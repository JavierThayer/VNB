;;; c f is measurable for a real c >= 0: `ptwise-scale-measurable' (theorem-library/real-integral.scm,
;;; MEASURE-4-C, loaded earlier, same statement).  This file proved it again as measurable-fn-scale;
;;; the integrator retired the copy (proven-duplicate-audit, 2026-10-10).

;;; The coefficient identity of Hoelder's main case:
;;;   etimes( (1/pw) . (1/nx)^pw , nint ) = 1/pw   when nx^pw = nint, nx real > 0.
(define (lpi-coef! rpw pw nx nint)
  (let* ((rx (list 'recip nx))
         (era (list 'EPOW rx pw))
         (goal (list '= (list 'etimes (list '* rpw era) nint) rpw)))
    (fact 'rr-zero-in) (fact 'rr-one-in)
    (lpi-le-of-lt! 0 era)
    (lpi-le-of-lt! 0 rx)
    (lpi-le-of-lt! 0 nx)
    (lpi-rps! nx)
    (fact 'etimes-assoc-real rpw era nint)
    (fact 'epow-etimes rx nx pw)
    (lpi-etimes-eq! rx nx)
    (lpi-need! (list 'IN rx 'RR) (list 'IN nx 'RR))
    (fact 'rr-mul-comm rx nx)
    (dk-have! (list '= (list '* rx nx) 1)
      (lambda () (subst (list '= (list '* rx nx) (list '* nx rx))) (dk-ass!)))
    (fact 'epow-one-base pw)
    (lpi-etimes-eq! rpw 1)
    (dk-have! goal
      (lambda ()
        (subst (list '= (list 'etimes (list '* rpw era) nint) (list 'etimes rpw (list 'etimes era nint))))
        (subst (list '= nint (list 'EPOW nx pw)))
        (subst (list '= (list 'etimes era (list 'EPOW nx pw)) (list 'EPOW (list 'etimes rx nx) pw)))
        (subst (list '= (list 'etimes rx nx) (list '* rx nx)))
        (subst (list '= (list '* rx nx) 1))
        (subst (list '= (list 'EPOW 1 pw) 1))
        (subst (list '= (list 'etimes rpw 1) (list '* rpw 1)))
        (dk-crs-opaque!)))
    goal))

;;; Hoelder's main case: na = I_p(f), nb = I_q(g) both real > 0.  Young with the
;;; weights 1/na, 1/nb at each point, integrated:
;;;   (1/(na nb)) INTEGRAL(f g) <= (1/p) + (1/q) = 1.
(define (lpi-main-case! na nb aa bb ii fg fp gq vfg)
  (let* ((rp '(recip p)) (rq '(recip q))
         (ra (list 'recip na)) (rb (list 'recip nb))
         (kk (list '* ra rb))
         (era (list 'EPOW ra 'p)) (erb (list 'EPOW rb 'q))
         (k1 (list '* rp era)) (k2 (list '* rq erb))
         (s1 (list 'PTWISE-SCALE 'omega k1 fp))
         (s2 (list 'PTWISE-SCALE 'omega k2 gq))
         (lf (list 'PTWISE-SCALE 'omega kk fg))
         (rf (list 'PTWISE-EPLUS 'omega s1 s2))
         (rps! (lambda (t) (lpi-le-of-lt! 0 t) (lpi-rps! t))))
    (lpi-recip-facts! na)
    (lpi-recip-facts! nb)
    (fact 'rr-mul-in-rr ra rb) (fact 'rr-mul-pos ra rb)
    (rps! kk)
    (fact 'rr-pos-ne-zero kk)
    (dk-split! (dk-fact! 'epow-pos-real ra 'p))
    (dk-split! (dk-fact! 'epow-pos-real rb 'q))
    (fact 'rr-mul-in-rr rp era) (fact 'rr-mul-pos rp era)
    (fact 'rr-mul-in-rr rq erb) (fact 'rr-mul-pos rq erb)
    (rps! k1) (rps! k2) (rps! rp) (rps! rq)
    (fact 'ptwise-scale-measurable 'omega 'cA fp k1)
    (fact 'ptwise-scale-measurable 'omega 'cA gq k2)
    (fact 'ptwise-scale-measurable 'omega 'cA fg kk)
    (fact 'measurable-fn-eplus 'omega 'cA s1 s2)
    (for-each (lambda (h) (lpi-mfn-parts! 'omega 'cA h)) (list s1 s2 lf rf))
    (let ((vfp (dk-cite! 'ptwise-epow-value 'omega 'f 'p))
          (vgq (dk-cite! 'ptwise-epow-value 'omega 'g 'q)))
      (lpi-need! '(IN p RR) '(< 1 p))
      (lpi-need! '(IN q RR) '(< 1 q))
      (dk-have! (list 'PTWISE-LE 'omega lf rf)
        (lambda ()
          (mac 'PTWISE-LE)
          (let* ((x (dk-di-var!)) (fx (list 'f x)) (gx (list 'g x))
                 (at (lambda (h) (list h x))))
            (vfg x)
            (dk-apply! vfp x)
            (dk-apply! vgq x)
            (for-each (lambda (h) (fact 'fun-apply-type-c h 'omega 'RR-POS-STAR x))
                      (list fg fp gq s1 s2))
            (lpi-need! (list 'IN kk 'RR-POS-STAR) (list 'IN (at fg) 'RR-POS-STAR))
            (fact 'etimes-closed kk (at fg))
            (lpi-need! (list 'IN k1 'RR-POS-STAR) (list 'IN (at fp) 'RR-POS-STAR))
            (fact 'etimes-closed k1 (at fp))
            (lpi-need! (list 'IN k2 'RR-POS-STAR) (list 'IN (at gq) 'RR-POS-STAR))
            (fact 'etimes-closed k2 (at gq))
            (lpi-need! (list 'IN (at s1) 'RR-POS-STAR) (list 'IN (at s2) 'RR-POS-STAR))
            (fact 'eplus-closed (at s1) (at s2))
            (lpi-val! 'PTWISE-SCALE (list kk fg) x (list 'etimes kk (at fg)))
            (lpi-val! 'PTWISE-SCALE (list k1 fp) x (list 'etimes k1 (at fp)))
            (lpi-val! 'PTWISE-SCALE (list k2 gq) x (list 'etimes k2 (at gq)))
            (lpi-val! 'PTWISE-EPLUS (list s1 s2) x (list 'eplus (at s1) (at s2)))
            (fact 'young-scaled ra rb fx gx 'p 'q)
            (subst (list '= (at lf) (list 'etimes kk (at fg))))
            (subst (list '= (at fg) (list 'etimes fx gx)))
            (subst (list '= (at rf) (list 'eplus (at s1) (at s2))))
            (subst (list '= (at s1) (list 'etimes k1 (at fp))))
            (subst (list '= (at s2) (list 'etimes k2 (at gq))))
            (subst (list '= (at fp) (list 'EPOW fx 'p)))
            (subst (list '= (at gq) (list 'EPOW gx 'q)))
            (dk-ass!)))))
    (fact 'integral-homogeneous 'omega 'cA 'mu fg kk)
    (fact 'integral-homogeneous 'omega 'cA 'mu fp k1)
    (fact 'integral-homogeneous 'omega 'cA 'mu gq k2)
    (fact 'integral-additive 'omega 'cA 'mu s1 s2)
    (dk-have! (list '= (list 'EPOW na 'p) aa)
      (lambda ()
        (subst (list '= na (list 'EPOW aa rp)))
        (dk-split! (dk-fact! 'epow-inverse aa 'p))
        (dk-ass!)))
    (dk-have! (list '= (list 'EPOW nb 'q) bb)
      (lambda ()
        (subst (list '= nb (list 'EPOW bb rq)))
        (dk-split! (dk-fact! 'epow-inverse bb 'q))
        (dk-ass!)))
    (lpi-coef! rp 'p na aa)
    (lpi-coef! rq 'q nb bb)
    (lpi-eplus-eq! rp rq)
    (dk-have! (list '= (list '+ rp rq) 1)
      (lambda ()
        (mac-h 'binary-divide-def '(= (+ (/ 1 p) (/ 1 q)) 1))
        (fact 'rr-one-mul rp)
        (fact 'rr-one-mul rq)
        (subst (list '= rp (list '* 1 rp)))
        (subst (list '= rq (list '* 1 rq)))
        (dk-ass!)))
    (let* ((h0 (dk-fact! 'integral-monotone 'omega 'cA 'mu lf rf))
           (h1 (dk-rewrite-h! h0 (list 'INTEGRAL 'omega 'cA 'mu lf) (list 'etimes kk ii)))
           (h2 (dk-rewrite-h! h1 (list 'INTEGRAL 'omega 'cA 'mu rf)
                              (list 'eplus (list 'INTEGRAL 'omega 'cA 'mu s1) (list 'INTEGRAL 'omega 'cA 'mu s2))))
           (h3 (dk-rewrite-h! h2 (list 'INTEGRAL 'omega 'cA 'mu s1) (list 'etimes k1 aa)))
           (h4 (dk-rewrite-h! h3 (list 'INTEGRAL 'omega 'cA 'mu s2) (list 'etimes k2 bb)))
           (h5 (dk-rewrite-h! h4 (list 'etimes k1 aa) rp))
           (h6 (dk-rewrite-h! h5 (list 'etimes k2 bb) rq))
           (h7 (dk-rewrite-h! h6 (list 'eplus rp rq) (list '+ rp rq)))
           (h8 (dk-rewrite-h! h7 (list '+ rp rq) 1)))
      (lpi-star-cases! ii
        (lambda ()
          (lpi-etimes-eq! kk ii)
          (let* ((h9 (dk-rewrite-h! h8 (list 'etimes kk ii) (list '* kk ii)))
                 (nn2 (list '* na nb))
                 (prod (list '* (list '* kk ii) nn2)))
            (fact 'rr-mul-in-rr kk ii)
            (fact 'rr-mul-in-rr na nb)
            (fact 'rr-mul-pos na nb)
            (lpi-le-of-lt! 0 nn2)
            (fact 'rr-mul-le-right (list '* kk ii) 1 nn2)
            (let ((id1 (list '= prod (list '* (list '* (list '* na ra) (list '* nb rb)) ii))))
              (dk-have! id1 (lambda () (dk-crs-opaque!)))
              (dk-have! (list '= prod ii)
                (lambda ()
                  (subst id1)
                  (subst (list '= (list '* na ra) 1))
                  (subst (list '= (list '* nb rb) 1))
                  (crs)))
              (dk-have! (list '= (list '* 1 nn2) nn2) (lambda () (crs)))
              (let* ((m0 (list '<= prod (list '* 1 nn2)))
                     (m1 (dk-rewrite-h! m0 prod ii))
                     (m2 (dk-rewrite-h! m1 (list '* 1 nn2) nn2)))
                (lpi-le-of-lt! 0 na) (lpi-le-of-lt! 0 nb)
                (lpi-etimes-eq! na nb)
                (subst (list '= (list 'etimes na nb) nn2))
                (dk-ass!)))))
        (lambda ()
          (fact 'etimes-pos-inf-right kk)
          (let* ((g1 (dk-rewrite-h! h8 ii 'POS-INF))
                 (g2 (dk-rewrite-h! g1 (list 'etimes kk 'POS-INF) 'POS-INF)))
            (fact 'pos-inf-above-reals 1)
            (lpi-keep-prop! '(<= POS-INF 1) '(NOT (<= POS-INF 1)))))))))

;;; hoelder: INTEGRAL(f g) <= I_p(f) I_q(g) for conjugate p, q (0 . +inf = 0).
(sp (make-wff
  '(FORALL omega (FORALL cA (FORALL mu (FORALL f (FORALL g
    (IMPLIES (IS-MEASURE omega cA mu)
      (IMPLIES (IS-MEASURABLE-FN omega cA f)
        (IMPLIES (IS-MEASURABLE-FN omega cA g)
          (FORALL p (IMPLIES (AND (IN p RR) (< 1 p))
            (FORALL q (IMPLIES (AND (IN q RR) (< 1 q))
              (IMPLIES (= (+ (/ 1 p) (/ 1 q)) 1)
                (<= (INTEGRAL omega cA mu (PTWISE-ETIMES omega f g))
                    (etimes (EP-NORM omega cA mu p f) (EP-NORM omega cA mu q g))))))))))))))))))
(dk-peel!)
(dk-split-all!)
(lpi-parts! 'IS-MEASURE '(omega cA mu))
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(fact 'rr-zero-in) (fact 'rr-one-in) (fact 'zero-in-rr-pos-star)
(dk-have! '(< 0 p) (lambda () (dk-ineq! '(< 1 p))))
(dk-have! '(< 0 q) (lambda () (dk-ineq! '(< 1 q))))
(lpi-recip-facts! 'p)
(lpi-recip-facts! 'q)
(let* ((fg '(PTWISE-ETIMES omega f g))
       (fp '(PTWISE-EPOW omega f p))
       (gq '(PTWISE-EPOW omega g q))
       (ii (list 'INTEGRAL 'omega 'cA 'mu fg))
       (aa (list 'INTEGRAL 'omega 'cA 'mu fp))
       (bb (list 'INTEGRAL 'omega 'cA 'mu gq))
       (na '(EP-NORM omega cA mu p f))
       (nb '(EP-NORM omega cA mu q g))
       (rhs (list 'etimes na nb))
       (rp '(recip p)) (rq '(recip q)))
  (lpi-mfn-parts! 'omega 'cA 'f)
  (lpi-mfn-parts! 'omega 'cA 'g)
  (fact 'measurable-fn-etimes 'omega 'cA 'f 'g)
  (fact 'measurable-fn-epow 'omega 'cA 'f 'p)
  (fact 'measurable-fn-epow 'omega 'cA 'g 'q)
  (lpi-mfn-parts! 'omega 'cA fg)
  (lpi-mfn-parts! 'omega 'cA fp)
  (lpi-mfn-parts! 'omega 'cA gq)
  (fact 'integral-in 'omega 'cA 'mu fg)
  (fact 'integral-in 'omega 'cA 'mu fp)
  (fact 'integral-in 'omega 'cA 'mu gq)
  (fact 'ep-norm-unfold 'omega 'cA 'mu 'p 'f)
  (fact 'ep-norm-unfold 'omega 'cA 'mu 'q 'g)
  (fact 'epow-in aa rp)
  (fact 'epow-in bb rq)
  (dk-have! (list 'IN na 'RR-POS-STAR) (lambda () (subst (list '= na (list 'EPOW aa rp))) (dk-ass!)))
  (dk-have! (list 'IN nb 'RR-POS-STAR) (lambda () (subst (list '= nb (list 'EPOW bb rq))) (dk-ass!)))
  (lpi-need! (list 'IN na 'RR-POS-STAR) (list 'IN nb 'RR-POS-STAR))
  (fact 'etimes-closed na nb)
  (let* ((vfg (lambda (x)          ; x in omega: (= (fg x) (etimes (f x) (g x)))
               (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR x)
               (fact 'fun-apply-type-c 'g 'omega 'RR-POS-STAR x)
               (lpi-need! (list 'IN (list 'f x) 'RR-POS-STAR) (list 'IN (list 'g x) 'RR-POS-STAR))
               (fact 'etimes-closed (list 'f x) (list 'g x))
               (lpi-val! 'PTWISE-ETIMES '(f g) x (list 'etimes (list 'f x) (list 'g x)))))
        (zero-case!
          (lambda (hf pw nf nint nh first?)
            ;; I_pw(hf) = nh = 0: hf vanishes off a null set eh, so f g <= nf there
            (let* ((zz (dk-fact! 'ep-norm-zero-null 'omega 'cA 'mu hf pw))
                   (eh (list 'SEP 'x_ 'omega (list '< 0 (list hf 'x_)))))
              (dk-split! zz)
              (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega)
                          (list 'IMPLIES (list 'NOT (list 'IN 'x eh))
                                (list '<= (list fg 'x) (list nf 'x)))))
                (lambda ()
                  (dk-peel!)
                  (let* ((x (cadr (cadr (dk-goal)))) (hx (list hf x)))
                    (vfg x)
                    (fact 'fun-apply-type-c hf 'omega 'RR-POS-STAR x)
                    (fact 'fun-apply-type-c nf 'omega 'RR-POS-STAR x)
                    (dk-have! (list 'NOT (list '< 0 hx))
                      (lambda ()
                        (di)
                        (dk-have! (list 'IN x eh) (lambda () (lpi-sep-in! (lambda () (dk-ass!)))))
                        (lpi-keep-prop! (list 'IN x eh) (list 'NOT (list 'IN x eh)))))
                    (fact 'rps-not-lt-le 0 hx)
                    (fact 'rr-pos-star-nonneg hx)
                    (lpi-antisym! hx 0)
                    (subst (list '= (list fg x) (list 'etimes (list 'f x) (list 'g x))))
                    (subst (list '= hx 0))
                    (if first?
                        (begin (fact 'etimes-zero-left (list 'g x))
                               (subst (list '= (list 'etimes 0 (list 'g x)) 0)))
                        (begin (fact 'etimes-zero-right (list 'f x))
                               (subst (list '= (list 'etimes (list 'f x) 0) 0))))
                    (fact 'rr-pos-star-nonneg (list nf x))
                    (dk-ass!))))
              (let ((le (dk-fact! 'integral-le-off-null 'omega 'cA 'mu eh fg nf)))
                (dk-rewrite-h! (list '= nh 0) nh (list 'EPOW nint (list 'recip pw)))
                (fact 'epow-eq-zero nint (list 'recip pw))
                (let ((le0 (dk-rewrite-h! le nint 0)))
                  (subst (list '= nh 0))
                  (if first?
                      (begin (fact 'etimes-zero-left nb) (subst (list '= (list 'etimes 0 nb) 0)))
                      (begin (fact 'etimes-zero-right na) (subst (list '= (list 'etimes na 0) 0))))
                  (dk-ass!))))))
        (inf-case!
          (lambda (eqn)
            (dk-have! (list '= rhs 'POS-INF) eqn)
            (fact 'rr-pos-star-below-pos-inf ii)
            (subst (list '= rhs 'POS-INF))
            (dk-ass!))))
    (use-em (list '= na 0)
      (lambda () (zero-case! 'f 'p fp aa na #t))
      (lambda ()
        (use-em (list '= nb 0)
          (lambda () (zero-case! 'g 'q gq bb nb #f))
          (lambda ()
            (lpi-star-cases! na
              (lambda ()
                (lpi-star-cases! nb
                  (lambda ()
                    (lpi-pos-of-ne! na)
                    (lpi-pos-of-ne! nb)
                    (lpi-main-case! na nb aa bb ii fg fp gq vfg))
                  (lambda ()
                    (inf-case! (lambda ()
                                 (subst (list '= nb 'POS-INF))
                                 (fact 'etimes-pos-inf-right na)
                                 (dk-ass!))))))
              (lambda ()
                (inf-case! (lambda ()
                             (subst (list '= na 'POS-INF))
                             (fact 'etimes-pos-inf-left nb)
                             (dk-ass!)))))))))))
(lpi-check 'hoelder)
(qed 'hoelder)
(topic! 'hoelder 'analysis)

;;; =====================================================================
;;; (E) TOWARD MINKOWSKI: the conjugate exponent, I_1 = the integral, the
;;;     splitting t^p = t^(p-1) t, distributivity in [0,+inf], and the
;;;     convexity bound (u + v)^p <= 2^p (u^p + v^p) that the notes skip.
;;; =====================================================================

;;; conjugate-exponent: for real p > 1, q = p/(p-1) is real, > 1, conjugate to
;;; p, and (p-1) q = p.
(sp (make-wff '(FORALL p (IMPLIES (IN p RR) (IMPLIES (< 1 p)
  (AND (IN (* p (recip (- p 1))) RR)
   (AND (< 1 (* p (recip (- p 1))))
    (AND (= (+ (/ 1 p) (/ 1 (* p (recip (- p 1))))) 1)
         (= (* (- p 1) (* p (recip (- p 1)))) p)))))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'rr-one-in)
(dk-have! '(< 0 p) (lambda () (dk-ineq! '(< 1 p))))
(lpi-recip-facts! 'p)
(lpi-type! '(- p 1))
(dk-have! '(< 0 (- p 1)) (lambda () (dk-ineq! '(< 1 p))))
(lpi-recip-facts! '(- p 1))
(let* ((pm1 '(- p 1)) (r '(recip (- p 1))) (rp '(recip p))
       (q (list '* 'p r))
       (v (list '* pm1 rp)))
  (fact 'rr-mul-in-rr 'p r)
  (fact 'rr-mul-pos 'p r)
  (fact 'rr-pos-ne-zero q)
  (fact 'rr-mul-in-rr pm1 rp)
  (fact 'rr-mul-in-rr pm1 r)
  (lpi-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (ass))
              ((dk-head-is? g '<)
               (let ((id (list '= q (list '+ (list '* pm1 r) r))))
                 (dk-have! id (lambda () (dk-crs-opaque!)))
                 (let ((id2 (dk-rewrite-h! id (list '* pm1 r) 1)))
                   (dk-ineq! id2 (list '< 0 r)))))
              ((equal? (cadr g) (list '* pm1 q))
               (let ((id (list '= (list '* pm1 q) (list '* 'p (list '* pm1 r)))))
                 (dk-have! id (lambda () (dk-crs-opaque!)))
                 (subst id)
                 (subst (list '= (list '* pm1 r) 1))
                 (crs)))
              (#t
               (mac 'binary-divide-def)
               (dk-have! (list '= 1 (list '* q v))
                 (lambda ()
                   (let ((id (list '= (list '* q v) (list '* (list '* 'p rp) (list '* pm1 r)))))
                     (dk-have! id (lambda () (dk-crs-opaque!)))
                     (subst id)
                     (subst (list '= (list '* 'p rp) 1))
                     (subst (list '= (list '* pm1 r) 1))
                     (crs))))
               (fact 'rr-recip-solve q 1 v)
               (let ((rq (list 'recip q)))
                 (fact 'rr-recip-closed q)
                 (let ((id1 (list '= (list '* 1 rq) (list '* rq 1)))
                       (id2 (list '= (list '+ (list '* 1 rp) v) (list '* 'p rp))))
                   (dk-have! id1 (lambda () (dk-crs-opaque!)))
                   (dk-have! id2 (lambda () (dk-crs-opaque!)))
                   (subst id1)
                   (subst (list '= (list '* rq 1) v))
                   (subst id2)
                   (subst (list '= (list '* 'p rp) 1))
                   (rfl)))))))))
(lpi-check 'conjugate-exponent)
(qed 'conjugate-exponent)

;;; ep-norm-one: I_1(h) is the integral of h.
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL h
  (IMPLIES (IS-MEASURE omega cA mu) (IMPLIES (IS-MEASURABLE-FN omega cA h)
    (= (EP-NORM omega cA mu 1 h) (INTEGRAL omega cA mu h))))))))))
(dk-peel!)
(lpi-parts! 'IS-MEASURE '(omega cA mu))
(lpi-mfn-parts! 'omega 'cA 'h)
(fact 'rr-zero-in) (fact 'rr-one-in) (fact 'rr-zero-lt-one)
(let ((h1 '(PTWISE-EPOW omega h 1)))
  (fact 'measurable-fn-epow 'omega 'cA 'h 1)
  (let ((val (dk-fact! 'ptwise-epow-value 'omega 'h 1)))
    (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list '= (list h1 'x) '(h x))))
      (lambda ()
        (let ((x (dk-di-var!)))
          (dk-apply! val x)
          (fact 'fun-apply-type-c 'h 'omega 'RR-POS-STAR x)
          (fact 'epow-one (list 'h x))
          (subst (list '= (list h1 x) (list 'EPOW (list 'h x) 1)))
          (dk-ass!)))))
  (fact 'integral-ptwise-eq 'omega 'cA 'mu h1 'h)
  (fact 'ep-norm-unfold 'omega 'cA 'mu 1 'h)
  (fact 'rr-recip-one)
  (fact 'integral-in 'omega 'cA 'mu 'h)
  (fact 'epow-one '(INTEGRAL omega cA mu h))
  (subst (list '= '(EP-NORM omega cA mu 1 h) (list 'EPOW (list 'INTEGRAL 'omega 'cA 'mu h1) '(recip 1))))
  (subst '(= (recip 1) 1))
  (subst (list '= (list 'INTEGRAL 'omega 'cA 'mu h1) '(INTEGRAL omega cA mu h)))
  (dk-ass!))
(lpi-check 'ep-norm-one)
(qed 'ep-norm-one)

;;; epow-split: t^p = t^(p-1) . t for p > 1.
(sp (make-wff '(FORALL t_ (IMPLIES (IN t_ RR-POS-STAR) (FORALL p_ (IMPLIES (IN p_ RR) (IMPLIES (< 1 p_)
  (= (EPOW t_ p_) (etimes (EPOW t_ (- p_ 1)) t_)))))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'rr-one-in)
(dk-have! '(< 0 p_) (lambda () (dk-ineq! '(< 1 p_))))
(lpi-type! '(- p_ 1))
(dk-have! '(< 0 (- p_ 1)) (lambda () (dk-ineq! '(< 1 p_))))
(let ((pm1 '(- p_ 1)))
  (lpi-star-cases! 't_
    (lambda ()
      (lpi-zero-cases! 't_
        (lambda ()
          (dk-split! (dk-fact! 'epow-pos-real 't_ pm1))
          (lpi-le-of-lt! 0 (list 'EPOW 't_ pm1))
          (lpi-le-of-lt! 0 't_)
          (lpi-etimes-eq! (list 'EPOW 't_ pm1) 't_)
          (subst (list '= (list 'etimes (list 'EPOW 't_ pm1) 't_) (list '* (list 'EPOW 't_ pm1) 't_)))
          (fact 'epow-real 't_ 'p_)
          (fact 'epow-real 't_ pm1)
          (subst '(= (EPOW t_ p_) (RPOW-STAR t_ p_)))
          (subst (list '= (list 'EPOW 't_ pm1) (list 'RPOW-STAR 't_ pm1)))
          (fact 'rpow-star-add 't_ pm1 1)
          (fact 'rpow-star-one 't_)
          (dk-have! (list '= (list '+ pm1 1) 'p_) (lambda () (crs)))
          (let* ((h0 (list '= (list 'RPOW-STAR 't_ (list '+ pm1 1))
                           (list '* (list 'RPOW-STAR 't_ pm1) '(RPOW-STAR t_ 1))))
                 (h1 (dk-rewrite-h! h0 (list '+ pm1 1) 'p_))
                 (h2 (dk-rewrite-h! h1 '(RPOW-STAR t_ 1) 't_)))
            (dk-ass!)))
        (lambda ()
          (subst '(= t_ 0))
          (fact 'epow-zero 'p_)
          (fact 'epow-zero pm1)
          (subst '(= (EPOW 0 p_) 0))
          (subst (list '= (list 'EPOW 0 pm1) 0))
          (fact 'zero-in-rr-pos-star)
          (fact 'etimes-zero-left 0)
          (subst '(= (etimes 0 0) 0))
          (rfl))))
    (lambda ()
      (subst '(= t_ POS-INF))
      (fact 'epow-pos-inf 'p_)
      (fact 'epow-pos-inf pm1)
      (subst '(= (EPOW POS-INF p_) POS-INF))
      (subst (list '= (list 'EPOW 'POS-INF pm1) 'POS-INF))
      (fact 'pos-inf-in-rr-pos-star)
      (dk-have! '(NOT (= POS-INF 0))
        (lambda ()
          (di)
          (dk-have! '(IN POS-INF RR) (lambda () (subst '(= POS-INF 0)) (dk-ass!)))
          (fact 'pos-inf-not-in-rr)
          (lpi-keep-prop! '(IN POS-INF RR) '(NOT (IN POS-INF RR)))))
      (fact 'etimes-pos-inf-left 'POS-INF)
      (subst '(= (etimes POS-INF POS-INF) POS-INF))
      (rfl))))
(lpi-check 'epow-split)
(qed 'epow-split)

;;; etimes-distrib-left-star: c (x + y) = c x + c y for every c in [0,+inf].
(sp (make-wff '(FORALL c_ (IMPLIES (IN c_ RR-POS-STAR) (FORALL x (FORALL y
  (IMPLIES (AND (IN x RR-POS-STAR) (IN y RR-POS-STAR))
    (= (etimes c_ (eplus x y)) (eplus (etimes c_ x) (etimes c_ y))))))))))
(dk-peel!)
(dk-split-all!)
(fact 'rr-zero-in) (fact 'zero-in-rr-pos-star) (fact 'pos-inf-in-rr-pos-star)
(lpi-need! '(IN x RR-POS-STAR) '(IN y RR-POS-STAR))
(fact 'eplus-closed 'x 'y)
(lpi-star-cases! 'c_
  (lambda ()
    (fact 'etimes-distrib-left 'c_ 'x 'y)
    (dk-ass!))
  (lambda ()
    (subst '(= c_ POS-INF))
    (dk-have! '(NOT (= POS-INF 0))
      (lambda ()
        (di)
        (dk-have! '(IN POS-INF RR) (lambda () (subst '(= POS-INF 0)) (dk-ass!)))
        (fact 'pos-inf-not-in-rr)
        (lpi-keep-prop! '(IN POS-INF RR) '(NOT (IN POS-INF RR)))))
    (lpi-need! '(IN POS-INF RR-POS-STAR) '(IN y RR-POS-STAR))
    (fact 'etimes-closed 'POS-INF 'y)
    (use-em '(= x 0)
      (lambda ()
        (subst '(= x 0))
        (fact 'eplus-zero-left 'y)
        (subst '(= (eplus 0 y) y))
        (fact 'etimes-zero-right 'POS-INF)
        (subst '(= (etimes POS-INF 0) 0))
        (fact 'eplus-zero-left '(etimes POS-INF y))
        (subst '(= (eplus 0 (etimes POS-INF y)) (etimes POS-INF y)))
        (rfl))
      (lambda ()
        (fact 'eplus-le-left 'x 'y)
        (fact 'rr-pos-star-nonneg 'x)
        (dk-have! '(NOT (= (eplus x y) 0))
          (lambda ()
            (di)
            (dk-have! '(<= x 0) (lambda () (subst '(= 0 (eplus x y))) (dk-ass!)))
            (lpi-antisym! 'x 0)
            (lpi-keep-prop! '(= x 0) '(NOT (= x 0)))))
        (fact 'etimes-pos-inf-left '(eplus x y))
        (fact 'etimes-pos-inf-left 'x)
        (subst '(= (etimes POS-INF (eplus x y)) POS-INF))
        (subst '(= (etimes POS-INF x) POS-INF))
        (fact 'eplus-pos-inf-left '(etimes POS-INF y))
        (subst '(= (eplus POS-INF (etimes POS-INF y)) POS-INF))
        (rfl)))))
(lpi-check 'etimes-distrib-left-star)
(qed 'etimes-distrib-left-star)

;;; epow-eplus-le: (u + v)^p <= 2^p (u^p + v^p) on [0,+inf], p > 0.  The notes'
;;; proof of Prop. 2.19 divides by I_p(f + g)^(p/q) and so needs I_p(f + g)
;;; finite; this bound is what makes it finite when I_p(f), I_p(g) are.
(sp (make-wff '(FORALL u_ (IMPLIES (IN u_ RR-POS-STAR) (FORALL v_ (IMPLIES (IN v_ RR-POS-STAR)
  (FORALL p_ (IMPLIES (IN p_ RR) (IMPLIES (< 0 p_)
    (<= (EPOW (eplus u_ v_) p_) (etimes (EPOW 2 p_) (eplus (EPOW u_ p_) (EPOW v_ p_)))))))))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'rr-one-in)
(dk-have! '(IN 2 RR) (lambda () (from-context!)))
(dk-have! '(< 0 2) (lambda () (dk-ineq! '(IN 2 RR))))
(dk-have! '(<= 0 1) (lambda () (dk-ineq! '(IN 1 RR))))
(lpi-le-of-lt! 0 2)
(lpi-rps! 2)
(fact 'rr-pos-ne-zero 2)
(let* ((e2 '(EPOW 2 p_)) (eu '(EPOW u_ p_)) (ev '(EPOW v_ p_))
       (s '(eplus u_ v_)) (es (list 'EPOW s 'p_))
       (rhs (list 'etimes e2 (list 'eplus eu ev)))
       (dbl! (lambda (w)
               (fact 'etimes-distrib-right-real 1 1 w)
               (fact 'etimes-one-left w)
               (lpi-eplus-eq! 1 1)
               (dk-have! '(= (+ 1 1) 2) (lambda () (crs)))
               (dk-have! (list '= (list 'eplus w w) (list 'etimes 2 w))
                 (lambda ()
                   (subst '(= 2 (+ 1 1)))
                   (subst '(= (+ 1 1) (eplus 1 1)))
                   (subst (list '= (list 'etimes '(eplus 1 1) w)
                                (list 'eplus (list 'etimes 1 w) (list 'etimes 1 w))))
                   (subst (list '= (list 'etimes 1 w) w))
                   (rfl)))))
       (finish! (lambda (w ew ew-le)
                  ;; (<= s (etimes 2 w)) in context; ew-le! lands (<= ew (eplus eu ev))
                  (lpi-need! '(IN 2 RR-POS-STAR) (list 'IN w 'RR-POS-STAR))
                  (fact 'etimes-closed 2 w)
                  (let* ((m1 (dk-fact! 'epow-mono s (list 'etimes 2 w) 'p_))
                         (ee (dk-fact! 'epow-etimes 2 w 'p_))
                         (m2 (dk-rewrite-h! m1 (list 'EPOW (list 'etimes 2 w) 'p_) (list 'etimes e2 ew))))
                    (ew-le)
                    (lpi-need! (list 'IN ew 'RR-POS-STAR) (list 'IN (list 'eplus eu ev) 'RR-POS-STAR))
                    (fact 'etimes-mono-left e2 ew (list 'eplus eu ev))
                    (lpi-need! (list 'IN e2 'RR-POS-STAR) (list 'IN ew 'RR-POS-STAR))
                    (fact 'etimes-closed e2 ew)
                    (lpi-need! (list 'IN e2 'RR-POS-STAR) (list 'IN (list 'eplus eu ev) 'RR-POS-STAR))
                    (fact 'etimes-closed e2 (list 'eplus eu ev))
                    (lpi-need! (list 'IN es 'RR-POS-STAR) (list 'IN (list 'etimes e2 ew) 'RR-POS-STAR)
                               (list 'IN rhs 'RR-POS-STAR))
                    (lpi-need! (list '<= es (list 'etimes e2 ew)) (list '<= (list 'etimes e2 ew) rhs))
                    (fact 'rr-pos-star-le-trans es (list 'etimes e2 ew) rhs)
                    (dk-ass!)))))
  (dk-split! (dk-fact! 'epow-pos-real 2 'p_))
  (lpi-le-of-lt! 0 e2)
  (lpi-rps! e2)
  (fact 'epow-in 'u_ 'p_)
  (fact 'epow-in 'v_ 'p_)
  (lpi-need! (list 'IN eu 'RR-POS-STAR) (list 'IN ev 'RR-POS-STAR))
  (fact 'eplus-closed eu ev)
  (lpi-need! '(IN u_ RR-POS-STAR) '(IN v_ RR-POS-STAR))
  (fact 'eplus-closed 'u_ 'v_)
  (fact 'epow-in s 'p_)
  (use-cases (dk-fact! 'rps-le-total 'u_ 'v_)
    (lambda ()                                     ; u <= v
      (fact 'rr-pos-star-le-refl 'v_)
      (lpi-need! '(IN u_ RR-POS-STAR) '(IN v_ RR-POS-STAR) '(IN v_ RR-POS-STAR) '(IN v_ RR-POS-STAR))
      (lpi-need! '(<= u_ v_) '(<= v_ v_))
      (let ((m (dk-fact! 'eplus-mono 'u_ 'v_ 'v_ 'v_)))
        (dbl! 'v_)
        (dk-rewrite-h! m '(eplus v_ v_) '(etimes 2 v_)))
      (finish! 'v_ ev
        (lambda ()
          (lpi-need! (list 'IN ev 'RR-POS-STAR) (list 'IN eu 'RR-POS-STAR))
          (fact 'eplus-le-left ev eu)
          (fact 'eplus-comm ev eu)
          (dk-rewrite-h! (list '<= ev (list 'eplus ev eu)) (list 'eplus ev eu) (list 'eplus eu ev)))))
    (lambda ()                                     ; v <= u
      (fact 'rr-pos-star-le-refl 'u_)
      (lpi-need! '(IN u_ RR-POS-STAR) '(IN v_ RR-POS-STAR) '(IN u_ RR-POS-STAR) '(IN u_ RR-POS-STAR))
      (lpi-need! '(<= u_ u_) '(<= v_ u_))
      (let ((m (dk-fact! 'eplus-mono 'u_ 'v_ 'u_ 'u_)))
        (dbl! 'u_)
        (dk-rewrite-h! m '(eplus u_ u_) '(etimes 2 u_)))
      (finish! 'u_ eu
        (lambda ()
          (fact 'eplus-le-left eu ev))))))
(lpi-check 'epow-eplus-le)
(qed 'epow-eplus-le)

;;; =====================================================================
;;; (F) MINKOWSKI (the notes' Prop. 2.19).
;;; =====================================================================

;;; The main case p > 1, I_p(f), I_p(g) finite.  ns, nf, ng are the three
;;; norms, cc = INTEGRAL((f+g)^p), aa, bb the integrals of f^p, g^p.
(define (lpi-mink-main! s ns nf ng aa bb cc fp gp sp)
  (let* ((rp '(recip p))
         (q '(* p (recip (- p 1))))
         (rq (list 'recip q))
         (pm1 '(- p 1))
         (e2 '(EPOW 2 p))
         (fpgp (list 'PTWISE-EPLUS 'omega fp gp))
         (tt (list 'PTWISE-SCALE 'omega e2 fpgp))
         (rps! (lambda (t) (lpi-le-of-lt! 0 t) (lpi-rps! t)))
         (vs (lambda (x)               ; (= (s x) (eplus (f x) (g x)))
               (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR x)
               (fact 'fun-apply-type-c 'g 'omega 'RR-POS-STAR x)
               (lpi-need! (list 'IN (list 'f x) 'RR-POS-STAR) (list 'IN (list 'g x) 'RR-POS-STAR))
               (fact 'eplus-closed (list 'f x) (list 'g x))
               (lpi-val! 'PTWISE-EPLUS '(f g) x (list 'eplus (list 'f x) (list 'g x)))))
         (vfp (dk-cite! 'ptwise-epow-value 'omega 'f 'p))
         (vgp (dk-cite! 'ptwise-epow-value 'omega 'g 'p))
         (vsp (dk-cite! 'ptwise-epow-value 'omega s 'p)))
    ;; I_p(f)^p = INTEGRAL(f^p), real; the same for g
    (dk-have! (list '= (list 'EPOW nf 'p) aa)
      (lambda () (subst (list '= nf (list 'EPOW aa rp))) (dk-split! (dk-fact! 'epow-inverse aa 'p)) (dk-ass!)))
    (dk-have! (list '= (list 'EPOW ng 'p) bb)
      (lambda () (subst (list '= ng (list 'EPOW bb rp))) (dk-split! (dk-fact! 'epow-inverse bb 'p)) (dk-ass!)))
    (dk-split! (dk-fact! 'epow-real-in nf 'p))
    (dk-split! (dk-fact! 'epow-real-in ng 'p))
    (dk-rewrite-h! (list 'IN (list 'EPOW nf 'p) 'RR) (list 'EPOW nf 'p) aa)
    (dk-rewrite-h! (list 'IN (list 'EPOW ng 'p) 'RR) (list 'EPOW ng 'p) bb)
    (fact 'rr-pos-star-nonneg aa)
    (fact 'rr-pos-star-nonneg bb)
    ;; (1) INTEGRAL((f+g)^p) is finite: (f+g)^p <= 2^p (f^p + g^p)
    (dk-have! '(IN 2 RR) (lambda () (from-context!)))
    (dk-have! '(< 0 2) (lambda () (dk-ineq! '(IN 2 RR))))
    (dk-split! (dk-fact! 'epow-pos-real 2 'p))
    (rps! e2)
    (fact 'measurable-fn-eplus 'omega 'cA fp gp)
    (fact 'ptwise-scale-measurable 'omega 'cA fpgp e2)
    (for-each (lambda (h) (lpi-mfn-parts! 'omega 'cA h)) (list fpgp tt))
    (dk-have! (list 'PTWISE-LE 'omega sp tt)
      (lambda ()
        (mac 'PTWISE-LE)
        (let* ((x (dk-di-var!)) (fx (list 'f x)) (gx (list 'g x))
               (at (lambda (h) (list h x))))
          (vs x)
          (dk-apply! vfp x) (dk-apply! vgp x) (dk-apply! vsp x)
          (for-each (lambda (h) (fact 'fun-apply-type-c h 'omega 'RR-POS-STAR x)) (list fp gp fpgp s))
          (lpi-need! (list 'IN (at fp) 'RR-POS-STAR) (list 'IN (at gp) 'RR-POS-STAR))
          (fact 'eplus-closed (at fp) (at gp))
          (lpi-need! (list 'IN e2 'RR-POS-STAR) (list 'IN (at fpgp) 'RR-POS-STAR))
          (fact 'etimes-closed e2 (at fpgp))
          (lpi-val! 'PTWISE-SCALE (list e2 fpgp) x (list 'etimes e2 (at fpgp)))
          (lpi-val! 'PTWISE-EPLUS (list fp gp) x (list 'eplus (at fp) (at gp)))
          (fact 'epow-eplus-le fx gx 'p)
          (subst (list '= (at sp) (list 'EPOW (at s) 'p)))
          (subst (list '= (at s) (list 'eplus fx gx)))
          (subst (list '= (at tt) (list 'etimes e2 (at fpgp))))
          (subst (list '= (at fpgp) (list 'eplus (at fp) (at gp))))
          (subst (list '= (at fp) (list 'EPOW fx 'p)))
          (subst (list '= (at gp) (list 'EPOW gx 'p)))
          (dk-ass!))))
    (fact 'integral-homogeneous 'omega 'cA 'mu fpgp e2)
    (fact 'integral-additive 'omega 'cA 'mu fp gp)
    (lpi-eplus-eq! aa bb)
    (lpi-type! (list '+ aa bb))
    (dk-have! (list '<= 0 (list '+ aa bb)) (lambda () (dk-ineq! (list '<= 0 aa) (list '<= 0 bb))))
    (lpi-etimes-eq! e2 (list '+ aa bb))
    (lpi-type! (list '* e2 (list '+ aa bb)))
    (let* ((b0 (dk-fact! 'integral-monotone 'omega 'cA 'mu sp tt))
           (b1 (dk-rewrite-h! b0 (list 'INTEGRAL 'omega 'cA 'mu tt) (list 'etimes e2 (list 'INTEGRAL 'omega 'cA 'mu fpgp))))
           (b2 (dk-rewrite-h! b1 (list 'INTEGRAL 'omega 'cA 'mu fpgp) (list 'eplus aa bb)))
           (b3 (dk-rewrite-h! b2 (list 'eplus aa bb) (list '+ aa bb)))
           (b4 (dk-rewrite-h! b3 (list 'etimes e2 (list '+ aa bb)) (list '* e2 (list '+ aa bb)))))
      (lpi-need! (list 'IN cc 'RR-POS-STAR) (list 'IN (list '* e2 (list '+ aa bb)) 'RR))
      (fact 'rr-pos-star-le-real-in-rr cc (list '* e2 (list '+ aa bb))))
    (fact 'rr-pos-star-nonneg cc)
    (lpi-zero-cases! cc
      (lambda ()                               ; 0 < cc
        (lpi-type! pm1)
        (dk-have! (list '< 0 pm1) (lambda () (dk-ineq! '(< 1 p))))
        (let* ((dfun (list 'PTWISE-EPOW 'omega s pm1))
               (p1 (list 'PTWISE-ETIMES 'omega dfun 'f))
               (p2 (list 'PTWISE-ETIMES 'omega dfun 'g))
               (p12 (list 'PTWISE-EPLUS 'omega p1 p2))
               (dq (list 'PTWISE-EPOW 'omega dfun q))
               (dd (list 'EP-NORM 'omega 'cA 'mu q dfun))
               (dv0 (list 'EPOW cc rq))
               (nv0 (list 'EPOW cc rp)))
          (dk-have! (list '< 0 q) (lambda () (dk-ineq! (list '< 1 q))))
          (fact 'measurable-fn-epow 'omega 'cA s pm1)
          (fact 'measurable-fn-etimes 'omega 'cA dfun 'f)
          (fact 'measurable-fn-etimes 'omega 'cA dfun 'g)
          (fact 'measurable-fn-eplus 'omega 'cA p1 p2)
          (fact 'measurable-fn-epow 'omega 'cA dfun q)
          (for-each (lambda (h) (lpi-mfn-parts! 'omega 'cA h)) (list dfun p1 p2 p12 dq))
          (let ((vd (dk-cite! 'ptwise-epow-value 'omega s pm1))
                (vdq (dk-cite! 'ptwise-epow-value 'omega dfun q)))
            ;; (2) (f+g)^p <= (f+g)^(p-1) f + (f+g)^(p-1) g, pointwise
            (dk-have! (list 'PTWISE-LE 'omega sp p12)
              (lambda ()
                (mac 'PTWISE-LE)
                (let* ((x (dk-di-var!)) (fx (list 'f x)) (gx (list 'g x))
                       (at (lambda (h) (list h x)))
                       (sx (list 'eplus fx gx))
                       (ee (list 'EPOW sx pm1)))
                  (vs x)
                  (dk-apply! vsp x) (dk-apply! vd x)
                  (for-each (lambda (h) (fact 'fun-apply-type-c h 'omega 'RR-POS-STAR x)) (list s dfun p1 p2))
                  (lpi-need! (list 'IN (at dfun) 'RR-POS-STAR) (list 'IN fx 'RR-POS-STAR))
                  (fact 'etimes-closed (at dfun) fx)
                  (lpi-need! (list 'IN (at dfun) 'RR-POS-STAR) (list 'IN gx 'RR-POS-STAR))
                  (fact 'etimes-closed (at dfun) gx)
                  (lpi-need! (list 'IN (at p1) 'RR-POS-STAR) (list 'IN (at p2) 'RR-POS-STAR))
                  (fact 'eplus-closed (at p1) (at p2))
                  (lpi-val! 'PTWISE-ETIMES (list dfun 'f) x (list 'etimes (at dfun) fx))
                  (lpi-val! 'PTWISE-ETIMES (list dfun 'g) x (list 'etimes (at dfun) gx))
                  (lpi-val! 'PTWISE-EPLUS (list p1 p2) x (list 'eplus (at p1) (at p2)))
                  (fact 'epow-split sx 'p)
                  (fact 'epow-in sx pm1)
                  (lpi-need! (list 'IN fx 'RR-POS-STAR) (list 'IN gx 'RR-POS-STAR))
                  (fact 'etimes-distrib-left-star ee fx gx)
                  (subst (list '= (at sp) (list 'EPOW (at s) 'p)))
                  (subst (list '= (at p12) (list 'eplus (at p1) (at p2))))
                  (subst (list '= (at p1) (list 'etimes (at dfun) fx)))
                  (subst (list '= (at p2) (list 'etimes (at dfun) gx)))
                  (subst (list '= (at dfun) (list 'EPOW (at s) pm1)))
                  (subst (list '= (at s) sx))
                  (subst (list '= (list 'EPOW sx 'p) (list 'etimes ee sx)))
                  (subst (list '= (list 'etimes ee sx) (list 'eplus (list 'etimes ee fx) (list 'etimes ee gx))))
                  (lpi-need! (list 'IN ee 'RR-POS-STAR) (list 'IN fx 'RR-POS-STAR))
                  (fact 'etimes-closed ee fx)
                  (lpi-need! (list 'IN ee 'RR-POS-STAR) (list 'IN gx 'RR-POS-STAR))
                  (fact 'etimes-closed ee gx)
                  (lpi-need! (list 'IN (list 'etimes ee fx) 'RR-POS-STAR) (list 'IN (list 'etimes ee gx) 'RR-POS-STAR))
                  (fact 'eplus-closed (list 'etimes ee fx) (list 'etimes ee gx))
                  (fact 'rr-pos-star-le-refl (list 'eplus (list 'etimes ee fx) (list 'etimes ee gx)))
                  (dk-ass!))))
            ;; (3) INTEGRAL(((f+g)^(p-1))^q) = cc, so I_q((f+g)^(p-1)) = cc^(1/q)
            (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list '= (list dq 'x) (list sp 'x))))
              (lambda ()
                (let ((x (dk-di-var!)))
                  (dk-apply! vdq x) (dk-apply! vd x) (dk-apply! vsp x)
                  (fact 'fun-apply-type-c s 'omega 'RR-POS-STAR x)
                  (fact 'epow-epow (list s x) pm1 q)
                  (subst (list '= (list dq x) (list 'EPOW (list dfun x) q)))
                  (subst (list '= (list dfun x) (list 'EPOW (list s x) pm1)))
                  (subst (list '= (list sp x) (list 'EPOW (list s x) 'p)))
                  (subst (list '= (list 'EPOW (list 'EPOW (list s x) pm1) q) (list 'EPOW (list s x) (list '* pm1 q))))
                  (subst (list '= (list '* pm1 q) 'p))
                  (rfl))))
            (fact 'integral-ptwise-eq 'omega 'cA 'mu dq sp)
            (fact 'ep-norm-unfold 'omega 'cA 'mu q dfun)
            ;; (4) Hoelder twice
            (lpi-recip-facts! q)
            (let ((qp (list '+ (list '/ 1 q) '(/ 1 p)))
                  (pq (list '+ '(/ 1 p) (list '/ 1 q))))
              (dk-have! (list '= qp 1)
                (lambda ()
                  (dk-have! (list '= qp pq)
                    (lambda () (mac 'binary-divide-def) (dk-crs-opaque!)))
                  (subst (list '= qp pq))
                  (dk-ass!))))
            (lpi-need! (list 'IN q 'RR) (list '< 1 q))
            (lpi-need! '(IN p RR) '(< 1 p))
            (let* ((h1 (dk-fact! 'hoelder 'omega 'cA 'mu dfun 'f q 'p))
                   (h2 (dk-fact! 'hoelder 'omega 'cA 'mu dfun 'g q 'p))
                   (h1a (dk-rewrite-h! h1 dd (list 'EPOW (list 'INTEGRAL 'omega 'cA 'mu dq) rq)))
                   (h1b (dk-rewrite-h! h1a (list 'INTEGRAL 'omega 'cA 'mu dq) cc))
                   (h2a (dk-rewrite-h! h2 dd (list 'EPOW (list 'INTEGRAL 'omega 'cA 'mu dq) rq)))
                   (h2b (dk-rewrite-h! h2a (list 'INTEGRAL 'omega 'cA 'mu dq) cc)))
              ;; reals: cc > 0, its powers 1/p and 1/q
              (dk-split! (dk-fact! 'epow-pos-real cc rp))
              (dk-split! (dk-fact! 'epow-pos-real cc rq))
              (let* ((dv (dk-name! dv0))
                     (nv (dk-name! nv0))
                     (i1 (list 'INTEGRAL 'omega 'cA 'mu p1))
                     (i2 (list 'INTEGRAL 'omega 'cA 'mu p2))
                     (x1 (list 'etimes dv nf)) (x2 (list 'etimes dv ng)))
                (fact 'integral-in 'omega 'cA 'mu p1)
                (fact 'integral-in 'omega 'cA 'mu p2)
                (dk-have! (list '< 0 dv) (lambda () (subst (list '= dv dv0)) (dk-ass!)))
                (dk-have! (list '< 0 nv) (lambda () (subst (list '= nv nv0)) (dk-ass!)))
                (rps! dv)
                (let* ((g1 (dk-rewrite-h! h1b dv0 dv))
                       (g2 (dk-rewrite-h! h2b dv0 dv)))
                  (lpi-need! (list 'IN dv 'RR-POS-STAR) (list 'IN nf 'RR-POS-STAR))
                  (fact 'etimes-closed dv nf)
                  (lpi-need! (list 'IN dv 'RR-POS-STAR) (list 'IN ng 'RR-POS-STAR))
                  (fact 'etimes-closed dv ng)
                  (lpi-need! (list 'IN i1 'RR-POS-STAR) (list 'AND (list 'IN i2 'RR-POS-STAR)
                                                               (list 'AND (list 'IN x1 'RR-POS-STAR) (list 'IN x2 'RR-POS-STAR))))
                  (lpi-need! g1 g2)
                  (fact 'eplus-mono i1 i2 x1 x2)
                  (fact 'integral-additive 'omega 'cA 'mu p1 p2)
                  (let* ((c0 (dk-fact! 'integral-monotone 'omega 'cA 'mu sp p12))
                         (c1 (dk-rewrite-h! c0 (list 'INTEGRAL 'omega 'cA 'mu p12) (list 'eplus i1 i2))))
                    (lpi-need! (list 'IN i1 'RR-POS-STAR) (list 'IN i2 'RR-POS-STAR))
                    (fact 'eplus-closed i1 i2)
                    (lpi-need! (list 'IN x1 'RR-POS-STAR) (list 'IN x2 'RR-POS-STAR))
                    (fact 'eplus-closed x1 x2)
                    (lpi-need! (list 'IN cc 'RR-POS-STAR) (list 'AND (list 'IN (list 'eplus i1 i2) 'RR-POS-STAR)
                                                                 (list 'IN (list 'eplus x1 x2) 'RR-POS-STAR)))
                    (lpi-need! c1 (list '<= (list 'eplus i1 i2) (list 'eplus x1 x2)))
                    (fact 'rr-pos-star-le-trans cc (list 'eplus i1 i2) (list 'eplus x1 x2))
                    ;; to the reals
                    (lpi-etimes-eq! dv nf)
                    (lpi-etimes-eq! dv ng)
                    (fact 'rr-mul-in-rr dv nf) (fact 'rr-mul-in-rr dv ng)
                    (fact 'rr-pos-star-nonneg x1) (fact 'rr-pos-star-nonneg x2)
                    (dk-rewrite-h! (list '<= 0 x1) x1 (list '* dv nf))
                    (dk-rewrite-h! (list '<= 0 x2) x2 (list '* dv ng))
                    (lpi-eplus-eq! (list '* dv nf) (list '* dv ng))
                    (let* ((r0 (list '<= cc (list 'eplus x1 x2)))
                           (r1 (dk-rewrite-h! r0 x1 (list '* dv nf)))
                           (r2 (dk-rewrite-h! r1 x2 (list '* dv ng)))
                           (r3 (dk-rewrite-h! r2 (list 'eplus (list '* dv nf) (list '* dv ng))
                                              (list '+ (list '* dv nf) (list '* dv ng)))))
                      ;; cc = cc^(1/p) cc^(1/q), since 1/p + 1/q = 1
                      (dk-have! (list '= (list '+ rp rq) 1)
                        (lambda ()
                          (mac-h 'binary-divide-def (list '= (list '+ '(/ 1 p) (list '/ 1 q)) 1))
                          (fact 'rr-one-mul rp)
                          (fact 'rr-one-mul rq)
                          (subst (list '= rp (list '* 1 rp)))
                          (subst (list '= rq (list '* 1 rq)))
                          (dk-ass!)))
                      (fact 'epow-real cc rp)
                      (fact 'epow-real cc rq)
                      (fact 'rpow-star-add cc rp rq)
                      (fact 'rpow-star-one cc)
                      (dk-have! (list '= (list '* nv dv) cc)
                        (lambda ()
                          (subst (list '= nv nv0))
                          (subst (list '= dv dv0))
                          (subst (list '= nv0 (list 'RPOW-STAR cc rp)))
                          (subst (list '= dv0 (list 'RPOW-STAR cc rq)))
                          (subst (list '= (list '* (list 'RPOW-STAR cc rp) (list 'RPOW-STAR cc rq))
                                       (list 'RPOW-STAR cc (list '+ rp rq))))
                          (subst (list '= (list '+ rp rq) 1))
                          (subst (list '= (list 'RPOW-STAR cc 1) cc))
                          (rfl)))
                      (lpi-type! (list '+ nf ng))
                      (let ((id (list '= (list '* (list '+ nf ng) dv) (list '+ (list '* dv nf) (list '* dv ng)))))
                        (dk-have! id (lambda () (crs)))
                        (dk-have! (list '<= (list '* nv dv) (list '* (list '+ nf ng) dv))
                          (lambda ()
                            (subst (list '= (list '* nv dv) cc))
                            (subst id)
                            (dk-ass!))))
                      (fact 'rr-mul-le-cancel-pos nv dv (list '+ nf ng))
                      (subst (list '= ns nv0))
                      (subst (list '= nv0 nv))
                      (lpi-eplus-eq! nf ng)
                      (subst (list '= (list 'eplus nf ng) (list '+ nf ng)))
                      (dk-ass!)))))))))
      (lambda ()                               ; 0 = cc
        (subst (list '= ns (list 'EPOW cc rp)))
        (subst (list '= cc 0))
        (fact 'epow-zero rp)
        (subst (list '= (list 'EPOW 0 rp) 0))
        (fact 'rr-pos-star-nonneg (list 'eplus nf ng))
        (dk-ass!)))))

;;; minkowski: I_p(f + g) <= I_p(f) + I_p(g), 1 <= p real.
(sp (make-wff
  '(FORALL omega (FORALL cA (FORALL mu (FORALL f (FORALL g
    (IMPLIES (IS-MEASURE omega cA mu)
      (IMPLIES (IS-MEASURABLE-FN omega cA f)
        (IMPLIES (IS-MEASURABLE-FN omega cA g)
          (FORALL p (IMPLIES (AND (IN p RR) (<= 1 p))
            (<= (EP-NORM omega cA mu p (PTWISE-EPLUS omega f g))
                (eplus (EP-NORM omega cA mu p f) (EP-NORM omega cA mu p g)))))))))))))))
(dk-peel!)
(dk-split-all!)
(lpi-parts! 'IS-MEASURE '(omega cA mu))
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(fact 'rr-zero-in) (fact 'rr-one-in) (fact 'zero-in-rr-pos-star)
(lpi-mfn-parts! 'omega 'cA 'f)
(lpi-mfn-parts! 'omega 'cA 'g)
(let* ((s '(PTWISE-EPLUS omega f g))
       (ns (list 'EP-NORM 'omega 'cA 'mu 'p s))
       (nf '(EP-NORM omega cA mu p f))
       (ng '(EP-NORM omega cA mu p g))
       (rhs (list 'eplus nf ng)))
  (fact 'measurable-fn-eplus 'omega 'cA 'f 'g)
  (lpi-mfn-parts! 'omega 'cA s)
  (use-cases (dk-fact! 'rr-le-cases 1 'p)
    (lambda ()                                     ; 1 < p
      (dk-have! '(< 0 p) (lambda () (dk-ineq! '(< 1 p))))
      (lpi-recip-facts! 'p)
      (dk-split-all! (list (dk-fact! 'conjugate-exponent 'p)))
      (let* ((rp '(recip p))
             (fp '(PTWISE-EPOW omega f p))
             (gp '(PTWISE-EPOW omega g p))
             (sp (list 'PTWISE-EPOW 'omega s 'p))
             (aa (list 'INTEGRAL 'omega 'cA 'mu fp))
             (bb (list 'INTEGRAL 'omega 'cA 'mu gp))
             (cc (list 'INTEGRAL 'omega 'cA 'mu sp)))
        (fact 'measurable-fn-epow 'omega 'cA 'f 'p)
        (fact 'measurable-fn-epow 'omega 'cA 'g 'p)
        (fact 'measurable-fn-epow 'omega 'cA s 'p)
        (for-each (lambda (h) (lpi-mfn-parts! 'omega 'cA h)) (list fp gp sp))
        (for-each (lambda (h) (fact 'integral-in 'omega 'cA 'mu h)) (list fp gp sp))
        (fact 'ep-norm-unfold 'omega 'cA 'mu 'p 'f)
        (fact 'ep-norm-unfold 'omega 'cA 'mu 'p 'g)
        (fact 'ep-norm-unfold 'omega 'cA 'mu 'p s)
        (for-each (lambda (n i)
                    (fact 'epow-in i rp)
                    (dk-have! (list 'IN n 'RR-POS-STAR)
                      (lambda () (subst (list '= n (list 'EPOW i rp))) (dk-ass!))))
                  (list nf ng ns) (list aa bb cc))
        (lpi-need! (list 'IN nf 'RR-POS-STAR) (list 'IN ng 'RR-POS-STAR))
        (fact 'eplus-closed nf ng)
        (let ((inf! (lambda (eqn)
                      (dk-have! (list '= rhs 'POS-INF) eqn)
                      (fact 'rr-pos-star-below-pos-inf ns)
                      (subst (list '= rhs 'POS-INF))
                      (dk-ass!))))
          (lpi-star-cases! nf
            (lambda ()
              (lpi-star-cases! ng
                (lambda () (lpi-mink-main! s ns nf ng aa bb cc fp gp sp))
                (lambda () (inf! (lambda () (subst (list '= ng 'POS-INF)) (fact 'eplus-pos-inf-right nf) (dk-ass!))))))
            (lambda () (inf! (lambda () (subst (list '= nf 'POS-INF)) (fact 'eplus-pos-inf-left ng) (dk-ass!))))))))
    (lambda ()                                     ; p = 1
      (subst '(= p 1))
      (let ((n1 (lambda (h) (list 'EP-NORM 'omega 'cA 'mu 1 h)))
            (i1 (lambda (h) (list 'INTEGRAL 'omega 'cA 'mu h))))
        (for-each (lambda (h) (fact 'ep-norm-one 'omega 'cA 'mu h)
                              (fact 'integral-in 'omega 'cA 'mu h)
                              (subst (list '= (n1 h) (i1 h))))
                  (list s 'f 'g))
        (fact 'integral-additive 'omega 'cA 'mu 'f 'g)
        (subst (list '= (i1 s) (list 'eplus (i1 'f) (i1 'g))))
        (lpi-need! (list 'IN (i1 'f) 'RR-POS-STAR) (list 'IN (i1 'g) 'RR-POS-STAR))
        (fact 'eplus-closed (i1 'f) (i1 'g))
        (fact 'rr-pos-star-le-refl (list 'eplus (i1 'f) (i1 'g)))
        (dk-ass!)))))
(lpi-check 'minkowski)
(qed 'minkowski)
(topic! 'minkowski 'analysis)

