;;; theorem-library/lp-inequalities.scm -- POWERS IN [0,+inf], HOELDER AND
;;; MINKOWSKI, FUNCTIONS EQUAL ALMOST EVERYWHERE.  MEASURE-4-B, 2026-10-10.
;;;
;;; SOURCE.  Thayer, Construction of Measures, Chapter 2, Sections 3 and 4
;;; (pp. 14-17): (27) conjugate exponents, Prop. 2.17 (Hoelder) with Lemma
;;; 2.18 (Young), Prop. 2.19 (Minkowski), Prop. 2.21 (functions equal almost
;;; everywhere have equal integrals), Prop. 2.23 (finite integral implies
;;; finite almost everywhere).  The vocabulary -- EPOW, PTWISE-EPOW, EP-NORM
;;; (the notes' I_p) -- is structure-library/lp-inequalities.scm.
;;;
;;; "ALMOST EVERYWHERE" (the user's decision of 2026-10-09).  No quotient and
;;; no setoid: functions are total on omega, and "almost everywhere" is a
;;; clause in the statement -- an exceptional set nb in cA with mu(nb) = 0, or
;;; the conclusion that an explicit set is measurable and of measure 0.
;;;
;;; THE THEOREMS, in order.
;;;   (A) EPOW: its unfolds, values (0^p = 0, (+inf)^p = +inf, 1^p = 1, t^1 = t),
;;;       typing, strict and weak monotonicity, (t^a)^b = t^(ab) and the
;;;       inverse t |-> t^(1/p), (c u)^p = c^p u^p, the value of PTWISE-EPOW
;;;       and of PTWISE-EPLUS / -ETIMES / -SCALE at a point, and
;;;       measurable-fn-epow (the tail { al < f^p } is the tail { al^(1/p) < f }).
;;;   (B) young-scaled (Young with real weights c, d > 0), young-extended (the
;;;       notes' Lemma 2.18 on [0,+inf] with 0 . (+inf) = 0).
;;;   (C) integral-markov, integral-zero-null (integral 0 => { h > 0 } null),
;;;       ep-norm-zero-null (the notes' "I_p(f) = 0 implies f = 0 a.e."),
;;;       integral-ae-eq (Prop. 2.21), integral-ptwise-eq,
;;;       integral-finite-ae-finite (Prop. 2.23).
;;;   (D) hoelder (Prop. 2.17).
;;;   (E) conjugate-exponent, ep-norm-one, epow-split, etimes-distrib-left-star,
;;;       epow-eplus-le ((u+v)^p <= 2^p (u^p + v^p), the step the notes skip).
;;;   (F) minkowski (Prop. 2.19), 1 <= p.
;;;
;;; THE PROOFS.  Hoelder: I_p(f) = 0 gives f = 0 off a null set, so f g <= f^p
;;; there and integral(f g) <= integral(f^p) = 0 (integral-le-off-null); the
;;; same for g; an infinite factor makes the right side +inf; otherwise, with
;;; a = I_p(f), b = I_q(g) real > 0, Young with the weights 1/a, 1/b at each
;;; point, integrated (integral-monotone, -homogeneous, -additive), gives
;;; (1/(a b)) integral(f g) <= (1/p) a^-p a^p + (1/q) b^-q b^q = 1.
;;; Minkowski: p = 1 is additivity (ep-norm-one).  For p > 1 with q = p/(p-1):
;;; an infinite I_p(f) or I_p(g) makes the right side +inf; otherwise
;;; (f+g)^p <= 2^p (f^p + g^p) makes C = integral((f+g)^p) finite (the notes
;;; divide by C^(1/q) without saying why it is finite); C = 0 is trivial;
;;; otherwise (f+g)^p = (f+g)^(p-1) f + (f+g)^(p-1) g pointwise, Hoelder twice
;;; with ((f+g)^(p-1))^q = (f+g)^p gives C <= C^(1/q) (I_p(f) + I_p(g)), and
;;; C = C^(1/p) C^(1/q) cancels.
;;;
;;; NOTHING IS ASSERTED.  Every qed bills `modulo 0'.
;;;
;;; LOAD WINDOW.  lo: the latest citations are esum-nn-zero
;;; (theorem-library/outer-measure-construction), integral-le-off-null,
;;; integral-finite-null, integral-additive, measurable-fn-etimes,
;;; measurable-fn-eplus, measurable-fn-finite-part, measurable-fn-const,
;;; measurable-fn-of-nonneg-tails, rps-not-lt-le, rps-lt-le-trans, rps-le-total
;;; (theorem-library/integral-convergence), rr-mul-le-cancel-pos
;;; (theorem-library/primitive-uniform-limit), measure-countably-subadditive
;;; (theorem-library/measure-laws), young-inequality-star
;;; (theorem-library/rpow-star-convexity), and the vocabulary file
;;; structure-library/lp-inequalities, which must load first.  No late tactic
;;; (no contra, prep, ineq-supply); the kit procedures used (dk-crs-opaque!,
;;; dk-rewrite-h!, dk-name!, dk-lam-type!, dk-absurd!) are in driver-kit.scm.
;;; hi: nothing in the tree cites these names.  Slot: after
;;; theorem-library/outer-measure-construction, e.g. right after
;;; theorem-library/lebesgue-measure-line, the structure file first.
;;; Library: measure.
;;; ====================================================================

;;; =====================================================================
;;; (0) file-local kit, prefix lpi-.  Copied from integral-convergence.scm
;;;     (icv-) and rpow-star-convexity.scm (rsc-), renamed.
;;; =====================================================================

(define (lpi-check name)
  (if (not (proof-done? *ps*))
      (error "lp-inequalities: proof did not close" name
             (expression->string (dk-goal)))))

(define (lpi-and . fs)
  (let build ((fs fs))
    (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (build (cdr fs))))))

;;; the conjunctive antecedent, landed whole
(define (lpi-need! . fs)
  (dk-have! (apply lpi-and fs) (lambda () (dk-conj-close! (lambda () (ass))))))

;;; (IN t RR) by the closure laws, its atoms typed in context first
(define (lpi-type! t)
  (if (not (dk-asm? (list 'IN t 'RR)))
      (dk-have! (list 'IN t 'RR) (lambda () (type-term)))))

(define (lpi-keep-prop! . keepers)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! keepers)
    (if (not (sequent-node-grounded? leaf)) (prop))))

(define (lpi-conj-close! . opt)
  (let ((closer (if (pair? opt) (car opt) from-context!)))
    (let walk ()
      (let ((g (dk-goal)))
        (if (and (pair? g) (eq? (car g) 'AND))
            (for-each (lambda (k)
                        (if (not (sequent-node-grounded? k))
                            (begin (dk-focus! k) (walk))))
                      (dk-opened (lambda () (di))))
            (closer))))))

(define (lpi-real-case tm) (list 'AND (list 'IN tm 'RR) (list '<= 0 tm)))
(define (lpi-inf-case  tm) (list '= tm 'POS-INF))

;;; Split on tm in RR-POS-STAR: REAL-BODY with (IN tm RR), (<= 0 tm) in
;;; context, INF-BODY with (= tm POS-INF).
(define (lpi-star-cases! tm real-body inf-body)
  (have! (list 'OR (lpi-real-case tm) (lpi-inf-case tm))
         (lambda ()
           (let ((inst (dk-fact! 'rr-pos-star-membership tm)))
             (lpi-keep-prop! inst (list 'IN tm 'RR-POS-STAR)))))
  (use-cases (list (lpi-real-case tm) (lpi-inf-case tm))
    (lambda () (dk-split! (lpi-real-case tm)) (real-body))
    inf-body))

;;; Goal-free: (IN tm RR-POS-STAR) landed, with (IN tm RR) and (<= 0 tm) in context.
(define (lpi-rps! tm)
  (if (not (dk-asm? (list 'IN tm 'RR-POS-STAR)))
      (dk-have! (list 'IN tm 'RR-POS-STAR)
        (lambda ()
          (let ((inst (dk-fact! 'rr-pos-star-membership tm)))
            (lpi-keep-prop! inst (list 'IN tm 'RR) (list '<= 0 tm)))))))

;;; Set equality by elements: lands (= A B).
(define (lpi-set-eq! a b fwd! bwd!)
  (dk-have! (list 'FORALL 'ew_ (list 'IFF (list 'IN 'ew_ a) (list 'IN 'ew_ b)))
    (lambda ()
      (let ((w (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (for-each (lambda (l)
                    (dk-focus! l)
                    (if (equal? (dk-goal) (list 'in w b)) (fwd! w) (bwd! w)))
                  (dk-opened (lambda () (di)))))))
  (fact 'class-extensionality a b)
  (list '= a b))

(define (lpi-sep-in! closer)
  (for-each (lambda (l)
              (if (not (sequent-node-grounded? l))
                  (begin (dk-focus! l) (closer))))
            (dk-opened (lambda () (sep-mi)))))

;;; the three conjuncts of IS-MEASURABLE-FN(om, ca, fv), landed, kept
(define (lpi-mfn-parts! om ca fv)
  (let* ((iff (dk-cite! 'is-measurable-fn om ca fv))
         (rhs (caddr iff))
         (c1 (cadr rhs)) (c2 (cadr (caddr rhs))) (c3 (caddr (caddr rhs))))
    (map (lambda (c) (dk-project! c 'IS-MEASURABLE-FN (list 'IS-MEASURABLE-FN om ca fv)))
         (list c1 c2 c3))))

;;; the conjuncts of a structure predicate PRED(args), landed, kept
(define (lpi-parts! pred args)
  (let* ((iff (apply dk-cite! pred args))
         (rhs (caddr iff))
         (whole (cons pred args)))
    (let walk ((c rhs) (acc '()))
      (if (and (pair? c) (eq? (car c) 'AND))
          (walk (caddr c) (cons (dk-project! (cadr c) pred whole) acc))
          (reverse (cons (dk-project! c pred whole) acc))))))

;;; land (= (etimes u v) (* u v)); u, v real >= 0 in context
(define (lpi-etimes-eq! u v)
  (let ((e (list '= (list 'etimes u v) (list '* u v))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (fact 'etimes-real-defined u v)
            (subst (list '= (list 'etimes u v) (list 'bintimes u v)))
            (fact 'bintimes-apply u v)
            (subst (list '== (list 'bintimes u v) (list '* u v)))
            (lpi-type! (list '* u v))
            (rfl))))
    e))

;;; land (= (eplus u v) (+ u v)); u, v real >= 0 in context
(define (lpi-eplus-eq! u v)
  (let ((e (list '= (list 'eplus u v) (list '+ u v))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (fact 'eplus-real-defined u v)
            (subst (list '= (list 'eplus u v) (list 'binplus u v)))
            (fact 'binplus-apply u v)
            (subst (list '== (list 'binplus u v) (list '+ u v)))
            (lpi-type! (list '+ u v))
            (rfl))))
    e))

;;; (<= a b) from (< a b), a, b real
(define (lpi-le-of-lt! a b)
  (if (not (dk-asm? (list '<= a b)))
      (fact 'rr-lt-implies-le a b)))

;;; (<= x y) from (< x y), any x, y, by the definition of <
(define (lpi-le-of-lt-def! x y)
  (if (not (dk-asm? (list '<= x y)))
      (dk-have! (list '<= x y)
        (lambda () (let ((iff (dk-cite! '< x y))) (lpi-keep-prop! iff (list '< x y)))))))

;;; recip facts for a real c > 0: (IN (recip c) RR), (< 0 (recip c)), (= (* c (recip c)) 1),
;;; (NOT (= c 0))
(define (lpi-recip-facts! c)
  (if (not (dk-asm? (list 'NOT (list '= c 0)))) (fact 'rr-pos-ne-zero c))
  (lpi-need! (list 'IN c 'RR) (list 'NOT (list '= c 0)))
  (if (not (dk-asm? (list 'IN (list 'recip c) 'RR))) (fact 'rr-recip-closed c))
  (if (not (dk-asm? (list '< 0 (list 'recip c)))) (fact 'rr-recip-pos c))
  (if (not (dk-asm? (list '= (list '* c (list 'recip c)) 1))) (fact 'rr-recip-inverse c)))

;;; split on 0 < t or 0 = t, t real >= 0 in context
(define (lpi-zero-cases! t pos-body zero-body)
  (use-cases (dk-fact! 'rr-le-cases 0 t) pos-body zero-body))

;;; IS-MEASURABLE-FN from IS-SIMPLE-FN of a term, by the defining iff
(define (lpi-simple-mfn! tm)
  (let* ((iff (dk-cite! 'IS-SIMPLE-FN 'omega 'cA tm))
         (lhs (cadr iff)) (rhs (caddr iff)))
    (dk-have! (list 'IS-MEASURABLE-FN 'omega 'cA tm)
      (lambda ()
        (ai iff)
        (detach! (list 'IMPLIES lhs rhs))
        (dk-split! rhs)
        (dk-ass!)))))

;;; POS-RR e from (< 0 e), (IN e RR)
(define (lpi-pos-rr! e)
  (let ((iff (dk-cite! '< 0 e)))
    (dk-have! (list 'AND (list 'IN e 'RR)
                    (list 'AND (list '<= 0 e) (list 'NOT (list '= 0 e))))
      (lambda ()
        (lpi-keep-prop! iff (list '< 0 e) (list 'IN e 'RR)))))
  (let ((iff2 (dk-cite! 'pos-rr e)))
    (dk-have! (list 'POS-RR e)
      (lambda ()
        (lpi-keep-prop! iff2 (list 'AND (list 'IN e 'RR)
                             (list 'AND (list '<= 0 e)
                                   (list 'NOT (list '= 0 e)))))))))

;;; dk-abstract! with a hook PRE-BETA! on the value lane (icv-abstract!)
(define (lpi-abstract! dom cod body-of typer pre-beta!)
  (let* ((body  (body-of 'dkak_))
         (lam   (list 'VNB-LAMBDA 'dkak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'dkak_ (list 'IMPLIES (list 'IN 'dkak_ dom)
                                                    (list '== (list g 'dkak_) body)))))
         (claim (list 'FORSOME 'dkag_ (list 'AND (list 'IN 'dkag_ (list 'FUN dom cod))
                                            (vals 'dkag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (lpi-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!)))
                              (lambda ()
                                (if (dk-asm? (dk-goal))
                                    (ass)
                                    (dk-set-close! (cadr (dk-goal))))))
                (let ((k (dk-di-var!)))
                  (pre-beta! k)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "lpi-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "lpi-abstract!: the value equation did not land"
                          (expression->string (vals g))))))
      (cons g ve))))

;;; (= x y) for x, y in [0,+inf] from both <=
(define (lpi-antisym! x y)
  (lpi-need! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR))
  (lpi-need! (list '<= x y) (list '<= y x))
  (fact 'rr-pos-star-le-antisymm x y))

;;; the value of a pointwise operation HEAD(omega, a, b) at x: lands
;;; (= ((HEAD omega a b) x) RHS) by citing its value theorem; the arguments'
;;; values at x are typed in context first
(define (lpi-val! head args x rhs)
  (let ((eq (list '= (list (cons head (cons 'omega args)) x) rhs))
        (thm (cond ((eq? head 'PTWISE-EPLUS) 'ptwise-eplus-value)
                   ((eq? head 'PTWISE-ETIMES) 'ptwise-etimes-value)
                   ((eq? head 'PTWISE-SCALE) 'ptwise-scale-value)
                   (#t (error "lpi-val!: no value theorem for" head)))))
    (if (not (dk-asm? eq))
        (apply dk-cite! thm 'omega (append args (list x))))
    (if (not (dk-asm? eq)) (error "lpi-val!: the value did not land" (expression->string eq)))
    eq))

;;; (< 0 c) from (<= 0 c) and (NOT (= c 0)), c in RR or RR-POS-STAR
(define (lpi-pos-of-ne! c)
  (if (not (dk-asm? (list '< 0 c)))
      (dk-have! (list '< 0 c)
        (lambda ()
          (mac '<)
          (lpi-conj-close!
            (lambda ()
              (if (equal? (dk-goal) (list '<= 0 c))
                  (ass)
                  (begin
                    (di)
                    (fact 'equality-symmetry 0 c)
                    (lpi-keep-prop! (list '= c 0) (list 'NOT (list '= c 0)))))))))))

;;; =====================================================================
;;; (A) THE UNFOLDS AND THE ELEMENTARY LAWS OF EPOW.
;;; =====================================================================

;;; epow-unfold
(sp (make-wff '(FORALL ept_ (FORALL epp_
      (== (EPOW ept_ epp_) (IF (= ept_ POS-INF) POS-INF (RPOW-STAR ept_ epp_)))))))
(dk-peel!)
(mac 'EPOW)
(qrfl)
(lpi-check 'epow-unfold)
(qed 'epow-unfold)

;;; ep-norm-unfold
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL epp_ (FORALL epf_
      (== (EP-NORM omega cA mu epp_ epf_)
          (EPOW (INTEGRAL omega cA mu (PTWISE-EPOW omega epf_ epp_)) (recip epp_))))))))))
(dk-peel!)
(mac 'EP-NORM)
(qrfl)
(lpi-check 'ep-norm-unfold)
(qed 'ep-norm-unfold)

;;; rr-lt-pos-inf: a real is below +inf.
(sp (make-wff '(FORALL x (IMPLIES (IN x RR) (< x POS-INF)))))
(dk-peel!)
(mac '<)
(lpi-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) '<=)
        (begin
          (dk-have! '(IN x RR-STAR)
            (lambda ()
              (let ((iff (dk-cite! 'rr-star-membership 'x)))
                (lpi-keep-prop! iff '(IN x RR)))))
          (fact 'pos-inf-upper-bound 'x) (ass))
        (begin
          (let ((eq (dk-landed (lambda () (di)))))
            (dk-have! '(IN POS-INF RR) (lambda () (subst (list '= 'POS-INF 'x)) (ass))))
          (fact 'pos-inf-not-in-rr)
          (lpi-keep-prop! '(IN POS-INF RR) '(NOT (IN POS-INF RR)))))))
(lpi-check 'rr-lt-pos-inf)
(qed 'rr-lt-pos-inf)

;;; epow-pos-inf: (+inf)^p = +inf.
(sp (make-wff '(FORALL p_ (= (EPOW POS-INF p_) POS-INF))))
(dk-peel!)
(mac 'EPOW)
(let ((ift (cadr (dk-goal))))
  (for-each
    (lambda (l)
      (dk-focus! l)
      (if (equal? (dk-goal) (cadr ift)) (rfl) (ass)))
    (dk-opened (lambda () (if-true ift)))))
(lpi-check 'epow-pos-inf)
(qed 'epow-pos-inf)

;;; epow-real: for a real t, EPOW(t, p) == RPOW-STAR(t, p).
(sp (make-wff '(FORALL t_ (IMPLIES (IN t_ RR) (FORALL p_
      (== (EPOW t_ p_) (RPOW-STAR t_ p_)))))))
(dk-peel!)
(mac 'EPOW)
(let ((ift (cadr (dk-goal))))
  (for-each
    (lambda (l)
      (dk-focus! l)
      (if (dk-head-is? (dk-goal) 'NOT)
          (begin
            (di)
            (dk-have! '(IN POS-INF RR) (lambda () (subst '(= POS-INF t_)) (ass)))
            (fact 'pos-inf-not-in-rr)
            (lpi-keep-prop! '(IN POS-INF RR) '(NOT (IN POS-INF RR))))
          (ass)))
    (dk-opened (lambda () (if-false ift)))))
(lpi-check 'epow-real)
(qed 'epow-real)

;;; epow-zero: 0^p = 0 for p > 0.
(sp (make-wff '(FORALL p_ (IMPLIES (IN p_ RR) (IMPLIES (< 0 p_) (= (EPOW 0 p_) 0))))))
(dk-peel!)
(fact 'rr-zero-in)
(fact 'epow-real 0 'p_)
(fact 'rpow-star-zero-base 'p_)
(subst '(= (EPOW 0 p_) (RPOW-STAR 0 p_)))
(subst '(= (RPOW-STAR 0 p_) 0))
(rfl)
(lpi-check 'epow-zero)
(qed 'epow-zero)

;;; epow-one-base: 1^p = 1.
(sp (make-wff '(FORALL p_ (IMPLIES (IN p_ RR) (= (EPOW 1 p_) 1)))))
(dk-peel!)
(fact 'rr-one-in) (fact 'rr-zero-in) (fact 'rr-zero-lt-one)
(fact 'epow-real 1 'p_)
(fact 'rpow-star-value 1 'p_)
(fact 'log-one)
(fact 'rr-mul-zero 'p_)
(fact 'r-exp-zero)
(subst '(= (EPOW 1 p_) (RPOW-STAR 1 p_)))
(subst '(= (RPOW-STAR 1 p_) (R-EXP (* p_ (LOG 1)))))
(subst '(= (LOG 1) 0))
(subst '(= (* p_ 0) 0))
(subst '(= (R-EXP 0) 1))
(rfl)
(lpi-check 'epow-one-base)
(qed 'epow-one-base)

;;; epow-pos-real: for real t > 0, t^p is a real > 0.
(sp (make-wff '(FORALL t_ (IMPLIES (IN t_ RR) (IMPLIES (< 0 t_) (FORALL p_ (IMPLIES (IN p_ RR)
      (AND (IN (EPOW t_ p_) RR) (< 0 (EPOW t_ p_))))))))))
(dk-peel!)
(fact 'epow-real 't_ 'p_)
(fact 'rpow-star-in-rr 't_ 'p_)
(fact 'rpow-star-pos 't_ 'p_)
(subst '(= (EPOW t_ p_) (RPOW-STAR t_ p_)))
(lpi-conj-close! (lambda () (ass)))
(lpi-check 'epow-pos-real)
(qed 'epow-pos-real)

;;; epow-real-in: for real t >= 0 and p > 0, t^p is a real >= 0.
(sp (make-wff '(FORALL t_ (IMPLIES (IN t_ RR) (IMPLIES (<= 0 t_) (FORALL p_ (IMPLIES (IN p_ RR)
      (IMPLIES (< 0 p_) (AND (IN (EPOW t_ p_) RR) (<= 0 (EPOW t_ p_)))))))))))
(dk-peel!)
(fact 'rr-zero-in)
(lpi-zero-cases! 't_
  (lambda ()
    (dk-split! (dk-fact! 'epow-pos-real 't_ 'p_))
    (lpi-le-of-lt! 0 '(EPOW t_ p_))
    (lpi-conj-close! (lambda () (ass))))
  (lambda ()
    (subst '(= t_ 0))
    (fact 'epow-zero 'p_)
    (subst '(= (EPOW 0 p_) 0))
    (fact 'rr-leq-reflexive 0)
    (lpi-conj-close! (lambda () (ass)))))
(lpi-check 'epow-real-in)
(qed 'epow-real-in)

;;; epow-in: t^p is a point of [0,+inf] for t in [0,+inf] and p > 0.
(sp (make-wff '(FORALL t_ (IMPLIES (IN t_ RR-POS-STAR) (FORALL p_ (IMPLIES (IN p_ RR)
      (IMPLIES (< 0 p_) (IN (EPOW t_ p_) RR-POS-STAR))))))))
(dk-peel!)
(lpi-star-cases! 't_
  (lambda ()
    (dk-split! (dk-fact! 'epow-real-in 't_ 'p_))
    (lpi-rps! '(EPOW t_ p_)))
  (lambda ()
    (subst '(= t_ POS-INF))
    (fact 'epow-pos-inf 'p_)
    (subst '(= (EPOW POS-INF p_) POS-INF))
    (fact 'pos-inf-in-rr-pos-star)
    (ass)))
(lpi-check 'epow-in)
(qed 'epow-in)

;;; epow-strict-mono: s < t implies s^p < t^p, p > 0.
(sp (make-wff '(FORALL s_ (IMPLIES (IN s_ RR-POS-STAR) (FORALL t_ (IMPLIES (IN t_ RR-POS-STAR)
      (FORALL p_ (IMPLIES (IN p_ RR) (IMPLIES (< 0 p_)
        (IMPLIES (< s_ t_) (< (EPOW s_ p_) (EPOW t_ p_))))))))))))
(dk-peel!)
(fact 'rr-zero-in)
(lpi-le-of-lt-def! 's_ 't_)
(lpi-star-cases! 't_
  (lambda ()
    (lpi-need! '(IN s_ RR-POS-STAR) '(IN t_ RR))
    (fact 'rr-pos-star-le-real-in-rr 's_ 't_)
    (fact 'rr-pos-star-nonneg 's_)
    (lpi-zero-cases! 's_
      (lambda ()
        (fact 'rpow-star-mono-base 's_ 't_ 'p_)
        (fact 'epow-real 's_ 'p_)
        (fact 'epow-real 't_ 'p_)
        (subst '(= (EPOW s_ p_) (RPOW-STAR s_ p_)))
        (subst '(= (EPOW t_ p_) (RPOW-STAR t_ p_)))
        (ass))
      (lambda ()
        (dk-have! '(< 0 t_) (lambda () (subst '(= 0 s_)) (ass)))
        (subst '(= s_ 0))
        (fact 'epow-zero 'p_)
        (subst '(= (EPOW 0 p_) 0))
        (dk-split! (dk-fact! 'epow-pos-real 't_ 'p_))
        (ass))))
  (lambda ()
    (lpi-star-cases! 's_
      (lambda ()
        (dk-split! (dk-fact! 'epow-real-in 's_ 'p_))
        (subst '(= t_ POS-INF))
        (fact 'epow-pos-inf 'p_)
        (subst '(= (EPOW POS-INF p_) POS-INF))
        (fact 'rr-lt-pos-inf '(EPOW s_ p_))
        (ass))
      (lambda ()
        (dk-have! '(= s_ t_) (lambda () (subst '(= s_ POS-INF)) (subst '(= t_ POS-INF)) (rfl)))
        (let ((iff (dk-cite! '< 's_ 't_)))
          (lpi-keep-prop! iff '(< s_ t_) '(= s_ t_)))))))
(lpi-check 'epow-strict-mono)
(qed 'epow-strict-mono)

;;; epow-mono: s <= t implies s^p <= t^p, p > 0.
(sp (make-wff '(FORALL s_ (IMPLIES (IN s_ RR-POS-STAR) (FORALL t_ (IMPLIES (IN t_ RR-POS-STAR)
      (FORALL p_ (IMPLIES (IN p_ RR) (IMPLIES (< 0 p_)
        (IMPLIES (<= s_ t_) (<= (EPOW s_ p_) (EPOW t_ p_))))))))))))
(dk-peel!)
(fact 'epow-in 's_ 'p_)
(fact 'epow-in 't_ 'p_)
(use-em '(= s_ t_)
  (lambda ()
    (subst '(= s_ t_))
    (fact 'rr-pos-star-le-refl '(EPOW t_ p_))
    (ass))
  (lambda ()
    (dk-have! '(< s_ t_)
      (lambda () (let ((iff (dk-cite! '< 's_ 't_)))
                   (lpi-keep-prop! iff '(<= s_ t_) '(NOT (= s_ t_))))))
    (fact 'epow-strict-mono 's_ 't_ 'p_)
    (lpi-le-of-lt-def! '(EPOW s_ p_) '(EPOW t_ p_))
    (ass)))
(lpi-check 'epow-mono)
(qed 'epow-mono)

;;; epow-epow: (t^a)^b = t^(a b), a, b > 0.
(sp (make-wff '(FORALL t_ (IMPLIES (IN t_ RR-POS-STAR) (FORALL a_ (IMPLIES (IN a_ RR) (IMPLIES (< 0 a_)
      (FORALL b_ (IMPLIES (IN b_ RR) (IMPLIES (< 0 b_)
        (= (EPOW (EPOW t_ a_) b_) (EPOW t_ (* a_ b_)))))))))))))
(dk-peel!)
(fact 'rr-zero-in)
(fact 'rr-mul-in-rr 'a_ 'b_)
(fact 'rr-mul-pos 'a_ 'b_)
(lpi-star-cases! 't_
  (lambda ()
    (lpi-zero-cases! 't_
      (lambda ()
        (dk-split! (dk-fact! 'epow-pos-real 't_ 'a_))
        (fact 'epow-real '(EPOW t_ a_) 'b_)
        (fact 'epow-real 't_ 'a_)
        (fact 'epow-real 't_ '(* a_ b_))
        (fact 'rpow-star-pow 't_ 'a_ 'b_)
        (subst '(= (EPOW (EPOW t_ a_) b_) (RPOW-STAR (EPOW t_ a_) b_)))
        (subst '(= (EPOW t_ a_) (RPOW-STAR t_ a_)))
        (subst '(= (EPOW t_ (* a_ b_)) (RPOW-STAR t_ (* a_ b_))))
        (ass))
      (lambda ()
        (subst '(= t_ 0))
        (fact 'epow-zero 'a_)
        (fact 'epow-zero 'b_)
        (fact 'epow-zero '(* a_ b_))
        (subst '(= (EPOW 0 a_) 0))
        (subst '(= (EPOW 0 b_) 0))
        (subst '(= (EPOW 0 (* a_ b_)) 0))
        (rfl))))
  (lambda ()
    (subst '(= t_ POS-INF))
    (fact 'epow-pos-inf 'a_)
    (fact 'epow-pos-inf 'b_)
    (fact 'epow-pos-inf '(* a_ b_))
    (subst '(= (EPOW POS-INF a_) POS-INF))
    (subst '(= (EPOW POS-INF b_) POS-INF))
    (subst '(= (EPOW POS-INF (* a_ b_)) POS-INF))
    (rfl)))
(lpi-check 'epow-epow)
(qed 'epow-epow)

;;; epow-one: t^1 = t.
(sp (make-wff '(FORALL t_ (IMPLIES (IN t_ RR-POS-STAR) (= (EPOW t_ 1) t_)))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'rr-one-in) (fact 'rr-zero-lt-one)
(lpi-star-cases! 't_
  (lambda ()
    (lpi-zero-cases! 't_
      (lambda ()
        (fact 'epow-real 't_ 1)
        (fact 'rpow-star-one 't_)
        (subst '(= (EPOW t_ 1) (RPOW-STAR t_ 1)))
        (ass))
      (lambda ()
        (subst '(= t_ 0))
        (fact 'epow-zero 1)
        (ass))))
  (lambda ()
    (subst '(= t_ POS-INF))
    (fact 'epow-pos-inf 1)
    (ass)))
(lpi-check 'epow-one)
(qed 'epow-one)

;;; epow-inverse: (t^p)^(1/p) = t and (t^(1/p))^p = t, p > 0.
(sp (make-wff '(FORALL t_ (IMPLIES (IN t_ RR-POS-STAR) (FORALL p_ (IMPLIES (IN p_ RR) (IMPLIES (< 0 p_)
      (AND (= (EPOW (EPOW t_ p_) (recip p_)) t_)
           (= (EPOW (EPOW t_ (recip p_)) p_) t_)))))))))
(dk-peel!)
(fact 'rr-zero-in)
(lpi-recip-facts! 'p_)
(lpi-need! '(IN p_ RR) '(IN (recip p_) RR))
(fact 'rr-mul-comm 'p_ '(recip p_))
(dk-have! '(= (* (recip p_) p_) 1)
  (lambda () (subst '(= (* (recip p_) p_) (* p_ (recip p_)))) (ass)))
(fact 'epow-epow 't_ 'p_ '(recip p_))
(fact 'epow-epow 't_ '(recip p_) 'p_)
(fact 'epow-one 't_)
(dk-have! '(= (EPOW (EPOW t_ p_) (recip p_)) t_)
  (lambda ()
    (subst '(= (EPOW (EPOW t_ p_) (recip p_)) (EPOW t_ (* p_ (recip p_)))))
    (subst '(= (* p_ (recip p_)) 1))
    (dk-ass!)))
(dk-have! '(= (EPOW (EPOW t_ (recip p_)) p_) t_)
  (lambda ()
    (subst '(= (EPOW (EPOW t_ (recip p_)) p_) (EPOW t_ (* (recip p_) p_))))
    (subst '(= (* (recip p_) p_) 1))
    (dk-ass!)))
(lpi-conj-close! (lambda () (dk-ass!)))
(lpi-check 'epow-inverse)
(qed 'epow-inverse)

;;; epow-eq-zero: t^p = 0 implies t = 0, p > 0.
(sp (make-wff '(FORALL t_ (IMPLIES (IN t_ RR-POS-STAR) (FORALL p_ (IMPLIES (IN p_ RR) (IMPLIES (< 0 p_)
      (IMPLIES (= (EPOW t_ p_) 0) (= t_ 0)))))))))
(dk-peel!)
(fact 'rr-zero-in)
(lpi-star-cases! 't_
  (lambda ()
    (lpi-zero-cases! 't_
      (lambda ()
        (dk-split! (dk-fact! 'epow-pos-real 't_ 'p_))
        (dk-absurd! '(< 0 (EPOW t_ p_)) '(= (EPOW t_ p_) 0)))
      (lambda () (subst '(= t_ 0)) (rfl))))
  (lambda ()
    (dk-have! '(IN POS-INF RR)
      (lambda ()
        (fact 'epow-pos-inf 'p_)
        (subst '(= POS-INF (EPOW POS-INF p_)))
        (subst '(= POS-INF t_))
        (subst '(= (EPOW t_ p_) 0))
        (ass)))
    (fact 'pos-inf-not-in-rr)
    (lpi-keep-prop! '(IN POS-INF RR) '(NOT (IN POS-INF RR)))))
(lpi-check 'epow-eq-zero)
(qed 'epow-eq-zero)

;;; epow-eq-pos-inf: t^p = +inf implies t = +inf, p > 0.
(sp (make-wff '(FORALL t_ (IMPLIES (IN t_ RR-POS-STAR) (FORALL p_ (IMPLIES (IN p_ RR) (IMPLIES (< 0 p_)
      (IMPLIES (= (EPOW t_ p_) POS-INF) (= t_ POS-INF)))))))))
(dk-peel!)
(lpi-star-cases! 't_
  (lambda ()
    (dk-split! (dk-fact! 'epow-real-in 't_ 'p_))
    (dk-have! '(IN POS-INF RR) (lambda () (subst '(= POS-INF (EPOW t_ p_))) (ass)))
    (fact 'pos-inf-not-in-rr)
    (lpi-keep-prop! '(IN POS-INF RR) '(NOT (IN POS-INF RR))))
  (lambda () (ass)))
(lpi-check 'epow-eq-pos-inf)
(qed 'epow-eq-pos-inf)

;;; epow-etimes: (c u)^p = c^p u^p for a real c > 0, u in [0,+inf], p > 0.
(sp (make-wff '(FORALL c_ (IMPLIES (IN c_ RR) (IMPLIES (< 0 c_)
      (FORALL u_ (IMPLIES (IN u_ RR-POS-STAR) (FORALL p_ (IMPLIES (IN p_ RR) (IMPLIES (< 0 p_)
        (= (EPOW (etimes c_ u_) p_) (etimes (EPOW c_ p_) (EPOW u_ p_)))))))))))))
(dk-peel!)
(fact 'rr-zero-in)
(lpi-le-of-lt! 0 'c_)
(lpi-rps! 'c_)
(fact 'rr-pos-ne-zero 'c_)
(dk-split! (dk-fact! 'epow-pos-real 'c_ 'p_))
(lpi-le-of-lt! 0 '(EPOW c_ p_))
(lpi-rps! '(EPOW c_ p_))
(fact 'rr-pos-ne-zero '(EPOW c_ p_))
(lpi-star-cases! 'u_
  (lambda ()
    (lpi-zero-cases! 'u_
      (lambda ()
        (lpi-le-of-lt! 0 'u_)
        (lpi-etimes-eq! 'c_ 'u_)
        (subst '(= (etimes c_ u_) (* c_ u_)))
        (fact 'rr-mul-in-rr 'c_ 'u_)
        (fact 'rr-mul-pos 'c_ 'u_)
        (fact 'epow-real '(* c_ u_) 'p_)
        (fact 'epow-real 'c_ 'p_)
        (fact 'epow-real 'u_ 'p_)
        (fact 'rpow-star-mul-base 'c_ 'u_ 'p_)
        (fact 'rpow-star-in-rr 'u_ 'p_)
        (fact 'rpow-star-pos 'u_ 'p_)
        (fact 'rpow-star-in-rr 'c_ 'p_)
        (fact 'rpow-star-pos 'c_ 'p_)
        (lpi-le-of-lt! 0 '(RPOW-STAR u_ p_))
        (lpi-le-of-lt! 0 '(RPOW-STAR c_ p_))
        (subst '(= (EPOW (* c_ u_) p_) (RPOW-STAR (* c_ u_) p_)))
        (subst '(= (EPOW c_ p_) (RPOW-STAR c_ p_)))
        (subst '(= (EPOW u_ p_) (RPOW-STAR u_ p_)))
        (lpi-etimes-eq! '(RPOW-STAR c_ p_) '(RPOW-STAR u_ p_))
        (subst '(= (etimes (RPOW-STAR c_ p_) (RPOW-STAR u_ p_)) (* (RPOW-STAR c_ p_) (RPOW-STAR u_ p_))))
        (ass))
      (lambda ()
        (subst '(= u_ 0))
        (fact 'etimes-zero-right 'c_)
        (subst '(= (etimes c_ 0) 0))
        (fact 'epow-zero 'p_)
        (subst '(= (EPOW 0 p_) 0))
        (fact 'etimes-zero-right '(EPOW c_ p_))
        (subst '(= (etimes (EPOW c_ p_) 0) 0))
        (rfl))))
  (lambda ()
    (subst '(= u_ POS-INF))
    (fact 'etimes-pos-inf-right 'c_)
    (subst '(= (etimes c_ POS-INF) POS-INF))
    (fact 'epow-pos-inf 'p_)
    (subst '(= (EPOW POS-INF p_) POS-INF))
    (fact 'etimes-pos-inf-right '(EPOW c_ p_))
    (subst '(= (etimes (EPOW c_ p_) POS-INF) POS-INF))
    (rfl)))
(lpi-check 'epow-etimes)
(qed 'epow-etimes)

;;; =====================================================================
;;; (A') THE POINTWISE POWER: its value and its measurability.
;;; =====================================================================

;;; ptwise-epow-value
(sp (make-wff '(FORALL omega (FORALL f (IMPLIES (IN f (FUN omega RR-POS-STAR))
      (FORALL p_ (IMPLIES (IN p_ RR) (IMPLIES (< 0 p_)
        (FORALL x (IMPLIES (IN x omega)
          (= ((PTWISE-EPOW omega f p_) x) (EPOW (f x) p_))))))))))))
(dk-peel!)
(fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR 'x)
(fact 'epow-in '(f x) 'p_)
(mac 'PTWISE-EPOW)
(if (not (dk-lam-b!)) (rfl))
(lpi-check 'ptwise-epow-value)
(qed 'ptwise-epow-value)

;;; measurable-fn-epow: f measurable, p > 0  =>  f^p measurable.  The tail
;;; { al < f^p } is the tail { al^(1/p) < f } of f (al >= 0), because t |-> t^p
;;; is a strictly increasing bijection of [0,+inf] with inverse t |-> t^(1/p).
(sp (make-wff
  (forall-guarded '(omega cA f p_)
                  '((IS-MEASURABLE-FN omega cA f) (IN p_ RR) (< 0 p_))
    '(IS-MEASURABLE-FN omega cA (PTWISE-EPOW omega f p_)))))
(dk-peel!)
(let* ((parts (lpi-mfn-parts! 'omega 'cA 'f))
       (tails (caddr parts))
       (h '(PTWISE-EPOW omega f p_))
       (hx (lambda (x) (list h x))))
  (fact 'sigma-algebra-ambient-set 'omega 'cA)
  (fact 'rr-zero-in)
  (lpi-recip-facts! 'p_)
  (dk-have! (list 'IN h '(FUN omega RR-POS-STAR))
    (lambda ()
      (mac 'PTWISE-EPOW)
      (dk-lam-type! (lambda ()
                      (let ((x (dk-di-var!)))
                        (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR x)
                        (fact 'epow-in (list 'f x) 'p_)
                        (dk-ass!))))))
  (let ((val (dk-fact! 'ptwise-epow-value 'omega 'f 'p_)))
    (dk-have! (list 'FORALL 'al_ (list 'IMPLIES '(IN al_ RR) (list 'IMPLIES '(<= 0 al_)
                (list 'IN (list 'SEP 'x_ 'omega (list '< 'al_ (hx 'x_))) 'cA))))
      (lambda ()
        (dk-peel!)
        (let* ((g (dk-goal))
               (al (cadr (cadddr (cadr g))))
               (be (list 'EPOW al '(recip p_)))
               (ta (cadr g))
               (tb (list 'SEP 'x_ 'omega (list '< be '(f x_)))))
          (lpi-rps! al)
          (dk-split! (dk-fact! 'epow-real-in al '(recip p_)))
          (lpi-rps! be)
          (dk-apply! tails be)
          (let ((inv (dk-fact! 'epow-inverse al 'p_)))
            (dk-split! inv))
          (lpi-set-eq! ta tb
            (lambda (w)                         ; w in ta  =>  w in tb
              (sep-me (list 'IN w ta))
              (let ((vw (dk-apply! val w))
                    (fw (list 'f w)))
                (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR w)
                (fact 'epow-in fw 'p_)
                (dk-rewrite-h! (list '< al (hx w)) (hx w) (list 'EPOW fw 'p_))
                (lpi-sep-in!
                  (lambda ()
                    (if (dk-asm? (dk-goal))
                        (ass)
                        (use-em (list '< be fw)
                          (lambda () (ass))
                          (lambda ()
                            (fact 'rps-not-lt-le be fw)
                            (fact 'epow-mono fw be 'p_)
                            (fact 'epow-in be 'p_)
                            (dk-have! (list '<= (list 'EPOW be 'p_) al)
                              (lambda ()
                                (subst (list '= (list 'EPOW be 'p_) al))
                                (fact 'rr-pos-star-le-refl al)
                                (ass)))
                            (lpi-need! (list 'IN fw 'RR-POS-STAR)
                                       (list 'IN (list 'EPOW fw 'p_) 'RR-POS-STAR)
                                       (list 'IN al 'RR-POS-STAR))
                            (lpi-need! (list 'IN (list 'EPOW fw 'p_) 'RR-POS-STAR)
                                       (list 'IN (list 'EPOW be 'p_) 'RR-POS-STAR)
                                       (list 'IN al 'RR-POS-STAR))
                            (lpi-need! (list '<= (list 'EPOW fw 'p_) (list 'EPOW be 'p_))
                                       (list '<= (list 'EPOW be 'p_) al))
                            (fact 'rr-pos-star-le-trans (list 'EPOW fw 'p_) (list 'EPOW be 'p_) al)
                            (fact 'rps-lt-le-trans al (list 'EPOW fw 'p_) al)
                            (fact 'rr-lt-irrefl al)
                            (lpi-keep-prop! (list '< al al) (list 'NOT (list '< al al))))))))))
            (lambda (w)                         ; w in tb  =>  w in ta
              (sep-me (list 'IN w tb))
              (let ((vw (dk-apply! val w))
                    (fw (list 'f w)))
                (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR w)
                (fact 'epow-strict-mono be fw 'p_)
                (dk-rewrite-h! (list '< (list 'EPOW be 'p_) (list 'EPOW fw 'p_))
                               (list 'EPOW be 'p_) al)
                (lpi-sep-in!
                  (lambda ()
                    (if (dk-asm? (dk-goal))
                        (ass)
                        (begin
                          (subst (list '= (hx w) (list 'EPOW fw 'p_)))
                          (ass))))))))
          (subst (list '= ta tb))
          (ass))))
    (fact 'measurable-fn-of-nonneg-tails 'omega 'cA h)
    (dk-ass!)))
(lpi-check 'measurable-fn-epow)
(qed 'measurable-fn-epow)
(topic! 'measurable-fn-epow 'analysis)

;;; The values of the pointwise operations of structure-library/integral.scm at
;;; a point, as theorems: a driver that unfolds PTWISE-EPLUS by `mac' rewrites
;;; EVERY occurrence, including one nested in an argument.
(sp (make-wff '(FORALL omega (FORALL f (FORALL g (FORALL x
  (IMPLIES (IN x omega) (IMPLIES (IN (f x) RR-POS-STAR) (IMPLIES (IN (g x) RR-POS-STAR)
    (= ((PTWISE-EPLUS omega f g) x) (eplus (f x) (g x))))))))))))
(dk-peel!)
(lpi-need! '(IN (f x) RR-POS-STAR) '(IN (g x) RR-POS-STAR))
(fact 'eplus-closed '(f x) '(g x))
(mac 'PTWISE-EPLUS)
(if (not (dk-lam-b!)) (rfl))
(lpi-check 'ptwise-eplus-value)
(qed 'ptwise-eplus-value)

(sp (make-wff '(FORALL omega (FORALL f (FORALL g (FORALL x
  (IMPLIES (IN x omega) (IMPLIES (IN (f x) RR-POS-STAR) (IMPLIES (IN (g x) RR-POS-STAR)
    (= ((PTWISE-ETIMES omega f g) x) (etimes (f x) (g x))))))))))))
(dk-peel!)
(lpi-need! '(IN (f x) RR-POS-STAR) '(IN (g x) RR-POS-STAR))
(fact 'etimes-closed '(f x) '(g x))
(mac 'PTWISE-ETIMES)
(if (not (dk-lam-b!)) (rfl))
(lpi-check 'ptwise-etimes-value)
(qed 'ptwise-etimes-value)

(sp (make-wff '(FORALL omega (FORALL c_ (FORALL f (FORALL x
  (IMPLIES (IN x omega) (IMPLIES (IN c_ RR-POS-STAR) (IMPLIES (IN (f x) RR-POS-STAR)
    (= ((PTWISE-SCALE omega c_ f) x) (etimes c_ (f x))))))))))))
(dk-peel!)
(lpi-need! '(IN c_ RR-POS-STAR) '(IN (f x) RR-POS-STAR))
(fact 'etimes-closed 'c_ '(f x))
(mac 'PTWISE-SCALE)
(if (not (dk-lam-b!)) (rfl))
(lpi-check 'ptwise-scale-value)
(qed 'ptwise-scale-value)

;;; =====================================================================
;;; (B) YOUNG'S INEQUALITY IN [0,+inf] (the notes' Lemma 2.18, extended to
;;;     a, b in [0,+inf] with 0 . (+inf) = 0), first with two real weights
;;;     c, d > 0 (the form Hoelder integrates):
;;;
;;;        (c d)(u v) <= (c^p / p) u^p + (d^q / q) v^q.
;;;
;;;     u = 0 or v = 0: the left side is 0.  u = +inf (v = +inf): the right
;;;     side is +inf.  u, v real > 0: young-inequality-star at c u, d v.
;;; =====================================================================

(sp (make-wff '(FORALL c_ (IMPLIES (IN c_ RR) (IMPLIES (< 0 c_)
  (FORALL d_ (IMPLIES (IN d_ RR) (IMPLIES (< 0 d_)
  (FORALL u_ (IMPLIES (IN u_ RR-POS-STAR) (FORALL v_ (IMPLIES (IN v_ RR-POS-STAR)
  (FORALL p (IMPLIES (AND (IN p RR) (< 1 p)) (FORALL q (IMPLIES (AND (IN q RR) (< 1 q))
    (IMPLIES (= (+ (/ 1 p) (/ 1 q)) 1)
      (<= (etimes (* c_ d_) (etimes u_ v_))
          (eplus (etimes (* (recip p) (EPOW c_ p)) (EPOW u_ p))
                 (etimes (* (recip q) (EPOW d_ q)) (EPOW v_ q)))))))))))))))))))))
(dk-peel!)
(dk-split-all!)
(fact 'rr-zero-in) (fact 'rr-one-in)
(dk-have! '(< 0 p) (lambda () (dk-ineq! '(< 1 p))))
(dk-have! '(< 0 q) (lambda () (dk-ineq! '(< 1 q))))
(lpi-recip-facts! 'p)
(lpi-recip-facts! 'q)
(let* ((rp '(recip p)) (rq '(recip q))
       (ec '(EPOW c_ p)) (ed '(EPOW d_ q))
       (kc (list '* rp ec)) (kd (list '* rq ed))
       (eu '(EPOW u_ p)) (ev '(EPOW v_ q))
       (cd '(* c_ d_))
       (uv '(etimes u_ v_))
       (lhs (list 'etimes cd uv))
       (x1 (list 'etimes kc eu)) (x2 (list 'etimes kd ev))
       (rhs (list 'eplus x1 x2))
       (posreal! (lambda (a b)            ; (* a b) real > 0, >= 0, in [0,+inf]
                   (fact 'rr-mul-in-rr a b)
                   (fact 'rr-mul-pos a b)
                   (lpi-le-of-lt! 0 (list '* a b))
                   (lpi-rps! (list '* a b))))
       (lhs-zero! (lambda (eq!)
                    (dk-have! (list '= lhs 0) eq!)
                    (fact 'rr-pos-star-nonneg rhs)
                    (subst (list '= lhs 0))
                    (ass)))
       (rhs-inf! (lambda (eq!)
                   (dk-have! (list '= rhs 'POS-INF) eq!)
                   (fact 'rr-pos-star-below-pos-inf lhs)
                   (subst (list '= rhs 'POS-INF))
                   (ass))))
  (dk-split! (dk-fact! 'epow-pos-real 'c_ 'p))
  (dk-split! (dk-fact! 'epow-pos-real 'd_ 'q))
  (posreal! rp ec)
  (posreal! rq ed)
  (posreal! 'c_ 'd_)
  (fact 'rr-pos-ne-zero kc)
  (fact 'rr-pos-ne-zero kd)
  (fact 'epow-in 'u_ 'p)
  (fact 'epow-in 'v_ 'q)
  (lpi-need! (list 'IN kc 'RR-POS-STAR) (list 'IN eu 'RR-POS-STAR))
  (fact 'etimes-closed kc eu)
  (lpi-need! (list 'IN kd 'RR-POS-STAR) (list 'IN ev 'RR-POS-STAR))
  (fact 'etimes-closed kd ev)
  (lpi-need! '(IN u_ RR-POS-STAR) '(IN v_ RR-POS-STAR))
  (fact 'etimes-closed 'u_ 'v_)
  (lpi-need! (list 'IN cd 'RR-POS-STAR) (list 'IN uv 'RR-POS-STAR))
  (fact 'etimes-closed cd uv)
  (lpi-need! (list 'IN x1 'RR-POS-STAR) (list 'IN x2 'RR-POS-STAR))
  (fact 'eplus-closed x1 x2)
  (let ((zero-u! (lambda ()
                   (subst '(= u_ 0))
                   (fact 'etimes-zero-left 'v_)
                   (subst '(= (etimes 0 v_) 0))
                   (fact 'etimes-zero-right cd)
                   (subst (list '= (list 'etimes cd 0) 0))
                   (rfl)))
        (zero-v! (lambda ()
                   (subst '(= v_ 0))
                   (fact 'etimes-zero-right 'u_)
                   (subst '(= (etimes u_ 0) 0))
                   (fact 'etimes-zero-right cd)
                   (subst (list '= (list 'etimes cd 0) 0))
                   (rfl)))
        (inf-u! (lambda ()
                  (subst '(= u_ POS-INF))
                  (fact 'epow-pos-inf 'p)
                  (subst '(= (EPOW POS-INF p) POS-INF))
                  (fact 'etimes-pos-inf-right kc)
                  (subst (list '= (list 'etimes kc 'POS-INF) 'POS-INF))
                  (fact 'eplus-pos-inf-left x2)
                  (subst (list '= (list 'eplus 'POS-INF x2) 'POS-INF))
                  (rfl)))
        (inf-v! (lambda ()
                  (subst '(= v_ POS-INF))
                  (fact 'epow-pos-inf 'q)
                  (subst '(= (EPOW POS-INF q) POS-INF))
                  (fact 'etimes-pos-inf-right kd)
                  (subst (list '= (list 'etimes kd 'POS-INF) 'POS-INF))
                  (fact 'eplus-pos-inf-right x1)
                  (subst (list '= (list 'eplus x1 'POS-INF) 'POS-INF))
                  (rfl)))
        (real-case!
          (lambda ()
            (lpi-le-of-lt! 0 'u_) (lpi-le-of-lt! 0 'v_)
            (lpi-etimes-eq! 'u_ 'v_)
            (posreal! 'u_ 'v_)
            (lpi-etimes-eq! cd '(* u_ v_))
            (dk-split! (dk-fact! 'epow-pos-real 'u_ 'p))
            (dk-split! (dk-fact! 'epow-pos-real 'v_ 'q))
            (lpi-le-of-lt! 0 eu) (lpi-le-of-lt! 0 ev)
            (lpi-le-of-lt! 0 kc) (lpi-le-of-lt! 0 kd)
            (lpi-etimes-eq! kc eu)
            (lpi-etimes-eq! kd ev)
            (posreal! kc eu)
            (posreal! kd ev)
            (lpi-eplus-eq! (list '* kc eu) (list '* kd ev))
            (subst '(= (etimes u_ v_) (* u_ v_)))
            (subst (list '= (list 'etimes cd '(* u_ v_)) (list '* cd '(* u_ v_))))
            (subst (list '= x1 (list '* kc eu)))
            (subst (list '= x2 (list '* kd ev)))
            (subst (list '= (list 'eplus (list '* kc eu) (list '* kd ev))
                         (list '+ (list '* kc eu) (list '* kd ev))))
            (for-each (lambda (b e) (fact 'epow-real b e)
                                    (fact 'rpow-star-in-rr b e)
                                    (fact 'rpow-star-pos b e))
                      '(c_ u_ d_ v_) '(p p q q))
            (subst '(= (EPOW c_ p) (RPOW-STAR c_ p)))
            (subst '(= (EPOW u_ p) (RPOW-STAR u_ p)))
            (subst '(= (EPOW d_ q) (RPOW-STAR d_ q)))
            (subst '(= (EPOW v_ q) (RPOW-STAR v_ q)))
            (posreal! 'c_ 'u_)
            (posreal! 'd_ 'v_)
            (fact 'rpow-star-mul-base 'c_ 'u_ 'p)
            (fact 'rpow-star-mul-base 'd_ 'v_ 'q)
            (fact 'rpow-star-in-rr '(* c_ u_) 'p)
            (fact 'rpow-star-in-rr '(* d_ v_) 'q)
            (let ((e1 '(= (* (* c_ d_) (* u_ v_)) (* (* c_ u_) (* d_ v_))))
                  (e2 '(= (* (* (recip p) (RPOW-STAR c_ p)) (RPOW-STAR u_ p))
                          (/ (RPOW-STAR (* c_ u_) p) p)))
                  (e3 '(= (* (* (recip q) (RPOW-STAR d_ q)) (RPOW-STAR v_ q))
                          (/ (RPOW-STAR (* d_ v_) q) q))))
              (dk-have! e1 (lambda () (crs)))
              (dk-have! e2 (lambda ()
                             (mac 'binary-divide-def)
                             (subst '(= (RPOW-STAR (* c_ u_) p) (* (RPOW-STAR c_ p) (RPOW-STAR u_ p))))
                             (dk-crs-opaque!)))
              (dk-have! e3 (lambda ()
                             (mac 'binary-divide-def)
                             (subst '(= (RPOW-STAR (* d_ v_) q) (* (RPOW-STAR d_ q) (RPOW-STAR v_ q))))
                             (dk-crs-opaque!)))
              (lpi-need! '(IN (* c_ u_) RR) '(< 0 (* c_ u_)))
              (lpi-need! '(IN (* d_ v_) RR) '(< 0 (* d_ v_)))
              (lpi-need! '(IN p RR) '(< 1 p))
              (lpi-need! '(IN q RR) '(< 1 q))
              (fact 'young-inequality-star '(* c_ u_) '(* d_ v_) 'p 'q)
              (subst e1) (subst e2) (subst e3)
              (ass)))))
    (lpi-star-cases! 'u_
      (lambda ()
        (lpi-zero-cases! 'u_
          (lambda ()
            (lpi-star-cases! 'v_
              (lambda ()
                (lpi-zero-cases! 'v_
                  real-case!
                  (lambda () (lhs-zero! zero-v!))))
              (lambda () (rhs-inf! inf-v!))))
          (lambda () (lhs-zero! zero-u!))))
      (lambda () (rhs-inf! inf-u!)))))
(lpi-check 'young-scaled)
(qed 'young-scaled)

;;; young-extended: the notes' Lemma 2.18 on [0,+inf] -- a b <= a^p/p + b^q/q.
(sp (make-wff '(FORALL a (IMPLIES (IN a RR-POS-STAR) (FORALL b (IMPLIES (IN b RR-POS-STAR)
  (FORALL p (IMPLIES (AND (IN p RR) (< 1 p)) (FORALL q (IMPLIES (AND (IN q RR) (< 1 q))
    (IMPLIES (= (+ (/ 1 p) (/ 1 q)) 1)
      (<= (etimes a b)
          (eplus (etimes (recip p) (EPOW a p)) (etimes (recip q) (EPOW b q)))))))))))))))
(dk-peel!)
(dk-split-all!)
(fact 'rr-zero-in) (fact 'rr-one-in) (fact 'rr-zero-lt-one)
(dk-have! '(< 0 p) (lambda () (dk-ineq! '(< 1 p))))
(dk-have! '(< 0 q) (lambda () (dk-ineq! '(< 1 q))))
(lpi-recip-facts! 'p)
(lpi-recip-facts! 'q)
(lpi-need! '(IN p RR) '(< 1 p))
(lpi-need! '(IN q RR) '(< 1 q))
(let* ((ys (dk-fact! 'young-scaled 1 1 'a 'b 'p 'q))
       (e1 (dk-fact! 'epow-one-base 'p))
       (e2 (dk-fact! 'epow-one-base 'q)))
  (dk-have! '(= (* (recip p) 1) (recip p)) (lambda () (dk-crs-opaque!)))
  (dk-have! '(= (* (recip q) 1) (recip q)) (lambda () (dk-crs-opaque!)))
  (dk-have! '(= (* 1 1) 1) (lambda () (crs)))
  (lpi-need! '(IN a RR-POS-STAR) '(IN b RR-POS-STAR))
  (fact 'etimes-closed 'a 'b)
  (fact 'etimes-one-left '(etimes a b))
  (let* ((h1 (dk-rewrite-h! ys '(EPOW 1 p) 1))
         (h2 (dk-rewrite-h! h1 '(EPOW 1 q) 1))
         (h3 (dk-rewrite-h! h2 '(* (recip p) 1) '(recip p)))
         (h4 (dk-rewrite-h! h3 '(* (recip q) 1) '(recip q)))
         (h5 (dk-rewrite-h! h4 '(* 1 1) 1))
         (h6 (dk-rewrite-h! h5 '(etimes 1 (etimes a b)) '(etimes a b))))
    (ass)))
(lpi-check 'young-extended)
(qed 'young-extended)
(topic! 'young-extended 'analysis)

;;; =====================================================================
;;; (C) NULL SETS FROM INTEGRALS: Markov's inequality, a function of
;;;     integral 0 vanishes off a null set (the lemma behind "I_p(f) = 0
;;;     implies f = 0 a.e." in the proof of Prop. 2.17), the notes'
;;;     Prop. 2.21 and Prop. 2.23.
;;; =====================================================================

;;; etimes-eq-zero-pos: c m = 0 with c a real > 0 forces m = 0.
(sp (make-wff '(FORALL c_ (IMPLIES (IN c_ RR) (IMPLIES (< 0 c_)
      (FORALL m (IMPLIES (IN m RR-POS-STAR) (IMPLIES (= (etimes c_ m) 0) (= m 0)))))))))
(dk-peel!)
(fact 'rr-zero-in)
(lpi-le-of-lt! 0 'c_)
(lpi-rps! 'c_)
(fact 'rr-pos-ne-zero 'c_)
(lpi-star-cases! 'm
  (lambda ()
    (lpi-zero-cases! 'm
      (lambda ()
        (lpi-le-of-lt! 0 'm)
        (lpi-etimes-eq! 'c_ 'm)
        (fact 'rr-mul-in-rr 'c_ 'm)
        (fact 'rr-mul-pos 'c_ 'm)
        (dk-rewrite-h! '(= (etimes c_ m) 0) '(etimes c_ m) '(* c_ m))
        (dk-absurd! '(< 0 (* c_ m)) '(= (* c_ m) 0)))
      (lambda () (subst '(= m 0)) (rfl))))
  (lambda ()
    (fact 'etimes-pos-inf-right 'c_)
    (dk-have! '(IN POS-INF RR)
      (lambda ()
        (subst '(= POS-INF (etimes c_ POS-INF)))
        (subst '(= POS-INF m))
        (subst '(= (etimes c_ m) 0))
        (ass)))
    (fact 'pos-inf-not-in-rr)
    (lpi-keep-prop! '(IN POS-INF RR) '(NOT (IN POS-INF RR)))))
(lpi-check 'etimes-eq-zero-pos)
(qed 'etimes-eq-zero-pos)

;;; integral-markov: c . mu{ c <= h } <= integral h, for a real c >= 0.
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL h (FORALL c_
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IS-MEASURABLE-FN omega cA h)
            (IMPLIES (IN c_ RR)
              (IMPLIES (<= 0 c_)
                (<= (etimes c_ (mu (SEP gx_ omega (<= c_ (h gx_)))))
                    (INTEGRAL omega cA mu h)))))))))))))
(dk-peel!)
(lpi-parts! 'IS-MEASURE '(omega cA mu))
(lpi-mfn-parts! 'omega 'cA 'h)
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(fact 'rr-zero-in) (fact 'rr-one-in)
(let* ((aa '(SEP gx_ omega (<= c_ (h gx_))))
       (ind (list 'INDICATOR 'omega aa))
       (gk (list 'PTWISE-SCALE 'omega 'c_ ind))
       (m (list 'mu aa))
       (ii '(INTEGRAL omega cA mu h)))
  (dk-fact! 'measurable-fn-ge 'omega 'cA 'h 'c_)
  (lpi-rps! 'c_)
  (fact 'indicator-simple 'omega 'cA aa)
  (fact 'simple-fn-scale 'omega 'cA ind 'c_)
  (lpi-simple-mfn! gk)
  (fact 'measurable-fn-indicator 'omega 'cA aa)
  (fact 'integral-homogeneous 'omega 'cA 'mu ind 'c_)
  (fact 'integral-indicator 'omega 'cA 'mu aa)
  (dk-have! (list 'PTWISE-LE 'omega gk 'h)
    (lambda ()
      (mac 'PTWISE-LE)
      (let* ((x (dk-di-var!)) (hx (list 'h x)))
        (fact 'fun-apply-type-c 'h 'omega 'RR-POS-STAR x)
        (mac 'PTWISE-SCALE)
        (if (dk--redex? (dk-goal)) (dk-lam-b!))
        (use-em (list 'IN x aa)
          (lambda ()
            (fact 'indicator-value-in 'omega aa x)
            (subst (list '= (list ind x) 1))
            (dk-have! '(<= 0 1) (lambda () (dk-ineq! '(IN 1 RR))))
            (lpi-etimes-eq! 'c_ 1)
            (subst (list '= '(etimes c_ 1) '(* c_ 1)))
            (dk-have! '(= (* c_ 1) c_) (lambda () (crs)))
            (subst '(= (* c_ 1) c_))
            (sep-me (list 'IN x aa))
            (dk-ass!))
          (lambda ()
            (fact 'indicator-value-out 'omega aa x)
            (subst (list '= (list ind x) 0))
            (fact 'etimes-zero-right 'c_)
            (subst '(= (etimes c_ 0) 0))
            (fact 'rr-pos-star-nonneg hx)
            (dk-ass!))))))
  (fact 'integral-monotone 'omega 'cA 'mu gk 'h)
  (subst (list '= m (list 'INTEGRAL 'omega 'cA 'mu ind)))
  (subst (list '= (list 'etimes 'c_ (list 'INTEGRAL 'omega 'cA 'mu ind)) (list 'INTEGRAL 'omega 'cA 'mu gk)))
  (dk-ass!))
(lpi-check 'integral-markov)
(qed 'integral-markov)
(topic! 'integral-markov 'analysis)

;;; integral-zero-null: a measurable h with integral 0 vanishes off a null set:
;;; mu{ 0 < h } = 0.  { 0 < h } is the union over n of { 1/(n+1) <= h }, each of
;;; measure 0 by Markov; countable subadditivity.
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL h
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IS-MEASURABLE-FN omega cA h)
            (IMPLIES (= (INTEGRAL omega cA mu h) 0)
              (= (mu (SEP x_ omega (< 0 (h x_)))) 0))))))))))
(dk-peel!)
(lpi-parts! 'IS-MEASURE '(omega cA mu))
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(fact 'rr-zero-in) (fact 'rr-one-in) (fact 'zero-in-rr-pos-star)
(let* ((pf (lpi-mfn-parts! 'omega 'cA 'h))
       (tails (caddr pf))
       (ee '(SEP x_ omega (< 0 (h x_))))
       (ii '(INTEGRAL omega cA mu h))
       (cof (lambda (k) (list 'recip (list '+ k 1))))
       (body-of (lambda (k) (list 'SEP 'gx_ 'omega (list '<= (cof k) '(h gx_)))))
       (ctype! (lambda (k)            ; k in NN: 1/(k+1) a real > 0, >= 0
                 (fact 'nn-in-rr k)
                 (fact 'nn-zero-le k)
                 (lpi-type! (list '+ k 1))
                 (dk-have! (list '< 0 (list '+ k 1)) (lambda () (dk-ineq! (list '<= 0 k))))
                 (lpi-recip-facts! (list '+ k 1))
                 (lpi-le-of-lt! 0 (cof k))
                 (lpi-rps! (cof k))))
       (inca! (lambda (k)
                (ctype! k)
                (dk-cite! 'measurable-fn-ge 'omega 'cA 'h (cof k))))
       (hve (lpi-abstract! 'NN 'cA body-of
              (lambda (k) (inca! k) (dk-ass!))
              (lambda (k) (inca! k) (fact 'membership-implies-sethood (body-of k) 'cA))))
       (hf (car hve)) (ve (cdr hve))
       (bu (list 'BIG-UNION 'n_ 'NN (list hf 'n_)))
       (ll (list 'VNB-LAMBDA 'n_ 'NN (list 'mu (list hf 'n_)))))
  (dk-apply! tails 0)
  (let ((zero-at!
          (lambda (k)
            (inca! k)
            (let* ((c (cof k)) (bk (body-of k)) (mb (list 'mu bk)))
              (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR bk)
              (let ((mk (dk-fact! 'integral-markov 'omega 'cA 'mu 'h c)))
                (dk-rewrite-h! mk ii 0))
              (lpi-need! (list 'IN c 'RR-POS-STAR) (list 'IN mb 'RR-POS-STAR))
              (fact 'etimes-closed c mb)
              (fact 'rr-pos-star-nonneg (list 'etimes c mb))
              (lpi-antisym! (list 'etimes c mb) 0)
              (fact 'etimes-eq-zero-pos c mb)
              (dk-apply! ve k)
              (dk-have! (list '= (list 'mu (list hf k)) 0)
                (lambda () (subst (list '== (list hf k) bk)) (dk-ass!)))))))
    (dk-have! (list 'IN ll '(FUN NN RR-POS-STAR))
      (lambda ()
        (dk-lam-type! (lambda ()
                        (let ((k (dk-di-var!)))
                          (fact 'fun-apply-type-c hf 'NN 'cA k)
                          (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (list hf k))
                          (dk-ass!)))
                      (lambda ()
                        (if (dk-asm? (dk-goal)) (ass) (dk-set-close! (cadr (dk-goal))))))))
    (dk-have! (list 'FORALL 'ozn (list 'IMPLIES '(IN ozn NN) (list '= (list ll 'ozn) 0)))
      (lambda ()
        (let ((k (dk-di-var!)))
          (zero-at! k)
          (fact 'fun-apply-type-c hf 'NN 'cA k)
          (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (list hf k))
          (if (not (dk-lam-b!)) (dk-ass!)))))
    (fact 'esum-nn-zero ll)
    (fact 'sigma-algebra-union-closed 'omega 'cA hf)
    (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR bu)
    (let ((sa (dk-cite! 'measure-countably-subadditive 'omega 'cA 'mu hf)))
      (dk-rewrite-h! sa (list 'ESUM ll) 0))
    (fact 'rr-pos-star-nonneg (list 'mu bu))
    (lpi-antisym! (list 'mu bu) 0)
    (lpi-set-eq! ee bu
      (lambda (w)                            ; w in {0 < h}  =>  w in the union
        (let ((hw (list 'h w)))
          (sep-me (list 'IN w ee))
          (fact 'fun-apply-type-c 'h 'omega 'RR-POS-STAR w)
          (let ((into! (lambda (k)          ; (<= (cof k) hw) in context
                         (inca! k)
                         (dk-apply! ve k)
                         (dk-have! (list 'IN w (list hf k))
                           (lambda ()
                             (subst (list '== (list hf k) (body-of k)))
                             (lpi-sep-in! (lambda () (dk-ass!)))))
                         (for-each (lambda (l)
                                     (if (not (sequent-node-grounded? l))
                                         (begin (dk-focus! l) (ass))))
                                   (dk-opened (lambda () (bu-mi k)))))))
            (lpi-star-cases! hw
              (lambda ()
                (lpi-pos-rr! hw)
                (let* ((ex (dk-fact! 'recip-succ-small hw))
                       (k (dk-skolem! ex))
                       (al (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'm_)))
                                    "the tail bound")))
                  (fact 'nn-in-rr k)
                  (fact 'rr-leq-reflexive k)
                  (dk-apply! al k)
                  (into! k)))
              (lambda ()
                (fact 'nn-zero-in)
                (ctype! 0)
                (fact 'rr-pos-star-below-pos-inf (cof 0))
                (dk-have! (list '<= (cof 0) hw)
                  (lambda () (subst (list '= hw 'POS-INF)) (dk-ass!)))
                (into! 0))))))
      (lambda (w)                            ; w in the union  =>  w in {0 < h}
        (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
               (nin (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'nn))) landed)))
               (k (cadr nin))
               (hw (list 'h w)))
          (inca! k)
          (dk-apply! ve k)
          (dk-have! (list 'IN w (body-of k))
            (lambda () (subst (list '= (body-of k) (list hf k))) (dk-ass!)))
          (sep-me (list 'IN w (body-of k)))
          (fact 'fun-apply-type-c 'h 'omega 'RR-POS-STAR w)
          (lpi-sep-in!
            (lambda ()
              (if (dk-asm? (dk-goal))
                  (ass)
                  (begin
                    (fact 'rps-lt-le-trans 0 (cof k) hw)
                    (dk-ass!))))))))
    (subst (list '= ee bu))
    (dk-ass!)))
(lpi-check 'integral-zero-null)
(qed 'integral-zero-null)
(topic! 'integral-zero-null 'analysis)

;;; ep-norm-zero-null: the notes' "if I_p(f) = 0 then f = 0 a.e." (proof of
;;; Prop. 2.17): { 0 < f } is measurable and null.
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL f (FORALL p_
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IS-MEASURABLE-FN omega cA f)
            (IMPLIES (IN p_ RR)
              (IMPLIES (< 0 p_)
                (IMPLIES (= (EP-NORM omega cA mu p_ f) 0)
                  (AND (IN (SEP x_ omega (< 0 (f x_))) cA)
                       (= (mu (SEP x_ omega (< 0 (f x_)))) 0))))))))))))))
(dk-peel!)
(lpi-parts! 'IS-MEASURE '(omega cA mu))
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(fact 'rr-zero-in) (fact 'zero-in-rr-pos-star)
(lpi-recip-facts! 'p_)
(let* ((pf (lpi-mfn-parts! 'omega 'cA 'f))
       (tails (caddr pf))
       (fp '(PTWISE-EPOW omega f p_))
       (aa (list 'INTEGRAL 'omega 'cA 'mu fp))
       (ef '(SEP x_ omega (< 0 (f x_))))
       (ep (list 'SEP 'x_ 'omega (list '< 0 (list fp 'x_)))))
  (fact 'measurable-fn-epow 'omega 'cA 'f 'p_)
  (fact 'integral-in 'omega 'cA 'mu fp)
  (fact 'ep-norm-unfold 'omega 'cA 'mu 'p_ 'f)
  (dk-rewrite-h! '(= (EP-NORM omega cA mu p_ f) 0) '(EP-NORM omega cA mu p_ f) (list 'EPOW aa '(recip p_)))
  (fact 'epow-eq-zero aa '(recip p_))
  (fact 'integral-zero-null 'omega 'cA 'mu fp)
  (dk-apply! tails 0)
  (let ((val (dk-fact! 'ptwise-epow-value 'omega 'f 'p_)))
    (lpi-set-eq! ef ep
      (lambda (w)
        (let ((fw (list 'f w)))
          (sep-me (list 'IN w ef))
          (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR w)
          (dk-apply! val w)
          (fact 'epow-strict-mono 0 fw 'p_)
          (fact 'epow-zero 'p_)
          (dk-rewrite-h! (list '< '(EPOW 0 p_) (list 'EPOW fw 'p_)) '(EPOW 0 p_) 0)
          (lpi-sep-in!
            (lambda ()
              (if (dk-asm? (dk-goal))
                  (ass)
                  (begin (subst (list '= (list fp w) (list 'EPOW fw 'p_))) (dk-ass!)))))))
      (lambda (w)
        (let ((fw (list 'f w)))
          (sep-me (list 'IN w ep))
          (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR w)
          (dk-apply! val w)
          (dk-rewrite-h! (list '< 0 (list fp w)) (list fp w) (list 'EPOW fw 'p_))
          (fact 'rr-pos-star-nonneg fw)
          (lpi-sep-in!
            (lambda ()
              (if (dk-asm? (dk-goal))
                  (ass)
                  (use-em (list '= 0 fw)
                    (lambda ()
                      (fact 'epow-zero 'p_)
                      (let ((h1 (dk-rewrite-h! (list '< 0 (list 'EPOW fw 'p_)) fw 0)))
                        (dk-rewrite-h! h1 '(EPOW 0 p_) 0))
                      (fact 'rr-lt-irrefl 0)
                      (lpi-keep-prop! '(< 0 0) '(NOT (< 0 0))))
                    (lambda ()
                      (let ((iff (dk-cite! '< 0 fw)))
                        (lpi-keep-prop! iff (list '<= 0 fw) (list 'NOT (list '= 0 fw))))))))))))
    (let ((pfp (lpi-mfn-parts! 'omega 'cA fp)))
      (dk-apply! (caddr pfp) 0))
    (subst (list '= ef ep))
    (lpi-conj-close! (lambda () (dk-ass!)))))
(lpi-check 'ep-norm-zero-null)
(qed 'ep-norm-zero-null)
(topic! 'ep-norm-zero-null 'analysis)

;;; integral-ae-eq: the notes' Prop. 2.21 -- f = g except on a null set nb
;;; implies integral f = integral g.
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL nb (FORALL f (FORALL g
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IN nb cA)
            (IMPLIES (= (mu nb) 0)
              (IMPLIES (IS-MEASURABLE-FN omega cA f)
                (IMPLIES (IS-MEASURABLE-FN omega cA g)
                  (IMPLIES (FORALL x (IMPLIES (IN x omega) (IMPLIES (NOT (IN x nb)) (= (f x) (g x)))))
                    (= (INTEGRAL omega cA mu f) (INTEGRAL omega cA mu g))))))))))))))))
(dk-peel!)
(lpi-mfn-parts! 'omega 'cA 'f)
(lpi-mfn-parts! 'omega 'cA 'g)
(let ((heq '(FORALL x (IMPLIES (IN x omega) (IMPLIES (NOT (IN x nb)) (= (f x) (g x))))))
      (le! (lambda (a b)
             (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega)
                         (list 'IMPLIES '(NOT (IN x nb)) (list '<= (list a 'x) (list b 'x)))))
               (lambda ()
                 (dk-peel!)
                 (let* ((g0 (dk-goal)) (x (cadr (cadr g0))))
                   (dk-apply! '(FORALL x (IMPLIES (IN x omega) (IMPLIES (NOT (IN x nb)) (= (f x) (g x))))) x)
                   (fact 'fun-apply-type-c 'g 'omega 'RR-POS-STAR x)
                   (subst (list '= (list 'f x) (list 'g x)))
                   (fact 'rr-pos-star-le-refl (list 'g x))
                   (dk-ass!)))))))
  (le! 'f 'g)
  (le! 'g 'f)
  (fact 'integral-le-off-null 'omega 'cA 'mu 'nb 'f 'g)
  (fact 'integral-le-off-null 'omega 'cA 'mu 'nb 'g 'f)
  (fact 'integral-in 'omega 'cA 'mu 'f)
  (fact 'integral-in 'omega 'cA 'mu 'g)
  (lpi-antisym! '(INTEGRAL omega cA mu f) '(INTEGRAL omega cA mu g))
  (dk-ass!))
(lpi-check 'integral-ae-eq)
(qed 'integral-ae-eq)
(topic! 'integral-ae-eq 'analysis)

;;; integral-ptwise-eq: functions equal at every point have the same integral.
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL f (FORALL g
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IS-MEASURABLE-FN omega cA f)
            (IMPLIES (IS-MEASURABLE-FN omega cA g)
              (IMPLIES (FORALL x (IMPLIES (IN x omega) (= (f x) (g x))))
                (= (INTEGRAL omega cA mu f) (INTEGRAL omega cA mu g)))))))))))))
(dk-peel!)
(lpi-parts! 'IS-MEASURE '(omega cA mu))
(fact 'sigma-algebra-empty-in 'omega 'cA)
(dk-have! '(FORALL x (IMPLIES (IN x omega) (IMPLIES (NOT (IN x EMPTY-SET)) (= (f x) (g x)))))
  (lambda ()
    (dk-peel!)
    (let ((x (cadr (cadr (dk-goal)))))
      (dk-apply! '(FORALL x (IMPLIES (IN x omega) (= (f x) (g x)))) x)
      (dk-ass!))))
(fact 'integral-ae-eq 'omega 'cA 'mu 'EMPTY-SET 'f 'g)
(dk-ass!)
(lpi-check 'integral-ptwise-eq)
(qed 'integral-ptwise-eq)

;;; integral-finite-ae-finite: the notes' Prop. 2.23 -- a measurable f with
;;; finite integral is finite almost everywhere: { f = +inf } is measurable and
;;; null.  (integral-finite-null, integral-convergence.scm, is the same fact
;;; stated for the complement of { f real }; this is the notes' wording.)
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL f
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IS-MEASURABLE-FN omega cA f)
            (IMPLIES (< (INTEGRAL omega cA mu f) POS-INF)
              (AND (IN (SEP x_ omega (= (f x_) POS-INF)) cA)
                   (= (mu (SEP x_ omega (= (f x_) POS-INF))) 0)))))))))))
(dk-peel!)
(lpi-parts! 'IS-MEASURE '(omega cA mu))
(lpi-mfn-parts! 'omega 'cA 'f)
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(let* ((ii '(INTEGRAL omega cA mu f))
       (fs '(SEP fp_ omega (IN (f fp_) RR)))
       (nb (list 'COMPLEMENT-IN 'omega fs))
       (ei '(SEP x_ omega (= (f x_) POS-INF))))
  (fact 'integral-in 'omega 'cA 'mu 'f)
  (lpi-star-cases! ii
    (lambda () #t)
    (lambda ()
      (let ((iff (dk-cite! '< ii 'POS-INF)))
        (dk-have! (list '= ii 'POS-INF) (lambda () (dk-ass!)))
        (lpi-keep-prop! iff (list '< ii 'POS-INF) (list '= ii 'POS-INF)))))
  (fact 'integral-finite-null 'omega 'cA 'mu 'f)
  (fact 'measurable-fn-finite-part 'omega 'cA 'f)
  (fact 'sigma-algebra-complement-closed 'omega 'cA fs)
  (lpi-set-eq! ei nb
    (lambda (w)
      (let ((fw (list 'f w)))
        (sep-me (list 'IN w ei))
        (mac 'complement-in-membership)
        (lpi-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (begin
                  (di)
                  (sep-me (list 'IN w fs))
                  (dk-rewrite-h! (list 'IN fw 'RR) fw 'POS-INF)
                  (fact 'pos-inf-not-in-rr)
                  (lpi-keep-prop! '(IN POS-INF RR) '(NOT (IN POS-INF RR)))))))))
    (lambda (w)
      (let ((fw (list 'f w)))
        (mac-h 'complement-in-membership (list 'IN w nb))
        (dk-split-all!)
        (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR w)
        (lpi-sep-in!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (lpi-star-cases! fw
                  (lambda ()
                    (dk-have! (list 'IN w fs) (lambda () (lpi-sep-in! (lambda () (dk-ass!)))))
                    (lpi-keep-prop! (list 'IN w fs) (list 'NOT (list 'IN w fs))))
                  (lambda () (dk-ass!)))))))))
  (subst (list '= ei nb))
  (lpi-conj-close! (lambda () (dk-ass!))))
(lpi-check 'integral-finite-ae-finite)
(qed 'integral-finite-ae-finite)
(topic! 'integral-finite-ae-finite 'analysis)

