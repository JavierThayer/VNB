;;; theorem-library/zz-number-theory.scm -- ALGEBRAIC-NUMBERS NOTES ch. 1: division with remainder, the gcd, the
;;; Chinese remainder theorem (ALGNUM, bundles B1 and B4, 2026-10-26).
;;; Vocabulary: structure-library/zz-divisibility.scm (ZZ-DIVIDES, ZZ-IS-GCD, ZZ-COPRIME, ZZ-BEZOUT-SET),
;;; structure-library/zz-nt-vocab.scm (EULER-PHI, ZZ-RESIDUE).
;;;
;;; THE HEADLINES.
;;;   nn-floor-unique              LEMMA 1.11: a >= 1: a unique n >= 0 with a n <= b < a n + a.
;;;   nn-division-remainder, nn-division-remainder-unique   PROP. 1.12: b = a n + r, 0 <= r < a, uniquely.
;;;   zz-gcd-remainder             PROP. 1.13: b = a n + r gives gcd(a, b) = gcd(a, r) (as ZZ-IS-GCD, an iff).
;;;   euclid-two-steps-halve       LEMMA 1.15: two steps of the Euclidean algorithm halve a.
;;;   zz-gcd-in-bezout-set         COR. 1.17: a gcd of a and b lies in the ideal generated by a and b.
;;;   zz-chinese-remainder         THM. 1.31, congruence form: every system x = a_i (mod n_i), i < k, is solvable iff
;;;                                the n_i are pairwise coprime.  The family is n(0), ..., n(k-1), n in FUN(NN, ZZ).
;;;   zz-linear-congruences        COR. 1.34: c_i x = a_i (mod n_i) is solvable for n_i pairwise coprime and
;;;                                c_i coprime to n_i.
;;;   euler-phi-multiplicative     PROP. 1.23: phi(m n) = phi(m) phi(n) for coprime m, n >= 1, by the Chinese
;;;                                remainder bijection k |-> (k mod m, k mod n) of {1..mn}; zz-residue-in /
;;;                                zz-residue-unique (the residue in {1..m}), zz-coprime-congruent, zz-coprime-sym,
;;;                                zz-coprime-factor, zz-coprime-divides-product, zz-small-multiple-zero.
;;;   Supporting: zz-divides-lincomb, zz-divides-mul-right, zz-divides-trans, zz-coprime-bezout (coprime iff
;;;   x a + y b = 1), zz-coprime-mul, nn-mul-gap, zz-crt-strong (the induction: a common multiple M, coprime to
;;;   whatever all n_i are coprime to, and a solution of every system).
;;;
;;; LOAD WINDOW.  lo: zz-divisibility, zz-bezout (theorem-library), nn-division, zz-divides-antisym,
;;; nn-succ-plus-one, rr-mul-le-right.  hi: none.  Library: algebra (core arithmetic plus Z divisibility).
;;; Helper prefixes nt-, nt2-.

(define (ap-absurd!) (dk-cite! 'rr-lt-irrefl 0) (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0)))))
;;; (0) the ma- kit
;;; (0) the ma- kit (file-local; most from push-forward.scm's pfw- kit and product-measure.scm's pms- kit)

(define (ma-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; dk-project!, except that a claim equal to the focus goal is proved in place
(define (ma-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
;;; sequential map (MIT evaluates arguments right to left)
(define (ma-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (ma-for-each f l) (let loop ((l l)) (if (pair? l) (begin (f (car l)) (loop (cdr l))))))
;;; the right-hand conjuncts of an IFF in context whose left side is in context, landed (by prop, on a lane)
(define (ma-iff-parts! iff0)
  (let* ((iff (or (dk-ctx-form iff0) (error "ma-iff-parts!: not in context" (expression->string iff0))))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    ;; the conjunct that is the focus goal (closed in place) goes LAST: closing it moves the focus
    (let* ((goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
           (late  (filter goal? cs))
           (early (filter (lambda (c) (not (goal? c))) cs)))
      (ma-map (lambda (c) (ma-by-prop! c (list iff (cadr iff)))) (append early late))
      cs)))
;;; the LEFT side of an IFF in context whose right side is in context, landed
(define (ma-iff-back! iff0)
  (let ((iff (or (dk-ctx-form iff0) (error "ma-iff-back!: not in context" (expression->string iff0)))))
    (ma-by-prop! (cadr iff)
      (cons iff (let ((r (caddr iff)))
                  (if (dk-asm? r)
                      (list r)
                      (let loop ((r r) (acc '()))
                        (if (and (pair? r) (eq? (car r) 'AND) (not (dk-asm? r)))
                            (loop (caddr r) (cons (cadr r) acc))
                            (reverse (cons r acc))))))))))
;;; CLAIM by prop from the formulas FS: on a lane, or in place when CLAIM is the focus goal; returns CLAIM
(define (ma-by-prop! claim fs)
  (cond ((dk-asm? claim) (dk-ctx-form claim))
        ((eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
         (ma-prop-with! fs) claim)
        (#t (dk-have! claim (lambda () (ma-prop-with! fs))) (dk-ctx-form claim))))
;;; (IN w (SEP v A P)) in context: land (IN w A) and P[w], the membership kept; return P[w].
(define (ma-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s (caddr m)) (v (cadr s)) (dom (caddr s))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "ma-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (let ((c (dk-ctx-form conj))) (if c (ai c)))))
    p))
;;; class extensionality, each direction driven: FWD / BWD procedures of the element; lands lhs = rhs
(define (ma-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'mew_ (list 'IFF (list 'IN 'mew_ lhs) (list 'IN 'mew_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs)
  (list '= lhs rhs))
;;; w in BIG-UNION(v, D, g(v)) gives the index and w in g(index): returns (k . formula)
(define (ma-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (caddr bu)))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
;;; prove the focus goal (IN w bu) at the index k (k in D and w in the k-th term in context)
(define (ma-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
;;; prop on the named formulas only
(define (ma-prop-with! fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))
;;; (IN z (UNION a b)) from (IN z a) / (IN z b) in context
(define (ma-in-union-left! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-l) (dk-ass!))))
(define (ma-in-union-right! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-r) (dk-ass!))))
;;; (IN x (PAIR x x)), x in SET in context
(define (ma-in-singleton! xv)
  (dk-have! (list 'IN xv (list 'PAIR xv xv))
    (lambda ()
      (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
      (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) xv)))
        (dk-have! (list '= xv xv) (lambda () (rfl)))
        (ma-prop-with! (list pm (list '= xv xv)))))))
;;; with (IN b (PAIR x x)) and x in SET in context, land b = x
(define (ma-singleton-eq! b xv)
  (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
  (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) b)))
    (dk-have! (list '= b xv)
      (lambda () (ma-prop-with! (list pm (list 'IN b (list 'PAIR xv xv))))))
    (list '= b xv)))

;;; FINITE-SET INDUCTION (pms-induct!, product-measure.scm).  PROP-OF builds P(s); BASE! proves P(EMPTY-SET)
;;; on its leaf; (STEP! sv xv u ih) proves P(u), u = sv u {xv}, with ih = P(sv) in context.  Returns P(xs).
(define (ma-class prop-of) (list 'COMP 'miu_ (prop-of 'miu_)))
(define (ma-step-formula c)
  (list 'FORALL 'is_
    (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ c)))
      (list 'FORALL 'ix_
        (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
          (list 'IN '(UNION is_ (PAIR ix_ ix_)) c))))))
(define (ma-induct! xs prop-of base! step!)
  (let* ((c     (ma-class prop-of))
         (stepf (ma-step-formula c)))
    (have! (list 'IN 'EMPTY-SET c)
      (lambda ()
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) '(in empty-set set))
                (begin (fact 'empty-set-is-set) (ass))
                (base!)))
          (dk-opened (lambda () (comp-mi))))))
    (have! stepf
      (lambda ()
        (let* ((landed (dk-peel!))
               (g      (dk-goal))
               (u      (cadr g))
               (sv     (cadr u))
               (xv     (cadr (caddr u))))
          (dk-split-all! landed)
          (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
          (fact 'pairing xv xv)
          (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET)))
          (fact 'union-set-closure sv (list 'PAIR xv xv))
          (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv c)))))
                 (ih (car (filter (lambda (f) (not (equal? f (list 'in sv 'set)))) ls))))
            (for-each
              (lambda (leaf)
                (dk-focus! leaf)
                (if (equal? (dk-goal) (list 'in u 'set))
                    (ass)
                    (step! sv xv u ih)))
              (dk-opened (lambda () (comp-mi))))))))
    (dk-have! (list 'AND (list 'IN 'EMPTY-SET c) stepf))
    (let ((ind (dk-fact! 'finite-set-induction c)))
      (dk-have! (list 'AND (list 'IN xs 'SET) (list 'IN (list 'CARD xs) 'NN)))
      (let* ((inx (dk-apply! ind xs))
             (ls  (dk-landed (lambda () (comp-me inx)))))
        (car (filter (lambda (f) (not (equal? f (list 'in xs 'set)))) ls))))))
;;; the membership laws whose instances make the two memberships propositionally equivalent
(define (ma-ext-prop! lhs rhs cites)
  (let ((side (lambda (have)
                (lambda (w)
                  (let ((fs (ma-map (lambda (c) (apply dk-cite! (car c) (cdr c))) (cites w))))
                    (ma-prop-with! (cons (list 'IN w have) fs)))))))
    (ma-ext2! lhs rhs (side lhs) (side rhs))))

;;; (SUBSET (SEP v d p) d)
(define (ma-sep-subset! sep)
  (dk-have! (list 'SUBSET sep (caddr sep))
    (lambda ()
      (mac 'subset-def)
      (let ((z (dk-di-var!)))
        (ma-sep-parts! (list 'IN z sep))
        (ass)))))
;;; s subset of the finite set ca (ca in SET, CARD ca in NN in context): land (IN s SET), (IN (CARD s) NN)
(define (ma-finite-sub! s ca)
  (fact 'subclass-of-set-is-set s ca)
  (dk-have! (list 'AND (list 'IN ca 'SET) (list 'IN (list 'CARD ca) 'NN)))
  (let ((cs (dk-fact! 'card-subset-nn ca)))
    (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s ca z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))))
    (dk-apply! cs s)))

;;; case split on a right-nested disjunction ORF in context, one THUNK per disjunct (each run with that
;;; disjunct in context, on its own leaf)
(define (ma-or-split! orf thunks)
  (let* ((o (or (dk-ctx-form orf) (error "ma-or-split!: not in context" (expression->string orf))))
         (l (cadr o)) (r (caddr o)))
    (for-each
      (lambda (leaf)
        (dk-focus! leaf)
        (cond ((dk-asm? l) ((car thunks)))
              ((pair? (cddr thunks)) (ma-or-split! r (cdr thunks)))
              (#t ((cadr thunks)))))
      (dk-opened (lambda () (ai o))))))
;;; f in FUN(NN, A) and every f(k) in B: f in FUN(NN, B)   (pfw-retype!, push-forward.scm)
(define (ma-retype! fv a b in-b!)
  (dk-have! (list 'IN fv (list 'FUN 'NN b))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c fv 'NN a kv)
                (ma-then-ass! (lambda () (in-b! (list fv kv)))))
              (begin
                (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN fv (list 'FUN 'NN a))))))
                (ass))))))))
;;; a function symbol G in FUN(DOM, COD) with G(k) == BODY(k): returns (G . VALUE-EQUATION)   (pfw-abstract!)
(define (ma-abstract! dom cod body-of typer pre)
  (let* ((body  (body-of 'mak_))
         (lam   (list 'VNB-LAMBDA 'mak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'mak_ (list 'IMPLIES (list 'IN 'mak_ dom)
                                                    (list '== (list g 'mak_) body)))))
         (claim (list 'FORSOME 'mag_ (list 'AND (list 'IN 'mag_ (list 'FUN dom cod))
                                            (vals 'mag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!))))
                (let ((kv (dk-di-var!)))
                  (pre kv)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "ma-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "ma-abstract!: the value equation did not land"))))
      (cons g ve))))



;;; (40) ALGEBRAIC-NUMBERS ch. 1, bundle B1 (integers): division with remainder, unique (1.11, 1.12), the gcd and
;;; the remainder (1.13), the gcd lies in the ideal generated by a, b (1.17).  Helper prefix nt-.
(define (nt-nn! . xs) (for-each (lambda (x) (fact 'nn-in-rr x)) xs))

;;; a combination of multiples of d is a multiple of d
(sp (make-wff (forall-guarded '(d x y s t) '((ZZ-DIVIDES d x) (ZZ-DIVIDES d y) (IN s ZZ) (IN t ZZ))
  '(ZZ-DIVIDES d (+ (* s x) (* t y))))))
(dk-peel!)
(dk-project! '(IN d ZZ) 'zz-divides '(ZZ-DIVIDES d x))
(dk-project! '(IN x ZZ) 'zz-divides '(ZZ-DIVIDES d x))
(dk-project! '(IN y ZZ) 'zz-divides '(ZZ-DIVIDES d y))
(let* ((c1 (dk-skolem! (dk-project! '(FORSOME c_ (AND (IN c_ ZZ) (= x (* d c_)))) 'zz-divides '(ZZ-DIVIDES d x))))
       (c2 (dk-skolem! (dk-project! '(FORSOME c_ (AND (IN c_ ZZ) (= y (* d c_)))) 'zz-divides '(ZZ-DIVIDES d y))))
       (w (list '+ (list '* 's c1) (list '* 't c2))))
  (dk-type! '(+ (* s x) (* t y)) 'ZZ)
  (dk-type! w 'ZZ)
  (mac 'zz-divides)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (ew w)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (begin (subst (list '= 'x (list '* 'd c1))) (subst (list '= 'y (list '* 'd c2))) (crs))))))))))
(qed 'zz-divides-lincomb)

;;; a n + a <= a m when n < m
(sp (make-wff (forall-guarded '(a n m) '((IN a NN) (IN n NN) (IN m NN) (< n m)) '(<= (+ (* a n) a) (* a m)))))
(dk-peel!)
(fact 'nn-succ-closed 'n)
(nt-nn! 'a 'n 'm '(succ n))
(dk-apply! (dk-cite! 'nn-lt-succ-le 'n 'm))
(dk-have! '(<= 0 a) (lambda () (dk-nn!)))
(dk-apply! (dk-cite! 'rr-mul-le-right '(succ n) 'm 'a))
(dk-apply! (dk-cite! 'nn-succ-plus-one) 'n)
(let ((h (dk-rewrite-h! '(<= (* (succ n) a) (* m a)) '(succ n) '(+ n 1))))
  (dk-have! '(= (+ (* a n) a) (* (+ n 1) a)) (lambda () (crs)))
  (dk-have! '(= (* a m) (* m a)) (lambda () (crs)))
  (subst '(= (+ (* a n) a) (* (+ n 1) a)))
  (subst '(= (* a m) (* m a)))
  (ass))
(qed 'nn-mul-gap)

;;; PROP. 1.12, existence: b = a n + r with 0 <= r < a
(define (nt-qr a b) (list 'FORSOME 'ntn_ (list 'AND '(IN ntn_ NN) (list 'FORSOME 'ntr_ (list 'AND '(IN ntr_ NN) (list 'AND (list '= b (list '+ (list '* a 'ntn_) 'ntr_)) (list '< 'ntr_ a)))))))
(sp (make-wff (forall-guarded '(a b) '((IN a NN) (IN b NN) (<= 1 a)) (nt-qr 'a 'b))))
(dk-peel!)
(dk-have! '(NOT (= a 0)) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-nn! '(= a 0) '(<= 1 a)))) (ap-absurd!)))
(let* ((q (dk-skolem! (dk-apply! (dk-cite! 'nn-division) 'b 'a)))
       (r (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f q))) (dk-asms)))))
  (ew q)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (ew r)
            (dk-conj-close!
              (lambda ()
                (cond ((dk-ass!) #t)
                      ((dk-head-is? (dk-goal) '<) (dk-nn! (list '<= (list 'succ r) 'a)))
                      (#t (subst (list '= 'b (list '+ (list '* q 'a) r))) (crs))))))))))
(qed 'nn-division-remainder)

;;; PROP. 1.12, uniqueness
(sp (make-wff (forall-guarded '(a b n r m s) '((IN a NN) (IN b NN) (IN n NN) (IN r NN) (IN m NN) (IN s NN)
                                              (= b (+ (* a n) r)) (< r a) (= b (+ (* a m) s)) (< s a))
  '(AND (= n m) (= r s)))))
(dk-peel!)
(nt-nn! 'a 'b 'n 'r 'm 's)
(dk-type! '(* a n) 'RR) (dk-type! '(* a m) 'RR)
(dk-have! '(<= 0 r) (lambda () (dk-nn!))) (dk-have! '(<= 0 s) (lambda () (dk-nn!)))
(dk-have! '(= n m)
  (lambda ()
    (ma-or-split! (dk-apply! (dk-cite! 'rr-lt-trichotomy 'n 'm))
      (list (lambda ()
              (dk-apply! (dk-cite! 'nn-mul-gap) 'a 'n 'm)
              (dk-have! '(< 0 0) (lambda () (dk-ineq! '(<= (+ (* a n) a) (* a m)) '(= b (+ (* a n) r)) '(= b (+ (* a m) s)) '(< r a) '(<= 0 s) '(IN (* a n) RR) '(IN (* a m) RR) '(IN a RR) '(IN b RR) '(IN r RR) '(IN s RR))))
              (ap-absurd!))
            (lambda () (ass))
            (lambda ()
              (dk-apply! (dk-cite! 'nn-mul-gap) 'a 'm 'n)
              (dk-have! '(< 0 0) (lambda () (dk-ineq! '(<= (+ (* a m) a) (* a n)) '(= b (+ (* a n) r)) '(= b (+ (* a m) s)) '(< s a) '(<= 0 r) '(IN (* a n) RR) '(IN (* a m) RR) '(IN a RR) '(IN b RR) '(IN r RR) '(IN s RR))))
              (ap-absurd!))))))
(let ((h (dk-rewrite-h! '(= b (+ (* a n) r)) 'n 'm)))
  (dk-have! '(<= r s) (lambda () (dk-ineq! h '(= b (+ (* a m) s)) '(IN (* a m) RR) '(IN b RR) '(IN r RR) '(IN s RR))))
  (dk-have! '(<= s r) (lambda () (dk-ineq! h '(= b (+ (* a m) s)) '(IN (* a m) RR) '(IN b RR) '(IN r RR) '(IN s RR))))
  (dk-apply! (dk-cite! 'nn-le-antisym 'r 's))
  (dk-conj-close! dk-ass!))
(qed 'nn-division-remainder-unique)

;;; LEMMA 1.11: there is a unique n >= 0 with a n <= b < a n + a
(sp (make-wff (forall-guarded '(a b) '((IN a NN) (IN b NN) (<= 1 a))
  '(AND (FORSOME ntn_ (AND (IN ntn_ NN) (AND (<= (* a ntn_) b) (< b (+ (* a ntn_) a)))))
        (FORALL ntn_ (IMPLIES (IN ntn_ NN) (FORALL ntm_ (IMPLIES (IN ntm_ NN)
          (IMPLIES (AND (<= (* a ntn_) b) (< b (+ (* a ntn_) a)))
            (IMPLIES (AND (<= (* a ntm_) b) (< b (+ (* a ntm_) a))) (= ntn_ ntm_)))))))))))
(dk-peel!)
(nt-nn! 'a 'b)
(dk-have! '(FORSOME ntn_ (AND (IN ntn_ NN) (AND (<= (* a ntn_) b) (< b (+ (* a ntn_) a)))))
  (lambda ()
    (let* ((n (dk-skolem! (dk-apply! (dk-cite! 'nn-division-remainder) 'a 'b)))
           (r (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'ntr_))) (dk-asms)))))
      (nt-nn! n r)
      (dk-type! (list '* 'a n) 'RR)
      (ew n)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (begin (dk-have! (list '<= 0 r) (lambda () (dk-nn!))) (dk-ineq! (list '= 'b (list '+ (list '* 'a n) r)) (list '< r 'a) (list '<= 0 r) (list 'IN (list '* 'a n) 'RR) '(IN a RR) '(IN b RR) (list 'IN r 'RR)))))))))
(dk-have! '(FORALL ntn_ (IMPLIES (IN ntn_ NN) (FORALL ntm_ (IMPLIES (IN ntm_ NN)
          (IMPLIES (AND (<= (* a ntn_) b) (< b (+ (* a ntn_) a)))
            (IMPLIES (AND (<= (* a ntm_) b) (< b (+ (* a ntm_) a))) (= ntn_ ntm_)))))))
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (n (cadr g)) (m (caddr g)))
      (dk-split-all!)
      (nt-nn! n m)
      (dk-type! (list '* 'a n) 'RR) (dk-type! (list '* 'a m) 'RR)
      (ma-or-split! (dk-apply! (dk-cite! 'rr-lt-trichotomy n m))
        (list (lambda ()
                (dk-apply! (dk-cite! 'nn-mul-gap) 'a n m)
                (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '<= (list '+ (list '* 'a n) 'a) (list '* 'a m)) (list '<= (list '* 'a m) 'b) (list '< 'b (list '+ (list '* 'a n) 'a)) (list 'IN (list '* 'a n) 'RR) (list 'IN (list '* 'a m) 'RR) '(IN a RR) '(IN b RR))))
                (ap-absurd!))
              (lambda () (ass))
              (lambda ()
                (dk-apply! (dk-cite! 'nn-mul-gap) 'a m n)
                (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '<= (list '+ (list '* 'a m) 'a) (list '* 'a n)) (list '<= (list '* 'a n) 'b) (list '< 'b (list '+ (list '* 'a m) 'a)) (list 'IN (list '* 'a n) 'RR) (list 'IN (list '* 'a m) 'RR) '(IN a RR) '(IN b RR))))
                (ap-absurd!)))))))
(dk-conj-close! dk-ass!)
(qed 'nn-floor-unique)

;;; PROP. 1.13: for b = a n + r, the common divisors of a, b are those of a, r; gcd(a, b) = gcd(a, r)
(sp (make-wff (forall-guarded '(a b n r d) '((IN a ZZ) (IN b ZZ) (IN n ZZ) (IN r ZZ) (= b (+ (* a n) r)))
  '(IFF (ZZ-IS-GCD a b d) (ZZ-IS-GCD a r d)))))
(dk-peel!)
(fact 'zz-one-in)
(dk-type! '(- n) 'ZZ) (dk-type! '(- 1) 'ZZ)
(let* ((to-r! (lambda (e)
                ;; e | a, e | b: e | r
                (dk-apply! (dk-cite! 'zz-divides-lincomb) e 'a 'b '(- n) 1)
                (dk-have! (list '= (list '+ '(* (- n) a) '(* 1 b)) 'r) (lambda () (subst '(= b (+ (* a n) r))) (crs)))
                (dk-rewrite-h! (list 'ZZ-DIVIDES e (list '+ '(* (- n) a) '(* 1 b))) (list '+ '(* (- n) a) '(* 1 b)) 'r)))
       (to-b! (lambda (e)
                (dk-apply! (dk-cite! 'zz-divides-lincomb) e 'a 'r 'n 1)
                (dk-have! (list '= (list '+ '(* n a) '(* 1 r)) 'b) (lambda () (subst '(= b (+ (* a n) r))) (crs)))
                (dk-rewrite-h! (list 'ZZ-DIVIDES e (list '+ '(* n a) '(* 1 r))) (list '+ '(* n a) '(* 1 r)) 'b)))
       (gcd-parts (lambda (x) (list (list 'ZZ-DIVIDES 'd 'a) (list 'ZZ-DIVIDES 'd x)
                                    (forall-guarded '(e_) (list '(IN e_ ZZ) '(ZZ-DIVIDES e_ a) (list 'ZZ-DIVIDES 'e_ x)) '(ZZ-DIVIDES e_ d)))))
       (dir! (lambda (from to fwd! bwd!)
               ;; ZZ-IS-GCD a from d in context; goal ZZ-IS-GCD a to d
               (ma-for-each (lambda (p) (dk-project! p 'zz-is-gcd (list 'ZZ-IS-GCD 'a from 'd))) (gcd-parts from))
               (fwd! 'd)
               (mac 'zz-is-gcd)
               (dk-conj-close!
                 (lambda ()
                   (if (not (dk-ass!))
                       (let ((e (dk-di-var!)))
                         (dk-peel!)
                         (bwd! e)
                         (dk-apply! (dk-ctx-form (caddr (gcd-parts from))) e)
                         (ass))))))))
  (dk-iff! (lambda (g) (equal? g '(ZZ-IS-GCD a r d)))
    (lambda () (dir! 'b 'r to-r! to-b!))
    (lambda () (dir! 'r 'b to-b! to-r!))))
(qed 'zz-gcd-remainder)

;;; COR. 1.17: a greatest common divisor of a and b lies in the ideal generated by a and b
(sp (make-wff (forall-guarded '(a b g) '((IN a ZZ) (IN b ZZ) (ZZ-IS-GCD a b g)) '(IN g (ZZ-BEZOUT-SET a b)))))
(dk-peel!)
(let* ((d (dk-skolem! (dk-apply! (dk-cite! 'zz-bezout) 'a 'b)))
       (mem (car (ma-iff-parts! (dk-cite! 'zz-bezout-set-membership 'a 'b d))))
       (x (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'x_) (dk-contains? f d))) (dk-asms))))
       (y (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'y_) (dk-contains? f x))) (dk-asms)))))
  (ma-for-each (lambda (p) (dk-project! p 'zz-is-gcd '(ZZ-IS-GCD a b g)))
    (list '(ZZ-DIVIDES g a) '(ZZ-DIVIDES g b) (forall-guarded '(e_) '((IN e_ ZZ) (ZZ-DIVIDES e_ a) (ZZ-DIVIDES e_ b)) '(ZZ-DIVIDES e_ g))))
  (dk-project! '(IN g ZZ) 'zz-divides '(ZZ-DIVIDES g a))
  (dk-project! (list 'IN d 'ZZ) 'zz-divides (list 'ZZ-DIVIDES d 'a))
  (dk-apply! (dk-ctx-form (forall-guarded '(e_) '((IN e_ ZZ) (ZZ-DIVIDES e_ a) (ZZ-DIVIDES e_ b)) '(ZZ-DIVIDES e_ g))) d)
  (dk-apply! (dk-cite! 'zz-divides-lincomb) 'g 'a 'b x y)
  (let ((h (dk-rewrite-h! (list 'ZZ-DIVIDES 'g (list '+ (list '* x 'a) (list '* y 'b))) (list '+ (list '* x 'a) (list '* y 'b)) d)))
    (ma-or-split! (dk-apply! (dk-cite! 'zz-divides-antisym) d 'g)
      (list (lambda () (subst (list '= 'g d)) (ass))
            (lambda ()
              (let* ((iff (dk-cite! 'zz-bezout-set-membership 'a 'b 'g)) (rhs (caddr iff))
                     (lx (list '+ (list '* x 'a) (list '* y 'b)))
                     (ln (list '+ (list '* (list '- x) 'a) (list '* (list '- y) 'b))))
                (dk-type! (list '- x) 'ZZ) (dk-type! (list '- y) 'ZZ)
                (dk-have! rhs
                  (lambda ()
                    (dk-conj-close!
                      (lambda ()
                        (cond ((dk-ass!) #t)
                              ((dk-head-is? (dk-goal) 'FORSOME)
                               (ew (list '- x))
                               (dk-conj-close!
                                 (lambda ()
                                   (cond ((dk-ass!) #t)
                                         ((dk-head-is? (dk-goal) 'FORSOME)
                                          (ew (list '- y))
                                          (dk-conj-close!
                                            (lambda ()
                                              (if (not (dk-ass!))
                                                  (let ((id (list '= ln (list '- lx))))
                                                    (dk-have! id (lambda () (crs)))
                                                    (subst id)
                                                    (subst (list '= lx d))
                                                    (subst (list '= d (list '- 'g)))
                                                    (crs))))))
                                         (#t #f)))))
                              (#t #f))))))
                (ma-prop-with! (list iff rhs))))))))
(qed 'zz-gcd-in-bezout-set)

;;; LEMMA 1.15: two steps of the Euclidean algorithm halve a: b = a n1 + r1, a = r1 n2 + r2, 0 <= r2 < r1 < a,
;;; r1 >= 1 (a does not divide b) give 2 r2 < a
(sp (make-wff (forall-guarded '(a b n1 r1 n2 r2) '((IN a NN) (IN b NN) (IN n1 NN) (IN r1 NN) (IN n2 NN) (IN r2 NN)
                                                  (= b (+ (* a n1) r1)) (< r1 a) (<= 1 r1) (= a (+ (* r1 n2) r2)) (< r2 r1))
  '(< (* 2 r2) a))))
(dk-peel!)
(nt-nn! 'a 'b 'n1 'r1 'n2 'r2)
(dk-type! '(* r1 n2) 'RR)
(dk-have! '(<= 0 r2) (lambda () (dk-nn!)))
(dk-have! '(<= 1 n2)
  (lambda ()
    (ma-or-split! (dk-cite! 'nn-zero-or-succ 'n2)
      (list (lambda ()
              (let ((h (dk-rewrite-h! '(= a (+ (* r1 n2) r2)) 'n2 0)))
                (dk-have! '(= (* r1 0) 0) (lambda () (crs)))
                (let ((h2 (dk-rewrite-h! h '(* r1 0) 0)))
                  (dk-have! '(< 0 0) (lambda () (dk-ineq! h2 '(< r2 r1) '(< r1 a))))
                  (ap-absurd!))))
            (lambda ()
              (let ((q (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'n2))) (dk-asms)))))
                (dk-nn! (list '= 'n2 (list 'succ q)))))))))
(dk-have! '(<= 0 r1) (lambda () (dk-nn!)))
(dk-apply! (dk-cite! 'rr-mul-le-right 1 'n2 'r1))
(dk-have! '(= (* 1 r1) r1) (lambda () (crs)))
(dk-have! '(= (* n2 r1) (* r1 n2)) (lambda () (crs)))
(let* ((h (dk-rewrite-h! '(<= (* 1 r1) (* n2 r1)) '(* 1 r1) 'r1))
       (h2 (dk-rewrite-h! h '(* n2 r1) '(* r1 n2))))
  (dk-ineq! h2 '(= a (+ (* r1 n2) r2)) '(< r2 r1) '(<= 0 r2) '(IN (* r1 n2) RR) '(IN a RR) '(IN r1 RR) '(IN r2 RR)))
(qed 'euclid-two-steps-halve)

;;; (41) ALGEBRAIC-NUMBERS ch. 1, bundle B4 (the Chinese remainder theorem for Z, in the notes' congruence form):
;;; Theorem 1.31 and Corollary 1.34.  A family n_1..n_k is indexed n(0)..n(k-1), n in FUN(NN, ZZ).
;;; Helper prefix nt2-.
(define (nt2-rfl!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(define (nt2-pw n k)
  ;; pairwise coprime below k
  (list 'FORALL 'cri_ (list 'IMPLIES '(IN cri_ NN) (list 'IMPLIES (list '< 'cri_ k)
    (list 'FORALL 'crj_ (list 'IMPLIES '(IN crj_ NN) (list 'IMPLIES (list '< 'crj_ k)
      (list 'IMPLIES '(NOT (= cri_ crj_)) (list 'ZZ-COPRIME (list n 'cri_) (list n 'crj_))))))))))
(define (nt2-solv n k)
  ;; every system x = a_i (mod n_i), i < k, has a solution
  (list 'FORALL 'cra_ (list 'IMPLIES '(IN cra_ (FUN NN ZZ))
    (list 'FORSOME 'crx_ (list 'AND '(IN crx_ ZZ)
      (list 'FORALL 'cri_ (list 'IMPLIES '(IN cri_ NN) (list 'IMPLIES (list '< 'cri_ k)
        (list 'ZZ-DIVIDES (list n 'cri_) '(- crx_ (cra_ cri_)))))))))))
(define (nt2-bez a b) (list 'FORSOME 'crx_ (list 'AND '(IN crx_ ZZ) (list 'FORSOME 'cry_ (list 'AND '(IN cry_ ZZ) (list '= (list '+ (list '* 'crx_ a) (list '* 'cry_ b)) 1))))))
(define (nt2-gcd-parts a b g)
  (list (list 'ZZ-DIVIDES g a) (list 'ZZ-DIVIDES g b)
        (forall-guarded '(e_) (list '(IN e_ ZZ) (list 'ZZ-DIVIDES 'e_ a) (list 'ZZ-DIVIDES 'e_ b)) (list 'ZZ-DIVIDES 'e_ g))))
(define (nt2-div-intro! d x c)
  ;; goal (ZZ-DIVIDES d x), d, x, c in ZZ, (= x (* d c)) provable by crs after the caller's substitutions: c the witness
  (mac 'zz-divides)
  (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew c) (dk-conj-close! dk-ass!))))))

;;; x | y and d | x give d | y; d | x gives d | x y
(sp (make-wff (forall-guarded '(d x y) '((ZZ-DIVIDES d x) (IN y ZZ)) '(ZZ-DIVIDES d (* x y)))))
(dk-peel!)
(dk-project! '(IN d ZZ) 'zz-divides '(ZZ-DIVIDES d x))
(dk-project! '(IN x ZZ) 'zz-divides '(ZZ-DIVIDES d x))
(let ((c (dk-skolem! (dk-project! '(FORSOME c_ (AND (IN c_ ZZ) (= x (* d c_)))) 'zz-divides '(ZZ-DIVIDES d x)))))
  (dk-type! '(* x y) 'ZZ) (dk-type! (list '* c 'y) 'ZZ)
  (dk-have! (list '= '(* x y) (list '* 'd (list '* c 'y))) (lambda () (subst (list '= 'x (list '* 'd c))) (crs)))
  (nt2-div-intro! 'd '(* x y) (list '* c 'y)))
(qed 'zz-divides-mul-right)
(sp (make-wff (forall-guarded '(d x y) '((ZZ-DIVIDES d x) (ZZ-DIVIDES x y)) '(ZZ-DIVIDES d y))))
(dk-peel!)
(dk-project! '(IN y ZZ) 'zz-divides '(ZZ-DIVIDES x y))
(let ((c (dk-skolem! (dk-project! '(FORSOME c_ (AND (IN c_ ZZ) (= y (* x c_)))) 'zz-divides '(ZZ-DIVIDES x y)))))
  (dk-apply! (dk-cite! 'zz-divides-mul-right) 'd 'x c)
  (dk-rewrite-h! (list 'ZZ-DIVIDES 'd (list '* 'x c)) (list '* 'x c) 'y)
  (ass))
(qed 'zz-divides-trans)

;;; coprime iff 1 is a combination
(sp (make-wff (forall-guarded '(a b) '((IN a ZZ) (IN b ZZ)) (list 'IFF '(ZZ-COPRIME a b) (nt2-bez 'a 'b)))))
(dk-peel!)
(fact 'zz-one-in) (fact 'zz-zero-in)
(dk-iff! (lambda (g) (dk-head-is? g 'FORSOME))
  (lambda ()
    (dk-project! '(ZZ-IS-GCD a b 1) 'zz-coprime '(ZZ-COPRIME a b))
    (dk-apply! (dk-cite! 'zz-gcd-in-bezout-set) 'a 'b 1)
    (let* ((x (dk-skolem! (cadr (ma-iff-parts! (dk-cite! 'zz-bezout-set-membership 'a 'b 1)))))
           (y (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'y_) (dk-contains? f x))) (dk-asms)))))
      (ew x)
      (dk-conj-close!
        (lambda ()
          (cond ((dk-ass!) #t)
                ((dk-head-is? (dk-goal) 'FORSOME) (ew y) (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst (list '= 1 (list '+ (list '* x 'a) (list '* y 'b)))) (rfl)))))) 
                (#t #f))))))
  (lambda ()
    (let* ((x (dk-skolem! (dk-ctx-form (nt2-bez 'a 'b))))
           (y (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'cry_) (dk-contains? f x))) (dk-asms)))))
      (mac 'zz-coprime)
      (mac 'zz-is-gcd)
      (dk-conj-close!
        (lambda ()
          (cond ((dk-ass!) #t)
                ((dk-head-is? (dk-goal) 'ZZ-DIVIDES)
                 (let ((t (caddr (dk-goal))))
                   (dk-have! (list '= t (list '* 1 t)) (lambda () (crs)))
                   (nt2-div-intro! 1 t t)))
                (#t
                 (let ((e (dk-di-var!)))
                   (dk-peel!)
                   (dk-apply! (dk-cite! 'zz-divides-lincomb) e 'a 'b x y)
                   (dk-rewrite-h! (list 'ZZ-DIVIDES e (list '+ (list '* x 'a) (list '* y 'b))) (list '+ (list '* x 'a) (list '* y 'b)) 1)
                   (ass)))))))))
(qed 'zz-coprime-bezout)

;;; coprime to m is closed under products
(sp (make-wff (forall-guarded '(a b m) '((IN a ZZ) (IN b ZZ) (IN m ZZ) (ZZ-COPRIME a m) (ZZ-COPRIME b m)) '(ZZ-COPRIME (* a b) m))))
(dk-peel!)
(dk-type! '(* a b) 'ZZ)
(car (ma-iff-parts! (dk-cite! 'zz-coprime-bezout 'a 'm)))
(let* ((x1 (dk-skolem! (dk-ctx-form (nt2-bez 'a 'm))))
       (y1 (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'cry_) (dk-contains? f x1))) (dk-asms)))))
  (car (ma-iff-parts! (dk-cite! 'zz-coprime-bezout 'b 'm)))
  (let* ((x2 (dk-skolem! (dk-ctx-form (nt2-bez 'b 'm))))
         (y2 (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'cry_) (dk-contains? f x2))) (dk-asms))))
         (iff (dk-cite! 'zz-coprime-bezout '(* a b) 'm))
         (xx (list '* x1 x2))
         (yy (list '+ (list '* y1 (list '* x2 'b)) (list '+ (list '* x1 (list '* y2 'a)) (list '* y1 (list '* y2 'm))))))
    (dk-type! xx 'ZZ) (dk-type! yy 'ZZ)
    (dk-have! (caddr iff)
      (lambda ()
        (ew xx)
        (dk-conj-close!
          (lambda ()
            (cond ((dk-ass!) #t)
                  ((dk-head-is? (dk-goal) 'FORSOME)
                   (ew yy)
                   (dk-conj-close!
                     (lambda ()
                       (if (not (dk-ass!))
                           (let ((id (list '= (list '+ (list '* xx '(* a b)) (list '* yy 'm))
                                           (list '* (list '+ (list '* x1 'a) (list '* y1 'm)) (list '+ (list '* x2 'b) (list '* y2 'm))))))
                             (dk-have! id (lambda () (crs)))
                             (subst id)
                             (subst (list '= (list '+ (list '* x1 'a) (list '* y1 'm)) 1))
                             (subst (list '= (list '+ (list '* x2 'b) (list '* y2 'm)) 1))
                             (crs))))))
                  (#t #f))))))
    (ma-prop-with! (list iff (caddr iff)))))
(qed 'zz-coprime-mul)

;;; i < succ v, not i < v: land (= i v)
(define (nt2-eq-last! i v)
  (fact 'nn-in-rr i) (fact 'nn-in-rr v)
  (dk-have! (list '= i v)
    (lambda ()
      (ma-or-split! (dk-apply! (dk-cite! 'rr-lt-trichotomy i v))
        (list (lambda () (ma-prop-with! (list (list '< i v) (list 'NOT (list '< i v)))))
              (lambda () (ass))
              (lambda ()
                (dk-apply! (dk-cite! 'nn-lt-succ-le v i))
                (dk-have! '(< 0 0) (lambda () (dk-nn! (list '<= (list 'succ v) i) (list '< i (list 'succ v)))))
                (ap-absurd!)))))))
(define (nt2-split-last! i v lt! eq!)
  ;; i < succ v: run LT! with (< i v), or EQ! with (= i v) in context
  (fact 'nn-in-rr i) (fact 'nn-in-rr v)
  (ma-or-split! (dk-apply! (dk-cite! 'rr-lt-trichotomy i v))
    (list lt! eq!
          (lambda ()
            (dk-apply! (dk-cite! 'nn-lt-succ-le v i))
            (dk-have! '(< 0 0) (lambda () (dk-nn! (list '<= (list 'succ v) i) (list '< i (list 'succ v)))))
            (ap-absurd!)))))
(define (nt2-below-absurd! i) (dk-have! '(< 0 0) (lambda () (dk-nn! (list '< i 0)))) (ap-absurd!))
(define (nt2-divall n k m) (list 'FORALL 'cri_ (list 'IMPLIES '(IN cri_ NN) (list 'IMPLIES (list '< 'cri_ k) (list 'ZZ-DIVIDES (list n 'cri_) m)))))
(define (nt2-copall n k q) (list 'FORALL 'cri_ (list 'IMPLIES '(IN cri_ NN) (list 'IMPLIES (list '< 'cri_ k) (list 'ZZ-COPRIME (list n 'cri_) q)))))
(define (nt2-strong k)
  (list 'FORSOME 'crm_ (list 'AND '(IN crm_ ZZ)
    (list 'AND (nt2-divall 'n k 'crm_)
      (list 'AND (list 'FORALL 'crq_ (list 'IMPLIES '(IN crq_ ZZ) (list 'IMPLIES (nt2-copall 'n k 'crq_) '(ZZ-COPRIME crm_ crq_))))
                 (nt2-solv 'n k))))))
(define (nt2-bez-open! a b)
  ;; ZZ-COPRIME a b in context: land x a + y b = 1, return (x y)
  (car (ma-iff-parts! (dk-cite! 'zz-coprime-bezout a b)))
  (let* ((x (dk-skolem! (dk-ctx-form (nt2-bez a b))))
         (y (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'cry_) (dk-contains? f x))) (dk-asms)))))
    (list x y)))

;;; the induction behind THEOREM 1.31: a common multiple M of n_0..n_(k-1), coprime to every q coprime to all of
;;; them, and a solution of every system
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'n (list 'IMPLIES '(IN n (FUN NN ZZ)) (list 'IMPLIES (nt2-pw 'n 'k) (nt2-strong 'k))))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (fact 'zz-one-in) (fact 'zz-zero-in)
  (ew 1)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-ass!) #t)
              ((and (dk-head-is? g 'FORALL) (eq? (cadr g) 'cri_))
               (let ((i (dk-di-var!))) (di) (nt2-below-absurd! i)))
              ((and (dk-head-is? g 'FORALL) (eq? (cadr g) 'crq_))
               (let ((q (dk-di-var!)))
                 (di)
                 (let ((iff (dk-cite! 'zz-coprime-bezout 1 q)))
                   (dk-have! (caddr iff)
                     (lambda ()
                       (ew 1)
                       (dk-conj-close!
                         (lambda ()
                           (cond ((dk-ass!) #t)
                                 ((dk-head-is? (dk-goal) 'FORSOME) (ew 0) (dk-conj-close! (lambda () (if (not (dk-ass!)) (crs)))))
                                 (#t #f))))))
                   (ma-iff-back! iff))))
              (#t
               (dk-di-var!)
               (ew 0)
               (dk-conj-close!
                 (lambda ()
                   (if (not (dk-ass!))
                       (let ((i (dk-di-var!))) (di) (nt2-below-absurd! i))))))))))
  (dk-focus! (cdr (assq 'step ind)))
  (let ((n (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(FUN NN ZZ)))) (dk-peel!)))))
  (fact 'zz-one-in) (fact 'zz-zero-in)
  (fact 'nn-succ-closed v)
  (let* ((sv (list 'succ v)) (nv (list n v)))
    (fact 'fun-apply-type-c n 'NN 'ZZ v)
    (dk-have! (nt2-pw n v)
      (lambda ()
        (let ((i (dk-di-var!)))
          (di)
          (let ((j (dk-di-var!)))
            (di) (di)
            (dk-have! (list '< i sv) (lambda () (dk-nn! (list '< i v))))
            (dk-have! (list '< j sv) (lambda () (dk-nn! (list '< j v))))
            (dk-apply! (dk-ctx-form (nt2-pw n sv)) i j)
            (ass)))))
    (let* ((m (dk-skolem! (dk-apply! (dk-ctx-form ih) n)))
           (copv (dk-have! (nt2-copall n v nv)
                   (lambda ()
                     (let ((i (dk-di-var!)))
                       (di)
                       (dk-have! (list '< i sv) (lambda () (dk-nn! (list '< i v))))
                       (dk-have! (list '< v sv) (lambda () (dk-nn!)))
                       (dk-have! (list 'NOT (list '= i v)) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-nn! (list '= i v) (list '< i v)))) (ap-absurd!)))
                       (dk-apply! (dk-ctx-form (nt2-pw n sv)) i v)
                       (ass)))))
           (cmv (dk-apply! (dk-ctx-form (list 'FORALL 'crq_ (list 'IMPLIES '(IN crq_ ZZ) (list 'IMPLIES (nt2-copall n v 'crq_) (list 'ZZ-COPRIME m 'crq_))))) nv))
           (uw (nt2-bez-open! m nv)) (u (car uw)) (w (cadr uw))
           (m2 (list '* m nv)))
      (dk-type! m2 'ZZ)
      (ew m2)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-ass!) #t)
              ((and (dk-head-is? g 'FORALL) (eq? (cadr g) 'cri_))
               ;; n_i divides M n_v
               (let ((i (dk-di-var!)))
                 (di)
                 (fact 'fun-apply-type-c n 'NN 'ZZ i)
                 (nt2-split-last! i v
                   (lambda ()
                     (dk-apply! (dk-ctx-form (nt2-divall n v m)) i)
                     (dk-apply! (dk-cite! 'zz-divides-mul-right) (list n i) m nv)
                     (ass))
                   (lambda ()
                     (subst (list '= i v))
                     (dk-have! (list '= m2 (list '* nv m)) (lambda () (crs)))
                     (nt2-div-intro! nv m2 m)))))
              ((and (dk-head-is? g 'FORALL) (eq? (cadr g) 'crq_))
               ;; coprime to every q coprime to n_0..n_v
               (let ((q (dk-di-var!)))
                 (di)
                 (dk-have! (nt2-copall n v q)
                   (lambda ()
                     (let ((i (dk-di-var!)))
                       (di)
                       (dk-have! (list '< i sv) (lambda () (dk-nn! (list '< i v))))
                       (dk-apply! (dk-ctx-form (nt2-copall n sv q)) i)
                       (ass))))
                 (dk-apply! (dk-ctx-form (list 'FORALL 'crq_ (list 'IMPLIES '(IN crq_ ZZ) (list 'IMPLIES (nt2-copall n v 'crq_) (list 'ZZ-COPRIME m 'crq_))))) q)
                 (dk-have! (list '< v sv) (lambda () (dk-nn!)))
                 (dk-apply! (dk-ctx-form (nt2-copall n sv q)) v)
                 (dk-apply! (dk-cite! 'zz-coprime-mul) m nv q)
                 (ass)))
              (#t
               ;; the solution x2 = x + M u (a_v - x)
               (let* ((a (dk-di-var!))
                      (x (dk-skolem! (dk-apply! (dk-ctx-form (nt2-solv n v)) a)))
                      (av (list a v))
                      (x2 (list '+ x (list '* m (list '* u (list '- av x))))))
                 (fact 'fun-apply-type-c a 'NN 'ZZ v)
                 (dk-type! x2 'ZZ)
                 (ew x2)
                 (dk-conj-close!
                   (lambda ()
                     (if (not (dk-ass!))
                         (let ((i (dk-di-var!)))
                           (di)
                           (fact 'fun-apply-type-c n 'NN 'ZZ i) (fact 'fun-apply-type-c a 'NN 'ZZ i)
                           (nt2-split-last! i v
                             (lambda ()
                               (let* ((ai (list a i)) (t (list '* u (list '- av x)))
                                      (lc (list '+ (list '* 1 (list '- x ai)) (list '* t m))))
                                 (dk-apply! (dk-ctx-form (list 'FORALL 'cri_ (list 'IMPLIES '(IN cri_ NN) (list 'IMPLIES (list '< 'cri_ v) (list 'ZZ-DIVIDES (list n 'cri_) (list '- x (list a 'cri_))))))) i)
                                 (dk-apply! (dk-ctx-form (nt2-divall n v m)) i)
                                 (dk-type! t 'ZZ) (dk-type! (list '- x ai) 'ZZ)
                                 (dk-apply! (dk-cite! 'zz-divides-lincomb) (list n i) (list '- x ai) m 1 t)
                                 (dk-have! (list '= lc (list '- x2 ai)) (lambda () (crs)))
                                 (dk-rewrite-h! (list 'ZZ-DIVIDES (list n i) lc) lc (list '- x2 ai))
                                 (ass)))
                             (lambda ()
                               (subst (list '= i v))
                               (let* ((c (list '* w (list '- x av)))
                                      (id (list '= (list '- x2 av) (list '+ (list '* nv c) (list '* (list '- x av) (list '- 1 (list '+ (list '* u m) (list '* w nv))))))))
                                 (dk-type! c 'ZZ) (dk-type! (list '- x2 av) 'ZZ)
                                 (dk-have! (list '= (list '- x2 av) (list '* nv c))
                                   (lambda ()
                                     (dk-have! id (lambda () (crs)))
                                     (subst id)
                                     (subst (list '= (list '+ (list '* u m) (list '* w nv)) 1))
                                     (crs)))
                                 (nt2-div-intro! nv (list '- x2 av) c))))))))))))))))))
(qed 'zz-crt-strong)

;;; THEOREM 1.31 (the Chinese remainder theorem, congruence form): every system x = a_i (mod n_i), i < k, has a
;;; solution iff the n_i are pairwise relatively prime
(sp (make-wff (forall-guarded '(k n) '((IN k NN) (IN n (FUN NN ZZ))) (list 'IFF (nt2-pw 'n 'k) (nt2-solv 'n 'k)))))
(let* ((ls (dk-peel!)) (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ls))) (n (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(FUN NN ZZ)))) ls))))
(fact 'zz-one-in) (fact 'zz-zero-in)
(dk-iff! (lambda (g) (equal? g (nt2-solv n k)))
  (lambda ()
    (dk-skolem! (dk-apply! (dk-cite! 'zz-crt-strong k) n))
    (ass))
  (lambda ()
    (let ((i (dk-di-var!)))
      (di)
      (let ((j (dk-di-var!)))
        (di) (di)
        (let* ((a (list 'VNB-LAMBDA 'cru_ 'NN (list 'IF (list '= 'cru_ i) 1 0)))
               (ni (list n i)) (nj (list n j)))
          (fact 'fun-apply-type-c n 'NN 'ZZ i) (fact 'fun-apply-type-c n 'NN 'ZZ j)
          (dk-have! (list 'IN a '(FUN NN ZZ))
            (lambda ()
              (dk-lam-type!
                (lambda () (let ((t (dk-di-var!))) (dk-case-if! (list 'IF (list '= t i) 1 0) (lambda (t? v) (ass)))))
                (lambda () (fact 'nn-is-set) (ass)))))
          (let* ((x (dk-skolem! (dk-apply! (dk-ctx-form (nt2-solv n k)) a)))
                 (sol (list 'FORALL 'crs_ (list 'IMPLIES '(IN crs_ NN) (list 'IMPLIES (list '< 'crs_ k) (list 'ZZ-DIVIDES (list n 'crs_) (list '- x (list a 'crs_))))))))
            (dk-apply! (dk-ctx-form sol) i)
            (dk-apply! (dk-ctx-form sol) j)
            (dk-have! (list '= (list a i) 1) (lambda () (dk-lam-b!) (dk-if-branch! #t (list 'IF (list '= i i) 1 0) (lambda () (rfl)) nt2-rfl!)))
            (dk-have! (list '= (list a j) 0)
              (lambda ()
                (dk-lam-b!)
                (dk-if-branch! #f (list 'IF (list '= j i) 1 0)
                  (lambda () (di) (dk-have! (list '= i j) (lambda () (subst (list '= j i)) (rfl))) (ma-prop-with! (list (list '= i j) (list 'NOT (list '= i j)))))
                  nt2-rfl!)))
            (let* ((h1 (dk-rewrite-h! (list 'ZZ-DIVIDES ni (list '- x (list a i))) (list a i) 1))
                   (h2 (dk-rewrite-h! (list 'ZZ-DIVIDES nj (list '- x (list a j))) (list a j) 0)))
              (mac 'zz-coprime)
              (mac 'zz-is-gcd)
              (dk-conj-close!
                (lambda ()
                  (cond ((dk-ass!) #t)
                        ((dk-head-is? (dk-goal) 'ZZ-DIVIDES)
                         (let ((t (caddr (dk-goal))))
                           (dk-have! (list '= t (list '* 1 t)) (lambda () (crs)))
                           (nt2-div-intro! 1 t t)))
                        (#t
                         (let ((e (dk-di-var!)))
                           (dk-peel!)
                           (dk-type! (list '- x 1) 'ZZ) (dk-type! (list '- x 0) 'ZZ)
                           (dk-apply! (dk-cite! 'zz-divides-trans) e ni (list '- x 1))
                           (dk-apply! (dk-cite! 'zz-divides-trans) e nj (list '- x 0))
                           (dk-type! '(- 1) 'ZZ)
                           (dk-apply! (dk-cite! 'zz-divides-lincomb) e (list '- x 1) (list '- x 0) '(- 1) 1)
                           (let ((lc (list '+ (list '* '(- 1) (list '- x 1)) (list '* 1 (list '- x 0)))))
                             (dk-have! (list '= lc 1) (lambda () (crs)))
                             (dk-rewrite-h! (list 'ZZ-DIVIDES e lc) lc 1)
                             (ass)))))))))))))))
(qed 'zz-chinese-remainder)

;;; COR. 1.34: n_i pairwise coprime, c_i coprime to n_i: every system c_i x = a_i (mod n_i) has a solution
(define nt2-inv-set (lambda (t) (list 'SEP 'crv_ 'ZZ (list 'FORSOME 'crw_ (list 'AND '(IN crw_ ZZ) (list '= (list '+ (list '* 'crv_ (list 'c t)) (list '* 'crw_ (list 'n t))) 1))))))
(sp (make-wff (forall-guarded '(k n c) (list '(IN k NN) '(IN n (FUN NN ZZ)) '(IN c (FUN NN ZZ)) (nt2-pw 'n 'k)
                                             '(FORALL cri_ (IMPLIES (IN cri_ NN) (IMPLIES (< cri_ k) (ZZ-COPRIME (c cri_) (n cri_))))))
  '(FORALL cra_ (IMPLIES (IN cra_ (FUN NN ZZ)) (FORSOME crx_ (AND (IN crx_ ZZ)
     (FORALL cri_ (IMPLIES (IN cri_ NN) (IMPLIES (< cri_ k) (ZZ-DIVIDES (n cri_) (- (* (c cri_) crx_) (cra_ cri_)))))))))))))
(define nt2-landed (dk-peel!))
(fact 'zz-one-in) (fact 'zz-zero-in)
(let* ((ch! (lambda (t)
              ;; t < k: CHOICE(S(t)) in S(t): an inverse of c_t modulo n_t
              (let ((st (nt2-inv-set t)))
                (fact 'fun-apply-type-c 'c 'NN 'ZZ t) (fact 'fun-apply-type-c 'n 'NN 'ZZ t)
                (if (not (dk-asm? (list 'IN (list 'CHOICE st) st)))
                    (begin
                      (dk-apply! (dk-ctx-form '(FORALL cri_ (IMPLIES (IN cri_ NN) (IMPLIES (< cri_ k) (ZZ-COPRIME (c cri_) (n cri_)))))) t)
                      (let* ((uw (nt2-bez-open! (list 'c t) (list 'n t))))
                        (dk-have! (list 'FORSOME 'cv_ (list 'IN 'cv_ st))
                          (lambda () (ew (car uw)) (in-sep! dk-ass! (lambda () (ew (cadr uw)) (dk-conj-close! dk-ass!))))))
                      (fact 'choice-axiom st)))
                (ma-sep-parts! (list 'IN (list 'CHOICE st) st))
                (list 'CHOICE st))))
       (a (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(FUN NN ZZ)) (not (memq (cadr f) '(n c))))) nt2-landed)))
       (b (list 'VNB-LAMBDA 'crb_ 'NN (list 'IF '(< crb_ k) (list '* (list 'CHOICE (nt2-inv-set 'crb_)) (list a 'crb_)) 0))))
  (dk-have! (list 'IN b '(FUN NN ZZ))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((t (dk-di-var!)))
            (fact 'fun-apply-type-c a 'NN 'ZZ t)
            (dk-case-if! (list 'IF (list '< t 'k) (list '* (list 'CHOICE (nt2-inv-set t)) (list a t)) 0)
              (lambda (t? v) (if t? (begin (ch! t) (dk-type! v 'ZZ)) (ass))))))
        (lambda () (fact 'nn-is-set) (ass)))))
  (dk-apply! (dk-cite! 'zz-chinese-remainder) 'k 'n)
  (car (ma-iff-parts! (dk-cite! 'zz-chinese-remainder 'k 'n)))
  (let* ((x (dk-skolem! (dk-apply! (dk-ctx-form (nt2-solv 'n 'k)) b)))
         (sol (list 'FORALL 'crs_ (list 'IMPLIES '(IN crs_ NN) (list 'IMPLIES '(< crs_ k) (list 'ZZ-DIVIDES '(n crs_) (list '- x (list b 'crs_))))))))
    (ew x)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let ((i (dk-di-var!)))
              (di)
              (fact 'fun-apply-type-c a 'NN 'ZZ i)
              (let* ((ch (ch! i))
                     (w (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'crw_) (dk-contains? f ch) (not (dk-contains? f 'cv_)))) (dk-asms))))
                     (ci (list 'c i)) (ni (list 'n i)) (ai (list a i)) (bi (list b i))
                     (bv (list '* ch ai)))
                (dk-apply! (dk-ctx-form sol) i)
                (dk-type! bv 'ZZ)
                (dk-have! (list '= bi bv) (lambda () (dk-lam-b!) (dk-if-branch! #t (list 'IF (list '< i 'k) bv 0) #f nt2-rfl!)))
                (let* ((h (dk-rewrite-h! (list 'ZZ-DIVIDES ni (list '- x bi)) bi bv))
                       (s2 (list '- (list '* ai w))))
                  (dk-type! (list '- x bv) 'ZZ) (dk-type! s2 'ZZ)
                  (dk-have! (list 'ZZ-DIVIDES ni ni) (lambda () (dk-have! (list '= ni (list '* ni 1)) (lambda () (crs))) (nt2-div-intro! ni ni 1)))
                  (dk-apply! (dk-cite! 'zz-divides-lincomb) ni (list '- x bv) ni ci s2)
                  (let* ((lc (list '+ (list '* ci (list '- x bv)) (list '* s2 ni)))
                         (tg (list '- (list '* ci x) ai))
                         (id (list '= lc (list '- tg (list '* ai (list '- (list '+ (list '* ch ci) (list '* w ni)) 1))))))
                    (dk-type! tg 'ZZ)
                    (dk-have! (list '= lc tg)
                      (lambda ()
                        (dk-have! id (lambda () (crs)))
                        (subst id)
                        (subst (list '= (list '+ (list '* ch ci) (list '* w ni)) 1))
                        (crs)))
                    (dk-rewrite-h! (list 'ZZ-DIVIDES ni lc) lc tg)
                    (ass))))))))))
(qed 'zz-linear-congruences)

;;; (43) ALGEBRAIC-NUMBERS ch. 1, bundle B2: residues modulo m, Euler's totient, PROP. 1.23 (phi is
;;; multiplicative).  The route is the Chinese remainder bijection k |-> (k mod m, k mod n), not the notes' product
;;; formula 1.19 (which needs the prime factorisation).  Helper prefix nt3-.
(define (ie-rfl0!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(define (nt3-rr! . xs) (for-each (lambda (x) (dk-type! x 'RR)) xs))
(define (nt3-dv! d x) ;; (ZZ-DIVIDES d x) in context: return the witness c, x = d c
  (dk-project! (list 'IN d 'ZZ) 'zz-divides (list 'ZZ-DIVIDES d x))
  (dk-project! (list 'IN x 'ZZ) 'zz-divides (list 'ZZ-DIVIDES d x))
  (dk-skolem! (dk-project! (list 'FORSOME 'c_ (list 'AND '(IN c_ ZZ) (list '= x (list '* d 'c_)))) 'zz-divides (list 'ZZ-DIVIDES d x))))
(define (nt3-eq-from-diff! a b)
  ;; (= (- a b) 0) in context, a, b typed: land (= a b)
  (dk-have! (list '= a b)
    (lambda ()
      (let ((id (list '= a (list '+ b (list '- a b)))))
        (dk-have! id (lambda () (crs)))
        (subst id)
        (subst (list '= (list '- a b) 0))
        (crs)))))

;;; a multiple of m strictly between -m and m is 0
(sp (make-wff (forall-guarded '(m x) '((IN m ZZ) (IN x ZZ) (<= 1 m) (ZZ-DIVIDES m x) (< x m) (< (- m) x)) '(= x 0))))
(dk-peel!)
(fact 'zz-zero-in) (fact 'zz-one-in)
(let* ((c (nt3-dv! 'm 'x)) (p (list '* c 'm)))
  (nt3-rr! 'm 'x c p)
  (dk-have! (list '= 'x p) (lambda () (subst (list '= 'x (list '* 'm c))) (crs)))
  (ma-or-split! (dk-apply! (dk-cite! 'zz-trichotomy) c)
    (list
      (lambda ()
        (dk-apply! (dk-cite! 'zz-lt-succ-le c 0))
        (dk-have! (list '<= c '(- 1)) (lambda () (dk-ineq! (list '<= (list '+ c 1) 0))))
        (dk-have! '(<= 0 m) (lambda () (dk-ineq! '(<= 1 m))))
        (dk-type! '(- 1) 'RR)
        (dk-apply! (dk-cite! 'rr-mul-le-right c '(- 1) 'm))
        (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '<= p '(* (- 1) m)) (list '= 'x p) '(< (- m) x) (list 'IN p 'RR) '(IN m RR) '(IN x RR))))
        (ap-absurd!))
      (lambda () (subst (list '= 'x (list '* 'm c))) (subst (list '= c 0)) (crs))
      (lambda ()
        (dk-apply! (dk-cite! 'zz-discrete) c)
        (dk-have! '(<= 0 m) (lambda () (dk-ineq! '(<= 1 m))))
        (dk-apply! (dk-cite! 'rr-mul-le-right 1 c 'm))
        (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '<= '(* 1 m) p) (list '= 'x p) '(< x m) (list 'IN p 'RR) '(IN m RR) '(IN x RR))))
        (ap-absurd!)))))
(qed 'zz-small-multiple-zero)

;;; the residue of k modulo m: in {1..m}, and m divides k minus it
(define (nt3-sset k m) (list 'SEP 'zrr_ (list 'INTERVAL 1 m) (list 'ZZ-DIVIDES m (list '- k 'zrr_))))
(sp (make-wff (forall-guarded '(m k) '((IN m NN) (<= 1 m) (IN k ZZ))
  '(AND (IN (ZZ-RESIDUE k m) (INTERVAL 1 m)) (ZZ-DIVIDES m (- k (ZZ-RESIDUE k m)))))))
(dk-peel!)
(fact 'zz-zero-in) (fact 'zz-one-in)
(dk-type! 'm 'ZZ) (nt3-rr! 'm 'k)
(let* ((s (nt3-sset 'k 'm))
       (put! (lambda (w c)
               ;; w in NN, 1 <= w <= m, k - w = m c: (FORSOME cv_ (IN cv_ S))
               (dk-apply! (dk-cite! 'interval-mem-intro 1 'm w))
               (dk-type! (list '- 'k w) 'ZZ) (dk-type! c 'ZZ)
               (dk-have! (list 'ZZ-DIVIDES 'm (list '- 'k w)) (lambda () (nt2-div-intro! 'm (list '- 'k w) c)))
               (ew w) (in-sep! dk-ass! dk-ass!))))
  (dk-have! '(NOT (= m 0)) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! '(= m 0) '(<= 1 m)))) (ap-absurd!)))
  (let* ((q (dk-skolem! (dk-apply! (dk-cite! 'zz-division) 'k 'm)))
         (r (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f q))) (dk-asms))))
         (ke (list '= 'k (list '+ (list '* q 'm) r)))
         (case0! (lambda ()
                   (dk-have! '(<= m m) (lambda () (dk-nn!)))
                   (dk-type! (list '- q 1) 'ZZ)
                   (dk-have! (list '= (list '- 'k 'm) (list '* 'm (list '- q 1))) (lambda () (subst ke) (subst (list '= r 0)) (crs)))
                   (put! 'm (list '- q 1)))))
    (nt3-rr! q r)
    (dk-have! '(<= 0 m) (lambda () (dk-ineq! '(<= 1 m))))
    (dk-apply! (dk-cite! 'rr-abs-of-nonneg) 'm)
    (dk-have! (list 'FORSOME 'cv_ (list 'IN 'cv_ s)) (lambda ()
    (ma-or-split! (dk-ctx-form (list 'OR (list '= r 0) (list '<= (list 'succ (list 'abs r)) (list 'abs 'm))))
      (list case0!
            (lambda ()
              (ma-or-split! (dk-apply! (dk-cite! 'zz-trichotomy) r)
                (list
                  (lambda ()
                    (dk-apply! (dk-cite! 'rr-abs-of-neg) r)
                    (dk-type! (list '- r) 'ZZ)
                    (dk-have! (list '<= 0 (list '- r)) (lambda () (dk-ineq! (list '< r 0))))
                    (dk-apply! (dk-cite! 'zz-nonneg-in-nn) (list '- r))
                    (dk-have! (list 'IN (list 'abs r) 'NN) (lambda () (subst (list '= (list 'abs r) (list '- r))) (ass)))
                    (dk-apply! (dk-cite! 'nn-succ-plus-one) (list 'abs r))
                    (let* ((h1 (dk-rewrite-h! (list '<= (list 'succ (list 'abs r)) (list 'abs 'm)) (list 'succ (list 'abs r)) (list '+ (list 'abs r) 1)))
                           (h2 (dk-rewrite-h! (dk-rewrite-h! h1 (list 'abs r) (list '- r)) (list 'abs 'm) 'm))
                           (w (list '+ r 'm)))
                      (dk-type! w 'ZZ)
                      (dk-have! (list '<= 0 w) (lambda () (dk-ineq! h2)))
                      (dk-apply! (dk-cite! 'zz-nonneg-in-nn) w)
                      (dk-have! (list '<= 1 w) (lambda () (dk-ineq! h2)))
                      (dk-have! (list '<= w 'm) (lambda () (dk-ineq! (list '< r 0))))
                      (dk-type! (list '- q 1) 'ZZ)
                      (dk-have! (list '= (list '- 'k w) (list '* 'm (list '- q 1))) (lambda () (subst ke) (crs)))
                      (put! w (list '- q 1))))
                  case0!
                  (lambda ()
                    (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
                    (dk-apply! (dk-cite! 'rr-abs-of-nonneg) r)
                    (dk-apply! (dk-cite! 'zz-nonneg-in-nn) r)
                    (dk-apply! (dk-cite! 'nn-succ-plus-one) r)
                    (let ((h1 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (list '<= (list 'succ (list 'abs r)) (list 'abs 'm)) (list 'abs r) r) (list 'abs 'm) 'm) (list 'succ r) (list '+ r 1))))
                      (dk-apply! (dk-cite! 'zz-discrete) r)
                      (dk-have! (list '<= r 'm) (lambda () (dk-ineq! h1)))
                      (dk-have! (list '= (list '- 'k r) (list '* 'm q)) (lambda () (subst ke) (crs)))
                      (put! r q))))))))))
    (fact 'choice-axiom s)
    (ma-sep-parts! (list 'IN (list 'CHOICE s) s))
    (mac 'ZZ-RESIDUE)
    (dk-conj-close! dk-ass!)))
(qed 'zz-residue-in)

;;; the residue is the only r in {1..m} with m | k - r
(sp (make-wff (forall-guarded '(m k r) '((IN m NN) (<= 1 m) (IN k ZZ) (IN r (INTERVAL 1 m)) (ZZ-DIVIDES m (- k r))) '(= r (ZZ-RESIDUE k m)))))
(dk-peel!)
(fact 'zz-one-in) (dk-type! '(- 1) 'ZZ) (dk-type! 'm 'ZZ)
(dk-split-all! (list (dk-apply! (dk-cite! 'zz-residue-in) 'm 'k)))
(let* ((s '(ZZ-RESIDUE k m)) (d (list '- s 'r)))
  (fact 'interval-elt-in-nn 1 'm 'r) (fact 'interval-lo 1 'm 'r) (fact 'interval-hi 1 'm 'r)
  (fact 'interval-elt-in-nn 1 'm s) (fact 'interval-lo 1 'm s) (fact 'interval-hi 1 'm s)
  (dk-type! 'r 'ZZ) (dk-type! s 'ZZ) (dk-type! d 'ZZ) (dk-type! (list '- 'k 'r) 'ZZ) (dk-type! (list '- 'k s) 'ZZ)
  (nt3-rr! 'm 'r s d)
  (dk-apply! (dk-cite! 'zz-divides-lincomb) 'm (list '- 'k 'r) (list '- 'k s) 1 '(- 1))
  (let ((lc (list '+ (list '* 1 (list '- 'k 'r)) (list '* '(- 1) (list '- 'k s)))))
    (dk-have! (list '= lc d) (lambda () (crs)))
    (dk-rewrite-h! (list 'ZZ-DIVIDES 'm lc) lc d))
  (dk-have! (list '< d 'm) (lambda () (dk-ineq! (list '<= s 'm) '(<= 1 r))))
  (dk-have! (list '< '(- m) d) (lambda () (dk-ineq! (list '<= 'r 'm) (list '<= 1 s))))
  (dk-apply! (dk-cite! 'zz-small-multiple-zero) 'm d)
  (nt3-eq-from-diff! s 'r)
  (subst (list '= s 'r))
  (ie-rfl0!))
(qed 'zz-residue-unique)

;;; coprime to m passes along congruence modulo m; coprime is symmetric; coprime to b c gives coprime to b
(sp (make-wff (forall-guarded '(m k r) '((IN m ZZ) (IN k ZZ) (IN r ZZ) (ZZ-DIVIDES m (- k r)) (ZZ-COPRIME k m)) '(ZZ-COPRIME r m))))
(dk-peel!)
(dk-type! '(- k r) 'ZZ)
(let* ((c (nt3-dv! 'm '(- k r)))
       (xy (nt2-bez-open! 'k 'm)) (x (car xy)) (y (cadr xy))
       (y2 (list '+ y (list '* x c)))
       (iff (dk-cite! 'zz-coprime-bezout 'r 'm)))
  (dk-type! y2 'ZZ)
  (dk-have! (caddr iff)
    (lambda ()
      (ew x)
      (dk-conj-close!
        (lambda ()
          (cond ((dk-ass!) #t)
                ((dk-head-is? (dk-goal) 'FORSOME)
                 (ew y2)
                 (dk-conj-close!
                   (lambda ()
                     (if (not (dk-ass!))
                         (let ((id (list '= (list '+ (list '* x 'r) (list '* y2 'm)) (list '+ (list '+ (list '* x 'k) (list '* y 'm)) (list '* x (list '- (list '* 'm c) (list '- 'k 'r)))))))
                           (dk-have! id (lambda () (crs)))
                           (subst id)
                           (subst (list '= (list '+ (list '* x 'k) (list '* y 'm)) 1))
                           (subst (list '= (list '* 'm c) (list '- 'k 'r)))
                           (crs))))))
                (#t #f))))))
  (ma-iff-back! iff))
(qed 'zz-coprime-congruent)

(sp (make-wff (forall-guarded '(a b) '((IN a ZZ) (IN b ZZ) (ZZ-COPRIME a b)) '(ZZ-COPRIME b a))))
(dk-peel!)
(let* ((xy (nt2-bez-open! 'a 'b)) (x (car xy)) (y (cadr xy)) (iff (dk-cite! 'zz-coprime-bezout 'b 'a)))
  (dk-have! (caddr iff)
    (lambda ()
      (ew y)
      (dk-conj-close!
        (lambda ()
          (cond ((dk-ass!) #t)
                ((dk-head-is? (dk-goal) 'FORSOME)
                 (ew x)
                 (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (dk-have! (list '= (list '+ (list '* y 'b) (list '* x 'a)) (list '+ (list '* x 'a) (list '* y 'b))) (lambda () (crs))) (subst (list '= (list '+ (list '* y 'b) (list '* x 'a)) (list '+ (list '* x 'a) (list '* y 'b)))) (ass))))))
                (#t #f))))))
  (ma-iff-back! iff))
(qed 'zz-coprime-sym)

(sp (make-wff (forall-guarded '(a b c) '((IN a ZZ) (IN b ZZ) (IN c ZZ) (ZZ-COPRIME a (* b c))) '(ZZ-COPRIME a b))))
(dk-peel!)
(dk-type! '(* b c) 'ZZ)
(let* ((xy (nt2-bez-open! 'a '(* b c))) (x (car xy)) (y (cadr xy)) (iff (dk-cite! 'zz-coprime-bezout 'a 'b))
       (y2 (list '* y 'c)))
  (dk-type! y2 'ZZ)
  (dk-have! (caddr iff)
    (lambda ()
      (ew x)
      (dk-conj-close!
        (lambda ()
          (cond ((dk-ass!) #t)
                ((dk-head-is? (dk-goal) 'FORSOME)
                 (ew y2)
                 (dk-conj-close! (lambda () (if (not (dk-ass!)) (let ((id (list '= (list '+ (list '* x 'a) (list '* y2 'b)) (list '+ (list '* x 'a) (list '* y '(* b c)))))) (dk-have! id (lambda () (crs))) (subst id) (ass))))))
                (#t #f))))))
  (ma-iff-back! iff))
(qed 'zz-coprime-factor)

;;; coprime m, n dividing x: m n divides x
(sp (make-wff (forall-guarded '(m n x) '((IN m ZZ) (IN n ZZ) (IN x ZZ) (ZZ-COPRIME m n) (ZZ-DIVIDES m x) (ZZ-DIVIDES n x)) '(ZZ-DIVIDES (* m n) x))))
(dk-peel!)
(let* ((c2 (nt3-dv! 'm 'x)) (c1 (nt3-dv! 'n 'x))
       (uv (nt2-bez-open! 'm 'n)) (u (car uv)) (v (cadr uv))
       (w (list '+ (list '* u c1) (list '* v c2))))
  (dk-type! '(* m n) 'ZZ) (dk-type! w 'ZZ)
  (dk-have! (list '= 'x (list '* '(* m n) w))
    (lambda ()
      (let ((id1 (list '= (list '* '(* m n) w) (list '+ (list '* (list '* u 'm) (list '* 'n c1)) (list '* (list '* v 'n) (list '* 'm c2)))))
            (id2 (list '= (list '+ (list '* (list '* u 'm) 'x) (list '* (list '* v 'n) 'x)) (list '* 'x (list '+ (list '* u 'm) (list '* v 'n))))))
        (dk-have! id1 (lambda () (crs)))
        (subst id1)
        (subst (list '= (list '* 'n c1) 'x))
        (subst (list '= (list '* 'm c2) 'x))
        (dk-have! id2 (lambda () (crs)))
        (subst id2)
        (subst (list '= (list '+ (list '* u 'm) (list '* v 'n)) 1))
        (crs))))
  (nt2-div-intro! '(* m n) 'x w))
(qed 'zz-coprime-divides-product)

;;; PROP. 1.23: Euler's totient is multiplicative: phi(m n) = phi(m) phi(n) for coprime m, n >= 1
(define (nt3-phiset k) (list 'SEP 'ephk_ (list 'INTERVAL 1 k) (list 'ZZ-COPRIME 'ephk_ k)))
(define (nt3-fin! s sup)
  (ma-sep-subset! s)
  (fact 'subclass-of-set-is-set s sup)
  (dk-have! (list 'AND (list 'IN sup 'SET) (list 'IN (list 'CARD sup) 'NN)))
  (let ((cs (dk-cite! 'card-subset-nn sup)))
    (dk-have! (list 'FORALL 'ntv_ (list 'IMPLIES (list 'IN 'ntv_ s) (list 'IN 'ntv_ sup)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s sup z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'ntv_ (list 'IMPLIES (list 'IN 'ntv_ s) (list 'IN 'ntv_ sup)))))
    (dk-apply! cs s)))
(define (nt2-div-intro-h! d x c)
  ;; land (ZZ-DIVIDES d x) from (= x (* d c)), d, x, c in ZZ
  (dk-have! (list 'ZZ-DIVIDES d x) (lambda () (nt2-div-intro! d x c))))
(define (nt3-lc! d x y s t target)
  ;; d | x, d | y, s, t in ZZ, s x + t y = target by crs: land d | target
  (dk-apply! (dk-cite! 'zz-divides-lincomb) d x y s t)
  (let ((lc (list '+ (list '* s x) (list '* t y))))
    (dk-have! (list '= lc target) (lambda () (crs)))
    (dk-rewrite-h! (list 'ZZ-DIVIDES d lc) lc target)))
(sp (make-wff (forall-guarded '(m n) '((IN m NN) (IN n NN) (<= 1 m) (<= 1 n) (ZZ-COPRIME m n))
  '(= (EULER-PHI (* m n)) (* (EULER-PHI m) (EULER-PHI n))))))
(dk-peel!)
(fact 'zz-one-in) (fact 'zz-zero-in) (dk-type! '(- 1) 'ZZ)
(let* ((mn '(* m n)) (pmn (nt3-phiset mn)) (pm (nt3-phiset 'm)) (pn (nt3-phiset 'n)) (cc2 (list 'CARTESIAN pm pn))
       (psi (list 'VNB-LAMBDA 'phk_ pmn (list 'LIST '(ZZ-RESIDUE phk_ m) '(ZZ-RESIDUE phk_ n))))
       (rm (lambda (k) (list 'ZZ-RESIDUE k 'm))) (rn (lambda (k) (list 'ZZ-RESIDUE k 'n))))
  (dk-type! mn 'NN) (dk-type! 'm 'ZZ) (dk-type! 'n 'ZZ) (dk-type! mn 'ZZ)
  (nt3-rr! 'm 'n mn)
  (dk-have! '(<= 0 m) (lambda () (dk-ineq! '(<= 1 m))))
  (dk-apply! (dk-cite! 'rr-mul-le-right 1 'n 'm))
  (dk-type! '(* n m) 'RR)
  (dk-have! (list '= '(* n m) mn) (lambda () (crs)))
  (dk-have! (list '<= 1 mn) (lambda () (dk-ineq! '(<= (* 1 m) (* n m)) (list '= '(* n m) mn) '(<= 1 m) (list 'IN mn 'RR) '(IN (* n m) RR) '(IN m RR))))
  (dk-have! (list '= '(* m n) '(* n m)) (lambda () (crs)))
  (ma-for-each (lambda (k) (fact 'interval-in-set 1 k) (dk-apply! (dk-cite! 'interval-card-in-nn 1 k)) (nt3-fin! (nt3-phiset k) (list 'INTERVAL 1 k))) (list mn 'm 'n))
  (let ((elt! (lambda (k)
                ;; k in P(mn): k typed, coprime to m and to n, its residues in P(m), P(n)
                (ma-sep-parts! (list 'IN k pmn))
                (fact 'interval-elt-in-nn 1 mn k) (fact 'interval-lo 1 mn k) (fact 'interval-hi 1 mn k)
                (dk-type! k 'ZZ)
                (dk-apply! (dk-cite! 'zz-coprime-factor) k 'm 'n)
                (dk-rewrite-h! (list 'ZZ-COPRIME k mn) mn '(* n m))
                (dk-apply! (dk-cite! 'zz-coprime-factor) k 'n 'm)
                (ma-for-each
                  (lambda (md)
                    (let ((r (list 'ZZ-RESIDUE k md)))
                      (dk-split-all! (list (dk-apply! (dk-cite! 'zz-residue-in) md k)))
                      (fact 'interval-elt-in-nn 1 md r)
                      (dk-type! r 'ZZ)
                      (dk-apply! (dk-cite! 'zz-coprime-congruent) md k r)
                      (dk-have! (list 'IN r (nt3-phiset md)) (lambda () (in-sep! dk-ass! dk-ass!)))))
                  '(m n)))))
    (let* ((iff (dk-cite! 'bijection-membership-iff pmn cc2 psi))
           (rhs (caddr iff))
           (val! (lambda (k) (dk-have! (list '= (list psi k) (list 'LIST (rm k) (rn k))) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl))))))))
      ;; into the product
      (dk-have! (cadr rhs)
        (lambda ()
          (dk-lam-type!
            (lambda () (let ((k (dk-di-var!))) (elt! k) (dk-apply! (dk-cite! 'pair-in-cartesian) pm pn (rm k) (rn k)) (ass)))
            (lambda () (ass)))))
      ;; injective
      (dk-have! (cadr (caddr rhs))
        (lambda ()
          (dk-peel!)
          (let* ((g (dk-goal)) (a (cadr g)) (b (caddr g)))
            (elt! a) (elt! b) (val! a) (val! b)
            (let* ((h (dk-rewrite-h! (dk-rewrite-h! (dk-ctx-form (list '= (list psi a) (list psi b))) (list psi a) (list 'LIST (rm a) (rn a))) (list psi b) (list 'LIST (rm b) (rn b))))
                   (pi (dk-apply! (dk-cite! 'node-pair-injective) (rm a) (rn a) (rm b) (rn b))))
              (dk-split-all! (list pi))
              (ma-for-each
                (lambda (md)
                  (let ((ra (list 'ZZ-RESIDUE a md)) (rb (list 'ZZ-RESIDUE b md)))
                    (dk-type! (list '- a ra) 'ZZ) (dk-type! (list '- b ra) 'ZZ) (dk-type! (list '- a 'b) 'ZZ)
                    (dk-rewrite-h! (list 'ZZ-DIVIDES md (list '- b rb)) rb ra)
                    (nt3-lc! md (list '- a ra) (list '- b ra) 1 '(- 1) (list '- a 'b))))
                '(m n))
              (dk-apply! (dk-cite! 'zz-coprime-divides-product) 'm 'n (list '- a 'b))
              (nt3-rr! a 'b (list '- a 'b))
              (dk-have! (list '< (list '- a 'b) mn) (lambda () (dk-ineq! (list '<= a mn) (list '<= 1 'b))))
              (dk-have! (list '< (list '- mn) (list '- a 'b)) (lambda () (dk-ineq! (list '<= 'b mn) (list '<= 1 a))))
              (dk-apply! (dk-cite! 'zz-small-multiple-zero) mn (list '- a 'b))
              (nt3-eq-from-diff! a 'b)
              (ass)))))
      ;; onto
      (dk-have! (caddr (caddr rhs))
        (lambda ()
          (let* ((w (dk-di-var!))
                 (w1 (list 'NTH 1 w)) (w2 (list 'NTH 2 w)))
            (ma-iff-parts! (dk-cite! 'cartesian-membership-nth pm pn w))
            (ma-sep-parts! (list 'IN w1 pm)) (ma-sep-parts! (list 'IN w2 pn))
            (fact 'interval-elt-in-nn 1 'm w1) (fact 'interval-elt-in-nn 1 'n w2)
            (dk-type! w1 'ZZ) (dk-type! w2 'ZZ)
            (let* ((uv (nt2-bez-open! 'm 'n)) (u (car uv)) (v (cadr uv))
                   (bz (list '+ (list '* u 'm) (list '* v 'n)))
                   (x (list '+ (list '* w1 (list '* v 'n)) (list '* w2 (list '* u 'm))))
                   (k (list 'ZZ-RESIDUE x mn)))
              (dk-type! x 'ZZ)
              (ma-for-each
                (lambda (trip)
                  (let* ((md (car trip)) (wi (cadr trip)) (c (caddr trip)) (other (cadddr trip)))
                    (dk-type! c 'ZZ) (dk-type! (list '- x wi) 'ZZ)
                    (dk-have! (list '= (list '- x wi) (list '* md c))
                      (lambda ()
                        (let ((id (list '= (list '- x wi) (list '+ (list '* md c) (list '* other (list '- bz 1))))))
                          (dk-have! id (lambda () (crs)))
                          (subst id)
                          (subst (list '= bz 1))
                          (crs))))
                    (nt2-div-intro-h! md (list '- x wi) c)))
                (list (list 'm w1 (list '* u (list '- w2 w1)) w1)
                      (list 'n w2 (list '* v (list '- w1 w2)) w2)))
              (dk-split-all! (list (dk-apply! (dk-cite! 'zz-residue-in) mn x)))
              (fact 'interval-elt-in-nn 1 mn k)
              (dk-type! k 'ZZ) (dk-type! (list '- x k) 'ZZ)
              (ma-for-each
                (lambda (pr)
                  (let* ((md (car pr)) (wi (cadr pr)) (other (if (eq? md 'm) 'n 'm)))
                    (dk-have! (list 'ZZ-DIVIDES md mn)
                      (lambda () (if (eq? md 'm) (begin (dk-have! (list '= mn (list '* 'm 'n)) (lambda () (rfl))) (nt2-div-intro! 'm mn 'n))
                                     (begin (dk-have! (list '= mn (list '* 'n 'm)) (lambda () (crs))) (nt2-div-intro! 'n mn 'm)))))
                    (dk-apply! (dk-cite! 'zz-divides-trans) md mn (list '- x k))
                    (dk-type! (list '- wi k) 'ZZ) (dk-type! (list '- k wi) 'ZZ)
                    (nt3-lc! md (list '- x k) (list '- x wi) 1 '(- 1) (list '- wi k))
                    (nt3-lc! md (list '- x k) (list '- x wi) '(- 1) 1 (list '- k wi))
                    (dk-apply! (dk-cite! 'zz-coprime-congruent) md wi k)
                    (dk-apply! (dk-cite! 'zz-coprime-sym) k md)
                    (dk-apply! (dk-cite! 'zz-residue-unique) md k wi)))
                (list (list 'm w1) (list 'n w2)))
              (dk-apply! (dk-cite! 'zz-coprime-mul) 'm 'n k)
              (dk-apply! (dk-cite! 'zz-coprime-sym) mn k)
              (dk-have! (list 'IN k pmn) (lambda () (in-sep! dk-ass! dk-ass!)))
              (val! k)
              (ew k)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin
                        (subst (list '= (list psi k) (list 'LIST (rm k) (rn k))))
                        (subst (list '= (rm k) w1))
                        (subst (list '= (rn k) w2))
                        (subst (list '= (list 'LIST w1 w2) w))
                        (ie-rfl0!)))))))))
      (ma-iff-back! iff))
    (dk-apply! (dk-cite! 'card-bijection-eq) pmn cc2 psi)
    (dk-have! (list 'AND (list 'IN pm 'SET) (list 'IN (list 'CARD pm) 'NN)))
    (dk-apply! (dk-cite! 'card-cartesian pm) pn)
    (mac 'EULER-PHI)
    (subst (list '= (list 'CARD pmn) (list 'CARD cc2)))
    (ass)))
(qed 'euler-phi-multiplicative)
