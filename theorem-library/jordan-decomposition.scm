;;; mf-tv.scm -- Def 3.14: the total variation |nu| = nu+ + nu- is a measure; Remark 3.15.
;;; Agent M-F, 2026-10-29.  DESTINATION: theorem-library/jordan-decomposition.scm (after mf-jordan).  Library: measure.
;;; Helper prefix: mft-.  Load window: after mf-jordan.scm and radon-nikodym.scm (measure-sum, M-E's me-rn2).

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)

(define (mft-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MFT OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mft-disj g) (list 'FORALL 'i_ (list 'FORALL 'j_ (dk-curry '((IN i_ NN) (IN j_ NN) (NOT (= i_ j_)))
                       (list '= (list 'INTERSECTION (list g 'i_) (list g 'j_)) 'EMPTY-SET)))))
(define (mft-parts! mu) (dk-iff-parts! (dk-cite! 'is-measure 'omega 'ca mu)))
(define (mft-le-anti! a b)          ; a <= b, b <= a in RR-POS-STAR: a = b
  (dk-have-and! (list 'IN a 'RR-POS-STAR) (list 'IN b 'RR-POS-STAR))
  (dk-have-and! (list '<= a b) (list '<= b a))
  (dk-cite! 'rr-pos-star-le-antisymm a b))

;; the sum of two measures is a measure: measure-sum (theorem-library/radon-nikodym.scm, M-E)

;; Definition 3.14: the total variation is a countably additive measure
(sp (make-wff (dk-foralls '(omega ca nu) (dk-curry '((IS-SIGNED-MEASURE omega ca nu)) '(IS-MEASURE omega ca (TOTAL-VARIATION ca nu))))))
(dk-peel!)
(dk-cite! 'pos-variation-is-measure 'omega 'ca 'nu)
(dk-cite! 'neg-variation-is-measure 'omega 'ca 'nu)
(dk-cite! 'measure-sum 'omega 'ca '(POS-VARIATION ca nu) '(NEG-VARIATION ca nu))
(mac 'TOTAL-VARIATION)
(dk-ass!)
(mft-qed! 'total-variation-is-measure)

;; members of a sigma-algebra are subsets of the ambient set
(sp (make-wff (dk-foralls '(omega ca a) (dk-curry '((IS-SIGMA-ALGEBRA omega ca) (IN a ca)) '(SUBSET a omega)))))
(dk-peel!)
(dk-cite! 'sigma-algebra-in-power-power 'omega 'ca)
(dk-iff-fwd! (dk-cite! 'power-set-membership '(POWER omega) 'ca))
(dk-apply! '(FORALL z (IMPLIES (IN z ca) (IN z (POWER omega)))) 'a)
(dk-iff-fwd! (dk-cite! 'power-set-membership 'omega 'a))
(dk-iff-bwd! (dk-cite! 'subset-def 'a 'omega))
(dk-ass!)
(mft-qed! 'sigma-algebra-member-subset)

(define (mft-pv a) (list '(POS-VARIATION ca nu) a))
(define (mft-nv a) (list '(NEG-VARIATION ca nu) a))
(sp (make-wff (dk-foralls '(ca nu a) (dk-curry '((IN a ca)) (list '== '((TOTAL-VARIATION ca nu) a) (list 'eplus (mft-pv 'a) (mft-nv 'a)))))))
(dk-peel!)
(mac 'TOTAL-VARIATION)
(lam-b)
(if (not (proof-done? *ps*)) (qrfl))
(mft-qed! 'total-variation-value)

;; Remark 3.15: ||nu|| is finite iff nu+ and nu- take only finite values
(define (mft-fin-all v) (list 'FORALL 'a_ (list 'IMPLIES '(IN a_ ca) (list 'IN (list v 'a_) 'RR))))
(sp (make-wff (dk-foralls '(omega ca nu) (dk-curry '((IS-SIGNED-MEASURE omega ca nu))
  (list 'IFF '(IN (TOTAL-VARIATION-NORM omega ca nu) RR) (list 'AND (mft-fin-all '(POS-VARIATION ca nu)) (mft-fin-all '(NEG-VARIATION ca nu))))))))
(dk-peel!)
(let* ((parts (dk-iff-parts! (dk-cite! 'is-signed-measure 'omega 'ca 'nu)))
       (P (mft-pv 'omega)) (N (mft-nv 'omega)) (E (list 'eplus P N)))
  (dk-cite! 'sigma-algebra-whole-in 'omega 'ca)
  (dk-cite! 'pos-variation-is-measure 'omega 'ca 'nu)
  (dk-cite! 'neg-variation-is-measure 'omega 'ca 'nu)
  (let ((ty (lambda (mu z) (dk-iff-parts! (dk-cite! 'is-measure 'omega 'ca mu)) (dk-cite! 'fun-apply-type-c mu 'ca 'RR-POS-STAR z))))
    (ty '(POS-VARIATION ca nu) 'omega) (ty '(NEG-VARIATION ca nu) 'omega)
    (mac 'TOTAL-VARIATION-NORM)
    (subst (dk-cite! 'total-variation-value 'ca 'nu 'omega))
    (dk-have-and! (list 'IN P 'RR-POS-STAR) (list 'IN N 'RR-POS-STAR))
    (dk-cite! 'eplus-le-left P N)
    (dk-cite! 'eplus-comm P N)
    (dk-have-and! (list 'IN N 'RR-POS-STAR) (list 'IN P 'RR-POS-STAR))
    (dk-cite! 'eplus-le-left N P)
    (dk-iff! (lambda (g) (dk-head-is? g 'AND))
      (lambda ()
        (dk-have-and! (list 'IN P 'RR-POS-STAR) (list 'IN E 'RR))
        (dk-cite! 'rr-pos-star-le-real-in-rr P E)
        (dk-rewrite-h! (list '<= N (list 'eplus N P)) (list 'eplus N P) E)
        (dk-have-and! (list 'IN N 'RR-POS-STAR) (list 'IN E 'RR))
        (dk-cite! 'rr-pos-star-le-real-in-rr N E)
        (dk-conj-close!
          (lambda ()
            (let* ((gl (dk-goal)) (mu (if (dk-contains? gl 'POS-VARIATION) '(POS-VARIATION ca nu) '(NEG-VARIATION ca nu)))
                   (W (if (eq? (car mu) 'POS-VARIATION) P N))
                   (a (dk-di-var!)))
              (ty mu a)
              (dk-cite! 'sigma-algebra-member-subset 'omega 'ca a)
              (dk-cite! 'measure-monotone 'omega 'ca mu a 'omega)
              (dk-have-and! (list 'IN (list mu a) 'RR-POS-STAR) (list 'IN W 'RR))
              (dk-cite! 'rr-pos-star-le-real-in-rr (list mu a) W)
              (dk-ass!)))))
      (lambda ()
        (dk-split-all!)
        (dk-apply! (mft-fin-all '(POS-VARIATION ca nu)) 'omega)
        (dk-apply! (mft-fin-all '(NEG-VARIATION ca nu)) 'omega)
        (dk-cite! 'rr-pos-star-nonneg P) (dk-cite! 'rr-pos-star-nonneg N)
        (subst (dk-cite! 'eplus-real-defined P N))
        (subst (dk-cite! 'binplus-apply P N))
        (dk-have-and! (list 'IN P 'RR) (list 'IN N 'RR))
        (dk-cite! 'rr-add-closed P N)
        (dk-ass!)))))
(mft-qed! 'total-variation-norm-finite-iff)

  
