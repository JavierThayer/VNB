;; keep the named formulas and run prop -- only on the leaf the keep was written for (when keep
;; finds that sequent already proven it closes the leaf and the focus moves; prop must not follow it)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (mfj-keep-prop! . fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply keep fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))

(define (mfj-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MFJ OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mfj-star-cases! t k)
  (let ((iff (dk-cite! 'rr-star-membership t)))
    (dk-have! (caddr iff) (lambda () (mfj-keep-prop! iff (list 'IN t 'RR-STAR))))
    (dk-or-each! (dk-ctx-form (caddr iff))
      (lambda (d)
        (cond ((equal? d (list 'IN t 'RR)) (k 'real))
              ((equal? d (list '= t 'POS-INF)) (k 'pos))
              (#t (k 'neg)))))))
(define (mfj-rstar! t) (fact 'rr-subset-rr-star) (dk-cite! 'subset-mem-fwd 'RR 'RR-STAR t))
(define (mfj-pv a) (list '(POS-VARIATION ca nu) a))
(define (mfj-nv a) (list '(NEG-VARIATION ca nu) a))
(define (mfj-sn a) (list '(SIGNED-NEG ca nu) a))
(define (mfj-sm-parts!) (dk-iff-parts! (dk-cite! 'is-signed-measure 'omega 'ca 'nu)))
(define (mfj-never c) (list 'FORALL 'a_ (list 'IMPLIES '(IN a_ ca) (list 'NOT (list '= '(nu a_) c)))))
(define (mfj-fin-all v) (list 'FORALL 'a_ (list 'IMPLIES '(IN a_ ca) (list 'IN (list v 'a_) 'RR))))
(define (mfj-rps! t)            ; t in RR, 0 <= t in context: t in RR-POS-STAR
  (let ((iff (dk-cite! 'rr-pos-star-membership t)))
    (dk-have! (list 'IN t 'RR-POS-STAR) (lambda () (mfj-keep-prop! iff (list 'IN t 'RR) (list '<= 0 t))))))

;; NV(a) == PV(-nu)(a)
(sp (make-wff (dk-foralls '(ca nu a) (list '== (mfj-nv 'a) (list '(POS-VARIATION ca (SIGNED-NEG ca nu)) 'a)))))
(dk-peel!)
(mac 'NEG-VARIATION)
(qrfl)
(mfj-qed! 'neg-variation-unfold)

;; nu never -inf: nu- takes only finite values
(sp (make-wff (dk-foralls '(omega ca nu) (dk-curry (list '(IS-SIGNED-MEASURE omega ca nu) (mfj-never 'NEG-INF))
  (mfj-fin-all '(NEG-VARIATION ca nu))))))
(dk-peel!)
(let ((parts (mfj-sm-parts!)))
  (dk-cite! 'signed-neg-is-signed-measure 'omega 'ca 'nu)
  (dk-have! '(FORALL a_ (IMPLIES (IN a_ ca) (NOT (= ((SIGNED-NEG ca nu) a_) POS-INF))))
    (lambda ()
      (let ((a (dk-di-var!)))
        (di)
        (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-STAR a)
        (dk-cite! 'signed-neg-value 'ca 'nu a)
        (dk-rewrite-h! (list '= (mfj-sn a) 'POS-INF) (mfj-sn a) (list 'EXT-NEG (list 'nu a)))
        (dk-cite! 'ext-neg-to-pos-inf (list 'nu a))
        (dk-apply! (mfj-never 'NEG-INF) a)
        (ai (list 'NOT (list '= (list 'nu a) 'NEG-INF))))))
  (dk-cite! 'pos-variation-finite 'omega 'ca '(SIGNED-NEG ca nu))
  (let ((a (cadr (cadr (dk-goal)))))
    (subst (dk-cite! 'neg-variation-unfold 'ca 'nu a))
    (dk-apply! (mfj-fin-all '(POS-VARIATION ca (SIGNED-NEG ca nu))) a)
    (dk-ass!)))
(mfj-qed! 'neg-variation-finite)

;; Corollary 3.13: one of nu+, nu- takes only finite values
(define mfj-one-finite (list 'OR (mfj-fin-all '(POS-VARIATION ca nu)) (mfj-fin-all '(NEG-VARIATION ca nu))))
(sp (make-wff (dk-foralls '(omega ca nu) (dk-curry '((IS-SIGNED-MEASURE omega ca nu)) mfj-one-finite))))
(dk-peel!)
(let* ((parts (mfj-sm-parts!))
       (notboth (list-ref parts 3))
       (ep '(FORSOME sma_ (AND (IN sma_ ca) (= (nu sma_) POS-INF))))
       (en '(FORSOME smb_ (AND (IN smb_ ca) (= (nu smb_) NEG-INF)))))
  (use-em ep
    (lambda ()
      (dk-have! (mfj-never 'NEG-INF)
        (lambda () (let ((a (dk-di-var!)))
                     (di)
                     (dk-have! (list 'AND ep en) (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew a) (dk-conj-close! dk-ass!)))))))
                     (ai notboth))))
      (dk-cite! 'neg-variation-finite 'omega 'ca 'nu)
      (oi-r) (dk-ass!))
    (lambda ()
      (dk-have! (mfj-never 'POS-INF)
        (lambda () (let ((a (dk-di-var!)))
                     (di)
                     (dk-have! ep (lambda () (ew a) (dk-conj-close! dk-ass!)))
                     (ai (list 'NOT ep)))))
      (dk-cite! 'pos-variation-finite 'omega 'ca 'nu)
      (oi-l) (dk-ass!))))
(mfj-qed! 'signed-measure-one-variation-finite)

;; ---------------------------------------------------------------------------
;; a set of finite measure splits into two pieces of finite measure
(define (mfj-real-of-eq! eqn)     ; eqn (= (nu a) X) with X = +-inf, (IN (nu a) RR) in context: close the goal
  (let ((x (caddr eqn)) (na (cadr eqn)))
    (dk-rewrite-h! (list 'IN na 'RR) na x)
    (ai (dk-cite! (if (eq? x 'POS-INF) 'pos-inf-not-in-rr 'neg-inf-not-in-rr)))))
(sp (make-wff (dk-foralls '(omega ca nu a e) (dk-curry '((IS-SIGNED-MEASURE omega ca nu) (IN a ca) (IN e ca) (SUBSET e a) (IN (nu a) RR))
  (dk-and (list '(IN (nu e) RR) '(IN (nu (COMPLEMENT-IN a e)) RR) '(= (nu a) (+ (nu e) (nu (COMPLEMENT-IN a e))))))))))
(dk-peel!)
(let* ((parts (mfj-sm-parts!))
       (r '(COMPLEMENT-IN a e)) (ne '(nu e)) (nr (list 'nu r)) (sum (list 'EXT-ADD ne nr)))
  (dk-cite! 'sigma-algebra-difference-closed 'omega 'ca 'a 'e)
  (dk-cite! 'intersection-complement-in-empty 'e 'a)
  (dk-cite! 'union-complement-in 'e 'a)
  (dk-cite! 'signed-measure-fa 'omega 'ca 'nu 'e r)
  (dk-rewrite-h! (list '= (list 'nu (list 'UNION 'e r)) sum) (list 'UNION 'e r) 'a)
  (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-STAR 'e)
  (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-STAR r)
  (let ((eq (list '= '(nu a) sum)))
    (mfj-star-cases! ne
      (lambda (ke)
        (case ke
          ((pos) (dk-rewrite-h! eq ne 'POS-INF)
                 (dk-cite! 'ext-add-pos-inf-left nr)
                 (mfj-real-of-eq! (dk-rewrite-h! (list '= '(nu a) (list 'EXT-ADD 'POS-INF nr)) (list 'EXT-ADD 'POS-INF nr) 'POS-INF)))
          (else
           (mfj-star-cases! nr
             (lambda (kr)
               (case kr
                 ((pos) (dk-rewrite-h! eq nr 'POS-INF)
                        (dk-cite! 'ext-add-pos-inf-right ne)
                        (mfj-real-of-eq! (dk-rewrite-h! (list '= '(nu a) (list 'EXT-ADD ne 'POS-INF)) (list 'EXT-ADD ne 'POS-INF) 'POS-INF)))
                 ((neg) (dk-rewrite-h! eq nr 'NEG-INF)
                        (if (eq? ke 'neg)
                            (begin (fact 'neg-inf-neq-pos-inf)
                                   (dk-have! (list 'NOT (list '= ne 'POS-INF)) (lambda () (subst (list '= ne 'NEG-INF)) (dk-ass!))))
                            (dk-cite! 'ext-real-not-pos-inf ne))
                        (dk-cite! 'ext-add-neg-inf-right ne)
                        (mfj-real-of-eq! (dk-rewrite-h! (list '= '(nu a) (list 'EXT-ADD ne 'NEG-INF)) (list 'EXT-ADD ne 'NEG-INF) 'NEG-INF)))
                 (else
                  (if (eq? ke 'neg)
                      (begin (dk-rewrite-h! eq ne 'NEG-INF)
                             (dk-cite! 'ext-real-not-pos-inf nr)
                             (dk-cite! 'ext-add-neg-inf-left nr)
                             (mfj-real-of-eq! (dk-rewrite-h! (list '= '(nu a) (list 'EXT-ADD 'NEG-INF nr)) (list 'EXT-ADD 'NEG-INF nr) 'NEG-INF)))
                      (begin
                        (dk-cite! 'ext-add-real ne nr)
                        (dk-rewrite-h! eq sum (list '+ ne nr))
                        (dk-conj-close! dk-ass!)))))))))))))
(mfj-qed! 'signed-split-real)

;; nu-(a) <= nu+(a) - nu(a) and nu+(a) <= nu(a) + nu-(a), for nu(a) finite
(define (mfj-snfacts!)           ; -nu: a signed measure, its typing
  (dk-cite! 'signed-neg-is-signed-measure 'omega 'ca 'nu)
  (dk-cite! 'signed-neg-fun 'omega 'ca 'nu))
(sp (make-wff (dk-foralls '(omega ca nu a) (dk-curry (list '(IS-SIGNED-MEASURE omega ca nu) '(IN a ca) '(IN (nu a) RR) (list 'IN (mfj-pv 'a) 'RR))
  (list '<= (mfj-nv 'a) (list '- (mfj-pv 'a) '(nu a)))))))
(dk-peel!)
(let* ((parts (mfj-sm-parts!)) (p (mfj-pv 'a)) (b (list '- p '(nu a))))
  (mfj-snfacts!)
  (dk-cite! 'pos-variation-ge 'ca 'nu 'a)
  (dk-type! b 'RR)
  (dk-have! (list '<= 0 b) (lambda () (dk-ineq! (list '<= '(nu a) p) (list 'IN p 'RR) '(IN (nu a) RR))))
  (mfj-rps! b)
  (dk-have! (list 'FORALL 'e_ (dk-curry '((IN e_ ca) (SUBSET e_ a)) (list '<= '((SIGNED-NEG ca nu) e_) b)))
    (lambda ()
      (let ((e (dk-di-var!)))
        (di)
        (let ((r (list 'COMPLEMENT-IN 'a e)))
          (dk-split-all! (list (dk-cite! 'signed-split-real 'omega 'ca 'nu 'a e)))
          (subst (dk-cite! 'signed-neg-value 'ca 'nu e))
          (subst (dk-cite! 'ext-neg-real (list 'nu e)))
          (dk-cite! 'sigma-algebra-difference-closed 'omega 'ca 'a e)
          (dk-cite! 'complement-in-subset e 'a)
          (dk-cite! 'pos-variation-upper 'ca 'nu 'a r)
          (dk-ineq! (list '<= (list 'nu r) p) (list '= '(nu a) (list '+ (list 'nu e) (list 'nu r)))
                    (list 'IN (list 'nu e) 'RR) (list 'IN (list 'nu r) 'RR) '(IN (nu a) RR) (list 'IN p 'RR))))))
  (dk-cite! 'pos-variation-least 'ca '(SIGNED-NEG ca nu) 'a b)
  (subst (dk-cite! 'neg-variation-unfold 'ca 'nu 'a))
  (dk-ass!))
(mfj-qed! 'jordan-neg-bound)

(sp (make-wff (dk-foralls '(omega ca nu a) (dk-curry (list '(IS-SIGNED-MEASURE omega ca nu) '(IN a ca) '(IN (nu a) RR) (list 'IN (mfj-nv 'a) 'RR))
  (list '<= (mfj-pv 'a) (list '+ '(nu a) (mfj-nv 'a)))))))
(dk-peel!)
(let* ((parts (mfj-sm-parts!)) (q (mfj-nv 'a)) (b (list '+ '(nu a) q))
       (qs (list '(POS-VARIATION ca (SIGNED-NEG ca nu)) 'a)))
  (mfj-snfacts!)
  (dk-cite! 'neg-variation-unfold 'ca 'nu 'a)
  ;; -nu(a) <= nu-(a)
  (dk-cite! 'subset-refl 'a)
  (dk-cite! 'pos-variation-upper 'ca '(SIGNED-NEG ca nu) 'a 'a)
  (dk-cite! 'signed-neg-value 'ca 'nu 'a)
  (dk-cite! 'ext-neg-real '(nu a))
  (dk-rewrite-h! (list '<= (mfj-sn 'a) qs) (mfj-sn 'a) '(EXT-NEG (nu a)))
  (dk-rewrite-h! (list '<= '(EXT-NEG (nu a)) qs) '(EXT-NEG (nu a)) '(- (nu a)))
  (dk-rewrite-h! (list '<= '(- (nu a)) qs) qs q)
  (dk-have-and! '(IN (nu a) RR) (list 'IN q 'RR)) (dk-cite! 'rr-add-closed '(nu a) q)
  (dk-have! (list '<= 0 b) (lambda () (dk-ineq! (list '<= '(- (nu a)) q) (list 'IN q 'RR) '(IN (nu a) RR))))
  (mfj-rps! b)
  (dk-have! (list 'FORALL 'e_ (dk-curry '((IN e_ ca) (SUBSET e_ a)) (list '<= '(nu e_) b)))
    (lambda ()
      (let ((e (dk-di-var!)))
        (di)
        (let ((r (list 'COMPLEMENT-IN 'a e)))
          (dk-split-all! (list (dk-cite! 'signed-split-real 'omega 'ca 'nu 'a e)))
          (dk-cite! 'sigma-algebra-difference-closed 'omega 'ca 'a e)
          (dk-cite! 'complement-in-subset e 'a)
          (dk-cite! 'pos-variation-upper 'ca '(SIGNED-NEG ca nu) 'a r)
          (dk-cite! 'signed-neg-value 'ca 'nu r)
          (dk-cite! 'ext-neg-real (list 'nu r))
          (dk-rewrite-h! (list '<= (mfj-sn r) qs) (mfj-sn r) (list 'EXT-NEG (list 'nu r)))
          (dk-rewrite-h! (list '<= (list 'EXT-NEG (list 'nu r)) qs) (list 'EXT-NEG (list 'nu r)) (list '- (list 'nu r)))
          (dk-rewrite-h! (list '<= (list '- (list 'nu r)) qs) qs q)
          (dk-ineq! (list '<= (list '- (list 'nu r)) q) (list '= '(nu a) (list '+ (list 'nu e) (list 'nu r)))
                    (list 'IN (list 'nu e) 'RR) (list 'IN (list 'nu r) 'RR) '(IN (nu a) RR) (list 'IN q 'RR))))))
  (dk-cite! 'pos-variation-least 'ca 'nu 'a b)
  (dk-ass!))
(mfj-qed! 'jordan-pos-bound)

;; ---------------------------------------------------------------------------
;; (62): nu = nu+ - nu-
(sp (make-wff (dk-foralls '(omega ca nu) (dk-curry '((IS-SIGNED-MEASURE omega ca nu))
  (list 'FORALL 'a (list 'IMPLIES '(IN a ca) (list '= '(nu a) (list 'EXT-SUB (mfj-pv 'a) (mfj-nv 'a)))))))))
(dk-peel!)
(let* ((parts (mfj-sm-parts!))
       (p (mfj-pv 'a)) (q (mfj-nv 'a))
       (qs (list '(POS-VARIATION ca (SIGNED-NEG ca nu)) 'a))
       (one (dk-cite! 'signed-measure-one-variation-finite 'omega 'ca 'nu)))
  (mfj-snfacts!)
  (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-STAR 'a)
  (dk-cite! 'pos-variation-in 'ca 'nu 'a)
  (dk-cite! 'pos-variation-in 'ca '(SIGNED-NEG ca nu) 'a)
  (dk-cite! 'neg-variation-unfold 'ca 'nu 'a)
  (dk-rewrite-h! (list 'IN qs 'RR-POS-STAR) qs q)
  (fact 'rr-pos-star-subset-rr-star)
  (dk-cite! 'subset-mem-fwd 'RR-POS-STAR 'RR-STAR p) (dk-cite! 'subset-mem-fwd 'RR-POS-STAR 'RR-STAR q)
  (mac 'EXT-SUB)
  (let ((fin! (lambda (v who)        ; land (IN (v a) RR) from the disjunct `who' of 3.13, or #f
                (dk-apply! (mfj-fin-all v) 'a))))
    (mfj-star-cases! '(nu a)
      (lambda (k)
        (case k
          ((pos)
           (dk-cite! 'pos-variation-ge 'ca 'nu 'a)
           (dk-rewrite-h! (list '<= '(nu a) p) '(nu a) 'POS-INF)
           (dk-cite! 'rr-star-le-pos-inf-eq p)
           (dk-or-each! one
             (lambda (d)
               (if (dk-contains? d '(POS-VARIATION ca nu))
                   (begin (fin! '(POS-VARIATION ca nu) d)
                          (dk-rewrite-h! (list 'IN p 'RR) p 'POS-INF)
                          (ai (dk-cite! 'pos-inf-not-in-rr)))
                   (begin
                     (subst (list '= p 'POS-INF)) (subst '(= (nu a) POS-INF))
                     (dk-cite! 'ext-neg-in q)
                     (subst (dk-cite! 'ext-add-pos-inf-left (list 'EXT-NEG q)))
                     (rfl))))))
          ((neg)
           (dk-cite! 'subset-refl 'a)
           (dk-cite! 'pos-variation-upper 'ca '(SIGNED-NEG ca nu) 'a 'a)
           (dk-cite! 'signed-neg-value 'ca 'nu 'a)
           (dk-rewrite-h! (list '<= (mfj-sn 'a) qs) (mfj-sn 'a) '(EXT-NEG (nu a)))
           (dk-rewrite-h! (list '<= '(EXT-NEG (nu a)) qs) '(nu a) 'NEG-INF)
           (fact 'ext-neg-neg-inf)
           (dk-rewrite-h! (list '<= '(EXT-NEG NEG-INF) qs) '(EXT-NEG NEG-INF) 'POS-INF)
           (dk-rewrite-h! (list '<= 'POS-INF qs) qs q)
           (dk-cite! 'rr-star-le-pos-inf-eq q)
           (dk-or-each! one
             (lambda (d)
               (if (dk-contains? d '(NEG-VARIATION ca nu))
                   (begin (fin! '(NEG-VARIATION ca nu) d)
                          (dk-rewrite-h! (list 'IN q 'RR) q 'POS-INF)
                          (ai (dk-cite! 'pos-inf-not-in-rr)))
                   (begin
                     (fin! '(POS-VARIATION ca nu) d)
                     (subst (list '= q 'POS-INF)) (subst '(= (nu a) NEG-INF))
                     (fact 'ext-neg-pos-inf)
                     (subst '(= (EXT-NEG POS-INF) NEG-INF))
                     (dk-cite! 'ext-real-not-pos-inf p)
                     (subst (dk-cite! 'ext-add-neg-inf-right p))
                     (rfl))))))
          (else
           (let ((finish!
                   (lambda ()           ; p real
                     (dk-cite! 'jordan-neg-bound 'omega 'ca 'nu 'a)
                     (dk-type! (list '- p '(nu a)) 'RR)
                     (dk-have-and! (list 'IN q 'RR-POS-STAR) (list 'IN (list '- p '(nu a)) 'RR))
                     (dk-cite! 'rr-pos-star-le-real-in-rr q (list '- p '(nu a)))
                     (dk-cite! 'jordan-pos-bound 'omega 'ca 'nu 'a)
                     (subst (dk-cite! 'ext-neg-real q))
                     (dk-cite! 'rr-neg-closed q)
                     (subst (dk-cite! 'ext-add-real p (list '- q)))
                     (dk-ineq! (list '<= q (list '- p '(nu a))) (list '<= p (list '+ '(nu a) q))
                               (list 'IN p 'RR) (list 'IN q 'RR) '(IN (nu a) RR)))))
             (dk-or-each! one
               (lambda (d)
                 (if (dk-contains? d '(POS-VARIATION ca nu))
                     (begin (fin! '(POS-VARIATION ca nu) d) (finish!))
                     (begin
                       (fin! '(NEG-VARIATION ca nu) d)
                       (dk-cite! 'jordan-pos-bound 'omega 'ca 'nu 'a)
                       (dk-have-and! '(IN (nu a) RR) (list 'IN q 'RR)) (dk-cite! 'rr-add-closed '(nu a) q)
                       (dk-have-and! (list 'IN p 'RR-POS-STAR) (list 'IN (list '+ '(nu a) q) 'RR))
                       (dk-cite! 'rr-pos-star-le-real-in-rr p (list '+ '(nu a) q))
                       (finish!))))))))))))
(mfj-qed! 'jordan-decomposition-value)

;; Proposition 3.12
(sp (make-wff (dk-foralls '(omega ca nu) (dk-curry '((IS-SIGNED-MEASURE omega ca nu))
  (dk-and (list '(IS-MEASURE omega ca (POS-VARIATION ca nu)) '(IS-MEASURE omega ca (NEG-VARIATION ca nu)) mfj-one-finite
                (list 'FORALL 'a (list 'IMPLIES '(IN a ca) (list '= '(nu a) (list 'EXT-SUB (mfj-pv 'a) (mfj-nv 'a)))))))))))
(dk-peel!)
(dk-cite! 'pos-variation-is-measure 'omega 'ca 'nu)
(dk-cite! 'neg-variation-is-measure 'omega 'ca 'nu)
(dk-cite! 'signed-measure-one-variation-finite 'omega 'ca 'nu)
(dk-cite! 'jordan-decomposition-value 'omega 'ca 'nu)
(dk-conj-close! dk-ass!)
(mfj-qed! 'jordan-decomposition)

  

