;;; mf-jordan.scm -- Prop 3.12 (Jordan decomposition), Cor 3.13, Def 3.14 and Remark 3.15.
;;; Agent M-F, 2026-10-29.  DESTINATION: theorem-library/jordan-decomposition.scm.  Library: measure.
;;; Helper prefix: mfj-.  Load window: after mf-fin3.scm.

