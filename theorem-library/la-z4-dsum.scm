;;; la-z4-dsum.scm -- dropping trivial summands from a direct sum; Z/(1) is the zero module
;;; (LA-Z4, 2026-10-24).  Vocabulary: structure-library/la-z3-vocab (DIRECT-SUM, ZZ-MOD).
;;; Prefix lzu-.
;;;
;;; PLAN.  dsum-drop-iso: if F(1), ..., F(k) are zero modules and G(i) = F(k + i) for
;;; i in [1, l], m = k + l, then x |-> (i |-> x(k + i)) is an isomorphism of the direct
;;; sum of F(1..m) onto the direct sum of G(1..l).  Its inverse pads with zeros:
;;; y |-> (j |-> IF j <= k THEN 0 ELSE y(j - k)), the subtraction being NN-MINUS.  The
;;; map is a homomorphism componentwise, one-to-one because the first k components are
;;; zero, and onto by the padding.  zz-mod-one-trivial: Z/(1) has one element.
;;;
;;; Destination theorem-library/.  Library: linear-algebra.  LOAD WINDOW: after
;;; theorem-library/la-z3-quotient and la-z3-dsum.

(define (lzu-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z4-dsum: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'algebra))
(define (lzu-iv-var ld cls)
  (let ((f (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cls))) ld)))
    (if (not f) (error "lzu-iv-var: no typing in" (expression->string cls)))
    (cadr f)))
(define (lzu-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!) #f))   ; #t when beta grounded the leaf
(define (lzu-iv! i a b)                  ; i in [a,b]: land i in NN, a <= i, i <= b
  (fact 'interval-elt-in-nn a b i)
  (fact 'interval-lo a b i)
  (fact 'interval-hi a b i))
(define (lzu-nn-add! a b)
  (if (not (dk-asm? (list 'IN (list '+ a b) 'NN)))
      (begin
        (dk-have! (list 'AND (list 'IN a 'NN) (list 'IN b 'NN)) (lambda () (dk-conj-close! (lambda () (ass)))))
        (fact 'nn-add-closed a b))))

;;; =====================================================================
;;; index arithmetic
;;; =====================================================================
(sp (make-wff (forall-guarded '(m k l i) '((IN m NN) (IN k NN) (IN l NN) (= m (+ k l)) (IN i (INTERVAL 1 l)))
  '(AND (IN (+ k i) (INTERVAL 1 m)) (NOT (<= (+ k i) k))))))
(dk-peel!)
(lzu-iv! 'i 1 'l)
(lzu-nn-add! 'k 'i)
(dk-have! '(<= 1 (+ k i)) (lambda () (dk-nn! '(<= 1 i))))
(dk-have! '(<= (+ k i) m) (lambda () (dk-nn! '(<= i l) '(= m (+ k l)))))
(fact 'interval-mem-intro 1 'm '(+ k i))
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (ass) (dk-nn! '(<= 1 i)))))
(lzu-done! 'lzu-shift-in)

(sp (make-wff (forall-guarded '(m k l j) '((IN m NN) (IN k NN) (IN l NN) (= m (+ k l)) (IN j (INTERVAL 1 m)) (NOT (<= j k)))
  '(AND (IN (NN-MINUS j k) (INTERVAL 1 l)) (= (+ k (NN-MINUS j k)) j)))))
(dk-peel!)
(lzu-iv! 'j 1 'm)
(fact 'nn-not-le-succ-le 'j 'k)
(dk-have! '(<= k j) (lambda () (dk-nn! '(<= (succ k) j))))
(fact 'nn-minus-in-nn 'j 'k)
(let ((def (dk-cite! 'nn-minus-def 'j 'k)))
  (dk-have! '(= (NN-MINUS j k) (- j k))
    (lambda ()
      (subst def)
      (dk-if-branch! #t (caddr def) #f (lambda () (rfl))))))
(dk-have! '(<= 1 (NN-MINUS j k)) (lambda () (dk-nn! '(= (NN-MINUS j k) (- j k)) '(<= (succ k) j))))
(dk-have! '(<= (NN-MINUS j k) l) (lambda () (dk-nn! '(= (NN-MINUS j k) (- j k)) '(<= j m) '(= m (+ k l)))))
(fact 'interval-mem-intro 1 'l '(NN-MINUS j k))
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (ass) (dk-nn! '(= (NN-MINUS j k) (- j k))))))
(lzu-done! 'lzu-shift-back)

(sp (make-wff (forall-guarded '(k i) '((IN k NN) (IN i NN)) '(= (NN-MINUS (+ k i) k) i))))
(dk-peel!)
(lzu-nn-add! 'k 'i)
(dk-have! '(<= k (+ k i)) (lambda () (dk-nn!)))
(let ((def (dk-cite! 'nn-minus-def '(+ k i) 'k)))
  (dk-have! '(= (NN-MINUS (+ k i) k) (- (+ k i) k))
    (lambda ()
      (subst def)
      (dk-if-branch! #t (caddr def) #f (lambda () (rfl))))))
(subst '(= (NN-MINUS (+ k i) k) (- (+ k i) k)))
(dk-nn!)
(lzu-done! 'lzu-shift-cancel)

(sp (make-wff (forall-guarded '(m k j) '((IN m NN) (IN k NN) (IN j (INTERVAL 1 m)) (<= j k)) '(IN j (INTERVAL 1 k)))))
(dk-peel!)
(lzu-iv! 'j 1 'm)
(fact 'interval-mem-intro 1 'k 'j)
(ass)
(lzu-done! 'lzu-prefix-in)

;;; =====================================================================
;;; the direct sum with the first k (zero) summands dropped
;;; =====================================================================
(define LZU-DSF '(DIRECT-SUM S m F))
(define LZU-DSG '(DIRECT-SUM S l G))
(define LZU-VF '(VEC (DIRECT-SUM S m F)))
(define LZU-VG '(VEC (DIRECT-SUM S l G)))
(define LZU-DROP '(VNB-LAMBDA dpx_ (VEC (DIRECT-SUM S m F)) (VNB-LAMBDA dpi_ (INTERVAL 1 l) (dpx_ (+ k dpi_)))))
(define LZU-PAD '(VNB-LAMBDA dpy_ (VEC (DIRECT-SUM S l G))
                   (VNB-LAMBDA dpj_ (INTERVAL 1 m) (IF (<= dpj_ k) (VZERO (F dpj_)) (dpy_ (NN-MINUS dpj_ k))))))
(define (lzu-dr x) (list LZU-DROP x))
(define (lzu-pd y) (list LZU-PAD y))
(define LZU-HMF '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 m)) (IS-MODULE (F i_)))))
(define LZU-HSF '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 m)) (= (SCAL (F i_)) S))))
(define LZU-HMG '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 l)) (IS-MODULE (G i_)))))
(define LZU-HSG '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 l)) (= (SCAL (G i_)) S))))
(define LZU-HGF '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 l)) (= (G i_) (F (+ k i_))))))
(define LZU-HTRIV '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 k)) (FORALL x_ (IMPLIES (IN x_ (VEC (F i_))) (= x_ (VZERO (F i_))))))))
(define LZU-HYPS (list '(IS-RING S) '(IN m NN) '(IN k NN) '(IN l NN) '(= m (+ k l))
                       LZU-HMF LZU-HSF LZU-HMG LZU-HSG LZU-HGF LZU-HTRIV))
(define (lzu-stmt vars guards body) (forall-guarded (append '(S m k l F G) vars) (append LZU-HYPS guards) body))
(define (lzu-setup!)
  (fact 'direct-sum-is-module 'S 'm 'F)
  (fact 'direct-sum-is-module 'S 'l 'G)
  (for-each (lambda (nm) (fact nm 'S 'm 'F) (fact nm 'S 'l 'G))
            '(dsum-ro-scal dsum-ro-vec dsum-ro-vadd dsum-ro-vzero dsum-ro-vneg dsum-ro-act dsum-vec-set2)))
(define (lzu-dsv! x m-or-l)              ; (IN x (DSUM-VEC _ _)) from (IN x (VEC DS))
  (let* ((ds (if (eq? m-or-l 'm) LZU-DSF LZU-DSG))
         (dv (if (eq? m-or-l 'm) '(DSUM-VEC m F) '(DSUM-VEC l G))))
    (if (not (dk-asm? (list 'IN x dv)))
        (dk-rewrite-h! (list 'IN x (list 'VEC ds)) (list 'VEC ds) dv))))
(define (lzu-sh! i)                       ; i in [1,l]: (+ k i) in [1,m] and NOT (+ k i) <= k
  (if (not (dk-asm? (list 'IN (list '+ 'k i) '(INTERVAL 1 m))))
      (dk-split! (dk-cite! 'lzu-shift-in 'm 'k 'l i))))
(define (lzu-gf! i)                       ; (G i) = (F (+ k i)), and IS-MODULE of both
  (dk-apply! LZU-HGF i)
  (dk-apply! LZU-HMG i)
  (lzu-sh! i)
  (dk-apply! LZU-HMF (list '+ 'k i)))
(define (lzu-fun1! lam dom body-closer)   ; (IN lam (FUN dom)) via lam-t into (FUN dom SET);
  (dk-have! (list 'IN lam (list 'FUN dom 'SET))   ; BODY-CLOSER (of the index) closes (IN body SET)
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((ld (dk-peel!)) (i (lzu-iv-var ld dom)))
            (if (not (lzu-beta!)) (body-closer i))))
        (lambda () (fact 'interval-in-set 1 (caddr dom)) (ass)))))
  (dk-have! (list 'IN lam (list 'FUN dom))
    (lambda ()
      (mac-h 'fun-codomain-iff (dk-ctx-form (list 'IN lam (list 'FUN dom 'SET))))
      (dk-split-all!)
      (ass))))

;; x in VEC DSF, i in [1,l] in context: land (IN (x (+ k i)) (VEC (G i)))
(define (lzu-xk! x i)
  (lzu-gf! i)
  (lzu-dsv! x 'm)
  (let ((h (dk-cite! 'dsum-member-elim 'S 'm 'F x (list '+ 'k i))))
    (if (not (dk-asm? (list 'IN (list x (list '+ 'k i)) (list 'VEC (list 'G i)))))
        (dk-rewrite-h! h (list 'F (list '+ 'k i)) (list 'G i)))))

(sp (make-wff (lzu-stmt '(x) (list (list 'IN 'x LZU-VF)) (list 'IN (lzu-dr 'x) LZU-VG))))
(dk-peel!)
(lzu-setup!)
(dk-lam-b!)
(let ((lam '(VNB-LAMBDA dpi_ (INTERVAL 1 l) (x (+ k dpi_)))))
  (lzu-fun1! lam '(INTERVAL 1 l)
    (lambda (i) (lzu-xk! 'x i) (fact 'membership-implies-sethood (list 'x (list '+ 'k i)) (list 'VEC (list 'G i))) (ass)))
  (dk-have! (list 'FORALL 'dsj_ (list 'IMPLIES '(IN dsj_ (INTERVAL 1 l)) (list 'IN (list lam 'dsj_) '(VEC (G dsj_)))))
    (lambda ()
      (let* ((ld (dk-peel!)) (i (lzu-iv-var ld '(INTERVAL 1 l))))
        (if (not (lzu-beta!))
            (begin (lzu-xk! 'x i) (ass))))))
  (fact 'dsum-member-intro 'S 'l 'G lam)
  (ass))
(lzu-done! 'lzu-drop-vec)

(sp (make-wff (lzu-stmt '(x i) (list (list 'IN 'x LZU-VF) '(IN i (INTERVAL 1 l))) (list '= (list (lzu-dr 'x) 'i) '(x (+ k i))))))
(dk-peel!)
(lzu-setup!)
(lzu-xk! 'x 'i)
(if (not (lzu-beta!)) (rfl))
(lzu-done! 'lzu-drop-at)

;; the homomorphism: componentwise
(define (lzu-ext-g! lhs rhs pointwise)   ; (= lhs rhs) in DSG by components; both typed in VEC DSG
  (let ((pt (list 'FORALL 'dsj_ (list 'IMPLIES '(IN dsj_ (INTERVAL 1 l)) (list '= (list lhs 'dsj_) (list rhs 'dsj_))))))
    (dk-have! pt (lambda () (let* ((ld (dk-peel!)) (i (lzu-iv-var ld '(INTERVAL 1 l)))) (pointwise i))))
    (fact 'dsum-ext 'S 'l 'G lhs rhs)
    (ass)))
(define (lzu-dvec! z)                     ; (IN (DROP z) VG) for z in VF
  (if (not (dk-asm? (list 'IN (lzu-dr z) LZU-VG))) (fact 'lzu-drop-vec 'S 'm 'k 'l 'F 'G z)))
(define (lzu-dat! z i) (subst (dk-cite! 'lzu-drop-at 'S 'm 'k 'l 'F 'G z i)))
(sp (make-wff (lzu-stmt '() '() (list 'IS-HOM-MODULE LZU-DSF LZU-DSG LZU-DROP))))
(dk-peel!)
(lzu-setup!)
(dk-have! (list 'IN LZU-DROP (list 'FUN LZU-VF LZU-VG))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let* ((ld (dk-peel!)) (x (lzu-iv-var ld LZU-VF)))
          (if (not (lzu-beta!))
              (begin (fact 'lzu-drop-vec 'S 'm 'k 'l 'F 'G x)
                     (dk-lam-b-h! (list 'IN (lzu-dr x) LZU-VG))
                     (ass)))))
      (lambda () (ass)))))
(mac 'is-hom-module-def)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'SCAL))
         (subst (list '= (list 'SCAL LZU-DSF) 'S))
         (subst (list '= (list 'SCAL LZU-DSG) 'S))
         (rfl))
        ((dk-head-is? g '=)                       ; zero
         (fact 'module-vzero-in LZU-DSF)
         (fact 'module-vzero-in LZU-DSG)
         (lzu-dvec! (list 'VZERO LZU-DSF))
         (lzu-ext-g! (lzu-dr (list 'VZERO LZU-DSF)) (list 'VZERO LZU-DSG)
           (lambda (i)
             (lzu-gf! i)
             (lzu-dat! (list 'VZERO LZU-DSF) i)
             (subst (dk-cite! 'dsum-vzero-at 'S 'm 'F (list '+ 'k i)))
             (subst (dk-cite! 'dsum-vzero-at 'S 'l 'G i))
             (subst (list '= (list 'G i) (list 'F (list '+ 'k i))))
             (fact 'module-vzero-in (list 'F (list '+ 'k i)))
             (rfl))))
        (#t
         (let* ((ld (dk-peel!))
                (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) LZU-VF))) ld)))
                (rs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'CARR (list 'SCAL LZU-DSF))))) ld))))
           (for-each (lambda (x) (lzu-dvec! x) (lzu-dsv! x 'm) (lzu-dsv! (lzu-dr x) 'l)) vs)
           (cond
             ((pair? rs)
              (let* ((r (car rs)) (x (car vs)) (rx (list (list 'ACT LZU-DSF) r x)))
                (fact 'module-act-type LZU-DSF r x)
                (lzu-dvec! rx)
                (dk-rewrite-h! (list 'IN r (list 'CARR (list 'SCAL LZU-DSF))) (list 'SCAL LZU-DSF) 'S)
                (dk-have! (list 'IN r (list 'CARR (list 'SCAL LZU-DSG))) (lambda () (subst (list '= (list 'SCAL LZU-DSG) 'S)) (ass)))
                (fact 'module-act-type LZU-DSG r (lzu-dr x))
                (lzu-ext-g! (lzu-dr rx) (list (list 'ACT LZU-DSG) r (lzu-dr x))
                  (lambda (i)
                    (lzu-gf! i)
                    (lzu-xk! x i)
                    (subst (dk-cite! 'dsum-act-at 'S 'l 'G r (lzu-dr x) i))
                    (lzu-dat! rx i) (lzu-dat! x i)
                    (subst (dk-cite! 'dsum-act-at 'S 'm 'F r x (list '+ 'k i)))
                    (subst (list '= (list 'G i) (list 'F (list '+ 'k i))))
                    (dk-apply! LZU-HSF (list '+ 'k i))
                    (dk-have! (list 'IN r (list 'CARR (list 'SCAL (list 'F (list '+ 'k i)))))
                      (lambda () (subst (list '= (list 'SCAL (list 'F (list '+ 'k i))) 'S)) (ass)))
                    (dk-rewrite-h! (list 'IN (list x (list '+ 'k i)) (list 'VEC (list 'G i))) (list 'G i) (list 'F (list '+ 'k i)))
                    (fact 'module-act-type (list 'F (list '+ 'k i)) r (list x (list '+ 'k i)))
                    (rfl)))))
             ((= (length vs) 2)
              (let* ((x (car vs)) (y (cadr vs)) (xy (list (list 'VADD LZU-DSF) x y)))
                (fact 'module-vadd-type LZU-DSF x y)
                (lzu-dvec! xy)
                (fact 'module-vadd-type LZU-DSG (lzu-dr x) (lzu-dr y))
                (lzu-ext-g! (lzu-dr xy) (list (list 'VADD LZU-DSG) (lzu-dr x) (lzu-dr y))
                  (lambda (i)
                    (lzu-gf! i)
                    (lzu-xk! x i) (lzu-xk! y i)
                    (subst (dk-cite! 'dsum-vadd-at 'S 'l 'G (lzu-dr x) (lzu-dr y) i))
                    (lzu-dat! xy i) (lzu-dat! x i) (lzu-dat! y i)
                    (subst (dk-cite! 'dsum-vadd-at 'S 'm 'F x y (list '+ 'k i)))
                    (subst (list '= (list 'G i) (list 'F (list '+ 'k i))))
                    (dk-rewrite-h! (list 'IN (list x (list '+ 'k i)) (list 'VEC (list 'G i))) (list 'G i) (list 'F (list '+ 'k i)))
                    (dk-rewrite-h! (list 'IN (list y (list '+ 'k i)) (list 'VEC (list 'G i))) (list 'G i) (list 'F (list '+ 'k i)))
                    (fact 'module-vadd-type (list 'F (list '+ 'k i)) (list x (list '+ 'k i)) (list y (list '+ 'k i)))
                    (rfl)))))
             (#t
              (let* ((x (car vs)) (nx (list (list 'VNEG LZU-DSF) x)))
                (fact 'module-vneg-type LZU-DSF x)
                (lzu-dvec! nx)
                (fact 'module-vneg-type LZU-DSG (lzu-dr x))
                (lzu-ext-g! (lzu-dr nx) (list (list 'VNEG LZU-DSG) (lzu-dr x))
                  (lambda (i)
                    (lzu-gf! i)
                    (lzu-xk! x i)
                    (subst (dk-cite! 'dsum-vneg-at 'S 'l 'G (lzu-dr x) i))
                    (lzu-dat! nx i) (lzu-dat! x i)
                    (subst (dk-cite! 'dsum-vneg-at 'S 'm 'F x (list '+ 'k i)))
                    (subst (list '= (list 'G i) (list 'F (list '+ 'k i))))
                    (dk-rewrite-h! (list 'IN (list x (list '+ 'k i)) (list 'VEC (list 'G i))) (list 'G i) (list 'F (list '+ 'k i)))
                    (fact 'module-vneg-type (list 'F (list '+ 'k i)) (list x (list '+ 'k i)))
                    (rfl))))))))))))
(lzu-done! 'lzu-drop-hom)

;; the padding
(define (lzu-find-if e)
  (cond ((and (pair? e) (eq? (car e) 'IF)) e)
        ((pair? e) (or (lzu-find-if (car e)) (lzu-find-if (cdr e))))
        (#t #f)))
(define (lzu-pad-pt! y j set?)            ; goal (IN <IF of PAD y at j> C), C = VEC (F j) or SET
  (let ((ift (lzu-find-if (dk-goal))))
    (dk-case-if! ift
      (lambda (true? v)
        (dk-apply! LZU-HMF j)
        (if true?
            (begin
              (fact 'module-vzero-in (list 'F j))
              (if set? (fact 'membership-implies-sethood (list 'VZERO (list 'F j)) (list 'VEC (list 'F j))))
              (ass))
            (let* ((sb (dk-split! (dk-cite! 'lzu-shift-back 'm 'k 'l j)))
                   (mj (list 'NN-MINUS j 'k)))
              (lzu-gf! mj)
              (lzu-dsv! y 'l)
              (let* ((h1 (dk-cite! 'dsum-member-elim 'S 'l 'G y mj))
                     (h2 (dk-rewrite-h! h1 (list 'G mj) (list 'F (list '+ 'k mj))))
                     (h3 (dk-rewrite-h! h2 (list '+ 'k mj) j)))
                (if set? (fact 'membership-implies-sethood (list y mj) (list 'VEC (list 'F j))))
                (ass))))))))
(sp (make-wff (lzu-stmt '(y) (list (list 'IN 'y LZU-VG)) (list 'IN (lzu-pd 'y) LZU-VF))))
(dk-peel!)
(lzu-setup!)
(dk-lam-b!)
(let ((lam '(VNB-LAMBDA dpj_ (INTERVAL 1 m) (IF (<= dpj_ k) (VZERO (F dpj_)) (y (NN-MINUS dpj_ k))))))
  (lzu-fun1! lam '(INTERVAL 1 m) (lambda (j) (lzu-pad-pt! 'y j #t)))
  (dk-have! (list 'FORALL 'dsj_ (list 'IMPLIES '(IN dsj_ (INTERVAL 1 m)) (list 'IN (list lam 'dsj_) '(VEC (F dsj_)))))
    (lambda ()
      (let* ((ld (dk-peel!)) (j (lzu-iv-var ld '(INTERVAL 1 m))))
        (if (not (lzu-beta!))
            (lzu-pad-pt! 'y j #f)))))
  (fact 'dsum-member-intro 'S 'm 'F lam)
  (ass))
(lzu-done! 'lzu-pad-vec)

(sp (make-wff (lzu-stmt '(y) (list (list 'IN 'y LZU-VG)) (list '= (lzu-dr (lzu-pd 'y)) 'y))))
(dk-peel!)
(lzu-setup!)
(fact 'lzu-pad-vec 'S 'm 'k 'l 'F 'G 'y)
(lzu-dvec! (lzu-pd 'y))
(lzu-ext-g! (lzu-dr (lzu-pd 'y)) 'y
  (lambda (i)
    (lzu-sh! i)
    (lzu-dat! (lzu-pd 'y) i)
    (dk-lam-b!)
    (let ((ift (lzu-find-if (dk-goal))))
      (dk-if-branch! #f ift #f
        (lambda ()
          (lzu-iv! i 1 'l)
          (subst (dk-cite! 'lzu-shift-cancel 'k i))
          (lzu-dsv! 'y 'l)
          (fact 'dsum-member-elim 'S 'l 'G 'y i)
          (rfl))))))
(lzu-done! 'lzu-drop-pad)

(sp (make-wff (lzu-stmt '(a b) (list (list 'IN 'a LZU-VF) (list 'IN 'b LZU-VF) (list '= (lzu-dr 'a) (lzu-dr 'b))) '(= a b))))
(dk-peel!)
(lzu-setup!)
(lzu-dvec! 'a) (lzu-dvec! 'b)
(lzu-dsv! 'a 'm) (lzu-dsv! 'b 'm)
(lzu-dsv! (lzu-dr 'b) 'l)
(dk-have! '(FORALL dsj_ (IMPLIES (IN dsj_ (INTERVAL 1 m)) (= (a dsj_) (b dsj_))))
  (lambda ()
    (let* ((ld (dk-peel!)) (j (lzu-iv-var ld '(INTERVAL 1 m))))
      (dk-apply! LZU-HMF j)
      (fact 'dsum-member-elim 'S 'm 'F 'a j)
      (fact 'dsum-member-elim 'S 'm 'F 'b j)
      (use-em (list '<= j 'k)
        (lambda ()
          (fact 'lzu-prefix-in 'm 'k j)
          (let ((tr (dk-apply! LZU-HTRIV j)))
            (subst (dk-apply! tr (list 'a j)))
            (subst (dk-apply! tr (list 'b j)))
            (fact 'module-vzero-in (list 'F j))
            (rfl)))
        (lambda ()
          (dk-split! (dk-cite! 'lzu-shift-back 'm 'k 'l j))
          (let ((mj (list 'NN-MINUS j 'k)))
            (fact 'dsum-member-elim 'S 'l 'G (lzu-dr 'b) mj)
            (let* ((c1 (dk-congr! (list '= (lzu-dr 'a) (lzu-dr 'b)) (lambda (t) (list t mj))))
                   (ea (dk-cite! 'lzu-drop-at 'S 'm 'k 'l 'F 'G 'a mj))
                   (eb (dk-cite! 'lzu-drop-at 'S 'm 'k 'l 'F 'G 'b mj))
                   (c2 (dk-rewrite-h! c1 (list (lzu-dr 'a) mj) (list 'a (list '+ 'k mj))))
                   (c3 (dk-rewrite-h! c2 (list (lzu-dr 'b) mj) (list 'b (list '+ 'k mj))))
                   (c4 (dk-rewrite-h! c3 (list '+ 'k mj) j)))
              (ass))))))))
(fact 'dsum-ext 'S 'm 'F 'a 'b)
(ass)
(lzu-done! 'lzu-drop-inj)

(sp (make-wff (lzu-stmt '() '() (list 'IS-ISO-MODULE LZU-DSF LZU-DSG LZU-DROP))))
(dk-peel!)
(lzu-setup!)
(fact 'lzu-drop-hom 'S 'm 'k 'l 'F 'G)
(fact 'is-hom-module-def LZU-DSF LZU-DSG LZU-DROP)
(mac 'IS-ISO-MODULE)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal))
        (ass)
        (let ((iff (dk-meta-iff! 'bijection-membership-iff LZU-VF LZU-VG LZU-DROP)))
          (dk-have! (caddr iff)
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (let ((g (dk-goal)))
                    (cond
                      ((dk-head-is? g 'IN)
                       (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-hom-module-def LZU-DSF LZU-DSG LZU-DROP))))
                       (ass))
                      ((dk-head-is? (caddr (caddr g)) 'FORSOME)
                       (let* ((ld (dk-peel!)) (w (lzu-iv-var ld LZU-VG)))
                         (fact 'lzu-pad-vec 'S 'm 'k 'l 'F 'G w)
                         (ew (lzu-pd w))
                         (dk-conj-close!
                           (lambda ()
                             (if (dk-asm? (dk-goal)) (ass)
                                 (begin (dk-cite! 'lzu-drop-pad 'S 'm 'k 'l 'F 'G w) (ass)))))))
                      (#t
                       (let* ((ld (dk-peel!))
                              (ab (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) LZU-VF))) ld))))
                         (dk-cite! 'lzu-drop-inj 'S 'm 'k 'l 'F 'G (car ab) (cadr ab))
                         (ass)))))))))
          (dk-meta-iff-l! iff)
          (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))))
(lzu-done! 'dsum-drop-iso)
(gloss! 'dsum-drop-iso "If F(1), ..., F(k) are zero modules and G(i) = F(k + i), then dropping the first k components is an isomorphism of F(1) + ... + F(k + l) onto G(1) + ... + G(l).")

;;; =====================================================================
;;; Z/(1) is the zero module
;;; =====================================================================
(define LZU-ZM '(RING-AS-MODULE ZZ-RING))
(define LZU-ZPI '(PRINCIPAL-IDEAL ZZ-RING 1))
(define LZU-ZS '(QMOD-SETOID (RING-AS-MODULE ZZ-RING) (PRINCIPAL-IDEAL ZZ-RING 1)))
(define (lzu-zcl t) (list 'CLASS LZU-ZS t))
(sp (make-wff '(FORALL x_ (IMPLIES (IN x_ (VEC (ZZ-MOD 1))) (= x_ (VZERO (ZZ-MOD 1)))))))
(dk-peel!)
(fact 'zz-is-commutative-ring)
(fact 'zz-is-ring)
(dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl)))
(fact 'zz-one-in)
(dk-rewrite-h! '(IN 1 ZZ) 'ZZ '(CARR ZZ-RING))
(fact 'ring-as-module-is-module 'ZZ-RING)
(fact 'principal-ideal-is-submodule 'ZZ-RING 1)
(for-each (lambda (nm) (fact nm 'ZZ-RING)) '(ram-ro-vec ram-ro-vadd ram-ro-vneg))
(fact 'qmod-setoid-is-setoid LZU-ZM LZU-ZPI)
(fact 'qmod-setoid-pts LZU-ZM LZU-ZPI)
(fact 'zz-mod-vec 1)
(fact 'zz-mod-vzero 1)
(let* ((h1 (dk-rewrite-h! '(IN x_ (VEC (ZZ-MOD 1))) '(VEC (ZZ-MOD 1)) (list 'QUOTIENT LZU-ZS)))
       (r (dk-skolem! (dk-cite! 'quotient-rep LZU-ZS 'x_))))
  (dk-rewrite-h! (list 'IN r (list 'PTS LZU-ZS)) (list 'PTS LZU-ZS) (list 'VEC LZU-ZM))
  (dk-rewrite-h! (list 'IN r (list 'VEC LZU-ZM)) (list 'VEC LZU-ZM) '(CARR ZZ-RING))
  (subst (list '= 'x_ (lzu-zcl r)))
  (subst (list '= '(VZERO (ZZ-MOD 1)) (lzu-zcl '(ZERO ZZ-RING))))
  (fact 'ring-zero-in 'ZZ-RING)
  (let* ((iff (dk-cite! 'zz-mod-class-eq-iff 1 r '(ZERO ZZ-RING)))
         (d (list '(ADD ZZ-RING) r '((NEG ZZ-RING) (ZERO ZZ-RING)))))
    (fact 'ring-neg-in-carr 'ZZ-RING '(ZERO ZZ-RING))
    (fact 'ring-add-closed 'ZZ-RING r '((NEG ZZ-RING) (ZERO ZZ-RING)))
    (let ((pim (dk-cite! 'principal-ideal-membership 'ZZ-RING 1 d)))
      (dk-have! (caddr pim)
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal))
                  (ass)
                  (begin
                    (ew d)
                    (dk-conj-close!
                      (lambda ()
                        (if (dk-asm? (dk-goal))
                            (ass)
                            (begin
                              (dk-have! '(== (ONE ZZ-RING) 1) (lambda () (slot 'ONE) (qrfl)))
                              (subst '(= 1 (ONE ZZ-RING)))
                              (subst (dk-cite! 'ring-mul-right-id 'ZZ-RING d))
                              (rfl)))))))))))
      (dk-meta-iff-l! pim))
    (dk-meta-iff-l! iff)
    (ass)))
(lzu-done! 'zz-mod-one-trivial)
(gloss! 'zz-mod-one-trivial "Z/(1) is the zero module: every element is its zero.")
