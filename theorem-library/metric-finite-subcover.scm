;;; theorem-library/metric-finite-subcover.scm -- a closed set of a compact metric space
;;; covered by countably many open sets is covered by finitely many of them.
;;; Library: analysis.  MOVED 2026-10-20 (the wiring of CALC-3) from
;;; theorem-library/riesz-markov-cantor.scm (library measure), where RM-2 proved it as
;;; `rmc-finite-subcover'; the statement and the proof are unchanged, the helpers are
;;; copies of the rmc- kit under this file's prefix mfs-.  It is pure metric topology and
;;; analysis files cite it (calc3-uniform), which the library gate refuses from measure.
;;;
;;;   compact-closed-countable-subcover   the theorem (was rmc-finite-subcover)
;;;
;;; Load window: after theorem-library/riesz-markov-model (rmm-nn-choice) and the metric
;;; compactness files; before riesz-markov-cantor and calc3-uniform.  No top-level macro.

(define (mfs-prop! . keepers)
  (apply dk-only! keepers)
  (prop))

(define (mfs-pos! e)
  (dk-cite! 'rr-pos-rr-in-rr e)
  (dk-cite! 'rr-lt-of-pos-rr e))

(define (mfs-d m a b) (list (list 'DIST m) a b))

;;; (mfs-in-ball! S A R B D): with (POS-RR D), (= (+ D D) R), B in PTS S and
;;; d(A, B) <= D in context, land (IN B (BALL S A R)).
(define (mfs-in-ball! s a r b d)
  (let ((dab (mfs-d s a b)))
    (dk-cite! 'metric-dist-real s a b)
    (mfs-pos! d)
    (mfs-pos! r)
    (dk-have! (list '<= dab r)
      (lambda () (dk-ineq! (list '<= dab d) (list '= (list '+ d d) r) (list '< 0 d)
                           (list 'IN dab 'RR) (list 'IN d 'RR) (list 'IN r 'RR))))
    (dk-have! (list 'NOT (list '= dab r))
      (lambda ()
        (di)
        (dk-absurd! (list '= dab r) (list '<= dab d) (list '= (list '+ d d) r) (list '< 0 d)
                    (list 'IN dab 'RR) (list 'IN d 'RR) (list 'IN r 'RR))))
    (let ((c (dk-cite! 'ball-membership s a r b)))
      (dk-have! (list 'IN b (list 'BALL s a r))
        (lambda () (mfs-prop! c (list 'IN b (list 'PTS s)) (list '<= dab r) (list 'NOT (list '= dab r))))))))

;;; Sequences by countable choice (copied from riesz-markov-model.scm's
;;; rmm-choose-seq! / rmm-seq-at!, which cite rmm-nn-choice).  PF = (lambda (k w)
;;; <formula>); WITNESS-OF, run where k in NN is in context, lands (IN w A) and
;;; (PF k w) and returns w.  Returns the chosen sequence g.  (mfs-seq-at! g k)
;;; lands (IN (g k) A) and PF(k, g(k)), split.
(define mfs-seq-family '())
(define (mfs-choose-seq! A Pf witness-of)
  (let* ((L   (list 'VNB-LAMBDA 'cfk_ 'NN (list 'SEP 'cfw_ A (Pf 'cfk_ 'cfw_))))
         (inh (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
                (list 'FORSOME 'w (list 'AND (list 'IN 'w A) (list 'IN 'w (list L 'k))))))))
    (dk-have! inh
      (lambda ()
        (let* ((k (dk-di-var!)))
          (dk-lam-b!)
          (let ((w (witness-of k)))
            (ew w)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (caddr (dk-goal)) 'SEP)
                    (dk-close-all! (lambda () (sep-mi)))
                    (ass))))))))
    (let ((g (dk-skolem! (dk-cite! 'rmm-nn-choice A L))))
      (set! mfs-seq-family (cons (cons g L) mfs-seq-family))
      g)))
(define (mfs-seq-at! g k)
  (let* ((L  (cdr (assq g mfs-seq-family)))
         (cl (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IN (list g 'k) (list L 'k))))))
         (h  (dk-apply! (or cl (error "mfs-seq-at!: the choice clause is not in context" g)) k)))
    (dk-lam-b-h! h)
    (let ((m (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list g k))
                                       (dk-head-is? (caddr f) 'SEP)))
                      "the chosen membership")))
      (dk-split-all! (dk-landed (lambda () (sep-me m)))))))

;;; THE FINITE SUBCOVER: a closed set a of a compact space, covered by the open
;;; sets csq(n), n in NN, is covered by the csq(n) with n below some bound.
;;; By contradiction: points g(k) of a outside csq(0), ..., csq(k-1); a convergent
;;; subsequence; its limit lies in a, hence in some open csq(n0); the subsequence
;;; enters csq(n0) at indices phi(k) > n0, where it was chosen outside it.
(sp (make-wff '(FORALL m (FORALL a (FORALL csq (IMPLIES (IS-COMPACT m) (IMPLIES (IS-CLOSED m a)
  (IMPLIES (FORALL n (IMPLIES (IN n NN) (IS-OPEN m (csq n))))
  (IMPLIES (FORALL x (IMPLIES (IN x a) (FORSOME n (AND (IN n NN) (IN x (csq n))))))
    (FORSOME nf_ (AND (IN nf_ NN) (FORALL x (IMPLIES (IN x a)
      (FORSOME n (AND (IN n NN) (AND (< n nf_) (IN x (csq n))))))))))))))))))
(dk-peel!)
(define mfs-kc (dk-cite! 'is-compact 'm))
(dk-have! '(IS-METRIC-SPACE m) (lambda () (mfs-prop! mfs-kc '(IS-COMPACT m))))
(define mfs-clc (dk-cite! 'is-closed 'm 'a))
(dk-have! '(SUBSET a (PTS m)) (lambda () (mfs-prop! mfs-clc '(IS-CLOSED m a))))
(define mfs-ophyp (dk-ctx-form '(FORALL n (IMPLIES (IN n NN) (IS-OPEN m (csq n))))))
(define mfs-cvhyp (dk-ctx-form '(FORALL x (IMPLIES (IN x a) (FORSOME n (AND (IN n NN) (IN x (csq n))))))))
(define mfs-notex (dk-landed-1 (lambda () (pbc))))
(define mfs-nall (dk-landed-1 (lambda () (push-not-h mfs-notex))))
(define (mfs-bad k w)
  (list 'AND (list 'IN w 'a)
    (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES (list '< 'n k) (list 'NOT (list 'IN w '(csq n))))))))
(define mfs-g
  (mfs-choose-seq! '(PTS m) mfs-bad
    (lambda (k)
      (let* ((nf (dk-apply! mfs-nall k))
             (ex (dk-landed-1 (lambda () (push-not-h nf))))
             (y  (dk-skolem! ex))
             (negf (dk-pick (lambda (f) (and (dk-head-is? f 'NOT) (dk-head-is? (cadr f) 'FORSOME) (dk--occurs? y f)))
                            "the failed cover at k")))
        (dk-cite! 'subset-mem-fwd 'a '(PTS m) y)
        (dk-have! (mfs-bad k y)
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'FORALL)
                    (let ((n (dk-di-var!)))
                      (di)
                      (di)
                      (dk-have! (cadr negf) (lambda () (ew n) (dk-conj-close! (lambda () (ass)))))
                      (ai negf))
                    (ass))))))
        y))))
(dk-cite! 'compact-implies-seq-compact 'm)
(dk-split-all! (dk-landed (lambda () (mac-h 'seq-compact '(SEQ-COMPACT m)))))
(define mfs-phi (dk-skolem! (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'f))) "seq-compact clause") mfs-g)))
(define mfs-l (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'l))) "the limit")))
(define mfs-sq (list 'SUBSEQ mfs-g mfs-phi))
(define mfs-smi (dk-cite! 'strictly-mono-nn mfs-phi))
(dk-have! (list 'IN mfs-phi '(FUN NN NN)) (lambda () (mfs-prop! mfs-smi (list 'STRICTLY-MONO-NN mfs-phi))))
(dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IN (list mfs-sq 'n) 'a)))
  (lambda ()
    (let* ((n (dk-di-var!)) (pn (list mfs-phi n)))
      (dk-cite! 'subseq-apply mfs-g mfs-phi n)
      (subst (list '== (list mfs-sq n) (list mfs-g pn)))
      (dk-cite! 'fun-apply-type-c mfs-phi 'NN 'NN n)
      (mfs-seq-at! mfs-g pn)
      (ass))))
(dk-cite! 'closed-set-limit-in 'm 'a mfs-sq mfs-l)
(define mfs-n0 (dk-skolem! (dk-apply! mfs-cvhyp mfs-l)))
(dk-apply! mfs-ophyp mfs-n0)
(define mfs-oc (dk-cite! 'is-open 'm (list 'csq mfs-n0)))
(define mfs-ocl (caddr (caddr (caddr mfs-oc))))
(dk-have! mfs-ocl (lambda () (mfs-prop! mfs-oc (list 'IS-OPEN 'm (list 'csq mfs-n0)))))
(define mfs-r (dk-skolem! (dk-apply! mfs-ocl mfs-l)))
(define mfs-hd (dk-halve! mfs-r))
(define mfs-cv (dk-cite! 'converges-to 'm mfs-sq mfs-l))
(define mfs-ec (caddr (caddr (caddr (caddr mfs-cv)))))
(dk-have! mfs-ec (lambda () (mfs-prop! mfs-cv (list 'CONVERGES-TO 'm mfs-sq mfs-l))))
(define mfs-n1 (dk-skolem! (dk-apply! mfs-ec mfs-hd)))
(define mfs-tail (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'n_) (dk--occurs? mfs-n1 f))) "the tail bound"))
(dk-cite! 'nn-succ-closed mfs-n0)
(define mfs-k (list '+ mfs-n1 (list 'succ mfs-n0)))
(dk-have! (list 'AND (list 'IN mfs-n1 'NN) (list 'IN (list 'succ mfs-n0) 'NN)) (lambda () (dk-conj-close! (lambda () (ass)))))
(dk-cite! 'nn-add-closed mfs-n1 (list 'succ mfs-n0))
(dk-have! (list '<= mfs-n1 mfs-k) (lambda () (dk-nn!)))
(define mfs-pk (list mfs-phi mfs-k))
(dk-cite! 'fun-apply-type-c mfs-phi 'NN 'NN mfs-k)
(dk-cite! 'strictly-mono-ge-id mfs-phi mfs-k)
(dk-have! (list '< mfs-n0 mfs-pk) (lambda () (dk-nn! (list '<= mfs-k mfs-pk))))
(define mfs-t1 (dk-apply! mfs-tail mfs-k))
(dk-cite! 'subseq-apply mfs-g mfs-phi mfs-k)
(define mfs-gk (list mfs-g mfs-pk))
(define mfs-t2 (dk-rewrite-h! mfs-t1 (list mfs-sq mfs-k) mfs-gk))
(dk-cite! 'fun-apply-type-c mfs-g 'NN '(PTS m) mfs-pk)
(dk-cite! 'metric-sym 'm mfs-gk mfs-l)
(define mfs-t3 (dk-rewrite-h! mfs-t2 (mfs-d 'm mfs-gk mfs-l) (mfs-d 'm mfs-l mfs-gk)))
(mfs-in-ball! 'm mfs-l mfs-r mfs-gk mfs-hd)
(dk-cite! 'subset-mem-fwd (list 'BALL 'm mfs-l mfs-r) (list 'csq mfs-n0) mfs-gk)
(mfs-seq-at! mfs-g mfs-pk)
(define mfs-badcl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'n) (dk--occurs? mfs-gk f))) "bad clause"))
(dk-apply! mfs-badcl mfs-n0)
(mfs-prop! (list 'IN mfs-gk (list 'csq mfs-n0)) (list 'NOT (list 'IN mfs-gk (list 'csq mfs-n0))))
(qed 'compact-closed-countable-subcover)
