;;; calc2-rn-nvs.scm -- RN(n) is a real normed vector space.  CALC-2, 2026-10-19.  Prefix c2v-.

(define c2v-V '(FUN (INTERVAL 1 n) RR))
(define (c2v-open) (dk-open-leaves))
(define (c2v-dump tag)
  (display ";; C2V ") (display tag) (display " goal: ") (display (dk-goal)) (newline)
  (for-each (lambda (l) (display ";; C2V   open: ") (display (dk-goal-of l)) (newline)) (c2v-open)))

;;; ---- the coordinate evaluator ------------------------------------------
(define (c2v-find pred e)
  (cond ((pred e) e)
        ((pair? e) (let loop ((l e)) (cond ((null? l) #f) ((c2v-find pred (car l))) (#t (loop (cdr l))))))
        (#t #f)))
(define (c2v-op? f h) (and (pair? f) (pair? (car f)) (eq? (caar f) h) (equal? (cdar f) '((RN n)))))
(define c2v-zero '(VZERO (RN n)))
(define (c2v-vterm? t)
  (or (equal? t c2v-zero) (c2v-op? t 'VADD) (c2v-op? t 'ACT) (c2v-op? t 'VNEG)
      (and (pair? t) (memq (car t) '(RN-TRUNC RN-UNIT)) (eq? (cadr t) 'n))))
(define (c2v-type! t)
  (cond ((dk-asm? (list 'IN t c2v-V)) (dk-ctx-form (list 'IN t c2v-V)))
        ((equal? t c2v-zero) (dk-cite! 'rn-vzero-in-vec 'n))
        ((c2v-op? t 'VADD) (c2v-type! (cadr t)) (c2v-type! (caddr t))
         (dk-cite! 'rn-vadd-in-vec 'n (cadr t) (caddr t)))
        ((c2v-op? t 'ACT) (if (not (dk-asm? (list 'IN (cadr t) 'RR))) (dk-type! (cadr t)))
         (c2v-type! (caddr t)) (dk-cite! 'rn-act-in-vec 'n (cadr t) (caddr t)))
        ((c2v-op? t 'VNEG) (c2v-type! (cadr t)) (dk-cite! 'rn-vneg-in-vec 'n (cadr t)))
        ((dk-head-is? t 'RN-TRUNC) (c2v-type! (caddr t)) (dk-cite! 'rn-trunc-in-vec 'n (caddr t) (cadddr t)))
        ((dk-head-is? t 'RN-UNIT) (dk-cite! 'rn-unit-in-vec 'n (caddr t)))
        (#t (error "c2v-type!: no typing for" t))))
;;; rewrite every coordinate (OP ...)(v) of the goal by the read-off lemmas
(define (c2v-eval! v)
  (let loop ((k 0))
    (let ((r (c2v-find (lambda (e) (and (pair? e) (= (length e) 2) (equal? (cadr e) v)
                                          (c2v-vterm? (car e))))
                       (dk-goal))))
      (if (and r (< k 40))
          (let* ((f (car r))
                 (eqn (cond ((equal? f c2v-zero) (dk-cite! 'rn-vzero-apply 'n v))
                            ((c2v-op? f 'VADD) (c2v-type! (cadr f)) (c2v-type! (caddr f))
                             (dk-cite! 'rn-vadd-apply 'n (cadr f) (caddr f) v))
                            ((c2v-op? f 'ACT) (if (not (dk-asm? (list 'IN (cadr f) 'RR))) (dk-type! (cadr f)))
                             (c2v-type! (caddr f))
                             (dk-cite! 'rn-act-apply 'n (cadr f) (caddr f) v))
                            ((dk-head-is? f 'RN-TRUNC)
                             (let ((x (caddr f)) (k (cadddr f)))
                               (c2v-type! x)
                               (cond ((dk-asm? (list '<= v k)) (dk-cite! 'rn-trunc-apply-le 'n x k v))
                                     ((dk-asm? (list 'NOT (list '<= v k))) (dk-cite! 'rn-trunc-apply-gt 'n x k v))
                                     (#t (error "c2v-eval!: no case for" (list '<= v k))))))
                            ((dk-head-is? f 'RN-UNIT)
                             (let ((i (caddr f)))
                               (cond ((equal? v i) (dk-cite! 'rn-unit-at-same 'n i))
                                     ((dk-asm? (list 'NOT (list '= v i))) (dk-cite! 'rn-unit-at-other 'n i v))
                                     ((dk-asm? (list '= v i))
                                      (dk-have! (list '= (list f v) 1)
                                        (lambda () (subst (list '= v i)) (dk-cite! 'rn-unit-at-same 'n i) (ass))))
                                     (#t (error "c2v-eval!: no case for" (list '= v i))))))
                            (#t (c2v-type! (cadr f)) (dk-cite! 'rn-vneg-apply 'n (cadr f) v)))))
            (subst eqn)
            (loop (+ k 1)))))))
;;; (IN (f x) RR) from f in V, x in INTERVAL(1, n), by fun-apply-type (dk-type! raised
;;; `car of ()' on (u dkxa_) in the rn-vzero-left context: kit finding in the report)
(define (c2v-app-type! f x)
  (dk-have! (list 'AND (list 'IN f c2v-V) (list 'IN x '(INTERVAL 1 n)))
    (lambda () (dk-conj-close! (lambda () (ass)))))
  (dk-cite! 'fun-apply-type f '(INTERVAL 1 n) 'RR x))
;;; type the coordinate atoms (u v) of the goal
(define (c2v-type-atoms! v)
  (let walk ((e (dk-goal)))
    (cond ((and (pair? e) (= (length e) 2) (symbol? (car e)) (equal? (cadr e) v)
                (dk-asm? (list 'IN (car e) c2v-V)))
           (if (not (dk-asm? (list 'IN e 'RR))) (c2v-app-type! (car e) v)))
          ((pair? e) (for-each walk e)))))
(define (c2v-ptwise! v)
  (c2v-eval! v)
  (c2v-type-atoms! v)
  (let ((g (dk-goal)))
    (cond ((equal? (cadr g) (caddr g)) (rfl))
          ((dk-close-if! (lambda () (vnb-guard (lambda () (crs)))) (lambda () #t)) #t)
          (#t (dk-ineq!)))))
;;; an equation between vector terms, by extensionality
(define (c2v-ext!)
  (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
    (c2v-type! l) (c2v-type! r)
    (dk-fun-ext! l r '(INTERVAL 1 n) 'RR #f #f c2v-ptwise!)))
(define (c2v-law! stmt name)
  (sp (make-wff stmt))
  (dk-peel!)
  (c2v-ext!)
  (qed name))
(define (c2v-st vars guards body) (forall-guarded (cons 'n vars) (cons '(IN n NN) guards) body))
(define (c2v-inV v) (list 'IN v c2v-V))

;;; ---- the vector-space laws, each by extensionality -------------------------
(c2v-law! (c2v-st '(u w z) (map c2v-inV '(u w z))
   '(= ((VADD (RN n)) ((VADD (RN n)) u w) z) ((VADD (RN n)) u ((VADD (RN n)) w z)))) 'rn-vadd-assoc)
(c2v-law! (c2v-st '(u w) (map c2v-inV '(u w))
   '(= ((VADD (RN n)) u w) ((VADD (RN n)) w u))) 'rn-vadd-comm)
(c2v-law! (c2v-st '(u) (map c2v-inV '(u))
   '(= ((VADD (RN n)) (VZERO (RN n)) u) u)) 'rn-vzero-left)
(c2v-law! (c2v-st '(u) (map c2v-inV '(u))
   '(= ((VADD (RN n)) u (VZERO (RN n))) u)) 'rn-vzero-right)
(c2v-law! (c2v-st '(u) (map c2v-inV '(u))
   '(= ((VADD (RN n)) ((VNEG (RN n)) u) u) (VZERO (RN n)))) 'rn-vneg-left)
(c2v-law! (c2v-st '(u) (map c2v-inV '(u))
   '(= ((VADD (RN n)) u ((VNEG (RN n)) u)) (VZERO (RN n)))) 'rn-vneg-right)
(c2v-law! (c2v-st '(r u w) (list '(IN r RR) (c2v-inV 'u) (c2v-inV 'w))
   '(= ((ACT (RN n)) r ((VADD (RN n)) u w)) ((VADD (RN n)) ((ACT (RN n)) r u) ((ACT (RN n)) r w)))) 'rn-act-vadd)
(c2v-law! (c2v-st '(r s u) (list '(IN r RR) '(IN s RR) (c2v-inV 'u))
   '(= ((ACT (RN n)) (+ r s) u) ((VADD (RN n)) ((ACT (RN n)) r u) ((ACT (RN n)) s u)))) 'rn-act-add)
(c2v-law! (c2v-st '(r s u) (list '(IN r RR) '(IN s RR) (c2v-inV 'u))
   '(= ((ACT (RN n)) (* r s) u) ((ACT (RN n)) r ((ACT (RN n)) s u)))) 'rn-act-mul)
(c2v-law! (c2v-st '(u) (map c2v-inV '(u))
   '(= ((ACT (RN n)) 1 u) u)) 'rn-act-one)

;;; ---- real typing by closure laws (no planner) ---------------------------------
(define (c2v-real! t)
  (let ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) (dk-ctx-form typ))
          ((number? t) (cond ((eqv? t 0) (dk-cite! 'rr-zero-in)) ((eqv? t 1) (dk-cite! 'rr-one-in))
                             (#t (dk-type! t))))
          ((and (pair? t) (= (length t) 2) (symbol? (car t)) (dk-asm? (list 'IN (car t) c2v-V)))
           (c2v-app-type! (car t) (cadr t)))
          ((and (pair? t) (eq? (car t) 'abs)) (c2v-real! (cadr t)) (dk-cite! 'rr-abs-closed (cadr t)))
          ((and (pair? t) (eq? (car t) '-) (= (length t) 2)) (c2v-real! (cadr t)) (dk-cite! 'rr-neg-closed (cadr t)))
          ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
           (c2v-real! (cadr t)) (c2v-real! (caddr t))
           (dk-have! (list 'AND (list 'IN (cadr t) 'RR) (list 'IN (caddr t) 'RR))
             (lambda () (dk-conj-close! (lambda () (ass)))))
           (dk-cite! (if (eq? (car t) '+) 'rr-add-closed 'rr-mul-closed) (cadr t) (caddr t)))
          (#t (dk-type! t)))))
(define (c2v-and! a b)
  (dk-have! (list 'AND a b) (lambda () (dk-conj-close! (lambda () (ass))))))

;;; ---- max scales by a nonnegative factor --------------------------------------
(sp (make-wff (forall-guarded '(a b c) '((IN a RR) (IN b RR) (IN c RR) (<= 0 c))
   '(= (max (* c a) (* c b)) (* c (max a b))))))
(dk-peel!)
(c2v-real! '(* c a))
(c2v-real! '(* c b))
(dk-have! '(= (* c a) (* a c)) (lambda () (crs)))
(dk-have! '(= (* c b) (* b c)) (lambda () (crs)))
(for-each
  (lambda (l)
    (dk-focus! l)
    (if (dk-asm? '(<= b a))
        (begin
          (dk-cite! 'rr-mul-le-right 'b 'a 'c)
          (dk-have! '(<= (* c b) (* c a))
            (lambda () (subst '(= (* c b) (* b c))) (subst '(= (* c a) (* a c))) (ass)))
          (subst (dk-cite! 'rr-max-left-le '(* c a) '(* c b)))
          (subst (dk-cite! 'rr-max-left-le 'a 'b))
          (rfl))
        (begin
          (dk-cite! 'rr-mul-le-right 'a 'b 'c)
          (dk-have! '(<= (* c a) (* c b))
            (lambda () (subst '(= (* c b) (* b c))) (subst '(= (* c a) (* a c))) (ass)))
          (subst (dk-cite! 'rr-max-right-le '(* c a) '(* c b)))
          (subst (dk-cite! 'rr-max-right-le 'a 'b))
          (rfl))))
  (dk-opened (lambda () (ai (dk-cite! 'rr-le-total 'b 'a)))))
(qed 'rr-max-nonneg-scale)

;;; ---- the norm is homogeneous: RN-MAXABS(r.x, k) = |r| RN-MAXABS(x, k) ---------
(define c2v-RX '((ACT (RN n)) r xv))
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
   (forall-guarded '(n xv r) (list '(IN n NN) (c2v-inV 'xv) '(IN r RR) '(<= k n))
     (list '= (list 'RN-MAXABS c2v-RX 'k) '(* (abs r) (RN-MAXABS xv k))))))))
(ni)
(define (c2v-step? l) (dk-contains? (dk-goal-of l) 'succ))
(dk-focus! (find-first (lambda (l) (not (c2v-step? l))) (c2v-open)))
(dk-peel!)
(c2v-type! c2v-RX)
(c2v-real! '(abs r))
(subst (dk-cite! 'rn-maxabs-zero c2v-RX))
(subst (dk-cite! 'rn-maxabs-zero 'xv))
(crs)
(dk-focus! (find-first c2v-step? (c2v-open)))
(dk-di-var!)
(dk-peel!)
(define c2v-ih (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'RN-MAXABS))) "the IH"))
(dk-have! '(<= k n) (lambda () (dk-nn! '(<= (succ k) n))))
(dk-cite! 'nn-succ-closed 'k)
(dk-have! '(<= 1 (succ k)) (lambda () (dk-nn!)))
(dk-cite! 'interval-mem-intro 1 'n '(succ k))
(c2v-type! c2v-RX)
(c2v-real! '(abs r))
(dk-cite! 'rr-abs-nonneg 'r)
(c2v-real! '(abs (xv (succ k))))
(dk-split! (dk-cite! 'rn-maxabs-typing 'k 'n 'xv))
(define c2v-ihi (dk-apply! c2v-ih 'n 'xv 'r))
(subst (dk-cite! 'rn-maxabs-succ c2v-RX 'k))
(subst (dk-cite! 'rn-maxabs-succ 'xv 'k))
(subst (dk-cite! 'rn-act-apply 'n 'r 'xv '(succ k)))
(c2v-and! '(IN r RR) '(IN (xv (succ k)) RR))
(subst (dk-cite! 'rr-abs-mult 'r '(xv (succ k))))
(subst c2v-ihi)
(dk-cite! 'rr-max-nonneg-scale '(RN-MAXABS xv k) '(abs (xv (succ k))) '(abs r))
(ass)
(qed 'rn-maxabs-scale)

(sp (make-wff (c2v-st '(r u) (list '(IN r RR) (c2v-inV 'u))
   '(= ((VNRM (RN n)) ((ACT (RN n)) r u)) (* (abs r) ((VNRM (RN n)) u))))))
(dk-peel!)
(c2v-type! '((ACT (RN n)) r u))
(subst (dk-cite! 'rn-vnrm-apply 'n '((ACT (RN n)) r u)))
(subst (dk-cite! 'rn-vnrm-apply 'n 'u))
(fact 'nn-le-refl 'n)
(dk-cite! 'rn-maxabs-scale 'n 'n 'u 'r)
(ass)
(qed 'rn-norm-homogeneous)

;;; ---- the triangle inequality -------------------------------------------------
(sp (make-wff (c2v-st '(u w) (list (c2v-inV 'u) (c2v-inV 'w))
   '(<= ((VNRM (RN n)) ((VADD (RN n)) u w)) (+ ((VNRM (RN n)) u) ((VNRM (RN n)) w))))))
(dk-peel!)
(c2v-type! '((VADD (RN n)) u w))
(dk-split! (dk-cite! 'rn-norm-typing 'n 'u))
(dk-split! (dk-cite! 'rn-norm-typing 'n 'w))
(define c2v-c '(+ ((VNRM (RN n)) u) ((VNRM (RN n)) w)))
(c2v-real! c2v-c)
(dk-have! (list '<= 0 c2v-c) (lambda () (dk-ineq! '(<= 0 ((VNRM (RN n)) u)) '(<= 0 ((VNRM (RN n)) w)))))
(dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 n)) (list '<= '(abs (((VADD (RN n)) u w) j)) c2v-c)))
  (lambda ()
    (let ((j (dk-di-var!)))
      (c2v-eval! j)
      (c2v-real! (list 'u j)) (c2v-real! (list 'w j))
      (c2v-real! (list 'abs (list 'u j))) (c2v-real! (list 'abs (list 'w j)))
      (c2v-real! (list 'abs (list '+ (list 'u j) (list 'w j))))
      (c2v-and! (list 'IN (list 'u j) 'RR) (list 'IN (list 'w j) 'RR))
      (dk-cite! 'rr-abs-triangle (list 'u j) (list 'w j))
      (dk-cite! 'rn-norm-ge-coord 'n 'u j)
      (dk-cite! 'rn-norm-ge-coord 'n 'w j)
      (dk-ineq! (list '<= (list 'abs (list '+ (list 'u j) (list 'w j))) (list '+ (list 'abs (list 'u j)) (list 'abs (list 'w j))))
                (list '<= (list 'abs (list 'u j)) '((VNRM (RN n)) u))
                (list '<= (list 'abs (list 'w j)) '((VNRM (RN n)) w))))))
(dk-cite! 'rn-norm-le 'n '((VADD (RN n)) u w) c2v-c)
(ass)
(qed 'rn-norm-triangle)

;;; (= a b) from a <= b and b <= a in context (ineq does not prove an equation)
(define (c2v-antisym! a b)
  (c2v-real! a) (c2v-real! b)
  (c2v-and! (list 'IN a 'RR) (list 'IN b 'RR))
  (c2v-and! (list '<= a b) (list '<= b a))
  (dk-cite! 'rr-leq-antisymmetric a b))
;;; ---- definiteness --------------------------------------------------------------
(sp (make-wff (c2v-st '(u) (list (c2v-inV 'u))
   '(IFF (= ((VNRM (RN n)) u) 0) (= u (VZERO (RN n)))))))
(dk-peel!)
(dk-split! (dk-cite! 'rn-norm-typing 'n 'u))
(c2v-type! '(VZERO (RN n)))
(dk-iff! (lambda (g) (equal? g '(= u (VZERO (RN n)))))
  (lambda ()
    (dk-fun-ext! 'u '(VZERO (RN n)) '(INTERVAL 1 n) 'RR #f #f
      (lambda (v)
        (c2v-eval! v)
        (c2v-real! (list 'u v))
        (c2v-real! (list 'abs (list 'u v)))
        (dk-cite! 'rn-norm-ge-coord 'n 'u v)
        (let ((au (list 'abs (list 'u v))))
          (dk-have! (list '<= au 0)
            (lambda () (dk-ineq! (list '<= au '((VNRM (RN n)) u)) '(= ((VNRM (RN n)) u) 0))))
          (dk-cite! 'rr-abs-nonneg (list 'u v))
          (c2v-antisym! au 0)
          (dk-meta-iff-r! (dk-cite! 'rr-abs-zero (list 'u v)))
          (ass)))))
  (lambda ()
    (subst '(= u (VZERO (RN n))))
    (dk-split! (dk-cite! 'rn-norm-typing 'n '(VZERO (RN n))))
    (c2v-real! 0)
    (dk-have! '(<= 0 0) (lambda () (dk-cite! 'rr-leq-reflexive 0) (ass)))
    (dk-have! '(FORALL j (IMPLIES (IN j (INTERVAL 1 n)) (<= (abs ((VZERO (RN n)) j)) 0)))
      (lambda ()
        (let ((j (dk-di-var!)))
          (c2v-eval! j)
          (dk-have! '(= 0 0) (lambda () (rfl)))
          (dk-meta-iff-l! (dk-cite! 'rr-abs-zero 0))
          (subst '(= (abs 0) 0))
          (ass))))
    (dk-cite! 'rn-norm-le 'n '(VZERO (RN n)) 0)
    (c2v-antisym! '((VNRM (RN n)) (VZERO (RN n))) 0)
    (ass)))
(qed 'rn-norm-definite)

(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (IS-NORMED-VECTOR-SPACE (RN n))))))
(dk-peel!)
(fact 'rr-is-normed-field)
(fact 'normed-field-as-commutative-ring-is-commutative-ring 'RR-NORMED-FIELD)
(fact 'rr-is-set)
(fact 'interval-in-set 1 'n)
(dk-have! '(IN (FUN (INTERVAL 1 n) RR) SET)
  (lambda () (mac 'fun-set-iff) (dk-conj-close! (lambda () (ass)))))
(fact 'rn-vec 'n)
(fact 'rn-scal 'n)
(mac 'IS-NORMED-VECTOR-SPACE)
(subst (list '= '(VEC (RN n)) c2v-V))
(subst '(= (SCAL (RN n)) (NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD)))
(for-each (lambda (m) (vnb-guard (lambda () (mac m))))
          '(rr-scalar-ring-carr rr-scalar-ring-add rr-scalar-ring-mul rr-scalar-ring-one))
(let loop ((k 0))
  (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (c2v-open))))
    (if (and l (< k 60)) (begin (dk-focus! l) (di) (loop (+ k 1))))))
;;; the typing of a slot: read it, then lam-t (outer, and inner for the vector-valued ones)
(define (c2v-real-close!)
  (let* ((g (dk-goal)) (t (cadr g)))
    (c2v-real! t)
    (if (and (not (sequent-node-grounded? (proof-state-focus *ps*))) (equal? (dk-goal) g)) (ass))))
(define (c2v-inner-lam!)
  (dk-lam-type! (lambda () (dk-di-var!) (c2v-real-close!)) (lambda () (ass))))
(define (c2v-set-close!)
  (let ((g (dk-goal)))
    (if (dk-head-is? (cadr g) 'CARTESIAN)
        (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))
        (ass))))
(define (c2v-slot-type! acc)
  (mac 'RN) (slot acc) (nth-r)
  (dk-lam-type!
    (lambda ()
      (dk-peel!)
      (let* ((g (dk-goal)) (body (cadr g)))
        (cond ((dk-head-is? body 'VNB-LAMBDA) (c2v-inner-lam!))
              ((dk-head-is? body 'RN-MAXABS)
               (fact 'nn-le-refl 'n)
               (dk-split! (dk-cite! 'rn-maxabs-typing 'n 'n (cadr body)))
               (ass))
              (#t (c2v-real-close!)))))
    c2v-set-close!))

(define (c2v-vecish? t) (or (c2v-vterm? t) (and (symbol? t) (dk-asm? (list 'IN t c2v-V)))))
(define (c2v-has-redex? e)
  (cond ((and (pair? e) (pair? (car e)) (eq? (caar e) 'VNB-LAMBDA)) #t)
        ((pair? e) (or (c2v-has-redex? (car e)) (c2v-has-redex? (cdr e))))
        (#t #f)))
(define (c2v-close-leaf!)
  (let ((g (dk-goal)))
    (cond
      ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH)) (mac 'RN) (len-r) (arith))
      ((dk-head-is? g 'IS-RING) (dk-cite! 'commutative-ring-is-ring (cadr g)) (ass))
      ((and (dk-head-is? g 'IN) (dk-asm? g)) (ass))
      ((and (dk-head-is? g 'IN) (equal? (cadr g) c2v-zero)) (dk-cite! 'rn-vzero-in-vec 'n) (ass))
      ((and (dk-head-is? g 'IN) (pair? (cadr g)) (memq (car (cadr g)) '(VADD VNEG ACT VNRM)))
       (c2v-slot-type! (car (cadr g))))
      ((memq (dk-head g) '(is-associative is-commutative is-identity has-inverses))
       (mac (dk-head g)) (c2v-close-leaf!))
      ((dk-head-is? g 'FORALL)
       (dk-peel!)
       (if (c2v-has-redex? (dk-goal)) (dk-lam-b!))
       (c2v-close-leaf!))
      ((dk-head-is? g 'AND)
       (for-each (lambda (l) (dk-focus! l) (c2v-close-leaf!)) (dk-opened (lambda () (di)))))
      ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))
      ((and (dk-head-is? g '=) (c2v-vecish? (cadr g))) (c2v-ext!))
      ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'VNRM-placeholder)) #f)
      ((and (dk-head-is? g '=) (pair? (cadr g)) (equal? (car (cadr g)) '(VNRM (RN n))))
       (let ((arg (cadr (cadr g))))       ; ((ACT (RN n)) r x)
         (dk-cite! 'rn-norm-homogeneous 'n (cadr arg) (caddr arg)) (ass)))
      ((dk-head-is? g 'IFF)
       (dk-cite! 'rn-norm-definite 'n (cadr (cadr (cadr g)))) (ass))
      ((and (dk-head-is? g '<=) (eqv? (cadr g) 0))
       (dk-split! (dk-cite! 'rn-norm-typing 'n (cadr (caddr g)))) (ass))
      ((dk-head-is? g '<=)
       (let ((arg (cadr (cadr g))))       ; ((VADD (RN n)) x y)
         (dk-cite! 'rn-norm-triangle 'n (cadr arg) (caddr arg)) (ass)))
      (#t (error "c2v-close-leaf!: unexpected leaf" g)))))

(for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (c2v-close-leaf!)))) (c2v-open))
;;; the owed definedness leaves of the slot macetes: (= (OP (RN n)) (OP (RN n)))
(for-each (lambda (l)
            (if (not (sequent-node-grounded? l))
                (let ((g (dk-goal-of l)))
                  (dk-focus! l)
                  (if (and (dk-head-is? g '=) (equal? (cadr g) (caddr g)) (pair? (cadr g)))
                      (begin (mac 'RN) (slot (car (cadr g))) (nth-r) (rfl))
                      (c2v-close-leaf!)))))
          (c2v-open))
(qed 'rn-is-normed-vector-space)

;;; ---- the truncations RN-TRUNC(n, x, k) -----------------------------------------------
(sp (make-wff (c2v-st '(x k) (list (c2v-inV 'x) '(IN k NN))
   (list 'IN '(RN-TRUNC n x k) c2v-V))))
(dk-peel!)
(fact 'interval-in-set 1 'n)
(mac 'RN-TRUNC)
(dk-lam-type!
  (lambda ()
    (dk-di-var!)
    (dk-case-if! (cadr (dk-goal)) (lambda (t? v) (c2v-real-close!))))
  (lambda () (ass)))
(qed 'rn-trunc-in-vec)

(sp (make-wff (c2v-st '(x k j) (list (c2v-inV 'x) '(IN k NN) '(IN j (INTERVAL 1 n)) '(<= j k))
   '(= ((RN-TRUNC n x k) j) (x j)))))
(dk-peel!)
(mac 'RN-TRUNC)
(dk-lam-b!)
(dk-if-branch! #t '(IF (<= j k) (x j) 0) #f (lambda () (c2v-app-type! 'x 'j) (rfl)))
(qed 'rn-trunc-apply-le)

(sp (make-wff (c2v-st '(x k j) (list (c2v-inV 'x) '(IN k NN) '(IN j (INTERVAL 1 n)) '(NOT (<= j k)))
   '(= ((RN-TRUNC n x k) j) 0))))
(dk-peel!)
(mac 'RN-TRUNC)
(dk-lam-b!)
(dk-if-branch! #f '(IF (<= j k) (x j) 0) #f (lambda () (rfl)))
(qed 'rn-trunc-apply-gt)

;;; a coordinate index v: v in NN
(define (c2v-idx! v) (dk-cite! 'interval-elt-in-nn 1 'n v) (dk-cite! 'interval-lo 1 'n v) (dk-cite! 'interval-hi 1 'n v))

(sp (make-wff (c2v-st '(x) (list (c2v-inV 'x)) '(= (RN-TRUNC n x 0) (VZERO (RN n))))))
(dk-peel!)
(fact 'nn-zero-in)
(c2v-type! '(RN-TRUNC n x 0)) (c2v-type! c2v-zero)
(dk-fun-ext! '(RN-TRUNC n x 0) c2v-zero '(INTERVAL 1 n) 'RR #f #f
  (lambda (v)
    (c2v-idx! v)
    (dk-have! (list 'NOT (list '<= v 0)) (lambda () (dk-nn! (list '<= 1 v))))
    (c2v-ptwise! v)))
(qed 'rn-trunc-zero)

(sp (make-wff (c2v-st '(x) (list (c2v-inV 'x)) '(= (RN-TRUNC n x n) x))))
(dk-peel!)
(c2v-type! '(RN-TRUNC n x n))
(dk-fun-ext! '(RN-TRUNC n x n) 'x '(INTERVAL 1 n) 'RR #f #f
  (lambda (v) (c2v-idx! v) (c2v-ptwise! v)))
(qed 'rn-trunc-full)

;;; the three cases of a coordinate v against succ(k): v <= k, v = succ k, v > succ k.
;;; CASE is called with 'le, 'eq or 'gt after the case facts are landed.
(define (c2v-three-cases! v k case)
  (let ((sk (list 'succ k)))
    (use-em (list '<= v k)
      (lambda ()
        (dk-have! (list '<= v sk) (lambda () (dk-nn! (list '<= v k))))
        (dk-have! (list 'NOT (list '= v sk)) (lambda () (dk-nn! (list '<= v k))))
        (case 'le))
      (lambda ()
        (use-em (list '= v sk)
          (lambda ()
            (dk-have! (list '<= v sk) (lambda () (subst (list '= v sk)) (dk-cite! 'nn-le-refl sk) (ass)))
            (case 'eq))
          (lambda ()
            (dk-have! (list 'NOT (list '<= v sk))
              (lambda ()
                (di)
                (let ((o (dk-cite! 'nn-le-succ-cases k v)))
                  (for-each (lambda (l) (dk-focus! l)
                              (if (dk-asm? (list '<= v k)) (ai (list 'NOT (list '<= v k))) (ai (list 'NOT (list '= v sk)))))
                            (dk-opened (lambda () (ai o)))))))
            (case 'gt)))))))

(define (c2v-sk-eq-facts!)
  (dk-cite! 'nn-le-refl '(succ k))
  (dk-cite! 'nn-succ-not-le 'k))
(define c2v-W '((VADD (RN n)) (RN-TRUNC n x k) ((ACT (RN n)) (x (succ k)) (RN-UNIT n (succ k)))))
(define (c2v-sk-in!)
  (dk-cite! 'nn-succ-closed 'k)
  (dk-have! '(<= 1 (succ k)) (lambda () (dk-nn!)))
  (dk-cite! 'interval-mem-intro 1 'n '(succ k))
  (c2v-app-type! 'x '(succ k)))
(sp (make-wff (c2v-st '(x k) (list (c2v-inV 'x) '(IN k NN) '(<= (succ k) n))
   (list '= '(RN-TRUNC n x (succ k)) c2v-W))))
(dk-peel!)
(c2v-sk-in!)
(c2v-type! '(RN-TRUNC n x (succ k))) (c2v-type! c2v-W)
(dk-fun-ext! '(RN-TRUNC n x (succ k)) c2v-W '(INTERVAL 1 n) 'RR #f #f
  (lambda (v)
    (c2v-idx! v)
    (c2v-three-cases! v 'k
      (lambda (cs)
        (if (eq? cs 'eq)
            (begin (subst (list '= v '(succ k)))
                   (c2v-sk-eq-facts!)
                   (c2v-ptwise! '(succ k)))
            (c2v-ptwise! v))))))
(qed 'rn-trunc-succ)

;;; the points the proof of Prop. 2.29 visits: T_k(x) + t.e_(k+1), |t| <= |x(k+1)|, stay in
;;; the cube of radius ||x||.
(define c2v-Wt '((VADD (RN n)) (RN-TRUNC n x k) ((ACT (RN n)) t (RN-UNIT n (succ k)))))
(define c2v-N '((VNRM (RN n)) x))
(sp (make-wff (c2v-st '(x k t) (list (c2v-inV 'x) '(IN k NN) '(<= (succ k) n) '(IN t RR)
                                     '(<= (abs t) (abs (x (succ k)))))
   (list '<= (list '(VNRM (RN n)) c2v-Wt) c2v-N))))
(dk-peel!)
(c2v-sk-in!)
(c2v-type! c2v-Wt)
(dk-split! (dk-cite! 'rn-norm-typing 'n 'x))
(define (c2v-abs-arg-to! simple)
  (let ((e (cadr (cadr (dk-goal)))))
    (dk-have! (list '= e simple) (lambda () (crs)))
    (subst (list '= e simple))))
(dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 n)) (list '<= (list 'abs (list c2v-Wt 'j)) c2v-N)))
  (lambda ()
    (let ((j (dk-di-var!)))
      (c2v-idx! j)
      (c2v-three-cases! j 'k
        (lambda (cs)
          (case cs
            ((le) (c2v-eval! j) (c2v-app-type! 'x j)
                  (c2v-abs-arg-to! (list 'x j))
                  (dk-cite! 'rn-norm-ge-coord 'n 'x j) (ass))
            ((eq) (subst (list '= j '(succ k))) (c2v-sk-eq-facts!)
                  (c2v-eval! '(succ k))
                  (c2v-abs-arg-to! 't)
                  (dk-cite! 'rn-norm-ge-coord 'n 'x '(succ k))
                  (dk-cite! 'rr-abs-closed 't) (dk-cite! 'rr-abs-closed '(x (succ k)))
                  (dk-ineq! '(<= (abs t) (abs (x (succ k)))) (list '<= '(abs (x (succ k))) c2v-N)))
            (else (c2v-eval! j)
                  (c2v-abs-arg-to! 0)
                  (fact 'rr-abs-zero-value) (subst '(= (abs 0) 0)) (ass))))))))
(dk-cite! 'rn-norm-le 'n c2v-Wt c2v-N)
(ass)
(qed 'rn-trunc-step-norm)
