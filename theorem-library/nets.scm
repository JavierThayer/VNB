;;; nets.scm -- directed sets, nets, subnets, net convergence in a topological space, the metric and sequence
;;; bridges, Cauchy nets and completeness in a topological vector space (Def 4.1), and the parts of TB-10 / TB-12
;;; that need nothing but nets.  Agent NETS (worker-08), 2026-10-26.
;;; DESTINATION: theorem-library/nets.scm.  Library: analysis.  Helper prefix: nt-.
;;; Needs: nets-vocab.scm (structure-library/nets.scm), top-space, metric-open-sets (IS-OPEN, BALL, PREIMAGE),
;;; metric-completeness (CONVERGES-TO), the TB-01 vocabulary (IS-TVS).

(define (nt-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; NT OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (nt-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    c))
(define (nt-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (nt-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define (nt-le d i j) (list 'IN (list 'LIST i j) (list 'DLEQ d)))
(define (nt-ev d x u) (list 'IS-EVENTUALLY-IN d x u))

;;; ===========================================================================
;;; (1) DIRECTED SETS
;;; ===========================================================================
(define nt-laws
  '((FORSOME dsn_ (IN dsn_ (PTS d)))
    (FORALL dsa_ (IMPLIES (IN dsa_ (PTS d)) (IN (LIST dsa_ dsa_) (DLEQ d))))
    (FORALL dsa_ (IMPLIES (IN dsa_ (PTS d)) (FORALL dsb_ (IMPLIES (IN dsb_ (PTS d)) (FORALL dsc_ (IMPLIES (IN dsc_ (PTS d))
      (IMPLIES (IN (LIST dsa_ dsb_) (DLEQ d)) (IMPLIES (IN (LIST dsb_ dsc_) (DLEQ d)) (IN (LIST dsa_ dsc_) (DLEQ d))))))))))
    (FORALL dsa_ (IMPLIES (IN dsa_ (PTS d)) (FORALL dsb_ (IMPLIES (IN dsb_ (PTS d))
      (FORSOME dsc_ (AND (IN dsc_ (PTS d)) (AND (IN (LIST dsa_ dsc_) (DLEQ d)) (IN (LIST dsb_ dsc_) (DLEQ d)))))))))))
(for-each
  (lambda (name law)
    (sp (make-wff (list 'FORALL 'd (list 'IMPLIES '(IS-DIRECTED-SET d) law))))
    (di) (di)
    (dk-project! law 'is-directed-set '(IS-DIRECTED-SET d))
    (dk-ass!)
    (nt-qed! name))
  '(ds-nonempty ds-refl ds-trans ds-upper)
  nt-laws)
(define (nt-refl! d i) (dk-cite! 'ds-refl d i))
(define (nt-trans! d i j k) (dk-cite! 'ds-trans d i j k))
(define (nt-upper! d i j)              ; an upper bound k of i, j: lands k in PTS d, i <= k, j <= k; returns k
  (dk-skolem! (dk-cite! 'ds-upper d i j) #t))

;;; ===========================================================================
;;; (2) EVENTUALLY
;;; ===========================================================================
(define (nt-ev-open! d x u)            ; IS-EVENTUALLY-IN(d, x, u) in context: skolemise; returns (i0 . tail-clause)
  (let* ((h (nt-ev d x u))
         (ex (dk-have! (caddr (dk-cite! 'is-eventually-in d x u))
               (lambda () (mac-h 'IS-EVENTUALLY-IN (dk-ctx-form h)) (ass))))
         (i0 (dk-skolem! (caddr (dk-cite! 'is-eventually-in d x u)) #t))
         (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f i0) (dk-contains? f u))) "the tail clause")))
    (cons i0 cl)))
(define (nt-ev-intro! d x u i0 tail!)   ; goal IS-EVENTUALLY-IN(d, x, u): witness i0; TAIL! proves x(j) in u for j >= i0
  (mac 'is-eventually-in)
  (ew i0)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((ld (dk-peel!))
                 (j (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'PTS d)))) ld))))
            (tail! j))))))

(sp (make-wff (nt-alls '(d x u v) (nt-imps (list (nt-ev 'd 'x 'u) '(SUBSET u v)) (nt-ev 'd 'x 'v)))))
(dk-peel!)
(let* ((pr (nt-ev-open! 'd 'x 'u)) (i0 (car pr)) (cl (cdr pr)))
  (nt-ev-intro! 'd 'x 'v i0
    (lambda (j) (dk-apply! cl j) (dk-cite! 'subset-mem-fwd 'u 'v (list 'x j)) (ass))))
(nt-qed! 'eventually-mono)

(sp (make-wff (nt-alls '(d x u v) (nt-imps (list '(IS-DIRECTED-SET d) (nt-ev 'd 'x 'u) (nt-ev 'd 'x 'v))
                                           (nt-ev 'd 'x '(INTERSECTION u v))))))
(dk-peel!)
(let* ((p1 (nt-ev-open! 'd 'x 'u)) (i1 (car p1)) (c1 (cdr p1))
       (p2 (nt-ev-open! 'd 'x 'v)) (i2 (car p2)) (c2 (cdr p2))
       (k (nt-upper! 'd i1 i2)))
  (nt-ev-intro! 'd 'x '(INTERSECTION u v) k
    (lambda (j)
      (nt-trans! 'd i1 k j) (nt-trans! 'd i2 k j)
      (dk-apply! c1 j) (dk-apply! c2 j)
      (let ((im (dk-cite! 'intersection-membership 'u 'v (list 'x j))))
        (if (dk-only! im (list 'IN (list 'x j) 'u) (list 'IN (list 'x j) 'v)) (prop))))))
(nt-qed! 'eventually-and)

;;; ===========================================================================
;;; (3) CONVERGENCE OF NETS IN A TOPOLOGICAL SPACE
;;; ===========================================================================
(define (nt-conv t d x a) (list 'NET-CONVERGES-TO t d x a))
(define (nt-conv-clause t d x a)
  (list 'FORALL 'ncu_ (list 'IMPLIES (list 'IN 'ncu_ (list 'OPENS t)) (list 'IMPLIES (list 'IN a 'ncu_) (nt-ev d x 'ncu_)))))
(define (nt-conv-parts! t d x a)       ; NET-CONVERGES-TO in context: land its parts, return the clause
  (let ((h (nt-conv t d x a)))
    (for-each (lambda (c) (dk-project! c 'net-converges-to h))
              (list (list 'IS-TOP-SPACE t) (list 'IS-DIRECTED-SET d) (list 'IN x (list 'FUN (list 'PTS d) (list 'PTS t)))
                    (list 'IN a (list 'PTS t))))
    (dk-project! (nt-conv-clause t d x a) 'net-converges-to h)))
(define (nt-conv-intro! clause!)       ; goal NET-CONVERGES-TO(t, d, x, a): the parts by ass, the clause by CLAUSE! u
  (mac 'net-converges-to)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((ld (dk-peel!))
                 (u (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'OPENS))) ld))))
            (clause! u))))))
(define (nt-ev-at! clause u)           ; the convergence clause at an open u containing the limit: (i0 . tail)
  (dk-apply! clause u)
  (let ((ev (dk-pick (lambda (f) (and (dk-head-is? f 'IS-EVENTUALLY-IN) (equal? (cadddr f) u))) "the eventuality")))
    (nt-ev-open! (cadr ev) (caddr ev) u)))

;;; a constant net converges
(sp (make-wff (nt-alls '(t d x a)
  (nt-imps '((IS-TOP-SPACE t) (IS-DIRECTED-SET d) (IN x (FUN (PTS d) (PTS t))) (IN a (PTS t))
             (FORALL ccj_ (IMPLIES (IN ccj_ (PTS d)) (= (x ccj_) a))))
    (nt-conv 't 'd 'x 'a)))))
(dk-peel!)
(let ((cst (dk-ctx-form '(FORALL ccj_ (IMPLIES (IN ccj_ (PTS d)) (= (x ccj_) a))))))
  (nt-conv-intro!
    (lambda (u)
      (let ((i0 (dk-skolem! (dk-cite! 'ds-nonempty 'd) #t)))
        (nt-ev-intro! 'd 'x u i0
          (lambda (j) (dk-apply! cst j) (subst (list '= (list 'x j) 'a)) (ass)))))))
(nt-qed! 'net-const-converges)

;;; a subnet of a convergent net converges to the same limit
(sp (make-wff (nt-alls '(t d x a e y)
  (nt-imps (list (nt-conv 't 'd 'x 'a) '(IS-SUBNET d x e y) '(IN y (FUN (PTS e) (PTS t))))
    (nt-conv 't 'e 'y 'a)))))
(dk-peel!)
(let* ((cl (nt-conv-parts! 't 'd 'x 'a))
       (sn '(IS-SUBNET d x e y))
       (de (dk-project! '(IS-DIRECTED-SET e) 'is-subnet sn))
       (ex (dk-project! '(FORSOME snh_ (AND (IS-COFINAL-MONOTONE e d snh_)
                          (FORALL snj_ (IMPLIES (IN snj_ (PTS e)) (= (y snj_) (x (snh_ snj_)))))))
                        'is-subnet sn))
       (h (dk-skolem! ex #t))
       (cm (list 'IS-COFINAL-MONOTONE 'e 'd h))
       (eqs (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'y) (dk-contains? f h))) "the pointwise equation"))
       (hf (dk-project! (list 'IN h '(FUN (PTS e) (PTS d))) 'is-cofinal-monotone cm))
       (mono (dk-project! (list 'FORALL 'cmi_ (list 'IMPLIES '(IN cmi_ (PTS e)) (list 'FORALL 'cmj_ (list 'IMPLIES '(IN cmj_ (PTS e))
                             (list 'IMPLIES '(IN (LIST cmi_ cmj_) (DLEQ e)) (list 'IN (list 'LIST (list h 'cmi_) (list h 'cmj_)) '(DLEQ d)))))))
                          'is-cofinal-monotone cm))
       (cof (dk-project! (list 'FORALL 'cmk_ (list 'IMPLIES '(IN cmk_ (PTS d))
                             (list 'FORSOME 'cml_ (list 'AND '(IN cml_ (PTS e)) (list 'IN (list 'LIST 'cmk_ (list h 'cml_)) '(DLEQ d))))))
                         'is-cofinal-monotone cm)))
  (nt-conv-intro!
    (lambda (u)
      (let* ((pr (nt-ev-at! cl u)) (i0 (car pr)) (tl (cdr pr))
             (l (dk-skolem! (dk-apply! cof i0) #t)))
        (nt-ev-intro! 'e 'y u l
          (lambda (j)
            (dk-cite! 'fun-apply-type-c h '(PTS e) '(PTS d) l)
            (dk-cite! 'fun-apply-type-c h '(PTS e) '(PTS d) j)
            (dk-apply! mono l j)
            (nt-trans! 'd i0 (list h l) (list h j))
            (dk-apply! tl (list h j))
            (dk-apply! eqs j)
            (subst (list '= (list 'y j) (list 'x (list h j))))
            (ass)))))))
(nt-qed! 'subnet-converges)

;;; a continuous map carries a convergent net to a convergent net
(sp (make-wff (nt-alls '(t d x a w f y)
  (nt-imps (list (nt-conv 't 'd 'x 'a) '(IS-HOM-TOP-SPACE t w f) '(IN y (FUN (PTS d) (PTS w)))
                 '(FORALL cij_ (IMPLIES (IN cij_ (PTS d)) (= (y cij_) (f (x cij_))))))
    (nt-conv 'w 'd 'y '(f a))))))
(dk-peel!)
(let* ((cl (nt-conv-parts! 't 'd 'x 'a))
       (hom '(IS-HOM-TOP-SPACE t w f))
       (eqs (dk-ctx-form '(FORALL cij_ (IMPLIES (IN cij_ (PTS d)) (= (y cij_) (f (x cij_)))))))
       (pre (dk-project! '(FORALL u (IMPLIES (IN u (OPENS w)) (IN (PREIMAGE t f u) (OPENS t)))) 'is-hom-top-space-def hom)))
  (dk-project! '(IS-TOP-SPACE w) 'is-hom-top-space-def hom)
  (dk-project! '(IN f (FUN (PTS t) (PTS w))) 'is-hom-top-space-def hom)
  (dk-cite! 'fun-apply-type-c 'f '(PTS t) '(PTS w) 'a)
  (nt-conv-intro!
    (lambda (u)
      (let ((p (list 'PREIMAGE 't 'f u)))
        (dk-apply! pre u)
        (let ((im (dk-cite! 'preimage-membership 't 'f u 'a)))
          (dk-have! (list 'IN 'a p) (lambda () (if (dk-only! im '(IN a (PTS t)) (list 'IN '(f a) u)) (prop)))))
        (let* ((pr (nt-ev-at! cl p)) (i0 (car pr)) (tl (cdr pr)))
          (nt-ev-intro! 'd 'y u i0
            (lambda (j)
              (dk-apply! tl j)
              (let ((im2 (dk-cite! 'preimage-membership 't 'f u (list 'x j))))
                (dk-have! (list 'IN (list 'f (list 'x j)) u) (lambda () (if (dk-only! im2 (list 'IN (list 'x j) p)) (prop)))))
              (dk-apply! eqs j)
              (subst (list '= (list 'y j) (list 'f (list 'x j))))
              (ass))))))))
(nt-qed! 'net-continuous-image)

;;; in a Hausdorff space a net has at most one limit
(sp (make-wff (nt-alls '(t d x a b)
  (nt-imps (list '(IS-HAUSDORFF t) (nt-conv 't 'd 'x 'a) (nt-conv 't 'd 'x 'b)) '(= a b)))))
(dk-peel!)
(let* ((ca (nt-conv-parts! 't 'd 'x 'a))
       (cb (nt-conv-parts! 't 'd 'x 'b))
       (hs (dk-project! (forall-guarded '(a b) (list '(IN a (PTS t)) '(IN b (PTS t)) '(NOT (== a b)))
                          (list 'FORSOME 'u (list 'FORSOME 'v (conjuncts->and (list '(IN u (OPENS t)) '(IN v (OPENS t)) '(IN a u) '(IN b v)
                                                                                  '(== (INTERSECTION u v) EMPTY-SET))))))
                        'is-hausdorff '(IS-HAUSDORFF t))))
  (pbc)
  (dk-have! '(NOT (== a b)) (lambda () (di) (dk-have! '(= a b) (lambda () (subst '(== a b)) (rfl))) (ai '(NOT (= a b)))))
  (let* ((u (dk-skolem! (dk-apply! hs 'a 'b) 'top))
         (v (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f u))) "v") #t)))
    (dk-split-all!)
    (dk-apply! ca u) (dk-apply! cb v)
    (dk-cite! 'eventually-and 'd 'x u v)
    (let* ((uv (list 'INTERSECTION u v))
           (pr (nt-ev-open! 'd 'x uv)) (i0 (car pr)) (tl (cdr pr)))
      (nt-refl! 'd i0)
      (dk-apply! tl i0)
      (dk-rewrite-h! (list 'IN (list 'x i0) uv) uv 'EMPTY-SET)
      (dk-cite! 'empty-set-has-no-members (list 'x i0))
      (ai (list 'NOT (list 'IN (list 'x i0) 'EMPTY-SET))))))
(nt-qed! 'net-limit-unique)

;;; ===========================================================================
;;; (4) METRIC SPACES: NET CONVERGENCE IN METRIC-TOP IS THE eps-BALL CONDITION
;;; ===========================================================================
(define nt-mt '(METRIC-TOP s))
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (== (PTS (METRIC-TOP s)) (PTS s))))))
(dk-peel!)
(dk-cite! 'ms-pts-is-set 's)
(dk-cite! 'power-set '(PTS s))
(slot 'PTS)
(mac 'METRIC-TOP)
(nth-r)
(if (and (not (proof-done? *ps*)) (dk-contains? (dk-goal) 'PTS)) (slot 'PTS))
(if (not (proof-done? *ps*)) (qrfl))
(nt-qed! 'metric-top-pts)

(define (nt-ball s a e) (list 'BALL s a e))
(define (nt-ev-ball s d x a) (list 'FORALL 'mbe_ (list 'IMPLIES '(POS-RR mbe_) (nt-ev d x (nt-ball s a 'mbe_)))))
(sp (make-wff (nt-alls '(s d x a)
  (nt-imps '((IS-METRIC-SPACE s) (IS-DIRECTED-SET d) (IN x (FUN (PTS d) (PTS s))) (IN a (PTS s)))
    (list 'IFF (nt-conv nt-mt 'd 'x 'a) (nt-ev-ball 's 'd 'x 'a))))))
(dk-peel!)
(dk-cite! 'metric-top-pts 's)
(dk-cite! 'metric-top-is-top-space 's)
(let ((oi (dk-cite! 'metric-top-opens-iff 's)))
  (dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
    (lambda ()
      (let* ((cl (nt-conv-parts! nt-mt 'd 'x 'a))
             (e (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) (dk-peel!))))
             (b (nt-ball 's 'a e)))
        (dk-pos-parts! e)
        (dk-cite! 'ball-is-open 's 'a e)
        (dk-cite! 'ball-center-in 's 'a e)
        (let ((io (dk-apply! oi b)))
          (dk-have! (list 'IN b (list 'OPENS nt-mt)) (lambda () (if (dk-only! io (list 'IS-OPEN 's b)) (prop)))))
        (dk-apply! cl b)
        (ass)))
    (lambda ()
      (let ((hb (nt-ev-ball 's 'd 'x 'a)))
        (dk-have! (list 'IN 'x (list 'FUN '(PTS d) (list 'PTS nt-mt))) (lambda () (subst (list '== (list 'PTS nt-mt) '(PTS s))) (ass)))
        (dk-have! (list 'IN 'a (list 'PTS nt-mt)) (lambda () (subst (list '== (list 'PTS nt-mt) '(PTS s))) (ass)))
        (nt-conv-intro!
          (lambda (u)
            (let ((io (dk-apply! oi u)))
              (dk-have! (list 'IS-OPEN 's u) (lambda () (if (dk-only! io (list 'IN u (list 'OPENS nt-mt))) (prop)))))
            (let* ((op (dk-project! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y u)
                                      (list 'FORSOME 'r (list 'AND '(POS-RR r) (list 'SUBSET '(BALL s y r) u)))))
                                    'is-open (list 'IS-OPEN 's u)))
                   (r (dk-skolem! (dk-apply! op 'a) #t)))
              (dk-apply! hb r)
              (dk-cite! 'eventually-mono 'd 'x (nt-ball 's 'a r) u)
              (ass))))))))
(nt-qed! 'metric-net-converges-iff)

;;; ===========================================================================
;;; (5) THE NATURALS AS A DIRECTED SET; A SEQUENCE CONVERGES IFF IT CONVERGES AS A NET
;;; ===========================================================================
(define nt-nnd-rel '(SEP ndp_ (CARTESIAN NN NN) (<= (NTH 1 ndp_) (NTH 2 ndp_))))
(define (nt-nnd-slot! name acc val)
  (dk-sp-qed! (make-wff (list '== (list acc 'NN-DIRECTED) val))
    (lambda ()
      (fact 'nn-is-set)
      (slot acc)
      (subst (dk-cite! 'nn-directed-def))
      (nth-r)
      (if (not (proof-done? *ps*)) (qrfl)))
    name)
  (topic! name 'analysis))
(nt-nnd-slot! 'nn-directed-pts 'PTS 'NN)
(nt-nnd-slot! 'nn-directed-dleq 'DLEQ nt-nnd-rel)

(sp (make-wff '(FORALL m (IMPLIES (IN m NN) (FORALL n_ (IMPLIES (IN n_ NN)
   (IFF (IN (LIST m n_) (DLEQ NN-DIRECTED)) (<= m n_))))))))
(dk-peel!)
(dk-cite! 'nn-directed-dleq)
(subst (list '== '(DLEQ NN-DIRECTED) nt-nnd-rel))
(dk-cite! 'pair-in-cartesian 'NN 'NN 'm 'n_)
(dk-iff! (lambda (g) (dk-head-is? g '<=))
  (lambda () (sep-me (dk-ctx-form (list 'IN '(LIST m n_) nt-nnd-rel))) (dk-split-all!)
             (dk-nth-h! (dk-pick (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f 'NTH))) "the order")) (ass))
  (lambda () (in-sep! (lambda () (ass)) (lambda () (nth-r) (ass)))))
(nt-qed! 'nn-directed-le-iff)
(define (nt-nn-le! a b)                ; (<= a b), a, b in NN in context  =>  [a, b] in DLEQ(NN-DIRECTED)
  (let ((i (dk-cite! 'nn-directed-le-iff a b)))
    (dk-have! (nt-le 'NN-DIRECTED a b) (lambda () (if (dk-only! i (list '<= a b)) (prop))))))
(define (nt-nn-le-back! a b)           ; the converse
  (let ((i (dk-cite! 'nn-directed-le-iff a b)))
    (dk-have! (list '<= a b) (lambda () (if (dk-only! i (nt-le 'NN-DIRECTED a b)) (prop))))))

(sp (make-wff '(IS-DIRECTED-SET NN-DIRECTED)))
(fact 'nn-is-set)
(fact 'nn-zero-in)
(dk-cite! 'nn-directed-pts)
(dk-cite! 'nn-directed-dleq)
(mac 'is-directed-set)
(subst (list '== '(PTS NN-DIRECTED) 'NN))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? g 'FORSOME) (ew 0) (ass))
        ((dk-contains? g 'LENGTH) (subst (dk-cite! 'nn-directed-def)) (len-r) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (arith)))
        ((dk-contains? g 'POWER)
         (subst (list '== '(DLEQ NN-DIRECTED) nt-nnd-rel))
         (let ((cc '(CARTESIAN NN NN)))
           (dk-have! (list 'IN cc 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
           (dk-have! (list 'IN nt-nnd-rel 'SET) (lambda () (sep-set) (ass)))
           (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ nt-nnd-rel) (list 'IN 'z_ cc)))
             (lambda () (let ((z (dk-di-var!))) (sep-me (dk-ctx-form (list 'IN z nt-nnd-rel))) (dk-split-all!) (ass))))
           (dk-cite! 'power-mem-intro cc nt-nnd-rel)
           (dk-ass!)))
        ((dk-head-is? g 'FORALL)
         (let* ((ld (dk-peel!))
                (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ld))))
           (cond ((= (length vs) 1)
                  (dk-cite! 'nn-le-refl (car vs)) (nt-nn-le! (car vs) (car vs)))
                 ((= (length vs) 3)
                  (let ((a (car vs)) (b (cadr vs)) (c (caddr vs)))
                    (dk-peel!)
                    (nt-nn-le-back! a b) (nt-nn-le-back! b c)
                    (dk-cite! 'nn-le-trans-guarded a b c)
                    (nt-nn-le! a c)))
                 (#t
                  (let* ((a (car vs)) (b (cadr vs)) (k (list '+ a b)))
                    (nt-and! (list 'IN a 'NN) (list 'IN b 'NN))
                    (dk-cite! 'nn-add-closed a b)
                    (dk-cite! 'nn-le-add-right b a)
                    (dk-cite! 'nn-le-add-left a b)
                    (nt-nn-le! a k) (nt-nn-le! b k)
                    (ew k) (dk-conj-close! (lambda () (ass))))))))
        (#t (error "nn-directed: unexpected conjunct" (expression->string g)))))))
(nt-qed! 'nn-directed-is-directed-set)

;;; a sequence converges in a metric space iff it converges as a net on NN-DIRECTED in the metric topology
(define nt-seq-clause
  '(FORALL eps (IMPLIES (POS-RR eps) (FORSOME N (AND (IN N NN) (FORALL n_ (IMPLIES (IN n_ NN)
     (IMPLIES (<= N n_) (<= ((DIST s) (f n_) L) eps)))))))))
(sp (make-wff (nt-alls '(s f L)
  (nt-imps '((IS-METRIC-SPACE s) (IN f (FUN NN (PTS s))) (IN L (PTS s)))
    (list 'IFF '(CONVERGES-TO s f L) (nt-conv nt-mt 'NN-DIRECTED 'f 'L))))))
(dk-peel!)
(dk-cite! 'nn-directed-is-directed-set)
(dk-cite! 'nn-directed-pts)
(fact 'nn-is-set)
(dk-have! '(IN f (FUN (PTS NN-DIRECTED) (PTS s))) (lambda () (subst '(== (PTS NN-DIRECTED) NN)) (ass)))
(let* ((iff2 (dk-cite! 'metric-net-converges-iff 's 'NN-DIRECTED 'f 'L))
       (bc (caddr iff2))
       (dds (lambda (j) (list '(DIST s) 'L (list 'f j))))
       (ddf (lambda (j) (list '(DIST s) (list 'f j) 'L))))
  (define (pt! j)                      ; j in NN: f(j) typed, both distances real, symmetric
    (dk-cite! 'fun-apply-type-c 'f 'NN '(PTS s) j)
    (dk-cite! 'metric-dist-real 's 'L (list 'f j))
    (dk-cite! 'metric-dist-real 's (list 'f j) 'L)
    (dk-cite! 'metric-sym 's 'L (list 'f j)))
  (dk-iff! (lambda (g) (dk-head-is? g 'NET-CONVERGES-TO))
    (lambda ()
      (let ((cl (dk-project! nt-seq-clause 'converges-to '(CONVERGES-TO s f L))))
        (dk-have! bc
          (lambda ()
            (let* ((e (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) (dk-peel!))))
                   (h (list '* 1/2 e)))
              (dk-pos-parts! e)
              (dk-real! h)
              (dk-have! (list '< 0 h) (lambda () (dk-ineq! (list '< 0 e) (list 'IN e 'RR))))
              (dk-cite! 'rr-pos-rr-of-lt h)
              (let ((nn (dk-skolem! (dk-apply! cl h) #t)))
                (dk-have! (list 'IN nn '(PTS NN-DIRECTED)) (lambda () (subst '(== (PTS NN-DIRECTED) NN)) (ass)))
                (nt-ev-intro! 'NN-DIRECTED 'f (nt-ball 's 'L e) nn
                  (lambda (j)
                    (dk-rewrite-h! (list 'IN j '(PTS NN-DIRECTED)) '(PTS NN-DIRECTED) 'NN)
                    (nt-nn-le-back! nn j)
                    (pt! j)
                    (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nn) (dk-contains? f 'DIST))) "the tail") j)
                    (dk-have! (list '<= (dds j) e) (lambda () (dk-ineq! (list '<= (ddf j) h) (list '= (dds j) (ddf j)) (list '< 0 e) (list 'IN (ddf j) 'RR) (list 'IN e 'RR))))
                    (dk-have! (list 'NOT (list '= (dds j) e))
                      (lambda () (di) (dk-absurd! (list '= (dds j) e) (list '<= (ddf j) h) (list '= (dds j) (ddf j)) (list '< 0 e)
                                                  (list 'IN (ddf j) 'RR) (list 'IN e 'RR))))
                    (let ((bm (dk-cite! 'ball-membership 's 'L e (list 'f j))))
                      (nt-and! (list 'IN (list 'f j) '(PTS s)) (list '<= (dds j) e) (list 'NOT (list '= (dds j) e)))
                      (if (dk-only! bm (caddr bm)) (prop)))))))))
        (if (dk-only! iff2 bc) (prop))))
    (lambda ()
      (dk-have! bc (lambda () (if (dk-only! iff2 (nt-conv nt-mt 'NN-DIRECTED 'f 'L)) (prop))))
      (mac 'converges-to)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((e (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) (dk-peel!))))
                     (pr (begin (dk-apply! bc e) (nt-ev-open! 'NN-DIRECTED 'f (nt-ball 's 'L e))))
                     (i0 (car pr)) (tl (cdr pr)))
                (dk-pos-parts! e)
                (dk-rewrite-h! (list 'IN i0 '(PTS NN-DIRECTED)) '(PTS NN-DIRECTED) 'NN)
                (ew i0)
                (dk-conj-close!
                  (lambda ()
                    (if (not (dk-ass!))
                        (let ((j (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!)))))
                          (nt-nn-le! i0 j)
                          (dk-have! (list 'IN j '(PTS NN-DIRECTED)) (lambda () (subst '(== (PTS NN-DIRECTED) NN)) (ass)))
                          (dk-apply! tl j)
                          (pt! j)
                          (let ((bm (dk-cite! 'ball-membership 's 'L e (list 'f j))))
                            (dk-have! (caddr bm) (lambda () (if (dk-only! bm (list 'IN (list 'f j) (nt-ball 's 'L e))) (prop))))
                            (dk-split-all! (list (caddr bm))))
                          (dk-ineq! (list '<= (dds j) e) (list '= (dds j) (ddf j)) (list 'IN (ddf j) 'RR) (list 'IN e 'RR)))))))))))))
(nt-qed! 'seq-converges-iff-net)

;;; ===========================================================================
;;; (6) TOPOLOGICAL VECTOR SPACES: SUBTRACTION IS CONTINUOUS; CAUCHY NETS (Def 4.1)
;;; ===========================================================================
(define nt-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define nt-tvs '(IS-TVS RR-NORMED-FIELD m t))
(define nt-addc
  (forall-guarded '(tvx_ tvy_ tvu_)
    '((IN tvx_ (VEC m)) (IN tvy_ (VEC m)) (IN tvu_ (OPENS t)) (IN ((VADD m) tvx_ tvy_) tvu_))
    '(FORSOME tvv_ (AND (IN tvv_ (OPENS t)) (AND (IN tvx_ tvv_)
       (FORSOME tvw_ (AND (IN tvw_ (OPENS t)) (AND (IN tvy_ tvw_)
         (FORALL tva_ (IMPLIES (IN tva_ tvv_) (FORALL tvb_ (IMPLIES (IN tvb_ tvw_)
           (IN ((VADD m) tva_ tvb_) tvu_)))))))))))))
(define (nt-tvs-parts!)
  (if (not (dk-asm? '(IS-TOP-SPACE t)))
      (begin
        (dk-project! '(IS-MODULE m) 'is-tvs nt-tvs)
        (dk-project! (list '= '(SCAL m) nt-ring) 'is-tvs nt-tvs)
        (dk-project! '(== (PTS t) (VEC m)) 'is-tvs nt-tvs)
        (dk-project! nt-addc 'is-tvs nt-tvs)
        (dk-project! '(IS-HAUSDORFF t) 'is-tvs nt-tvs)
        (dk-project! '(IS-TOP-SPACE t) 'is-hausdorff '(IS-HAUSDORFF t))
        (dk-project! '(IN (OPENS t) (POWER (POWER (PTS t)))) 'is-top-space '(IS-TOP-SPACE t)))))
(define (nt-sub a b) (list '(VADD m) a (list '(VNEG m) b)))
(define (nt-vtype! v)
  (let ((ty (list 'IN v '(VEC m))))
    (cond ((dk-asm? ty) ty)
          ((equal? v '(VZERO m)) (dk-cite! 'module-vzero-in 'm) ty)
          ((and (pair? v) (equal? (car v) '(VADD m))) (nt-vtype! (cadr v)) (nt-vtype! (caddr v)) (dk-cite! 'module-vadd-type 'm (cadr v) (caddr v)) ty)
          ((and (pair? v) (equal? (car v) '(VNEG m))) (nt-vtype! (cadr v)) (dk-cite! 'module-vneg-type 'm (cadr v)) ty)
          ((and (pair? v) (equal? (car v) '(ACT m))) (nt-vtype! (caddr v)) (dk-real! (cadr v)) (dk-cite! 'rmod-act-type 'm (cadr v) (caddr v)) ty)
          (#t (error "nt-vtype!: cannot type" (expression->string v))))))
(define (nt-pts! v)                    ; v in VEC m  =>  v in PTS t
  (let ((ty (list 'IN v '(PTS t))))
    (if (not (dk-asm? ty)) (begin (nt-vtype! v) (dk-have! ty (lambda () (subst '(== (PTS t) (VEC m))) (ass)))))
    ty))
(define (nt-vec! v)                    ; v in PTS t  =>  v in VEC m
  (let ((ty (list 'IN v '(VEC m))))
    (if (not (dk-asm? ty)) (dk-have! ty (lambda () (subst '(== (VEC m) (PTS t))) (ass))))
    ty))

;; in a real module, -x = (-1).x
(sp (make-wff (forall-guarded '(m x) (list '(IS-MODULE m) (list '= '(SCAL m) nt-ring) '(IN x (VEC m)))
                              '(= ((VNEG m) x) ((ACT m) (- 1) x)))))
(dk-peel!)
(dk-real! 1) (dk-real! '(- 1))
(dk-have! '(IN 1 (CARR (SCAL m))) (lambda () (subst (list '= '(SCAL m) nt-ring)) (mac 'rr-scalar-ring-carr) (ass)))
(dk-have! '(= ((NEG (SCAL m)) 1) (- 1))
  (lambda () (subst (list '= '(SCAL m) nt-ring)) (mac 'rr-scalar-ring-neg) (dk-lam-b!) (rfl)))
(subst '(= (- 1) ((NEG (SCAL m)) 1)))
(subst (dk-cite! 'frm-act-neg-scal 'm 1 'x))
(subst (dk-cite! 'rmod-act-one 'm 'x))
(dk-cite! 'module-vneg-type 'm 'x)
(rfl)
(nt-qed! 'rmod-vneg-act)

;; subtraction is continuous
(define nt-subc-body
  '(FORSOME tsv_ (AND (IN tsv_ (OPENS t)) (AND (IN x tsv_)
     (FORSOME tsw_ (AND (IN tsw_ (OPENS t)) (AND (IN y tsw_)
       (FORALL tsp_ (IMPLIES (IN tsp_ tsv_) (FORALL tsq_ (IMPLIES (IN tsq_ tsw_)
         (IN ((VADD m) tsp_ ((VNEG m) tsq_)) u))))))))))))
(sp (make-wff (forall-guarded '(m t x y u)
  (list nt-tvs '(IN x (VEC m)) '(IN y (VEC m)) '(IN u (OPENS t)) (list 'IN (nt-sub 'x 'y) 'u))
  nt-subc-body)))
(dk-peel!)
(nt-tvs-parts!)
(nt-vtype! '((VNEG m) y))
(let* ((ex (dk-apply! nt-addc 'x '((VNEG m) y) 'u))
       (v (dk-skolem! ex #t))
       (w0 (let ((ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'tvw_))) (dk-asms))))
             (if ex2 (dk-skolem! ex2 #t)
                 (caddr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) '((VNEG m) y)) (symbol? (caddr f)) (not (eq? (caddr f) v))))
                                 "W")))))
       (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f v) (dk-contains? f w0))) "the sum clause"))
       (w (list 'SEP 'scx_ '(VEC m) (list 'IN '((ACT m) (- 1) scx_) w0))))
  (dk-real! '(- 1))
  (dk-cite! 'tvs-dilate-open 'm 't '(- 1) w0)
  (dk-cite! 'rmod-vneg-act 'm 'y)
  (dk-have! (list 'IN 'y w) (lambda () (in-sep! (lambda () (ass)) (lambda () (subst '(= ((ACT m) (- 1) y) ((VNEG m) y))) (ass)))))
  (ew v)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (ew w)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (let* ((ld (dk-peel!))
                           (p (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) v))) ld)))
                           (q (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) w))) ld))))
                      (sep-me (list 'IN q w)) (dk-split-all!)
                      (dk-cite! 'rmod-vneg-act 'm q)
                      (dk-rewrite-h! (list 'IN (list '(ACT m) '(- 1) q) w0) (list '(ACT m) '(- 1) q) (list '(VNEG m) q))
                      (dk-apply! cl p (list '(VNEG m) q))
                      (ass))))))))))
(nt-qed! 'tvs-sub-continuous)

(define (nt-cauchy-clause d x)
  (list 'FORALL 'cnu_ (list 'IMPLIES '(IN cnu_ (OPENS t)) (list 'IMPLIES '(IN (VZERO m) cnu_)
    (list 'FORSOME 'cni_ (list 'AND (list 'IN 'cni_ (list 'PTS d))
      (list 'FORALL 'cnj_ (list 'IMPLIES (list 'IN 'cnj_ (list 'PTS d)) (list 'IMPLIES (nt-le d 'cni_ 'cnj_)
        (list 'FORALL 'cnk_ (list 'IMPLIES (list 'IN 'cnk_ (list 'PTS d)) (list 'IMPLIES (nt-le d 'cni_ 'cnk_)
          (list 'IN (list '(VADD m) (list x 'cnj_) (list '(VNEG m) (list x 'cnk_))) 'cnu_)))))))))))))
(define (nt-sub-open! a b u)            ; (IN (a - b) u) in context: the open v ∋ a, w ∋ b and the clause
  (let* ((ex (dk-cite! 'tvs-sub-continuous 'm 't a b u))
         (v (dk-skolem! ex #t))
         (w (let ((ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'tsw_))) (dk-asms))))
              (if ex2 (dk-skolem! ex2 #t)
                  (caddr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) b) (symbol? (caddr f)) (not (eq? (caddr f) v))
                                                   (dk-asm? (list 'IN (caddr f) '(OPENS t)))))
                                  "W")))))
         (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f v) (dk-contains? f w))) "the difference clause")))
    (list v w cl)))

;;; a convergent net is Cauchy
(sp (make-wff (nt-alls '(m t d x a) (nt-imps (list nt-tvs (nt-conv 't 'd 'x 'a)) '(IS-CAUCHY-NET m t d x)))))
(dk-peel!)
(nt-tvs-parts!)
(let ((cl (nt-conv-parts! 't 'd 'x 'a)))
  (nt-vec! 'a)
  (dk-have! '(IN x (FUN (PTS d) (VEC m))) (lambda () (subst '(== (VEC m) (PTS t))) (ass)))
  (mac 'is-cauchy-net)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((ld (dk-peel!))
                 (u (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(OPENS t)))) ld))))
            (dk-cite! 'frm-v-right-inv 'm 'a)
            (dk-have! (list 'IN (nt-sub 'a 'a) u) (lambda () (subst (list '= (nt-sub 'a 'a) '(VZERO m))) (ass)))
            (let* ((vwc (nt-sub-open! 'a 'a u)) (v (car vwc)) (w (cadr vwc)) (sc (caddr vwc)))
              (dk-apply! cl v) (dk-apply! cl w)
              (dk-cite! 'eventually-and 'd 'x v w)
              (let* ((vw (list 'INTERSECTION v w))
                     (pr (nt-ev-open! 'd 'x vw)) (i0 (car pr)) (tl (cdr pr)))
                (ew i0)
                (dk-conj-close!
                  (lambda ()
                    (if (not (dk-ass!))
                        (let* ((ld2 (dk-peel!))
                               (gv (cadr (dk-goal)))
                               (j (cadr (cadr gv))) (k (cadr (cadr (caddr gv)))))
                          (dk-apply! tl j) (dk-apply! tl k)
                          (let* ((im1 (dk-cite! 'intersection-membership v w (list 'x j)))
                                (im2 (dk-cite! 'intersection-membership v w (list 'x k))))
                            (dk-have! (list 'IN (list 'x j) v) (lambda () (if (dk-only! im1 (list 'IN (list 'x j) vw)) (prop))))
                            (dk-have! (list 'IN (list 'x k) w) (lambda () (if (dk-only! im2 (list 'IN (list 'x k) vw)) (prop)))))
                          (dk-apply! sc (list 'x j) (list 'x k))
                          (ass))))))))))))
(nt-qed! 'tvs-convergent-net-cauchy)

(define (nt-subnet-parts! d x e y)     ; IS-SUBNET in context: (h mono cof eqs), IS-DIRECTED-SET e landed
  (let* ((sn (list 'IS-SUBNET d x e y))
         (de (dk-project! (list 'IS-DIRECTED-SET e) 'is-subnet sn))
         (ex (dk-project! (list 'FORSOME 'snh_ (list 'AND (list 'IS-COFINAL-MONOTONE e d 'snh_)
                                 (list 'FORALL 'snj_ (list 'IMPLIES (list 'IN 'snj_ (list 'PTS e)) (list '= (list y 'snj_) (list x '(snh_ snj_)))))))
                          'is-subnet sn))
         (h (dk-skolem! ex #t))
         (cm (list 'IS-COFINAL-MONOTONE e d h))
         (eqs (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f y) (dk-contains? f h))) "the pointwise equation"))
         (hf (dk-project! (list 'IN h (list 'FUN (list 'PTS e) (list 'PTS d))) 'is-cofinal-monotone cm))
         (mono (dk-project! (list 'FORALL 'cmi_ (list 'IMPLIES (list 'IN 'cmi_ (list 'PTS e)) (list 'FORALL 'cmj_ (list 'IMPLIES (list 'IN 'cmj_ (list 'PTS e))
                               (list 'IMPLIES (nt-le e 'cmi_ 'cmj_) (nt-le d (list h 'cmi_) (list h 'cmj_)))))))
                            'is-cofinal-monotone cm))
         (cof (dk-project! (list 'FORALL 'cmk_ (list 'IMPLIES (list 'IN 'cmk_ (list 'PTS d))
                               (list 'FORSOME 'cml_ (list 'AND (list 'IN 'cml_ (list 'PTS e)) (nt-le d 'cmk_ (list h 'cml_))))))
                           'is-cofinal-monotone cm)))
    (list h mono cof eqs)))

;;; a Cauchy net with a convergent subnet converges, to the same limit
(sp (make-wff (nt-alls '(m t d x e y a)
  (nt-imps (list nt-tvs '(IS-CAUCHY-NET m t d x) '(IS-SUBNET d x e y) (nt-conv 't 'e 'y 'a)) (nt-conv 't 'd 'x 'a)))))
(dk-peel!)
(nt-tvs-parts!)
(let* ((cn '(IS-CAUCHY-NET m t d x))
       (cc (dk-project! (nt-cauchy-clause 'd 'x) 'is-cauchy-net cn))
       (xf (dk-project! '(IN x (FUN (PTS d) (VEC m))) 'is-cauchy-net cn))
       (dd (dk-project! '(IS-DIRECTED-SET d) 'is-cauchy-net cn))
       (cy (nt-conv-parts! 't 'e 'y 'a))
       (sp4 (nt-subnet-parts! 'd 'x 'e 'y))
       (h (car sp4)) (mono (cadr sp4)) (cof (caddr sp4)) (eqs (cadddr sp4)))
  (nt-vec! 'a)
  (dk-have! '(IN x (FUN (PTS d) (PTS t))) (lambda () (subst '(== (PTS t) (VEC m))) (ass)))
  (nt-conv-intro!
    (lambda (u)
      (dk-cite! 'module-vzero-in 'm)
      (dk-cite! 'rmod-vzero-left 'm 'a)
      (dk-have! (list 'IN '((VADD m) (VZERO m) a) u) (lambda () (subst '(= ((VADD m) (VZERO m) a) a)) (ass)))
      (let* ((ex (dk-apply! nt-addc '(VZERO m) 'a u))
             (v0 (dk-skolem! ex #t))
             (w (let ((ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'tvw_))) (dk-asms))))
                  (if ex2 (dk-skolem! ex2 #t)
                      (caddr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (cadr f) 'a) (symbol? (caddr f)) (not (eq? (caddr f) v0))
                                                       (not (eq? (caddr f) u)) (dk-asm? (list 'IN (caddr f) '(OPENS t)))))
                                      "W")))))
             (sc (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f v0) (dk-contains? f w))) "the sum clause"))
             (ci (dk-skolem! (dk-apply! cc v0) #t))
             (ctl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ci) (dk-contains? f v0))) "the Cauchy tail"))
             (pr (nt-ev-at! cy w)) (l0 (car pr)) (ytl (cdr pr))
             (l1 (dk-skolem! (dk-apply! cof ci) #t))
             (l2 (nt-upper! 'e l0 l1))
             (z (list 'x (list h l2))))
        (dk-cite! 'fun-apply-type-c h '(PTS e) '(PTS d) l1)
        (dk-cite! 'fun-apply-type-c h '(PTS e) '(PTS d) l2)
        (dk-apply! mono l1 l2)
        (nt-trans! 'd ci (list h l1) (list h l2))
        (dk-apply! ytl l2)
        (dk-apply! eqs l2)
        (dk-rewrite-h! (list 'IN (list 'y l2) w) (list 'y l2) z)
        (dk-cite! 'fun-apply-type-c 'x '(PTS d) '(VEC m) (list h l2))
        (nt-ev-intro! 'd 'x u ci
          (lambda (j)
            (dk-cite! 'fun-apply-type-c 'x '(PTS d) '(VEC m) j)
            (dk-apply! ctl j (list h l2))
            (nt-vtype! (nt-sub (list 'x j) z))
            (dk-apply! sc (nt-sub (list 'x j) z) z)
            (dk-cite! 'fbs-v-sub-add 'm (list 'x j) z)
            (dk-rewrite-h! (list 'IN (list '(VADD m) (nt-sub (list 'x j) z) z) u) (list '(VADD m) (nt-sub (list 'x j) z) z) (list 'x j))
            (ass)))))))
(nt-qed! 'tvs-cauchy-subnet-converges)

;;; ===========================================================================
;;; (7) LIMITS IN CLOSED SETS; COMPLETE SUBSETS
;;; ===========================================================================
(sp (make-wff (nt-alls '(t d x L a)
  (nt-imps (list '(IS-TOP-CLOSED t a) (nt-conv 't 'd 'x 'L) '(FORALL lci_ (IMPLIES (IN lci_ (PTS d)) (IN (x lci_) a))))
    '(IN L a)))))
(dk-peel!)
(let* ((cl (nt-conv-parts! 't 'd 'x 'L))
       (co '(COMPLEMENT-IN (PTS t) a))
       (inA (dk-ctx-form '(FORALL lci_ (IMPLIES (IN lci_ (PTS d)) (IN (x lci_) a))))))
  (dk-project! (list 'IN co '(OPENS t)) 'is-top-closed '(IS-TOP-CLOSED t a))
  (pbc)
  (let ((im (dk-cite! 'complement-in-membership '(PTS t) 'a 'L)))
    (dk-have! (list 'IN 'L co) (lambda () (if (dk-only! im '(IN L (PTS t)) '(NOT (IN L a))) (prop)))))
  (let* ((pr (nt-ev-at! cl co)) (i0 (car pr)) (tl (cdr pr)))
    (nt-refl! 'd i0)
    (dk-apply! tl i0)
    (dk-apply! inA i0)
    (let ((im2 (dk-cite! 'complement-in-membership '(PTS t) 'a (list 'x i0))))
      (dk-only! im2 (list 'IN (list 'x i0) co) (list 'IN (list 'x i0) 'a))
      (prop))))
(nt-qed! 'net-limit-in-closed)

;;; a closed subset of a complete topological vector space is complete
(sp (make-wff (nt-alls '(m t a)
  (nt-imps (list nt-tvs '(IS-COMPLETE-SUBSET m t (VEC m)) '(SUBSET a (VEC m)) '(IS-TOP-CLOSED t a)) '(IS-COMPLETE-SUBSET m t a)))))
(dk-peel!)
(nt-tvs-parts!)
(let ((cpl (dk-project! '(FORALL csd_ (FORALL csx_ (IMPLIES (IS-CAUCHY-NET m t csd_ csx_)
                            (IMPLIES (FORALL csi_ (IMPLIES (IN csi_ (PTS csd_)) (IN (csx_ csi_) (VEC m))))
                              (FORSOME csl_ (AND (IN csl_ (VEC m)) (NET-CONVERGES-TO t csd_ csx_ csl_)))))))
                        'is-complete-subset '(IS-COMPLETE-SUBSET m t (VEC m)))))
  (mac 'is-complete-subset)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((ld (dk-peel!))
                 (cn (find-first (lambda (f) (dk-head-is? f 'IS-CAUCHY-NET)) ld))
                 (d (cadddr cn)) (x (car (cddddr cn)))
                 (ina (find-first (lambda (f) (dk-head-is? f 'FORALL)) ld)))
            (dk-project! (list 'IN x (list 'FUN (list 'PTS d) '(VEC m))) 'is-cauchy-net cn)
            (dk-have! (list 'FORALL 'csi_ (list 'IMPLIES (list 'IN 'csi_ (list 'PTS d)) (list 'IN (list x 'csi_) '(VEC m))))
              (lambda () (let ((i (dk-di-var!))) (dk-cite! 'fun-apply-type-c x (list 'PTS d) '(VEC m) i) (ass))))
            (dk-apply! cpl d x)
            (let ((l (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'NET-CONVERGES-TO))) "the limit") #t)))
              (dk-cite! 'net-limit-in-closed 't d x l 'a)
              (ew l)
              (dk-conj-close! (lambda () (ass)))))))))
(nt-qed! 'closed-subset-complete)

;;; ===========================================================================
;;; (8) THE NEIGHBOURHOOD NET: a point every open neighbourhood of which meets a is the limit of a net in a.
;;;     (The closure is not named: the hypothesis is the adherence condition itself.)
;;; ===========================================================================
(define nt-adh '(FORALL u (IMPLIES (IN u (OPENS t)) (IMPLIES (IN L u) (FORSOME q (AND (IN q u) (IN q a)))))))
(define nt-P '(SEP nbp_ (CARTESIAN (OPENS t) a) (AND (IN L (NTH 1 nbp_)) (IN (NTH 2 nbp_) (NTH 1 nbp_)))))
(define nt-R (list 'SEP 'nbq_ (list 'CARTESIAN nt-P nt-P) '(SUBSET (NTH 1 (NTH 2 nbq_)) (NTH 1 (NTH 1 nbq_)))))
(define nt-D (list 'LIST nt-P nt-R))
(define nt-X (list 'VNB-LAMBDA 'nbr_ nt-P '(NTH 2 nbr_)))
;; reduce every NTH of a literal list in the goal
(define (nt-has-nth-list? e) (and (pair? e) (list? e)
  (or (and (eq? (car e) 'NTH) (= (length e) 3) (pair? (caddr e)) (eq? (car (caddr e)) 'LIST)) (any-pred nt-has-nth-list? e))))
(define (nt-nth-all!) (let loop ((k 0)) (if (and (< k 10) (nt-has-nth-list? (dk-goal))) (begin (nth-r) (loop (+ k 1))))))
;; reduce every NTH of a literal list inside a hypothesis F (in context), one rewrite at a time; returns the result
(define (nt-nth-redex e)
  (cond ((not (and (pair? e) (list? e))) #f)
        ((let loop ((xs e)) (cond ((null? xs) #f) ((nt-nth-redex (car xs))) (#t (loop (cdr xs))))))
        ((and (eq? (car e) 'NTH) (= (length e) 3) (number? (cadr e)) (pair? (caddr e)) (eq? (car (caddr e)) 'LIST)
              (<= (cadr e) (length (cdr (caddr e)))))
         e)
        (#t #f)))
(define (nt-nth-h! f)
  (let loop ((f f) (k 0))
    (let ((rx (nt-nth-redex f)))
      (if (and rx (< k 12))
          (let* ((v (list-ref (caddr rx) (cadr rx)))
                 (e (list '= rx v)))
            (if (not (dk-asm? e)) (dk-have! e (lambda () (nt-nth-all!) (rfl))))
            (loop (dk-rewrite-h! f rx v) (+ k 1)))
          f))))
(define (nt-nb-open! p)                ; p in P: its four facts
  (let ((c (list 'AND (list 'IN (list 'NTH 1 p) '(OPENS t))
                 (list 'AND (list 'IN (list 'NTH 2 p) 'a)
                   (list 'AND (list 'IN 'L (list 'NTH 1 p)) (list 'IN (list 'NTH 2 p) (list 'NTH 1 p)))))))
    (if (not (dk-asm? (list 'IN 'L (list 'NTH 1 p))))
        (begin
          (dk-have! c (lambda ()
                        (sep-me (dk-ctx-form (list 'IN p nt-P))) (dk-split-all!)
                        (dk-split-all! (list (dk-cite! 'cartesian-nth p '(OPENS t) 'a)))
                        (dk-conj-close! (lambda () (ass)))))
          (dk-split-all! (list c))))))
(define (nt-nb-in! u z)                ; (LIST u z) in P from u open, z in a, L in u, z in u
  (let ((p (list 'LIST u z)))
    (if (not (dk-asm? (list 'IN p nt-P)))
        (begin
          (dk-cite! 'pair-in-cartesian '(OPENS t) 'a u z)
          (dk-have! (list 'IN p nt-P) (lambda () (in-sep! (lambda () (ass)) (lambda () (nt-nth-all!) (dk-conj-close! (lambda () (ass)))))))))
    p))
(define (nt-nb-le-in! p q)             ; (LIST p q) in R from p, q in P and (NTH 1 q) subset (NTH 1 p) (reduced forms in context)
  (dk-cite! 'pair-in-cartesian nt-P nt-P p q)
  (dk-have! (list 'IN (list 'LIST p q) nt-R) (lambda () (in-sep! (lambda () (ass)) (lambda () (nt-nth-all!) (ass))))))
(define (nt-xval! p)                   ; p in P: (= (X p) (NTH 2 p))
  (nt-nb-open! p)
  (dk-have! (list '= (list nt-X p) (list 'NTH 2 p)) (lambda () (dk-lam-b!) (rfl))))
(define (nt-nb-le-out! p q)            ; (LIST p q) in R in context: land (SUBSET (NTH 1 q) (NTH 1 p)), NTHs of literal lists reduced
  (let ((c (list 'SUBSET (list 'NTH 1 q) (list 'NTH 1 p))))
    (dk-have! c (lambda () (sep-me (dk-ctx-form (list 'IN (list 'LIST p q) nt-R))) (dk-split-all!)
                           (let ((h (dk-pick (lambda (f) (dk-head-is? f 'SUBSET)) "the order")))
                             (if (not (equal? h c)) (nt-nth-h! h)))
                           (if (not (dk-ass!)) (begin (nt-nth-all!) (ass)))))
    (nt-nth-h! c)))

(sp (make-wff (nt-alls '(t a L)
  (nt-imps (list '(IS-TOP-SPACE t) '(SUBSET a (PTS t)) '(IN L (PTS t)) nt-adh)
    '(FORSOME adn_ (FORSOME adx_ (AND (IS-DIRECTED-SET adn_) (AND (IN adx_ (FUN (PTS adn_) (PTS t)))
       (AND (FORALL adi_ (IMPLIES (IN adi_ (PTS adn_)) (IN (adx_ adi_) a))) (NET-CONVERGES-TO t adn_ adx_ L))))))))))
(dk-peel!)
(dk-project! '(IN (OPENS t) (POWER (POWER (PTS t)))) 'is-top-space '(IS-TOP-SPACE t))
(dk-project! '(IN (PTS t) (OPENS t)) 'is-top-space '(IS-TOP-SPACE t))
(let ((inter (dk-project! '(FORALL u (IMPLIES (IN u (OPENS t)) (FORALL v (IMPLIES (IN v (OPENS t)) (IN (INTERSECTION u v) (OPENS t))))))
                          'is-top-space '(IS-TOP-SPACE t)))
      (adh (dk-ctx-form nt-adh)))
  (dk-cite! 'membership-implies-sethood '(OPENS t) '(POWER (POWER (PTS t))))
  (dk-cite! 'membership-implies-sethood '(PTS t) '(OPENS t))
  (dk-cite! 'subclass-of-set-is-set 'a '(PTS t))
  (dk-have! '(IN (CARTESIAN (OPENS t) a) SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
  (dk-have! (list 'IN nt-P 'SET) (lambda () (sep-set) (ass)))
  (dk-have! (list 'IN (list 'CARTESIAN nt-P nt-P) 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
  (dk-have! (list 'IN nt-R 'SET) (lambda () (sep-set) (ass)))
  (dk-have! (list '== (list 'PTS nt-D) nt-P) (lambda () (slot 'PTS) (nth-r) (qrfl)))
  (dk-have! (list '== (list 'DLEQ nt-D) nt-R) (lambda () (slot 'DLEQ) (nth-r) (qrfl)))
  ;; the directed set
  (dk-have! (list 'IS-DIRECTED-SET nt-D)
    (lambda ()
      (mac 'is-directed-set)
      (subst (list '== (list 'PTS nt-D) nt-P))
      (subst (list '== (list 'DLEQ nt-D) nt-R))
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-ass!) #t)
              ((dk-contains? g 'LENGTH) (len-r) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (arith)))
              ((dk-head-is? g 'FORSOME)
               (dk-apply! adh '(PTS t))
               (let ((z (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f '(PTS t)))) "the meet") #t)))
                 (ew (nt-nb-in! '(PTS t) z)) (ass)))
              ((dk-contains? g 'POWER)
               (let ((cc (list 'CARTESIAN nt-P nt-P)))
                 (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ nt-R) (list 'IN 'z_ cc)))
                   (lambda () (let ((z (dk-di-var!))) (sep-me (dk-ctx-form (list 'IN z nt-R))) (dk-split-all!) (ass))))
                 (dk-cite! 'power-mem-intro cc nt-R)
                 (dk-ass!)))
              ((dk-head-is? g 'FORALL)
               (let* ((ld (dk-peel!))
                      (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) nt-P))) ld))))
                 (for-each nt-nb-open! vs)
                 (cond ((= (length vs) 1)
                        (dk-cite! 'subset-refl (list 'NTH 1 (car vs)))
                        (nt-nb-le-in! (car vs) (car vs)))
                       ((= (length vs) 3)
                        (let ((p (car vs)) (q (cadr vs)) (r (caddr vs)))
                          (nt-nb-le-out! p q) (nt-nb-le-out! q r)
                          (dk-cite! 'subset-trans (list 'NTH 1 r) (list 'NTH 1 q) (list 'NTH 1 p))
                          (nt-nb-le-in! p r)))
                       (#t
                        (let* ((p (car vs)) (q (cadr vs)) (u (list 'INTERSECTION (list 'NTH 1 p) (list 'NTH 1 q))))
                          (dk-apply! inter (list 'NTH 1 p) (list 'NTH 1 q))
                          (let ((im (dk-cite! 'intersection-membership (list 'NTH 1 p) (list 'NTH 1 q) 'L)))
                            (dk-have! (list 'IN 'L u) (lambda () (if (dk-only! im (list 'IN 'L (list 'NTH 1 p)) (list 'IN 'L (list 'NTH 1 q))) (prop)))))
                          (dk-apply! adh u)
                          (let* ((z (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f u))) "the meet") #t))
                                 (k (nt-nb-in! u z)))
                            (dk-have! (list 'SUBSET u (list 'NTH 1 p))
                              (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (dk-cite! 'intersection-membership (list 'NTH 1 p) (list 'NTH 1 q) w)
                                                                (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop)))))
                            (dk-have! (list 'SUBSET u (list 'NTH 1 q))
                              (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (dk-cite! 'intersection-membership (list 'NTH 1 p) (list 'NTH 1 q) w)
                                                                (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop)))))
                            (nt-nb-le-in! p k) (nt-nb-le-in! q k)
                            (ew k) (dk-conj-close! (lambda () (ass)))))))))
              (#t (error "nbhd net: unexpected conjunct" (expression->string g)))))))))
  ;; the net
  (dk-have! (list 'IN nt-X (list 'FUN nt-P '(PTS t)))
    (lambda () (dk-lam-type! (lambda () (let ((p (dk-di-var!))) (nt-nb-open! p) (dk-cite! 'subset-mem-fwd 'a '(PTS t) (list 'NTH 2 p)) (ass)))
                             (lambda () (ass)))))
  (dk-have! (list 'IN nt-X (list 'FUN (list 'PTS nt-D) '(PTS t))) (lambda () (subst (list '== (list 'PTS nt-D) nt-P)) (ass)))
  (ew nt-D)
  (ew nt-X)
  (subst (list '== (list 'PTS nt-D) nt-P))
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? (dk-goal) 'FORALL)
         (let ((p (dk-di-var!))) (nt-xval! p) (subst (list '= (list nt-X p) (list 'NTH 2 p))) (ass)))
        (#t
         (nt-conv-intro!
           (lambda (u)
             (dk-apply! adh u)
             (let* ((z (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f u) (dk-contains? f 'a))) "the meet") #t))
                    (i0 (nt-nb-in! u z)))
               (dk-have! (list 'IN i0 (list 'PTS nt-D)) (lambda () (subst (list '== (list 'PTS nt-D) nt-P)) (ass)))
               (nt-ev-intro! nt-D nt-X u i0
                 (lambda (j)
                   (dk-rewrite-h! (list 'IN j (list 'PTS nt-D)) (list 'PTS nt-D) nt-P)
                   (dk-rewrite-h! (list 'IN (list 'LIST i0 j) (list 'DLEQ nt-D)) (list 'DLEQ nt-D) nt-R)
                   (nt-nb-le-out! i0 j)
                   (nt-xval! j)
                   (subst (list '= (list nt-X j) (list 'NTH 2 j)))
                   (dk-cite! 'subset-mem-fwd (list 'NTH 1 j) u (list 'NTH 2 j))
                   (ass)))))))))))
(nt-qed! 'adherent-point-net)

;;; a complete subset of a (Hausdorff) topological vector space is closed
(sp (make-wff (nt-alls '(m t a) (nt-imps (list nt-tvs '(IS-COMPLETE-SUBSET m t a)) '(IS-TOP-CLOSED t a)))))
(dk-peel!)
(nt-tvs-parts!)
(let* ((cs '(IS-COMPLETE-SUBSET m t a))
       (sub (dk-project! '(SUBSET a (VEC m)) 'is-complete-subset cs))
       (cpl (dk-project! '(FORALL csd_ (FORALL csx_ (IMPLIES (IS-CAUCHY-NET m t csd_ csx_)
                            (IMPLIES (FORALL csi_ (IMPLIES (IN csi_ (PTS csd_)) (IN (csx_ csi_) a)))
                              (FORSOME csl_ (AND (IN csl_ a) (NET-CONVERGES-TO t csd_ csx_ csl_)))))))
                         'is-complete-subset cs))
       (co '(COMPLEMENT-IN (PTS t) a)))
  (dk-have! '(SUBSET a (PTS t)) (lambda () (subst '(== (PTS t) (VEC m))) (ass)))
  (dk-have! (list 'SUBSET co '(PTS t))
    (lambda () (mac 'subset-def) (let* ((z (dk-di-var!)) (im (dk-cite! 'complement-in-membership '(PTS t) 'a z)))
                                   (if (dk-only! im (list 'IN z co)) (prop)))))
  (dk-have! (list 'FORALL 'tlx_ (list 'IMPLIES (list 'IN 'tlx_ co)
              (list 'FORSOME 'tlw_ (list 'AND '(IN tlw_ (OPENS t)) (list 'AND '(IN tlx_ tlw_) (list 'SUBSET 'tlw_ co))))))
    (lambda ()
      (let* ((z (dk-di-var!))
             (im (dk-cite! 'complement-in-membership '(PTS t) 'a z))
             (q (list 'FORSOME 'ccu_ (list 'AND '(IN ccu_ (OPENS t)) (list 'AND (list 'IN z 'ccu_)
                  (list 'FORALL 'ccq_ (list 'IMPLIES '(IN ccq_ ccu_) '(NOT (IN ccq_ a)))))))))
        (dk-have! (list 'AND (list 'IN z '(PTS t)) (list 'NOT (list 'IN z 'a))) (lambda () (if (dk-only! im (list 'IN z co)) (prop))))
        (dk-split! (list 'AND (list 'IN z '(PTS t)) (list 'NOT (list 'IN z 'a))))
        (use-em q
          (lambda ()
            (let* ((u (dk-skolem! (dk-ctx-form q) #t))
                   (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f u) (dk-contains? f 'a))) "the clause")))
              (ew u)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin
                        (mac 'subset-def)
                        (let ((w (dk-di-var!)))
                          (dk-cite! 'power-mem-in '(POWER (PTS t)) '(OPENS t) u)
                          (dk-cite! 'power-mem-in '(PTS t) u w)
                          (dk-apply! cl w)
                          (let ((im2 (dk-cite! 'complement-in-membership '(PTS t) 'a w)))
                            (if (dk-only! im2 (list 'IN w '(PTS t)) (list 'NOT (list 'IN w 'a))) (prop))))))))))
          (lambda ()
            (pbc)
            (let ((adh (list 'FORALL 'u (list 'IMPLIES '(IN u (OPENS t)) (list 'IMPLIES (list 'IN z 'u)
                         '(FORSOME q (AND (IN q u) (IN q a))))))))
              (dk-have! adh
                (lambda ()
                  (let ((u (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(OPENS t)))) (dk-peel!))))))
                    (pbc)
                    (dk-have! q
                      (lambda ()
                        (ew u)
                        (dk-conj-close!
                          (lambda ()
                            (if (not (dk-ass!))
                                (let ((w (dk-di-var!)))
                                  (di)
                                  (dk-have! (list 'FORSOME 'q (list 'AND (list 'IN 'q u) '(IN q a))) (lambda () (ew w) (dk-conj-close! (lambda () (ass)))))
                                  (ai (list 'NOT (list 'FORSOME 'q (list 'AND (list 'IN 'q u) '(IN q a)))))))))))
                    (ai (list 'NOT q)))))
              (dk-cite! 'adherent-point-net 't 'a z)
              (let* ((d (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'adx_))) "the net") 'top))
                     (x (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f d))) "the net map") #t))
                     (cv (nt-conv 't d x z)))
                (dk-cite! 'tvs-convergent-net-cauchy 'm 't d x z)
                (dk-apply! cpl d x)
                (let ((l (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'csl_))) "the limit") #t)))
                  (dk-cite! 'net-limit-unique 't d x z l)
                  (dk-rewrite-h! (list 'IN l 'a) l z)
                  (ai (list 'NOT (list 'IN z 'a)))))))))))
  (dk-cite! 'top-open-of-local 't co)
  (mac 'is-top-closed)
  (dk-conj-close! (lambda () (ass))))
(nt-qed! 'complete-subset-closed)

;;; ===========================================================================
;;; (9) TB-12, Lemma A.14: the pointwise limits of nets in an equicontinuous set form an equicontinuous set
;;; ===========================================================================
(define nt-PL '(PTWISE-NET-LIMITS t ee))
(define nt-PLB '(SEP pwf_ (FUN (PTS t) RR)
     (FORSOME pwd_ (FORSOME pwp_ (AND (IN pwd_ DIRECTED-SET) (AND (IS-DIRECTED-SET pwd_) (AND (IN pwp_ (FUN (PTS pwd_) ee))
       (FORALL pwx_ (IMPLIES (IN pwx_ (PTS t))
         (NET-CONVERGES-TO (METRIC-TOP RR-MS) pwd_ (VNB-LAMBDA pwl_ (PTS pwd_) ((pwp_ pwl_) pwx_)) (pwf_ pwx_)))))))))))
(sp (make-wff (list 'FORALL 't (list 'FORALL 'ee (list '== nt-PL nt-PLB)))))
(dk-peel!)
(mac 'PTWISE-NET-LIMITS)
(qrfl)
(nt-qed! 'ptwise-net-limits-unfold)

(define (nt-eval-net d phi p) (list 'VNB-LAMBDA 'pwl_ (list 'PTS d) (list (list phi 'pwl_) p)))
;; NET-CONVERGES-TO(METRIC-TOP RR-MS, d, z, c) in context, e POS-RR: (i0 . tail) for the ball of radius e about c
(define (nt-rr-ev! d z c e)
  (dk-cite! 'rr-is-metric-space)
  (dk-cite! 'r7q-rr-pts)
  (let* ((cv (list 'NET-CONVERGES-TO '(METRIC-TOP RR-MS) d z c)))
    (dk-project! (list 'IN z (list 'FUN (list 'PTS d) '(PTS (METRIC-TOP RR-MS)))) 'net-converges-to cv)
    (dk-project! (list 'IN c '(PTS (METRIC-TOP RR-MS))) 'net-converges-to cv)
    (dk-cite! 'metric-top-pts 'RR-MS)
    (dk-rewrite-h! (list 'IN z (list 'FUN (list 'PTS d) '(PTS (METRIC-TOP RR-MS)))) '(PTS (METRIC-TOP RR-MS)) '(PTS RR-MS))
    (dk-rewrite-h! (list 'IN c '(PTS (METRIC-TOP RR-MS))) '(PTS (METRIC-TOP RR-MS)) '(PTS RR-MS))
    (let* ((iff (dk-cite! 'metric-net-converges-iff 'RR-MS d z c))
           (bc (caddr iff)))
      (dk-have! bc (lambda () (if (dk-only! iff cv) (prop))))
      (dk-apply! bc e)
      (nt-ev-open! d z (list 'BALL 'RR-MS c e)))))
;; z(k) in BALL(RR-MS, c, e), with z(k) = v: land (< (abs (- c v)) e)
(define (nt-rr-ball-out! zk v c e)
  (let ((bm (dk-cite! 'ball-membership 'RR-MS c e zk)))
    (dk-have! (caddr bm) (lambda () (if (dk-only! bm (list 'IN zk (list 'BALL 'RR-MS c e))) (prop))))
    (dk-split-all! (list (caddr bm)))
    (let* ((dd (list '(DIST RR-MS) c zk))
           (ad (list 'abs (list '- c v))))
      (dk-rewrite-h! (list 'IN zk '(PTS RR-MS)) '(PTS RR-MS) 'RR)
      (dk-cite! 'rr-ms-dist c zk)
      (dk-cite! 'rr-sub-in-rr c zk) (dk-cite! 'rr-abs-closed (list '- c zk))
      (let* ((h1 (dk-rewrite-h! (list '<= dd e) dd (list 'abs (list '- c zk))))
             (h2 (dk-rewrite-h! (list 'NOT (list '= dd e)) dd (list 'abs (list '- c zk))))
             (h3 (dk-rewrite-h! h1 zk v))
             (h4 (dk-rewrite-h! h2 zk v)))
        (dk-cite! 'rr-sub-in-rr c v) (dk-cite! 'rr-abs-closed (list '- c v))
        (dk-cite! 'rr-le-ne-lt ad e)
        (dk-have! (list '< ad e)
          (lambda () (dk-have! (list 'NOT (list '= ad e)) (lambda () (ass)))
                     (dk-have! (list 'AND (list '<= ad e) (list 'NOT (list '= ad e))) (lambda () (dk-conj-close! (lambda () (ass)))))
                     (dk-cite! 'rr-le-ne-lt ad e) (dk-ass!)))))))

(sp (make-wff (nt-alls '(t ee) (nt-imps '((IS-TOP-SPACE t) (IS-EQUICONTINUOUS-T t ee)) (list 'IS-EQUICONTINUOUS-T 't nt-PL)))))
(dk-peel!)
(dk-cite! 'ptwise-net-limits-unfold 't 'ee)
(let* ((ec '(IS-EQUICONTINUOUS-T t ee))
       (esub (dk-project! '(SUBSET ee (FUN (PTS t) RR)) 'IS-EQUICONTINUOUS-T ec))
       (ecl (dk-project! '(FORALL eqx_ (IMPLIES (IN eqx_ (PTS t)) (FORALL eqe_ (IMPLIES (POS-RR eqe_)
                             (FORSOME eqv_ (AND (IN eqv_ (OPENS t)) (AND (IN eqx_ eqv_)
                               (FORALL eqf_ (IMPLIES (IN eqf_ ee) (FORALL eqy_ (IMPLIES (IN eqy_ eqv_)
                                 (< (abs (- (eqf_ eqx_) (eqf_ eqy_))) eqe_))))))))))))
                         'IS-EQUICONTINUOUS-T ec)))
  (dk-project! '(IN (OPENS t) (POWER (POWER (PTS t)))) 'is-top-space '(IS-TOP-SPACE t))
  (mac 'IS-EQUICONTINUOUS-T)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'SUBSET)
          (begin (subst (list '== nt-PL nt-PLB)) (mac 'subset-def)
                 (let ((w (dk-di-var!))) (sep-me (dk-ctx-form (list 'IN w nt-PLB))) (dk-split-all!) (ass)))
          (let* ((ld (dk-peel!))
                 (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(PTS t)))) ld)))
                 (e (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) ld)))
                 (h (list '* 1/2 e)) (r8 (list '* 1/8 e)))
            (dk-pos-parts! e)
            (dk-real! h) (dk-real! r8)
            (dk-have! (list '< 0 h) (lambda () (dk-ineq! (list '< 0 e) (list 'IN e 'RR))))
            (dk-have! (list '< 0 r8) (lambda () (dk-ineq! (list '< 0 e) (list 'IN e 'RR))))
            (dk-cite! 'rr-pos-rr-of-lt h) (dk-cite! 'rr-pos-rr-of-lt r8)
            (let* ((v (dk-skolem! (dk-apply! ecl x h) #t))
                   (vcl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f v) (dk-contains? f 'ee))) "the equicontinuity clause")))
              (ew v)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (let* ((ld2 (dk-peel!))
                             (f (cadr (find-first (lambda (g) (and (dk-head-is? g 'IN) (equal? (caddr g) nt-PL))) ld2)))
                             (y (cadr (find-first (lambda (g) (and (dk-head-is? g 'IN) (equal? (caddr g) v))) ld2))))
                        (dk-rewrite-h! (list 'IN f nt-PL) nt-PL nt-PLB)
                        (sep-me (list 'IN f nt-PLB)) (dk-split-all!)
                        (let* ((d (dk-skolem! (dk-pick (lambda (g) (and (dk-head-is? g 'FORSOME) (dk-contains? g 'pwp_))) "the net") 'top))
                               (phi (dk-skolem! (dk-pick (lambda (g) (and (dk-head-is? g 'FORSOME) (dk-contains? g d))) "the family") #t))
                               (pwc (dk-pick (lambda (g) (and (dk-head-is? g 'FORALL) (dk-contains? g phi) (dk-contains? g 'NET-CONVERGES-TO))) "pointwise")))
                          (dk-cite! 'power-mem-in '(POWER (PTS t)) '(OPENS t) v)
                          (dk-cite! 'power-mem-in '(PTS t) v y)
                          (dk-apply! pwc x) (dk-apply! pwc y)
                          (let* ((zx (nt-eval-net d phi x)) (zy (nt-eval-net d phi y))
                                 (fx (list f x)) (fy (list f y))
                                 (p1 (nt-rr-ev! d zx fx r8)) (i1 (car p1)) (t1 (cdr p1))
                                 (p2 (nt-rr-ev! d zy fy r8)) (i2 (car p2)) (t2 (cdr p2))
                                 (k (nt-upper! d i1 i2))
                                 (zxk (list zx k)) (zyk (list zy k))
                                 (g (list phi k)) (gx (list g x)) (gy (list g y)))
                            (dk-apply! t1 k) (dk-apply! t2 k)
                            (dk-cite! 'fun-apply-type-c phi (list 'PTS d) 'ee k)
                            (dk-cite! 'subset-mem-fwd 'ee '(FUN (PTS t) RR) g)
                            (dk-cite! 'fun-apply-type-c g '(PTS t) 'RR x)
                            (dk-cite! 'fun-apply-type-c g '(PTS t) 'RR y)
                            (dk-cite! 'fun-apply-type-c f '(PTS t) 'RR x)
                            (dk-cite! 'fun-apply-type-c f '(PTS t) 'RR y)
                            (dk-have! (list '= zxk gx) (lambda () (dk-lam-b!) (rfl)))
                            (dk-have! (list '= zyk gy) (lambda () (dk-lam-b!) (rfl)))
                            (nt-rr-ball-out! zxk gx fx r8)
                            (nt-rr-ball-out! zyk gy fy r8)
                            (dk-apply! vcl g y)
                            (for-each (lambda (pr)
                                        (let ((u (car pr)) (r (cdr pr)))
                                          (dk-real! u)
                                          (dk-split-all! (list (dk-cite! 'rr-abs-lt-parts u r)))))
                                      (list (cons (list '- fx gx) r8) (cons (list '- fy gy) r8) (cons (list '- gx gy) h)))
                            (let ((dfy (list '- fx fy)))
                              (dk-real! dfy)
                              (dk-have! (list '< (list '- e) dfy)
                                (lambda () (dk-ineq! (list '< (list '- r8) (list '- fx gx)) (list '< (list '- fy gy) r8) (list '< (list '- h) (list '- gx gy))
                                                     (list '< 0 e) (list 'IN fx 'RR) (list 'IN fy 'RR) (list 'IN gx 'RR) (list 'IN gy 'RR) (list 'IN e 'RR))))
                              (dk-have! (list '< dfy e)
                                (lambda () (dk-ineq! (list '< (list '- fx gx) r8) (list '< (list '- r8) (list '- fy gy)) (list '< (list '- gx gy) h)
                                                     (list '< 0 e) (list 'IN fx 'RR) (list 'IN fy 'RR) (list 'IN gx 'RR) (list 'IN gy 'RR) (list 'IN e 'RR))))
                              (dk-cite! 'rr-abs-lt-of-parts dfy e)
                              (dk-ass!))))))))))))))
(nt-qed! 'ptwise-limits-equicontinuous)

;;; ===========================================================================
;;; (9b) a FINITE family of eventual properties holds simultaneously eventually: with r an upward-closed set of
;;;      pairs [w, i], a finite set g each member of which has some index, has one common index.
;;; ===========================================================================
(define nt-fb-up '(FORALL fbw_ (FORALL fbi_ (FORALL fbk_ (IMPLIES (IN (LIST fbw_ fbi_) r) (IMPLIES (IN fbk_ (PTS d))
                    (IMPLIES (IN (LIST fbi_ fbk_) (DLEQ d)) (IN (LIST fbw_ fbk_) r))))))))
(define (nt-fb-body g)
  (list 'IMPLIES (list 'FORALL 'fbu_ (list 'IMPLIES (list 'IN 'fbu_ g) (list 'FORSOME 'fbj_ (list 'AND '(IN fbj_ (PTS d)) '(IN (LIST fbu_ fbj_) r)))))
        (list 'FORSOME 'fbm_ (list 'AND '(IN fbm_ (PTS d)) (list 'FORALL 'fbv_ (list 'IMPLIES (list 'IN 'fbv_ g) '(IN (LIST fbv_ fbm_) r)))))))
(define nt-fb-cls (list 'COMP 'fbg_ (nt-fb-body 'fbg_)))
(sp (make-wff (nt-alls '(d r) (nt-imps (list '(IS-DIRECTED-SET d) nt-fb-up)
   (list 'FORALL 'fbs_ (list 'IMPLIES '(IN fbs_ SET) (list 'IMPLIES '(IN (CARD fbs_) NN) (nt-fb-body 'fbs_))))))))
(dk-peel!)
(let ((up (dk-ctx-form nt-fb-up)))
  ;; base
  (dk-have! (list 'IN 'EMPTY-SET nt-fb-cls)
    (lambda ()
      (for-each
        (lambda (l)
          (dk-focus! l)
          (if (dk-head-is? (dk-goal) 'IN)
              (begin (fact 'empty-set-is-set) (ass))
              (begin
                (di)
                (let ((i0 (dk-skolem! (dk-cite! 'ds-nonempty 'd) #t)))
                  (ew i0)
                  (dk-conj-close!
                    (lambda ()
                      (if (not (dk-ass!))
                          (let ((w (dk-di-var!)))
                            (pbc)
                            (fact 'empty-set-has-no-members w)
                            (ai (list 'NOT (list 'IN w 'EMPTY-SET)))))))))))
        (dk-opened (lambda () (comp-mi))))))
  ;; step
  (dk-have! (list 'FORALL 'fbs_ (list 'IMPLIES (list 'AND '(IN fbs_ SET) (list 'AND '(IN (CARD fbs_) NN) (list 'IN 'fbs_ nt-fb-cls)))
              (list 'FORALL 'fbx_ (list 'IMPLIES '(AND (IN fbx_ SET) (NOT (IN fbx_ fbs_))) (list 'IN '(UNION fbs_ (PAIR fbx_ fbx_)) nt-fb-cls)))))
    (lambda ()
      (dk-peel!)
      (dk-split-all!)
      (let* ((g0 (dk-goal)) (un (cadr g0)) (s (cadr un)) (x (cadr (caddr un))) (px (list 'PAIR x x)))
        (nt-and! (list 'IN x 'SET) (list 'IN x 'SET))
        (fact 'pairing x x)
        (nt-and! (list 'IN s 'SET) (list 'IN px 'SET))
        (fact 'union-set-closure s px)
        (dk-cite! 'pair-self-member x)
        (comp-me (list 'IN s nt-fb-cls))
        (let ((ih (dk-pick (lambda (h) (and (dk-head-is? h 'IMPLIES) (dk-contains? h s) (dk-contains? h 'fbm_))) "IH")))
          (for-each
            (lambda (l)
              (dk-focus! l)
              (if (dk-head-is? (dk-goal) 'IN)
                  (ass)
                  (let ((hyp (car (dk-peel!))))
                    ;; every member of s has an index, so the IH applies
                    (dk-have! (cadr ih)
                      (lambda ()
                        (let ((w (dk-di-var!)))
                          (let ((im (dk-cite! 'union-membership s px w)))
                            (dk-have! (list 'IN w un) (lambda () (if (dk-only! im (list 'IN w s)) (prop)))))
                          (dk-apply! hyp w)
                          (dk-ass!))))
                    (detach! ih)
                    (let* ((m1 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'fbm_) (dk-contains? h s))) "IH result") #t))
                           (t1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m1))) "IH tail")))
                      (let ((im (dk-cite! 'union-membership s px x)))
                        (dk-have! (list 'IN x un) (lambda () (if (dk-only! im (list 'IN x px)) (prop)))))
                      (dk-apply! hyp x)
                      (let* ((m2 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'fbj_) (dk-contains? h x))) "x index") #t))
                             (mu (nt-upper! 'd m1 m2)))
                        (ew mu)
                        (dk-conj-close!
                          (lambda ()
                            (if (not (dk-ass!))
                                (let* ((w (dk-di-var!))
                                       (umm (dk-cite! 'union-membership s px w)))
                                  (use-em (list 'IN w s)
                                    (lambda () (dk-apply! t1 w) (dk-apply! up w m1 mu) (dk-ass!))
                                    (lambda ()
                                      (dk-have! (list 'IN w px) (lambda () (if (dk-only! umm (list 'IN w un) (list 'NOT (list 'IN w s))) (prop))))
                                      (let ((pm (dk-cite! 'pairing-membership x x w)))
                                        (dk-have! (list '= w x) (lambda () (if (dk-only! pm (list 'IN w px)) (prop)))))
                                      (subst (list '= w x))
                                      (dk-apply! up x m2 mu)
                                      (dk-ass!))))))))))))
            (dk-opened (lambda () (comp-mi))))))))
  (nt-and! (list 'IN 'EMPTY-SET nt-fb-cls)
           (list 'FORALL 'fbs_ (list 'IMPLIES (list 'AND '(IN fbs_ SET) (list 'AND '(IN (CARD fbs_) NN) (list 'IN 'fbs_ nt-fb-cls)))
              (list 'FORALL 'fbx_ (list 'IMPLIES '(AND (IN fbx_ SET) (NOT (IN fbx_ fbs_))) (list 'IN '(UNION fbs_ (PAIR fbx_ fbx_)) nt-fb-cls))))))
  (let* ((ind (dk-fact! 'finite-set-induction nt-fb-cls))
         (sv (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'SET))) (dk-asms))))))
    (nt-and! (list 'IN sv 'SET) (list 'IN (list 'CARD sv) 'NN))
    (let ((int (dk-apply! ind sv)))
      (comp-me int)
      (detach! (dk-pick (lambda (h) (and (dk-head-is? h 'IMPLIES) (dk-contains? h 'fbm_) (dk-contains? h sv))) "the instance"))
      (dk-ass!))))
(nt-qed! 'directed-finite-common-index)

;;; ===========================================================================
;;; (10) TB-12, Proposition A.15 (one direction): on an equicontinuous set, a net converging pointwise to a member
;;;      of the set converges uniformly on every compact set.  (Uniform convergence on k gives convergence at each
;;;      point of k by unif-conv-on-pointwise.)  Hausdorff is not needed.
;;; ===========================================================================
(define (nt-a15-bound e w m)
  (list 'FORALL 'ucl_ (list 'IMPLIES '(IN ucl_ (PTS d)) (list 'IMPLIES (nt-le 'd m 'ucl_)
    (list 'FORALL 'ucy_ (list 'IMPLIES (list 'IN 'ucy_ w) (list '< '(abs (- ((p ucl_) ucy_) (f ucy_))) e)))))))
(define (nt-a15-C e)
  (list 'SEP 'ucw_ '(POWER k)
    (list 'AND '(FORSOME ucv_ (AND (IN ucv_ (OPENS t)) (= ucw_ (INTERSECTION ucv_ k))))
               (list 'FORSOME 'ucm_ (list 'AND '(IN ucm_ (PTS d)) (nt-a15-bound e 'ucw_ 'ucm_))))))
(define (nt-a15-body e g)
  (list 'IMPLIES (list 'SUBSET g (nt-a15-C e))
        (list 'FORSOME 'ucn_ (list 'AND '(IN ucn_ (PTS d)) (nt-a15-bound e (list 'BIG-UNION 'u g 'u) 'ucn_)))))
(define (nt-a15-cls e) (list 'COMP 'ucg_ (nt-a15-body e 'ucg_)))
(define nt-pwc '(FORALL pwx_ (IMPLIES (IN pwx_ (PTS t))
                  (NET-CONVERGES-TO (METRIC-TOP RR-MS) d (VNB-LAMBDA pwl_ (PTS d) ((p pwl_) pwx_)) (f pwx_)))))
(define nt-ecl '(FORALL eqx_ (IMPLIES (IN eqx_ (PTS t)) (FORALL eqe_ (IMPLIES (POS-RR eqe_)
                  (FORSOME eqv_ (AND (IN eqv_ (OPENS t)) (AND (IN eqx_ eqv_)
                    (FORALL eqf_ (IMPLIES (IN eqf_ ee) (FORALL eqy_ (IMPLIES (IN eqy_ eqv_)
                      (< (abs (- (eqf_ eqx_) (eqf_ eqy_))) eqe_)))))))))))))
;; |a - b| < r1, |b - c| < r2 ... : the abs bounds linearised; then |u| < e from linear bounds
(define (nt-abs-parts! u r) (dk-real! u) (dk-split-all! (list (dk-cite! 'rr-abs-lt-parts u r))))
(define (nt-a15-tri! gz gy fz fy e3 e)  ; |gz - gy| < e3, |fz - fy| < e3, |fz - gz| < e3 in context: |gy - fy| < e
  (nt-abs-parts! (list '- gz gy) e3) (nt-abs-parts! (list '- fz fy) e3) (nt-abs-parts! (list '- fz gz) e3)
  (let ((u (list '- gy fy)) (ps (list (list 'IN gz 'RR) (list 'IN gy 'RR) (list 'IN fz 'RR) (list 'IN fy 'RR) (list 'IN e 'RR) (list '< 0 e))))
    (dk-real! u)
    (dk-have! (list '< (list '- e) u)
      (lambda () (apply dk-ineq! (append (list (list '< (list '- gz gy) e3) (list '< (list '- e3) (list '- fz fy)) (list '< (list '- fz gz) e3)) ps))))
    (dk-have! (list '< u e)
      (lambda () (apply dk-ineq! (append (list (list '< (list '- e3) (list '- gz gy)) (list '< (list '- fz fy) e3) (list '< (list '- e3) (list '- fz gz))) ps))))
    (dk-cite! 'rr-abs-lt-of-parts u e)))

(sp (make-wff (nt-alls '(t ee d p f k)
  (nt-imps (list '(IS-TOP-SPACE t) '(IS-EQUICONTINUOUS-T t ee) '(IS-DIRECTED-SET d) '(IN p (FUN (PTS d) ee)) '(IN f ee)
                 nt-pwc '(SUBSET k (PTS t)) '(IS-COMPACT-T (SUBSPACE-TOP t k)))
    '(NET-UNIF-CONV-ON d p f k)))))
(dk-peel!)
(let* ((ec '(IS-EQUICONTINUOUS-T t ee))
       (esub (dk-project! '(SUBSET ee (FUN (PTS t) RR)) 'IS-EQUICONTINUOUS-T ec))
       (ecl (dk-project! nt-ecl 'IS-EQUICONTINUOUS-T ec))
       (pwc (dk-ctx-form nt-pwc))
       (sk '(SUBSPACE-TOP t k)))
  (dk-project! '(IN (OPENS t) (POWER (POWER (PTS t)))) 'is-top-space '(IS-TOP-SPACE t))
  (dk-project! '(IN (PTS t) (OPENS t)) 'is-top-space '(IS-TOP-SPACE t))
  (dk-cite! 'membership-implies-sethood '(PTS t) '(OPENS t))
  (dk-cite! 'subclass-of-set-is-set 'k '(PTS t))
  (dk-cite! 'power-set 'k)
  (dk-cite! 'subspace-top-pts 't 'k)
  (dk-cite! 'subspace-top-opens 't 'k)
  (dk-cite! 'subset-mem-fwd 'ee '(FUN (PTS t) RR) 'f)
  (let ((cmp (dk-project! (list 'FORALL 'c (list 'IMPLIES (list 'FORALL 'u (list 'IMPLIES '(IN u c) (list 'IN 'u (list 'OPENS sk))))
                                             (list 'IMPLIES (list '== '(BIG-UNION u c u) (list 'PTS sk))
                                               (list 'FORSOME 'f_ (list 'AND '(SUBSET f_ c) (list 'AND '(IN (CARD f_) NN)
                                                 (list '== '(BIG-UNION u f_ u) (list 'PTS sk))))))))
                          'is-compact-t (list 'IS-COMPACT-T sk))))
    (mac 'net-unif-conv-on)
    (let* ((e (cadr (find-first (lambda (g) (dk-head-is? g 'POS-RR)) (dk-peel!))))
           (e3 (list '* 1/3 e))
           (cc (nt-a15-C e))
           (bu (list 'BIG-UNION 'u cc 'u))
           (cls (nt-a15-cls e)))
      (dk-pos-parts! e)
      (dk-real! e3)
      (dk-have! (list '< 0 e3) (lambda () (dk-ineq! (list '< 0 e) (list 'IN e 'RR))))
      (dk-cite! 'rr-pos-rr-of-lt e3)
      (dk-have! (list 'IN cc 'SET) (lambda () (sep-set) (ass)))
      ;; 1. the members of C are open in the subspace
      (dk-have! (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u cc) (list 'IN 'u (list 'OPENS sk))))
        (lambda ()
          (let ((w (dk-di-var!)))
            (sep-me (dk-ctx-form (list 'IN w cc))) (dk-split-all!)
            (subst (list '== (list 'OPENS sk) '(SEP stw_ (POWER k) (FORSOME stu_ (AND (IN stu_ (OPENS t)) (= stw_ (INTERSECTION stu_ k)))))))
            (in-sep! (lambda () (ass)) (lambda () (ass))))))
      ;; 2. C covers k
      (dk-have! (list 'FORALL 'ubz_ (list 'IFF (list 'IN 'ubz_ bu) '(IN ubz_ k)))
        (lambda ()
          (let ((z (begin (di) (cadr (cadr (dk-goal))))))
            (dk-iff! (lambda (g) (equal? g (list 'IN z 'k)))
              (lambda ()
                (let* ((ld (dk-landed (lambda () (bu-me (list 'IN z bu)))))
                       (w (cadr (find-first (lambda (g) (and (dk-head-is? g 'IN) (equal? (caddr g) cc))) ld))))
                  (dk-have! (list 'IN w '(POWER k)) (lambda () (sep-me (dk-ctx-form (list 'IN w cc))) (dk-split-all!) (ass)))
                  (dk-cite! 'power-mem-in 'k w z)
                  (ass)))
              (lambda ()
                (dk-cite! 'subset-mem-fwd 'k '(PTS t) z)
                (let* ((v (dk-skolem! (dk-apply! ecl z e3) #t))
                       (vcl (dk-pick (lambda (g) (and (dk-head-is? g 'FORALL) (dk-contains? g v) (dk-contains? g 'ee))) "the equicontinuity clause"))
                       (zn (nt-eval-net 'd 'p z))
                       (pr (begin (dk-apply! pwc z) (nt-rr-ev! 'd zn (list 'f z) e3)))
                       (i0 (car pr)) (tl (cdr pr))
                       (w (list 'INTERSECTION v 'k)))
                  (dk-cite! 'power-mem-in '(POWER (PTS t)) '(OPENS t) v)
                  (dk-have! (list 'OR (list 'IN v 'SET) '(IN k SET)) (lambda () (dk-only! '(IN k SET)) (prop)))
                  (dk-cite! 'intersection-set-closure v 'k)
                  (dk-have! (list 'IN w '(POWER k))
                    (lambda ()
                      (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ w) '(IN z_ k)))
                        (lambda () (let* ((q (dk-di-var!)) (im (dk-cite! 'intersection-membership v 'k q)))
                                     (if (dk-only! im (list 'IN q w)) (prop)))))
                      (dk-cite! 'power-mem-intro 'k w)
                      (dk-ass!)))
                  (dk-have! (list 'IN w cc)
                    (lambda ()
                      (in-sep! (lambda () (ass))
                        (lambda ()
                          (dk-conj-close!
                            (lambda ()
                              (if (dk-contains? (dk-goal) 'ucv_)
                                  (begin (ew v) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl)))))
                                  (begin
                                    (ew i0)
                                    (dk-conj-close!
                                      (lambda ()
                                        (if (not (dk-ass!))
                                            (let* ((ld (dk-peel!))
                                                   (lam (cadr (find-first (lambda (g) (and (dk-head-is? g 'IN) (equal? (caddr g) '(PTS d)))) ld)))
                                                   (y (cadr (find-first (lambda (g) (and (dk-head-is? g 'IN) (equal? (caddr g) w))) ld)))
                                                   (g (list 'p lam))
                                                   (im (dk-cite! 'intersection-membership v 'k y)))
                                              (dk-have! (list 'IN y v) (lambda () (if (dk-only! im (list 'IN y w)) (prop))))
                                              (dk-have! (list 'IN y 'k) (lambda () (if (dk-only! im (list 'IN y w)) (prop))))
                                              (dk-cite! 'subset-mem-fwd 'k '(PTS t) y)
                                              (dk-cite! 'fun-apply-type-c 'p '(PTS d) 'ee lam)
                                              (dk-cite! 'subset-mem-fwd 'ee '(FUN (PTS t) RR) g)
                                              (for-each (lambda (h q) (dk-cite! 'fun-apply-type-c h '(PTS t) 'RR q))
                                                        (list g g 'f 'f) (list z y z y))
                                              (dk-apply! vcl g y)
                                              (dk-apply! vcl 'f y)
                                              (dk-apply! tl lam)
                                              (dk-have! (list '= (list zn lam) (list g z)) (lambda () (dk-lam-b!) (rfl)))
                                              (nt-rr-ball-out! (list zn lam) (list g z) (list 'f z) e3)
                                              (nt-a15-tri! (list g z) (list g y) (list 'f z) (list 'f y) e3 e)
                                              (dk-ass!)))))))))))))
                  (dk-cite! 'intersection-membership v 'k z)
                  (dk-have! (list 'IN z w) (lambda () (if (dk-only! (dk-ctx-form (list 'IFF (list 'IN z w) (list 'AND (list 'IN z v) (list 'IN z 'k))))
                                                                    (list 'IN z v) (list 'IN z 'k)) (prop))))
                  (for-each (lambda (l) (dk-focus! l) (ass)) (dk-opened (lambda () (bu-mi w))))))))))
      (dk-cite! 'class-extensionality bu 'k)
      (dk-have! (list '== bu (list 'PTS sk)) (lambda () (subst (list '== (list 'PTS sk) 'k)) (subst (list '= bu 'k)) (qrfl)))
      ;; 3. a finite subcover
      (dk-apply! cmp cc)
      (let* ((ff (dk-skolem! (dk-pick (lambda (g) (and (dk-head-is? g 'FORSOME) (dk-contains? g 'f_))) "the subcover") #t))
             (bf (list 'BIG-UNION 'u ff 'u)))
        (dk-cite! 'subclass-of-set-is-set ff cc)
        ;; 4. a common index for the finite subcover (directed-finite-common-index)
        (let* ((rr (list 'SEP 'ucr_ (list 'CARTESIAN cc '(PTS d)) (nt-a15-bound e '(NTH 1 ucr_) '(NTH 2 ucr_))))
               (rin! (lambda (w i)       ; (IN (LIST w i) R) from w in C, i in PTS d and the bound for (w, i)
                       (dk-cite! 'pair-in-cartesian cc '(PTS d) w i)
                       (dk-have! (list 'IN (list 'LIST w i) rr) (lambda () (in-sep! (lambda () (ass)) (lambda () (nt-nth-all!) (dk-ass!)))))))
               (rout! (lambda (w i)      ; (IN (LIST w i) R) in context: the bound for (w, i), and w in C
                        (let ((b (nt-a15-bound e w i)))
                          (dk-have! b (lambda () (sep-me (dk-ctx-form (list 'IN (list 'LIST w i) rr))) (dk-split-all!)
                                                 (nt-nth-h! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'ucl_) (dk-contains? h 'NTH))) "the bound"))
                                                 (dk-ass!)))
                          b))))
          (dk-project! '(IN (PTS d) SET) 'is-directed-set '(IS-DIRECTED-SET d))
          (dk-have! (list 'IN (list 'CARTESIAN cc '(PTS d)) 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
          (dk-have! (list 'IN rr 'SET) (lambda () (sep-set) (ass)))
          ;; upward closure
          (dk-have! (list 'FORALL 'fbw_ (list 'FORALL 'fbi_ (list 'FORALL 'fbk_ (list 'IMPLIES (list 'IN '(LIST fbw_ fbi_) rr) (list 'IMPLIES '(IN fbk_ (PTS d))
                      (list 'IMPLIES '(IN (LIST fbi_ fbk_) (DLEQ d)) (list 'IN '(LIST fbw_ fbk_) rr)))))))
            (lambda ()
              (let* ((ld (dk-peel!))
                     (wi (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) rr))) ld)))
                     (w (cadr wi)) (i (caddr wi))
                     (kk (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(PTS d)))) ld)))
                     (b (rout! w i)))
                (dk-have! (list 'AND (list 'IN w cc) (list 'IN i '(PTS d)))
                  (lambda () (sep-me (dk-ctx-form (list 'IN (list 'LIST w i) rr))) (dk-split-all!)
                             (dk-cite! 'pair-in-cartesian-parts cc '(PTS d) w i) (dk-ass!)))
                (dk-split! (list 'AND (list 'IN w cc) (list 'IN i '(PTS d))))
                (dk-cite! 'pair-in-cartesian cc '(PTS d) w kk)
                (dk-have! (list 'IN (list 'LIST w kk) rr)
                  (lambda ()
                    (in-sep! (lambda () (ass))
                      (lambda ()
                        (nt-nth-all!)
                        (let* ((ld2 (dk-peel!))
                               (lam (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(PTS d)))) ld2)))
                               (y (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) w))) ld2))))
                          (nt-trans! 'd i kk lam)
                          (dk-apply! b lam y)
                          (dk-ass!))))))
                (dk-ass!))))
          ;; every member of the subcover has an index
          (dk-have! (list 'FORALL 'fbu_ (list 'IMPLIES (list 'IN 'fbu_ ff) (list 'FORSOME 'fbj_ (list 'AND '(IN fbj_ (PTS d)) (list 'IN '(LIST fbu_ fbj_) rr)))))
            (lambda ()
              (let ((w (dk-di-var!)))
                (dk-cite! 'subset-mem-fwd ff cc w)
                (let ((ex (list 'FORSOME 'ucm_ (list 'AND '(IN ucm_ (PTS d)) (nt-a15-bound e w 'ucm_)))))
                  (dk-have! ex (lambda () (sep-me (dk-ctx-form (list 'IN w cc))) (dk-split-all!) (dk-ass!)))
                  (let ((mu (dk-skolem! (dk-ctx-form ex) #t)))
                    (rin! w mu)
                    (ew mu)
                    (dk-conj-close! (lambda () (ass))))))))
          (dk-cite! 'directed-finite-common-index 'd rr)
          (nt-and! (list 'IN ff 'SET) (list 'IN (list 'CARD ff) 'NN))
          (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'fbs_) (dk-contains? h rr))) "the lemma") ff)
          (let* ((mu (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'fbm_) (dk-contains? h ff))) "the common index") #t))
                 (tl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h mu) (dk-contains? h ff))) "the tail")))
            (ew mu)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (let* ((ld (dk-peel!))
                           (lam (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(PTS d)))) ld)))
                           (y (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'k))) ld))))
                      (dk-have! (list 'IN y bf) (lambda () (subst (list '== bf (list 'PTS sk))) (subst (list '== (list 'PTS sk) 'k)) (ass)))
                      (let* ((ld2 (dk-landed (lambda () (bu-me (list 'IN y bf)))))
                             (w (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) ff))) ld2))))
                        (dk-apply! tl w)
                        (let ((b (rout! w mu)))
                          (dk-apply! b lam y)
                          (dk-ass!)))))))))))))
(nt-qed! 'equicontinuous-ptwise-implies-compact-unif)

;;; a one-point subspace is compact
(sp (make-wff (nt-alls '(t x) (nt-imps '((IS-TOP-SPACE t) (IN x (PTS t))) '(IS-COMPACT-T (SUBSPACE-TOP t (PAIR x x)))))))
(dk-peel!)
(let* ((sx '(PAIR x x)) (sk (list 'SUBSPACE-TOP 't sx))
       (opb (list 'SEP 'stw_ (list 'POWER sx) (list 'FORSOME 'stu_ (list 'AND '(IN stu_ (OPENS t)) (list '= 'stw_ (list 'INTERSECTION 'stu_ sx)))))))
  (dk-project! '(IN (OPENS t) (POWER (POWER (PTS t)))) 'is-top-space '(IS-TOP-SPACE t))
  (dk-project! '(IN (PTS t) (OPENS t)) 'is-top-space '(IS-TOP-SPACE t))
  (dk-cite! 'membership-implies-sethood '(PTS t) '(OPENS t))
  (dk-cite! 'membership-implies-sethood 'x '(PTS t))
  (nt-and! '(IN x SET) '(IN x SET))
  (dk-cite! 'pairing 'x 'x)
  (dk-cite! 'pair-self-member 'x)
  (dk-have! (list 'SUBSET sx '(PTS t)) (lambda () (mac 'subset-def) (let ((q (dk-di-var!))) (dk-cite! 'pair-self-eq 'x q) (subst (list '= q 'x)) (ass))))
  (dk-cite! 'subspace-top-is-top-space 't sx)
  (dk-cite! 'subspace-top-pts 't sx)
  (dk-cite! 'subspace-top-opens 't sx)
  (mac 'is-compact-t)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((ld (dk-peel!))
                 (cv (find-first (lambda (h) (dk-head-is? h 'FORALL)) ld))
                 (eqh (find-first (lambda (h) (dk-head-is? h '==)) ld))
                 (cc (caddr (cadr (caddr cv))))
                 (bu (cadr eqh)))
            (dk-have! (list 'IN 'x bu) (lambda () (subst eqh) (subst (list '== (list 'PTS sk) sx)) (ass)))
            (let* ((ld2 (dk-landed (lambda () (bu-me (list 'IN 'x bu)))))
                   (w (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) cc))) ld2)))
                   (ff (list 'PAIR w w)) (bf (list 'BIG-UNION 'u ff 'u)))
              (dk-cite! 'membership-implies-sethood w cc)
              (nt-and! (list 'IN w 'SET) (list 'IN w 'SET))
              (dk-cite! 'pairing w w)
              (dk-cite! 'pair-self-member w)
              (dk-apply! cv w)
              (dk-have! (list 'IN w (list 'POWER sx))
                (lambda () (dk-rewrite-h! (list 'IN w (list 'OPENS sk)) (list 'OPENS sk) opb)
                           (sep-me (list 'IN w opb)) (dk-split-all!) (ass)))
              (dk-cite! 'card-singleton w)
              (fact 'nn-zero-in)
              (dk-cite! 'nn-succ-closed 0)
              (dk-have! (list 'FORALL 'ubz_ (list 'IFF (list 'IN 'ubz_ bf) (list 'IN 'ubz_ sx)))
                (lambda ()
                  (let ((z (begin (di) (cadr (cadr (dk-goal))))))
                    (dk-iff! (lambda (g) (equal? g (list 'IN z sx)))
                      (lambda ()
                        (let* ((ld3 (dk-landed (lambda () (bu-me (list 'IN z bf)))))
                               (mm (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) ff))) ld3))))
                          (dk-cite! 'pair-self-eq w mm)
                          (dk-rewrite-h! (list 'IN z mm) mm w)
                          (dk-cite! 'power-mem-in sx w z)
                          (ass)))
                      (lambda ()
                        (dk-cite! 'pair-self-eq 'x z)
                        (dk-have! (list 'IN z w) (lambda () (subst (list '= z 'x)) (ass)))
                        (for-each (lambda (l) (dk-focus! l) (ass)) (dk-opened (lambda () (bu-mi w)))))))))
              (dk-cite! 'class-extensionality bf sx)
              (ew ff)
              (dk-conj-close!
                (lambda ()
                  (cond ((dk-ass!) #t)
                        ((dk-head-is? (dk-goal) 'SUBSET)
                         (mac 'subset-def) (let ((q (dk-di-var!))) (dk-cite! 'pair-self-eq w q) (subst (list '= q w)) (ass)))
                        ((dk-head-is? (dk-goal) 'IN)
                         (subst (list '= (list 'CARD ff) '(succ 0))) (ass))
                        (#t (subst (list '== (list 'PTS sk) sx)) (subst (list '= bf sx)) (qrfl)))))))))))
(nt-qed! 'singleton-subspace-compact)

;;; uniform convergence on k gives pointwise convergence at every point of k
(sp (make-wff (nt-alls '(t ee d p f k x)
  (nt-imps (list '(IS-DIRECTED-SET d) '(IN p (FUN (PTS d) ee)) '(SUBSET ee (FUN (PTS t) RR)) '(IN f (FUN (PTS t) RR))
                 '(SUBSET k (PTS t)) '(IN x k) '(NET-UNIF-CONV-ON d p f k))
    (list 'NET-CONVERGES-TO '(METRIC-TOP RR-MS) 'd (nt-eval-net 'd 'p 'x) '(f x))))))
(dk-peel!)
(dk-cite! 'rr-is-metric-space)
(dk-cite! 'r7q-rr-pts)
(dk-cite! 'subset-mem-fwd 'k '(PTS t) 'x)
(dk-cite! 'fun-apply-type-c 'f '(PTS t) 'RR 'x)
(dk-project! '(IN (PTS d) SET) 'is-directed-set '(IS-DIRECTED-SET d))
(let* ((zx (nt-eval-net 'd 'p 'x))
       (uc (dk-project! '(FORALL uce_ (IMPLIES (POS-RR uce_)
                           (FORSOME uci_ (AND (IN uci_ (PTS d))
                             (FORALL ucj_ (IMPLIES (IN ucj_ (PTS d)) (IMPLIES (IN (LIST uci_ ucj_) (DLEQ d))
                               (FORALL ucy_ (IMPLIES (IN ucy_ k) (< (abs (- ((p ucj_) ucy_) (f ucy_))) uce_))))))))))
                        'net-unif-conv-on '(NET-UNIF-CONV-ON d p f k))))
  (define (val! j)                     ; j in PTS d: (p j) x real, z(j) = (p j) x
    (dk-cite! 'fun-apply-type-c 'p '(PTS d) 'ee j)
    (dk-cite! 'subset-mem-fwd 'ee '(FUN (PTS t) RR) (list 'p j))
    (dk-cite! 'fun-apply-type-c (list 'p j) '(PTS t) 'RR 'x)
    (dk-have! (list '= (list zx j) (list (list 'p j) 'x)) (lambda () (dk-lam-b!) (rfl))))
  (dk-have! (list 'IN zx '(FUN (PTS d) (PTS RR-MS)))
    (lambda () (subst '(== (PTS RR-MS) RR))
               (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (dk-cite! 'fun-apply-type-c 'p '(PTS d) 'ee j)
                                          (dk-cite! 'subset-mem-fwd 'ee '(FUN (PTS t) RR) (list 'p j))
                                          (dk-cite! 'fun-apply-type-c (list 'p j) '(PTS t) 'RR 'x) (ass)))
                             (lambda () (ass)))))
  (dk-have! '(IN (f x) (PTS RR-MS)) (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
  (let* ((iff (dk-cite! 'metric-net-converges-iff 'RR-MS 'd zx '(f x)))
         (bc (caddr iff)))
    (dk-have! bc
      (lambda ()
        (let* ((e (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) (dk-peel!))))
               (i0 (dk-skolem! (dk-apply! uc e) #t))
               (tl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h i0) (dk-contains? h 'ucy_))) "the uniform tail")))
          (dk-pos-parts! e)
          (nt-ev-intro! 'd zx '(BALL RR-MS (f x) e) i0
            (lambda (j)
              (val! j)
              (dk-apply! tl j 'x)
              (let* ((v (list (list 'p j) 'x)) (zj (list zx j))
                     (dd (list '(DIST RR-MS) '(f x) zj))
                     (bm (dk-cite! 'ball-membership 'RR-MS '(f x) e zj)))
                (dk-have! (list 'IN zj 'RR) (lambda () (subst (list '= zj v)) (ass)))
                (dk-have! (list 'IN zj '(PTS RR-MS)) (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
                (dk-cite! 'rr-ms-dist '(f x) zj)
                (dk-cite! 'rr-sub-in-rr '(f x) v) (dk-cite! 'rr-abs-closed (list '- '(f x) v))
                (dk-cite! 'rr-sub-in-rr v '(f x)) (dk-cite! 'rr-abs-closed (list '- v '(f x)))
                (dk-cite! 'rr-abs-sub-sym v '(f x))
                (dk-have! (list '= dd (list 'abs (list '- '(f x) v)))
                  (lambda () (subst (list '== dd (list 'abs (list '- '(f x) zj)))) (subst (list '= zj v)) (rfl)))
                (dk-cite! 'metric-dist-real 'RR-MS '(f x) zj)
                (dk-have! (list '<= dd e) (lambda () (dk-ineq! (list 'IN dd 'RR) (list '= dd (list 'abs (list '- '(f x) v))) (list '= (list 'abs (list '- v '(f x))) (list 'abs (list '- '(f x) v)))
                                                                 (list '< (list 'abs (list '- v '(f x))) e) (list 'IN (list 'abs (list '- v '(f x))) 'RR)
                                                                 (list 'IN (list 'abs (list '- '(f x) v)) 'RR) (list 'IN e 'RR))))
                (dk-have! (list 'NOT (list '= dd e))
                  (lambda () (di) (dk-absurd! (list 'IN dd 'RR) (list '= dd e) (list '= dd (list 'abs (list '- '(f x) v))) (list '= (list 'abs (list '- v '(f x))) (list 'abs (list '- '(f x) v)))
                                              (list '< (list 'abs (list '- v '(f x))) e) (list 'IN (list 'abs (list '- v '(f x))) 'RR)
                                              (list 'IN (list 'abs (list '- '(f x) v)) 'RR) (list 'IN e 'RR))))
                (nt-and! (list 'IN zj '(PTS RR-MS)) (list '<= dd e) (list 'NOT (list '= dd e)))
                (if (dk-only! bm (caddr bm)) (prop))))))))
    (if (dk-only! iff bc) (prop))))
(nt-qed! 'unif-conv-on-pointwise)
