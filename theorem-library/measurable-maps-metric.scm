        (dk-iff-fwd! (dk-cite! 'rectangles-membership 'xs 'cx 'ys 'cy e))
        (let* ((ex (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f e))) (dk-asms)))
               (a (dk-skolem! ex))
