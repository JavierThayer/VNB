(define (mfm-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MFM OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mfm-find pred t)
  (cond ((pred t) t)
        ((pair? t) (let loop ((xs t))
                     (cond ((not (pair? xs)) #f)
                           ((mfm-find pred (car xs)) => (lambda (r) r))
                           (#t (loop (cdr xs))))))
        (#t #f)))
;; w in a member of the sigma-algebra ca over omega: land (IN w omega)
(define (mfm-in-omega! a w)
  (if (not (dk-asm? (list 'IN w 'omega)))
      (begin
        (dk-cite! 'sigma-algebra-in-power-power 'omega 'ca)
        (dk-iff-fwd! (dk-cite! 'power-set-membership '(POWER omega) 'ca))
        (dk-apply! '(FORALL z (IMPLIES (IN z ca) (IN z (POWER omega)))) a)
        (dk-iff-fwd! (dk-cite! 'power-set-membership 'omega a))
        (dk-apply! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z a) '(IN z omega))) w))))

;; ---------------------------------------------------------------------------
;; countable unions and intersections written as separations
(define mfm-bu-sep '(SEP mfx_ omega (FORSOME mfk_ (AND (IN mfk_ NN) (IN mfx_ (g mfk_))))))
(define mfm-bi-sep '(SEP mfx_ omega (FORALL mfk_ (IMPLIES (IN mfk_ NN) (IN mfx_ (g mfk_))))))

(sp (make-wff (dk-foralls '(omega ca g) (dk-curry '((IS-SIGMA-ALGEBRA omega ca) (IN g (FUN NN ca)))
  (list 'IN mfm-bu-sep 'ca)))))
(dk-peel!)
(let ((bu '(BIG-UNION n_ NN (g n_))))
  (dk-cite! 'sigma-algebra-union-closed 'omega 'ca 'g)
  (dk-class-ext! mfm-bu-sep bu
    (lambda (w)
      (dk-sep-parts! (list 'IN w mfm-bu-sep))
      (let ((k (dk-skolem! (dk-ctx-form (list 'FORSOME 'mfk_ (list 'AND '(IN mfk_ NN) (list 'IN w '(g mfk_))))))))
        (dk-bu-close! k)))
    (lambda (w)
      (let* ((r (dk-bu-open! w bu)) (k (car r)))
        (dk-cite! 'fun-apply-type-c 'g 'NN 'ca k)
        (mfm-in-omega! (list 'g k) w)
        (in-sep! (lambda () (dk-ass!))
                 (lambda () (ew k) (dk-conj-close! dk-ass!))))))
  (subst (list '= mfm-bu-sep bu))
  (dk-ass!))
(mfm-qed! 'sep-exists-family-in-sigma)

(sp (make-wff (dk-foralls '(omega ca g) (dk-curry '((IS-SIGMA-ALGEBRA omega ca) (IN g (FUN NN ca)))
  (list 'IN mfm-bi-sep 'ca)))))
(dk-peel!)
(let* ((bu '(BIG-UNION n_ NN (COMPLEMENT-IN omega (g n_))))
       (ci (list 'COMPLEMENT-IN 'omega bu)))
  (dk-cite! 'sigma-algebra-countable-inter 'omega 'ca 'g)
  (dk-class-ext! mfm-bi-sep ci
    (lambda (w)
      (dk-sep-parts! (list 'IN w mfm-bi-sep))
      (dk-have! (list 'NOT (list 'IN w bu))
        (lambda ()
          (di)
          (let* ((r (dk-bu-open! w bu)) (k (car r)))
            (dk-iff-fwd! (dk-cite! 'complement-in-membership 'omega (list 'g k) w))
            (dk-apply! (list 'FORALL 'mfk_ (list 'IMPLIES '(IN mfk_ NN) (list 'IN w '(g mfk_)))) k)
            (ai (list 'NOT (list 'IN w (list 'g k)))))))
      (dk-have-and! (list 'IN w 'omega) (list 'NOT (list 'IN w bu)))
      (dk-iff-bwd! (dk-cite! 'complement-in-membership 'omega bu w))
      (dk-ass!))
    (lambda (w)
      (dk-iff-fwd! (dk-cite! 'complement-in-membership 'omega bu w))
      (in-sep! (lambda () (dk-ass!))
               (lambda ()
                 (let ((k (dk-di-var!)))
                   (use-em (list 'IN w (list 'g k))
                     (lambda () (dk-ass!))
                     (lambda ()
                       (dk-have-and! (list 'IN w 'omega) (list 'NOT (list 'IN w (list 'g k))))
                       (dk-iff-bwd! (dk-cite! 'complement-in-membership 'omega (list 'g k) w))
                       (dk-have! (list 'IN w bu) (lambda () (dk-bu-close! k)))
                       (ai (list 'NOT (list 'IN w bu))))))))))
  (subst (list '= mfm-bi-sep ci))
  (dk-ass!))
(mfm-qed! 'sep-forall-family-in-sigma)

;; ---------------------------------------------------------------------------
;; the rho-neighbourhood of a set of points is open
(define mfm-nb '(SEP nby_ (PTS s) (FORSOME nba_ (AND (IN nba_ a) (< ((DIST s) nba_ nby_) rho)))))
(sp (make-wff (dk-foralls '(s a rho) (dk-curry '((IS-METRIC-SPACE s) (SUBSET a (PTS s)) (POS-RR rho))
  (list 'IS-OPEN 's mfm-nb)))))
(dk-peel!)
(dk-cite! 'rr-pos-rr-in-rr 'rho)
(dk-have! (list 'SUBSET mfm-nb '(PTS s))
  (lambda () (let ((w (subset-by-element!))) (dk-sep-parts! (list 'IN w mfm-nb)) (dk-ass!))))
(dk-have! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y mfm-nb)
                  (list 'FORSOME 'r (list 'AND '(POS-RR r) (list 'SUBSET '(BALL s y r) mfm-nb)))))
  (lambda ()
    (let ((y (dk-di-var!)))
      (dk-sep-parts! (list 'IN y mfm-nb))
      (let* ((a0 (dk-skolem! (dk-ctx-form (list 'FORSOME 'nba_ (list 'AND '(IN nba_ a) (list '< (list '(DIST s) 'nba_ y) 'rho))))))
             (day (list '(DIST s) a0 y))
             (r (list '- 'rho day)))
        (dk-cite! 'subset-mem-fwd 'a '(PTS s) a0)
        (dk-cite! 'metric-dist-real 's a0 y)
        (dk-type! r 'RR)
        (dk-have! (list '< 0 r) (lambda () (dk-ineq! (list '< day 'rho))))
        (dk-cite! 'rr-pos-rr-of-lt r)
        (ew r)
        (dk-conj-close!
          (lambda ()
            (if (dk-ass!) #t
                (let ((z (subset-by-element!)))
                  (dk-iff-fwd! (dk-cite! 'ball-membership 's y r z))
                  (let ((dyz (list '(DIST s) y z)) (daz (list '(DIST s) a0 z)))
                    (dk-cite! 'metric-dist-real 's y z)
                    (dk-cite! 'metric-dist-real 's a0 z)
                    (dk-have-and! (list '<= dyz r) (list 'NOT (list '= dyz r)))
                    (dk-cite! 'rr-le-ne-lt dyz r)
                    (dk-cite! 'metric-triangle 's a0 y z)
                    (in-sep! (lambda () (dk-ass!))
                             (lambda ()
                               (ew a0)
                               (dk-conj-close!
                                 (lambda ()
                                   (if (dk-ass!) #t
                                       (dk-ineq! (list '<= daz (list '+ day dyz)) (list '< dyz r))))))))))))))))
(dk-have-and! '(IS-METRIC-SPACE s) (list 'SUBSET mfm-nb '(PTS s))
              (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y mfm-nb)
                  (list 'FORSOME 'r (list 'AND '(POS-RR r) (list 'SUBSET '(BALL s y r) mfm-nb))))))
(dk-iff-bwd! (dk-cite! 'is-open 's mfm-nb))
(dk-ass!)
(mfm-qed! 'metric-nbhd-open)

;; ---------------------------------------------------------------------------
;; the open-preimage lemma
(define (mfm-rho m) (list 'RECIP (list '+ m 1)))
(define (mfm-rho2 m) (list 'RECIP (list '+ (list '+ m 1) 1)))
(define (mfm-A m)
  (list 'SEP 'mfa_ '(PTS s)
        (list 'FORALL 'mfz_ (list 'IMPLIES '(IN mfz_ (PTS s))
                                  (list 'IMPLIES (list '< '((DIST s) mfa_ mfz_) (list '+ (mfm-rho m) (mfm-rho m)))
                                        '(IN mfz_ u))))))
(define (mfm-V m)
  (list 'SEP 'nby_ '(PTS s)
        (list 'FORSOME 'nba_ (list 'AND (list 'IN 'nba_ (mfm-A m)) (list '< '((DIST s) nba_ nby_) (mfm-rho m))))))
(define (mfm-P m n k) (list 'SEP 'mfx_ 'omega (list 'IN (list (list 'fs (list '+ n k)) 'mfx_) (mfm-V m))))
(define (mfm-Tcond m n x)
  (list 'FORALL 'mfk_ (list 'IMPLIES '(IN mfk_ NN) (list 'IN (list (list 'fs (list '+ n 'mfk_)) x) (mfm-V m)))))
(define (mfm-T m n) (list 'SEP 'mfx_ 'omega (mfm-Tcond m n 'mfx_)))
(define (mfm-Ucond m x) (list 'FORSOME 'mfn_ (list 'AND '(IN mfn_ NN) (mfm-Tcond m 'mfn_ x))))
(define (mfm-U m) (list 'SEP 'mfx_ 'omega (mfm-Ucond m 'mfx_)))
(define mfm-Wcond (list 'FORSOME 'mfm_ (list 'AND '(IN mfm_ NN) (mfm-Ucond 'mfm_ 'mfx_))))
(define mfm-W (list 'SEP 'mfx_ 'omega mfm-Wcond))
(define mfm-seq '(VNB-LAMBDA k NN ((fs k) x)))
(define mfm-hyps
  (list '(IS-SIGMA-ALGEBRA omega ca) '(IS-METRIC-SPACE s) '(IN fs (FUN NN (FUN omega (PTS s))))
        '(FORALL n (IMPLIES (IN n NN) (IS-MEASURABLE-MAP omega ca (PTS s) (BOREL-SETS s) (fs n))))
        '(IN f (FUN omega (PTS s)))
        (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'CONVERGES-TO 's mfm-seq '(f x))))))
(define mfm-meas-hyp '(FORALL n (IMPLIES (IN n NN) (IS-MEASURABLE-MAP omega ca (PTS s) (BOREL-SETS s) (fs n)))))
(define mfm-conv-hyp (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'CONVERGES-TO 's mfm-seq '(f x)))))

;; (fs n)(w) typed in PTS s
(define (mfm-fsw! n w)
  (dk-cite! 'fun-apply-type-c 'fs 'NN '(FUN omega (PTS s)) n)
  (dk-cite! 'fun-apply-type-c (list 'fs n) 'omega '(PTS s) w))
(define (mfm-nn-add! a b)
  (if (not (dk-asm? (list 'IN (list '+ a b) 'NN)))
      (begin (dk-have-and! (list 'IN a 'NN) (list 'IN b 'NN))
             (dk-cite! 'nn-add-closed a b))))
(define (mfm-one-nn!) (if (not (dk-asm? '(IN 1 NN))) (dk-have! '(IN 1 NN) (lambda () (arith)))))
;; the eps clause of the convergence at w: returns the clause (FORALL eps ...)
(define (mfm-conv-clause! w)
  (let* ((cv (dk-apply! mfm-conv-hyp w))
         (parts (dk-iff-parts! (dk-cite! 'converges-to 's (subst-free 'x w mfm-seq) (list 'f w)))))
    (list-ref parts 3)))
;; from the eps clause at eps (POS-RR eps in context): skolemise the index; return (idx . tail-clause)
(define (mfm-conv-index! clause eps)
  (let* ((idx (dk-skolem! (dk-apply! clause eps)))
         (tail (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f idx) (dk-contains? f eps)
                                            (dk-contains? f 'DIST)))
                           (dk-asms))))
    (if (not tail) (error "mfm-conv-index!: no tail clause landed" idx))
    (cons idx tail)))
;; the bound at n (n in NN, idx <= n in context): (<= dist((fs n) w, f w) eps)
(define (mfm-conv-at! ci eps n w)
  (let* ((b (dk-apply! (cdr ci) n)))
    (dk-lam-b-h! b)
    (list '<= (list '(DIST s) (list (list 'fs n) w) (list 'f w)) eps)))

(sp (make-wff (dk-foralls '(omega ca s fs f u) (dk-curry (append mfm-hyps '((IS-OPEN s u)))
  (list 'IN '(SEP mfx_ omega (IN (f mfx_) u)) 'ca)))))
(dk-peel!)
(let* ((op-parts (dk-iff-parts! (dk-cite! 'is-open 's 'u)))
       (op-ball (list-ref op-parts 2)))
  (dk-cite! 'ms-pts-is-set 's)
  (dk-cite! 'sigma-algebra-ambient-set 'omega 'ca)
  (mfm-one-nn!)
  ;; Step 0: V(m) is Borel and P(m,n,k) is in ca
  (dk-have! (list 'FORALL 'mfm_ (list 'IMPLIES '(IN mfm_ NN) (list 'IN (mfm-V 'mfm_) '(BOREL-SETS s))))
    (lambda ()
      (let ((m (dk-di-var!)))
        (dk-have! (list 'SUBSET (mfm-A m) '(PTS s))
          (lambda () (let ((w (subset-by-element!))) (dk-sep-parts! (list 'IN w (mfm-A m))) (dk-ass!))))
        (dk-cite! 'nn-recip-succ-pos m)
        (dk-cite! 'metric-nbhd-open 's (mfm-A m) (mfm-rho m))
        (dk-cite! 'pfw-open-borel 's (mfm-V m))
        (dk-ass!))))
  ;; Step 1: T(m,n) in ca
  (dk-have! (list 'FORALL 'mfm_ (list 'IMPLIES '(IN mfm_ NN) (list 'FORALL 'mfn_ (list 'IMPLIES '(IN mfn_ NN) (list 'IN (mfm-T 'mfm_ 'mfn_) 'ca)))))
    (lambda ()
      (dk-peel!)
      (let* ((g (dk-goal))
             (n (cadr (mfm-find (lambda (t) (and (pair? t) (eq? (car t) '+) (pair? (cdr t)) (pair? (cddr t)) (eq? (caddr t) 'mfk_))) g)))
             (m (cadr (cadr (mfm-find (lambda (t) (and (pair? t) (eq? (car t) 'RECIP))) g))))
             (ab (dk-abstract! 'NN 'ca (lambda (k) (mfm-P m n k))
                   (lambda (k)
                     (mfm-nn-add! n k)
                     (dk-apply! mfm-meas-hyp (list '+ n k))
                     (dk-apply! (list 'FORALL 'mfm_ (list 'IMPLIES '(IN mfm_ NN) (list 'IN (mfm-V 'mfm_) '(BOREL-SETS s)))) m)
                     (dk-cite! 'measurable-map-preimage 'omega 'ca '(PTS s) '(BOREL-SETS s) (list 'fs (list '+ n k)) (mfm-V m))
                     (dk-ass!))))
             (gfam (car ab)) (ve (cdr ab))
             (gsep (list 'SEP 'mfx_ 'omega (list 'FORALL 'mfk_ (list 'IMPLIES '(IN mfk_ NN) (list 'IN 'mfx_ (list gfam 'mfk_)))))))
        (dk-cite! 'sep-forall-family-in-sigma 'omega 'ca gfam)
        (dk-class-ext! gsep (mfm-T m n)
          (lambda (w)
            (dk-sep-parts! (list 'IN w gsep))
            (in-sep! (lambda () (dk-ass!))
                     (lambda ()
                       (let ((k (dk-di-var!)))
                         (let ((h (dk-apply! (list 'FORALL 'mfk_ (list 'IMPLIES '(IN mfk_ NN) (list 'IN w (list gfam 'mfk_)))) k)))
                           (dk-apply! ve k)
                           (dk-rewrite-h! h (list gfam k) (mfm-P m n k))
                           (dk-sep-parts! (list 'IN w (mfm-P m n k)))
                           (dk-ass!))))))
          (lambda (w)
            (dk-sep-parts! (list 'IN w (mfm-T m n)))
            (in-sep! (lambda () (dk-ass!))
                     (lambda ()
                       (let ((k (dk-di-var!)))
                         (dk-apply! ve k)
                         (subst (list '= (list gfam k) (mfm-P m n k)))
                         (dk-apply! (mfm-Tcond m n w) k)
                         (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!))))))))
        (subst (list '= (mfm-T m n) gsep))
        (dk-ass!))))
  ;; Step 2: U(m) in ca
  (dk-have! (list 'FORALL 'mfm_ (list 'IMPLIES '(IN mfm_ NN) (list 'IN (mfm-U 'mfm_) 'ca)))
    (lambda ()
      (let* ((m (dk-di-var!))
             (ab (dk-abstract! 'NN 'ca (lambda (n) (mfm-T m n))
                   (lambda (n)
                     (dk-apply! (list 'FORALL 'mfm_ (list 'IMPLIES '(IN mfm_ NN) (list 'FORALL 'mfn_ (list 'IMPLIES '(IN mfn_ NN) (list 'IN (mfm-T 'mfm_ 'mfn_) 'ca))))) m n)
                     (dk-ass!))))
             (hfam (car ab)) (ve (cdr ab))
             (hsep (list 'SEP 'mfx_ 'omega (list 'FORSOME 'mfk_ (list 'AND '(IN mfk_ NN) (list 'IN 'mfx_ (list hfam 'mfk_)))))))
        (dk-cite! 'sep-exists-family-in-sigma 'omega 'ca hfam)
        (dk-class-ext! hsep (mfm-U m)
          (lambda (w)
            (dk-sep-parts! (list 'IN w hsep))
            (let* ((n (dk-skolem! (dk-ctx-form (list 'FORSOME 'mfk_ (list 'AND '(IN mfk_ NN) (list 'IN w (list hfam 'mfk_))))))))
              (dk-apply! ve n)
              (dk-rewrite-h! (list 'IN w (list hfam n)) (list hfam n) (mfm-T m n))
              (dk-sep-parts! (list 'IN w (mfm-T m n)))
              (in-sep! (lambda () (dk-ass!))
                       (lambda () (ew n) (dk-conj-close! dk-ass!)))))
          (lambda (w)
            (dk-sep-parts! (list 'IN w (mfm-U m)))
            (let ((n (dk-skolem! (dk-ctx-form (mfm-Ucond m w)))))
              (dk-apply! ve n)
              (dk-have! (list 'IN w (mfm-T m n)) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
              (dk-rewrite-h! (list 'IN w (mfm-T m n)) (mfm-T m n) (list hfam n))
              (in-sep! (lambda () (dk-ass!))
                       (lambda () (ew n) (dk-conj-close! dk-ass!))))))
        (subst (list '= (mfm-U m) hsep))
        (dk-ass!))))
  ;; Step 3: W in ca
  (let* ((ab (dk-abstract! 'NN 'ca (lambda (m) (mfm-U m))
               (lambda (m)
                 (dk-apply! (list 'FORALL 'mfm_ (list 'IMPLIES '(IN mfm_ NN) (list 'IN (mfm-U 'mfm_) 'ca))) m)
                 (dk-ass!))))
         (kfam (car ab)) (ve (cdr ab))
         (ksep (list 'SEP 'mfx_ 'omega (list 'FORSOME 'mfk_ (list 'AND '(IN mfk_ NN) (list 'IN 'mfx_ (list kfam 'mfk_)))))))
    (dk-cite! 'sep-exists-family-in-sigma 'omega 'ca kfam)
    (dk-class-ext! ksep mfm-W
      (lambda (w)
        (dk-sep-parts! (list 'IN w ksep))
        (let* ((m (dk-skolem! (dk-ctx-form (list 'FORSOME 'mfk_ (list 'AND '(IN mfk_ NN) (list 'IN w (list kfam 'mfk_))))))))
          (dk-apply! ve m)
          (dk-rewrite-h! (list 'IN w (list kfam m)) (list kfam m) (mfm-U m))
          (dk-sep-parts! (list 'IN w (mfm-U m)))
          (in-sep! (lambda () (dk-ass!))
                   (lambda () (ew m) (dk-conj-close! dk-ass!)))))
      (lambda (w)
        (dk-sep-parts! (list 'IN w mfm-W))
        (let ((m (dk-skolem! (dk-ctx-form (subst-free 'mfx_ w mfm-Wcond)))))
          (dk-apply! ve m)
          (dk-have! (list 'IN w (mfm-U m)) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
          (dk-rewrite-h! (list 'IN w (mfm-U m)) (mfm-U m) (list kfam m))
          (in-sep! (lambda () (dk-ass!))
                   (lambda () (ew m) (dk-conj-close! dk-ass!))))))
    (dk-have! (list 'IN mfm-W 'ca) (lambda () (subst (list '= mfm-W ksep)) (dk-ass!))))
  ;; Step 4: the preimage of u is W
  (let ((pre '(SEP mfx_ omega (IN (f mfx_) u))))
    (dk-class-ext! pre mfm-W
      (lambda (w)
        (dk-sep-parts! (list 'IN w pre))
        (dk-cite! 'fun-apply-type-c 'f 'omega '(PTS s) w)
        (let* ((fw (list 'f w))
               (r (dk-skolem! (dk-apply! op-ball fw)))
               (d (dk-halve! r))
               (m (dk-skolem! (dk-cite! 'nn-recip-succ-small d)))
               (rho (mfm-rho m)) (rho2 (mfm-rho2 m)))
          (dk-split-all! (list (dk-cite! 'cc-exhaust-radius-decrease m)))
          (mfm-nn-add! m 1)
          (dk-cite! 'nn-recip-succ-pos (list '+ m 1))
          (dk-cite! 'nn-recip-succ-pos m)
          (dk-cite! 'rr-pos-rr-in-rr rho) (dk-cite! 'rr-pos-rr-in-rr rho2) (dk-cite! 'rr-pos-rr-in-rr r)
          (let* ((cl (mfm-conv-clause! w))
                 (ci (mfm-conv-index! cl rho2)) (n0 (car ci)))
            ;; f w is in A(m)
            (dk-have! (list 'IN fw (mfm-A m))
              (lambda ()
                (in-sep! (lambda () (dk-ass!))
                         (lambda ()
                           (dk-peel!)
                           (let* ((g (dk-goal)) (z (cadr g))
                                  (dz (list '(DIST s) fw z)))
                             (dk-cite! 'metric-dist-real 's fw z)
                             (dk-cite! 'rr-leq-reflexive dz)
                             (dk-have! (list '< dz r)
                               (lambda () (dk-ineq! (list '< dz (list '+ rho rho)) (list '< rho d) (list '= (list '+ d d) r))))
                             (dk-have-and! (list 'IN z '(PTS s)) (list 'IN dz 'RR) (list 'IN r 'RR) (list '<= dz dz) (list '< dz r))
                             (dk-cite! 'ball-mem-from-le 's fw z dz r)
                             (dk-cite! 'subset-mem-fwd (list 'BALL 's fw r) 'u z)
                             (dk-ass!))))))
            (in-sep! (lambda () (dk-ass!))
                     (lambda ()
                       (ew m)
                       (dk-conj-close!
                         (lambda ()
                           (if (dk-ass!) #t
                               (begin
                                 (ew n0)
                                 (dk-conj-close!
                                   (lambda ()
                                     (if (dk-ass!) #t
                                         (let* ((k (dk-di-var!)) (n (list '+ n0 k)))
                                           (mfm-nn-add! n0 k)
                                           (dk-cite! 'nn-le-add-right k n0)
                                           (mfm-fsw! n w)
                                           (let* ((fnw (list (list 'fs n) w))
                                                  (b (mfm-conv-at! ci rho2 n w)))
                                             (dk-cite! 'metric-dist-real 's fnw fw)
                                             (dk-cite! 'metric-dist-real 's fw fnw)
