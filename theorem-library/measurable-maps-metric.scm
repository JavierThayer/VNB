;;; mf-mc3.scm -- Prop 2.5 of the construction-of-measures notes: a measurable map into a separable metric space
;;; is a uniform limit of step maps (Def 2.4); with the disjointification lemmas it rests on.
;;; Agent M-F (target M-C), 2026-10-29.  DESTINATION: theorem-library/measurable-maps-metric.scm (after mf-mc2).
;;; Library: measure.  Helper prefix: mfs-.  Load window: after mf-mcvocab (structure-library/step-maps), mf-mc1
;;; (sep-exists-family-in-sigma), seg-mem-lt, nn-least-element, choice-axiom, pfw-open-borel, measurable-map-intro.

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)

(define (mfs-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MFS OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mfs-bu e k) (list 'BIG-UNION 'uj_ (list 'ORD-SEGMENT k) (list e 'uj_)))
(define (mfs-A e k) (list 'COMPLEMENT-IN (list e k) (mfs-bu e k)))
;; open w in a segment union: return the index j (landed: j in seg k, j in NN, w in e j)
(define (mfs-seg-open! w e k)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w (mfs-bu e k))))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'ORD-SEGMENT k)))) landed)))
    (if (not ein) (error "mfs-seg-open!: no index landed" landed))
    (dk-cite! 'ord-segment-nn-subset k (cadr ein))
    (cadr ein)))
(define mfs-hyps '((IS-SIGMA-ALGEBRA omega ca) (IN e (FUN NN ca))))

;; ---------------------------------------------------------------------------
;; A(k) = e(k) minus the e(j), j < k
(sp (make-wff (dk-foralls '(omega ca e k) (dk-curry (append mfs-hyps '((IN k NN)))
  (list 'IN (mfs-A 'e 'k) 'ca)))))
(dk-peel!)
(dk-cite! 'sigma-algebra-seg-union-in 'k 'omega 'ca 'e)
(dk-cite! 'fun-apply-type-c 'e 'NN 'ca 'k)
(dk-cite! 'sigma-algebra-difference-closed 'omega 'ca '(e k) (mfs-bu 'e 'k))
(dk-ass!)
(mfs-qed! 'disjointed-seq-in-sigma)

(sp (make-wff (dk-foralls '(omega ca e x k j) (dk-curry (append mfs-hyps
    (list '(IN k NN) '(IN j NN) (list 'IN 'x (mfs-A 'e 'k)) (list 'IN 'x (mfs-A 'e 'j))))
  '(= k j)))))
(dk-peel!)
(dk-iff-fwd! (dk-cite! 'complement-in-membership '(e k) (mfs-bu 'e 'k) 'x))
(dk-iff-fwd! (dk-cite! 'complement-in-membership '(e j) (mfs-bu 'e 'j) 'x))
(dk-cite! 'nn-in-rr 'k)
(dk-cite! 'nn-in-rr 'j)
(dk-or-each! (dk-cite! 'rr-lt-trichotomy 'k 'j)
  (lambda (d)
    (cond ((equal? d '(= k j)) (dk-ass!))
          ((equal? d '(< k j))
           (dk-iff-bwd! (dk-cite! 'seg-mem-lt 'j 'k))
           (dk-have! (list 'IN 'x (mfs-bu 'e 'j)) (lambda () (dk-bu-close! 'k)))
           (ai (list 'NOT (list 'IN 'x (mfs-bu 'e 'j)))))
          (#t
           (dk-iff-bwd! (dk-cite! 'seg-mem-lt 'k 'j))
           (dk-have! (list 'IN 'x (mfs-bu 'e 'k)) (lambda () (dk-bu-close! 'j)))
           (ai (list 'NOT (list 'IN 'x (mfs-bu 'e 'k))))))))
(mfs-qed! 'disjointed-seq-unique)

(sp (make-wff (dk-foralls '(omega ca e x k) (dk-curry (append mfs-hyps '((IN k NN) (IN x (e k))))
  (list 'FORSOME 'm (list 'AND '(IN m NN) (list 'IN 'x (mfs-A 'e 'm))))))))
(dk-peel!)
(let ((tt '(SEP stj_ NN (IN x (e stj_)))))
  (dk-have! (list 'SUBSET tt 'NN)
    (lambda () (let ((w (subset-by-element!))) (dk-sep-parts! (list 'IN w tt)) (dk-ass!))))
  (dk-have! (list 'FORSOME 'n (list 'IN 'n tt))
    (lambda () (ew 'k) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
  (dk-have-and! (list 'SUBSET tt 'NN) (list 'FORSOME 'n (list 'IN 'n tt)))
  (let* ((m1 (dk-skolem! (dk-cite! 'nn-least-element tt)))
         (least (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f m1) (dk-contains? f '<=))) (dk-asms))))
    (dk-sep-parts! (list 'IN m1 tt))
    (dk-cite! 'nn-in-rr m1)
    (dk-have! (list 'NOT (list 'IN 'x (mfs-bu 'e m1)))
      (lambda ()
        (di)
        (let ((j (mfs-seg-open! 'x 'e m1)))
          (dk-cite! 'nn-in-rr j)
          (dk-iff-fwd! (dk-cite! 'seg-mem-lt m1 j))
          (dk-have! (list 'IN j tt) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
          (dk-apply! least j)
          (dk-absurd! (list '< j m1) (list '<= m1 j)))))
    (dk-have-and! (list 'IN 'x (list 'e m1)) (list 'NOT (list 'IN 'x (mfs-bu 'e m1))))
    (dk-iff-bwd! (dk-cite! 'complement-in-membership (list 'e m1) (mfs-bu 'e m1) 'x))
    (ew m1)
    (dk-conj-close! dk-ass!)))
(mfs-qed! 'disjointed-seq-cover)

;; ---------------------------------------------------------------------------
;; Prop 2.5, one tolerance at a time
(define mfs-close-goal
  '(FORALL x (IMPLIES (IN x omega) (< ((DIST s) (f x) (g x)) eps))))
(sp (make-wff (dk-foralls '(omega ca s f) (dk-curry
  '((IS-SEPARABLE s) (IS-MEASURABLE-MAP omega ca (PTS s) (BOREL-SETS s) f))
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'g (list 'AND '(IS-STEP-MAP omega ca s g) mfs-close-goal))))))))
(dk-peel!)
(let* ((sp-parts (dk-iff-parts! (dk-cite! 'is-separable 's)))
       (d (dk-skolem! (list-ref sp-parts 1)))
       (dens (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d) (dk-contains? f 'DIST))) (dk-asms)))
       (mparts (dk-iff-parts! (dk-cite! 'is-measurable-map 'omega 'ca '(PTS s) '(BOREL-SETS s) 'f)))
       (pparts (dk-iff-parts! (dk-cite! 'pos-rr 'eps))))
  (dk-cite! 'ms-pts-is-set 's)
  (dk-cite! 'sigma-algebra-ambient-set 'omega 'ca)
  (dk-cite! 'rr-pos-rr-in-rr 'eps)
  (let* ((ball (lambda (k) (list 'BALL 's (list d k) 'eps)))
         (ek (lambda (k) (list 'SEP 'stx_ 'omega (list 'IN '(f stx_) (ball k)))))
         (ab (dk-abstract! 'NN 'ca ek
               (lambda (k)
                 (dk-cite! 'fun-apply-type-c d 'NN '(PTS s) k)
                 (dk-have-and! '(IN eps RR) '(<= 0 eps) '(NOT (= 0 eps)))
                 (dk-cite! 'ball-is-open 's (list d k) 'eps)
                 (dk-cite! 'pfw-open-borel 's (ball k))
                 (dk-cite! 'measurable-map-preimage 'omega 'ca '(PTS s) '(BOREL-SETS s) 'f (ball k))
                 (dk-ass!))))
         (efam (car ab)) (eve (cdr ab))
         (sx (lambda (x) (list 'SEP 'stk_ 'NN (list 'IN x (mfs-A efam 'stk_)))))
         (cx (lambda (x) (list 'CHOICE (sx x))))
         (gt (list 'VNB-LAMBDA 'stx_ 'omega (list d (cx 'stx_))))
         (c1 (list 'FORALL 'x (list 'IMPLIES '(IN x omega)
                (list 'AND (list 'IN (cx 'x) 'NN) (list 'IN 'x (mfs-A efam (cx 'x))))))))
    ;; every point lies in exactly one A(k); the chosen index is that k
    (dk-have! c1
      (lambda ()
        (let* ((w (dk-di-var!)) (fw (list 'f w)))
          (dk-cite! 'fun-apply-type-c 'f 'omega '(PTS s) w)
          (let* ((m0 (dk-skolem! (dk-apply! dens fw 'eps)))
                 (dm (list d m0))
                 (dd (list '(DIST s) dm fw)))
            (dk-cite! 'fun-apply-type-c d 'NN '(PTS s) m0)
            (dk-cite! 'metric-dist-real 's dm fw)
            (dk-cite! 'metric-dist-real 's fw dm)
            (dk-cite! 'metric-sym 's fw dm)
            (dk-cite! 'rr-leq-reflexive dd)
            (dk-have! (list '< dd 'eps)
              (lambda () (dk-ineq! (list '= (list '(DIST s) fw dm) dd) (list '< (list '(DIST s) fw dm) 'eps))))
            (dk-have-and! (list 'IN fw '(PTS s)) (list 'IN dd 'RR) '(IN eps RR) (list '<= dd dd) (list '< dd 'eps))
            (dk-cite! 'ball-mem-from-le 's dm fw dd 'eps)
            (dk-apply! eve m0)
            (dk-have! (list 'IN w (list efam m0))
              (lambda () (subst (list '= (list efam m0) (ek m0)))
                         (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
            (let ((m1 (dk-skolem! (dk-cite! 'disjointed-seq-cover 'omega 'ca efam w m0))))
              (dk-have! (list 'FORSOME 'stz_ (list 'IN 'stz_ (sx w)))
                (lambda () (ew m1) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
              (dk-cite! 'choice-axiom (sx w))
              (dk-sep-parts! (list 'IN (cx w) (sx w)))
              (dk-conj-close! dk-ass!))))))
    (dk-have! (list 'IN gt '(FUN omega (PTS s)))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((x (dk-di-var!)))
              (dk-split-all! (list (dk-apply! c1 x)))
              (dk-cite! 'fun-apply-type-c d 'NN '(PTS s) (cx x))
              (dk-ass!))))))
    ;; the preimage of a Borel set under gt
    (dk-have! (list 'FORALL 'b_ (list 'IMPLIES '(IN b_ (BOREL-SETS s)) (list 'IN (list 'SEP 'x_ 'omega (list 'IN (list gt 'x_) 'b_)) 'ca)))
      (lambda ()
        (let* ((b (dk-di-var!))
               (ck (lambda (k) (list 'SEP 'stx_ 'omega (list 'AND (list 'IN 'stx_ (mfs-A efam k)) (list 'IN (list d k) b)))))
               (ab2 (dk-abstract! 'NN 'ca ck
                      (lambda (k)
                        (dk-cite! 'disjointed-seq-in-sigma 'omega 'ca efam k)
                        (use-em (list 'IN (list d k) b)
                          (lambda ()
                            (dk-class-ext! (ck k) (mfs-A efam k)
                              (lambda (w) (dk-sep-parts! (list 'IN w (ck k)))
                                          (dk-split-all!)
                                          (dk-ass!))
                              (lambda (w)
                                (dk-iff-fwd! (dk-cite! 'complement-in-membership (list efam k) (mfs-bu efam k) w))
                                (dk-cite! 'fun-apply-type-c efam 'NN 'ca k)
                                (dk-cite! 'sigma-algebra-in-power-power 'omega 'ca)
                                (dk-iff-fwd! (dk-cite! 'power-set-membership '(POWER omega) 'ca))
                                (dk-apply! '(FORALL z (IMPLIES (IN z ca) (IN z (POWER omega)))) (list efam k))
                                (dk-iff-fwd! (dk-cite! 'power-set-membership 'omega (list efam k)))
                                (dk-apply! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z (list efam k)) '(IN z omega))) w)
                                (in-sep! (lambda () (dk-ass!)) (lambda () (dk-conj-close! dk-ass!)))))
                            (subst (list '= (ck k) (mfs-A efam k)))
                            (dk-ass!))
                          (lambda ()
                            (dk-class-ext! (ck k) 'EMPTY-SET
                              (lambda (w) (dk-sep-parts! (list 'IN w (ck k)))
                                          (dk-split-all!)
                                          (ai (list 'NOT (list 'IN (list d k) b))))
                              (lambda (w) (ai (dk-cite! 'empty-set-has-no-members w))))
                            (subst (list '= (ck k) 'EMPTY-SET))
                            (dk-cite! 'sigma-algebra-empty-in 'omega 'ca)
                            (dk-ass!))))))
               (cfam (car ab2)) (cve (cdr ab2))
               (pre (list 'SEP 'x_ 'omega (list 'IN (list gt 'x_) b)))
               (csep (list 'SEP 'mfx_ 'omega (list 'FORSOME 'mfk_ (list 'AND '(IN mfk_ NN) (list 'IN 'mfx_ (list cfam 'mfk_)))))))
          (dk-cite! 'sep-exists-family-in-sigma 'omega 'ca cfam)
          (dk-class-ext! pre csep
            (lambda (w)
              (dk-sep-parts! (list 'IN w pre))
              (dk-lam-b-h! (list 'IN (list gt w) b))
              (dk-split-all! (list (dk-apply! c1 w)))
              (in-sep! (lambda () (dk-ass!))
                       (lambda ()
                         (ew (cx w))
                         (dk-conj-close!
                           (lambda ()
                             (if (dk-ass!) #t
                                 (begin
                                   (dk-apply! cve (cx w))
                                   (subst (list '= (list cfam (cx w)) (ck (cx w))))
                                   (in-sep! (lambda () (dk-ass!)) (lambda () (dk-conj-close! dk-ass!))))))))))
            (lambda (w)
              (dk-sep-parts! (list 'IN w csep))
              (let ((k (dk-skolem! (dk-ctx-form (list 'FORSOME 'mfk_ (list 'AND '(IN mfk_ NN) (list 'IN w (list cfam 'mfk_))))))))
                (dk-apply! cve k)
                (dk-rewrite-h! (list 'IN w (list cfam k)) (list cfam k) (ck k))
                (dk-sep-parts! (list 'IN w (ck k)))
                (dk-split-all!)
                (dk-split-all! (list (dk-apply! c1 w)))
                (dk-cite! 'disjointed-seq-unique 'omega 'ca efam w (cx w) k)
                (in-sep! (lambda () (dk-ass!))
                         (lambda ()
                           (dk-lam-b!)
                           (subst (list '= (cx w) k))
                           (dk-ass!))))))
          (subst (list '= pre csep))
          (dk-ass!))))
    (dk-cite! 'measurable-map-intro 'omega 'ca '(PTS s) '(BOREL-SETS s) gt)
    (ew gt)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'FORALL)
            (let* ((w (dk-di-var!)))
              (dk-split-all! (list (dk-apply! c1 w)))
              (dk-lam-b!)
              (let* ((c (cx w)) (dc (list d c)) (fw (list 'f w)))
                (dk-cite! 'fun-apply-type-c 'f 'omega '(PTS s) w)
                (dk-cite! 'fun-apply-type-c d 'NN '(PTS s) c)
                (dk-iff-fwd! (dk-cite! 'complement-in-membership (list efam c) (mfs-bu efam c) w))
                (dk-apply! eve c)
                (dk-rewrite-h! (list 'IN w (list efam c)) (list efam c) (ek c))
                (dk-sep-parts! (list 'IN w (ek c)))
                (dk-iff-fwd! (dk-cite! 'ball-membership 's dc 'eps fw))
                (dk-cite! 'metric-dist-real 's dc fw)
                (dk-cite! 'metric-dist-real 's fw dc)
                (dk-cite! 'metric-sym 's fw dc)
                (dk-have-and! (list '<= (list '(DIST s) dc fw) 'eps) (list 'NOT (list '= (list '(DIST s) dc fw) 'eps)))
                (dk-cite! 'rr-le-ne-lt (list '(DIST s) dc fw) 'eps)
                (dk-ineq! (list '= (list '(DIST s) fw dc) (list '(DIST s) dc fw)) (list '< (list '(DIST s) dc fw) 'eps))))
            (let ((vals (list 'FORSOME 'stv_ (list 'AND '(IN stv_ (FUN NN (PTS s)))
                               (list 'FORALL 'stx_ (list 'IMPLIES '(IN stx_ omega)
                                 (list 'FORSOME 'stk_ (list 'AND '(IN stk_ NN) (list '= (list gt 'stx_) '(stv_ stk_))))))))))
              (dk-have! vals
                (lambda ()
                  (ew d)
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-ass!) #t
                          (let ((w (dk-di-var!)))
                            (dk-split-all! (list (dk-apply! c1 w)))
                            (ew (cx w))
                            (dk-conj-close!
                              (lambda ()
                                (if (dk-ass!) #t
                                    (begin
                                      (dk-cite! 'fun-apply-type-c d 'NN '(PTS s) (cx w))
                                      (if (not (dk-lam-b!)) (rfl))))))))))))
              (dk-have-and! (list 'IS-MEASURABLE-MAP 'omega 'ca '(PTS s) '(BOREL-SETS s) gt) vals)
              (dk-iff-bwd! (dk-cite! 'is-step-map 'omega 'ca 's gt))
              (dk-ass!)))))))
(mfs-qed! 'step-map-approximation)

;; ---------------------------------------------------------------------------
;; Prop 2.5: a sequence of step maps converging uniformly (|f - g_n| < 1/(n+1) everywhere)
(define (mfs-close g k) (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list '< (list '(DIST s) '(f x) (list g 'x)) (list 'RECIP (list '+ k 1))))))
(sp (make-wff (dk-foralls '(omega ca s f) (dk-curry
  '((IS-SEPARABLE s) (IS-MEASURABLE-MAP omega ca (PTS s) (BOREL-SETS s) f))
  (list 'FORSOME 'gs (list 'AND '(IN gs (FUN NN (FUN omega (PTS s))))
    (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
      (list 'AND '(IS-STEP-MAP omega ca s (gs n)) (mfs-close '(gs n) 'n))))))))))
(dk-peel!)
(let* ((cls '(FUN omega (PTS s)))
       (fam (list 'VNB-LAMBDA 'mfgk_ 'NN (list 'SEP 'mfgg_ cls (list 'AND '(IS-STEP-MAP omega ca s mfgg_) (mfs-close 'mfgg_ 'mfgk_)))))
       (memb (lambda (k) (list 'SEP 'mfgg_ cls (list 'AND '(IS-STEP-MAP omega ca s mfgg_) (mfs-close 'mfgg_ k))))))
  (dk-iff-parts! (dk-cite! 'is-measurable-map 'omega 'ca '(PTS s) '(BOREL-SETS s) 'f))
  (dk-iff-parts! (dk-cite! 'is-separable 's))
  (dk-cite! 'ms-pts-is-set 's)
  (dk-cite! 'sigma-algebra-ambient-set 'omega 'ca)
  (dk-have-and! '(IN omega SET) '(IN (PTS s) SET))
  (dk-iff-bwd! (dk-cite! 'fun-set-iff 'omega '(PTS s)))
  (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORSOME 'w (list 'AND (list 'IN 'w cls) (list 'IN 'w (list fam 'k))))))
    (lambda ()
      (let* ((k (dk-di-var!)) (r (list 'RECIP (list '+ k 1))))
        (dk-cite! 'nn-recip-succ-pos k)
        (let* ((g0 (dk-skolem! (dk-cite! 'step-map-approximation 'omega 'ca 's 'f r))))
          (dk-iff-parts! (dk-cite! 'is-step-map 'omega 'ca 's g0))
          (dk-cite! 'measurable-map-in-fun 'omega 'ca '(PTS s) '(BOREL-SETS s) g0)
          (ew g0)
          (dk-conj-close!
            (lambda ()
              (if (dk-ass!) #t
                  (begin
                    (dk-lam-b!)
                    (in-sep! (lambda () (dk-ass!)) (lambda () (dk-conj-close! dk-ass!)))))))))))
  (let* ((gs (dk-skolem! (dk-cite! 'rmm-nn-choice cls fam)))
         (all (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f gs))) (dk-asms))))
    (ew gs)
    (dk-conj-close!
      (lambda ()
        (if (dk-ass!) #t
            (let* ((n (dk-di-var!))
                   (h (dk-apply! all n)))
              (dk-lam-b-h! h)
              (dk-sep-parts! (list 'IN (list gs n) (memb n)))
              (dk-split-all!)
              (dk-conj-close! dk-ass!)))))))
(mfs-qed! 'step-map-uniform-limit)
