;;; removable-singularities.scm -- WAVE 2 (2026-10-27..30), wired 2026-10-30 from scratchpad/ch3e/ch3f-rem.scm.
;;; Library: complex-analysis.

;;; ch3f-rem.scm -- CH3-F: removable singularities (complex-analysis.pdf Def 3.38, Corollary 3.39,
;;; Proposition 4.3), with the two eps-delta bridges for continuity on an open u of CC.
;;;
;;;   cc-cont-at-mag      continuity at a (subspace form) ==> |z - a| < del implies |g z - g a| < eps
;;;   cc-cont-at-of-mag   the converse
;;;   removable-singularity        (3.39) f holomorphic on u \ {c}, extended continuously to u by g:
;;;                                g is holomorphic on u
;;;   removable-extension-unique   (3.39, "uniquely") two continuous extensions agree at c
;;;   riemann-removable   (4.3) f holomorphic on u \ {c} has a removable singularity at c iff it is
;;;                       bounded on B(c, r) \ {c} for some r > 0
;;;
;;; Library: complex-analysis.  Helper prefix: rf-.

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define rf-nf '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (rf-sub u) (list 'SUBSPACE-MS rf-nf u))
(define (rf-cont u g)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u)
    (list 'IS-CONTINUOUS-AT (rf-sub u) rf-nf g 'rgy_))))
(define (rf-V u c) (list 'DIFFERENCE u (list 'SINGLETON c)))
(define (rf-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "rf-pick: nothing matching" what) (car l))))
(define (rf-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (rf-mag! t) (rf-cc! t) (fact 'cc-magnitude-closed t) (fact 'cc-magnitude-nonneg t) (list 'magnitude t))
(define (rf-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))

;;; the standing facts about an open u of CC: u subset CC, u a set, the subspace's points, CC's points
(define (rf-open! u)
  (fact 'cc-is-metric-space)
  (fact 'nf-cc-is-metric-space)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl))))
  (fact 'nf-cc-agree-pts)
  (dk-cite! 'cc-open-subset-cc u)
  (fact 'cc-is-set)
  (if (not (dk-asm? (list 'IN u 'SET))) (fact 'subclass-of-set-is-set u 'CC))
  (fact 'subspace-pts rf-nf u)
  (if (not (dk-asm? (list 'SUBSET u (list 'PTS rf-nf))))
      (dk-have! (list 'SUBSET u (list 'PTS rf-nf))
        (lambda () (subst (list '== (list 'PTS rf-nf) '(PTS CC-MS))) (subst '(== (PTS CC-MS) CC)) (ass))))
  (fact 'subspace-is-metric-space rf-nf u))

;;; a, b in CC: (== ((DIST NF) a b) (magnitude (- a b)))
(define (rf-nfdist! a b)
  (let ((g (list '== (list (list 'DIST rf-nf) a b) (list 'magnitude (list '- a b)))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (rf-cc! a) (rf-cc! b)
            (dk-have! (list 'IN a '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
            (dk-have! (list 'IN b '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
            (fact 'nf-cc-agree-dist a b)
            (fact 'cc-ms-dist a b)
            (subst (list '== (list (list 'DIST rf-nf) a b) (list '(DIST CC-MS) a b)))
            (subst (list '== (list '(DIST CC-MS) a b) (list 'magnitude (list '- a b))))
            (rf-cc! (list '- a b))
            (qrfl))))
    g))
;;; a, b in u: (== ((DIST SUB) a b) (magnitude (- a b)))
(define (rf-subdist! u a b)
  (let ((g (list '== (list (list 'DIST (rf-sub u)) a b) (list 'magnitude (list '- a b)))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (fact 'subspace-dist rf-nf u a b)
            (fact 'subset-mem-fwd u 'CC a) (fact 'subset-mem-fwd u 'CC b)
            (rf-nfdist! a b)
            (subst (list '== (list (list 'DIST (rf-sub u)) a b) (list (list 'DIST rf-nf) a b)))
            (subst (list '== (list (list 'DIST rf-nf) a b) (list 'magnitude (list '- a b))))
            (rf-cc! (list '- a b))
            (qrfl))))
    g))

(define (rf-mag-stmt g a)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'del (list 'AND '(POS-RR del)
      (list 'FORALL 'z (list 'IMPLIES '(IN z u)
        (list 'IMPLIES (list '< (list 'magnitude (list '- 'z a)) 'del)
              (list '< (list 'magnitude (list '- (list g 'z) (list g a))) 'eps)))))))))

;;; ---------------------------------------------------------------------------
;;; continuity at a, in magnitudes
(sp (make-wff (forall-guarded '(u g a)
  (list (list 'IS-OPEN rf-nf 'u) '(IN g (FUN u CC)) '(IN a u) (list 'IS-CONTINUOUS-AT (rf-sub 'u) rf-nf 'g 'a))
  (rf-mag-stmt 'g 'a))))
(dk-peel!)
(rf-open! 'u)
(let* ((cont (rf-pick 'cont (lambda (f) (dk-head-is? f 'IS-CONTINUOUS-AT))))
       (rhs (caddr (dk-cite! 'is-continuous-at (rf-sub 'u) rf-nf 'g 'a)))
       (_u (dk-project! rhs 'is-continuous-at cont))
       (_s (dk-split-all! (list rhs)))
       (ccl (rf-pick 'ccl (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR) (dk-contains? f 'g))))))
  (let* ((_pk (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!)))
         (e (cadr (rf-pick 'pe (lambda (f) (dk-head-is? f 'POS-RR)))))
         (h (dk-halve! e))
         (del (dk-skolem! (dk-apply! ccl h) #t))
         (dcl (rf-pick 'dcl (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f del))))))
    (dk-pos-parts! e) (dk-pos-parts! h) (dk-pos-parts! del)
    (ew del)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
            (let* ((pl2 (dk-peel!)) (z (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) pl2))))
                   (az (list '- 'a z)) (za (list '- z 'a))
                   (fd (list '- (list 'g z) '(g a))) (fd2 (list '- '(g a) (list 'g z))))
              (fact 'subset-mem-fwd 'u 'CC z) (fact 'subset-mem-fwd 'u 'CC 'a)
              (fact 'fun-apply-type-c 'g 'u 'CC z) (fact 'fun-apply-type-c 'g 'u 'CC 'a)
              (rf-mag! az) (rf-mag! za) (rf-mag! fd) (rf-mag! fd2)
              (fact 'cc-magnitude-sub-sym 'a z)
              (fact 'cc-magnitude-sub-sym '(g a) (list 'g z))
              (dk-have! (list 'IN z (list 'PTS (rf-sub 'u))) (lambda () (subst (list '== (list 'PTS (rf-sub 'u)) 'u)) (ass)))
              (rf-subdist! 'u 'a z)
              (dk-have! (list '<= (list (list 'DIST (rf-sub 'u)) 'a z) del)
                (lambda () (subst (list '== (list (list 'DIST (rf-sub 'u)) 'a z) (list 'magnitude az)))
                           (dk-ineq! (list '= (list 'magnitude az) (list 'magnitude za)) (list '< (list 'magnitude za) del))))
              (dk-apply! dcl z)
              (rf-nfdist! '(g a) (list 'g z))
              (dk-have! (list '<= (list 'magnitude fd2) h)
                (lambda () (subst (list '== (list 'magnitude fd2) (list (list 'DIST rf-nf) '(g a) (list 'g z)))) (ass)))
              (dk-ineq! (list '= (list 'magnitude fd2) (list 'magnitude fd)) (list '<= (list 'magnitude fd2) h)
                        (rf-pick 'eqh (lambda (f) (and (dk-head-is? f '=) (dk-contains? f h) (dk-contains? f e))))
                        (list '< 0 h))))))))
(qed 'cc-cont-at-mag)

;;; ---------------------------------------------------------------------------
;;; the converse: magnitudes give continuity at a
(sp (make-wff (forall-guarded '(u g a)
  (list (list 'IS-OPEN rf-nf 'u) '(IN g (FUN u CC)) '(IN a u) (rf-mag-stmt 'g 'a))
  (list 'IS-CONTINUOUS-AT (rf-sub 'u) rf-nf 'g 'a))))
(dk-peel!)
(rf-open! 'u)
(let ((mg (rf-pick 'mg (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR))))))
  (mac 'is-continuous-at)
  (dk-conj-close!
    (lambda ()
      (let ((gl (dk-goal)))
        (cond
         ((dk-asm? gl) (ass))
         ((dk-head-is? gl 'IN)
          (subst (list '== (list 'PTS (rf-sub 'u)) 'u))
          (if (dk-contains? (dk-goal) (list 'PTS rf-nf)) (subst (list '== (list 'PTS rf-nf) '(PTS CC-MS))))
          (if (dk-contains? (dk-goal) '(PTS CC-MS)) (subst '(== (PTS CC-MS) CC)))
          (if (dk-asm? (dk-goal)) (ass)))
         ((dk-head-is? gl 'FORALL)
          (let* ((pl (dk-peel!)) (e (cadr (car (filter (lambda (f) (dk-head-is? f 'POS-RR)) pl))))
                 (del (dk-skolem! (dk-apply! mg e) #t))
                 (dcl (rf-pick 'dcl (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f del)))))
                 (_p (dk-pos-parts! del))
                 (h (dk-halve! del)))
            (dk-pos-parts! e) (dk-pos-parts! h)
            (ew h)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (ass)
                    (let* ((pl2 (dk-peel!))
                           (b (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) (list 'PTS (rf-sub 'u))))) pl2))))
                           (ba (list '- b 'a)) (ab (list '- 'a b))
                           (fd (list '- (list 'g b) '(g a))) (fd2 (list '- '(g a) (list 'g b))))
                      (dk-have! (list 'IN b 'u) (lambda () (subst (list '== 'u (list 'PTS (rf-sub 'u)))) (ass)))
                      (fact 'subset-mem-fwd 'u 'CC b) (fact 'subset-mem-fwd 'u 'CC 'a)
                      (fact 'fun-apply-type-c 'g 'u 'CC b) (fact 'fun-apply-type-c 'g 'u 'CC 'a)
                      (rf-mag! ba) (rf-mag! ab) (rf-mag! fd) (rf-mag! fd2)
                      (fact 'cc-magnitude-sub-sym 'a b)
                      (fact 'cc-magnitude-sub-sym '(g a) (list 'g b))
                      (rf-subdist! 'u 'a b)
                      (dk-rewrite-h! (list '<= (list (list 'DIST (rf-sub 'u)) 'a b) h) (list (list 'DIST (rf-sub 'u)) 'a b) (list 'magnitude ab))
                      (dk-have! (list '< (list 'magnitude ba) del)
                        (lambda () (dk-ineq! (list '= (list 'magnitude ab) (list 'magnitude ba)) (list '<= (list 'magnitude ab) h)
                                             (rf-pick 'eqh (lambda (f) (and (dk-head-is? f '=) (dk-contains? f h) (dk-contains? f del))))
                                             (list '< 0 h))))
                      (dk-apply! dcl b)
                      (rf-nfdist! '(g a) (list 'g b))
                      (subst (list '== (list (list 'DIST rf-nf) '(g a) (list 'g b)) (list 'magnitude fd2)))
                      (dk-ineq! (list '= (list 'magnitude fd2) (list 'magnitude fd)) (list '< (list 'magnitude fd) e))))))))
         (#t (ass)))))))
(qed 'cc-cont-at-of-mag)

;;; ---------------------------------------------------------------------------
;;; COROLLARY 3.39 (with Definition 3.38): a function holomorphic on u \ {c} and continuously extended
;;; to the open set u by g: the extension g is holomorphic on u
(define (rf-V-setup! u c)                      ; V = u \ {c}: V subset u
  (let ((V (rf-V u c)))
    (if (not (dk-asm? (list 'SUBSET V u)))
        (dk-have! (list 'SUBSET V u)
          (lambda () (let ((z (subset-by-element!))) (fact 'difference-membership u (list 'SINGLETON c) z) (prop)))))
    V))
(sp (make-wff (forall-guarded '(u c f g)
  (list (list 'IS-OPEN rf-nf 'u) '(IN c u) (list 'HOLOMORPHIC-ON (rf-V 'u 'c) 'f)
        '(IN g (FUN u CC)) (rf-cont 'u 'g)
        (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z (rf-V 'u 'c)) '(= (g z) (f z)))))
  '(HOLOMORPHIC-ON u g))))
(dk-peel!)
(let* ((V (rf-V-setup! 'u 'c)) (gV (list 'RESTRICT 'g V))
       (ext (rf-pick 'ext (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(f z)))))))
  (dk-cite! 'restrict-in-fun 'g 'u 'CC V)
  (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ V) (list '== (list gV 'hbx_) '(f hbx_))))
    (lambda () (let ((x (dk-di-var!)))
                 (fact 'subset-mem-fwd V 'u x)
                 (dk-cite! 'restrict-apply 'g V x)
                 (subst (list '= (list gV x) (list 'g x)))
                 (inst*! ext x)
                 (subst (list '= (list 'g x) (list 'f x)))
                 (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass) (qrfl))))))
  (dk-fact! 'holomorphic-transfer-ptwise-eq V gV 'f)
  (dk-fact! 'goursat-triangle-except 'u 'g 'c)
  (dk-fact! 'morera 'u 'g)
  (if (dk-asm? (dk-goal)) (ass)))
(qed 'removable-singularity)

;;; ---------------------------------------------------------------------------
;;; points of V = u \ {c}
(define (rf-sub-nz! y c)                       ; y, c in CC, y /= c in context: y - c /= 0
  (let ((nz (list 'NOT (list '= (list '- y c) 0))))
    (if (not (dk-asm? nz))
        (dk-have! nz (lambda () (di) (dk-cite! 'cc-sub-zero-eq y c) (ai (dk-ctx-form (list 'NOT (list '= y c)))))))
    nz))
(define (rf-dpt-open! u c y)                   ; y in V: y in u, y in CC, y /= c, y - c /= 0
  (let ((iff (dk-cite! 'difference-membership u (list 'SINGLETON c) y)))
    (if (not (dk-asm? (list 'IN y u)))
        (dk-have! (list 'IN y u) (lambda () (if (dk-only! iff (list 'IN y (rf-V u c))) (prop)))))
    (fact 'subset-mem-fwd u 'CC y)
    (fact 'membership-implies-sethood y u)
    (fact 'singleton-membership c y)
    (if (not (dk-asm? (list 'NOT (list '= y c))))
        (dk-have! (list 'NOT (list '= y c))
          (lambda () (if (dk-only! iff (list 'IN y (rf-V u c)) (list 'IN y 'SET)
                               (dk-ctx-form (list 'IFF (list 'IN y (list 'SINGLETON c)) (list 'AND (list 'IN y 'SET) (list '= y c)))))
                       (prop)))))
    (rf-sub-nz! y c)))
(define (rf-dpt-in! u c y)                     ; y in u, y /= c in context: y in V
  (let ((iff (dk-cite! 'difference-membership u (list 'SINGLETON c) y)))
    (fact 'membership-implies-sethood y u)
    (fact 'singleton-membership c y)
    (if (not (dk-asm? (list 'IN y (rf-V u c))))
        (dk-have! (list 'IN y (rf-V u c))
          (lambda () (if (dk-only! iff (list 'IN y u) (list 'NOT (list '= y c))
                               (dk-ctx-form (list 'IFF (list 'IN y (list 'SINGLETON c)) (list 'AND (list 'IN y 'SET) (list '= y c)))))
                       (prop)))))))
;;; u open: a ball about y in u lies in u; returns the radius (POS-RR, in RR, 0 < r landed)
(define (rf-ball! u y)
  (let* ((oiff (dk-cite! 'cc-ms-open-iff u)))
    (if (not (dk-asm? (list 'IS-OPEN 'CC-MS u)))
        (dk-have! (list 'IS-OPEN 'CC-MS u) (lambda () (if (dk-only! oiff (list 'IS-OPEN rf-nf u)) (prop)))))
    (let ((ob (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y u) (list 'FORSOME 'r (list 'AND '(POS-RR r) (list 'SUBSET '(BALL CC-MS y r) u)))))))
      (if (not (dk-asm? ob)) (dk-project! ob (lambda () (mac-h 'IS-OPEN (list 'IS-OPEN 'CC-MS u)) (dk-split-all!))))
      (let ((r (dk-skolem! (dk-apply! (dk-ctx-form ob) y) #t)))
        (dk-pos-parts! r)
        r))))
;;; z, y in CC, |z - y| < r: z in BALL(CC-MS, y, r)
(define (rf-in-ball! z y r)
  (let ((g (list 'IN z (list 'BALL 'CC-MS y r))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda ()
                      (let ((bi (dk-cite! 'cc-ms-ball-membership y r z)))
                        (fact 'cc-magnitude-sub-sym z y)
                        (rf-mag! (list '- y z)) (rf-mag! (list '- z y))
                        (dk-have! (list '< (list 'magnitude (list '- z y)) r)
                          (lambda () (dk-ineq! (list '< (list 'magnitude (list '- y z)) r)
                                               (list '= (list 'magnitude (list '- y z)) (list 'magnitude (list '- z y))))))
                        (if (dk-only! bi (list 'IN z 'CC) (list '< (list 'magnitude (list '- z y)) r)) (prop))))))
    g))

;;; ---------------------------------------------------------------------------
;;; PROPOSITION 4.3 (Riemann): f holomorphic on u \ {c} has a removable singularity at c (Def 3.38: a
;;; continuous extension to u) if and only if f is bounded on B(c, r) \ {c} for some r > 0
(define (rf-rem u c f)
  (list 'FORSOME 'rfg_ (list 'AND (list 'IN 'rfg_ (list 'FUN u 'CC)) (list 'AND (rf-cont u 'rfg_)
    (list 'FORALL 'rfz_ (list 'IMPLIES (list 'IN 'rfz_ (rf-V u c)) (list '= '(rfg_ rfz_) (list f 'rfz_))))))))
(define (rf-bnd u c f)
  (list 'FORSOME 'rfr_ (list 'AND '(POS-RR rfr_) (list 'FORSOME 'rfm_ (list 'AND '(IN rfm_ RR)
    (list 'FORALL 'rfz_ (list 'IMPLIES (list 'IN 'rfz_ (rf-V u c))
      (list 'IMPLIES (list '< (list 'magnitude (list '- 'rfz_ c)) 'rfr_) (list '<= (list 'magnitude (list f 'rfz_)) 'rfm_)))))))))
(sp (make-wff (forall-guarded '(u c f) (list (list 'IS-OPEN rf-nf 'u) '(IN c u) (list 'HOLOMORPHIC-ON (rf-V 'u 'c) 'f))
  (list 'IFF (rf-rem 'u 'c 'f) (rf-bnd 'u 'c 'f)))))
(dk-peel!)
(rf-open! 'u)
(define rf-Vc (rf-V-setup! 'u 'c))
(dk-cite! 'holomorphic-on-in-fun rf-Vc 'f)
(dk-cite! 'holomorphic-on-open rf-Vc 'f)
(fact 'subset-mem-fwd 'u 'CC 'c)
(dk-have! '(IN 0 RR)) (dk-have! '(IN 1 RR)) (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
(fact 'cc-zero-in)
(dk-iff! (lambda (g) (and (dk-head-is? g 'FORSOME) (eq? (cadr g) 'rfr_)))
 ;; necessity: a continuous extension is bounded near c
 (lambda ()
   (let* ((g (dk-skolem! (rf-pick 'eg (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'rfg_)))) #t))
          (_s (dk-split-all!))
          (ext (rf-pick 'ext (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f (list g 'rfz_))))))
          (cc (rf-pick 'cc (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-CONTINUOUS-AT) (dk-contains? f g)))))
          (_c (inst*! cc 'c))
          (_r1 (fact 'rr-pos-rr-of-lt 1))
          (mg (dk-fact! 'cc-cont-at-mag 'u g 'c))
          (del (dk-skolem! (dk-apply! mg 1) #t))
          (dcl (rf-pick 'dcl (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f del)))))
          (gc (list g 'c)) (M (list '+ (list 'magnitude gc) 1)))
     (fact 'fun-apply-type-c g 'u 'CC 'c)
     (rf-mag! gc)
     (ew del)
     (dk-conj-close!
       (lambda ()
         (let ((gl (dk-goal)))
           (cond ((dk-asm? gl) (ass))
                 ((dk-head-is? gl 'FORSOME)
                  (ew M)
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-head-is? (dk-goal) 'IN) (dk-have! (dk-goal) (lambda () (type-term)))
                          (let* ((pl (dk-peel!))
                                 (z (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) rf-Vc))) pl))))
                                 (gz (list g z)) (d (list '- gz gc)))
                            (rf-dpt-open! 'u 'c z)
                            (fact 'fun-apply-type-c g 'u 'CC z)
                            (rf-mag! d) (rf-mag! gz)
                            (dk-apply! dcl z)
                            (inst*! ext z)
                            (subst (list '= (list 'f z) gz))
                            (dk-have! (list '= gz (list '+ d gc)) (lambda () (crs)))
                            (rf-and! (list 'IN d 'CC) (list 'IN gc 'CC))
                            (fact 'cc-magnitude-triangle d gc)
                            (dk-rewrite-h! (list '<= (list 'magnitude (list '+ d gc)) (list '+ (list 'magnitude d) (list 'magnitude gc)))
                                           (list '+ d gc) gz)
                            (dk-ineq! (list '<= (list 'magnitude gz) (list '+ (list 'magnitude d) (list 'magnitude gc)))
                                      (list '< (list 'magnitude d) 1)))))))
                 (#t (ass))))))))
 ;; sufficiency: h(z) = (z - c) f(z), h(c) = 0 is continuous, hence holomorphic (3.39); its difference
 ;; quotient at c is the extension
 (lambda ()
   (let* ((r (dk-skolem! (rf-pick 'er (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'rfr_)))) #t))
          (_s (dk-split-all!))
          (M (dk-skolem! (rf-pick 'em (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'rfm_)))) #t))
          (_s2 (dk-split-all!))
          (bd (rf-pick 'bd (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f M)))))
          (h (list 'VNB-LAMBDA 'rfq_ 'u (list 'IF '(= rfq_ c) 0 '(* (- rfq_ c) (f rfq_)))))
          (Fq (list 'VNB-LAMBDA 'rfq_ rf-Vc '(* (- rfq_ c) (f rfq_)))))
     (dk-pos-parts! r)
     (define (fv! z)                           ; z in V: f z typed, (= (h z) (* (- z c) (f z))), (= (F z) ...)
       (rf-dpt-open! 'u 'c z)
       (fact 'fun-apply-type-c 'f rf-Vc 'CC z)
       (let ((val (list '* (list '- z 'c) (list 'f z))))
         (rf-cc! val)
         (if (not (dk-asm? (list '= (list h z) val)))
             (dk-have! (list '= (list h z) val)
               (lambda () (dk-lam-b!)
                          (dk-if-branch! #f (list 'IF (list '= z 'c) 0 val) #f (lambda () (if (not (proof-done? *ps*)) (rfl)))))))
         (if (not (dk-asm? (list '= (list Fq z) val)))
             (dk-have! (list '= (list Fq z) val) (lambda () (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl)))))
         val))
     (dk-have! (list '= (list h 'c) 0)
       (lambda () (dk-lam-b!) (dk-have! '(= c c) (lambda () (rfl)))
                  (dk-if-branch! #t (list 'IF '(= c c) 0 '(* (- c c) (f c))) #f (lambda () (if (not (proof-done? *ps*)) (rfl))))))
     ;; h in FUN(u, CC)
     (dk-have! (list 'IN h '(FUN u CC))
       (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!)))
                                            (dk-case-if! (list 'IF (list '= z 'c) 0 (list '* (list '- z 'c) (list 'f z)))
                                              (lambda (tv val)
                                                (if (not tv) (begin (rf-dpt-in! 'u 'c z) (rf-dpt-open! 'u 'c z)
                                                                    (fact 'fun-apply-type-c 'f rf-Vc 'CC z) (rf-cc! val)))
                                                (if (dk-asm? (dk-goal)) (ass))))))
                                (lambda () (ass)))))
     ;; F holomorphic on V
     (dk-have! (list 'HOLOMORPHIC-ON rf-Vc Fq) (lambda () (dk-holomorphic! rf-Vc Fq)))
     (dk-cite! 'holomorphic-on-in-fun rf-Vc Fq)
     ;; K = |M| + 1 bounds f near c, and K > 0
     (let* ((K (list '+ (list 'abs M) 1)))
       (fact 'rr-abs-closed M) (fact 'rr-abs-nonneg M) (fact 'rr-le-abs M)
       (dk-real! K)
       (dk-have! (list '< 0 K) (lambda () (dk-ineq! (list '<= 0 (list 'abs M)))))
       (dk-have! (list '<= M K) (lambda () (dk-ineq! (list '<= M (list 'abs M)))))
       (fact 'rr-pos-ne-zero K)
       (rf-and! (list 'IN K 'RR) (list 'NOT (list '= K 0)))
       (fact 'rr-recip-closed K) (fact 'rr-recip-pos K)
       ;; h continuous on u
       (dk-have! (rf-cont 'u h)
         (lambda ()
           (let ((y (dk-di-var!)))
             (fact 'subset-mem-fwd 'u 'CC y)
             (dk-have! (rf-mag-stmt h y)
               (lambda ()
                 (let* ((_pk (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!)))
                        (e (cadr (rf-pick 'pe (lambda (f) (and (dk-head-is? f 'POS-RR) (not (equal? (cadr f) r))))))))
                   (dk-pos-parts! e)
                   (use-em (list '= y 'c)
                     ;; at c
                     (lambda ()
                       (let* ((et (list '* e (list 'recip K))))
                         (dk-real! et)
                         (fact 'rr-mul-pos e (list 'recip K))
                         (fact 'rr-recip-cancel-right e K)
                         (let* ((v (dk-name! et)))
                           (dk-rewrite-h! (list '< 0 et) et v)
                           (dk-rewrite-h! (list '= e (list '* et K)) et v)
                           (let* ((w (dk-skolem! (dk-fact! 'rr-min-pos r v) #t)) (_w (dk-split-all!)))
                             (fact 'rr-pos-rr-of-lt w)
                             (ew w)
                             (dk-conj-close!
                               (lambda ()
                                 (if (dk-asm? (dk-goal)) (ass)
                                     (let* ((pl (dk-peel!))
                                            (z (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'u))) pl)))))
                                       (fact 'subset-mem-fwd 'u 'CC z)
                                       (subst (list '= y 'c))
                                       (rf-mag! (list '- z 'c))
                                       (if (not (eq? y 'c)) (dk-rewrite-h! (list '< (list 'magnitude (list '- z y)) w) y 'c))
                                       (use-em (list '= z 'c)
                                         (lambda ()
                                           (subst (list '= z 'c))
                                           (subst (list '= (list h 'c) 0))
                                           (dk-have! '(= (- 0 0) 0) (lambda () (crs)))
                                           (subst '(= (- 0 0) 0))
                                           (fact 'cc-magnitude-zero)
                                           (subst '(= (magnitude 0) 0))
                                           (dk-ineq! (list '< 0 e)))
                                         (lambda ()
                                           (rf-dpt-in! 'u 'c z)
                                           (let* ((val (fv! z)) (d (list '- z 'c)) (fz (list 'f z))
                                                  (mzc (list 'magnitude d)) (mf (list 'magnitude fz)))
                                             (subst (list '= (list h z) val))
                                             (subst (list '= (list h 'c) 0))
                                             (dk-have! (list '= (list '- val 0) val) (lambda () (crs)))
                                             (subst (list '= (list '- val 0) val))
                                             (rf-and! (list 'IN d 'CC) (list 'IN fz 'CC))
                                             (fact 'cc-magnitude-mul d fz)
                                             (subst (list '= (list 'magnitude val) (list '* mzc mf)))
                                             (rf-mag! fz)
                                             (dk-have! (list '< mzc r) (lambda () (dk-ineq! (list '< mzc w) (list '<= w r))))
                                             (inst*! bd z)
                                             (dk-have! (list '<= mf K) (lambda () (dk-ineq! (list '<= mf M) (list '<= M K))))
                                             (rf-and! (list '<= 0 mzc) (list '<= mf K))
                                             (fact 'rr-le-scale-nonneg mzc mf K)
                                             (dk-have! (list '<= mzc w) (lambda () (dk-ineq! (list '< mzc w))))
                                             (dk-have! (list '<= 0 K) (lambda () (dk-ineq! (list '< 0 K))))
                                             (rf-and! (list '<= 0 K) (list '<= w v))
                                             (fact 'rr-le-scale-nonneg-right w v K)
                                             (let ((wm (list '- w mzc)))
                                               (dk-real! wm)
                                               (dk-have! (list '< 0 wm) (lambda () (dk-ineq! (list '< mzc w))))
                                               (fact 'rr-mul-pos wm K)
                                               (dk-real! (list '* wm K)) (dk-real! (list '* w K)) (dk-real! (list '* mzc K))
                                               (dk-real! (list '* v K)) (dk-real! (list '* mzc mf))
                                               (dk-have! (list '= (list '* wm K) (list '- (list '* w K) (list '* mzc K))) (lambda () (crs)))
                                               (dk-ineq! (list '<= (list '* mzc mf) (list '* mzc K))
                                                         (list '< 0 (list '* wm K))
                                                         (list '= (list '* wm K) (list '- (list '* w K) (list '* mzc K)))
                                                         (list '<= (list '* w K) (list '* v K))
                                                         (list '= e (list '* v K)))))))))))))))
                     ;; off c: h agrees with F near y, and F is continuous at y
                     (lambda ()
                       (rf-dpt-in! 'u 'c y)
                       (fv! y)
                       (dk-cite! 'cc-open-subset-cc rf-Vc)
                       (inst*! (dk-cite! 'holomorphic-on-continuous rf-Vc Fq) y)
                       (let* ((mg (dk-fact! 'cc-cont-at-mag rf-Vc Fq y))
                              (d1 (dk-skolem! (dk-apply! mg e) #t))
                              (cl (rf-pick 'cl (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d1)))))
                              (_p (dk-pos-parts! d1))
                              (rho (rf-ball! rf-Vc y))
                              (w (dk-skolem! (dk-fact! 'rr-min-pos d1 rho) #t)) (_w (dk-split-all!)))
                         (fact 'rr-pos-rr-of-lt w)
                         (ew w)
                         (dk-conj-close!
                           (lambda ()
                             (if (dk-asm? (dk-goal)) (ass)
                                 (let* ((pl (dk-peel!))
                                        (z (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'u))) pl))))
                                        (B (list 'BALL 'CC-MS y rho)))
                                   (fact 'subset-mem-fwd 'u 'CC z)
                                   (rf-mag! (list '- z y))
                                   (dk-have! (list '< (list 'magnitude (list '- z y)) rho)
                                     (lambda () (dk-ineq! (list '< (list 'magnitude (list '- z y)) w) (list '<= w rho))))
                                   (dk-have! (list '< (list 'magnitude (list '- z y)) d1)
                                     (lambda () (dk-ineq! (list '< (list 'magnitude (list '- z y)) w) (list '<= w d1))))
                                   (rf-in-ball! z y rho)
                                   (fact 'subset-mem-fwd B rf-Vc z)
                                   (let* ((vz (fv! z)) (vy (fv! y)))
                                     (inst*! cl z)
                                     (subst (list '= (list h z) vz))
                                     (subst (list '= (list h y) vy))
                                     (subst (list '= vz (list Fq z)))
                                     (subst (list '= vy (list Fq y)))
                                     (if (dk-asm? (dk-goal)) (ass)))))))))))))
             (fact 'cc-cont-at-of-mag 'u h y)
             (if (dk-asm? (dk-goal)) (ass)))))
       ;; h is holomorphic on u (3.39), and its difference quotient at c extends f
       (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z rf-Vc) (list '= (list h 'z) (list Fq 'z))))
         (lambda () (let ((z (dk-di-var!))) (fv! z) (subst (list '= (list h z) (list '* (list '- z 'c) (list 'f z))))
                      (subst (list '= (list '* (list '- z 'c) (list 'f z)) (list Fq z))) (if (not (proof-done? *ps*)) (rfl)))))
       (dk-fact! 'removable-singularity 'u 'c Fq h)
       (let* ((dq (inst*! (dk-fact! 'holomorphic-difference-quotient 'u h) 'c))
              (q (dk-skolem! dq #t)) (_s3 (dk-split-all!))
              (qe (rf-pick 'qe (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f q) (dk-contains? f '-))))))
         (ew q)
         (dk-conj-close!
           (lambda ()
             (if (dk-asm? (dk-goal)) (ass)
                 (let* ((x (dk-di-var!)) (val (fv! x)) (d (list '- x 'c)) (fx (list 'f x)) (qx (list q x)))
                   (fact 'fun-apply-type-c q 'u 'CC x)
                   (inst*! qe x)
                   (dk-rewrite-h! (list '= (list '- (list h x) (list h 'c)) (list '* qx d)) (list h x) val)
                   (dk-rewrite-h! (list '= (list '- val (list h 'c)) (list '* qx d)) (list h 'c) 0)
                   (rf-cc! d)
                   (rf-and! (list 'IN d 'CC) (list 'NOT (list '= d 0)))
                   (fact 'cc-recip-closed d) (fact 'cc-recip-inverse d)
                   (let ((rd (dk-name! (list 'recip d) 'CC)))
                     (dk-rewrite-h! (list '= (list '* d (list 'recip d)) 1) (list 'recip d) rd)
                     (dk-have! (list '= (list '* qx d) (list '* d fx))
                       (lambda () (subst (list '= (list '* qx d) (list '- val 0))) (crs)))
                     (dk-have! (list '= qx (list '* (list '* qx d) rd))
                       (lambda () (dk-have! (list '= (list '* (list '* qx d) rd) (list '* qx (list '* d rd))) (lambda () (crs)))
                                  (subst (list '= (list '* (list '* qx d) rd) (list '* qx (list '* d rd))))
                                  (subst (list '= (list '* d rd) 1)) (crs)))
                     (dk-have! (list '= fx (list '* (list '* d fx) rd))
                       (lambda () (dk-have! (list '= (list '* (list '* d fx) rd) (list '* fx (list '* d rd))) (lambda () (crs)))
                                  (subst (list '= (list '* (list '* d fx) rd) (list '* fx (list '* d rd))))
                                  (subst (list '= (list '* d rd) 1)) (crs)))
                     (subst (list '= qx (list '* (list '* qx d) rd)))
                     (subst (list '= (list '* qx d) (list '* d fx)))
                     (subst (list '= (list '* (list '* d fx) rd) fx))
                     (if (not (proof-done? *ps*)) (rfl))))))))))))
(qed 'riemann-removable)

;;; ---------------------------------------------------------------------------
;;; COROLLARY 3.39, "uniquely": two extensions continuous at c that agree off c agree at c
(sp (make-wff (forall-guarded '(u c g k)
  (list (list 'IS-OPEN rf-nf 'u) '(IN c u) '(IN g (FUN u CC)) '(IN k (FUN u CC))
        (list 'IS-CONTINUOUS-AT (rf-sub 'u) rf-nf 'g 'c) (list 'IS-CONTINUOUS-AT (rf-sub 'u) rf-nf 'k 'c)
        (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z (rf-V 'u 'c)) '(= (g z) (k z)))))
  '(= (g c) (k c)))))
(dk-peel!)
(rf-open! 'u)
(rf-V-setup! 'u 'c)
(fact 'subset-mem-fwd 'u 'CC 'c)
(fact 'fun-apply-type-c 'g 'u 'CC 'c) (fact 'fun-apply-type-c 'k 'u 'CC 'c)
(let* ((agree (rf-pick 'agree (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(k z))))))
       (gc '(g c)) (kc '(k c)) (dd (list '- gc kc)) (D (rf-mag! dd)))
  (use-em (list '= dd 0)
    (lambda () (dk-cite! 'cc-sub-zero-eq gc kc) (if (dk-asm? (dk-goal)) (ass)))
    (lambda ()
      (let ((zi (dk-cite! 'cc-magnitude-zero-iff dd)))
        (dk-have! (list 'NOT (list '= D 0)) (lambda () (if (dk-only! zi (list 'NOT (list '= dd 0))) (prop))))
        (dk-have! (list '< 0 D)
          (lambda () (mac '<)
                     (dk-conj-close!
                       (lambda () (if (dk-asm? (dk-goal)) (ass)
                                      (begin (di) (dk-have! (list '= D 0) (lambda () (subst (list '= D 0)) (rfl)))
                                             (ai (list 'NOT (list '= D 0)))))))))
        (fact 'rr-pos-rr-of-lt D)
        (let* ((e (dk-halve! D))
               (eqe (rf-pick 'eqe (lambda (f) (and (dk-head-is? f '=) (dk-contains? f e) (dk-contains? f D)))))
               (_p (dk-pos-parts! e))
               (d1 (dk-skolem! (dk-apply! (dk-fact! 'cc-cont-at-mag 'u 'g 'c) e) #t))
               (c1 (rf-pick 'c1 (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d1)))))
               (d2 (dk-skolem! (dk-apply! (dk-fact! 'cc-cont-at-mag 'u 'k 'c) e) #t))
               (c2 (rf-pick 'c2 (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d2)))))
               (_q (begin (dk-pos-parts! d1) (dk-pos-parts! d2)))
               (rho (rf-ball! 'u 'c))
               (w1 (dk-skolem! (dk-fact! 'rr-min-pos d1 d2) #t)) (_a (dk-split-all!))
               (w (dk-skolem! (dk-fact! 'rr-min-pos w1 rho) #t)) (_b (dk-split-all!))
               (_r (fact 'rr-pos-rr-of-lt w))
               (hw (dk-halve! w))
               (_h (dk-pos-parts! hw))
               (z (list '+ 'c hw)) (zc (list '- z 'c)))
          (fact 'rr-subset-cc hw)
          (rf-cc! z) (rf-cc! zc)
          (dk-have! (list '= zc hw) (lambda () (crs)))
          (fact 'rr-magnitude-is-abs hw)
          (dk-have! (list '<= 0 hw) (lambda () (dk-ineq! (list '< 0 hw))))
          (fact 'rr-abs-of-nonneg hw)
          (dk-have! (list '= (list 'magnitude zc) hw)
            (lambda () (subst (list '= zc hw)) (subst (list '= (list 'magnitude hw) (list 'abs hw))) (subst (list '= (list 'abs hw) hw)) (rfl)))
          (rf-mag! zc)
          (dk-have! (list '< (list 'magnitude zc) rho)
            (lambda () (dk-ineq! (list '= (list 'magnitude zc) hw) (rf-pick 'eqw (lambda (f) (and (dk-head-is? f '=) (dk-contains? f hw) (dk-contains? f w))))
                                 (list '< 0 hw) (list '<= w rho))))
          (rf-in-ball! z 'c rho)
          (fact 'subset-mem-fwd (list 'BALL 'CC-MS 'c rho) 'u z)
          (dk-have! (list 'NOT (list '= z 'c))
            (lambda () (di) (dk-have! (list '= zc 0) (lambda () (subst (list '= z 'c)) (crs)))
                       (dk-have! (list '= hw 0) (lambda () (subst (list '= hw zc)) (ass)))
                       (dk-absurd! (list '= hw 0) (list '< 0 hw))))
          (rf-dpt-in! 'u 'c z)
          (inst*! agree z)
          (fact 'fun-apply-type-c 'g 'u 'CC z) (fact 'fun-apply-type-c 'k 'u 'CC z)
          (let* ((wl (rf-pick 'eqw2 (lambda (f) (and (dk-head-is? f '=) (dk-contains? f hw) (dk-contains? f w)))))
                 (_x (dk-have! (list '< (list 'magnitude zc) d1)
                       (lambda () (dk-ineq! (list '= (list 'magnitude zc) hw) wl (list '< 0 hw) (list '<= w w1) (list '<= w1 d1)))))
                 (_y (dk-have! (list '< (list 'magnitude zc) d2)
                       (lambda () (dk-ineq! (list '= (list 'magnitude zc) hw) wl (list '< 0 hw) (list '<= w w1) (list '<= w1 d2)))))
                 (gz (list 'g z)) (kz (list 'k z))
                 (a1 (list '- gz gc)) (a2 (list '- kz kc)))
            (inst*! c1 z) (inst*! c2 z)
            (rf-mag! a1) (rf-mag! a2)
            ;; D = |g c - k c| <= |g z - g c| + |k z - k c|  (g z = k z)
            (dk-have! (list '= dd (list '- a2 a1)) (lambda () (subst (list '= gz kz)) (crs)))
            (rf-and! (list 'IN a2 'CC) (list 'IN a1 'CC))
            (fact 'cc-magnitude-sub-triangle a2 a1)
            (dk-rewrite-h! (list '<= (list 'magnitude (list '- a2 a1)) (list '+ (list 'magnitude a2) (list 'magnitude a1))) (list '- a2 a1) dd)
            (dk-absurd! (list '<= D (list '+ (list 'magnitude a2) (list 'magnitude a1)))
                        (list '< (list 'magnitude a1) e) (list '< (list 'magnitude a2) e) eqe)))))))
(qed 'removable-extension-unique)

  
