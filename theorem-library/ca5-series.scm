           (fact 'cc-open-subset-cc 'u)
           (fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC)
           (fact 'cc-is-normed-field)
           (ca5x-nn! sk)
           (ca5-apply! ih 'u 'g z)
           (ca5-gi-hol! k)
           (ca5-dser-typ! z)
           (fact 'cc-series-partial-sum-in-cc k dz)
           (let* ((l (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff 'u (list 'g k)) z)))
                  (dvk (list 'DERIV-ON 'CC-NORMED-FIELD 'u (list 'g k) z)))
             (dk-cite! 'cc-deriv-on-of-is-diff-on 'u (list 'g k) z l)
             (ca5v-deriv-typ! (list 'g k) z)
             (dk-have! (list 'IN l 'CC) (lambda () (subst (list '= l dvk)) (ass)))
             (dk-have! (list 'IN (list dz k) 'CC) (lambda () (ca5-gbeta!) (ca5-gopen!)))
             ;; the derivative: PS(dz, succ k) = PS(dz, k) + l
             (dk-cite! 'cc-series-partial-sum-succ dz k)
             (subst (list '= (list 'CC-SERIES-PARTIAL-SUM dz sk) (list '+ psk (list dz k))))
             (ca5-gbeta!)
             (subst (list '= dvk l))
             ;; the sum rule, its derivative brought to +
             (let* ((sm (dk-cite! 'diff-on-sum 'CC-NORMED-FIELD 'u (ca5-pfam k) (list 'g k) z psk l))
                    (ad (list (list 'ADD 'CC-NORMED-FIELD) psk l))
