(dk-peel!)
(fact 'cc-is-metric-space) (ca5v-pts-cc!)
(let* ((r1 '(recip (+ n 1))) (h (list '* 1/2 r1)) (m '(+ (* 4 n) 3)) (r4 '(recip (+ (+ (* 4 n) 3) 1))))
  (dk-split-all! (list (dk-cite! 'cc-exhaust-membership 'u 'n 'y)))
  (dk-have! (list 'AND '(IN y CC) (list 'AND '(<= (magnitude y) n) (list 'SUBSET (list 'BALL 'CC-MS 'y r1) 'u)))
