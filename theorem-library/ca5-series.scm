;;; ======================================================================
;;; (2) PROPOSITION 5.22, first half: the derived series of a series of holomorphic functions
;;;     normally convergent on every K_n is normally convergent on every K_n
;;; ======================================================================
(define ca5-gdf '(VNB-LAMBDA cdi_ NN (VNB-LAMBDA cdz_ u (DERIV-ON CC-NORMED-FIELD u (g cdi_) cdz_))))
(define (ca5-gdi i) (list 'VNB-LAMBDA 'cdz_ 'u (list 'DERIV-ON 'CC-NORMED-FIELD 'u (list 'g i) 'cdz_)))
(define (ca5-kk n) (list 'CC-EXHAUST 'u n))
;; i in NN, g in FUN(NN, H(u)) in context: land HOLOMORPHIC-ON(u, g i) and FUN typing
(define (ca5-gi-hol! i)
  (if (not (and (dk-asm? (list 'HOLOMORPHIC-ON 'u (list 'g i))) (dk-asm? (list 'IN (list 'g i) '(FUN u CC)))))
      (begin
        (fact 'fun-apply-type-c 'g 'NN '(CC-HOL-FNS u) i)
        (let* ((hi (dk-cite! 'cc-hol-fns-membership 'u (list 'g i))) (hr (caddr hi)))
          (if (not (dk-asm? hr)) (dk-have! hr (dk-lane (lambda () (dk-only! hi (list 'IN (list 'g i) '(CC-HOL-FNS u))) (dk-lane-if! prop)))))
          (dk-split-all! (list hr))
          (dk-cite! 'holomorphic-on-continuous 'u (list 'g i))))))
;; land IS-NORMALLY-CONVERGENT(fam, K)'s two parts; return the series-clause
(define (ca5-nc-open! fam kk)
  (let* ((ni (dk-cite! 'is-normally-convergent fam kk)) (nr (caddr ni)))
    (if (not (dk-asm? nr)) (dk-have! nr (lambda () (dk-only! ni (list 'IS-NORMALLY-CONVERGENT fam kk)) (prop))))
    (dk-split-all! (list nr))
    nr))

(sp (make-wff '(FORALL u (IMPLIES (IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u)
  (FORALL g (IMPLIES (IN g (FUN NN (CC-HOL-FNS u)))
    (IMPLIES (FORALL n (IMPLIES (IN n NN) (IS-NORMALLY-CONVERGENT g (CC-EXHAUST u n))))
      (FORALL n (IMPLIES (IN n NN)
        (IS-NORMALLY-CONVERGENT (VNB-LAMBDA cdi_ NN (VNB-LAMBDA cdz_ u (DERIV-ON CC-NORMED-FIELD u (g cdi_) cdz_)))
                                (CC-EXHAUST u n)))))))))))
(dk-peel!)
(fact 'cc-open-subset-cc 'u)
(fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC)
(let* ((hnc (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-NORMALLY-CONVERGENT))) "normal convergence"))
       (m (list '+ (list '* 4 'n) 3)) (kn (ca5-kk 'n)) (km (ca5-kk m))
       (c4 '(* 4 (+ n 1)))
       (pf (lambda (i) (list 'CC-SUP-NORM (list 'g i) km)))
       (df (lambda (i) (list 'CC-SUP-NORM (ca5-gdi i) kn))))
  (fact 'nn-in-rr 'n) (fact 'nn-zero-le 'n)
  (dk-have! (list 'IN m 'NN) (lambda () (dk-type! m 'NN) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))
  (ca5-apply! hnc m)
  (ca5-nc-open! 'g km)
  (dk-cite! 'cc-exhaust-subset 'u m) (dk-cite! 'cc-exhaust-subset 'u 'n)
  (ca5x-rr! c4)
  (dk-have! (list '<= 0 c4) (lambda () (dk-ineq! '(<= 0 n))))
  ;; for each i: sup_{K_n} |g_i'| <= 4(n+1) sup_{K_m} |g_i|, and both are reals >= 0
  (dk-have! (list 'FORALL 'cdi_ (list 'IMPLIES '(IN cdi_ NN)
              (list 'AND (list 'IN (df 'cdi_) 'RR) (list 'AND (list '<= 0 (df 'cdi_)) (list '<= (df 'cdi_) (list '* c4 (pf 'cdi_)))))))
    (lambda ()
      (let* ((i (dk-di-var!)) (gi (list 'g i)) (hd (ca5-gdi i)))
        (ca5-gi-hol! i)
        (ca5-apply! (or (dk-ctx-form (list 'FORALL 'cpsi_ (list 'IMPLIES '(IN cpsi_ NN) (list 'IN (list 'CC-SUP-NORM '(g cpsi_) km) 'RR)))) (error "ca5: realness clause")) i)
        (dk-have! (list 'FORALL 'ky_ (list 'IMPLIES (list 'IN 'ky_ km) (list 'IN (list gi 'ky_) 'CC)))
          (lambda () (let ((y (dk-di-var!))) (fact 'subset-mem-fwd km 'u y) (fact 'fun-apply-type-c gi 'u 'CC y) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))
        (let ((up (dk-cite! 'cc-sup-norm-upper gi km)))
          (dk-have! (list 'FORALL 'cmy_ (list 'IMPLIES (list 'IN 'cmy_ km) (list '<= (list 'magnitude (list gi 'cmy_)) (pf i))))
            (lambda () (let ((y (dk-di-var!))) (ca5-apply! up y) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))))
        (let ((est (dk-cite! 'cc-deriv-seminorm-estimate 'u gi 'n (pf i))))
          (fact 'rr-mul-in-rr c4 (pf i))
          (dk-have! (list '<= 0 (pf i))
            (lambda () (dk-split-all! (list (dk-cite! 'cc-exhaust-seminorm-real 'u gi m))) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))
          (dk-have! (list '<= 0 (list '* c4 (pf i)))
            (lambda () (ca5x-and! (list 'IN c4 'RR) (list 'IN (pf i) 'RR)) (ca5x-and! (list '<= 0 c4) (list '<= 0 (pf i)))
                       (fact 'rr-leq-mul-nonneg c4 (pf i)) (ass)))
          (dk-have! (list 'FORALL 'cpsx_ (list 'IMPLIES (list 'IN 'cpsx_ kn) (list 'IN (list hd 'cpsx_) 'CC)))
            (lambda () (let ((y (dk-di-var!))) (fact 'subset-mem-fwd kn 'u y)
                         (if (dk--redex? (dk-goal)) (dk-lam-b!))
                         (ca5v-deriv-typ! gi y)
                         (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))
          (dk-have! (list 'FORALL 'cpsx_ (list 'IMPLIES (list 'IN 'cpsx_ kn) (list '<= (list 'magnitude (list hd 'cpsx_)) (list '* c4 (pf i)))))
            (lambda () (let ((y (dk-di-var!)))
                         (fact 'subset-mem-fwd kn 'u y)
                         (if (dk--redex? (dk-goal)) (dk-lam-b!))
                         (ca5-apply! est y)
                         (ca5v-deriv-typ! gi y)
                         (ca5v-rr! (list 'magnitude (list 'DERIV-ON 'CC-NORMED-FIELD 'u gi y)))
                         (fact 'rr-mul-in-rr (pf i) c4)
                         (dk-have! (list '= (list '* (pf i) c4) (list '* c4 (pf i))) (lambda () (crs)))
                         (dk-ineq! (list '<= (list 'magnitude (list 'DERIV-ON 'CC-NORMED-FIELD 'u gi y)) (list '* (pf i) c4))
                                   (list '= (list '* (pf i) c4) (list '* c4 (pf i)))))))
          (dk-split-all! (list (dk-cite! 'cc-sup-norm-bound hd kn (list '* c4 (pf i)))))
          (dk-conj-close! (lambda () (ass)))))))
  (let* ((dcl (dk-ctx-form (list 'FORALL 'cdi_ (list 'IMPLIES '(IN cdi_ NN)
              (list 'AND (list 'IN (df 'cdi_) 'RR) (list 'AND (list '<= 0 (df 'cdi_)) (list '<= (df 'cdi_) (list '* c4 (pf 'cdi_)))))))))
         (fl (list 'VNB-LAMBDA 'cpsi_ 'NN (list 'CC-SUP-NORM (list ca5-gdf 'cpsi_) kn)))
         (pl (list 'VNB-LAMBDA 'cpsi_ 'NN (pf 'cpsi_)))
         (hl (list 'VNB-LAMBDA 'cpsi_ 'NN (list '* c4 (pf 'cpsi_))))
         (fv! (lambda (i) ; land (fl i) = df(i), with df(i) facts
                (ca5-apply! dcl i)
                (dk-split-all!))))
    (let* ((nci (dk-cite! 'is-normally-convergent ca5-gdf kn)) (nrhs (caddr nci)))
      (dk-have! nrhs
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'FORALL)
                  (let ((i (dk-di-var!)))
                    (if (dk--redex? (dk-goal)) (dk-lam-b!))
                    (fv! i)
                    (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))
                  ;; the series: comparison with 4(n+1) times the series at K_m
                  (begin
                    (dk-have! (list 'IN pl '(FUN NN RR))
                      (lambda () (dk-lam-type! (lambda () (let ((i (dk-di-var!)))
                         (ca5-apply! (or (dk-ctx-form (list 'FORALL 'cpsi_ (list 'IMPLIES '(IN cpsi_ NN) (list 'IN (list 'CC-SUP-NORM '(g cpsi_) km) 'RR)))) (error "ca5: realness clause")) i)
                         (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))))
                    (dk-have! (list 'IN hl '(FUN NN RR))
                      (lambda () (dk-lam-type! (lambda () (let ((i (dk-di-var!)))
                         (ca5-apply! (or (dk-ctx-form (list 'FORALL 'cpsi_ (list 'IMPLIES '(IN cpsi_ NN) (list 'IN (list 'CC-SUP-NORM '(g cpsi_) km) 'RR)))) (error "ca5: realness clause")) i)
                         (fact 'rr-mul-in-rr c4 (pf i))
                         (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))))
                    (dk-have! (list 'IN fl '(FUN NN RR))
                      (lambda () (dk-lam-type! (lambda () (let ((i (dk-di-var!)))
                         (if (dk--redex? (dk-goal)) (dk-lam-b!)) (fv! i)
                         (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))))
                    (dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN) (list '<= 0 (list pl 'cpsk_))))
                      (lambda () (let ((i (dk-di-var!)))
                         (if (dk--redex? (dk-goal)) (dk-lam-b!))
                         (ca5-gi-hol! i)
                         (dk-split-all! (list (dk-cite! 'cc-exhaust-seminorm-real 'u (list 'g i) m)))
                         (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))
                    (dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN) (list '= (list hl 'cpsk_) (list '* c4 (list pl 'cpsk_)))))
                      (lambda () (let ((i (dk-di-var!)))
                         (ca5-apply! (or (dk-ctx-form (list 'FORALL 'cpsi_ (list 'IMPLIES '(IN cpsi_ NN) (list 'IN (list 'CC-SUP-NORM '(g cpsi_) km) 'RR)))) (error "ca5: realness clause")) i)
                         (fact 'rr-mul-in-rr c4 (pf i))
                         (if (dk--redex? (dk-goal)) (dk-lam-b!))
                         (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
                    (dk-cite! 'series-scale-converges pl c4 hl)
                    (dk-have! (list 'FORALL 'cpn_ (list 'IMPLIES '(IN cpn_ NN) (list 'AND (list '<= 0 (list fl 'cpn_)) (list '<= (list fl 'cpn_) (list hl 'cpn_)))))
                      (lambda () (let ((i (dk-di-var!)))
                         (if (dk--redex? (dk-goal)) (dk-lam-b!))
                         (fv! i)
                         (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (if (dk--redex? (dk-goal)) (dk-lam-b!)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))))))
                    (ca5x-and! (list 'FORALL 'cpn_ (list 'IMPLIES '(IN cpn_ NN) (list 'AND (list '<= 0 (list fl 'cpn_)) (list '<= (list fl 'cpn_) (list hl 'cpn_)))))
                               (list 'SERIES-CONVERGES hl))
                    (dk-cite! 'comparison-test fl hl)
                    (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))))))
      (dk-only! nci nrhs)
      (prop))))
