;;; the estimate itself
(sp (make-wff '(FORALL u (IMPLIES (IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u)
  (FORALL f (IMPLIES (HOLOMORPHIC-ON u f)
  (FORALL n (IMPLIES (IN n NN)
  (FORALL bm (IMPLIES (IN bm RR)
    (IMPLIES (FORALL cmy_ (IMPLIES (IN cmy_ (CC-EXHAUST u (+ (* 4 n) 3))) (<= (magnitude (f cmy_)) bm)))
      (FORALL y (IMPLIES (IN y (CC-EXHAUST u n))
        (<= (magnitude (DERIV-ON CC-NORMED-FIELD u f y)) (* bm (* 4 (+ n 1)))))))))))))))))
(dk-peel!)
(fact 'cc-is-metric-space) (ca5v-pts-cc!)
(let* ((r1 '(recip (+ n 1))) (q (list '* 1/4 r1)) (h (list '* 1/2 r1)) (m '(+ (* 4 n) 3))
       (km (list 'CC-EXHAUST 'u m)) (bh (list 'BALL 'CC-MS 'y h)) (b2 (list 'BALL 'CC-MS 'y (list '* 2 q)))
       (bnd (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'bm))) "the bound")))
  (fact 'nn-in-rr 'n) (fact 'nn-zero-le 'n)
  (dk-split-all! (list (dk-cite! 'cc-exhaust-radius 'n)))
  (ca5x-rr! q) (ca5x-rr! h) (ca5x-rr! (list '* 2 q))
  (dk-have! (list '< 0 q) (lambda () (dk-ineq! (list '< 0 r1))))
  (dk-have! (list '<= (list '* 2 q) h) (lambda () (dk-ineq! (list '< 0 r1))))
  (dk-split-all! (list (dk-cite! 'cc-exhaust-membership 'u 'n 'y)))
  (dk-have! '(IN y CC) (lambda () (prop)))
  (dk-cite! 'cc-ms-ball-mono 'y (list '* 2 q) h)
  (dk-have! (list 'IN m 'NN) (lambda () (dk-type! m 'NN) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))
  (dk-cite! 'cc-exhaust-ball-inside 'u 'n 'y)
  (dk-cite! 'cc-exhaust-subset 'u m)
  (fact 'subset-trans b2 bh km)
  (fact 'subset-trans b2 km 'u)
  (dk-have! (list 'FORALL 'cmy_ (list 'IMPLIES (list 'IN 'cmy_ b2) '(<= (magnitude (f cmy_)) bm)))
    (lambda () (let ((v (dk-di-var!))) (fact 'subset-mem-fwd b2 km v) (ca5-apply! bnd v) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))
  (dk-cite! 'cc-holomorphic-deriv-estimate 'u 'f 'y q 'bm)
  ;; recip(q) = 4(n+1)
  (let* ((a '(+ n 1)) (v '(* 4 (+ n 1))))
    (ca5x-rr! a) (ca5x-rr! v)
    (dk-have! (list '< 0 a) (lambda () (dk-ineq! '(<= 0 n))))
    (fact 'rr-pos-ne-zero a) (fact 'rr-pos-ne-zero q)
    (ca5x-and! (list 'IN a 'RR) (list 'NOT (list '= a 0)))
    (fact 'rr-recip-inverse a)
    (fact 'rr-one-in)
    (let ((rv (dk-name! r1)))
