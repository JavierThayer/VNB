               (fact 'subset-refl 'u)
               (dk-have! (list 'FORALL 'cpx_ (list 'IMPLIES '(IN cpx_ u) (list '= (list (ca5-pfam sk) 'cpx_) (list hl 'cpx_))))
                 (lambda ()
                   (let* ((x (dk-di-var!)) (fx (ca5-fw x)))
                     (ca5-fw-typ! x)
                     (ca5-gix! k x)
