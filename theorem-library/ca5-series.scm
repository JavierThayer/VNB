;;; (4) the partial sums of a series of holomorphic functions are differentiable, and the
;;;     derivative of a partial sum is the partial sum of the derivatives
;;; ======================================================================
(define (ca5-fw w) (list 'VNB-LAMBDA 'cmi_ 'NN (list '(g cmi_) w)))
(define (ca5-pfam n) (list 'VNB-LAMBDA 'cpw_ 'u (list 'CC-SERIES-PARTIAL-SUM (ca5-fw 'cpw_) n)))
(define (ca5-dser z) (list 'VNB-LAMBDA 'cdi_ 'NN (list 'DERIV-ON 'CC-NORMED-FIELD 'u '(g cdi_) z)))
(define (ca5-psd-body n)
  (list 'FORALL 'z (list 'IMPLIES '(IN z u)
    (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'u (ca5-pfam n) 'z (list 'CC-SERIES-PARTIAL-SUM (ca5-dser 'z) n)))))
(define (ca5-gopen!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))
(define (ca5-gbeta!) (let loop () (if (dk--redex? (dk-goal)) (begin (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (loop))))))
;; g in FUN(NN, H(u)) in context, i in NN, x in u: ((g i) x) in CC
(define (ca5-gix! i x)
  (ca5-gi-hol! i)
  (fact 'fun-apply-type-c (list 'g i) 'u 'CC x))
;; x in u: fw(x) in FUN(NN, CC)
(define (ca5-fw-typ! x)
  (dk-have! (list 'IN (ca5-fw x) '(FUN NN CC))
    (lambda () (dk-lam-type! (lambda () (let ((i (dk-di-var!))) (ca5-gix! i x) (ca5-gopen!)))))))
;; the partial sum F_n is a function u -> CC
(define (ca5-pfam-typ! n)
  (dk-have! (list 'IN (ca5-pfam n) '(FUN u CC))
    (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!)))
                                          (ca5-fw-typ! x)
                                          (fact 'cc-series-partial-sum-in-cc n (ca5-fw x))
                                          (ca5-gopen!)))))))
;; z in u: DERIV-ON(u, g i, z) in CC, and dser(z) in FUN(NN, CC)
(define (ca5-dser-typ! z)
  (dk-have! (list 'IN (ca5-dser z) '(FUN NN CC))
    (lambda () (dk-lam-type! (lambda () (let ((i (dk-di-var!))) (ca5-gi-hol! i) (ca5v-deriv-typ! (list 'g i) z) (ca5-gopen!)))))))

