                     (subst (list '= (list 'CC-SERIES-PARTIAL-SUM fx sk) (list '+ (list 'CC-SERIES-PARTIAL-SUM fx k) (list fx k))))
                     (subst (list '= (list (list 'ADD 'CC-NORMED-FIELD) (list 'CC-SERIES-PARTIAL-SUM fx k) (list (list 'g k) x))
                                  (list '+ (list 'CC-SERIES-PARTIAL-SUM fx k) (list (list 'g k) x))))
                     (ca5-gbeta!)
                     (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
               (dk-cite! 'cc-diff-on-local 'u (ca5-pfam sk) 'u hl z (list '+ psk l))
               (ca5-gopen!)))))
       ;; the base
       (begin
         (dk-peel!)
         (let* ((gl (dk-goal))
                (z (list-ref gl 4))
                (dz (ca5-dser z))
                (c0 '(VNB-LAMBDA d2x_ u 0)))
           (fact 'cc-open-subset-cc 'u)
           (fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC)
           (fact 'cc-is-normed-field)
           (fact 'cc-zero-in) (fact 'cc-nf-carr)
           (dk-have! '(IN 0 (CARR CC-NORMED-FIELD)) (lambda () (subst '(= (CARR CC-NORMED-FIELD) CC)) (ass)))
           (fact 'cc-series-partial-sum-zero dz)
           (subst (list '= (list 'CC-SERIES-PARTIAL-SUM dz 0) 0))
           (let* ((d0 (dk-cite! 'diff-on-const 'CC-NORMED-FIELD 'u 0 z)))
             (fact 'cc-nf-zero)
             (dk-rewrite-h! d0 '(ZERO CC-NORMED-FIELD) 0)
             (ca5-pfam-typ! 0)
             (fact 'subset-refl 'u)
             (dk-have! (list 'FORALL 'cpx_ (list 'IMPLIES '(IN cpx_ u) (list '= (list (ca5-pfam 0) 'cpx_) (list c0 'cpx_))))
               (lambda ()
                 (let* ((x (dk-di-var!)) (fx (ca5-fw x)))
                   (ca5-gbeta!)
                   (fact 'cc-series-partial-sum-zero fx)
                   (subst (list '= (list 'CC-SERIES-PARTIAL-SUM fx 0) 0))
                   (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
             (dk-cite! 'cc-diff-on-local 'u (ca5-pfam 0) 'u c0 z 0)
             (ca5-gopen!))))))
 (dk-open-leaves))
(qed 'cc-partial-sums-diff)
(topic! 'cc-partial-sums-diff 'analysis)
;;; ======================================================================
;;; (5) PROPOSITION 5.22: the sum of a series of holomorphic functions normally convergent on
;;;     every K_n is holomorphic, and is differentiated term by term
;;; ======================================================================
(define ca5-famv (list 'VNB-LAMBDA 'cpn_ 'NN (ca5-pfam 'cpn_)))
(define ca5-ssum (list 'VNB-LAMBDA 'cpw_ 'u (list 'CC-SERIES-LIMIT (ca5-fw 'cpw_))))
(define ca5-hnc '(FORALL n (IMPLIES (IN n NN) (IS-NORMALLY-CONVERGENT g (CC-EXHAUST u n)))))
;; the typing of the family on K_n, in the form the M-test reads
(define (ca5-kn-gty! n)
  (let* ((kn (list 'CC-EXHAUST 'u n))
         (ty (list 'FORALL 'cmi_ (list 'IMPLIES '(IN cmi_ NN) (list 'FORALL 'cmy_ (list 'IMPLIES (list 'IN 'cmy_ kn) '(IN ((g cmi_) cmy_) CC)))))))
    (dk-cite! 'cc-exhaust-subset 'u n)
    (if (not (dk-asm? ty))
        (dk-have! ty (lambda ()
                       (dk-peel!)
                       (let* ((gd (dk-goal)) (i (cadr (car (cadr gd)))) (y (cadr (cadr gd))))
                         (fact 'subset-mem-fwd kn 'u y)
                         (ca5-gix! i y)
                         (ca5-gopen!)))))
    ty))
;; z in u: a K_n holding it; returns n
(define (ca5-cover! z)
  (dk-skolem! (ca5-apply! (dk-cite! 'cc-exhaust-covers 'u) z)))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ca5-nfm 'u)
  (list 'FORALL 'g (list 'IMPLIES '(IN g (FUN NN (CC-HOL-FNS u)))
    (list 'IMPLIES ca5-hnc
      (list 'AND (list 'HOLOMORPHIC-ON 'u ca5-ssum)
        (list 'FORALL 'z (list 'IMPLIES '(IN z u)
          (list '= (list 'DERIV-ON 'CC-NORMED-FIELD 'u ca5-ssum 'z) (list 'CC-SERIES-LIMIT (ca5-dser 'z)))))))))))))
(dk-peel!)
(fact 'cc-open-subset-cc 'u)
(fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC)
(fact 'cc-is-normed-field)
(dk-split-all! (list (dk-cite! 'cc-ms-open-iff 'u)))
(dk-have! '(IS-OPEN CC-MS u) (lambda () (prop)))
(define ca5-hncf (dk-ctx-form ca5-hnc))
;; (A) every partial sum is holomorphic
(define ca5-famhol (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'HOLOMORPHIC-ON 'u (list ca5-famv 'k)))))
(dk-have! ca5-famhol
  (lambda ()
    (let ((k (dk-di-var!)))
      (ca5-pfam-typ! k)
      (ca5-gbeta!)
      (mac 'holomorphic-on)
      (dk-conj-close!
        (lambda ()
          (cond ((dk-asm? (dk-goal)) (ass))
                (#t (let* ((a (dk-di-var!)))
                      (ca5-dser-typ! a)
                      (fact 'cc-series-partial-sum-in-cc k (ca5-dser a))
                      (ew (list 'CC-SERIES-PARTIAL-SUM (ca5-dser a) k))
                      (ca5-apply! (dk-cite! 'cc-partial-sums-diff k 'u 'g) a)
                      (ca5-gopen!)))))))))
;; (B) the series converges at every point of u; the sum is a function u -> CC
(define ca5-conv (list 'FORALL 'cpx_ (list 'IMPLIES '(IN cpx_ u) (list 'CC-SERIES-CONVERGES (ca5-fw 'cpx_)))))
(dk-have! ca5-conv
  (lambda ()
    (let* ((w (dk-di-var!)) (n (ca5-cover! w)))
      (ca5-kn-gty! n)
      (ca5-apply! ca5-hncf n)
      (ca5-apply! (dk-cite! 'cc-normal-convergence-pointwise 'g (list 'CC-EXHAUST 'u n)) w)
      (ca5-gopen!))))
(dk-have! (list 'IN ca5-ssum '(FUN u CC))
  (lambda () (dk-lam-type! (lambda () (let ((w (dk-di-var!)))
                                        (ca5-apply! (dk-ctx-form ca5-conv) w)
                                        (ca5-fw-typ! w)
                                        (dk-cite! 'cc-series-limit-in-cc (ca5-fw w))
                                        (ca5-gopen!))))))
;; (C) the partial sums converge to the sum uniformly on every K_n, hence on the compacta
(define ca5-uiff (dk-cite! 'cc-exhaust-uniform-iff-compacta 'u ca5-famv ca5-ssum))
(dk-have! (cadr ca5-uiff)
  (lambda ()
    (let* ((n (dk-di-var!)) (kn (list 'CC-EXHAUST 'u n)))
      (ca5-kn-gty! n)
      (ca5-apply! ca5-hncf n)
      (let* ((uni (dk-cite! 'cc-normal-convergence-uniform 'g kn)))
        (dk-peel!)
        (let* ((ev (cadr (car (filter (dk-head? 'POS-RR) (dk-asms)))))
               (cap (dk-skolem! (ca5-apply! uni ev)))
               (tl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm cap) (dk-contains? fm 'CC-SERIES-LIMIT))) "the tail")))
          (ew cap)
          (dk-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal))
                  (ass)
                  (begin
                    (dk-peel!)
                    (let* ((gd (dk-goal)) (fk (car (cadr (cadr (cadr gd))))) (k (cadr fk)) (z (cadr (cadr (cadr (cadr gd)))))
                           (fz (ca5-fw z)) (sl (list 'CC-SERIES-LIMIT fz)) (ps (list 'CC-SERIES-PARTIAL-SUM fz k)))
                      (ca5-apply! tl k z)
                      (fact 'subset-mem-fwd kn 'u z)
                      (ca5-gbeta!)
                      (ca5-apply! (dk-ctx-form ca5-conv) z)
                      (ca5-fw-typ! z)
                      (dk-cite! 'cc-series-limit-in-cc fz)
                      (fact 'cc-series-partial-sum-in-cc k fz)
                      (dk-cite! 'cc-magnitude-sub-sym ps sl)
                      (subst (list '= (list 'magnitude (list '- ps sl)) (list 'magnitude (list '- sl ps))))
                      (ca5-gopen!)))))))))))
(dk-have! (caddr ca5-uiff) (dk-lane (lambda () (dk-only! ca5-uiff (cadr ca5-uiff)) (dk-lane-if! prop))))
;; (D) Weierstrass (3.44 and its complement)
(dk-cite! 'holomorphic-limit-on-compacta 'u ca5-famv ca5-ssum)
(define ca5-dl (dk-cite! 'holomorphic-limit-derivatives 'u ca5-famv ca5-ssum))
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal))
        (ass)
        (let* ((z (dk-di-var!))
               (n (ca5-cover! z))
               (kk (list 'CC-EXHAUST 'u n))
               (dz (ca5-dser z))
               (ll (list 'CC-SERIES-LIMIT dz))
               (dd (list 'DERIV-ON 'CC-NORMED-FIELD 'u ca5-ssum z))
               (xx (list 'magnitude (list '- ll dd)))
               (mz (list 'VNB-LAMBDA 'cmi_ 'NN (list 'magnitude (list 'DERIV-ON 'CC-NORMED-FIELD 'u '(g cmi_) z))))
               (gdf '(VNB-LAMBDA cdi_ NN (VNB-LAMBDA cdz_ u (DERIV-ON CC-NORMED-FIELD u (g cdi_) cdz_))))
               (an (list 'VNB-LAMBDA 'cpsi_ 'NN (list 'CC-SUP-NORM (list gdf 'cpsi_) kk))))
          (dk-cite! 'cc-exhaust-subset 'u n)
          (dk-cite! 'cc-exhaust-compact 'u n)
          ;; the derived series converges at z: compare with the seminorms of the derived family
          (ca5-apply! (dk-cite! 'cc-derived-series-normally-convergent 'u 'g) n)
          (let* ((ni (dk-cite! 'is-normally-convergent gdf kk)) (nr (caddr ni)))
            (dk-have! nr (dk-lane (lambda () (dk-only! ni (list 'IS-NORMALLY-CONVERGENT gdf kk)) (dk-lane-if! prop))))
            (dk-split-all! (list nr)))
          (ca5-dser-typ! z)
          (dk-have! (list 'IN an '(FUN NN RR))
            (lambda () (dk-lam-type! (lambda () (let ((i (dk-di-var!)))
              (ca5-apply! (dk-ctx-form (list 'FORALL 'cpsi_ (list 'IMPLIES '(IN cpsi_ NN) (list 'IN (list 'CC-SUP-NORM (list gdf 'cpsi_) kk) 'RR)))) i)
              (ca5-gopen!))))))
          (dk-have! (list 'IN mz '(FUN NN RR))
            (lambda () (dk-lam-type! (lambda () (let ((i (dk-di-var!)))
              (ca5-gi-hol! i) (ca5v-deriv-typ! (list 'g i) z)
              (fact 'cc-magnitude-closed (list 'DERIV-ON 'CC-NORMED-FIELD 'u (list 'g i) z))
              (ca5-gopen!))))))
          (dk-have! (list 'FORALL 'cpsj_ (list 'IMPLIES '(IN cpsj_ NN) (list '= (list mz 'cpsj_) (list 'magnitude (list dz 'cpsj_)))))
            (lambda () (let ((i (dk-di-var!)))
                         (ca5-gi-hol! i) (ca5v-deriv-typ! (list 'g i) z)
                         (fact 'cc-magnitude-closed (list 'DERIV-ON 'CC-NORMED-FIELD 'u (list 'g i) z))
                         (ca5-gbeta!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
          (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'AND (list '<= 0 (list mz 'n)) (list '<= (list mz 'n) (list an 'n)))))
            (lambda ()
              (let* ((i (dk-di-var!)) (hd (list 'VNB-LAMBDA 'cdz_ 'u (list 'DERIV-ON 'CC-NORMED-FIELD 'u (list 'g i) 'cdz_)))
                     (dvi (list 'DERIV-ON 'CC-NORMED-FIELD 'u (list 'g i) z)))
                (ca5-gi-hol! i) (ca5v-deriv-typ! (list 'g i) z)
                (fact 'cc-magnitude-closed dvi) (fact 'cc-magnitude-nonneg dvi)
                (dk-have! (list 'FORALL 'ky_ (list 'IMPLIES (list 'IN 'ky_ kk) (list 'IN (list hd 'ky_) 'CC)))
                  (lambda () (let ((y (dk-di-var!))) (fact 'subset-mem-fwd kk 'u y) (ca5-gbeta!) (ca5v-deriv-typ! (list 'g i) y) (ca5-gopen!))))
                (let ((up (dk-cite! 'cc-sup-norm-upper hd kk z)))
                  (dk-lam-b-h! up))
                (dk-conj-close! (lambda () (ca5-gbeta!) (ca5-gopen!))))))
          (ca5x-and! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'AND (list '<= 0 (list mz 'n)) (list '<= (list mz 'n) (list an 'n)))))
                     (list 'SERIES-CONVERGES an))
          (dk-cite! 'comparison-test mz an)
          (dk-cite! 'cc-series-abs-converges dz mz)
          (dk-cite! 'cc-series-limit-in-cc dz)
          (ca5v-deriv-typ! ca5-ssum z)
          (ca5v-rr! xx)
          (fact 'cc-magnitude-nonneg (list '- ll dd))
          (let* ((cvi (dk-cite! 'cc-series-converges-to dz ll))
                 (cv0 (dk-cite! 'cc-series-limit-converges-to dz))
                 (cvr (caddr cvi))
                 (ts (caddr cvr))
                 (ui (dk-cite! 'unif-on-compacta 'u (caddr ca5-dl) (cadddr ca5-dl)))
                 (ur (caddr ui)))
            (dk-have! cvr (dk-lane (lambda () (dk-only! cvi cv0) (dk-lane-if! prop))))
            (dk-have! (list 'IN ts '(FUN NN CC))
              (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (fact 'cc-series-partial-sum-in-cc k dz) (ca5-gopen!))))))
            (dk-have! ur (dk-lane (lambda () (dk-only! ui ca5-dl) (dk-lane-if! prop))))
            ;; |L - D| <= eps for every eps
            (dk-have! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list '<= xx 'eps)))
              (lambda ()
                (dk-peel!)
                (let* ((ev (cadr (car (filter (dk-head? 'POS-RR) (dk-asms)))))
                       (cap (dk-skolem! (ca5-apply! (dk-ctx-form ur) kk ev)))
                       (tl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm cap) (dk-contains? fm 'DERIV-ON))) "the uniform tail")))
                  (fact 'rr-pos-rr-in-rr ev)
                  (dk-have! (list 'FORALL 'cekn_ (list 'IMPLIES '(IN cekn_ NN) (list 'IMPLIES (list '<= cap 'cekn_)
                              (list '<= (list 'magnitude (list '- (list ts 'cekn_) dd)) ev))))
                    (lambda ()
                      (let* ((m (dk-di-var!)))
                        (dk-peel!)
                        (let* ((h (ca5-apply! tl m z)))
                          (dk-lam-b-h! h)
                          (let ((want (list '<= (list 'magnitude (list '- (list 'DERIV-ON 'CC-NORMED-FIELD 'u (ca5-pfam m) z) dd)) ev)))
                            (let loop ((done '()))
                              (if (not (dk-asm? want))
                                  (let ((rs (filter (lambda (fm) (and (dk-head-is? fm '<=) (dk-contains? fm ev) (dk--redex? fm)
                                                                      (not (dk-contains? fm 'wcvk_)) (not (member fm done))))
                                                    (dk-asms))))
                                    (if (pair? rs) (begin (dk-lam-b-h! (car rs)) (loop (cons (car rs) done)))))))))
                        (ca5-gbeta!)
                        (let* ((ps (list 'CC-SERIES-PARTIAL-SUM dz m)))
                          (ca5-apply! (dk-cite! 'cc-partial-sums-diff m 'u 'g) z)
                          (dk-cite! 'cc-deriv-on-of-is-diff-on 'u (ca5-pfam m) z ps)
                          (subst (list '= ps (list 'DERIV-ON 'CC-NORMED-FIELD 'u (ca5-pfam m) z)))
                          (ca5-gopen!)))))
                  (dk-cite! 'cek-limit-tail-le ts ll dd ev cap)
                  (ca5-gopen!))))
            (dk-cite! 'rr-le-all-pos-nonpos xx)
            (fact 'rr-zero-in)
            (ca5x-and! (list 'IN xx 'RR) '(IN 0 RR))
            (ca5x-and! (list '<= xx 0) (list '<= 0 xx))
            (dk-cite! 'rr-leq-antisymmetric xx 0)
            (dk-cite! 'cc-sub-in-cc ll dd)
            (let* ((zi (dk-cite! 'cc-magnitude-zero-iff (list '- ll dd))))
              (dk-have! (list '= (list '- ll dd) 0) (dk-lane (lambda () (dk-only! zi (list '= xx 0)) (dk-lane-if! prop)))))
            (dk-cite! 'cc-sub-zero-eq ll dd)
            (subst (list '= dd ll))
            (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))))
(qed 'cc-series-holomorphic)
(topic! 'cc-series-holomorphic 'analysis)
;;; ======================================================================
;;; (6) PROPOSITION 5.20, the linearity half: D(c f + d g) = c D f + d D g on H(u)
;;;     (the continuity half is cc-deriv-continuous-on-hol, in ca5-montel.scm)
;;; ======================================================================
(define ca5-lin '(VNB-LAMBDA cdw_ u (+ (* lca_ (f cdw_)) (* lcb_ (g cdw_)))))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ca5-nfm 'u)
  (list 'FORALL 'f (list 'FORALL 'g (list 'IMPLIES '(HOLOMORPHIC-ON u f) (list 'IMPLIES '(HOLOMORPHIC-ON u g)
    (list 'FORALL 'lca_ (list 'IMPLIES '(IN lca_ CC) (list 'FORALL 'lcb_ (list 'IMPLIES '(IN lcb_ CC)
      (list 'FORALL 'z (list 'IMPLIES '(IN z u)
        (list '= (list 'DERIV-ON 'CC-NORMED-FIELD 'u ca5-lin 'z)
                 '(+ (* lca_ (DERIV-ON CC-NORMED-FIELD u f z)) (* lcb_ (DERIV-ON CC-NORMED-FIELD u g z))))))))))))))))))
(dk-peel!)
(fact 'cc-open-subset-cc 'u)
(fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC)
(fact 'cc-is-normed-field)
(let* ((gl (dk-goal))
       (z (list-ref (cadr gl) 4))
       (ca (cadr (cadr (caddr gl))))
       (cb (cadr (caddr (caddr gl))))
       (tgt (list-ref (cadr gl) 3))
       (dvf (list 'DERIV-ON 'CC-NORMED-FIELD 'u 'f z))
       (dvg (list 'DERIV-ON 'CC-NORMED-FIELD 'u 'g z))
       (l1 (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff 'u 'f) z)))
       (l2 (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff 'u 'g) z))))
  (dk-cite! 'cc-deriv-on-of-is-diff-on 'u 'f z l1)
  (dk-cite! 'cc-deriv-on-of-is-diff-on 'u 'g z l2)
  (ca5v-deriv-typ! 'f z) (ca5v-deriv-typ! 'g z)
  (dk-have! (list 'IN l1 'CC) (lambda () (subst (list '= l1 dvf)) (ass)))
  (dk-have! (list 'IN l2 'CC) (lambda () (subst (list '= l2 dvg)) (ass)))
  (for-each (lambda (h)
              (let* ((hi (dk-cite! 'holomorphic-on 'u h)) (hr (caddr hi)))
                (dk-have! (list 'IN h '(FUN u CC)) (dk-lane (lambda () (dk-only! hi (list 'HOLOMORPHIC-ON 'u h)) (dk-lane-if! prop))))))
            '(f g))
  (ca5v-cc! (list '* ca l1)) (ca5v-cc! (list '* cb l2))
  (let* ((s1 (dk-cite! 'cc-diff-on-scale 'u 'f z l1 ca))
         (s2 (dk-cite! 'cc-diff-on-scale 'u 'g z l2 cb))
         (sm (dk-cite! 'diff-on-sum 'CC-NORMED-FIELD 'u (list-ref s1 3) (list-ref s2 3) z (list '* ca l1) (list '* cb l2)))
         (ad (list (list 'ADD 'CC-NORMED-FIELD) (list '* ca l1) (list '* cb l2)))
         (sm2 (begin (dk-cite! 'cc-nf-add-apply (list '* ca l1) (list '* cb l2))
                     (dk-rewrite-h! sm ad (list '+ (list '* ca l1) (list '* cb l2)))))
         (hl (cadddr sm2)))
    (dk-have! (list 'IN tgt '(FUN u CC))
      (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!)))
        (fact 'fun-apply-type-c 'f 'u 'CC x) (fact 'fun-apply-type-c 'g 'u 'CC x)
        (ca5v-cc! (list '+ (list '* ca (list 'f x)) (list '* cb (list 'g x))))
        (ca5-gopen!))))))
    (fact 'subset-refl 'u)
    (dk-have! (list 'FORALL 'cpx_ (list 'IMPLIES '(IN cpx_ u) (list '= (list tgt 'cpx_) (list hl 'cpx_))))
      (lambda ()
        (let* ((x (dk-di-var!)) (a1 (list '* ca (list 'f x))) (a2 (list '* cb (list 'g x))))
          (fact 'fun-apply-type-c 'f 'u 'CC x) (fact 'fun-apply-type-c 'g 'u 'CC x)
          (ca5v-cc! a1) (ca5v-cc! a2)
          (ca5-gbeta!)
          (dk-cite! 'cc-nf-add-apply a1 a2)
          (subst (list '= (list (list 'ADD 'CC-NORMED-FIELD) a1 a2) (list '+ a1 a2)))
          (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
    (dk-cite! 'cc-diff-on-local 'u tgt 'u hl z (list '+ (list '* ca l1) (list '* cb l2)))
    (dk-cite! 'cc-deriv-on-of-is-diff-on 'u tgt z (list '+ (list '* ca l1) (list '* cb l2)))
    (subst (list '= (list 'DERIV-ON 'CC-NORMED-FIELD 'u tgt z) (list '+ (list '* ca l1) (list '* cb l2))))
    (subst (list '= dvf l1))
    (subst (list '= dvg l2))
    (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
(qed 'cc-deriv-linear)
(topic! 'cc-deriv-linear 'analysis)
