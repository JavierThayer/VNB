(define ca5x-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (ca5x-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (ca5x-and! a b)
  (let* ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (ca5x-rr! t)
  (let* ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((eq? t 'PI) (dk-split-all! (list (dk-cite! 'pi-pos))) typ)
          ((number? t) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((ca5x-op? t 'succ 2) (ca5x-nn! t) (fact 'nn-in-rr t) typ)
          ((ca5x-op? t '* 3) (ca5x-rr! (cadr t)) (ca5x-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((ca5x-op? t '+ 3) (ca5x-rr! (cadr t)) (ca5x-rr! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((ca5x-op? t '- 3) (ca5x-rr! (cadr t)) (ca5x-rr! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((ca5x-op? t '- 2) (ca5x-rr! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((ca5x-op? t 'magnitude 2) (ca5x-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((ca5x-op? t 'real-part 2) (ca5x-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((ca5x-op? t 'imag-part 2) (ca5x-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((ca5x-op? t 'abs 2) (ca5x-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((ca5x-op? t 'recip 2)
           (ca5x-rr! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (if (dk-asm? (list '< 0 (cadr t)))
                   (fact 'rr-pos-ne-zero (cadr t))
                   (error "ca5x-rr!: land the non-vanishing first" (expression->string (cadr t)))))
           (ca5x-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t))
           typ)
          (#t (dk-real! t) typ))))
(define (ca5x-nn! t)
  (let* ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((ca5x-op? t 'succ 2) (ca5x-nn! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          (#t (dk-type! t 'NN)))))
(define (ca5x-cc! t)
  (let* ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((or (and (number? t) (real? t)) (eq? t 'PI) (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
               (ca5x-op? t 'succ 2)
               (ca5x-op? t 'magnitude 2) (ca5x-op? t 'real-part 2) (ca5x-op? t 'imag-part 2))
           (ca5x-rr! t) (fact 'rr-subset-cc t) typ)
          ((ca5x-op? t '- 3) (ca5x-cc! (cadr t)) (ca5x-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((ca5x-op? t '- 2) (ca5x-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((ca5x-op? t '+ 3) (ca5x-cc! (cadr t)) (ca5x-cc! (caddr t))
           (ca5x-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((ca5x-op? t '* 3) (ca5x-cc! (cadr t)) (ca5x-cc! (caddr t))
           (ca5x-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((ca5x-op? t 'power 3) (ca5x-cc! (cadr t)) (ca5x-nn! (caddr t))
           (ca5x-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((ca5x-op? t 'CC-EXP 2) (ca5x-cc! (cadr t))
           (dk-split-all! (list (dk-cite! 'cc-exp-converges (cadr t)))) typ)
          ((ca5x-op? t 'recip 2) (ca5x-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "ca5x-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (ca5x-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (dk-type! t 'CC)))))
(define (ca5x-steps . thunks)
  ;; run THUNKS in order while the leaf focused at the start stays open
  (let* ((leaf (proof-state-focus *ps*)))
    (let loop ((ts thunks))
      (if (and (pair? ts) (not (sequent-node-grounded? leaf)))
          (begin ((car ts)) (loop (cdr ts)))))))
(define (ca5x-lam-typ! lam dom pre)
  (dk-have! (list 'IN lam (list 'FUN dom 'CC))
    (lambda ()
      (dk-lam-type! (lambda ()
                      (let* ((v (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                        (ca5x-steps
                          (lambda () (pre v))
                          (lambda () (if (dk--redex? (dk-goal)) (dk-lam-b!)))
                          (lambda () (if (not (dk-asm? (dk-goal))) (ca5x-cc! (cadr (dk-goal)))))
                          (lambda () (ass)))))))))
(define (ca5x-only-prop! . fs) (if (apply dk-only! fs) (prop)))
(define (ca5x-subst-ass! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (ass))))
(define (ca5x-in-ball! x c s)
  (let* ((m (list 'magnitude (list '- x c))))
    (fact 'cc-is-metric-space)
    (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
    (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (dk-have! (list 'IN c '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (ca5x-rr! m)
    (dk-cite! 'cc-ms-dist c x)
    (dk-cite! 'cc-magnitude-sub-sym c x)
    (dk-have! (list '<= (list '(DIST CC-MS) c x) m)
      (lambda ()
        (subst (list '= (list '(DIST CC-MS) c x) (list 'magnitude (list '- c x))))
        (if (not (equal? c x)) (subst (list '= (list 'magnitude (list '- c x)) m)))
        (dk-ineq!)))
    (let* ((cj (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list 'IN m 'RR) (list 'AND (list 'IN s 'RR)
                (list 'AND (list '<= (list '(DIST CC-MS) c x) m) (list '< m s)))))))
      (dk-have! cj (lambda () (dk-conj-close! dk-ass!)))
      (dk-cite! 'ball-mem-from-le 'CC-MS c x m s))))
(define (ca5x-subst-qrfl! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (qrfl))))
(define (ca5x-ball-open! c r x)
  ;; x in BALL(CC-MS, c, r) in context: land x in CC and |x - c| < r (stops early when a
  ;; landing closes the focus leaf, the claim being the goal)
  (let* ((dcx (list '(DIST CC-MS) c x))
         (mag (list 'magnitude (list '- c x)))
         (mag2 (list 'magnitude (list '- x c)))
         (cj  (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list '<= dcx r) (list 'NOT (list '= dcx r))))))
    (ca5x-steps
      (lambda () (fact 'cc-is-metric-space))
      (lambda () (let* ((iff (dk-cite! 'ball-membership 'CC-MS c r x)))
                   (dk-have! cj (lambda () (ca5x-only-prop! iff (list 'IN x (list 'BALL 'CC-MS c r)))))))
      (lambda () (dk-split-all! (list (dk-ctx-form cj))))
      (lambda () (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl))))
      (lambda () (dk-have! (list 'IN x 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass))))
      (lambda () (dk-cite! 'cc-ms-dist c x))
      (lambda () (ca5x-rr! mag))
      (lambda () (ca5x-rr! mag2))
      (lambda () (dk-cite! 'cc-magnitude-sub-sym c x))
      (lambda () (dk-have! (list 'AND (list '<= mag r) (list 'NOT (list '= mag r)))
                   (lambda () (subst (list '= mag dcx)) (dk-conj-close! dk-ass!))))
      (lambda () (dk-cite! 'rr-le-ne-lt mag r))
      (lambda () (dk-have! (list '< mag2 r) (lambda () (dk-ineq! (list '< mag r) (list '= mag mag2))))))))
(define (ca5x-center-in-ball! a r)
  ;; a in CC, r in RR, 0 < r: land a in BALL(CC-MS, a, r) (which also certifies the ball DEFINED)
  (let* ((d (list '- a a)) (m (list 'magnitude d)))
    (ca5x-rr! m)
    (ca5x-cc! d)
    (dk-have! (list '= d 0) (lambda () (crs)))
    (let ((iff (dk-cite! 'cc-magnitude-zero-iff d)))
      (dk-have! (list '= m 0) (lambda () (ca5x-only-prop! iff (list '= d 0)))))
    (dk-have! (list '< m r) (lambda () (dk-ineq! (list '= m 0) (list '< 0 r))))
    (ca5x-in-ball! a a r)))
(define (ca5x-pow-succ! a n)
  (ca5x-cc! a) (ca5x-nn! n)
  (ca5x-and! (list 'IN a 'CC) (list 'IN n 'NN))
  (dk-cite! 'power-succ a n))
(define (ca5v-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (ca5v-first-of l)
  (if (null? l) (error "wcv: a landing expected by the driver is missing; the goal" (expression->string (dk-goal))) (car l)))
(define (ca5v-need f what)
  (if (not (dk-asm? f)) (error (string-append "wcv: missing " what) (expression->string f)))
  f)
(define (ca5v-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (ca5v-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC)))
      (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (ca5v-rr! t)
  (let ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((ca5v-op? t 'real-part 2) (ca5v-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((ca5v-op? t 'imag-part 2) (ca5v-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((ca5v-op? t 'magnitude 2) (ca5v-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((ca5v-op? t 'ABS 2) (ca5v-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((ca5v-op? t '- 3) (ca5v-rr! (cadr t)) (ca5v-rr! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((ca5v-op? t '+ 3) (ca5v-rr! (cadr t)) (ca5v-rr! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          (#t (dk-type! t 'RR)))))
(define (ca5v-cc! t)
  (let ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((ca5v-op? t '- 3) (ca5v-cc! (cadr t)) (ca5v-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((ca5v-op? t '+ 3) (ca5v-cc! (cadr t)) (ca5v-cc! (caddr t))
           (ca5v-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((ca5v-op? t '* 3) (ca5v-cc! (cadr t)) (ca5v-cc! (caddr t))
           (ca5v-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((dk-asm? (list 'IN t 'RR)) (fact 'rr-subset-cc t) typ)
          (#t (dk-type! t 'CC)))))
(define ca5v-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (ca5v-open-ball! z)
  (fact 'cc-open-subset-cc 'u)
  (fact 'subset-mem-fwd 'u 'CC z)
  (fact 'cc-is-metric-space) (ca5v-pts-cc!)
  (if (not (dk-asm? (list 'IN z '(PTS CC-MS))))
      (dk-have! (list 'IN z '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass))))
  (if (not (dk-asm? '(IS-OPEN CC-MS u)))
      (begin
        (dk-split-all! (list (dk-cite! 'cc-ms-open-iff 'u)))
        (dk-have! '(IS-OPEN CC-MS u) (lambda () (prop)))))
  (let* ((oiff (dk-cite! 'is-open 'CC-MS 'u))
         (oball (let loop ((r (caddr oiff))) (if (eq? (car r) 'AND) (loop (caddr r)) r))))
    (if (not (dk-asm? oball))
        (dk-have! oball (lambda () (if (dk-only! oiff '(IS-OPEN CC-MS u)) (prop)))))
    (let ((rho (dk-skolem! (dk-apply! oball z))))
      (dk-split-all!)
      rho)))
(define (ca5v-head g) (and (pair? g) (car g)))
(define (ca5v-csub-and! closer)
  (if (eq? (ca5v-head (dk-goal)) 'AND)
      (for-each (lambda (k) (dk-focus! k) (ca5v-csub-and! closer))
                (dk-opened (lambda () (di))))
      (closer)))
(define (ca5v-ball-in-ball! y a z b)
  (let ()
    (dk-have! (list 'SUBSET (list 'BALL 'CC-MS y a) (list 'BALL 'CC-MS z b))
      (lambda ()
        (let* ((w (subset-by-element!)))
          (ca5x-ball-open! y a w)
          (let* ((wy (list '- w y)) (yz (list '- y z)) (wz (list '- w z)))
            (ca5v-cc! wy) (ca5v-cc! yz) (ca5v-cc! wz)
            (ca5v-and! (list 'IN wy 'CC) (list 'IN yz 'CC))
            (let ((tri (dk-cite! 'cc-magnitude-triangle wy yz)))
              (dk-have! (list '= (list '+ wy yz) wz) (lambda () (crs)))
              (dk-rewrite-h! tri (list '+ wy yz) wz)
              (ca5v-rr! (list 'magnitude wy)) (ca5v-rr! (list 'magnitude yz)) (ca5v-rr! (list 'magnitude wz))
              (dk-have! (list '< (list 'magnitude wz) b)
                (lambda () (dk-ineq! (list '<= (list 'magnitude wz) (list '+ (list 'magnitude wy) (list 'magnitude yz)))
                                     (list '< (list 'magnitude wy) a)
                                     (list '<= (list '+ (list 'magnitude yz) a) b))))
              (ca5x-in-ball! w z b)
              (if (not (dk-asm? (dk-goal))) (error "ca5v-ball-in-ball!: no membership")) (ass))))))))
(define (ca5v-deriv-typ! g w)
  (let ((typ (list 'IN (list 'DERIV-ON 'CC-NORMED-FIELD 'u g w) 'CC)))
    (if (not (dk-asm? typ))
        (let* ((l (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff 'u g) w))))
          (dk-cite! 'cc-deriv-on-of-is-diff-on 'u g w l)
          (dk-cite! 'diff-on-deriv-in-carr 'CC-NORMED-FIELD 'u g w l)
          (fact 'cc-nf-carr)
          (dk-have! (list 'IN l 'CC) (lambda () (subst '(== CC (CARR CC-NORMED-FIELD))) (ass)))
          (dk-have! typ (lambda () (subst (list '= (list 'DERIV-ON 'CC-NORMED-FIELD 'u g w) l)) (ass)))))
    typ))

;;; instantiation, remember the deepest stage the context holds, and dk-apply! from there
(define (ca5-strip-imps g)
  (if (and (pair? g) (eq? (car g) 'IMPLIES) (dk-asm? (cadr g))) (ca5-strip-imps (caddr g)) g))
(define (ca5-apply! f . terms)
  (let loop ((g (->raw-formula f)) (ts terms) (best f) (rest terms))
    (let* ((g1 (ca5-strip-imps g))
           (here (and (not (eq? g (->raw-formula f))) (dk-ctx-form g1)))
           (best2 (if here here best))
           (rest2 (if here ts rest)))
      (cond ((null? ts)
             (or (dk-ctx-form g1)
                 (if (null? rest2) best2 (apply dk-apply! best2 rest2))))
            ((and (pair? g1) (eq? (car g1) 'FORALL))
             (loop (subst-free (cadr g1) (car ts) (caddr g1)) (cdr ts) best2 rest2))
            (#t (apply dk-apply! best2 rest2))))))
(define ca5-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (ca5-dv u f y) (list 'DERIV-ON 'CC-NORMED-FIELD u f y))
;;; ======================================================================
;;; (1) LEMMA 5.21 on the exhaustion: |f'| on K_n is at most 4(n+1) times sup |f| on K_{4n+3}
;;; ======================================================================
;; H in context contains (* T 1), T real-typed: land H with (* T 1) replaced by T (crs cannot see through T)
(define (ca5-drop-times1! h tm)
  (let* ((tv (dk-name! tm))
         (h1 (dk-rewrite-h! h tm tv))
         (h1f (dk-ctx-form (ca5x-subst-sym2 h tm tv))))
    (dk-have! (list '= (list '* tv 1) tv) (lambda () (crs)))
    (let* ((h2 (ca5x-subst-sym2 h1f (list '* tv 1) tv)))
      (dk-rewrite-h! h1f (list '* tv 1) tv)
      (dk-rewrite-h! h2 tv tm)
      (ca5x-subst-sym2 h2 tv tm))))
(define (ca5x-subst-sym2 e from to)
  (cond ((equal? e from) to)
        ((pair? e) (cons (ca5x-subst-sym2 (car e) from to) (ca5x-subst-sym2 (cdr e) from to)))
        (#t e)))
(define (ca5-r1 n) (list 'recip (list '+ n 1)))
(define (ca5-m4 n) (list '+ (list '* 4 n) 3))
;; c in RR, c /= 0, u = c * v (all real): land v = recip(c) * u
(sp (make-wff '(FORALL n (IMPLIES (IN n NN)
   (= (recip (+ (+ (* 4 n) 3) 1)) (* 1/4 (recip (+ n 1))))))))
(dk-peel!)
(let* ((a '(+ n 1)) (c '(+ (+ (* 4 n) 3) 1)) (r1 (list 'recip a)) (v (list '* 1/4 r1)))
  (fact 'nn-in-rr 'n) (fact 'nn-zero-le 'n)
  (ca5x-rr! a) (ca5x-rr! c)
  (dk-have! (list '< 0 a) (lambda () (dk-ineq! '(<= 0 n))))
  (dk-have! (list '< 0 c) (lambda () (dk-ineq! '(<= 0 n))))
  (fact 'rr-pos-ne-zero a) (fact 'rr-pos-ne-zero c)
  (ca5x-rr! r1) (ca5x-rr! v)
  (ca5x-and! (list 'IN a 'RR) (list 'NOT (list '= a 0)))
  (fact 'rr-recip-inverse a)
  (fact 'rr-one-in)
  (let ((rv (dk-name! r1)))
    (dk-rewrite-h! (list '= (list '* a r1) 1) r1 rv)
    (dk-have! (list '= 1 (list '* c (list '* 1/4 rv)))
      (lambda ()
        (dk-have! (list '= (list '* c (list '* 1/4 rv)) (list '* a rv)) (lambda () (crs)))
        (subst (list '= (list '* c (list '* 1/4 rv)) (list '* a rv)))
        (subst (list '= (list '* a rv) 1))
        (rfl)))
    (fact 'rr-mul-in-rr 1/4 rv)
    (dk-cite! 'rr-recip-solve c 1 (list '* 1/4 rv))
    (ca5x-and! (list 'IN c 'RR) (list 'NOT (list '= c 0)))
    (fact 'rr-recip-closed c)
    (ca5-drop-times1! (list '= (list '* 1/4 rv) (list '* (list 'recip c) 1)) (list 'recip c))
    (subst (list '= r1 rv))
    (subst (list '= (list 'recip c) (list '* 1/4 rv)))
    (if (not (proof-done? *ps*)) (rfl))))
