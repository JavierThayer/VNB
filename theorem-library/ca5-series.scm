;;; ======================================================================
;;; (3) the Weierstrass M-test on a set xs: a series of functions normally convergent on xs
;;;     converges at each point of xs, and its partial sums converge to the sum uniformly on xs
;;; ======================================================================
(define (ca5-fz z) (list 'VNB-LAMBDA 'cmi_ 'NN (list '(g cmi_) z)))
(define (ca5-mz z) (list 'VNB-LAMBDA 'cmi_ 'NN (list 'magnitude (list '(g cmi_) z))))
(define (ca5-dz z) (list 'VNB-LAMBDA 'cmi_ 'NN (list '- '(CC-SUP-NORM (g cmi_) xs) (list 'magnitude (list '(g cmi_) z)))))
(define ca5-an '(VNB-LAMBDA cpsi_ NN (CC-SUP-NORM (g cpsi_) xs)))
(define ca5-gty '(FORALL cmi_ (IMPLIES (IN cmi_ NN) (FORALL cmy_ (IMPLIES (IN cmy_ xs) (IN ((g cmi_) cmy_) CC))))))
(define ca5-anr '(FORALL cpsi_ (IMPLIES (IN cpsi_ NN) (IN (CC-SUP-NORM (g cpsi_) xs) RR))))
(define (ca5-open!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))
(define (ca5-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
(define (ca5-mzle z)
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'AND (list '<= 0 (list (ca5-mz z) 'n)) (list '<= (list (ca5-mz z) 'n) (list ca5-an 'n))))))
;; at i in NN, z in xs: ((g i) z) in CC, |.| in RR and >= 0, CC-SUP-NORM(g i, xs) in RR
(define (ca5-gpt! i z)
  (ca5-apply! (dk-ctx-form ca5-gty) i z)
  (ca5-apply! (dk-ctx-form ca5-anr) i)
  (fact 'cc-magnitude-closed (list (list 'g i) z))
  (fact 'cc-magnitude-nonneg (list (list 'g i) z)))
;; at i in NN, z in xs: |((g i) z)| <= CC-SUP-NORM(g i, xs)
(define (ca5-mle! i z)
  (dk-have! (list 'FORALL 'ky_ (list 'IMPLIES '(IN ky_ xs) (list 'IN (list (list 'g i) 'ky_) 'CC)))
    (lambda () (let ((y (dk-di-var!))) (ca5-apply! (dk-ctx-form ca5-gty) i y) (ca5-open!))))
  (dk-cite! 'cc-sup-norm-upper (list 'g i) 'xs z))
;; IS-NORMALLY-CONVERGENT(g, xs) in context: land its two clauses and an in FUN(NN, RR)
(define (ca5-mtest-setup!)
  (let* ((ni (dk-cite! 'is-normally-convergent 'g 'xs)) (nr (caddr ni)))
    (if (not (dk-asm? nr)) (dk-have! nr (lambda () (dk-only! ni '(IS-NORMALLY-CONVERGENT g xs)) (prop))))
    (dk-split-all! (list nr))
    (dk-have! (list 'IN ca5-an '(FUN NN RR))
      (lambda () (dk-lam-type! (lambda () (let ((i (dk-di-var!))) (ca5-apply! (dk-ctx-form ca5-anr) i) (ca5-open!))))))))
