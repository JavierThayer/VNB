                           (list '< (list 'magnitude (list '- w 'y)) h) '(<= (magnitude y) n) (list '<= r1 1) '(<= 0 n))))
    (dk-have! (list 'SUBSET (list 'BALL 'CC-MS w r4) 'u)
      (lambda ()
        (let ((v (subset-by-element!)))
          (ca5x-ball-open! w r4 v)
          (ca5v-rr! (list 'magnitude (list '- v w))) (ca5v-rr! (list 'magnitude (list '- v 'y)))
          (dk-cite! 'cc-magnitude-sub-chain v w 'y)
          (dk-have! (list '< (list 'magnitude (list '- v 'y)) r1)
            (lambda () (dk-ineq! (list '<= (list 'magnitude (list '- v 'y)) (list '+ (list 'magnitude (list '- v w)) (list 'magnitude (list '- w 'y))))
                                 (list '< (list 'magnitude (list '- v w)) r4)
