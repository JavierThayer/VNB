    (dk-have! (list 'AND (list 'IN w 'CC) (list 'AND (list '<= (list 'magnitude w) m) (list 'SUBSET (list 'BALL 'CC-MS w r4) 'u)))
      (lambda () (dk-conj-close! (lambda () (ass)))))
