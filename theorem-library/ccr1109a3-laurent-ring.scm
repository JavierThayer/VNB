;; a truncated Laurent series is finitely supported
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) (FORALL fq_ (IMPLIES (IN fq_ (FUN ZZ (CARR kq_)))
   (FORALL bq_ (IMPLIES (IN bq_ ZZ) (IMPLIES ,(c3t-below 'kq_ 'fq_ 'bq_)
   (FORALL tq_ (IMPLIES (IN tq_ ZZ) (IN (LAURENT-TRUNC kq_ fq_ tq_) (FINSUPP kq_ ZZ-ADD-MONOID)))))))))))))
