;;; ---- driver helpers for the laws ----
;; F in LAURENT-SET K in context: land F in FUN(ZZ, CARR K)
(define (c3t-lfun! k f)
  (if (not (dk-asm? `(IN ,f ,(c3t-funk k))))
      (begin (dk-chain-ass! (dk-cite! 'laurent-set-out k f))
             (dk-split! (dk-pick (lambda (h) (and (dk-head-is? h 'AND) (equal? (cadr h) `(IN ,f ,(c3t-funk k))))) "laurent-set-out")))))
;; FS in LAURENT-SET K in context: return a bound B in ZZ with B <= 0 and every F of FS vanishing below B
(define (c3t-bounds! k fs)
  (fact 'zz-zero-in) (dk-cite! 'zz-in-rr 0)
  (let loop ((fs fs) (prev 0) (got '()) (les '()))
    (if (null? fs)
        (begin
          (for-each (lambda (fb)
                      (if (not (eq? (cdr fb) prev))
                          (begin
                            (dk-have! `(<= ,prev ,(cdr fb)) (lambda () (apply dk-ineq! les)))
                            (dk-chain-ass! (dk-cite! 'laurent-below-mono k (car fb) (cdr fb) prev)))))
                    got)
          (if (not (dk-asm? `(<= ,prev 0))) (dk-have! `(<= ,prev 0) (lambda () (apply dk-ineq! les))))
          prev)
        (let ((b (dk-skolem! (dk-chain-ass! (dk-cite! 'laurent-bound-le k (car fs) prev)))))
          (dk-split-all!)
          (dk-cite! 'zz-in-rr b)
          (loop (cdr fs) b (cons (cons (car fs) b) got) (cons `(<= ,b ,prev) les))))))
;; the level t = v - c in ZZ with v <= t + c, for v, c in ZZ
(define (c3t-level! v c)
  (let ((tt `(+ ,v (- ,c))))
    (dk-cite! 'zz-in-rr v) (dk-cite! 'zz-in-rr c)
    (dk-cite! 'zz-neg-closed c)
    (dk-have-and! `(IN ,v ZZ) `(IN (- ,c) ZZ))
    (dk-cite! 'zz-add-closed v `(- ,c))
    (dk-cite! 'zz-in-rr tt)
    (dk-have! `(<= ,v (+ ,tt ,c)) (lambda () (dk-ineq!)))
    tt))
;; the truncation facts at level t for F (in FUN, vanishing below b): typing, vanishing, finite support
(define (c3t-trunc-facts! k f b t)
  (dk-cite! 'laurent-trunc-fun k f t)
  (dk-chain-ass! (dk-cite! 'laurent-trunc-low k f b t))
  (dk-chain-ass! (dk-cite! 'laurent-trunc-finsupp k f b t)))
;; prove agree(F, F2, t) with POINT! closing (= (F j) (F2 j)) at the eigenvariable j (j in ZZ, j <= t in context)
(define (c3t-agree! f f2 t point!)
  (dk-have! (c3t-agree f f2 t)
    (lambda ()
      (dk-peel!)
      (let ((j (find-first (lambda (v) (dk-asm? `(<= ,v ,t))) (map cadr (filter (lambda (h) (dk-head-is? h '<=)) (dk-asms))))))
        (dk-cite! 'zz-in-rr j)
        (point! j)))))
(define (c3t-zfacts!)
  (fact 'zz-is-set)
  (dk-cite! 'zz-add-monoid-is-monoid)
  (dk-cite! 'zz-add-monoid-carr))
(define (c3t-inz! v)
  (if (not (dk-asm? `(IN ,v (CARR ZZ-ADD-MONOID))))
      (dk-have! `(IN ,v (CARR ZZ-ADD-MONOID)) (lambda () (subst '(= (CARR ZZ-ADD-MONOID) ZZ)) (dk-close-if-asm!)))))

;;; ---- K((x)) is closed under the product ----
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) ,(c3t-all 'fq_ '(LAURENT-SET kq_) (c3t-all 'gq_ '(LAURENT-SET kq_)
   '(IN (LAURENT-MUL kq_ fq_ gq_) (LAURENT-SET kq_))))))))
(dk-peel!)
(let* ((k 'kq_) (b (c3t-bounds! k '(fq_ gq_))) (mm (c3t-mm k 'fq_ 'gq_)))
  (c3t-lfun! k 'fq_) (c3t-lfun! k 'gq_)
  (mac 'LAURENT-MUL)
  (dk-chain-ass! (dk-cite! 'laurent-mul-vanish k 'fq_ 'gq_ b))
  (dk-chain-ass! (dk-cite! 'laurent-mul-fun k 'fq_ 'gq_ b))
  (dk-have-and! `(IN ,b ZZ) `(IN ,b ZZ))
  (dk-cite! 'zz-add-closed b b)
  (dk-chain-ass! (dk-cite! 'laurent-set-in k mm `(+ ,b ,b)))
  (dk-close-if-asm!))
(qed 'laurent-mul-in)

;;; ---- commutativity (K commutative) ----
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-COMMUTATIVE-RING kq_) ,(c3t-all 'fq_ '(LAURENT-SET kq_) (c3t-all 'gq_ '(LAURENT-SET kq_)
   '(= (LAURENT-MUL kq_ fq_ gq_) (LAURENT-MUL kq_ gq_ fq_))))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'commutative-ring-is-ring 'kq_))
(let* ((k 'kq_) (f 'fq_) (g 'gq_) (b (c3t-bounds! k (list f g))))
  (c3t-lfun! k f) (c3t-lfun! k g)
  (c3t-zfacts!)
  (dk-cite! 'zz-add-monoid-is-comm-monoid)
  (mac 'LAURENT-MUL)
  (dk-chain-ass! (dk-cite! 'laurent-mul-fun k f g b))
  (dk-chain-ass! (dk-cite! 'laurent-mul-fun k g f b))
  (dk-fun-ext! (c3t-mm k f g) (c3t-mm k g f) 'ZZ `(CARR ,k) #f #f
    (lambda (v)
      (let* ((t (c3t-level! v b)) (tf (c3t-tr k f t)) (tg (c3t-tr k g t)))
        (c3t-inz! v)
        (c3t-trunc-facts! k f b t) (c3t-trunc-facts! k g b t)
        (subst (dk-chain-ass! (dk-cite! 'laurent-mul-trunc k f g b v t)))
        (subst (dk-chain-ass! (dk-cite! 'laurent-mul-trunc k g f b v t)))
        (subst (dk-chain-ass! (dk-cite! 'monalg-mul-comm k c3t-Z tf tg)))
        (dk-chain-ass! (dk-cite! 'monalg-mul-value-in-carr k c3t-Z tg tf v))
        (c3t-rfl!)))))
(qed 'laurent-mul-comm)

;;; ---- the unit ----
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) ,(c3t-all 'fq_ '(LAURENT-SET kq_)
   '(= (LAURENT-MUL kq_ (LAURENT-ONE kq_) fq_) fq_))))))
(dk-peel!)
(let* ((k 'kq_) (f 'fq_) (one '(LAURENT-ONE kq_)) (b (c3t-bounds! k (list f))))
  (c3t-lfun! k f)
  (c3t-zfacts!)
  (dk-cite! 'laurent-one-in k) (c3t-lfun! k one)
  (dk-chain-ass! (dk-cite! 'laurent-one-low k b))
  (dk-cite! 'laurent-one-monalg k)
  (mac 'LAURENT-MUL)
  (dk-chain-ass! (dk-cite! 'laurent-mul-fun k one f b))
  (dk-fun-ext! (c3t-mm k one f) f 'ZZ `(CARR ,k) #f #f
    (lambda (v)
      (let* ((t (c3t-level! v b)) (tf (c3t-tr k f t)))
        (c3t-inz! v)
        (c3t-trunc-facts! k f b t)
        (c3t-agree! one one t (lambda (j) (c3t-app! k one j) (c3t-rfl!)))
        (c3t-agree! f tf t (lambda (j) (c3t-app! k f j) (subst (dk-chain-ass! (dk-cite! 'laurent-trunc-le k f t j))) (c3t-rfl!)))
        (subst (dk-chain-ass! (dk-cite! 'laurent-mul-local k one one f tf b t v)))
        (subst `(= ,one (MONALG-ONE ,k ZZ-ADD-MONOID)))
        (subst (dk-chain-ass! (dk-cite! 'monalg-one-left-fn k c3t-Z tf)))
        (dk-have! `(<= ,v ,t) (lambda () (dk-ineq! `(<= ,v (+ ,t ,b)) `(<= ,b 0))))
        (subst (dk-chain-ass! (dk-cite! 'laurent-trunc-le k f t v)))
        (c3t-app! k f v)
        (c3t-rfl!)))))
(qed 'laurent-mul-one)

;;; ---- associativity ----
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) ,(c3t-all 'fq_ '(LAURENT-SET kq_) (c3t-all 'gq_ '(LAURENT-SET kq_)
   (c3t-all 'hq_ '(LAURENT-SET kq_)
   '(= (LAURENT-MUL kq_ (LAURENT-MUL kq_ fq_ gq_) hq_) (LAURENT-MUL kq_ fq_ (LAURENT-MUL kq_ gq_ hq_))))))))))
(dk-peel!)
(let* ((k 'kq_) (f 'fq_) (g 'gq_) (h 'hq_) (b (c3t-bounds! k (list f g h)))
       (c `(+ ,b ,b)) (fg (c3t-mm k f g)) (gh (c3t-mm k g h)))
  (for-each (lambda (x) (c3t-lfun! k x)) (list f g h))
  (c3t-zfacts!)
  (let lp () (if (dk-contains? (dk-goal) 'LAURENT-MUL) (begin (mac 'LAURENT-MUL) (lp))))
  (dk-have-and! `(IN ,b ZZ) `(IN ,b ZZ))
  (dk-cite! 'zz-add-closed b b)
  (dk-cite! 'zz-in-rr c)
  (dk-have! `(<= ,c ,b) (lambda () (dk-ineq! `(<= ,b 0))))
  (for-each (lambda (x) (dk-chain-ass! (dk-cite! 'laurent-below-mono k x b c))) (list f h))
  (dk-chain-ass! (dk-cite! 'laurent-mul-fun k f g b))
  (dk-chain-ass! (dk-cite! 'laurent-mul-fun k g h b))
  (dk-chain-ass! (dk-cite! 'laurent-mul-vanish k f g b))
  (dk-chain-ass! (dk-cite! 'laurent-mul-vanish k g h b))
  (dk-chain-ass! (dk-cite! 'laurent-mul-fun k fg h c))
  (dk-chain-ass! (dk-cite! 'laurent-mul-fun k f gh c))
  (dk-fun-ext! (c3t-mm k fg h) (c3t-mm k f gh) 'ZZ `(CARR ,k) #f #f
    (lambda (v)
      (let* ((t (c3t-level! v c)) (m (c3t-level! t b))
             (fm (c3t-tr k f m)) (gm (c3t-tr k g m)) (hm (c3t-tr k h m))
             (fgm (c3t-mm k fm gm)) (ghm (c3t-mm k gm hm)))
        (c3t-inz! v)
        (for-each (lambda (x) (c3t-trunc-facts! k x b m)) (list f g h))
        (for-each (lambda (x) (dk-chain-ass! (dk-cite! 'laurent-below-mono k x b c))) (list fm hm))
        (dk-chain-ass! (dk-cite! 'laurent-mul-fun k fm gm b))
        (dk-chain-ass! (dk-cite! 'laurent-mul-fun k gm hm b))
        (dk-chain-ass! (dk-cite! 'laurent-mul-vanish k fm gm b))
        (dk-chain-ass! (dk-cite! 'laurent-mul-vanish k gm hm b))
        (dk-have! `(<= ,t ,m) (lambda () (dk-ineq! `(<= ,b 0))))
        ;; agreement at indices <= t
        (c3t-agree! fg fgm t
          (lambda (j) (dk-have! `(<= ,j (+ ,m ,b)) (lambda () (dk-ineq! `(<= ,j ,t))))
                      (dk-chain-ass! (dk-cite! 'laurent-mul-trunc k f g b j m)) (dk-close-if-asm!)))
        (c3t-agree! gh ghm t
          (lambda (j) (dk-have! `(<= ,j (+ ,m ,b)) (lambda () (dk-ineq! `(<= ,j ,t))))
                      (dk-chain-ass! (dk-cite! 'laurent-mul-trunc k g h b j m)) (dk-close-if-asm!)))
        (for-each
          (lambda (x xm)
            (c3t-agree! x xm t
              (lambda (j) (c3t-app! k x j)
                          (dk-have! `(<= ,j ,m) (lambda () (dk-ineq! `(<= ,j ,t) `(<= ,t ,m))))
                          (subst (dk-chain-ass! (dk-cite! 'laurent-trunc-le k x m j))) (c3t-rfl!))))
          (list f h) (list fm hm))
        (subst (dk-chain-ass! (dk-cite! 'laurent-mul-local k fg fgm h hm c t v)))
        (subst (dk-chain-ass! (dk-cite! 'laurent-mul-local k f fm gh ghm c t v)))
        (subst (dk-chain-ass! (dk-cite! 'monalg-mul-assoc-at k c3t-Z fm gm hm v)))
        (dk-chain-ass! (dk-cite! 'monalg-mul-fun k c3t-Z gm hm))
        (dk-chain-ass! (dk-cite! 'monalg-mul-value-in-carr k c3t-Z fm ghm v))
        (c3t-rfl!)))))
(qed 'laurent-mul-assoc)

;;; ---- distributivity (left) ----
;; X in FINSUPP(K, Z) in context: land X in FUN(ZZ, CARR K)
(define (c3t-fs-fun! k x)
  (dk-iff-fwd! (dk-cite! 'finsupp-membership k c3t-Z x))
  (dk-rewrite-h! `(IN ,x (FUN (CARR ZZ-ADD-MONOID) (CARR ,k))) '(CARR ZZ-ADD-MONOID) 'ZZ))
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) ,(c3t-all 'fq_ '(LAURENT-SET kq_) (c3t-all 'gq_ '(LAURENT-SET kq_)
   (c3t-all 'hq_ '(LAURENT-SET kq_)
   '(= (LAURENT-MUL kq_ fq_ (LAURENT-ADD kq_ gq_ hq_))
       (LAURENT-ADD kq_ (LAURENT-MUL kq_ fq_ gq_) (LAURENT-MUL kq_ fq_ hq_))))))))))
(dk-peel!)
(let* ((k 'kq_) (f 'fq_) (g 'gq_) (h 'hq_) (b (c3t-bounds! k (list f g h)))
       (gh '(LAURENT-ADD kq_ gq_ hq_)) (fg (c3t-mm k f g)) (fh (c3t-mm k f h))
       (rhs `(LAURENT-ADD ,k ,fg ,fh)))
  (for-each (lambda (x) (c3t-lfun! k x)) (list f g h))
  (dk-cite! 'ring-zero-in k)
  (c3t-zfacts!)
  (dk-cite! 'laurent-add-in k g h) (c3t-lfun! k gh)
  (mac 'LAURENT-MUL)
  ;; g + h vanishes below b
  (dk-have! (c3t-below k gh b)
    (lambda ()
      (dk-peel!)
      (let ((j (find-first (lambda (v) (dk-asm? `(< ,v ,b))) (map cadr (filter (lambda (x) (dk-head-is? x '<)) (dk-asms))))))
        (subst (dk-cite! 'laurent-add-apply k g h j))
        (subst (dk-chain-ass! (dk-apply! (c3t-below k g b) j)))
        (subst (dk-chain-ass! (dk-apply! (c3t-below k h b) j)))
        (subst (dk-cite! 'ring-add-left-id k `(ZERO ,k)))
        (c3t-rfl!))))
  (dk-chain-ass! (dk-cite! 'laurent-mul-fun k f gh b))
  (for-each (lambda (x) (dk-chain-ass! (dk-cite! 'laurent-mul-fun k f x b))
                        (dk-chain-ass! (dk-cite! 'laurent-mul-vanish k f x b)))
            (list g h))
  (dk-have-and! `(IN ,b ZZ) `(IN ,b ZZ))
  (dk-cite! 'zz-add-closed b b)
  (dk-chain-ass! (dk-cite! 'laurent-set-in k fg `(+ ,b ,b)))
  (dk-chain-ass! (dk-cite! 'laurent-set-in k fh `(+ ,b ,b)))
  (dk-cite! 'laurent-add-in k fg fh) (c3t-lfun! k rhs)
  (dk-fun-ext! (c3t-mm k f gh) rhs 'ZZ `(CARR ,k) #f #f
    (lambda (v)
      (let* ((t (c3t-level! v b)) (tf (c3t-tr k f t)) (tg (c3t-tr k g t)) (th (c3t-tr k h t))
             (ma `(MONALG-ADD ,k ZZ-ADD-MONOID ,tg ,th)))
        (c3t-inz! v)
        (for-each (lambda (x) (c3t-trunc-facts! k x b t)) (list f g h))
        (dk-chain-ass! (dk-cite! 'monalg-add-fun k c3t-Z tg th))
        (dk-have! `(IN ,ma ,(c3t-funk k)) (lambda () (c3t-fs-fun! k ma) (dk-close-if-asm!)))
        (dk-have! (c3t-below k ma b)
          (lambda ()
            (dk-peel!)
            (let ((j (find-first (lambda (x) (dk-asm? `(< ,x ,b))) (map cadr (filter (lambda (x) (dk-head-is? x '<)) (dk-asms))))))
              (c3t-inz! j)
              (subst (dk-cite! 'monalg-add-apply k c3t-Z tg th j))
              (subst (dk-chain-ass! (dk-apply! (c3t-below k tg b) j)))
              (subst (dk-chain-ass! (dk-apply! (c3t-below k th b) j)))
              (subst (dk-cite! 'ring-add-left-id k `(ZERO ,k)))
              (c3t-rfl!))))
        (c3t-agree! f tf t (lambda (j) (c3t-app! k f j) (subst (dk-chain-ass! (dk-cite! 'laurent-trunc-le k f t j))) (c3t-rfl!)))
        (c3t-agree! gh ma t
          (lambda (j)
            (c3t-inz! j)
            (c3t-app! k g j) (c3t-app! k h j)
            (subst (dk-cite! 'laurent-add-apply k g h j))
            (subst (dk-cite! 'monalg-add-apply k c3t-Z tg th j))
            (subst (dk-chain-ass! (dk-cite! 'laurent-trunc-le k g t j)))
            (subst (dk-chain-ass! (dk-cite! 'laurent-trunc-le k h t j)))
            (dk-cite! 'ring-add-closed k `(,g ,j) `(,h ,j))
            (c3t-rfl!)))
        (dk-chain-ass! (dk-cite! 'laurent-mul-trunc k f g b v t))
        (dk-chain-ass! (dk-cite! 'laurent-mul-trunc k f h b v t))
        (subst (dk-chain-ass! (dk-cite! 'laurent-mul-local k f tf gh ma b t v)))
        (subst (dk-chain-ass! (dk-cite! 'monalg-distrib-left k c3t-Z tf tg th)))
        (for-each (lambda (x) (dk-chain-ass! (dk-cite! 'monalg-mul-fun k c3t-Z tf x))) (list tg th))
        (subst (dk-cite! 'monalg-add-apply k c3t-Z (c3t-mm k tf tg) (c3t-mm k tf th) v))
        (subst `(= (,(c3t-mm k tf tg) ,v) (,fg ,v)))
        (subst `(= (,(c3t-mm k tf th) ,v) (,fh ,v)))
        (subst (dk-cite! 'laurent-add-apply k fg fh v))
        (c3t-app! k fg v) (c3t-app! k fh v)
        (dk-cite! 'ring-add-closed k `(,fg ,v) `(,fh ,v))
        (c3t-rfl!)))))
(qed 'laurent-mul-distrib-left)

;;; ---- the additive laws, pointwise ----
(define (c3t-ls k) `(LAURENT-SET ,k))
(define (c3t-la k f g) `(LAURENT-ADD ,k ,f ,g))
(define (c3t-ln k f) `(LAURENT-NEG ,k ,f))
;; type the Laurent terms TS (each built from LAURENT-ADD / -NEG / -ZERO over members of LAURENT-SET in context)
(define (c3t-ltype! k t)
  (cond ((dk-asm? `(IN ,t ,(c3t-ls k))) #t)
        ((dk-head-is? t 'LAURENT-ADD) (c3t-ltype! k (caddr t)) (c3t-ltype! k (cadddr t)) (dk-cite! 'laurent-add-in k (caddr t) (cadddr t)))
        ((dk-head-is? t 'LAURENT-NEG) (c3t-ltype! k (caddr t)) (dk-cite! 'laurent-neg-in k (caddr t)))
        ((dk-head-is? t 'LAURENT-ZERO) (dk-cite! 'laurent-zero-in k))
        (#t (error "c3t-ltype!: cannot type" t)))
  (c3t-lfun! k t))
;; the value at j of a Laurent term, rewritten in the goal down to K's operations on the atoms' values
(define (c3t-lval! k t j)
  (cond ((dk-head-is? t 'LAURENT-ADD)
         (subst (dk-cite! 'laurent-add-apply k (caddr t) (cadddr t) j))
         (c3t-lval! k (caddr t) j) (c3t-lval! k (cadddr t) j))
        ((dk-head-is? t 'LAURENT-NEG)
         (subst (dk-cite! 'laurent-neg-apply k (caddr t) j))
         (c3t-lval! k (caddr t) j))
        ((dk-head-is? t 'LAURENT-ZERO) (subst (dk-cite! 'laurent-zero-apply k j)))
        (#t (c3t-app! k t j))))
(define (c3t-pw-law! k lhs rhs atoms close!)
  (c3t-ltype! k lhs) (c3t-ltype! k rhs)
  (dk-fun-ext! lhs rhs 'ZZ `(CARR ,k) #f #f
    (lambda (v)
      (c3t-lval! k lhs v) (c3t-lval! k rhs v)
      (close! (map (lambda (a) `(,a ,v)) atoms)))))

(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) ,(c3t-all 'fq_ (c3t-ls 'kq_) (c3t-all 'gq_ (c3t-ls 'kq_) (c3t-all 'hq_ (c3t-ls 'kq_)
   `(= ,(c3t-la 'kq_ (c3t-la 'kq_ 'fq_ 'gq_) 'hq_) ,(c3t-la 'kq_ 'fq_ (c3t-la 'kq_ 'gq_ 'hq_))))))))))
(dk-peel!)
(c3t-pw-law! 'kq_ (c3t-la 'kq_ (c3t-la 'kq_ 'fq_ 'gq_) 'hq_) (c3t-la 'kq_ 'fq_ (c3t-la 'kq_ 'gq_ 'hq_)) '(fq_ gq_ hq_)
  (lambda (vs)
    (dk-cite! 'ring-add-closed 'kq_ (car vs) (cadr vs)) (dk-cite! 'ring-add-closed 'kq_ (cadr vs) (caddr vs))
    (subst (apply dk-cite! 'ring-add-assoc 'kq_ vs))
    (dk-cite! 'ring-add-closed 'kq_ (car vs) `((ADD kq_) ,(cadr vs) ,(caddr vs)))
    (c3t-rfl!)))
(qed 'laurent-add-assoc)

(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) ,(c3t-all 'fq_ (c3t-ls 'kq_) (c3t-all 'gq_ (c3t-ls 'kq_)
   `(= ,(c3t-la 'kq_ 'fq_ 'gq_) ,(c3t-la 'kq_ 'gq_ 'fq_))))))))
(dk-peel!)
(c3t-pw-law! 'kq_ (c3t-la 'kq_ 'fq_ 'gq_) (c3t-la 'kq_ 'gq_ 'fq_) '(fq_ gq_)
  (lambda (vs)
    (subst (apply dk-cite! 'ring-add-comm 'kq_ vs))
    (dk-cite! 'ring-add-closed 'kq_ (cadr vs) (car vs))
    (c3t-rfl!)))
(qed 'laurent-add-comm)

(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) ,(c3t-all 'fq_ (c3t-ls 'kq_)
   `(= ,(c3t-la 'kq_ '(LAURENT-ZERO kq_) 'fq_) fq_))))))
(dk-peel!)
(dk-cite! 'ring-zero-in 'kq_)
(c3t-pw-law! 'kq_ (c3t-la 'kq_ '(LAURENT-ZERO kq_) 'fq_) 'fq_ '(fq_)
  (lambda (vs)
    (subst (dk-cite! 'ring-add-left-id 'kq_ (car vs)))
    (c3t-rfl!)))
(qed 'laurent-add-zero-left)

(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) ,(c3t-all 'fq_ (c3t-ls 'kq_)
   `(= ,(c3t-la 'kq_ (c3t-ln 'kq_ 'fq_) 'fq_) (LAURENT-ZERO kq_)))))))
(dk-peel!)
(dk-cite! 'ring-zero-in 'kq_)
(c3t-pw-law! 'kq_ (c3t-la 'kq_ (c3t-ln 'kq_ 'fq_) 'fq_) '(LAURENT-ZERO kq_) '(fq_)
  (lambda (vs)
    (subst (dk-cite! 'ring-add-left-inv 'kq_ (car vs)))
    (c3t-rfl!)))
(qed 'laurent-add-neg-left)

;;; ---- K((x)) is a commutative ring (the assembly of monalg-is-ring.scm) ----
(define c3r-F '(LAURENT-SET kq_))
(define c3r-FF (list 'CARTESIAN c3r-F c3r-F))
(define (c3r-readoff! name acc rhs)
  (dk-sp-qed! (make-wff (list 'FORALL 'kq_ (list 'IMPLIES '(IS-RING kq_)
                (list '== (list acc '(LAURENT-RING kq_)) rhs))))
    (lambda () (dk-peel!) (mac 'LAURENT-RING) (slot acc) (nth-r) (qrfl))
    name))
(c3r-readoff! 'laurent-ring-carr 'CARR c3r-F)
(c3r-readoff! 'laurent-ring-add 'ADD (list 'VNB-LAMBDA '(LIST lrf_ lrg_) c3r-FF '(LAURENT-ADD kq_ lrf_ lrg_)))
(c3r-readoff! 'laurent-ring-mul 'MUL (list 'VNB-LAMBDA '(LIST lrf_ lrg_) c3r-FF '(LAURENT-MUL kq_ lrf_ lrg_)))
(c3r-readoff! 'laurent-ring-neg 'NEG (list 'VNB-LAMBDA 'lrf_ c3r-F '(LAURENT-NEG kq_ lrf_)))
(c3r-readoff! 'laurent-ring-zero 'ZERO '(LAURENT-ZERO kq_))
(c3r-readoff! 'laurent-ring-one 'ONE '(LAURENT-ONE kq_))

(define (c3r-binders g)
  (cond ((and (pair? g) (eq? (car g) 'FORALL)) (cons (cadr g) (c3r-binders (caddr g))))
        ((and (pair? g) (eq? (car g) 'IMPLIES)) (c3r-binders (caddr g)))
        (#t '())))
(define (c3r-peel-binders!)
  (let ((vs (c3r-binders (dk-goal))))
    (dk-peel!)
    (for-each (lambda (v) (if (not (dk-asm? (list 'IN v c3r-F)))
                              (error "c3r-peel-binders!: eigenvariable not typed in context" v)))
              vs)
    vs))
(define (c3r-is? h oph)
  (lambda (g) (and (pair? g) (eq? (car g) h)
                   (let ((a1 (cadr g))) (and (pair? a1) (eq? (car a1) oph))))))
(define (c3r-disch! pred thunk)
  (let ((hit (any-pred (lambda (l) (pred (dk-goal-of l))) (dk-open-leaves))))
    (if (not hit) (error "c3r-disch!: no open leaf matches"))
    (dk-focus! hit)
    (thunk)))
(define (c3r-lam-t!)
  (let ((new (dk-opened (lambda () (lam-t)))))
    (for-each (lambda (l)
                (dk-focus! l)
                (let ((g (dk-goal-of l)))
                  (if (and (eq? (car g) 'IN) (eq? (caddr g) 'SET))
                      (if (and (pair? (cadr g)) (eq? (car (cadr g)) 'CARTESIAN))
                          (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (dk-ass!))))
                          (dk-ass!)))))
              new)
    (let ((typ (filter (lambda (l) (not (sequent-node-grounded? l))) new)))
      (if (null? typ) (error "c3r-lam-t!: no typing leaf left open"))
      (dk-focus! (car typ)))))
;; the goal's Laurent-operation term, typed by its closure law
(define (c3r-close-typing!)
  (let ((t (cadr (dk-goal))))
    (cond ((dk-head-is? t 'LAURENT-ADD) (dk-cite! 'laurent-add-in 'kq_ (caddr t) (cadddr t)))
          ((dk-head-is? t 'LAURENT-MUL) (dk-cite! 'laurent-mul-in 'kq_ (caddr t) (cadddr t)))
          ((dk-head-is? t 'LAURENT-NEG) (dk-cite! 'laurent-neg-in 'kq_ (caddr t)))
          (#t (error "c3r-close-typing!: unexpected" t)))
    (dk-close-if-asm!)))

(sp (make-wff '(FORALL kq_ (IMPLIES (IS-COMMUTATIVE-RING kq_) (IS-RING (LAURENT-RING kq_))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'commutative-ring-is-ring 'kq_))
(dk-cite! 'zz-is-set)
(dk-cite! 'ring-carr-in-set 'kq_)
(dk-have! (list 'IN c3r-F 'SET)
  (lambda ()
    (dk-have! '(IN (FUN ZZ (CARR kq_)) SET) (lambda () (mac 'fun-set-iff) (dk-conj-close! (lambda () (dk-ass!)))))
    (mac 'LAURENT-SET) (sep-set) (dk-close-if-asm!)))
(mac 'IS-RING)
(dk-isx-set!)
(let lp () (let ((l (any-pred (lambda (n) ((dk-head? 'AND) (dk-goal-of n))) (dk-open-leaves))))
             (when l (dk-focus! l) (di) (lp))))
(c3r-disch! (c3r-is? '= 'LENGTH) (lambda () (mac 'LAURENT-RING) (len-r) (c3t-rfl!)))
(c3r-disch! (c3r-is? 'IN 'CARR) (lambda () (mac 'laurent-ring-carr) (dk-close-if-asm!)))
(for-each
  (lambda (acc rd)
    (c3r-disch! (c3r-is? 'IN acc)
      (lambda () (mac 'laurent-ring-carr) (mac rd) (c3r-lam-t!) (dk-peel!) (c3r-close-typing!))))
  '(ADD MUL NEG) '(laurent-ring-add laurent-ring-mul laurent-ring-neg))
(c3r-disch! (c3r-is? 'IN 'ZERO) (lambda () (mac 'laurent-ring-carr) (mac 'laurent-ring-zero) (dk-cite! 'laurent-zero-in 'kq_) (dk-close-if-asm!)))
(c3r-disch! (c3r-is? 'IN 'ONE) (lambda () (mac 'laurent-ring-carr) (mac 'laurent-ring-one) (dk-cite! 'laurent-one-in 'kq_) (dk-close-if-asm!)))
;; add associative / commutative
(c3r-disch! (c3r-is? 'is-associative 'ADD)
  (lambda () (mac 'laurent-ring-carr) (mac 'laurent-ring-add) (mac 'is-associative)
    (let* ((vs (c3r-peel-binders!)) (u (car vs)) (v (cadr vs)) (w (caddr vs)))
      (dk-cite! 'laurent-add-in 'kq_ u v) (dk-cite! 'laurent-add-in 'kq_ v w)
      (dk-lam-b!)
      (dk-cite! 'laurent-add-assoc 'kq_ u v w) (dk-close-if-asm!))))
(c3r-disch! (c3r-is? 'is-commutative 'ADD)
  (lambda () (mac 'laurent-ring-carr) (mac 'laurent-ring-add) (mac 'is-commutative)
    (let ((vs (c3r-peel-binders!)))
      (dk-lam-b!)
      (dk-cite! 'laurent-add-comm 'kq_ (car vs) (cadr vs)) (dk-close-if-asm!))))
(c3r-disch! (c3r-is? 'is-identity 'ADD)
  (lambda () (mac 'laurent-ring-carr) (mac 'laurent-ring-add) (mac 'laurent-ring-zero) (mac 'is-identity)
    (let* ((vs (c3r-peel-binders!)) (u (car vs)) (z '(LAURENT-ZERO kq_)))
      (dk-cite! 'laurent-zero-in 'kq_)
      (dk-cite! 'laurent-add-zero-left 'kq_ u)
      (dk-cite! 'laurent-add-comm 'kq_ u z)
      (dk-have! `(= (LAURENT-ADD kq_ ,u ,z) ,u) (lambda () (subst `(= (LAURENT-ADD kq_ ,u ,z) (LAURENT-ADD kq_ ,z ,u))) (dk-close-if-asm!)))
      (dk-conj-close! (lambda () (dk-lam-b!) (dk-close-if-asm!))))))
(c3r-disch! (c3r-is? 'has-inverses 'ADD)
  (lambda () (mac 'laurent-ring-carr) (mac 'laurent-ring-add) (mac 'laurent-ring-neg) (mac 'laurent-ring-zero) (mac 'has-inverses)
    (let* ((vs (c3r-peel-binders!)) (u (car vs)) (nu `(LAURENT-NEG kq_ ,u)))
      (dk-cite! 'laurent-neg-in 'kq_ u)
      (dk-cite! 'laurent-add-neg-left 'kq_ u)
      (dk-cite! 'laurent-add-comm 'kq_ u nu)
      (dk-have! `(= (LAURENT-ADD kq_ ,u ,nu) (LAURENT-ZERO kq_))
        (lambda () (subst `(= (LAURENT-ADD kq_ ,u ,nu) (LAURENT-ADD kq_ ,nu ,u))) (dk-close-if-asm!)))
      (dk-conj-close! (lambda () (dk-lam-b!) (dk-close-if-asm!))))))
;; mul associative / identity / distributive
(c3r-disch! (c3r-is? 'is-associative 'MUL)
  (lambda () (mac 'laurent-ring-carr) (mac 'laurent-ring-mul) (mac 'is-associative)
    (let* ((vs (c3r-peel-binders!)) (u (car vs)) (v (cadr vs)) (w (caddr vs)))
      (dk-cite! 'laurent-mul-in 'kq_ u v) (dk-cite! 'laurent-mul-in 'kq_ v w)
      (dk-lam-b!)
      (dk-cite! 'laurent-mul-assoc 'kq_ u v w) (dk-close-if-asm!))))
(c3r-disch! (c3r-is? 'is-identity 'MUL)
  (lambda () (mac 'laurent-ring-carr) (mac 'laurent-ring-mul) (mac 'laurent-ring-one) (mac 'is-identity)
    (let* ((vs (c3r-peel-binders!)) (u (car vs)) (o '(LAURENT-ONE kq_)))
      (dk-cite! 'laurent-one-in 'kq_)
      (dk-cite! 'laurent-mul-one 'kq_ u)
      (dk-cite! 'laurent-mul-comm 'kq_ u o)
      (dk-have! `(= (LAURENT-MUL kq_ ,u ,o) ,u) (lambda () (subst `(= (LAURENT-MUL kq_ ,u ,o) (LAURENT-MUL kq_ ,o ,u))) (dk-close-if-asm!)))
      (dk-conj-close! (lambda () (dk-lam-b!) (dk-close-if-asm!))))))
(c3r-disch! (c3r-is? 'is-distributive 'ADD)
  (lambda () (mac 'laurent-ring-carr) (mac 'laurent-ring-add) (mac 'laurent-ring-mul) (mac 'is-distributive)
    (let* ((vs (c3r-peel-binders!)) (u (car vs)) (v (cadr vs)) (w (caddr vs)))
      (dk-cite! 'laurent-add-in 'kq_ u v) (dk-cite! 'laurent-add-in 'kq_ v w)
      (dk-cite! 'laurent-mul-in 'kq_ u v) (dk-cite! 'laurent-mul-in 'kq_ u w) (dk-cite! 'laurent-mul-in 'kq_ v w)
      (dk-cite! 'laurent-mul-distrib-left 'kq_ u v w)
      ;; (u + v) w = w (u + v) = w u + w v = u w + v w
      (let ((uv `(LAURENT-ADD kq_ ,u ,v)))
        (dk-cite! 'laurent-mul-distrib-left 'kq_ w u v)
        (dk-cite! 'laurent-mul-comm 'kq_ uv w)
        (dk-cite! 'laurent-mul-comm 'kq_ u w)
        (dk-cite! 'laurent-mul-comm 'kq_ v w)
        (dk-have! `(= (LAURENT-MUL kq_ ,uv ,w) (LAURENT-ADD kq_ (LAURENT-MUL kq_ ,u ,w) (LAURENT-MUL kq_ ,v ,w)))
          (lambda ()
            (subst `(= (LAURENT-MUL kq_ ,uv ,w) (LAURENT-MUL kq_ ,w ,uv)))
            (subst `(= (LAURENT-MUL kq_ ,w ,uv) (LAURENT-ADD kq_ (LAURENT-MUL kq_ ,w ,u) (LAURENT-MUL kq_ ,w ,v))))
            (subst `(= (LAURENT-MUL kq_ ,w ,u) (LAURENT-MUL kq_ ,u ,w)))
            (subst `(= (LAURENT-MUL kq_ ,w ,v) (LAURENT-MUL kq_ ,v ,w)))
            (dk-cite! 'laurent-add-in 'kq_ `(LAURENT-MUL kq_ ,u ,w) `(LAURENT-MUL kq_ ,v ,w))
            (c3t-rfl!))))
      (dk-conj-close! (lambda () (dk-lam-b!) (dk-close-if-asm!))))))
(qed 'laurent-ring-is-ring)

(sp (make-wff '(FORALL kq_ (IMPLIES (IS-COMMUTATIVE-RING kq_) (IS-COMMUTATIVE-RING (LAURENT-RING kq_))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'commutative-ring-is-ring 'kq_))
(dk-chain-ass! (dk-cite! 'laurent-ring-is-ring 'kq_))
(let ((iff (dk-cite! 'is-commutative-ring-def '(LAURENT-RING kq_))))
  (dk-have! (caddr iff)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (begin
                (mac 'laurent-ring-carr) (mac 'laurent-ring-mul)
                (let ((vs (c3r-peel-binders!)))
                  (dk-lam-b!)
                  (dk-cite! 'laurent-mul-comm 'kq_ (car vs) (cadr vs))
                  (dk-close-if-asm!))))))))
  (dk-iff-bwd! iff)
  (dk-close-if-asm!))
(qed 'laurent-ring-is-commutative-ring)
