(qed 'zz-add-monoid-iden)

(define (c3t-rfl!) (dk-close-if-asm!) (if (pair? (dk-open-leaves)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))

(sp (make-wff '(FORALL za_ (IMPLIES (IN za_ ZZ) (FORALL zb_ (IMPLIES (IN zb_ ZZ)
   (= ((OPR ZZ-ADD-MONOID) za_ zb_) (+ za_ zb_))))))))
(dk-peel!)
(slot 'OPR)
(dk-have-and! '(IN za_ ZZ) '(IN zb_ ZZ))
(fact 'zz-add-closed 'za_ 'zb_)
