(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) (FORALL fq_ (IMPLIES (IN fq_ (FUN ZZ (CARR kq_)))
   (FORALL bq_ (IMPLIES (IN bq_ ZZ) (IMPLIES ,(c3t-below 'kq_ 'fq_ 'bq_)
   (FORALL tq_ (IMPLIES (IN tq_ ZZ) ,(c3t-below 'kq_ (c3t-tr 'kq_ 'fq_ 'tq_) 'bq_))))))))))))
(dk-peel!)
(let ((j (cadr (cadr (dk-goal)))))
  (dk-cite! 'zz-in-rr j) (dk-cite! 'zz-in-rr 'tq_)
  (dk-chain-ass! (dk-apply! (c3t-below 'kq_ 'fq_ 'bq_) j))
  (use-em `(<= ,j tq_)
    (lambda () (subst (dk-chain-ass! (dk-cite! 'laurent-trunc-le 'kq_ 'fq_ 'tq_ j))) (dk-close-if-asm!))
