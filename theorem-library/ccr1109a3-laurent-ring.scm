(qrfl)
(qed 'laurent-one-monalg)

(sp (make-wff `(FORALL kq_ (FORALL fq_ (FORALL gq_ ,(c3t-all 'jq_ 'ZZ
   '(== ((LAURENT-ADD kq_ fq_ gq_) jq_) ((ADD kq_) (fq_ jq_) (gq_ jq_)))))))))
