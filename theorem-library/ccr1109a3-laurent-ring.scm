;;; ccr1109a3-laurent-ring.scm -- CCR.pdf section 1.5: the formal Laurent series K((x)) form a commutative ring,
;;; with every multiplicative law read off the monoid algebra K[ZZ] by TRUNCATION.
;;; Agent CCR-1109-A3, 2026-11-09.  Destination: theorem-library/ccr1109a3-laurent-ring.scm.  Library: analysis
;;; (with its vocabulary, structure-library/ccr1109a3-laurent-vocab.scm).  Helper prefix c3z- / c3t-.
;;;
;;; THE MECHANISM.  LAURENT-MUL(K, f, g) is MONALG-MUL(K, ZZ-ADD-MONOID, f, g) (the vocabulary).  For
;;; functions f, g : ZZ -> CARR K vanishing below B, the coefficient at n of the convolution depends only on
;;; the coefficients at indices <= n - B, so it equals the coefficient at n of the convolution of the
;;; TRUNCATIONS of f and g above any N >= n - B (laurent-mul-trunc).  Truncations are finitely supported
;;; (laurent-trunc-finsupp, through zz-interval-finite), so every law of K[ZZ] proven in
;;; monalg-is-ring.scm (typing, associativity, distributivity, unit) and rake-monalg-comm.scm (commutativity)
;;; transfers coefficientwise.  No FINSUM law is proven again here.
;;;
;;; Load window: after the vocabulary, theorem-library/ccr1109a2-laurent (laurent-set-in / -out, A2),
;;; monalg-is-ring (monalg-mul-assoc-at, monalg-one-left-fn, ...), rake-monalg-comm (monalg-mul-comm),
;;; interval-card-in-nn, card-image-finite, nn-add-monoid (the driver shape copied for ZZ).

;;; ---- ZZ-ADD-MONOID is a commutative monoid (the driver of nn-add-monoid.scm, NN -> ZZ) ----
(define (c3z-goal) (wff-formula (sequent-node-assertion (proof-state-focus *ps*))))
(define (c3z-head g) (and (pair? g) (car g)))
(define (c3z-open) (filter (lambda (s) (null? (sequent-node-in-arrows s))) (proof-open-goals *ps*)))

(define (c3z-peel!)
  (let pl ((fuel 20))
    (let ((before (c3z-goal)))
      (when (and (> fuel 0) (memq (c3z-head before) '(FORALL IMPLIES)))
        (di)
        (if (equal? (c3z-goal) before)
            (error "zz-add-monoid: di made no progress on" before)
            (pl (- fuel 1)))))))

;;; Read the eigenvariables off the GOAL, never off the context.  `dk-asms''
;;; order is not the peel order -- taking the ZZ-typed hypotheses in context
;;; order yields (w v u) where the goal wants (u v w), and `fact' then builds an
;;; instance that does not match the goal, which `ass' quietly refuses.  The
;;; goal's own shape is unambiguous.
(define (c3z-assoc-vars g)        ; (= (+ (+ a b) c) (+ a (+ b c)))
  (let ((lhs (cadr g))) (list (cadr (cadr lhs)) (caddr (cadr lhs)) (caddr lhs))))
(define (c3z-comm-vars g)         ; (= (+ a b) (+ b a))
  (let ((lhs (cadr g))) (list (cadr lhs) (caddr lhs))))
(define (c3z-ident-var g)         ; (AND (= (+ 0 u) u) (= (+ u 0) u))
  (caddr (cadr g)))

(define (c3z-and* xs)
  (fold-right (lambda (x acc) (if acc (list 'AND x acc) x)) #f xs))

;;; Focus the open leaf whose goal satisfies PRED.  Errors on a miss -- a focus
;;; helper that returns #f and leaves focus put hides every later failure.
(define (c3z-focus-leaf! pred)
  (let ((ls (filter (lambda (n) (pred (wff-formula (sequent-node-assertion n))))
                    (filter (lambda (s) (null? (sequent-node-in-arrows s)))
                            (proof-open-goals *ps*)))))
    (if (null? ls) (error "zz-add-monoid: no open leaf matches"))
    (dk-focus! (car ls))))

(define (c3z-close-leaf!)
  (let ((g (c3z-goal)))
    (cond
      ;; length(zz-add-monoid) = 3
      ((and (eq? (c3z-head g) '=) (pair? (cadr g)) (eq? (car (cadr g)) 'LENGTH))
       (mac 'zz-add-monoid-def) (len-r) (arith))
      ((equal? g '(IN ZZ SET)) (fact 'zz-is-set) (ass))
      ;; the op-slot typing.  Until 2026-08-29 the slot held the shared constant
      ;; `binplus' and this cited binplus-in-fun-nn -- one of the fourteen
      ;; axioms that jointly proved ZZ = ZZ = QQ = RR = CC and hence FALSITY.
      ;; The slot now holds a tupled VNB-LAMBDA, so the typing is PROVED: lam-t
      ;; leaves the pointwise closure fact (zz-add-closed) and the sethood of
      ;; CARTESIAN(ZZ,ZZ).  Nothing is asserted that was not already there.
      ((and (eq? (c3z-head g) 'IN)
            (pair? (cadr g)) (eq? (car (cadr g)) 'VNB-LAMBDA))
       ;; Take the leaves lam-t OPENED; a shape search over all open leaves
       ;; picks up a sibling conjunct's IN goal (see zz-ring-is-ring.scm).
       (let* ((opened (dk-opened (lambda () (lam-t))))
              (pick (lambda (head)
                      (let ((hit (filter (lambda (n)
                                           (let ((gg (wff-formula
                                                      (sequent-node-assertion n))))
                                             (and (pair? gg) (eq? (car gg) head))))
                                         opened)))
                        (and (pair? hit) (dk-focus! (car hit)))))))
         (when (pick 'FORALL)
           (di)
           (let* ((g2 (c3z-goal)) (sum (cadr g2)) (a (cadr sum)) (b (caddr sum)))
             (dk-have! (list 'AND (list 'IN a 'ZZ) (list 'IN b 'ZZ)))
             (fact 'zz-add-closed a b))
           (ass))
         ;; sethood is conditional: hash-consing means a sibling conjunct may
         ;; already have posted the identical node, so lam-t opens one leaf.
         (when (pick 'IN)
           (fact 'zz-is-set)
           (dk-have! '(AND (IN ZZ SET) (IN ZZ SET)))
           (mac 'cartesian-set-iff)
           (ass))))
      ((and (eq? (c3z-head g) 'IN) (number? (cadr g))) (fact 'zz-zero-in) (ass))
      ;; a law: unfold, drop to the surface, peel, then CITE.
      ((memq (c3z-head g) '(is-associative is-commutative is-identity))
       (let ((law (c3z-head g)))
         (mac law)
         (quietly (lambda () (surface-goal! 'ZZ-ADD-MONOID)))
         (c3z-peel!)
         ;; ZZ-ADD-MONOID's ADD slot holds a tupled VNB-LAMBDA now, not the
         ;; shared constant `binplus', so the law goals arrive as lambda
         ;; APPLICATIONS.  Take them down to `+' before citing the ZZ axioms.
         (dk-saturate-slot-ops! 'ZZ '((+ . zz-add-closed)))
         (let ((gg (c3z-goal)))
           (case law
             ((is-associative)
              (let ((vs (c3z-assoc-vars gg)))
                (dk-have! (c3z-and* (map (lambda (v) (list 'IN v 'ZZ)) vs)))
                (apply fact 'zz-add-assoc vs)
                (ass)))
             ((is-commutative)
              (let ((vs (c3z-comm-vars gg)))
                (dk-have! (c3z-and* (map (lambda (v) (list 'IN v 'ZZ)) vs)))
                (apply fact 'zz-add-comm vs)
                (ass)))
             ((is-identity)
              ;; two-sided: u + 0 = u is the axiom; 0 + u = u is that plus
              ;; commutativity.  Establish both, THEN split the conjunction.
              (let ((u (c3z-ident-var gg)))
                (fact 'zz-add-zero u)                            ; u + 0 = u
                (dk-have! (list 'AND '(IN 0 ZZ) (list 'IN u 'ZZ)))  ; from-context!
                (fact 'zz-add-comm 0 u)                          ; 0 + u = u + 0
                (dk-have! (list '= (list '+ 0 u) u)
                       (lambda ()
                         (subst (list '= (list '+ 0 u) (list '+ u 0)))
                         (ass)))
                (for-each (lambda (k) (dk-focus! k) (ass))
                          (dk-opened (lambda () (di))))))))))
      (#t (error "zz-add-monoid: unexpected conjunct" g)))))

(sp (make-wff '(IS-COMM-MONOID ZZ-ADD-MONOID)))
(mac 'IS-COMM-MONOID)
(dk-isx-set!)                ; W1J-A: the conjunct t in SET, from the typings
(quietly (lambda () (surface-goal! 'ZZ-ADD-MONOID)))

;;; Split the conjunction to leaves.  Filtering on in-arrows is what stops the
;;; split from re-finding the conjunction it just split (see zz-ring-is-ring).
(let split ((fuel 40))
  (let ((andl (find-first
               (lambda (s) (eq? (c3z-head (wff-formula (sequent-node-assertion s))) 'AND))
               (c3z-open))))
    (when andl
      (if (= fuel 0) (error "zz-add-monoid: AND split did not terminate"))
      (dk-focus! andl) (di) (split (- fuel 1)))))

;;; Close each conjunct, insisting on PROGRESS: a pass that leaves the open-leaf
;;; count unchanged names the conjunct that failed instead of looping on it.
(let sweep ((fuel 40))
  (let* ((open (c3z-open)) (n (length open)))
    (when (pair? open)
      (if (= fuel 0) (error "zz-add-monoid: sweep out of fuel"))
      (dk-focus! (car open))
      (let ((g (c3z-goal)))
        (c3z-close-leaf!)
        (if (>= (length (c3z-open)) n)
            (error "zz-add-monoid: this conjunct did not close" g)))
      (sweep (- fuel 1)))))

(qed 'zz-add-monoid-is-comm-monoid)

(sp (make-wff '(IS-MONOID ZZ-ADD-MONOID)))
(fact 'zz-add-monoid-is-comm-monoid)
(fact 'comm-monoid-is-monoid 'ZZ-ADD-MONOID)
(ass)
(qed 'zz-add-monoid-is-monoid)

;; the slot read-offs of ZZ-ADD-MONOID
