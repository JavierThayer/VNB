(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) ,(c3t-all 'bq_ 'ZZ `(IMPLIES (<= bq_ 0) ,(c3t-below 'kq_ '(LAURENT-ONE kq_) 'bq_)))))))
(dk-peel!)
(let ((j (find-first (lambda (v) (dk-asm? `(< ,v bq_))) (map cadr (filter (lambda (h) (dk-head-is? h '<)) (dk-asms))))))
