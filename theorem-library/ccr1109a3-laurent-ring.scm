;;; ---- truncation ----
(define (c3t-below k f b) `(FORALL lzj (IMPLIES (IN lzj ZZ) (IMPLIES (< lzj ,b) (= (,f lzj) (ZERO ,k))))))
(define (c3t-tr k f t) `(LAURENT-TRUNC ,k ,f ,t))
(define c3t-Z 'ZZ-ADD-MONOID)
;; f(x) in CARR K from f in FUN(ZZ, CARR K) and x in ZZ, both in context
(define (c3t-app! k f x)
  (dk-have-and! `(IN ,f (FUN ZZ (CARR ,k))) `(IN ,x ZZ))
  (dk-cite! 'fun-apply-type f 'ZZ `(CARR ,k) x))

(sp (make-wff '(FORALL kq_ (IMPLIES (IS-RING kq_) (FORALL fq_ (IMPLIES (IN fq_ (FUN ZZ (CARR kq_)))
   (FORALL tq_ (IMPLIES (IN tq_ ZZ) (FORALL jq_ (IMPLIES (IN jq_ ZZ) (IMPLIES (<= jq_ tq_)
     (= ((LAURENT-TRUNC kq_ fq_ tq_) jq_) (fq_ jq_)))))))))))))
(dk-peel!)
(c3t-app! 'kq_ 'fq_ 'jq_)
(mac 'LAURENT-TRUNC)
(dk-lam-b!)
(dk-if-branch! #t '(IF (<= jq_ tq_) (fq_ jq_) (ZERO kq_)) #f (lambda () (c3t-rfl!)))
(qed 'laurent-trunc-le)

(sp (make-wff '(FORALL kq_ (IMPLIES (IS-RING kq_) (FORALL fq_ (IMPLIES (IN fq_ (FUN ZZ (CARR kq_)))
   (FORALL tq_ (IMPLIES (IN tq_ ZZ) (FORALL jq_ (IMPLIES (IN jq_ ZZ) (IMPLIES (< tq_ jq_)
     (= ((LAURENT-TRUNC kq_ fq_ tq_) jq_) (ZERO kq_)))))))))))))
(dk-peel!)
(dk-cite! 'ring-zero-in 'kq_)
(dk-cite! 'zz-in-rr 'jq_) (dk-cite! 'zz-in-rr 'tq_)
(mac 'LAURENT-TRUNC)
(dk-lam-b!)
(dk-if-branch! #f '(IF (<= jq_ tq_) (fq_ jq_) (ZERO kq_)) (lambda () (di) (dk-absurd! '(<= jq_ tq_) '(< tq_ jq_)))
  (lambda () (c3t-rfl!)))
(qed 'laurent-trunc-gt)

(sp (make-wff '(FORALL kq_ (IMPLIES (IS-RING kq_) (FORALL fq_ (IMPLIES (IN fq_ (FUN ZZ (CARR kq_)))
   (FORALL tq_ (IMPLIES (IN tq_ ZZ) (IN (LAURENT-TRUNC kq_ fq_ tq_) (FUN ZZ (CARR kq_)))))))))))
(dk-peel!)
(dk-cite! 'ring-zero-in 'kq_)
(dk-each-leaf! (lambda () (mac 'LAURENT-TRUNC) (lam-t))
  (lambda ()
    (if (dk-head-is? (dk-goal) 'FORALL)
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'ZZ))) landed))))
          (c3t-app! 'kq_ 'fq_ x)
          (dk-case-if! `(IF (<= ,x tq_) (fq_ ,x) (ZERO kq_)) (lambda (tv val) (dk-close-if-asm!)))
          (dk-close-if-asm!))
        (begin (fact 'zz-is-set) (dk-close-if-asm!)))))
