  (dk-cite! 'laurent-trunc-fun 'kq_ 'fq_ 'tq_)
  (dk-have! '(IN (CARR ZZ-ADD-MONOID) SET) (lambda () (subst '(= (CARR ZZ-ADD-MONOID) ZZ)) (dk-close-if-asm!)))
  (dk-have! `(IN ,tr (FUN (CARR ZZ-ADD-MONOID) (CARR kq_))) (lambda () (subst '(= (CARR ZZ-ADD-MONOID) ZZ)) (dk-close-if-asm!)))
  (dk-cite! 'supp-in-set 'kq_ 'ZZ-ADD-MONOID tr)
  (dk-fact-split! 'zz-interval-finite 'bq_ 'tq_)
  (dk-have! `(FORALL ivz_ (IMPLIES (IN ivz_ ,s) (IN ivz_ ,iv)))
    (lambda ()
      (let ((z (dk-di-var!)))
        (dk-iff-fwd! (dk-cite! 'supp-membership 'kq_ 'ZZ-ADD-MONOID tr z))
        (dk-rewrite-h! `(IN ,z (CARR ZZ-ADD-MONOID)) '(CARR ZZ-ADD-MONOID) 'ZZ)
        (dk-cite! 'zz-in-rr z) (dk-cite! 'zz-in-rr 'bq_) (dk-cite! 'zz-in-rr 'tq_)
        (in-sep! (lambda () (dk-ass!))
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (ass)
                    (let ((g (dk-goal)))
                      (pbc)
                      (if (eq? (cadr g) 'bq_)
                          (begin (dk-chain-ass! (dk-cite! 'rr-not-le-lt 'bq_ z))
                                 (dk-chain-ass! (dk-cite! 'laurent-trunc-low 'kq_ 'fq_ 'bq_ 'tq_))
                                 (dk-chain-ass! (dk-apply! (c3t-below 'kq_ tr 'bq_) z)))
                          (begin (dk-chain-ass! (dk-cite! 'rr-not-le-lt z 'tq_))
                                 (dk-chain-ass! (dk-cite! 'laurent-trunc-gt 'kq_ 'fq_ 'tq_ z))))
                      (ai `(NOT (= (,tr ,z) (ZERO kq_)))))))))))))
  (dk-have-and! `(IN ,s SET) `(FORALL ivz_ (IMPLIES (IN ivz_ ,s) (IN ivz_ ,iv))))
  (dk-have-and! `(IN ,iv SET) `(IN (CARD ,iv) NN))
  (dk-chain-ass! (dk-cite! 'card-subset-nn iv s))
  (let ((iff (dk-cite! 'finsupp-membership 'kq_ 'ZZ-ADD-MONOID tr)))
    (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (dk-iff-bwd! iff)
    (dk-close-if-asm!)))
(qed 'laurent-trunc-finsupp)

;;; ---- THE TRUNCATION LEMMA: the coefficient at n of f * g depends only on f, g at indices <= n - B ----
(define (c3t-all v c body) `(FORALL ,v (IMPLIES (IN ,v ,c) ,body)))
(define (c3t-mm k f g) `(MONALG-MUL ,k ZZ-ADD-MONOID ,f ,g))
(define (c3t-funk k) `(FUN ZZ (CARR ,k)))
;; v in SUPP(K, Z, F) in context: land v in ZZ and F(v) /= 0
(define (c3t-coord! k fn v)
  (dk-iff-fwd! (dk-cite! 'supp-membership k c3t-Z fn v))
  (dk-rewrite-h! `(IN ,v (CARR ZZ-ADD-MONOID)) '(CARR ZZ-ADD-MONOID) 'ZZ)
  (dk-cite! 'zz-in-rr v))
;; v in ZZ and F(v) /= 0 in context: land v in SUPP(K, Z, F)
(define (c3t-in-supp! k fn v)
  (dk-have! `(IN ,v (CARR ZZ-ADD-MONOID)) (lambda () (subst '(= (CARR ZZ-ADD-MONOID) ZZ)) (dk-close-if-asm!)))
  (let ((iff (dk-cite! 'supp-membership k c3t-Z fn v)))
    (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (dk-iff-bwd! iff)))
;; x in CARTESIAN(SA, SB) in context, and its two coordinates in SA2, SB2: land x in CARTESIAN(SA2, SB2)
(define (c3t-in-cart! x sa sb sa2 sb2)
  (dk-cite! 'cartesian-pair-eq x sa sb)
  (let ((iff (dk-cite! 'cartesian-membership-nth sa2 sb2 x)))
    (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (dk-iff-bwd! iff)))

(define (c3t-tl-formula)
  `(FORALL kq_ (IMPLIES (IS-RING kq_)
    ,(c3t-all 'fq_ (c3t-funk 'kq_) (c3t-all 'gq_ (c3t-funk 'kq_) (c3t-all 'bq_ 'ZZ
      `(IMPLIES ,(c3t-below 'kq_ 'fq_ 'bq_) (IMPLIES ,(c3t-below 'kq_ 'gq_ 'bq_)
        ,(c3t-all 'nq_ 'ZZ (c3t-all 'tq_ 'ZZ
          `(IMPLIES (<= nq_ (+ tq_ bq_))
             (= (,(c3t-mm 'kq_ 'fq_ 'gq_) nq_)
                (,(c3t-mm 'kq_ (c3t-tr 'kq_ 'fq_ 'tq_) (c3t-tr 'kq_ 'gq_ 'tq_)) nq_)))))))))))))

(sp (make-wff (c3t-tl-formula)))
(dk-peel!)
(let* ((k 'kq_) (f 'fq_) (g 'gq_) (b 'bq_) (n 'nq_) (t 'tq_)
       (tf (c3t-tr k f t)) (tg (c3t-tr k g t))
       (sf `(SUPP ,k ZZ-ADD-MONOID ,f)) (sg `(SUPP ,k ZZ-ADD-MONOID ,g))
       (sf2 `(SUPP ,k ZZ-ADD-MONOID ,tf)) (sg2 `(SUPP ,k ZZ-ADD-MONOID ,tg))
       (ag `(RING-ADDITIVE-AG ,k)))
  (fact 'zz-is-set)
  (dk-cite! 'zz-add-monoid-is-monoid)
  (dk-cite! 'zz-add-monoid-carr)
  (dk-have! '(IN (CARR ZZ-ADD-MONOID) SET) (lambda () (subst '(= (CARR ZZ-ADD-MONOID) ZZ)) (dk-close-if-asm!)))
  (dk-have! `(IN ,n (CARR ZZ-ADD-MONOID)) (lambda () (subst '(= (CARR ZZ-ADD-MONOID) ZZ)) (dk-close-if-asm!)))
  (for-each (lambda (v) (dk-cite! 'zz-in-rr v)) (list b n t))
  (dk-cite! 'laurent-trunc-fun k f t) (dk-cite! 'laurent-trunc-fun k g t)
  (dk-chain-ass! (dk-cite! 'laurent-trunc-finsupp k f b t))
  (dk-chain-ass! (dk-cite! 'laurent-trunc-finsupp k g b t))
  (dk-chain-ass! (dk-cite! 'monalg-mul-value-in-carr k c3t-Z tf tg n))
  (let* ((inst1 (dk-cite! 'monalg-mul-apply k c3t-Z f g n))
         (inst2 (dk-cite! 'monalg-mul-apply k c3t-Z tf tg n))
         (l1 (caddr (caddr inst1))) (i1 (cadddr (caddr inst1)))
         (l2 (caddr (caddr inst2))) (i2 (cadddr (caddr inst2)))
         (l1b (list 'VNB-LAMBDA (cadr l1) i2 (cadddr l1)))
         ;; X in I2 in context (opened): land, for both coordinates, typing, trunc = original, original /= 0
         (dir2! (lambda (x)
                  (let ((x1 `(NTH 1 ,x)) (x2 `(NTH 2 ,x)))
                    (dk-fact-split! 'cartesian-nth x sf2 sg2)
                    (for-each
                      (lambda (fn tfn xi)
                        (c3t-coord! k tfn xi)
                        (dk-have! `(<= ,xi ,t)
                          (lambda ()
                            (pbc)
                            (dk-chain-ass! (dk-cite! 'rr-not-le-lt xi t))
                            (dk-chain-ass! (dk-cite! 'laurent-trunc-gt k fn t xi))
                            (ai `(NOT (= (,tfn ,xi) (ZERO ,k))))))
                        (dk-chain-ass! (dk-cite! 'laurent-trunc-le k fn t xi))
                        (dk-rewrite-h! `(NOT (= (,tfn ,xi) (ZERO ,k))) `(,tfn ,xi) `(,fn ,xi))
                        (c3t-app! k fn xi))
                      (list f g) (list tf tg) (list x1 x2))))))
    ;; the two index sets are equal
    (dk-have! `(FORALL xcq_ (IFF (IN xcq_ ,i1) (IN xcq_ ,i2)))
      (lambda ()
        (let ((x (dk-di-var! (lambda (gl) (cadr (cadr gl))))))
          (dk-iff! (lambda (gl) (equal? (caddr gl) i2))
            (lambda ()
              (sep-me `(IN ,x ,i1))
              (let ((x1 `(NTH 1 ,x)) (x2 `(NTH 2 ,x)))
                (dk-fact-split! 'cartesian-nth x sf sg)
                (c3t-coord! k f x1) (c3t-coord! k g x2)
                (dk-chain-ass! (dk-cite! 'zz-add-monoid-opr x1 x2))
                (dk-rewrite-h! `(= ((OPR ZZ-ADD-MONOID) ,x1 ,x2) ,n) `((OPR ZZ-ADD-MONOID) ,x1 ,x2) `(+ ,x1 ,x2))
                (for-each
                  (lambda (fn xi)
                    (dk-have! `(<= ,b ,xi)
                      (lambda ()
                        (pbc)
                        (dk-chain-ass! (dk-cite! 'rr-not-le-lt b xi))
                        (dk-chain-ass! (dk-apply! (c3t-below k fn b) xi))
                        (ai `(NOT (= (,fn ,xi) (ZERO ,k)))))))
                  (list f g) (list x1 x2))
                (dk-have! `(<= ,x1 ,t) (lambda () (dk-ineq! `(= (+ ,x1 ,x2) ,n) `(<= ,b ,x2) `(<= ,n (+ ,t ,b)))))
                (dk-have! `(<= ,x2 ,t) (lambda () (dk-ineq! `(= (+ ,x1 ,x2) ,n) `(<= ,b ,x1) `(<= ,n (+ ,t ,b)))))
                (for-each
                  (lambda (fn tfn xi)
                    (dk-chain-ass! (dk-cite! 'laurent-trunc-le k fn t xi))
                    (dk-rewrite-h! `(NOT (= (,fn ,xi) (ZERO ,k))) `(,fn ,xi) `(,tfn ,xi))
                    (c3t-in-supp! k tfn xi))
                  (list f g) (list tf tg) (list x1 x2))
                (c3t-in-cart! x sf sg sf2 sg2)
                (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
            (lambda ()
              (sep-me `(IN ,x ,i2))
              (dir2! x)
              (c3t-in-supp! k f `(NTH 1 ,x)) (c3t-in-supp! k g `(NTH 2 ,x))
              (c3t-in-cart! x sf2 sg2 sf sg)
              (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!))))))))
    (dk-chain-ass! (dk-cite! 'class-extensionality i1 i2))
    ;; I2 is a finite set
    (for-each
      (lambda (tfn s)
        (dk-cite! 'supp-in-set k c3t-Z tfn)
        (dk-iff-fwd! (dk-cite! 'finsupp-membership k c3t-Z tfn)))
      (list tf tg) (list sf2 sg2))
    (let ((cart `(CARTESIAN ,sf2 ,sg2)))
      (dk-have! `(IN ,cart SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (dk-ass!)))))
      (dk-chain-ass! (dk-cite! 'card-cartesian-nn sf2 sg2))
      (dk-have! `(IN ,i2 SET) (lambda () (sep-set) (dk-close-if-asm!)))
      (dk-have! `(FORALL zcq_ (IMPLIES (IN zcq_ ,i2) (IN zcq_ ,cart)))
        (lambda () (let ((z (dk-di-var!))) (sep-me `(IN ,z ,i2)) (dk-close-if-asm!))))
      (dk-have-and! `(IN ,cart SET) `(IN (CARD ,cart) NN))
      (dk-have-and! `(IN ,i2 SET) `(FORALL zcq_ (IMPLIES (IN zcq_ ,i2) (IN zcq_ ,cart))))
      (dk-chain-ass! (dk-cite! 'card-subset-nn cart i2)))
    ;; the summands agree on I2
    (dk-have! `(FORALL zcq_ (IMPLIES (IN zcq_ ,i2) (= (,l1b zcq_) (,l2 zcq_))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (dk-lam-b!)
          (sep-me `(IN ,z ,i2))
          (dir2! z)
          (subst `(= (,tf (NTH 1 ,z)) (,f (NTH 1 ,z))))
          (subst `(= (,tg (NTH 2 ,z)) (,g (NTH 2 ,z))))
          (dk-cite! 'ring-carrier-closed-mul k `(,f (NTH 1 ,z)) `(,g (NTH 2 ,z)))
          (c3t-rfl!))))
    (dk-cite! 'ring-additive-ag-is-abelian-group k)
    (dk-chain-ass! (dk-cite! 'finsum-congruence-q ag i2 l1b l2))
    (subst `(= (,(c3t-mm k f g) ,n) ,(caddr inst1)))
    (subst `(= ,i1 ,i2))
    (subst `(= (FINSUM ,ag ,l1b ,i2) (FINSUM ,ag ,l2 ,i2)))
    (subst `(= (FINSUM ,ag ,l2 ,i2) (,(c3t-mm k tf tg) ,n)))
    (c3t-rfl!)))
(qed 'laurent-mul-trunc)

;;; ---- consequences: truncations of agreeing functions agree; local dependence; vanishing; typing ----
(define (c3t-agree f f2 t) `(FORALL lzj (IMPLIES (IN lzj ZZ) (IMPLIES (<= lzj ,t) (= (,f lzj) (,f2 lzj))))))

(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_)
   ,(c3t-all 'fq_ (c3t-funk 'kq_) (c3t-all 'fr_ (c3t-funk 'kq_) (c3t-all 'tq_ 'ZZ
      `(IMPLIES ,(c3t-agree 'fq_ 'fr_ 'tq_) (= ,(c3t-tr 'kq_ 'fq_ 'tq_) ,(c3t-tr 'kq_ 'fr_ 'tq_))))))))))
(dk-peel!)
(let ((k 'kq_) (f 'fq_) (f2 'fr_) (t 'tq_))
  (dk-cite! 'ring-zero-in k)
  (dk-cite! 'zz-in-rr t)
  (dk-cite! 'laurent-trunc-fun k f t) (dk-cite! 'laurent-trunc-fun k f2 t)
  (dk-fun-ext! (c3t-tr k f t) (c3t-tr k f2 t) 'ZZ `(CARR ,k) #f #f
    (lambda (v)
      (dk-cite! 'zz-in-rr v)
      (c3t-app! k f v) (c3t-app! k f2 v)
      (use-em `(<= ,v ,t)
        (lambda ()
          (subst (dk-chain-ass! (dk-cite! 'laurent-trunc-le k f t v)))
          (subst (dk-chain-ass! (dk-cite! 'laurent-trunc-le k f2 t v)))
          (subst (dk-chain-ass! (dk-apply! (c3t-agree f f2 t) v)))
          (c3t-rfl!))
        (lambda ()
          (dk-chain-ass! (dk-cite! 'rr-not-le-lt v t))
          (subst (dk-chain-ass! (dk-cite! 'laurent-trunc-gt k f t v)))
          (subst (dk-chain-ass! (dk-cite! 'laurent-trunc-gt k f2 t v)))
          (c3t-rfl!))))))
(qed 'laurent-trunc-agree)

;; LOCAL DEPENDENCE: functions agreeing at indices <= t have the same product coefficients at n <= t + b
(define (c3t-ld-formula)
  `(FORALL kq_ (IMPLIES (IS-RING kq_)
    ,(c3t-all 'fq_ (c3t-funk 'kq_) (c3t-all 'fr_ (c3t-funk 'kq_) (c3t-all 'gq_ (c3t-funk 'kq_) (c3t-all 'gr_ (c3t-funk 'kq_)
      (c3t-all 'bq_ 'ZZ
       `(IMPLIES ,(c3t-below 'kq_ 'fq_ 'bq_) (IMPLIES ,(c3t-below 'kq_ 'fr_ 'bq_)
        (IMPLIES ,(c3t-below 'kq_ 'gq_ 'bq_) (IMPLIES ,(c3t-below 'kq_ 'gr_ 'bq_)
        ,(c3t-all 'tq_ 'ZZ
          `(IMPLIES ,(c3t-agree 'fq_ 'fr_ 'tq_) (IMPLIES ,(c3t-agree 'gq_ 'gr_ 'tq_)
            ,(c3t-all 'nq_ 'ZZ
              `(IMPLIES (<= nq_ (+ tq_ bq_))
                 (= (,(c3t-mm 'kq_ 'fq_ 'gq_) nq_) (,(c3t-mm 'kq_ 'fr_ 'gr_) nq_)))))))))))))))))))
(sp (make-wff (c3t-ld-formula)))
(dk-peel!)
(let* ((k 'kq_) (f 'fq_) (f2 'fr_) (g 'gq_) (g2 'gr_) (b 'bq_) (t 'tq_) (n 'nq_))
  (subst (dk-chain-ass! (dk-cite! 'laurent-mul-trunc k f g b n t)))
  (subst (dk-chain-ass! (dk-cite! 'laurent-mul-trunc k f2 g2 b n t)))
  (subst (dk-chain-ass! (dk-cite! 'laurent-trunc-agree k f f2 t)))
  (subst (dk-chain-ass! (dk-cite! 'laurent-trunc-agree k g g2 t)))
  (dk-cite! 'zz-add-monoid-is-monoid)
  (dk-cite! 'zz-add-monoid-carr)
  (dk-have! `(IN ,n (CARR ZZ-ADD-MONOID)) (lambda () (subst '(= (CARR ZZ-ADD-MONOID) ZZ)) (dk-close-if-asm!)))
  (dk-chain-ass! (dk-cite! 'laurent-trunc-finsupp k f2 b t))
  (dk-chain-ass! (dk-cite! 'laurent-trunc-finsupp k g2 b t))
  (dk-chain-ass! (dk-cite! 'monalg-mul-value-in-carr k c3t-Z (c3t-tr k f2 t) (c3t-tr k g2 t) n))
  (c3t-rfl!))
(qed 'laurent-mul-local)

;; the product of functions vanishing below b vanishes below b + b
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_)
   ,(c3t-all 'fq_ (c3t-funk 'kq_) (c3t-all 'gq_ (c3t-funk 'kq_) (c3t-all 'bq_ 'ZZ
      `(IMPLIES ,(c3t-below 'kq_ 'fq_ 'bq_) (IMPLIES ,(c3t-below 'kq_ 'gq_ 'bq_)
         ,(c3t-below 'kq_ (c3t-mm 'kq_ 'fq_ 'gq_) '(+ bq_ bq_)))))))))))
(dk-peel!)
(let* ((k 'kq_) (f 'fq_) (g 'gq_) (b 'bq_)
       (n (cadr (find-first (lambda (h) (and (dk-head-is? h '<) (equal? (caddr h) '(+ bq_ bq_)))) (dk-asms))))
       (sf `(SUPP ,k ZZ-ADD-MONOID ,f)) (sg `(SUPP ,k ZZ-ADD-MONOID ,g))
       (ag `(RING-ADDITIVE-AG ,k)))
  (dk-cite! 'zz-add-monoid-carr)
  (dk-have! `(IN ,n (CARR ZZ-ADD-MONOID)) (lambda () (subst '(= (CARR ZZ-ADD-MONOID) ZZ)) (dk-close-if-asm!)))
  (for-each (lambda (v) (dk-cite! 'zz-in-rr v)) (list b n))
  (dk-cite! 'ring-zero-in k)
  (let* ((inst (dk-cite! 'monalg-mul-apply k c3t-Z f g n))
         (l (caddr (caddr inst))) (i (cadddr (caddr inst)))
         (le (list 'VNB-LAMBDA (cadr l) 'EMPTY-SET (cadddr l))))
    (dk-have! `(FORALL xcq_ (IFF (IN xcq_ ,i) (IN xcq_ EMPTY-SET)))
      (lambda ()
        (let ((x (dk-di-var! (lambda (gl) (cadr (cadr gl))))))
          (dk-iff! (lambda (gl) (equal? (caddr gl) 'EMPTY-SET))
            (lambda ()
              (sep-me `(IN ,x ,i))
              (let ((x1 `(NTH 1 ,x)) (x2 `(NTH 2 ,x)))
                (dk-fact-split! 'cartesian-nth x sf sg)
                (c3t-coord! k f x1) (c3t-coord! k g x2)
                (dk-chain-ass! (dk-cite! 'zz-add-monoid-opr x1 x2))
                (dk-rewrite-h! `(= ((OPR ZZ-ADD-MONOID) ,x1 ,x2) ,n) `((OPR ZZ-ADD-MONOID) ,x1 ,x2) `(+ ,x1 ,x2))
                (for-each
                  (lambda (fn xi)
                    (dk-have! `(<= ,b ,xi)
                      (lambda ()
                        (pbc)
                        (dk-chain-ass! (dk-cite! 'rr-not-le-lt b xi))
                        (dk-chain-ass! (dk-apply! (c3t-below k fn b) xi))
                        (ai `(NOT (= (,fn ,xi) (ZERO ,k)))))))
                  (list f g) (list x1 x2))
                (pbc)
                (dk-absurd! `(= (+ ,x1 ,x2) ,n) `(<= ,b ,x1) `(<= ,b ,x2) `(< ,n (+ ,b ,b)))))
            (lambda ()
              (pbc)
              (ai (dk-cite! 'empty-set-has-no-members x)))))))
    (dk-chain-ass! (dk-cite! 'class-extensionality i 'EMPTY-SET))
    (dk-cite! 'finsum-empty ag le)
    (dk-cite! 'raag-iden k)
    (subst `(= (,(c3t-mm k f g) ,n) ,(caddr inst)))
    (subst `(= ,i EMPTY-SET))
    (subst `(= (FINSUM ,ag ,le EMPTY-SET) (IDEN ,ag)))
    (subst `(= (IDEN ,ag) (ZERO ,k)))
    (c3t-rfl!)))
(qed 'laurent-mul-vanish)

;; the product of functions vanishing below some b is a function ZZ -> CARR K
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_)
   ,(c3t-all 'fq_ (c3t-funk 'kq_) (c3t-all 'gq_ (c3t-funk 'kq_) (c3t-all 'bq_ 'ZZ
      `(IMPLIES ,(c3t-below 'kq_ 'fq_ 'bq_) (IMPLIES ,(c3t-below 'kq_ 'gq_ 'bq_)
         (IN ,(c3t-mm 'kq_ 'fq_ 'gq_) ,(c3t-funk 'kq_)))))))))))
(dk-peel!)
(let* ((k 'kq_) (f 'fq_) (g 'gq_) (b 'bq_))
  (fact 'zz-is-set)
  (dk-cite! 'zz-add-monoid-is-monoid)
  (dk-cite! 'zz-add-monoid-carr)
  (dk-cite! 'zz-in-rr b)
  (dk-cite! 'zz-neg-closed b)
  (mac 'MONALG-MUL)
  (subst '(= (CARR ZZ-ADD-MONOID) ZZ))
  (dk-each-leaf! (lambda () (lam-t))
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORALL)
          (let* ((landed (dk-landed (lambda () (dk-peel!))))
                 (v (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'ZZ))) landed)))
                 (tt `(+ ,v (- ,b))))
            (dk-have! `(IN ,v (CARR ZZ-ADD-MONOID)) (lambda () (subst '(= (CARR ZZ-ADD-MONOID) ZZ)) (dk-close-if-asm!)))
            (let ((inst (dk-cite! 'monalg-mul-apply k c3t-Z f g v)))
              (subst `(= ,(caddr inst) (,(c3t-mm k f g) ,v))))
            (dk-cite! 'zz-in-rr v)
            (dk-have-and! `(IN ,v ZZ) `(IN (- ,b) ZZ))
            (dk-cite! 'zz-add-closed v `(- ,b))
            (dk-cite! 'zz-in-rr tt)
            (dk-have! `(<= ,v (+ ,tt ,b)) (lambda () (dk-ineq!)))
            (subst (dk-chain-ass! (dk-cite! 'laurent-mul-trunc k f g b v tt)))
            (dk-chain-ass! (dk-cite! 'laurent-trunc-finsupp k f b tt))
            (dk-chain-ass! (dk-cite! 'laurent-trunc-finsupp k g b tt))
            (dk-chain-ass! (dk-cite! 'monalg-mul-value-in-carr k c3t-Z (c3t-tr k f tt) (c3t-tr k g tt) v))
            (dk-close-if-asm!))
          (dk-close-if-asm!)))))
(qed 'laurent-mul-fun)

;;; ---- bounds ----
(sp (make-wff `(FORALL kq_ (FORALL fq_ ,(c3t-all 'bq_ 'ZZ `(IMPLIES ,(c3t-below 'kq_ 'fq_ 'bq_)
   ,(c3t-all 'cq_ 'ZZ `(IMPLIES (<= cq_ bq_) ,(c3t-below 'kq_ 'fq_ 'cq_)))))))))
(dk-peel!)
(let ((j (find-first (lambda (v) (dk-asm? `(< ,v cq_))) (map cadr (filter (lambda (h) (dk-head-is? h '<)) (dk-asms))))))
  (for-each (lambda (v) (dk-cite! 'zz-in-rr v)) (list j 'bq_ 'cq_))
  (dk-have! `(< ,j bq_) (lambda () (dk-ineq! `(< ,j cq_) '(<= cq_ bq_))))
  (dk-chain-ass! (dk-apply! (c3t-below 'kq_ 'fq_ 'bq_) j))
  (dk-close-if-asm!))
(qed 'laurent-below-mono)

(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) ,(c3t-all 'fq_ '(LAURENT-SET kq_) (c3t-all 'cq_ 'ZZ
   `(FORSOME bq_ (AND (IN bq_ ZZ) (AND (<= bq_ cq_) ,(c3t-below 'kq_ 'fq_ 'bq_))))))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'laurent-set-out 'kq_ 'fq_))
(dk-split-all!)
(let ((bf (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h '(fq_ lzj)))) "a bound"))))
  (dk-split-all!)
  (dk-cite! 'zz-in-rr bf) (dk-cite! 'zz-in-rr 'cq_)
  (use-em `(<= ,bf cq_)
    (lambda () (ew bf) (dk-conj-close! (lambda () (dk-ass!))))
    (lambda ()
      (dk-chain-ass! (dk-cite! 'rr-not-le-lt bf 'cq_))
      (dk-have! `(<= cq_ ,bf) (lambda () (dk-ineq! `(< cq_ ,bf))))
      (dk-chain-ass! (dk-cite! 'laurent-below-mono 'kq_ 'fq_ bf 'cq_))
      (ew 'cq_)
      (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq!)))))))
(qed 'laurent-bound-le)

;;; ---- the Laurent operations are the MONALG operations at ZZ-ADD-MONOID; pointwise values ----
(sp (make-wff '(FORALL kq_ (FORALL fq_ (FORALL gq_
   (== (LAURENT-ADD kq_ fq_ gq_) (MONALG-ADD kq_ ZZ-ADD-MONOID fq_ gq_)))))))
(dk-peel!)
(mac 'LAURENT-ADD) (mac 'MONALG-ADD) (slot 'CARR)
(qrfl)
(qed 'laurent-add-monalg)

(sp (make-wff '(FORALL kq_ (== (LAURENT-ONE kq_) (MONALG-ONE kq_ ZZ-ADD-MONOID)))))
(dk-peel!)
