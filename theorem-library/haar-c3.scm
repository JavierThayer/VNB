;;; ---- nu is 1-Lipschitz ----
(define hr-m1 '(- 0 1))
(sp (make-wff (hr-gcst '(nu u v) (list hr-nuh (hr-inCg 'u) (hr-inCg 'v))
   (list '<= (list '- '(nu u) '(nu v)) (hr-dst 'u 'v)))))
(dk-peel!)
(hr-gnsetup!)
(define hr-np (hr-nu-parts! 'nu))
(define hr-D9 (hr-dst 'u 'v))
(hr-dreal! 'u 'v)
(dk-real! hr-m1)
(define hr-w9 (hr-add (hr-act hr-m1 'u) 'v))
(define hr-p9 (hr-add (hr-const hr-D9) hr-w9))
(hr-cin! hr-p9)
(hr-fun! 'u) (hr-fun! 'v)
(dk-have! (list 'FORALL 'pfx_ (list 'IMPLIES (hr-inPg 'pfx_) (list '<= 0 (list hr-p9 'pfx_))))
  (lambda ()
    (let ((x (dk-di-var!)))
      (hr-eval! x)
      (if (hr-has-redex? (dk-goal)) (dk-lam-b!))
      (hr-app! 'u x) (hr-app! 'v x)
      (let* ((ux (list 'u x)) (vx (list 'v x))
             (e (list '= (list '* hr-m1 ux) (list '- 0 ux))))
        (dk-real! (list '* hr-m1 ux))
        (dk-have! e (lambda () (crs)))
        (dk-cite! 'ck-dist-upper hr-Mg 'u 'v x)
        (dk-real! (list '- ux vx))
        (let ((pr (dk-cite! 'rr-abs-le-parts (list '- ux vx) hr-D9)))
          (dk-split-all! (list pr))
          (dk-ineq! e (caddr pr) (list 'IN ux 'RR) (list 'IN vx 'RR) (list 'IN hr-D9 'RR)
                    (list 'IN (list '* hr-m1 ux) 'RR)))))))
(define hr-pos9 (dk-apply! (list-ref hr-np 3) hr-p9))
(for-each (lambda (t) (hr-nuv! 'nu t)) (list hr-p9 hr-w9 (hr-act hr-m1 'u) (hr-const hr-D9) 'u 'v))
(define hr-e1 (dk-cite! 'haar-integral-add 'G 'nu (hr-const hr-D9) hr-w9))
(define hr-e2 (dk-cite! 'haar-integral-add 'G 'nu (hr-act hr-m1 'u) 'v))
(define hr-e3 (dk-cite! 'haar-integral-act 'G 'nu hr-m1 'u))
(define hr-e4 (dk-cite! 'haar-integral-const 'G 'nu hr-D9))
(dk-real! (list '* hr-m1 '(nu u)))
(define hr-e5 (list '= (list '* hr-m1 '(nu u)) '(- 0 (nu u))))
(dk-have! hr-e5 (lambda () (crs)))
(dk-ineq! (list '<= 0 (list 'nu hr-p9)) hr-e1 hr-e2 hr-e3 hr-e4 hr-e5
          (list 'IN (list 'nu hr-p9) 'RR) (list 'IN (list 'nu hr-w9) 'RR) (list 'IN (list 'nu (hr-act hr-m1 'u)) 'RR)
          (list 'IN (list 'nu (hr-const hr-D9)) 'RR) '(IN (nu u) RR) '(IN (nu v) RR) (list 'IN hr-D9 'RR)
          (list 'IN (list '* hr-m1 '(nu u)) 'RR))
(hr-qed! 'haar-integral-lip)

;;; ---- nu is constant on the convex hull of the orbit, then on its closure ----
(sp (make-wff (hr-gcst '(nu f) (list hr-nuh (hr-inCg 'f))
   (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w (hr-hull 'f)) (list '= '(nu w) '(nu f)))))))
(dk-peel!)
(define hr-np (hr-nu-parts! 'nu))
(hr-hull-setup! 'f)
(dk-cite! 'vec-is-set hr-N)
(hr-nuv! 'nu 'f)
(define hr-S9 (list 'SEP 'hrz_ hr-V (list '= '(nu hrz_) '(nu f))))
(dk-have! (list 'SUBSET (hr-orb 'f) hr-S9)
  (lambda ()
    (mac 'subset-def)
    (let ((z (dk-di-var!)))
      (dk-cite! 'subset-mem-fwd (hr-orb 'f) hr-V z)
      (dk-split-all! (list (hr-iff-rhs! (dk-cite! 'image-membership-iff (hr-Phi 'f) hr-Pg z))))
      (let* ((b (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'hqa_))) "the index")))
             (eq0 (dk-ctx-form (list '= (list (hr-Phi 'f) b) z))))
        (dk-lam-b-h! eq0)
        (hr-cin! (hr-L b 'f))
        (in-sep! (lambda () (ass))
                 (lambda ()
                   (subst (list '= z (hr-L b 'f)))
                   (dk-apply! (list-ref hr-np 5) b 'f)
                   (ass)))))))
(dk-have! (list 'IS-CONVEX-SUBSET hr-N hr-S9)
  (lambda ()
    (mac 'is-convex-subset)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-head-is? (dk-goal) 'FORALL))
            (begin (mac 'subset-def)
                   (let ((z (dk-di-var!)))
                     (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN z hr-S9)))))
                     (ass)))
            (let* ((ld (dk-peel!))
                   (ins (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) hr-S9))) ld))
                   (u (cadr (car ins))) (v (cadr (cadr ins)))
                   (t (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld))))
              (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN u hr-S9)))))
              (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN v hr-S9)))))
              (hr-toC! u) (hr-toC! v)
              (dk-real! (list '- 1 t))
              (let* ((cm (hr-comb t u v)) (au (hr-act (list '- 1 t) u)) (av (hr-act t v)))
                (hr-cin! cm) (hr-pm! cm)
                (for-each (lambda (x) (hr-nuv! 'nu x)) (list cm au av u v))
                (in-sep! (lambda () (ass))
                         (lambda ()
                           (subst (hr-eqn (dk-cite! 'haar-integral-add 'G 'nu au av)))
                           (subst (hr-eqn (dk-cite! 'haar-integral-act 'G 'nu (list '- 1 t) u)))
                           (subst (hr-eqn (dk-cite! 'haar-integral-act 'G 'nu t v)))
                           (subst (list '= (list 'nu u) '(nu f)))
                           (subst (list '= (list 'nu v) '(nu f)))
                           (crs))))))))))
(dk-have! (list 'SUBSET hr-S9 hr-V)
  (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN z hr-S9))))) (ass))))
(dk-cite! 'conv-hull-least hr-N (hr-orb 'f) hr-S9)
(let ((w (cadr (cadr (dk-goal)))))
  (dk-cite! 'subset-mem-fwd (hr-hull 'f) hr-S9 w)
  (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN w hr-S9)))))
  (ass))
(hr-qed! 'haar-integral-hull-const)

(sp (make-wff (hr-gcst '(nu f w) (list hr-nuh (hr-inCg 'f) (list 'IN 'w (hr-K 'f))) (list '= '(nu w) '(nu f)))))
(dk-peel!)
(hr-gnsetup!)
(define hr-np (hr-nu-parts! 'nu))
(hr-hull-setup! 'f)
(dk-cite! 'mg-hull-sub-vec 'G 'f)
(dk-cite! 'subset-mem-fwd (hr-K 'f) hr-V 'w)
(hr-toC! 'w)
(hr-nuv! 'nu 'w) (hr-nuv! 'nu 'f)
(hr-pm! 'w)
(define hr-hc9 (dk-cite! 'haar-integral-hull-const 'G 'nu 'f))
(dk-have! (list 'FORALL 'e (list 'IMPLIES '(POS-RR e) (list '<= (list 'abs '(- (nu w) (nu f))) 'e)))
  (lambda ()
    (let* ((e (dk-di-var! (lambda (g) (cadr (cadr g)))))
           (_ (di))
           (_p (dk-cite! 'rr-pos-rr-in-rr e))
           (y (dk-skolem! (dk-apply! (dk-cite! 'ms-closure-near hr-M (hr-hull 'f) 'w) e))))
      (dk-cite! 'subset-mem-fwd (hr-hull 'f) hr-V y)
      (hr-toC! y) (hr-pm! y)
      (hr-nuv! 'nu y)
      (hr-dreal! 'w y) (hr-dreal! y 'w)
      (let* ((hy (dk-apply! hr-hc9 y))
             (l1 (dk-cite! 'haar-integral-lip 'G 'nu 'w y))
             (l2 (dk-cite! 'haar-integral-lip 'G 'nu y 'w))
             (sy (dk-cite! 'metric-sym hr-M 'w y))
             (nr (dk-ctx-form (list '<= (hr-dst 'w y) e))))
        (hr-abs-by-parts! '(- (nu w) (nu f)) e
                          (list hy l1 l2 sy nr '(IN (nu w) RR) '(IN (nu f) RR) (list 'IN (list 'nu y) 'RR)
                                (list 'IN (hr-dst 'w y) 'RR) (list 'IN (hr-dst y 'w) 'RR) (list 'IN e 'RR)))))))
(hr-abs-zero-close! '(nu w) '(nu f))
(hr-qed! 'haar-integral-closure-const)

