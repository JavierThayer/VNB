;;; an averaging operator of G: its hypotheses for the transport at the opposite group, landed in G form
(define (hr-avg-transport-hyps! q)
  (let ((ps (hr-avg-parts! q)))
    (dk-have! (hr-T-affine q)
      (lambda ()
        (dk-peel!)
        (let* ((g0 (dk-goal)) (cm (cadr (cadr g0)))
               (t (caddr (cadr (cadr cm)))) (u (caddr (cadr cm))) (v (caddr (caddr cm))))
          (hr-cin! cm) (hr-cin! (hr-act (list '- 1 t) u)) (hr-cin! (hr-act t v))
          (subst (hr-eqn (dk-apply! (list-ref ps 1) (hr-act (list '- 1 t) u) (hr-act t v))))
          (subst (hr-eqn (dk-apply! (list-ref ps 2) (list '- 1 t) u)))
          (subst (hr-eqn (dk-apply! (list-ref ps 2) t v)))
          (hr-cin! (hr-comb t (list q u) (list q v)))
          (rfl))))
    (dk-have! (hr-gp-term-lp (hr-T-comm q))
      (lambda ()
        (dk-peel!)
        (let* ((g0 (dk-goal)) (lbu (cadr (cadr g0))) (u (car (cadddr lbu))) (b (cadr (cadr (cadddr lbu)))))
          (hr-cin! (list q u))
          (hr-lp-eq! b u) (hr-lp-eq! b (list q u))
          (subst (list '= (hr-Lp b u) (hr-R b u)))
          (subst (list '= (hr-Lp b (list q u)) (hr-R b (list q u))))
          (subst (hr-eqn (dk-apply! (list-ref ps 6) b u)))
          (hr-cin! (hr-R b (list q u)))
          (rfl))))
    (list (list-ref ps 0) (hr-T-affine q) (list-ref ps 3) (hr-gp-term-lp (hr-T-comm q)))))
;;; the commutation clause with L read at the opposite group (OPR G -> OPR Gp in the translate)
(define (hr-gp-term-lp f)
  (cond ((and (pair? f) (equal? f (list 'OPR 'G))) (list 'OPR hr-Gp))
        ((pair? f) (map hr-gp-term-lp f))
        (#t f)))

(sp (make-wff (hr-gcst '(q f w) (list (list 'IN 'q hr-Q) (hr-inCg 'f) (list 'IN 'w (hr-Kp 'f)))
