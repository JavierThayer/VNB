(hr-qed! 'haar-mean-right-inv)

;;; =====================================================================
;;; hr-p8.scm -- HAAR-C3 part 8: th-main Prop 3.81 -- the Haar mean is additive, real-homogeneous and
;;; positive, and the functional f |-> HAAR-MEAN(G, f) is a Haar integral of G (Thm 1.9 / Cor 3.82).

;;; ---- pointwise estimates in C(G) ----
(define (hr-ptw-le! u v b pt!)           ; land (<= d(u,v) b) by ck-dist-le; PT! x proves |u x - v x| <= b
  (let ((bnd (list 'FORALL 'x (list 'IMPLIES (hr-inPg 'x) (list '<= (list 'abs (list '- (list u 'x) (list v 'x))) b))))
        (res (list '<= (hr-dst u v) b)))
    (dk-have! res
      (lambda ()
        (dk-have! bnd (lambda () (let ((x (dk-di-var!))) (pt! x))))
        (dk-cite! 'ck-dist-le hr-Mg u v b)
        (ass)))
    res))
(define (hr-abs-by-parts! x c prems)     ; goal (<= (abs x) c): -c <= x and x <= c by ineq on PREMS
  (dk-real! x) (dk-real! c)
  (let ((ps (append prems (list (list 'IN x 'RR) (list 'IN c 'RR)))))
    (dk-have! (list '<= (list '- c) x) (lambda () (apply dk-ineq! ps)))
    (dk-have! (list '<= x c) (lambda () (apply dk-ineq! ps))))
  (dk-cite! 'rr-abs-le-of-parts x c)
  (ass))

(sp (make-wff (hr-gcst '(u v u2 v2) (map hr-inCg '(u v u2 v2))
   (list '<= (hr-dst (hr-add 'u 'v) (hr-add 'u2 'v2)) (list '+ (hr-dst 'u 'u2) (hr-dst 'v 'v2))))))
(dk-peel!)
(hr-gnsetup!)
(hr-cin! (hr-add 'u 'v)) (hr-cin! (hr-add 'u2 'v2))
(hr-dreal! 'u 'u2) (hr-dreal! 'v 'v2)
(define hr-b8 (list '+ (hr-dst 'u 'u2) (hr-dst 'v 'v2)))
(dk-real! hr-b8)
(dk-have! (list '<= 0 hr-b8)
  (lambda () (let* ((p1 (dk-cite! 'metric-pos hr-M 'u 'u2)) (p2 (dk-cite! 'metric-pos hr-M 'v 'v2)))
                (dk-ineq! p1 p2 (list 'IN (hr-dst 'u 'u2) 'RR) (list 'IN (hr-dst 'v 'v2) 'RR)))))
(hr-ptw-le! (hr-add 'u 'v) (hr-add 'u2 'v2) hr-b8
  (lambda (x)
    (subst (hr-eqn (dk-cite! 'ck-vadd-apply hr-Mg 'u 'v x)))
    (subst (hr-eqn (dk-cite! 'ck-vadd-apply hr-Mg 'u2 'v2 x)))
    (for-each (lambda (h) (hr-app! h x)) '(u v u2 v2))
    (let* ((u1 (dk-cite! 'ck-dist-upper hr-Mg 'u 'u2 x))
           (u2 (dk-cite! 'ck-dist-upper hr-Mg 'v 'v2 x)))
      (dk-real! (list '- (list 'u x) (list 'u2 x))) (dk-real! (list '- (list 'v x) (list 'v2 x)))
      (let* ((p1 (dk-cite! 'rr-abs-le-parts (list '- (list 'u x) (list 'u2 x)) (hr-dst 'u 'u2)))
            (p2 (dk-cite! 'rr-abs-le-parts (list '- (list 'v x) (list 'v2 x)) (hr-dst 'v 'v2))))
        (dk-split-all! (list p1 p2))
        (hr-abs-by-parts! (list '- (list '+ (list 'u x) (list 'v x)) (list '+ (list 'u2 x) (list 'v2 x))) hr-b8
                          (append (list (cadr p1) (caddr p1) (cadr p2) (caddr p2)
                                        (list 'IN (hr-dst 'u 'u2) 'RR) (list 'IN (hr-dst 'v 'v2) 'RR))
                                  (map (lambda (h) (list 'IN (list h x) 'RR)) '(u v u2 v2))))))))
(hr-qed! 'ck-dist-add-le)

(sp (make-wff (hr-gcst '(c u v) (list '(IN c RR) (hr-inCg 'u) (hr-inCg 'v))
   (list '<= (hr-dst (hr-act 'c 'u) (hr-act 'c 'v)) (list '* (hr-dst 'u 'v) '(abs c))))))
(dk-peel!)
(hr-gnsetup!)
(hr-cin! (hr-act 'c 'u)) (hr-cin! (hr-act 'c 'v))
(hr-dreal! 'u 'v)
(dk-cite! 'metric-pos hr-M 'u 'v)
(dk-cite! 'rr-abs-closed 'c) (dk-cite! 'rr-abs-nonneg 'c)
(define hr-b9 (list '* (hr-dst 'u 'v) '(abs c)))
(hr-and! (list 'IN (hr-dst 'u 'v) 'RR) '(IN (abs c) RR))
(dk-real! hr-b9)
(hr-and! (list '<= 0 (hr-dst 'u 'v)) '(<= 0 (abs c)))
(dk-cite! 'rr-leq-mul-nonneg (hr-dst 'u 'v) '(abs c))
(hr-ptw-le! (hr-act 'c 'u) (hr-act 'c 'v) hr-b9
  (lambda (x)
    (subst (hr-eqn (dk-cite! 'ck-act-apply hr-Mg 'c 'u x)))
    (subst (hr-eqn (dk-cite! 'ck-act-apply hr-Mg 'c 'v x)))
    (hr-app! 'u x) (hr-app! 'v x)
    (let* ((dx (list '- (list 'u x) (list 'v x)))
           (eq (list '= (list '- (list '* 'c (list 'u x)) (list '* 'c (list 'v x))) (list '* dx 'c))))
      (dk-real! dx)
      (dk-have! eq (lambda () (crs)))
      (subst eq)
      (hr-and! (list 'IN dx 'RR) '(IN c RR))
      (subst (hr-eqn (dk-cite! 'rr-abs-mult dx 'c)))
      (dk-cite! 'ck-dist-upper hr-Mg 'u 'v x)
      (dk-cite! 'rr-abs-closed dx)
      (dk-cite! 'rr-mul-le-right (list 'abs dx) (hr-dst 'u 'v) '(abs c))
      (ass))))
(hr-qed! 'ck-dist-act-le)

(sp (make-wff (hr-gcst '(j k) (list '(IN j RR) '(IN k RR)) (list '= (hr-add (hr-const 'j) (hr-const 'k)) (hr-const '(+ j k))))))
(dk-peel!)
(hr-gnsetup!)
(hr-ext!)
(hr-qed! 'ck-vadd-const)

(sp (make-wff (hr-gcst '(c k) (list '(IN c RR) '(IN k RR)) (list '= (hr-act 'c (hr-const 'k)) (hr-const '(* c k))))))
