(hr-opp-setup!)
(hr-to-gp! (hr-inPg 'b))
(hr-to-gp! (hr-inCg 'f))
(let* ((e (hr-opp-cite! 'haar-mean-left-inv 'b 'f))
       (_l (hr-lp-eq! 'b 'f))
