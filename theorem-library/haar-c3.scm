;;; hr-p2.scm -- HAAR-C3 part 2: right translations x |-> h(x b) as the left translations of the opposite
;;; metric group; continuity, isometry, affinity of right translations; additivity and homogeneity of left
;;; translations; translations fix the constants; left and right translations commute.

(define hr-Cg (list 'CONT-FNS hr-Mg))
(define (hr-inCg v) (list 'IN v hr-Cg))
(define hr-FPg (list 'FUN hr-Pg 'RR))
(define hr-N '(CK-NVS (METRIC-GROUP-MS G)))
(define hr-M '(NVS-METRIC-SPACE (CK-NVS (METRIC-GROUP-MS G))))
(define (hr-dst u v) (list (list 'DIST hr-M) u v))
(define (hr-mul a b) (list '(OPR G) a b))
(define (hr-L a h) (list 'VNB-LAMBDA 'hix_ hr-Pg (list h (hr-mul a 'hix_))))
(define (hr-R b h) (list 'VNB-LAMBDA 'hix_ hr-Pg (list h (hr-mul 'hix_ b))))
(define (hr-Lp b h) (list 'VNB-LAMBDA 'hix_ hr-Pg (list h (list (list 'OPR hr-Gp) b 'hix_))))
(define (hr-const c) (list 'VNB-LAMBDA 'hix_ hr-Pg c))
(define (hr-add u v) (list (list 'VADD hr-N) u v))
(define (hr-act r u) (list (list 'ACT hr-N) r u))
(define (hr-comb t u v) (hr-add (hr-act (list '- 1 t) u) (hr-act t v)))
(define hr-gcpt (list 'IS-COMPACT hr-Mg))
(define (hr-gcst vars guards body) (hr-gst vars (cons hr-gcpt guards) body))

;;; ---- moving between G and its opposite ----
(define hr-MGp (list 'METRIC-GROUP-MS hr-Gp))
(define (hr-gp-term t)                   ; the term t with METRIC-GROUP-MS(G) read as METRIC-GROUP-MS(Gp)
  (cond ((equal? t hr-Mg) hr-MGp)
        ((pair? t) (map hr-gp-term t))
        (#t t)))
(define (hr-opp-setup!)
  (if (not (dk-asm? (list 'IS-METRIC-GROUP hr-Gp)))
      (begin
        (dk-cite! 'opp-mg-is-metric-group 'G)
        (dk-cite! 'opp-mg-ms 'G)
        (if (dk-asm? hr-gcpt) (dk-cite! 'opp-mg-compact 'G)))))
(define (hr-to-gp! f)                    ; F in context: land F[MS G := MS Gp]
  (let ((f2 (hr-gp-term f)))
    (if (dk-asm? f2) f2 (dk-rewrite-h! f hr-Mg hr-MGp))))
(define (hr-from-gp! f)                  ; F in context: land F[MS Gp := MS G]
  (if (dk-contains? f hr-MGp) (dk-rewrite-h! f hr-MGp hr-Mg) f))
(define (hr-opp-cite! name . args)       ; cite NAME at Gp, args read at Gp; return the fact read back at G
  (hr-from-gp! (apply dk-cite! name hr-Gp (map hr-gp-term args))))

;;; ---- typings ----
(define (hr-gset!) (if (not (dk-asm? (list 'IN hr-Pg 'SET))) (dk-cite! 'ms-pts-is-set hr-Mg)))
(define (hr-gmul! a x)
  (let ((ty (hr-inPg (hr-mul a x))))
    (if (not (dk-asm? ty)) (dk-cite! 'mg-opr-in 'G a x))
    ty))
(define (hr-fun! h)                      ; (IN h (FUN Pg RR)) from (IN h C(G))
  (if (not (dk-asm? (list 'IN h hr-FPg)))
      (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts hr-Mg h)))))
(define (hr-app! h x)
  (let ((ty (list 'IN (list h x) 'RR)))
    (if (not (dk-asm? ty)) (begin (hr-fun! h) (dk-cite! 'fun-apply-type-c h hr-Pg 'RR x)))
    ty))
(define (hr-lam-fun! lam pt!)            ; (IN lam (FUN Pg RR)) for lam = (VNB-LAMBDA hix_ Pg body); PT! types the body at x
  (let ((ty (list 'IN lam hr-FPg)))
    (if (not (dk-asm? ty))
        (begin
          (hr-gset!)
          (dk-have! ty (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (pt! x) (ass))))))))
    ty))
(define (hr-Lfun! a h) (hr-lam-fun! (hr-L a h) (lambda (x) (hr-gmul! a x) (hr-app! h (hr-mul a x)))))
(define (hr-Rfun! b h) (hr-lam-fun! (hr-R b h) (lambda (x) (hr-gmul! x b) (hr-app! h (hr-mul x b)))))
(define (hr-constfun! c) (hr-lam-fun! (hr-const c) (lambda (x) #t)))
(define (hr-pt-done!)                     ; close a pointwise goal: beta, then rfl / ass
  (let ((leaf (proof-state-focus *ps*)))
    (if (hr-has-redex? (dk-goal)) (dk-lam-b!))
    (if (not (sequent-node-grounded? leaf))
        (if (dk-asm? (dk-goal)) (ass) (rfl)))))

;;; ---- the left translates of the opposite group are the right translates ----
(sp (make-wff (hr-gst '(b h) (list (hr-inPg 'b) (list 'IN 'h hr-FPg)) (list '= (hr-Lp 'b 'h) (hr-R 'b 'h)))))
(dk-peel!)
(dk-cite! 'metric-group-ms-is-metric-space 'G)
(hr-gset!)
(hr-Rfun! 'b 'h)
(hr-lam-fun! (hr-Lp 'b 'h)
  (lambda (x)
    (hr-gmul! x 'b)
    (dk-cite! 'opp-mg-opr-apply 'G 'b x)
    (dk-rewrite-h! (hr-inPg (hr-mul x 'b)) (hr-mul x 'b) (list (list 'OPR hr-Gp) 'b x))
    (hr-app! 'h (list (list 'OPR hr-Gp) 'b x))))
(dk-fun-ext! (hr-Lp 'b 'h) (hr-R 'b 'h) hr-Pg 'RR #f #f
  (lambda (x)
    (hr-gmul! x 'b)
    (dk-cite! 'opp-mg-opr-apply 'G 'b x)
    (dk-rewrite-h! (hr-inPg (hr-mul x 'b)) (hr-mul x 'b) (list (list 'OPR hr-Gp) 'b x))
    (let ((leaf (proof-state-focus *ps*)))
      (dk-lam-b!)
      (if (not (sequent-node-grounded? leaf))
          (begin (subst (list '= (list (list 'OPR hr-Gp) 'b x) (hr-mul x 'b))) (rfl))))))
(hr-qed! 'opp-mg-ltrans-eq)

;;; (= Lp(b, h) R(b, h)) landed, h in C(G)
(define (hr-lp-eq! b h)
  (hr-fun! h)
  (dk-cite! 'opp-mg-ltrans-eq 'G b h))

(sp (make-wff (hr-gst '(b h) (list (hr-inPg 'b) (hr-inCg 'h)) (hr-inCg (hr-R 'b 'h)))))
(dk-peel!)
(hr-opp-setup!)
(hr-to-gp! (hr-inPg 'b))
(hr-to-gp! (hr-inCg 'h))
(let ((f (hr-opp-cite! 'mg-ltrans-cont 'b 'h)))
  (hr-lp-eq! 'b 'h)
  (dk-rewrite-h! f (hr-Lp 'b 'h) (hr-R 'b 'h))
  (ass))
(hr-qed! 'mg-rtrans-cont)

(sp (make-wff (hr-gcst '(b f f2) (list (hr-inPg 'b) (hr-inCg 'f) (hr-inCg 'f2))
   (list '= (hr-dst (hr-R 'b 'f) (hr-R 'b 'f2)) (hr-dst 'f 'f2)))))
(dk-peel!)
(hr-opp-setup!)
(for-each hr-to-gp! (list (hr-inPg 'b) (hr-inCg 'f) (hr-inCg 'f2)))
(let ((e (hr-opp-cite! 'mg-ltrans-dist 'b 'f 'f2)))
  (hr-lp-eq! 'b 'f) (hr-lp-eq! 'b 'f2)
  (let* ((e1 (dk-rewrite-h! e (hr-Lp 'b 'f) (hr-R 'b 'f)))
         (e2 (dk-rewrite-h! e1 (hr-Lp 'b 'f2) (hr-R 'b 'f2))))
    (ass)))
(hr-qed! 'mg-rtrans-dist)

(define (hr-comb-in! t u v)               ; the combination typed in C(G); t in RR in context
  (dk-real! (list '- 1 t))
  (dk-cite! 'ck-act-in hr-Mg (list '- 1 t) u)
  (dk-cite! 'ck-act-in hr-Mg t v)
  (dk-cite! 'ck-vadd-in hr-Mg (hr-act (list '- 1 t) u) (hr-act t v)))
(sp (make-wff (hr-gcst '(b u v t) (list (hr-inPg 'b) (hr-inCg 'u) (hr-inCg 'v) '(IN t RR))
   (list '= (hr-R 'b (hr-comb 't 'u 'v)) (hr-comb 't (hr-R 'b 'u) (hr-R 'b 'v))))))
(dk-peel!)
(dk-cite! 'metric-group-ms-is-metric-space 'G)
(hr-comb-in! 't 'u 'v)
(hr-opp-setup!)
(for-each hr-to-gp! (list (hr-inPg 'b) (hr-inCg 'u) (hr-inCg 'v)))
(let ((e (hr-opp-cite! 'mg-ltrans-affine 'b 'u 'v 't)))
  (hr-lp-eq! 'b 'u) (hr-lp-eq! 'b 'v) (hr-lp-eq! 'b (hr-comb 't 'u 'v))
  (let* ((e1 (dk-rewrite-h! e (hr-Lp 'b (hr-comb 't 'u 'v)) (hr-R 'b (hr-comb 't 'u 'v))))
         (e2 (dk-rewrite-h! e1 (hr-Lp 'b 'u) (hr-R 'b 'u)))
         (e3 (dk-rewrite-h! e2 (hr-Lp 'b 'v) (hr-R 'b 'v))))
    (ass)))
(hr-qed! 'mg-rtrans-affine)

;;; ---- left translations are additive and homogeneous ----
(sp (make-wff (hr-gst '(a u v) (list (hr-inPg 'a) (hr-inCg 'u) (hr-inCg 'v))
   (list '= (hr-L 'a (hr-add 'u 'v)) (hr-add (hr-L 'a 'u) (hr-L 'a 'v))))))
(dk-peel!)
(dk-cite! 'metric-group-ms-is-metric-space 'G)
(hr-gset!)
(dk-cite! 'ck-vadd-in hr-Mg 'u 'v)
(dk-cite! 'mg-ltrans-cont 'G 'a 'u)
(dk-cite! 'mg-ltrans-cont 'G 'a 'v)
(dk-cite! 'ck-vadd-in hr-Mg (hr-L 'a 'u) (hr-L 'a 'v))
(hr-Lfun! 'a (hr-add 'u 'v))
(hr-fun! (hr-add (hr-L 'a 'u) (hr-L 'a 'v)))
(dk-fun-ext! (hr-L 'a (hr-add 'u 'v)) (hr-add (hr-L 'a 'u) (hr-L 'a 'v)) hr-Pg 'RR #f #f
  (lambda (x)
    (let ((ax (hr-mul 'a x)))
      (hr-gmul! 'a x)
      (hr-app! 'u ax) (hr-app! 'v ax)
      (subst (hr-eqn (dk-cite! 'ck-vadd-apply hr-Mg (hr-L 'a 'u) (hr-L 'a 'v) x)))
      (dk-lam-b!)
      (subst (hr-eqn (dk-cite! 'ck-vadd-apply hr-Mg 'u 'v ax)))
      (rfl))))
(hr-qed! 'mg-ltrans-add)

(sp (make-wff (hr-gst '(a r u) (list (hr-inPg 'a) '(IN r RR) (hr-inCg 'u))
   (list '= (hr-L 'a (hr-act 'r 'u)) (hr-act 'r (hr-L 'a 'u))))))
(dk-peel!)
(dk-cite! 'metric-group-ms-is-metric-space 'G)
(hr-gset!)
(dk-cite! 'ck-act-in hr-Mg 'r 'u)
(dk-cite! 'mg-ltrans-cont 'G 'a 'u)
(dk-cite! 'ck-act-in hr-Mg 'r (hr-L 'a 'u))
(hr-Lfun! 'a (hr-act 'r 'u))
(hr-fun! (hr-act 'r (hr-L 'a 'u)))
(dk-fun-ext! (hr-L 'a (hr-act 'r 'u)) (hr-act 'r (hr-L 'a 'u)) hr-Pg 'RR #f #f
  (lambda (x)
    (let ((ax (hr-mul 'a x)))
      (hr-gmul! 'a x)
      (hr-app! 'u ax)
      (subst (hr-eqn (dk-cite! 'ck-act-apply hr-Mg 'r (hr-L 'a 'u) x)))
      (dk-lam-b!)
      (subst (hr-eqn (dk-cite! 'ck-act-apply hr-Mg 'r 'u ax)))
      (rfl))))
(hr-qed! 'mg-ltrans-act)

;;; ---- translations fix the constants ----
(sp (make-wff (hr-gst '(a c) (list (hr-inPg 'a) '(IN c RR)) (list '= (hr-L 'a (hr-const 'c)) (hr-const 'c)))))
(dk-peel!)
(dk-cite! 'metric-group-ms-is-metric-space 'G)
(hr-gset!)
(hr-constfun! 'c)
(hr-Lfun! 'a (hr-const 'c))
(dk-fun-ext! (hr-L 'a (hr-const 'c)) (hr-const 'c) hr-Pg 'RR #f #f
  (lambda (x) (hr-gmul! 'a x) (hr-pt-done!)))
(hr-qed! 'mg-ltrans-const)

(sp (make-wff (hr-gst '(b c) (list (hr-inPg 'b) '(IN c RR)) (list '= (hr-R 'b (hr-const 'c)) (hr-const 'c)))))
(dk-peel!)
(dk-cite! 'metric-group-ms-is-metric-space 'G)
(hr-gset!)
(hr-constfun! 'c)
(hr-Rfun! 'b (hr-const 'c))
(dk-fun-ext! (hr-R 'b (hr-const 'c)) (hr-const 'c) hr-Pg 'RR #f #f
  (lambda (x) (hr-gmul! x 'b) (hr-pt-done!)))
(hr-qed! 'mg-rtrans-const)

;;; ---- left and right translations commute ----
(sp (make-wff (hr-gst '(a b h) (list (hr-inPg 'a) (hr-inPg 'b) (list 'IN 'h hr-FPg))
   (list '= (hr-L 'a (hr-R 'b 'h)) (hr-R 'b (hr-L 'a 'h))))))
(dk-peel!)
(dk-cite! 'metric-group-ms-is-metric-space 'G)
(hr-gset!)
(hr-Rfun! 'b 'h)
(hr-Lfun! 'a 'h)
(hr-Lfun! 'a (hr-R 'b 'h))
(hr-Rfun! 'b (hr-L 'a 'h))
(dk-fun-ext! (hr-L 'a (hr-R 'b 'h)) (hr-R 'b (hr-L 'a 'h)) hr-Pg 'RR #f #f
  (lambda (x)
    (let ((ax (hr-mul 'a x)) (xb (hr-mul x 'b)))
      (hr-gmul! 'a x) (hr-gmul! x 'b)
      (hr-gmul! ax 'b) (hr-gmul! 'a xb)
      (hr-app! 'h (hr-mul ax 'b)) (hr-app! 'h (hr-mul 'a xb))
      (dk-cite! 'mg-assoc 'G 'a x 'b)
      (let ((leaf (proof-state-focus *ps*)))
        (dk-lam-b!)
        (if (not (sequent-node-grounded? leaf))
            (begin (subst (list '= (hr-mul ax 'b) (hr-mul 'a xb))) (rfl)))))))
(hr-qed! 'mg-lr-commute)

;;; =====================================================================
;;; hr-p3.scm -- HAAR-C3 part 3: the averaging operators HAAR-AVERAGES(G): unfold, elimination,
;;; introduction; constants are continuous; every left translation is an averaging operator.

(define hr-Q '(HAAR-AVERAGES G))
(define hr-FCC (list 'FUN hr-Cg hr-Cg))
(define (hr-Phi f) (list 'VNB-LAMBDA 'hqa_ hr-Pg (hr-L 'hqa_ f)))
(define (hr-orb f) (list 'IMAGE (hr-Phi f) hr-Pg))
(define (hr-hull f) (list 'CONV-HULL hr-N (hr-orb f)))
(define (hr-K f) (list 'CLOSURE hr-M (hr-hull f)))
(define hr-V (list 'VEC hr-N))
(define hr-PM (list 'PTS hr-M))
(define (hr-avg-clauses q)
  (list
    (list 'FORALL 'hau_ (list 'IMPLIES (hr-inCg 'hau_) (list 'FORALL 'hav_ (list 'IMPLIES (hr-inCg 'hav_)
      (list '= (list q (hr-add 'hau_ 'hav_)) (hr-add (list q 'hau_) (list q 'hav_)))))))
    (list 'FORALL 'har_ (list 'IMPLIES '(IN har_ RR) (list 'FORALL 'hau_ (list 'IMPLIES (hr-inCg 'hau_)
      (list '= (list q (hr-act 'har_ 'hau_)) (hr-act 'har_ (list q 'hau_)))))))
    (list 'FORALL 'hau_ (list 'IMPLIES (hr-inCg 'hau_) (list 'FORALL 'hav_ (list 'IMPLIES (hr-inCg 'hav_)
      (list '<= (hr-dst (list q 'hau_) (list q 'hav_)) (hr-dst 'hau_ 'hav_))))))
    (list 'FORALL 'hac_ (list 'IMPLIES '(IN hac_ RR) (list '= (list q (hr-const 'hac_)) (hr-const 'hac_))))
    (list 'FORALL 'hau_ (list 'IMPLIES (hr-inCg 'hau_) (list 'IN (list q 'hau_) (hr-hull 'hau_))))
    (list 'FORALL 'hab_ (list 'IMPLIES (hr-inPg 'hab_) (list 'FORALL 'hau_ (list 'IMPLIES (hr-inCg 'hau_)
      (list '= (list q (hr-R 'hab_ 'hau_)) (hr-R 'hab_ (list q 'hau_)))))))))
(define (hr-conj l) (if (null? (cdr l)) (car l) (list 'AND (car l) (hr-conj (cdr l)))))
(define hr-Qsep (list 'SEP 'haq_ hr-FCC (hr-conj (hr-avg-clauses 'haq_))))

(sp (make-wff (list 'FORALL 'G (list '== hr-Q hr-Qsep))))
(dk-peel!)
(mac 'HAAR-AVERAGES)
(qrfl)
(hr-qed! 'haar-avg-unfold)

(sp (make-wff (hr-gst '(q) (list (list 'IN 'q hr-Q)) (hr-conj (cons (list 'IN 'q hr-FCC) (hr-avg-clauses 'q))))))
(dk-peel!)
(dk-cite! 'haar-avg-unfold 'G)
(let ((m (dk-rewrite-h! (list 'IN 'q hr-Q) hr-Q hr-Qsep)))
  (dk-split-all! (dk-landed (lambda () (sep-me m)))))
(dk-conj-close! (lambda () (ass)))
(hr-qed! 'haar-avg-elim)

(define (hr-imps hs body) (if (null? hs) body (list 'IMPLIES (car hs) (hr-imps (cdr hs) body))))
(sp (make-wff (hr-gst '(q) '() (hr-imps (cons (list 'IN 'q hr-FCC) (hr-avg-clauses 'q)) (list 'IN 'q hr-Q)))))
(dk-peel!)
(dk-cite! 'haar-avg-unfold 'G)
(subst (list '= hr-Q hr-Qsep))
(in-sep! (lambda () (ass)) (lambda () (dk-conj-close! (lambda () (ass)))))
(hr-qed! 'haar-avg-intro)

;;; the parts of q in HAAR-AVERAGES(G), landed; returns (typing c1 c2 c3 c4 c5 c6)
(define (hr-avg-parts! q)
  (let ((fs (cons (list 'IN q hr-FCC) (hr-avg-clauses q))))
    (if (not (dk-asm? (list-ref fs 6)))
        (dk-split-all! (list (dk-cite! 'haar-avg-elim 'G q))))
    fs))

;;; ---- constants are continuous ----
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (FORALL c (IMPLIES (IN c RR)
   (IN (VNB-LAMBDA hix_ (PTS s) c) (CONT-FNS s))))))))
(dk-peel!)
(dk-cite! 'ms-pts-is-set 's)
(define hr-cst '(VNB-LAMBDA hix_ (PTS s) c))
(dk-have! (list 'IN hr-cst '(FUN (PTS s) RR))
  (lambda () (dk-lam-type! (lambda () (dk-di-var!) (ass)) (lambda () (ass)))))
(dk-cite! 'carrier-is-open 's)
(dk-have! (list 'FORALL 'a (list 'IMPLIES '(IN a (PTS s)) (list 'IS-CONTINUOUS-AT 's 'RR-MS hr-cst 'a)))
  (lambda ()
    (let ((a (dk-di-var!)))
      (dk-have! (list 'FORALL 'y (list 'IMPLIES '(IN y (PTS s)) (list '= (list hr-cst 'y) (list hr-cst a))))
        (lambda ()
          (dk-di-var!)
          (if (not (dk-lam-b!)) (rfl))))
      (dk-cite! 'rmc-cont-at-locally-const 's hr-cst a '(PTS s))
      (ass))))
(dk-cite! 'rmc-cont-fns-intro 's hr-cst)
(ass)
(hr-qed! 'ck-const-cont)

;;; ---- the normed-space setup on C(G) ----
(define (hr-gnsetup!)
  (if (not (dk-asm? (list 'IS-NORMED-VECTOR-SPACE hr-N)))
      (begin
        (dk-cite! 'metric-group-ms-is-metric-space 'G)
        (hr-gset!)
        (dk-cite! 'ck-nvs-is-normed-vector-space hr-Mg)
        (dk-cite! 'nvs-metric-is-ms hr-N)
        (dk-cite! 'nvs-ms-pts hr-N)
        (dk-cite! 'ck-nvs-vec hr-Mg))))
(define (hr-pm! v)                       ; (IN v VEC) and (IN v PTS M) from (IN v C(G))
  (let ((t1 (list 'IN v hr-V)) (t2 (list 'IN v hr-PM)))
    (if (not (dk-asm? t1)) (dk-rewrite-h! (hr-inCg v) hr-Cg hr-V))
    (if (not (dk-asm? t2)) (dk-rewrite-h! t1 hr-V hr-PM))
    t2))
(define (hr-toC! v)                      ; (IN v C(G)) from (IN v VEC)
  (if (not (dk-asm? (hr-inCg v))) (dk-rewrite-h! (list 'IN v hr-V) hr-V hr-Cg)))
(define (hr-dreal! u v)
  (hr-pm! u) (hr-pm! v)
  (let ((ty (list 'IN (hr-dst u v) 'RR)))
    (if (not (dk-asm? ty)) (dk-cite! 'metric-dist-real hr-M u v))
    ty))
;;; (= (op u) val) by beta on a lane, u typed in context
(define (hr-op-at! op u val)
  (let ((e (list '= (list op u) val)))
    (if (not (dk-asm? e))
        (dk-have! e (lambda () (let ((m (dk--close-owed-typings! (lambda () (lam-b))))) (if (and m (not (sequent-node-grounded? m))) (begin (dk-focus! m) (rfl)))))))
    e))
(define (hr-cin! v)                      ; (IN v C(G)) for slot terms, translates, constants, q-values
  (let ((ty (hr-inCg v)))
    (cond ((dk-asm? ty) ty)
          ((and (pair? v) (equal? (car v) (list 'VADD hr-N)))
           (hr-cin! (cadr v)) (hr-cin! (caddr v)) (dk-cite! 'ck-vadd-in hr-Mg (cadr v) (caddr v)) ty)
          ((and (pair? v) (equal? (car v) (list 'ACT hr-N)))
           (dk-real! (cadr v)) (hr-cin! (caddr v)) (dk-cite! 'ck-act-in hr-Mg (cadr v) (caddr v)) ty)
          ((and (dk-head-is? v 'VNB-LAMBDA) (not (dk-contains? (cadddr v) 'hix_)) (equal? v (hr-const (cadddr v))))
           (dk-real! (cadddr v)) (dk-cite! 'ck-const-cont hr-Mg (cadddr v)) ty)
          ((and (dk-head-is? v 'VNB-LAMBDA) (equal? v (hr-L (cadr (cadr (cadddr v))) (car (cadddr v)))))
           (hr-cin! (car (cadddr v))) (dk-cite! 'mg-ltrans-cont 'G (cadr (cadr (cadddr v))) (car (cadddr v))) ty)
          ((and (dk-head-is? v 'VNB-LAMBDA) (equal? v (hr-R (caddr (cadr (cadddr v))) (car (cadddr v)))))
           (hr-cin! (car (cadddr v))) (dk-cite! 'mg-rtrans-cont 'G (caddr (cadr (cadddr v))) (car (cadddr v))) ty)
          ((and (pair? v) (= (length v) 2) (dk-asm? (list 'IN (car v) hr-FCC)))
           (hr-cin! (cadr v)) (dk-cite! 'fun-apply-type-c (car v) hr-Cg hr-Cg (cadr v)) ty)
          (#t (error "hr-cin!: no typing for" (expression->string v))))))

;;; ---- a left translation is an averaging operator ----
(define (hr-Lop a) (list 'VNB-LAMBDA 'hrh_ hr-Cg (hr-L a 'hrh_)))
(sp (make-wff (hr-gcst '(a) (list (hr-inPg 'a)) (list 'IN (hr-Lop 'a) hr-Q))))
(dk-peel!)
(hr-gnsetup!)
(define hr-lopa (hr-Lop 'a))
(dk-cite! 'ck-cont-fns-is-set hr-Mg)
(dk-have! (list 'IN hr-lopa hr-FCC)
  (lambda () (dk-lam-type! (lambda () (let ((h (dk-di-var!))) (hr-cin! (hr-L 'a h)) (ass))) (lambda () (ass)))))
(begin
  (for-each
    (lambda (cl)
      (dk-have! cl
        (lambda ()
          (let* ((pl (dk-peel!))
                 (g0 (dk-goal)))
            (cond
              ;; additivity
              ((and (dk-head-is? g0 '=) (equal? (car (cadr (cadr g0))) (list 'VADD hr-N)))
               (let* ((uv (cadr (cadr g0))) (u (cadr uv)) (v (caddr uv)))
                 (hr-cin! uv)
                 (subst (hr-op-at! hr-lopa uv (hr-L 'a uv)))
                 (subst (hr-op-at! hr-lopa u (hr-L 'a u)))
                 (subst (hr-op-at! hr-lopa v (hr-L 'a v)))
                 (dk-cite! 'mg-ltrans-add 'G 'a u v)
                 (ass)))
              ;; homogeneity
              ((and (dk-head-is? g0 '=) (equal? (car (cadr (cadr g0))) (list 'ACT hr-N)))
               (let* ((ru (cadr (cadr g0))) (r (cadr ru)) (u (caddr ru)))
                 (hr-cin! ru)
                 (subst (hr-op-at! hr-lopa ru (hr-L 'a ru)))
                 (subst (hr-op-at! hr-lopa u (hr-L 'a u)))
                 (dk-cite! 'mg-ltrans-act 'G 'a r u)
                 (ass)))
              ;; Lipschitz
              ((dk-head-is? g0 '<=)
               (let* ((u (cadr (cadr (cadr g0)))) (v (cadr (caddr (cadr g0)))))
                 (subst (hr-op-at! hr-lopa u (hr-L 'a u)))
                 (subst (hr-op-at! hr-lopa v (hr-L 'a v)))
                 (let ((e (dk-cite! 'mg-ltrans-dist 'G 'a u v)))
                   (hr-cin! (hr-L 'a u)) (hr-cin! (hr-L 'a v))
                   (hr-dreal! (hr-L 'a u) (hr-L 'a v)) (hr-dreal! u v)
                   (dk-ineq! e (list 'IN (hr-dst (hr-L 'a u) (hr-L 'a v)) 'RR) (list 'IN (hr-dst u v) 'RR)))))
              ;; hull
              ((dk-head-is? g0 'IN)
               (let ((u (cadr (cadr g0))))
                 (subst (hr-op-at! hr-lopa u (hr-L 'a u)))
                 (dk-cite! 'mg-orbit-mem 'G u 'a)
                 (dk-cite! 'mg-orbit-sub-vec 'G u)
                 (dk-cite! 'conv-hull-contains hr-N (hr-orb u))
                 (dk-cite! 'subset-mem-fwd (hr-orb u) (hr-hull u) (hr-L 'a u))
                 (ass)))
              ;; constants
              ((and (dk-head-is? g0 '=) (equal? (cadr g0) (list hr-lopa (caddr g0))))
               (let* ((cst (caddr g0)) (c (cadddr cst)))
                 (hr-cin! cst)
                 (subst (hr-op-at! hr-lopa cst (hr-L 'a cst)))
                 (dk-cite! 'mg-ltrans-const 'G 'a c)
                 (ass)))
              ;; commutation with right translations
              (#t
               (let* ((rbu (cadr (cadr g0))) (u (car (cadddr rbu))) (b (caddr (cadr (cadddr rbu)))))
                 (hr-cin! rbu)
                 (subst (hr-op-at! hr-lopa rbu (hr-L 'a rbu)))
                 (subst (hr-op-at! hr-lopa u (hr-L 'a u)))
                 (hr-fun! u)
                 (dk-cite! 'mg-lr-commute 'G 'a b u)
                 (ass))))))))
    (hr-avg-clauses hr-lopa))
  (dk-cite! 'haar-avg-intro 'G hr-lopa)
  (ass))
(hr-qed! 'haar-ltrans-avg)

;;; =====================================================================
;;; hr-p4.scm -- HAAR-C3 part 4: a convex combination of two averaging operators is one; every point of the
;;; convex hull of the left translates of f is A f for an averaging operator A (th-main Lemma 3.80, the
;;; "finite weighted average of translates", without a finite sum).

;;; ---- pointwise evaluation in C(G) ----
(define (hr-op? t h) (and (pair? t) (equal? (car t) (list h hr-N))))
(define (hr-find pred e)
  (cond ((pred e) e)
        ((pair? e) (let loop ((l e)) (cond ((null? l) #f) ((hr-find pred (car l))) (#t (loop (cdr l))))))
        (#t #f)))
(define (hr-eval! x)
  (let loop ((k 0))
    (let ((hit (hr-find (lambda (e) (and (pair? e) (= (length e) 2) (equal? (cadr e) x)
                                         (or (hr-op? (car e) 'VADD) (hr-op? (car e) 'ACT))))
                        (dk-goal))))
      (if (and hit (< k 40))
          (let* ((f (car hit))
                 (eqn (if (hr-op? f 'VADD)
                          (begin (hr-cin! (cadr f)) (hr-cin! (caddr f))
                                 (dk-cite! 'ck-vadd-apply hr-Mg (cadr f) (caddr f) x))
                          (begin (dk-real! (cadr f)) (hr-cin! (caddr f))
                                 (dk-cite! 'ck-act-apply hr-Mg (cadr f) (caddr f) x)))))
            (subst (hr-eqn eqn))
            (loop (+ k 1)))))))
(define (hr-type-atoms! x)
  (let walk ((e (dk-goal)))
    (cond ((and (pair? e) (= (length e) 2) (equal? (cadr e) x) (dk-asm? (hr-inCg (car e))))
           (hr-app! (car e) x))
          ((pair? e) (for-each walk e)))))
(define (hr-ext!)                        ; the focus goal (= l r), l and r in C(G): pointwise, by crs
  (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
    (hr-cin! l) (hr-cin! r) (hr-fun! l) (hr-fun! r)
    (dk-fun-ext! l r hr-Pg 'RR #f #f
      (lambda (x)
        (hr-eval! x)
        (if (hr-has-redex? (dk-goal)) (dk-lam-b!))
        (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
            (begin
              (hr-type-atoms! x)
              (let ((g1 (dk-goal))) (if (equal? (cadr g1) (caddr g1)) (rfl) (crs)))))))))

(define (hr-alls vs body) (if (null? vs) body (list (quote FORALL) (car vs) (hr-alls (cdr vs) body))))
;;; ---- dist of two convex combinations ----
(define (hr-mc t x y) (list '(VADD m) (list '(ACT m) (list '- 1 t) x) (list '(ACT m) t y)))
(define hr-nm '(NVS-METRIC-SPACE m))
(define (hr-nd u v) (list (list 'DIST hr-nm) u v))
(define (hr-mvec! v)
  (let ((t1 (list 'IN v '(VEC m))) (t2 (list 'IN v (list 'PTS hr-nm))))
    (if (not (dk-asm? t1))
        (cond ((and (pair? v) (equal? (car v) '(VADD m)))
               (hr-mvec! (cadr v)) (hr-mvec! (caddr v)) (dk-cite! 'nvs-vadd-in-vec 'm (cadr v) (caddr v)))
              ((and (pair? v) (equal? (car v) '(ACT m)))
               (dk-real! (cadr v)) (hr-mvec! (caddr v)) (dk-cite! 'nvs-act-in-vec 'm (cadr v) (caddr v)))
              (#t (error "hr-mvec!: untyped" v))))
    (if (not (dk-asm? t2)) (dk-rewrite-h! t1 '(VEC m) (list 'PTS hr-nm)))))
(define (hr-ndreal! u v) (hr-mvec! u) (hr-mvec! v) (dk-cite! 'metric-dist-real hr-nm u v))
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m)
   (hr-alls '(a b a2 b2 t) (hr-imps '((IN a (VEC m)) (IN b (VEC m)) (IN a2 (VEC m)) (IN b2 (VEC m)) (IN t RR) (<= 0 t) (<= t 1))
     (list '<= (hr-nd (hr-mc 't 'a 'b) (hr-mc 't 'a2 'b2))
               (list '+ (list '* '(- 1 t) (hr-nd 'a 'a2)) (list '* 't (hr-nd 'b 'b2))))))))))
(dk-peel!)
(dk-cite! 'nvs-metric-is-ms 'm)
(dk-cite! 'nvs-ms-pts 'm)
(let* ((w (hr-mc 't 'a 'b)) (w1 (hr-mc 't 'a2 'b)) (w2 (hr-mc 't 'a2 'b2))
       (p1 (list '* '(- 1 t) (hr-nd 'a 'a2))) (p2 (list '* 't (hr-nd 'b 'b2))))
  (hr-ndreal! w w1) (hr-ndreal! w1 w2) (hr-ndreal! w w2) (hr-ndreal! 'a 'a2) (hr-ndreal! 'b 'b2)
  (hr-ndreal! 'a2 'a) (hr-ndreal! 'b2 'b)
  (dk-real! '(- 1 t))
  (dk-have! '(<= 0 (- 1 t)) (lambda () (dk-ineq! '(<= t 1) '(IN t RR))))
  (dk-cite! 'metric-triangle hr-nm w w1 w2)
  (let* ((e1 (dk-cite! 'convex-combination-dist-point 'm 'a 'a2 'b 't))
         (e2 (dk-cite! 'convex-combination-dist-second-point 'm 'a2 'b 'b2 't))
         (_a1 (dk-cite! 'rr-abs-of-nonneg '(- 1 t)))
         (_a2 (dk-cite! 'rr-abs-of-nonneg 't))
         (_s1 (dk-cite! 'metric-sym hr-nm 'a2 'a))
         (_s2 (dk-cite! 'metric-sym hr-nm 'b2 'b))
         (e1a (dk-rewrite-h! e1 '(abs (- 1 t)) '(- 1 t)))
         (e1b (dk-rewrite-h! e1a (hr-nd 'a2 'a) (hr-nd 'a 'a2)))
         (e2a (dk-rewrite-h! e2 '(abs t) 't))
         (e2b (dk-rewrite-h! e2a (hr-nd 'b2 'b) (hr-nd 'b 'b2))))
    (dk-real! p1) (dk-real! p2)
    (let* ((v1 (dk-name! p1)) (v2 (dk-name! p2)))
      (subst (list '= p1 v1)) (subst (list '= p2 v2))
      (dk-ineq! (list '<= (hr-nd w w2) (list '+ (hr-nd w w1) (hr-nd w1 w2)))
                e1b e2b (list '= v1 p1) (list '= v2 p2)
                (list 'IN (hr-nd w w2) 'RR) (list 'IN (hr-nd w w1) 'RR) (list 'IN (hr-nd w1 w2) 'RR)
                (list 'IN v1 'RR) (list 'IN v2 'RR)))))
(hr-qed! 'nvs-dist-comb-le)

;;; ---- (1 - t) x + t y <= D for x, y <= D ----
(sp (make-wff (hr-alls '(t x y d) (hr-imps '((IN t RR) (<= 0 t) (<= t 1) (IN x RR) (IN y RR) (IN d RR) (<= x d) (<= y d))
   '(<= (+ (* (- 1 t) x) (* t y)) d)))))
(dk-peel!)
(dk-real! '(- 1 t))
(dk-have! '(<= 0 (- 1 t)) (lambda () (dk-ineq! '(<= t 1) '(IN t RR))))
(dk-cite! 'rr-mul-le-right 'x 'd '(- 1 t))
(dk-cite! 'rr-mul-le-right 'y 'd 't)
(for-each dk-real! '((* x (- 1 t)) (* d (- 1 t)) (* y t) (* d t) (* (- 1 t) x) (* t y)))
(let ((e1 (list '= '(* (- 1 t) x) '(* x (- 1 t))))
      (e2 (list '= '(* t y) '(* y t)))
      (e3 (list '= '(+ (* d (- 1 t)) (* d t)) 'd)))
  (dk-have! e1 (lambda () (crs))) (dk-have! e2 (lambda () (crs))) (dk-have! e3 (lambda () (crs)))
  (let* ((n1 (dk-name! '(* x (- 1 t)))) (n2 (dk-name! '(* d (- 1 t)))) (n3 (dk-name! '(* y t))) (n4 (dk-name! '(* d t))))
    (subst e1) (subst e2)
    (subst (list '= '(* x (- 1 t)) n1)) (subst (list '= '(* y t) n3))
    (let* ((h1 (dk-rewrite-h! (dk-rewrite-h! '(<= (* x (- 1 t)) (* d (- 1 t))) '(* x (- 1 t)) n1) '(* d (- 1 t)) n2))
           (h2 (dk-rewrite-h! (dk-rewrite-h! '(<= (* y t) (* d t)) '(* y t) n3) '(* d t) n4))
           (h3 (dk-rewrite-h! (dk-rewrite-h! e3 '(* d (- 1 t)) n2) '(* d t) n4)))
      (dk-ineq! h1 h2 h3 (list 'IN n1 'RR) (list 'IN n2 'RR) (list 'IN n3 'RR) (list 'IN n4 'RR) '(IN d RR)))))
(hr-qed! 'rr-convex-le-bound)

;;; ---- a convex combination of two averaging operators ----
(define (hr-Cop t q1 q2) (list 'VNB-LAMBDA 'hrh_ hr-Cg (hr-comb t (list q1 'hrh_) (list q2 'hrh_))))
(define hr-unit '((IN t RR) (<= 0 t) (<= t 1)))
(sp (make-wff (hr-gcst '(q1 q2 t) (append (list (list 'IN 'q1 hr-Q) (list 'IN 'q2 hr-Q)) hr-unit)
   (list 'IN (hr-Cop 't 'q1 'q2) hr-Q))))
(dk-peel!)
(hr-gnsetup!)
(dk-cite! 'ck-cont-fns-is-set hr-Mg)
(define hr-p1s (hr-avg-parts! 'q1))
(define hr-p2s (hr-avg-parts! 'q2))
(define hr-copq (hr-Cop 't 'q1 'q2))
(dk-real! '(- 1 t))
(dk-have! '(<= 0 (- 1 t)) (lambda () (dk-ineq! '(<= t 1) '(IN t RR))))
(define (hr-copq-at! u)                   ; (= (Cop u) comb(q1 u, q2 u)), u typed
  (hr-cin! u)
  (hr-cin! (hr-comb 't (list 'q1 u) (list 'q2 u)))
  (hr-op-at! hr-copq u (hr-comb 't (list 'q1 u) (list 'q2 u))))
(dk-have! (list 'IN hr-copq hr-FCC)
  (lambda () (dk-lam-type! (lambda () (let ((h (dk-di-var!))) (hr-cin! (hr-comb 't (list 'q1 h) (list 'q2 h))) (ass)))
                           (lambda () (ass)))))
(define (hr-clause q k) (list-ref (if (eq? q 'q1) hr-p1s hr-p2s) k))
(let ((cls (hr-avg-clauses hr-copq)))
  ;; 1. additivity
  (dk-have! (list-ref cls 0)
    (lambda ()
      (dk-peel!)
      (let* ((g0 (dk-goal)) (uv (cadr (cadr g0))) (u (cadr uv)) (v (caddr uv)))
        (hr-cin! uv)
        (subst (hr-eqn (hr-copq-at! uv))) (subst (hr-eqn (hr-copq-at! u))) (subst (hr-eqn (hr-copq-at! v)))
        (subst (hr-eqn (dk-apply! (hr-clause 'q1 1) u v)))
        (subst (hr-eqn (dk-apply! (hr-clause 'q2 1) u v)))
        (hr-ext!))))
  ;; 2. homogeneity
  (dk-have! (list-ref cls 1)
    (lambda ()
      (dk-peel!)
      (let* ((g0 (dk-goal)) (ru (cadr (cadr g0))) (r (cadr ru)) (u (caddr ru)))
        (hr-cin! ru)
        (subst (hr-eqn (hr-copq-at! ru))) (subst (hr-eqn (hr-copq-at! u)))
        (subst (hr-eqn (dk-apply! (hr-clause 'q1 2) r u)))
        (subst (hr-eqn (dk-apply! (hr-clause 'q2 2) r u)))
        (hr-ext!))))
  ;; 3. Lipschitz
  (dk-have! (list-ref cls 2)
    (lambda ()
      (dk-peel!)
      (let* ((g0 (dk-goal)) (u (cadr (cadr (cadr g0)))) (v (cadr (caddr (cadr g0)))))
        (subst (hr-eqn (hr-copq-at! u))) (subst (hr-eqn (hr-copq-at! v)))
        (let* ((a (list 'q1 u)) (b (list 'q2 u)) (a2 (list 'q1 v)) (b2 (list 'q2 v)))
          (for-each (lambda (z) (hr-cin! z) (hr-pm! z)) (list a b a2 b2))
          (for-each (lambda (z) (hr-cin! z) (hr-pm! z)) (list (hr-comb 't a b) (hr-comb 't a2 b2)))
          (let* ((le (dk-cite! 'nvs-dist-comb-le hr-N a b a2 b2 't))
                 (d1 (dk-apply! (hr-clause 'q1 3) u v))
                 (d2 (dk-apply! (hr-clause 'q2 3) u v)))
            (hr-dreal! a a2) (hr-dreal! b b2) (hr-dreal! u v)
            (hr-dreal! (hr-comb 't a b) (hr-comb 't a2 b2))
            (let ((bd (dk-cite! 'rr-convex-le-bound 't (hr-dst a a2) (hr-dst b b2) (hr-dst u v))))
              (dk-le-trans! (cadr le) (caddr le) (caddr bd)) (ass)))))))
  ;; 4. constants
  (dk-have! (list-ref cls 3)
    (lambda ()
      (let* ((c (dk-di-var!)) (cst (hr-const c)))
        (subst (hr-eqn (hr-copq-at! cst)))
        (subst (hr-eqn (dk-apply! (hr-clause 'q1 4) c)))
        (subst (hr-eqn (dk-apply! (hr-clause 'q2 4) c)))
        (hr-ext!))))
  ;; 5. the hull
  (dk-have! (list-ref cls 4)
    (lambda ()
      (let ((u (dk-di-var!)))
        (subst (hr-eqn (hr-copq-at! u)))
        (dk-cite! 'mg-orbit-sub-vec 'G u)
        (dk-cite! 'conv-hull-convex hr-N (hr-orb u))
        (let* ((rhs (hr-iff-rhs! (dk-cite! 'is-convex-subset hr-N (hr-hull u)))))
          (dk-split-all! (list rhs))
          (let ((cvx (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'ACT) (dk-contains? h (hr-hull u)))) "hull convexity")))
            (dk-apply! (hr-clause 'q1 5) u)
            (dk-apply! (hr-clause 'q2 5) u)
            (dk-apply! cvx (list 'q1 u) (list 'q2 u) 't)
            (ass))))))
  ;; 6. commutation with right translations
  (dk-have! (list-ref cls 5)
    (lambda ()
      (dk-peel!)
      (let* ((g0 (dk-goal)) (rbu (cadr (cadr g0))) (u (car (cadddr rbu))) (b (caddr (cadr (cadddr rbu)))))
        (hr-cin! rbu)
        (subst (hr-eqn (hr-copq-at! rbu))) (subst (hr-eqn (hr-copq-at! u)))
        (subst (hr-eqn (dk-apply! (hr-clause 'q1 6) b u)))
        (subst (hr-eqn (dk-apply! (hr-clause 'q2 6) b u)))
        (hr-cin! (list 'q1 u)) (hr-cin! (list 'q2 u))
        (subst (hr-eqn (dk-cite! 'mg-rtrans-affine 'G b (list 'q1 u) (list 'q2 u) 't)))
        (hr-cin! (hr-comb 't (hr-R b (list 'q1 u)) (hr-R b (list 'q2 u))))
        (rfl)))))
(dk-cite! 'haar-avg-intro 'G hr-copq)
(ass)
(hr-qed! 'haar-avg-comb)

;;; ---- every point of the hull is an average of f ----
(define (hr-Ssep f) (list 'SEP 'hrv_ hr-V (list 'FORSOME 'hrq_ (list 'AND (list 'IN 'hrq_ hr-Q) (list '= 'hrv_ (list 'hrq_ f))))))
(sp (make-wff (hr-gcst '(f u) (list (hr-inCg 'f) (list 'IN 'u (hr-hull 'f)))
   (list 'FORSOME 'hrq_ (list 'AND (list 'IN 'hrq_ hr-Q) (list '= 'u (list 'hrq_ 'f)))))))
(dk-peel!)
(hr-gnsetup!)
(dk-cite! 'mg-orbit-sub-vec 'G 'f)
(dk-cite! 'vec-is-set hr-N)
(define hr-S (hr-Ssep 'f))
(dk-have! (list 'SUBSET hr-S hr-V)
  (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN z hr-S))))) (ass))))
;; the orbit lies in S
(dk-have! (list 'SUBSET (hr-orb 'f) hr-S)
  (lambda ()
    (mac 'subset-def)
    (let ((z (dk-di-var!)))
      (dk-cite! 'subset-mem-fwd (hr-orb 'f) hr-V z)
      (dk-split-all! (list (hr-iff-rhs! (dk-cite! 'image-membership-iff (hr-Phi 'f) hr-Pg z))))
      (let* ((b (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'hqa_))) "the index")))
             (eq0 (dk-ctx-form (list '= (list (hr-Phi 'f) b) z))))
        (dk-lam-b-h! eq0)
        (dk-cite! 'haar-ltrans-avg 'G b)
        (hr-op-at! (hr-Lop b) 'f (hr-L b 'f))
        (in-sep! (lambda () (ass))
                 (lambda ()
                   (ew (hr-Lop b))
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-asm? (dk-goal))
                           (ass)
                           (begin
                             (subst (list '= (list (hr-Lop b) 'f) (hr-L b 'f)))
                             (subst (list '= z (hr-L b 'f)))
                             (rfl)))))))))))
;; S is convex
(dk-have! (list 'IS-CONVEX-SUBSET hr-N hr-S)
  (lambda ()
    (mac 'is-convex-subset)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-head-is? (dk-goal) 'FORALL))
            (ass)
            (let* ((ld (dk-peel!))
                   (ins (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) hr-S))) ld))
                   (u (cadr (car ins))) (v (cadr (cadr ins)))
                   (t (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld))))
              (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN u hr-S)))))
              (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN v hr-S)))))
              (let* ((q1 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h u))) "u's average")))
                     (q2 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h v))) "v's average")))
                     (cop (hr-Cop t q1 q2))
                     (cm (hr-comb t u v)))
                (hr-toC! u) (hr-toC! v)
                (hr-cin! cm)
                (hr-pm! cm)
                (dk-cite! 'haar-avg-comb 'G q1 q2 t)
                (dk-split-all! (list (dk-cite! 'haar-avg-elim 'G q1)))
                (dk-split-all! (list (dk-cite! 'haar-avg-elim 'G q2)))
                (hr-cin! (hr-comb t (list q1 'f) (list q2 'f)))
                (hr-op-at! cop 'f (hr-comb t (list q1 'f) (list q2 'f)))
                (in-sep! (lambda () (ass))
                         (lambda ()
                           (ew cop)
                           (dk-conj-close!
                             (lambda ()
                               (if (dk-asm? (dk-goal))
                                   (ass)
                                   (begin
                                     (subst (list '= (list cop 'f) (hr-comb t (list q1 'f) (list q2 'f))))
                                     (subst (list '= u (list q1 'f)))
                                     (subst (list '= v (list q2 'f)))
                                     (rfl))))))))))))))
(dk-cite! 'conv-hull-least hr-N (hr-orb 'f) hr-S)
(dk-cite! 'subset-mem-fwd (hr-hull 'f) hr-S 'u)
(dk-split-all! (dk-landed (lambda () (sep-me (list 'IN 'u hr-S)))))
(ass)
(hr-qed! 'haar-hull-rep)

;;; =====================================================================
;;; hr-p5.scm -- HAAR-C3 part 5: an affine 1-Lipschitz map of C(G) commuting with the left translations maps
;;; K(f) into K(T f); averaging operators map the right hull Kp(f) into Kp(A f); th-main Lemma 3.80: the
;;; constants in the left and right closed convex hulls of f are the same.

(define (hr-hull-setup! f)
  (hr-gnsetup!)
  (dk-cite! 'mg-orbit-sub-vec 'G f)
  (dk-cite! 'conv-hull-sub-vec hr-N (hr-orb f))
  (if (not (dk-asm? (list 'SUBSET (hr-hull f) hr-PM)))
      (dk-have! (list 'SUBSET (hr-hull f) hr-PM) (lambda () (subst (list '= hr-PM hr-V)) (ass)))))
(define (hr-hull-convexity! f)            ; the convexity clause of hull(f), landed and returned
  (dk-cite! 'conv-hull-convex hr-N (hr-orb f))
  (let ((rhs (hr-iff-rhs! (dk-cite! 'is-convex-subset hr-N (hr-hull f)))))
    (dk-split-all! (list rhs))
    (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'ACT) (dk-contains? h (hr-hull f)))) "hull convexity")))

;;; the hypotheses on T
(define (hr-T-affine tq)
  (list 'FORALL 'hru_ (list 'IMPLIES (hr-inCg 'hru_) (list 'FORALL 'hrw_ (list 'IMPLIES (hr-inCg 'hrw_)
    (list 'FORALL 'hrt_ (list 'IMPLIES '(IN hrt_ RR)
      (list '= (list tq (hr-comb 'hrt_ 'hru_ 'hrw_)) (hr-comb 'hrt_ (list tq 'hru_) (list tq 'hrw_))))))))))
(define (hr-T-lip tq)
  (list 'FORALL 'hru_ (list 'IMPLIES (hr-inCg 'hru_) (list 'FORALL 'hrw_ (list 'IMPLIES (hr-inCg 'hrw_)
    (list '<= (hr-dst (list tq 'hru_) (list tq 'hrw_)) (hr-dst 'hru_ 'hrw_)))))))
(define (hr-T-comm tq)
  (list 'FORALL 'hrb_ (list 'IMPLIES (hr-inPg 'hrb_) (list 'FORALL 'hru_ (list 'IMPLIES (hr-inCg 'hru_)
    (list '= (list tq (hr-L 'hrb_ 'hru_)) (hr-L 'hrb_ (list tq 'hru_))))))))
(define (hr-T-hyps tq) (list (list 'IN tq hr-FCC) (hr-T-affine tq) (hr-T-lip tq) (hr-T-comm tq)))

(sp (make-wff (hr-gcst '(tq) (hr-T-hyps 'tq)
   (list 'FORALL 'f (list 'IMPLIES (hr-inCg 'f) (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w (hr-K 'f))
     (list 'IN '(tq w) (hr-K '(tq f))))))))))
(dk-peel!)
(define hr-aff (hr-T-affine 'tq))
(define hr-lip (hr-T-lip 'tq))
(define hr-com (hr-T-comm 'tq))
(hr-hull-setup! 'f)
(hr-cin! '(tq f))
(hr-hull-setup! '(tq f))
(dk-cite! 'vec-is-set hr-N)
(define hr-cvT (hr-hull-convexity! '(tq f)))
(define hr-Pre (list 'SEP 'hrz_ hr-V (list 'IN '(tq hrz_) (hr-hull '(tq f)))))
(dk-have! (list 'SUBSET (hr-orb 'f) hr-Pre)
  (lambda ()
    (mac 'subset-def)
    (let ((z (dk-di-var!)))
      (dk-cite! 'subset-mem-fwd (hr-orb 'f) hr-V z)
      (dk-split-all! (list (hr-iff-rhs! (dk-cite! 'image-membership-iff (hr-Phi 'f) hr-Pg z))))
      (let* ((b (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'hqa_))) "the index")))
             (eq0 (dk-ctx-form (list '= (list (hr-Phi 'f) b) z))))
        (dk-lam-b-h! eq0)
        (in-sep! (lambda () (ass))
                 (lambda ()
                   (subst (list '= z (hr-L b 'f)))
                   (subst (hr-eqn (dk-apply! hr-com b 'f)))
                   (dk-cite! 'mg-orbit-mem 'G '(tq f) b)
                   (dk-cite! 'conv-hull-contains hr-N (hr-orb '(tq f)))
                   (dk-cite! 'subset-mem-fwd (hr-orb '(tq f)) (hr-hull '(tq f)) (hr-L b '(tq f)))
                   (ass)))))))
(dk-have! (list 'IS-CONVEX-SUBSET hr-N hr-Pre)
  (lambda ()
    (mac 'is-convex-subset)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-head-is? (dk-goal) 'FORALL))
            (begin (mac 'subset-def)
                   (let ((z (dk-di-var!)))
                     (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN z hr-Pre)))))
                     (ass)))
            (let* ((ld (dk-peel!))
                   (ins (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) hr-Pre))) ld))
                   (u (cadr (car ins))) (v (cadr (cadr ins)))
                   (t (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld))))
              (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN u hr-Pre)))))
              (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN v hr-Pre)))))
              (hr-toC! u) (hr-toC! v)
              (hr-cin! (hr-comb t u v))
              (hr-pm! (hr-comb t u v))
              (in-sep! (lambda () (ass))
                       (lambda ()
                         (subst (hr-eqn (dk-apply! hr-aff u v t)))
