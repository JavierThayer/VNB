;;; hr-p1.scm -- HAAR-C3 part 1: the opposite group and the opposite metric group.  Helpers (prefix hr-).

(define (hr-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; HR OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (hr-dump tag)
  (display ";; HR ") (display tag) (display " goal: ") (display (expression->string (dk-goal))) (newline)
  (for-each (lambda (l) (display ";; HR   open: ") (display (expression->string (dk-goal-of l))) (newline))
            (dk-open-leaves)))
(define (hr-prop! . keepers) (apply dk-only! keepers) (prop))
(define (hr-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    c))
(define (hr-eqn e) (list '= (cadr e) (caddr e)))
(define (hr-iff-rhs! iff) (dk-meta-iff-r! iff) (caddr iff))
(define (hr-has-redex? e)
  (cond ((and (pair? e) (pair? (car e)) (eq? (caar e) 'VNB-LAMBDA)) #t)
        ((pair? e) (let loop ((l e)) (and (pair? l) (or (hr-has-redex? (car l)) (loop (cdr l))))))
        (#t #f)))
(define (hr-beta-close!)                 ; beta the goal if it has a redex, then close by rfl if open
  (let ((leaf (proof-state-focus *ps*)))
    (if (hr-has-redex? (dk-goal)) (dk-lam-b!))
    (if (not (sequent-node-grounded? leaf)) (rfl))))

;;; ---- the opposite group ----
(define hr-og '(OPP-GROUP g))
(define hr-og-lam '(VNB-LAMBDA (LIST ogp_ ogq_) (CARTESIAN (CARR g) (CARR g)) ((OPR g) ogq_ ogp_)))
(define (hr-gr-st vars guards body) (forall-guarded (cons 'g vars) (cons '(IS-GROUP g) guards) body))
(define (hr-group-parts!)
  (dk-split-all! (list (hr-iff-rhs! (dk-cite! 'is-group 'g)))))

(define (hr-og-readoff! name acc val)    ; opened and closed by dk-sp-qed!, so a certified load installs it
  (dk-sp-qed! (make-wff (hr-gr-st '() '() (list '== (list acc hr-og) val)))
    (lambda ()
      (dk-peel!)
      (hr-group-parts!)
      (mac 'OPP-GROUP)
      (let loop ((k 0))
        (let ((g0 (dk-goal)))
          (if (and (< k 6) (not (alpha-equiv? (cadr g0) (caddr g0))))
              (begin
                (if (dk-isx--nth-redex? g0) (nth-r) (slot acc))
                (loop (+ k 1))))))
      (qrfl))
    name)
  (topic! name 'analysis))
(hr-og-readoff! 'opp-group-carr 'CARR '(CARR g))
(hr-og-readoff! 'opp-group-opr 'OPR hr-og-lam)
(hr-og-readoff! 'opp-group-iden 'IDEN '(IDEN g))
(hr-og-readoff! 'opp-group-inv 'INV '(INV g))

(sp (make-wff (hr-gr-st '(a b) '((IN a (CARR g)) (IN b (CARR g)))
   '(= ((OPR (OPP-GROUP g)) a b) ((OPR g) b a)))))
(dk-peel!)
(hr-group-parts!)
(subst (hr-eqn (dk-cite! 'opp-group-opr 'g)))
(hr-beta-close!)
(hr-qed! 'opp-group-opr-apply)

;;; ---- the opposite group is a group ----
(define (hr-og-opr! a b)                 ; rewrite (OPR og) a b to (OPR g) b a in the goal, typing it
  (dk-cite! 'opp-group-opr-apply 'g a b)
  (subst (list '= (list (list 'OPR hr-og) a b) (list '(OPR g) b a)))
  (dk-cite! 'group-carrier-closed-opr 'g b a))
(sp (make-wff '(FORALL g (IMPLIES (IS-GROUP g) (IS-GROUP (OPP-GROUP g))))))
(dk-peel!)
(hr-group-parts!)
(dk-cite! 'opp-group-carr 'g)
(dk-cite! 'opp-group-iden 'g)
(dk-cite! 'opp-group-inv 'g)
(dk-cite! 'opp-group-opr 'g)
(dk-have! (list 'IN hr-og-lam '(FUN (CARTESIAN (CARR g) (CARR g)) (CARR g)))
  (lambda ()
    (dk-lam-type!
      (lambda () (dk-peel!)
        (let* ((g0 (dk-goal)) (t (cadr g0)))
          (dk-cite! 'group-carrier-closed-opr 'g (cadr t) (caddr t)) (ass)))
      (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))))
(dk-have! (list 'IN (list 'OPR hr-og) '(FUN (CARTESIAN (CARR g) (CARR g)) (CARR g)))
  (lambda () (subst (list '= (list 'OPR hr-og) hr-og-lam)) (ass)))
(mac 'is-group)
(dk-isx-set!)
(dk-conj-close!
  (lambda ()
    (let ((g0 (dk-goal)))
      (cond
        ((and (dk-head-is? g0 '=) (dk-head-is? (cadr g0) 'LENGTH))
         (mac 'OPP-GROUP) (len-r)
         (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (vnb-guard (lambda () (arith)))))
        (#t
         (for-each (lambda (pr) (if (dk-contains? (dk-goal) (car pr)) (subst (list '= (car pr) (cadr pr)))))
                   (list (list (list 'CARR hr-og) '(CARR g)) (list (list 'IDEN hr-og) '(IDEN g))
                         (list (list 'INV hr-og) '(INV g))))
         (let ((h (dk-head (dk-goal))))
           (cond
             ((eq? h 'IS-ASSOCIATIVE)
              (mac 'is-associative)
              (let* ((pl (dk-peel!))
                     (vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) pl)))
                     (u (car vs)) (v (cadr vs)) (w (caddr vs)))
                (hr-og-opr! u v)
                (hr-og-opr! (list '(OPR g) v u) w)
                (hr-og-opr! v w)
                (hr-og-opr! u (list '(OPR g) w v))
                (dk-cite! 'group-assoc 'g w v u)
                (subst (list '= (list '(OPR g) (list '(OPR g) w v) u) (list '(OPR g) w (list '(OPR g) v u))))
                (rfl)))
             ((eq? h 'IS-IDENTITY)
              (mac 'is-identity)
              (let ((u (dk-di-var!)))
                (dk-cite! 'group-identity-in 'g)
                (dk-conj-close!
                  (lambda ()
                    (let ((g1 (dk-goal)))
                      (let ((a (cadr (cadr g1))) (b (caddr (cadr g1))))
                        (hr-og-opr! a b)
                        (dk-cite! 'group-left-id 'g u)
                        (dk-cite! 'group-op-right-id 'g u)
                        (ass)))))))
             ((eq? h 'HAS-INVERSES)
              (mac 'has-inverses)
              (let ((u (dk-di-var!)))
                (dk-cite! 'group-inv-in 'g u)
                (dk-conj-close!
                  (lambda ()
                    (let ((g1 (dk-goal)))
                      (let ((a (cadr (cadr g1))) (b (caddr (cadr g1))))
                        (hr-og-opr! a b)
                        (dk-cite! 'group-left-inv 'g u)
                        (dk-cite! 'group-op-right-inv 'g u)
                        (ass)))))))
             (#t (ass))))))))
  )
(hr-qed! 'opp-group-is-group)

;;; ---- the opposite metric group ----
(define hr-Mg '(METRIC-GROUP-MS G))
(define hr-Pg '(PTS (METRIC-GROUP-MS G)))
(define hr-GG '(METRIC-GROUP-GROUP G))
(define hr-Gp '(OPP-METRIC-GROUP G))
(define hr-oGG '(OPP-GROUP (METRIC-GROUP-GROUP G)))
(define (hr-gst vars guards body) (forall-guarded (cons 'G vars) (cons '(IS-METRIC-GROUP G) guards) body))
(define (hr-inPg v) (list 'IN v hr-Pg))
(define (hr-gbase!)
  (dk-cite! 'metric-group-ms-is-metric-space 'G)
  (dk-cite! 'metric-group-group-is-group 'G)
  (for-each (lambda (n) (dk-cite! n 'G)) '(mg-ms-pts mg-ms-dist mg-group-carr mg-group-opr mg-group-inv mg-group-iden)))

(sp (make-wff (hr-gst '() '() (list 'IS-GROUP-METRIC hr-Mg hr-oGG))))
(dk-peel!)
(hr-gbase!)
(dk-cite! 'opp-group-is-group hr-GG)
(dk-cite! 'opp-group-carr hr-GG)
(dk-cite! 'opp-group-inv hr-GG)
(dk-cite! 'metric-group-group-metric 'G)
(define hr-gm0 (hr-iff-rhs! (dk-cite! 'is-group-metric hr-Mg hr-GG)))
(dk-split-all! (list hr-gm0))
(mac 'is-group-metric)
(dk-conj-close!
  (lambda ()
    (for-each (lambda (pr) (if (dk-contains? (dk-goal) (car pr)) (subst (list '= (car pr) (cadr pr)))))
              (list (list (list 'CARR hr-oGG) (list 'CARR hr-GG)) (list (list 'INV hr-oGG) (list 'INV hr-GG))))
    (let ((g0 (dk-goal)))
      (cond
        ((dk-asm? g0) (ass))
        ((dk-head-is? g0 'FORALL)
         (subst (list '= (list 'CARR hr-GG) '(CARR G)))
         (subst (list '= '(CARR G) hr-Pg))
         (let* ((pl (dk-peel!))
                (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) hr-Pg))) pl)))
                (u (car vs)) (v (cadr vs))
                (e (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) pl)))
                (ml (dk-cite! 'mg-mul-cont 'G v u))
                (d (dk-skolem! (dk-apply! ml e)))
                (dcl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d) (not (dk-contains? f 'POS-RR)))) "the delta clause")))
           (ew d)
           (dk-conj-close!
             (lambda ()
               (if (dk-asm? (dk-goal))
                   (ass)
                   (let* ((pl2 (dk-peel!))
                          (ws (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) hr-Pg))) pl2)))
                          (p (car ws)) (q (cadr ws)))
                     (for-each (lambda (z) (dk-rewrite-h! (hr-inPg z) hr-Pg (list 'CARR hr-GG))) (list u v p q))
                     (dk-cite! 'opp-group-opr-apply hr-GG u v)
                     (dk-cite! 'opp-group-opr-apply hr-GG p q)
                     (subst (list '= (list (list 'OPR hr-oGG) u v) (list (list 'OPR hr-GG) v u)))
                     (subst (list '= (list (list 'OPR hr-oGG) p q) (list (list 'OPR hr-GG) q p)))
                     (subst (list '= (list 'OPR hr-GG) '(OPR G)))
                     (dk-apply! dcl q p)
                     (ass)))))))
        (#t (ass))))))
(hr-qed! 'opp-group-metric)

(sp (make-wff (hr-gst '() '() (list 'IS-METRIC-GROUP hr-Gp))))
(dk-peel!)
(dk-cite! 'opp-group-metric 'G)
(mac 'OPP-METRIC-GROUP)
(dk-cite! 'make-metric-group-is-metric-group hr-Mg hr-oGG)
(ass)
(hr-qed! 'opp-mg-is-metric-group)

(define (hr-opp-ro-setup!)
  (hr-gbase!)
  (dk-cite! 'opp-group-is-group hr-GG)
  (mac 'OPP-METRIC-GROUP))
(sp (make-wff (hr-gst '() '() (list '== (list 'CARR hr-Gp) '(CARR G)))))
(dk-peel!)
(hr-opp-ro-setup!)
(subst (hr-eqn (dk-cite! 'make-metric-group-carr hr-Mg hr-oGG)))
(subst (hr-eqn (dk-cite! 'opp-group-carr hr-GG)))
(subst (list '= (list 'CARR hr-GG) '(CARR G)))
(qrfl)
(hr-qed! 'opp-mg-carr)

(sp (make-wff (hr-gst '() '() (list '== (list 'GDIST hr-Gp) '(GDIST G)))))
(dk-peel!)
(hr-opp-ro-setup!)
(subst (hr-eqn (dk-cite! 'make-metric-group-gdist hr-Mg hr-oGG)))
(subst (list '= (list 'DIST hr-Mg) '(GDIST G)))
(qrfl)
(hr-qed! 'opp-mg-gdist)

(sp (make-wff (hr-gst '() '() (list '== (list 'OPR hr-Gp) (list 'OPR hr-oGG)))))
(dk-peel!)
(hr-opp-ro-setup!)
(subst (hr-eqn (dk-cite! 'make-metric-group-opr hr-Mg hr-oGG)))
(qrfl)
(hr-qed! 'opp-mg-opr)

(sp (make-wff (hr-gst '() '() (list '== (list 'METRIC-GROUP-MS hr-Gp) hr-Mg))))
(dk-peel!)
(dk-cite! 'opp-mg-is-metric-group 'G)
(dk-cite! 'opp-mg-carr 'G)
(dk-cite! 'opp-mg-gdist 'G)
(mac 'METRIC-GROUP-MS)
(for-each (lambda (pr) (if (dk-contains? (dk-goal) (car pr)) (subst (list '= (car pr) (cadr pr)))))
          (list (list (list 'CARR hr-Gp) '(CARR G)) (list (list 'GDIST hr-Gp) '(GDIST G))))
(qrfl)
(hr-qed! 'opp-mg-ms)

(sp (make-wff (hr-gst '() (list (list 'IS-COMPACT hr-Mg)) (list 'IS-COMPACT (list 'METRIC-GROUP-MS hr-Gp)))))
(dk-peel!)
(dk-cite! 'opp-mg-ms 'G)
(subst (list '= (list 'METRIC-GROUP-MS hr-Gp) hr-Mg))
(ass)
(hr-qed! 'opp-mg-compact)

(sp (make-wff (hr-gst '(a b) (list (hr-inPg 'a) (hr-inPg 'b))
   (list '= (list (list 'OPR hr-Gp) 'a 'b) '((OPR G) b a)))))
(dk-peel!)
(hr-gbase!)
(dk-cite! 'opp-mg-opr 'G)
(for-each (lambda (z) (dk-rewrite-h! (hr-inPg z) hr-Pg '(CARR G)) (dk-rewrite-h! (list 'IN z '(CARR G)) '(CARR G) (list 'CARR hr-GG))) '(a b))
(subst (list '= (list 'OPR hr-Gp) (list 'OPR hr-oGG)))
(dk-cite! 'opp-group-opr-apply hr-GG 'a 'b)
(subst (list '= (list (list 'OPR hr-oGG) 'a 'b) (list (list 'OPR hr-GG) 'b 'a)))
(subst (list '= (list 'OPR hr-GG) '(OPR G)))
(rfl)
(hr-qed! 'opp-mg-opr-apply)

