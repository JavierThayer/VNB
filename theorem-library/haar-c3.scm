;;; ---- l = r from |l - r| <= e for every e > 0 (the universal in context) ----
(define (hr-abs-zero-close! l r)
  (let ((x (list '- l r)))
    (dk-real! l) (dk-real! r)
    (hr-real-ab! x)
    (dk-cite! 'rr-le-all-pos-nonpos (list 'abs x))
    (dk-real! 0)
    (let ((pr (dk-cite! 'rr-abs-le-parts x 0)))
      (dk-split-all! (list pr))
      (dk-have! (list '<= l r) (lambda () (dk-ineq! (caddr pr) (list 'IN l 'RR) (list 'IN r 'RR))))
      (dk-have! (list '<= r l) (lambda () (dk-ineq! (cadr pr) (list 'IN l 'RR) (list 'IN r 'RR))))
      (hr-and! (list 'IN l 'RR) (list 'IN r 'RR))
      (hr-and! (list '<= l r) (list '<= r l))
      (dk-cite! 'rr-leq-antisymmetric l r)
      (ass))))
(define (hr-mean-real! f) (dk-split-all! (list (dk-cite! 'haar-mean-spec 'G f))) (list 'IN (hr-mean f) 'RR))

;;; ---- additivity ----
(sp (make-wff (hr-gcst '(f h) (list (hr-inCg 'f) (hr-inCg 'h))
   (list '= (hr-mean (hr-add 'f 'h)) (list '+ (hr-mean 'f) (hr-mean 'h))))))
(dk-peel!)
(hr-gnsetup!)
(define hr-h8 (hr-add 'f 'h))
(define hr-k8 (list '+ (hr-mean 'f) (hr-mean 'h)))
(hr-cin! hr-h8)
(hr-mean-real! 'f) (hr-mean-real! 'h) (hr-mean-real! hr-h8)
(dk-real! hr-k8)
(hr-real-ab! (list '- (hr-mean hr-h8) hr-k8))
(dk-have! (list 'FORALL 'e (list 'IMPLIES '(POS-RR e) (list '<= (list 'abs (list '- (hr-mean hr-h8) hr-k8)) 'e)))
  (lambda ()
    (let* ((e (dk-di-var! (lambda (g) (cadr (cadr g)))))
           (_ (di))
           (_p (begin (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e)))
           (e2 (dk-halve! e))
           (q1 (dk-skolem! (dk-cite! 'haar-avg-near 'G 'f e2)))
           (ps1 (hr-avg-parts! q1))
           (q1f (list q1 'f)) (q1g (list q1 'h)) (q1h (list q1 hr-h8)))
      (hr-cin! q1f) (hr-cin! q1g) (hr-cin! q1h)
      (let* ((q2 (dk-skolem! (dk-cite! 'haar-avg-near 'G q1g e2)))
             (ps2 (hr-avg-parts! q2))
             (a (list q2 q1f)) (b (list q2 q1g)) (u (list q2 q1h))
             (mf (hr-mean 'f)) (mg (hr-mean 'h)))
        (hr-cin! a) (hr-cin! b) (hr-cin! u)
        (hr-cst-in! mf) (hr-cst-in! mg) (hr-cst-in! hr-k8)
        (let* ((n2 (dk-ctx-form (list '<= (hr-dst b (hr-const (hr-mean q1g))) e2)))
               (_m (dk-cite! 'haar-mean-avg 'G q1 'h))
               (n2b (dk-rewrite-h! n2 (hr-mean q1g) mg))
               (n1 (dk-ctx-form (list '<= (hr-dst q1f (hr-const mf)) e2)))
               (z (dk-cite! 'haar-mean-dist-const 'G u hr-k8))
               (_a1 (dk-cite! 'haar-mean-avg 'G q2 q1h))
               (_a2 (dk-cite! 'haar-mean-avg 'G q1 hr-h8))
               (z1 (dk-rewrite-h! z (hr-mean u) (hr-mean q1h)))
               (z2 (dk-rewrite-h! z1 (hr-mean q1h) (hr-mean hr-h8)))
               (s1 (dk-apply! (list-ref ps1 1) 'f 'h))
               (z3 (dk-rewrite-h! z2 q1h (hr-add q1f q1g)))
               (s2 (dk-apply! (list-ref ps2 1) q1f q1g))
               (z4 (dk-rewrite-h! z3 (list q2 (hr-add q1f q1g)) (hr-add a b)))
               (bd (dk-cite! 'ck-dist-add-le 'G a b (hr-const mf) (hr-const mg)))
               (_c (dk-cite! 'ck-vadd-const 'G mf mg))
               (bd2 (dk-rewrite-h! bd (hr-add (hr-const mf) (hr-const mg)) (hr-const hr-k8)))
               (lp (dk-apply! (list-ref ps2 3) q1f (hr-const mf)))
               (_k (dk-apply! (list-ref ps2 4) mf))
               (lp2 (dk-rewrite-h! lp (list q2 (hr-const mf)) (hr-const mf))))
          (hr-cin! (hr-add a b))
          (for-each (lambda (pr) (hr-dreal! (car pr) (cadr pr)))
                    (list (list (hr-add a b) (hr-const hr-k8)) (list a (hr-const mf)) (list b (hr-const mg))
                          (list q1f (hr-const mf))))
          (dk-ineq! z4 bd2 lp2 n1 n2b (list '= (list '+ e2 e2) e)
                    (list 'IN (list 'abs (list '- (hr-mean hr-h8) hr-k8)) 'RR)
                    (list 'IN (hr-dst (hr-add a b) (hr-const hr-k8)) 'RR) (list 'IN (hr-dst a (hr-const mf)) 'RR)
                    (list 'IN (hr-dst b (hr-const mg)) 'RR) (list 'IN (hr-dst q1f (hr-const mf)) 'RR)
                    (list 'IN e2 'RR) (list 'IN e 'RR)))))))
(hr-abs-zero-close! (hr-mean hr-h8) hr-k8)
(hr-qed! 'haar-mean-add)

;;; ---- homogeneity ----
(sp (make-wff (hr-gcst '(c f) (list '(IN c RR) (hr-inCg 'f))
   (list '= (hr-mean (hr-act 'c 'f)) (list '* 'c (hr-mean 'f))))))
(dk-peel!)
(hr-gnsetup!)
(define hr-h9 (hr-act 'c 'f))
(define hr-k9 (list '* 'c (hr-mean 'f)))
(hr-cin! hr-h9)
(hr-mean-real! 'f) (hr-mean-real! hr-h9)
(dk-real! hr-k9)
(hr-real-ab! (list '- (hr-mean hr-h9) hr-k9))
(dk-cite! 'rr-abs-closed 'c) (dk-cite! 'rr-abs-nonneg 'c)
(dk-have! (list 'FORALL 'e (list 'IMPLIES '(POS-RR e) (list '<= (list 'abs (list '- (hr-mean hr-h9) hr-k9)) 'e)))
  (lambda ()
    (let* ((e (dk-di-var! (lambda (g) (cadr (cadr g)))))
           (_ (di))
           (_p (begin (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e)))
           (fc (dk-skolem! (dk-cite! 'rr-small-factor-real e '(abs c))))
           (_f (dk-cite! 'rr-pos-rr-in-rr fc))
           (q (dk-skolem! (dk-cite! 'haar-avg-near 'G 'f fc)))
           (ps (hr-avg-parts! q))
           (mf (hr-mean 'f))
           (qf (list q 'f)) (qh (list q hr-h9)))
      (hr-cin! qf) (hr-cin! qh)
      (hr-cst-in! mf) (hr-cst-in! hr-k9)
      (let* ((nr (dk-ctx-form (list '<= (hr-dst qf (hr-const mf)) fc)))
             (z (dk-cite! 'haar-mean-dist-const 'G qh hr-k9))
             (_a (dk-cite! 'haar-mean-avg 'G q hr-h9))
             (z1 (dk-rewrite-h! z (hr-mean qh) (hr-mean hr-h9)))
             (_s (dk-apply! (list-ref ps 2) 'c 'f))
             (z2 (dk-rewrite-h! z1 qh (hr-act 'c qf)))
             (bd (dk-cite! 'ck-dist-act-le 'G 'c qf (hr-const mf)))
             (_c (dk-cite! 'ck-act-const 'G 'c mf))
             (bd2 (dk-rewrite-h! bd (hr-act 'c (hr-const mf)) (hr-const hr-k9)))
             (dq (hr-dst qf (hr-const mf))))
        (hr-cin! (hr-act 'c qf))
        (hr-dreal! qf (hr-const mf)) (hr-dreal! (hr-act 'c qf) (hr-const hr-k9))
        (let* ((ml (dk-cite! 'rr-mul-le-right dq fc '(abs c)))
               (p1 (list '* dq '(abs c))) (p2 (list '* fc '(abs c))))
          (dk-real! p1) (dk-real! p2)
          (let* ((v1 (dk-name! p1)) (v2 (dk-name! p2))
                 (bd3 (dk-rewrite-h! bd2 p1 v1))
                 (ml2 (dk-rewrite-h! (dk-rewrite-h! ml p1 v1) p2 v2))
                 (sm (dk-rewrite-h! (dk-ctx-form (list '<= p2 e)) p2 v2)))
            (dk-ineq! z2 bd3 ml2 sm
                      (list 'IN (list 'abs (list '- (hr-mean hr-h9) hr-k9)) 'RR)
                      (list 'IN (hr-dst (hr-act 'c qf) (hr-const hr-k9)) 'RR)
                      (list 'IN v1 'RR) (list 'IN v2 'RR) (list 'IN e 'RR))))))))
(hr-abs-zero-close! (hr-mean hr-h9) hr-k9)
(hr-qed! 'haar-mean-act)

;;; ---- positivity ----
(sp (make-wff (hr-gcst '(f) (list (hr-inCg 'f) (list 'FORALL 'hrx_ (list 'IMPLIES (hr-inPg 'hrx_) '(<= 0 (f hrx_)))))
   (list '<= 0 (hr-mean 'f)))))
(dk-peel!)
(hr-gnsetup!)
(define hr-pos8 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'hrx_))) "the positivity hypothesis"))
(define hr-nb8 (list 'CK-NORM hr-Mg 'f))
(dk-split-all! (list (dk-cite! 'ck-norm-real hr-Mg 'f)))
(hr-fun! 'f)
(define hr-up8 (dk-cite! 'ck-norm-upper hr-Mg 'f))
(hr-cst-in! hr-nb8)
(hr-mean-real! 'f)
(hr-ptw-le! 'f (hr-const hr-nb8) hr-nb8
  (lambda (x)
    (hr-app! 'f x)
    (dk-apply! hr-pos8 x)
    (dk-apply! hr-up8 x)
    (dk-cite! 'rr-abs-of-nonneg (list 'f x))
    (let ((leaf (proof-state-focus *ps*)))
      (dk-lam-b!)
      (if (not (sequent-node-grounded? leaf))
          (let ((ab (dk-rewrite-h! (dk-ctx-form (list '<= (list 'abs (list 'f x)) hr-nb8)) (list 'abs (list 'f x)) (list 'f x))))
            (hr-abs-by-parts! (list '- (list 'f x) hr-nb8) hr-nb8
                              (list ab (list '<= 0 (list 'f x)) (list '<= 0 hr-nb8) (list 'IN (list 'f x) 'RR))))))))
(define hr-pd8 (dk-ctx-form (list '<= (hr-dst 'f (hr-const hr-nb8)) hr-nb8)))
(let* ((z (dk-cite! 'haar-mean-dist-const 'G 'f hr-nb8)))
  (hr-dreal! 'f (hr-const hr-nb8))
  (hr-real-ab! (list '- (hr-mean 'f) hr-nb8))
  (let ((pr (dk-cite! 'rr-abs-le-parts (list '- (hr-mean 'f) hr-nb8) (hr-dst 'f (hr-const hr-nb8)))))
    (dk-split-all! (list pr))
    (dk-ineq! (cadr pr) hr-pd8 (list 'IN (hr-mean 'f) 'RR) (list 'IN hr-nb8 'RR)
              (list 'IN (hr-dst 'f (hr-const hr-nb8)) 'RR))))
(hr-qed! 'haar-mean-nonneg)

;;; ---- the Haar mean is a Haar integral ----
(define hr-mu (list 'VNB-LAMBDA 'hrm_ hr-Cg (hr-mean 'hrm_)))
(define (hr-mu-done! thm . args)         ; beta the mu applications of the goal (args typed), then cite THM
  (let ((leaf (proof-state-focus *ps*)))
    (dk-lam-b!)
    (if (not (sequent-node-grounded? leaf))
        (let ((e (apply dk-cite! thm 'G args)))
          (if (not (sequent-node-grounded? leaf)) (ass))))))
(sp (make-wff (hr-gcst '() '() (list 'IS-HAAR-INTEGRAL 'G hr-mu))))
(dk-peel!)
(hr-gnsetup!)
(dk-cite! 'ck-cont-fns-is-set hr-Mg)
(mac 'is-haar-integral)
(dk-conj-close!
  (lambda ()
    (let ((g0 (dk-goal)))
      (cond
        ((dk-asm? g0) (ass))
        ((dk-head-is? g0 'IS-POSITIVE-FUNCTIONAL)
         (mac 'is-positive-functional)
         (dk-conj-close!
           (lambda ()
             (let ((g1 (dk-goal)))
               (cond
                 ((dk-asm? g1) (ass))
                 ((dk-head-is? g1 'IN)
                  (dk-lam-type! (lambda () (let ((h (dk-di-var!))) (hr-mean-real! h) (ass))) (lambda () (ass))))
                 ((dk-contains? g1 '<=)
                  (let* ((ld (dk-peel!))
                         (f (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) hr-Cg))) ld))))
                    (hr-mu-done! 'haar-mean-nonneg f)))
                 ((dk-contains? g1 '+)
                  (dk-peel!)
                  (let* ((lam (cadr (cadr (dk-goal)))) (body (cadddr lam)) (f (car (cadr body))) (g (car (caddr body))))
                    (dk-cite! 'rmc-cont-fns-add hr-Mg f g)
                    (hr-mean-real! f) (hr-mean-real! g)
                    (let ((leaf (proof-state-focus *ps*)))
                      (dk-lam-b!)
                      (dk-cite! 'ck-vadd-readoff hr-Mg f g)
                      (subst (list '= lam (hr-add f g)))
                      (hr-cin! (hr-add f g))
                      (dk-cite! 'haar-mean-add 'G f g)
                      (ass))))
                 (#t
                  (dk-peel!)
                  (let* ((lam (cadr (cadr (dk-goal)))) (body (cadddr lam)) (c (cadr body)) (f (car (caddr body))))
                    (dk-cite! 'rmc-cont-fns-scale hr-Mg c f)
                    (hr-mean-real! f)
                    (dk-lam-b!)
                    (dk-cite! 'ck-act-readoff hr-Mg c f)
                    (subst (list '= lam (hr-act c f)))
                    (hr-cin! (hr-act c f))
                    (dk-cite! 'haar-mean-act 'G c f)
                    (ass))))))))
        ((dk-head-is? g0 '=)
         (hr-cst-in! 1)
         (hr-mu-done! 'haar-mean-const 1))
        (#t
         (let* ((ld (dk-peel!))
                (a (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) hr-Pg))) ld)))
                (f (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) hr-Cg))) ld))))
           (hr-cin! (hr-L a f))
           (hr-mu-done! 'haar-mean-left-inv a f)))))))
(hr-qed! 'haar-mean-is-haar-integral)

;;; =====================================================================
;;; hr-p9.scm -- HAAR-C3 part 9: uniqueness of the Haar integral (every Haar integral nu of G is the Haar
;;; mean), its right invariance, and HAAR-INTEGRAL(G) by IOTA.

;;; the clauses of IS-HAAR-INTEGRAL(G, nu), landed; returns (typing add homog pos one inv)
(define (hr-nu-parts! nu)
  (let ((ty (list 'IN nu (list 'FUN hr-Cg 'RR))))
    (if (not (dk-asm? ty))
        (begin
          (dk-split-all! (list (hr-iff-rhs! (dk-cite! 'is-haar-integral 'G nu))))
          (dk-split-all! (list (hr-iff-rhs! (dk-cite! 'is-positive-functional hr-Mg nu))))))
    (list ty
          (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nu) (dk-contains? h 'pfg_))) "nu additive")
          (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nu) (dk-contains? h 'pfc_))) "nu homogeneous")
          (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nu) (dk-contains? h 'pfx_))) "nu positive")
          (list '= (list nu (hr-const 1)) 1)
          (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nu) (dk-contains? h 'hia_))) "nu invariant"))))
(define (hr-nuv! nu u)                   ; (IN (nu u) RR), u typed in C(G)
  (let ((ty (list 'IN (list nu u) 'RR)))
