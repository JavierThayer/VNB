(dk-peel!)
(hr-gnsetup!)
(dk-cite! 'ck-cont-fns-is-set hr-Mg)
(dk-cite! 'haar-mean-is-haar-integral 'G)
(define hr-mu-parts (hr-nu-parts! hr-mu))
(mac 'HAAR-INTEGRAL)
(define hr-io9 (hr-find (lambda (e) (dk-head-is? e 'IOTA)) (dk-goal)))
(for-each
  (lambda (k)
    (dk-focus! k)
    (if (dk-head-is? (dk-goal) 'FORSOME)
        (begin
          (ew hr-mu)
          (for-each
            (lambda (l)
              (dk-focus! l)
              (if (dk-head-is? (dk-goal) 'FORALL)
                  (let* ((ld (dk-peel!))
                         (y (if (equal? (cadr (dk-goal)) hr-mu) (caddr (dk-goal)) (cadr (dk-goal)))))
                    (hr-nu-parts! y)
                    (dk-fun-ext! (cadr (dk-goal)) (caddr (dk-goal)) hr-Cg 'RR #f #f
                      (lambda (x)
                        (hr-mean-real! x)
                        (dk-cite! 'haar-integral-unique 'G y x)
                        (let ((leaf (proof-state-focus *ps*)))
                          (dk-lam-b!)
                          (if (not (sequent-node-grounded? leaf))
                              (begin (subst (list '= (list y x) (hr-mean x))) (rfl)))))))
                  (ass)))
            (dk-opened (lambda () (di)))))
        (ass)))
  (dk-opened (lambda () (iota-d hr-io9))))
(hr-qed! 'haar-integral-is-haar)

