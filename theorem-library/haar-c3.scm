  (hr-cin! (hr-R 'b 'f))
  (dk-cite! 'haar-mean-opp 'G (hr-R 'b 'f))
  (dk-cite! 'haar-mean-opp 'G 'f)
  (subst (list '= (hr-mean (hr-R 'b 'f)) (list 'HAAR-MEAN hr-Gp (hr-R 'b 'f))))
  (subst (list '= (hr-mean 'f) (list 'HAAR-MEAN hr-Gp 'f)))
