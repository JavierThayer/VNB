;;; ca51-compact-laws.scm -- compact SUBSETS of a metric space through cluster points
;;; (CA-51, 2026-10-26).  Destination: theorem-library/ca51-compact-laws.scm, library analysis.
;;;
;;; A subset A of a metric space s is compact when IS-COMPACT(SUBSPACE-MS(s, A)).  Through
;;; compact-iff-cluster-point, that is: every sequence in A has a cluster point (in s) lying in A.
;;;
;;;   lc5-cluster-to-subspace     a cluster point in s of a sequence in A, lying in A, is one in A
;;;   lc5-cluster-from-subspace   and back
;;;   lc5-compact-subset-cluster  A compact ==> every sequence in A has a cluster point in A
;;;   lc5-cluster-compact-subset  the converse
;;;   lc5-frequent-cluster        A compact, f frequently in A ==> f has a cluster point in A
;;;   lc5-frequent-pigeonhole     f frequently in the union of F(0), ..., F(n) ==> frequently in one F(i)
;;;   compact-finite-union        F(0), ..., F(n) compact ==> their union is compact      (target 1)
;;;   compact-union-two           A, B compact ==> A u B compact                          (target 1)
;;;   closed-in-compact-subset    A closed, A subset C, C compact ==> A compact           (target 1)
;;;
;;; Helper prefix lc5-.  Library: analysis.
;;; LOAD WINDOW: lo = after theorem-library/riesz-markov-model (load.scm:3048, rmm-nn-choice);
;;; the other citations load earlier (metric-subspace-laws 1482: subspace-*, closed-limit-in;
;;; rake-compact-equivalences 2607: compact-iff-cluster-point).  hi = before ca51-exhaustion.
;;; Needs structure-library/ca51-vocab only through the files after it (no vocabulary here).
;;; ======================================================================
(define (lc5-set! t)
  (if (not (dk-asm? (list 'IN t 'SET)))
      (dk-have! (list 'IN t 'SET) (lambda () (dk-sethood! t)))))
(define (lc5-sub s ds) (list 'SUBSPACE-MS s ds))
;; a + b in NN, from a in NN and b in NN in context (nn-add-closed has a CONJUNCTIVE antecedent)
(define (lc5-nn-add! a b)
  (if (not (dk-asm? (list 'IN (list '+ a b) 'NN)))
      (begin
        (if (not (dk-asm? (list 'AND (list 'IN a 'NN) (list 'IN b 'NN))))
            (dk-have! (list 'AND (list 'IN a 'NN) (list 'IN b 'NN)) (lambda () (dk-conj-close!))))
        (fact 'nn-add-closed a b))))
;; (PTS (SUBSPACE-MS s ds)) == ds in context (ds a set in context)
(define (lc5-subpts! s ds)
  (lc5-set! ds)
  (dk-cite! 'subspace-pts s ds))

;;; ======================================================================
;;; (1) cluster points and subspaces
;;; ======================================================================
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s)
  (FORALL ds (IMPLIES (SUBSET ds (PTS s))
    (FORALL f (IMPLIES (IN f (FUN NN ds))
      (FORALL xc (IMPLIES (IN xc ds)
        (IMPLIES (CLUSTER-POINT s f xc) (CLUSTER-POINT (SUBSPACE-MS s ds) f xc))))))))))))
(dk-peel!)
(define lc5-1-sub '(SUBSPACE-MS s ds))
(lc5-subpts! 's 'ds)
(fact 'subspace-is-metric-space 's 'ds)
(let* ((ci (dk-cite! 'cluster-point 's 'f 'xc)))
  (dk-have! (caddr ci) (lambda () (prop)))
  (dk-split-all! (list (caddr ci))))
(let* ((ci2 (dk-cite! 'cluster-point lc5-1-sub 'f 'xc))
       (rhs (caddr ci2))
       (clu (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm '(DIST s)))) "the cluster clause")))
  (dk-have! rhs
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (ass))
                  ((dk-head-is? g 'IN) (subst (list '== (list 'PTS lc5-1-sub) 'ds)) (ass))
                  (#t
                   (let* ((landed (dk-peel!))
                          (eps (dk-landed-eps landed))
                          (m (dk-landed-var landed 'NN)))
                     (let ((n (dk-skolem! (dk-apply! clu eps m))))
                       (dk-split-all!)
                       (ew n)
                       (fact 'fun-apply-type-c 'f 'NN 'ds n)
                       (dk-cite! 'subspace-dist 's 'ds (list 'f n) 'xc)
                       (dk-conj-close!
                         (lambda ()
                           (let ((g2 (dk-goal)))
                             (if (dk-asm? g2) (ass)
                                 (begin
                                   (subst (list '= (list (list 'DIST lc5-1-sub) (list 'f n) 'xc)
                                                (list (list 'DIST 's) (list 'f n) 'xc)))
                                   (ass)))))))))))))))
  (prop))
(qed 'lc5-cluster-to-subspace)
(topic! 'lc5-cluster-to-subspace 'topology)

(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s)
  (FORALL ds (IMPLIES (SUBSET ds (PTS s))
    (FORALL f (FORALL xc
      (IMPLIES (CLUSTER-POINT (SUBSPACE-MS s ds) f xc)
               (AND (IN xc ds) (CLUSTER-POINT s f xc)))))))))))
(dk-peel!)
(define lc5-2-sub '(SUBSPACE-MS s ds))
(lc5-subpts! 's 'ds)
(let* ((ci (dk-cite! 'cluster-point lc5-2-sub 'f 'xc)))
  (dk-have! (caddr ci) (lambda () (prop)))
