(dk-rewrite-h! (list 'IN 'f (list 'FUN 'NN (list 'PTS lc5-2-sub))) (list 'PTS lc5-2-sub) 'ds)
(dk-rewrite-h! (list 'IN 'xc (list 'PTS lc5-2-sub)) (list 'PTS lc5-2-sub) 'ds)
(fact 'fun-codomain-superset 'f 'NN 'ds '(PTS s))
(fact 'subset-mem-fwd 'ds '(PTS s) 'xc)
(let* ((ci2 (dk-cite! 'cluster-point 's 'f 'xc))
       (rhs (caddr ci2))
       (clu (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm (list 'DIST lc5-2-sub)))) "the cluster clause")))
  (dk-have! rhs
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (ass))
                  (#t
                   (let* ((landed (dk-peel!))
                          (eps (dk-landed-eps landed))
                          (m (dk-landed-var landed 'NN)))
                     (let ((n (dk-skolem! (dk-apply! clu eps m))))
                       (dk-split-all!)
                       (ew n)
                       (fact 'fun-apply-type-c 'f 'NN 'ds n)
                       (dk-cite! 'subspace-dist 's 'ds (list 'f n) 'xc)
                       (dk-conj-close!
                         (lambda ()
                           (let ((g2 (dk-goal)))
                             (if (dk-asm? g2) (ass)
                                 (begin
                                   (subst (list '= (list (list 'DIST 's) (list 'f n) 'xc)
                                                (list (list 'DIST lc5-2-sub) (list 'f n) 'xc)))
                                   (ass)))))))))))))))
  (dk-have! '(CLUSTER-POINT s f xc) (lambda () (prop)))
  (dk-conj-close!))
(qed 'lc5-cluster-from-subspace)
(topic! 'lc5-cluster-from-subspace 'topology)

;;; ======================================================================
;;; (2) compactness of a subset, read through cluster points in s
;;; ======================================================================
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s)
  (FORALL ds (IMPLIES (SUBSET ds (PTS s))
    (IMPLIES (IS-COMPACT (SUBSPACE-MS s ds))
      (FORALL f (IMPLIES (IN f (FUN NN ds))
        (FORSOME xc (AND (IN xc ds) (CLUSTER-POINT s f xc))))))))))))
(dk-peel!)
(define lc5-3-sub '(SUBSPACE-MS s ds))
(lc5-subpts! 's 'ds)
(fact 'subspace-is-metric-space 's 'ds)
(let* ((ciff (dk-cite! 'compact-iff-cluster-point lc5-3-sub))
       (call (caddr ciff)))
  (dk-have! call (lambda () (prop)))
  (dk-have! (list 'IN 'f (list 'FUN 'NN (list 'PTS lc5-3-sub)))
    (lambda () (subst (list '== (list 'PTS lc5-3-sub) 'ds)) (ass)))
  (let* ((xc (dk-skolem! (dk-apply! call 'f)))
         (r (dk-cite! 'lc5-cluster-from-subspace 's 'ds 'f xc)))
    (dk-split-all! (list r))
    (ew xc)
    (dk-conj-close!)))
