(define lc5-4-hyp (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'CLUSTER-POINT))) "the cluster hypothesis"))
(let* ((ciff (dk-cite! 'compact-iff-cluster-point lc5-4-sub))
