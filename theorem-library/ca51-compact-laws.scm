;;; ======================================================================
;;; (3) a sequence FREQUENTLY in a compact set has a cluster point in it
;;;     (the terms in the set are chosen by countable choice, rmm-nn-choice, and
;;;     a cluster point of the chosen sequence is one of the given sequence)
;;; ======================================================================
;;; countable choice through rmm-nn-choice, the driver of ca5-choose-seq! / ca5-seq-at!
;;; (ca5-function-spaces.scm); WITNESS-OF returns (w . CLOSER), CLOSER closing the
;;; SEP condition at w.
(define lc5-seq-family '())
(define (lc5-choose-seq! A Pf witness-of)
  (let* ((lfam (list 'VNB-LAMBDA 'lc5k_ 'NN (list 'SEP 'lc5w_ A (Pf 'lc5k_ 'lc5w_))))
         (inh (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
                (list 'FORSOME 'w (list 'AND (list 'IN 'w A) (list 'IN 'w (list lfam 'k))))))))
    (dk-have! inh
      (lambda ()
        (let* ((k (dk-di-var!)))
          (dk-lam-b!)
          (let* ((wc (witness-of k)) (w (car wc)) (closer (cdr wc)))
            (ew w)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (caddr (dk-goal)) 'SEP)
                    (for-each (lambda (lv)
                                (if (memq lv (dk-open-leaves))
                                    (begin (dk-focus! lv)
                                           (if (dk-asm? (dk-goal)) (ass) (closer)))))
                              (dk-opened (lambda () (sep-mi))))
                    (ass))))))))
    (let ((g (dk-skolem! (dk-cite! 'rmm-nn-choice A lfam))))
      (set! lc5-seq-family (cons (cons g lfam) lc5-seq-family))
      g)))
(define (lc5-seq-at! g k)
  (let* ((lfam (cdr (assq g lc5-seq-family)))
         (cl (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IN (list g 'k) (list lfam 'k))))))
         (h  (dk-apply! (or cl (error "lc5-seq-at!: the choice clause is not in context" g)) k)))
    (dk-lam-b-h! h)
    (let ((m (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list g k))
                                       (dk-head-is? (caddr f) 'SEP)))
                      "the chosen membership")))
      (dk-split-all! (dk-landed (lambda () (sep-me m)))))))

(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s)
  (FORALL ds (IMPLIES (SUBSET ds (PTS s))
    (IMPLIES (IS-COMPACT (SUBSPACE-MS s ds))
      (FORALL sq (IMPLIES (IN sq (FUN NN (PTS s)))
        (IMPLIES (FORALL k (IMPLIES (IN k NN) (FORSOME j (AND (IN j NN) (AND (<= k j) (IN (sq j) ds))))))
          (FORSOME xc (AND (IN xc ds) (CLUSTER-POINT s sq xc)))))))))))))
(dk-peel!)
(lc5-set! 'ds)
(define lc5-5-freq (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'sq) (dk-contains? fm 'ds))) "the frequency hypothesis"))
(let* ((h (lc5-choose-seq! 'ds
            (lambda (k w) (list 'FORSOME 'lc5j_ (list 'AND '(IN lc5j_ NN) (list 'AND (list '<= k 'lc5j_) (list '= w '(sq lc5j_))))))
            (lambda (k)
              (let ((j (dk-skolem! (dk-apply! lc5-5-freq k))))
                (dk-split-all!)
                (cons (list 'sq j)
                      (lambda ()
                        (ew j)
                        (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))))))
       (r (dk-cite! 'lc5-compact-subset-cluster 's 'ds h))
       (xc (dk-skolem! r)))
  (dk-split-all!)
  (fact 'subset-mem-fwd 'ds '(PTS s) xc)
  (let* ((ci (dk-cite! 'cluster-point 's h xc)))
    (dk-have! (caddr ci) (lambda () (prop)))
    (dk-split-all! (list (caddr ci))))
  (let* ((cluh (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm '(DIST s)) (dk-contains? fm h))) "the cluster clause of the chosen sequence"))
         (ci2 (dk-cite! 'cluster-point 's 'sq xc)))
    (dk-have! (caddr ci2)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (let* ((landed (dk-peel!))
                       (eps (dk-landed-eps landed))
                       (m (dk-landed-var landed 'NN))
                       (n (dk-skolem! (dk-apply! cluh eps m))))
                  (dk-split-all!)
                  (lc5-seq-at! h n)
                  (let* ((ex (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm (list h n)))) "the index of the chosen term"))
                         (j (dk-skolem! ex)))
                    (dk-split-all!)
                    (ew j)
                    (dk-conj-close!
                      (lambda ()
                        (let ((g (dk-goal)))
                          (cond ((dk-asm? g) (ass))
                                ((dk-head-is? g '<=) (dk-nn! (list '<= m n) (list '<= n j)))
                                (#t (subst (list '= (list 'sq j) (list h n))) (ass)))))))))))))
    (dk-have! (list 'CLUSTER-POINT 's 'sq xc) (lambda () (prop)))
    (ew xc)
    (dk-conj-close!)))
(qed 'lc5-frequent-cluster)
(topic! 'lc5-frequent-cluster 'topology)

;;; ======================================================================
;;; (4) pigeonhole: a sequence frequently in the union of fy(0), ..., fy(n) is
;;;     frequently in one fy(i).  Induction on n; no set is formed.
;;; ======================================================================
;; the innermost membership (IN (sq j) (fy i)) of a formula: its sequence and family heads
(define (lc5-inner-in fm)
  (cond ((not (pair? fm)) #f)
        ((and (eq? (car fm) 'IN) (= (length fm) 3) (pair? (cadr fm)) (pair? (caddr fm))
              (= (length (cadr fm)) 2) (= (length (caddr fm)) 2)
              (symbol? (car (cadr fm))) (symbol? (car (caddr fm))))
         fm)
        (#t (let loop ((xs (cdr fm)))
              (cond ((null? xs) #f)
                    ((lc5-inner-in (car xs)) => (lambda (r) r))
                    (#t (loop (cdr xs))))))))
;; naive replacement of the symbol V by the term T (V is not rebound inside FM)
(define (lc5-replace fm v t)
  (cond ((eq? fm v) t)
        ((pair? fm) (map (lambda (x) (lc5-replace x v t)) fm))
        (#t fm)))

(sp (make-wff '(FORALL n (IMPLIES (IN n NN)
  (FORALL fy (FORALL sq
    (IMPLIES (FORALL k (IMPLIES (IN k NN) (FORSOME j (AND (IN j NN) (AND (<= k j)
               (FORSOME i (AND (IN i NN) (AND (<= i n) (IN (sq j) (fy i))))))))))
      (FORSOME i (AND (IN i NN) (AND (<= i n)
        (FORALL k (IMPLIES (IN k NN) (FORSOME j (AND (IN j NN) (AND (<= k j) (IN (sq j) (fy i)))))))))))))))))
(ni)
(fact 'nn-zero-in)
(for-each
 (lambda (leaf)
   (dk-focus! leaf)
   (if (not (dk-contains? (dk-goal) 'succ))
       ;; the base: i = 0
       (let* ((landed (dk-peel!))
              (hh (car (filter (dk-head? 'FORALL) landed)))
              (in (lc5-inner-in (dk-goal)))
              (sq (car (cadr in)))
              (fy (car (caddr in))))
         (ew 0)
         (dk-conj-close!
           (lambda ()
             (let ((g (dk-goal)))
               (cond ((dk-asm? g) (ass))
                     ((dk-head-is? g '<=) (dk-nn!))
                     (#t
                      (let* ((k2 (dk-di-var!))
                             (j (dk-skolem! (dk-apply! hh k2)))
                             (_ (dk-split-all!))
                             (i (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm (list sq j)))) "the index"))))
                        (dk-split-all!)
                        (fact 'nn-le-zero-is-zero i)
                        (ew j)
                        (dk-conj-close!
                          (lambda ()
                            (if (dk-asm? (dk-goal)) (ass)
                                (begin (subst (list '= 0 i)) (ass)))))))))))
       ;; the step
       (let* ((landed (dk-peel!))
              (k (dk-landed-var landed 'NN))
              (sk (list 'succ k))
              (ih (car (filter (lambda (fm) (and (dk-head-is? fm 'FORALL) (not (dk-contains? fm 'succ)))) landed)))
              (hh (car (filter (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'succ))) landed)))
              (goal (dk-goal))
              (iv (cadr goal))
              (cl (caddr (caddr (caddr goal))))
              (q (lc5-replace cl iv sk))
              (in (lc5-inner-in goal))
              (sq (car (cadr in)))
              (fy (car (caddr in))))
         (fact 'nn-succ-closed k)
         (use-em q
           (lambda ()
             (ew sk)
             (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-nn!)))))
           (lambda ()
             (let* ((nq (list 'NOT q))
                    (ex (car (dk-landed (lambda () (push-not-h nq)))))
                    (k0 (dk-skolem! ex))
                    (ne (dk-pick (lambda (fm) (and (dk-head-is? fm 'NOT) (dk-contains? fm k0))) "no term past k0"))
                    (c0 (car (dk-landed (lambda () (push-not-h ne)))))
                    (ch (inst*! ih fy sq))
                    (b (dk-chain! ch
                         (lambda (ante)
                           (lambda ()
                             (let* ((k2 (dk-di-var!))
                                    (t (list '+ k2 k0)))
                               (lc5-nn-add! k2 k0)
                               (let* ((j (dk-skolem! (dk-apply! hh t)))
                                      (_ (dk-split-all!))
                                      (i (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm (list sq j)))) "the index"))))
                                 (dk-split-all!)
                                 (fact 'nn-le-succ-cases k i)
                                 (dk-have! (list 'NOT (list '= i sk))
                                   (lambda ()
                                     (di)
                                     (dk-have! (list 'IN (list sq j) (list fy sk)) (lambda () (subst (list '= sk i)) (ass)))
                                     (dk-have! (list '<= k0 j) (lambda () (dk-nn! (list '<= t j))))
                                     (let ((c (dk-apply! c0 j)))
                                       (dk-only! c (list '<= k0 j) (list 'IN (list sq j) (list fy sk)))
                                       (prop))))
                                 (dk-have! (list '<= i k)
                                   (lambda ()
                                     (dk-only! (list 'OR (list '<= i k) (list '= i sk)) (list 'NOT (list '= i sk)))
                                     (prop)))
                                 (ew j)
                                 (dk-conj-close!
                                   (lambda ()
                                     (let ((g (dk-goal)))
                                       (cond ((dk-asm? g) (ass))
                                             ((dk-head-is? g '<=) (dk-nn! (list '<= t j)))
                                             (#t (ew i) (dk-conj-close!)))))))))))))
               (let ((i2 (dk-skolem! b)))
                 (dk-split-all!)
                 (ew i2)
                 (dk-conj-close!
                   (lambda ()
                     (if (dk-asm? (dk-goal)) (ass) (dk-nn! (list '<= i2 k)))))))))))))
 (dk-open-leaves))
(qed 'lc5-frequent-pigeonhole)
(topic! 'lc5-frequent-pigeonhole 'plumbing)

;;; ======================================================================
;;; (5) TARGET 1: a finite union of compact sets is compact
;;; ======================================================================
(sp (make-wff '(FORALL n (IMPLIES (IN n NN)
  (FORALL s (IMPLIES (IS-METRIC-SPACE s)
    (FORALL fy
      (IMPLIES (FORALL i (IMPLIES (IN i NN) (IMPLIES (<= i n) (SUBSET (fy i) (PTS s)))))
        (IMPLIES (FORALL i (IMPLIES (IN i NN) (IMPLIES (<= i n) (IS-COMPACT (SUBSPACE-MS s (fy i))))))
          (IS-COMPACT (SUBSPACE-MS s
            (SEP ucy_ (PTS s) (FORSOME uci_ (AND (IN uci_ NN) (AND (<= uci_ n) (IN ucy_ (fy uci_)))))))))))))))))
(dk-peel!)
(fact 'nn-zero-in)
(define lc5-7-U (caddr (cadr (dk-goal))))
(define lc5-7-hsub (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'SUBSET))) "the subset hypothesis"))
(define lc5-7-hcmp (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-COMPACT))) "the compactness hypothesis"))
(dk-have! (list 'SUBSET lc5-7-U '(PTS s))
  (lambda ()
    (let ((z (subset-by-element!)))
      (sep-me (list 'IN z lc5-7-U))
      (ass))))
(let ((ch (dk-cite! 'lc5-cluster-compact-subset 's lc5-7-U)))
  (dk-chain! ch
    (lambda (ante)
      (lambda ()
        (let ((f (dk-di-var!)))
          (fact 'fun-codomain-superset f 'NN lc5-7-U '(PTS s))
          (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORSOME 'j (list 'AND '(IN j NN) (list 'AND '(<= k j)
                      (list 'FORSOME 'i (list 'AND '(IN i NN) (list 'AND '(<= i n) (list 'IN (list f 'j) '(fy i))))))))))
            (lambda ()
              (let ((k (dk-di-var!)))
                (fact 'fun-apply-type-c f 'NN lc5-7-U k)
                (sep-me (list 'IN (list f k) lc5-7-U))
                (let ((i (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm (list f k)))) "the piece"))))
                  (ew k)
                  (dk-conj-close!
                    (lambda ()
                      (let ((g (dk-goal)))
                        (cond ((dk-asm? g) (ass))
                              ((dk-head-is? g '<=) (dk-nn!))
                              (#t (ew i) (dk-conj-close!))))))))))
          (let* ((b (dk-cite! 'lc5-frequent-pigeonhole 'n 'fy f))
                 (i (dk-skolem! b)))
            (dk-split-all!)
            (let* ((fr (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm (list 'fy i)))) "frequently in the piece"))
                   (j0 (dk-skolem! (dk-apply! fr 0))))
              (dk-split-all!)
              (dk-apply! lc5-7-hsub i)
              (dk-apply! lc5-7-hcmp i)
              (let* ((r (dk-cite! 'lc5-frequent-cluster 's (list 'fy i) f))
                     (xc (dk-skolem! r)))
                (dk-split-all!)
                (fact 'subset-mem-fwd (list 'fy i) '(PTS s) xc)
                (ew xc)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-asm? (dk-goal))
                        (ass)
                        (for-each (lambda (lv)
                                    (if (memq lv (dk-open-leaves))
                                        (begin (dk-focus! lv)
                                               (if (dk-asm? (dk-goal)) (ass)
                                                   (begin (ew i) (dk-conj-close!))))))
                                  (dk-opened (lambda () (sep-mi)))))))))))))))
(ass)
(qed 'compact-finite-union)
(topic! 'compact-finite-union 'topology)

;;; A, B compact ==> A u B compact (the binary case, proved directly)
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s)
  (FORALL aa (FORALL bb
    (IMPLIES (SUBSET aa (PTS s))
      (IMPLIES (SUBSET bb (PTS s))
        (IMPLIES (IS-COMPACT (SUBSPACE-MS s aa))
          (IMPLIES (IS-COMPACT (SUBSPACE-MS s bb))
            (IS-COMPACT (SUBSPACE-MS s (UNION aa bb)))))))))))))
(dk-peel!)
(define lc5-8-U '(UNION aa bb))
(define (lc5-8-freq f st)
  (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORSOME 'j (list 'AND '(IN j NN) (list 'AND '(<= k j) (list 'IN (list f 'j) st)))))))
(define (lc5-8-close! f st)
  (let* ((r (dk-cite! 'lc5-frequent-cluster 's st f))
         (xc (dk-skolem! r)))
    (dk-split-all!)
    (dk-cite! 'union-membership 'aa 'bb xc)
    (ew xc)
    (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (prop))))))
(dk-have! (list 'SUBSET lc5-8-U '(PTS s))
  (lambda ()
    (let ((z (subset-by-element!)))
      (dk-cite! 'union-membership 'aa 'bb z)
      (fact 'subset-mem-fwd 'aa '(PTS s) z)
      (fact 'subset-mem-fwd 'bb '(PTS s) z)
      (prop))))
(let ((ch (dk-cite! 'lc5-cluster-compact-subset 's lc5-8-U)))
  (dk-chain! ch
    (lambda (ante)
      (lambda ()
        (let ((f (dk-di-var!)))
          (fact 'fun-codomain-superset f 'NN lc5-8-U '(PTS s))
          (use-em (lc5-8-freq f 'aa)
            (lambda () (lc5-8-close! f 'aa))
            (lambda ()
              (let* ((ex (car (dk-landed (lambda () (push-not-h (list 'NOT (lc5-8-freq f 'aa)))))))
                     (k0 (dk-skolem! ex))
                     (ne (dk-pick (lambda (fm) (and (dk-head-is? fm 'NOT) (dk-contains? fm k0))) "no term in aa past k0"))
                     (c0 (car (dk-landed (lambda () (push-not-h ne))))))
                (dk-have! (lc5-8-freq f 'bb)
                  (lambda ()
                    (let* ((k (dk-di-var!))
                           (t (list '+ k k0))
                           (ft (list f t)))
                      (lc5-nn-add! k k0)
                      (fact 'fun-apply-type-c f 'NN lc5-8-U t)
                      (dk-cite! 'union-membership 'aa 'bb ft)
                      (dk-have! (list '<= k0 t) (lambda () (dk-nn!)))
                      (dk-apply! c0 t)
                      (dk-have! (list 'IN ft 'bb) (lambda () (prop)))
                      (ew t)
                      (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-nn!)))))))
                (lc5-8-close! f 'bb)))))))))
(ass)
(qed 'compact-union-two)
(topic! 'compact-union-two 'topology)

;;; ======================================================================
;;; (6) TARGET 1: a closed subset of a compact subset is compact
;;; ======================================================================
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s)
  (FORALL kc (IMPLIES (SUBSET kc (PTS s))
    (IMPLIES (IS-COMPACT (SUBSPACE-MS s kc))
      (FORALL ka (IMPLIES (SUBSET ka kc)
        (IMPLIES (IS-CLOSED s ka) (IS-COMPACT (SUBSPACE-MS s ka))))))))))))
(dk-peel!)
(fact 'subset-trans 'ka 'kc '(PTS s))
(define lc5-9-sub '(SUBSPACE-MS s ka))
(lc5-subpts! 's 'ka)
(let ((ch (dk-cite! 'lc5-cluster-compact-subset 's 'ka)))
  (dk-chain! ch
    (lambda (ante)
      (lambda ()
        (let* ((f (dk-di-var!))
               (_ (fact 'fun-codomain-superset f 'NN 'ka 'kc))
               (xc (dk-skolem! (dk-cite! 'lc5-compact-subset-cluster 's 'kc f)))
               (_2 (dk-split-all!))
               (phi (dk-skolem! (dk-cite! 'cluster-point-has-convergent-subseq 's f xc)))
               (_3 (dk-split-all!))
               (fsub (list 'IN f (list 'FUN 'NN (list 'PTS lc5-9-sub)))))
          (dk-have! fsub (lambda () (subst (list '== (list 'PTS lc5-9-sub) 'ka)) (ass)))
          (dk-have! (list 'AND fsub (list 'STRICTLY-MONO-NN phi)) (lambda () (dk-conj-close!)))
          (fact 'subseq-is-fun lc5-9-sub f phi)
          (dk-rewrite-h! (list 'IN (list 'SUBSEQ f phi) (list 'FUN 'NN (list 'PTS lc5-9-sub))) (list 'PTS lc5-9-sub) 'ka)
          (dk-cite! 'closed-limit-in 's 'ka (list 'SUBSEQ f phi) xc)
          (ew xc)
          (dk-conj-close!))))))
(ass)
(qed 'closed-in-compact-subset)
(topic! 'closed-in-compact-subset 'topology)
