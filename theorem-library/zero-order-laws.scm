;;; ---------------------------------------------------------------- order 0 <=> f(a) /= 0
(sp (make-wff '(FORALL zlu_ (FORALL zlf_ (IMPLIES (HOLOMORPHIC-ON zlu_ zlf_) (FORALL zla_ (IMPLIES (IN zla_ zlu_)
  (IFF (HAS-ZERO-OF-ORDER zlu_ zlf_ zla_ 0) (NOT (= (zlf_ zla_) 0))))))))))
(let* ((new (zol-steps!)) (hh (find-first (lambda (q) (dk-head-is? q 'HOLOMORPHIC-ON)) new)) (u (cadr hh)) (f (caddr hh))
       (a (zol-var new u)) (aa (list '- a a)))
  (zol-hol-basics! u f) (zol-pt! u a) (fact 'fun-apply-type-c f u 'CC a) (zol-cc! aa)
  (dk-iff! (dk-head? 'NOT)
    (lambda ()
      (let* ((h (zol-hzo-open! (find-first (lambda (q) (dk-head-is? q 'HAS-ZERO-OF-ORDER)) (dk-asms))))
             (fx (dk-ctx-form (zol-fac u f a 0 h))))
        (dk-cite! 'holomorphic-on-in-fun u h) (fact 'fun-apply-type-c h u 'CC a)
        (subst (dk-apply! fx a))
        (subst (dk-cite! 'power-zero aa))
        (dk-have! (list '= (list '* 1 (list h a)) (list h a)) (lambda () (crs)))
        (subst (list '= (list '* 1 (list h a)) (list h a)))
        (dk-ass!)))
    (lambda ()
      (mac 'HAS-ZERO-OF-ORDER)
      (dk-conj-close!
        (lambda ()
          (cond ((dk-asm? (dk-goal)) (dk-ass!))
                ((dk-head-is? (dk-goal) 'FORSOME)
                 (ew f)
                 (dk-conj-close!
                   (lambda ()
                     (if (dk-asm? (dk-goal)) (dk-ass!)
                       (let* ((x (dk-di-var!)) (xa (list '- x a)))
                         (zol-pt! u x) (fact 'fun-apply-type-c f u 'CC x) (zol-cc! xa)
                         (subst (dk-cite! 'power-zero xa))
                         (crs))))))
                (#t (dk-ass!))))))))
(qed 'zero-order-zero-iff)

;;; ---------------------------------------------------------------- x -> (x - c)^d is holomorphic
(define (zol-pw u c d) (list 'VNB-LAMBDA 'zlx_ u (list 'power (list '- 'zlx_ c) d)))
(sp (make-wff (list 'FORALL 'zld_ (list 'IMPLIES '(IN zld_ NN) (list 'FORALL 'zlu_ (list 'IMPLIES (list 'IS-OPEN acn-nfm 'zlu_)
  (list 'FORALL 'zlc_ (list 'IMPLIES '(IN zlc_ CC) (list 'HOLOMORPHIC-ON 'zlu_ (zol-pw 'zlu_ 'zlc_ 'zld_))))))))))
(define (zol-pw-typ! u c d)
  (let ((lam (zol-pw u c d)))
    (if (not (dk-asm? (list 'IN lam (list 'FUN u 'CC))))
        (dk-have! (list 'IN lam (list 'FUN u 'CC))
          (lambda () (dk-lam-type!
                       (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                    (zol-pt! u x) (zol-cc! (list '- x c)) (zol-pow-cc! (list '- x c) d)
                                    (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
                       (lambda () (dk-ass!))))))))
(define (zol-setu! u) (dk-cite! 'cc-open-subset-cc u) (fact 'cc-is-set) (fact 'subclass-of-set-is-set u 'CC) (fact 'cc-one-in) (fact 'cc-zero-in) (fact 'nn-zero-in))
(let* ((ls (dk-open-leaves)))
  (dk-ni-fixed! '(zlu_))   ; W1G-B: zlu_ fixed; zlc_ (in CC) stays inside
  (let* ((leaves (dk-open-leaves))
         (st (find-first (lambda (l) (dk-contains? (dk-goal-of l) 'zld_)) leaves))
         (b (find-first (lambda (l) (not (eq? l st))) leaves)))
    (dk-focus! b)
    (let* ((new (zol-steps!)) (u (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) (dk-asms)))) (c (zol-var new 'CC))   ; W1G-B: u is hoisted
           (l0 (zol-pw u c 0)) (one (list 'VNB-LAMBDA 'zlx_ u 1)))
      (zol-setu! u)
      (dk-have! (list 'HOLOMORPHIC-ON u one) (lambda () (dk-holomorphic! u one)))
      (zol-pw-typ! u c 0)
      (dk-have! (list 'FORALL 'zly_ (list 'IMPLIES (list 'IN 'zly_ u) (list '== (list l0 'zly_) (list one 'zly_))))
        (lambda () (let ((x (dk-di-var!))) (zol-pt! u x) (zol-cc! (list '- x c)) (dk-lam-b!)
                     (subst (dk-cite! 'power-zero (list '- x c))) (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
      (dk-cite! 'holomorphic-transfer-ptwise-eq u l0 one)
      (dk-ass!))
    (dk-focus! st)
    (let* ((new (zol-steps!)) (u (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) (dk-asms)))) (c (zol-var new 'CC))   ; W1G-B: u is hoisted
           (d (find-first (lambda (v) (dk-contains? (dk-goal) (list 'succ v))) (map cadr (filter (lambda (q) (and (zol-op? q 'IN 3) (eq? (caddr q) 'NN))) new))))
           (ih (find-first (lambda (q) (and (zol-op? q 'FORALL 3) (dk-contains? q 'HOLOMORPHIC-ON))) new))
           (l0 (zol-pw u c d)) (l1 (zol-pw u c (list 'succ d))))
      (zol-setu! u) (fact 'nn-succ-closed d)
      (let ((hp (dk-apply! ih c)))
        (zol-pw-typ! u c d) (zol-pw-typ! u c (list 'succ d))
        (let* ((pv (dk-name! l0 (list 'FUN u 'CC)))
               (tg (list 'VNB-LAMBDA 'zlx_ u (list '* (list '- 'zlx_ c) (list pv 'zlx_)))))
          (dk-rewrite-h! hp l0 pv)
          (dk-have! (list 'FORALL 'dkdoy_ (list 'IMPLIES (list 'IN 'dkdoy_ u) (list 'IN 'dkdoy_ u))) (lambda () (dk-di-var!) (dk-ass!)))
          (dk-have! (list 'HOLOMORPHIC-ON u tg) (lambda () (dk-holomorphic! u tg)))
          (dk-have! (list 'FORALL 'zly_ (list 'IMPLIES (list 'IN 'zly_ u) (list '== (list l1 'zly_) (list tg 'zly_))))
            (lambda ()
              (let* ((x (dk-di-var!)) (xc (list '- x c)))
                (zol-pt! u x) (zol-cc! xc)
                (dk-lam-b!) (subst (list '= pv l0)) (dk-lam-b!)
                (zol-and! (list 'IN xc 'CC) (list 'IN d 'NN))
                (subst (dk-fact! 'power-succ xc d))
                (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
          (dk-cite! 'holomorphic-transfer-ptwise-eq u l1 tg)
          (dk-ass!))))))
(qed 'pow-sub-holomorphic)

;;; ---------------------------------------------------------------- the linear factor x - c: a zero of order 1 at c
(sp (make-wff (list 'FORALL 'zlu_ (list 'IMPLIES (list 'IS-OPEN acn-nfm 'zlu_) (list 'FORALL 'zlc_ (list 'IMPLIES '(IN zlc_ zlu_)
  '(HAS-ZERO-OF-ORDER zlu_ (VNB-LAMBDA zlx_ zlu_ (- zlx_ zlc_)) zlc_ 1)))))))
(let* ((new (zol-steps!)) (u (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) new))) (c (zol-var new u))
       (lin (list 'VNB-LAMBDA 'zlx_ u (list '- 'zlx_ c))) (one (list 'VNB-LAMBDA 'zlx_ u 1)))
  (zol-setu! u) (zol-pt! u c)
  (dk-have! (list 'HOLOMORPHIC-ON u lin) (lambda () (dk-holomorphic! u lin)))
  (dk-have! (list 'HOLOMORPHIC-ON u one) (lambda () (dk-holomorphic! u one)))
