             (let* ((z (dk-di-var!))
                    (_1 (acn-ball-open! 'c r z))
                    (_2 (dk-have! (list '< (list 'magnitude (list '- z 'c)) r) (lambda () (ass))))
                    (ps (dk-cite! 'holomorphic-power-series-disc 'u 'f 'c rbig r z))
                    (T3 (cadr ps))
                    (cz1 zol-6-cz))
               (fact 'fun-apply-type-c 'f 'u 'CC z)
               (fact 'cc-zero-in)
               (acn-lam-typ! T3 'NN
                 (lambda (v)
                   (let ((e (dk-apply! cz1 v)))
                     (acn-cc! (list 'power (list '- z 'c) v))
                     (dk-have! (list 'IN (cadr e) 'CC) (lambda () (subst e) (ass))))))
               (dk-have! (list 'FORALL 'acnk_ (list 'IMPLIES '(IN acnk_ NN) (list '= (list T3 'acnk_) 0)))
                 (lambda ()
                   (let* ((k (dk-di-var!)) (e (dk-apply! cz1 k)) (p (list 'power (list '- z 'c) k)))
                     (acn-cc! p)
                     (dk-lam-b!)
                     (subst e)
                     (crs))))
               (dk-cite! 'cc-series-of-zeros T3 (list 'f z))
               (ass)))))))
(qed 'holomorphic-all-orders-local)

;;; the zeros of g accumulate at a when g vanishes on a ball about a (inside u)
(define (zol-za-ball! u g a r0 vanish!)
  (let ((zi (dk-cite! 'zeros-accumulate-at u g a)))
    (dk-have! (caddr zi)
      (lambda ()
        (let* ((r (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) (zol-steps!)))))
          (fact 'rr-pos-rr-in-rr r) (fact 'rr-lt-of-pos-rr r) (fact 'rr-pos-rr-in-rr r0) (fact 'rr-lt-of-pos-rr r0)
          (let* ((w (dk-skolem! (dk-cite! 'rr-min-pos r r0) #t)) (s (list '* 1/2 w)) (x (list '+ a s)) (xa (list '- x a)))
            (dk-have! (list 'IN s 'RR) (lambda () (type-term)))
            (fact 'rr-subset-cc s) (zol-cc! x) (zol-cc! xa)
            (dk-have! (list '< 0 s) (lambda () (dk-ineq! (list '< 0 w))))
            (dk-have! (list '= xa s) (lambda () (crs)))
            (fact 'cc-magnitude-closed xa) (c6z-mag-s! xa s)
            (let* ((bm1 (dk-cite! 'cc-ms-ball-membership a r x)) (bm2 (dk-cite! 'cc-ms-ball-membership a r0 x)))
              (dk-have! (list '< (list 'magnitude xa) r) (lambda () (dk-ineq! (list '= (list 'magnitude xa) s) (list '<= w r) (list '< 0 w) (list '< 0 r))))
              (dk-have! (list '< (list 'magnitude xa) r0) (lambda () (dk-ineq! (list '= (list 'magnitude xa) s) (list '<= w r0) (list '< 0 w) (list '< 0 r0))))
              (dk-have! (list 'IN x (list 'BALL 'CC-MS a r)) (lambda () (keep bm1 (list 'IN x 'CC) (list '< (list 'magnitude xa) r)) (prop)))
              (dk-have! (list 'IN x (list 'BALL 'CC-MS a r0)) (lambda () (keep bm2 (list 'IN x 'CC) (list '< (list 'magnitude xa) r0)) (prop)))
              (fact 'subset-mem-fwd (list 'BALL 'CC-MS a r0) u x))
            (dk-have! (list 'NOT (list '= xa 0))
              (lambda () (di) (dk-have! (list '= s 0) (lambda () (subst (list '= s xa)) (dk-ass!))) (dk-absurd! (list '< 0 s) (list '= s 0))))
            (dk-have! (list 'NOT (list '= x a))
              (lambda () (di) (dk-have! (list '= xa 0) (lambda () (subst (list '= x a)) (crs))) (ai (list 'NOT (list '= xa 0)))))
            (ew x)
            (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!) (vanish! x))))))))
    (dk-have! (list 'ZEROS-ACCUMULATE-AT u g a) (lambda () (keep zi (caddr zi)) (prop)))))

;;; EXISTENCE: on a connected open u, a holomorphic f that is not identically zero has a zero of some finite
;;; order at every point of u (order 0 where f /= 0).
(sp (make-wff '(FORALL zlu_ (FORALL zlf_ (IMPLIES (IS-CONNECTED CC-MS zlu_) (IMPLIES (HOLOMORPHIC-ON zlu_ zlf_)
  (FORALL zla_ (IMPLIES (IN zla_ zlu_) (IMPLIES (FORSOME zlw_ (AND (IN zlw_ zlu_) (NOT (= (zlf_ zlw_) 0))))
    (FORSOME zlm_ (AND (IN zlm_ NN) (HAS-ZERO-OF-ORDER zlu_ zlf_ zla_ zlm_))))))))))))
(let* ((new (zol-steps!)) (hh (find-first (lambda (q) (dk-head-is? q 'HOLOMORPHIC-ON)) new)) (u (cadr hh)) (f (caddr hh))
       (a (zol-var new u)) (wx (find-first (lambda (q) (dk-head-is? q 'FORSOME)) new)) (gl (dk-goal)))
  (zol-hol-basics! u f) (zol-setu! u) (zol-pt! u a)
  (dk-cite! 'holomorphic-on-continuous u f)
  (use-em gl
    (lambda () (dk-ass!))
    (lambda ()
      (dk-have! (zol-ao u f a)
        (lambda ()
          (let* ((leaves (dk-opened (lambda () (ni))))
                 (st (find-first (lambda (l) (dk-contains? (dk-goal-of l) 'zon_)) leaves))
                 (b (find-first (lambda (l) (not (eq? l st))) leaves)))
            (dk-focus! b)
            (ew f)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (dk-ass!)
                  (let* ((x (dk-di-var!)) (xa (list '- x a)))
                    (zol-pt! u x) (fact 'fun-apply-type-c f u 'CC x) (zol-cc! xa)
                    (subst (dk-cite! 'power-zero xa)) (crs)))))
            (dk-focus! st)
            (let* ((nw (zol-steps!)) (n (zol-var nw 'NN))
                   (ih (find-first (lambda (q) (dk-head-is? q 'FORSOME)) nw))
                   (q (dk-skolem! ih #t))
                   (fq (dk-ctx-form (acn-fac-body n u f a q))))
              (dk-cite! 'holomorphic-on-in-fun u q) (dk-cite! 'holomorphic-on-continuous u q)
              (fact 'fun-apply-type-c q u 'CC a)
              (use-em (list '= (list q a) 0)
                (lambda ()
                  (let* ((dq (dk-skolem! (dk-cite! 'holomorphic-difference-quotient u q a)))
                         (dqf (find-first (lambda (g) (and (zol-op? g 'FORALL 3) (dk-contains? g dq) (dk-contains? g (list q a)))) (dk-asms))))
                    (dk-cite! 'goursat-triangle-except u dq a)
                    (dk-cite! 'morera u dq)
                    (fact 'nn-succ-closed n)
                    (ew dq)
                    (dk-conj-close!
                      (lambda ()
                        (if (dk-asm? (dk-goal)) (dk-ass!)
                          (let* ((x (dk-di-var!))
                                 (hx (list f x)) (qx (list q x)) (dqx (list dq x)) (xa (list '- x a))
                                 (p (list 'power xa n)))
                            (zol-pt! u x)
                            (fact 'fun-apply-type-c q u 'CC x) (fact 'fun-apply-type-c dq u 'CC x) (fact 'fun-apply-type-c f u 'CC x)
                            (zol-cc! xa) (zol-pow-cc! xa n)
                            (dk-apply! fq x)
                            (dk-apply! dqf x)
                            (dk-rewrite-h! (list '= (list '- qx (list q a)) (list '* dqx xa)) (list q a) 0)
                            (dk-have! (list '= (list '- qx 0) qx) (lambda () (crs)))
                            (dk-rewrite-h! (list '= (list '- qx 0) (list '* dqx xa)) (list '- qx 0) qx)
                            (subst (list '= hx (list '* p qx)))
                            (subst (list '= qx (list '* dqx xa)))
                            (zol-and! (list 'IN xa 'CC) (list 'IN n 'NN))
                            (subst (dk-fact! 'power-succ xa n))
                            (crs)))))))
                (lambda ()
                  (dk-have! (list 'HAS-ZERO-OF-ORDER u f a n)
                    (lambda ()
                      (mac 'HAS-ZERO-OF-ORDER)
                      (dk-conj-close!
                        (lambda ()
                          (cond ((dk-asm? (dk-goal)) (dk-ass!))
                                ((dk-head-is? (dk-goal) 'FORSOME) (ew q) (dk-conj-close! (lambda () (dk-ass!))))
                                (#t (dk-ass!)))))))
                  (dk-have! gl (lambda () (ew n) (dk-conj-close! (lambda () (dk-ass!)))))
                  (ai (list 'NOT gl))))))))
      (let* ((r0 (dk-skolem! (dk-cite! 'holomorphic-all-orders-local u f a) #t))
             (fv (find-first (lambda (g) (and (zol-op? g 'FORALL 3) (dk-contains? g r0) (dk-contains? g f))) (dk-asms))))
        (zol-za-ball! u f a r0 (lambda (x) (dk-close-if! (lambda () (dk-apply! fv x)) (lambda () (dk-ass!)))))
        (let* ((ip (dk-cite! 'holomorphic-identity-principle u f a))
               (w (dk-skolem! wx #t)))
          (dk-apply! ip w)
          (ai (list 'NOT (list '= (list f w) 0))))))))
(qed 'zero-order-exists)

  
