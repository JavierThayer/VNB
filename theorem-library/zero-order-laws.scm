             (dk-conj-close!
               (lambda ()
                 (cond ((dk-asm? (dk-goal)) (dk-ass!))
                       ((dk-head-is? (dk-goal) 'NOT) (dk-lam-b!) (dk-have! '(< 0 1) (lambda () (arith))) (fact 'rr-one-in) (fact 'rr-zero-in) (dk-cite! 'rr-pos-ne-zero 1)
                                                      (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))
                       (#t (let* ((x (dk-di-var!)) (xc (list '- x c)))
                             (zol-pt! u x) (zol-cc! xc) (dk-lam-b!)
                             (subst (dk-fact! 'nn-one-is-succ-zero))
                             (fact 'nn-zero-in) (zol-and! (list 'IN xc 'CC) '(IN 0 NN))
                             (subst (dk-fact! 'power-succ xc 0)) (subst (dk-cite! 'power-zero xc))
                             (crs)))))))
            (#t (dk-ass!))))))
(qed 'zero-order-linear)

;;; ---------------------------------------------------------------- orders add under products
(sp (make-wff (list 'FORALL 'zlu_ (list 'FORALL 'zlf_ (list 'FORALL 'zlg_ (list 'FORALL 'zla_
  (list 'FORALL 'zlm_ (list 'FORALL 'zln_ (list 'IMPLIES '(HAS-ZERO-OF-ORDER zlu_ zlf_ zla_ zlm_) (list 'IMPLIES '(HAS-ZERO-OF-ORDER zlu_ zlg_ zla_ zln_)
    (list 'FORALL 'zlk_ (list 'IMPLIES '(IN zlk_ (FUN zlu_ CC))
      (list 'IMPLIES '(FORALL zly_ (IMPLIES (IN zly_ zlu_) (= (zlk_ zly_) (* (zlf_ zly_) (zlg_ zly_)))))
        '(HAS-ZERO-OF-ORDER zlu_ zlk_ zla_ (+ zlm_ zln_)))))))))))))))
(let* ((new (zol-steps!)) (hz (filter (lambda (q) (dk-head-is? q 'HAS-ZERO-OF-ORDER)) new))
       (ptw (find-first (lambda (q) (zol-op? q 'FORALL 3)) new))
       (peq (caddr (caddr ptw))) (k (car (cadr peq))) (f (car (cadr (caddr peq)))) (g (car (caddr (caddr peq))))
       (hf (find-first (lambda (q) (eq? (caddr q) f)) hz)) (hg (find-first (lambda (q) (eq? (caddr q) g)) hz))
       (u (cadr hf)) (a (cadddr hf)) (m (list-ref hf 4)) (n (list-ref hg 4)))
  (let* ((h1 (zol-hzo-open! hf)) (h2 (zol-hzo-open! hg))
         (fx1 (dk-ctx-form (zol-fac u f a m h1))) (fx2 (dk-ctx-form (zol-fac u g a n h2)))
