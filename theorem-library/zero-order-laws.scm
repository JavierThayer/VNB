;;; at x /= a in u: h(x) - (x - a)^d k(x) = 0, from f = (x - a)^m h = (x - a)^(m+d) k; the goal is g(x) = 0
(define (zol-zero-at! u f h k a m n d pv pw x xa fh fk)
  (let* ((hx (list h x)) (kx (list k x)) (fx (list f x)) (p (list 'power xa m)) (dd (list 'power xa d))
         (pn (list 'power xa (list '+ m d))) (y (list '- hx (list '* dd kx))))
    (fact 'fun-apply-type-c h u 'CC x) (fact 'fun-apply-type-c k u 'CC x) (fact 'fun-apply-type-c f u 'CC x)
    (zol-pow-cc! xa m) (zol-pow-cc! xa d) (zol-and! (list 'IN m 'NN) (list 'IN d 'NN)) (fact 'nn-add-closed m d) (zol-pow-cc! xa (list '+ m d))
    (zol-cc! y)
    (dk-apply! fh x)
    (dk-rewrite-h! (dk-apply! fk x) n (list '+ m d))
    (dk-cite! 'cc-power-add d m xa)
    (dk-have! (list '= (list '* y p) 0)
      (lambda ()
        (dk-have! (list '= (list '* y p) (list '- (list '* p hx) (list '* (list '* p dd) kx))) (lambda () (crs)))
        (subst (list '= (list '* y p) (list '- (list '* p hx) (list '* (list '* p dd) kx))))
        (subst (list '= (list '* p hx) fx))
        (subst (list '= fx (list '* pn kx)))
        (subst (list '= pn (list '* p dd)))
        (crs)))
    (dk-cite! 'cc-power-nonzero m xa)
    (dk-cite! 'cc-mul-zero-left y p)
    (dk-lam-b!)
    (subst (list '= pv pw))
    (dk-lam-b!)
    (dk-close-if! (lambda () #t) (lambda () (dk-ass!)))))
