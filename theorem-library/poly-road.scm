;;; ch3c-poly.scm -- polygonal roads on a partition, and Example 3.11 of complex-analysis.pdf.
;;; Prefix cp-.  Library: complex-analysis.  Destination: theorem-library/poly-road.scm.
;;; Loads after ch3c-vocab (AFF-SEG, AFF-DER, POLY-ROAD, POLY-DER) and ch3c-ga.

(define (cp-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "cp-pick: nothing matching" what) (car l))))
(define (cp-split-goal!)
  (let loop ((todo (list (proof-state-focus *ps*))) (acc '()))
    (if (null? todo) (reverse acc)
        (begin (dk-focus! (car todo))
               (if (dk-head-is? (dk-goal) 'AND)
                   (loop (append (dk-opened (lambda () (di))) (cdr todo)) acc)
                   (loop (cdr todo) (cons (car todo) acc)))))))
(define (cp-in-ccint! x lo hi . prems)
  (let ((g (list 'IN x (list 'CCINT lo hi))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda ()
                      (mac 'ccint-membership)
                      (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (apply dk-ineq! prems)))))))))
;;; the increasing-nodes hypothesis (the same formula as ch3c-ga's cg-inc)
(define cp-inc '(FORALL cgk_ (IMPLIES (IN cgk_ NN) (IMPLIES (< cgk_ n) (< (tq cgk_) (tq (succ cgk_)))))))
(define (cp-ccint-parts! z lo hi)               ; z in [lo, hi]: land z in RR, lo <= z, z <= hi (keeps the membership)
  (for-each (lambda (c) (if (not (dk-asm? c)) (dk-project! c (lambda () (mac-h 'ccint-membership (list 'IN z (list 'CCINT lo hi))) (dk-split-all!)))))
            (list (list 'IN z 'RR) (list '<= lo z) (list '<= z hi))))

;;; ---------------------------------------------------------------------------
;;; The affine segment is a road: road-affine-reparam of seg-path(p, q) on [0, 1]
(define cp-as '(AFF-SEG p q c d))
(define cp-ad '(AFF-DER p q c d))
(sp (make-wff (forall-guarded '(p q c d) '((IN p CC) (IN q CC) (IN c RR) (IN d RR) (< c d))
  (list 'IS-ROAD cp-as cp-ad 'c 'd))))
(dk-peel!)
(let* ((dc '(- d c)) (L (list 'recip dc)) (M (list '- 0 (list '* 'c L))))
  (fact 'rr-sub-in-rr 'd 'c)
  (dk-have! (list '< 0 dc) (lambda () (dk-ineq! '(< c d))))
  (fact 'rr-pos-ne-zero dc)
  (dk-have! (list 'AND (list 'IN dc 'RR) (list 'NOT (list '= dc 0))))
  (fact 'rr-recip-closed dc) (fact 'rr-recip-pos dc) (fact 'rr-recip-inverse dc)
  (dk-have! (list '<= 0 L) (lambda () (dk-ineq! (list '< 0 L))))
  (dk-have! '(IN 0 RR)) (dk-have! '(IN 1 RR))
  (dk-have! (list 'AND '(IN c RR) (list 'IN L 'RR))) (fact 'rr-mul-closed 'c L)
  (fact 'rr-sub-in-rr 0 (list '* 'c L))
  (dk-have! (list '= (list '+ M (list '* L 'c)) 0) (lambda () (dk-crs-opaque!)))
  (dk-have! (list '= (list '* L dc) 1)
    (lambda () (dk-have! (list '= (list '* L dc) (list '* dc L)) (lambda () (dk-crs-opaque!)))
               (subst (list '= (list '* L dc) (list '* dc L))) (ass)))
  (dk-have! (list '= (list '+ M (list '* L 'd)) 1)
    (lambda () (dk-have! (list '= (list '+ M (list '* L 'd)) (list '* L dc)) (lambda () (dk-crs-opaque!)))
               (subst (list '= (list '+ M (list '* L 'd)) (list '* L dc))) (ass)))
  (fact 'seg-path-is-road 'p 'q)
  (fact 'rr-is-set) (fact 'ccint-subset-rr 'c 'd) (fact 'subclass-of-set-is-set '(CCINT c d) 'RR)
  (fact 'cc-sub-in-cc 'q 'p)
  (define (in01! z)
    (let ((x (list '+ M (list '* L z))) (zc (list '- z 'c)))
      (cp-ccint-parts! z 'c 'd)
      (fact 'rr-sub-in-rr z 'c)
      (dk-have! (list '<= 0 zc) (lambda () (dk-ineq! (list '<= 'c z))))
      (dk-have! (list '<= zc dc) (lambda () (dk-ineq! (list '<= z 'd))))
      (dk-have! (list 'AND (list 'IN L 'RR) (list 'IN zc 'RR))) (fact 'rr-mul-closed L zc)
      (dk-have! (list 'AND (list 'IN L 'RR) (list 'IN z 'RR))) (fact 'rr-mul-closed L z)
      (dk-have! (list 'AND (list 'IN L 'RR) (list 'IN dc 'RR))) (fact 'rr-mul-closed L dc)
      (dk-have! (list 'AND (list '<= 0 L) (list '<= 0 zc))) (fact 'rr-leq-mul-nonneg L zc)
      (dk-have! (list 'AND (list '<= 0 L) (list '<= zc dc))) (fact 'rr-le-scale-nonneg L zc dc)
      (dk-have! (list '= x (list '* L zc)) (lambda () (dk-crs-opaque!)))
      (dk-have! (list 'AND (list 'IN M 'RR) (list 'IN (list '* L z) 'RR))) (fact 'rr-add-closed M (list '* L z))
      (dk-have! (list 'IN x '(CCINT 0 1))
        (lambda () (mac 'ccint-membership)
          (dk-conj-close! (lambda ()
            (cond ((dk-asm? (dk-goal)) (ass))
                  (#t (dk-ineq! (list '= x (list '* L zc)) (list '<= 0 (list '* L zc)) (list '<= (list '* L zc) (list '* L dc))
                                (list '= (list '* L dc) 1))))))))
      x))
  (mac 'AFF-SEG) (mac 'AFF-DER)
  (let* ((g (dk-goal)) (las (cadr g)) (lad (caddr g)))
    (for-each (lambda (kk)
                (dk-have! (list 'IN kk '(FUN (CCINT c d) CC))
                  (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!)))
                                                         (cp-ccint-parts! z 'c 'd) (fact 'rr-subset-cc z) (fact 'rr-subset-cc 'c)
                                                         (fact 'rr-subset-cc L)
                                                         (dk-type! (cadr (dk-goal)) 'CC)
                                                         (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass)))))
                                           (lambda () (ass))))))
              (list las lad))
    (dk-have! (list 'FORALL 'lrpz_ (list 'IMPLIES '(IN lrpz_ (CCINT c d))
                (list '== (list las 'lrpz_) (list '(SEG-PATH p q) (list '+ M (list '* L 'lrpz_))))))
      (lambda ()
        (let* ((z (dk-di-var!)) (x (in01! z)))
          (dk-lam-b!)
          (subst (dk-cite! 'seg-path-apply 'p 'q x))
          (let ((lhs (list '+ 'p (list '* (list '* (list '- z 'c) L) '(- q p))))
                (rhs (list '+ 'p (list '* x '(- q p)))))
            (dk-have! (list '= lhs rhs) (lambda () (dk-crs-opaque!)))
            (subst (list '= lhs rhs))
            (qrfl)))))
    (dk-have! '(= (- q p) (- q p)) (lambda () (rfl)))
    (fact 'seg-deriv-bridge 'p 'q '(- q p))
    (dk-have! (list 'FORALL 'lrpz_ (list 'IMPLIES '(IN lrpz_ (CCINT c d))
                (list '== (list lad 'lrpz_) (list '* L (list '(SEG-DERIV p q) (list '+ M (list '* L 'lrpz_)))))))
      (lambda ()
        (let* ((z (dk-di-var!)) (x (in01! z)))
          (subst '(= (SEG-DERIV p q) (VNB-LAMBDA psx_ (CCINT 0 1) (- q p))))
          (dk-lam-b!)
          (qrfl))))
    (fact 'road-affine-reparam 0 1 'c 'd L M '(SEG-PATH p q) '(SEG-DERIV p q) las lad)
    (ass)))
(qed 'aff-seg-is-road)

;;; ---------------------------------------------------------------------------
;;; Values of the affine segment: its value at z in [c, d] as p + s (q - p) with s = (z - c)/(d - c) in [0, 1]
(define (cp-aff-basics!)                       ; p q c d typed, c < d in context
  (let* ((dc '(- d c)) (L (list 'recip dc)))
    (fact 'rr-sub-in-rr 'd 'c)
    (dk-have! (list '< 0 dc) (lambda () (dk-ineq! '(< c d))))
    (fact 'rr-pos-ne-zero dc)
    (dk-have! (list 'AND (list 'IN dc 'RR) (list 'NOT (list '= dc 0))))
    (fact 'rr-recip-closed dc) (fact 'rr-recip-pos dc) (fact 'rr-recip-inverse dc)
    (dk-have! (list '<= 0 L) (lambda () (dk-ineq! (list '< 0 L))))
    (dk-have! (list 'AND (list 'IN L 'RR) (list 'IN dc 'RR))) (fact 'rr-mul-closed L dc)
    (dk-have! (list '= (list '* L dc) 1)
      (lambda () (dk-have! (list '= (list '* L dc) (list '* dc L)) (lambda () (dk-crs-opaque!)))
                 (subst (list '= (list '* L dc) (list '* dc L))) (ass)))
    L))
(define (cp-s01! z L)                          ; z in [c, d]: (z - c) L in [0, 1]; returns it
  (let* ((zc (list '- z 'c)) (dc '(- d c)) (sv (list '* zc L)))
    (cp-ccint-parts! z 'c 'd)
    (fact 'rr-sub-in-rr z 'c)
    (dk-have! (list '<= 0 zc) (lambda () (dk-ineq! (list '<= 'c z))))
    (dk-have! (list '<= zc dc) (lambda () (dk-ineq! (list '<= z 'd))))
    (dk-have! (list 'AND (list 'IN zc 'RR) (list 'IN L 'RR))) (fact 'rr-mul-closed zc L)
    (dk-have! (list 'AND (list 'IN dc 'RR) (list 'IN L 'RR))) (fact 'rr-mul-closed dc L)
    (dk-have! (list 'AND (list '<= 0 zc) (list '<= 0 L))) (fact 'rr-leq-mul-nonneg zc L)
    (dk-have! (list 'AND (list '<= 0 L) (list '<= zc dc))) (fact 'rr-le-scale-nonneg-right zc dc L)
    (dk-have! (list '= (list '* dc L) 1) (lambda () (dk-ineq! (list '= (list '* L dc) 1) (list '= (list '* dc L) (list '* L dc)))))
    (dk-have! '(IN 0 RR)) (dk-have! '(IN 1 RR))
    (cp-in-ccint! sv 0 1 (list '<= 0 sv) (list '<= sv (list '* dc L)) (list '= (list '* dc L) 1))
    sv))

(sp (make-wff (forall-guarded '(p q c d) '((IN p CC) (IN q CC) (IN c RR) (IN d RR) (< c d))
  '(AND (= ((AFF-SEG p q c d) c) p) (= ((AFF-SEG p q c d) d) q)))))
(dk-peel!)
(let ((L (cp-aff-basics!)))
  (dk-have! '(<= c d) (lambda () (dk-ineq! '(< c d))))
  (cp-in-ccint! 'c 'c 'd '(<= c d)) (cp-in-ccint! 'd 'c 'd '(<= c d))
  (fact 'cc-sub-in-cc 'q 'p)
  (for-each (lambda (leaf) (dk-focus! leaf)
              (mac 'AFF-SEG) (dk-lam-b!)
              (fact 'rr-subset-cc L)
              (if (dk-contains? (dk-goal) (list '* '(- d c) L))
                  (begin
                    (dk-have! (list '= (list '* '(- d c) L) 1) (lambda () (dk-ineq! (list '= (list '* L '(- d c)) 1))))
                    (subst (list '= (list '* '(- d c) L) 1))
                    (crs))
                  (dk-crs-opaque!)))
            (cp-split-goal!)))
(qed 'aff-seg-ends)

(sp (make-wff (forall-guarded '(p q c d cps_ z) '((IN p CC) (IN q CC) (IN c RR) (IN d RR) (< c d) (IS-CONVEX-CC cps_)
     (IN p cps_) (IN q cps_) (IN z (CCINT c d)))
  '(IN ((AFF-SEG p q c d) z) cps_))))
(dk-peel!)
(let* ((L (cp-aff-basics!)) (sv (cp-s01! 'z L)))
  (mac 'AFF-SEG) (dk-lam-b!)
  (let* ((rhs (caddr (dk-cite! 'is-convex-cc 'cps_))))
    (dk-project! rhs 'is-convex-cc '(IS-CONVEX-CC cps_))
    (dk-split-all! (list rhs))
    (let ((cv (dk-apply! (cp-pick 'cv (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'cvt_)))) 'p 'q sv)))
      (dk-have! (list '= (list '* (list '* '(- z c) L) '(- q p)) (list '* sv '(- q p))) (lambda () (rfl)))
      (ass))))
(qed 'aff-seg-in-convex)

;;; ---------------------------------------------------------------------------
;;; THE POLYGON: on its k-th piece it is the k-th affine segment (by induction on m)
(define cp-hyps '((IN n NN) (IN tq (FUN NN RR)) (IN xq (FUN NN CC))))
(define (cp-aff k) (list 'AFF-SEG (list 'xq k) (list 'xq (list 'succ k)) (list 'tq k) (list 'tq (list 'succ k))))
(define (cp-pv-body m)
  (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES (list '<= 'k m)
    (list 'FORALL 'th (list 'IMPLIES '(IN th (CCINT (tq k) (tq (succ k))))
      (list '== (list (list 'POLY-ROAD 'tq 'xq m) 'th) (list (cp-aff 'k) 'th))))))))
(define (cp-types! . ks)
  (for-each (lambda (k) (fact 'fun-apply-type-c 'tq 'NN 'RR k) (fact 'fun-apply-type-c 'xq 'NN 'CC k)) ks))
(define (cp-inc-at! k)                         ; k < n in context: t(k) < t(succ k), and <=
  (let ((r (dk-apply! (cp-pick 'inc (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'cgk_)))) k)))
    (dk-have! (list '<= (list 'tq k) (list 'tq (list 'succ k))) (lambda () (dk-ineq! r)))
    r))
(define (cp-goal-k-th)                         ; goal (== (P th) ((AFF-SEG (xq k) ..) th)): (k . th)
  (let* ((g (dk-goal)) (th (cadr (cadr g))) (aff (car (caddr g))))
    (cons (cadr (cadr aff)) th)))
(define (cp-road m) (list 'IS-ROAD (list 'POLY-ROAD 'tq 'xq m) (list 'POLY-DER 'tq 'xq m) '(tq 0) (list 'tq (list 'succ m))))
(define (cp-aff-der k) (list 'AFF-DER (list 'xq k) (list 'xq (list 'succ k)) (list 'tq k) (list 'tq (list 'succ k))))
(define (cp-aff-typed! k)                      ; the k-th segment: a road, in FUN; t(k) < t(succ k) in context
  (fact 'aff-seg-is-road (list 'xq k) (list 'xq (list 'succ k)) (list 'tq k) (list 'tq (list 'succ k)))
  (fact 'is-road-is-path (cp-aff k) (cp-aff-der k) (list 'tq k) (list 'tq (list 'succ k)))
  (fact 'is-path-in-fun (cp-aff k) (list 'tq k) (list 'tq (list 'succ k))))
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IN m NN)
  (forall-guarded '(n tq xq) (append cp-hyps (list cp-inc '(< m n))) (list 'AND (cp-road 'm) (cp-pv-body 'm)))))))
(define cp1-br (use-induction))
(dk-focus! (cdr (assq 'base cp1-br)))
(dk-peel!)
(dk-have! '(IN 0 NN)) (fact 'nn-succ-closed 0)
(cp-types! 0 '(succ 0))
(cp-inc-at! 0)
(for-each
 (lambda (leaf)
   (dk-focus! leaf)
   (if (dk-head-is? (dk-goal) 'IS-ROAD)
       (begin (subst (dk-cite! 'poly-road-zero 'tq 'xq)) (subst (dk-cite! 'poly-der-zero 'tq 'xq))
              (fact 'aff-seg-is-road '(xq 0) '(xq (succ 0)) '(tq 0) '(tq (succ 0)))
              (ass))
       (begin
         (dk-peel!)
         (let* ((kt (cp-goal-k-th)) (k (car kt)))
           (dk-have! (list '= k 0) (lambda () (dk-nn!)))
           (subst (list '= k 0))
           (subst (dk-cite! 'poly-road-zero 'tq 'xq))
           (qrfl)))))
 (cp-split-goal!))
(dk-focus! (cdr (assq 'step cp1-br)))
(let* ((m (cdr (assq 'var cp1-br))) (ih (cdr (assq 'ih cp1-br)))
       (sm (list 'succ m)) (ssm (list 'succ sm)))
  (dk-peel!)
  (fact 'nn-succ-closed m) (fact 'nn-succ-closed sm)
  (dk-have! '(IN 0 NN))
  (dk-have! (list '< m 'n) (lambda () (dk-nn!)))
  (cp-types! 0 m sm ssm)
  (cp-inc-at! sm) (cp-inc-at! m)
  (dk-split-all! (list (dk-apply! ih 'n 'tq 'xq)))
  (let* ((P (list 'POLY-ROAD 'tq 'xq m)) (PD (list 'POLY-DER 'tq 'xq m))
         (inv (cp-pick 'inv (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'th) (dk-contains? z P)))))
         (J (list 'JUXTA P (cp-aff sm) '(tq 0) (list 'tq sm) (list 'tq ssm))))
    (fact 'is-road-is-path P PD '(tq 0) (list 'tq sm))
    (fact 'is-path-in-fun P '(tq 0) (list 'tq sm))
    (cp-aff-typed! m) (cp-aff-typed! sm)
    ;; the junction: P(t(sm)) = x(sm) = AFF(sm)(t(sm))
    (dk-have! (list '<= m m) (lambda () (dk-nn!)))
    (cp-in-ccint! (list 'tq sm) (list 'tq m) (list 'tq sm) (list '< (list 'tq m) (list 'tq sm)))
    (dk-split-all! (list (dk-fact! 'aff-seg-ends (list 'xq m) (list 'xq sm) (list 'tq m) (list 'tq sm))))
    (dk-split-all! (list (dk-fact! 'aff-seg-ends (list 'xq sm) (list 'xq ssm) (list 'tq sm) (list 'tq ssm))))
    (let ((pe (inst*! inv m (list 'tq sm))))
      (dk-have! (list '= (list P (list 'tq sm)) (list (cp-aff sm) (list 'tq sm)))
        (lambda ()
          (subst pe)
          (subst (list '= (list (cp-aff m) (list 'tq sm)) (list 'xq sm)))
          (subst (list '= (list (cp-aff sm) (list 'tq sm)) (list 'xq sm)))
          (rfl))))
    (dk-have! (list '<= sm 'n) (lambda () (dk-nn!)))
    (dk-split-all! (list (dk-fact! 'increasing-seq-from-start sm 'n 'tq)))
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (if (dk-head-is? (dk-goal) 'IS-ROAD)
           (begin
             (subst (dk-cite! 'poly-road-succ 'tq 'xq m)) (subst (dk-cite! 'poly-der-succ 'tq 'xq m))
             (fact 'juxta-is-road P PD (cp-aff sm) (cp-aff-der sm) '(tq 0) (list 'tq sm) (list 'tq ssm))
             (ass))
           (begin
             (dk-peel!)
             (let* ((kt (cp-goal-k-th)) (k (car kt)) (th (cdr kt)) (sk (list 'succ k)))
               (fact 'nn-succ-closed k)
               (cp-types! k sk)
               (subst (dk-cite! 'poly-road-succ 'tq 'xq m))
               (dk-fact! 'nn-le-succ-cases m k)
               (use-cases (list (list '<= k m) (list '= k sm))
                 (lambda ()
                   (dk-have! (list '<= k 'n) (lambda () (dk-nn!)))
                   (dk-split-all! (list (dk-fact! 'increasing-seq-from-start k 'n 'tq)))
                   (dk-have! (list '<= sk sm) (lambda () (dk-nn!)))
                   (fact 'increasing-seq-le sm sk 'n 'tq)
                   (cp-ccint-parts! th (list 'tq k) (list 'tq sk))
                   (cp-in-ccint! th '(tq 0) (list 'tq sm) (list '<= '(tq 0) (list 'tq k)) (list '<= (list 'tq k) th)
                                 (list '<= th (list 'tq sk)) (list '<= (list 'tq sk) (list 'tq sm)))
                   (subst (dk-cite! 'juxta-apply-left P (cp-aff sm) '(tq 0) (list 'tq sm) (list 'tq ssm) th))
                   (subst (inst*! inv k th))
                   (qrfl))
                 (lambda ()
                   (dk-rewrite-h! (list 'IN th (list 'CCINT (list 'tq k) (list 'tq sk))) k sm)
                   (subst (list '= k sm))
                   (dk-have! (list '<= '(tq 0) (list 'tq sm))
                     (lambda () (dk-ineq! (cp-pick 'le0 (lambda (z) (and (dk-head-is? z '<=) (equal? (cadr z) '(tq 0)) (equal? (caddr z) (list 'tq sm))))))))
                   (let ((jr (dk-fact! 'juxta-apply-right-closed P (cp-aff sm) '(tq 0) (list 'tq sm) (list 'tq ssm))))
                     (subst (inst*! jr th))
                     (qrfl))))))))
     (cp-split-goal!))))
(qed 'poly-road-facts)

;;; ---------------------------------------------------------------------------
;;; Every point of [t(0), t(m+1)] lies on some piece [t(k), t(k+1)], k <= m
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IN m NN)
  (forall-guarded '(n tq) (list '(IN n NN) '(IN tq (FUN NN RR)) cp-inc '(< m n))
    '(FORALL th (IMPLIES (IN th (CCINT (tq 0) (tq (succ m))))
       (FORSOME k (AND (IN k NN) (AND (<= k m) (IN th (CCINT (tq k) (tq (succ k))))))))))))))
(define cp2-br (use-induction))
(dk-focus! (cdr (assq 'base cp2-br)))
(dk-peel!)
(dk-have! '(IN 0 NN))
(ew 0)
(for-each (lambda (leaf) (dk-focus! leaf) (if (dk-asm? (dk-goal)) (ass) (dk-nn!))) (cp-split-goal!))
(dk-focus! (cdr (assq 'step cp2-br)))
(let* ((m (cdr (assq 'var cp2-br))) (ih (cdr (assq 'ih cp2-br)))
       (sm (list 'succ m)) (ssm (list 'succ sm)) (ts (list 'tq sm)) (tss (list 'tq ssm)))
  (dk-peel!)
  (fact 'nn-succ-closed m) (fact 'nn-succ-closed sm)
  (dk-have! '(IN 0 NN))
  (dk-have! (list '< m 'n) (lambda () (dk-nn!)))
  (for-each (lambda (k) (fact 'fun-apply-type-c 'tq 'NN 'RR k)) (list 0 sm ssm))
  (dk-apply! (cp-pick 'inc (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'cgk_)))) sm)
  (cp-ccint-parts! 'th '(tq 0) tss)
  (use-em (list '<= 'th ts)
    (lambda ()
      (cp-in-ccint! 'th '(tq 0) ts (list '<= '(tq 0) 'th) (list '<= 'th ts))
      (let* ((k (dk-skolem! (inst*! (dk-apply! ih 'n 'tq) 'th) #t)))
        (ew k)
        (for-each (lambda (leaf) (dk-focus! leaf) (if (dk-asm? (dk-goal)) (ass) (dk-nn!))) (cp-split-goal!))))
    (lambda ()
      (fact 'rr-not-le-lt 'th ts)
      (ew sm)
      (for-each (lambda (leaf) (dk-focus! leaf)
                  (cond ((dk-asm? (dk-goal)) (ass))
                        ((dk-head-is? (dk-goal) '<=) (dk-nn!))
                        (#t (cp-in-ccint! 'th ts tss (list '< ts 'th) (list '<= 'th tss)) (ass))))
                (cp-split-goal!)))))
(qed 'poly-piece-locate)

;;; ---------------------------------------------------------------------------
;;; THE CONSTRUCTION of Example 3.11, in the form 3.17 also needs: a polygon whose k-th piece runs
;;; between two nodes lying in an open convex bs(k) inside u, which holds pgam on that piece, is a road
;;; and a good approximation to pgam (the notes' nodes x_k = pgam(t_k) are one instance).
(define (cp-pks nn)
  (list 'FORALL 'hmk_ (list 'IMPLIES '(IN hmk_ NN) (list 'IMPLIES (list '< 'hmk_ nn)
    '(AND (< (tq hmk_) (tq (succ hmk_)))
     (AND (IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) (bs hmk_))
     (AND (IS-CONVEX-CC (bs hmk_))
     (AND (SUBSET (bs hmk_) u)
     (AND (IN (xq hmk_) (bs hmk_))
     (AND (IN (xq (succ hmk_)) (bs hmk_))
          (FORALL hmw_ (IMPLIES (IN hmw_ (CCINT (tq hmk_) (tq (succ hmk_)))) (IN (pgam hmw_) (bs hmk_))))))))))))))
(define cp-P '(POLY-ROAD tq xq m))
(define cp-PD '(POLY-DER tq xq m))
(sp (make-wff (forall-guarded '(u pgam a b m tq xq bs)
  (list '(IS-PATH pgam a b) '(SUBSET (TRACE pgam a b) u) '(IN m NN) '(IN tq (FUN NN RR)) '(IN xq (FUN NN CC))
        '(IN bs (FUN NN (POWER CC))) '(= (tq 0) a) '(= (tq (succ m)) b) '(= (xq 0) (pgam a)) '(= (xq (succ m)) (pgam b))
        (cp-pks '(succ m)))
  (list 'AND (list 'IS-ROAD cp-P cp-PD 'a 'b) (list 'GOOD-APPROX 'u 'pgam cp-P 'a 'b)))))
(dk-peel!)
(let* ((sm '(succ m)) (pks (cp-pick 'pks (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'hmw_))))))
  (fact 'nn-succ-closed 'm)
  (dk-have! '(IN 0 NN))
  (dk-have! (list '< 'm sm) (lambda () (dk-nn!)))
  (fact 'is-path-endpoints 'pgam 'a 'b) (dk-split-all!)
  (dk-have! (subst-free 'n sm cp-inc)
    (lambda () (let ((j (dk-di-var!))) (di) (dk-split-all! (list (dk-apply! pks j))) (ass))))
  (dk-split-all! (list (dk-fact! 'poly-road-facts 'm sm 'tq 'xq)))
  (let* ((pv (cp-pick 'pv (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'th) (dk-contains? z cp-P))))))
    (define (pks-at! k)
      (if (not (dk-asm? (list 'IS-CONVEX-CC (list 'bs k)))) (dk-split-all! (list (dk-apply! pks k)))))
    (fact 'is-road-is-path cp-P cp-PD '(tq 0) (list 'tq sm))
    (fact 'is-path-in-fun cp-P '(tq 0) (list 'tq sm))
    (cp-types! 0 'm sm)
    ;; P(t(k)) at the two ends
    (define (end! k th xk)                      ; (= (P th) xk) for th the end of piece k
      (let ((sk (list 'succ k)))
        (fact 'nn-succ-closed k) (cp-types! k sk)
        (dk-have! (list '< k sm) (lambda () (dk-nn!)))
        (pks-at! k)
        (dk-have! (list '<= (list 'tq k) (list 'tq sk)) (lambda () (dk-ineq! (list '< (list 'tq k) (list 'tq sk)))))
        (cp-in-ccint! th (list 'tq k) (list 'tq sk) (list '< (list 'tq k) (list 'tq sk)))
        (dk-have! (list '<= k 'm) (lambda () (dk-nn!)))
        (let ((e (inst*! pv k th)))
          (dk-split-all! (list (dk-fact! 'aff-seg-ends (list 'xq k) (list 'xq sk) (list 'tq k) (list 'tq sk))))
          (dk-have! (list '= (list cp-P th) xk)
            (lambda () (subst e) (subst (list '= (list (cp-aff k) th) xk)) (rfl))))))
    (end! 0 '(tq 0) '(xq 0))
    (end! 'm (list 'tq sm) (list 'xq sm))
    ;; the polygon at a point of piece k is in bs(k)
    (define (in-piece! k w)                     ; w in [t k, t sk], k <= m: (IN (P w) (bs k))
      (let ((sk (list 'succ k)))
        (fact 'nn-succ-closed k) (cp-types! k sk)
        (dk-have! (list '< k sm) (lambda () (dk-nn!)))
        (pks-at! k)
        (fact 'aff-seg-in-convex (list 'xq k) (list 'xq sk) (list 'tq k) (list 'tq sk) (list 'bs k) w)
        (dk-have! (list 'IN (list cp-P w) (list 'bs k)) (lambda () (subst (inst*! pv k w)) (ass)))))
    (define (drive!)
      (let ((g (dk-goal)))
        (cond
         ((dk-asm? g) (ass))
         ((dk-head-is? g 'AND) (for-each (lambda (l) (dk-focus! l) (drive!)) (dk-opened (lambda () (di)))))
         ((dk-head-is? g 'FORSOME)
          (let ((v (cadr g)))
            (ew (cond ((eq? v 'hmn_) sm) ((eq? v 'hmt_) 'tq) (#t 'bs)))
            (drive!)))
         ((dk-head-is? g 'IS-ROAD)
          (dk-rewrite-h! (list 'IS-ROAD cp-P cp-PD '(tq 0) (list 'tq sm)) '(tq 0) 'a)
          (dk-rewrite-h! (list 'IS-ROAD cp-P cp-PD 'a (list 'tq sm)) (list 'tq sm) 'b)
          (ass))
         ((dk-head-is? g 'IS-PATH)
          (subst '(= a (tq 0))) (subst (list '= 'b (list 'tq sm))) (ass))
         ((and (dk-head-is? g '<=) (equal? (cadr g) 1)) (dk-nn!))
         ((dk-head-is? g '=)                    ; (= (P a) (pgam a)) or (= (P b) (pgam b))
          (if (dk-contains? g 'a)
              (begin (subst '(= a (tq 0)))
                     (subst (list '= (list cp-P '(tq 0)) '(xq 0)))
                     (dk-rewrite-h! '(= (xq 0) (pgam a)) 'a '(tq 0)) (ass))
              (begin (subst (list '= 'b (list 'tq sm)))
                     (subst (list '= (list cp-P (list 'tq sm)) (list 'xq sm)))
                     (dk-rewrite-h! (list '= (list 'xq sm) '(pgam b)) 'b (list 'tq sm)) (ass))))
         ((dk-head-is? g 'SUBSET)                ; the trace of P
          (mac 'subset-def)
          (let* ((pl (dk-peel!)) (z (cadr (car pl))) (tr (list 'TRACE cp-P 'a 'b)))
            (fact 'trace-unfold cp-P 'a 'b)
            (dk-rewrite-h! (list 'IN z tr) tr (list 'IMAGE cp-P '(CCINT a b)))
            (let ((iff (dk-cite! 'image-membership-iff cp-P '(CCINT a b) z)))
              (dk-have! (caddr iff) (lambda () (prop)))
              (dk-split! (caddr iff))
              (let* ((x (dk-skolem! (cp-pick 'ex (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f z)))) #t)))
                (dk-have! (list 'IN x (list 'CCINT '(tq 0) (list 'tq sm)))
                  (lambda () (subst '(= (tq 0) a)) (subst (list '= (list 'tq sm) 'b)) (ass)))
                (let* ((k (dk-skolem! (inst*! (dk-fact! 'poly-piece-locate 'm sm 'tq) x) #t)))
                  (dk-split-all!)
                  (in-piece! k x)
                  (fact 'subset-mem-fwd (list 'bs k) 'u (list cp-P x))
                  (subst (list '= z (list cp-P x)))
                  (ass))))))
         ((dk-head-is? g 'FORALL)
          (let* ((pl (dk-peel!)) (k (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) pl)))))
            (pks-at! k)
            (for-each
             (lambda (l)
               (dk-focus! l)
               (let ((g2 (dk-goal)))
                 (cond ((dk-asm? g2) (ass))
                       ((dk-head-is? g2 'FORALL)
                        (let* ((w (dk-di-var!)))
                          (fact 'nn-lt-succ-le k sm)
                          (dk-have! (list '<= k 'm) (lambda () (dk-nn!)))
                          (in-piece! k w)
                          (inst*! (cp-pick 'pw (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'hmw_) (dk-contains? f 'pgam) (dk-contains? f (list 'bs k))))) w)
                          (dk-conj-close! (lambda () (ass)))))
                       (#t (ass)))))
             (cp-split-goal!))))
         (#t (ass)))))
    (mac 'good-approx)
    (drive!)))
(qed 'good-approx-polygon)

;;; ---------------------------------------------------------------------------
;;; A path is uniformly continuous (Heine-Cantor on [a, b], isom-uc), in plain terms
(sp (make-wff (forall-guarded '(pgam a b) '((IS-PATH pgam a b))
  '(FORALL cpe_ (IMPLIES (POS-RR cpe_) (FORSOME cpd_ (AND (POS-RR cpd_)
     (FORALL cpx_ (IMPLIES (IN cpx_ (CCINT a b)) (FORALL cpy_ (IMPLIES (IN cpy_ (CCINT a b))
       (IMPLIES (<= (abs (- cpx_ cpy_)) cpd_) (<= (magnitude (- (pgam cpx_) (pgam cpy_))) cpe_)))))))))))))
(dk-peel!)
(let* ((ab '(CCINT a b)) (sb (list 'SUBSPACE-MS 'RR-MS ab)) (e (cadr (cp-pick 'e (lambda (f) (dk-head-is? f 'POS-RR))))))
  (fact 'is-path-endpoints 'pgam 'a 'b) (dk-split-all!)
  (fact 'is-path-in-fun 'pgam 'a 'b)
  (fact 'rr-is-metric-space) (fact 'cc-is-metric-space) (fact 'rr-ms@pts) (fact 'cc-ms@pts)
  (fact 'rr-is-set) (fact 'ccint-subset-rr 'a 'b) (fact 'subclass-of-set-is-set ab 'RR)
  (fact 'subspace-pts 'RR-MS ab)
  (dk-have! (list 'SUBSET ab '(PTS RR-MS)) (lambda () (subst '(= (PTS RR-MS) RR)) (ass)))
  (fact 'subspace-is-metric-space 'RR-MS ab)
  (fact 'is-path-continuous 'pgam 'a 'b)
  (dk-have! (list 'IS-CONTINUOUS sb 'CC-MS 'pgam)
    (lambda ()
      (mac 'is-continuous)
      (dk-conj-close!
        (lambda ()
          (cond ((dk-asm? (dk-goal)) (ass))
                ((dk-head-is? (dk-goal) 'IN)
                 (subst (list '= (list 'PTS sb) ab)) (subst '(= (PTS CC-MS) CC)) (ass))
                (#t (let ((x (dk-di-var!)))
                      (dk-have! (list 'IN x ab) (lambda () (subst (list '= ab (list 'PTS sb))) (ass)))
                      (inst*! (cp-pick 'pc (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-CONTINUOUS-AT)))) x)
                      (ass))))))))
  (fact 'heine-borel-ccint 'a 'b)
  (fact 'compact-continuous-uniformly-continuous sb 'CC-MS 'pgam)
  (let* ((rhs (caddr (dk-cite! 'is-uniformly-continuous sb 'CC-MS 'pgam))))
    (dk-project! rhs 'is-uniformly-continuous (list 'IS-UNIFORMLY-CONTINUOUS sb 'CC-MS 'pgam))
    (dk-split-all! (list rhs))
    (let* ((d (dk-skolem! (dk-apply! (cp-pick 'ue (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR) (dk-contains? f 'delta)))) e) #t))
           (cl (cp-pick 'cl (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d))))))
      (ew d)
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (dk-asm? (dk-goal)) (ass)
             (let* ((pl (dk-peel!))
                    (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) ab))) pl)))
                    (x (car vs)) (y (cadr vs)))
               (for-each (lambda (v) (dk-have! (list 'IN v (list 'PTS sb)) (lambda () (subst (list '= (list 'PTS sb) ab)) (ass)))
                                     (fact 'subset-mem-fwd ab 'RR v)
                                     (fact 'fun-apply-type-c 'pgam ab 'CC v))
                         (list x y))
               (dk-cite! 'subspace-dist 'RR-MS ab x y)
               (dk-cite! 'rr-ms-dist x y)
               (dk-cite! 'cc-ms-dist (list 'pgam x) (list 'pgam y))
               (let* ((r 'none))
                 (let ((dxy (list (list 'DIST sb) x y)))
                   (dk-have! (list '<= dxy d)
                     (lambda () (subst (list '= dxy (list '(DIST RR-MS) x y))) (subst (list '= (list '(DIST RR-MS) x y) (list 'abs (list '- x y)))) (ass)))
                   (let ((r2 (inst*! cl x y)))
                     (dk-rewrite-h! (cp-pick 'res (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f '(DIST CC-MS)))))
                                    (list '(DIST CC-MS) (list 'pgam x) (list 'pgam y)) (list 'magnitude (list '- (list 'pgam x) (list 'pgam y))))
                     (ass)))))))
       (cp-split-goal!)))))
(qed 'path-uniformly-continuous)

;;; ---------------------------------------------------------------------------
;;; A uniform grid of mesh <= d: a + (m + 1) h = b with 0 < h <= d
(sp (make-wff (forall-guarded '(a b d) '((IN a RR) (IN b RR) (IN d RR) (< a b) (< 0 d))
  '(FORSOME cpm_ (AND (IN cpm_ NN) (FORSOME cph_ (AND (IN cph_ RR) (AND (< 0 cph_) (AND (<= cph_ d)
     (= (+ a (* (+ cpm_ 1) cph_)) b))))))))))
(dk-peel!)
(let* ((ba '(- b a)))
  (fact 'rr-sub-in-rr 'b 'a)
  (dk-have! (list '< 0 ba) (lambda () (dk-ineq! '(< a b))))
  (fact 'rr-pos-rr-of-lt 'd)
  (let* ((N (dk-skolem! (dk-apply! (dk-cite! 'rr-archimedean-multiple 'd) ba) #t))
         (M1 (list '+ N 1)) (r (list 'recip M1)) (h (list '* ba r)))
    (fact 'nn-in-rr N) (dk-have! '(IN 1 RR)) (dk-have! '(IN 0 NN)) (fact 'nn-in-rr 0)
    (dk-have! (list 'AND (list 'IN N 'RR) '(IN 1 RR))) (fact 'rr-add-closed N 1)
    (dk-have! (list '<= 0 N) (lambda () (dk-nn!)))
    (dk-have! (list '< 0 M1) (lambda () (dk-ineq! (list '<= 0 N))))
    (fact 'rr-pos-ne-zero M1)
    (dk-have! (list 'AND (list 'IN M1 'RR) (list 'NOT (list '= M1 0))))
    (fact 'rr-recip-closed M1) (fact 'rr-recip-pos M1) (fact 'rr-recip-inverse M1)
    (dk-have! (list 'AND (list 'IN ba 'RR) (list 'IN r 'RR))) (fact 'rr-mul-closed ba r)
    (fact 'rr-mul-pos ba r)
    (dk-have! (list 'AND (list 'IN M1 'RR) '(IN d RR))) (fact 'rr-mul-closed M1 'd)
    (dk-have! (list 'AND (list 'IN N 'RR) '(IN d RR))) (fact 'rr-mul-closed N 'd)
    (dk-have! (list '<= ba (list '* M1 'd))
      (lambda () (dk-have! (list '= (list '* M1 'd) (list '+ (list '* N 'd) 'd)) (lambda () (crs)))
                 (dk-ineq! (list '<= ba (list '* N 'd)) (list '= (list '* M1 'd) (list '+ (list '* N 'd) 'd)) '(< 0 d))))
    (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
    (dk-have! (list 'AND (list '<= 0 r) (list '<= ba (list '* M1 'd))))
    (fact 'rr-le-scale-nonneg r ba (list '* M1 'd))
    (dk-have! (list 'AND (list 'IN r 'RR) (list 'IN (list '* M1 'd) 'RR))) (fact 'rr-mul-closed r (list '* M1 'd))
    (dk-have! (list 'AND (list 'IN r 'RR) (list 'IN ba 'RR))) (fact 'rr-mul-closed r ba)
    (dk-have! (list '= (list '* r (list '* M1 'd)) 'd)
      (lambda () (dk-have! (list '= (list '* r (list '* M1 'd)) (list '* (list '* M1 r) 'd)) (lambda () (dk-crs-opaque!)))
                 (subst (list '= (list '* r (list '* M1 'd)) (list '* (list '* M1 r) 'd)))
                 (subst (list '= (list '* M1 r) 1)) (crs)))
    (dk-have! (list '= (list '* r ba) h) (lambda () (dk-crs-opaque!)))
    (ew N)
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (cond ((dk-asm? (dk-goal)) (ass))
             ((dk-head-is? (dk-goal) 'FORSOME)
              (ew h)
              (for-each
               (lambda (l2)
                 (dk-focus! l2)
                 (let ((g (dk-goal)))
                   (cond ((dk-asm? g) (ass))
                         ((dk-head-is? g '<=) (dk-ineq! (list '<= (list '* r ba) (list '* r (list '* M1 'd))) (list '= (list '* r (list '* M1 'd)) 'd)
                                                        (list '= (list '* r ba) h)))
                         (#t (dk-have! (list '= (list '* M1 h) ba)
                               (lambda () (dk-have! (list '= (list '* M1 h) (list '* (list '* M1 r) ba)) (lambda () (dk-crs-opaque!)))
                                          (subst (list '= (list '* M1 h) (list '* (list '* M1 r) ba)))
                                          (subst (list '= (list '* M1 r) 1)) (crs)))
                             (subst (list '= (list '* M1 h) ba))
                             (crs)))))
               (cp-split-goal!)))
             (#t (ass))))
     (cp-split-goal!))))
(qed 'uniform-grid)

;;; ---------------------------------------------------------------------------
;;; EXAMPLE 3.11: every curve in an open u has a polygonal good approximation (a road)
(sp (make-wff (forall-guarded '(u pgam a b)
  '((IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u) (IS-PATH pgam a b) (SUBSET (TRACE pgam a b) u))
  '(FORSOME cpr_ (FORSOME cpq_ (AND (IS-ROAD cpr_ cpq_ a b) (GOOD-APPROX u pgam cpr_ a b)))))))
(dk-peel!)
(let* ((ktr '(TRACE pgam a b)) (ab '(CCINT a b)))
  (fact 'is-path-endpoints 'pgam 'a 'b) (dk-split-all!)
  (fact 'is-path-in-fun 'pgam 'a 'b)
  (fact 'cc-is-metric-space) (fact 'cc-ms@pts)
  (fact 'path-trace-compact 'pgam 'a 'b)
  (let ((oiff (dk-cite! 'cc-ms-open-iff 'u)))
    (dk-have! '(IS-OPEN CC-MS u) (lambda () (if (dk-only! oiff '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u)) (prop)))))
  (let* ((eps (dk-skolem! (dk-fact! 'compact-open-margin ktr 'u) #t))
         (mg (cp-pick 'mg (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f eps) (dk-contains? f 'BALL)))))
         (e2 (dk-halve! eps))
         (_p (dk-pos-parts! eps))
         (dl (dk-skolem! (dk-apply! (dk-fact! 'path-uniformly-continuous 'pgam 'a 'b) e2) #t))
         (uc (cp-pick 'uc (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f dl)))))
         (_q (dk-pos-parts! dl))
         (m (dk-skolem! (dk-fact! 'uniform-grid 'a 'b dl) #t))
         (_s (dk-split-all!))
         (h (dk-skolem! (cp-pick 'eh (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'cph_)))) #t))
         (_s2 (dk-split-all!))
         (sm (list 'succ m))
         (TQ (list 'VNB-LAMBDA 'cpk_ 'NN (list '+ 'a (list '* 'cpk_ h))))
         (XQ (list 'VNB-LAMBDA 'cpk_ 'NN (list 'IF (list '<= 'cpk_ sm) (list 'pgam (list '+ 'a (list '* 'cpk_ h))) 0)))
         (BS (list 'VNB-LAMBDA 'cpk_ 'NN (list 'BALL 'CC-MS (list 'IF (list '<= 'cpk_ sm) (list 'pgam (list '+ 'a (list '* 'cpk_ h))) 0) eps))))
    (dk-pos-parts! e2)
    (fact 'nn-succ-closed m) (fact 'nn-in-rr m) (fact 'nn-in-rr sm) (fact 'nn-succ-plus-one m)
    (dk-have! '(IN 0 NN)) (dk-have! '(IN 0 RR)) (dk-have! '(IN 1 RR))
    (dk-have! '(IN 0 CC) (lambda () (fact 'rr-subset-cc 0) (ass)))
    (fact 'nn-is-set) (fact 'cc-is-set)
    (dk-have! (list '<= 0 h) (lambda () (dk-ineq! (list '< 0 h))))
    (dk-have! (list 'AND (list 'IN m 'RR) '(IN 1 RR))) (fact 'rr-add-closed m 1)
    ;; t_k = a + k h, for k in NN; in [a, b] when k <= m + 1
    (define (tk k) (list '+ 'a (list '* k h)))
    (define (t-typed! k)
      (fact 'nn-in-rr k)
      (if (not (dk-asm? (list 'IN (list '* k h) 'RR)))
          (begin (dk-have! (list 'AND (list 'IN k 'RR) (list 'IN h 'RR))) (fact 'rr-mul-closed k h)))
      (if (not (dk-asm? (list 'IN (tk k) 'RR)))
          (begin (dk-have! (list 'AND '(IN a RR) (list 'IN (list '* k h) 'RR))) (fact 'rr-add-closed 'a (list '* k h)))))
    (define (t-in-ab! k)                       ; k <= m + 1
      (t-typed! k)
      (if (not (dk-asm? (list 'IN (tk k) ab)))
          (begin
            (dk-have! (list '<= 0 k) (lambda () (dk-nn!)))
            (dk-have! (list 'AND (list '<= 0 k) (list '<= 0 h))) (fact 'rr-leq-mul-nonneg k h)
            (dk-have! (list 'AND (list 'IN (list '+ m 1) 'RR) (list 'IN h 'RR))) (fact 'rr-mul-closed (list '+ m 1) h)
            (dk-have! (list 'AND (list '<= 0 h) (list '<= k (list '+ m 1)))) (fact 'rr-le-scale-nonneg-right k (list '+ m 1) h)
            (cp-in-ccint! (tk k) 'a 'b (list '<= 0 (list '* k h)) (list '<= (list '* k h) (list '* (list '+ m 1) h))
                          (cp-pick 'grid (lambda (f) (and (dk-head-is? f '=) (dk-contains? f (list '+ m 1)) (dk-contains? f 'b))))))))
    (dk-have! (list '<= (list '+ m 1) (list '+ m 1)) (lambda () (dk-ineq!)))
    ;; the three families
    (dk-have! (list 'IN TQ '(FUN NN RR)) (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (t-typed! k) (ass))) (lambda () (ass)))))
    (define (ifc k) (list 'IF (list '<= k sm) (list 'pgam (tk k)) 0))
    (define (if-typed! k)                      ; (IN (ifc k) CC)
      (if (not (dk-asm? (list 'IN (ifc k) 'CC)))
          (dk-have! (list 'IN (ifc k) 'CC)
            (lambda ()
              (dk-case-if! (ifc k)
                (lambda (tv val) (if tv (begin (fact 'nn-in-rr k) (dk-have! (list '<= k (list '+ m 1)) (lambda () (dk-ineq! (list '<= k sm) (list '= sm (list '+ m 1)))))
                                               (t-in-ab! k) (fact 'fun-apply-type-c 'pgam ab 'CC (tk k)) (if (dk-asm? (dk-goal)) (ass)))
                                     (if (dk-asm? (dk-goal)) (ass)))))))))
    (dk-have! (list 'IN XQ '(FUN NN CC))
      (lambda () (dk-lam-type! (lambda () (let* ((k (dk-di-var!)) (lf (proof-state-focus *ps*))) (if-typed! k) (if (eq? lf (proof-state-focus *ps*)) (ass))))
                               (lambda () (ass)))))
    (fact 'ball-is-set 'CC-MS)
    (define (ball-pow! c)                      ; (IN (BALL CC-MS c eps) (POWER CC))
      (let ((B (list 'BALL 'CC-MS c eps)))
        (if (not (dk-asm? (list 'IN B '(POWER CC))))
            (dk-have! (list 'IN B '(POWER CC))
              (lambda () (fact 'ball-is-set 'CC-MS c eps) (mac 'power-set-membership)
                (for-each (lambda (l) (dk-focus! l)
                            (if (dk-asm? (dk-goal)) (ass)
                                (let* ((pl (dk-peel!)) (z (cadr (car pl))) (bi (dk-cite! 'ball-membership 'CC-MS c eps z)))
                                  (dk-have! (list 'IN z '(PTS CC-MS)) (lambda () (if (dk-only! bi (list 'IN z B)) (prop))))
                                  (subst '(= CC (PTS CC-MS))) (ass))))
                          (cp-split-goal!)))))))
    (dk-have! (list 'IN BS '(FUN NN (POWER CC)))
      (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!)))
                                             (if-typed! k)
                                             (let ((lf (proof-state-focus *ps*)))
                                               (ball-pow! (ifc k))
                                               (if (eq? lf (proof-state-focus *ps*)) (ass)))))
                               (lambda () (ass)))))
    ;; the hypotheses of good-approx-polygon
    (fact 'nn-in-rr 0)
    (t-typed! 0) (t-typed! sm)
    (dk-have! (list '= (list TQ 0) 'a) (lambda () (dk-lam-b!) (crs)))
    (dk-have! (list '= (list TQ sm) 'b)
      (lambda () (dk-lam-b!) (subst (list '= sm (list '+ m 1))) (ass)))
    (dk-have! (list '<= 0 sm) (lambda () (dk-nn!)))
    (dk-have! (list '<= sm sm) (lambda () (dk-nn!)))
    (dk-have! (list '<= 0 (list '+ m 1)) (lambda () (dk-ineq! (list '<= 0 sm) (list '= sm (list '+ m 1)))))
    (t-in-ab! 0)
    (dk-have! (list '= (tk sm) 'b) (lambda () (subst (list '= sm (list '+ m 1))) (ass)))
    (dk-have! (list '<= sm (list '+ m 1)) (lambda () (dk-ineq! (list '= sm (list '+ m 1)))))
    (t-in-ab! sm)
    (dk-have! (list '= (tk 0) 'a) (lambda () (crs)))
    (cp-in-ccint! 'a 'a 'b '(< a b)) (cp-in-ccint! 'b 'a 'b '(< a b))
    (for-each (lambda (pr)
                (let ((k (car pr)) (end (cadr pr)))
                  (dk-have! (list '= (list XQ k) (list 'pgam end))
                    (lambda ()
                      (dk-lam-b!)
                      (dk-if-branch! #t (ifc k) #f (lambda () #t))
                      (subst (list '= (tk k) end))
                      (fact 'fun-apply-type-c 'pgam ab 'CC end)
                      (rfl)))))
              (list (list 0 'a) (list sm 'b)))
    (let* ((pks (subst-free 'bs BS (subst-free 'xq XQ (subst-free 'tq TQ (cp-pks sm))))))
      (dk-have! pks
        (lambda ()
          (let* ((pl (dk-peel!)) (k (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) pl))))
                 (sk (list 'succ k)) (c (list 'pgam (tk k))) (B (list 'BALL 'CC-MS c eps)))
            (fact 'nn-succ-closed k)
            (fact 'nn-lt-succ-le k sm)
            (fact 'nn-succ-plus-one k)
            (fact 'nn-in-rr k) (fact 'nn-in-rr sk)
            (dk-have! (list '<= k sm) (lambda () (dk-nn!)))
            (dk-have! (list '<= k (list '+ m 1)) (lambda () (dk-ineq! (list '<= k sm) (list '= sm (list '+ m 1)))))
            (dk-have! (list '<= sk (list '+ m 1)) (lambda () (dk-ineq! (list '<= sk sm) (list '= sm (list '+ m 1)))))
            (t-in-ab! k) (t-in-ab! sk)
            (cp-ccint-parts! (tk k) 'a 'b) (cp-ccint-parts! (tk sk) 'a 'b)
            (fact 'fun-apply-type-c 'pgam ab 'CC (tk k)) (fact 'fun-apply-type-c 'pgam ab 'CC (tk sk))
            (dk-have! (list '= (list '* sk h) (list '+ (list '* k h) h)) (lambda () (subst (list '= sk (list '+ k 1))) (crs)))
            ;; |t_{k+1} - t_k| <= dl and |w - t_k| <= dl on the piece
            (define (close! w)                 ; w in [t_k, t_{k+1}]: (IN (pgam w) B)
              (cp-ccint-parts! w (tk k) (tk sk))
              (fact 'rr-sub-in-rr w (tk k))
              (dk-have! (list '<= (list '- 0 dl) (list '- w (tk k))) (lambda () (dk-ineq! (list '<= (tk k) w) (list '< 0 dl))))
              (dk-have! (list '<= (list '- w (tk k)) dl)
                (lambda () (dk-ineq! (list '<= w (tk sk)) (list '= (list '* sk h) (list '+ (list '* k h) h)) (list '<= h dl))))
              (dk-have! (list '<= (list '- dl) (list '- w (tk k))) (lambda () (dk-ineq! (list '<= (list '- 0 dl) (list '- w (tk k))))))
              (fact 'rr-abs-le-of-parts (list '- w (tk k)) dl)
              (cp-in-ccint! w 'a 'b (list '<= 'a (tk k)) (list '<= (tk k) w) (list '<= w (tk sk)) (list '<= (tk sk) 'b))
              (fact 'fun-apply-type-c 'pgam ab 'CC w)
              (let ((r (inst*! uc w (tk k))))
                (fact 'cc-sub-in-cc (list 'pgam w) c) (fact 'cc-magnitude-closed (list '- (list 'pgam w) c))
                (let ((bi (dk-cite! 'cc-ms-ball-membership c eps (list 'pgam w))))
                  (dk-have! (list '< (list 'magnitude (list '- (list 'pgam w) c)) eps)
                    (lambda () (dk-ineq! r (cp-pick 'half (lambda (f) (and (dk-head-is? f '=) (dk-contains? f e2) (dk-contains? f eps)))) (list '< 0 e2))))
                  (dk-have! (list 'IN (list 'pgam w) B)
                    (lambda () (if (dk-only! bi (list 'IN (list 'pgam w) 'CC) (list '< (list 'magnitude (list '- (list 'pgam w) c)) eps)) (prop)))))))
            (dk-have! (list '<= (tk k) (tk sk)) (lambda () (dk-ineq! (list '= (list '* sk h) (list '+ (list '* k h) h)) (list '< 0 h))))
            (cp-in-ccint! (tk sk) (tk k) (tk sk) (list '<= (tk k) (tk sk)))
            (close! (tk sk))
            (fact 'trace-value-in 'pgam 'a 'b (tk k))
            (fact 'subset-mem-fwd ktr 'u c)
            (fact 'cc-ms-ball-centre c eps)
            (dk-have! (list 'IN c '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
            (dk-have! (list 'AND (list 'IN eps 'RR) (list 'AND (list '<= 0 eps) (list 'NOT (list '= 0 eps)))))
            (fact 'ball-is-open 'CC-MS c eps)
            (let ((biff (dk-cite! 'cc-ms-open-iff B)))
              (dk-have! (list 'IS-OPEN '(NF-METRIC-SPACE CC-NORMED-FIELD) B) (lambda () (if (dk-only! biff (list 'IS-OPEN 'CC-MS B)) (prop)))))
            (fact 'cc-ball-is-convex c eps)
            (dk-split-all! (list (dk-apply! mg c)))
            (dk-have! (list '<= sk sm) (lambda () (dk-nn!)))
            (for-each
             (lambda (leaf)
               (dk-focus! leaf)
               (if (or (dk-contains? (dk-goal) TQ) (dk-contains? (dk-goal) XQ) (dk-contains? (dk-goal) BS)) (dk-lam-b!))
               (let loop ()
                 (let ((ifs (filter (lambda (t) (dk-contains? (dk-goal) t)) (list (ifc k) (ifc sk)))))
                   (if (pair? ifs) (begin (dk-if-branch! #t (car ifs) #f (lambda () #t)) (loop)))))
               (let ((g (dk-goal)))
                 (cond ((dk-asm? g) (ass))
                       ((dk-head-is? g '<) (dk-ineq! (list '= (list '* sk h) (list '+ (list '* k h) h)) (list '< 0 h)))
                       ((dk-head-is? g 'FORALL)
                        (let ((w (dk-di-var!))) (close! w) (ass)))
                       (#t (ass)))))
             (cp-split-goal!)))))
      (let ((res (dk-fact! 'good-approx-polygon 'u 'pgam 'a 'b m TQ XQ BS)))
        (dk-split-all! (list res))
        (ew (list 'POLY-ROAD TQ XQ m))
        (ew (list 'POLY-DER TQ XQ m))
        (for-each (lambda (l) (dk-focus! l) (ass)) (cp-split-goal!))))))
(qed 'polygonal-good-approx)

;;; ---------------------------------------------------------------------------
;;; THE TRACE OF A POLYGON whose k-th piece runs between two nodes of a ball B(xq k, eps) inside u lies in u
(define cp-bks
  '(FORALL hmk_ (IMPLIES (IN hmk_ NN) (IMPLIES (< hmk_ (succ m))
     (AND (< (tq hmk_) (tq (succ hmk_)))
     (AND (SUBSET (BALL CC-MS (xq hmk_) eps) u)
          (IN (xq (succ hmk_)) (BALL CC-MS (xq hmk_) eps))))))))
(sp (make-wff (forall-guarded '(u a b m tq xq eps)
  (list '(IN m NN) '(IN tq (FUN NN RR)) '(IN xq (FUN NN CC)) '(= (tq 0) a) '(= (tq (succ m)) b) '(POS-RR eps) cp-bks)
  (list 'SUBSET (list 'TRACE cp-P 'a 'b) 'u))))
(dk-peel!)
(let* ((sm '(succ m)) (bks (cp-pick 'bks (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'BALL))))))
  (fact 'nn-succ-closed 'm)
  (dk-have! '(IN 0 NN))
  (dk-have! (list '< 'm sm) (lambda () (dk-nn!)))
  (dk-pos-parts! 'eps)
  (dk-have! (subst-free 'n sm cp-inc)
    (lambda () (let ((j (dk-di-var!))) (di) (dk-split-all! (list (dk-apply! bks j))) (ass))))
  (dk-split-all! (list (dk-fact! 'poly-road-facts 'm sm 'tq 'xq)))
  (let* ((pv (cp-pick 'pv (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'th) (dk-contains? z cp-P))))))
    (mac 'subset-def)
    (let* ((pl (dk-peel!)) (z (cadr (car pl))) (tr (list 'TRACE cp-P 'a 'b)))
      (fact 'trace-unfold cp-P 'a 'b)
      (dk-rewrite-h! (list 'IN z tr) tr (list 'IMAGE cp-P '(CCINT a b)))
      (let ((iff (dk-cite! 'image-membership-iff cp-P '(CCINT a b) z)))
        (dk-have! (caddr iff) (lambda () (prop)))
        (dk-split! (caddr iff))
        (let* ((x (dk-skolem! (cp-pick 'ex (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f z)))) #t)))
          (dk-have! (list 'IN x (list 'CCINT '(tq 0) (list 'tq sm)))
            (lambda () (subst '(= (tq 0) a)) (subst (list '= (list 'tq sm) 'b)) (ass)))
          (let* ((k (dk-skolem! (inst*! (dk-fact! 'poly-piece-locate 'm sm 'tq) x) #t)))
            (dk-split-all!)
            (let* ((sk (list 'succ k)) (c (list 'xq k)) (B (list 'BALL 'CC-MS c 'eps)))
              (fact 'nn-succ-closed k) (cp-types! k sk)
              (dk-have! (list '< k sm) (lambda () (dk-nn!)))
              (dk-split-all! (list (dk-apply! bks k)))
              (fact 'cc-ms-ball-centre c 'eps)
              (fact 'cc-ball-is-convex c 'eps)
              (fact 'aff-seg-in-convex c (list 'xq sk) (list 'tq k) (list 'tq sk) B x)
              (dk-have! (list 'IN (list cp-P x) B) (lambda () (subst (inst*! pv k x)) (ass)))
              (fact 'subset-mem-fwd B 'u (list cp-P x))
              (subst (list '= z (list cp-P x)))
              (ass))))))))
(qed 'poly-trace-in)

