;;; g(pi(u)) = phi(u) on S^3: g(pi(a, b)) = phi(2 a conj(b), 2 b conj(b)) = phi(a, b)
(sp (make-wff "forall([u in cc2-sphere], hopf-quotient-map(hopf-map(u)) = homog-point(nth(1, u), nth(2, u)))"))
(let* ((u (dk-di-var!))
       (ab (hps-open-s3! u)) (a (car ab)) (b (cadr ab))
       (ca (hps-cj a)) (cb (hps-cj b))
       (p1 (hps-pi1 a b)) (p2 (hps-pi2 a b))
       (k (list '* 2 cb)))
  (subst (list '= u (list 'LIST a b)))
  (hps-sets! a b)
  (nth-r)
  (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'rr-zero-in) (fact 'rr-one-in)
  (hps-type! ca) (hps-type! cb) (hps-mag-facts! a) (hps-mag-facts! b)
  (let* ((s3 (dk-cite! 'hopf-maps-sphere (list 'LIST a b)))
         (pab (dk-cite! 'hopf-map-pair a b))
         (s2 (dk-rewrite-h! s3 (cadr pab) (caddr pab))))
    (subst pab)
    (subst (dk-cite! 'hopf-quotient-map-apply (list 'LIST p1 p2)))
    (hps-type! p1) (hps-real! p2) (hps-sets! p1 p2)
    (nth-r)
    (let ((sqa (dk-cite! 'cc-magnitude-sq-conjugate a))
          (sqb (dk-cite! 'cc-magnitude-sq-conjugate b)))
      (hps-type! k)
      (dk-have! (list '= (list '- 1 p2) (list '* k b))
        (lambda ()
          (subst (list '= 1 (list '+ (hps-msq a) (hps-msq b))))
          (subst sqa) (subst sqb)
          (crs)))
      (dk-have! (list '= p1 (list '* k a)) (lambda () (crs)))
      (subst (list '= (list '- 1 p2) (list '* k b)))
      (subst (list '= p1 (list '* k a)))
      (hps-type! (list '* k a)) (hps-type! (list '* k b))
      (use-em (list '= b 0)
        (lambda ()
          (subst (list '= b 0))
          (dk-cite! 'cc-conjugate-closed 0)
          (hps-type! '(* 2 (conjugate 0)))
          (hps-type! (list '* '(* 2 (conjugate 0)) a))
          (hps-crs-rewrite! '(* (* 2 (conjugate 0)) 0) 0)
          (subst (dk-cite! 'homog-point-at-inf (list '* '(* 2 (conjugate 0)) a)))
          (subst (dk-cite! 'homog-point-at-inf a))
          (hps-finish!))
        (lambda ()
          ;; k = 2 conj(b) /= 0, since |k| = 2 |b| and |b| /= 0
          (dk-have! (list 'NOT (list '= k 0))
            (lambda ()
              (di)
              (hps-real! 2) (dk-cite! 'rr-subset-cc 2)
              (hps-mag-facts! k)
              (dk-cite! 'cc-magnitude-zero)
              (dk-cite! 'cc-magnitude-conjugate b)
              (let* ((mk (dk-congr! (list '= k 0) (lambda (t) (list 'magnitude t))))
                     (mm (hps-cite-and! 'cc-magnitude-mul (list '(IN 2 CC) (list 'IN cb 'CC)) 2 cb))
                     (m1 (dk-rewrite-h! (list '= (list 'magnitude k) '(magnitude 0)) (list 'magnitude k)
                                        (list '* '(magnitude 2) (list 'magnitude cb))))
                     (m2 (dk-rewrite-h! m1 '(magnitude 0) 0))
                     (m3 (dk-rewrite-h! m2 (list 'magnitude cb) (list 'magnitude b)))
                     (ma (dk-cite! 'rr-magnitude-is-abs 2)))
                (dk-have! '(<= 0 2) (lambda () (dk-ineq!)))
                (dk-cite! 'rr-abs-of-nonneg 2)
                (let* ((m4 (dk-rewrite-h! (dk-rewrite-h! m3 '(magnitude 2) '(abs 2)) '(abs 2) 2)))
                  (dk-have! (list '= (list 'magnitude b) 0) (lambda () (dk-ineq! m4)))
                  (let ((iff (dk-cite! 'cc-magnitude-zero-iff b)))
                    (dk-meta-iff-r! iff)
                    (let ((leaf (proof-state-focus *ps*)))
                      (dk-only! (list '= b 0) (list 'NOT (list '= b 0)))
                      (if (not (sequent-node-grounded? leaf)) (prop))))))))
          (subst (dk-cite! 'homog-point-scale a b k))
          (dk-cite! 'homog-point-in-cc-hat a b)
          (hps-finish!))))))
(qed 'hopf-quotient-factor)

;;; g is onto C u {oo}: w = phi(u0, v0) (homog-point-cover); normalise (u0, v0) onto S^3
(sp (make-wff "forall([w in cc-hat], forsome([z in unit-sphere-cr], hopf-quotient-map(z) = w))"))
(let* ((w (dk-di-var!))
       (ex (dk-cite! 'homog-point-cover w))
       (u0 (dk-skolem! ex))
       (ex2 (dk-pick (dk-head? 'FORSOME) "the inner existential"))
       (v0 (dk-skolem! ex2))
       (nz (list 'NOT (list 'AND (list '= u0 0) (list '= v0 0))))
       (we (list '= w (list 'HOMOG-POINT u0 v0)))
       (sm (list '+ (hps-msq u0) (hps-msq v0))))
  (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'rr-zero-in) (fact 'rr-one-in)
  (hps-mag-facts! u0) (hps-mag-facts! v0) (hps-real! sm)
  (dk-cite! 'rr-sq-nonneg (list 'magnitude u0)) (dk-cite! 'rr-sq-nonneg (list 'magnitude v0))
  (let* ((m1 (dk-name! (hps-msq u0) 'RR)) (m2 (dk-name! (hps-msq v0) 'RR))
         (g1 (dk-rewrite-h! (list '<= 0 (hps-msq u0)) (hps-msq u0) m1))
         (g2 (dk-rewrite-h! (list '<= 0 (hps-msq v0)) (hps-msq v0) m2)))
    (dk-have! (list '<= 0 sm)
      (lambda () (subst (list '= (hps-msq u0) m1)) (subst (list '= (hps-msq v0) m2))
                 (dk-ineq! (list '<= 0 m1) (list '<= 0 m2) (list '= m1 (hps-msq u0)) (list '= m2 (hps-msq v0)))))
    ;; sm /= 0
    (dk-have! (list 'NOT (list '= sm 0))
      (lambda ()
        (di)
        (dk-have! (list 'AND (list '= u0 0) (list '= v0 0))
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (let* ((g (dk-goal)) (t (cadr g))
                       (mt (if (equal? t u0) m1 m2))
                       (sq (dk-cite! 'cc-magnitude-sq-conjugate t)))
                  (dk-cite! 'cc-conjugate-closed t)
                  (dk-have! (list '= (list '* t (list 'conjugate t)) 0)
                    (lambda ()
                      (subst (list '= (list '* t (list 'conjugate t)) (hps-msq t)))
                      (subst (list '= (hps-msq t) mt))
                      (dk-ineq! (list '<= 0 m1) (list '<= 0 m2) (list '= m1 (hps-msq u0)) (list '= m2 (hps-msq v0))
                                (list '= sm 0))))
                  (dk-cite! 'cc-zero-of-self-conj-zero t)
                  (hps-finish!))))))
        (let ((leaf (proof-state-focus *ps*)))
          (dk-only! (list 'AND (list '= u0 0) (list '= v0 0)) nz)
          (if (not (sequent-node-grounded? leaf)) (prop))))))
  ;; N = sqrt(sm), k = 1/N
  (let* ((ex3 (hps-cite-and! 'sqrt-exists (list (list 'IN sm 'RR) (list '<= 0 sm)) sm))
         (nn0 (dk-skolem! ex3))
         (nsq (list '= (list '* nn0 nn0) sm))
         (nnz (list 'NOT (list '= nn0 0))))
    (dk-have! nnz
      (lambda ()
        (di)
        (let ((h (dk-rewrite-h! nsq nn0 0)))
          (dk-have! (list '= sm 0) (lambda () (subst (list '= sm (list '* 0 0))) (crs))))
        (let ((leaf (proof-state-focus *ps*)))
          (dk-only! (list '= sm 0) (list 'NOT (list '= sm 0)))
          (if (not (sequent-node-grounded? leaf)) (prop)))))
    (hps-cite-and! 'rr-recip-closed (list (list 'IN nn0 'RR) nnz) nn0)
    (let* ((inv (hps-cite-and! 'rr-recip-inverse (list (list 'IN nn0 'RR) nnz) nn0))
           (k (dk-name! (list 'recip nn0) 'RR))
           (inv2 (dk-rewrite-h! inv (list 'recip nn0) k))
           (a (list '* k u0)) (b (list '* k v0)))
      (dk-cite! 'rr-subset-cc k) (dk-cite! 'rr-subset-cc nn0)
      (dk-have! (list 'NOT (list '= k 0))
        (lambda ()
          (di)
          (let ((h (dk-rewrite-h! inv2 k 0)))
            (dk-have! (list '= (list '* nn0 0) 0) (lambda () (crs)))
            (dk-rewrite-h! h (list '* nn0 0) 0)
            (dk-absurd! '(= 0 1)))))
      (hps-type! a) (hps-type! b) (hps-mag-facts! k) (hps-mag-facts! a) (hps-mag-facts! b)
      ;; [a, b] on S^3
      (dk-cite! 'rr-magnitude-sq k)
      (for-each (lambda (t u)
                  (hps-cite-and! 'cc-magnitude-mul (list (list 'IN k 'CC) (list 'IN u 'CC)) k u))
                (list a b) (list u0 v0))
      (let ((s3 (dk-cite! 'cc2-sphere-pair a b)))
        (dk-have! (list '= (list '+ (hps-msq a) (hps-msq b)) 1)
          (lambda ()
            (subst (list '= (list 'magnitude a) (list '* (list 'magnitude k) (list 'magnitude u0))))
            (subst (list '= (list 'magnitude b) (list '* (list 'magnitude k) (list 'magnitude v0))))
            (hps-crs-rewrite! (list '+ (hps-sq (list '* (list 'magnitude k) (list 'magnitude u0)))
                                       (hps-sq (list '* (list 'magnitude k) (list 'magnitude v0))))
                              (list '* (hps-msq k) sm))
            (subst (list '= (hps-msq k) (list '* k k)))
            (subst (list '= sm (list '* nn0 nn0)))
            (hps-crs-rewrite! (list '* (list '* k k) (list '* nn0 nn0)) (list '* (list '* nn0 k) (list '* nn0 k)))
            (subst inv2)
            (crs)))
        (dk-meta-iff-l! s3))
      ;; z = pi(a, b)
      (let* ((z (list 'HOPF-MAP (list 'LIST a b)))
             (zs (dk-cite! 'hopf-maps-sphere (list 'LIST a b)))
             (gf (dk-cite! 'hopf-quotient-factor (list 'LIST a b))))
        (hps-sets! a b)
        (let ((gf2 (dk-nth-h! gf)))
          (dk-cite! 'homog-point-scale u0 v0 k)
          (dk-have! (list '= (list 'HOPF-QUOTIENT-MAP z) w)
            (lambda ()
              (subst gf2)
              (subst (list '= (list 'HOMOG-POINT a b) (list 'HOMOG-POINT u0 v0)))
              (subst (list '= w (list 'HOMOG-POINT u0 v0)))
              (dk-cite! 'homog-point-in-cc-hat u0 v0)
              (hps-finish!)))
          (ew z)
          (dk-conj-close! (lambda () (hps-finish!))))))))
(qed 'hopf-quotient-map-onto)

;;; g is one-to-one: p = pi(u), q = pi(v) (pi onto S^2); g(p) = g(q) is phi(u) = phi(v), so
;;; v = r u with |r| = 1 (homog-point-sphere-eq) and pi(v) = pi(u)
(define (hps-s2-vars landed)
  (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'UNIT-SPHERE-CR))) landed)))
(sp (make-wff "forall([z1 in unit-sphere-cr, z2 in unit-sphere-cr],
   hopf-quotient-map(z1) = hopf-quotient-map(z2) implies z1 = z2)"))
(let* ((landed (dk-peel!))
       (pq (hps-s2-vars landed)) (p (car pq)) (q (cadr pq))
       (e (find-first (dk-head? '=) landed))
       (u (dk-skolem! (dk-cite! 'hopf-onto-sphere p)))
       (v (dk-skolem! (dk-cite! 'hopf-onto-sphere q)))
       (eu (list '= (list 'HOPF-MAP u) p))
       (ev (list '= (list 'HOPF-MAP v) q))
       (e1 (dk-rewrite-h! (dk-rewrite-h! e p (list 'HOPF-MAP u)) q (list 'HOPF-MAP v)))
       (fu (dk-cite! 'hopf-quotient-factor u))
       (fv (dk-cite! 'hopf-quotient-factor v))
       (e2 (dk-rewrite-h! (dk-rewrite-h! e1 (cadr fu) (caddr fu)) (cadr fv) (caddr fv)))
       (ab (hps-open-s3! u)) (a (car ab)) (b (cadr ab))
       (cd (hps-open-s3! v)) (c (car cd)) (d (cadr cd)))
  (hps-sets! a b c d)
  (let* ((e3 (dk-rewrite-h! (dk-rewrite-h! e2 u (list 'LIST a b)) v (list 'LIST c d)))
         (e4 (dk-nth-h! e3))
         (r (dk-skolem! (dk-cite! 'homog-point-sphere-eq a b c d))))
    (subst (list '= p (list 'HOPF-MAP u)))
    (subst (list '= q (list 'HOPF-MAP v)))
    (subst (list '= u (list 'LIST a b)))
    (subst (list '= v (list 'LIST c d)))
    (subst (list '= c (list '* r a)))
    (subst (list '= d (list '* r b)))
    (subst (dk-cite! 'hopf-map-unimodular-scale r a b))
    (subst (dk-cite! 'hopf-map-pair a b))
    (hps-type! (hps-pi1 a b)) (hps-real! (hps-pi2 a b))
    (hps-sets! (hps-pi1 a b) (hps-pi2 a b))
    (dk-cite! 'pair-in-cartesian 'CC 'RR (hps-pi1 a b) (hps-pi2 a b))
    (hps-finish!)))
(qed 'hopf-quotient-map-injective)

;;; Cor. 1.24
(sp (make-wff "hopf-quotient-map in bijection(unit-sphere-cr, cc-hat)"))
(let ((iff (dk-cite! 'bijection-membership-iff 'UNIT-SPHERE-CR 'CC-HAT 'HOPF-QUOTIENT-MAP)))
  (dk-cite! 'hopf-quotient-map-in-fun)
  (dk-cite! 'hopf-quotient-map-injective)
  (dk-cite! 'hopf-quotient-map-onto)
  (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (ass)))))
  (dk-meta-iff-l! iff)
  (hps-finish!))
(qed 'hopf-quotient-map-bijection)

(sp (make-wff "forsome([g in fun(unit-sphere-cr, cc-hat)], g in bijection(unit-sphere-cr, cc-hat) and
   forall([u in cc2-sphere], g(hopf-map(u)) = homog-point(nth(1, u), nth(2, u))))"))
(dk-cite! 'hopf-quotient-map-in-fun)
(dk-cite! 'hopf-quotient-map-bijection)
(dk-cite! 'hopf-quotient-factor)
(ew 'HOPF-QUOTIENT-MAP)
(dk-conj-close! (lambda () (ass)))
(qed 'hopf-factors-through-bijection)

;;; ---- the relation ~ of Def. 1.17 on S^3, and the fibres in the notes' words ---------------------
;;; on S^3, u ~ v iff u = r v with |r| = 1 (the notes, before (16))
(sp (make-wff "forall([u in cc2-sphere, v in cc2-sphere], homog-equiv(u, v) iff
   forsome([hr_ in cc], magnitude(hr_) = 1 and u = [hr_ * nth(1, v), hr_ * nth(2, v)]))"))
(let* ((uv (hps-s3-vars (dk-peel!)))
       (u (car uv)) (v (cadr uv))
       (ab (hps-open-s3! u)) (a (car ab)) (b (cadr ab))
       (cd (hps-open-s3! v)) (c (car cd)) (d (cadr cd)))
  (hps-sets! a b c d)
  (let* ((he (dk-cite! 'homog-equiv u v))
         (he2 (dk-rewrite-h! (dk-rewrite-h! he u (list 'LIST a b)) v (list 'LIST c d)))
         (he3 (dk-nth-h! he2)))
    (subst (list '= u (list 'LIST a b)))
    (subst (list '= v (list 'LIST c d)))
    (nth-r)
    (fact 'cc-zero-in)
    (dk-iff! (lambda (g) (dk-head-is? g 'FORSOME))
      (lambda ()
        (let* ((ex (dk-meta-iff-r! he3))
               (z (dk-skolem! ex)))
          (hps-type! (list '* z c)) (hps-type! (list '* z d))
          (hps-pair-eq! a b (list '* z c) (list '* z d))
          (dk-cite! 'cc2-sphere-unimodular c d a b z)
          (ew z)
          (dk-conj-close! (lambda () (hps-finish!)))))
      (lambda ()
        (let* ((ex (dk-pick (dk-head? 'FORSOME) "the existential"))
               (r (dk-skolem! ex)))
          (dk-have! (list 'NOT (list '= r 0))
            (lambda ()
              (di)
              (dk-cite! 'cc-magnitude-zero)
              (let ((h (dk-rewrite-h! (dk-rewrite-h! (list '= (list 'magnitude r) 1) r 0) '(magnitude 0) 0)))
                (dk-absurd! h))))
          (dk-have! (caddr he3)
            (lambda () (ew r) (dk-conj-close! (lambda () (hps-finish!)))))
          (dk-meta-iff-l! he3)
          (hps-finish!))))))
(qed 'cc2-sphere-equiv-iff)

;;; the notes: for u, v in S^3, pi(u) = pi(v) iff u ~ v
(sp (make-wff "forall([u in cc2-sphere, v in cc2-sphere], hopf-map(u) = hopf-map(v) iff homog-equiv(u, v))"))
(let* ((uv (hps-s3-vars (dk-peel!)))
       (u (car uv)) (v (cadr uv))
       (i1 (dk-cite! 'hopf-fibre-iff v u))
       (i2 (dk-cite! 'cc2-sphere-equiv-iff u v))
       (hu (list 'HOPF-MAP u)) (hv (list 'HOPF-MAP v)))
  (for-each (lambda (w)
              (let ((m (dk-cite! 'cc2-sphere-membership w)))
                (dk-split-all! (list (dk-meta-iff-r! m))))
              (dk-cite! 'hopf-map-in-cr w))
            (list u v))
  (let ((sym (list 'IFF (list '= hu hv) (list '= hv hu))))
    (dk-have! sym
      (lambda ()
        (dk-iff! (lambda (g) (equal? g (list '= hv hu)))
          (lambda () (subst (list '= hv hu)) (hps-finish!))
          (lambda () (subst (list '= hu hv)) (hps-finish!)))))
    (dk-only! i1 i2 sym)
    (prop)))
(qed 'hopf-fibre-equiv)

;;; (17) at a point of C^2: |pi(w)_1|^2 + pi(w)_2^2 = (|w_1|^2 + |w_2|^2)^2
(sp (make-wff "forall([w in cartesian(cc, cc)],
   magnitude(nth(1, hopf-map(w))) * magnitude(nth(1, hopf-map(w))) + nth(2, hopf-map(w)) * nth(2, hopf-map(w))
   = (magnitude(nth(1, w)) * magnitude(nth(1, w)) + magnitude(nth(2, w)) * magnitude(nth(2, w)))
   * (magnitude(nth(1, w)) * magnitude(nth(1, w)) + magnitude(nth(2, w)) * magnitude(nth(2, w))))"))
(let* ((w (dk-di-var!))
       (ab (hps-open-pair! w 'CC 'CC))
       (a (car ab)) (b (cadr ab)))
  (subst (list '= w (list 'LIST a b)))
  (subst (dk-cite! 'hopf-map-pair a b))
  (hps-sets! a b)
  (hps-type! (hps-pi1 a b)) (hps-real! (hps-pi2 a b))
  (hps-sets! (hps-pi1 a b) (hps-pi2 a b))
  (nth-r)
  (dk-cite! 'hopf-norm-identity a b)
  (hps-finish!))
(qed 'hopf-norm-identity-point)
