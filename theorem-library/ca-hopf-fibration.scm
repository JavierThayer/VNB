  (dk-meta-iff-l! ci))
(dk-cite! 'unit-sphere-cr-subset)
(dk-cite! 'subclass-of-set-is-set 'UNIT-SPHERE-CR '(CARTESIAN CC RR))
(hps-finish!)
(qed 'unit-sphere-cr-in-set)

(sp (make-wff "hopf-quotient-map in fun(unit-sphere-cr, cc-hat)"))
(fact 'hopf-quotient-map-def)
(subst (list '= 'HOPF-QUOTIENT-MAP hps-g-body))
(dk-lam-type!
  (lambda ()
    (let* ((leaf (proof-state-focus *ps*))
           (p (dk-di-var!)))
      (hps-open-s2! p)
      (fact 'rr-one-in)
      (hps-type! (list '- 1 (list 'NTH 2 p)))
      (dk-cite! 'homog-point-in-cc-hat (list 'NTH 1 p) (list '- 1 (list 'NTH 2 p)))
      (if (not (sequent-node-grounded? leaf)) (hps-finish!))))
  (lambda () (dk-cite! 'unit-sphere-cr-in-set) (ass)))
(qed 'hopf-quotient-map-in-fun)

(sp (make-wff "forall([p in unit-sphere-cr], hopf-quotient-map(p) = homog-point(nth(1, p), 1 - nth(2, p)))"))
(let ((p (dk-di-var!)))
  (fact 'hopf-quotient-map-def)
  (subst (dk-cite! 'apply-congruence-1 'HOPF-QUOTIENT-MAP hps-g-body p))
  (hps-open-s2! p)
  (fact 'rr-one-in)
  (hps-type! (list '- 1 (list 'NTH 2 p)))
  (dk-cite! 'homog-point-in-cc-hat (list 'NTH 1 p) (list '- 1 (list 'NTH 2 p)))
  (dk-lam-b!)
  (hps-finish!))
