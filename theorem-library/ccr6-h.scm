;;; =======================================================================
;;; 3. (66): w_K(lam_A(y, x), 1) = W_A(y, x)

(define (c6h-wstmt vars guards body)
  `(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL wk (IMPLIES (IS-BILINEAR-BICHARACTER kf wk)
     (FORALL n (IMPLIES (IN n NN) (IMPLIES (<= 1 n)
       (FORALL mtx (IMPLIES (IN mtx (MAT n n (CARR kf))) ,(forall-guarded vars guards body)))))))))))
(define (c6h-setup!)
  (dk-peel!)
  (c6h-mat-setup!)
  (c6h-wk-parts!))

;; a lane: forall z in I, (L z) in CARR kf (L a one-variable lambda over I whose body c6h-carr! types)
(define (c6h-ptype! L)
  (dk-have! `(FORALL c6hz_ (IMPLIES (IN c6hz_ ,c6h-I) (IN (,L c6hz_) (CARR kf))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (c6h-iv! z)
        (c6h-lb!)
        (c6h-carr! (cadr (dk-goal)))
        (dk-close-if-asm!)))))
(define (c6h-ftype! L)                   ; (IN L (FUN I (CARR V)))
  (dk-have! `(IN ,L (FUN ,c6h-I (CARR ,c6h-v)))
    (lambda ()
      (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (c6h-iv! z) (c6h-lb!) (c6h-carr! (cadr (dk-goal))) (dk-close-if-asm!)))
                    (lambda () (dk-ass!))))))

;; the row lemma: w_K(c (A x)_i, 1) = prod_j w_K(a_ij c, x_j)
(sp (make-wff (c6h-wstmt '(x i c) `((IN x ,c6h-VE) (IN i ,c6h-I) (IN c (CARR kf)))
  `(= (wk ((MUL ,c6h-v) c (ENTRY ,(c6h-B 'x) i 1)) (ONE kf)) ,(c6h-Prow 'i 'c 'x)))))
(c6h-setup!)
(c6h-row-types! 'x)
(c6h-iv! 'i)
(c6h-cv! 'c)
(let* ((me (dk-cite! 'matmul-entry c6h-v 'n 'n 1 'mtx (c6h-T 'x) 'i 1))
       (L2 (caddr (caddr me))))
  (subst me)
  (c6h-ftype! L2)
  (let* ((ds (dk-cite! 'finsum-ring-distrib-left-gen c6h-v 'c c6h-I L2))
         (L3 (caddr (caddr ds))))
    (subst ds)
    (c6h-ptype! L3)
    (let* ((e1 (dk-cite! 'c6h-wk-finsum-l 'kf 'wk '(ONE kf) 'n L3))
           (G3 (caddr (caddr e1)))
           (Gt (caddr (c6h-Prow 'i 'c 'x))))
      (dk-have! `(FORALL c6hz_ (IMPLIES (IN c6hz_ ,c6h-I) (= (,G3 c6hz_) (,Gt c6hz_))))
        (lambda ()
          (let* ((z (dk-di-var!)) (a `(ENTRY mtx i ,z)) (xz `(x ,z)))
            (c6h-iv! z)
            (dk-lam-b!)
            (dk-cite! 'transpose-entry `(RING-ROW ,c6h-v n x) 1 'n `(CARR ,c6h-v) z 1)
            (subst `(= (ENTRY ,(c6h-T 'x) ,z 1) (ENTRY (RING-ROW ,c6h-v n x) 1 ,z)))
            (subst (dk-cite! 'ring-row-entry c6h-v 'n 'x z))
            (c6h-carr! a) (c6h-carr! xz)
            (let ((ac `((MUL ,c6h-v) ,a c)))
              (c6h-carr! ac)
              (dk-have! `(= ((MUL ,c6h-v) c ((MUL ,c6h-v) ,a ,xz)) ((MUL ,c6h-v) ,xz ,ac)) (lambda () (crs)))
              (subst `(= ((MUL ,c6h-v) c ((MUL ,c6h-v) ,a ,xz)) ((MUL ,c6h-v) ,xz ,ac)))
              (subst `(== (MUL ,c6h-v) (MUL kf)))
              (let ((ack `((MUL kf) ,a c)))
                (c6h-carr! ack)
                (dk-apply! (c6h-bil) xz ack '(ONE kf))
                (subst `(= (wk ((MUL kf) ,xz ,ack) (ONE kf)) (wk ,ack ((MUL kf) ,xz (ONE kf)))))
                (dk-have! `(= ((MUL kf) ,xz (ONE kf)) ,xz)
                  (lambda ()
                    (dk-cite! 'ring-mul-right-id c6h-v xz)
                    (subst `(= (MUL kf) (MUL ,c6h-v)))
                    (subst `(= (ONE kf) (ONE ,c6h-v)))
                    (dk-close-if-asm!)))
                (subst `(= ((MUL kf) ,xz (ONE kf)) ,xz))
                (c6h-wk-uc! ack xz)
                (rfl))))))
      (dk-cite! 'finsum-cm-congruence-q c6h-cm c6h-I G3 Gt)
      (dk-rewrite-h! e1 `(FINSUM ,c6h-cm ,G3 ,c6h-I) `(FINSUM ,c6h-cm ,Gt ,c6h-I))
      (dk-close-if-asm!))))
(c6h-qed! 'c6h-row)

;; (66)
(sp (make-wff (c6h-wstmt '(y x) `((IN y ,c6h-VE) (IN x ,c6h-VE))
  `(= (wk ,(c6h-mf 'y 'x) (ONE kf)) ,(c6h-W 'y 'x)))))
(c6h-setup!)
(c6h-row-types! 'x)
(dk-cite! 'ring-row-type c6h-v 'n 'y)
(dk-cite! 'matmul-type c6h-v 1 'n 1 `(RING-ROW ,c6h-v n y) (c6h-B 'x))
(let* ((me (dk-cite! 'matmul-entry c6h-v 1 'n 1 `(RING-ROW ,c6h-v n y) (c6h-B 'x) 1 1))
       (L (caddr (caddr me))))
  (subst me)
  (c6h-ptype! L)
  (let* ((e1 (dk-cite! 'c6h-wk-finsum-l 'kf 'wk '(ONE kf) 'n L))
         (G1 (caddr (caddr e1)))
         (G (caddr (c6h-W 'y 'x))))
    (dk-have! `(FORALL c6hz_ (IMPLIES (IN c6hz_ ,c6h-I) (= (,G1 c6hz_) (,G c6hz_))))
      (lambda ()
        (let* ((z (dk-di-var!)))
          (c6h-iv! z)
          (dk-lam-b!)
          (subst (dk-cite! 'ring-row-entry c6h-v 'n 'y z))
          (c6h-carr! `(y ,z))
          (dk-cite! 'c6h-row 'kf 'wk 'n 'mtx 'x z `(y ,z))
          (dk-close-if-asm!))))
    (dk-cite! 'finsum-cm-congruence-q c6h-cm c6h-I G1 G)
    (dk-rewrite-h! e1 `(FINSUM ,c6h-cm ,G1 ,c6h-I) `(FINSUM ,c6h-cm ,G ,c6h-I))
    (dk-close-if-asm!)))
(c6h-qed! 'ccr-6-24-converse-66)

;;; =======================================================================
;;; 4. The converse of 6.24.

(sp (make-wff (c6h-wstmt '() '()
  `(FORSOME c6hw_ (AND (IS-E-BILINEAR-BICHARACTER kf ,c6h-E c6hw_)
     (FORALL y (IMPLIES (IN y ,c6h-VE) (FORALL x (IMPLIES (IN x ,c6h-VE) (= (c6hw_ y x) ,(c6h-W 'y 'x)))))))))))
(c6h-setup!)
(dk-cite! 'c6h-kn-vector-space 'kf 'n)
(dk-cite! 'c6h-form-bilinear 'kf 'n 'mtx)
(let* ((ex (dk-cite! 'ccr-6-32-converse 'kf 'wk c6h-E c6h-LAM))
       (ld (dk-landed (lambda () (dk-skolem! ex))))
       (bil (dk-pick (lambda (f) (dk-head-is? f 'IS-E-BILINEAR-BICHARACTER)) "the bicharacter"))
       (w (cadddr bil))
       (split! (let loop ()
                 (let ((c (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f w))) (dk-asms))))
                   (if c (begin (dk-split! c) (loop))))))
       (val (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f w)
                                      (pair? (caddr f)) (dk-head-is? (caddr f) 'IMPLIES)
                                      (equal? (caddr (cadr (caddr f))) c6h-VE)))
                     "the value law")))
  (ew w)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (dk-ass!)
          (begin
            (dk-peel!)
            (let* ((g (dk-goal)) (y (cadr (cadr g))) (x (caddr (cadr g))))
              (let* ((h1 (dk-apply! val y x))
                     (h2 (begin (dk-lam-b-h! h1) (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) `(,w ,y ,x))
                                                                            (not (dk-contains? f c6h-LAM)))) "the reduced value")))
                     (e66 (dk-cite! 'ccr-6-24-converse-66 'kf 'wk 'n 'mtx y x)))
                (dk-rewrite-h! h2 (cadr e66) (caddr e66))
                (dk-close-if-asm!))))))))
(c6h-qed! 'ccr-6-24-converse)
