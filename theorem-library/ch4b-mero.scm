            (use-em (list '= y 'a)
              (lambda ()
                (subst (list '= y 'a))
                (fact 'fun-apply-type-c h B 'CC 'a)
                (dk-have! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'del (list 'AND '(POS-RR del)
                            (list 'FORALL 'b (list 'IMPLIES (list 'IN 'b B) (list 'IMPLIES '(< (magnitude (- b a)) del)
                              (list '<= (list 'magnitude (list '- (list h 'b) (list h 'a))) 'eps))))))))
                  (lambda () (mr-mod-at-a! B h Mp pb-pt! b-pt! r0 M)))
