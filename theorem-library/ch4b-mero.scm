;; the modulus of h at a: |h(b) - h(a)| = |b - a| |f(b)| <= |b - a| Mp
(define (mr-mod-at-a! B h Mp pb-pt! b-pt! r0 M)
  (let* ((lk (dk-peel!)) (eps (cadr (car (filter (lambda (fm) (dk-head-is? fm 'POS-RR)) lk))))
         (del (list '* eps (list 'recip Mp))))
    (fact 'rr-pos-rr-in-rr eps) (fact 'rr-lt-of-pos-rr eps)
    (fact 'rr-pos-ne-zero Mp)
    (mr-and! (list 'IN Mp 'RR) (list 'NOT (list '= Mp 0)))
    (fact 'rr-recip-closed Mp) (fact 'rr-recip-pos Mp) (fact 'rr-recip-inverse Mp)
    (mr-rr! del)
    (dk-have! (list '< 0 del) (lambda () (fact 'rr-mul-pos eps (list 'recip Mp)) (if (pair? (dk-open-leaves)) (ass))))
    (fact 'rr-pos-rr-of-lt del)
    (ew del)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
            (let* ((lk2 (dk-peel!)) (mr-bpt (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) B))) lk2))))
                   (leaf (proof-state-focus *ps*)) (mb (list 'magnitude (list '- mr-bpt 'a))))
              (b-pt! mr-bpt)
              (fact 'fun-apply-type-c h mr-bpt 'CC mr-bpt)
              (use-em (list '= mr-bpt 'a)
                (lambda ()
                  (subst (list '= mr-bpt 'a))
                  (dk-have! (list '= (list '- (list h 'a) (list h 'a)) 0) (lambda () (crs)))
                  (subst (list '= (list '- (list h 'a) (list h 'a)) 0))
                  (fact 'cc-magnitude-zero)
                  (subst '(= (magnitude 0) 0))
                  (dk-ineq! (list '< 0 eps) (list 'IN eps 'RR)))
                (lambda ()
                  (mr-pb-in! 'a r0 mr-bpt) (pb-pt! mr-bpt)
                  (dk-have! (list '= (list h mr-bpt) (list '* (list '- mr-bpt 'a) (list 'f mr-bpt)))
                    (lambda () (mr-lam-b!) (dk-if-branch! #f (cadr (dk-goal)) (lambda () (ass)) (lambda () (if (pair? (dk-open-leaves)) (begin (mr-cc! (caddr (dk-goal))) (rfl)))))))
                  (dk-have! (list '= (list h 'a) 0) (lambda () (mr-lam-b!) (dk-if-branch! #t (cadr (dk-goal)) (lambda () (rfl)) (lambda () (if (pair? (dk-open-leaves)) (rfl))))))
                  (subst (list '= (list h mr-bpt) (list '* (list '- mr-bpt 'a) (list 'f mr-bpt))))
                  (subst (list '= (list h 'a) 0))
                  (mr-cc! (list '* (list '- mr-bpt 'a) (list 'f mr-bpt)))
                  (dk-have! (list '= (list '- (list '* (list '- mr-bpt 'a) (list 'f mr-bpt)) 0) (list '* (list '- mr-bpt 'a) (list 'f mr-bpt))) (lambda () (crs)))
                  (subst (list '= (list '- (list '* (list '- mr-bpt 'a) (list 'f mr-bpt)) 0) (list '* (list '- mr-bpt 'a) (list 'f mr-bpt))))
                  (mr-and! (list 'IN (list '- mr-bpt 'a) 'CC) (list 'IN (list 'f mr-bpt) 'CC))
                  (dk-cite! 'cc-magnitude-mul (list '- mr-bpt 'a) (list 'f mr-bpt))
                  (subst (list '= (list 'magnitude (list '* (list '- mr-bpt 'a) (list 'f mr-bpt))) (list '* mb (list 'magnitude (list 'f mr-bpt)))))
                  (mr-rr! mb) (fact 'cc-magnitude-nonneg (list '- mr-bpt 'a))
                  (dk-have! (list '<= (list 'magnitude (list 'f mr-bpt)) Mp)
                    (lambda () (dk-ineq! (list '<= (list 'magnitude (list 'f mr-bpt)) M) (list '<= M (list 'abs M)) (list 'IN (list 'magnitude (list 'f mr-bpt)) 'RR) (list 'IN M 'RR) (list 'IN (list 'abs M) 'RR))))
                  (let* ((P1 (list 'magnitude (list 'f mr-bpt)))
                         (rv (dk-name! (list 'recip Mp) 'RR)))
                    (dk-have! (list '<= 0 mb) (lambda () (ass)))
                    (dk-have! (list '<= 0 Mp) (lambda () (dk-ineq! (list '< 0 Mp))))
                    (fact 'rr-mul-le-right P1 Mp mb)
                    (dk-have! (list '<= mb del) (lambda () (dk-ineq! (list '< mb del) (list 'IN mb 'RR) (list 'IN del 'RR))))
                    (fact 'rr-mul-le-right mb del Mp)
                    (for-each (lambda (t) (mr-rr! t)) (list (list '* P1 mb) (list '* Mp mb) (list '* mb Mp) (list '* del Mp) (list '* mb P1)))
                    (dk-have! (list '= (list '* mb P1) (list '* P1 mb)) (lambda () (crs)))
                    (dk-have! (list '= (list '* Mp mb) (list '* mb Mp)) (lambda () (crs)))
                    (dk-have! (list '= (list '* del Mp) 'eps)
