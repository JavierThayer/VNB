(define mr-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (mr-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (mr-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u)
    (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS mr-nfm u) mr-nfm f 'rgy_))))
(define (mr-imps hyps body)
  (if (null? hyps) body (list 'IMPLIES (car hyps) (mr-imps (cdr hyps) body))))
(define (mr-all vars body)
  (if (null? vars) body (list 'FORALL (car vars) (mr-all (cdr vars) body))))
(define (mr-and! a b)
  (let* ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (mr-pz z) (list 'DIFFERENCE 'CC (list 'SINGLETON z)))
(define (mr-rr! t)
  (let* ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((eq? t 'PI) (dk-split-all! (list (dk-cite! 'pi-pos))) typ)
          ((number? t) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((mr-op? t 'succ 2) (mr-nn! t) (fact 'nn-in-rr t) typ)
          ((mr-op? t '* 3) (mr-rr! (cadr t)) (mr-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((mr-op? t '+ 3) (mr-rr! (cadr t)) (mr-rr! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((mr-op? t '- 3) (mr-rr! (cadr t)) (mr-rr! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((mr-op? t '- 2) (mr-rr! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((mr-op? t 'magnitude 2) (mr-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((mr-op? t 'real-part 2) (mr-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((mr-op? t 'imag-part 2) (mr-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((mr-op? t 'abs 2) (mr-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((mr-op? t 'recip 2)
           (mr-rr! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (if (dk-asm? (list '< 0 (cadr t)))
                   (fact 'rr-pos-ne-zero (cadr t))
                   (error "mr-rr!: land the non-vanishing first" (expression->string (cadr t)))))
           (mr-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t))
           typ)
          (#t (dk-real! t) typ))))
(define (mr-nn! t)
  (let* ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((mr-op? t 'succ 2) (mr-nn! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          (#t (dk-type! t 'NN)))))
(define (mr-cc! t)
  (let* ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((or (and (number? t) (real? t)) (eq? t 'PI) (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
               (mr-op? t 'succ 2)
               (mr-op? t 'magnitude 2) (mr-op? t 'real-part 2) (mr-op? t 'imag-part 2))
           (mr-rr! t) (fact 'rr-subset-cc t) typ)
          ((mr-op? t '- 3) (mr-cc! (cadr t)) (mr-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((mr-op? t '- 2) (mr-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((mr-op? t '+ 3) (mr-cc! (cadr t)) (mr-cc! (caddr t))
           (mr-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((mr-op? t '* 3) (mr-cc! (cadr t)) (mr-cc! (caddr t))
           (mr-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((mr-op? t 'power 3) (mr-cc! (cadr t)) (mr-nn! (caddr t))
           (mr-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((mr-op? t 'CC-EXP 2) (mr-cc! (cadr t))
           (dk-split-all! (list (dk-cite! 'cc-exp-converges (cadr t)))) typ)
          ((mr-op? t 'recip 2) (mr-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "mr-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (mr-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (dk-type! t 'CC)))))
(define (mr-sub-nz! y z)
  (let* ((nz (list 'NOT (list '= (list '- y z) 0))))
    (dk-have! nz
      (lambda ()
        (di)
        (dk-cite! 'cc-sub-zero-eq y z)
        (ai (dk-ctx-form (list 'NOT (list '= y z))))))
    nz))
(define (mr-steps . thunks)
  ;; run THUNKS in order while the leaf focused at the start stays open
  (let* ((leaf (proof-state-focus *ps*)))
    (let loop ((ts thunks))
      (if (and (pair? ts) (not (sequent-node-grounded? leaf)))
          (begin ((car ts)) (loop (cdr ts)))))))
(define (mr-pz-open! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (mr-steps
      (lambda () (dk-have! (list 'IN y 'CC) (lambda () (mr-only-prop! iff (list 'IN y (mr-pz z))))))
      (lambda () (dk-have! (list 'NOT (list '= y z)) (lambda () (mr-only-prop! iff (list 'IN y (mr-pz z))))))
      (lambda () (mr-sub-nz! y z)))))
(define (mr-pz-in! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (dk-have! (list 'IN y (mr-pz z))
      (lambda () (mr-only-prop! iff (list 'IN y 'CC) (list 'NOT (list '= y z)))))))
(define (mr-pz-setup! z)
  (let* ((d (mr-pz z)))
    (fact 'nf-cc-is-metric-space)
    (dk-cite! 'cc-punctured-open z)
    (let* ((iff (dk-cite! 'cc-ms-open-iff d)))
      (dk-have! (list 'IS-OPEN mr-nfm d) (lambda () (mr-only-prop! iff (list 'IS-OPEN 'CC-MS d)))))
    (fact 'cc-is-set)
    (dk-cite! 'difference-set 'CC (list 'SINGLETON z))
    (dk-cite! 'cc-open-subset-cc d)))
(define (mr-lam-typ! lam dom pre)
  (dk-have! (list 'IN lam (list 'FUN dom 'CC))
    (lambda ()
      (dk-lam-type! (lambda ()
                      (let* ((v (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                        (mr-steps
                          (lambda () (pre v))
                          (lambda () (if (dk--redex? (dk-goal)) (dk-lam-b!)))
                          (lambda () (if (not (dk-asm? (dk-goal))) (mr-cc! (cadr (dk-goal)))))
                          (lambda () (ass)))))))))
(define (mr-detach! imp thunk)
  (if (and (pair? imp) (eq? (car imp) 'IMPLIES))
      (begin (dk-have! (cadr imp) thunk)
             (dk-landed-1 (lambda () (detach! imp))))
      imp))
(define (mr-only-prop! . fs) (if (apply dk-only! fs) (prop)))
(define (mr-lam-b-if!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
(define (mr-subst-ass! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (ass))))
(define mr-tpi '(* (* 2 PI) +i))
(define (mr-tpi!)
  (mr-rr! '(* 2 PI))
  (dk-have! '(< 0 (* 2 PI)) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'rr-pos-ne-zero '(* 2 PI))
  (mr-cc! '(* 2 PI))
  (fact 'cc-i-in)
  (dk-have! '(NOT (= +i 0))
    (lambda ()
      (di)
      (fact 'cc-i-squared)
      (dk-have! '(= (* 0 0) -1) (lambda () (subst '(= 0 +i)) (ass)))
      (dk-have! '(NOT (= (* 0 0) -1)) (lambda () (arith)))
      (ai '(NOT (= (* 0 0) -1)))))
  (dk-cite! 'cc-mul-nonzero '(* 2 PI) +i)
  (mr-cc! mr-tpi)
  (mr-cc! (list 'recip mr-tpi))
  (mr-and! (list 'IN mr-tpi 'CC) (list 'NOT (list '= mr-tpi 0)))
  (dk-cite! 'cc-recip-inverse mr-tpi))
(define (mr-in-ball! x c s)
  (let* ((m (list 'magnitude (list '- x c))))
    (fact 'cc-is-metric-space)
    (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
    (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (dk-have! (list 'IN c '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (mr-rr! m)
    (dk-cite! 'cc-ms-dist c x)
    (dk-cite! 'cc-magnitude-sub-sym c x)
    (dk-have! (list '<= (list '(DIST CC-MS) c x) m)
      (lambda ()
        (subst (list '= (list '(DIST CC-MS) c x) (list 'magnitude (list '- c x))))
        (if (not (equal? c x)) (subst (list '= (list 'magnitude (list '- c x)) m)))
        (dk-ineq!)))
    (let* ((cj (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list 'IN m 'RR) (list 'AND (list 'IN s 'RR)
                (list 'AND (list '<= (list '(DIST CC-MS) c x) m) (list '< m s)))))))
      (dk-have! cj (lambda () (dk-conj-close! dk-ass!)))
      (dk-cite! 'ball-mem-from-le 'CC-MS c x m s))))
(define (mr-subst-qrfl! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (qrfl))))
(define (mr-ball-open! c r x)
  ;; x in BALL(CC-MS, c, r) in context: land x in CC and |x - c| < r (stops early when a
  ;; landing closes the focus leaf, the claim being the goal)
  (let* ((dcx (list '(DIST CC-MS) c x))
         (mag (list 'magnitude (list '- c x)))
         (mag2 (list 'magnitude (list '- x c)))
         (cj  (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list '<= dcx r) (list 'NOT (list '= dcx r))))))
    (mr-steps
      (lambda () (fact 'cc-is-metric-space))
      (lambda () (let* ((iff (dk-cite! 'ball-membership 'CC-MS c r x)))
                   (dk-have! cj (lambda () (mr-only-prop! iff (list 'IN x (list 'BALL 'CC-MS c r)))))))
      (lambda () (dk-split-all! (list (dk-ctx-form cj))))
      (lambda () (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl))))
      (lambda () (dk-have! (list 'IN x 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass))))
      (lambda () (dk-cite! 'cc-ms-dist c x))
      (lambda () (mr-rr! mag))
      (lambda () (mr-rr! mag2))
      (lambda () (dk-cite! 'cc-magnitude-sub-sym c x))
      (lambda () (dk-have! (list 'AND (list '<= mag r) (list 'NOT (list '= mag r)))
                   (lambda () (subst (list '= mag dcx)) (dk-conj-close! dk-ass!))))
      (lambda () (dk-cite! 'rr-le-ne-lt mag r))
      (lambda () (dk-have! (list '< mag2 r) (lambda () (dk-ineq! (list '< mag r) (list '= mag mag2))))))))
(define (mr-subst-sym e from to)
  (cond ((eq? e from) to)
        ((pair? e) (cons (mr-subst-sym (car e) from to) (mr-subst-sym (cdr e) from to)))
        (#t e)))
(define (mr-tpt! x . zs)
  (mr-steps
    (lambda () (fact 'subset-mem-fwd mr-T (mr-pz 'c) x))
    (lambda () (mr-pz-open! 'c x))
    (lambda () (for-each (lambda (z) (fact 'subset-mem-fwd mr-T (mr-pz z) x) (mr-pz-open! z x)) zs))))
(define (mr-dump-open!)
  (for-each (lambda (l) (display "\n;; OPEN: ") (display (expression->string (dk-goal-of l)))) (dk-open-leaves)))
(define (mr-center-in-ball! a r)
  ;; a in CC, r in RR, 0 < r: land a in BALL(CC-MS, a, r) (which also certifies the ball DEFINED)
  (let* ((d (list '- a a)) (m (list 'magnitude d)))
    (mr-rr! m)
    (mr-cc! d)
    (dk-have! (list '= d 0) (lambda () (crs)))
    (let ((iff (dk-cite! 'cc-magnitude-zero-iff d)))
      (dk-have! (list '= m 0) (lambda () (mr-only-prop! iff (list '= d 0)))))
    (dk-have! (list '< m r) (lambda () (dk-ineq! (list '= m 0) (list '< 0 r))))
    (mr-in-ball! a a r)))
(define mr-tp '(* 2 PI))
(define mr-I (list 'CCINT 0 mr-tp))
(define mr-C '(CIRCLE-PATH c r))
(define mr-Cd '(CIRCLE-DERIV c r))
(define mr-T (list 'TRACE mr-C 0 mr-tp))
(define (mr-kern z) (list 'VNB-LAMBDA 'wnw_ (mr-pz z) (list 'recip (list '- 'wnw_ z))))
(define (mr-in-I! v)
  (dk-have! (list 'IN v mr-I)
    (lambda () (mac 'ccint-membership)
               (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 0 mr-tp) '(< 0 PI))))))))
(define (mr-circle-basics!)
  (fact 'rr-zero-in)
  (mr-rr! mr-tp)
  (dk-have! (list '< 0 mr-tp) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'circle-is-road 'c 'r)
  (fact 'is-road-is-path mr-C mr-Cd 0 mr-tp)
  (fact 'is-path-in-fun mr-C 0 mr-tp)
  (dk-cite! 'trace-subset-cc mr-C 0 mr-tp))
(define (mr-circ-pt! y)
  ;; y in the trace of the circle (c, r in context, 0 < r): y in CC, |y - c| = r,
  ;; r <= |y - c|, y /= c, y - c /= 0, y in CC \ {c}
  (let* ((m (list 'magnitude (list '- y 'c))))
    (mr-steps
      (lambda () (fact 'subset-mem-fwd mr-T 'CC y))
      (lambda () (dk-cite! 'circle-trace-magnitude 'c 'r y))
      (lambda () (mr-rr! m))
      (lambda () (dk-have! (list '<= 'r m) (lambda () (dk-ineq! (list '= m 'r)))))
      (lambda ()
        (dk-have! (list 'NOT (list '= y 'c))
          (lambda ()
            (di)
            (dk-have! (list '= m 0)
              (lambda () (subst (list '= y 'c))
                         (dk-have! '(= (- c c) 0) (lambda () (crs)))
                         (subst '(= (- c c) 0))
                         (fact 'cc-magnitude-zero)
                         (ass)))
            (dk-absurd! (list 'IN m 'RR) '(IN r RR) (list '= m 0) (list '= m 'r) '(< 0 r)))))
      (lambda () (mr-sub-nz! y 'c))
      (lambda () (mr-pz-in! 'c y)))))
(define (mr-LI f) (list 'LINE-INT f mr-C mr-Cd 0 mr-tp))
(define (mr-trace-in-pz! p)
  (dk-have! (list 'SUBSET mr-T (mr-pz p))
    (lambda ()
      (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
        (mr-circ-pt! y)
        (if (eq? p 'z) (mr-circ-not-z! y))
        (if (not (sequent-node-grounded? leaf)) (ass))))))
(define (mr-kern-setup! p)
  (let* ((dd (mr-pz p)) (k (mr-kern p)))
    (dk-cite! 'winding-integrand-holomorphic p)
    (dk-cite! 'holomorphic-on-in-fun dd k)
    (dk-cite! 'holomorphic-on-continuous dd k)
    (dk-cite! 'holomorphic-on-open dd k)
    (dk-cite! 'cc-open-subset-cc dd)))
(define (mr-lam-b!) (if (dk--redex? (dk-goal)) (dk-lam-b!) #f))
(define (mr-B e r) (list 'BALL 'CC-MS e r))
(define (mr-PB e r) (list 'DIFFERENCE (mr-B e r) (list 'SINGLETON e)))
(define (mr-pz e) (list 'DIFFERENCE 'CC (list 'SINGLETON e)))
(define (mr-pb-in! e r y)              ; y in B(e, r), y /= e (in context): y in B(e, r) \ {e}
  (let ((iff (dk-cite! 'difference-membership (mr-B e r) (list 'SINGLETON e) y))
        (sf (begin (fact 'membership-implies-sethood y (mr-B e r)) (dk-cite! 'singleton-membership e y))))
    (dk-have! (list 'NOT (list 'IN y (list 'SINGLETON e))) (lambda () (mr-only-prop! sf (list 'NOT (list '= y e)))))
    (dk-have! (list 'IN y (mr-PB e r)) (lambda () (mr-only-prop! iff (list 'IN y (mr-B e r)) (list 'NOT (list 'IN y (list 'SINGLETON e))))))))
(define (mr-pb-open! e r y)            ; y in B(e, r) \ {e}: y in B, y in CC, y /= e, y - e /= 0, y in CC \ {e}
  (mr-steps
    (lambda () (let ((iff (dk-cite! 'difference-membership (mr-B e r) (list 'SINGLETON e) y)))
                 (if (not (and (dk-asm? (list 'IN y (mr-B e r))) (dk-asm? (list 'NOT (list 'IN y (list 'SINGLETON e))))))
                     (begin
                       (dk-have! (list 'AND (list 'IN y (mr-B e r)) (list 'NOT (list 'IN y (list 'SINGLETON e))))
                         (lambda () (mr-only-prop! iff (list 'IN y (mr-PB e r)))))
                       (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN y (mr-B e r)) (list 'NOT (list 'IN y (list 'SINGLETON e)))))))))))
    (lambda () (mr-ball-pt! e r y))
    (lambda () (fact 'membership-implies-sethood y 'CC))
    (lambda () (let ((iff (dk-cite! 'singleton-membership e y)))
                 (dk-have! (list 'NOT (list '= y e))
                   (lambda () (mr-only-prop! iff (list 'NOT (list 'IN y (list 'SINGLETON e))) (list 'IN y 'SET))))))
    (lambda () (mr-sub-nz! y e))
    (lambda () (mr-pz-in! e y))))
(define (mr-ball-pt! e r y)            ; y in B(e, r): y in CC, |y - e| < r
  (if (not (and (dk-asm? (list 'IN y 'CC)) (dk-asm? (list '< (list 'magnitude (list '- y e)) r))))
  (let ((iff (dk-cite! 'cc-ms-ball-membership e r y)))
    (dk-have! (list 'AND (list 'IN y 'CC) (list '< (list 'magnitude (list '- y e)) r))
      (lambda () (mr-only-prop! iff (list 'IN y (mr-B e r)))))
    (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN y 'CC) (list '< (list 'magnitude (list '- y e)) r))))))))
(define mr-nf '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (mr-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (mr-mag! t) (mr-cc! t) (if (not (dk-asm? (list 'IN (list 'magnitude t) 'RR))) (fact 'cc-magnitude-closed t)))

;;; (1) continuity on a subset of CC from a modulus (the converse of CH3-A's cc-continuous-at-modulus)
(define mr1-mod
  '(FORALL eps (IMPLIES (POS-RR eps) (FORSOME del (AND (POS-RR del)
     (FORALL b (IMPLIES (IN b u) (IMPLIES (< (magnitude (- b y)) del) (<= (magnitude (- (g b) (g y))) eps)))))))))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC) (list 'FORALL 'g (list 'IMPLIES '(IN g (FUN u CC))
  (list 'FORALL 'y (list 'IMPLIES '(IN y u) (list 'IMPLIES mr1-mod
    (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS mr-nf 'u) mr-nf 'g 'y))))))))))
(dk-peel!)
(define mr1-sub (list 'SUBSPACE-MS mr-nf 'u))
(mr-pts-cc!)
(fact 'cc-is-set)
(fact 'subclass-of-set-is-set 'u 'CC)
(fact 'nf-cc-is-metric-space)
(fact 'nf-cc-agree-pts)
(dk-have! (list 'SUBSET 'u (list 'PTS mr-nf)) (lambda () (subst (list '== (list 'PTS mr-nf) '(PTS CC-MS))) (subst '(== (PTS CC-MS) CC)) (ass)))
(fact 'subspace-is-metric-space mr-nf 'u)
(dk-cite! 'subspace-pts mr-nf 'u)
(fact 'subset-mem-fwd 'u 'CC 'y)
(fact 'fun-apply-type-c 'g 'u 'CC 'y)
(let* ((ci (dk-cite! 'is-continuous-at mr1-sub mr-nf 'g 'y)) (rhs (caddr ci)))
  (dk-have! rhs
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (let ((gl (dk-goal)) (leaf (proof-state-focus *ps*)))
            (cond
              ((dk-asm? gl) (ass))
              ((dk-head-is? gl 'IN)
               (subst (list '== (list 'PTS mr1-sub) 'u))
               (if (not (sequent-node-grounded? leaf)) (subst (list '== (list 'PTS mr-nf) '(PTS CC-MS))))
               (if (not (sequent-node-grounded? leaf)) (subst '(== (PTS CC-MS) CC)))
               (if (not (sequent-node-grounded? leaf)) (ass)))
              (#t
               (let* ((lk (dk-peel!)) (eps (cadr (car (filter (lambda (fm) (dk-head-is? fm 'POS-RR)) lk))))
