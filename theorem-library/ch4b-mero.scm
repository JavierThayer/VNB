                                                    (list '< 0 del) (list 'IN hd 'RR) (list 'IN del 'RR))))
                             (dk-apply! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm del) (dk-contains? fm '(g y)) (dk-contains? fm 'magnitude))) "the modulus") b)
                             (fact 'rr-pos-rr-in-rr eps)
                             (subst (list '= enf ecc))
