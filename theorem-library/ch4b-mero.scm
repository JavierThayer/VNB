;;; (2) PROPOSITION 4.3 (Riemann): f holomorphic on u \ {a} has a removable singularity at a iff f is bounded near a
(define mr-Ua '(DIFFERENCE u (SINGLETON a)))
(define mr-bdd
  (list 'FORSOME 'mrr_ (list 'AND '(IN mrr_ RR) (list 'AND '(< 0 mrr_)
    (list 'FORSOME 'mrm_ (list 'AND '(IN mrm_ RR)
      (list 'FORALL 'mrz_ (list 'IMPLIES (list 'IN 'mrz_ mr-Ua)
        (list 'IMPLIES '(< (magnitude (- mrz_ a)) mrr_) '(<= (magnitude (f mrz_)) mrm_))))))))))
(define (mr-open-ball! u c)            ; IS-OPEN(nf, u), c in u: a radius with B(c, r) inside u; returns r (POS-RR r, 0 < r, r in RR)
  (fact 'cc-is-metric-space) (mr-pts-cc!)
  (let ((iff0 (dk-cite! 'cc-ms-open-iff u)))
    (if (not (dk-asm? (list 'IS-OPEN 'CC-MS u))) (dk-have! (list 'IS-OPEN 'CC-MS u) (lambda () (mr-only-prop! iff0 (list 'IS-OPEN mr-nf u))))))
  (let* ((oiff (dk-cite! 'is-open 'CC-MS u))
         (oball (let loop ((r (caddr oiff))) (if (eq? (car r) 'AND) (loop (caddr r)) r))))
    (if (not (dk-asm? oball)) (dk-have! oball (lambda () (mr-only-prop! oiff (list 'IS-OPEN 'CC-MS u)))))
    (let ((rho (dk-skolem! (dk-apply! (dk-ctx-form oball) c))))
      (fact 'rr-pos-rr-in-rr rho) (fact 'rr-lt-of-pos-rr rho)
      rho)))
(define (mr-min! r1 r2 K)              ; 0 < r1, r2 in RR: K applied to a radius r0 with 0 < r0 <= r1, r0 <= r2
  (use-em (list '<= r1 r2)
    (lambda () (dk-have! (list '<= r1 r1) (lambda () (dk-ineq! (list 'IN r1 'RR)))) (K r1))
    (lambda () (fact 'rr-not-le-lt r1 r2) (dk-have! (list '<= r2 r2) (lambda () (dk-ineq! (list 'IN r2 'RR))))
               (dk-have! (list '<= r2 r1) (lambda () (dk-ineq! (list '< r2 r1)))) (K r2))))
(define (mr-ball-setup! e r)           ; 0 < r: B(e, r) open (both spellings), inside CC, a set
  (let ((B (mr-B e r)))
    (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
    (dk-have! (list 'NOT (list '= 0 r)) (lambda () (di) (dk-absurd! (list 'IN r 'RR) (list '< 0 r) (list '= 0 r))))
    (mr-and! (list 'IN r 'RR) (mr-and! (list '<= 0 r) (list 'NOT (list '= 0 r))))
    (fact 'cc-is-metric-space) (fact 'nf-cc-is-metric-space)
    (mr-pts-cc!)
    (dk-have! (list 'IN e '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (dk-cite! 'ball-is-open 'CC-MS e r)
    (let ((iff (dk-cite! 'cc-ms-open-iff B)))
      (dk-have! (list 'IS-OPEN mr-nf B) (lambda () (mr-only-prop! iff (list 'IS-OPEN 'CC-MS B)))))
    (dk-cite! 'cc-open-subset-cc B)
    (fact 'cc-is-set)
    (fact 'subclass-of-set-is-set B 'CC)))
(define (mr-back! r rho r0 M bd)
  (let* ((B (mr-B 'a r0)) (PB (mr-PB 'a r0))
         (h (list 'VNB-LAMBDA 'mrw_ B '(IF (= mrw_ a) 0 (* (- mrw_ a) (f mrw_)))))
         (k (list 'VNB-LAMBDA 'mrw_ PB '(* (- mrw_ a) (f mrw_))))
         (Mp (list '+ (list 'abs M) 1)))
    (dk-type! r0 'RR)
    (dk-have! (list '< 0 r0) (lambda () (dk-ineq! (list 'IN r0 'RR) (list '< 0 r) (list '< 0 rho) (dk-ctx-form (if (equal? r0 r) (list '<= r rho) (list '< rho r))))))
    (dk-have! (list '<= r0 r) (lambda () (dk-ineq! (list 'IN r0 'RR) (list 'IN r 'RR) (list 'IN rho 'RR) (dk-ctx-form (if (equal? r0 r) (list '<= r rho) (list '< rho r))))))
    (dk-have! (list '<= r0 rho) (lambda () (dk-ineq! (list 'IN r0 'RR) (list 'IN r 'RR) (list 'IN rho 'RR) (dk-ctx-form (if (equal? r0 r) (list '<= r rho) (list '< rho r))))))
    (mr-ball-setup! 'a r0)
