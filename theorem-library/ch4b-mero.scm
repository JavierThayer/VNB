    (fact 'subset-trans B (mr-B 'a rho) 'u)
    (dk-cite! 'cif-open-minus-point B 'a)
    (dk-cite! 'cc-open-subset-cc PB)
    (fact 'subclass-of-set-is-set PB 'CC)
    (mr-center-in-ball! 'a r0)
    (fact 'rr-abs-closed M) (fact 'rr-le-abs M) (fact 'rr-abs-nonneg M)
    (mr-rr! Mp)
    (dk-have! (list '< 0 Mp) (lambda () (dk-ineq! (list '<= 0 (list 'abs M)) (list 'IN (list 'abs M) 'RR) (list 'IN Mp 'RR))))
    (let* ((pb-pt! (lambda (z)        ; z in PB: z in u \ {a}, |f z| <= M, f z typed
                     (mr-steps
                       (lambda () (mr-pb-open! 'a r0 z))
                       (lambda () (fact 'subset-mem-fwd B 'u z))
                       (lambda () (mr-ua-in! z))
                       (lambda () (fact 'fun-apply-type-c 'f mr-Ua 'CC z))
