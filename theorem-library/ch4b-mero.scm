                             (dk-ineq! (list '<= (list 'magnitude (list '- gb gy)) 'eps) (list '= (list 'magnitude (list '- gy gb)) (list 'magnitude (list '- gb gy)))))))))))))))))
  (dk-have! (cadr ci) (lambda () (mr-only-prop! ci rhs))))
