                           (lambda () (if (not (sequent-node-grounded? leaf)) (begin (mr-cc! (cadr (dk-goal))) (rfl)))))))))
      ;; continuity of h on B
      (dk-have! (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ B) (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS mr-nf B) mr-nf h 'rgy_)))
        (lambda ()
          (let* ((y (dk-di-var!)))
