                  (dk-cite! 'diff-on-implies-continuous 'CC-NORMED-FIELD B h y L)
                  (if (pair? (dk-open-leaves)) (ass))))))))
      (dk-cite! 'holomorphic-removable-point B h 'a)
      ;; q: h(x) - h(a) = q(x)(x - a), q holomorphic on B
      (let* ((q (dk-skolem! (dk-cite! 'holomorphic-difference-quotient B h 'a)))
             (dq (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm q) (dk-contains? fm h))) "the quotient law")))
        (dk-cite! 'holomorphic-removable-point B q 'a)
        (dk-cite! 'holomorphic-on-in-fun B q)
        (dk-have! (list '= (list h 'a) 0) (lambda () (mr-lam-b!) (dk-if-branch! #t (cadr (dk-goal)) (lambda () (rfl)) (lambda () (if (pair? (dk-open-leaves)) (rfl))))))
        (let* ((iff (dk-cite! 'is-removable-singularity 'f 'a)) (rhs (caddr iff)))
          (dk-have! rhs
            (lambda ()
