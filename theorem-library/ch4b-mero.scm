                                              (lambda () (subst (list '= (list h z) (list '* e (list 'f z)))) (subst (list '= (list h 'a) 0)) (crs)))
                                            (subst (list '= (list '* e D) (list '- (list '- (list h z) (list h 'a)) (list '* (list q z) e))))
                                            (subst e1)
                                            (crs)))
                                        (use-em (list '= D 0)
                                          (lambda () (dk-cite! 'cc-sub-zero-eq (list 'f z) (list q z)) (if (not (sequent-node-grounded? leaf)) (ass)))
                                          (lambda ()
