                                    (lambda () (dk-ineq! (list '< (list 'magnitude (list '- z 'a)) r0) (list '<= r0 r)
                                                         (list 'IN (list 'magnitude (list '- z 'a)) 'RR) (list 'IN r0 'RR) (list 'IN r 'RR)))))
                       (lambda () (dk-apply! bd z)))))
           (b-pt! (lambda (z)          ; z in B: CC
                    (mr-ball-pt! 'a r0 z))))
      ;; h typed on B
      (dk-have! (list 'IN h (list 'FUN B 'CC))
        (lambda () (dk-lam-type! (lambda () (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                              (b-pt! y)
                                              (if (not (sequent-node-grounded? leaf)) (mr-lam-b!))
                                              (if (not (sequent-node-grounded? leaf))
                                                  (dk-case-if! (cadr (dk-goal))
                                                    (lambda (t? v) (if t? (ass)
                                                                       (begin (mr-pb-in! 'a r0 y) (pb-pt! y) (mr-cc! (cadr (dk-goal))) (ass)))))))))))
      ;; k holomorphic on PB
      (dk-have! (list 'SUBSET PB mr-Ua)
        (lambda () (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*))) (pb-pt! y) (if (not (sequent-node-grounded? leaf)) (ass)))))
      (dk-cite! 'holomorphic-on-restrict mr-Ua 'f PB)
      (dk-have! (list 'SUBSET PB B)
        (lambda () (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*))) (mr-pb-open! 'a r0 y) (if (not (sequent-node-grounded? leaf)) (ass)))))
      (dk-cite! 'holomorphic-on-in-fun PB (list 'RESTRICT 'f PB))
      (let* ((q1 (dk-name! (list 'RESTRICT 'f PB) (list 'FUN PB 'CC)))
             (k0 (list 'VNB-LAMBDA 'mrw_ PB (list '* '(- mrw_ a) (list q1 'mrw_)))))
        (dk-have! (list 'HOLOMORPHIC-ON PB q1) (lambda () (subst (list '= q1 (list 'RESTRICT 'f PB))) (ass)))
        (dk-have! (list 'HOLOMORPHIC-ON PB k0) (lambda () (dk-holomorphic! PB k0)))
        (dk-have! (list 'IN k (list 'FUN PB 'CC))
          (lambda () (dk-lam-type! (lambda () (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                                (pb-pt! y) (if (not (sequent-node-grounded? leaf)) (mr-lam-b!))
                                                (if (not (sequent-node-grounded? leaf)) (begin (mr-cc! (cadr (dk-goal))) (ass))))))))
        (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ PB) (list '== (list k 'hbx_) (list k0 'hbx_))))
          (lambda () (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                       (pb-pt! y) (mr-lam-b!)
                       (subst (list '= q1 (list 'RESTRICT 'f PB)))
                       (dk-cite! 'restrict-apply 'f PB y)
                       (subst (list '== (list (list 'RESTRICT 'f PB) y) (list 'f y)))
                       (if (not (sequent-node-grounded? leaf)) (qrfl)))))
        (dk-cite! 'holomorphic-transfer-ptwise-eq PB k k0))
      ;; RESTRICT(h, PB) = k, holomorphic
      (let ((rh (list 'RESTRICT h PB)))
        (dk-have! (list 'IN rh (list 'FUN PB 'CC))
          (lambda () (mac 'RESTRICT)
                     (dk-lam-type! (lambda () (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                                (pb-pt! y) (fact 'fun-apply-type-c h B 'CC y) (if (not (sequent-node-grounded? leaf)) (ass)))))))
        (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ PB) (list '== (list rh 'hbx_) (list k 'hbx_))))
          (lambda () (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                       (pb-pt! y)
