      (fact 'fun-apply-type-c 'f mr-Ua 'CC z)
      (mr-mag! (list '- (list 'f z) 'mrv_))
      (let ((m (list 'magnitude (list '- (list 'f z) 'mrv_))))
        (if (not (dk-asm? (list '<= 'mre_ m)))
          (dk-have! (list '<= 'mre_ m)
            (lambda ()
              (use-em (list '<= 'mre_ m)
                (lambda () (ass))
                (lambda ()
                  (fact 'rr-not-le-lt 'mre_ m)
                  (dk-have! mr7-goal (lambda () (ew z) (dk-conj-close! (lambda () (ass)))))
                  (ai (list 'NOT mr7-goal)))))))))
    (let* ((rho (mr-open-ball! 'u 'a)))
      (mr-min! 'mrr_ rho
        (lambda (r1)
          (mr7-main! r1 rho mr7-far!))))))
(mr-dump-open!)
(qed 'casorati-weierstrass)

;;; (8) PROPOSITION 4.11: f holomorphic on u \ S (S subset u), meromorphic at every point of S: S meets every compact
;;;     K subset u in a finite set.  Each x of K has a ball meeting S at most in x (at x in S: f is defined on the
;;;     punctured ball of its decomposition, so that ball misses S; off S: u \ S is open); finitely many such balls
;;;     cover K (compact-cover-by-balls), so S n K lies in the finite set of their centres.
(define mr8-D '(DIFFERENCE u mrs_))
(define (mr8-qsep x)
  (list 'SEP 'mrq_ 'RR (list 'AND '(< 0 mrq_)
    (list 'FORALL 'mrv_ (list 'IMPLIES '(IN mrv_ mrs_) (list 'IMPLIES (list 'IN 'mrv_ (list 'BALL 'CC-MS x 'mrq_)) (list '= 'mrv_ x)))))))
(define mr8-h (list 'VNB-LAMBDA 'mrt_ 'mrk_ (list 'CHOICE (mr8-qsep 'mrt_))))
(define (mr8-d-open! z)                ; z in u \ S: z in u, not in S
  (let ((iff (dk-cite! 'difference-membership 'u 'mrs_ z)))
    (dk-have! (list 'NOT (list 'IN z 'mrs_)) (lambda () (mr-only-prop! iff (list 'IN z mr8-D))))))
(define (mr8-rad-of! x)                ; x in K: the chosen radius c, 0 < c, its property landed; returns c
  (let* ((sv (mr8-qsep x)) (c (list 'CHOICE sv)))
    (if (not (dk-asm? (list 'IN c sv)))
        (let ((good (lambda (r0 not-in!)      ; r0 > 0, NOT-IN! w: w in S, w in B(x, r0), w /= x ==> FALSITY
                      (dk-have! (list 'IN r0 sv)
                        (lambda ()
                          (in-sep!
                            (lambda ()
                              (dk-conj-close!
                                (lambda ()
                                  (if (dk-asm? (dk-goal)) (ass)
                                      (let* ((ls (dk-peel!))
                                             (w (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'mrs_))) ls)))))
                                        (use-em (list '= w x)
                                          (lambda () (ass))
                                          (lambda () (not-in! w)))))))))))
                      (ew r0) (if (pair? (dk-open-leaves)) (ass)))))
          (fact 'subset-mem-fwd 'mrk_ 'u x)
          (fact 'subset-mem-fwd 'u 'CC x)
          (dk-have! (list 'FORSOME 'mrz_ (list 'IN 'mrz_ sv)) (lambda ()
          (use-em (list 'IN x 'mrs_)
            (lambda ()
              (dk-apply! (dk-ctx-form '(FORALL mre_ (IMPLIES (IN mre_ mrs_) (IS-MEROMORPHIC-AT f mre_)))) x)
              (mr-unfold! 'is-meromorphic-at (list 'f x) (list 'IS-MEROMORPHIC-AT 'f x))
              (let* ((N (mr-sk! 'mrn_ x)) (r (mr-sk! 'mrr_ x)) (G (mr-sk! 'mrg_ r))
                     (law (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm G) (dk-contains? fm 'f))) "the law at x")))
                (good r (lambda (w)
                          (mr-pb-in! x r w)
                          (let ((e (dk-apply! law w)))
                            (dk-cite! 'fun-value-in-domain mr8-D 'CC 'f w (caddr e))
                            (mr8-d-open! w)
                            (ai (list 'NOT (list 'IN w 'mrs_))))))))
            (lambda ()
              (let ((iff (dk-cite! 'difference-membership 'u 'mrs_ x)))
                (dk-have! (list 'IN x mr8-D) (lambda () (mr-only-prop! iff (list 'IN x 'u) (list 'NOT (list 'IN x 'mrs_))))))
              (let ((rho (mr-open-ball! mr8-D x)))
                (good rho (lambda (w)
                            (fact 'subset-mem-fwd (mr-B x rho) mr8-D w)
                            (mr8-d-open! w)
                            (ai (list 'NOT (list 'IN w 'mrs_))))))))))
          (dk-cite! 'choice-axiom sv)
          (sep-me (list 'IN c sv))
          (dk-split-all!)))
    c))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN mr-nf 'u)
  (list 'FORALL 'mrs_ (list 'IMPLIES '(SUBSET mrs_ u)
    (list 'FORALL 'f (mr-imps (list (list 'HOLOMORPHIC-ON mr8-D 'f) '(FORALL mre_ (IMPLIES (IN mre_ mrs_) (IS-MEROMORPHIC-AT f mre_))))
      (list 'FORALL 'mrk_ (mr-imps (list '(SUBSET mrk_ u) '(IS-COMPACT (SUBSPACE-MS CC-MS mrk_)))
        '(IN (CARD (INTERSECTION mrs_ mrk_)) NN)))))))))))
(dk-peel!)
(dk-cite! 'cc-open-subset-cc 'u)
(dk-cite! 'holomorphic-on-in-fun mr8-D 'f)
(dk-cite! 'holomorphic-on-open mr8-D 'f)
(fact 'subset-trans 'mrk_ 'u 'CC)
(fact 'cc-is-set)
(fact 'subclass-of-set-is-set 'mrk_ 'CC)
(dk-have! (list 'IN mr8-h '(FUN mrk_ RR))
  (lambda () (dk-lam-type! (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                        (mr8-rad-of! x) (mr-lam-b!) (if (not (sequent-node-grounded? leaf)) (ass)))))))
(dk-have! (list 'FORALL 'wcvx_ (list 'IMPLIES '(IN wcvx_ mrk_) (list '< 0 (list mr8-h 'wcvx_))))
  (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*))) (mr8-rad-of! x) (mr-lam-b!) (if (not (sequent-node-grounded? leaf)) (ass)))))
(let* ((P (dk-skolem! (dk-cite! 'compact-cover-by-balls 'mrk_ mr8-h)))
       (cov (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm P) (dk-contains? fm 'BALL))) "the finite cover"))
       (zset '(INTERSECTION mrs_ mrk_)))
  (fact 'subclass-of-set-is-set P 'mrk_)
  (dk-have! (list 'IN zset 'SET) (lambda () (dk-have! '(OR (IN mrs_ SET) (IN mrk_ SET)) (lambda () (oi-r) (ass))) (fact 'intersection-set-closure 'mrs_ 'mrk_) (ass)))
  (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z zset) (list 'IN 'z P)))
    (lambda ()
      (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*)) (iff (dk-cite! 'intersection-membership 'mrs_ 'mrk_ z)))
        (dk-have! (list 'IN z 'mrs_) (lambda () (mr-only-prop! iff (list 'IN z zset))))
        (dk-have! (list 'IN z 'mrk_) (lambda () (mr-only-prop! iff (list 'IN z zset))))
        (let* ((x (dk-skolem! (dk-apply! cov z) 'top)))
          (dk-split-all!)
          (fact 'subset-mem-fwd P 'mrk_ x)
          (dk-lam-b-h! (list 'IN z (list 'BALL 'CC-MS x (list mr8-h x))))
          (let ((c (mr8-rad-of! x)))
            (dk-apply! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm c) (dk-contains? fm 'mrs_))) "the radius clause at x") z)
            (subst (list '= z x))
            (if (not (sequent-node-grounded? leaf)) (ass)))))))
  (mr-and! (list 'IN P 'SET) (list 'IN (list 'CARD P) 'NN))
  (mr-and! (list 'IN zset 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z zset) (list 'IN 'z P))))
  (dk-cite! 'card-subset-nn P zset)
  (if (pair? (dk-open-leaves)) (ass)))
(mr-dump-open!)
(qed 'meromorphic-poles-finite-in-compact)
