                                          (lambda () (mr-lam-b!) (dk-if-branch! #f (cadr (dk-goal)) (lambda () (ass)) (lambda () (if (pair? (dk-open-leaves)) (begin (mr-cc! (caddr (dk-goal))) (rfl)))))))
                                        (mr-cc! D)
