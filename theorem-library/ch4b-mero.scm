        (dk-cite! 'holomorphic-transfer-ptwise-eq PB rh k))
      ;; h = k on PB, as '='
      (dk-have! (list 'FORALL 'cexx_ (list 'IMPLIES (list 'IN 'cexx_ PB) (list '= (list h 'cexx_) (list k 'cexx_))))
        (lambda () (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*)))
