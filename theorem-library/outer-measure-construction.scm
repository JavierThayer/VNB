  (fact 'nn-zero-in)
  (fact 'nn-succ-closed 0)
  (fact 'nn-succ-nonzero 0)
  (fact 'fun-apply-type-c 'pm 'cls 'RR-POS-STAR 'aa)
  (fact 'zero-in-rr-pos-star)
  (dk-have! (list 'IN sq '(FUN NN cls))
    (lambda () (dk-lam-type! (lambda () (dk-peel!) (dk-case-if! (omc-find-if (dk-goal)) (lambda (t v) (ass)))))))
  (dk-have! (list 'SUBSET 'es bu)
    (lambda ()
      (mac 'subset-def)
      (let ((zv (dk-di-var!)))
        (fact 'subset-mem-fwd 'es 'aa zv)
        (for-each (lambda (l)
                    (dk-focus! l)
                    (if (equal? (dk-goal) '(IN 0 NN))
                        (ass)
                        (begin (dk-lam-b!)
                               (dk-if-branch! #t (omc-find-if (dk-goal)) (lambda () (rfl)) dk-ass!))))
                  (dk-opened (lambda () (bu-mi 0)))))))
  (fact 'cover-sums-intro 'omega 'cls 'pm 'es sq)
  (dk-have! (list 'IN h '(FUN NN RR-POS-STAR))
    (lambda () (dk-lam-type! (lambda () (dk-peel!) (dk-lam-b!)
                               (dk-case-if! (omc-find-if (dk-goal))
                                 (lambda (t v) (if t (ass) (begin (subst '(= (pm EMPTY-SET) 0)) (ass)))))))))
  (dk-have! (list 'FORALL 'q (list 'IMPLIES '(IN q NN) (list '= (list h '(succ (succ q))) 0)))
    (lambda ()
      (let ((qv (dk-di-var!)))
        (fact 'nn-succ-closed qv) (fact 'nn-succ-closed (list 'succ qv))
        (fact 'nn-succ-nonzero (list 'succ qv))
        (dk-lam-b!)
        (dk-if-branch! #f (omc-find-if (dk-goal)) #f (lambda () (subst '(= (pm EMPTY-SET) 0)) (fact 'rr-zero-in) (rfl))))))
  (dk-have! (list '= (list h 0) pa)
    (lambda () (dk-lam-b!) (dk-if-branch! #t (omc-find-if (dk-goal)) (lambda () (rfl)) (lambda () (rfl)))))
  (dk-have! (list '= (list h '(succ 0)) 0)
    (lambda () (dk-lam-b!) (dk-if-branch! #f (omc-find-if (dk-goal)) #f (lambda () (subst '(= (pm EMPTY-SET) 0)) (fact 'rr-zero-in) (rfl)))))
  (fact 'esum-nn-two-support h)
