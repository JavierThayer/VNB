  (fact 'power-fun-union-closed 'omega 'osf)
  (omc-mstar-type! bu)
  (dk-have! (list 'IN omc-bl '(FUN NN RR-POS-STAR))
    (lambda () (dk-lam-type! (lambda () (let ((kv (cadr (car (dk-peel!)))))
                                          (fact 'fun-apply-type-c 'osf 'NN '(POWER omega) kv)
                                          (omc-then-ass! (lambda () (omc-mstar-type! (list 'osf kv)))))))))
  (omc-esum-type! omc-bl)
  (let ((cases (dk-cite! 'rr-pos-star-membership bb)))
    (dk-have! (list 'OR (list 'AND (list 'IN bb 'RR) (list '<= 0 bb)) (list '= bb 'POS-INF))
      (lambda () (omc-keep-prop! cases (list 'IN bb 'RR-POS-STAR))))
    (use-cases (list (list 'AND (list 'IN bb 'RR) (list '<= 0 bb)) (list '= bb 'POS-INF))
      (lambda ()
        (dk-split! (list 'AND (list 'IN bb 'RR) (list '<= 0 bb)))
        (dk-have! '(FORALL eps (IMPLIES (POS-RR eps)
                     (<= (EINF (COVER-SUMS omega cls pm (BIG-UNION osn_ NN (osf osn_))))
                         (eplus (ESUM (VNB-LAMBDA osk_ NN (EINF (COVER-SUMS omega cls pm (osf osk_))))) eps))))
          (lambda ()
            (dk-peel!)
            (omc-eps-parts!)
            (omc-el-type!)
            (dk-have! '(<= 0 eps) (lambda () (dk-ineq! '(< 0 eps))))
            (omc-rps! 'eps)
