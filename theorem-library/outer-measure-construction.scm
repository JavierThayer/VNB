;;; every covering sum dominates the measure of one member of cA covering E
(define omc-dom-claim
  '(FORSOME oda_ (AND (IN oda_ ca) (AND (SUBSET es oda_) (<= (rho oda_) y_)))))
(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'ca (list 'FORALL 'rho (list 'FORALL 'es (list 'FORALL 'y_
   (list 'IMPLIES '(IS-MEASURE omega ca rho)
     (list 'IMPLIES '(IN y_ (COVER-SUMS omega ca rho es)) omc-dom-claim)))))))))
(dk-peel!)
(fact 'measure-is-premeasure 'omega 'ca 'rho)
(let* ((iff (dk-cite! 'is-measure 'omega 'ca 'rho))
       (ex (dk-fact! 'cover-sums-elim 'omega 'ca 'rho 'es 'y_))
       (sv (dk-skolem! ex))
       (bu (list 'BIG-UNION 'cvn_ 'NN (list sv 'cvn_)))
       (sm (list 'ESUM (list 'VNB-LAMBDA 'cvk_ 'NN (list 'rho (list sv 'cvk_))))))
  (dk-project! '(IS-SIGMA-ALGEBRA omega ca) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
  (fact 'sigma-algebra-union-closed 'omega 'ca sv)
  (fact 'measure-countably-subadditive 'omega 'ca 'rho sv)
  (dk-have! (list '<= (list 'rho bu) 'y_) (lambda () (subst (list '= 'y_ sm)) (ass)))
  (ew bu)
  (dk-conj-close! dk-ass!))
