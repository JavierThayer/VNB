;;; =====================================================================
;;; (2) order bricks in [0, +inf].
;;; =====================================================================

(define (omc-keep-prop! . keepers)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! keepers)
    (if (not (sequent-node-grounded? leaf)) (prop))))

;;; einf-lt-witness: above the infimum there is a member below.  The mirror of
;;; esup-lt-witness (integral-convergence.scm).
(sp (make-wff '(FORALL S (IMPLIES (SUBSET S RR-POS-STAR)
                 (FORALL a (IMPLIES (IN a RR-POS-STAR)
                   (IMPLIES (< (EINF S) a) (FORSOME y (AND (IN y S) (< y a))))))))))
(dk-peel!)
(fact 'einf-in 's)
(let ((p '(FORSOME y (AND (IN y s) (< y a))))
      (e '(EINF s))
      (lb '(FORALL x (IMPLIES (IN x s) (<= a x)))))
  (use-em p
    (lambda () (ass))
    (lambda ()
      (dk-have! lb
        (lambda ()
          (let ((yv (dk-di-var!)))
            (fact 'subset-mem-fwd 's 'RR-POS-STAR yv)
            (use-em (list '< yv 'a)
              (lambda ()
                (dk-have! p (lambda () (ew yv) (dk-conj-close! dk-ass!)))
                (omc-keep-prop! p (list 'NOT p)))
              (lambda () (fact 'rps-not-lt-le yv 'a) (ass))))))
      (fact 'einf-greatest 's 'a)
      (let ((iff (dk-cite! '< e 'a)))
        (dk-have! (list 'AND (list '<= e 'a) (list 'NOT (list '= e 'a)))
          (lambda () (omc-keep-prop! iff (list '< e 'a))))
        (dk-split! (list 'AND (list '<= e 'a) (list 'NOT (list '= e 'a))))
        (omc-antisymm! e 'a)
        (omc-keep-prop! (list '= e 'a) (list 'NOT (list '= e 'a)))))))
(qed 'einf-lt-witness)
(topic! 'einf-lt-witness 'inequalities)

;;; rps-le-of-forall-eps: x <= y + eps for every eps > 0, y finite, gives x <= y.
(sp (make-wff '(FORALL x (FORALL y
   (IMPLIES (IN x RR-POS-STAR)
     (IMPLIES (IN y RR)
       (IMPLIES (<= 0 y)
         (IMPLIES (FORALL eps (IMPLIES (POS-RR eps) (<= x (eplus y eps))))
           (<= x y)))))))))
(dk-peel!)
(let ((hyp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR))) "the eps hypothesis")))
  ;; x is finite: x <= y + 1
  (fact 'rr-one-in)
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (fact 'rr-pos-rr-of-lt 1)
  (dk-apply! hyp 1)
  (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
  (let* ((e1 (dk-cite! 'eplus-real-defined 'y 1))
         (y1 (caddr e1)))
    (dk-have! (list 'IN y1 'RR) (lambda () (type-term)))
    (dk-have! (list '<= 'x y1) (lambda () (subst (list '= y1 (cadr e1))) (ass)))
    (omc-and2! '(IN x RR-POS-STAR) (list 'IN y1 'RR))
    (fact 'rr-pos-star-le-real-in-rr 'x y1))
  (let* ((imp (dk-cite! 'rr-le-of-le-add-all-pos 'x 'y))
         (ant (cadr imp)))
    (dk-have! ant
      (lambda ()
        (dk-peel!)
        (let* ((g (dk-goal)) (dv (caddr (caddr g))))
          (fact 'rr-pos-rr-in-rr dv)
          (fact 'rr-lt-of-pos-rr dv)
          (dk-have! (list '<= 0 dv) (lambda () (dk-ineq! (list '< 0 dv))))
          (let* ((h1 (dk-apply! hyp dv))
                 (e2 (dk-cite! 'eplus-real-defined 'y dv))
                 (h2 (dk-rewrite-h! h1 (cadr e2) (caddr e2))))
            (dk-ineq! '(IN x RR) '(IN y RR) (list 'IN dv 'RR) h2)))))
    (detach! imp)
    (ass)))
(qed 'rps-le-of-forall-eps)
(topic! 'rps-le-of-forall-eps 'inequalities)

;;; eplus-swap4: (a + b) + (c + d) = (a + c) + (b + d) in [0, +inf]
(sp (make-wff '(FORALL a_ (FORALL b_ (FORALL c_ (FORALL d_
   (IMPLIES (IN a_ RR-POS-STAR) (IMPLIES (IN b_ RR-POS-STAR)
     (IMPLIES (IN c_ RR-POS-STAR) (IMPLIES (IN d_ RR-POS-STAR)
       (= (eplus (eplus a_ b_) (eplus c_ d_)) (eplus (eplus a_ c_) (eplus b_ d_)))))))))))))
(dk-peel!)
(define (omc-ep! x y)
  (omc-and2! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR))
  (fact 'eplus-closed x y)
  (list 'eplus x y))
(define (omc-assoc! x y z)
  (omc-and3! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR) (list 'IN z 'RR-POS-STAR))
  (fact 'eplus-assoc x y z)
  (list '= (list 'eplus (list 'eplus x y) z) (list 'eplus x (list 'eplus y z))))
(let* ((ab (omc-ep! 'a_ 'b_)) (cd (omc-ep! 'c_ 'd_)) (ac (omc-ep! 'a_ 'c_)) (bd (omc-ep! 'b_ 'd_))
       (bc (omc-ep! 'b_ 'c_)) (cb (omc-ep! 'c_ 'b_))
       (bcd (omc-ep! 'b_ cd)) (cbd (omc-ep! 'c_ bd)))
  (omc-ep! bc 'd_) (omc-ep! cb 'd_) (omc-ep! 'a_ bcd) (omc-ep! 'a_ cbd)
  (subst (omc-assoc! 'a_ 'b_ cd))
  (subst (omc-assoc! 'a_ 'c_ bd))
  (let ((e1 (omc-assoc! 'b_ 'c_ 'd_)) (e2 (omc-assoc! 'c_ 'b_ 'd_)))
    (subst (list '= (caddr e1) (cadr e1)))
    (subst (list '= (caddr e2) (cadr e2))))
  (omc-and2! '(IN b_ RR-POS-STAR) '(IN c_ RR-POS-STAR))
  (fact 'eplus-comm 'b_ 'c_)
  (subst (list '= bc cb))
  (omc-ep! 'a_ (list 'eplus cb 'd_))
  (rfl))
(qed 'eplus-swap4)
(topic! 'eplus-swap4 'inequalities)

;;; the prefix sums of a pointwise sum
(define omc-hl '(VNB-LAMBDA oak_ NN (eplus (f oak_) (g oak_))))
(define (omc-fs f s) (list 'FINSUM 'RR-POS-STAR-ADD-MONOID f s))
(define (omc-hl-type!)
  (dk-have! (list 'IN omc-hl '(FUN NN RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((kv (cadr (car (dk-peel!)))))
            (fact 'fun-apply-type-c 'f 'NN 'RR-POS-STAR kv)
            (fact 'fun-apply-type-c 'g 'NN 'RR-POS-STAR kv)
            (omc-ep! (list 'f kv) (list 'g kv))
            (ass)))))))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
  (list 'FORALL 'f (list 'FORALL 'g (list 'IMPLIES '(IN f (FUN NN RR-POS-STAR))
    (list 'IMPLIES '(IN g (FUN NN RR-POS-STAR))
      (list '= (omc-fs omc-hl '(ORD-SEGMENT n))
               (list 'eplus (omc-fs 'f '(ORD-SEGMENT n)) (omc-fs 'g '(ORD-SEGMENT n))))))))))))
(for-each
  (lambda (l)
    (dk-focus! l)
    (if (dk-contains? (dk-goal-of l) '(ORD-SEGMENT 0))
        (begin
          (dk-peel!)
          (fact 'rps-prefix-zero omc-hl)
          (fact 'rps-prefix-zero 'f)
          (fact 'rps-prefix-zero 'g)
          (subst (list '= (omc-fs omc-hl '(ORD-SEGMENT 0)) 0))
          (subst (list '= (omc-fs 'f '(ORD-SEGMENT 0)) 0))
          (subst (list '= (omc-fs 'g '(ORD-SEGMENT 0)) 0))
          (fact 'zero-in-rr-pos-star)
          (fact 'eplus-zero-left 0)
          (subst '(= (eplus 0 0) 0))
          (fact 'rr-zero-in)
          (rfl))
        (let* ((landed (dk-landed (lambda () (di))))
               (nin (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN) (eq? (caddr f) 'NN))) landed))
               (nv (cadr nin))
               (ih (dk-landed-1 (lambda () (di))))
               (sn (list 'ORD-SEGMENT nv)) (ss (list 'ORD-SEGMENT (list 'succ nv))))
          (dk-peel!)
          (omc-hl-type!)
          (dk-apply! ih 'f 'g)
          (fact 'rps-prefix-succ omc-hl nv)
          (fact 'rps-prefix-succ 'f nv)
          (fact 'rps-prefix-succ 'g nv)
          (fact 'rps-prefix-type 'f nv)
          (fact 'rps-prefix-type 'g nv)
          (fact 'fun-apply-type-c 'f 'NN 'RR-POS-STAR nv)
          (fact 'fun-apply-type-c 'g 'NN 'RR-POS-STAR nv)
          (dk-have! (list '= (list omc-hl nv) (list 'eplus (list 'f nv) (list 'g nv)))
            (lambda () (dk-lam-b!) (omc-ep! (list 'f nv) (list 'g nv)) (if (not (dk-ass!)) (rfl))))
          (subst (list '= (omc-fs omc-hl ss) (list 'eplus (omc-fs omc-hl sn) (list omc-hl nv))))
          (subst (list '= (omc-fs 'f ss) (list 'eplus (omc-fs 'f sn) (list 'f nv))))
          (subst (list '= (omc-fs 'g ss) (list 'eplus (omc-fs 'g sn) (list 'g nv))))
          (subst (list '= (list omc-hl nv) (list 'eplus (list 'f nv) (list 'g nv))))
          (subst (list '= (omc-fs omc-hl sn) (list 'eplus (omc-fs 'f sn) (omc-fs 'g sn))))
          (fact 'eplus-swap4 (omc-fs 'f sn) (omc-fs 'g sn) (list 'f nv) (list 'g nv))
          (ass))))
  (dk-opened (lambda () (ni))))
(qed 'rps-prefix-add)
(topic! 'rps-prefix-add 'inequalities)

;;; esum-nn-add-le: the sum of a pointwise sum is at most the sum of the sums
(sp (make-wff (list 'FORALL 'f (list 'FORALL 'g (list 'IMPLIES '(IN f (FUN NN RR-POS-STAR))
    (list 'IMPLIES '(IN g (FUN NN RR-POS-STAR))
      (list '<= (list 'ESUM omc-hl) '(eplus (ESUM f) (ESUM g)))))))))
(dk-peel!)
(omc-hl-type!)
(omc-esum-type! 'f)
(omc-esum-type! 'g)
(let ((b (omc-ep! '(ESUM f) '(ESUM g))))
  (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (omc-fs omc-hl '(ORD-SEGMENT n)) b)))
    (lambda ()
      (let* ((nv (dk-di-var!)) (sn (list 'ORD-SEGMENT nv)))
        (fact 'rps-prefix-add nv 'f 'g)
        (fact 'rps-prefix-type 'f nv)
        (fact 'rps-prefix-type 'g nv)
        (fact 'esum-nn-prefix-le 'f nv)
        (fact 'esum-nn-prefix-le 'g nv)
        (omc-and4! (list 'IN (omc-fs 'f sn) 'RR-POS-STAR) (list 'IN (omc-fs 'g sn) 'RR-POS-STAR)
                   '(IN (ESUM f) RR-POS-STAR) '(IN (ESUM g) RR-POS-STAR))
        (omc-and2! (list '<= (omc-fs 'f sn) '(ESUM f)) (list '<= (omc-fs 'g sn) '(ESUM g)))
        (fact 'eplus-mono (omc-fs 'f sn) (omc-fs 'g sn) '(ESUM f) '(ESUM g))
        (subst (list '= (omc-fs omc-hl sn) (list 'eplus (omc-fs 'f sn) (omc-fs 'g sn))))
        (ass))))
  (fact 'esum-nn-le-of-prefixes omc-hl b)
  (ass))
(qed 'esum-nn-add-le)
(topic! 'esum-nn-add-le 'inequalities)

;;; =====================================================================
;;; (3) the eps / 2^(i+1) budget: e_i = eps * 2^-(i+1) is a sequence in
;;;     [0, +inf] of positive reals whose sum is at most eps.  Through the
;;;     dyadic weights of dyadic-weights.scm (DW, dyadic-partial-sum).
;;; =====================================================================

(define omc-dw '(VNB-LAMBDA n NN (/ 1 (power 2 (+ n 1)))))
(define (omc-w k) (list 'recip (list 'power 2 (list 'succ k))))
(define (omc-ew k) (list '* 'eps (omc-w k)))
(define omc-el '(VNB-LAMBDA oei_ NN (* eps (recip (power 2 (succ oei_))))))

;;; (IN t RR-POS-STAR) from (IN t RR) and (<= 0 t) in context
(define (omc-rps! t)
  (dk-have! (list 'IN t 'RR-POS-STAR)
    (lambda ()
      (mac 'rr-pos-star-membership)
      (oi-l)
      (dk-conj-close! dk-ass!))))

;;; with (IN eps RR) and (< 0 eps) in context, k in NN: everything about w_k and eps * w_k
(define (omc-w-facts! k)
  (let* ((sk (list 'succ k)) (p (list 'power 2 sk)) (w (omc-w k)) (ewt (omc-ew k)))
    (if (not (dk-asm? (list 'IN ewt 'RR-POS-STAR)))
        (begin
          (fact 'nn-succ-closed k)
          (dk-have! '(IN 2 RR) (lambda () (arith)))
          (fact 'power-real-closed 2 sk)
          (fact 'power-two-pos sk)
          (dk-have! (list 'NOT (list '= p 0)) (lambda () (di) (dk-absurd! (list '= p 0) (list '< 0 p))))
          (omc-and2! (list 'IN p 'RR) (list 'NOT (list '= p 0)))
          (fact 'rr-recip-closed p)
          (fact 'rr-recip-pos p)
          (fact 'rr-mul-pos 'eps w)
          (dk-have! (list 'IN ewt 'RR) (lambda () (type-term)))
          (dk-have! (list '<= 0 ewt) (lambda () (dk-ineq! (list '< 0 ewt))))
          (omc-rps! ewt)))))

(define (omc-eps-parts!)
  (fact 'rr-pos-rr-in-rr 'eps)
  (fact 'rr-lt-of-pos-rr 'eps))

(define (omc-el-type!)
  (dk-have! (list 'IN omc-el '(FUN NN RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((kv (cadr (car (dk-peel!)))))
            (omc-then-ass! (lambda () (omc-w-facts! kv)))))))))

(sp (make-wff (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
   (list 'AND (list 'IN omc-el '(FUN NN RR-POS-STAR))
              (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
                 (list '< 0 (list omc-el 'k)))))))))
(dk-peel!)
(omc-eps-parts!)
(omc-el-type!)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (let ((kv (dk-di-var!)))
          (omc-w-facts! kv)
          (if (not (dk-lam-b!)) (ass))))))
(qed 'dyadic-eps-type)
(topic! 'dyadic-eps-type 'inequalities)

(sp (make-wff (list 'FORALL 'ogn (list 'IMPLIES '(IN ogn NN)
   (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
     (list '= (omc-fs omc-el '(ORD-SEGMENT ogn))
              (list '* 'eps (list 'SERIES-PARTIAL-SUM omc-dw 'ogn)))))))))
(for-each
  (lambda (l)
    (dk-focus! l)
    (if (dk-contains? (dk-goal-of l) '(ORD-SEGMENT 0))
        (begin
          (dk-peel!)
          (omc-eps-parts!)
          (fact 'rps-prefix-zero omc-el)
          (subst (list '= (omc-fs omc-el '(ORD-SEGMENT 0)) 0))
          (mac 'series-partial-sum-zero)
          (crs))
        (let* ((landed (dk-landed (lambda () (di))))
               (nin (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN) (eq? (caddr f) 'NN))) landed))
               (nv (cadr nin))
               (ih (dk-landed-1 (lambda () (di))))
               (sn (list 'ORD-SEGMENT nv)) (ss (list 'ORD-SEGMENT (list 'succ nv)))
               (s  (list 'SERIES-PARTIAL-SUM omc-dw nv))
               (es (list '* 'eps s))
               (pn (omc-fs omc-el sn))
               (ew (omc-ew nv)))
          (dk-peel!)
          (omc-eps-parts!)
          (omc-el-type!)
          (dk-apply! ih 'eps)
          (fact 'rps-prefix-succ omc-el nv)
          (fact 'rps-prefix-type omc-el nv)
          (omc-w-facts! nv)
          (dk-have! (list '= (list omc-el nv) ew) (lambda () (dk-lam-b!) (if (not (dk-ass!)) (rfl))))
          (fact 'dyadic-weight-in-fun)
          (fact 'series-partial-sum-in-rr nv omc-dw)
          (dk-have! (list 'IN es 'RR) (lambda () (type-term)))
          (fact 'rr-pos-star-nonneg pn)
          (dk-rewrite-h! (list '<= 0 pn) pn es)
          (let ((e2 (dk-cite! 'eplus-real-defined es ew)))
            (subst (list '= (omc-fs omc-el ss) (list 'eplus pn (list omc-el nv))))
            (subst (list '= pn es))
            (subst (list '= (list omc-el nv) ew))
            (subst e2)
            (fact 'fun-apply-type-c omc-dw 'NN 'RR nv)
            (mac 'series-partial-sum-succ)
            (fact 'dyadic-weight-apply nv)
            (subst (list '= (list omc-dw nv) (omc-w nv)))
            (let ((g (dk-goal)))
              (dk-have! '(FORALL oxa_ (IMPLIES (IN oxa_ RR) (FORALL oxb_ (IMPLIES (IN oxb_ RR)
                           (FORALL oxc_ (IMPLIES (IN oxc_ RR)
                             (= (binplus (* oxa_ oxb_) (* oxa_ oxc_)) (* oxa_ (+ oxb_ oxc_)))))))))
                (lambda () (dk-peel!) (crs)))
              (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'oxa_))) "distrib")
                         'eps s (omc-w nv))
              (ass))))))
  (dk-opened (lambda () (ni))))
(qed 'dyadic-eps-prefix)
(topic! 'dyadic-eps-prefix 'inequalities)
;;; the budget's total is at most eps
(sp (make-wff (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
   (list '<= (list 'ESUM omc-el) 'eps)))))
(dk-peel!)
(omc-eps-parts!)
(omc-el-type!)
(dk-have! '(<= 0 eps) (lambda () (dk-ineq! '(< 0 eps))))
(omc-rps! 'eps)
(dk-have! (list 'FORALL 'ogn (list 'IMPLIES '(IN ogn NN) (list '<= (omc-fs omc-el '(ORD-SEGMENT ogn)) 'eps)))
  (lambda ()
    (let* ((nv (dk-di-var!))
           (pn (omc-fs omc-el (list 'ORD-SEGMENT nv)))
           (s  (list 'SERIES-PARTIAL-SUM omc-dw nv))
           (p  (list 'power 2 nv))
           (r  (list 'recip p)))
      (fact 'dyadic-eps-prefix nv 'eps)
      (fact 'dyadic-partial-sum nv)
      (fact 'dyadic-weight-in-fun)
      (fact 'series-partial-sum-in-rr nv omc-dw)
      (dk-have! '(IN 2 RR) (lambda () (arith)))
      (fact 'power-real-closed 2 nv)
      (fact 'power-two-pos nv)
      (dk-have! (list 'NOT (list '= p 0)) (lambda () (di) (dk-absurd! (list '= p 0) (list '< 0 p))))
      (omc-and2! (list 'IN p 'RR) (list 'NOT (list '= p 0)))
      (fact 'rr-recip-closed p)
      (fact 'rr-recip-pos p)
      (let ((seq (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) s))) "the partial sum")))
        (dk-have! (list '<= s 1) (lambda () (dk-ineq! (list 'IN s 'RR) (list 'IN r 'RR) seq (list '< 0 r)))))
      (fact 'rr-one-in)
      (omc-and2! '(<= 0 eps) (list '<= s 1))
      (fact 'rr-le-scale-nonneg 'eps s 1)
      (subst (list '= pn (list '* 'eps s)))
      (dk-have! (list 'IN (list '* 'eps s) 'RR) (lambda () (type-term)))
      (dk-ineq! '(IN eps RR) (list 'IN (list '* 'eps s) 'RR) (list '<= (list '* 'eps s) '(* eps 1))))))
(fact 'esum-nn-le-of-prefixes omc-el 'eps)
(ass)
(qed 'dyadic-eps-sum-le)
(topic! 'dyadic-eps-sum-le 'inequalities)

;;; =====================================================================
;;; (4) the Cantor code dominates its components: NNFST z <= z, NNSND z <= z.
;;; =====================================================================

(sp (make-wff '(FORALL ots (IMPLIES (IN ots NN) (<= ots (TRINUM ots))))))
(for-each
  (lambda (l)
    (dk-focus! l)
    (if (dk-contains? (dk-goal-of l) '(TRINUM 0))
        (begin (mac 'trinum-zero) (fact 'nn-zero-in) (dk-nn!))
        (let* ((landed (dk-landed (lambda () (di))))
               (nin (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN) (eq? (caddr f) 'NN))) landed))
               (sv (cadr nin))
               (ih (dk-landed-1 (lambda () (di)))))
          (fact 'trinum-type sv)
          (fact 'nn-succ-closed sv)
          (mac 'trinum-succ)
          (dk-nn! ih))))
  (dk-opened (lambda () (ni))))
(qed 'trinum-ge)
(topic! 'trinum-ge 'combinatorial)

;;; z = NNPAIR(i0, j0) with its components, landed; returns (i0 j0 unfold-eq)
(define (omc-unpair! zv)
  (let* ((ex (dk-fact! 'nnpair-onto zv))
         (i0 (dk-skolem! ex))
         (ex2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f i0))) "the second witness"))
         (j0 (dk-skolem! ex2))
         (pr (list 'NNPAIR i0 j0))
         (s  (list '+ i0 j0))
         (body (list '+ (list 'TRINUM s) j0)))
    (omc-and2! (list 'IN i0 'NN) (list 'IN j0 'NN))
    (fact 'nn-add-closed i0 j0)
    (fact 'trinum-type s)
    (dk-have! (list 'IN body 'NN) (lambda () (omc-and2! (list 'IN (list 'TRINUM s) 'NN) (list 'IN j0 'NN))
                                             (fact 'nn-add-closed (list 'TRINUM s) j0) (ass)))
    (dk-have! (list '= pr body) (lambda () (mac 'NNPAIR) (rfl)))
    (list i0 j0)))

(sp (make-wff '(FORALL ozv (IMPLIES (IN ozv NN)
   (AND (<= (NNFST ozv) ozv) (<= (NNSND ozv) ozv))))))
(dk-peel!)
(let* ((r (omc-unpair! 'ozv)) (i0 (car r)) (j0 (cadr r))
       (pr (list 'NNPAIR i0 j0))
       (s (list '+ i0 j0)) (tr (list 'TRINUM s)))
  (fact 'trinum-ge s)
  (let* ((e1 (dk-cite! 'nnfst-nnpair i0 j0))
         (e2 (dk-cite! 'nnsnd-nnpair i0 j0))
         (pe (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) pr) (eq? (caddr f) 'ozv))) "the code equation"))
         (f1 (dk-rewrite-h! e1 pr 'ozv))
         (f2 (dk-rewrite-h! e2 pr 'ozv))
         (ue (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) pr) (not (eq? (caddr f) 'ozv)))) "the unfold"))
         (ze (dk-rewrite-h! ue pr 'ozv)))
    (fact 'nnfst-type 'ozv)
    (fact 'nnsnd-type 'ozv)
    (dk-conj-close!
      (lambda ()
        (if (dk-contains? (dk-goal) 'NNFST)
            (begin (subst f1) (dk-nn! ze (list '<= s tr)))
            (begin (subst f2) (dk-nn! ze (list '<= s tr))))))))
(qed 'nn-unpair-le)
(topic! 'nn-unpair-le 'combinatorial)

;;; =====================================================================
;;; (5) the double sum: re-indexing a doubly indexed family by the Cantor
;;;     code does not increase its sum.  Two fiber decompositions
;;;     (finsum-cm-fiber-ptwise): over NNFST, then over NNSND, each fiber of
;;;     the second being inside the singleton {NNPAIR(i, j)}.
;;; =====================================================================

(define omc-m 'RR-POS-STAR-ADD-MONOID)
(define omc-carr-eq '(== (CARR RR-POS-STAR-ADD-MONOID) RR-POS-STAR))
(define (omc-readoff! eqn)
  (dk-have! eqn
    (lambda ()
      (quietly (lambda () (surface-goal! 'RR-POS-STAR-ADD-MONOID)))
      (qrfl))))

;;; prove the focus goal (FORALL z (IMPLIES (IN z A) P)) with BODY run on the eigenvariable
(define (omc-forall! body)
  (let ((zv (dk-di-var!))) (body zv)))

;;; a FINSUM over a finite set of [0,+inf]-valued terms is in [0,+inf]
(define (omc-fs-type! f s)
  (let ((t (omc-fs f s)))
    (if (not (dk-asm? (list 'IN t 'RR-POS-STAR)))
        (begin
          (fact 'rr-pos-star-is-comm-monoid)
          (omc-readoff! omc-carr-eq)
          (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN (list f 'z) '(CARR RR-POS-STAR-ADD-MONOID))))
            (lambda ()
              (omc-forall!
                (lambda (zv)
                  (subst omc-carr-eq)
                  (inst+ (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL)
                                                   (equal? (caddr h) (list 'IMPLIES (list 'IN (cadr h) s)
                                                                           (list 'IN (list f (cadr h)) 'RR-POS-STAR)))))
                                  "the pointwise typing")
                         zv)
                  (ass)))))
          (fact 'finsum-comm-monoid-type-ptwise omc-m s f)
          (dk-have! (list 'IN t 'RR-POS-STAR) (lambda () (subst '(= RR-POS-STAR (CARR RR-POS-STAR-ADD-MONOID))) (ass)))))))

(sp (make-wff '(FORALL ofs (FORALL oft (FORALL ofp (FORALL off (FORALL ofg
   (IMPLIES (IN ofs SET) (IMPLIES (IN (CARD ofs) NN)
   (IMPLIES (IN oft SET) (IMPLIES (IN (CARD oft) NN)
   (IMPLIES (FORALL z_ (IMPLIES (IN z_ ofs) (IN (ofp z_) oft)))
   (IMPLIES (FORALL z_ (IMPLIES (IN z_ ofs) (IN (off z_) RR-POS-STAR)))
   (IMPLIES (FORALL z_ (IMPLIES (IN z_ oft) (IN (ofg z_) RR-POS-STAR)))
   (IMPLIES (FORALL z_ (IMPLIES (IN z_ oft)
              (<= (FINSUM RR-POS-STAR-ADD-MONOID off (SEP ofw_ ofs (= (ofp ofw_) z_))) (ofg z_))))
     (<= (FINSUM RR-POS-STAR-ADD-MONOID off ofs) (FINSUM RR-POS-STAR-ADD-MONOID ofg oft)))))))))))))))))
(dk-peel!)
(fact 'rr-pos-star-is-comm-monoid)
(omc-readoff! omc-carr-eq)
(let* ((gl '(VNB-LAMBDA ogz_ oft (FINSUM RR-POS-STAR-ADD-MONOID off (SEP ofw_ ofs (= (ofp ofw_) ogz_)))))
       (bound (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '<=))) "the fiber bound"))
       (gtyp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'ofg) (not (dk-contains? h '<=)))) "g typed"))
       (ftyp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'off) (not (dk-contains? h '<=)))) "f typed"))
       (ptyp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'ofp) (not (dk-contains? h 'off)))) "phi maps")))
  ;; f in CARR M on S
  (dk-have! '(FORALL z_ (IMPLIES (IN z_ ofs) (IN (off z_) (CARR RR-POS-STAR-ADD-MONOID))))
    (lambda () (omc-forall! (lambda (zv) (subst omc-carr-eq) (inst+ ftyp zv) (ass)))))
  ;; S = sum over T of the fiber sums
  (let ((fe (dk-chain! (dk-cite! 'finsum-cm-fiber-ptwise omc-m 'ofs 'oft 'ofp 'off gl)
              (lambda (ante)
                (lambda ()
                  (omc-forall! (lambda (zv) (dk-lam-b!) (qrfl))))))))
    ;; the fiber sums are typed and below g
    (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ oft) (list 'IN (list gl 'z_) 'RR-POS-STAR)))
      (lambda ()
        (omc-forall!
          (lambda (zv)
            (let ((fib (list 'SEP 'ofw_ 'ofs (list '= '(ofp ofw_) zv))))
              (dk-lam-b!)
              (dk-have! (list 'SUBSET fib 'ofs) (lambda () (mac 'subset-def) (omc-forall! (lambda (wv) (sep-me (list 'IN wv fib)) (dk-split-all!) (ass)))))
              (fact 'subclass-of-set-is-set fib 'ofs)
              (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z fib) (list 'IN 'z 'ofs)))
                (lambda () (omc-forall! (lambda (wv) (fact 'subset-mem-fwd fib 'ofs wv) (ass)))))
              (omc-and2! '(IN ofs SET) '(IN (CARD ofs) NN))
              (omc-and2! (list 'IN fib 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z fib) (list 'IN 'z 'ofs))))
              (fact 'card-subset-nn 'ofs fib)
              (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z fib) (list 'IN '(off z) 'RR-POS-STAR)))
                (lambda () (omc-forall! (lambda (wv) (fact 'subset-mem-fwd fib 'ofs wv) (inst+ ftyp wv) (ass)))))
              (omc-then-ass! (lambda () (omc-fs-type! 'off fib))))))))
    (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ oft) (list '<= (list gl 'z_) '(ofg z_))))
      (lambda () (omc-forall! (lambda (zv) (dk-lam-b!) (inst+ bound zv) (ass)))))
    (let ((le (dk-chain! (dk-cite! 'rps-finsum-le-ptwise 'oft gl 'ofg)
                (lambda (ante) (lambda () (ass))))))
      (subst fe)
      (ass))))
(qed 'rps-finsum-fiber-le)
(topic! 'rps-finsum-fiber-le 'inequalities)

;;; seg(n) is a finite set
(define (omc-seg-finite! nv)
  (let ((sv (list 'ORD-SEGMENT nv)))
    (if (not (dk-asm? (list 'IN (list 'CARD sv) 'NN)))
        (begin
          (fact 'nn-subset-ord nv)
          (fact 'ord-segment-is-set nv)
          (fact 'card-segment nv)
          (dk-have! (list 'IN (list 'CARD sv) 'NN) (lambda () (subst (list '= (list 'CARD sv) nv)) (ass)))))))

;;; z in seg(n) gives z in NN and z < n
(define (omc-seg-mem! nv zv)
  (fact 'ord-segment-nn-subset nv zv)
  (let ((iff (dk-cite! 'seg-mem-lt nv zv)))
    (dk-project! (list '< zv nv) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff)))))))

;;; x in NN, x < n gives x in seg(n)
(define (omc-into-seg! nv xv)
  (let ((iff (dk-cite! 'seg-mem-lt nv xv)))
    (dk-have! (list 'IN xv (list 'ORD-SEGMENT nv))
      (lambda () (ai iff) (detach! (list 'IMPLIES (caddr iff) (cadr iff))) (ass)))))

;;; on the focus goal (FORALL z (IMPLIES (IN z SRC) (IN (PROJ z) seg(n)))), SRC inside seg(n)
;;; (SUB? true when SRC is a SEP over seg(n) to be read through sep-me)
(define omc-p1 '(VNB-LAMBDA ofq_ NN (NNFST ofq_)))
(define omc-p2 '(VNB-LAMBDA ofr_ NN (NNSND ofr_)))
(define (omc-proj-into-seg! nv proj src)
  (omc-forall!
    (lambda (zv)
      (if (not (equal? src (list 'ORD-SEGMENT nv)))
          (dk-project! (list 'IN zv (list 'ORD-SEGMENT nv))
                       (lambda () (sep-me (list 'IN zv src)) (dk-split-all!))))
      (omc-seg-mem! nv zv)
      (dk-lam-b!)
      (let* ((pr (dk-cite! 'nn-unpair-le zv))
             (pz (list proj zv)))
        (dk-split-all! (list pr))
        (fact (if (eq? proj 'NNFST) 'nnfst-type 'nnsnd-type) zv)
        (dk-have! (list '< pz nv) (lambda () (dk-nn! (list '<= pz zv) (list '< zv nv))))
        (omc-then-ass! (lambda () (omc-into-seg! nv pz)))))))

;;; on the focus goal (FORALL z (IMPLIES (IN z SRC) (IN (F z) RR-POS-STAR))), F in FUN(NN, RPS), SRC inside seg(n)
(define (omc-ptwise-typed! nv f src)
  (omc-forall!
    (lambda (zv)
      (if (not (equal? src (list 'ORD-SEGMENT nv)))
          (dk-project! (list 'IN zv (list 'ORD-SEGMENT nv))
                       (lambda () (sep-me (list 'IN zv src)) (dk-split-all!))))
      (fact 'ord-segment-nn-subset nv zv)
      (fact 'fun-apply-type-c f 'NN 'RR-POS-STAR zv)
      (ass))))

;;; a SEP over a finite SUP is a finite set (with SEP subset SUP landed)
(define (omc-sep-finite! sep sup)
  (dk-have! (list 'SUBSET sep sup)
    (lambda () (mac 'subset-def) (omc-forall! (lambda (wv) (sep-me (list 'IN wv sep)) (dk-split-all!) (ass)))))
  (fact 'subclass-of-set-is-set sep sup)
  (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z sep) (list 'IN 'z sup)))
    (lambda () (omc-forall! (lambda (wv) (fact 'subset-mem-fwd sep sup wv) (ass)))))
  (omc-and2! (list 'IN sup 'SET) (list 'IN (list 'CARD sup) 'NN))
  (omc-and2! (list 'IN sep 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z sep) (list 'IN 'z sup))))
  (fact 'card-subset-nn sup sep))

;;; the second fiber: on the goal (FORALL z (IMPLIES (IN z seg n) (<= (FINSUM M ofl Dij) ((oaa iv) z))))
(define (omc-fib2! nv iv fi)
  (let* ((jv (dk-di-var!))
         (g (dk-goal))
         (dij (cadddr (cadr g)))
         (c (list 'NNPAIR iv jv))
         (pc (list 'PAIR c c))
         (fdef (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-head-is? (caddr h) 'IMPLIES)
                                         (dk-head-is? (caddr (caddr h)) '=)
                                         (equal? (cadr (caddr (caddr h))) (list 'ofl (cadr h)))))
                        "the flat sequence")))
    (fact 'ord-segment-nn-subset nv jv)
    (fact 'nnpair-type iv jv)
    (fact 'membership-implies-sethood c 'NN)
    (omc-and2! (list 'IN c 'SET) (list 'IN c 'SET))
    (fact 'pairing c c)
    (fact 'card-singleton c)
    (fact 'nn-zero-in)
    (fact 'nn-succ-closed 0)
    (dk-have! (list 'IN (list 'CARD pc) 'NN) (lambda () (subst (list '= (list 'CARD pc) '(succ 0))) (ass)))
    (let ((pm (dk-cite! 'pairing-membership c c)))
      ;; Dij inside {c}
      (dk-have! (list 'SUBSET dij pc)
        (lambda ()
          (mac 'subset-def)
          (omc-forall!
            (lambda (wv)
              (sep-me (list 'IN wv dij))
              (dk-split-all!)
              (sep-me (list 'IN wv fi))
              (dk-split-all!)
              (fact 'ord-segment-nn-subset nv wv)
              (dk-lam-b-h! (list '= (list omc-p2 wv) jv))
              (dk-lam-b-h! (list '= (list omc-p1 wv) iv))
              (let* ((r (omc-unpair! wv)) (i0 (car r)) (j0 (cadr r))
                     (pr (list 'NNPAIR i0 j0))
                     (e1 (dk-rewrite-h! (dk-cite! 'nnfst-nnpair i0 j0) pr wv))
                     (e2 (dk-rewrite-h! (dk-cite! 'nnsnd-nnpair i0 j0) pr wv)))
                (dk-have! (list '= i0 iv) (lambda () (subst (list '= i0 (list 'NNFST wv))) (ass)))
                (dk-have! (list '= j0 jv) (lambda () (subst (list '= j0 (list 'NNSND wv))) (ass)))
                (dk-have! (list '= wv c)
                  (lambda ()
                    (subst (list '= wv pr))
                    (subst (list '= i0 iv))
                    (subst (list '= j0 jv))
                    (rfl)))
                (inst+ pm wv)
                (dk-have! (list 'OR (list '= wv c) (list '= wv c)) (lambda () (oi-l) (ass)))
                (let ((iff (dk-pick (lambda (h) (and (dk-head-is? h 'IFF) (equal? (cadr h) (list 'IN wv pc)))) "the pair iff")))
                  (ai iff)
                  (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
                  (ass)))))))
      ;; ofl typed on {c}
      (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z pc) (list 'IN '(ofl z) 'RR-POS-STAR)))
        (lambda ()
          (omc-forall!
            (lambda (wv)
              (inst+ pm wv)
              (let ((iff (dk-pick (lambda (h) (and (dk-head-is? h 'IFF) (equal? (cadr h) (list 'IN wv pc)))) "the pair iff")))
                (ai iff)
                (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
                (dk-have! (list '= wv c) (lambda () (omc-keep-prop! (caddr iff))))
                (subst (list '= wv c))
                (fact 'fun-apply-type-c 'ofl 'NN 'RR-POS-STAR c)
                (ass))))))
      (fact 'rps-finsum-mono-set 'ofl dij pc)
      (fact 'fun-apply-type-c 'ofl 'NN 'RR-POS-STAR c)
      (fact 'rr-pos-star-is-comm-monoid)
      (omc-readoff! omc-carr-eq)
      (dk-have! (list 'IN (list 'ofl c) '(CARR RR-POS-STAR-ADD-MONOID))
        (lambda () (subst '(= (CARR RR-POS-STAR-ADD-MONOID) RR-POS-STAR)) (ass)))
      (let* ((sing (dk-cite! 'finsum-cm-singleton-ptwise omc-m c 'ofl))
             (fc (dk-apply! fdef c)))
        (dk-cite! 'nnfst-nnpair iv jv)
        (dk-cite! 'nnsnd-nnpair iv jv)
        (let* ((f1 (dk-rewrite-h! fc (list 'NNFST c) iv))
               (f2 (dk-rewrite-h! f1 (list 'NNSND c) jv)))
          (subst (list '= (caddr f2) (list 'ofl c)))
          (subst (list '= (list 'ofl c) (omc-fs 'ofl pc)))
          (ass))))))

;;; the first fiber: on the goal (FORALL z (IMPLIES (IN z seg n) (<= (FINSUM M ofl Fi) (otl z))))
(define (omc-fib1! nv)
  (let* ((sv (list 'ORD-SEGMENT nv))
         (iv (dk-di-var!))
         (g (dk-goal))
         (fi (cadddr (cadr g)))
         (aiv (list 'oaa iv))
         (tdef (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-head-is? (caddr h) 'IMPLIES)
                                         (dk-head-is? (caddr (caddr h)) '=)
                                         (equal? (cadr (caddr (caddr h))) (list 'otl (cadr h)))))
                        "the outer sums")))
    (fact 'ord-segment-nn-subset nv iv)
    (fact 'fun-apply-type-c 'oaa 'NN '(FUN NN RR-POS-STAR) iv)
    (let ((te (dk-apply! tdef iv)))
      (subst te))
    (omc-sep-finite! fi sv)
    (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z fi) (list 'IN '(ofl z) 'RR-POS-STAR)))
      (lambda () (omc-ptwise-typed! nv 'ofl fi)))
    (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z sv) (list 'IN (list aiv 'z) 'RR-POS-STAR)))
      (lambda () (omc-ptwise-typed! nv aiv sv)))
    (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z fi) (list 'IN (list omc-p2 'z) sv)))
      (lambda () (omc-proj-into-seg! nv 'NNSND fi)))
    (let* ((ch (dk-cite! 'rps-finsum-fiber-le fi sv omc-p2 'ofl aiv))
           (le (dk-chain! ch
                (lambda (ante) (lambda () (omc-fib2! nv iv fi))))))
      (fact 'esum-nn-prefix-le aiv nv)
      (fact 'rps-prefix-type aiv nv)
      (omc-esum-type! aiv)
      (omc-fs-type! 'ofl fi)
      (omc-trans! (omc-fs 'ofl fi) (omc-fs aiv sv) (list 'ESUM aiv))
      (ass))))

(sp (make-wff '(FORALL oaa (FORALL ofl (FORALL otl
  (IMPLIES (IN oaa (FUN NN (FUN NN RR-POS-STAR)))
  (IMPLIES (IN ofl (FUN NN RR-POS-STAR))
  (IMPLIES (IN otl (FUN NN RR-POS-STAR))
  (IMPLIES (FORALL m_ (IMPLIES (IN m_ NN) (= (ofl m_) ((oaa (NNFST m_)) (NNSND m_)))))
  (IMPLIES (FORALL i_ (IMPLIES (IN i_ NN) (= (otl i_) (ESUM (oaa i_)))))
    (<= (ESUM ofl) (ESUM otl))))))))))))
(dk-peel!)
(omc-esum-type! 'otl)
(dk-have! '(FORALL ogn (IMPLIES (IN ogn NN) (<= (FINSUM RR-POS-STAR-ADD-MONOID ofl (ORD-SEGMENT ogn)) (ESUM otl))))
  (lambda ()
    (let* ((nv (dk-di-var!)) (sv (list 'ORD-SEGMENT nv)))
      (omc-seg-finite! nv)
      (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z sv) (list 'IN '(ofl z) 'RR-POS-STAR)))
        (lambda () (omc-ptwise-typed! nv 'ofl sv)))
      (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z sv) (list 'IN '(otl z) 'RR-POS-STAR)))
        (lambda () (omc-ptwise-typed! nv 'otl sv)))
      (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z sv) (list 'IN (list omc-p1 'z) sv)))
        (lambda () (omc-proj-into-seg! nv 'NNFST sv)))
      (let ((le (dk-chain! (dk-cite! 'rps-finsum-fiber-le sv sv omc-p1 'ofl 'otl)
                  (lambda (ante) (lambda () (omc-fib1! nv))))))
        (fact 'esum-nn-prefix-le 'otl nv)
        (fact 'rps-prefix-type 'otl nv)
        (fact 'rps-prefix-type 'ofl nv)
        (omc-trans! (omc-fs 'ofl sv) (omc-fs 'otl sv) '(ESUM otl))
        (ass)))))
(fact 'esum-nn-le-of-prefixes 'ofl '(ESUM otl))
(ass)
(qed 'esum-nn-flatten-le)
(topic! 'esum-nn-flatten-le 'inequalities)

;;; a term of a sequence is at most its sum
(sp (make-wff '(FORALL f (IMPLIES (IN f (FUN NN RR-POS-STAR))
   (FORALL k (IMPLIES (IN k NN) (<= (f k) (ESUM f))))))))
(dk-peel!)
(fact 'nn-succ-closed 'k)
(fact 'rps-prefix-succ 'f 'k)
(fact 'rps-prefix-type 'f 'k)
(fact 'rps-prefix-type 'f '(succ k))
(fact 'esum-nn-prefix-le 'f '(succ k))
(fact 'fun-apply-type-c 'f 'NN 'RR-POS-STAR 'k)
(omc-esum-type! 'f)
(let ((pk (omc-fs 'f '(ORD-SEGMENT k))) (ps (omc-fs 'f '(ORD-SEGMENT (succ k)))))
  (omc-and2! '(IN (f k) RR-POS-STAR) (list 'IN pk 'RR-POS-STAR))
  (fact 'eplus-le-left '(f k) pk)
  (omc-and2! (list 'IN pk 'RR-POS-STAR) '(IN (f k) RR-POS-STAR))
  (fact 'eplus-comm pk '(f k))
  (dk-have! (list '<= '(f k) ps)
    (lambda () (subst (list '= ps (list 'eplus pk '(f k))))
               (subst (list '= (list 'eplus pk '(f k)) (list 'eplus '(f k) pk)))
               (ass)))
  (omc-trans! '(f k) ps '(ESUM f))
  (ass))
(qed 'esum-nn-term-le)
(topic! 'esum-nn-term-le 'inequalities)

;;; =====================================================================
;;; (6) Proposition 4.7, in three parts stated on EINF(COVER-SUMS ...).
;;; =====================================================================

;;; the five conjuncts of IS-PREMEASURE(OM, CL, P), landed (hypothesis kept)
(define (omc-pm-parts-of! om cl p)
  (let* ((iff (dk-cite! 'is-premeasure om cl p))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (map (lambda (c) (dk-project! c 'IS-PREMEASURE (list 'IS-PREMEASURE om cl p))) cs)))
(define (omc-pm-parts!)
  (let* ((iff (dk-cite! 'is-premeasure 'omega 'cls 'pm))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (map (lambda (c) (dk-project! c 'IS-PREMEASURE '(IS-PREMEASURE omega cls pm))) cs)))

(define (omc-cs e) (list 'COVER-SUMS 'omega 'cls 'pm e))
(define (omc-mstar e) (list 'EINF (omc-cs e)))
;;; (IN (EINF (CS e)) RR-POS-STAR)
(define (omc-mstar-type! e)
  (if (not (dk-asm? (list 'IN (omc-mstar e) 'RR-POS-STAR)))
      (begin (fact 'cover-sums-subset 'omega 'cls 'pm e)
             (fact 'einf-in (omc-cs e)))))

;;; Prop. 4.7: mu*(empty) = 0
(sp (make-wff (forall-guarded '(omega cls pm) '((IS-PREMEASURE omega cls pm))
   '(= (EINF (COVER-SUMS omega cls pm EMPTY-SET)) 0))))
(dk-peel!)
(omc-pm-parts!)
(let* ((s0 '(VNB-LAMBDA oek_ NN EMPTY-SET))
       (h  (list 'VNB-LAMBDA 'cvk_ 'NN (list 'pm (list s0 'cvk_))))
       (m0 (omc-mstar 'EMPTY-SET)))
  (fact 'nn-is-set)
  (dk-have! (list 'IN s0 '(FUN NN cls)) (lambda () (dk-lam-type! (lambda () (dk-peel!) (ass)))))
  (fact 'empty-subset-any (list 'BIG-UNION 'cvn_ 'NN (list s0 'cvn_)))
  (fact 'cover-sums-intro 'omega 'cls 'pm 'EMPTY-SET s0)
  (fact 'zero-in-rr-pos-star)
  (dk-have! (list 'IN h '(FUN NN RR-POS-STAR))
    (lambda () (dk-lam-type! (lambda () (dk-peel!) (dk-lam-b!) (subst '(= (pm EMPTY-SET) 0)) (ass)))))
  (fact 'nn-zero-in)
  (fact 'nn-succ-closed 0)
  (dk-have! (list 'FORALL 'q (list 'IMPLIES '(IN q NN) (list '= (list h '(succ (succ q))) 0)))
    (lambda ()
      (let ((qv (dk-di-var!)))
        (fact 'nn-succ-closed qv) (fact 'nn-succ-closed (list 'succ qv))
        (dk-lam-b!) (ass))))
  (dk-have! (list '= (list h 0) 0) (lambda () (dk-lam-b!) (ass)))
  (dk-have! (list '= (list h '(succ 0)) 0) (lambda () (dk-lam-b!) (ass)))
  (fact 'esum-nn-two-support h)
  (fact 'eplus-zero-left 0)
  (dk-have! (list '= (list 'ESUM h) 0)
    (lambda () (subst (list '= (list 'ESUM h) (list 'eplus (list h 0) (list h '(succ 0)))))
               (subst (list '= (list h 0) 0)) (subst (list '= (list h '(succ 0)) 0)) (ass)))
  (omc-mstar-type! 'EMPTY-SET)
  (fact 'einf-lower (omc-cs 'EMPTY-SET) (list 'ESUM h))
  (dk-have! (list '<= m0 0) (lambda () (subst (list '= 0 (list 'ESUM h))) (ass)))
  (fact 'rr-pos-star-nonneg m0)
  (omc-antisymm! m0 0)
  (ass))
(qed 'method-i-outer-empty)
(topic! 'method-i-outer-empty 'inequalities)

;;; Prop. 4.7: monotone
(sp (make-wff (forall-guarded '(omega cls pm es ft)
   '((IN pm (FUN cls RR-POS-STAR)) (SUBSET es ft))
   '(<= (EINF (COVER-SUMS omega cls pm es)) (EINF (COVER-SUMS omega cls pm ft))))))
(dk-peel!)
(omc-mstar-type! 'es)
(fact 'cover-sums-subset 'omega 'cls 'pm 'ft)
(dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (omc-cs 'ft)) (list '<= (omc-mstar 'es) 'x)))
  (lambda ()
    (let* ((xv (dk-di-var!))
           (ex (dk-fact! 'cover-sums-elim 'omega 'cls 'pm 'ft xv))
           (sv (dk-skolem! ex))
           (bu (list 'BIG-UNION 'cvn_ 'NN (list sv 'cvn_)))
           (sm (list 'ESUM (list 'VNB-LAMBDA 'cvk_ 'NN (list 'pm (list sv 'cvk_))))))
      (fact 'subset-trans 'es 'ft bu)
      (fact 'cover-sums-intro 'omega 'cls 'pm 'es sv)
      (fact 'einf-lower (omc-cs 'es) sm)
      (subst (list '= xv sm))
      (ass))))
(fact 'einf-greatest (omc-cs 'ft) (omc-mstar 'es))
(ass)
(qed 'method-i-outer-mono)
(topic! 'method-i-outer-mono 'inequalities)

;;; Prop. 4.7: countably subadditive -- the eps / 2^(i+1) argument.
(define omc-bl '(VNB-LAMBDA osk_ NN (EINF (COVER-SUMS omega cls pm (osf osk_)))))
(define omc-tl '(VNB-LAMBDA oak_ NN (eplus ((VNB-LAMBDA osk_ NN (EINF (COVER-SUMS omega cls pm (osf osk_)))) oak_)
                                           ((VNB-LAMBDA oei_ NN (* eps (recip (power 2 (succ oei_))))) oak_))))
(define (omc-ti i) (list 'eplus (omc-mstar (list 'osf i)) (omc-ew i)))
(define (omc-good i)
  (list 'SEP 'osc_ '(FUN NN cls)
        (list 'AND (list 'SUBSET (list 'osf i) '(BIG-UNION cvn_ NN (osc_ cvn_)))
                   (list '<= '(ESUM (VNB-LAMBDA cvk_ NN (pm (osc_ cvk_)))) (omc-ti i)))))

;;; with the eps lane's context: for i in NN, the good covers of f(i) are inhabited
(define (omc-choice-ne! iv)
  (let* ((fi (list 'osf iv)) (xi (omc-mstar fi)) (ewt (omc-ew iv)) (ti (omc-ti iv))
         (gi (omc-good iv)))
    (fact 'fun-apply-type-c 'osf 'NN '(POWER omega) iv)
    (omc-mstar-type! fi)
    ;; x_i <= B, hence x_i real
    (fact 'esum-nn-term-le omc-bl iv)
    (dk-have! (list '= (list omc-bl iv) xi) (lambda () (dk-lam-b!) (if (not (dk-ass!)) (rfl))))
    (dk-have! (list '<= xi '(ESUM (VNB-LAMBDA osk_ NN (EINF (COVER-SUMS omega cls pm (osf osk_))))))
      (lambda () (subst (list '= xi (list omc-bl iv))) (ass)))
    (omc-and2! (list 'IN xi 'RR-POS-STAR) (list 'IN (list 'ESUM omc-bl) 'RR))
    (fact 'rr-pos-star-le-real-in-rr xi (list 'ESUM omc-bl))
    (fact 'rr-pos-star-nonneg xi)
    (omc-w-facts! iv)
    (let ((e1 (dk-cite! 'eplus-real-defined xi ewt)))
      (dk-have! (list '< xi ti)
        (lambda () (subst (list '= ti (caddr e1)))
                   (dk-ineq! (list 'IN xi 'RR) (list 'IN ewt 'RR) (list '< 0 ewt)))))
    (omc-and2! (list 'IN xi 'RR-POS-STAR) (list 'IN ewt 'RR-POS-STAR))
    (fact 'eplus-closed xi ewt)
    (fact 'cover-sums-subset 'omega 'cls 'pm fi)
    (let* ((ex (dk-fact! 'einf-lt-witness (omc-cs fi) ti))
           (yv (dk-skolem! ex))
           (ex2 (dk-fact! 'cover-sums-elim 'omega 'cls 'pm fi yv))
           (sv (dk-skolem! ex2))
           (sm (list 'ESUM (list 'VNB-LAMBDA 'cvk_ 'NN (list 'pm (list sv 'cvk_))))))
      (dk-project! (list '<= yv ti) (lambda () (let ((iff (dk-cite! '< yv ti))) (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!))))
      (dk-have! (list '<= sm ti) (lambda () (subst (list '= sm yv)) (ass)))
      (dk-have! (list 'FORSOME 'osz_ (list 'IN 'osz_ gi))
        (lambda ()
          (ew sv)
          (in-sep! dk-ass! (lambda () (dk-conj-close! dk-ass!)))))
      (fact 'choice-axiom gi))))


;;; for i in NN: (C i) is a good cover of f(i) -- lands its typing, the cover and the bound
(define (omc-c-facts! cv cve ne iv)
  (let* ((gi (omc-good iv))
         (ci (list cv iv))
         (m  (dk-apply! ne iv))
         (ve (dk-apply! cve iv))
         (m2 (dk-rewrite-h! m (list 'CHOICE gi) ci))
         (cover (list 'SUBSET (list 'osf iv) (list 'BIG-UNION 'cvn_ 'NN (list ci 'cvn_))))
         (bound (list '<= (list 'ESUM (list 'VNB-LAMBDA 'cvk_ 'NN (list 'pm (list ci 'cvk_)))) (omc-ti iv))))
    (dk-project! (list 'IN ci '(FUN NN cls)) (lambda () (sep-me m2) (dk-split-all!)))
    (dk-project! cover (lambda () (sep-me m2) (dk-split-all!)))
    (dk-project! bound (lambda () (sep-me m2) (dk-split-all!)))
    (list cover bound)))

;;; the core of the subadditivity, on the goal mu <= B + eps
(define (omc-sub-core! cv cve ne mu bb)
  (let* ((bu '(BIG-UNION osn_ NN (osf osn_)))
         (br (dk-abstract! 'NN 'cls (lambda (m) (list (list cv (list 'NNFST m)) (list 'NNSND m)))
               (lambda (mv)
                 (fact 'nnfst-type mv) (fact 'nnsnd-type mv)
                 (fact 'fun-apply-type-c cv 'NN '(FUN NN cls) (list 'NNFST mv))
                 (fact 'fun-apply-type-c (list cv (list 'NNFST mv)) 'NN 'cls (list 'NNSND mv))
                 (ass))))
         (bfv (car br)) (bfe (cdr br))
         (ubf (list 'BIG-UNION 'cvn_ 'NN (list bfv 'cvn_)))
         (ofl (list 'VNB-LAMBDA 'cvk_ 'NN (list 'pm (list bfv 'cvk_))))
         (ar (dk-abstract! 'NN '(FUN NN RR-POS-STAR) (lambda (i) (list 'VNB-LAMBDA 'osj_ 'NN (list 'pm (list (list cv i) 'osj_))))
               (lambda (iv)
                 (fact 'fun-apply-type-c cv 'NN '(FUN NN cls) iv)
                 (dk-lam-type! (lambda ()
                                 (let ((jv (cadr (car (dk-peel!)))))
                                   (fact 'fun-apply-type-c (list cv iv) 'NN 'cls jv)
                                   (fact 'fun-apply-type-c 'pm 'cls 'RR-POS-STAR (list (list cv iv) jv))
                                   (ass)))))))
         (oav (car ar)) (oae (cdr ar))
         (otl (list 'VNB-LAMBDA 'osi_ 'NN (list 'ESUM (list oav 'osi_))))
         (el omc-el))
    ;; the union is covered by the flattened sequence
    (dk-have! (list 'SUBSET bu ubf)
      (lambda ()
        (mac 'subset-def)
        (let* ((zv (dk-di-var!))
               (l1 (dk-landed (lambda () (bu-me (list 'IN zv bu)))))
               (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) l1))
               (ev (cadr ein)))
          (fact 'fun-apply-type-c cv 'NN '(FUN NN cls) ev)
          (omc-c-facts! cv cve ne ev)
          (fact 'subset-mem-fwd (list 'osf ev) (list 'BIG-UNION 'cvn_ 'NN (list (list cv ev) 'cvn_)) zv)
          (let* ((l2 (dk-landed (lambda () (bu-me (list 'IN zv (list 'BIG-UNION 'cvn_ 'NN (list (list cv ev) 'cvn_)))))))
                 (jin (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) l2))
                 (jv (cadr jin))
                 (c (list 'NNPAIR ev jv)))
            (fact 'nnpair-type ev jv)
            (dk-apply! bfe c)
            (fact 'nnfst-nnpair ev jv)
            (fact 'nnsnd-nnpair ev jv)
            (for-each
              (lambda (l)
                (dk-focus! l)
                (if (equal? (dk-goal) (list 'IN c 'NN))
                    (ass)
                    (begin
                      (subst (list '= (list bfv c) (list (list cv (list 'NNFST c)) (list 'NNSND c))))
                      (subst (list '= (list 'NNFST c) ev))
                      (subst (list '= (list 'NNSND c) jv))
                      (ass))))
              (dk-opened (lambda () (bu-mi c))))))))
    (fact 'cover-sums-intro 'omega 'cls 'pm bu bfv)
    (dk-have! (list 'IN ofl '(FUN NN RR-POS-STAR))
      (lambda () (dk-lam-type! (lambda () (let ((kv (cadr (car (dk-peel!)))))
                                            (fact 'fun-apply-type-c bfv 'NN 'cls kv)
                                            (fact 'fun-apply-type-c 'pm 'cls 'RR-POS-STAR (list bfv kv))
                                            (ass))))))
    (omc-esum-type! ofl)
    (fact 'einf-lower (omc-cs bu) (list 'ESUM ofl))
    ;; the flattening
    (dk-have! (list 'IN otl '(FUN NN RR-POS-STAR))
      (lambda () (dk-lam-type! (lambda () (let ((kv (cadr (car (dk-peel!)))))
                                            (fact 'fun-apply-type-c oav 'NN '(FUN NN RR-POS-STAR) kv)
                                            (omc-then-ass! (lambda () (omc-esum-type! (list oav kv)))))))))
    (omc-esum-type! otl)
    (dk-have! (list 'FORALL 'm_ (list 'IMPLIES '(IN m_ NN) (list '= (list ofl 'm_) (list (list oav '(NNFST m_)) '(NNSND m_)))))
      (lambda ()
        (let* ((mv (dk-di-var!)) (p1 (list 'NNFST mv)) (p2 (list 'NNSND mv)))
          (fact 'nnfst-type mv) (fact 'nnsnd-type mv)
          (fact 'fun-apply-type-c bfv 'NN 'cls mv)
          (fact 'fun-apply-type-c cv 'NN '(FUN NN cls) p1)
          (fact 'fun-apply-type-c (list cv p1) 'NN 'cls p2)
          (fact 'fun-apply-type-c 'pm 'cls 'RR-POS-STAR (list (list cv p1) p2))
          (dk-apply! bfe mv)
          (dk-apply! oae p1)
          (subst (list '= (list oav p1) (list 'VNB-LAMBDA 'osj_ 'NN (list 'pm (list (list cv p1) 'osj_)))))
          (dk-lam-b!)
          (subst (list '= (list bfv mv) (list (list cv p1) p2)))
          (rfl))))
    (dk-have! (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ NN) (list '= (list otl 'i_) (list 'ESUM (list oav 'i_)))))
      (lambda ()
        (let ((iv (dk-di-var!)))
          (fact 'fun-apply-type-c oav 'NN '(FUN NN RR-POS-STAR) iv)
          (omc-esum-type! (list oav iv))
          (if (not (dk-lam-b!)) (if (not (dk-ass!)) (rfl))))))
    (fact 'esum-nn-flatten-le oav ofl otl)
    ;; termwise against t_i = x_i + e_i
    (dk-have! (list 'IN omc-tl '(FUN NN RR-POS-STAR))
      (lambda () (dk-lam-type! (lambda () (let ((kv (cadr (car (dk-peel!)))))
                                            (dk-lam-b!)
                                            (fact 'fun-apply-type-c 'osf 'NN '(POWER omega) kv)
                                            (omc-mstar-type! (list 'osf kv))
                                            (omc-w-facts! kv)
                                            (omc-then-ass! (lambda () (omc-ep! (omc-mstar (list 'osf kv)) (omc-ew kv)))))))))
    (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list otl 'k) (list omc-tl 'k))))
      (lambda ()
        (let ((kv (dk-di-var!)))
          (fact 'fun-apply-type-c cv 'NN '(FUN NN cls) kv)
          (omc-c-facts! cv cve ne kv)
          (dk-apply! oae kv)
          (dk-lam-b!)
          (subst (list '= (list oav kv) (list 'VNB-LAMBDA 'osj_ 'NN (list 'pm (list (list cv kv) 'osj_)))))
          (ass))))
    (fact 'esum-nn-le-termwise otl omc-tl)
    (omc-esum-type! omc-tl)
    (fact 'esum-nn-add-le omc-bl el)
    (fact 'dyadic-eps-sum-le 'eps)
    (omc-esum-type! el)
    (fact 'rr-pos-star-le-refl bb)
    (omc-and4! (list 'IN bb 'RR-POS-STAR) (list 'IN (list 'ESUM el) 'RR-POS-STAR) (list 'IN bb 'RR-POS-STAR) '(IN eps RR-POS-STAR))
    (omc-and2! (list '<= bb bb) (list '<= (list 'ESUM el) 'eps))
    (fact 'eplus-mono bb (list 'ESUM el) bb 'eps)
    (let ((s1 (omc-ep! bb (list 'ESUM el))) (s2 (omc-ep! bb 'eps)))
      (omc-trans! mu (list 'ESUM ofl) (list 'ESUM otl))
      (omc-trans! mu (list 'ESUM otl) (list 'ESUM omc-tl))
      (omc-trans! mu (list 'ESUM omc-tl) s1)
      (omc-trans! mu s1 s2)
      (ass))))

(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cls (list 'FORALL 'pm (list 'FORALL 'osf
   (list 'IMPLIES '(IS-PREMEASURE omega cls pm)
     (list 'IMPLIES '(IN osf (FUN NN (POWER omega)))
       (list '<= '(EINF (COVER-SUMS omega cls pm (BIG-UNION osn_ NN (osf osn_))))
                 (list 'ESUM omc-bl))))))))))
(dk-peel!)
(omc-pm-parts!)
(let* ((bu '(BIG-UNION osn_ NN (osf osn_)))
       (mu (omc-mstar bu))
