                       (fact 'fun-apply-type-c fs 'NN 'ca nv)
                       (dk-project! (list 'SUBSET (omc-en nv) (list fs nv)) (lambda () (sep-me m2) (dk-split-all!)))
                       (dk-project! (list 'IS-NULL-SET 'omega 'ca 'rho (list 'COMPLEMENT-IN (list fs nv) (omc-en nv)))
                                    (lambda () (sep-me m2) (dk-split-all!)))))))
      ;; the null witnesses
      (dk-have! (list 'FORALL 'osn (list 'IMPLIES '(IN osn NN) (list 'IN (list 'CHOICE (omc-gz fs 'osn)) (omc-gz fs 'osn))))
        (lambda ()
