            (let* ((d (list 'COMPLEMENT-IN (list fs nv) (omc-en nv)))
                   (iff (dk-cite! 'is-null-set 'omega 'ca 'rho d)))
              (ai iff)
              (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
              (let ((zv (dk-skolem! (caddr iff))))
                (dk-have! (list 'FORSOME 'osz_ (list 'IN 'osz_ g))
                  (lambda () (ew zv) (in-sep! dk-ass! (lambda () (dk-conj-close! dk-ass!)))))
                (fact 'choice-axiom g)
                (ass))))))
      (let* ((nz (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'CHOICE) (dk-contains? h 'osh_))) "the Z choices"))
             (zr (dk-abstract! 'NN 'ca (lambda (k) (list 'CHOICE (omc-gz fs k)))
                   (lambda (kv) (let ((m (dk-apply! nz kv))) (sep-me m) (dk-split-all!) (ass)))))
             (zs (car zr)) (ze (cdr zr))
             (zfacts (lambda (nv)
                       (let* ((g (omc-gz fs nv)) (m (dk-apply! nz nv)) (ve (dk-apply! ze nv))
                              (m2 (dk-rewrite-h! m (list 'CHOICE g) (list zs nv))))
                         (fact 'fun-apply-type-c zs 'NN 'ca nv)
                         (dk-project! (list 'SUBSET (list 'COMPLEMENT-IN (list fs nv) (omc-en nv)) (list zs nv))
                                      (lambda () (sep-me m2) (dk-split-all!)))
                         (dk-project! (list '= (list 'rho (list zs nv)) 0) (lambda () (sep-me m2) (dk-split-all!))))))
             (bf (list 'BIG-UNION 'n_ 'NN (list fs 'n_)))
             (bz (list 'BIG-UNION 'n_ 'NN (list zs 'n_)))
             (fme (list 'COMPLEMENT-IN bf 'es)))
        (fact 'sigma-algebra-union-closed 'omega 'ca fs)
        (fact 'sigma-algebra-union-closed 'omega 'ca zs)
        ;; E inside F
        (dk-have! (list 'SUBSET 'es bf)
          (lambda ()
            (mac 'subset-def)
            (omc-forall!
              (lambda (zv)
                (fact 'subset-mem-fwd 'es 'omega zv)
                (let* ((h (dk-rewrite-h! (list 'IN zv 'omega) 'omega (cadr ueq)))
                       (l1 (dk-landed (lambda () (bu-me h))))
                       (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) l1))
                       (kv (cadr ein)))
                  (ffacts kv)
                  (dk-have! (list 'IN zv (omc-en kv)) (lambda () (mac 'intersection-membership) (dk-conj-close! dk-ass!)))
                  (fact 'subset-mem-fwd (omc-en kv) (list fs kv) zv)
                  (for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (ass))))
                            (dk-opened (lambda () (bu-mi kv)))))))))
        ;; F \ E inside Z
        (omc-subset! fme bz
          (lambda (w)
            (let* ((pos (dk-project! (list 'IN w bf)
                          (lambda () (mac-h 'complement-in-membership (list 'IN w fme)) (dk-split-all!))))
                   (l1 (dk-landed (lambda () (bu-me pos))))
                   (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) l1))
                   (kv (cadr ein)))
              (ffacts kv)
              (zfacts kv)
              (fact 'intersection-membership 'es (list sx kv) w)
              (fact 'complement-in-membership (list fs kv) (omc-en kv) w)
              (fact 'subset-mem-fwd (list 'COMPLEMENT-IN (list fs kv) (omc-en kv)) (list zs kv) w)
              (dk-have! (list 'IMPLIES (list 'IN w (list zs kv)) (list 'IN w bz))
                (lambda () (di) (for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (ass))))
                                          (dk-opened (lambda () (bu-mi kv))))))
              (fact 'complement-in-membership bf 'es w))))
        ;; rho(Z) = 0
        (let ((zl (list 'VNB-LAMBDA 'n_ 'NN (list 'rho (list zs 'n_)))))
          (fact 'measure-countably-subadditive 'omega 'ca 'rho zs)
          (dk-have! (list 'IN zl '(FUN NN RR-POS-STAR))
            (lambda () (dk-lam-type! (lambda () (let ((kv (cadr (car (dk-peel!)))))
                                                  (fact 'fun-apply-type-c zs 'NN 'ca kv)
                                                  (fact 'fun-apply-type-c 'rho 'ca 'RR-POS-STAR (list zs kv))
                                                  (ass))))))
          (dk-have! (list 'FORALL 'ozn (list 'IMPLIES '(IN ozn NN) (list '= (list zl 'ozn) 0)))
            (lambda () (let ((kv (dk-di-var!))) (zfacts kv) (dk-lam-b!) (ass))))
          (fact 'esum-nn-zero zl)
          (fact 'fun-apply-type-c 'rho 'ca 'RR-POS-STAR bz)
          (fact 'rr-pos-star-nonneg (list 'rho bz))
          (fact 'zero-in-rr-pos-star)
          (dk-have! (list '<= (list 'rho bz) 0) (lambda () (subst (list '= 0 (list 'ESUM zl))) (ass)))
          (omc-antisymm! (list 'rho bz) 0))
        (dk-have! (list 'IS-NULL-SET 'omega 'ca 'rho fme)
          (lambda () (mac 'IS-NULL-SET) (ew bz) (dk-conj-close! dk-ass!)))
        (ew bf)
        (dk-conj-close! dk-ass!)))))
(qed 'method-i-outer-sigma-finite-approx)
(topic! 'method-i-outer-sigma-finite-approx 'set-quotient)

;;; PROPOSITION 4.12: rho sigma-finite -- every mu*-measurable set is A u N with A
;;; in cA and N rho-null, i.e. lies in the completion of rho (Def. 3.3).
(sp (make-wff (forall-guarded '(omega ca rho es)
   (list '(IS-MEASURE omega ca rho) '(IS-SIGMA-FINITE omega ca rho)
         (list 'IN 'es (list 'CARATHEODORY-SETS 'omega omc-mu2)))
   '(FORSOME ofa_ (AND (IN ofa_ ca) (FORSOME ofb_ (AND (IS-NULL-SET omega ca rho ofb_) (= es (UNION ofa_ ofb_)))))))))
(dk-peel!)
(omc-sigma!)
(fact 'measure-is-premeasure 'omega 'ca 'rho)
(fact 'method-i-outer-is-outer-measure 'omega 'ca 'rho)
(fact 'sigma-algebra-ambient-set 'omega 'ca)
(fact 'caratheodory-measurable-sigma-algebra 'omega omc-mu2)
(let* ((ce '(COMPLEMENT-IN omega es)))
  (omc-from-cc3! 'es)
  (fact 'sigma-algebra-complement-closed 'omega omc-cc3 'es)
  (omc-from-cc3! ce)
  (dk-have! '(SUBSET es omega)
    (lambda () (mac 'subset-def) (omc-forall! (lambda (zv) (fact 'power-mem-in 'omega 'es zv) (ass)))))
  (let* ((ex (dk-fact! 'method-i-outer-sigma-finite-approx 'omega 'ca 'rho ce))
         (gv (dk-skolem! ex))
         (gce (list 'COMPLEMENT-IN gv ce))
         (iff (dk-cite! 'is-null-set 'omega 'ca 'rho gce)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (let* ((zv (dk-skolem! (caddr iff)))
           (av (list 'COMPLEMENT-IN 'omega gv))
           (nv (list 'COMPLEMENT-IN 'es av))
           (pre (lambda (w)
                  (fact 'subset-mem-fwd 'es 'omega w)
                  (fact 'subset-mem-fwd ce gv w)
                  (fact 'subset-mem-fwd gce zv w)
                  (fact 'complement-in-membership 'omega 'es w)
                  (fact 'complement-in-membership 'omega gv w)
                  (fact 'complement-in-membership gv ce w)
                  (fact 'complement-in-membership 'es av w))))
      (fact 'sigma-algebra-complement-closed 'omega 'ca gv)
      (omc-subset! nv zv pre)
      (dk-have! (list 'IS-NULL-SET 'omega 'ca 'rho nv)
        (lambda () (mac 'IS-NULL-SET) (ew zv) (dk-conj-close! dk-ass!)))
      (omc-ext! 'es (list 'UNION av nv) pre)
      (ew av)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (begin (ew nv) (dk-conj-close! dk-ass!))))))))
(qed 'method-i-outer-sigma-finite-completion)
(topic! 'method-i-outer-sigma-finite-completion 'set-quotient)
(gloss! 'method-i-outer-sigma-finite-completion
  "Thayer, Construction of Measures, Prop. 4.12 (p. 34): for a sigma-finite countably
   additive measure rho on (X, A), every set measurable for the method I outer measure
   of rho is A u N with A in A and N rho-null -- with Cor. 4.11, the Caratheodory
   measure of mu* is exactly the completion of rho.  The notes' proof shows only that
   E lies in a member F of A with F \\ E null; the A u N form is that statement applied
   to the complement X \\ E.")

;;; =====================================================================
;;; (10) Lebesgue outer measure on the line as an instance: the closed
;;;      intervals with their lengths form a pre-measure; its method I outer
;;;      measure is an outer measure (Prop. 4.7) and its Caratheodory measure a
;;;      complete measure (Prop. 4.4, MEASURE-1).  "Intervals are measurable" and
;;;      "the measure of an interval is its length" are MEASURE-3.
;;; =====================================================================

(define omc-ci-body
  '(SEP oci_ (POWER RR)
     (OR (= oci_ EMPTY-SET)
         (FORSOME oca_ (AND (IN oca_ RR)
           (FORSOME ocb_ (AND (IN ocb_ RR) (AND (<= oca_ ocb_) (= oci_ (CCINT oca_ ocb_))))))))))
(define omc-lp '(VNB-LAMBDA ols_ CLOSED-INTERVALS (INTERVAL-LENGTH ols_)))
(define (omc-dset s)
  (list 'SEP 'odv_ 'RR-POS-STAR
        (list 'OR '(= odv_ 0)
              (list 'FORSOME 'odx_ (list 'AND (list 'IN 'odx_ s)
                (list 'FORSOME 'ody_ (list 'AND (list 'IN 'ody_ s) '(AND (<= odx_ ody_) (= odv_ (- ody_ odx_))))))))))
(define (omc-ci-unfold!)
  (fact 'closed-intervals-def)
  (subst (list '= 'CLOSED-INTERVALS omc-ci-body)))
;;; (SUBSET D(s) RR-POS-STAR)
(define (omc-dset-sub! s)
  (dk-have! (list 'SUBSET (omc-dset s) 'RR-POS-STAR)
    (lambda () (mac 'subset-def) (omc-forall! (lambda (wv) (sep-me (list 'IN wv (omc-dset s))) (dk-split-all!) (ass))))))
(define (omc-empty-in-ci!)
  (dk-have! '(IN EMPTY-SET CLOSED-INTERVALS)
    (lambda ()
      (omc-ci-unfold!)
      (fact 'power-empty-in 'RR)
      (in-sep! dk-ass! (lambda () (oi-l) (rfl))))))

(sp (make-wff (list 'IS-PREMEASURE 'RR 'CLOSED-INTERVALS omc-lp)))
(fact 'rr-is-set)
(omc-empty-in-ci!)
(mac 'IS-PREMEASURE)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-ass!) #t)
            ((dk-head-is? g 'SUBSET)
             (omc-ci-unfold!)
             (mac 'subset-def)
             (omc-forall! (lambda (zv) (sep-me (list 'IN zv omc-ci-body)) (dk-split-all!) (ass))))
            ((dk-head-is? g 'IN)
             (dk-lam-type!
               (lambda ()
                 (let ((sv (cadr (car (dk-peel!)))))
                   (mac 'INTERVAL-LENGTH)
                   (omc-dset-sub! sv)
                   (fact 'esup-in (omc-dset sv))
                   (ass)))
               (lambda ()
                 (omc-ci-unfold!)
                 (sep-set)
                 (fact 'power-set 'RR)
                 (ass))))
            (#t
             (dk-lam-b!)
             (mac 'INTERVAL-LENGTH)
             (let* ((d (omc-dset 'EMPTY-SET)) (e (list 'ESUP d)))
               (omc-dset-sub! 'EMPTY-SET)
               (fact 'zero-in-rr-pos-star)
               (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x d) '(<= x 0)))
                 (lambda ()
                   (let ((xv (dk-di-var!)))
                     (sep-me (list 'IN xv d))
                     (dk-split-all!)
                     (let ((orf (dk-pick (lambda (h) (and (dk-head-is? h 'OR) (dk-contains? h xv))) "the cases")))
                       (use-cases (list (cadr orf) (caddr orf))
                         (lambda () (subst (list '= xv 0)) (fact 'rr-pos-star-le-refl 0) (ass))
                         (lambda ()
                           (let ((x0 (dk-skolem! (caddr orf) 'top)))
                             (dk-split-all!)
                             (fact 'empty-set-has-no-members x0)
                             (ai (list 'NOT (list 'IN x0 'EMPTY-SET))))))))))
               (omc-and2! '(IN 0 RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x d) '(<= x 0))))
               (fact 'esup-least d 0)
               (fact 'esup-in d)
               (fact 'rr-pos-star-nonneg e)
               (omc-antisymm! e 0)
               (ass)))))))
(qed 'lebesgue-premeasure)
(topic! 'lebesgue-premeasure 'set-quotient)

(define omc-lo (list 'METHOD-I-OUTER 'RR 'CLOSED-INTERVALS omc-lp))
(sp (make-wff (list 'IS-OUTER-MEASURE 'RR omc-lo)))
(fact 'lebesgue-premeasure)
(fact 'method-i-outer-is-outer-measure 'RR 'CLOSED-INTERVALS omc-lp)
(ass)
(qed 'lebesgue-outer-measure)
(topic! 'lebesgue-outer-measure 'set-quotient)
(gloss! 'lebesgue-outer-measure
  "Lebesgue outer measure on the real line: the method I outer measure (Thayer, Def.
   4.8) of the length on the empty set and the closed intervals is an outer measure
   (Prop. 4.7 at that pre-measure).")

(sp (make-wff (list 'IS-COMPLETE-MEASURE 'RR (list 'CARATHEODORY-SETS 'RR omc-lo)
                    (list 'RES omc-lo (list 'CARATHEODORY-SETS 'RR omc-lo)))))
(fact 'lebesgue-outer-measure)
(fact 'caratheodory-measure-complete 'RR omc-lo)
(ass)
(qed 'lebesgue-measure-complete)
(topic! 'lebesgue-measure-complete 'set-quotient)
(gloss! 'lebesgue-measure-complete
  "The Caratheodory measure of Lebesgue outer measure -- Lebesgue measure on its
   sigma-algebra of measurable sets -- is a complete countably additive measure
   (Prop. 4.4 and the completeness of every Caratheodory measure).")

;;; the length of [a, b] is b - a
(sp (make-wff (forall-guarded '(a_ b_) '((IN a_ RR) (IN b_ RR) (<= a_ b_))
   (list '= (list omc-lp '(CCINT a_ b_)) '(- b_ a_)))))
(dk-peel!)
(let* ((ab '(CCINT a_ b_)) (d (omc-dset ab)) (e (list 'ESUP d)) (len '(- b_ a_)))
  (fact 'ccint-subset-rr 'a_ 'b_)
  (fact 'rr-is-set)
  (fact 'subclass-of-set-is-set ab 'RR)
  (dk-have! (list 'IN ab '(POWER RR))
    (lambda ()
      (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ ab) '(IN z_ RR)))
        (lambda () (omc-forall! (lambda (zv) (fact 'subset-mem-fwd ab 'RR zv) (ass)))))
      (fact 'power-mem-intro 'RR ab) (ass)))
  (dk-have! (list 'IN ab 'CLOSED-INTERVALS)
    (lambda ()
      (omc-ci-unfold!)
      (in-sep! dk-ass!
        (lambda () (oi-r) (ew 'a_)
          (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew 'b_) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))))))
  (dk-lam-b!)
  (mac 'INTERVAL-LENGTH)
  (omc-dset-sub! ab)
  (fact 'esup-in d)
  (dk-have! (list 'IN len 'RR) (lambda () (type-term)))
  (dk-have! (list '<= 0 len) (lambda () (dk-ineq! '(IN a_ RR) '(IN b_ RR) '(<= a_ b_))))
  (omc-rps! len)
  ;; ESUP D <= b - a
  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x d) (list '<= 'x len)))
    (lambda ()
      (let ((xv (dk-di-var!)))
        (sep-me (list 'IN xv d))
        (dk-split-all!)
        (let ((orf (dk-pick (lambda (h) (and (dk-head-is? h 'OR) (dk-contains? h xv))) "the cases")))
          (use-cases (list (cadr orf) (caddr orf))
            (lambda () (subst (list '= xv 0)) (ass))
            (lambda ()
              (let* ((x0 (dk-skolem! (caddr orf) 'top))
                     (_ (dk-split-all!))
                     (ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h x0))) "y"))
                     (y0 (dk-skolem! ex 'top)))
                (dk-split-all!)
                (for-each (lambda (pt)
                            (let ((iff (dk-cite! 'ccint-membership 'a_ 'b_ pt)))
                              (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
                          (list x0 y0))
                (dk-have! (list 'IN xv 'RR) (lambda () (subst (list '= xv (list '- y0 x0))) (type-term)))
                (dk-ineq! (list 'IN xv 'RR) '(IN a_ RR) '(IN b_ RR) (list 'IN x0 'RR) (list 'IN y0 'RR)
                          (list '= xv (list '- y0 x0)) (list '<= 'a_ x0) (list '<= y0 'b_)))))))))
  (omc-and2! (list 'IN len 'RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x d) (list '<= 'x len))))
  (fact 'esup-least d len)
  ;; b - a is in D
  (dk-have! '(IN a_ (CCINT a_ b_))
    (lambda () (mac 'ccint-membership) (dk-conj-close! (lambda () (if (not (dk-ass!)) (dk-ineq! '(IN a_ RR)))))))
  (dk-have! '(IN b_ (CCINT a_ b_))
    (lambda () (mac 'ccint-membership) (dk-conj-close! (lambda () (if (not (dk-ass!)) (dk-ineq! '(IN b_ RR)))))))
  (dk-have! (list 'IN len d)
    (lambda ()
      (in-sep! dk-ass!
        (lambda () (oi-r) (ew 'a_)
          (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew 'b_) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))))))
  (fact 'esup-upper d len)
  (omc-antisymm! e len)
  (ass))
(qed 'interval-length-ccint)
(topic! 'interval-length-ccint 'inequalities)
