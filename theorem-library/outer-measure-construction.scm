(define (omc-find-if x)
  (cond ((not (pair? x)) #f)
        ((eq? (car x) 'IF) x)
        (#t (let loop ((xs x))
              (cond ((null? xs) #f)
                    ((not (pair? xs)) #f)
                    ((omc-find-if (car xs)) => (lambda (r) r))
                    (#t (loop (cdr xs))))))))

;;; one member of C covering E bounds the method I outer measure
(sp (make-wff (forall-guarded '(omega cls pm es aa)
   '((IS-PREMEASURE omega cls pm) (IN aa cls) (SUBSET es aa))
   '(<= (EINF (COVER-SUMS omega cls pm es)) (pm aa)))))
(dk-peel!)
(omc-pm-parts!)
(let* ((sq '(VNB-LAMBDA osp_ NN (IF (= osp_ 0) aa EMPTY-SET)))
       (h  (list 'VNB-LAMBDA 'cvk_ 'NN (list 'pm (list sq 'cvk_))))
       (bu (list 'BIG-UNION 'cvn_ 'NN (list sq 'cvn_)))
