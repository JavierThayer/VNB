(topic! 'cover-sum-dominates 'inequalities)

;;; REMARK 4.9.  For a measure rho, the method I outer measure is the infimum of
;;; rho over the single members of cA covering E.
(define omc-single
  '(SEP osv_ RR-POS-STAR (FORSOME osa_ (AND (IN osa_ ca) (AND (SUBSET es osa_) (= osv_ (rho osa_)))))))
(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'ca (list 'FORALL 'rho (list 'FORALL 'es
   (list 'IMPLIES '(IS-MEASURE omega ca rho)
     (list 'IMPLIES '(IN es (POWER omega))
       (list '= '((METHOD-I-OUTER omega ca rho) es) (list 'EINF omc-single))))))))))
(dk-peel!)
(fact 'measure-is-premeasure 'omega 'ca 'rho)
(let* ((cs '(COVER-SUMS omega ca rho es))
       (m1 (list 'EINF cs))
       (m2 (list 'EINF omc-single)))
  (fact 'method-i-outer-value 'omega 'ca 'rho 'es)
  (subst (list '= '((METHOD-I-OUTER omega ca rho) es) m1))
  (fact 'cover-sums-subset 'omega 'ca 'rho 'es)
  (fact 'einf-in cs)
  (dk-have! (list 'SUBSET omc-single 'RR-POS-STAR)
    (lambda () (mac 'subset-def) (omc-forall! (lambda (wv) (sep-me (list 'IN wv omc-single)) (dk-split-all!) (ass)))))
  (fact 'einf-in omc-single)
  ;; m1 <= m2: one member of cA is a cover
  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x omc-single) (list '<= m1 'x)))
    (lambda ()
      (let* ((xv (dk-di-var!)))
        (sep-me (list 'IN xv omc-single))
        (dk-split-all!)
        (let* ((ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h xv))) "the member"))
               (av (dk-skolem! ex)))
          (fact 'method-i-outer-le-single 'omega 'ca 'rho 'es av)
          (subst (list '= xv (list 'rho av)))
          (ass)))))
  (fact 'einf-greatest omc-single m1)
  ;; m2 <= m1: every covering sum dominates a member
  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x cs) (list '<= m2 'x)))
    (lambda ()
      (let* ((xv (dk-di-var!))
             (ex (dk-fact! 'cover-sum-dominates 'omega 'ca 'rho 'es xv))
             (av (dk-skolem! ex)))
        (fact 'subset-mem-fwd cs 'RR-POS-STAR xv)
        (fact 'measure-is-premeasure 'omega 'ca 'rho)
        (omc-pm-parts-of! 'omega 'ca 'rho)
        (fact 'fun-apply-type-c 'rho 'ca 'RR-POS-STAR av)
        (dk-have! (list 'IN (list 'rho av) omc-single)
          (lambda () (in-sep! dk-ass! (lambda () (ew av) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))
        (fact 'einf-lower omc-single (list 'rho av))
        (omc-trans! m2 (list 'rho av) xv)
        (ass))))
  (fact 'einf-greatest cs m2)
  (omc-antisymm! m1 m2)
  (ass))
(qed 'method-i-outer-of-measure)
(topic! 'method-i-outer-of-measure 'inequalities)
(gloss! 'method-i-outer-of-measure
  "Thayer, Construction of Measures, Remark 4.9 (p. 33), Eq. (81): when rho is a
   countably additive measure on (X, A), the method I outer measure of rho at E is
   the infimum of rho(A) over the single members A of the sigma-algebra containing E.")

;;; set algebra by elementwise unfolding and `prop' (the cth-ext! mechanics of caratheodory.scm)
(define omc-mac-heads
  '((intersection-membership . INTERSECTION) (complement-in-membership . COMPLEMENT-IN)
    (union-membership . UNION)))
(define (omc-has-in-head? x h)
  (and (pair? x)
       (or (and (eq? (car x) 'IN) (pair? (cdr x)) (pair? (cddr x))
                (pair? (caddr x)) (eq? (car (caddr x)) h))
           (let loop ((xs x))
             (and (pair? xs)
                  (or (omc-has-in-head? (car xs) h) (loop (cdr xs))))))))
(define (omc-unfold-sets!)
  (let loop ((fuel 12))
    (let ((m (find-first (lambda (p) (omc-has-in-head? (dk-goal) (cdr p))) omc-mac-heads)))
      (if (and m (> fuel 0))
          (begin (mac (car m)) (loop (- fuel 1)))))))
;;; (SUBSET lhs rhs) by unfolding; PRE (a procedure of the element) lands what prop needs
(define (omc-subset! lhs rhs pre)
  (dk-have! (list 'SUBSET lhs rhs)
    (lambda ()
      (mac 'subset-def)
      (let ((wv (dk-di-var!)))
        (omc-unfold-sets!)
        (let ((h (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (cadr f) wv) (equal? (caddr f) lhs))) "the element")))
          (pre wv)
          (dk-have! (list 'IMPLIES h (dk-goal))
            (lambda () (omc-unfold-sets!) (prop)))
          (detach! (list 'IMPLIES h (dk-goal)))
          (ass))))))
(define (omc-ext! lhs rhs pre)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((w (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (omc-unfold-sets!)
        (pre w)
        (prop))))
  (fact 'class-extensionality lhs rhs))

;;; (IN x (POWER omega)) from (IN x ca), ca a sigma-algebra over omega
(define (omc-ca-pow! ca x)
  (dk-project! (list 'SUBSET ca '(POWER omega)) 'IS-SIGMA-ALGEBRA (list 'IS-SIGMA-ALGEBRA 'omega ca))
  (fact 'subset-mem-fwd ca '(POWER omega) x))
(define (omc-sigma! )
  (let ((iff (dk-cite! 'is-measure 'omega 'ca 'rho)))
    (dk-project! '(IS-SIGMA-ALGEBRA omega ca) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
    (dk-project! '(IN rho (FUN ca RR-POS-STAR)) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))))

;;; PROPOSITION 4.10 (a): mu* extends rho.
(sp (make-wff (forall-guarded '(omega ca rho aa) '((IS-MEASURE omega ca rho) (IN aa ca))
   '(= ((METHOD-I-OUTER omega ca rho) aa) (rho aa)))))
(dk-peel!)
(omc-sigma!)
(fact 'measure-is-premeasure 'omega 'ca 'rho)
(omc-ca-pow! 'ca 'aa)
(fact 'method-i-outer-value 'omega 'ca 'rho 'aa)
(subst (list '= '((METHOD-I-OUTER omega ca rho) aa) '(EINF (COVER-SUMS omega ca rho aa))))
(fact 'subset-refl 'aa)
(fact 'method-i-outer-le-single 'omega 'ca 'rho 'aa 'aa)
(fact 'fun-apply-type-c 'rho 'ca 'RR-POS-STAR 'aa)
(let* ((cs '(COVER-SUMS omega ca rho aa)) (m1 (list 'EINF cs)))
  (fact 'cover-sums-subset 'omega 'ca 'rho 'aa)
  (fact 'einf-in cs)
  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x cs) '(<= (rho aa) x)))
    (lambda ()
      (let* ((xv (dk-di-var!))
             (ex (dk-fact! 'cover-sum-dominates 'omega 'ca 'rho 'aa xv))
