(define omc-cc '(CARATHEODORY-SETS omega mu))
;;; (IN x (POWER omega)) and the measurability, from (IN x C)
(define (omc-in-cc! x)
  (let* ((iff (dk-cite! 'caratheodory-sets-membership 'omega 'mu x)))
    (dk-project! (list 'IN x '(POWER omega)) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))))
;;; ((RES mu C) x) = (mu x)
(define (omc-res! x)
  (omc-and3! '(IN mu (FUN (POWER omega))) (list 'SUBSET omc-cc '(POWER omega)) (list 'IN x omc-cc))
  (dk-cite! 'res-apply '(POWER omega) omc-cc 'mu x))

;;; the measure of the Caratheodory construction is complete -- for ANY outer measure
(sp (make-wff (forall-guarded '(omega mu) '((IS-OUTER-MEASURE omega mu))
   '(IS-COMPLETE-MEASURE omega (CARATHEODORY-SETS omega mu) (RES mu (CARATHEODORY-SETS omega mu))))))
(dk-peel!)
(let* ((parts (omc-om-parts! 'mu))
       (mono (list-ref parts 3)))
  (fact 'caratheodory-measurable-sigma-algebra 'omega 'mu)
  (fact 'caratheodory-measure 'omega 'mu)
  (dk-project! (list 'SUBSET omc-cc '(POWER omega)) 'IS-SIGMA-ALGEBRA (list 'IS-SIGMA-ALGEBRA 'omega omc-cc))
  (dk-project! '(IN mu (FUN (POWER omega))) 'fun-codomain-iff '(IN mu (FUN (POWER omega) RR-POS-STAR)))
  (mac 'IS-COMPLETE-MEASURE)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((nv (dk-di-var! (lambda (g) (cadr (caddr g)))))
                 (nl (dk-landed-1 (lambda () (di))))
                 (iff (dk-cite! 'is-null-set 'omega omc-cc (list 'RES 'mu omc-cc) nv)))
            (ai iff)
            (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
            (let* ((av (dk-skolem! (caddr iff)))
                   (r (omc-res! av)))
              (omc-in-cc! av)
              (dk-have! (list '= (list 'mu av) 0) (lambda () (subst (list '= (list 'mu av) (cadr r))) (ass)))
              (fact 'power-mem-sethood 'omega av)
              (fact 'subclass-of-set-is-set nv av)
              (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ nv) '(IN z_ omega)))
                (lambda () (omc-forall! (lambda (zv) (fact 'subset-mem-fwd nv av zv) (fact 'power-mem-in 'omega av zv) (ass)))))
              (fact 'power-mem-intro 'omega nv)
              (dk-have! (list 'SUBSET nv 'omega)
                (lambda () (mac 'subset-def) (omc-forall! (lambda (zv) (fact 'subset-mem-fwd nv av zv) (fact 'power-mem-in 'omega av zv) (ass)))))
              (dk-apply! mono nv av)
              (fact 'fun-apply-type-c 'mu '(POWER omega) 'RR-POS-STAR nv)
              (fact 'rr-pos-star-nonneg (list 'mu nv))
              (fact 'zero-in-rr-pos-star)
              (dk-have! (list '<= (list 'mu nv) 0) (lambda () (subst (list '= 0 (list 'mu av))) (ass)))
              (omc-antisymm! (list 'mu nv) 0)
              (fact 'caratheodory-null-measurable 'omega 'mu nv)
              (mac 'caratheodory-sets-membership)
              (dk-conj-close! dk-ass!)))))))
(qed 'caratheodory-measure-complete)
(topic! 'caratheodory-measure-complete 'set-quotient)

;;; COROLLARY 4.11, first half: for a measure rho the Caratheodory measure of mu* is complete
(sp (make-wff (forall-guarded '(omega ca rho) '((IS-MEASURE omega ca rho))
   '(IS-COMPLETE-MEASURE omega
      (CARATHEODORY-SETS omega (METHOD-I-OUTER omega ca rho))
      (RES (METHOD-I-OUTER omega ca rho) (CARATHEODORY-SETS omega (METHOD-I-OUTER omega ca rho)))))))
(dk-peel!)
