;;; a sigma-algebra is closed under countable intersections, written as in
;;; measure-continuity-from-above (the mechanics of measure-laws.scm, step (1))
(define (omc-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (eq? (car f) 'IN) (not (equal? (cadr f) w)))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons ein app)))
(sp (make-wff (forall-guarded '(omega cA f_) '((IS-SIGMA-ALGEBRA omega cA) (IN f_ (FUN NN cA)))
   '(IN (COMPLEMENT-IN omega (BIG-UNION n_ NN (COMPLEMENT-IN omega (f_ n_)))) cA))))
(dk-peel!)
(let* ((fv 'f_)
       (buc '(BIG-UNION n_ NN (COMPLEMENT-IN omega (f_ n_))))
       (cf '(VNB-LAMBDA ocn_ NN (COMPLEMENT-IN omega (f_ ocn_))))
       (bul (list 'BIG-UNION 'n_ 'NN (list cf 'n_))))
  (dk-have! (list 'IN cf '(FUN NN cA))
    (lambda ()
      (dk-lam-type! (lambda () (let ((kv (cadr (car (dk-peel!)))))
                                 (fact 'fun-apply-type-c fv 'NN 'cA kv)
                                 (omc-then-ass! (lambda () (fact 'sigma-algebra-complement-closed 'omega 'cA (list fv kv)))))))))
  (fact 'sigma-algebra-union-closed 'omega 'cA cf)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ bul) (list 'IN 'w_ buc)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (for-each
          (lambda (l)
            (dk-focus! l)
            (if (equal? (dk-goal) (list 'IN wv buc))
                (let* ((r (omc-bu-open! wv bul)) (e (cadr (car r))))
                  (fact 'fun-apply-type-c fv 'NN 'cA e)
                  (fact 'sigma-algebra-complement-closed 'omega 'cA (list fv e))
                  (fact 'membership-implies-sethood (list 'COMPLEMENT-IN 'omega (list fv e)) 'cA)
                  (dk-lam-b-h! (cdr r))
                  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass)))) (dk-opened (lambda () (bu-mi e)))))
                (let* ((r (omc-bu-open! wv buc)) (e (cadr (car r))))
                  (fact 'fun-apply-type-c fv 'NN 'cA e)
                  (fact 'sigma-algebra-complement-closed 'omega 'cA (list fv e))
                  (fact 'membership-implies-sethood (list 'COMPLEMENT-IN 'omega (list fv e)) 'cA)
                  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n)
                              (if (equal? (dk-goal) (list 'IN e 'NN)) (ass)
                                  (omc-then-ass! (lambda () (dk-lam-b!)))))))
                            (dk-opened (lambda () (bu-mi e)))))))
          (dk-opened (lambda () (di)))))))
  (fact 'class-extensionality bul buc)
  (dk-have! (list 'IN buc 'cA) (lambda () (omc-then-ass! (lambda () (subst (list '= buc bul))))))
  (fact 'sigma-algebra-complement-closed 'omega 'cA buc)
  (dk-ass!))
(qed 'sigma-algebra-countable-inter)
(topic! 'sigma-algebra-countable-inter 'set-quotient)

;;; ---------------------------------------------------------------------
;;; Outer regularity: a set E of finite outer measure lies in a member F of cA
;;; with rho(F) = mu*(E).  (The step "by the argument used in the preceding
;;; paragraph using the characterization (81), there is an F ... with
;;; mu*(F) = mu*(E)" of the notes' proof of Prop. 4.10.)  The notes take a
;;; sequence A_n "without loss of generality non-increasing" and pass to the
;;; limit with Prop. 1.18; here the intersection F of the A_n is bounded by
;;; monotonicity alone, rho(F) <= rho(A_n) <= mu*(E) + 1/(n+1), so neither the
;;; reduction to a non-increasing sequence nor continuity from above is needed.
;;; ---------------------------------------------------------------------
(define omc-x '(EINF (COVER-SUMS omega ca rho es)))
(define (omc-rn n) (list 'recip (list '+ n 1)))
(define (omc-tn n) (list 'eplus omc-x (omc-rn n)))
(define (omc-gn n)
  (list 'SEP 'osb_ 'ca (list 'AND '(SUBSET es osb_) (list '<= '(rho osb_) (omc-tn n)))))
;;; r_n: typed, positive, in [0, +inf]
(define (omc-rn-facts! n)
  (let ((r (omc-rn n)))
    (if (not (dk-asm? (list 'IN r 'RR-POS-STAR)))
        (begin
          (fact 'nn-recip-succ-pos n)
          (fact 'rr-pos-rr-in-rr r)
          (fact 'rr-lt-of-pos-rr r)
          (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
          (omc-rps! r)))))

(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'ca (list 'FORALL 'rho (list 'FORALL 'es
   (list 'IMPLIES '(IS-MEASURE omega ca rho)
     (list 'IMPLIES '(IN es (POWER omega))
       (list 'IMPLIES '(IN ((METHOD-I-OUTER omega ca rho) es) RR)
         '(FORSOME ofz_ (AND (IN ofz_ ca) (AND (SUBSET es ofz_) (= (rho ofz_) ((METHOD-I-OUTER omega ca rho) es))))))))))))))
(dk-peel!)
(omc-sigma!)
(fact 'measure-is-premeasure 'omega 'ca 'rho)
(let* ((mue '((METHOD-I-OUTER omega ca rho) es))
       (cs '(COVER-SUMS omega ca rho es))
       (ss omc-single)
       (v1 (dk-cite! 'method-i-outer-value 'omega 'ca 'rho 'es))
       (v2 (dk-cite! 'method-i-outer-of-measure 'omega 'ca 'rho 'es)))
  (subst (list '= mue omc-x))
  (dk-rewrite-h! (list 'IN mue 'RR) mue omc-x)
  (dk-have! (list '= omc-x (list 'EINF ss)) (lambda () (subst (list '= omc-x mue)) (ass)))
  (fact 'cover-sums-subset 'omega 'ca 'rho 'es)
  (fact 'einf-in cs)
  (fact 'rr-pos-star-nonneg omc-x)
  (dk-have! (list 'SUBSET ss 'RR-POS-STAR)
    (lambda () (mac 'subset-def) (omc-forall! (lambda (wv) (sep-me (list 'IN wv ss)) (dk-split-all!) (ass)))))
  ;; the good sets are inhabited
  (dk-have! (list 'FORALL 'osn (list 'IMPLIES '(IN osn NN) (list 'IN (list 'CHOICE (omc-gn 'osn)) (omc-gn 'osn))))
    (lambda ()
      (let* ((nv (dk-di-var!)) (r (omc-rn nv)) (t (omc-tn nv)) (g (omc-gn nv)))
        (omc-rn-facts! nv)
        (omc-ep! omc-x r)
        (let ((e1 (dk-cite! 'eplus-real-defined omc-x r)))
          (dk-have! (list '< omc-x t)
            (lambda () (subst (list '= t (caddr e1)))
                       (dk-ineq! (list 'IN omc-x 'RR) (list 'IN r 'RR) (list '< 0 r))))
          (dk-have! (list '< (list 'EINF ss) t) (lambda () (subst (list '= (list 'EINF ss) omc-x)) (ass))))
        (let* ((ex (dk-fact! 'einf-lt-witness ss t))
               (yv (dk-skolem! ex)))
          (dk-project! (list '<= yv t) (lambda () (let ((iff (dk-cite! '< yv t))) (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!))))
          (sep-me (list 'IN yv ss))
          (dk-split-all!)
          (let* ((ex2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h yv))) "the member"))
                 (av (dk-skolem! ex2)))
            (dk-have! (list '<= (list 'rho av) t) (lambda () (subst (list '= (list 'rho av) yv)) (ass)))
            (dk-have! (list 'FORSOME 'osz_ (list 'IN 'osz_ g))
              (lambda () (ew av) (in-sep! dk-ass! (lambda () (dk-conj-close! dk-ass!)))))
            (fact 'choice-axiom g)
            (ass))))))
  (let* ((ne (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'CHOICE))) "the choices"))
         (gr (dk-abstract! 'NN 'ca (lambda (k) (list 'CHOICE (omc-gn k)))
               (lambda (kv) (let ((m (dk-apply! ne kv))) (sep-me m) (dk-split-all!) (ass)))))
         (gv (car gr)) (ge (cdr gr))
         (bu (list 'BIG-UNION 'ofn_ 'NN (list 'COMPLEMENT-IN 'omega (list gv 'ofn_))))
         (fz (list 'COMPLEMENT-IN 'omega bu))
         (rf (list 'rho fz))
         ;; G(n) is good
         (gfacts (lambda (nv)
                   (let* ((g (omc-gn nv)) (m (dk-apply! ne nv)) (ve (dk-apply! ge nv))
                          (m2 (dk-rewrite-h! m (list 'CHOICE g) (list gv nv))))
                     (dk-project! (list 'SUBSET 'es (list gv nv)) (lambda () (sep-me m2) (dk-split-all!)))
                     (dk-project! (list '<= (list 'rho (list gv nv)) (omc-tn nv)) (lambda () (sep-me m2) (dk-split-all!)))
                     (fact 'fun-apply-type-c gv 'NN 'ca nv)))))
    (fact 'sigma-algebra-countable-inter 'omega 'ca gv)
    (fact 'fun-apply-type-c 'rho 'ca 'RR-POS-STAR fz)
    (dk-have! '(SUBSET es omega)
      (lambda () (mac 'subset-def) (omc-forall! (lambda (zv) (fact 'power-mem-in 'omega 'es zv) (ass)))))
    ;; E inside F
    (dk-have! (list 'SUBSET 'es fz)
      (lambda ()
        (mac 'subset-def)
        (omc-forall!
          (lambda (zv)
            (fact 'subset-mem-fwd 'es 'omega zv)
            (mac 'complement-in-membership)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (let* ((pos (dk-landed-1 (lambda () (di))))
                           (l1 (dk-landed (lambda () (bu-me pos))))
                           (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) l1))
                           (nv (cadr ein)))
                      (gfacts nv)
                      (fact 'subset-mem-fwd 'es (list gv nv) zv)
                      (mac-h 'complement-in-membership (list 'IN zv (list 'COMPLEMENT-IN 'omega (list gv nv))))
                      (dk-split-all!)
                      (ai (list 'NOT (list 'IN zv (list gv nv))))))))))))
    ;; F inside every G(n); rho(F) <= t_n
    (dk-have! (list 'FORALL 'osn (list 'IMPLIES '(IN osn NN) (list '<= rf (omc-tn 'osn))))
      (lambda ()
        (let ((nv (dk-di-var!)))
          (gfacts nv)
          (omc-rn-facts! nv)
          (fact 'fun-apply-type-c 'rho 'ca 'RR-POS-STAR (list gv nv))
          (dk-have! (list 'SUBSET fz (list gv nv))
            (lambda ()
              (mac 'subset-def)
              (omc-forall!
                (lambda (zv)
                  (mac-h 'complement-in-membership (list 'IN zv fz))
                  (dk-split-all!)
                  (use-em (list 'IN zv (list gv nv))
                    (lambda () (ass))
                    (lambda ()
                      (dk-have! (list 'IN zv (list 'COMPLEMENT-IN 'omega (list gv nv)))
                        (lambda () (mac 'complement-in-membership) (dk-conj-close! dk-ass!)))
                      (dk-have! (list 'IN zv bu)
                        (lambda () (for-each (lambda (l) (dk-focus! l) (ass)) (dk-opened (lambda () (bu-mi nv))))))
                      (ai (list 'NOT (list 'IN zv bu)))))))))
          (fact 'measure-monotone 'omega 'ca 'rho fz (list gv nv))
          (omc-ep! omc-x (omc-rn nv))
          (omc-trans! rf (list 'rho (list gv nv)) (omc-tn nv))
          (ass))))
    ;; x <= rho(F): F is one member covering E
    (dk-have! (list 'IN rf ss)
      (lambda () (in-sep! dk-ass! (lambda () (ew fz) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))
    (fact 'einf-lower ss rf)
    (dk-have! (list '<= omc-x rf) (lambda () (subst (list '= omc-x (list 'EINF ss))) (ass)))
    ;; rho(F) <= x
    (dk-have! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list '<= rf (list 'eplus omc-x 'eps))))
      (lambda ()
        (dk-peel!)
        (omc-eps-parts!)
        (dk-have! '(<= 0 eps) (lambda () (dk-ineq! '(< 0 eps))))
        (omc-rps! 'eps)
        (let* ((ex (dk-fact! 'nn-recip-succ-small 'eps))
               (nv (dk-skolem! ex))
               (r (omc-rn nv)))
          (omc-rn-facts! nv)
          (dk-have! (list '<= r 'eps) (lambda () (dk-ineq! (list 'IN r 'RR) '(IN eps RR) (list '< r 'eps))))
          (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h rf) (dk-contains? h 'recip))) "rho(F) <= t_n") nv)
          (fact 'rr-pos-star-le-refl omc-x)
          (omc-and4! (list 'IN omc-x 'RR-POS-STAR) (list 'IN r 'RR-POS-STAR) (list 'IN omc-x 'RR-POS-STAR) '(IN eps RR-POS-STAR))
          (omc-and2! (list '<= omc-x omc-x) (list '<= r 'eps))
          (fact 'eplus-mono omc-x r omc-x 'eps)
          (omc-ep! omc-x r) (omc-ep! omc-x 'eps)
          (omc-trans! rf (omc-tn nv) (list 'eplus omc-x 'eps))
          (ass))))
    (fact 'rps-le-of-forall-eps rf omc-x)
    (omc-antisymm! rf omc-x)
    (ew fz)
    (dk-conj-close! dk-ass!)))
(qed 'method-i-outer-attained)
(topic! 'method-i-outer-attained 'set-quotient)

;;; PROPOSITION 4.10 (c): the mu*-null sets are the rho-null sets (Def. 3.1).
(sp (make-wff (forall-guarded '(omega ca rho es) '((IS-MEASURE omega ca rho) (IN es (POWER omega)))
   '(IFF (= ((METHOD-I-OUTER omega ca rho) es) 0) (IS-NULL-SET omega ca rho es)))))
