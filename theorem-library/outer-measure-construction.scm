;;; COROLLARY 4.11, second half: it extends the completion of rho -- every A u N with
;;; A in cA and N rho-null is mu*-measurable, of measure rho(A).
(define omc-cc2 (list 'CARATHEODORY-SETS 'omega omc-mu2))
(sp (make-wff (forall-guarded '(omega ca rho aa ns)
   '((IS-MEASURE omega ca rho) (IN aa ca) (IS-NULL-SET omega ca rho ns))
   (list 'AND (list 'IN '(UNION aa ns) omc-cc2)
              (list '= (list (list 'RES omc-mu2 omc-cc2) '(UNION aa ns)) '(rho aa))))))
(dk-peel!)
(omc-sigma!)
(fact 'measure-is-premeasure 'omega 'ca 'rho)
(fact 'method-i-outer-is-outer-measure 'omega 'ca 'rho)
(fact 'method-i-outer-type 'omega 'ca 'rho)
(fact 'sigma-algebra-ambient-set 'omega 'ca)
(let* ((mu omc-mu2) (cc omc-cc2) (un '(UNION aa ns))
       (parts (omc-om-parts! mu))
       (mono (list-ref parts 3)))
  (fact 'caratheodory-measurable-sigma-algebra 'omega mu)
  (dk-project! (list 'SUBSET cc '(POWER omega)) 'IS-SIGMA-ALGEBRA (list 'IS-SIGMA-ALGEBRA 'omega cc))
  (dk-project! (list 'IN mu '(FUN (POWER omega))) 'fun-codomain-iff (list 'IN mu '(FUN (POWER omega) RR-POS-STAR)))
  (omc-ca-pow! 'ca 'aa)
  ;; N is inside a member of cA, so N in POWER(omega)
  (let* ((iff (dk-cite! 'is-null-set 'omega 'ca 'rho 'ns)))
    (dk-have! (caddr iff) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (ass)))
    (let ((fv (dk-skolem! (caddr iff))))
      (omc-ca-pow! 'ca fv)
      (fact 'power-mem-sethood 'omega fv)
      (fact 'subclass-of-set-is-set 'ns fv)
      (dk-have! '(FORALL z_ (IMPLIES (IN z_ ns) (IN z_ omega)))
        (lambda () (omc-forall! (lambda (zv) (fact 'subset-mem-fwd 'ns fv zv) (fact 'power-mem-in 'omega fv zv) (ass)))))
      (fact 'power-mem-intro 'omega 'ns)))
  ;; mu*(N) = 0, so N is measurable; A is measurable (Prop. 4.10 (b))
  (fact 'method-i-outer-null-iff 'omega 'ca 'rho 'ns)
  (let ((iff (dk-pick (lambda (h) (and (dk-head-is? h 'IFF) (equal? (caddr h) '(IS-NULL-SET omega ca rho ns)))) "the null iff")))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff))))
  (dk-have! '(SUBSET ns omega)
    (lambda () (mac 'subset-def) (omc-forall! (lambda (zv) (fact 'power-mem-in 'omega 'ns zv) (ass)))))
  (fact 'caratheodory-null-measurable 'omega mu 'ns)
  (fact 'method-i-outer-measurable 'omega 'ca 'rho 'aa)
  (dk-have! (list 'IN 'ns cc) (lambda () (mac 'caratheodory-sets-membership) (dk-conj-close! dk-ass!)))
  (dk-have! (list 'IN 'aa cc) (lambda () (mac 'caratheodory-sets-membership) (dk-conj-close! dk-ass!)))
  (fact 'sigma-algebra-union-closed-2 'omega cc 'aa 'ns)
  ;; the value
  (fact 'subset-mem-fwd cc '(POWER omega) un)
  (omc-and3! (list 'IN mu '(FUN (POWER omega))) (list 'SUBSET cc '(POWER omega)) (list 'IN un cc))
  (fact 'res-apply '(POWER omega) cc mu un)
  (fact 'outer-measure-binary-subadditive 'omega mu 'aa 'ns)
  (fact 'method-i-outer-extends 'omega 'ca 'rho 'aa)
  (omc-subset! 'aa un (lambda (w) #t))
  (dk-apply! mono 'aa un)
  (for-each (lambda (x) (fact 'fun-apply-type-c mu '(POWER omega) 'RR-POS-STAR x)) (list 'aa 'ns un))
  (fact 'fun-apply-type-c 'rho 'ca 'RR-POS-STAR 'aa)
  (fact 'eplus-zero-right '(rho aa))
  (let ((mun (list mu un)) (mua (list mu 'aa)) (mun0 (list mu 'ns)))
    (dk-have! (list '<= mun '(rho aa))
      (lambda () (subst (list '= '(rho aa) (list 'eplus '(rho aa) 0)))
                 (subst (list '= 0 mun0))
                 (subst (list '= '(rho aa) mua))
                 (ass)))
    (dk-have! (list '<= '(rho aa) mun) (lambda () (subst (list '= '(rho aa) mua)) (ass)))
    (omc-antisymm! mun '(rho aa))
    (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst (list '= (list (list 'RES mu cc) un) mun)) (ass)))))))
(qed 'method-i-outer-extends-completion)
(topic! 'method-i-outer-extends-completion 'set-quotient)
(gloss! 'method-i-outer-extends-completion
  "Thayer, Construction of Measures, Cor. 4.11 (p. 34), second half: for a countably
   additive measure rho on (X, A), every set A u N with A in A and N rho-null is
   measurable for the method I outer measure mu* of rho, and the Caratheodory measure
   of mu* gives it the value rho(A) -- the completion of rho (Def. 3.3, Prop. 3.3) is
   extended, stated as the membership and value it amounts to.")

