;;; a sequence of zeros sums to zero
(sp (make-wff '(FORALL f (IMPLIES (IN f (FUN NN RR-POS-STAR))
   (IMPLIES (FORALL ozn (IMPLIES (IN ozn NN) (= (f ozn) 0))) (= (ESUM f) 0))))))
(dk-peel!)
(let ((z (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'ozn))) "the zeros")))
  (fact 'nn-zero-in)
  (fact 'nn-succ-closed 0)
  (dk-apply! z 0)
  (dk-apply! z '(succ 0))
  (dk-have! '(FORALL q (IMPLIES (IN q NN) (= (f (succ (succ q))) 0)))
    (lambda () (let ((qv (dk-di-var!)))
                 (fact 'nn-succ-closed qv) (fact 'nn-succ-closed (list 'succ qv))
                 (dk-apply! z (list 'succ (list 'succ qv))) (ass))))
  (fact 'esum-nn-two-support 'f)
  (fact 'zero-in-rr-pos-star)
  (fact 'eplus-zero-left 0)
  (subst '(= (ESUM f) (eplus (f 0) (f (succ 0)))))
  (subst '(= (f 0) 0))
  (subst '(= (f (succ 0)) 0))
  (subst '(= (eplus 0 0) 0))
  (fact 'rr-zero-in)
  (rfl))
(qed 'esum-nn-zero)
(topic! 'esum-nn-zero 'inequalities)

(define omc-cc3 (list 'CARATHEODORY-SETS 'omega omc-mu2))
(define omc-sx 'sxv)
(define (omc-en n) (list 'INTERSECTION 'es (list omc-sx n)))
(define (omc-gf n)
  (list 'SEP 'osg_ 'ca (list 'AND (list 'SUBSET (omc-en n) 'osg_)
                                  (list 'IS-NULL-SET 'omega 'ca 'rho (list 'COMPLEMENT-IN 'osg_ (omc-en n))))))
(define (omc-gz fs n)
  (list 'SEP 'osh_ 'ca (list 'AND (list 'SUBSET (list 'COMPLEMENT-IN (list fs n) (omc-en n)) 'osh_)
                                  '(= (rho osh_) 0))))
;;; (IN x C3) from (IN x (POWER omega)) and the measurability, and back
(define (omc-into-cc3! x)
  (dk-have! (list 'IN x omc-cc3) (lambda () (mac 'caratheodory-sets-membership) (dk-conj-close! dk-ass!))))
(define (omc-from-cc3! x)
  (let ((iff (dk-cite! 'caratheodory-sets-membership 'omega omc-mu2 x)))
    (dk-project! (list 'IN x '(POWER omega)) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
    (dk-project! (list 'IS-CARATHEODORY-MEASURABLE 'omega omc-mu2 x)
                 (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))))

;;; the sigma-finite form of Prop. 4.10 (d): no finiteness hypothesis on E
(sp (make-wff (forall-guarded '(omega ca rho es)
   (list '(IS-MEASURE omega ca rho) '(IS-SIGMA-FINITE omega ca rho)
         (list 'IS-CARATHEODORY-MEASURABLE 'omega omc-mu2 'es))
   '(FORSOME ofy_ (AND (IN ofy_ ca) (AND (SUBSET es ofy_) (IS-NULL-SET omega ca rho (COMPLEMENT-IN ofy_ es))))))))
(dk-peel!)
(omc-sigma!)
(fact 'measure-is-premeasure 'omega 'ca 'rho)
(fact 'method-i-outer-is-outer-measure 'omega 'ca 'rho)
(fact 'method-i-outer-type 'omega 'ca 'rho)
(fact 'sigma-algebra-ambient-set 'omega 'ca)
(fact 'caratheodory-measurable-sigma-algebra 'omega omc-mu2)
(dk-project! '(SUBSET es omega) 'IS-CARATHEODORY-MEASURABLE (list 'IS-CARATHEODORY-MEASURABLE 'omega omc-mu2 'es))
(fact 'subclass-of-set-is-set 'es 'omega)
(dk-have! '(IN es (POWER omega))
  (lambda () (dk-have! '(FORALL z_ (IMPLIES (IN z_ es) (IN z_ omega)))
               (lambda () (omc-forall! (lambda (zv) (fact 'subset-mem-fwd 'es 'omega zv) (ass)))))
             (fact 'power-mem-intro 'omega 'es) (ass)))
(omc-into-cc3! 'es)
(let* ((mu omc-mu2)
       (sfi (dk-cite! 'is-sigma-finite 'omega 'ca 'rho))
       (sfx (begin (ai sfi) (dk-landed-1 (lambda () (detach! (list 'IMPLIES (cadr sfi) (caddr sfi)))))))
       (sv0 (dk-skolem! sfx)))
  (set! omc-sx sv0)
  (let* ((sx sv0)
         (fin (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h sx) (dk-contains? h 'RR))) "finite measures"))
         (ueq (dk-pick (lambda (h) (and (dk-head-is? h '=) (equal? (caddr h) 'omega) (dk-contains? h sx))) "the union")))
    ;; for every n, E_n = E n X_n has a good F_n
    (dk-have! (list 'FORALL 'osn (list 'IMPLIES '(IN osn NN) (list 'IN (list 'CHOICE (omc-gf 'osn)) (omc-gf 'osn))))
      (lambda ()
        (let* ((nv (dk-di-var!)) (xn (list sx nv)) (en (omc-en nv)) (g (omc-gf nv)))
          (fact 'fun-apply-type-c sx 'NN 'ca nv)
          (dk-apply! fin nv)
