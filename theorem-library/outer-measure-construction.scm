          (omc-from-cc3! en)
          (fact 'method-i-outer-extends 'omega 'ca 'rho xn)
          (fact 'fun-apply-type-c mu '(POWER omega) 'RR-POS-STAR en)
          (omc-subset! en xn (lambda (w) #t))
          (dk-apply! (list-ref (omc-om-parts! mu) 3) en xn)
          (dk-have! (list '<= (list mu en) (list 'rho xn)) (lambda () (subst (list '= (list 'rho xn) (list mu xn))) (ass)))
          (fact 'fun-apply-type-c mu '(POWER omega) 'RR-POS-STAR xn)
          (dk-chain! (dk-cite! 'fun-apply-type-c mu '(POWER omega) 'RR-POS-STAR en) (lambda (a) (lambda () (ass))))
          (omc-and2! (list 'IN (list mu en) 'RR-POS-STAR) (list 'IN (list 'rho xn) 'RR))
          (fact 'rr-pos-star-le-real-in-rr (list mu en) (list 'rho xn))
          (let* ((ex (dk-fact! 'method-i-outer-finite-approx 'omega 'ca 'rho en))
                 (fv (dk-skolem! ex)))
            (dk-have! (list 'FORSOME 'osz_ (list 'IN 'osz_ g))
              (lambda () (ew fv) (in-sep! dk-ass! (lambda () (dk-conj-close! dk-ass!)))))
            (fact 'choice-axiom g)
            (ass)))))
    (let* ((ne (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'CHOICE))) "the F choices"))
           (fr (dk-abstract! 'NN 'ca (lambda (k) (list 'CHOICE (omc-gf k)))
                 (lambda (kv) (let ((m (dk-apply! ne kv))) (sep-me m) (dk-split-all!) (ass)))))
           (fs (car fr)) (fe (cdr fr))
           (ffacts (lambda (nv)
                     (let* ((g (omc-gf nv)) (m (dk-apply! ne nv)) (ve (dk-apply! fe nv))
