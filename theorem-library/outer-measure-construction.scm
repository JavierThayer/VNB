            (dk-have! (list 'FORALL 'osi (list 'IMPLIES '(IN osi NN) (list 'IN (list 'CHOICE (omc-good 'osi)) (omc-good 'osi))))
              (lambda () (omc-choice-ne! (dk-di-var!)) (ass)))
            (let* ((ne (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'CHOICE))) "the choices"))
                   (cr (dk-abstract! 'NN '(FUN NN cls) (lambda (k) (list 'CHOICE (omc-good k)))
                         (lambda (kv) (let ((m (dk-apply! ne kv)))
                                        (sep-me m) (dk-split-all!)
                                        (ass)))))
                   (cv (car cr)) (cve (cdr cr)))
