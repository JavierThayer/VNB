  (dk-project! '(IN rho (FUN ca RR-POS-STAR)) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
  (dk-project! '(= (rho EMPTY-SET) 0) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!))))
(fact 'sigma-algebra-ambient-set 'omega 'ca)
(fact 'sigma-algebra-empty-in 'omega 'ca)
(dk-project! '(SUBSET ca (POWER omega)) 'IS-SIGMA-ALGEBRA '(IS-SIGMA-ALGEBRA omega ca))
(mac 'IS-PREMEASURE)
(dk-conj-close! dk-ass!)
