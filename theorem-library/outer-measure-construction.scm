  (dk-have! '(IN es (POWER omega))
    (lambda () (dk-have! '(FORALL z_ (IMPLIES (IN z_ es) (IN z_ omega)))
                 (lambda () (omc-forall! (lambda (zv) (fact 'subset-mem-fwd 'es 'omega zv) (ass)))))
               (fact 'power-mem-intro 'omega 'es) (ass)))
  (let* ((ex (dk-fact! 'method-i-outer-attained 'omega 'ca 'rho 'es))
         (fv (dk-skolem! ex))
         (fe (list 'COMPLEMENT-IN fv 'es))
         (fi (list 'INTERSECTION fv 'es))
         (mf (list mu fv)) (my (list mu fe)))
    (omc-ca-pow! 'ca fv)
    (fact 'method-i-outer-extends 'omega 'ca 'rho fv)
    (fact 'complement-in-subset 'es fv)
    (dk-have! (list 'IN fe '(POWER omega))
      (lambda ()
        (fact 'power-mem-sethood 'omega fv)
        (fact 'subclass-of-set-is-set fe fv)
        (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ fe) '(IN z_ omega)))
          (lambda () (omc-forall! (lambda (zv) (fact 'subset-mem-fwd fe fv zv) (fact 'power-mem-in 'omega fv zv) (ass)))))
        (fact 'power-mem-intro 'omega fe)
        (ass)))
    ;; mu*(F) = mu*(F n E) + mu*(F \ E) = mu*(E) + mu*(F \ E)
    (dk-apply! mcl fv)
    (fact 'difference-unfold fv 'es)
    (omc-ext! fi 'es (lambda (w) (fact 'subset-mem-fwd 'es fv w)))
    (fact 'method-i-outer-type 'omega 'ca 'rho)
    (fact 'fun-apply-type-c mu '(POWER omega) 'RR-POS-STAR fe)
    (fact 'fun-apply-type-c mu '(POWER omega) 'RR-POS-STAR 'es)
    (dk-congr! (list '= fi 'es) (lambda (t) (list mu t)))
    (let ((h1 (list '= mf (list 'eplus mue my))))
      (dk-have! h1
        (lambda ()
          (subst (list '= fe (list 'DIFFERENCE fv 'es)))
          (subst (list '= mue (list mu fi)))
          (ass)))
      (dk-have! (list '= mf mue) (lambda () (subst (list '= mf (list 'rho fv))) (ass)))
      (dk-rewrite-h! h1 mf mue))
    ;; mu*(F \ E) is finite, hence 0
    (fact 'rr-pos-star-nonneg mue)
    (fact 'rr-pos-star-nonneg my)
    (let ((mono (list-ref (omc-om-parts! mu) 3)))
      (dk-apply! mono fe fv))
    (dk-have! (list '<= my mue) (lambda () (subst (list '= mue (list 'rho fv))) (subst (list '= (list 'rho fv) mf)) (ass)))
    (omc-and2! (list 'IN my 'RR-POS-STAR) (list 'IN mue 'RR))
    (fact 'rr-pos-star-le-real-in-rr my mue)
    (let ((e1 (dk-cite! 'eplus-real-defined mue my)))
      (dk-have! (list '= my 0)
        (lambda ()
          (let ((h (dk-rewrite-h! (list '= mue (list 'eplus mue my)) (cadr e1) (caddr e1))))
            (dk-have! (list '<= my 0) (lambda () (dk-ineq! (list 'IN mue 'RR) (list 'IN my 'RR) h)))
            (fact 'zero-in-rr-pos-star)
            (omc-antisymm! my 0)
            (ass)))))
    (fact 'method-i-outer-null-iff 'omega 'ca 'rho fe)
    (let ((iff (dk-pick (lambda (h) (and (dk-head-is? h 'IFF) (equal? (cadr h) (list '= my 0)))) "the null iff")))
      (ai iff)
      (detach! (list 'IMPLIES (cadr iff) (caddr iff))))
    (ew fv)
    (dk-conj-close! dk-ass!)))
(qed 'method-i-outer-finite-approx)
(topic! 'method-i-outer-finite-approx 'set-quotient)

;;; =====================================================================
;;; (8) Corollary 4.11: the Caratheodory measure of mu* is complete and
;;;     extends the completion of rho.
