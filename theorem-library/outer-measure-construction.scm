(qed 'method-i-outer-subadditive)
(topic! 'method-i-outer-subadditive 'inequalities)

;;; ---------------------------------------------------------------------
;;; PROPOSITION 4.7.  For a pre-measure p on C, the method I outer measure is
;;; an outer measure on X.
;;; ---------------------------------------------------------------------
(define omc-mu '(METHOD-I-OUTER omega cls pm))
;;; (= (mu e) (EINF (CS e))) with (IN e (POWER omega)) in context
(define (omc-val! e)
  (dk-cite! 'method-i-outer-value 'omega 'cls 'pm e))
(define (omc-val-of! cl p e)
  (dk-cite! 'method-i-outer-value 'omega cl p e))

(sp (make-wff (forall-guarded '(omega cls pm) '((IS-PREMEASURE omega cls pm))
   '(IS-OUTER-MEASURE omega (METHOD-I-OUTER omega cls pm)))))
(dk-peel!)
(omc-pm-parts!)
(fact 'method-i-outer-type 'omega 'cls 'pm)
(mac 'IS-OUTER-MEASURE)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-ass!) #t)
            ((dk-head-is? g '=)
             (fact 'power-empty-in 'omega)
             (subst (omc-val! 'EMPTY-SET))
             (fact 'method-i-outer-empty 'omega 'cls 'pm)
             (ass))
            ((dk-contains? g 'BIG-UNION)
             (let* ((fv (dk-di-var!))
                    (bu (cadr (cadr (dk-goal))))
                    (lhs-l (cadr (caddr (dk-goal))))
                    (bl (list 'VNB-LAMBDA 'osk_ 'NN (list 'EINF (list 'COVER-SUMS 'omega 'cls 'pm (list fv 'osk_))))))
               (fact 'power-fun-union-closed 'omega fv)
               (subst (omc-val! bu))
               (fact 'method-i-outer-subadditive 'omega 'cls 'pm fv)
               ;; ESUM of the EINFs <= ESUM of the mu-values, termwise (they are equal)
               (dk-have! (list 'IN bl '(FUN NN RR-POS-STAR))
                 (lambda () (dk-lam-type! (lambda () (let ((kv (cadr (car (dk-peel!)))))
                                                       (fact 'fun-apply-type-c fv 'NN '(POWER omega) kv)
                                                       (omc-then-ass! (lambda () (omc-mstar-type! (list fv kv)))))))))
               (dk-have! (list 'IN lhs-l '(FUN NN RR-POS-STAR))
                 (lambda () (dk-lam-type! (lambda () (let ((kv (cadr (car (dk-peel!)))))
                                                       (fact 'fun-apply-type-c fv 'NN '(POWER omega) kv)
                                                       (fact 'fun-apply-type-c omc-mu '(POWER omega) 'RR-POS-STAR (list fv kv))
                                                       (ass))))))
               (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list bl 'k) (list lhs-l 'k))))
                 (lambda ()
                   (let ((kv (dk-di-var!)))
                     (fact 'fun-apply-type-c fv 'NN '(POWER omega) kv)
                     (omc-mstar-type! (list fv kv))
                     (dk-lam-b!)
                     (subst (omc-val! (list fv kv)))
                     (fact 'rr-pos-star-le-refl (omc-mstar (list fv kv)))
                     (ass))))
               (fact 'esum-nn-le-termwise bl lhs-l)
               (omc-esum-type! bl)
               (omc-esum-type! lhs-l)
               (omc-mstar-type! bu)
               (omc-trans! (omc-mstar bu) (list 'ESUM bl) (list 'ESUM lhs-l))
               (ass)))
            (#t
             (dk-peel!)
             (let* ((gl (dk-goal))
                    (av (cadr (cadr gl))) (bv (cadr (caddr gl))))
               (subst (omc-val! av))
               (subst (omc-val! bv))
               (fact 'method-i-outer-mono 'omega 'cls 'pm av bv)
               (ass)))))))
(qed 'method-i-outer-is-outer-measure)
(topic! 'method-i-outer-is-outer-measure 'set-quotient)
(gloss! 'method-i-outer-is-outer-measure
  "Thayer, Construction of Measures, Prop. 4.7 (p. 32): for a pre-measure p on a
   family C of subsets of X containing the empty set, the function mu*(E) = inf of
   the sums of p over the sequences in C covering E (+inf when there is none) is an
   outer measure on X.  Def. 4.8 names it the method I outer measure.")

