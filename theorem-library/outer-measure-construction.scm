;;; =====================================================================
;;; (0) file-local kit (several copied from caratheodory.scm's cth- kit).
;;; =====================================================================

(define (omc-and2! p q)
  (dk-have! (list 'AND p q) (lambda () (dk-conj-close! dk-ass!))))
(define (omc-and3! p q r)
  (dk-have! (list 'AND p (list 'AND q r)) (lambda () (dk-conj-close! dk-ass!))))
(define (omc-and4! p q r s)
  (dk-have! (list 'AND p (list 'AND q (list 'AND r s))) (lambda () (dk-conj-close! dk-ass!))))

;;; run THUNK on the focus leaf; unless that leaf got grounded (a dk-have! of a claim equal
;;; to the goal proves it in place and moves the focus away), close the leaf now in focus
;;; (a `fact' moves the focus to the child it creates) by `ass'.
(define (omc-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))

;;; x = y in [0, +inf] from x <= y, y <= x, both typed
(define (omc-antisymm! x y)
  (omc-and2! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR))
  (omc-and2! (list '<= x y) (list '<= y x))
  (fact 'rr-pos-star-le-antisymm x y))

;;; x <= z from x <= y, y <= z, all typed
(define (omc-trans! x y z)
  (omc-and3! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR) (list 'IN z 'RR-POS-STAR))
  (omc-and2! (list '<= x y) (list '<= y z))
  (fact 'rr-pos-star-le-trans x y z))

;;; DOM f = NN and f in FUN(DOM f, RR-POS-STAR); then ESUM f typed
(define (omc-dom! fv)
  (fact 'nn-is-set)
  (dk-project! (list 'IN fv '(FUN NN)) 'fun-codomain-iff (list 'IN fv '(FUN NN RR-POS-STAR)))
  (omc-and2! (list 'IN fv '(FUN NN)) '(IN NN SET))
  (fact 'dom-of-fun 'NN fv)
  (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN (list 'DOM fv) 'SET)
                                          (list '= (list 'DOM fv) 'NN)))))
  (dk-have! (list 'IN fv (list 'FUN (list 'DOM fv) 'RR-POS-STAR))
            (lambda () (subst (list '= (list 'DOM fv) 'NN)) (ass))))
(define (omc-esum-type! fv)
  (if (not (dk-asm? (list 'IN (list 'ESUM fv) 'RR-POS-STAR)))
      (begin (omc-dom! fv) (fact 'esum-in fv))))

;;; =====================================================================
;;; (1) COVER-SUMS and METHOD-I-OUTER: unfold, membership, value, typing.
;;; =====================================================================

(define omc-cs-body
  '(SEP cvv_ RR-POS-STAR
     (FORSOME cvs_
       (AND (IN cvs_ (FUN NN cls))
            (AND (SUBSET es (BIG-UNION cvn_ NN (cvs_ cvn_)))
                 (= cvv_ (ESUM (VNB-LAMBDA cvk_ NN (pm (cvs_ cvk_))))))))))

(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cls (list 'FORALL 'pm (list 'FORALL 'es
   (list '== '(COVER-SUMS omega cls pm es) omc-cs-body)))))))
(di)
(mac 'COVER-SUMS)
(qrfl)
(qed 'cover-sums-unfold)
(topic! 'cover-sums-unfold 'plumbing)

;;; COVER-SUMS is a set of extended reals
(sp (make-wff '(FORALL omega (FORALL cls (FORALL pm (FORALL es
   (SUBSET (COVER-SUMS omega cls pm es) RR-POS-STAR)))))))
(di)
(mac 'subset-def)
(let ((zv (dk-di-var!)))
  (mac-h 'cover-sums-unfold (list 'IN zv '(COVER-SUMS omega cls pm es)))
  (sep-me (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (cadr f) zv))) "the SEP membership"))
  (dk-split-all!)
  (ass))
(qed 'cover-sums-subset)
(topic! 'cover-sums-subset 'plumbing)

;;; the read-off: a member of COVER-SUMS is the sum over some covering sequence
(sp (make-wff '(FORALL omega (FORALL cls (FORALL pm (FORALL es (FORALL v_
   (IMPLIES (IN v_ (COVER-SUMS omega cls pm es))
     (FORSOME cvs_
       (AND (IN cvs_ (FUN NN cls))
            (AND (SUBSET es (BIG-UNION cvn_ NN (cvs_ cvn_)))
                 (= v_ (ESUM (VNB-LAMBDA cvk_ NN (pm (cvs_ cvk_))))))))))))))))
(dk-peel!)
(mac-h 'cover-sums-unfold '(IN v_ (COVER-SUMS omega cls pm es)))
(sep-me (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (cadr f) 'v_))) "the SEP membership"))
(dk-split-all!)
(ass)
(qed 'cover-sums-elim)
(topic! 'cover-sums-elim 'plumbing)

;;; the converse: the sum over a covering sequence is a member
(sp (make-wff '(FORALL omega (FORALL cls (FORALL pm (FORALL es (FORALL sq_
   (IMPLIES (IN pm (FUN cls RR-POS-STAR))
     (IMPLIES (IN sq_ (FUN NN cls))
       (IMPLIES (SUBSET es (BIG-UNION cvn_ NN (sq_ cvn_)))
         (IN (ESUM (VNB-LAMBDA cvk_ NN (pm (sq_ cvk_)))) (COVER-SUMS omega cls pm es))))))))))))
(dk-peel!)
(let ((lam '(VNB-LAMBDA cvk_ NN (pm (sq_ cvk_)))))
  (dk-have! (list 'IN lam '(FUN NN RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((kv (cadr (car (dk-peel!)))))
            (fact 'fun-apply-type-c 'sq_ 'NN 'cls kv)
            (fact 'fun-apply-type-c 'pm 'cls 'RR-POS-STAR (list 'sq_ kv))
            (ass))))))
  (omc-esum-type! lam)
  (mac 'COVER-SUMS)
  (in-sep! dk-ass!
    (lambda ()
      (ew 'sq_)
      (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl)))))))
(qed 'cover-sums-intro)
(topic! 'cover-sums-intro 'plumbing)

;;; the value of the method I outer measure
(sp (make-wff '(FORALL omega (FORALL cls (FORALL pm (FORALL es
   (IMPLIES (IN es (POWER omega))
     (= ((METHOD-I-OUTER omega cls pm) es) (EINF (COVER-SUMS omega cls pm es))))))))))
(dk-peel!)
(fact 'cover-sums-subset 'omega 'cls 'pm 'es)
(fact 'einf-in '(COVER-SUMS omega cls pm es))
(mac 'METHOD-I-OUTER)
(dk-lam-b!)
(rfl)
(qed 'method-i-outer-value)
(topic! 'method-i-outer-value 'plumbing)

;;; its typing
(sp (make-wff '(FORALL omega (FORALL cls (FORALL pm
   (IMPLIES (IN omega SET)
     (IN (METHOD-I-OUTER omega cls pm) (FUN (POWER omega) RR-POS-STAR))))))))
(dk-peel!)
(fact 'power-set 'omega)
