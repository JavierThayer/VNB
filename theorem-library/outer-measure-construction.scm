(dk-peel!)
(omc-sigma!)
(fact 'measure-is-premeasure 'omega 'ca 'rho)
(fact 'method-i-outer-is-outer-measure 'omega 'ca 'rho)
(fact 'sigma-algebra-ambient-set 'omega 'ca)
(let* ((mu omc-mu2)
       (mue (list mu 'es))
       (mcl (list 'FORALL 'oma_ (list 'IMPLIES '(IN oma_ (POWER omega))
              (list '= (list mu 'oma_) (list 'eplus (list mu '(INTERSECTION oma_ es)) (list mu '(DIFFERENCE oma_ es))))))))
