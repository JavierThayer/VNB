;;; the five conjuncts of IS-OUTER-MEASURE(omega, MU), landed (hypothesis kept)
(define (omc-om-parts! mu)
  (let* ((iff (dk-cite! 'is-outer-measure 'omega mu))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (map (lambda (c) (dk-project! c 'IS-OUTER-MEASURE (list 'IS-OUTER-MEASURE 'omega mu))) cs)))

;;; PROPOSITION 4.10 (d): a mu*-measurable E of finite outer measure lies in an
;;; F in cA with F \ E rho-null.
(sp (make-wff (forall-guarded '(omega ca rho es)
   '((IS-MEASURE omega ca rho)
     (IS-CARATHEODORY-MEASURABLE omega (METHOD-I-OUTER omega ca rho) es)
     (IN ((METHOD-I-OUTER omega ca rho) es) RR))
