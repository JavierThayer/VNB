;;; Library: linear-algebra.

;;; ring-pow-form.scm -- the matrix form (u, v) |-> row(u) A row(v)^T on R^n is bilinear (CCR-1109-E2,
;;; 2026-11-09).  Prefix rpf-.  Vocabulary: structure-library/ring-pow-vocab (RING-POW, RING-ROW; CCR-1109-E),
;;; matrix (MATMUL, MATADD, MATSCALE, TRANSPOSE, ENTRY).
;;;
;;; For a commutative ring R, n >= 1 and A in MAT(n, n, CARR R), write
;;;     MF_A(u, v) = ENTRY(MATMUL(R, RING-ROW(R, n, u), MATMUL(R, A, TRANSPOSE(RING-ROW(R, n, v), 1, n))), 1, 1),
;;; i.e. row(u) (A row(v)^T) = sum_i u_i (sum_j a_ij v_j).  The laws:
;;;   matmul-matscale-left-rect    (c P) Q = c (P Q), P m x n, Q n x k, 1 <= n (over a ring)
;;;   matmul-matscale-right-rect   P (c Q) = c (P Q) (over a commutative ring)
;;;   transpose-matadd, transpose-matscale
;;;   ring-pow-vadd-at, ring-pow-act-at   the coordinates of u + v and a u in R^n
;;;   ring-row-vadd, ring-row-act         row(u + v) = row(u) + row(v), row(a u) = a row(u)
;;;   ring-pow-form-type                  MF_A(u, v) in CARR R
;;;   ring-pow-form-add-l / -add-r / -act-l / -act-r    additivity and homogeneity in each argument
;;;   ring-pow-matrix-form-bilinear       the four laws in the shape of IS-K-BILINEAR-FORM's conjuncts
;;; No binder work: matrix distributivity (matmul-right-dist-guarded, matmul-left-dist-guarded), the scalar
;;; laws above and the linearity of RING-ROW; the only entrywise proofs are matrix extensionality lanes.
;;; n = 0 is excluded: MATMUL of a 1 x 0 by a 0 x 1 matrix is not typed by matmul-type.
;;;
;;; Destination theorem-library/ring-pow-form.scm.  Library: linear-algebra (only matrix and module heads).
;;; LOAD WINDOW: after theorem-library/ring-pow (CCR-1109-E: ring-pow-unfold, ring-pow-family, ring-pow-is-module,
;;; ring-pow-scal, ring-pow-vec-out, ring-row-type, ring-row-entry) and theorem-library/la-det-adjoint
;;; (ladet-ring-r1); matmul-entry, matmul-type, matmul-*-dist-guarded, matadd-*, matscale-*, transpose-entry,
;;; transpose-in-mat, matrix-entry-extensionality, finsum-ring-distrib-left-gen, dsum-vadd-at, dsum-act-at
;;; load earlier.  No support, warrant or stamp.  Binders built: rpfz_ (the congruence lanes), rpfp_ rpfq_.

(define (rpf-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** ring-pow-form: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline))
                              (let ((as (dk-asms-of l))) (list-head as (min 40 (length as))))))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'algebra))
(define (rpf-iv! i a b)
  (fact 'interval-elt-in-nn a b i)
  (fact 'interval-lo a b i)
  (fact 'interval-hi a b i))
(define (rpf-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!) #f))
;; close ANY goal from contradictory NN facts PREMS (la-det-adjoint's ladet-absurd!)
(define (rpf-absurd! prems)
  (dk-have! '(<= 1 0) (lambda () (apply dk-nn! prems)))
  (dk-focus-having! '(<= 1 0))
  (have! '(NOT (<= 1 0)) (lambda () (arith)))
  (dk-focus-having! '(NOT (<= 1 0)))
  (pbc)
  (ai '(NOT (<= 1 0))))
;; (IMPLIES (= N 0) (OR (= A 0) (= B 0))) from (<= 1 N)
(define (rpf-guard! n a b)
  (let ((g (list 'IMPLIES (list '= n 0) (list 'OR (list '= a 0) (list '= b 0)))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (di) (rpf-absurd! (list (list '= n 0) (list '<= 1 n))))))
    g))
;; the sizes of a matrix X typed (IN X (MAT m k (CARR R))) in context
(define (rpf-mat-of X)
  (let ((f (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN) (equal? (cadr f) X)
                                        (pair? (caddr f)) (eq? (car (caddr f)) 'MAT)
                                        (equal? (cadddr (caddr f)) '(CARR R))))
                       (dk-asms))))
    (if (not f) (error "rpf-mat-of: matrix not typed" (expression->string X)))
    (caddr f)))
;; land (IN T (CARR R)) for T built of ENTRY, ADD, MUL, applications x(i) of vectors of R^n
(define (rpf-carr! t)
  (cond ((dk-asm? (list 'IN t '(CARR R))) #t)
        ((and (pair? t) (eq? (car t) 'ENTRY))
         (let ((M (rpf-mat-of (cadr t))))
           (fact 'entry-in-carrier (cadr M) (caddr M) '(CARR R) (cadr t) (caddr t) (cadddr t))))
        ((and (pair? t) (equal? (car t) '(ADD R)))
         (rpf-carr! (cadr t)) (rpf-carr! (caddr t))
         (fact 'ring-add-closed 'R (cadr t) (caddr t)))
        ((and (pair? t) (equal? (car t) '(MUL R)))
         (rpf-carr! (cadr t)) (rpf-carr! (caddr t))
         (fact 'ring-carrier-closed-mul 'R (cadr t) (caddr t)))
        ((and (pair? t) (symbol? (car t)) (= (length t) 2) (dk-asm? (list 'IN (car t) '(VEC (RING-POW R n)))))
         (fact 'ring-pow-vec-out 'R 'n (car t) (cadr t)))
        (#t (error "rpf-carr!: cannot type" (expression->string t))))
  (if (not (dk-asm? (list 'IN t '(CARR R)))) (error "rpf-carr!: did not land" (expression->string t))))
(define (rpf-close-carr!)
  (let ((g (dk-goal)))
    (cond ((and (eq? (car g) 'IN) (equal? (caddr g) '(CARR R))) (rpf-carr! (cadr g)) (ass))
          ((and (eq? (car g) 'IN) (eq? (caddr g) 'SET))
           (rpf-carr! (cadr g)) (fact 'membership-implies-sethood (cadr g) '(CARR R)) (ass))
          ((eq? (car g) '=) (rpf-carr! (cadr g)) (rfl))
          (#t (error "rpf-close-carr!: unexpected goal" (expression->string g))))))
;; (IN LAM (FUN DOM (CARR R))) for a one-variable lambda over an interval whose body is typable
(define (rpf-fun-type! lam)
  (let ((dom (caddr lam)))
    (dk-have! (list 'IN lam (list 'FUN dom '(CARR R)))
      (lambda ()
        (dk-lam-type! (lambda () (let ((ld (dk-peel!)))
                                   (let ((f (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) dom))) ld)))
                                     (if f (rpf-iv! (cadr f) (cadr dom) (caddr dom)))))
                                 (rpf-beta!) (rpf-close-carr!))
                      (lambda () (fact 'interval-in-set (cadr dom) (caddr dom)) (ass)))))))
;; FINSUM(ag, L1, I) == FINSUM(ag, L2, I), I = (INTERVAL 1 N), from the pointwise equation proved by THUNK
(define (rpf-cong! L1 L2 N thunk)
  (let ((I (list 'INTERVAL 1 N)))
    (fact 'ring-additive-ag-is-abelian-group 'R)
    (fact 'interval-in-set 1 N)
    (fact 'interval-card-in-nn 1 N)
    (dk-have! (list 'FORALL 'rpfz_ (list 'IMPLIES (list 'IN 'rpfz_ I)
                (list '= (list L1 'rpfz_) (list L2 'rpfz_))))
      (lambda ()
        (dk-peel!)
        (let ((v (cadr (cadr (dk-goal)))))
          (rpf-iv! v 1 N)
          (rpf-beta!)
          (thunk v))))
    (dk-fact! 'finsum-congruence-q '(RING-ADDITIVE-AG R) I L1 L2)))
;; entrywise proof of P = Q in MAT(ROWS, COLS, CARR R)
(define (rpf-ext! P Q rows cols thunk)
  (detach-with! (dk-fact! 'matrix-entry-extensionality rows cols '(CARR R) P Q)
    (lambda ()
      (dk-peel!)
      (let* ((g (dk-goal)) (ei (caddr (cadr g))) (ek (cadddr (cadr g))))
        (rpf-iv! ei 1 rows)
        (rpf-iv! ek 1 cols)
        (thunk ei ek))))
  (ass))
(define (rpf-ring!) (if (not (dk-asm? '(IS-RING R))) (fact 'commutative-ring-is-ring 'R)))

;;; =======================================================================
;;; 1. The scalar and transpose laws for rectangular matrices.

(define (rpf-scale-mul! right?)
  (let* ((cX (if right? '(MATSCALE R c Q) '(MATSCALE R c P)))
         (LHS (if right? (list 'MATMUL 'R 'P cX) (list 'MATMUL 'R cX 'Q)))
         (PQ '(MATMUL R P Q))
         (RHS (list 'MATSCALE 'R 'c PQ)))
    (sp (make-wff
      (forall-guarded '(R m n k P Q c)
        (list (if right? '(IS-COMMUTATIVE-RING R) '(IS-RING R)) '(IN m NN) '(IN n NN) '(IN k NN) '(<= 1 n)
              '(IN P (MAT m n (CARR R))) '(IN Q (MAT n k (CARR R))) '(IN c (CARR R)))
        (list '= LHS RHS))))
    (dk-peel!)
    (rpf-ring!)
    (if right? (fact 'matscale-type 'R 'n 'k 'c 'Q) (fact 'matscale-type 'R 'm 'n 'c 'P))
    (rpf-guard! 'n 'm 'k)
    (if right? (fact 'matmul-type 'R 'm 'n 'k 'P cX) (fact 'matmul-type 'R 'm 'n 'k cX 'Q))
    (fact 'matmul-type 'R 'm 'n 'k 'P 'Q)
    (fact 'matscale-type 'R 'm 'k 'c PQ)
    (fact 'interval-in-set 1 'n)
    (fact 'interval-card-in-nn 1 'n)
    (rpf-ext! LHS RHS 'm 'k (lambda (i kk)
      (let* ((me1 (if right? (dk-fact! 'matmul-entry 'R 'm 'n 'k 'P cX i kk)
                             (dk-fact! 'matmul-entry 'R 'm 'n 'k cX 'Q i kk)))
             (L1 (caddr (caddr me1))))
        (subst me1)
        (subst (dk-fact! 'matscale-entry 'R 'm 'k 'c PQ i kk))
        (let* ((me2 (dk-fact! 'matmul-entry 'R 'm 'n 'k 'P 'Q i kk))
               (L2 (caddr (caddr me2))))
          (subst me2)
          (rpf-fun-type! L2)
          (let* ((ds (dk-fact! 'finsum-ring-distrib-left-gen 'R 'c '(INTERVAL 1 n) L2))
                 (L3 (caddr (caddr ds))))
            (subst ds)
            (subst (rpf-cong! L1 L3 'n (lambda (v)
              (if right?
                  (subst (dk-fact! 'matscale-entry 'R 'n 'k 'c 'Q v kk))
                  (subst (dk-fact! 'matscale-entry 'R 'm 'n 'c 'P i v)))
              (let* ((p (list 'ENTRY 'P i v)) (q (list 'ENTRY 'Q v kk)))
                (rpf-carr! p) (rpf-carr! q)
                (if right?
                    (subst (dk-fact! 'ladet-ring-r1 'R p 'c q))
                    (subst (dk-fact! 'ring-mul-assoc 'R 'c p q)))
                (rpf-close-carr!)))))
            (rpf-fun-type! L3)
            (fact 'finsum-type-ring-additive-ag 'R '(INTERVAL 1 n) L3)
            (rfl))))))))
(rpf-scale-mul! #f)
(rpf-done! 'matmul-matscale-left-rect)
(rpf-scale-mul! #t)
(rpf-done! 'matmul-matscale-right-rect)

(sp (make-wff
  (forall-guarded '(R m n P Q) '((IS-RING R) (IN m NN) (IN n NN) (IN P (MAT m n (CARR R))) (IN Q (MAT m n (CARR R))))
    '(= (TRANSPOSE (MATADD R P Q) m n) (MATADD R (TRANSPOSE P m n) (TRANSPOSE Q m n))))))
(dk-peel!)
(fact 'matadd-type 'R 'm 'n 'P 'Q)
(fact 'transpose-in-mat '(MATADD R P Q) 'm 'n '(CARR R))
(fact 'transpose-in-mat 'P 'm 'n '(CARR R))
(fact 'transpose-in-mat 'Q 'm 'n '(CARR R))
(fact 'matadd-type 'R 'n 'm '(TRANSPOSE P m n) '(TRANSPOSE Q m n))
(rpf-ext! '(TRANSPOSE (MATADD R P Q) m n) '(MATADD R (TRANSPOSE P m n) (TRANSPOSE Q m n)) 'n 'm (lambda (i j)
  (subst (dk-fact! 'transpose-entry '(MATADD R P Q) 'm 'n '(CARR R) i j))
  (subst (dk-fact! 'matadd-entry 'R 'm 'n 'P 'Q j i))
  (subst (dk-fact! 'matadd-entry 'R 'n 'm '(TRANSPOSE P m n) '(TRANSPOSE Q m n) i j))
  (subst (dk-fact! 'transpose-entry 'P 'm 'n '(CARR R) i j))
  (subst (dk-fact! 'transpose-entry 'Q 'm 'n '(CARR R) i j))
  (rpf-close-carr!)))
(rpf-done! 'transpose-matadd)

(sp (make-wff
  (forall-guarded '(R m n c P) '((IS-RING R) (IN m NN) (IN n NN) (IN c (CARR R)) (IN P (MAT m n (CARR R))))
    '(= (TRANSPOSE (MATSCALE R c P) m n) (MATSCALE R c (TRANSPOSE P m n))))))
(dk-peel!)
(fact 'matscale-type 'R 'm 'n 'c 'P)
(fact 'transpose-in-mat '(MATSCALE R c P) 'm 'n '(CARR R))
(fact 'transpose-in-mat 'P 'm 'n '(CARR R))
(fact 'matscale-type 'R 'n 'm 'c '(TRANSPOSE P m n))
(rpf-ext! '(TRANSPOSE (MATSCALE R c P) m n) '(MATSCALE R c (TRANSPOSE P m n)) 'n 'm (lambda (i j)
  (subst (dk-fact! 'transpose-entry '(MATSCALE R c P) 'm 'n '(CARR R) i j))
  (subst (dk-fact! 'matscale-entry 'R 'm 'n 'c 'P j i))
  (subst (dk-fact! 'matscale-entry 'R 'n 'm 'c '(TRANSPOSE P m n) i j))
  (subst (dk-fact! 'transpose-entry 'P 'm 'n '(CARR R) i j))
  (rpf-close-carr!)))
(rpf-done! 'transpose-matscale)

;;; =======================================================================
;;; 2. The coordinates of u + v and a u in R^n; the coefficient row is linear.

(define RPF-FAM '(VNB-LAMBDA rqpi_ (INTERVAL 1 n) (RING-AS-MODULE R)))
(define RPF-DS (list 'DIRECT-SUM 'R 'n RPF-FAM))
(define RPF-RP '(RING-POW R n))
(define RPF-RAM '(RING-AS-MODULE R))
(define RPF-DV (list 'DSUM-VEC 'n RPF-FAM))
(define RPF-HM (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 n)) (list 'IS-MODULE (list RPF-FAM 'i_)))))
(define (rpf-setup!)                   ; IS-RING R, n in NN in context (ring-pow's rpw-setup!)
  (fact 'ring-as-module-is-module 'R)
  (for-each (lambda (nm) (fact nm 'R)) '(ram-ro-scal ram-ro-vec ram-ro-vadd ram-ro-act))
  (if (not (dk-asm? RPF-HM)) (dk-split! (dk-cite! 'ring-pow-family 'R 'n)))
  (fact 'direct-sum-is-module 'R 'n RPF-FAM)
  (for-each (lambda (nm) (fact nm 'R 'n RPF-FAM)) '(dsum-ro-scal dsum-ro-vec dsum-ro-vadd dsum-ro-act))
  (fact 'ring-pow-unfold 'R 'n))
(define (rpf-fam-ram! i)
  (let ((e (list '== (list RPF-FAM i) RPF-RAM)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (if (not (dk-lam-b!)) (qrfl)))))
    e))
(define (rpf-in-dv! x)                 ; from (IN x (VEC (RING-POW R n))) land (IN x (DSUM-VEC n FAM))
  (let ((h1 (dk-rewrite-h! (list 'IN x (list 'VEC RPF-RP)) RPF-RP RPF-DS)))
    (if (not (dk-asm? (list 'IN x RPF-DV)))
        (dk-rewrite-h! h1 (list 'VEC RPF-DS) RPF-DV))))
(define (rpf-stmt vars guards body)
  (forall-guarded (append '(R n) vars) (append '((IS-RING R) (IN n NN)) guards) body))

(sp (make-wff (rpf-stmt '(x y i) '((IN x (VEC (RING-POW R n))) (IN y (VEC (RING-POW R n))) (IN i (INTERVAL 1 n)))
  '(= (((VADD (RING-POW R n)) x y) i) ((ADD R) (x i) (y i))))))
(dk-peel!)
(rpf-setup!)
(rpf-in-dv! 'x)
(rpf-in-dv! 'y)
(subst (list '= RPF-RP RPF-DS))
(subst (dk-cite! 'dsum-vadd-at 'R 'n RPF-FAM 'x 'y 'i))
(rpf-fam-ram! 'i)
(subst (list '= (list RPF-FAM 'i) RPF-RAM))
(subst (list '= (list 'VADD RPF-RAM) '(ADD R)))
(fact 'ring-pow-vec-out 'R 'n 'x 'i)
(fact 'ring-pow-vec-out 'R 'n 'y 'i)
(fact 'ring-add-closed 'R '(x i) '(y i))
(rfl)
(rpf-done! 'ring-pow-vadd-at)

(sp (make-wff (rpf-stmt '(a x i) '((IN a (CARR R)) (IN x (VEC (RING-POW R n))) (IN i (INTERVAL 1 n)))
  '(= (((ACT (RING-POW R n)) a x) i) ((MUL R) a (x i))))))
(dk-peel!)
(rpf-setup!)
(rpf-in-dv! 'x)
(subst (list '= RPF-RP RPF-DS))
(subst (dk-cite! 'dsum-act-at 'R 'n RPF-FAM 'a 'x 'i))
(rpf-fam-ram! 'i)
(subst (list '= (list RPF-FAM 'i) RPF-RAM))
(subst (list '= (list 'ACT RPF-RAM) '(MUL R)))
(fact 'ring-pow-vec-out 'R 'n 'x 'i)
(fact 'ring-carrier-closed-mul 'R 'a '(x i))
(rfl)
(rpf-done! 'ring-pow-act-at)

;; i in [1, 1]: land (= i 1)
(define (rpf-one! i)
  (if (not (equal? i 1))
      (begin
        (if (not (dk-asm? (list '= i 1))) (dk-have! (list '= i 1) (lambda () (dk-nn!))))
        (subst (list '= i 1)))))

(sp (make-wff (rpf-stmt '(x y) '((IN x (VEC (RING-POW R n))) (IN y (VEC (RING-POW R n))))
  '(= (RING-ROW R n ((VADD (RING-POW R n)) x y)) (MATADD R (RING-ROW R n x) (RING-ROW R n y))))))
(dk-peel!)
(fact 'nn-one-in)
(fact 'ring-pow-is-module 'R 'n)
(let ((s '((VADD (RING-POW R n)) x y)))
  (fact 'module-vadd-type '(RING-POW R n) 'x 'y)
  (fact 'ring-row-type 'R 'n s)
  (fact 'ring-row-type 'R 'n 'x)
  (fact 'ring-row-type 'R 'n 'y)
  (fact 'matadd-type 'R 1 'n '(RING-ROW R n x) '(RING-ROW R n y))
  (rpf-ext! (list 'RING-ROW 'R 'n s) '(MATADD R (RING-ROW R n x) (RING-ROW R n y)) 1 'n (lambda (i j)
    (subst (dk-fact! 'matadd-entry 'R 1 'n '(RING-ROW R n x) '(RING-ROW R n y) i j))
    (rpf-one! i)
    (subst (dk-fact! 'ring-row-entry 'R 'n s j))
    (subst (dk-fact! 'ring-row-entry 'R 'n 'x j))
    (subst (dk-fact! 'ring-row-entry 'R 'n 'y j))
    (subst (dk-fact! 'ring-pow-vadd-at 'R 'n 'x 'y j))
    (rpf-close-carr!))))
(rpf-done! 'ring-row-vadd)

(sp (make-wff (rpf-stmt '(a x) '((IN a (CARR R)) (IN x (VEC (RING-POW R n))))
  '(= (RING-ROW R n ((ACT (RING-POW R n)) a x)) (MATSCALE R a (RING-ROW R n x))))))
(dk-peel!)
(fact 'nn-one-in)
(fact 'ring-pow-is-module 'R 'n)
(fact 'ring-pow-scal 'R 'n)
(let ((s '((ACT (RING-POW R n)) a x)))
  (dk-have! '(IN a (CARR (SCAL (RING-POW R n)))) (lambda () (subst '(= (SCAL (RING-POW R n)) R)) (ass)))
  (fact 'module-act-type '(RING-POW R n) 'a 'x)
  (fact 'ring-row-type 'R 'n s)
  (fact 'ring-row-type 'R 'n 'x)
  (fact 'matscale-type 'R 1 'n 'a '(RING-ROW R n x))
  (rpf-ext! (list 'RING-ROW 'R 'n s) '(MATSCALE R a (RING-ROW R n x)) 1 'n (lambda (i j)
    (subst (dk-fact! 'matscale-entry 'R 1 'n 'a '(RING-ROW R n x) i j))
    (rpf-one! i)
    (subst (dk-fact! 'ring-row-entry 'R 'n s j))
    (subst (dk-fact! 'ring-row-entry 'R 'n 'x j))
    (subst (dk-fact! 'ring-pow-act-at 'R 'n 'a 'x j))
    (rpf-close-carr!))))
(rpf-done! 'ring-row-act)

;;; =======================================================================
;;; 3. The matrix form.

(define (rpf-T v) (list 'TRANSPOSE (list 'RING-ROW 'R 'n v) 1 'n))
(define (rpf-B v) (list 'MATMUL 'R 'A (rpf-T v)))
(define (rpf-M u v) (list 'MATMUL 'R (list 'RING-ROW 'R 'n u) (rpf-B v)))
(define (rpf-mf u v) (list 'ENTRY (rpf-M u v) 1 1))
(define RPF-VEC '(VEC (RING-POW R n)))
(define (rpf-fstmt vars guards body)
  (forall-guarded (append '(R n A) vars)
                  (append '((IS-COMMUTATIVE-RING R) (IN n NN) (<= 1 n) (IN A (MAT n n (CARR R)))) guards) body))
;; typings of row(V), row(V)^T, A row(V)^T, row(U) A row(V)^T for vectors U, V
(define (rpf-types! u v)
  (rpf-ring!)
  (fact 'nn-one-in)
  (fact 'one-in-interval-1)
  (rpf-guard! 'n 'n 1)
  (rpf-guard! 'n 1 1)
  (fact 'ring-row-type 'R 'n u)
  (fact 'ring-row-type 'R 'n v)
  (fact 'transpose-in-mat (list 'RING-ROW 'R 'n v) 1 'n '(CARR R))
  (fact 'matmul-type 'R 'n 'n 1 'A (rpf-T v))
  (fact 'matmul-type 'R 1 'n 1 (list 'RING-ROW 'R 'n u) (rpf-B v)))

(sp (make-wff (rpf-fstmt '(u v) (list (list 'IN 'u RPF-VEC) (list 'IN 'v RPF-VEC)) (list 'IN (rpf-mf 'u 'v) '(CARR R)))))
(dk-peel!)
(rpf-types! 'u 'v)
(rpf-close-carr!)
(rpf-done! 'ring-pow-form-type)

;; additivity in the first argument
(sp (make-wff (rpf-fstmt '(x y z) (list (list 'IN 'x RPF-VEC) (list 'IN 'y RPF-VEC) (list 'IN 'z RPF-VEC))
  (list '= (rpf-mf '((VADD (RING-POW R n)) x y) 'z) (list '(ADD R) (rpf-mf 'x 'z) (rpf-mf 'y 'z))))))
(dk-peel!)
(rpf-types! 'x 'z)
(rpf-types! 'y 'z)
(subst (dk-fact! 'ring-row-vadd 'R 'n 'x 'y))
(subst (dk-fact! 'matmul-right-dist-guarded 'R 1 'n 1 '(RING-ROW R n x) '(RING-ROW R n y) (rpf-B 'z)))
(subst (dk-fact! 'matadd-entry 'R 1 1 (rpf-M 'x 'z) (rpf-M 'y 'z) 1 1))
(rpf-close-carr!)
(rpf-done! 'ring-pow-form-add-l)

;; additivity in the second argument
(sp (make-wff (rpf-fstmt '(x y z) (list (list 'IN 'x RPF-VEC) (list 'IN 'y RPF-VEC) (list 'IN 'z RPF-VEC))
  (list '= (rpf-mf 'z '((VADD (RING-POW R n)) x y)) (list '(ADD R) (rpf-mf 'z 'x) (rpf-mf 'z 'y))))))
(dk-peel!)
(rpf-types! 'z 'x)
(rpf-types! 'z 'y)
(subst (dk-fact! 'ring-row-vadd 'R 'n 'x 'y))
(subst (dk-fact! 'transpose-matadd 'R 1 'n '(RING-ROW R n x) '(RING-ROW R n y)))
(subst (dk-fact! 'matmul-left-dist-guarded 'R 'n 'n 1 'A (rpf-T 'x) (rpf-T 'y)))
(subst (dk-fact! 'matmul-left-dist-guarded 'R 1 'n 1 '(RING-ROW R n z) (rpf-B 'x) (rpf-B 'y)))
(subst (dk-fact! 'matadd-entry 'R 1 1 (rpf-M 'z 'x) (rpf-M 'z 'y) 1 1))
(rpf-close-carr!)
(rpf-done! 'ring-pow-form-add-r)

;; homogeneity in the first argument
(sp (make-wff (rpf-fstmt '(csc x y) (list '(IN csc (CARR R)) (list 'IN 'x RPF-VEC) (list 'IN 'y RPF-VEC))
  (list '= (rpf-mf '((ACT (RING-POW R n)) csc x) 'y) (list '(MUL R) 'csc (rpf-mf 'x 'y))))))
(dk-peel!)
(rpf-types! 'x 'y)
(subst (dk-fact! 'ring-row-act 'R 'n 'csc 'x))
(subst (dk-fact! 'matmul-matscale-left-rect 'R 1 'n 1 '(RING-ROW R n x) (rpf-B 'y) 'csc))
(subst (dk-fact! 'matscale-entry 'R 1 1 'csc (rpf-M 'x 'y) 1 1))
(rpf-close-carr!)
(rpf-done! 'ring-pow-form-act-l)

;; homogeneity in the second argument
(sp (make-wff (rpf-fstmt '(csc x y) (list '(IN csc (CARR R)) (list 'IN 'x RPF-VEC) (list 'IN 'y RPF-VEC))
  (list '= (rpf-mf 'x '((ACT (RING-POW R n)) csc y)) (list '(MUL R) 'csc (rpf-mf 'x 'y))))))
(dk-peel!)
(rpf-types! 'x 'y)
(subst (dk-fact! 'ring-row-act 'R 'n 'csc 'y))
(fact 'matscale-type 'R 'n 1 'csc (rpf-T 'y))
(subst (dk-fact! 'transpose-matscale 'R 1 'n 'csc '(RING-ROW R n y)))
(subst (dk-fact! 'matmul-matscale-right-rect 'R 'n 'n 1 'A (rpf-T 'y) 'csc))
(fact 'matscale-type 'R 'n 1 'csc (rpf-B 'y))
(subst (dk-fact! 'matmul-matscale-right-rect 'R 1 'n 1 '(RING-ROW R n x) (rpf-B 'y) 'csc))
(subst (dk-fact! 'matscale-entry 'R 1 1 'csc (rpf-M 'x 'y) 1 1))
(rpf-close-carr!)
(rpf-done! 'ring-pow-form-act-r)

;; the bundle, in the shape of the conjuncts of IS-K-BILINEAR-FORM
(define (rpf-bundle)
  (list 'AND
    (list 'FORALL 'rpfx_ (list 'IMPLIES (list 'IN 'rpfx_ RPF-VEC) (list 'FORALL 'rpfy_ (list 'IMPLIES (list 'IN 'rpfy_ RPF-VEC)
      (list 'FORALL 'rpfw_ (list 'IMPLIES (list 'IN 'rpfw_ RPF-VEC)
        (list 'AND
          (list '= (rpf-mf '((VADD (RING-POW R n)) rpfx_ rpfy_) 'rpfw_) (list '(ADD R) (rpf-mf 'rpfx_ 'rpfw_) (rpf-mf 'rpfy_ 'rpfw_)))
          (list '= (rpf-mf 'rpfw_ '((VADD (RING-POW R n)) rpfx_ rpfy_)) (list '(ADD R) (rpf-mf 'rpfw_ 'rpfx_) (rpf-mf 'rpfw_ 'rpfy_))))))))))
    (list 'FORALL 'rpfa_ (list 'IMPLIES '(IN rpfa_ (CARR R)) (list 'FORALL 'rpfx_ (list 'IMPLIES (list 'IN 'rpfx_ RPF-VEC)
      (list 'FORALL 'rpfy_ (list 'IMPLIES (list 'IN 'rpfy_ RPF-VEC)
        (list 'AND
          (list '= (rpf-mf '((ACT (RING-POW R n)) rpfa_ rpfx_) 'rpfy_) (list '(MUL R) 'rpfa_ (rpf-mf 'rpfx_ 'rpfy_)))
          (list '= (rpf-mf 'rpfx_ '((ACT (RING-POW R n)) rpfa_ rpfy_)) (list '(MUL R) 'rpfa_ (rpf-mf 'rpfx_ 'rpfy_))))))))))))
(sp (make-wff (rpf-fstmt '() '() (rpf-bundle))))
(dk-peel!)
(dk-conj-close!
  (lambda ()
    (dk-peel!)
    (dk-conj-close!
      (lambda ()
        (let* ((g (dk-goal)) (l (cadr g)) (mm (cadr l)) (row (caddr mm)) (tv (cadddr (cadddr mm))))
          ;; l = (ENTRY (MATMUL R (RING-ROW R n U) (MATMUL R A (TRANSPOSE (RING-ROW R n V) 1 n))) 1 1)
          (let* ((u (cadddr row)) (v (cadddr (cadr tv))))
            (cond ((and (pair? u) (equal? (car u) '(VADD (RING-POW R n))))
                   (dk-fact! 'ring-pow-form-add-l 'R 'n 'A (cadr u) (caddr u) v))
                  ((and (pair? v) (equal? (car v) '(VADD (RING-POW R n))))
                   (dk-fact! 'ring-pow-form-add-r 'R 'n 'A (cadr v) (caddr v) u))
                  ((and (pair? u) (equal? (car u) '(ACT (RING-POW R n))))
                   (dk-fact! 'ring-pow-form-act-l 'R 'n 'A (cadr u) (caddr u) v))
                  (#t (dk-fact! 'ring-pow-form-act-r 'R 'n 'A (cadr v) u (caddr v))))
            (ass)))))))
(rpf-done! 'ring-pow-matrix-form-bilinear)
(gloss! 'ring-pow-matrix-form-bilinear
  "For a commutative ring R, n >= 1 and an n x n matrix A, (u, v) |-> row(u) A row(v)^T is additive and R-homogeneous in each argument on R^n.")
