;;; sa-norm-eigenvalue
(sp (make-wff (forall-guarded '(v t_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPACT-OP v v t_) (IS-SELF-ADJOINT-OP v t_) (NOT (= t_ (BOP-ZERO v v))))
