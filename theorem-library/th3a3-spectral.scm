;;; Library: operator-algebras.

;;; th3a3-spectral.scm -- TEOREMA 3.1 OF th-main.pdf, step (b) and (iii): a compact self-adjoint
;;; T /= 0 has ||T|| or -||T|| as an eigenvalue; every compact self-adjoint operator on a space
;;; /= {0} has an eigenvector; the eigenvectors of a compact self-adjoint operator on a Hilbert space
;;; have orthocomplement {0}.  Agent TH3-A3, wave 2026-11-09.
;;; Destination: theorem-library/th3a3-spectral.scm, after th3a3-finrank.  Library: operator-algebras.
;;; Helper prefix tqe- (the tqe- helpers of th3a3-finrank.scm and the tqa- sequence helpers of
;;; th3-compact.scm, copied: helpers do not cross file environments).  Every qed modulo 0.

;;; tqd helpers: copy of TH3-A2 tqb-helpers.scm (itself a copy of TH3-A tqa-helpers.scm) (scratchpad/th3-1109/a/), prefix tqe-.
;;; tqa helpers: copies of ba-bh2.scm's bb2- helpers (themselves copies of ba-bh.scm's bbh- and hilbert-projection.scm's hpr- kit), prefix tqe-.
(define tqe-v 'v)
(define (tqe-ip a b) (list (list 'IP tqe-v) a b))
(define (tqe-sub a b) (list (list 'VADD tqe-v) a (list (list 'VNEG tqe-v) b)))
(define (tqe-add a b) (list (list 'VADD tqe-v) a b))
(define (tqe-act c a) (list (list 'ACT tqe-v) c a))
(define (tqe-q a) (tqe-ip a a))

(define (tqe-op? e op)
  (and (pair? e) (pair? (car e)) (eq? (car (car e)) op) (equal? (cadr (car e)) tqe-v)))
(define (tqe-zero? e) (equal? e (list 'VZERO tqe-v)))

;;; land (IN e (VEC v)) for a vector term built from typed atoms
(define (tqe-vt! e)
  (let ((goal (list 'IN e (list 'VEC tqe-v))))
    (cond ((and (dk-asm? goal) (not (or (tqe-op? e 'VADD) (tqe-op? e 'VNEG) (tqe-op? e 'ACT))))
           goal)
          ((dk-asm? goal)                  ; typed: still type the parts, which the laws need
           (cond ((tqe-op? e 'VADD) (tqe-vt! (cadr e)) (tqe-vt! (caddr e)))
                 ((tqe-op? e 'VNEG) (tqe-vt! (cadr e)))
                 ((tqe-op? e 'ACT)  (tqe-ct! (cadr e)) (tqe-vt! (caddr e))))
           goal)
          ((tqe-op? e 'VADD) (tqe-vt! (cadr e)) (tqe-vt! (caddr e))
                             (dk-cite! 'cips-vadd-type tqe-v (cadr e) (caddr e)) goal)
          ((tqe-op? e 'VNEG) (tqe-vt! (cadr e))
                             (dk-cite! 'cips-vneg-type tqe-v (cadr e)) goal)
          ((tqe-op? e 'ACT)  (tqe-ct! (cadr e)) (tqe-vt! (caddr e))
                             (dk-cite! 'cips-act-type tqe-v (cadr e) (caddr e)) goal)
          ((tqe-zero? e) (dk-cite! 'cips-vzero-in tqe-v) goal)
          ((tqe-app-fun e) => (lambda (ft) (tqe-arg-t! (cadr e) (cadr (caddr ft)))
                                    (dk-cite! 'fun-apply-type-c (car e) (cadr (caddr ft)) (caddr (caddr ft)) (cadr e))
                                    goal))
          (#t (error "tqe-vt!: no typing for the vector" (expression->string e))))))

;;; an application (f a) with (IN f (FUN D (VEC v))) in context: that typing
(define (tqe-app-fun e)
  (and (pair? e) (= (length e) 2)
       (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (cadr h) (car e))
                                    (pair? (caddr h)) (eq? (car (caddr h)) 'FUN)
                                    (= (length (caddr h)) 3)
                                    (equal? (caddr (caddr h)) (list 'VEC tqe-v))))
                   (dk-asms))))
;;; type the argument a in D: by recursion when D is VEC v, else from context
(define (tqe-arg-t! a d)
  (cond ((dk-asm? (list 'IN a d)) #t)
        ((equal? d (list 'VEC tqe-v)) (tqe-vt! a))
        ((and (pair? d) (eq? (car d) 'VEC))
         (fluid-let ((tqe-v (cadr d))) (tqe-vt! a)))
        (#t (error "tqe-arg-t!: argument not typed" (expression->string (list 'IN a d))))))

;;; land (IN c CC) for a scalar term
(define (tqe-ct! c)
  (let ((goal (list 'IN c 'CC)))
    (cond ((dk-asm? goal) goal)
          ((eqv? c +i) (dk-cite! 'cc-i-in) goal)
          ((number? c) (dk-have! goal (lambda () (arith))) goal)
          ((dk-asm? (list 'IN c 'RR)) (dk-cite! 'rr-subset-cc c) goal)
          ((tqe-op? c 'IP) (tqe-vt! (cadr c)) (tqe-vt! (caddr c))
                           (dk-cite! 'cips-ip-type tqe-v (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) 'conjugate))
           (tqe-ct! (cadr c)) (dk-cite! 'cc-conjugate-closed (cadr c)) goal)
          ((and (pair? c) (memq (car c) '(* +)) (= (length c) 3))
           (tqe-ct! (cadr c)) (tqe-ct! (caddr c))
           (tqe-have-and! (list 'IN (cadr c) 'CC) (list 'IN (caddr c) 'CC))
           (dk-cite! (if (eq? (car c) '*) 'cc-mul-closed 'cc-add-closed) (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 3))
           (tqe-ct! (cadr c)) (tqe-ct! (caddr c))
           (dk-cite! 'cc-sub-in-cc (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 2))
           (tqe-ct! (cadr c)) (dk-cite! 'cc-neg-closed (cadr c)) goal)
          (#t (dk-have! goal (lambda () (type-term))) goal))))

;;; the first inner-product term in E (preorder) with a compound argument
(define (tqe-find-redex e)
  (cond ((not (pair? e)) #f)
        ((and (tqe-op? e 'IP) (= (length e) 3)
              (or (tqe-compound? (cadr e)) (tqe-compound? (caddr e))))
         e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((tqe-find-redex (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
(define (tqe-compound? e)
  (or (tqe-op? e 'VADD) (tqe-op? e 'VNEG) (tqe-op? e 'ACT) (tqe-zero? e)))

;;; the law instance that opens the redex <a, b>
(define (tqe-open-law! r)
  (let ((a (cadr r)) (b (caddr r)))
    (tqe-vt! a) (tqe-vt! b)
    (cond ((tqe-op? a 'VADD) (dk-cite! 'cips-ip-add-left tqe-v (cadr a) (caddr a) b))
          ((tqe-op? a 'VNEG) (dk-cite! 'cips-ip-neg-left tqe-v (cadr a) b))
          ((tqe-op? a 'ACT)  (dk-cite! 'cips-ip-homog-left tqe-v (cadr a) (caddr a) b))
          ((tqe-zero? a)     (dk-cite! 'cips-ip-zero-left tqe-v b))
          ((tqe-op? b 'VADD) (dk-cite! 'cips-ip-add-right tqe-v a (cadr b) (caddr b)))
          ((tqe-op? b 'VNEG) (dk-cite! 'cips-ip-neg-right tqe-v a (cadr b)))
          ((tqe-op? b 'ACT)  (dk-cite! 'cips-ip-conj-homog-right tqe-v (cadr b) a (caddr b)))
          ((tqe-zero? b)     (dk-cite! 'cips-ip-zero-right tqe-v a))
          (#t (error "tqe-open-law!: not a redex" (expression->string r))))))

;;; a conjugate that can be pushed inwards: of a real (a numeral, or typed RR
;;; in context), of a product, sum, negation or conjugate, of an inner product
(define (tqe-conj-redex? e)
  (and (pair? e) (eq? (car e) 'conjugate) (= (length e) 2)
       (let ((x (cadr e)))
         (or (number? x) (dk-asm? (list 'IN x 'RR))
             (and (pair? x) (memq (car x) '(* + conjugate)))
             (and (pair? x) (eq? (car x) '-) (= (length x) 2))
             (and (tqe-op? x 'IP) (= (length x) 3))))))
(define (tqe-find-real-conj e)
  (cond ((not (pair? e)) #f)
        ((tqe-conj-redex? e) e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((tqe-find-real-conj (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))

;;; EXPAND the goal: every inner product of a constructed vector is opened by
;;; its law (first argument first), and every conjugate of a real is dropped,
;;; until the goal is a polynomial in inner products of ATOMS.  Loops on a redex
;;; test, never on a count.
(define (tqe-expand!)
  (let loop ((fuel 200))
    (if (<= fuel 0) (error "tqe-expand!: out of fuel"))
    (let ((r (tqe-find-redex (dk-goal))))
      (if r
          (let ((eq (tqe-open-law! r)))
            (subst eq)
            (loop (- fuel 1)))
          (let ((c (tqe-find-real-conj (dk-goal))))
            (if c
                (begin
                  (tqe-push-conj! c)
                  (loop (- fuel 1)))))))))

;;; one step of pushing a conjugate inwards
(define (tqe-push-conj! c)
  (let ((x (cadr c)))
    (cond ((or (number? x) (dk-asm? (list 'IN x 'RR)))
           (if (number? x) (dk-have! (list 'IN x 'RR) (lambda () (arith))))
           (subst (dk-cite! 'cc-conjugate-fixes-rr x)))
          ((tqe-op? x 'IP)
           (tqe-vt! (cadr x)) (tqe-vt! (caddr x))
           (dk-cite! 'cips-ip-conj-sym tqe-v (cadr x) (caddr x))
           (subst (list '= c (tqe-ip (caddr x) (cadr x)))))
          ((eq? (car x) 'conjugate)
           (tqe-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-involution (cadr x))))
          ((eq? (car x) '-)
           (tqe-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-neg (cadr x))))
          (#t
           (tqe-ct! (cadr x)) (tqe-ct! (caddr x))
           (tqe-have-and! (list 'IN (cadr x) 'CC) (list 'IN (caddr x) 'CC))
           (subst (dk-cite! (if (eq? (car x) '*) 'cc-conjugate-mul 'cc-conjugate-add)
                            (cadr x) (caddr x)))))))

;;; with (IN a RR) and (0 <= a) in context: land (IN (SQRT a) RR), 0 <= SQRT(a)
;;; and SQRT(a) * SQRT(a) = a
(define (tqe-sqrt! a)
  (if (not (dk-asm? (list 'IN (list 'SQRT a) 'RR)))
      (begin
        (dk-have! (list 'AND (list 'IN a 'RR) (list '<= 0 a)))
        (dk-split! (dk-cite! 'sqrt-nonneg a))
        (dk-cite! 'sqrt-sq a))))

;;; <u,u> is real and nonnegative
(define (tqe-q-facts! u)
  (tqe-vt! u)
  (dk-cite! 'cips-ip-self-real tqe-v u)
  (dk-cite! 'cips-ip-self-nonneg tqe-v u))

;;; rewrite ||u|| * ||u|| in the goal to <u, u>
(define (tqe-norm-sq! u)
  (tqe-vt! u)
  (subst (dk-cite! 'ip-norm-unfold tqe-v u))
  (tqe-q-facts! u)
  (tqe-sqrt! (tqe-q u))
  (subst (dk-cite! 'sqrt-sq (tqe-q u))))
(define (tqe-nsq u) (list '* (list 'IP-NORM tqe-v u) (list 'IP-NORM tqe-v u)))

;;; an IFF instance used forwards: cite THM at ARGS, land its right side (split)
(define (tqe-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))

;;; an IFF instance used backwards: its right side's conjuncts are in context;
;;; land the left side and return it
(define (tqe-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))

;;; the right-nested conjunction of FS, landed from its conjuncts in context
(define (tqe-and fs)
  (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (tqe-and (cdr fs)))))
(define (tqe-have-and! . fs)
  (let ((c (tqe-and fs)))
    (dk-have! c (lambda () (dk-conj-close! dk-ass!)))
    c))

;;; type every inner product of atoms in the goal (crs wants its atoms in CC)
(define (tqe-type-ips! e)
  (cond ((not (pair? e)) #t)
        ((tqe-op? e 'IP) (tqe-ct! e))
        ((and (eq? (car e) 'conjugate) (= (length e) 2)) (tqe-ct! e))
        (#t (for-each tqe-type-ips! e))))

(define (tqe-qd p xi) (tqe-q (tqe-sub p xi)))
(define (tqe-vec-eq! a b)
  (let ((goal (list '= a b)))
    (if (not (dk-asm? goal))
        (begin
          (tqe-vt! a) (tqe-vt! b)
          (dk-have! (list '= (tqe-qd a b) 0)
            (lambda () (tqe-expand!) (tqe-type-ips! (dk-goal)) (crs)))
          (dk-cite! 'cips-eq-of-dist-sq-zero tqe-v a b)))
    goal))

;;; Q(A) = Q(B) for two expressions of one vector, by expansion
(define (tqe-q-eq! a b)
  (let ((goal (list '= (tqe-q a) (tqe-q b))))
    (if (not (dk-asm? goal))
        (begin (tqe-vt! a) (tqe-vt! b)
               (dk-have! goal (lambda () (tqe-expand!) (tqe-type-ips! (dk-goal)) (crs)))))
    goal))

;;; ---- BA-BH additions -------------------------------------------------------------------
;;; qed, or a dump of the open leaves and an error
(define (tqe-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** TQD: ") (display name) (display " did NOT close.  Open leaves:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "TQD: unfinished" name
               (map (lambda (l) (expression->string (dk-goal-of l))) (dk-open-leaves))
               (map expression->string (dk-asms-of (car (dk-open-leaves))))))))
;;; dump the focus leaf (debugging)
(define (tqe-show! tag)
  (display "\n--- TQD ") (display tag) (display " GOAL: ") (display (expression->string (dk-goal))) (newline)
  (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline)) (dk-asms)))
;;; x in ks, ks a submodule of v: x in VEC v
(define (tqe-sub! ks x)
  (dk-cite! 'submodule-subset tqe-v ks)
  (dk-cite! 'subset-mem-fwd ks (list 'VEC tqe-v) x))
;;; c in CC => c in CARR(SCAL v)
(define (tqe-scal! c)
  (dk-cite! 'cips-scal-carrier tqe-v)
  (dk-have! (list 'IN c (list 'CARR (list 'SCAL tqe-v)))
            (lambda () (subst (list '= (list 'CARR (list 'SCAL tqe-v)) 'CC)) (ass))))

;;; ---- from ba-bh.scm parts 2-5 (prefix tqe-) -----------------------------------------------
(define tqe-w 'w)
(define (tqe-n u) (list 'IP-NORM tqe-v u))
(define (tqe-ipv a b) (list '(IP v) a b))
(define (tqe-ipw a b) (list '(IP w) a b))
(define (tqe-mul-in! u w2)
  (dk-have! (list 'AND (list 'IN u 'RR) (list 'IN w2 'RR)) (lambda () (dk-conj-close! dk-ass!)))
  (dk-cite! 'rr-mul-closed u w2))
(define (tqe-prod? t) (and (pair? t) (eq? (car t) '*) (= (length t) 3)
                           (not (number? (cadr t))) (not (number? (caddr t)))))
(define (tqe-prods e)
  (cond ((tqe-prod? e) (list e))
        ((and (pair? e) (memq (car e) '(<= < = + -))) (append-map tqe-prods (cdr e)))
        (#t '())))
(define (tqe-mul-type! p)
  (if (not (dk-asm? (list 'IN p 'RR)))
      (begin
        (if (tqe-prod? (cadr p)) (tqe-mul-type! (cadr p)))
        (if (tqe-prod? (caddr p)) (tqe-mul-type! (caddr p)))
        (dk-cite! 'rr-mul-in-rr (cadr p) (caddr p)))))
;;; (tqe-lin! TYPINGS PREMS): every product in PREMS and in the GOAL named, then dk-ineq!
(define (tqe-lin! typings prems)
  (let* ((ps (let loop ((l (append (append-map tqe-prods prems) (tqe-prods (dk-goal)))) (acc '()))
               (cond ((null? l) (reverse acc)) ((member (car l) acc) (loop (cdr l) acc))
                     (#t (loop (cdr l) (cons (car l) acc))))))
         (names (map (lambda (p)
                       (tqe-mul-type! p)
                       (cons p (dk-name! p)))
                     ps))
         (new (map (lambda (f)
                     (let loop ((f f) (ns names))
                       (cond ((null? ns) f)
                             ((dk-contains? f (caar ns)) (loop (dk-rewrite-h! f (caar ns) (cdar ns)) (cdr ns)))
                             (#t (loop f (cdr ns))))))
                   prems)))
    (for-each (lambda (n) (if (dk-contains? (dk-goal) (car n)) (subst (list '= (car n) (cdr n))))) names)
    (apply dk-ineq! (append typings (map (lambda (n) (list 'IN (cdr n) 'RR)) names) new))))
;;; the least-bound clause of opnorm-spec for T (spec split into context first)
(define (tqe-least t)
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'd_) (dk-contains? h t)
                            (dk-contains? h 'OPNORM)))
           "the least-bound clause"))
;;; the bound clause  forall x in VEC v. ||t x|| <= d ||x||
(define (tqe-ub v w t d)
  (list 'FORALL 'box_ (list 'IMPLIES (list 'IN 'box_ (list 'VEC v))
     (list '<= (list 'IP-NORM w (list t 'box_)) (list '* d (list 'IP-NORM v 'box_))))))
;;; ||x|| typed and nonnegative
(define (tqe-nt! v x) (dk-cite! 'ip-norm-in-rr v x) (dk-cite! 'ip-norm-nonneg v x))
;;; debugging: dump every open leaf (goal + context)
(define (tqe-dump! tag)
  (display "\n=== TQD DUMP ") (display tag) (newline)
  (for-each (lambda (l)
              (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
              (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                        (dk-asms-of l)))
            (dk-open-leaves)))
;;; run THUNK; on an error print the condition and dump, then re-raise
(define (tqe-try tag thunk)
  (call-with-current-continuation
    (lambda (k)
      (with-exception-handler
        (lambda (e)
          (display "\n*** TQD ERROR in ") (display tag) (display ": ")
          (display (if (condition? e) (condition/report-string e) e)) (newline)
          (tqe-dump! tag)
          (k (error "TQD stop" tag (if (condition? e) (condition/report-string e) e)
                    (if (pair? (dk-open-leaves)) (expression->string (dk-goal)) "no open leaf"))))
        thunk))))

;;; ---- TH3-A2 additions ----------------------------------------------------------------------
;;; the focus goal is (= a a) / (== a a)
(define (tqe-trivial-goal?)
  (and (pair? (dk-open-leaves))
       (let ((g (dk-goal)))
         (and (pair? g) (memq (car g) '(= ==)) (= (length g) 3) (equal? (cadr g) (caddr g))))))
(define (tqe-rfl-trivial!) (if (tqe-trivial-goal?) (rfl)))

;;; (C6-H) sequence helpers, copied from th3-compact.scm (tqe- -> tqe-): typing applications, beta-closing
;;; pointwise equations, typing lambda sequences, the pointwise compactness clause.
(define (tqe-M w) (list 'IP-METRIC-SPACE w))
;;; land (IN b (FUN NN (PTS M_w))) / (IN x (PTS M_w)) from the VEC typing
(define (tqe-pts-fun! w b)
  (let ((g (list 'IN b (list 'FUN 'NN (list 'PTS (tqe-M w))))))
    (if (not (dk-asm? g))
        (begin (dk-cite! 'ip-metric-space-pts w)
               (dk-have! g (lambda () (subst (list '= (list 'PTS (tqe-M w)) (list 'VEC w))) (ass)))))
    g))
(define (tqe-pts-pt! w x)
  (let ((g (list 'IN x (list 'PTS (tqe-M w)))))
    (if (not (dk-asm? g))
        (begin (dk-cite! 'ip-metric-space-pts w)
               (dk-have! g (lambda () (subst (list '= (list 'PTS (tqe-M w)) (list 'VEC w))) (ass)))))
    g))
;;; the converse: (IN b (FUN NN (VEC w))) from the PTS typing, (IN x (VEC w)) likewise
(define (tqe-vec-fun! w b)
  (let ((g (list 'IN b (list 'FUN 'NN (list 'VEC w)))))
    (if (not (dk-asm? g))
        (begin (dk-cite! 'ip-metric-space-pts w)
               (dk-have! g (lambda () (subst (list '= (list 'VEC w) (list 'PTS (tqe-M w)))) (ass)))))
    g))
(define (tqe-vec-pt! w x)
  (let ((g (list 'IN x (list 'VEC w))))
    (if (not (dk-asm? g))
        (begin (dk-cite! 'ip-metric-space-pts w)
               (dk-have! g (lambda () (subst (list '= (list 'VEC w) (list 'PTS (tqe-M w)))) (ass)))))
    g))
;;; the k-th term of b typed in VEC w, from b in FUN(NN, VEC w) and k in NN
(define (tqe-seq-t! w b k)
  (dk-cite! 'fun-apply-type-c b 'NN (list 'VEC w) k))
(define (tqe-has-redex? e)
  (and (pair? e)
       (or (and (pair? (car e)) (eq? (car (car e)) 'VNB-LAMBDA))
           (and (not (eq? (car e) 'VNB-LAMBDA)) (any (lambda (x) (tqe-has-redex? x)) e)))))
;;; land (IN e C) for an application (h a) with (IN h (FUN D C)) in context, typing a first
(define (tqe-vop? e op) (and (pair? e) (pair? (car e)) (eq? (car (car e)) op) (= (length (car e)) 2)))
(define (tqe-app-t! e)
  (cond ((not (pair? e)) #f)
        ((and (tqe-vop? e 'ACT) (= (length e) 3))
         (let ((sp (cadr (car e))))
           (tqe-app-t! (cadr e)) (tqe-app-t! (caddr e))
           (if (and (not (dk-asm? (list 'IN (cadr e) 'CC))) (dk-asm? (list 'IN (cadr e) 'RR)))
               (dk-cite! 'rr-subset-cc (cadr e)))
           (if (and (not (dk-asm? (list 'IN e (list 'VEC sp))))
                    (dk-asm? (list 'IN (cadr e) 'CC)) (dk-asm? (list 'IN (caddr e) (list 'VEC sp))))
               (dk-cite! 'cips-act-type sp (cadr e) (caddr e)))
           (list 'VEC sp)))
        ((and (tqe-vop? e 'VADD) (= (length e) 3))
         (let ((sp (cadr (car e))))
           (tqe-app-t! (cadr e)) (tqe-app-t! (caddr e))
           (if (and (not (dk-asm? (list 'IN e (list 'VEC sp))))
                    (dk-asm? (list 'IN (cadr e) (list 'VEC sp))) (dk-asm? (list 'IN (caddr e) (list 'VEC sp))))
               (dk-cite! 'cips-vadd-type sp (cadr e) (caddr e)))
           (list 'VEC sp)))
        ((and (tqe-vop? e 'VNEG) (= (length e) 2))
         (let ((sp (cadr (car e))))
           (tqe-app-t! (cadr e))
           (if (and (not (dk-asm? (list 'IN e (list 'VEC sp)))) (dk-asm? (list 'IN (cadr e) (list 'VEC sp))))
               (dk-cite! 'cips-vneg-type sp (cadr e)))
           (list 'VEC sp)))
        ((and (symbol? (car e)) (= (length e) 2))
         (let ((ft (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (cadr h) (car e))
                                                (pair? (caddr h)) (eq? (car (caddr h)) 'FUN)
                                                (= (length (caddr h)) 3)))
                               (dk-asms))))
           (if ft
               (let ((d (cadr (caddr ft))) (c (caddr (caddr ft))))
                 (tqe-app-t! (cadr e))
                 (if (dk-asm? (list 'IN e c)) c
                     (if (dk-asm? (list 'IN (cadr e) d))
                         (begin (dk-cite! 'fun-apply-type-c (car e) d c (cadr e)) c)
                         #f)))
               #f)))
        (#t #f)))
;;; type every symbol-headed application in E (not under a VNB-LAMBDA)
(define (tqe-type-apps! e)
  (cond ((not (pair? e)) #t)
        ((eq? (car e) 'VNB-LAMBDA) #t)
        (#t (for-each tqe-type-apps! e) (tqe-app-t! e))))
;;; close an equation goal by beta and reflexivity, typing as needed
(define (tqe-beta-close!)
  (tqe-type-apps! (dk-goal))
  (let ((done (if (tqe-has-redex? (dk-goal)) (dk-lam-b!) #f)))
    (if (not done)
        (begin (tqe-type-apps! (dk-goal))
               (if (tqe-has-redex? (dk-goal)) (set! done (dk-lam-b!)))
               (if (not done) (begin (tqe-type-apps! (dk-goal)) (rfl)))))))
;;; (FORALL nq_ (IMPLIES (IN nq_ NN) (= (b nq_) RHS(nq_)))) landed, PRE run after the peel
(define (tqe-ptw! b rhs-of pre)
  (let ((f (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN) (list '= (list b 'nq_) (rhs-of 'nq_))))))
    (dk-have! f (lambda () (let ((k (dk-di-var!))) (pre k) (tqe-beta-close!))))
    f))
;;; type a lambda sequence into FUN(NN, C)
(define (tqe-lam-t! lam c)
  (let ((g (list 'IN lam (list 'FUN 'NN c))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (dk-lam-type!
              (lambda () (let ((k (dk-di-var!)))
                           (tqe-type-apps! (dk-goal))
                           (if (tqe-has-redex? (dk-goal)) (dk-lam-b!))
                           (tqe-type-apps! (dk-goal)) (ass)))
              (lambda () (fact 'nn-is-set) (ass))))))
    g))
;;; compact-op-seq at (v w t f): skolemised; returns (phi lim U)
(define (tqe-seq! v w t f)
  (let* ((ex (dk-cite! 'compact-op-seq v w t f))
         (phi (dk-skolem! ex))
         (ex2 (dk-pick (lambda (x) (and (dk-head-is? x 'FORSOME) (memq phi (free-vars x)))) "the limit"))
         (lim (dk-skolem! ex2))
         (u (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (memq lim (free-vars x)))) "the limit clause")))
    (tqe-iff-fwd! 'strictly-mono-nn phi)
    (list phi lim u)))
;;; U applied to the lambda sequence LAM whose n-th term is RHS(n): CONVERGES-TO landed
(define (tqe-use-u! u lam rhs-of pre c)
  (tqe-lam-t! lam c)
  (tqe-ptw! lam rhs-of pre)
  (dk-apply! u lam))
;;; the clause of compact-op-intro, proved by BODY run on (f . bound) after the peel
;;; with (CONVERGES-TO M_w seq lim) in context: land (IN lim (VEC w))
(define (tqe-lim-t! w seq lim)
  (dk-have! (list 'IN lim (list 'PTS (tqe-M w)))
    (lambda () (tqe-iff-fwd! 'converges-to (tqe-M w) seq lim) (ass)))
  (tqe-vec-pt! w lim))


;;; ==========================================================================================
;;; (C4) THE OPERATOR NORM IS APPROACHED ON THE UNIT BALL: for e > 0 there is x with
;;; ||x|| <= 1 and ||T|| - e < ||T x||.  Library: operator-algebras.
;;; Proof: otherwise ||T x|| <= (||T|| - e) ||x|| for every x (normalise x /= 0 by
;;; recip ||x||), and the least-bound clause of opnorm-spec gives ||T|| <= ||T|| - e.
;;; ==========================================================================================

(define (tqe-and2! a b) (tqe-have-and! a b))

(sp (make-wff (forall-guarded '(v w t_ e_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN t_ (BOUNDED-OPS v w)) (IN e_ RR) (< 0 e_))
  '(FORSOME tqex_ (AND (IN tqex_ (VEC v)) (AND (<= (IP-NORM v tqex_) 1) (< (- (OPNORM v w t_) e_) (IP-NORM w (t_ tqex_)))))))))
(dk-peel!)
(tqe-try "approx" (lambda ()
(let* ((nn '(OPNORM v w t_))
       (d (list '- nn 'e_))
       (gl (dk-goal)))
  (dk-split-all! (list (dk-cite! 'opnorm-spec 'v 'w 't_)))
  (dk-cite! 'bop-fun 'v 'w 't_)
  (dk-cite! 'cips-vzero-in 'v)
  (dk-cite! 'cips-vzero-in 'w)
  (dk-have! (list 'IN d 'RR) (lambda () (mac 'binary-minus-def) (type-term)))
  (let ((least (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'd_))) "the least-bound clause")))
    (use-em (list '< d 0)
      ;; d < 0: the zero vector is a witness
      (lambda ()
        (witness! '(VZERO v)
          (lambda ()
            (subst (dk-cite! 'bop-zero-value 'v 'w 't_))
            (subst (dk-cite! 'ip-norm-zero 'v))
            (subst (dk-cite! 'ip-norm-zero 'w))
            (dk-conj-close!
              (lambda ()
                (cond ((dk-asm? (dk-goal)) (ass))
                      ((dk-head-is? (dk-goal) '<=) (arith))
                      (#t (dk-ineq! (list '< d 0)))))))))
      ;; 0 <= d: by contradiction
      (lambda ()
        (dk-have! '(IN 0 RR) (lambda () (arith)))
        (dk-cite! 'rr-not-lt-ge d 0)
        (pbc)
        (let ((notex (dk-pick (lambda (h) (and (dk-head-is? h 'NOT) (dk-head-is? (cadr h) 'FORSOME))) "the negated goal")))
          ;; the bound clause at d
          (dk-have! (list 'FORALL 'box_ (list 'IMPLIES '(IN box_ (VEC v))
                      (list '<= (list 'IP-NORM 'w (list 't_ 'box_)) (list '* d '(IP-NORM v box_)))))
            (lambda ()
              (let* ((x (dk-di-var!))
                     (n (list 'IP-NORM 'v x))
                     (p (list 'IP-NORM 'w (list 't_ x))))
                (tqe-nt! 'v x)
                (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) x)
                (tqe-nt! 'w (list 't_ x))
                (use-em (list '= x '(VZERO v))
                  (lambda ()
                    (subst (list '= x '(VZERO v)))
                    (subst (dk-cite! 'bop-zero-value 'v 'w 't_))
                    (subst (dk-cite! 'ip-norm-zero 'v))
                    (subst (dk-cite! 'ip-norm-zero 'w))
                    (dk-ineq!))
                  (lambda ()
                    (dk-have! (list 'NOT (list '= n 0))
                      (lambda () (di) (dk-cite! 'ip-norm-zero-vector 'v x) (ai (list 'NOT (list '= x '(VZERO v))))))
                    (dk-have! (list 'NOT (list '= 0 n)) (lambda () (di) (dk-have! (list '= n 0) (lambda () (subst (list '= n 0)) (dk-close-if! (lambda () #t) (lambda () (arith))))) (ai (list 'NOT (list '= n 0)))))
                    (tqe-and2! (list '<= 0 n) (list 'NOT (list '= 0 n)))
                    (dk-have! '(IN 0 RR) (lambda () (arith)))
                    (dk-cite! 'rr-le-ne-lt 0 n)
                    (tqe-and2! (list 'IN n 'RR) (list 'NOT (list '= n 0)))
                    (let* ((c (list 'recip n))
                           (xp (list '(ACT v) c x)))
                      (dk-cite! 'rr-recip-closed n)
                      (dk-cite! 'rr-recip-pos n)
                      (dk-cite! 'rr-recip-inverse n)
                      (dk-cite! 'rr-subset-cc c)
                      (dk-cite! 'cips-act-type 'v c x)
                      (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) xp)
                      (dk-have! (list '<= 0 c) (lambda () (dk-ineq! (list '< 0 c))))
                      (let* ((mg (dk-cite! 'rr-magnitude-is-abs c))
                             (ab (dk-cite! 'rr-abs-of-nonneg c))
                             (nxp (have-f! (list '= (list 'IP-NORM 'v xp) (list '* c n))
                                    (lambda ()
                                      (subst (dk-cite! 'ip-norm-act 'v c x))
                                      (subst mg) (subst ab)
                                      (dk-close-if! (lambda () #t) (lambda () (rfl))))))
                             (ptx (have-f! (list '= (list 'IP-NORM 'w (list 't_ xp)) (list '* c p))
                                    (lambda ()
                                      (subst (dk-cite! 'bop-act 'v 'w 't_ c x))
                                      (subst (dk-cite! 'ip-norm-act 'w c (list 't_ x)))
                                      (subst mg) (subst ab)
                                      (dk-close-if! (lambda () #t) (lambda () (rfl)))))))
                        (dk-cite! 'rr-mul-in-rr c n)
                        (dk-cite! 'rr-mul-in-rr c p)
                        (tqe-and2! (list 'IN c 'RR) (list 'IN n 'RR))
                        (dk-have! (list '= (list '* c n) 1)
                          (lambda () (subst (dk-cite! 'rr-mul-comm c n)) (dk-close-if-asm!)))
                        ;; ||T x'|| <= d, else x' is a witness
                        (use-em (list '< d (list 'IP-NORM 'w (list 't_ xp)))
                          (lambda ()
                            (pbc)
                            (dk-have! (cadr notex)
                              (lambda ()
                                (witness! xp
                                  (lambda ()
                                    (dk-conj-close!
                                      (lambda ()
                                        (cond ((dk-asm? (dk-goal)) (ass))
                                              ((dk-head-is? (dk-goal) '<=)
                                               (subst nxp) (subst (list '= (list '* c n) 1)) (arith))
                                              (#t (dk-close-if-asm!)))))))))
                            (ai notex))
                          (lambda ()
                            (tqe-nt! 'w (list 't_ xp))
                            (dk-cite! 'rr-not-lt-ge d (list 'IP-NORM 'w (list 't_ xp)))
                            (let* ((le1 (have-f! (list '<= (list '* c p) d) (lambda () (subst (list '= (list '* c p) (list 'IP-NORM 'w (list 't_ xp)))) (dk-close-if-asm!))))
                                   (le2 (dk-cite! 'rr-mul-le-right (list '* c p) d n))
                                   (cn (dk-cite! 'rr-recip-cancel-right p n)))
                              (tqe-and2! (list 'IN p 'RR) (list 'IN c 'RR))
                              (dk-cite! 'rr-mul-comm p c)
                              (let ((cn2 (dk-rewrite-h! cn (list '* p c) (list '* c p))))
                                (tqe-lin! (list (list 'IN p 'RR) (list 'IN n 'RR) (list 'IN d 'RR) (list 'IN c 'RR))
                                          (list le2 cn2)))))))))))))
          (let ((nd (dk-apply! least d)))
            (dk-absurd! nd '(< 0 e_))))))))))
(tqe-qed! 'opnorm-approx)

;;; ==========================================================================================
;;; (C5) THE DEFECT BOUND for a maximising vector: T self-adjoint, N = ||T||, lam = N^2,
;;; ||x|| <= 1, r, k >= 0 with (2 N lam) k <= 1 and N - r^2 k < ||T x||  ==>
;;;     || T T x - lam x || <= r.
;;; From sa-approx-eigen-estimate: ||u||^2 <= lam (lam - ||Tx||^2) = lam (N - p)(N + p)
;;; <= lam (r^2 k)(2 N) <= r^2.  Library: operator-algebras.
;;; ==========================================================================================

(define tqe-N '(OPNORM v v t_))
(define tqe-lam (list '* tqe-N tqe-N))
(define (tqe-defect x) (list '(VADD v) (list 't_ (list 't_ x)) (list '(VNEG v) (list '(ACT v) tqe-lam x))))
(define tqe-C (list '* (list '* (list '* 2 tqe-N) tqe-lam) 'k_))

(sp (make-wff (forall-guarded '(v t_ x_ r_ k_)
  (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) '(IS-SELF-ADJOINT-OP v t_) '(IN x_ (VEC v)) '(<= (IP-NORM v x_) 1)
        '(IN r_ RR) '(<= 0 r_) '(IN k_ RR) '(<= 0 k_) (list '<= tqe-C 1)
        (list '< (list '- tqe-N '(* (* r_ r_) k_)) '(IP-NORM v (t_ x_))))
  (list '<= (list 'IP-NORM 'v (tqe-defect 'x_)) 'r_))))
(dk-peel!)
(tqe-try "defect" (lambda ()
(let* ((n tqe-N) (lam tqe-lam)
       (tx '(t_ x_))
       (p (list 'IP-NORM 'v tx))
       (nx '(IP-NORM v x_))
       (rr2 '(* r_ r_))
       (e (list '* rr2 'k_))
       (a (list '- n p)) (b (list '+ n p))
       (n2 (list '* 2 n))
       (q (list '* a b)) (w2 (list '* n2 e))
       (u (tqe-defect 'x_)))
  (tqe-iff-fwd! 'is-self-adjoint-op 'v 't_)
  (dk-cite! 'bop-fun 'v 'v 't_)
  (dk-cite! 'opnorm-in-rr 'v 'v 't_)
  (dk-cite! 'opnorm-nonneg 'v 'v 't_)
  (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) 'x_)
  (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) tx)
  (tqe-nt! 'v tx) (tqe-nt! 'v 'x_)
  (dk-have! '(IN 1 RR) (lambda () (arith)))
  (dk-have! '(IN 2 RR) (lambda () (arith)))
  (dk-cite! 'rr-mul-in-rr n n)
  (dk-cite! 'rr-sq-nonneg n)
  (dk-cite! 'rr-mul-in-rr 'r_ 'r_)
  (dk-cite! 'rr-sq-nonneg 'r_)
  (dk-cite! 'rr-mul-in-rr rr2 'k_)
  (tqe-have-and! (list 'IN rr2 'RR) '(IN k_ RR))
  (tqe-have-and! (list '<= 0 rr2) '(<= 0 k_))
  (dk-cite! 'rr-leq-mul-nonneg rr2 'k_)
  (dk-cite! 'rr-mul-in-rr 2 n)
  (let* ((est0 (dk-cite! 'sa-approx-eigen-estimate 'v 't_ 'x_))
         (e2 (dk-cite! 'ip-norm-sq 'v tx))
         (est (dk-rewrite-h! est0 (caddr e2) (cadr e2)))
         (ob (dk-apply! (dk-cite! 'opnorm-bound 'v 'v 't_) 'x_))
         (m1 (dk-cite! 'rr-mul-le-right nx 1 n)))
    (dk-cite! 'rr-mul-in-rr n nx) (dk-cite! 'rr-mul-in-rr nx n) (dk-cite! 'rr-mul-in-rr 1 n)
    (dk-have! (list '= (list '* n nx) (list '* nx n)) (lambda () (crs)))
    (dk-have! (list '= (list '* 1 n) n) (lambda () (crs)))
    (dk-have! (list '<= p n)
      (lambda () (tqe-lin! (list (list 'IN p 'RR) (list 'IN n 'RR) (list 'IN nx 'RR))
                           (list ob m1 (list '= (list '* n nx) (list '* nx n)) (list '= (list '* 1 n) n)))))
    (dk-have! (list 'IN a 'RR) (lambda () (mac 'binary-minus-def) (type-term)))
    (dk-have! (list 'IN b 'RR) (lambda () (type-term)))
    (dk-have! (list '<= a e) (lambda () (dk-ineq! (list '< (list '- n e) p))))
    (dk-have! (list '<= 0 b) (lambda () (dk-ineq! (list '<= 0 n) (list '<= 0 p))))
    (dk-have! (list '<= b n2) (lambda () (dk-ineq! (list '<= p n))))
    (let* ((e4 (dk-cite! 'rr-mul-le-right a e b))
           (e5 (dk-cite! 'rr-mul-le-right b n2 e)))
      (dk-cite! 'rr-mul-in-rr e b) (dk-cite! 'rr-mul-in-rr b e)
      (dk-have! (list '= (list '* e b) (list '* b e)) (lambda () (crs)))
      (dk-cite! 'rr-mul-in-rr a b) (dk-cite! 'rr-mul-in-rr n2 e)
      (dk-have! (list '<= q w2)
        (lambda () (tqe-lin! (list (list 'IN e 'RR) (list 'IN b 'RR) (list 'IN a 'RR))
                             (list e4 e5 (list '= (list '* e b) (list '* b e))))))
      (let* ((e8 (dk-cite! 'rr-mul-le-right q w2 lam)))
        (dk-cite! 'rr-mul-in-rr lam lam) (dk-cite! 'rr-mul-in-rr p p) (dk-cite! 'rr-mul-in-rr lam (list '* p p))
        (dk-cite! 'rr-mul-in-rr q lam) (dk-cite! 'rr-mul-in-rr w2 lam)
        (dk-cite! 'rr-mul-in-rr n2 lam)
        (dk-cite! 'rr-mul-in-rr (list '* n2 lam) 'k_)
        (dk-cite! 'rr-mul-in-rr tqe-C rr2)
        (dk-cite! 'rr-mul-in-rr 1 rr2)
        (let* ((e3 (have-f! (list '= (list '- (list '* lam lam) (list '* lam (list '* p p))) (list '* q lam)) (lambda () (crs))))
               (e10 (have-f! (list '= (list '* w2 lam) (list '* tqe-C rr2)) (lambda () (crs))))
               (e11 (dk-cite! 'rr-mul-le-right tqe-C 1 rr2))
               (e12 (have-f! (list '= (list '* 1 rr2) rr2) (lambda () (crs)))))
          (tqe-q-facts! u)
          (let ((uu (tqe-q u)))
            (dk-have! (list '<= uu rr2)
              (lambda () (tqe-lin! (list (list 'IN uu 'RR) (list 'IN lam 'RR) (list 'IN p 'RR))
                                   (list est e3 e8 e10 e11 e12))))
            (tqe-nt! 'v u)
            (let* ((nu (list 'IP-NORM 'v u))
                   (e13 (dk-cite! 'ip-norm-sq 'v u)))
              (dk-cite! 'rr-mul-in-rr nu nu)
              (dk-have! (list '<= (list '* nu nu) rr2) (lambda () (subst e13) (dk-close-if-asm!)))
              (dk-cite! 'rr-le-of-sq-le nu 'r_)
              (dk-close-if-asm!))))))))))
(tqe-qed! 'sa-max-defect-bound)

;;; ==========================================================================================
;;; (C6) A COMPACT SELF-ADJOINT T /= 0 HAS ||T|| OR -||T|| AS AN EIGENVALUE (step (b) of the
;;; proof of Teorema 3.1).  Library: operator-algebras.
;;; Route (TH3-A2 finding 2): choose x_n with ||x_n|| <= 1, ||T|| - r_n^2 k < ||T x_n|| and
;;; ||T|| < 2 ||T x_n|| (r_n = 1/(n+1), k = 1/(2 N^3 + 1)); by compactness b = T x_phi -> y; the
;;; defect bound (c5) gives ||T T x_phi(n) - N^2 x_phi(n)|| <= r_phi(n) -> 0, so N^2 x_phi -> T y,
;;; and T(N^2 x_phi) = N^2 b -> N^2 y: T T y = N^2 y (metric-limit-unique); y /= 0 since
;;; ||b_n|| > N/2; sq-eigen-split concludes.
;;; ==========================================================================================

(define (tqe-r m) (list 'recip (list '+ m 1)))
(define (tqe-ep m k) (list '* (list '* (tqe-r m) (tqe-r m)) k))
(define (tqe-P m w k)
  (list 'AND (list '<= (list 'IP-NORM 'v w) 1)
    (list 'AND (list '< (list '- tqe-N (tqe-ep m k)) (list 'IP-NORM 'v (list 't_ w)))
               (list '< tqe-N (list '* 2 (list 'IP-NORM 'v (list 't_ w)))))))
;;; m in NN in context: recip(m + 1) in RR and 0 < recip(m + 1)
(define (tqe-r-t! m)
  (let ((r (tqe-r m)))
    (dk-cite! 'nn-recip-succ-pos m)
    (dk-cite! 'rr-pos-rr-in-rr r)
    (dk-cite! 'rr-lt-of-pos-rr r)))
;;; m in NN, k in RR, 0 < k in context: ep_m(k) typed and positive
(define (tqe-ep-facts! m k)
  (let ((r (tqe-r m)))
    (tqe-r-t! m)
    (dk-cite! 'rr-mul-in-rr r r)
    (dk-cite! 'rr-mul-pos r r)
    (dk-cite! 'rr-mul-in-rr (list '* r r) k)
    (dk-cite! 'rr-mul-pos (list '* r r) k)))
;;; (FORALL nq_ (IMPLIES (IN nq_ NN) (= (LAM nq_) RHS(nq_)))) proved by BODY run on the index
(define (tqe-ptw-by! lam rhs-of body)
  (let ((f (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN) (list '= (list lam 'nq_) (rhs-of 'nq_))))))
    (dk-have! f (lambda () (body (dk-di-var!))))
    f))

;;; opnorm-approx-seq: a sequence in the unit ball along which ||T x_n|| approaches ||T||
(sp (make-wff (forall-guarded '(v t_ k_)
  (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) '(IN t_ (BOUNDED-OPS v v)) (list '< 0 tqe-N) '(IN k_ RR) '(< 0 k_))
  (list 'FORSOME 'tqsg_ (list 'AND '(IN tqsg_ (FUN NN (VEC v)))
     (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (tqe-P 'n_ '(tqsg_ n_) 'k_))))))))
(dk-peel!)
