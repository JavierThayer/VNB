                        (dk-cite! 'fun-apply-type-c phi 'NN 'NN m)
                        (dk-cite! 'fun-apply-type-c g 'NN '(VEC v) pm)
                        (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) a)
                        (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) ta)
                        (dk-cite! 'cips-act-type 'v lam a)
                        (tqe-r-t! pm)
                        (dk-lam-b!)
                        (g-at! pm)
                        (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
                        (let ((db (dk-cite! 'sa-max-defect-bound 'v 't_ a r kk)))
                          (tqe-pts-pt! 'v fa) (tqe-pts-pt! 'v tta)
                          (let* ((tri (dk-apply! (dk-cite! 'metric-triangle msv) fa tta ty))
