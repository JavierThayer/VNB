                            (subst (dk-cite! 'rr-abs-of-nonneg (list '- r 0)))
                            (dk-ineq! t4 db (list 'IN r 'RR)
                                      (list 'IN (caddr d1e) 'RR) (list 'IN (caddr d3e) 'RR) (list 'IN (caddr d4e) 'RR)))))))
                  (dk-cite! 'ms-converges-of-dominated-sum msv msv 'RR-MS f cs rho ty ty 0)
                  ;; e_n = N^2 b_n = T f_n: T T y = N^2 y
                  (let ((e (list 'VNB-LAMBDA 'tqee_ 'NN (list '(ACT v) lam (list 't_ (a-of 'tqee_))))))
                    (tqe-lam-t! e '(VEC v))
                    (tqe-ptw-by! e (lambda (m) (list 't_ (list f m)))
                      (lambda (m)
                        (let ((a (a-of m)))
                          (dk-cite! 'fun-apply-type-c phi 'NN 'NN m)
                          (dk-cite! 'fun-apply-type-c g 'NN '(VEC v) (list phi m))
                          (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) a)
                          (dk-cite! 'cips-act-type 'v lam (list 't_ a))
