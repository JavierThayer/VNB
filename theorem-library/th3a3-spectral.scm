;;; ==========================================================================================
;;; (C7) TEOREMA 3.1 (iii): the eigenvectors of a compact self-adjoint operator on a Hilbert
;;; space span a dense subspace -- in the book's form K-perp = {0}, K spanned by the N_lam(T).
;;; Library: operator-algebras.
;;; sa-has-eigenvector is the "crucial observation" (every compact self-adjoint operator on
;;; H /= {0} has an eigenvector /= 0): T = 0 has the eigenvalue 0, else sa-norm-eigenvalue.
;;; sa-eigen-perp-zero: PERP(v, E) is T-invariant (sa-perp-invariant), closed and a submodule,
;;; so T restricted to it is compact self-adjoint on the Hilbert space SUB-CIPS(v, PERP(v, E))
;;; (TH3-A2); an eigenvector there is an eigenvector of T, so it lies in E and in PERP(v, E),
;;; hence is 0.  E is the union of the eigenspaces; PERP(v, E) = PERP(v, span E).
;;; ==========================================================================================

(define tqe-E '(SEP tsez_ (VEC v) (FORSOME tsec_ (AND (IN tsec_ CC) (IN tsez_ (EIGENSPACE v t_ tsec_))))))
(define tqe-PE (list 'PERP 'v tqe-E))

;;; sa-has-eigenvector
(sp (make-wff (forall-guarded '(v t_ x_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPACT-OP v v t_) (IS-SELF-ADJOINT-OP v t_)
    (IN x_ (VEC v)) (NOT (= x_ (VZERO v))))
  '(FORSOME tsel_ (IS-EIGENVALUE v t_ tsel_)))))
(dk-peel!)
(tqe-try "has-ev" (lambda ()
  (use-em '(= t_ (BOP-ZERO v v))
    (lambda ()
      (witness! 0
        (lambda ()
          (dk-have! '(IN 0 RR) (lambda () (arith)))
          (dk-cite! 'rr-subset-cc 0)
          (dk-cite! 'cips-vzero-in 'v)
          (dk-have! '(= (t_ x_) ((ACT v) 0 x_))
            (lambda ()
              (subst '(= t_ (BOP-ZERO v v)))
              (subst (dk-cite! 'bop-zero-apply 'v 'v 'x_))
              (tqe-vec-eq! '(VZERO v) '((ACT v) 0 x_))
              (dk-close-if-asm!)))
          (tqe-iff-bwd! 'eigenspace-membership 'v 't_ 0 'x_)
          (dk-have! '(FORSOME kqx_ (AND (IN kqx_ (EIGENSPACE v t_ 0)) (NOT (= kqx_ (VZERO v)))))
            (lambda () (witness! 'x_ (lambda () (dk-conj-close! dk-ass!)))))
          (tqe-iff-bwd! 'is-eigenvalue 'v 't_ 0)
          (dk-close-if-asm!))))
    (lambda ()
      (let* ((c (dk-skolem! (dk-cite! 'sa-norm-eigenvalue 'v 't_))))
        (witness! c (lambda () (dk-close-if-asm!))))))))
(tqe-qed! 'sa-has-eigenvector)

;;; sa-eigen-perp-zero
(sp (make-wff (forall-guarded '(v t_)
  '((IS-HILBERT-SPACE v) (IS-COMPACT-OP v v t_) (IS-SELF-ADJOINT-OP v t_))
  (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ tqe-PE) '(= x_ (VZERO v)))))))
(dk-peel!)
(tqe-try "perp0" (lambda ()
(let* ((x (cadr (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) tqe-PE))) "the perp vector")))
       (evs tqe-E) (pvs tqe-PE)
       (svs (list 'SUB-CIPS 'v pvs))
       (rt (list 'RESTRICT 't_ pvs)))
  (tqe-iff-fwd! 'is-hilbert-space 'v)
  (tqe-iff-fwd! 'is-self-adjoint-op 'v 't_)
  (dk-cite! 'bop-fun 'v 'v 't_)
  ;; evs is a subset of VEC v, invariant under t
  (dk-have! (list 'SUBSET evs '(VEC v))
    (lambda ()
      (let ((z (subset-by-element!)))
        (sep-me (list 'IN z evs))
        (dk-close-if-asm!))))
  (dk-have! (list 'FORALL 'tsbx_ (list 'IMPLIES (list 'IN 'tsbx_ evs) (list 'IN '(t_ tsbx_) evs)))
    (lambda ()
      (let* ((z (dk-di-var!)))
        (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN z evs)))))
        (let* ((ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (memq z (free-vars h)))) "the eigenvalue of z"))
               (c (dk-skolem! ex)))
          (tqe-iff-fwd! 'eigenspace-membership 'v 't_ c z)
          (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) z)
          (dk-cite! 'cips-act-type 'v c z)
          (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) (list 't_ z))
          (dk-cite! 'cips-act-type 'v c (list 't_ z))
          (dk-cite! 'cips-act-type 'v c (list '(ACT v) c z))
          (in-sep! (lambda () (dk-close-if-asm!))
                   (lambda ()
                     (witness! c
                       (lambda ()
                         (dk-conj-close!
                           (lambda ()
                             (if (dk-asm? (dk-goal)) (ass)
                                 (begin
                                   (dk-have! (list '= (list 't_ (list 't_ z)) (list '(ACT v) c (list 't_ z)))
                                     (lambda ()
                                       (subst (list '= (list 't_ z) (list '(ACT v) c z)))
                                       (subst (dk-cite! 'bop-act 'v 'v 't_ c z))
                                       (subst (list '= (list 't_ z) (list '(ACT v) c z)))
                                       (dk-close-if! (lambda () #t) (lambda () (rfl)))))
                                   (tqe-iff-bwd! 'eigenspace-membership 'v 't_ c (list 't_ z))
                                   (dk-close-if-asm!)))))))))))))
  ;; the restriction to pvs = PERP(v, evs)
  (dk-cite! 'sa-perp-invariant 'v evs 't_)
  (dk-cite! 'perp-is-submodule 'v evs)
  (dk-cite! 'perp-is-closed 'v evs)
  (dk-cite! 'sub-cips-is-cips 'v pvs)
  (dk-cite! 'sub-cips-restrict-compact 'v pvs 't_)
  (dk-cite! 'sub-cips-perp-self-adjoint 'v evs 't_)
  (let* ((vec-eq (dk-cite! 'sub-cips-vec 'v pvs))
         (z-eq (dk-cite! 'sub-cips-vzero 'v pvs)))
    (pbc)
    (let ((nz (dk-pick (lambda (h) (and (dk-head-is? h 'NOT) (dk-contains? h x) (dk-contains? h 'VZERO))) "the negated goal")))
      (dk-have! (list 'IN x (list 'VEC svs)) (lambda () (subst (list '= (list 'VEC svs) pvs)) (dk-close-if-asm!)))
      (dk-have! (list 'NOT (list '= x (list 'VZERO svs))) (lambda () (subst (list '= (list 'VZERO svs) '(VZERO v))) (dk-close-if-asm!)))
      (let* ((c (dk-skolem! (dk-cite! 'sa-has-eigenvector svs rt x))))
        (tqe-iff-fwd! 'is-eigenvalue svs rt c)
        (let* ((ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'EIGENSPACE) (dk-contains? h rt))) "the eigenvector"))
               (eta (dk-skolem! ex))
               (ne (list 'NOT (list '= eta (list 'VZERO svs)))))
          (tqe-iff-fwd! 'eigenspace-membership svs rt c eta)
          (let* ((inP (dk-rewrite-h! (list 'IN eta (list 'VEC svs)) (list 'VEC svs) pvs))
                 (eq0 (list '= (list rt eta) (list (list 'ACT svs) c eta)))
                 (r1 (dk-cite! 'restrict-apply 't_ pvs eta))
                 (e2 (dk-rewrite-h! eq0 (cadr r1) (caddr r1)))
                 (a1 (dk-cite! 'sub-cips-act-apply 'v pvs c eta))
                 (e3 (dk-rewrite-h! e2 (cadr a1) (caddr a1)))
                 (ne2 (dk-rewrite-h! ne (list 'VZERO svs) '(VZERO v))))
            (tqe-iff-fwd! 'perp-membership 'v evs eta)
            (tqe-iff-bwd! 'eigenspace-membership 'v 't_ c eta)
            (dk-have! (list 'IN eta evs)
              (lambda () (in-sep! (lambda () (dk-close-if-asm!))
                                  (lambda () (witness! c (lambda () (dk-conj-close! dk-ass!)))))))
            (dk-cite! 'perp-orth 'v evs eta eta)
            (let ((zz (dk-apply! (dk-cite! 'cips-ip-zero-vector 'v) eta)))
              (ai ne2))))))))))
