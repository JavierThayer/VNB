              (dk-have! (list 'IN rho '(FUN NN (PTS RR-MS))) (lambda () (subst '(= (PTS RR-MS) RR)) (dk-close-if-asm!)))
              (tqe-ptw-by! rho (lambda (m) (list R0 (list phi m)))
