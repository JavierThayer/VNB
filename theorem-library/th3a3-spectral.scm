              ;; c_n = T b_n -> T y
              (let ((cs (list 'VNB-LAMBDA 'tqec_ 'NN (list 't_ (list 't_ (a-of 'tqec_)))))
                    (ty (list 't_ y)))
                (tqe-lam-t! cs '(VEC v))
                (tqe-ptw! cs (lambda (m) (list 't_ (list b m))) (lambda (m) (dk-cite! 'fun-apply-type-c b 'NN '(VEC v) m)))
                (dk-cite! 'ipc-op 'v 'v 't_ b cs y)
                (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) y)
                (tqe-pts-pt! 'v ty)
                (dk-cite! 'rr-subset-cc lam)
