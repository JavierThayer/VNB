                                 (d3e (dk-cite! 'ipms-dist-norm 'v tta ty))
                                 (d4e (dk-cite! 'ipms-dist-norm 'v tta fa))
                                 (t1 (dk-rewrite-h! tri (cadr d1e) (caddr d1e)))
                                 (t2 (dk-rewrite-h! t1 (cadr sym) (caddr sym)))
                                 (t3 (dk-rewrite-h! t2 (cadr d4e) (caddr d4e)))
