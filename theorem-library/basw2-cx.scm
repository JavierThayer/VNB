      (list 'FORSOME 'u (list 'AND '(IN u (OPENS t)) (list 'AND '(IN p u)
        (list 'FORALL 'q (list 'IMPLIES '(IN q u) (list '< (list 'magnitude (list '- (list f 'p) (list f 'q))) 'eps)))))))))))
