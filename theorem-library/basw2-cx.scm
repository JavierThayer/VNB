(define (bsc-top-inter! u v)          ; IS-TOP-SPACE t, u v open: land (IN (INTERSECTION u v) (OPENS t))
  (let ((cl? (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'INTERSECTION) (dk-contains? h '(OPENS t))))))
    (if (not (any-pred cl? (dk-asms)))
        (let ((iff (dk-cite! 'is-top-space 't)))
          (dk-have! (caddr iff) (lambda () (if (dk-only! iff (cadr iff)) (prop))))
          (dk-split-all! (list (caddr iff)))))
    (dk-apply! (dk-pick cl? "the intersection clause") u v)))
(define (bsc-inter-in! p u v)
  (bsc-lhs! (dk-cite! 'intersection-membership u v p) (lambda () (dk-conj-close! (lambda () (bsc-ass!))))))
(define (bsc-inter-out! q u v)
  (bsc-rhs! (dk-cite! 'intersection-membership u v q)))
(define (bsc-mag x) (list 'magnitude x))
