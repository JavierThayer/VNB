      (let ((r (dk-cite! 'ccont-parts 't f))) (if (not (dk-asm? (list 'IN f '(FUN (PTS t) CC)))) (dk-split-all! (list r)))))
  (if (not (dk-asm? (list 'IN (list f z) 'CC))) (dk-cite! 'fun-apply-type-c f '(PTS t) 'CC z)))
(define (bsc-fact! . args)            ; dk-cite!, then detach conjunctive antecedents from context
  (let loop ((r (apply dk-cite! args)))
    (if (and (dk-head-is? r 'IMPLIES) (dk-head-is? (cadr r) 'AND))
        (begin (dk-have! (cadr r) (lambda () (dk-conj-close! (lambda () (bsc-ass!)))))
               (loop (dk-landed-1 (lambda () (detach! r)))))
        r)))
