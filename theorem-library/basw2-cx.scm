                               (dk-real! (list '* mgx mgyb)) (dk-real! (list '* w mgyb)) (dk-real! (list '* mgyb w))
                               (dk-real! bsc-b1) (dk-real! (list '* bsc-b1 w)) (dk-real! (list '* bsc-B w))
                               (dk-real! (list '* w m)) (dk-real! (list '* bsc-e2 m))))
                 (z1 (dk-have! (list '<= 0 w) (lambda () (dk-ineq! (list '< 0 w) (list 'IN w 'RR)))))
                 (z2 (dk-have! (list '<= 0 m) (lambda () (dk-ineq! (list '< 0 m) (list 'IN m 'RR)))))
                 (i1 (dk-cite! 'rr-mul-le-right mgy w bsc-A))
                 (i2 (dk-cite! 'rr-mul-le-right mgx w mgyb))
                 (c1 (dk-have! (list '= (list '* w mgyb) (list '* mgyb w)) (lambda () (crs))))
                 (yb1 (dk-have! (list '<= mgyb bsc-b1)
                        (lambda () (dk-ineq! la sy yl (list '<= bsc-w 1) (list '= bsc-b1 (list '+ 1 bsc-B)) (list 'IN mgyb 'RR) (list 'IN mgy 'RR) (list 'IN (bsc-mag (list '- y 'b)) 'RR)
                                             (list 'IN bsc-B 'RR) (list 'IN w 'RR)))))
                 (i3 (dk-cite! 'rr-mul-le-right mgyb bsc-b1 w))
                 (c2 (dk-have! (list '= (list '* bsc-b1 w) (list '+ w (list '* bsc-B w))) (lambda () (subst (list '= bsc-b1 (list '+ 1 bsc-B))) (crs))))
                 (i4 (dk-cite! 'rr-mul-le-right w bsc-e2 m))
                 (c3 (dk-have! (list '= (list '* w m) (list '+ (list '+ (list '* w bsc-A) (list '* bsc-B w)) w))
                       (lambda () (subst (list '= m (list '+ (list '+ bsc-A bsc-B) 1))) (crs)))))
            (dk-ineq! tri m1 m2 i1 i2 (list '= (list '* w mgyb) (list '* mgyb w)) (list '<= mgyb bsc-b1)
                      i3 (list '= (list '* bsc-b1 w) (list '+ w (list '* bsc-B w))) i4
                      (list '= (list '* w m) (list '+ (list '+ (list '* w bsc-A) (list '* bsc-B w)) w))
                      bsc-canc2 (list '= (list '+ bsc-h bsc-h) 'eps) (list '< 0 bsc-h)
                      (list 'IN (bsc-mag (list '+ U V)) 'RR) (list 'IN (bsc-mag U) 'RR) (list 'IN (bsc-mag V) 'RR)
                      (list 'IN (list '* mgy bsc-A) 'RR) (list 'IN (list '* w bsc-A) 'RR) (list 'IN (list '* mgx mgyb) 'RR)
                      (list 'IN (list '* w mgyb) 'RR) (list 'IN (list '* mgyb w) 'RR) (list 'IN (list '* bsc-b1 w) 'RR)
                      (list 'IN (list '* bsc-B w) 'RR) (list 'IN (list '* w m) 'RR) (list 'IN (list '* bsc-e2 m) 'RR)
                      (list 'IN mgyb 'RR) (list 'IN w 'RR) (list 'IN bsc-h 'RR) '(IN eps RR)))))))
(bsc-qed! 'cc-mul-near)
;;; ================================================================================================
;;; THE COMPOSITION LEMMA (the brief's form): F jointly continuous on CC x CC, f, g in CCONT(t) and
;;; h(z) = F(f(z), g(z)) give h in CCONT(t).  F is any binary operation, stated by its epsilon-delta
;;; estimate on CC x CC (the shape of cc-add-near / cc-mul-near).
;;; ================================================================================================
(define (bsc-joint op) (bsc-near-stmt op))
(sp (make-wff (list 'FORALL 't (list 'FORALL 'fop (list 'FORALL 'f (list 'FORALL 'g (list 'FORALL 'h
  (list 'IMPLIES '(IN f (CCONT t)) (list 'IMPLIES '(IN g (CCONT t)) (list 'IMPLIES '(IN h (FUN (PTS t) CC))
    (list 'IMPLIES '(FORALL rz_ (IMPLIES (IN rz_ (PTS t)) (= (h rz_) (fop (f rz_) (g rz_)))))
      (list 'IMPLIES (bsc-joint (lambda (u v) (list 'fop u v))) '(IN h (CCONT t))))))))))))))
(dk-peel!)
(define bsc-eqh (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'rz_))) "the pointwise equation"))
(define bsc-jh (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'a))) "the joint estimate"))
(bsc-parts! 'f) (bsc-parts! 'g)
(let ((imp (dk-cite! 'ccont-compose 't 'f 'g 'h)))
  (dk-have! (cadr imp)
    (lambda ()
      (let* ((pe (bsc-peel-pe (dk-peel!))) (p (car pe)) (e (cdr pe)))
        (bsc-val! 'f p) (bsc-val! 'g p)
        (let* ((d (dk-skolem! (dk-apply! bsc-jh (list 'f p) (list 'g p) e)))
               (dcl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'x) (dk-contains? x d))) "the d clause")))
          (ew d)
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'POS-RR) (bsc-ass!)
                  (let* ((q (dk-di-var!)))
                    (dk-peel!)
                    (bsc-val! 'f q) (bsc-val! 'g q)
                    (dk-apply! dcl (list 'f q) (list 'g q))
                    (subst (dk-apply! bsc-eqh p))
                    (subst (dk-apply! bsc-eqh q))
                    (bsc-ass!)))))))))
  (detach! imp)
  (bsc-ass!))
(bsc-qed! 'ccont-compose-fun)

;;; ---- one-variable estimates --------------------------------------------------------------------
(define (bsc-near1-stmt op)
  (list 'FORALL 'a (list 'IMPLIES '(IN a CC)
    (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
      (list 'FORSOME 'd (list 'AND '(POS-RR d)
        (list 'FORALL 'x (list 'IMPLIES '(IN x CC)
          (list 'IMPLIES '(< (magnitude (- a x)) d) (list '< (bsc-mag (list '- (op 'a) (op 'x))) 'eps)))))))))))
(define (bsc-near1! op rewrite!)
  (sp (make-wff (bsc-near1-stmt op)))
  (dk-peel!)
  (ew 'eps)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'POS-RR) (bsc-ass!)
          (let* ((x (dk-di-var!)))
            (dk-peel!)
            (bsc-cc! (list '- 'a x))
            (rewrite! x)
            (bsc-ass!))))))
(bsc-near1! (lambda (u) (list '- u))
  (lambda (x)
    (bsc-cc! (list '- 'a)) (bsc-cc! (list '- x))
    (bsc-cc! (list '- x 'a))
    (dk-have! (list '= (list '- (list '- 'a) (list '- x)) (list '- x 'a)) (lambda () (crs)))
    (subst (list '= (list '- (list '- 'a) (list '- x)) (list '- x 'a)))
    (subst (dk-cite! 'cc-magnitude-sub-sym x 'a))))
(bsc-qed! 'cc-neg-near)
(bsc-near1! (lambda (u) (list 'conjugate u))
  (lambda (x)
    (let ((cs (dk-cite! 'cc-conjugate-sub 'a x)))
      (subst (list '= (caddr cs) (cadr cs)))
      (subst (dk-cite! 'cc-magnitude-conjugate (list '- 'a x))))))
(bsc-qed! 'cc-conj-near)

;;; ---- the pointwise instances: h(z) = OP(f(z), g(z)) is continuous ------------------------------
(define (bsc-ptw-stmt vars hyps eqn)
  (let loop ((vs vars))
    (if (null? vs)
        (let loop2 ((hs hyps))
          (if (null? hs)
              (list 'IMPLIES '(IN h (FUN (PTS t) CC))
                (list 'IMPLIES (list 'FORALL 'rz_ (list 'IMPLIES '(IN rz_ (PTS t)) (list '= '(h rz_) eqn)))
                  '(IN h (CCONT t))))
              (list 'IMPLIES (car hs) (loop2 (cdr hs)))))
        (list 'FORALL (car vs) (loop (cdr vs))))))
;; drive a pointwise instance through ccont-compose-fun with FOP := L (a destructuring lambda on
;; CC x CC), f := F1, g := G1; JOINT! proves the estimate of L after the peel (args a b eps)
(define (bsc-ptw-drive! L f1 g1 joint!)
  (dk-peel!)
  (let ((eqh (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'rz_))) "the pointwise equation")))
    (bsc-parts! f1) (bsc-parts! g1)
    (let ((imp (dk-cite! 'ccont-compose-fun 't L f1 g1 'h)))
      (dk-have! (cadr imp)
        (lambda ()
          (let ((z (dk-di-var!)))
            (bsc-val! f1 z) (bsc-val! g1 z)
            (dk-lam-b!)
            (dk-apply! eqh z)
            (bsc-ass!))))
      (let ((imp2 (dk-landed-1 (lambda () (detach! imp)))))
        (dk-have! (cadr imp2)
          (lambda ()
            (let* ((pe (dk-peel!))
                   (ccs (map cadr (filter (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'CC))) pe)))
                   (e (cadr (car (filter (lambda (x) (dk-head-is? x 'POS-RR)) pe)))))
              (joint! (car ccs) (cadr ccs) e))))
        (detach! imp2)
        (bsc-ass!)))))
;; the estimate step after the skolem: ew d, then for x y with the two bounds, beta and the clause
(define (bsc-joint-close! d use!)
  (ew d)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'POS-RR) (bsc-ass!)
          (let* ((pe (dk-peel!))
                 (ccs (map cadr (filter (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'CC))) pe))))
            (dk-lam-b!)
            (use! (car ccs) (cadr ccs))
            (bsc-ass!))))))
(define (bsc-dcl d) (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'x) (dk-contains? x d))) "the d clause"))

(define bsc-Ladd '(VNB-LAMBDA (LIST cla_ clb_) (CARTESIAN CC CC) (+ cla_ clb_)))
(sp (make-wff (bsc-ptw-stmt '(t f g h) '((IN f (CCONT t)) (IN g (CCONT t))) '(+ (f rz_) (g rz_)))))
(bsc-ptw-drive! bsc-Ladd 'f 'g
  (lambda (a b e)
    (let ((d (dk-skolem! (dk-cite! 'cc-add-near a b e))))
      (bsc-joint-close! d (lambda (x y) (dk-apply! (bsc-dcl d) x y))))))
(bsc-qed! 'ccont-add-ptw)

(define bsc-Lmul '(VNB-LAMBDA (LIST cla_ clb_) (CARTESIAN CC CC) (* cla_ clb_)))
(sp (make-wff (bsc-ptw-stmt '(t f g h) '((IN f (CCONT t)) (IN g (CCONT t))) '(* (f rz_) (g rz_)))))
(bsc-ptw-drive! bsc-Lmul 'f 'g
  (lambda (a b e)
    (let ((d (dk-skolem! (dk-cite! 'cc-mul-near a b e))))
      (bsc-joint-close! d (lambda (x y) (dk-apply! (bsc-dcl d) x y))))))
(bsc-qed! 'ccont-mul-ptw)

(define (bsc-unary! op near)
  (sp (make-wff (bsc-ptw-stmt '(t f h) '((IN f (CCONT t))) (op '(f rz_)))))
  (bsc-ptw-drive! (list 'VNB-LAMBDA '(LIST cla_ clb_) '(CARTESIAN CC CC) (op 'cla_)) 'f 'f
    (lambda (a b e)
      (let ((d (dk-skolem! (dk-cite! near a e))))
        (bsc-joint-close! d (lambda (x y) (dk-apply! (bsc-dcl d) x)))))))
(bsc-unary! (lambda (u) (list '- u)) 'cc-neg-near)
(bsc-qed! 'ccont-neg-ptw)
(bsc-unary! (lambda (u) (list 'conjugate u)) 'cc-conj-near)
(bsc-qed! 'ccont-conj-ptw)

;; scalar multiples: F(u, v) = c u, the estimate is cc-mul-near at (c, a) with x := c
(sp (make-wff (bsc-ptw-stmt '(t c f h) '((IN c CC) (IN f (CCONT t))) '(* c (f rz_)))))
(bsc-ptw-drive! '(VNB-LAMBDA (LIST cla_ clb_) (CARTESIAN CC CC) (* c cla_)) 'f 'f
  (lambda (a b e)
    (let ((d (dk-skolem! (dk-cite! 'cc-mul-near 'c a e))))
      (dk-pos-parts! d)
      (bsc-joint-close! d
        (lambda (x y)
          (dk-have! (list '< (bsc-mag '(- c c)) d)
            (lambda ()
              (dk-have! '(= (- c c) 0) (lambda () (crs)))
              (subst '(= (- c c) 0))
              (subst (dk-cite! 'cc-magnitude-zero))
              (bsc-ass!)))
          (dk-apply! (bsc-dcl d) 'c x))))))
(bsc-qed! 'ccont-scal-ptw)

;; constants, directly from ccont-intro
(sp (make-wff (bsc-ptw-stmt '(t c h) '((IS-TOP-SPACE t) (IN c CC)) 'c)))
(dk-peel!)
(define bsc-ceq (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'rz_))) "the pointwise equation"))
(let ((imp (dk-cite! 'ccont-intro 't 'h)))
  (dk-have! (cadr imp)
    (lambda ()
      (let* ((pe (bsc-peel-pe (dk-peel!))) (p (car pe)) (e (cdr pe)))
        (dk-pos-parts! e)
        (ew '(PTS t))
        (dk-conj-close!
          (lambda ()
            (let ((gl (dk-goal)))
              (cond ((dk-asm? gl) (ass))
                    ((dk-head-is? gl 'IN) (bsc-rhs! (dk-cite! 'is-top-space 't)) (bsc-ass!))
                    (#t (let ((q (dk-di-var!)))
                          (subst (dk-apply! bsc-ceq p))
                          (subst (dk-apply! bsc-ceq q))
                          (dk-have! '(= (- c c) 0) (lambda () (crs)))
                          (subst '(= (- c c) 0))
                          (subst (dk-cite! 'cc-magnitude-zero))
                          (bsc-ass!))))))))))
  (detach! imp)
  (bsc-ass!))
(bsc-qed! 'ccont-const-ptw)
;;; ================================================================================================
;;; THE SLOT TYPINGS of CCONT-ALGEBRA(t): every operation lands in CCONT(t)
;;; ================================================================================================
(sp (make-wff '(FORALL t (IMPLIES (IS-TOP-SPACE t) (IN (CCONT t) SET)))))
(dk-peel!)
(bsc-rhs! (dk-cite! 'is-top-space 't))
(dk-cite! 'cc-is-set)
(dk-set-if! 'fun-set-iff '(PTS t) 'CC (lambda () (bsc-close-ctx!)))
(dk-cite! 'ccont-unfold 't)
(subst (list '= '(CCONT t) bsc-csep))
(sep-set)
(bsc-ass!)
(bsc-qed! 'ccont-is-set)

;; the lambda L on PTS t in context-free form: L in FUN(PTS t, CC) by its pointwise values
(define (bsc-lam-fun! L val!)         ; VAL! (z) lands (IN body(z) CC)
  (dk-have! (list 'IN L '(FUN (PTS t) CC))
    (lambda ()
      (dk-lam-type! (lambda () (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*))) (val! z) (if (not (sequent-node-grounded? leaf)) (bsc-ass!))))
                    (lambda () (bsc-rhs! (dk-cite! 'is-top-space 't)) (bsc-ass!))))))
;; goal (IN L (CCONT t)), L = (VNB-LAMBDA kxp_ (PTS t) BODY): cite the pointwise lemma LEMMA at ARGS + L
(define (bsc-lam-in! lemma args val!)
  (let* ((L (cadr (dk-goal))))
    (bsc-lam-fun! L val!)
    (let ((imp (apply dk-cite! lemma (append args (list L)))))
      (dk-have! (cadr imp)
        (lambda () (let ((z (dk-di-var!))) (val! z) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
      (let ((leaf (proof-state-focus *ps*)))
        (detach! imp)
        (if (not (sequent-node-grounded? leaf)) (bsc-ass!))))))
(define (bsc-body) (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!)) (cadddr (cadr (dk-goal))))
(define (bsc-slot-stmt fn dom cod) (list 'FORALL 't (list 'IMPLIES '(IS-TOP-SPACE t) (list 'IN (list fn 't) (list 'FUN dom cod)))))
(define (bsc-set-cart! a b)            ; (IN (CARTESIAN a b) SET), a and b sets in context
  (dk-set-if! 'cartesian-set-iff a b (lambda () (bsc-close-ctx!))))
(define (bsc-slot! fn dom cod set! typer)
  (sp (make-wff (bsc-slot-stmt fn dom cod)))
  (dk-peel!)
  (dk-cite! 'ccont-is-set 't)
  (dk-cite! 'cc-is-set)
  (mac fn)
  (dk-lam-type! typer set!))

(define bsc-CC2 '(CARTESIAN (CCONT t) (CCONT t)))
(define (bsc-set-ccont!) (if (equal? (dk-goal) '(IN (CCONT t) SET)) (ass)))
(define (bsc-binop-typer lemma valop)
  (lambda ()
    (let* ((b (bsc-body)) (f1 (car (cadr b))) (g1 (car (caddr b))))
      (bsc-parts! f1) (bsc-parts! g1)
      (bsc-lam-in! lemma (list 't f1 g1)
        (lambda (z) (bsc-val! f1 z) (bsc-val! g1 z) (bsc-cc! (valop (list f1 z) (list g1 z))))))))
(bsc-slot! 'CCONT-VADD bsc-CC2 '(CCONT t) (lambda () (bsc-set-cart! '(CCONT t) '(CCONT t)))
  (bsc-binop-typer 'ccont-add-ptw (lambda (u v) (list '+ u v))))
(bsc-qed! 'ccont-vadd-type)
(bsc-slot! 'CCONT-VMUL bsc-CC2 '(CCONT t) (lambda () (bsc-set-cart! '(CCONT t) '(CCONT t)))
  (bsc-binop-typer 'ccont-mul-ptw (lambda (u v) (list '* u v))))
(bsc-qed! 'ccont-vmul-type)

(define (bsc-unop-typer lemma valop)
  (lambda ()
    (let* ((b (bsc-body)) (f1 (car (cadr b))))
      (bsc-parts! f1)
      (bsc-lam-in! lemma (list 't f1)
        (lambda (z) (bsc-val! f1 z) (bsc-cc! (valop (list f1 z))))))))
(bsc-slot! 'CCONT-VNEG '(CCONT t) '(CCONT t) bsc-set-ccont!
  (bsc-unop-typer 'ccont-neg-ptw (lambda (u) (list '- u))))
(bsc-qed! 'ccont-vneg-type)
(bsc-slot! 'CCONT-VSTAR '(CCONT t) '(CCONT t) bsc-set-ccont!
  (bsc-unop-typer 'ccont-conj-ptw (lambda (u) (list 'conjugate u))))
(bsc-qed! 'ccont-vstar-type)

(bsc-slot! 'CCONT-ACT '(CARTESIAN CC (CCONT t)) '(CCONT t) (lambda () (bsc-set-cart! 'CC '(CCONT t)))
  (lambda ()
    (let* ((b (bsc-body)) (c1 (cadr b)) (f1 (car (caddr b))))
      (bsc-parts! f1)
      (bsc-lam-in! 'ccont-scal-ptw (list 't c1 f1)
        (lambda (z) (bsc-val! f1 z) (bsc-cc! (list '* c1 (list f1 z))))))))
(bsc-qed! 'ccont-act-type)

;; the constants
(define (bsc-const! fn c name)
  (sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-TOP-SPACE t) (list 'IN (list fn 't) '(CCONT t))))))
  (dk-peel!)
  (mac fn)
  (bsc-cc! c)
  (bsc-lam-in! 'ccont-const-ptw (list 't c) (lambda (z) (bsc-cc! c)))
  (bsc-qed! name))
(bsc-const! 'CCONT-VZERO 0 'ccont-vzero-type)
(bsc-const! 'CCONT-VONE 1 'ccont-vone-type)
;;; ================================================================================================
;;; THE SUP NORM.  |f| is continuous; on a compact space it is bounded; SUP-NORM-T is then a real
;;; number with the two characteristic properties (an upper bound, the least one).
;;; ================================================================================================
(define (bsc-abs-lt-goal! x c . premises)   ; goal (< (abs x) c), the parts by ineq from PREMISES
  (dk-real! x) (dk-real! c)
  (let ((imp (dk-cite! 'rr-abs-lt-of-parts x c)))
    (dk-have! (list '< (list '- c) x) (lambda () (apply dk-ineq! (append premises (list (list 'IN x 'RR) (list 'IN c 'RR))))))
    (dk-have! (list '< x c) (lambda () (apply dk-ineq! (append premises (list (list 'IN x 'RR) (list 'IN c 'RR))))))
    (dk-apply! imp)
    (bsc-ass!)))

;; |f| is a continuous real function
(sp (make-wff '(FORALL t (FORALL f (FORALL h (IMPLIES (IN f (CCONT t)) (IMPLIES (IN h (FUN (PTS t) RR))
   (IMPLIES (FORALL rz_ (IMPLIES (IN rz_ (PTS t)) (= (h rz_) (magnitude (f rz_))))) (IN h (RCONT t))))))))))
(dk-peel!)
(define bsc-meq (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'rz_))) "the pointwise equation"))
(bsc-parts! 'f)
(let ((imp (dk-cite! 'bsw-rcont-intro 't 'h)))
  (dk-have! (cadr imp)
    (lambda ()
      (let* ((pe (bsc-peel-pe (dk-peel!))) (p (car pe)) (e (cdr pe))
             (u (dk-skolem! (dk-apply! (dk-cite! 'ccont-local 't 'f) p e)))
             (c1 (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x u))) "the u clause")))
        (dk-pos-parts! e)
        (ew u)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'FORALL)
                (let ((q (dk-di-var!)))
                  (dk-cite! 'top-open-subset 't u)
                  (dk-cite! 'subset-mem-fwd u '(PTS t) q)
                  (let* ((b (dk-apply! c1 q)) (fp (list 'f p)) (fq (list 'f q)))
                    (bsc-val! 'f p) (bsc-val! 'f q)
                    (subst (dk-apply! bsc-meq p)) (subst (dk-apply! bsc-meq q))
                    (bsc-magr! fp) (bsc-magr! fq) (bsc-magr! (list '- fp fq)) (bsc-magr! (list '- fq fp))
                    (let* ((l1 (dk-cite! 'cc-magnitude-le-add fp fq))
                          (l2 (dk-cite! 'cc-magnitude-le-add fq fp))
                          (sy (dk-cite! 'cc-magnitude-sub-sym fq fp)))
                      (bsc-abs-lt-goal! (list '- (bsc-mag fp) (bsc-mag fq)) e b l1 l2 sy
                        (list 'IN (bsc-mag fp) 'RR) (list 'IN (bsc-mag fq) 'RR)
                        (list 'IN (bsc-mag (list '- fp fq)) 'RR) (list 'IN (bsc-mag (list '- fq fp)) 'RR)))))
                (bsc-ass!)))))))
  (detach! imp)
  (bsc-ass!))
(bsc-qed! 'ccont-magnitude-rcont)

;; on a compact space |f| is bounded
(sp (make-wff '(FORALL t (FORALL f (IMPLIES (IS-COMPACT-T t) (IMPLIES (IN f (CCONT t))
   (FORSOME bm_ (AND (IN bm_ RR) (AND (<= 0 bm_) (FORALL bz_ (IMPLIES (IN bz_ (PTS t)) (<= (magnitude (f bz_)) bm_))))))))))))
(dk-peel!)
(bsc-parts! 'f)
(define bsc-ml '(VNB-LAMBDA mgz_ (PTS t) (magnitude (f mgz_))))
(dk-have! (list 'IN bsc-ml '(FUN (PTS t) RR))
  (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (bsc-val! 'f z) (bsc-magr! (list 'f z)) (bsc-ass!)))
                           (lambda () (bsc-rhs! (dk-cite! 'is-top-space 't)) (bsc-ass!)))))
(let ((imp (dk-cite! 'ccont-magnitude-rcont 't 'f bsc-ml)))
  (dk-have! (cadr imp) (lambda () (let ((z (dk-di-var!))) (bsc-val! 'f z) (bsc-magr! (list 'f z)) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
  (detach! imp))
(let* ((m (dk-skolem! (dk-cite! 'bsw-rcont-bounded 't bsc-ml)))
       (cl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x m) (dk-contains? x 'abs))) "the bound clause")))
  (ew m)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORALL)
          (let* ((z (dk-di-var!)) (l (dk-apply! cl z)))
            (bsc-val! 'f z) (bsc-magr! (list 'f z))
            (dk-have! (list '= (list bsc-ml z) (bsc-mag (list 'f z)))
              (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
            (let* ((l2 (dk-rewrite-h! l (list bsc-ml z) (bsc-mag (list 'f z))))
                   (ab (dk-cite! 'rr-abs-of-nonneg (bsc-mag (list 'f z)))))
              (dk-rewrite-h! l2 (cadr ab) (caddr ab))
              (bsc-ass!)))
          (bsc-ass!)))))
(bsc-qed! 'ccont-bounded)

(sp (make-wff '(FORALL t (FORALL f (== (SUP-NORM-T t f) (CC-SUP-NORM f (PTS t)))))))
(dk-peel!) (mac 'SUP-NORM-T) (mac 'CC-SUP-NORM) (qrfl)
(bsc-qed! 'sup-norm-t-unfold)
(define (bsc-sn f) (list 'SUP-NORM-T 't f))

(sp (make-wff '(FORALL t (FORALL f (IMPLIES (IN f (FUN (PTS t) CC))
   (FORALL x (IMPLIES (IN x (PTS t)) (<= (magnitude (f x)) (SUP-NORM-T t f)))))))))
(dk-peel!)
(dk-cite! 'sup-norm-t-unfold 't 'f)
(subst '(= (SUP-NORM-T t f) (CC-SUP-NORM f (PTS t))))
(dk-have! '(FORALL y (IMPLIES (IN y (PTS t)) (IN (f y) CC))) (lambda () (let ((z (dk-di-var!))) (bsc-val! 'f z) (bsc-ass!))))
(dk-cite! 'cc-sup-norm-upper 'f '(PTS t) 'x)
(bsc-ass!)
(bsc-qed! 'sup-norm-t-upper)

(sp (make-wff '(FORALL t (FORALL f (IMPLIES (IN f (FUN (PTS t) CC))
   (FORALL bm (IMPLIES (IN bm RR) (IMPLIES (<= 0 bm) (IMPLIES (FORALL x (IMPLIES (IN x (PTS t)) (<= (magnitude (f x)) bm)))
     (AND (IN (SUP-NORM-T t f) RR) (AND (<= 0 (SUP-NORM-T t f)) (<= (SUP-NORM-T t f) bm))))))))))))
(dk-peel!)
(dk-cite! 'sup-norm-t-unfold 't 'f)
(subst '(= (SUP-NORM-T t f) (CC-SUP-NORM f (PTS t))))
(dk-have! '(FORALL y (IMPLIES (IN y (PTS t)) (IN (f y) CC))) (lambda () (let ((z (dk-di-var!))) (bsc-val! 'f z) (bsc-ass!))))
(dk-cite! 'cc-sup-norm-bound 'f '(PTS t) 'bm)
(bsc-ass!)
(bsc-qed! 'sup-norm-t-least)

(sp (make-wff '(FORALL t (FORALL f (IMPLIES (IS-COMPACT-T t) (IMPLIES (IN f (CCONT t))
   (AND (IN (SUP-NORM-T t f) RR) (<= 0 (SUP-NORM-T t f)))))))))
(dk-peel!)
(bsc-parts! 'f)
(let* ((m (dk-skolem! (dk-cite! 'ccont-bounded 't 'f)))
       (r (dk-cite! 'sup-norm-t-least 't 'f m)))
  (dk-split-all! (list r))
  (bsc-close-ctx!))
(bsc-qed! 'sup-norm-t-real)

(define (bsc-snr! f)                  ; t compact, f in CCONT t: land ||f|| in RR, 0 <= ||f||
  (if (not (dk-asm? (list 'IN (bsc-sn f) 'RR))) (bsc-split-cite! 'sup-norm-t-real 't f)))
(define (bsc-up! f x)                 ; |f x| <= ||f||
  (bsc-parts! f)
  (let ((l (list '<= (bsc-mag (list f x)) (bsc-sn f)))) (if (not (dk-asm? l)) (dk-cite! 'sup-norm-t-upper 't f x)) l))

(sp (make-wff '(FORALL t (IMPLIES (IS-COMPACT-T t) (IN (CCONT-VNRM t) (FUN (CCONT t) RR))))))
(dk-peel!)
(bsc-rhs! (dk-cite! 'is-compact-t 't))
(dk-cite! 'ccont-is-set 't)
(mac 'CCONT-VNRM)
(dk-lam-type! (lambda () (let ((f (dk-di-var!))) (bsc-snr! f) (bsc-ass!))) (lambda () (bsc-ass!)))
(bsc-qed! 'ccont-vnrm-type)
;;; ================================================================================================
;;; THE NORM LAWS of SUP-NORM-T on a compact space, stated POINTWISE (h given by its values)
;;; ================================================================================================
(define (bsc-law-stmt vars hyps eqn concl)
  (let loop ((vs vars))
    (if (null? vs)
        (let loop2 ((hs (cons '(IS-COMPACT-T t) hyps)))
          (if (null? hs)
              (list 'IMPLIES '(IN h (FUN (PTS t) CC))
                (list 'IMPLIES (list 'FORALL 'rz_ (list 'IMPLIES '(IN rz_ (PTS t)) (list '= '(h rz_) eqn))) concl))
              (list 'IMPLIES (car hs) (loop2 (cdr hs)))))
        (list 'FORALL (car vs) (loop (cdr vs))))))
(define (bsc-law-sp! vars hyps eqn concl) (sp (make-wff (bsc-law-stmt vars hyps eqn concl))))
(define (bsc-law-peel!)               ; peel; returns the pointwise equation; IS-TOP-SPACE t landed
  (dk-peel!)
  (bsc-rhs! (dk-cite! 'is-compact-t 't))
  (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'rz_))) "the pointwise equation"))
;; land ||H|| <= M: M real and nonnegative in context, PTW! (x) proves |H x| <= M at a point x
(define (bsc-least! hh m ptw!)
  (if (dk-asm? (list 'IN hh '(CCONT t))) (bsc-parts! hh))
  (let ((r (dk-cite! 'sup-norm-t-least 't hh m)))
    (if (dk-head-is? r 'IMPLIES)
        (begin (dk-have! (cadr r) (lambda () (let ((x (dk-di-var!))) (ptw! x))))
               (set! r (dk-landed-1 (lambda () (detach! r))))))
    (dk-split-all! (list r))
    (list '<= (bsc-sn hh) m)))
(define (bsc-nonneg-prod! a b)        ; a, b real nonnegative in context: land a * b in RR, 0 <= a * b
  (dk-real! (list '* a b))
  (if (not (dk-asm? (list '<= 0 (list '* a b))))
      (let ((i (begin (dk-real! 0) (dk-real! (list '* 0 b)) (dk-cite! 'rr-mul-le-right 0 a b))))
        (dk-have! (list '= (list '* 0 b) 0) (lambda () (crs)))
        (dk-have! (list '<= 0 (list '* a b))
          (lambda () (dk-ineq! i (list '= (list '* 0 b) 0) (list 'IN (list '* a b) 'RR) (list 'IN (list '* 0 b) 'RR)))))))
(define (bsc-prod-le! a ab b bb)       ; 0 <= a <= ab, 0 <= b <= bb (reals in context): land a * b <= ab * bb
  (dk-real! (list '* a b)) (dk-real! (list '* ab b)) (dk-real! (list '* b ab)) (dk-real! (list '* bb ab)) (dk-real! (list '* ab bb))
  (let* ((i1 (dk-cite! 'rr-mul-le-right a ab b))
         (i2 (dk-cite! 'rr-mul-le-right b bb ab))
         (c1 (dk-have! (list '= (list '* ab b) (list '* b ab)) (lambda () (crs))))
         (c2 (dk-have! (list '= (list '* bb ab) (list '* ab bb)) (lambda () (crs)))))
    (dk-have! (list '<= (list '* a b) (list '* ab bb))
      (lambda () (dk-ineq! i1 i2 (list '= (list '* ab b) (list '* b ab)) (list '= (list '* bb ab) (list '* ab bb))
                           (list 'IN (list '* a b) 'RR) (list 'IN (list '* ab b) 'RR) (list 'IN (list '* b ab) 'RR)
                           (list 'IN (list '* bb ab) 'RR) (list 'IN (list '* ab bb) 'RR))))))
(define (bsc-antisym! a b)            ; a <= b, b <= a, both real: goal a = b
  (bsc-fact! 'rr-leq-antisymmetric a b)
  (bsc-ass!))
(define (bsc-hval! eqh x)             ; rewrite h(x) in the goal by the pointwise equation
  (subst (dk-apply! eqh x)))

;; the triangle inequality
(bsc-law-sp! '(t f g h) '((IN f (CCONT t)) (IN g (CCONT t))) '(+ (f rz_) (g rz_))
  '(<= (SUP-NORM-T t h) (+ (SUP-NORM-T t f) (SUP-NORM-T t g))))
(let ((eqh (bsc-law-peel!)) (m '(+ (SUP-NORM-T t f) (SUP-NORM-T t g))))
  (bsc-snr! 'f) (bsc-snr! 'g)
  (dk-real! m)
  (dk-have! (list '<= 0 m) (lambda () (dk-ineq! '(<= 0 (SUP-NORM-T t f)) '(<= 0 (SUP-NORM-T t g)) '(IN (SUP-NORM-T t f) RR) '(IN (SUP-NORM-T t g) RR))))
  (bsc-least! 'h m
    (lambda (x)
      (bsc-hval! eqh x)
      (bsc-val! 'f x) (bsc-val! 'g x)
      (let* ((fx (list 'f x)) (gx (list 'g x))
             (tri (bsc-fact! 'cc-magnitude-triangle fx gx))
             (u1 (bsc-up! 'f x)) (u2 (bsc-up! 'g x)))
        (bsc-magr! fx) (bsc-magr! gx) (bsc-magr! (list '+ fx gx))
        (dk-ineq! tri u1 u2 (list 'IN (bsc-mag fx) 'RR) (list 'IN (bsc-mag gx) 'RR) (list 'IN (bsc-mag (list '+ fx gx)) 'RR)
                  '(IN (SUP-NORM-T t f) RR) '(IN (SUP-NORM-T t g) RR)))))
  (bsc-ass!))
(bsc-qed! 'sup-norm-t-add-le)

;; submultiplicativity
(bsc-law-sp! '(t f g h) '((IN f (CCONT t)) (IN g (CCONT t))) '(* (f rz_) (g rz_))
  '(<= (SUP-NORM-T t h) (* (SUP-NORM-T t f) (SUP-NORM-T t g))))
(let ((eqh (bsc-law-peel!)) (nf '(SUP-NORM-T t f)) (ng '(SUP-NORM-T t g)))
  (bsc-snr! 'f) (bsc-snr! 'g)
  (bsc-nonneg-prod! nf ng)
  (bsc-least! 'h (list '* nf ng)
    (lambda (x)
      (bsc-hval! eqh x)
      (bsc-val! 'f x) (bsc-val! 'g x)
      (let* ((fx (list 'f x)) (gx (list 'g x)))
        (bsc-magr! fx) (bsc-magr! gx)
        (subst (bsc-fact! 'cc-magnitude-mul fx gx))
        (bsc-up! 'f x) (bsc-up! 'g x)
        (bsc-prod-le! (bsc-mag fx) nf (bsc-mag gx) ng)
        (bsc-ass!))))
  (bsc-ass!))
(bsc-qed! 'sup-norm-t-mul-le)

;; homogeneity, the easy half
(bsc-law-sp! '(t c f h) '((IN c CC) (IN f (CCONT t))) '(* c (f rz_))
  '(<= (SUP-NORM-T t h) (* (magnitude c) (SUP-NORM-T t f))))
(let ((eqh (bsc-law-peel!)) (nf '(SUP-NORM-T t f)))
  (bsc-snr! 'f) (bsc-magr! 'c)
  (bsc-nonneg-prod! '(magnitude c) nf)
  (bsc-least! 'h (list '* '(magnitude c) nf)
    (lambda (x)
      (bsc-hval! eqh x)
      (bsc-val! 'f x)
      (let* ((fx (list 'f x)))
        (bsc-magr! fx)
        (subst (bsc-fact! 'cc-magnitude-mul 'c fx))
        (bsc-up! 'f x)
        (dk-have! '(<= (magnitude c) (magnitude c)) (lambda () (dk-ineq! '(IN (magnitude c) RR))))
        (bsc-prod-le! '(magnitude c) '(magnitude c) (bsc-mag fx) nf)
        (bsc-ass!))))
  (bsc-ass!))
(bsc-qed! 'sup-norm-t-scal-le)

;; homogeneity: ||c f|| = |c| ||f||
(bsc-law-sp! '(t c f h) '((IN c CC) (IN f (CCONT t))) '(* c (f rz_))
  '(= (SUP-NORM-T t h) (* (magnitude c) (SUP-NORM-T t f))))
(let ((eqh (bsc-law-peel!)) (nf '(SUP-NORM-T t f)) (nh '(SUP-NORM-T t h)) (mc '(magnitude c)))
  (bsc-snr! 'f) (bsc-magr! 'c)
  (bsc-nonneg-prod! mc nf)
  (dk-cite! 'ccont-scal-ptw 't 'c 'f 'h)
  (bsc-snr! 'h)
  (let ((le1 (dk-cite! 'sup-norm-t-scal-le 't 'c 'f 'h)))
    (use-em '(= c 0)
      (lambda ()
        (dk-have! (list '= mc 0) (lambda () (subst '(= c 0)) (subst (dk-cite! 'cc-magnitude-zero)) (rfl)))
        (dk-have! (list '= (list '* mc nf) 0) (lambda () (subst (list '= mc 0)) (crs)))
        (subst (list '= (list '* mc nf) 0))
        (dk-ineq! le1 (list '= (list '* mc nf) 0) (list '<= 0 nh) (list 'IN nh 'RR) (list 'IN (list '* mc nf) 'RR)))
      (lambda ()
        (bsc-fact! 'cc-recip-closed 'c)
        (let* ((k '(recip c)) (ck (bsc-fact! 'cc-recip-inverse 'c)))
          (dk-have! (list 'FORALL 'rz_ (list 'IMPLIES '(IN rz_ (PTS t)) (list '= '(f rz_) (list '* k '(h rz_)))))
            (lambda ()
              (let ((z (dk-di-var!)))
                (bsc-val! 'f z)
                (subst (dk-apply! eqh z))
                (dk-have! (list '= (list '* k (list '* 'c (list 'f z))) (list '* (list '* 'c k) (list 'f z))) (lambda () (crs)))
                (subst (list '= (list '* k (list '* 'c (list 'f z))) (list '* (list '* 'c k) (list 'f z))))
                (subst '(= (* c (recip c)) 1))
                (dk-have! (list '= (list '* 1 (list 'f z)) (list 'f z)) (lambda () (crs)))
                (subst (list '= (list '* 1 (list 'f z)) (list 'f z)))
                (rfl))))
          (bsc-parts! 'f)
          (let* ((le2 (dk-cite! 'sup-norm-t-scal-le 't k 'h 'f))
                 (mk '(magnitude (recip c))))
            (bsc-magr! k)
            (dk-have! (list '<= mc mc) (lambda () (dk-ineq! (list 'IN mc 'RR))))
            (dk-real! (list '* mk nh))
            (bsc-nonneg-prod! mk nh)
            (bsc-prod-le! mc mc nf (list '* mk nh))
            (let* ((mm (bsc-fact! 'cc-magnitude-mul 'c k))
                   (one (dk-cite! 'cc-magnitude-one)))
              (dk-real! (list '* mc mk))
              (dk-have! (list '= (list '* mc mk) 1)
                (lambda () (subst (list '= (list '* mc mk) (bsc-mag (list '* 'c k)))) (subst '(= (* c (recip c)) 1)) (bsc-ass!)))
              (dk-real! (list '* mc (list '* mk nh)))
              (dk-have! (list '= (list '* mc (list '* mk nh)) nh)
                (lambda () (dk-have! (list '= (list '* mc (list '* mk nh)) (list '* (list '* mc mk) nh)) (lambda () (crs)))
                           (subst (list '= (list '* mc (list '* mk nh)) (list '* (list '* mc mk) nh)))
                           (subst (list '= (list '* mc mk) 1))
                           (crs)))
              (dk-have! (list '<= (list '* mc nf) nh)
                (lambda () (dk-ineq! (list '<= (list '* mc nf) (list '* mc (list '* mk nh))) (list '= (list '* mc (list '* mk nh)) nh)
                                     (list 'IN (list '* mc nf) 'RR) (list 'IN (list '* mc (list '* mk nh)) 'RR) (list 'IN nh 'RR))))
              (bsc-antisym! nh (list '* mc nf)))))))))
(bsc-qed! 'sup-norm-t-scal)

;; the involution is isometric
(bsc-law-sp! '(t f h) '((IN f (CCONT t))) '(conjugate (f rz_)) '(= (SUP-NORM-T t h) (SUP-NORM-T t f)))
(let ((eqh (bsc-law-peel!)) (nf '(SUP-NORM-T t f)) (nh '(SUP-NORM-T t h)))
  (bsc-snr! 'f)
  (dk-cite! 'ccont-conj-ptw 't 'f 'h)
  (bsc-snr! 'h)
  (bsc-least! 'h nf
    (lambda (x)
      (bsc-hval! eqh x) (bsc-val! 'f x)
      (subst (dk-cite! 'cc-magnitude-conjugate (list 'f x)))
      (bsc-up! 'f x) (bsc-ass!)))
  (bsc-least! 'f nh
    (lambda (x)
      (bsc-val! 'f x) (bsc-parts! 'h)
      (let* ((u (bsc-up! 'h x))
             (ex (dk-apply! eqh x))
             (u2 (dk-rewrite-h! u (list 'h x) (list 'conjugate (list 'f x)))))
        (dk-cite! 'cc-magnitude-conjugate (list 'f x))
        (dk-rewrite-h! u2 (bsc-mag (list 'conjugate (list 'f x))) (bsc-mag (list 'f x)))
        (bsc-ass!))))
  (bsc-antisym! nh nf))
(bsc-qed! 'sup-norm-t-conj)

;; THE C* IDENTITY: || conj(f) f || = ||f||^2
(bsc-law-sp! '(t f h) '((IN f (CCONT t))) '(* (conjugate (f rz_)) (f rz_)) '(= (SUP-NORM-T t h) (* (SUP-NORM-T t f) (SUP-NORM-T t f))))
(let ((eqh (bsc-law-peel!)) (nf '(SUP-NORM-T t f)) (nh '(SUP-NORM-T t h))
      (kl '(VNB-LAMBDA cjz_ (PTS t) (conjugate (f cjz_)))))
  (bsc-snr! 'f)
  (bsc-nonneg-prod! nf nf)
  ;; h is continuous: h = K f with K the conjugate of f
  (dk-have! (list 'IN kl '(FUN (PTS t) CC))
    (lambda () (dk-lam-type! (lambda () (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*))) (bsc-val! 'f z) (bsc-cc! (list 'conjugate (list 'f z))) (if (not (sequent-node-grounded? leaf)) (bsc-ass!))))
                             (lambda () (bsc-rhs! (dk-cite! 'is-top-space 't)) (bsc-ass!)))))
  (let ((imp (dk-cite! 'ccont-conj-ptw 't 'f kl)))
    (dk-have! (cadr imp) (lambda () (let ((z (dk-di-var!))) (bsc-val! 'f z) (bsc-cc! (list 'conjugate (list 'f z))) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
    (detach! imp))
  (let ((imp (dk-cite! 'ccont-mul-ptw 't kl 'f 'h)))
    (dk-have! (cadr imp) (lambda () (let ((z (dk-di-var!))) (bsc-val! 'f z) (bsc-cc! (list 'conjugate (list 'f z))) (dk-lam-b!) (subst (dk-apply! eqh z)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
    (detach! imp))
  (bsc-snr! 'h)
  (define (bsc-cs-val! x)               ; |h x| = |f x| |f x|
    (bsc-val! 'f x) (bsc-cc! (list 'conjugate (list 'f x)))
    (let* ((fx (list 'f x)) (mm (bsc-fact! 'cc-magnitude-mul (list 'conjugate fx) fx))
           (mc (dk-cite! 'cc-magnitude-conjugate fx)))
      (bsc-magr! fx)
      (dk-have! (list '= (bsc-mag (list '* (list 'conjugate fx) fx)) (list '* (bsc-mag fx) (bsc-mag fx)))
        (lambda () (subst mm) (subst mc) (rfl)))
      (list '= (bsc-mag (list '* (list 'conjugate fx) fx)) (list '* (bsc-mag fx) (bsc-mag fx)))))
  (bsc-least! 'h (list '* nf nf)
    (lambda (x)
      (bsc-hval! eqh x)
      (let ((e (bsc-cs-val! x)))
        (subst e)
        (bsc-up! 'f x)
        (bsc-prod-le! (bsc-mag (list 'f x)) nf (bsc-mag (list 'f x)) nf)
        (bsc-ass!))))
  (let* ((sq (bsc-fact! 'sqrt-prop nh)) (r (list 'sqrt nh)))
    (dk-split-all! (list sq))
    (bsc-least! 'f r
      (lambda (x)
        (bsc-parts! 'h)
        (let* ((e (bsc-cs-val! x)) (fx (list 'f x))
               (u (bsc-up! 'h x))
               (ex (dk-apply! eqh x))
               (u2 (dk-rewrite-h! u (list 'h x) (list '* (list 'conjugate fx) fx)))
               (u3 (dk-rewrite-h! u2 (bsc-mag (list '* (list 'conjugate fx) fx)) (list '* (bsc-mag fx) (bsc-mag fx)))))
          (dk-real! (list '* (bsc-mag fx) (bsc-mag fx))) (dk-real! (list '* r r))
          (dk-have! (list '<= (list '* (bsc-mag fx) (bsc-mag fx)) (list '* r r))
            (lambda () (subst (list '= (list '* r r) nh)) (bsc-ass!)))
          (bsc-fact! 'rr-square-le-imp-le (bsc-mag fx) r)
          (bsc-ass!))))
    (let ((m (bsc-fact! 'rr-square-mono nf r)))
      (dk-have! (list '<= (list '* nf nf) nh)
        (lambda () (subst (list '= nh (list '* r r))) (bsc-ass!)))
      (bsc-antisym! nh (list '* nf nf)))))
(bsc-qed! 'sup-norm-t-cstar)

;; definiteness, both directions
(sp (make-wff '(FORALL t (FORALL f (IMPLIES (IS-COMPACT-T t) (IMPLIES (IN f (CCONT t)) (IMPLIES (= (SUP-NORM-T t f) 0)
   (FORALL rz_ (IMPLIES (IN rz_ (PTS t)) (= (f rz_) 0))))))))))
(dk-peel!)
(let ((z (if (dk-head-is? (dk-goal) 'FORALL) (dk-di-var!) (cadr (cadr (dk-goal))))))
  (bsc-val! 'f z)
  (let* ((u (bsc-up! 'f z)) (u2 (dk-rewrite-h! u '(SUP-NORM-T t f) 0)))
    (bsc-magr! (list 'f z))
    (dk-have! (list '= (bsc-mag (list 'f z)) 0) (lambda () (dk-ineq! u2 (list '<= 0 (bsc-mag (list 'f z))) (list 'IN (bsc-mag (list 'f z)) 'RR))))
    (let ((iff (dk-cite! 'cc-magnitude-zero-iff (list 'f z))))
      (bsc-rhs! iff)
      (bsc-ass!))))
(bsc-qed! 'sup-norm-t-zero-elim)

(bsc-law-sp! '(t h) '() 0 '(= (SUP-NORM-T t h) 0))
(let ((eqh (bsc-law-peel!)))
  (dk-real! 0) (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
  (bsc-least! 'h 0
    (lambda (x) (bsc-hval! eqh x) (subst (dk-cite! 'cc-magnitude-zero)) (bsc-ass!)))
  (dk-ineq! '(<= (SUP-NORM-T t h) 0) '(<= 0 (SUP-NORM-T t h)) '(IN (SUP-NORM-T t h) RR)))
(bsc-qed! 'sup-norm-t-zero-intro)

;; ||1|| = 1 on a NONEMPTY compact space
(bsc-law-sp! '(t h) '((FORSOME tp_ (IN tp_ (PTS t)))) 1 '(= (SUP-NORM-T t h) 1))
(let* ((eqh (bsc-law-peel!))
       (p (dk-skolem! (dk-pick (lambda (x) (and (dk-head-is? x 'FORSOME) (eq? (cadr x) 'tp_))) "nonempty"))))
  (dk-real! 1) (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
  (bsc-least! 'h 1
    (lambda (x) (bsc-hval! eqh x) (subst (dk-cite! 'cc-magnitude-one)) (dk-ineq! '(IN 1 RR))))
  (let* ((u (dk-cite! 'sup-norm-t-upper 't 'h p))
         (ex (dk-apply! eqh p))
         (mo (dk-cite! 'cc-magnitude-one))
         (u2 (dk-rewrite-h! u (list 'h p) 1))
         (u3 (dk-rewrite-h! u2 '(magnitude 1) 1)))
    (bsc-antisym! '(SUP-NORM-T t h) 1)))
(bsc-qed! 'sup-norm-t-one)
;;; ================================================================================================
;;; COMPLETENESS: a uniformly Cauchy sequence in CCONT(t) converges uniformly to a member of CCONT(t)
;;; (the pointwise limit by cc-complete, a CHOICE at each point; the 3-epsilon argument for its
;;; continuity).  Model: ca5-frechet.scm (C(U) on the exhaustion compacts).
;;; ================================================================================================
(define bsc-seq '(IN s (FUN NN (CCONT t))))
(define bsc-uc
  '(FORALL eps (IMPLIES (POS-RR eps)
     (FORSOME cap (AND (IN cap NN)
       (FORALL i (IMPLIES (IN i NN) (IMPLIES (<= cap i)
         (FORALL j (IMPLIES (IN j NN) (IMPLIES (<= cap j)
           (FORALL z (IMPLIES (IN z (PTS t))
             (< (magnitude (- ((s i) z) ((s j) z))) eps))))))))))))))
(define (bsc-tz z) (list 'VNB-LAMBDA 'cxi_ 'NN (list (list 's 'cxi_) z)))
(define (bsc-lset z) (list 'SEP 'cxl_ 'CC (list 'CONVERGES-TO 'CC-MS (bsc-tz z) 'cxl_)))
(define bsc-F (list 'VNB-LAMBDA 'cxz_ '(PTS t) (list 'CHOICE (bsc-lset 'cxz_))))
(define (bsc-sv! i z)                 ; s in FUN(NN, CCONT t), i in NN, z in PTS t: land (s i) z in CC
  (if (not (dk-asm? (list 'IN (list 's i) '(CCONT t)))) (dk-cite! 'fun-apply-type-c 's 'NN '(CCONT t) i))
  (bsc-val! (list 's i) z))
(define (bsc-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (bsc-mg! x) (bsc-magr! x) (bsc-mag x))

;;; the values at a point converge
(sp (make-wff (list 'FORALL 't (list 'FORALL 's (list 'IMPLIES '(IS-TOP-SPACE t) (list 'IMPLIES bsc-seq (list 'IMPLIES bsc-uc
    (list 'FORALL 'z (list 'IMPLIES '(IN z (PTS t))
      (list 'FORSOME 'cxl_ (list 'AND '(IN cxl_ CC) (list 'CONVERGES-TO 'CC-MS (bsc-tz 'z) 'cxl_))))))))))))
(dk-peel!)
(dk-cite! 'cc-is-metric-space)
(bsc-pts-cc!)
(define bsc-uc1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'eps) (dk-contains? f 'cap))) "uniform Cauchy"))
(let* ((tz (bsc-tz 'z)))
  (dk-have! (list 'IN tz '(FUN NN CC))
    (lambda () (dk-lam-type! (lambda () (let ((i (dk-di-var!))) (bsc-sv! i 'z) (bsc-ass!))))))
  (dk-have! (list 'IN tz '(FUN NN (PTS CC-MS))) (lambda () (subst '(= (PTS CC-MS) CC)) (bsc-ass!)))
  (let* ((ciff (dk-cite! 'is-cauchy-seq 'CC-MS tz)))
    (dk-have! (caddr ciff)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (let* ((lk (dk-peel!))
                       (epsv (cadr (car (filter (dk-head? 'POS-RR) lk))))
                       (cap (dk-skolem! (dk-apply! bsc-uc1 epsv))))
                  (dk-split-all!)
                  (ew cap)
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-asm? (dk-goal))
                          (ass)
                          (let* ((lk2 (begin (dk-peel!) (dk-split-all!)))
                                 (gd (dk-goal))
                                 (m (cadr (cadr gd))) (n2 (caddr (cadr gd)))
                                 (mi (cadr m)) (ni (cadr n2))
                                 (tl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f cap) (dk-contains? f epsv))) "the tail")))
                            (bsc-sv! mi 'z) (bsc-sv! ni 'z)
                            (dk-have! (list '= m (list (list 's mi) 'z)) (lambda () (if (not (dk-lam-b!)) (rfl))))
                            (dk-have! (list '= n2 (list (list 's ni) 'z)) (lambda () (if (not (dk-lam-b!)) (rfl))))
                            (dk-cite! 'cc-ms-dist (list (list 's mi) 'z) (list (list 's ni) 'z))
                            (subst (list '= m (list (list 's mi) 'z)))
                            (subst (list '= n2 (list (list 's ni) 'z)))
                            (subst (list '== (list '(DIST CC-MS) (list (list 's mi) 'z) (list (list 's ni) 'z))
                                         (list 'magnitude (list '- (list (list 's mi) 'z) (list (list 's ni) 'z)))))
                            (dk-apply! tl mi ni 'z)
                            (bsc-mg! (list '- (list (list 's mi) 'z) (list (list 's ni) 'z)))
                            (dk-cite! 'rr-pos-rr-in-rr epsv)
                            (dk-ineq! (list '< (list 'magnitude (list '- (list (list 's mi) 'z) (list (list 's ni) 'z))) epsv)
                                      (list 'IN (list 'magnitude (list '- (list (list 's mi) 'z) (list (list 's ni) 'z))) 'RR)
                                      (list 'IN epsv 'RR))))))))))))
    (dk-have! (list 'IS-CAUCHY-SEQ 'CC-MS tz) (lambda () (prop))))
  (dk-cite! 'cc-complete)
  (let* ((cpl (dk-cite! 'is-complete 'CC-MS))
         (cl (caddr (caddr cpl))))
    (dk-have! cl (lambda () (dk-only! cpl '(IS-COMPLETE CC-MS)) (prop)))
    (dk-apply! cl tz)
    (let* ((cv (dk-cite! 'converges 'CC-MS tz)))
      (dk-have! (caddr cv) (lambda () (prop)))
      (let* ((l (dk-skolem! (caddr cv)))
             (ct (dk-cite! 'converges-to 'CC-MS tz l)))
        (dk-have! (caddr ct) (lambda () (prop)))
        (dk-split-all! (list (caddr ct)))
        (dk-have! (list 'IN l 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass)))
        (ew l)
        (dk-conj-close! (lambda () (ass)))))))
(bsc-qed! 'ccont-pointwise-limit)

;;; the limit function F: its typing and its values
(sp (make-wff (list 'FORALL 't (list 'FORALL 's (list 'IMPLIES '(IS-TOP-SPACE t) (list 'IMPLIES bsc-seq (list 'IMPLIES bsc-uc
    (list 'AND (list 'IN bsc-F '(FUN (PTS t) CC))
      (list 'FORALL 'z (list 'IMPLIES '(IN z (PTS t)) (list 'CONVERGES-TO 'CC-MS (bsc-tz 'z) (list bsc-F 'z))))))))))))
(dk-peel!)
(bsc-rhs! (dk-cite! 'is-top-space 't))
(dk-cite! 'cc-is-set)
(define (bsc-choice-at! z)
  (let* ((ex (dk-cite! 'ccont-pointwise-limit 't 's z))
         (l (dk-skolem! ex)))
    (dk-split-all!)
    (dk-have! (list 'FORSOME 'cxx_ (list 'IN 'cxx_ (bsc-lset z)))
      (lambda () (ew l) (in-sep! (lambda () (ass)) (lambda () (ass)))))
    (let ((m (dk-cite! 'choice-axiom (bsc-lset z))))
      (dk-split-all! (dk-landed (lambda () (sep-me m)))))))
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IN)
        (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (bsc-choice-at! z) (ass))))
        (let ((z (dk-di-var!)))
          (bsc-choice-at! z)
          (if (not (dk-lam-b!)) (ass))))))
(bsc-qed! 'ccont-limit-function)

;;; uniform convergence to F
(define (bsc-unif-to g)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'cap (list 'AND '(IN cap NN)
      (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'IMPLIES '(<= cap i)
        (list 'FORALL 'z (list 'IMPLIES '(IN z (PTS t))
          (list '<= (list 'magnitude (list '- '((s i) z) (list g 'z))) 'eps)))))))))))
(sp (make-wff (list 'FORALL 't (list 'FORALL 's (list 'IMPLIES '(IS-TOP-SPACE t) (list 'IMPLIES bsc-seq (list 'IMPLIES bsc-uc
    (bsc-unif-to bsc-F))))))))
(define bsc-pe7 (dk-peel!))
(define bsc-uc2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'eps) (dk-contains? f 'cap) (not (dk-contains? f 'CHOICE)))) "uniform Cauchy"))
(dk-split-all! (list (dk-cite! 'ccont-limit-function 't 's)))
(let* ((epsv (cadr (car (filter (dk-head? 'POS-RR) bsc-pe7))))
       (cap (dk-skolem! (dk-apply! bsc-uc2 epsv))))
  (dk-split-all!)
  (dk-cite! 'rr-pos-rr-in-rr epsv)
  (ew cap)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (let* ((lk (dk-peel!))
                 (gd (cadr (cadr (dk-goal))))
                 (i (cadr (car (cadr gd)))) (z (cadr (cadr gd)))
                 (tl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f cap) (dk-contains? f epsv))) "the tail"))
                 (fz (list bsc-F z)) (siz (list (list 's i) z)) (tz (bsc-tz z)))
            (bsc-sv! i z)
            (dk-cite! 'fun-apply-type-c bsc-F '(PTS t) 'CC z)
            (dk-apply! (or (dk-ctx-form (list 'FORALL 'z (list 'IMPLIES '(IN z (PTS t)) (list 'CONVERGES-TO 'CC-MS (bsc-tz 'z) (list bsc-F 'z)))))
                           (error "bsc: pointwise clause missing")) z)
            (dk-have! (list 'IN tz '(FUN NN CC))
              (lambda () (dk-lam-type! (lambda () (let ((n (dk-di-var!))) (bsc-sv! n z) (ass))))))
            (dk-have! (list 'FORALL 'cekn_ (list 'IMPLIES '(IN cekn_ NN) (list 'IMPLIES (list '<= cap 'cekn_)
                         (list '<= (list 'magnitude (list '- (list tz 'cekn_) siz)) epsv))))
              (lambda ()
                (let* ((n (dk-di-var!)))
                  (di)
                  (bsc-sv! n z)
                  (dk-lam-b!)
                  (dk-apply! tl n i z)
                  (bsc-mg! (list '- (list (list 's n) z) siz))
                  (dk-ineq! (list '< (list 'magnitude (list '- (list (list 's n) z) siz)) epsv)
                            (list 'IN (list 'magnitude (list '- (list (list 's n) z) siz)) 'RR) (list 'IN epsv 'RR)))))
            (dk-cite! 'cek-limit-tail-le tz fz siz epsv cap)
            (bsc-mg! (list '- fz siz)) (bsc-mg! (list '- siz fz))
            (dk-cite! 'cc-magnitude-sub-sym siz fz)
            (dk-ineq! (list '<= (list 'magnitude (list '- fz siz)) epsv)
                      (list '= (list 'magnitude (list '- siz fz)) (list 'magnitude (list '- fz siz)))
                      (list 'IN (list 'magnitude (list '- siz fz)) 'RR) (list 'IN (list 'magnitude (list '- fz siz)) 'RR)
                      (list 'IN epsv 'RR)))))))
(bsc-qed! 'ccont-limit-uniform)

;;; the four-epsilon estimate, stated on variables (an ineq over binder-holding atoms declined)
(sp (make-wff '(FORALL fa_ (IMPLIES (IN fa_ CC) (FORALL fb_ (IMPLIES (IN fb_ CC) (FORALL fc_ (IMPLIES (IN fc_ CC)
  (FORALL fw_ (IMPLIES (IN fw_ CC) (FORALL fr_ (IMPLIES (IN fr_ RR) (FORALL fd_ (IMPLIES (IN fd_ RR) (FORALL fe_ (IMPLIES (IN fe_ RR)
  (IMPLIES (< 0 fr_) (IMPLIES (= (+ fr_ fr_) fd_) (IMPLIES (= (+ fd_ fd_) fe_)
  (IMPLIES (< (magnitude (- fb_ fc_)) fr_) (IMPLIES (<= (magnitude (- fb_ fa_)) fr_) (IMPLIES (<= (magnitude (- fc_ fw_)) fr_)
    (< (magnitude (- fa_ fw_)) fe_)))))))))))))))))))))))
(dk-peel!)
(let loop () (if (not (dk-head-is? (dk-goal) '<)) (begin (di) (loop))))
(let* ((ch1 (dk-cite! 'cc-magnitude-sub-chain 'fa_ 'fb_ 'fw_))
       (ch2 (dk-cite! 'cc-magnitude-sub-chain 'fb_ 'fc_ 'fw_))
       (sy (dk-cite! 'cc-magnitude-sub-sym 'fa_ 'fb_)))
  (for-each bsc-mg! (list '(- fa_ fw_) '(- fa_ fb_) '(- fb_ fw_) '(- fb_ fc_) '(- fc_ fw_) '(- fb_ fa_)))
  (dk-ineq! ch1 ch2 sy '(< (magnitude (- fb_ fc_)) fr_) '(<= (magnitude (- fb_ fa_)) fr_) '(<= (magnitude (- fc_ fw_)) fr_)
            '(< 0 fr_) '(= (+ fr_ fr_) fd_) '(= (+ fd_ fd_) fe_)
            '(IN (magnitude (- fa_ fw_)) RR) '(IN (magnitude (- fa_ fb_)) RR) '(IN (magnitude (- fb_ fw_)) RR)
            '(IN (magnitude (- fb_ fc_)) RR) '(IN (magnitude (- fc_ fw_)) RR) '(IN (magnitude (- fb_ fa_)) RR)
            '(IN fr_ RR) '(IN fd_ RR) '(IN fe_ RR)))
(bsc-qed! 'cc-four-eps)

;;; F is continuous: the 3-epsilon argument
(sp (make-wff (list 'FORALL 't (list 'FORALL 's (list 'IMPLIES '(IS-TOP-SPACE t) (list 'IMPLIES bsc-seq (list 'IMPLIES bsc-uc
    (list 'IN bsc-F '(CCONT t)))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'ccont-limit-function 't 's)))
(define bsc-ut (dk-cite! 'ccont-limit-uniform 't 's))
(let ((imp (dk-cite! 'ccont-intro 't bsc-F)))
  (dk-have! (cadr imp)
    (lambda ()
      (let* ((pe (bsc-peel-pe (dk-peel!))) (p (car pe)) (e (cdr pe))
             (d (dk-halve! e)) (d2 (dk-halve! d))
             (cap (dk-skolem! (dk-apply! bsc-ut d2)))
             (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f cap) (dk-contains? f d2))) "the uniform clause"))
             (capn (dk-have! (list '<= cap cap) (lambda () (dk-cite! 'nn-le-refl cap) (bsc-ass!))))
             (sn (list 's cap))
             (dummy (begin (dk-cite! 'fun-apply-type-c 's 'NN '(CCONT t) cap) (dk-apply! cl cap)))
             (unf (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f sn) (dk-contains? f d2))) "the uniform clause at cap"))
             (u (dk-skolem! (dk-apply! (dk-cite! 'ccont-local 't sn) p d2)))
             (c1 (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x u))) "the u clause")))
        (ew u)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'FORALL)
                (let ((q (dk-di-var!)))
                  (dk-cite! 'top-open-subset 't u)
                  (dk-cite! 'subset-mem-fwd u '(PTS t) q)
                  (let* ((b (dk-apply! c1 q))
                         (bp (dk-apply! unf p)) (bq (dk-apply! unf q))
                         (fp (list bsc-F p)) (fq (list bsc-F q)) (sp0 (list sn p)) (sq (list sn q)))
                    (bsc-sv! cap p) (bsc-sv! cap q)
                    (dk-cite! 'fun-apply-type-c bsc-F '(PTS t) 'CC p) (dk-cite! 'fun-apply-type-c bsc-F '(PTS t) 'CC q)
                    (for-each bsc-cc! (list fp fq sp0 sq))
                    (if (not (dk-asm? (list 'IN e 'RR))) (dk-cite! 'rr-pos-rr-in-rr e))
                    (dk-cite! 'cc-four-eps fp sp0 sq fq d2 d e) (bsc-ass!)))
                (bsc-ass!)))))))
  (detach! imp)
  (bsc-ass!))
(bsc-qed! 'ccont-limit-continuous)

;;; the completeness theorem, pointwise form
(sp (make-wff (list 'FORALL 't (list 'FORALL 's (list 'IMPLIES '(IS-TOP-SPACE t) (list 'IMPLIES bsc-seq (list 'IMPLIES bsc-uc
    (list 'FORSOME 'g (list 'AND '(IN g (CCONT t)) (bsc-unif-to 'g))))))))))
(dk-peel!)
(dk-cite! 'ccont-limit-continuous 't 's)
(dk-cite! 'ccont-limit-uniform 't 's)
(ew bsc-F)
(bsc-close-ctx!)
(bsc-qed! 'ccont-uniformly-complete)
;;; ================================================================================================
;;; part8: the operations of CCONT-ALGEBRA(t) at an argument, and at a point
;;; ================================================================================================
(define (bsc-show! tag) (display "\n*** ") (display tag) (display ": ") (display (expression->string (dk-goal))) (newline))
(define (bsc-guarded vs body)          ; vs: ((v C) ...)
  (if (null? vs) body
      (list 'FORALL (car (car vs)) (list 'IMPLIES (list 'IN (car (car vs)) (cadr (car vs))) (bsc-guarded (cdr vs) body)))))
(define (bsc-op-stmt hyp vs body) (list 'FORALL 't (list 'IMPLIES hyp (bsc-guarded vs body))))
(define (bsc-ccargs vs) (map car (filter (lambda (v) (equal? (cadr v) '(CCONT t))) vs)))

;;; (OP t) applied to ARGS lands in CCONT t
(define (bsc-op-in! name fn vs lemma valop)
  (sp (make-wff (bsc-op-stmt '(IS-TOP-SPACE t) vs (list 'IN (cons (list fn 't) (map car vs)) '(CCONT t)))))
  (dk-peel!)
  (for-each bsc-parts! (bsc-ccargs vs))
  (mac fn)
  (dk-lam-b!)
  (bsc-lam-in! lemma (cons 't (map car vs))
    (lambda (z) (for-each (lambda (f) (bsc-val! f z)) (bsc-ccargs vs)) (bsc-cc! (valop z))))
  (bsc-qed! name))
;;; ((OP t) ARGS) at a point p of t
(define (bsc-op-val! name fn vs valop)
  (sp (make-wff (bsc-op-stmt '(IS-TOP-SPACE t) (append vs '((p (PTS t))))
                  (list '= (list (if (null? vs) (list fn 't) (cons (list fn 't) (map car vs))) 'p) (valop 'p)))))
  (dk-peel!)
  (for-each (lambda (f) (bsc-parts! f) (bsc-val! f 'p)) (bsc-ccargs vs))
  (let ((v (valop 'p))) (if (pair? v) (bsc-cc! v)))
  (mac fn)
  (dk-lam-b!)
  (if (not (proof-done? *ps*)) (rfl))
  (bsc-qed! name))

(define bsc-fg '((f (CCONT t)) (g (CCONT t))))
(bsc-op-in! 'ccont-vadd-in 'CCONT-VADD bsc-fg 'ccont-add-ptw (lambda (z) (list '+ (list 'f z) (list 'g z))))
(bsc-op-val! 'ccont-vadd-val 'CCONT-VADD bsc-fg (lambda (z) (list '+ (list 'f z) (list 'g z))))
(bsc-op-in! 'ccont-vmul-in 'CCONT-VMUL bsc-fg 'ccont-mul-ptw (lambda (z) (list '* (list 'f z) (list 'g z))))
(bsc-op-val! 'ccont-vmul-val 'CCONT-VMUL bsc-fg (lambda (z) (list '* (list 'f z) (list 'g z))))
(bsc-op-in! 'ccont-vneg-in 'CCONT-VNEG '((f (CCONT t))) 'ccont-neg-ptw (lambda (z) (list '- (list 'f z))))
(bsc-op-val! 'ccont-vneg-val 'CCONT-VNEG '((f (CCONT t))) (lambda (z) (list '- (list 'f z))))
(bsc-op-in! 'ccont-vstar-in 'CCONT-VSTAR '((f (CCONT t))) 'ccont-conj-ptw (lambda (z) (list 'conjugate (list 'f z))))
(bsc-op-val! 'ccont-vstar-val 'CCONT-VSTAR '((f (CCONT t))) (lambda (z) (list 'conjugate (list 'f z))))
(bsc-op-in! 'ccont-act-in 'CCONT-ACT '((c CC) (f (CCONT t))) 'ccont-scal-ptw (lambda (z) (list '* 'c (list 'f z))))
(bsc-op-val! 'ccont-act-val 'CCONT-ACT '((c CC) (f (CCONT t))) (lambda (z) (list '* 'c (list 'f z))))
(bsc-op-val! 'ccont-vzero-val 'CCONT-VZERO '() (lambda (z) 0))
(bsc-op-val! 'ccont-vone-val 'CCONT-VONE '() (lambda (z) 1))
;;; the norm slot
(sp (make-wff '(FORALL t (IMPLIES (IS-COMPACT-T t) (FORALL f (IMPLIES (IN f (CCONT t)) (= ((CCONT-VNRM t) f) (SUP-NORM-T t f))))))))
(dk-peel!)
(bsc-snr! 'f)
(mac 'CCONT-VNRM)
(dk-lam-b!)
(if (not (proof-done? *ps*)) (rfl))
(bsc-qed! 'ccont-vnrm-val)
;;; ================================================================================================
;;; part9: the laws of CCONT-ALGEBRA(t), each stated as the conjunct of the structure's defining
;;; IFF at the literal tuple, and proved pointwise: an equation of continuous functions is the
;;; equation of their values (function extensionality), and a value is computed by the -val laws.
;;; ================================================================================================
;;; the tuple CCONT-ALGEBRA(t) unfolds to, and the accessors that read it
(define bsc-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define bsc-vals (list bsc-ring '(CCONT t) '(CCONT-VADD t) '(CCONT-VZERO t) '(CCONT-VNEG t) '(CCONT-ACT t)
                       '(CCONT-VNRM t) '(CCONT-VMUL t) '(CCONT-VONE t) '(CCONT-VSTAR t)))
(define bsc-accs '(SCAL VEC VADD VZERO VNEG ACT VNRM VMUL VONE VSTAR))
(define (bsc-first n l) (if (= n 0) '() (cons (car l) (bsc-first (- n 1) (cdr l)))))
(define bsc-optab '((CCONT-VADD ccont-vadd-in ccont-vadd-val (v v)) (CCONT-VMUL ccont-vmul-in ccont-vmul-val (v v))
                    (CCONT-VNEG ccont-vneg-in ccont-vneg-val (v)) (CCONT-VSTAR ccont-vstar-in ccont-vstar-val (v))
                    (CCONT-ACT ccont-act-in ccont-act-val (s v))))
(define (bsc-opapp? e) (and (pair? e) (pair? (car e)) (assq (car (car e)) bsc-optab) (equal? (cdr (car e)) '(t))))
(define (bsc-const? e) (and (pair? e) (memq (car e) '(CCONT-VZERO CCONT-VONE)) (equal? (cdr e) '(t))))
(define (bsc-ty! e)                    ; land (IN e (CCONT t)), bottom-up
  (cond ((dk-asm? (list 'IN e '(CCONT t))) #t)
        ((bsc-const? e) (dk-cite! (if (eq? (car e) 'CCONT-VZERO) 'ccont-vzero-type 'ccont-vone-type) 't))
        ((bsc-opapp? e)
         (let ((row (assq (caar e) bsc-optab)))
           (for-each (lambda (k a) (if (eq? k 'v) (bsc-ty! a) (bsc-cc! a))) (cadddr row) (cdr e))
           (apply dk-cite! (cadr row) 't (cdr e))))
        (#t (error "bsc-ty!: not typed in CCONT(t):" (expression->string e)))))
(define (bsc-ev! e z)                  ; rewrite (e z) in the goal by its value
  (cond ((bsc-const? e) (subst (dk-cite! (if (eq? (car e) 'CCONT-VZERO) 'ccont-vzero-val 'ccont-vone-val) 't z)))
        ((bsc-opapp? e)
         (let ((row (assq (caar e) bsc-optab)))
           (bsc-ty! e)
           (subst (apply dk-cite! (caddr row) 't (append (cdr e) (list z))))
           (for-each (lambda (k a) (if (eq? k 'v) (bsc-ev! a z))) (cadddr row) (cdr e))))
        (#t (bsc-parts! e) (bsc-val! e z))))
(define (bsc-crs! z) (if (not (proof-done-here?)) (crs)))
(define (proof-done-here?) (sequent-node-grounded? (proof-state-focus *ps*)))
;;; goal (= L R) of elements of CCONT(t)
(define (bsc-law-eq! fin)
  (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
    (dk-fun-ext! l r '(PTS t) 'CC
      (lambda () (bsc-ty! l) (bsc-parts! l) (bsc-ass!))
      (lambda () (bsc-ty! r) (bsc-parts! r) (bsc-ass!))
      (lambda (z) (bsc-ev! l z) (bsc-ev! r z) (fin z)))))
(define bsc-ring-eqs
  (list (list '(CARR (NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)) 'cc-scalar-ring-carr)
        (list '(ADD (NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)) 'cc-scalar-ring-add)
        (list '(MUL (NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)) 'cc-scalar-ring-mul)
        (list '(ONE (NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)) 'cc-scalar-ring-one)))
(define (bsc-ring-subst!)
  (for-each (lambda (p) (if (dk-contains? (dk-goal) (car p)) (subst (dk-cite! (cadr p))))) bsc-ring-eqs))
(define (bsc-law-body! fin)
  (let ((g (dk-goal)))
    (cond ((proof-done-here?) #t)
          ((memq (dk-head g) '(IS-ASSOCIATIVE IS-COMMUTATIVE IS-IDENTITY HAS-INVERSES)) (mac (dk-head g)) (bsc-law-body! fin))
          ((dk-head-is? g 'FORALL) (dk-peel!) (bsc-scal-typ!) (bsc-law-body! fin))
          ((dk-head-is? g 'AND) (dk-conj-close! (lambda () (bsc-law-body! fin))))
          ((dk-head-is? g '=) (if (dk-contains? g 'VNB-LAMBDA) (dk-lam-b!)) (bsc-law-eq! fin))
          (#t (error "bsc-law-body!: unexpected goal" (expression->string g))))))

;;; a scalar typed in CARR of the ring view: land it in CC
(define (bsc-scal-typ!)
  (let ((cr (list 'CARR bsc-ring)))
    (for-each (lambda (a) (if (and (dk-head-is? a 'IN) (equal? (caddr a) cr) (not (dk-asm? (list 'IN (cadr a) 'CC))))
                              (begin (dk-cite! 'cc-scalar-ring-carr) (dk-rewrite-h! a cr 'CC))))
              (dk-asms))))
;;; ---- the conjuncts of a structure's IFF at the literal tuple ----
(define (bsc-replace old new e)
  (cond ((eq? e old) new) ((pair? e) (map (lambda (x) (bsc-replace old new x)) e)) (#t e)))
(define (bsc-index x l) (let loop ((l l) (i 1)) (cond ((null? l) #f) ((eq? (car l) x) i) (#t (loop (cdr l) (+ i 1))))))
(define (bsc-acc-red e)
  (cond ((not (pair? e)) e)
        ((and (symbol? (car e)) (bsc-index (car e) bsc-accs) (= (length e) 2) (pair? (cadr e)) (eq? (car (cadr e)) 'LIST)
              (<= (bsc-index (car e) bsc-accs) (length (cdr (cadr e)))))
         (bsc-acc-red (list-ref (cdr (cadr e)) (- (bsc-index (car e) bsc-accs) 1))))
        (#t (map bsc-acc-red e))))
(define (bsc-conjs f) (if (dk-head-is? f 'AND) (append (bsc-conjs (cadr f)) (bsc-conjs (caddr f))) (list f)))
(define (bsc-iff-conjs thm tuple)       ; the conjuncts of THM's right side at TUPLE, accessors read off
  (let* ((f (lookup-theorem thm)) (v (cadr f)) (iff (caddr f)))
    (bsc-conjs (bsc-acc-red (bsc-replace v tuple (caddr iff))))))
(define (bsc-tuple n) (cons 'LIST (bsc-first n bsc-vals)))
(define bsc-cna-conjs (bsc-iff-conjs 'is-complex-normed-algebra (bsc-tuple 8)))
(define (bsc-law-thm! name conj hyp fin)
  (sp (make-wff (list 'FORALL 't (list 'IMPLIES hyp conj))))
  (dk-peel!)
  (if (not (dk-asm? '(IS-TOP-SPACE t))) (bsc-rhs! (dk-cite! 'is-compact-t 't)))
  (bsc-ring-subst!)
  (bsc-scal-typ!)
  (bsc-law-body! fin)
  (bsc-qed! name))
(define (bsc-alg-laws! conjs names)
  (for-each (lambda (k nm) (bsc-law-thm! nm (list-ref conjs k) '(IS-TOP-SPACE t) bsc-crs!)) (map car names) (map cadr names)))
(bsc-alg-laws! bsc-cna-conjs
  '((9 ccont-vadd-assoc) (10 ccont-vadd-comm) (11 ccont-vadd-ident) (12 ccont-vadd-inv) (13 ccont-vmul-assoc)
    (16 ccont-act-vadd) (17 ccont-act-add) (18 ccont-act-mul) (19 ccont-act-one)
    (24 ccont-vmul-vadd-right) (25 ccont-vmul-vadd-left) (26 ccont-vmul-act-left) (27 ccont-vmul-act-right)))

;;; ---- the norm laws ----
(define (bsc-subterms pred e) (cond ((pred e) (list e)) ((pair? e) (append-map (lambda (x) (bsc-subterms pred x)) e)) (#t '())))
(define (bsc-vnrm-subst!)
  (for-each (lambda (a) (bsc-ty! (cadr a)) (if (dk-contains? (dk-goal) a) (subst (dk-cite! 'ccont-vnrm-val 't (cadr a)))))
            (bsc-subterms (lambda (e) (and (pair? e) (equal? (car e) '(CCONT-VNRM t)) (= (length e) 2))) (dk-goal))))
(define (bsc-conj-typ!)
  (for-each (lambda (c) (if (not (dk-asm? (list 'IN c 'CC))) (dk-cite! 'cc-conjugate-closed (cadr c))))
            (bsc-subterms (lambda (e) (dk-head-is? e 'conjugate)) (dk-goal))))
(define (bsc-fin! z) (if (not (proof-done-here?)) (begin (bsc-conj-typ!) (crs))))
;;; a sup-norm law of part6 at h := H (H an expression in CCONT(t)): land its conclusion
(define (bsc-sn-law! lemma args h)
  (bsc-ty! h) (bsc-parts! h)
  (let ((r (apply dk-cite! lemma 't (append args (list h)))))
    (if (dk-head-is? r 'IMPLIES)
        (begin
          (dk-have! (cadr r) (lambda () (let ((z (dk-di-var!))) (bsc-ev! h z) (bsc-fin! z))))
          (dk-landed-1 (lambda () (detach! r))))
        r)))
(define (bsc-norm-thm! name conj prover)
  (sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) conj))))
  (dk-peel!)
  (bsc-rhs! (dk-cite! 'is-compact-t 't))
  (bsc-ring-subst!)
  (bsc-scal-typ!)
  (bsc-vnrm-subst!)
  (prover)
  (bsc-qed! name))
(bsc-norm-thm! 'ccont-vnrm-nonneg (list-ref bsc-cna-conjs 20) (lambda () (bsc-snr! 'x_) (bsc-ass!)))
(bsc-norm-thm! 'ccont-vnrm-zero-iff (list-ref bsc-cna-conjs 21)
  (lambda ()
    (dk-iff! (lambda (g) (dk-contains? g 'CCONT-VZERO))
      (lambda ()
        (let ((cl (dk-cite! 'sup-norm-t-zero-elim 't 'x_)))
          (bsc-law-eq! (lambda (z) (dk-apply! cl z) (bsc-ass!)))))
      (lambda ()
        (subst '(= x_ (CCONT-VZERO t)))
        (bsc-sn-law! 'sup-norm-t-zero-intro '() '(CCONT-VZERO t))
        (bsc-ass!)))))
(bsc-norm-thm! 'ccont-vnrm-act (list-ref bsc-cna-conjs 22)
  (lambda () (bsc-sn-law! 'sup-norm-t-scal '(r_ x_) '((CCONT-ACT t) r_ x_)) (bsc-ass!)))
(bsc-norm-thm! 'ccont-vnrm-triangle (list-ref bsc-cna-conjs 23)
  (lambda () (bsc-sn-law! 'sup-norm-t-add-le '(x_ y_) '((CCONT-VADD t) x_ y_)) (bsc-ass!)))
(bsc-norm-thm! 'ccont-vnrm-submult (list-ref bsc-cna-conjs 28)
  (lambda () (bsc-sn-law! 'sup-norm-t-mul-le '(x_ y_) '((CCONT-VMUL t) x_ y_)) (bsc-ass!)))

;;; ---- IS-COMPLEX-NORMED-ALGEBRA of the 8-tuple ----
(define bsc-cna-laws '(ccont-vadd-assoc ccont-vadd-comm ccont-vadd-ident ccont-vadd-inv ccont-vmul-assoc ccont-act-vadd
  ccont-act-add ccont-act-mul ccont-act-one ccont-vmul-vadd-right ccont-vmul-vadd-left ccont-vmul-act-left
  ccont-vmul-act-right ccont-vnrm-nonneg ccont-vnrm-zero-iff ccont-vnrm-act ccont-vnrm-triangle ccont-vnrm-submult))
(define (bsc-alg-typings!)
  (if (not (dk-asm? '(IS-TOP-SPACE t))) (bsc-rhs! (dk-cite! 'is-compact-t 't)))
  (for-each (lambda (n) (dk-cite! n 't))
            '(ccont-is-set ccont-vadd-type ccont-vmul-type ccont-vneg-type ccont-vstar-type ccont-act-type
              ccont-vzero-type ccont-vone-type ccont-vnrm-type))
  (dk-cite! 'cc-is-normed-field)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
  (dk-cite! 'commutative-ring-is-ring bsc-ring))
(define (bsc-conj-closer!)
  (let ((g (dk-goal)))
    (cond ((proof-done-here?) #t)
          ((dk-asm? g) (bsc-ass!))
          ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH)) (len-r) (if (not (proof-done-here?)) (arith)))
          ((and (dk-head-is? g 'IN) (eq? (caddr g) 'SET) (dk-head-is? (cadr g) 'LIST)) (dk-list-in-set!))
          ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))
          ((equal? g (list '= (list 'CARR bsc-ring) 'CC)) (dk-cite! 'sip-cc-ring-carr) (bsc-ass!))
          ((dk-contains? g (list 'CARR bsc-ring)) (bsc-ring-subst!) (bsc-conj-closer!))
          (#t (bsc-ass!)))))
(define (bsc-unfold-tuple! iff n)
  (mac iff)
  (for-each (lambda (a) (if (dk-contains? (dk-goal) a) (slot a))) (bsc-first n bsc-accs))
  (let loop ((k 0)) (if (and (< k 40) (dk-contains? (dk-goal) 'NTH)) (begin (nth-r) (loop (+ k 1))))))
(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'IS-COMPLEX-NORMED-ALGEBRA (bsc-tuple 8))))))
(dk-peel!)
(bsc-alg-typings!)
(for-each (lambda (n) (dk-cite! n 't)) bsc-cna-laws)
(bsc-unfold-tuple! 'is-complex-normed-algebra 8)
(dk-conj-close! bsc-conj-closer!)
(bsc-qed! 'ccont-algebra-is-cna)
;;; ================================================================================================
;;; part10: the read-offs of the tuple, the metric of the normed group, and COMPLETENESS
;;; ================================================================================================
(define (bsc-readoff! name n acc val)
  (sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list '== (list acc (bsc-tuple n)) val)))))
  (dk-peel!)
  (bsc-alg-typings!)
  (slot acc)
  (let loop ((k 0)) (if (and (< k 10) (dk-contains? (dk-goal) 'NTH)) (begin (nth-r) (loop (+ k 1)))))
  (if (not (proof-done? *ps*)) (qrfl))
  (bsc-qed! name))
(define (bsc-acc-name n acc) (symbol-append 'ccont-tuple (string->symbol (number->string n)) '- acc))
(define (bsc-readoffs! n)
  (for-each (lambda (acc v) (bsc-readoff! (bsc-acc-name n acc) n acc v)) (bsc-first n bsc-accs) (bsc-first n bsc-vals)))
(bsc-readoffs! 8)
(define bsc-L8 (bsc-tuple 8))
(define bsc-N (list 'CNA-AS-NORMED-AG bsc-L8))
(define bsc-MSP (list 'NAG-METRIC-SPACE bsc-N))
(define (bsc-cite-readoffs! n) (for-each (lambda (acc) (dk-cite! (bsc-acc-name n acc) 't)) (bsc-first n bsc-accs)))
(define (bsc-rw-h! f n)                ; rewrite every accessor of the n-tuple in hypothesis F by its value
  (let loop ((acc f) (as (bsc-first n bsc-accs)) (vs (bsc-first n bsc-vals)))
    (if (null? as) acc
        (let ((from (list (car as) (bsc-tuple n))))
          (loop (if (dk-contains? acc from) (dk-rewrite-h! acc from (car vs)) acc) (cdr as) (cdr vs))))))

;;; the distance of the metric space of the normed group: d(u, v) = ||u - v||
(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t)
  (list 'FORALL 'u (list 'IMPLIES '(IN u (CCONT t)) (list 'FORALL 'v (list 'IMPLIES '(IN v (CCONT t))
    (list '= (list (list 'DIST bsc-MSP) 'u 'v) '(SUP-NORM-T t ((CCONT-VADD t) u ((CCONT-VNEG t) v))))))))))))
(dk-peel!)
(bsc-alg-typings!)
(dk-cite! 'ccont-algebra-is-cna 't)
(bsc-cite-readoffs! 8)
(let* ((d0 (dk-cite! 'nag-metric-distance-cna-as-normed-ag bsc-L8))
       (d1 (bsc-rw-h! d0 8))
       (e1 (dk-apply! d1 'u 'v))
       (e2 (bsc-rw-h! e1 8))
       (h '((CCONT-VADD t) u ((CCONT-VNEG t) v))))
  (bsc-ty! h)
  (dk-cite! 'ccont-vnrm-val 't h)
  (subst (list '= (list (list 'DIST bsc-MSP) 'u 'v) (list '(CCONT-VNRM t) h)))
  (subst (list '= (list '(CCONT-VNRM t) h) (list 'SUP-NORM-T 't h)))
  (if (not (proof-done? *ps*)) (begin (bsc-snr! h) (rfl))))
(bsc-qed! 'ccont-algebra-dist)

;;; f(i) in CCONT(t) for f in FUN(NN, CCONT t)
(define (bsc-fi! f i) (if (not (dk-asm? (list 'IN (list f i) '(CCONT t)))) (dk-cite! 'fun-apply-type-c f 'NN '(CCONT t) i)))
;;; THE METRIC SPACE OF CCONT-ALGEBRA(t) IS COMPLETE
(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'IS-COMPLETE bsc-MSP)))))
(dk-peel!)
(bsc-alg-typings!)
(dk-cite! 'ccont-algebra-is-cna 't)
(bsc-cite-readoffs! 8)
(define bsc-ms (dk-cite! 'nag-metric-space-is-metric-space-cna-as-normed-ag bsc-L8))
(define bsc-ptsM (dk-cite! 'nag-metric-carrier-cna-as-normed-ag bsc-L8))
(mac 'is-complete)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IS-METRIC-SPACE) (bsc-ass!)
      (let* ((pe (dk-peel!))
             (f (caddr (car (filter (lambda (x) (dk-head-is? x 'IS-CAUCHY-SEQ)) pe))))
             (_1 (bsc-rhs! (dk-cite! 'is-cauchy-seq bsc-MSP f)))
             (fty0 (list 'IN f (list 'FUN 'NN (list 'PTS bsc-MSP))))
             (fty (bsc-rw-h! (dk-rewrite-h! fty0 (list 'PTS bsc-MSP) (list 'VEC bsc-L8)) 8))
             (cl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'DIST))) "the Cauchy clause"))
             (U (bsc-replace 's f bsc-uc)))
        ;; the sequence is uniformly Cauchy, pointwise
        (dk-have! U
          (lambda ()
            (let* ((eps (cadr (car (filter (lambda (x) (dk-head-is? x 'POS-RR)) (dk-peel!)))))
                   (d (dk-halve! eps))
                   (n (dk-skolem! (dk-apply! cl d)))
                   (c2 (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x n) (dk-contains? x 'DIST))) "the clause at n")))
              (dk-cite! 'rr-pos-rr-in-rr eps)
              (ew n)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-head-is? (dk-goal) 'FORALL)) (bsc-ass!)
                    (let* ((pe2 (dk-peel!))
                           (g (dk-goal)) (A (cadr (cadr g)))        ; (- ((f i) z) ((f j) z))
                           (fi (car (cadr A))) (fj (car (caddr A))) (z (cadr (cadr A)))
                           (i (cadr fi)) (j (cadr fj))
                           (h (list '(CCONT-VADD t) fi (list '(CCONT-VNEG t) fj))))
                      (bsc-fi! f i) (bsc-fi! f j)
                      (dk-have! (list 'AND (list '<= n i) (list '<= n j)) (lambda () (dk-conj-close! (lambda () (bsc-ass!)))))
                      (let* ((dl (dk-apply! c2 i j))
                             (de (dk-cite! 'ccont-algebra-dist 't fi fj))
                             (dl2 (dk-rewrite-h! dl (cadr de) (caddr de))))
                        (bsc-ty! h) (bsc-parts! h) (bsc-snr! h)
                        (let ((up (dk-cite! 'sup-norm-t-upper 't h z)))
                          (bsc-val! fi z) (bsc-val! fj z)
                          (bsc-magr! (list h z)) (bsc-magr! A)
                          (let ((me (list '= (bsc-mag A) (bsc-mag (list h z)))))
                            (dk-have! me
                              (lambda ()
                                (bsc-ev! h z)
                                (bsc-cc! (list '- (list fi z) (list fj z)))
                                (bsc-cc! (list '+ (list fi z) (list '- (list fj z))))
                                (dk-have! (list '= (list '- (list fi z) (list fj z)) (list '+ (list fi z) (list '- (list fj z)))) (lambda () (crs)))
                                (subst (list '= (list '- (list fi z) (list fj z)) (list '+ (list fi z) (list '- (list fj z)))))
                                (bsc-magr! (list '+ (list fi z) (list '- (list fj z))))
                                (if (not (proof-done-here?)) (rfl))))
                            (dk-ineq! me up dl2 (list '= (list '+ d d) eps) (list '< 0 d)
                                      (list 'IN (bsc-mag A) 'RR) (list 'IN (bsc-mag (list h z)) 'RR)
                                      (list 'IN (bsc-sn h) 'RR) (list 'IN d 'RR) (list 'IN eps 'RR))))))))))))
        ;; its uniform limit
        (let* ((gv (dk-skolem! (dk-cite! 'ccont-uniformly-complete 't f)))
               (_3 (dk-split-all!))
               (ut (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x gv) (dk-contains? x 'magnitude))) "the uniform limit")))
          (mac 'converges)
          (ew gv)
          (mac 'converges-to)
          (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond ((dk-asm? g) (bsc-ass!))
                      ((and (dk-head-is? g 'IN) (equal? (caddr g) (list 'PTS bsc-MSP)))
                       (subst bsc-ptsM) (subst (list '= (list 'VEC bsc-L8) '(CCONT t))) (bsc-ass!))
                      (#t
                       (let* ((eps (cadr (car (filter (lambda (x) (dk-head-is? x 'POS-RR)) (dk-peel!)))))
                              (cap (dk-skolem! (dk-apply! ut eps)))
                              (c3 (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x cap) (dk-contains? x 'magnitude))) "the bound at cap")))
                         (dk-cite! 'rr-pos-rr-in-rr eps)
                         (dk-pos-parts! eps)
                         (ew cap)
                         (dk-conj-close!
                           (lambda ()
                             (if (not (dk-head-is? (dk-goal) 'FORALL)) (bsc-ass!)
                               (let* ((pe3 (dk-peel!))
                                      (gg (dk-goal)) (fn (cadr (cadr gg))) (nn_ (cadr fn))
                                      (h (list '(CCONT-VADD t) fn (list '(CCONT-VNEG t) gv))))
                                 (bsc-fi! f nn_)
                                 (subst (dk-cite! 'ccont-algebra-dist 't fn gv))
                                 (bsc-ty! h) (bsc-parts! h)
                                 (let ((lr (dk-cite! 'sup-norm-t-least 't h eps)))
                                   (dk-have! (cadr lr)
                                     (lambda ()
                                       (let ((x (dk-di-var!)))
                                         (bsc-ev! h x)
                                         (bsc-val! fn x) (bsc-val! gv x)
                                         (bsc-cc! (list '- (list fn x) (list gv x)))
                                         (bsc-cc! (list '+ (list fn x) (list '- (list gv x))))
                                         (dk-have! (list '= (list '+ (list fn x) (list '- (list gv x))) (list '- (list fn x) (list gv x))) (lambda () (crs)))
                                         (subst (list '= (list '+ (list fn x) (list '- (list gv x))) (list '- (list fn x) (list gv x))))
                                         (dk-apply! c3 nn_ x)
                                         (bsc-ass!))))
                                   (let ((lc (dk-landed-1 (lambda () (detach! lr)))))
                                     (dk-split-all! (list lc))
                                     (bsc-ass!))))))))))))))))))
(bsc-qed! 'ccont-algebra-complete)
;;; ================================================================================================
;;; part11: unit, involution and C* laws; the tower IS-CBA < IS-UBA < IS-UIBA < IS-UCSA < IS-CCSA
;;; ================================================================================================
(define bsc-uba-conjs (bsc-iff-conjs 'is-unital-banach-algebra (bsc-tuple 9)))
(define bsc-uiba-conjs (bsc-iff-conjs 'is-unital-involutive-banach-algebra (bsc-tuple 10)))
(define bsc-ucsa-conjs (bsc-iff-conjs 'is-unital-c-star-algebra-def (bsc-tuple 10)))
(define bsc-ccsa-conjs (bsc-iff-conjs 'is-commutative-c-star-algebra-def (bsc-tuple 10)))
(define bsc-nonempty '(FORSOME tp_ (IN tp_ (PTS t))))

;;; conjugate pushed through + and *, and cancelled against itself; then the ring identity
(define (bsc-conj-step!)
  (let ((hits (bsc-subterms (lambda (e) (and (dk-head-is? e 'conjugate) (pair? (cadr e))
                                             (memq (car (cadr e)) '(+ * conjugate))))
                            (dk-goal))))
    (if (null? hits) #f
        (let* ((c (car hits)) (a (cadr c)))
          (case (car a)
            ((+) (bsc-cc! (cadr a)) (bsc-cc! (caddr a)) (subst (bsc-fact! 'cc-conjugate-add (cadr a) (caddr a))))
            ((*) (bsc-cc! (cadr a)) (bsc-cc! (caddr a)) (subst (bsc-fact! 'cc-conjugate-mul (cadr a) (caddr a))))
            (else (bsc-cc! (cadr a)) (subst (dk-cite! 'cc-conjugate-involution (cadr a)))))
          #t))))
(define (bsc-star-fin! z)
  (let loop ((k 0)) (if (and (< k 10) (not (proof-done-here?)) (bsc-conj-step!)) (loop (+ k 1))))
  (bsc-fin! z))
(define (bsc-alg-law-list! conjs names fin)
  (for-each (lambda (k nm) (bsc-law-thm! nm (list-ref conjs k) '(IS-TOP-SPACE t) fin)) (map car names) (map cadr names)))
(bsc-alg-law-list! bsc-uba-conjs '((12 ccont-vmul-unit-left) (13 ccont-vmul-unit-right)) bsc-crs!)
(bsc-alg-law-list! bsc-uiba-conjs '((13 ccont-vstar-vadd) (14 ccont-vstar-act) (15 ccont-vstar-vstar) (16 ccont-vstar-vmul))
  bsc-star-fin!)
(bsc-alg-law-list! bsc-ccsa-conjs '((1 ccont-vmul-comm)) bsc-crs!)
(bsc-norm-thm! 'ccont-vnrm-vstar (list-ref bsc-uiba-conjs 17)
  (lambda () (bsc-sn-law! 'sup-norm-t-conj '(x_) '((CCONT-VSTAR t) x_)) (bsc-ass!)))
(bsc-norm-thm! 'ccont-vnrm-cstar (list-ref bsc-ucsa-conjs 1)
  (lambda () (bsc-sn-law! 'sup-norm-t-cstar '(x_) '((CCONT-VMUL t) ((CCONT-VSTAR t) x_) x_)) (bsc-ass!)))
(bsc-norm-thm! 'ccont-vnrm-vone (list 'IMPLIES bsc-nonempty (list-ref bsc-uba-conjs 14))
  (lambda () (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
             (bsc-vnrm-subst!)
             (bsc-sn-law! 'sup-norm-t-one '() '(CCONT-VONE t)) (bsc-ass!)))

;;; ---- the tower ----
(define (bsc-tower! name hyps pred n iff lemmas)
  (sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t)
                  (let wrap ((hs hyps)) (if (null? hs) (list pred (bsc-tuple n)) (list 'IMPLIES (car hs) (wrap (cdr hs)))))))))
  (dk-peel!)
  (bsc-alg-typings!)
  (for-each (lambda (l) (if (pair? l) (apply dk-cite! l) (dk-cite! l 't))) lemmas)
  (bsc-unfold-tuple! iff n)
  (dk-conj-close! bsc-conj-closer!)
  (bsc-qed! name))
(bsc-tower! 'ccont-algebra-is-cba '() 'IS-COMPLEX-BANACH-ALGEBRA 8 'is-complex-banach-algebra-def
  '(ccont-algebra-is-cna ccont-algebra-complete))
(bsc-tower! 'ccont-algebra-is-uba (list bsc-nonempty) 'IS-UNITAL-BANACH-ALGEBRA 9 'is-unital-banach-algebra
  '(ccont-algebra-is-cba ccont-vmul-unit-left ccont-vmul-unit-right ccont-vnrm-vone))
(bsc-tower! 'ccont-algebra-is-uiba (list bsc-nonempty) 'IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA 10 'is-unital-involutive-banach-algebra
  '(ccont-algebra-is-uba ccont-vstar-vadd ccont-vstar-act ccont-vstar-vstar ccont-vstar-vmul ccont-vnrm-vstar))
(bsc-tower! 'ccont-algebra-is-ucsa-tuple (list bsc-nonempty) 'IS-UNITAL-C-STAR-ALGEBRA 10 'is-unital-c-star-algebra-def
  '(ccont-algebra-is-uiba ccont-vnrm-cstar))
(bsc-tower! 'ccont-algebra-is-ccsa-tuple (list bsc-nonempty) 'IS-COMMUTATIVE-C-STAR-ALGEBRA 10 'is-commutative-c-star-algebra-def
  '(ccont-algebra-is-ucsa-tuple ccont-vmul-comm))

;;; ---- THE THEOREMS: C(t) is a commutative unital C*-algebra, t compact and nonempty ----
(define (bsc-final! name pred tuple-thm)
  (sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'IMPLIES bsc-nonempty (list pred '(CCONT-ALGEBRA t)))))))
  (dk-peel!)
  (dk-cite! tuple-thm 't)
  (mac 'CCONT-ALGEBRA)
  (bsc-ass!)
  (bsc-qed! name))
(bsc-final! 'ccont-algebra-unital-c-star 'IS-UNITAL-C-STAR-ALGEBRA 'ccont-algebra-is-ucsa-tuple)
(bsc-final! 'ccont-algebra-commutative-c-star 'IS-COMMUTATIVE-C-STAR-ALGEBRA 'ccont-algebra-is-ccsa-tuple)
;;; ================================================================================================
;;; part12: a compact Hausdorff space is NORMAL, by two applications of bsw-compact-induction
;;; ================================================================================================
(define (bsn-empty-absurd! z)
  (let ((n (dk-cite! 'empty-set-has-no-members z))) (if (dk-only! n (list 'IN z 'EMPTY-SET)) (prop))))
(define (bsn-in-power! w)              ; (SUBSET w (PTS t)) in context: land w in POWER(PTS t)
  (dk-cite! 'subclass-of-set-is-set w '(PTS t))
  (let ((imp (dk-cite! 'power-mem-intro '(PTS t) w)))
    (dk-have! (cadr imp) (lambda () (let ((z (dk-di-var!))) (dk-cite! 'subset-mem-fwd w '(PTS t) z) (bsc-ass!))))
    (detach! imp)))
(define (bsn-sub! thunk) (mac 'subset-def) (let ((z (dk-di-var!))) (thunk z)))
(define (bsn-false! . fs) (if (apply dk-only! fs) (prop)))
(define (bsn-disj! thunk)              ; goal (FORALL x (IMPLIES (IN x u) (NOT (IN x v)))): THUNK x with (IN x v) landed
  (let ((x (dk-di-var!))) (di) (thunk x)))
(define (bsn-union-in! z a b)          ; (IN z a) in context: land (IN z (UNION a b))
  (bsc-lhs! (dk-cite! 'union-membership a b z) (lambda () (bsn-false-or! z a b))))
(define (bsn-false-or! z a b) (if (dk-only! (if (dk-asm? (list 'IN z a)) (list 'IN z a) (list 'IN z b))) (prop)))
(define (bst2-other! z a b)          ; (OR (IN z a) (IN z b)), (NOT (IN z a)) in context: land (IN z b)
  (if (not (dk-asm? (list 'IN z b))) (dk-have! (list 'IN z b) (lambda () (if (dk-only! (list 'OR (list 'IN z a) (list 'IN z b)) (list 'NOT (list 'IN z a))) (prop))))))
(define (bsn-union-out! z a b) (bsc-rhs! (dk-cite! 'union-membership a b z)))
(define (bsn-detach-all! r) (if (dk-head-is? r 'IMPLIES) (bsn-detach-all! (dk-landed-1 (lambda () (detach! r)))) r))
(define (bsn-top-inter! u v)          ; the intersection clause of IS-TOP-SPACE (not the Hausdorff one)
  (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'INTERSECTION) (dk-contains? h '(OPENS t))
                                       (not (dk-contains? h 'EMPTY-SET)) (not (dk-contains? h 'FORSOME))))
                      "the intersection clause")
             u v))
(define (bsn-wit! u v closer) (ew u) (ew v) (dk-conj-close! closer))
(define (bsn-top! hyps)                ; open the hypotheses: compact, top space, closed sets
  (bsc-rhs! (dk-cite! 'is-compact-t 't))
  (bsc-rhs! (dk-cite! 'is-top-space 't))
  (for-each (lambda (k) (bsc-rhs! (dk-cite! 'is-top-closed 't k))) hyps)
  (dk-cite! 'power-set '(PTS t)))

;;; the union of two open sets is open
(sp (make-wff '(FORALL t (IMPLIES (IS-TOP-SPACE t) (FORALL u (IMPLIES (IN u (OPENS t)) (FORALL v (IMPLIES (IN v (OPENS t))
   (IN (UNION u v) (OPENS t))))))))))
(dk-peel!)
(dk-cite! 'top-open-subset 't 'u) (dk-cite! 'top-open-subset 't 'v)
(let ((imp (dk-cite! 'top-open-of-local 't '(UNION u v))))
  (dk-have! '(SUBSET (UNION u v) (PTS t))
    (lambda () (bsn-sub! (lambda (z) (bsn-union-out! z 'u 'v)
                 (use-em (list 'IN z 'u) (lambda () (dk-cite! 'subset-mem-fwd 'u '(PTS t) z) (bsc-ass!))
                                         (lambda () (bst2-other! z 'u 'v) (dk-cite! 'subset-mem-fwd 'v '(PTS t) z) (bsc-ass!)))))))
  (let ((r1 (dk-landed-1 (lambda () (detach! imp)))))
    (dk-have! (cadr r1)
      (lambda ()
        (let ((a (dk-di-var!)))
          (bsn-union-out! a 'u 'v)
          (use-em (list 'IN a 'u)
            (lambda () (ew 'u) (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'SUBSET) (bsn-sub! (lambda (z) (bsn-union-in! z 'u 'v))) (bsc-ass!)))))
            (lambda () (bst2-other! a 'u 'v) (ew 'v) (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'SUBSET) (bsn-sub! (lambda (z) (bsn-union-in! z 'u 'v))) (bsc-ass!)))))))))
    (detach! r1)
    (bsc-ass!)))
(bsc-qed! 'top-open-union2)

;;; (a) a point and a closed set not containing it have disjoint open neighbourhoods
(define (bsn-disj u v) (list 'FORALL 'nx_ (list 'IMPLIES (list 'IN 'nx_ u) (list 'NOT (list 'IN 'nx_ v)))))
(define (bsn-sep-body pin sub)          ; exists open u, v: PIN(u), SUB(v), u and v disjoint
  (list 'FORSOME 'nu_ (list 'FORSOME 'nv_ (list 'AND '(IN nu_ (OPENS t)) (list 'AND '(IN nv_ (OPENS t))
    (list 'AND (pin 'nu_) (list 'AND (sub 'nv_) (bsn-disj 'nu_ 'nv_))))))))
(define bsn-C1 (list 'SEP 'nw_ '(POWER (PTS t))
  (bsn-sep-body (lambda (u) (list 'IN 'p u)) (lambda (v) (list 'SUBSET '(INTERSECTION nw_ k) v)))))
(define (bsn-in-c! w c prop!)          ; goal (IN w C), (SUBSET w (PTS t)) in context
  (in-sep! (lambda () (bsn-in-power! w) (bsc-ass!)) prop!))
;;; the two witnesses of a member of C, with their clauses
(define (bsn-open-c! w c)
  (dk-project! (list 'IN w '(POWER (PTS t))) (lambda () (sep-me (list 'IN w c))))
  (sep-me (list 'IN w c))
  (let* ((u (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'nu_))) "the u witness")))
         (v (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h u))) "the v witness"))))
    (dk-split-all!)
    (list u v (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u) (dk-contains? h v))) "disjointness"))))
(define (bsn-closer sub! disj!)
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (bsc-ass!))
            ((dk-head-is? g 'SUBSET) (bsn-sub! sub!))
            ((dk-head-is? g 'FORALL) (bsn-disj! disj!))
            ((and (dk-head-is? g 'IN) (dk-head-is? (caddr g) 'INTERSECTION)) (bsc-inter-in! (cadr g) (cadr (caddr g)) (caddr (caddr g))))
            (#t (bsc-ass!))))))
(define (bsn-power-sub! w)
  (if (not (dk-asm? (list 'SUBSET w '(PTS t))))
      (dk-have! (list 'SUBSET w '(PTS t)) (lambda () (bsn-sub! (lambda (z) (dk-cite! 'power-mem-in '(PTS t) w z) (bsc-ass!)))))))
(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'IMPLIES '(IS-HAUSDORFF t)
  (list 'FORALL 'k (list 'IMPLIES '(IS-TOP-CLOSED t k) (list 'FORALL 'p (list 'IMPLIES '(IN p (PTS t)) (list 'IMPLIES '(NOT (IN p k))
    (bsn-sep-body (lambda (u) (list 'IN 'p u)) (lambda (v) (list 'SUBSET 'k v)))))))))))))
(dk-peel!)
(bsn-top! '(k))
(define bsn-hc (let ((iff (dk-cite! 'is-hausdorff 't))) (bsc-rhs! iff)
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'INTERSECTION) (dk-contains? h 'EMPTY-SET))) "the Hausdorff clause")))
(define bsn-O '(COMPLEMENT-IN (PTS t) k))
(let ((imp (dk-cite! 'bsw-compact-induction 't bsn-C1)))
  ;; the empty set
  (dk-have! (list 'IN 'EMPTY-SET bsn-C1)
    (lambda ()
      (dk-cite! 'empty-set-is-set)
      (dk-have! '(SUBSET EMPTY-SET (PTS t)) (lambda () (bsn-sub! (lambda (z) (bsn-empty-absurd! z)))))
      (bsn-in-c! 'EMPTY-SET bsn-C1
        (lambda () (bsn-wit! '(PTS t) 'EMPTY-SET
          (bsn-closer (lambda (z) (bsc-inter-out! z 'EMPTY-SET 'k) (bsn-empty-absurd! z))
                      (lambda (x) (bsn-empty-absurd! x))))))))
  ;; binary unions
  (dk-have! (list 'FORALL 'ka (list 'IMPLIES (list 'IN 'ka bsn-C1) (list 'FORALL 'kb (list 'IMPLIES (list 'IN 'kb bsn-C1) (list 'IN '(UNION ka kb) bsn-C1)))))
    (lambda ()
      (let* ((pe (dk-peel!)) (g (dk-goal)) (a (cadr (cadr g))) (b (caddr (cadr g))) (un (list 'UNION a b))
             (w1 (bsn-open-c! a bsn-C1)) (u1 (car w1)) (v1 (cadr w1)) (d1 (caddr w1))
             (w2 (bsn-open-c! b bsn-C1)) (u2 (car w2)) (v2 (cadr w2)) (d2 (caddr w2)))
        (bsn-power-sub! a) (bsn-power-sub! b)
        (dk-have! (list 'SUBSET un '(PTS t))
          (lambda () (bsn-sub! (lambda (z) (bsn-union-out! z a b)
                       (use-em (list 'IN z a) (lambda () (dk-cite! 'subset-mem-fwd a '(PTS t) z) (bsc-ass!))
                                              (lambda () (bst2-other! z a b) (dk-cite! 'subset-mem-fwd b '(PTS t) z) (bsc-ass!)))))))
        (bsn-top-inter! u1 u2)
        (dk-cite! 'top-open-union2 't v1 v2)
        (bsn-in-c! un bsn-C1
          (lambda () (bsn-wit! (list 'INTERSECTION u1 u2) (list 'UNION v1 v2)
            (bsn-closer
              (lambda (z) (bsc-inter-out! z un 'k) (bsn-union-out! z a b)
                (use-em (list 'IN z a)
                  (lambda () (bsc-inter-in! z a 'k) (dk-cite! 'subset-mem-fwd (list 'INTERSECTION a 'k) v1 z) (bsn-union-in! z v1 v2))
                  (lambda () (bst2-other! z a b) (bsc-inter-in! z b 'k) (dk-cite! 'subset-mem-fwd (list 'INTERSECTION b 'k) v2 z) (bsn-union-in! z v1 v2))))
              (lambda (x) (bsc-inter-out! x u1 u2) (bsn-union-out! x v1 v2)
                (let* ((n1 (dk-apply! d1 x)) (n2 (dk-apply! d2 x)))
                  (bsn-false! n1 n2 (list 'OR (list 'IN x v1) (list 'IN x v2))))))))))))
  ;; a neighbourhood of every point
  (dk-have! (list 'FORALL 'q (list 'IMPLIES '(IN q (PTS t)) (list 'FORSOME 'u (list 'AND '(IN u (OPENS t)) (list 'AND '(IN q u) (list 'IN 'u bsn-C1))))))
    (lambda ()
      (let ((q (dk-di-var!)))
        (use-em (list 'IN q 'k)
          (lambda ()
            (dk-have! (list 'NOT (list '== 'p q))
              (lambda () (di) (let ((pk (dk-rewrite-h! (list 'IN q 'k) q 'p))) (bsn-false! pk '(NOT (IN p k))))))
            (let* ((a (dk-skolem! (dk-apply! bsn-hc 'p q)))
                   (b (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h a))) "the second open set"))))
              (dk-split-all!)
              (dk-cite! 'top-open-subset 't b)
              (ew b)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal)) (bsc-ass!)
                    (bsn-in-c! b bsn-C1
                      (lambda () (bsn-wit! a b
                        (bsn-closer (lambda (z) (bsc-inter-out! z b 'k) (bsc-ass!))
                                    (lambda (x) (bsc-inter-in! x a b)
                                      (let ((e (dk-rewrite-h! (list 'IN x (list 'INTERSECTION a b)) (list 'INTERSECTION a b) 'EMPTY-SET)))
                                        (bsn-empty-absurd! x))))))))))))
          (lambda ()
            (dk-cite! 'complement-in-subset 'k '(PTS t))
            (ew bsn-O)
            (dk-conj-close!
              (lambda ()
                (let ((g (dk-goal)))
                  (cond ((dk-asm? g) (bsc-ass!))
                        ((equal? g (list 'IN q bsn-O))
                         (bsc-lhs! (dk-cite! 'complement-in-membership '(PTS t) 'k q) (lambda () (dk-conj-close! (lambda () (bsc-ass!))))))
                        (#t
                         (bsn-in-c! bsn-O bsn-C1
                           (lambda () (bsn-wit! '(PTS t) 'EMPTY-SET
                             (bsn-closer (lambda (z) (bsc-inter-out! z bsn-O 'k)
                                           (bsc-rhs! (dk-cite! 'complement-in-membership '(PTS t) 'k z))
                                           (bsn-false! (list 'IN z 'k) (list 'NOT (list 'IN z 'k))))
                                         (lambda (x) (bsn-empty-absurd! x))))))))))))))))
  (bsn-detach-all! imp))
;; PTS t is in the class
(let* ((w (bsn-open-c! '(PTS t) bsn-C1)) (u (car w)) (v (cadr w)))
  (bsn-wit! u v
    (bsn-closer (lambda (z) (dk-cite! 'subset-mem-fwd 'k '(PTS t) z) (bsc-inter-in! z '(PTS t) 'k)
                  (dk-cite! 'subset-mem-fwd '(INTERSECTION (PTS t) k) v z) (bsc-ass!))
                (lambda (x) (bsn-false! (dk-apply! (caddr w) x) (list 'IN x v))))))
(bsc-qed! 'top-hausdorff-point-closed-sep)

;;; (b) two disjoint closed sets have disjoint open neighbourhoods: compact Hausdorff => normal
(define bsn-C2 (list 'SEP 'nw_ '(POWER (PTS t))
  (bsn-sep-body (lambda (u) (list 'SUBSET '(INTERSECTION nw_ a) u)) (lambda (v) (list 'SUBSET 'b v)))))
(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'IMPLIES '(IS-HAUSDORFF t)
  (list 'FORALL 'a (list 'IMPLIES '(IS-TOP-CLOSED t a) (list 'FORALL 'b (list 'IMPLIES '(IS-TOP-CLOSED t b)
    (list 'IMPLIES (bsn-disj 'a 'b)
      (bsn-sep-body (lambda (u) (list 'SUBSET 'a u)) (lambda (v) (list 'SUBSET 'b v)))))))))))))
(dk-peel!)
(bsn-top! '(a b))
(define bsn-dab (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (equal? (caddr h) '(IMPLIES (IN nx_ a) (NOT (IN nx_ b)))))) "a, b disjoint"))
(define bsn-Oa '(COMPLEMENT-IN (PTS t) a))
(let ((imp (dk-cite! 'bsw-compact-induction 't bsn-C2)))
  ;; the empty set
  (dk-have! (list 'IN 'EMPTY-SET bsn-C2)
    (lambda ()
      (dk-cite! 'empty-set-is-set)
      (dk-have! '(SUBSET EMPTY-SET (PTS t)) (lambda () (bsn-sub! (lambda (z) (bsn-empty-absurd! z)))))
      (bsn-in-c! 'EMPTY-SET bsn-C2
        (lambda () (bsn-wit! 'EMPTY-SET '(PTS t)
          (bsn-closer (lambda (z) (bsc-inter-out! z 'EMPTY-SET 'a) (bsn-empty-absurd! z))
                      (lambda (x) (bsn-empty-absurd! x))))))))
  ;; binary unions
  (dk-have! (list 'FORALL 'ka (list 'IMPLIES (list 'IN 'ka bsn-C2) (list 'FORALL 'kb (list 'IMPLIES (list 'IN 'kb bsn-C2) (list 'IN '(UNION ka kb) bsn-C2)))))
    (lambda ()
      (let* ((pe (dk-peel!)) (g (dk-goal)) (w1 (cadr (cadr g))) (w2 (caddr (cadr g))) (un (list 'UNION w1 w2))
             (o1 (bsn-open-c! w1 bsn-C2)) (u1 (car o1)) (v1 (cadr o1)) (d1 (caddr o1))
             (o2 (bsn-open-c! w2 bsn-C2)) (u2 (car o2)) (v2 (cadr o2)) (d2 (caddr o2)))
        (bsn-power-sub! w1) (bsn-power-sub! w2)
        (dk-have! (list 'SUBSET un '(PTS t))
          (lambda () (bsn-sub! (lambda (z) (bsn-union-out! z w1 w2)
                       (use-em (list 'IN z w1) (lambda () (dk-cite! 'subset-mem-fwd w1 '(PTS t) z) (bsc-ass!))
                                               (lambda () (bst2-other! z w1 w2) (dk-cite! 'subset-mem-fwd w2 '(PTS t) z) (bsc-ass!)))))))
        (bsn-top-inter! v1 v2)
        (dk-cite! 'top-open-union2 't u1 u2)
        (bsn-in-c! un bsn-C2
          (lambda () (bsn-wit! (list 'UNION u1 u2) (list 'INTERSECTION v1 v2)
            (lambda ()
              (let ((gg (dk-goal)))
                (cond ((dk-asm? gg) (bsc-ass!))
                      ((and (dk-head-is? gg 'SUBSET) (equal? (cadr gg) 'b))
                       (bsn-sub! (lambda (z) (dk-cite! 'subset-mem-fwd 'b v1 z) (dk-cite! 'subset-mem-fwd 'b v2 z) (bsc-inter-in! z v1 v2))))
                      ((dk-head-is? gg 'SUBSET)
                       (bsn-sub! (lambda (z) (bsc-inter-out! z un 'a) (bsn-union-out! z w1 w2)
                         (use-em (list 'IN z w1)
