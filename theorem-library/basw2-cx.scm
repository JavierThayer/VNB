(define (bsc-near-stmt op)
  (list 'FORALL 'a (list 'IMPLIES '(IN a CC) (list 'FORALL 'b (list 'IMPLIES '(IN b CC)
    (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
      (list 'FORSOME 'd (list 'AND '(POS-RR d)
        (list 'FORALL 'x (list 'IMPLIES '(IN x CC) (list 'FORALL 'y (list 'IMPLIES '(IN y CC)
          (list 'IMPLIES '(< (magnitude (- a x)) d) (list 'IMPLIES '(< (magnitude (- b y)) d)
            (list '< (bsc-mag (list '- (op 'a 'b) (op 'x 'y))) 'eps))))))))))))))))
