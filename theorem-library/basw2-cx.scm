(define bsq-g '(VNB-LAMBDA pgx_ (PTS t) (sqrt (abs (real-part (f pgx_))))))
(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'FORALL 'f (list 'IMPLIES '(IN f (CCONT t))
  (list 'IMPLIES (bsc-nn-body 'f) (list 'IN 'f (list 'POS-CONE bsc-A)))))))))
(dk-peel!)
(bsc-alg-typings!)
(for-each (lambda (acc) (dk-cite! (bsc-aname acc) 't)) bsc-accs)
(bsc-parts! 'f)
(define bsq-nn (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'pnx_))) "the values of f"))
(define (bsq-fval! z)                  ; f z in RR, 0 <= f z, Re(f z) = f z, |f z| = f z
  (bsc-val! 'f z)
  (dk-split-all! (list (dk-apply! bsq-nn z)))
  (dk-cite! 'cc-re-of-real (list 'f z))
  (dk-cite! 'rr-abs-of-nonneg (list 'f z)))
;; sqrt(|Re(w)|) in CC, w in CC
(define (bsq-sqrt-cc! w)
  (let ((r (list 'real-part w)))
    (dk-cite! 'real-part-in-rr w)
    (dk-cite! 'rr-abs-closed r) (dk-cite! 'rr-abs-nonneg r)
    (dk-split-all! (list (bsc-fact! 'sqrt-nonneg (list 'abs r))))
    (dk-cite! 'rr-subset-cc (list 'sqrt (list 'abs r)))))
;; g = sqrt o f is continuous
(dk-have! (list 'IN bsq-g '(FUN (PTS t) CC))
  (lambda ()
    (bsc-rhs! (dk-cite! 'is-top-space 't))
    (dk-lam-type! (lambda () (let ((z (dk-di-var!)))
                               (bsc-val! 'f z) (dk-cite! 'real-part-in-rr (list 'f z))
                               (let ((r (list 'real-part (list 'f z))))
                                 (dk-cite! 'rr-abs-closed r) (dk-cite! 'rr-abs-nonneg r)
                                 (dk-split-all! (list (bsc-fact! 'sqrt-nonneg (list 'abs r))))
                                 (dk-cite! 'rr-subset-cc (list 'sqrt (list 'abs r)))
                                 (bsc-ass!))))
                  (lambda () (bsc-ass!)))))
(let ((imp (dk-cite! 'ccont-sqrt-re-ptw 't 'f bsq-g)))
  (dk-have! (cadr imp) (lambda () (let ((z (dk-di-var!))) (bsc-val! 'f z) (dk-lam-b!) (if (not (proof-done-here?)) (begin (bsq-sqrt-cc! (list 'f z)) (rfl))))))
  (detach! imp))
(define bsq-E (list '(CCONT-VMUL t) (list '(CCONT-VSTAR t) bsq-g) bsq-g))
(dk-have! (list '= 'f bsq-E)
  (lambda ()
    (bsc-law-eq!
      (lambda (z)
        (bsq-fval! z)
        (dk-lam-b!)
        (subst (list '= (list 'real-part (list 'f z)) (list 'f z)))
        (subst (list '= (list 'abs (list 'f z)) (list 'f z)))
        (let ((s (list 'sqrt (list 'f z))))
          (dk-split-all! (list (bsc-fact! 'sqrt-prop (list 'f z))))
          (subst (dk-cite! 'cc-conjugate-fixes-rr s))
          (subst (list '= (list '* s s) (list 'f z)))
          (if (not (proof-done-here?)) (rfl)))))))
;; f is in every cone-closed class
(subst (dk-cite! 'pos-cone-unfold bsc-A))
(in-sep!
  (lambda () (subst (list '= (list 'VEC bsc-A) '(CCONT t))) (bsc-ass!))
  (lambda ()
    (dk-peel!)
    (let* ((p2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'pcy_))) "the generators"))
           (p2b (fold-left (lambda (acc p) (if (dk-contains? acc (car p)) (dk-rewrite-h! acc (car p) (cadr p)) acc)) p2
                  (map (lambda (acc v) (list (list acc bsc-A) v)) '(VEC VMUL VSTAR) '((CCONT t) (CCONT-VMUL t) (CCONT-VSTAR t))))))
      (dk-apply! p2b bsq-g)
      (subst (list '= 'f bsq-E))
      (bsc-ass!))))
(bsc-qed! 'ccont-nonneg-pos-cone)

;;; 1.37: f in C(t) is positive iff f(x) >= 0 for every x
(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IS-COMPACT-T t) (list 'FORALL 'f (list 'IMPLIES '(IN f (CCONT t))
  (list 'IFF (list 'IN 'f (list 'POS-CONE bsc-A)) (bsc-nn-body 'f))))))))
(dk-peel!)
(dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
  (lambda () (dk-split-all! (list (dk-cite! 'ccont-pos-cone-nonneg 't 'f))) (bsc-ass!))
  (lambda () (dk-cite! 'ccont-nonneg-pos-cone 't 'f) (bsc-ass!)))
(bsc-qed! 'ccont-positive-iff-nonneg)
