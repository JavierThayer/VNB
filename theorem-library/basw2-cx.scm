;;; ---- THE COMPOSITION LEMMA, local form: h is continuous when its oscillation at every point is
;;; controlled by those of two continuous functions f and g.  Every slot typing of CCONT-ALGEBRA(t)
;;; is an instance (through ccont-compose-fun or directly, with the estimate of the operation).
(define (bsc-mod f g h)
  (list 'FORALL 'cmp_ (list 'IMPLIES '(IN cmp_ (PTS t))
    (list 'FORALL 'cme_ (list 'IMPLIES '(POS-RR cme_)
      (list 'FORSOME 'cmd_ (list 'AND '(POS-RR cmd_)
        (list 'FORALL 'cmq_ (list 'IMPLIES '(IN cmq_ (PTS t))
          (list 'IMPLIES (list '< (bsc-mag (list '- (list f 'cmp_) (list f 'cmq_))) 'cmd_)
            (list 'IMPLIES (list '< (bsc-mag (list '- (list g 'cmp_) (list g 'cmq_))) 'cmd_)
              (list '< (bsc-mag (list '- (list h 'cmp_) (list h 'cmq_))) 'cme_))))))))))))
(sp (make-wff (list 'FORALL 't (list 'FORALL 'f (list 'FORALL 'g (list 'FORALL 'h
  (list 'IMPLIES '(IN f (CCONT t)) (list 'IMPLIES '(IN g (CCONT t)) (list 'IMPLIES '(IN h (FUN (PTS t) CC))
    (list 'IMPLIES (bsc-mod 'f 'g 'h) '(IN h (CCONT t))))))))))))
(dk-peel!)
(define bsc-modh (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'cmp_))) "the modulus hypothesis"))
(bsc-split-cite! 'ccont-parts 't 'f)
(bsc-split-cite! 'ccont-parts 't 'g)
(let ((imp (dk-cite! 'ccont-intro 't 'h)))
  (dk-have! (cadr imp)
    (lambda ()
      (let* ((pe (dk-peel!))
             (p (cadr (car (filter (lambda (x) (and (dk-head-is? x 'IN) (equal? (caddr x) '(PTS t)))) pe))))
             (e (cadr (car (filter (lambda (x) (dk-head-is? x 'POS-RR)) pe))))
             (d (dk-skolem! (dk-apply! bsc-modh p e)))
             (dcl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (eq? (cadr x) 'cmq_) (dk-contains? x d))) "the d clause"))
             (u1 (dk-skolem! (dk-apply! (dk-cite! 'ccont-local 't 'f) p d)))
             (c1 (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x u1))) "the u1 clause"))
             (u2 (dk-skolem! (dk-apply! (dk-cite! 'ccont-local 't 'g) p d)))
             (c2 (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x u2))) "the u2 clause"))
             (uu (list 'INTERSECTION u1 u2)))
        (bsc-top-inter! u1 u2)
        (ew uu)
        (dk-conj-close!
          (lambda ()
            (let ((gl (dk-goal)))
              (cond ((dk-asm? gl) (ass))
                    ((dk-head-is? gl 'IN) (bsc-inter-in! p u1 u2) (bsc-ass!))
                    (#t (let ((q (dk-di-var!)))
                          (bsc-inter-out! q u1 u2)
                          (dk-cite! 'top-open-subset 't u1)
                          (dk-cite! 'subset-mem-fwd u1 '(PTS t) q)
                          (dk-apply! c1 q) (dk-apply! c2 q)
                          (dk-apply! dcl q)
                          (bsc-ass!))))))))))
  (detach! imp)
  (bsc-ass!))
(bsc-qed! 'ccont-compose)
