(define (bsc-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (bsc-dump! tag)
  (display "\n*** DUMP ") (display tag) (newline)
  (for-each (lambda (l)
              (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
              (for-each (lambda (a) (if (< (string-length (expression->string a)) 300) (begin (display "      asm: ") (display (expression->string a)) (newline))))
                        (dk-asms-of l)))
            (dk-open-leaves)))
(define (bsc-split-cite! . args)      ; cite, split the conjunction that landed
  (let ((r (apply dk-cite! args)))
    (if (not (and (dk-head-is? r 'AND) (dk-asm? (cadr r)))) (dk-split-all! (list r)))
    r))
(define (bsc-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** basw2: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "basw2: unfinished" name))))
(define (bsc-rhs! iff)                ; the right side of an IFF instance whose left side is in context, split
  (dk-have! (caddr iff) (lambda () (if (dk-only! iff (cadr iff)) (prop))))
  (dk-split-all! (list (caddr iff))))
(define (bsc-lhs! iff thunk)          ; the left side of an IFF instance from its right side, built by THUNK
  (dk-have! (caddr iff) thunk)
  (dk-have! (cadr iff) (lambda () (if (dk-only! iff (caddr iff)) (prop)))))
(define (bsc-close-ctx!) (dk-conj-close! (lambda () (bsc-ass!))))
(define (bsc-le-ne-lt! a b)          ; goal a < b, with a <= b, not(a = b), a, b in RR in context
  (let ((imp (dk-cite! 'rr-le-ne-lt a b)))
    (dk-have! (cadr imp) (lambda () (dk-conj-close! (lambda () (bsc-ass!)))))
