(define (bas-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (if (and (not (sequent-node-grounded? l))
                           (let ((g (dk-goal-of l))) (and (pair? g) (eq? (car g) '=) (equal? (cadr g) (caddr g)))))
                      (begin (dk-focus! l) (rfl))))
                (dk-open-leaves)))
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba-spectrum: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (proof-leaves))
        (error "ba-spectrum: unfinished" name))))

(define (bas-st body) (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a) body))))
(define (bas-m x y) (list '(VMUL a) x y))
(define (bas-dump! tag)
  (display "\n;; BAN DUMP ") (display tag) (newline)
  (for-each (lambda (l) (display ";;   LEAF: ") (display (expression->string (dk-goal-of l))) (newline)) (dk-open-leaves)))
(define (bas-ad x y) (list '(VADD a) x y))
(define (bas-ng x) (list '(VNEG a) x))
(define (bas-sb x y) (bas-ad x (bas-ng y)))
(define (bas-nr x) (list '(VNRM a) x))
(define (bas-p x n) (list 'EL-POW 'a x n))
(define (bas-s x n) (list 'NEUMANN-SUM 'a x n))
(define bas-one '(VONE a))
(define bas-zero '(VZERO a))
(define bas-om (bas-sb bas-one 'x))              ; 1 - x
(define bas-bam '(BA-METRIC-SPACE a))
(define (bas-dist u v) (list '(DIST (BA-METRIC-SPACE a)) u v))
(define (bas-rw! from to) (subst (list '= from to)))
(define (bas-cite2! . args)
  (let ((r (apply dk-cite! args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (detach-with! r (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
        r)))

;;; type an algebra expression in (VEC a), bottom-up, by citation
(define (bas-vt x)
  (let ((want (list 'IN x '(VEC a))))
    (cond ((dk-asm? want) x)
          ((equal? x bas-one) (dk-cite! 'ring-one-in-uba-as-ring 'a) x)
          ((equal? x bas-zero) (dk-cite! 'ring-zero-in-uba-as-ring 'a) x)
          ((and (pair? x) (equal? (car x) '(VADD a)))
           (bas-vt (cadr x)) (bas-vt (caddr x))
           (dk-cite! 'ring-add-closed-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VMUL a)))
           (bas-vt (cadr x)) (bas-vt (caddr x))
           (dk-cite! 'ring-carrier-closed-mul-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG a)))
           (bas-vt (cadr x))
           (dk-cite! 'ring-neg-in-carr-uba-as-ring 'a (cadr x)) x)
          ((and (pair? x) (eq? (car x) 'INVERSE-EL))
           (dk-cite! 'bae-inverse-in 'a (caddr x)) x)
          ((and (pair? x) (eq? (car x) 'EL-POW))
           (bas-vt (caddr x))
           (dk-cite! 'bae-el-pow-type (cadddr x) 'a (caddr x)) x)
          ((and (pair? x) (eq? (car x) 'NEUMANN-SUM))
           (bas-vt (caddr x))
           (dk-cite! 'ban-nsum-type (cadddr x) 'a (caddr x)) x)
          (#t (error "bas-vt: cannot type" (expression->string x))))))

;;; (bas-in-pts! t) -- land t in PTS(BA-METRIC-SPACE a) from t in VEC a
(define (bas-in-pts! t)
  (bas-vt t)
  (dk-cite! 'ban-pts 'a)
  (let ((f (list 'IN t (list 'PTS bas-bam))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (subst (list '== (list 'PTS bas-bam) '(VEC a))) (dk-ass!))))
    f))

;;; (bas-dist-rr! u v) -- u, v typed in VEC: land dist(u, v) = ||u - v|| and dist(u, v) in RR
(define (bas-dist-rr! u v)
  (bas-vt u) (bas-vt v)
  (let ((d (bas-dist u v)))
    (dk-cite! 'ban-dist 'a u v)
    (bas-vt (bas-sb u v))
    (dk-cite! 'bae-vnrm-type 'a (bas-sb u v))
    (if (not (dk-asm? (list 'IN d 'RR)))
        (dk-have! (list 'IN d 'RR) (lambda () (bas-rw! d (bas-nr (bas-sb u v))) (dk-ass!))))
    d))
;;; (bas-rr! t) -- type a real term built from norms, distances, products, powers
(define (bas-rr! t)
  (cond ((dk-asm? (list 'IN t 'RR)) t)
        ((and (pair? t) (eq? (car t) '*))
         (bas-rr! (cadr t)) (bas-rr! (caddr t)) (dk-cite! 'rr-mul-in-rr (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) 'POWER))
         (bas-rr! (cadr t)) (dk-cite! 'power-real-closed (cadr t) (caddr t)) t)
        ((and (pair? t) (equal? (car t) '(VNRM a)))
         (bas-vt (cadr t)) (dk-cite! 'bae-vnrm-type 'a (cadr t)) t)
        ((and (pair? t) (equal? (car t) (list 'DIST bas-bam)))
         (bas-dist-rr! (cadr t) (caddr t)) t)
        (#t (error "bas-rr!: cannot type" (expression->string t)))))
;;; type the application (h v) of a sequence variable h in FUN(NN, VEC a)
(define (bas-app! h v) (dk-cite! 'fun-apply-type-c h 'NN '(VEC a) v) (list h v))
;;; (bas-lam-type! LAM) -- LAM = (VNB-LAMBDA w NN body): land LAM in FUN(NN, RR)
(define (bas-lam-rr! lam)
  (let ((f (list 'IN lam '(FUN NN RR))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda ()
          (dk-lam-type! (lambda ()
            (let* ((v (dk-di-var!)) (claim (dk-goal)))
              (bas-rr-term! (cadr claim) v)
              (if (equal? (dk-goal) claim) (dk-ass!))))))))
    f))
;;; a body term: applications of sequence VARIABLES at v are typed first
(define (bas-rr-term! t v)
  (let walk ((e t))
    (if (pair? e)
        (begin
          (if (and (symbol? (car e)) (= (length e) 2) (equal? (cadr e) v)
                   (dk-asm? (list 'IN (car e) '(FUN NN (VEC a)))))
              (bas-app! (car e) v))
          (for-each walk e))))
  (bas-rr! t))
;;; (bas-lam-vec! LAM) -- LAM = (VNB-LAMBDA w NN body), body an algebra term: land LAM in FUN(NN, VEC a)
(define (bas-lam-vec! lam)
  (let ((f (list 'IN lam '(FUN NN (VEC a)))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda ()
          (dk-lam-type! (lambda ()
            (dk-di-var!)
            (let ((claim (dk-goal)))
              (bas-vt (cadr claim))
              (if (equal? (dk-goal) claim) (dk-ass!))))))))
    f))
(define (bas-fun-pts! h)
  (dk-cite! 'ban-pts 'a)
  (let ((f (list 'IN h (list 'FUN 'NN (list 'PTS bas-bam)))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (subst (list '== (list 'PTS bas-bam) '(VEC a))) (dk-ass!))))
    f))


;;; ---- scalars -------------------------------------------------------------------------------
(define (bas-cc! t)                       ; type a CC term built from + - * recip of typed atoms
  (cond ((dk-asm? (list 'IN t 'CC)) t)
        ((and (pair? t) (eq? (car t) '+) (= (length t) 3))
         (bas-cc! (cadr t)) (bas-cc! (caddr t)) (bas-cite2! 'cc-add-closed (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) '*) (= (length t) 3))
         (bas-cc! (cadr t)) (bas-cc! (caddr t)) (bas-cite2! 'cc-mul-closed (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) '-) (= (length t) 2))
         (bas-cc! (cadr t)) (dk-cite! 'cc-neg-closed (cadr t)) t)
        ((and (pair? t) (eq? (car t) 'recip))
         (bas-cc! (cadr t)) (bas-cite2! 'cc-recip-closed (cadr t)) t)
        ((member t '(0 1)) (dk-cite! (if (equal? t 0) 'cc-zero-in 'cc-one-in)) t)
        (#t (error "bas-cc!: cannot type" (expression->string t)))))
(define (bas-ac z x) (list '(ACT a) z x))
(define (bas-pin!) (dk-cite! 'bal-uba-scal-pin 'a))
;;; extend the algebra typer by scalar multiples at a CC scalar
(define bas-vt0 bas-vt)
(set! bas-vt
  (lambda (x)
    (if (and (pair? x) (equal? (car x) '(ACT a)) (not (dk-asm? (list 'IN x '(VEC a)))))
        (begin (bas-cc! (cadr x)) (bas-vt (caddr x)) (bas-pin!)
               (dk-cite! 'rb3-c-act-in-uba-as-module 'a (cadr x) (caddr x)) x)
        (bas-vt0 x))))

;;; the scalar ring's negation, read off: (NEG (SCAL a)) z = -z
(sp (bas-st '(FORALL z (IMPLIES (IN z CC) (= ((NEG (SCAL a)) z) (- z))))))
(dk-peel!)
(bas-pin!)
(subst '(= (SCAL a) (NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)))
(fact 'cc-scalar-ring-neg)
(subst '(== (NEG (NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)) (VNB-LAMBDA x_ CC (- x_))))
(dk-lam-b!)
(bas-cc! '(- z))
(rfl)
(bas-qed! 'bas-scal-neg-eq)

;;; (u - z) v = u v - z v
(sp (bas-st '(FORALL u (IMPLIES (IN u CC) (FORALL z (IMPLIES (IN z CC) (FORALL v (IMPLIES (IN v (VEC a))
  (= ((ACT a) (+ u (- z)) v) ((VADD a) ((ACT a) u v) ((VNEG a) ((ACT a) z v))))))))))))
(dk-peel!)
(bas-pin!)
(dk-cite! 'rb3-c-in-carr-uba-as-module 'a 'u)
(dk-cite! 'rb3-c-in-carr-uba-as-module 'a 'z)
(bas-cc! '(- z))
(dk-cite! 'bas-scal-neg-eq 'a 'z)
(dk-cite! 'rb3-c-add-eq-uba-as-module 'a 'u '(- z))
(let* ((e0 (dk-cite! 'frm-act-sub-scal-uba-as-module 'a 'u 'z 'v))
       (e1 (dk-rewrite-h! e0 '((NEG (SCAL a)) z) '(- z)))
       (e2 (dk-rewrite-h! e1 '((ADD (SCAL a)) u (- z)) '(+ u (- z)))))
  (dk-ass!))
(bas-qed! 'bas-act-sub)

;;; the unfold of SHIFT-EL, and its typing
(sp (make-wff '(FORALL a (FORALL z (FORALL x (== (SHIFT-EL a z x) ((VADD a) ((ACT a) z (VONE a)) ((VNEG a) x))))))))
(di) (mac 'SHIFT-EL) (qrfl)
(bas-qed! 'bas-shift-unfold)
(define (bas-sh z) (list 'SHIFT-EL 'a z 'x))
(define (bas-sh-open z) (bas-sb (bas-ac z bas-one) 'x))
(define (bas-unshift! z) (fact 'bas-shift-unfold 'a z 'x) (subst (list '== (bas-sh z) (bas-sh-open z))))

(sp (bas-st '(FORALL z (IMPLIES (IN z CC) (FORALL x (IMPLIES (IN x (VEC a)) (IN (SHIFT-EL a z x) (VEC a))))))))
(dk-peel!)
(bas-unshift! 'z)
(bas-vt (bas-sh-open 'z))
(dk-ass!)
(bas-qed! 'bas-shift-type)
(set! bas-vt0
  (let ((prev bas-vt0))
    (lambda (x)
      (if (and (pair? x) (eq? (car x) 'SHIFT-EL))
          (begin (bas-cc! (caddr x)) (bas-vt (cadddr x)) (dk-cite! 'bas-shift-type 'a (caddr x) (cadddr x)) x)
          (prev x)))))

;;; -(r - q) = q - r, and (p - q) - (r - q) = p - r
(sp (bas-st '(FORALL r (IMPLIES (IN r (VEC a)) (FORALL q (IMPLIES (IN q (VEC a))
  (= ((VNEG a) ((VADD a) r ((VNEG a) q))) ((VADD a) q ((VNEG a) r)))))))))
(dk-peel!)
(let* ((rq (bas-vt (bas-sb 'r 'q))) (qr (bas-vt (bas-sb 'q 'r))))
  (dk-have! (list '= (bas-ad rq qr) bas-zero)
    (lambda ()
      (dk-cite! 'ban-telescope 'a 'r 'q 'r)
      (bas-rw! (bas-ad rq qr) (bas-sb 'r 'r))
      (dk-cite! 'ring-add-right-inv-uba-as-ring 'a 'r)
      (dk-ass!)))
  (dk-cite! 'ring-add-inverse-unique-uba-as-ring 'a rq qr)
  (bas-rw! (bas-ng rq) qr)
  (rfl))
(bas-qed! 'bas-neg-sub)

(sp (bas-st '(FORALL p (IMPLIES (IN p (VEC a)) (FORALL q (IMPLIES (IN q (VEC a)) (FORALL r (IMPLIES (IN r (VEC a))
  (= ((VADD a) ((VADD a) p ((VNEG a) q)) ((VNEG a) ((VADD a) r ((VNEG a) q)))) ((VADD a) p ((VNEG a) r)))))))))))
(dk-peel!)
(dk-cite! 'bas-neg-sub 'a 'r 'q)
(bas-rw! (bas-ng (bas-sb 'r 'q)) (bas-sb 'q 'r))
(dk-cite! 'ban-telescope 'a 'p 'q 'r)
(dk-ass!)
(bas-qed! 'bas-sub-sub-common)

;;; (u 1 - x) - (z 1 - x) = (u - z) 1
(sp (bas-st '(FORALL u (IMPLIES (IN u CC) (FORALL z (IMPLIES (IN z CC) (FORALL x (IMPLIES (IN x (VEC a))
  (= ((VADD a) (SHIFT-EL a u x) ((VNEG a) (SHIFT-EL a z x))) ((ACT a) (+ u (- z)) (VONE a)))))))))))
(dk-peel!)
(bas-unshift! 'u) (bas-unshift! 'z)
(let ((u1 (bas-vt (bas-ac 'u bas-one))) (z1 (bas-vt (bas-ac 'z bas-one))))
  (dk-cite! 'bas-sub-sub-common 'a u1 'x z1)
  (bas-rw! (bas-sb (bas-sb u1 'x) (bas-sb z1 'x)) (bas-sb u1 z1))
  (dk-cite! 'bas-act-sub 'a 'u 'z bas-one)
  (bas-rw! (bas-ac '(+ u (- z)) bas-one) (bas-sb u1 z1))
  (bas-vt (bas-sb u1 z1))
  (rfl))
(bas-qed! 'bas-shift-diff)

;;; ---- the resolvent identity -----------------------------------------------------------------
;;; z 1 - x, u 1 - x invertible:  (z 1 - x)^-1 - (u 1 - x)^-1 = (u - z) (z 1 - x)^-1 (u 1 - x)^-1
(sp (bas-st '(FORALL x (IMPLIES (IN x (VEC a)) (FORALL z (IMPLIES (IN z CC) (FORALL u (IMPLIES (IN u CC)
  (IMPLIES (IS-INVERTIBLE-EL a (SHIFT-EL a z x)) (IMPLIES (IS-INVERTIBLE-EL a (SHIFT-EL a u x))
    (= ((VADD a) (INVERSE-EL a (SHIFT-EL a z x)) ((VNEG a) (INVERSE-EL a (SHIFT-EL a u x))))
       ((ACT a) (+ u (- z)) ((VMUL a) (INVERSE-EL a (SHIFT-EL a z x)) (INVERSE-EL a (SHIFT-EL a u x)))))))))))))))
(dk-peel!)
(let* ((A (bas-sh 'z)) (B (bas-sh 'u)) (Ai (list 'INVERSE-EL 'a A)) (Bi (list 'INVERSE-EL 'a B))
       (c '(+ u (- z))) (c1 (bas-ac c bas-one)))
  (bas-vt A) (bas-vt B) (bas-vt Ai) (bas-vt Bi) (bas-cc! c) (bas-vt c1)
  (bas-vt (bas-m Ai B)) (bas-vt (bas-m Ai Bi)) (bas-vt (bas-ac c Ai))
  (dk-cite! 'bae-inverse-left 'a A) (dk-cite! 'bae-inverse-right 'a B)
  ;; E: (Ai (B - A)) Bi = Ai - Bi
  (dk-have! (list '= (bas-m (bas-m Ai (bas-sb B A)) Bi) (bas-sb Ai Bi))
    (lambda ()
      (dk-cite! 'ban-mul-sub-left 'a Ai B A)
      (bas-rw! (bas-m Ai (bas-sb B A)) (bas-sb (bas-m Ai B) (bas-m Ai A)))
      (bas-rw! (bas-m Ai A) bas-one)
      (dk-cite! 'ban-mul-sub-right 'a Bi (bas-m Ai B) bas-one)
      (bas-rw! (bas-m (bas-sb (bas-m Ai B) bas-one) Bi) (bas-sb (bas-m (bas-m Ai B) Bi) (bas-m bas-one Bi)))
      (dk-cite! 'ring-mul-assoc-uba-as-ring 'a Ai B Bi)
      (bas-rw! (bas-m (bas-m Ai B) Bi) (bas-m Ai (bas-m B Bi)))
      (bas-rw! (bas-m B Bi) bas-one)
      (dk-cite! 'ring-mul-right-id-uba-as-ring 'a Ai)
      (dk-cite! 'ring-mul-left-id-uba-as-ring 'a Bi)
      (bas-rw! (bas-m Ai bas-one) Ai)
      (bas-rw! (bas-m bas-one Bi) Bi)
      (bas-vt (bas-sb Ai Bi))
      (rfl)))
  (dk-cite! 'bas-shift-diff 'a 'u 'z 'x)
  (bas-pin!)
  (dk-cite! 'rb3-c-in-carr-uba-as-module 'a c)
  (dk-cite! 'bal-uba-vmul-act-right 'a c Ai bas-one)
  (dk-cite! 'bal-uba-vmul-act-left 'a c Ai Bi)
  (dk-cite! 'ring-mul-right-id-uba-as-ring 'a Ai)
  (let* ((e0 (list '= (bas-m (bas-m Ai (bas-sb B A)) Bi) (bas-sb Ai Bi)))
         (e1 (dk-rewrite-h! e0 (bas-sb B A) c1))
         (e2 (dk-rewrite-h! e1 (bas-m Ai c1) (bas-ac c (bas-m Ai bas-one))))
         (e3 (dk-rewrite-h! e2 (bas-m Ai bas-one) Ai))
         (e4 (dk-rewrite-h! e3 (bas-m (bas-ac c Ai) Bi) (bas-ac c (bas-m Ai Bi)))))
    (subst (list '= (bas-sb Ai Bi) (bas-ac c (bas-m Ai Bi))))
    (bas-vt (bas-ac c (bas-m Ai Bi)))
    (rfl)))
(bas-qed! 'resolvent-identity)

;;; ---- scalar multiples of invertible elements ---------------------------------------------------
(sp (bas-st '(FORALL v (IMPLIES (IN v (VEC a)) (= ((ACT a) 1 v) v)))))
(dk-peel!)
(bas-pin!)
(dk-cite! 'rb3-c-one-eq-uba-as-module 'a)
(let ((e (dk-cite! 'bal-uba-act-one 'a 'v)))
  (dk-rewrite-h! e '(ONE (SCAL a)) 1)
  (dk-ass!))
(bas-qed! 'bas-act-one)

;;; z (zr v) = v  when z zr = 1
(define (bas-cancel! z zr v)              ; rewrite (ACT z (ACT zr v)) to v in the goal
  (bas-pin!)
  (dk-cite! 'rb3-c-act-mul-uba-as-module 'a z zr v)
  (bas-rw! (bas-ac z (bas-ac zr v)) (bas-ac (list '* z zr) v))
  (bas-rw! (list '* z zr) 1)
  (dk-cite! 'bas-act-one 'a v)
  (bas-rw! (bas-ac 1 v) v))

(sp (bas-st '(FORALL z (IMPLIES (IN z CC) (IMPLIES (NOT (= z 0)) (FORALL u (IMPLIES (IS-INVERTIBLE-EL a u)
  (IS-INVERTIBLE-EL a ((ACT a) z u)))))))))
(dk-peel!)
(dk-project! '(IN u (VEC a)) 'IS-INVERTIBLE-EL '(IS-INVERTIBLE-EL a u))
(let* ((zr '(recip z)) (ui '(INVERSE-EL a u)) (zu (bas-ac 'z 'u)) (v (bas-ac zr ui)))
  (bas-cc! zr)
  (bas-cite2! 'cc-recip-inverse 'z)
  (dk-have! (list '= (list '* zr 'z) 1)
    (lambda () (bas-cite2! 'cc-mul-comm zr 'z) (bas-rw! (list '* zr 'z) (list '* 'z zr)) (dk-ass!)))
  (bas-vt ui) (bas-vt zu) (bas-vt v) (bas-pin!)
  (dk-cite! 'rb3-c-in-carr-uba-as-module 'a 'z)
  (dk-cite! 'rb3-c-in-carr-uba-as-module 'a zr)
  (dk-cite! 'bae-inverse-left 'a 'u) (dk-cite! 'bae-inverse-right 'a 'u)
  (bas-vt (bas-m 'u ui)) (bas-vt (bas-m ui 'u))
  (dk-have! (list '= (bas-m zu v) bas-one)
    (lambda ()
      (dk-cite! 'bal-uba-vmul-act-left 'a 'z 'u v)
      (bas-rw! (bas-m zu v) (bas-ac 'z (bas-m 'u v)))
      (dk-cite! 'bal-uba-vmul-act-right 'a zr 'u ui)
      (bas-rw! (bas-m 'u v) (bas-ac zr (bas-m 'u ui)))
      (bas-rw! (bas-m 'u ui) bas-one)
      (bas-vt bas-one)
      (bas-cancel! 'z zr bas-one)
      (rfl)))
  (dk-have! (list '= (bas-m v zu) bas-one)
    (lambda ()
      (dk-cite! 'bal-uba-vmul-act-left 'a zr ui zu)
      (bas-rw! (bas-m v zu) (bas-ac zr (bas-m ui zu)))
      (dk-cite! 'bal-uba-vmul-act-right 'a 'z ui 'u)
      (bas-rw! (bas-m ui zu) (bas-ac 'z (bas-m ui 'u)))
      (bas-rw! (bas-m ui 'u) bas-one)
      (bas-vt bas-one)
      (bas-cancel! zr 'z bas-one)
      (rfl)))
  (dk-cite! 'bae-invertible-intro 'a zu v)
  (dk-ass!))
(bas-qed! 'bas-act-invertible)

;;; ---- Proposition 1.6 (last claim): |z| > ||x|| implies z 1 - x invertible ----------------------
(sp (bas-st '(FORALL x (IMPLIES (IN x (VEC a)) (FORALL z (IMPLIES (IN z CC)
  (IMPLIES (< ((VNRM a) x) (magnitude z)) (IS-INVERTIBLE-EL a (SHIFT-EL a z x)))))))))
(dk-peel!)
(let* ((nx (bas-nr 'x)) (mz '(magnitude z)) (zr '(recip z)) (w (bas-ac zr 'x)) (nw (bas-nr w))
       (om (bas-sb bas-one w)) (hyp (list '< nx mz)))
  (bas-rr! nx) (dk-cite! 'bal-uba-vnrm-nonneg 'a 'x)
  (dk-cite! 'cc-magnitude-closed 'z)
  (dk-have! '(NOT (= z 0))
    (lambda ()
      (di)
      (dk-cite! 'cc-magnitude-zero)
      (let* ((h1 (dk-rewrite-h! hyp 'z 0))
             (h2 (dk-rewrite-h! h1 '(magnitude 0) 0)))
        (dk-absurd! h2 (list '<= 0 nx)))))
  (bas-cc! zr)
  (bas-cite2! 'cc-recip-inverse 'z)
  (bas-pin!)
  (dk-cite! 'rb3-c-in-carr-uba-as-module 'a 'z)
  (dk-cite! 'rb3-c-in-carr-uba-as-module 'a zr)
  (bas-vt w) (bas-rr! nw)
  ;; ||w|| = |1/z| ||x|| = ||x|| / |z| < 1
  (dk-cite! 'bal-uba-vnrm-homog 'a zr 'x)
  (dk-cite! 'aif-magnitude-recip 'z)
  (dk-have! (list '< 0 mz) (lambda () (dk-ineq! hyp (list '<= 0 nx))))
  (dk-have! (list '< nx (list '* 1 mz)) (lambda () (dk-ineq! hyp)))
  (dk-cite! 'rr-lt-div-of-lt-mul nx 1 mz)
  (dk-have! (list 'NOT (list '= mz 0))
    (lambda () (di) (dk-absurd! (dk-rewrite-h! (list '< 0 mz) mz 0))))
  (bas-cite2! 'rr-recip-closed mz)
  (dk-have! (list '< nw 1)
    (lambda ()
      (bas-rw! nw (list '* (list 'magnitude zr) nx))
      (bas-rw! (list 'magnitude zr) (list 'recip mz))
      (dk-have! (list '= (list '* (list 'recip mz) nx) (list '* nx (list 'recip mz))) (lambda () (crs)))
      (bas-rw! (list '* (list 'recip mz) nx) (list '* nx (list 'recip mz)))
      (dk-ass!)))
  ;; 1 - w is invertible, hence so is z (1 - w) = z 1 - x
  (dk-cite! 'neumann-series 'a w)
  (dk-have! (list 'IS-INVERTIBLE-EL 'a om) (lambda () (dk-split-all!) (dk-ass!)))
  (bas-vt om)
  (dk-cite! 'bas-act-invertible 'a 'z om)
  (dk-have! (list '= (bas-ac 'z om) (bas-sh-open 'z))
    (lambda ()
      (bas-vt (bas-ng w))
      (dk-cite! 'rb3-c-act-vadd-uba-as-module 'a 'z bas-one (bas-ng w))
      (bas-rw! (bas-ac 'z om) (bas-ad (bas-ac 'z bas-one) (bas-ac 'z (bas-ng w))))
      (dk-cite! 'frm-act-neg-vec-uba-as-module 'a 'z w)
      (bas-rw! (bas-ac 'z (bas-ng w)) (bas-ng (bas-ac 'z w)))
      (bas-cancel! 'z zr 'x)
      (bas-vt (bas-sh-open 'z))
      (rfl)))
  (bas-unshift! 'z)
  (bas-rw! (bas-sh-open 'z) (bas-ac 'z om))
  (dk-ass!))
(bas-qed! 'shift-invertible-outside-ball)

;;; the spectrum, unfolded; sigma(x) lies in the closed ball of radius ||x||
(sp (make-wff '(FORALL a (FORALL x (== (SPECTRUM a x) (SEP baz_ CC (NOT (IS-INVERTIBLE-EL a (SHIFT-EL a baz_ x)))))))))
(di) (mac 'SPECTRUM) (qrfl)
(bas-qed! 'bas-spectrum-unfold)

(sp (bas-st '(FORALL x (IMPLIES (IN x (VEC a)) (FORALL z (IMPLIES (IN z (SPECTRUM a x))
  (<= (magnitude z) ((VNRM a) x))))))))
(dk-peel!)
(let* ((nx (bas-nr 'x)) (mz '(magnitude z))
       (m0 '(IN z (SPECTRUM a x))))
  (fact 'bas-spectrum-unfold 'a 'x)
  (let* ((m1 (dk-rewrite-h! m0 '(SPECTRUM a x) '(SEP baz_ CC (NOT (IS-INVERTIBLE-EL a (SHIFT-EL a baz_ x)))))))
    (dk-project! '(IN z CC) (lambda () (sep-me m1)))
    (dk-project! (list 'NOT (list 'IS-INVERTIBLE-EL 'a (bas-sh 'z))) (lambda () (sep-me m1))))
  (bas-rr! nx) (dk-cite! 'cc-magnitude-closed 'z)
  (dk-have! (list 'NOT (list '< nx mz))
    (lambda ()
      (di)
      (dk-cite! 'shift-invertible-outside-ball 'a 'x 'z)
      (ai (list 'NOT (list 'IS-INVERTIBLE-EL 'a (bas-sh 'z))))))
  (dk-cite! 'rr-not-lt-ge nx mz)
  (dk-ass!))
(bas-qed! 'spectrum-in-closed-ball)

;;; ---- characters (Remark 1.13: a character has norm <= 1) --------------------------------------
;;; 0 v = 0
(sp (bas-st '(FORALL v (IMPLIES (IN v (VEC a)) (= ((ACT a) 0 v) (VZERO a))))))
(dk-peel!)
(let* ((w (bas-ac 0 'v)) (nw (bas-nr w)))
  (bas-cc! 0) (bas-vt w) (bas-rr! nw) (bas-rr! (bas-nr 'v))
  (bas-pin!)
  (dk-cite! 'rb3-c-in-carr-uba-as-module 'a 0)
  (dk-cite! 'bal-uba-vnrm-homog 'a 0 'v)
  (dk-cite! 'cc-magnitude-zero)
  (dk-have! (list '= nw 0)
    (lambda ()
      (bas-rw! nw (list '* '(magnitude 0) (bas-nr 'v)))
      (bas-rw! '(magnitude 0) 0)
      (dk-ineq!)))
  (dk-cite! 'bal-uba-vnrm-definite 'a w)
  (keep (list '= nw 0) (iff-for (list '= nw 0)))
  (prop))
(bas-qed! 'bas-act-zero)

(sp (make-wff '(FORALL a (== (CHARACTERS a)
  (SEP bac_ (FUN (VEC a) CC)
     (AND (IS-CC-LINEAR-ON a bac_)
     (AND (FORALL bax_ (IMPLIES (IN bax_ (VEC a)) (FORALL bay_ (IMPLIES (IN bay_ (VEC a))
            (= (bac_ ((VMUL a) bax_ bay_)) (* (bac_ bax_) (bac_ bay_)))))))
          (= (bac_ (VONE a)) 1))))))))
(di) (mac 'CHARACTERS) (qrfl)
(bas-qed! 'bas-characters-unfold)

;;; (bas-char-open! c) -- c in CHARACTERS(a) in context: land its typing, linearity laws,
;;; multiplicativity and c(1) = 1, keeping the membership
(define (bas-char-open! c)
  (let* ((m0 (list 'IN c '(CHARACTERS a)))
         (body (caddr (dk-cite! 'bas-characters-unfold 'a)))
         (m1 (dk-rewrite-h! m0 '(CHARACTERS a) body))
         (sb (lambda (f) (subst-free 'bac_ c f)))
         (lin (sb (car (cdr (cadddr body)))))
         (rest (sb (caddr (cadddr body)))))
    (dk-project! (list 'IN c '(FUN (VEC a) CC)) (lambda () (sep-me m1)))
    (dk-project! (list 'IS-CC-LINEAR-ON 'a c) (lambda () (sep-me m1)))
    (dk-project! (cadr rest) (lambda () (sep-me m1)))
    (dk-project! (caddr rest) (lambda () (sep-me m1)))
    (let* ((ld (caddr (dk-cite! 'IS-CC-LINEAR-ON 'a c)))
           (la (dk-project! (cadr (caddr ld)) 'IS-CC-LINEAR-ON (list 'IS-CC-LINEAR-ON 'a c)))
           (lm (dk-project! (caddr (caddr ld)) 'IS-CC-LINEAR-ON (list 'IS-CC-LINEAR-ON 'a c))))
      (list la lm (cadr rest) (caddr rest)))))
(define (bas-cv! c v) (dk-cite! 'fun-apply-type-c c '(VEC a) 'CC v) (list c v))

;;; a character does not vanish at an invertible element
(sp (bas-st '(FORALL c (IMPLIES (IN c (CHARACTERS a)) (FORALL u (IMPLIES (IS-INVERTIBLE-EL a u)
  (NOT (= (c u) 0))))))))
(dk-peel!)
(dk-project! '(IN u (VEC a)) 'IS-INVERTIBLE-EL '(IS-INVERTIBLE-EL a u))
(let* ((laws (bas-char-open! 'c)) (ui '(INVERSE-EL a u)))
  (bas-vt ui)
  (bas-cv! 'c 'u) (bas-cv! 'c ui)
  (dk-apply! (caddr laws) 'u ui)
  (dk-apply! (cadddr laws))
  (dk-cite! 'bae-inverse-right 'a 'u)
  (di)
  (dk-have! (list '= (list '* '(c u) (list 'c ui)) 1)
    (lambda ()
      (bas-rw! (list '* '(c u) (list 'c ui)) (list 'c (bas-m 'u ui)))
      (bas-rw! (bas-m 'u ui) bas-one)
      (dk-ass!)))
  (dk-have! (list '= (list '* 0 (list 'c ui)) 1)
    (lambda () (bas-rw! 0 '(c u)) (dk-ass!)))
  (dk-have! (list '= (list '* 0 (list 'c ui)) 0) (lambda () (crs)))
  (dk-have! '(= 0 1) (lambda () (bas-rw! 0 (list '* 0 (list 'c ui))) (dk-ass!)))
  (dk-absurd! '(= 0 1)))
(bas-qed! 'character-nonzero-at-invertible)

;;; |c(x)| <= ||x||
(sp (bas-st '(FORALL c (IMPLIES (IN c (CHARACTERS a)) (FORALL x (IMPLIES (IN x (VEC a))
  (<= (magnitude (c x)) ((VNRM a) x))))))))
(dk-peel!)
(let* ((laws (bas-char-open! 'c))
       (z '(c x)) (nx (bas-nr 'x)) (mz (list 'magnitude z)) (nxv (bas-vt (bas-ng 'x)))
       (z1 (bas-ac z bas-one)))
  (bas-cv! 'c 'x) (bas-cv! 'c nxv) (bas-vt bas-zero) (bas-cv! 'c bas-zero)
  (bas-vt bas-one) (bas-cc! z) (bas-vt z1)
  (dk-apply! (car laws) z1 nxv)
  (dk-apply! (car laws) 'x nxv)
  (dk-apply! (cadr laws) z bas-one)
  (dk-apply! (cadr laws) 0 bas-zero)
  (dk-apply! (cadddr laws))
  (bas-rr! nx) (dk-cite! 'cc-magnitude-closed z)
  (bas-vt z1)
  (dk-have! (list 'NOT (list '< nx mz))
    (lambda ()
      (di)
      (dk-cite! 'shift-invertible-outside-ball 'a 'x z)
      (dk-cite! 'character-nonzero-at-invertible 'a 'c (bas-sh z))
      ;; c(z 1 - x) = z c(1) + c(-x) = c(x) + c(-x) = c(x - x) = c(0) = c(0 0) = 0 c(0) = 0
      (dk-have! (list '= (list 'c (bas-sh z)) 0)
        (lambda ()
          (bas-unshift! z)
          (bas-rw! (list 'c (bas-sh-open z)) (list '+ (list 'c z1) (list 'c nxv)))
          (bas-rw! (list 'c z1) (list '* z (list 'c bas-one)))
          (bas-rw! (list 'c bas-one) 1)
          (dk-have! (list '= (list '+ (list '* z 1) (list 'c nxv)) (list '+ z (list 'c nxv))) (lambda () (crs)))
          (bas-rw! (list '+ (list '* z 1) (list 'c nxv)) (list '+ z (list 'c nxv)))
          (bas-rw! (list '+ z (list 'c nxv)) (list 'c (bas-ad 'x nxv)))
          (dk-cite! 'ring-add-right-inv-uba-as-ring 'a 'x)
          (bas-rw! (bas-ad 'x nxv) bas-zero)
          (dk-cite! 'bas-act-zero 'a bas-zero)
          (dk-rewrite-h! (list '= (list 'c (bas-ac 0 bas-zero)) (list '* 0 (list 'c bas-zero)))
                         (bas-ac 0 bas-zero) bas-zero)
          (bas-rw! (list 'c bas-zero) (list '* 0 (list 'c bas-zero)))
          (dk-have! (list '= (list '* 0 (list 'c bas-zero)) 0) (lambda () (crs)))))
      (ai (list 'NOT (list '= (list 'c (bas-sh z)) 0)))))
  (dk-cite! 'rr-not-lt-ge nx mz)
  (dk-ass!))
(bas-qed! 'character-bounded)

;;; ---- ideals (the key step of Corollary 1.5) ------------------------------------------------------
;;; a left ideal that contains an invertible element contains 1; one that meets the open
;;; unit ball around 1 does too (every element of that ball is invertible, Prop. 1.3)
(define (bas-ideal-open! ii)
  (let* ((lf (list 'IS-LEFT-IDEAL 'a ii))
         (body (caddr (dk-cite! 'IS-LEFT-IDEAL 'a ii)))
         (sub (dk-project! (cadr body) 'IS-LEFT-IDEAL lf))
         (mul (dk-project! (caddr body) 'IS-LEFT-IDEAL lf))
         (sbody (caddr (dk-cite! 'IS-ALG-SUBSPACE 'a ii)))
         (ss (dk-project! (cadr sbody) 'IS-ALG-SUBSPACE sub)))
    (list ss mul)))

(sp (bas-st '(FORALL ii (IMPLIES (IS-LEFT-IDEAL a ii) (FORALL y (IMPLIES (IN y ii)
  (IMPLIES (IS-INVERTIBLE-EL a y) (IN (VONE a) ii))))))))
(dk-peel!)
(let* ((r (bas-ideal-open! 'ii)) (yi '(INVERSE-EL a y)))
  (bas-vt yi)
  (dk-cite! 'bae-inverse-left 'a 'y)
  (dk-apply! (cadr r) yi 'y)
  (bas-rw! bas-one (bas-m yi 'y))
  (dk-ass!))
(bas-qed! 'left-ideal-invertible-one)

(sp (bas-st '(FORALL ii (IMPLIES (IS-LEFT-IDEAL a ii) (FORALL y (IMPLIES (IN y ii)
  (IMPLIES (< ((VNRM a) ((VADD a) (VONE a) ((VNEG a) y))) 1) (IN (VONE a) ii))))))))
(dk-peel!)
(let* ((r (bas-ideal-open! 'ii)) (w (bas-sb bas-one 'y)))
  (dk-have! '(IN y (VEC a))
    (lambda ()
      (mac-h 'subset-def (car r))
      (dk-apply! '(FORALL x (IMPLIES (IN x ii) (IN x (VEC a)))) 'y)
      (dk-ass!)))
  (bas-vt w)
  (dk-cite! 'neumann-series 'a w)
  (dk-have! (list 'IS-INVERTIBLE-EL 'a (bas-sb bas-one w)) (lambda () (dk-split-all!) (dk-ass!)))
  (dk-cite! 'ban-sub-sub 'a bas-one 'y)
  (dk-have! '(IS-INVERTIBLE-EL a y)
    (lambda () (bas-rw! 'y (bas-sb bas-one w)) (dk-ass!)))
  (dk-cite! 'left-ideal-invertible-one 'a 'ii 'y)
  (dk-ass!))
(bas-qed! 'left-ideal-near-one)

