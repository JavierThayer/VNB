;; two operators with the same form are equal
(sp (make-wff (wbc-alls '(v s1 s2)
  (wbc-imps (list '(IS-HILBERT-SPACE v) '(IN s1 (BOUNDED-OPS v v)) '(IN s2 (BOUNDED-OPS v v))
                  (wbc-vall '(wka_ wky_) '(= ((IP v) (s1 wka_) wky_) ((IP v) (s2 wka_) wky_))))
    '(= s1 s2)))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'cips-vec-set 'v)
(define wbc-BF1 (list 'VNB-LAMBDA 'wra_ wbc-V (list 'VNB-LAMBDA 'wrb_ wbc-V '((IP v) (s1 wra_) wrb_))))
(dk-have! (list 'IN wbc-BF1 (list 'FUN wbc-V (list 'FUN wbc-V 'CC)))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((x (dk-di-var!)))
          (dk-lam-type!
            (lambda ()
              (let ((y (dk-di-var!)))
                (wbc-opv! 's1 x) (dk-apply! (dk-cite! 'cips-ip-type 'v) (list 's1 x) y) (dk-ass!)))
            (lambda () (dk-ass!)))))
      (lambda () (dk-ass!)))))
(define (wbc-bf1-eq-th s)                 ; forall x y: (BF1 x) y = <s x | y>
  (lambda ()
    (let* ((ld (dk-peel!)) (xs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) ld))) (x (car xs)) (y (cadr xs)))
      (dk-lam-b!)
      (if (not (wbc-grounded?))
          (if (eq? s 's1)
              (begin (wbc-opv! 's1 x) (dk-apply! (dk-cite! 'cips-ip-type 'v) (list 's1 x) y) (rfl))
              (begin (dk-apply! (wbc-ctx (wbc-vall '(wka_ wky_) '(= ((IP v) (s1 wka_) wky_) ((IP v) (s2 wka_) wky_)))) x y)
                     (dk-ass!)))))))
(wbc-chain! (dk-cite! 'bounded-sesquilinear-form-unique 'v wbc-BF1 's1 's2)
  (list (wbc-bf1-eq-th 's1) (wbc-bf1-eq-th 's2)))
(dk-ass!)
(wbc-done! 'operator-of-form-unique)

;; the form of an operator of the unit ball lies in K
(define wbc-PHI '(VNB-LAMBDA wph_ (CARTESIAN (VEC v) (VEC v)) ((IP v) (t (NTH 1 wph_)) (NTH 2 wph_))))
(define (wbc-has-nth? e) (and (pair? e) (list? e)
  (or (and (eq? (car e) 'NTH) (= (length e) 3) (pair? (caddr e)) (eq? (car (caddr e)) 'LIST)) (any-pred wbc-has-nth? e))))
(define (wbc-nth-all!) (let loop ((k 0)) (if (and (< k 12) (wbc-open?) (wbc-has-nth? (dk-goal))) (begin (nth-r) (loop (+ k 1))))))
(sp (make-wff (wbc-alls '(v t) (wbc-imps (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) (list 'IN 't wbc-UB)) (list 'IN wbc-PHI wbc-K)))))
(dk-peel!)
(wbc-setup!)
(wbc-ub-out! 't)
(dk-have! (list 'IN wbc-PHI (list 'FUN wbc-CV 'CC))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let* ((i (dk-di-var!)) (n1 (list 'NTH 1 i)) (n2 (list 'NTH 2 i)))
          (dk-split! (dk-cite! 'cartesian-nth i wbc-V wbc-V))
          (wbc-opv! 't n1)
          (dk-apply! (dk-cite! 'cips-ip-type 'v) (list 't n1) n2)
          (dk-ass!)))
      (lambda () (dk-ass!)))))
(dk-cite! 'fun-in-cc-product wbc-CV wbc-PHI)
(define (wbc-phi-clause! finish!)       ; peel the clause, type the pairs, beta, reduce the NTHs, FINISH! the vars
  (lambda ()
    (let* ((ld (dk-peel!)) (xs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) ld))))
      (let walk ((e (dk-goal)))
        (if (pair? e)
            (begin (if (and (eq? (car e) 'LIST) (= (length e) 3)) (wbc-it! e))
                   (for-each walk e))))
      (dk-lam-b!)
      (wbc-nth-all!)
      (if (wbc-open?) (apply finish! xs)))))
(in-sep! (lambda () (dk-ass!))
  (lambda ()
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((dk-ass!) #t)
            ((equal? g (wbc-bnd wbc-PHI))
             ((wbc-phi-clause! (lambda (a y) (dk-cite! 'op-unit-ball-form-bound 'v 't a y) (dk-ass!)))))
            ((equal? g (wbc-a1 wbc-PHI))
             ((wbc-phi-clause! (lambda (a b y)
                (wbc-opv! 't a) (wbc-opv! 't b)
                (dk-cite! 'bop-add 'v 'v 't a b)
                (subst (list '= (list 't (list '(VADD v) a b)) (list '(VADD v) (list 't a) (list 't b))))
                (dk-apply! (dk-cite! 'cips-ip-add-left 'v) (list 't a) (list 't b) y)
                (dk-ass!)))))
            ((equal? g (wbc-a2 wbc-PHI))
             ((wbc-phi-clause! (lambda (k a y)
                (wbc-opv! 't a)
                (dk-cite! 'bop-act 'v 'v 't k a)
                (subst (list '= (list 't (list '(ACT v) k a)) (list '(ACT v) k (list 't a))))
                (dk-apply! (dk-cite! 'cips-ip-homog-left 'v) k (list 't a) y)
                (dk-ass!)))))
            ((equal? g (wbc-a3 wbc-PHI))
             ((wbc-phi-clause! (lambda (a b y)
                (wbc-opv! 't a)
                (dk-apply! (dk-cite! 'cips-ip-add-right 'v) (list 't a) b y)
                (dk-ass!)))))
            (#t
             ((wbc-phi-clause! (lambda (k a y)
                (wbc-opv! 't a)
                (dk-apply! (dk-cite! 'cips-ip-conj-homog-right 'v) k (list 't a) y)
                (dk-ass!)))))))))))
(wbc-done! 'operator-form-in-bounded-forms)

;;; ===========================================================================
;;; (7) THE INVERSE MAP K -> L(H) IS CONTINUOUS FOR THE WEAK OPERATOR TOPOLOGY
;;; ===========================================================================
(define wbc-Z (list 'SUBSPACE-TOP wbc-PR wbc-K))
(define wbc-BHM '(BH-MODULE v))
(define wbc-BO '(BOUNDED-OPS v v))
(define wbc-psrep (list 'FORALL 'wqh_ (list 'IMPLIES (list 'IN 'wqh_ wbc-K)
  (wbc-vall '(wka_ wky_) (list '= (list 'wqh_ (wbc-pair 'wka_ 'wky_)) '((IP v) ((psf wqh_) wka_) wky_))))))
(define (wbc-ball q i) (list 'BALL 'CC-MS (list q i) 'sle_))
(define (wbc-phib q) (list 'VNB-LAMBDA 'wci_ 'slf_ (wbc-pair 'wci_ (wbc-ball q 'wci_))))
(define (wbc-k-sub!)
  (if (not (dk-asm? (list 'SUBSET wbc-K wbc-PRP)))
      (dk-have! (list 'SUBSET wbc-K wbc-PRP)
        (lambda () (mac 'subset-def)
                   (let ((c (wbc-var (dk-peel!) wbc-K))) (wbc-k-out! c) (dk-ass!))))))
(define (wbc-in-prp! q)                 ; q in K, (SUBSET K PRP): q in PRP, PTS PR
  (if (not (dk-asm? (list 'IN q wbc-PRP))) (dk-cite! 'subset-mem-fwd wbc-K wbc-PRP q))
  (wbc-pt! q))
(define (wbc-con! q i)                  ; i in CV, q in PRP, eps typed: [i, ball(q i, eps)] is a constraint
  (let* ((bl (wbc-ball q i)) (b (wbc-pair i bl))
         (buo (list 'BIG-UNION 'tpj_ wbc-CV (list 'OPENS (list wbc-CF 'tpj_))))
         (kk (list 'TPROD-CONSTR wbc-CV wbc-CF)))
    (if (not (dk-asm? (list 'IN b kk)))
        (begin
          (wbc-coord! q i)
          (dk-have! (list 'IN (list q i) '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (dk-ass!)))
          (dk-apply! (dk-cite! 'ball-is-open 'CC-MS) (list q i) 'sle_)
          (let ((oi (dk-apply! (dk-cite! 'metric-top-opens-iff 'CC-MS) bl)))
            (wbc-iff-bwd! oi (list 'IS-OPEN 'CC-MS bl)))
          (wbc-cfy! i)
          (dk-have! (list 'IN bl (list 'OPENS (list wbc-CF i))) (lambda () (subst (list '= (list wbc-CF i) wbc-MT)) (dk-ass!)))
          (dk-have! (list 'IN bl buo)
            (lambda () (for-each (lambda (l) (dk-focus! l) (if (not (dk-ass!)) (error "wbc-con!: big-union leaf" (expression->string (dk-goal)))))
                                 (dk-opened (lambda () (bu-mi i))))))
          (dk-cite! 'pair-in-cartesian wbc-CV buo i bl)
          (let ((im (dk-cite! 'tprod-constr-mem wbc-CV wbc-CF b)))
            (dk-have! (caddr (caddr im)) (lambda () (wbc-nth-all!) (dk-ass!)))
            (wbc-iff-bwd! im (list 'IN b (list 'CARTESIAN wbc-CV buo)) (caddr (caddr im))))))
    b))
(define (wbc-phi-val! q i)              ; i in ff: (= (PHI i) [i, ball])
  (let ((e (list '= (list (wbc-phib q) i) (wbc-pair i (wbc-ball q i)))))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (if (not (dk-lam-b!)) (rfl)))))
    e))
(define (wbc-img-in! q i)               ; i in ff, constraint landed: (IN (PHI i) bb)
  (let* ((ph (wbc-phib q)) (bb (list 'IMAGE ph 'slf_)) (b (wbc-pair i (wbc-ball q i))))
    (wbc-phi-val! q i)
    (dk-cite! 'membership-implies-sethood b (list 'TPROD-CONSTR wbc-CV wbc-CF))
    (dk-have! (list 'IN (list ph i) 'SET) (lambda () (subst (list '= (list ph i) b)) (dk-ass!)))
    (let ((im (dk-cite! 'image-membership-iff ph 'slf_ (list ph i))))
      (dk-have! (caddr (caddr im)) (lambda () (ew i) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))
      (wbc-iff-bwd! im (list 'IN (list ph i) 'SET) (caddr (caddr im))))))
(define (wbc-img-out! q c)              ; (IN c bb): the index i with c = [i, ball]; returns i
  (let* ((ph (wbc-phib q)) (bb (list 'IMAGE ph 'slf_))
         (im (dk-cite! 'image-membership-iff ph 'slf_ c)))
    (wbc-iff-fwd! im (list 'IN c bb))
    (dk-split! (caddr im))
    (let ((i (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f c) (dk-contains? f 'wci_))) "index") #t)))
      (dk-cite! 'subset-mem-fwd 'slf_ wbc-CV i)
      (wbc-phi-val! q i)
      (dk-have! (list '= c (wbc-pair i (wbc-ball q i)))
        (lambda () (subst (list '= c (list ph i))) (dk-ass!)))
      i)))

(sp (make-wff (wbc-alls '(v psf)
  (wbc-imps (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) (list 'IN 'psf (list 'FUN wbc-K wbc-BO)) wbc-psrep)
    (list 'IS-HOM-TOP-SPACE wbc-Z '(WOT v) 'psf)))))
(dk-peel!)
(wbc-setup!)
(wbc-k-sub!)
(dk-have! (list 'IN wbc-K 'SET) (lambda () (sep-set) (dk-ass!)))
(dk-cite! 'subspace-top-pts wbc-PR wbc-K)
(dk-have! (list 'SUBSET wbc-K (list 'PTS wbc-PR)) (lambda () (subst (list '== (list 'PTS wbc-PR) wbc-PRP)) (dk-ass!)))
(dk-cite! 'subspace-top-is-top-space wbc-PR wbc-K)
(dk-cite! 'subspace-top-opens wbc-PR wbc-K)
(dk-cite! 'wot-seminorm-family 'v)
(dk-cite! 'bh-module-vec 'v)
(dk-cite! 'bh-module-is-module 'v)
(dk-cite! 'wot-unfold 'v)
(subst (list '== '(WOT v) (list 'SEMINORM-TOP wbc-BHM wbc-CV '(WOT-PF v))))
(dk-have! (list 'IN 'psf (list 'FUN (list 'PTS wbc-Z) (list 'VEC wbc-BHM)))
  (lambda () (subst (list '== (list 'PTS wbc-Z) wbc-K)) (subst (list '== (list 'VEC wbc-BHM) wbc-BO)) (dk-ass!)))
(wbc-chain! (dk-cite! 'sntop-hom-of-local 'CC-NORMED-FIELD wbc-BHM wbc-CV '(WOT-PF v) wbc-Z 'psf)
  (list
    (lambda ()
      (let* ((l1 (let loop ((acc '()) (k 0)) (if (or (> k 8) (dk-head-is? (dk-goal) 'FORSOME)) acc (loop (append acc (dk-peel!)) (+ k 1)))))
             (q0 (wbc-var l1 (list 'PTS wbc-Z))))
        (dk-rewrite-h! (list 'IN q0 (list 'PTS wbc-Z)) (list 'PTS wbc-Z) wbc-K)
        (let* ((ff (wbc-var l1 'SET)))
          (let* ((eps (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) l1))))
            (dk-pos-parts! 'sle_)
            (wbc-in-prp! q0)
            (let* ((ph (wbc-phib q0)) (bb (list 'IMAGE ph 'slf_)) (box (list 'TPROD-BOX wbc-CV wbc-CF bb))
                   (w (list 'INTERSECTION box wbc-K)))
              (dk-cite! 'image-set ph 'slf_)
              (dk-cite! 'card-image-finite ph 'slf_)
              (dk-have! (list 'SUBSET bb (list 'TPROD-CONSTR wbc-CV wbc-CF))
                (lambda () (mac 'subset-def)
                  (let* ((c (wbc-var (dk-peel!) bb)) (i (wbc-img-out! q0 c)))
                    (wbc-con! q0 i)
                    (subst (list '= c (wbc-pair i (wbc-ball q0 i))))
                    (dk-ass!))))
              (dk-cite! 'tprod-box-open wbc-CV wbc-CF bb)
              ;; q0 is in the box
              (let ((bm (dk-cite! 'tprod-box-mem wbc-CV wbc-CF bb q0)))
                (dk-have! (caddr (caddr bm))
                  (lambda ()
                    (let* ((c (wbc-var (dk-peel!) bb)) (i (wbc-img-out! q0 c)))
                      (subst (list '= c (wbc-pair i (wbc-ball q0 i))))
                      (wbc-nth-all!)
                      (wbc-coord! q0 i)
                      (dk-have! (list 'IN (list q0 i) '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (dk-ass!)))
                      (dk-apply! (dk-cite! 'ball-center-in 'CC-MS) (list q0 i) 'sle_)
                      (dk-ass!))))
                (wbc-iff-bwd! bm (list 'IN q0 wbc-PRP) (caddr (caddr bm))))
              (let ((imq (dk-cite! 'intersection-membership box wbc-K q0)))
                (wbc-iff-bwd! imq (list 'IN q0 box) (list 'IN q0 wbc-K)))
              ;; W = box n K is open in the subspace
              (dk-have! (list 'IN w (list 'OPENS wbc-Z))
                (lambda ()
                  (subst (list '== (list 'OPENS wbc-Z)
                               (list 'SEP 'stw_ (list 'POWER wbc-K) (list 'FORSOME 'stu_ (list 'AND (list 'IN 'stu_ (list 'OPENS wbc-PR)) (list '= 'stw_ (list 'INTERSECTION 'stu_ wbc-K)))))))
                  (dk-cite! 'membership-implies-sethood box (list 'OPENS wbc-PR))
                  (dk-have! (list 'OR (list 'IN box 'SET) (list 'IN wbc-K 'SET)) (lambda () (if (dk-only! (list 'IN wbc-K 'SET)) (prop))))
                  (let ((ic (dk-cite! 'intersection-set-closure box wbc-K))) (if (not (dk-asm? (list 'IN w 'SET))) (detach! ic)))
                  (dk-have! (list 'FORALL 'wzz_ (list 'IMPLIES (list 'IN 'wzz_ w) (list 'IN 'wzz_ wbc-K)))
                    (lambda () (let* ((z (dk-di-var!)) (iz (dk-cite! 'intersection-membership box wbc-K z)))
                                 (wbc-iff-fwd! iz (list 'IN z w)) (dk-split! (caddr iz)) (dk-ass!))))
                  (dk-cite! 'power-mem-intro wbc-K w)
                  (in-sep! (lambda () (dk-ass!))
                           (lambda () (ew box) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))
              (ew w)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      ;; the estimate on W
                      (let* ((l4 (dk-peel!)) (p (wbc-var l4 w)) (i (wbc-var l4 'slf_))
                             (ip (dk-cite! 'intersection-membership box wbc-K p))
                             (n1 (list 'NTH 1 i)) (n2 (list 'NTH 2 i)))
                        (wbc-iff-fwd! ip (list 'IN p w))
                        (dk-split! (caddr ip))
                        (wbc-in-prp! p)
                        (dk-cite! 'subset-mem-fwd 'slf_ wbc-CV i)
                        (dk-split! (dk-cite! 'cartesian-nth i wbc-V wbc-V))
                        (dk-cite! 'cartesian-pair-eq i wbc-V wbc-V)
                        (wbc-con! q0 i)
                        (wbc-img-in! q0 i)
                        (let ((bmp (dk-cite! 'tprod-box-mem wbc-CV wbc-CF bb p)))
                          (wbc-iff-fwd! bmp (list 'IN p box))
                          (dk-split! (caddr bmp))
                          (dk-apply! (caddr (caddr bmp)) (list ph i)))
                        (let* ((h1 (wbc-ctx (list 'IN (list p (list 'NTH 1 (list ph i))) (list 'NTH 2 (list ph i)))))
                               (h2 (dk-rewrite-h! h1 (list ph i) (wbc-pair i (wbc-ball q0 i))))
                               (h3 (dk-nth-h! h2)))
                          h3)
                        (wbc-coord! p i) (wbc-coord! q0 i)
                        (let ((bmem (dk-cite! 'ball-membership 'CC-MS (list q0 i) 'sle_ (list p i))))
                          (wbc-iff-fwd! bmem (list 'IN (list p i) (wbc-ball q0 i)))
                          (dk-split-all! (list (caddr bmem))))
                        (dk-cite! 'cc-ms-dist (list q0 i) (list p i))
                        (dk-cite! 'cc-magnitude-sub-sym (list q0 i) (list p i))
                        ;; the seminorm of psf(p) - psf(q0) at i
                        (let* ((sp1 (list 'psf p)) (sq (list 'psf q0))
                               (nq (list (list 'VNEG wbc-BHM) sq)) (x (list (list 'VADD wbc-BHM) sp1 nq))
                               (nb (list 'BOP-NEG 'v 'v sq)) (sb (list 'BOP-SUM 'v 'v sp1 nb)))
                          (wbc-ap! 'psf wbc-K wbc-BO p) (wbc-ap! 'psf wbc-K wbc-BO q0)
                          (dk-have! (list 'IN sp1 (list 'VEC wbc-BHM)) (lambda () (subst (list '== (list 'VEC wbc-BHM) wbc-BO)) (dk-ass!)))
                          (dk-have! (list 'IN sq (list 'VEC wbc-BHM)) (lambda () (subst (list '== (list 'VEC wbc-BHM) wbc-BO)) (dk-ass!)))
                          (dk-apply! (dk-cite! 'module-vneg-type wbc-BHM) sq)
                          (dk-apply! (dk-cite! 'module-vadd-type wbc-BHM) sp1 nq)
                          (dk-rewrite-h! (list 'IN x (list 'VEC wbc-BHM)) (list 'VEC wbc-BHM) wbc-BO)
                          (dk-cite! 'wot-pf-apply 'v i x)
                          (subst (list '= (list (list '(WOT-PF v) i) x) (list 'magnitude (list '(IP v) (list x n1) n2))))
                          (dk-cite! 'bh-module-vadd 'v) (dk-cite! 'bh-module-vneg 'v)
                          (subst (list '== (list 'VADD wbc-BHM) '(BH-VADD v)))
                          (subst (list '== (list 'VNEG wbc-BHM) '(BH-VNEG v)))
                          (dk-cite! 'bh-vneg-value 'v sq)
                          (subst (list '= (list '(BH-VNEG v) sq) nb))
                          (wbc-opv! sq n1) (wbc-opv! sp1 n1)
                          (dk-have! (list 'IN nb wbc-BO)
                            (lambda () (subst (list '= nb (list '(BH-VNEG v) sq)))
                                       (dk-have! (list 'IN (list '(BH-VNEG v) sq) wbc-BO)
                                         (lambda () (subst (list '== '(BH-VNEG v) (list 'VNEG wbc-BHM))) (subst (list '== wbc-BO (list 'VEC wbc-BHM))) (dk-ass!)))
                                       (dk-ass!)))
                          (dk-cite! 'bh-vadd-value 'v sp1 nb)
                          (subst (list '= (list '(BH-VADD v) sp1 nb) sb))
                          (if (not (dk-asm? (list 'IN sp1 (list 'FUN wbc-V wbc-V)))) (wbc-opv! sp1 n1))
                          (wbc-opv! nb n1)
                          (dk-cite! 'bop-sum-apply 'v 'v sp1 nb n1)
                          (subst (list '= (list sb n1) (list '(VADD v) (list sp1 n1) (list nb n1))))
                          (dk-cite! 'bop-neg-apply 'v 'v sq n1)
                          (subst (list '= (list nb n1) (list '(VNEG v) (list sq n1))))
                          (dk-apply! (dk-cite! 'cips-vneg-type 'v) (list sq n1))
                          (dk-apply! (dk-cite! 'cips-ip-add-left 'v) (list sp1 n1) (list '(VNEG v) (list sq n1)) n2)
                          (subst (list '= (list '(IP v) (list '(VADD v) (list sp1 n1) (list '(VNEG v) (list sq n1))) n2)
                                       (list '+ (list '(IP v) (list sp1 n1) n2) (list '(IP v) (list '(VNEG v) (list sq n1)) n2))))
                          (dk-apply! (dk-cite! 'cips-ip-neg-left 'v) (list sq n1) n2)
                          (subst (list '= (list '(IP v) (list '(VNEG v) (list sq n1)) n2) (list '- (list '(IP v) (list sq n1) n2))))
                          (let ((rep (wbc-ctx wbc-psrep)))
                            (dk-apply! rep p n1 n2)
                            (dk-apply! rep q0 n1 n2))
                          (subst (list '= (list '(IP v) (list sp1 n1) n2) (list p (wbc-pair n1 n2))))
                          (subst (list '= (list '(IP v) (list sq n1) n2) (list q0 (wbc-pair n1 n2))))
                          (subst (list '= (wbc-pair n1 n2) i))
                          (dk-have! (list '= (list '- (list p i) (list q0 i)) (list '+ (list p i) (list '- (list q0 i))))
                            (lambda () (mac 'binary-minus-def) (if (wbc-open?) (rfl))))
                          (subst (list '= (list '+ (list p i) (list '- (list q0 i))) (list '- (list p i) (list q0 i))))
                          (subst (list '= (list 'magnitude (list '- (list p i) (list q0 i))) (list 'magnitude (list '- (list q0 i) (list p i)))))
                          (subst (list '== (list 'magnitude (list '- (list q0 i) (list p i))) (list '(DIST CC-MS) (list q0 i) (list p i))))
                          (dk-ass!)))))))))))))
(dk-ass!)
(wbc-done! 'bounded-forms-inverse-wot-continuous)

