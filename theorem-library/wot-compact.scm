;;; (8) PROPOSITION 5.10: THE UNIT BALL OF L(H) IS COMPACT IN THE WEAK OPERATOR TOPOLOGY
;;; ===========================================================================
(define (wbc-repf h s) (wbc-vall '(wka_ wky_) (list '= (list h (wbc-pair 'wka_ 'wky_)) (list '(IP v) (list s 'wka_) 'wky_))))
(define wbc-Q (list 'VNB-LAMBDA 'wqx_ wbc-K (list 'SEP 'wqs_ wbc-UB (wbc-repf 'wqx_ 'wqs_))))
(define wbc-T (list 'SUBSPACE-TOP '(WOT v) wbc-UB))
(define (wbc-q-out! h s)                ; (IN s (Q h)) in context (beta-reduced or not), h in K: land REPF(h, s)
  (if (not (dk-asm? (wbc-repf h s)))
      (let* ((sepm? (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) s) (pair? (caddr f)) (eq? (car (caddr f)) 'SEP))))
             (appm? (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) s) (pair? (caddr f)) (equal? (car (caddr f)) wbc-Q))))
             (m (or (find-first sepm? (dk-asms))
                    (let ((a (find-first appm? (dk-asms))))
                      (if (not a) (error "wbc-q-out!: no membership of" (expression->string s)))
                      (let* ((sf (list 'SEP 'wqs_ wbc-UB (wbc-repf h 'wqs_)))
                             (e (list '= (list wbc-Q h) sf)))
                        (if (not (dk-asm? e)) (dk-have! e (lambda () (dk-lam-b!) (if (wbc-open?) (wbc-close!)))))
                        (dk-rewrite-h! a (list wbc-Q h) sf))))))
        (if (not m) (error "wbc-q-out!: beta landed no SEP membership"))
        (dk-split-all! (dk-landed (lambda () (sep-me m)))))))
(define (wbc-same-form! s1 s2 rep1 rep2) ; REP1: h([a,y]) = <s1 a|y>, REP2 likewise for s2, both in context: s1 = s2
  (wbc-ub-out! s1) (wbc-ub-out! s2)
  (wbc-chain! (dk-cite! 'operator-of-form-unique 'v s1 s2)
    (list (lambda ()
            (let* ((ld (dk-peel!)) (xs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) ld))) (a (car xs)) (y (cadr xs)))
              (dk-apply! (wbc-ctx rep1) a y) (dk-apply! (wbc-ctx rep2) a y)
              (let ((e1 (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (caddr f) (list '(IP v) (list s1 a) y)))) (dk-asms)))
                    (e2 (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (caddr f) (list '(IP v) (list s2 a) y)))) (dk-asms))))
                (subst (list '= (caddr e1) (cadr e1)))
                (subst (list '= (caddr e2) (cadr e2)))
                (if (wbc-open?) (wbc-close!))))))))
(sp (make-wff (wbc-alls '(v) (wbc-imps '((IS-HILBERT-SPACE v)) (list 'IS-COMPACT-T wbc-T)))))
