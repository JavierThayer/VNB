(define (wbc-hom-map h) (list-ref h 3))
(define (wbc-grounded?) (sequent-node-grounded? (proof-state-focus *ps*)))
(define (wbc-beta-val! e)
  (if (not (dk-asm? e))
      (dk-have! e (lambda ()
                    (dk-lam-b!)
                    (if (not (wbc-grounded?))
                        (begin
                          (for-each (lambda (h) (if (and (pair? h) (eq? (car h) '=) (pair? (cadr h)) (pair? (car (cadr h)))
                                                         (eq? (car (car (cadr h))) 'TPROJ) (dk-contains? (dk-goal) (cadr h)))
                                                    (subst h)))
                                    (dk-asms))
                          (if (not (wbc-grounded?)) (rfl)))))))
  e)
;; p in PTS PR fails an identity; A, B homs PR -> MT; VALS! q lands the values and returns (ta . tb);
;; at c in K, (= ta tb) follows by CFACT! c ta tb.  Lands the separating neighbourhood and closes.
(define (wbc-separate! p A B vals! cfact!)
  (let ((agree (list 'FORALL 'ctc_ (list 'IMPLIES (list 'IN 'ctc_ wbc-K) (list '= (list A 'ctc_) (list B 'ctc_))))))
    (dk-have! agree
      (lambda ()
        (let ((c (dk-di-var!)))
          (wbc-k-out! c)
          (let ((v (vals! c)))
            (subst (list '= (list A c) (car v)))
            (subst (list '= (list B c) (cdr v)))
            (cfact! c (car v) (cdr v))))))
    (let ((v (vals! p)))
      (dk-have! (list 'NOT (list '= (list A p) (list B p)))
        (lambda ()
          (di)
          (dk-have! (list '= (car v) (cdr v))
            (lambda () (subst (list '= (car v) (list A p))) (subst (list '= (cdr v) (list B p))) (dk-ass!)))
          (ai (list 'NOT (list '= (car v) (cdr v)))))))
    (dk-cite! 'cc-hom-separate wbc-PR A B wbc-K p)
    (dk-ass!)))
(define (wbc-skolem-n! fail n)          ; FORSOME^n (AND ..) in context: the n witnesses, body split
  (let loop ((k 0) (f (wbc-ctx fail)) (ws '()))
    (if (= k n)
        (begin (dk-split-all! (list (dk-pick (lambda (h) (and (dk-head-is? h 'AND) (every (lambda (w) (dk-contains? h w)) ws))) "the failure body")))
               ws)
        (let* ((w (dk-skolem! f #f))
               (nxt (if (< (+ k 1) n) (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h w) (every (lambda (u) (dk-contains? h u)) ws))) "inner failure") #f)))
          (loop (+ k 1) nxt (append ws (list w)))))))
(define (wbc-prove-clause! fail)        ; prove the clause on the goal from NOT FAIL in context
  (let* ((ld (dk-peel!)) (xs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) ld))) (g (dk-goal)))
    (use-em g
      (lambda () (dk-ass!))
      (lambda ()
        (dk-have! fail (lambda () (for-each ew xs) (dk-conj-close! (lambda () (dk-ass!)))))
        (ai (list 'NOT fail))))))

(sp (make-wff (wbc-alls '(v) (wbc-imps '((IS-COMPLEX-INNER-PRODUCT-SPACE v)) (list 'IS-TOP-CLOSED wbc-PR wbc-K)))))
