;;; wot-compact.scm -- agent BA-1117-TRACE (round 2), 2026-11-17.
;;; BanachAlgebras.pdf Proposition 5.10: the unit ball of L(H) is compact in the weak operator topology.
;;; (1) sntop-hom-of-local, the initial-topology lemma (finding F-5.10 of BA-1111-C2-REPORT.md): a map g
;;;     from a topological space z into a space with the topology of a family of seminorms is continuous
;;;     when, at every point q, every finite set F of seminorms and every eps > 0, some open W around q
;;;     has p_i(g(w) - g(q)) <= eps for w in W and i in F.
;;; (2) the bounded sesquilinear forms of norm <= 1 are a closed, confined, hence compact set K of the
;;;     product CC^(H x H) (Tychonoff through confined-closed-compact);
;;; (3) each h in K is <S . | .> for an S in the unit ball (bounded-sesquilinear-form-operator), the map
;;;     h |-> S is continuous from K into the unit ball with the weak operator topology (by (1)) and onto,
;;;     so the unit ball is compact (compact-t-continuous-onto).
;;; DESTINATION: theorem-library/wot-compact.scm.  Library: operator-algebras.  Helper prefix: wbc-.
;;; Vocab: wot-compact-vocab.scm (OP-UNIT-BALL).  Nothing asserted.
(define (wbc-open?)
  (let ((leaf (or *dk-lane-leaf* (proof-state-focus *ps*))))
    (not (sequent-node-grounded? leaf))))
(define (wbc-have! f th) (dk-have! f (dk-lane th)))
(define (wbc-and! . ps)
  (let ((f (let build ((l ps)) (if (null? (cdr l)) (car l) (list 'AND (car l) (build (cdr l)))))))
    (if (not (dk-asm? f)) (wbc-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (wbc-cite! thm . args)
  (let loop ((r (apply dk-cite! thm args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (if (dk-asm? (caddr r))
            (loop (caddr r))
            (loop (dk-landed-1 (lambda () (detach! r)))))
        r)))
(define (wbc-close!)
  (cond ((not (wbc-open?)) #t)
        ((dk-asm? (dk-goal)) (ass))
        ((dk-head-is? (dk-goal) '==) (qrfl))
        ((and (dk-head-is? (dk-goal) '=) (dk-asm? (list '= (caddr (dk-goal)) (cadr (dk-goal)))))
         (subst (list '= (caddr (dk-goal)) (cadr (dk-goal)))) (if (wbc-open?) (rfl)))
        (#t (rfl))))
(define (wbc-ctx f)
  (or (dk-ctx-form f) (error "wbc-ctx: not in context" (expression->string f))))
(define (wbc-ap! f a b x) (if (not (dk-asm? (list 'IN (list f x) b))) (dk-cite! 'fun-apply-type-c f a b x)))
(define (wbc-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; wbc: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l) (display ";;   ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (h) (display ";;      asm: ") (display (expression->string h)) (newline))
                              (list-head (dk-asms-of l) (min 40 (length (dk-asms-of l))))))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'analysis))
(define (wbc-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (wbc-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define (wbc-detach-close! ch th) (detach-with! ch th) (dk-ass!))
(define (wbc-absurd! a) (if (dk-only! a (list 'NOT a)) (prop)))
(define (wbc-var landed cls)
  (let ((h (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cls))) landed)))
    (if h (cadr h) (error "wbc-var: no landed typing in" cls))))
(define (wbc-iff-fwd! iff from)          ; (IFF a b) landed, a in context: land b
  (let ((b (caddr iff)))
    (if (not (dk-asm? b)) (dk-have! b (lambda () (if (dk-only! iff from) (prop)))))
    b))
(define (wbc-iff-bwd! iff . froms)       ; (IFF a b) landed, the parts of b in context: land a
  (let ((a (cadr iff)))
    (if (not (dk-asm? a)) (dk-have! a (lambda () (if (apply dk-only! iff froms) (prop)))))
    a))

;;; ===========================================================================
;;; (1) THE INITIAL-TOPOLOGY LEMMA
;;; ===========================================================================
(define wbc-ST '(SEMINORM-TOP m ix pf))
(define (wbc-sub m a b) (list (list 'VADD m) a (list (list 'VNEG m) b)))
(define wbc-hloc
  (list 'FORALL 'slq_ (list 'IMPLIES '(IN slq_ (PTS z))
    (list 'FORALL 'slf_ (list 'IMPLIES '(IN slf_ SET) (list 'IMPLIES '(IN (CARD slf_) NN) (list 'IMPLIES '(SUBSET slf_ ix)
      (list 'FORALL 'sle_ (list 'IMPLIES '(POS-RR sle_)
        (list 'FORSOME 'slw_ (list 'AND '(IN slw_ (OPENS z)) (list 'AND '(IN slq_ slw_)
          (list 'FORALL 'slp_ (list 'IMPLIES '(IN slp_ slw_)
            (list 'FORALL 'sli_ (list 'IMPLIES '(IN sli_ slf_)
              (list '<= (list '(pf sli_) (wbc-sub 'm '(g slp_) '(g slq_))) 'sle_)))))))))))))))))
(sp (make-wff (wbc-alls '(fld m ix pf z g)
  (wbc-imps (list '(IS-SEMINORM-FAMILY-ON fld m ix pf) '(IS-TOP-SPACE z) '(IN g (FUN (PTS z) (VEC m))) wbc-hloc)
    (list 'IS-HOM-TOP-SPACE 'z wbc-ST 'g)))))
(dk-peel!)
(dk-have! '(IS-MODULE m) (lambda () (mac-h 'IS-SEMINORM-FAMILY-ON (dk-ctx-form '(IS-SEMINORM-FAMILY-ON fld m ix pf))) (dk-split-all!) (ass)))
(dk-cite! 'frm-module-vec-set 'm)
(dk-cite! 'sntop-is-top-space 'fld 'm 'ix 'pf)
(dk-cite! 'sntop-pts 'm 'ix 'pf)
(dk-project! '(IN (PTS z) (OPENS z)) 'is-top-space '(IS-TOP-SPACE z))
(dk-cite! 'membership-implies-sethood '(PTS z) '(OPENS z))
(mac 'is-hom-top-space-def)
(dk-conj-close!
  (lambda ()
    (let ((gl (dk-goal)))
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? gl 'IN)
         (subst (list '== (list 'PTS wbc-ST) '(VEC m)))
         (dk-ass!))
        (#t
         (let* ((u (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
                (pp (list 'PREIMAGE 'z 'g u))
                (ch (dk-cite! 'top-open-of-local 'z pp))
                (ch2 (detach-with! ch
                       (lambda ()
                         (mac 'subset-def)
                         (let* ((w (dk-di-var!)) (pm (dk-cite! 'preimage-membership 'z 'g u w)))
                           (if (dk-only! pm (list 'IN w pp)) (prop)))))))
           (wbc-detach-close! ch2
             (lambda ()
               (let* ((a (wbc-var (dk-peel!) pp))
                      (pm (dk-cite! 'preimage-membership 'z 'g u 'a))
                      (pma (dk-cite! 'preimage-membership 'z 'g u a)))
                 (wbc-iff-fwd! pma (list 'IN a pp))
                 (dk-split! (caddr pma))
                 (wbc-ap! 'g '(PTS z) '(VEC m) a)
                 (dk-have! (list 'IN (list 'g a) (list 'PTS wbc-ST)) (lambda () (subst (list '== (list 'PTS wbc-ST) '(VEC m))) (dk-ass!)))
                 (let* ((ex (dk-cite! 'sntop-open-basic 'fld 'm 'ix 'pf u (list 'g a)))
                        (ff (dk-skolem! ex #t))
                        (ep (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f ff))) "radius") #t))
                        (bl (list 'SN-BALL 'm 'pf ff (list 'g a) ep))
                        (hl (wbc-ctx wbc-hloc)))
                   (dk-split-all! (filter (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f ep))) (dk-asms)))
                   (dk-split-all! (filter (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f ff) (not (dk-contains? f 'FORSOME)))) (dk-asms)))
                   (dk-apply! hl a ff ep)
                   (let* ((w (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'slw_) (dk-contains? f ep) (not (dk-contains? f 'slq_)))) "the neighbourhood") #t))
                          (_ (dk-split-all! (filter (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f w))) (dk-asms))))
                          (tl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f w) (dk-contains? f ep))) "the bound on W")))
                     (ew w)
                     (dk-conj-close!
                       (lambda ()
                         (if (not (dk-ass!))
                             (begin
                               (mac 'subset-def)
                               (let* ((q (dk-di-var!))
                                      (gq (list 'g q)))
                                 (dk-apply! (dk-cite! 'top-open-subset 'z) w)
                                 (dk-cite! 'subset-mem-fwd w '(PTS z) q)
                                 (wbc-ap! 'g '(PTS z) '(VEC m) q)
                                 (dk-apply! tl q)
                                 (let* ((bi (dk-cite! 'sn-ball-membership 'm 'pf ff (list 'g a) ep gq)))
                                   (wbc-iff-bwd! bi (list 'IN gq '(VEC m))
                                                 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f gq) (dk-contains? f ep))) "bound at q"))
                                   (dk-cite! 'subset-mem-fwd bl u gq)
                                   (let ((pmq (dk-cite! 'preimage-membership 'z 'g u q)))
                                     (wbc-iff-bwd! pmq (list 'IN q '(PTS z)) (list 'IN gq u))))))))))))))))))))
(wbc-done! 'sntop-hom-of-local)

;;; ===========================================================================
;;; (2) THE UNIT BALL AND THE FORM BOUND |<T x | y>| <= ||x|| ||y||
;;; ===========================================================================
(define wbc-UB '(OP-UNIT-BALL v))
(define wbc-UBSEP '(SEP wub_ (BOUNDED-OPS v v) (<= (OPNORM v v wub_) 1)))
(sp (make-wff (wbc-alls '(v) (list '== wbc-UB wbc-UBSEP))))
(dk-peel!) (mac 'OP-UNIT-BALL) (qrfl)
(wbc-done! 'op-unit-ball-unfold)

(define (wbc-ub-out! t)                ; (IN t UB) in context: t in BOUNDED-OPS and opnorm <= 1
  (if (not (dk-asm? (list '<= (list 'OPNORM 'v 'v t) 1)))
      (begin
        (dk-cite! 'op-unit-ball-unfold 'v)
        (let ((m (dk-rewrite-h! (list 'IN t wbc-UB) wbc-UB wbc-UBSEP)))
          (dk-split-all! (dk-landed (lambda () (sep-me m))))))))
(define (wbc-ipn! x)                   ; x in VEC v: ip-norm typed and nonnegative
  (if (not (dk-asm? (list '<= 0 (list 'IP-NORM 'v x))))
      (begin (dk-apply! (dk-cite! 'cips-ipn-in-rr 'v) x)
             (dk-apply! (dk-cite! 'cips-ipn-nonneg 'v) x))))
(define (wbc-opv! t x)                 ; t in BOUNDED-OPS, x in VEC: (t x) in VEC
  (if (not (dk-asm? (list 'IN (list t x) '(VEC v))))
      (begin
        (if (not (dk-asm? (list 'IN t '(FUN (VEC v) (VEC v)))))
            (let ((bm (dk-cite! 'bounded-ops-membership 'v 'v t)))
              (dk-have! (list 'IN t '(FUN (VEC v) (VEC v))) (lambda () (if (dk-only! bm (list 'IN t '(BOUNDED-OPS v v))) (prop))))))
        (dk-cite! 'fun-apply-type-c t '(VEC v) '(VEC v) x))))

;; an operator of the unit ball has |<T x | y>| <= ||x|| ||y||
(sp (make-wff (wbc-alls '(v t x y)
  (wbc-imps (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) (list 'IN 't wbc-UB) '(IN x (VEC v)) '(IN y (VEC v)))
    '(<= (magnitude ((IP v) (t x) y)) (* (IP-NORM v x) (IP-NORM v y)))))))
(dk-peel!)
(wbc-ub-out! 't)
(wbc-opv! 't 'x)
(wbc-ipn! 'x) (wbc-ipn! 'y) (wbc-ipn! '(t x))
(dk-cite! 'opnorm-in-rr 'v 'v 't)
(dk-cite! 'cips-ip-magnitude-le 'v '(t x) 'y)
(dk-apply! (dk-cite! 'opnorm-bound 'v 'v 't) 'x)
(dk-real! 1)
(dk-cite! 'rr-mul-le-right '(OPNORM v v t) 1 '(IP-NORM v x))
(dk-real! '(* (OPNORM v v t) (IP-NORM v x)))
(dk-have! '(<= (IP-NORM v (t x)) (IP-NORM v x))
  (lambda () (dk-ineq! '(<= (IP-NORM v (t x)) (* (OPNORM v v t) (IP-NORM v x)))
                       '(<= (* (OPNORM v v t) (IP-NORM v x)) (* 1 (IP-NORM v x)))
                       '(IN (* (OPNORM v v t) (IP-NORM v x)) RR) '(IN (IP-NORM v x) RR) '(IN (IP-NORM v (t x)) RR))))
(dk-cite! 'rr-mul-le-right '(IP-NORM v (t x)) '(IP-NORM v x) '(IP-NORM v y))
(dk-real! '(* (IP-NORM v (t x)) (IP-NORM v y)))
(dk-real! '(* (IP-NORM v x) (IP-NORM v y)))
(dk-apply! (dk-cite! 'cips-ip-type 'v) '(t x) 'y)
(dk-cite! 'cc-magnitude-closed '((IP v) (t x) y))
(dk-ineq! '(<= (magnitude ((IP v) (t x) y)) (* (IP-NORM v (t x)) (IP-NORM v y)))
          '(<= (* (IP-NORM v (t x)) (IP-NORM v y)) (* (IP-NORM v x) (IP-NORM v y)))
          '(IN (magnitude ((IP v) (t x) y)) RR) '(IN (* (IP-NORM v (t x)) (IP-NORM v y)) RR) '(IN (* (IP-NORM v x) (IP-NORM v y)) RR))
(wbc-done! 'op-unit-ball-form-bound)

;; conversely, a bounded operator with |<T x | y>| <= ||x|| ||y|| lies in the unit ball
(define wbc-fb '(FORALL wfx_ (IMPLIES (IN wfx_ (VEC v)) (FORALL wfy_ (IMPLIES (IN wfy_ (VEC v))
  (<= (magnitude ((IP v) (t wfx_) wfy_)) (* (IP-NORM v wfx_) (IP-NORM v wfy_))))))))
(sp (make-wff (wbc-alls '(v t)
  (wbc-imps (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) '(IN t (BOUNDED-OPS v v)) wbc-fb) (list 'IN 't wbc-UB)))))
(dk-peel!)
(define wbc-sp3 (dk-cite! 'opnorm-spec 'v 'v 't))
(dk-split-all! (list wbc-sp3))
(dk-real! 1)
(dk-have! '(FORALL wgx_ (IMPLIES (IN wgx_ (VEC v)) (<= (IP-NORM v (t wgx_)) (* 1 (IP-NORM v wgx_)))))
  (lambda ()
    (let ((x (dk-di-var!)))
      (wbc-opv! 't x) (wbc-ipn! x) (wbc-ipn! (list 't x))
      (dk-have! (list '<= (list 'IP-NORM 'v (list 't x)) (list 'IP-NORM 'v x))
        (lambda ()
          (let ((ch (dk-cite! 'cips-ip-bound-least 'v (list 't x) (list 'IP-NORM 'v x))))
            (detach-with! ch
              (lambda ()
                (let* ((y (dk-di-var!)) (ty (list 't x))
                       (iyt (list '(IP v) y ty)) (ity (list '(IP v) ty y)))
                  (wbc-ipn! y)
                  (dk-apply! (dk-cite! 'cips-ip-type 'v) ty y)
                  (dk-apply! (dk-cite! 'cips-ip-conj-sym 'v) ty y)
                  (dk-cite! 'cc-magnitude-conjugate ity)
                  (dk-apply! (wbc-ctx wbc-fb) x y)
                  (subst (list '= iyt (list 'conjugate ity)))
                  (subst (list '= (list 'magnitude (list 'conjugate ity)) (list 'magnitude ity)))
                  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-ass!)))))
            (dk-ass!))))
      (dk-ineq! (list '<= (list 'IP-NORM 'v (list 't x)) (list 'IP-NORM 'v x))
                (list 'IN (list 'IP-NORM 'v (list 't x)) 'RR) (list 'IN (list 'IP-NORM 'v x) 'RR)))))
(dk-cite! 'rr-leq-reflexive 1)
(dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
(dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'd_))) "least bound") 1)
(dk-cite! 'op-unit-ball-unfold 'v)
(subst (list '== wbc-UB wbc-UBSEP))
(in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))
(wbc-done! 'op-unit-ball-of-form-bound)

;;; ===========================================================================
;;; (3) THE BOUNDED SESQUILINEAR FORMS OF NORM <= 1 ARE CLOSED IN CC^(H x H)
;;; ===========================================================================
(define wbc-V '(VEC v))
(define wbc-CV '(CARTESIAN (VEC v) (VEC v)))
(define wbc-MT '(METRIC-TOP CC-MS))
(define wbc-CF (list 'VNB-LAMBDA 'bgx_ wbc-CV wbc-MT))
(define wbc-PRP (list 'TPROD-PTS wbc-CV wbc-CF))
(define wbc-PR (list 'TPRODUCT-TOP wbc-CV wbc-CF))
(define (wbc-pair a b) (list 'LIST a b))
(define (wbc-vall vs body) (fold-right (lambda (x acc) (list 'FORALL x (list 'IMPLIES (list 'IN x (if (eq? x 'wkk_) 'CC wbc-V)) acc))) body vs))
(define (wbc-bnd h) (wbc-vall '(wka_ wky_) (list '<= (list 'magnitude (list h (wbc-pair 'wka_ 'wky_))) '(* (IP-NORM v wka_) (IP-NORM v wky_)))))
(define (wbc-a1 h) (wbc-vall '(wka_ wkb_ wky_) (list '= (list h (wbc-pair '((VADD v) wka_ wkb_) 'wky_)) (list '+ (list h (wbc-pair 'wka_ 'wky_)) (list h (wbc-pair 'wkb_ 'wky_))))))
(define (wbc-a2 h) (wbc-vall '(wkk_ wka_ wky_) (list '= (list h (wbc-pair '((ACT v) wkk_ wka_) 'wky_)) (list '* 'wkk_ (list h (wbc-pair 'wka_ 'wky_))))))
(define (wbc-a3 h) (wbc-vall '(wka_ wkb_ wky_) (list '= (list h (wbc-pair 'wka_ '((VADD v) wkb_ wky_))) (list '+ (list h (wbc-pair 'wka_ 'wkb_)) (list h (wbc-pair 'wka_ 'wky_))))))
(define (wbc-a4 h) (wbc-vall '(wkk_ wka_ wky_) (list '= (list h (wbc-pair 'wka_ '((ACT v) wkk_ wky_))) (list '* '(conjugate wkk_) (list h (wbc-pair 'wka_ 'wky_))))))
(define wbc-K (list 'SEP 'wkh_ wbc-PRP (list 'AND (wbc-bnd 'wkh_) (list 'AND (wbc-a1 'wkh_) (list 'AND (wbc-a2 'wkh_) (list 'AND (wbc-a3 'wkh_) (wbc-a4 'wkh_)))))))
;; the failure of a clause, as an existential: (cls h) with its quantifier prefix turned into FORSOMEs
(define (wbc-fail clause-fn h)
  (let loop ((f (clause-fn h)) (gs '()))
    (if (dk-head-is? f 'FORALL)
        (let ((x (cadr f)) (g (cadr (caddr f))) (body (caddr (caddr f))))
          (loop body (append gs (list (cons x g)))))
        (let* ((ren (map (lambda (p) (cons (car p) (string->symbol (string-append "wf" (substring (symbol->string (car p)) 2 (string-length (symbol->string (car p)))))))) gs))
               (rn (lambda (t) (fold-left (lambda (acc p) (wbc-replace acc (car p) (cdr p))) t ren)))
               (core (let build ((l gs)) (if (null? l) (list 'NOT (rn f)) (list 'AND (rn (cdar l)) (build (cdr l)))))))
          (fold-right (lambda (p acc) (list 'FORSOME (cdr p) acc)) core ren)))))
(define (wbc-replace t a b) (cond ((eq? t a) b) ((pair? t) (map (lambda (x) (wbc-replace x a b)) t)) (#t t)))

(define (wbc-mt!)
  (if (not (dk-asm? (list 'IS-TOP-SPACE wbc-MT)))
      (begin (dk-cite! 'cc-is-metric-space) (dk-cite! 'metric-top-is-top-space 'CC-MS)
             (dk-cite! 'cc-metric-top-pts) (dk-cite! 'cc-is-set) (dk-cite! 'cc-ms@pts))))
(define (wbc-setup!)                    ; cips v in context: the product, its family, sets, PTS
  (wbc-mt!)
  (if (not (dk-asm? (list 'IS-TOP-SPACE wbc-PR)))
      (begin
        (dk-cite! 'cips-vec-set 'v)
        (let ((ci (dk-cite! 'cartesian-set-iff wbc-V wbc-V)))
          (dk-have! (list 'IN wbc-CV 'SET) (lambda () (if (dk-only! ci (list 'IN wbc-V 'SET)) (prop)))))
        (dk-cite! 'cc-product-family wbc-CV)
        (dk-split! (dk-cite! 'tprod-sets wbc-CV wbc-CF))
        (dk-cite! 'tprod-top-pts wbc-CV wbc-CF)
        (dk-cite! 'tprod-top-is-top-space wbc-CV wbc-CF))))
(define (wbc-cfy! y)
  (let ((e (list '= (list wbc-CF y) wbc-MT)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (if (not (dk-lam-b!)) (rfl)))))
    e))
(define (wbc-vt! x)                     ; type a vector built from VADD and ACT over typed atoms
  (let ((want (list 'IN x wbc-V)))
    (cond ((dk-asm? want) x)
          ((and (pair? x) (equal? (car x) '(VADD v)))
           (wbc-vt! (cadr x)) (wbc-vt! (caddr x)) (dk-apply! (dk-cite! 'cips-vadd-type 'v) (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT v)))
           (wbc-vt! (caddr x)) (dk-apply! (dk-cite! 'cips-act-type 'v) (cadr x) (caddr x)) x)
          (#t (error "wbc-vt!: cannot type" (expression->string x))))))
(define (wbc-it! i)                     ; i = (LIST a b): (IN i CV)
  (if (not (dk-asm? (list 'IN i wbc-CV)))
      (begin (wbc-vt! (cadr i)) (wbc-vt! (caddr i)) (dk-cite! 'pair-in-cartesian wbc-V wbc-V (cadr i) (caddr i))))
  i)
(define (wbc-proj i) (list 'TPROJ wbc-CV wbc-CF i))
(define (wbc-proj-hom! i)
  (let ((g (list 'IS-HOM-TOP-SPACE wbc-PR wbc-MT (wbc-proj i))))
    (if (not (dk-asm? g))
        (begin (wbc-it! i)
               (dk-cite! 'tproj-continuous wbc-CV wbc-CF i)
               (wbc-cfy! i)
               (dk-rewrite-h! (list 'IS-HOM-TOP-SPACE wbc-PR (list wbc-CF i) (wbc-proj i)) (list wbc-CF i) wbc-MT)))
    g))
(define (wbc-coord! h i)                ; h in PRP, i in CV: (IN (h i) CC)
  (let ((g (list 'IN (list h i) 'CC)))
    (if (not (dk-asm? g))
        (begin
          (if (not (dk-asm? (list 'IN h (list 'FUN wbc-CV 'CC)))) (dk-cite! 'cc-product-fun wbc-CV h))
          (dk-cite! 'fun-apply-type-c h wbc-CV 'CC i)))
    g))
(define (wbc-pval! i q)                 ; q in PRP: (= ((P i) q) (q i)) and q i typed
  (wbc-it! i)
  (let ((e (list '= (list (wbc-proj i) q) (list q i))))
    (if (not (dk-asm? e)) (dk-cite! 'tproj-value wbc-CV wbc-CF i q))
    (wbc-coord! q i)
    e))
(define (wbc-pt! q)                     ; q in PRP: q in PTS PR
  (if (not (dk-asm? (list 'IN q (list 'PTS wbc-PR))))
      (dk-have! (list 'IN q (list 'PTS wbc-PR)) (lambda () (subst (list '== (list 'PTS wbc-PR) wbc-PRP)) (dk-ass!)))))
(define (wbc-k-out! c)                  ; (IN c K) in context: c in PRP and the five clauses (consumes it)
  (if (not (dk-asm? (wbc-a4 c)))
      (dk-split-all! (dk-landed (lambda () (sep-me (wbc-ctx (list 'IN c wbc-K)))))))
