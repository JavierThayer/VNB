(dk-have! (list 'IN wbc-UB 'SET) (lambda () (subst (list '== wbc-UB wbc-UBSEP)) (sep-set) (dk-ass!)))
;; the inverse map, by unique choice
(define wbc-uniq
  (list 'FORALL 'ucx (list 'IMPLIES (list 'IN 'ucx wbc-K)
    (list 'FORSOME 'ucy (list 'AND (list 'IN 'ucy wbc-UB) (list 'AND (list 'IN 'ucy (list wbc-Q 'ucx))
      (list 'FORALL 'ucz (list 'IMPLIES (list 'IN 'ucz wbc-UB) (list 'IMPLIES (list 'IN 'ucz (list wbc-Q 'ucx)) '(= ucz ucy))))))))))
(dk-have! wbc-uniq
  (lambda ()
    (let* ((h (wbc-var (dk-peel!) wbc-K))
           (ex (dk-cite! 'bounded-form-operator-in-unit-ball 'v h))
           (s (dk-skolem! ex #t))
           (rep (wbc-repf h s)))
      (dk-split-all! (filter (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f s))) (dk-asms)))
      (dk-have! (list 'IN s (list wbc-Q h))
        (lambda () (dk-lam-b!) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
      (ew s)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((ld (dk-peel!)) (z (wbc-var ld wbc-UB)))
                (if (not (dk-asm? (list 'IN z (list wbc-Q h)))) (dk-peel!))
                (wbc-q-out! h z)
                (wbc-same-form! z s (wbc-repf h z) rep)
                (if (wbc-open?) (dk-ass!)))))))))
(define wbc-uc (wbc-chain! (dk-cite! 'uniq-choice-fun wbc-K wbc-UB wbc-Q) '()))
(define wbc-psf (dk-skolem! wbc-uc #t))
(define wbc-psq (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f wbc-psf) (dk-contains? f 'SEP))) "the choice"))
(define (wbc-psf-at! h)                 ; h in K: psf(h) in UB, BO, and REPF(h, psf h)
  (let ((s (list wbc-psf h)))
    (wbc-ap! wbc-psf wbc-K wbc-UB h)
    (wbc-ub-out! s)
    (if (not (dk-asm? (wbc-repf h s)))
        (begin (dk-apply! wbc-psq h) (wbc-q-out! h s)))
    s))
(dk-have! (list 'IN wbc-psf (list 'FUN wbc-K wbc-BO))
  (lambda ()
    (let* ((fi (dk-cite! 'fun-codomain-iff wbc-K wbc-BO wbc-psf))
          (fj (dk-cite! 'fun-codomain-iff wbc-K wbc-UB wbc-psf)))
      (wbc-iff-fwd! fj (list 'IN wbc-psf (list 'FUN wbc-K wbc-UB)))
      (dk-split! (caddr fj))
      (dk-have! (caddr (caddr fi)) (lambda () (let ((h (dk-di-var!))) (wbc-psf-at! h) (dk-ass!))))
      (wbc-iff-bwd! fi (list 'IN wbc-psf (list 'FUN wbc-K)) (caddr (caddr fi))))))
(define wbc-psrep2 (wbc-replace wbc-psrep 'psf wbc-psf))
(dk-have! wbc-psrep2
  (lambda () (let* ((ld (dk-peel!)) (h (wbc-var ld wbc-K))
                    (xs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) wbc-V))) ld))))
               (wbc-psf-at! h)
               (if (pair? xs) (apply dk-apply! (wbc-ctx (wbc-repf h (list wbc-psf h))) xs))
               (dk-ass!))))
