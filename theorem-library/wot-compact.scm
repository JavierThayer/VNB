(define wbc-rep
  (wbc-chain! (dk-cite! 'bounded-sesquilinear-form-operator 'v wbc-BF 1)
    (list (wbc-bf-ident-th (wbc-a1 'h))
          (wbc-bf-ident-th (wbc-a2 'h))
          (lambda ()
            (let* ((ld (dk-peel!)) (xs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) ld)))
                   (a (car xs)) (y (cadr xs)) (i (wbc-pair a y)) (r (list '* (list 'IP-NORM 'v a) (list 'IP-NORM 'v y))))
              (wbc-it! i) (wbc-coord! 'h i)
              (dk-lam-b!)
              (dk-apply! (wbc-ctx (wbc-bnd 'h)) a y)
              (wbc-ipn! a) (wbc-ipn! y) (dk-real! r)
              (dk-cite! 'cc-magnitude-closed (list 'h i))
              (dk-ineq! (list '<= (list 'magnitude (list 'h i)) r) (list 'IN (list 'magnitude (list 'h i)) 'RR) (list 'IN r 'RR))))
          (wbc-bf-ident-th (wbc-a3 'h))
          (wbc-bf-ident-th (wbc-a4 'h)))))
(define wbc-S (dk-skolem! wbc-rep #t))
(define wbc-Seq (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f wbc-S))) "the representation"))
(define (wbc-hval! x y)                 ; (= (h [x, y]) ((IP v) (S x) y)), x, y typed
  (let ((e (list '= (list 'h (wbc-pair x y)) (list '(IP v) (list wbc-S x) y))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (dk-apply! wbc-Seq x y)
            (let ((b (list (list wbc-BF x) y)))
              (dk-have! (list '= b (list 'h (wbc-pair x y))) (lambda () (wbc-it! (wbc-pair x y)) (dk-lam-b!) (if (not (wbc-grounded?)) (rfl))))
              (subst (list '= (list 'h (wbc-pair x y)) b))
              (dk-ass!)))))
    e))
(dk-have! (list 'IN wbc-S wbc-UB)
  (lambda ()
    (let ((ch (dk-cite! 'op-unit-ball-of-form-bound 'v wbc-S)))
      (wbc-chain! ch
        (list (lambda ()
                (let* ((ld (dk-peel!)) (xs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) ld))) (x (car xs)) (y (cadr xs)))
                  (wbc-hval! x y)
                  (dk-apply! (wbc-ctx (wbc-bnd 'h)) x y)
                  (subst (list '= (list '(IP v) (list wbc-S x) y) (list 'h (wbc-pair x y))))
                  (dk-ass!)))))
      (dk-ass!))))
(ew wbc-S)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (let* ((ld (dk-peel!)) (xs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) ld))))
          (wbc-hval! (car xs) (cadr xs))
          (dk-ass!)))))
(wbc-done! 'bounded-form-operator-in-unit-ball)

