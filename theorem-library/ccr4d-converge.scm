;;; Library: analysis.

;;; ccr4d-converge.scm -- LIMITS AND SERIES IN A NORMED FIELD, and the REARRANGEMENT of a series whose terms
;;; are finite sums (CCR-1109-C4 finding F4, in the form CCR 4.24 and 4.27 use it).  Agent CCR-1109-C5,
;;; 2026-11-10.  Destination: theorem-library/ccr4d-converge.scm.  Library: analysis.  Helper prefix cv5-.
;;;
;;;   nf-converges-add        f -> a, g -> b, h(n) = f(n) + g(n)  =>  h -> a + b      (any normed field)
;;;   nf-converges-scale      f -> a, h(n) = c f(n)               =>  h -> c a
;;;   nf-converges-finsum     F(i) -> L(i) for i < d, S(m) = sum_{i<d} F(i)(m)  =>  S -> sum_{i<d} L(i)
;;;   nf-series-finsum-swap   THE REARRANGEMENT: t(k)(i), k in NN, i < d; if for each i the series
;;;                           sum_k t(k)(i) converges to L(i), then the series of the row sums
;;;                           sum_k (sum_{i<d} t(k)(i)) converges to sum_{i<d} L(i).  That is,
;;;                           sum_k sum_{i<d} = sum_{i<d} sum_k.
;;;
;;; The finite index i < d is what 4.24 (the coordinates of a digit in a basis of the residue field) and 4.27
;;; (k = e l + j, j < e) regroup over; neither needs a double series over NN x NN.  No ultrametric is used
;;; here: the laws hold in any normed field.
;;;
;;; Load window: after metric-completeness (CONVERGES-TO), ms-converges-of-dominated-sum, nf-metric-distance /
;;; nf-metric-carrier, nf-norm-sum-diff, sum-ag-fubini-ind, sum-ag-succ, sum-ag-zero, sum-ag-type-ptwise and
;;; structure-library/normed-field (NORMED-FIELD-ADDITIVE-AG).  [after the latest of these, end).

(define cv5-ms '(NF-METRIC-SPACE K))
(define (cv5-add x y) `((ADD K) ,x ,y))
(define (cv5-mul x y) `((MUL K) ,x ,y))
(define (cv5-n x) `((FNRM K) ,x))
(define (cv5-dist x y) `((DIST (NF-METRIC-SPACE K)) ,x ,y))
(define (cv5-nat! landed)
  (cadr (find-first (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'NN))) landed)))
(define (cv5-app! f d c x)
  (if (not (dk-asm? `(IN (,f ,x) ,c))) (dk-cite! 'fun-apply-type-c f d c x)))
(define (cv5-pts! x)
  (if (not (dk-asm? `(IN ,x (PTS ,cv5-ms))))
      (dk-have! `(IN ,x (PTS ,cv5-ms)) (lambda () (subst `(== (PTS ,cv5-ms) (CARR K))) (dk-ass!)))))
(define (cv5-fun-pts! f)
  (if (not (dk-asm? `(IN ,f (FUN NN (PTS ,cv5-ms)))))
      (dk-have! `(IN ,f (FUN NN (PTS ,cv5-ms))) (lambda () (subst `(== (PTS ,cv5-ms) (CARR K))) (dk-ass!)))))

;;; -----------------------------------------------------------------------
;;; nf-converges-add

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K)
  (FORALL f (IMPLIES (IN f (FUN NN (CARR K))) (FORALL g (IMPLIES (IN g (FUN NN (CARR K)))
  (FORALL a (IMPLIES (IN a (CARR K)) (FORALL b (IMPLIES (IN b (CARR K))
  (IMPLIES (CONVERGES-TO ,cv5-ms f a) (IMPLIES (CONVERGES-TO ,cv5-ms g b)
  (FORALL h (IMPLIES (IN h (FUN NN (CARR K)))
  (IMPLIES (FORALL n (IMPLIES (IN n NN) (= (h n) ,(cv5-add '(f n) '(g n)))))
    (CONVERGES-TO ,cv5-ms h ,(cv5-add 'a 'b)))))))))))))))))))
(dk-peel!)
(dk-cite! 'nf-metric-space-is-metric-space 'K)
(dk-cite! 'nf-metric-carrier 'K)
(dk-cite! 'nf-add-in-carr 'K 'a 'b)
(cv5-fun-pts! 'h)
(cv5-pts! (cv5-add 'a 'b))
(let ((hyp (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q '(h n)))) "the pointwise law"))
      (dom `(FORALL n (IMPLIES (IN n NN)
              (<= ,(cv5-dist '(h n) (cv5-add 'a 'b)) (+ ,(cv5-dist '(f n) 'a) ,(cv5-dist '(g n) 'b)))))))
  (dk-have! dom
    (lambda ()
      (let* ((n (cv5-nat! (dk-landed (lambda () (dk-peel!))))))
        (cv5-app! 'f 'NN '(CARR K) n) (cv5-app! 'g 'NN '(CARR K) n) (cv5-app! 'h 'NN '(CARR K) n)
        (subst (dk-cite! 'nf-metric-distance 'K `(h ,n) (cv5-add 'a 'b)))
        (subst (dk-cite! 'nf-metric-distance 'K `(f ,n) 'a))
        (subst (dk-cite! 'nf-metric-distance 'K `(g ,n) 'b))
        (subst (dk-apply! hyp n))
        (dk-cite! 'nf-norm-sum-diff 'K `(f ,n) `(g ,n) 'a 'b)
        (dk-ass!))))
  (dk-cite! 'ms-converges-of-dominated-sum cv5-ms cv5-ms cv5-ms 'h 'f 'g (cv5-add 'a 'b) 'a 'b)
  (dk-close-if-asm!))
(qed 'nf-converges-add)

;;; -----------------------------------------------------------------------
;;; the ring view (crs reaches ADD / MUL / NEG of K through it)

(define cv5-view '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define (cv5-view!)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
  (dk-cite! 'commutative-ring-is-ring cv5-view)
  (for-each (lambda (r) (dk-cite! r 'K))
            '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
              normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one)))
(define (cv5-in-view! x)
  (if (not (dk-asm? `(IN ,x (CARR ,cv5-view))))
      (dk-have! `(IN ,x (CARR ,cv5-view)) (lambda () (subst `(= (CARR ,cv5-view) (CARR K))) (dk-ass!)))))
(define (cv5-crs! vs)
  (cv5-view!)
  (for-each cv5-in-view! vs)
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,cv5-view))))) '(ADD MUL NEG))
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,cv5-view))))) '(ZERO ONE))
  (crs))
(define (cv5-ring-eq! eq vs) (dk-have! eq (lambda () (cv5-crs! vs))) eq)
(define (cv5-typek! x)
  (dk-cite! 'nf-norm-in-rr 'K x)
  (dk-cite! 'nf-norm-nonneg 'K x))
;; the eps clause of CONVERGES-TO(MS, F, L), landed from that hypothesis (which survives)
(define (cv5-eps-clause f l)
  `(FORALL eps (IMPLIES (POS-RR eps)
     (FORSOME N (AND (IN N NN) (FORALL n_ (IMPLIES (IN n_ NN) (IMPLIES (<= N n_)
       (<= ((DIST ,cv5-ms) (,f n_) ,l) eps)))))))))
(define (cv5-clause! f l)
  (let ((h `(CONVERGES-TO ,cv5-ms ,f ,l)))
    (dk-project! (cv5-eps-clause f l)
      (lambda () (mac-h 'CONVERGES-TO (or (dk-ctx-form h) (error "cv5-clause!: no hypothesis" h))) (dk-split-all!)))))
;; close the IN / IS-METRIC-SPACE conjuncts of an unfolded CONVERGES-TO goal
(define (cv5-conv-typing!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'IN) (subst `(== (PTS ,cv5-ms) (CARR K))) (dk-close-if-asm!))
          (#t (error "cv5-conv-typing!: unexpected conjunct" g)))))

;;; -----------------------------------------------------------------------
;;; nf-converges-scale

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K)
  (FORALL c (IMPLIES (IN c (CARR K)) (FORALL f (IMPLIES (IN f (FUN NN (CARR K)))
  (FORALL a (IMPLIES (IN a (CARR K)) (IMPLIES (CONVERGES-TO ,cv5-ms f a)
  (FORALL h (IMPLIES (IN h (FUN NN (CARR K)))
  (IMPLIES (FORALL n (IMPLIES (IN n NN) (= (h n) ,(cv5-mul 'c '(f n)))))
    (CONVERGES-TO ,cv5-ms h ,(cv5-mul 'c 'a))))))))))))))))
(dk-peel!)
(dk-cite! 'nf-metric-space-is-metric-space 'K)
(dk-cite! 'nf-metric-carrier 'K)
(dk-cite! 'nf-mul-in-carr 'K 'c 'a)
(cv5-typek! 'c)
(let ((hyp (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q '(h n)))) "the pointwise law"))
      (cl (cv5-clause! 'f 'a))
      (nc (cv5-n 'c)))
  (mac 'CONVERGES-TO)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORALL)
          (let* ((eps (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) (dk-landed (lambda () (dk-peel!))))))
                 (e2 `(* ,eps (recip (+ ,nc 1)))))
            (dk-split-all! (list (dk-cite! 'aif-scale-small nc eps)))
            (dk-cite! 'rr-pos-rr-in-rr e2)
            (dk-cite! 'rr-pos-rr-in-rr eps)
            (let* ((ee (dk-name! e2 'RR))
                   (p1 (dk-rewrite-h! `(POS-RR ,e2) e2 ee))
                   (p2 (dk-rewrite-h! `(<= (* ,nc ,e2) ,eps) e2 ee))
                   (nn0 (dk-skolem! (dk-apply! cl ee))))
              (ew nn0)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal)) (dk-ass!)
                      (let* ((n (cv5-nat! (dk-landed (lambda () (dk-peel!)))))
                             (fn `(f ,n)) (dd (cv5-add fn `((NEG K) a))))
                        (cv5-app! 'f 'NN '(CARR K) n) (cv5-app! 'h 'NN '(CARR K) n)
                        (dk-cite! 'nf-neg-in-carr 'K 'a)
                        (dk-cite! 'nf-add-in-carr 'K fn '((NEG K) a))
                        (cv5-typek! dd)
                        (let* ((b0 (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q ee) (dk-contains? q 'DIST))) "the f bound"))
                               (b1 (dk-apply! b0 n)))
                          (dk-cite! 'nf-metric-distance 'K fn 'a)
                          (dk-rewrite-h! b1 (cv5-dist fn 'a) (cv5-n dd)))
                        (subst (dk-cite! 'nf-metric-distance 'K `(h ,n) (cv5-mul 'c 'a)))
                        (subst (dk-apply! hyp n))
                        (subst (cv5-ring-eq! `(= ,(cv5-add (cv5-mul 'c fn) `((NEG K) ,(cv5-mul 'c 'a))) ,(cv5-mul 'c dd)) (list 'c fn 'a)))
                        (subst (dk-cite! 'nf-norm-mult 'K 'c dd))
                        (dk-cite! 'rr-mul-le-right (cv5-n dd) ee nc)
                        (let ((x1 `(* ,nc ,(cv5-n dd))) (x2 `(* ,(cv5-n dd) ,nc)) (x3 `(* ,ee ,nc)) (x4 `(* ,nc ,ee)))
                          (dk-have! `(= ,x1 ,x2) (lambda () (crs)))
                          (dk-have! `(= ,x3 ,x4) (lambda () (crs)))
                          (dk-le-chain! x1 x2 x3 x4 eps))))))))
          (cv5-conv-typing!)))))
(qed 'nf-converges-scale)

;;; -----------------------------------------------------------------------
;;; ordinal-segment steps (the tree has the IFF ord-segment-nn-succ; ord-segment-trans is asserted)

(sp (make-wff '(FORALL d (IMPLIES (IN d NN) (FORALL i (IMPLIES (IN i (ORD-SEGMENT d)) (IN i (ORD-SEGMENT (succ d)))))))))
(dk-peel!)
(dk-cite! 'ord-segment-nn-succ 'd 'i)
(prop)
(qed 'ord-segment-succ-sub)

(sp (make-wff '(FORALL d (IMPLIES (IN d NN) (IN d (ORD-SEGMENT (succ d)))))))
(dk-peel!)
(dk-cite! 'ord-segment-nn-succ 'd 'd)
(dk-have! '(= d d) (lambda () (rfl)))
(prop)
(qed 'ord-segment-succ-top)

;;; -----------------------------------------------------------------------
;;; the additive group of K, read off by slot

(define cv5-ag '(NORMED-FIELD-ADDITIVE-AG K))
(define (cv5-ag!)
  (dk-cite! 'normed-field-additive-ag-is-abelian-group 'K)
  (for-each (lambda (sl)
              (let ((eq `(== (,(car sl) ,cv5-ag) ,(cadr sl))))
                (if (not (dk-asm? eq))
                    (dk-have! eq (lambda () (mac 'normed-field-additive-ag) (slot (car sl)) (nth-r)
                                            (if (eq? (car sl) 'CARR) (slot 'CARR)) (qrfl))))))
            '((OPR (ADD K)) (IDEN (ZERO K)) (CARR (CARR K)))))

;;; -----------------------------------------------------------------------
;;; nf-converges-const: a constant sequence converges to its value

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K)
  (FORALL c (IMPLIES (IN c (CARR K)) (FORALL h (IMPLIES (IN h (FUN NN (CARR K)))
  (IMPLIES (FORALL n (IMPLIES (IN n NN) (= (h n) c))) (CONVERGES-TO ,cv5-ms h c))))))))))
(dk-peel!)
(dk-cite! 'nf-metric-space-is-metric-space 'K)
(dk-cite! 'nf-metric-carrier 'K)
(fact 'nn-zero-in)
(let ((hyp (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q '(h n)))) "the pointwise law")))
  (mac 'CONVERGES-TO)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORALL)
          (let ((eps (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) (dk-landed (lambda () (dk-peel!)))))))
            (dk-cite! 'rr-pos-rr-in-rr eps) (dk-cite! 'rr-lt-of-pos-rr eps)
            (ew 0)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (dk-ass!)
                    (let ((n (cv5-nat! (dk-landed (lambda () (dk-peel!))))))
                      (cv5-app! 'h 'NN '(CARR K) n)
                      (subst (dk-cite! 'nf-metric-distance 'K `(h ,n) 'c))
                      (subst (dk-apply! hyp n))
                      (dk-cite! 'nf-neg-in-carr 'K 'c)
                      (subst (cv5-ring-eq! `(= ,(cv5-add 'c '((NEG K) c)) (ZERO K)) '(c)))
                      (subst (dk-cite! 'nf-norm-of-zero 'K))
                      (dk-ineq! `(< 0 ,eps) `(IN ,eps RR)))))))
          (cv5-conv-typing!)))))
(qed 'nf-converges-const)

;;; -----------------------------------------------------------------------
;;; nf-converges-finsum: a finite sum of convergent sequences converges to the sum of the limits

(define (cv5-sumseq d) `(VNB-LAMBDA cvm_ NN (SUM-AG ,cv5-ag (T cvm_) ,d)))
(define (cv5-fs-hyps d)
  (list `(FORALL i (IMPLIES (IN i (ORD-SEGMENT ,d)) (IN (F i) (FUN NN (CARR K)))))
        `(FORALL i (IMPLIES (IN i (ORD-SEGMENT ,d)) (IN (L i) (CARR K))))
        `(FORALL i (IMPLIES (IN i (ORD-SEGMENT ,d)) (CONVERGES-TO ,cv5-ms (F i) (L i))))
        `(FORALL m (IMPLIES (IN m NN) (FORALL i (IMPLIES (IN i (ORD-SEGMENT ,d)) (== ((T m) i) ((F i) m))))))))
(define cv5-tset '(FORALL m (IMPLIES (IN m NN) (IN (T m) SET))))
(define (cv5-tset! m)
  (if (not (dk-asm? `(IN (T ,m) SET)))
      (dk-apply! (or (dk-ctx-form cv5-tset) (error "cv5: no sethood of T")) m)))
(define (cv5-curry fs body) (fold-right (lambda (p acc) `(IMPLIES ,p ,acc)) body fs))
(define (cv5-fs-stmt d)
  (cv5-curry (cv5-fs-hyps d) `(CONVERGES-TO ,cv5-ms ,(cv5-sumseq d) (SUM-AG ,cv5-ag L ,d))))
;; with the hypotheses of size D in context (picked by shape), land (T m) i in CARR K for m in NN, i in seg D
(define (cv5-tmi! d m i)
  (let ((ft (find-first (lambda (q) (alpha-equiv? q (car (cv5-fs-hyps d)))) (dk-asms)))
        (tl (find-first (lambda (q) (alpha-equiv? q (cadddr (cv5-fs-hyps d)))) (dk-asms))))
    (dk-apply! ft i)
    (cv5-app! `(F ,i) 'NN '(CARR K) m)
    (let ((eq (dk-apply! tl m i)))
      (dk-have! `(IN ((T ,m) ,i) (CARR K)) (lambda () (subst eq) (dk-ass!))))))
;; land (IN (SUM-AG AG (T M) D) (CARR K)), M in NN
(define (cv5-sum-type! d m)
  (let ((s `(SUM-AG ,cv5-ag (T ,m) ,d)))
    (if (not (dk-asm? `(IN ,s (CARR K))))
        (begin
          (dk-have! `(FORALL cvi_ (IMPLIES (IN cvi_ (ORD-SEGMENT ,d)) (IN ((T ,m) cvi_) (CARR ,cv5-ag))))
            (lambda ()
              (let ((i (cadr (find-first (lambda (q) (dk-head-is? q 'IN)) (dk-landed (lambda () (dk-peel!)))))))
                (cv5-tmi! d m i)
                (subst `(== (CARR ,cv5-ag) (CARR K)))
                (dk-ass!))))
          (cv5-tset! m)
          (dk-cite! 'sum-ag-type-ptwise d cv5-ag `(T ,m))
          (dk-have! `(IN ,s (CARR K)) (lambda () (subst `(== (CARR K) (CARR ,cv5-ag))) (dk-ass!)))))))
(define (cv5-sumseq-type! d)
  (dk-have! `(IN ,(cv5-sumseq d) (FUN NN (CARR K)))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((m (cv5-nat! (dk-landed (lambda () (dk-peel!))))))
            (cv5-sum-type! d m)
            (dk-close-if-asm!)))))))

(sp (make-wff `(FORALL d (IMPLIES (IN d NN) (FORALL K (IMPLIES (IS-NORMED-FIELD K)
  (FORALL F (FORALL L (FORALL T (IMPLIES ,cv5-tset ,(cv5-fs-stmt 'd)))))))))))
(let* ((r (dk-use-induction-fixed! '(K F L T)))
       (base (cdr (assq 'base r))) (step (cdr (assq 'step r))) (ih (cdr (assq 'ih r))) (d (cdr (assq 'var r))))
  ;; base: the empty sums
  (dk-focus! base)
  (dk-peel!)
  (fact 'nn-zero-in)
  (cv5-ag!)
  (dk-cite! 'nf-zero-in-carr 'K)
  (subst (dk-cite! 'sum-ag-zero cv5-ag 'L))
  (subst `(== (IDEN ,cv5-ag) (ZERO K)))
  (cv5-sumseq-type! 0)
  (dk-cite! 'nf-converges-const 'K '(ZERO K) (cv5-sumseq 0))
  (let ((hl (dk-pick (lambda (q) (and (dk-head-is? q 'IMPLIES) (dk-contains? q 'CONVERGES-TO))) "the const instance")))
    (dk-have! (cadr hl)
      (lambda ()
        (let ((n (cv5-nat! (dk-landed (lambda () (dk-peel!))))))
          (dk-lam-b!)
          (cv5-tset! n)
          (subst (dk-cite! 'sum-ag-zero cv5-ag `(T ,n)))
          (subst `(== (IDEN ,cv5-ag) (ZERO K)))
          (rfl))))
    (detach! hl)
    (dk-close-if-asm!))
  ;; step
  (dk-focus! step)
  (let* ((sd `(succ ,d)))
    (dk-peel!)
    (cv5-ag!)
    (dk-cite! 'nn-succ-closed d)
    (dk-cite! 'ord-segment-succ-top d)
    ;; the hypotheses restricted to seg d
    (for-each
      (lambda (hs hd)
        (let ((big (find-first (lambda (q) (alpha-equiv? q hs)) (dk-asms))))
          (if (not big) (error "cv5: hypothesis of size succ d not in context" hs))
          (dk-have! hd
            (lambda ()
              (let* ((landed (dk-landed (lambda () (dk-peel!))))
                     (ins (filter (lambda (q) (dk-head-is? q 'IN)) landed)))
                (for-each (lambda (q) (if (dk-head-is? (caddr q) 'ORD-SEGMENT) (dk-cite! 'ord-segment-succ-sub d (cadr q)))) ins)
                (apply dk-apply! big (map cadr ins))
                (dk-ass!))))))
      (cv5-fs-hyps sd) (cv5-fs-hyps d))
    (let* ((hs (cv5-fs-hyps sd))
           (h1 (find-first (lambda (q) (alpha-equiv? q (car hs))) (dk-asms)))
           (h2 (find-first (lambda (q) (alpha-equiv? q (cadr hs))) (dk-asms)))
           (h3 (find-first (lambda (q) (alpha-equiv? q (caddr hs))) (dk-asms)))
           (h4 (find-first (lambda (q) (alpha-equiv? q (cadddr hs))) (dk-asms)))
           (h2d (find-first (lambda (q) (alpha-equiv? q (cadr (cv5-fs-hyps d)))) (dk-asms)))
           (sl `(SUM-AG ,cv5-ag L ,d)))
      (dk-chain-ass! ih)
      (dk-apply! h1 d) (dk-apply! h2 d) (dk-apply! h3 d)
      (cv5-sumseq-type! d)
      (cv5-sumseq-type! sd)
      ;; SUM-AG L d in CARR K
      (dk-have! `(FORALL cvi_ (IMPLIES (IN cvi_ (ORD-SEGMENT ,d)) (IN (L cvi_) (CARR ,cv5-ag))))
        (lambda ()
          (let ((i (cadr (find-first (lambda (q) (dk-head-is? q 'IN)) (dk-landed (lambda () (dk-peel!)))))))
            (dk-apply! h2d i)
            (subst `(== (CARR ,cv5-ag) (CARR K)))
            (dk-ass!))))
      (dk-cite! 'sum-ag-type-ptwise d cv5-ag 'L)
      (dk-have! `(IN ,sl (CARR K)) (lambda () (subst `(== (CARR K) (CARR ,cv5-ag))) (dk-ass!)))
      ;; the pointwise law
      (dk-have! `(FORALL n (IMPLIES (IN n NN) (= (,(cv5-sumseq sd) n) ,(cv5-add `(,(cv5-sumseq d) n) `((F ,d) n)))))
        (lambda ()
          (let ((n (cv5-nat! (dk-landed (lambda () (dk-peel!))))))
            (cv5-sum-type! d n)
            (cv5-sum-type! sd n)
            (cv5-app! `(F ,d) 'NN '(CARR K) n)
            (dk-lam-b!)
            (subst (dk-cite! 'sum-ag-succ cv5-ag `(T ,n) d))
            (subst `(== (OPR ,cv5-ag) (ADD K)))
            (subst (dk-apply! h4 n d))
            (rfl))))
      (subst (dk-cite! 'sum-ag-succ cv5-ag 'L d))
      (subst `(== (OPR ,cv5-ag) (ADD K)))
      (dk-cite! 'nf-converges-add 'K (cv5-sumseq d) `(F ,d) sl `(L ,d) (cv5-sumseq sd))
      (dk-close-if-asm!))))
(qed 'nf-converges-finsum)

;;; -----------------------------------------------------------------------
;;; nf-converges-ptwise-eq: a sequence equal pointwise to a convergent one converges to the same limit

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K)
  (FORALL f (IMPLIES (IN f (FUN NN (CARR K))) (FORALL a (IMPLIES (IN a (CARR K)) (IMPLIES (CONVERGES-TO ,cv5-ms f a)
  (FORALL h (IMPLIES (IN h (FUN NN (CARR K)))
  (IMPLIES (FORALL n (IMPLIES (IN n NN) (= (h n) (f n)))) (CONVERGES-TO ,cv5-ms h a)))))))))))))
(dk-peel!)
(dk-cite! 'nf-metric-space-is-metric-space 'K)
(dk-cite! 'nf-metric-carrier 'K)
(cv5-fun-pts! 'h)
(cv5-pts! 'a)
(let ((hyp (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q '(h n)))) "the pointwise law")))
  (dk-have! `(FORALL n (IMPLIES (IN n NN) (<= ,(cv5-dist '(h n) 'a) (+ ,(cv5-dist '(f n) 'a) ,(cv5-dist '(f n) 'a)))))
    (lambda ()
      (let ((n (cv5-nat! (dk-landed (lambda () (dk-peel!))))))
        (cv5-app! 'f 'NN '(CARR K) n) (cv5-app! 'h 'NN '(CARR K) n)
        (subst (dk-apply! hyp n))
        (subst (dk-cite! 'nf-metric-distance 'K `(f ,n) 'a))
        (dk-cite! 'nf-neg-in-carr 'K 'a)
        (dk-cite! 'nf-add-in-carr 'K `(f ,n) '((NEG K) a))
        (cv5-typek! (cv5-add `(f ,n) '((NEG K) a)))
        (let ((x (cv5-n (cv5-add `(f ,n) '((NEG K) a)))))
          (dk-ineq! `(<= 0 ,x) `(IN ,x RR))))))
  (dk-cite! 'ms-converges-of-dominated-sum cv5-ms cv5-ms cv5-ms 'h 'f 'f 'a 'a 'a)
  (dk-close-if-asm!))
(qed 'nf-converges-ptwise-eq)

;;; -----------------------------------------------------------------------
;;; nf-series-finsum-swap: THE REARRANGEMENT.  Every family a variable, as in sum-ag-fubini-ind:
;;;   t   the terms, curried: ((ta kx) i), k in NN, i < d      C   the columns: ((C i) kx) == ((ta kx) i)
;;;   R   the row sums: R(k) == SUM-AG(ta k, d)               F   the column partial sums: (F i)(m) == SUM-AG(C i, m)
;;;   T   the same, transposed: (T m)(i) == SUM-AG(C i, m)   L   the column limits: F(i) -> L(i)
;;; Then the series of the row sums converges to the sum of the column limits.

(define (cv5-sw-hyps)
  (list `(FORALL kx (IMPLIES (IN kx NN) (IN (ta kx) (FUN (ORD-SEGMENT d) (CARR K)))))
        `(FORALL i (IMPLIES (IN i (ORD-SEGMENT d)) (IN (C i) (FUN NN (CARR K)))))
        `(FORALL kx (IMPLIES (IN kx NN) (FORALL i (IMPLIES (IN i (ORD-SEGMENT d)) (== ((C i) kx) ((ta kx) i))))))
        `(FORALL kx (IMPLIES (IN kx NN) (== (R kx) (SUM-AG ,cv5-ag (ta kx) d))))
        `(FORALL i (IMPLIES (IN i (ORD-SEGMENT d)) (IN (F i) (FUN NN (CARR K)))))
        `(FORALL i (IMPLIES (IN i (ORD-SEGMENT d)) (FORALL m (IMPLIES (IN m NN) (== ((F i) m) (SUM-AG ,cv5-ag (C i) m))))))
        `(FORALL m (IMPLIES (IN m NN) (IN (T m) (FUN (ORD-SEGMENT d) (CARR K)))))
        `(FORALL m (IMPLIES (IN m NN) (FORALL i (IMPLIES (IN i (ORD-SEGMENT d)) (== ((T m) i) (SUM-AG ,cv5-ag (C i) m))))))
        `(FORALL i (IMPLIES (IN i (ORD-SEGMENT d)) (IN (L i) (CARR K))))
        `(FORALL i (IMPLIES (IN i (ORD-SEGMENT d)) (CONVERGES-TO ,cv5-ms (F i) (L i))))))
(define cv5-rowseq `(VNB-LAMBDA cvm_ NN (SUM-AG ,cv5-ag R cvm_)))
(define (cv5-h k) (find-first (lambda (q) (alpha-equiv? q (list-ref (cv5-sw-hyps) k))) (dk-asms)))
(define (cv5-seg-nat! i bound) (if (not (dk-asm? `(IN ,i NN))) (dk-cite! 'ord-segment-nn-subset bound i)))
;; a fold SUM-AG(AG, G, M) in CARR K, from G in FUN(ORD-SEGMENT M, CARR K) or FUN(NN, CARR K) (DOM)
(define (cv5-fold-type! g dom m)
  (let ((s `(SUM-AG ,cv5-ag ,g ,m)))
    (if (not (dk-asm? `(IN ,s (CARR K))))
        (begin
          (dk-have! `(FORALL cvf_ (IMPLIES (IN cvf_ (ORD-SEGMENT ,m)) (IN (,g cvf_) (CARR ,cv5-ag))))
            (lambda ()
              (let ((i (cadr (find-first (lambda (q) (dk-head-is? q 'IN)) (dk-landed (lambda () (dk-peel!)))))))
                (if (equal? dom 'NN) (cv5-seg-nat! i m))
                (cv5-app! g dom '(CARR K) i)
                (subst `(== (CARR ,cv5-ag) (CARR K)))
                (dk-ass!))))
          (dk-cite! 'membership-implies-sethood g `(FUN ,dom (CARR K)))
          (dk-cite! 'sum-ag-type-ptwise m cv5-ag g)
          (dk-have! `(IN ,s (CARR K)) (lambda () (subst `(== (CARR K) (CARR ,cv5-ag))) (dk-ass!)))))))

(define (cv5-rowfold-type! m)
  (let ((s `(SUM-AG ,cv5-ag R ,m)))
    (if (not (dk-asm? `(IN ,s (CARR K))))
        (begin
          (dk-have! `(FORALL cvi_ (IMPLIES (IN cvi_ (ORD-SEGMENT ,m)) (IN (R cvi_) (CARR ,cv5-ag))))
            (lambda ()
              (let ((i (cadr (find-first (lambda (q) (dk-head-is? q 'IN)) (dk-landed (lambda () (dk-peel!)))))))
                (cv5-seg-nat! i m)
                (dk-apply! (cv5-h 0) i)
                (cv5-fold-type! `(ta ,i) '(ORD-SEGMENT d) 'd)
                (subst (dk-apply! (cv5-h 3) i))
                (subst `(== (CARR ,cv5-ag) (CARR K)))
                (dk-ass!))))
          (dk-cite! 'sum-ag-type-ptwise m cv5-ag 'R)
          (dk-have! `(IN ,s (CARR K)) (lambda () (subst `(== (CARR K) (CARR ,cv5-ag))) (dk-ass!)))))))

(sp (make-wff `(FORALL d (IMPLIES (IN d NN) (FORALL K (IMPLIES (IS-NORMED-FIELD K)
  (FORALL ta (FORALL C (FORALL R (FORALL F (FORALL T (FORALL L
    ,(cv5-curry (cv5-sw-hyps) `(CONVERGES-TO ,cv5-ms ,cv5-rowseq (SUM-AG ,cv5-ag L d)))))))))))))))
(dk-peel!)
(cv5-ag!)
(dk-cite! 'nf-metric-space-is-metric-space 'K)
(dk-cite! 'nf-metric-carrier 'K)
;; the transposed hypothesis of nf-converges-finsum, and the sethood of T(m)
(dk-have! cv5-tset
  (lambda ()
    (let ((m (cv5-nat! (dk-landed (lambda () (dk-peel!))))))
      (dk-apply! (cv5-h 6) m)
      (dk-cite! 'membership-implies-sethood `(T ,m) '(FUN (ORD-SEGMENT d) (CARR K)))
      (dk-close-if-asm!))))
(dk-have! (cadddr (cv5-fs-hyps 'd))
  (lambda ()
    (let* ((landed (dk-landed (lambda () (dk-peel!))))
           (m (cv5-nat! landed))
           (i (cadr (find-first (lambda (q) (and (dk-head-is? q 'IN) (dk-head-is? (caddr q) 'ORD-SEGMENT))) landed))))
      (subst (dk-apply! (cv5-h 7) m i))
      (subst (dk-apply! (cv5-h 5) i m))
      (qrfl))))
(dk-cite! 'nf-converges-finsum 'd 'K 'F 'L 'T)
(let ((sl `(SUM-AG ,cv5-ag L d)) (qs (cv5-sumseq 'd)))
  ;; SUM-AG(AG, L, d) in CARR K
  (dk-have! `(FORALL cvi_ (IMPLIES (IN cvi_ (ORD-SEGMENT d)) (IN (L cvi_) (CARR ,cv5-ag))))
    (lambda ()
      (let ((i (cadr (find-first (lambda (q) (dk-head-is? q 'IN)) (dk-landed (lambda () (dk-peel!)))))))
        (dk-apply! (cv5-h 8) i)
        (subst `(== (CARR ,cv5-ag) (CARR K)))
        (dk-ass!))))
  (dk-cite! 'sum-ag-type-ptwise 'd cv5-ag 'L)
  (dk-have! `(IN ,sl (CARR K)) (lambda () (subst `(== (CARR K) (CARR ,cv5-ag))) (dk-ass!)))
  ;; both sequences typed
  (dk-have! `(IN ,qs (FUN NN (CARR K)))
    (lambda () (dk-lam-type! (lambda () (let ((m (cv5-nat! (dk-landed (lambda () (dk-peel!))))))
                                         (dk-apply! (cv5-h 6) m) (cv5-fold-type! `(T ,m) '(ORD-SEGMENT d) 'd) (dk-close-if-asm!))))))
  (dk-have! `(IN ,cv5-rowseq (FUN NN (CARR K)))
    (lambda () (dk-lam-type! (lambda () (let ((m (cv5-nat! (dk-landed (lambda () (dk-peel!))))))
                                         (cv5-rowfold-type! m) (dk-close-if-asm!))))))
  ;; the pointwise law: Fubini at each partial index
  (let ((pl `(FORALL n (IMPLIES (IN n NN) (= (,cv5-rowseq n) (,qs n))))))
    (dk-have! pl
      (lambda ()
        (let* ((n (cv5-nat! (dk-landed (lambda () (dk-peel!)))))
               (tn `(T ,n)) (cag `(CARR ,cv5-ag)))
          (cv5-rowfold-type! n)
          (dk-apply! (cv5-h 6) n)
          (cv5-fold-type! tn '(ORD-SEGMENT d) 'd)
          (dk-lam-b!)
          (dk-have! `(FORALL i_ (IMPLIES (IN i_ (ORD-SEGMENT ,n)) (FORALL j_ (IMPLIES (IN j_ (ORD-SEGMENT d)) (IN ((ta i_) j_) ,cag)))))
            (lambda ()
              (let* ((ls (dk-landed (lambda () (dk-peel!))))
                     (ins (filter (lambda (q) (dk-head-is? q 'IN)) ls))
                     (i (cadr (car ins))) (j (cadr (cadr ins))))
                (cv5-seg-nat! i n)
                (dk-apply! (cv5-h 0) i)
                (cv5-app! `(ta ,i) '(ORD-SEGMENT d) '(CARR K) j)
                (subst `(== ,cag (CARR K))) (dk-ass!))))
          (dk-have! `(FORALL i_ (IMPLIES (IN i_ (ORD-SEGMENT ,n)) (FORALL j_ (IMPLIES (IN j_ (ORD-SEGMENT d)) (== ((C j_) i_) ((ta i_) j_))))))
            (lambda ()
              (let* ((ls (dk-landed (lambda () (dk-peel!))))
                     (ins (filter (lambda (q) (dk-head-is? q 'IN)) ls))
                     (i (cadr (car ins))) (j (cadr (cadr ins))))
                (cv5-seg-nat! i n)
                (dk-apply! (cv5-h 2) i j)
                (dk-ass!))))
          (dk-have! `(FORALL i_ (IMPLIES (IN i_ (ORD-SEGMENT ,n)) (== (R i_) (SUM-AG ,cv5-ag (ta i_) d))))
            (lambda ()
              (let ((i (cadr (find-first (lambda (q) (dk-head-is? q 'IN)) (dk-landed (lambda () (dk-peel!)))))))
                (cv5-seg-nat! i n) (dk-apply! (cv5-h 3) i) (dk-ass!))))
          (dk-have! `(IN ,tn (FUN (ORD-SEGMENT d) ,cag)) (lambda () (subst `(== ,cag (CARR K))) (dk-ass!)))
          (dk-have! `(FORALL j_ (IMPLIES (IN j_ (ORD-SEGMENT d)) (== (,tn j_) (SUM-AG ,cv5-ag (C j_) ,n))))
            (lambda ()
              (let ((j (cadr (find-first (lambda (q) (dk-head-is? q 'IN)) (dk-landed (lambda () (dk-peel!)))))))
                (dk-apply! (cv5-h 7) n j) (dk-ass!))))
          (dk-have! `(FORALL fbi_ (IMPLIES (IN fbi_ (ORD-SEGMENT ,n)) (IN (R fbi_) ,cag)))
            (lambda () (let ((i (cadr (find-first (lambda (q) (dk-head-is? q 'IN)) (dk-landed (lambda () (dk-peel!)))))))
                         (dk-apply! (dk-ctx-form `(FORALL cvi_ (IMPLIES (IN cvi_ (ORD-SEGMENT ,n)) (IN (R cvi_) ,cag)))) i) (dk-ass!))))
          (dk-have! `(FORALL fbj_ (IMPLIES (IN fbj_ (ORD-SEGMENT d)) (IN (,tn fbj_) ,cag)))
            (lambda () (let ((j (cadr (find-first (lambda (q) (dk-head-is? q 'IN)) (dk-landed (lambda () (dk-peel!)))))))
                         (cv5-app! tn '(ORD-SEGMENT d) '(CARR K) j)
                         (subst `(== ,cag (CARR K))) (dk-ass!))))
          (dk-cite! 'sum-ag-fubini-ind n cv5-ag 'd 'ta 'C 'R tn)
          (dk-close-if-asm!))))
    (dk-cite! 'nf-converges-ptwise-eq 'K qs sl cv5-rowseq)
    (dk-close-if-asm!)))
(qed 'nf-series-finsum-swap)
