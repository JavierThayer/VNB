;;; theorem-library/algnum-countable.scm -- THE ALGEBRAIC NUMBERS OVER A COUNTABLE SUBRING OF C ARE COUNTABLE
;;; (ALGNUM, algebraic-numbers bundle B7, 2026-10-26).  Source: Thayer, algebraic-numbers notes, Cor. 4.23 (the
;;; countability half).  Vocabulary: structure-library/algnum-vocab.scm; POLY-2 (poly-fn-vocab.scm, cf-cons-*,
;;; cc-ps-root-bound); IS-COUNTABLE and its laws (regulated-primitive); qq-countable.  Helper prefix: ma- (kit), an-.
;;;
;;; THE HEADLINES.
;;;   algebraic-numbers-countable        K a subring of C (the notes: a subfield) and countable: the algebraic
;;;                                      numbers over K form a countable set.
;;;   algebraic-numbers-over-qq-countable the algebraic numbers (over Q) form a countable set.
;;;
;;; THE ROUTE.  (1) A set of complex numbers with no injective (n + 1)-tuple is countable (induction on n:
;;; remove one point; an injective tuple of the rest, prefixed by the point -- CF-CONS -- would be one of the
;;; set).  (2) By the root bound cc-ps-root-bound, the roots of a polynomial with non-zero leading coefficient
;;; c(n) have no injective (n + 1)-tuple, so they form a countable set.  (3) The coefficient sequences in K of
;;; length <= m form a countable set (induction on m: c = CF-CONS(c(0), tail), a countable union over the
;;; enumeration of K of images of the shorter ones).  (4) The algebraic numbers of degree n are a countable
;;; union over the polynomials of length n + 1 of their roots; all of them, a countable union over n.  The notes'
;;; proof through the minimal polynomial is replaced by (4), which needs no irreducibility.
;;;
;;; LOAD WINDOW.  lo: theorem-library/poly-fn-roots (POLY-2, cc-ps-root-bound, cf-cons-*), theorem-library/qq-countable,
;;; theorem-library/regulated-primitive-laws (countable-*; load.scm 3550), structure-library/algnum-vocab.
;;; hi: none.  Library: analysis (the heads are POLY-2's and IS-COUNTABLE's).

;;; (0) the ma- kit
;;; (0) the ma- kit (file-local; most from push-forward.scm's pfw- kit and product-measure.scm's pms- kit)

(define (ma-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; dk-project!, except that a claim equal to the focus goal is proved in place
(define (ma-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
;;; sequential map (MIT evaluates arguments right to left)
(define (ma-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (ma-for-each f l) (let loop ((l l)) (if (pair? l) (begin (f (car l)) (loop (cdr l))))))
;;; the right-hand conjuncts of an IFF in context whose left side is in context, landed (by prop, on a lane)
(define (ma-iff-parts! iff0)
  (let* ((iff (or (dk-ctx-form iff0) (error "ma-iff-parts!: not in context" (expression->string iff0))))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    ;; the conjunct that is the focus goal (closed in place) goes LAST: closing it moves the focus
    (let* ((goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
           (late  (filter goal? cs))
           (early (filter (lambda (c) (not (goal? c))) cs)))
      (ma-map (lambda (c) (ma-by-prop! c (list iff (cadr iff)))) (append early late))
      cs)))
;;; the LEFT side of an IFF in context whose right side is in context, landed
(define (ma-iff-back! iff0)
  (let ((iff (or (dk-ctx-form iff0) (error "ma-iff-back!: not in context" (expression->string iff0)))))
    (ma-by-prop! (cadr iff)
      (cons iff (let ((r (caddr iff)))
                  (if (dk-asm? r)
                      (list r)
                      (let loop ((r r) (acc '()))
                        (if (and (pair? r) (eq? (car r) 'AND) (not (dk-asm? r)))
                            (loop (caddr r) (cons (cadr r) acc))
                            (reverse (cons r acc))))))))))
;;; CLAIM by prop from the formulas FS: on a lane, or in place when CLAIM is the focus goal; returns CLAIM
(define (ma-by-prop! claim fs)
  (cond ((dk-asm? claim) (dk-ctx-form claim))
        ((eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
         (ma-prop-with! fs) claim)
        (#t (dk-have! claim (lambda () (ma-prop-with! fs))) (dk-ctx-form claim))))
;;; (IN w (SEP v A P)) in context: land (IN w A) and P[w], the membership kept; return P[w].
(define (ma-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s (caddr m)) (v (cadr s)) (dom (caddr s))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "ma-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (let ((c (dk-ctx-form conj))) (if c (ai c)))))
    p))
;;; class extensionality, each direction driven: FWD / BWD procedures of the element; lands lhs = rhs
(define (ma-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'mew_ (list 'IFF (list 'IN 'mew_ lhs) (list 'IN 'mew_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs)
  (list '= lhs rhs))
;;; w in BIG-UNION(v, D, g(v)) gives the index and w in g(index): returns (k . formula)
(define (ma-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (caddr bu)))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
;;; prove the focus goal (IN w bu) at the index k (k in D and w in the k-th term in context)
(define (ma-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
;;; prop on the named formulas only
(define (ma-prop-with! fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))
;;; (IN z (UNION a b)) from (IN z a) / (IN z b) in context
(define (ma-in-union-left! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-l) (dk-ass!))))
(define (ma-in-union-right! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-r) (dk-ass!))))
;;; (IN x (PAIR x x)), x in SET in context
(define (ma-in-singleton! xv)
  (dk-have! (list 'IN xv (list 'PAIR xv xv))
    (lambda ()
      (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
      (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) xv)))
        (dk-have! (list '= xv xv) (lambda () (rfl)))
        (ma-prop-with! (list pm (list '= xv xv)))))))
;;; with (IN b (PAIR x x)) and x in SET in context, land b = x
(define (ma-singleton-eq! b xv)
  (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
  (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) b)))
    (dk-have! (list '= b xv)
      (lambda () (ma-prop-with! (list pm (list 'IN b (list 'PAIR xv xv))))))
    (list '= b xv)))

;;; FINITE-SET INDUCTION (pms-induct!, product-measure.scm).  PROP-OF builds P(s); BASE! proves P(EMPTY-SET)
;;; on its leaf; (STEP! sv xv u ih) proves P(u), u = sv u {xv}, with ih = P(sv) in context.  Returns P(xs).
(define (ma-class prop-of) (list 'COMP 'miu_ (prop-of 'miu_)))
(define (ma-step-formula c)
  (list 'FORALL 'is_
    (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ c)))
      (list 'FORALL 'ix_
        (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
          (list 'IN '(UNION is_ (PAIR ix_ ix_)) c))))))
(define (ma-induct! xs prop-of base! step!)
  (let* ((c     (ma-class prop-of))
         (stepf (ma-step-formula c)))
    (have! (list 'IN 'EMPTY-SET c)
      (lambda ()
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) '(in empty-set set))
                (begin (fact 'empty-set-is-set) (ass))
                (base!)))
          (dk-opened (lambda () (comp-mi))))))
    (have! stepf
      (lambda ()
        (let* ((landed (dk-peel!))
               (g      (dk-goal))
               (u      (cadr g))
               (sv     (cadr u))
               (xv     (cadr (caddr u))))
          (dk-split-all! landed)
          (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
          (fact 'pairing xv xv)
          (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET)))
          (fact 'union-set-closure sv (list 'PAIR xv xv))
          (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv c)))))
                 (ih (car (filter (lambda (f) (not (equal? f (list 'in sv 'set)))) ls))))
            (for-each
              (lambda (leaf)
                (dk-focus! leaf)
                (if (equal? (dk-goal) (list 'in u 'set))
                    (ass)
                    (step! sv xv u ih)))
              (dk-opened (lambda () (comp-mi))))))))
    (dk-have! (list 'AND (list 'IN 'EMPTY-SET c) stepf))
    (let ((ind (dk-fact! 'finite-set-induction c)))
      (dk-have! (list 'AND (list 'IN xs 'SET) (list 'IN (list 'CARD xs) 'NN)))
      (let* ((inx (dk-apply! ind xs))
             (ls  (dk-landed (lambda () (comp-me inx)))))
        (car (filter (lambda (f) (not (equal? f (list 'in xs 'set)))) ls))))))
;;; the membership laws whose instances make the two memberships propositionally equivalent
(define (ma-ext-prop! lhs rhs cites)
  (let ((side (lambda (have)
                (lambda (w)
                  (let ((fs (ma-map (lambda (c) (apply dk-cite! (car c) (cdr c))) (cites w))))
                    (ma-prop-with! (cons (list 'IN w have) fs)))))))
    (ma-ext2! lhs rhs (side lhs) (side rhs))))

;;; (SUBSET (SEP v d p) d)
(define (ma-sep-subset! sep)
  (dk-have! (list 'SUBSET sep (caddr sep))
    (lambda ()
      (mac 'subset-def)
      (let ((z (dk-di-var!)))
        (ma-sep-parts! (list 'IN z sep))
        (ass)))))
;;; s subset of the finite set ca (ca in SET, CARD ca in NN in context): land (IN s SET), (IN (CARD s) NN)
(define (ma-finite-sub! s ca)
  (fact 'subclass-of-set-is-set s ca)
  (dk-have! (list 'AND (list 'IN ca 'SET) (list 'IN (list 'CARD ca) 'NN)))
  (let ((cs (dk-fact! 'card-subset-nn ca)))
    (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s ca z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))))
    (dk-apply! cs s)))

;;; case split on a right-nested disjunction ORF in context, one THUNK per disjunct (each run with that
;;; disjunct in context, on its own leaf)
(define (ma-or-split! orf thunks)
  (let* ((o (or (dk-ctx-form orf) (error "ma-or-split!: not in context" (expression->string orf))))
         (l (cadr o)) (r (caddr o)))
    (for-each
      (lambda (leaf)
        (dk-focus! leaf)
        (cond ((dk-asm? l) ((car thunks)))
              ((pair? (cddr thunks)) (ma-or-split! r (cdr thunks)))
              (#t ((cadr thunks)))))
      (dk-opened (lambda () (ai o))))))
;;; f in FUN(NN, A) and every f(k) in B: f in FUN(NN, B)   (pfw-retype!, push-forward.scm)
(define (ma-retype! fv a b in-b!)
  (dk-have! (list 'IN fv (list 'FUN 'NN b))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c fv 'NN a kv)
                (ma-then-ass! (lambda () (in-b! (list fv kv)))))
              (begin
                (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN fv (list 'FUN 'NN a))))))
                (ass))))))))
;;; a function symbol G in FUN(DOM, COD) with G(k) == BODY(k): returns (G . VALUE-EQUATION)   (pfw-abstract!)
(define (ma-abstract! dom cod body-of typer pre)
  (let* ((body  (body-of 'mak_))
         (lam   (list 'VNB-LAMBDA 'mak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'mak_ (list 'IMPLIES (list 'IN 'mak_ dom)
                                                    (list '== (list g 'mak_) body)))))
         (claim (list 'FORSOME 'mag_ (list 'AND (list 'IN 'mag_ (list 'FUN dom cod))
                                            (vals 'mag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!))))
                (let ((kv (dk-di-var!)))
                  (pre kv)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "ma-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "ma-abstract!: the value equation did not land"))))
      (cons g ve))))

;;; (1) a set of complex numbers with no injective (n + 1)-tuple is countable
(define (an-inj s n) (list 'FORALL 'pri_ (list 'IMPLIES '(IN pri_ NN) (list 'IMPLIES (list '<= 'pri_ n)
  (list 'FORALL 'prj_ (list 'IMPLIES '(IN prj_ NN) (list 'IMPLIES (list '<= 'prj_ n)
    (list 'IMPLIES (list '= (list s 'pri_) (list s 'prj_)) '(= pri_ prj_)))))))))
(define (an-noinj ss n) (list 'FORALL 'ansq_ (list 'IMPLIES (list 'IN 'ansq_ (list 'FUN 'NN ss)) (list 'NOT (an-inj 'ansq_ n)))))
;;; ss empty when it has no member: from a proof that any member gives FALSITY (CONTRA! z, z in ss in context)
(define (an-empty! ss contra!)
  (fact 'cc-is-set)
  (fact 'subclass-of-set-is-set ss 'CC)
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ ss) '(IN z_ EMPTY-SET)))
    (lambda () (let ((z (dk-di-var!))) (contra! z))))
  (dk-apply! (dk-cite! 'subset-of-empty-is-empty ss)))

;;; W1E (2026-11-05): the guard is ss in POWER(CC), in place of SUBSET ss CC (the
;;; induction hypothesis is used at a SEP subset of ss, and SUBSET does not confine).
;;; The two helpers pass between the forms by the library axiom power-set-membership.
;; (IN s (POWER c)) in context: land (SUBSET s c)
(define (an-power-subset! s c)
  (dk-have! (list 'SUBSET s c)
    (lambda ()
      (mac 'subset-def)
      (let ((z (dk-di-var!)))
        (let* ((h (dk-landed-1 (lambda () (mac-h 'power-set-membership (list 'IN s (list 'POWER c))))))
               (u (find-first (dk-head? 'FORALL) (dk-split! h))))
          (inst+ u z))
        (ass)))))
;; (SUBSET s c) and (IN c SET) in context: land (IN s (POWER c))
(define (an-in-power! s c)
  (dk-have! (list 'IN s (list 'POWER c))
    (lambda ()
      (mac 'power-set-membership)
      (for-each (lambda (l)
                  (dk-focus! l)
                  (if (dk-head-is? (dk-goal) 'IN)
                      (begin (fact 'subclass-of-set-is-set s c) (ass))
                      (let ((z (dk-di-var!)))
                        (fact 'subset-mem-fwd s c z) (ass))))
                (dk-opened di)))))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'ss (list 'IMPLIES '(IN ss (POWER CC))
  (list 'IMPLIES (an-noinj 'ss 'n) '(IS-COUNTABLE ss))))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  ;; base: no injective 1-tuple, so no member
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (an-power-subset! 'ss 'CC)
  (fact 'countable-empty)
  (an-empty! 'ss
    (lambda (z)
      (let ((cs (list 'VNB-LAMBDA 'ank_ 'NN z)))
        (dk-have! (list 'IN cs '(FUN NN ss)) (lambda () (dk-lam-type! (lambda () (dk-di-var!) (ass)) (lambda () (fact 'nn-is-set) (ass)))))
        (let ((ninj (dk-apply! (dk-ctx-form (an-noinj 'ss 0)) cs)))
          (dk-have! (an-inj cs 0)
            (lambda ()
              (let* ((ls (dk-peel!))
                     (ij (ma-map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ls))))
                (apply dk-nn! (filter (lambda (f) (dk-head-is? f '<=)) ls)))))
          (ma-prop-with! (list ninj (an-inj cs 0)))))))
  (subst '(= ss EMPTY-SET))
  (ass)
  ;; step
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (an-power-subset! 'ss 'CC)
  (let ((sv (list 'succ v)))
    (use-em '(FORSOME mae_ (IN mae_ ss))
      (lambda ()
        (let* ((a (dk-skolem! (dk-ctx-form '(FORSOME mae_ (IN mae_ ss)))))
               (s1 (list 'SEP 'mas_ 'ss (list 'NOT (list '= 'mas_ a)))))
          (fact 'subset-mem-fwd 'ss 'CC a)
          (ma-sep-subset! s1)
          (fact 'subset-trans s1 'ss 'CC)
          ;; s1 has no injective (v + 1)-tuple
          (dk-have! (an-noinj s1 v)
            (lambda ()
              (let ((sq (dk-di-var!)))
                (di)
                (let ((t (list 'CF-CONS a sq)) (inj (an-inj sq v)))
                  (fact 'fun-codomain-superset sq 'NN s1 'CC)
                  (fact 'cc-subring-cc)
                  (dk-apply! (dk-cite! 'cf-cons-in-fun 'CC) a sq)
                  (let ((val! (lambda (k)
                                ;; land the value of t at k: either k = 0 and t(k) = a, or k = succ q and t(k) = sq(q);
                                ;; returns (q-or-#f . equation)
                                (fact 'nn-zero-in)
                                #t)))
                    (ma-retype! t 'CC 'ss
                      (lambda (tk)
                        (let ((k (cadr tk)))
                          (ma-or-split! (dk-cite! 'nn-zero-or-succ k)
                            (list
                              (lambda ()
                                (subst (list '= k 0))
                                (subst (dk-apply! (dk-cite! 'cf-cons-zero a) sq))
                                (ass))
                              (lambda ()
                                (let ((q (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f k))) (dk-asms)))))
                                  (subst (list '= k (list 'succ q)))
                                  (subst (dk-apply! (dk-cite! 'cf-cons-succ a) sq q))
                                  (fact 'fun-apply-type-c sq 'NN s1 q)
                                  (fact 'subset-mem-fwd s1 'ss (list sq q))
                                  (ass))))))))
                    (let ((ninj (dk-apply! (dk-ctx-form (an-noinj 'ss sv)) t)))
                      (dk-have! (an-inj t sv)
                        (lambda ()
                          (let* ((ls (dk-peel!))
                                 (eqf (find-first (lambda (f) (dk-head-is? f '=)) ls))
                                 (i (cadr (cadr eqf))) (j (cadr (caddr eqf)))
                                 (le-i (list '<= i sv)) (le-j (list '<= j sv))
                                 (zs! (lambda (k) (ma-or-split! (dk-cite! 'nn-zero-or-succ k) '()))))
                            (ma-or-split! (dk-cite! 'nn-zero-or-succ i)
                              (list
                                (lambda ()
                                  (ma-or-split! (dk-cite! 'nn-zero-or-succ j)
                                    (list
                                      (lambda () (dk-nn! (list '= i 0) (list '= j 0)))
                                      (lambda ()
                                        (let ((q (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f j))) (dk-asms)))))
                                          (dk-apply! (dk-cite! 'cf-cons-zero a) sq)
                                          (dk-apply! (dk-cite! 'cf-cons-succ a) sq q)
                                          (let* ((e1 (dk-rewrite-h! eqf i 0))
                                                 (e2 (dk-rewrite-h! e1 j (list 'succ q)))
                                                 (e3 (dk-rewrite-h! e2 (list t 0) a))
                                                 (e4 (dk-rewrite-h! e3 (list t (list 'succ q)) (list sq q))))
                                            (fact 'fun-apply-type-c sq 'NN s1 q)
                                            (let ((pn (ma-sep-parts! (list 'IN (list sq q) s1))))
                                              (dk-have! (list '= (list sq q) a) (lambda () (subst e4) (fact 'subset-mem-fwd 'ss 'CC a) (rfl)))
                                              (ma-prop-with! (list (list '= (list sq q) a) pn)))))))))
                                (lambda ()
                                  (let ((p (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f i))) (dk-asms)))))
                                    (ma-or-split! (dk-cite! 'nn-zero-or-succ j)
                                      (list
                                        (lambda ()
                                          (let* ((e1 (dk-rewrite-h! eqf j 0))
                                                 (e2 (dk-rewrite-h! e1 i (list 'succ p))))
                                            (dk-apply! (dk-cite! 'cf-cons-zero a) sq)
                                            (dk-apply! (dk-cite! 'cf-cons-succ a) sq p)
                                            (let* ((e3 (dk-rewrite-h! e2 (list t 0) a))
                                                   (e4 (dk-rewrite-h! e3 (list t (list 'succ p)) (list sq p))))
                                              (fact 'fun-apply-type-c sq 'NN s1 p)
                                              (let ((pn (ma-sep-parts! (list 'IN (list sq p) s1))))
                                                (ma-prop-with! (list e4 pn))))))
                                        (lambda ()
                                          (let ((q (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f j))) (dk-asms)))))
                                            (let* ((e1 (dk-rewrite-h! eqf i (list 'succ p)))
                                                   (e2 (dk-rewrite-h! e1 j (list 'succ q))))
                                              (dk-apply! (dk-cite! 'cf-cons-succ a) sq p)
                                              (dk-apply! (dk-cite! 'cf-cons-succ a) sq q)
                                              (let* ((e3 (dk-rewrite-h! e2 (list t (list 'succ p)) (list sq p)))
                                                     (e4 (dk-rewrite-h! e3 (list t (list 'succ q)) (list sq q))))
                                                (dk-have! (list '<= p v) (lambda () (dk-nn! (list '= i (list 'succ p)) le-i)))
                                                (dk-have! (list '<= q v) (lambda () (dk-nn! (list '= j (list 'succ q)) le-j)))
                                                (let ((pq (dk-apply! (dk-ctx-form inj) p q)))
                                                  (dk-nn! pq (list '= i (list 'succ p)) (list '= j (list 'succ q)))))))))))))))))
                      (ma-prop-with! (list ninj (an-inj t sv)))))))))
          (fact 'cc-is-set)
          (an-in-power! s1 'CC)
          (dk-apply! (dk-ctx-form ih) s1)
          (fact 'membership-implies-sethood a 'ss)
          (fact 'countable-singleton a)
          (dk-apply! (dk-cite! 'countable-union-2 s1 (list 'PAIR a a)))
          (dk-have! (list 'SUBSET 'ss (list 'UNION s1 (list 'PAIR a a)))
            (lambda ()
              (mac 'subset-def)
              (let ((z (dk-di-var!)))
                (use-em (list '= z a)
                  (lambda () (subst (list '= z a)) (ma-in-singleton! a) (ma-in-union-right! a s1 (list 'PAIR a a)))
                  (lambda ()
                    (dk-have! (list 'IN z s1) (lambda () (in-sep! dk-ass! dk-ass!)))
                    (ma-in-union-left! z s1 (list 'PAIR a a)))))))
          (dk-apply! (dk-cite! 'countable-subset 'ss (list 'UNION s1 (list 'PAIR a a))))
          (ass)))
      (lambda ()
        (fact 'countable-empty)
        (an-empty! 'ss
          (lambda (z)
            (dk-have! '(FORSOME mae_ (IN mae_ ss)) (lambda () (ew z) (ass)))
            (ma-prop-with! (list '(FORSOME mae_ (IN mae_ ss)) '(NOT (FORSOME mae_ (IN mae_ ss)))))))
        (subst '(= ss EMPTY-SET))
        (ass)))))
(qed 'complex-set-no-injective-tuple-countable)

;;; (2) the roots of a polynomial with non-zero leading coefficient form a countable set
(define (an-ps c z n) (list 'CC-SERIES-PARTIAL-SUM (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list c 'pfj_) (list 'power z 'pfj_))) n))
(define (an-vanish c n) (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) (list 'IMPLIES (list '<= n 'pfk_) (list '= (list c 'pfk_) 0)))))
(define (an-roots c n) (list 'SEP 'anz_ 'CC (list 'AND (list 'NOT (list '= (list c n) 0)) (list '= (an-ps c 'anz_ (list 'succ n)) 0))))

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'c (list 'IMPLIES '(IN c (FUN NN CC))
  (list 'IMPLIES (an-vanish 'c '(succ n)) (list 'IS-COUNTABLE (an-roots 'c 'n)))))))))
(dk-peel!)
(let ((r (an-roots 'c 'n)))
  (ma-sep-subset! r)
  (dk-have! (an-noinj r 'n)
    (lambda ()
      (let ((sq (dk-di-var!)))
        (di)
        (fact 'fun-codomain-superset sq 'NN r 'CC)
        (fact 'nn-zero-in)
        (fact 'fun-apply-type-c sq 'NN r 0)
        (dk-split-all! (list (ma-sep-parts! (list 'IN (list sq 0) r))))
        (dk-have! (list 'FORALL 'pri_ (list 'IMPLIES '(IN pri_ NN) (list 'IMPLIES '(<= pri_ n) (list '= (an-ps 'c (list sq 'pri_) '(succ n)) 0))))
          (lambda ()
            (let ((i (car (ma-map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!))))))
              (fact 'fun-apply-type-c sq 'NN r i)
              (dk-split-all! (list (ma-sep-parts! (list 'IN (list sq i) r))))
              (ass))))
        (let ((allz (dk-apply! (dk-cite! 'cc-ps-root-bound 'n 'c) sq)))
          (dk-apply! allz 'n)
          (ma-prop-with! (list '(= (c n) 0) '(NOT (= (c n) 0))))))))
  (fact 'cc-is-set)
  (an-in-power! r 'CC)
  (dk-apply! (dk-cite! 'complex-set-no-injective-tuple-countable 'n) r)
  (ass))
(qed 'poly-roots-countable)

;;; (3) the polynomials with coefficients in a countable subring K of C and length <= m form a countable set
(define (an-polys kk m) (list 'SEP 'anp_ (list 'FUN 'NN kk) (an-vanish 'anp_ m)))
(define (an-subring-parts! kk)
  (dk-project! (list 'SUBSET kk 'CC) 'is-cc-subring (list 'IS-CC-SUBRING kk))
  (dk-project! (list 'IN 0 kk) 'is-cc-subring (list 'IS-CC-SUBRING kk)))
;;; the zero sequence, in FUN(NN, kk) (0 in kk in context); returns it
(define (an-zero-seq! kk)
  (let ((z0 '(VNB-LAMBDA ank_ NN 0)))
    (dk-have! (list 'IN z0 (list 'FUN 'NN kk))
      (lambda () (dk-lam-type! (lambda () (dk-di-var!) (ass)) (lambda () (fact 'nn-is-set) (ass)))))
    z0))
;;; (IN s SET) for s a SEP over FUN(NN, kk), kk in SET
(define (an-polys-set! kk m)
  (let ((p (an-polys kk m)))
    (fact 'nn-is-set)
    (dk-have! (list 'AND '(IN NN SET) (list 'IN kk 'SET)))
    (ma-iff-back! (dk-cite! 'fun-set-iff 'NN kk))
    (ma-sep-subset! p)
    (fact 'subclass-of-set-is-set p (list 'FUN 'NN kk))))

(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'kk (list 'IMPLIES '(IS-CC-SUBRING kk)
  (list 'IMPLIES '(IS-COUNTABLE kk) (list 'IS-COUNTABLE (an-polys 'kk 'm)))))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  ;; base: only the zero sequence
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (an-subring-parts! 'kk)
  (let* ((z0 (an-zero-seq! 'kk)) (p0 (an-polys 'kk 0)) (pr (list 'PAIR z0 z0)))
    (fact 'membership-implies-sethood z0 (list 'FUN 'NN 'kk))
    (fact 'countable-singleton z0)
    (dk-have! (list 'SUBSET p0 pr)
      (lambda ()
        (mac 'subset-def)
        (let* ((c (dk-di-var!)) (vz (ma-sep-parts! (list 'IN c p0))))
          (dk-fun-ext! c z0 'NN 'kk #f #f
            (lambda (w)
              (fact 'nn-zero-le w)
              (dk-apply! vz w)
              (dk-lam-b!)
              (ass)))
          (subst (list '= c z0))
          (ma-in-singleton! z0))))
    (dk-apply! (dk-cite! 'countable-subset p0 pr))
    (ass))
  ;; step
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (an-subring-parts! 'kk)
  (dk-apply! (dk-ctx-form ih) 'kk)
  (let* ((pv (an-polys 'kk v)) (sv (list 'succ v)) (ps (an-polys 'kk sv))
         (cs (dk-apply! (dk-cite! 'countable-cases 'kk))))
    (dk-split! cs)
    (ma-or-split! (caddr cs)
      (list
        (lambda ()
          (let ((h (dk-rewrite-h! '(IN 0 kk) 'kk 'EMPTY-SET)))
            (dk-cite! 'empty-set-has-no-members 0)
            (ma-prop-with! (list h (list 'NOT h)))))
        (lambda ()
          (let* ((ex (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'kk))) (dk-asms)))
                 (e (dk-skolem! ex))
                 (surj (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f e))) (dk-asms)))
                 (hj (lambda (j) (list 'VNB-LAMBDA 'anq_ pv (list 'CF-CONS (list e j) 'anq_))))
                 (pud (list 'VNB-LAMBDA 'anj_ 'NN (list 'IMAGE (hj 'anj_) pv))))
            (fact 'cc-is-set)
            (an-polys-set! 'kk sv)
            (an-polys-set! 'kk v)
            ;; each piece is countable
            (dk-have! (list 'FORALL 'puk_ (list 'IMPLIES '(IN puk_ NN) (list 'IS-COUNTABLE (list pud 'puk_))))
              (lambda ()
                (let ((j (dk-di-var!)))
                  (dk-lam-b!)
                  (fact 'fun-apply-type-c e 'NN 'kk j)
                  (dk-have! (list 'IN (hj j) (list 'FUN pv (list 'FUN 'NN 'kk)))
                    (lambda ()
                      (dk-lam-type!
                        (lambda ()
                          (let ((p (dk-di-var!)))
                            (ma-sep-parts! (list 'IN p pv))
                            (dk-apply! (dk-cite! 'cf-cons-in-fun 'kk) (list e j) p)
                            (ass)))
                        (lambda () (ass)))))
                  (dk-have! (list 'SUBSET pv pv) (lambda () (mac 'subset-def) (dk-di-var!) (ass)))
                  (dk-apply! (dk-cite! 'countable-image pv (hj j) pv (list 'FUN 'NN 'kk)))
                  (ass))))
            ;; every polynomial of length <= v + 1 is c(0) followed by one of length <= v
            (dk-have! (list 'FORALL 'puy_ (list 'IMPLIES (list 'IN 'puy_ ps) (list 'FORSOME 'puk_ (list 'AND '(IN puk_ NN) (list 'IN 'puy_ (list pud 'puk_))))))
              (lambda ()
                (let* ((c (dk-di-var!)) (vc (ma-sep-parts! (list 'IN c ps)))
                       (tl (list 'VNB-LAMBDA 'ank_ 'NN (list c '(succ ank_)))))
                  (fact 'nn-zero-in)
                  (fact 'fun-apply-type-c c 'NN 'kk 0)
                  (let ((j (dk-skolem! (dk-apply! surj (list c 0)))))
                    (fact 'fun-apply-type-c e 'NN 'kk j)
                    (dk-have! (list 'IN tl (list 'FUN 'NN 'kk))
                      (lambda ()
                        (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (fact 'nn-succ-closed k) (fact 'fun-apply-type-c c 'NN 'kk (list 'succ k)) (ass)))
                                      (lambda () (ass)))))
                    (dk-have! (list 'IN tl pv)
                      (lambda ()
                        (in-sep! dk-ass!
                          (lambda ()
                            (let* ((ls (dk-peel!))
                                   (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ls))))
                              (dk-lam-b!)
                              (fact 'nn-succ-closed k)
                              (dk-have! (list '<= sv (list 'succ k)) (lambda () (dk-nn! (list '<= v k))))
                              (dk-apply! vc (list 'succ k))
                              (ass))))))
                    (fact 'fun-codomain-superset tl 'NN 'kk 'CC)
                    (fact 'fun-codomain-superset c 'NN 'kk 'CC)
                    (fact 'subset-mem-fwd 'kk 'CC (list e j))
                    (dk-apply! (dk-cite! 'cf-cons-in-fun 'kk) (list e j) tl)
                    (fact 'fun-codomain-superset (list 'CF-CONS (list e j) tl) 'NN 'kk 'CC)
                    (fact 'membership-implies-sethood c (list 'FUN 'NN 'kk))
                    (ew j)
                    (dk-conj-close!
                      (lambda ()
                        (if (not (dk-ass!))
                            (begin
                              (dk-lam-b!)
                              (mac 'image-membership-iff)
                              (dk-conj-close!
                                (lambda ()
                                  (cond ((dk-ass!) #t)
                                        (#t (ew tl)
                                            (dk-conj-close!
                                              (lambda ()
                                                (if (not (dk-ass!))
                                                    (begin
                                                      (dk-lam-b!)
                                                      (dk-fun-ext! (list 'CF-CONS (list e j) tl) c 'NN 'CC #f #f
                                                        (lambda (w)
                                                          (ma-or-split! (dk-cite! 'nn-zero-or-succ w)
                                                            (list
                                                              (lambda ()
                                                                (subst (list '= w 0))
                                                                (subst (dk-apply! (dk-cite! 'cf-cons-zero (list e j)) tl))
                                                                (subst (list '= (list c 0) (list e j)))
                                                                (fact 'subset-mem-fwd 'kk 'CC (list e j))
                                                                (rfl))
                                                              (lambda ()
                                                                (let ((q (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f w))) (dk-asms)))))
                                                                  (subst (list '= w (list 'succ q)))
                                                                  (subst (dk-apply! (dk-cite! 'cf-cons-succ (list e j)) tl q))
                                                                  (fact 'nn-succ-closed q)
                                                                  (fact 'fun-apply-type-c c 'NN 'CC (list 'succ q))
                                                                  (dk-lam-b!)
                                                                  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))))))))))))))))))))))
            (dk-apply! (dk-cite! 'countable-union-nn pud ps))
            (ass)))))))
(qed 'polynomials-below-countable)

;;; (4) the algebraic numbers of degree n over K form a countable set
(define (an-deg kk n) (list 'SEP 'anz_ 'CC (list 'FORSOME 'anac_ (list 'AND (list 'IN 'anac_ (an-polys kk (list 'succ n)))
  (list 'AND (list 'NOT (list '= (list 'anac_ n) 0)) (list '= (an-ps 'anac_ 'anz_ (list 'succ n)) 0))))))

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'kk (list 'IMPLIES '(IS-CC-SUBRING kk)
  (list 'IMPLIES '(IS-COUNTABLE kk) (list 'IS-COUNTABLE (an-deg 'kk 'n)))))))))
(dk-peel!)
(an-subring-parts! 'kk)
(fact 'nn-succ-closed 'n)
(let* ((sn '(succ n)) (pp (an-polys 'kk sn)) (ad (an-deg 'kk 'n))
       (cp (dk-apply! (dk-apply! (dk-cite! 'polynomials-below-countable) sn) 'kk))
       (cs (dk-apply! (dk-cite! 'countable-cases pp)))
       (z0 (an-zero-seq! 'kk)))
  (dk-split! cs)
  ;; the zero sequence is a polynomial: the family is not empty
  (dk-have! (list 'IN z0 pp)
    (lambda () (in-sep! dk-ass! (lambda () (let ((k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!))))) (if (not (dk-lam-b!)) (rfl)))))))
  (ma-or-split! (caddr cs)
    (list
      (lambda ()
        (let ((h (dk-rewrite-h! (list 'IN z0 pp) pp 'EMPTY-SET)))
          (dk-cite! 'empty-set-has-no-members z0)
          (ma-prop-with! (list h (list 'NOT h)))))
      (lambda ()
        (let* ((ex (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'anp_))) (dk-asms)))
               (e (dk-skolem! ex))
               (surj (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f e))) (dk-asms)))
               (pud (list 'VNB-LAMBDA 'anm_ 'NN (an-roots (list e 'anm_) 'n))))
          (fact 'cc-is-set)
          (ma-sep-subset! ad)
          (fact 'subclass-of-set-is-set ad 'CC)
          (dk-have! (list 'FORALL 'puk_ (list 'IMPLIES '(IN puk_ NN) (list 'IS-COUNTABLE (list pud 'puk_))))
            (lambda ()
              (let ((m (dk-di-var!)))
                (dk-lam-b!)
                (fact 'fun-apply-type-c e 'NN pp m)
                (ma-sep-parts! (list 'IN (list e m) pp))
                (fact 'fun-codomain-superset (list e m) 'NN 'kk 'CC)
                (dk-apply! (dk-cite! 'poly-roots-countable 'n) (list e m))
                (ass))))
          (dk-have! (list 'FORALL 'puy_ (list 'IMPLIES (list 'IN 'puy_ ad) (list 'FORSOME 'puk_ (list 'AND '(IN puk_ NN) (list 'IN 'puy_ (list pud 'puk_))))))
            (lambda ()
              (let* ((th (dk-di-var!))
                     (exc (ma-sep-parts! (list 'IN th ad)))
                     (c (dk-skolem! exc))
                     (m (dk-skolem! (dk-apply! surj c))))
                (ew m)
                (dk-conj-close!
                  (lambda ()
                    (if (not (dk-ass!))
                        (begin
                          (dk-lam-b!)
                          (subst (list '= (list e m) c))
                          (in-sep! dk-ass! (lambda () (dk-conj-close! dk-ass!))))))))))
          (dk-apply! (dk-cite! 'countable-union-nn pud ad))
          (ass))))))
(qed 'algebraic-numbers-of-degree-countable)

;;; (5) COR. 4.23 (the countability half): the algebraic numbers over a countable K are countable
(sp (make-wff '(FORALL kk (== (ALGEBRAIC-NUMBERS-OVER kk) (SEP anth_ CC (IS-ALGEBRAIC-OVER-FIELD kk anth_))))))
(dk-peel!)
(mac 'ALGEBRAIC-NUMBERS-OVER)
(qrfl)
(qed 'algebraic-numbers-over-unfold)

(define (an-alg-body kk th)
  (list 'FORSOME 'anan_ (list 'AND '(IN anan_ NN)
    (list 'FORSOME 'anac_ (list 'AND (list 'IN 'anac_ (list 'FUN 'NN kk))
      (list 'AND (an-vanish 'anac_ '(succ anan_))
        (list 'AND '(NOT (= (anac_ anan_) 0)) (list '= (an-ps 'anac_ th '(succ anan_)) 0))))))))

(sp (make-wff '(FORALL kk (IMPLIES (IS-CC-SUBRING kk) (IMPLIES (IS-COUNTABLE kk) (IS-COUNTABLE (ALGEBRAIC-NUMBERS-OVER kk)))))))
(dk-peel!)
(let* ((al '(SEP anth_ CC (IS-ALGEBRAIC-OVER-FIELD kk anth_)))
       (pud (list 'VNB-LAMBDA 'ann_ 'NN (an-deg 'kk 'ann_))))
  (dk-cite! 'algebraic-numbers-over-unfold 'kk)
  (subst (list '= '(ALGEBRAIC-NUMBERS-OVER kk) al))
  (fact 'cc-is-set)
  (ma-sep-subset! al)
  (fact 'subclass-of-set-is-set al 'CC)
  (dk-have! (list 'FORALL 'puk_ (list 'IMPLIES '(IN puk_ NN) (list 'IS-COUNTABLE (list pud 'puk_))))
    (lambda ()
      (let ((n (dk-di-var!)))
        (dk-lam-b!)
        (dk-apply! (dk-apply! (dk-cite! 'algebraic-numbers-of-degree-countable) n) 'kk)
        (ass))))
  (dk-have! (list 'FORALL 'puy_ (list 'IMPLIES (list 'IN 'puy_ al) (list 'FORSOME 'puk_ (list 'AND '(IN puk_ NN) (list 'IN 'puy_ (list pud 'puk_))))))
    (lambda ()
      (let* ((th (dk-di-var!)))
        (ma-sep-parts! (list 'IN th al))
        (let* ((body (dk-project! (an-alg-body 'kk th) 'is-algebraic-over-field (list 'IS-ALGEBRAIC-OVER-FIELD 'kk th)))
               (n (dk-skolem! body 'top))
               (c (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'anac_))) (dk-asms)))))
          (ew n)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (begin
                    (dk-lam-b!)
                    (in-sep! dk-ass!
                      (lambda ()
                        (ew c)
                        (dk-conj-close!
                          (lambda ()
                            (cond ((dk-ass!) #t)
                                  (#t (in-sep! dk-ass! dk-ass!)))))))))))))))
  (dk-apply! (dk-cite! 'countable-union-nn pud al))
  (ass))
(qed 'algebraic-numbers-countable)

;;; the rationals form a subring of C, so the algebraic numbers (over Q) are countable
(sp (make-wff '(IS-CC-SUBRING QQ)))
(mac 'is-cc-subring)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-head-is? g 'SUBSET)
             (mac 'subset-def)
             (let ((x (dk-di-var!))) (fact 'qq-subset-rr x) (fact 'rr-subset-cc x) (ass)))
            ((equal? g '(IN 0 QQ)) (fact 'qq-zero-in) (ass))
            ((equal? g '(IN 1 QQ)) (fact 'qq-one-in) (ass))
            (#t
             (let* ((ls (dk-peel!)) (vs (ma-map cadr (filter (lambda (f) (dk-head-is? f 'IN)) ls))))
               (dk-have! (list 'AND (list 'IN (car vs) 'QQ) (list 'IN (cadr vs) 'QQ)))
               (if (dk-contains? (dk-goal) '+)
                   (fact 'qq-add-closed (car vs) (cadr vs))
                   (fact 'qq-mul-closed (car vs) (cadr vs)))
               (ass)))))))
(qed 'qq-is-cc-subring)

(sp (make-wff '(IS-COUNTABLE (ALGEBRAIC-NUMBERS-OVER QQ))))
(fact 'qq-is-cc-subring)
(fact 'qq-countable)
(dk-apply! (dk-cite! 'algebraic-numbers-countable 'QQ))
(ass)
(qed 'algebraic-numbers-over-qq-countable)
