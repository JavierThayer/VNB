;;; ======================================================================
;;; (3) THE ADDITION THEOREM (33): exp(z + w) = exp(z) exp(w).  The notes
;;; multiply the series out (a Cauchy product); the tree has no Cauchy product of
;;; series, and this is the DERIVATIVE ROUTE: for fixed w, G(z) = exp(z) exp(w - z)
;;; has derivative exp(z) exp(w - z) - exp(z) exp(w - z) = 0 on CC (product and
;;; chain rules, exp' = exp), so G is constant along the segment [0, z]: by the
;;; fundamental theorem for line integrals (line-int-of-derivative),
;;; G(z) - G(0) = the integral of the zero function = 0.  G(0) = exp(w).
;;; No connectedness is used: the segment is the road.
;;; ======================================================================
;;; K-operations of CC-NORMED-FIELD in the goal -> + * - of CC, innermost first
(define (cex-kop-find e)
  (cond ((not (pair? e)) #f)
        ((and (= (length e) 3) (member (car e) '((ADD CC-NORMED-FIELD) (MUL CC-NORMED-FIELD)))
              (not (cex-kop-find (cadr e))) (not (cex-kop-find (caddr e))))
         e)
        ((and (= (length e) 2) (equal? (car e) '(NEG CC-NORMED-FIELD)) (not (cex-kop-find (cadr e))))
         e)
        (#t (let loop ((xs e)) (cond ((null? xs) #f) ((cex-kop-find (car xs))) (#t (loop (cdr xs))))))))
(define (cex-kops!)
  (let loop ()
    (let ((k (cex-kop-find (dk-goal))))
      (if k
          (begin
            (cond ((equal? (car k) '(NEG CC-NORMED-FIELD))
                   (cex-cc-typ! (cadr k))
                   (fact 'cc-nf-neg-apply (cadr k))
                   (subst (list '== k (list '- (cadr k)))))
                  (#t
                   (cex-cc-typ! (cadr k)) (cex-cc-typ! (caddr k))
                   (let ((add? (equal? (car k) '(ADD CC-NORMED-FIELD))))
                     (fact (if add? 'cc-nf-add-apply 'cc-nf-mul-apply) (cadr k) (caddr k))
                     (subst (list '== k (list (if add? '+ '*) (cadr k) (caddr k)))))))
            (loop))))))
(define (cex-open-cc!)
  (cex-nf-setup!)
  (if (not (dk-asm? (list 'IS-OPEN cex-nfm 'CC)))
      (begin
        (fact 'carrier-is-open cex-nfm)
        (dk-have! (list 'IS-OPEN cex-nfm 'CC) (lambda () (subst (list '== 'CC (list 'PTS cex-nfm))) (ass))))))

;;; z |-> w - z has derivative -1 on CC (a quadratic bound with M = 0)
(define cex-H '(VNB-LAMBDA cexy_ CC (- cexw_ cexy_)))
(sp (make-wff (list 'FORALL 'cexw_ (list 'IMPLIES '(IN cexw_ CC)
  (list 'FORALL 'cexz_ (list 'IMPLIES '(IN cexz_ CC)
    (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'CC cex-H 'cexz_ -1)))))))
(dk-peel!)
(cex-open-cc!)
(dk-have! (list 'IN cex-H '(FUN CC CC)) (lambda () (cex-lam-goal! (lambda (x) (cex-cc-typ! (list '- 'cexw_ x))))))
(cex-cc-typ! -1)
(fact 'rr-zero-in)
(dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
(dk-fact! 'cc-diff-on-quadratic 'CC cex-H 'cexz_ -1 0)
(define (cex-sd-bound!)
  (let* ((x (dk-di-var!)) (d (list '- x 'cexz_)) (m (list 'magnitude d)))
    (cex-cc-typ! (list '- 'cexw_ x))
    (cex-cc-typ! '(- cexw_ cexz_))
    (cex-rr-typ! m)
    (cex-beta!
      (lambda ()
        (let ((inner (cadr (cadr (dk-goal)))))
          (cex-cc-typ! inner)
          (dk-have! (list '= inner 0) (lambda () (crs)))
          (subst (list '= inner 0))
          (subst (dk-fact! 'cc-magnitude-zero))
          (cex-rr-typ! (list '* m m))
          (dk-ineq!))))))
(let ((ch (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-contains? f cex-H) (dk-contains? f 'magnitude))) "the quadratic criterion")))
  (cex-chain! (detach-with! ch cex-sd-bound!)))
(ass)
(qed 'cex-sub-deriv)

;;; G(z) = exp(z) exp(w - z) has derivative 0 on CC
(define cex-G '(VNB-LAMBDA cexy_ CC (* (CC-EXP cexy_) (CC-EXP (- cexw_ cexy_)))))
(define (cex-stage-apply! f terms1 terms2)
  (let ((c1 (apply inst*! f terms1)))
    (apply dk-apply! c1 terms2)))
(sp (make-wff (list 'FORALL 'cexw_ (list 'IMPLIES '(IN cexw_ CC)
  (list 'FORALL 'cexz_ (list 'IMPLIES '(IN cexz_ CC)
    (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'CC cex-G 'cexz_ 0)))))))
(dk-peel!)
(cex-open-cc!)
(cex-E-typ!)
(dk-have! (list 'IN cex-H '(FUN CC CC)) (lambda () (cex-lam-goal! (lambda (x) (cex-cc-typ! (list '- 'cexw_ x))))))
(dk-have! (list 'IN cex-G '(FUN CC CC))
  (lambda () (cex-lam-goal! (lambda (x) (cex-cc-typ! (list '* (list 'CC-EXP x) (list 'CC-EXP (list '- 'cexw_ x))))))))
(dk-have! (list 'IN cex-G '(FUN CC (CARR CC-NORMED-FIELD))) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
(define cex-gd-hz (list cex-H 'cexz_))
(cex-cc-typ! cex-gd-hz)
(define cex-gd-m (list 'CC-EXP cex-gd-hz))
(cex-exp-typ! 'cexz_)
(cex-exp-typ! cex-gd-hz)
(dk-have! (list 'FORALL 'd2y_ (list 'IMPLIES '(IN d2y_ CC) (list 'IN (list cex-H 'd2y_) 'CC)))
  (lambda () (let ((y (dk-di-var!))) (cex-close-typ! (lambda () (cex-cc-typ! (list cex-H y)))))))
(fact 'cc-exp-deriv 'cexz_)
(fact 'cc-exp-deriv cex-gd-hz)
(fact 'cex-sub-deriv 'cexw_ 'cexz_)
(fact 'cc-is-normed-field)
(define cex-gd-r1
  (cex-stage-apply! (dk-fact! 'diff-on-chain 'CC-NORMED-FIELD) (list 'CC 'CC cex-H cex-E) (list 'cexz_ -1 cex-gd-m)))
(define cex-gd-h2 (list-ref cex-gd-r1 3))
(define cex-gd-l2 (list-ref cex-gd-r1 5))
(define cex-gd-r2
  (cex-stage-apply! (dk-fact! 'diff-on-product 'CC-NORMED-FIELD) (list 'CC cex-E cex-gd-h2) (list 'cexz_ '(CC-EXP cexz_) cex-gd-l2)))
(define cex-gd-p (list-ref cex-gd-r2 3))
(define cex-gd-lt (list-ref cex-gd-r2 5))
(dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES '(IN hbx_ CC) (list '== (list cex-G 'hbx_) (list cex-gd-p 'hbx_))))
  (lambda ()
    (let ((x (dk-di-var!)))
      (cex-cc-typ! (list '- 'cexw_ x))
      (cex-cc-typ! (list cex-H x))
      (cex-exp-typ! x)
      (cex-exp-typ! (list '- 'cexw_ x))
      (cex-beta!
        (lambda ()
          (cex-kops!)
          (qrfl))))))
(define cex-gd-r3 (dk-fact! 'diff-on-transfer-ptwise-eq 'CC-NORMED-FIELD 'CC cex-G cex-gd-p 'cexz_ cex-gd-lt))
(dk-have! (list '= cex-gd-lt 0)
  (lambda ()
    (cex-cc-typ! '(- cexw_ cexz_))
    (cex-exp-typ! '(- cexw_ cexz_))
