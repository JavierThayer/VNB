  (subst (cex-ring-id! '(cxra_ cxrb_)
           (list '= 'cxrb_ (list '* cex-r2i (list '- (list '+ 'cxra_ (list '* +i 'cxrb_)) (list '- 'cxra_ (list '* +i 'cxrb_)))))
           (list C S)))
  (subst (caddr r))
  (subst (cadddr r))
