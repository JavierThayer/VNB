(dk-fact! 'diff-on-transfer-ptwise-eq 'CC-NORMED-FIELD 'CC cex-E (cex-F cex-ecf) 'cexz_ (list 'CC-SERIES-LIMIT (cex-psum cex-ecf 'cexz_)))
(subst cex-ed-eq)
(ass)
