;;; ======================================================================
;;; (8) THE IDENTITIES.  The notes: cos(z+w) + i sin(z+w) = exp(i(z+w)) =
;;; exp(iz) exp(iw) = (cos z + i sin z)(cos w + i sin w), and the same with -i
;;; (cos even, sin odd); adding and subtracting gives the addition formulas.
;;; 1 = exp(iz) exp(-iz) = (cos z + i sin z)(cos z - i sin z) = cos^2 z + sin^2 z.
;;; ======================================================================
;;; C + iS = (c1 + i s1)(c2 + i s2) and C - iS = (c1 - i s1)(c2 - i s2) for C, S at z + w
(define (cex-add-eqs! z w)
  (let* ((zw (list '+ z w))
         (C (list 'CC-COS zw)) (S (list 'CC-SIN zw))
         (c1 (list 'CC-COS z)) (s1 (list 'CC-SIN z)) (c2 (list 'CC-COS w)) (s2 (list 'CC-SIN w))
         (ip (lambda (c s) (list '+ c (list '* +i s))))
         (im (lambda (c s) (list '- c (list '* +i s))))
         (iz (list '* +i z)) (iw (list '* +i w)) (izw (list '* +i zw))
         (ea (list '= (ip C S) (list '* (ip c1 s1) (ip c2 s2))))
         (eb (list '= (im C S) (list '* (im c1 s1) (im c2 s2)))))
    (cex-cc-typ! zw)
    (for-each (lambda (x) (cex-cos-typ! x) (cex-sin-typ! x)) (list z w zw))
    (for-each (lambda (x) (cex-cc-typ! x) (cex-exp-typ! x)) (list iz iw izw (list '- iz) (list '- iw) (list '- izw)))
    (fact 'cc-exp-i zw)
    (fact 'cc-exp-i z)
    (fact 'cc-exp-i w)
    (cex-exp-minus-i! zw)
    (cex-exp-minus-i! z)
    (cex-exp-minus-i! w)
    (cex-cc-typ! (list '+ iz iw))
    (cex-cc-typ! (list '+ (list '- iz) (list '- iw)))
    (fact 'cc-exp-add iz iw)
    (fact 'cc-exp-add (list '- iz) (list '- iw))
    (cex-cc-typ! (list '* (ip c1 s1) (ip c2 s2)))
    (cex-cc-typ! (list '* (im c1 s1) (im c2 s2)))
    (dk-have! ea
      (lambda ()
        (subst (list '= (ip C S) (list 'CC-EXP izw)))
        (dk-have! (list '= izw (list '+ iz iw)) (lambda () (crs)))
        (subst (list '= izw (list '+ iz iw)))
        (subst (list '= (list 'CC-EXP (list '+ iz iw)) (list '* (list 'CC-EXP iz) (list 'CC-EXP iw))))
        (subst (list '= (list 'CC-EXP iz) (ip c1 s1)))
        (subst (list '= (list 'CC-EXP iw) (ip c2 s2)))
        (rfl)))
    (dk-have! eb
      (lambda ()
        (subst (list '= (im C S) (list 'CC-EXP (list '- izw))))
        (dk-have! (list '= (list '- izw) (list '+ (list '- iz) (list '- iw))) (lambda () (crs)))
        (subst (list '= (list '- izw) (list '+ (list '- iz) (list '- iw))))
        (subst (list '= (list 'CC-EXP (list '+ (list '- iz) (list '- iw))) (list '* (list 'CC-EXP (list '- iz)) (list 'CC-EXP (list '- iw)))))
        (subst (list '= (list 'CC-EXP (list '- iz)) (im c1 s1)))
        (subst (list '= (list 'CC-EXP (list '- iw)) (im c2 s2)))
        (rfl)))
    (list C S ea eb)))
(sp (make-wff '(FORALL cexz_ (IMPLIES (IN cexz_ CC) (FORALL cexw_ (IMPLIES (IN cexw_ CC)
  (= (CC-COS (+ cexz_ cexw_)) (- (* (CC-COS cexz_) (CC-COS cexw_)) (* (CC-SIN cexz_) (CC-SIN cexw_))))))))))
(dk-peel!)
(let* ((r (cex-add-eqs! 'cexz_ 'cexw_)) (C (car r)) (S (cadr r)))
  (subst (cex-ring-id! '(cxra_ cxrb_)
           (list '= 'cxra_ (list '* 1/2 (list '+ (list '+ 'cxra_ (list '* +i 'cxrb_)) (list '- 'cxra_ (list '* +i 'cxrb_)))))
           (list C S)))
  (subst (caddr r))
  (subst (cadddr r))
  (crs))
(qed 'cc-cos-add)
(sp (make-wff '(FORALL cexz_ (IMPLIES (IN cexz_ CC) (FORALL cexw_ (IMPLIES (IN cexw_ CC)
  (= (CC-SIN (+ cexz_ cexw_)) (+ (* (CC-COS cexw_) (CC-SIN cexz_)) (* (CC-COS cexz_) (CC-SIN cexw_))))))))))
