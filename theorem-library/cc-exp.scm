;;; ======================================================================
;;; (5) CONJUGATION.  The notes: "it follows immediately from the definition of
;;; exp that exp(conj z) = conj(exp z)".  In the tree: conjugation commutes with
;;; the partial sums (induction) and, being an isometry (|conj w| = |w|), with
;;; their limit.  Then exp is real on RR and positive there (exp t = exp(t/2)^2),
;;; and |exp(it)| = 1 for real t (|w|^2 = w conj w and exp(it) exp(-it) = 1).
;;; ======================================================================
(define (cex-conj-typ! z) (cex-cc-typ! (list 'conjugate z)))
;;; conj(a - b) = conj(a) - conj(b)
(sp (make-wff '(FORALL cexa_ (IMPLIES (IN cexa_ CC) (FORALL cexb_ (IMPLIES (IN cexb_ CC)
  (= (conjugate (- cexa_ cexb_)) (- (conjugate cexa_) (conjugate cexb_)))))))))
(dk-peel!)
(cex-cc-typ! '(- cexb_))
(cex-conj-typ! 'cexa_)
(cex-conj-typ! 'cexb_)
(mac 'binary-minus-def)
(cex-and! '(IN cexa_ CC) '(IN (- cexb_) CC))
(subst (dk-fact! 'cc-conjugate-add 'cexa_ '(- cexb_)))
(subst (dk-fact! 'cc-conjugate-neg 'cexb_))
(cex-cc-typ! '(+ (conjugate cexa_) (- (conjugate cexb_))))
(rfl)
(qed 'cc-conjugate-sub)

;;; |conj w| = |w|: Re(conj w) = Re w, Im(conj w) = -Im w, and the squares agree
(sp (make-wff '(FORALL cexz_ (IMPLIES (IN cexz_ CC) (= (magnitude (conjugate cexz_)) (magnitude cexz_))))))
(dk-peel!)
(let* ((w 'cexz_) (cw '(conjugate cexz_)) (m1 (list 'magnitude cw)) (m2 (list 'magnitude w))
       (re1 (list 'real-part cw)) (re2 (list 'real-part w)) (im1 (list 'imag-part cw)) (im2 (list 'imag-part w)))
  (cex-conj-typ! w)
  (fact 'cc-conjugate-involution w)
  (dk-have! (list '= re1 re2)
    (lambda ()
      (subst (dk-fact! 'real-part-def cw))
      (subst (dk-fact! 'real-part-def w))
      (subst (list '= (list 'conjugate cw) w))
      (cex-ring-id! '(cxra_ cxrb_ cxrc_) '(= (* (+ cxra_ cxrb_) cxrc_) (* (+ cxrb_ cxra_) cxrc_)) (list cw w '(recip 2)))
      (ass)))
  (dk-have! (list '= im1 (list '- im2))
    (lambda ()
      (subst (dk-fact! 'imag-part-def cw))
      (subst (dk-fact! 'imag-part-def w))
      (subst (list '= (list 'conjugate cw) w))
      (cex-ring-id! '(cxra_ cxrb_ cxrc_) '(= (* (- cxra_ cxrb_) cxrc_) (- (* (- cxrb_ cxra_) cxrc_))) (list cw w '(recip (* 2 +i))))
      (ass)))
  (fact 'real-part-in-rr w)
  (fact 'imag-part-in-rr w)
  (cex-rr-typ! m1) (cex-rr-typ! m2)
  (fact 'cc-magnitude-nonneg cw)
  (fact 'cc-magnitude-nonneg w)
  (fact 'cc-magnitude-sq cw)
  (fact 'cc-magnitude-sq w)
  (dk-have! (list '= (list '* m1 m1) (list '* m2 m2))
    (lambda ()
      (subst (list '= (list '* m1 m1) (list '+ (list '* re1 re1) (list '* im1 im1))))
      (subst (list '= (list '* m2 m2) (list '+ (list '* re2 re2) (list '* im2 im2))))
      (subst (list '= re1 re2))
      (subst (list '= im1 (list '- im2)))
      (crs)))
  (cex-and! (list 'IN m1 'RR) (list 'IN m2 'RR))
  (cex-and! (list '<= 0 m1) (list '<= 0 m2))
  (fact 'sqrt-unique m1 m2)
  (ass))
(qed 'cc-magnitude-conjugate)

;;; conj(z^k) = conj(z)^k
(sp (make-wff '(FORALL cexk_ (IMPLIES (IN cexk_ NN) (FORALL cexz_ (IMPLIES (IN cexz_ CC)
  (= (conjugate (power cexz_ cexk_)) (power (conjugate cexz_) cexk_))))))))
(let* ((br (use-induction))
       (v (cdr (assq 'var br)))
       (ih (cdr (assq 'ih br)))
       (step (cdr (assq 'step br))))
  (dk-focus! (cdr (assq 'base br)))
  (let ((z (dk-di-var!)))
    (cex-conj-typ! z)
    (subst (dk-fact! 'power-zero z))
    (subst (dk-fact! 'power-zero (list 'conjugate z)))
    (fact 'rr-one-in)
    (subst (dk-fact! 'cc-conjugate-fixes-rr 1))
    (fact 'cc-one-in)
    (rfl))
  (dk-focus! step)
  (let ((z (dk-di-var!)))
    (cex-conj-typ! z)
    (cex-nn-typ! v)
    (cex-and! (list 'IN z 'CC) (list 'IN v 'NN))
    (subst (dk-fact! 'power-succ z v))
    (cex-and! (list 'IN (list 'conjugate z) 'CC) (list 'IN v 'NN))
    (subst (dk-fact! 'power-succ (list 'conjugate z) v))
    (cex-cc-typ! (list 'power z v))
    (cex-and! (list 'IN z 'CC) (list 'IN (list 'power z v) 'CC))
    (subst (dk-fact! 'cc-conjugate-mul z (list 'power z v)))
    (subst (dk-apply! ih z))
    (cex-cc-typ! (list '* (list 'conjugate z) (list 'power (list 'conjugate z) v)))
    (rfl)))
(qed 'cc-conjugate-power)

;;; the sum of the conjugated series is the conjugate of the sum
(define cex-cj-h '(FORALL cexj_ (IMPLIES (IN cexj_ NN) (= (g cexj_) (conjugate (f cexj_))))))
(sp (make-wff (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN NN CC))
  (list 'FORALL 'g (list 'IMPLIES '(IN g (FUN NN CC))
    (list 'IMPLIES cex-cj-h (list 'IMPLIES '(CC-SERIES-CONVERGES f)
      '(AND (CC-SERIES-CONVERGES g) (= (CC-SERIES-LIMIT g) (conjugate (CC-SERIES-LIMIT f))))))))))))
(dk-peel!)
(define cex-cj-l '(CC-SERIES-LIMIT f))
(define cex-cj-cl (list 'conjugate cex-cj-l))
(fact 'cc-series-limit-converges-to 'f)
(fact 'cc-series-limit-in-cc 'f)
(cex-conj-typ! cex-cj-l)
(define (cex-cj-ps! k)
  (cex-nn-typ! k)
  (fact 'cc-series-partial-sum-in-cc k 'f)
  (fact 'cc-series-partial-sum-in-cc k 'g)
  (fact 'fun-apply-type-c 'f 'NN 'CC k)
  (fact 'fun-apply-type-c 'g 'NN 'CC k))
(define cex-cj-claim
  '(FORALL cexm_ (IMPLIES (IN cexm_ NN)
     (= (CC-SERIES-PARTIAL-SUM g cexm_) (conjugate (CC-SERIES-PARTIAL-SUM f cexm_))))))
(dk-have! cex-cj-claim
  (lambda ()
    (let* ((br (use-induction))
           (v (cdr (assq 'var br)))
           (ih (cdr (assq 'ih br)))
           (step (cdr (assq 'step br))))
      (dk-focus! (cdr (assq 'base br)))
      (subst (dk-fact! 'cc-series-partial-sum-zero 'g))
      (subst (dk-fact! 'cc-series-partial-sum-zero 'f))
      (fact 'rr-zero-in)
      (subst (dk-fact! 'cc-conjugate-fixes-rr 0))
      (fact 'cc-zero-in)
      (rfl)
      (dk-focus! step)
      (cex-cj-ps! v)
      (subst (dk-fact! 'cc-series-partial-sum-succ 'g v))
      (subst (dk-fact! 'cc-series-partial-sum-succ 'f v))
      (subst ih)
      (subst (dk-apply! (dk-ctx-form cex-cj-h) v))
      (cex-and! (list 'IN (list 'CC-SERIES-PARTIAL-SUM 'f v) 'CC) (list 'IN (list 'f v) 'CC))
      (subst (dk-fact! 'cc-conjugate-add (list 'CC-SERIES-PARTIAL-SUM 'f v) (list 'f v)))
      (cex-cc-typ! (list '+ (list 'conjugate (list 'CC-SERIES-PARTIAL-SUM 'f v)) (list 'conjugate (list 'f v))))
      (rfl))))
;; the partial-sum sequences
(define cex-cj-iff (dk-fact! 'cc-series-converges-to 'g cex-cj-cl))
(define cex-cj-pg (caddr (caddr cex-cj-iff)))
(define cex-cj-pf (subst-free 'g 'f cex-cj-pg))
(cex-lam-typ! cex-cj-pg 'CC (lambda (v) (fact 'cc-series-partial-sum-in-cc v 'g)))
(cex-lam-typ! cex-cj-pf 'CC (lambda (v) (fact 'cc-series-partial-sum-in-cc v 'f)))
(dk-have! (list 'CONVERGES-TO 'CC-MS cex-cj-pf cex-cj-l)
  (lambda () (mac-h 'cc-series-converges-to (list 'CC-SERIES-CONVERGES-TO 'f cex-cj-l)) (ass)))
(define (cex-cj-err k) (list 'magnitude (list '- (list 'CC-SERIES-PARTIAL-SUM 'f k) cex-cj-l)))
(define cex-cj-m (list 'VNB-LAMBDA 'cexj_ 'NN (cex-cj-err 'cexj_)))
(cex-lam-typ! cex-cj-m 'RR
  (lambda (v) (fact 'cc-series-partial-sum-in-cc v 'f) (cex-rr-typ! (cex-cj-err v))))
(cex-chain!
  (detach-with! (dk-fact! 'cc-converges-magnitude-null cex-cj-pf cex-cj-l cex-cj-m)
    (lambda ()
      (let ((j (dk-di-var!)))
        (fact 'cc-series-partial-sum-in-cc j 'f)
        (cex-rr-typ! (cex-cj-err j))
        (cex-beta! (lambda () (rfl)))))))
(cex-chain!
  (detach-with! (dk-fact! 'cpd-cc-squeeze cex-cj-pg cex-cj-cl cex-cj-m)
    (lambda ()
      (let* ((j (dk-di-var!)) (sf (list 'CC-SERIES-PARTIAL-SUM 'f j)))
        (cex-cj-ps! j)
        (cex-rr-typ! (cex-cj-err j))
        (cex-beta!
          (lambda ()
            (subst (dk-apply! (dk-ctx-form cex-cj-claim) j))
            (fact 'cc-conjugate-sub sf cex-cj-l)
            (subst (list '= (list '- (list 'conjugate sf) cex-cj-cl) (list 'conjugate (list '- sf cex-cj-l))))
            (cex-cc-typ! (list '- sf cex-cj-l))
            (subst (dk-fact! 'cc-magnitude-conjugate (list '- sf cex-cj-l)))
            (dk-ineq!)))))))
(dk-have! (list 'CC-SERIES-CONVERGES-TO 'g cex-cj-cl) (lambda () (mac 'cc-series-converges-to) (ass)))
(dk-have! '(CC-SERIES-CONVERGES g) (lambda () (mac 'cc-series-converges) (mac 'converges) (ew cex-cj-cl) (ass)))
(fact 'cc-series-limit-converges-to 'g)
(fact 'cc-series-limit-in-cc 'g)
(dk-have! (list 'CONVERGES-TO 'CC-MS cex-cj-pg '(CC-SERIES-LIMIT g))
  (lambda () (mac-h 'cc-series-converges-to '(CC-SERIES-CONVERGES-TO g (CC-SERIES-LIMIT g))) (ass)))
(fact 'cc-limit-unique cex-cj-pg '(CC-SERIES-LIMIT g) cex-cj-cl)
(dk-conj-close! (lambda () (ass)))
(qed 'cc-series-limit-conjugate)

;;; exp(conj z) = conj(exp z)
(sp (make-wff '(FORALL cexz_ (IMPLIES (IN cexz_ CC) (= (CC-EXP (conjugate cexz_)) (conjugate (CC-EXP cexz_)))))))
(dk-peel!)
(cex-conj-typ! 'cexz_)
(let* ((f (cex-exp-lam 'cexz_)) (g (cex-exp-lam '(conjugate cexz_))))
  (dk-split-all! (list (dk-fact! 'cc-exp-converges 'cexz_)))
  (cex-lam-typ! f 'CC (lambda (k) (cex-cc-typ! (list '* (list 'recip (list 'FACTORIAL k)) (list 'power 'cexz_ k)))))
  (cex-lam-typ! g 'CC (lambda (k) (cex-cc-typ! (list '* (list 'recip (list 'FACTORIAL k)) (list 'power '(conjugate cexz_) k)))))
  (let ((ch (dk-fact! 'cc-series-limit-conjugate f g)))
    (cex-chain!
      (detach-with! ch
        (lambda ()
          (let* ((j (dk-di-var!)) (rj (list 'recip (list 'FACTORIAL j))) (pj (list 'power 'cexz_ j)))
            (cex-rr-typ! rj)
            (cex-cc-typ! (list '* rj pj))
            (cex-cc-typ! (list '* rj (list 'power '(conjugate cexz_) j)))
            (cex-cc-typ! (list 'conjugate (list '* rj pj)))
            (cex-beta!
              (lambda ()
                (cex-cc-typ! rj)
                (cex-and! (list 'IN rj 'CC) (list 'IN pj 'CC))
                (subst (dk-fact! 'cc-conjugate-mul rj pj))
                (subst (dk-fact! 'cc-conjugate-fixes-rr rj))
                (subst (dk-fact! 'cc-conjugate-power j 'cexz_))
                (rfl)))))))
    (dk-split-all!)
    (mac 'CC-EXP)
    (ass)))
(qed 'cc-exp-conj)

;;; |w|^2 = w conj(w)
(sp (make-wff '(FORALL cexz_ (IMPLIES (IN cexz_ CC) (= (* (magnitude cexz_) (magnitude cexz_)) (* cexz_ (conjugate cexz_)))))))
(dk-peel!)
(let* ((re '(real-part cexz_)) (im '(imag-part cexz_)) (iim (list '* +i im)) (d (list '+ re iim)))
  (fact 'real-part-in-rr 'cexz_)
  (fact 'imag-part-in-rr 'cexz_)
  (cex-conj-typ! 'cexz_)
  (cex-cc-typ! '(* cexz_ (conjugate cexz_)))
  (cex-cc-typ! d)
  (cex-conj-typ! d)
  (cex-cc-typ! (list '* d (list 'conjugate d)))
  (fact 'cc-re-im-decompose 'cexz_)
  (dk-congr! (list '= 'cexz_ d) (lambda (x) (list '* x (list 'conjugate x))))
  (subst (dk-fact! 'cc-magnitude-sq 'cexz_))
  (subst (list '= '(* cexz_ (conjugate cexz_)) (list '* d (list 'conjugate d))))
  (cex-and! (list 'IN re 'CC) (list 'IN iim 'CC))
  (subst (dk-fact! 'cc-conjugate-add re iim))
  (cex-cc-typ! im)
  (cex-and! (list 'IN +i 'CC) (list 'IN im 'CC))
  (subst (dk-fact! 'cc-conjugate-mul +i im))
  (subst (dk-fact! 'cc-conjugate-fixes-rr re))
  (subst (dk-fact! 'cc-conjugate-fixes-rr im))
  (subst (dk-fact! 'cc-conjugate-i))
  (crs))
(qed 'cc-magnitude-sq-conjugate)

;;; exp is real on RR
(sp (make-wff '(FORALL cext_ (IMPLIES (IN cext_ RR) (IN (CC-EXP cext_) RR)))))
(dk-peel!)
(fact 'rr-subset-cc 'cext_)
(let ((w '(CC-EXP cext_)))
  (cex-exp-typ! 'cext_)
  (cex-conj-typ! w)
  (fact 'cc-exp-conj 'cext_)
  (fact 'cc-conjugate-fixes-rr 'cext_)
  (cex-exp-typ! '(conjugate cext_))
  (dk-have! (list '= (list 'conjugate w) w)
    (lambda ()
      (subst (list '= (list 'conjugate w) '(CC-EXP (conjugate cext_))))
      (subst '(= (conjugate cext_) cext_))
      (rfl)))
  (fact 'real-part-in-rr w)
  (dk-have! (list '= (list 'real-part w) w)
    (lambda ()
      (subst (dk-fact! 'real-part-def w))
      (subst (list '= (list 'conjugate w) w))
      (dk-have! '(= (recip 2) 1/2) (lambda () (arith)))
      (subst '(= (recip 2) 1/2))
      (crs)))
  (subst (list '= w (list 'real-part w)))
  (ass))
(qed 'cc-exp-real-valued)

;;; exp t is a positive real for t real: exp t = exp(t/2)^2, exp(t/2) real and /= 0
(sp (make-wff '(FORALL cext_ (IMPLIES (IN cext_ RR) (AND (IN (CC-EXP cext_) RR) (< 0 (CC-EXP cext_)))))))
(dk-peel!)
(let* ((h '(* 1/2 cext_)) (u (list 'CC-EXP h)) (uu (list '* u u)))
  (cex-rr-typ! h)
  (fact 'rr-subset-cc h)
  (fact 'rr-subset-cc 'cext_)
  (fact 'cc-exp-real-valued h)
  (fact 'cc-exp-real-valued 'cext_)
  (fact 'cc-exp-nonzero h)
  (cex-exp-typ! h)
  (cex-exp-typ! 'cext_)
  (cex-cc-typ! (list '+ h h))
  (fact 'cc-exp-add h h)
  (cex-cc-typ! uu)
  (dk-have! (list '= '(CC-EXP cext_) uu)
    (lambda ()
      (subst (list '= uu (list 'CC-EXP (list '+ h h))))
      (dk-have! (list '= (list '+ h h) 'cext_) (lambda () (crs)))
      (subst (list '= (list '+ h h) 'cext_))
      (rfl)))
  (fact 'rr-zero-in)
  (fact 'neq-sym u 0)
  (cex-and! (list 'IN u 'RR) '(IN 0 RR))
  (dk-have! (list '< 0 uu)
    (lambda ()
      (use-cases (dk-fact! 'rr-leq-total u 0)
        (lambda ()
          (cex-and! (list '<= u 0) (list 'NOT (list '= u 0)))
          (fact 'rr-le-ne-lt u 0)
          (fact 'rr-mul-neg-neg-pos u u)
          (ass))
        (lambda ()
          (cex-and! (list '<= 0 u) (list 'NOT (list '= 0 u)))
          (fact 'rr-le-ne-lt 0 u)
          (fact 'rr-mul-pos u u)
          (ass)))))
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IN)
          (ass)
          (begin (subst (list '= '(CC-EXP cext_) uu)) (ass))))))
(qed 'cc-exp-real)

;;; |exp(it)| = 1 for real t
(sp (make-wff '(FORALL cext_ (IMPLIES (IN cext_ RR) (= (magnitude (CC-EXP (* +i cext_))) 1)))))
(dk-peel!)
(let* ((z (list '* +i 'cext_)) (w (list 'CC-EXP z)) (m (list 'magnitude w)) (nz (list '- z)))
  (fact 'rr-subset-cc 'cext_)
  (cex-cc-typ! z)
  (cex-cc-typ! nz)
  (cex-conj-typ! z)
  (cex-exp-typ! z)
  (cex-exp-typ! nz)
  (cex-conj-typ! w)
  (dk-have! (list '= (list 'conjugate z) nz)
    (lambda ()
      (cex-cc-typ! +i)
      (cex-and! (list 'IN +i 'CC) '(IN cext_ CC))
      (subst (dk-fact! 'cc-conjugate-mul +i 'cext_))
      (subst (dk-fact! 'cc-conjugate-i))
      (subst (dk-fact! 'cc-conjugate-fixes-rr 'cext_))
      (crs)))
  (fact 'cc-exp-conj z)
  (cex-exp-typ! (list 'conjugate z))
  (dk-have! (list '= (list 'conjugate w) (list 'CC-EXP nz))
    (lambda ()
      (subst (list '= (list 'conjugate w) (list 'CC-EXP (list 'conjugate z))))
      (subst (list '= (list 'conjugate z) nz))
      (rfl)))
  (cex-shift0! z)
  (fact 'cc-magnitude-sq-conjugate w)
  (cex-rr-typ! m)
  (fact 'cc-magnitude-nonneg w)
  (fact 'rr-one-in)
  (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
  (dk-have! (list '= (list '* m m) '(* 1 1))
    (lambda ()
      (subst (list '= (list '* m m) (list '* w (list 'conjugate w))))
      (subst (list '= (list 'conjugate w) (list 'CC-EXP nz)))
      (subst (list '= (list '* w (list 'CC-EXP nz)) 1))
      (crs)))
  (cex-and! (list 'IN m 'RR) '(IN 1 RR))
  (cex-and! (list '<= 0 m) '(<= 0 1))
  (fact 'sqrt-unique m 1)
  (ass))
(qed 'cc-exp-magnitude-imaginary)

;;; ======================================================================
;;; (6a) POWERS AND FACTORIALS: z^(m+n) = z^m z^n, z^(mk) = (z^m)^k,
;;; (ab)^k = a^k b^k over CC; k! <= (k+m)!.  Each by induction on the
;;; outermost variable (the tree had only power-zero / power-succ over CC).
;;; ======================================================================
(define (cex-ind! base-k step-k)
  (let* ((br (use-induction))
         (v (cdr (assq 'var br)))
         (ih (cdr (assq 'ih br)))
         (step (cdr (assq 'step br))))
    (dk-focus! (cdr (assq 'base br)))
    (base-k)
    (dk-focus! step)
    (step-k v ih)))
(define (cex-pw! z k)                    ; z^(succ k) = z z^k, rewritten in the goal
  (cex-cc-typ! z) (cex-nn-typ! k)
  (cex-and! (list 'IN z 'CC) (list 'IN k 'NN))
  (subst (dk-fact! 'power-succ z k)))

(sp (make-wff '(FORALL cexn_ (IMPLIES (IN cexn_ NN) (FORALL cexm_ (IMPLIES (IN cexm_ NN) (FORALL cexz_ (IMPLIES (IN cexz_ CC)
  (= (power cexz_ (+ cexm_ cexn_)) (* (power cexz_ cexm_) (power cexz_ cexn_)))))))))))
(cex-ind!
  (lambda ()
    (dk-peel!)
    (subst (dk-fact! 'nn-add-zero 'cexm_))
    (subst (dk-fact! 'power-zero 'cexz_))
    (cex-cc-typ! '(power cexz_ cexm_))
    (crs))
  (lambda (v ih)
    (dk-peel!)
    (subst (dk-fact! 'nn-add-succ 'cexm_ v))
    (cex-pw! 'cexz_ (list '+ 'cexm_ v))
    (subst (dk-apply! ih 'cexm_ 'cexz_))
    (cex-pw! 'cexz_ v)
    (cex-cc-typ! '(power cexz_ cexm_))
    (cex-cc-typ! (list 'power 'cexz_ v))
    (crs)))
(qed 'cc-power-add)

(sp (make-wff '(FORALL cexk_ (IMPLIES (IN cexk_ NN) (FORALL cexm_ (IMPLIES (IN cexm_ NN) (FORALL cexz_ (IMPLIES (IN cexz_ CC)
  (= (power cexz_ (* cexm_ cexk_)) (power (power cexz_ cexm_) cexk_))))))))))
(cex-ind!
  (lambda ()
    (dk-peel!)
    (fact 'nn-in-rr 'cexm_)
    (subst (dk-fact! 'rr-mul-zero 'cexm_))
    (cex-cc-typ! '(power cexz_ cexm_))
    (subst (dk-fact! 'power-zero 'cexz_))
    (subst (dk-fact! 'power-zero '(power cexz_ cexm_)))
    (fact 'cc-one-in)
    (rfl))
  (lambda (v ih)
    (dk-peel!)
    (subst (dk-fact! 'nn-mul-succ 'cexm_ v))
    (cex-nn-typ! (list '* 'cexm_ v))
    (subst (dk-fact! 'cc-power-add 'cexm_ (list '* 'cexm_ v) 'cexz_))
    (subst (dk-apply! ih 'cexm_ 'cexz_))
    (cex-pw! '(power cexz_ cexm_) v)
    (cex-cc-typ! (list 'power '(power cexz_ cexm_) v))
    (crs)))
(qed 'cc-power-mul)

(sp (make-wff '(FORALL cexk_ (IMPLIES (IN cexk_ NN) (FORALL cexa_ (IMPLIES (IN cexa_ CC) (FORALL cexb_ (IMPLIES (IN cexb_ CC)
  (= (power (* cexa_ cexb_) cexk_) (* (power cexa_ cexk_) (power cexb_ cexk_)))))))))))
(cex-ind!
  (lambda ()
    (dk-peel!)
    (cex-cc-typ! '(* cexa_ cexb_))
    (subst (dk-fact! 'power-zero '(* cexa_ cexb_)))
    (subst (dk-fact! 'power-zero 'cexa_))
    (subst (dk-fact! 'power-zero 'cexb_))
    (crs))
  (lambda (v ih)
    (dk-peel!)
    (cex-pw! '(* cexa_ cexb_) v)
    (subst (dk-apply! ih 'cexa_ 'cexb_))
    (cex-pw! 'cexa_ v)
    (cex-pw! 'cexb_ v)
    (cex-cc-typ! (list 'power 'cexa_ v))
    (cex-cc-typ! (list 'power 'cexb_ v))
    (crs)))
(qed 'cc-power-mul-base)

(sp (make-wff '(FORALL cexm_ (IMPLIES (IN cexm_ NN) (FORALL cexk_ (IMPLIES (IN cexk_ NN)
  (<= (FACTORIAL cexk_) (FACTORIAL (+ cexk_ cexm_)))))))))
(cex-ind!
  (lambda ()
    (dk-peel!)
    (subst (dk-fact! 'nn-add-zero 'cexk_))
    (cex-rr-typ! '(FACTORIAL cexk_))
    (dk-ineq!))
  (lambda (v ih)
    (dk-peel!)
    (let* ((x (list '+ 'cexk_ v)) (fx (list 'FACTORIAL x)) (sx (list 'succ x)))
      (subst (dk-fact! 'nn-add-succ 'cexk_ v))
      (cex-nn-typ! x)
      (subst (dk-fact! 'factorial-succ x))
      (dk-apply! ih 'cexk_)
      (cex-fact-pos! x)
      (cex-fact-pos! 'cexk_)
      (cex-rr-typ! sx)
      (fact 'nn-one-le-succ x)
      (fact 'rr-one-in)
      (dk-have! (list '<= 0 fx) (lambda () (dk-ineq! (list '< 0 fx))))
      (fact 'rr-le-scale-nonneg-right 1 sx fx)
      (cex-rr-typ! (list '* sx fx))
      (dk-ineq! (list '<= '(FACTORIAL cexk_) fx) (list '<= (list '* 1 fx) (list '* sx fx))))))
(qed 'factorial-mono)

;;; ======================================================================
;;; (1e) LEMMA 2.16 FOR cos AND sin: as power series in w = z^2 their
;;; coefficients are (-1)^k/(2k)! and (-1)^k/(2k+1)!, and |(-1)^k/(2k)!| <= 1/k!,
;;; |(-1)^k/(2k+1)!| <= 1/k! (factorial-mono), so each radius is infinite by
;;; comparison with the exponential series.
;;; ======================================================================
;;; |(-1)^k a| = a for a >= 0
(sp (make-wff '(FORALL cexk_ (IMPLIES (IN cexk_ NN) (FORALL cexa_ (IMPLIES (IN cexa_ RR) (IMPLIES (<= 0 cexa_)
  (= (magnitude (* (power -1 cexk_) cexa_)) cexa_))))))))
(dk-peel!)
(cex-cc-typ! '(power -1 cexk_))
(fact 'rr-subset-cc 'cexa_)
(cex-and! '(IN (power -1 cexk_) CC) '(IN cexa_ CC))
(subst (dk-fact! 'cc-magnitude-mul '(power -1 cexk_) 'cexa_))
(cex-cc-typ! -1)
(subst (dk-fact! 'cc-magnitude-power 'cexk_ -1))
(cex-rr-typ! -1)
(subst (dk-fact! 'rr-magnitude-is-abs -1))
(dk-have! '(= (abs -1) 1) (lambda () (arith)))
(subst '(= (abs -1) 1))
(subst (dk-fact! 'rr-power-one 'cexk_))
(subst (dk-fact! 'rr-magnitude-is-abs 'cexa_))
(subst (dk-fact! 'rr-abs-of-nonneg 'cexa_))
(crs)
(qed 'cex-sign-magnitude)

(define cex-cv-h '(FORALL cek_ (IMPLIES (IN cek_ NN) (= (cf cek_) (* (power -1 cek_) (recip (FACTORIAL (* 2 cek_))))))))
(define cex-sv-h '(FORALL cek_ (IMPLIES (IN cek_ NN) (= (cf cek_) (* (power -1 cek_) (recip (FACTORIAL (succ (* 2 cek_)))))))))
;;; the radius proof for a coefficient with |cf(n)| = 1/F(n)!, F(n) >= n
(define (cex-trig-radius! vh fidx mono!)
  (dk-peel!)
  (dk-have! cex-ri-h
    (lambda ()
      (dk-peel!)
      (let* ((fa (cadr (dk-goal)))
             (t (cadr (caddr (cadddr fa))))
             (conv (dk-fact! 'cex-exp-series-real-converges t))
             (th (cadr conv)))
        (cex-lam-typ! fa 'RR (lambda (j) (cex-rr-typ! (list '* (list 'magnitude (list 'cf j)) (list 'power t j)))))
        (cex-lam-typ! th 'RR (lambda (j) (cex-rr-typ! (list '* (list 'recip (list 'FACTORIAL j)) (list 'power t j)))))
        (cex-chain!
          (detach-with! (dk-fact! 'comparison-test fa th)
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'SERIES-CONVERGES)
                      (ass)
                      (let* ((n (dk-di-var!)) (fn (list 'FACTORIAL (fidx n))) (r2 (list 'recip fn))
                             (r1 (list 'recip (list 'FACTORIAL n))) (p (list 'power t n)))
                        (cex-nn-typ! (fidx n))
                        (cex-fact-pos! (fidx n))
                        (cex-fact-pos! n)
                        (cex-rr-typ! r2) (cex-rr-typ! r1) (cex-rr-typ! p)
                        (fact 'rr-recip-pos fn)
                        (fact 'rr-power-pos t n)
                        (dk-have! (list '<= 0 r2) (lambda () (dk-ineq! (list '< 0 r2))))
                        (dk-have! (list '<= 0 p) (lambda () (dk-ineq! (list '< 0 p))))
                        (cex-rr-typ! (list '* (list 'magnitude (list 'cf n)) p))
                        (cex-rr-typ! (list '* r1 p))
                        (mono! n)
                        (fact 'rr-recip-antitone (list 'FACTORIAL n) fn)
                        (fact 'rr-mul-le-right r2 r1 p)
                        (fact 'rr-mul-pos r2 p)
                        (cex-rr-typ! (list '* r2 p))
                        (cex-beta!
                          (lambda ()
                            (subst (dk-apply! (dk-ctx-form vh) n))
                            (subst (dk-fact! 'cex-sign-magnitude n r2))
                            (dk-conj-close!
                              (lambda ()
                                (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 0 (list '* r2 p)))))))))))))))
        (ass))))
  (cex-chain! (dk-fact! 'cps-radius-pos-inf 'cf))
  (ass))
(sp (make-wff (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN CC))
  (list 'IMPLIES cex-cv-h '(= (CPS-RADIUS cf) POS-INF))))))
(cex-trig-radius! cex-cv-h (lambda (n) (list '* 2 n))
  (lambda (n)
    (fact 'factorial-mono n n)
    (cex-nn-typ! (list '+ n n))
    (dk-have! (list '= (list '* 2 n) (list '+ n n)) (lambda () (dk-nn!)))
    (dk-have! (list '<= (list 'FACTORIAL n) (list 'FACTORIAL (list '* 2 n)))
      (lambda () (subst (list '= (list '* 2 n) (list '+ n n))) (ass)))))
(qed 'cc-cos-radius)
(sp (make-wff (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN CC))
  (list 'IMPLIES cex-sv-h '(= (CPS-RADIUS cf) POS-INF))))))
(cex-trig-radius! cex-sv-h (lambda (n) (list 'succ (list '* 2 n)))
  (lambda (n)
    (cex-nn-typ! (list 'succ n))
    (fact 'factorial-mono (list 'succ n) n)
    (cex-nn-typ! (list '+ n (list 'succ n)))
    (dk-have! (list '= (list 'succ (list '* 2 n)) (list '+ n (list 'succ n))) (lambda () (dk-nn!)))
    (dk-have! (list '<= (list 'FACTORIAL n) (list 'FACTORIAL (list 'succ (list '* 2 n))))
      (lambda () (subst (list '= (list 'succ (list '* 2 n)) (list '+ n (list 'succ n)))) (ass)))))
(qed 'cc-sin-radius)

;;; ======================================================================
;;; (1f) cos AND sin AS POWER SERIES IN z^2: cos z = C(z^2), sin z = z S(z^2)
;;; with C, S the sums of the coefficient sequences of (1e); both series
;;; converge at every z and cos z, sin z are complex numbers.
;;; ======================================================================
(define (cex-cos-lam z) (cadr (cex-cos-body z)))
(define (cex-lam-at lam j) (subst-free (cadr lam) j (cadddr lam)))
(define (cex-sin-lam z) (cadr (cex-sin-body z)))
(define (cex-sq z) (list 'power z 2))
(sp (make-wff (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN CC))
  (list 'IMPLIES cex-cv-h
    (list 'FORALL 'cexz_ (list 'IMPLIES '(IN cexz_ CC)
      (list 'AND (list 'CC-SERIES-CONVERGES (cex-cos-lam 'cexz_))
                 (list '= '(CC-COS cexz_) (list 'CC-SERIES-LIMIT (cex-psum 'cf (cex-sq 'cexz_))))))))))))
(dk-peel!)
(define cex-cps-w (cex-sq 'cexz_))
(cex-nn-typ! 2)
(cex-cc-typ! cex-cps-w)
(fact 'cc-cos-radius 'cf)
(cex-psum-lim! 'cf cex-cps-w (dk-fact! 'cps-entire-converges 'cf))
(define cex-cps-eqn
  (dk-fun-ext! (cex-cos-lam 'cexz_) (cex-psum 'cf cex-cps-w) 'NN 'CC
    (lambda () (cex-lam-goal! (lambda (j) (cex-nn-typ! (list '* 2 j)) (cex-cc-typ! (cex-lam-at (cex-cos-lam 'cexz_) j)))))
    #f
    (lambda (v)
      (cex-nn-typ! (list '* 2 v))
      (cex-cc-typ! (cex-lam-at (cex-cos-lam 'cexz_) v))
      (cex-cc-typ! (list '* (list 'cf v) (list 'power cex-cps-w v)))
      (cex-beta!
        (lambda ()
          (subst (dk-apply! (dk-ctx-form cex-cv-h) v))
          (subst (dk-fact! 'cc-power-mul v 2 'cexz_))
          (rfl))))))
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'CC-SERIES-CONVERGES)
        (begin (subst cex-cps-eqn) (ass))
        (begin (mac 'CC-COS) (subst cex-cps-eqn) (rfl)))))
(qed 'cc-cos-as-power-series)

(sp (make-wff (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN CC))
  (list 'IMPLIES cex-sv-h
    (list 'FORALL 'cexz_ (list 'IMPLIES '(IN cexz_ CC)
      (list 'AND (list 'CC-SERIES-CONVERGES (cex-sin-lam 'cexz_))
                 (list '= '(CC-SIN cexz_) (list '* 'cexz_ (list 'CC-SERIES-LIMIT (cex-psum 'cf (cex-sq 'cexz_)))))))))))))
(dk-peel!)
(define cex-sps-w (cex-sq 'cexz_))
