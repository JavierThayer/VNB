              (cex-nn-typ! (list '* 2 n))
              (cex-beta! (lambda () (dk-nn! lt)))))))))
(define cex-eo-q (list 'SUBSEQ cex-eo-pf cex-eo-phi))
(fact 'subseq-of-convergent 'CC-MS cex-eo-pf cex-eo-phi '(CC-SERIES-LIMIT f))
(dk-have! (list 'IN cex-eo-q '(FUN NN CC))
  (lambda ()
    (mac 'SUBSEQ)
    (cex-lam-goal!
      (lambda (k)
        (cex-nn-typ! (list '* 2 k))
        (fact 'cc-series-partial-sum-in-cc (list '* 2 k) 'f)
        (cex-beta! (lambda () (ass)))))))
(fact 'cc-one-in)
(define cex-eo-sum '(+ (* 1 (CC-SERIES-LIMIT cexfe_)) (* 1 (CC-SERIES-LIMIT cexfo_))))
(cex-cc-typ! cex-eo-sum)
(cex-chain!
  (detach-with! (dk-fact! 'cc-limit-lincomb cex-eo-pe cex-eo-po cex-eo-q '(CC-SERIES-LIMIT cexfe_) '(CC-SERIES-LIMIT cexfo_) 1 1)
    (lambda ()
      (let ((j (dk-di-var!)))
        (cex-eo-typ! j)
        (cex-eo-typ! (list '* 2 j))
        (subst (dk-fact! 'subseq-apply cex-eo-pf cex-eo-phi j))
        (cex-beta!
          (lambda ()
            (subst (dk-apply! (dk-ctx-form cex-eo-ps) j))
            (crs)))))))
(fact 'cc-limit-unique cex-eo-q '(CC-SERIES-LIMIT f) cex-eo-sum)
(subst (list '= '(CC-SERIES-LIMIT f) cex-eo-sum))
(crs)
(qed 'cc-series-even-odd)

;;; ======================================================================
;;; (6c) (34): exp(iz) = cos z + i sin z.  The exponential series at iz splits
;;; into its even terms (iz)^(2k)/(2k)! = (-1)^k z^(2k)/(2k)!, the cos series,
;;; and its odd terms (iz)^(2k+1)/(2k+1)! = i (-1)^k z^(2k+1)/(2k+1)!, i times the
;;; sin series (i^2 = -1, (ab)^k = a^k b^k, z^(2k) = (z^2)^k); (6b) adds them.
;;; ======================================================================
(define (cex-i2! )                        ; (= (power +i 2) -1) in context
  (if (not (dk-asm? (list '= (list 'power +i 2) -1)))
      (dk-have! (list '= (list 'power +i 2) -1)
        (lambda ()
          (fact 'nn-two-is-succ-succ-zero)
          (subst '(= 2 (succ (succ 0))))
          (fact 'nn-zero-in)
          (cex-nn-typ! '(succ 0))
          (cex-pw! +i '(succ 0))
          (cex-pw! +i 0)
          (subst (dk-fact! 'power-zero +i))
          (crs)))))
(sp (make-wff '(FORALL cexz_ (IMPLIES (IN cexz_ CC)
  (= (CC-EXP (* +i cexz_)) (+ (CC-COS cexz_) (* +i (CC-SIN cexz_))))))))
(dk-peel!)
(let* ((iz (list '* +i 'cexz_))
       (f (cex-exp-lam iz))
       (fe (cex-cos-lam 'cexz_))
       (sl (cex-sin-lam 'cexz_))
       (fo (list 'VNB-LAMBDA 'cexq_ 'NN (list '* +i (cex-lam-at sl 'cexq_))))
       (ls (list 'CC-SERIES-LIMIT sl)))
  (cex-cc-typ! iz)
  (cex-nn-typ! 2)
  (cex-i2!)
  (dk-split-all! (list (dk-fact! 'cc-exp-converges iz)))
  (dk-split-all! (list (dk-fact! 'cc-cos-converges 'cexz_)))
  (dk-split-all! (list (dk-fact! 'cc-sin-converges 'cexz_)))
  (cex-lam-typ! f 'CC (lambda (k) (cex-cc-typ! (cex-lam-at f k))))
  (cex-lam-typ! fe 'CC (lambda (k) (cex-nn-typ! (list '* 2 k)) (cex-cc-typ! (cex-lam-at fe k))))
  (cex-lam-typ! sl 'CC (lambda (k) (cex-nn-typ! (list 'succ (list '* 2 k))) (cex-cc-typ! (cex-lam-at sl k))))
  (cex-lam-typ! fo 'CC (lambda (k) (cex-nn-typ! (list 'succ (list '* 2 k))) (cex-cc-typ! (cex-lam-at fo k))))
  (fact 'cc-series-limit-in-cc sl)
  (fact 'cc-zero-in)
  ;; the odd series is i times the sin series
  (cex-chain!
    (detach-with! (dk-fact! 'cc-series-limit-linear sl sl fo +i 0)
      (lambda ()
        (let ((j (dk-di-var!)))
          (cex-nn-typ! (list 'succ (list '* 2 j)))
          (cex-cc-typ! (cex-lam-at fo j))
          (cex-cc-typ! (cex-lam-at sl j))
          (cex-beta!
            (lambda ()
              (cex-ring-id! '(cxra_) (list '= (list '* +i 'cxra_) (list '+ (list '* +i 'cxra_) (list '* 0 'cxra_)))
                (list (cex-lam-at sl j)))
              (ass)))))))
  (dk-split-all!)
  ;; the split
  (let* ((ch (dk-fact! 'cc-series-even-odd f fe fo))
         (c1 (detach-with! ch
               (lambda ()
                 (let* ((j (dk-di-var!)) (tj (list '* 2 j)) (a (list 'power -1 j)) (r (list 'recip (list 'FACTORIAL tj)))
                        (p (list 'power 'cexz_ tj)))
                   (cex-nn-typ! tj)
                   (cex-cc-typ! (cex-lam-at fe j))
                   (cex-cc-typ! (cex-lam-at f tj))
                   (cex-beta!
                     (lambda ()
                       (subst (dk-fact! 'cc-power-mul-base tj +i 'cexz_))
                       (subst (dk-fact! 'cc-power-mul j 2 +i))
                       (subst (list '= (list 'power +i 2) -1))
                       (cex-ring-id! '(cxra_ cxrb_ cxrc_) '(= (* (* cxra_ cxrb_) cxrc_) (* cxrb_ (* cxra_ cxrc_))) (list a r p))
                       (ass)))))))
         (c2 (detach-with! c1
               (lambda ()
                 (let* ((j (dk-di-var!)) (tj (list '* 2 j)) (sj (list 'succ tj)) (a (list 'power -1 j))
                        (r (list 'recip (list 'FACTORIAL sj))) (p (list 'power 'cexz_ sj)))
                   (cex-nn-typ! sj)
                   (cex-cc-typ! (cex-lam-at fo j))
                   (cex-cc-typ! (cex-lam-at f sj))
                   (cex-beta!
                     (lambda ()
                       (subst (dk-fact! 'cc-power-mul-base sj +i 'cexz_))
                       (cex-pw! +i tj)
                       (subst (dk-fact! 'cc-power-mul j 2 +i))
                       (subst (list '= (list 'power +i 2) -1))
                       (cex-ring-id! '(cxra_ cxrb_ cxrc_)
                         (list '= (list '* +i '(* (* cxra_ cxrb_) cxrc_)) (list '* 'cxrb_ (list '* (list '* +i 'cxra_) 'cxrc_)))
                         (list a r p))
                       (ass))))))))
    (cex-chain! c2))
  (mac 'CC-EXP)
  (mac 'CC-COS)
  (mac 'CC-SIN)
  (subst (list '= (list 'CC-SERIES-LIMIT f) (list '+ (list 'CC-SERIES-LIMIT fe) (list 'CC-SERIES-LIMIT fo))))
  (subst (list '= (list 'CC-SERIES-LIMIT fo) (list '+ (list '* +i ls) (list '* 0 ls))))
  (cex-ring-id! '(cxra_ cxrb_) (list '= (list '+ 'cxra_ (list '+ (list '* +i 'cxrb_) (list '* 0 'cxrb_))) (list '+ 'cxra_ (list '* +i 'cxrb_)))
    (list (list 'CC-SERIES-LIMIT fe) ls))
  (ass))
(qed 'cc-exp-i)

;;; ======================================================================
;;; (6d) cos IS EVEN, sin IS ODD ("it follows from the definition": (-z)^(2k) =
;;; z^(2k), (-z)^(2k+1) = -z^(2k+1), termwise), and (35):
;;;   sin z = (exp(iz) - exp(-iz)) / (2i),   cos z = (exp(iz) + exp(-iz)) / 2.
;;; THE NOTES' (35) READS "sin z = 1/2 (exp iz - exp -iz)": a misprint for
;;; 1/(2i) (at z = pi/2 the printed right side is i, not 1).  The true identity is
;;; proven; division is written with recip (binary-divide-def).
;;; ======================================================================
(define (cex-pow2! x)                    ; (= (power x 2) (* x x)) in context
  (let ((e (list '= (list 'power x 2) (list '* x x))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (cex-cc-typ! x)
            (fact 'nn-two-is-succ-succ-zero)
            (subst '(= 2 (succ (succ 0))))
            (fact 'nn-zero-in)
            (cex-nn-typ! '(succ 0))
            (cex-pw! x '(succ 0))
            (cex-pw! x 0)
            (subst (dk-fact! 'power-zero x))
            (crs))))
    e))
(sp (make-wff '(FORALL cexz_ (IMPLIES (IN cexz_ CC) (= (CC-COS (- cexz_)) (CC-COS cexz_))))))
(dk-peel!)
(cex-cc-typ! '(- cexz_))
(cex-nn-typ! 2)
(dk-split-all! (list (dk-fact! 'cc-cos-converges 'cexz_)))
(dk-split-all! (list (dk-fact! 'cc-cos-converges '(- cexz_))))
(let* ((f1 (cex-cos-lam '(- cexz_))) (f2 (cex-cos-lam 'cexz_)))
  (cex-lam-typ! f1 'CC (lambda (k) (cex-nn-typ! (list '* 2 k)) (cex-cc-typ! (cex-lam-at f1 k))))
  (cex-lam-typ! f2 'CC (lambda (k) (cex-nn-typ! (list '* 2 k)) (cex-cc-typ! (cex-lam-at f2 k))))
  (cex-pow2! '(- cexz_))
  (cex-pow2! 'cexz_)
  (dk-have! '(= (* (- cexz_) (- cexz_)) (* cexz_ cexz_)) (lambda () (crs)))
  (let ((eqn (dk-fun-ext! f1 f2 'NN 'CC #f #f
               (lambda (j)
                 (cex-nn-typ! (list '* 2 j))
                 (cex-cc-typ! (cex-lam-at f1 j))
                 (cex-cc-typ! (cex-lam-at f2 j))
                 (cex-beta!
                   (lambda ()
                     (subst (dk-fact! 'cc-power-mul j 2 '(- cexz_)))
                     (subst (dk-fact! 'cc-power-mul j 2 'cexz_))
                     (subst (list '= '(power (- cexz_) 2) '(* (- cexz_) (- cexz_))))
                     (subst (list '= '(power cexz_ 2) '(* cexz_ cexz_)))
                     (subst '(= (* (- cexz_) (- cexz_)) (* cexz_ cexz_)))
                     (cex-cc-typ! (list '* (list '* (list 'power -1 j) (list 'recip (list 'FACTORIAL (list '* 2 j))))
                                             (list 'power '(* cexz_ cexz_) j)))
                     (rfl)))))))
    (mac 'CC-COS)
    (subst eqn)
    (cex-cc-typ! (list 'CC-SERIES-LIMIT f2))
    (rfl)))
(qed 'cc-cos-even)

(sp (make-wff '(FORALL cexz_ (IMPLIES (IN cexz_ CC) (= (CC-SIN (- cexz_)) (- (CC-SIN cexz_)))))))
(dk-peel!)
(cex-cc-typ! '(- cexz_))
(cex-nn-typ! 2)
(fact 'cc-zero-in)
(cex-cc-typ! -1)
(dk-split-all! (list (dk-fact! 'cc-sin-converges 'cexz_)))
(let* ((h (cex-sin-lam '(- cexz_))) (s (cex-sin-lam 'cexz_)) (ls (list 'CC-SERIES-LIMIT s)))
  (cex-lam-typ! h 'CC (lambda (k) (cex-nn-typ! (list 'succ (list '* 2 k))) (cex-cc-typ! (cex-lam-at h k))))
  (cex-lam-typ! s 'CC (lambda (k) (cex-nn-typ! (list 'succ (list '* 2 k))) (cex-cc-typ! (cex-lam-at s k))))
  (cex-pow2! '(- cexz_))
  (cex-pow2! 'cexz_)
  (dk-have! '(= (* (- cexz_) (- cexz_)) (* cexz_ cexz_)) (lambda () (crs)))
  (cex-chain!
    (detach-with! (dk-fact! 'cc-series-limit-linear s s h -1 0)
      (lambda ()
        (let* ((j (dk-di-var!)) (tj (list '* 2 j)) (a (list 'power -1 j))
               (r (list 'recip (list 'FACTORIAL (list 'succ tj)))))
          (cex-nn-typ! (list 'succ tj))
          (cex-cc-typ! (cex-lam-at h j))
          (cex-cc-typ! (cex-lam-at s j))
          (cex-beta!
            (lambda ()
              (cex-pw! '(- cexz_) tj)
              (cex-pw! 'cexz_ tj)
              (subst (dk-fact! 'cc-power-mul j 2 '(- cexz_)))
              (subst (dk-fact! 'cc-power-mul j 2 'cexz_))
              (subst (list '= '(power (- cexz_) 2) '(* (- cexz_) (- cexz_))))
              (subst (list '= '(power cexz_ 2) '(* cexz_ cexz_)))
              (subst '(= (* (- cexz_) (- cexz_)) (* cexz_ cexz_)))
              (cex-ring-id! '(cxra_ cxrb_ cxrc_ cxrd_)
                '(= (* (* cxra_ cxrb_) (* (- cxrc_) cxrd_))
                    (+ (* -1 (* (* cxra_ cxrb_) (* cxrc_ cxrd_))) (* 0 (* (* cxra_ cxrb_) (* cxrc_ cxrd_)))))
                (list a r 'cexz_ (list 'power '(* cexz_ cexz_) j)))
              (ass)))))))
  (dk-split-all!)
  (mac 'CC-SIN)
  (subst (list '= (list 'CC-SERIES-LIMIT h) (list '+ (list '* -1 ls) (list '* 0 ls))))
  (cex-ring-id! '(cxra_) '(= (+ (* -1 cxra_) (* 0 cxra_)) (- cxra_)) (list ls))
  (ass))
(qed 'cc-sin-odd)

;;; exp(-iz) = cos z - i sin z
