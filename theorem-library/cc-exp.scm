;;; ======================================================================
;;; (6b) THE EVEN / ODD SPLIT OF A SERIES.  If sum f converges and so do its
;;; even-indexed subseries sum f(2k) and its odd-indexed subseries sum f(2k+1),
;;; then sum f = sum f(2k) + sum f(2k+1).  The partial sums satisfy
;;; S(f, 2m) = S(f_even, m) + S(f_odd, m) (induction); S(f, 2m) is a
;;; subsequence of S(f, n) (subseq-of-convergent, phi(m) = 2m), so it tends to
;;; sum f, and by linearity of limits to sum f_even + sum f_odd.  The subseries
;;; are GIVEN BY THEIR VALUES.  (Their convergence is a hypothesis: it holds
;;; when sum f converges absolutely, by comparison; for exp(iz) it is the
;;; convergence of the cos and sin series, (1f).)
;;; ======================================================================
(define cex-eo-e '(FORALL cexj_ (IMPLIES (IN cexj_ NN) (= (cexfe_ cexj_) (f (* 2 cexj_))))))
(define cex-eo-o '(FORALL cexj_ (IMPLIES (IN cexj_ NN) (= (cexfo_ cexj_) (f (succ (* 2 cexj_)))))))
(sp (make-wff (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN NN CC))
  (list 'FORALL 'cexfe_ (list 'IMPLIES '(IN cexfe_ (FUN NN CC))
    (list 'FORALL 'cexfo_ (list 'IMPLIES '(IN cexfo_ (FUN NN CC))
      (list 'IMPLIES cex-eo-e (list 'IMPLIES cex-eo-o
        (list 'IMPLIES '(CC-SERIES-CONVERGES f) (list 'IMPLIES '(CC-SERIES-CONVERGES cexfe_) (list 'IMPLIES '(CC-SERIES-CONVERGES cexfo_)
          '(= (CC-SERIES-LIMIT f) (+ (CC-SERIES-LIMIT cexfe_) (CC-SERIES-LIMIT cexfo_))))))))))))))))
(dk-peel!)
(define (cex-eo-typ! k)
  (cex-nn-typ! k)
  (for-each (lambda (g)
              (if (not (dk-asm? (list 'IN (list 'CC-SERIES-PARTIAL-SUM g k) 'CC))) (fact 'cc-series-partial-sum-in-cc k g))
              (if (not (dk-asm? (list 'IN (list g k) 'CC))) (fact 'fun-apply-type-c g 'NN 'CC k)))
            '(f cexfe_ cexfo_)))
(define cex-eo-ps '(FORALL cexm_ (IMPLIES (IN cexm_ NN)
  (= (CC-SERIES-PARTIAL-SUM f (* 2 cexm_)) (+ (CC-SERIES-PARTIAL-SUM cexfe_ cexm_) (CC-SERIES-PARTIAL-SUM cexfo_ cexm_))))))
(dk-have! cex-eo-ps
  (lambda ()
    (cex-ind!
      (lambda ()
        (dk-have! '(= (* 2 0) 0) (lambda () (arith)))
        (subst '(= (* 2 0) 0))
        (subst (dk-fact! 'cc-series-partial-sum-zero 'f))
        (subst (dk-fact! 'cc-series-partial-sum-zero 'cexfe_))
        (subst (dk-fact! 'cc-series-partial-sum-zero 'cexfo_))
        (crs))
      (lambda (v ih)
        (let* ((tv (list '* 2 v)) (s1 (list 'succ tv)))
          (cex-eo-typ! v) (cex-eo-typ! tv) (cex-eo-typ! s1)
          (subst (dk-fact! 'nn-two-mul-succ v))
          (subst (dk-fact! 'cc-series-partial-sum-succ 'f s1))
          (subst (dk-fact! 'cc-series-partial-sum-succ 'f tv))
          (subst (dk-fact! 'cc-series-partial-sum-succ 'cexfe_ v))
          (subst (dk-fact! 'cc-series-partial-sum-succ 'cexfo_ v))
          (subst ih)
          (subst (dk-apply! (dk-ctx-form cex-eo-e) v))
          (subst (dk-apply! (dk-ctx-form cex-eo-o) v))
          (crs))))))
(define (cex-eo-pseq! g)            ; the partial-sum sequence P_g, typed, with P_g -> lim g
  (let* ((l (list 'CC-SERIES-LIMIT g))
         (iff (begin (fact 'cc-series-limit-converges-to g)
                     (fact 'cc-series-limit-in-cc g)
                     (dk-fact! 'cc-series-converges-to g l)))
         (p (caddr (caddr iff))))
    (cex-lam-typ! p 'CC (lambda (v) (fact 'cc-series-partial-sum-in-cc v g)))
    (dk-have! (list 'CONVERGES-TO 'CC-MS p l)
      (lambda () (mac-h 'cc-series-converges-to (list 'CC-SERIES-CONVERGES-TO g l)) (ass)))
    p))
(define cex-eo-pf (cex-eo-pseq! 'f))
(define cex-eo-pe (cex-eo-pseq! 'cexfe_))
(define cex-eo-po (cex-eo-pseq! 'cexfo_))
(define cex-eo-phi '(VNB-LAMBDA cexk_ NN (* 2 cexk_)))
(dk-have! (list 'STRICTLY-MONO-NN cex-eo-phi)
  (lambda ()
