;;; cos and sin are holomorphic on CC
(define (cex-trig-holo! f dthm val-of)
  (cex-open-cc!)
  (mac 'HOLOMORPHIC-ON)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-head-is? g 'FORALL)
               (let ((a (dk-di-var!)))
                 (cex-cos-typ! a) (cex-sin-typ! a)
                 (cex-cc-typ! (val-of a))
                 (ew (val-of a))
                 (fact dthm a)
                 (ass)))
              ((dk-head-is? g 'IN)
               (cex-lam-goal! (lambda (x) (cex-cos-typ! x) (cex-sin-typ! x))))
              (#t (ass)))))))
