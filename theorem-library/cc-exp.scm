(qed 'cc-sin-add)

(sp (make-wff '(FORALL cexz_ (IMPLIES (IN cexz_ CC)
  (= (+ (power (CC-COS cexz_) 2) (power (CC-SIN cexz_) 2)) 1)))))
(dk-peel!)
(let* ((iz '(* +i cexz_)) (c '(CC-COS cexz_)) (s '(CC-SIN cexz_)))
  (cex-cos-typ! 'cexz_)
  (cex-sin-typ! 'cexz_)
  (cex-cc-typ! iz)
