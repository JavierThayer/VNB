;;; cc-exp.scm -- THE ELEMENTARY FUNCTIONS exp, cos, sin ON CC (the notes 2.3.1,
;;; 2.3.2, everything that does not mention pi).
;;; Batch 31-A, 2026-09-25.  The definitions are structure-library/cc-elementary.scm
;;; (CC-EXP, CC-COS, CC-SIN by their power series, the user's decision of 2026-09-25).
;;;
;;; THE SOURCE.  ~/docs/complex-analysis.pdf, 2.3.1-2.3.2 (pp. 30-33).
;;;
;;; THE HEADLINES, in the order of the notes.
;;;   Lemma 2.16   cc-exp-radius     CPS-RADIUS(cf) = POS-INF for cf(k) = 1/k!
;;;                cc-cos-radius, cc-sin-radius: the same for cos and sin as
;;;                power series in z^2 (coefficients (-1)^k/(2k)!, (-1)^k/(2k+1)!)
;;;   f' = f       cc-exp-deriv      IS-DIFF-ON(CC-NORMED-FIELD, CC, exp, z, exp z)
;;;                cc-exp-holomorphic HOLOMORPHIC-ON(CC, exp);  cc-exp-zero  exp 0 = 1
;;;   (33)         cc-exp-add        exp(z + w) = exp z exp w
;;;   Prop 2.17    cc-exp-add, cc-exp-zero, cc-exp-neg (exp(-z) = 1/exp z),
;;;                cc-exp-nonzero / cc-exp-maps-to-nonzero (exp maps CC into
;;;                CC \ {0}), cc-exp-continuous.  The tree has no group structure on
;;;                (CC, +) or CC \ {0} and no homomorphism predicate: these ARE 2.17.
;;;   conjugation  cc-exp-conj       exp(conj z) = conj(exp z)
;;;                cc-exp-real       t real => exp t real and 0 < exp t
;;;                cc-exp-magnitude-imaginary  |exp(i t)| = 1 for t real
;;;   (34)         cc-exp-i          exp(iz) = cos z + i sin z
;;;                cc-cos-even, cc-sin-odd
;;;   (35)         cc-sin-exp        sin z = (exp(iz) - exp(-iz)) / (2i)  [the notes
;;;                print 1/2: a misprint]; cc-cos-exp  cos z = (exp(iz) + exp(-iz))/2
;;;   derivatives  cc-cos-deriv (cos' = -sin), cc-sin-deriv (sin' = cos),
;;;                cc-cos-holomorphic, cc-sin-holomorphic
;;;   identities   cc-cos-add, cc-sin-add, cc-cos-sin-one (cos^2 z + sin^2 z = 1)
;;;
;;; THE ROUTES AND THE GENERAL LEMMAS ON THE WAY.
;;;   * The radius: cps-radius-pos-inf (sum |a_k| t^k < inf for every t > 0 =>
;;;     radius +inf: the ESUP cannot be a real R, since R + 1 is in the set) and,
;;;     for exp, the notes' ratio test (cex-exp-series-real-converges); cos and sin
;;;     by comparison with exp (factorial-mono: k! <= (k+m)!).
;;;   * CC from the balls of 2.10: cc-diff-on-local (the derivative is LOCAL: g
;;;     differentiable at a on an open V inside the open U, f = g on V => f
;;;     differentiable at a on U, the Caratheodory factor extended by the
;;;     difference quotient off V) and cps-entire-diff / cps-entire-converges
;;;     (a power series of infinite radius converges everywhere and is
;;;     differentiable on CC with the termwise derivative: 2.10 on B(0, |a| + 1)).
;;;   * (33) by the DERIVATIVE ROUTE, not the Cauchy product (the tree has none):
;;;     G(z) = exp(z) exp(w - z) has derivative 0 on CC (cex-shift-deriv-zero), so
;;;     G(z) - G(0) is the line integral of 0 along the segment [0, z]
;;;     (line-int-of-derivative), which is 0 (line-int-scalar with the scalar 0):
;;;     cc-exp-shift exp(z) exp(w - z) = exp(w).  No connectedness is used.
;;;   * conjugation: cc-series-limit-conjugate (the conjugated series converges to
;;;     the conjugate sum: partial sums by induction, |conj u| = |u|
;;;     (cc-magnitude-conjugate) for the limit), cc-conjugate-power, -sub,
;;;     cc-magnitude-sq-conjugate (|w|^2 = w conj w).
;;;   * (34) by cc-series-even-odd: a convergent series whose even- and odd-indexed
;;;     subseries converge is their sum (S(f, 2m) = S(f_e, m) + S(f_o, m), and
;;;     S(f, 2m) is a subsequence of S(f, n)); with cc-power-add, cc-power-mul,
;;;     cc-power-mul-base ((ab)^k = a^k b^k) and i^2 = -1.
;;;   * the derivatives through (35): cex-lin-deriv (c x), cc-exp-scaled-deriv
;;;     (exp(c x)' = c exp(c x)), cc-diff-on-scale ((c f)' = c f'),
;;;     cex-exp-comb-deriv (a exp(cx) + b exp(dx)).
;;;
;;; NOTHING asserted: no support, stamp, axiom or definition (the three
;;; definitions are the structure file's).  Helper prefix cex-; theorem binders
;;; cex..._ and those of the cited theorems where an instance must match (cf,
;;; dcf, f, g, cpsk_, cpdz_, cpda_, cpdj_, hbx_, hbz_, d2x_, liz_, rgy_).
;;; LOAD WINDOW: lo = theorem-library/line-int-laws (line-int-scalar; also
;;; cc-int-estimate, regulated-algebra, line-int-fundamental, cps-taylor-
;;; coefficients, cc-power-series-deriv); hi: none.  The structure file loads
;;; after structure-library/cc-power-series (CC-SERIES-LIMIT) and before this file.

;;; ---- typing ---------------------------------------------------------------
(define (cex-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (cex-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass))))))
    f))
(define (cex-nn-typ! t)
  (let ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((eqv? t 1) (fact 'nn-one-in) typ)
          ((and (exact-nonnegative-integer? t)) (dk-have! typ (lambda () (arith))) typ)
          ((cex-op? t 'succ 2) (cex-nn-typ! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          ((or (cex-op? t '+ 3) (cex-op? t '* 3))
           (cex-nn-typ! (cadr t)) (cex-nn-typ! (caddr t))
           (cex-and! (list 'IN (cadr t) 'NN) (list 'IN (caddr t) 'NN))
           (fact (if (eq? (car t) '+) 'nn-add-closed 'nn-mul-closed) (cadr t) (caddr t)) typ)
          (#t (error "cex-nn-typ!: cannot type" (expression->string t))))))
(define (cex-rr-typ! t)
  (let ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((and (number? t) (exact-rational? t)) (dk-have! typ (lambda () (arith))) typ)
          ((and (pair? t) (cex-ground? t)) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((cex-op? t 'FACTORIAL 2)
           (cex-nn-typ! (cadr t))
           (dk-split-all! (list (dk-fact! 'factorial-real-pos (cadr t)))) typ)
          ((or (cex-op? t 'succ 2) (and (cex-op? t '+ 3) (dk-asm? (list 'IN (cadr t) 'NN))
                                         (dk-asm? (list 'IN (caddr t) 'NN))))
           (cex-nn-typ! t) (fact 'nn-in-rr t) typ)
          ((and (cex-op? t 'recip 2) (cex-op? (cadr t) 'FACTORIAL 2))
           (cex-nn-typ! (cadr (cadr t))) (fact 'recip-factorial-in-rr (cadr (cadr t))) typ)
          ((cex-op? t 'recip 2)
           (cex-rr-typ! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "cex-rr-typ!: recip of a term not known nonzero" (expression->string t)))
           (cex-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t)) typ)
          ((cex-op? t '* 3) (cex-rr-typ! (cadr t)) (cex-rr-typ! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((cex-op? t '+ 3) (cex-rr-typ! (cadr t)) (cex-rr-typ! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((cex-op? t '- 3) (cex-rr-typ! (cadr t)) (cex-rr-typ! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((cex-op? t 'power 3) (cex-rr-typ! (cadr t)) (cex-nn-typ! (caddr t)) (fact 'power-real-closed (cadr t) (caddr t)) typ)
          ((cex-op? t 'magnitude 2) (cex-cc-typ! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((cex-op? t 'abs 2) (cex-rr-typ! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          (#t (error "cex-rr-typ!: cannot type" (expression->string t))))))
(define (cex-real? t)
  (or (and (number? t) (exact-rational? t))
      (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
      (cex-op? t 'succ 2) (cex-op? t 'FACTORIAL 2) (cex-op? t 'magnitude 2) (cex-op? t 'abs 2)
      (and (cex-op? t 'recip 2) (cex-op? (cadr t) 'FACTORIAL 2))
      (and (memq (dk-head t) '(* + -)) (= (length t) 3) (cex-real? (cadr t)) (cex-real? (caddr t)))
      (and (cex-op? t 'power 3) (cex-real? (cadr t)))))
;;; a ground numeric term (numbers under + - * recip): typed by arith
(define (cex-ground? t)
  (or (number? t)
      (and (pair? t) (memq (car t) '(+ - * recip)) (every cex-ground? (cdr t)))))
;;; D when (IN F (FUN D CC)) is in context
(define (cex-fun-dom f)
  (let ((hit (find-first (lambda (a) (and (cex-op? a 'IN 3) (equal? (cadr a) f)
                                          (cex-op? (caddr a) 'FUN 3) (eq? (caddr (caddr a)) 'CC)))
                         (dk-asms))))
    (and hit (cadr (caddr hit)))))
(define (cex-cc-typ! t)
  (let ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t 1) (fact 'cc-one-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((and (pair? t) (cex-ground? t)) (dk-have! typ (lambda () (arith))) typ)
          ((and (number? t) (exact-rational? t)) (cex-rr-typ! t) (fact 'rr-subset-cc t) typ)
          ((cex-real? t) (cex-rr-typ! t) (fact 'rr-subset-cc t) typ)
          ((and (pair? t) (= (length t) 2) (dk-asm? (list 'IN (car t) '(FUN NN CC))))
           (cex-nn-typ! (cadr t)) (fact 'fun-apply-type-c (car t) 'NN 'CC (cadr t)) typ)
          ((and (pair? t) (= (length t) 2) (cex-fun-dom (car t)))
           (let ((dom (cex-fun-dom (car t))))
             (if (eq? dom 'NN) (cex-nn-typ! (cadr t)))
             (if (eq? dom 'CC) (cex-cc-typ! (cadr t)))
             (fact 'fun-apply-type-c (car t) dom 'CC (cadr t)) typ))
          ((cex-op? t 'CC-EXP 2) (cex-exp-typ! (cadr t)) typ)
          ((and (cex-op? t 'CC-SERIES-LIMIT 2) (dk-asm? (list 'CC-SERIES-CONVERGES (cadr t))))
           (fact 'cc-series-limit-in-cc (cadr t)) typ)
          ((cex-op? t '* 3) (cex-cc-typ! (cadr t)) (cex-cc-typ! (caddr t))
           (cex-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((cex-op? t '+ 3) (cex-cc-typ! (cadr t)) (cex-cc-typ! (caddr t))
           (cex-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((cex-op? t '- 3) (cex-cc-typ! (cadr t)) (cex-cc-typ! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((cex-op? t '- 2) (cex-cc-typ! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((cex-op? t 'conjugate 2) (cex-cc-typ! (cadr t)) (fact 'cc-conjugate-closed (cadr t)) typ)
          ((cex-op? t 'power 3) (cex-cc-typ! (cadr t)) (cex-nn-typ! (caddr t))
           (cex-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((cex-op? t 'recip 2)
           (cex-cc-typ! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "cex-cc-typ!: recip of a term not known nonzero" (expression->string t)))
           (cex-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (error "cex-cc-typ!: cannot type" (expression->string t))))))

;;; (IN LAM (FUN NN COD)) for LAM = (VNB-LAMBDA v NN body): TYPER gets the
;;; eigenvariable and must land the body's typing.
(define (cex-lam-typ! lam cod typer)
  (let ((typ (list 'IN lam (list 'FUN 'NN cod))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-t!)
            (let* ((j (dk-di-var!)) (leaf (proof-state-focus *ps*)))
              (typer j)
              (if (not (sequent-node-grounded? leaf)) (ass))))))
    typ))

;;; beta-reduce the focus goal; the reduct is a NEW node that becomes the focus
;;; while the worked leaf stays open, unless beta grounded it: run CLOSER then.
(define (cex-beta! closer)
  (let ((leaf (proof-state-focus *ps*)))
    (dk-lam-b!)
    (if (not (sequent-node-grounded? leaf)) (closer))))

;;; A commutative-ring identity with opaque atoms: prove BODY over fresh complex
;;; variables VARS by crs on a lane, then instantiate it at TERMS (typed in CC
;;; first); returns the landed instance.
(define (cex-ring-id! vars body terms)
  (let ((gen (let build ((vs vars))
               (if (null? vs) body
                   (list 'FORALL (car vs) (list 'IMPLIES (list 'IN (car vs) 'CC) (build (cdr vs))))))))
    (if (not (dk-asm? gen)) (dk-have! gen (lambda () (dk-peel!) (crs))))
    (for-each cex-cc-typ! terms)
    (apply dk-apply! (dk-ctx-form gen) terms)))

;;; detach an implication chain: an antecedent in context by detach!, one not in
;;; context (a conjunction of context facts) by detach-with!
(define (cex-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))

;;; POS-RR c from (IN c RR) and (< 0 c) in context
(define (cex-pos-rr! c)
  (if (not (dk-asm? (list 'POS-RR c)))
      (dk-have! (list 'POS-RR c)
        (lambda ()
          (mac-h '< (dk-ctx-form (list '< 0 c)))
          (dk-split-all!)
          (mac 'pos-rr)
          (dk-conj-close! (lambda () (ass)))))))

;;; close the focus goal from a contradiction (< 0 0) proved by dk-ineq! from PREMS
(define (cex-absurd! . prems)
  (dk-have! '(< 0 0) (lambda () (apply dk-ineq! prems)))
  (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
  (ai (dk-cite! 'rr-lt-irrefl 0)))

;;; ======================================================================
;;; (0) THE UNFOLD EQUATIONS.  A def-functoid unfolds in a GOAL by `mac' but not
;;; in an assumption; these theorems are what `mac-h' can name.
;;; ======================================================================
(define (cex-exp-body z) (list 'CC-SERIES-LIMIT (list 'VNB-LAMBDA 'cek_ 'NN (list '* '(recip (FACTORIAL cek_)) (list 'power z 'cek_)))))
(define (cex-cos-body z)
  (list 'CC-SERIES-LIMIT (list 'VNB-LAMBDA 'cek_ 'NN
    (list '* '(* (power -1 cek_) (recip (FACTORIAL (* 2 cek_)))) (list 'power z '(* 2 cek_))))))
(define (cex-sin-body z)
  (list 'CC-SERIES-LIMIT (list 'VNB-LAMBDA 'cek_ 'NN
    (list '* '(* (power -1 cek_) (recip (FACTORIAL (succ (* 2 cek_))))) (list 'power z '(succ (* 2 cek_)))))))

(sp (make-wff (list 'FORALL 'cexz_ (list '== '(CC-EXP cexz_) (cex-exp-body 'cexz_)))))
(di)
(mac 'CC-EXP)
(qrfl)
(qed 'cc-exp-unfold)

(sp (make-wff (list 'FORALL 'cexz_ (list '== '(CC-COS cexz_) (cex-cos-body 'cexz_)))))
(di)
(mac 'CC-COS)
(qrfl)
(qed 'cc-cos-unfold)

(sp (make-wff (list 'FORALL 'cexz_ (list '== '(CC-SIN cexz_) (cex-sin-body 'cexz_)))))
(di)
(mac 'CC-SIN)
(qrfl)
(qed 'cc-sin-unfold)

;;; ======================================================================
;;; (1a) A RADIUS IS INFINITE WHEN THE SERIES OF ABSOLUTE VALUES CONVERGES AT
;;; EVERY t > 0 (the notes p. 25: "The radius of convergence is +infinity if and
;;; only if sum |a_k| r^k < infinity for all positive real numbers r", the "if").
;;; The radius R is ESUP of S = {r >= 0 : sum |a_k| r^k < inf}; if R were a real,
;;; R + 1 would lie in S and exceed R.
;;; ======================================================================
(define (cex-tm c t) (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list 'magnitude (list c 'cpsk_)) (list 'power t 'cpsk_))))
(define (cex-S-setup! s)
  (if (not (dk-asm? (list 'SUBSET s 'RR-POS-STAR)))
      (dk-have! (list 'SUBSET s 'RR-POS-STAR)
        (lambda ()
          (mac 'subset-def)
          (let ((x (dk-di-var!)))
            (sep-me (list 'IN x s))
            (dk-split-all!)
            (mac 'rr-pos-star-membership)
            (oi-l)
            (dk-conj-close! (lambda () (ass)))))))
  (fact 'esup-in s)
  (dk-fact! 'esup-upper s))
(define cex-ri-h
  (list 'FORALL 'cext_ (list 'IMPLIES '(IN cext_ RR) (list 'IMPLIES '(< 0 cext_)
    (list 'SERIES-CONVERGES (cex-tm 'cf 'cext_))))))
(sp (make-wff
  (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN CC))
    (list 'IMPLIES cex-ri-h '(= (CPS-RADIUS cf) POS-INF))))))
(dk-peel!)
(mac 'CPS-RADIUS)
(let* ((s (cadr (cadr (dk-goal))))
       (e (list 'ESUP s))
       (upb (cex-S-setup! s))
       (d (list 'OR (list 'AND (list 'IN e 'RR) (list '<= 0 e)) (list '= e 'POS-INF))))
  (fact 'rr-pos-star-membership e)
  (let ((iff (iff-for (list 'IN e 'RR-POS-STAR))))
    (dk-have! d (lambda () (if (dk-only! iff (list 'IN e 'RR-POS-STAR)) (prop)))))
  (use-cases d
    (lambda ()
      (dk-split-all!)
      (let ((t (list '+ e 1)))
        (cex-rr-typ! t)
        (dk-have! (list '< 0 t) (lambda () (dk-ineq! (list '<= 0 e))))
        (dk-have! (list '<= 0 t) (lambda () (dk-ineq! (list '<= 0 e))))
        (dk-apply! (dk-ctx-form cex-ri-h) t)
        (dk-have! (list 'IN t s) (lambda () (dk-each-leaf! (lambda () (sep-mi)) (lambda () (dk-conj-close! (lambda () (ass)))))))
        (inst+ upb t)
        (cex-absurd! (list '<= t e))))
    (lambda () (ass))))
(qed 'cps-radius-pos-inf)

;;; ======================================================================
;;; (1b) THE REAL EXPONENTIAL SERIES CONVERGES AT EVERY t > 0: the notes' proof
;;; of Lemma 2.16, by the ratio test (Lemma 2.15, ratio-test-converges-limsup):
;;; theta_k = t^k / k! > 0 and theta_(k+1) / theta_k = t / (k + 1) -> 0, so the
;;; ratios are eventually <= 1/2 and their lim sup is < 1.
;;; ======================================================================
(define (cex-fact-pos! k)                   ; (IN k! RR), (< 0 k!)
  (cex-nn-typ! k)
  (if (not (dk-asm? (list '< 0 (list 'FACTORIAL k))))
      (dk-split-all! (list (dk-fact! 'factorial-real-pos k)))))
(define (cex-th-body k) (list '* (list 'recip (list 'FACTORIAL k)) (list 'power 'cext_ k)))
(define cex-th (list 'VNB-LAMBDA 'cpsk_ 'NN (cex-th-body 'cpsk_)))
;;; theta(k) typed, positive, nonzero (cext_ > 0 in context)
(define (cex-th-parts! k)
  (let ((fk (list 'FACTORIAL k)) (rk (list 'recip (list 'FACTORIAL k))) (pk (list 'power 'cext_ k))
        (tk (cex-th-body k)))
    (cex-fact-pos! k)
    (fact 'rr-pos-ne-zero fk)
    (cex-rr-typ! rk)
    (fact 'rr-recip-pos fk)
    (cex-rr-typ! pk)
    (fact 'rr-power-pos 'cext_ k)
    (cex-rr-typ! tk)
    (fact 'rr-mul-pos rk pk)
    (fact 'rr-pos-ne-zero tk)
    tk))
(sp (make-wff (list 'FORALL 'cext_ (list 'IMPLIES '(IN cext_ RR) (list 'IMPLIES '(< 0 cext_)
  (list 'SERIES-CONVERGES cex-th))))))
(dk-peel!)
(fact 'rr-zero-in)
(fact 'rr-one-in)
(cex-lam-typ! cex-th 'RR cex-th-parts!)
(dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN) (list '< 0 (list cex-th 'cpsk_))))
  (lambda () (let ((k (dk-di-var!))) (cex-th-parts! k) (cex-beta! (lambda () (ass))))))
(let* ((ch (dk-fact! 'ratio-test-converges-limsup cex-th))
       (q (cadr (cadr (cadr ch))))
       (lim0 (dk-fact! 'rr-recip-succ-converges-to-zero))
       (f0 (caddr lim0))
       (qparts! (lambda (k)            ; q(k) reduced: typed, positive
                  (cex-nn-typ! (list 'succ k))
                  (let* ((t0 (cex-th-parts! k)) (t1 (cex-th-parts! (list 'succ k))))
                    (cex-rr-typ! (list 'recip t0))
                    (fact 'rr-recip-pos t0)
                    (cex-rr-typ! (list '* t1 (list 'recip t0)))
                    (fact 'rr-mul-pos t1 (list 'recip t0))
                    (list t0 t1))))
       (qh1 (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN) (list 'IN (list q 'cpsk_) 'RR))))
       (qh2 (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN) (list '<= 0 (list q 'cpsk_))))))
  (cex-lam-typ! q 'RR (lambda (k) (qparts! k) (cex-beta! (lambda () (ass)))))
  (dk-have! qh1 (lambda () (let ((k (dk-di-var!))) (qparts! k) (cex-beta! (lambda () (ass))))))
  (dk-have! qh2 (lambda ()
                  (let* ((k (dk-di-var!)) (tt (qparts! k)))
                    (cex-beta! (lambda () (dk-ineq! (list '< 0 (list '* (cadr tt) (list 'recip (car tt))))))))))
  (cex-lam-typ! f0 'RR
    (lambda (k)
      (cex-rr-typ! (list '+ k 1))
      (dk-have! (list 'NOT (list '= (list '+ k 1) 0))
        (lambda () (fact 'nn-zero-le k) (fact 'nn-in-rr k)
                   (dk-have! (list '< 0 (list '+ k 1)) (lambda () (dk-ineq! (list '<= 0 k))))
                   (fact 'rr-pos-ne-zero (list '+ k 1)) (ass)))
      (cex-rr-typ! (list 'recip (list '+ k 1)))))
  ;; q(j) = recip(j + 1) t
  (cex-chain!
    (detach-with! (dk-fact! 'rr-limit-scale 'cext_ f0 q 0)
      (lambda ()
        (let* ((j (dk-di-var!)) (sj (list 'succ j)))
          (qparts! j)
          (fact 'nn-zero-le j) (fact 'nn-in-rr j)
          (cex-rr-typ! (list '+ j 1))
          (dk-have! (list '< 0 (list '+ j 1)) (lambda () (dk-ineq! (list '<= 0 j))))
          (fact 'rr-pos-ne-zero (list '+ j 1))
          (cex-beta!
            (lambda ()
              (cex-cc-typ! 'cext_)
              (cex-and! '(IN cext_ CC) (list 'IN j 'NN))
              (subst (dk-fact! 'power-succ 'cext_ j))
              (subst (dk-fact! 'tgd-recip-factorial-succ j))
              (subst (dk-fact! 'nn-succ-plus-one j))
              (let* ((jj (list '+ j 1)) (b (list 'recip (list 'FACTORIAL jj))) (p (list 'power 'cext_ j))
                     (x (list '* (list '* jj b) p)) (r (list '* (list 'recip jj) 'cext_))
                     (n (list '* b (list '* 'cext_ p))))
                (cex-fact-pos! jj)
                (fact 'rr-pos-ne-zero (list 'FACTORIAL jj))
                (cex-rr-typ! b)
                (fact 'rr-recip-pos (list 'FACTORIAL jj))
                (cex-rr-typ! (list '* jj b))
                (fact 'rr-mul-pos jj b)
                (cex-rr-typ! x)
                (fact 'rr-mul-pos (list '* jj b) p)
                (fact 'rr-pos-ne-zero x)
                (cex-rr-typ! (list 'recip jj))
                (cex-rr-typ! r)
                (cex-rr-typ! n)
                (cex-and! (list 'IN jj 'RR) (list 'NOT (list '= jj 0)))
                (fact 'rr-recip-inverse jj)
                (dk-have! (list '= n (list '* r x))
                  (lambda ()
                    (subst (cex-ring-id! '(cxra_ cxrb_ cxrc_ cxrd_ cxre_)
                             '(= (* (* cxra_ cxrb_) (* (* cxrc_ cxrd_) cxre_)) (* (* cxrc_ cxra_) (* cxrd_ (* cxrb_ cxre_))))
                             (list (list 'recip jj) 'cext_ jj b p)))
                    (subst (list '= (list '* jj (list 'recip jj)) 1))
                    (cex-cc-typ! n)
                    (subst (dk-fact! 'cc-one-mul n))
                    (rfl)))
                (subst (list '= n (list '* r x)))
                (fact 'rr-mul-recip-cancel r x)
                (subst (list '= (list '* (list '* r x) (list 'recip x)) r))
                (rfl))))))))
  ;; eventually q <= 0 t + 1/2, so ELIMSUP(q) < 1
  (let ((lv (list '* 0 'cext_)) (c 1/2))
    (cex-rr-typ! lv)
    (cex-rr-typ! c)
    (dk-have! (list '< 0 c) (lambda () (dk-ineq!)))
    (cex-pos-rr! c)
    (let* ((nt (dk-skolem! (dk-fact! 'rr-limit-tail-le q lv c)))
           (r (list '+ lv c)))
      (cex-rr-typ! r)
      (cex-chain! (dk-fact! 'elimsup-eventually-le q r nt))
      (fact 'elimsup-in-rr-pos-star q)
      (cex-chain! (dk-fact! 'rr-pos-star-le-real-in-rr (list 'ELIMSUP q) r))
      (dk-have! (list '< (list 'ELIMSUP q) 1)
        (lambda () (dk-ineq! (list '<= (list 'ELIMSUP q) r))))
      (cex-chain! ch)
      (ass))))
(qed 'cex-exp-series-real-converges)

;;; ======================================================================
;;; (1c) LEMMA 2.16: THE RADIUS OF CONVERGENCE OF sum_k z^k / k! IS INFINITE.
;;; The coefficient sequence is given by its values, as cps-radius-derived and
;;; cps-kth-derived-radius state theirs.  From (1a) and (1b): |1/k!| = 1/k!.
;;; ======================================================================
;;; run TYPER on the focus leaf; `ass' only if the leaf is still open
(define (cex-close-typ! typer)
  (let ((leaf (proof-state-focus *ps*)))
    (typer)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; (IN LAM (FUN NN COD)) as the FOCUS goal, TYPER of the eigenvariable
(define (cex-lam-goal! typer)
  (dk-lam-t!)
  (let ((j (dk-di-var!)))
    (cex-close-typ! (lambda () (typer j)))))
(define cex-ev-h '(FORALL cek_ (IMPLIES (IN cek_ NN) (= (cf cek_) (recip (FACTORIAL cek_))))))
(sp (make-wff (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN CC))
  (list 'IMPLIES cex-ev-h '(= (CPS-RADIUS cf) POS-INF))))))
(dk-peel!)
(dk-have! cex-ri-h
  (lambda ()
    (dk-peel!)
    (let* ((lhs (cadr (dk-goal)))
           (t (cadr (caddr (cadddr lhs))))
           (conv (dk-fact! 'cex-exp-series-real-converges t))
           (rhs (cadr conv))
           (eqn (dk-fun-ext! lhs rhs 'NN 'RR
                  (lambda () (cex-lam-goal! (lambda (j) (cex-rr-typ! (list '* (list 'magnitude (list 'cf j)) (list 'power t j))))))
                  (lambda () (cex-lam-goal! (lambda (j) (cex-rr-typ! (list '* (list 'recip (list 'FACTORIAL j)) (list 'power t j))))))
                  (lambda (v)
                    (let ((rv (list 'recip (list 'FACTORIAL v))))
                      (cex-rr-typ! (list '* (list 'magnitude (list 'cf v)) (list 'power t v)))
                      (cex-rr-typ! (list '* rv (list 'power t v)))
                      (cex-fact-pos! v)
                      (fact 'rr-recip-pos (list 'FACTORIAL v))
                      (dk-have! (list '<= 0 rv) (lambda () (dk-ineq! (list '< 0 rv))))
                      (cex-beta!
                        (lambda ()
                          (subst (dk-apply! (dk-ctx-form cex-ev-h) v))
                          (subst (dk-fact! 'rr-magnitude-is-abs rv))
                          (subst (dk-fact! 'rr-abs-of-nonneg rv))
                          (rfl))))))))
      (subst eqn)
      (ass))))
(cex-chain! (dk-fact! 'cps-radius-pos-inf 'cf))
(ass)
(qed 'cc-exp-radius)

;;; ======================================================================
;;; (1d) A POWER SERIES OF INFINITE RADIUS CONVERGES AT EVERY z (2.8 on the
;;; closed ball of radius |z|).
;;; ======================================================================
(define (cex-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC)))
      (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
;;; (< R POS-INF) for R in RR with 0 <= R in context
(define (cex-lt-inf! r)
  (dk-have! (list '< r 'POS-INF)
    (lambda ()
      (mac '<)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) '<=)
              (begin
                (dk-have! (list 'IN r 'RR-POS-STAR)
                  (lambda () (mac 'rr-pos-star-membership) (oi-l) (dk-conj-close! (lambda () (ass)))))
                (fact 'rr-pos-star-below-pos-inf r)
                (ass))
              (begin
                (di)
                (fact 'pos-inf-not-in-rr)
                (dk-have! '(IN POS-INF RR) (lambda () (subst (list '= 'POS-INF r)) (ass)))
                (ai '(NOT (IN POS-INF RR))))))))))
;;; |0 - z| written |z|: lands (== ((DIST CC-MS) 0 z) (magnitude (- 0 z))) and (= (magnitude (- 0 z)) (magnitude z))
(define (cex-dist0! z)
  (cex-pts-cc!)
  (fact 'cc-zero-in)
  (cex-cc-typ! z)
  (fact 'cc-ms-dist 0 z)
  (cex-cc-typ! (list '- 0 z))
  (fact 'cc-neg-closed z)
  (dk-have! (list '= (list '- 0 z) (list '- z)) (lambda () (crs)))
  (dk-have! (list '= (list 'magnitude (list '- 0 z)) (list 'magnitude z))
    (lambda () (subst (list '= (list '- 0 z) (list '- z))) (subst (dk-fact! 'cc-magnitude-neg z)) (cex-rr-typ! (list 'magnitude z)) (rfl))))
(define (cex-psum cf z) (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list cf 'cpsk_) (list 'power z 'cpsk_))))
(sp (make-wff (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN CC))
  (list 'IMPLIES '(= (CPS-RADIUS cf) POS-INF)
    (list 'FORALL 'cexz_ (list 'IMPLIES '(IN cexz_ CC) (list 'CC-SERIES-CONVERGES (cex-psum 'cf 'cexz_)))))))))
(dk-peel!)
(let ((m '(magnitude cexz_)))
  (cex-rr-typ! m)
  (fact 'cc-magnitude-nonneg 'cexz_)
  (cex-lt-inf! m)
  (dk-have! (list '< m '(CPS-RADIUS cf)) (lambda () (subst '(= (CPS-RADIUS cf) POS-INF)) (ass)))
  (cex-dist0! 'cexz_)
  (dk-have! (list 'IN 'cexz_ (list 'CLOSED-BALL 'CC-MS 0 m))
    (lambda ()
      (mac 'closed-ball-membership)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'IN)
              (begin (subst '(== (PTS CC-MS) CC)) (ass))
              (begin
                (subst '(== ((DIST CC-MS) 0 cexz_) (magnitude (- 0 cexz_))))
                (subst (list '= '(magnitude (- 0 cexz_)) m))
                (dk-ineq!)))))))
  (dk-apply! (dk-fact! 'cps-converges-closed-ball 'cf m) 'cexz_)
  (ass))
(qed 'cps-entire-converges)

;;; ======================================================================
;;; (2a) THE DERIVATIVE IS LOCAL.  If g, on an open V inside the open U, is
;;; differentiable at a with derivative L, and f on U agrees with g on V, then
;;; f is differentiable at a with derivative L on U.  The Caratheodory factor
;;; psi of g on V is extended to U by the difference quotient of f,
;;;     phi(x) = IF(x in V, psi(x), (f(x) - f(a)) / (x - a)),
;;; which agrees with psi on V, an open neighbourhood of a in U, so it is
;;; continuous at a.  (x /= a off V, since a is in V.)  This is the step from
;;; the balls of 2.10 to CC.
;;; ======================================================================
(define cex-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (cex-nf-setup!)
  (fact 'cc-is-normed-field)
  (fact 'nf-cc-is-metric-space)
  (fact 'nf-metric-carrier 'CC-NORMED-FIELD)
  (fact 'cc-nf-carr)
  (if (not (dk-asm? (list '== (list 'PTS cex-nfm) 'CC)))
      (dk-have! (list '== (list 'PTS cex-nfm) 'CC)
        (lambda () (subst (list '== (list 'PTS cex-nfm) '(CARR CC-NORMED-FIELD))) (ass)))))
(define cex-lo-eq '(FORALL cexx_ (IMPLIES (IN cexx_ cexv_) (= (cexf_ cexx_) (cexg_ cexx_)))))
(sp (make-wff
  (list 'FORALL 'cexu_ (list 'IMPLIES (list 'IS-OPEN cex-nfm 'cexu_)
    (list 'FORALL 'cexf_ (list 'IMPLIES '(IN cexf_ (FUN cexu_ CC))
      (list 'FORALL 'cexv_ (list 'IMPLIES '(SUBSET cexv_ cexu_)
        (list 'FORALL 'cexg_ (list 'FORALL 'cexa_ (list 'FORALL 'cexl_
          (list 'IMPLIES '(IS-DIFF-ON CC-NORMED-FIELD cexv_ cexg_ cexa_ cexl_)
            (list 'IMPLIES cex-lo-eq '(IS-DIFF-ON CC-NORMED-FIELD cexu_ cexf_ cexa_ cexl_))))))))))))))
(dk-peel!)
(cex-nf-setup!)
(cex-pts-cc!)
(dk-have! (list 'SUBSET 'cexu_ (list 'PTS cex-nfm))
  (lambda () (mac-h 'is-open (dk-ctx-form (list 'IS-OPEN cex-nfm 'cexu_))) (dk-split-all!) (ass)))
(dk-have! '(SUBSET cexu_ CC) (lambda () (subst (list '== 'CC (list 'PTS cex-nfm))) (ass)))
(fact 'nf-open-is-set 'CC-NORMED-FIELD 'cexu_)
(fact 'subspace-is-metric-space cex-nfm 'cexu_)
(fact 'subspace-pts cex-nfm 'cexu_)
(fact 'subspace-pts cex-nfm 'cexv_)
;; the derivative of g on V, unfolded
(mac-h 'IS-DIFF-ON (dk-ctx-form '(IS-DIFF-ON CC-NORMED-FIELD cexv_ cexg_ cexa_ cexl_)))
(dk-split-all!)
(define cex-lo-psi (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the Caratheodory factor on V")))
(define cex-lo-veq (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f cex-lo-psi) (dk-contains? f 'MUL))) "the equation on V"))
(dk-have! (list 'IN cex-lo-psi '(FUN cexv_ CC)) (lambda () (subst '(== CC (CARR CC-NORMED-FIELD))) (ass)))
(dk-have! '(IN cexl_ CC) (lambda () (subst '(== CC (CARR CC-NORMED-FIELD))) (ass)))
(fact 'subset-mem-fwd 'cexv_ 'cexu_ 'cexa_)
(define (cex-lo-pt! w)                  ; w in U  ==>  w in CC, f(w) in CC
  (if (not (dk-asm? (list 'IN w 'CC))) (fact 'subset-mem-fwd 'cexu_ 'CC w))
  (if (not (dk-asm? (list 'IN (list 'cexf_ w) 'CC))) (fact 'fun-apply-type-c 'cexf_ 'cexu_ 'CC w)))
(cex-lo-pt! 'cexa_)
(define cex-lo-fa (dk-apply! (dk-ctx-form cex-lo-eq) 'cexa_))
(define (cex-lo-dq w) (list '* (list '- (list 'cexf_ w) '(cexf_ cexa_)) (list 'recip (list '- w 'cexa_))))
(define (cex-lo-ift w) (list 'IF (list 'IN w 'cexv_) (list cex-lo-psi w) (cex-lo-dq w)))
(define cex-lo-phi (list 'VNB-LAMBDA 'cexw_ 'cexu_ (cex-lo-ift 'cexw_)))
;;; NOT(w in V)  ==>  w - a /= 0, recip(w - a) in CC, (w - a) recip(w - a) = 1, the quotient in CC
(define (cex-lo-nz! w)
  (let ((d (list '- w 'cexa_)))
    (cex-cc-typ! d)
    (dk-have! (list 'NOT (list '= d 0))
      (lambda ()
        (di)
        (dk-have! (list '= w 'cexa_)
          (lambda ()
            (dk-have! (list '= w (list '+ d 'cexa_)) (lambda () (crs)))
            (subst (list '= w (list '+ d 'cexa_)))
            (subst (list '= d 0))
            (crs)))
        (dk-have! (list 'IN w 'cexv_) (lambda () (subst (list '= w 'cexa_)) (ass)))
        (ai (list 'NOT (list 'IN w 'cexv_)))))
    (cex-and! (list 'IN d 'CC) (list 'NOT (list '= d 0)))
    (fact 'cc-recip-closed d)
    (fact 'cc-recip-inverse d)
    (cex-cc-typ! (cex-lo-dq w))))
(define cex-lo-pt-typ (list 'FORALL 'cext_ (list 'IMPLIES '(IN cext_ cexu_) (list 'IN (cex-lo-ift 'cext_) 'CC))))
(dk-have! cex-lo-pt-typ
  (lambda ()
    (let ((v (dk-di-var!)))
      (cex-lo-pt! v)
      (dk-case-if! (cex-lo-ift v)
        (lambda (true? val)
          (if true?
              (begin (fact 'fun-apply-type-c cex-lo-psi 'cexv_ 'CC v) (ass))
              (begin (cex-lo-nz! v) (ass))))))))
(dk-have! (list 'IN cex-lo-phi '(FUN cexu_ CC))
  (lambda ()
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (let ((g (dk-goal)))
         (cond ((equal? g '(IN cexu_ SET)) (ass))
               ((dk-head-is? g 'FORALL)
                (let ((v (dk-di-var!))) (inst+ (dk-ctx-form cex-lo-pt-typ) v) (ass)))
               (#t (error "cex: unexpected lam-t leaf" (expression->string g))))))
     (dk-opened (lambda () (lam-t))))))
(dk-have! (list 'IN cex-lo-phi '(FUN cexu_ (CARR CC-NORMED-FIELD)))
  (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
(dk-have! '(IN cexf_ (FUN cexu_ (CARR CC-NORMED-FIELD)))
  (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
;; phi(a) = L
(define cex-lo-pa (list '= (list cex-lo-phi 'cexa_) 'cexl_))
(dk-have! cex-lo-pa
  (lambda ()
    (cex-beta! (lambda () (dk-if-branch! #t (cex-lo-ift 'cexa_) #f (lambda () (ass)))))))
;; continuity of psi at a, and a ball around a inside V
(define cex-lo-subv (list 'SUBSPACE-MS cex-nfm 'cexv_))
(define cex-lo-sub (list 'SUBSPACE-MS cex-nfm 'cexu_))
(mac-h 'is-continuous-at (dk-ctx-form (list 'IS-CONTINUOUS-AT cex-lo-subv cex-nfm cex-lo-psi 'cexa_)))
(dk-split-all!)
(define cex-lo-pcf (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f cex-lo-psi) (dk-contains? f 'POS-RR))) "psi's continuity"))
(mac-h 'is-open (dk-ctx-form (list 'IS-OPEN cex-nfm 'cexv_)))
(dk-split-all!)
(define cex-lo-vo (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'BALL) (dk-contains? f 'cexv_))) "V open"))
(define cex-lo-r0 (dk-skolem! (dk-apply! cex-lo-vo 'cexa_)))
(fact 'rr-pos-rr-in-rr cex-lo-r0)
(fact 'rr-lt-of-pos-rr cex-lo-r0)
(dk-have! (list 'IN 'cexa_ (list 'PTS cex-nfm)) (lambda () (subst (list '== (list 'PTS cex-nfm) 'CC)) (ass)))
(dk-have! (list 'IN 'cexa_ '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
;;; the delta for eps: DEL <= d1 and DEL <= r0/2 follow from PREMS by ineq
(define (cex-lo-delta! del d1 eps prems)
  (let ((r0 cex-lo-r0))
    (dk-have! (list '< 0 del) (lambda () (apply dk-ineq! (append (list (list '< 0 d1) (list '< 0 r0)) prems))))
    (cex-pos-rr! del)
    (ew del)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'POS-RR)
            (ass)
            (let* ((lk (dk-peel!))
                   (b (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)))) lk))))
                   (dab (list 'magnitude (list '- 'cexa_ b))))
              (dk-have! (list 'IN b 'cexu_) (lambda () (subst (list '== 'cexu_ (list 'PTS cex-lo-sub))) (ass)))
              (cex-lo-pt! b)
              (fact 'subspace-dist cex-nfm 'cexu_ 'cexa_ b)
              (dk-have! (list 'IN b (list 'PTS cex-nfm)) (lambda () (subst (list '== (list 'PTS cex-nfm) 'CC)) (ass)))
              (dk-have! (list 'IN b '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
              (fact 'nf-cc-agree-dist 'cexa_ b)
              (fact 'cc-ms-dist 'cexa_ b)
              (cex-rr-typ! dab)
              (dk-have! (list '<= (list (list 'DIST cex-nfm) 'cexa_ b) del)
                (lambda () (subst (list '== (list (list 'DIST cex-nfm) 'cexa_ b) (list (list 'DIST cex-lo-sub) 'cexa_ b))) (ass)))
              (dk-have! (list '<= dab del)
                (lambda ()
                  (subst (list '== dab (list '(DIST CC-MS) 'cexa_ b)))
                  (subst (list '== (list '(DIST CC-MS) 'cexa_ b) (list (list 'DIST cex-nfm) 'cexa_ b)))
                  (ass)))
              ;; b is in the ball of radius r0 about a, hence in V
              (cex-rr-typ! del)
              (dk-have! (list '< del r0) (lambda () (apply dk-ineq! (append (list (list '< 0 r0)) prems))))
              (cex-chain! (dk-fact! 'ball-mem-from-le cex-nfm 'cexa_ b del r0))
              (fact 'subset-mem-fwd (list 'BALL cex-nfm 'cexa_ r0) 'cexv_ b)
              ;; psi's bound at b
              (dk-have! (list '<= dab d1) (lambda () (apply dk-ineq! (append (list (list '<= dab del)) prems))))
              (fact 'subspace-dist cex-nfm 'cexv_ 'cexa_ b)
              (dk-have! (list 'IN b (list 'PTS cex-lo-subv)) (lambda () (subst (list '== (list 'PTS cex-lo-subv) 'cexv_)) (ass)))
              (dk-have! (list '<= (list (list 'DIST cex-lo-subv) 'cexa_ b) d1)
                (lambda ()
                  (subst (list '== (list (list 'DIST cex-lo-subv) 'cexa_ b) (list (list 'DIST cex-nfm) 'cexa_ b)))
                  (subst (list '== (list (list 'DIST cex-nfm) 'cexa_ b) (list '(DIST CC-MS) 'cexa_ b)))
                  (subst (list '== (list '(DIST CC-MS) 'cexa_ b) dab))
                  (ass)))
              (let ((d1f (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d1) (dk-contains? f cex-lo-psi))) "psi's delta")))
                (dk-apply! d1f b))
              ;; the goal, phi(a) = L = psi(a) and phi(b) = psi(b)
              (subst cex-lo-pa)
              (cex-beta!
                (lambda ()
                  (dk-if-branch! #t (cex-lo-ift b) #f
                    (lambda ()
                      (subst (list '= 'cexl_ (list cex-lo-psi 'cexa_)))
                      (ass)))))))))))
(dk-have! (list 'IS-CONTINUOUS-AT cex-lo-sub cex-nfm cex-lo-phi 'cexa_)
  (lambda ()
    (mac 'is-continuous-at)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((dk-head-is? g 'FORALL)
             (let* ((ep (dk-peel!))
                    (eps (cadr (car (filter (dk-head? 'POS-RR) ep))))
                    (d1 (dk-skolem! (dk-apply! cex-lo-pcf eps)))
                    (h (list '* 1/2 cex-lo-r0)))
               (fact 'rr-pos-rr-in-rr d1)
               (fact 'rr-lt-of-pos-rr d1)
               (cex-rr-typ! h)
               (cex-and! (list 'IN d1 'RR) (list 'IN h 'RR))
               (let ((d (dk-fact! 'rr-leq-total d1 h)))
                 (use-cases d
                   (lambda () (cex-lo-delta! d1 d1 eps (list (list '<= d1 h))))
                   (lambda () (cex-lo-delta! h d1 eps (list (list '<= h d1))))))))
            ((dk-head-is? g 'IN)
             (cond ((dk-asm? g) (ass))
                   ((equal? g (list 'IN 'cexa_ (list 'PTS cex-lo-sub)))
                    (subst (list '== (list 'PTS cex-lo-sub) 'cexu_)) (ass))
                   (#t (subst (list '== (list 'PTS cex-lo-sub) 'cexu_))
                       (subst (list '== (list 'PTS cex-nfm) 'CC))
                       (ass))))
            (#t (ass))))))))
;; the equation f(x) - f(a) = phi(x) (x - a) on U
(define (cex-lo-eqn!)
  (let ((x (dk-di-var!)))
    (cex-lo-pt! x)
    (inst+ (dk-ctx-form cex-lo-pt-typ) x)
    (cex-beta!
      (lambda ()
        (dk-case-if! (cex-lo-ift x)
          (lambda (true? val)
            (if true?
                (begin
                  (subst (dk-apply! (dk-ctx-form cex-lo-eq) x))
                  (subst cex-lo-fa)
                  (dk-apply! cex-lo-veq x)
                  (ass))
                (let* ((d (list '- x 'cexa_)) (fd (list '- (list 'cexf_ x) '(cexf_ cexa_))) (q (cex-lo-dq x)))
                  (cex-lo-nz! x)
                  (cex-cc-typ! fd)
                  (fact 'cc-nf-sub (list 'cexf_ x) '(cexf_ cexa_))
                  (fact 'cc-nf-sub x 'cexa_)
                  (subst (list '== (list '(ADD CC-NORMED-FIELD) (list 'cexf_ x) '((NEG CC-NORMED-FIELD) (cexf_ cexa_))) fd))
                  (subst (list '== (list '(ADD CC-NORMED-FIELD) x '((NEG CC-NORMED-FIELD) cexa_)) d))
                  (cex-and! (list 'IN q 'CC) (list 'IN d 'CC))
                  (fact 'cc-nf-mul-apply q d)
                  (subst (list '== (list '(MUL CC-NORMED-FIELD) q d) (list '* q d)))
                  (subst (cex-ring-id! '(cxra_ cxrb_ cxrc_) '(= (* (* cxra_ cxrb_) cxrc_) (* cxra_ (* cxrc_ cxrb_)))
                           (list fd (list 'recip d) d)))
                  (subst (list '= (list '* d (list 'recip d)) 1))
                  (crs)))))))))
(mac 'IS-DIFF-ON)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-head-is? g 'FORSOME)
         (ew cex-lo-phi)
         (dk-conj-close!
           (lambda ()
             (if (not (dk-head-is? (dk-goal) 'FORALL))
                 (ass)
                 (cex-lo-eqn!)))))
        (#t (ass))))))
(qed 'cc-diff-on-local)

;;; ======================================================================
;;; (2b) A POWER SERIES OF INFINITE RADIUS IS DIFFERENTIABLE ON CC, WITH THE
;;; TERMWISE DERIVATIVE (the notes' 2.10 with R = +inf, on CC itself): at a, 2.10
;;; on the ball B(0, |a| + 1) (cps-diff-on-ball), then (2a) with U = CC.
;;; ======================================================================
(define cex-dcf-h '(FORALL cpdj_ (IMPLIES (IN cpdj_ NN) (= (dcf cpdj_) (* (succ cpdj_) (cf (succ cpdj_)))))))
;;; (IN (psum cf z) (FUN NN CC)), then its sum in CC when CONV (the universal of
;;; cps-entire-converges, or #f) gives its convergence
(define (cex-psum-typ! cf z)
  (cex-cc-typ! z)
  (cex-lam-typ! (cex-psum cf z) 'CC (lambda (k) (cex-cc-typ! (list '* (list cf k) (list 'power z k))))))
(define (cex-psum-lim! cf z conv)
  (cex-psum-typ! cf z)
  (dk-apply! conv z)
  (fact 'cc-series-limit-in-cc (cex-psum cf z)))
(define (cex-F cf) (list 'VNB-LAMBDA 'cpdz_ 'CC (list 'CC-SERIES-LIMIT (cex-psum cf 'cpdz_))))
;;; x in BALL(CC-MS, 0, R)  ==>  x in CC
(define (cex-ball-pt! x r)
  (cex-pts-cc!)
  (if (not (dk-asm? (list 'IN x 'CC)))
      (begin
        (fact 'ball-membership 'CC-MS 0 r x)
        (let ((iff (iff-for (list 'IN x (list 'BALL 'CC-MS 0 r)))))
          (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (if (dk-only! iff (list 'IN x (list 'BALL 'CC-MS 0 r))) (prop))))
          (dk-have! (list 'IN x 'CC) (lambda () (subst '(== CC (PTS CC-MS))) (ass)))))))
(sp (make-wff (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN CC))
  (list 'FORALL 'dcf (list 'IMPLIES '(IN dcf (FUN NN CC))
    (list 'IMPLIES cex-dcf-h (list 'IMPLIES '(= (CPS-RADIUS cf) POS-INF)
      (list 'FORALL 'cpda_ (list 'IMPLIES '(IN cpda_ CC)
        (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'CC (cex-F 'cf) 'cpda_ (list 'CC-SERIES-LIMIT (cex-psum 'dcf 'cpda_)))))))))))))
(dk-peel!)
(cex-nf-setup!)
(cex-pts-cc!)
(let* ((m '(magnitude cpda_))
       (r (list '+ m 1))
       (B (list 'BALL 'CC-MS 0 r))
       (FB (list 'VNB-LAMBDA 'cpdz_ B (list 'CC-SERIES-LIMIT (cex-psum 'cf 'cpdz_))))
       (conv (dk-fact! 'cps-entire-converges 'cf)))
  (cex-rr-typ! m)
  (fact 'cc-magnitude-nonneg 'cpda_)
  (cex-rr-typ! r)
  (dk-have! (list '< 0 r) (lambda () (dk-ineq! (list '<= 0 m))))
  (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '<= 0 m))))
  (cex-lt-inf! r)
  (dk-have! (list '< r '(CPS-RADIUS cf)) (lambda () (subst '(= (CPS-RADIUS cf) POS-INF)) (ass)))
  ;; a is in the ball
  (cex-dist0! 'cpda_)
  (fact 'cc-is-metric-space)
  (dk-have! '(IN 0 (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
  (dk-have! '(IN cpda_ (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
  (dk-have! (list '<= '((DIST CC-MS) 0 cpda_) m)
    (lambda () (subst '(== ((DIST CC-MS) 0 cpda_) (magnitude (- 0 cpda_)))) (subst (list '= '(magnitude (- 0 cpda_)) m)) (dk-ineq!)))
  (dk-have! (list '< m r) (lambda () (dk-ineq!)))
  (cex-chain! (dk-fact! 'ball-mem-from-le 'CC-MS 0 'cpda_ m r))
  ;; 2.10 on the ball
  (dk-apply! (dk-fact! 'cps-diff-on-ball 'cf 'dcf r) 'cpda_)
  (fact 'carrier-is-open cex-nfm)
  (dk-have! (list 'IS-OPEN cex-nfm 'CC) (lambda () (subst (list '== 'CC (list 'PTS cex-nfm))) (ass)))
  (dk-have! (list 'SUBSET B 'CC)
    (lambda () (mac 'subset-def) (let ((x (dk-di-var!))) (cex-close-typ! (lambda () (cex-ball-pt! x r))))))
  (dk-have! (list 'IN (cex-F 'cf) '(FUN CC CC))
    (lambda ()
      (cex-lam-goal! (lambda (x) (cex-psum-lim! 'cf x conv)))))
  (dk-have! (list 'FORALL 'cexx_ (list 'IMPLIES (list 'IN 'cexx_ B) (list '= (list (cex-F 'cf) 'cexx_) (list FB 'cexx_))))
    (lambda ()
      (let ((x (dk-di-var!)))
        (cex-ball-pt! x r)
        (cex-psum-lim! 'cf x conv)
        (cex-beta! (lambda () (rfl))))))
  (let ((lsum (list 'CC-SERIES-LIMIT (cex-psum 'dcf 'cpda_))))
    (fact 'cps-radius-derived 'cf 'dcf)
    (dk-have! '(= (CPS-RADIUS dcf) POS-INF) (lambda () (subst '(= (CPS-RADIUS dcf) (CPS-RADIUS cf))) (ass)))
    (cex-psum-lim! 'dcf 'cpda_ (dk-fact! 'cps-entire-converges 'dcf))
    (dk-fact! 'cc-diff-on-local 'CC (cex-F 'cf) B FB 'cpda_ lsum))
  (ass))
(qed 'cps-entire-diff)

;;; ======================================================================
;;; (2c) exp AS A POWER SERIES.  For any coefficient sequence cf with
;;; cf(k) = 1/k!, the defining series of CC-EXP(z) is sum_k cf(k) z^k (function
;;; extensionality), it converges, and CC-EXP(z) is its sum.  The coefficient
;;; used below is the term ECF = VNB-LAMBDA(k, NN, 1/k!).
;;; ======================================================================
(define cex-ecf '(VNB-LAMBDA cej_ NN (recip (FACTORIAL cej_))))
(define (cex-ev-of c) (subst-free 'cf c cex-ev-h))
(define (cex-dcf-of c d) (subst-free 'dcf d (subst-free 'cf c cex-dcf-h)))
(define (cex-exp-lam z) (cadr (cex-exp-body z)))
;;; the exp series at z equals sum_k cf(k) z^k, cf given by its values EV (in context)
(define (cex-exp-lam-eq! cf ev z)
  (cex-psum-typ! cf z)
  (dk-fun-ext! (cex-exp-lam z) (cex-psum cf z) 'NN 'CC
    (lambda () (cex-lam-goal! (lambda (j) (cex-cc-typ! (list '* (list 'recip (list 'FACTORIAL j)) (list 'power z j))))))
    #f
    (lambda (v)
      (cex-cc-typ! (list '* (list cf v) (list 'power z v)))
      (cex-cc-typ! (list '* (list 'recip (list 'FACTORIAL v)) (list 'power z v)))
      (cex-beta! (lambda () (subst (dk-apply! ev v)) (rfl))))))
(sp (make-wff (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN CC))
  (list 'IMPLIES cex-ev-h
    (list 'FORALL 'cexz_ (list 'IMPLIES '(IN cexz_ CC)
      (list 'AND (list 'CC-SERIES-CONVERGES (cex-exp-lam 'cexz_))
                 (list '= '(CC-EXP cexz_) (list 'CC-SERIES-LIMIT (cex-psum 'cf 'cexz_)))))))))))
(dk-peel!)
(fact 'cc-exp-radius 'cf)
(cex-psum-lim! 'cf 'cexz_ (dk-fact! 'cps-entire-converges 'cf))
(define cex-ps-eqn (cex-exp-lam-eq! 'cf (dk-ctx-form cex-ev-h) 'cexz_))
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'CC-SERIES-CONVERGES)
        (begin (subst cex-ps-eqn) (ass))
        (begin (mac 'CC-EXP) (subst cex-ps-eqn) (rfl)))))
(qed 'cc-exp-as-power-series)

;;; ECF typed, its values, ECF is its own derived sequence (1/k! = (k+1)/(k+1)!),
;;; and its radius is infinite
(define (cex-ecf-setup!)
  (cex-lam-typ! cex-ecf 'CC (lambda (k) (cex-cc-typ! (list 'recip (list 'FACTORIAL k)))))
  (let ((ev (cex-ev-of cex-ecf)) (dh (cex-dcf-of cex-ecf cex-ecf)))
    (if (not (dk-asm? ev))
        (dk-have! ev (lambda ()
                       (let ((k (dk-di-var!)))
                         (cex-rr-typ! (list 'recip (list 'FACTORIAL k)))
                         (cex-beta! (lambda () (rfl)))))))
    (if (not (dk-asm? dh))
        (dk-have! dh (lambda ()
                       (let ((k (dk-di-var!)))
                         (cex-nn-typ! (list 'succ k))
                         (cex-rr-typ! (list 'recip (list 'FACTORIAL k)))
                         (cex-rr-typ! (list 'recip (list 'FACTORIAL (list 'succ k))))
                         (cex-beta! (lambda () (fact 'tgd-recip-factorial-succ k) (ass)))))))
    (if (not (dk-asm? (list '= (list 'CPS-RADIUS cex-ecf) 'POS-INF)))
        (fact 'cc-exp-radius cex-ecf))))
;;; CC-EXP(z) = sum_k ECF(k) z^k, landed (z typed in CC)
(define (cex-exp-ps! z)
  (let ((e (list '= (list 'CC-EXP z) (list 'CC-SERIES-LIMIT (cex-psum cex-ecf z)))))
    (if (not (dk-asm? e))
        (begin
          (cex-ecf-setup!)
          (cex-cc-typ! z)
          (let ((b1 (dk-apply! (dk-cite! 'cc-exp-as-power-series cex-ecf) z)))
            (dk-split-all! (list b1)))))
    e))

;;; the exp series converges at every z, and exp z is a complex number
(sp (make-wff (list 'FORALL 'cexz_ (list 'IMPLIES '(IN cexz_ CC)
  (list 'AND (list 'CC-SERIES-CONVERGES (cex-exp-lam 'cexz_)) '(IN (CC-EXP cexz_) CC))))))
(dk-peel!)
(define cex-ec-eq (cex-exp-ps! 'cexz_))
(cex-psum-lim! cex-ecf 'cexz_ (dk-fact! 'cps-entire-converges cex-ecf))
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'CC-SERIES-CONVERGES)
        (ass)
        (begin (subst cex-ec-eq) (ass)))))
(qed 'cc-exp-converges)
(define (cex-exp-typ! z)
  (cex-cc-typ! z)
  (if (not (dk-asm? (list 'IN (list 'CC-EXP z) 'CC)))
      (dk-split-all! (list (dk-fact! 'cc-exp-converges z)))))

;;; ======================================================================
;;; (2) exp' = exp ON CC, exp IS HOLOMORPHIC ON CC, exp 0 = 1.  The notes: "The
