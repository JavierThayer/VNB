;;; ======================================================================
;;; (4) PROPOSITION 2.17: exp is a continuous homomorphism from (CC, +) into
;;; (CC \ {0}, *).  The tree declares no group structure on (CC, +) or on
;;; CC \ {0} and no homomorphism predicate, so 2.17 is its three equations and
;;; the two facts: cc-exp-add (above), cc-exp-zero (exp 0 = 1), cc-exp-neg
;;; (exp(-z) = 1/exp z), cc-exp-nonzero / cc-exp-maps-to-nonzero (exp z /= 0:
;;; exp maps CC into CC \ {0}), and cc-exp-continuous.  The notes: "if exp(a) = 0
;;; ... exp would be identically 0"; here directly: exp(z) exp(-z) = exp(0) = 1.
;;; ======================================================================
(define (cex-shift0! z)                  ; lands (= (* (CC-EXP z) (CC-EXP (- z))) 1)
  (let ((e (list '= (list '* (list 'CC-EXP z) (list 'CC-EXP (list '- z))) 1)))
    (if (not (dk-asm? e))
        (begin
          (cex-cc-typ! z)
          (fact 'cc-zero-in)
          (fact 'cc-exp-shift 0 z)
          (cex-cc-typ! (list '- z))
          (cex-cc-typ! (list '- 0 z))
          (dk-have! (list '= (list '- 0 z) (list '- z)) (lambda () (crs)))
          (dk-have! e
            (lambda ()
              (subst (list '= (list '- z) (list '- 0 z)))
              (subst (list '= (list '* (list 'CC-EXP z) (list 'CC-EXP (list '- 0 z))) '(CC-EXP 0)))
              (subst (dk-fact! 'cc-exp-zero))
              (fact 'cc-one-in)
              (rfl)))))
    e))
(sp (make-wff '(FORALL cexz_ (IMPLIES (IN cexz_ CC) (NOT (= (CC-EXP cexz_) 0))))))
(dk-peel!)
(cex-shift0! 'cexz_)
(cex-exp-typ! 'cexz_)
(cex-exp-typ! '(- cexz_))
(di)
(dk-have! '(= (* (CC-EXP cexz_) (CC-EXP (- cexz_))) 0)
