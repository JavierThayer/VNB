;;; cos' = -sin, sin' = cos
(define cex-cosf '(VNB-LAMBDA cexy_ CC (CC-COS cexy_)))
(define cex-sinf '(VNB-LAMBDA cexy_ CC (CC-SIN cexy_)))
(define cex-mi (list '- +i))
;;; the pointwise and value equations close by crs once (35), -(ix) = (-i) x and
;;; the numeric recips are rewritten
(define (cex-trig-norm! x)
  (let ((e (list '= (list '* cex-mi x) (list '- (list '* +i x)))))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (crs))))
    (subst e)
    (if (dk-contains? (dk-goal) '(recip 2))
        (begin (if (not (dk-asm? '(= (recip 2) 1/2))) (dk-have! '(= (recip 2) 1/2) (lambda () (arith))))
               (subst '(= (recip 2) 1/2))))
    (if (dk-contains? (dk-goal) (list 'recip (list '* 2 +i)))
        (begin (if (not (dk-asm? (list '= (list 'recip (list '* 2 +i)) cex-r2i)))
                   (dk-have! (list '= (list 'recip (list '* 2 +i)) cex-r2i) (lambda () (arith))))
               (subst (list '= (list 'recip (list '* 2 +i)) cex-r2i))))))
(define (cex-trig-deriv! f a b trig-exp value value-exp)
  (cex-open-cc!)
  (let* ((x0 'cexz_)
         (d (dk-fact! 'cex-exp-comb-deriv a b +i cex-mi x0))
         (comb (list-ref d 3))
         (v (list-ref d 5)))
    (cex-exp-typ! (list '* +i x0))
    (cex-exp-typ! (list '* cex-mi x0))
    (cex-exp-typ! (list '- (list '* +i x0)))
    (cex-cos-typ! x0) (cex-sin-typ! x0)
    (dk-have! (list 'IN f '(FUN CC (CARR CC-NORMED-FIELD)))
      (lambda ()
        (subst '(== (CARR CC-NORMED-FIELD) CC))
        (cex-lam-goal! (lambda (x) (cex-cos-typ! x) (cex-sin-typ! x)))))
    (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES '(IN hbx_ CC) (list '== (list f 'hbx_) (list comb 'hbx_))))
      (lambda ()
        (let ((x (dk-di-var!)))
          (cex-cos-typ! x) (cex-sin-typ! x)
          (cex-cc-typ! (list '* +i x)) (cex-cc-typ! (list '* cex-mi x)) (cex-cc-typ! (list '- (list '* +i x)))
          (cex-exp-typ! (list '* +i x)) (cex-exp-typ! (list '* cex-mi x)) (cex-exp-typ! (list '- (list '* +i x)))
          (cex-beta!
            (lambda ()
              (subst (dk-fact! trig-exp x))
              (cex-trig-norm! x)
              (let ((g (dk-goal)))
                (dk-have! (list '= (cadr g) (caddr g)) (lambda () (crs)))
                (subst (list '= (cadr g) (caddr g)))
                (qrfl)))))))
    (dk-fact! 'diff-on-transfer-ptwise-eq 'CC-NORMED-FIELD 'CC f comb x0 v)
    (dk-have! (list '= value v)
      (lambda ()
        (subst (dk-fact! value-exp x0))
        (cex-trig-norm! x0)
        (crs)))
    (subst (list '= value v))
    (ass)))
(sp (make-wff (list 'FORALL 'cexz_ (list 'IMPLIES '(IN cexz_ CC)
  (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'CC cex-cosf 'cexz_ '(- (CC-SIN cexz_)))))))
(dk-peel!)
