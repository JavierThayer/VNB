;;; ca51-cc.scm -- Lemma 5.1 for CC and its open subsets (CA-51, 2026-10-26).
;;; Destination: theorem-library/ca51-cc.scm, library complex-analysis.
;;;
;;;   cc-ms-locally-compact            CC is locally compact (closed balls are compact)
;;;   cc-open-locally-compact          so is every open subset u of CC (open-subspace-locally-compact)
;;;   cc-open-separable                every nonempty open u is separable (the dense sequence of
;;;                                    cc-exhaust-dense-seqs / cc-exhaust-dense-in-u)
;;;   cc-ms-separable                  CC is separable
;;;   cc-has-compact-exhaustion        Lemma 5.1 for CC                 } the general theorem
;;;   cc-open-has-compact-exhaustion   Lemma 5.1 for a nonempty open u  } specialised
;;;   cc-exhaust-is-compact-exhaustion the existing sequence K_n = CC-EXHAUST(u, n) IS an exhaustive
;;;                                    sequence of compact sets of the subspace u in the sense of
;;;                                    IS-COMPACT-EXHAUSTION (uniform radius 1/(n+1) - 1/(n+2))
;;;
;;; NONEMPTINESS.  IS-SEPARABLE asks for a dense SEQUENCE, and FUN(NN, EMPTY-SET) is empty, so the
;;; empty open set is not IS-SEPARABLE (structure-library/separable.scm records the same encoding
;;; fact).  The separability statements, and the exhaustion obtained through the general theorem,
;;; carry a point p of u; cc-exhaust-is-compact-exhaustion does not need one.
;;;
;;; Library: complex-analysis.  Load window: after theorem-library/ca51-exhaustion and
;;; theorem-library/ca5-function-spaces (cc-exhaust-*, cc-ms-ball-membership,
;;; cc-exhaust-dense-seqs, cc-exhaust-dense-in-u); nothing cites it.  Helper prefix lx6-.
;;; ======================================================================
(define (lx6-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC)))
      (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (lx6-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-type! t 'CC)))
(define (lx6-mag! t)
  (lx6-cc! t)
  (if (not (dk-asm? (list 'IN (list 'magnitude t) 'RR))) (fact 'cc-magnitude-closed t)))

;;; ======================================================================
;;; (1) local compactness
;;; ======================================================================
(sp (make-wff '(IS-LOCALLY-COMPACT CC-MS)))
(fact 'cc-is-metric-space)
(lx6-pts-cc!)
(fact 'rr-one-in)
(let ((li (dk-cite! 'is-locally-compact 'CC-MS)))
  (dk-have! (caddr li)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (let ((a (dk-di-var!)))
                (dk-rewrite-h! (list 'IN a '(PTS CC-MS)) '(PTS CC-MS) 'CC)
                (dk-cite! 'cc-closed-ball-compact a 1)
                (let ((pi (dk-cite! 'pos-rr 1)))
                  (dk-have! (caddr pi)
                    (lambda ()
                      (dk-conj-close!
                        (lambda ()
                          (let ((g (dk-goal)))
                            (cond ((dk-asm? g) (ass))
                                  ((dk-head-is? g '<=) (dk-ineq!))
                                  (#t (di) (dk-absurd! '(= 0 1)))))))))
                  (dk-have! '(POS-RR 1) (lambda () (prop))))
                (ew 1)
                (dk-conj-close!)))))))
  (prop))
(qed 'cc-ms-locally-compact)
(topic! 'cc-ms-locally-compact 'analysis)

(sp (make-wff '(FORALL u (IMPLIES (IS-OPEN CC-MS u) (IS-LOCALLY-COMPACT (SUBSPACE-MS CC-MS u))))))
(dk-peel!)
(fact 'cc-ms-locally-compact)
(dk-cite! 'open-subspace-locally-compact 'CC-MS 'u)
(ass)
(qed 'cc-open-locally-compact)
(topic! 'cc-open-locally-compact 'analysis)

;;; ======================================================================
;;; (2) separability
;;; ======================================================================
(sp (make-wff '(FORALL u (IMPLIES (IS-OPEN CC-MS u)
  (FORALL p (IMPLIES (IN p u) (IS-SEPARABLE (SUBSPACE-MS CC-MS u))))))))
(dk-peel!)
(dk-cite! 'cc-ms-open-iff 'u)
(dk-have! '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u) (lambda () (prop)))
(let* ((n0 (dk-skolem! (dk-cite! 'cc-exhaust-dense-seqs 'u 'p)))
       (dsq (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm 'IS-DENSE-SEQ))) "the dense sequences")))
       (_ (dk-split-all!))
       (r (dk-cite! 'cc-exhaust-dense-in-u 'u n0 dsq)))
  (dk-cite! 'dense-seq-separable '(SUBSPACE-MS CC-MS u) (caddr r))
  (ass))
(qed 'cc-open-separable)
(topic! 'cc-open-separable 'analysis)

(sp (make-wff '(IS-SEPARABLE CC-MS)))
(fact 'cc-is-metric-space)
(lx6-pts-cc!)
(fact 'cc-zero-in)
(dk-cite! 'carrier-is-open 'CC-MS)
(dk-rewrite-h! '(IS-OPEN CC-MS (PTS CC-MS)) '(PTS CC-MS) 'CC)
(dk-cite! 'cc-open-separable 'CC 0)
(dk-rewrite-h! '(IS-SEPARABLE (SUBSPACE-MS CC-MS CC)) 'CC '(PTS CC-MS))
(dk-cite! 'separable-of-full-subspace 'CC-MS)
(ass)
(qed 'cc-ms-separable)
(topic! 'cc-ms-separable 'analysis)

;;; ======================================================================
;;; (3) the general theorem, specialised
;;; ======================================================================
(sp (make-wff '(FORSOME kx (IS-COMPACT-EXHAUSTION CC-MS kx))))
(fact 'cc-ms-locally-compact)
(fact 'cc-ms-separable)
(dk-cite! 'locally-compact-separable-exhaustion 'CC-MS)
(ass)
(qed 'cc-has-compact-exhaustion)
(topic! 'cc-has-compact-exhaustion 'analysis)

(sp (make-wff '(FORALL u (IMPLIES (IS-OPEN CC-MS u)
  (FORALL p (IMPLIES (IN p u) (FORSOME kx (IS-COMPACT-EXHAUSTION (SUBSPACE-MS CC-MS u) kx))))))))
(dk-peel!)
(dk-cite! 'cc-open-locally-compact 'u)
(dk-cite! 'cc-open-separable 'u 'p)
(dk-cite! 'locally-compact-separable-exhaustion '(SUBSPACE-MS CC-MS u))
(ass)
(qed 'cc-open-has-compact-exhaustion)
(topic! 'cc-open-has-compact-exhaustion 'analysis)

;;; ======================================================================
;;; (4) the existing exhaustion K_n = CC-EXHAUST(u, n) is an exhaustive sequence of
;;;     compact sets of the subspace u, in the sense of IS-COMPACT-EXHAUSTION
;;; ======================================================================
(define lx6-sub '(SUBSPACE-MS CC-MS u))
(define lx6-K '(VNB-LAMBDA cxn_ NN (CC-EXHAUST u cxn_)))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(IS-OPEN CC-MS u)
  (list 'IS-COMPACT-EXHAUSTION lx6-sub lx6-K)))))
(dk-peel!)
(fact 'cc-is-metric-space)
(lx6-pts-cc!)
(fact 'cc-is-set)
(fact 'nn-one-in)
(dk-cite! 'cc-ms-open-iff 'u)
(dk-have! '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u) (lambda () (prop)))
(fact 'cc-open-subset-cc 'u)
(dk-have! '(SUBSET u (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
(fact 'subclass-of-set-is-set 'u 'CC)
(fact 'subspace-is-metric-space 'CC-MS 'u)
(dk-cite! 'subspace-pts 'CC-MS 'u)
;; CC-EXHAUST(u, n) is a set and a subset of u (n in NN in context)
(define (lx6-kn! n)
  (let ((kn (list 'CC-EXHAUST 'u n)))
    (if (not (dk-asm? (list 'IN kn 'SET)))
        (begin
          (dk-cite! 'cc-exhaust-subset 'u n)
          (let ((eq (dk-cite! 'cc-exhaust-unfold 'u n)))
            (dk-have! (list 'IN kn 'SET)
              (lambda () (subst eq) (dk-sethood! (caddr eq)))))))
    kn))
;; y in CC-EXHAUST(u, n): land y in CC, |y| <= n, B(y, 1/(n+1)) subset u
(define (lx6-open-k! n y)
  (let ((iff (dk-cite! 'cc-exhaust-membership 'u n y)))
    (dk-have! (caddr iff) (lambda () (prop)))
    (dk-split-all! (list (caddr iff)))))
(let ((ci (dk-cite! 'is-compact-exhaustion lx6-sub lx6-K)))
  (dk-have! (caddr ci)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-asm? g) (ass))
              ;; the typing
              ((dk-head-is? g 'IN)
               (dk-lam-type!
                 (lambda ()
                   (let* ((n (dk-di-var!))
                          (kn (lx6-kn! n)))
                     (subst (list '== (list 'PTS lx6-sub) 'u))
                     (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ kn) '(IN z_ u)))
                       (lambda ()
                         (let ((z (dk-di-var!)))
                           (fact 'subset-mem-fwd kn 'u z)
                           (ass))))
                     (dk-cite! 'power-mem-intro 'u kn)
                     (ass)))))
              ;; compactness
              ((and (dk-head-is? g 'FORALL) (dk-contains? g 'IS-COMPACT) (not (dk-contains? g 'SUBSET)))
               (let* ((n (dk-di-var!))
                      (kn (lx6-kn! n)))
                 (dk-lam-b!)
                 (dk-cite! 'cc-exhaust-compact 'u n)
                 (let ((ci2 (dk-cite! 'compact-subset-of-subspace-iff 'CC-MS 'u kn)))
                   (dk-only! ci2 (list 'IS-COMPACT (list 'SUBSPACE-MS 'CC-MS kn)))
                   (prop))))
              ;; the uniform interior radius 1/(n+1) - 1/(n+2)
              ((dk-contains? g 'BALL)
               (let* ((n (dk-di-var!))
                      (n1 (list '+ n 1))
                      (ra (list 'recip n1))
                      (rb (list 'recip (list '+ n1 1)))
                      (e (list '- ra rb)))
                 (dk-have! (list 'IN n1 'NN) (lambda () (dk-have! (list 'AND (list 'IN n 'NN) '(IN 1 NN)) (lambda () (dk-conj-close!))) (fact 'nn-add-closed n 1) (ass)))
                 (dk-lam-b!)
                 (dk-cite! 'nn-recip-succ-gap-pos n)
                 (dk-split-all! (list (dk-cite! 'cc-exhaust-radius-decrease n)))
                 (dk-cite! 'nn-recip-succ-pos n) (fact 'rr-pos-rr-in-rr ra) (fact 'rr-lt-of-pos-rr ra)
                 (dk-cite! 'nn-recip-succ-pos n1) (fact 'rr-pos-rr-in-rr rb) (fact 'rr-lt-of-pos-rr rb)
                 (fact 'rr-pos-rr-in-rr e)
                 (fact 'nn-in-rr n)
                 (ew e)
                 (dk-conj-close!
                   (lambda ()
                     (if (dk-asm? (dk-goal))
                         (ass)
                         (let* ((y (dk-di-var!))
                                (_k (lx6-kn! n))
                                (_1 (fact 'subset-mem-fwd (list 'CC-EXHAUST 'u n) 'u y))
                                (_2 (lx6-open-k! n y))
                                (z (subset-by-element!))
                                (bi (dk-cite! 'ball-membership lx6-sub y e z)))
                           (dk-have! (caddr bi) (lambda () (prop)))
                           (dk-split-all! (list (caddr bi)))
                           (dk-rewrite-h! (list 'IN z (list 'PTS lx6-sub)) (list 'PTS lx6-sub) 'u)
                           (fact 'subset-mem-fwd 'u 'CC z)
                           (let* ((dsub (list (list 'DIST lx6-sub) y z))
                                  (dcc (list '(DIST CC-MS) y z))
                                  (myz (list 'magnitude (list '- y z)))
                                  (mzy (list 'magnitude (list '- z y))))
                             (dk-cite! 'subspace-dist 'CC-MS 'u y z)
                             (dk-cite! 'cc-ms-dist y z)
                             (lx6-mag! (list '- y z)) (lx6-mag! (list '- z y)) (lx6-mag! y) (lx6-mag! z)
                             (dk-cite! 'cc-magnitude-sub-sym z y)
                             (dk-rewrite-h! (list '<= dsub e) dsub dcc)
                             (dk-rewrite-h! (list '<= dcc e) dcc myz)
                             (dk-rewrite-h! (list 'NOT (list '= dsub e)) dsub dcc)
                             (dk-rewrite-h! (list 'NOT (list '= dcc e)) dcc myz)
                             (dk-have! (list 'AND (list '<= myz e) (list 'NOT (list '= myz e))) (lambda () (dk-conj-close!)))
                             (fact 'rr-le-ne-lt myz e)
                             (dk-have! (list '< mzy e) (lambda () (dk-ineq! (list '< myz e) (list '= mzy myz))))
                             ;; z in CC-EXHAUST(u, n + 1)
                             (let ((iff (dk-cite! 'cc-exhaust-membership 'u n1 z)))
                               (dk-have! (caddr iff)
                                 (lambda ()
                                   (dk-conj-close!
                                     (lambda ()
                                       (let ((g2 (dk-goal)))
                                         (cond
                                           ((dk-asm? g2) (ass))
                                           ((dk-head-is? g2 '<=)
                                            ;; |z| <= |y| + |z - y| < n + e <= n + 1
                                            (dk-have! (list '= (list '+ y (list '- z y)) z) (lambda () (crs)))
                                            (dk-have! (list 'AND (list 'IN y 'CC) (list 'IN (list '- z y) 'CC)) (lambda () (dk-conj-close!)))
                                            (fact 'cc-magnitude-triangle y (list '- z y))
                                            (dk-rewrite-h! (list '<= (list 'magnitude (list '+ y (list '- z y))) (list '+ (list 'magnitude y) mzy))
                                                           (list '+ y (list '- z y)) z)
                                            (dk-ineq! (list '<= (list 'magnitude z) (list '+ (list 'magnitude y) mzy))
                                                      (list '<= (list 'magnitude y) n)
                                                      (list '< mzy e)
                                                      (list '<= ra 1)
                                                      (list '< 0 rb)))
                                           (#t
                                            ;; B(z, 1/(n+2)) subset B(y, 1/(n+1)) subset u
                                            (let ((bsub (dk-pick (lambda (fm) (and (dk-head-is? fm 'SUBSET) (equal? (cadr fm) (list 'BALL 'CC-MS y ra)))) "the ball of y")))
                                              (dk-have! (list 'SUBSET (list 'BALL 'CC-MS z rb) (list 'BALL 'CC-MS y ra))
                                                (lambda ()
                                                  (let* ((w (subset-by-element!))
                                                         (b1 (dk-cite! 'cc-ms-ball-membership z rb w)))
                                                    (dk-have! (caddr b1) (lambda () (prop)))
                                                    (dk-split-all! (list (caddr b1)))
                                                    (lx6-mag! (list '- w z)) (lx6-mag! (list '- w y))
                                                    (dk-cite! 'cc-magnitude-sub-chain w z y)
                                                    (dk-have! (list '< (list 'magnitude (list '- w y)) ra)
                                                      (lambda () (dk-ineq! (list '<= (list 'magnitude (list '- w y)) (list '+ (list 'magnitude (list '- w z)) mzy))
                                                                           (list '< (list 'magnitude (list '- w z)) rb)
                                                                           (list '< mzy e))))
                                                    (dk-cite! 'cc-ms-ball-membership y ra w)
                                                    (prop))))
                                              (fact 'subset-trans (list 'BALL 'CC-MS z rb) (list 'BALL 'CC-MS y ra) 'u)
                                              (ass)))))))))
                               (prop)))))))))
              ;; the covering
              ((and (dk-head-is? g 'FORALL) (not (dk-contains? g 'SUBSET)))
               (let* ((x (dk-di-var!)))
                 (dk-rewrite-h! (list 'IN x (list 'PTS lx6-sub)) (list 'PTS lx6-sub) 'u)
                 (let ((n (dk-skolem! (dk-cite! 'cc-exhaust-covers 'u x))))
                   (dk-split-all!)
                   (ew n)
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-asm? (dk-goal))
                           (ass)
                           (begin (lx6-kn! n) (if (not (dk-lam-b!)) (ass)))))))))
              ;; the exhaustion
              (#t
               (let* ((landed (dk-peel!))
                      (a (cadr (car (filter (dk-head? 'SUBSET) landed)))))
                 (dk-rewrite-h! (list 'SUBSET a (list 'PTS lx6-sub)) (list 'PTS lx6-sub) 'u)
                 (let ((ci2 (dk-cite! 'compact-subset-of-subspace-iff 'CC-MS 'u a)))
                   (dk-have! (list 'IS-COMPACT (list 'SUBSPACE-MS 'CC-MS a)) (lambda () (prop))))
                 (let ((n (dk-skolem! (dk-cite! 'cc-exhaust-exhaustive 'u a))))
                   (dk-split-all!)
                   (ew n)
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-asm? (dk-goal))
                           (ass)
                           (begin (lx6-kn! n) (if (not (dk-lam-b!)) (ass)))))))))))))))
  (prop))
(qed 'cc-exhaust-is-compact-exhaustion)
(topic! 'cc-exhaust-is-compact-exhaustion 'analysis)
