;;; sxt.scm -- topological-vector-space.pdf Lemma 4.20: a seminorm p on a subspace E of F, dominated by a
;;; seminorm q of F, extends to a seminorm p~ of F with p~ <= q, namely
;;;     p~(y) = inf { p(v) + q(w) : v in E, w in F, y = v + w }.
;;; Agent DUAL-FIX, 2026-10-26.  DESTINATION: theorem-library/tvs-seminorm-extension.scm.  Library: analysis.
;;; Helper prefix: sxt-.  Needs: structure-library/seminorm-extension (sxt-vocab.scm here), the INF
;;; vocabulary and rr-inf-is-glb (RA-BASICS), theorem-library/tvs-minkowski (the real-module laws
;;; rmod-* and the real lemmas mink-rr-*) and theorem-library/dual-nvs (dual-rr-pos-of-nonneg-nonzero).
;;;
;;; As in tvs-minkowski the epsilons of the notes are replaced by greatest-lower-bound steps: an element
;;; of S(x) plus an element of S(y) dominates an element of S(x + y), so p~(x + y) - t is a lower bound of
;;; S(x) for t in S(y), and so on.  Homogeneity: |lam| S(x) is dominated elementwise by S(lam x), which
;;; gives p~(lam x) <= |lam| p~(x) for every real lam, and the reverse comes from lam^-1.

(define (sxt-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; SXT OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (sxt-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    c))
(define (sxt-eq! a b)
  (let ((e (list '= a b)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (crs))))
    e))
(define (sxt-subst-rev! e) (subst (list '= (caddr e) (cadr e))))
(define sxt-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define sxt-V '(VEC m))
(define sxt-z '(VZERO m))
(define (sxt-act r x) (list '(ACT m) r x))
(define (sxt-add x y) (list '(VADD m) x y))
(define sxt-rmod (list '(IS-MODULE m) (list '= '(SCAL m) sxt-ring)))

(define (sxt-real! t)
  (let ((ty (list 'IN t 'RR)))
    (cond ((dk-asm? ty) ty)
          ((and (number? t) (exact? t)) (dk-have! ty (lambda () (arith))) ty)
          ((and (pair? t) (= (length t) 2) (eq? (car t) 'p)) (sxt-ptype! (cadr t)) ty)
          ((and (pair? t) (= (length t) 2) (eq? (car t) 'q)) (sxt-vtype! (cadr t))
           (dk-cite! 'fun-apply-type-c 'q sxt-V 'RR (cadr t)) ty)
          ((dk-head-is? t 'abs) (sxt-real! (cadr t)) (dk-cite! 'rr-abs-closed (cadr t)) ty)
          ((dk-head-is? t 'recip) (sxt-real! (cadr t))
           (sxt-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (dk-cite! 'rr-recip-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 2)) (sxt-real! (cadr t)) (dk-cite! 'rr-neg-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 3))
           (sxt-real! (cadr t)) (sxt-real! (caddr t)) (dk-cite! 'rr-sub-in-rr (cadr t) (caddr t)) ty)
          ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
           (sxt-real! (cadr t)) (sxt-real! (caddr t))
           (sxt-and! (list 'IN (cadr t) 'RR) (list 'IN (caddr t) 'RR))
           (dk-cite! (if (eq? (car t) '+) 'rr-add-closed 'rr-mul-closed) (cadr t) (caddr t))
           ty)
          (#t (dk-type! t) ty))))
(define (sxt-vtype! t)
  (let ((ty (list 'IN t sxt-V)))
    (cond ((dk-asm? ty) ty)
          ((equal? t sxt-z) (dk-cite! 'module-vzero-in 'm) ty)
          ((and (pair? t) (equal? (car t) '(ACT m)))
           (sxt-real! (cadr t)) (sxt-vtype! (caddr t)) (dk-cite! 'rmod-act-type 'm (cadr t) (caddr t)) ty)
          ((and (pair? t) (equal? (car t) '(VADD m)))
           (sxt-vtype! (cadr t)) (sxt-vtype! (caddr t)) (dk-cite! 'module-vadd-type 'm (cadr t) (caddr t)) ty)
          ((and (pair? t) (equal? (car t) '(VNEG m)))
           (sxt-vtype! (cadr t)) (dk-cite! 'module-vneg-type 'm (cadr t)) ty)
          ((dk-asm? (list 'IN t 's)) (dk-cite! 'subset-mem-fwd 's sxt-V t) ty)
          (#t (error "sxt-vtype!: no typing for" t)))))
;; (IN t s) for a subspace term
(define (sxt-stype! t)
  (let ((ty (list 'IN t 's)))
    (cond ((dk-asm? ty) ty)
          ((equal? t sxt-z) (dk-project! (list 'IN sxt-z 's) 'is-submodule '(IS-SUBMODULE m s)) ty)
          ((and (pair? t) (equal? (car t) '(VADD m)))
           (sxt-stype! (cadr t)) (sxt-stype! (caddr t))
           (dk-apply! (sxt-sub-clause 'vadd) (cadr t) (caddr t)) ty)
          ((and (pair? t) (equal? (car t) '(VNEG m)))
           (sxt-stype! (cadr t)) (dk-apply! (sxt-sub-clause 'vneg) (cadr t)) ty)
          ((and (pair? t) (equal? (car t) '(ACT m)))
           (sxt-real! (cadr t)) (sxt-stype! (caddr t))
           (sxt-carr! (cadr t))
           (dk-apply! (sxt-sub-clause 'act) (cadr t) (caddr t)) ty)
          (#t (error "sxt-stype!: no typing for" t)))))
(define (sxt-sub-clause k)
  (let ((f (case k
             ((vadd) '(FORALL x_ (IMPLIES (IN x_ s) (FORALL y_ (IMPLIES (IN y_ s) (IN ((VADD m) x_ y_) s))))))
             ((vneg) '(FORALL x_ (IMPLIES (IN x_ s) (IN ((VNEG m) x_) s))))
             ((act)  '(FORALL r_ (IMPLIES (IN r_ (CARR (SCAL m))) (FORALL x_ (IMPLIES (IN x_ s) (IN ((ACT m) r_ x_) s)))))))))
    (if (not (dk-asm? f)) (dk-project! f 'is-submodule '(IS-SUBMODULE m s)))
    f))
(define (sxt-carr! r)
  (let ((ty (list 'IN r '(CARR (SCAL m)))))
    (if (not (dk-asm? ty))
        (dk-have! ty (lambda () (subst (list '= '(SCAL m) sxt-ring)) (mac 'rr-scalar-ring-carr) (ass))))
    ty))
(define (sxt-ptype! v)   ; (IN (p v) RR) for v in s
  (sxt-stype! v)
  (if (not (dk-asm? '(IN p (FUN s RR))))
      (dk-project! '(IN p (FUN s RR)) 'is-seminorm-on '(IS-SEMINORM-ON m s p)))
  (dk-cite! 'fun-apply-type-c 'p 's 'RR v))

;;; =====================================================================
;;; (1) THE ABELIAN-GROUP LAWS OF A MODULE, AND p, q AT ZERO
;;; =====================================================================
(define (sxt-law! pred args)
  (let ((h (dk-project! pred 'is-module '(IS-MODULE m))))
    (dk-have! (dk-goal)
      (lambda ()
        (mac-h (car pred) h)
        (let ((u (find-first (lambda (f) (dk-head-is? f 'FORALL)) (dk-asms))))
          (let ((r (apply dk-apply! u args)))
            (if (dk-head-is? r 'AND) (dk-split! r))
            (ass)))))))
(sp (make-wff (forall-guarded '(m x y z) (list '(IS-MODULE m) (list 'IN 'x sxt-V) (list 'IN 'y sxt-V) (list 'IN 'z sxt-V))
   (list '= (sxt-add (sxt-add 'x 'y) 'z) (sxt-add 'x (sxt-add 'y 'z))))))
(dk-peel!)
(sxt-law! (list 'is-associative '(VADD m) sxt-V) '(x y z))
(sxt-qed! 'rmod-vadd-assoc)
(sp (make-wff (forall-guarded '(m x y) (list '(IS-MODULE m) (list 'IN 'x sxt-V) (list 'IN 'y sxt-V))
   (list '= (sxt-add 'x 'y) (sxt-add 'y 'x)))))
(dk-peel!)
(sxt-law! (list 'is-commutative '(VADD m) sxt-V) '(x y))
(sxt-qed! 'rmod-vadd-comm)
(sp (make-wff (forall-guarded '(m x) (list '(IS-MODULE m) (list 'IN 'x sxt-V))
   (list '= (sxt-add 'x sxt-z) 'x))))
(dk-peel!)
(sxt-law! (list 'is-identity '(VADD m) sxt-z sxt-V) '(x))
(sxt-qed! 'rmod-vzero-right)
(sp (make-wff (forall-guarded '(m x) (list '(IS-MODULE m) (list 'IN 'x sxt-V))
   (list '= (sxt-add '((VNEG m) x) 'x) sxt-z))))
(dk-peel!)
(sxt-law! (list 'has-inverses '(VADD m) sxt-z '(VNEG m) sxt-V) '(x))
(sxt-qed! 'rmod-vneg-left)

;; (a + b) + (c + d) = (a + c) + (b + d)
(sp (make-wff (forall-guarded '(m a b c d) (list '(IS-MODULE m) (list 'IN 'a sxt-V) (list 'IN 'b sxt-V) (list 'IN 'c sxt-V) (list 'IN 'd sxt-V))
   (list '= (sxt-add (sxt-add 'a 'b) (sxt-add 'c 'd)) (sxt-add (sxt-add 'a 'c) (sxt-add 'b 'd))))))
(dk-peel!)
(for-each sxt-vtype! (list (sxt-add 'c 'd) (sxt-add 'b 'd) (sxt-add 'b (sxt-add 'c 'd)) (sxt-add 'c (sxt-add 'b 'd))
                           (sxt-add 'b 'c) (sxt-add 'c 'b)))
(subst (dk-cite! 'rmod-vadd-assoc 'm 'a 'b (sxt-add 'c 'd)))
(subst (dk-cite! 'rmod-vadd-assoc 'm 'a 'c (sxt-add 'b 'd)))
(sxt-subst-rev! (dk-cite! 'rmod-vadd-assoc 'm 'b 'c 'd))
(sxt-subst-rev! (dk-cite! 'rmod-vadd-assoc 'm 'c 'b 'd))
(subst (dk-cite! 'rmod-vadd-comm 'm 'b 'c))
(sxt-vtype! (sxt-add 'a (sxt-add (sxt-add 'c 'b) 'd)))
(rfl)
(sxt-qed! 'rmod-vadd-swap)

;; (-v) + (v + w) = w
(sp (make-wff (forall-guarded '(m v w) (list '(IS-MODULE m) (list 'IN 'v sxt-V) (list 'IN 'w sxt-V))
   (list '= (sxt-add '((VNEG m) v) (sxt-add 'v 'w)) 'w))))
(dk-peel!)
(sxt-vtype! '((VNEG m) v))
(sxt-subst-rev! (dk-cite! 'rmod-vadd-assoc 'm '((VNEG m) v) 'v 'w))
(subst (dk-cite! 'rmod-vneg-left 'm 'v))
(subst (dk-cite! 'rmod-vzero-left 'm 'w))
(rfl)
(sxt-qed! 'rmod-vneg-cancel)

;; recip(c).(c.x) = x for c /= 0
(sp (make-wff (forall-guarded '(m c x) (append sxt-rmod (list '(IN c RR) '(NOT (= c 0)) (list 'IN 'x sxt-V)))
                              (list '= (sxt-act '(recip c) (sxt-act 'c 'x)) 'x))))
(dk-peel!)
(sxt-and! '(IN c RR) '(NOT (= c 0)))
(dk-cite! 'rr-recip-closed 'c)
(dk-cite! 'rr-recip-inverse 'c)
(let ((q (dk-name! '(recip c))))
  (dk-have! (list '= (list '* 'c q) 1) (lambda () (subst (list '= q '(recip c))) (ass)))
  (subst (list '= '(recip c) q))
  (sxt-subst-rev! (dk-cite! 'rmod-act-mul 'm q 'c 'x))
  (subst (sxt-eq! (list '* q 'c) (list '* 'c q)))
  (subst (list '= (list '* 'c q) 1))
  (subst (dk-cite! 'rmod-act-one 'm 'x))
  (rfl))
(sxt-qed! 'rmod-act-recip-cancel-nz)

;;; =====================================================================
;;; (2) THE TWO SEMINORMS
;;; =====================================================================
(define sxt-qsn '(IS-SEMINORM RR-NORMED-FIELD m q))
(define sxt-psn '(IS-SEMINORM-ON m s p))
(define (sxt-qparts!)
  (if (not (dk-asm? (list 'IN 'q (list 'FUN sxt-V 'RR))))
      (dk-project! (list 'IN 'q (list 'FUN sxt-V 'RR)) 'is-seminorm sxt-qsn)))

(sp (make-wff (forall-guarded '(m q x) (list sxt-qsn (list 'IN 'x sxt-V)) '(<= 0 (q x)))))
(dk-peel!)
(dk-apply! (dk-project! '(FORALL x (IMPLIES (IN x (VEC m)) (<= 0 (q x)))) 'is-seminorm sxt-qsn) 'x)
(ass)
(sxt-qed! 'sxt-q-nonneg)

(sp (make-wff (forall-guarded '(m q x y) (list sxt-qsn (list 'IN 'x sxt-V) (list 'IN 'y sxt-V))
                              (list '<= (list 'q (sxt-add 'x 'y)) '(+ (q x) (q y))))))
(dk-peel!)
(dk-apply! (dk-project! '(FORALL x (IMPLIES (IN x (VEC m)) (FORALL y (IMPLIES (IN y (VEC m))
                          (<= (q ((VADD m) x y)) (+ (q x) (q y)))))))
                        'is-seminorm sxt-qsn) 'x 'y)
(ass)
(sxt-qed! 'sxt-q-subadd)

(sp (make-wff (forall-guarded '(m q lm x) (append sxt-rmod (list sxt-qsn '(IN lm RR) (list 'IN 'x sxt-V)))
                              (list '= (list 'q (sxt-act 'lm 'x)) '(* (abs lm) (q x))))))
(dk-peel!)
(sxt-carr! 'lm)
(let ((h (dk-apply! (dk-project! '(FORALL lam (IMPLIES (IN lam (CARR (SCAL m))) (FORALL x (IMPLIES (IN x (VEC m))
                                    (= (q ((ACT m) lam x)) (* ((FNRM RR-NORMED-FIELD) lam) (q x)))))))
                                 'is-seminorm sxt-qsn) 'lm 'x)))
  (dk-cite! 'rr-nf-fnrm-apply 'lm)
  (dk-rewrite-h! h '((FNRM RR-NORMED-FIELD) lm) '(abs lm))
  (ass))
(sxt-qed! 'sxt-q-homog)

(sp (make-wff (forall-guarded '(m q) (append sxt-rmod (list sxt-qsn)) (list '= (list 'q sxt-z) 0))))
(dk-peel!)
(sxt-vtype! sxt-z)
(sxt-qparts!)
(sxt-real! 0)
(let* ((e (dk-cite! 'rmod-act-zero 'm sxt-z))
       (h (dk-cite! 'sxt-q-homog 'm 'q 0 sxt-z))
       (h2 (dk-rewrite-h! h (sxt-act 0 sxt-z) sxt-z)))
  (fact 'rr-abs-zero-value)
  (let ((h3 (dk-rewrite-h! h2 '(abs 0) 0)))
    (sxt-real! (list 'q sxt-z))
    (dk-ineq! h3 (list 'IN (list 'q sxt-z) 'RR))))
(sxt-qed! 'sxt-q-zero)

(sp (make-wff (forall-guarded '(m s p x) (list sxt-psn '(IN x s)) '(<= 0 (p x)))))
(dk-peel!)
(dk-apply! (dk-project! '(FORALL snx_ (IMPLIES (IN snx_ s) (<= 0 (p snx_)))) 'is-seminorm-on sxt-psn) 'x)
(ass)
(sxt-qed! 'sxt-p-nonneg)

(sp (make-wff (forall-guarded '(m s p x y) (list sxt-psn '(IN x s) '(IN y s))
                              (list '<= (list 'p (sxt-add 'x 'y)) '(+ (p x) (p y))))))
(dk-peel!)
(dk-apply! (dk-project! '(FORALL snx_ (IMPLIES (IN snx_ s) (FORALL sny_ (IMPLIES (IN sny_ s)
                          (<= (p ((VADD m) snx_ sny_)) (+ (p snx_) (p sny_)))))))
                        'is-seminorm-on sxt-psn) 'x 'y)
(ass)
(sxt-qed! 'sxt-p-subadd)

(sp (make-wff (forall-guarded '(m s p lm x) (list sxt-psn '(IN lm RR) '(IN x s))
                              (list '= (list 'p (sxt-act 'lm 'x)) '(* (abs lm) (p x))))))
(dk-peel!)
(dk-apply! (dk-project! '(FORALL snl_ (IMPLIES (IN snl_ RR) (FORALL snx_ (IMPLIES (IN snx_ s)
                          (= (p ((ACT m) snl_ snx_)) (* (abs snl_) (p snx_)))))))
                        'is-seminorm-on sxt-psn) 'lm 'x)
(ass)
(sxt-qed! 'sxt-p-homog)

(sp (make-wff (forall-guarded '(m s p) (append sxt-rmod (list '(IS-SUBMODULE m s) sxt-psn)) (list '= (list 'p sxt-z) 0))))
(dk-peel!)
(sxt-stype! sxt-z)
(sxt-vtype! sxt-z)
(sxt-real! 0)
(let* ((e (dk-cite! 'rmod-act-zero 'm sxt-z))
       (h (dk-cite! 'sxt-p-homog 'm 's 'p 0 sxt-z))
       (h2 (dk-rewrite-h! h (sxt-act 0 sxt-z) sxt-z)))
  (fact 'rr-abs-zero-value)
  (let ((h3 (dk-rewrite-h! h2 '(abs 0) 0)))
    (sxt-real! (list 'p sxt-z))
    (dk-ineq! h3 (list 'IN (list 'p sxt-z) 'RR))))
(sxt-qed! 'sxt-p-zero)

;;; =====================================================================
;;; (3) THE SETS S(y) = { p(v) + q(w) : y = v + w, v in s }
;;; =====================================================================
(define sxt-H (append sxt-rmod (list '(IS-SUBMODULE m s) sxt-psn sxt-qsn '(FORALL dmx_ (IMPLIES (IN dmx_ s) (<= (p dmx_) (q dmx_)))))))
(define (sxt-st vars guards body) (forall-guarded (append '(m s p q) vars) (append sxt-H guards) body))
(define (sxt-S y) (list 'SEMINORM-EXT-SET 'm 's 'p 'q y))
(define (sxt-Sbody y)
  (list 'SEP 'sxt_ 'RR (list 'FORSOME 'sev_ (list 'AND '(IN sev_ s) (list 'FORSOME 'sew_ (list 'AND '(IN sew_ (VEC m))
     (list 'AND (list '= y '((VADD m) sev_ sew_)) '(= sxt_ (+ (p sev_) (q sew_))))))))))
(define (sxt-I y) (list 'INF (sxt-S y)))

(sp (make-wff (forall-guarded '(m s p q y) '() (list '== (sxt-S 'y) (sxt-Sbody 'y)))))
(dk-peel!)
(mac 'SEMINORM-EXT-SET)
(qrfl)
(sxt-qed! 'sxt-set-unfold)

(sp (make-wff (forall-guarded '(m s p q y v w) (list '(IN p (FUN s RR)) '(IN q (FUN (VEC m) RR)) '(IN v s) '(IN w (VEC m))
                                                      (list '= 'y (sxt-add 'v 'w)))
                              (list 'IN '(+ (p v) (q w)) (sxt-S 'y)))))
(dk-peel!)
(dk-cite! 'fun-apply-type-c 'p 's 'RR 'v)
(dk-cite! 'fun-apply-type-c 'q sxt-V 'RR 'w)
(sxt-real! '(+ (p v) (q w)))
(mac 'SEMINORM-EXT-SET)
(in-sep! (lambda () (ass))
         (lambda ()
           (ew 'v)
           (dk-conj-close!
             (lambda ()
               (if (dk-head-is? (dk-goal) 'FORSOME)
                   (begin (ew 'w) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl)))))
                   (ass))))))
(sxt-qed! 'sxt-set-intro)

(sp (make-wff (forall-guarded '(m s p q y t) (list (list 'IN 't (sxt-S 'y)))
   '(AND (IN t RR) (FORSOME sev_ (AND (IN sev_ s) (FORSOME sew_ (AND (IN sew_ (VEC m))
       (AND (= y ((VADD m) sev_ sew_)) (= t (+ (p sev_) (q sew_))))))))))))
(dk-peel!)
(let* ((h (dk-ctx-form (list 'IN 't (sxt-S 'y))))
       (e (dk-cite! 'sxt-set-unfold 'm 's 'p 'q 'y))
       (h2 (dk-rewrite-h! h (sxt-S 'y) (sxt-Sbody 'y))))
  (sep-me h2)
  (dk-split-all!)
  (dk-conj-close! (lambda () (ass))))
(sxt-qed! 'sxt-set-elim)

;; t in S(y): land t in RR and the splitting; return (v . w)
(define (sxt-elim! y t)
  (let ((c (dk-cite! 'sxt-set-elim 'm 's 'p 'q y t)))
    (dk-split! c)
    (let* ((ex (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'sev_) (dk-contains? f t)))
                           (dk-asms)))
           (v (dk-skolem! ex))
           (ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'sew_) (dk-contains? f v)))
                            (dk-asms)))
           (w (dk-skolem! ex2)))
      (cons v w))))

(define (sxt-parts!)
  (sxt-qparts!)
  (if (not (dk-asm? '(IN p (FUN s RR))))
      (dk-project! '(IN p (FUN s RR)) 'is-seminorm-on sxt-psn))
  (if (not (dk-asm? '(SUBSET s (VEC m))))
      (dk-project! '(SUBSET s (VEC m)) 'is-submodule '(IS-SUBMODULE m s))))
;; t = p(v) + q(w) >= 0
(define (sxt-elem-nonneg! y t)
  (let* ((vw (sxt-elim! y t)) (v (car vw)) (w (cdr vw)))
    (sxt-real! (list 'p v)) (sxt-real! (list 'q w))
    (dk-cite! 'sxt-p-nonneg 'm 's 'p v)
    (dk-cite! 'sxt-q-nonneg 'm 'q w)
    vw))

(define (sxt-glb-body s)
  (list 'AND (list 'IN (list 'INF s) 'RR)
   (list 'AND (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ s) (list '<= (list 'INF s) 'lbw_)))
              (list 'FORALL 'lbb_ (list 'IMPLIES '(IN lbb_ RR) (list 'IMPLIES (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ s) '(<= lbb_ lbw_)))
                                                                (list '<= 'lbb_ (list 'INF s))))))))
(sp (make-wff (sxt-st '(z) (list (list 'IN 'z sxt-V)) (sxt-glb-body (sxt-S 'z)))))
(dk-peel!)
(sxt-parts!)
(let ((st (sxt-S 'z)))
  (dk-have! (list 'SUBSET st 'RR)
    (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (dk-split! (dk-cite! 'sxt-set-elim 'm 's 'p 'q 'z w)) (ass))))
  (sxt-stype! sxt-z)
  (dk-cite! 'rmod-vzero-left 'm 'z)
  (dk-have! (list '= 'z (sxt-add sxt-z 'z)) (lambda () (subst (list '= (sxt-add sxt-z 'z) 'z)) (rfl)))
  (dk-cite! 'sxt-set-intro 'm 's 'p 'q 'z sxt-z 'z)
  (dk-have! (list 'FORSOME 'x0 (list 'IN 'x0 st)) (lambda () (ew (list '+ (list 'p sxt-z) '(q z))) (ass)))
  (dk-cite! 'rr-zero-in)
  (dk-have! (list 'FORSOME 'bnd (list 'AND '(IN bnd RR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x st) '(<= bnd x)))))
    (lambda ()
      (ew 0)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let* ((t (dk-di-var!)) (vw (sxt-elem-nonneg! 'z t)))
                (dk-ineq! (list '= t (list '+ (list 'p (car vw)) (list 'q (cdr vw))))
                          (list '<= 0 (list 'p (car vw))) (list '<= 0 (list 'q (cdr vw)))
                          (list 'IN (list 'p (car vw)) 'RR) (list 'IN (list 'q (cdr vw)) 'RR)))
              (ass))))))
  (dk-cite! 'rr-inf-is-glb st)
  (ass))
(sxt-qed! 'sxt-set-glb)

(sp (make-wff (forall-guarded '(m s p q z) (list (list 'IN 'z sxt-V))
   (list '== (list '(SEMINORM-EXT m s p q) 'z) (sxt-I 'z)))))
