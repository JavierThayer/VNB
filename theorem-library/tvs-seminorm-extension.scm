                (list 'IN (list 'p (car vw)) 'RR) (list 'IN (list 'q (cdr vw)) 'RR)))))
(ass)
(sxt-qed! 'sxt-inf-nonneg)

;; t1 in S(x), t2 in S(y)  =>  INF S(x + y) <= t1 + t2
(sp (make-wff (sxt-st '(x y t1 t2) (list (list 'IN 'x sxt-V) (list 'IN 'y sxt-V) (list 'IN 't1 (sxt-S 'x)) (list 'IN 't2 (sxt-S 'y)))
                      (list '<= (sxt-I (sxt-add 'x 'y)) '(+ t1 t2)))))
(dk-peel!)
(sxt-parts!)
(let* ((vw1 (sxt-elim! 'x 't1)) (v1 (car vw1)) (w1 (cdr vw1))
       (vw2 (sxt-elim! 'y 't2)) (v2 (car vw2)) (w2 (cdr vw2))
       (xy (sxt-add 'x 'y)) (vv (sxt-add v1 v2)) (ww (sxt-add w1 w2)))
  (for-each sxt-stype! (list v1 v2 vv))
  (for-each sxt-vtype! (list v1 v2 w1 w2 ww))
  (dk-have! (list '= xy (sxt-add vv ww))
    (lambda ()
      (subst (list '= 'x (sxt-add v1 w1)))
      (subst (list '= 'y (sxt-add v2 w2)))
      (subst (dk-cite! 'rmod-vadd-swap 'm v1 w1 v2 w2))
      (sxt-vtype! (sxt-add vv ww))
      (rfl)))
  (sxt-elem! xy vv ww)
  (let* ((h (sxt-inf-le! xy (list '+ (list 'p vv) (list 'q ww))))
         (hp (dk-cite! 'sxt-p-subadd 'm 's 'p v1 v2))
         (hq (dk-cite! 'sxt-q-subadd 'm 'q w1 w2)))
    (for-each sxt-real! (list (list 'p v1) (list 'p v2) (list 'p vv) (list 'q w1) (list 'q w2) (list 'q ww)))
    (sxt-glb! xy)
    (dk-ineq! h hp hq (list '= 't1 (list '+ (list 'p v1) (list 'q w1))) (list '= 't2 (list '+ (list 'p v2) (list 'q w2)))
              (list 'IN (sxt-I xy) 'RR)
              (list 'IN (list 'p v1) 'RR) (list 'IN (list 'p v2) 'RR) (list 'IN (list 'p vv) 'RR)
              (list 'IN (list 'q w1) 'RR) (list 'IN (list 'q w2) 'RR) (list 'IN (list 'q ww) 'RR))))
(sxt-qed! 'sxt-elem-sum)

(sp (make-wff (sxt-st '(x y) (list (list 'IN 'x sxt-V) (list 'IN 'y sxt-V))
                      (list '<= (sxt-I (sxt-add 'x 'y)) (list '+ (sxt-I 'x) (sxt-I 'y))))))
(dk-peel!)
(sxt-parts!)
(let* ((xy (sxt-add 'x 'y)) (pp (sxt-I xy)) (pa (sxt-I 'x)) (pb (sxt-I 'y)))
  (sxt-glb! xy) (sxt-glb! 'x) (sxt-glb! 'y)
  (dk-have! (list 'FORALL 'sv_ (list 'IMPLIES (list 'IN 'sv_ (sxt-S 'y)) (list '<= (list '- pp 'sv_) pa)))
    (lambda ()
      (let ((sv (dk-di-var!)))
        (dk-split! (dk-cite! 'sxt-set-elim 'm 's 'p 'q 'y sv))
        (sxt-glb-le! 'x (list '- pp sv)
          (lambda (r)
            (dk-split! (dk-cite! 'sxt-set-elim 'm 's 'p 'q 'x r))
            (let ((h (dk-cite! 'sxt-elem-sum 'm 's 'p 'q 'x 'y r sv)))
              (dk-ineq! h (list 'IN pp 'RR) (list 'IN r 'RR) (list 'IN sv 'RR)))))
        (ass))))
  (let ((c1 (dk-ctx-form (list 'FORALL 'sv_ (list 'IMPLIES (list 'IN 'sv_ (sxt-S 'y)) (list '<= (list '- pp 'sv_) pa))))))
    (sxt-glb-le! 'y (list '- pp pa)
      (lambda (sv)
        (let ((h (dk-apply! c1 sv)))
          (dk-split! (dk-cite! 'sxt-set-elim 'm 's 'p 'q 'y sv))
          (dk-ineq! h (list 'IN pp 'RR) (list 'IN pa 'RR) (list 'IN sv 'RR)))))
    (dk-ineq! (list '<= (list '- pp pa) pb) (list 'IN pp 'RR) (list 'IN pa 'RR) (list 'IN pb 'RR))))
(sxt-qed! 'sxt-inf-subadditive)

;;; ---- homogeneity -----------------------------------------------------------

;; t in S(x)  =>  |lam| t in S(lam x)
(sp (make-wff (sxt-st '(x lm t) (list (list 'IN 'x sxt-V) '(IN lm RR) (list 'IN 't (sxt-S 'x)))
                      (list 'IN '(* (abs lm) t) (sxt-S (sxt-act 'lm 'x))))))
(dk-peel!)
(sxt-parts!)
(let* ((vw (sxt-elim! 'x 't)) (v (car vw)) (w (cdr vw))
       (lv (sxt-act 'lm v)) (lw (sxt-act 'lm w)) (lx (sxt-act 'lm 'x)) (a '(abs lm)))
  (sxt-stype! v) (sxt-vtype! v) (sxt-vtype! w)
  (sxt-stype! lv) (sxt-vtype! lw)
  (dk-have! (list '= lx (sxt-add lv lw))
    (lambda ()
      (subst (list '= 'x (sxt-add v w)))
      (subst (dk-cite! 'rmod-act-distrib 'm 'lm v w))
      (sxt-vtype! (sxt-add lv lw))
      (rfl)))
  (let* ((m1 (sxt-elem! lx lv lw))
         (e1 (dk-cite! 'sxt-p-homog 'm 's 'p 'lm v))
         (e2 (dk-cite! 'sxt-q-homog 'm 'q 'lm w))
         (m2 (dk-rewrite-h! m1 (list 'p lv) (list '* a (list 'p v))))
         (m3 (dk-rewrite-h! m2 (list 'q lw) (list '* a (list 'q w))))
         (pv (list 'p v)) (qw (list 'q w)))
    (sxt-real! pv) (sxt-real! qw) (sxt-real! a)
    (let* ((e3 (sxt-eq! (list '+ (list '* a pv) (list '* a qw)) (list '* a (list '+ pv qw))))
           (m4 (dk-rewrite-h! m3 (list '+ (list '* a pv) (list '* a qw)) (list '* a (list '+ pv qw))))
           (m5 (dk-rewrite-h! m4 (list '+ pv qw) 't)))
      (ass))))
(sxt-qed! 'sxt-elem-scale)

(sp (make-wff (sxt-st '(x lm) (list (list 'IN 'x sxt-V) '(IN lm RR))
                      (list '<= (sxt-I (sxt-act 'lm 'x)) (list '* '(abs lm) (sxt-I 'x))))))
(dk-peel!)
(sxt-parts!)
(let* ((lx (sxt-act 'lm 'x)) (ix (sxt-I 'x)) (il (sxt-I lx)) (a '(abs lm)))
  (sxt-vtype! lx)
  (sxt-glb! 'x) (sxt-glb! lx)
  (sxt-real! a)
  (dk-cite! 'rr-abs-nonneg 'lm)
  (dk-cite! 'rr-zero-in)
  (use-em '(= lm 0)
    (lambda ()
      ;; an element t of S(x): 0 t is in S(0 x)
      (sxt-stype! sxt-z)
      (dk-cite! 'rmod-vzero-left 'm 'x)
      (dk-have! (list '= 'x (sxt-add sxt-z 'x)) (lambda () (subst (list '= (sxt-add sxt-z 'x) 'x)) (rfl)))
      (sxt-elem! 'x sxt-z 'x)
      (let* ((t0 (list '+ (list 'p sxt-z) '(q x)))
             (m1 (dk-cite! 'sxt-elem-scale 'm 's 'p 'q 'x 'lm t0))
             (h (sxt-inf-le! lx (list '* a t0))))
        (dk-have! (list '= a 0) (lambda () (subst '(= lm 0)) (fact 'rr-abs-zero-value) (ass)))
        (subst (list '= a 0))
        (dk-rewrite-h! h a 0)
        (sxt-real! t0)
        (dk-ineq! (dk-ctx-form (list '<= il (list '* 0 t0))) (list 'IN il 'RR) (list 'IN ix 'RR) (list 'IN t0 'RR))))
    (lambda ()
      (let ((iff (dk-cite! 'rr-abs-zero 'lm)))
        (dk-have! (list 'NOT (list '= a 0)) (lambda () (dk-only! iff '(NOT (= lm 0))) (prop))))
      (dk-cite! 'dual-rr-pos-of-nonneg-nonzero a)
      (sxt-glb-le! 'x (list '* (list 'recip a) il)
        (lambda (t)
          (dk-split! (dk-cite! 'sxt-set-elim 'm 's 'p 'q 'x t))
          (dk-cite! 'sxt-elem-scale 'm 's 'p 'q 'x 'lm t)
          (sxt-inf-le! lx (list '* a t))
          (dk-cite! 'mink-rr-div-ge t il a)
          (ass)))
      (dk-cite! 'mink-rr-ge-div ix il a)
      (ass))))
(sxt-qed! 'sxt-inf-homog-le)

(sp (make-wff (sxt-st '(x lm) (list (list 'IN 'x sxt-V) '(IN lm RR))
                      (list '= (sxt-I (sxt-act 'lm 'x)) (list '* '(abs lm) (sxt-I 'x))))))
(dk-peel!)
(sxt-parts!)
(let* ((lx (sxt-act 'lm 'x)) (ix (sxt-I 'x)) (il (sxt-I lx)) (a '(abs lm)) (ai (list '* a ix)))
  (sxt-vtype! lx)
  (sxt-glb! 'x) (sxt-glb! lx)
  (sxt-real! a) (sxt-real! ai)
  (dk-cite! 'sxt-inf-homog-le 'm 's 'p 'q 'x 'lm)
  (dk-cite! 'rr-abs-nonneg 'lm)
  (dk-cite! 'sxt-inf-nonneg 'm 's 'p 'q 'x)
  (define (fin!)
    (sxt-and! (list 'IN il 'RR) (list 'IN ai 'RR))
    (sxt-and! (list '<= il ai) (list '<= ai il))
    (dk-cite! 'rr-leq-antisymmetric il ai)
    (ass))
  (use-em '(= lm 0)
    (lambda ()
      (dk-have! (list '= a 0) (lambda () (subst '(= lm 0)) (fact 'rr-abs-zero-value) (ass)))
      (dk-cite! 'sxt-inf-nonneg 'm 's 'p 'q lx)
      (dk-have! (list '<= ai il)
        (lambda () (subst (list '= a 0)) (dk-ineq! (list '<= 0 il) (list 'IN il 'RR) (list 'IN ix 'RR))))
      (fin!))
    (lambda ()
      (let ((iff (dk-cite! 'rr-abs-zero 'lm)))
        (dk-have! (list 'NOT (list '= a 0)) (lambda () (dk-only! iff '(NOT (= lm 0))) (prop))))
      (sxt-and! '(IN lm RR) '(NOT (= lm 0)))
      (dk-cite! 'rr-recip-closed 'lm)
      (dk-cite! 'rr-recip-inverse 'lm)
      (let* ((rl '(recip lm))
             (h0 (dk-cite! 'sxt-inf-homog-le 'm 's 'p 'q lx rl))
             (e0 (dk-cite! 'rmod-act-recip-cancel-nz 'm 'lm 'x))
             (h1 (dk-rewrite-h! h0 (sxt-act rl lx) 'x))
             (r1 (begin (sxt-real! (list 'abs rl)) (dk-name! (list 'abs rl))))
             (h2 (dk-rewrite-h! h1 (list 'abs rl) r1)))
        (sxt-and! '(IN lm RR) (list 'IN rl 'RR))
        (let* ((em (dk-cite! 'rr-abs-mult 'lm rl))
               (e1 (dk-have! '(<= 0 1) (lambda () (dk-ineq!))))
               (e2 (dk-cite! 'rr-abs-of-nonneg 1)))
          (dk-have! (list '= (list '* a r1) 1)
            (lambda ()
              (subst (list '= r1 (list 'abs rl)))
              (subst (list '= (list '* a (list 'abs rl)) (list 'abs (list '* 'lm rl))))
              (subst (list '= (list '* 'lm rl) 1))
              (subst '(= (abs 1) 1))
              (arith))))
        (dk-cite! 'rr-abs-nonneg 'lm)
        (sxt-real! (list '* r1 il))
        (let* ((h3 (dk-cite! 'mink-rr-scale-le ix (list '* r1 il) a))
               (e3 (sxt-eq! (list '* a (list '* r1 il)) (list '* (list '* a r1) il)))
               (h4 (dk-rewrite-h! h3 (list '* a (list '* r1 il)) (list '* (list '* a r1) il)))
               (h5 (dk-rewrite-h! h4 (list '* a r1) 1))
               (e4 (sxt-eq! (list '* 1 il) il))
               (h6 (dk-rewrite-h! h5 (list '* 1 il) il)))
          (fin!))))))
(sxt-qed! 'sxt-inf-homogeneous)

;;; =====================================================================
;;; (5) Lemma 4.20
;;; =====================================================================
(define sxt-pt '(SEMINORM-EXT m s p q))
(define (sxt-tval! z)
  (sxt-vtype! z)
  (dk-cite! 'sxt-value 'm 's 'p 'q z)
  (subst (list '= (list sxt-pt z) (sxt-I z))))

(sp (make-wff (forall-guarded '(m s p q) sxt-H
   (list 'AND (list 'IS-SEMINORM 'RR-NORMED-FIELD 'm sxt-pt)
     (list 'AND (list 'EXTENDS-ON 's sxt-pt 'p)
       (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y sxt-V) (list '<= (list sxt-pt 'y) '(q y)))))))))
(dk-peel!)
(sxt-parts!)
(dk-project! '(IN (VEC m) SET) 'is-module '(IS-MODULE m))
(dk-cite! 'rr-scalar-ring-carr)
(let loop ((k 0))
  (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (dk-open-leaves))))
    (if (and l (< k 20)) (begin (dk-focus! l) (di) (loop (+ k 1))))))
(define (sxt-close-leaf!)
  (let ((g (dk-goal)))
    (cond
      ((dk-head-is? g 'IS-SEMINORM)
       (mac 'is-seminorm)
       (let loop ((k 0))
         (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (dk-open-leaves))))
           (if (and l (< k 20)) (begin (dk-focus! l) (di) (loop (+ k 1)))))))
      ((dk-head-is? g 'EXTENDS-ON)
       (mac 'extends-on)
       (let* ((landed (dk-peel!)) (x (cadr (cadr (dk-goal)))))
         (sxt-tval! x)
         (dk-cite! 'sxt-inf-extends 'm 's 'p 'q x)
         (ass)))
      ((dk-head-is? g 'IS-NORMED-FIELD) (dk-cite! 'rr-is-normed-field) (ass))
      ((dk-head-is? g 'IN)
       (mac 'SEMINORM-EXT)
       (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (sxt-glb! v) (ass))) (lambda () (ass))))
      ((or (dk-head-is? g 'IS-MODULE) (dk-head-is? g '=)) (ass))
      (#t
       (dk-peel!)
       (let ((g2 (dk-goal)))
         (cond
           ((and (dk-head-is? g2 '<=) (eqv? (cadr g2) 0))
            (let ((z (cadr (caddr g2)))) (sxt-tval! z) (dk-cite! 'sxt-inf-nonneg 'm 's 'p 'q z) (ass)))
           ((and (dk-head-is? g2 '<=) (dk-head-is? (caddr g2) 'q))
            (let ((z (cadr (cadr g2)))) (sxt-tval! z) (dk-cite! 'sxt-inf-le-q 'm 's 'p 'q z) (ass)))
           ((dk-head-is? g2 '<=)
            (let* ((xy (cadr (cadr g2))) (a (cadr xy)) (b (caddr xy)))
              (for-each sxt-tval! (list xy a b))
              (dk-cite! 'sxt-inf-subadditive 'm 's 'p 'q a b) (ass)))
           (#t
            (let* ((ax (cadr (cadr g2))) (lm (cadr ax)) (z (caddr ax)))
              (dk-have! (list 'IN lm 'RR)
                (lambda () (dk-rewrite-h! (dk-ctx-form (list 'IN lm '(CARR (SCAL m)))) '(SCAL m) sxt-ring)
                           (dk-rewrite-h! (dk-ctx-form (list 'IN lm (list 'CARR sxt-ring))) (list 'CARR sxt-ring) 'RR)
                           (ass)))
              (subst (dk-cite! 'rr-nf-fnrm-apply lm))
              (sxt-tval! ax) (sxt-tval! z)
              (dk-cite! 'sxt-inf-homogeneous 'm 's 'p 'q z lm) (ass)))))))))
(let sweep ((k 0))
  (let ((ls (filter (lambda (l) (not (sequent-node-grounded? l))) (dk-open-leaves))))
    (if (and (pair? ls) (< k 4))
        (begin (for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (sxt-close-leaf!)))) ls)
               (sweep (+ k 1))))))
(sxt-qed! 'seminorm-extension)
