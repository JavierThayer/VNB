(define (sxt-glb! z)
  (sxt-vtype! z)
  (if (not (dk-asm? (list 'IN (sxt-I z) 'RR)))
      (dk-split! (dk-cite! 'sxt-set-glb 'm 's 'p 'q z)))
  (cons (dk-ctx-form (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ (sxt-S z)) (list '<= (sxt-I z) 'lbw_))))
        (dk-ctx-form (list 'FORALL 'lbb_ (list 'IMPLIES '(IN lbb_ RR)
                       (list 'IMPLIES (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ (sxt-S z)) '(<= lbb_ lbw_)))
                             (list '<= 'lbb_ (sxt-I z))))))))
(define (sxt-glb-le! z b lb!)
  (let ((g (cdr (sxt-glb! z)))
        (lbf (list 'FORALL 'lbw_ (list 'IMPLIES (list 'IN 'lbw_ (sxt-S z)) (list '<= b 'lbw_)))))
    (sxt-real! b)
    (dk-have! lbf (lambda () (let ((w (dk-di-var!))) (lb! w))))
    (dk-apply! g b)))
(define (sxt-inf-le! z w)
  (dk-apply! (car (sxt-glb! z)) w))
(define (sxt-elem! y v w)   ; v in s, w in VEC m, y = v + w in context: land p(v) + q(w) in S(y)
  (sxt-parts!)
  (sxt-stype! v) (sxt-vtype! w)
  (dk-cite! 'sxt-set-intro 'm 's 'p 'q y v w))
(define sxt-dom '(FORALL dmx_ (IMPLIES (IN dmx_ s) (<= (p dmx_) (q dmx_)))))

(sp (make-wff (sxt-st '(y) (list (list 'IN 'y sxt-V)) (list '<= (sxt-I 'y) '(q y)))))
(dk-peel!)
(sxt-parts!)
(sxt-stype! sxt-z)
(dk-cite! 'rmod-vzero-left 'm 'y)
(dk-have! (list '= 'y (sxt-add sxt-z 'y)) (lambda () (subst (list '= (sxt-add sxt-z 'y) 'y)) (rfl)))
(sxt-elem! 'y sxt-z 'y)
(let ((h (sxt-inf-le! 'y (list '+ (list 'p sxt-z) '(q y)))))
  (dk-cite! 'sxt-p-zero 'm 's 'p)
  (sxt-real! '(q y)) (sxt-real! (list 'p sxt-z))
  (dk-ineq! h (list '= (list 'p sxt-z) 0) (list 'IN (sxt-I 'y) 'RR) '(IN (q y) RR) (list 'IN (list 'p sxt-z) 'RR)))
(sxt-qed! 'sxt-inf-le-q)

(sp (make-wff (sxt-st '(x) '((IN x s)) (list '= (sxt-I 'x) '(p x)))))
(dk-peel!)
(sxt-parts!)
(sxt-vtype! 'x)
(sxt-vtype! sxt-z)
(let ((ix (sxt-I 'x)))
  (sxt-glb! 'x)
  (dk-cite! 'rmod-vzero-right 'm 'x)
  (dk-have! (list '= 'x (sxt-add 'x sxt-z)) (lambda () (subst (list '= (sxt-add 'x sxt-z) 'x)) (rfl)))
  (sxt-elem! 'x 'x sxt-z)
  (let ((h (sxt-inf-le! 'x (list '+ '(p x) (list 'q sxt-z)))))
    (dk-cite! 'sxt-q-zero 'm 'q)
    (sxt-real! '(p x)) (sxt-real! (list 'q sxt-z))
    (dk-have! (list '<= ix '(p x)) (lambda () (dk-ineq! h (list '= (list 'q sxt-z) 0) (list 'IN ix 'RR) '(IN (p x) RR)
                                                        (list 'IN (list 'q sxt-z) 'RR)))))
  (sxt-glb-le! 'x '(p x)
    (lambda (t)
      (let* ((vw (sxt-elim! 'x t)) (v (car vw)) (w (cdr vw)) (vpw (sxt-add v w)))
        (sxt-stype! v) (sxt-vtype! v) (sxt-vtype! w)
        (let* ((e (dk-cite! 'rmod-vneg-cancel 'm v w))
               (e2 (dk-rewrite-h! e vpw 'x))
               (m1 (sxt-stype! (sxt-add (list '(VNEG m) v) 'x)))
               (m2 (dk-rewrite-h! m1 (sxt-add (list '(VNEG m) v) 'x) w))
               (h1 (dk-cite! 'sxt-p-subadd 'm 's 'p v w))
               (h2 (dk-rewrite-h! h1 vpw 'x))
               (h3 (dk-apply! sxt-dom w)))
          (sxt-real! (list 'p v)) (sxt-real! (list 'p w)) (sxt-real! (list 'q w))
          (dk-ineq! h2 h3 (list '= t (list '+ (list 'p v) (list 'q w)))
                    '(IN (p x) RR) (list 'IN (list 'p v) 'RR) (list 'IN (list 'p w) 'RR) (list 'IN (list 'q w) 'RR))))))
  (sxt-and! (list 'IN ix 'RR) '(IN (p x) RR))
  (sxt-and! (list '<= ix '(p x)) (list '<= '(p x) ix))
  (dk-cite! 'rr-leq-antisymmetric ix '(p x))
  (ass))
(sxt-qed! 'sxt-inf-extends)

(sp (make-wff (sxt-st '(z) (list (list 'IN 'z sxt-V)) (list '<= 0 (sxt-I 'z)))))
