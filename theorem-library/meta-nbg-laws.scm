;;; meta-nbg-laws.scm -- K2, agent METACORE (2026-10-29).  Three parts:
;;;   A. THE NBG CONTROLS of the predicativity relation NBG-OK (structure-library/meta-core.scm 4.3a): the walk's
;;;      unfold and least-set laws; a predicative condition (TRUTH, the condition of the universal class) passes;
;;;      an unconfined universal (forall X. X = X) does not.
;;;   B. THE BRIDGES of the ten C+ rows of the K2 ledger: each kernel form (structure-library/meta-nbg.scm) is
;;;      admissible over the core.
;;;   C. The rules of rows 49 (big-union-mem-elim) and 58 (tuple-equality-decompose, re-transcribed in
;;;      structure-library/meta-ind.scm).
;;; Every theorem here is (qed ...); helper procedures are local (prefix mn-).  Load window: after
;;; theorem-library/meta-def-laws.scm and structure-library/meta-nbg.scm.  Library: meta.

;;; -----------------------------------------------------------------------
;;; 0. HELPERS (copies of the meta laws files' local helpers, renamed: the rule is one file or the kit).

(define (mn+ g . fs) (fold-left (lambda (g f) `(CTX-ADD ,g ,f)) g fs))
(define (mn-der g f) `(IN (LIST ,g ,f) (DERIVABLE tt)))
(define (mn-close!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (mn-expr-of! e cls)
  (if (not (dk-asm? `(IN ,e EXPR-SET)))
      (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! (if (eq? cls 'CLF) 'clf-iff 'clt-iff) e))))))
;; XS = (SEP v DOM cond), DOM a set: land (IN XS (POWER DOM))
(define (mn-sep-power! xs dom)
  (dk-have! `(IN ,xs SET) (lambda () (sep-set) (ass)))
  (let* ((iff (dk-meta-iff! 'power-set-membership dom xs))
         (inc `(FORALL mnvq_ (IMPLIES (IN mnvq_ ,xs) (IN mnvq_ ,dom)))))
    (dk-have! inc
      (lambda ()
        (dk-peel!)
        (sep-me (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) xs))) (dk-asms)))
        (ass)))
    (dk-meta-and! `(IN ,xs SET) inc)
    (dk-meta-iff-l! iff)
    `(IN ,xs (POWER ,dom))))
(define (mn-cart-en-set!)                 ; (IN (CARTESIAN EXPR-SET NN) SET)
  (if (not (dk-asm? '(IN (CARTESIAN EXPR-SET NN) SET)))
      (begin
        (fact 'expr-set-is-set) (fact 'nn-is-set)
        (let ((iff (dk-meta-iff! 'cartesian-set-iff 'EXPR-SET 'NN)))
          (dk-meta-and! '(IN EXPR-SET SET) '(IN NN SET))
          (dk-meta-iff-l! iff)))))
;; Open REL(tt, hs, c) (its body (AND (IN c SEQ-SET) (FORSOME ...))); N hypotheses (0, 1 or 2): c and hs rewritten
;; away, each hypothesis' derivability and SEQ-SET membership landed; return the witnesses.
(define (mn-rel-open! rel n)
  (let* ((r (dk-meta-iff-r! (dk-meta-iff! rel 'tt 'hs 'c)))
         (parts (dk-split! r))
         (vs (dk-meta-unpack! (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts)))
         (ceq (dk-meta-eq-of 'c)) (heq (dk-meta-eq-of 'hs)))
    (subst ceq)
    (dk-rewrite-h! '(IN c SEQ-SET) 'c (caddr ceq))
    (if (> n 0)
        (let* ((lst (caddr heq))
               (h2 (dk-rewrite-h! '(HYPS-IN hs (DERIVABLE tt)) 'hs lst))
               (ss (cdr lst)))
          (dk-have! `(= ,lst ,lst) (lambda () (rfl)))
          (case n
            ((1) (dk-cite! 'hyps-in-1-elim (car ss) '(DERIVABLE tt)))
            ((2) (dk-split! (dk-cite! 'hyps-in-2-elim (car ss) (cadr ss) '(DERIVABLE tt)))))
          (for-each (lambda (s) (dk-cite! 'der-in-seq 'tt s)) ss)))
    vs))
;; (= X Y) in context, X and Y ENCODED constructor terms (ENC-..., EAPP, EBIND, literal lists) whose
;; unfoldings differ in their tag or their head: close the goal.  The encoded constructors are unfolded in the
;; equation, then dk-meta-absurd-eq! (different tags) or eapp-injective / ebind-injective (one tag, two heads).
(define mn-enc-unfolds
  '((ENC-ALL . enc-all-unfold) (ENC-EX . enc-ex-unfold) (ENC-IOTA . enc-iota-unfold)
    (ENC-SEP . enc-sep-unfold) (ENC-COMP . enc-comp-unfold) (ENC-BU . enc-bu-unfold)
    (ENC-IN . enc-in-unfold) (ENC-EQ . enc-eq-unfold) (ENC-AND . enc-and-unfold) (ENC-IMP . enc-imp-unfold)
    (ENC-OR . enc-or-unfold) (ENC-IFF . enc-iff-unfold) (ENC-NOT . enc-not-unfold)))
(define (mn-enc-step t)                   ; the one-step unfolding of T, or #f
  (cond ((eq? t 'ENC-TRUTH) '(EAPP 0 (LIST)))
        ((eq? t 'ENC-FALSITY) '(EAPP 1 (LIST)))
        ((and (pair? t) (assq (car t) mn-enc-unfolds))
         (caddr (apply dk-cite! (cdr (assq (car t) mn-enc-unfolds)) (cdr t))))
        (#t #f)))
(define (mn-enc-fact! t)                  ; land the unfold equation of T (an ENC- term or constant)
  (cond ((eq? t 'ENC-TRUTH) (dk-cite! 'enc-truth-def))
        ((eq? t 'ENC-FALSITY) (dk-cite! 'enc-falsity-def))
        (#t (apply dk-cite! (cdr (assq (car t) mn-enc-unfolds)) (cdr t)))))
(define (mn-head-form! eqn)               ; rewrite both sides of the equation in context to EAPP / EBIND terms
  (let loop ((eqn eqn))
    (let ((x (cadr eqn)) (y (caddr eqn)))
      (cond ((or (memq x '(ENC-TRUTH ENC-FALSITY)) (and (pair? x) (assq (car x) mn-enc-unfolds)))
             (let ((u (mn-enc-fact! x))) (loop (dk-rewrite-h! eqn x (caddr u)))))
            ((or (memq y '(ENC-TRUTH ENC-FALSITY)) (and (pair? y) (assq (car y) mn-enc-unfolds)))
             (let ((u (mn-enc-fact! y))) (loop (dk-rewrite-h! eqn y (caddr u)))))
            (#t eqn)))))
(define (mn-absurd! eqn)
  (let* ((e2 (mn-head-form! eqn)) (x (cadr e2)) (y (caddr e2)))
    (cond ((and (dk-head-is? x 'EAPP) (dk-head-is? y 'EAPP))
           (let* ((parts (dk-split! (dk-cite! 'eapp-injective (cadr x) (caddr x) (cadr y) (caddr y))))
                  (hh `(= ,(cadr x) ,(cadr y))))
             (dk-have! `(NOT ,hh) (lambda () (arith)))
             (ai `(NOT ,hh))))
          ((and (dk-head-is? x 'EBIND) (dk-head-is? y 'EBIND))
           (let* ((parts (dk-split-all! (list (dk-cite! 'ebind-injective (cadr x) (caddr x) (cadddr x) (list-ref x 4)
                                                       (cadr y) (caddr y) (cadddr y) (list-ref y 4)))))
                  (hh `(= ,(cadr x) ,(cadr y))))
             (dk-have! `(NOT ,hh) (lambda () (arith)))
             (ai `(NOT ,hh))))
          (#t (dk-meta-absurd-eq! e2)))))

;;; -----------------------------------------------------------------------
;;; A. THE NBG CONTROLS.

(sp (make-wff '(FORALL mnbp_ (== (NBG-WALK mnbp_) (SEP mnbz_ EXPR-SET (FORALL mnbv_ (IMPLIES (IN mnbv_ (POWER EXPR-SET))
      (IMPLIES (IN mnbp_ mnbv_) (IMPLIES (NBG-CLOSED mnbv_) (IN mnbz_ mnbv_))))))))))
(dk-peel!) (mac 'NBG-WALK) (qrfl)
(qed 'nbg-walk-unfold)

(sp (make-wff '(FORALL p (FORALL mnvxs_ (IMPLIES (IN mnvxs_ (POWER EXPR-SET)) (IMPLIES (IN p mnvxs_)
   (IMPLIES (NBG-CLOSED mnvxs_) (FORALL x (IMPLIES (IN x (NBG-WALK p)) (IN x mnvxs_))))))))))
(dk-peel!)
(let* ((m (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'NBG-WALK))) (dk-asms)))
       (landed (dk-landed (lambda () (sep-me (dk-rewrite-h! m '(NBG-WALK p) (caddr (dk-cite! 'nbg-walk-unfold 'p)))))))
       (u (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
  (dk-apply! u 'mnvxs_)
  (ass))
(qed 'nbg-walk-least)

;; the walk holds its start
(sp (make-wff '(FORALL p (IMPLIES (IN p EXPR-SET) (IN p (NBG-WALK p))))))
(dk-peel!)
(subst (dk-cite! 'nbg-walk-unfold 'p))
(in-sep! (lambda () (ass)) (lambda () (dk-peel!) (ass)))
(qed 'nbg-walk-base)

(sp (make-wff '(FORALL mnbb_ (== (ALL-SPINE mnbb_) (SEP mnbz_ (CARTESIAN EXPR-SET NN) (FORALL mnbv_ (IMPLIES (IN mnbv_ (POWER (CARTESIAN EXPR-SET NN)))
      (IMPLIES (IN (LIST mnbb_ 0) mnbv_) (IMPLIES (ALL-SPINE-CLOSED mnbv_) (IN mnbz_ mnbv_))))))))))
(dk-peel!) (mac 'ALL-SPINE) (qrfl)
(qed 'all-spine-unfold)

(sp (make-wff '(FORALL b (FORALL mnvxs_ (IMPLIES (IN mnvxs_ (POWER (CARTESIAN EXPR-SET NN))) (IMPLIES (IN (LIST b 0) mnvxs_)
   (IMPLIES (ALL-SPINE-CLOSED mnvxs_) (FORALL x (IMPLIES (IN x (ALL-SPINE b)) (IN x mnvxs_))))))))))
(dk-peel!)
(let* ((m (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'ALL-SPINE))) (dk-asms)))
       (landed (dk-landed (lambda () (sep-me (dk-rewrite-h! m '(ALL-SPINE b) (caddr (dk-cite! 'all-spine-unfold 'b)))))))
       (u (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
  (dk-apply! u 'mnvxs_)
  (ass))
(qed 'all-spine-least)

;; THE POSITIVE CONTROL.  TRUTH, the condition of the universal class COMP x. TRUTH, is predicative: the walk
;; from it stays at it ({TRUTH} is closed under the steps), and TRUTH is not a quantifier node.
(define mn-xt '(SEP mnvz_ EXPR-SET (= mnvz_ ENC-TRUTH)))
(sp (make-wff '(NBG-OK ENC-TRUTH)))
(mac 'NBG-OK)
(dk-peel!)
(let* ((m (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'NBG-WALK))) (dk-asms)))
       (e (cadr m)) (xs mn-xt))
  (fact 'clf-truth)
  (mn-expr-of! 'ENC-TRUTH 'CLF)
  (fact 'expr-set-is-set)
  (mn-sep-power! xs 'EXPR-SET)
  (dk-have! `(IN ENC-TRUTH ,xs) (lambda () (in-sep! (lambda () (ass)) (lambda () (rfl)))))
  (dk-have! `(NBG-CLOSED ,xs)
    (lambda ()
      (mac 'NBG-CLOSED)
      (let* ((landed (dk-peel!))
             (mem (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) xs))) landed))
             (st (find-first (lambda (f) (dk-head-is? f 'NBG-STEP)) landed))
             (e1 (cadr mem)))
        (sep-me mem)
        (let* ((st2 (dk-rewrite-h! st e1 'ENC-TRUTH))
               (o (dk-landed-1 (lambda () (mac-h 'nbg-step st2)))))
          (dk-meta-or-each! o
            (lambda (d)
              (let* ((vs (dk-meta-unpack! d))
                     (eqn (find-first (lambda (f) (and (dk-head-is? f '=) (eq? (cadr f) 'ENC-TRUTH))) (dk-asms))))
                (cond
                  ;; an entry of the argument list: the list is empty
                  ((and (dk-head-is? (caddr eqn) 'EAPP) (not (dk-contains? d 'FUN-DEF)) (not (dk-contains? d 'PRED-DEF)))
                   (let* ((e2 (mn-head-form! eqn)) (y (caddr e2)) (l (caddr y))
                          (i (car (cddr vs))))
                     (dk-split! (dk-cite! 'eapp-injective 0 '(LIST) (cadr y) l))
                     (fact 'length-of-empty)
                     (let* ((le (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) i))) (dk-asms)))
                            (le2 (dk-rewrite-h! le l '(LIST))))
                       (dk-rewrite-h! le2 '(LENGTH (LIST)) 0)
                       (dk-have! '(<= 1 0) (lambda () (dk-nn! `(<= 1 ,i) `(<= ,i 0))))
                       (dk-have! '(NOT (<= 1 0)) (lambda () (arith)))
                       (ai '(NOT (<= 1 0))))))
                  ;; a row of the functoid table: the head is 0, the table's is 32
                  ((dk-contains? d 'FUN-DEF)
                   (let* ((e2 (mn-head-form! eqn)) (y (caddr e2)) (h (cadr y))
                          (fd (find-first (lambda (f) (dk-head-is? f 'FUN-DEF)) (dk-asms))))
                     (dk-split! (dk-cite! 'eapp-injective 0 '(LIST) h (caddr y)))
                     (dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'fun-def fd)))))
                     (dk-have! '(= 0 32) (lambda () (subst `(= 0 ,h)) (ass)))
                     (dk-have! '(NOT (= 0 32)) (lambda () (arith)))
                     (ai '(NOT (= 0 32)))))
                  ;; a predicate atom: head 10
                  ((dk-contains? d 'PRED-DEF) (mn-absurd! eqn))
                  ;; a binder: the tags differ
                  (#t (mn-absurd! eqn))))))))))
  (dk-apply! (dk-cite! 'nbg-walk-least 'ENC-TRUTH xs) e)
  (sep-me `(IN ,e ,xs))
  (subst `(= ,e ENC-TRUTH))
  (mac 'QNODE-OK)
  (dk-peel!)
  (dk-conj-close!
    (lambda ()
      (di)
      (mn-absurd! (find-first (lambda (f) (and (dk-head-is? f '=) (eq? (cadr f) 'ENC-TRUTH))) (dk-asms))))))
(qed 'nbg-ok-truth)

;; THE NEGATIVE CONTROL.  forall X. X = X (the body X = X, the index 0 against itself) is NOT predicative: the
;; walk holds the universal itself, and its implicational spine is the one node [X = X, 0], no implication.
(define mn-bb '(ENC-EQ (EBVAR 0) (EBVAR 0)))
(define mn-ys `(SEP mnvy_ (CARTESIAN EXPR-SET NN) (= mnvy_ (LIST ,mn-bb 0))))
(sp (make-wff `(NOT (NBG-OK (ENC-ALL ,mn-bb)))))
(di)
(let* ((bb mn-bb) (al `(ENC-ALL ,bb)) (ys mn-ys)
       (ok (find-first (lambda (f) (dk-head-is? f 'NBG-OK)) (dk-asms))))
  ;; the two expressions
  (dk-have! '(IN 0 NN) (lambda () (arith)))
  (fact 'ebvar-in-expr 0)
  (let ((l2 '(LIST (EBVAR 0) (EBVAR 0))))
    (dk-have! `(IN ,l2 (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
    (dk-have! '(IN 8 NN) (lambda () (arith)))
    (fact 'eapp-in-expr 8 l2)
    (dk-have! `(IN ,bb EXPR-SET) (lambda () (subst (dk-cite! 'enc-eq-unfold '(EBVAR 0) '(EBVAR 0))) (ass))))
  (dk-have! '(IN (LIST) (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
  (dk-have! '(IN 20 NN) (lambda () (arith)))
  (dk-have! '(IN 1 NN) (lambda () (arith)))
  (fact 'ebind-in-expr 20 1 '(LIST) bb)
  (dk-have! `(IN ,al EXPR-SET) (lambda () (subst (dk-cite! 'enc-all-unfold bb)) (ass)))
  ;; the universal is a node of its own walk, so its body is confined
  (dk-cite! 'nbg-walk-base al)
  (let* ((u (dk-landed-1 (lambda () (mac-h 'nbg-ok ok))))
         (q (dk-apply! u al))
         (u2 (dk-landed-1 (lambda () (mac-h 'qnode-ok q))))
         (cj (dk-apply! u2 bb))
         (parts (dk-split-all! (list cj)))
         (imp (find-first (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-contains? f 'ALL-CONFINED))) (dk-asms))))
    (dk-have! `(= ,al ,al) (lambda () (rfl)))
    (let* ((ac (dk-landed-1 (lambda () (detach! imp))))
           (ex (dk-landed-1 (lambda () (mac-h 'all-confined ac))))
           (vs (dk-meta-unpack! ex))
           (x (car vs)) (y (cadr vs)) (d (caddr vs))
           (sm (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'ALL-SPINE))) (dk-asms))))
      ;; the spine is inside {[X = X, 0]}
      (mn-cart-en-set!)
      (mn-sep-power! ys '(CARTESIAN EXPR-SET NN))
      (dk-meta-set-of! bb 'EXPR-SET)
      (dk-meta-num-set! 0)
      (dk-have! `(IN (LIST ,bb 0) ,ys)
        (lambda () (in-sep! (lambda () (dk-meta-close-in!)) (lambda () (rfl)))))
      (dk-have! `(ALL-SPINE-CLOSED ,ys)
        (lambda ()
          (mac 'ALL-SPINE-CLOSED)
          (let* ((landed (dk-peel!))
                 (mem (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) ys))) landed))
                 (st (find-first (lambda (f) (dk-head-is? f 'ALL-SPINE-STEP)) landed))
                 (u1 (cadr mem)))
            (sep-me mem)
            (let* ((st2 (dk-rewrite-h! st u1 `(LIST ,bb 0)))
                   (o (dk-landed-1 (lambda () (mac-h 'all-spine-step st2)))))
              (dk-meta-or-each! o
                (lambda (dj)
                  (dk-meta-unpack! dj)
                  (let* ((leq (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) `(LIST ,bb 0)))) (dk-asms)))
                         (l2 (caddr leq)) (y1 (cadr l2)))
                    (dk-have! `(= ,bb ,y1) (lambda () (dk-meta-component! `(LIST ,bb 0) l2 1)))
                    (mn-absurd! `(= ,bb ,y1)))))))))
      (dk-apply! (dk-cite! 'all-spine-least bb ys) `(LIST (ENC-IMP ,x ,y) ,d))
      (sep-me `(IN (LIST (ENC-IMP ,x ,y) ,d) ,ys))
      (let ((leq `(= (LIST (ENC-IMP ,x ,y) ,d) (LIST ,bb 0))))
        (dk-have! `(= (ENC-IMP ,x ,y) ,bb) (lambda () (dk-meta-component! `(LIST (ENC-IMP ,x ,y) ,d) `(LIST ,bb 0) 1)))
        (mn-absurd! `(= (ENC-IMP ,x ,y) ,bb))))))
(qed 'nbg-ok-refuses-unguarded)

;; THE CONFINEMENT CLAUSES ARE MET by the guards the kernel reads: a universal whose body is (x in C) => B, an
;; existential whose body is (x in C) and B (the controls of the clauses themselves; nbg-ok-truth is the walk's).
(sp (make-wff '(FORALL mnbx_ (== (CONJ-REACH mnbx_) (SEP mnbz_ EXPR-SET (FORALL mnbv_ (IMPLIES (IN mnbv_ (POWER EXPR-SET))
      (IMPLIES (IN mnbx_ mnbv_) (IMPLIES (CONJ-CLOSED mnbv_) (IN mnbz_ mnbv_))))))))))
(dk-peel!) (mac 'CONJ-REACH) (qrfl)
(qed 'conj-reach-unfold)
(sp (make-wff '(FORALL mnbb_ (== (EX-SPINE mnbb_) (SEP mnbz_ (CARTESIAN EXPR-SET NN) (FORALL mnbv_ (IMPLIES (IN mnbv_ (POWER (CARTESIAN EXPR-SET NN)))
      (IMPLIES (IN (LIST mnbb_ 0) mnbv_) (IMPLIES (EX-SPINE-CLOSED mnbv_) (IN mnbz_ mnbv_))))))))))
(dk-peel!) (mac 'EX-SPINE) (qrfl)
(qed 'ex-spine-unfold)

(define (mn-typed-enc! c b)               ; c, b in EXPR-SET in context: (EBVAR 0), (ENC-IN (EBVAR 0) c) typed
  (dk-have! '(IN 0 NN) (lambda () (arith)))
  (dk-have! '(IN 7 NN) (lambda () (arith)))
  (dk-have! '(IN 3 NN) (lambda () (arith)))
  (dk-have! '(IN 5 NN) (lambda () (arith)))
  (fact 'ebvar-in-expr 0)
  (let ((l `(LIST (EBVAR 0) ,c)))
    (dk-have! `(IN ,l (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
    (fact 'eapp-in-expr 7 l)
    (dk-have! `(IN (ENC-IN (EBVAR 0) ,c) EXPR-SET) (lambda () (subst (dk-cite! 'enc-in-unfold '(EBVAR 0) c)) (ass)))))
(define (mn-typed-bin! h enc p q)         ; p, q in EXPR-SET: (ENC p q) in EXPR-SET, its unfolding the head H
  (let ((l `(LIST ,p ,q)))
    (dk-have! `(IN ,l (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
    (fact 'eapp-in-expr h l)
    (dk-have! `(IN (,enc ,p ,q) EXPR-SET) (lambda () (subst (apply dk-cite! (cdr (assq enc mn-enc-unfolds)) (list p q))) (ass)))))
;; x in every least set holding it: (IN x (R x)) for R = CONJ-REACH
(define (mn-base-in! unfold x)
  (dk-have! `(IN ,x (CONJ-REACH ,x))
    (lambda () (subst (dk-cite! unfold x)) (in-sep! (lambda () (ass)) (lambda () (dk-peel!) (ass))))))

(sp (make-wff '(FORALL c (FORALL b (IMPLIES (IN c EXPR-SET) (IMPLIES (IN b EXPR-SET)
   (ALL-CONFINED (ENC-IMP (ENC-IN (EBVAR 0) c) b))))))))
(dk-peel!)
(let* ((gd '(ENC-IN (EBVAR 0) c)) (body `(ENC-IMP ,gd b)))
  (mn-typed-enc! 'c 'b)
  (mn-typed-bin! 5 'ENC-IMP gd 'b)
  (mn-base-in! 'conj-reach-unfold gd)
  (dk-have! `(IN (LIST ,body 0) (ALL-SPINE ,body))
    (lambda ()
      (subst (dk-cite! 'all-spine-unfold body))
      (in-sep! (lambda () (dk-meta-close-in!)) (lambda () (dk-peel!) (ass)))))
  (mac 'ALL-CONFINED)
  (ew gd) (ew 'b) (ew 0) (ew 'c)
  (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (arith)))))
(qed 'all-confined-guarded)

(sp (make-wff '(FORALL c (FORALL b (IMPLIES (IN c EXPR-SET) (IMPLIES (IN b EXPR-SET)
   (EX-CONFINED (ENC-AND (ENC-IN (EBVAR 0) c) b))))))))
(dk-peel!)
(let* ((gd '(ENC-IN (EBVAR 0) c)) (body `(ENC-AND ,gd b)) (cc '(CARTESIAN EXPR-SET NN)))
  (mn-typed-enc! 'c 'b)
  (mn-typed-bin! 3 'ENC-AND gd 'b)
  (dk-meta-set-of! body 'EXPR-SET) (dk-meta-set-of! gd 'EXPR-SET) (dk-meta-num-set! 0)
  (dk-have! `(IN (LIST ,gd 0) ,cc) (lambda () (dk-meta-close-in!)))
  (dk-have! `(IN (LIST ,body 0) ,cc) (lambda () (dk-meta-close-in!)))
  ;; the step from [b0 and b, 0] to [b0, 0]: an EX-SPINE-STEP, second disjunct, left side
  (dk-have! `(EX-SPINE-STEP (LIST ,body 0) (LIST ,gd 0))
    (lambda ()
      (mac 'EX-SPINE-STEP)
      (oi-r)
      (ew gd) (ew 'b) (ew 0)
      (dk-conj-close! (lambda () (cond ((dk-asm? (dk-goal)) (ass))
                                       ((dk-head-is? (dk-goal) 'OR) (oi-l) (rfl))
                                       ((dk-head-is? (dk-goal) '=) (rfl))
                                       (#t (arith)))))))
  (dk-have! `(IN (LIST ,gd 0) (EX-SPINE ,body))
    (lambda ()
      (subst (dk-cite! 'ex-spine-unfold body))
      (in-sep!
        (lambda () (ass))
        (lambda ()
          (let* ((landed (dk-peel!))
                 (cl (find-first (lambda (f) (dk-head-is? f 'EX-SPINE-CLOSED)) landed))
                 (u (dk-landed-1 (lambda () (mac-h 'ex-spine-closed cl))))
                 (u2 (dk-apply! u `(LIST ,body 0))))
            (dk-apply! u2 `(LIST ,gd 0))
            (mn-close!))))))
  (mac 'EX-CONFINED)
  (ew 0) (ew 'c)
  (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (arith)))))
(qed 'ex-confined-guarded)

;;; -----------------------------------------------------------------------
;;; B. THE BRIDGES: the kernel forms of the ten C+ rows (structure-library/meta-nbg.scm) are admissible.

;; the shared preparation of a REPLACE form: the conclusion's and the hypotheses' sequents typed, the replaced
;; formula F0 a sentence, DIFFERENCE(g, {F0}) a sub-context of g
(define (mn-replace-prep! g f f0 gds)
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g f)))
  (for-each (lambda (gd) (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff gd f)))) gds)
  (dk-cite! 'ctx-mem g f0)
  (dk-cite! 'ctx-diff-sub g `(PAIR ,f0 ,f0)))
(define (mn-adm-stmt rel)
  `(FORALL tt (FORALL hs (FORALL c (IMPLIES (,rel tt hs c) (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt))))))))

;; ROW 10, and-elim (replace): weakening to the core's keep form.
(sp (make-wff (mn-adm-stmt 'REL-AND-ELIM-K)))
(dk-peel!)
(let* ((vs (mn-rel-open! 'rel-and-elim-k 1)) (g (car vs)) (f (cadr vs)) (a (caddr vs)) (b (cadddr vs))
       (f0 `(ENC-AND ,a ,b)) (dg `(DIFFERENCE ,g (PAIR ,f0 ,f0))) (gd (mn+ dg a b)) (g1 (mn+ g a b)))
  (mn-replace-prep! g f f0 (list gd))
  (dk-split! (dk-cite! 'clf-and-elim a b))
  (dk-meta-derive! 'tt `(and-elim (,g ==> ,f) (weakening (,g1 ==> ,f) (given (,gd ==> ,f)))))
  (mn-close!))
(qed 'adm-and-elim-k)

;; ROW 11, or-elim (replace).
(sp (make-wff (mn-adm-stmt 'REL-OR-ELIM-K)))
(dk-peel!)
(let* ((vs (mn-rel-open! 'rel-or-elim-k 2)) (g (car vs)) (f (cadr vs)) (a (caddr vs)) (b (cadddr vs))
       (f0 `(ENC-OR ,a ,b)) (dg `(DIFFERENCE ,g (PAIR ,f0 ,f0))) (gda (mn+ dg a)) (gdb (mn+ dg b)))
  (mn-replace-prep! g f f0 (list gda gdb))
  (dk-split! (dk-cite! 'clf-or-elim a b))
  (dk-meta-derive! 'tt `(or-elim (,g ==> ,f) (weakening (,(mn+ g a) ==> ,f) (given (,gda ==> ,f)))
                                             (weakening (,(mn+ g b) ==> ,f) (given (,gdb ==> ,f)))))
  (mn-close!))
(qed 'adm-or-elim-k)

;; ROW 13, iff-elim (replace).
(sp (make-wff (mn-adm-stmt 'REL-IFF-ELIM-K)))
(dk-peel!)
(let* ((vs (mn-rel-open! 'rel-iff-elim-k 1)) (g (car vs)) (f (cadr vs)) (a (caddr vs)) (b (cadddr vs))
       (f0 `(ENC-IFF ,a ,b)) (dg `(DIFFERENCE ,g (PAIR ,f0 ,f0)))
       (ab `(ENC-IMP ,a ,b)) (ba `(ENC-IMP ,b ,a)) (gd (mn+ dg ab ba)) (g1 (mn+ g ab ba)))
  (mn-replace-prep! g f f0 (list gd))
  (dk-split! (dk-cite! 'clf-iff-elim a b))
  (dk-cite! 'clf-imp-intro a b)
  (dk-cite! 'clf-imp-intro b a)
  (dk-meta-derive! 'tt `(iff-elim (,g ==> ,f) (weakening (,g1 ==> ,f) (given (,gd ==> ,f)))))
  (mn-close!))
(qed 'adm-iff-elim-k)

;; ROW 14, forsome-elim (replace).  The kernel's eigenvariable condition (y free in neither the rest of the
;; context, the goal nor the existential) gives the core's (y free in neither the context nor the goal): a free
;; name of a member of g is one of a member of the rest, or of the existential.
(sp (make-wff '(FORALL g (FORALL e (FORALL y (IMPLIES (IN e SET) (IMPLIES (IN y (CTX-FV g))
   (OR (IN y (CTX-FV (DIFFERENCE g (PAIR e e)))) (IN y (EXPR-FV e))))))))))
(dk-peel!)
(let* ((m '(IN y (CTX-FV g)))
       (bu (caddr (dk-cite! 'ctx-fv-unfold 'g)))
       (m2 (dk-rewrite-h! m '(CTX-FV g) bu))
       (landed (dk-landed (lambda () (bu-me m2))))
       (wm (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'g))) landed))
       (w (cadr wm)))
  (use-em `(= ,w e)
    (lambda () (oi-r) (subst `(= e ,w)) (ass))
    (lambda ()
      (oi-l)
      (let* ((dg '(DIFFERENCE g (PAIR e e))) (bu2 (caddr (dk-cite! 'ctx-fv-unfold dg))))
        (subst `(= (CTX-FV ,dg) ,bu2))
        (dk-each-leaf! (lambda () (bu-mi w))
          (lambda ()
            (if (dk-asm? (dk-goal)) (ass)
                (let ((iff (dk-meta-iff! 'difference-membership 'g '(PAIR e e) w)))
                  (dk-have! `(NOT (IN ,w (PAIR e e)))
                    (lambda ()
                      (di)
                      (dk-have! '(AND (IN e SET) (IN e SET)) (lambda () (dk-conj-close! (lambda () (ass)))))
                      (let* ((u (dk-cite! 'pairing-membership 'e 'e))
                             (i2 (dk-apply! u w))
                             (o (dk-meta-iff-r! i2)))
                        (dk-meta-or-each! o (lambda (d) (ai `(NOT (= ,w e))))))))
                  (dk-meta-and! `(IN ,w g) `(NOT (IN ,w (PAIR e e))))
                  (dk-meta-iff-l! iff)
                  (ass))))))))
  (mn-close!))
(qed 'ctx-fv-minus)

;; (IN y U), U nested UNIONs, from (IN y S) in context for a leaf S of U
(define (mn-reaches? y a)
  (or (dk-asm? `(IN ,y ,a)) (and (dk-head-is? a 'UNION) (or (mn-reaches? y (cadr a)) (mn-reaches? y (caddr a))))))
(define (mn-union-in!)
  (let ((goal (dk-goal)))
    (if (dk-asm? goal) (ass)
        (let* ((y (cadr goal)) (u (caddr goal)) (a (cadr u)) (b (caddr u))
               (iff (dk-meta-iff! 'union-membership a b y)))
          (dk-have! (caddr iff) (lambda () (if (mn-reaches? y a) (oi-l) (oi-r)) (mn-union-in!)))
          (dk-meta-iff-l! iff)
          (mn-close!)))))

(sp (make-wff (mn-adm-stmt 'REL-FORSOME-ELIM-K)))
(dk-peel!)
(let* ((vs (mn-rel-open! 'rel-forsome-elim-k 1)) (g (car vs)) (f (cadr vs)) (b (caddr vs)) (y (cadddr vs))
       (f0 `(ENC-EX ,b)) (dg `(DIFFERENCE ,g (PAIR ,f0 ,f0))) (op `(EXPR-OPEN ,b 0 (EFVAR ,y)))
       (gd (mn+ dg op)) (g1 (mn+ g op))
       (kfresh (find-first (lambda (f) (and (dk-head-is? f 'NOT) (dk-contains? f 'CTX-FV))) (dk-asms))))
  (mn-replace-prep! g f f0 (list gd))
  (dk-meta-set-of! f0 'CLF)
  ;; the free-name sets are sets (union-membership is instantiated at them)
  (mn-expr-of! f 'CLF) (mn-expr-of! f0 'CLF)
  (dk-split-all! (list (dk-cite! 'fv-finite f)))
  (dk-split-all! (list (dk-cite! 'fv-finite f0)))
  (dk-split-all! (list (dk-cite! 'ctx-fv-finite g)))
  (dk-have! `(NOT (IN ,y (UNION (CTX-FV ,g) (EXPR-FV ,f))))
    (lambda ()
      (di)
      (let* ((absurd! (lambda () (dk-have! (cadr kfresh) (lambda () (mn-union-in!))) (ai kfresh)))
             (o1 (dk-meta-iff-r! (dk-meta-iff! 'union-membership `(CTX-FV ,g) `(EXPR-FV ,f) y))))
        (dk-meta-or-each! o1
          (lambda (d)
            (if (dk-contains? d 'CTX-FV)
                (dk-meta-or-each! (dk-cite! 'ctx-fv-minus g f0 y) (lambda (d2) (absurd!)))
                (absurd!)))))))
  (dk-cite! 'clt-efvar y)
  (dk-cite! 'clf-open-inst-ex b `(EFVAR ,y))
  (dk-meta-derive! 'tt `(forsome-elim (,g ==> ,f) (weakening (,g1 ==> ,f) (given (,gd ==> ,f))) (y := ,y)))
  (mn-close!))
(qed 'adm-forsome-elim-k)

;; ROW 8, forsome-intro with a certified witness: the definedness sequent the core's forsome-intro owes is derived
;; -- from the instance (adm-true-walk, adm-strict-atom) or from the context (assumption, adm-cert).
(sp (make-wff (mn-adm-stmt 'REL-FORSOME-INTRO-K)))
(dk-peel!)
(let* ((vs (mn-rel-open! 'rel-forsome-intro-k 1)) (g (car vs)) (b (cadr vs)) (tm (caddr vs))
       (op `(EXPR-OPEN ,b 0 ,tm))
       (o (find-first (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f 'CERT-SET))) (dk-asms))))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g `(ENC-EX ,b))))
  (dk-meta-or-each! o
    (lambda (d)
      (let ((vv (dk-meta-unpack! d)))
        (if (dk-contains? d 'TRUE-REACH)
            (begin (dk-cite! 'adm-true-walk 'tt g op (car vv))
                   (dk-cite! 'adm-strict-atom 'tt g (car vv) tm))
            (begin (dk-meta-derive! 'tt `(assumption (,g ==> ,(car vv))))
                   (dk-cite! 'adm-cert 'tt g tm (car vv))))
        (dk-meta-derive! 'tt `(forsome-intro (,g ==> (ENC-EX ,b)) (given (,g ==> ,op)) (given (,g ==> (ENC-EQ ,tm ,tm)))))
        (mn-close!)))))
(qed 'adm-forsome-intro-k)

;; ROW 15, forall-elim at a term the context certifies.
(sp (make-wff (mn-adm-stmt 'REL-FORALL-ELIM-K)))
(dk-peel!)
(let* ((vs (mn-rel-open! 'rel-forall-elim-k 1)) (g (car vs)) (f (cadr vs)) (b (caddr vs)) (tm (cadddr vs)) (h (list-ref vs 4))
       (op `(EXPR-OPEN ,b 0 ,tm)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g f)))
  (dk-meta-derive! 'tt `(assumption (,g ==> ,h)))
  (dk-cite! 'adm-cert 'tt g tm h)
  (dk-meta-derive! 'tt `(forall-elim (,g ==> ,f) (given (,(mn+ g op) ==> ,f)) (given (,g ==> (ENC-EQ ,tm ,tm)))))
  (mn-close!))
(qed 'adm-forall-elim-k)

;; ROW 24, reflexivity at a term the context certifies.
(sp (make-wff (mn-adm-stmt 'REL-REFLEXIVITY-K)))
(dk-peel!)
(let* ((vs (mn-rel-open! 'rel-reflexivity-k 0)) (g (car vs)) (tm (cadr vs)) (h (caddr vs)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g `(ENC-EQ ,tm ,tm))))
  (dk-meta-derive! 'tt `(assumption (,g ==> ,h)))
  (dk-cite! 'adm-cert 'tt g tm h)
  (mn-close!))
(qed 'adm-reflexivity-k)

;; ROWS 26, 27, if-true / if-false with the STRICT equation: from the quasi-equation the core hands over and the
;; branch's definedness, the strict equation (der-atom-l at the head 8), then a cut.
(define (mn-if-k! rel cr-rule side-of br-of)
  (sp (make-wff (mn-adm-stmt rel)))
  (dk-peel!)
  (let* ((vs (mn-rel-open! (string->symbol (string-downcase (symbol->string rel))) 2))
         (g (car vs)) (f (cadr vs)) (p (caddr vs)) (a (cadddr vs)) (b (list-ref vs 4)) (h (list-ref vs 5))
         (br (br-of a b)) (ift `(ENC-IF ,p ,a ,b))
         (eqf `(ENC-EQ ,ift ,br)) (qq `(ENC-QEQ ,ift ,br)) (g2 (mn+ g eqf)) (g1 (mn+ g qq))
         (eap `(EAPP 8 (LIST ,ift ,br))) (ebb `(EAPP 8 (LIST ,br ,br))))
    (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g f)))
    (dk-cite! 'clf-eq-intro ift br)
    (dk-cite! 'clf-qeq-intro ift br)
    (dk-cite! 'clf-eq-intro br br)
    ;; the branch denotes: the context certificate
    (dk-meta-derive! 'tt `(assumption (,g ==> ,h)))
    (dk-cite! 'adm-cert 'tt g br h)
    ;; the EAPP forms of the two equations
    (let* ((u1 (dk-cite! 'enc-eq-unfold ift br)) (u2 (dk-cite! 'enc-eq-unfold br br)))
      (dk-rewrite-h! `(IN ,eqf CLF) eqf eap)
      (dk-rewrite-h! `(IN (ENC-EQ ,br ,br) CLF) `(ENC-EQ ,br ,br) ebb)
      (dk-rewrite-h! (mn-der g `(ENC-EQ ,br ,br)) `(ENC-EQ ,br ,br) ebb)
      (dk-have! '(IN 8 NN) (lambda () (arith)))
      (dk-meta-derive! 'tt `(lemma (,g1 ==> ,eap) der-atom-l (,g1 8 ,ift ,br ,br)
                              (assumption (,g1 ==> ,qq))
                              (weakening (,g1 ==> ,ebb) (given (,g ==> ,ebb)))))
      (dk-rewrite-h! (mn-der g1 eap) eap eqf))
    (dk-meta-derive! 'tt `(,cr-rule (,g ==> ,f) (given (,g ==> ,(side-of p)))
                            (cut (,g1 ==> ,f) (given (,g1 ==> ,eqf))
                                 (weakening (,(mn+ g1 eqf) ==> ,f) (given (,g2 ==> ,f))))))
    (mn-close!)))
(mn-if-k! 'REL-IF-TRUE-K 'if-true (lambda (p) p) (lambda (a b) a))
(qed 'adm-if-true-k)
(mn-if-k! 'REL-IF-FALSE-K 'if-false (lambda (p) `(ENC-NOT ,p)) (lambda (a b) b))
(qed 'adm-if-false-k)

;; ROW 51, iota-in-elim: the description's definedness, which the core's rule takes as a premise, read off the
;; context -- a membership by strictness of IN, an equation by strictness of = (adm-def-strict-eq-l / -r).
(sp (make-wff (mn-adm-stmt 'REL-IOTA-IN-ELIM-K)))
(dk-peel!)
(let* ((vs (mn-rel-open! 'rel-iota-in-elim-k 1)) (g (car vs)) (f (cadr vs)) (p (caddr vs))
       (io `(ENC-IOTA ,p)) (ee `(ENC-EQ ,io ,io)) (op `(EXPR-OPEN ,p 0 ,io))
       (o (find-first (lambda (x) (and (dk-head-is? x 'OR) (dk-contains? x 'ENC-IOTA))) (dk-asms))))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g f)))
  (dk-meta-or-each! o
    (lambda (d)
      (let* ((strict!
              (lambda (rel law eqn)          ; DEF-STRICT-EQ-L / -R at the equation EQN of g
                (let* ((hs `(LIST (LIST ,g ,eqn))) (c `(LIST ,g ,ee)))
                  (dk-meta-derive! 'tt `(assumption (,g ==> ,eqn)))
                  (dk-split! (dk-cite! 'clf-eq-elim (cadr eqn) (caddr eqn)))
                  (dk-cite! 'clf-eq-intro io io)
                  (dk-meta-seq! g ee)
                  (dk-have! `(,rel tt ,hs ,c)
                    (lambda () (mac rel) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                                         (dk-meta-ex-fill! (if (eq? rel 'DEF-STRICT-EQ-L)
                                                                                               (list g io (caddr eqn))
                                                                                               (list g (cadr eqn) io))))))))
                  (dk-have! `(HYPS-IN ,hs (DERIVABLE tt)) (lambda () (fact 'hyps-in-1 `(LIST ,g ,eqn) '(DERIVABLE tt)) (ass)))
                  (dk-cite! law 'tt hs c)))))
        (cond
          ((dk-head-is? d 'FORSOME)
           (let* ((vv (dk-meta-unpack! d)) (aa (car vv)))
             (if (dk-contains? d 'ENC-IN)
                 (begin (dk-cite! 'ctx-mem g `(ENC-IN ,io ,aa))
                        (dk-split! (dk-cite! 'clf-in-elim io aa))
                        (dk-cite! 'clf-eq-intro io io)
                        (dk-meta-derive! 'tt `(def-strict-in-l (,g ==> ,ee) (assumption (,g ==> (ENC-IN ,io ,aa))))))
                 (let ((o2 (find-first (lambda (x) (and (dk-head-is? x 'OR) (dk-contains? x aa))) (dk-asms))))
                   (dk-meta-or-each! o2
                     (lambda (d2)
                       (let ((eqn (cadr d2)))
                         (dk-cite! 'ctx-mem g eqn)
                         (if (equal? (cadr eqn) io)
                             (strict! 'DEF-STRICT-EQ-L 'adm-def-strict-eq-l eqn)
                             (strict! 'DEF-STRICT-EQ-R 'adm-def-strict-eq-r eqn))
                         (dk-meta-derive! 'tt `(iota-in-elim (,g ==> ,f) (given (,g ==> ,ee)) (given (,(mn+ g op) ==> ,f))))
                         (mn-close!))))))
             (if (dk-contains? d 'ENC-IN)
                 (begin
                   (dk-meta-derive! 'tt `(iota-in-elim (,g ==> ,f) (given (,g ==> ,ee)) (given (,(mn+ g op) ==> ,f))))
                   (mn-close!)))))
          (#t (error "adm-iota-in-elim-k: unexpected disjunct" (expression->string d))))))))
(qed 'adm-iota-in-elim-k)

;;; -----------------------------------------------------------------------
;;; C. ROW 58: TUPLE-EQUALITY-DECOMPOSE, re-transcribed (structure-library/meta-ind.scm, J-TEQ, with the two
;;; definedness premises).  The kernel's right fold of the component equations (TF-SET) against the core's left
;;; fold ENC-EQL, by induction over the least set (tf-eql, as rf-andl of meta-def-laws.scm section 10); every
;;; instance derivable through CR-TUPLE-EQ (der-tuple-eq-decompose); the local redexes inside EQV(T)
;;; (j-teq-sub); the kernel's rewrite admissible at one position, at stage 5 and at stage 7.

(define (mn-iff g a b) `(IN (LIST ,g (ENC-IFF ,a ,b)) (DERIVABLE tt)))
(define (mn-seq-of! g f)                   ; [g, f] derivable in context: its context and formula typed
  (dk-cite! 'der-in-seq 'tt `(LIST ,g ,f))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g f))))
(define (mn-cart-set! a b)                 ; (IN (CARTESIAN A B) SET), A and B sets in context
  (let ((cc `(CARTESIAN ,a ,b)))
    (if (not (dk-asm? `(IN ,cc SET)))
        (let ((iff (dk-meta-iff! 'cartesian-set-iff a b)))
          (dk-meta-and! `(IN ,a SET) `(IN ,b SET))
          (dk-meta-iff-l! iff)))))

(sp (make-wff '(FORALL mitfa_ (FORALL mitfb_ (== (TF-SET mitfa_ mitfb_)
   (SEP mitfp_ (CARTESIAN NN EXPR-SET) (FORALL mitfw_ (IMPLIES (IN mitfw_ (POWER (CARTESIAN NN EXPR-SET)))
      (IMPLIES (TF-CLOSED mitfa_ mitfb_ mitfw_) (IN mitfp_ mitfw_))))))))))
(dk-peel!) (mac 'TF-SET) (qrfl)
(qed 'tf-set-unfold)
(sp (make-wff '(FORALL a (FORALL b (FORALL mnvxs_ (IMPLIES (IN mnvxs_ (POWER (CARTESIAN NN EXPR-SET)))
   (IMPLIES (TF-CLOSED a b mnvxs_) (FORALL z (IMPLIES (IN z (TF-SET a b)) (IN z mnvxs_))))))))))
(dk-peel!)
(let* ((m (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'TF-SET))) (dk-asms)))
       (landed (dk-landed (lambda () (sep-me (dk-rewrite-h! m '(TF-SET a b) (caddr (dk-cite! 'tf-set-unfold 'a 'b)))))))
       (u (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
  (dk-apply! u 'mnvxs_)
  (ass))
(qed 'tf-set-least)

;; the core's left fold of the component equations is a sentence (as orl-clf)
(define mn-msa '(FORALL mczu_ (IMPLIES (IN mczu_ (MAKE-SET a)) (IN mczu_ CLT))))
(define mn-msb '(FORALL mczv_ (IMPLIES (IN mczv_ (MAKE-SET b)) (IN mczv_ CLT))))
(sp (make-wff `(FORALL n (IMPLIES (IN n NN) (FORALL a (FORALL b
   (IMPLIES (IN a (TUPLES EXPR-SET)) (IMPLIES (IN b (TUPLES EXPR-SET)) (IMPLIES ,mn-msa (IMPLIES ,mn-msb
   (IMPLIES (<= n (LENGTH a)) (IMPLIES (<= n (LENGTH b)) (IN (ENC-EQL a b n) CLF)))))))))))))
(let ((cs (dk-meta-ni-cases!)))
  (dk-focus! (car cs))
  (dk-peel!)
  (let* ((o (cadr (dk-goal))) (a (cadr o)) (b (caddr o)))
    (subst (dk-cite! 'enc-eql-zero a b))
    (fact 'clf-truth) (ass))
  (dk-focus! (cadr cs))
  (let* ((landed (dk-peel!))
         (ih (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ENC-EQL))) landed))
         (o (cadr (dk-goal))) (a (cadr o)) (b (caddr o)) (sn (cadddr o)) (n (cadr sn))
         (ua (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(MAKE-SET ,a)))) landed))
         (ub (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(MAKE-SET ,b)))) landed))
         (ea `(NTH ,sn ,a)) (eb `(NTH ,sn ,b)))
    (subst (dk-cite! 'enc-eql-succ a b n))
    (fact 'length-in-nn 'EXPR-SET a)
    (fact 'length-in-nn 'EXPR-SET b)
    (fact 'nn-succ-closed n)
    (dk-have! `(<= ,n (LENGTH ,a)) (lambda () (dk-nn! `(<= ,sn (LENGTH ,a)))))
    (dk-have! `(<= ,n (LENGTH ,b)) (lambda () (dk-nn! `(<= ,sn (LENGTH ,b)))))
    (dk-have! `(<= 1 ,sn) (lambda () (dk-nn!)))
    (dk-apply! ih a b)
    (dk-have! `(IN ,ea (MAKE-SET ,a)) (lambda () (dk-meta-in-makeset! sn a 'EXPR-SET)))
    (dk-have! `(IN ,eb (MAKE-SET ,b)) (lambda () (dk-meta-in-makeset! sn b 'EXPR-SET)))
    (dk-apply! ua ea)
    (dk-apply! ub eb)
    (dk-cite! 'clf-eq-intro ea eb)
    (dk-cite! 'clf-and-intro `(ENC-EQL ,a ,b ,n) `(ENC-EQ ,ea ,eb))
    (ass)))
(qed 'enc-eql-clf)

;; THE RIGHT FOLD AGAINST THE LEFT FOLD.  [j, f] in TF-SET(a, b), |a| = |b|: j + 1 <= |a| and
;; EQL(a, b, |a|) iff (EQL(a, b, j) and f).  (md14-rf! of meta-def-laws.scm with the component equation for the
;; membership atom.)
(sp (make-wff `(FORALL tt (FORALL g (FORALL a (FORALL b (FORALL j (FORALL f
   (IMPLIES (IN g CTX-SET) (IMPLIES (IN a (TUPLES EXPR-SET)) (IMPLIES (IN b (TUPLES EXPR-SET))
   (IMPLIES (= (LENGTH a) (LENGTH b)) (IMPLIES ,mn-msa (IMPLIES ,mn-msb
   (IMPLIES (IN (LIST j f) (TF-SET a b))
     (AND (<= (succ j) (LENGTH a))
          (IN (LIST g (ENC-IFF (ENC-EQL a b (LENGTH a)) (ENC-AND (ENC-EQL a b j) f))) (DERIVABLE tt))))))))))))))))))
(dk-peel!)
(let* ((top '(ENC-EQL a b (LENGTH a)))
       (claim (lambda (jj ff) `(AND (<= (succ ,jj) (LENGTH a)) (IN (LIST g (ENC-IFF ,top (ENC-AND (ENC-EQL a b ,jj) ,ff))) (DERIVABLE tt)))))
       (cc '(CARTESIAN NN EXPR-SET))
       (xs `(SEP mnvp_ ,cc ,(claim '(NTH 1 mnvp_) '(NTH 2 mnvp_))))
       (ua (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(MAKE-SET a)))) (dk-asms)))
       (ub (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(MAKE-SET b)))) (dk-asms)))
       (lenb! (lambda (k)                 ; k <= |a| in context: k <= |b|
                (dk-have! `(<= ,k (LENGTH b)) (lambda () (subst '(= (LENGTH b) (LENGTH a))) (ass)))))
       (atom! (lambda (k)                 ; k in NN, succ k <= |a| in context: the equation a_(k+1) = b_(k+1), a sentence
                (let ((ea `(NTH (succ ,k) a)) (eb `(NTH (succ ,k) b)))
                  (fact 'nn-succ-closed k)
                  (dk-have! `(<= 1 (succ ,k)) (lambda () (dk-nn!)))
                  (lenb! `(succ ,k))
                  (dk-have! `(IN ,ea (MAKE-SET a)) (lambda () (dk-meta-in-makeset! `(succ ,k) 'a 'EXPR-SET)))
                  (dk-have! `(IN ,eb (MAKE-SET b)) (lambda () (dk-meta-in-makeset! `(succ ,k) 'b 'EXPR-SET)))
                  (dk-apply! ua ea)
                  (dk-apply! ub eb)
                  (dk-cite! 'clf-eq-intro ea eb)
                  `(ENC-EQ ,ea ,eb))))
       (fold! (lambda (k) (lenb! k) (dk-apply! (dk-cite! 'enc-eql-clf k) 'a 'b) `(ENC-EQL a b ,k))))
  (fact 'length-in-nn 'EXPR-SET 'a)
  (fact 'nn-is-set) (fact 'expr-set-is-set)
  (mn-cart-set! 'NN 'EXPR-SET)
  (mn-sep-power! xs cc)
  (dk-have! `(TF-CLOSED a b ,xs)
    (lambda ()
      (mac 'TF-CLOSED)
      (dk-conj-close!
        (lambda ()
          (if (dk-contains? (dk-goal) '=)
              ;; the base: [j, a_(j+1) = b_(j+1)] with j + 1 = |a|
              (let* ((landed (dk-peel!))
                     (jv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed)))
                     (eq1 `(= (succ ,jv) (LENGTH a))))
                (dk-have! `(<= (succ ,jv) (LENGTH a)) (lambda () (dk-nn! eq1)))
                (dk-have! `(<= ,jv (LENGTH a)) (lambda () (dk-nn! eq1)))
                (let* ((at (atom! jv)) (rj (fold! jv)) (oa `(ENC-AND ,rj ,at)))
                  (mn-expr-of! at 'CLF)
                  (dk-cite! 'clf-and-intro rj at)
                  (dk-cite! 'der-iff-refl 'tt 'g oa)
                  (in-sep! (lambda () (dk-meta-close-in!))
                           (lambda ()
                             (nth-r)
                             (dk-conj-close!
                               (lambda ()
                                 (if (dk-head-is? (dk-goal) '<=) (ass)
                                     (begin (subst `(= (LENGTH a) (succ ,jv)))
                                            (subst (dk-cite! 'enc-eql-succ 'a 'b jv))
                                            (ass)))))))))
              ;; the step: from [k + 1, f] to [k, (a_(k+1) = b_(k+1)) and f]
              (let* ((landed (dk-peel!))
                     (kv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed)))
                     (mem (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) xs))) landed))
                     (fv (caddr (cadr mem)))
                     (cl (dk-nth-h! (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f `(NTH 1 ,(cadr mem)))))
                                                (dk-landed (lambda () (sep-me mem)))))))
                (dk-split! cl)
                (dk-have! `(<= (succ ,kv) (LENGTH a)) (lambda () (dk-nn! `(<= (succ (succ ,kv)) (LENGTH a)))))
                (dk-have! `(<= ,kv (LENGTH a)) (lambda () (dk-nn! `(<= (succ (succ ,kv)) (LENGTH a)))))
                (let* ((at (atom! kv)) (rk (fold! kv)) (rsk `(ENC-EQL a b (succ ,kv)))
                       (d0 (mn-iff 'g top `(ENC-AND ,rsk ,fv))) (af `(ENC-AND ,at ,fv)))
                  (mn-seq-of! 'g `(ENC-IFF ,top (ENC-AND ,rsk ,fv)))
                  (dk-split! (dk-cite! 'clf-iff-elim top `(ENC-AND ,rsk ,fv)))
                  (dk-split! (dk-cite! 'clf-and-elim rsk fv))
                  (dk-rewrite-h! d0 rsk (caddr (dk-cite! 'enc-eql-succ 'a 'b kv)))
                  (dk-cite! 'der-and-assoc 'tt 'g rk at fv)
                  (dk-cite! 'der-iff-trans 'tt 'g top `(ENC-AND (ENC-AND ,rk ,at) ,fv) `(ENC-AND ,rk ,af))
                  (dk-cite! 'clf-and-intro at fv)
                  (mn-expr-of! af 'CLF)
                  (in-sep! (lambda () (dk-meta-close-in!))
                           (lambda ()
                             (nth-r)
                             (dk-conj-close! (lambda () (ass))))))))))))
  (dk-apply! (dk-cite! 'tf-set-least 'a 'b xs) '(LIST j f))
  (let ((cl (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f '(NTH 1 (LIST j f)))))
                        (dk-landed (lambda () (sep-me `(IN (LIST j f) ,xs)))))))
    (dk-nth-h! cl)
    (ass)))
(qed 'tf-eql)

;; EVERY INSTANCE IS DERIVABLE when both lists denote: CR-TUPLE-EQ, the right fold against the left fold at
;; j = 0, the unit TRUTH; for n = 0 the fold is TRUTH on both sides.
(sp (make-wff '(FORALL tt (FORALL g (FORALL a (FORALL b (FORALL f (IMPLIES (IN g CTX-SET)
   (IMPLIES (IN (ENC-EQ (ENC-LIST a) (ENC-LIST b)) CLF) (IMPLIES (IN f CLF) (IMPLIES (= (LENGTH a) (LENGTH b))
   (IMPLIES (IN (LIST g (ENC-EQ (ENC-LIST a) (ENC-LIST a))) (DERIVABLE tt))
   (IMPLIES (IN (LIST g (ENC-EQ (ENC-LIST b) (ENC-LIST b))) (DERIVABLE tt))
   (IMPLIES (OR (AND (= (LENGTH a) 0) (= f ENC-TRUTH)) (IN (LIST 0 f) (TF-SET a b)))
     (IN (LIST g (ENC-IFF (ENC-EQ (ENC-LIST a) (ENC-LIST b)) f)) (DERIVABLE tt))))))))))))))))
(dk-peel!)
(let* ((uu '(ENC-EQ (ENC-LIST a) (ENC-LIST b))) (top '(ENC-EQL a b (LENGTH a))) (ff `(ENC-IFF ,uu ,top))
       (o (find-first (lambda (x) (and (dk-head-is? x 'OR) (dk-contains? x 'TF-SET))) (dk-asms))))
  (dk-split! (dk-cite! 'clf-eq-elim '(ENC-LIST a) '(ENC-LIST b)))
  (dk-split! (dk-cite! 'clt-list-elim 'a))
  (dk-split! (dk-cite! 'clt-list-elim 'b))
  (fact 'length-in-nn 'EXPR-SET 'a)
  (dk-have! '(<= (LENGTH a) (LENGTH a)) (lambda () (dk-nn!)))
  (dk-have! '(<= (LENGTH a) (LENGTH b)) (lambda () (subst '(= (LENGTH b) (LENGTH a))) (ass)))
  (dk-apply! (dk-cite! 'enc-eql-clf '(LENGTH a)) 'a 'b)
  (dk-cite! 'clf-iff-intro uu top)
  (dk-meta-derive! 'tt `(tuple-eq (g ==> ,ff) (given (g ==> (ENC-EQ (ENC-LIST a) (ENC-LIST a))))
                                               (given (g ==> (ENC-EQ (ENC-LIST b) (ENC-LIST b))))))
  (dk-meta-or-each! o
    (lambda (d)
      (if (dk-head-is? d 'AND)
          ;; n = 0: EQL(a, b, 0) is TRUTH, and so is f
          (let* ((parts (dk-split! d))
                 (d1 (dk-rewrite-h! (mn-iff 'g uu top) '(LENGTH a) 0)))
            (dk-rewrite-h! d1 '(ENC-EQL a b 0) (caddr (dk-cite! 'enc-eql-zero 'a 'b)))
            (subst '(= f ENC-TRUTH))
            (ass))
          ;; [0, f] a right fold
          (let* ((r (dk-split! (dk-cite! 'tf-eql 'tt 'g 'a 'b 0 'f)))
                 (u0 '(ENC-AND ENC-TRUTH f)))
            (dk-rewrite-h! (mn-iff 'g top '(ENC-AND (ENC-EQL a b 0) f)) '(ENC-EQL a b 0) (caddr (dk-cite! 'enc-eql-zero 'a 'b)))
            (dk-cite! 'der-and-truth 'tt 'g 'f)
            (dk-cite! 'der-iff-trans 'tt 'g top u0 'f)
            (dk-cite! 'der-iff-trans 'tt 'g uu top 'f)
            (mn-close!))))))
(qed 'der-tuple-eq-decompose)

;; THE LOCAL REDEXES are inside EQV(T), for every T
(sp (make-wff '(FORALL tt (SUBSET (J-TEQ tt) (EQV tt)))))
(di)
(mac 'J-TEQ)
(mac 'subset-def)
(dk-peel!)
(let* ((mm (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) (dk-asms)))
       (y (cadr mm))
       (landed (dk-landed (lambda () (sep-me mm))))
       (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) landed))
       (vs (dk-meta-unpack! ex))
       (g (car vs)) (a (cadr vs)) (b (caddr vs)) (f (cadddr vs))
       (uu `(ENC-EQ (ENC-LIST ,a) (ENC-LIST ,b))) (lit `(LIST 2 ,g ,uu ,f)))
  (dk-split-all!)
  (if (not (dk-asm? `(= ,y ,lit))) (error "j-teq-sub: the redex tuple is not" (expression->string lit)))
  (dk-rewrite-h! `(IN ,y RW-UNIV) y lit)
  (dk-cite! 'rw-univ-ctx 2 g uu f)
  (dk-cite! 'der-tuple-eq-decompose 'tt g a b f)
  (subst `(= ,y ,lit))
  (dk-cite! 'eqv-f-intro 'tt g uu f)
  (ass))
(qed 'j-teq-sub)

(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (REL-TUPLE-EQ-DECOMPOSE-1 tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
(dk-peel!)
(mac-h 'REL-TUPLE-EQ-DECOMPOSE-1 '(REL-TUPLE-EQ-DECOMPOSE-1 tt hs c))
(dk-cite! 'j-teq-sub 'tt)
(dk-cite! 'adm-rewrite-1 'tt '(J-TEQ tt) 'hs 'c)
(ass)
(qed 'adm-tuple-eq-decompose-1)
(sp (make-wff '(FORALL tt (FORALL hs (FORALL c
   (IMPLIES (REL-TUPLE-EQ-DECOMPOSE-7 tt hs c) (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
(dk-peel!)
(mac-h 'REL-TUPLE-EQ-DECOMPOSE-7 '(REL-TUPLE-EQ-DECOMPOSE-7 tt hs c))
(dk-cite! 'j-teq-sub 'tt)
(dk-cite! 'adm-rewrite-7 'tt '(J-TEQ tt) 'hs 'c)
(ass)
(qed 'adm-tuple-eq-decompose-7)

;;; -----------------------------------------------------------------------
;;; D. THE CERTIFICATE AS A WHOLE (agent BRIDGE, 2026-11-19; structure-library/meta-nbg.scm, section D).  The least set
;;; DEF-DERIVABLE(T) of the sequents the definedness rows reach is included in DERIVABLE(T) (every row of DEF-RULE is
;;; admissible: lemma (*) for the rows it holds), and with it the kernel forms -KD of rows 8, 15, 24, 26, 27, the TRUTH
;;; arm of reflexivity and the adds-nothing arm are admissible.

(sp (make-wff '(FORALL mnkt_ (== (DEF-DERIVABLE mnkt_)
   (SEP mnkq_ SEQ-SET (FORALL mnks_ (IMPLIES (IN mnks_ (POWER SEQ-SET)) (IMPLIES (DEF-CLOSED mnkt_ mnks_) (IN mnkq_ mnks_)))))))))
(dk-peel!) (mac 'DEF-DERIVABLE) (qrfl)
(qed 'def-derivable-unfold)

(sp (make-wff '(FORALL tt (IN (DERIVABLE tt) (POWER SEQ-SET)))))
(dk-peel!)
(let* ((u (dk-cite! 'derivable-unfold 'tt)) (xs (caddr u)))
  (fact 'seq-set-is-set)
  (mn-sep-power! xs 'SEQ-SET)
  (subst u)
  (ass))
(qed 'derivable-in-power)

;; the closure law of each row of DEF-RULE (meta-core-laws.scm, meta-def-laws.scm, meta-ind-laws.scm)
(define mn-def-row-laws
  '((CR-ASSUMPTION . derivable-assumption) (CR-THEOREM-ASSUMPTION . derivable-theorem-assumption)
    (CR-REFLEXIVITY . derivable-reflexivity)
    (DEF-STRICT-IN-L . def-strict-in-l-admitted) (DEF-STRICT-IN-R . def-strict-in-r-admitted)
    (DEF-STRICT-EQ-L . adm-def-strict-eq-l) (DEF-STRICT-EQ-R . adm-def-strict-eq-r)
    (DEF-STRICT-ARG . def-strict-arg-admitted) (DEF-STRICT-DOM . def-strict-dom-admitted)
    (DEF-TOTAL . def-total-admitted) (DEF-BINDER . def-binder-admitted) (DEF-COMP . def-comp-admitted)
    (DEF-LIST . def-list-admitted) (DEF-STRICT-HYP . def-strict-hyp-derived) (DEF-NTH-LIST . def-nth-list-derived)
    (DEF-STRICT-PRED . def-strict-pred-admitted) (DEF-STRUCT-HYP . def-struct-hyp-derived)
    (DEF-PRED-UNFOLD . def-pred-unfold-derived) (DEF-PRED-HYP . def-pred-hyp-derived)
    (DEF-FUN-INST . def-fun-inst-derived) (DEF-FUN-STRICT . def-fun-strict-derived)
    (DEF-FUN-NTH . def-fun-nth-derived) (DEF-FUN-SEP . def-fun-sep-derived)
    (DEF-PRED-UNFOLD-N . def-pred-unfold-n-derived) (DEF-PRED-HYP-N . def-pred-hyp-n-derived)
    (DEF-CERT-HYP . def-cert-hyp-derived)))

;; DERIVABLE(T) is closed under the rows: lemma (*), row by row.
(sp (make-wff '(FORALL tt (DEF-CLOSED tt (DERIVABLE tt)))))
(dk-peel!)
(mac 'DEF-CLOSED)
(dk-peel!)
(let* ((r (find-first (lambda (f) (dk-head-is? f 'DEF-RULE)) (dk-asms)))
       (hs (caddr r)) (c (cadddr r))
       (o (dk-meta-iff-r! (dk-meta-iff! 'def-rule 'tt hs c))))
  (dk-meta-or-each! o
    (lambda (d)
      (if (dk-head-is? d 'AND)
          (let ((parts (dk-split-all! (list d))))
            (dk-cite! 'adm-def-strict-in-l-holds 'tt)
            (dk-cite! 'adm-def-strict-in-r-holds 'tt)
            (if (dk-contains? d 'DEF-APP)
                (dk-cite! 'adm-def-app 'tt hs c)
                (dk-cite! 'adm-def-len-tuples 'tt hs c)))
          (let ((law (assq (car d) mn-def-row-laws)))
            (if (not law) (error "def-closed-derivable: no closure law for the row" (car d)))
            (dk-cite! (cdr law) 'tt hs c)))
      (mn-close!))))
(qed 'def-closed-derivable)

;; LEMMA (*) for the rows of DEF-RULE: a sequent the rows reach is derivable.
(sp (make-wff '(FORALL tt (FORALL s (IMPLIES (IN s (DEF-DERIVABLE tt)) (IN s (DERIVABLE tt)))))))
(dk-peel!)
(let* ((m '(IN s (DEF-DERIVABLE tt)))
       (landed (dk-landed (lambda () (sep-me (dk-rewrite-h! m '(DEF-DERIVABLE tt) (caddr (dk-cite! 'def-derivable-unfold 'tt)))))))
       (u (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
  (dk-cite! 'derivable-in-power 'tt)
  (dk-cite! 'def-closed-derivable 'tt)
  (dk-apply! u '(DERIVABLE tt))
  (ass))
(qed 'def-derivable-sub)

;; ROW 15, forall-elim at a term certified by the rows.
(sp (make-wff (mn-adm-stmt 'REL-FORALL-ELIM-KD)))
(dk-peel!)
(let* ((vs (mn-rel-open! 'rel-forall-elim-kd 1)) (g (car vs)) (f (cadr vs)) (b (caddr vs)) (tm (cadddr vs))
       (op `(EXPR-OPEN ,b 0 ,tm)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g f)))
  (dk-cite! 'def-derivable-sub 'tt `(LIST ,g (ENC-EQ ,tm ,tm)))
  (dk-meta-derive! 'tt `(forall-elim (,g ==> ,f) (given (,(mn+ g op) ==> ,f)) (given (,g ==> (ENC-EQ ,tm ,tm)))))
  (mn-close!))
(qed 'adm-forall-elim-kd)

;; ROW 8, forsome-intro with a witness certified by the rows.
(sp (make-wff (mn-adm-stmt 'REL-FORSOME-INTRO-KD)))
(dk-peel!)
(let* ((vs (mn-rel-open! 'rel-forsome-intro-kd 1)) (g (car vs)) (b (cadr vs)) (tm (caddr vs))
       (op `(EXPR-OPEN ,b 0 ,tm)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g `(ENC-EX ,b))))
  (dk-cite! 'def-derivable-sub 'tt `(LIST ,g (ENC-EQ ,tm ,tm)))
  (dk-meta-derive! 'tt `(forsome-intro (,g ==> (ENC-EX ,b)) (given (,g ==> ,op)) (given (,g ==> (ENC-EQ ,tm ,tm)))))
  (mn-close!))
(qed 'adm-forsome-intro-kd)

;; ROW 24, reflexivity at a term certified by the rows, and at TRUTH.
(sp (make-wff (mn-adm-stmt 'REL-REFLEXIVITY-KD)))
(dk-peel!)
(let* ((vs (mn-rel-open! 'rel-reflexivity-kd 0)) (g (car vs)) (tm (cadr vs)))
  (dk-cite! 'def-derivable-sub 'tt `(LIST ,g (ENC-EQ ,tm ,tm)))
  (mn-close!))
(qed 'adm-reflexivity-kd)
(sp (make-wff (mn-adm-stmt 'REL-REFLEXIVITY-KT)))
(dk-peel!)
(let* ((vs (mn-rel-open! 'rel-reflexivity-kt 0)) (g (car vs)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g 'ENC-TRUTH)))
  (dk-meta-derive! 'tt `(truth-intro (,g ==> ENC-TRUTH)))
  (mn-close!))
(qed 'adm-reflexivity-kt)

;; ROWS 26, 27, the strict equation at a branch certified by the rows (mn-if-k! with the definedness from the rows).
(define (mn-if-kd! rel cr-rule side-of br-of)
  (sp (make-wff (mn-adm-stmt rel)))
  (dk-peel!)
  (let* ((vs (mn-rel-open! (string->symbol (string-downcase (symbol->string rel))) 2))
         (g (car vs)) (f (cadr vs)) (p (caddr vs)) (a (cadddr vs)) (b (list-ref vs 4))
         (br (br-of a b)) (ift `(ENC-IF ,p ,a ,b))
         (eqf `(ENC-EQ ,ift ,br)) (qq `(ENC-QEQ ,ift ,br)) (g2 (mn+ g eqf)) (g1 (mn+ g qq))
         (eap `(EAPP 8 (LIST ,ift ,br))) (ebb `(EAPP 8 (LIST ,br ,br))))
    (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g f)))
    (dk-cite! 'clf-eq-intro ift br)
    (dk-cite! 'clf-qeq-intro ift br)
    (dk-cite! 'clf-eq-intro br br)
    ;; the branch denotes: the rows
    (dk-cite! 'def-derivable-sub 'tt `(LIST ,g (ENC-EQ ,br ,br)))
    (let* ((u1 (dk-cite! 'enc-eq-unfold ift br)) (u2 (dk-cite! 'enc-eq-unfold br br)))
      (dk-rewrite-h! `(IN ,eqf CLF) eqf eap)
      (dk-rewrite-h! `(IN (ENC-EQ ,br ,br) CLF) `(ENC-EQ ,br ,br) ebb)
      (dk-rewrite-h! (mn-der g `(ENC-EQ ,br ,br)) `(ENC-EQ ,br ,br) ebb)
      (dk-have! '(IN 8 NN) (lambda () (arith)))
      (dk-meta-derive! 'tt `(lemma (,g1 ==> ,eap) der-atom-l (,g1 8 ,ift ,br ,br)
                              (assumption (,g1 ==> ,qq))
                              (weakening (,g1 ==> ,ebb) (given (,g ==> ,ebb)))))
      (dk-rewrite-h! (mn-der g1 eap) eap eqf))
    (dk-meta-derive! 'tt `(,cr-rule (,g ==> ,f) (given (,g ==> ,(side-of p)))
                            (cut (,g1 ==> ,f) (given (,g1 ==> ,eqf))
                                 (weakening (,(mn+ g1 eqf) ==> ,f) (given (,g2 ==> ,f))))))
    (mn-close!)))
(mn-if-kd! 'REL-IF-TRUE-KD 'if-true (lambda (p) p) (lambda (a b) a))
(qed 'adm-if-true-kd)
(mn-if-kd! 'REL-IF-FALSE-KD 'if-false (lambda (p) `(ENC-NOT ,p)) (lambda (a b) b))
(qed 'adm-if-false-kd)

;; THE ADDS-NOTHING ARM (forall-elim, forsome-elim, if-true, if-false, iota-in-elim): a weakening.
(sp (make-wff (mn-adm-stmt 'REL-ADDS-NOTHING-K)))
(dk-peel!)
(let* ((vs (let* ((r (dk-meta-iff-r! (dk-meta-iff! 'rel-adds-nothing-k 'tt 'hs 'c)))   ; no hs equation: open by hand
                   (parts (dk-split! r))
                   (ws (dk-meta-unpack! (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts)))
                   (ceq (dk-meta-eq-of 'c)))
              (subst ceq)
              (dk-rewrite-h! '(IN c SEQ-SET) 'c (caddr ceq))
              ws))
       (g (car vs)) (f (cadr vs)) (d (caddr vs)) (i (cadddr vs))
       (u (dk-cite! 'hyps-in-all 'hs '(DERIVABLE tt))))
  (dk-apply! u i)
  (dk-rewrite-h! `(IN (NTH ,i hs) (DERIVABLE tt)) `(NTH ,i hs) `(LIST ,d ,f))
  (dk-cite! 'derivable-weakening-c 'tt g f d)
  (mn-close!))
(qed 'adm-adds-nothing-k)

;;; -----------------------------------------------------------------------
;;; E. THE REWRITING RULES AT ANY FINITE SET OF POSITIONS (agent POSN, 2026-11-19; structure-library/meta-nbg.scm,
;;; section E).  REWRS(J) holds the one-position rewrites REWR(J, 7) (rewrs-base) and is closed under composing two
;;; formula rewrites in one context (rewrs-trans), with the empty rewrite (rewrs-refl): a rewrite at n positions is
;;; n one-position steps.  EQV(T) is closed under the same three clauses (eqv-rws-closed: the one-position law cr-7,
;;; der-iff-refl, der-iff-trans), so REWRS(J) is inside EQV(T) whenever J is (crs-s, the induction on the number of
;;; positions as the least-set induction of REWRS); the goal form and the assumption form follow as at one position
;;; (adm-rewrite-s, adm-rewrite-hyp-s), and each P1 row through its local step j-<rule>-sub.

(sp (make-wff '(FORALL mpoj_ (== (REWRS mpoj_)
   (SEP mpox_ RW-UNIV (FORALL mpos_ (IMPLIES (IN mpos_ (POWER RW-UNIV)) (IMPLIES (RWS-CLOSED mpoj_ mpos_) (IN mpox_ mpos_)))))))))
(di) (mac 'REWRS) (qrfl)
(qed 'rewrs-unfold)

;; REWRS is below every closed member of POWER(RW-UNIV).
(sp (make-wff '(FORALL jj (FORALL mpzS_ (IMPLIES (IN mpzS_ (POWER RW-UNIV)) (IMPLIES (RWS-CLOSED jj mpzS_)
   (FORALL x (IMPLIES (IN x (REWRS jj)) (IN x mpzS_)))))))))
(dk-peel!)
(let* ((m (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'REWRS))) (dk-asms)))
       (landed (dk-landed (lambda () (sep-me (dk-rewrite-h! m '(REWRS jj) (caddr (dk-cite! 'rewrs-unfold 'jj)))))))
       (u (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
  (dk-apply! u 'mpzS_)
  (ass))
(qed 'rewrs-least)

;; EQV(T) is closed under the three clauses: the one-position rewrite by CR (cr-7), the empty rewrite by
;; reflexivity of IFF, the composition by its transitivity.
(sp (make-wff '(FORALL tt (FORALL jj (IMPLIES (SUBSET jj (EQV tt)) (RWS-CLOSED jj (EQV tt)))))))
(dk-peel!)
(mac 'RWS-CLOSED)
(dk-peel!)
(let* ((xv (cadr (dk-goal)))
       (r (find-first (lambda (f) (dk-head-is? f 'RWS-RULE)) (dk-asms)))
       (o (dk-landed-1 (lambda () (mac-h 'RWS-RULE r)))))
  (dk-meta-or-each! o
    (lambda (d)
      (cond
        ((dk-head-is? d 'IN)
         (dk-cite! 'cr-7 'tt 'jj xv)
         (ass))
        (#t
         (let* ((vs (dk-meta-unpack! d)))
           (dk-split-all!)
           (if (= (length vs) 2)
               (let ((g (car vs)) (e (cadr vs)))
                 (subst `(= ,xv (LIST 2 ,g ,e ,e)))
                 (dk-cite! 'der-iff-refl 'tt g e)
                 (dk-cite! 'eqv-f-intro 'tt g e e)
                 (ass))
               (let ((g (car vs)) (a (cadr vs)) (b (caddr vs)) (c (cadddr vs)))
                 (subst `(= ,xv (LIST 2 ,g ,a ,c)))
                 (dk-split! (dk-cite! 'eqv-f-open 'tt g a b))
                 (dk-split! (dk-cite! 'eqv-f-open 'tt g b c))
                 (dk-cite! 'der-iff-trans 'tt g a b c)
                 (dk-cite! 'eqv-f-intro 'tt g a c)
                 (ass)))))))))
(qed 'eqv-rws-closed)

;; CR AT FINITELY MANY POSITIONS.
(sp (make-wff '(FORALL tt (FORALL jj (FORALL x
   (IMPLIES (SUBSET jj (EQV tt)) (IMPLIES (IN x (REWRS jj)) (IN x (EQV tt)))))))))
(dk-peel!)
(dk-cite! 'eqv-rws-closed 'tt 'jj)
(fact 'eqv-in-power 'tt)
(dk-apply! (dk-cite! 'rewrs-least 'jj '(EQV tt)) 'x)
(ass)
(qed 'crs-s)

;; THE CHAINS ARE IN REWRS: a one-position rewrite, the empty rewrite, and the composition of two.
(define (mpo-rewrs-in! x thunk)            ; goal (IN X (REWRS jj)), X in RW-UNIV in context; THUNK proves RWS-RULE
  (subst (dk-cite! 'rewrs-unfold 'jj))
  (in-sep!
    (lambda () (ass))
    (lambda ()
      (dk-peel!)
      (let* ((cl (find-first (lambda (f) (dk-head-is? f 'RWS-CLOSED)) (dk-asms)))
             (s (caddr cl)))
        (thunk s)
        (let ((u (dk-landed-1 (lambda () (mac-h 'RWS-CLOSED cl)))))
          (dk-apply! u x)
          (ass))))))

(sp (make-wff '(FORALL jj (FORALL x (IMPLIES (IN x (REWR jj 7)) (IN x (REWRS jj)))))))
(dk-peel!)
(let ((m '(IN x (REWR jj 7))))
  (sep-me (dk-rewrite-h! m '(REWR jj 7) (caddr (dk-cite! 'rewr-unfold 'jj 7))))
  (dk-split-all!)
  (mpo-rewrs-in! 'x
    (lambda (s) (dk-have! `(RWS-RULE jj ,s x) (lambda () (mac 'RWS-RULE) (oi-l) (ass))))))
(qed 'rewrs-base)

(sp (make-wff '(FORALL jj (FORALL g (FORALL e (IMPLIES (IN g CTX-SET) (IMPLIES (IN e CLF) (IN (LIST 2 g e e) (REWRS jj)))))))))
(dk-peel!)
(let ((x '(LIST 2 g e e)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'clf-iff 'e)))
  (dk-have! `(IN ,x RW-UNIV)
    (lambda () (subst (dk-cite! 'rw-univ-def)) (dk-have! '(IN 2 NN) (lambda () (arith))) (dk-meta-close-in!)))
  (mpo-rewrs-in! x
    (lambda (s)
      (dk-have! `(RWS-RULE jj ,s ,x)
        (lambda () (mac 'RWS-RULE) (oi-r) (oi-l) (ew 'g) (ew 'e)
          (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) '=) (rfl) (ass)))))))))
(qed 'rewrs-refl)

(sp (make-wff '(FORALL jj (FORALL g (FORALL a (FORALL b (FORALL c
   (IMPLIES (IN g CTX-SET) (IMPLIES (IN a EXPR-SET) (IMPLIES (IN b EXPR-SET) (IMPLIES (IN c EXPR-SET)
   (IMPLIES (IN (LIST 2 g a b) (REWRS jj)) (IMPLIES (IN (LIST 2 g b c) (REWRS jj)) (IN (LIST 2 g a c) (REWRS jj)))))))))))))))
(dk-peel!)
(let ((x '(LIST 2 g a c)) (xab '(LIST 2 g a b)) (xbc '(LIST 2 g b c)))
  (dk-have! `(IN ,x RW-UNIV)
    (lambda () (subst (dk-cite! 'rw-univ-def)) (dk-have! '(IN 2 NN) (lambda () (arith))) (dk-meta-close-in!)))
  (mpo-rewrs-in! x
    (lambda (s)
      (for-each (lambda (y) (dk-apply! (dk-cite! 'rewrs-least 'jj s) y)) (list xab xbc))
      (dk-have! `(RWS-RULE jj ,s ,x)
        (lambda () (mac 'RWS-RULE) (oi-r) (oi-r) (ew 'g) (ew 'a) (ew 'b) (ew 'c)
          (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) '=) (rfl) (ass)))))))))
(qed 'rewrs-trans)

;; THE GENERIC ADMISSIBILITY at finitely many positions: the goal, and one assumption.
(sp (make-wff '(FORALL tt (FORALL jj (FORALL hs (FORALL c
   (IMPLIES (SUBSET jj (EQV tt)) (IMPLIES (REL-REWRITE-S jj hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))))
(dk-peel!)
(let* ((parts (dk-split! (dk-landed-1 (lambda () (mac-h 'REL-REWRITE-S '(REL-REWRITE-S jj hs c))))))
       (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts))
       (vs (dk-meta-unpack! ex)) (g (car vs)) (a (cadr vs)) (b (caddr vs)))
  (dk-split-all!)
  (subst `(= c (LIST ,g ,a)))
  (dk-rewrite-h! '(HYPS-IN hs (DERIVABLE tt)) 'hs `(LIST (LIST ,g ,b)))
  (dk-have! `(= (LIST (LIST ,g ,b)) (LIST (LIST ,g ,b))) (lambda () (rfl)))
  (dk-cite! 'hyps-in-1-elim `(LIST ,g ,b) '(DERIVABLE tt))
  (dk-cite! 'crs-s 'tt 'jj `(LIST 2 ,g ,a ,b))
  (dk-split! (dk-cite! 'eqv-f-open 'tt g a b))
  (dk-cite! 'der-iff-l 'tt g a b)
  (ass))
(qed 'adm-rewrite-s)

(sp (make-wff '(FORALL tt (FORALL jj (FORALL hs (FORALL c
   (IMPLIES (SUBSET jj (EQV tt)) (IMPLIES (REL-REWRITE-HYP-S jj hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))))
(dk-peel!)
(let* ((parts (dk-split! (dk-landed-1 (lambda () (mac-h 'REL-REWRITE-HYP-S '(REL-REWRITE-HYP-S jj hs c))))))
       (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts))
       (vs (dk-meta-unpack! ex)) (g (car vs)) (f (cadr vs)) (a (caddr vs)) (b (cadddr vs))
       (gd `(CTX-ADD (DIFFERENCE ,g (PAIR ,a ,a)) ,b)) (gb `(CTX-ADD ,g ,b)))
  (dk-split-all!)
  (dk-rewrite-h! '(IN c SEQ-SET) 'c `(LIST ,g ,f))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g f)))
  (subst `(= c (LIST ,g ,f)))
  (dk-rewrite-h! '(HYPS-IN hs (DERIVABLE tt)) 'hs `(LIST (LIST ,gd ,f)))
  (dk-have! `(= (LIST (LIST ,gd ,f)) (LIST (LIST ,gd ,f))) (lambda () (rfl)))
  (dk-cite! 'hyps-in-1-elim `(LIST ,gd ,f) '(DERIVABLE tt))
  (dk-cite! 'crs-s 'tt 'jj `(LIST 2 ,g ,a ,b))
  (dk-split! (dk-cite! 'eqv-f-open 'tt g a b))
  (dk-meta-seq! g a)
  (dk-cite! 'derivable-assumption-c 'tt g a)
  (dk-cite! 'der-iff-r 'tt g a b)
  (dk-meta-set-of! b 'CLF)
  (dk-cite! 'ctx-diff-sub g `(PAIR ,a ,a))
  (dk-cite! 'ctx-sub-snoc `(DIFFERENCE ,g (PAIR ,a ,a)) g b)
  (dk-cite! 'ctx-add-has g b)
  (dk-cite! 'ctx-sub-cons `(DIFFERENCE ,g (PAIR ,a ,a)) gb b)
  (dk-cite! 'ctx-add-ctx g b)
  (dk-meta-seq! gb f)
  (dk-cite! 'derivable-weakening-c 'tt gb f gd)
  (dk-cite! 'derivable-cut-c 'tt g f b)
  (ass))
(qed 'adm-rewrite-hyp-s)

;; THE NINE P1 ROWS at finitely many positions.
(define (mpo-adm-s! rel j jsub generic)
  (sp (make-wff `(FORALL tt (FORALL hs (FORALL c
       (IMPLIES (,rel tt hs c) (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
  (dk-peel!)
  (mac-h rel `(,rel tt hs c))
  (dk-cite! jsub 'tt)
  (dk-cite! generic 'tt `(,j tt) 'hs 'c)
  (ass))
(mpo-adm-s! 'REL-NTH-REDUCE-S 'J-NTH 'j-nth-sub 'adm-rewrite-s)
(qed 'adm-nth-reduce-s)
(mpo-adm-s! 'REL-LENGTH-REDUCE-S 'J-LEN 'j-len-sub 'adm-rewrite-s)
(qed 'adm-length-reduce-s)
(mpo-adm-s! 'REL-FUNCTOID-BETA-S 'J-FB 'j-fb-sub 'adm-rewrite-s)
(qed 'adm-functoid-beta-s)
(mpo-adm-s! 'REL-LAMBDA-BETA-S 'J-LB 'j-lb-sub 'adm-rewrite-s)
(qed 'adm-lambda-beta-s)
(mpo-adm-s! 'REL-LAMBDA-BETA-HYP-S 'J-LB 'j-lb-sub 'adm-rewrite-hyp-s)
(qed 'adm-lambda-beta-hyp-s)
(mpo-adm-s! 'REL-MACETE-S 'J-MAC 'j-mac-sub 'adm-rewrite-s)
(qed 'adm-macete-s)
(mpo-adm-s! 'REL-MACETE-HYP-S 'J-MAC 'j-mac-sub 'adm-rewrite-hyp-s)
(qed 'adm-macete-hyp-s)
(mpo-adm-s! 'REL-MACETE-N-S 'J-MACN 'j-macn-sub 'adm-rewrite-s)
(qed 'adm-macete-n-s)
(mpo-adm-s! 'REL-MACETE-N-HYP-S 'J-MACN 'j-macn-sub 'adm-rewrite-hyp-s)
(qed 'adm-macete-n-hyp-s)
(mpo-adm-s! 'REL-UNION-DECOMPOSE-S 'J-UDEC 'j-udec-sub 'adm-rewrite-s)
(qed 'adm-union-decompose-s)
(mpo-adm-s! 'REL-UNION-DECOMPOSE-HYP-S 'J-UDEC 'j-udec-sub 'adm-rewrite-hyp-s)
(qed 'adm-union-decompose-hyp-s)
(mpo-adm-s! 'REL-INTERSECTION-DECOMPOSE-S 'J-IDEC 'j-idec-sub 'adm-rewrite-s)
(qed 'adm-intersection-decompose-s)
(mpo-adm-s! 'REL-INTERSECTION-DECOMPOSE-HYP-S 'J-IDEC 'j-idec-sub 'adm-rewrite-hyp-s)
(qed 'adm-intersection-decompose-hyp-s)
(mpo-adm-s! 'REL-TUPLE-EQ-DECOMPOSE-S 'J-TEQ 'j-teq-sub 'adm-rewrite-s)
(qed 'adm-tuple-eq-decompose-s)
(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (SUBSET tt CLF) (IMPLIES (IN AX-MEM-SET tt)
   (IMPLIES (REL-CARTESIAN-DECOMPOSE-S tt hs c) (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))))
(dk-peel!)
(mac-h 'REL-CARTESIAN-DECOMPOSE-S '(REL-CARTESIAN-DECOMPOSE-S tt hs c))
(dk-cite! 'j-cart-sub 'tt)
(dk-cite! 'adm-rewrite-s 'tt '(J-CART tt) 'hs 'c)
(ass)
(qed 'adm-cartesian-decompose-s)

;;; K1FIX (2026-11-19): the certified forms of tuples-intro at the empty tuple and of lambda-type at one binder
;;; (structure-library/meta-nbg.scm, end): the definedness sequent the core owes is derived from the context
;;; certificate (assumption, adm-cert), then the owed form (adm-tuples-intro-0) or the core rule.
(sp (make-wff (mn-adm-stmt 'REL-TUPLES-INTRO-0K)))
(dk-peel!)
(let* ((vs (mn-rel-open! 'rel-tuples-intro-0k 0)) (g (car vs)) (l (cadr vs)) (a (caddr vs)) (h (cadddr vs))
       (c `(LIST ,g (ENC-IN (ENC-LIST ,l) (ENC-TUPLES ,a)))) (ea `(ENC-EQ ,a ,a)) (hs1 `(LIST (LIST ,g ,ea))))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g (caddr c))))
  (dk-meta-derive! 'tt `(assumption (,g ==> ,h)))
  (dk-cite! 'adm-cert 'tt g a h)
  (dk-have! `(REL-TUPLES-INTRO-0 tt ,hs1 ,c)
    (lambda () (mac 'REL-TUPLES-INTRO-0) (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'FORSOME) (dk-meta-ex-fill! (list g l a)) (ass))))))
  (dk-have! `(HYPS-IN ,hs1 (DERIVABLE tt)) (lambda () (fact 'hyps-in-1 `(LIST ,g ,ea) '(DERIVABLE tt)) (ass)))
  (dk-cite! 'adm-tuples-intro-0 'tt hs1 c)
  (mn-close!))
(qed 'adm-tuples-intro-0k)

(sp (make-wff (mn-adm-stmt 'REL-LAMBDA-TYPE-K)))
(dk-peel!)
(let* ((vs (mn-rel-open! 'rel-lambda-type-k 2)) (g (car vs)) (a (cadr vs)) (b (caddr vs)) (d (cadddr vs)) (h (list-ref vs 4))
       (goal `(ENC-IN (ENC-LAM ,a ,b) (ENC-FUN ,a ,d)))
       (ty `(ENC-ALL (ENC-IMP (ENC-IN (EBVAR 0) ,a) (ENC-IN ,b ,d)))) (sh `(ENC-IN ,a ENC-SETC)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g goal)))
  (dk-meta-derive! 'tt `(assumption (,g ==> ,h)))
  (dk-cite! 'adm-cert 'tt g d h)
  (dk-meta-derive! 'tt `(lambda-type (,g ==> ,goal) (given (,g ==> ,ty)) (given (,g ==> ,sh)) (given (,g ==> (ENC-EQ ,d ,d)))))
  (mn-close!))
(qed 'adm-lambda-type-k)
