;;; ca-lft-sl2.scm -- Cor. 1.20 of complex-analysis.pdf: S |-> L_S restricted to the matrices of
;;; determinant 1 is a surjective homomorphism onto the linear fractional transformations, with
;;; kernel {I, -I}.
;;; CA-LFT, 2026-10-19.  Library: complex-analysis.  Vocabulary: structure-library/ca-lft-vocab.scm.
;;;
;;;   cc-sqrt-exists          every nonzero complex number is a square   (through exp on its strip)
;;;   homog-point-scale       phi(k u, k v) = phi(u, v)                  (k /= 0)
;;;   lft-scale-invariant     LFT(k a, k b, k c, k d) = LFT(a, b, c, d)  (k /= 0, ad - bc /= 0)
;;;   sl2-matmul-closed       det S = det T = 1 gives det ST = 1
;;;   sl2-lft-hom             L_(ST) = L_S o L_T on determinant-1 matrices    (Cor. 1.20)
;;;   sl2-lft-onto            every LFT is L_S with det S = 1                 (Cor. 1.20, the notes' proof)
;;;   sl2-lft-kernel          for det S = 1: L_S = id iff S = I or S = -I     (Cor. 1.20)
;;;
;;; Helper prefix cls-.

(define cls-r '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))

(define (cls-finish-ass!)
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))
(define (cls-finish!)
  (let ((leaf (proof-state-focus *ps*)))
    (if (not (sequent-node-grounded? leaf))
        (if (and (dk-head-is? (dk-goal) '=) (equal? (cadr (dk-goal)) (caddr (dk-goal))))
            (rfl)
            (ass)))))
(define (cls-type! t)
  (if (not (dk-asm? (list 'IN t 'CC)))
      (dk-have! (list 'IN t 'CC) (lambda () (type-term)))))
(define (cls-rewrite! s t prove)
  (if (not (equal? s t))
      (begin (dk-have! (list '= s t) prove) (subst (list '= s t)))))
(define (cls-crs-rewrite! s t) (cls-rewrite! s t (lambda () (crs))))
(define (cls-conj fs)
  (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (cls-conj (cdr fs)))))
(define (cls-cite-and! thm fs . terms)
  (let ((c (cls-conj fs)))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    (apply dk-cite! thm terms)))
(define (cls-vars landed)
  (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)))) landed)))
(define (cls-recip! y)
  (if (not (dk-asm? (list 'IN (list 'recip y) 'CC)))
      (cls-cite-and! 'cc-recip-closed (list (list 'IN y 'CC) (list 'NOT (list '= y 0))) y)))

;;; exp(z) in CC and exp(z) /= 0, z typed in CC
(define (cls-exp-parts! z)
  (let* ((m   (dk-cite! 'cc-exp-maps-to-nonzero z))
         (iff (dk-cite! 'cc-nonzero-membership (list 'CC-EXP z))))
    (dk-have! (caddr iff) (lambda () (dk-only! iff m) (prop)))
    (dk-split-all! (list (caddr iff)))))

;;; ---------------------------------------------------------------------------
;;; Square roots: d = exp(z) for z in the strip, and r = exp(z/2).

(sp (make-wff "forall([d in cc], not(d = 0) implies forsome([r in cc], r * r = d))"))
(let* ((vs (cls-vars (dk-peel!))) (d (car vs)))
  (let* ((bj  (fact 'cc-exp-bijection-strip))
         (thm (lookup-theorem 'cc-exp-bijection-strip))
         (lam (cadr thm))
         (strip (caddr lam))
         (iff (dk-cite! 'bijection-membership-iff strip '(DIFFERENCE CC (SINGLETON 0)) lam)))
    (dk-have! (caddr iff) (lambda () (dk-only! iff thm) (prop)))
    (dk-split-all!)
    (let ((nzm (dk-cite! 'cc-nonzero-membership d)))
      (dk-have! (list 'IN d '(DIFFERENCE CC (SINGLETON 0))) (lambda () (dk-only! nzm (list 'IN d 'CC) (list 'NOT (list '= d 0))) (prop))))
    (let* ((onto (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'FORSOME) (dk-contains? h lam))) (dk-asms)))
           (ex (dk-apply! onto d))
           (z (dk-skolem! ex)))
      (dk-have! (list 'IN z 'CC) (lambda () (sep-me (list 'IN z strip)) (cls-finish-ass!)))
      (cls-exp-parts! z)
      (dk-have! (list '= (list 'CC-EXP z) d)
        (lambda () (subst (list '= d (list lam z))) (dk-lam-b!) (cls-finish!)))
      (fact 'cc-one-in)
      (dk-have! '(NOT (= 2 0)) (lambda () (arith)))
      (dk-have! '(IN 2 CC) (lambda () (type-term)))
      (cls-recip! 2)
      (let* ((h (list '* z (list 'recip 2))))
        (cls-type! h)
        (cls-cite-and! 'cc-recip-inverse (list '(IN 2 CC) '(NOT (= 2 0))) 2)
        (cls-exp-parts! h)
        (ew (list 'CC-EXP h))
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) '=)
                (let ((e (list 'CC-EXP h)))
                  (dk-cite! 'cc-exp-add h h)
                  (subst (list '= (list '* e e) (list 'CC-EXP (list '+ h h))))
                  (let ((q (dk-name! '(recip 2) 'CC)))
                    (dk-have! (list '= (list '+ h h) z)
                      (lambda ()
                        (subst (list '= '(recip 2) q))
                        (dk-rewrite-h! '(= (* 2 (recip 2)) 1) '(recip 2) q)
                        (cls-crs-rewrite! (list '+ (list '* z q) (list '* z q)) (list '* z (list '* 2 q)))
                        (subst (list '= (list '* 2 q) 1))
                        (crs))))
                  (subst (list '= (list '+ h h) z))
                  (cls-finish-ass!))
                (cls-finish-ass!))))))))
(qed 'cc-sqrt-exists)

;;; ---------------------------------------------------------------------------
;;; Scaling: homogeneous coordinates and coefficients are defined up to a nonzero factor.

(sp (make-wff "forall([u in cc, v in cc, k in cc], not(k = 0) implies homog-point(k * u, k * v) = homog-point(u, v))"))
(let* ((vs (cls-vars (dk-peel!))) (u (car vs)) (v (cadr vs)) (k (caddr vs)))
  (cls-type! (list '* k u)) (cls-type! (list '* k v))
  (use-em (list '= v 0)
    (lambda ()
      (cls-rewrite! (list '* k v) 0 (lambda () (subst (list '= v 0)) (crs)))
      (subst (list '= v 0))
      (subst (dk-cite! 'homog-point-at-inf (list '* k u)))
      (subst (dk-cite! 'homog-point-at-inf u))
      (cls-finish!))
    (lambda ()
      (dk-cite! 'cc-mul-nonzero k v)
      (subst (dk-cite! 'homog-point-finite (list '* k u) (list '* k v)))
      (subst (dk-cite! 'homog-point-finite u v))
      (cls-crs-rewrite! (list '* k u) (list '* u k))
      (cls-crs-rewrite! (list '* k v) (list '* v k))
      (subst (dk-cite! 'cc-div-cancel u v k))
      (cls-finish!))))
(qed 'homog-point-scale)

(sp (make-wff "forall([a in cc, b in cc, c in cc, d in cc, k in cc], not(a * d - b * c = 0) implies not(k = 0) implies lft(k * a, k * b, k * c, k * d) = lft(a, b, c, d))"))
(let* ((vs (cls-vars (dk-peel!)))
       (a (list-ref vs 0)) (b (list-ref vs 1)) (c (list-ref vs 2)) (d (list-ref vs 3)) (k (list-ref vs 4))
       (ks (map (lambda (x) (list '* k x)) (list a b c d)))
       (l1 (cons 'LFT ks)) (l2 (list 'LFT a b c d))
       (dt (list '- (list '* a d) (list '* b c))))
  (for-each cls-type! ks) (cls-type! dt)
  (dk-cite! 'cc-mul-nonzero k k)
  (cls-type! (list '* k k))
  (dk-cite! 'cc-mul-nonzero (list '* k k) dt)
  (let ((kdt (list '- (list '* (car ks) (cadddr ks)) (list '* (cadr ks) (caddr ks)))))
    (dk-have! (list 'NOT (list '= kdt 0))
      (lambda () (cls-crs-rewrite! kdt (list '* (list '* k k) dt)) (cls-finish-ass!))))
  (apply dk-cite! 'lft-in-fun ks)
  (apply dk-cite! 'lft-in-fun (list a b c d))
  (fact 'cc-hat-in-set)
  (dk-fun-ext! l1 l2 'CC-HAT 'CC-HAT #f #f
    (lambda (z)
      (let* ((u (dk-skolem! (dk-cite! 'homog-point-cover z)))
             (ex (or (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (memq u (free-vars f)))) (dk-asms))
                     (error "lft-scale-invariant: no inner existential")))
             (v (dk-skolem! ex))
             (h (list 'HOMOG-POINT u v))
             (p (list '+ (list '* a u) (list '* b v)))
             (q (list '+ (list '* c u) (list '* d v))))
        (subst (list '= z h))
        (cls-type! p) (cls-type! q)
        (subst (apply dk-cite! 'lft-homog (append ks (list u v))))
        (subst (dk-cite! 'lft-homog a b c d u v))
        (let* ((g (dk-goal)) (x1 (cadr (cadr g))) (y1 (caddr (cadr g))))
          (cls-crs-rewrite! x1 (list '* k p))
          (cls-crs-rewrite! y1 (list '* k q))
          (subst (dk-cite! 'homog-point-scale p q k))
          (dk-cite! 'homog-point-in-cc-hat p q)
          (cls-finish!))))))
(qed 'lft-scale-invariant)

;;; ---------------------------------------------------------------------------
;;; Cor. 1.20.

(define (cls-det1 s) (list '= (list 'DET cls-r 2 s) 1))
(define (cls-det-of s)
  (list '- (list '* (list 'ENTRY s 1 1) (list 'ENTRY s 2 2)) (list '* (list 'ENTRY s 1 2) (list 'ENTRY s 2 1))))

;;; det S = 1, S in MAT(2,2,CC): S is invertible
(define (cls-invertible! s)
  (dk-cite! 'cc-det-2x2 s)
  (dk-have! (list 'NOT (list '= (cls-det-of s) 0))
    (lambda ()
      (subst (list '= (cls-det-of s) (list 'DET cls-r 2 s)))
      (subst (list '= (list 'DET cls-r 2 s) 1))
      (arith)))
  (dk-cite! 'cc-det-nonzero-invertible s))

(define (cls-ring!)
  (fact 'cc-is-normed-field)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
  (dk-cite! 'commutative-ring-is-ring cls-r))

(define (cls-mat-carr! t)
  (let ((f (list 'IN t (list 'MAT 2 2 (list 'CARR cls-r)))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (mac 'cc-scalar-ring-carr) (cls-finish-ass!))))
    f))

;;; The set of matrices of determinant 1 is closed under products (the notes: "is a group").
(sp (make-wff `(FORALL s (IMPLIES (IN s (MAT 2 2 CC)) (IMPLIES ,(cls-det1 's) (FORALL t (IMPLIES (IN t (MAT 2 2 CC))
      (IMPLIES ,(cls-det1 't) ,(cls-det1 (list 'MATMUL cls-r 's 't))))))))))
(dk-peel!)
(cls-ring!)
(cls-mat-carr! 's) (cls-mat-carr! 't)
(dk-have! '(IN 2 NN) (lambda () (arith)))
(subst (dk-cite! 'det-multiplicative cls-r 2 's 't))
(subst (cls-det1 's))
(subst (cls-det1 't))
(fact 'cc-one-in)
(mac 'cc-scalar-ring-mul)
(dk-lam-b!)
(if (not (sequent-node-grounded? (proof-state-focus *ps*))) (crs))
(qed 'sl2-matmul-closed)

(sp (make-wff `(FORALL s (IMPLIES (IN s (MAT 2 2 CC)) (IMPLIES ,(cls-det1 's) (FORALL t (IMPLIES (IN t (MAT 2 2 CC))
      (IMPLIES ,(cls-det1 't) (= (MAT-LFT (MATMUL ,cls-r s t)) (COMPOSE (MAT-LFT s) (MAT-LFT t)))))))))))
(dk-peel!)
(cls-invertible! 's)
(cls-invertible! 't)
(dk-cite! 'mat-lft-hom 's 't)
(cls-finish-ass!)
(qed 'sl2-lft-hom)

(define (cls-lit-entries! m)
  (let* ((a (cadr (cadr m))) (b (caddr (cadr m))) (c (cadr (caddr m))) (d (caddr (caddr m))))
    (dk-split-all! (list (dk-cite! 'cc-mat22-entries a b c d)))))

(define (cls-subst-entry-eqs!)
  (let loop ((fuel 40))
    (let ((eq (find-first (lambda (h) (and (dk-head-is? h '=) (dk-head-is? (cadr h) 'ENTRY)
                                           (not (dk-head-is? (caddr h) 'ENTRY))
                                           (dk-contains? (dk-goal) (cadr h))))
                          (dk-asms))))
      (if (and eq (> fuel 0))
          (begin (subst eq) (loop (- fuel 1)))))))

(define (cls-skolem-tower! f n)
  (let loop ((k n) (acc '()))
    (if (= k 0)
        (reverse acc)
        (let ((ex (or (find-first (lambda (h) (and (dk-head-is? h 'FORSOME) (memq f (free-vars h)))) (dk-asms))
                      (error "cls-skolem-tower!: no existential"))))
          (loop (- k 1) (cons (dk-skolem! ex) acc))))))

;;; Every linear fractional transformation is L_S with det S = 1: the notes' r^-1 S, r^2 = det S.
(sp (make-wff `(FORALL f (IMPLIES (IN f LFTS)
      (FORSOME s (AND (IN s (MAT 2 2 CC)) (AND ,(cls-det1 's) (= f (MAT-LFT s)))))))))
(let ((f (car (cls-vars (dk-peel!)))))
  (let ((sepm (list 'IN f (caddr (lookup-theorem 'lfts-def)))))
    (fact 'lfts-def)
    (dk-have! sepm (lambda () (subst (list '= (caddr (lookup-theorem 'lfts-def)) 'LFTS)) (cls-finish-ass!)))
    (sep-me sepm))
  (let* ((vs (cls-skolem-tower! f 4))
         (a (car vs)) (b (cadr vs)) (c (caddr vs)) (d (cadddr vs))
         (dt (list '- (list '* a d) (list '* b c))))
    (cls-type! dt)
    (let* ((r (dk-skolem! (dk-cite! 'cc-sqrt-exists dt))))
      (dk-have! (list 'NOT (list '= r 0))
        (lambda ()
          (di)
          (dk-have! (list '= dt 0) (lambda () (subst (list '= dt (list '* r r))) (subst (list '= r 0)) (crs)))
          (dk-only! (list '= dt 0) (list 'NOT (list '= dt 0)))
          (prop)))
      (cls-recip! r)
      (cls-cite-and! 'cc-recip-inverse (list (list 'IN r 'CC) (list 'NOT (list '= r 0))) r)
      (let ((k (dk-name! (list 'recip r) 'CC)))
        (dk-rewrite-h! (list '= (list '* r (list 'recip r)) 1) (list 'recip r) k)
        (dk-have! (list 'NOT (list '= k 0))
          (lambda ()
            (di)
            (dk-have! '(= 1 0) (lambda () (subst (list '= 1 (list '* r k))) (subst (list '= k 0)) (crs)))
            (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
            (dk-only! '(= 1 0) '(NOT (= 1 0)))
            (prop)))
        (let* ((ks (map (lambda (x) (list '* k x)) (list a b c d)))
               (lit (list 'LIST (list 'LIST (car ks) (cadr ks)) (list 'LIST (caddr ks) (cadddr ks)))))
          (for-each cls-type! ks)
          (dk-cite! 'mat22-literal-in-mat 'CC (car ks) (cadr ks) (caddr ks) (cadddr ks))
          (cls-lit-entries! lit)
          (dk-cite! 'cc-det-2x2 lit)
          (dk-have! (cls-det1 lit)
            (lambda ()
              (subst (list '= (list 'DET cls-r 2 lit) (cls-det-of lit)))
              (cls-subst-entry-eqs!)
              (cls-crs-rewrite! (cadr (dk-goal)) (list '* (list '* k k) dt))
              (subst (list '= dt (list '* r r)))
              (cls-crs-rewrite! (list '* (list '* k k) (list '* r r)) (list '* (list '* r k) (list '* r k)))
              (subst (list '= (list '* r k) 1))
              (crs)))
          (let ((ml (apply dk-cite! 'mat-lft-literal ks))
                (sc (dk-cite! 'lft-scale-invariant a b c d k)))
            (ew lit)
            (dk-conj-close!
              (lambda ()
                (if (and (dk-head-is? (dk-goal) '=) (equal? (cadr (dk-goal)) f))
                    (begin (subst ml) (subst sc)))
                (cls-finish-ass!)))))))))
(qed 'sl2-lft-onto)

;;; The kernel on determinant-1 matrices: {I, -I}.
(define cls-i  '(LIST (LIST 1 0) (LIST 0 1)))
(define cls-mi '(LIST (LIST (- 1) 0) (LIST 0 (- 1))))
(define cls-id '(ID-FUN CC-HAT))

(sp (make-wff `(FORALL s (IMPLIES (IN s (MAT 2 2 CC)) (IMPLIES ,(cls-det1 's)
      (IFF (= (MAT-LFT s) (ID-FUN CC-HAT)) (OR (= s ,cls-i) (= s ,cls-mi))))))))
(dk-peel!)
(cls-invertible! 's)
(fact 'cc-zero-in) (fact 'cc-one-in)
(cls-type! '(- 1))
(let* ((kern (dk-cite! 'mat-lft-kernel 's))
       (ex (caddr kern)))
  (dk-iff! (lambda (g) (dk-head-is? g 'OR))
    (lambda ()
      (dk-have! ex (lambda () (dk-only! kern (list '= '(MAT-LFT s) cls-id)) (prop)))
      (let* ((r (dk-skolem! ex))
             (lit (list 'LIST (list 'LIST r 0) (list 'LIST 0 r))))
        (dk-cite! 'mat22-literal-in-mat 'CC r 0 0 r)
        (cls-lit-entries! lit)
        (dk-cite! 'cc-det-2x2 lit)
        (let ((h2 (dk-rewrite-h! (cls-det1 's) 's lit)))
          (dk-have! (list '= (list '* r r) 1)
            (lambda ()
              (cls-rewrite! (list '* r r) (cls-det-of lit) (lambda () (cls-subst-entry-eqs!) (crs)))
              (subst (list '= (cls-det-of lit) (list 'DET cls-r 2 lit)))
              (cls-finish-ass!))))
        (cls-type! (list '+ r 1)) (cls-type! (list '- r 1))
        (use-em (list '= (list '+ r 1) 0)
          (lambda ()
            (dk-have! (list '= r '(- 1))
              (lambda () (cls-crs-rewrite! r (list '- (list '+ r 1) 1)) (subst (list '= (list '+ r 1) 0)) (crs)))
            (dk-have! (list '= 's cls-mi) (lambda () (subst (list '= 's lit)) (subst (list '= r '(- 1))) (cls-finish!)))
            (dk-only! (list '= 's cls-mi))
            (prop))
          (lambda ()
            (dk-have! (list '= (list '* (list '- r 1) (list '+ r 1)) 0)
              (lambda () (cls-crs-rewrite! (list '* (list '- r 1) (list '+ r 1)) (list '- (list '* r r) 1))
                         (subst (list '= (list '* r r) 1)) (crs)))
            (dk-cite! 'cc-mul-zero-left (list '- r 1) (list '+ r 1))
            (dk-have! (list '= r 1)
              (lambda () (cls-crs-rewrite! r (list '+ (list '- r 1) 1)) (subst (list '= (list '- r 1) 0)) (crs)))
            (dk-have! (list '= 's cls-i) (lambda () (subst (list '= 's lit)) (subst (list '= r 1)) (cls-finish!)))
            (dk-only! (list '= 's cls-i))
            (prop)))))
    (lambda ()
      (let ((orf (list 'OR (list '= 's cls-i) (list '= 's cls-mi))))
        (dk-have! ex
          (lambda ()
            (use-cases orf
              (lambda () (ew 1) (dk-conj-close! (lambda () (cls-finish-ass!))))
              (lambda () (ew '(- 1)) (dk-conj-close! (lambda () (cls-finish-ass!)))))))
        (dk-only! kern ex)
        (prop)))))
(qed 'sl2-lft-kernel)
