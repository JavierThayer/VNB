;;; ch3d-rm.scm -- CH3-D: Proposition 10.16 and Corollary 10.17 (the reduction step of the Riemann
;;; mapping theorem).  An open simply connected u missing a point a carries a bounded simple
;;; (injective) holomorphic function, and a simple holomorphic map into the open unit disc whose image
;;; contains 0.  The notes take a ball inside g(V) from the Open Mapping Theorem (4.26), which the tree
;;; does not have; here the gap of g(u) around g(v) + 2 pi i is proved from the continuity of g at v and
;;; the estimate |exp w - 1 - w| <= |w|^2 (cc-exp-near-one) instead.  Needs: ch3d-log
;;; (holomorphic-log-sc-exists), ch3b-const (holomorphic-continuous-mag).  Library: complex-analysis.
;;; Helper prefix: rm-.

(define (rm-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "rm-pick: nothing matching" what) (car l))))
(define (rm-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (rm-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (rm-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))
(define (rm-mag! t) (rm-cc! t) (fact 'cc-magnitude-closed t) (fact 'cc-magnitude-nonneg t) (list 'magnitude t))
(define rm-tpi '(* (* 2 PI) +i))
(define (rm-inj h)
  (list 'FORALL 'rmz_ (list 'IMPLIES '(IN rmz_ u) (list 'FORALL 'rmw_ (list 'IMPLIES '(IN rmw_ u)
    (list 'IMPLIES (list '= (list h 'rmz_) (list h 'rmw_)) '(= rmz_ rmw_)))))))
(define (rm-sc-split!)
  (let ((rhs (caddr (dk-cite! 'simply-connected 'u))))
    (dk-project! rhs 'simply-connected '(SIMPLY-CONNECTED u))
    (dk-split-all! (list rhs))))
;;; from (= (- p c) (- q c)) or similar: p = q, by the ring
(define (rm-cancel! p q c)                     ; (= (- p c) (- q c)) in context, p q c typed: lands (= p q)
  (let ((g (list '= p q)))
    (if (not (dk-asm? g))
        (dk-have! g (lambda ()
                      (dk-have! (list '= p (list '+ (list '- p c) c)) (lambda () (crs)))
                      (dk-have! (list '= q (list '+ (list '- q c) c)) (lambda () (crs)))
                      (subst (list '= p (list '+ (list '- p c) c)))
                      (subst (list '= q (list '+ (list '- q c) c)))
                      (subst (list '= (list '- p c) (list '- q c)))
                      (if (not (proof-done? *ps*)) (rfl)))))
    g))

;;; ---------------------------------------------------------------------------
;;; PROPOSITION 10.16: an open simply connected u different from CC carries a bounded simple holomorphic function
(sp (make-wff (forall-guarded '(u a) '((SIMPLY-CONNECTED u) (IN a CC) (NOT (IN a u)))
  (list 'FORSOME 'rmh_ (list 'AND '(HOLOMORPHIC-ON u rmh_) (list 'AND (rm-inj 'rmh_)
    '(FORSOME rmm_ (AND (IN rmm_ RR) (FORALL rmz_ (IMPLIES (IN rmz_ u) (<= (magnitude (rmh_ rmz_)) rmm_)))))))))))
(dk-peel!)
(rm-sc-split!)
(fact 'cc-open-subset-cc 'u)
(dk-have! '(IN 0 RR)) (dk-have! '(IN 1 RR)) (dk-have! '(IN 2 RR))
(dk-have! '(< 0 1) (lambda () (dk-ineq!)))
(dk-split-all! (list (dk-fact! 'pi-pos)))
(define (rm-in-u-ne! z)                        ; z in u: z in CC, and (NOT (= z a))
  (fact 'subset-mem-fwd 'u 'CC z)
  (if (not (dk-asm? (list 'NOT (list '= z 'a))))
      (dk-have! (list 'NOT (list '= z 'a))
        (lambda () (di) (dk-rewrite-h! (list 'IN z 'u) z 'a) (ai '(NOT (IN a u)))))))
(use-em '(FORSOME rmv_ (IN rmv_ u))
 (lambda ()
  (let* ((v (dk-skolem! (rm-pick 'ev (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'rmv_)))) #t))
         (f0 '(VNB-LAMBDA rmq_ u (- rmq_ a))))
    (rm-in-u-ne! v)
    (dk-have! (list 'HOLOMORPHIC-ON 'u f0) (lambda () (dk-holomorphic! 'u f0)))
    (dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list 'NOT (list '= (list f0 'z) 0))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (rm-in-u-ne! z)
          (di)
          (dk-lam-b-h! (list '= (list f0 z) 0))
          (dk-have! (list '= z 'a)
            (lambda ()
              (dk-have! (list '= z (list '+ (list '- z 'a) 'a)) (lambda () (crs)))
              (subst (list '= z (list '+ (list '- z 'a) 'a)))
              (subst (list '= (list '- z 'a) 0))
              (crs)))
          (ai (list 'NOT (list '= z 'a))))))
    (let* ((g (dk-skolem! (dk-fact! 'holomorphic-log-sc-exists 'u f0) #t))
           (_s (dk-split-all!))
           (eg (rm-pick 'eg (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'CC-EXP) (dk-contains? f g)))))
           (gv (list g v)) (c (list '+ gv rm-tpi)))
      (dk-cite! 'holomorphic-on-in-fun 'u g)
      (define (ev! z)                          ; z in u: g z typed, (= (CC-EXP (g z)) (- z a))
        (rm-in-u-ne! z)
        (fact 'fun-apply-type-c g 'u 'CC z)
        (let ((e (list '= (list 'CC-EXP (list g z)) (list '- z 'a))))
          (if (not (dk-asm? e))
              (dk-have! e (lambda ()
                            (inst*! eg z)
                            (subst (list '= (list 'CC-EXP (list g z)) (list f0 z)))
                            (dk-lam-b!)
                            (if (not (proof-done? *ps*)) (rfl)))))
          e))
      (define (g-inj! z w)                     ; (= (g z) (g w)) in context: lands (= z w)
        (ev! z) (ev! w)
        (let ((gl (list '= z w)))
          (if (not (dk-asm? gl))
              (dk-have! gl
                (lambda ()
                  (dk-have! (list '= (list '- z 'a) (list '- w 'a))
                    (lambda () (subst (list '= (list '- z 'a) (list 'CC-EXP (list g z))))
                               (subst (list '= (list g z) (list g w)))
                               (subst (list '= (list 'CC-EXP (list g w)) (list '- w 'a)))
                               (if (not (proof-done? *ps*)) (rfl))))
                  (rm-cancel! z w 'a)
                  (if (dk-asm? (dk-goal)) (ass)))))
          gl))
      (ev! v)
      (fact 'cc-i-in)
      (rm-cc! rm-tpi) (rm-cc! c)
      ;; |2 pi i| = 2 pi
      (let* ((mt (list 'magnitude rm-tpi)) (tp '(* 2 PI)))
        (rm-rr! tp)
        (dk-have! (list '= mt tp)
          (lambda ()
            (rm-cc! tp)
            (rm-and! (list 'IN tp 'CC) '(IN +i CC))
            (fact 'cc-magnitude-mul tp '+i)
            (fact 'cc-magnitude-i)
            (fact 'rr-magnitude-is-abs tp)
            (dk-have! (list '<= 0 tp) (lambda () (dk-ineq! '(< 0 PI))))
            (fact 'rr-abs-of-nonneg tp)
            (subst (list '= mt (list '* (list 'magnitude tp) '(magnitude +i))))
            (subst '(= (magnitude +i) 1))
            (subst (list '= (list 'magnitude tp) (list 'abs tp)))
            (subst (list '= (list 'abs tp) tp))
            (crs)))
        ;; continuity of g at v at the scale PI
        (fact 'rr-pos-rr-of-lt 'PI)
        (let* ((del (dk-skolem! (dk-apply! (dk-fact! 'holomorphic-continuous-mag 'u g v) 'PI) #t))
               (_s2 (dk-split-all!))
               (cg (rm-pick 'cg (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f del)))))
               (va (list '- v 'a)) (K (rm-mag! va)) (K1 (list '+ K 1)))
          (dk-pos-parts! del)
          (rm-rr! K1)
          (dk-have! (list '< 0 K1) (lambda () (dk-ineq! (list '<= 0 K))))
          (fact 'rr-pos-ne-zero K1)
          (rm-and! (list 'IN K1 'RR) (list 'NOT (list '= K1 0)))
          (fact 'rr-recip-closed K1) (fact 'rr-recip-pos K1)
          (let* ((rt (list '* del (list 'recip (list '* 2 K1)))))
            (rm-rr! (list '* 2 K1))
            (dk-have! (list '< 0 (list '* 2 K1)) (lambda () (dk-ineq! (list '< 0 K1))))
            (fact 'rr-pos-ne-zero (list '* 2 K1))
            (rm-and! (list 'IN (list '* 2 K1) 'RR) (list 'NOT (list '= (list '* 2 K1) 0)))
            (fact 'rr-recip-closed (list '* 2 K1)) (fact 'rr-recip-pos (list '* 2 K1))
            (rm-rr! rt)
            (fact 'rr-mul-pos del (list 'recip (list '* 2 K1)))
            (fact 'rr-recip-cancel-right del (list '* 2 K1))
            (let* ((rho (dk-name! rt)))
              (dk-rewrite-h! (list '< 0 rt) rt rho)
              (dk-rewrite-h! (list '= del (list '* rt (list '* 2 K1))) rt rho)
              ;; r = min(1, PI, rho)
              (let* ((r1 (dk-skolem! (dk-fact! 'rr-min-pos 1 'PI) #t)) (_a (dk-split-all!))
                     (r (dk-skolem! (dk-fact! 'rr-min-pos r1 rho) #t)) (_b (dk-split-all!))
                     (B (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list '<= r (list 'magnitude (list '- (list g 'z) c)))))))
                (dk-have! B
                  (lambda ()
                    (let* ((z (dk-di-var!)) (gz (list g z)) (A (list '- gz c)))
                      (ev! z)
                      (rm-mag! A)
                      (rm-and! (list 'IN r 'RR) (list 'IN (list 'magnitude A) 'RR))
                      (dk-fact! 'rr-leq-total r (list 'magnitude A))
                      (use-cases (list (list '<= r (list 'magnitude A)) (list '<= (list 'magnitude A) r))
                        (lambda () (ass))
                        (lambda ()
                          ;; w = g z - c is small: |z - v| < del, so |g z - g v| < PI; but |g z - g v| >= 2 PI - |w|
                          (let* ((w A) (mw (list 'magnitude w)) (ew (list 'CC-EXP w)) (e1 (list '- ew 1))
                                 (zv (list '- z v)) (gzv (list '- gz gv)))
                            (for-each (lambda (x) (if (not (dk-asm? (list 'IN (list 'CC-EXP x) 'CC)))
                                                    (dk-split-all! (list (dk-cite! 'cc-exp-converges x)))))
                                      (list w gv rm-tpi c))
                            (rm-cc! ew) (rm-cc! e1) (rm-cc! zv) (rm-cc! gzv) (rm-cc! (list '- e1 w))
                            (dk-have! (list '<= mw 1) (lambda () (dk-ineq! (list '<= mw r) (list '<= r r1) (list '<= r1 1))))
                            (fact 'cc-exp-near-one w)
                            ;; |e1| <= |w| + |w|^2 <= 2 |w|
                            (rm-and! (list 'IN (list '- e1 w) 'CC) (list 'IN w 'CC))
                            (fact 'cc-magnitude-triangle (list '- e1 w) w)
                            (dk-have! (list '= (list '+ (list '- e1 w) w) e1) (lambda () (crs)))
                            (dk-rewrite-h! (list '<= (list 'magnitude (list '+ (list '- e1 w) w)) (list '+ (list 'magnitude (list '- e1 w)) mw))
                                           (list '+ (list '- e1 w) w) e1)
                            (rm-mag! e1) (rm-mag! (list '- e1 w))
                            (rm-rr! (list 'power mw 2)) (rm-rr! (list '* mw mw))
                            (let* ((mm (dk-name! mw)) (pm (list '= (list 'power mm 2) (list '* mm mm))))
                              (fact 'rr-subset-cc mm)
                              (dk-have! pm
                                (lambda ()
                                  (fact 'nn-two-is-succ-succ-zero)
                                  (subst '(= 2 (succ (succ 0))))
                                  (fact 'nn-zero-in) (fact 'nn-succ-closed 0)
                                  (rm-and! (list 'IN mm 'CC) '(IN (succ 0) NN)) (fact 'power-succ mm '(succ 0))
                                  (rm-and! (list 'IN mm 'CC) '(IN 0 NN)) (fact 'power-succ mm 0)
                                  (fact 'power-zero mm)
                                  (subst (list '= (list 'power mm '(succ (succ 0))) (list '* mm (list 'power mm '(succ 0)))))
                                  (subst (list '= (list 'power mm '(succ 0)) (list '* mm (list 'power mm 0))))
                                  (subst (list '= (list 'power mm 0) 1))
                                  (crs)))
                              (dk-rewrite-h! pm mm mw))
                            (rm-and! (list '<= 0 mw) (list '<= mw 1))
                            (fact 'rr-le-scale-nonneg mw mw 1)
                            (rm-rr! (list '* mw 1))
                            (dk-have! (list '<= (list 'magnitude e1) (list '* 2 mw))
                              (lambda () (dk-ineq! (list '<= (list 'magnitude e1) (list '+ (list 'magnitude (list '- e1 w)) mw))
                                                   (list '<= (list 'magnitude (list '- e1 w)) (list 'power mw 2))
                                                   (list '= (list 'power mw 2) (list '* mw mw))
                                                   (list '<= (list '* mw mw) (list '* mw 1)))))
                            ;; z - v = e1 (v - a)
                            (fact 'cc-exp-add w c) (fact 'cc-exp-add gv rm-tpi) (fact 'cc-exp-two-pi-i)
                            (dk-have! (list '= (list '+ w c) gz) (lambda () (crs)))
                            (dk-rewrite-h! (list '= (list 'CC-EXP (list '+ w c)) (list '* ew (list 'CC-EXP c))) (list '+ w c) gz)
                            (dk-have! (list '= zv (list '* e1 va))
                              (lambda ()
                                (dk-have! (list '= (list '- z 'a) (list '* ew va))
                                  (lambda ()
                                    (subst (list '= (list '- z 'a) (list 'CC-EXP gz)))
                                    (subst (list '= (list 'CC-EXP gz) (list '* ew (list 'CC-EXP c))))
                                    (subst (list '= (list 'CC-EXP c) (list '* (list 'CC-EXP gv) (list 'CC-EXP rm-tpi))))
                                    (subst (list '= (list 'CC-EXP rm-tpi) 1))
                                    (subst (list '= (list 'CC-EXP gv) va))
                                    (crs)))
                                (dk-have! (list '= zv (list '- (list '- z 'a) va)) (lambda () (crs)))
                                (subst (list '= zv (list '- (list '- z 'a) va)))
                                (subst (list '= (list '- z 'a) (list '* ew va)))
                                (crs)))
                            ;; |z - v| < del
                            (rm-and! (list 'IN e1 'CC) (list 'IN va 'CC))
                            (fact 'cc-magnitude-mul e1 va)
                            (rm-rr! (list '* (list 'magnitude e1) K)) (rm-rr! (list '* (list '* 2 mw) K)) (rm-rr! (list '* (list '* 2 rho) K))
                            (rm-rr! (list '* 2 mw)) (rm-rr! (list '* 2 rho))
                            (rm-and! (list '<= 0 K) (list '<= (list 'magnitude e1) (list '* 2 mw)))
                            (fact 'rr-le-scale-nonneg-right (list 'magnitude e1) (list '* 2 mw) K)
                            (dk-have! (list '<= (list '* 2 mw) (list '* 2 rho)) (lambda () (dk-ineq! (list '<= mw r) (list '<= r rho))))
                            (rm-and! (list '<= 0 K) (list '<= (list '* 2 mw) (list '* 2 rho)))
                            (fact 'rr-le-scale-nonneg-right (list '* 2 mw) (list '* 2 rho) K)
                            (rm-rr! (list '* rho (list '* 2 K1)))
                            (dk-have! (list '= (list '* rho (list '* 2 K1)) (list '+ (list '* (list '* 2 rho) K) (list '* 2 rho))) (lambda () (crs)))
                            (rm-mag! zv)
                            (dk-have! (list '< (list 'magnitude zv) del)
                              (lambda ()
                                (subst (list '= zv (list '* e1 va)))
                                (subst (list '= (list 'magnitude (list '* e1 va)) (list '* (list 'magnitude e1) K)))
                                (dk-ineq! (list '<= (list '* (list 'magnitude e1) K) (list '* (list '* 2 mw) K))
                                          (list '<= (list '* (list '* 2 mw) K) (list '* (list '* 2 rho) K))
                                          (list '= (list '* rho (list '* 2 K1)) (list '+ (list '* (list '* 2 rho) K) (list '* 2 rho)))
                                          (list '= del (list '* rho (list '* 2 K1)))
                                          (list '< 0 rho))))
                            (inst*! cg z)
                            ;; 2 PI = |2 pi i| <= |g z - g v| + |w|
                            (dk-have! (list '= rm-tpi (list '- gzv w)) (lambda () (crs)))
                            (rm-mag! gzv)
                            (rm-and! (list 'IN gzv 'CC) (list 'IN w 'CC))
                            (fact 'cc-magnitude-sub-triangle gzv w)
                            (dk-rewrite-h! (list '<= (list 'magnitude (list '- gzv w)) (list '+ (list 'magnitude gzv) mw)) (list '- gzv w) rm-tpi)
                            (rm-mag! rm-tpi)
                            (dk-ineq! (list '<= (list 'magnitude rm-tpi) (list '+ (list 'magnitude gzv) mw))
                                        (list '= (list 'magnitude rm-tpi) '(* 2 PI))
                                        (list '< (list 'magnitude gzv) 'PI)
                                        (list '<= mw r) (list '<= r r1) (list '<= r1 'PI))))))))
                ;; h = 1 / (g - c)
                (let* ((h (list 'VNB-LAMBDA 'rmq_ 'u (list 'recip (list '- (list g 'rmq_) c))))
                       (nzc (list 'FORALL 'y (list 'IMPLIES '(IN y u) (list 'NOT (list '= (list '- (list g 'y) c) 0))))))
                  (define (nz! z)                ; z in u: g z - c /= 0, with r <= |g z - c|
                    (let* ((A (list '- (list g z) c)) (nzA (list 'NOT (list '= A 0))))
                      (ev! z) (rm-cc! A) (rm-mag! A)
                      (if (not (dk-asm? (list '<= r (list 'magnitude A)))) (inst*! B z))
                      (if (not (dk-asm? nzA))
                          (dk-have! nzA (lambda () (di) (fact 'cc-magnitude-zero) (fact 'cc-zero-in) (fact 'cc-magnitude-closed 0)
                                          (dk-rewrite-h! (list '<= r (list 'magnitude A)) A 0)
                                          (dk-absurd! (list '<= r '(magnitude 0)) '(= (magnitude 0) 0) (list '< 0 r)))))
                      A))
                  (dk-have! nzc (lambda () (let ((y (dk-di-var!))) (nz! y) (if (dk-asm? (dk-goal)) (ass)))))
                  (dk-have! (list 'HOLOMORPHIC-ON 'u h) (lambda () (dk-holomorphic! 'u h)))
                  (define (hv! z)                ; (= (h z) (recip (g z - c)))
                    (let* ((A (nz! z)) (e (list '= (list h z) (list 'recip A))))
                      (rm-and! (list 'IN A 'CC) (list 'NOT (list '= A 0)))
                      (fact 'cc-recip-closed A)
                      (if (not (dk-asm? e)) (dk-have! e (lambda () (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl)))))
                      e))
                  (ew h)
                  (dk-conj-close!
                    (lambda ()
                      (let ((gl (dk-goal)))
                        (cond
                         ((dk-asm? gl) (ass))
                         ((dk-head-is? gl 'FORALL)
                          (let* ((pl (dk-peel!))
                                 (z (cadr (dk-goal))) (w (caddr (dk-goal))))
                            ;; injectivity: recip A = recip B => A = B => g z = g w => z = w
                            (let* ((A (nz! z)) (Bw (nz! w)))
                              (hv! z) (hv! w)
                              (rm-and! (list 'IN Bw 'CC) (list 'NOT (list '= Bw 0)))
                              (fact 'cc-recip-inverse A) (fact 'cc-recip-inverse Bw)
                              (let* ((ra (dk-name! (list 'recip A) 'CC)) (rb (dk-name! (list 'recip Bw) 'CC)))
                                (dk-have! (list '= ra rb)
                                  (lambda () (subst (list '= ra (list 'recip A))) (subst (list '= rb (list 'recip Bw)))
                                             (subst (list '= (list 'recip A) (list h z))) (subst (list '= (list 'recip Bw) (list h w)))
                                             (if (not (proof-done? *ps*)) (ass))))
                                (dk-rewrite-h! (list '= (list '* A (list 'recip A)) 1) (list 'recip A) ra)
                                (dk-rewrite-h! (list '= (list '* Bw (list 'recip Bw)) 1) (list 'recip Bw) rb)
                                (dk-have! (list '= (list '- A Bw) 0)
                                  (lambda ()
                                    (dk-have! (list '= (list '- A Bw) (list '- (list '* A (list '* Bw rb)) (list '* Bw (list '* A ra))))
                                      (lambda () (subst (list '= (list '* Bw rb) 1)) (subst (list '= (list '* A ra) 1)) (crs)))
                                    (subst (list '= (list '- A Bw) (list '- (list '* A (list '* Bw rb)) (list '* Bw (list '* A ra)))))
                                    (subst (list '= ra rb))
                                    (crs)))
                                (dk-have! (list '= A (list '+ (list '- A Bw) Bw)) (lambda () (crs)))
                                (dk-have! (list '= A Bw) (lambda () (subst (list '= A (list '+ (list '- A Bw) Bw))) (subst (list '= (list '- A Bw) 0)) (crs)))
                                (rm-cancel! (list g z) (list g w) c)
                                (g-inj! z w)
                                (if (dk-asm? (dk-goal)) (ass))))))
                         ((dk-head-is? gl 'FORSOME)
                          (let ((M (list 'recip r)))
                            (dk-have! (list '< 0 r) (lambda () (dk-ineq! (list '< 0 r))))
                            (fact 'rr-pos-ne-zero r)
                            (rm-and! (list 'IN r 'RR) (list 'NOT (list '= r 0)))
                            (fact 'rr-recip-closed r)
                            (ew M)
                            (dk-conj-close!
                              (lambda ()
                                (if (dk-asm? (dk-goal)) (ass)
                                    (let* ((z (dk-di-var!)) (A (nz! z)) (mA (list 'magnitude A)))
                                      (hv! z)
                                      (subst (list '= (list h z) (list 'recip A)))
                                      (fact 'aif-magnitude-recip A)
                                      (subst (list '= (list 'magnitude (list 'recip A)) (list 'recip mA)))
                                      (fact 'rr-recip-antitone r mA)
                                      (ass)))))))
                         (#t (ass)))))))))))))))
 (lambda ()
   (ew '(VNB-LAMBDA rmq_ u 0))
   (fact 'cc-zero-in)
   (define (none! z)                           ; z in u contradicts emptiness
     (dk-have! '(FORSOME rmv_ (IN rmv_ u)) (lambda () (ew z) (ass)))
     (if (dk-only! '(FORSOME rmv_ (IN rmv_ u)) '(NOT (FORSOME rmv_ (IN rmv_ u)))) (prop)))
   (dk-conj-close!
     (lambda ()
       (let ((gl (dk-goal)))
         (cond ((dk-asm? gl) (ass))
               ((dk-head-is? gl 'HOLOMORPHIC-ON) (dk-holomorphic! 'u '(VNB-LAMBDA rmq_ u 0)))
               ((dk-head-is? gl 'FORALL) (let ((z (dk-di-var!))) (none! z)))
               ((dk-head-is? gl 'FORSOME) (ew 0) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (let ((z (dk-di-var!))) (none! z))))))
               (#t (ass))))))))
(qed 'sc-bounded-simple)

;;; ---------------------------------------------------------------------------
;;; COROLLARY 10.17: a simple holomorphic map of u into the open unit disc whose image contains 0
(sp (make-wff (forall-guarded '(u a v) '((SIMPLY-CONNECTED u) (IN a CC) (NOT (IN a u)) (IN v u))
  (list 'FORSOME 'rmk_ (list 'AND '(HOLOMORPHIC-ON u rmk_) (list 'AND (rm-inj 'rmk_)
    '(AND (FORALL rmz_ (IMPLIES (IN rmz_ u) (< (magnitude (rmk_ rmz_)) 1)))
          (FORSOME rmy_ (AND (IN rmy_ u) (= (rmk_ rmy_) 0))))))))))
(dk-peel!)
(let* ((h (dk-skolem! (dk-fact! 'sc-bounded-simple 'u 'a) #t))
       (_s (dk-split-all!))
       (M (dk-skolem! (rm-pick 'em (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'rmm_)))) #t))
       (_s2 (dk-split-all!))
       (bd (rm-pick 'bd (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f M)))))
       (hinj (rm-pick 'hinj (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'rmw_) (dk-contains? f h)))))
       (hv (list h 'v)) (M1 (list '+ (list '* 2 M) 1)))
  (rm-sc-split!)
  (fact 'cc-open-subset-cc 'u)
  (dk-cite! 'holomorphic-on-in-fun 'u h)
  (fact 'subset-mem-fwd 'u 'CC 'v)
  (fact 'fun-apply-type-c h 'u 'CC 'v)
  (rm-mag! hv)
  (inst*! bd 'v)
  (dk-have! '(IN 1 RR)) (dk-have! '(IN 2 RR)) (rm-rr! M1)
  (dk-have! (list '< 0 M1) (lambda () (dk-ineq! (list '<= (list 'magnitude hv) M) (list '<= 0 (list 'magnitude hv)))))
  (fact 'rr-pos-ne-zero M1)
  (rm-and! (list 'IN M1 'RR) (list 'NOT (list '= M1 0)))
  (fact 'rr-recip-closed M1) (fact 'rr-recip-pos M1)
  (fact 'rr-recip-cancel-right 1 M1)
  (let* ((ns (dk-name! (list 'recip M1))))
    (dk-rewrite-h! (list '< 0 (list 'recip M1)) (list 'recip M1) ns)
    (dk-rewrite-h! (list '= 1 (list '* (list '* 1 (list 'recip M1)) M1)) (list 'recip M1) ns)
    (fact 'rr-subset-cc ns)
    (dk-have! (list '= (list '* 1 ns) ns) (lambda () (crs)))
    (dk-rewrite-h! (list '= 1 (list '* (list '* 1 ns) M1)) (list '* 1 ns) ns)
    (dk-have! (list '= (list '* M1 ns) (list '* ns M1)) (lambda () (crs)))
    (dk-have! (list '= (list '* M1 ns) 1)
      (lambda () (subst (list '= (list '* M1 ns) (list '* ns M1))) (subst (list '= (list '* ns M1) 1)) (rfl)))
    (let ((k (list 'VNB-LAMBDA 'rmq_ 'u (list '* (list '- (list h 'rmq_) hv) ns))))
      (define (kv! z)                          ; z in u: (= (k z) (* (- (h z) hv) ns)), typed
        (fact 'subset-mem-fwd 'u 'CC z)
        (fact 'fun-apply-type-c h 'u 'CC z)
        (let* ((val (list '* (list '- (list h z) hv) ns)) (e (list '= (list k z) val)))
          (rm-cc! (list '- (list h z) hv)) (rm-cc! val)
          (if (not (dk-asm? e)) (dk-have! e (lambda () (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl)))))
          val))
      (ew k)
      (dk-conj-close!
        (lambda ()
          (let ((gl (dk-goal)))
            (cond
             ((dk-asm? gl) (ass))
             ((dk-head-is? gl 'HOLOMORPHIC-ON) (dk-holomorphic! 'u k))
             ((dk-head-is? gl 'FORSOME)
              (ew 'v)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal)) (ass)
                      (begin (kv! 'v) (subst (list '= (list k 'v) (list '* (list '- hv hv) ns))) (crs))))))
             ((and (dk-head-is? gl 'FORALL) (dk-contains? gl 'magnitude))
              (let* ((z (dk-di-var!)) (val (kv! z)) (d (list '- (list h z) hv)) (md (list 'magnitude d)))
                (subst (list '= (list k z) val))
                (rm-mag! (list h z)) (rm-mag! d)
                (inst*! bd z)
                (rm-and! (list 'IN d 'CC) (list 'IN ns 'CC))
                (fact 'cc-magnitude-mul d ns)
                (fact 'rr-magnitude-is-abs ns)
                (dk-have! (list '<= 0 ns) (lambda () (dk-ineq! (list '< 0 ns))))
                (fact 'rr-abs-of-nonneg ns)
                (rm-and! (list 'IN (list h z) 'CC) (list 'IN hv 'CC))
                (fact 'cc-magnitude-sub-triangle (list h z) hv)
                (rm-rr! (list '* md ns)) (rm-rr! (list '* (list '* 2 M) ns)) (rm-rr! (list '* M1 ns))
                (dk-have! (list '<= md (list '* 2 M)) (lambda () (dk-ineq! (list '<= md (list '+ (list 'magnitude (list h z)) (list 'magnitude hv)))
                                                                    (list '<= (list 'magnitude (list h z)) M) (list '<= (list 'magnitude hv) M))))
                (rm-rr! (list '* 2 M)) (rm-rr! md)
                (rm-and! (list '<= 0 ns) (list '<= md (list '* 2 M)))
                (fact 'rr-le-scale-nonneg-right md (list '* 2 M) ns)
                (dk-have! (list '= (list '* M1 ns) (list '+ (list '* (list '* 2 M) ns) ns)) (lambda () (crs)))
                
                (subst (list '= (list 'magnitude val) (list '* md (list 'magnitude ns))))
                (subst (list '= (list 'magnitude ns) (list 'abs ns)))
                (subst (list '= (list 'abs ns) ns))
                (dk-ineq! (list '<= (list '* md ns) (list '* (list '* 2 M) ns))
                          (list '= (list '* M1 ns) (list '+ (list '* (list '* 2 M) ns) ns))
                          (list '= (list '* M1 ns) 1) (list '< 0 ns))))
             ((dk-head-is? gl 'FORALL)
              (let* ((pl (dk-peel!)) (z (cadr (dk-goal))) (w (caddr (dk-goal))))
                (kv! z) (kv! w)
                (let* ((dz (list '- (list h z) hv)) (dw (list '- (list h w) hv)))
                  (dk-have! (list '= (list '* dz ns) (list '* dw ns))
                    (lambda () (subst (list '= (list '* dz ns) (list k z))) (subst (list '= (list '* dw ns) (list k w))) (if (dk-asm? (dk-goal)) (ass))))
                  (dk-have! (list '= dz dw)
                    (lambda ()
                      (rm-cc! M1)
                      (dk-have! (list '= dz (list '* M1 (list '* dz ns))) (lambda () (dk-have! (list '= (list '* M1 (list '* dz ns)) (list '* dz (list '* M1 ns))) (lambda () (crs)))
                                                                                   (subst (list '= (list '* M1 (list '* dz ns)) (list '* dz (list '* M1 ns))))
                                                                                   (subst (list '= (list '* M1 ns) 1)) (crs)))
                      (dk-have! (list '= dw (list '* M1 (list '* dw ns))) (lambda () (dk-have! (list '= (list '* M1 (list '* dw ns)) (list '* dw (list '* M1 ns))) (lambda () (crs)))
                                                                                   (subst (list '= (list '* M1 (list '* dw ns)) (list '* dw (list '* M1 ns))))
                                                                                   (subst (list '= (list '* M1 ns) 1)) (crs)))
                      (subst (list '= dz (list '* M1 (list '* dz ns))))
                      (subst (list '= dw (list '* M1 (list '* dw ns))))
                      (subst (list '= (list '* dz ns) (list '* dw ns)))
                      (rfl)))
                  (rm-cancel! (list h z) (list h w) hv)
                  (inst*! hinj z w)
                  (if (dk-asm? (dk-goal)) (ass)))))
             (#t (ass)))))))))
(qed 'sc-simple-into-disc)

(display ";; RM qed failures: ") (display *vnb-qed-failures*) (newline)
