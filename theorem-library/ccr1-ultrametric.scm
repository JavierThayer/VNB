;;; ccr1-ultrametric.scm -- ULTRAMETRIC SPACES: CCR.pdf chapter 1, Propositions 1.2, 1.3, Corollary 1.4,
;;; Propositions 1.5 and 1.7.  Vocabulary: structure-library/ccr1-vocab.scm (SPHERE, EPS-REL, EPS-SETOID)
;;; and IS-ULTRAMETRIC (agent ISOM's, scratchpad/mb12/mb12-vocab.scm).  Agent CCR-B1, wave MAP-1026,
;;; 2026-10-26.  Destination: theorem-library/ccr1-ultrametric.scm.  Library: analysis.  Helper prefix cu-.
;;;
;;; THE TECHNIQUE.  Three lemmas carry the ultrametric inequality, and every result is a few citations:
;;;   ultra-le         d(x, z) <= r and d(z, y) <= r give d(x, y) <= r
;;;   ultra-lt         d(x, z) < r and d(z, y) < r give d(x, y) < r
;;;   ultra-isosceles  d(z, y) < d(x, z) gives d(x, y) = d(x, z)  ("every triangle is isosceles")
;;;
;;; LOAD WINDOW: after structure-library/ccr1-vocab and the IS-ULTRAMETRIC file; cites metric-space laws
;;; (metric-dist-real, metric-sym, metric-self-zero), ball / closed-ball membership, rr-max-*, the setoid
;;; laws (class-eq-iff, quotient-rep, class-in-quotient, quotient-is-set), card-image-finite,
;;; card-subset-nn, image-membership-iff -- all early.

(define (cu-or-each! o handler)
  (if (not (dk-head-is? o 'OR))
      (handler o)
      (dk-each-leaf! (lambda () (ai o))
        (lambda ()
          (cond ((dk-asm? (cadr o)) (handler (cadr o)))
                ((and (pair? (caddr o)) (eq? (car (caddr o)) 'OR)) (cu-or-each! (caddr o) handler))
                (#t (handler (caddr o))))))))

(define (cu-d x y) `((DIST s) ,x ,y))

(define (cu-keep-prop! . fs)
  (let ((node (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? node)) (prop))))

(define cu-law
  '(FORALL umx_ (IMPLIES (IN umx_ (PTS s))
     (FORALL umy_ (IMPLIES (IN umy_ (PTS s))
       (FORALL umz_ (IMPLIES (IN umz_ (PTS s))
         (<= ((DIST s) umx_ umy_) (MAX ((DIST s) umx_ umz_) ((DIST s) umz_ umy_))))))))))

;;; -----------------------------------------------------------------------
;;; The ultrametric inequality, and its three working forms.

(sp (make-wff '(FORALL s (IMPLIES (IS-ULTRAMETRIC s) (IS-METRIC-SPACE s)))))
(dk-peel!)
(mac-h 'is-ultrametric '(IS-ULTRAMETRIC s))
(dk-split-all!)
(dk-ass!)
(qed 'ultra-ms)

(sp (make-wff '(FORALL s (IMPLIES (IS-ULTRAMETRIC s) (FORALL x (IMPLIES (IN x (PTS s)) (FORALL y (IMPLIES (IN y (PTS s))
  (FORALL z (IMPLIES (IN z (PTS s)) (<= ((DIST s) x y) (MAX ((DIST s) x z) ((DIST s) z y)))))))))))))
(dk-peel!)
(dk-have! cu-law (lambda () (mac-h 'is-ultrametric '(IS-ULTRAMETRIC s)) (dk-split-all!) (dk-ass!)))
(dk-apply! cu-law 'x 'y 'z)
(dk-ass!)
(qed 'ultra-max)

(define (cu-ms!) (if (not (dk-asm? '(IS-METRIC-SPACE s))) (dk-cite! 'ultra-ms 's)))
(define (cu-real! x y) (dk-cite! 'metric-dist-real 's x y))

;; the common preamble: IS-METRIC-SPACE, the three distances real, the max of the two real, and the
;; ultrametric inequality d(x, y) <= max(d(x, z), d(z, y)) landed; returns the max term
(define (cu-max! x y z)
  (cu-ms!)
  (cu-real! x y) (cu-real! x z) (cu-real! z y)
  (dk-cite! 'rr-max-closed (cu-d x z) (cu-d z y))
  (dk-cite! 'ultra-max 's x y z)
  `(MAX ,(cu-d x z) ,(cu-d z y)))

(sp (make-wff '(FORALL s (IMPLIES (IS-ULTRAMETRIC s) (FORALL x (FORALL y (FORALL z (FORALL r
  (IMPLIES (IN x (PTS s)) (IMPLIES (IN y (PTS s)) (IMPLIES (IN z (PTS s)) (IMPLIES (IN r RR)
  (IMPLIES (<= ((DIST s) x z) r) (IMPLIES (<= ((DIST s) z y) r) (<= ((DIST s) x y) r)))))))))))))))
(dk-peel!)
(let ((mx (cu-max! 'x 'y 'z)))
  (dk-cite! 'rr-max-le (cu-d 'x 'z) (cu-d 'z 'y) 'r)
  (dk-ineq! `(<= ,(cu-d 'x 'y) ,mx) `(<= ,mx r)))
(qed 'ultra-le)

(sp (make-wff '(FORALL s (IMPLIES (IS-ULTRAMETRIC s) (FORALL x (FORALL y (FORALL z (FORALL r
  (IMPLIES (IN x (PTS s)) (IMPLIES (IN y (PTS s)) (IMPLIES (IN z (PTS s)) (IMPLIES (IN r RR)
  (IMPLIES (< ((DIST s) x z) r) (IMPLIES (< ((DIST s) z y) r) (< ((DIST s) x y) r)))))))))))))))
(dk-peel!)
(let ((mx (cu-max! 'x 'y 'z)))
  (dk-cite! 'rr-max-lt (cu-d 'x 'z) (cu-d 'z 'y) 'r)
  (dk-ineq! `(<= ,(cu-d 'x 'y) ,mx) `(< ,mx r)))
(qed 'ultra-lt)

;;; Every triangle is isosceles: d(z, y) < d(x, z) gives d(x, y) = d(x, z).
(sp (make-wff '(FORALL s (IMPLIES (IS-ULTRAMETRIC s) (FORALL x (FORALL y (FORALL z
  (IMPLIES (IN x (PTS s)) (IMPLIES (IN y (PTS s)) (IMPLIES (IN z (PTS s))
  (IMPLIES (< ((DIST s) z y) ((DIST s) x z)) (= ((DIST s) x y) ((DIST s) x z)))))))))))))
(dk-peel!)
(let* ((m1 (cu-max! 'x 'y 'z))
       (dxy (cu-d 'x 'y)) (dxz (cu-d 'x 'z)) (dzy (cu-d 'z 'y)) (dyz (cu-d 'y 'z)))
  ;; d(x, y) <= max(d(x, z), d(z, y)) = d(x, z)
  (dk-have! `(<= ,dzy ,dxz) (lambda () (dk-ineq! `(< ,dzy ,dxz))))
  (dk-cite! 'rr-max-left-le dxz dzy)
  (dk-have! `(<= ,dxy ,dxz) (lambda () (dk-ineq! `(<= ,dxy ,m1) `(= ,m1 ,dxz))))
  ;; d(x, z) <= max(d(x, y), d(y, z)), and that max is d(x, y) since d(y, z) = d(z, y) < d(x, z)
  (let ((m2 (cu-max! 'x 'z 'y)))
    (dk-cite! 'metric-sym 's 'y 'z)
    (cu-or-each! (dk-cite! 'rr-max-cases dxy dyz)
      (lambda (e)
        (dk-have! `(<= ,dxz ,dxy) (lambda () (dk-ineq! `(<= ,dxz ,m2) e `(= ,dyz ,dzy) `(< ,dzy ,dxz))))
        (dk-have! `(AND (IN ,dxy RR) (IN ,dxz RR)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
        (dk-have! `(AND (<= ,dxy ,dxz) (<= ,dxz ,dxy)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
        (fact 'rr-leq-antisymmetric dxy dxz)
        (dk-ass!)))))
(qed 'ultra-isosceles)

;;; -----------------------------------------------------------------------
;;; Ball memberships, opened and introduced.

(define (cu-cb t c r) `(CLOSED-BALL s ,c ,r))
(define (cu-b t c r) `(BALL s ,c ,r))

;; (IN y CLOSED-BALL(s, c, r)) in context: land y in PTS and d(c, y) <= r
(define (cu-cb-open! y c r)
  (let ((mem `(IN ,y (CLOSED-BALL s ,c ,r))))
    (fact 'closed-ball-membership 's c r y)
    (dk-have! `(AND (IN ,y (PTS s)) (<= ,(cu-d c y) ,r)) (lambda () (cu-keep-prop! (iff-for mem) mem)))
    (dk-split-all!)))
(define (cu-cb-intro! y c r)
  (let ((mem `(IN ,y (CLOSED-BALL s ,c ,r))))
    (fact 'closed-ball-membership 's c r y)
    (cu-keep-prop! (iff-for mem) `(IN ,y (PTS s)) `(<= ,(cu-d c y) ,r))))

;; (IN y BALL(s, c, r)) in context: land y in PTS and d(c, y) < r
(define (cu-b-open! y c r)
  (let ((mem `(IN ,y (BALL s ,c ,r))) (d (cu-d c y)))
    (fact 'ball-membership 's c r y)
    (dk-have! `(AND (IN ,y (PTS s)) (AND (<= ,d ,r) (NOT (= ,d ,r)))) (lambda () (cu-keep-prop! (iff-for mem) mem)))
    (dk-split-all!)
    (cu-ms!)
    (cu-real! c y)
    (dk-have! `(AND (<= ,d ,r) (NOT (= ,d ,r))) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (fact 'rr-le-ne-lt d r)))
(define (cu-lt-ne! a b)
  (dk-have! `(NOT (= ,a ,b))
    (lambda () (di) (dk-rewrite-h! `(< ,a ,b) a b) (ai (dk-cite! 'rr-lt-irrefl b)))))
;; goal (IN y BALL(s, c, r)) with y in PTS and d(c, y) < r in context
(define (cu-b-intro! y c r)
  (let ((mem `(IN ,y (BALL s ,c ,r))) (d (cu-d c y)))
    (dk-have! `(<= ,d ,r) (lambda () (dk-ineq! `(< ,d ,r))))
    (cu-lt-ne! d r)
    (fact 'ball-membership 's c r y)
    (cu-keep-prop! (iff-for mem) `(IN ,y (PTS s)) `(<= ,d ,r) `(NOT (= ,d ,r)))))

;;; -----------------------------------------------------------------------
;;; PROPOSITION 1.2: intersecting balls are nested; with equal radii, identical (closed and open).

(sp (make-wff '(FORALL s (IMPLIES (IS-ULTRAMETRIC s) (FORALL a (FORALL b (FORALL r (FORALL q
  (IMPLIES (IN a (PTS s)) (IMPLIES (IN b (PTS s)) (IMPLIES (IN r RR) (IMPLIES (IN q RR) (IMPLIES (<= q r)
  (IMPLIES (FORSOME x (AND (IN x (CLOSED-BALL s a r)) (IN x (CLOSED-BALL s b q))))
    (SUBSET (CLOSED-BALL s b q) (CLOSED-BALL s a r))))))))))))))))
(let* ((landed (dk-peel!))
       (x (dk-skolem! (find-first (lambda (f) (dk-head-is? f 'FORSOME)) landed))))
  (cu-ms!)
  (cu-cb-open! x 'a 'r)
  (cu-cb-open! x 'b 'q)
  (mac 'subset-def)
  (let ((y (cadr (car (dk-peel!)))))
    (cu-cb-open! y 'b 'q)
    (dk-cite! 'metric-sym 's 'b x)
    (dk-have! `(<= ,(cu-d x 'b) q) (lambda () (subst `(= ,(cu-d x 'b) ,(cu-d 'b x))) (dk-ass!)))
    (dk-cite! 'ultra-le 's x y 'b 'q)
    (cu-real! x y)
    (dk-have! `(<= ,(cu-d x y) r) (lambda () (dk-ineq! `(<= ,(cu-d x y) q) '(<= q r))))
    (dk-cite! 'ultra-le 's 'a y x 'r)
    (cu-cb-intro! y 'a 'r)))
(qed 'ultra-closed-ball-nested)

(sp (make-wff '(FORALL s (IMPLIES (IS-ULTRAMETRIC s) (FORALL a (FORALL b (FORALL r (FORALL q
  (IMPLIES (IN a (PTS s)) (IMPLIES (IN b (PTS s)) (IMPLIES (IN r RR) (IMPLIES (IN q RR) (IMPLIES (<= q r)
  (IMPLIES (FORSOME x (AND (IN x (BALL s a r)) (IN x (BALL s b q))))
    (SUBSET (BALL s b q) (BALL s a r))))))))))))))))
(let* ((landed (dk-peel!))
       (x (dk-skolem! (find-first (lambda (f) (dk-head-is? f 'FORSOME)) landed))))
  (cu-ms!)
  (cu-b-open! x 'a 'r)
  (cu-b-open! x 'b 'q)
  (mac 'subset-def)
  (let ((y (cadr (car (dk-peel!)))))
    (cu-b-open! y 'b 'q)
    (dk-cite! 'metric-sym 's 'b x)
    (dk-have! `(< ,(cu-d x 'b) q) (lambda () (subst `(= ,(cu-d x 'b) ,(cu-d 'b x))) (dk-ass!)))
    (dk-cite! 'ultra-lt 's x y 'b 'q)
    (cu-real! x y)
    (dk-have! `(< ,(cu-d x y) r) (lambda () (dk-ineq! `(< ,(cu-d x y) q) '(<= q r))))
    (dk-cite! 'ultra-lt 's 'a y x 'r)
    (cu-real! 'a y)
    (cu-b-intro! y 'a 'r)))
(qed 'ultra-ball-nested)

;; the goal (= A B) for two sets with (SUBSET A B) and (SUBSET B A) in context
(define (cu-set-eq! a b)
  (let ((u `(FORALL cuw_ (IFF (IN cuw_ ,a) (IN cuw_ ,b)))))
    (fact 'subset-def a b) (fact 'subset-def b a)
    (let* ((ab (dk-have! `(FORALL cux_ (IMPLIES (IN cux_ ,a) (IN cux_ ,b)))
                (lambda () (cu-keep-prop! (iff-for `(SUBSET ,a ,b)) `(SUBSET ,a ,b)))))
          (ba (dk-have! `(FORALL cux_ (IMPLIES (IN cux_ ,b) (IN cux_ ,a)))
                (lambda () (cu-keep-prop! (iff-for `(SUBSET ,b ,a)) `(SUBSET ,b ,a))))))
      (dk-have! u
        (lambda ()
          (dk-peel!)
          (dk-iff! (lambda (g) (equal? (caddr g) b))
            (lambda () (dk-apply! `(FORALL cux_ (IMPLIES (IN cux_ ,a) (IN cux_ ,b))) (cadr (dk-goal))) (dk-ass!))
            (lambda () (dk-apply! `(FORALL cux_ (IMPLIES (IN cux_ ,b) (IN cux_ ,a))) (cadr (dk-goal))) (dk-ass!)))))
      (fact 'class-extensionality a b)
      (dk-ass!))))

(sp (make-wff '(FORALL s (IMPLIES (IS-ULTRAMETRIC s) (FORALL a (FORALL b (FORALL r
  (IMPLIES (IN a (PTS s)) (IMPLIES (IN b (PTS s)) (IMPLIES (IN r RR)
  (IMPLIES (FORSOME x (AND (IN x (CLOSED-BALL s a r)) (IN x (CLOSED-BALL s b r))))
    (= (CLOSED-BALL s a r) (CLOSED-BALL s b r)))))))))))))
(let* ((landed (dk-peel!))
       (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) landed)))
  (dk-have! '(<= r r) (lambda () (dk-ineq!)))
  (fact 'ultra-closed-ball-nested 's 'a 'b 'r 'r)
  (dk-have! '(FORSOME x (AND (IN x (CLOSED-BALL s b r)) (IN x (CLOSED-BALL s a r))))
    (lambda () (let ((x (dk-skolem! ex))) (ew x) (dk-conj-close! (lambda () (dk-ass!))))))
  (fact 'ultra-closed-ball-nested 's 'b 'a 'r 'r)
  (cu-set-eq! '(CLOSED-BALL s a r) '(CLOSED-BALL s b r)))
(qed 'ultra-closed-ball-equal)

(sp (make-wff '(FORALL s (IMPLIES (IS-ULTRAMETRIC s) (FORALL a (FORALL b (FORALL r
  (IMPLIES (IN a (PTS s)) (IMPLIES (IN b (PTS s)) (IMPLIES (IN r RR)
  (IMPLIES (FORSOME x (AND (IN x (BALL s a r)) (IN x (BALL s b r))))
    (= (BALL s a r) (BALL s b r)))))))))))))
(let* ((landed (dk-peel!))
       (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) landed)))
  (dk-have! '(<= r r) (lambda () (dk-ineq!)))
  (fact 'ultra-ball-nested 's 'a 'b 'r 'r)
  (dk-have! '(FORSOME x (AND (IN x (BALL s b r)) (IN x (BALL s a r))))
    (lambda () (let ((x (dk-skolem! ex))) (ew x) (dk-conj-close! (lambda () (dk-ass!))))))
  (fact 'ultra-ball-nested 's 'b 'a 'r 'r)
  (cu-set-eq! '(BALL s a r) '(BALL s b r)))
(qed 'ultra-ball-equal)

;;; -----------------------------------------------------------------------
;;; PROPOSITION 1.3: closed balls are open, open balls are closed (radius r > 0).

;; goal (POS-RR r) with r in RR and 0 < r in context
(define (cu-pos! r)
  (mac 'pos-rr)
  (cu-lt-ne! 0 r)
  (dk-conj-close! (lambda () (if (not (dk-ass!)) (dk-ineq! `(< 0 ,r))))))

(sp (make-wff '(FORALL s (IMPLIES (IS-ULTRAMETRIC s) (FORALL a (FORALL r
  (IMPLIES (IN a (PTS s)) (IMPLIES (IN r RR) (IMPLIES (< 0 r) (IS-OPEN s (CLOSED-BALL s a r)))))))))))
(dk-peel!)
(cu-ms!)
(mac 'is-open)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-ass!) #t)
            ((dk-head-is? g 'SUBSET) (dk-apply! (dk-cite! 'closed-ball-in-carrier 's) 'a 'r) (dk-ass!))
            (#t
             (let ((y (cadr (car (dk-peel!)))))
               (cu-cb-open! y 'a 'r)
               (ew 'r)
               (dk-conj-close!
                 (lambda ()
                   (if (dk-head-is? (dk-goal) 'POS-RR)
                       (cu-pos! 'r)
                       (begin
                         (mac 'subset-def)
                         (let ((z (cadr (car (dk-peel!)))))
                           (cu-b-open! z y 'r)
                           (dk-have! `(<= ,(cu-d y z) r) (lambda () (dk-ineq! `(< ,(cu-d y z) r))))
                           (dk-cite! 'ultra-le 's 'a z y 'r)
                           (cu-cb-intro! z 'a 'r))))))))))))
(qed 'ultra-closed-ball-open)

;; (IN w COMPLEMENT-IN(P, B)) opened / introduced
(define (cu-cmp-open! w p b)
  (let ((mem `(IN ,w (COMPLEMENT-IN ,p ,b))))
    (fact 'complement-in-membership p b w)
    (dk-have! `(AND (IN ,w ,p) (NOT (IN ,w ,b))) (lambda () (cu-keep-prop! (iff-for mem) mem)))
    (dk-split-all!)))
(define (cu-cmp-intro! w p b)
  (let ((mem `(IN ,w (COMPLEMENT-IN ,p ,b))))
    (fact 'complement-in-membership p b w)
    (cu-keep-prop! (iff-for mem) `(IN ,w ,p) `(NOT (IN ,w ,b)))))

;; the goal IS-OPEN(s, COMPLEMENT-IN(PTS s, B)) for B a subset of PTS(s): AWAY! gets a point z of the
;; complement and a point w with d(z, w) < r, and must land (NOT (IN w B))
(define (cu-complement-open! b r away!)
  (let ((cmp `(COMPLEMENT-IN (PTS s) ,b)))
    (mac 'is-open)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond ((dk-ass!) #t)
                ((dk-head-is? g 'SUBSET)
                 (mac 'subset-def)
                 (let ((w (cadr (car (dk-peel!))))) (cu-cmp-open! w '(PTS s) b) (dk-ass!)))
                (#t
                 (let ((z (cadr (car (dk-peel!)))))
                   (cu-cmp-open! z '(PTS s) b)
                   (ew r)
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-head-is? (dk-goal) 'POS-RR)
                           (cu-pos! r)
                           (begin
                             (mac 'subset-def)
                             (let ((w (cadr (car (dk-peel!)))))
                               (cu-b-open! w z r)
                               (away! z w)
                               (cu-cmp-intro! w '(PTS s) b))))))))))))))

(sp (make-wff '(FORALL s (IMPLIES (IS-ULTRAMETRIC s) (FORALL a (FORALL r
  (IMPLIES (IN a (PTS s)) (IMPLIES (IN r RR) (IMPLIES (< 0 r) (IS-CLOSED s (BALL s a r)))))))))))
(dk-peel!)
(cu-ms!)
(mac 'is-closed)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-ass!) #t)
            ((dk-head-is? g 'SUBSET)
             (mac 'subset-def)
             (let ((z (cadr (car (dk-peel!))))) (cu-b-open! z 'a 'r) (dk-ass!)))
            (#t
             (cu-complement-open! '(BALL s a r) 'r
               (lambda (z w)
                 ;; w in B(a, r) and d(w, z) = d(z, w) < r put z in B(a, r)
                 (dk-have! `(NOT (IN ,w (BALL s a r)))
                   (lambda ()
                     (di)
                     (cu-b-open! w 'a 'r)
                     (dk-cite! 'metric-sym 's z w)
                     (dk-have! `(< ,(cu-d w z) r) (lambda () (subst `(= ,(cu-d w z) ,(cu-d z w))) (dk-ass!)))
                     (dk-cite! 'ultra-lt 's 'a z w 'r)
                     (cu-real! 'a z)
                     (dk-have! `(IN ,z (BALL s a r)) (lambda () (cu-b-intro! z 'a 'r)))
                     (ai `(NOT (IN ,z (BALL s a r)))))))))))))
(qed 'ultra-ball-closed)

;;; -----------------------------------------------------------------------
;;; COROLLARY 1.4: spheres are open and closed (radius r > 0).

(sp (make-wff '(FORALL s (FORALL c (FORALL r (== (SPHERE s c r)
  (SEP cuvy_ (PTS s) (= ((DIST s) c cuvy_) r))))))))
(di) (mac 'SPHERE) (qrfl)
(qed 'sphere-unfold)

(sp (make-wff '(FORALL s (FORALL c (FORALL r (FORALL y
  (IFF (IN y (SPHERE s c r)) (AND (IN y (PTS s)) (= ((DIST s) c y) r)))))))))
(dk-peel!)
(dk-iff! (lambda (g) (dk-head-is? g 'AND))
  (lambda ()
    (mac-h 'sphere-unfold '(IN y (SPHERE s c r)))
    (sep-me (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) "the separation"))
    (dk-conj-close! (lambda () (dk-ass!))))
  (lambda ()
    (dk-split-all!)
    (mac 'sphere-unfold)
    (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
(qed 'sphere-membership)

(define (cu-sph-open! y c r)
  (let ((mem `(IN ,y (SPHERE s ,c ,r))))
    (fact 'sphere-membership 's c r y)
    (dk-have! `(AND (IN ,y (PTS s)) (= ,(cu-d c y) ,r)) (lambda () (cu-keep-prop! (iff-for mem) mem)))
    (dk-split-all!)))
(define (cu-sph-intro! y c r)
  (let ((mem `(IN ,y (SPHERE s ,c ,r))))
    (fact 'sphere-membership 's c r y)
    (cu-keep-prop! (iff-for mem) `(IN ,y (PTS s)) `(= ,(cu-d c y) ,r))))

(sp (make-wff '(FORALL s (IMPLIES (IS-ULTRAMETRIC s) (FORALL a (FORALL r
  (IMPLIES (IN a (PTS s)) (IMPLIES (IN r RR) (IMPLIES (< 0 r) (IS-OPEN s (SPHERE s a r)))))))))))
(dk-peel!)
(cu-ms!)
(mac 'is-open)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-ass!) #t)
            ((dk-head-is? g 'SUBSET)
             (mac 'subset-def)
             (let ((z (cadr (car (dk-peel!))))) (cu-sph-open! z 'a 'r) (dk-ass!)))
            (#t
             (let ((y (cadr (car (dk-peel!)))))
               (cu-sph-open! y 'a 'r)
               (ew 'r)
               (dk-conj-close!
                 (lambda ()
                   (if (dk-head-is? (dk-goal) 'POS-RR)
                       (cu-pos! 'r)
                       (begin
                         (mac 'subset-def)
                         (let ((z (cadr (car (dk-peel!)))))
                           (cu-b-open! z y 'r)
                           ;; d(y, z) < r = d(a, y): every triangle is isosceles, d(a, z) = d(a, y) = r
                           (dk-have! `(< ,(cu-d y z) ,(cu-d 'a y)) (lambda () (subst `(= ,(cu-d 'a y) r)) (dk-ass!)))
                           (dk-cite! 'ultra-isosceles 's 'a z y)
                           (dk-have! `(= ,(cu-d 'a z) r)
                             (lambda () (subst `(= ,(cu-d 'a z) ,(cu-d 'a y))) (dk-ass!)))
                           (cu-sph-intro! z 'a 'r))))))))))))
(qed 'ultra-sphere-open)

(sp (make-wff '(FORALL s (IMPLIES (IS-ULTRAMETRIC s) (FORALL a (FORALL r
  (IMPLIES (IN a (PTS s)) (IMPLIES (IN r RR) (IMPLIES (< 0 r) (IS-CLOSED s (SPHERE s a r)))))))))))
(dk-peel!)
(cu-ms!)
(mac 'is-closed)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-ass!) #t)
            ((dk-head-is? g 'SUBSET)
             (mac 'subset-def)
             (let ((z (cadr (car (dk-peel!))))) (cu-sph-open! z 'a 'r) (dk-ass!)))
            (#t
             (cu-complement-open! '(SPHERE s a r) 'r
               (lambda (z w)
                 ;; w on the sphere and d(w, z) < r = d(a, w) put z on it too
                 (dk-have! `(NOT (IN ,w (SPHERE s a r)))
                   (lambda ()
                     (di)
                     (cu-sph-open! w 'a 'r)
                     (dk-cite! 'metric-sym 's z w)
                     (dk-have! `(< ,(cu-d w z) ,(cu-d 'a w))
                       (lambda () (subst `(= ,(cu-d w z) ,(cu-d z w))) (subst `(= ,(cu-d 'a w) r)) (dk-ass!)))
                     (dk-cite! 'ultra-isosceles 's 'a z w)
                     (dk-have! `(= ,(cu-d 'a z) r) (lambda () (subst `(= ,(cu-d 'a z) ,(cu-d 'a w))) (dk-ass!)))
                     (dk-have! `(IN ,z (SPHERE s a r)) (lambda () (cu-sph-intro! z 'a 'r)))
                     (ai `(NOT (IN ,z (SPHERE s a r)))))))))))))
(qed 'ultra-sphere-closed)

;;; -----------------------------------------------------------------------
;;; PROPOSITION 1.5: x ~e y iff d(x, y) < e is an equivalence relation (e > 0).

(define cu-S '(EPS-SETOID s e))
(define cu-rel '(EPS-REL s e))

(sp (make-wff '(FORALL s (FORALL e (== (EPS-REL s e)
  (SEP cuvp_ (CARTESIAN (PTS s) (PTS s)) (< ((DIST s) (NTH 1 cuvp_) (NTH 2 cuvp_)) e)))))))
(di) (mac 'EPS-REL) (qrfl)
(qed 'eps-rel-unfold)

(sp (make-wff '(FORALL s (FORALL e (FORALL u (FORALL v (IMPLIES (IN u (PTS s)) (IMPLIES (IN v (PTS s))
  (IFF (IN (LIST u v) (EPS-REL s e)) (< ((DIST s) u v) e))))))))))
(dk-peel!)
(dk-iff! (lambda (g) (dk-head-is? g '<))
  (lambda ()
    (mac-h 'eps-rel-unfold '(IN (LIST u v) (EPS-REL s e)))
    (sep-me (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) "the separation"))
    (dk-nth-h! (dk-pick (lambda (f) (dk-head-is? f '<)) "the distance"))
    (dk-ass!))
  (lambda ()
    (mac 'eps-rel-unfold)
    (in-sep! (lambda () (fact 'pair-in-cartesian '(PTS s) '(PTS s) 'u 'v) (dk-ass!))
             (lambda () (nth-r) (dk-ass!)))))
(qed 'eps-rel-mem)

;; (IN (LIST u v) EPS-REL) in context: land d(u, v) < e (u, v in PTS in context)
(define (cu-rel-open! u v)
  (let ((mem `(IN (LIST ,u ,v) ,cu-rel)))
    (fact 'eps-rel-mem 's 'e u v)
    (dk-have! `(< ,(cu-d u v) e) (lambda () (cu-keep-prop! (iff-for mem) mem)))))
(define (cu-rel-intro! u v)
  (let ((mem `(IN (LIST ,u ,v) ,cu-rel)))
    (fact 'eps-rel-mem 's 'e u v)
    (cu-keep-prop! (iff-for mem) `(< ,(cu-d u v) e))))

;; PTS(s) is a set (a projection of IS-METRIC-SPACE)
(define (cu-pts-set!)
  (if (not (dk-asm? '(IN (PTS s) SET)))
      (dk-have! '(IN (PTS s) SET) (lambda () (mac-h 'is-metric-space '(IS-METRIC-SPACE s)) (dk-split-all!) (dk-ass!)))))

(sp (make-wff '(FORALL s (IMPLIES (IS-ULTRAMETRIC s) (FORALL e (IMPLIES (IN e RR) (IMPLIES (< 0 e)
  (IS-EQUIVALENCE (EPS-REL s e) (PTS s)))))))))
(dk-peel!)
(cu-ms!)
(cu-pts-set!)
(mac 'is-equivalence)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (if (dk-head-is? g 'IN)
          ;; EPS-REL(s, e) is in POWER(PTS x PTS)
          (let* ((cart '(CARTESIAN (PTS s) (PTS s)))
                 (sepf '(SEP cuvp_ (CARTESIAN (PTS s) (PTS s)) (< ((DIST s) (NTH 1 cuvp_) (NTH 2 cuvp_)) e))))
            (dk-have! `(IN ,cart SET)
              (lambda () (fact 'cartesian-set-iff '(PTS s) '(PTS s))
                         (dk-have! '(AND (IN (PTS s) SET) (IN (PTS s) SET)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                         (cu-keep-prop! (iff-for `(IN ,cart SET)) '(AND (IN (PTS s) SET) (IN (PTS s) SET)))))
            (dk-have! `(IN ,cu-rel SET) (lambda () (mac 'eps-rel-unfold) (sep-set) (dk-ass!)))
            (dk-have! `(FORALL cuz_ (IMPLIES (IN cuz_ ,cu-rel) (IN cuz_ ,cart)))
              (lambda ()
                (let ((z (cadr (car (dk-peel!)))))
                  (mac-h 'eps-rel-unfold `(IN ,z ,cu-rel))
                  (sep-me `(IN ,z ,sepf))
                  (dk-ass!))))
            (fact 'power-mem-intro cart cu-rel)
            (dk-ass!))
          (let* ((landed (dk-peel!))
                 (g2 (dk-goal))
                 (p (cadr (cadr g2))) (q (caddr (cadr g2))))
            (dk-split-all!)
            (for-each (lambda (f) (if (and (dk-head-is? f 'IN) (equal? (caddr f) cu-rel))
                                      (cu-rel-open! (cadr (cadr f)) (caddr (cadr f)))))
                      (dk-asms))
            (cu-real! p q)
            (cond
              ((equal? p q)                       ; reflexive
               (dk-cite! 'metric-self-zero 's p)
               (dk-have! `(< ,(cu-d p p) e) (lambda () (dk-ineq! `(= ,(cu-d p p) 0) '(< 0 e)))))
              ((dk-asm? `(< ,(cu-d q p) e))       ; symmetric
               (dk-cite! 'metric-sym 's p q)
               (dk-have! `(< ,(cu-d p q) e) (lambda () (subst `(= ,(cu-d p q) ,(cu-d q p))) (dk-ass!))))
              (#t                                 ; transitive: d(p, m) < e and d(m, q) < e
               (let* ((h1 (dk-pick (lambda (f) (and (dk-head-is? f '<) (pair? (cadr f)) (= (length (cadr f)) 3) (equal? (cadr f) (cu-d p (caddr (cadr f))))
                                                    (not (equal? (caddr (cadr f)) q))))
                                   "d(p, m) < e"))
                      (m (caddr (cadr h1))))
                 (dk-cite! 'ultra-lt 's p q m 'e))))
            (cu-rel-intro! p q))))))
(qed 'eps-rel-equivalence)

(sp (make-wff '(FORALL s (FORALL e (IMPLIES (IS-METRIC-SPACE s) (IN (EPS-REL s e) SET))))))
(dk-peel!)
(cu-pts-set!)
(let ((cart '(CARTESIAN (PTS s) (PTS s))))
  (dk-have! `(IN ,cart SET)
    (lambda () (fact 'cartesian-set-iff '(PTS s) '(PTS s))
               (dk-have! '(AND (IN (PTS s) SET) (IN (PTS s) SET)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
               (cu-keep-prop! (iff-for `(IN ,cart SET)) '(AND (IN (PTS s) SET) (IN (PTS s) SET)))))
  (mac 'eps-rel-unfold)
  (sep-set)
  (dk-ass!))
(qed 'eps-rel-set)

;; close every leaf left open (the definedness of the literal pair) by rfl
(define (cu-close-owed!)
  (for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (rfl)))) (dk-open-leaves)))

(sp (make-wff '(FORALL s (FORALL e (IMPLIES (IS-METRIC-SPACE s) (== (PTS (EPS-SETOID s e)) (PTS s)))))))
(dk-peel!) (cu-pts-set!) (fact 'eps-rel-set 's 'e)
(mac 'EPS-SETOID) (slot 'PTS) (nth-r) (slot 'PTS) (qrfl)
(cu-close-owed!)
(qed 'eps-setoid-pts)

(sp (make-wff '(FORALL s (FORALL e (IMPLIES (IS-METRIC-SPACE s) (== (REL (EPS-SETOID s e)) (EPS-REL s e)))))))
(dk-peel!) (cu-pts-set!) (fact 'eps-rel-set 's 'e)
(slot 'REL) (mac 'EPS-SETOID) (nth-r) (qrfl)
(cu-close-owed!)
(qed 'eps-setoid-rel)

(sp (make-wff '(FORALL s (IMPLIES (IS-ULTRAMETRIC s) (FORALL e (IMPLIES (IN e RR) (IMPLIES (< 0 e)
  (IS-SETOID (EPS-SETOID s e)))))))))
(dk-peel!)
(cu-ms!)
(cu-pts-set!)
(fact 'eps-rel-equivalence 's 'e)
(mac 'IS-SETOID)
(slot 'pts)
(slot 'rel)
(mac 'EPS-SETOID)
(nth-r)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (dk-ass!))
            ((and (dk-head-is? g '=) (pair? (cadr g)) (eq? (car (cadr g)) 'LENGTH))
             (len-r) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
            ((and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'POWER))
             (let ((h (dk-pick (lambda (f) (dk-head-is? f 'is-equivalence)) "the equivalence")))
               (dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'IS-EQUIVALENCE h)))))
               (dk-ass!)))
            (#t (error "eps-setoid-is-setoid: unexpected conjunct" (expression->string g)))))))
(qed 'eps-setoid-is-setoid)

;;; -----------------------------------------------------------------------
;;; PROPOSITION 1.7: an ultrametric space is totally bounded iff for every e > 0 there are only finitely
;;; many ~e classes (CARD of the quotient of EPS-SETOID(s, e) in NN).

(define (cu-fact-split! thm . args)
  (let ((f (apply dk-cite! thm args)))
    (if (and (pair? f) (eq? (car f) 'AND)) (dk-split-all!))
    f))

(define (cu-Se e) `(EPS-SETOID s ,e))
(define (cu-Qe e) `(QUOTIENT (EPS-SETOID s ,e)))

;; the setoid facts at E (e in RR, 0 < e in context)
(define (cu-S-setup! e)
  (fact 'eps-setoid-is-setoid 's e)
  (fact 'eps-setoid-pts 's e)
  (fact 'eps-setoid-rel 's e))
(define (cu-in-S! x e)
  (dk-have! `(IN ,x (PTS ,(cu-Se e))) (lambda () (subst `(= (PTS ,(cu-Se e)) (PTS s))) (dk-ass!))))
(define (cu-from-S! x e)
  (dk-have! `(IN ,x (PTS s)) (lambda () (subst `(= (PTS s) (PTS ,(cu-Se e)))) (dk-ass!))))
;; RELATED(S, u, v) in context: land d(u, v) < e
(define (cu-related-lt! u v e)
  (let ((r `(RELATED ,(cu-Se e) ,u ,v)) (m `(IN (LIST ,u ,v) (EPS-REL s ,e))))
    (fact 'rko2-related-unfold (cu-Se e) u v)
    (dk-have! `(IN (LIST ,u ,v) (REL ,(cu-Se e))) (lambda () (cu-keep-prop! (iff-for r) r)))
    (dk-have! m (lambda () (subst `(= (EPS-REL s ,e) (REL ,(cu-Se e)))) (dk-ass!)))
    (fact 'eps-rel-mem 's e u v)
    (dk-have! `(< ,(cu-d u v) ,e) (lambda () (cu-keep-prop! (iff-for m) m)))))
;; d(u, v) < e in context: land RELATED(S, u, v)
(define (cu-lt-related! u v e)
  (let ((r `(RELATED ,(cu-Se e) ,u ,v)) (m `(IN (LIST ,u ,v) (EPS-REL s ,e))))
    (fact 'eps-rel-mem 's e u v)
    (dk-have! m (lambda () (cu-keep-prop! (iff-for m) `(< ,(cu-d u v) ,e))))
    (dk-have! `(IN (LIST ,u ,v) (REL ,(cu-Se e))) (lambda () (subst `(= (REL ,(cu-Se e)) (EPS-REL s ,e))) (dk-ass!)))
    (fact 'rko2-related-unfold (cu-Se e) u v)
    (dk-have! r (lambda () (cu-keep-prop! (iff-for r) `(IN (LIST ,u ,v) (REL ,(cu-Se e))))))))

(sp (make-wff '(FORALL s (IMPLIES (IS-ULTRAMETRIC s) (IFF (TOTALLY-BOUNDED s)
  (FORALL e (IMPLIES (IN e RR) (IMPLIES (< 0 e) (IN (CARD (QUOTIENT (EPS-SETOID s e))) NN)))))))))
(dk-peel!)
(cu-ms!)
(cu-pts-set!)
(dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
  ;; totally bounded => finitely many classes: the classes of a finite e-net's points cover the quotient
  (lambda ()
    (let* ((lnd (dk-peel!))
           (e (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) lnd)))
           (sset (cu-Se e)) (qset (cu-Qe e)))
      (cu-S-setup! e)
      (mac-h 'totally-bounded '(TOTALLY-BOUNDED s))
      (dk-split-all!)
      (let ((tbl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-R-NET))) "the nets")))
        (cu-lt-ne! 0 e)
        (dk-have! `(<= 0 ,e) (lambda () (dk-ineq! `(< 0 ,e))))
        (let* ((ante (cadr (caddr tbl))))
          (dk-have! (subst-free (cadr tbl) e ante) (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        (let* ((f (dk-skolem! (dk-apply! tbl e)))
               (net (dk-pick (lambda (x) (dk-head-is? x 'IS-R-NET)) "the net")))
          (mac-h 'is-r-net net)
          (dk-split-all!)
          (let* ((netl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'FORSOME) (dk-contains? x f))) "the net law"))
                 (xset `(IMAGE (PROJ ,sset) ,f)))
            (fact 'subclass-of-set-is-set f '(PTS s))
            (fact 'subset-def f '(PTS s))
            (let ((fsub (dk-have! `(FORALL cux_ (IMPLIES (IN cux_ ,f) (IN cux_ (PTS s))))
                          (lambda () (cu-keep-prop! (iff-for `(SUBSET ,f (PTS s))) `(SUBSET ,f (PTS s)))))))
              (fact 'card-image-finite `(PROJ ,sset) f)
              (fact 'image-set `(PROJ ,sset) f)
              (fact 'quotient-is-set sset)
              (dk-have! `(FORALL cuz_ (IMPLIES (IN cuz_ ,qset) (IN cuz_ ,xset)))
                (lambda ()
                  (let* ((z (cadr (car (dk-peel!))))
                         (a (dk-skolem! (dk-cite! 'quotient-rep sset z))))
                    (cu-from-S! a e)
                    (let* ((c (dk-skolem! (dk-apply! netl a))))
                      (dk-apply! `(FORALL cux_ (IMPLIES (IN cux_ ,f) (IN cux_ (PTS s)))) c)
                      (cu-real! c a)
                      (dk-have! `(AND (<= ,(cu-d c a) ,e) (NOT (= ,(cu-d c a) ,e))) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                      (fact 'rr-le-ne-lt (cu-d c a) e)
                      (cu-lt-related! c a e)
                      (cu-in-S! c e)
                      (let ((ceq `(= (CLASS ,sset ,c) (CLASS ,sset ,a))))
                        (fact 'class-eq-iff sset c a)
                        (dk-have! ceq (lambda () (cu-keep-prop! (iff-for ceq) `(RELATED ,sset ,c ,a))))
                        (fact 'membership-implies-sethood z qset)
                        (let* ((iff (dk-cite! 'image-membership-iff `(PROJ ,sset) f z))
                               (rhs (caddr iff)))
                          (dk-have! rhs
                            (lambda ()
                              (dk-conj-close!
                                (lambda ()
                                  (cond ((dk-ass!) #t)
                                        (#t
                                         (ew c)
                                         (dk-conj-close!
                                           (lambda ()
                                             (if (not (dk-ass!))
                                                 (begin
                                                   (mac 'PROJ)
                                                   (dk-lam-b!)
                                                   (subst `(= ,z (CLASS ,sset ,a)))
                                                   (dk-ass!)))))))))))
                          (cu-keep-prop! iff rhs)))))))
              (dk-have! `(AND (IN ,xset SET) (IN (CARD ,xset) NN)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
              (let ((sub (dk-cite! 'card-subset-nn xset)))
                (dk-have! `(AND (IN ,qset SET) (FORALL cuz_ (IMPLIES (IN cuz_ ,qset) (IN cuz_ ,xset))))
                  (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                (dk-apply! sub qset)
                (dk-ass!))))))))
  ;; finitely many classes => totally bounded: one chosen point per class is an e-net
  (lambda ()
    (let ((h (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'QUOTIENT))) "the finiteness")))
      (mac 'totally-bounded)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((lnd (dk-peel!)))
                (dk-split-all!)
                (let* ((r (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR) (dk-contains? (dk-goal) (cadr f)))) "the radius")))
                       (sset (cu-Se r)) (qset (cu-Qe r))
                       (ch `(VNB-LAMBDA cuq_ ,qset (CHOICE cuq_)))
                       (fset `(IMAGE ,ch ,qset)))
                  (dk-have! `(AND (<= 0 ,r) (NOT (= 0 ,r))) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                  (fact 'rr-le-ne-lt 0 r)
                  (dk-apply! h r)
                  (cu-S-setup! r)
                  (fact 'quotient-is-set sset)
                  (fact 'card-image-finite ch qset)
                  (ew fset)
                  (dk-conj-close!
                    (lambda ()
                      (if (not (dk-ass!))
                          (begin
                            (mac 'is-r-net)
                            (dk-conj-close!
                              (lambda ()
                                (cond
                                  ((dk-ass!) #t)
                                  ((dk-head-is? (dk-goal) 'SUBSET)
                                   ;; a chosen point lies in its class, a subset of the points
                                   (mac 'subset-def)
                                   (let* ((w (cadr (car (dk-peel!))))
                                          (iff (dk-cite! 'image-membership-iff ch qset w)))
                                     (dk-have! (caddr iff) (lambda () (cu-keep-prop! iff `(IN ,w ,fset))))
                                     (dk-split-all!)
                                     (let* ((q (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'CHOICE))) "the class")))
                                            (eqw (dk-pick (lambda (f) (and (dk-head-is? f '=) (dk-contains? f 'CHOICE))) "the choice"))
                                            (eqw2 (dk-lam-b-h! eqw))
                                            (a (dk-skolem! (dk-cite! 'quotient-rep sset q))))
                                       (dk-cite! 'class-self sset a)
                                       (dk-rewrite-h! `(IN ,a (CLASS ,sset ,a)) `(CLASS ,sset ,a) q)
                                       (dk-have! `(FORSOME cuy_ (IN cuy_ ,q)) (lambda () (ew a) (dk-ass!)))
                                       (fact 'choice-axiom q)
                                       (cu-fact-split! 'class-of-member sset q `(CHOICE ,q))
                                       (cu-from-S! `(CHOICE ,q) r)
                                       (subst `(= ,w (CHOICE ,q)))
                                       (dk-ass!))))
                                  (#t
                                   ;; p ~r CHOICE([p]): the chosen point of p's class is within r of p
                                   (let* ((p (cadr (car (dk-peel!))))
                                          (q `(CLASS ,sset ,p))
                                          (c `(CHOICE ,q)))
                                     (cu-in-S! p r)
                                     (dk-cite! 'class-in-quotient sset p)
                                     (dk-cite! 'class-self sset p)
                                     (dk-have! `(FORSOME cuy_ (IN cuy_ ,q)) (lambda () (ew p) (dk-ass!)))
                                     (fact 'choice-axiom q)
                                     (cu-fact-split! 'class-of-member sset q c)
                                     (let ((ceq `(= (CLASS ,sset ,c) (CLASS ,sset ,p))))
                                       (fact 'class-eq-iff sset c p)
                                       (dk-have! `(RELATED ,sset ,c ,p) (lambda () (cu-keep-prop! (iff-for ceq) ceq))))
                                     (cu-from-S! c r)
                                     (cu-related-lt! c p r)
                                     (cu-real! c p)
                                     (cu-lt-ne! (cu-d c p) r)
                                     (ew c)
                                     (dk-conj-close!
                                       (lambda ()
                                         (cond ((dk-ass!) #t)
                                               ((dk-head-is? (dk-goal) '<=) (dk-ineq! `(< ,(cu-d c p) ,r)))
                                               (#t
                                                (fact 'membership-implies-sethood c q)
                                                (let* ((iff (dk-cite! 'image-membership-iff ch qset c))
                                                       (rhs (caddr iff)))
                                                  (dk-have! rhs
                                                    (lambda ()
                                                      (dk-conj-close!
                                                        (lambda ()
                                                          (cond ((dk-ass!) #t)
                                                                (#t (ew q)
                                                                    (dk-conj-close!
                                                                      (lambda ()
                                                                        (if (not (dk-ass!))
                                                                            (begin (dk-lam-b!) (rfl)))))))))))
                                                  (cu-keep-prop! iff rhs)))))))))))))))))))))))
(qed 'ultra-totally-bounded-iff)
