    (dk-real! kk)
    (fek-lin! (list '< 0 kk) (list '<= 0 cm) (list '< cm kk))
    (dk-cite! 'fek-root-lt am kk mm)
    (let ((nn0 (dk-skolem! (dk-cite! 'fek-upper 'al kk mm) #t)))
      (dk-have! (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN) (list 'IMPLIES (list '<= nn0 'k_)
                  (list '<= '(abs (- (g k_) lv)) 'eps))))
        (lambda ()
          (dk-peel!)
          (let* ((sk '(succ k_)) (ask (list 'al sk)) (x (fek-rt ask sk)))
            (dk-cite! 'nn-succ-closed 'k_)
            (dk-cite! 'nn-in-rr 'k_)
