;;; ---- the key step: some al(m) < 1 makes al(n) <= 1 for all large n ----------------------
(define (fek-find-forsome v)
  (or (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (memq v (free-vars f)))) (dk-asms))
      (error "fek-find-forsome: no existential mentioning" v)))
(define (fek-comm! x y) (fek-cite2! 'rr-mul-comm x y))

(sp (make-wff (list 'FORALL 'al (list 'IMPLIES '(IN al (FUN NN RR)) (list 'IMPLIES fek-nonneg (list 'IMPLIES fek-submult
  '(FORALL m (IMPLIES (IN m NN) (IMPLIES (<= 1 m) (IMPLIES (< (al m) 1)
     (FORSOME nn0 (AND (IN nn0 NN) (FORALL n (IMPLIES (IN n NN) (IMPLIES (<= nn0 n) (<= (al n) 1))))))))))))))))
(dk-peel!)
(let* ((am '(al m))
       (bd (dk-skolem! (dk-cite! 'fek-bound 'm 'al) #t))
       (rb (list 'RECIP bd)))
  (dk-cite! 'nn-in-rr 'm)
  (dk-cite! 'fun-apply-type-c 'al 'NN 'RR 'm)
  (dk-apply! fek-nonneg 'm)
  (fek-lin! (list '< 0 bd) (list '<= 1 bd))
  (fek-lin! (list '<= 0 bd) (list '<= 1 bd))
  (dk-cite! 'rr-pos-ne-zero bd)
  (fek-cite2! 'rr-recip-closed bd)
  (dk-cite! 'rr-recip-pos bd)
  (dk-cite! 'rr-pos-rr-of-lt rb)
  (let* ((thr (fek-cite2! 'power-small-threshold am))
         (pp (dk-skolem! (dk-apply! thr rb) #t))
         (spp (list 'succ pp))
         (nn0 (list '* 'm spp)))
    (dk-cite! 'nn-succ-closed pp)
    (fek-cite2! 'nn-mul-closed 'm spp)
    (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES (list '<= nn0 'n) '(<= (al n) 1))))
      (lambda ()
        (dk-peel!)
        (let* ((q (dk-skolem! (dk-cite! 'nn-division-remainder 'm 'n) #t))
               (r (dk-skolem! (fek-find-forsome q) #t))
               (mq (list '* 'm q)) (mqr (list '+ mq r)) (pq (fek-pw am q)))
          (fek-cite2! 'nn-mul-closed 'm q)
          (for-each (lambda (x) (dk-cite! 'nn-in-rr x)) (list 'n q r mq pp spp nn0))
          ;; q >= succ(P), else n = m q + r < m q + m <= m succ(P) <= n
          (dk-have! (list '<= spp q)
            (lambda ()
              (use-em (list '<= spp q)
                (lambda () (dk-ass!))
                (lambda ()
                  (dk-cite! 'rr-not-le-lt spp q)
                  (dk-cite! 'nn-mul-gap 'm q spp)
                  (dk-absurd! (list '= 'n mqr) (list '< r 'm) (list '<= (list '+ mq 'm) nn0)
                              (list '<= nn0 'n))))))
          (dk-cite! 'nn-succ-plus-one pp)
          (fek-lin! (list '<= pp q) (list '<= spp q) (list '= spp (list '+ pp 1)))
          (dk-have! (list '<= 1 q) (lambda () (dk-nn! (list '<= spp q) (list '= spp (list '+ pp 1)))))
          (let* ((j (dk-skolem! (dk-cite! 'nn-pos-is-succ q) #t))
                 (sj (list 'succ j)))
            (dk-rewrite-h! (dk-cite! 'fek-pow-mult j 'al 'm) sj q)
            (dk-apply! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES (list '<= pp 'k) (list '<= (fek-pw am 'k) rb))))
                       q)
            (dk-cite! 'fun-apply-type-c 'al 'NN 'RR mq)
            (dk-cite! 'power-real-closed am q)
            (dk-cite! 'rr-power-nonneg q am)
            (dk-real! 1)
            (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
            (fact 'rr-recip-one)
            (dk-rewrite-h! (dk-cite! 'rr-recip-antitone 1 bd) '(RECIP 1) 1)
            (subst (list '= 'n mqr))
            (use-em (list '= r 0)
              (lambda ()
                (subst (list '= r 0))
                (dk-cite! 'nn-add-zero mq)
                (subst (list '= (list '+ mq 0) mq))
                (dk-le-chain! (list 'al mq) pq rb 1))
              (lambda ()
                (dk-cite! 'nn-one-le-nonzero r)
                (dk-cite! 'nn-in-rr j)
                (fek-cite2! 'nn-mul-closed 'm j)
                (dk-cite! 'nn-in-rr (list '* 'm j))
                (dk-rewrite-h! (dk-cite! 'nn-mul-succ 'm j) sj q)
                (dk-cite! 'nn-le-add-left (list '* 'm j) 'm)
                (fek-lin! (list '<= 1 mq) '(<= 1 m) (list '<= 'm (list '+ (list '* 'm j) 'm))
                          (list '= mq (list '+ (list '* 'm j) 'm)))
                (dk-apply! fek-submult mq r)
                (fek-lin! (list '<= r 'm) (list '< r 'm))
                (dk-apply! (list 'FORALL 'r (list 'IMPLIES '(IN r NN) (list 'IMPLIES (list '<= 'r 'm) (list '<= '(al r) bd))))
                           r)
                (dk-cite! 'fun-apply-type-c 'al 'NN 'RR r)
                (dk-apply! fek-nonneg r)
                (let ((ar (list 'al r)))
                  (dk-cite! 'rr-mul-le-right (list 'al mq) pq ar)
                  (fek-comm! pq ar)
                  (dk-cite! 'rr-mul-le-right ar bd pq)
                  (fek-comm! bd pq)
                  (dk-cite! 'rr-mul-le-right pq rb bd)
                  (fek-cite2! 'rr-recip-inverse bd)
                  (fek-comm! rb bd)
                  (dk-le-chain! (list 'al mqr) (list '* (list 'al mq) ar) (list '* pq ar) (list '* ar pq)
                                (list '* bd pq) (list '* pq bd) (list '* rb bd) (list '* bd rb) 1))))))))
    (ew nn0)
    (dk-conj-close! (lambda () (dk-ass!)))))
(fek-qed! 'fek-eventually)

;;; ---- al(m) < K^m makes al(n) <= K^n for all large n (normalise by K^n) ------------------
(define fek-be '(VNB-LAMBDA fkn_ NN (* (al fkn_) (RECIP (POWER K fkn_)))))
(define (fek-sub-al f) (dk--replace f 'al fek-be))
(define (fek-bterm j) (list '* (list 'al j) (list 'RECIP (fek-pw 'K j))))
;;; land the typings of K^j, recip(K^j), al(j), the term, and 0 < K^j, 0 < recip(K^j), K^j /= 0
(define (fek-btype! j)
  (let* ((pj (fek-pw 'K j)) (rj (list 'RECIP pj)))
    (dk-cite! 'fun-apply-type-c 'al 'NN 'RR j)
    (dk-cite! 'power-real-closed 'K j)
    (dk-cite! 'rr-power-pos 'K j)
    (dk-cite! 'rr-pos-ne-zero pj)
    (fek-cite2! 'rr-recip-closed pj)
    (dk-cite! 'rr-recip-pos pj)
    (dk-cite! 'rr-mul-in-rr (list 'al j) rj)
    (list 'IN (fek-bterm j) 'RR)))
;;; land  BE(j) = al(j) recip(K^j)
(define (fek-bval! j)
  (fek-btype! j)
  (let ((eq (list '= (list fek-be j) (fek-bterm j))))
    (dk-have! eq (lambda () (if (not (dk-lam-b!)) (rfl))))
    eq))

(sp (make-wff (list 'FORALL 'al (list 'IMPLIES '(IN al (FUN NN RR)) (list 'IMPLIES fek-nonneg (list 'IMPLIES fek-submult
  '(FORALL K (IMPLIES (IN K RR) (IMPLIES (< 0 K) (FORALL m (IMPLIES (IN m NN) (IMPLIES (<= 1 m)
     (IMPLIES (< (al m) (POWER K m))
       (FORSOME nn0 (AND (IN nn0 NN) (FORALL n (IMPLIES (IN n NN) (IMPLIES (<= nn0 n) (<= (al n) (POWER K n))))))))))))))))))))
(dk-peel!)
(dk-cite! 'rr-subset-cc 'K)
(dk-have! (list 'IN fek-be '(FUN NN RR))
  (lambda ()
    (dk-lam-type! (lambda ()
                    (let ((j (cadr (dk-goal))))
                      (dk-peel!)
                      (fek-btype! j)
                      (dk-ass!))))))
