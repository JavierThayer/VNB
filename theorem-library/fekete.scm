    (ew tt)
    (dk-conj-close! (lambda () (dk-ass!))))
  ;; step: bd' = bd + al(succ v)
  (dk-focus! step)
  (let* ((bd (dk-skolem! ih #t)) (sv (list 'succ v)) (asv (list 'al sv)) (tt (list '+ bd asv)))
