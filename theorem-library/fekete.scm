    (dk-have! (list 'FORALL 'r (list 'IMPLIES '(IN r NN) (list 'IMPLIES (list '<= 'r sv) (list '<= '(al r) tt))))
      (lambda ()
        (dk-peel!)
        (dk-cite! 'fun-apply-type-c 'al 'NN 'RR 'r)
        (dk-cite! 'nn-le-succ-cases v 'r)
        (use-em (list '<= 'r v)
          (lambda ()
