;;; fekete.scm -- FEKETE'S LEMMA, multiplicative form (Thayer, "Banach Algebras and
;;; Applications", Lemma 1.7): if al(n) >= 0 and al(m + n) <= al(m) al(n) for m, n >= 1, then
;;; al(n)^(1/n) converges, to inf_(n >= 1) al(n)^(1/n).
;;; Agent BA-1C, wave 2026-11-09.  Destination: theorem-library/fekete.scm.
;;; Library: analysis (a real-sequence lemma; BA-MAP-REPORT.md s.3.9 puts Fekete there).
;;; All proofs modulo 0.  Helper prefix: fek-.
;;;
;;; THE ROUTE (avoids lim sup, avoids limits of rpow-star).  Let L be the infimum, eps > 0,
;;; K = L + eps.  Some m >= 1 has al(m)^(1/m) < K, hence al(m) < K^m.  Normalise:
;;; be(n) = al(n) / K^n is again submultiplicative and be(m) < 1.  For n = q m + r (r < m,
;;; Euclidean division) be(n) <= be(m)^q be(r) <= be(m)^q B, B a bound of be on [0, m];
;;; be(m)^q <= 1/B once q is large, so be(n) <= 1, al(n) <= K^n and al(n)^(1/n) <= K, for
;;; all large n.  With L <= al(n)^(1/n) (L is a lower bound) the sequence converges to L.
;;;
;;; The statement takes L by its two defining properties (a lower bound of the roots, and
;;; every L + eps is exceeded by some root) rather than as an EINF term, and the sequence as
;;; any g with g(n) = al(n + 1)^(1/(n + 1)): a caller (the spectral radius, ba-fekete.scm)
;;; then never rewrites under a SEP or a lambda binder.
;;;
;;; LOAD WINDOW: after theorem-library/lp-convergence (rps-below-real-is-real is not cited
;;; here; the latest citations are rpow-star (3467), mb12-snow (3583: rpow-mono-le),
;;; limsup-tests (3582: rpow-star-nat, rr-power-mono-base), cc-power-add (3756),
;;; rake-series2 (3629: power-small-threshold), antiderivable-uniform-limit (3252:
;;; rr-converges-to-abs)).  The exact floor is printed in the report.

(define (fek-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** fekete: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "fekete: unfinished" name))))

(define (fek-lin! claim . prems) (dk-have! claim (lambda () (apply dk-ineq! prems))))
(define (fek-ind! . h) (let ((br (apply dk-use-induction-fixed! h)))
  (list (cdr (assq 'base br)) (cdr (assq 'step br)) (cdr (assq 'ih br)) (cdr (assq 'var br)))))
(define (fek-cite2! . args)
  (let loop ((ch (apply dk-cite! args)))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
(define (fek-pw x n) (list 'POWER x n))
(define (fek-rt x n) (list 'RPOW-STAR x (list 'RECIP-STAR n)))

;;; the hypotheses on a sequence al (a function NN -> RR)
(define fek-nonneg '(FORALL n_ (IMPLIES (IN n_ NN) (<= 0 (al n_)))))
(define fek-submult
  '(FORALL m_ (IMPLIES (IN m_ NN) (IMPLIES (<= 1 m_) (FORALL n_ (IMPLIES (IN n_ NN) (IMPLIES (<= 1 n_)
     (<= (al (+ m_ n_)) (* (al m_) (al n_))))))))))

;;; ---- roots of powers -------------------------------------------------------------------
;;; (K^n)^(1/n) = K for K > 0, n >= 1
(sp (make-wff '(FORALL K (IMPLIES (IN K RR) (IMPLIES (< 0 K) (FORALL n (IMPLIES (IN n NN) (IMPLIES (<= 1 n)
  (= (RPOW-STAR (POWER K n) (RECIP-STAR n)) K)))))))))
(dk-peel!)
(dk-cite! 'nn-in-rr 'n)
(dk-cite! 'recip-star-in-rr 'n)
(dk-cite! 'rpow-star-nat 'n 'K)
(subst '(= (POWER K n) (RPOW-STAR K n)))
(dk-cite! 'rpow-star-pow 'K 'n '(RECIP-STAR n))
(subst (list '= '(RPOW-STAR (RPOW-STAR K n) (RECIP-STAR n)) '(RPOW-STAR K (* n (RECIP-STAR n)))))
(fek-lin! '(< 0 n) '(<= 1 n))
(dk-cite! 'rr-pos-ne-zero 'n)
(dk-cite! 'recip-star-inverse 'n)
(subst '(= (* n (RECIP-STAR n)) 1))
(dk-cite! 'rpow-star-one 'K)
(dk-ass!)
(fek-qed! 'fek-root-power)

;;; x <= K^n  ==>  x^(1/n) <= K
(sp (make-wff '(FORALL x (IMPLIES (IN x RR) (IMPLIES (<= 0 x) (FORALL K (IMPLIES (IN K RR) (IMPLIES (< 0 K)
  (FORALL n (IMPLIES (IN n NN) (IMPLIES (<= 1 n) (IMPLIES (<= x (POWER K n))
    (<= (RPOW-STAR x (RECIP-STAR n)) K)))))))))))))
(dk-peel!)
(dk-cite! 'nn-in-rr 'n)
(dk-cite! 'recip-star-nn-pos 'n)
(dk-cite! 'recip-star-in-rr 'n)
(dk-cite! 'power-real-closed 'K 'n)
(dk-cite! 'rpow-mono-le 'x '(POWER K n) '(RECIP-STAR n))
(dk-cite! 'fek-root-power 'K 'n)
(subst '(= K (RPOW-STAR (POWER K n) (RECIP-STAR n))))
(dk-ass!)
(fek-qed! 'fek-root-le)

;;; x^(1/n) < K  ==>  x < K^n
(sp (make-wff '(FORALL x (IMPLIES (IN x RR) (IMPLIES (<= 0 x) (FORALL K (IMPLIES (IN K RR) (IMPLIES (< 0 K)
  (FORALL n (IMPLIES (IN n NN) (IMPLIES (<= 1 n) (IMPLIES (< (RPOW-STAR x (RECIP-STAR n)) K)
    (< x (POWER K n))))))))))))))
(dk-peel!)
(dk-cite! 'power-real-closed 'K 'n)
(dk-cite! 'nn-in-rr 'n)
(dk-cite! 'recip-star-nn-pos 'n)
(dk-cite! 'recip-star-in-rr 'n)
(fek-lin! '(<= 0 (RECIP-STAR n)) '(< 0 (RECIP-STAR n)))
(dk-cite! 'rpow-star-nonneg-in-rr 'x '(RECIP-STAR n))
(use-em '(<= (POWER K n) x)
  (lambda ()
    (dk-cite! 'rr-power-pos 'K 'n)
    (fek-lin! '(<= 0 (POWER K n)) '(< 0 (POWER K n)))
    (dk-cite! 'rpow-mono-le '(POWER K n) 'x '(RECIP-STAR n))
    (dk-cite! 'fek-root-power 'K 'n)
    (dk-cite! 'rpow-star-nonneg-in-rr '(POWER K n) '(RECIP-STAR n))
    (dk-absurd! '(<= (RPOW-STAR (POWER K n) (RECIP-STAR n)) (RPOW-STAR x (RECIP-STAR n)))
                '(= (RPOW-STAR (POWER K n) (RECIP-STAR n)) K)
                '(< (RPOW-STAR x (RECIP-STAR n)) K)))
  (lambda ()
    (dk-cite! 'rr-not-le-lt '(POWER K n) 'x)
    (dk-ass!)))
(fek-qed! 'fek-root-lt)

(display "\n;; FEK part 1 qed failures: ")  

