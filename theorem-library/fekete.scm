(fek-qed! 'fek-pow-mult)

;;; ---- a bound of al on [0, m] -----------------------------------------------------------
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'al (list 'IMPLIES '(IN al (FUN NN RR))
  (list 'IMPLIES fek-nonneg
    '(FORSOME bd (AND (IN bd RR) (AND (<= 1 bd) (FORALL r (IMPLIES (IN r NN) (IMPLIES (<= r m) (<= (al r) bd))))))))))))))
(let* ((br (fek-ind! '(al))) (base (car br)) (step (cadr br)) (ih (caddr br)) (v (cadddr br)))
  ;; base: bd = 1 + al(0)
  (dk-focus! base)
  (fact 'nn-zero-in)
  (dk-cite! 'fun-apply-type-c 'al 'NN 'RR 0)
  (dk-apply! fek-nonneg 0)
  (let ((tt '(+ 1 (al 0))))
    (dk-real! tt)
    (fek-lin! (list '<= 1 tt) '(<= 0 (al 0)))
    (dk-have! (list 'FORALL 'r (list 'IMPLIES '(IN r NN) (list 'IMPLIES '(<= r 0) (list '<= '(al r) tt))))
      (lambda ()
        (dk-peel!)
        (dk-cite! 'nn-le-zero-is-zero 'r)
        (subst '(= r 0))
