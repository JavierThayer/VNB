  (lambda ()
    (let ((j (cadr (dk-goal))))
      (dk-peel!)
      (subst (fek-bval! j))
      (dk-apply! fek-nonneg j)
      (fek-lin! (list '<= 0 (list 'RECIP (fek-pw 'K j))) (list '< 0 (list 'RECIP (fek-pw 'K j))))
      (fek-cite2! 'rr-leq-mul-nonneg (list 'al j) (list 'RECIP (fek-pw 'K j)))
      (dk-ass!))))
(dk-have! (fek-sub-al fek-submult)
  (lambda ()
    (let* ((g0 (dk-goal)) (mm (cadr g0)) (nn (cadr (caddr (caddr (caddr g0))))))
      (dk-peel!)
      (let* ((s (list '+ mm nn))
             (pm (fek-pw 'K mm)) (pn (fek-pw 'K nn)) (rm (list 'RECIP pm)) (rn (list 'RECIP pn))
             (am (list 'al mm)) (an (list 'al nn)))
        (fek-cite2! 'nn-add-closed mm nn)
        (subst (fek-bval! s))
        (subst (fek-bval! mm))
        (subst (fek-bval! nn))
        (dk-cite! 'cc-power-add nn mm 'K)
        (subst (list '= (fek-pw 'K s) (list '* pm pn)))
        (dk-cite! 'rr-subset-cc pm)
        (dk-cite! 'rr-subset-cc pn)
        (dk-cite! 'cc-recip-mul pm pn)
        (subst (list '= (list 'RECIP (list '* pm pn)) (list '* rm rn)))
        (dk-apply! fek-submult mm nn)
        (dk-cite! 'rr-mul-in-rr am an)
        (dk-cite! 'rr-mul-in-rr rm rn)
        (fek-lin! (list '<= 0 rm) (list '< 0 rm))
        (fek-lin! (list '<= 0 rn) (list '< 0 rn))
        (fek-cite2! 'rr-leq-mul-nonneg rm rn)
        (dk-cite! 'rr-mul-le-right (list 'al s) (list '* am an) (list '* rm rn))
        (dk-have! (list '= (list '* (list '* am an) (list '* rm rn)) (list '* (list '* am rm) (list '* an rn)))
          (lambda () (dk-crs-opaque!)))
        (dk-le-chain! (list '* (list 'al s) (list '* rm rn)) (list '* (list '* am an) (list '* rm rn))
                      (list '* (list '* am rm) (list '* an rn)))))))
(let* ((pm (fek-pw 'K 'm)) (bm (list fek-be 'm)) (eqm (fek-bval! 'm)))
  (dk-real! 1)
  (let* ((rm (list 'RECIP pm))
         (lt0 (fek-cite2! 'rr-lt-scale-pos rm '(al m) pm))
         (c1 (fek-comm! rm '(al m)))
         (c2 (fek-comm! rm pm))
         (inv (fek-cite2! 'rr-recip-inverse pm))
         (lt1 (dk-rewrite-h! lt0 (list '* rm '(al m)) (list '* '(al m) rm)))
         (lt2 (dk-rewrite-h! lt1 (list '* rm pm) (list '* pm rm)))
         (lt3 (dk-rewrite-h! lt2 (list '* pm rm) 1)))
    (dk-have! (list '< bm 1) (lambda () (subst eqm) (dk-ass!))))
  (let* ((nn0 (dk-skolem! (dk-cite! 'fek-eventually fek-be 'm) #t))
         (ev (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES (list '<= nn0 'n) (list '<= (list fek-be 'n) 1))))))
    (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES (list '<= nn0 'n) '(<= (al n) (POWER K n)))))
      (lambda ()
        (dk-peel!)
        (let* ((pn (fek-pw 'K 'n)) (bt (fek-bterm 'n)) (eqn (fek-bval! 'n)))
          (dk-apply! ev 'n)
          (dk-rewrite-h! (list '<= (list fek-be 'n) 1) (list fek-be 'n) bt)
          (fek-lin! (list '<= 0 pn) (list '< 0 pn))
          (dk-cite! 'rr-mul-le-right bt 1 pn)
          (dk-cite! 'rr-recip-cancel-right '(al n) pn)
          (dk-have! (list '= (list '* 1 pn) pn) (lambda () (crs)))
          (dk-cite! 'rr-mul-in-rr bt pn)
          (dk-le-chain! '(al n) (list '* bt pn) (list '* 1 pn) pn))))
    (ew nn0)
    (dk-conj-close! (lambda () (dk-ass!)))))
(fek-qed! 'fek-upper)

;;; ---- FEKETE'S LEMMA ---------------------------------------------------------------------
;;; al >= 0, al(m + n) <= al(m) al(n) (m, n >= 1), L the infimum of the roots al(k)^(1/k)
;;; (k >= 1): then g(n) = al(n + 1)^(1/(n + 1)) converges to L.
(define fek-root-k '(RPOW-STAR (al k) (RECIP-STAR k)))
(sp (make-wff (list 'FORALL 'al (list 'IMPLIES '(IN al (FUN NN RR)) (list 'IMPLIES fek-nonneg (list 'IMPLIES fek-submult
  '(FORALL lv (IMPLIES (IN lv RR)
     (IMPLIES (FORALL k (IMPLIES (IN k NN) (IMPLIES (<= 1 k) (<= lv (RPOW-STAR (al k) (RECIP-STAR k))))))
     (IMPLIES (FORALL eps (IMPLIES (POS-RR eps)
                (FORSOME k (AND (IN k NN) (AND (<= 1 k) (< (RPOW-STAR (al k) (RECIP-STAR k)) (+ lv eps)))))))
     (FORALL g (IMPLIES (IN g (FUN NN RR))
       (IMPLIES (FORALL n (IMPLIES (IN n NN) (= (g n) (RPOW-STAR (al (succ n)) (RECIP-STAR (succ n))))))
         (CONVERGES-TO RR-MS g lv))))))))))))))
(dk-peel!)
(let* ((hlow '(FORALL k (IMPLIES (IN k NN) (IMPLIES (<= 1 k) (<= lv (RPOW-STAR (al k) (RECIP-STAR k)))))))
       (hinf '(FORALL eps (IMPLIES (POS-RR eps)
                (FORSOME k (AND (IN k NN) (AND (<= 1 k) (< (RPOW-STAR (al k) (RECIP-STAR k)) (+ lv eps)))))))))
  (detach-with! (dk-cite! 'rr-converges-to-abs 'g 'lv) (lambda ()
  (dk-peel!)
  (dk-cite! 'rr-pos-rr-in-rr 'eps)
  (dk-cite! 'rr-lt-of-pos-rr 'eps)
  (let* ((mm (dk-skolem! (dk-apply! hinf 'eps) #t))
         (kk (list '+ 'lv 'eps))
         (am (list 'al mm)) (cm (fek-rt am mm)))
    (dk-cite! 'nn-in-rr mm)
    (dk-cite! 'fun-apply-type-c 'al 'NN 'RR mm)
    (dk-apply! fek-nonneg mm)
    (dk-cite! 'recip-star-nn-pos mm)
    (dk-cite! 'recip-star-in-rr mm)
    (fek-lin! (list '<= 0 (list 'RECIP-STAR mm)) (list '< 0 (list 'RECIP-STAR mm)))
    (dk-cite! 'rpow-star-nonneg-nonneg am (list 'RECIP-STAR mm))
