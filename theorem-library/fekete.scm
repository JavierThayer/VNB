            (dk-apply! '(FORALL n (IMPLIES (IN n NN) (= (g n) (RPOW-STAR (al (succ n)) (RECIP-STAR (succ n)))))) 'k_)
            (subst (list '= '(g k_) x))
            (dk-cite! 'recip-star-nn-pos sk)
