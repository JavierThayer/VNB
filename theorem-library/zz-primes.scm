       (n (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'gun_))) (dk-asms))))
       (q (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'gup_) (dk-contains? f n))) (dk-asms))))
       (pq (list 'PROD-RING 'ZZ-RING q (list 'INTERVAL 1 n)))
       (f (nt4-absl q)))
  (nt4-pseq-typ! q n)
  (nt4-ptw q n (lambda (z) (dk-apply! (dk-ctx-form (nt4-ptq q n)) z)))
  (nt4-prod-type! q n)
  (nt4-open! 'is-unit (list 'ZZ-RING u) (list 'IS-UNIT 'ZZ-RING u))
  (dk-rewrite-h! (list 'IN u '(CARR ZZ-RING)) '(CARR ZZ-RING) 'ZZ)
  (let ((v (dk-skolem! (dk-ctx-form (list 'FORSOME 'guv_ (list 'AND '(IN guv_ (CARR ZZ-RING)) (list '= (list '(MUL ZZ-RING) u 'guv_) '(ONE ZZ-RING))))))))
    (dk-rewrite-h! (list 'IN v '(CARR ZZ-RING)) '(CARR ZZ-RING) 'ZZ)
