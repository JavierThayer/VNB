    (dk-rewrite-h! (dk-rewrite-h! (list '= (list '(MUL ZZ-RING) u v) '(ONE ZZ-RING)) (list '(MUL ZZ-RING) u v) (list '* u v)) '(ONE ZZ-RING) 1)
