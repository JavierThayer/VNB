    (lambda ()
      (nt4-close! 'is-unit '(ZZ-RING 1)
        (lambda ()
          (nt4-in-carr! 1)
          (nt4-mul! 1 1)
          (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew 1) (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst '(= ((MUL ZZ-RING) 1 1) (* 1 1))) (subst '(== (ONE ZZ-RING) 1)) (crs)))))))))))))
