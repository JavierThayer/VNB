                          (dk-have! (list '<= t 0) (lambda () (dk-ineq! (list '< t 0))))
                          (dk-apply! (dk-cite! 'rr-mul-le-right t 0 'd))
                          (dk-type! '(* 0 d) 'RR)
                          (dk-have! '(= (* 0 d) 0) (lambda () (crs)))
                          (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '<= (list '* t 'd) '(* 0 d)) '(= (* 0 d) 0) (list '= k (list '* t 'd)) (list '<= 1 k) (list 'IN k 'RR) (list 'IN (list '* t 'd) 'RR) '(IN (* 0 d) RR))))
                          (ap-absurd!))
                        (lambda ()
                          (dk-have! (list '= k 0) (lambda () (subst (list '= k (list '* t 'd))) (subst (list '= t 0)) (crs)))
                          (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= k 0) (list '<= 1 k))))
                          (ap-absurd!))
                        (lambda () (ass))))))
            (dk-apply! (dk-cite! 'zz-discrete) t)
            (dk-have! (list '<= 0 t) (lambda () (dk-ineq! (list '< 0 t))))
            (dk-apply! (dk-cite! 'zz-nonneg-in-nn) t)
            (dk-apply! (dk-cite! 'interval-mem-intro 1 'c t))
            (val! t)
            (ew t)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (begin
                      (subst (list '= (list phi t) (list '* 'd t)))
                      (subst (list '= k (list '* 'd t)))
                      (rfl)))))))))
    (ma-iff-back! iff)
    (dk-apply! (dk-cite! 'card-bijection-eq) ic m phi)
    (dk-apply! (dk-cite! 'interval-card) 'c)
    (subst (list '= (list 'CARD m) (list 'CARD ic)))
    (ass)))
(qed 'multiples-count)

;;; a prime factor of every integer d with |d| >= 2 (the last factor of a prime factorisation of |d|)
(sp (make-wff '(FORALL d (IMPLIES (IN d ZZ) (IMPLIES (NOT (= d 0)) (IMPLIES (NOT (= d 1)) (IMPLIES (NOT (= d (- 1)))
  (FORSOME ntp_ (AND (IS-PRIME-NAT ntp_) (ZZ-DIVIDES ntp_ d))))))))))
(dk-peel!)
(nt4-zzr!)
(dk-cite! 'zz-is-commutative-ring)
(nt4-abs-nn! 'd)
(fact 'nn-in-rr '(abs d))
(dk-type! 'd 'RR)
(dk-apply! (dk-cite! 'rr-abs-nonneg) 'd)
(dk-have! '(NOT (= (abs d) 0)) (lambda () (di) (ma-iff-parts! (dk-cite! 'rr-abs-zero 'd)) (ma-prop-with! (list '(= d 0) '(NOT (= d 0))))))
(dk-have! '(< 0 (abs d))
  (lambda () (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases 0 '(abs d))) (list (lambda () (ass)) (lambda () (dk-have! '(= (abs d) 0) (lambda () (subst '(= (abs d) 0)) (rfl))) (ma-prop-with! (list '(= (abs d) 0) '(NOT (= (abs d) 0)))))))))
(dk-apply! (dk-cite! 'zz-discrete) '(abs d))
(let* ((k (dk-skolem! (dk-apply! (dk-cite! 'prime-factorization-exists) '(abs d))))
       (q (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'ntp_) (dk-contains? f k))) (dk-asms))))
       (pk (list 'PROD-RING 'ZZ-RING q (list 'INTERVAL 1 k))))
  ;; k /= 0: the empty product is 1, but |d| /= 1
  (ma-or-split! (dk-cite! 'nn-zero-or-succ k)
    (list
      (lambda ()
        (nt4-int0!)
        (dk-cite! 'prod-ring-empty 'ZZ-RING q)
        (let ((h (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (list '= '(abs d) pk) k 0) '(INTERVAL 1 0) 'EMPTY-SET) (list 'PROD-RING 'ZZ-RING q 'EMPTY-SET) '(ONE ZZ-RING))))
          (dk-rewrite-h! h '(ONE ZZ-RING) 1)
          (ma-or-split! (dk-apply! (dk-cite! 'rr-abs-cases) 'd)
            (list (lambda () (dk-split-all!) (dk-have! '(= d 1) (lambda () (subst '(= d (abs d))) (ass))) (ma-prop-with! (list '(= d 1) '(NOT (= d 1)))))
                  (lambda () (dk-split-all!) (dk-have! '(= d (- 1)) (lambda () (dk-have! '(= d (- (abs d))) (lambda () (subst '(= (abs d) (- d))) (crs))) (subst '(= d (- (abs d)))) (subst '(= (abs d) 1)) (rfl)))
                                (ma-prop-with! (list '(= d (- 1)) '(NOT (= d (- 1))))))))))
      (lambda ()
        (let* ((j (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f k) (not (dk-contains? f 'ntp_)))) (dk-asms))))
               (sj (list 'succ j)) (pj (list 'PROD-RING 'ZZ-RING q (list 'INTERVAL 1 j))) (top (list q sj)))
          (fact 'nn-succ-closed j)
          (dk-rewrite-h! (list 'FORALL 'nti_ (list 'IMPLIES (list 'IN 'nti_ (list 'INTERVAL 1 k)) (list 'IS-PRIME-NAT (list q 'nti_)))) k sj)
          (dk-rewrite-h! (list '= '(abs d) pk) k sj)
          (let ((pn! (lambda (i) (dk-apply! (dk-ctx-form (list 'FORALL 'nti_ (list 'IMPLIES (list 'IN 'nti_ (list 'INTERVAL 1 sj)) (list 'IS-PRIME-NAT (list q 'nti_))))) i)
                                 (nt4-open! 'is-prime-nat (list (list q i)) (list 'IS-PRIME-NAT (list q i))) (dk-type! (list q i) 'ZZ))))
            (dk-have! (nt4-ptq q sj) (lambda () (let ((i (dk-di-var!))) (pn! i) (ass))))
            (nt4-restrict! q j)
            (nt4-ptw q sj (lambda (z) (dk-apply! (dk-ctx-form (nt4-ptq q sj)) z)))
            (nt4-ptw q j (lambda (z) (dk-apply! (dk-ctx-form (nt4-ptq q j)) z)))
            (nt4-prod-type! q j)
            (nt4-top! j)
            (pn! sj)
            (dk-apply! (dk-cite! 'lzd-prod-succ) 'ZZ-RING j q)
            (nt4-mul! pj top)
            ;; q(succ j) divides |d|, hence d
            (dk-have! (list 'ZZ-DIVIDES top '(abs d))
              (lambda ()
                (mac 'zz-divides)
                (dk-conj-close!
                  (lambda ()
                    (if (not (dk-ass!))
                        (begin
                          (ew pj)
                          (dk-conj-close!
                            (lambda ()
                              (if (not (dk-ass!))
                                  (begin
                                    (subst (list '= '(abs d) (list 'PROD-RING 'ZZ-RING q (list 'INTERVAL 1 sj))))
                                    (subst (list '= (list 'PROD-RING 'ZZ-RING q (list 'INTERVAL 1 sj)) (list '(MUL ZZ-RING) pj top)))
                                    (subst (list '= (list '(MUL ZZ-RING) pj top) (list '* pj top)))
                                    (crs))))))))))))
            (dk-have! (list 'ZZ-DIVIDES top 'd)
              (lambda ()
                (ma-or-split! (dk-apply! (dk-cite! 'rr-abs-cases) 'd)
                  (list (lambda () (dk-split-all!) (subst '(= d (abs d))) (ass))
                        (lambda ()
                          (dk-split-all!)
                          (fact 'zz-one-in) (dk-type! '(- 1) 'ZZ)
                          (dk-apply! (dk-cite! 'zz-divides-mul-right) top '(abs d) '(- 1))
                          (dk-have! '(= (* (abs d) (- 1)) d) (lambda () (subst '(= (abs d) (- d))) (crs)))
                          (dk-rewrite-h! (list 'ZZ-DIVIDES top '(* (abs d) (- 1))) '(* (abs d) (- 1)) 'd)
                          (ass))))))
            (ew top)
            (dk-conj-close! dk-ass!))))))
(qed 'zz-prime-factor-exists)

;;; k is coprime to n /= 0 iff no prime dividing n divides k
(define (nt5-noprime k n) (list 'FORALL 'ntq_ (list 'IMPLIES '(IS-PRIME-NAT ntq_) (list 'IMPLIES (list 'ZZ-DIVIDES 'ntq_ n) (list 'NOT (list 'ZZ-DIVIDES 'ntq_ k))))))
(sp (make-wff (forall-guarded '(k n) '((IN k ZZ) (IN n ZZ) (NOT (= n 0))) (list 'IFF '(ZZ-COPRIME k n) (nt5-noprime 'k 'n)))))
(dk-peel!)
(fact 'zz-one-in) (fact 'zz-zero-in) (dk-type! '(- 1) 'ZZ)
(dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
  (lambda ()
    (let* ((xy (nt2-bez-open! 'k 'n)) (x (car xy)) (y (cadr xy)))
      (dk-peel!)
      (di)
      (let* ((p (cadr (find-first (lambda (f) (dk-head-is? f 'IS-PRIME-NAT)) (dk-asms)))))
        (dk-split-all! (list (dk-apply! (dk-cite! 'prime-nat-gt-one) p)))
        (dk-type! p 'ZZ) (fact 'nn-in-rr p)
        (nt3-lc! p 'k 'n x y 1)
        (dk-have! (list '< 0 p) (lambda () (dk-ineq! (list '< 1 p))))
        (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
        (dk-apply! (dk-cite! 'zz-divides-small) p 1)
        (ma-prop-with! (list (list 'ZZ-DIVIDES p 1) (list 'NOT (list 'ZZ-DIVIDES p 1)))))))
  (lambda ()
    (use-em '(ZZ-COPRIME k n)
      (lambda () (ass))
      (lambda ()
        (let* ((d (dk-skolem! (dk-apply! (dk-cite! 'zz-bezout) 'k 'n)))
               (x (dk-skolem! (cadr (ma-iff-parts! (dk-cite! 'zz-bezout-set-membership 'k 'n d)))))
               (y (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'y_) (dk-contains? f x))) (dk-asms))))
               (bz (list '+ (list '* x 'k) (list '* y 'n)))
               (cop! (lambda (xx yy)
                       ;; xx k + yy n = 1 in context: land the coprimality, contradiction
                       (let ((iff (dk-cite! 'zz-coprime-bezout 'k 'n)))
                         (dk-have! (caddr iff)
                           (lambda () (ew xx) (dk-conj-close! (lambda () (cond ((dk-ass!) #t) ((dk-head-is? (dk-goal) 'FORSOME) (ew yy) (dk-conj-close! dk-ass!)) (#t #f))))))
                         (ma-iff-back! iff)
                         (ma-prop-with! (list '(ZZ-COPRIME k n) '(NOT (ZZ-COPRIME k n))))))))
          (dk-project! (list 'IN d 'ZZ) 'zz-divides (list 'ZZ-DIVIDES d 'k))
          (dk-have! (list 'NOT (list '= d 1))
            (lambda () (di) (dk-have! (list '= bz 1) (lambda () (subst (list '= bz d)) (ass))) (cop! x y)))
          (dk-type! (list '- x) 'ZZ) (dk-type! (list '- y) 'ZZ)
          (dk-have! (list 'NOT (list '= d '(- 1)))
            (lambda () (di)
              (let ((b2 (list '+ (list '* (list '- x) 'k) (list '* (list '- y) 'n))))
                (dk-have! (list '= b2 1) (lambda () (dk-have! (list '= b2 (list '- bz)) (lambda () (crs))) (subst (list '= b2 (list '- bz))) (subst (list '= bz d)) (subst (list '= d '(- 1))) (crs)))
                (cop! (list '- x) (list '- y)))))
          (dk-have! (list 'NOT (list '= d 0))
            (lambda () (di)
              (let ((c (nt3-dv! d 'n)))
                (dk-have! '(= n 0) (lambda () (subst (list '= 'n (list '* d c))) (subst (list '= d 0)) (crs)))
                (ma-prop-with! (list '(= n 0) '(NOT (= n 0)))))))
          (let ((p (dk-skolem! (dk-apply! (dk-cite! 'zz-prime-factor-exists) d))))
            (dk-apply! (dk-cite! 'zz-divides-trans) p d 'k)
            (dk-apply! (dk-cite! 'zz-divides-trans) p d 'n)
            (dk-apply! (dk-ctx-form (nt5-noprime 'k 'n)) p)
            (ma-prop-with! (list (list 'ZZ-DIVIDES p 'k) (list 'NOT (list 'ZZ-DIVIDES p 'k))))))))))
(qed 'zz-coprime-iff-no-common-prime)
