;;; PROP. 1.9, uniqueness: two prime factorisations of the same number differ only by the order of the factors
(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (FORALL p (IMPLIES (FORALL nti_ (IMPLIES (IN nti_ (INTERVAL 1 k)) (IS-PRIME-NAT (p nti_))))
  (FORALL m (IMPLIES (IN m NN) (FORALL q (IMPLIES (FORALL nti_ (IMPLIES (IN nti_ (INTERVAL 1 m)) (IS-PRIME-NAT (q nti_))))
    (IMPLIES (= (PROD-RING ZZ-RING p (INTERVAL 1 k)) (PROD-RING ZZ-RING q (INTERVAL 1 m)))
      (AND (= k m) (FORSOME nts_ (AND (IN nts_ (BIJECTION (INTERVAL 1 k) (INTERVAL 1 m)))
        (FORALL nti_ (IMPLIES (IN nti_ (INTERVAL 1 k)) (= (q (nts_ nti_)) (p nti_))))))))))))))))))
(dk-peel!)
(nt4-ufd!)
(let* ((pk '(PROD-RING ZZ-RING p (INTERVAL 1 k))) (qm '(PROD-RING ZZ-RING q (INTERVAL 1 m)))
       (pn! (lambda (x n i)
              ;; i in INTERVAL(1, n): IS-PRIME-NAT (x i), its prime-element form, x i in ZZ
              (dk-apply! (dk-ctx-form (list 'FORALL 'nti_ (list 'IMPLIES (list 'IN 'nti_ (list 'INTERVAL 1 n)) (list 'IS-PRIME-NAT (list x 'nti_))))) i)
              (nt4-open! 'is-prime-nat (list (list x i)) (list 'IS-PRIME-NAT (list x i)))
              (dk-type! (list x i) 'ZZ)))
       (seq! (lambda (x n)
               (dk-have! (list 'IS-PRIME-SEQ 'ZZ-RING x n)
                 (lambda () (nt4-close! 'is-prime-seq (list 'ZZ-RING x n) (lambda () (let ((i (dk-di-var!))) (pn! x n i) (ass))))))
               (dk-have! (nt4-ptq x n) (lambda () (let ((i (dk-di-var!))) (pn! x n i) (ass))))
               (nt4-ptw x n (lambda (z) (dk-apply! (dk-ctx-form (nt4-ptq x n)) z)))
               (nt4-prod-type! x n))))
