(nt4-ufd!)
(dk-type! 'a 'ZZ) (fact 'nn-in-rr 'a)
(nt4-in-carr! 'a)
(dk-have! '(NOT (= a (ZERO ZZ-RING))) (lambda () (di) (dk-rewrite-h! '(= a (ZERO ZZ-RING)) '(ZERO ZZ-RING) 0) (dk-have! '(< 0 0) (lambda () (dk-ineq! '(= a 0) '(<= 1 a)))) (ap-absurd!)))
