               (lambda ()
                 (if (not (dk-ass!))
                     (let* ((i (dk-di-var!)) (si (list sg i)))
                       (dk-apply! (dk-ctx-form (list 'FORALL 'gui_ (list 'IMPLIES '(IN gui_ (INTERVAL 1 k)) (list 'ASSOCIATED 'ZZ-RING '(p gui_) (list 'q (list sg 'gui_)))))) i)
