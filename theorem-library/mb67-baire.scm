;;; mb67-baire.scm -- construction of measures, chapter 5: the Baire space N^N as a Polish metric space, and the
;;; necessity half of Proposition 5.14 (M-B67, 2026-10-26).  Vocabulary: mb67-vocab.scm (BAIRE-MS,
;;; SND-ITER, BAIRE-CODE) over scratchpad/mb12 (ULTRA-SEQ-MS and its laws, M-B1B2).  Library: measure.
;;; Helper prefixes mr- (copied from mb35-souslin.scm) and mbz-.
;;;
;;; Load window: after mb67-vocab, scratchpad/mb12/mb12-ultra (prefix-dist-*, prefix-prod-*, ultra-seq-*),
;;; mb4-vocab (IS-POLISH), mb35-souslin (souslin-baire-image, prefix-eq-*), riesz-markov-model (rmm-nn-choice),
;;; nn-pairing.
(define (mr-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (mr-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (mr-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
(define (mr-iff-parts! iff)
  ;; the conjunct equal to the focus GOAL (if any) is projected LAST: proving it closes the leaf, and a
  ;; projection after that would fire on a sibling (focus drift)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc)))))
         (goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
         (opener (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
         (rest (filter (lambda (c) (not (goal? c))) cs))
         (last (filter goal? cs)))
    (append (mr-map (lambda (c) (mr-project! c opener)) rest)
            (mr-map (lambda (c) (mr-project! c opener)) last))))
(define (mr-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (mr-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))
(define (mr-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
(define (mr-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
(define (mr-ne! a b lt)
  (dk-have! (list 'NOT (list '= a b))
    (lambda ()
      (di)
      (dk-have! '(< 0 0) (lambda () (dk-ineq! lt (list '= a b))))
      (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
      (ai (dk-cite! 'rr-lt-irrefl 0)))))
(define (mr-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s0 (caddr m)) (v (cadr s0)) (dom (caddr s0))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s0)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "mr-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (ai (dk-ctx-form conj))))
    p))
(define (mr-and-close! closer)
  (if (dk-head-is? (dk-goal) 'AND)
      (for-each (lambda (k) (dk-focus! k) (mr-and-close! closer)) (dk-opened (lambda () (di))))
      (closer)))
(define (mr-find tag pred lst)
  (or (find-first pred lst) (error "mr-find: nothing matches at" tag (map expression->string lst))))
(define (mr-real! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)) (list 'IN t 'RR))
(define (mr-pos! e) (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))
(define (mr-recip! k)              ; recip(k + 1), k in NN: typed, positive (idempotent)
  (let* ((k1 (list '+ k 1)) (rq (list 'RECIP k1)))
   (if (dk-asm? (list 'POS-RR rq))
    rq
    (begin
    (dk-cite! 'nn-in-rr k) (dk-type! k1 'RR)
    (dk-have! (list '< 0 k1) (lambda () (dk-cite! 'nn-zero-le k) (dk-ineq! (list '<= 0 k))))
    (mr-ne! k1 0 (list '< 0 k1))
    (mr-chain! (dk-fact! 'rr-recip-closed k1))
    (dk-cite! 'rr-recip-pos k1)
    (dk-cite! 'rr-pos-rr-of-lt rq)
    rq))))
(define (mr-sep-open! sp0)           ; IS-SEPARABLE(sp0) in context: is-metric-space and a dense sequence, returned
  (let* ((iff (dk-cite! 'is-separable sp0)) (rhs (caddr iff)) (ex (caddr rhs)))
    (dk-project! (list 'IS-METRIC-SPACE sp0) (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (dk-project! ex (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (let ((d (dk-skolem! ex))) (dk-split-all!) d)))
(define (mr-dense ds sp0) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'PTS sp0)) (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
  (list 'FORSOME 'n (list 'AND '(IN n NN) (list '< (list (list 'DIST sp0) 'x (list ds 'n)) 'eps))))))))
(define (mr-iff-back! iff)           ; the right side of an IFF in context (proved by the caller): land the left side
  (ai iff)
  (detach! (list 'IMPLIES (caddr iff) (cadr iff))))

;;; ======================================================================
;;; the weight 2 and the prefix product 2^n
;;; ======================================================================
(define mbz-F '(FUN NN NN))
(define mbz-W '(VNB-LAMBDA bwk_ NN 2))
(define mbz-wt (list 'FORALL 'w (list 'IMPLIES '(IN w NN) (list '< 1 (list mbz-W 'w)))))
(define mbz-wv (list 'FORALL 'w (list 'IMPLIES '(IN w NN) (list '= (list mbz-W 'w) 2))))
(define (mbz-P y n) (list 'PREFIX-PROD mbz-W y n))
(define (mbz-D x y) (list 'PREFIX-DIST mbz-W x y))
(define (mbz-dd x y) (list (list 'DIST 'BAIRE-MS) x y))

;; recip is strictly antitone on the positive reals
(sp (make-wff '(FORALL u (IMPLIES (IN u RR) (FORALL v (IMPLIES (IN v RR) (IMPLIES (< 0 u) (IMPLIES (< u v)
   (< (recip v) (recip u))))))))))
(dk-peel!)
(dk-have! '(< 0 v) (lambda () (dk-ineq! '(< 0 u) '(< u v))))
(mr-ne! 'u 0 '(< 0 u))
(mr-ne! 'v 0 '(< 0 v))
(mr-chain! (dk-fact! 'rr-recip-closed 'u))
(mr-chain! (dk-fact! 'rr-recip-closed 'v))
(dk-have! '(<= u v) (lambda () (dk-ineq! '(< u v))))
(mr-chain! (dk-cite! 'rr-recip-antitone 'u 'v))
(dk-cite! 'rr-recip-pos 'u) (dk-cite! 'rr-recip-pos 'v)
(mr-ne! '(recip u) 0 '(< 0 (recip u)))
(mr-ne! '(recip v) 0 '(< 0 (recip v)))
(mr-chain! (dk-fact! 'rr-recip-closed '(recip u)))
(mr-chain! (dk-fact! 'rr-recip-closed '(recip v)))
(dk-have! '(NOT (= (recip v) (recip u)))
  (lambda ()
    (di)
    (dk-congr! '(= (recip v) (recip u)) (lambda (t) (list 'recip t)))
    (dk-cite! 'rr-recip-recip-pos 'u)
    (dk-cite! 'rr-recip-recip-pos 'v)
    (dk-absurd! '(= (recip (recip v)) (recip (recip u))) '(= (recip (recip u)) u) '(= (recip (recip v)) v) '(< u v)
                '(IN u RR) '(IN v RR))))
(mr-chain! (dk-fact! 'rr-le-ne-lt '(recip v) '(recip u)))
(mr-close-open!)
(qed 'baire-recip-lt)
(topic! 'baire-recip-lt 'analysis)

(sp (make-wff (list 'AND (list 'IN mbz-W '(FUN NN RR)) mbz-wv)))
(dk-cite! 'nn-is-set)
(dk-type! 2 'RR)
(mr-and-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IN)
        (for-each (lambda (kn)
                    (if (not (sequent-node-grounded? kn))
                        (begin (dk-focus! kn)
                               (if (dk-asm? (dk-goal)) (ass) (begin (dk-peel!) (mr-close-open!))))))
                  (dk-opened (lambda () (lam-t))))
        (begin (dk-peel!) (dk-lam-b!) (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (rfl)))))))
(qed 'baire-wt-facts)
(topic! 'baire-wt-facts 'analysis)

(sp (make-wff mbz-wt))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'baire-wt-facts)))
(dk-apply! mbz-wv 'w)
(subst (list '= (list mbz-W 'w) 2))
(dk-ineq!)
(qed 'baire-wt-gt-one)
(topic! 'baire-wt-gt-one 'analysis)

(define (mbz-setup!)
  (if (not (dk-asm? (list 'IN mbz-W '(FUN NN RR)))) (dk-split-all! (list (dk-cite! 'baire-wt-facts))))
  (if (not (dk-asm? mbz-wt)) (dk-cite! 'baire-wt-gt-one))
  (dk-cite! 'nn-is-set))
(define (mbz-wt2! v)                  ; v in NN in context: BAIRE-WT(v) = 2
  (mbz-setup!)
  (dk-cite! 'baire-wt-facts)
  (dk-apply! mbz-wv v))

;; P(y, n) = 2^n: real, at least n + 1, independent of y
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y mbz-F)
  (list 'FORALL 'y2 (list 'IMPLIES (list 'IN 'y2 mbz-F)
    (list 'AND (list 'IN (mbz-P 'y 'n) 'RR) (list 'AND (list '<= '(+ n 1) (mbz-P 'y 'n)) (list '= (mbz-P 'y 'n) (mbz-P 'y2 'n))))))))))))
(define mbz-br (use-induction))
(dk-focus! (cdr (assq 'base mbz-br)))
(dk-peel!)
(mac 'prefix-prod-zero)
(fact 'rr-one-in)
(mr-and-close! (lambda () (cond ((dk-asm? (dk-goal)) (ass)) ((dk-head-is? (dk-goal) '<=) (dk-ineq!)) (#t (rfl)))))
(dk-focus! (cdr (assq 'step mbz-br)))
(let* ((k (cdr (assq 'var mbz-br)))
       (ih (cdr (assq 'ih mbz-br)))
       (lk (dk-peel!))
       (ys (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) mbz-F))) lk)))
       (y (car ys)) (y2 (cadr ys)))
  (dk-split-all! (list (dk-apply! ih y y2)))
  (dk-split-all! (list (dk-apply! ih y2 y)))
  (for-each (lambda (yy)
              (dk-cite! 'fun-apply-type-c yy 'NN 'NN k)
              (mbz-wt2! (list yy k))
              (fact 'prefix-prod-succ mbz-W yy k)
              (subst (list '== (mbz-P yy (list 'succ k)) (list '* (mbz-P yy k) (list mbz-W (list yy k)))))
              (subst (list '= (list mbz-W (list yy k)) 2)))
            (list y y2))
  (let ((P (mbz-P y k)) (P2 (mbz-P y2 k)))
    (dk-type! 2 'RR)
    (dk-type! (list '* P 2) 'RR)
    (dk-type! (list '* P2 2) 'RR)
    (dk-cite! 'nn-succ-closed k)
    (dk-cite! 'nn-succ-plus-one k)
    (dk-cite! 'nn-in-rr k) (dk-cite! 'nn-in-rr (list 'succ k)) (dk-cite! 'nn-zero-le k)
    (mr-and-close!
      (lambda ()
        (cond ((dk-asm? (dk-goal)) (ass))
              ((dk-head-is? (dk-goal) '<=)
               (dk-ineq! (list '= (list 'succ k) (list '+ k 1)) (list '<= (list '+ k 1) P) (list '<= 0 k)
                         (list 'IN k 'RR) (list 'IN (list 'succ k) 'RR) (list 'IN P 'RR)))
              (#t (subst (list '= P P2)) (rfl)))))))
(qed 'baire-prod-facts)
(topic! 'baire-prod-facts 'analysis)

(define (mbz-P! y n)                  ; y in N^N, n in NN in context: P(y, n) and recip P(y, n) typed and positive
  (let* ((P (mbz-P y n)) (rP (list 'recip P)))
    (if (not (dk-asm? (list '< 0 rP)))
        (begin
          (if (not (dk-asm? (list '<= (list '+ n 1) P))) (dk-split-all! (list (dk-cite! 'baire-prod-facts n y y))))
          (dk-cite! 'nn-in-rr n) (dk-cite! 'nn-zero-le n)
          (dk-have! (list '< 0 P) (lambda () (dk-ineq! (list '<= (list '+ n 1) P) (list '<= 0 n) (list 'IN n 'RR) (list 'IN P 'RR))))
          (mr-ne! P 0 (list '< 0 P))
          (mr-chain! (dk-fact! 'rr-recip-closed P))
          (dk-cite! 'rr-recip-pos P)))
    rP))

;; P(y, n + 1) = 2 P(y, n)
(sp (make-wff (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y mbz-F) (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
  (list '= (mbz-P 'y '(succ n)) (list '* (mbz-P 'y 'n) 2))))))))
(dk-peel!)
(dk-cite! 'fun-apply-type-c 'y 'NN 'NN 'n)
(mbz-wt2! '(y n))
(mbz-P! 'y 'n)
(fact 'prefix-prod-succ mbz-W 'y 'n)
(subst (list '== (mbz-P 'y '(succ n)) (list '* (mbz-P 'y 'n) (list mbz-W '(y n)))))
(subst (list '= (list mbz-W '(y n)) 2))
(dk-type! 2 'RR)
(rfl)
(qed 'baire-prod-succ)
(topic! 'baire-prod-succ 'analysis)

;;; ======================================================================
;;; BAIRE-MS: a metric space on FUN(NN, NN)
;;; ======================================================================
(sp (make-wff '(IS-METRIC-SPACE BAIRE-MS)))
(mbz-setup!)
(mr-chain! (dk-cite! 'ultra-seq-is-metric-space 'NN mbz-W))
(subst (dk-cite! 'baire-ms-def))
(mr-close-open!)
(qed 'baire-ms-is-metric-space)
(topic! 'baire-ms-is-metric-space 'analysis)

(sp (make-wff '(== (PTS BAIRE-MS) (FUN NN NN))))
(mbz-setup!)
(mr-chain! (dk-cite! 'ultra-seq-pts 'NN mbz-W))
(subst (dk-cite! 'baire-ms-def))
(mr-close-open!)
(qed 'baire-ms-pts)
(topic! 'baire-ms-pts 'analysis)

(sp (make-wff (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x mbz-F) (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y mbz-F)
  (list 'AND (list '= (mbz-dd 'x 'y) (mbz-D 'x 'y)) (list 'AND (list 'IN (mbz-D 'x 'y) 'RR) (list '<= 0 (mbz-D 'x 'y))))))))))
(dk-peel!)
(mbz-setup!)
(dk-split-all! (list (mr-chain! (dk-cite! 'prefix-dist-nonneg 'NN mbz-W 'x 'y))))
(mr-chain! (dk-cite! 'ultra-seq-dist-apply 'NN mbz-W 'x 'y))
(subst (dk-cite! 'baire-ms-def))
(mr-and-close! (lambda () (ass)))
(qed 'baire-ms-dist)
(topic! 'baire-ms-dist 'analysis)

(define (mbz-dist! x y)               ; x, y in N^N: d(x, y) = D(x, y), both typed, >= 0
  (let ((dd (mbz-dd x y)))
    (if (not (dk-asm? (list 'IN dd 'RR)))
        (begin
          (dk-split-all! (list (dk-cite! 'baire-ms-dist x y)))
          (dk-have! (list 'IN dd 'RR) (lambda () (subst (list '= dd (mbz-D x y))) (ass)))
          (dk-have! (list '<= 0 dd) (lambda () (subst (list '= dd (mbz-D x y))) (ass)))))
    dd))

;; agreement below n puts y within 1/(n+1) of x
(define (mbz-agree n x y) (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'IMPLIES (list '< 'j n) (list '= (list x 'j) (list y 'j))))))
(sp (make-wff (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x mbz-F) (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y mbz-F)
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES (mbz-agree 'n 'x 'y)
    (list '<= (mbz-dd 'x 'y) '(recip (+ n 1))))))))))))
(dk-peel!)
(mbz-setup!)
(let* ((dd (mbz-dist! 'x 'y))
       (rP (mbz-P! 'y 'n))
       (P (cadr rP))
       (r1 (mr-recip! 'n)))
  (mr-chain! (dk-cite! 'prefix-dist-small 'NN mbz-W 'x 'y 'n))
  (dk-have! '(< 0 (+ n 1)) (lambda () (dk-ineq! '(<= 0 n) '(IN n RR))))
  (dk-type! '(+ n 1) 'RR)
  (mr-chain! (dk-cite! 'rr-recip-antitone '(+ n 1) P))
  (dk-ineq! (list '= dd (mbz-D 'x 'y)) (list '<= (mbz-D 'x 'y) rP) (list '<= rP '(recip (+ n 1)))
            (list 'IN dd 'RR) (list 'IN (mbz-D 'x 'y) 'RR) (list 'IN rP 'RR) (list 'IN '(recip (+ n 1)) 'RR)))
(qed 'baire-dist-agree-small)
(topic! 'baire-dist-agree-small 'analysis)

;; d(x, y) < 1/P(c, n) forces agreement up to n
(sp (make-wff (list 'FORALL 'c (list 'IMPLIES (list 'IN 'c mbz-F) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x mbz-F)
  (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y mbz-F) (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
    (list 'IMPLIES (list '< (mbz-dd 'x 'y) (list 'recip (mbz-P 'c 'n)))
      '(FORALL j (IMPLIES (IN j NN) (IMPLIES (<= j n) (= (x j) (y j))))))))))))))))
(dk-peel!)
(mbz-setup!)
(pbc)
(let* ((dd (mbz-dist! 'x 'y))
       (rcn (mbz-P! 'c 'n)) (rcj (mbz-P! 'c 'j)) (ryj (mbz-P! 'y 'j))
       (Pcn (cadr rcn)) (Pcj (cadr rcj)) (Pyj (cadr ryj)))
  (mr-chain! (dk-cite! 'prefix-dist-large 'NN mbz-W 'x 'y 'j))
  (dk-split-all! (list (dk-cite! 'baire-prod-facts 'j 'y 'c)))
  (mr-chain! (dk-cite! 'prefix-prod-mono 'NN mbz-W 'c 'j 'n))
  (mr-chain! (dk-cite! 'rr-recip-antitone Pcj Pcn))
  (dk-congr! (list '= Pyj Pcj) (lambda (t) (list 'recip t)))
  (dk-absurd! (list '< dd rcn) (list '= dd (mbz-D 'x 'y)) (list '<= ryj (mbz-D 'x 'y)) (list '= ryj rcj) (list '<= rcn rcj)
              (list 'IN dd 'RR) (list 'IN (mbz-D 'x 'y) 'RR) (list 'IN rcn 'RR) (list 'IN rcj 'RR) (list 'IN ryj 'RR)))
(qed 'baire-close-agree)
(topic! 'baire-close-agree 'analysis)

;; the radius 1/P(c, n+1): positive and below 1/P(c, n)
(sp (make-wff (list 'FORALL 'c (list 'IMPLIES (list 'IN 'c mbz-F) (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
  (list 'AND (list 'POS-RR (list 'recip (mbz-P 'c '(succ n)))) (list '< (list 'recip (mbz-P 'c '(succ n))) (list 'recip (mbz-P 'c 'n))))))))))
(dk-peel!)
(dk-cite! 'nn-succ-closed 'n)
(let* ((r1 (mbz-P! 'c '(succ n))) (r0 (mbz-P! 'c 'n)) (P1 (cadr r1)) (P0 (cadr r0)))
  (dk-cite! 'baire-prod-succ 'c 'n)
  (dk-type! 2 'RR)
  (dk-have! (list '< P0 P1) (lambda () (dk-ineq! (list '= P1 (list '* P0 2)) (list '< 0 P0) (list 'IN P0 'RR) (list 'IN P1 'RR))))
  (dk-have! (list '< 0 P0) (lambda () (ass)))
  (mr-chain! (dk-cite! 'baire-recip-lt P0 P1))
  (dk-cite! 'rr-pos-rr-of-lt r1)
  (mr-and-close! (lambda () (ass))))
(qed 'baire-delta)
(topic! 'baire-delta 'analysis)

(define (mbz-delta! c n)              ; c in N^N, n in NN: delta = 1/P(c, n+1), POS-RR, typed, below 1/P(c, n)
  (let ((r1 (list 'recip (mbz-P c (list 'succ n)))))
    (if (not (dk-asm? (list 'POS-RR r1)))
        (begin (dk-cite! 'nn-succ-closed n)
               (mbz-P! c (list 'succ n)) (mbz-P! c n)
               (dk-split-all! (list (dk-cite! 'baire-delta c n)))))
    r1))

;; (418) for the weight 2: the prefix products are unbounded
(define mbz-div (list 'FORALL 'dvz_ (list 'IMPLIES '(IN dvz_ (FUN NN NN)) (list 'FORALL 'dvm_ (list 'IMPLIES '(IN dvm_ RR)
                 (list 'FORSOME 'dvn_ (list 'AND '(IN dvn_ NN) (list '< 'dvm_ (list 'PREFIX-PROD mbz-W 'dvz_ 'dvn_)))))))))
(sp (make-wff mbz-div))
(let* ((lk (dk-peel!))
       (z (cadr (mr-find 'div-z (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) mbz-F))) lk)))
       (m (cadr (mr-find 'div-m (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) lk))))
  (fact 'rr-one-in)
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (dk-cite! 'rr-pos-rr-of-lt 1)
  (let* ((nv (dk-skolem! (dk-cite! 'rr-archimedean-multiple 1 m))))
    (dk-split-all!)
    (let ((rP (mbz-P! z nv)))
