;;; l2b-e.scm -- th-main 3.40 (i)-(ii) FOR A REAL KERNEL: T_k xi IS IN L^2 AND
;;; ||T_k xi||^2 <= ||k||^2 ||xi||^2 (TH3-L2B, 2026-11-09).  Helper prefix: tle-.
;;;
;;; LOAD WINDOW: after l2b-d.  Library: measure.  No new vocabulary.

(define (tle-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** l2b-e: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "l2b-e: unfinished" name))))

(define (tle-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (tle-open?) (not (proof-done? *ps*)))
(define (tle-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
(define (tle-lb!) (let loop () (if (dk--redex? (dk-goal)) (begin (dk-lam-b!) (loop)))))
(define (tle-parts! pred args)
  (let* ((iff (apply dk-cite! (cons pred args)))
         (cs (let loop ((r (caddr iff)) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (tle-map (lambda (c) (if (dk-asm? c) c
                             (dk-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))))
             cs)))
;;; land the right-hand side of a predicate's defining iff (hypothesis kept)
(define (tle-unfold! pred args)
  (let ((iff (apply dk-cite! (cons pred args))))
    (dk-project! (caddr iff) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff)))))))
(define (tle-ptwise var dom body) (list 'FORALL var (list 'IMPLIES (list 'IN var dom) body)))
(define (tle-off var dom nset body) (tle-ptwise var dom (list 'IMPLIES (list 'NOT (list 'IN var nset)) body)))
(define (tle-sq f om) (list 'VNB-LAMBDA 'lx_ om (list '* (list f 'lx_) (list f 'lx_))))

;;; ==========================================================================================
;;; (1) A POINTWISE BOUND OFF A NULL SET GIVES L^2 AND THE INTEGRAL BOUND
;;; ==========================================================================================
(define tle-gsq (tle-sq 'gg 'omega))
(define tle-h2 '(PTWISE-SCALE omega c h))
(sp (make-wff (forall-guarded '(omega cA mu gg h c nb)
   (list '(IS-MEASURE omega cA mu) '(IS-REAL-MEASURABLE-FN omega cA gg) '(IS-MEASURABLE-FN omega cA h)
         '(IN c RR) '(<= 0 c) '(IN (INTEGRAL omega cA mu h) RR) '(IN nb cA) '(= (mu nb) 0)
         (tle-off 'x 'omega 'nb '(AND (<= (* (gg x) (gg x)) (* (h x) c)) (IN (h x) RR))))
   (list 'AND '(IN gg (L2-SET omega cA mu))
         (list '<= (list 'INTEGRAL 'omega 'cA 'mu tle-gsq) '(* (INTEGRAL omega cA mu h) c))))))
(dk-peel!)
(tle-parts! 'is-measure '(omega cA mu))
(tle-parts! 'is-real-measurable-fn '(omega cA gg))
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(dk-cite! 'measurable-fn-in-fun 'omega 'cA 'h)
(dk-cite! 'rmc-rps-of-nonneg 'c)
(let* ((isq (list 'INTEGRAL 'omega 'cA 'mu tle-gsq))
       (ih '(INTEGRAL omega cA mu h))
       (ih2 (list 'INTEGRAL 'omega 'cA 'mu tle-h2))
       (hyp (tle-off 'x 'omega 'nb '(AND (<= (* (gg x) (gg x)) (* (h x) c)) (IN (h x) RR)))))
  (dk-have! (tle-ptwise 'x_ 'omega (list '<= 0 (list tle-gsq 'x_)))
    (lambda ()
      (let ((w (dk-di-var!)))
        (fact 'fun-apply-type-c 'gg 'omega 'RR w)
        (tle-lb!)
        (tle-then-ass! (lambda () (fact 'rr-sq-nonneg (list 'gg w)))))))
  (fact 'real-measurable-mul 'omega 'cA 'gg 'gg)
  (fact 'real-nonneg-measurable 'omega 'cA tle-gsq)
  (fact 'ptwise-scale-measurable 'omega 'cA 'h 'c)
  (dk-have! (tle-off 'x 'omega 'nb (list '<= (list tle-gsq 'x) (list tle-h2 'x)))
    (lambda ()
      (let ((w (dk-di-var!)))
        (di)
        (dk-split! (dk-apply! hyp w))
        (fact 'fun-apply-type-c 'gg 'omega 'RR w)
        (fact 'fun-apply-type-c 'h 'omega 'RR-POS-STAR w)
        (fact 'rr-pos-star-nonneg (list 'h w))
        (tle-lb!)
        (subst (dk-cite! 'ptwise-scale-value 'omega 'c 'h w))
        (subst (dk-cite! 'etimes-real-defined 'c (list 'h w)))
        (subst (dk-cite! 'bintimes-apply 'c (list 'h w)))
        (dk-have! (list '= (list '* (list 'h w) 'c) (list '* 'c (list 'h w))) (lambda () (crs)))
        (let ((b (find-first (lambda (q) (and (dk-head-is? q '<=) (dk-contains? q 'gg) (dk-contains? q w))) (dk-asms))))
          (dk-rewrite-h! b (list '* (list 'h w) 'c) (list '* 'c (list 'h w))))
        (if (tle-open?) (ass)))))
  (fact 'integral-le-off-null 'omega 'cA 'mu 'nb tle-gsq tle-h2)
  (fact 'integral-homogeneous 'omega 'cA 'mu 'h 'c)
  (fact 'integral-in 'omega 'cA 'mu 'h)
  (fact 'rr-pos-star-nonneg ih)
  (dk-cite! 'etimes-real-defined 'c ih)
  (dk-cite! 'bintimes-apply 'c ih)
  (fact 'rr-mul-in-rr 'c ih)
  (dk-have! (list '<= isq (list '* 'c ih))
    (lambda ()
      (subst (list '= (list '* 'c ih) (list 'bintimes 'c ih)))
      (subst (list '= (list 'bintimes 'c ih) (list 'etimes 'c ih)))
      (subst (list '= (list 'etimes 'c ih) ih2))
      (ass)))
  (fact 'integral-in 'omega 'cA 'mu tle-gsq)
  (fact 'rps-below-real-is-real isq (list '* 'c ih))
  (fact 'l2-in-of-square-integral 'omega 'cA 'mu 'gg)
  (dk-have! (list '= (list '* 'c ih) (list '* ih 'c)) (lambda () (crs)))
  (dk-have! (list '<= isq (list '* ih 'c))
    (lambda () (subst (list '= (list '* ih 'c) (list '* 'c ih))) (ass)))
  (dk-conj-close! dk-ass!))
(tle-qed! 'l2-of-square-bound)

;;; ==========================================================================================
;;; (2) THE INNER INTEGRAL OF k^2 AT x IS THE SQUARED NORM OF THE SECTION
;;; ==========================================================================================
(define tle-xy '(CARTESIAN xs ys))
(define tle-ps '(PRODUCT-SIGMA xs cA ys cB))
(define tle-rho '(PRODUCT-MEASURE xs cA mu ys cB nu))
(define (tle-fxs f x) (list 'FN-X-SECTION 'ys f x))
(define (tle-xsi f) (list 'X-SECTION-INTEGRAL 'xs 'ys 'cB 'nu f))
(define tle-ksq (tle-sq 'k tle-xy))
(sp (make-wff (forall-guarded '(xs cA ys cB nu k x)
   (list '(IS-SIGMA-ALGEBRA xs cA) '(IS-MEASURE ys cB nu) (list 'IN 'k (list 'FUN tle-xy 'RR))
         (list 'IS-MEASURABLE-FN tle-xy tle-ps tle-ksq) '(IN x xs))
   (list '= (list (tle-xsi tle-ksq) 'x) (list 'INTEGRAL 'ys 'cB 'nu (tle-sq (tle-fxs 'k 'x) 'ys))))))
(dk-peel!)
(tle-parts! 'is-measure '(ys cB nu))
(fact 'sigma-algebra-ambient-set 'ys 'cB)
(let* ((sec (tle-fxs 'k 'x)) (ssq (tle-sq sec 'ys)) (fsq (tle-fxs tle-ksq 'x)))
  (fact 'fn-x-section-measurable 'xs 'cA 'ys 'cB tle-ksq 'x)
  (dk-cite! 'measurable-fn-in-fun 'ys 'cB fsq)
  (dk-cite! 'x-section-integral-apply 'xs 'ys 'cB 'nu tle-ksq 'x)
  (dk-have! (list 'IN ssq '(FUN ys RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((z (dk-di-var!)) (pr (list 'LIST 'x z)))
            (fact 'pair-in-cartesian 'xs 'ys 'x z)
            (fact 'fun-apply-type-c 'k tle-xy 'RR pr)
            (subst (dk-cite! 'fn-x-section-apply 'ys 'k 'x z))
            (fact 'rr-mul-in-rr (list 'k pr) (list 'k pr))
            (fact 'rr-sq-nonneg (list 'k pr))
            (tle-then-ass! (lambda () (dk-cite! 'rmc-rps-of-nonneg (list '* (list 'k pr) (list 'k pr)))))))
        (lambda () (ass)))))
  (dk-have! (tle-ptwise 'icx_ 'ys (list '= (list fsq 'icx_) (list ssq 'icx_)))
    (lambda ()
      (let* ((z (dk-di-var!)) (pr (list 'LIST 'x z)))
        (fact 'pair-in-cartesian 'xs 'ys 'x z)
        (fact 'fun-apply-type-c 'k tle-xy 'RR pr)
        (subst (dk-cite! 'fn-x-section-apply 'ys tle-ksq 'x z))
        (tle-lb!)
        (subst (dk-cite! 'fn-x-section-apply 'ys 'k 'x z))
        (if (tle-open?) (rfl)))))
  (fact 'measurable-fn-congruence-ptwise 'ys 'cB fsq ssq)
  (fact 'integral-congruence-ptwise 'ys 'cB 'nu fsq ssq)
  (fact 'integral-in 'ys 'cB 'nu ssq)
  (subst (list '= (list (tle-xsi tle-ksq) 'x) (list 'INTEGRAL 'ys 'cB 'nu fsq)))
  (subst (list '= (list 'INTEGRAL 'ys 'cB 'nu fsq) (list 'INTEGRAL 'ys 'cB 'nu ssq)))
  (if (tle-open?) (rfl)))
(tle-qed! 'xsi-square-section)

;;; ==========================================================================================
;;; (3) th-main 3.40 (i)-(ii), REAL KERNEL
;;; ==========================================================================================
(define (tle-g f)
  (let ((u (tle-xsi (list 'POS-PART tle-xy f))) (v (tle-xsi (list 'NEG-PART tle-xy f))))
    (list 'VNB-LAMBDA 'sgx_ 'xs
          (list '- (list 'IF (list 'IN (list u 'sgx_) 'RR) (list u 'sgx_) 0)
                   (list 'IF (list 'IN (list v 'sgx_) 'RR) (list v 'sgx_) 0)))))
(define tle-ff (list 'VNB-LAMBDA 'kpw_ tle-xy '(* (k kpw_) (xi (NTH 2 kpw_)))))
(define tle-gg (tle-g tle-ff))
(define (tle-p x) (list 'VNB-LAMBDA 'lx_ 'ys (list '* (list (tle-fxs 'k x) 'lx_) '(xi lx_))))
(define tle-xsq (tle-sq 'xi 'ys))
(define tle-kn (list 'INTEGRAL tle-xy tle-ps tle-rho tle-ksq))
(define tle-c (list 'INTEGRAL 'ys 'cB 'nu tle-xsq))

(sp (make-wff (forall-guarded '(xs cA mu ys cB nu k xi)
   (list '(IS-MEASURE xs cA mu) '(IS-MEASURE ys cB nu) '(IS-SIGMA-FINITE xs cA mu) '(IS-SIGMA-FINITE ys cB nu)
         (list 'IN 'k (list 'L2-SET tle-xy tle-ps tle-rho)) '(IN xi (L2-SET ys cB nu)))
   (list 'AND (list 'IN tle-gg '(L2-SET xs cA mu))
     (list 'AND (list '<= (list 'INTEGRAL 'xs 'cA 'mu (tle-sq tle-gg 'xs)) (list '* tle-kn tle-c))
       (list 'FORSOME 'en_
         (list 'AND '(IS-NULL-SET xs cA mu en_)
           (tle-off 'x 'xs 'en_
             (list 'AND (list 'IS-INTEGRABLE 'ys 'cB 'nu (tle-p 'x))
                        (list '= (list tle-gg 'x) (list 'RINTEGRAL 'ys 'cB 'nu (tle-p 'x))))))))))))
(dk-peel!)
(tle-parts! 'is-measure '(xs cA mu))
(tle-parts! 'is-measure '(ys cB nu))
(fact 'sigma-algebra-ambient-set 'xs 'cA)
(fact 'sigma-algebra-ambient-set 'ys 'cB)
(fact 'product-sigma-is-sigma-algebra 'xs 'cA 'ys 'cB)
(fact 'product-measure-is-measure 'xs 'cA 'mu 'ys 'cB 'nu)
(dk-have! (list 'IN tle-xy 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! dk-ass!)))
(dk-split! (dk-cite! 'l2-out tle-xy tle-ps tle-rho 'k))
(dk-split! (dk-cite! 'l2-out 'ys 'cB 'nu 'xi))
(dk-split! (dk-cite! 'l2-square-integral tle-xy tle-ps tle-rho 'k))
(dk-split! (dk-cite! 'l2-square-integral 'ys 'cB 'nu 'xi))
(fact 'rr-zero-in)
;; F(x, y) = k(x, y) xi(y) is real measurable on the product
(let* ((xp '(VNB-LAMBDA tw_ (CARTESIAN xs ys) (xi (NTH 2 tw_))))
       (fp (list 'VNB-LAMBDA 'sx_ tle-xy (list '* '(k sx_) (list xp 'sx_)))))
  (fact 'real-measurable-pullback-second 'xs 'cA 'ys 'cB 'xi)
  (fact 'real-measurable-mul tle-xy tle-ps 'k xp)
  (tle-parts! 'is-real-measurable-fn (list tle-xy tle-ps fp))
  (dk-have! (list 'IN tle-ff (list 'FUN tle-xy 'RR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((w (dk-di-var!)))
            (dk-split! (dk-cite! 'cartesian-nth w 'xs 'ys))
            (fact 'fun-apply-type-c 'k tle-xy 'RR w)
            (fact 'fun-apply-type-c 'xi 'ys 'RR (list 'NTH 2 w))
            (tle-then-ass! (lambda () (fact 'rr-mul-in-rr (list 'k w) (list 'xi (list 'NTH 2 w)))))))
        (lambda () (ass)))))
  (dk-have! (tle-ptwise 'ex_ tle-xy (list '= (list fp 'ex_) (list tle-ff 'ex_)))
    (lambda ()
      (let ((w (dk-di-var!)))
        (dk-split! (dk-cite! 'cartesian-nth w 'xs 'ys))
        (fact 'fun-apply-type-c 'k tle-xy 'RR w)
        (fact 'fun-apply-type-c 'xi 'ys 'RR (list 'NTH 2 w))
        (tle-lb!)
        (if (tle-open?) (rfl)))))
  (fact 'real-measurable-ptwise-eq tle-xy tle-ps fp tle-ff))
(let* ((sir (dk-split! (dk-cite! 'section-integral-real-measurable 'xs 'cA 'mu 'ys 'cB 'nu tle-ff)))
       (simp (find-first (lambda (q) (dk-head-is? q 'FORALL)) sir))
       (sae (dk-split! (dk-cite! 'l2-sections-ae 'xs 'cA 'mu 'ys 'cB 'nu 'k)))
       (xeq (find-first (lambda (q) (dk-head-is? q '=)) sae))
       (e1 (dk-skolem! (find-first (lambda (q) (dk-head-is? q 'FORSOME)) sae)))
       (o1 (find-first (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q e1))) (dk-asms)))
       (n1 (dk-skolem! (tle-unfold! 'is-null-set (list 'xs 'cA 'mu e1))))
       (subs (let ((iff (dk-cite! 'subset-def e1 n1)))
               (dk-have! (caddr iff) (lambda () (keep iff (list 'SUBSET e1 n1)) (prop)))
               (caddr iff)))
       (xk (tle-xsi tle-ksq))
       (fb (dk-cite! 'fubini 'xs 'cA 'mu 'ys 'cB 'nu tle-ksq)))
  ;; at a point w off e1: the section facts
  (define (at! w)
    (let* ((sk (tle-fxs 'k w)) (sf (tle-fxs tle-ff w)) (p (tle-p w)))
      (dk-apply! o1 w)
      (dk-split! (dk-cite! 'l2-out 'ys 'cB 'nu sk))
      (fact 'l2-prod-integrable 'ys 'cB 'nu sk 'xi)
      (tle-parts! 'is-integrable (list 'ys 'cB 'nu p))
      (tle-parts! 'is-real-measurable-fn (list 'ys 'cB p))
      (dk-split! (dk-cite! 'section-parts 'xs 'cA 'ys 'cB 'nu tle-ff w))
      (tle-parts! 'is-real-measurable-fn (list 'ys 'cB sf))
      (dk-have! (tle-ptwise 'ex_ 'ys (list '= (list p 'ex_) (list sf 'ex_)))
        (lambda ()
          (let* ((z (dk-di-var!)) (pr (list 'LIST w z)))
            (fact 'pair-in-cartesian 'xs 'ys w z)
            (fact 'fun-apply-type-c 'k tle-xy 'RR pr)
            (fact 'fun-apply-type-c 'xi 'ys 'RR z)
            (subst (dk-cite! 'fn-x-section-apply 'ys tle-ff w z))
            (tle-lb!)
            (let loop () (if (dk-contains? (dk-goal) 'NTH) (begin (nth-r) (loop))))
            (subst (dk-cite! 'fn-x-section-apply 'ys 'k w z))
            (if (tle-open?) (rfl)))))
      (dk-split! (dk-cite! 'integrable-ptwise-eq 'ys 'cB 'nu p sf))
      (dk-apply! simp w)
      (dk-have! (list '= (list tle-gg w) (list 'RINTEGRAL 'ys 'cB 'nu p))
        (lambda ()
          (subst (list '= (list tle-gg w) (list 'RINTEGRAL 'ys 'cB 'nu sf)))
          (subst (list '= (list 'RINTEGRAL 'ys 'cB 'nu sf) (list 'RINTEGRAL 'ys 'cB 'nu p)))
          (fact 'rintegral-in-rr 'ys 'cB 'nu p)
          (if (tle-open?) (rfl))))))
  (define (not-e1! w)
    (dk-have! (list 'NOT (list 'IN w e1))
      (lambda ()
        (di)
        (dk-apply! subs w)
        (keep (list 'NOT (list 'IN w n1)) (list 'IN w n1))
        (prop))))
  (dk-project! (list 'IS-MEASURABLE-FN 'xs 'cA xk) (lambda () (dk-split-all! (list fb))))
  (dk-have! (list 'IN (list 'INTEGRAL 'xs 'cA 'mu xk) 'RR)
    (lambda () (subst (list '= (list 'INTEGRAL 'xs 'cA 'mu xk) tle-kn)) (ass)))
  (fact 'integral-in 'ys 'cB 'nu tle-xsq)
  (fact 'rr-pos-star-nonneg tle-c)
  ;; the pointwise bound off n1
  (dk-have! (tle-off 'x 'xs n1 (list 'AND (list '<= (list '* (list tle-gg 'x) (list tle-gg 'x)) (list '* (list xk 'x) tle-c))
                                          (list 'IN (list xk 'x) 'RR)))
    (lambda ()
      (let ((w (dk-di-var!)))
        (di)
        (not-e1! w)
        (at! w)
        (let* ((sk (tle-fxs 'k w)) (p (tle-p w)) (rp (list 'RINTEGRAL 'ys 'cB 'nu p))
               (ssq (tle-sq sk 'ys)))
          (dk-split! (dk-cite! 'l2-square-integral 'ys 'cB 'nu sk))
          (dk-cite! 'xsi-square-section 'xs 'cA 'ys 'cB 'nu 'k w)
          (dk-have! (list 'IN (list xk w) 'RR)
            (lambda () (subst (list '= (list xk w) (list 'INTEGRAL 'ys 'cB 'nu ssq))) (ass)))
          (let* ((cs (dk-cite! 'l2-schwarz 'ys 'cB 'nu sk 'xi))
                 (c1 (dk-rewrite-h! cs (list 'RINTEGRAL 'ys 'cB 'nu ssq) (list 'INTEGRAL 'ys 'cB 'nu ssq)))
                 (c2 (dk-rewrite-h! c1 (list 'INTEGRAL 'ys 'cB 'nu ssq) (list xk w)))
                 (c3 (dk-rewrite-h! c2 (list 'RINTEGRAL 'ys 'cB 'nu tle-xsq) tle-c)))
            (dk-have! (list '<= (list '* (list tle-gg w) (list tle-gg w)) (list '* (list xk w) tle-c))
              (lambda () (subst (list '= (list tle-gg w) rp)) (ass)))
            (dk-conj-close! dk-ass!))))))
  (let ((lb (dk-split! (dk-cite! 'l2-of-square-bound 'xs 'cA 'mu tle-gg xk tle-c n1))))
    (dk-have! (list '<= (list 'INTEGRAL 'xs 'cA 'mu (tle-sq tle-gg 'xs)) (list '* tle-kn tle-c))
      (lambda () (subst (list '= tle-kn (list 'INTEGRAL 'xs 'cA 'mu xk))) (ass))))
  ;; the exceptional set
  (dk-have! (list 'FORSOME 'en_
              (list 'AND '(IS-NULL-SET xs cA mu en_)
                (tle-off 'x 'xs 'en_
                  (list 'AND (list 'IS-INTEGRABLE 'ys 'cB 'nu (tle-p 'x))
                             (list '= (list tle-gg 'x) (list 'RINTEGRAL 'ys 'cB 'nu (tle-p 'x)))))))
    (lambda ()
      (ew e1)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (let ((w (dk-di-var!)))
                (di)
                (at! w)
                (dk-conj-close! dk-ass!)))))))
  (dk-conj-close! dk-ass!))
(tle-qed! 'kernel-operator-l2)
(alias! 'kernel-operator-l2 "th-main 3.40 (i)-(ii), real kernel: T_k xi is defined a.e., lies in L^2 and ||T_k xi||^2 <= ||k||^2 ||xi||^2")
