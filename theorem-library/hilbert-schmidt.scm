;;; ====================================================================
;;; ||T|| <= ||T||_HS  (Prop. 3.36 / (3.15) of th-main)
;;; ====================================================================
;;; hs-vector-bound: ||T x||^2 <= ||x||^2 sum_i ||T e_i||^2, by Parseval in K,
;;; <T x, f_j> = <x, T* f_j>, Cauchy-Schwarz, and (3.10).
(sp (make-wff (tbh-stmt
  (list 'FORALL 'tbx_ (list 'IMPLIES '(IN tbx_ (VEC v))
    (list '<= (tbh-ns 'w '(t_ tbx_)) (list 'etimes (tbh-ns 'v 'tbx_) '(HS-SUM v w ix e t_))))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(fact 'hilbert-space-is-cips 'w)
(tbh-onb! 'v 'ix 'e)
(tbh-onb! 'w 'jx 'f)
(fact 'bop-fun 'v 'w 't_)
(fact 'op-adjoint-fun 'v 'w 't_)
(let* ((x (cadr (caddr (cadr (cadr (dk-goal))))))
       (y (list 't_ x))
       (nx (list 'IP-NORM 'v x))
       (c (tbh-ns 'v x))
       (g (tbh-lam-ns 'v 'jx 'f tbh-ts))
       (gq (list 'VNB-LAMBDA 'onk_ 'jx (tbh-ms (list '(IP w) y '(f onk_)))))
       (hc (list 'VNB-LAMBDA 'esz_ 'jx (list 'etimes c (list g 'esz_)))))
  (tbh-ap! 't_ '(VEC v) '(VEC w) x)
  (tbh-ns-type! 'w y)
  (tbh-ns-type! 'v x)
  (fact 'ip-norm-in-rr 'v x)
  (fact 'ip-norm-nonneg 'v x)
  (tbh-lam-ns-type! 'w 'v 'jx 'f tbh-ts)
  (dk-have! (list 'IN gq '(FUN jx RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((home (proof-state-focus *ps*)) (kv (dk-di-var!)))
            (tbh-ap! 'f 'jx '(VEC w) kv)
            (fact 'cips-ip-type 'w y (list 'f kv))
            (tbh-ms-type! (list '(IP w) y (list 'f kv)))
            (tbh-close-home! home)))
        (lambda () (ass)))))
  (dk-have! (list 'IN hc '(FUN jx RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((home (proof-state-focus *ps*)) (kv (dk-di-var!)))
            (fact 'fun-apply-type-c g 'jx 'RR-POS-STAR kv)
            (tbh-and! (list 'IN c 'RR-POS-STAR) (list 'IN (list g kv) 'RR-POS-STAR))
            (fact 'etimes-closed c (list g kv))
            (tbh-close-home! home)))
        (lambda () (ass)))))
  (let* ((ae (tbh-cite! 'hs-sum-adjoint-eq 'v 'w 't_ 'ix 'e 'jx 'f))
         (sc (begin (tbh-and! (list 'IN c 'RR) (list '<= 0 c)) (tbh-cite! 'esum-scale c 'jx g))))
    (subst (list '= '(HS-SUM v w ix e t_) (cadr ae)))
    (tbh-unfold-hs! 'w 'v 'jx 'f tbh-ts)
    (subst (dk-cite! 'ip-norm-sq 'w y))
    (let ((pv (dk-cite! 'parseval-identity 'w 'jx 'f y)))
      (subst (list '= (caddr pv) (cadr pv))))
    (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ jx) (list '<= (list gq 'z_) (list hc 'z_))))
      (lambda ()
        (let* ((kv (dk-di-var!))
               (fk (list 'f kv)) (b (list tbh-ts fk))
               (nb (list 'IP-NORM 'v b)) (nsb (tbh-ns 'v b))
               (z (list '(IP v) x b)) (m (list 'MAGNITUDE z)) (p (list '* nx nb)))
          (tbh-ap! 'f 'jx '(VEC w) kv)
          (tbh-ap! tbh-ts '(VEC w) '(VEC v) fk)
          (fact 'cips-ip-type 'w y fk)
          (fact 'cips-ip-type 'v x b)
          (tbh-ms-type! (list '(IP w) y fk))
          (tbh-ms-type! z)
          (tbh-ns-type! 'v b)
          (fact 'ip-norm-in-rr 'v b)
          (fact 'ip-norm-nonneg 'v b)
          (fact 'cc-magnitude-nonneg z)
          (dk-lam-b!)
          (let* ((er (begin (tbh-and! (list 'IN nsb 'RR) (list '<= 0 nsb))
                            (tbh-cite! 'etimes-real-defined c nsb)))
                 (bt (dk-cite! 'bintimes-apply c nsb))
                 (adj (dk-cite! 'op-adjoint-ip 'v 'w 't_ x fk)))
            (subst er)
            (subst bt)
            (subst adj)
            (let ((cs (tbh-cite! 'cips-ip-magnitude-le 'v x b)))
              (tbh-and! (list 'IN nx 'RR) (list 'IN nb 'RR))
              (fact 'rr-mul-closed nx nb)
              (fact 'rr-square-mono m p)
              (let ((ide (list '= (list '* p p) (list '* c nsb))))
                (dk-have! ide (lambda () (crs)))
                (dk-rewrite-h! (list '<= (list '* m m) (list '* p p)) (list '* p p) (list '* c nsb))
                (if (tbh-open?) (ass))))))))
    (tbh-cite! 'esum-le-ptwise 'jx gq hc)
    (dk-rewrite-h! (list '<= (list 'ESUM gq) (list 'ESUM hc)) (list 'ESUM hc) (caddr sc))
    (if (tbh-open?) (ass))))
(qed 'hs-vector-bound)
(topic! 'hs-vector-bound 'analysis)

;;; detach a chain of implications whose antecedents are in context or provable by detach!
(define (tbh-chain! r)
  (let loop ((r r))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (if (dk-asm? (caddr r))
            (loop (caddr r))
            (loop (dk-landed-1 (lambda () (detach! r)))))
        r)))

;;; hs-opnorm-le (th-main (3.15)): ||T|| <= ||T||_HS for a Hilbert-Schmidt T
(sp (make-wff (list 'FORALL 'v (list 'FORALL 'w (list 'IMPLIES '(IS-HILBERT-SPACE v) (list 'IMPLIES '(IS-HILBERT-SPACE w)
  (list 'FORALL 't_ (list 'IMPLIES '(IS-HILBERT-SCHMIDT v w t_)
    '(<= (OPNORM v w t_) (HS-NORM v w t_))))))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(fact 'hilbert-space-is-cips 'w)
(dk-have! '(IN t_ (BOUNDED-OPS v w)) (lambda () (dk-project! '(IN t_ (BOUNDED-OPS v w)) 'IS-HILBERT-SCHMIDT '(IS-HILBERT-SCHMIDT v w t_))))
(fact 'bop-fun 'v 'w 't_)
(let* ((ie (tbh-open-hs! 'v 'w 't_)) (i0 (car ie)) (e0 (cdr ie))
       (jf (tbh-some-onb! 'w)) (jx (car jf)) (f (cdr jf))
       (h (tbh-hs 'v 'w i0 e0 't_))
       (s (list 'SQRT h))
       (opn '(OPNORM v w t_)))
  (tbh-onb! 'v i0 e0)
  (fact 'hs-sum-in-rps 'v 'w 't_ i0 e0)
  (fact 'rr-pos-star-nonneg h)
  (tbh-and! (list 'IN h 'RR) (list '<= 0 h))
  (let ((sp0 (tbh-cite! 'sqrt-prop h)))
    (dk-split-all! (list sp0)))
  (subst (tbh-cite! 'hs-norm-any-basis 'v 'w 't_ i0 e0))
  (let ((ub (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC v))
              (list '<= '(IP-NORM w (t_ x_)) (list '* s '(IP-NORM v x_)))))))
    (dk-have! ub
      (lambda ()
        (let* ((xv (dk-di-var!))
               (y (list 't_ xv)) (a (list 'IP-NORM 'w y)) (nx (list 'IP-NORM 'v xv))
               (b (list '* s nx)) (nsx (tbh-ns 'v xv)))
          (tbh-ap! 't_ '(VEC v) '(VEC w) xv)
          (fact 'ip-norm-in-rr 'w y)
          (fact 'ip-norm-nonneg 'w y)
          (fact 'ip-norm-in-rr 'v xv)
          (fact 'ip-norm-nonneg 'v xv)
          (tbh-ns-type! 'v xv)
          (fact 'rr-pos-star-nonneg nsx)
          (tbh-and! (list 'IN s 'RR) (list 'IN nx 'RR))
          (fact 'rr-mul-closed s nx)
          (tbh-and! (list '<= 0 s) (list '<= 0 nx))
          (dk-cite! 'rr-leq-mul-nonneg s nx)
          (let* ((vb (tbh-cite! 'hs-vector-bound 'v 'w 't_ i0 e0 jx f xv))
                 (er (begin (tbh-and! (list 'IN nsx 'RR) (list '<= 0 nsx) (list 'IN h 'RR) (list '<= 0 h))
                            (tbh-cite! 'etimes-real-defined nsx h)))
                 (bt (dk-cite! 'bintimes-apply nsx h))
                 (v1 (dk-rewrite-h! vb (cadr er) (caddr er)))
                 (v2 (dk-rewrite-h! v1 (cadr bt) (caddr bt)))
                 (ide (list '= (list '* b b) (list '* nsx (list '* s s)))))
            (dk-have! ide (lambda () (crs)))
            (let ((ide2 (dk-rewrite-h! ide (list '* s s) h)))
              (dk-have! (list '<= (list '* a a) (list '* b b))
                (lambda () (subst ide2) (if (tbh-open?) (ass))))
              (tbh-cite! 'rr-square-le-imp-le a b)
              (if (tbh-open?) (ass)))))))
    (let* ((os (tbh-cite! 'opnorm-spec 'v 'w 't_)))
      (dk-split-all! (list os))
      (let ((least (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (eq? (cadr q) 'd_))) "the least-bound clause")))
        (dk-apply! least s)
        (if (not (dk-asm? (list '<= opn s)))
            (let ((inst (dk-pick (lambda (q) (and (dk-head-is? q 'IMPLIES) (dk-contains? q opn)
                                                  (dk-contains? q s) (not (memq 'd_ (free-vars q)))))
                                 "the instance")))
              (tbh-chain! inst)))
        (if (tbh-open?) (ass))))))
(qed 'hs-opnorm-le)
(topic! 'hs-opnorm-le 'analysis)

;;; ====================================================================
;;; TRACE CLASS: the trace series converges absolutely in every basis (Prop. 3.45 / Def. 3.46)
;;; ====================================================================
;;; lam in FUN(ix, RPS) in context: ESUM lam in RPS
(define (tbh-esum-in! lam ix)
  (if (not (dk-asm? (list 'IN (list 'ESUM lam) 'RR-POS-STAR)))
      (begin
        (if (not (dk-asm? (list 'IN ix 'SET))) (fact 'fun-domain-in-set ix 'RR-POS-STAR lam))
        (dk-project! (list 'IN lam (list 'FUN ix)) 'fun-codomain-iff (list 'IN lam (list 'FUN ix 'RR-POS-STAR)))
        (tbh-and! (list 'IN lam (list 'FUN ix)) (list 'IN ix 'SET))
        (fact 'dom-of-fun ix lam)
        (let ((dd2 (dk-ctx-form (list 'AND (list 'IN (list 'DOM lam) 'SET) (list '= (list 'DOM lam) ix)))))
          (if dd2 (dk-split-all! (list dd2))))
        (dk-have! (list 'IN lam (list 'FUN (list 'DOM lam) 'RR-POS-STAR))
          (lambda () (subst (list '= (list 'DOM lam) ix)) (ass)))
        (fact 'esum-in lam))))
;;; trace-abs-summable: T = A B with A, B Hilbert-Schmidt, {e_i} any orthonormal basis:
;;;   sum_i |<T e_i, e_i>| < +inf.
;;; |<A B e, e>| = |<B e, A* e>| <= ||B e|| ||A* e|| <= ||B e||^2 + ||A* e||^2, and both sums
;;; are finite (hs-sum-real-any-basis, hs-adjoint); esum-subadditive.
(define (tbh-trm t ix e) (list 'VNB-LAMBDA 'kqk_ ix (list 'MAGNITUDE (list '(IP v) (list t (list e 'kqk_)) (list e 'kqk_)))))
(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-HILBERT-SPACE v)
  (list 'FORALL 't_ (list 'IMPLIES '(IS-TRACE-CLASS v t_)
    (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES '(IS-ORTHONORMAL-BASIS v ix e)
      (list 'IN (list 'ESUM (tbh-trm 't_ 'ix 'e)) 'RR))))))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tbh-onb! 'v 'ix 'e)
(let* ((tc '(IS-TRACE-CLASS v t_))
       (opened (dk-landed-1 (lambda () (mac-h 'IS-TRACE-CLASS tc)))))
  (dk-split-all! (list opened)))
(let* ((ex (dk-pick (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q 'BOP-COMP))) "the factor A"))
       (a (dk-skolem! ex))
       (ex2 (dk-pick (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q 'BOP-COMP) (memq a (free-vars q)))) "the factor B"))
       (b (dk-skolem! ex2))
       (as (list 'OP-ADJOINT 'v 'v a))
       (comp (list 'BOP-COMP 'v a b))
       (hm (tbh-trm 't_ 'ix 'e))
       (f1 (tbh-lam-ns 'v 'ix 'e b))
       (f2 (tbh-lam-ns 'v 'ix 'e as)))
  (dk-split-all!)
  (for-each (lambda (x)
              (let ((bx (list 'IN x '(BOUNDED-OPS v v))))
                (if (not (dk-asm? bx))
                    (dk-have! bx (lambda () (dk-project! bx 'IS-HILBERT-SCHMIDT (list 'IS-HILBERT-SCHMIDT 'v 'v x)))))))
            (list a b))
  (fact 'op-adjoint-bounded 'v 'v a)
  (fact 'hs-adjoint 'v 'v a)
  (fact 'bop-fun 'v 'v a)
  (fact 'bop-fun 'v 'v b)
  (fact 'bop-fun 'v 'v as)
  (fact 'bop-fun 'v 'v 't_)
  (fact 'hs-sum-real-any-basis 'v 'v b 'ix 'e)
  (fact 'hs-sum-real-any-basis 'v 'v as 'ix 'e)
  (tbh-lam-ns-type! 'v 'v 'ix 'e b)
  (tbh-lam-ns-type! 'v 'v 'ix 'e as)
  (let ((u1 (dk-cite! 'hs-sum-unfold 'v 'v 'ix 'e b))
        (u2 (dk-cite! 'hs-sum-unfold 'v 'v 'ix 'e as)))
    (dk-rewrite-h! (list 'IN (tbh-hs 'v 'v 'ix 'e b) 'RR) (cadr u1) (caddr u1))
    (dk-rewrite-h! (list 'IN (tbh-hs 'v 'v 'ix 'e as) 'RR) (cadr u2) (caddr u2)))
  (let ((s1 (list 'ESUM f1)) (s2 (list 'ESUM f2)))
    (tbh-esum-in! f1 'ix)
    (tbh-esum-in! f2 'ix)
    (dk-have! (list 'IN hm '(FUN ix RR-POS-STAR))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let* ((home (proof-state-focus *ps*)) (kv (dk-di-var!)) (ek (list 'e kv)))
              (tbh-ap! 'e 'ix '(VEC v) kv)
              (tbh-ap! 't_ '(VEC v) '(VEC v) ek)
              (fact 'cips-ip-type 'v (list 't_ ek) ek)
              (let ((m (list 'MAGNITUDE (list '(IP v) (list 't_ ek) ek))))
                (fact 'cc-magnitude-closed (list '(IP v) (list 't_ ek) ek))
                (fact 'cc-magnitude-nonneg (list '(IP v) (list 't_ ek) ek))
                (tbh-rps-of-real! m))
              (tbh-close-home! home)))
          (lambda () (ass)))))
    (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ ix) (list '<= (list hm 'z_) (list 'eplus (list f1 'z_) (list f2 'z_)))))
      (lambda ()
        (let* ((kv (dk-di-var!)) (ek (list 'e kv))
               (be (list b ek)) (ae (list as ek))
               (nb (list 'IP-NORM 'v be)) (na (list 'IP-NORM 'v ae))
               (nsb (tbh-ns 'v be)) (nsa (tbh-ns 'v ae))
               (z (list '(IP v) be ae)) (m (list 'MAGNITUDE z)) (p (list '* nb na))
               (dlt (list '- nb na)))
          (tbh-ap! 'e 'ix '(VEC v) kv)
          (tbh-ap! b '(VEC v) '(VEC v) ek)
          (tbh-ap! as '(VEC v) '(VEC v) ek)
          (tbh-ap! 't_ '(VEC v) '(VEC v) ek)
          (tbh-ap! a '(VEC v) '(VEC v) be)
          (tbh-ns-type! 'v be)
          (tbh-ns-type! 'v ae)
          (for-each (lambda (y) (fact 'ip-norm-in-rr 'v y) (fact 'ip-norm-nonneg 'v y)) (list be ae))
          (fact 'cips-ip-type 'v be ae)
          (fact 'cc-magnitude-closed z)
          (fact 'cc-magnitude-nonneg z)
          (fact 'cips-ip-type 'v (list 't_ ek) ek)
          (fact 'cips-ip-type 'v (list a be) ek)
          (dk-lam-b!)
          (let* ((er (begin (tbh-and! (list 'IN nsb 'RR) (list '<= 0 nsb) (list 'IN nsa 'RR) (list '<= 0 nsa))
                            (tbh-cite! 'eplus-real-defined nsb nsa)))
                 (bp (dk-cite! 'binplus-apply nsb nsa)))
            (subst er)
            (subst bp)
            (subst (list '= 't_ comp))
            (subst (dk-cite! 'bop-comp-apply 'v a b ek))
            (subst (dk-cite! 'op-adjoint-ip 'v 'v a be ek))
            (tbh-cite! 'cips-ip-magnitude-le 'v be ae)
            (tbh-and! (list 'IN nb 'RR) (list 'IN na 'RR))
            (fact 'rr-mul-closed nb na)
            (fact 'rr-sub-in-rr nb na)
            (tbh-and! (list 'IN dlt 'RR) (list 'IN dlt 'RR))
            (fact 'rr-mul-closed dlt dlt)
            (fact 'rr-sq-nonneg dlt)
            (let ((ide (list '= (list '* dlt dlt) (list '- (list '+ nsb nsa) (list '* 2 p)))))
              (dk-have! ide (lambda () (crs)))
              (dk-rewrite-h! (list '<= 0 (list '* dlt dlt)) (list '* dlt dlt) (caddr ide))
              (if (tbh-open?)
                  (dk-ineq! (list '<= m p)
                            (list '<= 0 (caddr ide))
                            (list '<= 0 nsb) (list '<= 0 nsa)
                            (list 'IN m 'RR) (list 'IN p 'RR) (list 'IN nsb 'RR) (list 'IN nsa 'RR))))))))
    (let* ((sa (tbh-cite! 'esum-subadditive 'ix f1 f2 hm))
           (er (begin (fact 'rr-pos-star-nonneg s1) (fact 'rr-pos-star-nonneg s2)
                      (tbh-and! (list 'IN s1 'RR) (list '<= 0 s1) (list 'IN s2 'RR) (list '<= 0 s2))
                      (tbh-cite! 'eplus-real-defined s1 s2)))
           (bp (dk-cite! 'binplus-apply s1 s2))
           (l1 (dk-rewrite-h! sa (cadr er) (caddr er)))
           (l2 (dk-rewrite-h! l1 (cadr bp) (caddr bp))))
      (tbh-and! (list 'IN s1 'RR) (list 'IN s2 'RR))
      (fact 'rr-add-closed s1 s2)
      (tbh-esum-in! hm 'ix)
      (tbh-and! (list 'IN (list 'ESUM hm) 'RR-POS-STAR) (list 'IN (list '+ s1 s2) 'RR))
      (fact 'rr-pos-star-le-real-in-rr (list 'ESUM hm) (list '+ s1 s2))
      (if (tbh-open?) (ass)))))
(qed 'trace-abs-summable)
(topic! 'trace-abs-summable 'analysis)

;;; ====================================================================
;;; HS(H, K) is closed under sums (Prop. 3.37: a subspace)
;;; ====================================================================
;;; hs-sum-add-le: sum ||(S+T) e_i||^2 <= 2 sum ||S e_i||^2 + 2 sum ||T e_i||^2,
;;; from ||(S+T)e|| <= ||S e|| + ||T e|| (cips-minkowski) and (p+q)^2 <= 2p^2 + 2q^2.
(define tbh-sum '(BOP-SUM v w s_ t_))
(define (tbh-2x f ix) (list 'VNB-LAMBDA 'esz_ ix (list 'etimes 2 (list f 'esz_))))
(define (tbh-two!)
  (if (not (dk-asm? '(IN 2 RR))) (dk-have! '(IN 2 RR) (lambda () (arith))))
  (if (not (dk-asm? '(<= 0 2))) (dk-have! '(<= 0 2) (lambda () (dk-ineq!))))
  (tbh-rps-of-real! 2))
(sp (make-wff (list 'FORALL 'v (list 'FORALL 'w (list 'IMPLIES '(IS-HILBERT-SPACE v) (list 'IMPLIES '(IS-HILBERT-SPACE w)
  (list 'FORALL 's_ (list 'FORALL 't_ (list 'IMPLIES '(IN s_ (BOUNDED-OPS v w)) (list 'IMPLIES '(IN t_ (BOUNDED-OPS v w))
    (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES '(IS-ORTHONORMAL-BASIS v ix e)
      (list '<= (list 'HS-SUM 'v 'w 'ix 'e tbh-sum)
                (list 'eplus (list 'etimes 2 '(HS-SUM v w ix e s_)) (list 'etimes 2 '(HS-SUM v w ix e t_)))))))))))))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(fact 'hilbert-space-is-cips 'w)
(tbh-onb! 'v 'ix 'e)
(fact 'bop-fun 'v 'w 's_)
(fact 'bop-fun 'v 'w 't_)
(fact 'bop-sum-bounded 'v 'w 's_ 't_)
(fact 'bop-fun 'v 'w tbh-sum)
(tbh-two!)
(let* ((h (tbh-lam-ns 'w 'ix 'e tbh-sum))
       (f1 (tbh-lam-ns 'w 'ix 'e 's_))
       (f2 (tbh-lam-ns 'w 'ix 'e 't_))
       (g1 (tbh-2x f1 'ix))
       (g2 (tbh-2x f2 'ix)))
  (tbh-lam-ns-type! 'v 'w 'ix 'e tbh-sum)
  (tbh-lam-ns-type! 'v 'w 'ix 'e 's_)
  (tbh-lam-ns-type! 'v 'w 'ix 'e 't_)
  (for-each
    (lambda (gl fl)
      (dk-have! (list 'IN gl '(FUN ix RR-POS-STAR))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let* ((home (proof-state-focus *ps*)) (kv (dk-di-var!)))
                (fact 'fun-apply-type-c fl 'ix 'RR-POS-STAR kv)
                (tbh-rps-of-real! 2)
                (tbh-and! '(IN 2 RR-POS-STAR) (list 'IN (list fl kv) 'RR-POS-STAR))
                (fact 'etimes-closed 2 (list fl kv))
                (tbh-close-home! home)))
            (lambda () (ass))))))
    (list g1 g2) (list f1 f2))
  (tbh-unfold-hs! 'v 'w 'ix 'e tbh-sum)
  (tbh-unfold-hs! 'v 'w 'ix 'e 's_)
  (tbh-unfold-hs! 'v 'w 'ix 'e 't_)
  (let ((c1 (tbh-cite! 'esum-scale 2 'ix f1))
        (c2 (tbh-cite! 'esum-scale 2 'ix f2)))
    (subst (list '= (caddr c1) (cadr c1)))
    (subst (list '= (caddr c2) (cadr c2))))
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ ix) (list '<= (list h 'z_) (list 'eplus (list g1 'z_) (list g2 'z_)))))
    (lambda ()
      (let* ((kv (dk-di-var!)) (ek (list 'e kv))
             (se (list 's_ ek)) (te (list 't_ ek)) (ue (list tbh-sum ek))
             (ns (list 'IP-NORM 'w se)) (nt (list 'IP-NORM 'w te)) (nu (list 'IP-NORM 'w ue))
             (nss (tbh-ns 'w se)) (ntt (tbh-ns 'w te))
             (q (list '+ ns nt)) (dlt (list '- ns nt)) (p (list '* ns nt)))
        (tbh-ap! 'e 'ix '(VEC v) kv)
        (tbh-ap! 's_ '(VEC v) '(VEC w) ek)
        (tbh-ap! 't_ '(VEC v) '(VEC w) ek)
        (tbh-ap! tbh-sum '(VEC v) '(VEC w) ek)
        (tbh-ns-type! 'w se)
        (tbh-ns-type! 'w te)
        (tbh-ns-type! 'w ue)
        (for-each (lambda (y) (fact 'ip-norm-in-rr 'w y) (fact 'ip-norm-nonneg 'w y)) (list se te ue))
        (dk-lam-b!)
        (let* ((e1 (begin (tbh-and! (list 'IN nss 'RR) (list '<= 0 nss)) (tbh-cite! 'etimes-real-defined 2 nss)))
               (b1 (dk-cite! 'bintimes-apply 2 nss))
               (e2 (begin (tbh-and! (list 'IN ntt 'RR) (list '<= 0 ntt)) (tbh-cite! 'etimes-real-defined 2 ntt)))
               (b2 (dk-cite! 'bintimes-apply 2 ntt)))
          (subst e1) (subst b1) (subst e2) (subst b2)
          (tbh-and! '(IN 2 RR) (list 'IN nss 'RR))
          (fact 'rr-mul-closed 2 nss)
          (tbh-and! '(IN 2 RR) (list 'IN ntt 'RR))
          (fact 'rr-mul-closed 2 ntt)
          (tbh-and! (list '<= 0 2) (list '<= 0 nss))
          (dk-cite! 'rr-leq-mul-nonneg 2 nss)
          (tbh-and! (list '<= 0 2) (list '<= 0 ntt))
          (dk-cite! 'rr-leq-mul-nonneg 2 ntt)
          (let* ((x1 (list '* 2 nss)) (x2 (list '* 2 ntt))
                 (ep (begin (tbh-and! (list 'IN x1 'RR) (list '<= 0 x1) (list 'IN x2 'RR) (list '<= 0 x2))
                            (tbh-cite! 'eplus-real-defined x1 x2)))
                 (bp (dk-cite! 'binplus-apply x1 x2)))
            (subst ep) (subst bp)
            (subst (dk-cite! 'bop-sum-apply 'v 'w 's_ 't_ ek))
            (let* ((vs (list '(VADD w) se te)) (nv (list 'IP-NORM 'w vs)))
              (fact 'cips-vadd-type 'w se te)
              (fact 'ip-norm-in-rr 'w vs)
              (fact 'ip-norm-nonneg 'w vs)
              (tbh-cite! 'cips-minkowski 'w se te)
              (tbh-and! (list 'IN ns 'RR) (list 'IN nt 'RR))
              (fact 'rr-add-closed ns nt)
              (fact 'rr-sub-in-rr ns nt)
              (fact 'rr-mul-closed ns nt)
              (tbh-cite! 'rr-square-mono nv q)
              (tbh-and! (list 'IN dlt 'RR) (list 'IN dlt 'RR))
              (fact 'rr-mul-closed dlt dlt)
              (fact 'rr-sq-nonneg dlt)
              (tbh-and! (list 'IN nv 'RR) (list 'IN nv 'RR))
              (fact 'rr-mul-closed nv nv)
              (let ((i1 (list '= (list '* q q) (list '+ (list '+ nss ntt) (list '* 2 p))))
                    (i2 (list '= (list '* dlt dlt) (list '- (list '+ nss ntt) (list '* 2 p)))))
                (dk-have! i1 (lambda () (crs)))
                (dk-have! i2 (lambda () (crs)))
                (dk-rewrite-h! (list '<= (list '* nv nv) (list '* q q)) (list '* q q) (caddr i1))
                (dk-rewrite-h! (list '<= 0 (list '* dlt dlt)) (list '* dlt dlt) (caddr i2))
                (if (tbh-open?)
                    (dk-ineq! (list '<= (list '* nv nv) (caddr i1))
                              (list '<= 0 (caddr i2))
                              (list 'IN (list '* nv nv) 'RR) (list 'IN p 'RR) (list 'IN nss 'RR) (list 'IN ntt 'RR))))))))))
  (let ((sa (tbh-cite! 'esum-subadditive 'ix g1 g2 h)))
    (if (tbh-open?) (ass))))
(qed 'hs-sum-add-le)
(topic! 'hs-sum-add-le 'analysis)

;;; hs-add: S + T is Hilbert-Schmidt when S and T are
(sp (make-wff (list 'FORALL 'v (list 'FORALL 'w (list 'IMPLIES '(IS-HILBERT-SPACE v) (list 'IMPLIES '(IS-HILBERT-SPACE w)
  (list 'FORALL 's_ (list 'FORALL 't_ (list 'IMPLIES '(IS-HILBERT-SCHMIDT v w s_) (list 'IMPLIES '(IS-HILBERT-SCHMIDT v w t_)
    (list 'IS-HILBERT-SCHMIDT 'v 'w tbh-sum)))))))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(fact 'hilbert-space-is-cips 'w)
(for-each (lambda (x)
            (let ((bx (list 'IN x '(BOUNDED-OPS v w))))
              (dk-have! bx (lambda () (dk-project! bx 'IS-HILBERT-SCHMIDT (list 'IS-HILBERT-SCHMIDT 'v 'w x))))))
          '(s_ t_))
(fact 'bop-sum-bounded 'v 'w 's_ 't_)
(tbh-two!)
(let* ((ie (tbh-open-hs! 'v 'w 's_)) (i0 (car ie)) (e0 (cdr ie))
       (hs (tbh-hs 'v 'w i0 e0 's_)) (ht (tbh-hs 'v 'w i0 e0 't_)) (hu (tbh-hs 'v 'w i0 e0 tbh-sum)))
  (tbh-onb! 'v i0 e0)
  (fact 'hs-sum-real-any-basis 'v 'w 't_ i0 e0)
  (fact 'hs-sum-in-rps 'v 'w 's_ i0 e0)
  (fact 'hs-sum-in-rps 'v 'w 't_ i0 e0)
  (fact 'hs-sum-in-rps 'v 'w tbh-sum i0 e0)
  (fact 'rr-pos-star-nonneg hs)
  (fact 'rr-pos-star-nonneg ht)
  (let* ((le (tbh-cite! 'hs-sum-add-le 'v 'w 's_ 't_ i0 e0))
         (r1 (begin (tbh-and! '(IN 2 RR) '(<= 0 2) (list 'IN hs 'RR) (list '<= 0 hs))
                    (tbh-cite! 'etimes-real-defined 2 hs)))
         (q1 (dk-cite! 'bintimes-apply 2 hs))
         (r2 (begin (tbh-and! '(IN 2 RR) '(<= 0 2) (list 'IN ht 'RR) (list '<= 0 ht))
                    (tbh-cite! 'etimes-real-defined 2 ht)))
         (q2 (dk-cite! 'bintimes-apply 2 ht))
         (l1 (dk-rewrite-h! le (cadr r1) (caddr r1)))
         (l2 (dk-rewrite-h! l1 (cadr q1) (caddr q1)))
         (l3 (dk-rewrite-h! l2 (cadr r2) (caddr r2)))
         (l4 (dk-rewrite-h! l3 (cadr q2) (caddr q2)))
         (x1 (list '* 2 hs)) (x2 (list '* 2 ht)))
    (tbh-and! '(IN 2 RR) (list 'IN hs 'RR))
    (fact 'rr-mul-closed 2 hs)
    (tbh-and! '(IN 2 RR) (list 'IN ht 'RR))
    (fact 'rr-mul-closed 2 ht)
    (tbh-and! '(<= 0 2) (list '<= 0 hs))
    (dk-cite! 'rr-leq-mul-nonneg 2 hs)
    (tbh-and! '(<= 0 2) (list '<= 0 ht))
    (dk-cite! 'rr-leq-mul-nonneg 2 ht)
    (let* ((ep (begin (tbh-and! (list 'IN x1 'RR) (list '<= 0 x1) (list 'IN x2 'RR) (list '<= 0 x2))
                      (tbh-cite! 'eplus-real-defined x1 x2)))
           (bp (dk-cite! 'binplus-apply x1 x2))
           (l5 (dk-rewrite-h! l4 (cadr ep) (caddr ep)))
           (l6 (dk-rewrite-h! l5 (cadr bp) (caddr bp))))
      (tbh-and! (list 'IN x1 'RR) (list 'IN x2 'RR))
      (fact 'rr-add-closed x1 x2)
      (tbh-and! (list 'IN hu 'RR-POS-STAR) (list 'IN (list '+ x1 x2) 'RR))
      (fact 'rr-pos-star-le-real-in-rr hu (list '+ x1 x2))
      (tbh-close-hs! i0 e0))))
(qed 'hs-add)
(topic! 'hs-add 'analysis)

;;; hs-scale: c T is Hilbert-Schmidt when T is; sum ||c T e_i||^2 = |c|^2 sum ||T e_i||^2
(define tbh-sc '(BOP-SCALE v w c_ t_))
(sp (make-wff (list 'FORALL 'v (list 'FORALL 'w (list 'IMPLIES '(IS-HILBERT-SPACE v) (list 'IMPLIES '(IS-HILBERT-SPACE w)
  (list 'FORALL 'c_ (list 'FORALL 't_ (list 'IMPLIES '(IN c_ CC) (list 'IMPLIES '(IS-HILBERT-SCHMIDT v w t_)
    (list 'IS-HILBERT-SCHMIDT 'v 'w tbh-sc)))))))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(fact 'hilbert-space-is-cips 'w)
(dk-have! '(IN t_ (BOUNDED-OPS v w)) (lambda () (dk-project! '(IN t_ (BOUNDED-OPS v w)) 'IS-HILBERT-SCHMIDT '(IS-HILBERT-SCHMIDT v w t_))))
(fact 'bop-scale-bounded 'v 'w 'c_ 't_)
(fact 'bop-fun 'v 'w 't_)
(fact 'bop-fun 'v 'w tbh-sc)
(let* ((ie (tbh-open-hs! 'v 'w 't_)) (i0 (car ie)) (e0 (cdr ie))
       (ht (tbh-hs 'v 'w i0 e0 't_)) (hu (tbh-hs 'v 'w i0 e0 tbh-sc))
       (g (tbh-lam-ns 'w i0 e0 't_)) (h (tbh-lam-ns 'w i0 e0 tbh-sc))
       (cm (tbh-ms 'c_)))
  (tbh-onb! 'v i0 e0)
  (tbh-ms-type! 'c_)
  (tbh-lam-ns-type! 'v 'w i0 e0 't_)
  (tbh-lam-ns-type! 'v 'w i0 e0 tbh-sc)
  (fact 'rr-pos-star-nonneg cm)
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ i0) (list '= (list h 'z_) (list 'etimes cm (list g 'z_)))))
    (lambda ()
      (let* ((kv (dk-di-var!)) (ek (list e0 kv)) (te (list 't_ ek))
