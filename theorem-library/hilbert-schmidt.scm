(fact 'hilbert-space-is-cips 'v)
(dk-have! '(IN t_ (BOUNDED-OPS v v)) (lambda () (dk-project! '(IN t_ (BOUNDED-OPS v v)) 'IS-HILBERT-SCHMIDT '(IS-HILBERT-SCHMIDT v v t_))))
(fact 'bop-comp-bounded 'v 's_ 't_)
(fact 'opnorm-in-rr 'v 'v 's_)
(fact 'opnorm-nonneg 'v 'v 's_)
(let* ((ie (tbh-open-hs! 'v 'v 't_)) (i0 (car ie)) (e0 (cdr ie))
       (n '(OPNORM v v s_)) (c tbh-nc)
       (ht (tbh-hs 'v 'v i0 e0 't_)) (hc (tbh-hs 'v 'v i0 e0 tbh-C)))
  (tbh-onb! 'v i0 e0)
  (tbh-and! (list 'IN n 'RR) (list 'IN n 'RR))
  (fact 'rr-mul-closed n n)
  (fact 'rr-sq-nonneg n)
  (fact 'hs-sum-in-rps 'v 'v 't_ i0 e0)
  (fact 'hs-sum-in-rps 'v 'v tbh-C i0 e0)
  (fact 'rr-pos-star-nonneg ht)
  (let* ((le (tbh-cite! 'hs-sum-comp-left 'v 's_ 't_ i0 e0))
         (er (begin (tbh-and! (list 'IN c 'RR) (list '<= 0 c) (list 'IN ht 'RR) (list '<= 0 ht))
                    (tbh-cite! 'etimes-real-defined c ht)))
         (bt (dk-cite! 'bintimes-apply c ht))
         (le1 (dk-rewrite-h! le (cadr er) (caddr er)))
         (le2 (dk-rewrite-h! le1 (cadr bt) (caddr bt))))
