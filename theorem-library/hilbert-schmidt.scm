;;; ====================================================================
;;; th3b-hs.scm -- TH3-B, 2026-11-09.  Hilbert-Schmidt operators (th-main s.3.6).
;;;
;;; PART 1 (no TH3 vocabulary): the identity (3.10) of th-main,
;;;   hs-sum-adjoint   H, K Hilbert spaces, T in B(H, K), {e_i} an ONB of H, {f_j} an ONB of K:
;;;                    sum_i ||T e_i||^2 = sum_j ||T* f_j||^2   (sums in [0,+inf], ESUM)
;;;   hs-sum-basis-independent   the same sum for two ONBs {e_i}, {e'_k} of H agrees.
;;; The proof is the book's: ||T e_i||^2 = sum_j |<T e_i, f_j>|^2 (Parseval in K),
;;; |<T e_i, f_j>| = |<e_i, T* f_j>| = |<T* f_j, e_i>|, and the double sum is summed in the
;;; other order (esum-swap, th3b-esum.scm), giving sum_j ||T* f_j||^2 by Parseval in H.
;;; Basis independence: apply hs-sum-adjoint to (e, f) and to (e', f) with the same f.
;;;
;;; PART 2 (TH3 vocabulary, th3-vocab.scm of TH3-A):
;;;   hs-sum-basis-independent, hs-sum-adjoint-eq, hs-sum-real-any-basis   (3.10), Obs. 3.35
;;;   hs-adjoint (Ex. 3.12), canon-onb-is-onb, hs-norm-any-basis, hs-sum-in-rps
;;;   hs-sum-comp-left (Ex. 3.12: ||ST||_HS^2 <= ||S||^2 ||T||_HS^2), hs-comp-left,
;;;   hs-comp-right, hs-sum-add-le, hs-add, hs-scale       (Prop. 3.37: HS a two-sided ideal
;;;                                                         and a subspace)
;;;   hs-vector-bound ((3.14) form), hs-opnorm-le ((3.15): ||T|| <= ||T||_HS)
;;;   trace-abs-summable (Prop. 3.45, absolute convergence of (Tr) in every basis, for
;;;                       T = A B with A, B Hilbert-Schmidt, the definition IS-TRACE-CLASS)
;;;
;;; LOAD WINDOW: after theorem-library/hilbert-onb (parseval-identity), ba-bh
;;; (op-adjoint-ip, op-adjoint-fun, op-adjoint-type, bop-fun, ip-norm-*), and
;;; ba-bh2 (bop-sum-*, bop-scale-*), th3-vocab-unfold (hs-sum-unfold) and th3b-esum
;;; (esum-swap, esum-subadditive).  Library: operator-algebras.
;;; ====================================================================

(define (tbh-ns w y) (list '* (list 'IP-NORM w y) (list 'IP-NORM w y)))
(define (tbh-ms z) (list '* (list 'MAGNITUDE z) (list 'MAGNITUDE z)))
(define tbh-ts '(OP-ADJOINT v w t_))
(define (tbh-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))

(define (tbh-and! . ps)
  (let ((f (let build ((l ps)) (if (null? (cdr l)) (car l) (list 'AND (car l) (build (cdr l)))))))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (tbh-rps-of-real! x)
  (if (not (dk-asm? (list 'IN x 'RR-POS-STAR)))
      (dk-have! (list 'IN x 'RR-POS-STAR)
        (lambda ()
          (let ((inst (dk-cite! 'rr-pos-star-membership x)))
            (dk-only! inst (list 'IN x 'RR) (list '<= 0 x))
            (prop))))))

;;; z in CC in context: |z| |z| in RR, >= 0, in RR-POS-STAR
(define (tbh-ms-type! z)
  (let ((m (list 'MAGNITUDE z)))
    (fact 'cc-magnitude-closed z)
    (tbh-and! (list 'IN m 'RR) (list 'IN m 'RR))
    (fact 'rr-mul-closed m m)
    (fact 'rr-sq-nonneg m)
    (tbh-rps-of-real! (tbh-ms z))))
;;; y in VEC w, CIPS w in context: ||y|| ||y|| in RR-POS-STAR
(define (tbh-ns-type! w y)
  (let ((n (list 'IP-NORM w y)))
    (fact 'ip-norm-in-rr w y)
    (tbh-and! (list 'IN n 'RR) (list 'IN n 'RR))
    (fact 'rr-mul-closed n n)
    (fact 'rr-sq-nonneg n)
    (tbh-rps-of-real! (tbh-ns w y))))

(define (tbh-cite! thm . args)
  (let loop ((r (apply dk-cite! thm args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (if (dk-asm? (caddr r))
            (loop (caddr r))
            (loop (dk-landed-1 (lambda () (detach! r)))))
        r)))
;;; close the leaf the typer started on, wherever the focus has gone (the claim may have
;;; been proved in place by a dk-have! equal to the goal)
(define (tbh-close-home! home)
  (if (and (not (proof-done? *ps*)) (dk-head-is? (dk-goal) 'IN) (dk-asm? (dk-goal))) (ass)))
(define (tbh-ap! f a b x) (if (not (dk-asm? (list 'IN (list f x) b))) (fact 'fun-apply-type-c f a b x)))

;;; the ONB projections: (IS-ORTHONORMAL-FAMILY v ix e), e in FUN(ix, VEC v), ix in SET
(define (tbh-onb! v ix e)
  (let ((onb (list 'IS-ORTHONORMAL-BASIS v ix e))
        (onf (list 'IS-ORTHONORMAL-FAMILY v ix e)))
    (dk-project! onf 'is-orthonormal-basis onb)
    (dk-project! (list 'IN e (list 'FUN ix (list 'VEC v))) 'is-orthonormal-family onf)
    (fact 'fun-domain-in-set ix (list 'VEC v) e)))

(define tbh-G '(VNB-LAMBDA tbi_ ix (VNB-LAMBDA onk_ jx
                 (* (MAGNITUDE ((IP w) (t_ (e tbi_)) (f onk_))) (MAGNITUDE ((IP w) (t_ (e tbi_)) (f onk_)))))))
(define tbh-GT '(VNB-LAMBDA tbj_ jx (VNB-LAMBDA onk_ ix
                  (* (MAGNITUDE ((IP v) ((OP-ADJOINT v w t_) (f tbj_)) (e onk_)))
                     (MAGNITUDE ((IP v) ((OP-ADJOINT v w t_) (f tbj_)) (e onk_)))))))
(define tbh-A '(VNB-LAMBDA kqk_ ix (* (IP-NORM w (t_ (e kqk_))) (IP-NORM w (t_ (e kqk_))))))
(define tbh-B '(VNB-LAMBDA kqk_ jx (* (IP-NORM v ((OP-ADJOINT v w t_) (f kqk_)))
                                      (IP-NORM v ((OP-ADJOINT v w t_) (f kqk_))))))

(define (tbh-stmt concl)
  (list 'FORALL 'v (list 'FORALL 'w (list 'IMPLIES '(IS-HILBERT-SPACE v) (list 'IMPLIES '(IS-HILBERT-SPACE w)
    (list 'FORALL 't_ (list 'IMPLIES '(IN t_ (BOUNDED-OPS v w))
      (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES '(IS-ORTHONORMAL-BASIS v ix e)
        (list 'FORALL 'jx (list 'FORALL 'f (list 'IMPLIES '(IS-ORTHONORMAL-BASIS w jx f)
          concl)))))))))))))

;;; ====================================================================
;;; hs-sum-adjoint  (th-main (3.10))
;;; ====================================================================
(sp (make-wff (tbh-stmt (list '= (list 'ESUM tbh-A) (list 'ESUM tbh-B)))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(fact 'hilbert-space-is-cips 'w)
(tbh-onb! 'v 'ix 'e)
(tbh-onb! 'w 'jx 'f)
(fact 'bop-fun 'v 'w 't_)
(fact 'op-adjoint-fun 'v 'w 't_)
;;; the typings of e_i, T e_i, f_j, T* f_j at eigenvariables i, j
(define (tbh-pt! i j)
  (if i (begin (tbh-ap! 'e 'ix '(VEC v) i) (tbh-ap! 't_ '(VEC v) '(VEC w) (list 'e i))))
  (if j (begin (tbh-ap! 'f 'jx '(VEC w) j) (tbh-ap! tbh-ts '(VEC w) '(VEC v) (list 'f j)))))
;;; G : ix -> (jx -> [0,+inf])
(dk-have! (list 'IN tbh-G '(FUN ix (FUN jx RR-POS-STAR)))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((iv (dk-di-var!)))
          (tbh-pt! iv #f)
          (dk-lam-type!
            (lambda ()
              (let* ((home (proof-state-focus *ps*)) (kv (dk-di-var!)))
                (tbh-pt! #f kv)
                (fact 'cips-ip-type 'w (list 't_ (list 'e iv)) (list 'f kv))
                (tbh-ms-type! (list '(IP w) (list 't_ (list 'e iv)) (list 'f kv)))
                (tbh-close-home! home)))
            (lambda () (ass)))))
      (lambda () (ass)))))
(dk-have! (list 'IN tbh-GT '(FUN jx (FUN ix RR-POS-STAR)))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((jv (dk-di-var!)))
          (tbh-pt! #f jv)
          (dk-lam-type!
            (lambda ()
              (let* ((home (proof-state-focus *ps*)) (kv (dk-di-var!)))
                (tbh-pt! kv #f)
                (fact 'cips-ip-type 'v (list tbh-ts (list 'f jv)) (list 'e kv))
                (tbh-ms-type! (list '(IP v) (list tbh-ts (list 'f jv)) (list 'e kv)))
                (tbh-close-home! home)))
            (lambda () (ass)))))
      (lambda () (ass)))))
(dk-have! (list 'IN tbh-A '(FUN ix RR-POS-STAR))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let* ((home (proof-state-focus *ps*)) (iv (dk-di-var!)))
          (tbh-pt! iv #f)
          (tbh-ns-type! 'w (list 't_ (list 'e iv)))
          (tbh-close-home! home)))
      (lambda () (ass)))))
(dk-have! (list 'IN tbh-B '(FUN jx RR-POS-STAR))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let* ((home (proof-state-focus *ps*)) (jv (dk-di-var!)))
          (tbh-pt! #f jv)
          (tbh-ns-type! 'v (list tbh-ts (list 'f jv)))
          (tbh-close-home! home)))
      (lambda () (ass)))))
;;; the transpose
(dk-have! (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ ix) (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ jx)
            (list '= (list (list tbh-GT 'j_) 'i_) (list (list tbh-G 'i_) 'j_))))))
  (lambda ()
    (dk-peel!)
    (let* ((gl (dk-goal))
           (iv (cadr (cadr gl)))
           (jv (cadr (car (cadr gl))))
           (z1 (list '(IP v) (list tbh-ts (list 'f jv)) (list 'e iv)))
           (z0 (list '(IP v) (list 'e iv) (list tbh-ts (list 'f jv))))
           (z2 (list '(IP w) (list 't_ (list 'e iv)) (list 'f jv))))
      (tbh-pt! iv jv)
      (fact 'cips-ip-type 'v (list tbh-ts (list 'f jv)) (list 'e iv))
      (fact 'cips-ip-type 'v (list 'e iv) (list tbh-ts (list 'f jv)))
      (fact 'cips-ip-type 'w (list 't_ (list 'e iv)) (list 'f jv))
      (tbh-ms-type! z1)
      (tbh-ms-type! z2)
      (dk-lam-b!)
      (if (tbh-open?)
          (let* ((adj (dk-cite! 'op-adjoint-ip 'v 'w 't_ (list 'e iv) (list 'f jv)))
                 (cs (dk-cite! 'cips-ip-conj-sym 'v (list tbh-ts (list 'f jv)) (list 'e iv)))
                 (mc (dk-cite! 'cc-magnitude-conjugate z1)))
            (subst adj)
            (subst cs)
            (subst mc)
            (if (tbh-open?) (rfl)))))))
;;; the row sums: ||T e_i||^2 = sum_j |<T e_i, f_j>|^2  (Parseval in w)
(dk-have! (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ ix) (list '= (list tbh-A 'i_) (list 'ESUM (list tbh-G 'i_)))))
  (lambda ()
    (let* ((iv (dk-di-var!)) (y (list 't_ (list 'e iv))))
      (tbh-pt! iv #f)
      (tbh-ns-type! 'w y)
      (dk-lam-b!)
      (if (tbh-open?)
          (let* ((pv (dk-cite! 'parseval-identity 'w 'jx 'f y))
                 (sq (dk-cite! 'ip-norm-sq 'w y)))
            (subst pv)
            (subst sq)
            (if (tbh-open?) (rfl)))))))
;;; the column sums: ||T* f_j||^2 = sum_i |<T* f_j, e_i>|^2  (Parseval in v)
(dk-have! (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ jx) (list '= (list tbh-B 'j_) (list 'ESUM (list tbh-GT 'j_)))))
  (lambda ()
    (let* ((jv (dk-di-var!)) (y (list tbh-ts (list 'f jv))))
      (tbh-pt! #f jv)
      (tbh-ns-type! 'v y)
      (dk-lam-b!)
      (if (tbh-open?)
          (let* ((pv (dk-cite! 'parseval-identity 'v 'ix 'e y))
                 (sq (dk-cite! 'ip-norm-sq 'v y)))
            (subst pv)
            (subst sq)
            (if (tbh-open?) (rfl)))))))
(let ((sw (tbh-cite! 'esum-swap 'ix 'jx tbh-G tbh-GT tbh-A tbh-B)))
  (if (tbh-open?) (ass)))
(qed 'hs-sum-adjoint)
(topic! 'hs-sum-adjoint 'analysis)

;;; ====================================================================
;;; PART 2: with the TH3 vocabulary (th3-vocab.scm, md5 f7a7698a...)
;;; ====================================================================
(define (tbh-hs v w ix e t) (list 'HS-SUM v w ix e t))
;;; HS-SUM unfolded on the goal, at the given arguments
(define (tbh-unfold-hs! v w ix e t)
  (subst (dk-cite! 'hs-sum-unfold v w ix e t)))
;;; an orthonormal basis of the Hilbert space w: returns (jx . f)
(define (tbh-some-onb! w)
  (let* ((ex (tbh-cite! 'onb-exists w))
         (jx (dk-skolem! ex))
         (ex2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'IS-ORTHONORMAL-BASIS)
                                         (memq jx (free-vars h))))
                       "the basis existential"))
         (f (dk-skolem! ex2)))
    (cons jx f)))

;;; hs-sum-basis-independent (th-main (3.10), Obs. 3.35): sum_i ||T e_i||^2 is the same
;;; for every orthonormal basis of H
(sp (make-wff (list 'FORALL 'v (list 'FORALL 'w (list 'IMPLIES '(IS-HILBERT-SPACE v) (list 'IMPLIES '(IS-HILBERT-SPACE w)
  (list 'FORALL 't_ (list 'IMPLIES '(IN t_ (BOUNDED-OPS v w))
    (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES '(IS-ORTHONORMAL-BASIS v ix e)
      (list 'FORALL 'kx (list 'FORALL 'e2 (list 'IMPLIES '(IS-ORTHONORMAL-BASIS v kx e2)
        '(= (HS-SUM v w ix e t_) (HS-SUM v w kx e2 t_))))))))))))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'w)
(let* ((jf (tbh-some-onb! 'w)) (jx (car jf)) (f (cdr jf)))
  (let* ((h1 (tbh-cite! 'hs-sum-adjoint 'v 'w 't_ 'ix 'e jx f))
         (h2 (tbh-cite! 'hs-sum-adjoint 'v 'w 't_ 'kx 'e2 jx f)))
    (tbh-unfold-hs! 'v 'w 'ix 'e 't_)
    (tbh-unfold-hs! 'v 'w 'kx 'e2 't_)
    (subst h1)
    (subst h2)
    (if (tbh-open?) (rfl))))
(qed 'hs-sum-basis-independent)
(topic! 'hs-sum-basis-independent 'analysis)

;;; hs-sum-adjoint-eq: the identity (3.10) in the vocabulary
(sp (make-wff (tbh-stmt '(= (HS-SUM w v jx f (OP-ADJOINT v w t_)) (HS-SUM v w ix e t_)))))
(dk-peel!)
(let ((h (tbh-cite! 'hs-sum-adjoint 'v 'w 't_ 'ix 'e 'jx 'f)))
  (tbh-unfold-hs! 'w 'v 'jx 'f tbh-ts)
  (tbh-unfold-hs! 'v 'w 'ix 'e 't_)
  (subst h)
  (if (tbh-open?) (rfl)))
(qed 'hs-sum-adjoint-eq)
(topic! 'hs-sum-adjoint-eq 'analysis)

;;; open IS-HILBERT-SCHMIDT(v, w, t) in context: returns (i0 . e0) with the ONB and
;;; (IN (HS-SUM v w i0 e0 t) RR) in context
(define (tbh-open-hs! v w t)
  (let* ((hs (list 'IS-HILBERT-SCHMIDT v w t))
         (opened (dk-landed-1 (lambda () (mac-h 'IS-HILBERT-SCHMIDT hs)))))
    (dk-split-all! (list opened))
    (let* ((ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'HS-SUM) (dk-contains? h t)))
                        "the HS witness"))
           (i0 (dk-skolem! ex))
           (ex2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'HS-SUM) (memq i0 (free-vars h))))
                         "the HS basis"))
           (e0 (dk-skolem! ex2)))
      (cons i0 e0))))

;;; Obs. 3.35: a Hilbert-Schmidt operator has sum ||T e_i||^2 finite for EVERY basis
(sp (make-wff (list 'FORALL 'v (list 'FORALL 'w (list 'IMPLIES '(IS-HILBERT-SPACE v) (list 'IMPLIES '(IS-HILBERT-SPACE w)
  (list 'FORALL 't_ (list 'IMPLIES '(IS-HILBERT-SCHMIDT v w t_)
    (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES '(IS-ORTHONORMAL-BASIS v ix e)
      '(IN (HS-SUM v w ix e t_) RR))))))))))))
(dk-peel!)
(dk-have! '(IN t_ (BOUNDED-OPS v w)) (lambda () (dk-project! '(IN t_ (BOUNDED-OPS v w)) 'IS-HILBERT-SCHMIDT '(IS-HILBERT-SCHMIDT v w t_))))
(let* ((ie (tbh-open-hs! 'v 'w 't_)) (i0 (car ie)) (e0 (cdr ie))
       (eq (tbh-cite! 'hs-sum-basis-independent 'v 'w 't_ i0 e0 'ix 'e)))
  (subst (list '= (caddr eq) (cadr eq)))
  (if (tbh-open?) (ass)))
(qed 'hs-sum-real-any-basis)
(topic! 'hs-sum-real-any-basis 'analysis)

;;; Exercise 3.12 (HS is involutive): T in HS(H, K) => T* in HS(K, H)
(sp (make-wff (list 'FORALL 'v (list 'FORALL 'w (list 'IMPLIES '(IS-HILBERT-SPACE v) (list 'IMPLIES '(IS-HILBERT-SPACE w)
  (list 'FORALL 't_ (list 'IMPLIES '(IS-HILBERT-SCHMIDT v w t_)
    '(IS-HILBERT-SCHMIDT w v (OP-ADJOINT v w t_))))))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'w)
(dk-have! '(IN t_ (BOUNDED-OPS v w)) (lambda () (dk-project! '(IN t_ (BOUNDED-OPS v w)) 'IS-HILBERT-SCHMIDT '(IS-HILBERT-SCHMIDT v w t_))))
(fact 'op-adjoint-bounded 'v 'w 't_)
(let* ((ie (tbh-open-hs! 'v 'w 't_)) (i0 (car ie)) (e0 (cdr ie))
       (jf (tbh-some-onb! 'w)) (jx (car jf)) (f (cdr jf))
       (eq (tbh-cite! 'hs-sum-adjoint-eq 'v 'w 't_ i0 e0 jx f)))
  (tbh-onb! 'w jx f)
  (dk-have! (list 'IN (tbh-hs 'w 'v jx f tbh-ts) 'RR)
    (lambda () (subst eq) (if (tbh-open?) (ass))))
  (mac 'IS-HILBERT-SCHMIDT)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (ew jx)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (begin
                      (ew f)
                      (dk-conj-close! (lambda () (dk-ass!))))))))))))
(qed 'hs-adjoint)
(topic! 'hs-adjoint 'analysis)

;;; the chosen basis CANON-ONB(v), indexed by itself, is an orthonormal basis
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v)
   (IS-ORTHONORMAL-BASIS v (CANON-ONB v) (VNB-LAMBDA kqe_ (CANON-ONB v) kqe_))))))
(dk-peel!)
(fact 'cips-vec-set 'v)
(dk-have! '(IS-ORTHONORMAL-SET v EMPTY-SET)
  (lambda ()
    (mac 'is-orthonormal-set)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'SUBSET)
            (begin (fact 'empty-subset-any '(VEC v)) (dk-ass!))
            (let* ((ld (dk-peel!))
                   (z (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'EMPTY-SET))) ld)))
                   (ne (dk-cite! 'empty-set-has-no-members z)))
              (if (dk-only! (list 'IN z 'EMPTY-SET) (list 'NOT (list 'IN z 'EMPTY-SET))) (prop))))))))
(let* ((ex (dk-cite! 'onb-complete-orthonormal-set-exists 'v 'EMPTY-SET))
       (mm (dk-skolem! ex))
       (os (dk-pick (lambda (h) (and (dk-head-is? h 'IS-ORTHONORMAL-SET) (memq mm (free-vars h)))) "the set"))
       (cpl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'VZERO) (memq mm (free-vars h)))) "completeness")))
  (fact 'onb-of-complete-orthonormal-set 'v mm)
  (dk-project! (list 'SUBSET mm '(VEC v)) 'is-orthonormal-set os)
  (fact 'subclass-of-set-is-set mm '(VEC v))
  (let ((mem (list 'IN mm '(ONB-SETS v))))
    (dk-have! mem
      (lambda ()
        (let ((iff (dk-cite! 'onb-sets-membership 'v mm)))
          (dk-have! (list 'IN mm '(POWER (VEC v)))
            (lambda ()
              (let ((pi (dk-cite! 'power-set-membership '(VEC v) mm)))
                (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ mm) '(IN z_ (VEC v))))
                  (lambda ()
                    (let ((zv (dk-di-var!)))
                      (fact 'subset-mem-fwd mm '(VEC v) zv)
                      (if (tbh-open?) (ass)))))
                (if (dk-only! pi (list 'IN mm 'SET) (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ mm) '(IN z_ (VEC v)))))
                    (prop)))))
          (if (dk-only! iff (list 'IN mm '(POWER (VEC v)))
                        (list 'IS-ORTHONORMAL-BASIS 'v mm (list 'VNB-LAMBDA 'onk_ mm 'onk_)))
              (prop)))))
    (dk-have! '(FORSOME cv_ (IN cv_ (ONB-SETS v))) (lambda () (ew mm) (if (tbh-open?) (dk-ass!))))
    (fact 'choice-axiom '(ONB-SETS v))
    (let ((ch '(CHOICE (ONB-SETS v))))
      (subst (dk-cite! 'canon-onb-unfold 'v))
      (let ((iff2 (dk-cite! 'onb-sets-membership 'v ch)))
        (if (dk-only! iff2 (list 'IN ch '(ONB-SETS v))) (prop))))))
(qed 'canon-onb-is-onb)
(topic! 'canon-onb-is-onb 'analysis)

;;; the HS norm in any basis: ||T||_HS = sqrt(sum_i ||T e_i||^2)
(sp (make-wff (list 'FORALL 'v (list 'FORALL 'w (list 'IMPLIES '(IS-HILBERT-SPACE v) (list 'IMPLIES '(IS-HILBERT-SPACE w)
  (list 'FORALL 't_ (list 'IMPLIES '(IN t_ (BOUNDED-OPS v w))
    (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES '(IS-ORTHONORMAL-BASIS v ix e)
      '(== (HS-NORM v w t_) (SQRT (HS-SUM v w ix e t_))))))))))))))
