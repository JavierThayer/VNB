;;; ====================================================================
;;; HS(H) is a two-sided ideal of B(H)  (Prop. 3.37, Exercise 3.12)
;;; ====================================================================
(define (tbh-lam-ns v ix e t) (list 'VNB-LAMBDA 'kqk_ ix (tbh-ns v (list t (list e 'kqk_)))))
;;; with CIPS v, e in FUN(ix, VEC v), t in FUN(VEC v, VEC w): the family k |-> ||t e_k||^2 typed
(define (tbh-lam-ns-type! v w ix e t)
  (let ((ty (list 'IN (tbh-lam-ns w ix e t) (list 'FUN ix 'RR-POS-STAR))))
    (if (not (dk-asm? ty))
        (dk-have! ty
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let* ((home (proof-state-focus *ps*)) (kv (dk-di-var!)))
                  (tbh-ap! e ix (list 'VEC v) kv)
                  (tbh-ap! t (list 'VEC v) (list 'VEC w) (list e kv))
                  (tbh-ns-type! w (list t (list e kv)))
                  (tbh-close-home! home)))
              (lambda () (ass))))))
    ty))

