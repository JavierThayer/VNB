;;; build IS-HILBERT-SCHMIDT(v, w, t) on the goal from t bounded, an ONB (ix, e) and
;;; HS-SUM real, all in context
(define (tbh-close-hs! ix e)
  (mac 'IS-HILBERT-SCHMIDT)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (ew ix)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (begin
                      (ew e)
                      (dk-conj-close! (lambda () (dk-ass!))))))))))))

;;; S T is Hilbert-Schmidt when T is
(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-HILBERT-SPACE v)
  (list 'FORALL 's_ (list 'FORALL 't_ (list 'IMPLIES '(IN s_ (BOUNDED-OPS v v)) (list 'IMPLIES '(IS-HILBERT-SCHMIDT v v t_)
    (list 'IS-HILBERT-SCHMIDT 'v 'v tbh-C)))))))))
