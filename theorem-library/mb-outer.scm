;;; mb-outer.scm -- construction-of-measures.pdf Lemma 4.5 (countable form) and Prop. 4.13.
;;; Agent M-B, 2026-10-26.  DESTINATION: theorem-library/mb-outer.scm.  Library: measure.
;;;
;;;   outer-measure-disjoint-additive   Lemma 4.5: E_i pairwise disjoint mu*-measurable, A
;;;                                     arbitrary:  mu*(A n U E_i) = sum_i mu*(A n E_i)
;;;
;;; THE ROUTE: (<=) A n U E_i is inside U_i (A n E_i), countable subadditivity of mu*;
;;; (>=) A n E_k lies inside (A n U E) n D_k (D_k = E_k \ U_{j<k} E_j, by disjointness), and
;;; the sums of mu*((A n U E) n D_k) over the prefixes are bounded by mu*(A n U E)
;;; (caratheodory-prefix-split at the test set A n U E) -- the route of caratheodory-measure,
;;; with the test set A n U E in place of U E.
;;; CITATIONS: is-outer-measure, caratheodory-measurable-sigma-algebra, caratheodory-sets-
;;; membership, caratheodory-prefix-split, esum-nn-le-termwise, esum-nn-le-of-prefixes, esum-in,
;;; dom-of-fun, rps-prefix-type, eplus-le-left, rr-pos-star-le-trans, rr-pos-star-le-antisymm,
;;; power-inter-closed, power-fun-union-closed, power-mem-*, subset-mem-fwd, seg-mem-lt,
;;; ord-segment-nn-subset, rr-lt-irrefl, fun-domain-extensionality (through dk-fun-ext!).
;;; LOAD WINDOW: after theorem-library/caratheodory (3626) and outer-measure-construction
;;; (3631); no citer.
;;; Helper prefix: mbo- (the caratheodory.scm cth- kit, copied: helpers are file-local).

(define (mbo-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))

(define mbo-pw '(POWER omega))
(define mbo-C '(CARATHEODORY-SETS omega mu))
(define (mbo-seg n) (list 'ORD-SEGMENT n))
(define (mbo-useg fv kv) (list 'BIG-UNION 'uj_ (mbo-seg kv) (list fv 'uj_)))
(define (mbo-dterm fv kv) (list 'COMPLEMENT-IN (list fv kv) (mbo-useg fv kv)))
(define (mbo-fs f s) (list 'FINSUM 'RR-POS-STAR-ADD-MONOID f s))

(define (mbo-om-parts!)
  (let* ((iff (dk-cite! 'is-outer-measure 'omega 'mu))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (map (lambda (c) (dk-project! c 'IS-OUTER-MEASURE '(IS-OUTER-MEASURE omega mu))) cs)))

(define (mbo-mu-type! x)
  (if (not (dk-asm? (list 'IN (list 'mu x) 'RR-POS-STAR)))
      (fact 'fun-apply-type-c 'mu mbo-pw 'RR-POS-STAR x)))

(define (mbo-pow-sub! x y)
  (if (not (dk-asm? (list 'IN x mbo-pw)))
      (begin
        (fact 'power-mem-sethood 'omega y)
        (fact 'subclass-of-set-is-set x y)
        (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ x) (list 'IN 'z_ 'omega)))
          (lambda ()
            (let ((zv (dk-di-var!)))
              (fact 'subset-mem-fwd x y zv)
              (fact 'power-mem-in 'omega y zv)
              (ass))))
        (fact 'power-mem-intro 'omega x))))

(define (mbo-and2! p q)
  (if (not (dk-asm? (list 'AND p q)))
      (dk-have! (list 'AND p q) (lambda () (dk-conj-close! dk-ass!)))))

(define (mbo-antisymm! x y)
  (mbo-and2! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR))
  (mbo-and2! (list '<= x y) (list '<= y x))
  (fact 'rr-pos-star-le-antisymm x y))

(define (mbo-trans! x y z)
  (dk-have! (list 'AND (list 'IN x 'RR-POS-STAR)
                  (list 'AND (list 'IN y 'RR-POS-STAR) (list 'IN z 'RR-POS-STAR)))
            (lambda () (dk-conj-close! dk-ass!)))
  (mbo-and2! (list '<= x y) (list '<= y z))
  (fact 'rr-pos-star-le-trans x y z))

(define (mbo-in-C! x)
  (if (not (dk-asm? (list 'IN x mbo-pw)))
      (let* ((iff (dk-fact! 'caratheodory-sets-membership 'omega 'mu x))
             (a (cadr iff)) (b (caddr iff)))
        (ai iff)
        (detach! (list 'IMPLIES a b))
        (dk-split-all! (list (dk-ctx-form b))))))

(define (mbo-fk! fv kv . av)
  (let* ((fk (list fv kv)) (uk (mbo-useg fv kv)) (dk (mbo-dterm fv kv)))
    (if (not (dk-asm? (list 'IN fk mbo-C)))
        (fact 'fun-apply-type-c fv 'NN mbo-C kv))
    (mbo-in-C! fk)
    (if (not (dk-asm? (list 'SUBSET dk fk)))
        (fact 'complement-in-subset uk fk))
    (mbo-pow-sub! dk fk)
    (if (pair? av)
        (let ((ik (list 'INTERSECTION (car av) dk)))
          (if (not (dk-asm? (list 'IN ik mbo-pw)))
              (fact 'power-inter-closed 'omega (car av) dk))
          (mbo-mu-type! ik)))))

(define (mbo-sseq fv av)
  (list 'VNB-LAMBDA 'ck_ 'NN
        (list 'mu (list 'INTERSECTION av
                        (list 'COMPLEMENT-IN (list fv 'ck_)
                              (list 'BIG-UNION 'uj_ '(ORD-SEGMENT ck_) (list fv 'uj_)))))))
(define (mbo-sseq-type! fv av)
  (let ((sq (mbo-sseq fv av)))
    (if (not (dk-asm? (list 'IN sq '(FUN NN RR-POS-STAR))))
        (dk-have! (list 'IN sq '(FUN NN RR-POS-STAR))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((kv (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                  (mbo-fk! fv kv av)
                  (dk-ass!)))))))
    sq))

(define (mbo-dom! fv)
  (fact 'nn-is-set)
  (dk-project! (list 'IN fv '(FUN NN)) 'fun-codomain-iff (list 'IN fv '(FUN NN RR-POS-STAR)))
  (mbo-and2! (list 'IN fv '(FUN NN)) '(IN NN SET))
  (fact 'dom-of-fun 'NN fv)
  (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN (list 'DOM fv) 'SET)
                                          (list '= (list 'DOM fv) 'NN)))))
  (dk-have! (list 'IN fv (list 'FUN (list 'DOM fv) 'RR-POS-STAR))
            (lambda () (subst (list '= (list 'DOM fv) 'NN)) (ass))))

(define (mbo-esum-type! fv)
  (mbo-dom! fv)
  (fact 'esum-in fv))

(define (mbo-f-pow! fv)
  (dk-project! (list 'IN fv '(FUN NN)) 'fun-codomain-iff (list 'IN fv (list 'FUN 'NN mbo-C)))
  (dk-have! (list 'IN fv (list 'FUN 'NN mbo-pw))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (eq? (car (dk-goal)) 'IN)
              (ass)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c fv 'NN mbo-C kv)
                (mbo-in-C! (list fv kv))
                (ass))))))))

;;; zv in E_k, j in ORD-SEGMENT(k), zv in E_j: contradiction (pairwise disjoint, j < k)
(define (mbo-not-in-prefix! fv kv dd zv)
  (let* ((pos (dk-landed-1 (lambda () (di))))
         (landed (dk-landed (lambda () (bu-me pos))))
         (ein (find-first (lambda (f) (and (eq? (car f) 'IN) (not (equal? (cadr f) zv)))) landed))
         (jv (cadr ein))
         (fk (list fv kv))
         (ij (list 'INTERSECTION (list fv jv) fk)))
    (fact 'ord-segment-nn-subset kv jv)
    (let ((iff (dk-fact! 'seg-mem-lt kv jv)))
      (ai iff)
      (detach! (list 'IMPLIES (cadr iff) (caddr iff))))
    (fact 'nn-in-rr kv)
    (fact 'nn-in-rr jv)
    (dk-have! (list 'NOT (list '= jv kv))
      (lambda ()
        (di)
        (dk-have! (list '< kv kv)
          (lambda () (dk-ineq! (list 'IN jv 'RR) (list 'IN kv 'RR)
                               (list '= jv kv) (list '< jv kv))))
        (fact 'rr-lt-irrefl kv)
        (ai (list 'NOT (list '< kv kv)))))
    (dk-apply! dd jv kv)
        (dk-have! (list 'IN zv ij)
      (lambda () (mac 'intersection-membership) (dk-conj-close! dk-ass!)))
    (dk-have! (list 'IN zv 'EMPTY-SET)
      (lambda () (subst (list '= 'EMPTY-SET ij)) (ass)))
    (fact 'empty-set-has-no-members zv)
    (ai (list 'NOT (list 'IN zv 'EMPTY-SET)))))

;;; A n E_k inside (A n U E) n D_k
(define (mbo-trace! av fv kv bu dd)
  (let* ((fk (list fv kv))
         (xx (list 'INTERSECTION av bu))
         (lhs (list 'INTERSECTION av fk))
         (rhs (list 'INTERSECTION xx (mbo-dterm fv kv))))
    (dk-have! (list 'SUBSET lhs rhs)
      (lambda ()
        (mac 'subset-def)
        (let ((zv (dk-di-var!)))
          (mac-h 'intersection-membership (list 'IN zv lhs))
          (dk-split-all!)
          (let close ()
            (let ((g (dk-goal)))
              (cond ((dk-ass!) #t)
                    ((and (dk-head-is? g 'IN) (dk-head-is? (caddr g) 'INTERSECTION))
                     (mac 'intersection-membership) (dk-conj-close! close))
                    ((and (dk-head-is? g 'IN) (dk-head-is? (caddr g) 'COMPLEMENT-IN))
                     (mac 'complement-in-membership) (dk-conj-close! close))
                    ((and (dk-head-is? g 'IN) (equal? (caddr g) bu))
                     (for-each (lambda (n) (dk-focus! n) (ass)) (dk-opened (lambda () (bu-mi kv)))))
                    ((dk-head-is? g 'NOT)
                     (mbo-not-in-prefix! fv kv dd zv))
                    (#t (error "mbo-trace!: unexpected leaf" (expression->string g)))))))))
    (list 'SUBSET lhs rhs)))

;;; ---------------------------------------------------------------------------
(sp (make-wff
  (forall-guarded '(omega mu ef_ ta_)
    (list '(IS-OUTER-MEASURE omega mu)
          '(IN ef_ (FUN NN (CARATHEODORY-SETS omega mu)))
          (forall-guarded '(i_ j_) '((IN i_ NN) (IN j_ NN) (NOT (= i_ j_)))
            '(= (INTERSECTION (ef_ i_) (ef_ j_)) EMPTY-SET))
          '(IN ta_ (POWER omega)))
    '(= (mu (INTERSECTION ta_ (BIG-UNION n_ NN (ef_ n_))))
        (ESUM (VNB-LAMBDA n_ NN (mu (INTERSECTION ta_ (ef_ n_)))))))))
(dk-peel!)
(let* ((parts (mbo-om-parts!))
       (mono (list-ref parts 3))
       (sub (list-ref parts 4))
       (fv 'ef_) (av 'ta_)
       (bu '(BIG-UNION n_ NN (ef_ n_)))
       (xx (list 'INTERSECTION av bu))
       (mx (list 'mu xx))
       (lm '(VNB-LAMBDA n_ NN (mu (INTERSECTION ta_ (ef_ n_)))))
       (gl '(VNB-LAMBDA gk_ NN (INTERSECTION ta_ (ef_ gk_))))
       (ug (list 'BIG-UNION 'n_ 'NN (list gl 'n_)))
       (lg (list 'VNB-LAMBDA 'n_ 'NN (list 'mu (list gl 'n_))))
       (dd (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'INTERSECTION) (dk-contains? f fv)))
                    "disjointness")))
  (fact 'caratheodory-measurable-sigma-algebra 'omega 'mu)
  (dk-project! (list 'SUBSET mbo-C mbo-pw) 'IS-SIGMA-ALGEBRA (list 'IS-SIGMA-ALGEBRA 'omega mbo-C))
  (mbo-f-pow! fv)
  (fact 'power-fun-union-closed 'omega fv)
  (fact 'power-inter-closed 'omega av bu)
  (mbo-mu-type! xx)
  ;; the summands, typed
  (dk-have! (list 'IN lm '(FUN NN RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((kv (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
            (fact 'fun-apply-type-c fv 'NN mbo-pw kv)
            (fact 'power-inter-closed 'omega av (list fv kv))
            (mbo-mu-type! (list 'INTERSECTION av (list fv kv)))
            (dk-ass!))))))
  (let ((sq (mbo-sseq-type! fv xx)))
    ;; (>=)  sum mu(A n E_k) <= sum mu((A n U E) n D_k) <= mu(A n U E)
    (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list lm 'k) (list sq 'k))))
      (lambda ()
        (let* ((kv (dk-di-var!))
               (fk (list fv kv))
               (ak (list 'INTERSECTION av fk))
               (ik (list 'INTERSECTION xx (mbo-dterm fv kv))))
          (mbo-fk! fv kv xx)
          (fact 'fun-apply-type-c fv 'NN mbo-pw kv)
          (fact 'power-inter-closed 'omega av fk)
          (mbo-mu-type! ak)
          (dk-lam-b!)
          (mbo-trace! av fv kv bu dd)
          (dk-apply! mono ak ik)
          (dk-ass!))))

    (fact 'esum-nn-le-termwise lm sq)
    (dk-have! (list 'FORALL 'mpn_ (list 'IMPLIES '(IN mpn_ NN) (list '<= (mbo-fs sq '(ORD-SEGMENT mpn_)) mx)))
      (lambda ()
        (let* ((nv (dk-di-var!))
               (pn (mbo-fs sq (mbo-seg nv)))
               (un (mbo-useg fv nv))
               (cun (list 'COMPLEMENT-IN xx un))
               (mcun (list 'mu cun)))
          (fact 'caratheodory-prefix-split nv 'omega 'mu fv xx)
                    (fact 'rps-prefix-type sq nv)
                    (fact 'complement-in-subset un xx)
                    (mbo-pow-sub! cun xx)
                    (mbo-mu-type! cun)
          (mbo-and2! (list 'IN pn 'RR-POS-STAR) (list 'IN mcun 'RR-POS-STAR))
          (fact 'eplus-le-left pn mcun)
          (subst (list '= mx (list 'eplus pn mcun)))
          (ass))))
    (fact 'esum-nn-le-of-prefixes sq mx)
    (mbo-esum-type! lm)
    (mbo-esum-type! sq)
    (mbo-trans! (list 'ESUM lm) (list 'ESUM sq) mx))
  ;; (<=)  mu(A n U E) <= mu(U (A n E_k)) <= sum mu(A n E_k)
  (dk-have! (list 'IN gl (list 'FUN 'NN mbo-pw))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((kv (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
            (fact 'fun-apply-type-c fv 'NN mbo-pw kv)
            (fact 'power-inter-closed 'omega av (list fv kv))
            (dk-ass!))))))
  (fact 'power-fun-union-closed 'omega gl)
  (mbo-mu-type! ug)
  (dk-have! (list 'SUBSET xx ug)
    (lambda ()
      (mac 'subset-def)
      (let ((wv (dk-di-var!)))
        (mac-h 'intersection-membership (list 'IN wv xx))
        (dk-split-all!)
        (let* ((landed (dk-landed (lambda () (bu-me (list 'IN wv bu)))))
               (ein (find-first (lambda (f) (and (eq? (car f) 'IN) (not (equal? (cadr f) wv)))) landed))
               (e (cadr ein)))
          (fact 'fun-apply-type-c fv 'NN mbo-pw e)
          (fact 'power-inter-closed 'omega av (list fv e))
          (fact 'membership-implies-sethood (list 'INTERSECTION av (list fv e)) mbo-pw)
          (for-each (lambda (n)
                      (dk-focus! n)
                      (if (not (dk-ass!))
                          (begin (dk-lam-b!)
                                 (if (not (dk-ass!))
                                     (begin (mac 'intersection-membership) (dk-conj-close! dk-ass!))))))
                    (dk-opened (lambda () (bu-mi e))))))))
  (dk-apply! mono xx ug)
  (let ((le (dk-apply! sub gl)))
    (dk-fun-ext! lg lm 'NN 'RR-POS-STAR
      (lambda () (dk-lam-type! (lambda ()
        (let ((kv (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
          (fact 'fun-apply-type-c gl 'NN mbo-pw kv)
          (mbo-mu-type! (list gl kv))
          (dk-ass!)))))
      (lambda () (dk-ass!))
      (lambda (kv)
        (fact 'fun-apply-type-c fv 'NN mbo-pw kv)
        (fact 'power-inter-closed 'omega av (list fv kv))
        (mbo-mu-type! (list 'INTERSECTION av (list fv kv)))
        (dk-lam-b!)
        (if (not (dk-ass!)) (rfl))))
    (let ((le2 (dk-rewrite-h! le lg lm)))
      (mbo-trans! mx (list 'mu ug) (list 'ESUM lm))))
  (mbo-antisymm! mx (list 'ESUM lm))
  (dk-ass!))
(mbo-qed! 'outer-measure-disjoint-additive)

;;; ===========================================================================
;;; Prop. 4.13: for the method-I outer measure of a measure rho, measurability may be tested
;;; on the sets A of cA with rho(A) finite.

(define mbo-out '(METHOD-I-OUTER omega cA rho))
(define (mbo-o x) (list mbo-out x))

;;; (IN X (POWER omega)) from (SUBSET X Y), Y in POWER (copy of mbo-pow-sub! for any X)
;;; (IN (OUT X) RR-POS-STAR) with X in POWER(omega)
(define (mbo-o-type! x)
  (if (not (dk-asm? (list 'IN (mbo-o x) 'RR-POS-STAR)))
      (fact 'fun-apply-type-c mbo-out mbo-pw 'RR-POS-STAR x)))

;;; the parts of IS-OUTER-MEASURE(omega, OUT)
(define (mbo-out-parts!)
  (let* ((h (list 'IS-OUTER-MEASURE 'omega mbo-out))
         (iff (dk-cite! 'is-outer-measure 'omega mbo-out))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (map (lambda (c) (dk-project! c 'IS-OUTER-MEASURE h)) cs)))

(define (mbo-subset-prop! x y memb!)
  (dk-have! (list 'SUBSET x y)
    (lambda ()
      (mac 'subset-def)
      (let ((w (dk-di-var!)))
        (memb! w)
        (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop))))))

(sp (make-wff '(FORALL omega (FORALL cA (FORALL rho (FORALL es
  (IMPLIES (IS-MEASURE omega cA rho)
    (IMPLIES (SUBSET es omega)
      (IFF (IS-CARATHEODORY-MEASURABLE omega (METHOD-I-OUTER omega cA rho) es)
           (FORALL ta_ (IMPLIES (IN ta_ cA) (IMPLIES (IN (rho ta_) RR)
             (<= (eplus ((METHOD-I-OUTER omega cA rho) (INTERSECTION ta_ es))
                        ((METHOD-I-OUTER omega cA rho) (COMPLEMENT-IN ta_ es)))
                 (rho ta_))))))))))))))
(dk-peel!)
(let* ((iff (dk-fact! 'is-measure 'omega 'cA 'rho))
       (rhs (caddr iff)))
  (dk-project! (cadr rhs) 'IS-MEASURE '(IS-MEASURE omega cA rho)))
(dk-cite! 'sigma-algebra-ambient-set 'omega 'cA)
(dk-project! '(SUBSET cA (POWER omega)) 'IS-SIGMA-ALGEBRA '(IS-SIGMA-ALGEBRA omega cA))
(dk-cite! 'measure-is-premeasure 'omega 'cA 'rho)
(dk-cite! 'method-i-outer-is-outer-measure 'omega 'cA 'rho)
(dk-cite! 'method-i-outer-type 'omega 'cA 'rho)
(dk-cite! 'subclass-of-set-is-set 'es 'omega)
(let ((s (caddr (dk-cite! 'subset-def 'es 'omega))))
  (dk-have! s (lambda () (mac-h 'subset-def '(SUBSET es omega)) (ass))))
(dk-cite! 'power-mem-intro 'omega 'es)
(define mbo-om (mbo-out-parts!))
(define mbo-omono (list-ref mbo-om 3))
;;; for X in POWER(omega): land X n es, X \ es in POWER and their outer measures typed
(define (mbo-pieces! x)
  (let ((xi (list 'INTERSECTION x 'es)) (xc (list 'COMPLEMENT-IN x 'es)))
    (if (not (dk-asm? (list 'IN xi mbo-pw))) (fact 'power-inter-closed 'omega x 'es))
    (if (not (dk-asm? (list 'SUBSET xc x))) (fact 'complement-in-subset 'es x))
    (mbo-pow-sub! xc x)
    (mbo-o-type! xi)
    (mbo-o-type! xc)
    (mbo-and2! (list 'IN (mbo-o xi) 'RR-POS-STAR) (list 'IN (mbo-o xc) 'RR-POS-STAR))
    (if (not (dk-asm? (list 'IN (list 'eplus (mbo-o xi) (mbo-o xc)) 'RR-POS-STAR)))
        (fact 'eplus-closed (mbo-o xi) (mbo-o xc)))
    (list 'eplus (mbo-o xi) (mbo-o xc))))
(dk-iff! (lambda (g) (or (dk-head-is? g 'FORALL)
                         (and (dk-head-is? g 'IMPLIES) (dk-head-is? (cadr g) 'IS-CARATHEODORY-MEASURABLE))))
  ;; necessity: the Caratheodory equation at A, and mu*(A) = rho(A)
  (lambda ()
    (dk-peel!)
    (let* ((a (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'cA) (symbol? (cadr f))))
                             "the test set")))
           (m (dk-pick (lambda (f) (dk-head-is? f 'IS-CARATHEODORY-MEASURABLE)) "measurability"))
           (dif (list 'DIFFERENCE a 'es))
           (eqn (list '= (mbo-o a) (list 'eplus (mbo-o (list 'INTERSECTION a 'es)) (mbo-o dif)))))
      (fact 'subset-mem-fwd 'cA mbo-pw a)
      (dk-have! eqn
        (lambda ()
          (mac-h 'IS-CARATHEODORY-MEASURABLE m)
          (dk-split-all!)
          (inst*! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'eplus))) "the clause") a)
          (dk-ass!)))
      (fact 'difference-unfold a 'es)
      (let* ((s (mbo-pieces! a))
             (e1 (dk-rewrite-h! eqn dif (list 'COMPLEMENT-IN a 'es))))
        (dk-cite! 'method-i-outer-extends 'omega 'cA 'rho a)
        (let ((e2 (dk-rewrite-h! (list '= (mbo-o a) s) (mbo-o a) (list 'rho a))))
          (subst (list '= (list 'rho a) s))
          (fact 'rr-pos-star-le-refl s)
          (dk-ass!)))))
  ;; sufficiency
  (lambda ()
    (dk-peel!)
    (let ((crit (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'eplus))) "the criterion"))
          (clause '(FORALL a_ (IMPLIES (IN a_ (POWER omega))
                     (<= (eplus ((METHOD-I-OUTER omega cA rho) (INTERSECTION a_ es))
                                ((METHOD-I-OUTER omega cA rho) (DIFFERENCE a_ es)))
                         ((METHOD-I-OUTER omega cA rho) a_))))))
      (dk-have! clause
        (lambda ()
          (let* ((b (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
                 (ob (mbo-o b)))
            (fact 'difference-unfold b 'es)
            (subst (list '== (list 'DIFFERENCE b 'es) (list 'COMPLEMENT-IN b 'es)))
            (mbo-o-type! b)
            (let ((s (mbo-pieces! b)))
              (use-em (list 'IN ob 'RR)
                (lambda ()
                  (let* ((ex (dk-cite! 'method-i-outer-attained 'omega 'cA 'rho b))
                         (z (dk-skolem! ex #t)))
                    (dk-rewrite-h! (list 'IN ob 'RR) ob (list 'rho z))
                    (inst*! crit z)
                    (fact 'subset-mem-fwd 'cA mbo-pw z)
                    (let ((sz (mbo-pieces! z)))
                      (mbo-subset-prop! (list 'INTERSECTION b 'es) (list 'INTERSECTION z 'es)
                        (lambda (w) (dk-cite! 'intersection-membership b 'es w)
                                    (dk-cite! 'intersection-membership z 'es w)
                                    (dk-cite! 'subset-mem-fwd b z w)))
                      (mbo-subset-prop! (list 'COMPLEMENT-IN b 'es) (list 'COMPLEMENT-IN z 'es)
                        (lambda (w) (dk-cite! 'complement-in-membership b 'es w)
                                    (dk-cite! 'complement-in-membership z 'es w)
                                    (dk-cite! 'subset-mem-fwd b z w)))
                      (dk-apply! mbo-omono (list 'INTERSECTION b 'es) (list 'INTERSECTION z 'es))
                      (dk-apply! mbo-omono (list 'COMPLEMENT-IN b 'es) (list 'COMPLEMENT-IN z 'es))
                      (let ((x1 (mbo-o (list 'INTERSECTION b 'es))) (y1 (mbo-o (list 'COMPLEMENT-IN b 'es)))
                            (x2 (mbo-o (list 'INTERSECTION z 'es))) (y2 (mbo-o (list 'COMPLEMENT-IN z 'es))))
                        (dk-have! (list 'AND (list 'IN x1 'RR-POS-STAR) (list 'AND (list 'IN y1 'RR-POS-STAR)
                                        (list 'AND (list 'IN x2 'RR-POS-STAR) (list 'IN y2 'RR-POS-STAR))))
                                  (lambda () (dk-conj-close! dk-ass!)))
                        (mbo-and2! (list '<= x1 x2) (list '<= y1 y2))
                        (fact 'eplus-mono x1 y1 x2 y2))
                      (let ((le (dk-pick (lambda (f) (and (dk-head-is? f '<=) (equal? (caddr f) (list 'rho z))))
                                         "the criterion at z")))
                        (dk-rewrite-h! le (list 'rho z) ob))
                      (mbo-trans! s sz ob)
                      (dk-ass!))))
                (lambda ()
                  (let ((i (dk-cite! 'rr-pos-star-membership ob)))
                    (dk-have! (list '= ob 'POS-INF)
                      (lambda () (if (dk-only! i (list 'IN ob 'RR-POS-STAR) (list 'NOT (list 'IN ob 'RR))) (prop)))))
                  (subst (list '= ob 'POS-INF))
                  (fact 'rr-pos-star-below-pos-inf s)
                  (dk-ass!)))))))
      (dk-cite! 'caratheodory-superadditive-suffices 'omega mbo-out 'es)
      (dk-ass!))))
(mbo-qed! 'method-i-outer-measurable-iff-finite)
