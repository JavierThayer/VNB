  (dk-have! (list '= (list '* (list 'CC-EXP a) (list 'CC-EXP (list '- lw))) (list 'CC-EXP b))
    (lambda ()
      (subst (list '= (list '* (list 'CC-EXP a) (list 'CC-EXP (list '- lw))) (list 'CC-EXP (list '+ a (list '- lw)))))
      (c6t-subst-close! (list '= (list '+ a (list '- lw)) b)))))
(define (c6t-conv-univ f l)
  (list 'FORALL 'ipe_ (list 'IMPLIES '(POS-RR ipe_)
    (list 'FORSOME 'ipd_ (list 'AND '(POS-RR ipd_)
      (list 'FORSOME 'ipm_ (list 'AND '(IN ipm_ RR)
        (list 'FORALL 'ipr_ (list 'IMPLIES '(IN ipr_ RR)
          (list 'FORALL 'ipq_ (list 'IMPLIES '(IN ipq_ RR)
            (list 'IMPLIES '(< 0 ipr_)
              (list 'IMPLIES '(< ipr_ ipd_)
                (list 'IMPLIES '(< ipm_ ipq_)
                  (list 'IMPLIES '(< ipr_ ipq_)
                    (list '<= (list 'magnitude (list '- (list 'CC-INT f 'ipr_ 'ipq_) l)) 'ipe_))))))))))))))))
(define (c6t-conv-open! f l)
  (let ((c (list 'IMPROPER-INT-CONVERGES-TO f l)))
    (dk-project! (list 'IN l 'CC) (lambda () (mac-h 'IMPROPER-INT-CONVERGES-TO (dk-ctx-form c))))
    (dk-project! (c6t-conv-univ f l) (lambda () (mac-h 'IMPROPER-INT-CONVERGES-TO (dk-ctx-form c))))))
(define (c6t-conv-pick! f l d)
  (let* ((del (dk-skolem! (dk-apply! (dk-ctx-form (c6t-conv-univ f l)) d) 'top))
         (_ (dk-split-all!))
         (m (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm del))) "the M") 'top))
         (_2 (dk-split-all!))
         (cu (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm del) (dk-contains? fm m))) "the universal")))
    (fact 'rr-pos-rr-in-rr del) (fact 'rr-lt-of-pos-rr del)
    (list del m cu)))
(define c6t-tk '(* A (- (LOG (* 2 A)) 1)))
(define (c6t-tl-E x) (list 'CC-EXP (list '- c6t-tk (list '* 1/2 x))))
(define (c6t-ex k x) (list '* 2 (list 'CC-EXP (list '- k (list '* 1/2 x)))))
(define (c6t-carr-typ! lam u)                   ; (IN lam (FUN u CC)) in context: the CARR(CC-NORMED-FIELD) form
  (fact 'cc-nf-carr)
  (let ((t (list 'IN lam (list 'FUN u '(CARR CC-NORMED-FIELD)))))
    (if (not (dk-asm? t)) (dk-have! t (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (dk-ass!))))
    t))
(define (c6t-pwl-typ! c j)
  (let ((typ (list 'IN (c6t-pwl c j) (list 'FUN c6t-rhp 'CC))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda () (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                           (c6t-rhp-open! y) (c6f-cc-and-closed! 'cc-mul-closed y c) (c6-cc! (list '- 1 (list '* y c)))
                           (c6-and! (list 'IN (list '- 1 (list '* y c)) 'CC) (list 'IN j 'NN)) (fact 'power-typing-nonneg (list '- 1 (list '* y c)) j)
                           (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
              (lambda () (fact 'cc-is-set) (fact 'subclass-of-set-is-set c6t-rhp 'CC) (dk-ass!))))))
    typ))
(sp (make-wff (list 'FORALL 'c6tk_ (list 'IMPLIES '(IN c6tk_ NN) (list 'FORALL 'c6tc_ (list 'IMPLIES '(IN c6tc_ CC)
  (list 'FORALL 'c6ta_ (list 'IMPLIES (list 'IN 'c6ta_ c6t-rhp)
    (list 'IS-DIFF-ON 'CC-NORMED-FIELD c6t-rhp (c6t-pwl 'c6tc_ '(succ c6tk_)) 'c6ta_
          '(* (* (succ c6tk_) (power (- 1 (* c6ta_ c6tc_)) c6tk_)) (- c6tc_)))))))))))
(define (c6t-dp-setup! c a)
  (c6w-cc-setup!) (fact 'right-half-plane-open) (fact 'cc-open-subset-cc c6t-rhp) (fact 'cc-is-set)
  (fact 'subclass-of-set-is-set c6t-rhp 'CC) (c6t-rhp-open! a)
  (c6f-cc-and-closed! 'cc-mul-closed a c) (c6-cc! (list '- 1 (list '* a c))) (c6-cc! (list '- c)))
(ni)
(c6w-induct-on! 'c6tk_
  (lambda ()
    (let* ((new (c6-steps!)) (c (c6-var new 'CC)) (a (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) c6t-rhp))) new)))
           (l0 (list 'VNB-LAMBDA 'c6tw_ c6t-rhp (list '- 1 (list '* 'c6tw_ c)))) (b (list '- 1 (list '* a c))))
      (c6t-dp-setup! c a) (fact 'nn-zero-in) (fact 'nn-one-in) (c6g-one!)
      (let* ((r (dk-diff! c6t-rhp l0 a)) (d (list-ref r 5)))
        (c6t-pwl-typ! c '(succ 0))
        (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ c6t-rhp) (list '== (list (c6t-pwl c '(succ 0)) 'hbx_) (list l0 'hbx_))))
          (lambda () (let* ((y (dk-di-var!)) (by (list '- 1 (list '* y c))))
                       (c6t-rhp-open! y) (c6f-cc-and-closed! 'cc-mul-closed y c) (c6-cc! by)
                       (dk-lam-b!)
                       (c6-and! (list 'IN by 'CC) '(IN 0 NN)) (subst (dk-fact! 'power-succ by 0)) (subst (dk-fact! 'power-zero by))
                       (c6-cc! (list '* by 1)) (dk-have! (list '= (list '* by 1) by) (lambda () (crs))) (subst (list '= (list '* by 1) by))
                       (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
        (c6t-carr-typ! (c6t-pwl c '(succ 0)) c6t-rhp) (c6-cite! 'diff-on-transfer-ptwise-eq 'CC-NORMED-FIELD c6t-rhp (c6t-pwl c '(succ 0)) l0 a d)
        (c6-and! (list 'IN b 'CC) '(IN 0 NN)) (fact 'power-typing-nonneg b 0)
        (c6-cc! d)
        (let ((tg (list '* (list '* '(succ 0) (list 'power b 0)) (list '- c))))
          (dk-have! (list '= tg d) (lambda () (subst (dk-fact! 'power-zero b)) (subst '(= (succ 0) 1)) (crs)))
          (subst (list '= tg d))
          (dk-close-if! (lambda () #t) (lambda () (dk-ass!)))))))
  (lambda ()
    (let* ((new (c6-steps!)) (k (c6-var new 'NN)) (c (c6-var new 'CC))
           (a (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) c6t-rhp))) new)))
           (ih (find-first (lambda (q) (c6-op? q 'FORALL 3)) new))
           (sk (list 'succ k)) (ssk (list 'succ sk)) (b (list '- 1 (list '* a c))))
      (c6t-dp-setup! c a) (fact 'nn-succ-closed k) (fact 'nn-succ-closed sk) (c6-nn! k) (c6-nn! sk) (c6-nn! ssk)
      (fact 'nn-succ-plus-one k) (fact 'nn-succ-plus-one sk)
      (c6t-pwl-typ! c sk) (c6t-pwl-typ! c ssk)
      (let* ((ihe (dk-apply! ih c a))
             (pk (dk-name! (c6t-pwl c sk) (list 'FUN c6t-rhp 'CC)))
             (ihp (dk-rewrite-h! ihe (c6t-pwl c sk) pk))
             (q (list 'VNB-LAMBDA 'c6tw_ c6t-rhp (list '* (list '- 1 (list '* 'c6tw_ c)) (list pk 'c6tw_))))
             (r (dk-diff! c6t-rhp q a)) (d (list-ref r 5)))
        (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ c6t-rhp) (list '== (list (c6t-pwl c ssk) 'hbx_) (list q 'hbx_))))
          (lambda () (let* ((y (dk-di-var!)) (by (list '- 1 (list '* y c))))
                       (c6t-rhp-open! y) (c6f-cc-and-closed! 'cc-mul-closed y c) (c6-cc! by)
                       (fact 'fun-apply-type-c pk c6t-rhp 'CC y)
                       (dk-lam-b!)
                       (subst (list '= pk (c6t-pwl c sk)))
                       (dk-lam-b!)
                       (c6-and! (list 'IN by 'CC) (list 'IN sk 'NN)) (subst (dk-fact! 'power-succ by sk))
                       (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
        (c6t-carr-typ! (c6t-pwl c ssk) c6t-rhp) (c6-cite! 'diff-on-transfer-ptwise-eq 'CC-NORMED-FIELD c6t-rhp (c6t-pwl c ssk) q a d)
        ;; the derivative: d = -c pk(a) + b ((k+1) b^k (-c)) (in some arrangement), target (k+2) b^(k+1) (-c)
        (fact 'fun-apply-type-c pk c6t-rhp 'CC a)
        (c6-and! (list 'IN b 'CC) (list 'IN k 'NN)) (fact 'power-typing-nonneg b k)
        (c6-and! (list 'IN b 'CC) (list 'IN sk 'NN)) (fact 'power-typing-nonneg b sk)
        (c6-cc! d)
        (let* ((pa (list '= (list pk a) (list 'power b sk)))
               (tg (list '* (list '* ssk (list 'power b sk)) (list '- c))))
          (dk-have! pa (lambda () (subst (list '= pk (c6t-pwl c sk))) (dk-lam-b!) (c6f-rfl-close!)))
          (dk-have! (list '= tg d)
            (lambda ()
              (subst pa)
              (subst (dk-fact! 'power-succ b k))
              (let ((pv (dk-name! (list 'power b k) 'CC)) (sv (dk-name! sk 'RR)))
                (subst (list '= (list 'power b k) pv))
                (subst (list '= ssk (list '+ sk 1)))
                (subst (list '= sk sv))
                (crs))))
          (subst (list '= tg d))
          (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))))))
(qed 'power-lin-diff-on-rhp)

;;; (1 - w c)^k is holomorphic on the half-plane
(sp (make-wff (list 'FORALL 'c6tk_ (list 'IMPLIES '(IN c6tk_ NN) (list 'FORALL 'c6tc_ (list 'IMPLIES '(IN c6tc_ CC)
  (list 'HOLOMORPHIC-ON c6t-rhp (c6t-pwl 'c6tc_ 'c6tk_))))))))
(let* ((new (c6-steps!)) (k (c6-var new 'NN)) (c (c6-var new 'CC)))
  (c6w-cc-setup!) (fact 'right-half-plane-open) (fact 'cc-open-subset-cc c6t-rhp) (fact 'cc-is-set) (fact 'subclass-of-set-is-set c6t-rhp 'CC)
  (use-em (list '= k 0)
    (lambda () (subst (list '= k 0))
               (let ((one (list 'VNB-LAMBDA 'c6tw_ c6t-rhp 1)))
                 (dk-have! (list 'HOLOMORPHIC-ON c6t-rhp one) (lambda () (dk-holomorphic! c6t-rhp one)))
                 (fact 'nn-zero-in) (c6t-pwl-typ! c 0)
                 (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ c6t-rhp) (list '== (list (c6t-pwl c 0) 'hbx_) (list one 'hbx_))))
                   (lambda () (let* ((y (dk-di-var!)) (by (list '- 1 (list '* y c))))
                                (c6t-rhp-open! y) (c6f-cc-and-closed! 'cc-mul-closed y c) (c6-cc! by)
                                (dk-lam-b!) (subst (dk-fact! 'power-zero by)) (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
                 (c6-cite! 'holomorphic-transfer-ptwise-eq c6t-rhp (c6t-pwl c 0) one)
                 (dk-close-if! (lambda () #t) (lambda () (dk-ass!)))))
    (lambda ()
      (let* ((zs (c6-cite! 'nn-zero-or-succ k)) (ex (caddr zs)))
        (dk-have! ex (lambda () (keep zs (list 'NOT (list '= k 0))) (prop)))
        (let* ((j (c6-sk! ex)))
          (subst (list '= k (list 'succ j)))
          (fact 'nn-succ-closed j)
          (c6t-pwl-typ! c (list 'succ j))
          (mac 'HOLOMORPHIC-ON)
          (dk-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal)) (dk-ass!)
                (let* ((a (dk-di-var!)))
                  (c6t-rhp-open! a) (c6t-cc! (list '* (list '* (list 'succ j) (list 'power (list '- 1 (list '* a c)) j)) (list '- c)))
                  (ew (list '* (list '* (list 'succ j) (list 'power (list '- 1 (list '* a c)) j)) (list '- c)))
                  (c6-cite! 'power-lin-diff-on-rhp j c a)
                  (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))))))))))
(define (c6t-dump!) (for-each (lambda (l) (display ";; C6TL ") (display (expression->string (dk-goal-of l))) (newline)) (dk-open-leaves)))
(qed 'power-lin-holomorphic-rhp)

;;; the truncated integrand F(z, k)(w) = (1 - w/m)^k w^(z-1) on the half-plane, and the primitive pieces
(define (c6t-F z k mm) (list 'VNB-LAMBDA 'c6tw_ c6t-rhp (list '* (list 'power (list '- 1 (list '* 'c6tw_ (list 'recip mm))) k)
                                                           (list 'CC-EXP (list '* (list '- z 1) '(CC-LOG c6tw_))))))
(define (c6t-Fv z k mm w) (list '* (list 'power (list '- 1 (list '* w (list 'recip mm))) k) (list 'CC-EXP (list '* (list '- z 1) (list 'CC-LOG w)))))
(define (c6t-pt! w)                              ; w in RHP: CC-LOG w typed, slit facts
  (c6t-rhp-open! w) (c6t-cite-split! 'right-half-plane-in-slit w) (c6t-cite-split! 'cc-log-in-slit w))
(define (c6t-Fval! z k mm w)                     ; F(z,k)(w) = its body, F(z,k)(w) in CC
  (let ((e (list '= (list (c6t-F z k mm) w) (c6t-Fv z k mm w))))
    (c6t-pt! w) (c6t-cc! (c6t-Fv z k mm w))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (dk-lam-b!) (c6f-rfl-close!))))
    e))
(define (c6t-F-hol! z k mm)                      ; HOLOMORPHIC-ON(RHP, F(z,k)), F in FUN(RHP, CC), continuity
  (let* ((c (list 'recip mm)) (ff (c6t-F z k mm)) (h (list 'HOLOMORPHIC-ON c6t-rhp ff)))
    (if (not (dk-asm? h))
        (begin
          (c6t-rhp-setup!)
          (c6-cite! 'power-lin-holomorphic-rhp k c)
          (c6t-pwl-typ! c k)
          (let* ((pn (dk-name! (c6t-pwl c k) (list 'FUN c6t-rhp 'CC)))
                 (hp (dk-rewrite-h! (list 'HOLOMORPHIC-ON c6t-rhp (c6t-pwl c k)) (c6t-pwl c k) pn))
                 (f2 (list 'VNB-LAMBDA 'c6tw_ c6t-rhp (list '* (list pn 'c6tw_) (list 'CC-EXP (list '* (list '- z 1) '(CC-LOG c6tw_)))))))
            (c6t-cc! (list '- z 1))
            (dk-have! (list 'HOLOMORPHIC-ON c6t-rhp f2) (lambda () (dk-holomorphic! c6t-rhp f2)))
            (dk-have! (list 'IN ff (list 'FUN c6t-rhp 'CC))
              (lambda () (dk-lam-type!
                           (lambda () (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                        (c6t-pt! y) (c6t-cc! (c6t-Fv z k mm y))
                                        (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
                           (lambda () (fact 'cc-is-set) (fact 'subclass-of-set-is-set c6t-rhp 'CC) (dk-ass!)))))
            (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ c6t-rhp) (list '== (list ff 'hbx_) (list f2 'hbx_))))
              (lambda () (let ((y (dk-di-var!)))
                           (c6t-pt! y) (fact 'fun-apply-type-c pn c6t-rhp 'CC y) (c6t-cc! (c6t-Fv z k mm y))
                           (dk-lam-b!)
                           (subst (list '= pn (c6t-pwl c k)))
                           (dk-lam-b!)
                           (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
            (c6-cite! 'holomorphic-transfer-ptwise-eq c6t-rhp ff f2))))
    (dk-project! (list 'IN ff (list 'FUN c6t-rhp 'CC)) (lambda () (mac-h 'HOLOMORPHIC-ON (dk-ctx-form h))))
    (fact 'holomorphic-on-continuous c6t-rhp ff)
    h))
(define (c6t-mm-setup! mm z)                     ; mm > 0 real, z in CC, 0 < re z
  (c6w-cc-setup!) (c6t-rhp-setup!)
  (fact 'rr-pos-ne-zero mm) (c6t-rr! (list 'recip mm)) (fact 'rr-recip-pos mm) (fact 'rr-subset-cc (list 'recip mm))
  (c6t-rr! (list 'real-part z))
  (dk-have! (list 'NOT (list '= z 0))
    (lambda () (di) (c6t-re-im-real! 0) (dk-have! (list '= (list 'real-part z) 0) (lambda () (subst (list '= z 0)) (dk-ass!)))
                    (dk-absurd! (list '< 0 (list 'real-part z)) (list '= (list 'real-part z) 0))))
  (c6t-cc! (list 'recip z)) (fact 'cc-recip-inverse z))

;;; THE BASE INTEGRAL: int_r^m w^(z-1) dw = m^z / z - r^z / z
(define (c6t-G z) (list 'VNB-LAMBDA 'c6tw_ c6t-rhp (list '* (list 'CC-EXP (list '* z '(CC-LOG c6tw_))) (list 'recip z))))
(define (c6t-Gv z t) (list '* (list 'CC-EXP (list '* z (list 'LOG t))) (list 'recip z)))
(define (c6t-Gval! z t)                          ; t > 0 real: G(t) = e^(z log t) / z
  (let ((e (list '= (list (c6t-G z) t) (c6t-Gv z t))))
    (c6t-pos-in-rhp! t) (fact 'log-in-rr t) (fact 'rr-subset-cc (list 'LOG t)) (c6t-cc! (c6t-Gv z t))
    (if (not (dk-asm? e))
        (dk-have! e (lambda () (dk-lam-b!) (fact 'cc-log-real t) (c6t-subst-close! (list '= (list 'CC-LOG t) (list 'LOG t))))))
    e))
(define (c6t-G-diff! z)                          ; G holomorphic, G' = F(z,0) pointwise (as IS-DIFF-ON universal)
  (let ((g (c6t-G z)))
    (c6t-holo-setup! g)
    (dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES (list 'IN 'hbz_ c6t-rhp)
                (list 'IS-DIFF-ON 'CC-NORMED-FIELD c6t-rhp g 'hbz_ (list (c6t-F z 0 'c6tm_) 'hbz_))))
      (lambda ()
        (let* ((w (dk-di-var!)) (r (dk-diff! c6t-rhp g w)) (ls (list-ref r 5))
               (lw (c6t-log-at! w)) (e (list 'CC-EXP (list '* z lw))) (tgt (list 'CC-EXP (list '* (list '- z 1) lw))))
          (c6t-cc! e) (c6t-cc! tgt)
          (c6t-exp-shift! (list '* z lw) lw (list '* (list '- z 1) lw))
          (c6t-Fval! z 0 'c6tm_ w)
          (c6-cc! ls)
          (let ((b (list '- 1 (list '* w '(recip c6tm_)))))
            (c6t-cc! b) (c6-and! (list 'IN b 'CC) '(IN 0 NN)) (fact 'power-typing-nonneg b 0)
            (dk-have! (list '= (list (c6t-F z 0 'c6tm_) w) ls)
              (lambda ()
                (subst (c6t-Fval! z 0 'c6tm_ w))
                (subst (dk-fact! 'power-zero b))
                (subst (list '= tgt (list '* e (list 'CC-EXP (list '- lw)))))
                (subst (list '= (list 'CC-EXP (list '- lw)) (list 'recip w)))
                (let* ((ev (dk-name! e 'CC)) (rw (dk-name! (list 'recip w) 'CC)) (rz (dk-name! (list 'recip z) 'CC)))
                  (dk-rewrite-h! (list '= (list '* z (list 'recip z)) 1) (list 'recip z) rz)
                  (subst (list '= e ev)) (subst (list '= (list 'recip w) rw)) (subst (list '= (list 'recip z) rz))
                  (let ((g1 (dk-goal)))
                    (dk-have! (list '= (caddr g1) (list '* (list '* ev rw) (list '* z rz))) (lambda () (crs)))
                    (subst (list '= (caddr g1) (list '* (list '* ev rw) (list '* z rz))))
                    (subst (list '= (list '* z rz) 1))
                    (crs))))))
          (subst (list '= (list (c6t-F z 0 'c6tm_) w) ls))
          (dk-ass!))))))
(sp (make-wff (list 'FORALL 'c6tm_ (list 'IMPLIES '(IN c6tm_ RR) (list 'IMPLIES '(< 0 c6tm_)
  (list 'FORALL 'c6tz_ (list 'IMPLIES '(IN c6tz_ CC) (list 'IMPLIES '(< 0 (real-part c6tz_))
    (list 'FORALL 'c6tr_ (list 'IMPLIES '(IN c6tr_ RR) (list 'IMPLIES '(< 0 c6tr_) (list 'IMPLIES '(< c6tr_ c6tm_)
      (list '= (list 'CC-INT (c6t-F 'c6tz_ 0 'c6tm_) 'c6tr_ 'c6tm_) (list '- (c6t-Gv 'c6tz_ 'c6tm_) (c6t-Gv 'c6tz_ 'c6tr_)))))))))))))))
(let* ((new (c6-steps!)) (z 'c6tz_) (r 'c6tr_) (mm 'c6tm_))
  (c6t-mm-setup! mm z)
  (c6t-F-hol! z 0 mm)
  (c6t-G-diff! z)
  (fact 'ccint-in-right-half-plane r mm)
  (fact 'cc-int-of-derivative c6t-rhp (c6t-F z 0 mm) (c6t-G z) r mm)
  (c6t-Gval! z r) (c6t-Gval! z mm)
  (subst (list '= (list 'CC-INT (c6t-F z 0 mm) r mm) (list '- (list (c6t-G z) mm) (list (c6t-G z) r))))
  (subst (c6t-Gval! z r)) (subst (c6t-Gval! z mm))
  (c6t-cc! (list '- (c6t-Gv z mm) (c6t-Gv z r)))
  (dk-close-if! (lambda () #t) (lambda () (c6f-rfl-close!))))
(qed 'truncated-integral-base)

;;; INTEGRATION BY PARTS: int_r^m F(z, k+1) = -H(r) + ((k+1) / (m z)) int_r^m F(z+1, k)
(define (c6t-Hv z k mm t) (list '* (list 'power (list '- 1 (list '* t (list 'recip mm))) (list 'succ k)) (c6t-Gv z t)))
(define (c6t-K z k mm) (list '* (list 'succ k) (list '* (list 'recip mm) (list 'recip z))))
(sp (make-wff (list 'FORALL 'c6tm_ (list 'IMPLIES '(IN c6tm_ RR) (list 'IMPLIES '(< 0 c6tm_)
  (list 'FORALL 'c6tk_ (list 'IMPLIES '(IN c6tk_ NN)
  (list 'FORALL 'c6tz_ (list 'IMPLIES '(IN c6tz_ CC) (list 'IMPLIES '(< 0 (real-part c6tz_))
    (list 'FORALL 'c6tr_ (list 'IMPLIES '(IN c6tr_ RR) (list 'IMPLIES '(< 0 c6tr_) (list 'IMPLIES '(< c6tr_ c6tm_)
      (list '= (list 'CC-INT (c6t-F 'c6tz_ '(succ c6tk_) 'c6tm_) 'c6tr_ 'c6tm_)
               (list '+ (list '- (c6t-Hv 'c6tz_ 'c6tk_ 'c6tm_ 'c6tr_))
                        (list '* (c6t-K 'c6tz_ 'c6tk_ 'c6tm_) (list 'CC-INT (c6t-F '(+ c6tz_ 1) 'c6tk_ 'c6tm_) 'c6tr_ 'c6tm_))))))))))))))))))
(let* ((new (c6-steps!)) (z 'c6tz_) (r 'c6tr_) (mm 'c6tm_) (k 'c6tk_) (sk '(succ c6tk_)) (z1 '(+ c6tz_ 1))
       (c (list 'recip mm)) (kk (c6t-K z k mm)) (nk (list '- kk))
       (f1 (c6t-F z sk mm)) (f2 (c6t-F z1 k mm))
       (dl (list 'VNB-LAMBDA 'c6tw_ c6t-rhp (list '+ (c6t-Fv z sk mm 'c6tw_) (list '* nk (c6t-Fv z1 k mm 'c6tw_))))))
  (c6t-mm-setup! mm z) (fact 'nn-succ-closed k) (c6-nn! k) (c6-nn! sk)
  (c6t-cc! z1) (c6t-re-im-real! 1) (fact 'cc-re-add z 1)
  (dk-have! (list '< 0 (list 'real-part z1))
    (lambda () (subst (list '= (list 'real-part z1) (list '+ (list 'real-part z) (list 'real-part 1)))) (subst '(= (real-part 1) 1))
               (dk-ineq! (list '< 0 (list 'real-part z)))))
  (c6t-cc! kk) (c6t-cc! nk)
  (c6t-F-hol! z sk mm) (c6t-F-hol! z1 k mm)
  (fact 'ccint-in-right-half-plane r mm)
  (c6t-pos-in-rhp! r) (c6t-pos-in-rhp! mm)
  (dk-cite! 'cc-int-in-cc-of-continuous c6t-rhp f1 r mm) (dk-cite! 'cc-int-in-cc-of-continuous c6t-rhp f2 r mm)
  (dk-have! (list 'IN dl (list 'FUN c6t-rhp 'CC))
    (lambda () (dk-lam-type!
                 (lambda () (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                              (c6t-pt! y) (c6t-cc! (c6t-Fv z sk mm y)) (c6t-cc! (c6t-Fv z1 k mm y))
                              (c6t-cc! (list '+ (c6t-Fv z sk mm y) (list '* nk (c6t-Fv z1 k mm y))))
                              (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
                 (lambda () (fact 'cc-is-set) (fact 'subclass-of-set-is-set c6t-rhp 'CC) (dk-ass!)))))
  ;; int dl = int f1 + nk int f2, and dl is continuous
  (dk-split-all! (list (dk-chain! (dk-cite! 'cc-int-linear-combination c6t-rhp f1 f2 r mm nk dl)
                         (list (cons (lambda (an) (dk-head-is? an 'FORALL))
                                     (lambda () (let ((w (dk-di-var!)))
                                                  (c6t-Fval! z sk mm w) (c6t-Fval! z1 k mm w)
                                                  (dk-lam-b!)
                                                  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (qrfl)))))))))
  (dk-cite! 'cc-int-in-cc-of-continuous c6t-rhp dl r mm)
  ;; the primitive H2(w) = pk(w) e^(z log w) rz, pk the power lambda named, rz = 1/z named
  (c6-cite! 'power-lin-holomorphic-rhp sk c) (c6t-pwl-typ! c sk)
  (let* ((pk (dk-name! (c6t-pwl c sk) (list 'FUN c6t-rhp 'CC)))
         (hp (dk-rewrite-h! (list 'HOLOMORPHIC-ON c6t-rhp (c6t-pwl c sk)) (c6t-pwl c sk) pk))
         (rz (dk-name! (list 'recip z) 'CC)) (cv (dk-name! c 'CC)) (sv (dk-name! sk 'CC))
         (zrz (dk-rewrite-h! (list '= (list '* z (list 'recip z)) 1) (list 'recip z) rz))
         (h2 (list 'VNB-LAMBDA 'c6tw_ c6t-rhp (list '* (list pk 'c6tw_) (list '* (list 'CC-EXP (list '* z '(CC-LOG c6tw_))) rz)))))
    (c6t-holo-setup! h2)
    (dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES (list 'IN 'hbz_ c6t-rhp) (list 'IS-DIFF-ON 'CC-NORMED-FIELD c6t-rhp h2 'hbz_ (list dl 'hbz_))))
      (lambda ()
        (let* ((w (dk-di-var!)) (b (list '- 1 (list '* w c))) (pw (list 'power b k)))
          (c6t-pt! w) (c6f-cc-and-closed! 'cc-mul-closed w c) (c6t-cc! b) (c6t-cc! pw)
          (let* ((lw (c6t-log-at! w))
                 (e (list 'CC-EXP (list '* z lw))) (e1 (list 'CC-EXP (list '* (list '- z 1) lw)))
                 (e2 (list 'CC-EXP (list '* (list '- z1 1) lw)))
                 (pv (dk-name! pw 'CC))
                 (dp (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (c6-cite! 'power-lin-diff-on-rhp k c w) (c6t-pwl c sk) pk) pw pv) c cv) sk sv))
                 (pre (begin (fact 'fun-apply-type-c pk c6t-rhp 'CC w) (c6t-cc! (list '* z lw)) (c6t-cc! e) (c6t-cc! (list '* e rz))
                             (c6t-cc! (list 'recip w)) #t))
                 (ll (list '+ (list '* (list '* (list '* sv pv) (list '- cv)) (list '* e rz))
                              (list '* (list pk w) (list '* (list '* e (list '* z (list 'recip w))) rz))))
                 (r0 (dk-diff! c6t-rhp h2 w ll)) (ls (list-ref r0 5)))
            (c6t-cc! e1) (c6t-cc! e2)
            (c6t-exp-shift! (list '* z lw) lw (list '* (list '- z 1) lw))
            (fact 'fun-apply-type-c dl c6t-rhp 'CC w)
            (dk-have! (list '= (list pk w) (list '* b pw))
              (lambda () (subst (list '= pk (c6t-pwl c sk))) (dk-lam-b!)
                         (c6-and! (list 'IN b 'CC) (list 'IN k 'NN)) (subst (dk-fact! 'power-succ b k)) (c6f-rfl-close!)))
            (dk-have! (list '= (list dl w) ls)
              (lambda ()
                (dk-lam-b!)
                (c6-and! (list 'IN b 'CC) (list 'IN k 'NN)) (subst (dk-fact! 'power-succ b k))
                (c6t-cc! (list '* (list '- z1 1) lw))
                (dk-have! (list '= (list '* (list '- z1 1) lw) (list '* z lw)) (lambda () (crs)))
                (subst (list '= (list '* (list '- z1 1) lw) (list '* z lw)))
                (subst (list '= e1 (list '* e (list 'CC-EXP (list '- lw)))))
                (subst (list '= (list 'CC-EXP (list '- lw)) (list 'recip w)))
                (subst (list '= (list pk w) (list '* b pw)))
                (let* ((ev (dk-name! e 'CC)) (rw (dk-name! (list 'recip w) 'CC)))
                  (subst (list '= e ev)) (subst (list '= (list 'recip w) rw)) (subst (list '= (list 'recip z) rz))
                  (subst (list '= pw pv)) (subst (list '= c cv)) (subst (list '= sk sv))
                  (let* ((g1 (dk-goal)) (rhs (caddr g1))
                         (bb (list '- 1 (list '* w cv)))
                         (nf (list '+ (list '* (list '- (list '* sv (list '* cv rz))) (list '* pv ev)) (list '* (list '* (list '* bb pv) (list '* ev rw)) (list '* z rz)))))
                    (dk-have! (list '= rhs nf) (lambda () (crs)))
                    (subst (list '= rhs nf))
                    (subst (list '= (list '* z rz) 1))
                    (crs)))))
            (subst (list '= (list dl w) ls))
            (dk-ass!)))))
    (fact 'cc-int-of-derivative c6t-rhp dl h2 r mm)
    ;; H2(m) = 0, H2(r) = Hv(r)
    (let* ((bm (list '- 1 (list '* mm c))) (br (list '- 1 (list '* r c))))
      (fact 'fun-apply-type-c h2 c6t-rhp 'CC mm) (fact 'fun-apply-type-c h2 c6t-rhp 'CC r)
      (c6t-cc! bm) (c6t-cc! br)
      (fact 'rr-recip-inverse mm) (c6t-rr! (list '* mm c))
      (dk-have! (list '= bm 0) (lambda () (dk-ineq! (list '= (list '* mm c) 1))))
      (c6t-cc! (c6t-Hv z k mm r))
      (dk-have! (list '= (list h2 mm) 0)
        (lambda () (dk-lam-b!) (subst (list '= pk (c6t-pwl c sk))) (dk-lam-b!)
                   (subst (list '= bm 0))
                   (c6-and! '(IN 0 CC) (list 'IN k 'NN)) (subst (dk-fact! 'power-succ 0 k))
                   (fact 'power-typing-nonneg 0 k) (fact 'cc-log-real mm) (fact 'log-in-rr mm) (fact 'rr-subset-cc (list 'LOG mm))
                   (subst (list '= (list 'CC-LOG mm) (list 'LOG mm)))
                   (c6t-cc! (c6t-Gv z mm))
                   (crs)))
      (dk-have! (list '= (list h2 r) (c6t-Hv z k mm r))
        (lambda () (dk-lam-b!) (subst (list '= pk (c6t-pwl c sk))) (dk-lam-b!)
                   (fact 'cc-log-real r) (fact 'log-in-rr r) (fact 'rr-subset-cc (list 'LOG r))
                   (subst (list '= rz (list 'recip z)))
                   (c6t-subst-close! (list '= (list 'CC-LOG r) (list 'LOG r)))))
      (let* ((i1 (list 'CC-INT f1 r mm)) (i2 (list 'CC-INT f2 r mm)) (id (list 'CC-INT dl r mm)))
        (c6t-cc! (list '* kk i2))
        (dk-have! (list '= i1 (list '- id (list '* nk i2)))
          (lambda () (subst (list '= id (list '+ i1 (list '* nk i2)))) (crs)))
        (subst (list '= i1 (list '- id (list '* nk i2))))
        (subst (list '= id (list '- (list h2 mm) (list h2 r))))
        (subst (list '= (list h2 mm) 0)) (subst (list '= (list h2 r) (c6t-Hv z k mm r)))
        (crs)))))
(qed 'truncated-integral-parts)

;;; ---------------------------------------------------------------- the boundary term at 0: |r^z / z| is small for small r
(define (c6t-pow-mag! z t)                       ; t > 0 real: |e^(z log t)| = e^(re z log t), real and positive; returns the latter
  (let* ((lt (list 'LOG t)) (w (list '* z lt)) (wr (list '* lt z)) (v (list 'CC-EXP (list '* (list 'real-part z) lt))))
    (fact 'log-in-rr t) (fact 'rr-subset-cc lt) (c6t-cc! w) (c6t-cc! wr) (c6t-rr! (list 'real-part z))
    (c6t-rr! (list '* (list 'real-part z) lt)) (c6t-cite-split! 'cc-exp-real (list '* (list 'real-part z) lt))
    (if (not (dk-asm? (list '= (list 'magnitude (list 'CC-EXP w)) v)))
        (dk-have! (list '= (list 'magnitude (list 'CC-EXP w)) v)
          (lambda ()
            (subst (c6-cite! 'cc-exp-magnitude w))
            (dk-have! (list '= w wr) (lambda () (crs)))
            (subst (list '= w wr))
            (subst (dk-fact! 'cc-re-real-mul lt z))
            (c6t-rr! (list '* lt (list 'real-part z)))
            (dk-have! (list '= (list '* lt (list 'real-part z)) (list '* (list 'real-part z) lt)) (lambda () (crs)))
            (c6t-subst-close! (list '= (list '* lt (list 'real-part z)) (list '* (list 'real-part z) lt))))))
    v))
(define (c6t-rz-mag! z)                          ; z /= 0: |1/z| * |z| = 1, both real; returns (|1/z| . |z|)
  (let* ((rz (list 'recip z)) (m1 (list 'magnitude rz)) (m2 (list 'magnitude z)))
    (c6-mag! rz) (c6-mag! z) (fact 'cc-recip-inverse z) (fact 'cc-magnitude-one)
    (c6-and! (list 'IN rz 'CC) (list 'IN z 'CC))
    (c6t-rr! (list '* m1 m2))
    (if (not (dk-asm? (list '= (list '* m1 m2) 1)))
        (dk-have! (list '= (list '* m1 m2) 1)
          (lambda () (c6-cite! 'cc-magnitude-mul rz z)
                     (subst (list '= (list '* m1 m2) (list 'magnitude (list '* rz z))))
                     (c6t-cc! (list '* rz z)) (c6t-cc! (list '* z rz))
                     (dk-have! (list '= (list '* rz z) (list '* z rz)) (lambda () (crs)))
                     (dk-have! (list '= (list '* rz z) 1) (lambda () (subst (list '= (list '* rz z) (list '* z rz))) (dk-ass!)))
                     (subst (list '= (list '* rz z) 1)) (dk-ass!))))
    (cons m1 m2)))
(sp (make-wff (list 'FORALL 'c6tz_ (list 'IMPLIES '(IN c6tz_ CC) (list 'IMPLIES '(< 0 (real-part c6tz_))
  (list 'FORALL 'c6te_ (list 'IMPLIES '(POS-RR c6te_)
    (list 'FORSOME 'c6td_ (list 'AND '(POS-RR c6td_) (list 'AND '(<= c6td_ 1)
      (list 'FORALL 'c6tr_ (list 'IMPLIES '(IN c6tr_ RR) (list 'IMPLIES '(< 0 c6tr_) (list 'IMPLIES '(< c6tr_ c6td_)
        (list '<= (list 'magnitude (c6t-Gv 'c6tz_ 'c6tr_)) 'c6te_)))))))))))))))
(let* ((new (c6-steps!)) (z 'c6tz_) (e 'c6te_) (s (list 'real-part z)))
  (fact 'rr-one-in) (fact 'rr-zero-in) (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (c6t-mm-setup! 1 z)
  (fact 'rr-pos-rr-in-rr e) (fact 'rr-lt-of-pos-rr e)
  (let* ((mz (cdr (c6t-rz-mag! z))) (mr (car (c6t-rz-mag! z))) (ez (list '* e mz)))
    (fact 'cc-magnitude-nonneg z) (fact 'cc-magnitude-nonneg (list 'recip z))
    (let ((iff (c6-cite! 'cc-magnitude-zero-iff z)))
      (dk-have! (list 'NOT (list '= mz 0)) (lambda () (keep iff (list 'NOT (list '= z 0))) (prop))))
    (dk-have! (list 'NOT (list '= 0 mz))
      (lambda () (di) (dk-have! (list '= mz 0) (lambda () (subst (list '= mz 0)) (c6f-rfl-close!))) (ai (list 'NOT (list '= mz 0)))))
    (c6-and! (list '<= 0 mz) (list 'NOT (list '= 0 mz))) (c6-cite! 'rr-le-ne-lt 0 mz)
    (c6t-rr! ez) (c6-cite! 'rr-mul-pos e mz)
    (let* ((d (dk-skolem! (dk-cite! 'rr-power-small-at-zero-plain s ez) #t))
           (bu (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q d) (dk-contains? q 'CC-EXP))) (dk-asms))))
      (fact 'rr-pos-rr-of-lt d)
      (ew d)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (dk-ass!)
            (let* ((nr (c6-steps!)) (r (c6-var nr 'RR)) (pz (list 'CC-EXP (list '* z (list 'LOG r)))))
              (dk-have! (list '<= r d) (lambda () (dk-ineq! (list '< r d))))
              (dk-apply! bu r)
              (let* ((v (c6t-pow-mag! z r)))
                (c6t-cc! pz) (c6t-cc! (list 'recip z))
                (c6-and! (list 'IN pz 'CC) (list 'IN (list 'recip z) 'CC))
                (let* ((mm1 (c6-cite! 'cc-magnitude-mul pz (list 'recip z)))
                       (k1 (begin (dk-have! (list '<= 0 mr) (lambda () (dk-ineq! (list '<= 0 (list 'magnitude (list 'recip z))))))
                                  (c6-cite! 'rr-mul-le-right v ez mr))))
                  (c6t-rr! (list '* v mr)) (c6t-rr! (list '* ez mr)) (c6t-rr! (list '* (list 'magnitude pz) mr))
                  (dk-have! (list '= (list '* ez mr) e)
                    (lambda () (dk-have! (list '= (list '* ez mr) (list '* e (list '* mr mz))) (lambda () (crs)))
                               (subst (list '= (list '* ez mr) (list '* e (list '* mr mz))))
                               (subst (list '= (list '* mr mz) 1)) (crs)))
                  (c6t-cc! (list '* pz (list 'recip z))) (c6-mag! (list '* pz (list 'recip z)))
                  (c6-ineq*! (dk-rewrite-h! mm1 (list 'magnitude pz) v) k1 (list '= (list '* ez mr) e)))))))))))
(qed 'boundary-power-small)

