;;; ---------------------------------------------------------------- the value A(z, k) = m^z / (z P_k(z)) and its recursion
(define (c6t-A z k mm) (list '* (c6t-Gv z mm) (list 'recip (c6t-pp z k))))
(sp (make-wff (list 'FORALL 'c6tk_ (list 'IMPLIES '(IN c6tk_ NN) (list 'FORALL 'c6tm_ (list 'IMPLIES '(IN c6tm_ RR) (list 'IMPLIES '(< 0 c6tm_)
