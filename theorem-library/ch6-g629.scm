    (list '= (c6t-A 'c6tz_ '(succ c6tk_) 'c6tm_) (list '* (c6t-K 'c6tz_ 'c6tk_ 'c6tm_) (c6t-A '(+ c6tz_ 1) 'c6tk_ 'c6tm_)))))))))))))
(let* ((new (c6-steps!)) (k 'c6tk_) (mm 'c6tm_) (z 'c6tz_) (sk '(succ c6tk_)) (z1 '(+ c6tz_ 1))
       (lm (list 'LOG mm)) (e (list 'CC-EXP (list '* z lm))) (e1 (list 'CC-EXP (list '* z1 lm)))
       (xx (c6t-pp z sk)) (yy (c6t-pp z1 k)))
  (c6t-mm-setup! mm z) (fact 'nn-succ-closed k) (c6-nn! k) (c6-nn! sk)
  (c6t-cc! z1) (c6t-re-im-real! 1) (c6t-and! (list 'IN z 'CC) '(IN 1 CC)) (fact 'cc-re-add z 1)
  (dk-have! (list '< 0 (list 'real-part z1))
    (lambda () (subst (list '= (list 'real-part z1) (list '+ (list 'real-part z) (list 'real-part 1)))) (subst '(= (real-part 1) 1))
               (dk-ineq! (list '< 0 (list 'real-part z)))))
  (c6t-qq-typ! z) (c6t-qq-typ! z1) (c6t-rr! (list 'real-part z1))
  (dk-cite! 'pprod-in-cc sk (c6e-qq z)) (dk-cite! 'pprod-in-cc k (c6e-qq z1))
  (c6-cite! 'pprod-qq-nonzero sk z) (c6-cite! 'pprod-qq-nonzero k z1)
  (c6t-cc! (list 'recip xx)) (c6t-cc! (list 'recip yy)) (fact 'cc-recip-inverse xx) (fact 'cc-recip-inverse yy)
  (dk-have! (list 'NOT (list '= z1 0))
    (lambda () (di) (c6t-re-im-real! 0) (dk-have! (list '= (list 'real-part z1) 0) (lambda () (subst (list '= z1 0)) (dk-ass!)))
                    (dk-absurd! (list '< 0 (list 'real-part z1)) (list '= (list 'real-part z1) 0))))
  (c6t-cc! (list 'recip z1)) (fact 'cc-recip-inverse z1)
  (fact 'log-in-rr mm) (fact 'rr-subset-cc lm) (c6t-cc! (list '* z lm)) (c6t-cc! (list '* z1 lm)) (c6t-cc! e) (c6t-cc! e1)
  (fact 'cc-exp-log-real mm) (c6t-and! (list 'IN (list '* z lm) 'CC) (list 'IN lm 'CC)) (fact 'cc-exp-add (list '* z lm) lm)
  (c6t-cc! (list 'CC-EXP lm)) (fact 'rr-subset-cc mm) (fact 'rr-recip-inverse mm)
  (let ((sh (c6-cite! 'pprod-qq-shift k z)))
    (c6t-cc! (list '+ (list '* z lm) lm))
    (dk-have! (list '= e1 (list '* e mm))
      (lambda () (dk-have! (list '= (list '* z1 lm) (list '+ (list '* z lm) lm)) (lambda () (crs)))
                 (subst (list '= (list '* z1 lm) (list '+ (list '* z lm) lm)))
                 (subst (list '= (list 'CC-EXP (list '+ (list '* z lm) lm)) (list '* e (list 'CC-EXP lm))))
                 (subst (list '= (list 'CC-EXP lm) mm)) (c6f-rfl-close!)))
    (let* ((xv (dk-name! xx 'CC)) (yv (dk-name! yy 'CC)) (rx (dk-name! (list 'recip xx) 'CC)) (ry (dk-name! (list 'recip yy) 'CC))
           (r1 (dk-name! (list 'recip z1) 'CC)) (rz (dk-name! (list 'recip z) 'CC)) (cv (dk-name! (list 'recip mm) 'CC))
           (ev (dk-name! e 'CC)) (sv (dk-name! sk 'CC))
           (h1 (dk-rewrite-h! (dk-rewrite-h! (list '= (list '* xx (list 'recip xx)) 1) (list 'recip xx) rx) xx xv))
           (h2 (dk-rewrite-h! (dk-rewrite-h! (list '= (list '* yy (list 'recip yy)) 1) (list 'recip yy) ry) yy yv))
           (h3 (dk-rewrite-h! (list '= (list '* z1 (list 'recip z1)) 1) (list 'recip z1) r1))
           (h4 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! sh xx xv) yy yv) sk sv))
           (h5 (dk-rewrite-h! (list '= (list '* mm (list 'recip mm)) 1) (list 'recip mm) cv)))
      (subst (list '= e1 (list '* e mm)))
      (subst (list '= (list 'recip xx) rx)) (subst (list '= (list 'recip yy) ry)) (subst (list '= (list 'recip z1) r1))
      (subst (list '= (list 'recip z) rz)) (subst (list '= (list 'recip mm) cv)) (subst (list '= e ev)) (subst (list '= sk sv))
      (fact 'fun-apply-type-c (c6e-qq z) 'NN 'CC 0)
      ;; rx = sv r1 ry
      (let ((q (list '* sv (list '* r1 ry))))
        (dk-have! (list '= rx q)
          (lambda ()
            (dk-have! (list '= rx (list '+ (list '* rx (list '- 1 (list '* (list '* sv xv) (list '* r1 ry)))) (list '* q (list '* xv rx))))
              (lambda () (crs)))
            (subst (list '= rx (list '+ (list '* rx (list '- 1 (list '* (list '* sv xv) (list '* r1 ry)))) (list '* q (list '* xv rx)))))
            (subst (list '= (list '* sv xv) (list '* z1 yv)))
            (dk-have! (list '= (list '* (list '* z1 yv) (list '* r1 ry)) (list '* (list '* z1 r1) (list '* yv ry))) (lambda () (crs)))
            (subst (list '= (list '* (list '* z1 yv) (list '* r1 ry)) (list '* (list '* z1 r1) (list '* yv ry))))
            (subst (list '= (list '* z1 r1) 1)) (subst (list '= (list '* yv ry) 1)) (subst (list '= (list '* xv rx) 1))
            (crs)))
        (subst (list '= rx q))
        (dk-have! (list '= (list '* mm cv) 1) (lambda () (dk-ass!)))
        (let ((g (dk-goal)))
          (dk-have! (list '= (caddr g) (list '* (cadr g) (list '* mm cv))) (lambda () (crs)))
          (subst (list '= (caddr g) (list '* (cadr g) (list '* mm cv))))
          (subst (list '= (list '* mm cv) 1))
          (crs))))))
(qed 'truncated-value-recursion)

;;; ---------------------------------------------------------------- THE LIMIT r -> 0:  int_r^m F(z, k) -> A(z, k) = m^z / (z P_k(z))
(define (c6t-lim k mm z e)
  (list 'FORSOME 'c6td_ (list 'AND '(POS-RR c6td_)
    (list 'FORALL 'c6tr_ (list 'IMPLIES '(IN c6tr_ RR) (list 'IMPLIES '(< 0 c6tr_) (list 'IMPLIES '(< c6tr_ c6td_) (list 'IMPLIES (list '< 'c6tr_ mm)
      (list '<= (list 'magnitude (list '- (list 'CC-INT (c6t-F z k mm) 'c6tr_ mm) (c6t-A z k mm))) e)))))))))
(define (c6t-z1-setup! z)                        ; z in CC, 0 < re z: z + 1 in CC, 0 < re(z + 1)
  (let ((z1 (list '+ z 1)))
    (c6t-cc! z1) (c6t-re-im-real! 1) (c6t-and! (list 'IN z 'CC) '(IN 1 CC)) (fact 'cc-re-add z 1) (c6t-rr! (list 'real-part z1)) (c6t-rr! '(real-part 1))
    (if (not (dk-asm? (list '< 0 (list 'real-part z1))))
        (dk-have! (list '< 0 (list 'real-part z1))
          (lambda () (dk-ineq! (list '= (list 'real-part z1) (list '+ (list 'real-part z) (list 'real-part 1))) '(= (real-part 1) 1) (list '< 0 (list 'real-part z))))))
    (if (not (dk-asm? (list 'NOT (list '= z1 0))))
        (dk-have! (list 'NOT (list '= z1 0))
          (lambda () (di) (c6t-re-im-real! 0) (dk-have! (list '= (list 'real-part z1) 0) (lambda () (subst (list '= z1 0)) (dk-ass!)))
                          (dk-absurd! (list '< 0 (list 'real-part z1)) (list '= (list 'real-part z1) 0)))))
    (c6t-cc! (list 'recip z1)) (fact 'cc-recip-inverse z1)
    z1))
(sp (make-wff (list 'FORALL 'c6tk_ (list 'IMPLIES '(IN c6tk_ NN) (list 'FORALL 'c6tm_ (list 'IMPLIES '(IN c6tm_ RR) (list 'IMPLIES '(< 0 c6tm_)
  (list 'FORALL 'c6tz_ (list 'IMPLIES '(IN c6tz_ CC) (list 'IMPLIES '(< 0 (real-part c6tz_))
    (list 'FORALL 'c6te_ (list 'IMPLIES '(POS-RR c6te_) (c6t-lim 'c6tk_ 'c6tm_ 'c6tz_ 'c6te_)))))))))))))
(define (c6t-pick-mz new)                        ; (mm z e) from the landed formulas
  (list (caddr (find-first (lambda (q) (and (c6-op? q '< 3) (eqv? (cadr q) 0) (symbol? (caddr q)))) new))
        (c6-var new 'CC)
        (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) new))))
(ni)
(c6w-induct-on! 'c6tk_
  (lambda ()
    (let* ((new (c6-steps!)) (pk3 (c6t-pick-mz new)) (mm (car pk3)) (z (cadr pk3)) (e (caddr pk3)))
      (c6t-mm-setup! mm z) (fact 'rr-pos-rr-in-rr e) (fact 'rr-lt-of-pos-rr e)
      (let* ((d (dk-skolem! (c6-cite! 'boundary-power-small z e) #t))
             (bu (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q d) (dk-contains? q 'magnitude))) (dk-asms))))
        (ew d)
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal)) (dk-ass!)
              (let* ((nr (c6-steps!)) (r (c6-var nr 'RR)) (gr (c6t-Gv z r)) (gm (c6t-Gv z mm)))
                (c6t-pos-in-rhp! r) (fact 'log-in-rr r) (fact 'log-in-rr mm) (c6t-cc! gr) (c6t-cc! gm)
                (dk-apply! bu r)
