                   (error "c6t-rr!: land the non-vanishing first" (expression->string (cadr t)))))
           (c6t-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t))
