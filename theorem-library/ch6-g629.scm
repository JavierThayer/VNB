                            (let* ((k1 (list '<= (list '* (list 'magnitude bp) (list 'magnitude gr)) (list '* 1 (list 'magnitude gr))))
                                   (pp1 (list '* (list 'magnitude bp) (list 'magnitude gr)))
                                   (dl (list 'magnitude dd))
                                   (k2 (begin (dk-rewrite-h! (dk-rewrite-h! (list '<= (list 'magnitude (list '- i1 a1)) e2) i1 i1v) a1 a1v)
