                (dk-lam-b!)
                (c6t-rr! (list '* uvr ev)) (c6t-re-im-real! (list '* uvr ev))
               
                (subst (list '= (list 'real-part (list '* uvr ev)) (list '* uvr ev)))
                (dk-have! (list '<= 0 uvr) (lambda () (subst (list '= uvr (list 'recip mm))) (dk-ineq! (list '< 0 (list 'recip mm)))))
                (subst (list '= uvr (list 'recip mm)))
                (dk-have! (list '<= 0 (list 'recip mm)) (lambda () (dk-ineq! (list '< 0 (list 'recip mm)))))
                (let ((k1 (c6-cite! 'rr-mul-le-right gz2 ev (list 'recip mm))))
                  (c6t-rr! (list '* gz2 (list 'recip mm))) (c6t-rr! (list '* ev (list 'recip mm))) (c6t-rr! (list '* (list 'recip mm) ev))
                  (dk-have! (list '= (list '* ev (list 'recip mm)) (list '* (list 'recip mm) ev)) (lambda () (crs)))
                  (c6-ineq*! idb k1 (list '= (list '* ev (list 'recip mm)) (list '* (list 'recip mm) ev))))))))
        (fact 'cc-int-compare-primitive c6t-rhp dd g2d g2p 1 mm)
        ;; the primitive values
        (let* ((e1 (list 'CC-EXP (list '- kb (list '* 1/2 1)))) (em (list 'CC-EXP (list '- kb (list '* 1/2 mm))))
               (v1 (list '- (list '* 1 uvr) (list '* r uvr)))
               (v2 (list '- (list '* (list '* -2 uvr) em) (list '* (list '* -2 uvr) e1))))
          (for-each (lambda (q) (c6t-rr! q) (c6t-cite-split! 'cc-exp-real q)) (list (list '- kb (list '* 1/2 1)) (list '- kb (list '* 1/2 mm))))
          (c6t-rr! v1) (c6t-rr! v2) (c6t-re-im-real! v1) (c6t-re-im-real! v2)
          (fact 'fun-apply-type-c g1p c6t-rhp 'CC 1) (fact 'fun-apply-type-c g1p c6t-rhp 'CC r)
          (fact 'fun-apply-type-c g2p c6t-rhp 'CC 1) (fact 'fun-apply-type-c g2p c6t-rhp 'CC mm)
          (c6t-pos-in-rhp! 1) (c6t-pos-in-rhp! r) (c6t-pos-in-rhp! mm)
          (dk-have! (list '= (list 'real-part (list '- (list g1p 1) (list g1p r))) v1)
            (lambda () (dk-lam-b!) (c6t-subst-close! (list '= (list 'real-part v1) v1))))
          (dk-have! (list '= (list 'real-part (list '- (list g2p mm) (list g2p 1))) v2)
            (lambda () (dk-lam-b!) (c6t-subst-close! (list '= (list 'real-part v2) v2))))
          (c6t-rr! (list 'real-part (list '- (list g1p 1) (list g1p r)))) (c6t-rr! (list 'real-part (list '- (list g2p mm) (list g2p 1))))
          ;; assemble: |I_GI - I_F| = |int D| <= |int_r^1 D| + |int_1^M D|
          (let* ((ig (list 'CC-INT gi r mm)) (if0 (list 'CC-INT ff r mm)) (id (list 'CC-INT dd r mm)))
            (c6t-cc! (list '- ig if0))
            (dk-have! (list '= (list '- ig if0) (list '+ i1 i2))
              (lambda () (subst (list '= (list '+ i1 i2) id)) (subst (list '= id (list '+ ig (list '* -1 if0)))) (crs)))
            (subst (list '= (list '- ig if0) (list '+ i1 i2)))
            (c6t-and! (list 'IN i1 'CC) (list 'IN i2 'CC))
            (c6-mag! i1) (c6-mag! i2) (c6t-cc! (list '+ i1 i2)) (c6-mag! (list '+ i1 i2))
            (let ((tri (c6-cite! 'cc-magnitude-triangle i1 i2)))
              (dk-have! (list '<= 0 uvr) (lambda () (subst (list '= uvr (list 'recip mm))) (dk-ineq! (list '< 0 (list 'recip mm)))))
              (c6t-rr! em) (c6t-rr! e1)
              (dk-have! (list '<= 0 em) (lambda () (dk-ineq! (list '< 0 em))))
