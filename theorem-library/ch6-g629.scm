              (let ((lhs-eq (list '= (list '* (list '+ sv 1) (list '* pv (list '+ 1 (list '* z vv))))
                                    (list '+ (list '* (list '+ sv 1) pv) (list '* pv (list '* z (list '* (list '+ sv 1) vv)))))))
                (dk-have! lhs-eq (lambda () (crs)))
                (subst lhs-eq)
                (subst (list '= (list '* (list '+ sv 1) vv) 1))
                (let ((rhs-eq (list '= (list '* z1 (list '* qv (list '+ 1 (list '* z1 uv))))
                                      (list '+ (list '* z1 qv) (list '* (list '* z1 qv) (list '* z1 uv))))))
                  (dk-have! rhs-eq (lambda () (crs)))
                  (subst rhs-eq)
                  (subst (list '= (list '* z1 qv) (list '* sv pv)))
                  (dk-have! (list '= (list '* (list '* sv pv) (list '* z1 uv)) (list '* (list '* pv z1) (list '* sv uv))) (lambda () (crs)))
                  (subst (list '= (list '* (list '* sv pv) (list '* z1 uv)) (list '* (list '* pv z1) (list '* sv uv))))
                  (subst (list '= (list '* sv uv) 1))
