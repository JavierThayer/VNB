    (let* ((new (c6-steps!)) (k (c6-var new 'NN)) (z (c6-var new 'CC)) (z1 (list '+ z 1))
           (ih (find-first (lambda (q) (c6-op? q 'FORALL 3)) new)) (sk (list 'succ k)) (ssk (list 'succ sk)))
      (c6w-cc-setup!) (c6-cc! z1) (c6t-qq-typ! z) (c6t-qq-typ! z1) (fact 'nn-succ-closed k) (fact 'nn-succ-closed sk)
      (c6-nn! k) (c6-nn! sk) (c6-nn! ssk) (fact 'nn-succ-plus-one k) (fact 'nn-succ-plus-one sk)
      (let ((ihe (dk-apply! ih z)))
        (dk-cite! 'pprod-in-cc sk (c6e-qq z)) (dk-cite! 'pprod-in-cc k (c6e-qq z1))
        (subst (dk-cite! 'pprod-succ (c6e-qq z) sk)) (subst (dk-cite! 'pprod-succ (c6e-qq z1) k))
        (subst (c6t-qv! z sk)) (subst (c6t-qv! z1 k))
