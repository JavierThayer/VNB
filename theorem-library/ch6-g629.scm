;;; ---------------------------------------------------------------- (1 - w c)^(k+1) is differentiable on the half-plane
(define c6t-rhp '(SEP gmu_ CC (< 0 (real-part gmu_))))
(define (c6t-pwl c j) (list 'VNB-LAMBDA 'c6tw_ c6t-rhp (list 'power (list '- 1 (list '* 'c6tw_ c)) j)))
(define (c6t-rhp-open! y)                        ; y in RHP in context: y in CC, 0 < re y
  (let* ((m (list 'IN y c6t-rhp)))
