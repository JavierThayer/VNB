                (subst (dk-cite! 'pprod-zero (c6e-qq z)))
                (dk-have! '(NOT (= 1 0)) (lambda () (di) (dk-absurd! '(= 1 0))))
                (c6t-and! '(IN 1 CC) '(NOT (= 1 0))) (fact 'cc-recip-inverse 1)
                (dk-have! '(= (recip 1) 1) (lambda () (dk-have! '(= (recip 1) (* 1 (recip 1))) (lambda () (crs))) (subst '(= (recip 1) (* 1 (recip 1)))) (dk-ass!)))
                (subst '(= (recip 1) 1))
                (c6t-cc! (list '- gr))
                (dk-have! (list '= (list '- (list '- gm gr) (list '* gm 1)) (list '- gr)) (lambda () (crs)))
                (subst (list '= (list '- (list '- gm gr) (list '* gm 1)) (list '- gr)))
                (subst (c6-cite! 'cc-magnitude-neg gr))
