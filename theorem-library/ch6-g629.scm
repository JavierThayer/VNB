               (c6t-op? t 'magnitude 2) (c6t-op? t 'real-part 2) (c6t-op? t 'imag-part 2) (c6t-op? t 'LOG 2))
           (c6t-rr! t) (fact 'rr-subset-cc t) typ)
          ((c6t-op? t '- 3) (c6t-cc! (cadr t)) (c6t-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((c6t-op? t '- 2) (c6t-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((c6t-op? t '+ 3) (c6t-cc! (cadr t)) (c6t-cc! (caddr t))
           (c6t-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((c6t-op? t '* 3) (c6t-cc! (cadr t)) (c6t-cc! (caddr t))
           (c6t-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((c6t-op? t 'power 3) (c6t-cc! (cadr t)) (c6t-nn! (caddr t))
           (c6t-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((c6t-op? t 'CC-EXP 2) (c6t-cc! (cadr t))
