  (lambda ()
    (let* ((new (c6-steps!)) (k (find-first (lambda (v) (dk-contains? (dk-goal) (list 'succ v))) (c6-vars new 'NN)))
           (ih (find-first (lambda (q) (c6-op? q 'FORALL 3)) new))
           (pk3 (c6t-pick-mz new)) (mm (car pk3)) (z (cadr pk3)) (e (caddr pk3))
           (sk (list 'succ k)) (kk (c6t-K z k mm)) (kv (list 'magnitude kk)))
      (c6t-mm-setup! mm z) (fact 'rr-pos-rr-in-rr e) (fact 'rr-lt-of-pos-rr e) (fact 'nn-succ-closed k) (c6-nn! k) (c6-nn! sk)
      (let* ((z1 (c6t-z1-setup! z)))
        (c6t-cc! kk) (c6-mag! kk)
        (let* ((den (list '* 2 (list '+ kv 1))) (q (list 'recip den)) (e2 (list '* e q)) (eh (list '* e 1/2)))
          (c6t-rr! den) (dk-have! (list '< 0 den) (lambda () (dk-ineq! (list '<= 0 kv))))
          (c6t-rr! q) (fact 'rr-recip-pos den) (fact 'rr-recip-inverse den)
          (c6t-rr! e2) (c6-cite! 'rr-mul-pos e q) (c6-cite! 'rr-pos-rr-of-lt e2)
          (c6t-rr! eh) (dk-have! (list '< 0 eh) (lambda () (dk-ineq! (list '< 0 e)))) (c6-cite! 'rr-pos-rr-of-lt eh)
          (let* ((d2 (dk-skolem! (dk-apply! ih mm z1 e2) #t))
                 (bu2 (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q d2) (dk-contains? q 'CC-INT))) (dk-asms)))
                 (d1 (dk-skolem! (c6-cite! 'boundary-power-small z eh) #t))
                 (bu1 (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q d1) (dk-contains? q 'magnitude))) (dk-asms))))
            (fact 'rr-pos-rr-in-rr d1) (fact 'rr-lt-of-pos-rr d1) (fact 'rr-pos-rr-in-rr d2) (fact 'rr-lt-of-pos-rr d2)
            (let* ((w (dk-skolem! (dk-cite! 'rr-min-pos d1 d2) #t)))
              (c6-cite! 'rr-pos-rr-of-lt w)
              (ew w)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal)) (dk-ass!)
                    (let* ((nr (c6-steps!)) (r (c6-var nr 'RR)) (gr (c6t-Gv z r))
                           (b (list '- 1 (list '* r (list 'recip mm)))) (bp (list 'power b sk)))
                      (dk-have! (list '< r d1) (lambda () (dk-ineq! (list '< r w) (list '<= w d1))))
                      (dk-have! (list '< r d2) (lambda () (dk-ineq! (list '< r w) (list '<= w d2))))
                      (c6t-pos-in-rhp! r) (fact 'log-in-rr r) (fact 'log-in-rr mm) (c6t-cc! gr)
                      (dk-apply! bu1 r) (dk-apply! bu2 r)
                      (let* ((ibp (c6-cite! 'truncated-integral-parts mm k z r))
                             (rec (c6-cite! 'truncated-value-recursion k mm z))
                             (i0 (list 'CC-INT (c6t-F z sk mm) r mm)) (i1 (list 'CC-INT (c6t-F z1 k mm) r mm))
                             (a0 (c6t-A z sk mm)) (a1 (c6t-A z1 k mm)) (hv (c6t-Hv z k mm r)))
                        (fact 'ccint-in-right-half-plane r mm)
                        (c6t-F-hol! z sk mm) (c6t-F-hol! z1 k mm)
                        (dk-cite! 'cc-int-in-cc-of-continuous c6t-rhp (c6t-F z sk mm) r mm) (dk-cite! 'cc-int-in-cc-of-continuous c6t-rhp (c6t-F z1 k mm) r mm)
                        (c6t-qq-typ! z) (c6t-qq-typ! z1)
                        (dk-cite! 'pprod-in-cc sk (c6e-qq z)) (dk-cite! 'pprod-in-cc k (c6e-qq z1))
                        (c6-cite! 'pprod-qq-nonzero sk z) (c6-cite! 'pprod-qq-nonzero k z1)
                        (c6t-cc! a0) (c6t-cc! a1)
                        ;; b in [0, 1], b^(k+1) in [0, 1]
                        (fact 'rr-recip-inverse mm) (c6t-rr! (list '* r (list 'recip mm))) (c6t-rr! (list '* mm (list 'recip mm)))
                        (c6t-rr! b)
                        (begin
                          (dk-have! (list '<= (list 'recip mm) (list 'recip mm)) (lambda () (dk-ineq!)))
                          (dk-have! (list '<= 0 (list 'recip mm)) (lambda () (dk-ineq! (list '< 0 (list 'recip mm)))))
                          (dk-have! (list '<= r mm) (lambda () (dk-ineq! (list '< r mm))))
                          (c6-cite! 'rr-mul-le-right r mm (list 'recip mm))
                          (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
                          (c6g-mul-nonneg! r (list 'recip mm))
                          (dk-have! (list '<= 0 b) (lambda () (c6-ineq*! (list '<= (list '* r (list 'recip mm)) (list '* mm (list 'recip mm))) (list '= (list '* mm (list 'recip mm)) 1))))
                          (dk-have! (list '<= b 1) (lambda () (c6-ineq*! (list '<= 0 (list '* r (list 'recip mm)))))))
                        (fact 'power-real-closed b sk) (fact 'rr-subset-cc bp)
                        (c6-cite! 'rr-power-nonneg sk b)
                        (c6t-and! (list '<= 0 b) (list '<= b 1)) (c6-cite! 'rr-power-le-one sk b)
                        (c6t-cc! hv)
                        (let* (;; names
                               (i0v (dk-name! i0 'CC)) (i1v (dk-name! i1 'CC)) (a0v (dk-name! a0 'CC)) (a1v (dk-name! a1 'CC))
                               (hvv (dk-name! hv 'CC)) (kkv (dk-name! kk 'CC))
                               (ibp2 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! ibp i0 i0v) i1 i1v) hv hvv) kk kkv))
                               (rec2 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! rec a0 a0v) a1 a1v) kk kkv))
                               (dd (list '- i1v a1v)) (tot (list '+ (list '- hvv) (list '* kkv dd))))
                          (subst (list '= i0 i0v)) (subst (list '= a0 a0v))
                          (c6t-cc! dd) (c6t-cc! tot)
                          (dk-have! (list '= (list '- i0v a0v) tot)
                            (lambda () (subst ibp2) (subst rec2) (crs)))
                          (subst (list '= (list '- i0v a0v) tot))
                          ;; |tot| <= |hv| + |kk| |dd|
                          (c6-mag! hvv) (c6-mag! dd) (c6-mag! kkv) (c6t-cc! (list '- hvv)) (c6t-cc! (list '* kkv dd)) (c6-mag! tot)
                          (c6-mag! (list '- hvv)) (c6-mag! (list '* kkv dd))
                          (c6t-and! (list 'IN (list '- hvv) 'CC) (list 'IN (list '* kkv dd) 'CC))
                          (let* ((tri (c6-cite! 'cc-magnitude-triangle (list '- hvv) (list '* kkv dd)))
                                 (ng (c6-cite! 'cc-magnitude-neg hvv))
                                 (ml (begin (c6t-and! (list 'IN kkv 'CC) (list 'IN dd 'CC)) (c6-cite! 'cc-magnitude-mul kkv dd)))
                                 ;; |hv| = |b^(k+1)| |Gv(r)| <= |Gv(r)|
                                 (mh (begin (c6t-and! (list 'IN bp 'CC) (list 'IN gr 'CC)) (c6-cite! 'cc-magnitude-mul bp gr)))
                                 (mb (c6-cite! 'rr-magnitude-is-abs bp))
                                 (ab (c6-cite! 'rr-abs-of-nonneg bp)))
