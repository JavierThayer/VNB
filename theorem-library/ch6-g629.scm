        (let* ((pv (dk-name! (c6t-pp z sk) 'CC)) (qv (dk-name! (c6t-pp z1 k) 'CC))
               (uv (dk-name! (c6g-u k) 'RR)) (vv (dk-name! (c6g-u sk) 'RR))
               (sv (dk-name! sk 'RR)))
          (subst (list '= (c6t-pp z sk) pv)) (subst (list '= (c6t-pp z1 k) qv))
          (subst (list '= (c6g-u k) uv)) (subst (list '= (c6g-u sk) vv))
          (let* ((ih2 (dk-rewrite-h! (dk-rewrite-h! ihe (c6t-pp z sk) pv) (c6t-pp z1 k) qv))
                 (iu (dk-rewrite-h! (list '= (list '* ssk (c6g-u sk)) 1) (c6g-u sk) vv))
                 (iv (dk-rewrite-h! (list '= (list '* (list 'succ k) (c6g-u k)) 1) (c6g-u k) uv)))
            (let* ((ih3 (dk-rewrite-h! ih2 sk sv))
                   (iv2 (dk-rewrite-h! iv sk sv))
                   (e1 (list '= ssk (list '+ sv 1))))
              (dk-have! e1 (lambda () (subst (list '= ssk (list '+ sk 1))) (subst (list '= sk sv)) (c6f-rfl-close!)))
              (subst e1)
              (subst (list '= sk sv))
