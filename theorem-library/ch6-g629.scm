;;; helpers copied from theorem-library/gamma-function.scm (gmf- prefix there, c6t- here)
(define c6t-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (c6t-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (c6t-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u)
