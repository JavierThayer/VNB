                        (dk-asms)))
         (skip '(RR CC NN PI))
         (share? (lambda (fm gs) (any-pred (lambda (x) (and (memq x gs) (not (memq x skip)))) (c6t-syms fm)))))
    (let loop ((gs (c6t-syms goal)) (round 0))
