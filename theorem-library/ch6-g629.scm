                       (dk-have! (list '= (list g2d w) ls) (lambda () (dk-lam-b!) (crs)))
                       (subst (list '= (list g2d w) ls)) (dk-ass!))))
        (c6t-cp-bound! dd g2d 1 mm
          (lambda (y)
