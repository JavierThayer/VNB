        (#t '())))
(define (c6t-atoms t)
  (cond ((number? t) '())
        ((and (pair? t) (memq (car t) '(+ - abs))) (apply append (map c6t-atoms (cdr t))))
        ((and (pair? t) (eq? (car t) '*) (= (length t) 3) (number? (cadr t))) (c6t-atoms (caddr t)))
        ((and (pair? t) (eq? (car t) '*) (= (length t) 3) (number? (caddr t))) (c6t-atoms (cadr t)))
