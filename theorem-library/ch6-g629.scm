                                              (c6-cite! 'rr-mul-le-right dl e2 (list 'magnitude kkv))))
                                   (kq (list '* kv q)))
                              (dk-have! (list '<= (list 'magnitude bp) 1) (lambda () (dk-ineq! mb ab (list '<= bp 1))))
                              (dk-have! (list '<= 0 (list 'magnitude gr)) (lambda () (fact 'cc-magnitude-nonneg gr) (dk-ass!)))
                              (c6-cite! 'rr-mul-le-right (list 'magnitude bp) 1 (list 'magnitude gr))
                              ;; |hvv| = |hv|
                              (dk-have! (list '= (list 'magnitude hvv) pp1)
                                (lambda () (subst (list '= hvv hv)) (dk-ass!)))
                              ;; |kkv| = kv
                              (dk-have! (list '= (list 'magnitude kkv) kv) (lambda () (subst (list '= kkv kk)) (c6f-rfl-close!)))
                              ;; kv q <= 1/2
                              (c6t-rr! kq) (c6t-rr! (list '* den q))
                              (dk-have! (list '= (list '* den q) (list '+ (list '* 2 kq) (list '* 2 q))) (lambda () (crs)))
                              (dk-have! (list '<= kq 1/2) (lambda () (c6-ineq*! (list '= (list '* den q) 1) (list '= (list '* den q) (list '+ (list '* 2 kq) (list '* 2 q))) (list '< 0 q))))
                              (dk-have! (list '<= 0 e) (lambda () (dk-ineq! (list '< 0 e))))
                              (let* ((k3 (c6-cite! 'rr-mul-le-right kq 1/2 e)))
                                (c6t-rr! (list '* e2 (list 'magnitude kkv))) (c6t-rr! (list '* kq e)) (c6t-rr! (list '* dl (list 'magnitude kkv)))
                                (c6t-rr! (list '* (list 'magnitude kkv) dl))
                                (dk-have! (list '= (list '* e2 (list 'magnitude kkv)) (list '* kq e))
                                  (lambda () (subst (list '= (list 'magnitude kkv) kv)) (crs)))
                                (dk-have! (list '= (list '* (list 'magnitude kkv) dl) (list '* dl (list 'magnitude kkv))) (lambda () (crs)))
                                (dk-have! (list '<= 1/2 1/2) (lambda () (dk-ineq!)))
                                (c6-ineq*! tri ng ml k1 k2 k3
                                           (list '= (list 'magnitude hvv) pp1) (list '= (list '* e2 (list 'magnitude kkv)) (list '* kq e))
                                           (list '= (list '* (list 'magnitude kkv) dl) (list '* dl (list 'magnitude kkv)))
                                           (list '<= (list 'magnitude gr) eh) (list '<= dl e2))))))))))))))))))
(qed 'truncated-limit-at-zero)

;;; ---------------------------------------------------------------- (185): the integrands differ by at most |t^(s+1) e^(-t)| / m on (0, m]
(define (c6t-GI z t) (list (list 'GAMMA-INTEGRAND z) t))
(define (c6t-GIval! z t)                         ; t > 0 real: GI(z)(t) = e^((z-1) log t) e^(-t), with CC-LOG t = LOG t
  (let* ((lt (list 'LOG t)) (x (list 'CC-EXP (list '* (list '- z 1) lt))) (e (list 'CC-EXP (list '- t)))
         (eq (list '= (c6t-GI z t) (list '* x e))))
    (c6t-pos-in-rhp! t) (fact 'log-in-rr t) (fact 'rr-subset-cc lt) (c6t-cc! (list '- z 1)) (c6t-cc! x) (c6t-rr! (list '- t)) (c6t-cc! e)
    (fact 'cc-log-real t)
    (if (not (dk-asm? eq))
        (dk-have! eq (lambda () (mac 'GAMMA-INTEGRAND) (dk-lam-b!) (c6t-subst-close! (list '= (list 'CC-LOG t) lt)))))
    eq))
(sp (make-wff (list 'FORALL 'c6tn_ (list 'IMPLIES '(IN c6tn_ NN) (list 'FORALL 'c6tz_ (list 'IMPLIES '(IN c6tz_ CC) (list 'IMPLIES '(< 0 (real-part c6tz_))
  (list 'FORALL 'c6tt_ (list 'IMPLIES '(IN c6tt_ RR) (list 'IMPLIES '(< 0 c6tt_) (list 'IMPLIES '(<= c6tt_ (succ c6tn_))
    (list '<= (list 'magnitude (list '- (c6t-GI 'c6tz_ 'c6tt_) (c6t-Fv 'c6tz_ '(succ c6tn_) '(succ c6tn_) 'c6tt_)))
              (list '* (list 'magnitude (c6t-GI '(+ (real-part c6tz_) 2) 'c6tt_)) '(recip (succ c6tn_)))))))))))))))
(let* ((new (c6-steps!)) (n 'c6tn_) (z 'c6tz_) (t 'c6tt_) (mm '(succ c6tn_)) (s '(real-part c6tz_)) (z2 '(+ (real-part c6tz_) 2))
       (lt (list 'LOG t)) (x (list 'CC-EXP (list '* (list '- z 1) (list 'CC-LOG t)))) (b (list '- 1 (list '* t (list 'recip mm))))
       (pp (list 'power b mm)) (re (list 'R-EXP (list '- t))) (ce (list 'CC-EXP (list '- t))))
  (c6w-cc-setup!) (fact 'nn-succ-closed n) (c6-nn! n) (c6g-pos! mm) (fact 'rr-subset-cc (list 'recip mm))
  (c6t-rr! s) (c6t-rr! z2) (fact 'rr-subset-cc z2) (c6t-re-im-real! z2) (c6t-rr! (list 'real-part z2))
  (dk-have! (list '< 0 (list 'real-part z2)) (lambda () (dk-ineq! (list '= (list 'real-part z2) z2) (list '< 0 s))))
  (let* ((g1 (c6t-GIval! z t)) (g2 (c6t-GIval! z2 t)))
    (fact 'cc-log-real t)
    (c6t-rr! b) (fact 'power-real-closed b mm) (fact 'rr-subset-cc pp)
    (fact 'r-exp-in-rr (list '- t)) (fact 'cc-exp-real-is-r-exp (list '- t)) (c6t-rr! ce)
    (subst g1)
    (subst (list '= (list 'CC-LOG t) lt))
    (let* ((x1 (list 'CC-EXP (list '* (list '- z 1) lt))) (dlt (list '- ce pp)))
      (c6t-cc! (list '* (list '- z 1) lt)) (c6t-cc! x1) (c6t-rr! dlt) (fact 'rr-subset-cc dlt)
      (c6t-cc! (list '* x1 ce)) (c6t-cc! (list '* pp x1)) (c6t-cc! (list '* x1 dlt))
      (dk-have! (list '= (list '- (list '* x1 ce) (list '* pp x1)) (list '* x1 dlt)) (lambda () (crs)))
      (subst (list '= (list '- (list '* x1 ce) (list '* pp x1)) (list '* x1 dlt)))
      (c6t-and! (list 'IN x1 'CC) (list 'IN dlt 'CC))
      (subst (c6-cite! 'cc-magnitude-mul x1 dlt))
      ;; |x1| = e^((s-1) log t)
      (let* ((ms (list '* (list '- s 1) lt)) (v1 (list 'CC-EXP ms)))
        (c6t-rr! ms) (c6t-cite-split! 'cc-exp-real ms)
        (dk-have! (list '= (list 'magnitude x1) v1)
          (lambda ()
            (subst (c6-cite! 'cc-exp-magnitude (list '* (list '- z 1) lt)))
            (c6t-cc! (list '* lt (list '- z 1)))
            (dk-have! (list '= (list '* (list '- z 1) lt) (list '* lt (list '- z 1))) (lambda () (crs)))
            (subst (list '= (list '* (list '- z 1) lt) (list '* lt (list '- z 1))))
            (subst (dk-fact! 'cc-re-real-mul lt (list '- z 1)))
            (c6t-re-im-real! 1) (c6t-and! (list 'IN z 'CC) '(IN 1 CC)) (fact 'cc-re-sub z 1)
            (subst (list '= (list 'real-part (list '- z 1)) (list '- s (list 'real-part 1))))
            (subst '(= (real-part 1) 1))
            (c6t-rr! (list '* lt (list '- s 1)))
            (dk-have! (list '= (list '* lt (list '- s 1)) ms) (lambda () (crs)))
            (c6t-subst-close! (list '= (list '* lt (list '- s 1)) ms))))
        (subst (list '= (list 'magnitude x1) v1))
        ;; |dlt| = dlt, and (186)
        (dk-have! (list '<= 0 t) (lambda () (dk-ineq! (list '< 0 t))))
        (let* ((i186 (c6-cite! 'inequality-186 n t)))
          (dk-split-all! (list i186))
          (let* ((dlt2 (list '- re pp)))
            (c6t-rr! dlt2)
            (dk-have! (list '<= 0 dlt) (lambda () (dk-ineq! (list '<= 0 dlt2) (list '= ce re))))
            (c6-cite! 'rr-magnitude-is-abs dlt) (c6-cite! 'rr-abs-of-nonneg dlt)
            (c6-mag! dlt) (c6t-rr! (list 'abs dlt))
            (subst (list '= (list 'magnitude dlt) (list 'abs dlt))) (subst (list '= (list 'abs dlt) dlt))
            ;; |GI(z2)(t)| = e^((s+1) log t - t)
            (let* ((mg (c6-cite! 'gamma-integrand-magnitude z2 t))
                   (u2 (list '- (list '* (list '- (list 'real-part z2) 1) lt) t)) (w2 (list '- (list '* (list '+ s 1) lt) t)))
              (c6t-rr! u2) (c6t-rr! w2) (c6t-cite-split! 'cc-exp-real u2) (c6t-cite-split! 'cc-exp-real w2)
              (subst mg)
              (dk-have! (list '= u2 w2) (lambda () (subst (list '= (list 'real-part z2) z2)) (crs)))
              (subst (list '= u2 w2))
              ;; e^((s+1) log t - t) = e^((s-1) log t) t t e^(-t)
              (let* ((tt (list '* t t)) (ex2 (list 'CC-EXP (list '* 2 lt))))
                (fact 'cc-exp-log-real t)
                (c6t-rr! (list '* 2 lt)) (c6t-cite-split! 'cc-exp-real (list '* 2 lt))
                (c6t-cc! ms) (c6t-cc! (list '* 2 lt)) (c6t-cc! (list '- t)) (c6t-cc! lt)
                (c6t-and! (list 'IN lt 'CC) (list 'IN lt 'CC)) (fact 'cc-exp-add lt lt)
                (c6t-cc! (list '+ lt lt))
                (dk-have! (list '= ex2 tt)
                  (lambda () (dk-have! (list '= (list '* 2 lt) (list '+ lt lt)) (lambda () (crs)))
                             (subst (list '= (list '* 2 lt) (list '+ lt lt)))
                             (subst (list '= (list 'CC-EXP (list '+ lt lt)) (list '* (list 'CC-EXP lt) (list 'CC-EXP lt))))
                             (subst (list '= (list 'CC-EXP lt) t)) (c6f-rfl-close!)))
                (c6t-and! (list 'IN ms 'CC) (list 'IN (list '* 2 lt) 'CC)) (fact 'cc-exp-add ms (list '* 2 lt))
                (c6t-cc! (list '+ ms (list '* 2 lt)))
                (c6t-and! (list 'IN (list '+ ms (list '* 2 lt)) 'CC) (list 'IN (list '- t) 'CC)) (fact 'cc-exp-add (list '+ ms (list '* 2 lt)) (list '- t))
                (let ((ew (list '= (list 'CC-EXP w2) (list '* (list '* v1 tt) ce))))
                  (c6t-cc! (list '+ (list '+ ms (list '* 2 lt)) (list '- t)))
                  (dk-have! ew
                    (lambda () (dk-have! (list '= w2 (list '+ (list '+ ms (list '* 2 lt)) (list '- t))) (lambda () (crs)))
                               (subst (list '= w2 (list '+ (list '+ ms (list '* 2 lt)) (list '- t))))
                               (subst (list '= (list 'CC-EXP (list '+ (list '+ ms (list '* 2 lt)) (list '- t)))
                                               (list '* (list 'CC-EXP (list '+ ms (list '* 2 lt))) ce)))
                               (subst (list '= (list 'CC-EXP (list '+ ms (list '* 2 lt))) (list '* v1 ex2)))
                               (subst (list '= ex2 tt))
                               (c6t-cc! (list '* (list '* v1 tt) ce))
                               (c6f-rfl-close!)))
                  (subst ew)
                  ;; v1 dlt <= v1 (t t e / m)
                  (let* ((u (list 'recip mm)) (bnd (list '* (list '* tt re) u)))
                    (c6t-rr! tt) (c6t-rr! bnd) (c6t-rr! v1)
                    (dk-have! (list '<= dlt bnd) (lambda () (c6-ineq*! (list '<= dlt2 bnd) (list '= ce re))))
                    (dk-have! (list '<= 0 v1) (lambda () (dk-ineq! (list '< 0 v1))))
                    (let* ((k1 (c6-cite! 'rr-mul-le-right dlt bnd v1)))
                      (c6t-rr! (list '* (list '* v1 tt) ce)) (c6t-rr! (list '* (list '* (list '* v1 tt) ce) u))
                      (c6t-rr! (list '* v1 dlt)) (c6t-rr! (list '* dlt v1)) (c6t-rr! (list '* bnd v1))
                      (dk-have! (list '= (list '* bnd v1) (list '* (list '* (list '* v1 tt) ce) u))
                        (lambda () (subst (list '= ce re)) (crs)))
                      (dk-have! (list '= (list '* v1 dlt) (list '* dlt v1)) (lambda () (crs)))
                      (c6-ineq*! k1 (list '= (list '* bnd v1) (list '* (list '* (list '* v1 tt) ce) u)) (list '= (list '* v1 dlt) (list '* dlt v1))))))))))))))
(qed 'integrand-difference-bound)

;;; ---------------------------------------------------------------- the integrated difference: |int_r^M (GI(z) - F(z, M, M))| <= C(z) / M
(define (c6t-KB s) (list '* (list '+ s 2) (list '- (list 'LOG (list '* 2 (list '+ s 2))) 1)))
(define (c6t-CB s) (list '+ 1 (list '* 2 (list 'CC-EXP (list '- (c6t-KB s) 1/2)))))
(define (c6t-D z mm) (list 'VNB-LAMBDA 'c6tw_ c6t-rhp (list '+ (list (list 'GAMMA-INTEGRAND z) 'c6tw_) (list '* -1 (c6t-Fv z mm mm 'c6tw_)))))
(define (c6t-cp-bound! f gdr a b pt-bound!)      ; the pointwise bound universal of cc-int-compare-primitive
  (dk-have! (list 'FORALL 'gmy_ (list 'IMPLIES (list 'IN 'gmy_ (list 'CCINT a b)) (list '<= (list 'magnitude (list f 'gmy_)) (list 'real-part (list gdr 'gmy_)))))
    (lambda () (let ((y (dk-di-var!))) (c6t-ccint-parts! y a b) (pt-bound! y)))))
(sp (make-wff (list 'FORALL 'c6tn_ (list 'IMPLIES '(IN c6tn_ NN) (list 'FORALL 'c6tz_ (list 'IMPLIES '(IN c6tz_ CC) (list 'IMPLIES '(< 0 (real-part c6tz_))
  (list 'FORALL 'c6tr_ (list 'IMPLIES '(IN c6tr_ RR) (list 'IMPLIES '(< 0 c6tr_) (list 'IMPLIES '(< c6tr_ 1)
    (list '<= (list 'magnitude (list '- (list 'CC-INT '(GAMMA-INTEGRAND c6tz_) 'c6tr_ '(succ (succ c6tn_)))
                                        (list 'CC-INT (c6t-F 'c6tz_ '(succ (succ c6tn_)) '(succ (succ c6tn_))) 'c6tr_ '(succ (succ c6tn_)))))
              (list '* (c6t-CB '(real-part c6tz_)) '(recip (succ (succ c6tn_))))))))))))))))
(let* ((new (c6-steps!)) (n 'c6tn_) (z 'c6tz_) (r 'c6tr_) (n1 '(succ c6tn_)) (mm '(succ (succ c6tn_)))
       (s '(real-part c6tz_)) (z2 '(+ (real-part c6tz_) 2)) (gi '(GAMMA-INTEGRAND c6tz_))
       (ff (c6t-F z mm mm)) (dd (c6t-D z mm)) (kb (c6t-KB s)))
  (fact 'nn-succ-closed n) (fact 'nn-succ-closed n1) (c6-nn! n) (c6-nn! n1) (c6-nn! mm) (fact 'nn-succ-plus-one n) (fact 'nn-succ-plus-one n1)
  (fact 'nn-zero-le n)
  (dk-have! (list '< 1 mm) (lambda () (dk-ineq! (list '= mm (list '+ n1 1)) (list '= n1 (list '+ n 1)) (list '<= 0 n))))
  (dk-have! (list '< 0 mm) (lambda () (dk-ineq! (list '< 1 mm))))
  (c6t-mm-setup! mm z)
  (c6t-F-hol! z mm mm) (c6t-GI-setup! z)
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (fact 'ccint-in-right-half-plane r mm) (fact 'ccint-in-right-half-plane r 1) (fact 'ccint-in-right-half-plane 1 mm)
  (dk-have! (list '< r mm) (lambda () (dk-ineq! (list '< r 1) (list '< 1 mm))))
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (dk-cite! 'gamma-integrand-locint z)
  (c6-cite! 'cc-int-in-cc-of-continuous c6t-rhp gi r mm) (c6-cite! 'cc-int-in-cc-of-continuous c6t-rhp ff r mm)
  (dk-have! (list 'IN dd (list 'FUN c6t-rhp 'CC))
    (lambda () (dk-lam-type!
                 (lambda () (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                              (c6t-pt! y) (fact 'fun-apply-type-c gi c6t-rhp 'CC y) (c6t-cc! (c6t-Fv z mm mm y))
                              (c6t-cc! (list '+ (list gi y) (list '* -1 (c6t-Fv z mm mm y))))
                              (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
                 (lambda () (fact 'cc-is-set) (fact 'subclass-of-set-is-set c6t-rhp 'CC) (dk-ass!)))))
  (c6t-cc! -1)
  (dk-split-all! (list (dk-chain! (dk-cite! 'cc-int-linear-combination c6t-rhp gi ff r mm -1 dd)
                         (list (cons (lambda (an) (dk-head-is? an 'FORALL))
                                     (lambda () (let ((w (dk-di-var!)))
                                                  (c6t-Fval! z mm mm w) (fact 'fun-apply-type-c gi c6t-rhp 'CC w)
                                                  (dk-lam-b!)
                                                  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (qrfl)))))))))
  (c6-cite! 'cc-int-in-cc-of-continuous c6t-rhp dd r mm) (c6-cite! 'cc-int-in-cc-of-continuous c6t-rhp dd r 1) (c6-cite! 'cc-int-in-cc-of-continuous c6t-rhp dd 1 mm)
  (fact 'cc-int-split c6t-rhp dd r mm 1)
  (let* ((uvr (dk-name! (list 'recip mm) 'RR)) (uv (begin (fact 'rr-subset-cc uvr) uvr))
         (i1 (list 'CC-INT dd r 1)) (i2 (list 'CC-INT dd 1 mm))
         (sz2 (begin (c6t-rr! s) (c6t-rr! z2) (fact 'rr-subset-cc z2) (c6t-re-im-real! z2) (c6t-rr! (list 'real-part z2)) #t))
         ;; the pointwise bound |D(t)| <= |GI(z2)(t)| / M
         (ptb! (lambda (y)
                 (c6t-lt! 0 y)
                 (c6t-pos-in-rhp! y)
                 (c6t-le! y mm)
                 (let ((idb (c6-cite! 'integrand-difference-bound n1 z y)))
                   (c6t-Fval! z mm mm y) (fact 'fun-apply-type-c gi c6t-rhp 'CC y) (fact 'fun-apply-type-c dd c6t-rhp 'CC y)
                   (c6t-cc! (list '- (list gi y) (c6t-Fv z mm mm y))) (c6-mag! (list '- (list gi y) (c6t-Fv z mm mm y)))
                   (dk-have! (list '= (list dd y) (list '- (list gi y) (c6t-Fv z mm mm y)))
                     (lambda () (dk-lam-b!) (crs)))
                   idb))))
    (c6t-rr! (list '* 2 (list '+ s 2))) (c6t-rr! kb) (c6t-rr! (list '- kb 1/2)) (c6t-cite-split! 'cc-exp-real (list '- kb 1/2))
    ;; [r, 1]: gdr = u, gpr = w u
    (let* ((g1d (list 'VNB-LAMBDA 'c6tw_ c6t-rhp uv)) (g1p (list 'VNB-LAMBDA 'c6tw_ c6t-rhp (list '* 'c6tw_ uv))))
      (c6t-holo-setup! g1d) (c6t-holo-setup! g1p)
      (dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES (list 'IN 'hbz_ c6t-rhp) (list 'IS-DIFF-ON 'CC-NORMED-FIELD c6t-rhp g1p 'hbz_ (list g1d 'hbz_))))
        (lambda () (let* ((w (dk-di-var!)) (rr0 (dk-diff! c6t-rhp g1p w)) (ls (list-ref rr0 5)))
                     (c6t-rhp-open! w) (fact 'fun-apply-type-c g1d c6t-rhp 'CC w)
                     (dk-have! (list '= (list g1d w) ls) (lambda () (dk-lam-b!) (crs)))
                     (subst (list '= (list g1d w) ls)) (dk-ass!))))
      (c6t-cp-bound! dd g1d r 1
        (lambda (y)
          (let* ((idb (ptb! y)) (gz2 (list 'magnitude (c6t-GI z2 y))))
            (dk-have! (list '<= y 1) (lambda () (dk-ass!)))
            (c6t-rr! (list '+ s 2)) (dk-have! (list '< 0 (list '+ s 2)) (lambda () (dk-ineq! (list '< 0 s))))
            (dk-have! (list '<= (list '+ s 2) (list 'real-part z2)) (lambda () (dk-ineq! (list '= (list 'real-part z2) z2))))
            (let* ((bs (c6-cite! 'gamma-integrand-bound-small z2 (list '+ s 2) y))
                   (ly (list 'LOG y)) (ex (list '* (list '- (list '+ s 2) 1) ly)))
              (fact 'log-in-rr y) (c6t-rr! ex) (c6t-cite-split! 'cc-exp-real ex)
              (fact 'log-one) (fact 'rr-one-in) (fact 'log-in-rr 1) (c6-cite! 'log-monotone y 1)
              (c6t-rr! (list '* ly (list '+ s 1)))
              (dk-have! (list '<= ex 0)
                (lambda () (dk-have! (list '= ex (list '* ly (list '+ s 1))) (lambda () (crs)))
                           (subst (list '= ex (list '* ly (list '+ s 1))))
                           (c6t-rr! (list '+ s 1)) (dk-have! (list '<= 0 (list '+ s 1)) (lambda () (dk-ineq! (list '< 0 s))))
                           (dk-have! (list '<= ly 0) (lambda () (dk-ineq! (list '<= ly '(LOG 1)) '(= (LOG 1) 0))))
                           (let ((k0 (c6-cite! 'rr-mul-le-right ly 0 (list '+ s 1))))
                             (c6t-rr! (list '* 0 (list '+ s 1)))
                             (dk-have! (list '= (list '* 0 (list '+ s 1)) 0) (lambda () (crs)))
                             (c6-ineq*! k0 (list '= (list '* 0 (list '+ s 1)) 0)))))
              (fact 'rr-zero-in) (c6-cite! 'cc-exp-real-mono ex 0) (fact 'cc-exp-zero) (c6t-cite-split! 'cc-exp-real 0)
              (c6t-GI-setup! z2) (fact 'fun-apply-type-c (list 'GAMMA-INTEGRAND z2) c6t-rhp 'CC y) (c6-mag! (c6t-GI z2 y))
              (dk-have! (list '<= gz2 1) (lambda () (dk-ineq! bs (list '<= (list 'CC-EXP ex) (list 'CC-EXP 0)) '(= (CC-EXP 0) 1) (list 'IN (list 'CC-EXP ex) 'RR))))
              ;; |D(y)| <= gz2 u <= u
              (subst (list '= (list dd y) (list '- (list gi y) (c6t-Fv z mm mm y))))
              (dk-lam-b!)
              (c6t-re-im-real! uvr)
             
              (subst (list '= (list 'real-part uvr) uvr))
              (dk-have! (list '<= 0 uvr) (lambda () (subst (list '= uvr (list 'recip mm))) (dk-ineq! (list '< 0 (list 'recip mm)))))
              (subst (list '= uvr (list 'recip mm)))
              (dk-have! (list '<= 0 (list 'recip mm)) (lambda () (dk-ineq! (list '< 0 (list 'recip mm)))))
              (let ((k1 (c6-cite! 'rr-mul-le-right gz2 1 (list 'recip mm))))
                (c6t-rr! (list '* gz2 (list 'recip mm))) (c6t-rr! (list '* 1 (list 'recip mm)))
                (c6-ineq*! idb k1))))))
      (fact 'cc-int-compare-primitive c6t-rhp dd g1d g1p r 1)
      ;; [1, M]: gdr = u e^(KB - w/2), gpr = -2 u e^(KB - w/2)
      (let* ((g2d (list 'VNB-LAMBDA 'c6tw_ c6t-rhp (list '* uv (list 'CC-EXP (list '- kb '(* 1/2 c6tw_))))))
             (g2p (list 'VNB-LAMBDA 'c6tw_ c6t-rhp (list '* (list '* -2 uv) (list 'CC-EXP (list '- kb '(* 1/2 c6tw_)))))))
        (fact 'rr-subset-cc kb)
        (c6t-holo-setup! g2d) (c6t-holo-setup! g2p)
        (dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES (list 'IN 'hbz_ c6t-rhp) (list 'IS-DIFF-ON 'CC-NORMED-FIELD c6t-rhp g2p 'hbz_ (list g2d 'hbz_))))
          (lambda () (let* ((w (dk-di-var!)) (rr0 (dk-diff! c6t-rhp g2p w)) (ls (list-ref rr0 5)))
