;;; ch6-g629.scm -- CH6-B: toward Proposition 6.29 (Gamma(z) = int_0^oo e^{-t} t^{z-1} dt for Re z > 0).
;;; This file: the elementary inequality (186) of the notes, 0 <= e^{-t} - (1 - t/m)^m <= t^2 e^{-t} / m on [0, m],
;;; with Bernoulli's inequality.  Loads after ch6-pole (it uses only the band).  Prefix c6t-.  Library: analysis.
;;; KIT-9 link skipping, opt-in per file since 2026-10-29 (this file was developed with it on); guarded for bands that predate it


(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

;;; ---- helper defines COPIED 2026-10-30 (wave-2 integration) from ch6/ch6-euler.scm, ch6/ch6-fun.scm, ch6/ch6-gamma.scm, ch6/ch6-prod.scm, ch6/ch6-weier.scm:
;;; the probe loaded this chain in ONE environment; load.scm gives each file its own.
(define (c6-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (c6-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (c6-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (c6-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))
(define (c6-nn! n) (fact 'nn-in-rr n) (fact 'rr-subset-cc n))
(define (c6-steps!)                          ; peel FORALL / IMPLIES; return the landed formulas
  (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
(define (c6-var new cls) (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (c6-vars new cls) (map cadr (filter (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (c6-lam-typ! lam cod typer)          ; (IN lam (FUN NN cod)); TYPER gets the eigenvariable, must ground
  (let ((typ (list 'IN lam (list 'FUN 'NN cod))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda () (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*))) (typer k) (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
              (lambda () (fact 'nn-is-set) (dk-ass!))))))
    typ))
(define (c6-mag! t) (fact 'cc-magnitude-closed t) (fact 'cc-magnitude-nonneg t) (list 'magnitude t))
(define c6-debug #f)
(define (c6-first-map f l) (cond ((null? l) #f) ((f (car l)) => (lambda (x) x)) (#t (c6-first-map f (cdr l)))))
(define (c6-prod-sub t)
  (cond ((not (pair? t)) #f)
        ((not (memq (car t) '(+ - * < <= = AND))) #f)                ; any other head is an atom for ineq
        (#t (or (c6-first-map c6-prod-sub (cdr t))
                (and (eq? (car t) '*) (= (length t) 3) (not (number? (cadr t))) (not (number? (caddr t))) t)))))
(define (c6-ineq*! . prems)
  (let loop ((prems prems))
    (let ((pt (c6-first-map c6-prod-sub (cons (dk-goal) prems))))
      (if (not pt)
          (begin
            (if c6-debug (for-each (lambda (q) (display ";; C6I ") (display (expression->string q)) (newline)) (cons (dk-goal) prems)))
            (apply dk-ineq! prems))
          (begin
            (c6-rr! pt)
            (let ((v (dk-name! pt 'RR)))
              (if (dk-contains? (dk-goal) pt) (subst (list '= pt v)))
              (loop (map (lambda (f) (if (dk-contains? f pt) (dk-rewrite-h! f pt v) f)) prems))))))))
(define (c6-chain-end f) (if (c6-op? f 'IMPLIES 3) (c6-chain-end (caddr f)) f))
(define (c6-cite! . args)                     ; dk-cite! that refuses to return an undetached implication link
  (let ((r (apply dk-cite! args)))
    (cond ((not (c6-op? r 'IMPLIES 3)) r)
          ((dk-asm? (c6-chain-end r)) (dk-ctx-form (c6-chain-end r)))     ; the consequent was already in context
          (#t (error "c6-cite!: the chain stopped at an antecedent not in context" (car args) (expression->string (cadr r)))))))
(define (c6-pts!)
  (fact 'cc-is-metric-space)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (c6-sk! ex) (dk-skolem! (dk-ctx-form ex) #t))
(define (c6f-rfl-close!) (dk-close-if! (lambda () #t) (lambda () (rfl))))
(define (c6f-rr-mul-nonneg! x y)               ; 0 <= x, 0 <= y in context: lands 0 <= x * y
  (let ((r (list '<= 0 (list '* x y))))
    (if (not (dk-asm? r))
        (let ((k (c6-cite! 'rr-mul-le-right 0 x y)))
          (dk-have! (list '= (list '* 0 y) 0) (lambda () (crs)))
          (dk-have! r (lambda () (dk-ineq! (dk-rewrite-h! k (list '* 0 y) 0))))))
    r))
(define (c6f-cc-and-closed! law x y)            ; law cc-mul-closed / cc-add-closed: (IN (op x y) CC)
  (c6-and! (list 'IN x 'CC) (list 'IN y 'CC)) (fact law x y))
(define (c6w-cc-setup!) (fact 'cc-is-set) (fact 'cc-one-in) (fact 'cc-zero-in) (fact 'nn-zero-in) (fact 'rr-zero-in) (fact 'rr-one-in))
(define (c6w-induct-on! v base step)             ; after (ni) on the variable V: the step leaf is the one whose goal mentions V
  (let* ((ls (dk-open-leaves)) (st (find-first (lambda (l) (dk-contains? (dk-goal-of l) v)) ls))
         (b (find-first (lambda (l) (not (eq? l st))) ls)))
    (if (not (and b st)) (error "c6w-induct-on!: leaves not found"))
    (dk-focus! b) (base) (dk-focus! st) (step)))
(define (c6g-nn! n) (fact 'nn-succ-closed n) (c6-nn! n) (c6-nn! (list 'succ n)))
(define (c6g-pos! t)                              ; t = succ(..) in NN: 0 < t, t /= 0, recip t in RR, > 0
  (let ((pred (cadr t)))
    (c6g-nn! pred) (fact 'nn-zero-le pred) (fact 'nn-succ-plus-one pred) (c6-nn! pred)
    (dk-have! (list '< 0 t) (lambda () (dk-ineq! (list '<= 0 pred) (list '= t (list '+ pred 1)))))
    (c6-cite! 'rr-pos-ne-zero t) (c6-and! (list 'IN t 'RR) (list 'NOT (list '= t 0))) (fact 'rr-recip-closed t) (c6-cite! 'rr-recip-pos t)
    (fact 'rr-recip-inverse t) (fact 'log-in-rr t)))
(define (c6g-one!)                               ; succ 0 = 1, LOG 1 = 0, recip 1 = 1 in context
  (fact 'nn-zero-in) (c6g-pos! '(succ 0)) (fact 'nn-succ-plus-one 0) (fact 'rr-one-in)
  (dk-have! '(= (succ 0) 1) (lambda () (dk-ineq! '(= (succ 0) (+ 0 1)))))
  (fact 'log-one) (fact 'rr-recip-inverse 1) (fact 'rr-recip-closed 1)
  (dk-have! '(= (recip 1) 1) (lambda () (dk-ineq! '(= (* 1 (recip 1)) 1)))))
(define (c6g-u n) (list 'recip (list 'succ n)))
(define (c6g-mul-nonneg! a b)                    ; 0 <= a, 0 <= b in context: lands 0 <= a * b
  (let ((r (list '<= 0 (list '* a b))))
    (if (not (dk-asm? r))
        (begin
          (c6-rr! a) (c6-rr! b)
          (let* ((aa (dk-name! a 'RR)) (bb (dk-name! b 'RR)))
            (dk-rewrite-h! (list '<= 0 a) a aa) (dk-rewrite-h! (list '<= 0 b) b bb)
            (c6-rr! (list '* aa bb)) (c6f-rr-mul-nonneg! aa bb)
            (dk-have! r (lambda () (subst (list '= a aa)) (subst (list '= b bb)) (dk-ass!))))))
    r))
(define (c6e-q z k) (list '+ 1 (list '* z (c6g-u k))))
(define (c6e-qq z) (list 'VNB-LAMBDA 'egq_ 'NN (c6e-q z 'egq_)))
(define (c6e-eul z) (list 'VNB-LAMBDA 'egm_ 'NN (list '* (list '* z (list 'PPROD (c6e-qq z) 'egm_)) (list 'CC-EXP (list '- (list '* z '(LOG (succ egm_))))))))
;;; ---- end of copied helpers ----

(define (c6t-pow! b k)                           ; b in RR, k in NN: b^k in RR and in CC
  (c6-rr! b) (fact 'rr-subset-cc b) (fact 'power-real-closed b k) (list 'power b k))
(define (c6t-succ-pow! b k)                      ; b^(succ k) = b * b^k landed; returns the equation
  (c6-rr! b) (fact 'rr-subset-cc b) (c6-and! (list 'IN b 'CC) (list 'IN k 'NN)) (dk-fact! 'power-succ b k))

;;; e^{a k} = (e^a)^k
(sp (make-wff '(FORALL c6tk_ (IMPLIES (IN c6tk_ NN) (FORALL c6ta_ (IMPLIES (IN c6ta_ RR)
  (= (power (R-EXP c6ta_) c6tk_) (R-EXP (* c6tk_ c6ta_)))))))))
(ni)
(c6w-induct-on! 'c6tk_
  (lambda ()
    (let* ((new (c6-steps!)) (a (c6-var new 'RR)) (e (list 'R-EXP a)))
      (fact 'rr-zero-in) (fact 'rr-one-in) (fact 'r-exp-in-rr a) (fact 'rr-subset-cc e)
      (subst (dk-fact! 'power-zero e))
      (dk-have! (list '= (list '* 0 a) 0) (lambda () (crs)))
      (subst (list '= (list '* 0 a) 0)) (subst (dk-fact! 'r-exp-zero)) (c6f-rfl-close!)))
  (lambda ()
    (let* ((new (c6-steps!)) (k (c6-var new 'NN)) (a (c6-var new 'RR)) (sk (list 'succ k))
           (ih (find-first (lambda (q) (c6-op? q 'FORALL 3)) new)) (e (list 'R-EXP a)) (ka (list '* k a)))
      (fact 'nn-succ-closed k) (c6-nn! k) (c6-nn! sk) (fact 'nn-succ-plus-one k)
      (fact 'r-exp-in-rr a) (c6t-pow! e k)
      (let ((ihe (dk-apply! ih a)))
        (subst (c6t-succ-pow! e k))
        (subst ihe)
        (c6-rr! ka) (fact 'r-exp-in-rr ka)
        (c6-cite! 'r-exp-add a ka)
        (subst (list '= (list '* e (list 'R-EXP ka)) (list 'R-EXP (list '+ a ka))))
        (c6-rr! (list '+ a ka)) (c6-rr! (list '* sk a))
        (dk-have! (list '= (list '* sk a) (list '+ a ka))
          (lambda () (subst (list '= sk (list '+ k 1))) (crs)))
        (subst (list '= (list '* sk a) (list '+ a ka)))
        (fact 'r-exp-in-rr (list '+ a ka))
        (c6f-rfl-close!)))))
(qed 'r-exp-power)

;;; BERNOULLI: 0 <= x <= 1 ==> 1 - k x <= (1 - x)^k
(sp (make-wff '(FORALL c6tk_ (IMPLIES (IN c6tk_ NN) (FORALL c6tx_ (IMPLIES (IN c6tx_ RR) (IMPLIES (<= 0 c6tx_) (IMPLIES (<= c6tx_ 1)
  (<= (- 1 (* c6tk_ c6tx_)) (power (- 1 c6tx_) c6tk_))))))))))
(ni)
(c6w-induct-on! 'c6tk_
  (lambda ()
    (let* ((new (c6-steps!)) (x (c6-var new 'RR)) (b (list '- 1 x)))
      (fact 'rr-zero-in) (fact 'rr-one-in) (c6-rr! b) (fact 'rr-subset-cc b)
      (subst (dk-fact! 'power-zero b))
      (c6-rr! (list '* 0 x)) (dk-have! (list '= (list '* 0 x) 0) (lambda () (crs)))
      (dk-ineq! (list '= (list '* 0 x) 0))))
  (lambda ()
    (let* ((new (c6-steps!)) (k (c6-var new 'NN)) (x (c6-var new 'RR)) (sk (list 'succ k)) (b (list '- 1 x))
           (ih (find-first (lambda (q) (c6-op? q 'FORALL 3)) new)) (p (list 'power b k)) (kx (list '* k x)))
      (fact 'rr-zero-in) (fact 'rr-one-in) (fact 'nn-succ-closed k) (c6-nn! k) (c6-nn! sk) (fact 'nn-succ-plus-one k)
      (fact 'nn-zero-le k)
      (c6t-pow! b k) (c6-rr! kx) (c6-rr! (list '- 1 kx))
      (let ((ihe (dk-apply! ih x)))
        (subst (c6t-succ-pow! b k))
        (dk-have! (list '<= 0 b) (lambda () (dk-ineq! (list '<= x 1))))
        (let* ((k1 (c6-cite! 'rr-mul-le-right (list '- 1 kx) p b))
               (pv (dk-name! p 'RR)) (xv x))
          (dk-have! (list '<= 0 (list '* kx x)) (lambda () (c6g-mul-nonneg! k x) (c6g-mul-nonneg! kx x) (dk-close-if! (lambda () #t) (lambda () (dk-ass!)))))
          (c6-rr! (list '* (list '- 1 kx) b)) (c6-rr! (list '* sk x))
          (dk-have! (list '= (list '* (list '- 1 kx) b) (list '+ (list '- 1 (list '* sk x)) (list '* kx x)))
            (lambda () (subst (list '= sk (list '+ k 1))) (crs)))
          (subst (list '= p pv))
          (let ((k2 (dk-rewrite-h! k1 p pv)))
            (c6-rr! (list '* pv b)) (c6-rr! (list '* b pv))
            (dk-have! (list '= (list '* b pv) (list '* pv b)) (lambda () (crs)))
            (c6-ineq*! k2 (list '= (list '* (list '- 1 kx) b) (list '+ (list '- 1 (list '* sk x)) (list '* kx x)))
                       (list '<= 0 (list '* kx x)) (list '= (list '* b pv) (list '* pv b)))))))))
(qed 'bernoulli-inequality)


;;; (186): 0 <= e^{-t} - (1 - t/m)^m <= t^2 e^{-t} / m for 0 <= t <= m, m = n + 1
(define (c6t-tr t m) (list 'power (list '- 1 (list '* t (list 'recip m))) m))
(sp (make-wff (list 'FORALL 'egn_ (list 'IMPLIES '(IN egn_ NN) (list 'FORALL 'egt_ (list 'IMPLIES '(IN egt_ RR) (list 'IMPLIES '(<= 0 egt_) (list 'IMPLIES '(<= egt_ (succ egn_))
  (list 'AND (list '<= 0 (list '- '(R-EXP (- egt_)) (c6t-tr 'egt_ '(succ egn_))))
             (list '<= (list '- '(R-EXP (- egt_)) (c6t-tr 'egt_ '(succ egn_))) (list '* '(* (* egt_ egt_) (R-EXP (- egt_))) '(recip (succ egn_)))))))))))))
(let* ((new (c6-steps!)) (n (c6-var new 'NN)) (t (c6-var new 'RR)) (m (list 'succ n)) (u (list 'recip m))
       (x (list '* t u)) (b (list '- 1 x)) (c (list '+ 1 x)) (y (list '* x x)))
  (fact 'rr-zero-in) (fact 'rr-one-in) (fact 'nn-succ-closed n) (c6g-pos! m)
  (c6-rr! x) (c6-rr! b) (c6-rr! c) (c6-rr! y) (c6-rr! (list '- t)) (c6-rr! (list '- x))
  (dk-have! (list '<= 0 u) (lambda () (dk-ineq! (list '< 0 u))))
  (c6g-mul-nonneg! t u)
  (let* ((k0 (c6-cite! 'rr-mul-le-right t m u)))
    (dk-have! (list '<= x 1) (lambda () (c6-ineq*! k0 (list '= (list '* m u) 1)))))
  (dk-have! (list '<= 0 b) (lambda () (dk-ineq! (list '<= x 1))))
  (dk-have! (list '<= 0 c) (lambda () (dk-ineq! (list '<= 0 x))))
  (let* ((e1 (list 'R-EXP (list '- x))) (e2 (list 'R-EXP x)) (ee (list 'R-EXP (list '- t))) (ff (list 'R-EXP t)))
    (fact 'r-exp-in-rr (list '- x)) (fact 'r-exp-in-rr x) (fact 'r-exp-in-rr (list '- t)) (fact 'r-exp-in-rr t)
    (fact 'r-exp-pos (list '- t))
    (let* ((g1 (c6-cite! 'r-exp-ge-one-plus (list '- x))) (g2 (c6-cite! 'r-exp-ge-one-plus x)))
      (dk-have! (list '<= b e1) (lambda () (dk-ineq! g1)))
      (dk-have! (list '<= c e2) (lambda () (dk-ineq! g2))))
    ;; m x = t
    (let ((mx (list '= (list '* m x) t)))
      (dk-have! mx (lambda () (let ((uv (dk-name! u 'RR)))
                                (subst (list '= u uv))
                                (let ((i (dk-rewrite-h! (list '= (list '* m u) 1) u uv)))
                                  (dk-have! (list '= (list '* m (list '* t uv)) (list '* t (list '* m uv))) (lambda () (crs)))
                                  (subst (list '= (list '* m (list '* t uv)) (list '* t (list '* m uv))))
                                  (subst (list '= (list '* m uv) 1))
                                  (crs)))))
      (c6t-pow! b m) (c6t-pow! c m) (c6t-pow! e1 m) (c6t-pow! e2 m)
      (let* ((pp (list 'power b m)) (qq (list 'power c m))
             (m1 (c6-cite! 'rr-power-mono-base m b e1)) (m2 (c6-cite! 'rr-power-mono-base m c e2))
             (r1 (c6-cite! 'r-exp-power m (list '- x))) (r2 (c6-cite! 'r-exp-power m x)))
        (c6-rr! (list '* m (list '- x))) (c6-rr! (list '* m x))
        (dk-have! (list '= (list '* m (list '- x)) (list '- t)) (lambda () (dk-have! (list '= (list '* m (list '- x)) (list '- (list '* m x))) (lambda () (crs)))
                                                                        (subst (list '= (list '* m (list '- x)) (list '- (list '* m x)))) (subst mx) (c6f-rfl-close!)))
        (let* ((pe (dk-rewrite-h! (dk-rewrite-h! m1 (list 'power e1 m) (list 'R-EXP (list '* m (list '- x)))) (list '* m (list '- x)) (list '- t)))
               (qf (dk-rewrite-h! (dk-rewrite-h! m2 (list 'power e2 m) (list 'R-EXP (list '* m x))) (list '* m x) t)))
          ;; Q P = (1 - x^2)^m >= 1 - m x^2
          (let* ((ml (c6-cite! 'rr-power-mul-base m c b))
                 (cb (list '= (list '* c b) (list '- 1 y))))
            (c6-rr! (list '* c b)) (dk-have! cb (lambda () (crs)))
            (fact 'rr-sq-nonneg x)
            (let ((k1 (c6-cite! 'rr-mul-le-right x 1 x)))
              (dk-have! (list '<= y 1) (lambda () (c6-ineq*! k1 (list '<= x 1)))))
            (let* ((bn (c6-cite! 'bernoulli-inequality m y))
                   (qp (dk-rewrite-h! ml (list '* c b) (list '- 1 y))))
              (c6t-pow! (list '- 1 y) m)
              ;; E F = 1
              (let* ((ea (c6-cite! 'r-exp-add (list '- t) t)))
                (c6-rr! (list '+ (list '- t) t))
                (dk-have! (list '= (list '+ (list '- t) t) 0) (lambda () (dk-ineq!)))
                (fact 'r-exp-zero)
                (let* ((ef (dk-rewrite-h! (dk-rewrite-h! ea (list '+ (list '- t) t) 0) '(R-EXP 0) 1))
                       (pn (begin (c6-cite! 'rr-power-nonneg m b) (list '<= 0 pp)))
                       (k5 (c6-cite! 'rr-mul-le-right qq ff pp))
                       (ev (dk-name! ee 'RR)) (fv (dk-name! ff 'RR)) (pv (dk-name! pp 'RR)) (qv (dk-name! qq 'RR))
                       (uv (dk-name! u 'RR)) (yv (dk-name! y 'RR)))
                  (subst (list '= ee ev)) (subst (list '= pp pv)) (subst (list '= u uv))
                  (let* ((efv (dk-rewrite-h! (dk-rewrite-h! ef ee ev) ff fv))
                         (pev (dk-rewrite-h! (dk-rewrite-h! pe pp pv) ee ev))
                         (k5v (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! k5 qq qv) ff fv) pp pv))
                         (bnv (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! bn (list 'power (list '- 1 y) m) (list '* qq pp)) qq qv) pp pv) y yv))
                         (evp (dk-rewrite-h! (list '< 0 ee) ee ev))
                         ;; 1 - F P <= m y
                         (w1 (list '- 1 (list '* fv pv))) (w2 (list '* m yv)))
                    (c6-rr! (list '* fv pv)) (c6-rr! w1) (c6-rr! w2) (c6-rr! (list '* qv pv))
                    (dk-have! (list '<= w1 w2) (lambda () (c6-ineq*! k5v bnv)))
                    (dk-have! (list '<= 0 ev) (lambda () (dk-ineq! evp)))
                    (let* ((k6 (c6-cite! 'rr-mul-le-right w1 w2 ev))
                           (id1 (list '= (list '* w1 ev) (list '- ev (list '* (list '* ev fv) pv)))))
                      (c6-rr! (list '* w1 ev)) (c6-rr! (list '* w2 ev))
                      (dk-have! id1 (lambda () (crs)))
                      (let* ((id2 (dk-rewrite-h! id1 (list '* ev fv) 1))
                             (myv (list '= w2 (list '* (list '* t t) uv))))
                        (dk-have! myv
                          (lambda ()
                            (subst (list '= yv y))
                            (let ((i (dk-rewrite-h! (list '= (list '* m u) 1) u uv)))
                              (subst (list '= u uv))
                              (dk-have! (list '= (list '* m (list '* (list '* t uv) (list '* t uv))) (list '* (list '* (list '* t t) uv) (list '* m uv))) (lambda () (crs)))
                              (subst (list '= (list '* m (list '* (list '* t uv) (list '* t uv))) (list '* (list '* (list '* t t) uv) (list '* m uv))))
                              (subst (list '= (list '* m uv) 1))
                              (crs))))
                        (c6-rr! (list '* (list '* t t) uv)) (c6-rr! (list '* (list '* (list '* t t) ev) uv)) (c6-rr! (list '* (list '* t t) ev))
                        (dk-have! (list '= (list '* (list '* (list '* t t) uv) ev) (list '* (list '* (list '* t t) ev) uv)) (lambda () (crs)))
                        (dk-conj-close!
                          (lambda () (c6-ineq*! pev k6 id2 (dk-rewrite-h! (list '<= (list '* w1 ev) (list '* w2 ev)) w2 (list '* (list '* t t) uv))
                                                (list '= (list '* (list '* (list '* t t) uv) ev) (list '* (list '* (list '* t t) ev) uv)))))))))))))))))
(qed 'inequality-186)

;;; ================================================================ 6.29
;;; ---------------------------------------------------------------- the product shift: (k+1) P_{k+1}(z) = (z+1) P_k(z+1)
(define (c6t-pp z k) (list 'PPROD (c6e-qq z) k))
(define (c6t-qq-typ! z)
  (c6-lam-typ! (c6e-qq z) 'CC (lambda (j) (c6g-pos! (list 'succ j)) (fact 'rr-subset-cc (c6g-u j))
                                 (c6f-cc-and-closed! 'cc-mul-closed z (c6g-u j)) (c6-cc! (c6e-q z j)))))
(define (c6t-qv! z j)                            ; qq_z(j) = 1 + z/(j+1), landed
  (let ((e (list '= (list (c6e-qq z) j) (c6e-q z j))))
    (c6g-pos! (list 'succ j)) (fact 'rr-subset-cc (c6g-u j)) (c6f-cc-and-closed! 'cc-mul-closed z (c6g-u j)) (c6-cc! (c6e-q z j))
