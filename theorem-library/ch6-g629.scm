      (subst (dk-cite! 'pprod-zero (c6e-qq z))) (subst (dk-cite! 'pprod-zero (c6e-qq z1)))
      (subst (c6t-qv! z 0))
      (subst '(= (succ 0) 1)) (subst '(= (recip 1) 1))
      (crs)))
