;;; mb35-regular.scm -- construction of measures, chapter 5 section 2: approximation of Borel measures on
;;; metric spaces by closed, open and compact sets (M-B35 / B3, 2026-10-26).  Library: measure.  Helper prefix mr-.
;;; Closed and open sets are IS-CLOSED / IS-OPEN; no CLOSURE, no INTERIOR.
;;;
;;; Load window: after mb4-polish-open (pt-set-dist-real, pt-set-dist-lipschitz), theorem-library/measure-laws,
;;; push-forward (pfw-open-borel), metric-outer-measure (dist-layer-*), riesz-markov-model (rmm-nn-choice).
(define (mr-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (mr-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (mr-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
(define (mr-iff-parts! iff)
  ;; the conjunct equal to the focus GOAL (if any) is projected LAST: proving it closes the leaf, and a
  ;; projection after that would fire on a sibling (focus drift)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc)))))
         (goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
         (opener (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
         (rest (filter (lambda (c) (not (goal? c))) cs))
         (last (filter goal? cs)))
    (append (mr-map (lambda (c) (mr-project! c opener)) rest)
            (mr-map (lambda (c) (mr-project! c opener)) last))))
(define (mr-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (mr-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))
(define (mr-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
(define (mr-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
;;; (IN (ESUM f) RR-POS-STAR) for f in FUN(NN, RR-POS-STAR)  (cth-dom!, caratheodory.scm)
(define (mr-esum-type! fv)
  (fact 'nn-is-set)
  (dk-project! (list 'IN fv '(FUN NN)) 'fun-codomain-iff (list 'IN fv '(FUN NN RR-POS-STAR)))
  (dk-have! (list 'AND (list 'IN fv '(FUN NN)) '(IN NN SET)) (lambda () (dk-conj-close! dk-ass!)))
  (fact 'dom-of-fun 'NN fv)
  (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN (list 'DOM fv) 'SET) (list '= (list 'DOM fv) 'NN)))))
  (dk-have! (list 'IN fv (list 'FUN (list 'DOM fv) 'RR-POS-STAR))
            (lambda () (subst (list '= (list 'DOM fv) 'NN)) (ass)))
  (fact 'esum-in fv))
;;; (NOT (= a b)) from a strict inequality in context
(define (mr-ne! a b lt)
  (dk-have! (list 'NOT (list '= a b))
    (lambda ()
      (di)
      (dk-have! '(< 0 0) (lambda () (dk-ineq! lt (list '= a b))))
      (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
      (ai (dk-cite! 'rr-lt-irrefl 0)))))
;;; y in BALL(sp, c, r) from d(c, y) < r (c, y in PTS sp, r typed); the space is mr-space ('s by default)
(define mr-space 's)
(define (mr-in-ball! c y r)
  (let ((d (list (list 'DIST mr-space) c y)))
    (dk-cite! 'metric-dist-real mr-space c y)
    (dk-have! (list '<= d r) (lambda () (dk-ineq! (list '< d r))))
    (mr-ne! d r (list '< d r))
    (dk-have! (list 'IN y (list 'BALL mr-space c r))
      (lambda () (mac 'ball-membership) (dk-conj-close! (lambda () (ass)))))))
;;; the parts of y in BALL(sp, c, r): y in PTS sp, d(c, y) < r
(define (mr-ball-parts! c y r)
  (let* ((d (list (list 'DIST mr-space) c y))
         (ps (mr-iff-parts! (dk-cite! 'ball-membership mr-space c r y))))
    (dk-cite! 'metric-dist-real mr-space c y)
    (if (not (dk-asm? (list '< d r)))
        (begin
          (dk-cite! 'rr-le-ne-lt d r)
          (if (not (dk-asm? (list '< d r)))
              (begin
                (dk-have! (list 'AND (list '<= d r) (list 'NOT (list '= d r))) (lambda () (dk-conj-close! dk-ass!)))
                (mr-chain! (dk-fact! 'rr-le-ne-lt d r))))))
    (list '< d r)))
(define (mr-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s0 (caddr m)) (v (cadr s0)) (dom (caddr s0))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s0)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "mr-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (ai (dk-ctx-form conj))))
    p))
(define (mr-and-close! closer)
  (if (dk-head-is? (dk-goal) 'AND)
      (for-each (lambda (k) (dk-focus! k) (mr-and-close! closer)) (dk-opened (lambda () (di))))
      (closer)))
(define (mr-find tag pred lst)
  (or (find-first pred lst) (error "mr-find: nothing matches at" tag (map expression->string lst))))
(define (mr-real! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)) (list 'IN t 'RR))
(define (mr-pos! e) (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))

;;; ======================================================================
;;; an increasing union is approximated from below
;;; ======================================================================
(define mr-bu '(BIG-UNION n_ NN (f_ n_)))
(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'ca (list 'FORALL 'mu (list 'FORALL 'f_
  (list 'IMPLIES '(IS-MEASURE omega ca mu) (list 'IMPLIES '(IN f_ (FUN NN ca))
    (list 'IMPLIES '(FORALL n_ (IMPLIES (IN n_ NN) (SUBSET (f_ n_) (f_ (succ n_)))))
      (list 'IMPLIES (list 'IN (list 'mu mr-bu) 'RR)
        (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
          (list 'FORSOME 'k (list 'AND '(IN k NN) (list '<= (list 'mu mr-bu) (list '+ '(mu (f_ k)) 'eps))))))))))))))))
(dk-peel!)
(mr-pos! 'eps)
(define mr1-parts (mr-iff-parts! (dk-cite! 'is-measure 'omega 'ca 'mu)))
(dk-cite! 'sigma-algebra-union-closed 'omega 'ca 'f_)
(define mr1-m (list 'mu mr-bu))
(define (mr1-fk! k)                 ; mu(f k) real, >= 0, <= M
  (let ((fk (list 'f_ k)) (mk (list 'mu (list 'f_ k))))
    (dk-cite! 'fun-apply-type-c 'f_ 'NN 'ca k)
    (dk-have! (list 'SUBSET fk mr-bu)
      (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (mr-bu-close! k))))
    (dk-cite! 'measure-monotone 'omega 'ca 'mu fk mr-bu)
    (dk-cite! 'fun-apply-type-c 'mu 'ca 'RR-POS-STAR fk)
    (mr-chain! (dk-fact! 'rr-pos-star-le-real-in-rr mk mr1-m))
    (dk-cite! 'rr-pos-star-nonneg mk)
    mk))
(define mr1-lam '(VNB-LAMBDA n_ NN (mu (f_ n_))))
(define mr1-img (list 'IMAGE mr1-lam 'NN))
(define mr1-cont (dk-cite! 'measure-continuity-from-below 'omega 'ca 'mu 'f_))
(dk-cite! 'nn-zero-in)
(use-cases (dk-cite! 'rr-le-total mr1-m 'eps)
  (lambda ()
    (let ((m0 (mr1-fk! 0)))
      (ew 0)
      (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '<= mr1-m 'eps) (list '<= 0 m0)))))))
  (lambda ()
    (let ((a (list '- mr1-m 'eps)))
      (dk-type! a 'RR)
      (dk-have! (list '<= 0 a) (lambda () (dk-ineq! (list '<= 'eps mr1-m))))
      (mr-chain! (dk-fact! 'rmc-rps-of-nonneg a))
      (dk-have! (list 'SUBSET mr1-img 'RR-POS-STAR)
        (lambda ()
          (mac 'subset-def)
          (let* ((w (dk-di-var!))
                 (x (dk-skolem! (cadr (mr-iff-parts! (dk-cite! 'image-membership-iff mr1-lam 'NN w))))))
            (dk-split-all!)
            (mr1-fk! x)
            (let ((eqn (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (caddr f) w))) (dk-asms))))
              (dk-lam-b-h! eqn)
              (subst (list '= w (list 'mu (list 'f_ x))))
              (mr-close-open!)))))
      (dk-have! (list '< a (list 'ESUP mr1-img)) (lambda () (subst (list '= (list 'ESUP mr1-img) mr1-m)) (dk-ineq! '(< 0 eps))))
      (let* ((y (dk-skolem! (dk-cite! 'esup-lt-witness mr1-img a)))
             (_0 (dk-split-all!))
             (ims (mr-iff-parts! (dk-cite! 'image-membership-iff mr1-lam 'NN y)))
             (x (dk-skolem! (cadr ims)))
             (_1 (dk-split-all!))
             (eqn (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (caddr f) y))) (dk-asms))))
        (mr1-fk! x)
        (dk-lam-b-h! eqn)
        (dk-have! (list '< a (list 'mu (list 'f_ x))) (lambda () (subst (list '= (list 'mu (list 'f_ x)) y)) (mr-close-open!)))
        (ew x)
        (dk-conj-close!
          (lambda () (if (dk-asm? (dk-goal)) (ass)
                         (dk-ineq! (list '< a (list 'mu (list 'f_ x)))))))))))
(qed 'measure-below-approx)
(topic! 'measure-below-approx 'analysis)

;;; ======================================================================
;;; closed sets are Borel; the distance layers {x : 1/(k+1) <= d(x, C)} are closed
;;; ======================================================================
(sp (make-wff '(FORALL s (FORALL a (IMPLIES (IS-CLOSED s a) (IN a (BOREL-SETS s)))))))
(dk-peel!)
(define mrc-parts (mr-iff-parts! (dk-cite! 'is-closed 's 'a)))
(dk-cite! 'pfw-open-borel 's '(COMPLEMENT-IN (PTS s) a))
(dk-cite! 'pfw-borel-sigma-algebra 's)
(dk-cite! 'sigma-algebra-complement-closed '(PTS s) '(BOREL-SETS s) '(COMPLEMENT-IN (PTS s) a))
(subst (list '= 'a (cadr (dk-cite! 'complement-in-double '(PTS s) 'a))))
(mr-close-open!)
(qed 'closed-borel)
(topic! 'closed-borel 'analysis)

(define (mr-recip! k)              ; recip(k + 1), k in NN: typed, positive (idempotent)
  (let* ((k1 (list '+ k 1)) (rq (list 'RECIP k1)))
   (if (dk-asm? (list 'POS-RR rq))
    rq
    (begin
    (dk-cite! 'nn-in-rr k) (dk-type! k1 'RR)
    (dk-have! (list '< 0 k1) (lambda () (dk-cite! 'nn-zero-le k) (dk-ineq! (list '<= 0 k))))
    (mr-ne! k1 0 (list '< 0 k1))
    (mr-chain! (dk-fact! 'rr-recip-closed k1))
    (dk-cite! 'rr-recip-pos k1)
    (dk-cite! 'rr-pos-rr-of-lt rq)
    rq))))
(define (mr-layer m k fcl) (list 'SEP 'mex_ (list 'PTS m) (list '<= (list 'RECIP (list '+ k 1)) (list 'PT-SET-DIST m 'mex_ fcl))))
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-METRIC-SPACE m) (list 'FORALL 'fcl (list 'IMPLIES '(SUBSET fcl (PTS m))
  (list 'FORALL 'z (list 'IMPLIES '(IN z fcl) (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IS-CLOSED 'm (mr-layer 'm 'k 'fcl))))))))))))
(dk-peel!)
(set! mr-space 'm)
(define mrl-L (mr-layer 'm 'k 'fcl))
(define mrl-C (list 'COMPLEMENT-IN '(PTS m) mrl-L))
(define mrl-rk (mr-recip! 'k))
(define (mrl-d! x)                 ; d(x, fcl) real, >= 0
  (dk-split-all! (list (dk-cite! 'pt-set-dist-real 'm 'fcl 'z x)))
  (list 'PT-SET-DIST 'm x 'fcl))
(mac 'is-closed)
(mr-and-close!
  (lambda ()
    (let ((g0 (dk-goal)))
      (cond
        ((dk-asm? g0) (ass))
        ((dk-head-is? g0 'SUBSET)
         (mac 'subset-def) (let ((w (dk-di-var!))) (mr-sep-parts! (list 'IN w mrl-L)) (mr-close-open!)))
        (#t
         (mac 'is-open)
         (mr-and-close!
           (lambda ()
             (let ((g1 (dk-goal)))
               (cond
                 ((dk-asm? g1) (ass))
                 ((dk-head-is? g1 'SUBSET) (dk-cite! 'complement-in-subset mrl-L '(PTS m)) (mr-close-open!))
                 (#t
                  (let* ((lk (dk-peel!))
                         (y (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) lk)))
                         (_0 (mr-iff-parts! (dk-cite! 'complement-in-membership '(PTS m) mrl-L y)))
                         (dy (mrl-d! y))
                         (in-l! (lambda () (dk-have! (list 'IN y mrl-L) (lambda () (in-sep! (lambda () (mr-close-open!)))))
                                           (ai (list 'NOT (list 'IN y mrl-L))))))
                    (use-cases (dk-cite! 'rr-lt-trichotomy dy mrl-rk)
                      (lambda ()
                        (let ((r (list '- mrl-rk dy)))
                          (dk-type! r 'RR)
                          (dk-have! (list '< 0 r) (lambda () (dk-ineq! (list '< dy mrl-rk))))
                          (dk-cite! 'rr-pos-rr-of-lt r)
                          (ew r)
                          (dk-conj-close!
                            (lambda ()
                              (if (dk-asm? (dk-goal))
                                  (ass)
                                  (begin
                                    (mac 'subset-def)
                                    (let* ((w (dk-di-var!))
                                           (lt (mr-ball-parts! y w r))
                                           (dw (mrl-d! w)))
                                      (dk-cite! 'pt-set-dist-lipschitz 'm 'fcl 'z w y)
                                      (dk-cite! 'metric-sym 'm y w)
                                      (dk-cite! 'metric-dist-real 'm w y)
                                      (mac 'complement-in-membership)
                                      (dk-conj-close!
                                        (lambda ()
                                          (if (dk-asm? (dk-goal))
                                              (ass)
                                              (begin
                                                (di)
                                                (mr-sep-parts! (list 'IN w mrl-L))
                                                (dk-absurd! (list '<= mrl-rk dw)
                                                            (list '<= dw (list '+ (list '(DIST m) w y) dy))
                                                            (list '= (list '(DIST m) y w) (list '(DIST m) w y))
                                                            lt))))))))))))
                      (lambda () (dk-have! (list '<= mrl-rk dy) (lambda () (dk-ineq! (list '= dy mrl-rk)))) (in-l!))
                      (lambda () (dk-have! (list '<= mrl-rk dy) (lambda () (dk-ineq! (list '< mrl-rk dy)))) (in-l!))))))))))))))
(qed 'dist-layer-closed)
(set! mr-space 's)
(topic! 'dist-layer-closed 'analysis)

;;; ======================================================================
;;; a finite measure: every open set is approximated from inside by closed sets
;;; ======================================================================
(define mr-meas '(IS-MEASURE (PTS s) (BOREL-SETS s) mu))
(define (mr-setup!)                  ; metric s, measure mu: the sigma-algebra facts
  (dk-cite! 'ms-pts-is-set 's)
  (dk-cite! 'pfw-borel-sigma-algebra 's)
  (dk-cite! 'sigma-algebra-whole-in '(PTS s) '(BOREL-SETS s))
  (dk-cite! 'carrier-is-open 's)
  (mr-iff-parts! (dk-cite! 'is-sigma-algebra '(PTS s) '(BOREL-SETS s)))
  (mr-iff-parts! (dk-cite! 'is-measure '(PTS s) '(BOREL-SETS s) 'mu)))
(define (mr-sub-pts! a)              ; a Borel: a subset PTS s
  (let ((g0 (list 'SUBSET a '(PTS s))))
    (if (not (dk-asm? g0))
        (begin
          (dk-cite! 'subset-mem-fwd '(BOREL-SETS s) '(POWER (PTS s)) a)
          (dk-have! g0 (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (dk-cite! 'power-mem-in '(PTS s) a w) (mr-close-open!))))))
    g0))
(define (mr-mu-real! a)              ; a Borel, mu(PTS s) real:  mu(a) real, >= 0, <= mu(PTS s)
  (let ((ma (list 'mu a)))
    (mr-sub-pts! a)
    (dk-cite! 'measure-monotone '(PTS s) '(BOREL-SETS s) 'mu a '(PTS s))
    (dk-cite! 'fun-apply-type-c 'mu '(BOREL-SETS s) 'RR-POS-STAR a)
    (if (not (dk-asm? (list 'IN ma 'RR))) (mr-chain! (dk-fact! 'rr-pos-star-le-real-in-rr ma '(mu (PTS s)))))
    (dk-cite! 'rr-pos-star-nonneg ma)
    ma))
(define mro-C '(COMPLEMENT-IN (PTS s) u))
(define mro-P (list 'FORSOME 'mrq_ (list 'IN 'mrq_ mro-C)))
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'FORALL 'mu (list 'IMPLIES mr-meas
  (list 'IMPLIES '(IN (mu (PTS s)) RR) (list 'FORALL 'u (list 'IMPLIES '(IS-OPEN s u)
    (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
      '(FORSOME f (AND (IS-CLOSED s f) (AND (SUBSET f u) (<= (mu (COMPLEMENT-IN u f)) eps)))))))))))))))
(dk-peel!)
(mr-setup!)
(mr-pos! 'eps)
(mr-iff-parts! (dk-cite! 'is-open 's 'u))
(dk-cite! 'pfw-open-borel 's 'u)
(mr-mu-real! 'u)
(use-em mro-P
  (lambda ()
    (let* ((z (dk-skolem! mro-P))
           (_0 (mr-iff-parts! (dk-cite! 'complement-in-membership '(PTS s) 'u z)))
           (_1 (dk-cite! 'complement-in-subset 'u '(PTS s)))
           (_2 (dk-have! (list 'IS-CLOSED 's mro-C)
                 (lambda ()
                   (mac 'is-closed)
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-asm? (dk-goal))
                           (ass)
                           (begin (subst (dk-cite! 'complement-in-double '(PTS s) 'u)) (mr-close-open!))))))))
           (lay (lambda (k) (mr-layer 's k mro-C)))
           (ex (list 'FORSOME 'mrb_ (list 'AND '(IN mrb_ (FUN NN (BOREL-SETS s)))
                 (list 'FORALL 'mrn_ (list 'IMPLIES '(IN mrn_ NN) (list '== '(mrb_ mrn_) (lay 'mrn_)))))))
           (_3 (dk-have! ex
                 (lambda ()
                   (ew (list 'VNB-LAMBDA 'mrn_ 'NN (lay 'mrn_)))
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-head-is? (dk-goal) 'IN)
                           (dk-lam-type! (lambda () (let ((n (dk-di-var!)))
                                                       (dk-cite! 'dist-layer-closed 's mro-C z n)
                                                       (dk-cite! 'closed-borel 's (lay n))
                                                       (mr-close-open!))))
                           (let ((n (dk-di-var!))) (dk-close-if! (lambda () (dk-lam-b!)) qrfl))))))))
           (b (dk-skolem! ex))
           (val (begin (dk-split-all!) (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f b) (dk-contains? f 'SEP))) "the layer values")))
           (bk! (lambda (k) (dk-apply! val k) (list b k)))
           (bu (list 'BIG-UNION 'n_ 'NN (list b 'n_))))
      ;; increasing
      (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'SUBSET (list b 'n_) (list b '(succ n_)))))
        (lambda ()
          (let* ((n (dk-di-var!)) (sn (begin (dk-cite! 'nn-succ-closed n) (list 'succ n))))
            (bk! n) (bk! sn)
            (dk-cite! 'nn-le-succ n)
            (dk-cite! 'dist-layer-mono 's mro-C n sn)
            (subst (list '= (list b n) (lay n)))
            (subst (list '= (list b sn) (lay sn)))
            (mr-close-open!))))
      ;; the union is u
      (mr-ext2! bu 'u
        (lambda (w)
          (let* ((ka (mr-bu-open! w bu)) (k (car ka))
                 (wk (dk-rewrite-h! (cdr ka) (bk! k) (lay k))))
            (mr-sep-parts! wk)
            (dk-cite! 'dist-layer-disjoint 's mro-C k w)
            (pbc)
            (dk-have! (list 'IN w mro-C) (lambda () (mac 'complement-in-membership) (dk-conj-close! (lambda () (ass)))))
            (ai (list 'NOT (list 'IN w mro-C)))))
        (lambda (w)
          (dk-cite! 'subset-mem-fwd 'u '(PTS s) w)
          (dk-have! (list 'NOT (list 'IN w mro-C))
            (lambda () (di) (mr-iff-parts! (dk-cite! 'complement-in-membership '(PTS s) 'u w)) (ai (list 'NOT (list 'IN w 'u)))))
          (let* ((k (dk-skolem! (dk-cite! 'dist-layer-cover 's mro-C w))) (_4 (dk-split-all!)))
            (bk! k)
            (dk-have! (list 'IN w (list b k)) (lambda () (subst (list '= (list b k) (lay k))) (mr-close-open!)))
            (mr-bu-close! k))))
