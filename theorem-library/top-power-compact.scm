;;; top-power-compact.scm -- A CONFINED CLOSED SET IN A POWER OF A TOPOLOGICAL SPACE IS COMPACT.
;;; For a set ff, a topological space tt and a family kk of subsets of PTS(tt) indexed by ff, each compact
;;; in the subspace topology, a set aa of points of the power TPRODUCT-TOP(ff, y |-> tt) that is CONFINED
;;; (g(y) in kk(y) for every g in aa and y in ff) and closed in the power is compact in the subspace
;;; topology (Tychonoff on the product of the subspaces kk(y)).  This is the generic form of
;;; `pointwise-bounded-closed-compact' (theorem-library/tvs-alaoglu.scm, which has the real line and
;;; intervals built in); the proof is the same, the factors abstracted.
;;; Agent BA-1F, wave 2026-11-09.  Destination: theorem-library/top-power-compact.scm.  Library: analysis.
;;; All proofs modulo 0.  Helper prefix: tpc-.
;;; LOAD WINDOW: after theorem-library/tvs-alaoglu.scm (subspace-inclusion-continuous, hom-into-subspace,
;;; closed-in-subspace, closed-subset-compact, subspace-of-subspace) and the top-product file (tychonoff,
;;; tprod-*, tproj-*, compact-t-continuous-onto, hom-top-space-ptwise-eq, hom-top-space-compose).

(define (tpc-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** top-power-compact: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (h) (display "      asm: ") (display (expression->string h)) (newline))
                              (list-head (dk-asms-of l) (min 40 (length (dk-asms-of l))))))
                  (dk-open-leaves))
        (error "top-power-compact: unfinished" name))))
(define (tpc-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    c))
(define (tpc-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (tpc-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define (tpc-grounded?) (sequent-node-grounded? (proof-state-focus *ps*)))
(define (tpc-beta-eq! e)              ; prove the equation E by beta
  (if (not (dk-asm? e)) (dk-have! e (lambda () (dk-lam-b!) (if (not (tpc-grounded?)) (rfl)))))
  e)
(define (tpc-top! s)
  (if (not (dk-asm? (list 'IN (list 'PTS s) 'SET)))
      (begin
        (dk-project! (list 'IN (list 'PTS s) (list 'OPENS s)) 'is-top-space (list 'IS-TOP-SPACE s))
        (dk-cite! 'membership-implies-sethood (list 'PTS s) (list 'OPENS s)))))
(define (tpc-sub t a) (list 'SUBSPACE-TOP t a))
(define (tpc-sub-facts! t a)           ; IS-TOP-SPACE t, a subset PTS t: the subspace's facts
  (tpc-top! t)
  (if (not (dk-asm? (list 'IN a 'SET))) (dk-cite! 'subclass-of-set-is-set a (list 'PTS t)))
  (if (not (dk-asm? (list 'IS-TOP-SPACE (tpc-sub t a))))
      (begin (dk-cite! 'subspace-top-is-top-space t a)
             (dk-cite! 'subspace-top-pts t a))))

(define tpc-FF (list 'VNB-LAMBDA 'pcn_ 'ff 'tt))
(define tpc-KF (list 'VNB-LAMBDA 'pcn_ 'ff '(SUBSPACE-TOP tt (kk pcn_))))
(define tpc-PR (list 'TPRODUCT-TOP 'ff tpc-FF))
(define tpc-PRP (list 'TPROD-PTS 'ff tpc-FF))
(define tpc-KI (list 'TPRODUCT-TOP 'ff tpc-KF))
(define tpc-KP (list 'TPROD-PTS 'ff tpc-KF))
(define (tpc-k y) (list 'kk y))
(define (tpc-kfs y) (tpc-sub 'tt (tpc-k y)))
(define tpc-hsub '(FORALL pcy_ (IMPLIES (IN pcy_ ff) (IN (kk pcy_) (POWER (PTS tt))))))
(define tpc-hcpt '(FORALL pcy_ (IMPLIES (IN pcy_ ff) (IS-COMPACT-T (SUBSPACE-TOP tt (kk pcy_))))))
(define tpc-hconf '(FORALL pcy_ (IMPLIES (IN pcy_ ff) (FORALL pcg_ (IMPLIES (IN pcg_ aa) (IN (pcg_ pcy_) (kk pcy_)))))))
(define tpc-hyp (list '(IN ff SET) '(IS-TOP-SPACE tt) tpc-hsub tpc-hcpt))

(define (tpc-ksub! y)                  ; y in ff: (IN (kk y) (POWER (PTS tt))), (IN (kk y) SET), (SUBSET (kk y) (PTS tt))
  (let ((kv (tpc-k y)))
    (if (not (dk-asm? (list 'SUBSET kv '(PTS tt))))
        (begin
          (if (not (dk-asm? (list 'IN kv '(POWER (PTS tt))))) (dk-apply! (dk-ctx-form tpc-hsub) y))
          (dk-cite! 'power-mem-sethood '(PTS tt) kv)
          (dk-have! (list 'SUBSET kv '(PTS tt))
            (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (dk-cite! 'power-mem-in '(PTS tt) kv z) (dk-ass!))))))))
(define (tpc-ffy! y) (tpc-beta-eq! (list '= (list tpc-FF y) 'tt)))
(define (tpc-kfy! y)                   ; y in ff: (= (KF y) (SUBSPACE-TOP tt (kk y))), with the subspace's facts
  (let ((e (list '= (list tpc-KF y) (tpc-kfs y))))
    (if (not (dk-asm? e))
        (begin
          (tpc-ksub! y)
          (tpc-sub-facts! 'tt (tpc-k y))
          (tpc-beta-eq! e)))
    e))
(define (tpc-setup!)
  (tpc-top! 'tt)
  (dk-have! (list 'IS-TOP-FAMILY 'ff tpc-FF)
    (lambda () (mac 'is-top-family) (dk-conj-close! (lambda () (if (not (dk-ass!)) (let ((y (dk-di-var!))) (subst (tpc-ffy! y)) (dk-ass!)))))))
  (dk-have! (list 'IS-TOP-FAMILY 'ff tpc-KF)
    (lambda () (mac 'is-top-family) (dk-conj-close! (lambda () (if (not (dk-ass!)) (let ((y (dk-di-var!))) (subst (tpc-kfy! y)) (dk-ass!)))))))
  (for-each (lambda (fam) (dk-split! (dk-cite! 'tprod-sets 'ff fam)) (dk-cite! 'tprod-top-pts 'ff fam)
                          (dk-cite! 'tprod-top-is-top-space 'ff fam))
            (list tpc-FF tpc-KF)))
;; a point x of TPROD-PTS(ff, fam): its coordinate clause (landed)
(define (tpc-pts-out! fam x)
  (let* ((im (dk-cite! 'tprod-pts-mem 'ff fam x)) (r (caddr im)))
    (if (not (dk-asm? (caddr r))) (begin (dk-have! r (lambda () (if (dk-only! im (list 'IN x (list 'TPROD-PTS 'ff fam))) (prop)))) (dk-split! r)))
    (caddr r)))
(define (tpc-fun-ff! x fam)            ; x in TPROD-PTS(ff, fam): (IN x (FUN ff))
  (let* ((bu (list 'BIG-UNION 'tpj_ 'ff (list 'PTS (list fam 'tpj_))))
         (fi (dk-cite! 'fun-codomain-iff 'ff bu x)))
    (tpc-pts-out! fam x)
    (dk-have! (list 'IN x (list 'FUN 'ff)) (lambda () (if (dk-only! fi (list 'IN x (list 'FUN 'ff bu))) (prop))))))
(define (tpc-kf-out! x y)              ; (IN (x y) (PTS (KF y))) in context: land (IN (x y) (kk y)) and (IN (x y) (PTS tt))
  (tpc-kfy! y)
  (let* ((h1 (dk-rewrite-h! (list 'IN (list x y) (list 'PTS (list tpc-KF y))) (list tpc-KF y) (tpc-kfs y))))
    (dk-rewrite-h! h1 (list 'PTS (tpc-kfs y)) (tpc-k y))
    (dk-cite! 'subset-mem-fwd (tpc-k y) '(PTS tt) (list x y))))
(define (tpc-coord-close! fam y)       ; goal (IN _ (PTS (fam y))) or a bu-mi leaf
  (if (not (dk-ass!))
      (begin
        (if (equal? fam tpc-FF)
            (subst (tpc-ffy! y))
            (begin (subst (tpc-kfy! y)) (subst (list '== (list 'PTS (tpc-kfs y)) (tpc-k y)))))
        (dk-ass!))))
(define (tpc-into! fam x coord!)       ; (IN x (TPROD-PTS ff fam)) from x in FUN(ff); COORD! y lands the coordinate fact
  (let* ((bur (list 'BIG-UNION 'tpj_ 'ff (list 'PTS (list fam 'tpj_))))
         (im (dk-cite! 'tprod-pts-mem 'ff fam x))
         (fi (dk-cite! 'fun-codomain-iff 'ff bur x)))
    (dk-have! (caddr (caddr fi))
      (lambda () (let ((y (dk-di-var!)))
                   (coord! y)
                   (for-each (lambda (l) (dk-focus! l) (tpc-coord-close! fam y))
                             (dk-opened (lambda () (bu-mi y)))))))
    (dk-have! (list 'IN x (list 'FUN 'ff bur)) (lambda () (if (dk-only! fi (list 'IN x (list 'FUN 'ff)) (caddr (caddr fi))) (prop))))
    (dk-have! (caddr (caddr im))
      (lambda () (let ((y (dk-di-var!))) (coord! y) (tpc-coord-close! fam y))))
    (dk-have! (list 'IN x (list 'TPROD-PTS 'ff fam))
      (lambda () (tpc-and! (list 'IN x (list 'FUN 'ff bur)) (caddr (caddr im))) (if (dk-only! im (caddr im)) (prop))))))

;;; ---- (1) the product of the subspaces lies in the power -----------------------------------------------
(sp (make-wff (tpc-alls '(ff tt kk) (tpc-imps tpc-hyp (list 'SUBSET tpc-KP tpc-PRP)))))
(dk-peel!)
(tpc-setup!)
(mac 'subset-def)
(let* ((x (dk-di-var!)) (cl (tpc-pts-out! tpc-KF x)))
  (tpc-fun-ff! x tpc-KF)
  (tpc-into! tpc-FF x (lambda (y) (dk-apply! cl y) (tpc-kf-out! x y)))
  (dk-ass!))
(tpc-qed! 'confined-product-in-power)

;;; ---- (2) the identity of the product of the subspaces into the power is continuous (into the subspace) --
(define tpc-JJ (list 'VNB-LAMBDA 'pcp_ tpc-KP 'pcp_))
(define (tpc-jval! q) (tpc-beta-eq! (list '= (list tpc-JJ q) q)))
(sp (make-wff (tpc-alls '(ff tt kk) (tpc-imps tpc-hyp (list 'IS-HOM-TOP-SPACE tpc-KI (tpc-sub tpc-PR tpc-KP) tpc-JJ)))))
(dk-peel!)
(tpc-setup!)
(dk-cite! 'confined-product-in-power 'ff 'tt 'kk)
(dk-have! (list 'IN tpc-JJ (list 'FUN (list 'PTS tpc-KI) tpc-PRP))
  (lambda () (subst (list '== (list 'PTS tpc-KI) tpc-KP))
             (dk-lam-type! (lambda () (let ((p (dk-di-var!))) (dk-cite! 'subset-mem-fwd tpc-KP tpc-PRP p) (dk-ass!))) (lambda () (dk-ass!)))))
(let* ((iff (dk-cite! 'tprod-hom-iff 'ff tpc-FF tpc-KI tpc-JJ)))
  (dk-have! (caddr iff)
    (lambda ()
      (let* ((k (dk-di-var!)) (kv (tpc-k k)) (sk (tpc-kfs k))
             (cm (list 'VNB-LAMBDA 'tpq_ (list 'PTS tpc-KI) (list (list tpc-JJ 'tpq_) k)))
             (pj (list 'TPROJ 'ff tpc-KF k)) (inc (list 'VNB-LAMBDA 'b6q_ kv 'b6q_)) (g (list 'COMPOSE inc pj)))
        (subst (tpc-ffy! k))
        (tpc-kfy! k)
        (dk-cite! 'tproj-continuous 'ff tpc-KF k)
        (dk-rewrite-h! (list 'IS-HOM-TOP-SPACE tpc-KI (list tpc-KF k) pj) (list tpc-KF k) sk)
        (dk-cite! 'subspace-inclusion-continuous 'tt kv)
        (dk-cite! 'hom-top-space-compose tpc-KI sk 'tt pj inc)
        (dk-project! (list 'IN pj (list 'FUN (list 'PTS tpc-KI) (list 'PTS sk))) 'is-hom-top-space-def (list 'IS-HOM-TOP-SPACE tpc-KI sk pj))
        (dk-project! (list 'IN inc (list 'FUN (list 'PTS sk) '(PTS tt))) 'is-hom-top-space-def (list 'IS-HOM-TOP-SPACE sk 'tt inc))
        (tpc-and! (list 'IN pj (list 'FUN (list 'PTS tpc-KI) (list 'PTS sk))) (list 'IN inc (list 'FUN (list 'PTS sk) '(PTS tt))))
        (let ((ca (dk-cite! 'compose-apply (list 'PTS tpc-KI) (list 'PTS sk) '(PTS tt) inc pj)))
          (define (val! q)             ; q in PTS KI: (cm q) = (q k), (g q) = (q k), (q k) in kk(k)
            (dk-have! (list 'IN q (list 'PTS tpc-KI)) (lambda () (subst (list '== (list 'PTS tpc-KI) tpc-KP)) (dk-ass!)))
            (dk-have! (list 'IN q tpc-KP) (lambda () (subst (list '== tpc-KP (list 'PTS tpc-KI))) (dk-ass!)))
            (let ((cl (tpc-pts-out! tpc-KF q))) (dk-apply! cl k) (tpc-kf-out! q k))
            (tpc-jval! q)
            (dk-have! (list '= (list cm q) (list q k))
              (lambda () (dk-lam-b!)
                         (if (not (tpc-grounded?)) (begin (subst (tpc-jval! q)) (if (not (tpc-grounded?)) (rfl))))))
            (dk-apply! ca q)
            (dk-cite! 'tproj-value 'ff tpc-KF k q)
            (dk-have! (list '= (list g q) (list q k))
              (lambda () (subst (list '= (list g q) (list inc (list pj q)))) (subst (list '= (list pj q) (list q k)))
                         (dk-lam-b!) (if (not (tpc-grounded?)) (rfl))))
            #t)
          (dk-have! (list 'IN cm (list 'FUN (list 'PTS tpc-KI) '(PTS tt)))
            (lambda () (dk-lam-type! (lambda () (let ((q (dk-di-var!))) (val! q)
                                                  (if (dk-contains? (dk-goal) tpc-JJ) (subst (tpc-jval! q)))
                                                  (dk-ass!)))
                                     (lambda () (if (not (dk-ass!)) (begin (subst (list '== (list 'PTS tpc-KI) tpc-KP)) (dk-ass!)))))))
          (dk-have! (list 'FORALL 'tpq_ (list 'IMPLIES (list 'IN 'tpq_ (list 'PTS tpc-KI)) (list '= (list cm 'tpq_) (list g 'tpq_))))
            (lambda () (let ((q (dk-di-var!))) (val! q) (subst (list '= (list cm q) (list q k))) (subst (list '= (list g q) (list q k))) (rfl))))
          (dk-cite! 'hom-top-space-ptwise-eq tpc-KI 'tt g cm)
          (dk-ass!)))))
  (dk-have! (list 'IS-HOM-TOP-SPACE tpc-KI tpc-PR tpc-JJ) (lambda () (if (dk-only! iff (caddr iff)) (prop)))))
(dk-have! (list 'SUBSET tpc-KP (list 'PTS tpc-PR)) (lambda () (subst (list '== (list 'PTS tpc-PR) tpc-PRP)) (dk-ass!)))
(dk-have! (list 'FORALL 'b6x_ (list 'IMPLIES (list 'IN 'b6x_ (list 'PTS tpc-KI)) (list 'IN (list tpc-JJ 'b6x_) tpc-KP)))
  (lambda () (let ((q (dk-di-var!))) (dk-rewrite-h! (list 'IN q (list 'PTS tpc-KI)) (list 'PTS tpc-KI) tpc-KP) (subst (tpc-jval! q)) (dk-ass!))))
(dk-cite! 'hom-into-subspace tpc-KI tpc-PR tpc-KP tpc-JJ)
(dk-ass!)
(tpc-qed! 'confined-product-identity)

;;; ---- (3) a confined set of points of the power lies in the product of the subspaces ------------------
(sp (make-wff (tpc-alls '(ff tt kk aa) (tpc-imps (append tpc-hyp (list (list 'SUBSET 'aa tpc-PRP) tpc-hconf)) (list 'SUBSET 'aa tpc-KP)))))
(dk-peel!)
(tpc-setup!)
(mac 'subset-def)
(let ((x (dk-di-var!)))
  (dk-cite! 'subset-mem-fwd 'aa tpc-PRP x)
  (tpc-fun-ff! x tpc-FF)
  (tpc-into! tpc-KF x (lambda (y) (if (not (dk-asm? (list 'IN (list x y) (tpc-k y)))) (dk-apply! (dk-ctx-form tpc-hconf) y x))))
  (dk-ass!))
(tpc-qed! 'confined-in-product)

;;; ---- (4) THE THEOREM ---------------------------------------------------------------------------------
(sp (make-wff (tpc-alls '(ff tt kk aa) (tpc-imps (append tpc-hyp (list (list 'SUBSET 'aa tpc-PRP) tpc-hconf (list 'IS-TOP-CLOSED tpc-PR 'aa)))
                                           (list 'IS-COMPACT-T (tpc-sub tpc-PR 'aa))))))
(dk-peel!)
(tpc-setup!)
(let* ((sk (tpc-sub tpc-PR tpc-KP)))
  (dk-cite! 'confined-product-in-power 'ff 'tt 'kk)
  (dk-cite! 'confined-product-identity 'ff 'tt 'kk)
  (dk-cite! 'confined-in-product 'ff 'tt 'kk 'aa)
  (dk-have! (list 'FORALL 'tpi_ (list 'IMPLIES '(IN tpi_ ff) (list 'IS-COMPACT-T (list tpc-KF 'tpi_))))
    (lambda () (let ((y (dk-di-var!))) (subst (tpc-kfy! y)) (dk-apply! (dk-ctx-form tpc-hcpt) y) (dk-ass!))))
  (dk-cite! 'tychonoff 'ff tpc-KF)
  (dk-have! (list 'SUBSET tpc-KP (list 'PTS tpc-PR)) (lambda () (subst (list '== (list 'PTS tpc-PR) tpc-PRP)) (dk-ass!)))
  (tpc-sub-facts! tpc-PR tpc-KP)
  (dk-have! (list 'FORALL 'tpy_ (list 'IMPLIES (list 'IN 'tpy_ (list 'PTS sk)) (list 'FORSOME 'tpx_ (list 'AND (list 'IN 'tpx_ (list 'PTS tpc-KI)) (list '= (list tpc-JJ 'tpx_) 'tpy_)))))
    (lambda () (let ((q (dk-di-var!)))
                 (dk-rewrite-h! (list 'IN q (list 'PTS sk)) (list 'PTS sk) tpc-KP)
                 (tpc-jval! q)
                 (ew q)
                 (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst (list '== (list 'PTS tpc-KI) tpc-KP)) (dk-ass!))))))))
  (dk-cite! 'compact-t-continuous-onto tpc-KI sk tpc-JJ)
  (dk-cite! 'closed-in-subspace tpc-PR tpc-KP 'aa)
  (dk-cite! 'closed-subset-compact sk 'aa)
  (dk-cite! 'subspace-of-subspace tpc-PR tpc-KP 'aa)
  (subst (list '= (tpc-sub tpc-PR 'aa) (tpc-sub sk 'aa)))
  (dk-ass!))
(tpc-qed! 'confined-closed-compact)

