;;; ---- typing a function term built from + and scalar multiples ----
;;; the op applications of the module, reduced (what lam-b will produce)
(define (pex-red t)
  (cond ((and (pair? t) (equal? (car t) pex-vaddl)) (pex-sum (pex-red (cadr t)) (pex-red (caddr t))))
        ((and (pair? t) (equal? (car t) pex-vnegl)) (pex-scl '(- 1) (pex-red (cadr t))))
        ((and (pair? t) (equal? (car t) pex-actl)) (pex-scl (pex-red (cadr t)) (pex-red (caddr t))))
        ((and (pair? t) (equal? (car t) '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN RR RR) (+ x_ y_))))
         (list '+ (cadr t) (caddr t)))
        ((and (pair? t) (equal? (car t) '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN RR RR) (* x_ y_))))
         (list '* (cadr t) (caddr t)))
        (#t t)))
(define (pex-in-c! t0)
  (define t (pex-red t0))
  (cond
    ((dk-asm? (list 'IN t pex-C)) #t)
    ((equal? t pex-zero) (dk-cite! 'pex-zero-in 's))
    ((and (pair? t) (eq? (car t) 'VNB-LAMBDA) (equal? (caddr t) '(PTS s)))
     (let ((b (cadddr t)))
       (cond ((eq? (car b) '+)
              (let ((f (car (cadr b))) (g (car (caddr b))))
                (pex-in-c! f) (pex-in-c! g)
                (dk-cite! 'rmc-cont-fns-add 's f g)))
             ((eq? (car b) '*)
              (let ((c (cadr b)) (f (car (caddr b))))
                (if (not (dk-asm? (list 'IN c 'RR))) (dk-have! (list 'IN c 'RR) (lambda () (in-rr))))
                (pex-in-c! f)
                (dk-cite! 'rmc-cont-fns-scale 's c f)))
             (#t (error "pex-in-c!: unknown function term" t)))))
    (#t (error "pex-in-c!: not typed" t0 (expression->string (dk-goal))))))
(define (pex-in-fun! t)
  (pex-in-c! t)
  (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's t))))

;;; the application redexes of the goal's operations, argument-typed, then reduced
(define (pex-type-args! g)
  (if (pair? g)
      (begin
        (for-each pex-type-args! g)
        (cond ((and (pair? (car g)) (equal? (car g) pex-vaddl))
               (pex-in-c! (cadr g)) (pex-in-c! (caddr g)))
              ((and (pair? (car g)) (equal? (car g) pex-vnegl))
               (pex-in-c! (cadr g)))
              ((and (pair? (car g)) (equal? (car g) pex-actl))
               (let ((c (pex-red (cadr g))))
                 (if (not (dk-asm? (list 'IN c 'RR))) (dk-have! (list 'IN c 'RR) (lambda () (in-rr)))))
               (pex-in-c! (caddr g)))))))
(define (pex-fval! f x)
  (pex-in-fun! f)
  (dk-cite! 'fun-apply-type-c f '(PTS s) 'RR x))
;;; (IN T (FUN (PTS s) RR)) for T a symbol in C or a lambda over PTS s whose body is
;;; real arithmetic in values of functions in C
(define (pex-lam-fun! t)
  (if (symbol? t)
      (begin (pex-in-fun! t) (ass))
      (dk-lam-type!
        (lambda ()
          (let ((x (dk-di-var!)))
            (for-each (lambda (f) (if (not (dk-asm? (list 'IN (list f x) 'RR))) (pex-fval! f x)))
                      (pex-fun-atoms (dk-goal) x))
            (in-rr))))))
;;; equality of two function terms, pointwise by crs
(define (pex-eq!)
  (pex-type-args! (dk-goal))
  (if (not (dk-lam-b!))
      (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
        (if (equal? l r)
            (begin (pex-in-c! l) (rfl))
            (dk-fun-ext! l r '(PTS s) 'RR
              (lambda () (pex-lam-fun! l))
              (lambda () (pex-lam-fun! r))
              (lambda (v)
                (let loop () (if (not (dk-lam-b!)) (if (dk-contains? (dk-goal) 'VNB-LAMBDA) (loop))))
                (if (not (proof-done? *ps*))
                    (if (and (pair? (dk-goal)) (eq? (car (dk-goal)) '=))
                        (begin
                          (for-each (lambda (f) (if (not (dk-asm? (list 'IN (list f v) 'RR))) (pex-fval! f v)))
                                    (pex-fun-atoms (dk-goal) v))
                          (crs))))))))))
(define (pex-fun-atoms g v)
  (let walk ((t g) (acc '()))
    (cond ((and (pair? t) (= (length t) 2) (symbol? (car t)) (equal? (cadr t) v)
                (not (memq (car t) '(- abs))))
           (if (memq (car t) acc) acc (cons (car t) acc)))
          ((pair? t) (fold-left (lambda (a x) (walk x a)) acc t))
          (#t acc))))

(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'IS-MODULE pex-CF)))))
(dk-peel!)
(dk-cite! 'pex-c-set 's)
(dk-cite! 'ms-pts-is-set 's)
(dk-cite! 'rr-is-set)
(pex-m1!)
(mac 'is-module)
(for-each (lambda (nm) (dk-cite! nm 's))
          '(pex-cf-scal pex-cf-vec pex-cf-vadd pex-cf-vzero pex-cf-vneg pex-cf-act))
(subst (list '== (pex-acc 'SCAL) pex-R))
(subst (list '== (pex-acc 'VEC) pex-C))
(subst (list '== (pex-acc 'VADD) pex-vaddl))
(subst (list '== (pex-acc 'VZERO) pex-zero))
(subst (list '== (pex-acc 'VNEG) pex-vnegl))
(subst (list '== (pex-acc 'ACT) pex-actl))
(for-each (lambda (m) (if (dk-contains? (dk-goal) (car m)) (mac (cadr m))))
          (list (list (list 'CARR pex-R) 'rr-scalar-ring-carr) (list (list 'ADD pex-R) 'rr-scalar-ring-add)
                (list (list 'MUL pex-R) 'rr-scalar-ring-mul) (list (list 'ONE pex-R) 'rr-scalar-ring-one)))
(len-r)
(define (pex-law!)
  (let ((g (dk-goal)))
    (cond
      ((dk-asm? g) (ass))
      ((equal? g '(= 6 6)) (rfl))
      ((dk-head-is? g 'IS-RING)
       (fact 'rr-is-normed-field)
       (fact 'normed-field-as-commutative-ring-is-commutative-ring 'RR-NORMED-FIELD)
       (fact 'commutative-ring-is-ring pex-R)
       (ass))
      ((and (dk-head-is? g 'IN) (equal? (cadr g) pex-zero)) (dk-cite! 'pex-zero-in 's) (ass))
      ((and (dk-head-is? g 'IN) (pair? (cadr g)) (eq? (car (cadr g)) 'VNB-LAMBDA))
       (dk-lam-type!
         (lambda ()
           (dk-peel!)
           (let ((b (cadr (dk-goal))))
             (pex-in-c! b)
             (ass)))))
      ((memq (car g) '(IS-ASSOCIATIVE IS-COMMUTATIVE IS-IDENTITY HAS-INVERSES))
       (mac (case (car g) ((IS-ASSOCIATIVE) 'is-associative) ((IS-COMMUTATIVE) 'is-commutative)
                          ((IS-IDENTITY) 'is-identity) ((HAS-INVERSES) 'has-inverses)))
       (dk-peel!)
       (if (dk-head-is? (dk-goal) 'AND)
           (dk-conj-close! pex-eq!)
           (pex-eq!)))
      ((dk-head-is? g 'FORALL)
       (dk-peel!)
       (pex-eq!))
      (#t (error "pex-law!: unexpected conjunct" (expression->string g))))))
(dk-conj-close! pex-law!)
(pex-qed! 'pex-cf-module)

;;; ---- the module operations of CF, applied ----
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s)
  (pex-fa 'f_ pex-C (pex-fa 'g_ pex-C (list '= (list (pex-acc 'VADD) 'f_ 'g_) (pex-sum 'f_ 'g_))))))))
(dk-peel!)
(dk-cite! 'pex-cf-vadd 's)
(subst (list '== (pex-acc 'VADD) pex-vaddl))
(dk-cite! 'rmc-cont-fns-add 's 'f_ 'g_)
(if (not (dk-lam-b!)) (rfl))
(pex-qed! 'pex-vadd-val)

(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s)
  (pex-fa 'c_ 'RR (pex-fa 'f_ pex-C (list '= (list (pex-acc 'ACT) 'c_ 'f_) (pex-scl 'c_ 'f_))))))))
(dk-peel!)
(dk-cite! 'pex-cf-act 's)
(subst (list '== (pex-acc 'ACT) pex-actl))
(dk-cite! 'rmc-cont-fns-scale 's 'c_ 'f_)
(if (not (dk-lam-b!)) (rfl))
(pex-qed! 'pex-act-val)

(sp (make-wff (list 'FORALL 's (list '= (pex-acc 'SCAL) pex-R))))
(dk-peel!)
(slot 'SCAL)
(nth-r)
(mac 'NORMED-FIELD-AS-COMMUTATIVE-RING)
(quietly (lambda () (surface-goal! 'RR-NORMED-FIELD)))
(rfl)
(pex-qed! 'pex-cf-pin)

;;; =====================================================================
;;; (2) THE DATA: a subspace vs of C(s) holding 1, a positive linear lm on it
;;; =====================================================================
(define pex-vsum (pex-fa 'f_ 'vs (pex-fa 'g_ 'vs (list 'IN (pex-sum 'f_ 'g_) 'vs))))
(define pex-vscl (pex-fa 'c_ 'RR (pex-fa 'f_ 'vs (list 'IN (pex-scl 'c_ 'f_) 'vs))))
(define pex-ladd (pex-fa 'f_ 'vs (pex-fa 'g_ 'vs (list '= (list 'lm (pex-sum 'f_ 'g_)) '(+ (lm f_) (lm g_))))))
(define pex-lscl (pex-fa 'c_ 'RR (pex-fa 'f_ 'vs (list '= (list 'lm (pex-scl 'c_ 'f_)) '(* c_ (lm f_))))))
(define pex-lpos (pex-fa 'f_ 'vs (list 'IMPLIES (pex-fa 'x_ '(PTS s) '(<= 0 (f_ x_))) '(<= 0 (lm f_)))))
(define (pex-hyps body)
  (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'IMPLIES '(IS-COMPACT s)
   (list 'FORALL 'vs (list 'IMPLIES (list 'SUBSET 'vs pex-C)
    (list 'IMPLIES pex-vsum (list 'IMPLIES pex-vscl (list 'IMPLIES (list 'IN pex-one 'vs)
     (list 'FORALL 'lm (list 'IMPLIES '(IN lm (FUN vs RR))
      (list 'IMPLIES pex-ladd (list 'IMPLIES pex-lscl (list 'IMPLIES pex-lpos body))))))))))))))
(define (pex-in-vs-c! v) (dk-cite! 'subset-mem-fwd 'vs pex-C v))
(define (pex-vs-sum! f g) (pex-apply! (dk-ctx-form pex-vsum) f g))
(define (pex-vs-scl! c f) (pex-apply! (dk-ctx-form pex-vscl) c f))
(define (pex-lm-val! v) (dk-cite! 'fun-apply-type-c 'lm 'vs 'RR v))
(define (pex-open!)
  (dk-peel!)
  (pex-m1!)
  (dk-cite! 'rr-zero-in)
  (dk-cite! 'ms-pts-is-set 's)
  (dk-cite! 'pex-c-set 's))

;;; the zero function is in vs, and lm(0) = 0
(sp (make-wff (pex-hyps (list 'AND (list 'IN pex-zero 'vs) (list '= (list 'lm pex-zero) 0)))))
(pex-open!)
(dk-cite! 'rr-one-in)
(pex-vs-scl! 0 pex-one)
(pex-apply! (dk-ctx-form pex-lscl) 0 pex-one)
(pex-in-vs-c! pex-one)
(pex-lm-val! pex-one)
(dk-have! (list '= (pex-scl 0 pex-one) pex-zero)
  (lambda () (pex-eq!)))
(dk-conj-close!
  (lambda ()
    (subst (list '= pex-zero (pex-scl 0 pex-one)))
    (if (dk-head-is? (dk-goal) 'IN) (ass)
        (begin
          (pex-lm-val! (pex-scl 0 pex-one))
          (dk-ineq! (list '= (list 'lm (pex-scl 0 pex-one)) (list '* 0 (list 'lm pex-one)))
                    (list 'IN (list 'lm pex-one) 'RR) (list 'IN (list 'lm (pex-scl 0 pex-one)) 'RR))))))
(pex-qed! 'pex-vs-zero)

;;; lm is monotone on vs
(sp (make-wff (pex-hyps (pex-fa 'f_ 'vs (pex-fa 'g_ 'vs (list 'IMPLIES (pex-fa 'x_ '(PTS s) '(<= (f_ x_) (g_ x_)))
   '(<= (lm f_) (lm g_))))))))
(pex-open!)
(let* ((mf (pex-scl pex-m1 'f_)) (h (pex-sum 'g_ mf)))
  (pex-in-vs-c! 'f_) (pex-in-vs-c! 'g_)
  (pex-vs-scl! pex-m1 'f_)
  (pex-vs-sum! 'g_ mf)
  (pex-apply! (dk-ctx-form pex-ladd) 'g_ mf)
  (pex-apply! (dk-ctx-form pex-lscl) pex-m1 'f_)
  (pex-lm-val! 'f_) (pex-lm-val! 'g_) (pex-lm-val! mf)
  (dk-have! (pex-fa 'x_ '(PTS s) (list '<= 0 (list h 'x_)))
    (lambda ()
      (let ((x (dk-di-var!)))
        (pex-fval! 'f_ x) (pex-fval! 'g_ x)
        (pex-apply! (dk-ctx-form (pex-fa 'x_ '(PTS s) '(<= (f_ x_) (g_ x_)))) x)
        (let loop () (if (not (dk-lam-b!)) (if (dk-contains? (dk-goal) 'VNB-LAMBDA) (loop))))
        (dk-ineq! (list '<= (list 'f_ x) (list 'g_ x)) (list 'IN (list 'f_ x) 'RR) (list 'IN (list 'g_ x) 'RR)))))
  (pex-apply! (dk-ctx-form pex-lpos) h)
  (pex-lm-val! h)
  (dk-ineq! (list '<= 0 (list 'lm h)) (list 'IN (list 'lm h) 'RR) (list '= (list 'lm h) (list '+ '(lm g_) (list 'lm mf)))
            (list '= (list 'lm mf) (list '* pex-m1 '(lm f_)))
            '(IN (lm f_) RR) '(IN (lm g_) RR) (list 'IN (list 'lm mf) 'RR)))
(pex-qed! 'pex-lm-mono)

;;; rewrite every CF accessor of the goal to its slot value
(define (pex-readoffs!)
  (for-each (lambda (nm) (dk-cite! nm 's))
            '(pex-cf-scal pex-cf-vec pex-cf-vadd pex-cf-vzero pex-cf-vneg pex-cf-act))
  (for-each (lambda (pr)
              (if (dk-contains? (dk-goal) (pex-acc (car pr)))
                  (subst (list '== (pex-acc (car pr)) (cadr pr)))))
