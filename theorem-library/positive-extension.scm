            (ass))))
      (pex-apply! (pex-pglb!) v0 (list 'lm v0))
      (ass))))
;;; pp <= 0 on functions <= 0
(define pex-neg-claim (pex-fa 'g_ pex-C (list 'IMPLIES (pex-fa 'x_ '(PTS s) '(<= (g_ x_) 0)) '(<= (pp g_) 0))))
(dk-have! pex-neg-claim
  (lambda ()
    (dk-peel!)
    (let* ((g (cadr (cadr (dk-goal)))))
      (pex-above! g pex-zero (lambda (x) (list (pex-apply! (dk-ctx-form (pex-fa 'x_ '(PTS s) (list '<= (list g 'x_) 0))) x))))
      (pex-apply! (pex-plb!) g pex-zero)
      (pex-lm-val! pex-zero) (pex-ppv! g)
      (dk-ineq! (list '<= (list 'pp g) (list 'lm pex-zero)) (list '= (list 'lm pex-zero) 0)
                (list 'IN (list 'pp g) 'RR) (list 'IN (list 'lm pex-zero) 'RR)))))
;;; the parts of IS-SUBLINEAR(CF, pp), in accessor form, then hbs-sl-intro-pos
(define (pex-vec-to-c! x)
  (dk-cite! 'pex-cf-vec 's)
  (if (not (dk-asm? (list 'IN x pex-C)))
      (dk-rewrite-h! (dk-ctx-form (list 'IN x (pex-acc 'VEC))) (pex-acc 'VEC) pex-C)))
(dk-have! (pex-sub-cf '(IN q (FUN (VEC m) RR)))
  (lambda () (pex-readoffs!) (ass)))
(dk-have! (pex-sub-cf pex-subadd-q)
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (app (cadr (cadr g))) (x (cadr app)) (y (caddr app)) (xy (pex-sum x y)))
      (pex-vec-to-c! x) (pex-vec-to-c! y)
      (pex-readoffs!)
      (dk-lam-b!)
      (pex-in-c! xy)
      (pex-ppv! xy) (pex-ppv! x) (pex-ppv! y)
      (let ((r12 (list 'pp xy)))
        (dk-have! (pex-glb-ant y (list '- r12 (list 'pp x)))
          (lambda ()
            (dk-peel!)
            (let* ((w (cadr (caddr (dk-goal)))) (b1 (list '- r12 (list 'lm w))))
              (pex-in-vs-c! w) (pex-lm-val! w)
              (dk-cite! 'rr-sub-in-rr r12 (list 'lm w))
              (dk-have! (pex-glb-ant x b1)
                (lambda ()
                  (dk-peel!)
                  (let* ((v (cadr (caddr (dk-goal)))) (vw (pex-sum v w)))
                    (pex-in-vs-c! v) (pex-lm-val! v)
                    (pex-vs-sum! v w)
                    (pex-lm-val! vw)
                    (pex-apply! (dk-ctx-form pex-ladd) v w)
                    (pex-above! xy vw
                      (lambda (t) (list (pex-apply! (pex-hyp-above x v) t) (pex-apply! (pex-hyp-above y w) t)
                                        (pex-fval! v t) (pex-fval! w t))))
                    (pex-apply! (pex-plb!) xy vw)
                    (dk-ineq! (list '<= r12 (list 'lm vw)) (list '= (list 'lm vw) (list '+ (list 'lm v) (list 'lm w)))
                              (list 'IN r12 'RR) (list 'IN (list 'lm vw) 'RR) (list 'IN (list 'lm v) 'RR) (list 'IN (list 'lm w) 'RR)))))
              (pex-apply! (pex-pglb!) x b1)
              (dk-ineq! (list '<= b1 (list 'pp x)) (list 'IN r12 'RR) (list 'IN (list 'pp x) 'RR) (list 'IN (list 'lm w) 'RR)))))
        (dk-cite! 'rr-sub-in-rr r12 (list 'pp x))
        (pex-apply! (pex-pglb!) y (list '- r12 (list 'pp x)))
        (dk-ineq! (list '<= (list '- r12 (list 'pp x)) (list 'pp y))
                  (list 'IN r12 'RR) (list 'IN (list 'pp x) 'RR) (list 'IN (list 'pp y) 'RR))))))
(dk-have! (pex-sub-cf pex-homle-q)
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (app (cadr (cadr g))) (t (cadr app)) (x (caddr app)) (tx (pex-scl t x))
           (u (dk-skolem! (dk-cite! 'hbs-pos-inv t))))
      (pex-vec-to-c! x)
      (pex-readoffs!)
      (dk-lam-b!)
      (pex-in-c! tx)
      (pex-ppv! tx) (pex-ppv! x)
      (dk-cite! 'rr-mul-in-rr u (list 'pp tx))
      (dk-have! (list '<= 0 t) (lambda () (dk-ineq! (list '< 0 t) (list 'IN t 'RR))))
      (dk-have! (pex-glb-ant x (list '* u (list 'pp tx)))
        (lambda ()
          (dk-peel!)
          (let* ((v (cadr (caddr (dk-goal)))) (tv (pex-scl t v)))
            (pex-in-vs-c! v) (pex-lm-val! v)
            (pex-vs-scl! t v)
            (pex-lm-val! tv)
            (pex-apply! (dk-ctx-form pex-lscl) t v)
            (pex-above! tx tv
              (lambda (z)
                (pex-fval! x z) (pex-fval! v z)
                (pex-apply! (pex-hyp-above x v) z)
                (pex-have-conj! (list 'IN t 'RR) (list 'IN (list x z) 'RR) (list 'IN (list v z) 'RR))
                (pex-have-conj! (list '<= 0 t) (list '<= (list x z) (list v z)))
                (list (dk-cite! 'rr-le-scale-nonneg t (list x z) (list v z))
                      (dk-cite! 'rr-mul-in-rr t (list x z)) (dk-cite! 'rr-mul-in-rr t (list v z)))))
            (pex-apply! (pex-plb!) tx tv)
            (dk-cite! 'rr-mul-in-rr t (list 'lm v))
            (dk-have! (list '<= (list 'pp tx) (list '* t (list 'lm v)))
              (lambda () (dk-ineq! (list '<= (list 'pp tx) (list 'lm tv)) (list '= (list 'lm tv) (list '* t (list 'lm v)))
                                   (list 'IN (list 'pp tx) 'RR) (list 'IN (list 'lm tv) 'RR) (list 'IN (list '* t (list 'lm v)) 'RR))))
            (dk-cite! 'hbs-rr-div-le t u (list 'pp tx) (list 'lm v))
            (ass))))
      (pex-apply! (pex-pglb!) x (list '* u (list 'pp tx)))
      (dk-cite! 'hbs-rr-mul-back t u (list 'pp tx) (list 'pp x))
      (ass))))
(dk-have! (pex-sub-cf '(= (q (VZERO m)) 0))
  (lambda ()
    (pex-readoffs!)
    (pex-ppv! pex-zero)
    (pex-above! pex-zero pex-zero (lambda (x) '()))
    (dk-have! (pex-fa 'x_ '(PTS s) (list '<= (list pex-zero 'x_) 0))
      (lambda () (dk-di-var!) (pex-reduce-goal!) (if (not (proof-done? *ps*)) (dk-ineq!))))
    (pex-apply! (dk-ctx-form pex-neg-claim) pex-zero)
    (dk-have! (pex-glb-ant pex-zero 0)
      (lambda ()
        (dk-peel!)
        (let ((v (cadr (caddr (dk-goal)))))
          (pex-in-vs-c! v)
          (dk-have! (pex-fa 'x_ '(PTS s) (list '<= 0 (list v 'x_)))
            (lambda ()
              (let ((x (dk-di-var!)))
                (let ((h (pex-apply! (pex-hyp-above pex-zero v) x)))
                  (dk-lam-b-h! h)
                  (ass)))))
          (pex-apply! (dk-ctx-form pex-lpos) v)
          (ass))))
    (pex-apply! (pex-pglb!) pex-zero 0)
    (pex-antisym! (list 'pp pex-zero) 0 (lambda () (ass)) (lambda () (ass)))))
(dk-cite! 'hbs-sl-intro-pos pex-CF 'pp)
(dk-conj-close! (lambda () (ass)))
(pex-qed! 'pex-p-props)

;;; =====================================================================
;;; (4) THE EXTENSION, given that every continuous function is bounded
;;; =====================================================================
(define pex-goal '(FORSOME plam (AND (IS-POSITIVE-FUNCTIONAL s plam) (EXTENDS-ON vs plam lm))))
(sp (make-wff (pex-hyps (list 'IMPLIES pex-bnd pex-goal))))
(pex-open!)
(dk-split-all! (list (dk-cite! 'pex-vs-zero 's 'vs 'lm)))
(dk-cite! 'pex-cf-module 's)
(dk-cite! 'pex-cf-pin 's)
(dk-cite! 'pex-vs-submodule 's 'vs 'lm)
(dk-cite! 'pex-lm-linear 's 'vs 'lm)
(for-each (lambda (nm) (dk-cite! nm 's))
          '(pex-cf-scal pex-cf-vec pex-cf-vadd pex-cf-vzero pex-cf-vneg pex-cf-act))
(let* ((pp (dk-skolem! (dk-cite! 'pex-p-exists 's 'vs 'lm))))
  (dk-split-all! (list (dk-cite! 'pex-p-props 's 'vs 'lm pp)))
  (let* ((ff (dk-skolem! (dk-cite! 'hbs-hahn-banach-sublinear pex-CF pp 'vs 'lm)))
         (ff-le (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ff) (dk-contains? f pp))) "ff <= pp"))
         (in-vec! (lambda (f) (dk-have! (list 'IN f (pex-acc 'VEC))
                                (lambda () (subst (list '== (pex-acc 'VEC) pex-C)) (ass))))))
    (dk-cite! 'hbs-lf-fun pex-CF (pex-acc 'VEC) ff)
    (ew ff)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((dk-asm? g) (ass))
            (#t
             (mac 'is-positive-functional)
             (dk-conj-close!
               (lambda ()
                 (let ((g (dk-goal)))
                   (cond
                     ((dk-head-is? g 'IN)
                      (dk-rewrite-h! (dk-ctx-form (list 'IN ff (list 'FUN (pex-acc 'VEC) 'RR))) (pex-acc 'VEC) pex-C)
                      (ass))
                     ((dk-contains? g 'pfg_)
                      (dk-peel!)
                      (let* ((app (cadr (cadr (dk-goal)))) (f (car (cadr (cadddr app)))) (h (car (caddr (cadddr app)))))
                        (in-vec! f) (in-vec! h)
                        (let ((e (dk-cite! 'hbs-lf-add pex-CF (pex-acc 'VEC) ff f h)))
                          (dk-cite! 'pex-vadd-val 's f h)
                          (dk-rewrite-h! e (list (pex-acc 'VADD) f h) (pex-sum f h)))
                        (ass)))
                     ((dk-contains? g 'pfc_)
                      (dk-peel!)
                      (let* ((app (cadr (cadr (dk-goal)))) (c (cadr (cadddr app))) (f (car (caddr (cadddr app)))))
                        (in-vec! f)
                        (let ((e (dk-cite! 'hbs-lf-hom pex-CF (pex-acc 'VEC) ff c f)))
                          (dk-cite! 'pex-act-val 's c f)
                          (dk-rewrite-h! e (list (pex-acc 'ACT) c f) (pex-scl c f)))
                        (ass)))
                     (#t
                      (dk-peel!)
                      (let* ((f (cadr (caddr (dk-goal)))) (mf (pex-scl pex-m1 f)))
                        (in-vec! f)
                        (pex-in-c! mf)
                        (in-vec! mf)
                        (pex-above! mf pex-zero
                          (lambda (x) (list (pex-apply! (dk-ctx-form (pex-fa 'pfx_ '(PTS s) (list '<= 0 (list f 'pfx_)))) x)
                                            (pex-fval! f x))))
                        (dk-have! (pex-fa 'x_ '(PTS s) (list '<= (list mf 'x_) 0))
                          (lambda ()
                            (let ((x (dk-di-var!)))
                              (let ((h (pex-apply! (pex-hyp-above mf pex-zero) x)))
                                (dk-lam-b-h! h)
                                (pex-reduce-goal!)
                                (ass)))))
                        (pex-apply! (dk-ctx-form (pex-fa 'g_ pex-C (list 'IMPLIES (pex-fa 'x_ '(PTS s) '(<= (g_ x_) 0))
                                                                          (list '<= (list pp 'g_) 0)))) mf)
                        (pex-apply! ff-le mf)
                        (let ((e (dk-cite! 'hbs-lf-hom pex-CF (pex-acc 'VEC) ff pex-m1 f)))
                          (dk-cite! 'pex-act-val 's pex-m1 f)
                          (dk-rewrite-h! e (list (pex-acc 'ACT) pex-m1 f) mf))
                        (dk-cite! 'hbs-lf-val pex-CF (pex-acc 'VEC) ff f)
                        (dk-cite! 'hbs-lf-val pex-CF (pex-acc 'VEC) ff mf)
                        (dk-cite! 'fun-apply-type-c pp pex-C 'RR mf)
                        (dk-ineq! (list '<= (list ff mf) (list pp mf)) (list '<= (list pp mf) 0)
                                  (list '= (list ff mf) (list '* pex-m1 (list ff f)))
                                  (list 'IN (list ff f) 'RR) (list 'IN (list ff mf) 'RR) (list 'IN (list pp mf) 'RR)))))))))))))))
(pex-qed! 'pex-extension-from-bound)

;;; =====================================================================
;;; (5) M. RIESZ: s a compact metric space, vs a subspace of C(s) holding the
;;;     constant 1, lm positive and linear on vs.  Then lm extends to a positive
;;;     linear functional on C(s).
;;; =====================================================================
(sp (make-wff (pex-hyps pex-goal)))
(dk-peel!)
(dk-have! pex-bnd
  (lambda ()
    (let ((g (dk-di-var!)))
      (dk-cite! 'rmc-cont-bounded 's g)
      (ass))))
(dk-cite! 'pex-extension-from-bound 's 'vs 'lm)
(ass)
(pex-qed! 'pex-positive-extension)
