    (lambda () (dk-close-all! (lambda () (sep-set))))))
;;; membership in the index set, as a theorem (instantiating it never beta-reduces v)
(sp (make-wff (list 'FORALL 's (list 'FORALL 'vs (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'IMPLIES (list 'SUBSET 'vs pex-C)
  (pex-fa 'g_ pex-C (list 'FORALL 'v_ (list 'IFF (list 'IN 'v_ (list pex-iif 'g_)) (list 'IN 'v_ (pex-idx 'g_)))))))))))
(dk-peel!)
(dk-cite! 'pex-c-set 's)
(pex-idx-set! 'g_)
(dk-lam-b!)
(for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (ass))))
          (dk-opened (lambda () (di))))
(pex-qed! 'pex-iif-mem)
;;; (IN v (IIF g)) in context: land v in vs and g <= v
(define (pex-idx-parts! v g)
  (let ((iff (dk-cite! 'pex-iif-mem 's 'vs g v)))
    (dk-have! (list 'IN v (pex-idx g)) (lambda () (pex-prop! iff (list 'IN v (list pex-iif g)))))
    (pex-sep-part! (list 'IN v (pex-idx g)) (list 'IN v 'vs))
    (pex-sep-part! (list 'IN v (pex-idx g)) (pex-above g v))))
(define (pex-idx-in! v g) ; v in vs, g <= v in context
  (let ((iff (dk-cite! 'pex-iif-mem 's 'vs g v)))
    (dk-have! (list 'IN v (pex-idx g)) (lambda () (dk-close-all! (lambda () (sep-mi)))))
    (dk-have! (list 'IN v (list pex-iif g)) (lambda () (pex-prop! iff (list 'IN v (pex-idx g)))))))
(define (pex-redex? t)
  (and (pair? t)
       (or (and (pair? (car t)) (eq? (car (car t)) 'VNB-LAMBDA))
           (any-pred pex-redex? t))))
(define (pex-reduce-goal!)
  (let loop () (if (and (not (proof-done? *ps*)) (pex-redex? (dk-goal))) (if (not (dk-lam-b!)) (loop)))))
;;; a bound for g: (bd, the bound clause) landed
(define (pex-bound! g)
  (let* ((bd (dk-skolem! (pex-apply! (dk-ctx-form pex-bnd) g))))
    bd))

(sp (make-wff (pex-hyps (list 'IMPLIES pex-bnd
  (list 'FORSOME 'pp (pex-conj! (list 'IN 'pp (list 'FUN pex-C 'RR)) (pex-plb 'pp) (pex-pglb 'pp)))))))
(pex-open!)
(dk-cite! 'rr-one-in)
(pex-in-vs-c! pex-one)
(pex-lm-val! pex-one)
(dk-have! (pex-fa 'hix_ pex-C (list 'FORSOME 'hi0_ (list 'IN 'hi0_ (list pex-iif 'hix_))))
  (lambda ()
    (let* ((g (dk-di-var!)) (bd (pex-bound! g)) (w (pex-scl bd pex-one)))
      (pex-vs-scl! bd pex-one)
      (dk-have! (pex-above g w)
        (lambda ()
          (let ((x (dk-di-var!)))
            (pex-fval! g x)
            (pex-apply! (dk-ctx-form (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS s)) (list '<= (list 'abs (list g 'x)) bd)))) x)
            (pex-reduce-goal!)
            (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list g x) bd)))
            (dk-ineq! (list '<= (list g x) bd) (list 'IN (list g x) 'RR) (list 'IN bd 'RR)))))
      (pex-idx-in! w g)
      (ew w)
      (ass))))
(dk-have! (pex-fa 'hix_ pex-C (pex-fa 'hij_ (list pex-iif 'hix_) (list 'IN (list pex-phi 'hix_ 'hij_) 'RR)))
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (gg (cadr (cadr g))) (v (caddr (cadr g))))
      (pex-idx-parts! v gg)
      (pex-lm-val! v)
      (pex-reduce-goal!)
      (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass))))))
(dk-have! (pex-fa 'hix_ pex-C (list 'FORSOME 'hib_ (list 'AND '(IN hib_ RR)
            (pex-fa 'hij_ (list pex-iif 'hix_) (list '<= 'hib_ (list pex-phi 'hix_ 'hij_))))))
  (lambda ()
    (let* ((g (dk-di-var!)) (bd (pex-bound! g)) (w (pex-scl bd pex-one))
           (b (list '- (list '* bd (list 'lm pex-one)))))
      (pex-vs-scl! bd pex-one)
      (pex-apply! (dk-ctx-form pex-lscl) bd pex-one)
      (pex-lm-val! w)
      (dk-cite! 'rr-mul-in-rr bd (list 'lm pex-one))
      (dk-cite! 'rr-neg-closed (list '* bd (list 'lm pex-one)))
      (ew b)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
            (let* ((v (dk-di-var!)) (h (pex-sum v w)))
              (pex-idx-parts! v g)
              (pex-in-vs-c! v)
              (pex-lm-val! v)
              (pex-vs-sum! v w)
              (pex-apply! (dk-ctx-form pex-ladd) v w)
              (pex-lm-val! h)
              (dk-have! (pex-fa 'x_ '(PTS s) (list '<= 0 (list h 'x_)))
                (lambda ()
                  (let ((x (dk-di-var!)))
                    (pex-fval! g x) (pex-fval! v x)
                    (pex-apply! (dk-ctx-form (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS s)) (list '<= (list 'abs (list g 'x)) bd)))) x)
                    (pex-apply! (dk-ctx-form (pex-above g v)) x)
                    (pex-reduce-goal!)
                    (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list g x) bd)))
                    (dk-ineq! (list '<= (list '- bd) (list g x)) (list '<= (list g x) (list v x))
                              (list 'IN (list g x) 'RR) (list 'IN (list v x) 'RR) (list 'IN bd 'RR)))))
              (pex-apply! (dk-ctx-form pex-lpos) h)
              (pex-reduce-goal!)
              (dk-ineq! (list '<= 0 (list 'lm h)) (list '= (list 'lm h) (list '+ (list 'lm v) (list 'lm w)))
                        (list '= (list 'lm w) (list '* bd (list 'lm pex-one)))
                        (list 'IN (list 'lm h) 'RR) (list 'IN (list 'lm v) 'RR) (list 'IN (list 'lm w) 'RR)
                        (list 'IN (list '* bd (list 'lm pex-one)) 'RR)))))))))
(let* ((r (dk-skolem! (dk-cite! 'hbs-inf-family pex-C pex-iif pex-phi)))
       (r-lb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r) (not (dk-contains? f 'hib_)))) "LB"))
       (r-glb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r) (dk-contains? f 'hib_))) "GLB")))
  (ew r)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (ass))
              ((dk-contains? g 'b_)
               (dk-peel!)
               (let* ((gl (dk-goal)) (b (cadr gl)) (gg (cadr (caddr gl)))
                      (hb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f b) (dk-contains? f 'lm)))
                                   "the lower-bound hypothesis")))
                 (dk-have! (pex-fa 'hij_ (list pex-iif gg) (list '<= b (list pex-phi gg 'hij_)))
                   (lambda ()
                     (let ((j (dk-di-var!)))
                       (pex-idx-parts! j gg)
                       (pex-apply! hb j)
                       (pex-reduce-goal!)
                       (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass))))))
                 (pex-apply! r-glb gg b)
                 (ass)))
              (#t
               (dk-peel!)
               (let* ((gl (dk-goal)) (gg (cadr (cadr gl))) (v (cadr (caddr gl))))
                 (pex-idx-in! v gg)
                 (let ((h (pex-apply! r-lb gg v)))
                   (if (not (dk-lam-b-h! h)) (ass))))))))))
(pex-qed! 'pex-p-exists)

;;; the antecedent of the greatest-lower-bound clause at g with bound b, under a fresh binder
(define (pex-glb-ant g b)
  (let ((v (dk--fresh-binder '(pva_ pvb_ pvc_ pvd_) (list g b) "pex-glb-ant")))
    (pex-fa v 'vs (list 'IMPLIES (pex-above g v) (list '<= b (list 'lm v))))))
(define (pex-hyp-above g v)
  (dk-ctx-form (pex-above g v)))
;;; g <= h pointwise, both explicit function terms of C: by beta and ineq from PREMS (procedure of x)
(define (pex-above! g h prems)
  (dk-have! (pex-above g h)
    (lambda ()
      (let ((x (dk-di-var!)))
        (for-each (lambda (f) (if (symbol? f) (pex-fval! f x)))
                  (append (pex-fun-atoms (list g h) x) (filter symbol? (list g h))))
        (let ((ps (prems x)))
          (pex-reduce-goal!)
          (if (not (proof-done? *ps*))
              (for-each (lambda (f) (if (not (dk-asm? (list 'IN (list f x) 'RR))) (pex-fval! f x)))
                        (pex-fun-atoms (dk-goal) x)))
          (if (not (proof-done? *ps*))
              (if (dk-asm? (dk-goal)) (ass)
                  (apply dk-ineq! (append ps
                                          (map (lambda (f) (list 'IN (list f x) 'RR))
                                               (filter (lambda (f) (dk-asm? (list 'IN (list f x) 'RR)))
                                                       (pex-fun-atoms (dk-goal) x))))))))))))

(define (pex-sub-cf f) (subst-free 'q 'pp (subst-free 'm pex-CF f)))

(sp (make-wff (pex-hyps (list 'FORALL 'pp (list 'IMPLIES (list 'IN 'pp (list 'FUN pex-C 'RR))
  (list 'IMPLIES (pex-plb 'pp) (list 'IMPLIES (pex-pglb 'pp)
    (pex-conj! (list 'IS-SUBLINEAR pex-CF 'pp)
               (pex-fa 'v_ 'vs '(<= (lm v_) (pp v_)))
               (pex-fa 'g_ pex-C (list 'IMPLIES (pex-fa 'x_ '(PTS s) '(<= (g_ x_) 0)) '(<= (pp g_) 0)))))))))))
(pex-open!)
(dk-split-all! (list (dk-cite! 'pex-vs-zero 's 'vs 'lm)))
(dk-cite! 'pex-cf-module 's)
(dk-cite! 'pex-cf-pin 's)
(dk-cite! 'pex-zero-in 's)
(define (pex-plb!) (dk-ctx-form (pex-plb 'pp)))
(define (pex-pglb!) (dk-ctx-form (pex-pglb 'pp)))
(define (pex-ppv! g) (dk-cite! 'fun-apply-type-c 'pp pex-C 'RR g))
;;; lm <= pp on vs
(dk-have! (pex-fa 'v_ 'vs '(<= (lm v_) (pp v_)))
