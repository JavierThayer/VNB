;;; theorem-library/positive-extension.scm -- THE POSITIVE EXTENSION (M. Riesz) for
;;; C(K), K a compact metric space (RM-3A, 2026-10-10).  Prefix pex-.
;;;
;;; THE THEOREM (pex-positive-extension).  s a compact metric space, vs a set of
;;; functions with vs subset CONT-FNS(s), closed under the pointwise sum and real
;;; multiples (the lambdas of IS-POSITIVE-FUNCTIONAL, binder sx_), holding the
;;; constant 1; lm : vs -> RR additive, real-homogeneous and positive.  Then some
;;; plam with IS-POSITIVE-FUNCTIONAL(s, plam) extends lm on vs.
;;;
;;; THE MODULE.  CONT-FNS(s) is presented as the explicit 6-tuple
;;;   [ R, CONT-FNS(s), (f, g) |-> f + g, 0, f |-> (-1) f, (c, f) |-> c f ]
;;; (pex-CF below; R the real ring view), and pex-cf-module proves IS-MODULE of it
;;; for every metric space s: the closures are RM-2's rmc-cont-fns-add / -scale, the
;;; laws are pointwise ring identities (function extensionality + crs).  No new
;;; vocabulary: the tuple is a term of the statements.
;;;
;;; THE ROUTE.  pp(g) = inf { lm(v) : v in vs, g <= v } (hbs-inf-family, the index set
;;; depending on g) is finite because g is bounded (rmc-cont-bounded; compactness is
;;; used only there: pex-extension-from-bound takes the bound as a hypothesis), is
;;; sublinear in the module sense, and lm <= pp on vs (lm monotone).  Hahn-Banach
;;; (hbs-hahn-banach-sublinear) gives ff linear on CF with ff <= pp extending lm; g <= 0
;;; gives pp(g) <= lm(0) = 0, so ff is positive.
;;;
;;; LOAD WINDOW: [after theorem-library/riesz-markov-cantor, end).  The latest citations
;;; are rmc-cont-bounded, rmc-cont-fns-add/-scale/-parts/-intro (riesz-markov-cantor,
;;; library MEASURE) and IS-POSITIVE-FUNCTIONAL / CONT-FNS (positive-functional); then
;;; hbs-* (hahn-banach-sublinear), rr-abs-le-parts (regulated-primitive-laws),
;;; ms-const-continuous-at.  Library: MEASURE as the citations stand -- every cited
;;; fact is analysis, but the rmc- laws of C(s) live in the measure file; moving
;;; rmc-cont-fns-* and rmc-cont-bounded to an analysis file would put this file in
;;; analysis.  No late tactic, no top-level macro.  Every theorem `proven modulo 0'.

;;; ---- local copies of the hahn-banach-sublinear driver helpers (a library file
;;; loads in its own environment, so the hbs- helpers are not visible here) ----
(define pex-R '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define pex-m1 '(- 1))
(define (pex-m1!) (dk-cite! 'rr-one-in) (dk-cite! 'rr-neg-closed 1))
(define (pex-fa v dom body) (list 'FORALL v (list 'IMPLIES (list 'IN v dom) body)))
(define (pex-prop! . keepers) (if (apply dk-only! keepers) (prop)))
(define (pex-apply! f . terms)
  (let loop ((g (->raw-formula f)) (ts terms))
    (cond ((and (pair? g) (eq? (car g) 'FORALL) (pair? ts))
           (loop (subst-free (cadr g) (car ts) (caddr g)) (cdr ts)))
          ((and (null? ts) (pair? g) (eq? (car g) 'IMPLIES) (dk-asm? (cadr g)))
           (loop (caddr g) ts))
          ((and (null? ts) (dk-ctx-form g)) => (lambda (h) h))
          (#t (apply dk-apply! f terms)))))
(define (pex-conj! . fs)
  (let loop ((fs fs))
    (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (loop (cdr fs))))))
(define (pex-have-conj! . fs)
  (dk-have! (apply pex-conj! fs)
    (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (in-rr)))))))
(define (pex-antisym! x y le1 le2)
  (dk-have! (list '<= x y) le1)
  (dk-have! (list '<= y x) le2)
  (dk-have! (list 'AND (list 'IN x 'RR) (list 'IN y 'RR))
    (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (in-rr))))))
  (dk-have! (list 'AND (list '<= x y) (list '<= y x)) (lambda () (dk-conj-close! (lambda () (ass)))))
  (dk-cite! 'rr-leq-antisymmetric x y)
  (ass))
(define (pex-sep-part! hyp claim)
  (dk-have! claim
    (lambda ()
      (dk-split-all! (dk-landed (lambda () (sep-me (dk-ctx-form hyp)))))
      (ass))))
(define pex-subadd-q
  '(FORALL x_ (IMPLIES (IN x_ (VEC m)) (FORALL y_ (IMPLIES (IN y_ (VEC m))
     (<= (q ((VADD m) x_ y_)) (+ (q x_) (q y_))))))))
(define pex-homle-q
  '(FORALL t_ (IMPLIES (IN t_ RR) (IMPLIES (< 0 t_) (FORALL x_ (IMPLIES (IN x_ (VEC m))
     (<= (q ((ACT m) t_ x_)) (* t_ (q x_)))))))))

(define pex-C '(CONT-FNS s))
(define (pex-sum f g) (list 'VNB-LAMBDA 'sx_ '(PTS s) (list '+ (list f 'sx_) (list g 'sx_))))
(define (pex-scl c f) (list 'VNB-LAMBDA 'sx_ '(PTS s) (list '* c (list f 'sx_))))
(define pex-zero '(VNB-LAMBDA sx_ (PTS s) 0))
(define pex-one '(VNB-LAMBDA sx_ (PTS s) 1))
(define pex-vaddl (list 'VNB-LAMBDA '(LIST pea_ peb_) (list 'CARTESIAN pex-C pex-C) (pex-sum 'pea_ 'peb_)))
(define pex-vnegl (list 'VNB-LAMBDA 'pea_ pex-C (pex-scl '(- 1) 'pea_)))
(define pex-actl (list 'VNB-LAMBDA '(LIST pec_ pea_) (list 'CARTESIAN 'RR pex-C) (pex-scl 'pec_ 'pea_)))
;;; C(s) as a real vector space: [R, CONT-FNS(s), +, 0, -, .], the operations pointwise
(define pex-CF (list 'LIST pex-R pex-C pex-vaddl pex-zero pex-vnegl pex-actl))
(define (pex-acc a) (list a pex-CF))

(define (pex-qed! name)
  (if (not (proof-done? *ps*))
      (error "positive-extension: proof did not close" name (expression->string (dk-goal))))
  (qed name)
  (topic! name 'analysis))

