;;; =====================================================================
;;; (3) THE DOMINATING FUNCTIONAL  pp(g) = inf { lm(v) : v in vs, g <= v }
;;; =====================================================================
(define (pex-above g v) (pex-fa 'pex_ '(PTS s) (list '<= (list g 'pex_) (list v 'pex_))))
(define (pex-idx g) (list 'SEP 'pev_ 'vs (pex-above g 'pev_)))
(define pex-iif (list 'VNB-LAMBDA 'peg_ pex-C (pex-idx 'peg_)))
(define pex-phi (list 'VNB-LAMBDA '(LIST peg_ pev_) (list 'CARTESIAN pex-C 'vs) '(lm pev_)))
(define pex-bnd (pex-fa 'g_ pex-C '(FORSOME bd_ (AND (IN bd_ RR) (AND (<= 0 bd_)
                    (FORALL x (IMPLIES (IN x (PTS s)) (<= (abs (g_ x)) bd_))))))))
(define (pex-plb pp) (pex-fa 'g_ pex-C (pex-fa 'v_ 'vs (list 'IMPLIES (pex-above 'g_ 'v_) (list '<= (list pp 'g_) '(lm v_))))))
(define (pex-pglb pp) (pex-fa 'g_ pex-C (pex-fa 'b_ 'RR
  (list 'IMPLIES (pex-fa 'v_ 'vs (list 'IMPLIES (pex-above 'g_ 'v_) '(<= b_ (lm v_))))
        (list '<= 'b_ (list pp 'g_))))))
(define (pex-idx-set! g)
