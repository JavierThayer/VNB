;;; mh-method2.scm -- construction-of-measures.pdf section 2.4: the method II construction.
;;; Prop 4.23: METHOD-II(m, C, p) is a metric outer measure.  Helper prefix mh2-.

(define (mh2-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "mh2-pick: nothing matching" what) (car l))))
(define (mh2-split-goal!)
  (let loop ((todo (list (proof-state-focus *ps*))) (acc '()))
    (if (null? todo) (reverse acc)
        (begin (dk-focus! (car todo))
               (if (dk-head-is? (dk-goal) 'AND)
                   (loop (append (dk-opened (lambda () (di))) (cdr todo)) acc)
                   (loop (cdr todo) (cons (car todo) acc)))))))
(define (mh2-diam-set m a)
  (list 'SEP 'mhw_ 'RR-POS-STAR (list 'FORSOME 'mhx_ (list 'AND (list 'IN 'mhx_ a)
        (list 'FORSOME 'mhy_ (list 'AND (list 'IN 'mhy_ a) (list '= 'mhw_ (list (list 'DIST m) 'mhx_ 'mhy_))))))))
;;; (SUBSET (SEP v D ..) D) for a SEP term, on a lane
(define (mh2-sep-sub! s)
  (dk-have! (list 'SUBSET s (caddr s))
    (lambda () (mac 'subset-def) (di)
               (sep-me (mh2-pick 'member (lambda (z) (and (dk-head-is? z 'IN) (equal? (caddr z) s)))))
               (ass))))

;;; ---------------------------------------------------------------------------
(sp (make-wff '(FORALL m (FORALL a (IN (DIAM m a) RR-POS-STAR)))))
(dk-peel!)
(let ((g (dk-goal)))
  (mac 'DIAM)
  (let ((s (cadr (cadr (dk-goal)))))
    (mh2-sep-sub! s)
    (fact 'esup-in s)
    (ass)))
(qed 'diam-in)

(sp (make-wff '(FORALL m (= (DIAM m EMPTY-SET) 0))))
(dk-peel!)
(mac 'DIAM)
(let* ((e (cadr (dk-goal))) (s (cadr e)))
  (mh2-sep-sub! s)
  (fact 'esup-in s)
  (fact 'zero-in-rr-pos-star)
  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x s) (list '<= 'x 0)))
    (lambda ()
      (let* ((pl (dk-peel!)) (x (cadr (car (filter (lambda (z) (dk-head-is? z 'IN)) pl)))))
        (sep-me (list 'IN x s))
        (let ((w (dk-skolem! (mh2-pick 'ex (lambda (z) (dk-head-is? z 'FORSOME))) #t)))
          (fact 'empty-set-has-no-members w)
          (if (dk-only! (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET))) (prop))))))
  (dk-have! (list 'AND '(IN 0 RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x s) (list '<= 'x 0)))))
  (fact 'esup-least s 0)
  (fact 'rr-pos-star-nonneg e)
  (dk-have! (list 'AND (list 'IN e 'RR-POS-STAR) '(IN 0 RR-POS-STAR)))
  (dk-have! (list 'AND (list '<= e 0) (list '<= 0 e)))
  (fact 'rr-pos-star-le-antisymm e 0)
  (ass))
(qed 'diam-empty)

(sp (make-wff '(FORALL m (IMPLIES (IS-METRIC-SPACE m) (FORALL a (IMPLIES (SUBSET a (PTS m))
   (FORALL x (IMPLIES (IN x a) (FORALL y (IMPLIES (IN y a) (<= ((DIST m) x y) (DIAM m a))))))))))))
(dk-peel!)
(let* ((g (dk-goal)) (dxy (cadr g)) (x (cadr dxy)) (y (caddr dxy))
       (s (mh2-diam-set 'm 'a)))
  (fact 'subset-mem-fwd 'a '(PTS m) x)
  (fact 'subset-mem-fwd 'a '(PTS m) y)
  (fact 'metric-dist-real 'm x y)
  (fact 'metric-pos 'm x y)
  (dk-have! (list 'IN dxy 'RR-POS-STAR) (lambda () (mac 'rr-pos-star-membership) (oi-l)
                                                  (dk-conj-close! (lambda () (ass)))))
  (dk-have! (list 'IN dxy s)
    (lambda ()
      (in-sep! (lambda ()
        (ew x) (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'FORSOME)
                                               (begin (ew y) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))))
                                               (ass))))))))
  (mh2-sep-sub! s)
  (mac 'DIAM)
  (fact 'esup-upper s)
  (inst+ (mh2-pick 'up (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'ESUP) (dk-contains? z 'mhw_)))) dxy)
  (ass))
(qed 'diam-dist-le)

;;; ---------------------------------------------------------------------------
;;; mu*_delta: C_delta, its pre-measure, and the outer measure
(define (mh2-cd m cls dl) (list 'SEP 'mha_ cls (list '<= (list 'DIAM m 'mha_) dl)))
(define (mh2-rcd m cls pm dl) (list 'RESTRICT pm (mh2-cd m cls dl)))
(define mh2-hyps '((IS-PREMEASURE (PTS m) cls pm) (IN dl RR) (<= 0 dl)))
;;; project the five parts of IS-PREMEASURE(pts m, cls, pm) from the context
(define (mh2-pre-parts!)
  (let ((h '(IS-PREMEASURE (PTS m) cls pm)))
    (for-each (lambda (c) (dk-project! c 'is-premeasure h))
              '((IN (PTS m) SET) (SUBSET cls (POWER (PTS m))) (IN EMPTY-SET cls)
                (IN pm (FUN cls RR-POS-STAR)) (= (pm EMPTY-SET) 0)))))
;;; x in C_delta: x in cls, DIAM(x) <= dl
(define (mh2-cd-parts! x cd)
  (dk-project! (list 'IN x (caddr cd)) (lambda () (sep-me (list 'IN x cd))))
  (dk-project! (list '<= (list 'DIAM 'm x) (caddr (cadddr cd))) (lambda () (sep-me (list 'IN x cd)))))
(define (mh2-cd-sub! cd)                    ; (SUBSET cd cls)
  (mh2-sep-sub! cd))

(sp (make-wff (forall-guarded '(m cls pm dl) mh2-hyps
  (list 'IS-PREMEASURE '(PTS m) (mh2-cd 'm 'cls 'dl) (mh2-rcd 'm 'cls 'pm 'dl)))))
(dk-peel!)
(mh2-pre-parts!)
(define mh2a-cd (mh2-cd 'm 'cls 'dl))
(mh2-cd-sub! mh2a-cd)
(fact 'diam-empty 'm)
(dk-have! (list 'IN 'EMPTY-SET mh2a-cd)
  (lambda () (in-sep! (lambda () (subst '(= (DIAM m EMPTY-SET) 0)) (ass)))))
(fact 'restrict-in-fun 'pm 'cls 'RR-POS-STAR mh2a-cd)
(mac 'is-premeasure)
(for-each
 (lambda (leaf)
   (dk-focus! leaf)
   (let ((g (dk-goal)))
     (cond ((dk-asm? g) (ass))
           ((dk-head-is? g 'SUBSET)
            (mac 'subset-def)
            (let* ((pl (dk-peel!)) (x (cadr (car pl))))
              (mh2-cd-parts! x mh2a-cd)
              (fact 'subset-mem-fwd 'cls '(POWER (PTS m)) x)
              (ass)))
           (#t                                         ; restrict(pm, cd)(empty) = 0
            (subst (dk-cite! 'restrict-apply 'pm mh2a-cd 'EMPTY-SET))
            (ass)))))
 (mh2-split-goal!))
(qed 'method-ii-delta-premeasure)

(sp (make-wff (forall-guarded '(m cls pm dl) mh2-hyps
  '(IS-OUTER-MEASURE (PTS m) (METHOD-II-DELTA m cls pm dl)))))
(dk-peel!)
(fact 'method-ii-delta-premeasure 'm 'cls 'pm 'dl)
(mac 'METHOD-II-DELTA)
(fact 'method-i-outer-is-outer-measure '(PTS m) (mh2-cd 'm 'cls 'dl) (mh2-rcd 'm 'cls 'pm 'dl))
(ass)
(qed 'method-ii-delta-outer)

;;; the value: einf of the cover sums
(define (mh2-cs m cls pm dl es) (list 'COVER-SUMS (list 'PTS m) (mh2-cd m cls dl) (mh2-rcd m cls pm dl) es))
(sp (make-wff (forall-guarded '(m cls pm dl es) '((IN es (POWER (PTS m))))
  (list '= '((METHOD-II-DELTA m cls pm dl) es) (list 'EINF (mh2-cs 'm 'cls 'pm 'dl 'es))))))
(dk-peel!)
(mac 'METHOD-II-DELTA)
(fact 'method-i-outer-value '(PTS m) (mh2-cd 'm 'cls 'dl) (mh2-rcd 'm 'cls 'pm 'dl) 'es)
(ass)
(qed 'method-ii-delta-value)

;;; d1 <= d2: mu*_(d2)(E) <= mu*_(d1)(E)
(sp (make-wff (forall-guarded '(m cls pm d1 d2 es)
  '((IS-PREMEASURE (PTS m) cls pm) (IN d1 RR) (<= 0 d1) (IN d2 RR) (<= d1 d2) (IN es (POWER (PTS m))))
  '(<= ((METHOD-II-DELTA m cls pm d2) es) ((METHOD-II-DELTA m cls pm d1) es)))))
(dk-peel!)
(mh2-pre-parts!)
(define mh2b-cd1 (mh2-cd 'm 'cls 'd1))
(define mh2b-cd2 (mh2-cd 'm 'cls 'd2))
(define mh2b-r1 (mh2-rcd 'm 'cls 'pm 'd1))
(define mh2b-r2 (mh2-rcd 'm 'cls 'pm 'd2))
(define mh2b-cs1 (mh2-cs 'm 'cls 'pm 'd1 'es))
(define mh2b-cs2 (mh2-cs 'm 'cls 'pm 'd2 'es))
(subst (dk-cite! 'method-ii-delta-value 'm 'cls 'pm 'd1 'es))
(subst (dk-cite! 'method-ii-delta-value 'm 'cls 'pm 'd2 'es))
(mh2-cd-sub! mh2b-cd1) (mh2-cd-sub! mh2b-cd2)
(dk-have! (list 'SUBSET mh2b-cd1 mh2b-cd2)
  (lambda ()
    (mac 'subset-def)
    (let* ((pl (dk-peel!)) (x (cadr (car pl))))
      (mh2-cd-parts! x mh2b-cd1)
      (fact 'diam-in 'm x)
      (dk-have! (list 'AND (list 'IN (list 'DIAM 'm x) 'RR-POS-STAR) '(IN d1 RR)))
      (fact 'rr-pos-star-le-real-in-rr (list 'DIAM 'm x) 'd1)
      (in-sep! (lambda () (dk-ineq! (list '<= (list 'DIAM 'm x) 'd1) '(<= d1 d2)))))))
(fact 'restrict-in-fun 'pm 'cls 'RR-POS-STAR mh2b-cd1)
(fact 'restrict-in-fun 'pm 'cls 'RR-POS-STAR mh2b-cd2)
(fact 'cover-sums-subset '(PTS m) mh2b-cd1 mh2b-r1 'es)
(fact 'cover-sums-subset '(PTS m) mh2b-cd2 mh2b-r2 'es)
(dk-have! (list 'SUBSET mh2b-cs1 mh2b-cs2)
  (lambda ()
    (mac 'subset-def)
    (let* ((pl (dk-peel!)) (v (cadr (car pl)))
           (ex (dk-cite! 'cover-sums-elim '(PTS m) mh2b-cd1 mh2b-r1 'es v))
           (sq (dk-skolem! ex #t))
           (l1 (list 'VNB-LAMBDA 'cvk_ 'NN (list mh2b-r1 (list sq 'cvk_))))
           (l2 (list 'VNB-LAMBDA 'cvk_ 'NN (list mh2b-r2 (list sq 'cvk_)))))
      (fact 'fun-codomain-superset sq 'NN mh2b-cd1 mh2b-cd2)
      (define (typ! r cd)
        (lambda ()
          (dk-lam-type!
           (lambda ()
             (let ((k (dk-di-var!)))
               (fact 'fun-apply-type-c sq 'NN cd k)
               (fact 'fun-apply-type-c r cd 'RR-POS-STAR (list sq k))
               (ass)))
           (lambda () (fact 'nn-is-set) (ass)))))
      (define t1 (typ! mh2b-r1 mh2b-cd1))
      (define t2 (typ! mh2b-r2 mh2b-cd2))
      (dk-fun-ext! l1 l2 'NN 'RR-POS-STAR t1 t2
        (lambda (k)
          (fact 'fun-apply-type-c sq 'NN mh2b-cd1 k)
          (fact 'fun-apply-type-c sq 'NN mh2b-cd2 k)
          (dk-lam-b!)
          (subst (dk-cite! 'restrict-apply 'pm mh2b-cd1 (list sq k)))
          (subst (dk-cite! 'restrict-apply 'pm mh2b-cd2 (list sq k)))
          (fact 'subset-mem-fwd mh2b-cd1 'cls (list sq k))
          (fact 'fun-apply-type-c 'pm 'cls 'RR-POS-STAR (list sq k))
          (rfl)))
      (fact 'cover-sums-intro '(PTS m) mh2b-cd2 mh2b-r2 'es sq)
      (subst (list '= v (list 'ESUM l1)))
      (subst (list '= l1 l2))
      (ass))))
(fact 'einf-in mh2b-cs2)
(dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x mh2b-cs1) (list '<= (list 'EINF mh2b-cs2) 'x)))
  (lambda ()
    (let* ((pl (dk-peel!)) (x (cadr (car pl))))
      (fact 'subset-mem-fwd mh2b-cs1 mh2b-cs2 x)
      (fact 'einf-lower mh2b-cs2)
      (inst+ (mh2-pick 'lower (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'EINF) (dk-contains? z mh2b-cs2)
                                              (not (dk-contains? z mh2b-cs1))))) x)
      (ass))))
(fact 'einf-greatest mh2b-cs1)
(inst+ (mh2-pick 'greatest (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'EINF) (dk-contains? z mh2b-cs1)
                                            (not (dk-contains? z mh2b-cs2)))))
       (list 'EINF mh2b-cs2))
(ass)
(qed 'method-ii-delta-antitone)

;;; ---------------------------------------------------------------------------
;;; mu*_0 = METHOD-II
(define (mh2-sv m cls pm es)
  (list 'SEP 'mhv_ 'RR-POS-STAR (list 'FORSOME 'mhd_ (list 'AND '(IN mhd_ RR) (list 'AND '(POS-RR mhd_)
        (list '= 'mhv_ (list (list 'METHOD-II-DELTA m cls pm 'mhd_) es)))))))
(sp (make-wff (forall-guarded '(m cls pm es) '((IN es (POWER (PTS m))))
  (list '= '((METHOD-II m cls pm) es) (list 'ESUP (mh2-sv 'm 'cls 'pm 'es))))))
(dk-peel!)
(mac 'METHOD-II)
(dk-lam-b!)
(let ((g (dk-goal))) (if (not (proof-done? *ps*)) (begin (mh2-sep-sub! (cadr (cadr g))) (fact 'esup-in (cadr (cadr g))) (rfl))))
(qed 'method-ii-value)

;;; mu*_delta(E) <= mu*_0(E), delta > 0
(sp (make-wff (forall-guarded '(m cls pm es dl)
  '((IS-PREMEASURE (PTS m) cls pm) (IN es (POWER (PTS m))) (POS-RR dl))
  '(<= ((METHOD-II-DELTA m cls pm dl) es) ((METHOD-II m cls pm) es)))))
(dk-peel!)
(dk-pos-parts! 'dl)
(let* ((S (mh2-sv 'm 'cls 'pm 'es)) (v '((METHOD-II-DELTA m cls pm dl) es)))
  (fact 'method-ii-delta-outer 'm 'cls 'pm 'dl)
  (dk-project! '(IN (METHOD-II-DELTA m cls pm dl) (FUN (POWER (PTS m)) RR-POS-STAR)) 'is-outer-measure
               '(IS-OUTER-MEASURE (PTS m) (METHOD-II-DELTA m cls pm dl)))
  (fact 'fun-apply-type-c '(METHOD-II-DELTA m cls pm dl) '(POWER (PTS m)) 'RR-POS-STAR 'es)
  (dk-have! (list 'IN v S)
    (lambda () (in-sep! (lambda () (ew 'dl) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))))
  (mh2-sep-sub! S)
  (subst (dk-cite! 'method-ii-value 'm 'cls 'pm 'es))
  (fact 'esup-upper S)
  (inst+ (mh2-pick 'up (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'ESUP)))) v)
  (ass))
(qed 'method-ii-delta-le)

;;; every mu*_delta(E) <= b  ==>  mu*_0(E) <= b
(sp (make-wff (forall-guarded '(m cls pm es b)
  '((IN es (POWER (PTS m))) (IN b RR-POS-STAR)
    (FORALL dl (IMPLIES (POS-RR dl) (<= ((METHOD-II-DELTA m cls pm dl) es) b))))
  '(<= ((METHOD-II m cls pm) es) b))))
(dk-peel!)
(let* ((S (mh2-sv 'm 'cls 'pm 'es))
       (hb (mh2-pick 'bound (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'POS-RR))))))
  (subst (dk-cite! 'method-ii-value 'm 'cls 'pm 'es))
  (mh2-sep-sub! S)
  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x S) '(<= x b)))
    (lambda ()
      (let* ((pl (dk-peel!)) (x (cadr (car pl))))
        (sep-me (list 'IN x S))
        (let ((d (dk-skolem! (mh2-pick 'ex (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z x)))) #t)))
          (inst+ hb d)
          (subst (mh2-pick 'eq (lambda (z) (and (dk-head-is? z '=) (equal? (cadr z) x)))))
          (ass)))))
  (dk-have! (list 'AND '(IN b RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x S) '(<= x b)))))
  (fact 'esup-least S 'b)
  (ass))
(qed 'method-ii-least)

;;; x <= y <= z in RR-POS-STAR  ==>  x <= z
(define (mh2-le-trans! x y z)
  (dk-have! (list 'AND (list 'IN x 'RR-POS-STAR) (list 'AND (list 'IN y 'RR-POS-STAR) (list 'IN z 'RR-POS-STAR))))
  (dk-have! (list 'AND (list '<= x y) (list '<= y z)))
  (fact 'rr-pos-star-le-trans x y z))
(define mh2-MII '(METHOD-II m cls pm))
(define (mh2-miid d) (list 'METHOD-II-DELTA 'm 'cls 'pm d))
;;; the outer-measure parts of mu*_delta, landed: (fun typing, mono universal, subadd universal)
(define (mh2-miid-parts! d)
  (let* ((om (list 'IS-OUTER-MEASURE '(PTS m) (mh2-miid d)))
         (mu (mh2-miid d))
         (c1 (list 'IN mu '(FUN (POWER (PTS m)) RR-POS-STAR)))
         (c2 (list '= (list mu 'EMPTY-SET) 0))
         (c3 (list 'FORALL 'a_ (list 'FORALL 'b_
               (list 'IMPLIES '(IN a_ (POWER (PTS m)))
                 (list 'IMPLIES '(IN b_ (POWER (PTS m)))
                   (list 'IMPLIES '(SUBSET a_ b_) (list '<= (list mu 'a_) (list mu 'b_))))))))
         (c4 (list 'FORALL 'f_ (list 'IMPLIES '(IN f_ (FUN NN (POWER (PTS m))))
               (list '<= (list mu '(BIG-UNION n_ NN (f_ n_)))
                         (list 'ESUM (list 'VNB-LAMBDA 'n_ 'NN (list mu '(f_ n_)))))))))
    (if (not (dk-asm? (list '<= 0 d))) (dk-pos-parts! d))
    (fact 'method-ii-delta-outer 'm 'cls 'pm d)
    (map (lambda (c) (dk-project! c 'is-outer-measure om)) (list c1 c2 c3 c4))))
;;; (IN (ESUM fv) RR-POS-STAR) for fv in FUN(NN, RR-POS-STAR) (the cth-esum-type! pattern)
(define (mh2-esum-type! fv)
  (fact 'nn-is-set)
  (dk-project! (list 'IN fv '(FUN NN)) 'fun-codomain-iff (list 'IN fv '(FUN NN RR-POS-STAR)))
  (dk-have! (list 'AND (list 'IN fv '(FUN NN)) '(IN NN SET)))
  (fact 'dom-of-fun 'NN fv)
  (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN (list 'DOM fv) 'SET) (list '= (list 'DOM fv) 'NN)))))
  (dk-have! (list 'IN fv (list 'FUN (list 'DOM fv) 'RR-POS-STAR))
            (lambda () (subst (list '= (list 'DOM fv) 'NN)) (ass)))
  (fact 'esum-in fv))

(sp (make-wff (forall-guarded '(m cls pm es) '((IN es (POWER (PTS m))))
  '(IN ((METHOD-II m cls pm) es) RR-POS-STAR))))
(dk-peel!)
(subst (dk-cite! 'method-ii-value 'm 'cls 'pm 'es))
(let ((S (mh2-sv 'm 'cls 'pm 'es))) (mh2-sep-sub! S) (fact 'esup-in S) (ass))
(qed 'method-ii-in)

(sp (make-wff (forall-guarded '(m cls pm) '((IS-PREMEASURE (PTS m) cls pm))
  '(IS-OUTER-MEASURE (PTS m) (METHOD-II m cls pm)))))
(dk-peel!)
(mh2-pre-parts!)
(fact 'zero-in-rr-pos-star)
(fact 'power-set '(PTS m))
(fact 'power-empty-in '(PTS m))
(mac 'is-outer-measure)
(for-each
 (lambda (leaf)
   (dk-focus! leaf)
   (let ((g (dk-goal)))
     (cond
      ((dk-asm? g) (ass))
      ((and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'FUN))   ; typing
       (mac 'METHOD-II)
       (dk-lam-type!
        (lambda ()
          (let* ((e (dk-di-var!)) (S (cadr (cadr (dk-goal)))))
            (mh2-sep-sub! S)
            (fact 'esup-in S)
            (ass)))
        (lambda () (ass))))
      ((dk-head-is? g '=)                                   ; mu*_0(empty) = 0
       (let ((v (list mh2-MII 'EMPTY-SET)))
         (fact 'method-ii-in 'm 'cls 'pm 'EMPTY-SET)
         (dk-have! (list 'FORALL 'dl (list 'IMPLIES '(POS-RR dl) (list '<= (list (mh2-miid 'dl) 'EMPTY-SET) 0)))
           (lambda ()
             (let* ((pl (dk-peel!)) (d (cadr (car pl))))
               (dk-pos-parts! d)
               (mh2-miid-parts! d)
               (subst (list '= (list (mh2-miid d) 'EMPTY-SET) 0))
               (fact 'rr-pos-star-le-refl 0)
               (ass))))
         (fact 'method-ii-least 'm 'cls 'pm 'EMPTY-SET 0)
         (fact 'rr-pos-star-nonneg v)
         (dk-have! (list 'AND (list 'IN v 'RR-POS-STAR) '(IN 0 RR-POS-STAR)))
         (dk-have! (list 'AND (list '<= v 0) (list '<= 0 v)))
         (fact 'rr-pos-star-le-antisymm v 0)
         (ass)))
      ((dk-contains? g 'BIG-UNION)                          ; countable subadditivity
       (let* ((pl (dk-peel!)) (f (cadr (car (filter (lambda (z) (dk-head-is? z 'IN)) pl))))
              (bu (list 'BIG-UNION 'n_ 'NN (list f 'n_)))
              (lam0 (list 'VNB-LAMBDA 'n_ 'NN (list mh2-MII (list f 'n_))))
              (b (list 'ESUM lam0)))
         (fact 'power-fun-union-closed '(PTS m) f)
         (dk-have! (list 'IN lam0 '(FUN NN RR-POS-STAR))
           (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!)))
                                                  (fact 'fun-apply-type-c f 'NN '(POWER (PTS m)) k)
                                                  (fact 'method-ii-in 'm 'cls 'pm (list f k)) (ass)))
                                    (lambda () (fact 'nn-is-set) (ass)))))
         (dk-have! (list 'IN b 'RR-POS-STAR)
           (lambda () (mh2-esum-type! lam0) (ass)))
         (dk-have! (list 'FORALL 'dl (list 'IMPLIES '(POS-RR dl) (list '<= (list (mh2-miid 'dl) bu) b)))
           (lambda ()
             (let* ((pl2 (dk-peel!)) (d (cadr (car pl2)))
                    (parts (mh2-miid-parts! d))
                    (lamd (list 'VNB-LAMBDA 'n_ 'NN (list (mh2-miid d) (list f 'n_))))
                    (sd (list 'ESUM lamd)))
               (dk-pos-parts! d)
               (dk-apply! (list-ref parts 3) f)
               (dk-have! (list 'IN lamd '(FUN NN RR-POS-STAR))
                 (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!)))
                                                        (fact 'fun-apply-type-c f 'NN '(POWER (PTS m)) k)
                                                        (fact 'fun-apply-type-c (mh2-miid d) '(POWER (PTS m)) 'RR-POS-STAR (list f k))
                                                        (ass)))
                                          (lambda () (fact 'nn-is-set) (ass)))))
               (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list lamd 'k) (list lam0 'k))))
                 (lambda () (let ((k (dk-di-var!)))
                              (fact 'fun-apply-type-c f 'NN '(POWER (PTS m)) k)
                              (dk-lam-b!)
                              (fact 'method-ii-delta-le 'm 'cls 'pm (list f k) d)
                              (ass))))
               (fact 'esum-nn-le-termwise lamd lam0)
               (fact 'fun-apply-type-c (mh2-miid d) '(POWER (PTS m)) 'RR-POS-STAR bu)
               (dk-have! (list 'IN sd 'RR-POS-STAR)
                 (lambda () (mh2-esum-type! lamd) (ass)))
               (mh2-le-trans! (list (mh2-miid d) bu) sd b)
               (ass))))
         (fact 'method-ii-least 'm 'cls 'pm bu b)
         (ass)))
      (#t                                                   ; monotone
       (let* ((pl (dk-peel!))
              (gg (dk-goal))
              (a (cadr (cadr gg))) (bb (cadr (caddr gg)))
              (mb (list mh2-MII bb)))
         (fact 'method-ii-in 'm 'cls 'pm bb)
         (dk-have! (list 'FORALL 'dl (list 'IMPLIES '(POS-RR dl) (list '<= (list (mh2-miid 'dl) a) mb)))
           (lambda ()
             (let* ((pl2 (dk-peel!)) (d (cadr (car pl2)))
                    (parts (mh2-miid-parts! d)))
               (dk-pos-parts! d)
               (dk-apply! (list-ref parts 2) a bb)
               (fact 'fun-apply-type-c (mh2-miid d) '(POWER (PTS m)) 'RR-POS-STAR a)
               (fact 'fun-apply-type-c (mh2-miid d) '(POWER (PTS m)) 'RR-POS-STAR bb)
               (fact 'method-ii-delta-le 'm 'cls 'pm bb d)
               (mh2-le-trans! (list (mh2-miid d) a) (list (mh2-miid d) bb) mb)
               (ass))))
         (fact 'method-ii-least 'm 'cls 'pm a mb)
         (ass))))))
 (mh2-split-goal!))
(qed 'method-ii-outer-measure)

;;; ---------------------------------------------------------------------------
(sp (make-wff '(FORALL x (FORALL a (FORALL b (IMPLIES (IN a (POWER x)) (IMPLIES (IN b (POWER x))
   (IN (UNION a b) (POWER x)))))))))
(dk-peel!)
(dk-project! '(IN a SET) 'power-set-membership '(IN a (POWER x)))
(dk-project! '(IN b SET) 'power-set-membership '(IN b (POWER x)))
(dk-project! '(FORALL z (IMPLIES (IN z a) (IN z x))) 'power-set-membership '(IN a (POWER x)))
(dk-project! '(FORALL z (IMPLIES (IN z b) (IN z x))) 'power-set-membership '(IN b (POWER x)))
(dk-have! '(AND (IN a SET) (IN b SET)))
(fact 'union-set-closure 'a 'b)
(mac 'power-set-membership)
(for-each
 (lambda (leaf)
   (dk-focus! leaf)
   (if (dk-asm? (dk-goal)) (ass)
       (let* ((pl (dk-peel!)) (z (cadr (car pl))))
         (mac-h 'union-membership (list 'IN z '(UNION a b)))
         (use-cases (list (list 'IN z 'a) (list 'IN z 'b))
           (lambda () (inst+ (mh2-pick 'fa (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q '(IN z a))))) z) (ass))
           (lambda () (inst+ (mh2-pick 'fb (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q '(IN z b))))) z) (ass))))))
 (mh2-split-goal!))
(qed 'union-in-power)

;;; ---------------------------------------------------------------------------
;;; THE SEPARATION STEP: delta < r, E and F at distance >= r:  mu_d(E) + mu_d(F) <= mu_d(E u F).
;;; A cover of E u F by sets of diameter <= delta splits into the members meeting E and the members
;;; meeting F (none meets both): U_k = s_k if s_k meets E else empty, V_k likewise.
(define mh2c-cd (mh2-cd 'm 'cls 'dl))
(define mh2c-r (mh2-rcd 'm 'cls 'pm 'dl))
(define (mh2c-cs es) (mh2-cs 'm 'cls 'pm 'dl es))
(define (mh2c-cond sq k es) (list 'FORSOME 'mhz_ (list 'AND (list 'IN 'mhz_ (list sq k)) (list 'IN 'mhz_ es))))
(define (mh2c-split sq es) (list 'VNB-LAMBDA 'mhk_ 'NN (list 'IF (mh2c-cond sq 'mhk_ es) (list sq 'mhk_) 'EMPTY-SET)))
(define (mh2c-sumf sq) (list 'VNB-LAMBDA 'cvk_ 'NN (list mh2c-r (list sq 'cvk_))))
(sp (make-wff (forall-guarded '(m cls pm dl r es fs)
  '((IS-METRIC-SPACE m) (IS-PREMEASURE (PTS m) cls pm) (IN dl RR) (<= 0 dl) (POS-RR r) (< dl r)
    (IN es (POWER (PTS m))) (IN fs (POWER (PTS m)))
    (FORALL x (IMPLIES (IN x es) (FORALL y (IMPLIES (IN y fs) (<= r ((DIST m) x y)))))))
  '(<= (eplus ((METHOD-II-DELTA m cls pm dl) es) ((METHOD-II-DELTA m cls pm dl) fs))
       ((METHOD-II-DELTA m cls pm dl) (UNION es fs))))))
(dk-peel!)
(mh2-pre-parts!)
(dk-pos-parts! 'r)
(fact 'union-in-power '(PTS m) 'es 'fs)
(fact 'method-ii-delta-premeasure 'm 'cls 'pm 'dl)
(define mh2c-pre (list 'IS-PREMEASURE '(PTS m) mh2c-cd mh2c-r))
(for-each (lambda (c) (dk-project! c 'is-premeasure mh2c-pre))
          (list (list 'IN 'EMPTY-SET mh2c-cd) (list 'IN mh2c-r (list 'FUN mh2c-cd 'RR-POS-STAR))
                (list '= (list mh2c-r 'EMPTY-SET) 0) (list 'SUBSET mh2c-cd '(POWER (PTS m)))))
(define mh2c-sep (mh2-pick 'sep (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'DIST)))))
(subst (dk-cite! 'method-ii-delta-value 'm 'cls 'pm 'dl 'es))
(subst (dk-cite! 'method-ii-delta-value 'm 'cls 'pm 'dl 'fs))
(subst (dk-cite! 'method-ii-delta-value 'm 'cls 'pm 'dl '(UNION es fs)))
(define mh2c-cse (mh2c-cs 'es))
(define mh2c-csf (mh2c-cs 'fs))
(define mh2c-csu (mh2c-cs '(UNION es fs)))
(for-each (lambda (c) (fact 'cover-sums-subset '(PTS m) mh2c-cd mh2c-r c)) '(es fs (UNION es fs)))
(for-each (lambda (c) (fact 'einf-in c)) (list mh2c-cse mh2c-csf mh2c-csu))
(define mh2c-ie (list 'EINF mh2c-cse))
(define mh2c-if (list 'EINF mh2c-csf))
(define mh2c-b (list 'eplus mh2c-ie mh2c-if))
(dk-have! (list 'AND (list 'IN mh2c-ie 'RR-POS-STAR) (list 'IN mh2c-if 'RR-POS-STAR)))
(fact 'eplus-closed mh2c-ie mh2c-if)
(fact 'einf-lower mh2c-cse)
(fact 'einf-lower mh2c-csf)
;;; one cover: the bound b <= v
(define (mh2c-cover! v)
  (let* ((ex (dk-cite! 'cover-sums-elim '(PTS m) mh2c-cd mh2c-r '(UNION es fs) v))
         (sq (dk-skolem! ex #t))
         (su (mh2c-split sq 'es)) (sv (mh2c-split sq 'fs))
         (fu (mh2c-sumf su)) (fv (mh2c-sumf sv)) (fh (mh2c-sumf sq)))
    ;; k in NN: s_k in C_delta, a subset of the points, with diameter <= dl
    (define (sk! k)
      (fact 'fun-apply-type-c sq 'NN mh2c-cd k)
      (mh2-cd-parts! (list sq k) mh2c-cd)
      (fact 'subset-mem-fwd mh2c-cd '(POWER (PTS m)) (list sq k))
      (dk-project! (list 'SUBSET (list sq k) '(PTS m))
                   (lambda () (mac-h 'power-set-membership (list 'IN (list sq k) '(POWER (PTS m))))
                              (dk-split-all!) (mac 'subset-def))))
    ;; the split functions are in FUN(NN, C_delta)
    (define (split-typed! spl es0)
      (dk-have! (list 'IN spl (list 'FUN 'NN mh2c-cd))
        (lambda ()
          (dk-lam-type!
           (lambda ()
             (let* ((k (dk-di-var!)) (ift (cadr (dk-goal))))
               (fact 'fun-apply-type-c sq 'NN mh2c-cd k)
               (dk-case-if! ift (lambda (tv val) (ass)))))
           (lambda () (fact 'nn-is-set) (ass))))))
    ;; es (fs) is covered by the split
    (define (covers! spl es0)
      (dk-have! (list 'SUBSET es0 (list 'BIG-UNION 'cvn_ 'NN (list spl 'cvn_)))
        (lambda ()
          (mac 'subset-def)
          (let* ((pl (dk-peel!)) (x (cadr (car pl))))
            (dk-have! (list 'IN x '(UNION es fs)) (lambda () (mac 'union-membership) (if (eq? es0 'es) (oi-l) (oi-r)) (ass)))
            (fact 'subset-mem-fwd '(UNION es fs) (list 'BIG-UNION 'cvn_ 'NN (list sq 'cvn_)) x)
            (let* ((nl (dk-landed (lambda () (bu-me (list 'IN x (list 'BIG-UNION 'cvn_ 'NN (list sq 'cvn_)))))))
                   (k (cadr (car (filter (lambda (z) (and (dk-head-is? z 'IN) (eq? (caddr z) 'NN))) nl)))))
              (for-each (lambda (leaf)
                          (dk-focus! leaf)
                          (if (dk-asm? (dk-goal)) (ass)
                              (let ((cnd (mh2c-cond sq k es0)))
                                (dk-lam-b!)
                                (dk-have! cnd (lambda () (ew x) (dk-conj-close! (lambda () (ass)))))
                                (dk-if-branch! #t (caddr (dk-goal)) #f (lambda () (ass))))))
                        (dk-opened (lambda () (bu-mi k)))))))))
    ;; the three sum functions are in FUN(NN, RR-POS-STAR)
    (define (sum-typed! spl cd0)
      (dk-have! (list 'IN (mh2c-sumf spl) '(FUN NN RR-POS-STAR))
        (lambda ()
          (dk-lam-type!
           (lambda ()
             (let ((k (dk-di-var!)))
               (fact 'fun-apply-type-c spl 'NN mh2c-cd k)
               (fact 'fun-apply-type-c mh2c-r mh2c-cd 'RR-POS-STAR (list spl k))
               (ass)))
           (lambda () (fact 'nn-is-set) (ass))))))
    (split-typed! su 'es)
    (split-typed! sv 'fs)
    (covers! su 'es)
    (covers! sv 'fs)
    (sum-typed! su #f) (sum-typed! sv #f) (sum-typed! sq #f)
    ;; termwise: R(U_k) + R(V_k) <= R(s_k)
    (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list 'eplus (list fu 'k) (list fv 'k)) (list fh 'k))))
      (lambda ()
        (let* ((k (dk-di-var!)) (c1 (mh2c-cond sq k 'es)) (c2 (mh2c-cond sq k 'fs))
               (rk (list mh2c-r (list sq k))) (r0 (list mh2c-r 'EMPTY-SET)))
          (sk! k)
          (fact 'fun-apply-type-c su 'NN mh2c-cd k)
          (fact 'fun-apply-type-c sv 'NN mh2c-cd k)
          (dk-lam-b!)
          (fact 'fun-apply-type-c mh2c-r mh2c-cd 'RR-POS-STAR (list sq k))
          (fact 'zero-in-rr-pos-star)
          (fact 'rr-pos-star-nonneg rk)
          (fact 'rr-pos-star-le-refl rk)
          (fact 'eplus-zero-right rk)
          (fact 'eplus-zero-left rk)
          (fact 'eplus-zero-left 0)
          (use-em c1
            (lambda ()                                          ; s_k meets E, so not F
              (dk-have! (list 'NOT c2)
                (lambda ()
                  (di)
                  (let* ((x (dk-skolem! (mh2-pick 'c1 (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z 'es)))) #t))
                         (y (dk-skolem! (mh2-pick 'c2 (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z 'fs)))) #t))
                         (dxy (list (list 'DIST 'm) x y)))
                    (inst+ mh2c-sep x)
                    (inst+ (mh2-pick 'sepx (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z x) (dk-contains? z 'DIST)))) y)
                    (fact 'diam-dist-le 'm (list sq k) x y)
                    (fact 'subset-mem-fwd (list sq k) '(PTS m) x)
                    (fact 'subset-mem-fwd (list sq k) '(PTS m) y)
                    (fact 'metric-dist-real 'm x y)
                    (fact 'diam-in 'm (list sq k))
                    (dk-have! (list 'AND (list 'IN (list 'DIAM 'm (list sq k)) 'RR-POS-STAR) '(IN dl RR)))
                    (fact 'rr-pos-star-le-real-in-rr (list 'DIAM 'm (list sq k)) 'dl)
                    (dk-absurd! (list '<= 'r dxy) (list '<= dxy (list 'DIAM 'm (list sq k)))
                                (list '<= (list 'DIAM 'm (list sq k)) 'dl) '(< dl r)))))
              (dk-if-branch! #t (list 'IF c1 (list sq k) 'EMPTY-SET) #f (lambda () #t))
              (dk-if-branch! #f (list 'IF c2 (list sq k) 'EMPTY-SET) #f (lambda () #t))
              (subst (list '= r0 0))
              (subst (list '= (list 'eplus rk 0) rk))
              (ass))
            (lambda ()                                          ; s_k does not meet E
              (dk-if-branch! #f (list 'IF c1 (list sq k) 'EMPTY-SET) #f (lambda () #t))
              (subst (list '= r0 0))
              (dk-case-if! (list 'IF c2 (list sq k) 'EMPTY-SET)
                (lambda (tv val)
                  (if tv
                      (begin (subst (list '= (list 'eplus 0 rk) rk)) (ass))
                      (begin (subst (list '= r0 0)) (subst (list '= (list 'eplus 0 0) 0))
                             (fact 'rr-pos-star-le-refl 0) (ass))))))))))
    (fact 'esum-nn-superadditive fu fv fh)
    (fact 'cover-sums-intro '(PTS m) mh2c-cd mh2c-r 'es su)
    (fact 'cover-sums-intro '(PTS m) mh2c-cd mh2c-r 'fs sv)
    (mh2-esum-type! fu) (mh2-esum-type! fv) (mh2-esum-type! fh)
    (inst+ (mh2-pick 'le (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z mh2c-cse) (dk-contains? z 'EINF)))) (list 'ESUM fu))
    (inst+ (mh2-pick 'lf (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z mh2c-csf) (dk-contains? z 'EINF)))) (list 'ESUM fv))
    (dk-have! (list 'AND (list 'IN mh2c-ie 'RR-POS-STAR) (list 'AND (list 'IN mh2c-if 'RR-POS-STAR)
                (list 'AND (list 'IN (list 'ESUM fu) 'RR-POS-STAR) (list 'IN (list 'ESUM fv) 'RR-POS-STAR)))))
    (dk-have! (list 'AND (list '<= mh2c-ie (list 'ESUM fu)) (list '<= mh2c-if (list 'ESUM fv))))
    (fact 'eplus-mono mh2c-ie mh2c-if (list 'ESUM fu) (list 'ESUM fv))
    (dk-have! (list 'AND (list 'IN (list 'ESUM fu) 'RR-POS-STAR) (list 'IN (list 'ESUM fv) 'RR-POS-STAR)))
    (fact 'eplus-closed (list 'ESUM fu) (list 'ESUM fv))
    (mh2-le-trans! mh2c-b (list 'eplus (list 'ESUM fu) (list 'ESUM fv)) (list 'ESUM fh))
    (subst (list '= v (list 'ESUM fh)))
    (ass)))
(dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x mh2c-csu) (list '<= mh2c-b 'x)))
  (lambda () (let* ((pl (dk-peel!)) (v (cadr (car pl)))) (mh2c-cover! v))))
(inst+ (dk-fact! 'einf-greatest mh2c-csu) mh2c-b)
(ass)
(qed 'method-ii-delta-separated)

;;; ---------------------------------------------------------------------------
;;; the limit along delta_n = 1/(n+1)
(define (mh2-useq es) (list 'VNB-LAMBDA 'mhn_ 'NN (list (mh2-miid '(recip (+ mhn_ 1))) es)))
(define (mh2-dn n) (list 'recip (list '+ n 1)))
;;; n in NN: delta_n pos-rr, real, >= 0; u(n) typed
(define (mh2-dn! n)
  (fact 'nn-recip-succ-pos n)
  (dk-pos-parts! (mh2-dn n)))
(define (mh2-u-typed! es)
  (dk-have! (list 'IN (mh2-useq es) '(FUN NN RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
       (lambda ()
         (let ((n (dk-di-var!)))
           (mh2-dn! n)
           (let ((parts (mh2-miid-parts! (mh2-dn n))))
             (fact 'fun-apply-type-c (mh2-miid (mh2-dn n)) '(POWER (PTS m)) 'RR-POS-STAR es)
             (ass))))
       (lambda () (fact 'nn-is-set) (ass))))))
(define (mh2-in-image! phi n w)            ; (IN w (IMAGE phi NN)) for w = phi(n), w in RR-POS-STAR typed
  (dk-have! (list 'IN w (list 'IMAGE phi 'NN))
    (lambda ()
      (mac 'image-membership-iff)
      (fact 'membership-implies-sethood w 'RR-POS-STAR)
      (dk-conj-close!
       (lambda ()
         (if (dk-asm? (dk-goal)) (ass)
             (begin (ew n) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (dk-lam-b!) (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass) (rfl))))))))))))))
(sp (make-wff (forall-guarded '(m cls pm es) '((IS-PREMEASURE (PTS m) cls pm) (IN es (POWER (PTS m))))
  (list '= '((METHOD-II m cls pm) es) (list 'ESUP (list 'IMAGE (mh2-useq 'es) 'NN))))))
(dk-peel!)
(mh2-pre-parts!)
(define mh2d-u (mh2-useq 'es))
(define mh2d-img (list 'IMAGE mh2d-u 'NN))
(define mh2d-mii '((METHOD-II m cls pm) es))
(mh2-u-typed! 'es)
(fact 'nn-is-set)
(dk-have! (list 'SUBSET mh2d-img 'RR-POS-STAR)
  (lambda () (mac 'subset-def) (let* ((pl (dk-peel!)) (w (cadr (car pl))))
                                 (fact 'image-subset-codomain 'NN 'RR-POS-STAR mh2d-u w) (ass))))
(fact 'esup-in mh2d-img)
(fact 'method-ii-in 'm 'cls 'pm 'es)
;; <= : every mu_delta(E) is below some u(N)
(dk-have! (list 'FORALL 'dl (list 'IMPLIES '(POS-RR dl) (list '<= (list (mh2-miid 'dl) 'es) (list 'ESUP mh2d-img))))
  (lambda ()
    (let* ((pl (dk-peel!)) (d (cadr (car pl)))
           (nN (dk-skolem! (dk-cite! 'nn-recip-succ-small d) #t))
           (dN (mh2-dn nN)) (uN (list (mh2-miid dN) 'es)))
      (dk-pos-parts! d)
      (mh2-dn! nN)
      (mh2-miid-parts! d) (mh2-miid-parts! dN)
      (fact 'fun-apply-type-c (mh2-miid d) '(POWER (PTS m)) 'RR-POS-STAR 'es)
      (fact 'fun-apply-type-c (mh2-miid dN) '(POWER (PTS m)) 'RR-POS-STAR 'es)
      (fact 'rr-lt-implies-le dN d)
      (fact 'method-ii-delta-antitone 'm 'cls 'pm dN d 'es)
      (mh2-in-image! mh2d-u nN uN)
      (fact 'esup-upper mh2d-img)
      (inst+ (mh2-pick 'up (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'ESUP) (dk-contains? z 'IMAGE)
                                            (not (dk-contains? z 'cpss_))))) uN)
      (mh2-le-trans! (list (mh2-miid d) 'es) uN (list 'ESUP mh2d-img))
      (ass))))
(fact 'method-ii-least 'm 'cls 'pm 'es (list 'ESUP mh2d-img))
;; >= : every u(n) is below mu*_0(E)
(dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x mh2d-img) (list '<= 'x mh2d-mii)))
  (lambda ()
    (let* ((pl (dk-peel!)) (w (cadr (car pl))))
      (mac-h 'image-membership-iff (list 'IN w mh2d-img))
      (let ((n (dk-skolem! (mh2-pick 'ex (lambda (z) (and (or (dk-head-is? z 'FORSOME) (dk-head-is? z 'AND)) (dk-contains? z w)
                                                         (dk-contains? z 'FORSOME)))) #t)))
        (mh2-dn! n)
        (dk-lam-b-h! (mh2-pick 'eq (lambda (z) (and (dk-head-is? z '=) (equal? (caddr z) w)))))
        (let ((e2 (mh2-pick 'eq2 (lambda (z) (and (dk-head-is? z '=) (equal? (caddr z) w) (not (dk-contains? z 'mhn_)))))))
          (subst (list '= w (cadr e2))))
        (fact 'method-ii-delta-le 'm 'cls 'pm 'es (mh2-dn n))
        (ass)))))
(dk-have! (list 'AND (list 'IN mh2d-mii 'RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x mh2d-img) (list '<= 'x mh2d-mii)))))
(fact 'esup-least mh2d-img mh2d-mii)
(dk-have! (list 'AND (list 'IN mh2d-mii 'RR-POS-STAR) (list 'IN (list 'ESUP mh2d-img) 'RR-POS-STAR)))
(dk-have! (list 'AND (list '<= mh2d-mii (list 'ESUP mh2d-img)) (list '<= (list 'ESUP mh2d-img) mh2d-mii)))
(fact 'rr-pos-star-le-antisymm mh2d-mii (list 'ESUP mh2d-img))
(ass)
(qed 'method-ii-seq)

;;; ---------------------------------------------------------------------------
;;; PROPOSITION 4.23: the method-II outer measure is a metric outer measure.
(sp (make-wff (forall-guarded '(m cls pm) '((IS-METRIC-SPACE m) (IS-PREMEASURE (PTS m) cls pm))
  '(IS-METRIC-OUTER-MEASURE m (METHOD-II m cls pm)))))
(dk-peel!)
(mh2-pre-parts!)
(fact 'method-ii-outer-measure 'm 'cls 'pm)
(fact 'nn-is-set)
(define (mh2e-sub! a)                        ; a in POWER(PTS m): SUBSET a (PTS m)
  (dk-project! (list 'SUBSET a '(PTS m))
    (lambda () (mac-h 'power-set-membership (list 'IN a '(POWER (PTS m)))) (dk-split-all!) (mac 'subset-def))))
(define (mh2e-main! a b)
  (let* ((ab (list 'UNION a b))
         (Ma (list mh2-MII a)) (Mb (list mh2-MII b)) (Mab (list mh2-MII ab))
         (ua (mh2-useq a)) (ub (mh2-useq b)))
    (mh2e-sub! a) (mh2e-sub! b)
    (fact 'union-in-power '(PTS m) a b)
    (for-each (lambda (e) (fact 'method-ii-in 'm 'cls 'pm e)) (list a b ab))
    (dk-have! (list 'AND (list 'IN Ma 'RR-POS-STAR) (list 'IN Mb 'RR-POS-STAR)))
    (fact 'eplus-closed Ma Mb)
    (fact 'outer-measure-binary-subadditive '(PTS m) mh2-MII a b)
    (let* ((rr0 (dk-skolem! (dk-cite! 'set-dist-pos-elim 'm a b) #t))
           (n0 (dk-skolem! (dk-cite! 'nn-recip-succ-small rr0) #t)))
      (dk-pos-parts! rr0)
      (mh2-dn! n0)
      (mh2-u-typed! a) (mh2-u-typed! b)
      ;; nondecreasing
      (define (nondecr! es)
        (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (list (mh2-useq es) 'n) (list (mh2-useq es) '(succ n)))))
          (lambda ()
            (let ((n (dk-di-var!)))
              (fact 'nn-succ-closed n)
              (dk-lam-b!)
              (mh2-dn! n) (mh2-dn! (list 'succ n))
              (fact 'nn-le-succ n)
              (fact 'nn-recip-succ-antitone n (list 'succ n))
              (fact 'method-ii-delta-antitone 'm 'cls 'pm (mh2-dn (list 'succ n)) (mh2-dn n) es)
              (ass)))))
      (nondecr! a) (nondecr! b)
      ;; eplus(u n, v n) <= mu*_0(E u F)
      (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (list 'eplus (list ua 'n) (list ub 'n)) Mab)))
        (lambda ()
          (let* ((n (dk-di-var!)) (nN (list '+ n n0)) (dsml (mh2-dn n)) (dbig (mh2-dn nN))
                 (usmla (list (mh2-miid dsml) a)) (usmlb (list (mh2-miid dsml) b))
                 (ubiga (list (mh2-miid dbig) a)) (ubigb (list (mh2-miid dbig) b)) (ubigab (list (mh2-miid dbig) ab)))
            (dk-lam-b!)
            (dk-have! (list 'AND (list 'IN n 'NN) (list 'IN n0 'NN)))
            (fact 'nn-add-closed n n0)
            (mh2-dn! n) (mh2-dn! nN)
            (fact 'nn-le-add-right n0 n)
            (fact 'nn-le-add-left n n0)
            (fact 'nn-recip-succ-antitone n nN)
            (fact 'nn-recip-succ-antitone n0 nN)
            (dk-have! (list '< dbig rr0) (lambda () (dk-ineq! (list '<= dbig (mh2-dn n0)) (list '< (mh2-dn n0) rr0))))
            (fact 'method-ii-delta-antitone 'm 'cls 'pm dbig dsml a)
            (fact 'method-ii-delta-antitone 'm 'cls 'pm dbig dsml b)
            (for-each (lambda (d) (mh2-miid-parts! d)) (list dsml dbig))
            (for-each (lambda (t) (fact 'fun-apply-type-c (car t) '(POWER (PTS m)) 'RR-POS-STAR (cadr t)))
                      (list (list (mh2-miid dsml) a) (list (mh2-miid dsml) b) (list (mh2-miid dbig) a) (list (mh2-miid dbig) b)
                            (list (mh2-miid dbig) ab)))
            (dk-have! (list 'AND (list 'IN usmla 'RR-POS-STAR) (list 'AND (list 'IN usmlb 'RR-POS-STAR)
                        (list 'AND (list 'IN ubiga 'RR-POS-STAR) (list 'IN ubigb 'RR-POS-STAR)))))
            (dk-have! (list 'AND (list '<= usmla ubiga) (list '<= usmlb ubigb)))
            (fact 'eplus-mono usmla usmlb ubiga ubigb)
            (fact 'method-ii-delta-separated 'm 'cls 'pm dbig rr0 a b)
            (fact 'method-ii-delta-le 'm 'cls 'pm ab dbig)
            (dk-have! (list 'AND (list 'IN usmla 'RR-POS-STAR) (list 'IN usmlb 'RR-POS-STAR)))
            (fact 'eplus-closed usmla usmlb)
            (dk-have! (list 'AND (list 'IN ubiga 'RR-POS-STAR) (list 'IN ubigb 'RR-POS-STAR)))
            (fact 'eplus-closed ubiga ubigb)
            (mh2-le-trans! (list 'eplus usmla usmlb) (list 'eplus ubiga ubigb) ubigab)
            (mh2-le-trans! (list 'eplus usmla usmlb) ubigab Mab)
            (ass))))
      (fact 'esup-eplus-le ua ub)
      (inst+ (mh2-pick 'el (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'eplus) (dk-contains? z 'ESUP)
                                            (not (dk-contains? z 'u))))) Mab)
      (let* ((sa (dk-cite! 'method-ii-seq 'm 'cls 'pm a)) (sb (dk-cite! 'method-ii-seq 'm 'cls 'pm b)))
        (let* ((h1 (mh2-pick 'sup (lambda (z) (and (dk-head-is? z '<=) (dk-contains? z 'ESUP) (equal? (caddr z) Mab)))))
               (h2 (dk-rewrite-h! h1 (caddr sa) Ma))
               (h3 (dk-rewrite-h! h2 (caddr sb) Mb)))
          (dk-have! (list 'AND (list 'IN Mab 'RR-POS-STAR) (list 'IN (list 'eplus Ma Mb) 'RR-POS-STAR)))
          (dk-have! (list 'AND (list '<= Mab (list 'eplus Ma Mb)) (list '<= (list 'eplus Ma Mb) Mab)))
          (fact 'rr-pos-star-le-antisymm Mab (list 'eplus Ma Mb))
          (ass))))))
(mac 'is-metric-outer-measure)
(for-each
 (lambda (leaf)
   (dk-focus! leaf)
   (if (dk-asm? (dk-goal)) (ass)
       (let* ((pl (dk-peel!))
              (ins (filter (lambda (z) (dk-head-is? z 'IN)) pl))
              (g (dk-goal))
              (ab (cadr (cadr g))))
         (mh2e-main! (cadr ab) (caddr ab)))))
 (mh2-split-goal!))
(qed 'method-ii-metric-outer-measure)

(display ";; MH2 qed failures: ") (display *vnb-qed-failures*) (newline)
