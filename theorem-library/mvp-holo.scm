;;; mvp-holo.scm -- WAVE 2 (2026-10-27..30), wired 2026-10-30 from scratchpad/calint2/mvp-holo.scm.
;;; Library: complex-analysis.

;;; mvp-holo.scm -- holomorphic functions have the mean value property (complex-analysis 3.54 for the
;;; class of 3.8), and 3.55 for holomorphic f as a corollary (CAL-INT-2 follow-on, 2026-10-28).
;;;   cc-radial-scale              |(c + s(y - c)) - c| = s |y - c|, |y - (c + s(y - c))| = (1 - s)|y - c|
;;;   closed-ball-in-closure-ball  the closed disc lies in the closure of the open one (r > 0)
;;;   closed-disc-margin           the closure of B(c, r) inside an open u: some B(c, Rb), Rb > r, inside u
;;;                                (compact-open-margin of scratchpad/ch3c/ch3c-gen.scm at the closed disc)
;;;   holomorphic-has-mean-value-property
;;;   holomorphic-maximum-modulus  3.55 for holomorphic f
;;; Library: complex-analysis.  Load window: after mvp-modulus, mvp-bounded (closure-cc-sequence-free-closed)
;;; and CH3-C's compact-margins (compact-open-margin).  Prefix mvh-.

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (mvh-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (mvh-pts!)
  (fact 'cc-is-metric-space)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))

;;; (1) radial scaling
(sp (make-wff "forall([c in cc, y in cc, s in rr], 0 <= s implies s <= 1 implies
   magnitude(c + s * (y - c) - c) = s * magnitude(y - c) and magnitude(y - (c + s * (y - c))) = (1 - s) * magnitude(y - c))"))
(dk-peel!)
(let* ((d '(- y c)) (z '(+ c (* s (- y c)))) (s1 '(- 1 s)))
  (fact 'rr-one-in) (fact 'rr-sub-in-rr 1 's)
  (fact 'rr-subset-cc 's) (fact 'rr-subset-cc s1)
  (fact 'cc-sub-in-cc 'y 'c)
  (fact 'cc-magnitude-closed d)
  (mvh-and! '(IN s CC) (list 'IN d 'CC)) (dk-cite! 'cc-magnitude-mul 's d)
  (mvh-and! (list 'IN s1 'CC) (list 'IN d 'CC)) (dk-cite! 'cc-magnitude-mul s1 d)
  (dk-cite! 'rr-magnitude-is-abs 's) (dk-cite! 'rr-abs-of-nonneg 's)
  (dk-have! (list '<= 0 s1) (lambda () (dk-ineq! '(IN s RR) '(<= s 1))))
  (dk-cite! 'rr-magnitude-is-abs s1) (dk-cite! 'rr-abs-of-nonneg s1)
  (dk-conj-close!
   (lambda ()
     (let ((g (dk-goal)))
       (if (dk-contains? (cadr g) '(- y (+ c (* s (- y c)))))
           (begin
             (dk-have! (list '= '(- y (+ c (* s (- y c)))) (list '* s1 d)) (lambda () (crs)))
             (subst (list '= '(- y (+ c (* s (- y c)))) (list '* s1 d)))
             (subst (list '= (list 'magnitude (list '* s1 d)) (list '* (list 'magnitude s1) (list 'magnitude d))))
             (subst (list '= (list 'magnitude s1) (list 'abs s1)))
             (subst (list '= (list 'abs s1) s1))
             (rfl))
           (begin
             (dk-have! (list '= (list '- z 'c) (list '* 's d)) (lambda () (crs)))
             (subst (list '= (list '- z 'c) (list '* 's d)))
             (subst (list '= (list 'magnitude (list '* 's d)) (list '* '(magnitude s) (list 'magnitude d))))
             (subst '(= (magnitude s) (abs s)))
             (subst '(= (abs s) s))
             (fact 'rr-mul-in-rr 's (list 'magnitude d))
             (rfl)))))))
(qed 'cc-radial-scale)

;;; t in (0, 1) with t r < rho from rho > 0, r > 0: t = rho / (rho + r)
(define (mvh-small-t! rho r)       ; lands t in RR, 0 < t, t < 1, (* t r) < rho; returns t
  (let* ((B (list '+ rho r)))
    (fact 'rr-add-in-rr rho r)
    (dk-have! (list '< 0 B) (lambda () (dk-ineq! (list 'IN rho 'RR) (list 'IN r 'RR) (list '< 0 rho) (list '< 0 r))))
    (fact 'rr-pos-ne-zero B)
    (mvh-and! (list 'IN B 'RR) (list 'NOT (list '= B 0)))
    (fact 'rr-recip-closed B) (fact 'rr-recip-pos B) (fact 'rr-recip-inverse B)
    (let* ((q (dk-name! (list 'recip B) 'RR)))
      (dk-have! (list '= (list '* B q) 1) (lambda () (subst (list '= q (list 'recip B))) (ass)))
      (dk-have! (list '< 0 q) (lambda () (subst (list '= q (list 'recip B))) (ass)))
      (fact 'rr-mul-in-rr rho q)
      (let ((t (dk-name! (list '* rho q) 'RR)))
        (fact 'rr-mul-pos rho q)
        (dk-have! (list '< 0 t) (lambda () (subst (list '= t (list '* rho q))) (ass)))
        (fact 'rr-mul-in-rr r q) (fact 'rr-mul-pos r q)
        (fact 'rr-mul-in-rr t r) (fact 'rr-mul-pos t r)
        (fact 'rr-mul-in-rr rho t) (fact 'rr-mul-pos rho t)
        ;; 1 - t = r q and t r = rho - rho t
        (dk-have! (list '= (list '- 1 t) (list '* r q))
          (lambda ()
            (subst (list '= t (list '* rho q)))
            (dk-have! (list '= (list '- (list '- 1 (list '* rho q)) (list '* r q)) (list '- 1 (list '* B q))) (lambda () (crs)))
            (dk-have! (list '= (list '- 1 (list '* rho q)) (list '+ (list '* r q) (list '- (list '- 1 (list '* rho q)) (list '* r q)))) (lambda () (crs)))
            (subst (list '= (list '- 1 (list '* rho q)) (list '+ (list '* r q) (list '- (list '- 1 (list '* rho q)) (list '* r q)))))
            (subst (list '= (list '- (list '- 1 (list '* rho q)) (list '* r q)) (list '- 1 (list '* B q))))
            (subst (list '= (list '* B q) 1))
            (crs)))
        (dk-have! (list '= (list '* t r) (list '- rho (list '* rho t)))
          (lambda ()
            (dk-have! (list '= (list '- rho (list '* rho t)) (list '* rho (list '- 1 t))) (lambda () (crs)))
            (subst (list '= (list '- rho (list '* rho t)) (list '* rho (list '- 1 t))))
            (subst (list '= (list '- 1 t) (list '* r q)))
            (subst (list '= t (list '* rho q)))
            (crs)))
        (dk-have! (list '< t 1)
          (lambda () (dk-ineq! (list 'IN t 'RR) (list 'IN (list '* r q) 'RR) (list '= (list '- 1 t) (list '* r q)) (list '< 0 (list '* r q)))))
        (dk-have! (list '< (list '* t r) rho)
          (lambda () (dk-ineq! (list 'IN (list '* t r) 'RR) (list 'IN (list '* rho t) 'RR) (list 'IN rho 'RR)
                               (list '= (list '* t r) (list '- rho (list '* rho t))) (list '< 0 (list '* rho t)))))
        t))))

;;; (2) the closed disc lies in the closure of the open one
(sp (make-wff "forall([c in cc, r in rr], 0 < r implies closed-ball(cc-ms, c, r) subset closure(cc-ms, ball(cc-ms, c, r)))"))
(dk-peel!)
(mvh-pts!)
(define mvh-B '(BALL CC-MS c r))
(dk-cite! 'rr-pos-rr-of-lt 'r)
(dk-have! (list 'SUBSET mvh-B 'CC)
  (lambda () (let ((y (subset-by-element!))) (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'cc-ms-ball-membership 'c 'r y)))) (ass))))
(dk-have! (list 'SUBSET mvh-B '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
(dk-apply! (dk-cite! 'closure-contains 'CC-MS) mvh-B)
(define mvh-cl (dk-cite! 'closure-cc-sequence-free-closed mvh-B))
(dk-have! (list 'SUBSET '(CLOSED-BALL CC-MS c r) (list 'CLOSURE 'CC-MS mvh-B))
  (lambda ()
    (let* ((y (subset-by-element!))
           (_0 (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'closed-ball-membership 'CC-MS 'c 'r y)))))
           (_1 (dk-have! (list 'IN y 'CC) (lambda () (subst '(== CC (PTS CC-MS))) (ass))))
           (dy (list '- y 'c)) (my (list 'magnitude dy)))
      (fact 'cc-sub-in-cc 'c y) (fact 'cc-sub-in-cc y 'c)
      (dk-cite! 'cc-ms-dist 'c y)
      (fact 'cc-magnitude-sub-sym 'c y)
      (fact 'cc-magnitude-closed dy) (fact 'cc-magnitude-nonneg dy)
      (dk-have! (list '<= my 'r)
        (lambda () (subst (list '= my (list 'magnitude (list '- 'c y)))) (subst (list '== (list 'magnitude (list '- 'c y)) (list '(DIST CC-MS) 'c y))) (ass)))
      (dk-have! (list 'FORALL 'r_ (list 'IMPLIES '(POS-RR r_) (list 'FORSOME 'y_ (list 'AND (list 'IN 'y_ (list 'CLOSURE 'CC-MS mvh-B)) (list '< (list 'magnitude (list '- 'y_ y)) 'r_)))))
        (lambda ()
          (dk-peel!)
          (let* ((rho (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'POS-RR) (not (eq? (cadr f) 'r)))) "rho")))
                 (_2 (fact 'rr-pos-rr-in-rr rho)) (_3 (fact 'rr-lt-of-pos-rr rho))
                 (t (mvh-small-t! rho 'r))
                 (s (list '- 1 t))
                 (z (list '+ 'c (list '* s dy))))
            (fact 'rr-sub-in-rr 1 t)
            (dk-have! (list '<= 0 t) (lambda () (dk-ineq! (list 'IN t 'RR) (list '< 0 t))))
            (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list 'IN t 'RR) (list '< t 1))))
            (dk-have! (list '<= s 1) (lambda () (dk-ineq! (list 'IN t 'RR) (list '< 0 t))))
            (dk-split-all! (list (dk-cite! 'cc-radial-scale 'c y s)))
            (fact 'rr-subset-cc s) (mvh-and! (list 'IN s 'CC) (list 'IN dy 'CC)) (fact 'cc-mul-closed s dy) (mvh-and! '(IN c CC) (list 'IN (list '* s dy) 'CC)) (fact 'cc-add-closed 'c (list '* s dy))
            (dk-have! (list '= (list '- 1 s) t) (lambda () (crs)))
            (fact 'rr-mul-in-rr s my) (fact 'rr-mul-in-rr t my) (fact 'rr-mul-in-rr s 'r) (fact 'rr-mul-in-rr t 'r)
            (mvh-and! (list '<= my 'r) (list '<= 0 s)) (dk-cite! 'rr-mul-le-right my 'r s)
            (mvh-and! (list '<= my 'r) (list '<= 0 t)) (dk-cite! 'rr-mul-le-right my 'r t)
            (dk-have! (list '= (list '* s my) (list '* my s)) (lambda () (crs)))
            (dk-have! (list '= (list '* 'r s) (list '- 'r (list '* t 'r))) (lambda () (crs)))
            (dk-have! (list '= (list '* (list '- 1 s) my) (list '* my t)) (lambda () (crs)))
            (dk-have! (list '= (list '* 'r t) (list '* t 'r)) (lambda () (crs)))
            (fact 'rr-mul-pos t 'r)
            (fact 'rr-mul-in-rr my s) (fact 'rr-mul-in-rr 'r s) (fact 'rr-mul-in-rr my t) (fact 'rr-mul-in-rr 'r t)
            (fact 'cc-sub-in-cc z 'c) (fact 'cc-magnitude-closed (list '- z 'c))
            (fact 'cc-sub-in-cc z y) (fact 'cc-magnitude-closed (list '- z y))
            (fact 'cc-sub-in-cc y z) (fact 'cc-magnitude-closed (list '- y z))
            (fact 'cc-magnitude-sub-sym z y)
            (let ((iff (dk-cite! 'cc-ms-ball-membership 'c 'r z))
                  (cj (list 'AND (list 'IN z 'CC) (list '< (list 'magnitude (list '- z 'c)) 'r))))
              (dk-have! cj
                (lambda ()
                  (dk-conj-close!
                   (lambda ()
                     (if (dk-asm? (dk-goal)) (ass)
                         (dk-ineq! (list 'IN (list 'magnitude (list '- z 'c)) 'RR) (list 'IN (list '* s my) 'RR) (list 'IN (list '* my s) 'RR)
                                   (list 'IN (list '* 'r s) 'RR) (list 'IN (list '* t 'r) 'RR) '(IN r RR)
                                   (list '= (list 'magnitude (list '- z 'c)) (list '* s my))
                                   (list '= (list '* s my) (list '* my s))
                                   (list '<= (list '* my s) (list '* 'r s))
                                   (list '= (list '* 'r s) (list '- 'r (list '* t 'r)))
                                   (list '< 0 (list '* t 'r))))))))
              (dk-have! (list 'IN z mvh-B) (lambda () (dk-only! iff cj) (prop))))
            (fact 'subset-mem-fwd mvh-B (list 'CLOSURE 'CC-MS mvh-B) z)
            (ew z)
            (dk-conj-close!
             (lambda ()
               (if (dk-asm? (dk-goal))
                   (ass)
                   (let ((e1 (list 'magnitude (list '- z y))))
                     (fact 'rr-sub-in-rr 1 s) (fact 'rr-mul-in-rr (list '- 1 s) my)
                     (dk-ineq! (list 'IN e1 'RR) (list 'IN (list 'magnitude (list '- y z)) 'RR) (list 'IN (list '* my t) 'RR) (list 'IN (list '* (list '- 1 s) my) 'RR)
                               (list 'IN (list '* 'r t) 'RR) (list 'IN (list '* t 'r) 'RR) (list 'IN rho 'RR)
                               (list '= e1 (list 'magnitude (list '- y z)))
                               (list '= (list 'magnitude (list '- y z)) (list '* (list '- 1 s) my))
                               (list '= (list '* (list '- 1 s) my) (list '* my t))
                               (list '<= (list '* my t) (list '* 'r t))
                               (list '= (list '* 'r t) (list '* t 'r))
                               (list '< (list '* t 'r) rho)))))))))
      (dk-apply! mvh-cl y)
      (ass))))
(ass)
(qed 'closed-ball-in-closure-ball)

;;; (3) a closed disc inside an open set lies in a larger open disc inside it
(sp (make-wff "forall([u, c in cc, r in rr], is-open(cc-ms, u) implies 0 < r implies
   closure(cc-ms, ball(cc-ms, c, r)) subset u implies forsome([mvR_ in rr], r < mvR_ and ball(cc-ms, c, mvR_) subset u))"))
(dk-peel!)
(mvh-pts!)
(define mvh-CB '(CLOSED-BALL CC-MS c r))
(dk-cite! 'closed-ball-in-closure-ball 'c 'r)
(dk-cite! 'subset-trans mvh-CB '(CLOSURE CC-MS (BALL CC-MS c r)) 'u)
(dk-cite! 'cc-closed-ball-compact 'c 'r)
(define mvh-e (dk-skolem! (dk-cite! 'compact-open-margin mvh-CB 'u)))
(define mvh-mc (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f mvh-e))) "the margin"))
(fact 'rr-pos-rr-in-rr mvh-e) (fact 'rr-lt-of-pos-rr mvh-e)
(let* ((e mvh-e) (Rb (list '+ 'r e)))
  (fact 'rr-add-in-rr 'r e)
  (dk-have! (list '< 0 Rb) (lambda () (dk-ineq! '(IN r RR) (list 'IN e 'RR) '(< 0 r) (list '< 0 e))))
  (fact 'rr-pos-ne-zero Rb)
  (mvh-and! (list 'IN Rb 'RR) (list 'NOT (list '= Rb 0)))
  (fact 'rr-recip-closed Rb) (fact 'rr-recip-pos Rb) (fact 'rr-recip-inverse Rb)
  (let* ((q (dk-name! (list 'recip Rb) 'RR)))
    (dk-have! (list '= (list '* Rb q) 1) (lambda () (subst (list '= q (list 'recip Rb))) (ass)))
    (dk-have! (list '< 0 q) (lambda () (subst (list '= q (list 'recip Rb))) (ass)))
    (fact 'rr-mul-in-rr 'r q) (fact 'rr-mul-pos 'r q)
    (let* ((s (dk-name! (list '* 'r q) 'RR)))
      (dk-have! (list '< 0 s) (lambda () (subst (list '= s (list '* 'r q))) (ass)))
      (dk-have! (list '= (list '* Rb s) 'r)
        (lambda () (subst (list '= s (list '* 'r q)))
                   (dk-have! (list '= (list '* Rb (list '* 'r q)) (list '* 'r (list '* Rb q))) (lambda () (crs)))
                   (subst (list '= (list '* Rb (list '* 'r q)) (list '* 'r (list '* Rb q))))
                   (subst (list '= (list '* Rb q) 1)) (crs)))
      (dk-have! (list '= (list '* (list '- 1 s) Rb) e)
        (lambda () (dk-have! (list '= (list '* (list '- 1 s) Rb) (list '- Rb (list '* Rb s))) (lambda () (crs)))
                   (subst (list '= (list '* (list '- 1 s) Rb) (list '- Rb (list '* Rb s))))
                   (subst (list '= (list '* Rb s) 'r)) (crs)))
      (fact 'rr-one-in) (fact 'rr-sub-in-rr 1 s) (fact 'rr-mul-in-rr (list '- 1 s) Rb) (fact 'rr-mul-in-rr Rb s)
      (fact 'rr-mul-in-rr e q) (fact 'rr-mul-pos e q)
      (dk-have! (list '= (list '- 1 s) (list '* e q))
        (lambda ()
          (subst (list '= s (list '* 'r q)))
          (dk-have! (list '= (list '- 1 (list '* 'r q)) (list '+ (list '* e q) (list '- 1 (list '* Rb q)))) (lambda () (crs)))
          (subst (list '= (list '- 1 (list '* 'r q)) (list '+ (list '* e q) (list '- 1 (list '* Rb q)))))
          (subst (list '= (list '* Rb q) 1))
          (crs)))
      (dk-have! (list '< 0 (list '- 1 s))
        (lambda () (dk-ineq! (list 'IN s 'RR) (list 'IN (list '* e q) 'RR) (list '= (list '- 1 s) (list '* e q)) (list '< 0 (list '* e q)))))
      (ew Rb)
      (dk-conj-close!
       (lambda ()
         (let ((g (dk-goal)))
           (cond
            ((dk-head-is? g '<) (dk-ineq! '(IN r RR) (list 'IN e 'RR) (list '< 0 e)))
            ((dk-head-is? g 'SUBSET)
             (let* ((y (subset-by-element!))
                    (_0 (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'cc-ms-ball-membership 'c Rb y)))))
                    (dy (list '- y 'c)) (my (list 'magnitude dy))
                    (z (list '+ 'c (list '* s dy))))
               (fact 'cc-sub-in-cc y 'c) (fact 'cc-magnitude-closed dy) (fact 'cc-magnitude-nonneg dy)
               (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list 'IN s 'RR) (list '< 0 s))))
               (dk-have! (list '<= s 1) (lambda () (dk-ineq! (list 'IN s 'RR) (list '< 0 (list '- 1 s)))))
               (dk-split-all! (list (dk-cite! 'cc-radial-scale 'c y s)))
               (fact 'rr-subset-cc s) (mvh-and! (list 'IN s 'CC) (list 'IN dy 'CC)) (fact 'cc-mul-closed s dy) (mvh-and! '(IN c CC) (list 'IN (list '* s dy) 'CC)) (fact 'cc-add-closed 'c (list '* s dy))
               (fact 'cc-sub-in-cc z 'c) (fact 'cc-sub-in-cc 'c z) (fact 'cc-sub-in-cc y z)
               (fact 'cc-magnitude-closed (list '- z 'c)) (fact 'cc-magnitude-closed (list '- y z)) (fact 'cc-magnitude-closed (list '- 'c z))
               (fact 'cc-magnitude-sub-sym 'c z)
               (fact 'rr-mul-in-rr s my) (fact 'rr-mul-in-rr my s) (fact 'rr-mul-in-rr Rb s)
               (fact 'rr-mul-in-rr (list '- 1 s) my) (fact 'rr-mul-in-rr (list '- 1 s) Rb)
               (dk-have! (list '<= my Rb) (lambda () (dk-ineq! (list 'IN my 'RR) (list 'IN Rb 'RR) (list '< my Rb))))
               (mvh-and! (list '<= my Rb) (list '<= 0 s)) (dk-cite! 'rr-mul-le-right my Rb s)
               (dk-have! (list '= (list '* s my) (list '* my s)) (lambda () (crs)))
               (dk-have! (list '= (list '* Rb s) (list '* Rb s)) (lambda () (rfl)))
               ;; z in the closed disc
               (dk-cite! 'cc-ms-dist 'c z)
               (mvh-pts!)
               (dk-have! (list 'IN z '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
               (let ((iffc (dk-cite! 'closed-ball-membership 'CC-MS 'c 'r z))
                     (cj (list 'AND (list 'IN z '(PTS CC-MS)) (list '<= (list '(DIST CC-MS) 'c z) 'r))))
                 (dk-have! cj
                   (lambda ()
                     (dk-conj-close!
                      (lambda ()
                        (if (dk-asm? (dk-goal)) (ass)
                            (begin
                              (subst (list '== (list '(DIST CC-MS) 'c z) (list 'magnitude (list '- 'c z))))
                              (dk-ineq! (list 'IN (list 'magnitude (list '- 'c z)) 'RR) (list 'IN (list '* s my) 'RR) (list 'IN (list '* my s) 'RR)
                                        (list 'IN (list '* Rb s) 'RR) '(IN r RR)
                                        (list '= (list 'magnitude (list '- 'c z)) (list 'magnitude (list '- z 'c)))
                                        (list '= (list 'magnitude (list '- z 'c)) (list '* s my))
                                        (list '= (list '* s my) (list '* my s))
                                        (list '<= (list '* my s) (list '* Rb s))
                                        (list '= (list '* Rb s) 'r))))))))
                 (dk-have! (list 'IN z mvh-CB) (lambda () (dk-only! iffc cj) (prop))))
               ;; y in B(z, e)
               (let* ((d2 (list '- Rb my)))
                 (fact 'rr-sub-in-rr Rb my)
                 (dk-have! (list '< 0 d2) (lambda () (dk-ineq! (list 'IN my 'RR) (list 'IN Rb 'RR) (list '< my Rb))))
                 (fact 'rr-mul-pos (list '- 1 s) d2) (fact 'rr-mul-in-rr (list '- 1 s) d2)
                 (dk-have! (list '= (list '* (list '- 1 s) my) (list '- (list '* (list '- 1 s) Rb) (list '* (list '- 1 s) d2))) (lambda () (crs)))
                 (let ((iffb (dk-cite! 'cc-ms-ball-membership z e y))
                       (cj (list 'AND (list 'IN y 'CC) (list '< (list 'magnitude (list '- y z)) e))))
                   (dk-have! cj
                     (lambda ()
                       (dk-conj-close!
                        (lambda ()
                          (if (dk-asm? (dk-goal)) (ass)
                              (dk-ineq! (list 'IN (list 'magnitude (list '- y z)) 'RR) (list 'IN (list '* (list '- 1 s) my) 'RR)
                                        (list 'IN (list '* (list '- 1 s) Rb) 'RR) (list 'IN (list '* (list '- 1 s) d2) 'RR) (list 'IN e 'RR)
                                        (list '= (list 'magnitude (list '- y z)) (list '* (list '- 1 s) my))
                                        (list '= (list '* (list '- 1 s) my) (list '- (list '* (list '- 1 s) Rb) (list '* (list '- 1 s) d2)))
                                        (list '= (list '* (list '- 1 s) Rb) e)
                                        (list '< 0 (list '* (list '- 1 s) d2))))))))
                   (dk-have! (list 'IN y (list 'BALL 'CC-MS z e)) (lambda () (dk-only! iffb cj) (prop)))))
               (dk-apply! mvh-mc z)
               (fact 'subset-mem-fwd (list 'BALL 'CC-MS z e) 'u y)
               (ass)))
            (#t (ass)))))))))
(qed 'closed-disc-margin)

;;; (4) holomorphic functions have the mean value property (complex-analysis 3.8, equation (92))
(sp (make-wff "forall([u, f], holomorphic-on(u, f) implies has-mean-value-property(u, f))"))
(dk-peel!)
(fact 'holomorphic-on-open 'u 'f)
(fact 'holomorphic-on-in-fun 'u 'f)
(fact 'holomorphic-on-continuous 'u 'f)
(dk-split-all! (list (dk-cite! 'cc-ms-open-iff 'u)))
(dk-have! '(IS-OPEN CC-MS u) (lambda () (prop)))
(mac 'HAS-MEAN-VALUE-PROPERTY)
(dk-conj-close!
 (lambda ()
   (if (not (and (dk-head-is? (dk-goal) 'FORALL) (dk-contains? (dk-goal) 'CC-INT)))
       (ass)
       (begin
         (dk-peel!)
         (let* ((g (dk-goal))
                (c (cadr (cadr g)))
                (r (cadr (caddr (cadr (cadddr (cadr (caddr (caddr g))))))))
                (Rb (dk-skolem! (dk-cite! 'closed-disc-margin 'u c r))))
           (dk-split-all!)
           (let ((hm (dk-cite! 'holomorphic-mean-value 'u 'f c r Rb)))
             (ass)))))))
(qed 'holomorphic-has-mean-value-property)

;;; (5) complex-analysis 3.55 for holomorphic f: a corollary of mvp-maximum-modulus
(sp (make-wff "forall([u, f], holomorphic-on(u, f) implies is-connected(cc-ms, u) implies
   forall([a in u], forall([z in u], magnitude(f(z)) <= magnitude(f(a))) implies forall([z in u], f(z) = f(a))))"))
(dk-peel!)
(dk-cite! 'holomorphic-has-mean-value-property 'u 'f)
(let* ((a (cadr (caddr (dk-goal))))
       (z (cadr (cadr (dk-goal)))))
  (dk-apply! (dk-cite! 'mvp-maximum-modulus 'u 'f) a z)
  (ass))
(qed 'holomorphic-maximum-modulus)
