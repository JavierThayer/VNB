;;; frechet-banach-steinhaus.scm -- Thayer, "Analise Funcional e Teoria Espectral",
;;; Ch. 8 s.4, pp. 256-257: Thm 8.29 (closed graph bis) and Thm 8.32 (Banach-Steinhaus
;;; bis, exercise 8.10).  Batch TVS-2B, 2026-10-11/12.  Vocabulary (Def. 8.31, the
;;; equicontinuity of 8.32): structure-library/frechet-banach-steinhaus.scm.
;;;
;;; THE THEOREMS.
;;;   closed-graph-theorem       Thm 8.29, the support of structure-library/
;;;                              frechet-open-mapping.scm, statement copied literally.
;;;                              Proven FROM THE OPEN MAPPING THEOREM, as the book says
;;;                              ("identical to the Banach case"): it cites the asserted
;;;                              `open-mapping-bounded-inverse' and bills it until TVS-2A
;;;                              proves that support.
;;;   frechet-banach-steinhaus   Thm 8.32: E Frechet, F with a countable separating
;;;                              seminorm family, T_i continuous linear, every orbit
;;;                              {T_i x : i in ix} bounded (Def. 8.31)  =>  {T_i} is
;;;                              equicontinuous (IS-FR-EQUICONT).  modulo 0.
;;;
;;; THE CLOSED GRAPH ROUTE.  The book's proof forms the graph G(T) as a closed subspace
;;; of E x F, hence a Frechet space, and inverts the projection G(T) -> E.  The tree has
;;; no product module, so the graph is carried on E itself by the GRAPH SEMINORMS
;;; gg_k(x) = p_k(x) + q_k(T x) (fbs-graph-*): (VEC m1, gg) is a copy of G(T) with the
;;; topology of E x F, it is Frechet exactly because T is closed (fbs-graph-frechet),
;;; the projection onto E is the identity (VEC m1, gg) -> (VEC m1, fam1), continuous
;;; because p_k <= gg_k, and its inverse is continuous by the bounded-inverse form of
;;; the open mapping theorem; then q_k(T x) <= gg_k(x) gives T continuous.
;;;
;;; THE BANACH-STEINHAUS ROUTE (Thm 1.72's).  For each seminorm q = fam2(k) of F:
;;;   fbs-baire-ball     the sets E_n = {x : q(T_i x) <= n for all i} cover E (orbits
;;;                      bounded, `nn-unbounded-in-rr'); E is a complete nonempty metric
;;;                      space (FR-METRIC-SPACE, `frm-frechet-iff-complete'), so by
;;;                      `baire-category' some E_n is not nowhere dense: a ball
;;;                      B(x0, rad) lies in CLOSURE(E_n).
;;;   fbs-closure-bound  q(T_i z) <= n on CLOSURE(E_n) -- the book's "E_k is closed" --
;;;                      from the continuity of z |-> q(T_i z) (fbs-q-cont, through
;;;                      `continuous-at-iff-sequential' as frm-cont-lin-nbhd does it).
;;;   fbs-uniform-ball   a prefix ball {p_j(w) < dl, j <= nb} is carried into
;;;                      B(x0, rad) - x0 (`frm-seminorm-ball'), so
;;;                      q(T_i w) <= q(T_i(x0 + w)) + q(T_i x0) <= n + M(x0), uniformly
;;;                      in i -- "the form of the neighbourhoods of 0 in E".
;;;   fbs-ball-bound     rescaling by powers of a scalar |c| > 1 (`frm-nf-bracket'):
;;;                      the ball bound gives q(T x) <= (|c| mm / dl) r whenever
;;;                      p_j(x) <= r for j <= nb, with a constant independent of T.
;;; The book rescales by the real delta^-1; over a normed field the hypothesis
;;; IS-NONTRIVIALLY-VALUED (as for Prop. 8.26, frm-bound-of-cont-lin) supplies c.
;;;
;;; EQUICONTINUITY is stated in the book's seminorm form with the finitely many p_j an
;;; INITIAL SEGMENT fam1(0..nb) of the enumerated family: any finite set of indices lies
;;; in an initial segment and the maximum over a larger set is larger, so nothing is
;;; lost; the maximum is written through its upper bounds r, as in frm-bound-826.
;;;
;;; LOAD WINDOW: [after theorem-library/frechet-metric, end).  The latest citations are
;;; the frm- theorems (frechet-metric, load.scm 3477); the others load earlier
;;; (hahn-banach-sublinear 2933: hbs-vadd-assoc / -comm / hbs-vzero-r; rake-dual-norm-spec
;;; 2873; rake-hb-leaves 2869; sequential-continuity 2566; rr-null-scale 2511; rake-baire-2
;;; 1693: baire-category; metric-closure-laws 1630; and the basics).  Supports cited:
;;; `open-mapping-bounded-inverse' (structure-library/frechet-open-mapping) -- when TVS-2A
;;; proves it, this file must load after A's file.  No late tactic (contra, prep, ...).
;;; The vocabulary file loads after structure-library/frechet-open-mapping (it uses
;;; nothing else).  Library: analysis, both files.
;;;
;;; Helper prefix: fbs-.  Binders of built terms: gk_ gv_ (the graph family), iv_ (the
;;; identity), bx_ bi_ (the sets E_n).

;;; ---- the fbs- kit ------------------------------------------------------

(define (fbs-sub m a b) (list (list 'VADD m) a (list (list 'VNEG m) b)))
(define (fbs-add m a b) (list (list 'VADD m) a b))
(define (fbs-neg m a) (list (list 'VNEG m) a))
(define (fbs-once! f thunk) (if (not (dk-asm? f)) (thunk)))
(define (fbs-seq-map f l)                ; left to right, by construction
  (let loop ((l l) (acc '()))
    (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (fbs-pick-forall-with sym what)
  (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f sym))) what))
(define (fbs-landed-last thunk)
  (let ((new (dk-landed thunk)))
    (if (null? new) (error "fbs-landed-last: nothing landed"))
    (car (last-pair new))))

;;; the domain A of an (IN f (FUN A cod)) in context, or #f
(define (fbs-fun-dom f cod)
  (let ((hit (find-first (lambda (a) (and (pair? a) (eq? (car a) 'IN) (equal? (cadr a) f)
                                           (pair? (caddr a)) (eq? (car (caddr a)) 'FUN)
                                           (equal? (caddr (caddr a)) cod)))
                         (dk-asms))))
    (and hit (cadr (caddr hit)))))
;;; the (A . B) of some (IN f (FUN A B)) in context whose B is a FUN, or #f
(define (fbs-fun-sig f)
  (let ((hit (find-first (lambda (a) (and (pair? a) (eq? (car a) 'IN) (equal? (cadr a) f)
                                           (pair? (caddr a)) (eq? (car (caddr a)) 'FUN)))
                         (dk-asms))))
    (and hit (cons (cadr (caddr hit)) (caddr (caddr hit))))))

;;; (IN t cls) for a term built from typed atoms by VADD / VNEG / VZERO / ACT and by
;;; application of functions typed in context (curried applications too).
(define (fbs-ty! t cls)
  (let ((ty (list 'IN t cls)))
    (if (not (dk-asm? ty))
        (cond
         ((and (pair? t) (pair? (car t)) (eq? (car (car t)) 'VADD) (equal? cls (list 'VEC (cadr (car t)))))
          (fbs-ty! (cadr t) cls) (fbs-ty! (caddr t) cls)
          (dk-cite! 'module-vadd-type (cadr (car t)) (cadr t) (caddr t)))
         ((and (pair? t) (pair? (car t)) (eq? (car (car t)) 'VNEG) (equal? cls (list 'VEC (cadr (car t)))))
          (fbs-ty! (cadr t) cls)
          (dk-cite! 'module-vneg-type (cadr (car t)) (cadr t)))
         ((and (pair? t) (eq? (car t) 'VZERO)) (dk-cite! 'module-vzero-in (cadr t)))
         ((and (pair? t) (pair? (car t)) (eq? (car (car t)) 'ACT) (equal? cls (list 'VEC (cadr (car t)))))
          (fbs-ty! (caddr t) cls)
          (dk-cite! 'module-act-type (cadr (car t)) (cadr t) (caddr t)))
         ((and (pair? t) (= (length t) 2))
          (let* ((f (car t)) (x (cadr t))
                 (dom (or (fbs-fun-dom f cls)
                          (and (pair? f) (= (length f) 2)
                               (let ((sig (fbs-fun-sig (car f))))
                                 (and sig (eq? (car (cdr sig)) 'FUN) (equal? (caddr (cdr sig)) cls)
                                      (begin (fbs-ty! f (cdr sig)) (cadr (cdr sig))))))
                          (error "fbs-ty!: no function typing for" (expression->string f)))))
            (fbs-ty! x dom)
            (dk-cite! 'fun-apply-type-c f dom cls x)))
         (#t (error "fbs-ty!: cannot type" (expression->string t) (expression->string cls)))))
    (if (not (dk-asm? ty)) (error "fbs-ty!: typing did not land" (expression->string ty)))
    ty))
(define (fbs-real! t) (fbs-ty! t 'RR))

;;; =====================================================================
;;; (1) DOMINATION: convergence and Cauchy sequences pass from a family g to a
;;;     family h dominated by it along the sequences.
;;; =====================================================================

;;; FR-CONV(m1, gf, ss, aa) and hf_k(ts(i) - bb) <= gf_k(ss(i) - aa)  =>  FR-CONV(m2, hf, ts, bb)
(sp (make-wff
 (forall-guarded '(m1 m2 gf hf ss ts aa bb)
   '((IS-MODULE m1) (IS-MODULE m2)
     (IN gf (FUN NN (FUN (VEC m1) RR))) (IN hf (FUN NN (FUN (VEC m2) RR)))
     (IN ss (FUN NN (VEC m1))) (IN ts (FUN NN (VEC m2))) (IN aa (VEC m1)) (IN bb (VEC m2)))
   (list 'IMPLIES
         (forall-guarded '(k i) '((IN k NN) (IN i NN))
           (list '<= (list '(hf k) (fbs-sub 'm2 '(ts i) 'bb)) (list '(gf k) (fbs-sub 'm1 '(ss i) 'aa))))
         '(IMPLIES (FR-CONV m1 gf ss aa) (FR-CONV m2 hf ts bb))))))
(let* ((landed (dk-peel!))
       (dom (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'hf))) landed))
       (fc (find-first (dk-head? 'FR-CONV) landed)))
  (mac 'fr-conv)
  (let* ((l2 (dk-peel!))
         (k (cadr (find-first (dk-head? 'IN) l2)))
         (eps (cadr (find-first (dk-head? 'POS-RR) l2)))
         (_ (dk-cite! 'rr-pos-rr-in-rr eps))
         (u (fbs-landed-last (lambda () (mac-h 'fr-conv fc))))
         (cap (dk-skolem! (dk-apply! u k eps)))
         (cu (fbs-pick-forall-with cap "the threshold universal")))
    (ew cap)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IN)
            (ass)
            (let* ((ls (dk-peel!))
                   (gd (find-first (dk-head? 'AND) ls))
                   (i (cadr (cadr gd)))
                   (c (dk-apply! cu i)))
              (dk-split-all! (list gd))
              (let ((d (dk-apply! dom k i)))
                (fbs-real! (cadr d)) (fbs-real! (caddr d))
                (dk-ineq! d c))))))))
(qed 'fbs-conv-dom)

;;; FR-CAUCHY(m1, gf, ss) and hf_k(ts(i) - ts(j)) <= gf_k(ss(i) - ss(j))  =>  FR-CAUCHY(m2, hf, ts)
(sp (make-wff
 (forall-guarded '(m1 m2 gf hf ss ts)
   '((IS-MODULE m1) (IS-MODULE m2)
     (IN gf (FUN NN (FUN (VEC m1) RR))) (IN hf (FUN NN (FUN (VEC m2) RR)))
     (IN ss (FUN NN (VEC m1))) (IN ts (FUN NN (VEC m2))))
   (list 'IMPLIES
         (forall-guarded '(k i j) '((IN k NN) (IN i NN) (IN j NN))
           (list '<= (list '(hf k) (fbs-sub 'm2 '(ts i) '(ts j))) (list '(gf k) (fbs-sub 'm1 '(ss i) '(ss j)))))
         '(IMPLIES (FR-CAUCHY m1 gf ss) (FR-CAUCHY m2 hf ts))))))
(let* ((landed (dk-peel!))
       (dom (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'hf))) landed))
       (fc (find-first (dk-head? 'FR-CAUCHY) landed)))
  (mac 'fr-cauchy)
  (let* ((l2 (dk-peel!))
         (k (cadr (find-first (dk-head? 'IN) l2)))
         (eps (cadr (find-first (dk-head? 'POS-RR) l2)))
         (_ (dk-cite! 'rr-pos-rr-in-rr eps))
         (u (fbs-landed-last (lambda () (mac-h 'fr-cauchy fc))))
         (cap (dk-skolem! (dk-apply! u k eps)))
         (cu (fbs-pick-forall-with cap "the threshold universal")))
    (ew cap)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IN)
            (ass)
            (let* ((ls (dk-peel!))
                   (gds (filter (dk-head? 'AND) ls))
                   (vv (cadr (cadr (dk-goal))))
                   (i (cadr (cadr vv))) (j (cadr (cadr (caddr vv))))
                   (c (dk-apply! cu i j)))
              (dk-split-all! gds)
              (let ((d (dk-apply! dom k i j)))
                (fbs-real! (cadr d)) (fbs-real! (caddr d))
                (dk-ineq! d c))))))))
(qed 'fbs-cauchy-dom)

;;; FR-CONV(m1, hf, ss, aa), FR-CONV(m2, kf, ts, bb) and
;;; gf_k(ss(i) - aa) <= hf_k(ss(i) - aa) + kf_k(ts(i) - bb)  =>  FR-CONV(m1, gf, ss, aa)
(sp (make-wff
 (forall-guarded '(m1 m2 gf hf kf ss ts aa bb)
   '((IS-MODULE m1) (IS-MODULE m2)
     (IN gf (FUN NN (FUN (VEC m1) RR))) (IN hf (FUN NN (FUN (VEC m1) RR))) (IN kf (FUN NN (FUN (VEC m2) RR)))
     (IN ss (FUN NN (VEC m1))) (IN ts (FUN NN (VEC m2))) (IN aa (VEC m1)) (IN bb (VEC m2)))
   (list 'IMPLIES
         (forall-guarded '(k i) '((IN k NN) (IN i NN))
           (list '<= (list '(gf k) (fbs-sub 'm1 '(ss i) 'aa))
                     (list '+ (list '(hf k) (fbs-sub 'm1 '(ss i) 'aa)) (list '(kf k) (fbs-sub 'm2 '(ts i) 'bb)))))
         '(IMPLIES (FR-CONV m1 hf ss aa) (IMPLIES (FR-CONV m2 kf ts bb) (FR-CONV m1 gf ss aa)))))))
(let* ((landed (dk-peel!))
       (dom (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'kf))) landed))
       (fc1 (find-first (lambda (f) (and (dk-head-is? f 'FR-CONV) (dk-contains? f 'hf))) landed))
       (fc2 (find-first (lambda (f) (and (dk-head-is? f 'FR-CONV) (dk-contains? f 'kf))) landed)))
  (mac 'fr-conv)
  (let* ((l2 (dk-peel!))
         (k (cadr (find-first (dk-head? 'IN) l2)))
         (eps (cadr (find-first (dk-head? 'POS-RR) l2)))
         (_ (dk-cite! 'rr-pos-rr-in-rr eps))
         (e2 (dk-halve! eps))
         (u1 (fbs-landed-last (lambda () (mac-h 'fr-conv fc1))))
         (c1 (dk-skolem! (dk-apply! u1 k e2)))
         (cu1 (fbs-pick-forall-with c1 "the first threshold universal"))
         (u2 (fbs-landed-last (lambda () (mac-h 'fr-conv fc2))))
         (c2 (dk-skolem! (dk-apply! u2 k e2)))
         (cu2 (fbs-pick-forall-with c2 "the second threshold universal"))
         (cap (list '+ c1 c2)))
    (dk-have! (list 'AND (list 'IN c1 'NN) (list 'IN c2 'NN)) (lambda () (dk-conj-close! ass)))
    (dk-cite! 'nn-add-closed c1 c2)
    (ew cap)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IN)
            (ass)
            (let* ((ls (dk-peel!))
                   (gd (find-first (dk-head? 'AND) ls))
                   (i (cadr (cadr gd)))
                   (cap-le (caddr gd)))
              (dk-split-all! (list gd))
              (dk-have! (list 'AND (list 'IN i 'NN) (list '<= c1 i))
                (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-nn! cap-le))))))
              (dk-have! (list 'AND (list 'IN i 'NN) (list '<= c2 i))
                (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-nn! cap-le))))))
              (let* ((d1 (dk-apply! cu1 i))
                     (d2 (dk-apply! cu2 i))
                     (d (dk-apply! dom k i)))
                (fbs-real! (cadr d)) (fbs-real! (cadr (caddr d))) (fbs-real! (caddr (caddr d)))
                (dk-ineq! d d1 d2 (list '= (list '+ e2 e2) eps)))))))))
(qed 'fbs-conv-sum)

;;; =====================================================================
;;; (2) THE GRAPH FAMILY.  For a linear tt : (m1, fam1) -> (m2, fam2) the family
;;;     gg_k(x) = fam1_k(x) + fam2_k(tt x) on VEC m1 -- the k-th GRAPH SEMINORM, the
;;;     seminorm of the graph {(x, tt x)} read back on the domain -- is a separating
;;;     seminorm family, and when tt has a closed graph between Frechet spaces it is
;;;     a Frechet family.  This is the device that replaces the product space E x F
;;;     of the book's proof (the graph as a Frechet space): the projection of the
;;;     graph onto E is the identity (VEC m1, gg) -> (VEC m1, fam1).
;;; =====================================================================

(define fbs-gval
  '(FORALL k (IMPLIES (IN k NN) (FORALL x (IMPLIES (IN x (VEC m1))
      (= ((gg k) x) (+ ((fam1 k) x) ((fam2 k) (tt x)))))))))

(sp (make-wff (forall-guarded '(fld m1 fam1 m2 fam2 tt)
   '((IS-SEMINORM-FAMILY fld m1 fam1) (IS-SEMINORM-FAMILY fld m2 fam2) (IN tt (FUN (VEC m1) (VEC m2))))
   (list 'FORSOME 'gg (list 'AND '(IN gg (FUN NN (FUN (VEC m1) RR))) fbs-gval)))))
(dk-peel!)
(dk-cite! 'frm-fam-type 'fld 'm1 'fam1)
(dk-cite! 'frm-fam-type 'fld 'm2 'fam2)
(dk-cite! 'frm-fam-module 'fld 'm1 'fam1)
(dk-cite! 'frm-module-vec-set 'm1)
(dk-cite! 'nn-is-set)
(define (fbs-gbody k x) (list '+ (list (list 'fam1 k) x) (list (list 'fam2 k) (list 'tt x))))
(define (fbs-gbody-real! k x)
  (fbs-real! (list (list 'fam1 k) x))
  (fbs-real! (list (list 'fam2 k) (list 'tt x)))
  (dk-real! (fbs-gbody k x)))
(ew '(VNB-LAMBDA gk_ NN (VNB-LAMBDA gv_ (VEC m1) (+ ((fam1 gk_) gv_) ((fam2 gk_) (tt gv_))))))
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IN)
        (dk-lam-type!
          (lambda ()
            (let ((k (dk-di-var!)))
              (dk-lam-type!
                (lambda ()
                  (let ((x (dk-di-var!)))
                    (fbs-gbody-real! k x)))))))
        (let* ((ls (dk-peel!))
               (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) ls)))
               (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC m1)))) ls))))
          (fbs-gbody-real! k x)
          (if (not (dk-lam-b!)) (rfl))))))
(qed 'fbs-graph-fam-exists)

(define (fbs-gstmt body)
  (forall-guarded '(fld m1 fam1 m2 fam2 tt gg)
     (list '(IS-SEMINORM-FAMILY fld m1 fam1) '(IS-SEMINORM-FAMILY fld m2 fam2) '(IS-LINEAR-MAP m1 m2 tt)
           '(IN gg (FUN NN (FUN (VEC m1) RR))) fbs-gval)
     body))
(define fbs-gname 'gg)                  ; the graph family's symbol in the running proof
(define (fbs-pick-gval)
  (or (dk-ctx-form (subst-free 'gg fbs-gname fbs-gval))
      (error "fbs-pick-gval: the graph value equation is not in context" fbs-gname)))
;;; the common context of the graph lemmas
(define (fbs-graph-context!)
  (dk-cite! 'frm-fam-field 'fld 'm1 'fam1)
  (dk-cite! 'frm-fam-module 'fld 'm1 'fam1)
  (dk-cite! 'frm-fam-module 'fld 'm2 'fam2)
  (dk-cite! 'frm-fam-scal 'fld 'm1 'fam1)
  (dk-cite! 'frm-fam-scal 'fld 'm2 'fam2)
  (dk-cite! 'frm-fam-type 'fld 'm1 'fam1)
  (dk-cite! 'frm-fam-type 'fld 'm2 'fam2)
  (dk-project! '(IN tt (FUN (VEC m1) (VEC m2))) (lambda () (mac-h 'is-linear-map '(IS-LINEAR-MAP m1 m2 tt)))))
(define (fbs-sn! md fm k)               ; (IS-SEMINORM fld md (fm k)), k typed
  (let ((sn (list 'IS-SEMINORM 'fld md (list fm k))))
    (fbs-once! sn (lambda () (dk-apply! (dk-cite! 'frm-fam-seminorm 'fld md fm) k)))
    sn))
(define (fbs-nonneg! md fm k v)         ; (<= 0 ((fm k) v)), v typed in VEC md
  (fbs-sn! md fm k)
  (fbs-ty! v (list 'VEC md))
  (fbs-real! (list (list fm k) v))
  (let ((f (list '<= 0 (list (list fm k) v))))
    (fbs-once! f (lambda () (dk-apply! (dk-cite! 'frm-sn-nonneg 'fld md (list fm k)) v)))
    f))
;;; (= ((gg k) v) BODY) landed, with the summands typed; v typed in VEC m1
(define (fbs-gval-at! ve k v)
  (fbs-ty! v '(VEC m1))
  (fbs-ty! (list 'tt v) '(VEC m2))
  (fbs-gbody-real! k v)
  (fbs-real! (list (list fbs-gname k) v))
  (let ((e (list '= (list (list fbs-gname k) v) (fbs-gbody k v)))
        (vk (dk-ctx-form (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC m1))
                                 (list '= (list (list fbs-gname k) 'x) (fbs-gbody k 'x)))))))
    ;; inst*! will not re-instantiate a universal whose instance at k is already in context
    (fbs-once! e (lambda () (if vk (dk-apply! vk v) (dk-apply! ve k v))))
    e))

;;; each graph seminorm is a seminorm
(sp (make-wff (fbs-gstmt '(FORALL k (IMPLIES (IN k NN) (IS-SEMINORM fld m1 (gg k)))))))
(let* ((ls (dk-peel!))
       (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) ls)))
       (_ (fbs-graph-context!))
       (ve (fbs-pick-gval))
       (addu (dk-project! '(FORALL x (IMPLIES (IN x (VEC m1)) (FORALL y (IMPLIES (IN y (VEC m1))
                              (= (tt ((VADD m1) x y)) ((VADD m2) (tt x) (tt y)))))))
               (lambda () (mac-h 'is-linear-map '(IS-LINEAR-MAP m1 m2 tt)))))
       (p (list 'fam1 k)) (q (list 'fam2 k)) (g (list 'gg k)))
    (fbs-sn! 'm1 'fam1 k)
  (fbs-sn! 'm2 'fam2 k)
  (dk-cite! 'normed-field-ring-view-carr 'fld)
  (fbs-ty! g '(FUN (VEC m1) RR))
  (mac 'is-seminorm)
  (dk-conj-close!
    (lambda ()
      (let ((gl (dk-goal)))
        (cond
         ((dk-asm? gl) (ass))
         ((dk-head-is? gl 'IN) (dk-close-if! (lambda () (fbs-ty! (cadr gl) (caddr gl))) ass))
         ((dk-head-is? gl 'FORALL)
          (let* ((ls2 (dk-peel!)) (gl2 (dk-goal)))
            (cond
             ;; 0 <= g(x)
             ((and (dk-head-is? gl2 '<=) (equal? (cadr gl2) 0))
              (let* ((x (cadr (caddr gl2)))
                     (e (fbs-gval-at! ve k x)))
                (subst e)
                (dk-ineq! (fbs-nonneg! 'm1 'fam1 k x) (fbs-nonneg! 'm2 'fam2 k (list 'tt x)))))
             ;; g(x + y) <= g(x) + g(y)
             ((dk-head-is? gl2 '<=)
              (let* ((v (cadr (cadr gl2))) (x (cadr v)) (y (caddr v))
                     (tx (list 'tt x)) (ty (list 'tt y)))
                (subst (fbs-gval-at! ve k v))
                (subst (fbs-gval-at! ve k x))
                (subst (fbs-gval-at! ve k y))
                (let* ((la (dk-apply! addu x y))
                       (_ (subst la))
                       (_ (fbs-ty! (fbs-add 'm2 tx ty) '(VEC m2)))
                       (s1 (dk-apply! (dk-cite! 'frm-sn-subadd 'fld 'm1 p) x y))
                       (s2 (dk-apply! (dk-cite! 'frm-sn-subadd 'fld 'm2 q) tx ty)))
                  (fbs-real! (list q (fbs-add 'm2 tx ty)))
                  (dk-ineq! s1 s2))))
             ;; g(lam . x) = |lam| g(x)
             (#t
              (let* ((v (cadr (cadr gl2))) (lam (cadr v)) (x (caddr v))
                     (tx (list 'tt x))
                     (l1 (list 'IN lam '(CARR (SCAL m1))))
                     (l2 (dk-rewrite-h! l1 '(SCAL m1) '(NORMED-FIELD-AS-COMMUTATIVE-RING fld)))
                     (l3 (dk-rewrite-h! l2 '(NORMED-FIELD-AS-COMMUTATIVE-RING fld) '(SCAL m2)))
                     (l4 (dk-rewrite-h! l2 '(CARR (NORMED-FIELD-AS-COMMUTATIVE-RING fld)) '(CARR fld)))
                     (nl (list '(FNRM fld) lam)))
                (dk-cite! 'nf-norm-in-rr 'fld lam)
                (subst (fbs-gval-at! ve k v))
                (subst (fbs-gval-at! ve k x))
                (subst (dk-apply! (dk-cite! 'frm-linear-homog 'm1 'm2 'tt) lam x))
                (subst (dk-apply! (dk-cite! 'frm-sn-homog 'fld 'm1 p) lam x))
                (fbs-ty! tx '(VEC m2))
                (subst (dk-apply! (dk-cite! 'frm-sn-homog 'fld 'm2 q) lam tx))
                (crs)))))))))))
(qed 'fbs-graph-seminorm)

;;; the graph family is a separating seminorm family
(sp (make-wff (fbs-gstmt '(IS-SEMINORM-FAMILY fld m1 gg))))
(dk-peel!)
(fbs-graph-context!)
(let* ((ve (fbs-pick-gval))
       (sep (dk-project! '(FORALL x (IMPLIES (IN x (VEC m1)) (IMPLIES (NOT (= x (VZERO m1)))
                             (FORSOME k (AND (IN k NN) (NOT (= ((fam1 k) x) 0)))))))
              (lambda () (mac-h 'is-seminorm-family '(IS-SEMINORM-FAMILY fld m1 fam1))))))
  (mac 'is-seminorm-family)
  (dk-conj-close!
    (lambda ()
      (cond
       ((dk-asm? (dk-goal)) (ass))
       ((dk-contains? (dk-goal) 'IS-SEMINORM)
        (let ((k (cadr (car (dk-peel!)))))
          (dk-cite! 'fbs-graph-seminorm 'fld 'm1 'fam1 'm2 'fam2 'tt 'gg k)
          (ass)))
       (#t
          (let* ((ls (dk-peel!))
                 (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC m1)))) ls)))
                 (kk (dk-skolem! (dk-apply! sep x)))
                 (p (list (list 'fam1 kk) x)))
            (ew kk)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'IN)
                    (ass)
                    (let* ((z (dk-landed-1 (lambda () (di))))
                           (e (fbs-gval-at! ve kk x))
                           (z2 (dk-rewrite-h! z (cadr e) (caddr e)))
                           (n1 (fbs-nonneg! 'm1 'fam1 kk x))
                           (n2 (fbs-nonneg! 'm2 'fam2 kk (list 'tt x))))
                      (dk-cite! 'rr-zero-in)
                      (dk-have! (list '<= p 0) (lambda () (dk-ineq! z2 n2)))
                      (dk-have! (list 'AND (list 'IN p 'RR) '(IN 0 RR)) (lambda () (dk-conj-close! ass)))
                      (dk-have! (list 'AND (list '<= p 0) (list '<= 0 p)) (lambda () (dk-conj-close! ass)))
                      (dk-cite! 'rr-leq-antisymmetric p 0)
                      (ai (list 'NOT (list '= p 0)))))))))))))
(qed 'fbs-graph-family)

;;; the two dominations by the graph seminorm, at k and a vector v of VEC m1
(define (fbs-dom-p! ve k v)              ; goal fam1_k(v) <= gg_k(v)
  (dk-ineq! (fbs-gval-at! ve k v) (fbs-nonneg! 'm2 'fam2 k (list 'tt v))))
(define (fbs-dom-q! ve k v)              ; goal fam2_k(tt v) <= gg_k(v)
  (dk-ineq! (fbs-gval-at! ve k v) (fbs-nonneg! 'm1 'fam1 k v)))
;;; in the goal, tt(a) - tt(b) rewritten to tt(a - b)
(define (fbs-pull-sub! a b)
  (fbs-ty! a '(VEC m1)) (fbs-ty! b '(VEC m1))
  (let ((lsub (dk-cite! 'frm-linear-sub 'm1 'm2 'tt a b)))
    (subst (list '= (caddr lsub) (cadr lsub)))))

;;; (IN (sq v) (VEC m1)) for every index v typed (IN v NN) among LANDED
(define (fbs-type-seq-at! sq landed)
  (for-each (lambda (f) (if (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN)) (fbs-ty! (list sq (cadr f)) '(VEC m1))))
            landed))

(define fbs-cg-univ
  '(FORALL seq (IMPLIES (IN seq (FUN NN (VEC m1))) (FORALL p1 (IMPLIES (IN p1 (VEC m1))
     (FORALL p2 (IMPLIES (IN p2 (VEC m2))
       (IMPLIES (AND (FR-CONV m1 fam1 seq p1) (FR-CONV m2 fam2 (VNB-LAMBDA i NN (tt (seq i))) p2))
                (= p2 (tt p1))))))))))
(define (fbs-complete-univ md fm)
  (list 'FORALL 'seq (list 'IMPLIES (list 'IN 'seq (list 'FUN 'NN (list 'VEC md)))
    (list 'IMPLIES (list 'FR-CAUCHY md fm 'seq)
      (list 'FORSOME 'lim (list 'AND (list 'IN 'lim (list 'VEC md)) (list 'FR-CONV md fm 'seq 'lim)))))))
(define (fbs-in-vec? md) (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'VEC md)))))
(define (fbs-in-seq? md) (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'FUN 'NN (list 'VEC md))))))

;;; with tt closed between Frechet spaces, the graph family is a Frechet family
(sp (make-wff (forall-guarded '(fld m1 fam1 m2 fam2 tt gg)
   (list '(IS-FRECHET-STRUCTURE fld m1 fam1) '(IS-FRECHET-STRUCTURE fld m2 fam2) '(HAS-CLOSED-GRAPH m1 fam1 m2 fam2 tt)
         '(IN gg (FUN NN (FUN (VEC m1) RR))) fbs-gval)
   '(IS-FRECHET-STRUCTURE fld m1 gg))))
(dk-peel!)
(set! fbs-gname 'gg)
(dk-project! '(IS-SEMINORM-FAMILY fld m1 fam1) (lambda () (mac-h 'is-frechet-structure '(IS-FRECHET-STRUCTURE fld m1 fam1))))
(dk-project! '(IS-SEMINORM-FAMILY fld m2 fam2) (lambda () (mac-h 'is-frechet-structure '(IS-FRECHET-STRUCTURE fld m2 fam2))))
(dk-project! '(IS-LINEAR-MAP m1 m2 tt) (lambda () (mac-h 'has-closed-graph '(HAS-CLOSED-GRAPH m1 fam1 m2 fam2 tt))))
(fbs-graph-context!)
(dk-cite! 'nn-is-set)
(dk-cite! 'fbs-graph-family 'fld 'm1 'fam1 'm2 'fam2 'tt 'gg)
(let* ((ve (fbs-pick-gval))
       (cm1 (dk-project! (fbs-complete-univ 'm1 'fam1)
              (lambda () (mac-h 'is-frechet-structure '(IS-FRECHET-STRUCTURE fld m1 fam1)))))
       (cm2 (dk-project! (fbs-complete-univ 'm2 'fam2)
              (lambda () (mac-h 'is-frechet-structure '(IS-FRECHET-STRUCTURE fld m2 fam2)))))
       (cg (dk-project! fbs-cg-univ (lambda () (mac-h 'has-closed-graph '(HAS-CLOSED-GRAPH m1 fam1 m2 fam2 tt))))))
  (mac 'is-frechet-structure)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (let* ((ls (dk-peel!))
                 (sq (cadr (find-first (fbs-in-seq? 'm1) ls)))
                 (ts (list 'VNB-LAMBDA 'i 'NN (list 'tt (list sq 'i)))))
            (dk-have! (list 'IN ts '(FUN NN (VEC m2)))
              (lambda ()
                (dk-lam-type! (lambda () (let ((i (dk-di-var!))) (fbs-ty! (list 'tt (list sq i)) '(VEC m2)) (ass))))))
            ;; Cauchy for fam1
            (let ((r (dk-cite! 'fbs-cauchy-dom 'm1 'm1 'gg 'fam1 sq sq)))
              (dk-have! (cadr r)
                (lambda ()
                  (dk-peel!)
                  (let* ((gl (dk-goal)) (k (cadr (car (cadr gl)))) (v (cadr (cadr gl))))
                    (fbs-dom-p! ve k v))))
              (dk-cite! 'fbs-cauchy-dom 'm1 'm1 'gg 'fam1 sq sq))
            ;; Cauchy for the image sequence in fam2
            (let ((r (dk-cite! 'fbs-cauchy-dom 'm1 'm2 'gg 'fam2 sq ts)))
              (dk-have! (cadr r)
                (lambda ()
                  (dk-peel!)
                  (dk-lam-b!)
                  (let* ((gl (dk-goal)) (k (cadr (car (cadr gl)))) (v (cadr (caddr gl))))
                    (fbs-pull-sub! (cadr v) (cadr (caddr v)))
                    (fbs-dom-q! ve k v))))
              (dk-cite! 'fbs-cauchy-dom 'm1 'm2 'gg 'fam2 sq ts))
            ;; the two limits, and the closed graph
            (let* ((l1 (dk-skolem! (dk-apply! cm1 sq)))
                   (l2 (dk-skolem! (dk-apply! cm2 ts)))
                   (c1 (list 'FR-CONV 'm1 'fam1 sq l1))
                   (c2 (list 'FR-CONV 'm2 'fam2 ts l2)))
              (dk-have! (list 'AND c1 c2) (lambda () (dk-conj-close! ass)))
              (let ((eq (dk-apply! cg sq l1 l2)))
                (ew l1)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-asm? (dk-goal))
                        (ass)
                        (let ((r (dk-cite! 'fbs-conv-sum 'm1 'm2 'gg 'fam1 'fam2 sq ts l1 l2)))
                          (dk-have! (cadr r)
                            (lambda ()
                              (dk-peel!)
                              (dk-lam-b!)
                              (subst eq)
                              (let* ((gl (dk-goal)) (k (cadr (car (cadr gl)))) (v (cadr (cadr gl))))
                                (fbs-pull-sub! (cadr v) l1)
                                (dk-ineq! (fbs-gval-at! ve k v)))))
                          (dk-cite! 'fbs-conv-sum 'm1 'm2 'gg 'fam1 'fam2 sq ts l1 l2)
                          (ass))))))))))))
(qed 'fbs-graph-frechet)

;;; the identity of VEC m1 is linear
(define fbs-id '(VNB-LAMBDA iv_ (VEC m1) iv_))
(sp (make-wff '(FORALL m1 (IMPLIES (IS-MODULE m1) (IS-LINEAR-MAP m1 m1 (VNB-LAMBDA iv_ (VEC m1) iv_))))))
(dk-peel!)
(dk-cite! 'frm-module-vec-set 'm1)
(mac 'is-linear-map)
(dk-conj-close!
  (lambda ()
    (let ((gl (dk-goal)))
      (cond
       ((dk-asm? gl) (ass))
       ((dk-head-is? gl '=) (rfl))
       ((dk-head-is? gl 'IN) (dk-lam-type! (lambda () (dk-di-var!) (ass))))
       (#t (dk-peel!)
           (fbs-ty! (cadr (cadr (dk-goal))) '(VEC m1))
           (if (not (dk-lam-b!)) (rfl)))))))
(qed 'fbs-id-linear)

;;; =====================================================================
;;; (3) THM 8.29, CLOSED GRAPH (bis), from the open mapping theorem as in the
;;;     Banach case: the identity (VEC m1, gg) -> (VEC m1, fam1) -- the projection
;;;     of the graph onto E -- is a continuous linear bijection between Frechet
;;;     spaces, so its inverse is continuous (open-mapping-bounded-inverse), and
;;;     tt = (projection onto F) o (that inverse) is continuous.
;;; =====================================================================

(sp (make-wff
  (forall-guarded '(fld m1 fam1 m2 fam2 tt)
    (list
      '(IS-NONTRIVIALLY-VALUED fld)
      '(IS-FRECHET-STRUCTURE fld m1 fam1)
      '(IS-FRECHET-STRUCTURE fld m2 fam2)
      '(HAS-CLOSED-GRAPH m1 fam1 m2 fam2 tt))
    '(IS-CONT-LIN m1 fam1 m2 fam2 tt))))
(dk-peel!)
(dk-project! '(IS-SEMINORM-FAMILY fld m1 fam1) (lambda () (mac-h 'is-frechet-structure '(IS-FRECHET-STRUCTURE fld m1 fam1))))
(dk-project! '(IS-SEMINORM-FAMILY fld m2 fam2) (lambda () (mac-h 'is-frechet-structure '(IS-FRECHET-STRUCTURE fld m2 fam2))))
(dk-project! '(IS-LINEAR-MAP m1 m2 tt) (lambda () (mac-h 'has-closed-graph '(HAS-CLOSED-GRAPH m1 fam1 m2 fam2 tt))))
(fbs-graph-context!)
(dk-cite! 'nn-is-set)
(dk-cite! 'frm-module-vec-set 'm1)
(let* ((gg (dk-skolem! (dk-cite! 'fbs-graph-fam-exists 'fld 'm1 'fam1 'm2 'fam2 'tt)))
       (_ (set! fbs-gname gg))
       (ve (fbs-pick-gval))
       (id fbs-id)
       (idl (list 'VNB-LAMBDA 'i 'NN (list id '(seq i)))))
  (dk-cite! 'fbs-graph-frechet 'fld 'm1 'fam1 'm2 'fam2 'tt gg)
  (dk-cite! 'fbs-id-linear 'm1)
  ;; the projection of the graph onto E is continuous: (VEC m1, gg) -> (VEC m1, fam1)
  (dk-have! (list 'IS-CONT-LIN 'm1 gg 'm1 'fam1 id)
    (lambda ()
      (mac 'is-cont-lin)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (let* ((ls (dk-peel!))
                     (sq (cadr (find-first (fbs-in-seq? 'm1) ls)))
                     (lim (cadr (find-first (fbs-in-vec? 'm1) ls)))
                     (gl (dk-goal)) (tsq (cadddr gl)) (bb (car (cddddr gl))))
                (dk-have! (list 'IN bb '(VEC m1)) (lambda () (if (not (dk-lam-b!)) (ass))))
                (dk-have! (list 'IN tsq '(FUN NN (VEC m1)))
                  (lambda ()
                    (dk-lam-type!
                      (lambda ()
                        (let ((i (dk-di-var!)))
                          (fbs-ty! (list sq i) '(VEC m1))
                          (if (not (dk-lam-b!)) (ass)))))))
                (let ((r (dk-cite! 'fbs-conv-dom 'm1 'm1 gg 'fam1 sq tsq lim bb)))
                  (dk-have! (cadr r)
                    (lambda ()
                      (fbs-type-seq-at! sq (dk-peel!))
                      (dk-lam-b!)
                      (let* ((gl (dk-goal)) (k (cadr (car (cadr gl)))) (v (cadr (cadr gl))))
                        (fbs-dom-p! ve k v))))
                  (dk-cite! 'fbs-conv-dom 'm1 'm1 gg 'fam1 sq tsq lim bb)
                  (ass))))))))
  ;; the identity is its own two-sided inverse
  (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC m1)) (list '= (list id (list id 'x)) 'x)))
    (lambda () (dk-peel!) (if (not (dk-lam-b!)) (rfl))))
  ;; Thm 8.30, bounded-inverse form: the inverse is continuous
  (dk-cite! 'open-mapping-bounded-inverse 'fld 'm1 gg 'm1 'fam1 id id)
  (mac 'is-cont-lin)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (let* ((ls (dk-peel!))
                 (sq (cadr (find-first (fbs-in-seq? 'm1) ls)))
                 (lim (cadr (find-first (fbs-in-vec? 'm1) ls)))
                 (gl (dk-goal)) (tts (cadddr gl)) (tl (car (cddddr gl)))
                 (seqc (dk-cite! 'frm-cont-lin-seq 'm1 'fam1 'm1 gg id))
                 (gc (dk-apply! seqc sq lim))          ; FR-CONV m1 gg (i |-> id(sq i)) (id lim)
                 (ss (cadddr gc)) (aa (car (cddddr gc))))
            (dk-have! (list 'IN aa '(VEC m1)) (lambda () (if (not (dk-lam-b!)) (ass))))
            (dk-have! (list 'IN ss '(FUN NN (VEC m1)))
              (lambda ()
                (dk-lam-type!
                  (lambda ()
                    (let ((i (dk-di-var!)))
                      (fbs-ty! (list sq i) '(VEC m1))
                      (if (not (dk-lam-b!)) (ass)))))))
            (fbs-ty! tl '(VEC m2))
            (dk-have! (list 'IN tts '(FUN NN (VEC m2)))
              (lambda ()
                (dk-lam-type!
                  (lambda ()
                    (let ((i (dk-di-var!)))
                      (fbs-ty! (list 'tt (list sq i)) '(VEC m2))
                      (ass))))))
            (let ((r (dk-cite! 'fbs-conv-dom 'm1 'm2 gg 'fam2 ss tts aa tl)))
              (dk-have! (cadr r)
                (lambda ()
                  (fbs-type-seq-at! sq (dk-peel!))
                  (dk-lam-b!)
                  (let* ((gl (dk-goal)) (k (cadr (car (cadr gl)))) (v (cadr (caddr gl))))
                    (fbs-pull-sub! (cadr v) (cadr (caddr v)))
                    (fbs-dom-q! ve k v))))
              (dk-cite! 'fbs-conv-dom 'm1 'm2 gg 'fam2 ss tts aa tl)
              (ass)))))))
(qed 'closed-graph-theorem)

;;; =====================================================================
;;; (4) THM 8.32 (BANACH-STEINHAUS bis), the route of Thm 1.72.  Fix the
;;;     seminorm q = fam2(k) of F.  The sets
;;;         E_n = { x in E : q(T_i x) <= n for every i }
;;;     cover E (pointwise boundedness + the archimedean property), so by Baire
;;;     some E_n is not nowhere dense: a ball B(x0, rad) lies in its closure
;;;     (fbs-baire-ball).  The T_i are continuous, so the bound passes to the
;;;     closure (fbs-closure-bound) -- the book's "E_k is closed".  A prefix ball
;;;     {p_j(w) < dl, j <= nb} lies in B(0, rad) - x0, so q(T_i w) <= n + M(x0)
;;;     there, uniformly in i (fbs-uniform-ball); rescaling by the powers of a
;;;     scalar |c| > 1 (fbs-ball-bound) turns that into the seminorm bound.
;;; =====================================================================

(define fbs-fx '(FR-METRIC-SPACE m1 fam1))
(define fbs-pts-eq (list '== (list 'PTS fbs-fx) '(VEC m1)))
(define (fbs-orbit x)
  (list 'SEP 'y '(VEC m2) (list 'FORSOME 'i (list 'AND '(IN i ix) (list '= 'y (list '(tf i) x))))))
(define fbs-pbdd
  (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC m1)) (list 'IS-FR-BOUNDED 'm2 'fam2 (fbs-orbit 'x)))))
;;; E_n for the seminorm fam2(k)
(define (fbs-aset k n)
  (list 'SEP 'bx_ '(VEC m1)
        (list 'FORALL 'bi_ (list 'IMPLIES '(IN bi_ ix) (list '<= (list (list 'fam2 k) '((tf bi_) bx_)) n)))))
;;; ew the witnesses in turn, closing the conjuncts the context holds; a conjunct it
;;; does not hold is left open, and the focus is left on the last leaf visited
(define (fbs-ew-chain! ws)
  (ew (car ws))
  (dk-conj-close!
    (lambda ()
      (cond ((dk-head-is? (dk-goal) 'FORSOME) (fbs-ew-chain! (cdr ws)))
            ((dk-asm? (dk-goal)) (ass))
            (#t #f)))))
;;; goal (IN E_n (POWER (PTS FX)))
(define (fbs-aset-power!)
  (mac 'power-set-membership)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IN)
          (begin (sep-set) (ass))
          (let ((mem (car (dk-peel!))))
            (sep-me mem)
            (subst fbs-pts-eq)
            (ass))))))
;;; (IN ((tf j) z) orbit(z)), with (IN j ix) and the value typed
(define (fbs-in-orbit! j z)
  (let ((tj (list (list 'tf j) z)))
    (fbs-ty! tj '(VEC m2))
    (dk-have! (list 'IN tj (fbs-orbit z))
      (lambda ()
        (in-sep! (lambda () (ass))
                 (lambda ()
                   (ew j)
                   (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass) (rfl))))))))
    (list 'IN tj (fbs-orbit z))))

(define (fbs-bs-hyps body)
  (forall-guarded '(fld m1 fam1 m2 fam2 ix tf)
    (list '(IS-FRECHET-STRUCTURE fld m1 fam1) '(IS-SEMINORM-FAMILY fld m2 fam2)
          '(IN tf (FUN ix (FUN (VEC m1) (VEC m2)))) fbs-pbdd)
    body))

(sp (make-wff (fbs-bs-hyps
  (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
    (list 'FORSOME 'n (list 'AND '(IN n NN)
      (list 'FORSOME 'x0 (list 'AND '(IN x0 (VEC m1))
        (list 'FORSOME 'rad (list 'AND '(POS-RR rad)
          (list 'SUBSET (list 'BALL fbs-fx 'x0 'rad) (list 'CLOSURE fbs-fx (fbs-aset 'k 'n))))))))))))))
(let* ((ls (dk-peel!))
       (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) ls)))
       (pb (or (dk-ctx-form fbs-pbdd) (error "fbs-baire-ball: no pointwise bound"))))
  (dk-project! '(IS-SEMINORM-FAMILY fld m1 fam1)
    (lambda () (mac-h 'is-frechet-structure '(IS-FRECHET-STRUCTURE fld m1 fam1))))
  (dk-project! (list 'IS-COMPLETE fbs-fx)
    (lambda () (mac-h 'frm-frechet-iff-complete '(IS-FRECHET-STRUCTURE fld m1 fam1))))
  (dk-cite! 'frm-fam-module 'fld 'm1 'fam1)
  (dk-cite! 'frm-fam-module 'fld 'm2 'fam2)
  (dk-cite! 'frm-fam-type 'fld 'm2 'fam2)
  (dk-cite! 'frm-metric-space-is-metric-space 'fld 'm1 'fam1)
  (dk-cite! 'frm-metric-space-pts 'fld 'm1 'fam1)
  (dk-cite! 'frm-module-vec-set 'm1)
  (dk-cite! 'module-vzero-in 'm1)
  (dk-cite! 'nn-is-set)
  (dk-have! (list 'FORSOME 'x (list 'IN 'x (list 'PTS fbs-fx)))
    (lambda () (ew '(VZERO m1)) (subst fbs-pts-eq) (ass)))
  (dk-cite! 'baire-category fbs-fx)
  (let* ((nm (dk-project! (list 'NOT (list 'IS-MEAGER fbs-fx (list 'PTS fbs-fx)))
               (lambda () (mac-h 'is-nonmeager (list 'IS-NONMEAGER fbs-fx (list 'PTS fbs-fx))))))
         (ab (dk-abstract! 'NN (list 'POWER (list 'PTS fbs-fx)) (lambda (n) (fbs-aset k n))
               (lambda (n) (fbs-aset-power!))))
         (gfam (car ab)) (gve (cdr ab)))
    (pbc)
    (let ((note (dk-pick (lambda (f) (and (dk-head-is? f 'NOT) (dk-head-is? (cadr f) 'FORSOME)))
                         "the negated conclusion")))
      ;; every E_n is nowhere dense
      (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IS-NOWHERE-DENSE fbs-fx (list gfam 'n))))
        (lambda ()
          (let ((n (cadr (car (dk-peel!)))))
            (subst (dk-apply! gve n))
            (mac 'is-nowhere-dense)
            (dk-conj-close!
              (lambda ()
                (let ((gl (dk-goal)))
                  (cond
                   ((dk-asm? gl) (ass))
                   ((dk-head-is? gl 'SUBSET)
                    (let ((z (subset-by-element!)))
                      (sep-me (list 'IN z (cadr gl)))
                      (subst fbs-pts-eq)
                      (ass)))
                   (#t
                    (let* ((int (cadr gl))
                           (clos (caddr int))
                           (r (dk-cite! 'class-extensionality int 'EMPTY-SET)))
                      (dk-have! (cadr r)
                        (lambda ()
                          (di)
                          (let ((x (cadr (cadr (dk-goal)))))
                            (dk-iff! (lambda (g) (equal? g (list 'IN x 'EMPTY-SET)))
                              (lambda ()
                                (dk-split! (dk-landed-1 (lambda () (mac-h 'interior-membership (list 'IN x int)))))
                                (let* ((u (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'IS-OPEN)))
                                                               "the open set")))
                                       (_ (dk-split-all! (dk-landed (lambda () (mac-h 'is-open (list 'IS-OPEN fbs-fx u))))))
                                       (ou (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'BALL) (dk-contains? f u)))
                                                    "the openness clause"))
                                       (rad (dk-skolem! (dk-apply! ou x)))
                                       (bl (list 'BALL fbs-fx x rad)))
                                  (dk-cite! 'subset-trans bl u clos)
                                  (dk-rewrite-h! (list 'IN x (list 'PTS fbs-fx)) (list 'PTS fbs-fx) '(VEC m1))
                                  (dk-have! (cadr note) (lambda () (fbs-ew-chain! (list n x rad))))
                                  (ai note)))
                              (lambda ()
                                (dk-cite! 'empty-set-has-no-members x)
                                (ai (list 'NOT (list 'IN x 'EMPTY-SET))))))))
                      (dk-cite! 'class-extensionality int 'EMPTY-SET)
                      (ass))))))))))
      ;; so PTS(FX) is meager
      (dk-have! (list 'IS-MEAGER fbs-fx (list 'PTS fbs-fx))
        (lambda ()
          (mac 'is-meager)
          (dk-conj-close!
            (lambda ()
              (let ((gl (dk-goal)))
                (cond
                 ((dk-asm? gl) (ass))
                 ((dk-head-is? gl 'SUBSET) (dk-cite! 'subset-refl (cadr gl)) (ass))
                 (#t
                  (ew gfam)
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-asm? (dk-goal))
                          (ass)
                          ;; the cover
                          (let* ((z (subset-by-element!))
                                 (_ (dk-rewrite-h! (list 'IN z (list 'PTS fbs-fx)) (list 'PTS fbs-fx) '(VEC m1)))
                                 (bh (dk-apply! pb z))
                                 (_ (dk-split-all! (dk-landed (lambda () (mac-h 'is-fr-bounded bh)))))
                                 (bu (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'FORSOME) (dk-contains? f z)))
                                              "the bound clause"))
                                 (bd (dk-skolem! (dk-apply! bu k)))
                                 (yu (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f bd))) "the bound universal"))
                                 (n (dk-skolem! (dk-cite! 'nn-unbounded-in-rr bd))))
                            (dk-cite! 'nn-in-rr n)
                            (for-each
                              (lambda (leaf)
                                (dk-focus! leaf)
                                (if (equal? (dk-goal) (list 'IN n 'NN))
                                    (ass)
                                    (begin
                                      (subst (dk-apply! gve n))
                                      (in-sep! (lambda () (ass))
                                               (lambda ()
                                                 (let* ((j (cadr (car (dk-peel!))))
                                                        (tj (list (list 'tf j) z)))
                                                   (fbs-in-orbit! j z)
                                                   (fbs-real! (list (list 'fam2 k) tj))
                                                   (dk-ineq! (dk-apply! yu tj) (list '< bd n))))))))
                              (dk-opened (lambda () (bu-mi n)))))))))))))))
      (ai nm))))
(qed 'fbs-baire-ball)

;;; ---- two group identities on VEC m ----------------------------------------

;;; (x - y) + y = x
(sp (make-wff '(FORALL m (IMPLIES (IS-MODULE m) (FORALL x (IMPLIES (IN x (VEC m)) (FORALL y (IMPLIES (IN y (VEC m))
   (= ((VADD m) ((VADD m) x ((VNEG m) y)) y) x)))))))))
(dk-peel!)
(fbs-ty! '((VNEG m) y) '(VEC m))
(subst (dk-cite! 'hbs-vadd-assoc 'm 'x '((VNEG m) y) 'y))
(subst (dk-cite! 'hbs-vadd-comm 'm '((VNEG m) y) 'y))
(subst (dk-cite! 'frm-v-right-inv 'm 'y))
(subst (dk-cite! 'hbs-vzero-r 'm 'x))
(rfl)
(qed 'fbs-v-sub-add)

;;; (x + y) - y = x
(sp (make-wff '(FORALL m (IMPLIES (IS-MODULE m) (FORALL x (IMPLIES (IN x (VEC m)) (FORALL y (IMPLIES (IN y (VEC m))
   (= ((VADD m) ((VADD m) x y) ((VNEG m) y)) x)))))))))
(dk-peel!)
(fbs-ty! '((VNEG m) y) '(VEC m))
(subst (dk-cite! 'hbs-vadd-assoc 'm 'x 'y '((VNEG m) y)))
(subst (dk-cite! 'frm-v-right-inv 'm 'y))
(subst (dk-cite! 'hbs-vzero-r 'm 'x))
(rfl)
(qed 'fbs-v-add-sub)

;;; ---- continuity of x |-> q_k(tt x) in the metric, from below ---------------

(define fbs-f2 '(FR-METRIC-SPACE m2 fam2))
(sp (make-wff (forall-guarded '(fld m1 fam1 m2 fam2 tt)
  '((IS-SEMINORM-FAMILY fld m1 fam1) (IS-SEMINORM-FAMILY fld m2 fam2) (IS-CONT-LIN m1 fam1 m2 fam2 tt))
  (forall-guarded '(k y) '((IN k NN) (IN y (VEC m1)))
    (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
      (list 'FORSOME 'de (list 'AND '(POS-RR de)
        (forall-guarded 'z '(IN z (VEC m1))
          (list 'IMPLIES (list '<= (list (list 'DIST fbs-fx) 'y 'z) 'de)
                '(<= ((fam2 k) (tt y)) (+ ((fam2 k) (tt z)) eps))))))))))))
(let* ((ls (dk-peel!))
       (kk (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) ls)))
       (y (cadr (find-first (fbs-in-vec? 'm1) ls)))
       (eps (cadr (find-first (dk-head? 'POS-RR) ls)))
       (ty (list 'tt y))
       (f1 fbs-fx) (f2 fbs-f2))
  (dk-cite! 'frm-fam-module 'fld 'm1 'fam1)
  (dk-cite! 'frm-fam-module 'fld 'm2 'fam2)
  (dk-cite! 'frm-fam-type 'fld 'm2 'fam2)
  (dk-cite! 'frm-metric-space-is-metric-space 'fld 'm1 'fam1)
  (dk-cite! 'frm-metric-space-is-metric-space 'fld 'm2 'fam2)
  (dk-cite! 'frm-metric-space-pts 'fld 'm1 'fam1)
  (dk-cite! 'frm-metric-space-pts 'fld 'm2 'fam2)
  (dk-project! '(IS-LINEAR-MAP m1 m2 tt) (lambda () (mac-h 'is-cont-lin '(IS-CONT-LIN m1 fam1 m2 fam2 tt))))
  (dk-project! '(IN tt (FUN (VEC m1) (VEC m2))) (lambda () (mac-h 'is-linear-map '(IS-LINEAR-MAP m1 m2 tt))))
  (dk-cite! 'nn-is-set)
  (dk-cite! 'rr-pos-rr-in-rr eps)
  (fbs-ty! ty '(VEC m2))
  (let ((seqc (dk-cite! 'frm-cont-lin-seq 'm1 'fam1 'm2 'fam2 'tt))
        (to-vec (lambda ()
                  (if (dk-contains? (dk-goal) (list 'PTS f1)) (subst (list '== (list 'PTS f1) '(VEC m1))))
                  (if (dk-contains? (dk-goal) (list 'PTS f2)) (subst (list '== (list 'PTS f2) '(VEC m2)))))))
    (dk-have! (list 'IN 'tt (list 'FUN (list 'PTS f1) (list 'PTS f2))) (lambda () (to-vec) (ass)))
    (dk-have! (list 'IN y (list 'PTS f1)) (lambda () (to-vec) (ass)))
    (let* ((cas (dk-cite! 'continuous-at-iff-sequential f1 f2 'tt y))
           (lhs (cadr cas)) (rhs (caddr cas)))
      (ai cas)
      (dk-have! rhs
        (lambda ()
          (let* ((ls (dk-peel!))
                 (sm (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-contains? f 'SQN))) ls))
                 (sq (cadr sm))
                 (lam (list 'VNB-LAMBDA 'i 'NN (list 'tt (list sq 'i)))))
            (fbs-landed-last (lambda () (mac-h 'sqn-membership sm)))
            (dk-rewrite-h! (list 'IN sq (list 'FUN 'NN (list 'PTS f1))) (list 'PTS f1) '(VEC m1))
            (dk-cite! 'frm-conv-of-converges 'fld 'm1 'fam1 sq y)
            (dk-apply! seqc sq y)
            (dk-have! (list 'IN lam '(FUN NN (VEC m2)))
              (lambda ()
                (dk-lam-type!
                  (lambda ()
                    (let ((i (cadr (car (dk-peel!)))))
                      (dk-cite! 'fun-apply-type-c sq 'NN '(VEC m1) i)
                      (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) (list sq i))
                      (ass))))))
            (dk-cite! 'frm-converges-of-conv 'fld 'm2 'fam2 lam ty)
            (dk-have! (list 'AND (list 'IN sq '(FUN NN (VEC m1))) '(IN tt (FUN (VEC m1) (VEC m2))))
                      (lambda () (dk-conj-close! ass)))
            (dk-cite! 'compose-type 'NN '(VEC m1) '(VEC m2) 'tt sq)
            (let ((cap (dk-cite! 'compose-apply 'NN '(VEC m1) '(VEC m2) 'tt sq)))
              (dk-fun-ext! (list 'COMPOSE 'tt sq) lam 'NN '(VEC m2) #f #f
                (lambda (v)
                  (dk-cite! 'fun-apply-type-c sq 'NN '(VEC m1) v)
                  (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) (list sq v))
                  (subst (dk-apply! cap v))
                  (if (not (dk-lam-b!)) (rfl)))))
            (subst (list '= (list 'COMPOSE 'tt sq) lam))
            (ass))))
      (dk-landed (lambda () (detach! (list 'IMPLIES rhs lhs))))
      (let* ((cu (begin (mac-h 'is-continuous-at lhs) (dk-split-all!)
                        (fbs-pick-forall-with 'DIST "the epsilon-delta clause")))
             (dl2 (dk-skolem! (dk-apply! (dk-cite! 'frm-ball-seminorm 'fld 'm2 'fam2) kk eps)))
             (bl2 (fbs-pick-forall-with dl2 "the codomain ball"))
             (h (begin (dk-cite! 'rr-pos-rr-in-rr dl2) (dk-halve! dl2)))
             (de (dk-skolem! (dk-apply! cu h)))
             (bu (fbs-pick-forall-with de "the delta universal")))
        (ew de)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'POS-RR)
                (ass)
                (let* ((ls2 (dk-peel!))
                       (z (cadr (find-first (fbs-in-vec? 'm1) ls2)))
                       (tz (list 'tt z))
                       (q (list 'fam2 kk)))
                  (fbs-ty! tz '(VEC m2))
                  (dk-rewrite-h! (list 'IN z '(VEC m1)) '(VEC m1) (list 'PTS f1))
                  (dk-rewrite-h! (list 'IN ty '(VEC m2)) '(VEC m2) (list 'PTS f2))
                  (dk-rewrite-h! (list 'IN tz '(VEC m2)) '(VEC m2) (list 'PTS f2))
                  (let* ((d2 (dk-apply! bu z))
                         (dr (dk-cite! 'metric-dist-real f2 ty tz))
                         (lt (dk-have! (list '< (cadr d2) dl2)
                               (lambda () (dk-ineq! d2 (list '= (list '+ h h) dl2) (list '< 0 h)))))
                         (q1 (dk-apply! bl2 ty tz))
                         (dv (fbs-sub 'm2 ty tz))
                         (_ (fbs-ty! dv '(VEC m2)))
                         (_ (fbs-sn! 'm2 'fam2 kk))
                         (sa (dk-apply! (dk-cite! 'frm-sn-subadd 'fld 'm2 q) dv tz))
                         (_ (dk-cite! 'fbs-v-sub-add 'm2 ty tz))
                         (sb (dk-rewrite-h! sa (fbs-add 'm2 dv tz) ty)))
                    (fbs-real! (list q ty)) (fbs-real! (list q tz)) (fbs-real! (list q dv))
                    (dk-ineq! sb q1))))))))))
(qed 'fbs-q-cont)

;;; the bound of E_n passes to its closure: the book's "E_k is closed"
(sp (make-wff (forall-guarded '(fld m1 fam1 m2 fam2 ix tf)
  (list '(IS-SEMINORM-FAMILY fld m1 fam1) '(IS-SEMINORM-FAMILY fld m2 fam2)
        '(IN tf (FUN ix (FUN (VEC m1) (VEC m2))))
        '(FORALL i (IMPLIES (IN i ix) (IS-CONT-LIN m1 fam1 m2 fam2 (tf i)))))
  (forall-guarded '(k n z) (list '(IN k NN) '(IN n NN) '(IN z (VEC m1)))
    (list 'IMPLIES (list 'IN 'z (list 'CLOSURE fbs-fx (fbs-aset 'k 'n)))
      '(FORALL j (IMPLIES (IN j ix) (<= ((fam2 k) ((tf j) z)) n))))))))
(let* ((ls (dk-peel!))
       (nns (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) ls))
       (zc (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'CLOSURE))) ls))
       (z (cadr zc)) (aset (caddr (caddr zc)))
       (le (caddr (caddr (cadddr aset))))                 ; q_k(T_i x) <= n inside E_n
       (n (caddr le))
       (j (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'ix))) ls)))
       (kk (cadr (car (cadr le))))
       (cl (fbs-pick-forall-with 'IS-CONT-LIN "the continuity hypothesis"))
       (tj (list 'tf j)) (qz (list (list 'fam2 kk) (list tj z))))
  (dk-cite! 'frm-fam-module 'fld 'm1 'fam1)
  (dk-cite! 'frm-fam-module 'fld 'm2 'fam2)
  (dk-cite! 'frm-fam-type 'fld 'm2 'fam2)
  (dk-cite! 'frm-metric-space-is-metric-space 'fld 'm1 'fam1)
  (dk-cite! 'frm-metric-space-pts 'fld 'm1 'fam1)
  (dk-cite! 'nn-in-rr n)
  (fbs-ty! tj '(FUN (VEC m1) (VEC m2)))
  (fbs-real! qz)
  (use-em (list '<= qz n)
    (lambda () (ass))
    (lambda ()
      (let* ((gap (begin (dk-cite! 'rr-not-le-lt qz n) (list '- qz n)))
             (_ (dk-cite! 'rr-lt-diff-pos n qz))
             (_ (dk-cite! 'rr-sub-in-rr qz n))
             (_ (dk-cite! 'rr-pos-rr-of-lt gap))
             (h (dk-halve! gap))
             (_ (dk-apply! cl j))
             (qc (dk-cite! 'fbs-q-cont 'fld 'm1 'fam1 'm2 'fam2 tj))
             (de (dk-skolem! (dk-apply! qc kk z h)))
             (bu (fbs-pick-forall-with de "the continuity universal"))
             (bl (list 'BALL fbs-fx z de)))
        (dk-cite! 'rr-pos-rr-in-rr de)
        (dk-cite! 'rr-lt-of-pos-rr de)
        (dk-have! (list '<= 0 de) (lambda () (dk-ineq! (list '< 0 de))))
        (dk-have! (list 'NOT (list '= 0 de)) (lambda () (di) (dk-absurd! (list '= 0 de) (list '< 0 de))))
        (dk-have! (list 'AND (list 'IN de 'RR) (list 'AND (list '<= 0 de) (list 'NOT (list '= 0 de))))
                  (lambda () (dk-conj-close! ass)))
        (dk-rewrite-h! (list 'IN z '(VEC m1)) '(VEC m1) (list 'PTS fbs-fx))
        (dk-cite! 'ball-is-open fbs-fx z de)
        (dk-cite! 'ball-center-in fbs-fx z de)
        (dk-split! (dk-landed-1 (lambda () (mac-h 'closure-membership zc))))
        (let* ((cu (fbs-pick-forall-with 'IS-OPEN "the closure clause"))
               (_ (dk-have! (list 'AND (list 'IS-OPEN fbs-fx bl) (list 'IN z bl)) (lambda () (dk-conj-close! ass))))
               (y (dk-skolem! (dk-apply! cu bl)))
               (ya (list 'IN y aset))
               (_ (sep-me ya))
               (yb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f y) (dk-contains? f 'ix))) "y's bound"))
               (qy (dk-apply! yb j))
               (_ (dk-split-all! (dk-landed (lambda () (mac-h 'ball-membership (list 'IN y bl))))))
               (dyz (dk-ctx-form (list '<= (list (list 'DIST fbs-fx) z y) de)))
               (_ (dk-rewrite-h! (list 'IN y (list 'PTS fbs-fx)) (list 'PTS fbs-fx) '(VEC m1)))
               (cz (dk-apply! bu y)))
          (fbs-real! (list (list 'fam2 kk) (list tj y)))
          (dk-ineq! cz qy (list '= (list '+ h h) gap) (list '< 0 h)))))))
(qed 'fbs-closure-bound)

;;; ---- rescaling: a uniform bound on a prefix ball gives the seminorm bound ----
;;; The argument of frm-bound-of-cont-lin (theorem-library/frechet-metric.scm, 8.26),
;;; with the neighbourhood {p_j < dl, j <= nb} -> {q_k <= mm} GIVEN instead of read off
;;; continuity, and the scalars c (|c| > 1) and b = c^-1 given: the constant
;;; (|c| mm) / dl then depends on nothing but c, mm and dl -- which is what makes it
;;; uniform over a family.  The driver below is that file's, adapted (frm-* helpers
;;; are file-local there, so the ones it needs are restated with the fbs- prefix).

(define fbs-nfv '(NORMED-FIELD-AS-COMMUTATIVE-RING fld))
(define (fbs-act m r v) (list (list 'ACT m) r v))
(define (fbs-names! terms)
  (fbs-seq-map (lambda (t) (dk-real! t) (cons t (dk-name! t 'RR))) terms))
(define (fbs-rw al f)
  (fold-left (lambda (f pr) (if (dk-contains? f (car pr)) (dk-rewrite-h! f (car pr) (cdr pr)) f)) f al))
(define (fbs-rw-goal! al)
  (for-each (lambda (pr) (if (dk-contains? (dk-goal) (car pr)) (subst (list '= (car pr) (cdr pr))))) al))
(define (fbs-sc-in! md v)              ; (IN v (CARR (SCAL md))) from (IN v (CARR fld))
  (let ((ty (list 'IN v (list 'CARR (list 'SCAL md)))))
    (fbs-once! ty
      (lambda ()
        (dk-rewrite-h! (dk-rewrite-h! (list 'IN v '(CARR fld)) '(CARR fld) (list 'CARR fbs-nfv))
                       fbs-nfv (list 'SCAL md))))
    ty))
(define (fbs-pv! md fm k v)            ; (IN ((fm k) v) RR)
  (fbs-real! (list (list fm k) v)))

(define fbs-ball-hyp
  '(FORALL x (IMPLIES (IN x (VEC m1))
     (IMPLIES (FORALL j (IMPLIES (IN j NN) (IMPLIES (<= j nb) (< ((fam1 j) x) dl))))
              (<= ((fam2 k) (tt x)) mm)))))
(define fbs-ball-concl
  '(FORALL x (IMPLIES (IN x (VEC m1)) (FORALL r (IMPLIES (IN r RR)
     (IMPLIES (FORALL j (IMPLIES (IN j NN) (IMPLIES (<= j nb) (<= ((fam1 j) x) r))))
              (<= ((fam2 k) (tt x)) (* (* (* ((FNRM fld) c) mm) (recip dl)) r))))))))
(define (fbs-c-hyps body)
  (list 'FORALL 'c (list 'IMPLIES '(IN c (CARR fld)) (list 'FORALL 'b (list 'IMPLIES '(IN b (CARR fld))
    (list 'IMPLIES '(< 1 ((FNRM fld) c)) (list 'IMPLIES '(= ((MUL fld) c b) (ONE fld)) body)))))))

(sp (make-wff (forall-guarded '(fld m1 fam1 m2 fam2 tt)
  '((IS-SEMINORM-FAMILY fld m1 fam1) (IS-SEMINORM-FAMILY fld m2 fam2) (IS-LINEAR-MAP m1 m2 tt))
  (fbs-c-hyps
    (forall-guarded '(k nb) '((IN k NN) (IN nb NN))
      (list 'FORALL 'dl (list 'IMPLIES '(POS-RR dl) (list 'FORALL 'mm (list 'IMPLIES '(POS-RR mm)
        (list 'IMPLIES fbs-ball-hyp fbs-ball-concl))))))))))
(let* ((landed (dk-peel!))
       (gl0 (dk-goal))
       (kk (cadr (car (cadr gl0))))
       (x (cadr (cadr (cadr gl0))))
       (r (caddr (caddr gl0)))
       (nbu (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'tt))) landed))
       (hx (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (not (dk-contains? f 'tt)))) landed))
       (nb 'nb) (dl 'dl) (mm 'mm) (c 'c) (b 'b)
       (g (list '(FNRM fld) c))
       (gm (list '* g mm))
       (rd (list 'recip dl))
       (ck (list '* gm rd))
       (tx (list 'tt x))
       (a (list (list 'fam2 kk) tx)))
  (for-each (lambda (f) (if (not (dk-asm? f)) (error "fbs-ball-bound: binder renamed" (expression->string f))))
            (list '(IN nb NN) '(POS-RR dl) '(POS-RR mm) '(IN c (CARR fld)) '(IN b (CARR fld))))
  (dk-cite! 'frm-fam-field 'fld 'm1 'fam1)
  (dk-cite! 'frm-fam-module 'fld 'm1 'fam1)
  (dk-cite! 'frm-fam-module 'fld 'm2 'fam2)
  (dk-cite! 'frm-fam-scal 'fld 'm1 'fam1)
  (dk-cite! 'frm-fam-scal 'fld 'm2 'fam2)
  (dk-cite! 'frm-fam-type 'fld 'm1 'fam1)
  (dk-cite! 'frm-fam-type 'fld 'm2 'fam2)
  (dk-cite! 'normed-field-ring-view-carr 'fld)
  (dk-project! '(IN tt (FUN (VEC m1) (VEC m2))) (lambda () (mac-h 'is-linear-map '(IS-LINEAR-MAP m1 m2 tt))))
  (dk-cite! 'nf-norm-in-rr 'fld c)
  (dk-have! (list '< 0 g) (lambda () (dk-ineq! (list '< 1 g))))
  (dk-have! (list '<= 0 g) (lambda () (dk-ineq! (list '< 1 g))))
  (dk-cite! 'rr-pos-rr-in-rr dl) (dk-cite! 'rr-lt-of-pos-rr dl)
  (dk-cite! 'rr-pos-rr-in-rr mm) (dk-cite! 'rr-lt-of-pos-rr mm)
  (dk-have! (list 'NOT (list '= dl 0)) (lambda () (di) (dk-absurd! (list '= dl 0) (list '< 0 dl))))
  (dk-have! (list 'AND (list 'IN dl 'RR) (list 'NOT (list '= dl 0))) (lambda () (dk-conj-close! ass)))
  (dk-cite! 'rr-recip-closed dl)
  (dk-cite! 'rr-recip-inverse dl)
  (dk-cite! 'rr-recip-pos dl)
  (dk-real! gm)
  (dk-cite! 'rr-mul-pos g mm)
  (dk-have! (list '<= 0 gm) (lambda () (dk-ineq! (list '< 0 gm))))
  (dk-cite! 'rr-mul-pos gm rd)
  (dk-real! ck)
  (fbs-ty! tx '(VEC m2))
  (fbs-pv! 'm2 'fam2 kk tx)
  (fbs-sn! 'm2 'fam2 kk)
  (dk-apply! (dk-cite! 'frm-sn-nonneg 'fld 'm2 (list 'fam2 kk)) tx)      ; 0 <= a
  ;; 0 <= r, from j = 0
  (dk-cite! 'nn-zero-in) (dk-cite! 'nn-zero-le nb)
  (fbs-sn! 'm1 'fam1 0)
  (fbs-pv! 'm1 'fam1 0 x)
  (let* ((h0 (dk-apply! hx 0))
         (n0 (dk-apply! (dk-cite! 'frm-sn-nonneg 'fld 'm1 '(fam1 0)) x)))
    (dk-have! (list '<= 0 r) (lambda () (dk-ineq! h0 n0))))
  ;; the claim dl a <= gm r + fd for every fd > 0, by r' = r + e
  (dk-real! (list '* dl a)) (dk-real! (list '* gm r))
  (dk-have! (list 'FORALL 'fd_ (list 'IMPLIES '(POS-RR fd_)
              (list '<= (list '* dl a) (list '+ (list '* gm r) 'fd_))))
    (lambda ()
      (let* ((d (cadr (car (dk-peel!))))
             (_ (dk-cite! 'rr-pos-rr-in-rr d))
             (e (dk-skolem! (dk-cite! 'rr-scale-eps gm d)))
             (se (fbs-pick-forall-with e "the scaling of e"))
             (rp (list '+ r e)))
        (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e)
        (dk-real! rp)
        (dk-have! (list '< 0 rp) (lambda () (dk-ineq! (list '<= 0 r) (list '< 0 e))))
        (let* ((s (dk-skolem! (dk-cite! 'frm-nf-bracket 'fld c b dl rp)))
               (sv (list '(FNRM fld) s))
               (y (fbs-act 'm1 s x)))
          (dk-cite! 'nf-norm-in-rr 'fld s)
          (dk-cite! 'nf-norm-nonneg 'fld s)
          (fbs-sc-in! 'm1 s) (fbs-sc-in! 'm2 s)
          (dk-cite! 'module-act-type 'm1 s x)
          ;; s.x is in the prefix ball
          (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'IMPLIES (list '<= 'j nb)
                      (list '< (list '(fam1 j) y) dl))))
            (lambda ()
              (let* ((j (cadr (car (dk-peel!))))
                     (pj (list (list 'fam1 j) x)))
                (fbs-sn! 'm1 'fam1 j)
                (fbs-pv! 'm1 'fam1 j x)
                (subst (dk-apply! (dk-cite! 'frm-sn-homog 'fld 'm1 (list 'fam1 j)) s x))
                (let ((hj (dk-apply! hx j)))
                  (dk-have! (list '<= pj rp) (lambda () (dk-ineq! hj (list '< 0 e))))
                  (dk-have! (list 'AND (list '<= 0 sv) (list '<= pj rp)) (lambda () (dk-conj-close! ass)))
                  (let* ((sc (dk-cite! 'rr-le-scale-nonneg sv pj rp))
                         (al (fbs-names! (list (list '* sv pj) (list '* sv rp)))))
                    (fbs-rw-goal! al)
                    (apply dk-ineq! (fbs-seq-map (lambda (f) (fbs-rw al f))
                                                 (list sc (dk-ctx-form (list '< (list '* sv rp) dl))))))))))
          (let* ((lh (dk-apply! (dk-cite! 'frm-linear-homog 'm1 'm2 'tt) s x))
                 (qh (dk-apply! (dk-cite! 'frm-sn-homog 'fld 'm2 (list 'fam2 kk)) s tx))
                 (q0 (dk-apply! nbu y))
                 (q1 (dk-rewrite-h! q0 (list 'tt y) (fbs-act 'm2 s tx)))
                 (q2 (dk-rewrite-h! q1 (list (list 'fam2 kk) (fbs-act 'm2 s tx)) (list '* sv a)))
                 (xx (list '* g (list '* sv rp)))
                 (_ (begin (dk-real! xx) (dk-real! (list '* sv a)) (dk-real! (list '* g rp))
                           (dk-cite! 'rr-zero-in) (dk-cite! 'rr-one-in)))
                 (m1x (dk-cite! 'rr-mul-le-right dl xx a))
                 (e1 (begin (dk-have! (list '= (list '* xx a) (list '* (list '* g rp) (list '* sv a)))
                                      (lambda () (crs)))
                            (list '= (list '* xx a) (list '* (list '* g rp) (list '* sv a)))))
                 (_ (dk-have! (list 'AND (list '<= 0 g) (list '<= 0 rp))
                      (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 0 rp))))))))
                 (g0 (dk-cite! 'rr-le-scale-nonneg g 0 rp))
                 (al0 (fbs-names! (list (list '* g rp) (list '* sv a))))
                 (_ (dk-have! (list '<= 0 (list '* g rp))
                      (lambda () (fbs-rw-goal! al0) (dk-ineq! (fbs-rw al0 g0)))))
                 (_ (dk-have! (list '<= (list '* sv a) mm)
                      (lambda () (fbs-rw-goal! al0) (dk-ineq! (fbs-rw al0 q2)))))
                 (_ (dk-have! (list 'AND (list '<= 0 (list '* g rp)) (list '<= (list '* sv a) mm))
                      (lambda () (dk-conj-close! ass))))
                 (m2x (dk-cite! 'rr-le-scale-nonneg (list '* g rp) (list '* sv a) mm))
                 (_ (dk-real! (list '* (list '* g rp) mm)))
                 (_ (dk-real! (list '* gm e)))
                 (e3 (begin (dk-have! (list '= (list '* (list '* g rp) mm) (list '+ (list '* gm r) (list '* gm e)))
                                      (lambda () (crs)))
                            (list '= (list '* (list '* g rp) mm) (list '+ (list '* gm r) (list '* gm e)))))
                 (_ (dk-have! (list '<= e e) (lambda () (dk-ineq!))))
                 (_ (dk-have! (list '<= 0 e) (lambda () (dk-ineq! (list '< 0 e)))))
                 (ge (dk-apply! se e))
                 (al (fbs-names! (list (list '* dl a) (list '* xx a)
                                       (list '* (list '* g rp) (list '* sv a))
                                       (list '* (list '* g rp) mm)
                                       (list '* gm r) (list '* gm e)))))
            (fbs-rw-goal! al)
            (apply dk-ineq! (fbs-seq-map (lambda (f) (fbs-rw al f))
                                         (list m1x e1 m2x e3 ge))))))))
  (dk-cite! 'rr-le-of-le-add-all-pos (list '* dl a) (list '* gm r))
  ;; a <= ck r: scale dl a <= gm r by recip(dl)
  (dk-have! (list '<= 0 rd) (lambda () (dk-ineq! (list '< 0 rd))))
  (dk-have! (list 'AND (list '<= 0 rd) (list '<= (list '* dl a) (list '* gm r)))
            (lambda () (dk-conj-close! ass)))
  (let* ((sc (dk-cite! 'rr-le-scale-nonneg rd (list '* dl a) (list '* gm r)))
         (e1 (list '= (list '* rd (list '* dl a)) (list '* a (list '* dl rd))))
         (e2 (list '= (list '* rd (list '* gm r)) (list '* ck r))))
    (dk-have! e1 (lambda () (dk-crs-opaque!)))
    (dk-have! e2 (lambda () (dk-crs-opaque!)))
    (let* ((sc1 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! sc (cadr e1) (caddr e1)) (cadr e2) (caddr e2))
                               (list '* dl rd) 1))
           (_ (dk-real! (list '* a 1)))
           (al (fbs-names! (list (list '* ck r)))))
      (fbs-rw-goal! al)
      (dk-ineq! (fbs-rw al sc1)))))
(qed 'fbs-ball-bound)

;;; ---- the uniform ball: one prefix ball on which every T_i is bounded --------

(define fbs-cont-all '(FORALL i (IMPLIES (IN i ix) (IS-CONT-LIN m1 fam1 m2 fam2 (tf i)))))
(define (fbs-bs-hyps2 body)
  (forall-guarded '(fld m1 fam1 m2 fam2 ix tf)
    (list '(IS-FRECHET-STRUCTURE fld m1 fam1) '(IS-SEMINORM-FAMILY fld m2 fam2)
          '(IN tf (FUN ix (FUN (VEC m1) (VEC m2)))) fbs-cont-all fbs-pbdd)
    body))
(define fbs-uniform-body
  '(FORALL k (IMPLIES (IN k NN) (FORSOME nb (AND (IN nb NN) (FORSOME dl (AND (POS-RR dl)
     (FORSOME mm (AND (POS-RR mm)
       (FORALL i (IMPLIES (IN i ix) (FORALL x (IMPLIES (IN x (VEC m1))
         (IMPLIES (FORALL j (IMPLIES (IN j NN) (IMPLIES (<= j nb) (< ((fam1 j) x) dl))))
                  (<= ((fam2 k) ((tf i) x)) mm)))))))))))))))

(sp (make-wff (fbs-bs-hyps2 fbs-uniform-body)))
(let* ((ls (dk-peel!))
       (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) ls)))
       (pb (or (dk-ctx-form fbs-pbdd) (error "fbs-uniform-ball: no pointwise bound")))
       (clh (or (dk-ctx-form fbs-cont-all) (error "fbs-uniform-ball: no continuity")))
       (_ (dk-project! '(IS-SEMINORM-FAMILY fld m1 fam1)
            (lambda () (mac-h 'is-frechet-structure '(IS-FRECHET-STRUCTURE fld m1 fam1)))))
       (_ (begin
            (dk-cite! 'frm-fam-module 'fld 'm1 'fam1)
            (dk-cite! 'frm-fam-module 'fld 'm2 'fam2)
            (dk-cite! 'frm-fam-type 'fld 'm1 'fam1)
            (dk-cite! 'frm-fam-type 'fld 'm2 'fam2)
            (dk-cite! 'frm-metric-space-is-metric-space 'fld 'm1 'fam1)
            (dk-cite! 'frm-metric-space-pts 'fld 'm1 'fam1)
            (dk-cite! 'nn-is-set)))
       (bb (dk-apply! (dk-cite! 'fbs-baire-ball 'fld 'm1 'fam1 'm2 'fam2 'ix 'tf) k))
       (n (dk-skolem! bb))
       (x0 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'BALL))) "the centre")))
       (rad (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'BALL))) "the radius")))
       (ball (list 'BALL fbs-fx x0 rad))
       (sub (dk-pick (lambda (f) (and (dk-head-is? f 'SUBSET) (dk-contains? f rad))) "the ball in the closure"))
       (clos (caddr sub))
       (_ (dk-cite! 'rr-pos-rr-in-rr rad))
       (r2 (dk-halve! rad))
       (nb (dk-skolem! (dk-apply! (dk-cite! 'frm-seminorm-ball 'fld 'm1 'fam1) r2)))
       (dl (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f nb))) "the dl existential")))
       (ub (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f dl) (dk-contains? f 'DIST)))
                    "the prefix-ball universal"))
       ;; the orbit of x0 is bounded in fam2(k)
       (bh (dk-apply! pb x0))
       (_ (dk-split-all! (dk-landed (lambda () (mac-h 'is-fr-bounded bh)))))
       (bu (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'FORSOME) (dk-contains? f x0)
                                     (dk-contains? f 'SEP)))
                    "the bound clause"))
       (bd (dk-skolem! (dk-apply! bu k)))
       (yu (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f bd))) "the bound universal"))
       (nn (dk-skolem! (dk-cite! 'nn-unbounded-in-rr bd)))
       (mm (list '+ (list '+ n nn) 1)))
  (dk-cite! 'nn-in-rr n) (dk-cite! 'nn-in-rr nn)
  (dk-cite! 'nn-zero-le n) (dk-cite! 'nn-zero-le nn)
  (dk-real! mm)
  (dk-have! (list '< 0 mm) (lambda () (dk-ineq! (list '<= 0 n) (list '<= 0 nn))))
  (dk-cite! 'rr-pos-rr-of-lt mm)
  (dk-cite! 'rr-pos-rr-in-rr r2) (dk-cite! 'rr-lt-of-pos-rr r2)
  (fbs-ew-chain! (list nb dl mm))
  ;; the remaining leaf: the universal over i and x
  (let* ((ls2 (dk-peel!))
         (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'ix))) ls2)))
         (w (cadr (find-first (fbs-in-vec? 'm1) ls2)))
         (hp (find-first (dk-head? 'FORALL) ls2))
         (ti (list 'tf i))
         (q (list 'fam2 k)))
    (fbs-ty! (fbs-add 'm1 w x0) '(VEC m1))
    (let* ((v (dk-name! (fbs-add 'm1 w x0) '(VEC m1)))
           (e1 (dk-cite! 'fbs-v-add-sub 'm1 w x0))
           (e2 (dk-rewrite-h! e1 (fbs-add 'm1 w x0) v))         ; v - x0 = w
           (vx (fbs-sub 'm1 v x0)))
      (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'IMPLIES (list '<= 'j nb)
                  (list '< (list '(fam1 j) vx) dl))))
        (lambda ()
          (let ((j (cadr (car (dk-peel!)))))
            (subst e2)
            (dk-apply! hp j)
            (ass))))
      (let* ((dv (dk-apply! ub v x0))                           ; D(v, x0) <= r2
             (_ (dk-rewrite-h! (list 'IN v '(VEC m1)) '(VEC m1) (list 'PTS fbs-fx)))
             (_ (dk-rewrite-h! (list 'IN x0 '(VEC m1)) '(VEC m1) (list 'PTS fbs-fx)))
             (sy (dk-cite! 'metric-sym fbs-fx v x0))
             (_ (dk-cite! 'metric-dist-real fbs-fx v x0))
             (_ (dk-cite! 'metric-dist-real fbs-fx x0 v))
             (dvv (list (list 'DIST fbs-fx) x0 v)))
        (dk-have! (list 'IN v ball)
          (lambda ()
            (mac 'ball-membership)
            (dk-conj-close!
              (lambda ()
                (let ((gl (dk-goal)))
                  (cond
                   ((dk-asm? gl) (ass))
                   ((dk-head-is? gl '<=) (dk-ineq! dv sy (list '= (list '+ r2 r2) rad) (list '< 0 r2)))
                   (#t (di) (dk-absurd! (list '= dvv rad) dv sy (list '= (list '+ r2 r2) rad) (list '< 0 r2)))))))))
        (dk-cite! 'subset-mem-fwd ball clos v)
        (let* ((cb (dk-apply! (dk-cite! 'fbs-closure-bound 'fld 'm1 'fam1 'm2 'fam2 'ix 'tf k n v) i))  ; q(T_i v) <= n
               (_ (fbs-in-orbit! i x0))
               (yb (dk-apply! yu (list ti x0)))                  ; q(T_i x0) <= bd
               (_ (dk-apply! clh i))
               (_ (dk-project! (list 'IS-LINEAR-MAP 'm1 'm2 ti)
                    (lambda () (mac-h 'is-cont-lin (list 'IS-CONT-LIN 'm1 'fam1 'm2 'fam2 ti)))))
               (tv (list ti v)) (tx0 (list ti x0))
               (_ (begin (fbs-ty! tv '(VEC m2)) (fbs-ty! tx0 '(VEC m2)) (fbs-ty! (fbs-neg 'm2 tx0) '(VEC m2))))
               (ls (dk-cite! 'frm-linear-sub 'm1 'm2 ti v x0)))
          (subst (list '= w vx))
          (subst ls)
          (fbs-sn! 'm2 'fam2 k)
          (let* ((sa (dk-apply! (dk-cite! 'frm-sn-subadd 'fld 'm2 q) tv (fbs-neg 'm2 tx0)))
                 (sn (dk-apply! (dk-cite! 'frm-sn-neg 'fld 'm2 q) tx0)))
            (fbs-real! (list q (fbs-sub 'm2 tv tx0)))
            (fbs-real! (list q tv)) (fbs-real! (list q tx0)) (fbs-real! (list q (fbs-neg 'm2 tx0)))
            (dk-ineq! sa sn cb yb (list '< bd nn))))))))
(qed 'fbs-uniform-ball)

;;; =====================================================================
;;; THM 8.32 (Banach-Steinhaus bis).  E Frechet, F with a countable separating
;;; family of seminorms, {T_i} continuous linear maps E -> F, each orbit
;;; {T_i x : i in ix} bounded in F  =>  {T_i} is equicontinuous.
;;; =====================================================================

(sp (make-wff (forall-guarded '(fld m1 fam1 m2 fam2 ix tf)
  (list '(IS-NONTRIVIALLY-VALUED fld) '(IS-FRECHET-STRUCTURE fld m1 fam1) '(IS-SEMINORM-FAMILY fld m2 fam2)
        '(IN tf (FUN ix (FUN (VEC m1) (VEC m2)))) fbs-cont-all fbs-pbdd)
  '(IS-FR-EQUICONT m1 fam1 m2 fam2 ix tf))))
(dk-peel!)
(dk-project! '(IS-SEMINORM-FAMILY fld m1 fam1)
  (lambda () (mac-h 'is-frechet-structure '(IS-FRECHET-STRUCTURE fld m1 fam1))))
(dk-cite! 'frm-fam-field 'fld 'm1 'fam1)
(let* ((clh (dk-ctx-form fbs-cont-all))
       (ub (dk-cite! 'fbs-uniform-ball 'fld 'm1 'fam1 'm2 'fam2 'ix 'tf))
       (_ (dk-split-all! (dk-landed (lambda () (mac-h 'is-nontrivially-valued '(IS-NONTRIVIALLY-VALUED fld))))))
       (c (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'FNRM))) "the scalar c")))
       (b (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'MUL))) "its inverse")))
       (g (list '(FNRM fld) c)))
  (dk-cite! 'nf-norm-in-rr 'fld c)
  (dk-have! (list '< 0 g) (lambda () (dk-ineq! (list '< 1 g))))
  (mac 'is-fr-equicont)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (let* ((k (cadr (car (dk-peel!))))
                 (nb (dk-skolem! (dk-apply! ub k)))
                 (dl (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f nb))) "dl")))
                 (mm (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f dl))) "mm")))
                 (hb (fbs-pick-forall-with mm "the uniform ball bound"))
                 (gm (list '* g mm)) (rd (list 'recip dl)) (ck (list '* gm rd)))
            (dk-cite! 'rr-pos-rr-in-rr dl) (dk-cite! 'rr-lt-of-pos-rr dl)
            (dk-cite! 'rr-pos-rr-in-rr mm) (dk-cite! 'rr-lt-of-pos-rr mm)
            (dk-have! (list 'NOT (list '= dl 0)) (lambda () (di) (dk-absurd! (list '= dl 0) (list '< 0 dl))))
            (dk-have! (list 'AND (list 'IN dl 'RR) (list 'NOT (list '= dl 0))) (lambda () (dk-conj-close! ass)))
            (dk-cite! 'rr-recip-closed dl)
            (dk-cite! 'rr-recip-pos dl)
            (dk-real! gm)
            (dk-cite! 'rr-mul-pos g mm)
            (dk-cite! 'rr-mul-pos gm rd)
            (dk-real! ck)
            (dk-cite! 'rr-pos-rr-of-lt ck)
            (fbs-ew-chain! (list nb ck))
            (let* ((ls (dk-peel!))
                   (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'ix))) ls)))
                   (x (cadr (find-first (fbs-in-vec? 'm1) ls)))
                   (r (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'RR))) ls)))
                   (ti (list 'tf i)))
              (dk-apply! hb i)
              (dk-apply! clh i)
              (dk-project! (list 'IS-LINEAR-MAP 'm1 'm2 ti)
                (lambda () (mac-h 'is-cont-lin (list 'IS-CONT-LIN 'm1 'fam1 'm2 'fam2 ti))))
              (let ((bnd (dk-cite! 'fbs-ball-bound 'fld 'm1 'fam1 'm2 'fam2 ti c b k nb dl mm)))
                (dk-apply! bnd x r)
                (ass))))))))
(qed 'frechet-banach-steinhaus)

(for-each (lambda (n) (topic! n 'analysis))
  '(closed-graph-theorem frechet-banach-steinhaus fbs-conv-dom fbs-cauchy-dom fbs-conv-sum
    fbs-graph-fam-exists fbs-graph-seminorm fbs-graph-family fbs-graph-frechet fbs-id-linear
    fbs-baire-ball fbs-v-sub-add fbs-v-add-sub fbs-q-cont fbs-closure-bound fbs-ball-bound
    fbs-uniform-ball))
