;;; ba-trace-dual.scm -- BA-1117-TRACE, 2026-11-17.  BanachAlgebras.pdf ch. 5 s.6-s.8: the trace
;;; functional tau_S (Def 5.25), its adjoint (Prop 5.32), self-adjoint and positive trace functionals
;;; (Prop 5.33), the module structure of L_*(H) (eqs. 145-146), and the trace of a rank-one operator.
;;; Vocabulary: structure-library/ba-trace-dual-vocab.scm (TAU-OP, FUNCTIONAL-STAR,
;;; IS-SELF-ADJOINT-FUNCTIONAL, IS-POSITIVE-FUNCTIONAL).
;;; LOAD WINDOW: after theorem-library/ba-trace-class (load.scm 4472: trace-class-comp-left,
;;; op-trace-comm-bounded, op-trace-adjoint, trace-pairing-nondeg-*), hs-inner-product-3,
;;; th3a4-spectral (sa-eigen-onb), hs-compact (hs-op-compact), hilbert-schmidt (trace-abs-summable),
;;; ba-bh (op-adjoint-*), and after structure-library/ba-trace-dual-vocab.
;;; Library: operator-algebras.  Helper prefix tdu-.
;;; LOAD WINDOW: after theorem-library/hs-inner-product-3 (load.scm 4447: hs-ip-self,
;;; trace-class-comp, op-trace-scale), hilbert-schmidt (4293), th3-eigen-normalized /
;;; th3a4-spectral (sa-eigen-expansion), cc-sums-ptwise (4444), ba-bh (op-adjoint-*).
;;; Library: operator-algebras.  Helper prefix tdu-.
;;; ---- helpers copied from hs-inner-product-3.scm (tb2- renamed tdu-) ----
(define (tdu-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (tdu-and! . ps)
  (let ((f (let build ((l ps)) (if (null? (cdr l)) (car l) (list 'AND (car l) (build (cdr l)))))))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (tdu-cite! thm . args)
  (let loop ((r (apply dk-cite! thm args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (if (dk-asm? (caddr r))
            (loop (caddr r))
            (loop (dk-landed-1 (lambda () (detach! r)))))
        r)))
(define (tdu-close!)
  (cond ((not (tdu-open?)) #t)
        ((dk-asm? (dk-goal)) (ass))
        ((dk-head-is? (dk-goal) '==) (qrfl))
        (#t (rfl))))
(define (tdu-ap! f a b x) (if (not (dk-asm? (list 'IN (list f x) b))) (fact 'fun-apply-type-c f a b x)))
(define (tdu-dom! f dd cod)
  (if (not (dk-asm? (list 'IN dd 'SET))) (fact 'fun-domain-in-set dd cod f))
  (if (not (dk-asm? (list '= (list 'DOM f) dd)))
      (begin
        (dk-project! (list 'IN f (list 'FUN dd)) 'fun-codomain-iff (list 'IN f (list 'FUN dd cod)))
        (tdu-and! (list 'IN f (list 'FUN dd)) (list 'IN dd 'SET))
        (fact 'dom-of-fun dd f)
        (let ((x (dk-ctx-form (list 'AND (list 'IN (list 'DOM f) 'SET) (list '= (list 'DOM f) dd)))))
          (if x (dk-split-all! (list x))))))
  (if (not (dk-asm? (list 'IN f (list 'FUN (list 'DOM f) cod))))
      (dk-have! (list 'IN f (list 'FUN (list 'DOM f) cod))
        (lambda () (subst (list '= (list 'DOM f) dd)) (ass)))))
(define (tdu-cc! t)
  (cond ((dk-asm? (list 'IN t 'CC)) #t)
        ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
         (tdu-cc! (cadr t)) (tdu-cc! (caddr t))
         (tdu-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC))
         (fact (if (eq? (car t) '+) 'cc-add-closed 'cc-mul-closed) (cadr t) (caddr t)))
        ((and (pair? t) (eq? (car t) 'conjugate))
         (tdu-cc! (cadr t)) (fact 'cc-conjugate-closed (cadr t)))
        ((and (pair? t) (eq? (car t) '-) (= (length t) 2))
         (tdu-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)))
        ((dk-asm? (list 'IN t 'RR)) (fact 'rr-subset-cc t))
        (#t (error "tdu-cc!: cannot type in CC" (expression->string t)))))
(define (tdu-nag!)
  (if (not (dk-asm? '(IS-NORMED-AG CC-NAG))) (fact 'cc-nag-is-normed-ag))
  (if (not (dk-asm? '(== (CARR CC-NAG) CC))) (fact 'cc-nag@carr)))
(define (tdu-carr! form)          ; form mentions CC where CARR CC-NAG is wanted, given as the target
  (if (not (dk-asm? form))
      (dk-have! form (lambda () (subst '(= (CARR CC-NAG) CC)) (tdu-close!)))))
(define (tdu-pw dd h body-of)
  (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ dd) (list '= (list h 'z_) (body-of 'z_)))))
(define (tdu-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; tdu: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l) (display ";;   ") (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'analysis))
(define (tdu-ns w y) (list '* (list 'IP-NORM w y) (list 'IP-NORM w y)))
(define (tdu-lam-ns w ix e t) (list 'VNB-LAMBDA 'kqk_ ix (tdu-ns w (list t (list e 'kqk_)))))
(define (tdu-Q w ix e s t) (list 'VNB-LAMBDA 'kqk_ ix (list (list 'IP w) (list s (list e 'kqk_)) (list t (list e 'kqk_)))))
(define (tdu-qsum w ix e s t) (list 'CC-FAMILY-SUM (tdu-Q w ix e s t)))
(define (tdu-onb! v ix e)
  (let ((onb (list 'IS-ORTHONORMAL-BASIS v ix e))
        (onf (list 'IS-ORTHONORMAL-FAMILY v ix e)))
    (if (not (dk-asm? onf)) (dk-project! onf 'is-orthonormal-basis onb))
    (if (not (dk-asm? (list 'IN e (list 'FUN ix (list 'VEC v)))))
        (dk-project! (list 'IN e (list 'FUN ix (list 'VEC v))) 'is-orthonormal-family onf))
    (if (not (dk-asm? (list 'IN ix 'SET))) (fact 'fun-domain-in-set ix (list 'VEC v) e))))
(define (tdu-hs-bounded! v w t)
  (let ((bx (list 'IN t (list 'BOUNDED-OPS v w))))
    (if (not (dk-asm? bx))
        (dk-have! bx (lambda () (dk-project! bx 'IS-HILBERT-SCHMIDT (list 'IS-HILBERT-SCHMIDT v w t)))))
    (if (not (dk-asm? (list 'IN t (list 'FUN (list 'VEC v) (list 'VEC w))))) (fact 'bop-fun v w t))))
(define (tdu-pt! v w ix e ts k)
  (tdu-ap! e ix (list 'VEC v) k)
  (for-each (lambda (t) (tdu-ap! t (list 'VEC v) (list 'VEC w) (list e k))) ts))
(define (tdu-ns-type! w y)
  (let ((n (list 'IP-NORM w y)))
    (if (not (dk-asm? (list 'IN n 'RR))) (fact 'ip-norm-in-rr w y))
    (if (not (dk-asm? (list '<= 0 n))) (fact 'ip-norm-nonneg w y))
    (if (not (dk-asm? (list 'IN (tdu-ns w y) 'RR)))
        (begin (tdu-and! (list 'IN n 'RR) (list 'IN n 'RR)) (fact 'rr-mul-closed n n)))
    (if (not (dk-asm? (list '<= 0 (tdu-ns w y)))) (fact 'rr-sq-nonneg n))))
(define (tdu-nn-univ L ix) (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ ix) (list '<= 0 (list L 'z_)))))
(define (tdu-ns-fam! v w ix e t)
  (let ((L (tdu-lam-ns w ix e t)))
    
    (if (not (dk-asm? (list 'IN L (list 'FUN ix 'RR))))
        (dk-have! (list 'IN L (list 'FUN ix 'RR))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (tdu-pt! v w ix e (list t) k)
                  (tdu-ns-type! w (list t (list e k)))
                  (tdu-close!)))
              (lambda () (ass))))))
    
    (if (not (dk-asm? (list 'IN L (list 'FUN ix 'CC))))
        (dk-have! (list 'IN L (list 'FUN ix 'CC))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (tdu-pt! v w ix e (list t) k)
                  (tdu-ns-type! w (list t (list e k)))
                  (tdu-cc! (tdu-ns w (list t (list e k))))
                  (tdu-close!)))
              (lambda () (ass))))))
    
    (if (not (dk-asm? (tdu-nn-univ L ix)))
        (dk-have! (tdu-nn-univ L ix)
          (lambda ()
            (let ((k (dk-di-var!)))
              (tdu-pt! v w ix e (list t) k)
              (tdu-ns-type! w (list t (list e k)))
              (dk-lam-b!)
              (tdu-close!)))))
    
    (if (and (dk-asm? (list 'IS-HILBERT-SCHMIDT v w t)) (not (dk-asm? (list 'IN (list 'ESUM L) 'RR))))
        (let* ((r (tdu-cite! 'hs-sum-real-any-basis v w t ix e))
               (u (dk-cite! 'hs-sum-unfold v w ix e t)))
          (dk-rewrite-h! r (cadr u) (caddr u))))
    L))
(define (tdu-ns-sums! L ix)
  (tdu-dom! L ix 'RR)
  (let ((nn (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ (list 'DOM L)) (list '<= 0 (list L 'z_))))))
    (if (not (dk-asm? nn))
        (dk-have! nn (lambda () (subst (list '= (list 'DOM L) ix)) (tdu-close!)))))
  (tdu-cite! 'esum-sums-to-cc L))
(define (tdu-fin!)
  (cond ((not (tdu-open?)) #t)
        ((dk-asm? (dk-goal)) (ass))
        (#t (dk-lam-b!) (tdu-close!))))
(define (tdu-vty! v w ops y)
  (for-each (lambda (op) (tdu-ap! op (list 'VEC v) (list 'VEC w) y)) ops))
(define (tdu-ipty! w a b)
  (if (not (dk-asm? (list 'IN (list (list 'IP w) a b) 'CC))) (fact 'cips-ip-type w a b)))
(define (tdu-qfam-type! v w ix e s t)
  (let ((fam (tdu-Q w ix e s t)))
    (if (not (dk-asm? (list 'IN fam (list 'FUN ix 'CC))))
        (dk-have! (list 'IN fam (list 'FUN ix 'CC))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (tdu-ap! e ix (list 'VEC v) k)
                  (tdu-vty! v w (list s t) (list e k))
                  (tdu-ipty! w (list s (list e k)) (list t (list e k)))
                  (tdu-fin!)))
              (lambda () (ass))))))
    fam))
(define (tdu-one!)
  (if (not (dk-asm? '(IN 1 RR))) (dk-have! '(IN 1 RR) (lambda () (arith))))
  (tdu-cc! 1))
(define (tdu-qcc! v w s t ix e)
  (let ((qq (tdu-qsum w ix e s t)))
    (if (not (dk-asm? (list 'IN qq 'CC)))
        (dk-split-all! (list (tdu-cite! 'hs-ip-family-sums v w s t ix e))))
    (tdu-cc! (list 'conjugate qq))
    qq))
(define (tdu-cb-pt! v cl k)
  (let ((cb (caddr cl)))
    (tdu-ap! cl cb (list 'VEC v) k)
    (if (not (dk-asm? (list '= (list cl k) k)))
        (dk-have! (list '= (list cl k) k) (lambda () (dk-lam-b!) (tdu-close!))))
    (if (not (dk-asm? (list 'IN k (list 'VEC v))))
        (dk-rewrite-h! (list 'IN (list cl k) (list 'VEC v)) (list cl k) k))))
(define (tdu-tr v ix e t)
  (list 'VNB-LAMBDA 'kqk_ ix (list (list 'IP v) (list t (list e 'kqk_)) (list e 'kqk_))))
(define (tdu-tr-type! v ix e t)
  (let ((fam (tdu-tr v ix e t)))
    (if (not (dk-asm? (list 'IN fam (list 'FUN ix 'CC))))
        (dk-have! (list 'IN fam (list 'FUN ix 'CC))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (tdu-ap! e ix (list 'VEC v) k)
                  (tdu-vty! v v (list t) (list e k))
                  (tdu-ipty! v (list t (list e k)) (list e k))
                  (tdu-fin!)))
              (lambda () (ass))))))
    fam))
(define (tdu-canon! v)
  (let* ((cb (list 'CANON-ONB v)) (cl (list 'VNB-LAMBDA 'kqe_ cb 'kqe_)))
    (if (not (dk-asm? (list 'IS-ORTHONORMAL-BASIS v cb cl))) (fact 'canon-onb-is-onb v))
    (tdu-onb! v cb cl)
    (cons cb cl)))
(define (tdu-unique! fam dd r1 r2)
  (tdu-nag!)
  (tdu-dom! fam dd 'CC)
  (tdu-carr! (list 'IN fam (list 'FUN (list 'DOM fam) '(CARR CC-NAG))))
  (tdu-carr! (list 'IN r1 '(CARR CC-NAG)))
  (tdu-carr! (list 'IN r2 '(CARR CC-NAG)))
  (tdu-and! (list 'SUMS-TO 'CC-NAG fam r1) (list 'SUMS-TO 'CC-NAG fam r2))
  (tdu-cite! 'sums-to-unique 'CC-NAG fam r1 r2))
;;; ---- end of copied helpers ----

;;; ---- local helpers ----
(define (tdu-dbg tag) (display ";; TDU ") (display tag) (display " ") (display (expression->string (dk-goal))) (newline))
(define (tdu-some-onb! v)
  (let* ((ex (tdu-cite! 'onb-exists v))
         (ixv (dk-skolem! ex #t))
         (ex2 (dk-pick (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q ixv))) "the ONB family"))
         (ev (dk-skolem! ex2 #t)))
    (tdu-onb! v ixv ev)
    (cons ixv ev)))

;;; the existential half of IS-TRACE-CLASS(v, t), read off the definition
(define (tdu-tc-ex t)
  (list 'FORSOME 'kqa_ (list 'AND '(IS-HILBERT-SCHMIDT v v kqa_)
     (list 'FORSOME 'kqb_ (list 'AND '(IS-HILBERT-SCHMIDT v v kqb_) (list '= t '(BOP-COMP v kqa_ kqb_)))))))
;;; IS-TRACE-CLASS(v, t) in context (kept): skolemise T = A B; returns (a . b) with
;;; IS-HILBERT-SCHMIDT of both, both bounded and in FUN, and (= t (BOP-COMP v a b)) landed
(define (tdu-open-tc! t)
  (let ((tc (list 'IS-TRACE-CLASS 'v t))
        (bx (list 'IN t '(BOUNDED-OPS v v)))
        (ex (tdu-tc-ex t)))
    (if (not (dk-asm? bx)) (dk-project! bx 'is-trace-class tc))
    (if (not (dk-asm? ex)) (dk-project! ex 'is-trace-class tc))
    (let* ((a (dk-skolem! (or (dk-ctx-form ex) ex) #t))
           (ex2 (dk-pick (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q a)
                                          (dk-contains? q 'BOP-COMP)))
                         "the factor B"))
           (b (dk-skolem! ex2 #t)))
      (tdu-hs-bounded! 'v 'v a)
      (tdu-hs-bounded! 'v 'v b)
      (cons a b))))
(define (tdu-comp x y) (list 'BOP-COMP 'v x y))
(define (tdu-adj x) (list 'OP-ADJOINT 'v 'v x))
(define (tdu-bdd! x)
  (if (not (dk-asm? (list 'IN x '(BOUNDED-OPS v v))))
      (error "tdu-bdd!: not typed bounded" (expression->string x)))
  (if (not (dk-asm? (list 'IN x '(FUN (VEC v) (VEC v))))) (fact 'bop-fun 'v 'v x)))
(define (tdu-comp-bdd! x y)
  (let ((c (tdu-comp x y)))
    (if (not (dk-asm? (list 'IN c '(BOUNDED-OPS v v)))) (tdu-cite! 'bop-comp-bounded 'v x y))
    (tdu-bdd! c)
    c))
(define (tdu-adj-bdd! x)
  (let ((c (tdu-adj x)))
    (if (not (dk-asm? (list 'IN c '(BOUNDED-OPS v v)))) (tdu-cite! 'op-adjoint-bounded 'v 'v x))
    (tdu-bdd! c)
    c))

;;; ---- end of copied helpers ----

;;; ---- local helpers ----
(define (tdu-ip v a b) (list (list 'IP v) a b))
;;; a family k |-> F(k) over ix typed in FUN(ix, CC) by a pointwise typer (typer! k) that lands (IN (F k) CC)
(define (tdu-fam-type! fam ix typer!)
  (if (not (dk-asm? (list 'IN fam (list 'FUN ix 'CC))))
      (dk-have! (list 'IN fam (list 'FUN ix 'CC))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let ((k (dk-di-var!)))
                (typer! k)
                (tdu-fin!)))
            (lambda () (ass))))))
  fam)
;;; op-trace of a trace-class operator typed in CC (canonical basis)
(define (tdu-tr-cc! t)
  (let* ((cc_ (tdu-canon! 'v)) (cb (car cc_)) (cl (cdr cc_)))
    (if (not (dk-asm? (list 'IN (list 'OP-TRACE 'v t) 'CC)))
        (dk-split-all! (list (tdu-cite! 'op-trace-sums 'v t cb cl))))))

;;; ====================================================================
;;; unfolds
;;; ====================================================================
(sp (make-wff '(FORALL tdv_ (FORALL tds_ (== (TAU-OP tdv_ tds_)
   (VNB-LAMBDA tda_ (BOUNDED-OPS tdv_ tdv_) (OP-TRACE tdv_ (BOP-COMP tdv_ tda_ tds_))))))))
(di) (mac 'TAU-OP) (qrfl)
(tdu-done! 'tau-op-unfold)

(sp (make-wff '(FORALL tdv_ (FORALL tdf_ (== (FUNCTIONAL-STAR tdv_ tdf_)
   (VNB-LAMBDA tda_ (BOUNDED-OPS tdv_ tdv_) (conjugate (tdf_ (OP-ADJOINT tdv_ tdv_ tda_)))))))))
(di) (mac 'FUNCTIONAL-STAR) (qrfl)
(tdu-done! 'functional-star-unfold)

;;; ====================================================================
;;; tau-op-apply (Def 5.25): tau_S(A) = tr(A S)
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_ a_) '((IS-TRACE-CLASS v s_) (IN a_ (BOUNDED-OPS v v)))
      '(= ((TAU-OP v s_) a_) (OP-TRACE v (BOP-COMP v a_ s_)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tdu-cite! 'trace-class-comp-left 'v 'a_ 's_)
(tdu-tr-cc! '(BOP-COMP v a_ s_))
(subst (dk-cite! 'tau-op-unfold 'v 's_))
(dk-lam-b!)
(tdu-close!)
(tdu-done! 'tau-op-apply)

;;; ====================================================================
;;; op-trace-rank-one: tr(x |-> <x|a> c) = <c|a>
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(a_ c_) '((IN a_ (VEC v)) (IN c_ (VEC v)))
      '(= (OP-TRACE v (RANK-ONE-OP v v a_ c_)) ((IP v) c_ a_))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tdu-nag!)
(tdu-one!)
(let* ((r '(RANK-ONE-OP v v a_ c_))
       (cc_ (tdu-canon! 'v)) (cb (car cc_)) (cl (cdr cc_))
       (ca (tdu-ip 'v 'c_ 'a_)))
  (tdu-cite! 'rank-one-op-hs 'v 'a_ 'c_)
  (tdu-hs-bounded! 'v 'v r)
  (subst (dk-cite! 'op-trace-canon 'v r))
  (tdu-ipty! 'v 'c_ 'a_)
  (let* ((ex (tdu-cite! 'onb-inner-product-expansion 'v cb cl 'c_ 'a_))
         (f (caddr ex))
         (h (tdu-tr-type! 'v cb cl r)))
    (tdu-fam-type! f cb
      (lambda (k)
        (tdu-ap! cl cb '(VEC v) k)
        (tdu-ipty! 'v 'c_ (list cl k)) (tdu-ipty! 'v (list cl k) 'a_)
        (tdu-cc! (list '* (tdu-ip 'v 'c_ (list cl k)) (tdu-ip 'v (list cl k) 'a_)))))
    (dk-have! (tdu-pw cb h (lambda (z) (list '* 1 (list f z))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (tdu-cb-pt! 'v cl z)
          (dk-lam-b!)
          (if (dk-contains? (dk-goal) (list cl z)) (subst (list '= (list cl z) z)))
          (tdu-ipty! 'v z 'a_)
          (subst (dk-cite! 'rank-one-op-unfold 'v 'v 'a_ 'c_))
          (dk-lam-b!)
          (tdu-ipty! 'v 'c_ z)
          (subst (tdu-cite! 'cips-ip-homog-left 'v (tdu-ip 'v z 'a_) 'c_ z))
          (crs))))
    (tdu-cite! 'cc-sums-to-scale-ptwise cb 1 f h ca)
    (tdu-cc! (list '* 1 ca))
    (tdu-dom! h cb 'CC)
    (subst (tdu-cite! 'cc-family-sum-value h (list '* 1 ca)))
    (crs)))
(tdu-done! 'op-trace-rank-one)

;;; ====================================================================
;;; tau-op-type: tau_S in FUN(L(H), CC)
;;; ====================================================================
(define (tdu-tc-bdd! s)
  (let ((bx (list 'IN s '(BOUNDED-OPS v v))))
    (if (not (dk-asm? bx)) (dk-project! bx 'is-trace-class (list 'IS-TRACE-CLASS 'v s)))
    (tdu-bdd! s)))
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_) '((IS-TRACE-CLASS v s_))
      '(IN (TAU-OP v s_) (FUN (BOUNDED-OPS v v) CC))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(subst (dk-cite! 'tau-op-unfold 'v 's_))
(dk-lam-type!
  (lambda ()
    (let ((a (dk-di-var!)))
      (tdu-cite! 'trace-class-comp-left 'v a 's_)
      (tdu-tr-cc! (tdu-comp a 's_))
      (tdu-fin!)))
  (lambda () (fact 'bounded-ops-is-set 'v 'v) (tdu-close!)))
(tdu-done! 'tau-op-type)

;;; ====================================================================
;;; tau-op-star (Prop 5.32): conj tau_S(A*) = tau_{S*}(A), i.e. (tau_S)* = tau_{S*}
;;; ====================================================================
(define (tdu-adj2! a)          ; lands (= (OP-ADJOINT v v (OP-ADJOINT v v a)) a), a bounded
  (let* ((aa (tdu-adj (tdu-adj a))) (goal (list '= aa a)))
    (if (not (dk-asm? goal))
        (let* ((vv (tdu-cite! 'bh-vstar-vstar 'v a))
               (v1 (tdu-cite! 'bh-vstar-value 'v a))
               (v2 (tdu-cite! 'bh-vstar-value 'v (tdu-adj a))))
          (dk-have! goal
            (lambda ()
              (subst (list '= aa (list (list 'BH-VSTAR 'v) (tdu-adj a))))
              (subst (list '= (tdu-adj a) (list (list 'BH-VSTAR 'v) a)))
              (tdu-close!)))))
    goal))
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_ a_) '((IS-TRACE-CLASS v s_) (IN a_ (BOUNDED-OPS v v)))
      '(= (conjugate ((TAU-OP v s_) (OP-ADJOINT v v a_))) ((TAU-OP v (OP-ADJOINT v v s_)) a_))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tdu-bdd! 'a_)
(tdu-tc-bdd! 's_)
(let* ((as (tdu-adj-bdd! 'a_)) (ss (tdu-adj-bdd! 's_))
       (as-s (tdu-comp as 's_)) (a-ss (tdu-comp 'a_ ss)))
  (tdu-cite! 'trace-class-adjoint 'v 's_)
  (tdu-cite! 'trace-class-comp-left 'v as 's_)
  (tdu-cite! 'trace-class-comp-left 'v 'a_ ss)
  (tdu-tr-cc! as-s) (tdu-tr-cc! a-ss)
  (tdu-comp-bdd! as 's_)
  (subst (tdu-cite! 'tau-op-apply 'v 's_ as))
  (subst (tdu-cite! 'tau-op-apply 'v ss 'a_))
  (let ((e1 (tdu-cite! 'op-trace-adjoint 'v as-s)))
    (subst (list '= (caddr e1) (cadr e1))))
  (subst (tdu-cite! 'op-adjoint-comp 'v as 's_))
  (subst (tdu-adj2! 'a_))
  (subst (tdu-cite! 'op-trace-comm-bounded 'v ss 'a_))
  (tdu-close!))
(tdu-done! 'tau-op-star)

(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_ a_) '((IS-TRACE-CLASS v s_) (IN a_ (BOUNDED-OPS v v)))
      '(= ((FUNCTIONAL-STAR v (TAU-OP v s_)) a_) ((TAU-OP v (OP-ADJOINT v v s_)) a_))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tdu-bdd! 'a_)
(tdu-tc-bdd! 's_)
(tdu-adj-bdd! 'a_)
(tdu-adj-bdd! 's_)
(tdu-cite! 'trace-class-adjoint 'v 's_)
(tdu-cite! 'tau-op-type 'v 's_)
(tdu-cite! 'tau-op-type 'v (tdu-adj 's_))
(subst (dk-cite! 'functional-star-unfold 'v '(TAU-OP v s_)))
(dk-lam-b!)
(subst (tdu-cite! 'tau-op-star 'v 's_ 'a_))
(tdu-close!)
(tdu-done! 'tau-op-star-functional)

;;; ====================================================================
;;; the module structure of L_*(H) (eqs. 145-146): [S . tau_T](A) = tau_T(A S) = tau_{S T}(A),
;;; [tau_T . S](A) = tau_T(S A) = tau_{T S}(A)
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_ t_ a_) '((IN s_ (BOUNDED-OPS v v)) (IS-TRACE-CLASS v t_) (IN a_ (BOUNDED-OPS v v)))
      '(= ((TAU-OP v t_) (BOP-COMP v a_ s_)) ((TAU-OP v (BOP-COMP v s_ t_)) a_))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tdu-bdd! 'a_) (tdu-bdd! 's_) (tdu-tc-bdd! 't_)
(let* ((as (tdu-comp-bdd! 'a_ 's_)) (st (tdu-comp-bdd! 's_ 't_)))
  (tdu-cite! 'trace-class-comp-left 'v 's_ 't_)
  (tdu-cite! 'trace-class-comp-left 'v 'a_ st)
  (tdu-tr-cc! (tdu-comp 'a_ st))
  (subst (tdu-cite! 'tau-op-apply 'v 't_ as))
  (subst (tdu-cite! 'tau-op-apply 'v st 'a_))
  (subst (tdu-cite! 'bop-comp-assoc 'v 'a_ 's_ 't_))
  (tdu-close!))
(tdu-done! 'tau-op-module-right)

(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_ t_ a_) '((IN s_ (BOUNDED-OPS v v)) (IS-TRACE-CLASS v t_) (IN a_ (BOUNDED-OPS v v)))
      '(= ((TAU-OP v t_) (BOP-COMP v s_ a_)) ((TAU-OP v (BOP-COMP v t_ s_)) a_))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tdu-bdd! 'a_) (tdu-bdd! 's_) (tdu-tc-bdd! 't_)
(let* ((sa (tdu-comp-bdd! 's_ 'a_)) (ts (tdu-comp-bdd! 't_ 's_)) (at (tdu-comp-bdd! 'a_ 't_)))
  (tdu-cite! 'trace-class-comp-right 'v 's_ 't_)
  (tdu-cite! 'trace-class-comp-left 'v 'a_ 't_)
  (tdu-cite! 'trace-class-comp-left 'v 's_ at)
  (tdu-tr-cc! (tdu-comp 's_ at))
  (subst (tdu-cite! 'tau-op-apply 'v 't_ sa))
  (subst (tdu-cite! 'tau-op-apply 'v ts 'a_))
  (subst (tdu-cite! 'bop-comp-assoc 'v 's_ 'a_ 't_))
  (let ((e (tdu-cite! 'bop-comp-assoc 'v 'a_ 't_ 's_)))
    (subst (list '= (caddr e) (cadr e))))
  (subst (tdu-cite! 'op-trace-comm-bounded 'v at 's_))
  (tdu-close!))
(tdu-done! 'tau-op-module-left)

;;; ====================================================================
;;; op-trace-comp-rank-one: tr(S o (x |-> <x|a> c)) = <S c | a>, S bounded
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_ a_ c_) '((IN s_ (BOUNDED-OPS v v)) (IN a_ (VEC v)) (IN c_ (VEC v)))
      '(= (OP-TRACE v (BOP-COMP v s_ (RANK-ONE-OP v v a_ c_))) ((IP v) (s_ c_) a_))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tdu-nag!)
(tdu-one!)
(tdu-bdd! 's_)
(let* ((r '(RANK-ONE-OP v v a_ c_))
       (cc_ (tdu-canon! 'v)) (cb (car cc_)) (cl (cdr cc_))
       (sc '(s_ c_))
       (ca (tdu-ip 'v sc 'a_)))
  (tdu-cite! 'rank-one-op-hs 'v 'a_ 'c_)
  (tdu-hs-bounded! 'v 'v r)
  (let ((sr (tdu-comp-bdd! 's_ r)))
    (tdu-ap! 's_ '(VEC v) '(VEC v) 'c_)
    (subst (dk-cite! 'op-trace-canon 'v sr))
    (tdu-ipty! 'v sc 'a_)
    (let* ((ex (tdu-cite! 'onb-inner-product-expansion 'v cb cl sc 'a_))
           (f (caddr ex))
           (h (tdu-tr-type! 'v cb cl sr)))
      (tdu-fam-type! f cb
        (lambda (k)
          (tdu-ap! cl cb '(VEC v) k)
          (tdu-ipty! 'v sc (list cl k)) (tdu-ipty! 'v (list cl k) 'a_)
          (tdu-cc! (list '* (tdu-ip 'v sc (list cl k)) (tdu-ip 'v (list cl k) 'a_)))))
      (dk-have! (tdu-pw cb h (lambda (z) (list '* 1 (list f z))))
        (lambda ()
          (let ((z (dk-di-var!)))
            (tdu-cb-pt! 'v cl z)
            (dk-lam-b!)
            (if (dk-contains? (dk-goal) (list cl z)) (subst (list '= (list cl z) z)))
            (tdu-ipty! 'v z 'a_)
            (subst (tdu-cite! 'bop-comp-apply 'v 's_ r z))
            (subst (dk-cite! 'rank-one-op-unfold 'v 'v 'a_ 'c_))
            (dk-lam-b!)
            (subst (tdu-cite! 'bop-act 'v 'v 's_ (tdu-ip 'v z 'a_) 'c_))
            (tdu-ipty! 'v sc z)
            (subst (tdu-cite! 'cips-ip-homog-left 'v (tdu-ip 'v z 'a_) sc z))
            (crs))))
      (tdu-cite! 'cc-sums-to-scale-ptwise cb 1 f h ca)
      (tdu-cc! (list '* 1 ca))
      (tdu-dom! h cb 'CC)
      (subst (tdu-cite! 'cc-family-sum-value h (list '* 1 ca)))
      (crs))))
(tdu-done! 'op-trace-comp-rank-one)

;;; ====================================================================
;;; op-trace-nonneg-basis: T trace class, <T e_k | e_k> real and >= 0 on SOME orthonormal basis
;;; => tr T real and >= 0
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(t_) '((IS-TRACE-CLASS v t_))
      (forall-guarded '(ix e) '((IS-ORTHONORMAL-BASIS v ix e))
        '(IMPLIES (FORALL tdk_ (IMPLIES (IN tdk_ ix)
                    (AND (IN ((IP v) (t_ (e tdk_)) (e tdk_)) RR) (<= 0 ((IP v) (t_ (e tdk_)) (e tdk_))))))
           (AND (IN (OP-TRACE v t_) RR) (<= 0 (OP-TRACE v t_)))))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tdu-nag!)
(tdu-tc-bdd! 't_)
(tdu-onb! 'v 'ix 'e)
(let* ((hyp (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q 'tdk_))) "the basis hypothesis"))
       (g (tdu-tr 'v 'ix 'e 't_))
       (m (list 'VNB-LAMBDA 'kqk_ 'ix (list 'magnitude (tdu-ip 'v '(t_ (e kqk_)) '(e kqk_)))))
       (pt! (lambda (k)            ; lands the typing and sign of <t e_k|e_k>
              (tdu-ap! 'e 'ix '(VEC v) k)
              (tdu-vty! 'v 'v '(t_) (list 'e k))
              (tdu-ipty! 'v (list 't_ (list 'e k)) (list 'e k))
              (dk-split-all! (list (dk-apply! hyp k)))))
       (ty! (lambda (fam cls body!)
              (if (not (dk-asm? (list 'IN fam (list 'FUN 'ix cls))))
                  (dk-have! (list 'IN fam (list 'FUN 'ix cls))
                    (lambda ()
                      (dk-lam-type!
                        (lambda () (let ((k (dk-di-var!))) (pt! k) (body! k) (tdu-fin!)))
                        (lambda () (ass)))))))))
  (tdu-cite! 'trace-abs-summable 'v 't_ 'ix 'e)
  (ty! g 'RR (lambda (k) #t))
  (ty! g 'CC (lambda (k) #t))
  (ty! m 'RR (lambda (k) (fact 'cc-magnitude-closed (tdu-ip 'v (list 't_ (list 'e k)) (list 'e k)))))
  (ty! g 'RR-POS-STAR (lambda (k) (fact 'rmc-rps-of-nonneg (tdu-ip 'v (list 't_ (list 'e k)) (list 'e k)))))
  (let ((nn (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ 'ix) (list '<= 0 (list g 'z_)))))
        (le (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ 'ix) (list '<= (list g 'z_) (list m 'z_))))))
    (dk-have! nn (lambda () (let ((z (dk-di-var!))) (pt! z) (dk-lam-b!) (tdu-close!))))
    (dk-have! le (lambda ()
                   (let* ((z (dk-di-var!)) (q (tdu-ip 'v (list 't_ (list 'e z)) (list 'e z))))
                     (pt! z) (dk-lam-b!)
                     (subst (tdu-cite! 'rr-magnitude-is-abs q))
                     (subst (tdu-cite! 'rr-abs-of-nonneg q))
                     (fact 'rr-leq-reflexive q)
                     (tdu-close!))))
    (dk-split-all! (list (tdu-cite! 'esum-real-le-ptwise 'ix g m)))
    (tdu-ns-sums! g 'ix)
    (dk-split-all! (list (tdu-cite! 'op-trace-sums 'v 't_ 'ix 'e)))
    (tdu-cc! (list 'ESUM g))
    (subst (tdu-unique! g 'ix '(OP-TRACE v t_) (list 'ESUM g)))
    (tdu-dom! g 'ix 'RR-POS-STAR)
    (tdu-cite! 'esum-in g)
    (tdu-cite! 'rr-pos-star-nonneg (list 'ESUM g))
    (tdu-and! (list 'IN (list 'ESUM g) 'RR) (list '<= 0 (list 'ESUM g)))
    (tdu-close!)))
(tdu-done! 'op-trace-nonneg-basis)

;;; ---- positive operators ----
(define (tdu-pos-univ t)   ; the positivity conjunct of IS-POSITIVE-OP(v, t), projected (t stays positive)
  (let ((u (list 'FORALL 'kqx_ (list 'IMPLIES '(IN kqx_ (VEC v))
             (list 'AND (list 'IN (list '(IP v) (list t 'kqx_) 'kqx_) 'RR)
                        (list '<= 0 (list '(IP v) (list t 'kqx_) 'kqx_)))))))
    (if (not (dk-asm? u)) (dk-project! u 'is-positive-op (list 'IS-POSITIVE-OP 'v t)))
    u))
(define (tdu-pos-sa! t)    ; IS-SELF-ADJOINT-OP(v, t) and t bounded, from IS-POSITIVE-OP(v, t)
  (let ((sa (list 'IS-SELF-ADJOINT-OP 'v t)) (bx (list 'IN t '(BOUNDED-OPS v v))))
    (if (not (dk-asm? sa)) (dk-project! sa 'is-positive-op (list 'IS-POSITIVE-OP 'v t)))
    (if (not (dk-asm? bx)) (dk-project! bx 'is-self-adjoint-op sa))
    (tdu-bdd! t)))

;;; ====================================================================
;;; op-trace-positive: T positive and trace class => tr T real and >= 0
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(t_) '((IS-TRACE-CLASS v t_) (IS-POSITIVE-OP v t_))
      '(AND (IN (OP-TRACE v t_) RR) (<= 0 (OP-TRACE v t_)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(let* ((cc_ (tdu-canon! 'v)) (cb (car cc_)) (cl (cdr cc_))
       (u (tdu-pos-univ 't_))
       (pw (list 'FORALL 'tdk_ (list 'IMPLIES (list 'IN 'tdk_ cb)
             (list 'AND (list 'IN (list '(IP v) (list 't_ (list cl 'tdk_)) (list cl 'tdk_)) 'RR)
                        (list '<= 0 (list '(IP v) (list 't_ (list cl 'tdk_)) (list cl 'tdk_))))))))
  (dk-have! pw (lambda ()
                 (let ((k (dk-di-var!)))
                   (tdu-ap! cl cb '(VEC v) k)
                   (dk-apply! u (list cl k))
                   (tdu-close!))))
  (tdu-cite! 'op-trace-nonneg-basis 'v 't_ cb cl)
  (tdu-close!))
(tdu-done! 'op-trace-positive)

;;; ====================================================================
;;; tau-op-positive (Prop 5.33, S >= 0 => tau_S >= 0), through an eigenbasis of the compact S:
;;; tr(A S) = sum_k l_k <A e_k | e_k> with l_k = <S e_k | e_k> >= 0
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_) '((IS-TRACE-CLASS v s_) (IS-POSITIVE-OP v s_))
      '(IS-POSITIVE-OP-FUNCTIONAL v (TAU-OP v s_))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tdu-pos-sa! 's_)
(let ((su (tdu-pos-univ 's_)))
  (tdu-cite! 'trace-class-is-hs 'v 's_)
  (tdu-cite! 'hs-op-compact 'v 'v 's_)
  (let* ((eig (tdu-cite! 'sa-eigen-onb 'v 's_))
         (ixv (dk-skolem! eig #t))
         (ex2 (dk-pick (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q ixv))) "the eigenbasis"))
         (ev (dk-skolem! ex2 #t)))
    (dk-split-all!)
    (tdu-onb! 'v ixv ev)
    (let ((eh (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q ev) (dk-contains? q 'ACT)))
                       "the eigen equations")))
      (mac 'is-positive-op-functional)
      (let* ((landed (dk-peel!))
             (pa (car (filter (lambda (q) (and (dk-head-is? q 'IS-POSITIVE-OP) (not (equal? (caddr q) 's_))))
                              landed)))
             (a (caddr pa))
             (as (tdu-comp a 's_)))
        (tdu-pos-sa! a)
        (let ((au (tdu-pos-univ a)))
          (tdu-cite! 'trace-class-comp-left 'v a 's_)
          (tdu-tr-cc! as)
          (subst (tdu-cite! 'tau-op-apply 'v 's_ a))
          (dk-have! (list 'FORALL 'tdk_ (list 'IMPLIES (list 'IN 'tdk_ ixv)
                      (list 'AND (list 'IN (list '(IP v) (list as (list ev 'tdk_)) (list ev 'tdk_)) 'RR)
                                 (list '<= 0 (list '(IP v) (list as (list ev 'tdk_)) (list ev 'tdk_))))))
            (lambda ()
              (let* ((k (dk-di-var!)) (ek (list ev k))
                     (l (list '(IP v) (list 's_ ek) ek))
                     (m (list '(IP v) (list a ek) ek)))
                (tdu-ap! ev ixv '(VEC v) k)
                (tdu-vty! 'v 'v (list 's_ a) ek)
                (dk-split-all! (list (dk-apply! su ek)))
                (dk-split-all! (list (dk-apply! au ek)))
                (tdu-cc! l) (tdu-cc! m)
                (subst (tdu-cite! 'bop-comp-apply 'v a 's_ ek))
                (subst (dk-apply! eh k))
                (subst (tdu-cite! 'bop-act 'v 'v a l ek))
                (tdu-vty! 'v 'v (list a) ek)
                (subst (tdu-cite! 'cips-ip-homog-left 'v l (list a ek) ek))
                (tdu-and! (list 'IN l 'RR) (list 'IN m 'RR))
                (tdu-and! (list '<= 0 l) (list '<= 0 m))
                (fact 'rr-mul-closed l m)
                (fact 'rr-leq-mul-nonneg l m)
                (tdu-and! (list 'IN (list '* l m) 'RR) (list '<= 0 (list '* l m))))))
          (tdu-cite! 'op-trace-nonneg-basis 'v as ixv ev)
          (tdu-close!))))))
(tdu-done! 'tau-op-positive)

;;; ====================================================================
;;; self-adjoint operators: T* = T;  Prop 5.33 (self-adjoint part)
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(t_) '((IS-SELF-ADJOINT-OP v t_))
      '(= (OP-ADJOINT v v t_) t_)))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(let ((bx '(IN t_ (BOUNDED-OPS v v)))
      (sy '(FORALL kqx_ (IMPLIES (IN kqx_ (VEC v)) (FORALL kqy_ (IMPLIES (IN kqy_ (VEC v))
             (= ((IP v) (t_ kqx_) kqy_) ((IP v) kqx_ (t_ kqy_)))))))))
  (dk-project! bx 'is-self-adjoint-op '(IS-SELF-ADJOINT-OP v t_))
  (dk-project! sy 'is-self-adjoint-op '(IS-SELF-ADJOINT-OP v t_))
  (tdu-bdd! 't_)
  (tdu-cite! 'op-adjoint-unique 'v 'v 't_ 't_)
  (tdu-close!))
(tdu-done! 'self-adjoint-op-adjoint-eq)

(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_) '((IS-TRACE-CLASS v s_) (IS-SELF-ADJOINT-OP v s_))
      '(IS-SELF-ADJOINT-FUNCTIONAL v (TAU-OP v s_))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tdu-tc-bdd! 's_)
(tdu-cite! 'tau-op-type 'v 's_)
(mac 'is-self-adjoint-functional)
(let* ((landed (dk-peel!))
       (a (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) '(BOUNDED-OPS v v))
                                             (not (equal? (cadr q) 's_))))
                             landed)))))
  (tdu-bdd! a)
  (subst (tdu-cite! 'tau-op-star 'v 's_ a))
  (subst (tdu-cite! 'self-adjoint-op-adjoint-eq 'v 's_))
  (tdu-close!))
(tdu-done! 'tau-op-self-adjoint-of-op)

(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_) '((IS-TRACE-CLASS v s_) (IS-SELF-ADJOINT-FUNCTIONAL v (TAU-OP v s_)))
      '(IS-SELF-ADJOINT-OP v s_)))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tdu-tc-bdd! 's_)
(let* ((u '(FORALL tda_ (IMPLIES (IN tda_ (BOUNDED-OPS v v))
             (= (conjugate ((TAU-OP v s_) (OP-ADJOINT v v tda_))) ((TAU-OP v s_) tda_)))))
       (ss (tdu-adj-bdd! 's_)))
  (dk-project! u 'is-self-adjoint-functional '(IS-SELF-ADJOINT-FUNCTIONAL v (TAU-OP v s_)))
  (tdu-cite! 'trace-class-adjoint 'v 's_)
  (mac 'is-self-adjoint-op)
  (let* ((g (dk-goal)) (c2 (caddr g)))
    (dk-have! c2
      (lambda ()
        (dk-peel!)
        (let* ((gl (dk-goal)) (x (cadr (cadr (cadr gl)))) (y (caddr (cadr gl)))
               (r (list 'RANK-ONE-OP 'v 'v y x))
               (ip (lambda (p q) (list '(IP v) p q))))
          (tdu-cite! 'rank-one-op-hs 'v y x)
          (tdu-hs-bounded! 'v 'v r)
          (tdu-adj-bdd! r)
          (tdu-vty! 'v 'v (list 's_ ss) x)
          (tdu-vty! 'v 'v (list 's_) y)
          (let ((e1 (tdu-cite! 'op-trace-comp-rank-one 'v 's_ y x)))
            (subst (list '= (caddr e1) (cadr e1))))
          (subst (tdu-cite! 'op-trace-comm-bounded 'v 's_ r))
          (let ((e3 (tdu-cite! 'tau-op-apply 'v 's_ r)))
            (subst (list '= (caddr e3) (cadr e3))))
          (let ((h (dk-apply! u r)))
            (subst (list '= (caddr h) (cadr h))))
          (subst (tdu-cite! 'tau-op-star 'v 's_ r))
          (subst (tdu-cite! 'tau-op-apply 'v ss r))
          (let ((e7 (tdu-cite! 'op-trace-comm-bounded 'v ss r)))
            (subst (list '= (caddr e7) (cadr e7))))
          (subst (tdu-cite! 'op-trace-comp-rank-one 'v ss y x))
          (subst (tdu-cite! 'op-adjoint-ip 'v 'v ss x y))
          (subst (tdu-adj2! 's_))
          (tdu-ipty! 'v x (list 's_ y))
          (tdu-close!))))
    (tdu-and! (cadr g) c2)
    (tdu-close!)))
(tdu-done! 'self-adjoint-op-of-tau)

(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_) '((IS-TRACE-CLASS v s_))
      '(IFF (IS-SELF-ADJOINT-FUNCTIONAL v (TAU-OP v s_)) (IS-SELF-ADJOINT-OP v s_))))))
(dk-peel!)
(dk-iff! (lambda (g) (dk-head-is? g 'IS-SELF-ADJOINT-OP))
  (lambda () (tdu-cite! 'self-adjoint-op-of-tau 'v 's_) (tdu-close!))
  (lambda () (tdu-cite! 'tau-op-self-adjoint-of-op 'v 's_) (tdu-close!)))
(tdu-done! 'tau-op-self-adjoint-iff)

;;; ====================================================================
;;; self-adjoint-of-real-form (polarization): T bounded, <T x | x> real for every x => T self-adjoint
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(t_) '((IN t_ (BOUNDED-OPS v v)))
      '(IMPLIES (FORALL tdx_ (IMPLIES (IN tdx_ (VEC v)) (IN ((IP v) (t_ tdx_) tdx_) RR)))
         (IS-SELF-ADJOINT-OP v t_))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tdu-bdd! 't_)
(fact 'cc-i-in)
(let* ((hq (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q 'tdx_))) "the real form"))
       (ip (lambda (p q) (tdu-ip 'v p q)))
       (T (lambda (p) (list 't_ p)))
       (sym! (lambda (z)        ; lands <T z | z> = <z | T z>
               (tdu-ap! 't_ '(VEC v) '(VEC v) z)
               (tdu-ipty! 'v (T z) z) (tdu-ipty! 'v z (T z))
               (dk-apply! hq z)
               (let ((e (list '= (ip (T z) z) (ip z (T z)))))
                 (dk-have! e (lambda ()
                               (subst (tdu-cite! 'cips-ip-conj-sym 'v (T z) z))
                               (subst (dk-cite! 'cc-conjugate-fixes-rr (ip (T z) z)))
                               (tdu-close!)))
                 e))))
  (mac 'is-self-adjoint-op)
  (let* ((g (dk-goal)) (c2 (caddr g)))
    (dk-have! c2
      (lambda ()
        (dk-peel!)
        (let* ((gl (dk-goal)) (x (cadr (cadr (cadr gl)))) (y (caddr (cadr gl)))
               (iy (list '(ACT v) '+i y))
               (z1 (list '(VADD v) x y)) (z2 (list '(VADD v) x iy))
               (tx (T x)) (ty (T y)) (ity (list '(ACT v) '+i ty))
               (u (ip tx y)) (u2 (ip x ty)) (w (ip ty x)) (w2 (ip y tx))
               (a (ip tx x)) (a2 (ip x tx)) (b (ip ty y)) (b2 (ip y ty)))
          (tdu-vty! 'v 'v '(t_) x) (tdu-vty! 'v 'v '(t_) y)
          (tdu-cite! 'cips-act-type 'v '+i y)
          (tdu-cite! 'cips-act-type 'v '+i ty)
          (tdu-cite! 'cips-vadd-type 'v x y)
          (tdu-cite! 'cips-vadd-type 'v x iy)
          (tdu-cite! 'cips-vadd-type 'v tx ty)
          (tdu-cite! 'cips-vadd-type 'v tx ity)
          (for-each (lambda (pq) (tdu-ipty! 'v (car pq) (cadr pq)))
                    (list (list tx y) (list x ty) (list ty x) (list y tx) (list tx x) (list x tx)
                          (list ty y) (list y ty)))
          (let* ((e1 (sym! z1)) (e2 (sym! z2)) (ex (sym! x)) (ey (sym! y))
                 (l1 (cadr e1)) (r1 (caddr e1)) (l2 (cadr e2)) (r2 (caddr e2))
                 (big (list '+ u2 (list '* 1/2
                        (list '- (list '+ (list '- l1 r1) (list '* '+i (list '- l2 r2)))
                                 (let ((dd (list '+ (list '- a a2) (list '- b b2))))
                                   (list '+ dd (list '* '+i dd)))))))
                 (k (list '= u big)))
            (dk-have! k
              (lambda ()
                (subst (tdu-cite! 'bop-add 'v 'v 't_ x y))
                (subst (tdu-cite! 'bop-add 'v 'v 't_ x iy))
                (subst (tdu-cite! 'bop-act 'v 'v 't_ '+i y))
                (subst (tdu-cite! 'cips-ip-add-left 'v tx ty z1))
                (subst (tdu-cite! 'cips-ip-add-right 'v tx x y))
                (subst (tdu-cite! 'cips-ip-add-right 'v ty x y))
                (subst (tdu-cite! 'cips-ip-add-left 'v x y (list '(VADD v) tx ty)))
                (subst (tdu-cite! 'cips-ip-add-right 'v x tx ty))
                (subst (tdu-cite! 'cips-ip-add-right 'v y tx ty))
                (subst (tdu-cite! 'cips-ip-add-left 'v tx ity z2))
                (subst (tdu-cite! 'cips-ip-add-right 'v tx x iy))
                (subst (tdu-cite! 'cips-ip-add-right 'v ity x iy))
                (subst (tdu-cite! 'cips-ip-homog-left 'v '+i ty x))
                (subst (tdu-cite! 'cips-ip-homog-left 'v '+i ty iy))
                (subst (tdu-cite! 'cips-ip-conj-homog-right 'v '+i ty y))
                (subst (tdu-cite! 'cips-ip-conj-homog-right 'v '+i tx y))
                (subst (tdu-cite! 'cips-ip-add-left 'v x iy (list '(VADD v) tx ity)))
                (subst (tdu-cite! 'cips-ip-add-right 'v x tx ity))
                (subst (tdu-cite! 'cips-ip-add-right 'v iy tx ity))
                (subst (tdu-cite! 'cips-ip-homog-left 'v '+i y tx))
                (subst (tdu-cite! 'cips-ip-homog-left 'v '+i y ity))
                (subst (tdu-cite! 'cips-ip-conj-homog-right 'v '+i x ty))
                (subst (tdu-cite! 'cips-ip-conj-homog-right 'v '+i y ty))
                (subst (dk-cite! 'cc-conjugate-i))
                (crs)))
            (subst k)
            (subst e1) (subst e2) (subst ex) (subst ey)
            (tdu-ipty! 'v z1 (T z1)) (tdu-ipty! 'v z2 (T z2))
            (let* ((n1 (dk-name! r1 'CC)) (n2 (dk-name! r2 'CC)))
              (subst (list '= r1 n1)) (subst (list '= r2 n2))
              (crs))))))
    (tdu-and! (cadr g) c2)
    (tdu-close!)))
(tdu-done! 'self-adjoint-of-real-form)

;;; ====================================================================
;;; rank-one-op-positive: x |-> <x|a> a is a positive operator;  <R z | z> = |<z|a>|^2
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(a_) '((IN a_ (VEC v)))
      '(IS-POSITIVE-OP v (RANK-ONE-OP v v a_ a_))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(let* ((r '(RANK-ONE-OP v v a_ a_))
       (val! (lambda (z)        ; lands <R z|z> = |<z|a>| |<z|a>| with its typing and sign
               (let* ((c (tdu-ip 'v z 'a_)) (m (list 'magnitude c)) (mm (list '* m m))
                      (e (list '= (tdu-ip 'v (list r z) z) mm)))
                 (tdu-ipty! 'v z 'a_) (tdu-ipty! 'v 'a_ z)
                 (tdu-ap! r '(VEC v) '(VEC v) z)
                 (tdu-ipty! 'v (list r z) z)
                 (fact 'cc-magnitude-closed c) (fact 'cc-magnitude-nonneg c)
                 (tdu-and! (list 'IN m 'RR) (list 'IN m 'RR))
                 (tdu-and! (list '<= 0 m) (list '<= 0 m))
                 (fact 'rr-mul-closed m m) (fact 'rr-leq-mul-nonneg m m)
                 (dk-have! e
                   (lambda ()
                     (subst (dk-cite! 'rank-one-op-unfold 'v 'v 'a_ 'a_))
                     (dk-lam-b!)
                     (subst (tdu-cite! 'cips-ip-homog-left 'v c 'a_ z))
                     (subst (tdu-cite! 'cips-ip-conj-sym 'v z 'a_))
                     (let ((q (tdu-cite! 'cc-magnitude-sq-conjugate c)))
                       (subst (list '= (caddr q) (cadr q))))
                     (tdu-close!)))
                 e))))
  (tdu-cite! 'rank-one-op-hs 'v 'a_ 'a_)
  (tdu-hs-bounded! 'v 'v r)
  (dk-have! '(FORALL tdx_ (IMPLIES (IN tdx_ (VEC v)) (IN ((IP v) ((RANK-ONE-OP v v a_ a_) tdx_) tdx_) RR)))
    (lambda () (let* ((z (dk-di-var!)) (e (val! z))) (subst e) (tdu-close!))))
  (tdu-cite! 'self-adjoint-of-real-form 'v r)
  (mac 'is-positive-op)
  (let* ((g (dk-goal)) (c2 (caddr g)))
    (dk-have! c2
      (lambda ()
        (let* ((z (dk-di-var!)) (e (val! z))) (subst e)
          (tdu-and! (list 'IN (caddr e) 'RR) (list '<= 0 (caddr e))))))
    (tdu-and! (cadr g) c2)
    (tdu-close!)))
(tdu-done! 'rank-one-op-positive)

;;; ====================================================================
;;; positive-op-of-tau (Prop 5.33, tau_S >= 0 => S >= 0):  <S x | x> = tau_S(x |-> <.|x> x) >= 0
;;; ====================================================================
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_) '((IS-TRACE-CLASS v s_) (IS-POSITIVE-OP-FUNCTIONAL v (TAU-OP v s_)))
      '(IS-POSITIVE-OP v s_)))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tdu-tc-bdd! 's_)
(let* ((pu '(FORALL tda_ (IMPLIES (IS-POSITIVE-OP v tda_)
             (AND (IN ((TAU-OP v s_) tda_) RR) (<= 0 ((TAU-OP v s_) tda_))))))
       (pos! (lambda (z)      ; lands <S z|z> in RR and 0 <= <S z|z>
               (let* ((r (list 'RANK-ONE-OP 'v 'v z z)) (q (tdu-ip 'v (list 's_ z) z))
                      (tq (list (list 'TAU-OP 'v 's_) r)))
                 (tdu-ap! 's_ '(VEC v) '(VEC v) z)
                 (tdu-ipty! 'v (list 's_ z) z)
                 (tdu-cite! 'rank-one-op-hs 'v z z)
                 (tdu-hs-bounded! 'v 'v r)
                 (tdu-cite! 'rank-one-op-positive 'v z)
                 (let ((inst (dk-apply! pu r)))
                   (dk-have! (list '= tq q)
                     (lambda ()
                       (subst (tdu-cite! 'tau-op-apply 'v 's_ r))
                       (let ((c (tdu-cite! 'op-trace-comm-bounded 'v 's_ r)))
                         (subst (list '= (caddr c) (cadr c))))
                       (subst (tdu-cite! 'op-trace-comp-rank-one 'v 's_ z z))
                       (tdu-close!)))
                   (dk-split-all! (list (dk-rewrite-h! inst tq q))))))))
  (dk-project! pu 'is-positive-op-functional '(IS-POSITIVE-OP-FUNCTIONAL v (TAU-OP v s_)))
  (dk-have! '(FORALL tdx_ (IMPLIES (IN tdx_ (VEC v)) (IN ((IP v) (s_ tdx_) tdx_) RR)))
    (lambda () (let ((z (dk-di-var!))) (pos! z) (tdu-close!))))
  (tdu-cite! 'self-adjoint-of-real-form 'v 's_)
  (mac 'is-positive-op)
  (let* ((g (dk-goal)) (c2 (caddr g)))
    (dk-have! c2
      (lambda ()
        (let ((z (dk-di-var!))) (pos! z)
          (tdu-and! (list 'IN (tdu-ip 'v (list 's_ z) z) 'RR) (list '<= 0 (tdu-ip 'v (list 's_ z) z))))))
    (tdu-and! (cadr g) c2)
    (tdu-close!)))
(tdu-done! 'positive-op-of-tau)

(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(s_) '((IS-TRACE-CLASS v s_))
      '(IFF (IS-POSITIVE-OP-FUNCTIONAL v (TAU-OP v s_)) (IS-POSITIVE-OP v s_))))))
(dk-peel!)
(dk-iff! (lambda (g) (dk-head-is? g 'IS-POSITIVE-OP))
  (lambda () (tdu-cite! 'positive-op-of-tau 'v 's_) (tdu-close!))
  (lambda () (tdu-cite! 'tau-op-positive 'v 's_) (tdu-close!)))
(tdu-done! 'tau-op-positive-iff)

;;; ====================================================================
;;; onb-coef-separates: two vectors with the same coefficients on an orthonormal basis are equal
;;; ====================================================================
(define (tdu-coef y) (list 'VNB-LAMBDA 'cfk_ 'ix (list '(IP v) y '(e cfk_))))
(define (tdu-coef-type! y)
  (tdu-fam-type! (tdu-coef y) 'ix
    (lambda (k) (tdu-ap! 'e 'ix '(VEC v) k) (tdu-ipty! 'v y (list 'e k)))))
(sp (make-wff
  (forall-guarded '(v) '((IS-HILBERT-SPACE v))
    (forall-guarded '(ix e) '((IS-ORTHONORMAL-BASIS v ix e))
      (forall-guarded '(y_ z_) '((IN y_ (VEC v)) (IN z_ (VEC v)))
        '(IMPLIES (FORALL tdk_ (IMPLIES (IN tdk_ ix) (= ((IP v) y_ (e tdk_)) ((IP v) z_ (e tdk_)))))
           (= y_ z_)))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(tdu-onb! 'v 'ix 'e)
(let* ((hyp (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q 'tdk_))) "the coefficient hypothesis"))
       (cy (tdu-coef 'y_)) (cz (tdu-coef 'z_))
       (eq (dk-fun-ext! cy cz 'ix 'CC
             (lambda () (tdu-coef-type! 'y_)) (lambda () (tdu-coef-type! 'z_))
             (lambda (w)
               (tdu-ap! 'e 'ix '(VEC v) w)
               (dk-lam-b!)
               (dk-apply! hyp w)
               (tdu-close!)))))
  (dk-have! '(FORALL hrx_ (IMPLIES (IN hrx_ (VEC v)) (= ((IP v) hrx_ y_) ((IP v) hrx_ z_))))
    (lambda ()
      (let* ((h (dk-di-var!))
             (i1 (tdu-cite! 'onb-coefficients-ip 'v 'ix 'e h 'y_))
             (i2 (tdu-cite! 'onb-coefficients-ip 'v 'ix 'e h 'z_)))
        (subst (list '= (caddr i1) (cadr i1)))
        (subst (list '= (caddr i2) (cadr i2)))
        (subst (list '= cy cz))
        (tdu-close!))))
  (tdu-cite! 'cips-ip-separates 'v 'y_ 'z_)
  (tdu-close!))
(tdu-done! 'onb-coef-separates)
