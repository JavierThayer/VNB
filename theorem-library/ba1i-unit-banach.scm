(sp (make-wff (b1u-st 'IS-COMPLEX-NORMED-ALGEBRA
  (b1u-fa 'l 'CC (b1u-fa 'x '(VEC a) (b1u-fa 'r 'CC (b1u-fa 'y '(VEC a)
    (list '= (list (list 'DIST b1u-MU) '(LIST l x) '(LIST r y))
          (list '+ '(magnitude (- l r)) (b1u-nr (b1u-diff 'x 'y)))))))))))
