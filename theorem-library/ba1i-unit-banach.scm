;;; ---- the 9-tuple UNITIZATION(a): typings, read-offs ------------------------------------------------
(define b1u-one '(LIST 1 (VZERO a)))
(define b1u-components
  (list '(SCAL (NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)) '(VEC (UNIT-VEC a)) '(VADD (UNIT-VADD a))
        '(VZERO (LIST 0 (VZERO a))) '(VNEG (UNIT-VNEG a)) '(ACT (UNIT-ACT a)) '(VNRM (UNIT-VNRM a))
        '(VMUL (UNIT-VMUL a)) (list 'VONE b1u-one)))
(define b1u-L9 (cons 'LIST (map cadr b1u-components)))
(define b1u-L8 (cons 'LIST (map cadr (list-head b1u-components 8))))
(define (b1u-ro-name acc) (symbol-append 'b1u-ro- (string->symbol (string-downcase (symbol->string acc)))))
(sp (make-wff (b1u-st 'IS-COMPLEX-NORMED-ALGEBRA (list 'IN b1u-one '(UNIT-VEC a)))))
(dk-peel!)
(dk-have! '(IN 1 CC) (lambda () (arith)))
(b1u-vt '(VZERO a))
(dk-cite! 'pair-in-cartesian 'CC '(VEC a) 1 '(VZERO a))
(dk-cite! 'unit-vec-unfold 'a)
(subst '(= (UNIT-VEC a) (CARTESIAN CC (VEC a))))
