;;; ba1i-unit-banach.scm -- BANACH ALGEBRAS: the unitization of a complex Banach algebra is a Banach
;;; algebra.  C x A with ||(l, x)|| = |l| + ||x|| is complete when A is (the sum metric lies between the
;;; max metric of PRODUCT2-MS(CC-MS, A) and twice it: product2-complete + complete-of-dominated-metric),
;;; so UNITIZATION-NA(a) is a COMPLEX-BANACH-ALGEBRA and UNITIZATION(a), with the unit (1, 0), a
;;; UNITAL-BANACH-ALGEBRA.  F. J. Thayer, "Banach Algebras and Applications", Prop. 1.1 / 1.18.
;;; Agent BA-1I, 2026-11-10.  Destination: theorem-library/ba1i-unit-banach.scm.
;;; Library: operator-algebras.  All proofs modulo 0.  Helper prefix b1u-.
;;; LOAD WINDOW: after kal-unit-cna.scm (KIT-ALG; and so ba-unitization, kal-laws, ba-laws, ba-vocab),
;;; ba1i-dominated.scm, mb67-prod2.scm (product2-complete) and the PRODUCT2-MS laws.

(define (b1u-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (if (and (not (sequent-node-grounded? l))
                           (let ((g (dk-goal-of l))) (and (pair? g) (eq? (car g) '=) (equal? (cadr g) (caddr g)))))
                      (begin (dk-focus! l) (rfl))))
                (dk-open-leaves)))
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba1i-unit-banach: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba1i-unit-banach: unfinished" name))))
(define (b1u-cite2! . args)
  (let loop ((ch (apply dk-cite! args)) (n 0))
    (if (and (dk-head-is? ch 'IMPLIES) (< n 6))
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))) (+ n 1))
        ch)))
(define (b1u-fa v cls body) (list 'FORALL v (list 'IMPLIES (list 'IN v cls) body)))
(define (b1u-st pred body) (list 'FORALL 'a (list 'IMPLIES (list pred 'a) body)))
(define b1u-U '(UNITIZATION-NA a))
(define b1u-W '(UNITIZATION a))
(define b1u-MU '(NAG-METRIC-SPACE (CNA-AS-NORMED-AG (UNITIZATION-NA a))))
(define b1u-MA '(NAG-METRIC-SPACE (CNA-AS-NORMED-AG a)))
(define b1u-P (list 'PRODUCT2-MS 'CC-MS b1u-MA))
(define (b1u-vt t) (dk-alg-type! 'kal-cna 'a t))
(define (b1u-nr x) (list '(VNRM a) x))
(define (b1u-diff x y) (list '(VADD a) x (list '(VNEG a) y)))
;;; land (IN p (VEC U)) for a literal pair p = (LIST l x), l and x typed
(define (b1u-in-vecU! l x)
  (let ((p (list 'LIST l x)))
    (dk-cite! 'pair-in-cartesian 'CC '(VEC a) l x)
    (dk-cite! 'kuc-ro-vec 'a)
    (dk-cite! 'unit-vec-unfold 'a)
    (dk-have! (list 'IN p (list 'VEC b1u-U))
      (lambda () (subst (list '= (list 'VEC b1u-U) '(UNIT-VEC a)))
                 (subst '(= (UNIT-VEC a) (CARTESIAN CC (VEC a))))
                 (dk-ass!)))))

