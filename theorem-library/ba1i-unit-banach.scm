(b1u-qed! 'b1u-dist-pair)

;;; ---- the sum metric between the max metric and twice it, at literal pairs ------------------------
(define (b1u-dom-setup!)                 ; l x r y peeled and typed; returns (A B dP dU), the goal rewritten
  (let* ((A '(magnitude (- l r))) (B (b1u-nr (b1u-diff 'x 'y)))
         (dP (list (list 'DIST b1u-P) '(LIST l x) '(LIST r y)))
         (dU (list (list 'DIST b1u-MU) '(LIST l x) '(LIST r y))))
    (dk-cite! 'cc-is-metric-space)
    (dk-cite! 'nag-metric-space-is-metric-space-cna-as-normed-ag 'a)
    (dk-cite! 'cc-ms@pts)
    (dk-cite! 'nag-metric-carrier-cna-as-normed-ag 'a)
    (for-each (lambda (v) (dk-have! (list 'IN v '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (dk-ass!)))) '(l r))
    (for-each (lambda (v) (dk-have! (list 'IN v (list 'PTS b1u-MA)) (lambda () (subst (list '= (list 'PTS b1u-MA) '(VEC a))) (dk-ass!)))) '(x y))
    (let ((e1 (dk-cite! 'product2-dist-pair 'CC-MS b1u-MA 'l 'r 'x 'y))
          (e2 (dk-cite! 'cc-ms-dist 'l 'r))
          (e3 (dk-cite! 'nag-metric-distance-cna-as-normed-ag 'a 'x 'y))
          (e4 (dk-cite! 'b1u-dist-pair 'a 'l 'x 'r 'y)))
      (subst e1) (subst e2) (subst e3) (subst e4))
    (dk-cc-type! '(- l r))
    (dk-cite! 'cc-magnitude-closed '(- l r))
    (dk-cite! 'cc-magnitude-nonneg '(- l r))
    (b1u-vt (b1u-diff 'x 'y))
    (dk-cite! 'bal-cna-vnrm-fun 'a)
    (dk-cite! 'fun-apply-type-c '(VNRM a) '(VEC a) 'RR (b1u-diff 'x 'y))
    (dk-cite! 'bal-cna-vnrm-nonneg 'a (b1u-diff 'x 'y))
    (dk-cite! 'rr-max-closed A B)
    (dk-cite! 'rr-le-max-left A B)
    (dk-cite! 'rr-le-max-right A B)
    (list A B dP dU)))
(define (b1u-pair-st body)
  (b1u-st 'IS-COMPLEX-NORMED-ALGEBRA
    (b1u-fa 'l 'CC (b1u-fa 'x '(VEC a) (b1u-fa 'r 'CC (b1u-fa 'y '(VEC a) body))))))
(define b1u-dPp (list (list 'DIST b1u-P) '(LIST l x) '(LIST r y)))
(define b1u-dUp (list (list 'DIST b1u-MU) '(LIST l x) '(LIST r y)))
(sp (make-wff (b1u-pair-st (list '<= b1u-dPp b1u-dUp))))
(dk-peel!)
(let* ((s (b1u-dom-setup!)) (A (car s)) (B (cadr s)) (AB (list '+ A B)))
  (b1u-cite2! 'rr-add-closed A B)
  (dk-have! (list '<= A AB) (lambda () (dk-ineq! (list '<= 0 B) (list 'IN A 'RR) (list 'IN B 'RR))))
  (dk-have! (list '<= B AB) (lambda () (dk-ineq! (list '<= 0 A) (list 'IN A 'RR) (list 'IN B 'RR))))
  (b1u-cite2! 'rr-max-le A B AB)
  (if (not (proof-done? *ps*)) (dk-ass!)))
(b1u-qed! 'b1u-dom1-pair)
(sp (make-wff (b1u-pair-st (list '<= b1u-dUp (list '* 2 b1u-dPp)))))
(dk-peel!)
(let* ((s (b1u-dom-setup!)) (A (car s)) (B (cadr s)) (M (list 'MAX A B)))
  (dk-ineq! (list '<= A M) (list '<= B M) (list 'IN A 'RR) (list 'IN B 'RR) (list 'IN M 'RR)))
(b1u-qed! 'b1u-dom2-pair)

;;; the eta lifts, in the shape of complete-of-dominated-metric's hypotheses
(define (b1u-eta! u)                     ; u in PTS(MU): u = (NTH 1 u, NTH 2 u), components typed
  (dk-cite! 'unitization-is-complex-normed-algebra 'a)
  (dk-cite! 'nag-metric-carrier-cna-as-normed-ag b1u-U)
  (dk-cite! 'kuc-ro-vec 'a)
  (dk-cite! 'unit-vec-unfold 'a)
  (dk-have! (list 'IN u '(CARTESIAN CC (VEC a)))
    (lambda () (subst '(= (CARTESIAN CC (VEC a)) (UNIT-VEC a)))
               (subst (list '= '(UNIT-VEC a) (list 'VEC b1u-U)))
               (subst (list '= (list 'VEC b1u-U) (list 'PTS b1u-MU)))
               (dk-ass!)))
  (dk-cite! 'cartesian-pair-eq u 'CC '(VEC a))
  (dk-split! (dk-cite! 'cartesian-nth u 'CC '(VEC a)))
  (list 'LIST (list 'NTH 1 u) (list 'NTH 2 u)))
(define (b1u-lift! pair-name name build)
  (sp (make-wff (b1u-st 'IS-COMPLEX-NORMED-ALGEBRA
    (b1u-fa 'dmp_ (list 'PTS b1u-MU) (b1u-fa 'dmq_ (list 'PTS b1u-MU) (build 'dmp_ 'dmq_))))))
  (dk-peel!)
  (let* ((ep (b1u-eta! 'dmp_)) (eq (b1u-eta! 'dmq_))
         (f0 (dk-cite! pair-name 'a (cadr ep) (caddr ep) (cadr eq) (caddr eq)))
         (f1 (dk-rewrite-h! f0 ep 'dmp_)))
    (dk-rewrite-h! f1 eq 'dmq_)
    (dk-ass!))
  (b1u-qed! name))
(b1u-lift! 'b1u-dom1-pair 'b1u-dom1
  (lambda (p q) (list '<= (list (list 'DIST b1u-P) p q) (list (list 'DIST b1u-MU) p q))))
(b1u-lift! 'b1u-dom2-pair 'b1u-dom2
  (lambda (p q) (list '<= (list (list 'DIST b1u-MU) p q) (list '* 2 (list (list 'DIST b1u-P) p q)))))

