  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD))
(for-each
  (lambda (e)
    (let ((acc (car e)) (val (cadr e)))
      (sp (make-wff (b1u-st 'IS-COMPLEX-NORMED-ALGEBRA (list '== (list acc b1u-W) val))))
      (dk-peel!)
      (b1u-typings!)
      (dk-have! (list 'IN b1u-L9 'SET) (lambda () (dk-list-in-set!)))
      (mac 'UNITIZATION)
      (let outer ((j 0))
        (let ((g0 (dk-goal)))
