;;; THE UNITIZATION OF A COMPLEX BANACH ALGEBRA, WITH UNIT (1, 0), IS A UNITAL BANACH ALGEBRA
(define (b1u-close-leaf!)
  (let* ((g (dk-goal)) (h (dk-head g)))
    (cond ((dk-asm? g) (dk-ass!))
          ((and (eq? h '=) (dk-head-is? (cadr g) 'LENGTH)) (mac 'UNITIZATION) (len-r) (arith))
          ((eq? h 'IS-RING)
           (dk-cite! 'commutative-ring-is-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)) (dk-ass!))
          ((and (eq? h '=) (equal? (cadr g) (caddr g))) (rfl))
          ((eq? h 'IS-COMPLEX-BANACH-ALGEBRA)
           (let* ((f (dk-cite! 'unitization-is-complex-banach-algebra 'a))
                  (e (dk-cite! 'unitization-na-unfold 'a)))
             (dk-rewrite-h! f b1u-U b1u-L8)
             (dk-ass!)))
          ((eq? h 'FORALL)
           (if (dk-contains? (dk-goal) '(UNIT-VMUL a) )
               (begin (dk-cite! 'unitization-unit-left 'a) (dk-cite! 'unitization-unit-right 'a) (dk-ass!))
               (error "b1u-close-leaf!: unexpected universal" (expression->string g))))
          ((eq? h '=)
           (dk-cite! 'unitization-norm-unit 'a) (dk-ass!))
          (#t (error "b1u-close-leaf!: unexpected conjunct" (expression->string g))))))
(define (b1u-guard tag thunk)
  (call-with-current-continuation
    (lambda (k) (with-exception-handler
                  (lambda (e) (display "\n;; B1U LEAF FAILED ") (display tag) (display ": ")
                          (display (if (condition? e) (condition/report-string e) e)) (newline) (k #f))
                  thunk))))
(define (b1u-isx-tuple! pred funct comps readoff-name)   ; unfold PRED(FUNCT a), read every accessor off, split
  (mac pred)
  (dk-isx-set! funct)
  (for-each (lambda (e)
              (let ((t (list (car e) (list funct 'a))))
                (if (dk--occurs? t (dk-goal))
                    (begin (dk-cite! (readoff-name (car e)) 'a)
                           (subst (list '= t (cadr e)))))))
            comps)
  (for-each (lambda (m) (vnb-guard (lambda () (quietly (lambda () (mac m))))))
            '(cc-scalar-ring-carr))
  (let loop ((k 0))
    (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (dk-open-leaves))))
      (if (and l (< k 80)) (begin (dk-focus! l) (di) (loop (+ k 1)))))))
(sp (make-wff (b1u-st 'IS-COMPLEX-BANACH-ALGEBRA (list 'IS-UNITAL-BANACH-ALGEBRA b1u-W))))
(dk-peel!)
(dk-cite! 'bal-cba-is-cna 'a)
(b1u-typings!)
(b1u-isx-tuple! 'IS-UNITAL-BANACH-ALGEBRA 'UNITIZATION b1u-components b1u-ro-name)
(for-each (lambda (l)
            (if (not (sequent-node-grounded? l))
                (begin (dk-focus! l)
                       (b1u-guard (expression->string (dk-goal-of l)) b1u-close-leaf!))))
          (dk-open-leaves))
(b1u-qed! 'unitization-is-unital-banach-algebra)
(display "\n;; B1U qed failures: ")  
