;;; poly-fn-holomorphic.scm -- complex analysis: a polynomial function on an open set is holomorphic and its
;;; derivative is a polynomial function (CA-MONTEL "POLY", 2026-10-26).  Library: complex-analysis.
;;; The helpers below are copied from poly-fn-laws.scm (each proof file has its own environment).
(define (pfh-H c z) (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list c 'pfj_) (list 'power z 'pfj_))))
(define (pfh-PS c z n) (list 'CC-SERIES-PARTIAL-SUM (pfh-H c z) n))
(define (pfh-only-prop! . fs) (dk-close-if! (lambda () (apply dk-only! fs)) prop))
(define (pfh-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (pfh-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-type! t 'CC)))
(define (pfh-nn! t) (if (not (dk-asm? (list 'IN t 'NN))) (dk-type! t 'NN)))
(define (pfh-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (pfh-H-typ! c z)
  (let ((g (list 'IN (pfh-H c z) '(FUN NN CC))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let* ((j (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                  (fact 'fun-apply-type-c c 'NN 'CC j)
                  (if (not (sequent-node-grounded? leaf)) (dk-type! (cadr (dk-goal)) 'CC))
                  (pfh-close-open!)))))))
    g))
(define (pfh-PS-typ! c z n)
  (pfh-H-typ! c z) (pfh-nn! n)
  (let ((g (list 'IN (pfh-PS c z n) 'CC)))
    (if (not (dk-asm? g)) (dk-cite! 'cc-series-partial-sum-in-cc n (pfh-H c z)))
    g))
(define (pfh-sub-parts! kc)
  (let ((h (list 'IS-CC-SUBRING kc)))
    (dk-project! (list 'SUBSET kc 'CC) 'IS-CC-SUBRING h)
    (dk-project! (list 'IN 0 kc) 'IS-CC-SUBRING h)
    (dk-project! (list 'IN 1 kc) 'IS-CC-SUBRING h)
    (dk-project! (pfh-sub-add kc) 'IS-CC-SUBRING h)
    (dk-project! (pfh-sub-mul kc) 'IS-CC-SUBRING h)))
(define (pfh-sub-add kc) (list 'FORALL 'psu_ (list 'IMPLIES (list 'IN 'psu_ kc) (list 'FORALL 'psv_ (list 'IMPLIES (list 'IN 'psv_ kc) (list 'IN '(+ psu_ psv_) kc))))))
(define (pfh-sub-mul kc) (list 'FORALL 'psu_ (list 'IMPLIES (list 'IN 'psu_ kc) (list 'FORALL 'psv_ (list 'IMPLIES (list 'IN 'psv_ kc) (list 'IN '(* psu_ psv_) kc))))))
(define (pfh-KCC! kc t) (if (not (dk-asm? (list 'IN t 'CC))) (fact 'subset-mem-fwd kc 'CC t)))
(define (pfh-cons-cc! b c)
  (let ((g (list 'IN (list 'CF-CONS b c) '(FUN NN CC))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (subst (dk-cite! 'cf-cons-unfold b c))
            (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-one-in)
            (dk-lam-type!
              (lambda ()
                (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                  (fact 'nn-minus-in-nn k 1)
                  (fact 'fun-apply-type-c c 'NN 'CC (list 'NN-MINUS k 1))
                  (if (not (sequent-node-grounded? leaf)) (dk-type! (cadr (dk-goal)) 'CC))
                  (pfh-close-open!)))))))
    g))
(define (pfh-vanish c n) (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) (list 'IMPLIES (list '<= n 'pfk_) (list '= (list c 'pfk_) 0)))))
(define (pfh-poly-open! kc a f)
  (let* ((h (list 'IS-POLY-FN-ON kc a f))
         (iff (dk-cite! 'is-poly-fn-on kc a f))
         (rhs (caddr iff)))
    (dk-project! (list 'SUBSET a kc) (lambda () (dk-only! iff h)))
    (dk-project! (list 'IN f (list 'FUN a kc)) (lambda () (dk-only! iff h)))
    (let* ((ex (caddr (caddr rhs))))
      (dk-project! ex (lambda () (dk-only! iff h)))
      (let* ((n (dk-skolem! ex))
             (_0 (dk-split-all!))
             (ex2 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm n) (dk-contains? fm f))) "the coefficients"))
             (c (dk-skolem! ex2))
             (_1 (dk-split-all!)))
        (list n c)))))
(define (pfh-val f a c n)
  (list 'FORALL 'pfz_ (list 'IMPLIES (list 'IN 'pfz_ a) (list '= (list f 'pfz_) (pfh-PS c 'pfz_ n)))))
(define (pfh-poly-intro! kc a g n c val!)
  (let* ((iff (dk-cite! 'is-poly-fn-on kc a g)) (rhs (caddr iff)))
    (dk-have! rhs
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (cond ((dk-asm? (dk-goal)) (ass))
                  ((dk-head-is? (dk-goal) 'FORSOME)
                   (ew n)
                   (dk-conj-close!
                     (lambda ()
                       (cond ((dk-asm? (dk-goal)) (ass))
                             ((dk-head-is? (dk-goal) 'FORSOME)
                              (ew c)
                              (dk-conj-close!
                                (lambda ()
                                  (cond ((dk-asm? (dk-goal)) (ass))
                                        (#t (let ((z (dk-di-var!))) (val! z) (pfh-close-open!)))))))
                             (#t (error "pfh-poly-intro!: unexpected goal" (expression->string (dk-goal))))))))
                  (#t (error "pfh-poly-intro!: unexpected goal" (expression->string (dk-goal)))))))))
    (pfh-only-prop! iff rhs)))
(define (pfh-lam-kc! g a kc typer!)
  (let ((goal (list 'IN g (list 'FUN a kc))))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                  (fact 'subset-mem-fwd a kc x)
                  (pfh-KCC! kc x)
                  (if (not (sequent-node-grounded? leaf)) (typer! x))
                  (pfh-close-open!)))))))
    goal))
(define (pfh-sets! kc a)
  (fact 'cc-is-set)
  (if (not (dk-asm? (list 'IN kc 'SET))) (fact 'subclass-of-set-is-set kc 'CC))
  (if (not (dk-asm? (list 'IN a 'SET))) (fact 'subclass-of-set-is-set a kc)))
(define (pfh-beta! close!)
  (let ((leaf (proof-state-focus *ps*)))
    (dk-lam-b!)
    (if (not (sequent-node-grounded? leaf)) (close!))))
(define (pfh-ext! kc a src tgt typer! eq!)
  (pfh-lam-kc! tgt a kc typer!)
  (let ((pw (list 'FORALL 'pfz_ (list 'IMPLIES (list 'IN 'pfz_ a) (list '= (list tgt 'pfz_) (list src 'pfz_))))))
    (dk-have! pw (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd a kc z) (pfh-KCC! kc z) (eq! z) (pfh-close-open!))))
    (dk-cite! 'poly-fn-ext kc a src tgt)))
(define (pfh-beta-eq! close!)
  (dk-close-if! (lambda () (dk-lam-b!)) close!))
(define (pfh-tail-val t c) (list 'FORALL 'pftk_ (list 'IMPLIES '(IN pftk_ NN) (list '= (list t 'pftk_) (list c '(succ pftk_))))))
(define (pfh-tail-sym! kc c)
  (let* ((lam (list 'VNB-LAMBDA 'pftk_ 'NN (list c '(succ pftk_))))
         (ex (list 'FORSOME 'pftt_ (list 'AND (list 'IN 'pftt_ (list 'FUN 'NN kc))
                (list 'AND (list 'IN 'pftt_ '(FUN NN CC)) (pfh-tail-val 'pftt_ c))))))
    (dk-have! ex
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (let ((cls (caddr (caddr (dk-goal)))))
                  (dk-lam-type!
                    (lambda ()
                      (let* ((k (dk-di-var!)))
                        (fact 'nn-succ-closed k)
                        (fact 'fun-apply-type-c c 'NN cls (list 'succ k))
                        (pfh-close-open!)))))
                (let ((k (dk-di-var!)))
                  (fact 'nn-succ-closed k)
                  (fact 'fun-apply-type-c c 'NN 'CC (list 'succ k))
                  (pfh-beta! rfl)))))))
    (let ((t (dk-skolem! ex)))
      (dk-split-all!)
      t)))
(define (pfh-split! kc c t v z)
  (let* ((c0 (list c 0))
         (e (list '= (pfh-PS c z (list 'succ v)) (list '+ c0 (list '* z (pfh-PS t z v))))))
    (if (not (dk-asm? e))
        (begin
          (fact 'nn-zero-in)
          (fact 'fun-apply-type-c c 'NN 'CC 0)
          (pfh-cons-cc! c0 t)
          (fact 'nn-succ-closed v)
          (dk-have! (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) (list '= (list c 'pfk_) (list (list 'CF-CONS c0 t) 'pfk_))))
            (lambda ()
              (let ((k (dk-di-var!)))
                (use-cases (dk-cite! 'nn-zero-or-succ k)
                  (lambda () (subst (list '= k 0)) (subst (dk-cite! 'cf-cons-zero c0 t)) (rfl))
                  (lambda ()
                    (let* ((q (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f k))) "k = succ q")))
                           (_0 (dk-split-all!)))
                      (subst (list '= k (list 'succ q)))
                      (subst (dk-cite! 'cf-cons-succ c0 t q))
                      (fact 'nn-succ-closed q)
                      (fact 'fun-apply-type-c c 'NN 'CC (list 'succ q))
                      (subst (dk-apply! (pfh-tail-val t c) q))
                      (rfl)))))))
          (dk-have! e
            (lambda ()
              (subst (pfh-chain! (dk-fact! 'cc-ps-congr (list 'succ v) c (list 'CF-CONS c0 t) z)))
              (subst (dk-cite! 'cc-ps-cons v c0 t z))
              (rfl)))))
    e))
(define (pfh-tail-vanish! c t v)
  (dk-have! (pfh-vanish t v)
    (lambda ()
      (let* ((lk (dk-peel!)) (k (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk)))))
        (fact 'nn-succ-closed k)
        (pfh-chain! (dk-fact! 'nn-succ-mono v k))
        (dk-apply! (pfh-vanish c (list 'succ v)) (list 'succ k))
        (fact 'fun-apply-type-c c 'NN 'CC (list 'succ k))
        (subst (dk-apply! (pfh-tail-val t c) k))
        (subst (list '= (list c (list 'succ k)) 0))
        (rfl)))))

;;; ======================================================================
;;; CA: A POLYNOMIAL FUNCTION IS HOLOMORPHIC, AND ITS DERIVATIVE IS A POLYNOMIAL FUNCTION
;;; ======================================================================
(define (pfh-F c n) (list 'VNB-LAMBDA 'pfx_ 'CC (pfh-PS c 'pfx_ n)))
(define (pfh-dergoal c n)
  (list 'FORSOME 'pfd_ (list 'AND '(IS-POLY-FN-ON CC CC pfd_)
    (list 'FORALL 'pfw_ (list 'IMPLIES '(IN pfw_ CC) (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'CC (pfh-F c n) 'pfw_ '(pfd_ pfw_)))))))
;; (IN (pfh-F c n) (FUN CC CC))
(define (pfh-F-typ! c n)
  (let ((g (list 'IN (pfh-F c n) '(FUN CC CC))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (pfh-PS-typ! c x n) (pfh-close-open!)))))))
    g))
;; from IS-DIFF-ON(K, CC, LAM, w, L) landed and F(x) == LAM(x) pointwise (EQ! closes it at x): F's
(define (pfh-transfer! fF lam w l eq!)
  (pfh-cc! l)
  (dk-have! (list 'IN fF '(FUN CC (CARR CC-NORMED-FIELD)))
    (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
  (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES '(IN hbx_ CC) (list '== (list fF 'hbx_) (list lam 'hbx_))))
    (lambda () (let ((x (dk-di-var!))) (eq! x) (pfh-close-open!))))
  (pfh-chain! (dk-fact! 'diff-on-transfer-ptwise-eq 'CC-NORMED-FIELD 'CC fF lam w l)))

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'pfc_ (list 'IMPLIES '(IN pfc_ (FUN NN CC))
  (list 'IMPLIES (pfh-vanish 'pfc_ 'n) (pfh-dergoal 'pfc_ 'n))))))))
(define (pfh-der-common!)
  (fact 'cc-is-normed-field) (fact 'cc-nf-carr)
  (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-zero-in)
  (fact 'cc-is-set)
  (dk-cite! 'cc-subring-cc)
  (pfh-sub-parts! 'CC)
  (dk-have! '(SUBSET CC CC) (lambda () (let ((x (subset-by-element!))) (pfh-close-open!)))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  ;; base: the zero function, derivative 0
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (pfh-der-common!)
  (let* ((z0 '(VNB-LAMBDA pfx_ CC 0)))
    (dk-cite! 'poly-fn-const 'CC 'CC 0)
    (ew z0)
    (pfh-F-typ! 'pfc_ 0)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal))
            (ass)
            (let* ((w (dk-di-var!)))
              (dk-have! (list '= (list z0 w) 0) (lambda () (pfh-beta! rfl)))
              (subst (list '= (list z0 w) 0))
              (dk-diff! 'CC z0 w 0)
              (pfh-transfer! (pfh-F 'pfc_ 0) z0 w 0
                (lambda (x)
                  (pfh-H-typ! 'pfc_ x)
                  (dk-close-if! (lambda () (dk-lam-b!)) (lambda () #t))
                  (subst (dk-cite! 'cc-series-partial-sum-zero (pfh-H 'pfc_ x)))
                  (qrfl)))
              (pfh-close-open!))))))
  ;; step: F = c(0) + x Fq(x), Fq the polynomial of the tail
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (pfh-der-common!)
  (fact 'nn-succ-closed v)
  (let* ((t (pfh-tail-sym! 'CC 'pfc_))
         (c0 '(pfc_ 0))
         (_0 (pfh-tail-vanish! 'pfc_ t v))
         (_1 (fact 'fun-apply-type-c 'pfc_ 'NN 'CC 0))
         (ex (dk-apply! ih t))
         (d0 (dk-skolem! ex))
         (_2 (dk-split-all!))
         (fq (pfh-F t v))
         (_3 (pfh-F-typ! t v))
         (g (dk-name! fq '(FUN CC CC)))
         (geq (list '= g fq)))
    ;; g is a polynomial function on CC
    (dk-have! (list 'IS-POLY-FN-ON 'CC 'CC fq)
      (lambda ()
        (pfh-poly-intro! 'CC 'CC fq v t
          (lambda (z) (pfh-PS-typ! t z v) (pfh-beta! rfl)))))
    (dk-rewrite-h! (list 'IS-POLY-FN-ON 'CC 'CC fq) fq g)
    (let* ((dq (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-DIFF-ON) (dk-contains? fm d0))) "Fq's derivative")))
      (dk-rewrite-h! dq fq g))
    (let* ((dqg (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-DIFF-ON) (dk-contains? fm d0) (dk-contains? fm g))) "g's derivative"))
           (xd (list 'VNB-LAMBDA 'pfx_ 'CC (list '* 'pfx_ (list d0 'pfx_))))
           (sm (list 'VNB-LAMBDA 'pfx_ 'CC (list '+ (list g 'pfx_) (list xd 'pfx_))))
           (dd (list 'VNB-LAMBDA 'pfx_ 'CC (list '+ (list g 'pfx_) (list '* 'pfx_ (list d0 'pfx_)))))
           (lam (list 'VNB-LAMBDA 'pfx_ 'CC (list '+ c0 (list '* 'pfx_ (list g 'pfx_))))))
      (dk-cite! 'poly-fn-mulz 'CC 'CC d0)
      (dk-cite! 'poly-fn-add 'CC 'CC g xd)
      (pfh-poly-open! 'CC 'CC d0)
      (pfh-ext! 'CC 'CC sm dd
        (lambda (x) (fact 'fun-apply-type-c g 'CC 'CC x) (fact 'fun-apply-type-c d0 'CC 'CC x) (pfh-cc! (list '* x (list d0 x))) (pfh-cc! (list '+ (list g x) (list '* x (list d0 x)))))
        (lambda (z) (fact 'fun-apply-type-c g 'CC 'CC z) (fact 'fun-apply-type-c d0 'CC 'CC z) (pfh-beta-eq! crs)))
      (ew dd)
      (pfh-F-typ! 'pfc_ (list 'succ v))
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (let* ((w (dk-di-var!))
                     (l (list '+ (list g w) (list '* w (list d0 w)))))
                (fact 'fun-apply-type-c g 'CC 'CC w) (fact 'fun-apply-type-c d0 'CC 'CC w)
                (pfh-cc! (list '* w (list d0 w))) (pfh-cc! l)
                (dk-have! (list '= (list dd w) l) (lambda () (pfh-beta! rfl)))
                (subst (list '= (list dd w) l))
                (dk-apply! dqg w)
                (pfh-cc! c0)
                (dk-diff! 'CC lam w l)
                (pfh-transfer! (pfh-F 'pfc_ (list 'succ v)) lam w l
                  (lambda (x)
                    (fact 'fun-apply-type-c g 'CC 'CC x)
                    (pfh-PS-typ! t x v)
                    (pfh-PS-typ! 'pfc_ x (list 'succ v))
                    (let ((sp1 (pfh-split! 'CC 'pfc_ t v x))
                          (rhs (list '+ c0 (list '* x (list g x)))))
                      (pfh-cc! (list '* x (list g x))) (pfh-cc! rhs)
                      (dk-have! (list '= (list (pfh-F 'pfc_ (list 'succ v)) x) (pfh-PS 'pfc_ x (list 'succ v))) (lambda () (pfh-beta! rfl)))
                      (dk-have! (list '= (list lam x) rhs) (lambda () (pfh-beta! rfl)))
                      (subst (list '= (list (pfh-F 'pfc_ (list 'succ v)) x) (pfh-PS 'pfc_ x (list 'succ v))))
                      (subst (list '= (list lam x) rhs))
                      (subst sp1)
                      (dk-have! (list '= (list g x) (pfh-PS t x v))
                        (lambda () (subst geq) (pfh-beta! rfl)))
                      (subst (list '= (list g x) (pfh-PS t x v)))
                      (qrfl))))
                (pfh-close-open!))))))))
(qed 'cc-ps-deriv-poly)
(topic! 'cc-ps-deriv-poly 'analysis)

(define pfh-hol-goal
  '(AND (HOLOMORPHIC-ON u f)
        (FORSOME pfd_ (AND (IS-POLY-FN-ON CC u pfd_)
          (FORALL pfw_ (IMPLIES (IN pfw_ u) (IS-DIFF-ON CC-NORMED-FIELD u f pfw_ (pfd_ pfw_))))))))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u)
  (list 'FORALL 'f (list 'IMPLIES '(IS-POLY-FN-ON CC u f) pfh-hol-goal))))))
(dk-peel!)
(fact 'cc-is-normed-field) (fact 'cc-nf-carr)
(dk-cite! 'cc-subring-cc)
(pfh-sub-parts! 'CC)
(let* ((nc (pfh-poly-open! 'CC 'u 'f)) (n (car nc)) (c (cadr nc))
       (ex (dk-cite! 'cc-ps-deriv-poly n c))
       (dD (dk-skolem! ex))
       (_0 (dk-split-all!))
       (fF (pfh-F c n))
       (dall (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-DIFF-ON) (dk-contains? fm dD))) "F's derivative"))
       (du (list 'VNB-LAMBDA 'pfx_ 'u (list dD 'pfx_)))
       (fdiff (list 'FORALL 'pfw_ (list 'IMPLIES '(IN pfw_ u) (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'u 'f 'pfw_ (list dD 'pfw_))))))
  (fact 'cc-is-set)
  (pfh-sets! 'CC 'u)
  (pfh-F-typ! c n)
  (dk-cite! 'poly-fn-restrict 'CC 'CC dD 'u)
  (pfh-poly-open! 'CC 'CC dD)
  (dk-have! '(IN f (FUN u (CARR CC-NORMED-FIELD))) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
  (dk-have! fdiff
    (lambda ()
      (let* ((w (dk-di-var!)))
        (fact 'subset-mem-fwd 'u 'CC w)
        (fact 'fun-apply-type-c dD 'CC 'CC w)
        (dk-apply! dall w)
        (pfh-chain! (dk-fact! 'diff-on-shrink 'CC-NORMED-FIELD 'CC fF w (list dD w) 'u))
        (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES '(IN hbx_ u) (list '== '(f hbx_) (list (list 'RESTRICT fF 'u) 'hbx_))))
          (lambda ()
            (let ((x (dk-di-var!)))
              (fact 'subset-mem-fwd 'u 'CC x)
              (pfh-PS-typ! c x n)
              (subst (dk-cite! 'restrict-apply fF 'u x))
              (subst (dk-apply! (pfh-val 'f 'u c n) x))
              (dk-close-if! (lambda () (dk-lam-b!)) qrfl))))
        (pfh-chain! (dk-fact! 'diff-on-transfer-ptwise-eq 'CC-NORMED-FIELD 'u 'f (list 'RESTRICT fF 'u) w (list dD w)))
        (pfh-close-open!))))
  (dk-conj-close!
    (lambda ()
      (cond ((dk-asm? (dk-goal)) (ass))
            ((dk-head-is? (dk-goal) 'HOLOMORPHIC-ON)
             (let* ((hi (dk-cite! 'holomorphic-on 'u 'f)) (hr (caddr hi)))
               (dk-have! hr
                 (lambda ()
                   (dk-conj-close!
                     (lambda ()
                       (cond ((dk-asm? (dk-goal)) (ass))
                             ((dk-head-is? (dk-goal) 'IN) (fact 'fun-codomain-superset 'f 'u 'CC 'CC) (pfh-close-open!))
                             (#t (let ((w (dk-di-var!)))
                                   (fact 'subset-mem-fwd 'u 'CC w) (fact 'fun-apply-type-c dD 'CC 'CC w)
                                   (ew (list dD w)) (dk-apply! fdiff w) (pfh-close-open!))))))))
               (pfh-only-prop! hi hr)))
            (#t
             (ew du)
             (dk-conj-close!
               (lambda ()
                 (if (dk-asm? (dk-goal))
                     (ass)
                     (let ((w (dk-di-var!)))
                       (fact 'subset-mem-fwd 'u 'CC w)
                       (fact 'fun-apply-type-c dD 'CC 'CC w)
                       (dk-have! (list '= (list du w) (list dD w)) (lambda () (pfh-beta! rfl)))
                       (subst (list '= (list du w) (list dD w)))
                       (dk-apply! fdiff w)
                       (pfh-close-open!))))))))))
(qed 'poly-fn-holomorphic)
(topic! 'poly-fn-holomorphic 'analysis)

;;; ======================================================================
;;; THE FUNDAMENTAL THEOREM OF ALGEBRA for polynomial functions (the bridge from cc-algebraically-closed,
;;; CA 3.50, which is stated with an explicit coefficient sequence)
;;; ======================================================================
(sp (make-wff '(FORALL f (FORALL n (IMPLIES (IN n NN) (IMPLIES (<= 1 n) (IMPLIES (IS-POLY-DEG CC CC f n)
  (FORSOME z (AND (IN z CC) (= (f z) 0))))))))))
(dk-peel!)
(let* ((iff (dk-cite! 'is-poly-deg 'CC 'CC 'f 'n))
       (ex (caddr (caddr (caddr iff)))))
  (dk-project! ex (lambda () (dk-only! iff '(IS-POLY-DEG CC CC f n))))
  (dk-project! '(IN f (FUN CC CC)) (lambda () (dk-only! iff '(IS-POLY-DEG CC CC f n))))
  (let* ((c (dk-skolem! ex))
         (_0 (dk-split-all!))
         (zex (dk-cite! 'cc-algebraically-closed c 'n))
         (z (dk-skolem! zex))
         (_1 (dk-split-all!))
         (val (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'f) (dk-contains? fm c))) "the values")))
    (ew z)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal))
            (ass)
            (begin
              (subst (dk-apply! val z))
              (pfh-close-open!)))))))
(qed 'poly-fn-fta)
(topic! 'poly-fn-fta 'analysis)
