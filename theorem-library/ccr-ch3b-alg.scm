;; the class of X with ||X T^j|| <= c for all j
(define (cq4-bcl c) `(SEP zkb_ ,(cq4-mat 'n 'n) (FORALL zkj_ (IMPLIES (IN zkj_ NN)
                        (IS-MAT-BOUND K n n ,(cq4-mm 'zkb_ (cq4-pw 'tm 'zkj_)) ,c)))))
(define (cq4-h3-of s) `(FORALL zkx_ (IMPLIES (IN zkx_ ,s) (IN ,(cq4-mm 'zkx_ 'tm) ,s))))
(define (cq4-h4-of s) `(FORALL zkx_ (IMPLIES (IN zkx_ ,s) (FORALL zky_ (IMPLIES (IN zky_ ,s) (IN ,(cq4-ma 'zkx_ 'zky_) ,s))))))
(define (cq4-h5-of s) `(FORALL zkx_ (IMPLIES (IN zkx_ ,s) (FORALL zkc_ (IMPLIES (IN zkc_ (NV-INTEGERS K)) (IN ,(cq4-ms 'zkc_ 'zkx_) ,s))))))
;; prove (IN X S) for S = SEP v D (FORALL j (IMPLIES (IN j NN) body)): BODY-THUNK gets the eigenvariable j
(define (cq4-in-bcl! x s body-thunk)
  (cq4-ty! x 'n 'n)
  (in-sep! (lambda () (dk-ass!))
    (lambda ()
      (let* ((landed (dk-peel!))
             (jm (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) landed)))
        (body-thunk (cadr jm))))))
;; with (IN X S) in context, land (and return) X's universal
(define (cq4-bcl-univ! x s)
  (if (not (dk-asm? `(IN ,x ,(cq4-mat 'n 'n))))
      (dk-have! `(IN ,x ,(cq4-mat 'n 'n)) (lambda () (sep-me `(IN ,x ,s)) (dk-ass!))))
  (let ((body (subst-free (cadr s) x (cadddr s))))
    (if (not (dk-asm? body)) (dk-have! body (lambda () (sep-me `(IN ,x ,s)) (dk-ass!))))
    (dk-ctx-form body)))

;; (a) every X in Z(K)[T] has ||X T^j||_max <= c for all j, c a power bound of T
(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL tm (FORALL c
  (IMPLIES (IS-POWER-BOUNDED-BY K n tm c) (FORALL zkp_ (IMPLIES (IN zkp_ ,cq4-alg)
    (FORALL j (IMPLIES (IN j NN) (IS-MAT-BOUND K n n ,(cq4-mm 'zkp_ (cq4-pw 'tm 'j)) c))))))))))))))
(dk-peel!)
(dk-cite! 'nv-field-normed 'K)
(cq4-view!)
(let* ((pb '(IS-POWER-BOUNDED-BY K n tm c))
       (s (cq4-bcl 'c)))
  (dk-project! `(IN tm ,(cq4-mat 'n 'n)) (lambda () (mac-h 'is-power-bounded-by pb)))
  (dk-project! '(IN c RR) (lambda () (mac-h 'is-power-bounded-by pb)))
  (dk-project! '(<= 0 c) (lambda () (mac-h 'is-power-bounded-by pb)))
  (let ((ut `(FORALL cbvk_ (IMPLIES (IN cbvk_ NN) (IS-MAT-BOUND K n n ,(cq4-pw 'tm 'cbvk_) c)))))
    (dk-project! ut (lambda () (mac-h 'is-power-bounded-by pb)))
    ;; I in S
    (dk-have! `(IN ,cq4-id ,s)
      (lambda ()
        (cq4-in-bcl! cq4-id s
          (lambda (jv)
            (cq4-ty! (cq4-pw 'tm jv) 'n 'n)
            (dk-cite! 'identmat-left-identity cq4-v 'n 'n (cq4-pw 'tm jv))
            (subst `(= ,(cq4-mm cq4-id (cq4-pw 'tm jv)) ,(cq4-pw 'tm jv)))
            (dk-apply! (dk-ctx-form ut) jv)
            (dk-ass!)))))
    ;; 0 in S
    (dk-have! `(IN ,cq4-z ,s)
      (lambda ()
        (cq4-in-bcl! cq4-z s
          (lambda (jv)
            (cq4-ty! (cq4-pw 'tm jv) 'n 'n)
            (dk-cite! 'cq4-zero-mul-left 'K 'n (cq4-pw 'tm jv))
            (subst `(= ,(cq4-mm cq4-z (cq4-pw 'tm jv)) ,cq4-z))
            (dk-cite! 'cq4-zero-bound 'K 'n 'n 'c)
            (dk-ass!)))))
    ;; X T
    (dk-have! (cq4-h3-of s)
      (lambda ()
        (let* ((landed (dk-peel!)) (x (cadr (car landed))) (ux (cq4-bcl-univ! x s)) (xt (cq4-mm x 'tm)))
          (cq4-in-bcl! xt s
            (lambda (jv)
              (let ((pj (cq4-pw 'tm jv)) (pj1 (cq4-pw 'tm `(succ ,jv))))
                (cq4-ty! pj 'n 'n)
                (cq4-to-v! x 'n 'n) (cq4-to-v! 'tm 'n 'n)
                (cq4-guard! '(IMPLIES (= n 0) (OR (= n 0) (AND (= n 0) (= n 0)))))
                (dk-cite! 'matmul-assoc cq4-v 'n 'n 'n 'n x 'tm pj)
                (subst `(= ,(cq4-mm xt pj) ,(cq4-mm x (cq4-mm 'tm pj))))
                (dk-cite! 'cq4-pow-succ 'K 'n 'tm jv)
                (subst `(= ,(cq4-mm 'tm pj) ,pj1))
                (dk-cite! 'nn-succ-closed jv)
                (dk-apply! ux `(succ ,jv))
                (dk-ass!)))))))
    ;; X + Y
    (dk-have! (cq4-h4-of s)
      (lambda ()
        (let* ((landed (dk-peel!))
               (xs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) s))) landed)))
               (x (car xs)) (y (cadr xs))
               (ux (cq4-bcl-univ! x s)) (uy (cq4-bcl-univ! y s)) (xy (cq4-ma x y)))
          (cq4-in-bcl! xy s
            (lambda (jv)
              (let ((pj (cq4-pw 'tm jv)))
                (cq4-ty! pj 'n 'n)
                (cq4-to-v! x 'n 'n) (cq4-to-v! y 'n 'n)
                (cq4-guard! '(IMPLIES (= n 0) (OR (= n 0) (= n 0))))
                (dk-cite! 'matmul-right-dist-guarded cq4-v 'n 'n 'n x y pj)
                (subst `(= ,(cq4-mm xy pj) ,(cq4-ma (cq4-mm x pj) (cq4-mm y pj))))
                (dk-apply! ux jv) (dk-apply! uy jv)
                (dk-cite! 'cb3-mat-bound-add 'K 'n 'n (cq4-mm x pj) (cq4-mm y pj) 'c)
                (dk-ass!)))))))
    ;; c X, |c| <= 1
    (dk-have! (cq4-h5-of s)
      (lambda ()
        (let* ((landed (dk-peel!))
               (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) s))) landed)))
               (cv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(NV-INTEGERS K)))) landed)))
               (ux (cq4-bcl-univ! x s)) (cx (cq4-ms cv x)))
          (cq4-nvint! cv)
          (cq4-in-bcl! cx s
            (lambda (jv)
              (let ((pj (cq4-pw 'tm jv)))
                (cq4-ty! pj 'n 'n)
                (dk-cite! 'cq4-matscale-mul-left 'K 'n cv x pj)
                (subst `(= ,(cq4-mm cx pj) ,(cq4-ms cv (cq4-mm x pj))))
                (dk-apply! ux jv)
                (dk-cite! 'cq4-scale-bound 'K 'n 'n cv 'c (cq4-mm x pj))
                (dk-ass!)))))))
    (dk-cite! 'cq4-zalg-induction 'K 'n 'tm s)
    (dk-apply! (dk-ctx-form `(FORALL zkp_ (IMPLIES (IN zkp_ ,cq4-alg) (IN zkp_ ,s)))) 'zkp_)
    (dk-apply! (cq4-bcl-univ! 'zkp_ s) 'j)
    (dk-ass!)))
(cq4-qed! 'cq4-zalg-bounded)

