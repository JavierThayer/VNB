;; THE INDUCTION over Z(K)[T], into any class zks_
(define cq4-h3 `(FORALL zkx_ (IMPLIES (IN zkx_ zks_) (IN ,(cq4-mm 'zkx_ 'tm) zks_))))
(define cq4-h4 `(FORALL zkx_ (IMPLIES (IN zkx_ zks_) (FORALL zky_ (IMPLIES (IN zky_ zks_) (IN ,(cq4-ma 'zkx_ 'zky_) zks_))))))
(define cq4-h5 `(FORALL zkx_ (IMPLIES (IN zkx_ zks_) (FORALL zkc_ (IMPLIES (IN zkc_ (NV-INTEGERS K)) (IN ,(cq4-ms 'zkc_ 'zkx_) zks_))))))
(sp (make-wff (cq4-stmt '() '()
  `(FORALL zks_ (IMPLIES (IN ,cq4-id zks_) (IMPLIES (IN ,cq4-z zks_) (IMPLIES ,cq4-h3 (IMPLIES ,cq4-h4 (IMPLIES ,cq4-h5
     (FORALL zkp_ (IMPLIES (IN zkp_ ,cq4-alg) (IN zkp_ zks_))))))))))))
(let* ((landed (dk-peel!))
       (pm (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cq4-alg))) landed))
       (p (cadr pm))
       (allp (cq4-alg-all! p))
       (tcl `(SEP zkt_ ,(cq4-mat 'n 'n) (IN zkt_ zks_))))
  (cq4-view!)
  (dk-cite! 'ring-carr-in-set cq4-v)
  (dk-have! '(IN (CARR K) SET) (lambda () (subst `(= (CARR K) (CARR ,cq4-v))) (dk-ass!)))
  (dk-cite! 'mat-is-set '(CARR K) 'n 'n)
  (dk-have! `(IN ,tcl SET) (lambda () (sep-set) (dk-ass!)))
  (dk-have! `(IN ,tcl ,cq4-F)
    (lambda ()
      (in-sep!
        (lambda ()
          (dk-have! `(FORALL zkz_ (IMPLIES (IN zkz_ ,tcl) (IN zkz_ ,(cq4-mat 'n 'n))))
            (lambda ()
              (let* ((l2 (dk-peel!)) (zm (car l2)))
                (sep-me zm)
                (dk-ass!))))
          (dk-cite! 'power-mem-intro (cq4-mat 'n 'n) tcl)
          (dk-ass!))
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'IN)
                  (begin
                    (cq4-ty! (cadr (dk-goal)) 'n 'n)
                    (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!))))
                  (let* ((l3 (dk-peel!))
                         (tm-of (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) tcl))))
                         (xs (map cadr (filter tm-of l3)))
                         (cs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(NV-INTEGERS K)))) l3)))
                         (term (cadr (dk-goal))))
                    (for-each (lambda (x) (sep-me `(IN ,x ,tcl))) xs)
                    (for-each cq4-nvint! cs)
                    (cq4-ty! term 'n 'n)
                    (in-sep! (lambda () (dk-ass!))
                      (lambda ()
                        (cond ((eq? (car term) 'MATMUL) (dk-apply! (dk-ctx-form cq4-h3) (car xs)))
                              ((eq? (car term) 'MATADD) (dk-apply! (dk-ctx-form cq4-h4) (car xs) (cadr xs)))
                              (#t (dk-apply! (dk-ctx-form cq4-h5) (car xs) (car cs))))
                        (dk-ass!)))))))))))
  (dk-apply! allp tcl)
  (sep-me `(IN ,p ,tcl))
  (dk-ass!))
(cq4-qed! 'cq4-zalg-induction)

