;; the ring view of a normed field is a field ring
(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (IS-FIELD-RING ,cq4-v)))))
(dk-peel!)
(cq4-view!)
(mac 'is-field-ring-def)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
       ((dk-asm? g) (dk-ass!))
       ((dk-head-is? g 'NOT)
        (let ((neg (dk-cite! 'nf-zero-ne-one 'K)))
          (subst `(= (ONE ,cq4-v) (ONE K)))
          (subst `(= (ZERO ,cq4-v) (ZERO K)))
          (di)
          (dk-have! '(= (ZERO K) (ONE K)) (lambda () (subst '(= (ZERO K) (ONE K))) (rfl)))
          (dk-only! neg '(= (ZERO K) (ONE K)))
          (prop)))
       (#t
        (subst `(= (CARR ,cq4-v) (CARR K)))
        (subst `(= (ZERO ,cq4-v) (ZERO K)))
        (subst `(= (MUL ,cq4-v) (MUL K)))
        (subst `(= (ONE ,cq4-v) (ONE K)))
        (let* ((landed (dk-peel!))
               (am (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(CARR K)))) landed))
               (a (cadr am))
               (ex (dk-cite! 'nf-inverse 'K a))
               (y (dk-skolem! ex)))
          (ew y)
          (dk-conj-close! (lambda () (dk-ass!)))))))))
(cq4-qed! 'cq4-view-field-ring)

;; MAT-POWER typing
(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN)
  (FORALL tm (IMPLIES (IN tm ,(cq4-mat 'n 'n)) (FORALL j (IMPLIES (IN j NN)
