;; 0 X = 0
(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL zkp_ (IMPLIES (IN zkp_ ,(cq4-mat 'n 'n))
  (= ,(cq4-mm cq4-z 'zkp_) ,cq4-z)))))))))
