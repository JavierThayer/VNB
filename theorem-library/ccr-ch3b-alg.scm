;;; A1. Max-norm bounds of the zero matrix and of a scalar multiple.

(define (cq4-bound-univ a m n c)
  `(FORALL cbvi_ (IMPLIES (IN cbvi_ (INTERVAL 1 ,m))
     (FORALL cbvj_ (IMPLIES (IN cbvj_ (INTERVAL 1 ,n)) (<= ,(cq4-n `(ENTRY ,a cbvi_ cbvj_)) ,c))))))
;; with (IS-MAT-BOUND K m n A c) in context: land A's typing and the entry bound, keep the hypothesis
(define (cq4-bound-parts! a m n c)
  (let ((h `(IS-MAT-BOUND K ,m ,n ,a ,c)))
    (dk-project! `(IN ,a ,(cq4-mat m n)) (lambda () (mac-h 'is-mat-bound h)))
    (dk-project! (cq4-bound-univ a m n c) (lambda () (mac-h 'is-mat-bound h)))))
;; the goal IS-MAT-BOUND K m n A c, A typed: unfold and hand each entry (i j) to ENTRY-THUNK
(define (cq4-bound-goal! entry-thunk)
  (mac 'is-mat-bound)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IN)
          (dk-ass!)
          (begin
            (dk-peel!)
            (let* ((g (dk-goal)) (en (cadr (cadr g))))
              (entry-thunk (caddr en) (cadddr en))))))))

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL m (IMPLIES (IN m NN) (FORALL n (IMPLIES (IN n NN)
  (FORALL c (IMPLIES (IN c RR) (IMPLIES (<= 0 c) (IS-MAT-BOUND K m n (ZEROMAT ,cq4-v m n) c))))))))))))
(dk-peel!)
(cq4-view!)
(cq4-ty! `(ZEROMAT ,cq4-v m n) 'm 'n)
(cq4-bound-goal!
  (lambda (iv jv)
    (dk-cite! 'entry-of-zeromat cq4-v 'm 'n iv jv)
    (subst `(= (ENTRY (ZEROMAT ,cq4-v m n) ,iv ,jv) (ZERO ,cq4-v)))
    (subst `(= (ZERO ,cq4-v) (ZERO K)))
    (dk-cite! 'nf-norm-of-zero 'K)
    (subst `(= ,(cq4-n '(ZERO K)) 0))
    (dk-ass!)))
(cq4-qed! 'cq4-zero-bound)

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL m (FORALL n (FORALL c (IMPLIES (IN c (CARR K))
  (IMPLIES (<= ,(cq4-n 'c) 1) (FORALL b (IMPLIES (IN b RR) (IMPLIES (<= 0 b) (FORALL zka_
    (IMPLIES (IS-MAT-BOUND K m n zka_ b) (IS-MAT-BOUND K m n ,(cq4-ms 'c 'zka_) b)))))))))))))))
(dk-peel!)
(cq4-view!)
(let ((bu (cq4-bound-parts! 'zka_ 'm 'n 'b)))
  (cq4-ty! (cq4-ms 'c 'zka_) 'm 'n)
  (cq4-bound-goal!
    (lambda (iv jv)
      (let ((ae `(ENTRY zka_ ,iv ,jv)))
        (dk-cite! 'matscale-entry cq4-v 'm 'n 'c 'zka_ iv jv)
        (subst `(= (ENTRY ,(cq4-ms 'c 'zka_) ,iv ,jv) ((MUL ,cq4-v) c ,ae)))
        (subst `(= (MUL ,cq4-v) (MUL K)))
        (dk-cite! 'entry-in-carrier 'm 'n '(CARR K) 'zka_ iv jv)
        (dk-cite! 'nf-norm-mult 'K 'c ae)
        (subst `(= ,(cq4-n `((MUL K) c ,ae)) (* ,(cq4-n 'c) ,(cq4-n ae))))
        (dk-cite! 'nf-norm-in-rr 'K 'c) (dk-cite! 'nf-norm-in-rr 'K ae)
        (dk-cite! 'nf-norm-nonneg 'K 'c) (dk-cite! 'nf-norm-nonneg 'K ae)
        (dk-apply! bu iv jv)
        (dk-cite! 'rr-one-in)
        (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
        (let ((pr (dk-cite! 'rr-prod-le-gen (cq4-n 'c) (cq4-n ae) 1 'b)))
          (dk-have! '(= (* 1 b) b) (lambda () (crs)))
          (dk-rewrite-h! pr '(* 1 b) 'b)
          (dk-ass!))))))
(cq4-qed! 'cq4-scale-bound)

(sp (make-wff `(FORALL K (FORALL c (IMPLIES (IN c (NV-INTEGERS K)) (AND (IN c (CARR K)) (<= ,(cq4-n 'c) 1)))))))
(dk-peel!)
(dk-cite! 'nv-integers-unfold 'K)
(let ((m2 (dk-rewrite-h! '(IN c (NV-INTEGERS K)) '(NV-INTEGERS K)
