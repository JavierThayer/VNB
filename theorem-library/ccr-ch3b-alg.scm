(sp (make-wff `(FORALL K (FORALL c (IMPLIES (IN c (CARR K)) (IMPLIES (<= ,(cq4-n 'c) 1) (IN c (NV-INTEGERS K))))))))
(dk-peel!)
(dk-cite! 'nv-integers-unfold 'K)
(subst `(= (NV-INTEGERS K) (SEP cwx_ (CARR K) (<= ,(cq4-n 'cwx_) 1))))
(in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))
(cq4-qed! 'cq4-nvint-intro)

;;; =======================================================================
;;; A2. Z(K)[T] = ZPOLY-ALG(K, n, T): the family, membership, closure, induction.

(define (cq4-zbody s)
  `(AND (IN ,cq4-id ,s)
   (AND (IN ,cq4-z ,s)
   (AND (FORALL zkvx_ (IMPLIES (IN zkvx_ ,s) (IN ,(cq4-mm 'zkvx_ 'tm) ,s)))
   (AND (FORALL zkvx_ (IMPLIES (IN zkvx_ ,s) (FORALL zkvy_ (IMPLIES (IN zkvy_ ,s) (IN ,(cq4-ma 'zkvx_ 'zkvy_) ,s)))))
        (FORALL zkvx_ (IMPLIES (IN zkvx_ ,s) (FORALL zkvc_ (IMPLIES (IN zkvc_ (NV-INTEGERS K))
          (IN ,(cq4-ms 'zkvc_ 'zkvx_) ,s))))))))))
(define cq4-F `(SEP zkvs_ (POWER ,(cq4-mat 'n 'n)) ,(cq4-zbody 'zkvs_)))
(define cq4-int `(INTERSECTION-OF ,cq4-F))
(define cq4-alg '(ZPOLY-ALG K n tm))
(define cq4-hyps '((IS-NORMED-FIELD K) (IN n NN)))
(define (cq4-stmt vars hyps concl)     ; FORALL K n tm, the standing hypotheses, tm typed, FORALL VARS, HYPS => CONCL
  `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL tm (IMPLIES (IN tm ,(cq4-mat 'n 'n))
     ,(let vl ((vs vars))
        (if (null? vs)
            (let loop ((hs hyps)) (if (null? hs) concl `(IMPLIES ,(car hs) ,(loop (cdr hs)))))
            `(FORALL ,(car vs) ,(vl (cdr vs))))))))))))
;; split (IN c (NV-INTEGERS K)) into its two parts, keeping it
(define (cq4-nvint! c)
  (let ((pr (dk-cite! 'cq4-nvint-parts 'K c)))
    (if (and (pair? pr) (eq? (car pr) 'AND)) (dk-split! pr))))

(sp (make-wff `(FORALL K (FORALL n (FORALL tm (== ,cq4-alg ,cq4-int))))))
(dk-peel!)
(mac 'ZPOLY-ALG)
(qrfl)
(cq4-qed! 'cq4-zalg-unfold)

(sp (make-wff (cq4-stmt '() '() `(IN ,(cq4-mat 'n 'n) ,cq4-F))))
(dk-peel!)
(cq4-view!)
(dk-cite! 'ring-carr-in-set cq4-v)
(dk-have! '(IN (CARR K) SET) (lambda () (subst `(= (CARR K) (CARR ,cq4-v))) (dk-ass!)))
(dk-cite! 'mat-is-set '(CARR K) 'n 'n)
(dk-cite! 'power-whole-in (cq4-mat 'n 'n))
(in-sep! (lambda () (dk-ass!))
  (lambda ()
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IN)
            (begin (cq4-ty! (cadr (dk-goal)) 'n 'n) (dk-ass!))
            (let ((landed (dk-peel!)))
              (for-each (lambda (f) (if (and (dk-head-is? f 'IN) (equal? (caddr f) '(NV-INTEGERS K))) (cq4-nvint! (cadr f))))
                        landed)
              (cq4-ty! (cadr (dk-goal)) 'n 'n)
              (dk-ass!)))))))
(cq4-qed! 'cq4-zalg-fam-has-mat)

;; with (IN P ALG) in context, land (and return) forall u in F. P in u
(define (cq4-all-of p) `(FORALL iou_ (IMPLIES (IN iou_ ,cq4-F) (IN ,p iou_))))
(define (cq4-alg-all! p)
  (let ((mem `(IN ,p ,cq4-alg)) (all (cq4-all-of p)))
    (if (not (dk-asm? all))
        (begin
          (dk-cite! 'cq4-zalg-unfold 'K 'n 'tm)
          (let* ((m2 (dk-rewrite-h! mem cq4-alg cq4-int))
                 (iff (dk-cite! 'intersection-of-membership cq4-F p)))
            (dk-have! all (lambda () (dk-only! iff m2) (prop))))))
    (dk-ctx-form all)))
;; prove the goal (IN P ALG) from BODY, called with U, proving (IN P U) with (IN U F) in context
(define (cq4-alg-intro! p body)
  (dk-cite! 'cq4-zalg-unfold 'K 'n 'tm)
  (subst `(= ,cq4-alg ,cq4-int))
  (dk-cite! 'cq4-zalg-fam-has-mat 'K 'n 'tm)
  (let* ((iff (dk-cite! 'intersection-of-membership cq4-F p))
         (inh (cadr (caddr iff)))
         (all (caddr (caddr iff))))
    (dk-have! inh (lambda () (ew (cq4-mat 'n 'n)) (dk-ass!)))
    (dk-have! all
      (lambda ()
        (let* ((landed (dk-peel!))
               (uf (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cq4-F))) landed)))
          (body (cadr uf)))))
    (dk-only! iff inh all)
    (prop)))
;; with (IN U F) in context (kept), land the five closure parts of U and return them in order
(define (cq4-fam-parts! u)
  (dk-have! (cq4-zbody u) (lambda () (sep-me `(IN ,u ,cq4-F)) (dk-ass!)))
  (let* ((zb (dk-ctx-form (cq4-zbody u)))
         (parts (list (cadr zb) (cadr (caddr zb)) (cadr (caddr (caddr zb)))
                      (cadr (caddr (caddr (caddr zb)))) (caddr (caddr (caddr (caddr zb)))))))
    (dk-split-all!)
    (for-each (lambda (f) (if (not (dk-asm? f)) (error "cq4-fam-parts!: part not landed" f))) parts)
    parts))

(sp (make-wff (cq4-stmt '(zkp_) `((IN zkp_ ,cq4-alg)) `(IN zkp_ ,(cq4-mat 'n 'n)))))
(dk-peel!)
(dk-cite! 'cq4-zalg-fam-has-mat 'K 'n 'tm)
(dk-apply! (cq4-alg-all! 'zkp_) (cq4-mat 'n 'n))
(dk-ass!)
