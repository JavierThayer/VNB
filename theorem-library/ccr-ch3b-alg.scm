;;; Library: analysis.

;;; ccr-ch3b-alg.scm -- CCR.pdf chapter 3, second pass, the ALGEBRA: Proposition 3.3 (polynomial clause,
;;; coefficients in Z(K)), and "det B = 0 implies B eta = 0 for some eta /= 0" (used by Lemma 3.4).
;;; Vocabulary: structure-library/ccr-ch3-vocab.scm, structure-library/ccr-ch3b-vocab.scm.
;;; Agent CCR-1109-B2, wave 2026-11-09.  Destination: theorem-library/ccr-ch3b-alg.scm.
;;; Library: analysis.  Helper prefix cq4-.
;;;
;;; PLAN, Proposition 3.3 (polynomials).  The notes' clause "any polynomial p(T) of a power bounded operator
;;; is power bounded" is FALSE for coefficients outside the valuation ring (p(T) = (1/p) I over Q_p has the
;;; unbounded powers p^(-k) I); the guard is "coefficients in Z(K)".  The proof here is not the induction
;;; on the degree through 3.3's sum and product clauses: it goes through the Z(K)-algebra generated by T,
;;; ZPOLY-ALG(K, n, T), the least set of matrices containing I and 0 and closed under X |-> X T, +, and
;;; scalars of norm <= 1.
;;;   (a) every X in Z(K)[T] satisfies ||X T^k||_max <= C_T for every k: the class of such X contains I and 0
;;;       and is closed under the four operations (the ultrametric inequality for +, |c| <= 1 for scalars,
;;;       (X T) T^k = X T^(k+1));
;;;   (b) Z(K)[T] is closed under products (for fixed X in it, the class of Y with X Y in it is closed);
;;;   (c) so every power X^k is in Z(K)[T] and ||X^k||_max <= C_T: X is power bounded, with T's constant;
;;;   (d) p(T) is in Z(K)[T] when every |p(k)| <= 1.
;;;
;;; PLAN, the kernel vector.  det B = 0 => B is not invertible (invertible-iff-det-nonzero over the field
;;; ring V).  Reduce B by columns (column-step-reduced): C = B P with P a product of elementary matrices
;;; and every row of C in reduced column step form.  If every diagonal entry of C is 1 then C = I and B is
;;; invertible; otherwise let i0 be the LARGEST index with C_(i0 i0) = 0 (least d with i0 + d = n,
;;; nn-least-element).  Column i0 of C is zero: above the diagonal by column step form, at i0 by choice,
;;; below because every row k > i0 has C_kk = 1 and is then the unit row.  So eta = P e_(i0) has
;;; B eta = C e_(i0) = 0, and eta /= 0 since P is invertible.
;;;
;;; LOAD WINDOW: after theorem-library/ccr-ch3-ops (cb3-mr-ring, cb3-mr-carr, cb3-mr-mul-apply,
;;; cb3-mr-add-apply, cb3-mat-power-unfold, cb3-mat-bound-add, IS-POWER-BOUNDED-BY's laws) and
;;; structure-library/ccr-ch3b-vocab; the other citations (mat-ring, matrix laws, la-elem-gen,
;;; la-elem-gauss, det, ccr2-nv) load earlier.

(define cq4-v '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define (cq4-mat r c) `(MAT ,r ,c (CARR K)))
(define (cq4-matv r c) `(MAT ,r ,c (CARR ,cq4-v)))
(define cq4-mr `(MAT-RING ,cq4-v n))
(define cq4-mrm `(RING-MULTIPLICATIVE-MONOID ,cq4-mr))
(define (cq4-mm a b) `(MATMUL ,cq4-v ,a ,b))
(define (cq4-ma a b) `(MATADD ,cq4-v ,a ,b))
(define (cq4-ms c a) `(MATSCALE ,cq4-v ,c ,a))
(define cq4-id `(IDENTMAT ,cq4-v n))
(define cq4-z `(ZEROMAT ,cq4-v n n))
(define (cq4-n x) `((FNRM K) ,x))
(define (cq4-pw x kk) `(MAT-POWER K n ,x ,kk))

;; first subterm of TREE satisfying PRED
(define (cq4-find pred tree)
  (cond ((pred tree) tree)
        ((pair? tree) (or (cq4-find pred (car tree)) (cq4-find pred (cdr tree))))
        (#t #f)))

;; the view's read-offs (K a normed field in context)
(define (cq4-view!)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
  (dk-cite! 'commutative-ring-is-ring cq4-v)
  (for-each (lambda (r) (dk-cite! r 'K))
            '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
              normed-field-ring-view-one normed-field-ring-view-zero normed-field-ring-view-neg)))
(define (cq4-to-v! a r c)
  (if (not (dk-asm? `(IN ,a ,(cq4-matv r c))))
      (dk-have! `(IN ,a ,(cq4-matv r c)) (lambda () (subst `(= (CARR ,cq4-v) (CARR K))) (dk-ass!)))))
(define (cq4-to-k! a r c)
  (if (not (dk-asm? `(IN ,a ,(cq4-mat r c))))
      (dk-have! `(IN ,a ,(cq4-mat r c)) (lambda () (subst `(= (CARR K) (CARR ,cq4-v))) (dk-ass!)))))
(define (cq4-sc-v! s)                   ; s in CARR K  ->  s in CARR V
  (if (not (dk-asm? `(IN ,s (CARR ,cq4-v))))
      (dk-have! `(IN ,s (CARR ,cq4-v)) (lambda () (subst `(= (CARR ,cq4-v) (CARR K))) (dk-ass!)))))
(define (cq4-guard! g) (if (not (dk-asm? g)) (dk-have! g (lambda () (prop)))))

;; type a matrix term built from typed n-by-n (or n-by-1) matrices: lands both the K and V forms.
;; R C: its size.  Handles MATMUL (left factor n-by-n), MATADD, MATSCALE, IDENTMAT, ZEROMAT, MAT-POWER.
(define (cq4-ty! t r c)
  (cond
   ((dk-asm? `(IN ,t ,(cq4-mat r c))) (cq4-to-v! t r c))
   ((dk-asm? `(IN ,t ,(cq4-matv r c))) (cq4-to-k! t r c))
   ((and (pair? t) (eq? (car t) 'MATMUL))
    (cq4-ty! (caddr t) r 'n) (cq4-ty! (cadddr t) 'n c)
    (cq4-guard! `(IMPLIES (= n 0) (OR (= ,r 0) (= ,c 0))))
    (dk-cite! 'matmul-type cq4-v r 'n c (caddr t) (cadddr t))
    (cq4-to-k! t r c))
   ((and (pair? t) (eq? (car t) 'MATADD))
    (cq4-ty! (caddr t) r c) (cq4-ty! (cadddr t) r c)
    (dk-cite! 'matadd-type cq4-v r c (caddr t) (cadddr t))
    (cq4-to-k! t r c))
   ((and (pair? t) (eq? (car t) 'MATSCALE))
    (cq4-sc-v! (caddr t)) (cq4-ty! (cadddr t) r c)
    (dk-cite! 'matscale-type cq4-v r c (caddr t) (cadddr t))
    (cq4-to-k! t r c))
   ((and (pair? t) (eq? (car t) 'IDENTMAT))
    (dk-cite! 'identmat-type cq4-v (caddr t))
    (cq4-to-k! t r c))
   ((and (pair? t) (eq? (car t) 'ZEROMAT))
    (dk-cite! 'zeromat-type cq4-v r c)
    (cq4-to-k! t r c))
   ((and (pair? t) (eq? (car t) 'MAT-POWER))
    (cq4-ty! (cadddr t) 'n 'n)
    (dk-cite! 'cq4-mat-power-type 'K 'n (cadddr t) (car (cddddr t)))
    (cq4-to-v! t 'n 'n))
   (#t (error "cq4-ty!: cannot type" (expression->string t)))))


;; qed, after listing the open leaves (with their contexts' last formulas) when the proof is not done
(define (cq4-qed! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; cq4: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l)
                    (display ";;   GOAL ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (f) (display ";;      | ") (display (expression->string f)) (newline))
                              (let ((a (dk-asms-of l))) (list-head a (min 8 (length a))))))
                  (dk-open-leaves))))
  (qed name))

