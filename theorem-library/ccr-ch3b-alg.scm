(cq4-qed! 'cq4-mat-power-type)

;; case split on an OR in context: THUNK1 runs on the leaf holding the left disjunct, THUNK2 on the other
(define (cq4-or! o thunk1 thunk2)
  (dk-each-leaf! (lambda () (ai o))
    (lambda () (if (dk-asm? (cadr o)) (thunk1) (thunk2)))))

;; n = 0: every universal over INTERVAL(1, n) is vacuous; prove (FORALL i (IMPLIES (IN i (INTERVAL 1 n)) ..))
;; style goals by contradiction.  (= n 0) in context.
(define (cq4-vacuous!)
  (let* ((landed (dk-peel!))
         (im (find-first (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (eq? (car (caddr f)) 'INTERVAL))) landed))
         (iv (cadr im)) (hi (caddr (caddr im))))
    (dk-cite! 'interval-lo 1 hi iv)
    (dk-cite! 'interval-hi 1 hi iv)
    (dk-cite! 'interval-elt-in-nn 1 hi iv)
    (dk-have! '(< 0 0) (lambda () (dk-nn! `(<= 1 ,iv) `(<= ,iv ,hi) `(= ,hi 0))))
    (dk-absurd! '(< 0 0))))

;; equality of two n-by-n (or n-by-1) matrices over V when n = 0, both typed
(define (cq4-eq-n0! lhs rhs c)
  (cq4-ty! lhs 'n c) (cq4-ty! rhs 'n c)
  (dk-have! `(FORALL zki_ (IMPLIES (IN zki_ (INTERVAL 1 n)) (FORALL zkj_ (IMPLIES (IN zkj_ (INTERVAL 1 ,c))
               (= (ENTRY ,lhs zki_ zkj_) (ENTRY ,rhs zki_ zkj_))))))
    (lambda () (cq4-vacuous!)))
  (dk-cite! 'matrix-entry-extensionality 'n c `(CARR ,cq4-v) lhs rhs)
  (dk-ass!))

;; MATSCALE commutes with MATMUL, at every size n (matmul-matscale-left / -right are stated at succ(n))
(define (cq4-ms-mul-stmt side)
  `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN)
     (FORALL c (IMPLIES (IN c (CARR K)) (FORALL zkp_ (FORALL zkq_
       (IMPLIES (IN zkp_ ,(cq4-mat 'n 'n)) (IMPLIES (IN zkq_ ,(cq4-mat 'n 'n))
         ,(if (eq? side 'left)
              `(= ,(cq4-mm (cq4-ms 'c 'zkp_) 'zkq_) ,(cq4-ms 'c (cq4-mm 'zkp_ 'zkq_)))
              `(= ,(cq4-mm 'zkp_ (cq4-ms 'c 'zkq_)) ,(cq4-ms 'c (cq4-mm 'zkp_ 'zkq_)))))))))))))))
(define (cq4-ms-mul! side)
  (dk-peel!)
  (cq4-view!)
  (let* ((g (dk-goal)) (lhs (cadr g)) (rhs (caddr g)))
    (cq4-sc-v! 'c)
    (cq4-to-v! 'zkp_ 'n 'n) (cq4-to-v! 'zkq_ 'n 'n)
    (cq4-or! (dk-cite! 'nn-zero-or-succ 'n)
      (lambda () (cq4-eq-n0! lhs rhs 'n))
      (lambda ()
        (let* ((ex (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "n = succ(q)"))
               (q (dk-skolem! ex))
               (eqn `(= n (succ ,q))))
          (dk-rewrite-h! `(IN zkp_ ,(cq4-matv 'n 'n)) 'n `(succ ,q))
          (dk-rewrite-h! `(IN zkq_ ,(cq4-matv 'n 'n)) 'n `(succ ,q))
          (dk-cite! (if (eq? side 'left) 'matmul-matscale-left 'matmul-matscale-right) cq4-v q 'zkp_ 'zkq_ 'c)
          (dk-ass!))))))
(sp (make-wff (cq4-ms-mul-stmt 'left)))
(cq4-ms-mul! 'left)
(cq4-qed! 'cq4-matscale-mul-left)
(sp (make-wff (cq4-ms-mul-stmt 'right)))
(cq4-ms-mul! 'right)
(cq4-qed! 'cq4-matscale-mul-right)

