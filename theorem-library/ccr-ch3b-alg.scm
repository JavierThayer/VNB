;;; C. det B = 0 gives a non-zero kernel vector (over a field ring R).

(define (cq4-iv n) `(INTERVAL 1 ,n))
(define cq4-rows '(FORALL zkr_ (IMPLIES (IN zkr_ (INTERVAL 1 n)) (COL-STEP-ROW R n C zkr_))))
(define (cq4-row1 i) `(FORALL csj_ (IMPLIES (IN csj_ (INTERVAL 1 n)) (IMPLIES (< ,i csj_) (= (ENTRY C ,i csj_) (ZERO R))))))
(define (cq4-row2 i)
  `(IMPLIES (IN ,i (INTERVAL 1 n))
     (AND (OR (= (ENTRY C ,i ,i) (ZERO R)) (= (ENTRY C ,i ,i) (ONE R)))
          (IMPLIES (= (ENTRY C ,i ,i) (ONE R))
            (FORALL csj_ (IMPLIES (IN csj_ (INTERVAL 1 n))
              (IMPLIES (NOT (= csj_ ,i)) (= (ENTRY C ,i csj_) (ZERO R)))))))))
;; row I of C (I in [1, n] in context): land both conjuncts of COL-STEP-ROW R n C I, and the
;; disjunction and unit-row clause of the second; returns (row1 disj unit)
(define (cq4-row! i)
  (let ((h `(COL-STEP-ROW R n C ,i)))
    (if (not (dk-asm? h)) (dk-apply! (dk-ctx-form cq4-rows) i))
    (dk-project! (cq4-row1 i) (lambda () (mac-h 'col-step-row h)))
    (dk-project! (cq4-row2 i) (lambda () (mac-h 'col-step-row h)))
    (let* ((r2 (cq4-row2 i)) (conj (caddr r2)))
      (if (not (dk-asm? conj)) (detach! (dk-ctx-form r2)))
      (dk-split! (dk-ctx-form conj))
      (list (cq4-row1 i) (cadr conj) (caddr conj)))))
(define (cq4-nn-rr! i)                  ; i in [1, n]: i in NN, i in RR, 1 <= i <= n
  (dk-cite! 'interval-elt-in-nn 1 'n i)
  (dk-cite! 'nn-in-rr i)
  (dk-cite! 'interval-lo 1 'n i)
  (dk-cite! 'interval-hi 1 'n i))
(define (cq4-neq! a b lt)               ; NOT (a = b) from the strict LT in context
  (if (not (dk-asm? `(NOT (= ,a ,b))))
      (dk-have! `(NOT (= ,a ,b))
        (lambda ()
          (di)
          (dk-have! '(< 0 0) (lambda () (dk-nn! lt `(= ,a ,b))))
          (dk-absurd! '(< 0 0))))))

(define cq4-c-hyps
  '((IS-RING R) (IN n NN) (IN C (MAT n n (CARR R)))))
(define (cq4-r-stmt vars hyps concl)
  `(FORALL R (FORALL n (FORALL C ,(let vl ((vs vars))
     (if (null? vs)
         (let loop ((hs (append cq4-c-hyps (cons cq4-rows hyps))))
           (if (null? hs) concl `(IMPLIES ,(car hs) ,(loop (cdr hs)))))
         `(FORALL ,(car vs) ,(vl (cdr vs)))))))))

;; C1: if C_(i0 i0) = 0 and C_kk = 1 for every k > i0, column i0 of C is zero
(define cq4-above '(FORALL zkk_ (IMPLIES (IN zkk_ (INTERVAL 1 n)) (IMPLIES (< zio_ zkk_) (= (ENTRY C zkk_ zkk_) (ONE R))))))
(sp (make-wff (cq4-r-stmt '(zio_) `((IN zio_ (INTERVAL 1 n)) (= (ENTRY C zio_ zio_) (ZERO R)) ,cq4-above)
  '(FORALL zkk_ (IMPLIES (IN zkk_ (INTERVAL 1 n)) (= (ENTRY C zkk_ zio_) (ZERO R)))))))
(let* ((landed (dk-peel!))
       (kv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 n)) (not (eq? (cadr f) 'zio_)))) landed))))
  (cq4-nn-rr! kv) (cq4-nn-rr! 'zio_)
  (let ((tri (dk-apply! (dk-cite! 'rr-lt-trichotomy kv 'zio_))))
    (cq4-or! tri
      (lambda ()
        (let ((parts (cq4-row! kv)))
          (dk-apply! (dk-ctx-form (car parts)) 'zio_)
          (dk-ass!)))
      (lambda ()
        (cq4-or! (caddr tri)
          (lambda () (subst `(= ,kv zio_)) (dk-ass!))
          (lambda ()
            (dk-apply! (dk-ctx-form cq4-above) kv)
            (let ((parts (cq4-row! kv)))
              (detach! (dk-ctx-form (caddr parts)))
              (cq4-neq! 'zio_ kv `(< zio_ ,kv))
              (dk-apply! (dk-ctx-form (caddr (caddr parts))) 'zio_)
              (dk-ass!))))))))
(cq4-qed! 'cq4-zero-column)

(define (cq4-zdiag c) `(FORSOME zke_ (AND (IN zke_ (INTERVAL 1 n)) (= (ENTRY ,c zke_ zke_) (ZERO R)))))
;; prove (= P Q), both in MAT(n, l, X) in context, entrywise: THUNK gets i j, focus on the entry equation
(define (cq4-ext! p q nr nc x thunk)
  (let ((h `(FORALL zkxi_ (IMPLIES (IN zkxi_ (INTERVAL 1 ,nr)) (FORALL zkxj_ (IMPLIES (IN zkxj_ (INTERVAL 1 ,nc))
              (= (ENTRY ,p zkxi_ zkxj_) (ENTRY ,q zkxi_ zkxj_))))))))
    (dk-have! h
      (lambda ()
        (dk-peel!)
        (let* ((g (dk-goal)) (i (caddr (cadr g))) (j (cadddr (cadr g))))
          (thunk i j))))
    (dk-cite! 'matrix-entry-extensionality nr nc x p q)
    (dk-ass!)))
;; u in [1, 1] in context: subst u := 1 in the goal
(define (cq4-u1! u)
  (dk-cite! 'interval-lo 1 1 u)
  (dk-cite! 'interval-hi 1 1 u)
  (dk-cite! 'interval-elt-in-nn 1 1 u)
  (dk-have! `(= ,u 1) (lambda () (dk-nn! `(<= 1 ,u) `(<= ,u 1))))
  (subst `(= ,u 1)))

;; C2: either some diagonal entry of C is 0, or C = I
(sp (make-wff (cq4-r-stmt '() '() `(OR ,(cq4-zdiag 'C) (= C (IDENTMAT R n))))))
(dk-peel!)
(use-em (cq4-zdiag 'C)
  (lambda () (prop))
  (lambda ()
    (dk-cite! 'identmat-type 'R 'n)
    (let ((one `(FORALL zkk_ (IMPLIES (IN zkk_ (INTERVAL 1 n)) (= (ENTRY C zkk_ zkk_) (ONE R))))))
      (dk-have! one
        (lambda ()
          (let* ((landed (dk-peel!)) (kv (cadr (car landed))) (parts (cq4-row! kv)))
            (cq4-or! (cadr parts)
              (lambda ()
                (dk-have! (cq4-zdiag 'C) (lambda () (ew kv) (dk-conj-close! (lambda () (dk-ass!)))))
                (dk-only! (cq4-zdiag 'C) `(NOT ,(cq4-zdiag 'C)))
                (prop))
              (lambda () (dk-ass!))))))
      (dk-have! '(= C (IDENTMAT R n))
        (lambda ()
          (cq4-ext! 'C '(IDENTMAT R n) 'n 'n '(CARR R)
            (lambda (i j)
              (use-em `(= ,i ,j)
                (lambda ()
                  (subst `(= ,j ,i))
                  (dk-apply! (dk-ctx-form one) i)
                  (dk-cite! 'identmat-entry-diag 'R 'n i)
                  (subst `(= (ENTRY C ,i ,i) (ONE R)))
                  (subst `(= (ENTRY (IDENTMAT R n) ,i ,i) (ONE R)))
                  (rfl))
                (lambda ()
                  (dk-apply! (dk-ctx-form one) i)
                  (let ((parts (cq4-row! i)))
                    (detach! (dk-ctx-form (caddr parts)))
                    (dk-have! `(NOT (= ,j ,i))
                      (lambda ()
                        (di)
                        (dk-have! `(= ,i ,j) (lambda () (subst `(= ,j ,i)) (rfl)))
                        (dk-only! `(= ,i ,j) `(NOT (= ,i ,j)))
                        (prop)))
                    (dk-apply! (dk-ctx-form (caddr (caddr parts))) j)
                    (dk-cite! 'identmat-entry-off 'R 'n i j)
                    (subst `(= (ENTRY C ,i ,j) (ZERO R)))
                    (subst `(= (ENTRY (IDENTMAT R n) ,i ,j) (ZERO R)))
                    (rfl))))))))
      (prop))))
(cq4-qed! 'cq4-diag-zero-or-identity)

;; C3: the LAST zero on the diagonal
(sp (make-wff (cq4-r-stmt '() `(,(cq4-zdiag 'C))
  `(FORSOME zio_ (AND (IN zio_ (INTERVAL 1 n)) (AND (= (ENTRY C zio_ zio_) (ZERO R)) ,cq4-above))))))
(dk-peel!)
(let* ((ev (dk-skolem! (dk-ctx-form (cq4-zdiag 'C)) #t))
       (dd `(SEP zkd_ NN (FORSOME zkf_ (AND (IN zkf_ (INTERVAL 1 n)) (AND (= (ENTRY C zkf_ zkf_) (ZERO R)) (<= n (+ zkf_ zkd_))))))))
  (cq4-nn-rr! ev)
  (dk-have! `(IN n ,dd)
    (lambda ()
      (in-sep! (lambda () (dk-ass!))
        (lambda () (ew ev) (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) '<=) (dk-nn!) (dk-ass!))))))))
  (dk-have! `(AND (SUBSET ,dd NN) (FORSOME zkw_ (IN zkw_ ,dd)))
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORSOME)
              (begin (ew 'n) (dk-ass!))
              (begin
                (mac 'subset-def)
                (let* ((l2 (dk-peel!)) (w (cadr (car l2))))
                  (sep-me `(IN ,w ,dd))
                  (dk-ass!))))))))
  (let* ((mex (dk-cite! 'nn-least-element dd))
         (mv (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (cq4-find (lambda (u) (eq? u 'zkd_)) f)
                                                    (dk-head-is? (caddr f) 'AND))) "least") #t))
         (least (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (cq4-find (lambda (u) (and (pair? u) (eq? (car u) '<=) (pair? (cdr u)) (equal? (cadr u) mv))) f))) "leastness")))
    (dk-have! `(IN ,mv ,dd) (lambda () (dk-ass!)))
    (sep-me `(IN ,mv ,dd))
    (let ((i0 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (cq4-find (lambda (u) (equal? u mv)) f))) "i0") #t)))
      (cq4-nn-rr! i0)
      (ew i0)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-head-is? (dk-goal) 'FORALL))
              (dk-ass!)
              (let* ((l3 (dk-peel!))
                     (kv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 n)))) l3)))
                     (parts (cq4-row! kv)))
                (cq4-nn-rr! kv)
                (cq4-or! (cadr parts)
                  (lambda ()
                    (cq4-or! (dk-apply! (dk-cite! 'nn-zero-or-succ mv))
                      (lambda ()
                        (dk-have! '(< 0 0) (lambda () (dk-nn! `(<= n (+ ,i0 ,mv)) `(= ,mv 0) `(< ,i0 ,kv) `(<= ,kv n))))
                        (dk-absurd! '(< 0 0)))
                      (lambda ()
                        (let* ((qv (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (cq4-find (lambda (u) (equal? u `(succ ,(cadr f)))) f))) "pred") #t)))
                          (dk-have! `(IN ,qv ,dd)
                            (lambda ()
                              (in-sep! (lambda () (dk-ass!))
                                (lambda ()
                                  (ew kv)
                                  (dk-conj-close!
                                    (lambda ()
                                      (if (dk-head-is? (dk-goal) '<=)
                                          (begin
                                            (dk-cite! 'nn-succ-plus-one qv)
                                            (dk-cite! 'nn-lt-succ-le i0 kv)
                                            (dk-cite! 'nn-succ-plus-one i0)
                                            (dk-nn! `(<= n (+ ,i0 ,mv)) `(= ,mv (succ ,qv)) `(= (succ ,qv) (+ ,qv 1))
                                                    `(<= (succ ,i0) ,kv) `(= (succ ,i0) (+ ,i0 1))))
                                          (dk-ass!))))))))
                          (dk-apply! least qv)
                          (dk-have! '(< 0 0) (lambda () (dk-nn! `(<= ,mv ,qv) `(= ,mv (succ ,qv)) `(= (succ ,qv) (+ ,qv 1)))))
                          (dk-absurd! '(< 0 0))))))
                  (lambda () (dk-ass!))))))))))
(cq4-qed! 'cq4-last-zero)

;; the j-th column of the zero matrix is the zero column
(sp (make-wff '(FORALL R (IMPLIES (IS-RING R) (FORALL n (IMPLIES (IN n NN) (FORALL j (IMPLIES (IN j (INTERVAL 1 n))
  (= (COL-OF (ZEROMAT R n n) n j) (ZEROMAT R n 1))))))))))
(dk-peel!)
(dk-have! '(IN 1 NN) (lambda () (arith)))
(dk-cite! 'zeromat-type 'R 'n 'n)
(dk-cite! 'zeromat-type 'R 'n 1)
(dk-cite! 'cq4-col-type '(ZEROMAT R n n) 'n 'n '(CARR R) 'j)
(cq4-ext! '(COL-OF (ZEROMAT R n n) n j) '(ZEROMAT R n 1) 'n 1 '(CARR R)
  (lambda (i u)
    (cq4-u1! u)
    (cq4-one-in-11!)
    (dk-cite! 'cq4-col-entry '(ZEROMAT R n n) 'n 'n '(CARR R) 'j i)
    (subst `(= (ENTRY (COL-OF (ZEROMAT R n n) n j) ,i 1) (ENTRY (ZEROMAT R n n) ,i j)))
    (dk-cite! 'entry-of-zeromat 'R 'n 'n i 'j)
    (dk-cite! 'entry-of-zeromat 'R 'n 1 i 1)
    (subst `(= (ENTRY (ZEROMAT R n n) ,i j) (ZERO R)))
    (subst `(= (ENTRY (ZEROMAT R n 1) ,i 1) (ZERO R)))
    (rfl)))
(cq4-qed! 'cq4-col-of-zero)

;; X 0 = 0 over a ring
(sp (make-wff '(FORALL R (IMPLIES (IS-RING R) (FORALL n (IMPLIES (IN n NN) (FORALL zkp_ (IMPLIES (IN zkp_ (MAT n n (CARR R)))
  (= (MATMUL R zkp_ (ZEROMAT R n n)) (ZEROMAT R n n))))))))))
(dk-peel!)
(let ((mr '(MAT-RING R n)))
  (dk-cite! 'mat-ring-is-ring 'R 'n)
  (dk-cite! 'mat-ring-carr 'R 'n)
  (dk-cite! 'zeromat-type 'R 'n 'n)
  (dk-have! `(IN zkp_ (CARR ,mr)) (lambda () (subst `(= (CARR ,mr) (MAT n n (CARR R)))) (dk-ass!)))
  (dk-cite! 'ring-mul-zero-right mr 'zkp_)
  (dk-cite! 'mat-ring-zero 'R 'n)
  (dk-have! '(IMPLIES (= n 0) (OR (= n 0) (= n 0))) (lambda () (prop)))
  (dk-cite! 'matmul-type 'R 'n 'n 'n 'zkp_ '(ZEROMAT R n n))
  (dk-have! `(= ((MUL ,mr) zkp_ (ZEROMAT R n n)) (MATMUL R zkp_ (ZEROMAT R n n)))
    (lambda () (subst (dk-cite! 'mat-ring-mul 'R 'n)) (dk-lam-b!) (rfl)))
  (subst `(= (MATMUL R zkp_ (ZEROMAT R n n)) ((MUL ,mr) zkp_ (ZEROMAT R n n))))
  (subst `(= (ZEROMAT R n n) (ZERO ,mr)))
  (dk-ass!))
(cq4-qed! 'cq4-mm-zero-right)

;;; det B = 0 => B eta = 0 for a non-zero column eta (R a field ring)
(define cq4-ker-concl
  '(FORSOME zke_ (AND (IN zke_ (MAT n 1 (CARR R))) (AND (NOT (= zke_ (ZEROMAT R n 1))) (= (MATMUL R B zke_) (ZEROMAT R n 1))))))
(sp (make-wff `(FORALL R (IMPLIES (IS-FIELD-RING R) (FORALL n (IMPLIES (IN n NN) (FORALL B (IMPLIES (IN B (MAT n n (CARR R)))
  (IMPLIES (= (DET R n B) (ZERO R)) ,cq4-ker-concl)))))))))
(dk-peel!)
(dk-project! '(IS-COMMUTATIVE-RING R) (lambda () (mac-h 'is-field-ring-def '(IS-FIELD-RING R))))
(dk-project! '(NOT (= (ONE R) (ZERO R))) (lambda () (mac-h 'is-field-ring-def '(IS-FIELD-RING R))))
(dk-cite! 'commutative-ring-is-ring 'R)
(let* ((cv (dk-skolem! (dk-cite! 'column-step-reduced 'R 'n 'n 'B) #t))
       (pv (begin
             (dk-project! `(FORSOME cep_ (AND (IN cep_ (ELEM-GEN R n)) (= ,cv (MATMUL R B cep_))))
               (lambda () (mac-h 'col-equiv `(COL-EQUIV R n B ,cv))))
             (dk-skolem! (dk-ctx-form `(FORSOME cep_ (AND (IN cep_ (ELEM-GEN R n)) (= ,cv (MATMUL R B cep_))))) #t)))
       (bp `(MATMUL R B ,pv)))
  (dk-cite! 'elem-gen-mat 'R 'n pv)
  (dk-cite! 'elem-gen-invertible 'R 'n pv)
  (let* ((inv `(FORSOME V (AND (IN V (MAT n n (CARR R))) (AND (= (MATMUL R ,pv V) (IDENTMAT R n)) (= (MATMUL R V ,pv) (IDENTMAT R n)))))))
    (dk-project! inv (lambda () (mac-h 'is-invertible-mat `(IS-INVERTIBLE-MAT R n ,pv))))
    (let ((qv (dk-skolem! (dk-ctx-form inv) #t)))
      (dk-split-all!)
      (dk-cite! 'col-equiv-mat 'R 'n 'n 'B cv)
      ;; det C = 0, so C is not invertible
      (dk-cite! 'det-multiplicative 'R 'n 'B pv)
      (dk-cite! 'det-in-carrier 'R 'n pv)
      (dk-cite! 'ring-mul-zero-left 'R `(DET R n ,pv))
      (dk-have! `(= (DET R n ,cv) (ZERO R))
        (lambda ()
          (subst `(= ,cv ,bp))
          (subst `(= (DET R n ,bp) ((MUL R) (DET R n B) (DET R n ,pv))))
          (subst '(= (DET R n B) (ZERO R)))
          (dk-ass!)))
      (let ((iff (dk-cite! 'invertible-iff-det-nonzero 'R 'n cv)))
        (dk-have! `(NOT (IS-INVERTIBLE-MAT R n ,cv))
          (lambda () (dk-only! (dk-ctx-form `(IFF (IS-INVERTIBLE-MAT R n ,cv) (NOT (= (DET R n ,cv) (ZERO R)))))
                               `(= (DET R n ,cv) (ZERO R)))
                     (prop))))
      (let ((alt (dk-cite! 'cq4-diag-zero-or-identity 'R 'n cv)))
        (cq4-or! (dk-ctx-form `(OR ,(cq4-zdiag cv) (= ,cv (IDENTMAT R n))))
          (lambda ()
            (dk-cite! 'cq4-last-zero 'R 'n cv)
            (let* ((i0 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'zio_))) "last zero") #t))
                   (eta `(COL-OF ,pv n ,i0))
                   (z1 '(ZEROMAT R n 1)))
              (dk-split-all!)
              (dk-cite! 'cq4-zero-column 'R 'n cv i0)
              (cq4-nn-rr! i0)
              (dk-have! '(<= 1 n) (lambda () (dk-nn! `(<= 1 ,i0) `(<= ,i0 n))))
              (dk-have! '(IN 1 NN) (lambda () (arith)))
              (cq4-one-in-11!)
              (dk-cite! 'cq4-col-type pv 'n 'n '(CARR R) i0)
              (dk-cite! 'zeromat-type 'R 'n 1)
              (dk-have! '(IMPLIES (= n 0) (OR (= n 0) (= 1 0))) (lambda () (prop)))
              (dk-cite! 'matmul-type 'R 'n 'n 1 'B eta)
              (ew eta)
              (dk-conj-close!
                (lambda ()
                  (let ((g (dk-goal)))
                    (cond
                     ((dk-head-is? g 'IN) (dk-ass!))
                     ((dk-head-is? g 'NOT)
                      (di)
                      (let* ((a1 (dk-cite! 'cq4-col-mul 'R 'n 'n 'n qv pv))
                             (a1 (dk-ctx-form `(= (ENTRY (MATMUL R ,qv ,pv) ,i0 ,i0) (ENTRY (MATMUL R ,qv ,eta) ,i0 1))))
                             (zn '(ZEROMAT R n n)))
                        (if (not a1) (begin (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (cq4-find (lambda (u) (equal? u `(MATMUL R ,qv ,pv))) f))) "cm1") i0 i0)
                                            (set! a1 `(= (ENTRY (MATMUL R ,qv ,pv) ,i0 ,i0) (ENTRY (MATMUL R ,qv ,eta) ,i0 1)))))
                        (dk-cite! 'zeromat-type 'R 'n 'n)
                        (dk-cite! 'cq4-col-mul 'R 'n 'n 'n qv zn)
                        (let ((a2 `(= (ENTRY (MATMUL R ,qv ,zn) ,i0 ,i0) (ENTRY (MATMUL R ,qv (COL-OF ,zn n ,i0)) ,i0 1))))
                          (if (not (dk-asm? a2))
                              (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (cq4-find (lambda (u) (equal? u `(MATMUL R ,qv ,zn))) f))) "cm2") i0 i0))
                          (dk-cite! 'cq4-col-of-zero 'R 'n i0)
                          (dk-cite! 'cq4-mm-zero-right 'R 'n qv)
                          (dk-cite! 'identmat-entry-diag 'R 'n i0)
                          (dk-cite! 'entry-of-zeromat 'R 'n 'n i0 i0)
                          (let* ((b1 (dk-rewrite-h! (dk-ctx-form a1) eta z1))
                                 (b1 (dk-rewrite-h! b1 `(MATMUL R ,qv ,pv) '(IDENTMAT R n)))
                                 (b1 (dk-rewrite-h! b1 `(ENTRY (IDENTMAT R n) ,i0 ,i0) '(ONE R)))
                                 (b2 (dk-rewrite-h! (dk-ctx-form a2) `(COL-OF ,zn n ,i0) z1))
                                 (b2 (dk-rewrite-h! b2 `(MATMUL R ,qv ,zn) zn))
                                 (b2 (dk-rewrite-h! b2 `(ENTRY ,zn ,i0 ,i0) '(ZERO R)))
                                 (x `(ENTRY (MATMUL R ,qv ,z1) ,i0 1)))
                            (dk-have! '(= (ONE R) (ZERO R))
                              (lambda () (subst `(= (ONE R) ,x)) (subst `(= (ZERO R) ,x)) (rfl)))
                            (dk-only! '(= (ONE R) (ZERO R)) '(NOT (= (ONE R) (ZERO R))))
                            (prop)))))
                     (#t
                      (dk-cite! 'zeromat-type 'R 'n 1)
                      (cq4-ext! `(MATMUL R B ,eta) z1 'n 1 '(CARR R)
                        (lambda (kv u)
                          (cq4-u1! u)
                          (dk-cite! 'cq4-col-mul 'R 'n 'n 'n 'B pv)
                          (let ((e `(= (ENTRY ,bp ,kv ,i0) (ENTRY (MATMUL R B ,eta) ,kv 1))))
                            (if (not (dk-asm? e))
                                (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (cq4-find (lambda (u2) (equal? u2 bp)) f))) "cm3") kv i0))
                            (subst `(= (ENTRY (MATMUL R B ,eta) ,kv 1) (ENTRY ,bp ,kv ,i0)))
                            (subst `(= ,bp ,cv))
                            (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (cq4-find (lambda (u2) (equal? u2 `(ENTRY ,cv zkk_ ,i0))) f))) "zero col") kv)
                            (subst `(= (ENTRY ,cv ,kv ,i0) (ZERO R)))
                            (dk-cite! 'entry-of-zeromat 'R 'n 1 kv 1)
                            (subst `(= (ENTRY ,z1 ,kv 1) (ZERO R)))
                            (rfl)))))))))))
          (lambda ()
            (dk-cite! 'identmat-invertible 'R 'n)
            (dk-rewrite-h! `(NOT (IS-INVERTIBLE-MAT R n ,cv)) cv '(IDENTMAT R n))
            (dk-only! '(NOT (IS-INVERTIBLE-MAT R n (IDENTMAT R n))) '(IS-INVERTIBLE-MAT R n (IDENTMAT R n)))
            (prop)))))))
(cq4-qed! 'cq4-det-zero-kernel)

;;; The same over a normed field K (the notes' K^n): det B = 0 gives a non-zero eta in K^n with B eta = 0.
(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL B (IMPLIES (IN B ,(cq4-mat 'n 'n))
  (IMPLIES (= (DET ,cq4-v n B) (ZERO K))
    (FORSOME zke_ (AND (IN zke_ ,(cq4-mat 'n 1)) (AND (NOT (= zke_ (ZEROMAT ,cq4-v n 1))) (= ,(cq4-mm 'B 'zke_) (ZEROMAT ,cq4-v n 1))))))))))))))
(dk-peel!)
(cq4-view!)
(dk-cite! 'cq4-view-field-ring 'K)
(cq4-to-v! 'B 'n 'n)
(dk-rewrite-h! `(= (DET ,cq4-v n B) (ZERO K)) '(ZERO K) `(ZERO ,cq4-v))
(let ((ev (dk-skolem! (dk-cite! 'cq4-det-zero-kernel cq4-v 'n 'B) #t)))
  (dk-split-all!)
  (cq4-to-k! ev 'n 1)
  (ew ev)
  (dk-conj-close! (lambda () (dk-ass!))))
(cq4-qed! 'ccr-det-zero-kernel)

;;; =======================================================================
;;; D. The commutant of an irreducible operator (the algebra of Lemma 3.4): if B commutes with T,
;;;    T is irreducible and det B = 0, then B = 0.

;; a guard (IMPLIES (= x 0) G) made vacuous by (<= 1 x) in context
(define (cq4-vac-guard! x g)
  (if (not (dk-asm? `(IMPLIES (= ,x 0) ,g)))
      (dk-have! `(IMPLIES (= ,x 0) ,g)
        (lambda ()
          (di)
          (dk-have! '(< 0 0) (lambda () (dk-nn! `(<= 1 ,x) `(= ,x 0))))
          (dk-absurd! '(< 0 0))))))

;; 0 P = 0 and P 0 = 0 at every size, inner size >= 1
(define (cq4-zg-stmt side)
  `(FORALL R (IMPLIES (IS-RING R) (FORALL m (FORALL n (FORALL l (FORALL P
     (IMPLIES (IN m NN) (IMPLIES (IN l NN) (IMPLIES (<= 1 n)
       ,(if (eq? side 'left)
            '(IMPLIES (IN P (MAT n l (CARR R))) (= (MATMUL R (ZEROMAT R m n) P) (ZEROMAT R m l)))
            '(IMPLIES (IN P (MAT m n (CARR R))) (= (MATMUL R P (ZEROMAT R n l)) (ZEROMAT R m l))))))))))))))
(define (cq4-zg! side)
  (dk-peel!)
  (let* ((zl (if (eq? side 'left) '(ZEROMAT R m n) '(ZEROMAT R n l)))
         (prod (if (eq? side 'left) `(MATMUL R ,zl P) `(MATMUL R P ,zl)))
         (ag '(RING-ADDITIVE-AG R)))
    (if (eq? side 'left) (dk-cite! 'mat-rows-in-nn 'n 'l '(CARR R) 'P) (dk-cite! 'mat-cols-in-nn 'm 'n '(CARR R) 'P))
    (dk-cite! 'zeromat-type 'R 'm 'n) (dk-cite! 'zeromat-type 'R 'n 'l) (dk-cite! 'zeromat-type 'R 'm 'l)
    (cq4-vac-guard! 'n '(OR (= m 0) (= l 0)))
    (if (eq? side 'left)
        (dk-cite! 'matmul-type 'R 'm 'n 'l zl 'P)
        (dk-cite! 'matmul-type 'R 'm 'n 'l 'P zl))
    (dk-cite! 'ring-additive-ag-is-abelian-group 'R)
    (dk-cite! 'ras-id 'R)
    (dk-cite! 'interval-in-set 1 'n)
    (dk-cite! 'interval-card-in-nn 1 'n)
    (cq4-ext! prod '(ZEROMAT R m l) 'm 'l '(CARR R)
      (lambda (i j)
        (if (eq? side 'left) (dk-cite! 'matmul-entry 'R 'm 'n 'l zl 'P) (dk-cite! 'matmul-entry 'R 'm 'n 'l 'P zl))
        (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (cq4-find (lambda (u) (equal? u prod)) f))) "entry") i j)
        (let* ((q (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) `(ENTRY ,prod ,i ,j)))) "q"))
               (fs (caddr q)) (lam (caddr fs)))
          (dk-have! `(FORALL zkz_ (IMPLIES (IN zkz_ (INTERVAL 1 n)) (= (,lam zkz_) (IDEN ,ag))))
            (lambda ()
              (let* ((landed (dk-peel!)) (z (cadr (car landed))))
                (dk-lam-b!)
                (subst `(= (IDEN ,ag) (ZERO R)))
                (if (eq? side 'left)
                    (begin
                      (dk-cite! 'entry-of-zeromat 'R 'm 'n i z)
                      (subst `(= (ENTRY ,zl ,i ,z) (ZERO R)))
                      (dk-cite! 'entry-in-carrier 'n 'l '(CARR R) 'P z j)
                      (dk-cite! 'ring-mul-zero-left 'R `(ENTRY P ,z ,j))
                      (subst `(= ((MUL R) (ZERO R) (ENTRY P ,z ,j)) (ZERO R))))
                    (begin
                      (dk-cite! 'entry-of-zeromat 'R 'n 'l z j)
                      (subst `(= (ENTRY ,zl ,z ,j) (ZERO R)))
                      (dk-cite! 'entry-in-carrier 'm 'n '(CARR R) 'P i z)
                      (dk-cite! 'ring-mul-zero-right 'R `(ENTRY P ,i ,z))
                      (subst `(= ((MUL R) (ENTRY P ,i ,z) (ZERO R)) (ZERO R)))))
                (dk-cite! 'ring-zero-in 'R)
                (rfl))))
          (dk-cite! 'finsum-all-id-ptwise ag '(INTERVAL 1 n) lam)
          (dk-cite! 'entry-of-zeromat 'R 'm 'l i j)
          (subst q)
          (subst `(= ,fs (IDEN ,ag)))
          (subst `(= (IDEN ,ag) (ZERO R)))
          (subst `(= (ENTRY (ZEROMAT R m l) ,i ,j) (ZERO R)))
          (dk-cite! 'ring-zero-in 'R)
          (rfl))))))
(sp (make-wff (cq4-zg-stmt 'left)))
(cq4-zg! 'left)
(cq4-qed! 'cq4-zero-mul-gen-left)
(sp (make-wff (cq4-zg-stmt 'right)))
(cq4-zg! 'right)
(cq4-qed! 'cq4-zero-mul-gen-right)

;; B T = T B  =>  B T^k = T^k B
(sp (make-wff `(FORALL zkk_ (IMPLIES (IN zkk_ NN) (FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN)
  (FORALL tm (FORALL B (IMPLIES (IN tm ,(cq4-mat 'n 'n)) (IMPLIES (IN B ,(cq4-mat 'n 'n))
    (IMPLIES (= ,(cq4-mm 'B 'tm) ,(cq4-mm 'tm 'B))
      (= ,(cq4-mm 'B (cq4-pw 'tm 'zkk_)) ,(cq4-mm (cq4-pw 'tm 'zkk_) 'B)))))))))))))))
(dk-ni-fixed! '(K n tm B))
(for-each
  (lambda (leaf)
    (if (not (sequent-node-grounded? leaf))
        (begin
          (dk-focus! leaf)
          (cq4-view!)
          (cq4-to-v! 'B 'n 'n) (cq4-to-v! 'tm 'n 'n)
          (cq4-guard! '(IMPLIES (= n 0) (OR (= n 0) (AND (= n 0) (= n 0)))))
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let* ((landed (dk-peel!))
                     (kv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) landed)))
                     (pk (cq4-pw 'tm kv)) (tp (cq4-mm 'tm pk)))
                (cq4-ty! pk 'n 'n)
                (dk-cite! 'cq4-pow-succ 'K 'n 'tm kv)
                (subst `(= ,(cq4-pw 'tm `(succ ,kv)) ,tp))
                (dk-cite! 'matmul-assoc cq4-v 'n 'n 'n 'n 'B 'tm pk)
                (subst `(= ,(cq4-mm 'B tp) ,(cq4-mm (cq4-mm 'B 'tm) pk)))
                (subst `(= ,(cq4-mm 'B 'tm) ,(cq4-mm 'tm 'B)))
                (dk-cite! 'matmul-assoc cq4-v 'n 'n 'n 'n 'tm 'B pk)
                (subst `(= ,(cq4-mm (cq4-mm 'tm 'B) pk) ,(cq4-mm 'tm (cq4-mm 'B pk))))
                (subst `(= ,(cq4-mm 'B pk) ,(cq4-mm pk 'B)))
                (dk-cite! 'matmul-assoc cq4-v 'n 'n 'n 'n 'tm pk 'B)
                (subst `(= ,(cq4-mm 'tm (cq4-mm pk 'B)) ,(cq4-mm tp 'B)))
                (cq4-ty! (cq4-mm tp 'B) 'n 'n)
                (rfl))
              (begin
                (dk-cite! 'cq4-pow-zero 'K 'n 'tm)
                (subst `(= ,(cq4-pw 'tm 0) ,cq4-id))
                (dk-cite! 'identmat-right-identity cq4-v 'n 'n 'B)
                (dk-cite! 'identmat-left-identity cq4-v 'n 'n 'B)
                (subst `(= ,(cq4-mm 'B cq4-id) B))
                (subst `(= ,(cq4-mm cq4-id 'B) B))
                (rfl))))))
  (dk-open-leaves))
(cq4-qed! 'cq4-commute-power)

;; J in [1, n] in context: run (K Q) with Q in NN and (- J 1) = Q, J = succ Q in context
(define (cq4-pred! j kont)
  (dk-cite! 'interval-lo 1 'n j)
  (dk-cite! 'interval-elt-in-nn 1 'n j)
  (cq4-or! (dk-apply! (dk-cite! 'nn-zero-or-succ j))
    (lambda ()
      (dk-have! '(< 0 0) (lambda () (dk-nn! `(<= 1 ,j) `(= ,j 0))))
      (dk-absurd! '(< 0 0)))
    (lambda ()
      (let ((q (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (cq4-find (lambda (u) (and (pair? u) (eq? (car u) '=) (equal? (cadr u) j))) f))) "pred") #t)))
        (dk-cite! 'nn-succ-plus-one q)
        (dk-cite! 'nn-in-rr q)
        (dk-have! `(= (- ,j 1) ,q)
          (lambda ()
            (subst `(= ,j (succ ,q)))
            (subst `(= (succ ,q) (+ ,q 1)))
            (mac 'binary-minus-def)
            (crs)))
        (kont q)))))

(define cq4-kry '(KRYLOV-MAT K n tm phi))
(define (cq4-kcol j) (cq4-mm (cq4-pw 'tm `(- ,j 1)) 'phi))
(define (cq4-kry-stmt concl)
  `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL tm (FORALL phi
     (IMPLIES (IN tm ,(cq4-mat 'n 'n)) (IMPLIES (IN phi ,(cq4-mat 'n 1)) ,concl)))))))))
(sp (make-wff (cq4-kry-stmt `(IN ,cq4-kry ,(cq4-mat 'n 'n)))))
(dk-peel!)
(cq4-view!)
(mac 'KRYLOV-MAT)
(dk-matof!)
(let* ((landed (dk-peel!))
       (ivs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(INTERVAL 1 n)))) landed)))
       (iv (car ivs)) (jv (cadr ivs)))
  (dk-lam-b!)
  (cq4-pred! jv
    (lambda (q)
      (subst `(= (- ,jv 1) ,q))
      (dk-have! '(IN 1 NN) (lambda () (arith)))
      (cq4-one-in-11!)
      (cq4-ty! (cq4-mm (cq4-pw 'tm q) 'phi) 'n 1)
      (dk-cite! 'entry-in-carrier 'n 1 '(CARR K) (cq4-mm (cq4-pw 'tm q) 'phi) iv 1)
      (dk-ass!))))
(cq4-qed! 'cq4-krylov-type)

;; the j-th column of the Krylov matrix is T^(j-1) phi
(sp (make-wff (cq4-kry-stmt `(FORALL j (IMPLIES (IN j (INTERVAL 1 n)) (= (COL-OF ,cq4-kry n j) ,(cq4-kcol 'j)))))))
(dk-peel!)
(cq4-view!)
(dk-cite! 'cq4-krylov-type 'K 'n 'tm 'phi)
(dk-cite! 'cq4-col-type cq4-kry 'n 'n '(CARR K) 'j)
(dk-have! '(IN 1 NN) (lambda () (arith)))
(cq4-one-in-11!)
(cq4-pred! 'j
  (lambda (q)
    (subst `(= (- j 1) ,q))
    (let ((col (cq4-mm (cq4-pw 'tm q) 'phi)))
      (cq4-ty! col 'n 1)
      (cq4-ext! `(COL-OF ,cq4-kry n j) col 'n 1 '(CARR K)
        (lambda (i u)
          (cq4-u1! u)
          (dk-cite! 'cq4-col-entry cq4-kry 'n 'n '(CARR K) 'j i)
          (subst `(= (ENTRY (COL-OF ,cq4-kry n j) ,i 1) (ENTRY ,cq4-kry ,i j)))
          (mac 'KRYLOV-MAT)
          (subst (cq4-matof-eqn!
            (lambda (x y)
              (cq4-pred! y
                (lambda (q2)
                  (subst `(= (- ,y 1) ,q2))
                  (cq4-ty! (cq4-mm (cq4-pw 'tm q2) 'phi) 'n 1)
                  (dk-cite! 'entry-in-carrier 'n 1 '(CARR K) (cq4-mm (cq4-pw 'tm q2) 'phi) x 1)
                  (dk-cite! 'membership-implies-sethood `(ENTRY ,(cq4-mm (cq4-pw 'tm q2) 'phi) ,x 1) '(CARR K))
                  (dk-ass!))))))
          (subst `(= (- j 1) ,q))
          (dk-cite! 'entry-in-carrier 'n 1 '(CARR K) col i 1)
          (rfl))))))
(cq4-qed! 'cq4-krylov-column)

;; the entry-of-product instance of cq4-col-mul at (i, j): returns the equation
(define (cq4-colmul! p q i j)
  (dk-cite! 'cq4-col-mul cq4-v 'n 'n 'n p q)
  (let ((e `(= (ENTRY ,(cq4-mm p q) ,i ,j) (ENTRY ,(cq4-mm p `(COL-OF ,q n ,j)) ,i 1))))
    (if (not (dk-asm? e))
        (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (cq4-find (lambda (u) (equal? u (cq4-mm p q))) f))) "col-mul") i j))
    (dk-ctx-form e)))

(define cq4-z1 `(ZEROMAT ,cq4-v n 1))
(define cq4-kre '(KRYLOV-MAT K n tm zke_))
(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL tm (FORALL B (FORALL zke_
  (IMPLIES (IS-IRREDUCIBLE-MAT K n tm) (IMPLIES (IN B ,(cq4-mat 'n 'n)) (IMPLIES (= ,(cq4-mm 'B 'tm) ,(cq4-mm 'tm 'B))
  (IMPLIES (IN zke_ ,(cq4-mat 'n 1)) (IMPLIES (NOT (= zke_ ,cq4-z1)) (IMPLIES (= ,(cq4-mm 'B 'zke_) ,cq4-z1)
    (= B ,cq4-z))))))))))))))))
(dk-peel!)
(cq4-view!)
(dk-have! '(IN 1 NN) (lambda () (arith)))
(cq4-one-in-11!)
(let ((irr `(FORALL zkvp_ (IMPLIES (IN zkvp_ ,(cq4-mat 'n 1)) (IMPLIES (NOT (= zkvp_ ,cq4-z1))
              (FORALL zkvx_ (IMPLIES (IN zkvx_ ,(cq4-mat 'n 1))
                (FORSOME zkvc_ (AND (IN zkvc_ ,(cq4-mat 'n 1)) (= zkvx_ ,(cq4-mm `(KRYLOV-MAT K n tm zkvp_) 'zkvc_)))))))))))
  (dk-project! `(IN tm ,(cq4-mat 'n 'n)) (lambda () (mac-h 'is-irreducible-mat '(IS-IRREDUCIBLE-MAT K n tm))))
  (dk-project! irr (lambda () (mac-h 'is-irreducible-mat '(IS-IRREDUCIBLE-MAT K n tm))))
  (cq4-or! (dk-apply! (dk-cite! 'nn-zero-or-succ 'n))
    (lambda ()
      (dk-have! `(= zke_ ,cq4-z1) (lambda () (cq4-eq-n0! 'zke_ cq4-z1 1)))
      (dk-only! `(= zke_ ,cq4-z1) `(NOT (= zke_ ,cq4-z1)))
      (prop))
    (lambda ()
      (let ((qn (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (cq4-find (lambda (u) (and (pair? u) (eq? (car u) '=) (eq? (cadr u) 'n))) f))) "n succ") #t)))
        (dk-cite! 'nn-succ-plus-one qn)
        (dk-have! '(<= 1 n) (lambda () (dk-nn! `(= n (succ ,qn)) `(= (succ ,qn) (+ ,qn 1)))))
        (dk-apply! (dk-ctx-form irr) 'zke_)
        (let ((span `(FORALL zkvx_ (IMPLIES (IN zkvx_ ,(cq4-mat 'n 1))
                       (FORSOME zkvc_ (AND (IN zkvc_ ,(cq4-mat 'n 1)) (= zkvx_ ,(cq4-mm cq4-kre 'zkvc_))))))))
          (cq4-guard! '(IMPLIES (= n 0) (OR (= n 0) (AND (= n 0) (= 1 0)))))
          (cq4-guard! '(IMPLIES (= n 0) (OR (= 1 0) (AND (= n 0) (= n 0)))))
          (cq4-guard! '(IMPLIES (= n 0) (OR (= n 0) (= 1 0))))
          (dk-cite! 'cq4-krylov-type 'K 'n 'tm 'zke_)
          (cq4-ty! 'B 'n 'n) (cq4-ty! 'zke_ 'n 1) (cq4-ty! cq4-kre 'n 'n) (cq4-ty! cq4-z 'n 'n) (cq4-ty! cq4-z1 'n 1)
          (cq4-ty! (cq4-mm 'B cq4-kre) 'n 'n)
          ;; B K = 0
          (dk-have! `(= ,(cq4-mm 'B cq4-kre) ,cq4-z)
            (lambda ()
              (cq4-ext! (cq4-mm 'B cq4-kre) cq4-z 'n 'n `(CARR ,cq4-v)
                (lambda (i j)
                  (subst (cq4-colmul! 'B cq4-kre i j))
                  (dk-cite! 'cq4-krylov-column 'K 'n 'tm 'zke_ j)
                  (subst `(= (COL-OF ,cq4-kre n ,j) ,(cq4-mm (cq4-pw 'tm `(- ,j 1)) 'zke_)))
                  (cq4-pred! j
                    (lambda (q)
                      (let ((pq (cq4-pw 'tm q)))
                        (subst `(= (- ,j 1) ,q))
                        (cq4-ty! pq 'n 'n)
                        (dk-cite! 'matmul-assoc cq4-v 'n 'n 'n 1 'B pq 'zke_)
                        (subst `(= ,(cq4-mm 'B (cq4-mm pq 'zke_)) ,(cq4-mm (cq4-mm 'B pq) 'zke_)))
                        (dk-cite! 'cq4-commute-power q 'K 'n 'tm 'B)
                        (subst `(= ,(cq4-mm 'B pq) ,(cq4-mm pq 'B)))
                        (dk-cite! 'matmul-assoc cq4-v 'n 'n 'n 1 pq 'B 'zke_)
                        (subst `(= ,(cq4-mm (cq4-mm pq 'B) 'zke_) ,(cq4-mm pq (cq4-mm 'B 'zke_))))
                        (subst `(= ,(cq4-mm 'B 'zke_) ,cq4-z1))
                        (cq4-to-v! pq 'n 'n)
                        (dk-cite! 'cq4-zero-mul-gen-right cq4-v 'n 'n 1 pq)
                        (subst `(= ,(cq4-mm pq cq4-z1) ,cq4-z1))
                        (dk-cite! 'entry-of-zeromat cq4-v 'n 1 i 1)
                        (dk-cite! 'entry-of-zeromat cq4-v 'n 'n i j)
                        (subst `(= (ENTRY ,cq4-z1 ,i 1) (ZERO ,cq4-v)))
                        (subst `(= (ENTRY ,cq4-z ,i ,j) (ZERO ,cq4-v)))
                        (dk-cite! 'ring-zero-in cq4-v)
                        (rfl))))))))
          ;; B = 0, column by column
          (cq4-ty! cq4-id 'n 'n)
          (cq4-ext! 'B cq4-z 'n 'n `(CARR ,cq4-v)
            (lambda (i j)
              (let* ((e0 (cq4-colmul! 'B cq4-id i j))
                     (e1 (begin (dk-cite! 'identmat-right-identity cq4-v 'n 'n 'B)
                                (dk-rewrite-h! e0 (cq4-mm 'B cq4-id) 'B)))
                     (col `(COL-OF ,cq4-id n ,j)))
                (subst e1)
                (dk-cite! 'cq4-col-type cq4-id 'n 'n '(CARR K) j)
                (dk-apply! (dk-ctx-form span) col)
                (let ((cv (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (cq4-find (lambda (u) (equal? u col)) f))) "coeffs") #t)))
                  (subst `(= ,col ,(cq4-mm cq4-kre cv)))
                  (cq4-ty! cv 'n 1)
                  (dk-cite! 'matmul-assoc cq4-v 'n 'n 'n 1 'B cq4-kre cv)
                  (subst `(= ,(cq4-mm 'B (cq4-mm cq4-kre cv)) ,(cq4-mm (cq4-mm 'B cq4-kre) cv)))
                  (subst `(= ,(cq4-mm 'B cq4-kre) ,cq4-z))
                  (dk-cite! 'cq4-zero-mul-gen-left cq4-v 'n 'n 1 cv)
                  (subst `(= ,(cq4-mm cq4-z cv) ,cq4-z1))
                  (dk-cite! 'entry-of-zeromat cq4-v 'n 1 i 1)
                  (dk-cite! 'entry-of-zeromat cq4-v 'n 'n i j)
                  (subst `(= (ENTRY ,cq4-z1 ,i 1) (ZERO ,cq4-v)))
                  (subst `(= (ENTRY ,cq4-z ,i ,j) (ZERO ,cq4-v)))
                  (dk-cite! 'ring-zero-in cq4-v)
                  (rfl))))))))))
(cq4-qed! 'cq4-commutant-kernel)

;;; THE ALGEBRA OF LEMMA 3.4.  An operator commuting with an irreducible T is 0 as soon as its determinant is.
(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL tm (FORALL B
  (IMPLIES (IS-IRREDUCIBLE-MAT K n tm) (IMPLIES (IN B ,(cq4-mat 'n 'n)) (IMPLIES (= ,(cq4-mm 'B 'tm) ,(cq4-mm 'tm 'B))
    (IMPLIES (= (DET ,cq4-v n B) (ZERO K)) (= B ,cq4-z)))))))))))))
(dk-peel!)
(let ((ev (dk-skolem! (dk-cite! 'ccr-det-zero-kernel 'K 'n 'B) #t)))
  (dk-split-all!)
  (dk-cite! 'cq4-commutant-kernel 'K 'n 'tm 'B ev)
  (dk-ass!))
(cq4-qed! 'ccr-3-4-commutant)
