;; entry-of-matof on the goal (= (ENTRY (MATOF m n LAM) a b) RHS), indices typed (det-transpose's
;; dtt-matof-eqn!, adapted): DEFINED! proves (IN (LAM x y) SET) beta-reduced; returns the reduced equation
(define (cq4-matof-eqn! defined!)
  (let* ((e (cadr (dk-goal))) (mf (cadr e)) (mv (cadr mf)) (nv (caddr mf)) (lam (cadddr mf))
         (a (caddr e)) (b (cadddr e))
