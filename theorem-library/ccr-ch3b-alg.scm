(sp (make-wff (cq4-stmt '(zkp_ zkq_) `((IN zkp_ ,cq4-alg) (IN zkq_ ,cq4-alg)) `(IN ,(cq4-ma 'zkp_ 'zkq_) ,cq4-alg))))
