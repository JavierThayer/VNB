                  (IN (,lam zkmi_ zkmj_) SET))))))
         (eqn `(= ,e (,lam ,a ,b))))
    (dk-have! def
      (lambda ()
        (let* ((landed (dk-peel!))
               (xy (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (eq? (car (caddr f)) 'INTERVAL))) landed))))
          (dk-lam-b!)
          (defined! (car xy) (cadr xy)))))
    (dk-have! eqn (lambda () (dk-cite! 'entry-of-matof mv nv lam a b) (dk-ass!)))
    (lam-b-h (dk-ctx-form eqn))
    (let ((q (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) e) (not (equal? f eqn)))) (dk-asms))))
      (if (not q) (error "cq4-matof-eqn!: no reduced equation"))
      q)))
