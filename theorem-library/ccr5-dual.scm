                                           (he `((MUL kf) ,h ,e)))
                                      (dk-have! `(IN ,e ,z) (lambda () (mac 'nv-integers) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
                                      (dk-apply! pl e)
                                      (dk-cite! 'ch-bichar-value 'kf 'chi a h e)
                                      (dk-cite! 'nf-mul-in-carr 'kf h e)
                                      (dk-have! `(= ((MUL kf) ,ah ,e) ((MUL kf) ,a ,he)) (lambda () (c5-crs! 'kf (list 'uw y1 h e))))
                                      (subst `(= ((MUL kf) ,ah ,e) ((MUL kf) ,a ,he)))
                                      (subst `(= (chi ((MUL kf) ,a ,he)) (,w ,h ,e)))
                                      (dk-ass!))))
                                (let ((core (dk-cite! 'ccr-5-15-core 'kf 'chi ah)))
                                  ;; |y1| <= |a h|
                                  (c5-rr-mul! t nh)
                                  (let ((i0 (dk-cite! 'rr-mul-le-right 1 `(* ,t ,nh) ny1)))
                                    (c5-rr-mul! 1 ny1) (c5-rr-mul! `(* ,t ,nh) ny1)
                                    (dk-have! `(= (* 1 ,ny1) ,ny1) (lambda () (crs)))
                                    (dk-have! `(= (* (* ,t ,nh) ,ny1) ((FNRM kf) ,ah))
                                      (lambda () (subst `(= ((FNRM kf) ,ah) (* ,na ,nh))) (subst `(= ,na (* ,t ,ny1))) (crs)))
                                    (let* ((i1 (dk-rewrite-h! i0 `(* 1 ,ny1) ny1))
                                           (i2 (dk-rewrite-h! i1 `(* (* ,t ,nh) ,ny1) `((FNRM kf) ,ah))))
                                      (dk-apply! core y1)
                                      (ai `(NOT (= (chi ,y1) 1)))))))))))
                      ;; Z is inside pol Z: |a h x| <= |a|
                      (lambda ()
                        (c5-iff-fwd! (dk-cite! 'c5-integers-mem 'kf h))
                        (dk-cite! 'nf-norm-in-rr 'kf h) (dk-cite! 'nf-norm-nonneg 'kf h)
                        (mac 'bichar-polar)
                        (in-sep! (lambda () (dk-ass!))
                          (lambda ()
                            (let* ((x (dk-di-var!))
                                   (nx `((FNRM kf) ,x)) (hx `((MUL kf) ,h ,x)) (ahx `((MUL kf) ,a ,hx)))
                              (c5-iff-fwd! (dk-cite! 'c5-integers-mem 'kf x))
                              (dk-cite! 'nf-norm-in-rr 'kf x) (dk-cite! 'nf-norm-nonneg 'kf x)
                              (dk-cite! 'ch-bichar-value 'kf 'chi a h x)
                              (dk-cite! 'nf-mul-in-carr 'kf h x) (dk-cite! 'nf-mul-in-carr 'kf a hx)
                              (dk-cite! 'nf-norm-mult 'kf h x) (dk-cite! 'nf-norm-mult 'kf a hx)
                              (c5-rr-mul! nh nx)
                              (let ((p (dk-name! `(* ,nh ,nx) 'RR)))
                                (dk-cite! 'rr-mul-le-right nh 1 nx)
                                (c5-rr-mul! 1 nx)
                                (dk-have! `(<= ,p 1) (lambda () (dk-ineq! `(= ,p (* ,nh ,nx)) `(<= (* ,nh ,nx) (* 1 ,nx)) `(<= ,nx 1))))
                                (dk-cite! 'rr-mul-le-right p 1 na)
                                (c5-rr-mul! p na) (c5-rr-mul! na p) (c5-rr-mul! 1 na)
                                (dk-have! `(= (* ,na ,p) (* ,p ,na)) (lambda () (crs)))
                                (dk-cite! 'nf-norm-in-rr 'kf ahx)
                                (dk-have! `(<= ((FNRM kf) ,ahx) ,na)
                                  (lambda ()
                                    (subst `(= ((FNRM kf) ,ahx) (* ,na ((FNRM kf) ,hx))))
                                    (subst `(= ((FNRM kf) ,hx) (* ,nh ,nx)))
                                    (subst `(= (* ,nh ,nx) ,p))
                                    (dk-ineq! `(= (* ,na ,p) (* ,p ,na)) `(<= (* ,p ,na) (* 1 ,na)))))
                                (dk-apply! triv ahx)
                                (subst `(= (,w ,h ,x) (chi ,ahx)))
                                (dk-ass!))))))))))
              (fact 'class-extensionality pol z)
              (dk-ass!)))))))
(qed 'ccr-6-14)

