                 (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(CARR kf)))) landed))
                 (a1 (cadr (car ins))) (a2 (cadr (cadr ins)))
                 (h1 (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f a1))) landed))
                 (h2 (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f a2))) landed))
                 (un (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f c2) (dk-head-is? (caddr (caddr f)) 'FORALL))) "6.20 uniqueness")))
            (from-rel! a1 h1) (from-rel! a2 h2)
            (dk-apply! un a1 a2)
            (dk-ass!))))))
(qed 'ccr-6-23)

;;; -----------------------------------------------------------------------
(define (c5-ff p l what) (or (find-first p l) (error "c5-ff: nothing for" what l)))
;;; 11. Corollary 6.6: over a self-dual field a non-trivial bilinear bicharacter is faithful.

(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL chi (IMPLIES (IS-DUALIZING-CHARACTER kf chi)
  (FORALL w (IMPLIES (IS-BILINEAR-BICHARACTER kf w)
    (IMPLIES (FORSOME c5x (AND (IN c5x (CARR kf)) (FORSOME c5y (AND (IN c5y (CARR kf)) (NOT (= (w c5x c5y) 1))))))
      (IS-FAITHFUL-BICHARACTER kf w))))))))))
(dk-peel!)
(dk-cite! 'nf-zero-in-carr 'kf) (dk-cite! 'nf-one-in-carr 'kf)
(dk-project! '(IS-NONTRIVIAL-CHARACTER kf chi) 'is-dualizing-character '(IS-DUALIZING-CHARACTER kf chi))
(dk-project! '(IS-ADD-CHARACTER kf chi) 'is-nontrivial-character '(IS-NONTRIVIAL-CHARACTER kf chi))
(c5-hom! 'kf 'chi)
(dk-cite! 'ch-zero 'kf 'chi)
(let* ((dual (dk-project! '(FORALL c5t_ (IMPLIES (IS-ADD-CHARACTER kf c5t_)
                               (FORSOME c5a_ (AND (IN c5a_ (CARR kf)) (= c5t_ (DUALITY-MAP kf chi c5a_))))))
                          'is-dualizing-character '(IS-DUALIZING-CHARACTER kf chi)))
       (bic (dk-project! '(IS-BICHARACTER kf w) 'is-bilinear-bicharacter '(IS-BILINEAR-BICHARACTER kf w)))
       (c (dk-skolem! (dk-cite! 'ccr-6-3-converse 'kf 'chi 'w)))
       (wb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f c) (dk-contains? f 'BICHAR-OF))) "w = chi(c x y)"))
       (nt (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "non-trivial"))
       ;; goal rewrite w(u, v) -> chi(c (u v)), and back
       (wval! (lambda (u v)
                (dk-apply! wb u v)
                (subst `(= (w ,u ,v) ((BICHAR-OF kf chi ,c) ,u ,v)))
                (subst (dk-cite! 'ch-bichar-value 'kf 'chi c u v))))
       (wval-back! (lambda (u v)
                     (dk-apply! wb u v)
                     (let ((bv (dk-cite! 'ch-bichar-value 'kf 'chi c u v)))
                       (subst `(= ,(caddr bv) ,(cadr bv)))
                       (subst `(= ((BICHAR-OF kf chi ,c) ,u ,v) (w ,u ,v)))))))
  ;; c /= 0
  (dk-have! `(NOT (= ,c (ZERO kf)))
    (lambda ()
      (di)
      (let* ((x0 (dk-skolem! nt))
             (y0 (dk-skolem! (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "eta"))))
        (dk-have! `(= (w ,x0 ,y0) 1)
          (lambda ()
            (wval! x0 y0)
            (dk-cite! 'nf-mul-in-carr 'kf x0 y0)
            (dk-have! `(= ((MUL kf) ,c ((MUL kf) ,x0 ,y0)) (ZERO kf)) (lambda () (subst `(= ,c (ZERO kf))) (c5-crs! 'kf (list x0 y0))))
            (subst `(= ((MUL kf) ,c ((MUL kf) ,x0 ,y0)) (ZERO kf)))
            (dk-ass!)))
        (ai `(NOT (= (w ,x0 ,y0) 1))))))
  (let ((e (dk-skolem! (dk-cite! 'nf-inverse 'kf c))))
    (mac 'is-faithful-bicharacter)
    (dk-conj-close!
      (lambda ()
        (cond
          ((dk-ass!) #t)
          ((and (dk-head-is? (dk-goal) 'FORALL) (dk-head-is? (caddr (dk-goal)) 'IMPLIES) (dk-head-is? (cadr (caddr (dk-goal))) 'IS-ADD-CHARACTER))
           ;; (a): tau = Psi(b) is h |-> w(h, e b) and h |-> w(e b, h), uniquely
           (let* ((landed (dk-landed (lambda () (dk-peel!))))
                  (tau (caddr (c5-ff (lambda (f) (dk-head-is? f 'IS-ADD-CHARACTER)) landed "tau")))
                  (b (dk-skolem! (dk-apply! dual tau)))
                  (dmb `(DUALITY-MAP kf chi ,b))
                  (x `((MUL kf) ,e ,b))
                  ;; side 'l: w(v, z); side 'r: w(z, v)
                  (wt (lambda (side z v) (if (eq? side 'l) `(w ,v ,z) `(w ,z ,v))))
                  (inner (lambda (side z v) (if (eq? side 'l) `((MUL kf) ,v ,z) `((MUL kf) ,z ,v))))
                  ;; with (= tau LAMZ) in context: (= (wt side z v) (chi (b v))) as a goal
                  (eq-b! (lambda (side lamz z v)
                           (let ((t0 (wt side z v)))
                             (dk-have! `(= ,t0 (chi ((MUL kf) ,b ,v)))
                               (lambda ()
                                 (dk-have! `(== (,lamz ,v) ,t0) (lambda () (dk-lam-b!) (qrfl)))
                                 (subst `(== ,t0 (,lamz ,v)))
                                 (subst `(= ,lamz ,tau))
                                 (subst `(= ,tau ,dmb))
                                 (subst (dk-cite! 'ch-psi-value 'kf 'chi b v))
                                 (dk-cite! 'nf-mul-in-carr 'kf b v)
                                 (c5-val! 'kf 'chi `((MUL kf) ,b ,v))
                                 (rfl)))))))
             (dk-cite! 'nf-mul-in-carr 'kf e b)
             (dk-cite! 'ccr-5-12-character 'kf 'chi b) (c5-hom! 'kf dmb)
             (dk-conj-close!
               (lambda ()
                 (let* ((side (if (dk-contains? (dk-goal) '(w c5h_ c5x_)) 'l 'r))
                        (l (if (eq? side 'l) `(VNB-LAMBDA chx_ (CARR kf) (w chx_ ,x)) `(VNB-LAMBDA chx_ (CARR kf) (w ,x chx_)))))
                   (dk-project! (if (eq? side 'l)
                                    '(FORALL chy_ (IMPLIES (IN chy_ (CARR kf)) (IS-ADD-CHARACTER kf (VNB-LAMBDA chx_ (CARR kf) (w chx_ chy_)))))
                                    '(FORALL chy_ (IMPLIES (IN chy_ (CARR kf)) (IS-ADD-CHARACTER kf (VNB-LAMBDA chx_ (CARR kf) (w chy_ chx_))))))
                                'is-bicharacter '(IS-BICHARACTER kf w))
                   (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-ADD-CHARACTER)
                                                        (dk-contains? f (if (eq? side 'l) '(w chx_ chy_) '(w chy_ chx_)))))
                                       "the bicharacter clause")
                              x)
                   (c5-hom! 'kf l)
                   ;; Psi(b) = LAM_x
                   (dk-fun-ext! dmb l '(CARR kf) 'UNIT-CIRCLE #f #f
                     (lambda (v)
                       (subst (dk-cite! 'ch-psi-value 'kf 'chi b v))
                       (let ((t0 (wt side x v)))
                         (dk-have! `(== (,l ,v) ,t0) (lambda () (dk-lam-b!) (qrfl)))
                         (subst `(== (,l ,v) ,t0))
                         (wval! (cadr t0) (caddr t0))
                         (dk-cite! 'nf-mul-in-carr 'kf b v)
                         (dk-have! `(= ((MUL kf) ,c ,(inner side x v)) ((MUL kf) ((MUL kf) ,c ,e) ((MUL kf) ,b ,v)))
                           (lambda () (c5-crs! 'kf (list c e b v))))
                         (subst `(= ((MUL kf) ,c ,(inner side x v)) ((MUL kf) ((MUL kf) ,c ,e) ((MUL kf) ,b ,v))))
                         (subst `(= ((MUL kf) ,c ,e) (ONE kf)))
                         (dk-have! `(= ((MUL kf) (ONE kf) ((MUL kf) ,b ,v)) ((MUL kf) ,b ,v)) (lambda () (c5-crs! 'kf (list b v))))
                         (subst `(= ((MUL kf) (ONE kf) ((MUL kf) ,b ,v)) ((MUL kf) ,b ,v)))
                         (c5-val! 'kf 'chi `((MUL kf) ,b ,v))
                         (rfl))))
                   (dk-have! `(= ,tau ,l) (lambda () (subst `(= ,tau ,dmb)) (dk-ass!)))
                   (ew x)
                   (dk-conj-close!
                     (lambda ()
                       (cond
                         ((dk-ass!) #t)
                         ((dk-head-is? (dk-goal) '=) (dk-ass!))
                         (#t
                          ;; uniqueness: tau = LAM_y gives chi(c y v) = chi(b v) = chi(c x v), so c y = c x
                          (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                 (y (cadr (c5-ff (lambda (f) (dk-head-is? f 'IN)) landed "y")))
                                 (ly (caddr (c5-ff (lambda (f) (dk-head-is? f '=)) landed "ly")))
                                 (cy `((MUL kf) ,c ,y)) (cx `((MUL kf) ,c ,x))
                                 (dmy `(DUALITY-MAP kf chi ,cy)) (dmx `(DUALITY-MAP kf chi ,cx)))
                            (dk-cite! 'nf-mul-in-carr 'kf c y) (dk-cite! 'nf-mul-in-carr 'kf c x)
                            (dk-cite! 'ccr-5-12-character 'kf 'chi cy) (c5-hom! 'kf dmy)
                            (dk-cite! 'ccr-5-12-character 'kf 'chi cx) (c5-hom! 'kf dmx)
                            (dk-fun-ext! dmy dmx '(CARR kf) 'UNIT-CIRCLE #f #f
                              (lambda (v)
                                (subst (dk-cite! 'ch-psi-value 'kf 'chi cy v))
                                (subst (dk-cite! 'ch-psi-value 'kf 'chi cx v))
                                (eq-b! side ly y v) (eq-b! side l x v)
                                (dk-cite! 'nf-mul-in-carr 'kf (cadr (inner side y v)) (caddr (inner side y v)))
                                (dk-cite! 'nf-mul-in-carr 'kf (cadr (inner side x v)) (caddr (inner side x v)))
                                (dk-have! `(= ((MUL kf) ,cy ,v) ((MUL kf) ,c ,(inner side y v))) (lambda () (c5-crs! 'kf (list c y v))))
                                (dk-have! `(= ((MUL kf) ,cx ,v) ((MUL kf) ,c ,(inner side x v))) (lambda () (c5-crs! 'kf (list c x v))))
                                (subst `(= ((MUL kf) ,cy ,v) ((MUL kf) ,c ,(inner side y v))))
                                (subst `(= ((MUL kf) ,cx ,v) ((MUL kf) ,c ,(inner side x v))))
                                (let ((ty (wt side y v)) (tx (wt side x v)))
                                  (wval-back! (cadr ty) (caddr ty))
                                  (wval-back! (cadr tx) (caddr tx))
                                  (subst `(= ,ty (chi ((MUL kf) ,b ,v))))
                                  (subst `(= ,tx (chi ((MUL kf) ,b ,v))))
                                  (dk-cite! 'nf-mul-in-carr 'kf b v)
                                  (c5-val! 'kf 'chi `((MUL kf) ,b ,v))
                                  (rfl))))
                            (dk-cite! 'ccr-5-12-injective 'kf 'chi cy cx)
                            (dk-close-if! (lambda () (c5-cancel! 'kf c e y x)) (lambda () (dk-ass!)))
                            ))))))))))
          ((dk-head-is? (dk-goal) 'FORALL)
           ;; (b): x /= 0 is separated by some Psi(cc)
           (let* ((landed (dk-landed (lambda () (dk-peel!))))
                  (x (cadr (c5-ff (lambda (f) (dk-head-is? f 'IN)) landed "x(b)")))
                  (cc (dk-skolem! (dk-cite! 'ch-psi-separates 'kf 'chi x)))
                  (dm `(DUALITY-MAP kf chi ,cc)))
             (dk-cite! 'ccr-5-12-character 'kf 'chi cc)
             (dk-cite! 'nf-mul-in-carr 'kf cc '(ZERO kf))
             (dk-have! `(= ((MUL kf) ,cc (ZERO kf)) (ZERO kf)) (lambda () (c5-crs! 'kf (list cc))))
             (dk-cite! 'ch-psi-value 'kf 'chi cc '(ZERO kf))
             (ew dm)
             (dk-conj-close!
               (lambda ()
                 (if (not (dk-ass!))
                     (begin
                       (di)
                       (let* ((h (dk-pick (lambda (f) (and (dk-head-is? f 'NOT) (dk-contains? f `(,dm (ZERO kf))))) "separation"))
                              (h1 (dk-rewrite-h! h `(,dm (ZERO kf)) `(chi ((MUL kf) ,cc (ZERO kf)))))
                              (h2 (dk-rewrite-h! h1 `((MUL kf) ,cc (ZERO kf)) '(ZERO kf)))
                              (h3 (dk-rewrite-h! h2 '(chi (ZERO kf)) 1)))
                         (ai h3))))))))
          (#t #f))))))
(qed 'ccr-6-6)
