;;; 8. Chapter 6 over a self-dual field (Remark 6.4: "the only property of K used ... was self-duality"):
;;; the converse of Lemma 6.3, Proposition 6.20, Corollary 6.23, Corollary 6.6.

;; a character chi with Psi_chi(a) = tau: tau(x) = chi(a x)
(define (c5-dual-val! kf chi a tau x)
  (dk-cite! 'ccr-5-12-character kf chi a)
  (c5-hom! kf `(DUALITY-MAP ,kf ,chi ,a))
  (c5-val! kf `(DUALITY-MAP ,kf ,chi ,a) x)
  (dk-congr! `(= ,tau (DUALITY-MAP ,kf ,chi ,a)) (lambda (t) `(,t ,x)))
  (dk-cite! 'ch-psi-value kf chi a x))

(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL chi (IMPLIES (IS-DUALIZING-CHARACTER kf chi)
  (FORALL w (IMPLIES (IS-BILINEAR-BICHARACTER kf w)
    (FORSOME c5a (AND (IN c5a (CARR kf))
      (FORALL x (IMPLIES (IN x (CARR kf)) (FORALL eta (IMPLIES (IN eta (CARR kf))
        (= (w x eta) ((BICHAR-OF kf chi c5a) x eta))))))))))))))))
(dk-peel!)
(dk-cite! 'nf-one-in-carr 'kf)
(dk-project! '(IS-NONTRIVIAL-CHARACTER kf chi) 'is-dualizing-character '(IS-DUALIZING-CHARACTER kf chi))
(dk-project! '(IS-ADD-CHARACTER kf chi) 'is-nontrivial-character '(IS-NONTRIVIAL-CHARACTER kf chi))
(let* ((dual (dk-project! '(FORALL c5t_ (IMPLIES (IS-ADD-CHARACTER kf c5t_)
                               (FORSOME c5a_ (AND (IN c5a_ (CARR kf)) (= c5t_ (DUALITY-MAP kf chi c5a_))))))
                          'is-dualizing-character '(IS-DUALIZING-CHARACTER kf chi)))
       (bil (dk-project! '(FORALL cha_ (IMPLIES (IN cha_ (CARR kf)) (FORALL chx_ (IMPLIES (IN chx_ (CARR kf)) (FORALL chy_ (IMPLIES (IN chy_ (CARR kf))
                             (= (w ((MUL kf) cha_ chx_) chy_) (w chx_ ((MUL kf) cha_ chy_)))))))))
                         'is-bilinear-bicharacter '(IS-BILINEAR-BICHARACTER kf w)))
       (bic (dk-project! '(IS-BICHARACTER kf w) 'is-bilinear-bicharacter '(IS-BILINEAR-BICHARACTER kf w)))
       (right (dk-project! '(FORALL chy_ (IMPLIES (IN chy_ (CARR kf)) (IS-ADD-CHARACTER kf (VNB-LAMBDA chx_ (CARR kf) (w chy_ chx_)))))
                           'is-bicharacter '(IS-BICHARACTER kf w)))
       (l1 '(VNB-LAMBDA chx_ (CARR kf) (w (ONE kf) chx_)))
       (c (begin (dk-apply! right '(ONE kf)) (dk-skolem! (dk-apply! dual l1)))))
  (ew c)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((landed (dk-landed (lambda () (dk-peel!))))
                 (g (dk-goal))
                 (x (cadr (cadr g))) (eta (caddr (cadr g)))
                 (xe `((MUL kf) ,x ,eta)))
            (dk-cite! 'nf-mul-in-carr 'kf x eta)
            (dk-cite! 'nf-mul-in-carr 'kf x '(ONE kf))
            (subst (dk-cite! 'ch-bichar-value 'kf 'chi c x eta))
            (dk-have! `(= ((MUL kf) ,x (ONE kf)) ,x) (lambda () (c5-crs! 'kf (list x))))
            (let ((b1 (dk-rewrite-h! (dk-apply! bil x '(ONE kf) eta) `((MUL kf) ,x (ONE kf)) x)))
              (subst b1))
            (dk-have! `(== (,l1 ,xe) (w (ONE kf) ,xe)) (lambda () (dk-lam-b!) (qrfl)))
            (subst `(== (w (ONE kf) ,xe) (,l1 ,xe)))
            (let ((pv (c5-dual-val! 'kf 'chi c l1 xe)))
              (subst `(= (,l1 ,xe) ((DUALITY-MAP kf chi ,c) ,xe)))
              (subst pv))
            (dk-cite! 'nf-mul-in-carr 'kf c xe)
            (c5-hom! 'kf 'chi)
            (c5-val! 'kf 'chi `((MUL kf) ,c ,xe))
            (rfl))))))
(qed 'ccr-6-3-converse)

;; (= A A2) from (= (MUL C A) (MUL C A2)) and (= (MUL C D) ONE) in context, A A2 C D in CARR KF
(define (c5-cancel! kf c d a a2)
  (dk-have! `(= ((MUL ,kf) ,d ((MUL ,kf) ,c ,a)) ((MUL ,kf) ,d ((MUL ,kf) ,c ,a2)))
    (lambda () (subst `(= ((MUL ,kf) ,c ,a) ((MUL ,kf) ,c ,a2)))
               (dk-cite! 'nf-mul-in-carr kf c a2) (dk-cite! 'nf-mul-in-carr kf d `((MUL ,kf) ,c ,a2)) (rfl)))
  (for-each (lambda (u)
              (dk-have! `(= ((MUL ,kf) ,d ((MUL ,kf) ,c ,u)) ((MUL ,kf) ((MUL ,kf) ,c ,d) ,u)) (lambda () (c5-crs! kf (list c d u)))))
            (list a a2))
  (dk-have! `(= ,a ,a2)
    (lambda ()
      (dk-have! `(= ,a ((MUL ,kf) ((MUL ,kf) ,c ,d) ,a))
        (lambda () (subst `(= ((MUL ,kf) ,c ,d) (ONE ,kf))) (c5-crs! kf (list a))))
      (dk-have! `(= ,a2 ((MUL ,kf) ((MUL ,kf) ,c ,d) ,a2))
        (lambda () (subst `(= ((MUL ,kf) ,c ,d) (ONE ,kf))) (c5-crs! kf (list a2))))
      (subst `(= ,a ((MUL ,kf) ((MUL ,kf) ,c ,d) ,a)))
      (subst `(= ,a2 ((MUL ,kf) ((MUL ,kf) ,c ,d) ,a2)))
      (subst `(= ((MUL ,kf) ((MUL ,kf) ,c ,d) ,a) ((MUL ,kf) ,d ((MUL ,kf) ,c ,a))))
      (subst `(= ((MUL ,kf) ((MUL ,kf) ,c ,d) ,a2) ((MUL ,kf) ,d ((MUL ,kf) ,c ,a2))))
      (dk-ass!))))

;; uniqueness in Lemma 6.3
(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL chi (IMPLIES (IS-NONTRIVIAL-CHARACTER kf chi)
  (FORALL a (IMPLIES (IN a (CARR kf)) (FORALL b (IMPLIES (IN b (CARR kf))
    (IMPLIES (FORALL x (IMPLIES (IN x (CARR kf)) (FORALL eta (IMPLIES (IN eta (CARR kf))
               (= ((BICHAR-OF kf chi a) x eta) ((BICHAR-OF kf chi b) x eta))))))
      (= a b))))))))))))
(dk-peel!)
(dk-cite! 'nf-one-in-carr 'kf)
(dk-project! '(IS-ADD-CHARACTER kf chi) 'is-nontrivial-character '(IS-NONTRIVIAL-CHARACTER kf chi))
(let ((hyp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'BICHAR-OF))) "the hypothesis"))
      (da '(DUALITY-MAP kf chi a)) (db '(DUALITY-MAP kf chi b)))
  (dk-cite! 'ccr-5-12-character 'kf 'chi 'a) (dk-cite! 'ccr-5-12-character 'kf 'chi 'b)
  (c5-hom! 'kf da) (c5-hom! 'kf db) (c5-hom! 'kf 'chi)
  (dk-fun-ext! da db '(CARR kf) 'UNIT-CIRCLE #f #f
    (lambda (v)
      (let ((v1 `((MUL kf) (ONE kf) ,v)))
        (dk-cite! 'nf-mul-in-carr 'kf '(ONE kf) v)
        (dk-apply! hyp '(ONE kf) v)
        (dk-cite! 'ch-bichar-value 'kf 'chi 'a '(ONE kf) v) (dk-cite! 'ch-bichar-value 'kf 'chi 'b '(ONE kf) v)
        (subst (dk-cite! 'ch-psi-value 'kf 'chi 'a v)) (subst (dk-cite! 'ch-psi-value 'kf 'chi 'b v))
        (dk-have! `(= ,v1 ,v) (lambda () (c5-crs! 'kf (list v))))
        (let* ((h1 (dk-rewrite-h! `(= ((BICHAR-OF kf chi a) (ONE kf) ,v) ((BICHAR-OF kf chi b) (ONE kf) ,v))
                                  `((BICHAR-OF kf chi a) (ONE kf) ,v) `(chi ((MUL kf) a ,v1))))
               (h2 (dk-rewrite-h! h1 `((BICHAR-OF kf chi b) (ONE kf) ,v) `(chi ((MUL kf) b ,v1))))
               (h3 (dk-rewrite-h! h2 v1 v)))
          (dk-ass!)))))
  (dk-cite! 'ccr-5-12-injective 'kf 'chi 'a 'b)
  (dk-ass!))
(qed 'ccr-6-3-unique)

;; Proposition 6.20: every bilinear bicharacter is w0(a x, eta) for a unique a, w0 = BICHAR-OF(chi, c), c /= 0
(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL chi (IMPLIES (IS-DUALIZING-CHARACTER kf chi)
  (FORALL c (IMPLIES (IN c (CARR kf)) (IMPLIES (NOT (= c (ZERO kf)))
    (FORALL w (IMPLIES (IS-BILINEAR-BICHARACTER kf w)
      (AND (FORSOME c5a (AND (IN c5a (CARR kf))
             (FORALL x (IMPLIES (IN x (CARR kf)) (FORALL eta (IMPLIES (IN eta (CARR kf))
               (= (w x eta) ((BICHAR-OF kf chi c) ((MUL kf) c5a x) eta))))))))
           (FORALL c5a (IMPLIES (IN c5a (CARR kf)) (FORALL c5b (IMPLIES (IN c5b (CARR kf))
             (IMPLIES (FORALL x (IMPLIES (IN x (CARR kf)) (FORALL eta (IMPLIES (IN eta (CARR kf))
                        (= (w x eta) ((BICHAR-OF kf chi c) ((MUL kf) c5a x) eta))))))
               (IMPLIES (FORALL x (IMPLIES (IN x (CARR kf)) (FORALL eta (IMPLIES (IN eta (CARR kf))
                          (= (w x eta) ((BICHAR-OF kf chi c) ((MUL kf) c5b x) eta))))))
                 (= c5a c5b)))))))))))))))))))
(dk-peel!)
(dk-project! '(IS-NONTRIVIAL-CHARACTER kf chi) 'is-dualizing-character '(IS-DUALIZING-CHARACTER kf chi))
(dk-project! '(IS-ADD-CHARACTER kf chi) 'is-nontrivial-character '(IS-NONTRIVIAL-CHARACTER kf chi))
(c5-hom! 'kf 'chi)
(let* ((d (dk-skolem! (dk-cite! 'nf-inverse 'kf 'c)))
       (b (dk-skolem! (dk-cite! 'ccr-6-3-converse 'kf 'chi 'w)))
       (wb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f b))) "w = chi(b x eta)"))
       (bc! (lambda (a)          ; forall x eta: (BICHAR-OF chi c)(a x, eta) = (BICHAR-OF chi (c a))(x, eta)
              (let ((ca `((MUL kf) c ,a)))
                (dk-cite! 'nf-mul-in-carr 'kf 'c a)
                (dk-have! `(FORALL x (IMPLIES (IN x (CARR kf)) (FORALL eta (IMPLIES (IN eta (CARR kf))
                             (= ((BICHAR-OF kf chi c) ((MUL kf) ,a x) eta) ((BICHAR-OF kf chi ,ca) x eta))))))
                  (lambda ()
                    (dk-peel!)
                    (let* ((g (dk-goal)) (x (cadr (caddr g))) (eta (caddr (caddr g)))
                           (ax `((MUL kf) ,a ,x)))
                      (dk-cite! 'nf-mul-in-carr 'kf a x)
                      (subst (dk-cite! 'ch-bichar-value 'kf 'chi 'c ax eta))
                      (subst (dk-cite! 'ch-bichar-value 'kf 'chi ca x eta))
                      (dk-have! `(= ((MUL kf) c ((MUL kf) ,ax ,eta)) ((MUL kf) ,ca ((MUL kf) ,x ,eta)))
                        (lambda () (c5-crs! 'kf (append (list 'c x eta) (if (pair? a) (cdr a) (list a))))))
                      (subst `(= ((MUL kf) c ((MUL kf) ,ax ,eta)) ((MUL kf) ,ca ((MUL kf) ,x ,eta))))
                      (dk-cite! 'nf-mul-in-carr 'kf x eta) (dk-cite! 'nf-mul-in-carr 'kf ca `((MUL kf) ,x ,eta))
                      (c5-val! 'kf 'chi `((MUL kf) ,ca ((MUL kf) ,x ,eta)))
                      (rfl))))))))
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORSOME)
          ;; existence: a = d b
          (let ((a `((MUL kf) ,d ,b)))
            (dk-cite! 'nf-mul-in-carr 'kf d b)
            (bc! a)
            (dk-have! `(= ((MUL kf) c ,a) ,b)
              (lambda () (dk-have! `(= ((MUL kf) c ,a) ((MUL kf) ((MUL kf) c ,d) ,b)) (lambda () (c5-crs! 'kf (list 'c d b))))
                         (subst `(= ((MUL kf) c ,a) ((MUL kf) ((MUL kf) c ,d) ,b)))
                         (subst `(= ((MUL kf) c ,d) (ONE kf)))
                         (c5-crs! 'kf (list b))))
            (ew a)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (begin
                      (dk-peel!)
                      (let* ((g (dk-goal)) (x (cadr (cadr g))) (eta (caddr (cadr g))))
                        (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `((MUL kf) c ,a)))) "bc") x eta)
                        (subst `(= ((BICHAR-OF kf chi c) ((MUL kf) ,a ,x) ,eta) ((BICHAR-OF kf chi ((MUL kf) c ,a)) ,x ,eta)))
                        (subst `(= ((MUL kf) c ,a) ,b))
                        (dk-apply! wb x eta)
                        (dk-ass!)))))))
          ;; uniqueness: c a = c a' by ccr-6-3-unique, then cancel c
          (let* ((landed (dk-landed (lambda () (dk-peel!))))
                 (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(CARR kf)))) landed))
                 (a1 (cadr (car ins))) (a2 (cadr (cadr ins)))
                 (h1 (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f a1))) landed))
                 (h2 (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f a2))) landed)))
            (bc! a1) (bc! a2)
            (let ((ca1 `((MUL kf) c ,a1)) (ca2 `((MUL kf) c ,a2)))
              (dk-have! `(FORALL x (IMPLIES (IN x (CARR kf)) (FORALL eta (IMPLIES (IN eta (CARR kf))
                           (= ((BICHAR-OF kf chi ,ca1) x eta) ((BICHAR-OF kf chi ,ca2) x eta))))))
                (lambda ()
                  (dk-peel!)
                  (let* ((g (dk-goal)) (x (cadr (cadr g))) (eta (caddr (cadr g))))
                    (dk-apply! h1 x eta) (dk-apply! h2 x eta)
                    (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ca1) (not (dk-contains? f ca2)))) "bc1") x eta)
                    (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ca2) (not (dk-contains? f ca1)))) "bc2") x eta)
                    (subst `(= ((BICHAR-OF kf chi ,ca1) ,x ,eta) ((BICHAR-OF kf chi c) ((MUL kf) ,a1 ,x) ,eta)))
                    (subst `(= ((BICHAR-OF kf chi c) ((MUL kf) ,a1 ,x) ,eta) (w ,x ,eta)))
                    (subst `(= (w ,x ,eta) ((BICHAR-OF kf chi c) ((MUL kf) ,a2 ,x) ,eta)))
                    (subst `(= ((BICHAR-OF kf chi c) ((MUL kf) ,a2 ,x) ,eta) ((BICHAR-OF kf chi ,ca2) ,x ,eta)))
                    (dk-cite! 'ch-bichar-value 'kf 'chi ca2 x eta)
                    (rfl))))
              (dk-cite! 'ccr-6-3-unique 'kf 'chi ca1 ca2)
              (dk-close-if! (lambda () (c5-cancel! 'kf 'c d a1 a2)) (lambda () (dk-ass!)))
              ))))))
(qed 'ccr-6-20)

