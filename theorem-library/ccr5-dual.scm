;;; -----------------------------------------------------------------------
;;; 7. Lemma 6.14: a non-trivial character trivial on a ball gives a unipolar bicharacter.
;;; The notes take the least k with chi trivial on B(|uw|^k).  Without integer exponents: a point y1 with
;;; chi(y1) /= 1 and chi trivial on every |y| < |y1|.  If there were none, every such y would have a y'
;;; with chi(y') /= 1 and |y'| <= |uw| |y| (discreteness), so |y'| <= |y| - d, d = r0 - |uw| r0 > 0, and
;;; by induction |y| + n d <= |x0| for every n, against the archimedean property.

(define (c5-min kf chi)
  `(FORSOME c5y (AND (IN c5y (CARR ,kf)) (AND (NOT (= (,chi c5y) 1))
     (FORALL y (IMPLIES (IN y (CARR ,kf)) (IMPLIES (< ((FNRM ,kf) y) ((FNRM ,kf) c5y)) (= (,chi y) 1))))))))
(define (c5-desc kf chi n dd x0)
  `(FORSOME c5y (AND (IN c5y (CARR ,kf)) (AND (NOT (= (,chi c5y) 1)) (<= (+ ((FNRM ,kf) c5y) (* ,n ,dd)) ((FNRM ,kf) ,x0))))))

(sp (make-wff `(FORALL c5n (IMPLIES (IN c5n NN) (FORALL kf (FORALL uw (IMPLIES (IS-LOCAL-UNIFORMIZER kf uw)
  (FORALL chi (IMPLIES (IS-ADD-CHARACTER kf chi) (FORALL r0 (IMPLIES (IN r0 RR)
    (IMPLIES (FORALL y (IMPLIES (IN y (CARR kf)) (IMPLIES (<= ((FNRM kf) y) r0) (= (chi y) 1))))
      (FORALL x0 (IMPLIES (IN x0 (CARR kf)) (IMPLIES (NOT (= (chi x0) 1))
        (FORALL dd (IMPLIES (IN dd RR) (IMPLIES (= dd (- r0 (* ((FNRM kf) uw) r0)))
          (OR ,(c5-min 'kf 'chi) ,(c5-desc 'kf 'chi 'c5n 'dd 'x0))))))))))))))))))))
(let* ((leaves (dk-opened (lambda () (dk-ni-fixed! '(kf uw chi r0 x0 dd)))))
       (base (find-first (lambda (l) (not (dk-contains? (dk-goal-of l) 'succ))) leaves))
       (step (find-first (lambda (l) (dk-contains? (dk-goal-of l) 'succ)) leaves))
       (t '((FNRM kf) uw)) (nx0 '((FNRM kf) x0)))
  (dk-focus! base)
  (dk-cite! 'c5-lu-nv-field 'kf 'uw)
  (dk-cite! 'nv-field-normed 'kf)
  (dk-cite! 'nf-norm-in-rr 'kf 'x0)
  (oi-r)
  (ew 'x0)
  (dk-conj-close! (lambda () (if (not (dk-ass!)) (dk-ineq! `(IN dd RR)))))
  (dk-focus! step)
  (let* ((landed (dk-landed (lambda () (dk-peel!))))
         (nv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed)))
         (ih (find-first (lambda (f) (dk-head-is? f 'OR)) landed))
         (rn (c5-desc 'kf 'chi nv 'dd 'x0))
         (gl (dk-goal)))
    (dk-cite! 'c5-lu-nv-field 'kf 'uw)
    (dk-cite! 'nv-field-normed 'kf)
    (dk-split! (dk-cite! 'c5-lu-norm 'kf 'uw)) (dk-cite! 'nf-norm-in-rr 'kf 'uw)
    (dk-cite! 'nf-norm-in-rr 'kf 'x0)
    (fact 'rr-one-in) (fact 'rr-zero-in)
    (dk-have! `(IMPLIES ,rn ,gl)
      (lambda ()
        (di)
        (let* ((y (dk-skolem! rn))
               (s `((FNRM kf) ,y))
               (hyp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'r0) (dk-contains? f 'chi))) "the ball")))
          (dk-cite! 'nf-norm-in-rr 'kf y)
          (use-em `(FORALL c5z_ (IMPLIES (IN c5z_ (CARR kf)) (IMPLIES (< ((FNRM kf) c5z_) ,s) (= (chi c5z_) 1))))
            (lambda ()
              (oi-l) (ew y) (dk-conj-close! (lambda () (dk-ass!))))
            (lambda ()
              (let* ((ex (dk-landed-1 (lambda () (push-not-h `(NOT (FORALL c5z_ (IMPLIES (IN c5z_ (CARR kf))
                                                                  (IMPLIES (< ((FNRM kf) c5z_) ,s) (= (chi c5z_) 1)))))))))
                     (yp (dk-skolem! ex))
                     (ni (dk-pick (lambda (f) (and (dk-head-is? f 'NOT) (dk-contains? f yp))) "the NOT"))
                     (sp_ `((FNRM kf) ,yp)))
                (if (dk-head-is? (cadr ni) 'IMPLIES)
                    (dk-split! (dk-landed-1 (lambda () (push-not-h ni)))))
                (dk-cite! 'nf-norm-in-rr 'kf yp)
                (dk-cite! 'c5-lu-discrete 'kf 'uw yp y)
                ;; r0 <= |y|
                (dk-have! `(IMPLIES (<= ,s r0) (= (chi ,y) 1)) (lambda () (di) (dk-apply! hyp y) (dk-ass!)))
                (c5-and! `(IN ,s RR) '(IN r0 RR))
                (dk-cite! 'rr-leq-total s 'r0)
                (dk-have! `(<= r0 ,s)
                  (lambda () (keep `(OR (<= ,s r0) (<= r0 ,s)) `(IMPLIES (<= ,s r0) (= (chi ,y) 1)) `(NOT (= (chi ,y) 1)))
                    (prop)))
                ;; t s - t r0 <= s - r0
                (dk-have! `(<= ,t 1) (lambda () (dk-ineq! `(< ,t 1))))
                (dk-have! `(IN (- ,s r0) RR) (lambda () (type-term)))
                (dk-have! `(<= 0 (- ,s r0)) (lambda () (dk-ineq! `(<= r0 ,s))))
                (let ((h (dk-cite! 'rr-mul-le-right t 1 `(- ,s r0))))
                  (c5-rr-mul! t s) (c5-rr-mul! t 'r0) (c5-rr-mul! t `(- ,s r0)) (c5-rr-mul! 1 `(- ,s r0))
                  (dk-have! `(= (* ,t (- ,s r0)) (- (* ,t ,s) (* ,t r0))) (lambda () (crs)))
                  (dk-have! `(= (* 1 (- ,s r0)) (- ,s r0)) (lambda () (crs)))
                  (let* ((h1 (dk-rewrite-h! h `(* ,t (- ,s r0)) `(- (* ,t ,s) (* ,t r0))))
                         (h2 (dk-rewrite-h! h1 `(* 1 (- ,s r0)) `(- ,s r0))))
                    (dk-cite! 'nn-in-rr nv)
                    (c5-rr-mul! nv 'dd)
                    (fact 'nn-succ-plus-one nv)
                    (oi-r) (ew yp)
                    (dk-conj-close!
                      (lambda ()
                        (if (not (dk-ass!))
                            (begin
                              (subst `(= (succ ,nv) (+ ,nv 1)))
                              (dk-have! `(= (* (+ ,nv 1) dd) (+ (* ,nv dd) dd)) (lambda () (crs)))
                              (subst `(= (* (+ ,nv 1) dd) (+ (* ,nv dd) dd)))
                              (dk-ineq! h2 `(<= ,sp_ (* ,t ,s)) '(= dd (- r0 (* ((FNRM kf) uw) r0)))
                                        `(<= (+ ,s (* ,nv dd)) ,nx0))))))))))))))
    (keep ih `(IMPLIES ,rn ,gl))
    (prop)))
(qed 'c5-chi-min-ind)

(sp (make-wff `(FORALL kf (FORALL uw (IMPLIES (IS-LOCAL-UNIFORMIZER kf uw)
