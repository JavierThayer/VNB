                          (x (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
                     (dk-have! '(FORSOME c5z (IN c5z c5e)) (lambda () (ew x) (dk-ass!)))
                     (ai neg))))))))))
(qed 'c5-compact-norm-bound)

;; 0 < T from T in RR, 0 <= T and NOT (T = 0) in context
(define (c5-lt-of-ne! t)
  (dk-have! `(POS-RR ,t)
    (lambda () (mac 'pos-rr)
      (dk-conj-close!
        (lambda () (if (not (dk-ass!))
                       (begin (di) (dk-have! `(= ,t 0) (lambda () (subst `(= ,t 0)) (rfl))) (ai `(NOT (= ,t 0)))))))))
  (dk-cite! 'rr-lt-of-pos-rr t))
;; POS-RR from 0 < t, t in RR
(define (c5-pos! t)
  (if (not (dk-asm? `(POS-RR ,t)))
      (dk-have! `(POS-RR ,t)
        (lambda () (mac 'pos-rr)
          (dk-conj-close! (lambda () (cond ((dk-ass!) #t)
                                           ((dk-head-is? (dk-goal) '<=) (dk-ineq! `(< 0 ,t)))
                                           (#t (di) (dk-absurd! (car (dk-asms)) `(< 0 ,t))))))))))
;; NOT (T = 0) from 0 < T
(define (c5-nz! t)
  (if (not (dk-asm? `(NOT (= ,t 0))))
      (dk-have! `(NOT (= ,t 0)) (lambda () (di) (dk-absurd! `(= ,t 0) `(< 0 ,t))))))
;; chi(a' x) = chi(a x) when |(a' - a) x| <= r0 and chi is trivial on B(r0)
(define (c5-shift! kf chi hom triv ap a x)
  (let* ((d `((ADD ,kf) ,ap ((NEG ,kf) ,a)))
         (dx `((MUL ,kf) ,d ,x)) (ax `((MUL ,kf) ,a ,x)) (apx `((MUL ,kf) ,ap ,x)))
    (dk-cite! 'nf-neg-in-carr kf a)
    (dk-cite! 'nf-add-in-carr kf ap `((NEG ,kf) ,a))
    (dk-cite! 'nf-mul-in-carr kf d x) (dk-cite! 'nf-mul-in-carr kf a x) (dk-cite! 'nf-mul-in-carr kf ap x)
    (dk-apply! triv dx)
    (c5-val! kf chi ax)
    (dk-have! `(= ((ADD ,kf) ,ax ,dx) ,apx) (lambda () (c5-crs! kf (list a ap x))))
    (let ((h (dk-rewrite-h! (dk-apply! hom ax dx) `((ADD ,kf) ,ax ,dx) apx)))
      (dk-have! `(= (,chi ,apx) (,chi ,ax))
        (lambda () (subst h) (subst `(= (,chi ,dx) 1)) (crs))))))

;; Proposition 5.12, continuity: a_k -> a in K gives Psi(a_k) -> Psi(a) uniformly on compact sets
(sp (make-wff '(FORALL kf (IMPLIES (IS-NV-FIELD kf) (FORALL chi (IMPLIES (IS-ADD-CHARACTER kf chi)
  (FORALL asq (IMPLIES (IN asq (FUN NN (CARR kf))) (FORALL a (IMPLIES (IN a (CARR kf))
    (IMPLIES (CONVERGES-TO (NF-METRIC-SPACE kf) asq a)
      (CHAR-CONVERGES kf (VNB-LAMBDA c5k NN (DUALITY-MAP kf chi (asq c5k))) (DUALITY-MAP kf chi a)))))))))))))
(dk-peel!)
(dk-cite! 'nv-field-normed 'kf)
(fact 'rr-zero-in)
(let* ((ms '(NF-METRIC-SPACE kf))
       (r0 (dk-skolem! (dk-cite! 'ccr-6-17-ball 'kf 'chi)))
       (triv (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r0))) "the ball"))
       (hom (c5-hom! 'kf 'chi))
       (conv (dk-project! `(FORALL eps (IMPLIES (POS-RR eps) (FORSOME n (AND (IN n NN) (FORALL n_ (IMPLIES (IN n_ NN)
                              (IMPLIES (<= n n_) (<= ((DIST ,ms) (asq n_) a) eps))))))))
                          'converges-to `(CONVERGES-TO ,ms asq a))))
  (dk-cite! 'rr-pos-rr-in-rr r0) (dk-cite! 'rr-lt-of-pos-rr r0)
  (mac 'CHAR-CONVERGES)
  (let* ((landed (dk-landed (lambda () (dk-peel!))))
         (eps (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) landed)))
         (e (cadr (find-first (lambda (f) (dk-head-is? f 'SUBSET)) landed)))
         (bR (dk-skolem! (dk-cite! 'c5-compact-norm-bound 'kf e)))
         (bnd (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f bR))) "the bound"))
         (rc `(recip ,bR))
         (dl `(* ,r0 ,rc)))
    (dk-cite! 'rr-pos-rr-in-rr eps) (dk-cite! 'rr-lt-of-pos-rr eps)
    (c5-nz! bR)
    (c5-and! `(IN ,bR RR) `(NOT (= ,bR 0)))
    (dk-cite! 'rr-recip-closed bR)
    (dk-cite! 'rr-recip-pos bR)
    (c5-rr-mul! r0 rc)
    (dk-cite! 'rr-mul-pos r0 rc)
    (c5-pos! dl)
    (dk-cite! 'rr-recip-cancel-right r0 bR)
    (let* ((nN (dk-skolem! (dk-apply! conv dl)))
           (near (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nN) (dk-contains? f 'DIST))) "N")))
      (ew nN)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((landed (dk-landed (lambda () (dk-peel!))))
                     (m (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed)))
                     (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) e))) landed)))
                     (am `(asq ,m)))
                (c5-and! '(IN asq (FUN NN (CARR kf))) `(IN ,m NN))
                (dk-cite! 'fun-apply-type 'asq 'NN '(CARR kf) m)
                (dk-cite! 'subset-mem-fwd e '(CARR kf) x)
                (dk-lam-b!)
                (subst (dk-cite! 'ch-psi-value 'kf 'chi am x))
                (subst (dk-cite! 'ch-psi-value 'kf 'chi 'a x))
                ;; |(a_m - a) x| <= r0
                (let* ((d `((ADD kf) ,am ((NEG kf) a)))
                       (t `((FNRM kf) ,d)) (nx `((FNRM kf) ,x)))
                  (dk-cite! 'nf-neg-in-carr 'kf 'a)
                  (dk-cite! 'nf-add-in-carr 'kf am '((NEG kf) a))
                  (dk-cite! 'nf-mul-in-carr 'kf d x)
                  (dk-cite! 'nf-norm-in-rr 'kf `((MUL kf) ,d ,x))
                  (dk-cite! 'nf-norm-in-rr 'kf d) (dk-cite! 'nf-norm-in-rr 'kf x)
                  (dk-cite! 'nf-norm-nonneg 'kf d) (dk-cite! 'nf-norm-nonneg 'kf x)
                  (dk-cite! 'nf-norm-mult 'kf d x)
                  (dk-cite! 'nf-metric-distance 'kf am 'a)
                  (let ((h (dk-rewrite-h! (dk-apply! near m) `((DIST ,ms) ,am a) t)))
                    (dk-apply! bnd x)
                    (dk-have! `(<= 0 ,bR) (lambda () (dk-ineq! `(< 0 ,bR))))
                    (dk-cite! 'rr-mul-le-right nx bR t)
                    (dk-cite! 'rr-mul-le-right t dl bR)
                    (c5-rr-mul! nx t) (c5-rr-mul! bR t) (c5-rr-mul! t bR) (c5-rr-mul! dl bR) (c5-rr-mul! t nx)
                    (dk-have! `(= (* ,t ,nx) (* ,nx ,t)) (lambda () (crs)))
                    (dk-have! `(= (* ,bR ,t) (* ,t ,bR)) (lambda () (crs)))
                    (dk-have! `(<= ((FNRM kf) ((MUL kf) ,d ,x)) ,r0)
                      (lambda () (dk-ineq! `(= ((FNRM kf) ((MUL kf) ,d ,x)) (* ,t ,nx)) `(= (* ,t ,nx) (* ,nx ,t))
                                           `(<= (* ,nx ,t) (* ,bR ,t)) `(= (* ,bR ,t) (* ,t ,bR))
                                           `(<= (* ,t ,bR) (* ,dl ,bR)) `(= ,r0 (* ,dl ,bR)))))))
                (c5-shift! 'kf 'chi hom triv am 'a x)
                (subst `(= (chi ((MUL kf) ,am ,x)) (chi ((MUL kf) a ,x))))
                (let ((w `(chi ((MUL kf) a ,x))))
                  (dk-have! `(= (- ,w ,w) 0) (lambda () (crs)))
                  (subst `(= (- ,w ,w) 0))
                  (fact 'cc-magnitude-zero)
                  (subst '(= (magnitude 0) 0))
                  (dk-ass!)))))))))
(qed 'ccr-5-12-continuous)

