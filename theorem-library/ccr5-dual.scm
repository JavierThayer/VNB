;; Proposition 6.17: every character of the additive group of an NV field is locally constant
(sp (make-wff '(FORALL kf (IMPLIES (IS-NV-FIELD kf) (FORALL chi (IMPLIES (IS-ADD-CHARACTER kf chi) (IS-LOCALLY-CONSTANT-FN kf chi)))))))
(dk-peel!)
(dk-cite! 'nv-field-normed 'kf)
(let* ((r (dk-skolem! (dk-cite! 'ccr-6-17-ball 'kf 'chi)))
       (triv (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r))) "the ball"))
       (hom (c5-hom! 'kf 'chi)))
  (mac 'IS-LOCALLY-CONSTANT-FN)
  (let* ((landed (dk-landed (lambda () (dk-peel!))))
         (x (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
    (ew r)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let* ((landed (dk-landed (lambda () (dk-peel!))))
                   (y (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed)))
                   (d `((ADD kf) ,y ((NEG kf) ,x))))
              (dk-cite! 'nf-neg-in-carr 'kf x)
              (dk-cite! 'nf-add-in-carr 'kf y `((NEG kf) ,x))
              (dk-apply! triv d)
              (c5-val! 'kf 'chi x)
              (dk-have! `(= ((ADD kf) ,d ,x) ,y) (lambda () (c5-crs! 'kf (list x y))))
              (dk-rewrite-h! (dk-apply! hom d x) `((ADD kf) ,d ,x) y)
              (subst `(= (chi ,y) (* (chi ,d) (chi ,x))))
              (subst `(= (chi ,d) 1))
              (crs)))))))
(qed 'ccr-6-17)

;; Lemma 6.16, which 6.17 makes unconditional: given a non-trivial locally constant character, every
;; character is locally constant
(sp (make-wff '(FORALL kf (IMPLIES (IS-NV-FIELD kf)
  (IMPLIES (FORSOME c5c (AND (IS-NONTRIVIAL-CHARACTER kf c5c) (IS-LOCALLY-CONSTANT-FN kf c5c)))
    (FORALL tau (IMPLIES (IS-ADD-CHARACTER kf tau) (IS-LOCALLY-CONSTANT-FN kf tau))))))))
(dk-peel!)
(dk-cite! 'ccr-6-17 'kf 'tau)
(dk-ass!)
(qed 'ccr-6-16)

;;; -----------------------------------------------------------------------
;;; 3. Compact subsets of K are bounded; continuity of a |-> Psi(a) (Proposition 5.12, the remaining half).

(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL c5e (IMPLIES (SUBSET c5e (CARR kf))
  (IMPLIES (IS-COMPACT (SUBSPACE-MS (NF-METRIC-SPACE kf) c5e))
    (FORSOME c5b (AND (IN c5b RR) (AND (< 0 c5b) (FORALL x (IMPLIES (IN x c5e) (<= ((FNRM kf) x) c5b)))))))))))))
(dk-peel!)
(let ((ms '(NF-METRIC-SPACE kf)) (sub '(SUBSPACE-MS (NF-METRIC-SPACE kf) c5e)))
  (dk-project! '(IN (CARR kf) SET) 'is-normed-field '(IS-NORMED-FIELD kf))
  (dk-cite! 'subclass-of-set-is-set 'c5e '(CARR kf))
  (dk-cite! 'nf-metric-space-is-metric-space 'kf)
  (fact 'rr-one-in) (fact 'rr-zero-in)
  (use-em '(FORSOME c5z (IN c5z c5e))
    (lambda ()
      (let* ((x0 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'c5z))) "x0")))
             (bd (dk-cite! 'compact-is-bounded sub))
             (bex (dk-project! `(FORSOME b (AND (IN b RR) (FORALL x (FORALL y (IMPLIES (IN x (PTS ,sub)) (IMPLIES (IN y (PTS ,sub))
                                    (<= ((DIST ,sub) x y) b)))))))
                               'is-bounded-metric-space bd))
             (b (dk-skolem! bex))
             (bnd (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f b))) "the bound")))
        (dk-cite! 'subspace-pts ms 'c5e)
        (dk-cite! 'subset-mem-fwd 'c5e '(CARR kf) x0)
        (dk-cite! 'nf-norm-in-rr 'kf x0)
        (dk-cite! 'nf-norm-nonneg 'kf x0)
        (let ((ub (lambda (x)   ; x in c5e: |x| <= b + |x0|
                    (dk-cite! 'subset-mem-fwd 'c5e '(CARR kf) x)
                    (dk-have! `(IN ,x (PTS ,sub)) (lambda () (subst `(== (PTS ,sub) c5e)) (dk-ass!)))
                    (dk-have! `(IN ,x0 (PTS ,sub)) (lambda () (subst `(== (PTS ,sub) c5e)) (dk-ass!)))
                    (let ((h (dk-apply! bnd x x0)))
                      (dk-cite! 'subspace-dist ms 'c5e x x0)
                      (dk-cite! 'nf-neg-in-carr 'kf x0)
                      (dk-cite! 'nf-add-in-carr 'kf x `((NEG kf) ,x0))
                      (dk-cite! 'nf-metric-distance 'kf x x0)
                      (let* ((d `((ADD kf) ,x ((NEG kf) ,x0)))
                             (h2 (dk-rewrite-h! h `((DIST ,sub) ,x ,x0) `((DIST ,ms) ,x ,x0)))
                             (h3 (dk-rewrite-h! h2 `((DIST ,ms) ,x ,x0) `((FNRM kf) ,d))))
                        (dk-cite! 'nf-norm-subadd 'kf d x0)
                        (dk-cite! 'nf-norm-in-rr 'kf d)
                        (dk-have! `(= ((ADD kf) ,d ,x0) ,x) (lambda () (c5-crs! 'kf (list x x0))))
                        (let ((h4 (dk-rewrite-h! `(<= ((FNRM kf) ((ADD kf) ,d ,x0)) (+ ((FNRM kf) ,d) ((FNRM kf) ,x0)))
                                                 `((ADD kf) ,d ,x0) x)))
                          (dk-cite! 'nf-norm-in-rr 'kf x)
                          (dk-have! `(<= ((FNRM kf) ,x) (+ ,b ((FNRM kf) ,x0))) (lambda () (dk-ineq! h3 h4)))))))))
          (ub x0)
          (dk-have! `(IN (+ (+ ,b ((FNRM kf) ,x0)) 1) RR) (lambda () (type-term)))
          (ew `(+ (+ ,b ((FNRM kf) ,x0)) 1))
          (dk-conj-close!
            (lambda ()
              (cond ((dk-ass!) #t)
                    ((dk-head-is? (dk-goal) '<)
                     (dk-ineq! `(<= ((FNRM kf) ,x0) (+ ,b ((FNRM kf) ,x0))) `(<= 0 ((FNRM kf) ,x0))))
                    (#t
                     (let* ((landed (dk-landed (lambda () (dk-peel!))))
                            (x (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
                       (ub x)
                       (dk-ineq! `(<= ((FNRM kf) ,x) (+ ,b ((FNRM kf) ,x0))) `(<= ((FNRM kf) ,x0) (+ ,b ((FNRM kf) ,x0)))
                                 `(<= 0 ((FNRM kf) ,x0)))))))))))
    (lambda ()
      (let ((neg (dk-pick (lambda (f) (and (dk-head-is? f 'NOT) (dk-contains? f 'c5z))) "the empty case")))
        (ew 1)
        (dk-conj-close!
          (lambda ()
            (cond ((dk-ass!) #t)
