(define (c5-dist0-eq! kf y)
  (let ((eq `(= ((DIST (NF-METRIC-SPACE ,kf)) (ZERO ,kf) ,y) ((FNRM ,kf) ,y))))
    (if (not (dk-asm? eq)) (dk-have! eq (lambda () (c5-dist0! kf y) (rfl))))
    eq))
(define (c5-lu-proj! name concl)
  (sp (make-wff `(FORALL kf (FORALL uw (IMPLIES (IS-LOCAL-UNIFORMIZER kf uw) ,concl)))))
  (dk-peel!)
  (dk-project! concl 'is-local-uniformizer '(IS-LOCAL-UNIFORMIZER kf uw))
  (dk-ass!)
  (qed name))
(c5-lu-proj! 'c5-lu-compact '(IS-COMPACT-NV-DOMAIN kf (NV-INTEGERS kf)))
(c5-lu-proj! 'c5-lu-in '(IN uw (NV-INTEGERS kf)))
(c5-lu-proj! 'c5-lu-maximal '(= (NV-MAXIMAL kf (NV-INTEGERS kf)) (NV-PRINCIPAL kf (NV-INTEGERS kf) uw)))
(c5-lu-proj! 'c5-lu-nonzero '(NOT (= uw (ZERO kf))))

(sp (make-wff '(FORALL kf (FORALL uw (IMPLIES (IS-LOCAL-UNIFORMIZER kf uw) (IS-NV-FIELD kf))))))
(dk-peel!)
