;;; 9. Proposition 6.18 (existence half) and Proposition 6.21.

;; Proposition 6.18, the unipolar half: a local NV field with a non-trivial character has a unipolar
;; bicharacter (6.17-ball + 6.14).  Faithfulness is Corollary 6.6 (needs self-duality, 5.13).
(sp (make-wff '(FORALL kf (FORALL uw (IMPLIES (IS-LOCAL-UNIFORMIZER kf uw)
  (FORALL chi (IMPLIES (IS-NONTRIVIAL-CHARACTER kf chi) (FORSOME c5w (IS-UNIPOLAR kf c5w)))))))))
(dk-peel!)
(dk-cite! 'c5-lu-nv-field 'kf 'uw)
(dk-project! '(IS-ADD-CHARACTER kf chi) 'is-nontrivial-character '(IS-NONTRIVIAL-CHARACTER kf chi))
(dk-skolem! (dk-cite! 'ccr-6-17-ball 'kf 'chi))
(let ((r (cadr (dk-pick (lambda (f) (dk-head-is? f 'POS-RR)) "the radius"))))
  (dk-cite! 'ccr-6-14 'kf 'uw 'chi r)
  (dk-ass!))
(qed 'ccr-6-18-unipolar)

;; y in B(0, r) <-> y in K and |y| <= r
(define (c5-in-ball! kf r y)        ; goal (IN y (CLOSED-BALL ms 0 r)), with (IN y (CARR kf)), (<= |y| r) in context
  (let ((ms `(NF-METRIC-SPACE ,kf)))
    (c5-dist0-eq! kf y)
    (mac 'closed-ball-membership)
    (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN)
                                   (begin (subst `(== (PTS ,ms) (CARR ,kf))) (dk-ass!))
                                   (begin (subst `(= ((DIST ,ms) (ZERO ,kf) ,y) ((FNRM ,kf) ,y))) (dk-ass!)))))))
(define (c5-ball-out! kf r y)       ; (IN y (CLOSED-BALL ms 0 r)) in context: land (IN y (CARR kf)), (<= |y| r)
  (let ((ms `(NF-METRIC-SPACE ,kf)))
    (c5-iff-fwd! (dk-cite! 'closed-ball-membership ms `(ZERO ,kf) r y))
    (dk-rewrite-h! `(IN ,y (PTS ,ms)) `(PTS ,ms) `(CARR ,kf))
    (c5-dist0-eq! kf y)
    (dk-rewrite-h! `(<= ((DIST ,ms) (ZERO ,kf) ,y) ,r) `((DIST ,ms) (ZERO ,kf) ,y) `((FNRM ,kf) ,y))))

;; Proposition 6.21: for a unipolar w and c /= 0, eta is in pol_w B(|c|) iff |c eta| <= 1 (pol B(s) = B(1/s))
(sp (make-wff '(FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL w (IMPLIES (IS-UNIPOLAR kf w)
  (FORALL c (IMPLIES (IN c (CARR kf)) (IMPLIES (NOT (= c (ZERO kf)))
