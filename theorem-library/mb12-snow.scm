;;; mb12-snow.scm -- construction-of-measures.pdf Appendix A.3.2, the snowflake
;;; construction: Lemma A.10 ((a + b)^s <= a^s + b^s for 0 < s <= 1, a, b >= 0) and
;;; Proposition A.9 (d^s is a metric).  Agent ISOM (brief M-B1B2), 2026-10-26.
;;;
;;;   rpow-one-base          1^c = 1
;;;   rpow-le-self-gt1       x > 1, 0 < s <= 1  ==>  x^s <= x
;;;   rpow-ge-self-lt1       0 < b < 1, 0 < s <= 1  ==>  b <= b^s
;;;   rpow-one-plus-small    0 < t < 1  ==>  (1 + t)^s <= 1 + t^s
;;;   rpow-one-plus          t > 0  ==>  (1 + t)^s <= 1 + t^s
;;;   rpow-subadditive       (A.10)
;;;   SNOWFLAKE(s, e), snowflake-is-metric-space   (A.9)
;;;
;;; The proof is the notes': (1 + t)^s <= 1 + t <= 1 + t^s for t < 1; for t > 1 factor t out;
;;; for general a, b factor a out.  Powers are RPOW-STAR.
;;;
;;; WINDOW.  Citations: rpow-star-* (rpow-defined and laws), log-one, r-exp-zero, the rr
;;; order laws.  The latest citations are rpow-star-nonneg-* (limsup-tests, load.scm 3494).
;;; lo = after limsup-tests.scm and mb12-vocab.scm; hi = none.  Library: analysis.
;;;
;;; Helper prefix: msn-.

(define (msn-head g) (and (pair? g) (car g)))
(define (msn-rp x s) (list 'RPOW-STAR x s))
(define (msn-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass))))))
    f))
(define (msn-rr! t)
  (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))))
(define (msn-rpow! x s)                ; x > 0, x, s in RR: x^s in RR, 0 < x^s
  (let ((p (msn-rp x s)))
    (if (not (dk-asm? (list 'IN p 'RR))) (dk-close-if! (lambda () (fact 'rpow-star-in-rr x s)) (lambda () #t)))
    (if (not (dk-asm? (list '< 0 p))) (dk-close-if! (lambda () (fact 'rpow-star-pos x s)) (lambda () #t)))
    p))
(define (msn-name! t) (msn-rr! t) (dk-name! t 'RR))
;;; P * X <= P * Y from X <= Y and 0 < P (all real)
(define (msn-mul-le! P X Y)
  (msn-rr! (list '* X P)) (msn-rr! (list '* Y P))
  (dk-have! (list '<= 0 P) (lambda () (dk-ineq! (list '< 0 P) (list 'IN P 'RR))))
  (dk-close-if! (lambda () (fact 'rr-mul-le-right X Y P)) (lambda () #t))
  (list '<= (list '* X P) (list '* Y P)))

(sp (make-wff '(FORALL c (IMPLIES (IN c RR) (= (RPOW-STAR 1 c) 1)))))
(dk-peel!)
(fact 'rr-one-in)
(dk-have! '(< 0 1) (lambda () (arith)))
(fact 'rpow-star-value 1 'c)
(subst '(= (RPOW-STAR 1 c) (r-exp (* c (log 1)))))
(fact 'log-one)
(subst '(= (log 1) 0))
(dk-have! '(= (* c 0) 0) (lambda () (crs)))
(subst '(= (* c 0) 0))
(fact 'r-exp-zero)
(ass)
(qed 'rpow-one-base)
(topic! 'rpow-one-base 'analysis)

;;; x > 1, 0 < s <= 1: x^s <= x
(sp (make-wff '(FORALL x (IMPLIES (IN x RR) (FORALL s (IMPLIES (IN s RR)
     (IMPLIES (< 1 x) (IMPLIES (< 0 s) (IMPLIES (<= s 1) (<= (RPOW-STAR x s) x))))))))))
(dk-peel!)
(fact 'rr-one-in)
(dk-have! '(< 0 x) (lambda () (dk-ineq! '(< 1 x) '(IN x RR))))
(msn-rpow! 'x 's)
(fact 'rpow-star-one 'x)
(use-em '(= s 1)
  (lambda () (subst '(= s 1)) (subst '(= (RPOW-STAR x 1) x)) (dk-ineq! '(IN x RR)))
  (lambda ()
    (dk-have! '(< s 1) (lambda () (msn-and! '(<= s 1) '(NOT (= s 1))) (fact 'rr-le-ne-lt 's 1) (ass)))
    (fact 'rpow-star-mono-exp 'x 's 1)
    (msn-rpow! 'x 1)
    (dk-ineq! '(< (RPOW-STAR x s) (RPOW-STAR x 1)) '(= (RPOW-STAR x 1) x)
              '(IN (RPOW-STAR x s) RR) '(IN (RPOW-STAR x 1) RR) '(IN x RR))))
(qed 'rpow-le-self-gt1)
(topic! 'rpow-le-self-gt1 'analysis)

;;; 0 < b < 1, 0 < s <= 1: b <= b^s
(sp (make-wff '(FORALL b (IMPLIES (IN b RR) (FORALL s (IMPLIES (IN s RR)
     (IMPLIES (< 0 b) (IMPLIES (< b 1) (IMPLIES (< 0 s) (IMPLIES (<= s 1) (<= b (RPOW-STAR b s))))))))))))
(dk-peel!)
(fact 'rr-one-in)
(msn-rpow! 'b 's)
(fact 'rpow-star-one 'b)
(use-em '(= s 1)
  (lambda () (subst '(= s 1)) (subst '(= (RPOW-STAR b 1) b)) (dk-ineq! '(IN b RR)))
  (lambda ()
    (dk-have! '(< s 1) (lambda () (msn-and! '(<= s 1) '(NOT (= s 1))) (fact 'rr-le-ne-lt 's 1) (ass)))
    (let* ((c '(- 1 s)) (P '(RPOW-STAR b s)) (Q (msn-rp 'b c)))
      (msn-rr! c)
      (dk-have! (list '< 0 c) (lambda () (dk-ineq! '(< s 1) '(IN s RR))))
      (msn-rpow! 'b c)
      ;; Q < 1^c = 1
      (dk-have! '(< 0 1) (lambda () (arith)))
      (msn-rpow! 1 c)
      (fact 'rpow-star-mono-base 'b 1 c)
      (fact 'rpow-one-base c)
      (dk-have! (list '< Q 1) (lambda () (dk-ineq! (list '< Q (msn-rp 1 c)) (list '= (msn-rp 1 c) 1)
                                                   (list 'IN Q 'RR) (list 'IN (msn-rp 1 c) 'RR))))
      ;; b = b^(s + c) = P Q
      (fact 'rpow-star-add 'b 's c)
      (dk-have! (list '= '(+ s (- 1 s)) 1) (lambda () (crs)))
      (dk-rewrite-h! (list '= (msn-rp 'b '(+ s (- 1 s))) (list '* P Q)) '(+ s (- 1 s)) 1)
      (dk-rewrite-h! (list '= (msn-rp 'b 1) (list '* P Q)) (msn-rp 'b 1) 'b)
      ;; P (1 - Q) > 0, so P Q < P
      (let ((w (msn-name! (list '- 1 Q))))
        (dk-have! (list '< 0 w) (lambda () (subst (list '= w (list '- 1 Q))) (dk-ineq! (list '< Q 1) (list 'IN Q 'RR))))
        (fact 'rr-mul-pos P w)
        (msn-rr! (list '* P w)) (msn-rr! (list '* P Q))
        (dk-have! (list '= (list '* P w) (list '- P (list '* P Q))) (lambda () (subst (list '= w (list '- 1 Q))) (crs)))
        (dk-ineq! (list '= 'b (list '* P Q)) (list '< 0 (list '* P w)) (list '= (list '* P w) (list '- P (list '* P Q)))
                  (list 'IN P 'RR) (list 'IN (list '* P Q) 'RR) (list 'IN (list '* P w) 'RR) '(IN b RR))))))
(qed 'rpow-ge-self-lt1)
(topic! 'rpow-ge-self-lt1 'analysis)

;;; 0 < t < 1: (1 + t)^s <= 1 + t^s
(sp (make-wff '(FORALL t (IMPLIES (IN t RR) (FORALL s (IMPLIES (IN s RR)
     (IMPLIES (< 0 t) (IMPLIES (< t 1) (IMPLIES (< 0 s) (IMPLIES (<= s 1)
       (<= (RPOW-STAR (+ 1 t) s) (+ 1 (RPOW-STAR t s)))))))))))))
(dk-peel!)
(fact 'rr-one-in)
(msn-rr! '(+ 1 t))
(dk-have! '(< 1 (+ 1 t)) (lambda () (dk-ineq! '(< 0 t) '(IN t RR))))
(dk-have! '(< 0 (+ 1 t)) (lambda () (dk-ineq! '(< 0 t) '(IN t RR))))
(msn-rpow! '(+ 1 t) 's)
(msn-rpow! 't 's)
(fact 'rpow-le-self-gt1 '(+ 1 t) 's)
(fact 'rpow-ge-self-lt1 't 's)
(dk-ineq! '(<= (RPOW-STAR (+ 1 t) s) (+ 1 t)) '(<= t (RPOW-STAR t s))
          '(IN (RPOW-STAR (+ 1 t) s) RR) '(IN (RPOW-STAR t s) RR) '(IN t RR))
(qed 'rpow-one-plus-small)
(topic! 'rpow-one-plus-small 'analysis)

;;; x > 0, v > 0, (1 + v)^s <= 1 + v^s  ==>  (x (1 + v))^s <= x^s + (x v)^s
(sp (make-wff '(FORALL x (IMPLIES (IN x RR) (FORALL v (IMPLIES (IN v RR) (FORALL s (IMPLIES (IN s RR)
     (IMPLIES (< 0 x) (IMPLIES (< 0 v)
       (IMPLIES (<= (RPOW-STAR (+ 1 v) s) (+ 1 (RPOW-STAR v s)))
         (<= (RPOW-STAR (* x (+ 1 v)) s) (+ (RPOW-STAR x s) (RPOW-STAR (* x v) s))))))))))))))
(dk-peel!)
(fact 'rr-one-in)
(msn-rr! '(+ 1 v))
(msn-rr! '(* x v))
(dk-have! '(< 0 (+ 1 v)) (lambda () (dk-ineq! '(< 0 v) '(IN v RR))))
(fact 'rr-mul-pos 'x 'v)
(define msn-P (msn-rpow! 'x 's))
(define msn-Q (msn-rpow! '(+ 1 v) 's))
(define msn-V (msn-rpow! 'v 's))
(msn-rpow! '(* x v) 's)
(msn-rr! '(* x (+ 1 v)))
(fact 'rr-mul-pos 'x '(+ 1 v))
(msn-rpow! '(* x (+ 1 v)) 's)
(fact 'rpow-star-mul-base 'x '(+ 1 v) 's)
(fact 'rpow-star-mul-base 'x 'v 's)
(define msn-y2 (msn-name! (list '+ 1 msn-V)))
(dk-have! (list '<= msn-Q msn-y2) (lambda () (subst (list '= msn-y2 (list '+ 1 msn-V))) (ass)))
(msn-mul-le! msn-P msn-Q msn-y2)
(dk-have! (list '= (list '* msn-y2 msn-P) (list '+ msn-P (list '* msn-P msn-V)))
  (lambda () (subst (list '= msn-y2 (list '+ 1 msn-V))) (crs)))
(msn-rr! (list '* msn-P msn-Q)) (msn-rr! (list '* msn-P msn-V))
(dk-have! (list '= (list '* msn-Q msn-P) (list '* msn-P msn-Q)) (lambda () (crs)))
(dk-ineq! (list '= (msn-rp '(* x (+ 1 v)) 's) (list '* msn-P msn-Q))
          (list '= (msn-rp '(* x v) 's) (list '* msn-P msn-V))
          (list '<= (list '* msn-Q msn-P) (list '* msn-y2 msn-P))
          (list '= (list '* msn-y2 msn-P) (list '+ msn-P (list '* msn-P msn-V)))
          (list '= (list '* msn-Q msn-P) (list '* msn-P msn-Q))
          (list 'IN (msn-rp '(* x (+ 1 v)) 's) 'RR) (list 'IN (msn-rp '(* x v) 's) 'RR)
          (list 'IN (list '* msn-P msn-Q) 'RR) (list 'IN (list '* msn-P msn-V) 'RR)
          (list 'IN (list '* msn-Q msn-P) 'RR) (list 'IN (list '* msn-y2 msn-P) 'RR) (list 'IN msn-P 'RR))
(qed 'rpow-factor-bound)
(topic! 'rpow-factor-bound 'analysis)

;;; t > 0: (1 + t)^s <= 1 + t^s
(sp (make-wff '(FORALL t (IMPLIES (IN t RR) (FORALL s (IMPLIES (IN s RR)
     (IMPLIES (< 0 t) (IMPLIES (< 0 s) (IMPLIES (<= s 1)
       (<= (RPOW-STAR (+ 1 t) s) (+ 1 (RPOW-STAR t s))))))))))))
(dk-peel!)
(fact 'rr-one-in)
(msn-rr! '(+ 1 t))
(dk-have! '(< 0 (+ 1 t)) (lambda () (dk-ineq! '(< 0 t) '(IN t RR))))
(msn-rpow! '(+ 1 t) 's)
(msn-rpow! 't 's)
(use-cases (dk-fact! 'rr-lt-trichotomy 't 1)
  (lambda () (dk-close-if! (lambda () (fact 'rpow-one-plus-small 't 's)) ass))
  (lambda ()
    (fact 'rpow-one-base 's)
    (dk-have! '(< 0 1) (lambda () (arith)))
    (msn-rpow! 1 's)
    (subst '(= t 1))
    (dk-have! '(< 1 (+ 1 1)) (lambda () (arith)))
    (msn-rr! '(+ 1 1))
    (dk-have! '(< 0 (+ 1 1)) (lambda () (arith)))
    (msn-rpow! '(+ 1 1) 's)
    (fact 'rpow-le-self-gt1 '(+ 1 1) 's)
    (dk-ineq! '(<= (RPOW-STAR (+ 1 1) s) (+ 1 1)) '(= (RPOW-STAR 1 s) 1)
              '(IN (RPOW-STAR (+ 1 1) s) RR) '(IN (RPOW-STAR 1 s) RR)))
  (lambda ()
    (dk-have! '(NOT (= t 0)) (lambda () (di) (dk-absurd! '(= t 0) '(< 0 t) '(IN t RR))))
    (msn-and! '(IN t RR) '(NOT (= t 0)))
    (fact 'rr-recip-closed 't)
    (fact 'rr-recip-pos 't)
    (fact 'rr-recip-inverse 't)
    (let ((u (dk-name! '(recip t) 'RR)))
      (dk-have! (list '= (list '* 't u) 1) (lambda () (subst (list '= u '(recip t))) (ass)))
      (dk-have! (list '< 0 u) (lambda () (subst (list '= u '(recip t))) (ass)))
      ;; u < 1: u (t - 1) > 0 and u (t - 1) = 1 - u
      (let ((w (msn-name! '(- t 1))))
        (dk-have! (list '< 0 w) (lambda () (subst (list '= w '(- t 1))) (dk-ineq! '(< 1 t) '(IN t RR))))
        (fact 'rr-mul-pos u w)
        (msn-rr! (list '* u w))
        (dk-have! (list '= (list '* u w) (list '- 1 u))
          (lambda () (subst (list '= w '(- t 1)))
                     (dk-have! (list '= (list '* u '(- t 1)) (list '- (list '* 't u) u)) (lambda () (crs)))
                     (subst (list '= (list '* u '(- t 1)) (list '- (list '* 't u) u)))
                     (subst (list '= (list '* 't u) 1))
                     (crs)))
        (dk-have! (list '< u 1) (lambda () (dk-ineq! (list '< 0 (list '* u w)) (list '= (list '* u w) (list '- 1 u))
                                                     (list 'IN (list '* u w) 'RR) (list 'IN u 'RR)))))
      (fact 'rpow-one-plus-small u 's)
      (fact 'rpow-factor-bound 't u 's)
      ;; t (1 + u) = 1 + t and t u = 1
      (dk-have! (list '= (list '* 't (list '+ 1 u)) '(+ 1 t))
        (lambda () (dk-have! (list '= (list '* 't (list '+ 1 u)) (list '+ 't (list '* 't u))) (lambda () (crs)))
                   (subst (list '= (list '* 't (list '+ 1 u)) (list '+ 't (list '* 't u))))
                   (subst (list '= (list '* 't u) 1))
                   (crs)))
      (let ((fb (dk-pick (lambda (h) (and (eq? (msn-head h) '<=) (dk-contains? h (list '* 't (list '+ 1 u))))) "the factored bound")))
        (dk-rewrite-h! fb (list '* 't (list '+ 1 u)) '(+ 1 t)))
      (let ((fb2 (dk-pick (lambda (h) (and (eq? (msn-head h) '<=) (dk-contains? h (list '* 't u)))) "the factored bound")))
        (dk-rewrite-h! fb2 (list '* 't u) 1))
      (fact 'rpow-one-base 's)
      (if (not (dk-asm? '(< 0 1))) (dk-have! '(< 0 1) (lambda () (arith))))
      (msn-rpow! 1 's)
      (dk-ineq! (list '<= '(RPOW-STAR (+ 1 t) s) (list '+ '(RPOW-STAR t s) '(RPOW-STAR 1 s)))
                '(= (RPOW-STAR 1 s) 1)
                '(IN (RPOW-STAR (+ 1 t) s) RR) '(IN (RPOW-STAR t s) RR) '(IN (RPOW-STAR 1 s) RR)))))
(qed 'rpow-one-plus)
(topic! 'rpow-one-plus 'analysis)

;;; Lemma A.10: (a + b)^s <= a^s + b^s for 0 < s <= 1, a, b >= 0
(sp (make-wff '(FORALL a (IMPLIES (IN a RR) (FORALL b (IMPLIES (IN b RR) (FORALL s (IMPLIES (IN s RR)
     (IMPLIES (< 0 s) (IMPLIES (<= s 1) (IMPLIES (<= 0 a) (IMPLIES (<= 0 b)
       (<= (RPOW-STAR (+ a b) s) (+ (RPOW-STAR a s) (RPOW-STAR b s)))))))))))))))
(dk-peel!)
(fact 'rr-zero-in)
(dk-have! '(<= 0 s) (lambda () (dk-ineq! '(< 0 s) '(IN s RR))))
(msn-rr! '(+ a b))
(define (msn-nn-rpow! x)               ; x >= 0: x^s in RR, >= 0
  (dk-close-if! (lambda () (fact 'rpow-star-nonneg-in-rr x 's)) (lambda () #t))
  (dk-close-if! (lambda () (fact 'rpow-star-nonneg-nonneg x 's)) (lambda () #t)))
(dk-have! '(<= 0 (+ a b)) (lambda () (dk-ineq! '(<= 0 a) '(<= 0 b) '(IN a RR) '(IN b RR))))
(msn-nn-rpow! 'a) (msn-nn-rpow! 'b) (msn-nn-rpow! '(+ a b))
(fact 'rpow-star-zero-base 's)
(use-em '(= a 0)
  (lambda ()
    (subst '(= a 0))
    (dk-have! '(= (+ 0 b) b) (lambda () (crs)))
    (subst '(= (+ 0 b) b))
    (subst '(= (RPOW-STAR 0 s) 0))
    (dk-ineq! '(IN (RPOW-STAR b s) RR)))
  (lambda ()
    (use-em '(= b 0)
      (lambda ()
        (subst '(= b 0))
        (dk-have! '(= (+ a 0) a) (lambda () (crs)))
        (subst '(= (+ a 0) a))
        (subst '(= (RPOW-STAR 0 s) 0))
        (dk-ineq! '(IN (RPOW-STAR a s) RR)))
      (lambda ()
        (dk-have! '(< 0 a)
          (lambda ()
            (use-cases (dk-fact! 'rr-lt-trichotomy 0 'a)
              (lambda () (ass))
              (lambda () (dk-have! '(= a 0) (lambda () (subst '(= a 0)) (rfl)))
                         (if (dk-only! '(= a 0) '(NOT (= a 0))) (prop)))
              (lambda () (dk-absurd! '(< a 0) '(<= 0 a) '(IN a RR))))))
        (dk-have! '(< 0 b)
          (lambda ()
            (use-cases (dk-fact! 'rr-lt-trichotomy 0 'b)
              (lambda () (ass))
              (lambda () (dk-have! '(= b 0) (lambda () (subst '(= b 0)) (rfl)))
                         (if (dk-only! '(= b 0) '(NOT (= b 0))) (prop)))
              (lambda () (dk-absurd! '(< b 0) '(<= 0 b) '(IN b RR))))))
        (msn-and! '(IN a RR) '(NOT (= a 0)))
        (fact 'rr-recip-closed 'a)
        (fact 'rr-recip-pos 'a)
        (fact 'rr-recip-inverse 'a)
        (msn-and! '(IN b RR) '(IN (recip a) RR))
        (fact 'rr-mul-closed 'b '(recip a))
        (let ((tq (dk-name! '(* b (recip a)) 'RR)))
          (dk-have! (list '= (list '* 'a tq) 'b)
            (lambda () (subst (list '= tq '(* b (recip a))))
                       (dk-have! '(= (* a (* b (recip a))) (* b (* a (recip a)))) (lambda () (dk-crs-opaque!)))
                       (subst '(= (* a (* b (recip a))) (* b (* a (recip a)))))
                       (subst '(= (* a (recip a)) 1))
                       (crs)))
          (dk-have! (list '< 0 tq) (lambda () (subst (list '= tq '(* b (recip a)))) (fact 'rr-mul-pos 'b '(recip a)) (ass)))
          (fact 'rpow-one-plus tq 's)
          (fact 'rpow-factor-bound 'a tq 's)
          (dk-have! (list '= (list '* 'a (list '+ 1 tq)) '(+ a b))
            (lambda () (dk-have! (list '= (list '* 'a (list '+ 1 tq)) (list '+ 'a (list '* 'a tq))) (lambda () (crs)))
                       (subst (list '= (list '* 'a (list '+ 1 tq)) (list '+ 'a (list '* 'a tq))))
                       (subst (list '= (list '* 'a tq) 'b))
                       (crs)))
          (let ((fb (dk-pick (lambda (h) (and (eq? (msn-head h) '<=) (dk-contains? h (list '* 'a (list '+ 1 tq))))) "factored")))
            (dk-rewrite-h! fb (list '* 'a (list '+ 1 tq)) '(+ a b)))
          (let ((fb2 (dk-pick (lambda (h) (and (eq? (msn-head h) '<=) (dk-contains? h (list '* 'a tq)))) "factored")))
            (dk-rewrite-h! fb2 (list '* 'a tq) 'b))
          (ass))))))
(qed 'rpow-subadditive)
(topic! 'rpow-subadditive 'analysis)
(alias! 'rpow-subadditive "for 0 < s <= 1 and a, b >= 0, (a + b)^s <= a^s + b^s")

;;; =====================================================================
;;; Proposition A.9: the snowflake d^e of a metric is a metric (0 < e <= 1)
;;; =====================================================================
;;; monotone in the base: 0 <= x <= y, 0 < e  ==>  x^e <= y^e
(sp (make-wff '(FORALL x (IMPLIES (IN x RR) (FORALL y (IMPLIES (IN y RR) (FORALL e (IMPLIES (IN e RR)
     (IMPLIES (<= 0 x) (IMPLIES (<= x y) (IMPLIES (< 0 e) (<= (RPOW-STAR x e) (RPOW-STAR y e)))))))))))))
(dk-peel!)
(fact 'rr-zero-in)
(dk-have! '(<= 0 e) (lambda () (dk-ineq! '(< 0 e) '(IN e RR))))
(dk-have! '(<= 0 y) (lambda () (dk-ineq! '(<= 0 x) '(<= x y) '(IN x RR) '(IN y RR))))
(define (msn-nn2! z x2)
  (dk-close-if! (lambda () (fact 'rpow-star-nonneg-in-rr z x2)) (lambda () #t))
  (dk-close-if! (lambda () (fact 'rpow-star-nonneg-nonneg z x2)) (lambda () #t)))
(msn-nn2! 'x 'e) (msn-nn2! 'y 'e)
(use-cases (dk-fact! 'rr-lt-trichotomy 0 'x)
  (lambda ()
    (use-cases (dk-fact! 'rr-lt-trichotomy 'x 'y)
      (lambda () (fact 'rpow-star-mono-base 'x 'y 'e) (dk-ineq! '(< (RPOW-STAR x e) (RPOW-STAR y e)) '(IN (RPOW-STAR x e) RR) '(IN (RPOW-STAR y e) RR)))
      (lambda () (subst '(= x y)) (dk-ineq! '(IN (RPOW-STAR y e) RR)))
      (lambda () (dk-absurd! '(< y x) '(<= x y) '(IN x RR) '(IN y RR)))))
  (lambda ()
    (subst '(= x 0))
    (fact 'rpow-star-zero-base 'e)
    (subst '(= (RPOW-STAR 0 e) 0))
    (ass))
  (lambda () (dk-absurd! '(< x 0) '(<= 0 x) '(IN x RR))))
(qed 'rpow-mono-le)
(topic! 'rpow-mono-le 'analysis)

(define msn-SF '(SNOWFLAKE s e))
(define msn-SL '(VNB-LAMBDA (LIST snfu_ snfv_) (CARTESIAN (PTS s) (PTS s)) (RPOW-STAR ((DIST s) snfu_ snfv_) e)))
(define msn-sf-hyps '((IS-METRIC-SPACE s) (IN e RR) (<= 0 e)))
(define (msn-imps hs body) (if (null? hs) body (list 'IMPLIES (car hs) (msn-imps (cdr hs) body))))
(define (msn-ds a b) (list '(DIST s) a b))
(define (msn-dpow! a b)                ; a, b in pts s: d(a,b) in RR, >= 0, d^e in RR, >= 0
  (fact 'metric-dist-real 's a b)
  (fact 'metric-pos 's a b)
  (msn-nn2! (msn-ds a b) 'e))

(sp (make-wff (list 'FORALL 's (list 'FORALL 'e (msn-imps msn-sf-hyps
     (list 'IN msn-SL '(FUN (CARTESIAN (PTS s) (PTS s)) RR)))))))
(dk-peel!)
(dk-project! '(IN (PTS s) SET) 'is-metric-space '(IS-METRIC-SPACE s))
(for-each
 (lambda (kn)
   (if (not (sequent-node-grounded? kn))
       (begin
         (dk-focus! kn)
         (if (and (eq? (msn-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
             (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))
             (begin
               (dk-peel!)
               (let* ((d (cadr (cadr (dk-goal)))) (u (cadr d)) (v (caddr d)))
                 (msn-dpow! u v)
                 (ass)))))))
 (dk-opened (lambda () (lam-t))))
(qed 'snowflake-lam-type)
(topic! 'snowflake-lam-type 'plumbing)

(define (msn-sf-readoff! name acc val)
  (sp (make-wff (list 'FORALL 's (list 'FORALL 'e (msn-imps msn-sf-hyps (list '== (list acc msn-SF) val))))))
  (dk-peel!)
  (dk-project! '(IN (PTS s) SET) 'is-metric-space '(IS-METRIC-SPACE s))
  (fact 'snowflake-lam-type 's 'e)
  (mac 'SNOWFLAKE)
  (slot acc)
  (nth-r)
  (if (memq acc '(PTS DIST)) (vnb-guard (lambda () (slot acc))))
  (qrfl)
  (qed name)
  (topic! name 'plumbing))
(msn-sf-readoff! 'snowflake-pts 'PTS '(PTS s))
(msn-sf-readoff! 'snowflake-dist-fun 'DIST msn-SL)

(sp (make-wff (list 'FORALL 's (list 'FORALL 'e (msn-imps msn-sf-hyps
     '(FORALL u (IMPLIES (IN u (PTS s)) (FORALL v (IMPLIES (IN v (PTS s))
        (== ((DIST (SNOWFLAKE s e)) u v) (RPOW-STAR ((DIST s) u v) e)))))))))))
(dk-peel!)
(fact 'snowflake-dist-fun 's 'e)
(subst (list '== '(DIST (SNOWFLAKE s e)) msn-SL))
(dk-lam-b!)
(qrfl)
(qed 'snowflake-dist)
(topic! 'snowflake-dist 'analysis)

(define (msn-D a b) (list '(DIST (SNOWFLAKE s e)) a b))
(define (msn-P a b) (msn-rp (msn-ds a b) 'e))
(define (msn-sfro! a b)                ; D(a,b) and d(a,b)^e real, equal
  (msn-dpow! a b)
  (if (not (dk-asm? (list '== (msn-D a b) (msn-P a b)))) (fact 'snowflake-dist 's 'e a b))
  (if (not (dk-asm? (list 'IN (msn-D a b) 'RR)))
      (dk-have! (list 'IN (msn-D a b) 'RR) (lambda () (subst (list '== (msn-D a b) (msn-P a b))) (ass))))
  (if (not (dk-asm? (list '= (msn-D a b) (msn-P a b))))
      (dk-have! (list '= (msn-D a b) (msn-P a b)) (lambda () (subst (list '== (msn-D a b) (msn-P a b))) (rfl)))))
(define (msn-law!)
  (let ((g (dk-goal)))
    (cond
     ;; D(u, u) = 0
     ((and (eq? (car g) '=) (equal? (caddr g) 0))
      (let ((u (cadr (cadr g))))
        (msn-sfro! u u)
        (subst (list '= (msn-D u u) (msn-P u u)))
        (fact 'metric-self-zero 's u)
        (subst (list '= (msn-ds u u) 0))
        (fact 'rpow-star-zero-base 'e)
        (ass)))
     ;; 0 <= D(u, v)
     ((and (eq? (car g) '<=) (equal? (cadr g) 0))
      (let* ((r (caddr g)) (u (cadr r)) (v (caddr r)))
        (msn-sfro! u v)
        (subst (list '= (msn-D u v) (msn-P u v)))
        (ass)))
     ;; D(u, v) = 0 => u = v
     ((and (eq? (car g) '=) (symbol? (cadr g)) (symbol? (caddr g)))
      (let* ((u (cadr g)) (v (caddr g)) (d (msn-ds u v)))
        (msn-sfro! u v)
        (dk-rewrite-h! (list '= (msn-D u v) 0) (msn-D u v) (msn-P u v))
        (dk-have! (list '= d 0)
          (lambda ()
            (use-cases (dk-fact! 'rr-lt-trichotomy 0 d)
              (lambda ()
                (fact 'rpow-star-pos d 'e)
                (dk-absurd! (list '< 0 (msn-P u v)) (list '= (msn-P u v) 0) (list 'IN (msn-P u v) 'RR)))
              (lambda () (dk-have! (list '= d 0) (lambda () (subst (list '= d 0)) (fact 'rr-zero-in) (rfl))) (ass))
              (lambda () (dk-absurd! (list '< d 0) (list '<= 0 d) (list 'IN d 'RR))))))
        (dk-close-if! (lambda () (fact 'metric-zero-eq 's u v)) ass)))
     ;; D(u, v) = D(v, u)
     ((eq? (car g) '=)
      (let* ((u (cadr (cadr g))) (v (caddr (cadr g))))
        (msn-sfro! u v) (msn-sfro! v u)
        (subst (list '= (msn-D u v) (msn-P u v)))
        (subst (list '= (msn-D v u) (msn-P v u)))
        (fact 'metric-sym 's u v)
        (subst (list '= (msn-ds u v) (msn-ds v u)))
        (rfl)))
     ;; D(u, w) <= D(u, v) + D(v, w)
     ((eq? (car g) '<=)
      (let* ((lhs (cadr g)) (rhs (caddr g))
             (u (cadr lhs)) (w (caddr lhs)) (v (caddr (cadr rhs)))
             (duw (msn-ds u w)) (duv (msn-ds u v)) (dvw (msn-ds v w)) (sm (list '+ duv dvw)))
        (msn-sfro! u w) (msn-sfro! u v) (msn-sfro! v w)
        (fact 'metric-triangle 's u v w)
        (msn-rr! sm)
        (dk-have! (list '<= 0 sm) (lambda () (dk-ineq! (list '<= 0 duv) (list '<= 0 dvw) (list 'IN duv 'RR) (list 'IN dvw 'RR))))
        (msn-nn2! sm 'e)
        (fact 'rpow-mono-le duw sm 'e)
        (fact 'rpow-subadditive duv dvw 'e)
        (dk-ineq! (list '<= (msn-P u w) (msn-rp sm 'e)) (list '<= (msn-rp sm 'e) (list '+ (msn-P u v) (msn-P v w)))
                  (list '= (msn-D u w) (msn-P u w)) (list '= (msn-D u v) (msn-P u v)) (list '= (msn-D v w) (msn-P v w))
                  (list 'IN (msn-P u w) 'RR) (list 'IN (msn-P u v) 'RR) (list 'IN (msn-P v w) 'RR) (list 'IN (msn-rp sm 'e) 'RR)
                  (list 'IN (msn-D u w) 'RR) (list 'IN (msn-D u v) 'RR) (list 'IN (msn-D v w) 'RR))))
     (#t (error "msn-law!: unexpected leaf" g)))))

(sp (make-wff '(FORALL s (FORALL e (IMPLIES (IS-METRIC-SPACE s) (IMPLIES (IN e RR)
     (IMPLIES (< 0 e) (IMPLIES (<= e 1) (IS-METRIC-SPACE (SNOWFLAKE s e))))))))))
(dk-peel!)
(dk-have! '(<= 0 e) (lambda () (dk-ineq! '(< 0 e) '(IN e RR))))
(dk-project! '(IN (PTS s) SET) 'is-metric-space '(IS-METRIC-SPACE s))
(fact 'snowflake-lam-type 's 'e)
(fact 'snowflake-pts 's 'e)
(fact 'snowflake-dist-fun 's 'e)
(dk-have! (list 'IN (list 'DIST msn-SF) '(FUN (CARTESIAN (PTS s) (PTS s)) RR))
  (lambda () (subst (list '== (list 'DIST msn-SF) msn-SL)) (ass)))
(mac 'IS-METRIC-SPACE)
(subst (list '== (list 'PTS msn-SF) '(PTS s)))
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
      ((and (eq? (msn-head g) '=) (dk-head-is? (cadr g) 'LENGTH))
       (mac 'SNOWFLAKE) (len-r) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (vnb-guard (lambda () (arith)))))
      ((eq? (msn-head g) 'IS-METRIC)
       (mac 'is-metric)
       (let loop ((fuel 80))
         (let ((n (find-first (lambda (n) (let ((gg (dk-goal-of n))) (and (pair? gg) (memq (car gg) '(FORALL IMPLIES AND)))))
                              (dk-open-leaves))))
           (if (and n (> fuel 0)) (begin (dk-focus! n) (di) (loop (- fuel 1))))))
       (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (msn-law!)))) (dk-open-leaves)))
      (#t (ass))))))
(qed 'snowflake-is-metric-space)
(topic! 'snowflake-is-metric-space 'analysis)
(alias! 'snowflake-is-metric-space "for 0 < e <= 1 the snowflake d^e of a metric d is a metric")
