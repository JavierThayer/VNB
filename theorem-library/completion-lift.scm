;;; ---- a Lipschitz t preserves Cauchy sequences and the null-distance relation
(define g4c-lip '(FORALL g4u_ (IMPLIES (IN g4u_ (PTS mq)) (FORALL g4w_ (IMPLIES (IN g4w_ (PTS mq))
                   (<= ((DIST mq) (tq g4u_) (tq g4w_)) (* bq ((DIST mq) g4u_ g4w_))))))))
(define (g4c-lip-st concl)
  (make-wff (list 'FORALL 'mq (list 'FORALL 'tq (list 'FORALL 'bq
    (list 'IMPLIES '(IS-METRIC-SPACE mq) (list 'IMPLIES '(IN tq (FUN (PTS mq) (PTS mq)))
      (list 'IMPLIES '(IN bq RR) (list 'IMPLIES '(<= 0 bq) (list 'IMPLIES g4c-lip concl))))))))))
(define (g4c-pt! t f)           ; f(t) in PTS mq, f in FUN(NN, PTS mq) or tq
  (if (eq? f 'tq)
      (dk-cite! 'fun-apply-type-c 'tq '(PTS mq) '(PTS mq) t)
      (dk-cite! 'fun-apply-type-c f 'NN '(PTS mq) t)))
;;; d(t f(m), t f(n)) <= e from d(f m, f n) <= c and c bq <= e, with the Lipschitz bound
(define (g4c-lip-step! f m1 n1 c e)
  (let* ((fm (list f m1)) (fn (list f n1)) (dd (list '(DIST mq) fm fn))
         (td (list '(DIST mq) (list 'tq fm) (list 'tq fn))))
    (g4c-pt! m1 f) (g4c-pt! n1 f) (g4c-pt! fm 'tq) (g4c-pt! fn 'tq)
    (g4c-cite*! 'metric-dist-real 'mq fm fn)
    (g4c-cite*! 'metric-dist-real 'mq (list 'tq fm) (list 'tq fn))
    (dk-apply! g4c-lip fm fn)
    (dk-real! c) (dk-real! (list '* 'bq dd))
    (g4c-cite*! 'rr-mul-le-right dd c 'bq)
    (g4c-have! (list '= (list '* dd 'bq) (list '* 'bq dd)) (lambda () (crs)))
    (dk-rewrite-h! (list '<= (list '* dd 'bq) (list '* c 'bq)) (list '* dd 'bq) (list '* 'bq dd))
    (dk-le-trans! td (list '* 'bq dd) (list '* c 'bq))
    (dk-le-trans! td (list '* c 'bq) e)))

(sp (g4c-lip-st '(FORALL f (IMPLIES (IS-CAUCHY-SEQ mq f) (IS-CAUCHY-SEQ mq (SEQ-MAP tq f))))))
(dk-peel!)
(let* ((ci (dk-cite! 'is-cauchy-seq 'mq 'f))
       (fe (caddr (caddr (caddr ci))))
       (sm '(SEQ-MAP tq f)))
  (dk-iff-fwd! ci)
  (let* ((cg (dk-cite! 'is-cauchy-seq 'mq sm)) (rg (caddr cg)))
    (mac 'is-cauchy-seq)
    ((lambda ()
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond ((dk-asm? g) (dk-ass!))
                    ((dk-head-is? g 'IN)
                     (g4c-cite*! 'seq-map-type '(PTS mq) '(PTS mq) 'tq 'f) (dk-ass!))
                    (#t
                     (let* ((new (dk-landed (lambda () (dk-peel!))))
                            (pe (car (filter (lambda (a) (dk-head-is? a 'POS-RR)) new)))
                            (e (cadr pe)))
                       (dk-cite! 'rr-pos-rr-in-rr e)
                       (let* ((c (dk-skolem! (g4c-cite*! 'rr-small-factor-real e 'bq)))
                              (cr (dk-cite! 'rr-pos-rr-in-rr c))
                              (nb (dk-skolem! (dk-apply! fe c))))
                         (ew nb)
                         (dk-conj-close!
                           (lambda ()
                             (if (dk-asm? (dk-goal)) (dk-ass!)
                                 (begin
                                   (dk-peel!)
                                   (let* ((g2 (dk-goal)) (m1 (cadr (cadr (cadr g2)))) (n1 (cadr (caddr (cadr g2)))))
                                     (g4c-have! (list 'AND (list '<= nb m1) (list '<= nb n1))
                                                (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                                     (subst (g4c-cite*! 'seq-map-at '(PTS mq) '(PTS mq) 'tq 'f m1))
                                     (subst (g4c-cite*! 'seq-map-at '(PTS mq) '(PTS mq) 'tq 'f n1))
                                     (dk-apply! (car (filter (lambda (a) (and (dk-head-is? a 'FORALL) (g4c-occurs? nb a))) (dk-asms))) m1 n1)
                                     (g4c-lip-step! 'f m1 n1 c e)
                                     (dk-ass!)))))))))))))))))
(g4c-qed! 'seq-map-cauchy)

(sp (g4c-lip-st '(FORALL f (FORALL g (IMPLIES (IN f (FUN NN (PTS mq))) (IMPLIES (IN g (FUN NN (PTS mq)))
  (IMPLIES (CSEQ-EQUIV mq f g) (CSEQ-EQUIV mq (SEQ-MAP tq f) (SEQ-MAP tq g)))))))))
