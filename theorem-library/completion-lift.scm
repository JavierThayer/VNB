(dk-split! (g4c-cite*! 'completion-lift-ok 'mq 'tq 'bq))
(mac 'COMPLETION-LIFT)
(dk-have! (list 'AND (list 'IN (g4c-F) (list 'FUN (list 'PTS g4c-S) (list 'QUOTIENT g4c-S))) (list 'RESPECTS g4c-S (g4c-F)))
  (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
(g4c-cite*! 'descend-in-fun g4c-S (list 'QUOTIENT g4c-S) (g4c-F))
(dk-ass!)
