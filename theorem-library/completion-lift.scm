;;; completion-lift.scm -- THE COMPLETION OF A LIPSCHITZ MAP, and its Hilbert-space laws.
;;; Agent BA-1117-GNS2, 2026-11-17.  Destination: theorem-library/completion-lift.scm.
;;; Library: operator-algebras.  Load window: after hilbert-completion (hc-setoid-eq, hc-vec,
;;; form-ms-*), rake-setoid2 (descend-computes, class-eq-iff, the CREL read-offs), the
;;; rr-limit-* laws, and structure-library/ba-gns2-vocab (SEQ-MAP, COMPLETION-LIFT).
;;;
;;; m a metric space, t : PTS m -> PTS m with d(t u, t w) <= b d(u, w).  COMPLETION-LIFT(m, t)
;;; sends the class of a Cauchy sequence f to the class of t o f.  This is the operator of the
;;; proof of Theorem 4.13 "extended by continuity" to the completion, built on representatives:
;;; every law on the completion is then a POINTWISE identity on the sequences.
;;;   seq-map-type, seq-map-at               t o f is a sequence, (t o f)(n) = t(f(n))
;;;   seq-map-cauchy                         t o f is Cauchy when f is
;;;   seq-map-equiv                          f ~ g  =>  t o f ~ t o g
;;;   completion-lift-ok                     f |-> [t o f] is a map on CSEQ(m) respecting ~
;;;   completion-lift-computes               lift(t)([f]) = [t o f]
;;;   completion-lift-type                   lift(t) maps the classes into the classes

(define (g4c-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (if (and (not (sequent-node-grounded? l))
                           (let ((g (dk-goal-of l))) (and (pair? g) (eq? (car g) '=) (equal? (cadr g) (caddr g)))))
                      (begin (dk-focus! l) (rfl))))
                (dk-open-leaves)))
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** completion-lift: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "completion-lift: unfinished" name))))
(define (g4c-close-eq!) (if (not (proof-done? *ps*)) (let ((g (dk-goal))) (if (and (eq? (car g) '=) (equal? (cadr g) (caddr g))) (rfl)))))
(define (g4c-cite*! . args)
  (let loop ((r (apply dk-cite! args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (loop (if (dk-asm? (caddr r)) (caddr r) (if (dk-asm? (cadr r))
                  (dk-landed-1 (lambda () (detach! r)))
                  (detach-with! r (lambda () (dk-conj-close! (lambda () (dk-ass!))))))))
        r)))
(define (g4c-occurs? x t) (or (equal? x t) (and (pair? t) (or (g4c-occurs? x (car t)) (g4c-occurs? x (cdr t))))))
(define (g4c-have! f thunk) (if (not (dk-asm? f)) (dk-have! f thunk)) f)
(define (g4c-iff! iff from)
  (let ((other (if (alpha-equiv? (cadr iff) from) (caddr iff) (cadr iff))))
    (if (not (dk-asm? other)) (dk-have! other (lambda () (keep iff from) (prop))))
    other))

