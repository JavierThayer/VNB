;;; ==== THE HILBERT COMPLETION ON CLASSES OF CAUCHY SEQUENCES ====
;;; HC = HILBERT-COMPLETION(md, fq) is FORM-QUOTIENT(CSEQ-MODULE, LIMIT-FORM), whose setoid is
;;; CAUCHY-SETOID(FORM-MS md fq) (hc-setoid-eq): its operations read on the classes [f].
(define g4c-R '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define (g4c-hst body)
  (make-wff (list 'FORALL 'md (list 'FORALL 'fq (list 'IMPLIES '(IS-MODULE md)
    (list 'IMPLIES (list '= '(SCAL md) g4c-R) (list 'IMPLIES '(IS-INNER-PRODUCT-FORM md fq) body)))))))
(define g4c-HC '(HILBERT-COMPLETION md fq))
(define g4c-M '(FORM-MS md fq))
(define g4c-HS (list 'CAUCHY-SETOID g4c-M))
(define g4c-CM '(CSEQ-MODULE md fq))
(define g4c-LF '(LIMIT-FORM md fq))
(define g4c-N (list 'FORM-NULL g4c-CM g4c-LF))
(define g4c-Sq (list 'QMOD-SETOID g4c-CM g4c-N))
(define g4c-CS (list 'CSEQ g4c-M))
(define (g4c-hcl f) (list 'CLASS g4c-HS f))
(define (g4c-hsetup!)
  (dk-cite! 'form-ms-is-metric-space 'md 'fq)
  (dk-cite! 'cauchy-setoid-is-setoid g4c-M)
  (dk-cite! 'rkt-cauchy-setoid-pts g4c-M)
  (dk-cite! 'hc-setoid-eq 'md 'fq)
  (dk-cite! 'cseq-module-is-module 'md 'fq)
  (dk-cite! 'limit-form-psd 'md 'fq)
  (dk-cite! 'hilbert-completion-is-cips 'md 'fq)
  (dk-cite! 'hc-vec 'md 'fq)
  (dk-cite! 'form-cseq-unfold 'md 'fq)
  (dk-cite! 'cseq-module-vec 'md 'fq)
  (dk-cite! 'form-ms-pts 'md 'fq)
  (dk-cite! 'ipf-form-psd 'md 'fq)
  (let ((sc (dk-cite! 'cseq-module-scal 'md 'fq)))
    (g4c-have! (list '= (list 'SCAL g4c-CM) g4c-R) (lambda () (subst sc) (dk-ass!))))
  (g4c-cite*! 'form-null-submodule g4c-CM g4c-LF))
(define (g4c-vcm! f)      ; f in CSEQ M in context: land f in FORM-CSEQ, f in VEC CM, f in PTS(HS)
  (g4c-have! (list 'IN f '(FORM-CSEQ md fq)) (lambda () (subst (list '= '(FORM-CSEQ md fq) g4c-CS)) (dk-ass!)))
  (g4c-have! (list 'IN f (list 'VEC g4c-CM)) (lambda () (subst (list '= (list 'VEC g4c-CM) '(FORM-CSEQ md fq))) (dk-ass!)))
  (g4c-have! (list 'IN f (list 'PTS g4c-HS)) (lambda () (subst (list '= (list 'PTS g4c-HS) g4c-CS)) (dk-ass!))))
(define (g4c-to-sq!) (if (g4c-occurs? g4c-HS (dk-goal)) (subst (list '= g4c-HS g4c-Sq))))

(sp (g4c-hst (list 'FORALL 'f (list 'IMPLIES (list 'IN 'f g4c-CS) (list 'FORALL 'g (list 'IMPLIES (list 'IN 'g g4c-CS)
  (list '= (list (list 'VADD g4c-HC) (g4c-hcl 'f) (g4c-hcl 'g)) (g4c-hcl '(SEQ-VADD md f g)))))))))
(dk-peel!)
(g4c-hsetup!)
(g4c-vcm! 'f) (g4c-vcm! 'g)
(subst (dk-cite! 'hc-vadd-form 'md 'fq))
(g4c-to-sq!)
(subst (g4c-cite*! 'qmod-vadd-computes g4c-CM g4c-N 'f 'g))
(subst (g4c-cite*! 'cseq-module-vadd-computes 'md 'fq 'f 'g))
(g4c-close-eq!)
(g4c-qed! 'hc-vadd-classes)

(sp (g4c-hst (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'f (list 'IMPLIES (list 'IN 'f g4c-CS)
  (list '= (list (list 'ACT g4c-HC) 'c (g4c-hcl 'f)) (g4c-hcl '(SEQ-ACT md c f)))))))))
(dk-peel!)
(g4c-hsetup!)
(g4c-vcm! 'f)
(g4c-have! (list 'IN 'c (list 'CARR (list 'SCAL g4c-CM)))
  (lambda () (subst (list '= (list 'SCAL g4c-CM) g4c-R)) (subst (dk-cite! 'sip-cc-ring-carr)) (dk-ass!)))
(subst (dk-cite! 'hc-act-form 'md 'fq))
(g4c-to-sq!)
(subst (g4c-cite*! 'qmod-act-computes g4c-CM g4c-N 'c 'f))
(subst (g4c-cite*! 'cseq-module-act-computes 'md 'fq 'c 'f))
(g4c-close-eq!)
(g4c-qed! 'hc-act-classes)

(sp (g4c-hst (list 'FORALL 'f (list 'IMPLIES (list 'IN 'f g4c-CS) (list 'FORALL 'g (list 'IMPLIES (list 'IN 'g g4c-CS)
  (list '= (list (list 'IP g4c-HC) (g4c-hcl 'f) (g4c-hcl 'g)) (list g4c-LF 'f 'g))))))))
(dk-peel!)
(g4c-hsetup!)
(g4c-vcm! 'f) (g4c-vcm! 'g)
(g4c-cite*! 'form-quotient-ip g4c-CM g4c-LF)
(mac 'HILBERT-COMPLETION)
(subst (list '= (list 'IP (list 'FORM-QUOTIENT g4c-CM g4c-LF)) (list 'FORM-QIP g4c-CM g4c-LF)))
(g4c-to-sq!)
(subst (g4c-cite*! 'form-qip-computes g4c-CM g4c-LF 'f 'g))
(g4c-close-eq!)
(g4c-qed! 'hc-ip-classes)

(sp (g4c-hst (list 'FORALL 'xx (list 'IMPLIES (list 'IN 'xx (list 'VEC g4c-HC))
  (list 'FORSOME 'f (list 'AND (list 'IN 'f g4c-CS) (list '= 'xx (g4c-hcl 'f))))))))
(dk-peel!)
(g4c-hsetup!)
(g4c-have! (list 'IN 'xx (list 'QUOTIENT g4c-HS)) (lambda () (subst (list '= (list 'QUOTIENT g4c-HS) (list 'VEC g4c-HC))) (dk-ass!)))
(let* ((ex (g4c-cite*! 'quotient-rep g4c-HS 'xx))
       (b (dk-skolem! ex)))
  (ew b)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (dk-ass!)
          (begin (subst (list '= g4c-CS (list 'PTS g4c-HS))) (dk-ass!))))))
(g4c-qed! 'hc-class-rep)

;;; ==== THE LIFT ON THE HILBERT COMPLETION: every law is a pointwise identity ====
(define g4c-PM (list 'PTS g4c-M))
(define (g4c-lipf t b)
  (list 'FORALL 'g4u_ (list 'IMPLIES (list 'IN 'g4u_ g4c-PM) (list 'FORALL 'g4w_ (list 'IMPLIES (list 'IN 'g4w_ g4c-PM)
    (list '<= (list (list 'DIST g4c-M) (list t 'g4u_) (list t 'g4w_)) (list '* b (list (list 'DIST g4c-M) 'g4u_ 'g4w_))))))))
(define (g4c-mhyps tbs body)
  (if (null? tbs) body
      (let ((t (car (car tbs))) (b (cadr (car tbs))))
        (list 'FORALL t (list 'FORALL b
          (list 'IMPLIES (list 'IN t (list 'FUN g4c-PM g4c-PM)) (list 'IMPLIES (list 'IN b 'RR)
            (list 'IMPLIES (list '<= 0 b) (list 'IMPLIES (g4c-lipf t b) (g4c-mhyps (cdr tbs) body))))))))))
(define (g4c-L t) (list 'COMPLETION-LIFT g4c-M t))
(define (g4c-sm t f) (list 'SEQ-MAP t f))
(define (g4c-in-cs! t)          ; (IN t (CSEQ M)) from IS-CAUCHY-SEQ(M, t)
  (g4c-have! (list 'IN t g4c-CS)
    (lambda ()
      (subst (dk-cite! 'rko2-cseq-unfold g4c-M))
      (in-sep! (lambda () (g4c-cite*! 'cauchy-seq-is-fun g4c-M t) (dk-ass!))
               (lambda () (dk-ass!))))))
(define (g4c-vecfun! f)         ; f in FUN(NN, PTS M) in context: land f in FUN(NN, VEC md)
  (g4c-have! (list 'IN f '(FUN NN (VEC md))) (lambda () (subst (list '= '(VEC md) g4c-PM)) (dk-ass!))))
(define (g4c-cs-facts! f)       ; f in CSEQ M in context
  (g4c-cite*! 'r7q-cseq-cauchy g4c-M f)
  (g4c-cite*! 'rko2-cseq-in-fun g4c-M f)
  (g4c-vecfun! f)
  (g4c-vcm! f))
;;; f in CSEQ M: t o f's facts; returns lift(t)([f]) = [t o f]
(define (g4c-lift! t b f)
  (g4c-cs-facts! f)
  (let ((sf (g4c-sm t f)))
    (g4c-cite*! 'seq-map-cauchy g4c-M t b f)
    (g4c-in-cs! sf)
    (g4c-cs-facts! sf)
    (g4c-cite*! 'completion-lift-computes g4c-M t b f)))
(define (g4c-rep! xx)
  (let* ((ex (g4c-cite*! 'hc-class-rep 'md 'fq xx))
         (f (dk-skolem! ex)))
    (subst (list '= xx (g4c-hcl f)))
    f))
(define (g4c-at! t f j) (subst (g4c-cite*! 'seq-map-at g4c-PM g4c-PM t f j)))
(define (g4c-fj! f j)           ; f(j) in VEC md and in PTS M
  (dk-cite! 'fun-apply-type-c f 'NN g4c-PM j)
  (g4c-have! (list 'IN (list f j) '(VEC md)) (lambda () (subst (list '= '(VEC md) g4c-PM)) (dk-ass!))))
(define (g4c-tj! t x)           ; t(x) in PTS M and VEC md, x in PTS M
  (dk-cite! 'fun-apply-type-c t g4c-PM g4c-PM x)
  (g4c-have! (list 'IN (list t x) '(VEC md)) (lambda () (subst (list '= '(VEC md) g4c-PM)) (dk-ass!))))
(define (g4c-ext! lhs rhs cod ptwise)
  (dk-fun-ext! lhs rhs 'NN cod (lambda () (dk-ass!)) (lambda () (dk-ass!)) ptwise))
(define (g4c-st1 tbs body) (g4c-hst (g4c-mhyps tbs body)))

;;; lift(t) E(u) = E(t u)
(define g4c-E '(HC-EMBED md fq))
(sp (g4c-st1 '((t1 b1)) (list 'FORALL 'u (list 'IMPLIES '(IN u (VEC md))
  (list '= (list (g4c-L 't1) (list g4c-E 'u)) (list g4c-E '(t1 u)))))))
(dk-peel!)
(g4c-hsetup!)
(let* ((es (list 'EMBED-SEQ g4c-M 'u)) (es2 (list 'EMBED-SEQ g4c-M '(t1 u))))
  (g4c-have! (list 'IN 'u g4c-PM) (lambda () (subst (list '= g4c-PM '(VEC md))) (dk-ass!)))
  (g4c-tj! 't1 'u)
  (mac 'HC-EMBED)
  (dk-lam-b!)
  (g4c-to-sq!)
  (subst (list '= g4c-Sq g4c-HS))
  (g4c-cite*! 'rkt-embed-seq-in-cseq g4c-M 'u)
  (g4c-cite*! 'rkt-embed-seq-in-cseq g4c-M '(t1 u))
  (g4c-cite*! 'rkt-embed-seq-in-fun g4c-M '(t1 u))
  (subst (g4c-lift! 't1 'b1 es))
  (g4c-cite*! 'seq-map-type g4c-PM g4c-PM 't1 es)
  (g4c-ext! (g4c-sm 't1 es) es2 g4c-PM
    (lambda (j)
      (g4c-at! 't1 es j)
      (mac 'EMBED-SEQ)
      (dk-lam-b!)
      (g4c-close-eq!)))
  (subst (list '= (g4c-sm 't1 es) es2))
  (g4c-close-eq!))
(g4c-qed! 'completion-lift-embed)

(define (g4c-ptw body)          ; forall v in PTS M. body(v)
  (list 'FORALL 'g4v_ (list 'IMPLIES (list 'IN 'g4v_ g4c-PM) (body 'g4v_))))
(define (g4c-ptw2 body)
  (list 'FORALL 'g4v_ (list 'IMPLIES (list 'IN 'g4v_ g4c-PM)
    (list 'FORALL 'g4z_ (list 'IMPLIES (list 'IN 'g4z_ g4c-PM) (body 'g4v_ 'g4z_))))))
(define (g4c-allx body)
  (list 'FORALL 'xx (list 'IMPLIES (list 'IN 'xx (list 'VEC g4c-HC)) body)))
(define (g4c-hyp-of pred) (car (filter pred (dk-asms))))
(define (g4c-ptw-hyp t)         ; the pointwise hypothesis whose body mentions t first
  (g4c-hyp-of (lambda (a) (and (dk-head-is? a 'FORALL) (eq? (cadr a) 'g4v_)))))

;;; lift(t3) = lift(t1) lift(t2) when t3 = t1 o t2
(sp (g4c-st1 '((t1 b1) (t2 b2) (t3 b3))
  (list 'IMPLIES (g4c-ptw (lambda (v) (list '= (list 't3 v) (list 't1 (list 't2 v)))))
    (g4c-allx (list '= (list (g4c-L 't3) 'xx) (list (g4c-L 't1) (list (g4c-L 't2) 'xx)))))))
(dk-peel!)
(g4c-hsetup!)
(let* ((hy (g4c-ptw-hyp 't3)) (f (g4c-rep! 'xx)) (s2 (g4c-sm 't2 f)))
  (subst (g4c-lift! 't2 'b2 f))
  (subst (g4c-lift! 't1 'b1 s2))
  (subst (g4c-lift! 't3 'b3 f))
  (g4c-cite*! 'seq-map-type g4c-PM g4c-PM 't3 f)
  (g4c-cite*! 'seq-map-type g4c-PM g4c-PM 't1 s2)
  (g4c-ext! (g4c-sm 't3 f) (g4c-sm 't1 s2) g4c-PM
    (lambda (j)
      (g4c-at! 't3 f j) (g4c-at! 't1 s2 j) (g4c-at! 't2 f j)
      (g4c-fj! f j)
      (subst (dk-apply! hy (list f j)))
      (g4c-close-eq!)))
  (subst (list '= (g4c-sm 't3 f) (g4c-sm 't1 s2)))
  (g4c-close-eq!))
(g4c-qed! 'completion-lift-compose)

;;; lift(t1) = id when t1 = id
(sp (g4c-st1 '((t1 b1))
  (list 'IMPLIES (g4c-ptw (lambda (v) (list '= (list 't1 v) v)))
    (g4c-allx (list '= (list (g4c-L 't1) 'xx) 'xx)))))
(dk-peel!)
(g4c-hsetup!)
(let* ((hy (g4c-ptw-hyp 't1)) (f (g4c-rep! 'xx)))
  (subst (g4c-lift! 't1 'b1 f))
  (g4c-cite*! 'seq-map-type g4c-PM g4c-PM 't1 f)
  (g4c-ext! (g4c-sm 't1 f) f g4c-PM
    (lambda (j)
      (g4c-at! 't1 f j)
      (g4c-fj! f j)
      (subst (dk-apply! hy (list f j)))
      (g4c-close-eq!)))
  (subst (list '= (g4c-sm 't1 f) f))
  (g4c-close-eq!))
(g4c-qed! 'completion-lift-id)

;;; lift(t3) = lift(t1) + lift(t2) when t3 = t1 + t2
(define (g4c-hvadd x y) (list (list 'VADD g4c-HC) x y))
(define (g4c-hact c x) (list (list 'ACT g4c-HC) c x))
(sp (g4c-st1 '((t1 b1) (t2 b2) (t3 b3))
  (list 'IMPLIES (g4c-ptw (lambda (v) (list '= (list 't3 v) (list '(VADD md) (list 't1 v) (list 't2 v)))))
    (g4c-allx (list '= (list (g4c-L 't3) 'xx) (g4c-hvadd (list (g4c-L 't1) 'xx) (list (g4c-L 't2) 'xx)))))))
(dk-peel!)
(g4c-hsetup!)
(let* ((hy (g4c-ptw-hyp 't3)) (f (g4c-rep! 'xx)) (s1 (g4c-sm 't1 f)) (s2 (g4c-sm 't2 f))
       (sv (list 'SEQ-VADD 'md s1 s2)))
  (subst (g4c-lift! 't1 'b1 f))
  (subst (g4c-lift! 't2 'b2 f))
  (subst (g4c-lift! 't3 'b3 f))
  (subst (g4c-cite*! 'hc-vadd-classes 'md 'fq s1 s2))
  (g4c-cite*! 'seq-vadd-type 'md 'fq s1 s2)
  (g4c-ext! (g4c-sm 't3 f) sv '(VEC md)
    (lambda (j)
      (g4c-at! 't3 f j)
      (subst (g4c-cite*! 'seq-vadd-at 'md 'fq s1 s2 j))
      (g4c-at! 't1 f j) (g4c-at! 't2 f j)
      (g4c-fj! f j)
      (subst (dk-apply! hy (list f j)))
      (g4c-close-eq!)))
  (subst (list '= (g4c-sm 't3 f) sv))
  (g4c-close-eq!))
(g4c-qed! 'completion-lift-sum)

;;; lift(t3) = c lift(t1) when t3 = c t1
(sp (g4c-st1 '((t1 b1) (t3 b3))
  (list 'FORALL 'c (list 'IMPLIES '(IN c CC)
  (list 'IMPLIES (g4c-ptw (lambda (v) (list '= (list 't3 v) (list '(ACT md) 'c (list 't1 v)))))
    (g4c-allx (list '= (list (g4c-L 't3) 'xx) (g4c-hact 'c (list (g4c-L 't1) 'xx)))))))))
(dk-peel!)
(g4c-hsetup!)
(let* ((hy (g4c-ptw-hyp 't3)) (f (g4c-rep! 'xx)) (s1 (g4c-sm 't1 f))
       (sv (list 'SEQ-ACT 'md 'c s1)))
  (subst (g4c-lift! 't1 'b1 f))
  (subst (g4c-lift! 't3 'b3 f))
  (subst (g4c-cite*! 'hc-act-classes 'md 'fq 'c s1))
  (g4c-cite*! 'seq-act-type 'md 'fq 'c s1)
  (g4c-ext! (g4c-sm 't3 f) sv '(VEC md)
    (lambda (j)
      (g4c-at! 't3 f j)
      (subst (g4c-cite*! 'seq-act-at 'md 'fq 'c s1 j))
      (g4c-at! 't1 f j)
      (g4c-fj! f j)
      (subst (dk-apply! hy (list f j)))
      (g4c-close-eq!)))
  (subst (list '= (g4c-sm 't3 f) sv))
  (g4c-close-eq!))
(g4c-qed! 'completion-lift-scale)

;;; ---- lift(t) is linear when t is
(define (g4c-add-hyp t) (g4c-ptw2 (lambda (v z) (list '= (list t (list '(VADD md) v z)) (list '(VADD md) (list t v) (list t z))))))
(define (g4c-hom-hyp t)
  (list 'FORALL 'g4c_ (list 'IMPLIES '(IN g4c_ CC)
    (g4c-ptw (lambda (v) (list '= (list t (list '(ACT md) 'g4c_ v)) (list '(ACT md) 'g4c_ (list t v))))))))
(define (g4c-add-concl t)
  (list 'FORALL 'xx (list 'IMPLIES (list 'IN 'xx (list 'VEC g4c-HC)) (list 'FORALL 'yy (list 'IMPLIES (list 'IN 'yy (list 'VEC g4c-HC))
    (list '= (list (g4c-L t) (g4c-hvadd 'xx 'yy)) (g4c-hvadd (list (g4c-L t) 'xx) (list (g4c-L t) 'yy))))))))
(define (g4c-hom-concl t)
  (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'xx (list 'IMPLIES (list 'IN 'xx (list 'VEC g4c-HC))
    (list '= (list (g4c-L t) (g4c-hact 'c 'xx)) (g4c-hact 'c (list (g4c-L t) 'xx))))))))

(sp (g4c-st1 '((t1 b1)) (list 'IMPLIES (g4c-add-hyp 't1) (g4c-add-concl 't1))))
(dk-peel!)
(g4c-hsetup!)
(let* ((hy (g4c-hyp-of (lambda (a) (and (dk-head-is? a 'FORALL) (eq? (cadr a) 'g4v_)))))
       (f (g4c-rep! 'xx)) (g (g4c-rep! 'yy)) (sv (list 'SEQ-VADD 'md f g)))
  (g4c-cs-facts! f) (g4c-cs-facts! g)
  (subst (g4c-cite*! 'hc-vadd-classes 'md 'fq f g))
  (g4c-cite*! 'seq-vadd-cauchy 'md 'fq f g)
  (g4c-in-cs! sv)
  (let* ((s1 (g4c-sm 't1 f)) (s2 (g4c-sm 't1 g)) (sw (list 'SEQ-VADD 'md s1 s2)))
    (subst (g4c-lift! 't1 'b1 sv))
    (subst (g4c-lift! 't1 'b1 f))
    (subst (g4c-lift! 't1 'b1 g))
    (subst (g4c-cite*! 'hc-vadd-classes 'md 'fq s1 s2))
    (g4c-cite*! 'seq-vadd-type 'md 'fq s1 s2)
    (g4c-cite*! 'seq-map-type g4c-PM g4c-PM 't1 sv)
    (g4c-vecfun! (g4c-sm 't1 sv))
    (g4c-ext! (g4c-sm 't1 sv) sw '(VEC md)
      (lambda (j)
        (g4c-at! 't1 sv j)
        (subst (g4c-cite*! 'seq-vadd-at 'md 'fq f g j))
        (subst (g4c-cite*! 'seq-vadd-at 'md 'fq s1 s2 j))
        (g4c-at! 't1 f j) (g4c-at! 't1 g j)
        (g4c-fj! f j) (g4c-fj! g j)
        (subst (dk-apply! hy (list f j) (list g j)))
        (g4c-close-eq!)))
    (subst (list '= (g4c-sm 't1 sv) sw))
    (g4c-close-eq!)))
(g4c-qed! 'completion-lift-additive)

(sp (g4c-st1 '((t1 b1)) (list 'IMPLIES (g4c-hom-hyp 't1) (g4c-hom-concl 't1))))
(dk-peel!)
(g4c-hsetup!)
(let* ((hy (g4c-hyp-of (lambda (a) (and (dk-head-is? a 'FORALL) (eq? (cadr a) 'g4c_)))))
       (f (g4c-rep! 'xx)) (sv (list 'SEQ-ACT 'md 'c f)))
  (g4c-cs-facts! f)
  (subst (g4c-cite*! 'hc-act-classes 'md 'fq 'c f))
  (g4c-cite*! 'seq-act-cauchy 'md 'fq 'c f)
  (g4c-in-cs! sv)
  (let* ((s1 (g4c-sm 't1 f)) (sw (list 'SEQ-ACT 'md 'c s1)))
    (subst (g4c-lift! 't1 'b1 sv))
    (subst (g4c-lift! 't1 'b1 f))
    (subst (g4c-cite*! 'hc-act-classes 'md 'fq 'c s1))
    (g4c-cite*! 'seq-act-type 'md 'fq 'c s1)
    (g4c-cite*! 'seq-map-type g4c-PM g4c-PM 't1 sv)
    (g4c-vecfun! (g4c-sm 't1 sv))
    (g4c-ext! (g4c-sm 't1 sv) sw '(VEC md)
      (lambda (j)
        (g4c-at! 't1 sv j)
        (subst (g4c-cite*! 'seq-act-at 'md 'fq 'c f j))
        (subst (g4c-cite*! 'seq-act-at 'md 'fq 'c s1 j))
        (g4c-at! 't1 f j)
        (g4c-fj! f j)
        (subst (dk-apply! hy 'c (list f j)))
        (g4c-close-eq!)))
    (subst (list '= (g4c-sm 't1 sv) sw))
    (g4c-close-eq!)))
(g4c-qed! 'completion-lift-homogeneous)

;;; ---- the adjoint relation passes to the lifts
(sp (g4c-st1 '((t1 b1) (t2 b2))
  (list 'IMPLIES (g4c-ptw2 (lambda (v z) (list '= (list 'fq (list 't1 v) z) (list 'fq v (list 't2 z)))))
    (list 'FORALL 'xx (list 'IMPLIES (list 'IN 'xx (list 'VEC g4c-HC)) (list 'FORALL 'yy (list 'IMPLIES (list 'IN 'yy (list 'VEC g4c-HC))
      (list '= (list (list 'IP g4c-HC) (list (g4c-L 't1) 'xx) 'yy) (list (list 'IP g4c-HC) 'xx (list (g4c-L 't2) 'yy))))))))))
(dk-peel!)
(g4c-hsetup!)
(let* ((hy (g4c-hyp-of (lambda (a) (and (dk-head-is? a 'FORALL) (eq? (cadr a) 'g4v_)))))
       (f (g4c-rep! 'xx)) (g (g4c-rep! 'yy)) (s1 (g4c-sm 't1 f)) (s2 (g4c-sm 't2 g))
       (sl (list 'SEQ-FORM 'fq s1 g)) (sr (list 'SEQ-FORM 'fq f s2)) (c (list g4c-LF f s2)))
  (subst (g4c-lift! 't1 'b1 f))
  (subst (g4c-lift! 't2 'b2 g))
  (subst (g4c-cite*! 'hc-ip-classes 'md 'fq s1 g))
  (subst (g4c-cite*! 'hc-ip-classes 'md 'fq f s2))
  (dk-split! (g4c-cite*! 'limit-form-prop 'md 'fq f s2))
  (g4c-cite*! 'seq-form-type 'md 'fq s1 g)
  (g4c-cite*! 'seq-form-type 'md 'fq f s2)
  (g4c-ext! sl sr 'CC
    (lambda (j)
      (subst (g4c-cite*! 'seq-form-at 'md 'fq s1 g j))
      (subst (g4c-cite*! 'seq-form-at 'md 'fq f s2 j))
      (g4c-at! 't1 f j) (g4c-at! 't2 g j)
      (g4c-fj! f j) (g4c-fj! g j)
      (subst (dk-apply! hy (list f j) (list g j)))
      (g4c-close-eq!)))
  (dk-rewrite-h! (list 'CONVERGES-TO 'CC-MS sr c) sr sl)
  (subst (g4c-cite*! 'limit-form-value 'md 'fq s1 g c))
  (g4c-close-eq!))
(g4c-qed! 'completion-lift-adjoint)

;;; ---- <lift(t) x | lift(t) x> <= c <x | x> when <t u | t u> <= c <u | u>
(define (g4c-mulr! a b)
  (g4c-have! (list 'IN (list '* a b) 'RR) (lambda () (g4c-cite*! 'rr-mul-closed a b) (dk-ass!))))
(define (g4c-c2! thm a b h1 h2 claim)   ; thm: forall a. a in RR and h1 => forall b. b in RR and h2 => claim
  (g4c-have! claim
    (lambda ()
      (g4c-have! (list 'AND (list 'IN a 'RR) h1) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
      (g4c-have! (list 'AND (list 'IN b 'RR) h2) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
      (let* ((r (dk-cite! thm a))
             (fa (if (dk-head-is? r 'IMPLIES) (caddr r) r)))
        (if (not (dk-asm? fa)) (detach! r))
        (dk-apply! fa b)
        (dk-ass!)))))
(define (g4c-bound-hyp t cq) (g4c-ptw (lambda (v) (list '<= (list 'fq (list t v) (list t v)) (list '* cq (list 'fq v v))))))
(define (g4c-sfrr! f)          ; SEQ-FORM(fq, f, f) in FUN(NN, RR); f in FUN(NN, PTS M) in context
  (let ((cl (list 'IN (list 'SEQ-FORM 'fq f f) '(FUN NN RR))))
    (g4c-have! cl
      (lambda ()
        (mac 'SEQ-FORM)
        (dk-lam-type!
          (lambda ()
            (dk-peel!)
            (let* ((g (dk-goal)) (j (cadr (cadr (cadr g)))))
              (g4c-fj! f j)
              (g4c-cite*! 'psd-form-real 'md 'fq (list f j))
              (dk-ass!))))))))
(sp (g4c-st1 '((t1 b1))
  (list 'FORALL 'cq (list 'IMPLIES '(IN cq RR) (list 'IMPLIES (g4c-bound-hyp 't1 'cq)
    (g4c-allx (list '<= (list (list 'IP g4c-HC) (list (g4c-L 't1) 'xx) (list (g4c-L 't1) 'xx))
                        (list '* 'cq (list (list 'IP g4c-HC) 'xx 'xx)))))))))
(dk-peel!)
(g4c-hsetup!)
(let* ((hy (g4c-hyp-of (lambda (a) (and (dk-head-is? a 'FORALL) (eq? (cadr a) 'g4v_)))))
       (f (g4c-rep! 'xx)) (s1 (g4c-sm 't1 f))
       (sff (list 'SEQ-FORM 'fq f f)) (s11 (list 'SEQ-FORM 'fq s1 s1))
       (lff (list g4c-LF f f)) (l11 (list g4c-LF s1 s1))
       (h (list 'VNB-LAMBDA 'g4cj_ 'NN (list '* (list sff 'g4cj_) 'cq))))
  (subst (g4c-lift! 't1 'b1 f))
  (subst (g4c-cite*! 'hc-ip-classes 'md 'fq s1 s1))
  (subst (g4c-cite*! 'hc-ip-classes 'md 'fq f f))
  (g4c-sfrr! f) (g4c-sfrr! s1)
  (g4c-cite*! 'limit-form-rr 'md 'fq f)
  (g4c-cite*! 'limit-form-rr 'md 'fq s1)
  (dk-split! (g4c-cite*! 'limit-form-diag 'md 'fq f))
  (dk-split! (g4c-cite*! 'limit-form-diag 'md 'fq s1))
  (dk-have! (list 'IN h '(FUN NN RR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (dk-peel!)
          (let* ((j (cadr (cadr (cadr (dk-goal))))) (l (proof-state-focus *ps*)))
            (dk-cite! 'fun-apply-type-c sff 'NN 'RR j)
            (g4c-mulr! (list sff j) 'cq)
            (if (not (sequent-node-grounded? l)) (dk-ass!)))))))
  (dk-have! (list 'FORALL 'g4ck_ (list 'IMPLIES '(IN g4ck_ NN) (list '= (list h 'g4ck_) (list '* (list sff 'g4ck_) 'cq))))
    (lambda ()
      (dk-peel!)
      (let* ((j (cadr (cadr (dk-goal)))))
        (dk-cite! 'fun-apply-type-c sff 'NN 'RR j)
        (let ((l (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? l)) (g4c-close-eq!))))))
  (g4c-mulr! 'cq lff) (g4c-mulr! lff 'cq)
  (g4c-cite*! 'rr-limit-scale 'cq sff h lff)
  (dk-have! (list 'FORALL 'g4ck_ (list 'IMPLIES '(IN g4ck_ NN) (list '<= (list s11 'g4ck_) (list h 'g4ck_))))
    (lambda ()
      (dk-peel!)
      (let* ((j (cadr (cadr (dk-goal)))) (fj (list f j)) (tfj (list 't1 fj))
             (a (list 'fq tfj tfj)) (b (list 'fq fj fj)))
        (dk-cite! 'fun-apply-type-c sff 'NN 'RR j)
        (dk-lam-b!)
        (subst (g4c-cite*! 'seq-form-at 'md 'fq s1 s1 j))
        (subst (g4c-cite*! 'seq-form-at 'md 'fq f f j))
        (g4c-at! 't1 f j)
        (g4c-fj! f j) (g4c-tj! 't1 fj)
        (g4c-cite*! 'psd-form-real 'md 'fq fj)
        (g4c-cite*! 'psd-form-real 'md 'fq tfj)
        (let ((le (dk-apply! hy fj)))
          (g4c-mulr! 'cq b) (g4c-mulr! b 'cq)
          (g4c-have! (list '= (list '* 'cq b) (list '* b 'cq)) (lambda () (crs)))
          (dk-rewrite-h! le (list '* 'cq b) (list '* b 'cq))
          (dk-ass!)))))
  (g4c-cite*! 'rr-limit-le s11 h l11 (list '* lff 'cq))
  (g4c-mulr! 'cq lff) (g4c-mulr! lff 'cq)
  (g4c-have! (list '= (list '* lff 'cq) (list '* 'cq lff)) (lambda () (crs)))
  (subst (list '= (list '* 'cq lff) (list '* lff 'cq)))
  (dk-ass!))
(g4c-qed! 'completion-lift-bound)

;;; ---- lift(t) is a bounded operator on the completion, of norm <= b
(sp (g4c-st1 '((t1 b1))
  (list 'IMPLIES (g4c-add-hyp 't1) (list 'IMPLIES (g4c-hom-hyp 't1) (list 'IMPLIES (g4c-bound-hyp 't1 '(* b1 b1))
    (list 'IN (g4c-L 't1) (list 'BOUNDED-OPS g4c-HC g4c-HC)))))))
(dk-peel!)
(g4c-hsetup!)
(let* ((L (g4c-L 't1)) (bb '(* b1 b1)))
  (dk-real! bb)
  (g4c-cite*! 'completion-lift-type g4c-M 't1 'b1)
  (g4c-have! (list 'IN L (list 'FUN (list 'VEC g4c-HC) (list 'VEC g4c-HC)))
    (lambda () (subst (list '= (list 'VEC g4c-HC) (list 'QUOTIENT g4c-HS))) (dk-ass!)))
  (g4c-cite*! 'completion-lift-additive 'md 'fq 't1 'b1)
  (g4c-cite*! 'completion-lift-homogeneous 'md 'fq 't1 'b1)
  (let ((bd (g4c-cite*! 'completion-lift-bound 'md 'fq 't1 'b1 bb)))
    (dk-have! (list 'IS-LINEAR-OP g4c-HC g4c-HC L)
      (lambda () (mac 'IS-LINEAR-OP) (dk-conj-close! (lambda () (dk-ass!)))))
    (dk-have! (list 'FORALL 'g4cx_ (list 'IMPLIES (list 'IN 'g4cx_ (list 'VEC g4c-HC))
                (list '<= (list 'IP-NORM g4c-HC (list L 'g4cx_)) (list '* 'b1 (list 'IP-NORM g4c-HC 'g4cx_)))))
      (lambda ()
        (dk-peel!)
        (let* ((x (caddr (caddr (caddr (dk-goal)))))
               (lx (list L x)) (pl (list (list 'IP g4c-HC) lx lx)) (px (list (list 'IP g4c-HC) x x)))
          (dk-cite! 'fun-apply-type-c L (list 'VEC g4c-HC) (list 'VEC g4c-HC) x)
          (subst (dk-cite! 'ip-norm-unfold g4c-HC lx))
          (subst (dk-cite! 'ip-norm-unfold g4c-HC x))
          (g4c-cite*! 'cips-ip-self-real g4c-HC x) (g4c-cite*! 'cips-ip-self-nonneg g4c-HC x)
          (g4c-cite*! 'cips-ip-self-real g4c-HC lx) (g4c-cite*! 'cips-ip-self-nonneg g4c-HC lx)
          (g4c-mulr! bb px)
          (let ((le (dk-apply! bd x)))
            (g4c-cite*! 'rr-mul-le-right 0 'b1 'b1)
            (g4c-have! '(= (* 0 b1) 0) (lambda () (crs)))
            (dk-rewrite-h! '(<= (* 0 b1) (* b1 b1)) '(* 0 b1) 0)
            (let* ((bpx (list '* bb px))
                   (sm (g4c-c2! 'sqrt-mono pl bpx (list '<= 0 pl) (list '<= pl bpx)
                                (list '<= (list 'SQRT pl) (list 'SQRT bpx))))
                   (e1 (g4c-c2! 'sqrt-mul bb px (list '<= 0 bb) (list '<= 0 px)
                                (list '= (list 'SQRT bpx) (list '* (list 'SQRT bb) (list 'SQRT px)))))
                   (e2 (dk-cite! 'sqrt-of-sq 'b1))
                   (e3 (g4c-cite*! 'rr-abs-of-nonneg 'b1)))
              (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! sm (cadr e1) (caddr e1)) (cadr e2) (caddr e2)) (cadr e3) (caddr e3))
              (dk-ass!))))))
    (g4c-cite*! 'bop-intro g4c-HC g4c-HC L 'b1)
    (dk-ass!)))
(g4c-qed! 'completion-lift-bounded)
