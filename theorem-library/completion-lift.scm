;;; ---- the lift on the classes
(define g4c-S '(CAUCHY-SETOID mq))
(define (g4c-F) (list 'VNB-LAMBDA 'g4hf_ '(CSEQ mq) (list 'CLASS g4c-S '(SEQ-MAP tq g4hf_))))
(define (g4c-cl f) (list 'CLASS g4c-S f))
(define (g4c-ssetup!)
  (dk-cite! 'cauchy-setoid-is-setoid 'mq)
  (dk-cite! 'rkt-cauchy-setoid-pts 'mq)
  (dk-cite! 'rko2-cauchy-setoid-rel 'mq))
;;; (IN t (CSEQ mq)) from IS-CAUCHY-SEQ(mq, t)
(define (g4c-in-cseq! t)
  (let ((g (list 'IN t '(CSEQ mq))))
    (g4c-have! g
      (lambda ()
        (subst (dk-cite! 'rko2-cseq-unfold 'mq))
        (in-sep! (lambda () (g4c-cite*! 'cauchy-seq-is-fun 'mq t) (dk-ass!))
                 (lambda () (dk-ass!)))))))
;;; u in CSEQ mq: land u's Cauchy-ness, its typing, and t o u in CSEQ mq
(define (g4c-seq-facts! u)
  (g4c-cite*! 'r7q-cseq-cauchy 'mq u)
  (g4c-cite*! 'rko2-cseq-in-fun 'mq u)
  (g4c-cite*! 'seq-map-cauchy 'mq 'tq 'bq u)
  (g4c-in-cseq! (list 'SEQ-MAP 'tq u)))
(define (g4c-pts! t)           ; (IN t (PTS S)) from (IN t (CSEQ mq))
  (g4c-have! (list 'IN t (list 'PTS g4c-S)) (lambda () (subst (list '= (list 'PTS g4c-S) '(CSEQ mq))) (dk-ass!))))

(sp (g4c-lip-st (list 'AND (list 'IN (g4c-F) (list 'FUN (list 'PTS g4c-S) (list 'QUOTIENT g4c-S)))
                           (list 'RESPECTS g4c-S (g4c-F)))))
(dk-peel!)
(g4c-ssetup!)
(let ((F (g4c-F)))
  (dk-have! (list 'IN F (list 'FUN (list 'PTS g4c-S) (list 'QUOTIENT g4c-S)))
    (lambda ()
      (subst (list '= (list 'PTS g4c-S) '(CSEQ mq)))
      (dk-lam-type!
        (lambda ()
          (dk-peel!)
          (let* ((u (caddr (caddr (cadr (dk-goal))))))
            (g4c-seq-facts! u)
            (g4c-pts! (list 'SEQ-MAP 'tq u))
            (g4c-cite*! 'class-in-quotient g4c-S (list 'SEQ-MAP 'tq u))
            (dk-ass!)))
        (lambda () (g4c-cite*! 'rkt-cseq-is-set 'mq) (dk-ass!)))))
  (let* ((iff (dk-cite! 'respects-unfold g4c-S F)) (rhs (caddr iff)))
    (dk-have! rhs
      (lambda ()
        (dk-peel!)
        (let* ((g (dk-goal)) (u (cadr (cadr g))) (w (cadr (caddr g)))
               (su (list 'SEQ-MAP 'tq u)) (sw (list 'SEQ-MAP 'tq w)))
          (for-each (lambda (t) (g4c-have! (list 'IN t '(CSEQ mq)) (lambda () (subst (list '= '(CSEQ mq) (list 'PTS g4c-S))) (dk-ass!))))
                    (list u w))
          (g4c-seq-facts! u) (g4c-seq-facts! w)
          (dk-lam-b!)
          (dk-iff-fwd! (dk-cite! 'rko2-related-unfold g4c-S u w))
          (let* ((m1 (dk-rewrite-h! (list 'IN (list 'LIST u w) (list 'REL g4c-S)) (list 'REL g4c-S) '(CREL mq))))
            (g4c-cite*! 'rko2-crel-elim 'mq u w)
            (g4c-cite*! 'seq-map-equiv 'mq 'tq 'bq u w)
            (g4c-cite*! 'rko2-crel-intro 'mq su sw)
            (dk-have! (list 'IN (list 'LIST su sw) (list 'REL g4c-S))
              (lambda () (subst (list '= (list 'REL g4c-S) '(CREL mq))) (dk-ass!)))
            (let ((ri (dk-cite! 'rko2-related-unfold g4c-S su sw)))
              (dk-iff-bwd! ri))
            (g4c-pts! su) (g4c-pts! sw)
            (dk-iff-bwd! (g4c-cite*! 'class-eq-iff g4c-S su sw))
            (dk-ass!)))))
    (dk-iff-bwd! iff)
    (dk-conj-close! (lambda () (dk-ass!)))))
(g4c-qed! 'completion-lift-ok)

(define g4c-L '(COMPLETION-LIFT mq tq))
