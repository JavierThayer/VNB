;;; ccr4c-local.scm -- CCR.pdf 4.21 PACKAGED: B(K), with the structure of K restricted to it, IS A LOCAL FIELD, in
;;; characteristic p and in characteristic 0, from the general fact that a subfield of an NV field whose integers
;;; are compact and which holds an element w with 0 < |w| < 1 is a local NV field.  Agent CCR-1109-C4, 2026-11-09/10.
;;; Destination: theorem-library/ccr4c-local.scm.  Helper prefix sl-.
;;;
;;;   sub-nf-local           IS-NV-FIELD K, IS-NF-SUBFIELD(K, S), Z(K) n S compact, w in S with 0 < |w| < 1
;;;                          => IS-LOCAL-NV-FIELD(SUB-NF K S)
;;;   ccr-4-21               K local (Z(K) compact, M = (w), w /= 0), K of characteristic p
;;;                          => IS-LOCAL-NV-FIELD(SUB-NF K B(K)), B(K) = NV-BASE(K, w) the user's definition
;;;   nv-residue-zz-act-one  n.1 lies in Z(K), and n.1 in the residue ring is the class of n.1 (n in NN)
;;;   ccr-4-21-char-0        the same as ccr-4-21 for K with no prime characteristic: the residue field is finite
;;;                          (ccr-2-7), of prime characteristic p (finite-field-characteristic), so p.1 lies in M,
;;;                          0 < |p.1| < 1, and p.1 lies in B(K) (nf-subfield-zz-act-one)
;;;
;;; Library: complex-analysis AS THE TREE STANDS, because it cites nv-local-of-compact-integers, ccr-2-7 and the rs-*
;;; laws of the residue ringoid (theorem-library/qp-laws, complex-analysis) and ccr-4-21-base (CCR-1109-C3, which
;;; cites qp-laws itself).  All are general NV facts: once they are hoisted to analysis (CCR-1109-C3 report, gate
;;; note option (a)), this file is analysis.
;;; Load window: after qp-laws, ca51-exhaustion (compact-subset-of-subspace-iff), ccr4b-base (ccr-4-21-base,
;;; ccr-4-21-base-char-p, nv-residue-unfold, nv-residue-zero-class), ccr4c-finite-char (zz-act-one-zero/succ,
;;; finite-field-characteristic) and ccr4c-subnf (sub-nf-*, nf-subfield-small, nf-subfield-zz-act-one).

(define sl-r '(SUB-NF K S))
(define sl-lnrm '(VNB-LAMBDA snu_ S ((FNRM K) snu_)))
(define sl-ms '(NF-METRIC-SPACE K))
(define sl-int '(INTERSECTION (NV-INTEGERS K) S))

(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL S (IMPLIES (IS-NF-SUBFIELD K S)
   (IMPLIES (IS-COMPACT (SUBSPACE-MS ,sl-ms ,sl-int))
   (FORALL w (IMPLIES (IN w S) (IMPLIES (< 0 ((FNRM K) w)) (IMPLIES (< ((FNRM K) w) 1)
     (IS-LOCAL-NV-FIELD ,sl-r))))))))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'nv-field-normed 'K))
(dk-chain-ass! (dk-cite! 'sub-nf-is-nv-field 'K 'S))
(dk-chain-ass! (dk-cite! 'sub-nf-is-normed-field 'K 'S))
(for-each (lambda (n) (dk-cite! n 'K 'S)) '(sub-nf-carr sub-nf-zero sub-nf-fnrm sub-nf-metric sub-nf-integers))
(dk-chain-ass! (dk-cite! 'nf-metric-space-is-metric-space 'K))
(dk-cite! 'nf-metric-carrier 'K)
;; S lies in K
(let* ((iff (dk-cite! 'is-nf-subfield 'K 'S)) (rhs (caddr iff)))
  (ai iff) (detach! (list 'IMPLIES (cadr iff) rhs)) (dk-split-all! (list rhs)))
(dk-have! `(SUBSET S (PTS ,sl-ms))
  (lambda () (subst `(== (PTS ,sl-ms) (CARR K))) (mac 'subset-def) (dk-close-if-asm!)))
(dk-have! `(SUBSET ,sl-int S)
  (lambda ()
    (mac 'subset-def)
    (let ((z (begin (di) (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) sl-int))) "z in the intersection")))))
      (dk-iff-fwd! (dk-cite! 'intersection-membership '(NV-INTEGERS K) 'S z))
      (dk-close-if-asm!))))
;; the integers of SUB-NF(K, S) are compact
(dk-have! `(IS-COMPACT (SUBSPACE-MS (NF-METRIC-SPACE ,sl-r) (NV-INTEGERS ,sl-r)))
  (lambda ()
    (subst `(== (NF-METRIC-SPACE ,sl-r) (SUBSPACE-MS ,sl-ms S)))
    (subst `(= (NV-INTEGERS ,sl-r) ,sl-int))
    (dk-iff-bwd! (dk-chain-ass! (dk-cite! 'compact-subset-of-subspace-iff sl-ms 'S sl-int)))
    (dk-close-if-asm!)))
;; it has non-zero elements of arbitrarily small absolute value
(define sl-small `(FORALL eps (IMPLIES (POS-RR eps) (FORSOME hs (AND (IN hs (CARR ,sl-r))
                     (AND (NOT (= hs (ZERO ,sl-r))) (< ((FNRM ,sl-r) hs) eps)))))))
(dk-have! sl-small
  (lambda ()
    (dk-peel!)
    (let* ((eps (cadr (dk-pick (lambda (f) (dk-head-is? f 'POS-RR)) "eps")))
           (ex (dk-chain-ass! (dk-cite! 'nf-subfield-small 'K 'S 'w eps)))
           (h0 (dk-skolem! ex #t)))
      (dk-cite! 'sub-nf-fnrm-val 'K 'S h0)
      (subst `(== (CARR ,sl-r) S))
      (subst `(== (ZERO ,sl-r) (ZERO K)))
      (subst `(== (FNRM ,sl-r) ,sl-lnrm))
      (ew h0)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (dk-ass!)
              (begin (subst `(= (,sl-lnrm ,h0) ((FNRM K) ,h0))) (dk-close-if-asm!))))))))
(dk-chain-ass! (dk-cite! 'nv-local-of-compact-integers sl-r))
(dk-close-if-asm!)
(qed 'sub-nf-local)

;;; ---------------------------------------------------------------------------
;;; Proposition 4.21, characteristic p: B(K) is a local field
(define sl-ZK '(NV-INTEGERS K))
(define sl-B '(NV-BASE K w))
(sp (make-wff `(FORALL K (IMPLIES (IS-COMPACT-NV-DOMAIN K ,sl-ZK) (FORALL w (IMPLIES (IN w ,sl-ZK)
   (IMPLIES (= (NV-MAXIMAL K ,sl-ZK) (NV-PRINCIPAL K ,sl-ZK w)) (IMPLIES (NOT (= w (ZERO K)))
   (FORALL p (IMPLIES (HAS-CHARACTERISTIC (NORMED-FIELD-AS-COMMUTATIVE-RING K) p)
     (IS-LOCAL-NV-FIELD (SUB-NF K ,sl-B))))))))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'nv-compact-domain 'K sl-ZK))
(dk-chain-ass! (dk-cite! 'nv-domain-field 'K sl-ZK))
(dk-split-all! (list (dk-chain-ass! (dk-cite! 'ccr-4-21-base 'K 'w))))
(dk-split-all! (list (dk-chain-ass! (dk-cite! 'ccr-4-21-base-char-p 'K 'w 'p))))
(dk-chain-ass! (dk-cite! 'sub-nf-local 'K sl-B 'w))
(dk-close-if-asm!)
(qed 'ccr-4-21)

;;; ---------------------------------------------------------------------------
;;; Proposition 4.21, characteristic 0.  The residue field is finite (ccr-2-7), so it has a prime characteristic
;;; p (finite-field-characteristic); p.1 then lies in M(K), so |p.1| < 1, and p.1 /= 0 because K has no prime
;;; characteristic; p.1 lies in every subfield, B(K) among them (nf-subfield-zz-act-one).
(define sl-V '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define sl-rr `(NV-RES-RINGOID K ,sl-ZK))
(define sl-Q `(RINGOID-QUOTIENT-RING ,sl-rr))
(define sl-st `(RINGOID-SETOID ,sl-rr))
(define sl-res `(NV-RESIDUE K ,sl-ZK))
(define (sl-E n) `(ZZ-ACT (RING-ADDITIVE-AG ,sl-V) ,n (ONE ,sl-V)))
(define (sl-L n) `(ZZ-ACT (RING-ADDITIVE-AG ,sl-Q) ,n (ONE ,sl-Q)))
(define sl-rslam `(VNB-LAMBDA (LIST rsu_ rsv_) (CARTESIAN ,sl-ZK ,sl-ZK) ((ADD K) rsu_ rsv_)))
(define (sl-rfl!) (dk-close-if! (lambda () #t) (lambda () (rfl))))

;; n.1 in the residue ring is the class of n.1
(sp (make-wff `(FORALL n (IMPLIES (IN n NN) (FORALL K (IMPLIES (IS-NV-FIELD K)
   (AND (IN ,(sl-E 'n) ,sl-ZK) (= ,(sl-L 'n) (CLASS ,sl-st ,(sl-E 'n))))))))))
(let* ((br (dk-use-induction-fixed! '(K)))
       (n (cdr (assq 'var br))) (st (cdr (assq 'step br))) (bs (cdr (assq 'base br))))
  (define (prep!)
    (if (not (dk-head-is? (dk-goal) 'AND)) (dk-peel!))
    (dk-chain-ass! (dk-cite! 'nv-field-normed 'K))
    (dk-chain-ass! (dk-cite! 'nv-integers-domain 'K))
    (dk-chain-ass! (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K))
    (dk-chain-ass! (dk-cite! 'commutative-ring-is-ring sl-V))
    (for-each (lambda (r) (dk-cite! r 'K))
              '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-zero normed-field-ring-view-one))
    (for-each (lambda (r) (dk-chain-ass! (dk-cite! r 'K sl-ZK)))
              '(rs-is-ringoid rs-carr rs-one rs-zero rs-add nv-domain-zero nv-domain-one))
    (dk-chain-ass! (dk-cite! 'ringoid-quotient-is-ring sl-rr))
    (dk-cite! 'rq-one sl-rr)
    (dk-cite! 'rq-zero sl-rr))
  (dk-focus! bs)
  (prep!)
  (dk-have! `(= ,(sl-E 0) (ZERO K))
    (lambda () (subst (dk-chain-ass! (dk-cite! 'zz-act-one-zero sl-V))) (subst `(= (ZERO ,sl-V) (ZERO K))) (sl-rfl!)))
  (dk-have! `(IN ,(sl-E 0) ,sl-ZK) (lambda () (subst `(= ,(sl-E 0) (ZERO K))) (dk-close-if-asm!)))
  (dk-have! `(= ,(sl-L 0) (CLASS ,sl-st ,(sl-E 0)))
    (lambda ()
      (subst `(= ,(sl-E 0) (ZERO K)))
      (subst (dk-chain-ass! (dk-cite! 'zz-act-one-zero sl-Q)))
      (subst `(== (ZERO ,sl-Q) (CLASS ,sl-st (ZERO ,sl-rr))))
      (subst `(== (ZERO ,sl-rr) (ZERO K)))
      (sl-rfl!)))
  (dk-conj-close! (lambda () (dk-ass!)))
  (dk-focus! st)
  (prep!)
  (let* ((ih (cdr (assq 'ih br)))
         (en (sl-E n)) (esn (sl-E `(succ ,n))) (sum `((ADD K) ,en (ONE K))))
    (if (and (pair? ih) (dk-asm? ih) (dk-head-is? ih 'AND)) (dk-split-all! (list ih)))
    (dk-chain-ass! (dk-cite! 'nv-domain-sub 'K sl-ZK en))
    (dk-chain-ass! (dk-cite! 'nf-one-in-carr 'K))
    (dk-have! `(IN (ONE ,sl-V) (CARR K)) (lambda () (subst `(= (ONE ,sl-V) (ONE K))) (dk-close-if-asm!)))
    (dk-have! `(= ,esn ,sum)
      (lambda ()
        (subst (dk-chain-ass! (dk-cite! 'zz-act-one-succ n sl-V)))
        (subst `(= (ADD ,sl-V) (ADD K)))
        (subst `(= (ONE K) (ONE ,sl-V)))
        (sl-rfl!)))
    (dk-chain-ass! (dk-cite! 'nv-domain-add 'K sl-ZK en '(ONE K)))
    (dk-have! `(IN ,esn ,sl-ZK) (lambda () (subst `(= ,esn ,sum)) (dk-close-if-asm!)))
    (dk-have! `(IN ,en (CARR ,sl-rr)) (lambda () (subst `(== (CARR ,sl-rr) ,sl-ZK)) (dk-close-if-asm!)))
    (dk-have! `(IN (ONE K) (CARR ,sl-rr)) (lambda () (subst `(== (CARR ,sl-rr) ,sl-ZK)) (dk-close-if-asm!)))
    (dk-have! `(= ,(sl-L `(succ ,n)) (CLASS ,sl-st ,esn))
      (lambda ()
        (subst `(= ,esn ,sum))
        (subst (dk-chain-ass! (dk-cite! 'zz-act-one-succ n sl-Q)))
        (subst `(= ,(sl-L n) (CLASS ,sl-st ,en)))
        (subst `(== (ONE ,sl-Q) (CLASS ,sl-st (ONE ,sl-rr))))
        (subst `(== (ONE ,sl-rr) (ONE K)))
        (subst (dk-chain-ass! (dk-cite! 'rq-add-computes sl-rr en '(ONE K))))
        (subst `(== (ADD ,sl-rr) ,sl-rslam))
        (subst (dk-chain-ass! (dk-cite! 'rs-add-val 'K sl-ZK en '(ONE K))))
        (sl-rfl!)))
    (dk-conj-close! (lambda () (dk-ass!)))))
(qed 'nv-residue-zz-act-one)

(define sl-res-p (lambda (p) `(ZZ-ACT (RING-ADDITIVE-AG ,sl-res) ,p (ONE ,sl-res))))
(sp (make-wff `(FORALL K (IMPLIES (IS-COMPACT-NV-DOMAIN K ,sl-ZK) (FORALL w (IMPLIES (IN w ,sl-ZK)
   (IMPLIES (= (NV-MAXIMAL K ,sl-ZK) (NV-PRINCIPAL K ,sl-ZK w)) (IMPLIES (NOT (= w (ZERO K)))
   (IMPLIES (FORALL p (NOT (HAS-CHARACTERISTIC ,sl-V p)))
     (IS-LOCAL-NV-FIELD (SUB-NF K ,sl-B)))))))))))
(dk-peel!)
(dk-chain-ass! (dk-cite! 'nv-compact-domain 'K sl-ZK))
(dk-chain-ass! (dk-cite! 'nv-domain-field 'K sl-ZK))
(dk-chain-ass! (dk-cite! 'nv-field-normed 'K))
(dk-chain-ass! (dk-cite! 'nv-integers-domain 'K))
(dk-split-all! (list (dk-chain-ass! (dk-cite! 'ccr-4-21-base 'K 'w))))
(dk-split-all! (list (dk-chain-ass! (dk-cite! 'ccr-2-7 'K sl-ZK))))
(let* ((h0 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'HAS-CHARACTERISTIC))) "characteristic 0"))
       (ex (dk-chain-ass! (dk-cite! 'finite-field-characteristic sl-res)))
       (p (dk-skolem! ex #t)))
  (dk-iff-fwd! (dk-cite! 'has-characteristic sl-res p))
  (dk-iff-fwd! (dk-cite! 'is-prime-nat p))
  (dk-split-all! (list (dk-chain-ass! (dk-cite! 'nv-residue-zz-act-one p 'K))))
  (let* ((ep (sl-E p)) (np `((FNRM K) ,ep)) (d `((ADD K) ,ep ((NEG K) (ZERO K)))))
    (dk-cite! 'nv-residue-unfold 'K sl-ZK)
    (dk-cite! 'nv-residue-zero-class 'K)
    (dk-have! `(= (CLASS ,sl-st ,ep) (CLASS ,sl-st (ZERO K)))
      (lambda ()
        (subst `(= (CLASS ,sl-st ,ep) ,(sl-L p)))
        (subst `(= (CLASS ,sl-st (ZERO K)) (ZERO ,sl-res)))
        (subst `(= ,sl-Q ,sl-res))
        (dk-close-if-asm!)))
    (dk-chain-ass! (dk-cite! 'nv-domain-zero 'K sl-ZK))
    (dk-iff-fwd! (dk-chain-ass! (dk-cite! 'rs-class-eq-iff 'K sl-ZK ep '(ZERO K))))
    (dk-cite! 'nv-maximal-norm 'K sl-ZK d)
    ;; p.1 - 0 = p.1
    (dk-chain-ass! (dk-cite! 'nv-domain-sub 'K sl-ZK ep))
    (dk-chain-ass! (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K))
    (for-each (lambda (r) (dk-cite! r 'K))
              '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-neg normed-field-ring-view-zero))
    (dk-have! `(IN ,ep (CARR ,sl-V)) (lambda () (subst `(= (CARR ,sl-V) (CARR K))) (dk-close-if-asm!)))
    (dk-have! `(= ,d ,ep)
      (lambda ()
        (subst `(= (ADD K) (ADD ,sl-V)))
        (subst `(= (NEG K) (NEG ,sl-V)))
        (subst `(= (ZERO K) (ZERO ,sl-V)))
        (crs)))
    (dk-rewrite-h! `(< ((FNRM K) ,d) 1) d ep)
    ;; p.1 /= 0
    (dk-have! `(NOT (= ,ep (ZERO K)))
      (lambda ()
        (di)
        (let ((iff (dk-cite! 'has-characteristic sl-V p)))
          (dk-have! (caddr iff)
            (lambda () (subst `(= (ZERO ,sl-V) (ZERO K))) (dk-conj-close! (lambda () (dk-ass!)))))
          (ai iff)
          (detach! `(IMPLIES ,(caddr iff) ,(cadr iff)))
          (dk-apply! h0 p)
          (ai `(NOT ,(cadr iff))))))
    ;; 0 < |p.1|
    (dk-cite! 'nf-norm-in-rr 'K ep)
    (dk-cite! 'nf-norm-nonneg 'K ep)
    (dk-have! `(NOT (= 0 ,np))
      (lambda ()
        (di)
        (let ((iff (dk-cite! 'nf-norm-zero-iff 'K ep)))
          (dk-have! `(= ,np 0) (lambda () (subst `(= ,np 0)) (rfl)))
          (dk-have! `(= ,ep (ZERO K)) (lambda () (ai iff) (detach! `(IMPLIES (= ,np 0) (= ,ep (ZERO K)))) (dk-ass!)))
          (ai `(NOT (= ,ep (ZERO K)))))))
    (dk-have-and! `(<= 0 ,np) `(NOT (= 0 ,np)))
    (dk-cite! 'rr-le-ne-lt 0 np)
    ;; p.1 lies in B(K)
    (dk-chain-ass! (dk-cite! 'nf-subfield-zz-act-one p 'K sl-B))
    (dk-chain-ass! (dk-cite! 'sub-nf-local 'K sl-B ep))
    (dk-close-if-asm!)))
(qed 'ccr-4-21-char-0)
