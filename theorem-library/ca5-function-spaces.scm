;;; ca5-function-spaces.scm -- CHAPTER 5 OF THE COMPLEX ANALYSIS NOTES (FUNCTION SPACES),
;;; FIRST PART: the exhaustion of an open subset of CC by compact sets (Lemma 5.1),
;;; the sup seminorms on it, and the topology of Proposition 5.2.
;;; Agent CA-5, 2026-10-14.  Vocabulary: structure-library/ca5-function-spaces.scm
;;; (CC-EXHAUST); UNIF-ON-COMPACTA is CA-AC's (structure-library/ca-ac-vocab.scm).
;;;
;;; CONTENTS.  For u open in CC and K_n = CC-EXHAUST(u, n):
;;;   cc-exhaust-subset, -interior, -mono, -covers, -compact, -limit-in   the exhaustion
;;;   cc-exhaust-exhaustive        Lemma 5.1: a compact subset of u lies in some K_n
;;;   cc-bolzano-weierstrass       a bounded sequence of CC has a convergent subsequence
;;;   cc-continuous-bounded-on-exhaust, cc-sup-norm-upper, cc-exhaust-seminorm-real
;;;                                the seminorms p_n(f) = CC-SUP-NORM(f, K_n) are real
;;;   cc-exhaust-uniform-iff-compacta   Prop 5.2 (topology): uniform convergence on every
;;;                                K_n iff UNIF-ON-COMPACTA
;;;   plumbing: cc-exhaust-unfold, -membership, -radius, -radius-decrease, cc-ms-ball-membership,
;;;   cc-ms-ball-centre, cc-ms-ball-mono, cc-magnitude-sub-chain, not-subset-witness.
;;; NOTHING asserted.  Every qed modulo 0 (probe worker-06, R4 keep-going band, 2026-10-14).
;;; LOAD WINDOW: lo = after theorem-library/goursat (load.scm:3625, cc-open-subset-cc) and
;;; after structure-library/ca-ac-vocab (UNIF-ON-COMPACTA, not yet wired); the other
;;; citations load earlier (riesz-markov-model 2959 rmm-nn-choice, holomorphic-basics 2964,
;;; rake-bolzano-weierstrass-2 3145, cc-power-series-laws 3573).  hi: none.
;;; Library: complex-analysis.  Tactics: the early kit, pbc, use-em, prop.  Helper prefix ca5-.
;;; ======================================================================
;;; local helpers
;;; ======================================================================
(define (ca5-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (ca5-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC)))
      (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
;; t in RR / CC, by the planner unless in context
(define (ca5-rr! t) (dk-type! t 'RR))
(define (ca5-cc! t) (dk-type! t 'CC))
;;; ======================================================================
;;; (0) the unfold equation and the membership read-off of CC-EXHAUST
;;; ======================================================================
(sp (make-wff '(FORALL u (FORALL n
   (== (CC-EXHAUST u n)
       (SEP cxz_ CC (AND (<= (magnitude cxz_) n)
                         (SUBSET (BALL CC-MS cxz_ (recip (+ n 1))) u))))))))
(di) (mac 'CC-EXHAUST) (qrfl)
(qed 'cc-exhaust-unfold)
(topic! 'cc-exhaust-unfold 'plumbing)

(sp (make-wff '(FORALL u (FORALL n (FORALL z
   (IFF (IN z (CC-EXHAUST u n))
        (AND (IN z CC)
             (AND (<= (magnitude z) n)
                  (SUBSET (BALL CC-MS z (recip (+ n 1))) u)))))))))
(di)
(dk-iff! (dk-head? 'AND)
  (lambda ()
    (mac-h 'cc-exhaust-unfold '(IN z (CC-EXHAUST u n)))
    (sep-me '(IN z (SEP cxz_ CC (AND (<= (magnitude cxz_) n)
                                     (SUBSET (BALL CC-MS cxz_ (recip (+ n 1))) u)))))
    (prop))
  (lambda ()
    (dk-split-all!)
    (mac 'CC-EXHAUST)
    (in-sep! (lambda () (ass)) (lambda () (dk-conj-close!)))))
(qed 'cc-exhaust-membership)
(topic! 'cc-exhaust-membership 'analysis)

;;; ======================================================================
;;; (1) the open ball of CC-MS, read in moduli
;;; ======================================================================
(sp (make-wff '(FORALL c (IMPLIES (IN c CC) (FORALL r (IMPLIES (IN r RR) (FORALL y
   (IFF (IN y (BALL CC-MS c r))
        (AND (IN y CC) (< (magnitude (- y c)) r))))))))))
(dk-peel!)
(ca5-pts-cc!)
(fact 'cc-is-metric-space)
(define (ca5-dist-eq!)        ; y in CC in context: dist(c, y) = |y - c|
  (fact 'cc-ms-dist 'c 'y)
  (fact 'cc-magnitude-sub-sym 'c 'y)
  (ca5-cc! '(- c y)) (ca5-cc! '(- y c))
  (fact 'cc-magnitude-closed '(- c y))
  (fact 'cc-magnitude-closed '(- y c))
  (dk-have! '(= ((DIST CC-MS) c y) (magnitude (- y c)))
    (lambda () (subst '(= ((DIST CC-MS) c y) (magnitude (- c y)))) (ass))))
(dk-iff! (dk-head? 'AND)
  (lambda ()
    (mac-h 'ball-membership '(IN y (BALL CC-MS c r)))
    (dk-split-all!)
    (dk-have! '(IN y CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass)))
    (ca5-dist-eq!)
    (dk-rewrite-h! '(<= ((DIST CC-MS) c y) r) '((DIST CC-MS) c y) '(magnitude (- y c)))
    (dk-rewrite-h! '(NOT (= ((DIST CC-MS) c y) r)) '((DIST CC-MS) c y) '(magnitude (- y c)))
    (dk-have! '(AND (<= (magnitude (- y c)) r) (NOT (= (magnitude (- y c)) r))) (lambda () (dk-conj-close!)))
    (fact 'rr-le-ne-lt '(magnitude (- y c)) 'r)
    (dk-conj-close!))
  (lambda ()
    (dk-split-all!)
    (ca5-dist-eq!)
    (mac 'ball-membership)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond ((dk-asm? g) (ass))
                ((eq? (car g) 'IN) (subst '(= (PTS CC-MS) CC)) (ass))
                ((eq? (car g) '<=)
                 (subst '(= ((DIST CC-MS) c y) (magnitude (- y c))))
                 (dk-ineq! '(< (magnitude (- y c)) r)))
                (#t
                 (subst '(= ((DIST CC-MS) c y) (magnitude (- y c))))
                 (di)
                 (dk-absurd! '(= (magnitude (- y c)) r) '(< (magnitude (- y c)) r)))))))))
(qed 'cc-ms-ball-membership)
(topic! 'cc-ms-ball-membership 'analysis)

;;; ======================================================================
;;; (2) the radius 1/(n+1)
;;; ======================================================================
(sp (make-wff '(FORALL n (IMPLIES (IN n NN)
   (AND (IN (recip (+ n 1)) RR) (< 0 (recip (+ n 1))))))))
(dk-peel!)
(fact 'nn-in-rr 'n)
(fact 'nn-zero-le 'n)
(fact 'rr-one-in)
(fact 'rr-add-in-rr 'n 1)
(dk-have! '(< 0 (+ n 1)) (lambda () (dk-ineq! '(<= 0 n))))
(dk-have! '(NOT (= (+ n 1) 0)) (lambda () (di) (dk-absurd! '(= (+ n 1) 0) '(< 0 (+ n 1)))))
(dk-have! '(AND (IN (+ n 1) RR) (NOT (= (+ n 1) 0))) (lambda () (dk-conj-close!)))
(fact 'rr-recip-closed '(+ n 1))
(fact 'rr-recip-pos '(+ n 1))
(dk-conj-close!)
(qed 'cc-exhaust-radius)
(topic! 'cc-exhaust-radius 'plumbing)

;;; ======================================================================
;;; (3) K_n lies in u
;;; ======================================================================
(sp (make-wff '(FORALL u (FORALL n (IMPLIES (IN n NN) (SUBSET (CC-EXHAUST u n) u))))))
(dk-peel!)
(let ((z (subset-by-element!)))
  (mac-h 'cc-exhaust-membership (list 'IN z '(CC-EXHAUST u n)))
  (dk-split-all!)
  (dk-split-all! (list (dk-cite! 'cc-exhaust-radius 'n)))
  (let ((rad '(recip (+ n 1))))
    (fact 'cc-sub-in-cc z z)
    (dk-have! (list '= (list 'magnitude (list '- z z)) 0)
      (lambda ()
        (dk-have! (list '= (list '- z z) 0) (lambda () (crs)))
        (subst (list '= (list '- z z) 0))
        (fact 'cc-magnitude-zero) (ass)))
    (dk-have! (list 'IN z (list 'BALL 'CC-MS z rad))
      (lambda ()
        (dk-split-all! (list (dk-cite! 'cc-ms-ball-membership z rad z)))
        (dk-have! (list '< (list 'magnitude (list '- z z)) rad)
          (lambda () (subst (list '= (list 'magnitude (list '- z z)) 0)) (ass)))
        (dk-have! (list 'AND (list 'IN z 'CC) (list '< (list 'magnitude (list '- z z)) rad))
          (lambda () (dk-conj-close!)))
        (prop)))
    (fact 'subset-mem-fwd (list 'BALL 'CC-MS z rad) 'u z)
    (ass)))
(qed 'cc-exhaust-subset)
(topic! 'cc-exhaust-subset 'analysis)
;;; ======================================================================
;;; (4) the triangle inequality for differences, and the strict decrease of the radii
;;; ======================================================================
(define (ca5-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close!))))
    f))
(sp (make-wff '(FORALL a (IMPLIES (IN a CC) (FORALL b (IMPLIES (IN b CC) (FORALL c (IMPLIES (IN c CC)
   (<= (magnitude (- a c)) (+ (magnitude (- a b)) (magnitude (- b c))))))))))))
(dk-peel!)
(fact 'cc-sub-in-cc 'a 'b) (fact 'cc-sub-in-cc 'b 'c) (fact 'cc-sub-in-cc 'a 'c)
(ca5-and! '(IN (- a b) CC) '(IN (- b c) CC))
(fact 'cc-add-closed '(- a b) '(- b c))
(dk-have! '(= (- a c) (+ (- a b) (- b c))) (lambda () (crs)))
(subst '(= (- a c) (+ (- a b) (- b c))))
(fact 'cc-magnitude-triangle '(- a b) '(- b c))
(ass)
(qed 'cc-magnitude-sub-chain)
(topic! 'cc-magnitude-sub-chain 'analysis)

(sp (make-wff '(FORALL n (IMPLIES (IN n NN)
   (AND (< (recip (+ (+ n 1) 1)) (recip (+ n 1))) (<= (recip (+ n 1)) 1))))))
(dk-peel!)
(let ((a '(+ n 1)) (b '(+ (+ n 1) 1)))
  (fact 'nn-in-rr 'n)
  (fact 'nn-zero-le 'n)
  (fact 'rr-one-in)
  (fact 'rr-add-in-rr 'n 1)
  (fact 'rr-add-in-rr a 1)
  (dk-have! (list '< 0 a) (lambda () (dk-ineq! '(<= 0 n))))
  (dk-have! (list '< 0 b) (lambda () (dk-ineq! '(<= 0 n))))
  (dk-have! (list '<= a b) (lambda () (dk-ineq!)))
  (dk-have! (list '<= 1 a) (lambda () (dk-ineq! '(<= 0 n))))
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (dk-cite! 'rr-recip-antitone a b)
  (dk-cite! 'rr-recip-antitone 1 a)
  (fact 'rr-recip-one)
  (dk-split-all! (list (dk-cite! 'cc-exhaust-radius 'n)))
  (fact 'nn-one-in)
  (ca5-and! '(IN n NN) '(IN 1 NN))
  (fact 'nn-add-closed 'n 1)
  (dk-split-all! (list (dk-cite! 'cc-exhaust-radius a)))
  (dk-cite! 'rr-recip-recip-pos a)
  (dk-cite! 'rr-recip-recip-pos b)
  (dk-rewrite-h! (list '<= (list 'recip a) '(recip 1)) '(recip 1) 1)
  (dk-have! (list 'NOT (list '= (list 'recip b) (list 'recip a)))
    (lambda ()
      (di)
      (dk-have! (list '= b a)
        (lambda ()
          (subst (list '= b (list 'recip (list 'recip b))))
          (subst (list '= (list 'recip b) (list 'recip a)))
          (ass)))
      (dk-absurd! (list '= b a))))
  (ca5-and! (list '<= (list 'recip b) (list 'recip a)) (list 'NOT (list '= (list 'recip b) (list 'recip a))))
  (fact 'rr-le-ne-lt (list 'recip b) (list 'recip a))
  (dk-conj-close!))
(qed 'cc-exhaust-radius-decrease)
(topic! 'cc-exhaust-radius-decrease 'plumbing)
;;; ======================================================================
;;; (5) the centre is in its ball; K_n lies in the interior of K_{n+1}
;;; ======================================================================
(define (ca5-mag! t) (ca5-cc! t) (fact 'cc-magnitude-closed t) (list 'magnitude t))
;; (IN y CC) and (< |y - c| r) in context, c in CC, r in RR: land y in BALL(CC-MS, c, r)
(define (ca5-in-ball! y c r)
  (let ((goal (list 'IN y (list 'BALL 'CC-MS c r))))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (dk-split-all! (list (dk-cite! 'cc-ms-ball-membership c r y)))
            (ca5-and! (list 'IN y 'CC) (list '< (list 'magnitude (list '- y c)) r))
            (prop))))
    goal))
;; y in BALL(CC-MS, c, r) in context: land (IN y CC) and (< |y - c| r)
(define (ca5-out-ball! y c r)
  (dk-split-all! (list (dk-cite! 'cc-ms-ball-membership c r y)))
  (let ((conj (list 'AND (list 'IN y 'CC) (list '< (list 'magnitude (list '- y c)) r))))
    (if (not (dk-asm? conj)) (dk-have! conj (lambda () (prop))))
    (dk-split-all! (list conj))
    (list '< (list 'magnitude (list '- y c)) r)))

(sp (make-wff '(FORALL c (IMPLIES (IN c CC) (FORALL r (IMPLIES (IN r RR) (IMPLIES (< 0 r)
   (IN c (BALL CC-MS c r)))))))))
(dk-peel!)
(fact 'cc-sub-in-cc 'c 'c)
(dk-have! '(= (magnitude (- c c)) 0)
  (lambda ()
    (dk-have! '(= (- c c) 0) (lambda () (crs)))
    (subst '(= (- c c) 0))
    (fact 'cc-magnitude-zero) (ass)))
(dk-have! '(< (magnitude (- c c)) r) (lambda () (subst '(= (magnitude (- c c)) 0)) (ass)))
(ca5-in-ball! 'c 'c 'r)
(ass)
(qed 'cc-ms-ball-centre)
(topic! 'cc-ms-ball-centre 'analysis)

(sp (make-wff '(FORALL u (FORALL n (IMPLIES (IN n NN)
   (SUBSET (CC-EXHAUST u n) (INTERIOR CC-MS (CC-EXHAUST u (+ n 1)))))))))
(dk-peel!)
(fact 'cc-is-metric-space)
(ca5-pts-cc!)
(let* ((z (subset-by-element!))
       (r1 '(recip (+ n 1))) (r2 '(recip (+ (+ n 1) 1)))
       (dl (list '- r1 r2))
       (n1 '(+ n 1))
       (k1 (list 'CC-EXHAUST 'u n1)))
  (mac-h 'cc-exhaust-membership (list 'IN z '(CC-EXHAUST u n)))
  (dk-split-all!)
  (fact 'nn-one-in)
  (ca5-and! '(IN n NN) '(IN 1 NN))
  (fact 'nn-add-closed 'n 1)
  (fact 'nn-in-rr 'n)
  (dk-split-all! (list (dk-cite! 'cc-exhaust-radius 'n)))
  (dk-split-all! (list (dk-cite! 'cc-exhaust-radius n1)))
  (dk-split-all! (list (dk-cite! 'cc-exhaust-radius-decrease 'n)))
  (fact 'rr-sub-in-rr r1 r2)
  (dk-have! (list '< 0 dl) (lambda () (dk-ineq! (list '< r2 r1))))
  (ca5-mag! z)
  ;; the ball B(z, dl) is open, contains z, and lies in K_{n+1}
  (dk-have! (list 'IN z '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
  (dk-have! (list 'AND (list 'IN dl 'RR) (list 'AND (list '<= 0 dl) (list 'NOT (list '= 0 dl))))
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (ass))
                  ((eq? (car g) '<=) (dk-ineq! (list '< 0 dl)))
                  (#t (di) (dk-absurd! (list '= 0 dl) (list '< 0 dl)))))))))
  (fact 'ball-is-open 'CC-MS z dl)
  (dk-cite! 'cc-ms-ball-centre z dl)
  (dk-have! (list 'SUBSET (list 'BALL 'CC-MS z dl) k1)
    (lambda ()
      (let* ((w (subset-by-element!)))
        (ca5-out-ball! w z dl)
        (ca5-mag! (list '- w z))
        (ca5-mag! w)
        ;; |w| <= |w - z| + |z|
        (ca5-cc! (list '- w z))
        (dk-have! (list '= w (list '+ (list '- w z) z)) (lambda () (crs)))
        (ca5-and! (list 'IN (list '- w z) 'CC) (list 'IN z 'CC))
        (fact 'cc-magnitude-triangle (list '- w z) z)
        (dk-rewrite-h! (list '<= (list 'magnitude (list '+ (list '- w z) z)) (list '+ (list 'magnitude (list '- w z)) (list 'magnitude z)))
                       (list '+ (list '- w z) z) w)
        (dk-have! (list '<= (list 'magnitude w) n1)
          (lambda () (dk-ineq! (list '<= (list 'magnitude w) (list '+ (list 'magnitude (list '- w z)) (list 'magnitude z)))
                               (list '< (list 'magnitude (list '- w z)) dl)
                               (list '<= r1 1) (list '< 0 r2) (list '<= (list 'magnitude z) 'n))))
        ;; B(w, r2) inside B(z, r1) inside u
        (dk-have! (list 'SUBSET (list 'BALL 'CC-MS w r2) 'u)
          (lambda ()
            (let ((y (subset-by-element!)))
              (ca5-out-ball! y w r2)
              (ca5-mag! (list '- y w))
              (ca5-mag! (list '- y z))
              (dk-cite! 'cc-magnitude-sub-chain y w z)
              (dk-have! (list '< (list 'magnitude (list '- y z)) r1)
                (lambda () (dk-ineq! (list '<= (list 'magnitude (list '- y z))
                                               (list '+ (list 'magnitude (list '- y w)) (list 'magnitude (list '- w z))))
                                     (list '< (list 'magnitude (list '- y w)) r2)
                                     (list '< (list 'magnitude (list '- w z)) dl))))
              (ca5-in-ball! y z r1)
              (fact 'subset-mem-fwd (list 'BALL 'CC-MS z r1) 'u y)
              (ass))))
        (dk-split-all! (list (dk-cite! 'cc-exhaust-membership 'u n1 w)))
        (dk-have! (list 'AND (list 'IN w 'CC)
                        (list 'AND (list '<= (list 'magnitude w) n1) (list 'SUBSET (list 'BALL 'CC-MS w r2) 'u)))
          (lambda () (dk-conj-close!)))
        (prop))))
  (fact 'interior-mem-intro 'CC-MS k1 (list 'BALL 'CC-MS z dl) z)
  (ass))
(qed 'cc-exhaust-interior)
(topic! 'cc-exhaust-interior 'analysis)
;;; ======================================================================
;;; (6) balls grow with the radius; K_n grows with n; every point of an open u is in some K_n
;;; ======================================================================
(sp (make-wff '(FORALL c (IMPLIES (IN c CC) (FORALL r (IMPLIES (IN r RR) (FORALL q (IMPLIES (IN q RR)
   (IMPLIES (<= r q) (SUBSET (BALL CC-MS c r) (BALL CC-MS c q)))))))))))
(dk-peel!)
(let ((y (subset-by-element!)))
  (ca5-out-ball! y 'c 'r)
  (ca5-mag! (list '- y 'c))
  (dk-have! (list '< (list 'magnitude (list '- y 'c)) 'q)
    (lambda () (dk-ineq! (list '< (list 'magnitude (list '- y 'c)) 'r) '(<= r q))))
  (ca5-in-ball! y 'c 'q)
  (ass))
(qed 'cc-ms-ball-mono)
(topic! 'cc-ms-ball-mono 'analysis)

(sp (make-wff '(FORALL u (FORALL a (IMPLIES (IN a NN) (FORALL b (IMPLIES (IN b NN)
   (IMPLIES (<= a b) (SUBSET (CC-EXHAUST u a) (CC-EXHAUST u b))))))))))
(dk-peel!)
(let ((z (subset-by-element!)) (ra '(recip (+ a 1))) (rb '(recip (+ b 1))))
  (mac-h 'cc-exhaust-membership (list 'IN z '(CC-EXHAUST u a)))
  (dk-split-all!)
  (fact 'nn-in-rr 'a) (fact 'nn-in-rr 'b) (fact 'nn-zero-le 'a)
  (fact 'rr-one-in)
  (fact 'rr-add-in-rr 'a 1) (fact 'rr-add-in-rr 'b 1)
  (dk-split-all! (list (dk-cite! 'cc-exhaust-radius 'a)))
  (dk-split-all! (list (dk-cite! 'cc-exhaust-radius 'b)))
  (dk-have! '(< 0 (+ a 1)) (lambda () (dk-ineq! '(<= 0 a))))
  (dk-have! '(<= (+ a 1) (+ b 1)) (lambda () (dk-ineq! '(<= a b))))
  (dk-cite! 'rr-recip-antitone '(+ a 1) '(+ b 1))
  (ca5-mag! z)
  (dk-have! (list '<= (list 'magnitude z) 'b) (lambda () (dk-ineq! (list '<= (list 'magnitude z) 'a) '(<= a b))))
  (dk-cite! 'cc-ms-ball-mono z rb ra)
  (fact 'subset-trans (list 'BALL 'CC-MS z rb) (list 'BALL 'CC-MS z ra) 'u)
  (dk-split-all! (list (dk-cite! 'cc-exhaust-membership 'u 'b z)))
  (dk-have! (list 'AND (list 'IN z 'CC)
                  (list 'AND (list '<= (list 'magnitude z) 'b) (list 'SUBSET (list 'BALL 'CC-MS z rb) 'u)))
    (lambda () (dk-conj-close!)))
  (prop))
(qed 'cc-exhaust-mono)
(topic! 'cc-exhaust-mono 'analysis)

(sp (make-wff '(FORALL u (IMPLIES (IS-OPEN CC-MS u) (FORALL z (IMPLIES (IN z u)
   (FORSOME n (AND (IN n NN) (IN z (CC-EXHAUST u n))))))))))
(dk-peel!)
(fact 'cc-is-metric-space)
(ca5-pts-cc!)
(let* ((oiff (dk-cite! 'is-open 'CC-MS 'u))
       (oball (let loop ((r (caddr oiff))) (if (eq? (car r) 'AND) (loop (caddr r)) r))))
  (dk-have! (caddr oiff) (lambda () (prop)))
  (dk-split-all! (list (caddr oiff)))
  (fact 'subset-mem-fwd 'u '(PTS CC-MS) 'z)
  (dk-have! '(IN z CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass)))
  (let ((rho (dk-skolem! (dk-apply! oball 'z))))
    (dk-split-all!)
    (fact 'rr-pos-rr-in-rr rho)
    (fact 'rr-lt-of-pos-rr rho)
    (dk-have! (list 'NOT (list '= rho 0)) (lambda () (di) (dk-absurd! (list '= rho 0) (list '< 0 rho))))
    (ca5-and! (list 'IN rho 'RR) (list 'NOT (list '= rho 0)))
    (fact 'rr-recip-closed rho)
    (ca5-mag! 'z)
    (let* ((n1 (dk-skolem! (dk-cite! 'nn-unbounded-in-rr '(magnitude z))))
           (_1 (dk-split-all!))
           (n2 (dk-skolem! (dk-cite! 'nn-unbounded-in-rr (list 'recip rho))))
           (_2 (dk-split-all!))
           (nsum (list '+ n1 n2)))
      (ca5-and! (list 'IN n1 'NN) (list 'IN n2 'NN))
      (fact 'nn-add-closed n1 n2)
      (fact 'nn-in-rr n1) (fact 'nn-in-rr n2) (fact 'nn-zero-le n1) (fact 'nn-zero-le n2)
      (fact 'nn-in-rr nsum)
      (fact 'rr-one-in)
      (fact 'rr-add-in-rr nsum 1)
      (dk-have! (list '< (list 'recip rho) (list '+ nsum 1))
        (lambda () (dk-ineq! (list '< (list 'recip rho) n2) (list '<= 0 n1))))
      (dk-cite! 'nn-recip-succ-small-at rho nsum)
      (dk-split-all! (list (dk-cite! 'cc-exhaust-radius nsum)))
      (dk-have! (list '<= (list 'recip (list '+ nsum 1)) rho)
        (lambda () (dk-ineq! (list '< (list 'recip (list '+ nsum 1)) rho))))
      (dk-cite! 'cc-ms-ball-mono 'z (list 'recip (list '+ nsum 1)) rho)
      (fact 'subset-trans (list 'BALL 'CC-MS 'z (list 'recip (list '+ nsum 1))) (list 'BALL 'CC-MS 'z rho) 'u)
      (dk-have! (list '<= '(magnitude z) nsum) (lambda () (dk-ineq! (list '< '(magnitude z) n1) (list '<= 0 n2))))
      (ew nsum)
      (dk-split-all! (list (dk-cite! 'cc-exhaust-membership 'u nsum 'z)))
      (dk-have! (list 'AND '(IN z CC)
                      (list 'AND (list '<= '(magnitude z) nsum)
                            (list 'SUBSET (list 'BALL 'CC-MS 'z (list 'recip (list '+ nsum 1))) 'u)))
        (lambda () (dk-conj-close!)))
      (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (prop)))))))
