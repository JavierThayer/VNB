;;; countable choice through rmm-nn-choice (riesz-markov-model.scm), the driver copied
;;; from rmm-choose-seq! / rmm-seq-at! there
(define ca5-seq-family '())
(define (ca5-choose-seq! A Pf witness-of)
  (let* ((L   (list 'VNB-LAMBDA 'ca5k_ 'NN (list 'SEP 'ca5w_ A (Pf 'ca5k_ 'ca5w_))))
         (inh (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
                (list 'FORSOME 'w (list 'AND (list 'IN 'w A) (list 'IN 'w (list L 'k))))))))
    (dk-have! inh
      (lambda ()
        (let* ((k (dk-di-var!)))
          (dk-lam-b!)
          (let ((w (witness-of k)))
            (ew w)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (caddr (dk-goal)) 'SEP)
                    (dk-close-all! (lambda () (sep-mi)))
                    (ass))))))))
    (let ((g (dk-skolem! (dk-cite! 'rmm-nn-choice A L))))
      (set! ca5-seq-family (cons (cons g L) ca5-seq-family))
      g)))
(define (ca5-seq-at! g k)
  (let* ((L  (cdr (assq g ca5-seq-family)))
         (cl (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IN (list g 'k) (list L 'k))))))
         (h  (dk-apply! (or cl (error "ca5-seq-at!: the choice clause is not in context" g)) k)))
    (dk-lam-b-h! h)
    (let ((m (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list g k))
                                       (dk-head-is? (caddr f) 'SEP)))
                      "the chosen membership")))
      (dk-split-all! (dk-landed (lambda () (sep-me m)))))))

(define ca5-P '(FORSOME n (AND (IN n NN) (SUBSET cmp (CC-EXHAUST u n)))))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u)
   (list 'FORALL 'cmp (list 'IMPLIES '(SUBSET cmp u)
     (list 'IMPLIES '(IS-COMPACT (SUBSPACE-MS CC-MS cmp)) ca5-P)))))))
(dk-peel!)
(fact 'cc-is-metric-space)
(ca5-pts-cc!)
(fact 'cc-open-subset-cc 'u)
(dk-split-all! (list (dk-cite! 'cc-ms-open-iff 'u)))
(dk-have! '(IS-OPEN CC-MS u) (lambda () (prop)))
(fact 'subset-trans 'cmp 'u 'CC)
(dk-have! '(SUBSET cmp (PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
(dk-have! '(IN cmp SET) (lambda () (dk-sethood! 'cmp)))
(fact 'subspace-is-metric-space 'CC-MS 'cmp)
(use-em ca5-P
  (lambda () (ass))
  (lambda ()
    (let* ((sub '(SUBSPACE-MS CC-MS cmp))
           (g (ca5-choose-seq! 'cmp
                (lambda (k w) (list 'NOT (list 'IN w (list 'CC-EXHAUST 'u k))))
                (lambda (k)
                  (dk-have! (list 'NOT (list 'SUBSET 'cmp (list 'CC-EXHAUST 'u k)))
                    (lambda ()
                      (di)
                      (dk-have! ca5-P (lambda () (ew k) (dk-conj-close!)))
                      (ai (or (dk-ctx-form (list 'NOT ca5-P)) (error "ca5: no NOT P in context")))))
                  (let ((w (dk-skolem! (dk-cite! 'not-subset-witness 'cmp (list 'CC-EXHAUST 'u k)))))
                    (dk-split-all!)
                    w)))))
      (fact 'subspace-pts 'CC-MS 'cmp)
      (dk-have! (list 'IN g (list 'FUN 'NN (list 'PTS sub)))
        (lambda () (subst (list '== (list 'PTS sub) 'cmp)) (ass)))
      (let* ((ciff (dk-cite! 'compact-iff-cluster-point sub))
             (call (caddr ciff)))
        (dk-have! call (lambda () (prop)))
        (let* ((x (dk-skolem! (dk-apply! call g)))
               (cpiff (dk-cite! 'cluster-point sub g x)))
          (dk-have! (caddr cpiff) (lambda () (prop)))
          (dk-split-all! (list (caddr cpiff)))
          (dk-have! (list 'IN x 'cmp) (lambda () (subst (list '== 'cmp (list 'PTS sub))) (ass)))
          (fact 'subset-mem-fwd 'cmp 'u x)
          (fact 'subset-mem-fwd 'cmp 'CC x)
          (let* ((m (dk-skolem! (dk-cite! 'cc-exhaust-covers 'u x)))
                 (_1 (dk-split-all!))
                 (m1 (list '+ m 1))
                 (km1 (list 'CC-EXHAUST 'u m1)))
            (dk-cite! 'cc-exhaust-interior 'u m)
            (fact 'subset-mem-fwd (list 'CC-EXHAUST 'u m) (list 'INTERIOR 'CC-MS km1) x)
            (let* ((imiff (dk-cite! 'interior-membership 'CC-MS km1 x))
                   (iex (caddr (caddr imiff))))
              (dk-have! iex (lambda () (prop)))
              (let* ((v (dk-skolem! iex))
                     (_2 (dk-split-all!))
                     (oiff (dk-cite! 'is-open 'CC-MS v))
                     (oball (let loop ((r (caddr oiff))) (if (eq? (car r) 'AND) (loop (caddr r)) r))))
                (dk-have! oball (lambda () (prop)))
                (let* ((rho (dk-skolem! (dk-apply! oball x)))
                       (_3 (dk-split-all!))
                       (clu (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(DIST (SUBSPACE-MS CC-MS cmp)))))
                                     "the cluster clause")))
                  (fact 'nn-one-in)
                  (ca5-and! (list 'IN m 'NN) '(IN 1 NN))
                  (fact 'nn-add-closed m 1)
                  (let* ((j (dk-skolem! (dk-apply! clu rho m1)))
                         (_4 (dk-split-all!))
                         (gj (list g j)))
                    (fact 'fun-apply-type-c g 'NN 'cmp j)
                    (fact 'subset-mem-fwd 'cmp 'CC gj)
                    (fact 'subspace-dist 'CC-MS 'cmp gj x)
                    (fact 'cc-ms-dist gj x)
                    (let ((dsub (list (list 'DIST sub) gj x)))
                      (dk-rewrite-h! (list '< dsub rho) dsub (list (list 'DIST 'CC-MS) gj x))
                      (dk-rewrite-h! (list '< (list (list 'DIST 'CC-MS) gj x) rho)
                                     (list (list 'DIST 'CC-MS) gj x) (list 'magnitude (list '- gj x))))
                    (fact 'rr-pos-rr-in-rr rho)
                    (ca5-in-ball! gj x rho)
                    (fact 'subset-mem-fwd (list 'BALL 'CC-MS x rho) v gj)
                    (fact 'subset-mem-fwd v km1 gj)
                    (dk-cite! 'cc-exhaust-mono 'u m1 j)
                    (fact 'subset-mem-fwd km1 (list 'CC-EXHAUST 'u j) gj)
                    (ca5-seq-at! g j)
                    (dk-only! (list 'IN gj (list 'CC-EXHAUST 'u j)) (list 'NOT (list 'IN gj (list 'CC-EXHAUST 'u j))))
                    (prop)))))))))))
(qed 'cc-exhaust-exhaustive)
(topic! 'cc-exhaust-exhaustive 'analysis)
;;; ======================================================================
;;; (8) Bolzano-Weierstrass in CC: a bounded sequence has a convergent subsequence
;;;     (real parts, then imaginary parts, by bounded-block-converges; the common
;;;     block enumerated by subsequence-capture; coord-block-estimate twice;
;;;     cc-converges-of-coords)
;;; ======================================================================
(define (ca5-sm-fun! phi b)   ; phi in FUN(NN, b), b in INF-SUBSETS(NN): land STRICTLY-MONO-NN(phi) from the capture clause
  (let* ((miff (dk-cite! 'inf-subsets-membership 'NN b)))
    (dk-have! (list 'SUBSET b 'NN) (lambda () (prop)))
    (fact 'fun-codomain-superset phi 'NN b 'NN)
    (let* ((smiff (dk-cite! 'strictly-mono-nn phi))
           (rhs (caddr smiff)))
      (dk-have! rhs (lambda () (dk-conj-close! (lambda () (ass)))))
      (dk-have! (list 'STRICTLY-MONO-NN phi) (lambda () (prop))))))

(define (ca5-tail! phi b2 b)
  (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'IMPLIES '(<= 0 j) (list 'IN (list phi 'j) b))))
    (lambda ()
      (let ((j (dk-di-var!)))
        (di)
        (fact 'fun-apply-type-c phi 'NN b2 j)
        (if (not (eq? b b2)) (fact 'subset-mem-fwd b2 b (list phi j)))
        (ass)))))
(define (ca5-subfun! phi f ms C)
  (dk-have! (list 'IN f (list 'FUN 'NN (list 'PTS ms))) (lambda () (subst (list '== (list 'PTS ms) C)) (ass)))
  (ca5-and! (list 'IN f (list 'FUN 'NN (list 'PTS ms))) (list 'STRICTLY-MONO-NN phi))
  (fact 'subseq-is-fun ms f phi)
  (dk-have! (list 'IN (list 'SUBSEQ f phi) (list 'FUN 'NN C))
    (lambda () (subst (list '== C (list 'PTS ms))) (ass))))
(define (ca5-ptwise! phi part co)
  (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
              (list '= (list part (list (list 'SUBSEQ 'h phi) 'n_)) (list (list 'SUBSEQ co phi) 'n_))))
    (lambda ()
      (let ((n (dk-di-var!)))
        (fact 'fun-apply-type-c phi 'NN 'NN n)
        (fact 'subseq-apply 'h phi n)
        (fact 'subseq-apply co phi n)
        (subst (list '== (list (list 'SUBSEQ 'h phi) n) (list 'h (list phi n))))
        (subst (list '== (list (list 'SUBSEQ co phi) n) (list co (list phi n))))
        (dk-lam-b!)
        (fact 'fun-apply-type-c 'h 'NN 'CC (list phi n))
        (fact (if (eq? part 'real-part) 'real-part-in-rr 'imag-part-in-rr) (list 'h (list phi n)))
        (rfl)))))

(sp (make-wff '(FORALL h (IMPLIES (IN h (FUN NN CC)) (FORALL bd (IMPLIES (IN bd RR)
   (IMPLIES (FORALL i (IMPLIES (IN i NN) (<= (magnitude (h i)) bd)))
     (FORSOME phi (AND (STRICTLY-MONO-NN phi)
       (FORSOME l (AND (IN l CC) (CONVERGES-TO CC-MS (SUBSEQ h phi) l))))))))))))
(dk-peel!)
(define ca5-bnd (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'bd))) "the bound"))
(define ca5-re '(VNB-LAMBDA cbi_ NN (real-part (h cbi_))))
(define ca5-im '(VNB-LAMBDA cbi_ NN (imag-part (h cbi_))))
(define (ca5-coord! part co lemma)    ; type the coordinate sequence and bound it
  (dk-have! (list 'IN co '(FUN NN RR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((i (dk-di-var!)))
            (fact 'fun-apply-type-c 'h 'NN 'CC i)
            (fact (if (eq? part 'real-part) 'real-part-in-rr 'imag-part-in-rr) (list 'h i))
            (ass))))))
  (dk-have! (list 'FORALL 'iqv_ (list 'IMPLIES '(IN iqv_ NN) (list '<= (list 'abs (list co 'iqv_)) 'bd)))
    (lambda ()
      (let ((i (dk-di-var!)))
        (dk-lam-b!)
        (fact 'fun-apply-type-c 'h 'NN 'CC i)
        (fact lemma (list 'h i))
        (fact 'cc-magnitude-closed (list 'h i))
        (fact (if (eq? part 'real-part) 'real-part-in-rr 'imag-part-in-rr) (list 'h i))
        (dk-apply! ca5-bnd i)
        (dk-ineq! (list '<= (list 'abs (list part (list 'h i))) (list 'magnitude (list 'h i)))
                  (list '<= (list 'magnitude (list 'h i)) 'bd))))))
(ca5-coord! 'real-part ca5-re 'cc-abs-re-le-magnitude)
(ca5-coord! 'imag-part ca5-im 'cc-abs-im-le-magnitude)
(fact 'nn-in-inf-subsets)
(define (ca5-block! co j)     ; a block b subset j and a point p with co converging along b to p; returns (b . p)
  (let* ((bb (dk-cite! 'bounded-block-converges co 'bd))
         (b (dk-skolem! (dk-apply! bb j))))
    (dk-split-all!)
    (let* ((pe (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f b) (dk-contains? f 'CONVERGES-ALONG)))
                        "the block limit"))
           (p (dk-skolem! pe)))
      (dk-split-all!)
      (cons b p))))
(let* ((bp1 (ca5-block! ca5-re 'NN)) (b1 (car bp1)) (p1 (cdr bp1))
       (bp2 (ca5-block! ca5-im b1)) (b2 (car bp2)) (p2 (cdr bp2))
       (phi (dk-skolem! (dk-cite! 'subsequence-capture b2)))
       (_1 (dk-split-all!))
       (lv (list '+ p1 (list '* p2 '+i))))
  (ca5-sm-fun! phi b2)
  (fact 'nn-zero-in)
  (ca5-tail! phi b2 b1) (ca5-tail! phi b2 b2)
  (dk-cite! 'coord-block-estimate 'RR-MS ca5-re b1 p1 phi 0)
  (dk-cite! 'coord-block-estimate 'RR-MS ca5-im b2 p2 phi 0)
  ;; the limit and its coordinates
  (fact 'rr-subset-cc p1) (fact 'rr-subset-cc p2)
  (fact 'cc-i-in)
  (ca5-and! (list 'IN p2 'CC) '(IN +i CC))
  (fact 'cc-mul-closed p2 '+i)
  (ca5-and! (list 'IN p1 'CC) (list 'IN (list '* p2 '+i) 'CC))
  (fact 'cc-add-closed p1 (list '* p2 '+i))
  (dk-have! (list '= lv lv) (lambda () (rfl)))
  (dk-split-all! (list (dk-cite! 'cc-re-im-of lv p1 p2)))
  ;; the three subsequences are sequences of the right kind
  (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
  (dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl)))
  (ca5-subfun! phi 'h 'CC-MS 'CC)
  (ca5-subfun! phi ca5-re 'RR-MS 'RR)
  (ca5-subfun! phi ca5-im 'RR-MS 'RR)
  (ca5-ptwise! phi 'real-part ca5-re)
  (ca5-ptwise! phi 'imag-part ca5-im)
  (dk-have! (list 'CONVERGES-TO 'RR-MS (list 'SUBSEQ ca5-re phi) (list 'real-part lv))
    (lambda () (subst (list '= (list 'real-part lv) p1)) (ass)))
  (dk-have! (list 'CONVERGES-TO 'RR-MS (list 'SUBSEQ ca5-im phi) (list 'imag-part lv))
    (lambda () (subst (list '= (list 'imag-part lv) p2)) (ass)))
  (dk-cite! 'cc-converges-of-coords (list 'SUBSEQ 'h phi) (list 'SUBSEQ ca5-re phi) (list 'SUBSEQ ca5-im phi) lv)
  (ew phi)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORSOME)
          (begin (ew lv) (dk-conj-close! (lambda () (ass))))
          (ass)))))
(qed 'cc-bolzano-weierstrass)
(topic! 'cc-bolzano-weierstrass 'analysis)
;;; ======================================================================
;;; (9) K_n is closed under limits in CC, and compact
;;; ======================================================================
(define (ca5-kn-parts! kn-u kn-n z)    ; z in CC-EXHAUST(u, n) in context: land its three parts
  (dk-split-all! (list (dk-cite! 'cc-exhaust-membership kn-u kn-n z)))
  (let ((conj (list 'AND (list 'IN z 'CC)
                    (list 'AND (list '<= (list 'magnitude z) kn-n)
                          (list 'SUBSET (list 'BALL 'CC-MS z (list 'recip (list '+ kn-n 1))) kn-u)))))
    (if (not (dk-asm? conj)) (dk-have! conj (lambda () (prop))))
    (dk-split-all! (list conj))))

(sp (make-wff '(FORALL u (FORALL n (IMPLIES (IN n NN)
   (FORALL s (IMPLIES (IN s (FUN NN CC)) (FORALL l (IMPLIES (IN l CC)
     (IMPLIES (FORALL i (IMPLIES (IN i NN) (IN (s i) (CC-EXHAUST u n))))
       (IMPLIES (CONVERGES-TO CC-MS s l) (IN l (CC-EXHAUST u n)))))))))))))
(dk-peel!)
(fact 'cc-is-metric-space)
(ca5-pts-cc!)
(define ca5-inK (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'CC-EXHAUST))) "the membership clause"))
(let ((r '(recip (+ n 1))))
  (fact 'nn-in-rr 'n)
  (dk-split-all! (list (dk-cite! 'cc-exhaust-radius 'n)))
  (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) '(<= (magnitude (s n_)) n)))
    (lambda ()
      (let ((i (dk-di-var!)))
        (dk-apply! ca5-inK i)
        (ca5-kn-parts! 'u 'n (list 's i))
        (ass))))
  (dk-cite! 'cc-limit-magnitude-le 's 'l 'n)
  (dk-have! (list 'SUBSET (list 'BALL 'CC-MS 'l r) 'u)
    (lambda ()
      (let* ((w (subset-by-element!)))
        (ca5-out-ball! w 'l r)
        (ca5-mag! (list '- w 'l))
        (let* ((e (list '- r (list 'magnitude (list '- w 'l))))
               (he (list '* 1/2 e)))
          (ca5-rr! e) (ca5-rr! he)
          (dk-have! (list '< 0 he) (lambda () (dk-ineq! (list '< (list 'magnitude (list '- w 'l)) r))))
          (dk-cite! 'rr-pos-rr-of-lt he)
          (let* ((ctiff (dk-cite! 'converges-to 'CC-MS 's 'l))
                 (cev (let loop ((x (caddr ctiff))) (if (eq? (car x) 'AND) (loop (caddr x)) x))))
            (dk-have! cev (lambda () (prop)))
            (let* ((nb (dk-skolem! (dk-apply! cev he))))
              (dk-split-all!)
              (let* ((tl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm nb) (dk-contains? fm he))) "the tail"))
                     (sn (list 's nb)))
                (fact 'nn-le-refl nb)
                (dk-apply! tl nb)
                (dk-apply! ca5-inK nb)
                (ca5-kn-parts! 'u 'n sn)
                (fact 'fun-apply-type-c 's 'NN 'CC nb)
                (fact 'cc-ms-dist sn 'l)
                (dk-rewrite-h! (list '<= (list '(DIST CC-MS) sn 'l) he) (list '(DIST CC-MS) sn 'l) (list 'magnitude (list '- sn 'l)))
                (ca5-mag! (list '- sn 'l)) (ca5-mag! (list '- 'l sn)) (ca5-mag! (list '- w sn))
                (dk-cite! 'cc-magnitude-sub-sym 'l sn)
                (dk-cite! 'cc-magnitude-sub-chain w 'l sn)
                (dk-have! (list '< (list 'magnitude (list '- w sn)) r)
                  (lambda ()
                    (dk-ineq! (list '<= (list 'magnitude (list '- w sn))
                                    (list '+ (list 'magnitude (list '- w 'l)) (list 'magnitude (list '- 'l sn))))
                              (list '= (list 'magnitude (list '- 'l sn)) (list 'magnitude (list '- sn 'l)))
                              (list '<= (list 'magnitude (list '- sn 'l)) he)
                              (list '< (list 'magnitude (list '- w 'l)) r))))
                (ca5-in-ball! w sn r)
                (fact 'subset-mem-fwd (list 'BALL 'CC-MS sn r) 'u w)
                (ass))))))))
  (dk-split-all! (list (dk-cite! 'cc-exhaust-membership 'u 'n 'l)))
  (dk-have! (list 'AND '(IN l CC) (list 'AND '(<= (magnitude l) n) (list 'SUBSET (list 'BALL 'CC-MS 'l r) 'u)))
    (lambda () (dk-conj-close!)))
  (prop))
(qed 'cc-exhaust-limit-in)
(topic! 'cc-exhaust-limit-in 'analysis)

(sp (make-wff '(FORALL u (FORALL n (IMPLIES (IN n NN)
   (IS-COMPACT (SUBSPACE-MS CC-MS (CC-EXHAUST u n))))))))
(dk-peel!)
(fact 'cc-is-metric-space)
(ca5-pts-cc!)
(let* ((kn '(CC-EXHAUST u n))
       (sub (list 'SUBSPACE-MS 'CC-MS kn)))
  (fact 'nn-in-rr 'n)
  (dk-have! (list 'SUBSET kn 'CC)
    (lambda () (let ((z (subset-by-element!))) (ca5-kn-parts! 'u 'n z) (ass))))
  (dk-have! (list 'SUBSET kn '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
  (dk-have! (list 'IN kn 'SET) (lambda () (dk-sethood! kn)))
  (fact 'subspace-is-metric-space 'CC-MS kn)
  (fact 'subspace-pts 'CC-MS kn)
  (let* ((sciff (dk-cite! 'seq-compact sub))
         (rhs (caddr sciff)))
    (dk-have! rhs
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (let* ((f (dk-di-var!)))
                  (dk-have! (list 'IN f (list 'FUN 'NN kn)) (lambda () (subst (list '== kn (list 'PTS sub))) (ass)))
                  (fact 'fun-codomain-superset f 'NN kn 'CC)
                  (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list '<= (list 'magnitude (list f 'i)) 'n)))
                    (lambda ()
                      (let ((i (dk-di-var!)))
                        (fact 'fun-apply-type-c f 'NN kn i)
                        (ca5-kn-parts! 'u 'n (list f i))
                        (ass))))
                  (let* ((phi (dk-skolem! (dk-cite! 'cc-bolzano-weierstrass f 'n))))
                    (dk-split-all!)
                    (let* ((lex (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm 'CONVERGES-TO))) "the limit"))
                           (l (dk-skolem! lex))
                           (sq (list 'SUBSEQ f phi)))
                      (dk-split-all!)
                      (ca5-and! (list 'IN f (list 'FUN 'NN (list 'PTS sub))) (list 'STRICTLY-MONO-NN phi))
                      (fact 'subseq-is-fun sub f phi)
                      (dk-have! (list 'IN sq (list 'FUN 'NN kn)) (lambda () (subst (list '== kn (list 'PTS sub))) (ass)))
                      (fact 'fun-codomain-superset sq 'NN kn 'CC)
                      (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'IN (list sq 'i) kn)))
                        (lambda () (let ((i (dk-di-var!))) (fact 'fun-apply-type-c sq 'NN kn i) (ass))))
                      (dk-cite! 'cc-exhaust-limit-in 'u 'n sq l)
                      (dk-have! (list 'IN l (list 'PTS sub)) (lambda () (subst (list '== (list 'PTS sub) kn)) (ass)))
                      (dk-split-all! (list (dk-cite! 'subspace-converges-to 'CC-MS kn sq l)))
                      (dk-have! (list 'CONVERGES-TO sub sq l) (lambda () (prop)))
                      (ew phi)
                      (dk-conj-close!
                        (lambda ()
                          (if (dk-head-is? (dk-goal) 'FORSOME)
                              (begin (ew l) (dk-conj-close! (lambda () (ass))))
                              (ass))))))))))))
    (dk-have! (list 'SEQ-COMPACT sub) (lambda () (prop)))
    (fact 'seq-compact-implies-compact sub)
    (ass)))
(qed 'cc-exhaust-compact)
(topic! 'cc-exhaust-compact 'analysis)
;;; ======================================================================
;;; (10) a continuous function on u is bounded on each K_n; the seminorms
;;;      p_n(f) = CC-SUP-NORM(f, K_n) are real, and |f(z)| <= p_n(f) on K_n
;;; ======================================================================
(define ca5-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (ca5-sub u) (list 'SUBSPACE-MS ca5-nfm u))
(define (ca5-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u)
    (list 'IS-CONTINUOUS-AT (ca5-sub u) ca5-nfm f 'rgy_))))
(define (ca5-imps hyps body)
  (if (null? hyps) body (list 'IMPLIES (car hyps) (ca5-imps (cdr hyps) body))))
;; the facts on NFM and on the subspace u (u subset CC in context), after morera.scm's mrr-ms!
(define (ca5-nfm! u)
  (fact 'nf-cc-is-metric-space)
  (fact 'nf-metric-carrier 'CC-NORMED-FIELD)
  (fact 'cc-nf-carr)
  (if (not (dk-asm? (list '== (list 'PTS ca5-nfm) 'CC)))
      (dk-have! (list '== (list 'PTS ca5-nfm) 'CC)
        (lambda () (subst (list '== (list 'PTS ca5-nfm) '(CARR CC-NORMED-FIELD))) (ass))))
  (if (not (dk-asm? (list 'SUBSET u (list 'PTS ca5-nfm))))
      (dk-have! (list 'SUBSET u (list 'PTS ca5-nfm))
        (lambda () (subst (list '== (list 'PTS ca5-nfm) 'CC)) (ass))))
  (if (not (dk-asm? (list 'IN u 'SET))) (dk-have! (list 'IN u 'SET) (lambda () (dk-sethood! u))))
  (fact 'subspace-is-metric-space ca5-nfm u)
  (fact 'subspace-pts ca5-nfm u))
;; x, y in CC in context: land (DIST NFM)(x, y) = |x - y| as an equation in context, return it
(define (ca5-nfm-dist! x y)
  (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
  (dk-have! (list 'IN y '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
  (fact 'nf-cc-agree-dist x y)
  (fact 'cc-ms-dist x y)
  (ca5-mag! (list '- x y))
  (let ((eq (list '= (list (list 'DIST ca5-nfm) x y) (list 'magnitude (list '- x y)))))
    (if (not (dk-asm? eq))
        (dk-have! eq
          (lambda ()
            (subst (list '== (list (list 'DIST ca5-nfm) x y) (list (list 'DIST 'CC-MS) x y)))
            (subst (list '== (list (list 'DIST 'CC-MS) x y) (list 'magnitude (list '- x y))))
            (rfl))))
    eq))

(define ca5-bq '(FORSOME bm (AND (IN bm RR) (AND (<= 0 bm)
                   (FORALL z (IMPLIES (IN z (CC-EXHAUST u n)) (<= (magnitude (f z)) bm)))))))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ca5-nfm 'u)
  (list 'FORALL 'f (ca5-imps (list '(IN f (FUN u CC)) (ca5-cont 'u 'f))
    (list 'FORALL 'n (list 'IMPLIES '(IN n NN) ca5-bq))))))))
(dk-peel!)
(fact 'cc-is-metric-space)
(ca5-pts-cc!)
(fact 'cc-open-subset-cc 'u)
(ca5-nfm! 'u)
(define ca5-cnt (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-CONTINUOUS-AT))) "continuity"))
(dk-cite! 'cc-exhaust-subset 'u 'n)
(use-em ca5-bq
  (lambda () (ass))
  (lambda ()
    (let* ((kn '(CC-EXHAUST u n))
           (g (ca5-choose-seq! kn
                (lambda (k w) (list 'NOT (list '<= (list 'magnitude (list 'f w)) k)))
                (lambda (k)
                  (let ((ex (list 'FORSOME 'zw_ (list 'AND (list 'IN 'zw_ kn)
                                    (list 'NOT (list '<= (list 'magnitude '(f zw_)) k))))))
                    (fact 'nn-in-rr k) (fact 'nn-zero-le k)
                    (dk-have! ex (lambda () (use-em ex
                      (lambda () (ass))
                      (lambda ()
                        (dk-have! ca5-bq
                          (lambda ()
                            (ew k)
                            (dk-conj-close!
                              (lambda ()
                                (if (dk-head-is? (dk-goal) 'FORALL)
                                    (let ((z (dk-di-var!)))
                                      (use-em (list '<= (list 'magnitude (list 'f z)) k)
                                        (lambda () (ass))
                                        (lambda ()
                                          (dk-have! ex (lambda () (ew z) (dk-conj-close! (lambda () (ass)))))
                                          (dk-only! ex (list 'NOT ex))
                                          (prop))))
                                    (ass))))))
                        (dk-only! ca5-bq (list 'NOT ca5-bq))
                        (prop)))))
                    (let ((w (dk-skolem! ex))) (dk-split-all!) w))))))
      (fact 'subset-trans kn 'u 'CC)
      (fact 'fun-codomain-superset g 'NN kn 'CC)
      (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list '<= (list 'magnitude (list g 'i)) 'n)))
        (lambda ()
          (let ((i (dk-di-var!)))
            (fact 'fun-apply-type-c g 'NN kn i)
            (ca5-kn-parts! 'u 'n (list g i))
            (ass))))
      (fact 'nn-in-rr 'n)
      (let* ((phi (dk-skolem! (dk-cite! 'cc-bolzano-weierstrass g 'n))))
        (dk-split-all!)
        (let* ((lex (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm 'CONVERGES-TO))) "the limit"))
               (l (dk-skolem! lex))
               (sq (list 'SUBSEQ g phi))
               (ssk (list 'SUBSPACE-MS 'CC-MS kn)))
          (dk-split-all!)
          ;; the subsequence lies in K_n, so does its limit, hence l in u
          (dk-have! (list 'IN kn 'SET) (lambda () (dk-sethood! kn)))
          (fact 'subspace-pts 'CC-MS kn)
          (dk-have! (list 'IN g (list 'FUN 'NN (list 'PTS ssk))) (lambda () (subst (list '== (list 'PTS ssk) kn)) (ass)))
          (ca5-and! (list 'IN g (list 'FUN 'NN (list 'PTS ssk))) (list 'STRICTLY-MONO-NN phi))
          (fact 'subseq-is-fun ssk g phi)
          (dk-have! (list 'IN sq (list 'FUN 'NN kn)) (lambda () (subst (list '== kn (list 'PTS ssk))) (ass)))
          (fact 'fun-codomain-superset sq 'NN kn 'CC)
          (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'IN (list sq 'i) kn)))
            (lambda () (let ((i (dk-di-var!))) (fact 'fun-apply-type-c sq 'NN kn i) (ass))))
          (dk-cite! 'cc-exhaust-limit-in 'u 'n sq l)
          (fact 'subset-mem-fwd kn 'u l)
          (fact 'fun-apply-type-c 'f 'u 'CC l)
          ;; continuity at l with eps = 1
          (fact 'rr-one-in)
          (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
          (dk-cite! 'rr-pos-rr-of-lt 1)
          (let* ((ciff (dk-cite! 'is-continuous-at (ca5-sub 'u) ca5-nfm 'f l))
                 (_0 (dk-apply! ca5-cnt l))
                 (cev (let loop ((x (caddr ciff))) (if (eq? (car x) 'AND) (loop (caddr x)) x))))
            (dk-have! cev (lambda () (prop)))
            (let* ((dl (dk-skolem! (dk-apply! cev 1))))
              (dk-split-all!)
              (fact 'rr-pos-rr-in-rr dl)
              (let* ((cb (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm dl))) "the delta clause"))
                     (ctiff (dk-cite! 'converges-to 'CC-MS sq l))
                     (tev (let loop ((x (caddr ctiff))) (if (eq? (car x) 'AND) (loop (caddr x)) x))))
                (dk-have! tev (lambda () (prop)))
                (let* ((nb (dk-skolem! (dk-apply! tev dl))))
                  (dk-split-all!)
                  (let* ((tl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm nb) (dk-contains? fm dl))) "the tail"))
                         (fl (list 'f l)))
                    (ca5-mag! fl)
                    (fact 'rr-add-in-rr (list 'magnitude fl) 1)
                    (let* ((k0 (dk-skolem! (dk-cite! 'nn-unbounded-in-rr (list '+ (list 'magnitude fl) 1)))))
                      (dk-split-all!)
                      (let* ((j (list '+ nb k0))
                             (pj (list phi j))
                             (gj (list g pj)))
                        (ca5-and! (list 'IN nb 'NN) (list 'IN k0 'NN))
                        (fact 'nn-add-closed nb k0)
                        (fact 'nn-le-add-right k0 nb)
                        (fact 'nn-le-add-left nb k0)
                        (dk-cite! 'strictly-mono-ge-id phi j)
                        (let ((smi (dk-cite! 'strictly-mono-nn phi)))
                          (dk-have! (caddr smi) (lambda () (prop)))
                          (dk-split-all! (list (caddr smi))))
                        (fact 'fun-apply-type-c phi 'NN 'NN j)
                        (fact 'fun-apply-type-c g 'NN kn pj)
                        (fact 'fun-apply-type-c g 'NN 'CC pj)
                        (fact 'subset-mem-fwd kn 'u gj)
                        (fact 'fun-apply-type-c 'f 'u 'CC gj)
                        (fact 'nn-in-rr j) (fact 'nn-in-rr pj) (fact 'nn-in-rr k0) (fact 'nn-in-rr nb)
                        ;; |g(phi j) - l| <= dl
                        (dk-apply! tl j)
                        (fact 'subseq-apply g phi j)
                        (dk-rewrite-h! (list '<= (list '(DIST CC-MS) (list sq j) l) dl) (list sq j) gj)
                        (fact 'cc-ms-dist gj l)
                        (dk-rewrite-h! (list '<= (list '(DIST CC-MS) gj l) dl) (list '(DIST CC-MS) gj l) (list 'magnitude (list '- gj l)))
                        (ca5-mag! (list '- gj l)) (ca5-mag! (list '- l gj))
                        (dk-cite! 'cc-magnitude-sub-sym l gj)
                        ;; the distance in the subspace u
                        (dk-have! (list 'IN gj (list 'PTS (ca5-sub 'u))) (lambda () (subst (list '== (list 'PTS (ca5-sub 'u)) 'u)) (ass)))
                        (fact 'subspace-dist ca5-nfm 'u l gj)
                        (ca5-nfm-dist! l gj)
                        (dk-have! (list '<= (list (list 'DIST (ca5-sub 'u)) l gj) dl)
                          (lambda ()
                            (subst (list '== (list (list 'DIST (ca5-sub 'u)) l gj) (list (list 'DIST ca5-nfm) l gj)))
                            (subst (list '= (list (list 'DIST ca5-nfm) l gj) (list 'magnitude (list '- l gj))))
                            (dk-ineq! (list '= (list 'magnitude (list '- l gj)) (list 'magnitude (list '- gj l)))
                                      (list '<= (list 'magnitude (list '- gj l)) dl))))
                        (dk-apply! cb gj)
                        (let ((fg (list 'f gj)))
                          (ca5-nfm-dist! fl fg)
                          (dk-rewrite-h! (list '<= (list (list 'DIST ca5-nfm) fl fg) 1)
                                         (list (list 'DIST ca5-nfm) fl fg) (list 'magnitude (list '- fl fg)))
                          (ca5-mag! fg)
                          (ca5-mag! (list '- fg fl)) (ca5-mag! (list '- fl fg))
                          (dk-cite! 'cc-magnitude-sub-sym fl fg)
                          (ca5-and! (list 'IN (list '- fg fl) 'CC) (list 'IN fl 'CC))
                          (fact 'cc-magnitude-triangle (list '- fg fl) fl)
                          (dk-have! (list '= fg (list '+ (list '- fg fl) fl)) (lambda () (crs)))
                          (dk-rewrite-h! (list '<= (list 'magnitude (list '+ (list '- fg fl) fl))
                                               (list '+ (list 'magnitude (list '- fg fl)) (list 'magnitude fl)))
                                         (list '+ (list '- fg fl) fl) fg)
                          (ca5-seq-at! g pj)
                          (dk-have! (list '<= (list 'magnitude fg) (list '+ (list 'magnitude fl) 1))
                            (lambda ()
                              (dk-ineq! (list '<= (list 'magnitude fg) (list '+ (list 'magnitude (list '- fg fl)) (list 'magnitude fl)))
                                        (list '= (list 'magnitude (list '- fl fg)) (list 'magnitude (list '- fg fl)))
                                        (list '<= (list 'magnitude (list '- fl fg)) 1))))
                          (dk-have! (list '<= (list 'magnitude fg) pj)
                            (lambda ()
                              (dk-ineq! (list '<= (list 'magnitude fg) (list '+ (list 'magnitude fl) 1))
                                        (list '< (list '+ (list 'magnitude fl) 1) k0)
                                        (list '<= k0 j) (list '<= j pj))))
                          (dk-only! (list '<= (list 'magnitude fg) pj) (list 'NOT (list '<= (list 'magnitude fg) pj)))
                          (prop))))))))))))))
(qed 'cc-continuous-bounded-on-exhaust)
(topic! 'cc-continuous-bounded-on-exhaust 'analysis)
;;; ======================================================================
;;; (11) the supremum norm bounds each value; p_n(f) is a non-negative real
;;; ======================================================================
(define ca5-sn-im '(IMAGE (VNB-LAMBDA cpsx_ xs (magnitude (g cpsx_))) xs))
(sp (make-wff (list 'FORALL 'g (list 'FORALL 'xs
  (ca5-imps (list '(FORALL y (IMPLIES (IN y xs) (IN (g y) CC))))
    (list 'FORALL 'x (list 'IMPLIES '(IN x xs) '(<= (magnitude (g x)) (CC-SUP-NORM g xs)))))))))
(dk-peel!)
(define ca5-sn-typ (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'CC))) "the typing"))
(mac 'CC-SUP-NORM)
;; the image lies in [0, +inf]
(dk-have! (list 'SUBSET ca5-sn-im 'RR-POS-STAR)
  (lambda ()
    (let ((w (subset-by-element!)))
      (let* ((ex (car (dk-landed (lambda () (mac-h 'image-membership-iff (list 'IN w ca5-sn-im))))))
             (_0 (dk-split-all!))
             (exf (dk-pick (lambda (fm) (dk-head-is? fm 'FORSOME)) "the preimage"))
             (y (dk-skolem! exf)))
        (dk-split-all!)
        (dk-lam-b-h! (dk-pick (lambda (fm) (and (dk-head-is? fm '=) (eq? (caddr fm) w))) "value equation"))
        (dk-apply! ca5-sn-typ y)
        (fact 'cc-magnitude-closed (list 'g y))
        (fact 'cc-magnitude-nonneg (list 'g y))
        (subst (list '= w (list 'magnitude (list 'g y))))
        (mac 'rr-pos-star-membership) (oi-l) (dk-conj-close! (lambda () (ass)))))))
(fact 'esup-upper ca5-sn-im)
(dk-apply! ca5-sn-typ 'x)
(fact 'cc-magnitude-closed '(g x))
(fact 'membership-implies-sethood '(magnitude (g x)) 'RR)
(dk-have! (list 'IN '(magnitude (g x)) ca5-sn-im)
  (lambda ()
    (mac 'image-membership-iff)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'FORSOME)
            (begin (ew 'x)
                   (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (dk-lam-b!) (rfl))))))
            (ass))))))
(dk-apply! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'ESUP))) "esup-upper") '(magnitude (g x)))
(ass)
(qed 'cc-sup-norm-upper)
(topic! 'cc-sup-norm-upper 'analysis)

;;; p_n(f) = CC-SUP-NORM(f, K_n) is a real >= 0 for f continuous on u
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ca5-nfm 'u)
  (list 'FORALL 'f (ca5-imps (list '(IN f (FUN u CC)) (ca5-cont 'u 'f))
    (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
      '(AND (IN (CC-SUP-NORM f (CC-EXHAUST u n)) RR) (<= 0 (CC-SUP-NORM f (CC-EXHAUST u n))))))))))))
(dk-peel!)
(let* ((kn '(CC-EXHAUST u n))
       (bm (dk-skolem! (dk-cite! 'cc-continuous-bounded-on-exhaust 'u 'f 'n))))
  (dk-split-all!)
  (dk-cite! 'cc-exhaust-subset 'u 'n)
  (dk-have! (list 'FORALL 'cpsx_ (list 'IMPLIES (list 'IN 'cpsx_ kn) '(IN (f cpsx_) CC)))
    (lambda ()
      (let ((z (dk-di-var!)))
        (fact 'subset-mem-fwd kn 'u z)
        (fact 'fun-apply-type-c 'f 'u 'CC z)
        (ass))))
  (dk-split-all! (list (dk-cite! 'cc-sup-norm-bound 'f kn bm)))
  (dk-conj-close! (lambda () (ass))))
(qed 'cc-exhaust-seminorm-real)
(topic! 'cc-exhaust-seminorm-real 'analysis)
;;; ======================================================================
;;; (12) Proposition 5.2, the topology: uniform convergence on every K_n is
;;;      UNIF-ON-COMPACTA (structure-library/ca-ac-vocab.scm, CA-AC's predicate)
;;; ======================================================================
(define (ca5-unif-on set)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'cap_ (list 'AND '(IN cap_ NN)
      (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES '(<= cap_ k)
        (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z set)
          '(<= (magnitude (- ((fam k) z) (f z))) eps)))))))))))
(define ca5-unif-kn
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (ca5-unif-on '(CC-EXHAUST u n)))))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ca5-nfm 'u)
  (list 'FORALL 'fam (list 'FORALL 'f (list 'IFF ca5-unif-kn '(UNIF-ON-COMPACTA u fam f))))))))
(dk-peel!)
(define ca5-ui (dk-cite! 'unif-on-compacta 'u 'fam 'f))
(define ca5-ubody (caddr ca5-ui))
(dk-iff! (lambda (g) (dk-head-is? g 'UNIF-ON-COMPACTA))
  ;; on the K_n => on a compact subset: it lies in one K_n
  (lambda ()
    (dk-have! ca5-ubody
      (lambda ()
        (let ((hk (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'CC-EXHAUST))) "on the K_n"))
              (cq (cadr (dk-goal))))
          (dk-peel!)
          (let* ((nx (dk-skolem! (dk-cite! 'cc-exhaust-exhaustive 'u cq))))
            (dk-split-all!)
            (let* ((epsv (cadr (car (filter (dk-head? 'POS-RR) (dk-asms)))))
                   (on (dk-apply! hk nx))
                   (cap (dk-skolem! (dk-apply! on epsv))))
              (dk-split-all!)
              (ew cap)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal))
                      (ass)
                      (let* ((cl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm cap) (dk-contains? fm epsv))) "the tail"))
                             (lk (dk-peel!))
                             (kv (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) lk))))
                             (zv (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) cq))) lk)))))
                        (fact 'subset-mem-fwd cq (list 'CC-EXHAUST 'u nx) zv)
                        (dk-apply! cl kv zv)
                        (ass))))))))))
    (prop))
  ;; on compact subsets => on each K_n: K_n is compact and lies in u
  (lambda ()
    (dk-have! ca5-ubody (lambda () (prop)))
    (let* ((lk (dk-peel!))
           (n (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) lk))))
           (epsv (cadr (car (filter (dk-head? 'POS-RR) lk)))))
      (dk-cite! 'cc-exhaust-subset 'u n)
      (dk-cite! 'cc-exhaust-compact 'u n)
      (let* ((on (dk-apply! ca5-ubody (list 'CC-EXHAUST 'u n)))
             (on2 (dk-apply! on epsv)))
        (ass)))))
(qed 'cc-exhaust-uniform-iff-compacta)
(topic! 'cc-exhaust-uniform-iff-compacta 'analysis)
