;;; ch3a-maxmod.scm -- the maximum modulus principle on a connected open set (Proposition 3.55 of
;;; the complex analysis notes, holomorphic form) (CH3-A, 2026-10-26).
;;; Destination: theorem-library/ch3a-maxmod.scm, library complex-analysis.
;;;
;;;   ball-zeros-accumulate        g = 0 on a ball B(a, r) inside u ==> the zeros of g accumulate at a
;;;   maximum-modulus-connected    u connected open, f holomorphic on u, |f| attains its maximum
;;;                                over u at a in u ==> f is constant (= f(a)) on u
;;;
;;; Proof: maximum-modulus-disc makes f constant on a ball about a; so the zeros of f - f(a)
;;; accumulate at a, and the identity principle (holomorphic-identity-principle, on the
;;; connected u) makes f - f(a) vanish on u.  This replaces the notes' open-closed argument
;;; (the identity principle is that argument, already proven); the mean value property of
;;; Definition 3.54 (an integral) is not used.
;;; Helper prefix cmx-.
;;; ======================================================================
(define (cmx-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-type! t 'CC)))
(define (cmx-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)))
(define (cmx-nn-add! a b)
  (if (not (dk-asm? (list 'IN (list '+ a b) 'NN)))
      (begin
        (if (not (dk-asm? (list 'AND (list 'IN a 'NN) (list 'IN b 'NN))))
            (dk-have! (list 'AND (list 'IN a 'NN) (list 'IN b 'NN)) (lambda () (dk-conj-close!))))
        (fact 'nn-add-closed a b))))
(define (cmx-rad! m)
  (let ((r (list 'recip (list '+ m 1))))
    (if (not (dk-asm? (list 'IN r 'RR)))
        (begin (dk-cite! 'nn-recip-succ-pos m) (fact 'rr-pos-rr-in-rr r) (fact 'rr-lt-of-pos-rr r)))
    r))
;; e1, e2 POS-RR in context: a t = recip(n+1) with 0 < t < e1, t < e2; returns t
(define (cmx-small! e1 e2)
  (let* ((n1 (dk-skolem! (dk-cite! 'nn-recip-succ-small e1)))
         (_1 (dk-split-all!))
         (n2 (dk-skolem! (dk-cite! 'nn-recip-succ-small e2)))
         (_2 (dk-split-all!))
         (n (list '+ n1 n2)))
    (cmx-nn-add! n1 n2)
    (cmx-rad! n1) (cmx-rad! n2)
    (let ((t (cmx-rad! n)))
      (dk-have! (list '<= n1 n) (lambda () (dk-nn!)))
      (dk-have! (list '<= n2 n) (lambda () (dk-nn!)))
      (dk-cite! 'nn-recip-succ-antitone n1 n)
      (dk-cite! 'nn-recip-succ-antitone n2 n)
      (dk-have! (list '< t e1) (lambda () (dk-ineq! (list '<= t (list 'recip (list '+ n1 1))) (list '< (list 'recip (list '+ n1 1)) e1))))
      (dk-have! (list '< t e2) (lambda () (dk-ineq! (list '<= t (list 'recip (list '+ n2 1))) (list '< (list 'recip (list '+ n2 1)) e2))))
      t)))

;;; ======================================================================
;;; (1) a function vanishing on a ball about a has zeros accumulating at a
;;; ======================================================================
(sp (make-wff '(FORALL u (FORALL g (FORALL a (IMPLIES (IN a CC)
  (FORALL r (IMPLIES (POS-RR r) (IMPLIES (SUBSET (BALL CC-MS a r) u)
    (IMPLIES (FORALL z (IMPLIES (IN z (BALL CC-MS a r)) (= (g z) 0)))
      (ZEROS-ACCUMULATE-AT u g a)))))))))))
(dk-peel!)
(define cmx-1-zero (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm '(BALL CC-MS a r)))) "g = 0 on the ball"))
(fact 'rr-pos-rr-in-rr 'r)
(let ((zi (dk-cite! 'zeros-accumulate-at 'u 'g 'a)))
  (dk-have! (caddr zi)
    (lambda ()
      (let* ((landed (dk-peel!))
             (e (dk-landed-eps landed))
             (_e (fact 'rr-pos-rr-in-rr e))
             (t (cmx-small! e 'r))
             (x (list '+ 'a t)))
        (cmx-cc! t)
        (cmx-cc! x)
        (dk-have! (list '= (list '- x 'a) t) (lambda () (crs)))
        (cmx-cc! (list '- x 'a))
        (dk-cite! 'rr-magnitude-is-abs t)
        (dk-have! (list '<= 0 t) (lambda () (dk-ineq! (list '< 0 t))))
        (dk-cite! 'rr-abs-of-nonneg t)
        (dk-have! (list '= (list 'magnitude (list '- x 'a)) t)
          (lambda ()
            (subst (list '= (list '- x 'a) t))
            (subst (list '= (list 'magnitude t) (list 'abs t)))
            (subst (list '= (list 'abs t) t))
            (rfl)))
        (dk-cite! 'cc-ms-ball-membership 'a e x)
        (dk-cite! 'cc-ms-ball-membership 'a 'r x)
        (fact 'cc-magnitude-closed (list '- x 'a))
        (dk-have! (list '< (list 'magnitude (list '- x 'a)) 'r) (lambda () (dk-ineq! (list '= (list 'magnitude (list '- x 'a)) t) (list '< t 'r))))
        (dk-have! (list '< (list 'magnitude (list '- x 'a)) e) (lambda () (dk-ineq! (list '= (list 'magnitude (list '- x 'a)) t) (list '< t e))))
        (dk-have! (list 'IN x '(BALL CC-MS a r))
          (lambda ()
            (dk-only! (dk-pick (lambda (fm) (and (dk-head-is? fm 'IFF) (dk-contains? fm '(BALL CC-MS a r)))) "the r-ball iff")
                      (list 'IN x 'CC) (list '< (list 'magnitude (list '- x 'a)) 'r))
            (prop)))
        (fact 'subset-mem-fwd '(BALL CC-MS a r) 'u x)
        (dk-apply! cmx-1-zero x)
        (ew x)
        (dk-conj-close!
          (lambda ()
            (let ((gl (dk-goal)))
              (cond ((dk-asm? gl) (ass))
                    ((dk-head-is? gl 'NOT)
                     (di)
                     (dk-rewrite-h! (list '= (list '- x 'a) t) x 'a)
                     (dk-have! (list '= (list '- 'a 'a) 0) (lambda () (crs)))
                     (dk-rewrite-h! (list '= (list '- 'a 'a) t) (list '- 'a 'a) 0)
                     (dk-absurd! (list '= 0 t) (list '< 0 t)))
                    (#t
                     (dk-only! (dk-pick (lambda (fm) (and (dk-head-is? fm 'IFF) (dk-contains? fm (list 'BALL 'CC-MS 'a e)))) "the e-ball iff")
                               (list 'IN x 'CC) (list '< (list 'magnitude (list '- x 'a)) e))
                     (prop)))))))))
  (prop))
(qed 'ball-zeros-accumulate)
(topic! 'ball-zeros-accumulate 'analysis)

;;; ======================================================================
;;; (2) PROPOSITION 3.55: the maximum modulus principle on a connected open set
;;; ======================================================================
(sp (make-wff '(FORALL u (IMPLIES (IS-CONNECTED CC-MS u)
  (FORALL f (IMPLIES (HOLOMORPHIC-ON u f)
    (FORALL a (IMPLIES (IN a u)
      (IMPLIES (FORALL z (IMPLIES (IN z u) (<= (magnitude (f z)) (magnitude (f a)))))
        (FORALL z (IMPLIES (IN z u) (= (f z) (f a)))))))))))))
(dk-peel!)
(define cmx-2-max (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'magnitude))) "the maximum"))
(define cmx-2-z (cadr (dk-goal)))
(set! cmx-2-z (let ((g (dk-goal))) (cadr (cadr g))))
(let ((hi (dk-cite! 'holomorphic-on 'u 'f)))
  (dk-have! (caddr hi) (lambda () (prop)))
  (dk-split-all! (list (caddr hi))))
(dk-cite! 'cc-ms-open-iff 'u)
(dk-have! '(IS-OPEN CC-MS u) (lambda () (prop)))
(fact 'cc-open-subset-cc 'u)
(fact 'subset-mem-fwd 'u 'CC 'a)
(fact 'fun-apply-type-c 'f 'u 'CC 'a)
(let ((oi (dk-cite! 'is-open 'CC-MS 'u)))
  (dk-have! (caddr oi) (lambda () (prop)))
  (dk-split-all! (list (caddr oi))))
(define cmx-2-op (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'BALL))) "openness"))
(define cmx-2-r (dk-skolem! (dk-apply! cmx-2-op 'a)))
(dk-split-all!)
(fact 'rr-pos-rr-in-rr cmx-2-r)
(fact 'rr-lt-of-pos-rr cmx-2-r)
(dk-have! (list 'FORALL 'cmvz_ (list 'IMPLIES (list 'IN 'cmvz_ (list 'BALL 'CC-MS 'a cmx-2-r))
            '(<= (magnitude (f cmvz_)) (magnitude (f a)))))
  (lambda ()
    (let ((w (dk-di-var!)))
      (fact 'subset-mem-fwd (list 'BALL 'CC-MS 'a cmx-2-r) 'u w)
      (dk-apply! cmx-2-max w)
      (ass))))
(define cmx-2-const (dk-cite! 'maximum-modulus-disc 'u 'f 'a cmx-2-r))
(define cmx-2-g '(VNB-LAMBDA cmxw_ u (- (f cmxw_) (f a))))
(dk-have! (list 'HOLOMORPHIC-ON 'u cmx-2-g) (lambda () (dk-holomorphic! 'u cmx-2-g)))
(dk-have! (list 'FORALL 'cmxz_ (list 'IMPLIES (list 'IN 'cmxz_ (list 'BALL 'CC-MS 'a cmx-2-r)) (list '= (list cmx-2-g 'cmxz_) 0)))
  (lambda ()
    (let ((w (dk-di-var!)))
      (fact 'subset-mem-fwd (list 'BALL 'CC-MS 'a cmx-2-r) 'u w)
      (fact 'fun-apply-type-c 'f 'u 'CC w)
      (dk-apply! cmx-2-const w)
      (dk-lam-b!)
      (subst (list '= (list 'f w) '(f a)))
      (crs))))
(dk-cite! 'ball-zeros-accumulate 'u cmx-2-g 'a cmx-2-r)
(define cmx-2-zero (dk-cite! 'holomorphic-identity-principle 'u cmx-2-g 'a))
(dk-apply! cmx-2-zero cmx-2-z)
(fact 'fun-apply-type-c 'f 'u 'CC cmx-2-z)
(dk-lam-b-h! (dk-pick (lambda (fm) (and (dk-head-is? fm '=) (dk-contains? fm 'VNB-LAMBDA) (dk-contains? fm cmx-2-z))) "g(z) = 0"))
(dk-cite! 'cc-sub-zero-eq (list 'f cmx-2-z) '(f a))
(ass)
(qed 'maximum-modulus-connected)
(topic! 'maximum-modulus-connected 'analysis)
