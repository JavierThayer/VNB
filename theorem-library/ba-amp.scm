(dk-cite! 'bop-fun 'w 'w '(BOP-COMP w a_ c_)) (dk-cite! 'bop-fun 'v 'v '(BOP-COMP v b_ d_))
(dk-cite! 'hsum-diag-bounded 'w 'v '(BOP-COMP w a_ c_) '(BOP-COMP v b_ d_))
(dk-cite! 'bop-fun am-HS am-HS (am-diag 'a_ 'b_)) (dk-cite! 'bop-fun am-HS am-HS (am-diag 'c_ 'd_))
(am-op-ext! (list 'BOP-COMP am-HS (am-diag 'a_ 'b_) (am-diag 'c_ 'd_)) (am-diag '(BOP-COMP w a_ c_) '(BOP-COMP v b_ d_))
  (lambda (p1 p2)
    (am-type! (am-pr p1 p2) '(VEC (HSUM w v)))
    (subst (dk-cite! 'bop-comp-apply am-HS (am-diag 'a_ 'b_) (am-diag 'c_ 'd_) (am-pr p1 p2)))
