  (dk-cite! 'bop-fun am-HS 'w p1) (dk-cite! 'bop-fun am-HS 'v p2) (dk-cite! 'bop-fun 'u am-HS k)
  (dk-cite! 'bop-comp-bounded-gen 'u am-HS 'w p1 k)
  (dk-cite! 'bop-comp-bounded-gen 'u am-HS 'v p2 k)
  (let* ((capp (lambda (pp z) (dk-cite! 'bop-comp-apply-gen 'u am-HS (if (equal? pp p1) 'w 'v) pp k z)))
         (comp-ante!
           (lambda (pp q-id?)
             (lambda (a y)
               (am-sub-type! a)
               (let* ((ra (list 'r_ a)) (ray (list ra y)) (ky (list k y)))
                 (am-type! ray '(VEC u))
                 (am-type! (list k ray) '(VEC (HSUM w v)))
                 (am-type! ky am-HV)
                 (am-type! (list 'f_ a) '(BOUNDED-OPS w w))
