                (list (am-pr ftx z1) (am-pr z2 tx) (am-pr x1 z1) (am-pr z2 x2)))
      (subst (dk-cite! 'bop-add am-HS 'u k (am-pr ftx z1) (am-pr z2 tx)))
      (subst (dk-cite! 'bop-add am-HS 'u k (am-pr x1 z1) (am-pr z2 x2)))
      (am-type! (list k (am-pr x1 z1)) '(VEC u)) (am-type! (list k (am-pr z2 x2)) '(VEC u))
      (subst (dk-cite! 'bop-add 'u 'u rt (list k (am-pr x1 z1)) (list k (am-pr z2 x2))))
      (let* ((i1 (dk-apply! d1 t x1)) (q1 (capp j1 ftx)) (q2 (inj j1 ftx)) (q3 (capp j1 x1)) (q4 (inj j1 x1))
             (e1 (am-rw-h! i1 q1 q2 q3 q4))
             (i2 (dk-apply! d2 t x2)) (r0 (dk-cite! 'id-rep-apply 'v t)) (r1 (capp j2 tx)) (r2 (inj j2 tx))
             (r3 (capp j2 x2)) (r4 (inj j2 x2))
             (e2 (am-rw-h! i2 r0 r1 r2 r3 r4)))
        (subst e1) (subst e2)
        (am-type! (list rt (list k (am-pr x1 z1))) '(VEC u)) (am-type! (list rt (list k (am-pr z2 x2))) '(VEC u))
        (am-rfl!)))))
(am-qed! 'intertwined-split-domain)

