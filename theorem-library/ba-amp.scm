(dk-split-all!)
(define (am-flaw head)
  (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f head) (dk-contains? f 'f_)
                            (not (dk-contains? f 'AMP-STEP)))) "the representation law"))
(define (am-ft! a)                    ; f a in L(w), as a function too
  (am-type! (list 'f_ a) '(BOUNDED-OPS w w))
  (dk-cite! 'bop-fun 'w 'w (list 'f_ a)))
(define (am-amp! a) (subst (dk-cite! 'amp-step-apply 'w 'v 'f_ a)))
(mac 'is-star-rep)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((am-done?) #t)
            ((dk-head-is? g 'IN) (dk-cite! 'amp-step-type 'w 'v 'f_) (dk-ass!))
            ((dk-head-is? g '=)
             (dk-cite! 'bop-id-bounded 'v)
             (am-amp! '(BOP-ID v))
             (subst (dk-ctx-form '(= (f_ (BOP-ID v)) (BOP-ID w))))
             (subst (dk-cite! 'hsum-diag-id 'w 'v))
             (if (not (am-done?)) (am-rfl!)))
            ((dk-contains? g 'OP-ADJOINT)
             (let* ((a (dk-di-var!)) (as (list 'OP-ADJOINT 'v 'v a)))
               (dk-cite! 'op-adjoint-bounded 'v 'v a)
               (am-ft! a) (am-ft! as)
               (am-amp! as) (am-amp! a)
               (subst (dk-apply! (am-flaw 'OP-ADJOINT) a))
               (subst (dk-cite! 'hsum-diag-adjoint 'w 'v (list 'f_ a) a))
               (dk-cite! 'op-adjoint-bounded 'w 'w (list 'f_ a))
               (dk-cite! 'bop-fun 'w 'w (list 'OP-ADJOINT 'w 'w (list 'f_ a))) (dk-cite! 'bop-fun 'v 'v as)
               (dk-cite! 'hsum-diag-bounded 'w 'v (list 'OP-ADJOINT 'w 'w (list 'f_ a)) as)
               (am-rfl!)))
            (#t
             (let* ((pl (dk-peel!))
                    (vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) pl)))
                    (g2 (dk-goal))
                    (arg (cadr (cadr g2)))
                    (hd (car arg)))
               (for-each (lambda (x) (if (dk-asm? (list 'IN x am-BOv)) (begin (dk-cite! 'bop-fun 'v 'v x) (am-ft! x)))) vs)
               (cond ((eq? hd 'BOP-SUM) (dk-cite! 'bop-sum-bounded 'v 'v (car vs) (cadr vs)))
                     ((eq? hd 'BOP-SCALE) (dk-cite! 'bop-scale-bounded 'v 'v (car vs) (cadr vs)))
                     ((eq? hd 'BOP-COMP) (dk-cite! 'bop-comp-bounded 'v (car vs) (cadr vs))))
               (am-ft! arg)
               (am-amp! arg)
               (for-each (lambda (x) (if (dk-asm? (list 'IN x am-BOv)) (am-amp! x))) vs)
               (subst (apply dk-apply! (am-flaw hd) vs))
               (let* ((fx (lambda (x) (if (dk-asm? (list 'IN x am-BOv)) (list 'f_ x) x))))
                 (cond ((eq? hd 'BOP-SUM)
                        (subst (dk-cite! 'hsum-diag-sum 'w 'v (fx (car vs)) (car vs) (fx (cadr vs)) (cadr vs)))
                        (dk-cite! 'bop-sum-bounded 'w 'w (fx (car vs)) (fx (cadr vs))))
                       ((eq? hd 'BOP-SCALE)
                        (subst (dk-cite! 'hsum-diag-scale 'w 'v (fx (cadr vs)) (cadr vs) (car vs)))
                        (dk-cite! 'bop-scale-bounded 'w 'w (car vs) (fx (cadr vs))))
                       ((eq? hd 'BOP-COMP)
                        (subst (dk-cite! 'hsum-diag-comp 'w 'v (fx (car vs)) (car vs) (fx (cadr vs)) (cadr vs)))
                        (dk-cite! 'bop-comp-bounded 'w (fx (car vs)) (fx (cadr vs))))))
