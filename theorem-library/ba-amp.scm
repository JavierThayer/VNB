;;; ba-amp.scm -- Thayer, Banach Algebras and Applications, ch. 6: von Neumann's bicommutant theorem
;;; (Theorem 6.1) by amplification, and Corollary 6.9 for a von Neumann algebra.
;;;   Part A  the injections, projections and diagonal operators of the Hilbert direct sum HSUM(w, v),
;;;           their values and bounds; composites of bounded operators between different spaces.
;;;   Part B  the intertwining property and how it passes to HSUM in the domain and in the codomain.
;;;   Part C  the algebra of diagonal operators; the one-step amplification T |-> f(T) (+) T of a unital
;;;           *-representation f is a unital *-representation (amplification-step).
;;;   Part D  the image f(s) of a unital *-algebra is a unital *-algebra, and f(s'') lies in f(s)''.
;;;   Part E  finite-set induction: one vector X of an amplification separates S, T in L(H) at least as
;;;           well as a given finite set G of vectors (amp-vector-exists) -- the n-fold sum H^n, built one
;;;           summand at a time instead of indexed by 1..n.
;;;   Part F  density on finite sets (bicommutant-finite-approx).
;;;   Part G  Theorem 6.1: s'' = TOP-CLOSURE(SOT v, s) (bicommutant-is-sot-closure).
;;;   Part H  a von Neumann algebra equals its bicommutant; Corollary 6.9.
;;; Agent BA-1111-C2, 2026-11-11.  DESTINATION: theorem-library/ba-amp.scm, after theorem-library/ba-vn.scm
;;; (BA-1111-C; it cites commutant-membership, bicommutant-vector-closure, commutant-sot-closed, the 6.9
;;; lemmas), which itself follows ba-optop-adjoint; also cites ba-g2 (HSUM), ba-optop (SOT), cvx-alg,
;;; ba-maximal-ideal (bmx-subset-antisym), ba-metric-lemmas, tvs-seminorm-tvs.  Vocabulary:
;;; structure-library/ba-amp-vocab.scm.  Library: operator-algebras.  Helper prefix am-.  Every qed is
;;; modulo 0; no support, warrant or axiom.

(define (am-done?) (sequent-node-grounded? (proof-state-focus *ps*)))
(define (am-qed! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** ba-amp: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'analysis))
(define am-C2 '((IS-COMPLEX-INNER-PRODUCT-SPACE w) (IS-COMPLEX-INNER-PRODUCT-SPACE v)))
(define am-HS '(HSUM w v))
(define am-HV '(CARTESIAN (VEC w) (VEC v)))
(define (am-vadd u a b) (list (list 'VADD u) a b))
(define (am-vneg u a) (list (list 'VNEG u) a))
(define (am-act u c a) (list (list 'ACT u) c a))
(define (am-nrm u a) (list 'IP-NORM u a))
(define (am-pr a b) (list 'LIST a b))

;;; the space a vector class belongs to: (VEC u) -> u
(define (am-space-of c) (and (dk-head-is? c 'VEC) (cadr c)))
(define (am-hsum? u) (dk-head-is? u 'HSUM))
(define (am-cart-of u) (list 'CARTESIAN (list 'VEC (cadr u)) (list 'VEC (caddr u))))

;;; (= (VEC (HSUM a b)) (CARTESIAN (VEC a) (VEC b))) in context
(define (am-hsum-eq! u)
  (let ((g (list '= (list 'VEC u) (am-cart-of u))))
    (if (not (dk-asm? g)) (dk-cite! 'hsum-vec-eq (cadr u) (caddr u)))
    g))
(define (am-cips! u)
  (if (not (dk-asm? (list 'IS-COMPLEX-INNER-PRODUCT-SPACE u)))
      (if (am-hsum? u)
          (begin (am-cips! (cadr u)) (am-cips! (caddr u)) (dk-cite! 'hsum-is-cips (cadr u) (caddr u)))
          (error "am-cips!: no CIPS for" (expression->string u)))))

;;; the class of an operator term f: (FUN A B) or (BOUNDED-OPS a b), landing its typing
(define (am-class-of f)
  (let ((hs (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (cadr h) f)
                                     (or (dk-head-is? (caddr h) 'FUN) (dk-head-is? (caddr h) 'BOUNDED-OPS))))
                    (dk-asms))))
    (cond ((pair? (filter (lambda (h) (dk-head-is? (caddr h) 'FUN)) hs))
           (caddr (car (filter (lambda (h) (dk-head-is? (caddr h) 'FUN)) hs))))
          ((pair? hs)
           (let ((c (caddr (car hs))))
             (dk-cite! 'bop-fun (cadr c) (caddr c) f)
             (list 'FUN (list 'VEC (cadr c)) (list 'VEC (caddr c)))))
          ((and (pair? f) (not (symbol? (car f))) )
           ;; an applied representation (phi t): phi in FUN(X, Y)
           (let* ((g (car f)) (gc (am-class-of g)))
             (if (and (dk-head-is? gc 'FUN) (= (length f) 2))
                 (begin (am-type! (cadr f) (cadr gc))
                        (dk-cite! 'fun-apply-type-c g (cadr gc) (caddr gc) (cadr f))
                        (am-class-of f))
                 (error "am-class-of: no class for" (expression->string f)))))
          ((and (pair? f) (symbol? (car f)) (= (length f) 2) (not (memq (car f) '(VADD VNEG ACT IP))))
           (let ((gc (am-class-of (car f))))
             (if (dk-head-is? gc 'FUN)
                 (begin (am-type! (cadr f) (cadr gc))
                        (dk-cite! 'fun-apply-type-c (car f) (cadr gc) (caddr gc) (cadr f))
                        (am-class-of f))
                 (error "am-class-of: no class for" (expression->string f)))))
          (#t (error "am-class-of: no class for" (expression->string f))))))

;;; land (IN t c)
(define (am-type! t c)
  (cond
    ((dk-asm? (list 'IN t c)) #t)
    ((and (dk-head-is? c 'VEC) (am-hsum? (cadr c)))
     (let ((eq (am-hsum-eq! (cadr c))))
       (am-type! t (caddr eq))
       (dk-have! (list 'IN t c) (lambda () (subst eq) (if (not (am-done?)) (dk-ass!))))))
    ((and (dk-head-is? c 'CARTESIAN) (dk-head-is? t 'LIST))
     (am-type! (cadr t) (cadr c)) (am-type! (caddr t) (caddr c))
     (dk-cite! 'pair-in-cartesian (cadr c) (caddr c) (cadr t) (caddr t)))
    ((and (dk-head-is? c 'CARTESIAN) (= (length c) 3) (dk-head-is? (cadr c) 'VEC) (dk-head-is? (caddr c) 'VEC)
          (pair? (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (cadr h) t)
                                           (equal? (caddr h) (list 'VEC (list 'HSUM (cadr (cadr c)) (cadr (caddr c)))))))
                         (dk-asms))))
     (let ((eq (am-hsum-eq! (list 'HSUM (cadr (cadr c)) (cadr (caddr c))))))
       (dk-have! (list 'IN t c) (lambda () (subst (list '= (caddr eq) (cadr eq))) (if (not (am-done?)) (dk-ass!))))))
    ((and (dk-head-is? t 'VZERO) (equal? c (list 'VEC (cadr t))))
     (am-cips! (cadr t)) (dk-cite! 'cips-vzero-in (cadr t)))
    ((and (pair? t) (dk-head-is? (car t) 'VADD) (equal? c (list 'VEC (cadr (car t)))))
     (am-cips! (cadr (car t))) (am-type! (cadr t) c) (am-type! (caddr t) c)
     (dk-cite! 'cips-vadd-type (cadr (car t)) (cadr t) (caddr t)))
    ((and (pair? t) (dk-head-is? (car t) 'VNEG) (equal? c (list 'VEC (cadr (car t)))))
     (am-cips! (cadr (car t))) (am-type! (cadr t) c)
     (dk-cite! 'cips-vneg-type (cadr (car t)) (cadr t)))
    ((and (pair? t) (dk-head-is? (car t) 'ACT) (equal? c (list 'VEC (cadr (car t)))))
     (am-cips! (cadr (car t))) (am-type! (caddr t) c)
     (dk-cite! 'cips-act-type (cadr (car t)) (cadr t) (caddr t)))
    ((and (pair? t) (= (length t) 2))
     (let ((fc (am-class-of (car t))))
       (am-type! (cadr t) (cadr fc))
       (dk-cite! 'fun-apply-type-c (car t) (cadr fc) (caddr fc) (cadr t))
       (if (not (equal? (caddr fc) c))
           (am-type! t c))))
    (#t (error "am-type!: no route" (expression->string (list 'IN t c))))))

;;; NTH reduction on the goal, landing set typings of the vectors involved
(define (am-sets! e)
  (for-each (lambda (h)
              (if (and (dk-head-is? h 'IN) (pair? (caddr h)) (dk-contains? e (cadr h))
                       (not (eq? (caddr h) 'SET)) (not (dk-asm? (list 'IN (cadr h) 'SET))))
                  (dk-cite! 'membership-implies-sethood (cadr h) (caddr h))))
            (dk-asms)))
(define (am-nth!)
  (let loop ((k 0))
    (if (and (< k 40) (not (am-done?)) (dk-contains? (dk-goal) 'NTH)
             (not (equal? (reduce-nth-in-expr (dk-goal)) (dk-goal))))
        (begin (am-sets! (dk-goal)) (nth-r) (loop (+ k 1))))))
(define (am-rfl!)
  (if (not (am-done?))
      (begin (am-sets! (dk-goal)) (rfl))))

;;; ineq over products: name each product P of PRODS (typed in RR by dk-real!), rewrite the HYPS and the
;;; goal with the names, then dk-ineq! on the rewritten hyps plus the RR typings in TYPS
(define (am-ineq! prods hyps typs)
  (for-each dk-real! prods)
  (let loop ((ps prods) (hs hyps))
    (if (null? ps)
        (let ((names (map (lambda (p) (cadr (dk-ctx-form-name p))) prods)))
          (apply dk-ineq! (append hs (map (lambda (n) (list 'IN n 'RR)) names) typs)))
        (let* ((p (car ps)) (n (dk-name! p)))
          (if (dk-contains? (dk-goal) p) (subst (list '= p n)))
          (loop (cdr ps) (map (lambda (h) (if (dk-contains? h p) (dk-rewrite-h! h p n) h)) hs))))))
(define (dk-ctx-form-name p)
  (car (filter (lambda (h) (and (dk-head-is? h '=) (symbol? (cadr h)) (equal? (caddr h) p))) (dk-asms))))

