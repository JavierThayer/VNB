               (cond ((dk-head-is? lhs-arg 'BOP-SUM) (dk-cite! 'bop-sum-bounded 'v 'v (car vs) (cadr vs)))
                     ((dk-head-is? lhs-arg 'BOP-SCALE) (dk-cite! 'bop-scale-bounded 'v 'v (car vs) (cadr vs)))
