;;; Part C.  The algebra of diagonal operators, and the one-step amplification of a *-representation.
(define am-Cab2 (append am-C2 '((IN a_ (BOUNDED-OPS w w)) (IN b_ (BOUNDED-OPS v v))
                                (IN c_ (BOUNDED-OPS w w)) (IN d_ (BOUNDED-OPS v v)))))
(define am-HSo '(BOUNDED-OPS (HSUM w v) (HSUM w v)))
(define (am-diag a b) (list 'HSUM-DIAG 'w 'v a b))
;;; L = R for two bounded operators on w (+) v (typed in context), pointwise on pairs by PTWISE (p1 p2)
(define (am-op-ext! l r ptwise)
  (dk-cite! 'bop-fun am-HS am-HS l) (dk-cite! 'bop-fun am-HS am-HS r)
  (dk-fun-ext! l r '(VEC (HSUM w v)) '(VEC (HSUM w v)) #f #f
    (lambda (z) (let ((pz (am-pairify! z am-HS))) (ptwise (car pz) (cadr pz))))))
(define (am-diag-setup!)
  (dk-peel!)
  (am-vec-sets!)
  (for-each (lambda (o u) (if (dk-asm? (list 'IN o (list 'BOUNDED-OPS u u))) (dk-cite! 'bop-fun u u o)))
            '(a_ b_ c_ d_) '(w v w v)))
(define (am-dapp! a b p1 p2)          ; rewrite (a (+) b)(p1, p2) in the goal
  (subst (dk-cite! 'hsum-diag-apply 'w 'v a b p1 p2)))

;;; (a (+) b) + (c (+) d) = (a + c) (+) (b + d)
