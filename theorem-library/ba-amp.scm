;;; Part D.  The image of an involutive algebra under a *-representation, and the bicommutant through an
;;; amplification.
(define am-IMG '(REP-IMAGE v w f_ s))
(define (am-img-sep img)
  (list 'SEP 'amb_ (list 'BOUNDED-OPS (caddr img) (caddr img))
        (list 'FORSOME 'amt_ (list 'AND (list 'IN 'amt_ (car (cddddr img))) (list '= 'amb_ (list (cadddr img) 'amt_))))))
(sp (make-wff (list 'FORALL 'v (list 'FORALL 'w (list 'FORALL 'f_ (list 'FORALL 's (list '== am-IMG (am-img-sep am-IMG))))))))
(dk-peel!) (mac 'REP-IMAGE) (qrfl)
(am-qed! 'rep-image-unfold)

;;; B in f(s) in context: land B in L(w), a in s, B = f(a); return a
(define (am-img-witness! b img)
  (let* ((u (dk-cite! 'rep-image-unfold (cadr img) (caddr img) (cadddr img) (car (cddddr img))))
         (h (dk-rewrite-h! (list 'IN b img) img (am-img-sep img)))
         (ex-b (subst-free 'amb_ b (cadddr (am-img-sep img)))))
    (sep-me h)
    (if (not (dk-ctx-form ex-b)) (dk-split-all!))
    (dk-skolem! (dk-ctx-form ex-b) #t)))
;;; goal (IN B img): close it with the witness a (a in s and B = f(a) proved by EQ!, or in context)
(define (am-img-intro! a eq!)
  (let* ((g (dk-goal)) (b (cadr g)) (img (caddr g)))
    (subst (dk-cite! 'rep-image-unfold (cadr img) (caddr img) (cadddr img) (car (cddddr img))))
    (in-sep! (lambda () (if (not (am-done?)) (dk-ass!)))
             (lambda ()
               (ew a)
               (dk-conj-close!
                 (lambda () (cond ((am-done?) #t) ((dk-ass!) #t) (#t (eq!)))))))))

(define am-star '(IS-STAR-OP-ALGEBRA v s))
(define (am-star-conj k)
  (list-ref (list (list 'SUBSET 's am-BOv) '(IN (BOP-ID v) s)
    '(FORALL vna_ (IMPLIES (IN vna_ s) (FORALL vnb_ (IMPLIES (IN vnb_ s) (IN (BOP-SUM v v vna_ vnb_) s)))))
    '(FORALL vnc_ (IMPLIES (IN vnc_ CC) (FORALL vna_ (IMPLIES (IN vna_ s) (IN (BOP-SCALE v v vnc_ vna_) s)))))
    '(FORALL vna_ (IMPLIES (IN vna_ s) (FORALL vnb_ (IMPLIES (IN vnb_ s) (IN (BOP-COMP v vna_ vnb_) s)))))
    '(FORALL vna_ (IMPLIES (IN vna_ s) (IN (OP-ADJOINT v v vna_) s)))) k))

(sp (make-wff (forall-guarded '(v w f_ s) (append '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w) (IS-STAR-REP v w f_)) (list am-star))
   (list 'IS-STAR-OP-ALGEBRA 'w am-IMG))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'w) (dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'bounded-ops-is-set 'w 'w) (dk-cite! 'bounded-ops-is-set 'v 'v)
(for-each (lambda (k) (dk-project! (am-star-conj k) 'is-star-op-algebra am-star)) '(0 1 2 3 4 5))
(mac-h 'is-star-rep '(IS-STAR-REP v w f_))
(dk-split-all!)
(define (am-in-s! a) (dk-cite! 'subset-mem-fwd 's am-BOv a))
(define (am-law head) (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f head) (dk-contains? f 'f_))) "law"))
(mac 'is-star-op-algebra)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((am-done?) #t)
        ((dk-head-is? g 'SUBSET)
         (mac 'subset-def)
         (let ((b (dk-di-var!))) (am-img-witness! b am-IMG) (dk-ass!)))
        ((dk-head-is? g 'IN)                                   ; I_w = f(I_v)
         (dk-cite! 'bop-id-bounded 'w)
         (am-img-intro! '(BOP-ID v)
           (lambda () (subst (dk-ctx-form '(= (f_ (BOP-ID v)) (BOP-ID w)))) (dk-cite! 'bop-id-bounded 'w) (am-rfl!))))
        ((dk-contains? g 'OP-ADJOINT)
         (let* ((b (dk-di-var!)) (a (am-img-witness! b am-IMG)) (as (list 'OP-ADJOINT 'v 'v a)))
           (am-in-s! a)
           (dk-apply! (dk-ctx-form (am-star-conj 5)) a)
           (dk-cite! 'op-adjoint-bounded 'w 'w b)
           (am-img-intro! as
             (lambda ()
               (subst (dk-apply! (am-law 'OP-ADJOINT) a))
               (subst (dk-ctx-form (list '= b (list 'f_ a))))
               (am-type! (list 'f_ a) '(BOUNDED-OPS w w))
               (dk-cite! 'op-adjoint-bounded 'w 'w (list 'f_ a))
               (am-rfl!)))))
        ((dk-contains? g 'BOP-SCALE)
         (let* ((pl (dk-peel!))
                (c (cadr (car (filter (lambda (f) (equal? (caddr f) 'CC)) pl))))
                (b (cadr (car (filter (lambda (f) (equal? (caddr f) am-IMG)) pl))))
                (a (am-img-witness! b am-IMG)))
           (am-in-s! a)
           (dk-apply! (dk-ctx-form (am-star-conj 3)) c a)
           (dk-cite! 'bop-scale-bounded 'w 'w c b)
           (am-img-intro! (list 'BOP-SCALE 'v 'v c a)
             (lambda ()
               (subst (dk-apply! (am-law 'BOP-SCALE) c a))
               (subst (dk-ctx-form (list '= b (list 'f_ a))))
               (am-type! (list 'f_ a) '(BOUNDED-OPS w w))
               (dk-cite! 'bop-scale-bounded 'w 'w c (list 'f_ a))
               (am-rfl!)))))
        (#t
         (let* ((hd (if (dk-contains? g 'BOP-SUM) 'BOP-SUM 'BOP-COMP))
                (pl (dk-peel!))
                (bs (map cadr (filter (lambda (f) (equal? (caddr f) am-IMG)) pl)))
                (b1 (car bs)) (b2 (cadr bs))
                (a1 (am-img-witness! b1 am-IMG)) (a2 (am-img-witness! b2 am-IMG)))
           (am-in-s! a1) (am-in-s! a2)
           (dk-apply! (dk-ctx-form (am-star-conj (if (eq? hd 'BOP-SUM) 2 4))) a1 a2)
           (if (eq? hd 'BOP-SUM) (dk-cite! 'bop-sum-bounded 'w 'w b1 b2) (dk-cite! 'bop-comp-bounded 'w b1 b2))
           (am-img-intro! (if (eq? hd 'BOP-SUM) (list 'BOP-SUM 'v 'v a1 a2) (list 'BOP-COMP 'v a1 a2))
             (lambda ()
               (subst (dk-apply! (am-law hd) a1 a2))
               (subst (dk-ctx-form (list '= b1 (list 'f_ a1))))
               (subst (dk-ctx-form (list '= b2 (list 'f_ a2))))
               (am-type! (list 'f_ a1) '(BOUNDED-OPS w w)) (am-type! (list 'f_ a2) '(BOUNDED-OPS w w))
               (if (eq? hd 'BOP-SUM) (dk-cite! 'bop-sum-bounded 'w 'w (list 'f_ a1) (list 'f_ a2))
                   (dk-cite! 'bop-comp-bounded 'w (list 'f_ a1) (list 'f_ a2)))
               (am-rfl!)))))))))
(am-qed! 'rep-image-star-algebra)

;;; f(s'') lies in f(s)'' along an amplification
(define am-BOw '(BOUNDED-OPS w w))
(sp (make-wff (forall-guarded '(v s w f_ t_)
   (list '(IS-HILBERT-SPACE v) am-star '(IS-AMPLIFICATION v s w f_) '(IN t_ (BICOMMUTANT v s)))
   (list 'IN '(f_ t_) (list 'BICOMMUTANT 'w am-IMG)))))
(dk-peel!)
(mac-h 'is-amplification '(IS-AMPLIFICATION v s w f_))
(dk-split-all!)
(dk-cite! 'hilbert-space-is-cips 'w) (dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'cips-vec-set 'w) (dk-cite! 'cips-vec-set 'v)
(dk-cite! 'bounded-ops-is-set 'w 'w) (dk-cite! 'bounded-ops-is-set 'v 'v)
(dk-project! (am-star-conj 0) 'is-star-op-algebra am-star)
(dk-project! '(IN f_ (FUN (BOUNDED-OPS v v) (BOUNDED-OPS w w))) 'is-star-rep '(IS-STAR-REP v w f_))
(am-bicomm-bo! 't_)
(am-ft! 't_)
(subst (dk-cite! 'bicommutant-unfold 'w am-IMG))
(let* ((ft '(f_ t_))
       (cmem (dk-cite! 'commutant-membership 'w (list 'COMMUTANT 'w am-IMG) ft))
       (rhs (caddr cmem)))
  (dk-have! rhs
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((k (dk-di-var!))
                     (kin (list 'IN k (list 'COMMUTANT 'w am-IMG)))
                     (kiff (dk-cite! 'commutant-membership 'w am-IMG k))
                     (krhs (caddr kiff)))
                (dk-have! krhs (lambda () (if (dk-only! kiff kin) (prop))))
                (dk-split! krhs)
                (dk-cite! 'bop-fun 'w 'w k)
                (let* ((lk (caddr krhs))
                       (conc (am-use-intw! 'w 'w 'f_ 'f_ 'v 's k
                               (lambda (a x)
                                 (let* ((fa (list 'f_ a)))
                                   (dk-cite! 'subset-mem-fwd 's am-BOv a)
                                   (am-ft! a)
                                   (dk-have! (list 'IN fa am-IMG) (lambda () (am-img-intro! a (lambda () (am-rfl!)))))
                                   (dk-apply! lk fa)
                                   (let ((c1 (dk-cite! 'bop-comp-apply 'w k fa x)))
                                     (subst (list '= (caddr c1) (cadr c1))))
                                   (subst (list '= (list 'BOP-COMP 'w k fa) (list 'BOP-COMP 'w fa k)))
                                   (subst (dk-cite! 'bop-comp-apply 'w fa k x))
                                   (am-type! (list fa (list k x)) '(VEC w))
                                   (am-rfl!))))))
                  (dk-cite! 'bop-comp-bounded 'w ft k) (dk-cite! 'bop-comp-bounded 'w k ft)
                  (dk-fun-ext! (list 'BOP-COMP 'w ft k) (list 'BOP-COMP 'w k ft) '(VEC w) '(VEC w)
                    (lambda () (dk-cite! 'bop-fun 'w 'w (list 'BOP-COMP 'w ft k)) (if (not (am-done?)) (dk-ass!)))
                    (lambda () (dk-cite! 'bop-fun 'w 'w (list 'BOP-COMP 'w k ft)) (if (not (am-done?)) (dk-ass!)))
                    (lambda (z)
                      (subst (dk-cite! 'bop-comp-apply 'w ft k z))
                      (subst (dk-cite! 'bop-comp-apply 'w k ft z))
                      (subst (dk-apply! conc 't_ z))
                      (am-type! (list ft (list k z)) '(VEC w))
                      (am-rfl!))))))))))
  (if (dk-only! cmem rhs) (prop)))
(am-qed! 'rep-image-bicommutant)

;;; ---------------------------------------------------------------------------------------------
;;; the separation of two operators by a vector grows along one amplification step
(define am-Cst (append am-C2 (list '(IN f_ (FUN (BOUNDED-OPS v v) (BOUNDED-OPS w w)))
                                   (list 'IN 'a_ am-BOv) (list 'IN 'b_ am-BOv) '(IN c_ (VEC w)) '(IN d_ (VEC v)))))
(define (am-dif u x y) (am-vadd u x (am-vneg u y)))
(define am-stepD (am-nrm am-HS (am-dif am-HS '(((AMP-STEP v w f_) a_) (LIST c_ d_)) '(((AMP-STEP v w f_) b_) (LIST c_ d_)))))
(define (am-step-norm! name small)
  (sp (make-wff (forall-guarded '(w v f_ a_ b_ c_ d_) am-Cst (list '<= small am-stepD))))
  (dk-peel!)
  (am-vec-sets!)
  (am-cips! am-HS)
  (dk-cite! 'bounded-ops-is-set 'w 'w) (dk-cite! 'bounded-ops-is-set 'v 'v)
  (am-ft! 'a_) (am-ft! 'b_)
  (dk-cite! 'bop-fun 'v 'v 'a_) (dk-cite! 'bop-fun 'v 'v 'b_)
  (am-amp! 'a_) (am-amp! 'b_)
  (dk-cite! 'hsum-diag-bounded 'w 'v '(f_ a_) 'a_)
  (dk-cite! 'hsum-diag-bounded 'w 'v '(f_ b_) 'b_)
  (am-dapp! '(f_ a_) 'a_ 'c_ 'd_)
  (am-dapp! '(f_ b_) 'b_ 'c_ 'd_)
  (let* ((A1 '((f_ a_) c_)) (B1 '(a_ d_)) (A2 '((f_ b_) c_)) (B2 '(b_ d_)))
    (for-each (lambda (t c) (am-type! t c)) (list A1 B1 A2 B2) '((VEC w) (VEC v) (VEC w) (VEC v)))
    (subst (dk-cite! 'hsum-vneg-pair 'w 'v A2 B2))
    (am-type! (am-vneg 'w A2) '(VEC w)) (am-type! (am-vneg 'v B2) '(VEC v))
    (subst (dk-cite! 'hsum-vadd-pair 'w 'v A1 B1 (am-vneg 'w A2) (am-vneg 'v B2)))
    (let ((P (am-dif 'w A1 A2)) (Q (am-dif 'v B1 B2)))
      (am-type! P '(VEC w)) (am-type! Q '(VEC v))
      (dk-cite! (if (equal? small (am-nrm 'w (am-dif 'w '((f_ a_) c_) '((f_ b_) c_)))) 'hsum-norm-ge-1 'hsum-norm-ge-2)
                'w 'v P Q)
      (if (not (am-done?)) (dk-ass!))))
  (am-qed! name))
(am-step-norm! 'amp-step-norm-ge-1 (am-nrm 'w (am-dif 'w '((f_ a_) c_) '((f_ b_) c_))))
(am-step-norm! 'amp-step-norm-ge-2 (am-nrm 'v (am-dif 'v '(a_ d_) '(b_ d_))))

;;; =============================================================================================
;;; Part E.  A finite set of vectors is separated by ONE vector of an amplification: for every finite
;;; G <= H there are an amplification (w, f) of s and X in w with ||S y - T y|| <= ||f(S) X - f(T) X||
;;; for all S, T in L(H) and y in G.
(define (am-gbound w f x g)
  (list 'FORALL 'cqa_ (list 'IMPLIES (list 'IN 'cqa_ am-BOv)
    (list 'FORALL 'cqb_ (list 'IMPLIES (list 'IN 'cqb_ am-BOv)
      (list 'FORALL 'cqy_ (list 'IMPLIES (list 'IN 'cqy_ g)
        (list '<= (am-nrm 'v (am-dif 'v '(cqa_ cqy_) '(cqb_ cqy_)))
                  (am-nrm w (am-dif w (list (list f 'cqa_) x) (list (list f 'cqb_) x)))))))))))
(define (am-gex g)
  (list 'FORSOME 'cqw_ (list 'AND '(IN cqw_ SET)
    (list 'FORSOME 'cqf_ (list 'AND '(IN cqf_ SET)
      (list 'AND '(IS-AMPLIFICATION v s cqw_ cqf_)
        (list 'FORSOME 'cqx_ (list 'AND '(IN cqx_ (VEC cqw_)) (am-gbound 'cqw_ 'cqf_ 'cqx_ g)))))))))
(define (am-and! p q)
  (let ((c (list 'AND p q)))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (if (not (am-done?)) (dk-ass!)))))))
    c))
(define (am-prop! claim . keep)
  (if (not (dk-asm? claim))
      (dk-have! claim (lambda () (let ((leaf (proof-state-focus *ps*)))
                                   (apply dk-only! keep)
                                   (if (not (sequent-node-grounded? leaf)) (prop))))))
  claim)
;;; close a goal (am-gex g) instantiated: witnesses by binder, BOUND! for the bound clause
(define (am-gex-close! ww ff xx bound!)
  (define (closer)
    (let ((g (dk-goal)))
      (cond ((am-done?) #t)
            ((dk-head-is? g 'FORSOME)
             (ew (case (cadr g) ((cqw_) ww) ((cqf_) ff) ((cqx_) xx) (else (error "am-gex-close!: binder" (cadr g)))))
             (dk-conj-close! closer))
            ((dk-ass!) #t)
            ((dk-head-is? g 'FORALL) (bound!))
            (#t (error "am-gex-close!: stuck at" (expression->string g))))))
  (closer))

;;; the step, as a lemma: from a separating vector for G to one for G u {z}
(define am-AMPs '(AMP-STEP v w f_))
(define am-T1 '(UNION u_ (PAIR z_ z_)))
(sp (make-wff (forall-guarded '(v s w f_ x_ u_ z_)
   (append am-Hsub (list '(IS-AMPLIFICATION v s w f_) '(IN x_ (VEC w)) '(IN z_ (VEC v)) '(SUBSET u_ (VEC v))
                         (am-gbound 'w 'f_ 'x_ 'u_)))
   (am-gex am-T1))))
(dk-peel!)
(dk-cite! 'amplification-step 'v 's 'w 'f_)
(dk-project! '(IS-HILBERT-SPACE w) 'is-amplification '(IS-AMPLIFICATION v s w f_))
(dk-project! '(IS-STAR-REP v w f_) 'is-amplification '(IS-AMPLIFICATION v s w f_))
(dk-project! '(IN f_ (FUN (BOUNDED-OPS v v) (BOUNDED-OPS w w))) 'is-star-rep '(IS-STAR-REP v w f_))
(dk-cite! 'hilbert-space-is-cips 'w) (dk-cite! 'hilbert-space-is-cips 'v)
(am-vec-sets!)
(dk-cite! 'bounded-ops-is-set 'w 'w) (dk-cite! 'bounded-ops-is-set 'v 'v)
(am-cips! am-HS)
(dk-cite! 'hsum-is-set 'w 'v)
(let ((ty (dk-cite! 'amp-step-type 'w 'v 'f_)))
  (dk-cite! 'membership-implies-sethood am-AMPs (caddr ty)))
(am-type! '(LIST x_ z_) (list 'VEC am-HS))
(define am-bU (am-gbound 'w 'f_ 'x_ 'u_))
(define am-BOhs (list 'BOUNDED-OPS am-HS am-HS))
(define (am-hs-norm-rr! a b)
  (let* ((X '(LIST x_ z_))
         (ya (list (list am-AMPs a) X)) (yb (list (list am-AMPs b) X))
         (vec (am-dif am-HS ya yb)))
    (for-each (lambda (o)
                (dk-cite! 'fun-apply-type-c am-AMPs am-BOv am-BOhs o)
                (dk-cite! 'bop-fun am-HS am-HS (list am-AMPs o))
                (dk-cite! 'fun-apply-type-c (list am-AMPs o) (list 'VEC am-HS) (list 'VEC am-HS) X))
              (list a b))
    (dk-cite! 'cips-vneg-type am-HS yb)
    (dk-cite! 'cips-vadd-type am-HS ya (am-vneg am-HS yb))
    (dk-cite! 'ip-norm-in-rr am-HS vec)))
(am-gex-close! am-HS am-AMPs '(LIST x_ z_)
  (lambda ()
    (let* ((pl (dk-peel!))
           (ops (map cadr (filter (lambda (f) (equal? (caddr f) am-BOv)) pl)))
           (a (car ops)) (b (cadr ops))
           (y (cadr (car (filter (lambda (f) (equal? (caddr f) am-T1)) pl))))
           (D (am-nrm am-HS (am-dif am-HS (list (list am-AMPs a) '(LIST x_ z_)) (list (list am-AMPs b) '(LIST x_ z_))))))
      (dk-cite! 'membership-implies-sethood 'z_ '(VEC v))
      (am-and! '(IN z_ SET) '(IN z_ SET))
      (let* ((um (dk-cite! 'union-membership 'u_ '(PAIR z_ z_) y)))
        (use-em (list 'IN y 'u_)
          (lambda ()
            (dk-cite! 'subset-mem-fwd 'u_ '(VEC v) y)
            (let* ((h1 (dk-apply! am-bU a b y))
                   (h2 (dk-cite! 'amp-step-norm-ge-1 'w 'v 'f_ a b 'x_ 'z_))
                   (va (am-dif 'v (list a y) (list b y)))
                   (vw (am-dif 'w (list (list 'f_ a) 'x_) (list (list 'f_ b) 'x_))))
              (am-ft! a) (am-ft! b)
              (am-type! va '(VEC v)) (am-type! vw '(VEC w))
              (let* ((r1 (dk-cite! 'ip-norm-in-rr 'v va))
                     (r2 (dk-cite! 'ip-norm-in-rr 'w vw))
                     (r3 (am-hs-norm-rr! a b)))
                (dk-ineq! h1 h2 r1 r2 (list 'IN D 'RR)))))
          (lambda ()
            (dk-cite! 'pairing 'z_ 'z_)
            (am-prop! (list 'IN y '(PAIR z_ z_)) um (list 'IN y am-T1) (list 'NOT (list 'IN y 'u_)))
            (let ((pm (dk-apply! (dk-cite! 'pairing-membership 'z_ 'z_) y)))
              (am-prop! (list '= y 'z_) pm (list 'IN y '(PAIR z_ z_)))
              (subst (list '= y 'z_))
              (dk-cite! 'amp-step-norm-ge-2 'w 'v 'f_ a b 'x_ 'z_)
              (if (not (am-done?)) (dk-ass!)))))))))
(am-qed! 'amp-vector-step)

;;; the induction
(define am-cls (list 'COMP 'cqg_ (list 'IMPLIES '(SUBSET cqg_ (VEC v)) (am-gex 'cqg_))))
(sp (make-wff (forall-guarded '(v s gg_)
   (append am-Hsub '((IN gg_ SET) (IN (CARD gg_) NN) (SUBSET gg_ (VEC v))))
   (am-gex 'gg_))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'cips-vec-set 'v)
(dk-cite! 'bounded-ops-is-set 'v 'v)
(dk-cite! 'empty-set-is-set)
;; base
(dk-have! (list 'IN 'EMPTY-SET am-cls)
  (lambda ()
    (for-each
      (lambda (leaf)
        (dk-focus! leaf)
        (if (equal? (dk-goal) '(IN EMPTY-SET SET))
            (dk-ass!)
            (begin
              (di)
              (dk-cite! 'is-complex-inner-product-space-is-set 'v)
              (let ((ty (dk-cite! 'id-rep-type 'v)))
                (dk-cite! 'membership-implies-sethood '(ID-REP v) (caddr ty)))
              (dk-cite! 'amplification-base 'v 's)
              (dk-cite! 'cips-vzero-in 'v)
              (am-gex-close! 'v '(ID-REP v) '(VZERO v)
                (lambda ()
                  (let* ((pl (dk-peel!))
                         (m (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'EMPTY-SET))) pl)))
                         (ne (dk-cite! 'empty-set-has-no-members (cadr m))))
                    (let ((leaf (proof-state-focus *ps*)))
                      (dk-only! m ne)
                      (if (not (sequent-node-grounded? leaf)) (prop)))))))))
      (dk-opened (lambda () (comp-mi))))))
;; step
(define am-stp
  (list 'FORALL 'cqu_
    (list 'IMPLIES (list 'AND '(IN cqu_ SET) (list 'AND '(IN (CARD cqu_) NN) (list 'IN 'cqu_ am-cls)))
      (list 'FORALL 'cqz_
        (list 'IMPLIES '(AND (IN cqz_ SET) (NOT (IN cqz_ cqu_)))
              (list 'IN '(UNION cqu_ (PAIR cqz_ cqz_)) am-cls))))))
(dk-have! am-stp
  (lambda ()
    (dk-split-all! (dk-peel!))
    (let* ((gl (dk-goal))
           (t1 (cadr gl))
           (u  (cadr t1))
           (z  (cadr (caddr t1)))
           (pr (list 'PAIR z z))
           (ih (dk-landed-find (lambda () (comp-me (list 'IN u am-cls))) (dk-head? 'IMPLIES))))
      (am-and! (list 'IN z 'SET) (list 'IN z 'SET))
      (dk-cite! 'pairing z z)
      (am-and! (list 'IN u 'SET) (list 'IN pr 'SET))
      (dk-cite! 'union-set-closure u pr)
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (equal? (dk-goal) (list 'IN t1 'SET))
             (dk-ass!)
             (begin
               (di)
               ;; u <= H and z in H
               (dk-have! (list 'SUBSET u '(VEC v))
                 (lambda ()
                   (mac 'subset-def)
                   (let* ((y (dk-di-var!))
                          (um (dk-cite! 'union-membership u pr y)))
                     (am-prop! (list 'IN y t1) um (list 'IN y u))
                     (dk-cite! 'subset-mem-fwd t1 '(VEC v) y)
                     (if (not (am-done?)) (dk-ass!)))))
               (let ((pm (dk-apply! (dk-cite! 'pairing-membership z z) z)))
                 (dk-have! (list '= z z) (lambda () (rfl)))
                 (am-prop! (list 'IN z pr) pm (list '= z z)))
               (let ((um (dk-cite! 'union-membership u pr z)))
                 (am-prop! (list 'IN z t1) um (list 'IN z pr)))
               (dk-cite! 'subset-mem-fwd t1 '(VEC v) z)
               ;; the hypothesis for u
               (detach! ih)
               (let* ((ex (caddr ih))
                      (w (dk-skolem! ex #t))
                      (exf (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'cqf_) (dk-contains? h w))) "f"))
                      (f (dk-skolem! exf #t)))
                 (dk-split-all!)
                 (let* ((exx (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'cqx_) (dk-contains? h f))) "X"))
                        (x (dk-skolem! exx #t)))
                   (dk-split-all!)
                   (dk-cite! 'amp-vector-step 'v 's w f x u z)
                   (if (not (am-done?)) (dk-ass!)))))))
       (dk-opened (lambda () (comp-mi)))))))
(dk-have! (list 'AND (list 'IN 'EMPTY-SET am-cls) am-stp)
          (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
(let ((ind (dk-fact! 'finite-set-induction am-cls)))
  (am-and! '(IN gg_ SET) '(IN (CARD gg_) NN))
  (let* ((inw (dk-apply! ind 'gg_))
         (body (dk-landed-find (lambda () (comp-me inw)) (dk-head? 'IMPLIES))))
    (detach! body)
    (if (not (am-done?)) (dk-ass!))))
(am-qed! 'amp-vector-exists)

;;; =============================================================================================
;;; Part F.  Density on finite sets: an operator of s'' agrees with some a in s up to eps on a finite set
(define (am-approx g t eps)
  (list 'FORSOME 'cqa_ (list 'AND '(IN cqa_ s)
    (list 'FORALL 'cqy_ (list 'IMPLIES (list 'IN 'cqy_ g)
      (list '< (am-nrm 'v (am-dif 'v (list t 'cqy_) '(cqa_ cqy_))) eps))))))
(define am-MMw (list 'SEP 'vqm_ '(VEC w) (list 'FORSOME 'vqb_ (list 'AND (list 'IN 'vqb_ am-IMG) '(= vqm_ (vqb_ x_))))))
(sp (make-wff (forall-guarded '(v s w f_ x_ gg_ t_ eps)
   (list '(IS-HILBERT-SPACE v) am-star '(IS-AMPLIFICATION v s w f_) '(IN x_ (VEC w)) '(SUBSET gg_ (VEC v))
         (am-gbound 'w 'f_ 'x_ 'gg_) '(IN t_ (BICOMMUTANT v s)) '(POS-RR eps))
   (am-approx 'gg_ 't_ 'eps))))
(dk-peel!)
(dk-project! '(IS-HILBERT-SPACE w) 'is-amplification '(IS-AMPLIFICATION v s w f_))
(dk-project! '(IS-STAR-REP v w f_) 'is-amplification '(IS-AMPLIFICATION v s w f_))
(dk-cite! 'hilbert-space-is-cips 'w) (dk-cite! 'hilbert-space-is-cips 'v)
(am-vec-sets!)
(dk-cite! 'bounded-ops-is-set 'w 'w) (dk-cite! 'bounded-ops-is-set 'v 'v)
(dk-project! (am-star-conj 0) 'is-star-op-algebra am-star)
(dk-cite! 'rep-image-star-algebra 'v 'w 'f_ 's)
(dk-cite! 'rep-image-bicommutant 'v 's 'w 'f_ 't_)
(dk-project! '(IN f_ (FUN (BOUNDED-OPS v v) (BOUNDED-OPS w w))) 'is-star-rep '(IS-STAR-REP v w f_))
(am-bicomm-bo! 't_)
(am-ft! 't_)
(define am-z0 '((f_ t_) x_))
(am-type! am-z0 '(VEC w))
(dk-cite! 'bicommutant-vector-closure 'w am-IMG 'x_ '(f_ t_))
(dk-cite! 'ip-metric-space-is-metric-space 'w)
(let* ((ex (dk-cite! 'fom-closure-near '(IP-METRIC-SPACE w) am-MMw am-z0 'eps))
       (m (dk-skolem! ex #t))
       (inm (list 'IN m am-MMw))
       (ltd (dk-pick (lambda (h) (and (dk-head-is? h '<) (dk-contains? h m) (dk-contains? h 'DIST))) "the distance")))
  (sep-me inm)
  (dk-split-all!)
  (let* ((exb (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'vqb_) (dk-contains? h m))) "b"))
         (b (dk-skolem! exb #t))
         (a (am-img-witness! b am-IMG)))
    (dk-split-all!)
    (dk-cite! 'subset-mem-fwd 's am-BOv a)
    (am-ft! a)
    (let* ((e1 (dk-cite! 'ipms-dist-norm 'w am-z0 m))
           (h2 (am-rw-h! ltd e1 (list '= m (list b 'x_)) (list '= b (list 'f_ a))))
           (bnd (am-gbound 'w 'f_ 'x_ 'gg_)))
      (ew a)
      (dk-conj-close!
        (lambda ()
          (cond ((am-done?) #t)
                ((dk-ass!) #t)
                (#t
                 (let* ((y (dk-di-var!))
                        (h1 (dk-apply! bnd 't_ a y))
                        (va (am-dif 'v (list 't_ y) (list a y)))
                        (vw (am-dif 'w am-z0 (list (list 'f_ a) 'x_))))
                   (dk-cite! 'subset-mem-fwd 'gg_ '(VEC v) y)
                   (am-type! va '(VEC v)) (am-type! vw '(VEC w))
                   (let* ((r1 (dk-cite! 'ip-norm-in-rr 'v va))
                          (r2 (dk-cite! 'ip-norm-in-rr 'w vw))
                          (r3 (dk-cite! 'rr-pos-rr-in-rr 'eps)))
                     (dk-ineq! h1 h2 r1 r2 r3))))))))))
(am-qed! 'bicommutant-approx-at)

(sp (make-wff (forall-guarded '(v s gg_ t_ eps)
   (list '(IS-HILBERT-SPACE v) am-star '(IN gg_ SET) '(IN (CARD gg_) NN) '(SUBSET gg_ (VEC v))
         '(IN t_ (BICOMMUTANT v s)) '(POS-RR eps))
   (am-approx 'gg_ 't_ 'eps))))
(dk-peel!)
(dk-project! (am-star-conj 0) 'is-star-op-algebra am-star)
(let* ((ex (dk-cite! 'amp-vector-exists 'v 's 'gg_))
       (w (dk-skolem! ex #t))
       (exf (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'cqf_) (dk-contains? h w))) "f"))
       (f (dk-skolem! exf #t)))
  (dk-split-all!)
  (let* ((exx (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'cqx_) (dk-contains? h f))) "X"))
         (x (dk-skolem! exx #t)))
    (dk-split-all!)
    (dk-cite! 'bicommutant-approx-at 'v 's w f x 'gg_ 't_ 'eps)
    (if (not (am-done?)) (dk-ass!))))
(am-qed! 'bicommutant-finite-approx)

;;; =============================================================================================
;;; Part G.  Theorem 6.1 (von Neumann's bicommutant theorem): for a unital *-algebra s of operators on a
;;; Hilbert space, s'' is the closure of s in the strong operator topology.
(sp (make-wff '(FORALL v (FORALL x_ (FORALL y_ (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v)
   (IMPLIES (IN x_ (VEC v)) (IMPLIES (IN y_ (VEC v))
     (= (IP-NORM v ((VADD v) x_ ((VNEG v) y_))) (IP-NORM v ((VADD v) y_ ((VNEG v) x_))))))))))))
(dk-peel!)
(dk-cite! 'ip-metric-space-is-metric-space 'v)
(let* ((e1 (dk-cite! 'ipms-dist-norm 'v 'x_ 'y_))
       (e2 (dk-cite! 'ipms-dist-norm 'v 'y_ 'x_))
       (pe (dk-cite! 'ip-metric-space-pts 'v))
       (sy (dk-cite! 'metric-sym '(IP-METRIC-SPACE v)))
