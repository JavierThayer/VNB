(am-qed! 'hsum-diag-sum)

;;; k (a (+) b) = (k a) (+) (k b)
(sp (make-wff (forall-guarded '(w v a_ b_ k_) (append am-C2 '((IN a_ (BOUNDED-OPS w w)) (IN b_ (BOUNDED-OPS v v)) (IN k_ CC)))
   (list '= (list 'BOP-SCALE am-HS am-HS 'k_ (am-diag 'a_ 'b_)) (am-diag '(BOP-SCALE w w k_ a_) '(BOP-SCALE v v k_ b_))))))
