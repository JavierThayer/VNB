           (list (list 'SUBSET 's am-BOv) '(IS-INTERTWINED w u f_ r_ v s) '(IS-INTERTWINED v u (ID-REP v) r_ v s)))
   '(IS-INTERTWINED (HSUM w v) u (AMP-STEP v w f_) r_ v s))))
(dk-peel!)
