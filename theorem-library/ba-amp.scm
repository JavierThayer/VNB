;;; c 0 = 0 in a complex inner product space
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v) (FORALL c_ (IMPLIES (IN c_ CC)
                 (= ((ACT v) c_ (VZERO v)) (VZERO v))))))))
(dk-peel!)
