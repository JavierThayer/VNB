;;; values of the injections, projections and diagonal operators
(define (am-value-thm! name vars guards lhs rhs fn)
  (sp (make-wff (forall-guarded (append '(w v) vars) (append am-C2 guards) (list '= lhs rhs))))
  (dk-peel!)
  (dk-cite! 'cips-vzero-in 'w) (dk-cite! 'cips-vzero-in 'v)
  (dk-cite! 'cips-vec-set 'w) (dk-cite! 'cips-vec-set 'v)
  (if (and (memq 'x_ vars) (memq 'y_ vars)) (am-type! '(LIST x_ y_) am-HV))
  (mac fn)
  (dk-lam-b!)
  (am-nth!)
  (if (not (am-done?))
      (begin (for-each (lambda (h) (if (and (dk-head-is? h 'IN) (dk-head-is? (caddr h) 'FUN))
                                       (am-type! (list (cadr h) (if (eq? (cadr h) 'a_) 'x_ 'y_)) (caddr (caddr h)))))
                       (filter (lambda (h) (and (dk-head-is? h 'IN) (memq (cadr h) '(a_ b_)))) (dk-asms)))
             (am-rfl!)))
  (am-qed! name))
(am-value-thm! 'hsum-in1-apply '(x_) '((IN x_ (VEC w))) '((HSUM-IN1 w v) x_) '(LIST x_ (VZERO v)) 'HSUM-IN1)
(am-value-thm! 'hsum-in2-apply '(y_) '((IN y_ (VEC v))) '((HSUM-IN2 w v) y_) '(LIST (VZERO w) y_) 'HSUM-IN2)
(am-value-thm! 'hsum-pr1-apply '(x_ y_) '((IN x_ (VEC w)) (IN y_ (VEC v))) '((HSUM-PR1 w v) (LIST x_ y_)) 'x_ 'HSUM-PR1)
(am-value-thm! 'hsum-pr2-apply '(x_ y_) '((IN x_ (VEC w)) (IN y_ (VEC v))) '((HSUM-PR2 w v) (LIST x_ y_)) 'y_ 'HSUM-PR2)
(am-value-thm! 'hsum-diag-apply '(a_ b_ x_ y_)
  '((IN a_ (FUN (VEC w) (VEC w))) (IN b_ (FUN (VEC v) (VEC v))) (IN x_ (VEC w)) (IN y_ (VEC v)))
  '((HSUM-DIAG w v a_ b_) (LIST x_ y_)) '(LIST (a_ x_) (b_ y_)) 'HSUM-DIAG)

;;; (x, y) = (x, 0) + (0, y)
(sp (make-wff (forall-guarded '(w v x_ y_) (append am-C2 '((IN x_ (VEC w)) (IN y_ (VEC v))))
   (list '= '(LIST x_ y_) (am-vadd am-HS '(LIST x_ (VZERO v)) '(LIST (VZERO w) y_))))))
(dk-peel!)
(dk-cite! 'cips-vzero-in 'w) (dk-cite! 'cips-vzero-in 'v)
(subst (dk-cite! 'hsum-vadd-pair 'w 'v 'x_ '(VZERO v) '(VZERO w) 'y_))
(subst (dk-cite! 'cips-vadd-vzero-right 'w 'x_))
(subst (dk-cite! 'cips-vadd-vzero 'v 'y_))
(am-rfl!)
(am-qed! 'hsum-pair-split)

;;; ||(a, b)||^2 = ||a||^2 + ||b||^2, and the two bounds
(define am-N '(IP-NORM (HSUM w v) (LIST a_ b_)))
(define am-A '(IP-NORM w a_))
(define am-B '(IP-NORM v b_))
(define am-C2ab (append am-C2 '((IN a_ (VEC w)) (IN b_ (VEC v)))))
(define (am-norm-setup!)
  (dk-peel!)
  (am-cips! am-HS)
  (am-type! '(LIST a_ b_) '(VEC (HSUM w v)))
  (for-each (lambda (u x) (dk-cite! 'ip-norm-in-rr u x) (dk-cite! 'ip-norm-nonneg u x))
            (list am-HS 'w 'v) '((LIST a_ b_) a_ b_)))
(sp (make-wff (forall-guarded '(w v a_ b_) am-C2ab
   (list '= (list '* am-N am-N) (list '+ (list '* am-A am-A) (list '* am-B am-B))))))
(am-norm-setup!)
(subst (dk-cite! 'ip-norm-sq am-HS '(LIST a_ b_)))
(subst (dk-cite! 'hsum-ip-pair 'w 'v 'a_ 'b_ 'a_ 'b_))
(let* ((ea (dk-cite! 'ip-norm-sq 'w 'a_)) (eb (dk-cite! 'ip-norm-sq 'v 'b_)))
  (subst (list '= (caddr ea) (cadr ea)))
  (subst (list '= (caddr eb) (cadr eb))))
(am-rfl!)
(am-qed! 'hsum-norm-pair-sq)

(define (am-norm-ge! name small)
  (sp (make-wff (forall-guarded '(w v a_ b_) am-C2ab (list '<= small am-N))))
  (am-norm-setup!)
  (let ((e (dk-cite! 'hsum-norm-pair-sq 'w 'v 'a_ 'b_))
        (other (if (equal? small am-A) am-B am-A)))
    (dk-cite! 'rr-sq-nonneg other)
    (dk-have! (list '<= (list '* small small) (list '* am-N am-N))
      (lambda () (am-ineq! (list (list '* small small) (list '* other other) (list '* am-N am-N))
                           (list e (list '<= 0 (list '* other other))) '())))
    (dk-cite! 'rr-le-of-sq-le small am-N)
    (if (not (am-done?)) (dk-ass!)))
  (am-qed! name))
(am-norm-ge! 'hsum-norm-ge-1 am-A)
(am-norm-ge! 'hsum-norm-ge-2 am-B)

(sp (make-wff (forall-guarded '(w v a_ b_) am-C2ab (list '<= am-N (list '+ am-A am-B)))))
(am-norm-setup!)
(let ((e (dk-cite! 'hsum-norm-pair-sq 'w 'v 'a_ 'b_))
      (s (list '+ am-A am-B)))
  (dk-cite! 'cvx-mul-nonneg am-A am-B)
  (dk-cite! 'rr-sq-nonneg am-A) (dk-cite! 'rr-sq-nonneg am-B)
  (dk-have! (list '= (list '* s s) (list '+ (list '+ (list '* am-A am-A) (list '* am-B am-B)) (list '* 2 (list '* am-A am-B))))
    (lambda () (crs)))
  (dk-real! s)
  (dk-have! (list '<= (list '* am-N am-N) (list '* s s))
    (lambda () (am-ineq! (list (list '* s s) (list '* am-A am-B) (list '* am-A am-A) (list '* am-B am-B) (list '* am-N am-N))
                         (list e (list '= (list '* s s) (list '+ (list '+ (list '* am-A am-A) (list '* am-B am-B)) (list '* 2 (list '* am-A am-B))))
                               (list '<= 0 (list '* am-A am-B))
                               (list '<= 0 (list '* am-A am-A)) (list '<= 0 (list '* am-B am-B)))
                         '())))
  (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list '<= 0 am-A) (list '<= 0 am-B) (list 'IN am-A 'RR) (list 'IN am-B 'RR))))
  (dk-cite! 'rr-le-of-sq-le am-N s)
  (if (not (am-done?)) (dk-ass!)))
(am-qed! 'hsum-norm-le-sum)

