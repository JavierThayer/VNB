  (subst (list '= (caddr e1) (cadr e1)))
  (subst (list '= (caddr e2) (cadr e2)))
  (if (not (am-done?)) (dk-ass!)))
(am-qed! 'ip-norm-diff-sym)

(define (am-tc-sep q a)
  (list 'SEP 'otx_ (list 'PTS q)
    (list 'FORALL 'otu_ (list 'IMPLIES (list 'IN 'otu_ (list 'OPENS q))
      (list 'IMPLIES '(IN otx_ otu_) (list 'FORSOME 'oty_ (list 'AND (list 'IN 'oty_ a) '(IN oty_ otu_))))))))
(sp (make-wff (list 'FORALL 'q_ (list 'FORALL 'a_ (list '== '(TOP-CLOSURE q_ a_) (am-tc-sep 'q_ 'a_))))))
(dk-peel!) (mac 'TOP-CLOSURE) (qrfl)
(am-qed! 'top-closure-unfold)

(define am-SOT '(SOT v))
(define am-TC '(TOP-CLOSURE (SOT v) s))
