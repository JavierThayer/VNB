(am-op-ext! (list 'BOP-SUM am-HS am-HS (am-diag 'a_ 'b_) (am-diag 'c_ 'd_)) (am-diag '(BOP-SUM w w a_ c_) '(BOP-SUM v v b_ d_))
  (lambda (p1 p2)
    (am-type! (am-pr p1 p2) '(VEC (HSUM w v)))
    (subst (dk-cite! 'bop-sum-apply am-HS am-HS (am-diag 'a_ 'b_) (am-diag 'c_ 'd_) (am-pr p1 p2)))
    (am-dapp! 'a_ 'b_ p1 p2) (am-dapp! 'c_ 'd_ p1 p2) (am-dapp! '(BOP-SUM w w a_ c_) '(BOP-SUM v v b_ d_) p1 p2)
    (for-each (lambda (t c) (am-type! t c)) (list (list 'a_ p1) (list 'c_ p1) (list 'b_ p2) (list 'd_ p2)) '((VEC w) (VEC w) (VEC v) (VEC v)))
    (subst (dk-cite! 'hsum-vadd-pair 'w 'v (list 'a_ p1) (list 'b_ p2) (list 'c_ p1) (list 'd_ p2)))
    (subst (dk-cite! 'bop-sum-apply 'w 'w 'a_ 'c_ p1))
