;;; composites of operators between different spaces
(sp (make-wff (forall-guarded '(ua ub uc s_ t_ x_)
   '((IN t_ (FUN (VEC ua) (VEC ub))) (IN s_ (FUN (VEC ub) (VEC uc))) (IN x_ (VEC ua)))
   '(= ((BOP-COMP ua s_ t_) x_) (s_ (t_ x_))))))
(dk-peel!)
(mac 'BOP-COMP)
(dk-lam-b!)
(if (not (am-done?))
    (begin (dk-cite! 'fun-apply-type-c 't_ '(VEC ua) '(VEC ub) 'x_)
           (dk-cite! 'fun-apply-type-c 's_ '(VEC ub) '(VEC uc) '(t_ x_))
           (am-rfl!)))
(am-qed! 'bop-comp-apply-gen)

;;; for a pair variable p of w (+) v in context: its NTH typings, and the goal rewritten with p = (p1, p2)
(define (am-pairify! p u)
  (let ((cart (am-cart-of u)))
    (am-type! p cart)
    (dk-split! (dk-cite! 'cartesian-nth p (cadr cart) (caddr cart)))
    (let ((e (dk-cite! 'cartesian-pair-eq p (cadr cart) (caddr cart))))
      (subst e)
      (list (list 'NTH 1 p) (list 'NTH 2 p)))))

;;; the introduction of a bounded operator OP : u1 -> u2.  TYPE! proves (IN OP (FUN (VEC u1) (VEC u2)));
;;; ADD! and ACT! prove the additivity / homogeneity goal for the peeled vectors (x y) / (c x);
;;; M is the bound and BOUND! proves (<= (IP-NORM u2 (OP x)) (* M (IP-NORM u1 x))) for the peeled x.
(define (am-bop-intro! u1 u2 op type! add! act! m mtype! bound!)
  (dk-have! (list 'IS-LINEAR-OP u1 u2 op)
    (lambda ()
      (mac 'is-linear-op)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((am-done?) #t)
                  ((dk-head-is? g 'IN) (type!))
                  ((dk-contains? g 'ACT)
                   (let ((pl (dk-peel!))) (act! (cadr (car pl)) (cadr (cadr pl)))))
                  (#t (let ((pl (dk-peel!))) (add! (cadr (car pl)) (cadr (cadr pl)))))))))))
  (mtype!)
  (dk-have! (list 'FORALL 'box_ (list 'IMPLIES (list 'IN 'box_ (list 'VEC u1))
                   (list '<= (list 'IP-NORM u2 (list op 'box_)) (list '* m (list 'IP-NORM u1 'box_)))))
    (lambda () (let ((x (dk-di-var!))) (bound! x))))
  (dk-cite! 'bop-intro u1 u2 op m)
  (if (not (am-done?)) (dk-ass!)))

;;; the typing of a lambda operator term by its functoid unfold and lam-t
(define (am-lam-type! fn typer)
  (mac fn)
  (dk-lam-type!
    (lambda () (dk-peel!) (typer) (if (not (am-done?)) (dk-ass!)))
    (lambda () (cond ((am-done?) #t)
                     ((dk-head-is? (cadr (dk-goal)) 'CARTESIAN)
                      (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))
                     (#t (ass))))))

(define (am-vec-sets!)
  (dk-cite! 'cips-vec-set 'w) (dk-cite! 'cips-vec-set 'v)
  (dk-cite! 'cips-vzero-in 'w) (dk-cite! 'cips-vzero-in 'v)
  (am-cips! am-HS))

;;; ---- the injections are bounded
(define (am-in-bounded! name fn in-space other first?)
  (sp (make-wff (forall-guarded '(w v) am-C2 (list 'IN (list fn 'w 'v) (list 'BOUNDED-OPS in-space am-HS)))))
  (dk-peel!)
  (am-vec-sets!)
  (let* ((op (list fn 'w 'v))
         (apply-name (if first? 'hsum-in1-apply 'hsum-in2-apply))
         (val (lambda (x) (dk-cite! apply-name 'w 'v x)))
         (pr (lambda (x z) (if first? (am-pr x z) (am-pr z x))))
         (z (list 'VZERO other)))
    (am-bop-intro! in-space am-HS op
      (lambda ()
        (am-hsum-eq! am-HS)
        (subst (am-hsum-eq! am-HS))
        (am-lam-type! fn (lambda () (am-type! (cadr (dk-goal)) (caddr (dk-goal))))))
      (lambda (x y)
        (am-type! (am-vadd in-space x y) (list 'VEC in-space))
        (subst (val (am-vadd in-space x y))) (subst (val x)) (subst (val y))
        (am-type! (pr x z) am-HV) (am-type! (pr y z) am-HV)
        (subst (if first? (dk-cite! 'hsum-vadd-pair 'w 'v x z y z) (dk-cite! 'hsum-vadd-pair 'w 'v z x z y)))
        (subst (if first? (dk-cite! 'cips-vadd-vzero-right 'v z) (dk-cite! 'cips-vadd-vzero-right 'w z)))
        (am-type! (am-vadd in-space x y) (list 'VEC in-space))
        (am-rfl!))
      (lambda (c x)
        (am-type! (am-act in-space c x) (list 'VEC in-space))
        (subst (val (am-act in-space c x))) (subst (val x))
        (subst (if first? (dk-cite! 'hsum-act-pair 'w 'v c x z) (dk-cite! 'hsum-act-pair 'w 'v c z x)))
        (subst (dk-cite! 'cips-act-vzero other c))
        (am-type! (am-act in-space c x) (list 'VEC in-space))
        (am-rfl!))
      1 (lambda () #t)
      (lambda (x)
        (subst (val x))
        (let* ((le (if first? (dk-cite! 'hsum-norm-le-sum 'w 'v x z) (dk-cite! 'hsum-norm-le-sum 'w 'v z x)))
              (nz (dk-cite! 'ip-norm-zero other)))
          (am-type! (pr x z) '(VEC (HSUM w v)))
          (dk-cite! 'ip-norm-in-rr in-space x) (dk-cite! 'ip-norm-in-rr am-HS (pr x z)) (dk-cite! 'ip-norm-in-rr other z)
          (dk-ineq! le nz (list 'IN (list 'IP-NORM in-space x) 'RR) (list 'IN (list 'IP-NORM am-HS (pr x z)) 'RR)
                    (list 'IN (list 'IP-NORM other z) 'RR))))))
  (am-qed! name))
(am-in-bounded! 'hsum-in1-bounded 'HSUM-IN1 'w 'v #t)
(am-in-bounded! 'hsum-in2-bounded 'HSUM-IN2 'v 'w #f)

;;; ---- the projections are bounded
(define (am-pr-bounded! name fn out-space first?)
  (sp (make-wff (forall-guarded '(w v) am-C2 (list 'IN (list fn 'w 'v) (list 'BOUNDED-OPS am-HS out-space)))))
  (dk-peel!)
  (am-vec-sets!)
  (let* ((op (list fn 'w 'v))
         (apply-name (if first? 'hsum-pr1-apply 'hsum-pr2-apply))
         (val (lambda (pq) (dk-cite! apply-name 'w 'v (car pq) (cadr pq))))
         (pick (lambda (pq) (if first? (car pq) (cadr pq)))))
    (am-bop-intro! am-HS out-space op
      (lambda ()
        (subst (am-hsum-eq! am-HS))
        (am-lam-type! fn (lambda ()
                           (let* ((g (dk-goal)) (p (caddr (cadr g))))
                             (dk-split! (dk-cite! 'cartesian-nth p '(VEC w) '(VEC v)))))))
      (lambda (x y)
        (let* ((px (am-pairify! x am-HS)) (py (am-pairify! y am-HS)))
          (subst (dk-cite! 'hsum-vadd-pair 'w 'v (car px) (cadr px) (car py) (cadr py)))
          (let ((s1 (am-vadd 'w (car px) (car py))) (s2 (am-vadd 'v (cadr px) (cadr py))))
            (am-type! s1 '(VEC w)) (am-type! s2 '(VEC v))
            (subst (val (list s1 s2))))
          (subst (val px)) (subst (val py))
          (am-type! (am-vadd out-space (pick px) (pick py)) (list 'VEC out-space))
          (am-rfl!)))
      (lambda (c x)
        (let* ((px (am-pairify! x am-HS)))
          (subst (dk-cite! 'hsum-act-pair 'w 'v c (car px) (cadr px)))
          (let ((s1 (am-act 'w c (car px))) (s2 (am-act 'v c (cadr px))))
            (am-type! s1 '(VEC w)) (am-type! s2 '(VEC v))
            (subst (val (list s1 s2))))
          (subst (val px))
          (am-type! (am-act out-space c (pick px)) (list 'VEC out-space))
          (am-rfl!)))
      1 (lambda () #t)
      (lambda (x)
        (let* ((px (am-pairify! x am-HS)))
          (subst (val px))
          (let* ((ge (dk-cite! (if first? 'hsum-norm-ge-1 'hsum-norm-ge-2) 'w 'v (car px) (cadr px))))
            (am-type! (am-pr (car px) (cadr px)) '(VEC (HSUM w v)))
            (dk-cite! 'ip-norm-in-rr out-space (pick px)) (dk-cite! 'ip-norm-in-rr am-HS (am-pr (car px) (cadr px)))
            (dk-ineq! ge (list 'IN (list 'IP-NORM out-space (pick px)) 'RR)
                      (list 'IN (list 'IP-NORM am-HS (am-pr (car px) (cadr px))) 'RR)))))))
  (am-qed! name))
(am-pr-bounded! 'hsum-pr1-bounded 'HSUM-PR1 'w #t)
(am-pr-bounded! 'hsum-pr2-bounded 'HSUM-PR2 'v #f)

;;; the bound of a <= chain through products: (<= LHS (* c x)) etc. -- land (<= (* c x) (* c y)) from x <= y
(define (am-scale-le! c x y)
  (dk-have! (list 'AND (list '<= 0 c) (list '<= x y)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
  (dk-cite! 'rr-le-scale-nonneg c x y))

;;; ---- the composite of bounded operators is bounded
(sp (make-wff (forall-guarded '(ua ub uc s_ t_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE ua) (IS-COMPLEX-INNER-PRODUCT-SPACE ub) (IS-COMPLEX-INNER-PRODUCT-SPACE uc)
     (IN t_ (BOUNDED-OPS ua ub)) (IN s_ (BOUNDED-OPS ub uc)))
   '(IN (BOP-COMP ua s_ t_) (BOUNDED-OPS ua uc)))))
(dk-peel!)
(dk-cite! 'bop-fun 'ua 'ub 't_) (dk-cite! 'bop-fun 'ub 'uc 's_)
(dk-cite! 'cips-vec-set 'ua) (dk-cite! 'cips-vec-set 'ub) (dk-cite! 'cips-vec-set 'uc)
(define am-ns '(OPNORM ub uc s_))
(define am-nt '(OPNORM ua ub t_))
(let* ((op '(BOP-COMP ua s_ t_))
       (val (lambda (x) (dk-cite! 'bop-comp-apply-gen 'ua 'ub 'uc 's_ 't_ x))))
  (am-bop-intro! 'ua 'uc op
    (lambda ()
      (am-lam-type! 'BOP-COMP (lambda () (am-type! (cadr (dk-goal)) (caddr (dk-goal))))))
    (lambda (x y)
      (am-type! (am-vadd 'ua x y) '(VEC ua))
      (subst (val (am-vadd 'ua x y))) (subst (val x)) (subst (val y))
      (subst (dk-cite! 'bop-add 'ua 'ub 't_ x y))
      (am-type! (list 't_ x) '(VEC ub)) (am-type! (list 't_ y) '(VEC ub))
      (subst (dk-cite! 'bop-add 'ub 'uc 's_ (list 't_ x) (list 't_ y)))
      (am-type! (list 's_ (list 't_ x)) '(VEC uc)) (am-type! (list 's_ (list 't_ y)) '(VEC uc))
      (am-type! (am-vadd 'uc (list 's_ (list 't_ x)) (list 's_ (list 't_ y))) '(VEC uc))
      (am-rfl!))
    (lambda (c x)
      (am-type! (am-act 'ua c x) '(VEC ua))
      (subst (val (am-act 'ua c x))) (subst (val x))
      (subst (dk-cite! 'bop-act 'ua 'ub 't_ c x))
      (am-type! (list 't_ x) '(VEC ub))
      (subst (dk-cite! 'bop-act 'ub 'uc 's_ c (list 't_ x)))
      (am-type! (am-act 'uc c (list 's_ (list 't_ x))) '(VEC uc))
      (am-rfl!))
    (list '* am-ns am-nt)
    (lambda ()
      (dk-cite! 'opnorm-in-rr 'ub 'uc 's_) (dk-cite! 'opnorm-nonneg 'ub 'uc 's_)
      (dk-cite! 'opnorm-in-rr 'ua 'ub 't_) (dk-cite! 'opnorm-nonneg 'ua 'ub 't_)
      (dk-real! (list '* am-ns am-nt))
      (dk-cite! 'cvx-mul-nonneg am-ns am-nt))
    (lambda (x)
      (subst (val x))
      (let* ((tx (list 't_ x)) (ntx (am-nrm 'ub tx)) (nx (am-nrm 'ua x)))
        (am-type! tx '(VEC ub))
        (am-type! (list 's_ tx) '(VEC uc))
        (dk-cite! 'ip-norm-in-rr 'ub tx) (dk-cite! 'ip-norm-in-rr 'ua x) (dk-cite! 'ip-norm-in-rr 'uc (list 's_ tx))
        (dk-cite! 'ip-norm-nonneg 'ub tx) (dk-cite! 'ip-norm-nonneg 'ua x)
        (let* ((b1 (dk-apply! (dk-cite! 'opnorm-bound 'ub 'uc 's_) tx))
               (b2 (dk-apply! (dk-cite! 'opnorm-bound 'ua 'ub 't_) x)))
          (dk-real! (list '* am-nt nx))
          (let* ((b3 (am-scale-le! am-ns ntx (list '* am-nt nx)))
                 (e (dk-have! (list '= (list '* am-ns (list '* am-nt nx)) (list '* (list '* am-ns am-nt) nx)) (lambda () (crs)))))
            (am-ineq! (list (list '* am-ns ntx) (list '* am-ns (list '* am-nt nx)) (list '* (list '* am-ns am-nt) nx))
                      (list b1 b3 (list '= (list '* am-ns (list '* am-nt nx)) (list '* (list '* am-ns am-nt) nx)))
                      (list (list 'IN (am-nrm 'uc (list 's_ tx)) 'RR) (list 'IN ntx 'RR)))))))))
(am-qed! 'bop-comp-bounded-gen)

;;; ---- the diagonal operator a (+) b is bounded
(define am-Cab (append am-C2 '((IN a_ (BOUNDED-OPS w w)) (IN b_ (BOUNDED-OPS v v)))))
(sp (make-wff (forall-guarded '(w v a_ b_) am-Cab '(IN (HSUM-DIAG w v a_ b_) (BOUNDED-OPS (HSUM w v) (HSUM w v))))))
(dk-peel!)
(am-vec-sets!)
(dk-cite! 'bop-fun 'w 'w 'a_) (dk-cite! 'bop-fun 'v 'v 'b_)
(define am-na '(OPNORM w w a_))
(define am-nb '(OPNORM v v b_))
(define (am-diag-val! pq) (dk-cite! 'hsum-diag-apply 'w 'v 'a_ 'b_ (car pq) (cadr pq)))
(let* ((op '(HSUM-DIAG w v a_ b_)))
  (am-bop-intro! am-HS am-HS op
    (lambda ()
      (subst (am-hsum-eq! am-HS))
      (am-lam-type! 'HSUM-DIAG
        (lambda ()
          (let* ((g (dk-goal)) (p (caddr (cadr (cadr (cadr g))))))
            (dk-split! (dk-cite! 'cartesian-nth p '(VEC w) '(VEC v)))
            (am-type! (cadr g) (caddr g))))))
    (lambda (x y)
      (let* ((px (am-pairify! x am-HS)) (py (am-pairify! y am-HS)))
        (subst (dk-cite! 'hsum-vadd-pair 'w 'v (car px) (cadr px) (car py) (cadr py)))
        (let ((s1 (am-vadd 'w (car px) (car py))) (s2 (am-vadd 'v (cadr px) (cadr py))))
          (am-type! s1 '(VEC w)) (am-type! s2 '(VEC v))
          (subst (am-diag-val! (list s1 s2)))
          (subst (am-diag-val! px)) (subst (am-diag-val! py))
          (subst (dk-cite! 'bop-add 'w 'w 'a_ (car px) (car py)))
          (subst (dk-cite! 'bop-add 'v 'v 'b_ (cadr px) (cadr py)))
          (for-each (lambda (t c) (am-type! t c))
                    (list (list 'a_ (car px)) (list 'a_ (car py)) (list 'b_ (cadr px)) (list 'b_ (cadr py)))
                    '((VEC w) (VEC w) (VEC v) (VEC v)))
          (subst (dk-cite! 'hsum-vadd-pair 'w 'v (list 'a_ (car px)) (list 'b_ (cadr px)) (list 'a_ (car py)) (list 'b_ (cadr py))))
          (am-type! (am-pr (am-vadd 'w (list 'a_ (car px)) (list 'a_ (car py))) (am-vadd 'v (list 'b_ (cadr px)) (list 'b_ (cadr py)))) am-HV)
          (am-rfl!))))
    (lambda (c x)
      (let* ((px (am-pairify! x am-HS)))
        (subst (dk-cite! 'hsum-act-pair 'w 'v c (car px) (cadr px)))
        (let ((s1 (am-act 'w c (car px))) (s2 (am-act 'v c (cadr px))))
          (am-type! s1 '(VEC w)) (am-type! s2 '(VEC v))
          (subst (am-diag-val! (list s1 s2)))
          (subst (am-diag-val! px))
          (subst (dk-cite! 'bop-act 'w 'w 'a_ c (car px)))
          (subst (dk-cite! 'bop-act 'v 'v 'b_ c (cadr px)))
          (am-type! (list 'a_ (car px)) '(VEC w)) (am-type! (list 'b_ (cadr px)) '(VEC v))
          (subst (dk-cite! 'hsum-act-pair 'w 'v c (list 'a_ (car px)) (list 'b_ (cadr px))))
          (am-type! (am-pr (am-act 'w c (list 'a_ (car px))) (am-act 'v c (list 'b_ (cadr px)))) am-HV)
          (am-rfl!))))
    (list '+ am-na am-nb)
    (lambda ()
      (dk-cite! 'opnorm-in-rr 'w 'w 'a_) (dk-cite! 'opnorm-nonneg 'w 'w 'a_)
      (dk-cite! 'opnorm-in-rr 'v 'v 'b_) (dk-cite! 'opnorm-nonneg 'v 'v 'b_)
      (dk-real! (list '+ am-na am-nb))
      (dk-have! (list '<= 0 (list '+ am-na am-nb))
        (lambda () (dk-ineq! (list '<= 0 am-na) (list '<= 0 am-nb) (list 'IN am-na 'RR) (list 'IN am-nb 'RR)))))
    (lambda (x)
      (let* ((px (am-pairify! x am-HS))
             (p1 (car px)) (p2 (cadr px)) (pp (am-pr p1 p2))
             (ap (list 'a_ p1)) (bp (list 'b_ p2)))
        (subst (am-diag-val! px))
        (am-type! ap '(VEC w)) (am-type! bp '(VEC v))
        (am-type! pp '(VEC (HSUM w v)))
        (am-type! (am-pr ap bp) '(VEC (HSUM w v)))
        (for-each (lambda (u t) (dk-cite! 'ip-norm-in-rr u t) (dk-cite! 'ip-norm-nonneg u t))
                  (list 'w 'v 'w 'v am-HS am-HS) (list ap bp p1 p2 pp (am-pr ap bp)))
        (let* ((nP (am-nrm am-HS pp)) (n1 (am-nrm 'w p1)) (n2 (am-nrm 'v p2))
               (le (dk-cite! 'hsum-norm-le-sum 'w 'v ap bp))
               (b1 (dk-apply! (dk-cite! 'opnorm-bound 'w 'w 'a_) p1))
               (b2 (dk-apply! (dk-cite! 'opnorm-bound 'v 'v 'b_) p2))
               (g1 (dk-cite! 'hsum-norm-ge-1 'w 'v p1 p2))
               (g2 (dk-cite! 'hsum-norm-ge-2 'w 'v p1 p2))
               (s1 (am-scale-le! am-na n1 nP))
               (s2 (am-scale-le! am-nb n2 nP))
               (e (dk-have! (list '= (list '* (list '+ am-na am-nb) nP) (list '+ (list '* am-na nP) (list '* am-nb nP)))
                            (lambda () (crs)))))
          (am-ineq! (list (list '* am-na n1) (list '* am-nb n2) (list '* am-na nP) (list '* am-nb nP)
                          (list '* (list '+ am-na am-nb) nP))
                    (list le b1 b2 s1 s2 (list '= (list '* (list '+ am-na am-nb) nP) (list '+ (list '* am-na nP) (list '* am-nb nP))))
                    (list (list 'IN (am-nrm am-HS (am-pr ap bp)) 'RR) (list 'IN (am-nrm 'w ap) 'RR) (list 'IN (am-nrm 'v bp) 'RR))))))))
(am-qed! 'hsum-diag-bounded)

;;; =============================================================================================
;;; Part B.  The one-step amplification and the intertwining property.
(define am-BOv '(BOUNDED-OPS v v))
(define am-Cf (append am-C2 '((IN f_ (FUN (BOUNDED-OPS v v) (BOUNDED-OPS w w))))))

;;; projections and the diagonal at an arbitrary pair (no literal pair needed)
(define (am-nth-value! name vars guards lhs rhs fn)
  (sp (make-wff (forall-guarded (append '(w v) vars) (append am-C2 guards) (list '= lhs rhs))))
  (dk-peel!)
  (dk-cite! 'cips-vec-set 'w) (dk-cite! 'cips-vec-set 'v)
  (dk-split! (dk-cite! 'cartesian-nth 'p_ '(VEC w) '(VEC v)))
  (mac fn)
  (dk-lam-b!)
  (if (not (am-done?))
      (begin (if (memq 'a_ vars) (begin (am-type! '(a_ (NTH 1 p_)) '(VEC w)) (am-type! '(b_ (NTH 2 p_)) '(VEC v))))
             (am-rfl!)))
  (am-qed! name))
(am-nth-value! 'hsum-pr1-value '(p_) (list (list 'IN 'p_ am-HV)) '((HSUM-PR1 w v) p_) '(NTH 1 p_) 'HSUM-PR1)
(am-nth-value! 'hsum-pr2-value '(p_) (list (list 'IN 'p_ am-HV)) '((HSUM-PR2 w v) p_) '(NTH 2 p_) 'HSUM-PR2)
(am-nth-value! 'hsum-diag-value '(a_ b_ p_)
  (list '(IN a_ (FUN (VEC w) (VEC w))) '(IN b_ (FUN (VEC v) (VEC v))) (list 'IN 'p_ am-HV))
  '((HSUM-DIAG w v a_ b_) p_) '(LIST (a_ (NTH 1 p_)) (b_ (NTH 2 p_))) 'HSUM-DIAG)

;;; the values and typings of AMP-STEP and ID-REP
(sp (make-wff (forall-guarded '(v t_) (list (list 'IN 't_ am-BOv)) '(= ((ID-REP v) t_) t_))))
(dk-peel!) (mac 'ID-REP) (dk-lam-b!) (am-rfl!)
(am-qed! 'id-rep-apply)
(sp (make-wff (forall-guarded '(w v f_ t_) (list (list 'IN 't_ am-BOv))
   '(== ((AMP-STEP v w f_) t_) (HSUM-DIAG w v (f_ t_) t_)))))
(dk-peel!) (mac 'AMP-STEP) (dk-lam-b!)
(if (not (am-done?)) (qrfl))
(am-qed! 'amp-step-apply)
(sp (make-wff (forall-guarded '(v) '((IS-COMPLEX-INNER-PRODUCT-SPACE v)) (list 'IN '(ID-REP v) (list 'FUN am-BOv am-BOv)))))
(dk-peel!)
(dk-cite! 'bounded-ops-is-set 'v 'v)
(am-lam-type! 'ID-REP (lambda () #t))
(am-qed! 'id-rep-type)
(sp (make-wff (forall-guarded '(w v f_) am-Cf (list 'IN '(AMP-STEP v w f_) (list 'FUN am-BOv '(BOUNDED-OPS (HSUM w v) (HSUM w v)))))))
(dk-peel!)
(dk-cite! 'bounded-ops-is-set 'v 'v)
;; K1FIX (2026-11-19): lam-t owes the codomain's definedness; its sethood certifies it
(am-cips! am-HS) (dk-cite! 'bounded-ops-is-set am-HS am-HS)
(am-lam-type! 'AMP-STEP
  (lambda ()
    (let ((t (cadr (cadddr (cadr (dk-goal))))))
      (am-type! (list 'f_ t) '(BOUNDED-OPS w w))
      (dk-cite! 'hsum-diag-bounded 'w 'v (list 'f_ t) t))))
(am-qed! 'amp-step-type)

;;; the antecedent and the conclusion of IS-INTERTWINED(u, z, r, q, vv, ss) instantiated at the operator k
(define (am-intw-ante u r q ss k)
  (list 'FORALL 'ama_ (list 'IMPLIES (list 'IN 'ama_ ss) (list 'FORALL 'amx_ (list 'IMPLIES (list 'IN 'amx_ (list 'VEC u))
    (list '= (list k (list (list r 'ama_) 'amx_)) (list (list q 'ama_) (list k 'amx_))))))))
(define (am-intw-conc u r q vv ss k)
  (list 'FORALL 'amt_ (list 'IMPLIES (list 'IN 'amt_ (list 'BICOMMUTANT vv ss)) (list 'FORALL 'amx_ (list 'IMPLIES (list 'IN 'amx_ (list 'VEC u))
    (list '= (list k (list (list r 'amt_) 'amx_)) (list (list q 'amt_) (list k 'amx_))))))))
(define (am-intw-body u z r q vv ss)
  (list 'FORALL 'amk_ (list 'IMPLIES (list 'IN 'amk_ (list 'BOUNDED-OPS u z))
    (list 'IMPLIES (am-intw-ante u r q ss 'amk_) (am-intw-conc u r q vv ss 'amk_)))))
;;; with (IS-INTERTWINED u z r q vv ss) in context and k typed in BOUNDED-OPS(u, z): prove the antecedent
;;; at k with ANTE! (run on the peeled a, x), and return the conclusion at k (in context)
(define (am-use-intw! u z r q vv ss k ante!)
  (let* ((hyp (list 'IS-INTERTWINED u z r q vv ss))
         (body (am-intw-body u z r q vv ss))
         (ante (am-intw-ante u r q ss k))
         (conc (am-intw-conc u r q vv ss k)))
    (dk-project! body 'is-intertwined hyp)
    (dk-have! ante (lambda () (let* ((pl (dk-peel!))) (ante! (cadr (car pl)) (cadr (cadr pl))))))
    (dk-apply! body k)
    (or (dk-ctx-form conc) (error "am-use-intw!: the conclusion did not land" (expression->string conc)))))

;;; peel an IS-INTERTWINED goal (already unfolded): return (k H t x)
(define (am-peel-intw!)
  (let* ((pl (dk-peel!))
         (fnd (lambda (pred what) (let ((l (filter pred pl))) (if (null? l) (error "am-peel-intw!: no" what) (car l)))))
         (kk (fnd (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'BOUNDED-OPS))) "operator"))
         (hh (fnd (lambda (f) (dk-head-is? f 'FORALL)) "hypothesis"))
         (tt (fnd (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'BICOMMUTANT))) "t"))
         (xx (fnd (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'VEC))) "x")))
    (list (cadr kk) hh (cadr tt) (cadr xx))))
;;; t in s'' gives t in L(v)
(define (am-bicomm-bo! t)
  (if (not (dk-asm? (list 'IN t am-BOv)))
      (begin
        (dk-cite! 'bicommutant-unfold 'v 's)
        (dk-cite! 'commutant-subset-bo 'v '(COMMUTANT v s))
        (let ((h (dk-rewrite-h! (list 'IN t '(BICOMMUTANT v s)) '(BICOMMUTANT v s) '(COMMUTANT v (COMMUTANT v s)))))
          (dk-cite! 'subset-mem-fwd '(COMMUTANT v (COMMUTANT v s)) am-BOv t)))))

;;; ---------------------------------------------------------------------------------------------
;;; the base: an operator on v commuting pointwise with s commutes with s''
(define am-Cs (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) (list 'SUBSET 's am-BOv)))
(sp (make-wff (forall-guarded '(v s) am-Cs '(IS-INTERTWINED v v (ID-REP v) (ID-REP v) v s))))
(dk-peel!)
(dk-cite! 'cips-vec-set 'v)
(dk-cite! 'bounded-ops-is-set 'v 'v)
(mac 'is-intertwined)
(let* ((pl (am-peel-intw!))
       (k (car pl)) (hh (cadr pl)) (t (caddr pl)) (x (cadddr pl)))
  (am-bicomm-bo! t)
  (dk-cite! 'bop-fun 'v 'v k) (dk-cite! 'bop-fun 'v 'v t)
  (subst (dk-cite! 'id-rep-apply 'v t))
  ;; k is in the commutant of s
  (let ((cmem (dk-cite! 'commutant-membership 'v 's k)))
    (dk-have! (caddr cmem)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (let* ((a (dk-di-var!)))
                  (dk-cite! 'subset-mem-fwd 's am-BOv a)
                  (dk-cite! 'bop-fun 'v 'v a)
                  (dk-cite! 'bop-comp-bounded 'v k a) (dk-cite! 'bop-comp-bounded 'v a k)
                  (dk-fun-ext! (list 'BOP-COMP 'v k a) (list 'BOP-COMP 'v a k) '(VEC v) '(VEC v)
                    (lambda () (dk-cite! 'bop-fun 'v 'v (list 'BOP-COMP 'v k a)) (if (not (am-done?)) (dk-ass!)))
                    (lambda () (dk-cite! 'bop-fun 'v 'v (list 'BOP-COMP 'v a k)) (if (not (am-done?)) (dk-ass!)))
                    (lambda (z)
                      (subst (dk-cite! 'bop-comp-apply 'v k a z))
                      (subst (dk-cite! 'bop-comp-apply 'v a k z))
                      (let* ((h1 (dk-apply! hh a z))
                             (e0 (dk-cite! 'id-rep-apply 'v a))
                             (h2 (dk-rewrite-h! h1 (list '(ID-REP v) a) a)))
                        (subst h2)
                        (am-type! (list a (list k z)) '(VEC v))
                        (am-rfl!))))))))))
    (dk-split! (caddr cmem))
    (dk-have! (cadr cmem) (lambda () (subst (dk-cite! 'commutant-unfold 'v 's)) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!))))))
  (dk-cite! 'bicommutant-unfold 'v 's)
  (let* ((h (dk-rewrite-h! (list 'IN t '(BICOMMUTANT v s)) '(BICOMMUTANT v s) '(COMMUTANT v (COMMUTANT v s))))
         (ti (dk-cite! 'commutant-membership 'v '(COMMUTANT v s) t)))
    (let ((rhs (caddr ti)))
      (dk-have! rhs (lambda () (if (dk-only! ti h) (prop))))
      (dk-split! rhs))
    (let ((e (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f t) (dk-contains? f 'BOP-COMP))) "t commutes") k)))
      (let ((c1 (dk-cite! 'bop-comp-apply 'v k t x)))
        (subst (list '= (caddr c1) (cadr c1))))
      (subst (list '= (list 'BOP-COMP 'v k t) (list 'BOP-COMP 'v t k)))
      (subst (dk-cite! 'bop-comp-apply 'v t k x))
      (am-type! (list t (list k x)) '(VEC v))
      (am-rfl!))))
(am-qed! 'intertwined-base)

;;; rewrite the context formula F with each equation of EQS (landed, used left to right)
(define (am-rw-h! f . eqs)
  (let loop ((f f) (es eqs))
    (if (null? es) f
        (let ((e (car es)))
          (loop (if (dk-contains? f (cadr e)) (dk-rewrite-h! f (cadr e) (caddr e)) f) (cdr es))))))
(define (am-sub-type! a)               ; a in s: a in L(v), and its FUN typing
  (dk-cite! 'subset-mem-fwd 's am-BOv a)
  (dk-cite! 'bop-fun 'v 'v a))

