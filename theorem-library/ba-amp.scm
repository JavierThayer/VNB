(let* ((pl (am-peel-intw!))
       (k (car pl)) (hh (cadr pl)) (t (caddr pl)) (x (cadddr pl))
       (j1 '(HSUM-IN1 w v)) (j2 '(HSUM-IN2 w v))
       (k1 (list 'BOP-COMP 'w k j1)) (k2 (list 'BOP-COMP 'v k j2))
       (z1 '(VZERO v)) (z2 '(VZERO w)))
  (am-bicomm-bo! t)
  (dk-cite! 'hsum-in1-bounded 'w 'v) (dk-cite! 'hsum-in2-bounded 'w 'v)
  (dk-cite! 'bop-fun 'w am-HS j1) (dk-cite! 'bop-fun 'v am-HS j2) (dk-cite! 'bop-fun am-HS 'u k)
  (dk-cite! 'bop-comp-bounded-gen 'w am-HS 'u k j1)
  (dk-cite! 'bop-comp-bounded-gen 'v am-HS 'u k j2)
  (let* ((capp (lambda (jj z) (dk-cite! 'bop-comp-apply-gen (if (equal? jj j1) 'w 'v) am-HS 'u k jj z)))
         (inj (lambda (jj z) (if (equal? jj j1) (dk-cite! 'hsum-in1-apply 'w 'v z) (dk-cite! 'hsum-in2-apply 'w 'v z))))
         (pr (lambda (jj z) (if (equal? jj j1) (am-pr z z1) (am-pr z2 z))))
         (dom-ante!
           (lambda (jj)
             (lambda (a y)
               (am-sub-type! a)
               (let* ((fa (list 'f_ a)) (ra (list 'r_ a)))
                 (am-type! fa '(BOUNDED-OPS w w)) (dk-cite! 'bop-fun 'w 'w fa)
                 (am-type! ra '(BOUNDED-OPS u u))
                 (if (equal? jj j2) (subst (dk-cite! 'id-rep-apply 'v a)))
                 (let* ((ay (if (equal? jj j1) (list fa y) (list a y))))
                   (am-type! ay (if (equal? jj j1) '(VEC w) '(VEC v)))
                   (subst (capp jj ay)) (subst (inj jj ay))
                   (subst (capp jj y)) (subst (inj jj y))
                   (am-type! (pr jj y) '(VEC (HSUM w v)))
                   (let* ((h0 (dk-apply! hh a (pr jj y)))
                          (e0 (dk-cite! 'amp-step-apply 'w 'v 'f_ a))
                          (e1 (if (equal? jj j1) (dk-cite! 'hsum-diag-apply 'w 'v fa a y z1)
                                                (dk-cite! 'hsum-diag-apply 'w 'v fa a z2 y)))
                          (e2 (if (equal? jj j1) (dk-cite! 'bop-zero-value 'v 'v a) (dk-cite! 'bop-zero-value 'w 'w fa)))
                          (h1 (am-rw-h! h0 e0 e1 e2)))
                     (subst h1)
                     (am-type! (list ra (list k (pr jj y))) '(VEC u))
                     (am-rfl!)))))))
         (d1 (am-use-intw! 'w 'u 'f_ 'r_ 'v 's k1 (dom-ante! j1)))
         (d2 (am-use-intw! 'v 'u '(ID-REP v) 'r_ 'v 's k2 (dom-ante! j2))))
    (dk-cite! 'bop-fun 'v 'v t)
    (let* ((px (am-pairify! x am-HS)) (x1 (car px)) (x2 (cadr px))
           (ft (list 'f_ t)) (rt (list 'r_ t))
           (_a (am-type! ft '(BOUNDED-OPS w w)))
           (_b (dk-cite! 'bop-fun 'w 'w ft))
           (_c (am-type! rt '(BOUNDED-OPS u u)))
           (ftx (list ft x1)) (tx (list t x2)))
      (am-type! ftx '(VEC w)) (am-type! tx '(VEC v))
      (subst (dk-cite! 'amp-step-apply 'w 'v 'f_ t))
