                 (am-type! (list a (list 'NTH 2 ky)) '(VEC v))
                 (subst (dk-cite! (if (equal? pp p1) 'hsum-pr1-apply 'hsum-pr2-apply) 'w 'v
                                  (list (list 'f_ a) (list 'NTH 1 ky)) (list a (list 'NTH 2 ky))))
                 (subst (dk-cite! (if (equal? pp p1) 'hsum-pr1-value 'hsum-pr2-value) 'w 'v ky))
                 (am-rfl!)))))
         (d1 (am-use-intw! 'u 'w 'r_ 'f_ 'v 's k1 (comp-ante! p1 #f)))
         (d2 (am-use-intw! 'u 'v 'r_ '(ID-REP v) 'v 's k2 (comp-ante! p2 #t))))
    (let* ((rt (list 'r_ t)) (rtx (list rt x)) (kx (list k x)) (krtx (list k rtx)))
