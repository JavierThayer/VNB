             (subst (list '= (list 'VEC am-M) am-BOv)) (dk-ass!)))
(subst (list '== am-TC (am-tc-sep am-SOT 's)))
(mac 'subset-def)
(let* ((t (dk-di-var!)))
  (am-bicomm-bo! t)
  (dk-cite! 'bop-fun 'v 'v t)
    (in-sep!
    (lambda ()
      (if (not (am-done?))
          (begin (subst (list '= am-SOT am-SNT))
                 (subst (list '= (list 'PTS am-SNT) (list 'VEC am-M)))
                 (subst (list '= (list 'VEC am-M) am-BOv))
                 (dk-ass!))))
    (lambda ()
      (let* ((pl (dk-peel!))
             (hu (car (filter (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'OPENS))) pl)))
             (u (cadr hu))
             (hu2 (dk-rewrite-h! hu am-SOT am-SNT))
             (ex (dk-cite! 'sntop-open-basic 'CC-NORMED-FIELD am-M '(VEC v) am-PF u t))
             (ff (dk-skolem! ex #t)))
        (dk-split-all!)
        (let* ((exe (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'sne_))) "eps"))
               (eps (dk-skolem! exe #t)))
          (dk-split-all!)
          (let* ((ball (list 'SN-BALL am-M am-PF ff t eps))
                 (exa (dk-cite! 'bicommutant-finite-approx 'v 's ff t eps))
                 (a (dk-skolem! exa #t))
                 (apx (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'cqy_) (dk-contains? h a))) "the approximation"))
                 (bm (dk-cite! 'sn-ball-membership am-M am-PF ff t eps a)))
            (dk-split-all!)
            (dk-cite! 'subset-mem-fwd 's am-BOv a)
            (dk-cite! 'bop-fun 'v 'v a)
            (dk-have! (caddr bm)
              (lambda ()
                (dk-conj-close!
                  (lambda ()
                    (cond
                      ((am-done?) #t)
                      ((dk-ass!) #t)
                      ((dk-head-is? (dk-goal) 'IN)
                       (subst (list '= (list 'VEC am-M) am-BOv)) (dk-ass!))
                      (#t
                       (let* ((i (dk-di-var!))
                              (nt (list 'BOP-NEG 'v 'v t))
                              (st (list 'BOP-SUM 'v 'v a nt)))
                         (dk-cite! 'subset-mem-fwd ff '(VEC v) i)
                         (subst (dk-cite! 'bh-module-vadd 'v))
                         (subst (dk-cite! 'bh-module-vneg 'v))
                         (subst (dk-cite! 'bh-vneg-value 'v t))
                         (dk-cite! 'bop-neg-bounded 'v 'v t)
                         (subst (dk-cite! 'bh-vadd-value 'v a nt))
                         (dk-cite! 'bop-sum-bounded 'v 'v a nt)
                         (subst (dk-cite! 'sot-pf-apply 'v i st))
                         (dk-cite! 'bop-fun 'v 'v nt)
                         (subst (dk-cite! 'bop-sum-apply 'v 'v a nt i))
                         (subst (dk-cite! 'bop-neg-apply 'v 'v t i))
                         (am-type! (list t i) '(VEC v)) (am-type! (list a i) '(VEC v))
                         (let* ((h (dk-apply! apx i))
                                (sy (dk-cite! 'ip-norm-diff-sym 'v (list t i) (list a i)))
                                (d1 (am-dif 'v (list t i) (list a i)))
                                (d2 (am-dif 'v (list a i) (list t i))))
                           (am-type! d1 '(VEC v)) (am-type! d2 '(VEC v))
                           (let* ((r1 (dk-cite! 'ip-norm-in-rr 'v d1))
                                  (r2 (dk-cite! 'ip-norm-in-rr 'v d2))
                                  (r3 (dk-cite! 'rr-pos-rr-in-rr eps)))
                             (dk-ineq! h sy r1 r2 r3))))))))))
            (am-prop! (list 'IN a ball) bm (caddr bm))
            (dk-cite! 'subset-mem-fwd ball u a)
            (ew a)
            (dk-conj-close! (lambda () (if (not (am-done?)) (dk-ass!))))))))))
(am-qed! 'bicommutant-in-sot-closure)

