    (am-rfl!)))
(am-qed! 'hsum-diag-scale)

;;; (a (+) b)(c (+) d) = (a c) (+) (b d)
(sp (make-wff (forall-guarded '(w v a_ b_ c_ d_) am-Cab2
   (list '= (list 'BOP-COMP am-HS (am-diag 'a_ 'b_) (am-diag 'c_ 'd_))
            (am-diag '(BOP-COMP w a_ c_) '(BOP-COMP v b_ d_))))))
(am-diag-setup!)
(dk-cite! 'hsum-diag-bounded 'w 'v 'a_ 'b_) (dk-cite! 'hsum-diag-bounded 'w 'v 'c_ 'd_)
(dk-cite! 'bop-comp-bounded am-HS (am-diag 'a_ 'b_) (am-diag 'c_ 'd_))
