;;; Part H.  A von Neumann algebra is its own bicommutant; Corollary 6.9 for a von Neumann algebra.
;;; an adherent point of a closed set lies in it
(sp (make-wff (forall-guarded '(q_ a_ x_) '((IS-TOP-CLOSED q_ a_) (IN x_ (TOP-CLOSURE q_ a_))) '(IN x_ a_))))
(dk-peel!)
(dk-cite! 'top-closure-unfold 'q_ 'a_)
(let* ((hx (dk-rewrite-h! '(IN x_ (TOP-CLOSURE q_ a_)) '(TOP-CLOSURE q_ a_) (am-tc-sep 'q_ 'a_)))
       (cmp '(COMPLEMENT-IN (PTS q_) a_)))
  (sep-me hx)
  (dk-split-all!)
  (mac-h 'is-top-closed '(IS-TOP-CLOSED q_ a_))
  (dk-split-all!)
  (use-em '(IN x_ a_)
    (lambda () (dk-ass!))
    (lambda ()
      (let ((cx (dk-cite! 'complement-in-membership '(PTS q_) 'a_ 'x_)))
        (am-prop! (list 'IN 'x_ cmp) cx '(IN x_ (PTS q_)) '(NOT (IN x_ a_))))
      (let* ((cond1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'otu_))) "the adherence clause"))
             (ex (dk-apply! cond1 cmp))
             (y (dk-skolem! ex #t))
             (cy (dk-cite! 'complement-in-membership '(PTS q_) 'a_ y)))
        (am-prop! (list 'NOT (list 'IN y 'a_)) cy (list 'IN y cmp))
        (am-prop! '(IN x_ a_) (list 'IN y 'a_) (list 'NOT (list 'IN y 'a_)))))))
(am-qed! 'top-closure-closed-mem)

