(dk-split-all!)
(subst (list '= '(BICOMMUTANT v s) am-C2c))
(mac 'subset-def)
(dk-cite! 'top-closure-unfold am-SOT 's)
(let* ((x (dk-di-var!))
       (hx (dk-rewrite-h! (list 'IN x am-TC) am-TC (am-tc-sep am-SOT 's)))
       (cmp (list 'COMPLEMENT-IN (list 'PTS am-SOT) am-C2c)))
  (sep-me hx)
  (dk-split-all!)
  (use-em (list 'IN x am-C2c)
    (lambda () (dk-ass!))
    (lambda ()
      (let ((cx (dk-cite! 'complement-in-membership (list 'PTS am-SOT) am-C2c x)))
        (am-prop! (list 'IN x cmp) cx (list 'IN x (list 'PTS am-SOT)) (list 'NOT (list 'IN x am-C2c))))
      (let* ((cond1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'otu_))) "the adherence clause"))
             (ex (dk-apply! cond1 cmp))
             (y (dk-skolem! ex #t))
             (cy (dk-cite! 'complement-in-membership (list 'PTS am-SOT) am-C2c y)))
        (am-prop! (list 'NOT (list 'IN y am-C2c)) cy (list 'IN y cmp))
        (dk-cite! 'subset-mem-fwd 's am-C2c y)
        (am-prop! (list 'IN x am-C2c) (list 'IN y am-C2c) (list 'NOT (list 'IN y am-C2c)))))))
