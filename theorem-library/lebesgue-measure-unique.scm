;;; ====================================================================
;;; theorem-library/lebesgue-measure-unique.scm -- MEASURE-4-A, 2026-10-10.
;;; Lebesgue measure on the line: translation invariance and uniqueness.
;;;
;;; Notation.  lam* = METHOD-I-OUTER(RR, CLOSED-INTERVALS, ols_ |-> INTERVAL-LENGTH(ols_))
;;; (MEASURE-2's term); the Lebesgue sets are C = CARATHEODORY-SETS(RR, lam*); Lebesgue
;;; measure is lam = RES(lam*, C) (as in lebesgue-measure-ccint); the Borel sets are
;;; BOREL-SETS(RR-MS) (MEASURE-3).  TRANSLATE(es, c) = { z in RR : z - c in es } is the
;;; vocabulary of structure-library/lebesgue-translate.scm.
;;;
;;; THE THEOREMS (every one `modulo 0'):
;;;   lebesgue-outer-translate-invariant  lam*(es + c) = lam*(es), es a set of reals, c real
;;;                                       (MEASURE-3's lebesgue-outer-translate, restated
;;;                                       in the vocabulary)
;;;   lebesgue-measurable-translate       es in C, c real ==> es + c in C and
;;;                                       lam(es + c) = lam(es)
;;;   lebesgue-measure-unique             IS-MEASURE(RR, BOREL-SETS(RR-MS), mu) and
;;;                                       mu([a, b]) = b - a for all real a <= b ==>
;;;                                       mu(es) = lam(es) for every Borel set es
;;; and the lemmas they rest on, each general:
;;;   translate-{unfold,membership,subset-rr,intersection,difference,neg-back};
;;;   rr-closed-borel (a closed set of the line is Borel), ccint-closed-rr-ms ([a, b] is the
;;;   closed ball about (a+b)/2 of radius (b-a)/2), closed-intervals-borel;
;;;   borel-measure-le-lebesgue-outer (mu <= lam* on the Borel sets: mu of a set is at most
;;;   mu of any countable cover by closed intervals, hence at most every cover sum, hence
;;;   at most their EINF), borel-measure-eq-lebesgue-outer-bounded (equality on a Borel set
;;;   inside [p, q]: apply the inequality to the set and to its complement in [p, q], and
;;;   compare mu([p,q]) = q - p = lam*([p,q]) through Caratheodory's condition at [p, q]),
;;;   measure-le-of-ccint-exhaust (any measure on the line: nu(es) <= b as soon as
;;;   nu(es n [-n, n]) <= b for all n -- continuity from below).
;;;
;;; THE ROUTE FOR UNIQUENESS, AND WHY IT IS NOT THE BRIEF'S.  The brief proposed the
;;; monotone class theorem (or Dynkin's pi-lambda) on es n [-n, n]: it needs the algebra of
;;; finite disjoint unions of intervals AND the fact that this algebra generates the open
;;; sets of the line (every open set is a countable union of intervals, through the
;;; rationals).  Neither is needed.  lam* is the LARGEST measure-like set function agreeing
;;; with the length on intervals: mu <= lam* on Borel sets by countable subadditivity of mu
;;; alone, since lam* is an infimum of cover sums; on a bounded Borel set the two
;;; inequalities for the set and for its complement in [p, q] add up to the same finite
;;; total q - p, so both are equalities; and continuity from below of lam (a measure by
;;; caratheodory-measure) carries equality from the es n [-n, n] to es.  The statement of
;;; item 3 is unchanged.  What it needs of the Borel sets is only that the closed
;;; intervals are Borel (closed balls are closed) and that the Borel sets are Lebesgue
;;; measurable (lebesgue-borel-measurable, MEASURE-3).
;;;
;;; LOAD WINDOW: after "theorem-library/lebesgue-measure-line" (load.scm 3493), which
;;; gives lebesgue-measure-ccint; "structure-library/lebesgue-translate" goes just before
;;; this file.  From metric-outer-measure (3492): lebesgue-borel-measurable,
;;; ccint-empty-of-lt, borel-sets-unfold; from lebesgue-interval-length (3490):
;;; lebesgue-outer-translate, lebesgue-outer-ccint, lebesgue-outer-mono,
;;; subset-rr-in-power-rr; from outer-measure-construction (3483): lebesgue-outer-measure,
;;; lebesgue-premeasure, method-i-outer-value, cover-sums-{subset,elim},
;;; interval-length-ccint, closed-intervals-def; caratheodory (3478); measure-laws (3386);
;;; everything else earlier.  Nothing in the tree cites these names.  libraries.sexp: both
;;; files in library measure.
;;; ====================================================================

;;; ====================================================================
;;; (0) file-local kit (lmu- prefix)
;;; ====================================================================

(define lmu-lam '(METHOD-I-OUTER RR CLOSED-INTERVALS (VNB-LAMBDA ols_ CLOSED-INTERVALS (INTERVAL-LENGTH ols_))))
(define lmu-lp '(VNB-LAMBDA ols_ CLOSED-INTERVALS (INTERVAL-LENGTH ols_)))
(define (lmu-lo s) (list lmu-lam s))
(define lmu-cs (list 'CARATHEODORY-SETS 'RR lmu-lam))
(define lmu-mu (list 'RES lmu-lam lmu-cs))
(define (lmu-mu-at s) (list lmu-mu s))
(define lmu-pw '(POWER RR))
(define lmu-bor '(BOREL-SETS RR-MS))
(define (lmu-tr s c) (list 'TRANSLATE s c))

;;; an IFF instance used forwards: cite THM at ARGS, land its right side (split)
(define (lmu-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))

;;; an IFF instance used backwards: its right side's conjuncts are in context;
;;; land the left side and return it
(define (lmu-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))

;;; the goal (= A B) by class extensionality; AB proves (IN x B) with (IN x A)
;;; landed, BA the converse; both get the eigenvariable
(define (lmu-class-eq! a b ab ba)
  (let ((ext (list 'FORALL 'lmx_ (list 'IFF (list 'IN 'lmx_ a) (list 'IN 'lmx_ b)))))
    (dk-have! ext
      (lambda ()
        (dk-peel!)
        (let ((xv (cadr (cadr (dk-goal)))))
          (dk-iff! (lambda (g) (equal? g (list 'IN xv b)))
                   (lambda () (ab xv))
                   (lambda () (ba xv))))))
    (fact 'class-extensionality a b)
    (ass)))

;;; (SUBSET s RR) from (IN s (POWER RR))
(define (lmu-pow-sub! s)
  (if (not (dk-asm? (list 'SUBSET s 'RR)))
      (dk-have! (list 'SUBSET s 'RR)
        (lambda ()
          (mac 'subset-def)
          (let ((zv (dk-di-var!)))
            (fact 'power-mem-in 'RR s zv)
            (ass))))))

;;; (IN s (POWER RR)) from (SUBSET s RR)
(define (lmu-pow! s)
  (if (not (dk-asm? (list 'IN s lmu-pw)))
      (fact 'subset-rr-in-power-rr s)))

;;; x in TRANSLATE(s, c) in context: land x in RR and x - c in s
(define (lmu-tr-in! s c x)
  (lmu-iff-fwd! 'translate-membership s c x))

;;; land x in TRANSLATE(s, c) from x in RR and x - c in s in context
(define (lmu-tr-into! s c x)
  (lmu-iff-bwd! 'translate-membership s c x))

;;; (IN (- x c) RR) from x, c in RR
(define (lmu-real! t)
  (if (not (dk-asm? (list 'IN t 'RR)))
      (dk-have! (list 'IN t 'RR) (lambda () (type-term)))))

;;; ====================================================================
;;; (1) TRANSLATE: unfold, membership, subset of RR, invariance of lam*
;;; ====================================================================

(sp (make-wff '(FORALL es (FORALL c_ (== (TRANSLATE es c_) (SEP ltz_ RR (IN (- ltz_ c_) es)))))))
(di)
(mac 'TRANSLATE)
(qrfl)
(qed 'translate-unfold)
(topic! 'translate-unfold 'plumbing)

(sp (make-wff '(FORALL es (FORALL c_ (FORALL z_
   (IFF (IN z_ (TRANSLATE es c_)) (AND (IN z_ RR) (IN (- z_ c_) es))))))))
(dk-peel!)
(let ((u (dk-cite! 'translate-unfold 'es 'c_)))
  (subst u)
  (let ((sep (caddr u)))
    (dk-iff! (lambda (g) (dk-head-is? g 'AND))
      (lambda ()
        (sep-me (list 'IN 'z_ sep))
        (dk-split-all!)
        (dk-conj-close! dk-ass!))
      (lambda ()
        (dk-split-all!)
        (in-sep! dk-ass! (lambda () (ass)))))))
(qed 'translate-membership)
(topic! 'translate-membership 'plumbing)

(sp (make-wff '(FORALL es (FORALL c_ (SUBSET (TRANSLATE es c_) RR)))))
(dk-peel!)
(mac 'subset-def)
(let ((zv (dk-di-var!)))
  (lmu-tr-in! 'es 'c_ zv)
  (ass))
(qed 'translate-subset-rr)
(topic! 'translate-subset-rr 'plumbing)

;;; item 1 in the vocabulary: lam*(es + c) = lam*(es)
(sp (make-wff (forall-guarded '(es c_) '((SUBSET es RR) (IN c_ RR))
   (list '= (lmu-lo '(TRANSLATE es c_)) (lmu-lo 'es)))))
(dk-peel!)
(let ((u (dk-cite! 'translate-unfold 'es 'c_)))
  (subst u)
  (fact 'lebesgue-outer-translate 'es 'c_)
  (ass))
(qed 'lebesgue-outer-translate-invariant)
(topic! 'lebesgue-outer-translate-invariant 'inequalities)

;;; ====================================================================
;;; (2) TRANSLATE commutes with intersection and difference, and is undone
;;; ====================================================================

(sp (make-wff '(FORALL aa (FORALL bb (FORALL c_ (IMPLIES (IN c_ RR)
   (= (TRANSLATE (INTERSECTION aa bb) c_) (INTERSECTION (TRANSLATE aa c_) (TRANSLATE bb c_)))))))))
(dk-peel!)
(lmu-class-eq! '(TRANSLATE (INTERSECTION aa bb) c_) '(INTERSECTION (TRANSLATE aa c_) (TRANSLATE bb c_))
  (lambda (xv)
    (lmu-tr-in! '(INTERSECTION aa bb) 'c_ xv)
    (lmu-real! (list '- xv 'c_))
    (lmu-iff-fwd! 'intersection-membership 'aa 'bb (list '- xv 'c_))
    (lmu-tr-into! 'aa 'c_ xv)
    (lmu-tr-into! 'bb 'c_ xv)
    (lmu-iff-bwd! 'intersection-membership '(TRANSLATE aa c_) '(TRANSLATE bb c_) xv)
    (ass))
  (lambda (xv)
    (lmu-iff-fwd! 'intersection-membership '(TRANSLATE aa c_) '(TRANSLATE bb c_) xv)
    (lmu-tr-in! 'aa 'c_ xv)
    (lmu-tr-in! 'bb 'c_ xv)
    (lmu-real! (list '- xv 'c_))
    (lmu-iff-bwd! 'intersection-membership 'aa 'bb (list '- xv 'c_))
    (lmu-tr-into! '(INTERSECTION aa bb) 'c_ xv)
    (ass)))
(qed 'translate-intersection)
(topic! 'translate-intersection 'plumbing)

(sp (make-wff '(FORALL aa (FORALL bb (FORALL c_ (IMPLIES (IN c_ RR)
   (= (TRANSLATE (DIFFERENCE aa bb) c_) (DIFFERENCE (TRANSLATE aa c_) (TRANSLATE bb c_)))))))))
(dk-peel!)
(subst (dk-cite! 'difference-unfold 'aa 'bb))
(subst (dk-cite! 'difference-unfold '(TRANSLATE aa c_) '(TRANSLATE bb c_)))
(lmu-class-eq! '(TRANSLATE (COMPLEMENT-IN aa bb) c_) '(COMPLEMENT-IN (TRANSLATE aa c_) (TRANSLATE bb c_))
  (lambda (xv)
    (lmu-tr-in! '(COMPLEMENT-IN aa bb) 'c_ xv)
    (lmu-real! (list '- xv 'c_))
    (lmu-iff-fwd! 'complement-in-membership 'aa 'bb (list '- xv 'c_))
    (lmu-tr-into! 'aa 'c_ xv)
    (dk-have! (list 'NOT (list 'IN xv '(TRANSLATE bb c_)))
      (lambda ()
        (di)
        (lmu-tr-in! 'bb 'c_ xv)
        (dk-only! (list 'IN (list '- xv 'c_) 'bb) (list 'NOT (list 'IN (list '- xv 'c_) 'bb)))
        (prop)))
    (lmu-iff-bwd! 'complement-in-membership '(TRANSLATE aa c_) '(TRANSLATE bb c_) xv)
    (ass))
  (lambda (xv)
    (lmu-iff-fwd! 'complement-in-membership '(TRANSLATE aa c_) '(TRANSLATE bb c_) xv)
    (lmu-tr-in! 'aa 'c_ xv)
    (lmu-real! (list '- xv 'c_))
    (dk-have! (list 'NOT (list 'IN (list '- xv 'c_) 'bb))
      (lambda ()
        (di)
        (lmu-tr-into! 'bb 'c_ xv)
        (dk-only! (list 'IN xv '(TRANSLATE bb c_)) (list 'NOT (list 'IN xv '(TRANSLATE bb c_))))
        (prop)))
    (lmu-iff-bwd! 'complement-in-membership 'aa 'bb (list '- xv 'c_))
    (lmu-tr-into! '(COMPLEMENT-IN aa bb) 'c_ xv)
    (ass)))
(qed 'translate-difference)
(topic! 'translate-difference 'plumbing)

;;; translating by -c and then by c gives the set back
(sp (make-wff '(FORALL aa (FORALL c_ (IMPLIES (SUBSET aa RR) (IMPLIES (IN c_ RR)
   (= (TRANSLATE (TRANSLATE aa (- 0 c_)) c_) aa)))))))
(dk-peel!)
(lmu-real! '(- 0 c_))
(lmu-class-eq! '(TRANSLATE (TRANSLATE aa (- 0 c_)) c_) 'aa
  (lambda (xv)
    (let* ((y (list '- xv 'c_)) (w (list '- y '(- 0 c_))))
      (lmu-tr-in! '(TRANSLATE aa (- 0 c_)) 'c_ xv)
      (lmu-real! y)
      (lmu-tr-in! 'aa '(- 0 c_) y)
      (dk-have! (list '= w xv) (lambda () (dk-ineq! (list 'IN xv 'RR) '(IN c_ RR))))
      (dk-rewrite-h! (list 'IN w 'aa) w xv)
      (ass)))
  (lambda (xv)
    (let* ((y (list '- xv 'c_)) (w (list '- y '(- 0 c_))))
      (fact 'subset-mem-fwd 'aa 'RR xv)
      (lmu-real! y)
      (dk-have! (list '= w xv) (lambda () (dk-ineq! (list 'IN xv 'RR) '(IN c_ RR))))
      (dk-have! (list 'IN w 'aa) (lambda () (subst (list '= w xv)) (ass)))
      (lmu-tr-into! 'aa '(- 0 c_) y)
      (lmu-tr-into! '(TRANSLATE aa (- 0 c_)) 'c_ xv)
      (ass))))
(qed 'translate-neg-back)
(topic! 'translate-neg-back 'plumbing)
;;; ====================================================================
;;; (3) ITEM 2: translation preserves the Lebesgue sets and their measure
;;; ====================================================================

;;; the setting: lam* an outer measure with its FUN typing, its Caratheodory sets a
;;; sigma-algebra inside POWER(RR)
(define (lmu-setting!)
  (if (not (dk-asm? (list 'SUBSET lmu-cs lmu-pw)))
      (begin
        (fact 'lebesgue-outer-measure)
        (let ((om (list 'IS-OUTER-MEASURE 'RR lmu-lam))
              (ty (list 'IN lmu-lam (list 'FUN lmu-pw 'RR-POS-STAR))))
          (dk-project! ty 'IS-OUTER-MEASURE om)
          (dk-project! (list 'IN lmu-lam (list 'FUN lmu-pw)) 'fun-codomain-iff ty)
          (fact 'caratheodory-measurable-sigma-algebra 'RR lmu-lam)
          (dk-project! (list 'SUBSET lmu-cs lmu-pw) 'IS-SIGMA-ALGEBRA (list 'IS-SIGMA-ALGEBRA 'RR lmu-cs))))))

;;; with (IN x C) in context: land and return RES(lam*, C)(x) = lam*(x)
(define (lmu-res! x)
  (lmu-setting!)
  (if (not (dk-asm? (list 'AND (list 'IN lmu-lam (list 'FUN lmu-pw))
                          (list 'AND (list 'SUBSET lmu-cs lmu-pw) (list 'IN x lmu-cs)))))
      (dk-have! (list 'AND (list 'IN lmu-lam (list 'FUN lmu-pw))
                      (list 'AND (list 'SUBSET lmu-cs lmu-pw) (list 'IN x lmu-cs)))
                (lambda () (dk-conj-close! dk-ass!))))
  (dk-cite! 'res-apply lmu-pw lmu-cs lmu-lam x))

;;; Caratheodory's condition for lam* and the set s, as IS-CARATHEODORY-MEASURABLE states it
(define (lmu-carf s)
  (list 'FORALL 'a_ (list 'IMPLIES (list 'IN 'a_ lmu-pw)
    (list '= (list lmu-lam 'a_)
          (list 'eplus (list lmu-lam (list 'INTERSECTION 'a_ s))
                       (list lmu-lam (list 'DIFFERENCE 'a_ s)))))))

(sp (make-wff (forall-guarded '(es c_) (list '(IN c_ RR) (list 'IN 'es lmu-cs))
   (list 'AND (list 'IN '(TRANSLATE es c_) lmu-cs)
              (list '= (lmu-mu-at '(TRANSLATE es c_)) (lmu-mu-at 'es))))))
(dk-peel!)
(lmu-setting!)
(let* ((ts '(TRANSLATE es c_))
       (nc '(- 0 c_))
       (cm (list 'IS-CARATHEODORY-MEASURABLE 'RR lmu-lam 'es)))
  (dk-project! cm 'caratheodory-sets-membership (list 'IN 'es lmu-cs))
  (dk-project! (list 'SUBSET 'es 'RR) 'IS-CARATHEODORY-MEASURABLE cm)
  (dk-project! (lmu-carf 'es) 'IS-CARATHEODORY-MEASURABLE cm)
  (lmu-real! nc)
  (fact 'translate-subset-rr 'es 'c_)
  (lmu-pow! ts)
  ;; Caratheodory's condition for the translate
  (dk-have! (lmu-carf ts)
    (lambda ()
      (let* ((landed (dk-peel!))
             (tv (cadr (car landed)))
             (tn (list 'TRANSLATE tv nc))
             (ti (list 'INTERSECTION tn 'es))
             (td (list 'DIFFERENCE tn 'es)))
        (lmu-pow-sub! tv)
        (fact 'lebesgue-outer-translate-invariant tv nc)
        (fact 'translate-subset-rr tv nc)
        (lmu-pow! tn)
        (dk-apply! (lmu-carf 'es) tn)
        (fact 'translate-neg-back tv 'c_)
        (let ((ei (dk-cite! 'translate-intersection tn 'es 'c_))
              (ed (dk-cite! 'translate-difference tn 'es 'c_)))
          (dk-rewrite-h! ei (list 'TRANSLATE tn 'c_) tv)
          (dk-rewrite-h! ed (list 'TRANSLATE tn 'c_) tv))
        (dk-have! (list 'SUBSET ti 'RR)
          (lambda () (mac 'subset-def)
            (let ((zv (dk-di-var!)))
              (lmu-iff-fwd! 'intersection-membership tn 'es zv)
              (fact 'subset-mem-fwd 'es 'RR zv)
              (ass))))
        (dk-have! (list 'SUBSET td 'RR)
          (lambda () (mac 'subset-def)
            (let ((zv (dk-di-var!)))
              (dk-cite! 'difference-unfold tn 'es)
              (dk-rewrite-h! (list 'IN zv td) td (list 'COMPLEMENT-IN tn 'es))
              (lmu-iff-fwd! 'complement-in-membership tn 'es zv)
              (fact 'subset-mem-fwd tn 'RR zv)
              (ass))))
        (fact 'lebesgue-outer-translate-invariant ti 'c_)
        (fact 'lebesgue-outer-translate-invariant td 'c_)
        (subst (list '= (list 'INTERSECTION tv ts) (list 'TRANSLATE ti 'c_)))
        (subst (list '= (list 'DIFFERENCE tv ts) (list 'TRANSLATE td 'c_)))
        (subst (list '= (lmu-lo (list 'TRANSLATE ti 'c_)) (lmu-lo ti)))
        (subst (list '= (lmu-lo (list 'TRANSLATE td 'c_)) (lmu-lo td)))
        (subst (list '= (lmu-lo tv) (lmu-lo tn)))
        (ass))))
  (dk-have! (list 'IS-CARATHEODORY-MEASURABLE 'RR lmu-lam ts)
    (lambda () (mac 'IS-CARATHEODORY-MEASURABLE) (dk-conj-close! dk-ass!)))
  (lmu-iff-bwd! 'caratheodory-sets-membership 'RR lmu-lam ts)
  (let ((r1 (lmu-res! ts))
        (r2 (lmu-res! 'es)))
    (fact 'lebesgue-outer-translate-invariant 'es 'c_)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin (subst r1) (subst r2) (ass)))))))
(qed 'lebesgue-measurable-translate)
(topic! 'lebesgue-measurable-translate 'set-quotient)
;;; ====================================================================
;;; (4) CLOSED SETS OF THE LINE ARE BOREL; CLOSED INTERVALS ARE CLOSED
;;; ====================================================================

(define lmu-ptsq '(== (PTS RR-MS) RR))
(define (lmu-ptsq!)
  (if (not (dk-asm? lmu-ptsq))
      (dk-have! lmu-ptsq (lambda () (slot 'PTS) (qrfl)))))
;;; a lane body: run THUNK, then `ass' while the lane's leaf is still open
(define (lmu-lane-ass thunk)
  (dk-lane (lambda () (thunk) (dk-lane-if! ass))))

(sp (make-wff '(FORALL fcl (IMPLIES (IS-CLOSED RR-MS fcl) (IN fcl (BOREL-SETS RR-MS))))))
(dk-peel!)
(lmu-ptsq!)
(let* ((pts '(PTS RR-MS))
       (cu (list 'COMPLEMENT-IN pts 'fcl))
       (cc (list 'COMPLEMENT-IN pts cu))
       (gens (list 'SEP 'mou_ (list 'POWER pts) '(IS-OPEN RR-MS mou_)))
       (sg (list 'SIGMA-GENERATED pts gens)))
  (dk-project! (list 'SUBSET 'fcl pts) 'is-closed '(IS-CLOSED RR-MS fcl))
  (dk-project! (list 'IS-OPEN 'RR-MS cu) 'is-closed '(IS-CLOSED RR-MS fcl))
  (dk-have! (list 'IN pts 'SET) (lmu-lane-ass (lambda () (subst lmu-ptsq) (fact 'rr-is-set))))
  (dk-have! (list 'SUBSET gens (list 'POWER pts))
    (lambda () (mac 'subset-def)
      (let ((uv (dk-di-var!)))
        (sep-me (list 'IN uv gens)) (dk-split-all!) (ass))))
  (fact 'sigma-generated-is-sigma-algebra pts gens)
  (fact 'power-complement-closed pts 'fcl)
  (dk-have! (list 'IN cu gens) (lambda () (in-sep! dk-ass! (lambda () (ass)))))
  (dk-have! (list 'FORALL 'cb_ (list 'IMPLIES (list 'AND (list 'IS-SIGMA-ALGEBRA pts 'cb_) (list 'SUBSET gens 'cb_))
                                     (list 'IN cu 'cb_)))
    (lmu-lane-ass (lambda ()
      (dk-peel!)
      (dk-split-all!)
      (let ((cbv (caddr (dk-goal))))
        (fact 'subset-mem-fwd gens cbv cu)))))
  (fact 'sigma-generated-intro pts gens cu)
  (fact 'sigma-algebra-complement-closed pts sg cu)
  (fact 'complement-in-double pts 'fcl)
  (dk-rewrite-h! (list 'IN cc sg) cc 'fcl)
  (subst (dk-cite! 'borel-sets-unfold 'RR-MS))
  (ass))
(qed 'rr-closed-borel)
(topic! 'rr-closed-borel 'set-quotient)

;;; [a, b] is closed in the line: it is the closed ball about (a+b)/2 of radius (b-a)/2
(sp (make-wff (forall-guarded '(a_ b_) '((IN a_ RR) (IN b_ RR)) '(IS-CLOSED RR-MS (CCINT a_ b_)))))
(dk-peel!)
(lmu-ptsq!)
(let* ((cen '(* 1/2 (+ a_ b_)))
       (rad '(* 1/2 (- b_ a_)))
       (ball (list 'CLOSED-BALL 'RR-MS cen rad))
       (cc '(CCINT a_ b_)))
  (lmu-real! cen)
  (lmu-real! rad)
  (fact 'rr-is-metric-space)
  (dk-have! (list 'IN cen '(PTS RR-MS)) (lambda () (subst lmu-ptsq) (ass)))
  (dk-apply! (dk-cite! 'closed-ball-is-closed 'RR-MS) cen rad)
  (dk-have! (list '= ball cc)
    (lambda ()
      (lmu-class-eq! ball cc
        (lambda (xv)
          (lmu-iff-fwd! 'closed-ball-membership 'RR-MS cen rad xv)
          (dk-have! (list 'IN xv 'RR) (lambda () (subst (list '= 'RR '(PTS RR-MS))) (ass)))
          (let* ((de (dk-cite! 'rr-ms-dist cen xv))
                 (le (dk-pick (lambda (h) (and (dk-head-is? h '<=) (dk-contains? h 'DIST))) "the distance bound"))
                 (le2 (dk-rewrite-h! le (cadr de) (caddr de))))
            (lmu-real! (list '- cen xv))
            (let ((pp (dk-apply! (dk-cite! 'rr-abs-le-parts (list '- cen xv) rad))))
              (dk-split-all! (list pp))
              (dk-have! (list '<= 'a_ xv) (lambda () (dk-ineq! (cadr pp) (caddr pp) (list 'IN xv 'RR) '(IN a_ RR) '(IN b_ RR))))
              (dk-have! (list '<= xv 'b_) (lambda () (dk-ineq! (cadr pp) (caddr pp) (list 'IN xv 'RR) '(IN a_ RR) '(IN b_ RR)))))
            (lmu-iff-bwd! 'ccint-membership 'a_ 'b_ xv)
            (ass)))
        (lambda (xv)
          (lmu-iff-fwd! 'ccint-membership 'a_ 'b_ xv)
          (dk-have! (list 'IN xv '(PTS RR-MS)) (lambda () (subst lmu-ptsq) (ass)))
          (let ((de (dk-cite! 'rr-ms-dist cen xv)))
            (lmu-real! (list '- cen xv))
            (let* ((inst (dk-cite! 'rr-abs-le-of-parts (list '- cen xv) rad))
                   (h1 (cadr inst)) (h2 (cadr (caddr inst))))
              (dk-have! h1 (lambda () (dk-ineq! (list 'IN xv 'RR) '(IN a_ RR) '(IN b_ RR) (list '<= 'a_ xv) (list '<= xv 'b_))))
              (dk-have! h2 (lambda () (dk-ineq! (list 'IN xv 'RR) '(IN a_ RR) '(IN b_ RR) (list '<= 'a_ xv) (list '<= xv 'b_))))
              (dk-apply! inst))
            (dk-have! (list '<= (cadr de) rad) (lambda () (subst de) (ass)))
            (lmu-iff-bwd! 'closed-ball-membership 'RR-MS cen rad xv)
            (ass))))))
  (dk-rewrite-h! (list 'IS-CLOSED 'RR-MS ball) ball cc)
  (ass))
(qed 'ccint-closed-rr-ms)
(topic! 'ccint-closed-rr-ms 'set-quotient)

;;; every member of CLOSED-INTERVALS is a Borel set of the line
(define lmu-ci-body
  '(SEP oci_ (POWER RR)
     (OR (= oci_ EMPTY-SET)
         (FORSOME oca_ (AND (IN oca_ RR)
           (FORSOME ocb_ (AND (IN ocb_ RR) (AND (<= oca_ ocb_) (= oci_ (CCINT oca_ ocb_))))))))))

;;; the cases of a member V of CLOSED-INTERVALS: EMPTY with (= v EMPTY-SET), PAIR with
;;; x0 y0 and (IN x0 RR) (IN y0 RR) (<= x0 y0) (= v (CCINT x0 y0)) landed
(define (lmu-ci-cases! v empty pair)
  (fact 'closed-intervals-def)
  (let ((m (dk-rewrite-h! (list 'IN v 'CLOSED-INTERVALS) 'CLOSED-INTERVALS lmu-ci-body)))
    (sep-me m)
    (dk-split-all!)
    (let ((orf (dk-pick (lambda (h) (and (dk-head-is? h 'OR) (dk-contains? h v))) "the cases")))
      (use-cases (list (cadr orf) (caddr orf))
        empty
        (lambda ()
          (let* ((x0 (dk-skolem! (caddr orf) 'top))
                 (_ (dk-split-all!))
                 (ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h x0))) "y"))
                 (y0 (dk-skolem! ex 'top)))
            (dk-split-all!)
            (pair x0 y0)))))))

(sp (make-wff (list 'SUBSET 'CLOSED-INTERVALS lmu-bor)))
;; a member of BOREL-SETS(RR-MS) in context FIRST: it certifies the term at which
;; subset-def is instantiated (repair 3); the empty case below uses the same member
(dk-have! '(IN 1 RR) (lambda () (type-term)))
(dk-have! '(IN 0 RR) (lambda () (type-term)))
(fact 'ccint-closed-rr-ms 1 0)
(fact 'rr-closed-borel '(CCINT 1 0))
(mac 'subset-def)
(let ((v (dk-di-var!)))
  (lmu-ci-cases! v
    (lambda ()
      (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
      (fact 'ccint-empty-of-lt 1 0 0)
      (dk-rewrite-h! (list 'IN '(CCINT 1 0) lmu-bor) '(CCINT 1 0) 'EMPTY-SET)
      (subst (list '= v 'EMPTY-SET))
      (ass))
    (lambda (x0 y0)
      (fact 'ccint-closed-rr-ms x0 y0)
      (fact 'rr-closed-borel (list 'CCINT x0 y0))
      (subst (list '= v (list 'CCINT x0 y0)))
      (ass))))
(qed 'closed-intervals-borel)
(topic! 'closed-intervals-borel 'set-quotient)
;;; ====================================================================
;;; (5) A BOREL MEASURE THAT GIVES [a, b] ITS LENGTH IS BELOW lam* ON BOREL SETS
;;; ====================================================================

(define lmu-ism '(IS-MEASURE RR (BOREL-SETS RR-MS) mu))
(define lmu-hyp
  (forall-guarded '(a_ b_) '((IN a_ RR) (IN b_ RR) (<= a_ b_)) '(= (mu (CCINT a_ b_)) (- b_ a_))))

(define (lmu-and2! p q)
  (dk-have! (list 'AND p q) (lambda () (dk-conj-close! dk-ass!))))
(define (lmu-and3! p q r)
  (dk-have! (list 'AND p (list 'AND q r)) (lambda () (dk-conj-close! dk-ass!))))
;;; x <= z from x <= y, y <= z, all typed in [0, +inf]
(define (lmu-trans! x y z)
  (lmu-and3! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR) (list 'IN z 'RR-POS-STAR))
  (lmu-and2! (list '<= x y) (list '<= y z))
  (fact 'rr-pos-star-le-trans x y z))
;;; x = y in [0, +inf] from x <= y, y <= x, both typed
(define (lmu-antisymm! x y)
  (lmu-and2! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR))
  (lmu-and2! (list '<= x y) (list '<= y x))
  (fact 'rr-pos-star-le-antisymm x y))
;;; ESUM fv typed, for fv in FUN(NN, RR-POS-STAR) in context
(define (lmu-esum-type! fv)
  (if (not (dk-asm? (list 'IN (list 'ESUM fv) 'RR-POS-STAR)))
      (begin
        (fact 'nn-is-set)
        (dk-project! (list 'IN fv '(FUN NN)) 'fun-codomain-iff (list 'IN fv '(FUN NN RR-POS-STAR)))
        (lmu-and2! (list 'IN fv '(FUN NN)) '(IN NN SET))
        (fact 'dom-of-fun 'NN fv)
        (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN (list 'DOM fv) 'SET)
                                                (list '= (list 'DOM fv) 'NN)))))
        (dk-have! (list 'IN fv (list 'FUN (list 'DOM fv) 'RR-POS-STAR))
                  (lambda () (subst (list '= (list 'DOM fv) 'NN)) (ass)))
        (fact 'esum-in fv))))

;;; cite THM at ARGS and return its consequent, detaching every antecedent (each must
;;; be in context); the deepest link of the chain whether or not `fact' detached it
(define (lmu-cite! thm . args)
  (let loop ((r (apply dk-cite! thm args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (if (dk-asm? (caddr r))
            (loop (caddr r))
            (loop (dk-landed-1 (lambda () (detach! r)))))
        r)))

;;; the conjuncts of IS-MEASURE(RR, BOREL-SETS(RR-MS), mu), and BOREL-SETS(RR-MS) inside POWER(RR)
(define (lmu-measure-parts! cA nu)
  (let ((ism (list 'IS-MEASURE 'RR cA nu)))
    (dk-project! (list 'IS-SIGMA-ALGEBRA 'RR cA) 'IS-MEASURE ism)
    (dk-project! (list 'IN nu (list 'FUN cA 'RR-POS-STAR)) 'IS-MEASURE ism)
    (dk-project! (list '= (list nu 'EMPTY-SET) 0) 'IS-MEASURE ism)
    (dk-project! (list 'SUBSET cA lmu-pw) 'IS-SIGMA-ALGEBRA (list 'IS-SIGMA-ALGEBRA 'RR cA))))

(sp (make-wff (forall-guarded '(mu es) (list lmu-ism lmu-hyp (list 'IN 'es lmu-bor))
   (list '<= '(mu es) (lmu-lo 'es)))))
(dk-peel!)
(lmu-measure-parts! lmu-bor 'mu)
(fact 'subset-mem-fwd lmu-bor lmu-pw 'es)
(fact 'closed-intervals-borel)
(fact 'fun-apply-type-c 'mu lmu-bor 'RR-POS-STAR 'es)
(dk-project! (list 'IN lmu-lp '(FUN CLOSED-INTERVALS RR-POS-STAR)) 'IS-PREMEASURE
             (dk-landed-1 (lambda () (fact 'lebesgue-premeasure))))
(let* ((val (dk-cite! 'method-i-outer-value 'RR 'CLOSED-INTERVALS lmu-lp 'es))
       (csum (cadr (caddr val))))
  (fact 'cover-sums-subset 'RR 'CLOSED-INTERVALS lmu-lp 'es)
  (dk-have! (list 'FORALL 'lmv_ (list 'IMPLIES (list 'IN 'lmv_ csum) (list '<= '(mu es) 'lmv_)))
    (lambda ()
      (let* ((xv (dk-di-var!))
             (ex (dk-cite! 'cover-sums-elim 'RR 'CLOSED-INTERVALS lmu-lp 'es xv))
             (sv (dk-skolem! ex #t)))
        (dk-split-all!)
        (let* ((sub (dk-pick (lambda (h) (and (dk-head-is? h 'SUBSET) (eq? (cadr h) 'es) (dk-contains? h sv))) "the cover"))
               (bu (caddr sub))
               (xeq (dk-pick (lambda (h) (and (dk-head-is? h '=) (eq? (cadr h) xv))) "the cover sum"))
               (gsum (caddr xeq))
               (gl (cadr gsum))
               (fl (list 'VNB-LAMBDA 'n_ 'NN (list 'mu (list sv 'n_))))
               (bun (list 'BIG-UNION 'n_ 'NN (list sv 'n_))))
          (fact 'fun-codomain-superset sv 'NN 'CLOSED-INTERVALS lmu-bor)
          (fact 'sigma-algebra-union-closed 'RR lmu-bor sv)
          (fact 'measure-monotone 'RR lmu-bor 'mu 'es bun)
          (fact 'measure-countably-subadditive 'RR lmu-bor 'mu sv)
          (fact 'fun-apply-type-c 'mu lmu-bor 'RR-POS-STAR bun)
          ;; the two sequences are typed
          (dk-have! (list 'IN fl '(FUN NN RR-POS-STAR))
            (lambda ()
              (dk-lam-type!
                (lmu-lane-ass (lambda ()
                  (let ((kv (dk-di-var!)))
                    (fact 'fun-apply-type-c sv 'NN lmu-bor kv)
                    (fact 'fun-apply-type-c 'mu lmu-bor 'RR-POS-STAR (list sv kv))))))))
          (dk-have! (list 'IN gl '(FUN NN RR-POS-STAR))
            (lambda ()
              (dk-lam-type!
                (lmu-lane-ass (lambda ()
                  (let ((kv (dk-di-var!)))
                    (fact 'fun-apply-type-c sv 'NN 'CLOSED-INTERVALS kv)
                    (fact 'fun-apply-type-c lmu-lp 'CLOSED-INTERVALS 'RR-POS-STAR (list sv kv))))))))
          ;; termwise: mu(s k) <= length(s k)
          (dk-have! (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN) (list '<= (list fl 'k_) (list gl 'k_))))
            (lambda ()
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c sv 'NN 'CLOSED-INTERVALS kv)
                (fact 'fun-apply-type-c sv 'NN lmu-bor kv)
                (dk-lam-b!)
                (let ((sk (list sv kv)))
                  (lmu-ci-cases! sk
                    (lambda ()
                      (subst (list '= sk 'EMPTY-SET))
                      (subst (list '= '(mu EMPTY-SET) 0))
                      (fact 'interval-length-type 'EMPTY-SET)
                      (fact 'rr-pos-star-nonneg '(INTERVAL-LENGTH EMPTY-SET))
                      (ass))
                    (lambda (x0 y0)
                      (let ((cc (list 'CCINT x0 y0)))
                        (dk-apply! lmu-hyp x0 y0)
                        (fact 'ccint-in-closed-intervals x0 y0)
                        (let ((il (dk-cite! 'interval-length-ccint x0 y0)))
                          (dk-lam-b-h! il))
                        (subst (list '= sk cc))
                        (subst (list '= (list 'mu cc) (list '- y0 x0)))
                        (subst (list '= (list 'INTERVAL-LENGTH cc) (list '- y0 x0)))
                        (dk-ineq! (list 'IN x0 'RR) (list 'IN y0 'RR)))))))))
          (fact 'esum-nn-le-termwise fl gl)
          (lmu-esum-type! fl)
          (lmu-esum-type! gl)
          (lmu-trans! '(mu es) (list 'mu bu) (list 'ESUM fl))
          (lmu-trans! '(mu es) (list 'ESUM fl) gsum)
          (subst (list '= xv gsum))
          (ass)))))
  (fact 'einf-greatest csum '(mu es))
  (subst val)
  (ass))
(qed 'borel-measure-le-lebesgue-outer)
(topic! 'borel-measure-le-lebesgue-outer 'inequalities)
;;; ====================================================================
;;; (6) EQUALITY ON A BOREL SET INSIDE [p, q]
;;; ====================================================================

(sp (make-wff (forall-guarded '(mu p_ q_ es)
   (list lmu-ism lmu-hyp '(IN p_ RR) '(IN q_ RR) '(<= p_ q_) (list 'IN 'es lmu-bor) '(SUBSET es (CCINT p_ q_)))
   (list '= '(mu es) (lmu-lo 'es)))))
(dk-peel!)
(lmu-measure-parts! lmu-bor 'mu)
(lmu-setting!)
(let* ((cc '(CCINT p_ q_))
       (dd (list 'COMPLEMENT-IN cc 'es))
       (lq '(- q_ p_))
       (x '(mu es)) (y (list 'mu dd))
       (bx (lmu-lo 'es)) (by (lmu-lo dd)))
  (fact 'ccint-closed-rr-ms 'p_ 'q_)
  (fact 'rr-closed-borel cc)
  (fact 'sigma-algebra-difference-closed 'RR lmu-bor cc 'es)
  (fact 'subset-mem-fwd lmu-bor lmu-pw 'es)
  (lmu-pow-sub! 'es)
  (fact 'ccint-subset-rr 'p_ 'q_)
  (lmu-pow! cc)
  (fact 'complement-in-subset 'es cc)
  (fact 'subset-trans dd cc 'RR)
  (lmu-pow! dd)
  (lmu-real! lq)
  ;; mu: mu(dd) = mu(cc) - mu(es), mu(cc) = q - p
  (dk-apply! lmu-hyp 'p_ 'q_)
  (dk-have! (list 'IN (list 'mu cc) 'RR) (lambda () (subst (list '= (list 'mu cc) lq)) (ass)))
  (fact 'measure-subtractive 'RR lmu-bor 'mu 'es cc)
  ;; mu below lam* on es and on dd
  (fact 'borel-measure-le-lebesgue-outer 'mu 'es)
  (fact 'borel-measure-le-lebesgue-outer 'mu dd)
  ;; lam*: both pieces finite, and Caratheodory at [p, q]
  (fact 'lebesgue-outer-ccint 'p_ 'q_)
  (fact 'lebesgue-outer-mono 'es cc)
  (fact 'lebesgue-outer-mono dd cc)
  (for-each (lambda (s) (fact 'fun-apply-type-c lmu-lam lmu-pw 'RR-POS-STAR s)) (list 'es dd cc))
  (let ((l1 (dk-pick (lambda (h) (and (dk-head-is? h '<=) (equal? (cadr h) bx) (equal? (caddr h) (lmu-lo cc)))) "lam(es) <= lam(cc)"))
        (l2 (dk-pick (lambda (h) (and (dk-head-is? h '<=) (equal? (cadr h) by) (equal? (caddr h) (lmu-lo cc)))) "lam(dd) <= lam(cc)")))
    (dk-rewrite-h! l1 (lmu-lo cc) lq)
    (dk-rewrite-h! l2 (lmu-lo cc) lq))
  (lmu-and2! (list 'IN bx 'RR-POS-STAR) (list 'IN lq 'RR)) (fact 'rr-pos-star-le-real-in-rr bx lq)
  (lmu-and2! (list 'IN by 'RR-POS-STAR) (list 'IN lq 'RR)) (fact 'rr-pos-star-le-real-in-rr by lq)
  (fact 'fun-apply-type-c 'mu lmu-bor 'RR-POS-STAR 'es)
  (fact 'fun-apply-type-c 'mu lmu-bor 'RR-POS-STAR dd)
  (lmu-and2! (list 'IN x 'RR-POS-STAR) (list 'IN bx 'RR)) (fact 'rr-pos-star-le-real-in-rr x bx)
  (lmu-and2! (list 'IN y 'RR-POS-STAR) (list 'IN by 'RR)) (fact 'rr-pos-star-le-real-in-rr y by)
  (fact 'rr-pos-star-nonneg bx)
  (fact 'rr-pos-star-nonneg by)
  (fact 'lebesgue-borel-measurable 'es)
  (dk-project! (lmu-carf 'es) 'IS-CARATHEODORY-MEASURABLE (list 'IS-CARATHEODORY-MEASURABLE 'RR lmu-lam 'es))
  (let* ((car (dk-apply! (lmu-carf 'es) cc))
         (ie (dk-have! (list '= (list 'INTERSECTION cc 'es) 'es)
               (lambda ()
                 (lmu-class-eq! (list 'INTERSECTION cc 'es) 'es
                   (lambda (xv) (lmu-iff-fwd! 'intersection-membership cc 'es xv) (ass))
                   (lambda (xv)
                     (fact 'subset-mem-fwd 'es cc xv)
                     (lmu-iff-bwd! 'intersection-membership cc 'es xv)
                     (ass))))))
         (du (dk-cite! 'difference-unfold cc 'es))
         (c1 (dk-rewrite-h! car (list 'INTERSECTION cc 'es) 'es))
         (c2 (dk-rewrite-h! c1 (list 'DIFFERENCE cc 'es) dd))
         (c3 (dk-rewrite-h! c2 (lmu-lo cc) lq))
         (ep (begin (dk-have! (list '= (list 'eplus bx by) (list 'binplus bx by))
                       (lmu-lane-ass (lambda () (fact 'eplus-real-defined bx by))))
                     (list '= (list 'eplus bx by) (list 'binplus bx by))))
         (c4 (dk-rewrite-h! c3 (cadr ep) (caddr ep)))
         (bp (dk-cite! 'binplus-apply bx by))
         (c5 (dk-rewrite-h! c4 (cadr bp) (caddr bp)))
         (sb (dk-pick (lambda (h) (and (dk-head-is? h '=) (equal? (cadr h) y))) "mu(dd) = mu(cc) - mu(es)"))
         (s2 (dk-rewrite-h! sb (list 'mu cc) lq))
         (lx (list '<= x bx))
         (ly (list '<= y by))
         (prems (list c5 s2 lx ly (list 'IN x 'RR) (list 'IN y 'RR) (list 'IN bx 'RR) (list 'IN by 'RR) '(IN p_ RR) '(IN q_ RR))))
    (apply dk-ineq! prems)))
(qed 'borel-measure-eq-lebesgue-outer-bounded)
(topic! 'borel-measure-eq-lebesgue-outer-bounded 'inequalities)
;;; ====================================================================
;;; (7) A MEASURE ON THE LINE IS EXHAUSTED BY THE [-n, n]
;;; ====================================================================

(define (lmu-cn n) (list 'CCINT (list '- 0 n) n))
(define (lmu-sl n) (list 'INTERSECTION 'es (lmu-cn n)))
(define lmu-hypcc '(FORALL n_ (IMPLIES (IN n_ NN) (IN (CCINT (- 0 n_) n_) cA))))
(define lmu-hypb '(FORALL n_ (IMPLIES (IN n_ NN) (<= (nu (INTERSECTION es (CCINT (- 0 n_) n_))) bd_))))

;;; (POS-RR 1)
(define (lmu-pos-one!)
  (if (not (dk-asm? '(POS-RR 1)))
      (dk-have! '(POS-RR 1)
        (lambda () (mac 'pos-rr) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (arith))))))))

(sp (make-wff (forall-guarded '(cA nu es bd_)
   (list '(IS-MEASURE RR cA nu) lmu-hypcc '(IN es cA) '(IN bd_ RR-POS-STAR) lmu-hypb)
   '(<= (nu es) bd_))))
(dk-peel!)
(lmu-measure-parts! 'cA 'nu)
(fact 'subset-mem-fwd 'cA lmu-pw 'es)
(lmu-pow-sub! 'es)
(let* ((ab (dk-abstract! 'NN 'cA lmu-sl
             (lambda (k)
               ((lmu-lane-ass
                  (lambda ()
                    (dk-apply! lmu-hypcc k)
                    (fact 'sigma-algebra-inter-closed-2 'RR 'cA 'es (lmu-cn k))))))))
       (g (car ab))
       (ve (cdr ab))
       (bu (list 'BIG-UNION 'n_ 'NN (list g 'n_)))
       (phi (list 'VNB-LAMBDA 'n_ 'NN (list 'nu (list g 'n_))))
       (im (list 'IMAGE phi 'NN))
       (mono (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'SUBSET (list g 'n_) (list g '(succ n_)))))))
  (if (not (dk-asm? (list 'IN g '(FUN NN cA))))
      (error "lmu: the family's typing did not land"))
  ;; the slices increase
  (dk-have! mono
    (lambda ()
      (let* ((nv (dk-di-var!)) (sn (list 'succ nv)) (n1 (list '+ nv 1)))
        (fact 'nn-succ-closed nv)
        (fact 'nn-in-rr nv)
        (fact 'nn-zero-le nv)
        (subst (dk-apply! ve nv))
        (subst (dk-apply! ve sn))
        (fact 'nn-succ-plus-one nv)
        (subst (list '= sn n1))
        (mac 'subset-def)
        (let ((zv (dk-di-var!)))
          (lmu-iff-fwd! 'intersection-membership 'es (lmu-cn nv) zv)
          (lmu-iff-fwd! 'ccint-membership (list '- 0 nv) nv zv)
          (dk-have! (list '<= (list '- 0 n1) zv)
            (lambda () (dk-ineq! (list 'IN nv 'RR) (list 'IN zv 'RR) (list '<= 0 nv) (list '<= (list '- 0 nv) zv))))
          (dk-have! (list '<= zv n1)
            (lambda () (dk-ineq! (list 'IN nv 'RR) (list 'IN zv 'RR) (list '<= zv nv))))
          (lmu-iff-bwd! 'ccint-membership (list '- 0 n1) n1 zv)
          (lmu-iff-bwd! 'intersection-membership 'es (lmu-cn n1) zv)
          (ass)))))
  ;; the slices exhaust es
  (fact 'nn-is-set)
  (lmu-pos-one!)
  (dk-have! (list '= bu 'es)
    (lambda ()
      (lmu-class-eq! bu 'es
        (lambda (xv)
          (let* ((landed (dk-landed (lambda () (bu-me (list 'IN xv bu)))))
                 (ein (find-first (lambda (f) (and (eq? (car f) 'IN) (eq? (caddr f) 'NN))) landed))
                 (ev (cadr ein)))
            (dk-apply! ve ev)
            (dk-rewrite-h! (list 'IN xv (list g ev)) (list g ev) (lmu-sl ev))
            (lmu-iff-fwd! 'intersection-membership 'es (lmu-cn ev) xv)
            (ass)))
        (lambda (xv)
          (fact 'subset-mem-fwd 'es 'RR xv)
          (fact 'rr-abs-closed xv)
          (let* ((ex (dk-apply! (dk-cite! 'rr-archimedean-multiple 1) (list 'abs xv)))
                 (nv (dk-skolem! ex)))
            (fact 'nn-in-rr nv)
            (let ((le1 (dk-pick (lambda (h) (and (dk-head-is? h '<=) (equal? (cadr h) (list 'abs xv)))) "abs bound")))
              (dk-have! (list '<= (list 'abs xv) nv)
                (lambda () (dk-ineq! le1 (list 'IN (list 'abs xv) 'RR) (list 'IN nv 'RR)))))
            (let ((pp (dk-apply! (dk-cite! 'rr-abs-le-parts xv nv))))
              (dk-split-all! (list pp))
              (dk-have! (list '<= (list '- 0 nv) xv)
                (lambda () (dk-ineq! (cadr pp) (list 'IN nv 'RR) (list 'IN xv 'RR))))
              (lmu-iff-bwd! 'ccint-membership (list '- 0 nv) nv xv)
              (lmu-iff-bwd! 'intersection-membership 'es (lmu-cn nv) xv)
              (dk-apply! ve nv)
              (dk-rewrite-h! (list 'IN xv (lmu-sl nv)) (lmu-sl nv) (list g nv))
              (for-each (lambda (l) (dk-focus! l) (ass))
                        (dk-opened (lambda () (bu-mi nv))))))))))
  (fact 'measure-continuity-from-below 'RR 'cA 'nu g)
  (let* ((cont (dk-pick (lambda (h) (and (dk-head-is? h '=) (dk-contains? h 'ESUP) (dk-contains? h g))) "continuity from below"))
         (c2 (dk-rewrite-h! cont bu 'es))
         (elem! (lambda (w)
                  (lmu-iff-fwd! 'image-membership-iff phi 'NN w)
                  (let* ((ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h w))) "the preimage"))
                         (kv (dk-skolem! ex))
                         (pe (list '= (list phi kv) w)))
                    (dk-lam-b-h! pe)
                    (if (not (dk-asm? (list '= (list 'nu (list g kv)) w)))
                        (error "lmu: the image member did not reduce"))
                    kv))))
    (dk-have! (list 'SUBSET im 'RR-POS-STAR)
      (lambda ()
        (mac 'subset-def)
        (let* ((w (dk-di-var!)) (kv (elem! w)))
          (fact 'fun-apply-type-c g 'NN 'cA kv)
          (fact 'fun-apply-type-c 'nu 'cA 'RR-POS-STAR (list g kv))
          (dk-rewrite-h! (list 'IN (list 'nu (list g kv)) 'RR-POS-STAR) (list 'nu (list g kv)) w)
          (ass))))
    (dk-have! (list 'FORALL 'lmw_ (list 'IMPLIES (list 'IN 'lmw_ im) '(<= lmw_ bd_)))
      (lambda ()
        (let* ((w (dk-di-var!)) (kv (elem! w)))
          (let* ((le (dk-apply! lmu-hypb kv)))
            (dk-apply! ve kv)
            (let* ((le2 (dk-rewrite-h! le (lmu-sl kv) (list g kv)))
                   (le3 (dk-rewrite-h! le2 (list 'nu (list g kv)) w)))
              (ass))))))
    (lmu-and2! '(IN bd_ RR-POS-STAR) (list 'FORALL 'lmw_ (list 'IMPLIES (list 'IN 'lmw_ im) '(<= lmw_ bd_))))
    (fact 'esup-least im 'bd_)
    (subst c2)
    (ass)))
(qed 'measure-le-of-ccint-exhaust)
(topic! 'measure-le-of-ccint-exhaust 'inequalities)
;;; ====================================================================
;;; (8) ITEM 3: UNIQUENESS OF LEBESGUE MEASURE ON THE BOREL SETS
;;; ====================================================================

(sp (make-wff (forall-guarded '(mu es) (list lmu-ism lmu-hyp (list 'IN 'es lmu-bor))
   (list '= '(mu es) (lmu-mu-at 'es)))))
(dk-peel!)
(lmu-measure-parts! lmu-bor 'mu)
(lmu-setting!)
(fact 'subset-mem-fwd lmu-bor lmu-pw 'es)
(fact 'lebesgue-borel-measurable 'es)
(lmu-iff-bwd! 'caratheodory-sets-membership 'RR lmu-lam 'es)
(fact 'fun-apply-type-c 'mu lmu-bor 'RR-POS-STAR 'es)
(fact 'fun-apply-type-c lmu-lam lmu-pw 'RR-POS-STAR 'es)
(let ((res (lmu-res! 'es))
      (hcc (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IN (lmu-cn 'n_) lmu-cs))))
      (hb (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
             (list '<= (list lmu-mu (list 'INTERSECTION 'es (lmu-cn 'n_))) '(mu es))))))
  (subst res)
  ;; mu <= lam*
  (fact 'borel-measure-le-lebesgue-outer 'mu 'es)
  ;; lam* <= mu: the Lebesgue measure is exhausted by the [-n, n]
  (fact 'caratheodory-measure 'RR lmu-lam)
  (dk-have! hcc
    (lambda ()
      (let ((nv (dk-di-var!)))
        (fact 'nn-in-rr nv)
        (fact 'nn-zero-le nv)
        (lmu-real! (list '- 0 nv))
        (dk-have! (list '<= (list '- 0 nv) nv) (lambda () (dk-ineq! (list 'IN nv 'RR) (list '<= 0 nv))))
        (let ((both (lmu-cite! 'lebesgue-measure-ccint (list '- 0 nv) nv)))
          (dk-split-all! (list both))
          (ass)))))
  (dk-have! hb
    (lambda ()
      (let* ((nv (dk-di-var!))
             (cn (lmu-cn nv))
             (it (list 'INTERSECTION 'es cn)))
        (fact 'nn-in-rr nv)
        (fact 'nn-zero-le nv)
        (lmu-real! (list '- 0 nv))
        (dk-have! (list '<= (list '- 0 nv) nv) (lambda () (dk-ineq! (list 'IN nv 'RR) (list '<= 0 nv))))
        (fact 'ccint-closed-rr-ms (list '- 0 nv) nv)
        (fact 'rr-closed-borel cn)
        (fact 'sigma-algebra-inter-closed-2 'RR lmu-bor 'es cn)
        (dk-have! (list 'SUBSET it cn)
          (lambda () (mac 'subset-def)
            (let ((zv (dk-di-var!))) (lmu-iff-fwd! 'intersection-membership 'es cn zv) (ass))))
        (dk-have! (list 'SUBSET it 'es)
          (lambda () (mac 'subset-def)
            (let ((zv (dk-di-var!))) (lmu-iff-fwd! 'intersection-membership 'es cn zv) (ass))))
        (fact 'borel-measure-eq-lebesgue-outer-bounded 'mu (list '- 0 nv) nv it)
        (fact 'measure-monotone 'RR lmu-bor 'mu it 'es)
        (dk-apply! hcc nv)
        (fact 'sigma-algebra-inter-closed-2 'RR lmu-cs 'es cn)
        (let ((r2 (lmu-res! it)))
          (subst r2)
          (subst (list '= (lmu-lo it) (list 'mu it)))
          (ass)))))
  (fact 'measure-le-of-ccint-exhaust lmu-cs lmu-mu 'es '(mu es))
  (let ((le (dk-pick (lambda (h) (and (dk-head-is? h '<=) (equal? (cadr h) (lmu-mu-at 'es)))) "lam(es) <= mu(es)")))
    (dk-rewrite-h! le (lmu-mu-at 'es) (lmu-lo 'es)))
  (lmu-antisymm! '(mu es) (lmu-lo 'es))
  (ass))
(qed 'lebesgue-measure-unique)
(topic! 'lebesgue-measure-unique 'set-quotient)

(gloss! 'lebesgue-measurable-translate
  "Translation preserves the Lebesgue sets and Lebesgue measure: if E is Lebesgue measurable
   and c is real, then E + c is Lebesgue measurable and has the measure of E.")
(gloss! 'lebesgue-measure-unique
  "Uniqueness of Lebesgue measure: a measure on the Borel sets of the line that gives every
   closed interval [a, b] the measure b - a agrees with Lebesgue measure on every Borel set.")
