;;; isom-group.scm -- calculus.pdf Propositions 3.37 and 3.38: the group of isometries
;;; of a compact metric space, with the sup metric, is compact, and in it uniform and
;;; pointwise convergence agree.  Agent ISOM, 2026-10-26.
;;;
;;;   isometry-group-subset-fun        Gamma lies in FUN(pts s, pts s)
;;;   isometry-family-equicontinuous   a sequence in Gamma is equicontinuous (delta = eps)
;;;   ptwise-limit-in-isometry-group   s compact: a pointwise limit of a sequence in Gamma
;;;                                    is in Gamma (an isometry by passing to the limit;
;;;                                    onto: y = f_k(x_k), a subsequence x_k -> z, g(z) = y)
;;;   ptwise-conv-iff-converges-to     CONVERGES-PTWISE-TO read as CONVERGES-TO at each x
;;;   isometry-group-conv-iff-uniform  convergence in d_Gamma = uniform convergence
;;;   isometry-group-uniform-iff-ptwise                                  (Prop 3.38)
;;;   isometry-subseq-ptwise           a sequence in Gamma has a pointwise convergent
;;;                                    subsequence (dense sequence, diagonal, Lemma 3.36)
;;;   isometry-group-compact                                              (Prop 3.37)
;;;
;;; 3.37 is proved SEQUENTIALLY (seq-compact-implies-compact): the subsequence converges
;;; pointwise (isometry-subseq-ptwise), its limit is in Gamma, and by Prop 3.33
;;; (equicont-ptwise-implies-uniform) the convergence is uniform, i.e. in d_Gamma.  This is
;;; the Ascoli argument of the notes specialised to Gamma; the tree's Ascoli theorem is for
;;; real-valued functions only, so it is not cited.
;;;
;;; WINDOW.  Citations: the files isom-uc, isom-equicont, isom-supdist, isom-dense (all
;;; before this one), rmm-dense-seq-exists (riesz-markov-model), rr-le-of-le-add-all-pos
;;; (rake-dual-norm-spec), seq-compact-implies-compact, compact-implies-complete,
;;; strictly-mono-ge-id, inverse-bij-*, subseq-apply.  lo = after isom-dense.scm; hi =
;;; none.  Library: analysis.
;;;
;;; Helper prefix: isg-.

(define (isg-head g) (and (pair? g) (car g)))
(define (isg-iff-rhs! iff)
  (let ((rhs (caddr iff)))
    (dk-have! rhs (lambda () (prop)))
    (if (eq? (isg-head rhs) 'AND) (dk-split-all! (list rhs)))
    rhs))
(define (isg-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass))))))
    f))
(define (isg-ds a b) (list '(DIST s) a b))
(define isg-G '(ISOMETRY-GROUP s))
(define isg-F '(FUN (PTS s) (PTS s)))

;;; Gamma lies in FUN(pts s, pts s)
;;; SUBSEQ(f, phi) in FUN(NN, A) from f in FUN(NN, A) and phi strictly monotone, by
;;; unfolding (subseq-fun-typing, ca6-hurwitz.scm, sits in the complex-analysis library)
(define (isg-subseq-type! f phi A)
  (let ((claim (list 'IN (list 'SUBSEQ f phi) (list 'FUN 'NN A))))
    (if (not (dk-asm? claim))
        (dk-have! claim
          (lambda ()
            (if (not (dk-asm? (list 'IN phi '(FUN NN NN))))
                (dk-project! (list 'IN phi '(FUN NN NN)) 'strictly-mono-nn (list 'STRICTLY-MONO-NN phi)))
            (if (not (dk-asm? '(IN NN SET))) (fact 'nn-is-set))
            (mac 'SUBSEQ)
            (for-each
             (lambda (kn)
               (if (not (sequent-node-grounded? kn))
                   (begin
                     (dk-focus! kn)
                     (if (and (eq? (car (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
                         (ass)
                         (let ((k (dk-di-var!)))
                           (fact 'fun-apply-type-c phi 'NN 'NN k)
                           (dk-close-if! (lambda () (fact 'fun-apply-type-c f 'NN A (list phi k))) ass))))))
             (dk-opened (lambda () (lam-t)))))))
    claim))

(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s)
     (SUBSET (ISOMETRY-GROUP s) (FUN (PTS s) (PTS s)))))))
(dk-peel!)
(fact 'isometry-group-is-set 's)
(mac 'subset-def)
(let ((w (dk-di-var!)))
  (dk-close-if! (lambda () (fact 'isometry-group-in-fun 's w)) ass))
(qed 'isometry-group-subset-fun)
(topic! 'isometry-group-subset-fun 'analysis)

;;; the isometry equation of a member PHI of Gamma at A, B (typed in pts s), landed
(define (isg-iso! phi a b)
  (let ((e (list '= (isg-ds (list phi a) (list phi b)) (isg-ds a b)))
        (cl (list 'FORALL 'isga_ (list 'IMPLIES '(IN isga_ (PTS s))
              (list 'FORALL 'isgb_ (list 'IMPLIES '(IN isgb_ (PTS s))
                (list '= (isg-ds (list phi 'isga_) (list phi 'isgb_)) (isg-ds 'isga_ 'isgb_))))))))
    (if (not (dk-asm? e))
        (begin
          (if (not (dk-asm? cl))
              (begin
                (dk-project! (list 'IS-ISOMETRY 's 's phi) 'isometry-group-membership (list 'IN phi isg-G))
                (dk-project! cl 'is-isometry (list 'IS-ISOMETRY 's 's phi))))
          (dk-have! e (lambda () (dk-close-if! (lambda () (inst*! (dk-ctx-form cl) a b)) ass)))))
    e))

;;; =====================================================================
;;; isometry-family-equicontinuous
;;; =====================================================================
(sp (make-wff '(FORALL s (FORALL fam (IMPLIES (IS-METRIC-SPACE s)
     (IMPLIES (IN fam (FUN NN (ISOMETRY-GROUP s)))
       (IS-EQUICONTINUOUS s s fam)))))))
(dk-peel!)
(fact 'isometry-group-subset-fun 's)
(dk-close-if! (lambda () (fact 'fun-codomain-superset 'fam 'NN isg-G isg-F)) (lambda () #t))
(mac 'is-equicontinuous)
(dk-conj-close!
 (lambda ()
   (if (not (eq? (isg-head (dk-goal)) 'FORALL))
       (ass)
       (let* ((pl (dk-peel!))
              (x (cadr (car (filter (lambda (f) (eq? (isg-head f) 'IN)) pl))))
              (e (cadr (car (filter (lambda (f) (eq? (isg-head f) 'POS-RR)) pl)))))
         (ew e)
         (dk-conj-close!
          (lambda ()
            (if (not (eq? (isg-head (dk-goal)) 'FORALL))
                (ass)
                (let* ((pk (dk-peel!))
                       (k (cadr (car (filter (lambda (f) (and (eq? (isg-head f) 'IN) (eq? (caddr f) 'NN))) pk))))
                       (y (cadr (car (filter (lambda (f) (and (eq? (isg-head f) 'IN) (equal? (caddr f) '(PTS s)))) pk))))
                       (fk (list 'fam k)))
                  (fact 'fun-apply-type-c 'fam 'NN isg-G k)
                  (isg-iso! fk x y)
                  (fact 'isometry-group-in-fun 's fk)
                  (fact 'fun-apply-type-c fk '(PTS s) '(PTS s) x)
                  (fact 'fun-apply-type-c fk '(PTS s) '(PTS s) y)
                  (fact 'metric-dist-real 's (list fk x) (list fk y))
                  (fact 'rr-pos-rr-in-rr e)
                  (fact 'metric-dist-real 's x y)
                  (dk-ineq! (list '= (isg-ds (list fk x) (list fk y)) (isg-ds x y))
                            (list '< (isg-ds x y) e)
                            (list 'IN (isg-ds (list fk x) (list fk y)) 'RR)
                            (list 'IN (isg-ds x y) 'RR) (list 'IN e 'RR))))))))))
(qed 'isometry-family-equicontinuous)
(topic! 'isometry-family-equicontinuous 'analysis)
(alias! 'isometry-family-equicontinuous "a sequence of isometries of a metric space is equicontinuous")

;;; =====================================================================
;;; ptwise-limit-in-isometry-group: on a compact space a pointwise limit of
;;; isometries of s onto itself is again one (an isometry by passing to the limit;
;;; onto because y = fam(k)(x_k) with x_k = fam(k)^-1(y), and a subsequence of the
;;; x_k converges to some z, whence g(z) = y)
;;; =====================================================================
(define isg-P #f)                         ; the pointwise clause
(define (isg-fk! k)                       ; fam(k) in Gamma and in FUN(pts s, pts s)
  (let ((fk (list 'fam k)))
    (if (not (dk-asm? (list 'IN fk isg-G))) (fact 'fun-apply-type-c 'fam 'NN isg-G k))
    (if (not (dk-asm? (list 'IN fk isg-F))) (fact 'isometry-group-in-fun 's fk))
    fk))
(define (isg-pt! f x)                     ; f(x) in pts s
  (let ((t (list 'IN (list f x) '(PTS s))))
    (if (not (dk-asm? t)) (fact 'fun-apply-type-c f '(PTS s) '(PTS s) x))
    (list f x)))
(define (isg-real! a b)                   ; d(a, b) in RR, a, b in pts s
  (let ((t (list 'IN (isg-ds a b) 'RR)))
    (if (not (dk-asm? t)) (fact 'metric-dist-real 's a b))
    t))
;;; the pointwise threshold at x for tolerance e: returns (n . clause)
(define (isg-thr! x e)
  (let* ((n (dk-skolem! (dk-apply! isg-P x e)))
         (cl (dk-pick (lambda (h) (and (eq? (isg-head h) 'FORALL) (dk-contains? h n))) "the threshold clause")))
    (cons n cl)))
(define (isg-nat-sum! a b)                ; a + b in NN, a <= a + b, b <= a + b
  (let ((k (list '+ a b)))
    (isg-and! (list 'IN a 'NN) (list 'IN b 'NN))
    (fact 'nn-add-closed a b)
    (dk-have! (list '<= a k) (lambda () (dk-nn!)))
    (dk-have! (list '<= b k) (lambda () (dk-nn!)))
    k))

;;; for x, y in pts s and d > 0: an index k with d(F x, g x) <= d/2, d(F y, g y) <= d/2,
;;; F = fam(k); the four triangles and two symmetries; returns the premise list
(define (isg-near-pair! x y d)
  (let* ((h (dk-halve! d))
         (t1 (isg-thr! x h)) (t2 (isg-thr! y h))
         (k (isg-nat-sum! (car t1) (car t2)))
         (F (isg-fk! k))
         (gx (isg-pt! 'g x)) (gy (isg-pt! 'g y))
         (Fx (isg-pt! F x)) (Fy (isg-pt! F y)))
    (dk-apply! (cdr t1) k)
    (dk-apply! (cdr t2) k)
    (isg-iso! F x y)
    (fact 'metric-triangle 's gx Fx gy)
    (fact 'metric-triangle 's Fx Fy gy)
    (fact 'metric-triangle 's Fx gx Fy)
    (fact 'metric-triangle 's gx gy Fy)
    (fact 'metric-sym 's gx Fx)
    (fact 'metric-sym 's gy Fy)
    (fact 'rr-pos-rr-in-rr h)
    (fact 'rr-pos-rr-in-rr d)
    (append
     (list (list '<= (isg-ds Fx gx) h) (list '<= (isg-ds Fy gy) h)
           (list '= (isg-ds Fx Fy) (isg-ds x y))
           (list '<= (isg-ds gx gy) (list '+ (isg-ds gx Fx) (isg-ds Fx gy)))
           (list '<= (isg-ds Fx gy) (list '+ (isg-ds Fx Fy) (isg-ds Fy gy)))
           (list '<= (isg-ds Fx Fy) (list '+ (isg-ds Fx gx) (isg-ds gx Fy)))
           (list '<= (isg-ds gx Fy) (list '+ (isg-ds gx gy) (isg-ds gy Fy)))
           (list '= (isg-ds gx Fx) (isg-ds Fx gx))
           (list '= (isg-ds gy Fy) (isg-ds Fy gy))
           (list '= (list '+ h h) d)
           (list 'IN h 'RR) (list 'IN d 'RR))
     (map (lambda (pq) (isg-real! (car pq) (cadr pq)))
          (list (list gx gy) (list x y) (list Fx gx) (list Fy gy) (list Fx Fy) (list gx Fx)
                (list Fx gy) (list gx Fy) (list gy Fy))))))

(define (isg-le-by-eps! a b prove)        ; a <= b from a <= b + d for every d > 0
  (dk-have! (list 'FORALL 'isgd_ (list 'IMPLIES '(POS-RR isgd_) (list '<= a (list '+ b 'isgd_))))
    (lambda ()
      (let* ((pl (dk-peel!))
             (d (cadr (car (filter (lambda (f) (eq? (isg-head f) 'POS-RR)) pl)))))
        (prove d))))
  (dk-close-if! (lambda () (fact 'rr-le-of-le-add-all-pos a b)) (lambda () #t))
  (list '<= a b))

(sp (make-wff '(FORALL s (FORALL fam (FORALL g
     (IMPLIES (IS-COMPACT s)
       (IMPLIES (IN fam (FUN NN (ISOMETRY-GROUP s)))
         (IMPLIES (CONVERGES-PTWISE-TO s s fam g)
           (IN g (ISOMETRY-GROUP s))))))))))
(dk-peel!)
(dk-project! '(IS-METRIC-SPACE s) 'is-compact '(IS-COMPACT s))
(isg-iff-rhs! (dk-cite! 'converges-ptwise-to 's 's 'fam 'g))
(set! isg-P (dk-pick (lambda (h) (and (eq? (isg-head h) 'FORALL) (dk-contains? h 'POS-RR)
                                      (dk-contains? h 'g)))
                     "the pointwise clause"))
;;; (i) g is an isometry
(dk-have! '(IS-ISOMETRY s s g)
  (lambda ()
    (mac 'is-isometry)
    (dk-conj-close!
     (lambda ()
       (if (not (eq? (isg-head (dk-goal)) 'FORALL))
           (ass)
           (begin
             (dk-peel!)
             (let* ((x (cadr (cadr (cadr (dk-goal)))))
                    (y (cadr (caddr (cadr (dk-goal)))))
                    (a (isg-ds (list 'g x) (list 'g y)))
                    (b (isg-ds x y)))
               (isg-pt! 'g x) (isg-pt! 'g y)
               (isg-real! (list 'g x) (list 'g y))
               (isg-real! x y)
               (isg-le-by-eps! a b
                 (lambda (d) (apply dk-ineq! (isg-near-pair! x y d))))
               (isg-le-by-eps! b a
                 (lambda (d) (apply dk-ineq! (isg-near-pair! x y d))))
               (isg-and! (list 'IN a 'RR) (list 'IN b 'RR))
               (isg-and! (list '<= a b) (list '<= b a))
               (dk-close-if! (lambda () (fact 'rr-leq-antisymmetric a b)) ass))))))))
(define isg-giso (isg-iff-rhs! (dk-cite! 'is-isometry 's 's 'g)))
(define isg-gcl (dk-pick (lambda (h) (and (eq? (isg-head h) 'FORALL) (dk-contains? h '(DIST s))
                                          (dk-contains? h 'g) (not (dk-contains? h 'POS-RR))))
                         "the isometry clause of g"))
;;; (ii) g is a bijection
(dk-have! '(IN g (BIJECTION (PTS s) (PTS s)))
  (lambda ()
    (mac 'bijection-membership-iff)
    (dk-conj-close!
     (lambda ()
       (let ((gl (dk-goal)))
         (cond
          ((not (eq? (isg-head gl) 'FORALL)) (ass))
          ;; injective
          ((not (dk-contains? gl 'FORSOME))
           (let* ((pl (dk-peel!))
                  (eqn (car (filter (lambda (f) (eq? (isg-head f) '=)) pl)))
                  (a (cadr (cadr eqn))) (b (cadr (caddr eqn))))
             (isg-pt! 'g a) (isg-pt! 'g b)
             (dk-apply! isg-gcl a b)
             (dk-rewrite-h! (list '= (isg-ds (list 'g a) (list 'g b)) (isg-ds a b)) (list 'g b) (list 'g a))
             (fact 'metric-self-zero 's (list 'g a))
             (isg-real! a b) (isg-real! (list 'g a) (list 'g a))
             (fact 'rr-zero-in)
             (isg-and! (list 'IN (isg-ds a b) 'RR) '(IN 0 RR))
             (dk-have! (list '<= (isg-ds a b) 0)
               (lambda () (dk-ineq! (list '= (isg-ds (list 'g a) (list 'g a)) (isg-ds a b))
                                    (list '= (isg-ds (list 'g a) (list 'g a)) 0)
                                    (list 'IN (isg-ds a b) 'RR) (list 'IN (isg-ds (list 'g a) (list 'g a)) 'RR))))
             (fact 'metric-pos 's a b)
             (isg-and! (list '<= (isg-ds a b) 0) (list '<= 0 (isg-ds a b)))
             (fact 'rr-leq-antisymmetric (isg-ds a b) 0)
             (dk-close-if! (lambda () (fact 'metric-zero-eq 's a b)) ass)))
          ;; onto
          (#t
           (let* ((w (dk-di-var!))
                  (xs (list 'VNB-LAMBDA 'isk_ 'NN (list (list 'INVERSE-BIJ '(fam isk_) '(PTS s) '(PTS s)) w))))
             ;; x_k = fam(k)^-1(w) is a sequence of points
             (dk-have! (list 'IN xs '(FUN NN (PTS s)))
               (lambda ()
                 (for-each
                  (lambda (kn)
                    (if (not (sequent-node-grounded? kn))
                        (begin
                          (dk-focus! kn)
                          (if (and (eq? (isg-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
                              (dk-close-if! (lambda () (fact 'nn-is-set)) ass)
                              (let* ((k (dk-di-var!)) (fk (isg-fk! k))
                                     (inv (list 'INVERSE-BIJ fk '(PTS s) '(PTS s))))
                                (isg-iff-rhs! (dk-cite! 'isometry-group-membership 's fk))
                                (fact 'inverse-bij-in-fun '(PTS s) '(PTS s) fk)
                                (dk-close-if! (lambda () (fact 'fun-apply-type-c inv '(PTS s) '(PTS s) w)) ass))))))
                  (dk-opened (lambda () (lam-t))))))
             (fact 'compact-implies-seq-compact 's)
             (isg-iff-rhs! (dk-cite! 'seq-compact 's))
             (let* ((sc (dk-pick (lambda (h) (and (eq? (isg-head h) 'FORALL) (dk-contains? h 'SUBSEQ)))
                                 "the sequential compactness clause"))
                    (psi (dk-skolem! (dk-apply! sc xs)))
                    (z (dk-skolem! (dk-pick (lambda (h) (and (eq? (isg-head h) 'FORSOME) (dk-contains? h psi)))
                                            "the limit point")))
                    (cv (dk-pick (lambda (h) (and (eq? (isg-head h) 'CONVERGES-TO) (dk-contains? h psi)))
                                 "the convergence"))
                    (gz (isg-pt! 'g z))
                    (dgw (isg-ds gz w)))
               (isg-real! gz w)
               (fact 'metric-pos 's gz w)
               (fact 'rr-zero-in)
               (dk-split-all! (dk-landed (lambda () (mac-h 'converges-to cv))))
               (dk-project! (list 'IN psi '(FUN NN NN)) 'strictly-mono-nn (list 'STRICTLY-MONO-NN psi))
               (let ((ccl (dk-pick (lambda (h) (and (eq? (isg-head h) 'FORALL) (dk-contains? h 'POS-RR)
                                                    (dk-contains? h psi) (dk-contains? h z)))
                                   "the convergence clause")))
                 (isg-le-by-eps! dgw 0
                   (lambda (d)
                     (let* ((h (dk-halve! d))
                            (t1 (isg-thr! z h))
                            (n2 (dk-skolem! (dk-apply! ccl h)))
                            (c2 (dk-pick (lambda (q) (and (eq? (isg-head q) 'FORALL) (dk-contains? q n2)))
                                         "the subsequence threshold clause"))
                            (i (isg-nat-sum! (car t1) n2))
                            (Kp (list psi i))
                            (_1 (fact 'fun-apply-type-c psi 'NN 'NN i))
                            (_2 (fact 'strictly-mono-ge-id psi))
                            (_3 (dk-apply! (dk-pick (lambda (q) (and (eq? (isg-head q) 'FORALL)
                                                                     (dk-contains? q psi)
                                                                     (not (dk-contains? q 'POS-RR))
                                                                     (not (dk-contains? q '<))))
                                                    "the ge-id clause")
                                           i))
                            (_4 (dk-have! (list '<= (car t1) Kp) (lambda () (dk-nn! (list '<= (car t1) i) (list '<= i Kp)))))
                            (FKp (isg-fk! Kp))
                            (xk (list (list 'INVERSE-BIJ FKp '(PTS s) '(PTS s)) w))
                            (sx (list (list 'SUBSEQ xs psi) i)))
                       (dk-apply! (cdr t1) Kp)
                       (dk-apply! c2 i)
                       ;; the subsequence's i-th term is x_K
                       (fact 'subseq-apply xs psi i)
                       (fact 'fun-apply-type-c xs 'NN '(PTS s) Kp)
                       (dk-have! (list '= sx (list xs Kp))
                         (lambda () (subst (list '== sx (list xs Kp))) (rfl)))
                       (dk-rewrite-h! (list '<= (isg-ds sx z) h) sx (list xs Kp))
                       (dk-lam-b-h! (list '<= (isg-ds (list xs Kp) z) h))
                       (isg-iff-rhs! (dk-cite! 'isometry-group-membership 's FKp))
                       (fact 'inverse-bij-in-fun '(PTS s) '(PTS s) FKp)
                       (fact 'fun-apply-type-c (list 'INVERSE-BIJ FKp '(PTS s) '(PTS s)) '(PTS s) '(PTS s) w)
                       (fact 'inverse-bij-right '(PTS s) '(PTS s) FKp w)
                       (let* ((FKz (isg-pt! FKp z)) (FKx (isg-pt! FKp xk)))
                         (isg-iso! FKp z xk)
                         (dk-rewrite-h! (list '= (isg-ds FKz FKx) (isg-ds z xk)) FKx w)
                         (fact 'metric-triangle 's gz FKz w)
                         (fact 'metric-sym 's gz FKz)
                         (fact 'metric-sym 's z xk)
                         (fact 'rr-pos-rr-in-rr h)
                         (fact 'rr-pos-rr-in-rr d)
                         (apply dk-ineq!
                                (append
                                 (list (list '<= dgw (list '+ (isg-ds gz FKz) (isg-ds FKz w)))
                                       (list '= (isg-ds gz FKz) (isg-ds FKz gz))
                                       (list '<= (isg-ds FKz gz) h)
                                       (list '= (isg-ds FKz w) (isg-ds z xk))
                                       (list '= (isg-ds z xk) (isg-ds xk z))
                                       (list '<= (isg-ds xk z) h)
                                       (list '= (list '+ h h) d)
                                       (list 'IN h 'RR) (list 'IN d 'RR) '(IN 0 RR))
                                 (map (lambda (pq) (isg-real! (car pq) (cadr pq)))
                                      (list (list gz w) (list gz FKz) (list FKz gz) (list FKz w)
                                            (list z xk) (list xk z)))))))))
                 (isg-and! (list 'IN dgw 'RR) '(IN 0 RR))
                 (isg-and! (list '<= dgw 0) (list '<= 0 dgw))
                 (fact 'rr-leq-antisymmetric dgw 0)
                 (fact 'metric-zero-eq 's gz w)
                 (ew z)
                 (dk-conj-close! (lambda () (ass)))))))))))))
(mac 'isometry-group-membership)
(dk-conj-close! (lambda () (ass)))
(qed 'ptwise-limit-in-isometry-group)
(topic! 'ptwise-limit-in-isometry-group 'analysis)
(alias! 'ptwise-limit-in-isometry-group
        "on a compact space a pointwise limit of isometries onto the space is an isometry onto it")

;;; =====================================================================
;;; ptwise-conv-iff-converges-to: CONVERGES-PTWISE-TO is convergence of every
;;; sequence of values fam(k)(x), as CONVERGES-TO states it
;;; =====================================================================
(sp (make-wff '(FORALL s (FORALL t (FORALL fam (FORALL g
     (IMPLIES (IS-METRIC-SPACE s)
       (IMPLIES (IS-METRIC-SPACE t)
         (IMPLIES (IN fam (FUN NN (FUN (PTS s) (PTS t))))
           (IMPLIES (IN g (FUN (PTS s) (PTS t)))
             (IFF (CONVERGES-PTWISE-TO s t fam g)
                  (FORALL x (IMPLIES (IN x (PTS s))
                    (CONVERGES-TO t (VNB-LAMBDA k NN ((fam k) x)) (g x)))))))))))))))
(dk-peel!)
(fact 'nn-is-set)
(define (isg-cv-forward!)
  (dk-split-all! (dk-landed (lambda () (mac-h 'converges-ptwise-to '(CONVERGES-PTWISE-TO s t fam g)))))
  (let* ((P (dk-pick (lambda (h) (and (eq? (isg-head h) 'FORALL) (dk-contains? h 'POS-RR))) "the pointwise clause"))
         (x (dk-di-var!)))
    (mac 'converges-to)
    (dk-conj-close!
     (lambda ()
       (let ((gl (dk-goal)))
         (cond
          ((and (eq? (isg-head gl) 'IN) (dk-contains? gl 'VNB-LAMBDA))
           (for-each
            (lambda (kn)
              (if (not (sequent-node-grounded? kn))
                  (begin
                    (dk-focus! kn)
                    (if (and (eq? (isg-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
                        (ass)
                        (let ((k (dk-di-var!)))
                          (fact 'fun-apply-type-c 'fam 'NN '(FUN (PTS s) (PTS t)) k)
                          (dk-close-if! (lambda () (fact 'fun-apply-type-c (list 'fam k) '(PTS s) '(PTS t) x)) ass))))))
            (dk-opened (lambda () (lam-t)))))
          ((and (eq? (isg-head gl) 'IN) (equal? (caddr gl) '(PTS t)))
           (dk-close-if! (lambda () (fact 'fun-apply-type-c 'g '(PTS s) '(PTS t) x)) ass))
          ((eq? (isg-head gl) 'FORALL)
           (let* ((pe (dk-peel!))
                  (e (cadr (car (filter (lambda (f) (eq? (isg-head f) 'POS-RR)) pe))))
                  (n (dk-skolem! (dk-apply! P x e)))
                  (ncl (dk-pick (lambda (h) (and (eq? (isg-head h) 'FORALL) (dk-contains? h n))) "the threshold clause")))
             (ew n)
             (dk-conj-close!
              (lambda ()
                (if (not (eq? (isg-head (dk-goal)) 'FORALL))
                    (ass)
                    (let* ((pk (dk-peel!))
                           (k (cadr (car (filter (lambda (f) (and (eq? (isg-head f) 'IN) (eq? (caddr f) 'NN))) pk)))))
                      (dk-lam-b!)
                      (dk-close-if! (lambda () (inst*! ncl k)) ass)))))))
          (#t (ass))))))))
(define (isg-cv-backward!)
  (let ((A (dk-pick (lambda (h) (and (eq? (isg-head h) 'FORALL) (dk-contains? h 'CONVERGES-TO))) "the convergences")))
    (mac 'converges-ptwise-to)
    (dk-conj-close!
     (lambda ()
       (if (not (eq? (isg-head (dk-goal)) 'FORALL))
           (ass)
           (let* ((pl (dk-peel!))
                  (x (cadr (car (filter (lambda (f) (eq? (isg-head f) 'IN)) pl))))
                  (e (cadr (car (filter (lambda (f) (eq? (isg-head f) 'POS-RR)) pl))))
                  (cv (dk-apply! A x)))
             (dk-split-all! (dk-landed (lambda () (mac-h 'converges-to cv))))
             (let* ((ccl (dk-pick (lambda (h) (and (eq? (isg-head h) 'FORALL) (dk-contains? h 'POS-RR)
                                                   (dk-contains? h (list 'g x))))
                                  "the convergence clause"))
                    (n (dk-skolem! (dk-apply! ccl e)))
                    (ncl (dk-pick (lambda (h) (and (eq? (isg-head h) 'FORALL) (dk-contains? h n))) "the threshold clause")))
               (ew n)
               (dk-conj-close!
                (lambda ()
                  (if (not (eq? (isg-head (dk-goal)) 'FORALL))
                      (ass)
                      (let* ((pk (dk-peel!))
                             (k (cadr (car (filter (lambda (f) (and (eq? (isg-head f) 'IN) (eq? (caddr f) 'NN))) pk)))))
                        (dk-lam-b-h! (dk-apply! ncl k))
                        (ass))))))))))))
(dk-iff! (dk-head? 'FORALL) isg-cv-forward! isg-cv-backward!)
(qed 'ptwise-conv-iff-converges-to)
(topic! 'ptwise-conv-iff-converges-to 'analysis)

;;; =====================================================================
;;; the sup distance in Gamma, read through the metric of Gamma
;;; =====================================================================
(define isg-M '(ISOMETRY-GROUP-MS s))
(define (isg-D a b) (list '(DIST (ISOMETRY-GROUP-MS s)) a b))
(define (isg-S a b) (list 'SUP-DIST 's 's a b))
;;; a, b in Gamma, M a metric space and the read-offs in context: D(a,b), S(a,b) real, equal
(define (isg-DS! a b)
  (let ((D (isg-D a b)) (S (isg-S a b)))
    (if (not (dk-asm? (list 'IN a (list 'PTS isg-M))))
        (dk-have! (list 'IN a (list 'PTS isg-M)) (lambda () (subst (list '== (list 'PTS isg-M) isg-G)) (ass))))
    (if (not (dk-asm? (list 'IN b (list 'PTS isg-M))))
        (dk-have! (list 'IN b (list 'PTS isg-M)) (lambda () (subst (list '== (list 'PTS isg-M) isg-G)) (ass))))
    (if (not (dk-asm? (list 'IN D 'RR))) (fact 'metric-dist-real isg-M a b))
    (let ((ro (list '== D S)))
      (if (not (dk-asm? ro)) (fact 'isometry-group-ms-dist 's a b))
      (dk-have! (list 'IN S 'RR) (lambda () (subst (list '== S D)) (ass)))
      (dk-have! (list '= D S) (lambda () (subst (list '== S D)) (rfl))))))

(define (isg-gamma-setup!)          ; IS-COMPACT s in context
  (dk-project! '(IS-METRIC-SPACE s) 'is-compact '(IS-COMPACT s))
  (fact 'isometry-group-ms-is-metric-space 's)
  (fact 'isometry-group-ms-pts 's)
  (fact 'isometry-group-is-set 's)
  (fact 'isometry-group-subset-fun 's))

;;; uniform convergence in Gamma is convergence in d_Gamma
(sp (make-wff '(FORALL s (FORALL fam (FORALL g
     (IMPLIES (IS-COMPACT s)
       (IMPLIES (IN fam (FUN NN (ISOMETRY-GROUP s)))
         (IMPLIES (IN g (ISOMETRY-GROUP s))
           (IFF (CONVERGES-TO (ISOMETRY-GROUP-MS s) fam g)
                (CONVERGES-UNIFORMLY-TO s s fam g))))))))))
(dk-peel!)
(isg-gamma-setup!)
(fact 'isometry-group-in-fun 's 'g)
(dk-close-if! (lambda () (fact 'fun-codomain-superset 'fam 'NN isg-G isg-F)) (lambda () #t))
(dk-iff! (dk-head? 'CONVERGES-UNIFORMLY-TO)
  ;; d_Gamma -> uniform
  (lambda ()
    (dk-split-all! (dk-landed (lambda () (mac-h 'converges-to (list 'CONVERGES-TO isg-M 'fam 'g)))))
    (let ((mcl (dk-pick (lambda (h) (and (eq? (isg-head h) 'FORALL) (dk-contains? h 'POS-RR))) "the d_Gamma clause")))
      (mac 'converges-uniformly-to)
      (dk-conj-close!
       (lambda ()
         (if (not (eq? (isg-head (dk-goal)) 'FORALL))
             (ass)
             (let* ((pe (dk-peel!))
                    (e (cadr (car (filter (lambda (f) (eq? (isg-head f) 'POS-RR)) pe))))
                    (n (dk-skolem! (dk-apply! mcl e)))
                    (ncl (dk-pick (lambda (h) (and (eq? (isg-head h) 'FORALL) (dk-contains? h n))) "the threshold clause")))
               (ew n)
               (dk-conj-close!
                (lambda ()
                  (if (not (eq? (isg-head (dk-goal)) 'FORALL))
                      (ass)
                      (let* ((pk (dk-peel!))
                             (k (cadr (car (filter (lambda (f) (and (eq? (isg-head f) 'IN) (eq? (caddr f) 'NN))) pk))))
                             (x (cadr (car (filter (lambda (f) (and (eq? (isg-head f) 'IN) (equal? (caddr f) '(PTS s)))) pk))))
                             (fk (isg-fk! k)))
                        (dk-apply! ncl k)
                        (isg-DS! fk 'g)
                        (fact 'rr-pos-rr-in-rr e)
                        (isg-pt! fk x) (isg-pt! 'g x)
                        (isg-real! (list fk x) (list 'g x))
                        (dk-apply! (dk-cite! 'sup-dist-upper 's 's fk 'g) x)
                        (dk-ineq! (list '<= (isg-ds (list fk x) (list 'g x)) (isg-S fk 'g))
                                  (list '= (isg-D fk 'g) (isg-S fk 'g))
                                  (list '<= (isg-D fk 'g) e)
                                  (isg-real! (list fk x) (list 'g x))
                                  (list 'IN (isg-S fk 'g) 'RR) (list 'IN (isg-D fk 'g) 'RR)
                                  (list 'IN e 'RR))))))))))))
  ;; uniform -> d_Gamma
  (lambda ()
    (dk-split-all! (dk-landed (lambda () (mac-h 'converges-uniformly-to '(CONVERGES-UNIFORMLY-TO s s fam g)))))
    (let ((ucl (dk-pick (lambda (h) (and (eq? (isg-head h) 'FORALL) (dk-contains? h 'POS-RR))) "the uniform clause")))
      (mac 'converges-to)
      (dk-conj-close!
       (lambda ()
         (let ((gl (dk-goal)))
           (cond
            ((and (eq? (isg-head gl) 'IN) (dk-contains? gl 'ISOMETRY-GROUP-MS))
             (subst (list '== (list 'PTS isg-M) isg-G))
             (ass))
            ((eq? (isg-head gl) 'FORALL)
             (let* ((pe (dk-peel!))
                    (e (cadr (car (filter (lambda (f) (eq? (isg-head f) 'POS-RR)) pe))))
                    (n (dk-skolem! (dk-apply! ucl e)))
                    (ncl (dk-pick (lambda (h) (and (eq? (isg-head h) 'FORALL) (dk-contains? h n))) "the threshold clause")))
               (ew n)
               (dk-conj-close!
                (lambda ()
                  (if (not (eq? (isg-head (dk-goal)) 'FORALL))
                      (ass)
                      (let* ((pk (dk-peel!))
                             (k (cadr (car (filter (lambda (f) (and (eq? (isg-head f) 'IN) (eq? (caddr f) 'NN))) pk))))
                             (fk (isg-fk! k)))
                        (dk-apply! ncl k)
                        (isg-DS! fk 'g)
                        (fact 'rr-pos-rr-in-rr e)
                        (fact 'rr-lt-of-pos-rr e)
                        (dk-have! (list '<= 0 e) (lambda () (dk-ineq! (list '< 0 e) (list 'IN e 'RR))))
                        (dk-split-all! (list (dk-cite! 'sup-dist-bound 's 's fk 'g e)))
                        (dk-ineq! (list '= (isg-D fk 'g) (isg-S fk 'g))
                                  (list '<= (isg-S fk 'g) e)
                                  (list 'IN (isg-S fk 'g) 'RR) (list 'IN (isg-D fk 'g) 'RR)
                                  (list 'IN e 'RR))))))))
            (#t (ass)))))))))
(qed 'isometry-group-conv-iff-uniform)
(topic! 'isometry-group-conv-iff-uniform 'analysis)
(alias! 'isometry-group-conv-iff-uniform
        "convergence in the isometry group with the sup metric is uniform convergence")

;;; =====================================================================
;;; Prop 3.38: in Gamma, g_i -> g (in d_Gamma, i.e. uniformly) iff g_i(x) -> g(x)
;;; for every x
;;; =====================================================================
(sp (make-wff '(FORALL s (FORALL gs (FORALL g
     (IMPLIES (IS-COMPACT s)
       (IMPLIES (IN gs (FUN NN (ISOMETRY-GROUP s)))
         (IMPLIES (IN g (ISOMETRY-GROUP s))
           (IFF (CONVERGES-TO (ISOMETRY-GROUP-MS s) gs g)
                (FORALL x (IMPLIES (IN x (PTS s))
                  (CONVERGES-TO s (VNB-LAMBDA k NN ((gs k) x)) (g x)))))))))))))
(dk-peel!)
(isg-gamma-setup!)
(fact 'isometry-group-in-fun 's 'g)
(dk-close-if! (lambda () (fact 'fun-codomain-superset 'gs 'NN isg-G isg-F)) (lambda () #t))
(fact 'isometry-family-equicontinuous 's 'gs)
(fact 'isometry-group-conv-iff-uniform 's 'gs 'g)
(fact 'equicont-compact-ptwise-iff-uniform 's 's 'gs 'g)
(fact 'ptwise-conv-iff-converges-to 's 's 'gs 'g)
(define isg-i1 (dk-pick (lambda (h) (and (eq? (isg-head h) 'IFF) (dk-contains? h 'ISOMETRY-GROUP-MS))) "iff 1"))
(define isg-i2 (dk-pick (lambda (h) (and (eq? (isg-head h) 'IFF) (eq? (isg-head (cadr h)) 'CONVERGES-PTWISE-TO)
                                         (eq? (isg-head (caddr h)) 'CONVERGES-UNIFORMLY-TO))) "iff 2"))
(define isg-i3 (dk-pick (lambda (h) (and (eq? (isg-head h) 'IFF) (eq? (isg-head (cadr h)) 'CONVERGES-PTWISE-TO)
                                         (eq? (isg-head (caddr h)) 'FORALL))) "iff 3"))
(dk-only! isg-i1 isg-i2 isg-i3)
(prop)
(qed 'isometry-group-uniform-iff-ptwise)
(topic! 'isometry-group-uniform-iff-ptwise 'analysis)
(alias! 'isometry-group-uniform-iff-ptwise
        "in the isometry group of a compact space uniform and pointwise convergence agree")

;;; =====================================================================
;;; a sequence in Gamma has a subsequence converging pointwise
;;; =====================================================================
(sp (make-wff '(FORALL s (FORALL f
     (IMPLIES (IS-COMPACT s)
       (IMPLIES (IN f (FUN NN (ISOMETRY-GROUP s)))
         (FORSOME delta (AND (STRICTLY-MONO-NN delta)
           (FORSOME g (CONVERGES-PTWISE-TO s s (SUBSEQ f delta) g))))))))))
(dk-peel!)
(isg-gamma-setup!)
(dk-close-if! (lambda () (fact 'fun-codomain-superset 'f 'NN isg-G isg-F)) (lambda () #t))
(use-em '(FORSOME isz_ (IN isz_ (PTS s)))
 (lambda ()
   (let* ((dq (dk-skolem! (dk-cite! 'rmm-dense-seq-exists 's)))
          (_1 (dk-project! (list 'IN dq '(FUN NN (PTS s))) 'is-dense-seq (list 'IS-DENSE-SEQ 's dq)))
          (delta (dk-skolem! (dk-cite! 'compact-diagonal-on-seq 's '(PTS s) 'f dq)))
          (F (list 'SUBSEQ 'f delta)))
     (isg-subseq-type! 'f delta isg-G)
     (isg-subseq-type! 'f delta isg-F)
     (fact 'isometry-family-equicontinuous 's F)
     (fact 'compact-implies-complete 's)
     (fact 'equicont-dense-ptwise-limit 's 's F dq)
     (fact 'ptwise-limit-function 's 's F)
     (ew delta)
     (dk-conj-close! (lambda () (ass)))))
 (lambda ()
   (let ((delta '(VNB-LAMBDA isi_ NN isi_)))
     (fact 'nn-is-set)
     (fact 'nn-zero-in)
     (dk-have! (list 'STRICTLY-MONO-NN delta)
       (lambda ()
         (mac 'strictly-mono-nn)
         (dk-conj-close!
          (lambda ()
            (if (eq? (isg-head (dk-goal)) 'FORALL)
                (begin (dk-peel!) (dk-lam-b!) (ass))
                (for-each (lambda (kn)
                            (if (not (sequent-node-grounded? kn))
                                (begin (dk-focus! kn)
                                       (if (eq? (caddr (dk-goal)) 'SET) (ass) (begin (dk-di-var!) (ass))))))
                          (dk-opened (lambda () (lam-t)))))))))
     (isg-subseq-type! 'f delta isg-F)
     (fact 'fun-apply-type-c 'f 'NN isg-F 0)
     (ew delta)
     (dk-conj-close!
      (lambda ()
        (if (not (eq? (isg-head (dk-goal)) 'FORSOME))
            (ass)
            (begin
              (ew '(f 0))
              (mac 'converges-ptwise-to)
              (dk-conj-close!
               (lambda ()
                 (if (not (eq? (isg-head (dk-goal)) 'FORALL))
                     (ass)
                     (let* ((pl (dk-peel!))
                            (x (cadr (car (filter (lambda (q) (eq? (isg-head q) 'IN)) pl)))))
                       (dk-have! '(FORSOME isz_ (IN isz_ (PTS s))) (lambda () (ew x) (ass)))
                       (dk-only! '(FORSOME isz_ (IN isz_ (PTS s))) '(NOT (FORSOME isz_ (IN isz_ (PTS s)))))
                       (prop))))))))))))
(qed 'isometry-subseq-ptwise)
(topic! 'isometry-subseq-ptwise 'analysis)

;;; =====================================================================
;;; Prop 3.37: Gamma with d_Gamma is a compact metric space
;;; =====================================================================
(sp (make-wff '(FORALL s (IMPLIES (IS-COMPACT s) (IS-COMPACT (ISOMETRY-GROUP-MS s))))))
(dk-peel!)
(isg-gamma-setup!)
(dk-have! (list 'SEQ-COMPACT isg-M)
  (lambda ()
    (mac 'seq-compact)
    (dk-conj-close!
     (lambda ()
       (if (not (eq? (isg-head (dk-goal)) 'FORALL))
           (ass)
           (let ((fv (dk-di-var!)))
             (dk-have! (list 'IN fv (list 'FUN 'NN isg-G))
               (lambda () (subst (list '== isg-G (list 'PTS isg-M))) (ass)))
             (subst (list '== (list 'PTS isg-M) isg-G))
             (let* ((delta (dk-skolem! (dk-cite! 'isometry-subseq-ptwise 's fv)))
                    (g (dk-skolem! (dk-pick (lambda (h) (and (eq? (isg-head h) 'FORSOME) (dk-contains? h delta)))
                                            "the pointwise limit")))
                    (F (list 'SUBSEQ fv delta)))
               (isg-subseq-type! fv delta isg-G)
               (fact 'ptwise-limit-in-isometry-group 's F g)
               (fact 'isometry-family-equicontinuous 's F)
               (fact 'equicont-ptwise-implies-uniform 's 's F g)
               (fact 'isometry-group-conv-iff-uniform 's F g)
               (dk-have! (list 'CONVERGES-TO isg-M F g) (lambda () (prop)))
               (ew delta)
               (dk-conj-close!
                (lambda ()
                  (if (eq? (isg-head (dk-goal)) 'FORSOME)
                      (begin (ew g) (dk-conj-close! (lambda () (ass))))
                      (ass)))))))))))
(dk-close-if! (lambda () (fact 'seq-compact-implies-compact isg-M)) ass)
(qed 'isometry-group-compact)
(topic! 'isometry-group-compact 'analysis)
(alias! 'isometry-group-compact
        "the isometry group of a compact metric space, with the sup metric, is a compact metric space")
