                                    (subst `(= ,u ,(cw-mul tt 'uw)))
                                    (subst `(= ,m (succ ,j)))
                                    (subst `(= ,(cw-pw 'uw `(succ ,j)) ((MUL ,cw-view) ,pj uw)))
                                    (subst `(= (MUL ,cw-view) (MUL K)))
