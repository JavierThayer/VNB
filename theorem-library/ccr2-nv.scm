                 (pnm (cw-add pn (cw-neg pm))))
            (dk-cite! 'nv-pow-in-domain 'K 'A 'x d)
            (dk-cite! 'nv-pow-in-domain 'K 'A 'x nx)
            (dk-cite! 'nv-pow-in-domain 'K 'A 'x mx)
            (cw-type! w)
            (cw-type! pn)
            (cw-type! pm)
            (dk-cite! 'nv-pow-norm 'K 'x nx)
            (cw-view!)
            (cw-in-view! 'x)
            (dk-cite! 'ring-power-add cw-view 'x `(succ ,nx) d)
            (dk-cite! 'ring-power-succ cw-view 'x nx)
            (dk-cite! 'nf-mul-in-carr 'K 'x w)
            (dk-cite! 'nf-neg-in-carr 'K (cw-mul 'x w))
            (dk-cite! 'nf-add-in-carr 'K '(ONE K) (cw-neg (cw-mul 'x w)))
            (dk-cite! 'nf-neg-in-carr 'K w)
