                (subst `(= ,mx (+ (succ ,nx) ,d)))
                (subst `(= ,(cw-pw 'x `(+ (succ ,nx) ,d)) ((MUL ,cw-view) ,(cw-pw 'x `(succ ,nx)) ,w)))
                (subst `(= ,(cw-pw 'x `(succ ,nx)) ((MUL ,cw-view) ,pn x)))
