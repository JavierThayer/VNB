          (dk-have! `(IN ,y (NV-INTEGERS K)) (lambda () (mac 'nv-integers) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
          (dk-have! `(IN ,y A) (lambda () (subst '(= A (NV-INTEGERS K))) (dk-ass!)))
          (let* ((ke (dk-skolem! (dk-cite! 'nv-uniformizer-factorization 'K 'A 'uw y)))
                 (u (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f ke))) "the unit")))
