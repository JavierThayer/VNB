            (subst `(= j (+ e ,d)))
            (subst `(= ,(cw-pw 'uw `(+ e ,d)) ((MUL ,cw-view) ,pe ,pd)))
            (subst `(= (MUL ,cw-view) (MUL K)))
            (cw-crs! (list m pe pd))))
        (dk-cite! 'nf-mul-cancel 'K 'u (cw-mul m pd) pe)
        (dk-cite! 'nf-norm-mult 'K m pd)
        (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'cwd))) "the smallness law") d)
        (dk-cite! 'rr-prod-lt-one-right (cw-n m) (cw-n pd))
        (dk-have! `(< ,(cw-n 'u) 1)
          (lambda () (subst `(= u ,(cw-mul m pd))) (subst `(= ,(cw-n (cw-mul m pd)) (* ,(cw-n m) ,(cw-n pd)))) (dk-ass!)))
        (dk-absurd! `(< ,(cw-n 'u) 1) `(= ,(cw-n 'u) 1))))
    ;; j <= e: x = uw^j (uw^d u)
    (lambda ()
      (let* ((d (dk-skolem! (dk-cite! 'nn-le-gap 'e 'j)))
             (pd (cw-47-pow! d)))
        (dk-cite! 'ring-power-add cw-view 'uw 'j d)
        (dk-cite! 'nv-domain-mul 'K 'A pd 'u)
        (mac 'nv-principal)
        (in-sep! (lambda () (dk-ass!))
          (lambda ()
            (ew (cw-mul pd 'u))
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (begin
                      (subst `(= e (+ j ,d)))
                      (subst `(= ,(cw-pw 'uw `(+ j ,d)) ((MUL ,cw-view) ,pj ,pd)))
                      (subst `(= (MUL ,cw-view) (MUL K)))
                      (cw-crs! (list pj pd 'u))))))))))))
(qed 'nv-order-nonneg)

;; (b) x uw^e = u
(sp (make-wff `(FORALL K (FORALL A (FORALL uw ,(cw-curry cw-47-hyps
  `(FORALL x (IMPLIES (IN x (CARR K)) (FORALL e (IMPLIES (IN e NN) (FORALL u (IMPLIES (IN u (NV-UNITS K A))
    (IMPLIES (= ((MUL K) x ,(cw-pw 'uw 'e)) u)
      (FORALL kk (IMPLIES (IN kk NN) (IFF (IN ((MUL K) ,(cw-pw 'uw 'kk) x) A) (<= e kk)))))))))))))))))
(dk-peel!)
(cw-47-setup!)
(dk-cite! 'nv-uniformizer-power-small 'K 'A 'uw)
(cw-typek! 'x)
(cw-unit! 'u)
(let* ((pe (cw-47-pow! 'e)) (pk (cw-47-pow! 'kk)) (y (cw-mul pk 'x)))
  (dk-cite! 'nf-mul-in-carr 'K pk 'x)
  (dk-iff! (lambda (gl) (dk-head-is? gl '<=))
    ;; uw^k x in A forces e <= k
    (lambda ()
      (pbc)
      (cw-type! y)
      (let* ((d (cw3-gap! 'e 'kk)) (pd (cw-47-pow! d)))
        (dk-cite! 'ring-power-add cw-view 'uw 'kk d)
        (dk-have! `(= u ,(cw-mul y pd))
          (lambda ()
            (subst `(= u ,(cw-mul 'x pe)))
            (subst `(= e (+ kk ,d)))
            (subst `(= ,(cw-pw 'uw `(+ kk ,d)) ((MUL ,cw-view) ,pk ,pd)))
            (subst `(= (MUL ,cw-view) (MUL K)))
            (cw-crs! (list 'x pk pd))))
        (dk-cite! 'nf-norm-mult 'K y pd)
        (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'cwd))) "the smallness law") d)
        (dk-cite! 'rr-prod-lt-one-right (cw-n y) (cw-n pd))
        (dk-have! `(< ,(cw-n 'u) 1)
          (lambda () (subst `(= u ,(cw-mul y pd))) (subst `(= ,(cw-n (cw-mul y pd)) (* ,(cw-n y) ,(cw-n pd)))) (dk-ass!)))
        (dk-absurd! `(< ,(cw-n 'u) 1) `(= ,(cw-n 'u) 1))))
    ;; e <= k: uw^k x = uw^d u
    (lambda ()
      (let* ((d (dk-skolem! (dk-cite! 'nn-le-gap 'kk 'e))) (pd (cw-47-pow! d)))
        (dk-cite! 'ring-power-add cw-view 'uw 'e d)
        (dk-cite! 'nv-domain-mul 'K 'A pd 'u)
        (dk-have! `(= ,y ,(cw-mul pd 'u))
          (lambda ()
            (subst `(= kk (+ e ,d)))
            (subst `(= ,(cw-pw 'uw `(+ e ,d)) ((MUL ,cw-view) ,pe ,pd)))
            (subst `(= (MUL ,cw-view) (MUL K)))
            (subst `(= u ,(cw-mul 'x pe)))
            (cw-crs! (list pe pd 'x))))
        (subst `(= ,y ,(cw-mul pd 'u)))
        (dk-ass!)))))
(qed 'nv-order-negative)
