    (lambda () (di)
      (dk-have! `(= ,(cw-n 'x) 0) (lambda () (subst '(= x (ZERO K))) (dk-ass!)))
      (dk-absurd! `(= ,(cw-n 'x) 0) `(= ,(cw-n 'x) 1))))
