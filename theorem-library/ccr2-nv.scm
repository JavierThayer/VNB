;;; 8. Proposition 2.4: in a compact NV domain the units are the elements of absolute value one.
;;; |x| = 1 and z = 1/x not in A: A is closed, so a ball B(z, r) misses A; x^n, x^m (n < m) with
;;; |x^n - x^m| <= r/2 give w = x^(m-n-1) in A with |z - w| = |1 - x w| = |x^n - x^m| < r.

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-COMPACT-NV-DOMAIN K A) (FORALL x (IMPLIES (IN x A) (IMPLIES (= ((FNRM K) x) 1)
  (IN x (NV-UNITS K A))))))))))
(dk-peel!)
(let ((sm '(NF-METRIC-SPACE K)))
  (dk-cite! 'nv-compact-domain 'K 'A)
  (dk-cite! 'nv-domain-normed 'K 'A)
  (dk-cite! 'nf-zero-in-carr 'K)
  (dk-cite! 'nf-one-in-carr 'K)
  (fact 'rr-one-in)
  (cw-type! 'x)
  (dk-cite! 'nf-norm-of-zero 'K)
