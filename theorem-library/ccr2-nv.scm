  (dk-have! '(IN uw (NV-MAXIMAL K A)) (lambda () (subst '(= (NV-MAXIMAL K A) (NV-PRINCIPAL K A uw))) (dk-ass!)))
  (dk-cite! 'nv-maximal-norm 'K 'A 'uw)
