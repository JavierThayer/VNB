                (dk-have! `(IN ,u (NV-PRINCIPAL K A uw)) (lambda () (subst '(= (NV-PRINCIPAL K A uw) (NV-MAXIMAL K A))) (dk-ass!)))
                (let ((tt (cw-principal-witness! u 'uw)))
