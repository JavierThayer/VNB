                          (ew u)
                          (dk-conj-close!
                            (lambda ()
                              (if (not (dk-ass!))
                                  (begin (subst `(= el ,(cw-mul u pj))) (cw-crs! (list u pj)))))))))))
              (lambda ()
                ;; |u| < 1 puts u in M = (uw), and then el is in (uw^(j+1)) = (uw^m)
                (pbc)
