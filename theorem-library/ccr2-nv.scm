            (subst `(= ,m 0))
            (dk-cite! 'ring-power-zero cw-view 'uw)
            (subst `(= ,(cw-pw 'uw 0) (ONE ,cw-view)))
            (subst `(= (ONE ,cw-view) (ONE K)))
            (mac 'nv-principal)
            (in-sep! (lambda () (dk-ass!))
              (lambda () (ew 'el) (dk-conj-close! (lambda () (if (not (dk-ass!)) (cw-crs! '(el)))))))))
        (ai `(NOT (IN el (NV-PRINCIPAL K A ,(cw-pw 'uw m)))))))
    (let* ((j (dk-skolem! (dk-cite! 'nn-nonzero-is-succ m)))
           (pj (cw-47-pow! j))
           (pin `(IN el (NV-PRINCIPAL K A ,pj))))
      (dk-cite! 'nn-succ-closed j)
      (use-em pin
        (lambda ()
          (let ((u (cw-principal-witness! 'el pj)))
            (cw-type! u)
            (use-em `(= ,(cw-n u) 1)
              (lambda ()
                (dk-cite! 'nv-compact-norm-one-unit 'K 'A u)
                (ew j)
                (dk-conj-close!
                  (lambda ()
                    (if (not (dk-ass!))
