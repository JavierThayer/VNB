;; with X in the ideal I (nonzero), A compact with uniformizer uw: land u in U, v in A, u v = 1,
;; X = uw^k u and uw^k in I; return (k u v)
(define (cw-exponent-in-ideal! x iv)
  (dk-cite! 'nv-ideal-sub 'K 'A iv x)
  (cw-type! x)
  (let* ((k (dk-skolem! (dk-cite! 'nv-uniformizer-factorization 'K 'A 'uw x)))
         (u (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f k))) "the unit")))
         (p (cw-47-pow! k)))
    (cw-unit! u)
    (let ((v (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f u))) "the inverse"))))
      (cw-type! v)
      (dk-cite! 'nv-ideal-mul 'K 'A iv v x)
      (dk-have! `(= ,(cw-mul v x) ,p)
        (lambda ()
          (subst `(= ,x ,(cw-mul p u)))
          (dk-have! `(= ,(cw-mul v (cw-mul p u)) ,(cw-mul p (cw-mul u v))) (lambda () (cw-crs! (list v p u))))
          (subst `(= ,(cw-mul v (cw-mul p u)) ,(cw-mul p (cw-mul u v))))
          (subst `(= ,(cw-mul u v) (ONE K)))
          (cw-crs! (list p))))
      (dk-have! `(IN ,p ,iv) (lambda () (subst `(= ,p ,(cw-mul v x))) (dk-ass!)))
      (list k u v))))

(sp (make-wff `(FORALL K (FORALL A (FORALL uw ,(cw-curry cw-47-hyps '(IS-NV-PID K A)))))))
(dk-peel!)
(cw-47-setup!)
(mac 'is-nv-pid)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (begin
          (dk-peel!)
          (let* ((ih (find-first (lambda (f) (dk-head-is? f 'IS-NV-IDEAL)) (dk-asms)))
                 (iv (cadddr ih))
                 (nz `(FORSOME cwz_ (AND (IN cwz_ ,iv) (NOT (= cwz_ (ZERO K)))))))
            (dk-cite! 'nv-ideal-zero 'K 'A iv)
            (use-em nz
              ;; a nonzero element: generator uw^m, m least with uw^m in I
              (lambda ()
                (let* ((x0 (dk-skolem! nz))
                       (kuv0 (cw-exponent-in-ideal! x0 iv))
                       (k0 (car kuv0))
                       (tset `(SEP cwt_ NN (IN ,(cw-pw 'uw 'cwt_) ,iv))))
                  (dk-have! `(IN ,k0 ,tset) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
                  (dk-have! `(SUBSET ,tset NN)
                    (lambda () (mac 'subset-def) (di) (let ((z (cadr (dk-goal)))) (sep-me `(IN ,z ,tset)) (dk-ass!))))
                  (dk-have! `(FORSOME cwn (IN cwn ,tset)) (lambda () (ew k0) (dk-ass!)))
                  (cw-and! `(SUBSET ,tset NN) `(FORSOME cwn (IN cwn ,tset)))
                  (let* ((m (dk-skolem! (dk-cite! 'nn-least-element tset)))
                         (least (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f tset) (dk-contains? f '<=))) "the least law"))
                         (pm (cw-pw 'uw m)))
                    (dk-have! `(IN ,m NN) (lambda () (sep-me `(IN ,m ,tset)) (dk-ass!)))
                    (dk-have! `(IN ,pm ,iv) (lambda () (sep-me `(IN ,m ,tset)) (dk-ass!)))
                    (cw-47-pow! m)
                    (ew pm)
                    (dk-conj-close!
                      (lambda ()
                        (if (not (dk-ass!))
                            (let ((pp `(NV-PRINCIPAL K A ,pm)))
                              (dk-have! `(FORALL cwq_ (IFF (IN cwq_ ,iv) (IN cwq_ ,pp)))
                                (lambda ()
                                  (di)
                                  (let ((x (cadr (cadr (dk-goal)))))
                                    (dk-iff! (lambda (g) (dk-contains? g 'NV-PRINCIPAL))
                                      (lambda ()
                                        (dk-cite! 'nv-ideal-sub 'K 'A iv x)
                                        (cw-type! x)
                                        (mac 'nv-principal)
                                        (in-sep! (lambda () (dk-ass!))
                                          (lambda ()
                                            (use-em `(= ,x (ZERO K))
                                              (lambda () (ew '(ZERO K))
                                                (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst `(= ,x (ZERO K))) (cw-crs! (list pm)))))))
                                              (lambda ()
                                                (let* ((kuv (cw-exponent-in-ideal! x iv)) (k (car kuv)) (u (cadr kuv)))
                                                  (dk-have! `(IN ,k ,tset) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
                                                  (dk-apply! least k)
                                                  (let* ((d (dk-skolem! (dk-cite! 'nn-le-gap k m)))
                                                         (pd (cw-47-pow! d)))
                                                    (dk-cite! 'nv-domain-mul 'K 'A pd u)
                                                    (dk-cite! 'ring-power-add cw-view 'uw m d)
                                                    (ew (cw-mul pd u))
                                                    (dk-conj-close!
                                                      (lambda ()
                                                        (if (not (dk-ass!))
                                                            (begin
                                                              (subst `(= ,x ,(cw-mul (cw-pw 'uw k) u)))
                                                              (subst `(= ,k (+ ,m ,d)))
                                                              (subst `(= ,(cw-pw 'uw `(+ ,m ,d)) ((MUL ,cw-view) ,pm ,pd)))
                                                              (subst `(= (MUL ,cw-view) (MUL K)))
                                                              (cw-crs! (list pm pd u)))))))))))))
                                      (lambda ()
                                        (let ((r (cw-principal-witness! x pm)))
                                          (dk-cite! 'nv-ideal-mul 'K 'A iv r pm)
                                          (subst `(= ,x ,(cw-mul r pm)))
                                          (dk-ass!)))))))
                              (fact 'class-extensionality iv pp)
                              (dk-ass!))))))))
              ;; every element is zero: I = (0)
              (lambda ()
                (let ((pp '(NV-PRINCIPAL K A (ZERO K))))
                  (ew '(ZERO K))
                  (dk-conj-close!
                    (lambda ()
                      (if (not (dk-ass!))
                          (begin
                            (dk-have! `(FORALL cwq_ (IFF (IN cwq_ ,iv) (IN cwq_ ,pp)))
                              (lambda ()
                                (di)
                                (let ((x (cadr (cadr (dk-goal)))))
                                  (dk-iff! (lambda (g) (dk-contains? g 'NV-PRINCIPAL))
                                    (lambda ()
                                      (dk-cite! 'nv-ideal-sub 'K 'A iv x)
                                      (cw-type! x)
                                      (dk-have! `(= ,x (ZERO K))
                                        (lambda ()
                                          (pbc)
                                          (dk-have! nz (lambda () (ew x) (dk-conj-close! (lambda () (dk-ass!)))))
                                          (ai `(NOT ,nz))))
                                      (mac 'nv-principal)
                                      (in-sep! (lambda () (dk-ass!))
                                        (lambda () (ew '(ZERO K))
                                          (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst `(= ,x (ZERO K))) (cw-crs! '()))))))))
                                    (lambda ()
                                      (let ((r (cw-principal-witness! x '(ZERO K))))
                                        (cw-type! r)
                                        (dk-have! `(= ,x (ZERO K)) (lambda () (subst `(= ,x ,(cw-mul r '(ZERO K)))) (cw-crs! (list r))))
                                        (subst `(= ,x (ZERO K)))
                                        (dk-ass!)))))))
                            (fact 'class-extensionality iv pp)
                            (dk-ass!)))))))))))))
(qed 'nv-uniformizer-pid)

;;; -----------------------------------------------------------------------
;;; 17. Proposition 4.12: in a local NV field (A = Z(K) compact with a uniformizing parameter), every module
;;; E /= K is principal: E = A g.  If x0 is not in E then |y| < |x0| on E, so E lies in A x0 uw; the
;;; multipliers form an ideal of A, principal by section 16.

(define (cw-module-thm! name concl)
  (dk-sp-qed! (make-wff `(FORALL K (FORALL A (FORALL E (IMPLIES (IS-NV-MODULE K A E) ,concl)))))
    (lambda ()
      (di) (di)
      (mac-h 'is-nv-module '(IS-NV-MODULE K A E))
      (dk-split-all!)
      (if (not (dk-ass!)) (error "cw-module-thm!: not a conjunct" name (dk-goal))))
    name))
(cw-module-thm! 'nv-module-sub '(FORALL x (IMPLIES (IN x E) (IN x (CARR K)))))
(cw-module-thm! 'nv-module-zero '(IN (ZERO K) E))
(cw-module-thm! 'nv-module-add '(FORALL x (IMPLIES (IN x E) (FORALL y (IMPLIES (IN y E) (IN ((ADD K) x y) E))))))
(cw-module-thm! 'nv-module-neg '(FORALL x (IMPLIES (IN x E) (IN ((NEG K) x) E))))
(cw-module-thm! 'nv-module-mul '(FORALL r (IMPLIES (IN r A) (FORALL x (IMPLIES (IN x E) (IN ((MUL K) r x) E))))))

(define cw-loc-hyps (append cw-47-hyps '((= A (NV-INTEGERS K)))))
;; X in CARR K with |X| <= 1: X in A (A = Z(K))
(define (cw-in-integers! x)
  (dk-have! `(IN ,x (NV-INTEGERS K)) (lambda () (mac 'nv-integers) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
  (dk-have! `(IN ,x A) (lambda () (subst '(= A (NV-INTEGERS K))) (dk-ass!))))

(sp (make-wff `(FORALL K (FORALL A (FORALL uw ,(cw-curry cw-loc-hyps
  `(FORALL E (IMPLIES (IS-NV-MODULE K A E) (FORALL x0 (IMPLIES (IN x0 (CARR K)) (IMPLIES (NOT (IN x0 E))
     (FORALL y (IMPLIES (IN y E) (FORSOME t (AND (IN t A) (= y ((MUL K) t ((MUL K) x0 uw))))))))))))))))))
(dk-peel!)
(cw-47-setup!)
(dk-cite! 'nv-module-zero 'K 'A 'E)
(dk-cite! 'nv-module-sub 'K 'A 'E 'y)
(cw-typek! 'x0)
(cw-typek! 'y)
(dk-have! '(NOT (= x0 (ZERO K)))
  (lambda () (di) (dk-have! '(IN x0 E) (lambda () (subst '(= x0 (ZERO K))) (dk-ass!))) (ai '(NOT (IN x0 E)))))
(use-em '(= y (ZERO K))
  (lambda ()
    (ew '(ZERO K))
    (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst '(= y (ZERO K))) (cw-crs! '(x0 uw)))))))
  (lambda ()
    (let* ((z (dk-skolem! (dk-cite! 'nf-inverse 'K 'y)))
           (xi (dk-skolem! (dk-cite! 'nf-inverse 'K 'x0))))
      (cw-typek! z) (cw-typek! xi)
      (dk-cite! 'nf-norm-one 'K)
      ;; |x0| <= |y| is absurd: q = x0 / y has |q| <= 1, so q in A and x0 = q y in E
      (define (le-absurd!)
        (let ((q (cw-mul 'x0 z)))
          (dk-cite! 'nf-mul-in-carr 'K 'x0 z)
          (cw-typek! q)
          (dk-cite! 'nf-norm-mult 'K 'x0 z)
          (dk-cite! 'nf-norm-mult 'K 'y z)
          (dk-have! `(= (* ,(cw-n 'y) ,(cw-n z)) 1)
            (lambda () (subst `(= (* ,(cw-n 'y) ,(cw-n z)) ,(cw-n (cw-mul 'y z)))) (subst `(= ,(cw-mul 'y z) (ONE K))) (dk-ass!)))
          (dk-cite! 'rr-mul-le-right (cw-n 'x0) (cw-n 'y) (cw-n z))
          (cw-rr-mul! (cw-n 'x0) (cw-n z)) (cw-rr-mul! (cw-n 'y) (cw-n z))
          (dk-have! `(<= ,(cw-n q) 1)
            (lambda () (dk-ineq! `(= ,(cw-n q) (* ,(cw-n 'x0) ,(cw-n z))) `(<= (* ,(cw-n 'x0) ,(cw-n z)) (* ,(cw-n 'y) ,(cw-n z)))
                                 `(= (* ,(cw-n 'y) ,(cw-n z)) 1))))
          (cw-in-integers! q)
          (dk-cite! 'nv-module-mul 'K 'A 'E q 'y)
          (dk-have! '(IN x0 E)
            (lambda ()
              (dk-have! `(= ,(cw-mul q 'y) x0)
                (lambda ()
                  (dk-have! `(= ,(cw-mul q 'y) ,(cw-mul 'x0 (cw-mul 'y z))) (lambda () (cw-crs! (list 'x0 'y z))))
                  (subst `(= ,(cw-mul q 'y) ,(cw-mul 'x0 (cw-mul 'y z))))
                  (subst `(= ,(cw-mul 'y z) (ONE K)))
                  (cw-crs! '(x0))))
              (subst `(= x0 ,(cw-mul q 'y)))
              (dk-ass!)))
          (ai '(NOT (IN x0 E)))))
      (cw-and! `(IN ,(cw-n 'x0) RR) `(IN ,(cw-n 'y) RR))
      (dk-have! `(< ,(cw-n 'y) ,(cw-n 'x0))
        (lambda ()
          (cw-or-each! (dk-cite! 'rr-leq-total (cw-n 'x0) (cw-n 'y))
            (lambda (o)
              (if (equal? o `(<= ,(cw-n 'x0) ,(cw-n 'y)))
                  (begin (pbc) (le-absurd!))
                  (begin
                    (dk-have! `(NOT (= ,(cw-n 'y) ,(cw-n 'x0)))
                      (lambda () (di) (dk-have! `(<= ,(cw-n 'x0) ,(cw-n 'y)) (lambda () (dk-ineq! `(= ,(cw-n 'y) ,(cw-n 'x0))))) (le-absurd!)))
                    (cw-and! `(<= ,(cw-n 'y) ,(cw-n 'x0)) `(NOT (= ,(cw-n 'y) ,(cw-n 'x0))))
                    (dk-cite! 'rr-le-ne-lt (cw-n 'y) (cw-n 'x0))
                    (dk-ass!)))))))
      ;; s = y / x0 has |s| < 1, so s in M = (uw)
      (dk-cite! 'nf-mul-in-carr 'K 'y xi)
      (let ((s (dk-name! (cw-mul 'y xi) '(CARR K))))
        (cw-typek! s)
        (dk-cite! 'nf-norm-mult 'K 'x0 xi)
        (dk-have! `(= (* ,(cw-n 'x0) ,(cw-n xi)) 1)
          (lambda () (subst `(= (* ,(cw-n 'x0) ,(cw-n xi)) ,(cw-n (cw-mul 'x0 xi)))) (subst `(= ,(cw-mul 'x0 xi) (ONE K))) (dk-ass!)))
        (dk-cite! 'nf-norm-mult 'K 'y xi)
        (dk-have! `(<= ,(cw-n 'y) ,(cw-n 'x0)) (lambda () (dk-ineq! `(< ,(cw-n 'y) ,(cw-n 'x0)))))
        (dk-cite! 'rr-mul-le-right (cw-n 'y) (cw-n 'x0) (cw-n xi))
        (cw-rr-mul! (cw-n 'y) (cw-n xi)) (cw-rr-mul! (cw-n 'x0) (cw-n xi))
        (dk-have! `(= ,(cw-n s) (* ,(cw-n 'y) ,(cw-n xi))) (lambda () (subst `(= ,s ,(cw-mul 'y xi))) (dk-ass!)))
        (dk-have! `(<= ,(cw-n s) 1)
          (lambda () (dk-ineq! `(= ,(cw-n s) (* ,(cw-n 'y) ,(cw-n xi))) `(<= (* ,(cw-n 'y) ,(cw-n xi)) (* ,(cw-n 'x0) ,(cw-n xi)))
                               `(= (* ,(cw-n 'x0) ,(cw-n xi)) 1))))
        (cw-in-integers! s)
        (cw-type! s)
        (dk-have! `(= ,(cw-mul s 'x0) y)
          (lambda ()
            (subst `(= ,s ,(cw-mul 'y xi)))
            (dk-have! `(= ,(cw-mul (cw-mul 'y xi) 'x0) ,(cw-mul 'y (cw-mul 'x0 xi))) (lambda () (cw-crs! (list 'y xi 'x0))))
            (subst `(= ,(cw-mul (cw-mul 'y xi) 'x0) ,(cw-mul 'y (cw-mul 'x0 xi))))
            (subst `(= ,(cw-mul 'x0 xi) (ONE K)))
            (cw-crs! '(y))))
        (dk-have! `(NOT (= ,(cw-n s) 1))
          (lambda ()
            (di)
            (dk-cite! 'nf-norm-mult 'K s 'x0)
            (dk-have! `(= ,(cw-n 'y) (* ,(cw-n s) ,(cw-n 'x0)))
              (lambda () (subst `(= y ,(cw-mul s 'x0))) (dk-ass!)))
            (dk-cite! 'rr-mul-left-one (cw-n s) (cw-n 'x0))
            (cw-rr-mul! (cw-n s) (cw-n 'x0))
            (dk-absurd! `(= ,(cw-n 'y) (* ,(cw-n s) ,(cw-n 'x0))) `(= (* ,(cw-n s) ,(cw-n 'x0)) ,(cw-n 'x0)) `(< ,(cw-n 'y) ,(cw-n 'x0)))))
        (cw-and! `(<= ,(cw-n s) 1) `(NOT (= ,(cw-n s) 1)))
        (dk-cite! 'rr-le-ne-lt (cw-n s) 1)
        (dk-have! `(IN ,s (NV-MAXIMAL K A)) (lambda () (cw-max-close! (lambda () (dk-ass!)))))
        (dk-have! `(IN ,s (NV-PRINCIPAL K A uw)) (lambda () (subst '(= (NV-PRINCIPAL K A uw) (NV-MAXIMAL K A))) (dk-ass!)))
        (let ((t (cw-principal-witness! s 'uw)))
          (cw-type! t)
          (ew t)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (begin
                    (subst `(= y ,(cw-mul s 'x0)))
                    (subst `(= ,s ,(cw-mul t 'uw)))
                    (cw-crs! (list t 'uw 'x0)))))))))))
(qed 'nv-local-module-in-multiple)

(sp (make-wff `(FORALL K (FORALL A (FORALL uw ,(cw-curry cw-loc-hyps
  `(FORALL E (IMPLIES (IS-NV-MODULE K A E) (IMPLIES (NOT (= E (CARR K)))
     (FORSOME g (AND (IN g (CARR K)) (= E (NV-MULTIPLES K A g)))))))))))))
(dk-peel!)
(cw-47-setup!)
(for-each (lambda (r) (dk-cite! r 'K 'A 'E)) '(nv-module-zero nv-module-sub nv-module-add nv-module-neg nv-module-mul))
(let ((out '(FORSOME cwo_ (AND (IN cwo_ (CARR K)) (NOT (IN cwo_ E))))))
  (use-em out
    (lambda ()
      (let* ((x0 (dk-skolem! out))
             (w (cw-mul x0 'uw))
             (iset `(SEP cwt_ A (IN ((MUL K) cwt_ ,w) E))))
        (cw-typek! x0)
        (dk-cite! 'nf-mul-in-carr 'K x0 'uw)
        (let ((key (dk-cite! 'nv-local-module-in-multiple 'K 'A 'uw 'E x0)))
          ;; the multipliers form an ideal of A
          (dk-have! `(IS-NV-IDEAL K A ,iset)
            (lambda ()
              (mac 'is-nv-ideal)
              (dk-conj-close!
                (lambda ()
                  (let ((g (dk-goal)))
                    (cond
                      ((dk-head-is? g 'IN)
                       (in-sep! (lambda () (dk-ass!))
                         (lambda ()
                           (dk-have! `(= ,(cw-mul '(ZERO K) w) (ZERO K)) (lambda () (cw-crs! (list x0 'uw))))
                           (subst `(= ,(cw-mul '(ZERO K) w) (ZERO K)))
                           (dk-ass!))))
                      ((equal? (cadr (caddr g)) `(IN ,(cadr g) A))
                       (dk-peel!)
                       (let* ((xs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) iset))) (dk-asms))))
                              (r (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'A) (symbol? (cadr f)))) (dk-asms))))
                              (x (car xs)))
                         (sep-me `(IN ,x ,iset))
                         (cw-type! r) (cw-type! x)
                         (dk-cite! 'nv-domain-mul 'K 'A r x)
                         (dk-cite! 'nv-module-mul 'K 'A 'E r (cw-mul x w))
                         (in-sep! (lambda () (dk-ass!))
                           (lambda ()
                             (dk-have! `(= ,(cw-mul (cw-mul r x) w) ,(cw-mul r (cw-mul x w))) (lambda () (cw-crs! (list r x x0 'uw))))
                             (subst `(= ,(cw-mul (cw-mul r x) w) ,(cw-mul r (cw-mul x w))))
                             (dk-ass!)))))
                      ((dk-contains? (caddr g) '(ADD K))
                       (dk-peel!)
                       (let* ((xs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) iset))) (dk-asms))))
                              (x (car xs)) (y (cadr xs)))
                         (sep-me `(IN ,x ,iset)) (sep-me `(IN ,y ,iset))
                         (cw-type! x) (cw-type! y)
                         (dk-cite! 'nv-domain-add 'K 'A x y)
                         (dk-cite! 'nv-module-add 'K 'A 'E (cw-mul x w) (cw-mul y w))
                         (in-sep! (lambda () (dk-ass!))
                           (lambda ()
                             (let ((g2 (cadr (dk-goal))))
                               (dk-have! `(= ,g2 ,(cw-add (cw-mul x w) (cw-mul y w))) (lambda () (cw-crs! (list x y x0 'uw))))
                               (subst `(= ,g2 ,(cw-add (cw-mul x w) (cw-mul y w))))
                               (dk-ass!))))))
                      ((dk-contains? (caddr g) '(NEG K))
                       (dk-peel!)
                       (let ((x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) iset))) (dk-asms)))))
                         (sep-me `(IN ,x ,iset))
                         (cw-type! x)
                         (dk-cite! 'nv-domain-neg 'K 'A x)
                         (dk-cite! 'nv-module-neg 'K 'A 'E (cw-mul x w))
                         (in-sep! (lambda () (dk-ass!))
                           (lambda ()
                             (let ((g2 (cadr (dk-goal))))
                               (dk-have! `(= ,g2 ,(cw-neg (cw-mul x w))) (lambda () (cw-crs! (list x x0 'uw))))
                               (subst `(= ,g2 ,(cw-neg (cw-mul x w))))
                               (dk-ass!))))))
                      (#t (di) (let ((x (cadr (dk-goal)))) (sep-me `(IN ,x ,iset)) (dk-ass!)))))))))
          (dk-cite! 'nv-uniformizer-pid 'K 'A 'uw)
          (let* ((g0 (dk-skolem! (dk-cite! 'nv-pid-principal 'K 'A iset)))
                 (gg (cw-mul g0 w))
                 (mg `(NV-MULTIPLES K A ,gg)))
            (cw-type! g0)
            (dk-cite! 'nf-mul-in-carr 'K g0 w)
            (ew gg)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (begin
                      (dk-have! `(FORALL cwq_ (IFF (IN cwq_ E) (IN cwq_ ,mg)))
                        (lambda ()
                          (di)
                          (let ((y (cadr (cadr (dk-goal)))))
                            (dk-iff! (lambda (g) (dk-contains? g 'NV-MULTIPLES))
                              (lambda ()
                                (let ((t (dk-skolem! (dk-apply! key y))))
                                  (dk-cite! 'nv-module-sub 'K 'A 'E y)
                                  (cw-type! t)
                                  (dk-have! `(IN ,t ,iset)
                                    (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (subst `(= ,(cw-mul t w) ,y)) (dk-ass!)))))
                                  (dk-have! `(IN ,t (NV-PRINCIPAL K A ,g0)) (lambda () (subst `(= (NV-PRINCIPAL K A ,g0) ,iset)) (dk-ass!)))
                                  (let ((m (cw-principal-witness! t g0)))
                                    (cw-type! m)
                                    (mac 'nv-multiples)
                                    (in-sep! (lambda () (dk-ass!))
                                      (lambda ()
                                        (ew m)
                                        (dk-conj-close!
                                          (lambda ()
                                            (if (not (dk-ass!))
                                                (begin
                                                  (subst `(= ,y ,(cw-mul t w)))
                                                  (subst `(= ,t ,(cw-mul m g0)))
                                                  (cw-crs! (list m g0 x0 'uw)))))))))))
                              (lambda ()
                                (let* ((l (dk-landed (lambda () (mac-h 'nv-multiples-unfold `(IN ,y ,mg)))))
                                       (l2 (dk-landed (lambda () (sep-me (car l)))))
                                       (m (dk-skolem! (find-first (lambda (f) (dk-head-is? f 'FORSOME)) l2))))
                                  (cw-type! m)
                                  (dk-cite! 'nv-domain-mul 'K 'A m g0)
                                  (dk-have! `(IN ,(cw-mul m g0) (NV-PRINCIPAL K A ,g0))
                                    (lambda ()
                                      (mac 'nv-principal)
                                      (in-sep! (lambda () (dk-ass!))
                                        (lambda () (ew m) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))
                                  (dk-have! `(IN ,(cw-mul m g0) ,iset) (lambda () (subst `(= ,iset (NV-PRINCIPAL K A ,g0))) (dk-ass!)))
                                  (sep-me `(IN ,(cw-mul m g0) ,iset))
                                  (subst `(= ,y ,(cw-mul m gg)))
                                  (dk-have! `(= ,(cw-mul m gg) ,(cw-mul (cw-mul m g0) w)) (lambda () (cw-crs! (list m g0 x0 'uw))))
                                  (subst `(= ,(cw-mul m gg) ,(cw-mul (cw-mul m g0) w)))
                                  (dk-ass!)))))))
                      (fact 'class-extensionality 'E mg)
                      (dk-ass!)))))))))
    ;; every x in K is in E: E = K, against the hypothesis
    (lambda ()
      (pbc)
      (dk-have! '(FORALL cwq_ (IFF (IN cwq_ E) (IN cwq_ (CARR K))))
        (lambda ()
          (di)
          (let ((x (cadr (cadr (dk-goal)))))
            (dk-iff! (lambda (g) (dk-contains? g 'CARR))
              (lambda () (dk-cite! 'nv-module-sub 'K 'A 'E x) (dk-ass!))
              (lambda ()
                (pbc)
                (dk-have! out (lambda () (ew x) (dk-conj-close! (lambda () (dk-ass!)))))
                (ai `(NOT ,out)))))))
      (fact 'class-extensionality 'E '(CARR K))
      (ai '(NOT (= E (CARR K)))))))
(qed 'nv-local-module-principal)

;;; -----------------------------------------------------------------------
;;; 18. Ultrametric finite sums, and Remark 1.42.

(define cw3-ag `(RING-ADDITIVE-AG ,cw-view))
(define (cw3-fs f s) `(FINSUM ,cw3-ag ,f ,s))
;; the ring view, its additive group, and their read-offs
(define (cw3-ag-setup!)
  (cw-view!)
  (dk-cite! 'normed-field-ring-view-add 'K)
  (dk-cite! 'normed-field-ring-view-zero 'K)
  (dk-cite! 'ring-additive-ag-is-abelian-group cw-view)
  (for-each (lambda (r) (dk-cite! r cw-view)) '(raag-carr raag-iden raag-opr)))
;; (IN T (CARR AG)) from (IN T (CARR K))
(define (cw3-in-ag! t)
  (dk-have! `(IN ,t (CARR ,cw3-ag))
    (lambda () (subst `(= (CARR ,cw3-ag) (CARR ,cw-view))) (subst `(= (CARR ,cw-view) (CARR K))) (dk-ass!))))

;; Remark 1.42: |a| < |b| gives |a + b| = |b|
(sp (make-wff '(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL x (IMPLIES (IN x (CARR K)) (FORALL y (IMPLIES (IN y (CARR K))
  (IMPLIES (< ((FNRM K) x) ((FNRM K) y)) (= ((FNRM K) ((ADD K) x y)) ((FNRM K) y)))))))))))
(dk-peel!)
(dk-cite! 'nv-field-normed 'K)
(cw-typek! 'x) (cw-typek! 'y)
(let* ((xy (cw-add 'x 'y)))
  (dk-cite! 'nf-add-in-carr 'K 'x 'y)
  (cw-typek! xy)
  (dk-cite! 'nf-neg-in-carr 'K 'x)
  (cw-typek! (cw-neg 'x))
  (dk-cite! 'nf-norm-neg 'K 'x)
  (dk-cite! 'nv-ultra 'K 'x 'y)
  (dk-cite! 'nv-ultra 'K xy (cw-neg 'x))
  (dk-cite! 'rr-max-closed (cw-n 'x) (cw-n 'y))
  (dk-cite! 'rr-max-closed (cw-n xy) (cw-n (cw-neg 'x)))
  (dk-have! `(<= ,(cw-n 'x) ,(cw-n 'y)) (lambda () (dk-ineq! `(< ,(cw-n 'x) ,(cw-n 'y)))))
  (dk-have! `(<= ,(cw-n 'y) ,(cw-n 'y)) (lambda () (dk-ineq!)))
  (dk-cite! 'rr-max-le (cw-n 'x) (cw-n 'y) (cw-n 'y))
  (dk-cite! 'nf-add-in-carr 'K xy (cw-neg 'x))
  (cw-typek! (cw-add xy (cw-neg 'x)))
  (dk-have! `(= ,(cw-add xy (cw-neg 'x)) y) (lambda () (cw-crs! '(x y))))
  (dk-have! `(= ,(cw-n (cw-add xy (cw-neg 'x))) ,(cw-n 'y)) (lambda () (subst `(= ,(cw-add xy (cw-neg 'x)) y)) (rfl)))
  (dk-have! `(<= ,(cw-n xy) ,(cw-n 'y))
    (lambda () (dk-ineq! `(<= ,(cw-n xy) (MAX ,(cw-n 'x) ,(cw-n 'y))) `(<= (MAX ,(cw-n 'x) ,(cw-n 'y)) ,(cw-n 'y)))))
  (pbc)
  (dk-have! `(< ,(cw-n xy) ,(cw-n 'y))
    (lambda ()
      (cw-and! `(<= ,(cw-n xy) ,(cw-n 'y)) `(NOT (= ,(cw-n xy) ,(cw-n 'y))))
      (dk-cite! 'rr-le-ne-lt (cw-n xy) (cw-n 'y))
      (dk-ass!)))
  (dk-have! `(< ,(cw-n (cw-neg 'x)) ,(cw-n 'y)) (lambda () (dk-ineq! `(= ,(cw-n (cw-neg 'x)) ,(cw-n 'x)) `(< ,(cw-n 'x) ,(cw-n 'y)))))
  (dk-cite! 'rr-max-lt (cw-n xy) (cw-n (cw-neg 'x)) (cw-n 'y))
  (dk-absurd! `(<= ,(cw-n (cw-add xy (cw-neg 'x))) (MAX ,(cw-n xy) ,(cw-n (cw-neg 'x))))
              `(< (MAX ,(cw-n xy) ,(cw-n (cw-neg 'x))) ,(cw-n 'y))
              `(= ,(cw-n (cw-add xy (cw-neg 'x))) ,(cw-n 'y))))
(qed 'nv-strict-dominance)

;; the ultrametric bound on finite sums: REL is <= (with 0 <= r) or < (with 0 < r)
(define (cw3-finsum-bound! rel rel0 name)
  (let* ((hyp-of (lambda (s) `(FORALL cw3z_ (IMPLIES (IN cw3z_ ,s) (AND (IN (f cw3z_) (CARR K)) (,rel ((FNRM K) (f cw3z_)) rb))))))
         (concl-of (lambda (s) `(,rel ((FNRM K) ,(cw3-fs 'f s)) rb)))
         (p-of (lambda (s) `(IMPLIES ,(hyp-of s) ,(concl-of s)))))
    (dk-sp-qed!
      (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL sq (IMPLIES (IN sq SET) (IMPLIES (IN (CARD sq) NN)
        (FORALL f (FORALL rb (IMPLIES (IN rb RR) (IMPLIES (,rel0 0 rb) ,(p-of 'sq)))))))))))
      (lambda ()
        (dk-peel!)
        (dk-cite! 'nv-field-normed 'K)
        (cw3-ag-setup!)
        (dk-cite! 'nf-zero-in-carr 'K)
        (let* ((c `(COMP cw3s_ ,(p-of 'cw3s_)))
               (stepf `(FORALL is_ (IMPLIES (AND (IN is_ SET) (AND (IN (CARD is_) NN) (IN is_ ,c)))
                          (FORALL ix_ (IMPLIES (AND (IN ix_ SET) (NOT (IN ix_ is_))) (IN (UNION is_ (PAIR ix_ ix_)) ,c)))))))
          ;; base: the empty sum is 0
          (dk-have! `(IN EMPTY-SET ,c)
            (lambda ()
              (for-each
                (lambda (leaf)
                  (dk-focus! leaf)
                  (if (equal? (dk-goal) '(IN EMPTY-SET SET))
                      (begin (fact 'empty-set-is-set) (dk-ass!))
                      (begin
                        (di)
                        (dk-cite! 'finsum-empty cw3-ag 'f)
                        (subst `(= ,(cw3-fs 'f 'EMPTY-SET) (IDEN ,cw3-ag)))
                        (subst `(= (IDEN ,cw3-ag) (ZERO ,cw-view)))
                        (subst `(= (ZERO ,cw-view) (ZERO K)))
                        (dk-cite! 'nf-norm-of-zero 'K)
                        (subst `(= ((FNRM K) (ZERO K)) 0))
                        (dk-ass!))))
                (dk-opened (lambda () (comp-mi))))))
          ;; step: insert a point, ultrametric inequality
          (dk-have! stepf
            (lambda ()
              (let* ((landed (dk-peel!)) (g (dk-goal)) (u (cadr g)) (sv (cadr u)) (xv (cadr (caddr u))))
                (dk-split-all! landed)
                (cw-and! `(IN ,xv SET) `(IN ,xv SET))
                (fact 'pairing xv xv)
                (cw-and! `(IN ,sv SET) `(IN (PAIR ,xv ,xv) SET))
                (fact 'union-set-closure sv `(PAIR ,xv ,xv))
                (let* ((ls (dk-landed (lambda () (comp-me `(IN ,sv ,c)))))
                       (ih (find-first (lambda (f) (dk-head-is? f 'IMPLIES)) ls)))
                  (for-each
                    (lambda (leaf)
                      (dk-focus! leaf)
                      (if (equal? (dk-goal) `(IN ,u SET))
                          (dk-ass!)
                          (begin
                            (di)
                            (let ((hu (hyp-of u)))
                              ;; H restricted to sv, and at xv
                              (dk-have! (hyp-of sv)
                                (lambda ()
                                  (dk-peel!)
                                  (let ((z (cadr (cadr (cadr (dk-goal))))))
                                    (dk-have! `(IN ,z ,u) (lambda () (mac 'union-membership) (oi-l) (dk-ass!)))
                                    (dk-apply! hu z)
                                    (dk-ass!))))
                              (detach! ih)
                              (dk-have! `(IN ,xv ,u)
                                (lambda ()
                                  (mac 'union-membership) (oi-r)
                                  (cw-and! `(IN ,xv SET) `(IN ,xv SET))
                                  (let ((pm (inst*! (dk-cite! 'pairing-membership xv xv) xv)))
                                    (dk-have! `(= ,xv ,xv) (lambda () (rfl)))
                                    (cw-keep-prop! pm `(= ,xv ,xv)))))
                              (dk-split! (dk-apply! hu xv))
                              (cw-typek! `(f ,xv))
                              ;; typings in the additive group
                              (dk-have! `(FORALL cw3w_ (IMPLIES (IN cw3w_ ,u) (IN (f cw3w_) (CARR ,cw3-ag))))
                                (lambda () (dk-peel!) (let ((z (cadr (cadr (dk-goal))))) (dk-split! (dk-apply! hu z)) (cw3-in-ag! `(f ,z)) (dk-ass!))))
                              (dk-have! `(FORALL cw3w_ (IMPLIES (IN cw3w_ ,sv) (IN (f cw3w_) (CARR ,cw3-ag))))
                                (lambda () (dk-peel!) (let ((z (cadr (cadr (dk-goal)))))
                                  (dk-split! (dk-apply! (hyp-of sv) z)) (cw3-in-ag! `(f ,z)) (dk-ass!))))
                              (dk-cite! 'finsum-type-ptwise cw3-ag sv 'f)
                              (dk-have! `(IN ,(cw3-fs 'f sv) (CARR K))
                                (lambda () (subst `(= (CARR K) (CARR ,cw-view))) (subst `(= (CARR ,cw-view) (CARR ,cw3-ag))) (dk-ass!)))
                              (cw-typek! (cw3-fs 'f sv))
                              (dk-cite! 'finsum-insert-ptwise cw3-ag sv xv 'f)
                              (subst `(= ,(cw3-fs 'f u) ((OPR ,cw3-ag) ,(cw3-fs 'f sv) (f ,xv))))
                              (subst `(= (OPR ,cw3-ag) (ADD ,cw-view)))
                              (subst `(= (ADD ,cw-view) (ADD K)))
                              (let ((a (cw-n (cw3-fs 'f sv))) (b (cw-n `(f ,xv))))
                                (dk-cite! 'nv-ultra 'K (cw3-fs 'f sv) `(f ,xv))
                                (dk-cite! 'nf-add-in-carr 'K (cw3-fs 'f sv) `(f ,xv))
                                (cw-typek! (cw-add (cw3-fs 'f sv) `(f ,xv)))
                                (dk-cite! 'rr-max-closed a b)
                                (if (eq? rel '<=) (dk-cite! 'rr-max-le a b 'rb) (dk-cite! 'rr-max-lt a b 'rb))
                                (dk-ineq! `(<= ,(cw-n (cw-add (cw3-fs 'f sv) `(f ,xv))) (MAX ,a ,b)) `(,rel (MAX ,a ,b) rb)))))))
                    (dk-opened (lambda () (comp-mi))))))))
          (cw-and! `(IN EMPTY-SET ,c) stepf)
          (let ((ind (dk-fact! 'finite-set-induction c)))
            (cw-and! '(IN sq SET) '(IN (CARD sq) NN))
            (let* ((inx (dk-apply! ind 'sq))
                   (ls (dk-landed (lambda () (comp-me inx)))))
              (detach! (find-first (lambda (f) (dk-head-is? f 'IMPLIES)) ls))
              (dk-ass!)))))
      name)))
(cw3-finsum-bound! '<= '<= 'nv-finsum-le)
(cw3-finsum-bound! '< '< 'nv-finsum-lt)

;;; -----------------------------------------------------------------------
;;; 19. Proposition 1.43 (Gauss): the product of two polynomials of content 1 has content 1.

;; a b < 1 for a, b in [0, 1] with a < 1 (left) or b < 1 (right)
(sp (make-wff '(FORALL cra (IMPLIES (IN cra RR) (FORALL crb (IMPLIES (IN crb RR)
  (IMPLIES (<= 0 cra) (IMPLIES (<= 0 crb) (IMPLIES (< cra 1) (IMPLIES (<= crb 1) (< (* cra crb) 1)))))))))))
(dk-peel!)
(fact 'rr-one-in)
(dk-cite! 'rr-mul-le-right 'crb 1 'cra)
(dk-cite! 'rr-one-mul 'cra)
(cw-rr-mul! 'crb 'cra) (cw-rr-mul! 'cra 'crb) (cw-rr-mul! 1 'cra)
(dk-have! '(= (* crb cra) (* cra crb)) (lambda () (crs)))
(dk-ineq! '(<= (* crb cra) (* 1 cra)) '(= (* crb cra) (* cra crb)) '(= (* 1 cra) cra) '(< cra 1))
(qed 'rr-prod-lt-one-left)
(sp (make-wff '(FORALL cra (IMPLIES (IN cra RR) (FORALL crb (IMPLIES (IN crb RR)
  (IMPLIES (<= 0 cra) (IMPLIES (<= 0 crb) (IMPLIES (<= cra 1) (IMPLIES (< crb 1) (< (* cra crb) 1)))))))))))
(dk-peel!)
(fact 'rr-one-in)
(dk-cite! 'rr-mul-le-right 'cra 1 'crb)
(dk-cite! 'rr-one-mul 'crb)
(cw-rr-mul! 'cra 'crb) (cw-rr-mul! 1 'crb)
(dk-ineq! '(<= (* cra crb) (* 1 crb)) '(= (* 1 crb) crb) '(< crb 1))
(qed 'rr-prod-lt-one-right)
(sp (make-wff '(FORALL cra (IMPLIES (IN cra RR) (FORALL crb (IMPLIES (IN crb RR)
  (IMPLIES (<= 0 cra) (IMPLIES (<= 0 crb) (IMPLIES (<= cra 1) (IMPLIES (<= crb 1) (<= (* cra crb) 1)))))))))))
(dk-peel!)
(fact 'rr-one-in)
(dk-cite! 'rr-mul-le-right 'cra 1 'crb)
(dk-cite! 'rr-one-mul 'crb)
(cw-rr-mul! 'cra 'crb) (cw-rr-mul! 1 'crb)
(dk-ineq! '(<= (* cra crb) (* 1 crb)) '(= (* 1 crb) crb) '(<= crb 1))
(qed 'rr-prod-le-one)

;;; MOVED 2026-11-10 (integration): the proof of `rr-not-lt-ge' is now in
;;; theorem-library/rr-not-lt-ge.scm (library core).

(define cw3-nnm 'NN-ADD-MONOID)
;; nth-r on the focus, closing the reflexive definedness leaves it owes; focus back on the reduced goal
(define (cw3-nth-r!)
  (let ((before (dk-open-leaves)))
    (nth-r)
    (let ((main (proof-state-focus *ps*)))
      (for-each (lambda (l)
                  (let ((g (dk-goal-of l)))
                    (if (and (not (memq l before)) (not (sequent-node-grounded? l)) (not (eq? l main))
                             (eq? (car g) '=) (equal? (cadr g) (caddr g)))
                        (begin (dk-focus! l) (rfl)))))
                (dk-open-leaves))
      (if (not (sequent-node-grounded? main)) (dk-focus! main)))))
(define (cw3-iff-fwd! iff) (ai iff) (detach! `(IMPLIES ,(cadr iff) ,(caddr iff))) (dk-split-all!))
;; P in FINSUPP: land P in FUN(NN, CARR K) and CARD(SUPP P) in NN
(define (cw3-poly! p)
  (let ((iff (dk-cite! 'finsupp-membership cw-view cw3-nnm p)))
    (dk-have! `(IN ,p (FUN NN (CARR K)))
      (lambda ()
        (cw3-iff-fwd! iff)
        (subst `(= NN (CARR ,cw3-nnm)))
        (subst `(= (CARR K) (CARR ,cw-view)))
        (dk-ass!)))
    (dk-have! `(IN (CARD (SUPP ,cw-view ,cw3-nnm ,p)) NN) (lambda () (cw3-iff-fwd! iff) (dk-ass!)))))
(define (cw3-coef! p i)
  (dk-cite! 'fun-apply-type-c p 'NN '(CARR K) i)
  (cw-typek! `(,p ,i)))
;; IS-NV-CONTENT-ONE(K, P) in context: land the bound law, an index M (the least with |P M| = 1), and
;; return (bound m least)
(define (cw3-unpack! p)
  (let* ((l (dk-landed (lambda () (dk-project! `(FORALL cw3i_ (IMPLIES (IN cw3i_ NN) (<= ((FNRM K) (,p cw3i_)) 1)))
                                                'is-nv-content-one `(IS-NV-CONTENT-ONE K ,p)))))
         (ex `(FORSOME cw3i_ (AND (IN cw3i_ NN) (= ((FNRM K) (,p cw3i_)) 1))))
         (bound `(FORALL cw3i_ (IMPLIES (IN cw3i_ NN) (<= ((FNRM K) (,p cw3i_)) 1))))
         (tset `(SEP cwt_ NN (= ((FNRM K) (,p cwt_)) 1))))
    (dk-project! ex 'is-nv-content-one `(IS-NV-CONTENT-ONE K ,p))
    (let ((i0 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f p) (dk-contains? f 'FNRM))) "the unit coefficient"))))
      (dk-have! `(IN ,i0 ,tset) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
      (dk-have! `(SUBSET ,tset NN) (lambda () (mac 'subset-def) (di) (let ((z (cadr (dk-goal)))) (sep-me `(IN ,z ,tset)) (dk-ass!))))
      (dk-have! `(FORSOME cwn (IN cwn ,tset)) (lambda () (ew i0) (dk-ass!)))
      (cw-and! `(SUBSET ,tset NN) `(FORSOME cwn (IN cwn ,tset)))
      (let* ((m (dk-skolem! (dk-cite! 'nn-least-element tset)))
             (least (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f tset) (dk-contains? f '<=))) "the least law")))
        (dk-have! `(IN ,m NN) (lambda () (sep-me `(IN ,m ,tset)) (dk-ass!)))
        (dk-have! `(= ((FNRM K) (,p ,m)) 1) (lambda () (sep-me `(IN ,m ,tset)) (dk-ass!)))
        (list bound m least tset)))))
;; with (< I M) in context, I in NN: land |P I| < 1
(define (cw3-below! p i un)
  (let ((bound (car un)) (m (cadr un)) (least (caddr un)) (tset (cadddr un)))
    (cw3-coef! p i)
    (dk-apply! bound i)
    (dk-have! `(NOT (= ((FNRM K) (,p ,i)) 1))
      (lambda ()
        (di)
        (dk-have! `(IN ,i ,tset) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
        (dk-apply! least i)
        (cw-absurd! `(<= ,m ,i) `(< ,i ,m))))
    (cw-and! `(<= ((FNRM K) (,p ,i)) 1) `(NOT (= ((FNRM K) (,p ,i)) 1)))
    (dk-cite! 'rr-le-ne-lt `((FNRM K) (,p ,i)) 1)))

;; the coefficient goal (REL |(MONALG-MUL V NNM P Q)(KK)| B): rewrite it as a FINSUM over the pairs; land the
;; pair set's sethood and finiteness; return (F S)
(define (cw3-coef-sum! p q kk)
  (dk-have! `(IN ,kk (CARR ,cw3-nnm)) (lambda () (subst `(= (CARR ,cw3-nnm) NN)) (dk-ass!)))
  (subst (dk-cite! 'monalg-mul-apply cw-view cw3-nnm p q kk))
  (let* ((fs (cadr (cadr (dk-goal)))) (f (caddr fs)) (s (cadddr fs))
         (sp_ `(SUPP ,cw-view ,cw3-nnm ,p)) (sq_ `(SUPP ,cw-view ,cw3-nnm ,q))
         (cart `(CARTESIAN ,sp_ ,sq_)))
    (dk-cite! 'supp-in-set cw-view cw3-nnm p)
    (dk-cite! 'supp-in-set cw-view cw3-nnm q)
    (dk-cite! 'card-cartesian-nn sp_ sq_)
    (dk-have! `(IN ,cart SET) (lambda () (dk-sethood! cart)))
    (dk-have! `(IN ,s SET) (lambda () (dk-sethood! s)))
    (cw-and! `(IN ,cart SET) `(IN (CARD ,cart) NN))
    (let ((u (dk-cite! 'card-subset-nn cart)))
      (dk-have! `(AND (IN ,s SET) (FORALL cwz_ (IMPLIES (IN cwz_ ,s) (IN cwz_ ,cart))))
        (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (di) (let ((z (cadr (dk-goal)))) (sep-me `(IN ,z ,s)) (dk-ass!))))))))
      (dk-apply! u s))
    (list f s)))
;; Z in S: land i = (NTH 1 Z), j = (NTH 2 Z) in NN, (+ i j) = KK, Z = [i, j], |p i|, |q j| typed, and
;; (= (F Z) (MUL K (p i) (q j))); return (i j)
(define (cw3-term! p q kk f s z)
  (let* ((sp_ `(SUPP ,cw-view ,cw3-nnm ,p)) (sq_ `(SUPP ,cw-view ,cw3-nnm ,q))
         (cart `(CARTESIAN ,sp_ ,sq_))
         (i `(NTH 1 ,z)) (j `(NTH 2 ,z))
         (cond_ `(= ((OPR ,cw3-nnm) ,i ,j) ,kk)))
    (dk-have! `(IN ,z ,cart) (lambda () (sep-me `(IN ,z ,s)) (dk-ass!)))
    (dk-have! cond_ (lambda () (sep-me `(IN ,z ,s)) (dk-ass!)))
    (cw3-iff-fwd! (dk-cite! 'cartesian-membership-nth sp_ sq_ z))
