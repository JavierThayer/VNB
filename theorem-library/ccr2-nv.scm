;; P(k) = uw^k: in A, typed, |P(k)| = |uw|^k in RR
(define (cw-47-pow! k)
  (let ((p (cw-pw 'uw k)))
    (dk-cite! 'nv-pow-in-domain 'K 'A 'uw k)
    (cw-type! p)
    (dk-cite! 'nv-pow-norm-power 'K 'uw k)
