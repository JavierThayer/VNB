            (dk-cite! 'nf-neg-in-carr 'K pm)
            (dk-cite! 'nf-add-in-carr 'K pn (cw-neg pm))
            (dk-cite! 'nf-mul-in-carr 'K z q)
            (dk-cite! 'nf-mul-in-carr 'K pn q)
            (cw-typek! q)
            (cw-typek! zw)
            (cw-typek! pnm)
            ;; |x^n - x^m| = |q|
