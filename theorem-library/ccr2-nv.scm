    (dk-cite! 'nf-norm-mult 'K 'x z)
    (dk-cite! 'nf-norm-one 'K)
    (dk-have! `(= (* ,(cw-n 'x) ,(cw-n z)) 1)
      (lambda () (subst `(= (* ,(cw-n 'x) ,(cw-n z)) ,(cw-n (cw-mul 'x z))))
                 (subst `(= ,(cw-mul 'x z) (ONE K)))
                 (dk-ass!)))
    (dk-cite! 'rr-mul-left-one (cw-n 'x) (cw-n z))
    (cw-rr-mul! (cw-n 'x) (cw-n z))
    (dk-have! `(= ,(cw-n z) 1) (lambda () (dk-ineq! `(= (* ,(cw-n 'x) ,(cw-n z)) 1) `(= (* ,(cw-n 'x) ,(cw-n z)) ,(cw-n z)))))
    (dk-have! `(IN ,z A)
      (lambda ()
        (pbc)
        (dk-cite! 'nv-compact-closed 'K 'A)
        (dk-cite! 'nf-metric-carrier 'K)
        (mac-h 'is-closed `(IS-CLOSED ,sm A))
        (dk-split-all!)
        (mac-h 'is-open `(IS-OPEN ,sm (COMPLEMENT-IN (PTS ,sm) A)))
        (dk-split-all!)
        (dk-have! `(IN ,z (COMPLEMENT-IN (PTS ,sm) A))
          (lambda () (mac 'complement-in-membership)
                     (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst `(= (PTS ,sm) (CARR K))) (dk-ass!)))))))
        (let* ((uo (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'BALL))) "the openness law"))
