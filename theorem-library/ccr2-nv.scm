;; the hypotheses of 4.7: A compact, uw a nonzero generator of M(A) (a uniformizing parameter)
(define cw-47-hyps '((IS-COMPACT-NV-DOMAIN K A) (IN uw A) (= (NV-MAXIMAL K A) (NV-PRINCIPAL K A uw)) (NOT (= uw (ZERO K)))))
(define (cw-curry fs body) (fold-right (lambda (p acc) `(IMPLIES ,p ,acc)) body fs))
;; land the facts about uw every 4.7 proof uses: |uw| in RR, 0 < |uw| < 1, uw in CARR, the ring view
(define (cw-47-setup!)
  (dk-cite! 'nv-compact-domain 'K 'A)
  (dk-cite! 'nv-domain-normed 'K 'A)
  (dk-cite! 'nf-zero-in-carr 'K)
