;;; 16. Corollary 2.14 with a uniformizing parameter: a compact NV domain whose maximal ideal is generated by a
;;; nonzero uw is a PID (the ideal is generated by uw^m, m the least exponent of its nonzero elements).  The
;;; paper's route, through the converse of 2.13, needs the closure of an ideal; this one does not.

(sp (make-wff '(FORALL K (FORALL A (FORALL g (== (NV-MULTIPLES K A g)
  (SEP cw3x_ (CARR K) (FORSOME cw3m_ (AND (IN cw3m_ A) (= cw3x_ ((MUL K) cw3m_ g)))))))))))
(di) (mac 'nv-multiples) (qrfl)
