                  (dk-conj-close!
                    (lambda ()
                      (let ((g (dk-goal)))
                        (cond ((dk-head-is? g 'IN) (subst `(= (PTS ,sm) (CARR K))) (dk-ass!))
                              ((dk-head-is? g 'NOT)
                               (subst `(= ,dd ,nzw))
                               (di)
                               (dk-absurd! `(= ,nzw ,r) `(<= ,nzw ,e) `(= (+ ,e ,e) ,r) `(< 0 ,e)))
                              (#t (subst `(= ,dd ,nzw))
                                  (dk-ineq! `(<= ,nzw ,e) `(= (+ ,e ,e) ,r) `(< 0 ,e)))))))))
              (let ((sub (dk-pick (lambda (h) (and (dk-head-is? h 'SUBSET) (dk-contains? h 'BALL))) "the ball inclusion")))
                (mac-h 'subset-def sub)
                (let* ((un (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'BALL) (dk-contains? h z))) "the inclusion"))
                       (wc (dk-apply! un w)))
                  (mac-h 'complement-in-membership wc)
                  (dk-split-all!)
                  (ai `(NOT (IN ,w A))))))))))
    (mac 'nv-units)
    (in-sep! (lambda () (dk-ass!)) (lambda () (ew z) (dk-conj-close! (lambda () (dk-ass!)))))))
(qed 'nv-compact-norm-one-unit)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-COMPACT-NV-DOMAIN K A) (FORALL x (IMPLIES (IN x A)
  (IFF (IN x (NV-UNITS K A)) (= ((FNRM K) x) 1)))))))))
(dk-peel!)
(dk-cite! 'nv-compact-domain 'K 'A)
(dk-iff! (lambda (g) (dk-head-is? g '=))
  (lambda () (dk-cite! 'nv-unit-norm 'K 'A 'x) (dk-ass!))
  (lambda () (dk-cite! 'nv-compact-norm-one-unit 'K 'A 'x) (dk-ass!)))
(qed 'nv-compact-units-norm-one)

;;; -----------------------------------------------------------------------
;;; 9. Proposition 2.6: M(A) is an ideal, it misses 1, and in a compact NV domain it contains every
;;; proper ideal -- so it is the unique maximal ideal.

(define (cw-ideal-thm! name concl)
  (dk-sp-qed! (make-wff `(FORALL K (FORALL A (FORALL I (IMPLIES (IS-NV-IDEAL K A I) ,concl)))))
    (lambda ()
      (di) (di)
      (mac-h 'is-nv-ideal '(IS-NV-IDEAL K A I))
      (dk-split-all!)
      (if (not (dk-ass!)) (error "cw-ideal-thm!: not a conjunct" name (dk-goal))))
    name))
(cw-ideal-thm! 'nv-ideal-sub '(FORALL x (IMPLIES (IN x I) (IN x A))))
(cw-ideal-thm! 'nv-ideal-zero '(IN (ZERO K) I))
(cw-ideal-thm! 'nv-ideal-add '(FORALL x (IMPLIES (IN x I) (FORALL y (IMPLIES (IN y I) (IN ((ADD K) x y) I))))))
(cw-ideal-thm! 'nv-ideal-neg '(FORALL x (IMPLIES (IN x I) (IN ((NEG K) x) I))))
(cw-ideal-thm! 'nv-ideal-mul '(FORALL r (IMPLIES (IN r A) (FORALL x (IMPLIES (IN x I) (IN ((MUL K) r x) I))))))

(sp (make-wff '(FORALL K (FORALL A (FORALL x (IMPLIES (IN x (NV-MAXIMAL K A)) (IN x A)))))))
(dk-peel!)
(cw-open-sep! 'nv-maximal-unfold '(IN x (NV-MAXIMAL K A)))
(dk-ass!)
(qed 'nv-maximal-sub)

(sp (make-wff '(FORALL K (FORALL A (FORALL x (IMPLIES (IN x (NV-MAXIMAL K A)) (< ((FNRM K) x) 1)))))))
(dk-peel!)
(cw-open-sep! 'nv-maximal-unfold '(IN x (NV-MAXIMAL K A)))
(dk-ass!)
(qed 'nv-maximal-norm)

;; X in M(A) in context: X in A, |X| < 1, and the typings of cw-type!
(define (cw-max! x)
  (dk-cite! 'nv-maximal-sub 'K 'A x)
  (dk-cite! 'nv-maximal-norm 'K 'A x)
  (cw-type! x))
;; the goal (IN T (NV-MAXIMAL K A)), T in A in context, NORM-THUNK proves |T| < 1
(define (cw-max-close! norm-thunk)
  (mac 'nv-maximal)
  (in-sep! (lambda () (dk-ass!)) norm-thunk))

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (IN (ZERO K) (NV-MAXIMAL K A)))))))
(dk-peel!)
(dk-cite! 'nv-domain-normed 'K 'A)
(dk-cite! 'nv-domain-zero 'K 'A)
(dk-cite! 'nf-zero-in-carr 'K)
(cw-typek! '(ZERO K))
(dk-cite! 'nf-norm-of-zero 'K)
(cw-max-close! (lambda () (dk-ineq! `(= ,(cw-n '(ZERO K)) 0))))
(qed 'nv-maximal-zero)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (FORALL x (IMPLIES (IN x (NV-MAXIMAL K A))
  (FORALL y (IMPLIES (IN y (NV-MAXIMAL K A)) (IN ((ADD K) x y) (NV-MAXIMAL K A)))))))))))
(dk-peel!)
(dk-cite! 'nv-domain-normed 'K 'A)
(dk-cite! 'nv-domain-field 'K 'A)
(fact 'rr-one-in)
(cw-max! 'x)
(cw-max! 'y)
(dk-cite! 'nv-domain-add 'K 'A 'x 'y)
(dk-cite! 'nf-add-in-carr 'K 'x 'y)
(cw-typek! (cw-add 'x 'y))
(dk-cite! 'nv-ultra 'K 'x 'y)
(dk-cite! 'rr-max-closed (cw-n 'x) (cw-n 'y))
(dk-cite! 'rr-max-lt (cw-n 'x) (cw-n 'y) 1)
(cw-max-close! (lambda () (dk-ineq! `(<= ,(cw-n (cw-add 'x 'y)) (MAX ,(cw-n 'x) ,(cw-n 'y))) `(< (MAX ,(cw-n 'x) ,(cw-n 'y)) 1))))
(qed 'nv-maximal-add)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (FORALL x (IMPLIES (IN x (NV-MAXIMAL K A))
  (IN ((NEG K) x) (NV-MAXIMAL K A)))))))))
(dk-peel!)
(dk-cite! 'nv-domain-normed 'K 'A)
(cw-max! 'x)
(dk-cite! 'nv-domain-neg 'K 'A 'x)
(dk-cite! 'nf-neg-in-carr 'K 'x)
(cw-typek! (cw-neg 'x))
(dk-cite! 'nf-norm-neg 'K 'x)
(cw-max-close! (lambda () (dk-ineq! `(= ,(cw-n (cw-neg 'x)) ,(cw-n 'x)) `(< ,(cw-n 'x) 1))))
(qed 'nv-maximal-neg)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (FORALL r (IMPLIES (IN r A) (FORALL x (IMPLIES (IN x (NV-MAXIMAL K A))
  (IN ((MUL K) r x) (NV-MAXIMAL K A)))))))))))
(dk-peel!)
(dk-cite! 'nv-domain-normed 'K 'A)
(fact 'rr-one-in)
(cw-type! 'r)
(cw-max! 'x)
(dk-cite! 'nv-domain-mul 'K 'A 'r 'x)
(dk-cite! 'nf-mul-in-carr 'K 'r 'x)
(cw-typek! (cw-mul 'r 'x))
(dk-cite! 'nf-norm-mult 'K 'r 'x)
(dk-cite! 'rr-mul-le-right (cw-n 'r) 1 (cw-n 'x))
(dk-cite! 'rr-one-mul (cw-n 'x))
(cw-rr-mul! (cw-n 'r) (cw-n 'x))
(cw-rr-mul! 1 (cw-n 'x))
(cw-max-close! (lambda () (dk-ineq! `(= ,(cw-n (cw-mul 'r 'x)) (* ,(cw-n 'r) ,(cw-n 'x)))
                                    `(<= (* ,(cw-n 'r) ,(cw-n 'x)) (* 1 ,(cw-n 'x)))
                                    `(= (* 1 ,(cw-n 'x)) ,(cw-n 'x))
                                    `(< ,(cw-n 'x) 1))))
(qed 'nv-maximal-mul)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (IS-NV-IDEAL K A (NV-MAXIMAL K A)))))))
(dk-peel!)
(dk-cite! 'nv-maximal-sub 'K 'A)
(dk-cite! 'nv-maximal-zero 'K 'A)
(dk-cite! 'nv-maximal-add 'K 'A)
(dk-cite! 'nv-maximal-neg 'K 'A)
(dk-cite! 'nv-maximal-mul 'K 'A)
(mac 'is-nv-ideal)
(dk-conj-close! (lambda () (if (not (dk-ass!)) (error "nv-maximal-ideal: open conjunct" (dk-goal)))))
(qed 'nv-maximal-ideal)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (NOT (IN (ONE K) (NV-MAXIMAL K A))))))))
(dk-peel!)
(di)
(dk-cite! 'nv-domain-normed 'K 'A)
(dk-cite! 'nf-one-in-carr 'K)
(cw-typek! '(ONE K))
(dk-cite! 'nf-norm-one 'K)
(dk-cite! 'nv-maximal-norm 'K 'A '(ONE K))
(dk-absurd! `(< ,(cw-n '(ONE K)) 1) `(= ,(cw-n '(ONE K)) 1))
(qed 'nv-maximal-proper)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-COMPACT-NV-DOMAIN K A) (FORALL I (IMPLIES (IS-NV-IDEAL K A I)
  (IMPLIES (NOT (IN (ONE K) I)) (FORALL x (IMPLIES (IN x I) (IN x (NV-MAXIMAL K A))))))))))))
(dk-peel!)
(dk-cite! 'nv-compact-domain 'K 'A)
(dk-cite! 'nv-domain-normed 'K 'A)
(dk-cite! 'nv-ideal-sub 'K 'A 'I 'x)
(cw-type! 'x)
(use-em `(= ,(cw-n 'x) 1)
  (lambda ()
    (pbc)
    (dk-cite! 'nv-compact-norm-one-unit 'K 'A 'x)
    (cw-open-sep! 'nv-units-unfold '(IN x (NV-UNITS K A)))
    (let ((y (dk-skolem! (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the inverse"))))
      (cw-type! y)
      (dk-cite! 'nv-ideal-mul 'K 'A 'I y 'x)
      (dk-have! '(IN (ONE K) I)
        (lambda ()
          (subst `(= (ONE K) ,(cw-mul 'x y)))
          (dk-have! `(= ,(cw-mul 'x y) ,(cw-mul y 'x)) (lambda () (cw-crs! (list 'x y))))
          (subst `(= ,(cw-mul 'x y) ,(cw-mul y 'x)))
          (dk-ass!)))
      (ai '(NOT (IN (ONE K) I)))))
  (lambda ()
    (fact 'rr-one-in)
    (dk-have! `(AND (<= ,(cw-n 'x) 1) (NOT (= ,(cw-n 'x) 1))) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (dk-cite! 'rr-le-ne-lt (cw-n 'x) 1)
    (cw-max-close! (lambda () (dk-ass!)))))
(qed 'nv-compact-proper-in-maximal)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-COMPACT-NV-DOMAIN K A)
  (AND (IS-NV-IDEAL K A (NV-MAXIMAL K A))
  (AND (NOT (IN (ONE K) (NV-MAXIMAL K A)))
       (FORALL I (IMPLIES (IS-NV-IDEAL K A I) (IMPLIES (NOT (IN (ONE K) I)) (SUBSET I (NV-MAXIMAL K A))))))))))))
(dk-peel!)
(dk-cite! 'nv-compact-domain 'K 'A)
(dk-cite! 'nv-maximal-ideal 'K 'A)
(dk-cite! 'nv-maximal-proper 'K 'A)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (begin
          (dk-peel!)
          (let ((iv (cadr (dk-goal))))
            (mac 'subset-def)
            (dk-cite! 'nv-compact-proper-in-maximal 'K 'A iv)
            (dk-ass!))))))
(qed 'nv-compact-maximal-unique)

;;; -----------------------------------------------------------------------
;;; 10. Proposition 2.10: in a PID, M(A) has a generator p; in a compact NV domain whose M(A) = (p),
;;; the units act transitively on S(|p|) = {y in A : |y| = |p|}.

(cw-proj-thm! 'IS-NV-PID 'nv-pid-domain '(IS-NV-DOMAIN K A))
(cw-proj-thm! 'IS-NV-PID 'nv-pid-principal
  '(FORALL I (IMPLIES (IS-NV-IDEAL K A I) (FORSOME g (AND (IN g A) (= I (NV-PRINCIPAL K A g)))))))

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-PID K A)
  (FORSOME p (AND (IN p A) (= (NV-MAXIMAL K A) (NV-PRINCIPAL K A p)))))))))
(dk-peel!)
(dk-cite! 'nv-pid-domain 'K 'A)
(dk-cite! 'nv-maximal-ideal 'K 'A)
(dk-cite! 'nv-pid-principal 'K 'A '(NV-MAXIMAL K A))
(dk-ass!)
(qed 'nv-pid-maximal-generator)

(sp (make-wff '(FORALL cra (IMPLIES (IN cra RR) (FORALL crb (IMPLIES (IN crb RR)
  (IMPLIES (< 0 crb) (IMPLIES (= (* cra crb) crb) (= cra 1)))))))))
(dk-peel!)
(fact 'rr-one-in)
(cw-rr-mul! 'cra 'crb)
(cw-rr-mul! 1 'crb)
(dk-cite! 'rr-one-mul 'crb)
(dk-have! '(<= (* cra crb) (* 1 crb)) (lambda () (dk-ineq! '(= (* cra crb) crb) '(= (* 1 crb) crb))))
(dk-cite! 'rr-mul-le-cancel-pos 'cra 'crb 1)
(dk-have! '(<= (* 1 crb) (* cra crb)) (lambda () (dk-ineq! '(= (* cra crb) crb) '(= (* 1 crb) crb))))
(dk-cite! 'rr-mul-le-cancel-pos 1 'crb 'cra)
(dk-ineq! '(<= cra 1) '(<= 1 cra))
(qed 'rr-mul-cancel-right-one)

;; X /= 0 in context (X in CARR K): land 0 < |X|
(define (cw-norm-pos! x)
  (dk-have! `(NOT (= 0 ,(cw-n x)))
    (lambda ()
      (di)
      (dk-have! `(= ,(cw-n x) 0) (lambda () (dk-ineq! `(= 0 ,(cw-n x)))))
      (dk-cite! 'nf-norm-zero-implies 'K x)
      (ai `(NOT (= ,x (ZERO K))))))
  (dk-have! `(AND (<= 0 ,(cw-n x)) (NOT (= 0 ,(cw-n x)))) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
  (dk-cite! 'rr-le-ne-lt 0 (cw-n x)))

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-COMPACT-NV-DOMAIN K A) (FORALL p (IMPLIES (IN p A)
  (IMPLIES (= (NV-MAXIMAL K A) (NV-PRINCIPAL K A p))
    (FORALL y (IMPLIES (IN y A) (IMPLIES (= ((FNRM K) y) ((FNRM K) p))
      (FORSOME u (AND (IN u (NV-UNITS K A)) (= y ((MUL K) u p)))))))))))))))
(dk-peel!)
(dk-cite! 'nv-compact-domain 'K 'A)
(dk-cite! 'nv-domain-normed 'K 'A)
(dk-cite! 'nf-zero-in-carr 'K)
(dk-cite! 'nf-one-in-carr 'K)
(dk-cite! 'nv-one-unit 'K 'A)
(fact 'rr-one-in)
(cw-type! 'p)
(cw-type! 'y)
(dk-cite! 'nv-principal-self 'K 'A 'p)
(dk-have! '(IN p (NV-MAXIMAL K A)) (lambda () (subst '(= (NV-MAXIMAL K A) (NV-PRINCIPAL K A p))) (dk-ass!)))
(dk-cite! 'nv-maximal-norm 'K 'A 'p)
(dk-have! '(IN y (NV-MAXIMAL K A))
  (lambda () (cw-max-close! (lambda () (dk-ineq! `(= ,(cw-n 'y) ,(cw-n 'p)) `(< ,(cw-n 'p) 1))))))
(dk-have! '(IN y (NV-PRINCIPAL K A p)) (lambda () (subst '(= (NV-PRINCIPAL K A p) (NV-MAXIMAL K A))) (dk-ass!)))
(let ((m (cw-principal-witness! 'y 'p)))
  (cw-type! m)
  (use-em '(= p (ZERO K))
    (lambda ()
      (dk-cite! 'nf-norm-of-zero 'K)
      (dk-have! `(= ,(cw-n 'p) 0) (lambda () (subst '(= p (ZERO K))) (dk-ass!)))
      (dk-have! `(= ,(cw-n 'y) 0) (lambda () (dk-ineq! `(= ,(cw-n 'y) ,(cw-n 'p)) `(= ,(cw-n 'p) 0))))
      (dk-cite! 'nf-norm-zero-implies 'K 'y)
      (ew '(ONE K))
      (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst '(= y (ZERO K))) (subst '(= p (ZERO K))) (cw-crs! '()))))))
    (lambda ()
      (cw-norm-pos! 'p)
      (dk-cite! 'nf-mul-in-carr 'K m 'p)
      (dk-cite! 'nf-norm-mult 'K m 'p)
      (cw-rr-mul! (cw-n m) (cw-n 'p))
      (dk-have! `(= (* ,(cw-n m) ,(cw-n 'p)) ,(cw-n 'p))
        (lambda () (subst `(= (* ,(cw-n m) ,(cw-n 'p)) ,(cw-n (cw-mul m 'p))))
                   (subst `(= ,(cw-mul m 'p) y))
                   (dk-ass!)))
      (dk-cite! 'rr-mul-cancel-right-one (cw-n m) (cw-n 'p))
      (dk-cite! 'nv-compact-norm-one-unit 'K 'A m)
      (ew m)
      (dk-conj-close! (lambda () (dk-ass!))))))
(qed 'nv-compact-units-transitive)

;;; -----------------------------------------------------------------------
;;; 11. The ideal (g, h) generated by two elements.

;; with (IN X (NV-IDEAL2 K A G H)) in context: land X in A, m, n in A, X = m G + n H; return (m n)
(define (cw-ideal2-open! x g h)
  (let* ((landed (cw-open-sep! 'nv-ideal2-unfold `(IN ,x (NV-IDEAL2 K A ,g ,h))))
         (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) landed))
         (m (if ex (dk-skolem! ex) (error "cw-ideal2-open!: no existential" x)))
         (n (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f m))) "the second coefficient"))))
    (list m n)))
;; the goal (IN X (NV-IDEAL2 K A G H)), X, M, N in A in context; EQ-THUNK proves X = M G + N H
(define (cw-ideal2-close! m n eq-thunk)
  (mac 'nv-ideal2)
  (in-sep! (lambda () (dk-ass!))
    (lambda ()
      (ew m)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (begin (ew n) (dk-conj-close! (lambda () (if (not (dk-ass!)) (eq-thunk)))))))))))

(sp (make-wff '(FORALL K (FORALL A (FORALL g (FORALL h (FORALL x (IMPLIES (IN x (NV-IDEAL2 K A g h)) (IN x A)))))))))
(dk-peel!)
(cw-open-sep! 'nv-ideal2-unfold '(IN x (NV-IDEAL2 K A g h)))
(dk-ass!)
(qed 'nv-ideal2-sub)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (FORALL g (IMPLIES (IN g A) (FORALL h (IMPLIES (IN h A)
  (IN (ZERO K) (NV-IDEAL2 K A g h)))))))))))
(dk-peel!)
(dk-cite! 'nv-domain-normed 'K 'A)
(dk-cite! 'nv-domain-zero 'K 'A)
(cw-type! 'g)
(cw-type! 'h)
(cw-ideal2-close! '(ZERO K) '(ZERO K) (lambda () (cw-crs! '(g h))))
(qed 'nv-ideal2-zero)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (FORALL g (IMPLIES (IN g A) (FORALL h (IMPLIES (IN h A)
  (FORALL x (IMPLIES (IN x (NV-IDEAL2 K A g h)) (FORALL y (IMPLIES (IN y (NV-IDEAL2 K A g h))
    (IN ((ADD K) x y) (NV-IDEAL2 K A g h)))))))))))))))
(dk-peel!)
(dk-cite! 'nv-domain-normed 'K 'A)
(cw-type! 'g)
(cw-type! 'h)
(let* ((p1 (cw-ideal2-open! 'x 'g 'h)) (p2 (cw-ideal2-open! 'y 'g 'h))
       (m1 (car p1)) (n1 (cadr p1)) (m2 (car p2)) (n2 (cadr p2)))
  (for-each cw-type! (list m1 n1 m2 n2))
  (dk-cite! 'nv-domain-add 'K 'A 'x 'y)
  (dk-cite! 'nv-domain-add 'K 'A m1 m2)
  (dk-cite! 'nv-domain-add 'K 'A n1 n2)
  (cw-ideal2-close! (cw-add m1 m2) (cw-add n1 n2)
    (lambda ()
      (subst `(= x ,(cw-add (cw-mul m1 'g) (cw-mul n1 'h))))
      (subst `(= y ,(cw-add (cw-mul m2 'g) (cw-mul n2 'h))))
      (cw-crs! (list m1 n1 m2 n2 'g 'h)))))
(qed 'nv-ideal2-add)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (FORALL g (IMPLIES (IN g A) (FORALL h (IMPLIES (IN h A)
  (FORALL x (IMPLIES (IN x (NV-IDEAL2 K A g h)) (IN ((NEG K) x) (NV-IDEAL2 K A g h)))))))))))))
(dk-peel!)
(dk-cite! 'nv-domain-normed 'K 'A)
(cw-type! 'g)
(cw-type! 'h)
(let* ((p1 (cw-ideal2-open! 'x 'g 'h)) (m1 (car p1)) (n1 (cadr p1)))
  (for-each cw-type! (list m1 n1))
  (dk-cite! 'nv-domain-neg 'K 'A 'x)
  (dk-cite! 'nv-domain-neg 'K 'A m1)
  (dk-cite! 'nv-domain-neg 'K 'A n1)
  (cw-ideal2-close! (cw-neg m1) (cw-neg n1)
    (lambda ()
      (subst `(= x ,(cw-add (cw-mul m1 'g) (cw-mul n1 'h))))
      (cw-crs! (list m1 n1 'g 'h)))))
(qed 'nv-ideal2-neg)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (FORALL g (IMPLIES (IN g A) (FORALL h (IMPLIES (IN h A)
  (FORALL r (IMPLIES (IN r A) (FORALL x (IMPLIES (IN x (NV-IDEAL2 K A g h))
    (IN ((MUL K) r x) (NV-IDEAL2 K A g h)))))))))))))))
(dk-peel!)
(dk-cite! 'nv-domain-normed 'K 'A)
(cw-type! 'g)
(cw-type! 'h)
(cw-type! 'r)
(let* ((p1 (cw-ideal2-open! 'x 'g 'h)) (m1 (car p1)) (n1 (cadr p1)))
  (for-each cw-type! (list m1 n1))
  (dk-cite! 'nv-domain-mul 'K 'A 'r 'x)
  (dk-cite! 'nv-domain-mul 'K 'A 'r m1)
  (dk-cite! 'nv-domain-mul 'K 'A 'r n1)
  (cw-ideal2-close! (cw-mul 'r m1) (cw-mul 'r n1)
    (lambda ()
