;; the ring atoms of a term built by ADD / MUL / NEG of K (for cw-crs!'s typings)
(define (cw3-atoms t)
  (cond ((and (pair? t) (member (car t) '((ADD K) (MUL K))) (= (length t) 3)) (append (cw3-atoms (cadr t)) (cw3-atoms (caddr t))))
        ((and (pair? t) (equal? (car t) '(NEG K))) (cw3-atoms (cadr t)))
        ((member t '((ZERO K) (ONE K))) '())
        (#t (list t))))
