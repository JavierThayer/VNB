          (dk-cite! 'nf-norm-one 'K)
          (dk-have! `(= (* ,(cw-n 'x) ,(cw-n y)) 1)
            (lambda () (subst `(= (* ,(cw-n 'x) ,(cw-n y)) ,(cw-n (cw-mul 'x y)))) (subst `(= ,(cw-mul 'x y) (ONE K))) (dk-ass!)))
          (dk-cite! 'rr-mul-le-right 1 (cw-n 'x) (cw-n y))
