(sp (make-wff `(FORALL K (FORALL A (FORALL uw ,(cw-curry cw-47-hyps
  `(FORALL el (IMPLIES (IN el A) (IMPLIES (NOT (= el (ZERO K)))
     (FORSOME ke (AND (IN ke NN) (FORSOME u (AND (IN u (NV-UNITS K A)) (= el ((MUL K) ,(cw-pw 'uw 'ke) u)))))))))))))))
(dk-peel!)
(cw-47-setup!)
(cw-type! 'el)
(cw-norm-pos! 'el)
(let* ((k0 (dk-skolem! (dk-cite! 'rr-power-decay (cw-n 'uw) (cw-n 'el))))
       (tset `(SEP cwt_ NN (NOT (IN el (NV-PRINCIPAL K A ,(cw-pw 'uw 'cwt_))))))
       (pk0 (cw-47-pow! k0)))
  ;; k0 is in T: el in (uw^k0) would give |a| <= |uw|^k0 < |a|
  (dk-have! `(IN ,k0 ,tset)
    (lambda ()
