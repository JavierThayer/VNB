          (dk-absurd! `(<= ,(cw-n 'el) ,(cw-n pk0)) `(= ,(cw-n pk0) (power ,(cw-n 'uw) ,k0)) `(< (power ,(cw-n 'uw) ,k0) ,(cw-n 'el)))))))
  (dk-have! `(SUBSET ,tset NN)
    (lambda () (mac 'subset-def) (di) (let ((z (cadr (dk-goal)))) (sep-me `(IN ,z ,tset)) (dk-ass!))))
  (dk-have! `(FORSOME cwn (IN cwn ,tset)) (lambda () (ew k0) (dk-ass!)))
  (cw-and! `(SUBSET ,tset NN) `(FORSOME cwn (IN cwn ,tset)))
  (let* ((m (dk-skolem! (dk-cite! 'nn-least-element tset)))
         (least (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f tset) (dk-contains? f '<=))) "the least-element law")))
    (dk-have! `(IN ,m NN) (lambda () (sep-me `(IN ,m ,tset)) (dk-ass!)))
