;;; ccr2-nv.scm -- NON-ARCHIMEDEAN VALUED FIELDS AND DOMAINS: CCR.pdf Propositions 1.9, 1.17, 2.4, 2.6,
;;; 2.10, 2.11, 2.12 (and what follows when time allows).  Vocabulary: structure-library/ccr2-vocab.scm.
;;; Agent CCR-B2, wave MAP-1026, 2026-10-26.  Destination: theorem-library/ccr2-nv.scm.  Library: analysis.
;;; Helper prefix cw-.  Variables: K the field, A the domain (never `a' or `k', which fold onto them).
;;;
;;; LOAD WINDOW: after structure-library/ccr2-vocab and the normed-field toolkit (diff-on-laws: nf-*-in-carr,
;;; nf-norm-*, nf-mul-cancel; the ring view normed-field-ring-view-*); compactness (compact-implies-totally-
;;; bounded, compact-subspace-is-closed, totally-bounded-has-cauchy-subsequence) and subspace-ms laws.

(define (cw-keep-prop! . fs)
  (let ((node (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? node)) (prop))))

(define (cw-or-each! o handler)
  (if (not (dk-head-is? o 'OR))
      (handler o)
      (dk-each-leaf! (lambda () (ai o))
        (lambda ()
          (cond ((dk-asm? (cadr o)) (handler (cadr o)))
                ((and (pair? (caddr o)) (eq? (car (caddr o)) 'OR)) (cw-or-each! (caddr o) handler))
                (#t (handler (caddr o))))))))

(define (cw-n x) `((FNRM K) ,x))
(define (cw-add x y) `((ADD K) ,x ,y))
(define (cw-mul x y) `((MUL K) ,x ,y))
(define (cw-neg x) `((NEG K) ,x))
(define cw-view '(NORMED-FIELD-AS-COMMUTATIVE-RING K))

;; land CLAIM, a projection of the predicate hypothesis HYP, keeping HYP
(define (cw-project! pred hyp claim)
  (dk-have! claim
    (lambda ()
      (mac-h pred hyp)
      (if (not (dk-ass!))
          (begin (dk-split-all!)
                 (dk-conj-close! (lambda () (if (not (dk-ass!)) (error "cw-project!: not a projection" claim))))))))
  claim)

;; the goal an identity of K's ring operations over the variables VS (typed in CARR K): `crs' on the view
(define (cw-crs! vs)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
  (for-each (lambda (r) (dk-cite! r 'K))
            '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
              normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one))
  (for-each (lambda (u)
              (dk-have! `(IN ,u (CARR ,cw-view)) (lambda () (subst `(= (CARR ,cw-view) (CARR K))) (dk-ass!))))
            vs)
  (for-each (lambda (op)
              (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,cw-view)))))
            '(ADD MUL NEG))
  (for-each (lambda (op)
              (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,cw-view)))))
            '(ZERO ONE))
  (crs))

;;; -----------------------------------------------------------------------
;;; 1. Normed fields: |1| = 1, inverses; non-archimedean fields.

(sp (make-wff '(FORALL K (IMPLIES (IS-NV-FIELD K) (IS-NORMED-FIELD K)))))
(dk-peel!)
(mac-h 'is-nv-field '(IS-NV-FIELD K))
(dk-split-all!)
(dk-ass!)
(qed 'nv-field-normed)

(sp (make-wff '(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL x (FORALL y (IMPLIES (IN x (CARR K)) (IMPLIES (IN y (CARR K))
  (<= ((FNRM K) ((ADD K) x y)) (MAX ((FNRM K) x) ((FNRM K) y)))))))))))
(dk-peel!)
(mac-h 'is-nv-field '(IS-NV-FIELD K))
(dk-split-all!)
(dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'MAX))) "the ultrametric law") 'x 'y)
(dk-ass!)
(qed 'nv-ultra)

(sp (make-wff '(FORALL K (IMPLIES (IS-NORMED-FIELD K) (NOT (= (ZERO K) (ONE K)))))))
(dk-peel!)
(mac-h 'is-normed-field '(IS-NORMED-FIELD K))
(dk-split-all!)
(dk-ass!)
(qed 'nf-zero-ne-one)

(sp (make-wff '(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL x (IMPLIES (IN x (CARR K)) (IMPLIES (NOT (= x (ZERO K)))
  (FORSOME y (AND (IN y (CARR K)) (AND (NOT (= y (ZERO K))) (= ((MUL K) x y) (ONE K))))))))))))
(dk-peel!)
(mac-h 'is-normed-field '(IS-NORMED-FIELD K))
(dk-split-all!)
(dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'FORSOME) (dk-contains? f 'ONE))) "the inverses") 'x)
(dk-ass!)
(qed 'nf-inverse)

;;; |1| = 1: t = |1| satisfies t = t t and t /= 0.
(sp (make-wff '(FORALL K (IMPLIES (IS-NORMED-FIELD K) (= ((FNRM K) (ONE K)) 1)))))
(dk-peel!)
(let ((t1 (cw-n '(ONE K))))
  (fact 'nf-one-in-carr 'K)
  (fact 'nf-zero-in-carr 'K)
  (fact 'nf-zero-ne-one 'K)
  (dk-cite! 'nf-norm-in-rr 'K '(ONE K))
  (dk-cite! 'nf-norm-nonneg 'K '(ONE K))
  (dk-cite! 'nf-norm-mult 'K '(ONE K) '(ONE K))
  (dk-have! `(= ,(cw-mul '(ONE K) '(ONE K)) (ONE K)) (lambda () (cw-crs! '())))
  (dk-have! `(= ,t1 (* ,t1 ,t1))
    (lambda () (subst `(= (* ,t1 ,t1) ,(cw-n (cw-mul '(ONE K) '(ONE K)))))
                 (subst `(= ,(cw-mul '(ONE K) '(ONE K)) (ONE K)))
                 (rfl)))
  ;; t /= 0: |1| = 0 would make 1 = 0
  (dk-have! `(NOT (= ,t1 0))
    (lambda ()
      (di)
      (fact 'nf-norm-zero-implies 'K '(ONE K))
      (dk-have! '(= (ZERO K) (ONE K)) (lambda () (subst '(= (ONE K) (ZERO K))) (rfl)))
      (ai '(NOT (= (ZERO K) (ONE K))))))
  (dk-have! `(< 0 ,t1)
    (lambda () (fact 'rr-le-ne-lt 0 t1)
               (dk-have! `(NOT (= 0 ,t1)) (lambda () (di) (dk-have! `(= ,t1 0) (lambda () (subst `(= ,t1 0)) (rfl))) (ai `(NOT (= ,t1 0)))))
               (dk-have! `(AND (<= 0 ,t1) (NOT (= 0 ,t1))) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
               (fact 'rr-le-ne-lt 0 t1)
               (dk-ass!)))
  (fact 'rr-one-in)
  (dk-have! `(<= (* ,t1 ,t1) (* 1 ,t1)) (lambda () (subst `(= (* ,t1 ,t1) ,t1)) (dk-ineq!)))
  (fact 'rr-mul-le-cancel-pos t1 t1 1)
  (dk-have! `(<= (* 1 ,t1) (* ,t1 ,t1)) (lambda () (subst `(= (* ,t1 ,t1) ,t1)) (dk-ineq!)))
  (fact 'rr-mul-le-cancel-pos 1 t1 t1)
  (dk-ineq! `(<= ,t1 1) `(<= 1 ,t1)))
(qed 'nf-norm-one)

;;; -----------------------------------------------------------------------
;;; 2. A real lemma: a, b in [0, 1] with a b = 1 give a = 1.
(sp (make-wff '(FORALL cra (IMPLIES (IN cra RR) (FORALL crb (IMPLIES (IN crb RR)
  (IMPLIES (<= 0 cra) (IMPLIES (<= cra 1) (IMPLIES (<= 0 crb) (IMPLIES (<= crb 1)
    (IMPLIES (= (* cra crb) 1) (= cra 1))))))))))))
(dk-peel!)
(fact 'rr-one-in)
(dk-have! '(AND (IN crb RR) (IN cra RR)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
(dk-cite! 'rr-mul-closed 'crb 'cra)
(dk-have! '(AND (IN cra RR) (IN crb RR)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
(dk-cite! 'rr-mul-closed 'cra 'crb)
(dk-cite! 'rr-mul-le-right 'crb 1 'cra)
(dk-have! '(= (* crb cra) (* cra crb)) (lambda () (crs)))
(dk-cite! 'rr-one-mul 'cra)
(dk-ineq! '(<= (* crb cra) (* 1 cra)) '(= (* crb cra) (* cra crb)) '(= (* 1 cra) cra) '(= (* cra crb) 1) '(<= cra 1))
(qed 'rr-unit-interval-prod-one)

;;; -----------------------------------------------------------------------
;;; 3. The projections of IS-NV-DOMAIN.
(define (cw-proj-thm! pred name concl)
  (dk-sp-qed! (make-wff `(FORALL K (FORALL A (IMPLIES (,pred K A) ,concl))))
    (lambda ()
      (di) (di)
      (mac-h pred `(,pred K A))
      (dk-split-all!)
      (if (not (dk-ass!)) (error "cw-proj-thm!: not a conjunct" name (dk-goal))))
    name))
(define (cw-dom-thm! name concl) (cw-proj-thm! 'IS-NV-DOMAIN name concl))

(cw-dom-thm! 'nv-domain-field '(IS-NV-FIELD K))
(cw-dom-thm! 'nv-domain-sub '(FORALL x (IMPLIES (IN x A) (IN x (CARR K)))))
(cw-dom-thm! 'nv-domain-zero '(IN (ZERO K) A))
(cw-dom-thm! 'nv-domain-one '(IN (ONE K) A))
(cw-dom-thm! 'nv-domain-add '(FORALL x (IMPLIES (IN x A) (FORALL y (IMPLIES (IN y A) (IN ((ADD K) x y) A))))))
(cw-dom-thm! 'nv-domain-mul '(FORALL x (IMPLIES (IN x A) (FORALL y (IMPLIES (IN y A) (IN ((MUL K) x y) A))))))
(cw-dom-thm! 'nv-domain-neg '(FORALL x (IMPLIES (IN x A) (IN ((NEG K) x) A))))
(cw-dom-thm! 'nv-domain-norm '(FORALL x (IMPLIES (IN x A) (<= ((FNRM K) x) 1))))

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (IS-NORMED-FIELD K))))))
(dk-peel!)
(dk-cite! 'nv-domain-field 'K 'A)
(dk-cite! 'nv-field-normed 'K)
(dk-ass!)
(qed 'nv-domain-normed)

;; X in CARR K: |X| in RR, 0 <= |X|
(define (cw-typek! x)
  (dk-cite! 'nf-norm-in-rr 'K x)
  (dk-cite! 'nf-norm-nonneg 'K x))
;; X in A: also X in CARR K and |X| <= 1
(define (cw-type! x)
  (dk-cite! 'nv-domain-sub 'K 'A x)
  (dk-cite! 'nv-domain-norm 'K 'A x)
  (cw-typek! x))
;; (* P Q) in RR for P, Q in RR
(define (cw-rr-mul! p q)
  (dk-have! `(AND (IN ,p RR) (IN ,q RR)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
  (dk-cite! 'rr-mul-closed p q))
;; open (IN T (SEP ...)) obtained by unfolding the functoid NAME in hypothesis H; return what landed
(define (cw-open-sep! name h)
  (let ((s (car (dk-landed (lambda () (mac-h name h))))))
    (dk-landed (lambda () (sep-me s)))))

;;; the functoid unfolds, as theorems `mac-h' can name
(sp (make-wff '(FORALL K (== (NV-INTEGERS K) (SEP cwx_ (CARR K) (<= ((FNRM K) cwx_) 1))))))
(di) (mac 'nv-integers) (qrfl)
(qed 'nv-integers-unfold)
(sp (make-wff '(FORALL K (FORALL A (== (NV-UNITS K A)
  (SEP cwx_ A (FORSOME cwy_ (AND (IN cwy_ A) (= ((MUL K) cwx_ cwy_) (ONE K))))))))))
(di) (mac 'nv-units) (qrfl)
(qed 'nv-units-unfold)
(sp (make-wff '(FORALL K (FORALL A (== (NV-MAXIMAL K A) (SEP cwx_ A (< ((FNRM K) cwx_) 1)))))))
(di) (mac 'nv-maximal) (qrfl)
(qed 'nv-maximal-unfold)
(sp (make-wff '(FORALL K (FORALL A (FORALL g (== (NV-PRINCIPAL K A g)
  (SEP cwx_ A (FORSOME cwm_ (AND (IN cwm_ A) (= cwx_ ((MUL K) cwm_ g)))))))))))
(di) (mac 'nv-principal) (qrfl)
(qed 'nv-principal-unfold)
(sp (make-wff '(FORALL K (FORALL A (FORALL g (FORALL h (== (NV-IDEAL2 K A g h)
  (SEP cwx_ A (FORSOME cwm_ (AND (IN cwm_ A) (FORSOME cwn_ (AND (IN cwn_ A)
     (= cwx_ ((ADD K) ((MUL K) cwm_ g) ((MUL K) cwn_ h)))))))))))))))
(di) (mac 'nv-ideal2) (qrfl)
(qed 'nv-ideal2-unfold)
(sp (make-wff '(FORALL K (FORALL A (FORALL r (== (NV-BALL K A r) (SEP cwx_ A (<= ((FNRM K) cwx_) r))))))))
(di) (mac 'nv-ball) (qrfl)
(qed 'nv-ball-unfold)

;;; -----------------------------------------------------------------------
;;; 4. Proposition 1.17.  A is contained in Z(K); with K the field of fractions of A, A = Z(K) iff
;;; |x| <= |y| implies y divides x in A.

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (FORALL x (IMPLIES (IN x A) (IN x (NV-INTEGERS K)))))))))
(dk-peel!)
(dk-cite! 'nv-domain-sub 'K 'A 'x)
(dk-cite! 'nv-domain-norm 'K 'A 'x)
(mac 'nv-integers)
(in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))
(qed 'nv-domain-integral)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (IMPLIES (IS-FRACTIONS-OF K A)
  (IFF (= A (NV-INTEGERS K))
       (FORALL x (IMPLIES (IN x A) (FORALL y (IMPLIES (IN y A)
         (IMPLIES (<= ((FNRM K) x) ((FNRM K) y))
           (FORSOME l (AND (IN l A) (= x ((MUL K) l y))))))))))))))))
(dk-peel!)
(dk-cite! 'nv-domain-normed 'K 'A)
(dk-cite! 'nf-zero-in-carr 'K)
(dk-cite! 'nf-one-in-carr 'K)
(dk-cite! 'nv-domain-zero 'K 'A)
(fact 'rr-one-in)
(dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
  ;; A = Z(K): y /= 0 divides x through x y^-1, which lies in Z(K) = A
  (lambda ()
    (dk-peel!)
    (cw-type! 'x)
    (cw-type! 'y)
    (use-em '(= y (ZERO K))
      (lambda ()
        (dk-cite! 'nf-norm-of-zero 'K)
        (dk-have! `(= ,(cw-n 'y) 0) (lambda () (subst '(= y (ZERO K))) (dk-ass!)))
        (dk-have! `(= ,(cw-n 'x) 0) (lambda () (dk-ineq! `(<= ,(cw-n 'x) ,(cw-n 'y)) `(= ,(cw-n 'y) 0) `(<= 0 ,(cw-n 'x)))))
        (dk-cite! 'nf-norm-zero-implies 'K 'x)
        (ew '(ZERO K))
        (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst '(= x (ZERO K))) (cw-crs! '(y)))))))
      (lambda ()
        (let* ((z (dk-skolem! (dk-cite! 'nf-inverse 'K 'y)))
               (l (cw-mul 'x z)))
          (cw-typek! z)
          (dk-cite! 'nf-mul-in-carr 'K 'x z)
          (cw-typek! l)
          (dk-cite! 'nf-norm-mult 'K 'x z)
          (dk-cite! 'nf-norm-mult 'K 'y z)
          (dk-cite! 'nf-norm-one 'K)
          (dk-have! `(= (* ,(cw-n 'y) ,(cw-n z)) 1)
            (lambda () (subst `(= (* ,(cw-n 'y) ,(cw-n z)) ,(cw-n (cw-mul 'y z))))
                       (subst `(= ,(cw-mul 'y z) (ONE K)))
                       (dk-ass!)))
          (dk-cite! 'rr-mul-le-right (cw-n 'x) (cw-n 'y) (cw-n z))
          (cw-rr-mul! (cw-n 'x) (cw-n z))
          (cw-rr-mul! (cw-n 'y) (cw-n z))
          (dk-have! `(<= ,(cw-n l) 1)
            (lambda () (dk-ineq! `(= ,(cw-n l) (* ,(cw-n 'x) ,(cw-n z)))
                                 `(<= (* ,(cw-n 'x) ,(cw-n z)) (* ,(cw-n 'y) ,(cw-n z)))
                                 `(= (* ,(cw-n 'y) ,(cw-n z)) 1))))
          (dk-have! `(IN ,l (NV-INTEGERS K)) (lambda () (mac 'nv-integers) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
          (dk-have! `(IN ,l A) (lambda () (subst '(= A (NV-INTEGERS K))) (dk-ass!)))
          (ew l)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (begin
                    (dk-have! `(= ,(cw-mul l 'y) ,(cw-mul 'x (cw-mul 'y z))) (lambda () (cw-crs! (list 'x 'y z))))
                    (subst `(= ,(cw-mul l 'y) ,(cw-mul 'x (cw-mul 'y z))))
                    (subst `(= ,(cw-mul 'y z) (ONE K)))
                    (dk-have! `(= ,(cw-mul 'x '(ONE K)) x) (lambda () (cw-crs! '(x))))
                    (subst `(= ,(cw-mul 'x '(ONE K)) x))
                    (rfl)))))))))
  ;; the divisibility law: x in Z(K) is u / v with u, v in A and |u| <= |v|, so v divides u
  (lambda ()
    (let ((h (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'FORSOME) (dk-contains? f 'FNRM))) "the divisibility law")))
      (dk-have! '(FORALL x (IFF (IN x A) (IN x (NV-INTEGERS K))))
        (lambda ()
          (di)
          (let ((x (cadr (cadr (dk-goal)))))
            (dk-iff! (lambda (g) (dk-contains? g 'NV-INTEGERS))
              (lambda () (dk-cite! 'nv-domain-integral 'K 'A x) (dk-ass!))
              (lambda ()
                (cw-open-sep! 'nv-integers-unfold `(IN ,x (NV-INTEGERS K)))
                (cw-typek! x)
                (mac-h 'is-fractions-of '(IS-FRACTIONS-OF K A))
                (let* ((fr (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'FORSOME) (not (dk-contains? f 'FNRM)))) "the fractions law"))
                       (u (dk-skolem! (dk-apply! fr x)))
                       (v (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f u))) "the denominator"))))
                  (cw-type! u)
                  (cw-type! v)
                  (dk-cite! 'nf-norm-mult 'K x v)
                  (dk-cite! 'nf-mul-in-carr 'K x v)
                  (cw-typek! (cw-mul x v))
                  (dk-cite! 'rr-mul-le-right (cw-n x) 1 (cw-n v))
                  (dk-cite! 'rr-one-mul (cw-n v))
                  (cw-rr-mul! (cw-n x) (cw-n v))
                  (dk-have! `(<= ,(cw-n u) ,(cw-n v))
                    (lambda () (subst `(= ,u ,(cw-mul x v)))
                               (dk-ineq! `(= ,(cw-n (cw-mul x v)) (* ,(cw-n x) ,(cw-n v)))
                                         `(<= (* ,(cw-n x) ,(cw-n v)) (* 1 ,(cw-n v)))
                                         `(= (* 1 ,(cw-n v)) ,(cw-n v)))))
                  (let ((l (dk-skolem! (dk-apply! h u v))))
                    (cw-type! l)
                    (dk-have! `(= ,(cw-mul x v) ,(cw-mul l v)) (lambda () (subst `(= ,(cw-mul x v) ,u)) (dk-ass!)))
                    (dk-cite! 'nf-mul-cancel 'K x l v)
                    (subst `(= ,x ,l))
                    (dk-ass!))))))))
      (fact 'class-extensionality 'A '(NV-INTEGERS K))
      (dk-ass!))))
(qed 'nv-integers-iff-divisibility)

;;; -----------------------------------------------------------------------
;;; 5. Units: a unit of A has absolute value one (Proposition 2.4, the easy half, no compactness);
;;; generators of one principal ideal differ by a unit (Proposition 2.11).

(sp (make-wff '(FORALL cra (IMPLIES (IN cra RR) (FORALL crb (IMPLIES (IN crb RR)
  (IMPLIES (= cra 1) (= (* cra crb) crb))))))))
(dk-peel!)
(subst '(= cra 1))
(dk-cite! 'rr-one-mul 'crb)
(dk-ass!)
(qed 'rr-mul-left-one)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (FORALL x (IMPLIES (IN x (NV-UNITS K A)) (= ((FNRM K) x) 1))))))))
(dk-peel!)
(dk-cite! 'nv-domain-normed 'K 'A)
(cw-open-sep! 'nv-units-unfold '(IN x (NV-UNITS K A)))
(let ((y (dk-skolem! (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the inverse"))))
  (cw-type! 'x)
  (cw-type! y)
  (dk-cite! 'nf-norm-mult 'K 'x y)
  (dk-cite! 'nf-norm-one 'K)
  (dk-have! `(= (* ,(cw-n 'x) ,(cw-n y)) 1)
    (lambda () (subst `(= (* ,(cw-n 'x) ,(cw-n y)) ,(cw-n (cw-mul 'x y))))
               (subst `(= ,(cw-mul 'x y) (ONE K)))
               (dk-ass!)))
  (dk-cite! 'rr-unit-interval-prod-one (cw-n 'x) (cw-n y))
  (dk-ass!))
(qed 'nv-unit-norm)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (FORALL g (IMPLIES (IN g A) (IN g (NV-PRINCIPAL K A g)))))))))
(dk-peel!)
(dk-cite! 'nv-domain-normed 'K 'A)
(cw-type! 'g)
(dk-cite! 'nv-domain-one 'K 'A)
(mac 'nv-principal)
(in-sep! (lambda () (dk-ass!))
  (lambda () (ew '(ONE K)) (dk-conj-close! (lambda () (if (not (dk-ass!)) (cw-crs! '(g)))))))
(qed 'nv-principal-self)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (IN (ONE K) (NV-UNITS K A)))))))
(dk-peel!)
(dk-cite! 'nv-domain-normed 'K 'A)
(dk-cite! 'nv-domain-one 'K 'A)
(dk-cite! 'nf-one-in-carr 'K)
(mac 'nv-units)
(in-sep! (lambda () (dk-ass!))
  (lambda () (ew '(ONE K)) (dk-conj-close! (lambda () (if (not (dk-ass!)) (cw-crs! '()))))))
(qed 'nv-one-unit)

;; with (IN TM (NV-PRINCIPAL K A GEN)) in context: land m in A, TM = m GEN; return m
(define (cw-principal-witness! tm gen)
  (let* ((landed (cw-open-sep! 'nv-principal-unfold `(IN ,tm (NV-PRINCIPAL K A ,gen))))
         (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) landed)))
    (if (not ex) (error "cw-principal-witness!: no existential" tm gen))
    (dk-skolem! ex)))

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (FORALL g (IMPLIES (IN g A) (FORALL h (IMPLIES (IN h A)
  (IMPLIES (= (NV-PRINCIPAL K A g) (NV-PRINCIPAL K A h))
    (FORSOME u (AND (IN u (NV-UNITS K A)) (= g ((MUL K) u h))))))))))))))
