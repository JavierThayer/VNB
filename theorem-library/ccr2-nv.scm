                    (subst `(= ,(cw-mul 'x z) (ONE K)))
                    (cw-crs! (list z w))))
                (subst `(= ,zw ,(cw-mul z q)))
                (dk-cite! 'nf-norm-mult 'K z q)
                (subst `(= ,(cw-n (cw-mul z q)) (* ,(cw-n z) ,(cw-n q))))
                (dk-cite! 'rr-mul-left-one (cw-n z) (cw-n q))
                (dk-ass!)))
            (dk-have! `(<= ,(cw-n zw) ,e)
              (lambda () (dk-ineq! `(= ,(cw-n zw) ,(cw-n q)) `(= ,(cw-n pnm) ,(cw-n q)) `(<= ,(cw-n pnm) ,e))))
            (dk-cite! 'nf-metric-distance 'K z w)
            (let ((dd `((DIST ,sm) ,z ,w)) (nzw (cw-n zw)))
              (dk-have! `(IN ,w (BALL ,sm ,z ,r))
                (lambda ()
