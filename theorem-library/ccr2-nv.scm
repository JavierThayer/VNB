;;; 13. Proposition 4.7: with a uniformizing parameter uw (a nonzero generator of M(A)), every nonzero
;;; a in A is uw^k u for a unique k in NN and a unit u.

;; contradictory NN / RR premises close the goal FALSITY
(define (cw-absurd! . prems)
  (dk-have! '(< 0 0) (lambda () (apply dk-nn! prems)))
  (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
  (ai (dk-cite! 'rr-lt-irrefl 0)))
(define (cw-and! . fs)
  (let ((c (let loop ((fs fs)) (if (null? (cdr fs)) (car fs) `(AND ,(car fs) ,(loop (cdr fs)))))))
    (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    c))

;; the powers of a real r < 1 fall below any t > 0
(sp (make-wff '(FORALL cr (IMPLIES (IN cr RR) (FORALL ct (IMPLIES (IN ct RR)
  (IMPLIES (<= 0 cr) (IMPLIES (< cr 1) (IMPLIES (< 0 ct)
    (FORSOME ck (AND (IN ck NN) (< (power cr ck) ct))))))))))))
(dk-peel!)
(fact 'rr-one-in)
(fact 'rr-zero-in)
(dk-cite! 'rr-sub-in-rr 1 'cr)
(let ((om (dk-name! '(- 1 cr))))
  (dk-have! `(< 0 ,om) (lambda () (dk-ineq! `(= ,om (- 1 cr)) '(< cr 1))))
  (cw-rr-mul! om 'ct)
  (let ((c (dk-name! `(* ,om ct))))
    (cw-and! `(IN ,om RR) '(IN ct RR))
    (dk-cite! 'rr-mul-pos om 'ct)
    (dk-have! `(< 0 ,c) (lambda () (dk-ineq! `(= ,c (* ,om ct)) `(< 0 (* ,om ct)))))
    (dk-cite! 'rr-pos-rr-of-lt c)
    (dk-have! '(IN 2 RR) (lambda () (arith)))
    (let ((n (dk-skolem! (dk-cite! 'rr-archimedean-multiple c 2))))
      (dk-cite! 'nn-in-rr n)
      (dk-cite! 'nn-zero-le n)
      (dk-cite! 'power-real-closed 'cr n)
      (let ((rn (dk-name! `(power cr ,n))))
        (cw-rr-mul! n om)
        (let ((s (dk-name! `(* ,n ,om))))
          (dk-have! '(<= cr 1) (lambda () (dk-ineq! '(< cr 1))))
          (cw-and! '(<= 0 cr) '(<= cr 1))
          (dk-cite! 'rr-power-shrink-bound n 'cr)
          (dk-have! `(<= (* ,s ,rn) 1)
            (lambda () (subst `(= ,s (* ,n ,om))) (subst `(= ,om (- 1 cr))) (subst `(= ,rn (power cr ,n))) (dk-ass!)))
          (cw-rr-mul! s 'ct)
          (cw-rr-mul! s rn)
          (cw-rr-mul! n c)
          (dk-have! `(<= 2 (* ,s ct))
            (lambda ()
              (subst `(= ,s (* ,n ,om)))
              (dk-have! `(= (* (* ,n ,om) ct) (* ,n ,c)) (lambda () (subst `(= ,c (* ,om ct))) (crs)))
              (subst `(= (* (* ,n ,om) ct) (* ,n ,c)))
              (dk-ass!)))
          (cw-and! `(IN ,n RR) `(IN ,om RR))
          (dk-have! `(<= 0 ,om) (lambda () (dk-ineq! `(< 0 ,om))))
          (cw-and! `(<= 0 ,n) `(<= 0 ,om))
          (dk-cite! 'rr-leq-mul-nonneg n om)
          (dk-have! `(<= 0 ,s) (lambda () (dk-ineq! `(= ,s (* ,n ,om)) `(<= 0 (* ,n ,om)))))
          (ew n)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (begin
                    (subst `(= (power cr ,n) ,rn))
                    (cw-and! '(IN ct RR) `(IN ,rn RR))
                    (cw-or-each! (dk-cite! 'rr-leq-total 'ct rn)
                      (lambda (o)
                        (if (equal? o `(<= ct ,rn))
                            (begin
                              (pbc)
                              (dk-cite! 'rr-mul-le-right 'ct rn s)
                              (cw-rr-mul! 'ct s) (cw-rr-mul! rn s)
                              (dk-have! `(= (* ct ,s) (* ,s ct)) (lambda () (crs)))
                              (dk-have! `(= (* ,rn ,s) (* ,s ,rn)) (lambda () (crs)))
                              (dk-absurd! `(<= (* ct ,s) (* ,rn ,s)) `(= (* ct ,s) (* ,s ct)) `(= (* ,rn ,s) (* ,s ,rn))
                                          `(<= 2 (* ,s ct)) `(<= (* ,s ,rn) 1)))
                            (begin
                              (dk-have! `(NOT (= ,rn ct))
                                (lambda ()
                                  (di)
                                  (dk-have! `(= (* ,s ,rn) (* ,s ct)) (lambda () (subst `(= ,rn ct)) (rfl)))
                                  (dk-absurd! `(= (* ,s ,rn) (* ,s ct)) `(<= 2 (* ,s ct)) `(<= (* ,s ,rn) 1))))
                              (cw-and! `(<= ,rn ct) `(NOT (= ,rn ct)))
                              (dk-cite! 'rr-le-ne-lt rn 'ct)
                              (dk-ass!))))))))))))))
(qed 'rr-power-decay)

;; |x^n| = |x|^n
(sp (make-wff `(FORALL cwn (IMPLIES (IN cwn NN) (FORALL K (IMPLIES (IS-NORMED-FIELD K)
  (FORALL x (IMPLIES (IN x (CARR K)) (= ((FNRM K) ,(cw-pw 'x 'cwn)) (power ((FNRM K) x) cwn))))))))))
