;;; ---- helper defines copied from mb35-regular.scm ----
(define (mr-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (mr-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (mr-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
(define (mr-iff-parts! iff)
  ;; the conjunct equal to the focus GOAL (if any) is projected LAST: proving it closes the leaf, and a
  ;; projection after that would fire on a sibling (focus drift)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc)))))
         (goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
         (opener (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
         (rest (filter (lambda (c) (not (goal? c))) cs))
         (last (filter goal? cs)))
    (append (mr-map (lambda (c) (mr-project! c opener)) rest)
            (mr-map (lambda (c) (mr-project! c opener)) last))))
(define (mr-and-close! closer)
  (if (dk-head-is? (dk-goal) 'AND)
      (for-each (lambda (k) (dk-focus! k) (mr-and-close! closer)) (dk-opened (lambda () (di))))
      (closer)))
(define (mr-find tag pred lst)
  (or (find-first pred lst) (error "mr-find: nothing matches at" tag (map expression->string lst))))
(define (mr-closed-parts! f) (mr-iff-parts! (dk-cite! 'is-closed 's f)))
(define mrk-sk '(SUBSPACE-MS s k))
(define mrk-kf '(INTERSECTION k f))
(define mrk-skf (list 'SUBSPACE-MS 's mrk-kf))

;;; ---- the moved proofs ----
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'FORALL 'k (list 'IMPLIES '(SUBSET k (PTS s))
  (list 'IMPLIES (list 'IS-COMPACT mrk-sk) (list 'FORALL 'f (list 'IMPLIES '(IS-CLOSED s f) (list 'IS-COMPACT mrk-skf))))))))))
(dk-peel!)
(mr-closed-parts! 'f)
(dk-cite! 'ms-pts-is-set 's)
(dk-cite! 'subclass-of-set-is-set 'k '(PTS s))
(define (mrk-sub-int! side)          ; INTERSECTION k f subset k (side 'k) or f (side 'f)
  (dk-have! (list 'SUBSET mrk-kf side)
    (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (mac-h 'intersection-membership (list 'IN z mrk-kf)) (dk-split-all!) (mr-close-open!)))))
(mrk-sub-int! 'k)
(mrk-sub-int! 'f)
(dk-cite! 'subset-trans mrk-kf 'k '(PTS s))
(dk-cite! 'subclass-of-set-is-set mrk-kf '(PTS s))
(dk-cite! 'subspace-is-metric-space 's 'k)
(dk-cite! 'subspace-is-metric-space 's mrk-kf)
(dk-cite! 'subspace-pts 's 'k)
(dk-cite! 'subspace-pts 's mrk-kf)
(define mrk-iffk (dk-cite! 'compact-iff-seq-compact mrk-sk))
(define mrk-sqk (list 'SEQ-COMPACT mrk-sk))
(dk-have! mrk-sqk (lambda () (ai mrk-iffk) (detach! (list 'IMPLIES (cadr mrk-iffk) (caddr mrk-iffk))) (dk-split-all!) (mr-close-open!)))
(define mrk-sqparts (mr-iff-parts! (dk-cite! 'seq-compact mrk-sk)))
(define mrk-sqcl (dk-rewrite-h! (cadr mrk-sqparts) (list 'PTS mrk-sk) 'k))
(define mrk-ifff (dk-cite! 'compact-iff-seq-compact mrk-skf))
(dk-have! (list 'SEQ-COMPACT mrk-skf)
  (lambda ()
    (mac 'seq-compact)
    (mac 'subspace-pts)
    (mr-and-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
            (let* ((lk (dk-peel!))
                   (g (cadr (mr-find 70 (lambda (x) (dk-head-is? x 'IN)) lk))))
              (dk-cite! 'fun-codomain-superset g 'NN mrk-kf 'k)
              (let* ((phi (dk-skolem! (dk-apply! mrk-sqcl g)))
                     (_0 (dk-split-all!))
                     (l (dk-skolem! (mr-find 71 (lambda (x) (and (dk-head-is? x 'FORSOME) (dk-contains? x 'CONVERGES-TO))) (dk-asms))))
                     (_1 (dk-split-all!))
                     (sg (list 'SUBSEQ g phi)))
                (dk-cite! 'subseq-fun-typing g mrk-kf phi)
                (dk-cite! 'subseq-fun-typing g 'k phi)
                (dk-cite! 'fun-codomain-superset sg 'NN mrk-kf 'f)
                (mr-iff-parts! (dk-cite! 'subspace-converges-to 's 'k sg l))
                (dk-cite! 'closed-limit-in 's 'f sg l)
                (dk-have! (list 'IN l mrk-kf) (lambda () (mac 'intersection-membership) (dk-conj-close! (lambda () (ass)))))
                (let ((ic (dk-cite! 'subspace-converges-to 's mrk-kf sg l)))
                  (ai ic)
                  (detach! (list 'IMPLIES (caddr ic) (cadr ic))))
                (ew phi)
                (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew l) (dk-conj-close! (lambda () (ass))))))))))))))
(ai mrk-ifff)
(detach! (list 'IMPLIES (caddr mrk-ifff) (cadr mrk-ifff)))
(mr-close-open!)
(qed 'compact-inter-closed)
(topic! 'compact-inter-closed 'analysis)

