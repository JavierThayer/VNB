;;; rake-asm-b5.scm -- RAKE-ASM-B, agent RB-5 (2026-10-12).  Helper prefix `rb5-'.
;;;
;;; TWO TARGET GROUPS.
;;;
;;; (b) THE INJECTION COUNT (structure-library/injection.scm).
;;;   injection-count-falling   PROVEN here under its own name, statement copied literally.
;;;   permutation-recurrence    PROVEN here under its own name, statement copied literally.
;;;   injection-extension-recurrence  NOT PROVABLE AS STATED: it has no (IN b SET) guard,
;;;     and for b a proper class PAIR(b, b) = {b} denotes nothing (the list / pair doctrine
;;;     of 2026-10-01: "{SET} denotes nothing"), so the left side denotes nothing and the
;;;     strict `=' is false.  Counterexample: b = SET, A = C = EMPTY-SET, m = 0 -- every
;;;     hypothesis holds.  The guarded statement (the support's antecedent, then
;;;     (IN b SET)) is proven, and since 2026-10-12 (the user's decision) it IS injection-extension-recurrence.
;;;
;;;   THE ROUTE (no SEP over pairs or triples at all).  The bijection
;;;   INJECTION(A u {b}, C) ~ { <g, c> : g in INJECTION(A, C), c in C \ IMAGE(g, A) }
;;;   is replaced by a FIBRE COUNT over the restriction map
;;;       P = (VNB-LAMBDA rbf_ X R(rbf_, A)),   R(f, A) = (VNB-LAMBDA rsx_ A (f rsx_)),
;;;   X = INJECTION(A u {b}, C).  rb5-fibre-count (a set classified by a map into a
;;;   finite set, every fibre of size m, has m |g| points -- finite-set-induction, after
;;;   rake-combinatorics2's fibrewise-finite) does the summing; each fibre over g is the
;;;   image of W = C \ IMAGE(g, A) under c |-> EXT(g, c) = (VNB-LAMBDA rbz_ (A u {b})
;;;   (IF (= rbz_ b) c (g rbz_))) (rb5-fibre-image), an injection (evaluate at b), and
;;;   |W| = m (rb5-complement-card).  |INJECTION(A, C)| is finite by the same fibre
;;;   argument, through fibrewise-finite (rb5-injection-finite).  The pairs never appear.
;;;   R(f, A) is written out rather than cited as RESTRICT: RESTRICT belongs to the
;;;   analysis library (structure-library/metric-subspace.scm) and this is core.
;;;
;;;   Then rb5-count-falling-aux is the induction on m (outermost, for `ni'), and the two
;;;   targets are one citation each (permutation-recurrence through falling-succ-succ).
;;;
;;; (a) THE N-ARY NODES (structure-library/numeric-instances.scm).  None of the 14
;;;   unguarded statements is provable; see the report (RAKE-ASM-B5-REPORT.md).  What IS
;;;   provable is their content on CC, and it is proven here: rb5-nary-{plus,times}-N-cc
;;;   (N = 3..5, one `crs' each -- the oracle already reads the flat node as the sum) and
;;;   rb5-nary-{plus,times}-N-list-cc (N = 2..5, REDUCE / FAM-OF-LIST unfolded by their own
;;;   axioms, then `crs').
;;;
;;; LOAD WINDOW: after theorem-library/rake-asm-1 (injection-in-fun, injection-injective,
;;;   injection-set-iff; load.scm line 3490), before theorem-library/pss-topics (line 3668,
;;;   which files injection-extension-recurrence, permutation-recurrence and
;;;   injection-count-falling).  Next-latest citations: rake-asm-2 (falling-succ-succ, 2275), rake-finsum-typing-nn (falling-in-nn,
;;;   nn-minus-in-nn, 2272), rake-combinatorics / rake-combinatorics2 (succ-nn-ord,
;;;   subset-of-empty-is-empty, injection-from-empty, fibrewise-finite, 1362-1364),
;;;   rake-finsum-core (ord-segment-insert, 1309).
;;; LIBRARY: cross-cutting (the n-ary companions are algebra by their heads, the rest core).
;;;   Nothing cited lies outside core except the algebra-headed binplus / bintimes facts.

;;; ===================================================================
;;; PART A.  The n-ary nodes on the number classes.
;;;
;;; rb5-nary-plus-N-cc / rb5-nary-times-N-cc (N = 3, 4, 5): the CC-guarded
;;; content of nary-plus-N / nary-times-N.  `crs' reads the flat (+ x y z) and
;;; binplus as the sum in CC (rule-checkers-oracle.scm, rco--num-poly), so on
;;; typed arguments each is one oracle call.  The UNGUARDED statements in
;;; numeric-instances.scm are not provable: see the report.
;;; ===================================================================

(define (rb5-check! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; rb5: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l)
                    (display ";;   ") (display (expression->string (dk-goal-of l))) (newline))
                  (proof-leaves))
        (error "rb5: proof not complete" name))))

(define (rb5-guard-cc vars body)
  (if (null? vars) body
      (list 'FORALL (car vars)
            (list 'IMPLIES (list 'IN (car vars) 'CC) (rb5-guard-cc (cdr vars) body)))))

(define (rb5-fold op vars)
  (let loop ((acc (list op (car vars) (cadr vars))) (rest (cddr vars)))
    (if (null? rest) acc (loop (list op acc (car rest)) (cdr rest)))))

(define (rb5-nary-cc! name surf bin vars)
  (sp (make-wff (rb5-guard-cc vars (list '= (cons surf vars) (rb5-fold bin vars)))))
  (dk-peel!)
  (crs)
  (rb5-check! name)
  (qed name))

(rb5-nary-cc! 'rb5-nary-plus-3-cc  '+ 'binplus  '(x y z))
(rb5-nary-cc! 'rb5-nary-plus-4-cc  '+ 'binplus  '(w x y z))
(rb5-nary-cc! 'rb5-nary-plus-5-cc  '+ 'binplus  '(v w x y z))
(rb5-nary-cc! 'rb5-nary-times-3-cc '* 'bintimes '(x y z))
(rb5-nary-cc! 'rb5-nary-times-4-cc '* 'bintimes '(w x y z))
(rb5-nary-cc! 'rb5-nary-times-5-cc '* 'bintimes '(v w x y z))
;;; ---- rb5-nary-plus-N-list-cc / rb5-nary-times-N-list-cc (N = 2..5) ------
;;; The CC-guarded content of nary-plus-N-list / nary-times-N-list: REDUCE and
;;; FAM-OF-LIST unfolded by their own axioms (reduce-one, reduce-succ,
;;; fam-of-list-apply, the kernel LENGTH / NTH reductions), then `crs'.

(define (rb5-list-cc! name surf bin vars)
  (let* ((n   (length vars))
         (L   (cons 'LIST vars))
         (F   (list 'FAM-OF-LIST L))
         (red (lambda (k) (list 'REDUCE bin F k))))
    (sp (make-wff (rb5-guard-cc vars (list '= (cons surf vars) (red n)))))
    (dk-peel!)
    (fact 'nn-zero-in)
    ;; F(i) = x_(i+1) for i = 0 .. n-1
    (let loop ((i 0) (xs vars))
      (if (pair? xs)
          (let ((cl (list '= (list F i) (car xs))))
            (dk-have! (list 'IN i 'NN) (lambda () (arith)))
            (dk-have! cl
              (lambda ()
                (dk-have! (list '<= (list 'succ i) (list 'LENGTH L))
                  (lambda () (len-r) (arith)))
                (have! (list 'AND (list 'IN i 'NN) (list '<= (list 'succ i) (list 'LENGTH L))))
                (dk-cite! 'fam-of-list-apply L i)
                (subst (list '= (list F i) (list 'NTH (list 'succ i) L)))
                (dk-have! (list '= (list 'succ i) (+ i 1)) (lambda () (arith)))
                (subst (list '= (list 'succ i) (+ i 1)))
                (let ((nd (proof-state-focus *ps*))) (nth-r) (if (not (sequent-node-grounded? nd)) (rfl)))))
            (loop (+ i 1) (cdr xs)))))
    ;; REDUCE(op, F, k) == op(REDUCE(op, F, k-1), F(k-1)) for k = n .. 2
    (let loop ((k n))
      (if (>= k 2)
          (let* ((km (- k 1))
                 (cl (list '== (red k) (list bin (red km) (list F km)))))
            (dk-have! (list 'IN km 'NN) (lambda () (arith)))
            (dk-have! (list '<= 1 km) (lambda () (arith)))
            (dk-have! cl
              (lambda ()
                (dk-have! (list '= k (list 'succ km)) (lambda () (arith)))
                (subst (list '= k (list 'succ km)))
                (dk-cite! 'reduce-succ bin F km)
                (ass)))
            (loop km))))
    (dk-cite! 'reduce-one bin F)
    ;; rewrite the goal down to the nested binary form
    (let loop ((k n))
      (if (>= k 2)
          (begin
            (subst (list '= (red k) (list bin (red (- k 1)) (list F (- k 1)))))
            (loop (- k 1)))))
    (subst (list '= (red 1) (list F 0)))
    (let loop ((i 0) (xs vars))
      (if (pair? xs)
          (begin (subst (list '= (list F i) (car xs))) (loop (+ i 1) (cdr xs)))))
    (crs)
    (rb5-check! name)
    (qed name)))

(rb5-list-cc! 'rb5-nary-plus-2-list-cc  '+ 'binplus  '(x y))
(rb5-list-cc! 'rb5-nary-plus-3-list-cc  '+ 'binplus  '(x y z))
(rb5-list-cc! 'rb5-nary-plus-4-list-cc  '+ 'binplus  '(w x y z))
(rb5-list-cc! 'rb5-nary-plus-5-list-cc  '+ 'binplus  '(v w x y z))
(rb5-list-cc! 'rb5-nary-times-2-list-cc '* 'bintimes '(x y))
(rb5-list-cc! 'rb5-nary-times-3-list-cc '* 'bintimes '(x y z))
(rb5-list-cc! 'rb5-nary-times-4-list-cc '* 'bintimes '(w x y z))
(rb5-list-cc! 'rb5-nary-times-5-list-cc '* 'bintimes '(v w x y z))
;;; ===================================================================
;;; rb5-fibre-count: a set classified by a map into a FINITE set, every
;;; fibre of size m, has m * |g| elements.  finite-set-induction on the value
;;; set, after rake-combinatorics2's fibrewise-finite (the map is asked only
;;; to land pointwise, which survives passing to a subset).
;;; ===================================================================

(define (rb5-close-all! thunk)
  (for-each (lambda (l) (dk-focus! l) (ass)) (dk-opened thunk)))

(define (rb5-landed-in landed dom)
  (let ((h (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN) (equal? (caddr f) dom))) landed)))
    (if (null? h) (error "rb5-landed-in: nothing landed in" (expression->string dom)))
    (cadr (car h))))

(define (rb5-fib pv T c) (list 'SEP 'rbx_ T (list '= (list pv 'rbx_) c)))

(define (rb5-body pv mv gg)
  (list 'FORALL 't_
    (list 'IMPLIES
      (list 'AND (list 'IN 't_ 'SET)
            (list 'AND
                  (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ 't_) (list 'IN (list pv 'y_) gg)))
                  (list 'FORALL 'c_ (list 'IMPLIES (list 'IN 'c_ gg)
                                          (list '= (list 'CARD (rb5-fib pv 't_ 'c_)) mv)))))
      (list '= (list 'CARD 't_) (list '* mv (list 'CARD gg))))))

(define (rb5-cls pv mv) (list 'COMP 'g_ (rb5-body pv mv 'g_)))

(define (rb5-step-formula cls)
  (list 'FORALL 'bigs_
    (list 'IMPLIES (list 'AND (list 'IN 'bigs_ 'SET)
                         (list 'AND (list 'IN (list 'CARD 'bigs_) 'NN) (list 'IN 'bigs_ cls)))
      (list 'FORALL 'k_
        (list 'IMPLIES (list 'AND (list 'IN 'k_ 'SET) (list 'NOT (list 'IN 'k_ 'bigs_)))
          (list 'IN (list 'UNION 'bigs_ (list 'PAIR 'k_ 'k_)) cls))))))

(define (rb5-h1? tv U)
  (lambda (f) (and (pair? f) (eq? (car f) 'FORALL)
                   (let ((b (caddr f)))
                     (and (pair? b) (eq? (car b) 'IMPLIES)
                          (pair? (cadr b)) (eq? (car (cadr b)) 'IN)
                          (equal? (caddr (cadr b)) tv)
                          (pair? (caddr b)) (eq? (car (caddr b)) 'IN)
                          (equal? (caddr (caddr b)) U))))))

(define (rb5-h2? U)
  (lambda (f) (and (pair? f) (eq? (car f) 'FORALL)
                   (let ((b (caddr f)))
                     (and (pair? b) (eq? (car b) 'IMPLIES)
                          (pair? (cadr b)) (eq? (car (cadr b)) 'IN)
                          (equal? (caddr (cadr b)) U)
                          (pair? (caddr b)) (eq? (car (caddr b)) '=)
                          (pair? (cadr (caddr b))) (eq? (car (cadr (caddr b))) 'CARD))))))

;; (IN c0 (PAIR c0 c0)) and (IN c0 (UNION G (PAIR c0 c0)))
(define (rb5-union-right! G c0)
  (let* ((pk (list 'PAIR c0 c0))
         (U  (list 'UNION G pk)))
    (dk-have! (list 'IN c0 pk)
      (lambda ()
        (have! (list 'AND (list 'IN c0 'SET) (list 'IN c0 'SET)))
        (fact 'pairing-membership c0 c0)
        (inst*! (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL)
                                          (pair? (caddr f)) (eq? (car (caddr f)) 'IFF)
                                          (equal? (caddr (cadr (caddr f))) pk)))
                         "the pairing universal")
                c0)
        (have! (list '= c0 c0) (lambda () (rfl)))
        (dk-only! (iff-for (list 'IN c0 pk)) (list '= c0 c0))
        (prop)))
    (dk-have! (list 'IN c0 U)
      (lambda ()
        (fact 'union-membership G pk c0)
        (dk-only! (iff-for (list 'IN c0 U)) (list 'IN c0 pk))
        (prop)))))

;; (IN e (UNION G (PAIR c0 c0))) from (IN e G) in context
(define (rb5-union-left! G c0 e)
  (let* ((pk (list 'PAIR c0 c0))
         (U  (list 'UNION G pk)))
    (dk-have! (list 'IN e U)
      (lambda ()
        (fact 'union-membership G pk e)
        (dk-only! (iff-for (list 'IN e U)) (list 'IN e G))
        (prop)))))

(define (rb5-fc-base! pv mv)
  (for-each
   (lambda (leaf)
     (dk-focus! leaf)
     (if (equal? (dk-goal) '(in empty-set set))
         (begin (fact 'empty-set-is-set) (ass))
         (let* ((landed (dk-peel!)))
           (dk-split-all! landed)
           (let* ((tv   (cadr (cadr (dk-goal))))
                  (univ (dk-pick (rb5-h1? tv 'EMPTY-SET) "the values-in-EMPTY-SET universal")))
             (have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ tv) (list 'IN 'z_ 'EMPTY-SET)))
               (lambda ()
                 (let* ((l2 (dk-peel!))
                        (zv (rb5-landed-in l2 tv))
                        (got (dk-apply! univ zv)))
                   (fact 'empty-set-has-no-members (list pv zv))
                   (dk-only! got (list 'NOT got))
                   (prop))))
             (fact 'subset-of-empty-is-empty tv)
             (subst (list '= tv 'EMPTY-SET))
             (fact 'card-empty)
             (subst '(= (CARD EMPTY-SET) 0))
             (crs)))))
   (dk-opened (lambda () (comp-mi)))))

;; the property leaf of the step: t_ arbitrary, values in U = G u {c0}
(define (rb5-fc-inner! pv mv G c0 cls)
  (let* ((pk (list 'PAIR c0 c0))
         (U  (list 'UNION G pk)))
    (dk-split-all! (dk-peel!))
    (let* ((tv (cadr (cadr (dk-goal))))
           (T  (list 'SEP 'rbx_ tv (list 'NOT (list '= (list pv 'rbx_) c0))))
           (K  (rb5-fib pv tv c0))
           (H1 (dk-pick (rb5-h1? tv U) "H1: values land in U"))
           (H2 (dk-pick (rb5-h2? U) "H2: fibres over U have m points")))
      (have! (list 'IN T 'SET) (lambda () (sep-set) (ass)))
      (have! (list 'IN K 'SET) (lambda () (sep-set) (ass)))
      ;; |K| = m
      (rb5-union-right! G c0)
      (dk-apply! H2 c0)
      ;; |T| = m |G|, by the induction hypothesis at G
      (comp-me (list 'IN G cls))
      (let ((H1T (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ T) (list 'IN (list pv 'y_) G))))
            (H2T (list 'FORALL 'c_ (list 'IMPLIES (list 'IN 'c_ G)
                                         (list '= (list 'CARD (rb5-fib pv T 'c_)) mv)))))
        (have! H1T
          (lambda ()
            (let* ((l  (dk-peel!))
                   (yv (rb5-landed-in l T)))
              (sep-me (list 'IN yv T))
              (dk-apply! H1 yv)
              (fact 'union-membership G pk (list pv yv))
              (have! (list 'AND (list 'IN c0 'SET) (list 'IN c0 'SET)))
              (fact 'pairing-membership c0 c0)
              (inst*! (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL)
                                                (pair? (caddr f)) (eq? (car (caddr f)) 'IFF)
                                                (equal? (caddr (cadr (caddr f))) pk)))
                               "the pairing universal")
                      (list pv yv))
              (dk-only! (iff-for (list 'IN (list pv yv) U))
                        (iff-for (list 'IN (list pv yv) pk))
                        (list 'IN (list pv yv) U)
                        (list 'NOT (list '= (list pv yv) c0)))
              (prop))))
        (have! H2T
          (lambda ()
            (let* ((l  (dk-peel!))
                   (cv (rb5-landed-in l G))
                   (S1 (rb5-fib pv T cv))
                   (S2 (rb5-fib pv tv cv)))
              (have! (list 'NOT (list '= cv c0))
                (lambda ()
                  (di)
                  (fact 'eq-sym cv c0)
                  (have! (list 'IN c0 G) (lambda () (subst (list '= c0 cv)) (ass)))
                  (ai (list 'NOT (list 'IN c0 G)))))
              (have! (list '= S1 S2)
                (lambda ()
                  (bc* 'class-extensionality)
                  (dk-peel!)
                  (let* ((wv (cadr (cadr (dk-goal))))
                         (i1 (list 'IMPLIES (list 'IN wv S1) (list 'IN wv S2)))
                         (i2 (list 'IMPLIES (list 'IN wv S2) (list 'IN wv S1))))
                    (have! i1
                      (lambda ()
                        (di)
                        (sep-me (list 'IN wv S1))
                        (sep-me (list 'IN wv T))
                        (rb5-close-all! (lambda () (sep-mi)))))
                    (have! i2
                      (lambda ()
                        (di)
                        (sep-me (list 'IN wv S2))
                        (have! (list 'NOT (list '= (list pv wv) c0))
                          (lambda ()
                            (di)
                            (fact 'eq-sym (list pv wv) cv)
                            (have! (list '= cv c0)
                                   (lambda () (subst (list '= cv (list pv wv))) (ass)))
                            (ai (list 'NOT (list '= cv c0)))))
                        (have! (list 'IN wv T)
                               (lambda () (rb5-close-all! (lambda () (sep-mi)))))
                        (rb5-close-all! (lambda () (sep-mi)))))
                    (dk-only! i1 i2)
                    (prop))))
              (subst (list '= S1 S2))
              (rb5-union-left! G c0 cv)
              (dk-apply! H2 cv)
              (ass))))
        (have! (list 'AND (list 'IN T 'SET) (list 'AND H1T H2T)))
        (dk-apply! (rb5-body pv mv G) T))
      ;; t_ = T u K
      (have! (list '= tv (list 'UNION T K))
        (lambda ()
          (bc* 'class-extensionality)
          (dk-peel!)
          (let* ((wv (cadr (cadr (dk-goal))))
                 (UTK (list 'UNION T K))
                 (i1 (list 'IMPLIES (list 'IN wv tv) (list 'IN wv UTK)))
                 (i2 (list 'IMPLIES (list 'IN wv UTK) (list 'IN wv tv))))
            (have! i1
              (lambda ()
                (di)
                (fact 'union-membership T K wv)
                (let ((iff (iff-for (list 'IN wv UTK)))
                      (a1  (list 'IMPLIES (list '= (list pv wv) c0) (list 'IN wv K)))
                      (a2  (list 'IMPLIES (list 'NOT (list '= (list pv wv) c0)) (list 'IN wv T))))
                  (have! a1 (lambda () (di) (rb5-close-all! (lambda () (sep-mi)))))
                  (have! a2 (lambda () (di) (rb5-close-all! (lambda () (sep-mi)))))
                  (dk-only! iff a1 a2 (list 'IN wv tv))
                  (prop))))
            (have! i2
              (lambda ()
                (di)
                (fact 'union-membership T K wv)
                (let ((iff (iff-for (list 'IN wv UTK)))
                      (a1  (list 'IMPLIES (list 'IN wv T) (list 'IN wv tv)))
                      (a2  (list 'IMPLIES (list 'IN wv K) (list 'IN wv tv))))
                  (have! a1 (lambda () (di) (sep-me (list 'IN wv T)) (ass)))
                  (have! a2 (lambda () (di) (sep-me (list 'IN wv K)) (ass)))
                  (dk-only! iff a1 a2 (list 'IN wv UTK))
                  (prop))))
            (dk-only! i1 i2)
            (prop))))
      ;; T n K = EMPTY-SET
      (have! (list '= (list 'INTERSECTION T K) 'EMPTY-SET)
        (lambda ()
          (bc* 'class-extensionality)
          (dk-peel!)
          (let* ((wv (cadr (cadr (dk-goal))))
                 (TK (list 'INTERSECTION T K))
                 (i1 (list 'NOT (list 'IN wv TK))))
            (have! i1
              (lambda ()
                (di)
                (fact 'intersection-membership T K wv)
                (have! (list 'AND (list 'IN wv T) (list 'IN wv K))
                       (lambda () (dk-only! (iff-for (list 'IN wv TK)) (list 'IN wv TK)) (prop)))
                (dk-split-all!)
                (sep-me (list 'IN wv T))
                (sep-me (list 'IN wv K))
                (dk-only! (list '= (list pv wv) c0) (list 'NOT (list '= (list pv wv) c0)))
                (prop)))
            (fact 'empty-set-has-no-members wv)
            (dk-only! i1 (list 'NOT (list 'IN wv 'EMPTY-SET)))
            (prop))))
      ;; the count
      (let ((mg (list '* mv (list 'CARD G))))
        (have! (list 'AND (list 'IN mv 'NN) (list 'IN (list 'CARD G) 'NN)))
        (fact 'nn-mul-closed mv (list 'CARD G))
        (have! (list 'IN (list 'CARD T) 'NN)
               (lambda () (subst (list '= (list 'CARD T) mg)) (ass)))
        (have! (list 'IN (list 'CARD K) 'NN)
               (lambda () (subst (list '= (list 'CARD K) mv)) (ass)))
        (have! (list 'AND (list 'IN T 'SET) (list 'IN (list 'CARD T) 'NN)))
        (have! (list 'AND (list 'IN K 'SET)
                     (list 'AND (list 'IN (list 'CARD K) 'NN)
                           (list '= (list 'INTERSECTION T K) 'EMPTY-SET))))
        (dk-fact! 'card-union-disjoint T K)
        (have! (list 'AND (list 'IN c0 'SET) (list 'NOT (list 'IN c0 G))))
        (dk-fact! 'card-insert G c0)
        (dk-fact! 'succ-nn-ord (list 'CARD G))
        (dk-fact! 'nn-succ-plus-one (list 'CARD G))
        (subst (list '= tv (list 'UNION T K)))
        (subst (list '= (list 'CARD (list 'UNION T K)) (list '+ (list 'CARD T) (list 'CARD K))))
        (subst (list '= (list 'CARD U) (list 'succ_ORD (list 'CARD G))))
        (subst (list '= (list 'succ_ORD (list 'CARD G)) (list 'succ (list 'CARD G))))
        (subst (list '= (list 'succ (list 'CARD G)) (list '+ (list 'CARD G) 1)))
        (subst (list '= (list 'CARD T) mg))
        (subst (list '= (list 'CARD K) mv))
        (crs)))))

(define (rb5-fc-step! pv mv cls)
  (dk-split-all! (dk-peel!))
  (let* ((g  (dk-goal))
         (U  (cadr g))
         (gs (cadr U))
         (c0 (cadr (caddr U))))
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (if (equal? (dk-goal) (list 'in U 'set))
           (begin (have! (list 'AND (list 'IN c0 'SET) (list 'IN c0 'SET)))
                  (fact 'pairing c0 c0)
                  (have! (list 'AND (list 'IN gs 'SET) (list 'IN (list 'PAIR c0 c0) 'SET)))
                  (fact 'union-set-closure gs (list 'PAIR c0 c0))
                  (ass))
           (rb5-fc-inner! pv mv gs c0 cls)))
     (dk-opened (lambda () (comp-mi))))))

(sp (make-wff
  (list 'FORALL 'p_
    (list 'FORALL 'm_
      (list 'IMPLIES '(IN m_ NN)
        (list 'FORALL 'g_
          (list 'IMPLIES (list 'AND (list 'IN 'g_ 'SET) (list 'IN (list 'CARD 'g_) 'NN))
                (rb5-body 'p_ 'm_ 'g_))))))))
(dk-split-all! (dk-peel!))
(let* ((tv  (cadr (cadr (dk-goal))))
       (gt  (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'IN) (eq? (caddr f) 'NN)
                                      (pair? (cadr f)) (eq? (car (cadr f)) 'CARD)
                                      (not (equal? (cadr (cadr f)) tv))))
                     "the finiteness of g_"))
       (gv  (cadr (cadr gt)))
       (H1  (dk-pick (rb5-h1? tv gv) "H1 of the goal"))
       (pv  (car (cadr (caddr (caddr H1)))))
       (H2  (dk-pick (rb5-h2? gv) "H2 of the goal"))
       (mv  (caddr (caddr (caddr H2))))
       (cls (rb5-cls pv mv))
       (stp (rb5-step-formula cls)))
  (have! (list 'IN 'EMPTY-SET cls) (lambda () (rb5-fc-base! pv mv)))
  (have! stp (lambda () (rb5-fc-step! pv mv cls)))
  (have! (list 'AND (list 'IN 'EMPTY-SET cls) stp))
  (let ((ind (dk-fact! 'finite-set-induction cls)))
    (have! (list 'AND (list 'IN gv 'SET) (list 'IN (list 'CARD gv) 'NN)))
    (let ((ing (dk-apply! ind gv)))
      (comp-me ing)
      (have! (list 'AND (list 'IN tv 'SET) (list 'AND H1 H2)))
      (dk-apply! (rb5-body pv mv gv) tv)
      (ass))))
(rb5-check! 'rb5-fibre-count)
(qed 'rb5-fibre-count)
;;; ===================================================================
;;; THE RESTRICTION of f to A, written out:  R(f, A) = (VNB-LAMBDA rsx_ A (f rsx_)).
;;; (structure-library/metric-subspace.scm's RESTRICT is the same lambda, but
;;; it belongs to the analysis library; this file stays in core.)
;;; rb5-restrict-injection: R(f, A) is an injection when f is one and A is a
;;; subset of its domain.
;;; ===================================================================

;; keep the named formulas, then prop -- unless the keep already closed the leaf
(define (rb5-kp! . fs)
  (let ((n (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? n)) (prop))))

;; ONE beta pass on the focus goal (owed typings the context holds are closed),
;; then rfl unless that closed it.  One pass, not dk-lam-b!'s fixpoint: R(EXT, A)
;; keeps the redex (EXT rsx_) under its own binder, which no pass reduces, and
;; dk-lam-b! errors on it after the outer reduction has been made.
(define (rb5-beta-rfl!)
  (let ((n (proof-state-focus *ps*)))
    (dk--close-owed-typings! (lambda () (lam-b)))
    (if (not (sequent-node-grounded? n)) (rfl))))

(define (rb5-res fv av) (list 'VNB-LAMBDA 'rsx_ av (list fv 'rsx_)))

;; (IN x B) from (SUBSET A B) and (IN x A), both in context.
(define (rb5-sub! A B x)
  (dk-have! (list 'IN x B)
    (lambda ()
      (fact 'subset-def A B)
      (let ((u (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x A) (list 'IN 'x B)))))
        (have! u (lambda () (rb5-kp! (iff-for (list 'SUBSET A B)) (list 'SUBSET A B))))
        (dk-apply! u x)
        (ass)))))

;; (= (R(f, A) x) (f x)), with (IN x D) and (IN f (FUN D C)) in context
(define (rb5-res-val! fv av dv cv x)
  (let ((fx (list fv x)))
    (dk-cite! 'fun-apply-type-c fv dv cv x)
    (dk-cite! 'membership-implies-sethood fx cv)
    (dk-have! (list '= (list (rb5-res fv av) x) fx) (lambda () (rb5-beta-rfl!)))))

(sp (make-wff
  (list 'FORALL 'A (list 'FORALL 'D (list 'FORALL 'C (list 'FORALL 'f
    (list 'IMPLIES '(IN A SET)
      (list 'IMPLIES '(IN f (INJECTION D C))
        (list 'IMPLIES '(SUBSET A D)
          (list 'IN (rb5-res 'f 'A) '(INJECTION A C)))))))))))
(dk-peel!)
(let* ((gl (dk-goal))
       (R  (cadr gl))
       (av (caddr R))
       (fv (car (cadddr R)))
       (cv (caddr (caddr gl)))
       (dv (cadr (caddr (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'IN) (equal? (cadr f) fv)
                                                  (pair? (caddr f)) (eq? (car (caddr f)) 'INJECTION)))
                                 "f in INJECTION(D, C)")))))
  (dk-fact! 'injection-in-fun dv cv fv)
  (dk-have! (list 'IN R (list 'FUN av cv))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (dk-peel!)
          (let ((zv (cadr (cadr (dk-goal)))))
            (rb5-sub! av dv zv)
            (dk-cite! 'fun-apply-type-c fv dv cv zv)
            (ass))))))
  (fact 'injection-membership-iff av cv R)
  (let* ((iff (iff-for (list 'IN R (list 'INJECTION av cv))))
         (inj (caddr (caddr iff))))
    (have! inj
      (lambda ()
        (dk-peel!)
        (let* ((g2 (dk-goal)) (x1 (cadr g2)) (x2 (caddr g2)))
          (rb5-sub! av dv x1)
          (rb5-sub! av dv x2)
          (rb5-res-val! fv av dv cv x1)
          (rb5-res-val! fv av dv cv x2)
          (dk-have! (list '= (list fv x1) (list fv x2))
            (lambda ()
              (subst (list '= (list fv x1) (list R x1)))
              (subst (list '= (list fv x2) (list R x2)))
              (ass)))
          (dk-fact! 'injection-injective dv cv fv)
          (let ((u (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL)
                                             (dk-contains? f dv) (dk-contains? f fv)
                                             (not (dk-contains? f 'INJECTION))
                                             (not (dk-contains? f 'VNB-LAMBDA))))
                            "the injectivity universal of f")))
            (dk-apply! u x1 x2)
            (ass)))))
    (rb5-kp! iff (list 'IN R (list 'FUN av cv)) inj)))
(rb5-check! 'rb5-restrict-injection)
(qed 'rb5-restrict-injection)
;;; ===================================================================
;;; THE EXTENSION of g : A -> C by b |-> v:
;;;   EXT = (VNB-LAMBDA rbz_ (UNION A (PAIR b b)) (IF (= rbz_ b) v (g rbz_)))
;;; ===================================================================

(define (rb5-dom av bv) (list 'UNION av (list 'PAIR bv bv)))
(define (rb5-ext av bv vv gv)
  (list 'VNB-LAMBDA 'rbz_ (rb5-dom av bv) (list 'IF (list '= 'rbz_ bv) vv (list gv 'rbz_))))

;; (IN b (PAIR b b)) and (IN b D), b a set in context
(define (rb5-b-in-dom! av bv)
  (rb5-union-right! av bv))

;; (IN D SET) from A, b sets in context
(define (rb5-dom-set! av bv)
  (dk-have! (list 'IN (rb5-dom av bv) 'SET)
    (lambda ()
      (have! (list 'AND (list 'IN bv 'SET) (list 'IN bv 'SET)))
      (fact 'pairing bv bv)
      (have! (list 'AND (list 'IN av 'SET) (list 'IN (list 'PAIR bv bv) 'SET)))
      (fact 'union-set-closure av (list 'PAIR bv bv))
      (ass))))

;; (IN z A) from (IN z D), (NOT (= z b)), b a set
(define (rb5-in-a! av bv zv)
  (dk-have! (list 'IN zv av)
    (lambda ()
      (let ((pk (list 'PAIR bv bv)))
        (fact 'union-membership av pk zv)
        (have! (list 'IMPLIES (list 'IN zv pk) (list '= zv bv))
               (lambda ()
                 (di)
                 (have! (list 'AND (list 'IN bv 'SET) (list 'IN bv 'SET)))
                 (fact 'pairing-membership bv bv)
                 (inst*! (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL)
                                                   (pair? (caddr f)) (eq? (car (caddr f)) 'IFF)
                                                   (equal? (caddr (cadr (caddr f))) pk)))
                                  "the pairing universal")
                         zv)
                 (rb5-kp! (iff-for (list 'IN zv pk)) (list 'IN zv pk))))
        (rb5-kp! (iff-for (list 'IN zv (rb5-dom av bv))) (list 'IN zv (rb5-dom av bv))
                 (list 'IMPLIES (list 'IN zv pk) (list '= zv bv)) (list 'NOT (list '= zv bv)))))))

;; (NOT (= z b)) from (IN z A), (NOT (IN b A))
(define (rb5-ne-b! av bv zv)
  (dk-have! (list 'NOT (list '= zv bv))
    (lambda ()
      (di)
      (have! (list 'IN bv av) (lambda () (subst (list '= bv zv)) (ass)))
      (ai (list 'NOT (list 'IN bv av))))))

;;; ---- rb5-ext-at-b: EXT(b) = v ----------------------------------------
(sp (make-wff
  (list 'FORALL 'A (list 'FORALL 'C (list 'FORALL 'b (list 'FORALL 'g (list 'FORALL 'rbv_
    (list 'IMPLIES '(IN b SET) (list 'IMPLIES '(IN rbv_ C)
      (list '= (list (rb5-ext 'A 'b 'rbv_ 'g) 'b) 'rbv_))))))))))
(dk-peel!)
(let* ((gl (dk-goal)) (E (car (cadr gl))) (bv (cadr (cadr gl)))
       (av (cadr (caddr E))) (vv (caddr gl))
       (ift (cadddr E)))
  (rb5-b-in-dom! av bv)
  (dk-lam-b!)
  (dk-if-branch! #t (list 'IF (list '= bv bv) vv (list (car (cadddr ift)) bv))
                 (lambda () (rfl))
                 (lambda () (rfl))))
(rb5-check! 'rb5-ext-at-b)
(qed 'rb5-ext-at-b)

;;; ---- rb5-ext-off-b: EXT(z) = g(z) for z in A -------------------------
(sp (make-wff
  (list 'FORALL 'A (list 'FORALL 'C (list 'FORALL 'b (list 'FORALL 'g (list 'FORALL 'rbv_
    (list 'IMPLIES '(IN b SET) (list 'IMPLIES '(NOT (IN b A)) (list 'IMPLIES '(IN g (FUN A C))
      (list 'FORALL 'rbw_ (list 'IMPLIES '(IN rbw_ A)
        (list '= (list (rb5-ext 'A 'b 'rbv_ 'g) 'rbw_) '(g rbw_))))))))))))))
(dk-peel!)
(let* ((gl (dk-goal)) (E (car (cadr gl))) (zv (cadr (cadr gl)))
       (D (caddr E)) (av (cadr D)) (bv (cadr (caddr D)))
       (ift (cadddr E)) (vv (caddr ift)) (gv (car (cadddr ift))))
  (rb5-union-left! av bv zv)
  (rb5-ne-b! av bv zv)
  (let* ((cv  (caddr (caddr (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'IN) (equal? (cadr f) gv)))
                                     "g in FUN(A, C)"))))
         (gz  (list gv zv))
         (ifz (list 'IF (list '= zv bv) vv gz)))
    (dk-fact! 'fun-apply-type-c gv av cv zv)
    (dk-fact! 'membership-implies-sethood gz cv)
    (dk-have! (list '= ifz gz)
      (lambda () (dk-if-branch! #f ifz #f (lambda () (rfl)))))
    (dk-have! (list 'IN ifz 'SET) (lambda () (subst (list '= ifz gz)) (ass)))
    (if (not (dk-lam-b!)) (ass))))
(rb5-check! 'rb5-ext-off-b)
(qed 'rb5-ext-off-b)
;;; ---- rb5-ext-injection: EXT is an injection of A u {b} into C --------
;;; when v lies in C outside the image of the injection g.

;; the context's typing of g: (IN g (INJECTION A C)) -> C
(define (rb5-cod-of gv)
  (caddr (caddr (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'IN) (equal? (cadr f) gv)
                                          (pair? (caddr f)) (eq? (car (caddr f)) 'INJECTION)))
                         "g in INJECTION(A, C)"))))

(sp (make-wff
  (list 'FORALL 'A (list 'FORALL 'C (list 'FORALL 'b (list 'FORALL 'g (list 'FORALL 'rbv_
    (list 'IMPLIES '(IN A SET) (list 'IMPLIES '(IN b SET) (list 'IMPLIES '(NOT (IN b A))
      (list 'IMPLIES '(IN g (INJECTION A C)) (list 'IMPLIES '(IN rbv_ C)
        (list 'IMPLIES '(NOT (IN rbv_ (IMAGE g A)))
          (list 'IN (rb5-ext 'A 'b 'rbv_ 'g) (list 'INJECTION (rb5-dom 'A 'b) 'C)))))))))))))))
(dk-peel!)
(let* ((gl  (dk-goal))
       (E   (cadr gl))
       (D   (caddr E))
       (av  (cadr D)) (bv (cadr (caddr D)))
       (ift (cadddr E)) (vv (caddr ift)) (gv (car (cadddr ift)))
       (cv  (caddr (caddr gl)))
       (img (list 'IMAGE gv av)))
  (dk-fact! 'injection-in-fun av cv gv)
  (rb5-dom-set! av bv)
  ;; EXT in FUN(D, C)
  (dk-have! (list 'IN E (list 'FUN D cv))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (dk-peel!)
          (let* ((g2 (dk-goal)) (ifz (cadr g2)) (zv (cadr (cadr ifz))))
            (use-em (list '= zv bv)
              (lambda () (dk-if-branch! #t ifz #f (lambda () (ass))))
              (lambda ()
                (rb5-in-a! av bv zv)
                (dk-fact! 'fun-apply-type-c gv av cv zv)
                (dk-if-branch! #f ifz #f (lambda () (ass))))))))))
  (fact 'injection-membership-iff D cv E)
  (let* ((iff (iff-for (list 'IN E (list 'INJECTION D cv))))
         (inj (caddr (caddr iff))))
    (have! inj
      (lambda ()
        (dk-peel!)
        (let* ((g2 (dk-goal)) (pv (cadr g2)) (qv (caddr g2))
               (eqE (list '= (list E pv) (list E qv)))
               (at-b (lambda () (dk-fact! 'rb5-ext-at-b av cv bv gv vv)))
               (off-b (lambda (z) (dk-fact! 'rb5-ext-off-b av cv bv gv vv z)))
               ;; bside = b, oth in A: FALSITY from v = g(oth), v outside IMAGE(g, A)
               (clash! (lambda (bside oth)
                 (rb5-in-a! av bv oth)
                 (at-b)
                 (off-b oth)
                 (dk-have! (list '= (list E bside) vv) (lambda () (subst (list '= bside bv)) (ass)))
                 (if (eq? bside qv) (dk-fact! 'eq-sym (list E pv) (list E qv)))
                 (dk-have! (list '= vv (list gv oth))
                   (lambda ()
                     (subst (list '= vv (list E bside)))
                     (subst (list '= (list gv oth) (list E oth)))
                     (ass)))
                 (dk-fact! 'eq-sym vv (list gv oth))
                 (dk-fact! 'membership-implies-sethood vv cv)
                 (fact 'image-membership-iff gv av vv)
                 (let* ((iffv (iff-for (list 'IN vv img)))
                        (ex   (caddr (caddr iffv))))
                   (dk-have! ex
                     (lambda ()
                       (ew oth)
                       (dk-have! (list 'AND (list 'IN oth av) (list '= (list gv oth) vv)))))
                   (dk-have! (list 'IN vv img) (lambda () (rb5-kp! iffv (list 'IN vv 'SET) ex)))
                   (ai (list 'NOT (list 'IN vv img)))))))
          (use-em (list '= pv bv)
            (lambda ()
              (use-em (list '= qv bv)
                (lambda ()
                  (subst (list '= pv bv))
                  (subst (list '= qv bv))
                  (rfl))
                (lambda () (pbc) (clash! pv qv))))
            (lambda ()
              (use-em (list '= qv bv)
                (lambda () (pbc) (clash! qv pv))
                (lambda ()
                  (rb5-in-a! av bv pv)
                  (rb5-in-a! av bv qv)
                  (off-b pv)
                  (off-b qv)
                  (dk-have! (list '= (list gv pv) (list gv qv))
                    (lambda ()
                      (subst (list '= (list gv pv) (list E pv)))
                      (subst (list '= (list gv qv) (list E qv)))
                      (ass)))
                  (dk-fact! 'injection-injective av cv gv)
                  (let ((u (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL)
                                                     (dk-contains? f gv) (dk-contains? f av)
                                                     (not (dk-contains? f 'INJECTION))
                                                     (not (dk-contains? f 'VNB-LAMBDA))))
                                    "the injectivity universal of g")))
                    (dk-apply! u pv qv)
                    (ass)))))))))
    (rb5-kp! iff (list 'IN E (list 'FUN D cv)) inj)))
(rb5-check! 'rb5-ext-injection)
(qed 'rb5-ext-injection)
;;; ---- helpers for the restriction map --------------------------------

;; (SUBSET A D) for D = A u {b}
(define (rb5-subset-dom! av bv)
  (let ((D (rb5-dom av bv)))
    (dk-have! (list 'SUBSET av D)
      (lambda ()
        (fact 'subset-def av D)
        (let ((u (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x av) (list 'IN 'x D)))))
          (have! u (lambda ()
                     (dk-peel!)
                     (rb5-union-left! av bv (cadr (dk-goal)))))
          (rb5-kp! (iff-for (list 'SUBSET av D)) u))))))

;;; ---- rb5-ext-restrict: R(EXT, A) = g -------------------------------
(sp (make-wff
  (list 'FORALL 'A (list 'FORALL 'C (list 'FORALL 'b (list 'FORALL 'g (list 'FORALL 'rbv_
    (list 'IMPLIES '(IN A SET) (list 'IMPLIES '(IN b SET) (list 'IMPLIES '(NOT (IN b A))
      (list 'IMPLIES '(IN g (INJECTION A C)) (list 'IMPLIES '(IN rbv_ C)
        (list 'IMPLIES '(NOT (IN rbv_ (IMAGE g A)))
          (list '= (rb5-res (rb5-ext 'A 'b 'rbv_ 'g) 'A) 'g))))))))))))))
(dk-peel!)
(let* ((gl  (dk-goal))
       (R   (cadr gl))
       (E   (car (cadddr R)))
       (D   (caddr E))
       (av  (cadr D)) (bv (cadr (caddr D)))
       (ift (cadddr E)) (vv (caddr ift)) (gv (caddr gl))
       (cv  (rb5-cod-of gv)))
  (dk-fact! 'injection-in-fun av cv gv)
  (dk-fact! 'rb5-ext-injection av cv bv gv vv)
  (dk-fact! 'injection-in-fun D cv E)
  (rb5-subset-dom! av bv)
  (dk-fact! 'rb5-restrict-injection av D cv E)
  (dk-fact! 'injection-in-fun av cv R)
  (dk-fun-ext! R gv av cv #f #f
    (lambda (zv)
      (let* ((gz  (list gv zv))
             (ifz (list 'IF (list '= zv bv) vv gz)))
        (rb5-union-left! av bv zv)
        (dk-fact! 'rb5-ext-off-b av cv bv gv vv zv)
        (dk-cite! 'fun-apply-type-c gv av cv zv)
        (dk-cite! 'membership-implies-sethood gz cv)
        (dk-have! (list 'IN (list E zv) 'SET) (lambda () (subst (list '= (list E zv) gz)) (ass)))
        (rb5-ne-b! av bv zv)
        (dk-have! (list '= ifz gz) (lambda () (dk-if-branch! #f ifz #f (lambda () (rfl)))))
        (dk-have! (list 'IN ifz 'SET) (lambda () (subst (list '= ifz gz)) (ass)))
        (let ((n (proof-state-focus *ps*)))
          (dk-lam-b!)
          (if (not (sequent-node-grounded? n)) (ass)))))))
(rb5-check! 'rb5-ext-restrict)
(qed 'rb5-ext-restrict)

;;; ---- rb5-free-value: f(b) is in C and outside IMAGE(g, A) when R(f, A) = g --
(sp (make-wff
  (list 'FORALL 'A (list 'FORALL 'C (list 'FORALL 'b (list 'FORALL 'g (list 'FORALL 'f
    (list 'IMPLIES '(IN A SET) (list 'IMPLIES '(IN b SET) (list 'IMPLIES '(NOT (IN b A))
      (list 'IMPLIES (list 'IN 'f (list 'INJECTION (rb5-dom 'A 'b) 'C))
        (list 'IMPLIES (list '= (rb5-res 'f 'A) 'g)
          '(AND (IN (f b) C) (NOT (IN (f b) (IMAGE g A))))))))))))))))
(dk-peel!)
(let* ((gl  (dk-goal))
       (fb  (cadr (cadr gl)))
       (fv  (car fb)) (bv (cadr fb))
       (cv  (caddr (cadr gl)))
       (img (caddr (cadr (caddr gl))))
       (gv  (cadr img)) (av (caddr img))
       (D   (rb5-dom av bv))
       (R   (rb5-res fv av)))
  (dk-fact! 'injection-in-fun D cv fv)
  (rb5-union-right! av bv)
  (dk-fact! 'fun-apply-type-c fv D cv bv)
  (dk-have! (list 'NOT (list 'IN fb img))
    (lambda ()
      (di)
      (fact 'image-membership-iff gv av fb)
      (let* ((iffv (iff-for (list 'IN fb img)))
             (cj   (caddr iffv)))
        (dk-have! cj (lambda () (rb5-kp! iffv (list 'IN fb img))))
        (dk-split-all!)
        (let* ((xv (dk-skolem! (caddr cj))))
          (dk-split-all!)
          (rb5-union-left! av bv xv)
          (rb5-res-val! fv av D cv xv)
          (dk-have! (list '= (list fv xv) fb)
            (lambda ()
              (subst (list '= (list fv xv) (list R xv)))
              (subst (list '= R gv))
              (ass)))
          (dk-fact! 'injection-injective D cv fv)
          (let ((u (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL)
                                             (dk-contains? f fv) (not (dk-contains? f 'INJECTION))
                                             (not (dk-contains? f 'VNB-LAMBDA))))
                            "the injectivity universal of f")))
            (dk-apply! u xv bv))
          (dk-have! (list 'IN bv av) (lambda () (subst (list '= bv xv)) (ass)))
          (ai (list 'NOT (list 'IN bv av)))))))
  (dk-have! gl))
(rb5-check! 'rb5-free-value)
(qed 'rb5-free-value)

;;; ---- rb5-ext-recover: f = EXT(A, b, f(b), g) when R(f, A) = g ---------
(sp (make-wff
  (list 'FORALL 'A (list 'FORALL 'C (list 'FORALL 'b (list 'FORALL 'g (list 'FORALL 'f
    (list 'IMPLIES '(IN A SET) (list 'IMPLIES '(IN b SET) (list 'IMPLIES '(NOT (IN b A))
      (list 'IMPLIES '(IN g (INJECTION A C))
        (list 'IMPLIES (list 'IN 'f (list 'INJECTION (rb5-dom 'A 'b) 'C))
          (list 'IMPLIES (list '= (rb5-res 'f 'A) 'g)
            (list '= 'f (rb5-ext 'A 'b '(f b) 'g)))))))))))))))
(dk-peel!)
(let* ((gl  (dk-goal))
       (fv  (cadr gl))
       (E   (caddr gl))
       (D   (caddr E))
       (av  (cadr D)) (bv (cadr (caddr D)))
       (ift (cadddr E)) (fb (caddr ift)) (gv (car (cadddr ift)))
       (cv  (rb5-cod-of gv))
       (R   (rb5-res fv av)))
  (dk-fact! 'rb5-free-value av cv bv gv fv)
  (dk-split-all!)
  (dk-fact! 'rb5-ext-injection av cv bv gv fb)
  (dk-fact! 'injection-in-fun D cv E)
  (dk-fact! 'injection-in-fun D cv fv)
  (dk-fact! 'injection-in-fun av cv gv)
  (dk-fun-ext! fv E D cv #f #f
    (lambda (zv)
      (use-em (list '= zv bv)
        (lambda ()
          (dk-fact! 'rb5-ext-at-b av cv bv gv fb)
          (subst (list '= zv bv))
          (dk-fact! 'eq-sym (list E bv) fb)
          (ass))
        (lambda ()
          (rb5-in-a! av bv zv)
          (dk-fact! 'rb5-ext-off-b av cv bv gv fb zv)
          (rb5-res-val! fv av D cv zv)
          (subst (list '= (list E zv) (list gv zv)))
          (subst (list '= gv R))
          (subst (list '= (list R zv) (list fv zv)))
          (rfl))))))
(rb5-check! 'rb5-ext-recover)
(qed 'rb5-ext-recover)

;;; ---- rb5-complement-card: |C \ IMAGE(g, A)| = m ----------------------
(sp (make-wff
  '(FORALL A (FORALL C (FORALL g (FORALL m
     (IMPLIES (IN A SET) (IMPLIES (IN C SET) (IMPLIES (IN (CARD A) NN) (IMPLIES (IN m NN)
       (IMPLIES (= (CARD C) (+ (CARD A) m))
         (IMPLIES (IN g (INJECTION A C))
           (= (CARD (DIFFERENCE C (IMAGE g A))) m)))))))))))))
(dk-peel!)
(let* ((gl  (dk-goal))
       (W   (cadr (cadr gl)))
       (mv  (caddr gl))
       (cv  (cadr W))
       (IM  (caddr W))
       (gv  (cadr IM)) (av (caddr IM))
       (ca  (list 'CARD av)) (cc (list 'CARD cv)) (cw (list 'CARD W)) (ci (list 'CARD IM)))
  (dk-fact! 'injection-in-fun av cv gv)
  (have! (list 'AND (list 'IN ca 'NN) (list 'IN mv 'NN)))
  (dk-fact! 'nn-add-closed ca mv)
  (dk-have! (list 'IN cc 'NN) (lambda () (subst (list '= cc (list '+ ca mv))) (ass)))
  (dk-fact! 'image-set gv av)
  (have! (list 'AND (list 'IN gv (list 'INJECTION av cv)) (list 'AND (list 'IN av 'SET) (list 'IN ca 'NN))))
  (dk-fact! 'card-image-injection av cv gv)
  (dk-have! (list 'IN ci 'NN) (lambda () (subst (list '= ci ca)) (ass)))
  (dk-fact! 'image-subset-codomain av cv gv)
  (dk-fact! 'difference-set cv)
  (dk-apply! (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f 'DIFFERENCE)
                                       (dk-contains? f cv) (not (dk-contains? f 'IFF))))
                      "difference-set's universal")
             IM)
  (have! (list 'AND (list 'IN cv 'SET) (list 'IN cc 'NN)))
  (dk-fact! 'card-subset-nn cv)
  (let* ((csu (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (eq? (cadr f) 's)))
                       "card-subset-nn's universal"))
         (zb  (cadr (caddr (cadr (caddr csu)))))
         (subW (list 'FORALL zb (list 'IMPLIES (list 'IN zb W) (list 'IN zb cv)))))
    (have! subW
      (lambda ()
        (dk-peel!)
        (let ((zv (cadr (dk-goal))))
          (fact 'difference-membership cv IM zv)
          (rb5-kp! (iff-for (list 'IN zv W)) (list 'IN zv W)))))
    (have! (list 'AND (list 'IN W 'SET) subW))
    (dk-apply! csu W))
  ;; C = IM u W
  (let ((U (list 'UNION IM W))
        (isub (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f 'IMAGE)
                                        (not (dk-contains? f 'IFF)) (not (dk-contains? f 'DIFFERENCE))))
                       "image-subset-codomain's universal")))
    (have! (list '= cv U)
      (lambda ()
        (bc* 'class-extensionality)
        (dk-peel!)
        (let* ((wv (cadr (cadr (dk-goal))))
               (i1 (list 'IMPLIES (list 'IN wv cv) (list 'IN wv U)))
               (i2 (list 'IMPLIES (list 'IN wv U) (list 'IN wv cv))))
          (have! i1
            (lambda ()
              (di)
              (fact 'union-membership IM W wv)
              (fact 'difference-membership cv IM wv)
              (rb5-kp! (iff-for (list 'IN wv U)) (iff-for (list 'IN wv W)) (list 'IN wv cv))))
          (have! i2
            (lambda ()
              (di)
              (fact 'union-membership IM W wv)
              (fact 'difference-membership cv IM wv)
              (dk-have! (list 'IMPLIES (list 'IN wv IM) (list 'IN wv cv))
                        (lambda () (di) (dk-apply! isub wv) (ass)))
              (rb5-kp! (iff-for (list 'IN wv U)) (iff-for (list 'IN wv W)) (list 'IN wv U)
                       (list 'IMPLIES (list 'IN wv IM) (list 'IN wv cv)))))
          (rb5-kp! i1 i2))))
    (have! (list '= (list 'INTERSECTION IM W) 'EMPTY-SET)
      (lambda ()
        (bc* 'class-extensionality)
        (dk-peel!)
        (let* ((wv (cadr (cadr (dk-goal))))
               (TK (list 'INTERSECTION IM W))
               (i1 (list 'NOT (list 'IN wv TK))))
          (have! i1
            (lambda ()
              (di)
              (fact 'intersection-membership IM W wv)
              (fact 'difference-membership cv IM wv)
              (rb5-kp! (iff-for (list 'IN wv TK)) (iff-for (list 'IN wv W)) (list 'IN wv TK))))
          (fact 'empty-set-has-no-members wv)
          (rb5-kp! i1 (list 'NOT (list 'IN wv 'EMPTY-SET))))))
    (have! (list 'AND (list 'IN IM 'SET) (list 'IN ci 'NN)))
    (have! (list 'AND (list 'IN W 'SET) (list 'AND (list 'IN cw 'NN)
                                              (list '= (list 'INTERSECTION IM W) 'EMPTY-SET))))
    (dk-fact! 'card-union-disjoint IM W)
    (dk-have! (list '= (list '+ ca cw) (list '+ ca mv))
      (lambda ()
        (subst (list '= (list '+ ca mv) cc))
        (subst (list '= ca ci))
        (dk-congr! (list '= cv U) (lambda (t) (list 'CARD t)))
        (subst (list '= cc (list 'CARD U)))
        (dk-fact! 'eq-sym (list 'CARD U) (list '+ ci cw))
        (ass)))
    (have! (list 'AND (list 'IN ca 'NN) (list 'IN cw 'NN)))
    (dk-fact! 'nn-add-comm ca cw)
    (dk-fact! 'nn-add-comm ca mv)
    (dk-have! (list '= (list '+ cw ca) (list '+ mv ca))
      (lambda ()
        (subst (list '= (list '+ cw ca) (list '+ ca cw)))
        (subst (list '= (list '+ mv ca) (list '+ ca mv)))
        (ass)))
    (dk-fact! 'nn-add-cancel cw mv ca)
    (ass)))
(rb5-check! 'rb5-complement-card)
(qed 'rb5-complement-card)
;;; ===================================================================
;;; rb5-fibre-card: the fibre of the restriction map over g has m points.
;;;   X   = INJECTION(A u {b}, C)
;;;   P   = (VNB-LAMBDA rbf_ X R(rbf_, A))             the restriction map
;;;   FIB = (SEP rbx_ X (= (P rbx_) g))
;;;   W   = C \ IMAGE(g, A),   Phi = (VNB-LAMBDA rbc_ W EXT(A, b, rbc_, g))
;;; Phi is an injection of W onto FIB, and |W| = m.
;;; ===================================================================

(define (rb5-X av bv cv) (list 'INJECTION (rb5-dom av bv) cv))
(define (rb5-P av bv cv) (list 'VNB-LAMBDA 'rbf_ (rb5-X av bv cv) (rb5-res 'rbf_ av)))
(define (rb5-phi av bv gv W) (list 'VNB-LAMBDA 'rbc_ W (rb5-ext av bv 'rbc_ gv)))

;; (= (P f) R(f, A)), with f in X in context; lands the typing of R(f, A) too
(define (rb5-p-val! av bv cv fv)
  (let* ((D (rb5-dom av bv)) (P (rb5-P av bv cv)) (R (rb5-res fv av)))
    (rb5-subset-dom! av bv)
    (dk-cite! 'rb5-restrict-injection av D cv fv)
    (dk-cite! 'membership-implies-sethood R (list 'INJECTION av cv))
    (dk-have! (list '= (list P fv) R)
      (lambda () (rb5-beta-rfl!)))))

;; with (IN c W) in context: c in C, c outside IM, EXT_c in X and a set,
;; (= (Phi c) EXT_c).  Returns EXT_c.
(define (rb5-ext-facts! av bv cv gv W c)
  (let* ((IM (list 'IMAGE gv av))
         (E  (rb5-ext av bv c gv))
         (X  (rb5-X av bv cv))
         (Phi (rb5-phi av bv gv W)))
    (fact 'difference-membership cv IM c)
    (dk-have! (list 'AND (list 'IN c cv) (list 'NOT (list 'IN c IM)))
              (lambda () (rb5-kp! (iff-for (list 'IN c W)) (list 'IN c W))))
    (dk-split-all!)
    (dk-fact! 'rb5-ext-injection av cv bv gv c)
    (dk-fact! 'membership-implies-sethood E X)
    (dk-fact! 'injection-in-fun (rb5-dom av bv) cv E)
    (dk-have! (list '= (list Phi c) E)
      (lambda () (rb5-beta-rfl!)))
    E))

;;; ---- rb5-fibre-image: IMAGE(Phi, W) = FIB ------------------------------
(sp (make-wff
  (list 'FORALL 'A (list 'FORALL 'C (list 'FORALL 'b (list 'FORALL 'g
    (list 'IMPLIES '(IN A SET) (list 'IMPLIES '(IN C SET) (list 'IMPLIES '(IN b SET)
      (list 'IMPLIES '(NOT (IN b A))
        (list 'IMPLIES '(IN g (INJECTION A C))
          (list '= (list 'IMAGE (rb5-phi 'A 'b 'g '(DIFFERENCE C (IMAGE g A))) '(DIFFERENCE C (IMAGE g A)))
                   (rb5-fib (rb5-P 'A 'b 'C) (rb5-X 'A 'b 'C) 'g)))))))))))))
(dk-peel!)
(let* ((gl  (dk-goal))
       (IMG (cadr gl))
       (FIB (caddr gl))
       (X   (caddr FIB))
       (cnd (cadddr FIB))
       (P   (car (cadr cnd)))
       (gv  (caddr cnd))
       (D   (cadr X)) (cv (caddr X))
       (av  (cadr D)) (bv (cadr (caddr D)))
       (IM  (list 'IMAGE gv av))
       (W   (list 'DIFFERENCE cv IM))
       (Phi (rb5-phi av bv gv W)))
  (dk-fact! 'injection-in-fun av cv gv)
  (dk-fact! 'difference-set cv)
  (dk-apply! (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f 'DIFFERENCE)
                                       (not (dk-contains? f 'IFF)) (not (dk-contains? f 'IMAGE))))
                      "difference-set's universal")
             IM)
  (rb5-dom-set! av bv)
  (have! (list 'AND (list 'IN D 'SET) (list 'IN cv 'SET)))
  (dk-fact! 'injection-set-iff D cv)
  (rb5-union-right! av bv)
  ;; IMAGE(Phi, W) = FIB
  (dk-have! (list '= IMG FIB)
    (lambda ()
      (bc* 'class-extensionality)
      (dk-peel!)
      (let* ((wv (cadr (cadr (dk-goal))))
             (i1 (list 'IMPLIES (list 'IN wv IMG) (list 'IN wv FIB)))
             (i2 (list 'IMPLIES (list 'IN wv FIB) (list 'IN wv IMG))))
        (have! i1
          (lambda ()
            (di)
            (fact 'image-membership-iff Phi W wv)
            (let* ((iffw (iff-for (list 'IN wv IMG)))
                   (cj   (caddr iffw)))
              (dk-have! cj (lambda () (rb5-kp! iffw (list 'IN wv IMG))))
              (dk-split-all!)
              (let* ((c (dk-skolem! (caddr cj))))
                (dk-split-all!)
                (let ((E (rb5-ext-facts! av bv cv gv W c)))
                  (dk-have! (list '= wv E)
                    (lambda () (subst (list '= wv (list Phi c))) (ass)))
                  (subst (list '= wv E))
                  (for-each
                   (lambda (l)
                     (dk-focus! l)
                     (if (dk-goal-head? '=)
                         (begin
                           (rb5-p-val! av bv cv E)
                           (if (dk-contains? (dk-goal) 'rbf_)
                               (subst (list '= (list P E) (rb5-res E av))))
                           (dk-fact! 'rb5-ext-restrict av cv bv gv c)
                           (ass))
                         (ass)))
                   (dk-opened (lambda () (sep-mi)))))))))
        (have! i2
          (lambda ()
            (di)
            (sep-me (list 'IN wv FIB))
            (rb5-p-val! av bv cv wv)
            (dk-have! (list '= (rb5-res wv av) gv)
              (lambda () (subst (list '= (rb5-res wv av) (list P wv))) (ass)))
            (dk-fact! 'rb5-free-value av cv bv gv wv)
            (dk-split-all!)
            (let ((fb (list wv bv)))
              (fact 'difference-membership cv IM fb)
              (dk-have! (list 'IN fb W)
                (lambda () (rb5-kp! (iff-for (list 'IN fb W)) (list 'IN fb cv) (list 'NOT (list 'IN fb IM)))))
              (dk-fact! 'rb5-ext-recover av cv bv gv wv)
              (let ((E (rb5-ext-facts! av bv cv gv W fb)))
                (dk-fact! 'membership-implies-sethood wv X)
                (dk-fact! 'eq-sym wv E)
                (dk-have! (list '= (list Phi fb) wv)
                  (lambda () (subst (list '= (list Phi fb) E)) (ass)))
                (fact 'image-membership-iff Phi W wv)
                (let* ((iffw (iff-for (list 'IN wv IMG)))
                       (ex   (caddr (caddr iffw))))
                  (dk-have! ex
                    (lambda ()
                      (ew fb)
                      (dk-have! (list 'AND (list 'IN fb W) (list '= (list Phi fb) wv)))))
                  (rb5-kp! iffw (list 'IN wv 'SET) ex))))))
        (rb5-kp! i1 i2)))))
(rb5-check! 'rb5-fibre-image)
(qed 'rb5-fibre-image)

;;; ---- rb5-fibre-card: |FIB| = m -----------------------------------------
(sp (make-wff
  (list 'FORALL 'A (list 'FORALL 'C (list 'FORALL 'b (list 'FORALL 'm (list 'FORALL 'g
    (list 'IMPLIES '(IN A SET) (list 'IMPLIES '(IN C SET) (list 'IMPLIES '(IN b SET)
      (list 'IMPLIES '(NOT (IN b A)) (list 'IMPLIES '(IN (CARD A) NN) (list 'IMPLIES '(IN m NN)
        (list 'IMPLIES '(= (CARD C) (+ (CARD A) m))
          (list 'IMPLIES '(IN g (INJECTION A C))
            (list '= (list 'CARD (rb5-fib (rb5-P 'A 'b 'C) (rb5-X 'A 'b 'C) 'g)) 'm))))))))))))))))
(dk-peel!)
(let* ((gl  (dk-goal))
       (FIB (cadr (cadr gl)))
       (mv  (caddr gl))
       (X   (caddr FIB))
       (cnd (cadddr FIB))
       (P   (car (cadr cnd)))
       (gv  (caddr cnd))
       (D   (cadr X)) (cv (caddr X))
       (av  (cadr D)) (bv (cadr (caddr D)))
       (IM  (list 'IMAGE gv av))
       (W   (list 'DIFFERENCE cv IM))
       (Phi (rb5-phi av bv gv W))
       (IMG (list 'IMAGE Phi W)))
  (dk-fact! 'injection-in-fun av cv gv)
  (dk-fact! 'difference-set cv)
  (dk-apply! (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f 'DIFFERENCE)
                                       (not (dk-contains? f 'IFF)) (not (dk-contains? f 'IMAGE))))
                      "difference-set's universal")
             IM)
  (rb5-dom-set! av bv)
  (have! (list 'AND (list 'IN D 'SET) (list 'IN cv 'SET)))
  (dk-fact! 'injection-set-iff D cv)
  (rb5-union-right! av bv)
  (dk-fact! 'rb5-complement-card av cv gv mv)
  (dk-have! (list 'IN (list 'CARD W) 'NN) (lambda () (subst (list '= (list 'CARD W) mv)) (ass)))
  ;; Phi in FUN(W, X)
  (dk-have! (list 'IN Phi (list 'FUN W X))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (dk-peel!)
          (let* ((c (rb5-landed-in (dk-asms) W)))
            (fact 'difference-membership cv IM c)
            (dk-have! (list 'AND (list 'IN c cv) (list 'NOT (list 'IN c IM)))
                      (lambda () (rb5-kp! (iff-for (list 'IN c W)) (list 'IN c W))))
            (dk-split-all!)
            (dk-fact! 'rb5-ext-injection av cv bv gv c)
            (ass))))))
  ;; Phi injective
  (fact 'injection-membership-iff W X Phi)
  (let* ((iff (iff-for (list 'IN Phi (list 'INJECTION W X))))
         (inj (caddr (caddr iff))))
    (have! inj
      (lambda ()
        (dk-peel!)
        (let* ((g2 (dk-goal)) (c1 (cadr g2)) (c2 (caddr g2))
               (E1 (rb5-ext-facts! av bv cv gv W c1))
               (E2 (rb5-ext-facts! av bv cv gv W c2)))
          (dk-have! (list '= E1 E2)
            (lambda ()
              (subst (list '= E1 (list Phi c1)))
              (subst (list '= E2 (list Phi c2)))
              (ass)))
          (dk-fact! 'rb5-ext-at-b av cv bv gv c1)
          (dk-fact! 'rb5-ext-at-b av cv bv gv c2)
          (subst (list '= c1 (list E1 bv)))
          (subst (list '= c2 (list E2 bv)))
          (subst (list '= E1 E2))
          (rfl))))
    (dk-have! (list 'IN Phi (list 'INJECTION W X))
              (lambda () (rb5-kp! iff (list 'IN Phi (list 'FUN W X)) inj))))
  (have! (list 'AND (list 'IN Phi (list 'INJECTION W X))
               (list 'AND (list 'IN W 'SET) (list 'IN (list 'CARD W) 'NN))))
  (dk-fact! 'card-image-injection W X Phi)
  (dk-fact! 'rb5-fibre-image av cv bv gv)
  (subst (list '= FIB IMG))
  (subst (list '= (list 'CARD IMG) (list 'CARD W)))
  (ass))
(rb5-check! 'rb5-fibre-card)
(qed 'rb5-fibre-card)

;;; ===================================================================
;;; rb5-injection-finite: INJECTION(A, C) is finite for finite A, C.
;;; finite-set-induction on A: INJECTION(A u {k}, C) is classified by the
;;; restriction map into the finite INJECTION(A, C), and each fibre is
;;; IMAGE(Phi, W) (rb5-fibre-image) with W a subset of C -- fibrewise-finite.
;;; ===================================================================

;; W = C \ IM a set and finite, from (IN C SET), (IN (CARD C) NN) in context
(define (rb5-w-finite! cv IM)
  (let* ((W (list 'DIFFERENCE cv IM)) (cc (list 'CARD cv)))
    (dk-cite! 'difference-set cv)
    (dk-apply! (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f 'DIFFERENCE)
                                         (not (dk-contains? f 'IFF)) (not (dk-contains? f IM))
                                         (not (dk-contains? f 'IMPLIES))))
                        "difference-set's universal")
               IM)
    (have! (list 'AND (list 'IN cv 'SET) (list 'IN cc 'NN)))
    (dk-cite! 'card-subset-nn cv)
    (let* ((csu (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (eq? (cadr f) 's)
                                          (dk-contains? f cv)))
                         "card-subset-nn's universal"))
           (zb  (cadr (caddr (cadr (caddr csu)))))
           (subW (list 'FORALL zb (list 'IMPLIES (list 'IN zb W) (list 'IN zb cv)))))
      (have! subW
        (lambda ()
          (dk-peel!)
          (let ((zv (cadr (dk-goal))))
            (fact 'difference-membership cv IM zv)
            (rb5-kp! (iff-for (list 'IN zv W)) (list 'IN zv W)))))
      (have! (list 'AND (list 'IN W 'SET) subW))
      (dk-apply! csu W))))

(sp (make-wff
  '(FORALL A (FORALL C
     (IMPLIES (IN A SET) (IMPLIES (IN (CARD A) NN)
       (IMPLIES (IN C SET) (IMPLIES (IN (CARD C) NN)
         (IN (CARD (INJECTION A C)) NN)))))))))
(dk-peel!)
(let* ((gl  (dk-goal))
       (av  (cadr (cadr (cadr gl))))
       (cv  (caddr (cadr (cadr gl))))
       (cls (list 'COMP 'rbk_ (list 'IN (list 'CARD (list 'INJECTION 'rbk_ cv)) 'NN)))
       (stp (rb5-step-formula cls)))
  (have! (list 'IN 'EMPTY-SET cls)
    (lambda ()
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (equal? (dk-goal) '(in empty-set set))
             (begin (fact 'empty-set-is-set) (ass))
             (begin
               (dk-fact! 'injection-from-empty cv)
               (subst (list '= (list 'CARD (list 'INJECTION 'EMPTY-SET cv)) '(succ 0)))
               (fact 'nn-zero-in)
               (dk-fact! 'nn-succ-closed 0)
               (ass))))
       (dk-opened (lambda () (comp-mi))))))
  (have! stp
    (lambda ()
      (dk-split-all! (dk-peel!))
      (let* ((g  (dk-goal))
             (U  (cadr g))
             (sv (cadr U))
             (kv (cadr (caddr U))))
        (for-each
         (lambda (leaf)
           (dk-focus! leaf)
           (if (equal? (dk-goal) (list 'in U 'set))
               (begin (have! (list 'AND (list 'IN kv 'SET) (list 'IN kv 'SET)))
                      (fact 'pairing kv kv)
                      (have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'PAIR kv kv) 'SET)))
                      (fact 'union-set-closure sv (list 'PAIR kv kv))
                      (ass))
               (let* ((X (rb5-X sv kv cv))
                      (I (list 'INJECTION sv cv))
                      (P (rb5-P sv kv cv))
                      (H1 (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ X) (list 'IN (list P 'y_) I))))
                      (H2 (list 'FORALL 'c_ (list 'IMPLIES (list 'IN 'c_ I)
                                                  (list 'IN (list 'CARD (list 'SEP 'x X (list '= (list P 'x) 'c_))) 'NN)))))
                 (comp-me (list 'IN sv cls))
                 (have! (list 'AND (list 'IN sv 'SET) (list 'IN cv 'SET)))
                 (dk-fact! 'injection-set-iff sv cv)
                 (rb5-dom-set! sv kv)
                 (have! (list 'AND (list 'IN U 'SET) (list 'IN cv 'SET)))
                 (dk-fact! 'injection-set-iff U cv)
                 (have! (list 'AND (list 'IN I 'SET) (list 'IN (list 'CARD I) 'NN)))
                 (dk-fact! 'fibrewise-finite P I)
                 (have! H1
                   (lambda ()
                     (dk-peel!)
                     (let ((yv (rb5-landed-in (dk-asms) X)))
                       (rb5-p-val! sv kv cv yv)
                       (subst (list '= (list P yv) (rb5-res yv sv)))
                       (ass))))
                 (have! H2
                   (lambda ()
                     (dk-peel!)
                     (let* ((gv  (rb5-landed-in (dk-asms) I))
                            (IM  (list 'IMAGE gv sv))
                            (W   (list 'DIFFERENCE cv IM))
                            (Phi (rb5-phi sv kv gv W))
                            (IMG (list 'IMAGE Phi W))
                            (FIB (rb5-fib P X gv)))
                       (dk-fact! 'rb5-fibre-image sv cv kv gv)
                       (rb5-w-finite! cv IM)
                       (dk-fact! 'card-image-finite Phi W)
                       (let ((n (proof-state-focus *ps*)))
                         (dk-have! (list 'IN (list 'CARD FIB) 'NN)
                           (lambda () (subst (list '= FIB IMG)) (ass)))
                         (if (not (sequent-node-grounded? n)) (ass))))))
                 (have! (list 'AND (list 'IN X 'SET) (list 'AND H1 H2)))
                 (let ((n (proof-state-focus *ps*)))
                   (dk-apply! (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (eq? (cadr f) 't_)
                                                        (dk-contains? f I)))
                                       "fibrewise-finite's body at INJECTION(S, C)")
                              X)
                   (if (not (sequent-node-grounded? n)) (ass))))))
         (dk-opened (lambda () (comp-mi)))))))
  (have! (list 'AND (list 'IN 'EMPTY-SET cls) stp))
  (let ((ind (dk-fact! 'finite-set-induction cls)))
    (have! (list 'AND (list 'IN av 'SET) (list 'IN (list 'CARD av) 'NN)))
    (let ((ina (dk-apply! ind av))
          (n   (proof-state-focus *ps*)))
      (comp-me ina)
      (if (not (proof-done? *ps*)) (ass)))))
(rb5-check! 'rb5-injection-finite)
(qed 'rb5-injection-finite)
;;; ===================================================================
;;; injection-extension-recurrence, with the guard (IN b SET) added (the user's decision
;;; 2026-10-12: the guarded statement replaces the false asserted one under the same name).  rb5-fibre-count over the restriction
;;; map P, the fibres counted by rb5-fibre-card, |INJECTION(A, C)| finite by
;;; rb5-injection-finite.
;;; ===================================================================
(sp (make-wff
  '(FORALL A (FORALL C (FORALL b (FORALL m
     (IMPLIES (AND (NOT (IN b A)) (AND (IN A SET) (AND (IN C SET) (AND (IN (CARD A) NN) (AND (IN m NN) (= (CARD C) (+ (CARD A) m)))))))
       (IMPLIES (IN b SET)
         (= (CARD (INJECTION (UNION A (PAIR b b)) C))
            (* m (CARD (INJECTION A C))))))))))))
(dk-peel!)
(dk-split-all!)
(let* ((gl (dk-goal))
       (X  (cadr (cadr gl)))
       (D  (cadr X)) (cv (caddr X))
       (av (cadr D)) (bv (cadr (caddr D)))
       (mv (cadr (caddr gl)))
       (I  (cadr (caddr (caddr gl))))
       (P  (rb5-P av bv cv))
       (ca (list 'CARD av)) (cc (list 'CARD cv)))
  (have! (list 'AND (list 'IN ca 'NN) (list 'IN mv 'NN)))
  (dk-fact! 'nn-add-closed ca mv)
  (dk-have! (list 'IN cc 'NN) (lambda () (subst (list '= cc (list '+ ca mv))) (ass)))
  (have! (list 'AND (list 'IN av 'SET) (list 'IN cv 'SET)))
  (dk-fact! 'injection-set-iff av cv)
  (dk-fact! 'rb5-injection-finite av cv)
  (rb5-dom-set! av bv)
  (have! (list 'AND (list 'IN D 'SET) (list 'IN cv 'SET)))
  (dk-fact! 'injection-set-iff D cv)
  (dk-fact! 'rb5-fibre-count P mv)
  (have! (list 'AND (list 'IN I 'SET) (list 'IN (list 'CARD I) 'NN)))
  (dk-apply! (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (eq? (cadr f) 'g_)))
                      "fibre-count at P, m")
             I)
  (let* ((body (rb5-body P mv I))
         (H1 (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ X) (list 'IN (list P 'y_) I))))
         (H2 (list 'FORALL 'c_ (list 'IMPLIES (list 'IN 'c_ I)
                                     (list '= (list 'CARD (rb5-fib P X 'c_)) mv)))))
    (have! H1
      (lambda ()
        (dk-peel!)
        (let ((yv (rb5-landed-in (dk-asms) X)))
          (rb5-p-val! av bv cv yv)
          (subst (list '= (list P yv) (rb5-res yv av)))
          (ass))))
    (have! H2
      (lambda ()
        (dk-peel!)
        (let ((gv (rb5-landed-in (dk-asms) I)))
          (dk-fact! 'rb5-fibre-card av cv bv mv gv)
          (ass))))
    (have! (list 'AND (list 'IN X 'SET) (list 'AND H1 H2)))
    (dk-apply! (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (eq? (cadr f) 't_)
                                         (dk-contains? f I)))
                        "fibre-count's body at INJECTION(A, C)")
               X)
    (ass)))
(rb5-check! 'injection-extension-recurrence)
(qed 'injection-extension-recurrence)

;;; ===================================================================
;;; rb5-count-falling-aux: |INJECTION(seg m, seg n)| = FALLING(n, m) for
;;; m <= n, by induction on m (outermost, for `ni').
;;; ===================================================================
(sp (make-wff
  '(FORALL m (IMPLIES (IN m NN)
     (FORALL n (IMPLIES (IN n NN)
       (IMPLIES (<= m n)
         (= (CARD (INJECTION (ORD-SEGMENT m) (ORD-SEGMENT n))) (FALLING n m)))))))))
(let* ((br (use-induction))
       (base (cdr (assq 'base br))) (step (cdr (assq 'step br)))
       (ih (cdr (assq 'ih br))) (v (cdr (assq 'var br))))
  (dk-focus! base)
  (dk-peel!)
  (let* ((gl (dk-goal))
         (sn (caddr (cadr (cadr gl))))
         (nv (cadr sn)))
    (dk-fact! 'nn-subset-ord nv)
    (dk-fact! 'ord-segment-is-set nv)
    (fact 'ord-segment-zero)
    (subst '(= (ORD-SEGMENT 0) EMPTY-SET))
    (dk-fact! 'injection-from-empty sn)
    (subst (list '= (list 'CARD (list 'INJECTION 'EMPTY-SET sn)) '(succ 0)))
    (dk-fact! 'falling-zero nv)
    (subst (list '= (list 'FALLING nv 0) '(succ 0)))
    (fact 'nn-zero-in)
    (dk-fact! 'nn-succ-closed 0)
    (rfl))
  (dk-focus! step)
  (dk-peel!)
  (let* ((gl  (dk-goal))
         (sn  (caddr (cadr (cadr gl))))
         (nv  (cadr sn))
         (sv  (list 'succ v))
         (sg  (list 'ORD-SEGMENT v))
         (dif (list '- nv v))
         (nm  (list 'nn-minus nv v)))
    (dk-have! (list '<= v nv) (lambda () (dk-nn! (list '<= sv nv))))
    (dk-apply! ih nv)
    (dk-fact! 'nn-subset-ord nv)
    (dk-fact! 'ord-segment-is-set nv)
    (dk-fact! 'nn-subset-ord v)
    (dk-fact! 'ord-segment-is-set v)
    (dk-fact! 'ord-segment-self v)
    (dk-fact! 'card-segment v)
    (dk-fact! 'card-segment nv)
    (dk-have! (list 'IN (list 'CARD sg) 'NN) (lambda () (subst (list '= (list 'CARD sg) v)) (ass)))
    (dk-fact! 'nn-minus-def nv v)
    (dk-fact! 'nn-minus-in-nn nv v)
    (dk-have! (list '= nm dif)
      (lambda ()
        (let ((ift (list 'IF (list '<= v nv) dif 0)))
          (subst (list '= nm ift))
          (dk-if-branch! #t ift #f (lambda () (rfl))))))
    (dk-have! (list 'IN dif 'NN) (lambda () (subst (list '= dif nm)) (ass)))
    (dk-have! (list '= (list 'CARD sn) (list '+ (list 'CARD sg) dif))
      (lambda ()
        (subst (list '= (list 'CARD sn) nv))
        (subst (list '= (list 'CARD sg) v))
        (crs)))
    (dk-fact! 'membership-implies-sethood v 'NN)
    (have! (list 'AND (list 'NOT (list 'IN v sg))
                 (list 'AND (list 'IN sg 'SET)
                       (list 'AND (list 'IN sn 'SET)
                             (list 'AND (list 'IN (list 'CARD sg) 'NN)
                                   (list 'AND (list 'IN dif 'NN)
                                         (list '= (list 'CARD sn) (list '+ (list 'CARD sg) dif))))))))
    (dk-fact! 'injection-extension-recurrence sg sn v dif)
    (dk-fact! 'ord-segment-insert v)
    (subst (list '= (list 'ORD-SEGMENT sv) (list 'UNION sg (list 'PAIR v v))))
    (subst (list '= (list 'CARD (list 'INJECTION (list 'UNION sg (list 'PAIR v v)) sn))
                 (list '* dif (list 'CARD (list 'INJECTION sg sn)))))
    (subst (list '= (list 'CARD (list 'INJECTION sg sn)) (list 'FALLING nv v)))
    (dk-fact! 'falling-succ nv v)
    (subst (list '= (list 'FALLING nv sv) (list '* dif (list 'FALLING nv v))))
    (dk-fact! 'falling-in-nn nv v)
    (rfl)))
(rb5-check! 'rb5-count-falling-aux)
(qed 'rb5-count-falling-aux)

;;; ===================================================================
;;; injection-count-falling -- statement copied from
;;; structure-library/injection.scm (support, warranted well-known).
;;; ===================================================================
(sp (make-wff
  '(FORALL n (IMPLIES (IN n NN)
     (FORALL m (IMPLIES (AND (IN m NN) (<= m n))
       (= (CARD (INJECTION (ORD-SEGMENT m) (ORD-SEGMENT n))) (FALLING n m))))))))
(dk-peel!)
(dk-split-all!)
(let* ((gl (dk-goal))
       (I  (cadr (cadr gl)))
       (mv (cadr (cadr I)))
       (nv (cadr (caddr I))))
  (dk-fact! 'rb5-count-falling-aux mv nv)
  (ass))
(rb5-check! 'injection-count-falling)
(qed 'injection-count-falling)

;;; ===================================================================
;;; permutation-recurrence -- statement copied from
;;; structure-library/injection.scm (support).
;;; ===================================================================
(sp (make-wff
  '(FORALL n (IMPLIES (IN n NN)
     (= (CARD (PERMUTATIONS (succ n)))
        (* (succ n) (CARD (PERMUTATIONS n))))))))
(dk-peel!)
(let* ((gl (dk-goal))
       (sn (cadr (cadr (cadr gl))))
       (nv (cadr sn)))
  (mac 'PERMUTATIONS)
  (dk-fact! 'nn-succ-closed nv)
  (dk-have! (list '<= nv nv) (lambda () (dk-nn!)))
  (dk-have! (list '<= sn sn) (lambda () (dk-nn!)))
  (dk-fact! 'rb5-count-falling-aux sn sn)
  (dk-fact! 'rb5-count-falling-aux nv nv)
  (dk-fact! 'falling-succ-succ nv nv)
  (subst (list '= (list 'CARD (list 'INJECTION (list 'ORD-SEGMENT sn) (list 'ORD-SEGMENT sn)))
               (list 'FALLING sn sn)))
  (subst (list '= (list 'CARD (list 'INJECTION (list 'ORD-SEGMENT nv) (list 'ORD-SEGMENT nv)))
               (list 'FALLING nv nv)))
  (subst (list '= (list 'FALLING sn sn) (list '* sn (list 'FALLING nv nv))))
  (dk-fact! 'falling-in-nn nv nv)
  (rfl))
(rb5-check! 'permutation-recurrence)
(qed 'permutation-recurrence)
