;;; t in RR, 0 < t: land t in the half-plane (and t in CC, re t = t)
(define (gmf-pos-in-rhp! t)
  (gmf-re-im-real! t)
  (gmf-cc! t)
  (if (not (dk-asm? (list '< 0 (list 'real-part t))))
      (dk-have! (list '< 0 (list 'real-part t)) (lambda () (subst (list '= (list 'real-part t) t)) (dk-ass!))))
  (gmf-rhp-in! t))

(sp (make-wff '(FORALL z (IMPLIES (IN z CC) (FORALL t (IMPLIES (IN t RR) (IMPLIES (< 0 t)
   (= (magnitude ((GAMMA-INTEGRAND z) t)) (CC-EXP (- (* (- (real-part z) 1) (LOG t)) t))))))))))
(dk-peel!)
(gmf-pos-in-rhp! 't)
(mac 'GAMMA-INTEGRAND)
(dk-lam-b!)
(fact 'cc-log-real 't)
(subst '(= (CC-LOG t) (LOG t)))
(let* ((L '(LOG t)) (w1 (list '* '(- z 1) L)) (w2 '(- t))
       (p (list 'CC-EXP w1)) (q (list 'CC-EXP w2)))
  (fact 'log-in-rr 't)
  (gmf-cc! L) (gmf-cc! '(- z 1)) (gmf-cc! w1) (gmf-cc! w2) (gmf-cc! p) (gmf-cc! q)
  (gmf-and! (list 'IN p 'CC) (list 'IN q 'CC))
  (fact 'cc-magnitude-mul p q)
  (subst (list '= (list 'magnitude (list '* p q)) (list '* (list 'magnitude p) (list 'magnitude q))))
  (fact 'cc-exp-magnitude w1)
  (fact 'cc-exp-magnitude w2)
  (subst (list '= (list 'magnitude p) (list 'CC-EXP (list 'real-part w1))))
  (subst (list '= (list 'magnitude q) (list 'CC-EXP (list 'real-part w2))))
  ;; re((z - 1) L) = (re z - 1) L ; re(-t) = -t
  (gmf-rr! '(real-part z))
  (gmf-re-im-real! 1)
  (fact 'cc-re-real-mul L '(- z 1))
  (fact 'cc-one-in)
  (fact 'cc-re-sub 'z 1)
  (gmf-cc! (list '* L '(- z 1)))
  (dk-have! (list '= w1 (list '* L '(- z 1))) (lambda () (crs)))
  (gmf-rr! (list '* (list '- '(real-part z) 1) L))
  (dk-have! (list '= (list 'real-part w1) (list '* (list '- '(real-part z) 1) L))
    (lambda ()
      (subst (list '= w1 (list '* L '(- z 1))))
      (subst (list '= (list 'real-part (list '* L '(- z 1))) (list '* L (list 'real-part '(- z 1)))))
      (subst (list '= (list 'real-part '(- z 1)) (list '- '(real-part z) '(real-part 1))))
      (subst (list '= '(real-part 1) 1))
      (crs)))
  (subst (list '= (list 'real-part w1) (list '* (list '- '(real-part z) 1) L)))
  (gmf-rr! w2)
  (gmf-re-im-real! w2)
  (subst (list '= (list 'real-part w2) w2))
  (let* ((A (list '* (list '- '(real-part z) 1) L)))
    (gmf-cc! A)
    (fact 'cc-exp-add A w2)
    (subst (list '= (list '* (list 'CC-EXP A) (list 'CC-EXP w2)) (list 'CC-EXP (list '+ A w2))))
    (gmf-rr! (list '- A 't))
    (dk-have! (list '= (list '+ A w2) (list '- A 't)) (lambda () (crs)))
    (gmf-subst-close! (list '= (list '+ A w2) (list '- A 't)))))
(qed 'gamma-integrand-magnitude)
;;; ---------------------------------------------------------------------
;;; (9) THE TWO BOUNDS OF ESTIMATE (96): t^{x-1} on (0, 1], C e^{-t/2} on [1, +inf)
;;; ---------------------------------------------------------------------
(sp (make-wff '(FORALL t (IMPLIES (IN t RR) (IMPLIES (<= 1 t) (<= 0 (LOG t)))))))
(dk-peel!)
(fact 'rr-one-in)
(fact 'log-in-rr 't)
(use-cases (dk-cite! 'rr-lt-trichotomy 't 1)
  (lambda () (dk-absurd! '(< t 1) '(<= 1 t)))
  (lambda () (fact 'log-one) (fact 'log-in-rr 1) (subst '(= t 1)) (gmf-ineq! '(<= 0 (LOG 1)) '(= (LOG 1) 0)))
  (lambda () (fact 'log-pos-above-one 't) (gmf-ineq! '(<= 0 (LOG t)) '(< 0 (LOG t)))))
(qed 'log-nonneg-of-ge-one)

(define gmf-GIt '(magnitude ((GAMMA-INTEGRAND z) t)))
(define gmf-bd-u '(- (* (- (real-part z) 1) (LOG t)) t))
(sp (make-wff (gmf-all '(z s0 t) (gmf-imps (list '(IN z CC) '(IN s0 RR) '(IN t RR) '(< 0 s0) '(<= s0 (real-part z)) '(< 0 t) '(<= t 1))
  (list '<= gmf-GIt '(CC-EXP (* (- s0 1) (LOG t))))))))
(dk-peel!)
(fact 'gamma-integrand-magnitude 'z 't)
(subst (list '= gmf-GIt (list 'CC-EXP gmf-bd-u)))
(let* ((L '(LOG t)) (c '(- (real-part z) s0)) (v '(* (- s0 1) (LOG t))))
  (fact 'log-in-rr 't)
  (gmf-rr! '(real-part z)) (gmf-rr! c) (gmf-rr! gmf-bd-u) (gmf-rr! v) (fact 'rr-zero-in)
  (fact 'log-le-minus-one 't)
  (gmf-ineq! (list '<= L 0) (list '<= L '(- t 1)) '(<= t 1))
  (gmf-ineq! (list '<= 0 c) '(<= s0 (real-part z)))
  (fact 'rr-mul-le-right L 0 c)
  (gmf-rr! (list '* L c)) (gmf-rr! (list '* 0 c)) (gmf-rr! '(* (- (real-part z) 1) (LOG t)))
  (dk-have! (list '= (list '* 0 c) 0) (lambda () (crs)))
  (dk-have! (list '= (list '- '(* (- (real-part z) 1) (LOG t)) v) (list '* L c)) (lambda () (crs)))
  (gmf-ineq! (list '<= gmf-bd-u v)
             (list '= (list '- '(* (- (real-part z) 1) (LOG t)) v) (list '* L c))
             (list '<= (list '* L c) (list '* 0 c)) (list '= (list '* 0 c) 0) '(< 0 t))
  (fact 'cc-exp-real-mono gmf-bd-u v)
  (dk-ass!))
(qed 'gamma-integrand-bound-small)

(define gmf-bd-K '(* A (- (LOG (* 2 A)) 1)))
(define gmf-bd-v (list '- gmf-bd-K '(* 1/2 t)))
(sp (make-wff (gmf-all '(z s1 A t) (gmf-imps (list '(IN z CC) '(IN s1 RR) '(IN A RR) '(IN t RR)
                                                 '(<= (real-part z) s1) '(<= 1 A) '(<= (- s1 1) A) '(<= 1 t))
  (list '<= gmf-GIt (list 'CC-EXP gmf-bd-v))))))
(dk-peel!)
(gmf-ineq! '(< 0 t))
(fact 'gamma-integrand-magnitude 'z 't)
(subst (list '= gmf-GIt (list 'CC-EXP gmf-bd-u)))
(let* ((L '(LOG t)) (a2 '(* 2 A)) (y '(* t (recip (* 2 A)))) (la2 '(LOG (* 2 A))))
  (fact 'log-in-rr 't) (fact 'log-in-rr a2)
  (gmf-rr! '(real-part z)) (gmf-rr! a2)
  (gmf-ineq! (list '< 0 a2))
  (fact 'rr-pos-ne-zero a2)
  (fact 'rr-recip-pos a2)
  (gmf-rr! y)
  (dk-have! (list '< 0 y) (lambda () (fact 'rr-mul-pos 't (list 'recip a2)) (dk-ass!)))
  (fact 'log-nonneg-of-ge-one 't)
  ;; (re z - 1) L <= A L
  (gmf-rr! '(- (real-part z) 1))
  (gmf-ineq! '(<= (- (real-part z) 1) A) '(<= (real-part z) s1) '(<= (- s1 1) A))
  (fact 'rr-mul-le-right '(- (real-part z) 1) 'A L)
  ;; L = log y + log(2A) <= y - 1 + log(2A)
  (fact 'rr-recip-cancel-right 't a2)
  (fact 'log-mul y a2)
  (gmf-rr! (list '* y a2))
  (dk-have! (list '= L (list '+ (list 'LOG y) la2))
    (lambda () (subst (list '= (list '+ (list 'LOG y) la2) (list 'LOG (list '* y a2))))
               (gmf-subst-close! (list '= (list '* y a2) 't))))
  (fact 'log-in-rr y)
  (fact 'log-le-minus-one y)
  (let* ((rhs (list '+ (list '- y 1) la2)))
    (gmf-rr! rhs)
    (gmf-ineq! (list '<= L rhs) (list '= L (list '+ (list 'LOG y) la2)) (list '<= (list 'LOG y) (list '- y 1)))
    (gmf-ineq! '(<= 0 A))
    (fact 'rr-mul-le-right L rhs 'A)
    (for-each gmf-rr! (list (list '* L 'A) (list '* rhs 'A) '(* A (LOG t)) '(* (- (real-part z) 1) (LOG t))
                            (list '* y 'A) (list '* 'A la2) (list '* y a2) gmf-bd-K gmf-bd-u gmf-bd-v))
    (dk-have! (list '= (list '* L 'A) '(* A (LOG t))) (lambda () (crs)))
    (dk-have! (list '= (list '* rhs 'A) (list '+ (list '- (list '* y 'A) 'A) (list '* 'A la2))) (lambda () (crs)))
    (dk-have! (list '= (list '* y a2) (list '* 2 (list '* y 'A))) (lambda () (crs)))
    (dk-have! (list '= gmf-bd-K (list '- (list '* 'A la2) 'A)) (lambda () (crs)))
    (gmf-ineq! (list '<= gmf-bd-u gmf-bd-v)
               (list '<= '(* (- (real-part z) 1) (LOG t)) '(* A (LOG t)))
               (list '= (list '* L 'A) '(* A (LOG t)))
               (list '<= (list '* L 'A) (list '* rhs 'A))
               (list '= (list '* rhs 'A) (list '+ (list '- (list '* y 'A) 'A) (list '* 'A la2)))
               (list '= 't (list '* y a2))
               (list '= (list '* y a2) (list '* 2 (list '* y 'A)))
               (list '= gmf-bd-K (list '- (list '* 'A la2) 'A)))
    (fact 'cc-exp-real-mono gmf-bd-u gmf-bd-v)
    (dk-ass!)))
(qed 'gamma-integrand-bound-large)
;;; ---------------------------------------------------------------------
;;; (10) THE TAILS: |int_r1^r2| <= r2^{x0}/x0 on (0, 1], |int_R1^R2| <= 2C e^{-R1/2} on [1, +inf)
;;; ---------------------------------------------------------------------
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IN a RR) (list 'FORALL 'b (list 'IMPLIES '(IN b RR) (list 'IMPLIES '(< 0 a)
  (list 'SUBSET '(CCINT a b) gmf-rhp))))))))
(dk-peel!)
(let* ((x (subset-by-element!)))
  (gmf-ccint-parts! x 'a 'b)
  (gmf-lt! 0 x)
  (gmf-pos-in-rhp! x)
  (dk-ass!))
(qed 'ccint-in-right-half-plane)


;;; the integrand is integrable on every [r, R], 0 < r < R
(sp (make-wff (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (gmf-locint '(GAMMA-INTEGRAND z))))))
(dk-peel!)
(fact 'gamma-integrand-holomorphic 'z)
(gmf-rhp-setup!)
(dk-project! (list 'IN '(GAMMA-INTEGRAND z) (list 'FUN gmf-rhp 'CC))
             (lambda () (mac-h 'HOLOMORPHIC-ON (dk-ctx-form (list 'HOLOMORPHIC-ON gmf-rhp '(GAMMA-INTEGRAND z))))))
(fact 'holomorphic-on-continuous gmf-rhp '(GAMMA-INTEGRAND z))
(fact 'ccint-in-right-half-plane 'ipr_ 'ipq_)
(fact 'cc-int-in-cc-of-continuous gmf-rhp '(GAMMA-INTEGRAND z) 'ipr_ 'ipq_)
(dk-ass!)
(qed 'gamma-integrand-locint)

;;; the integrand's setup at z: holomorphic, a function on H, continuous on H
(define (gmf-GI-setup! z)
  (let ((h (list 'HOLOMORPHIC-ON gmf-rhp (list 'GAMMA-INTEGRAND z))))
    (fact 'gamma-integrand-holomorphic z)
    (dk-project! (list 'IN (list 'GAMMA-INTEGRAND z) (list 'FUN gmf-rhp 'CC))
                 (lambda () (mac-h 'HOLOMORPHIC-ON (dk-ctx-form h))))
    (fact 'holomorphic-on-continuous gmf-rhp (list 'GAMMA-INTEGRAND z))))
;;; F holomorphic on H as a lambda: land HOLOMORPHIC-ON, the FUN typing, the continuity
(define (gmf-holo-setup! lam)
  (let ((h (list 'HOLOMORPHIC-ON gmf-rhp lam)))
    (dk-have! h (lambda () (dk-holomorphic! gmf-rhp lam)))
    (dk-project! (list 'IN lam (list 'FUN gmf-rhp 'CC)) (lambda () (mac-h 'HOLOMORPHIC-ON (dk-ctx-form h))))
    (fact 'holomorphic-on-continuous gmf-rhp lam)))
;;; (a * (b * c)) * d = (a * c) * (b * d), and x * 1 = x, over CC
(define gmf-ring4 '(FORALL ga_ (IMPLIES (IN ga_ CC) (FORALL gb_ (IMPLIES (IN gb_ CC) (FORALL gc_ (IMPLIES (IN gc_ CC)
                     (FORALL gd_ (IMPLIES (IN gd_ CC) (= (* (* ga_ (* gb_ gc_)) gd_) (* (* ga_ gc_) (* gb_ gd_))))))))))))
(define (gmf-ring4!) (if (not (dk-asm? gmf-ring4)) (dk-have! gmf-ring4 (lambda () (dk-peel!) (crs)))))
;;; w in H in context: land CC-LOG(w) in CC, recip(w) = exp(-log w); return (Lw . (recip w = exp(-Lw)))
(define (gmf-log-at! w)
  (let* ((lw (list 'CC-LOG w)))
    (gmf-cite-split! 'right-half-plane-in-slit w)
    (gmf-rhp-open! w)
    (gmf-cite-split! 'cc-log-in-slit w)
    (fact 'cc-exp-log w)
    (gmf-cc! (list '- lw))
    (fact 'cc-exp-neg lw)
    (gmf-cc! (list 'recip w))
    (dk-have! (list '= (list 'recip w) (list 'CC-EXP (list '- lw)))
      (lambda ()
        (subst (list '= (list 'CC-EXP (list '- lw)) (list 'recip (list 'CC-EXP lw))))
        (gmf-subst-close! (list '= (list 'CC-EXP lw) w))))
    lw))
;;; E exp(-Lw) = exp(A + -Lw) for E = exp(A); then A + -Lw = B: land (= (* (CC-EXP A) (CC-EXP (- Lw))) (CC-EXP B))
(define (gmf-exp-shift! a lw b)
  (gmf-cc! a) (gmf-cc! (list '- lw)) (gmf-cc! (list 'CC-EXP a)) (gmf-cc! (list 'CC-EXP (list '- lw)))
  (fact 'cc-exp-add a (list '- lw))
  (gmf-cc! b)
  (dk-have! (list '= (list '+ a (list '- lw)) b) (lambda () (crs)))
  (dk-have! (list '= (list '* (list 'CC-EXP a) (list 'CC-EXP (list '- lw))) (list 'CC-EXP b))
    (lambda ()
      (subst (list '= (list '* (list 'CC-EXP a) (list 'CC-EXP (list '- lw))) (list 'CC-EXP (list '+ a (list '- lw)))))
      (gmf-subst-close! (list '= (list '+ a (list '- lw)) b)))))

(define gmf-ts-prim '(VNB-LAMBDA gmw_ (SEP gmu_ CC (< 0 (real-part gmu_))) (* (CC-EXP (* s0 (CC-LOG gmw_))) (recip s0))))
(define gmf-ts-der '(VNB-LAMBDA gmw_ (SEP gmu_ CC (< 0 (real-part gmu_))) (CC-EXP (* (- s0 1) (CC-LOG gmw_)))))
(define gmf-ts-I '(CC-INT (GAMMA-INTEGRAND z) r1 r2))
(sp (make-wff (gmf-all '(z s0 r1 r2) (gmf-imps (list '(IN z CC) '(IN s0 RR) '(IN r1 RR) '(IN r2 RR)
     '(< 0 s0) '(<= s0 (real-part z)) '(< 0 r1) '(< r1 r2) '(<= r2 1))
  (list '<= (list 'magnitude gmf-ts-I) '(* (CC-EXP (* s0 (LOG r2))) (recip s0)))))))
(dk-peel!)
(gmf-rhp-setup!)
(gmf-GI-setup! 'z)
(fact 'ccint-in-right-half-plane 'r1 'r2)
(dk-apply! (dk-fact! 'gamma-integrand-locint 'z) 'r1 'r2)
(fact 'rr-pos-ne-zero 's0)
(gmf-cc! 's0)
(gmf-and! '(IN s0 CC) '(NOT (= s0 0)))
(fact 'cc-recip-closed 's0)
(gmf-holo-setup! gmf-ts-prim)
(gmf-ring4!)
(dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES (list 'IN 'hbz_ gmf-rhp)
            (list 'IS-DIFF-ON 'CC-NORMED-FIELD gmf-rhp gmf-ts-prim 'hbz_ (list gmf-ts-der 'hbz_))))
  (lambda ()
    (let* ((w (dk-di-var!))
           (r (dk-diff! gmf-rhp gmf-ts-prim w))
           (ls (list-ref r 5))
           (lw (gmf-log-at! w))
           (e (list 'CC-EXP (list '* 's0 lw)))
           (tgt (list 'CC-EXP (list '* '(- s0 1) lw))))
      (gmf-cc! e) (gmf-cc! tgt)
      (dk-apply! (dk-ctx-form gmf-ring4) e 's0 (list 'recip w) '(recip s0))
      (fact 'cc-recip-inverse 's0)
      (gmf-exp-shift! (list '* 's0 lw) lw (list '* '(- s0 1) lw))
      (dk-have! (list '= (list gmf-ts-der w) ls)
        (lambda ()
          (dk-lam-b!)
          (subst (list '= ls (list '* (list '* e (list 'recip w)) '(* s0 (recip s0)))))
          (subst '(= (* s0 (recip s0)) 1))
          (subst (list '= (list 'recip w) (list 'CC-EXP (list '- lw))))
          (subst (list '= (list '* e (list 'CC-EXP (list '- lw))) tgt))
          (gmf-cc! (list '* tgt 1))
          (dk-have! (list '= (list '* tgt 1) tgt) (lambda () (crs)))
          (gmf-subst-close! (list '= (list '* tgt 1) tgt))))
      (subst (list '= (list gmf-ts-der w) ls))
      (dk-ass!))))
(gmf-holo-setup! gmf-ts-der)
(gmf-ring4!)
;;; the bound, pointwise on [r1, r2]
(dk-have! (list 'FORALL 'gmy_ (list 'IMPLIES '(IN gmy_ (CCINT r1 r2))
            (list '<= '(magnitude ((GAMMA-INTEGRAND z) gmy_)) (list 'real-part (list gmf-ts-der 'gmy_)))))
  (lambda ()
    (let* ((y (dk-di-var!)) (v (list 'CC-EXP (list '* '(- s0 1) (list 'LOG y)))))
      (gmf-ccint-parts! y 'r1 'r2)
      (gmf-lt! 0 y) (gmf-le! y 1)
      (gmf-pos-in-rhp! y)
      (fact 'gamma-integrand-bound-small 'z 's0 y)
      (dk-lam-b!)
      (fact 'cc-log-real y)
      (subst (list '= (list 'CC-LOG y) (list 'LOG y)))
      (fact 'log-in-rr y)
      (gmf-rr! (list '* '(- s0 1) (list 'LOG y)))
      (gmf-cite-split! 'cc-exp-real (list '* '(- s0 1) (list 'LOG y)))
      (gmf-re-im-real! v)
      (subst (list '= (list 'real-part v) v))
      (dk-ass!))))
(fact 'cc-int-compare-primitive gmf-rhp '(GAMMA-INTEGRAND z) gmf-ts-der gmf-ts-prim 'r1 'r2)
;;; G(r) = exp(s0 log r) / s0, real and positive
(define (gmf-ts-Gval! r)
  (let* ((x (list 'CC-EXP (list '* 's0 (list 'LOG r)))) (v (list '* x '(recip s0))))
    (gmf-pos-in-rhp! r)
    (fact 'log-in-rr r)
    (gmf-rr! (list '* 's0 (list 'LOG r)))
    (gmf-cite-split! 'cc-exp-real (list '* 's0 (list 'LOG r)))
    (gmf-rr! '(recip s0))
    (fact 'rr-recip-pos 's0)
    (gmf-rr! v)
    (fact 'rr-mul-pos x '(recip s0))
    (fact 'cc-log-real r)
    (dk-have! (list '= (list gmf-ts-prim r) v)
      (lambda () (dk-lam-b!) (gmf-subst-close! (list '= (list 'CC-LOG r) (list 'LOG r)))))
    v))
(gmf-lt! 0 'r2)
(let* ((v1 (gmf-ts-Gval! 'r1)) (v2 (gmf-ts-Gval! 'r2))
       (dg (list '- (list gmf-ts-prim 'r2) (list gmf-ts-prim 'r1))))
  (gmf-rr! (list '- v2 v1))
  (gmf-re-im-real! (list '- v2 v1))
  (dk-have! (list '= (list 'real-part dg) (list '- v2 v1))
    (lambda ()
      (subst (list '= (list gmf-ts-prim 'r2) v2))
      (subst (list '= (list gmf-ts-prim 'r1) v1))
      (gmf-subst-close! (list '= (list 'real-part (list '- v2 v1)) (list '- v2 v1)))))
  (gmf-rr! (list 'magnitude gmf-ts-I))
  (gmf-rr! (list 'real-part dg))
  (dk-ineq! (list '<= (list 'magnitude gmf-ts-I) (list 'real-part dg))
            (list '= (list 'real-part dg) (list '- v2 v1))
            (list '< 0 v1)))
(qed 'gamma-tail-small)

(define gmf-tk '(* A (- (LOG (* 2 A)) 1)))
(define gmf-tl-prim (list 'VNB-LAMBDA 'gmw_ gmf-rhp (list '* -2 (list 'CC-EXP (list '- gmf-tk '(* 1/2 gmw_))))))
(define gmf-tl-der (list 'VNB-LAMBDA 'gmw_ gmf-rhp (list 'CC-EXP (list '- gmf-tk '(* 1/2 gmw_)))))
(define gmf-tl-int '(CC-INT (GAMMA-INTEGRAND z) r1 r2))
(define (gmf-tl-E x) (list 'CC-EXP (list '- gmf-tk (list '* 1/2 x))))
(sp (make-wff (gmf-all '(z s1 A r1 r2) (gmf-imps (list '(IN z CC) '(IN s1 RR) '(IN A RR) '(IN r1 RR) '(IN r2 RR)
     '(<= (real-part z) s1) '(<= 1 A) '(<= (- s1 1) A) '(<= 1 r1) '(< r1 r2))
  (list '<= (list 'magnitude gmf-tl-int) (list '* 2 (gmf-tl-E 'r1)))))))
(dk-peel!)
(gmf-rhp-setup!)
(gmf-GI-setup! 'z)
(gmf-lt! 0 'r1)
(fact 'ccint-in-right-half-plane 'r1 'r2)
(dk-apply! (dk-fact! 'gamma-integrand-locint 'z) 'r1 'r2)
(gmf-rr! gmf-tk) (gmf-cc! gmf-tk)
(gmf-holo-setup! gmf-tl-prim)
(dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES (list 'IN 'hbz_ gmf-rhp)
            (list 'IS-DIFF-ON 'CC-NORMED-FIELD gmf-rhp gmf-tl-prim 'hbz_ (list gmf-tl-der 'hbz_))))
  (lambda ()
    (let* ((w (dk-di-var!))
           (v (gmf-tl-E w))
           (r (dk-diff! gmf-rhp gmf-tl-prim w v)))
      (dk-have! (list '= (list gmf-tl-der w) v) (lambda () (if (not (dk-lam-b!)) (begin (gmf-cc! v) (rfl)))))
      (subst (list '= (list gmf-tl-der w) v))
      (dk-ass!))))
(gmf-holo-setup! gmf-tl-der)
(dk-have! (list 'FORALL 'gmy_ (list 'IMPLIES '(IN gmy_ (CCINT r1 r2))
            (list '<= '(magnitude ((GAMMA-INTEGRAND z) gmy_)) (list 'real-part (list gmf-tl-der 'gmy_)))))
  (lambda ()
    (let* ((y (dk-di-var!)) (v (gmf-tl-E y)))
      (gmf-ccint-parts! y 'r1 'r2)
      (gmf-le! 1 y)
      (gmf-lt! 0 y)
      (gmf-pos-in-rhp! y)
      (fact 'gamma-integrand-bound-large 'z 's1 'A y)
      (dk-lam-b!)
      (gmf-rr! (list '- gmf-tk (list '* 1/2 y)))
      (gmf-rr! v)
      (gmf-re-im-real! v)
      (subst (list '= (list 'real-part v) v))
      (dk-ass!))))
(fact 'cc-int-compare-primitive gmf-rhp '(GAMMA-INTEGRAND z) gmf-tl-der gmf-tl-prim 'r1 'r2)
(define (gmf-tl-Gval! x)
  (let* ((e (gmf-tl-E x)) (v (list '* -2 e)))
    (gmf-lt! 0 x)
    (gmf-pos-in-rhp! x)
    (gmf-rr! (list '- gmf-tk (list '* 1/2 x)))
    (gmf-rr! e) (gmf-rr! v)
    (gmf-cite-split! 'cc-exp-real (list '- gmf-tk (list '* 1/2 x)))
    (dk-have! (list '= (list gmf-tl-prim x) v) (lambda () (if (not (dk-lam-b!)) (rfl))))
    v))
(let* ((v1 (gmf-tl-Gval! 'r1)) (v2 (gmf-tl-Gval! 'r2))
       (dg (list '- (list gmf-tl-prim 'r2) (list gmf-tl-prim 'r1))))
  (gmf-rr! (list '- v2 v1))
  (gmf-re-im-real! (list '- v2 v1))
  (dk-have! (list '= (list 'real-part dg) (list '- v2 v1))
    (lambda ()
      (subst (list '= (list gmf-tl-prim 'r2) v2))
      (subst (list '= (list gmf-tl-prim 'r1) v1))
      (gmf-subst-close! (list '= (list 'real-part (list '- v2 v1)) (list '- v2 v1)))))
  (gmf-rr! (list 'magnitude gmf-tl-int))
  (gmf-rr! (list 'real-part dg))
  (gmf-rr! (gmf-tl-E 'r1)) (gmf-rr! (gmf-tl-E 'r2))
  (dk-ineq! (list '<= (list 'magnitude gmf-tl-int) (list 'real-part dg))
            (list '= (list 'real-part dg) (list '- v2 v1))
            (list '< 0 (gmf-tl-E 'r2))))
(qed 'gamma-tail-large)
;;; ---------------------------------------------------------------------
;;; (11) CONVERGENCE FOR 0 < re z (the notes' (96)-(97)); Gamma is defined there.
;;; ---------------------------------------------------------------------
(sp (make-wff '(FORALL u (IMPLIES (IN u RR) (FORALL v (IMPLIES (IN v RR) (IMPLIES (< 0 u) (IMPLIES (<= u v)
   (<= (LOG u) (LOG v))))))))))
(dk-peel!)
(fact 'log-in-rr 'u) (fact 'log-in-rr 'v)
(use-cases (dk-cite! 'rr-lt-trichotomy 'u 'v)
  (lambda () (fact 'log-strictly-increasing 'u 'v) (gmf-ineq! '(<= (LOG u) (LOG v)) '(< (LOG u) (LOG v))))
  (lambda () (subst '(= u v)) (gmf-ineq! '(<= (LOG v) (LOG v))))
  (lambda () (dk-absurd! '(< v u) '(<= u v))))
(qed 'log-monotone)

;;; x^s / s is small near 0
(define gmf-pw (lambda (s x) (list '* (list 'CC-EXP (list '* s (list 'LOG x))) (list 'recip s))))
(sp (make-wff (gmf-all '(s e) (gmf-imps (list '(IN s RR) '(IN e RR) '(< 0 s) '(< 0 e))
  (list 'FORSOME 'd (list 'AND '(IN d RR) (list 'AND '(< 0 d) (list 'AND '(<= d 1) (list '<= (gmf-pw 's 'd) 'e)))))))))
(dk-peel!)
(let* ((es '(* e s)))
  (gmf-rr! es)
  (fact 'rr-mul-pos 'e 's)
  (gmf-rr! (list 'LOG es))
  (gmf-rr! (list '- (list 'LOG es)))
  (fact 'rr-pos-rr-of-lt 's)
  (let* ((n (dk-skolem! (dk-apply! (dk-cite! 'rr-archimedean-multiple 's) (list '- (list 'LOG es)))))
         (_ (begin (fact 'nn-in-rr n) (fact 'nn-zero-le n) (gmf-rr! (list '- n))))
         (d (dk-skolem! (dk-cite! 'log-surjective (list '- n)))))
    (fact 'log-in-rr d)
    ;; d <= 1
    (fact 'rr-one-in)
    (dk-have! (list '<= d 1)
      (lambda ()
        (use-cases (dk-cite! 'rr-lt-trichotomy d 1)
          (lambda () (gmf-ineq! (list '<= d 1) (list '< d 1)))
          (lambda () (gmf-ineq! (list '<= d 1) (list '= d 1)))
          (lambda () (fact 'log-pos-above-one d)
                     (dk-absurd! (list '< 0 (list 'LOG d)) (list '= (list 'LOG d) (list '- n)) (list '<= 0 n))))))
    ;; exp(s log d) <= e s
    (gmf-rr! (list '* 's (list 'LOG d)))
    (gmf-rr! (list '* n 's))
    (dk-have! (list '= (list '* 's (list 'LOG d)) (list '- (list '* n 's)))
      (lambda () (subst (list '= (list 'LOG d) (list '- n))) (crs)))
    (gmf-ineq! (list '<= (list '* 's (list 'LOG d)) (list 'LOG es))
               (list '= (list '* 's (list 'LOG d)) (list '- (list '* n 's)))
               (list '<= (list '- (list 'LOG es)) (list '* n 's)))
    (fact 'cc-exp-real-mono (list '* 's (list 'LOG d)) (list 'LOG es))
    (fact 'cc-exp-log-real es)
    (gmf-rr! (list 'CC-EXP (list '* 's (list 'LOG d))))
    (gmf-rr! (list 'CC-EXP (list 'LOG es)))
    (gmf-ineq! (list '<= (list 'CC-EXP (list '* 's (list 'LOG d))) es)
               (list '<= (list 'CC-EXP (list '* 's (list 'LOG d))) (list 'CC-EXP (list 'LOG es)))
               (list '= (list 'CC-EXP (list 'LOG es)) es))
    (fact 'rr-pos-ne-zero 's)
    (gmf-rr! '(recip s))
    (fact 'rr-recip-pos 's)
    (gmf-ineq! '(<= 0 (recip s)) '(< 0 (recip s)))
    (fact 'rr-mul-le-right (list 'CC-EXP (list '* 's (list 'LOG d))) es '(recip s))
    (fact 'rr-mul-recip-cancel 'e 's)
    (gmf-rr! (gmf-pw 's d)) (gmf-rr! (list '* es '(recip s)))
    (ew d)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (dk-ass!)
            (dk-ineq! (list '<= (gmf-pw 's d) (list '* es '(recip s)))
                      (list '= 'e (list '* es '(recip s)))))))))
(qed 'rr-power-small-at-zero)

(sp (make-wff (gmf-all '(s r d) (gmf-imps (list '(IN s RR) '(IN r RR) '(IN d RR) '(< 0 s) '(< 0 r) '(<= r d))
  (list '<= (gmf-pw 's 'r) (gmf-pw 's 'd))))))
(dk-peel!)
(gmf-lt! 0 'd)
(fact 'log-monotone 'r 'd)
(fact 'log-in-rr 'r) (fact 'log-in-rr 'd)
(gmf-ineq! '(<= 0 s) '(< 0 s))
(fact 'rr-mul-le-right '(LOG r) '(LOG d) 's)
(for-each gmf-rr! (list '(* (LOG r) s) '(* (LOG d) s) '(* s (LOG r)) '(* s (LOG d))))
(dk-have! '(= (* s (LOG r)) (* (LOG r) s)) (lambda () (crs)))
(dk-have! '(= (* s (LOG d)) (* (LOG d) s)) (lambda () (crs)))
(gmf-ineq! '(<= (* s (LOG r)) (* s (LOG d))) '(= (* s (LOG r)) (* (LOG r) s)) '(= (* s (LOG d)) (* (LOG d) s))
           '(<= (* (LOG r) s) (* (LOG d) s)))
(fact 'cc-exp-real-mono '(* s (LOG r)) '(* s (LOG d)))
(fact 'rr-pos-ne-zero 's)
(gmf-rr! '(recip s)) (fact 'rr-recip-pos 's)
(gmf-ineq! '(<= 0 (recip s)) '(< 0 (recip s)))
(gmf-rr! '(CC-EXP (* s (LOG r)))) (gmf-rr! '(CC-EXP (* s (LOG d))))
(fact 'rr-mul-le-right '(CC-EXP (* s (LOG r))) '(CC-EXP (* s (LOG d))) '(recip s))
(dk-ass!)
(qed 'rr-power-monotone)

;;; 2 C e^{-M/2} is small for M large
(define (gmf-ex k x) (list '* 2 (list 'CC-EXP (list '- k (list '* 1/2 x)))))
(sp (make-wff (gmf-all '(k e) (gmf-imps (list '(IN k RR) '(IN e RR) '(< 0 e))
  (list 'FORSOME 'm (list 'AND '(IN m RR) (list 'AND '(<= 1 m) (list '<= (gmf-ex 'k 'm) 'e))))))))
(dk-peel!)
(let* ((h '(* e 1/2)) (lh (list 'LOG h)) (y (list '- (list '* 2 'k) (list '* 2 lh)))
       (m (list '+ (list 'abs y) 1)))
  (gmf-rr! h) (gmf-lt! 0 h) (gmf-rr! lh) (gmf-rr! y) (gmf-rr! m)
  (fact 'rr-le-abs y)
  (fact 'rr-abs-nonneg y)
  (gmf-rr! (list '- 'k (list '* 1/2 m)))
  (gmf-ineq! (list '<= (list '- 'k (list '* 1/2 m)) lh) (list '<= y (list 'abs y)))
  (fact 'cc-exp-real-mono (list '- 'k (list '* 1/2 m)) lh)
  (fact 'cc-exp-log-real h)
  (gmf-rr! (list 'CC-EXP (list '- 'k (list '* 1/2 m)))) (gmf-rr! (list 'CC-EXP lh))
  (ew m)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (dk-ass!)
          (gmf-ineq! (dk-goal) (list '<= (list 'CC-EXP (list '- 'k (list '* 1/2 m))) (list 'CC-EXP lh))
                     (list '= (list 'CC-EXP lh) h) (list '<= 0 (list 'abs y)))))))
(qed 'exp-tail-small-at-infinity)

(sp (make-wff (gmf-all '(k m x) (gmf-imps (list '(IN k RR) '(IN m RR) '(IN x RR) '(<= m x))
  (list '<= (gmf-ex 'k 'x) (gmf-ex 'k 'm))))))
(dk-peel!)
(gmf-rr! '(- k (* 1/2 x))) (gmf-rr! '(- k (* 1/2 m)))
(gmf-le! '(- k (* 1/2 x)) '(- k (* 1/2 m)))
(fact 'cc-exp-real-mono '(- k (* 1/2 x)) '(- k (* 1/2 m)))
(gmf-rr! '(CC-EXP (- k (* 1/2 x)))) (gmf-rr! '(CC-EXP (- k (* 1/2 m))))
(gmf-ineq! (dk-goal) '(<= (CC-EXP (- k (* 1/2 x))) (CC-EXP (- k (* 1/2 m)))))
(qed 'exp-tail-monotone)
;;; I(a, b) = CC-INT(GAMMA-INTEGRAND(z), a, b): typed, and split at c (0 < a < c < b)
(define (gmf-I a b) (list 'CC-INT '(GAMMA-INTEGRAND z) a b))
(define (gmf-I! a b)
  (if (not (dk-asm? (list 'IN (gmf-I a b) 'CC)))
      (dk-cite! 'gamma-integrand-locint 'z a b))
  (gmf-I a b))
(define (gmf-split! a b c)
  (fact 'ccint-in-right-half-plane a b)
  (fact 'cc-int-split gmf-rhp '(GAMMA-INTEGRAND z) a b c)
  (gmf-I! a b) (gmf-I! a c) (gmf-I! c b))
(define (gmf-z-setup!)
  (gmf-rhp-setup!)
  (gmf-GI-setup! 'z)
  (fact 'gamma-integrand-locint 'z))
;;; |X - Y| for typed X, Y: land |X - Y| = |Y - X| and the typings
(define (gmf-mag-typ! x) (gmf-cc! x) (gmf-rr! (list 'magnitude x)))

(define gmf-sd-goal (list '<= (list 'magnitude (list '- (gmf-I 'r1 1) (gmf-I 'r2 1))) (gmf-pw 's0 'd)))
(sp (make-wff (gmf-all '(z s0 d r1 r2) (gmf-imps (list '(IN z CC) '(IN s0 RR) '(IN d RR) '(IN r1 RR) '(IN r2 RR)
     '(< 0 s0) '(<= s0 (real-part z)) '(< 0 r1) '(< r1 d) '(< 0 r2) '(< r2 d) '(<= d 1))
  gmf-sd-goal))))
(dk-peel!)
(gmf-z-setup!)
(fact 'rr-one-in)
(gmf-lt! 'r1 1) (gmf-lt! 'r2 1) (gmf-lt! 0 'd)
(gmf-I! 'r1 1) (gmf-I! 'r2 1)
(gmf-rr! (gmf-pw 's0 'd))
(define (gmf-sd-case! lo hi)
  ;; lo < hi: |I(lo,1) - I(hi,1)| = |I(lo,hi)| <= pw(hi) <= pw(d)
  (gmf-split! lo 1 hi)
  (gmf-le! hi 1) (gmf-le! hi 'd)
  (fact 'gamma-tail-small 'z 's0 lo hi)
  (fact 'rr-power-monotone 's0 hi 'd)
  (gmf-rr! (gmf-pw 's0 hi))
  (let* ((dlh (list '- (gmf-I lo 1) (gmf-I hi 1))) (dhl (list '- (gmf-I hi 1) (gmf-I lo 1))))
    (gmf-mag-typ! dlh) (gmf-mag-typ! dhl) (gmf-mag-typ! (gmf-I lo hi))
    (dk-have! (list '= dlh (gmf-I lo hi))
      (lambda () (subst (list '= (gmf-I lo 1) (list '+ (gmf-I lo hi) (gmf-I hi 1)))) (crs)))
    (fact 'cc-magnitude-sub-sym (gmf-I lo 1) (gmf-I hi 1))
    (dk-have! (list '= (list 'magnitude dlh) (list 'magnitude (gmf-I lo hi)))
      (lambda () (gmf-subst-close! (list '= dlh (gmf-I lo hi)))))
    (gmf-ineq! (dk-goal) (list '= (list 'magnitude dlh) (list 'magnitude (gmf-I lo hi)))
               (list '= (list 'magnitude dlh) (list 'magnitude dhl))
               (list '<= (list 'magnitude (gmf-I lo hi)) (gmf-pw 's0 hi))
               (list '<= (gmf-pw 's0 hi) (gmf-pw 's0 'd)))))
(use-cases (dk-cite! 'rr-lt-trichotomy 'r1 'r2)
  (lambda () (gmf-sd-case! 'r1 'r2))
  (lambda ()
    (subst '(= r1 r2))
    (let ((dd (list '- (gmf-I 'r2 1) (gmf-I 'r2 1))))
      (gmf-cc! dd)
      (dk-have! (list '= dd 0) (lambda () (crs)))
      (subst (list '= dd 0))
      (fact 'cc-magnitude-zero)
      (subst '(= (magnitude 0) 0))
      (fact 'log-in-rr 'd)
      (gmf-rr! '(* s0 (LOG d)))
      (gmf-cite-split! 'cc-exp-real '(* s0 (LOG d)))
      (fact 'rr-pos-ne-zero 's0) (gmf-rr! '(recip s0)) (fact 'rr-recip-pos 's0)
      (fact 'rr-mul-pos '(CC-EXP (* s0 (LOG d))) '(recip s0))
      (gmf-ineq! (dk-goal) (list '< 0 (gmf-pw 's0 'd)))))
  (lambda () (gmf-sd-case! 'r2 'r1)))
(qed 'gamma-small-difference)

(define gmf-K1 '(* A (- (LOG (* 2 A)) 1)))
(define gmf-ld-goal (list '<= (list 'magnitude (list '- (gmf-I 1 'r1) (gmf-I 1 'r2))) (gmf-ex gmf-K1 'm)))
(sp (make-wff (gmf-all '(z s1 A m r1 r2) (gmf-imps (list '(IN z CC) '(IN s1 RR) '(IN A RR) '(IN m RR) '(IN r1 RR) '(IN r2 RR)
     '(<= (real-part z) s1) '(<= 1 A) '(<= (- s1 1) A) '(<= 1 m) '(< m r1) '(< m r2))
  gmf-ld-goal))))
(dk-peel!)
(gmf-z-setup!)
(fact 'rr-one-in)
(gmf-lt! 0 1)
(gmf-lt! 1 'r1) (gmf-lt! 1 'r2) (gmf-lt! 0 'r1) (gmf-lt! 0 'r2)
(gmf-I! 1 'r1) (gmf-I! 1 'r2)
(gmf-rr! gmf-K1)
(gmf-rr! (gmf-ex gmf-K1 'm))
(define (gmf-ld-case! lo hi)
  ;; lo < hi: |I(1,lo) - I(1,hi)| = |I(lo,hi)| <= 2E(lo) <= 2E(m)
  (gmf-split! 1 hi lo)
  (gmf-le! 1 lo) (gmf-le! 'm lo)
  (fact 'gamma-tail-large 'z 's1 'A lo hi)
  (fact 'exp-tail-monotone gmf-K1 'm lo)
  (gmf-rr! (gmf-ex gmf-K1 lo))
  (let* ((dlh (list '- (gmf-I 1 lo) (gmf-I 1 hi))) (dhl (list '- (gmf-I 1 hi) (gmf-I 1 lo))))
    (gmf-mag-typ! dlh) (gmf-mag-typ! dhl) (gmf-mag-typ! (gmf-I lo hi))
    (dk-have! (list '= dhl (gmf-I lo hi))
      (lambda () (subst (list '= (gmf-I 1 hi) (list '+ (gmf-I 1 lo) (gmf-I lo hi)))) (crs)))
    (fact 'cc-magnitude-sub-sym (gmf-I 1 lo) (gmf-I 1 hi))
    (dk-have! (list '= (list 'magnitude dhl) (list 'magnitude (gmf-I lo hi)))
      (lambda () (gmf-subst-close! (list '= dhl (gmf-I lo hi)))))
    (gmf-ineq! (dk-goal) (list '= (list 'magnitude dhl) (list 'magnitude (gmf-I lo hi)))
               (list '= (list 'magnitude dlh) (list 'magnitude dhl))
               (list '<= (list 'magnitude (gmf-I lo hi)) (gmf-ex gmf-K1 lo))
               (list '<= (gmf-ex gmf-K1 lo) (gmf-ex gmf-K1 'm)))))
(use-cases (dk-cite! 'rr-lt-trichotomy 'r1 'r2)
  (lambda () (gmf-ld-case! 'r1 'r2))
  (lambda ()
    (subst '(= r1 r2))
    (let ((dd (list '- (gmf-I 1 'r2) (gmf-I 1 'r2))))
      (gmf-cc! dd)
      (dk-have! (list '= dd 0) (lambda () (crs)))
      (subst (list '= dd 0))
      (fact 'cc-magnitude-zero)
      (subst '(= (magnitude 0) 0))
      (gmf-rr! (list '- gmf-K1 '(* 1/2 m)))
      (gmf-cite-split! 'cc-exp-real (list '- gmf-K1 '(* 1/2 m)))
      (gmf-ineq! (dk-goal) (list '< 0 (list 'CC-EXP (list '- gmf-K1 '(* 1/2 m)))))))
  (lambda () (gmf-ld-case! 'r2 'r1)))
(qed 'gamma-large-difference)
;;; THE CONVERGENCE THEOREM: for 0 < re z the improper integral converges, to GAMMA-FUNCTION(z)
(define gmf-cv-A '(+ (real-part z) 1))
(define gmf-cv-K '(* (+ (real-part z) 1) (- (LOG (* 2 (+ (real-part z) 1))) 1)))
(sp (make-wff '(FORALL z (IMPLIES (IN z CC) (IMPLIES (< 0 (real-part z))
   (IMPROPER-INT-CONVERGES-TO (GAMMA-INTEGRAND z) (GAMMA-FUNCTION z)))))))
(dk-peel!)
(gmf-z-setup!)
(fact 'rr-one-in)
(gmf-lt! 0 1)
(gmf-rr! '(real-part z)) (gmf-rr! gmf-cv-A) (gmf-rr! gmf-cv-K)
(gmf-le! 1 gmf-cv-A) (gmf-le! '(- (real-part z) 1) gmf-cv-A) (gmf-le! '(real-part z) '(real-part z))
(dk-have! (gmf-cauchy '(GAMMA-INTEGRAND z))
  (lambda ()
    (let* ((eps (dk-di-var! (lambda (g) (cadr (cadr g))))))
      (dk-peel!)
      (fact 'rr-pos-rr-in-rr eps)
      (let* ((e2 (dk-halve! eps))
             (d (dk-skolem! (dk-cite! 'rr-power-small-at-zero '(real-part z) e2)))
             (m (dk-skolem! (dk-cite! 'exp-tail-small-at-infinity gmf-cv-K e2))))
        (fact 'rr-pos-rr-of-lt d)
        (ew d)
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal)) (dk-ass!)
              (begin
                (ew m)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-asm? (dk-goal)) (dk-ass!)
                      (let* ((g (dk-goal))
                             (vars (list 'gcr1_ 'gcr2_ 'gcq1_ 'gcq2_))
                             (_ (dk-peel!))
                             (dg (cadr (cadr (dk-goal))))       ; I(r1, q1) - I(r2, q2)
                             (i1 (cadr dg)) (i2 (caddr dg))
                             (r1 (caddr i1)) (q1 (cadddr i1)) (r2 (caddr i2)) (q2 (cadddr i2)))
                        (gmf-lt! r1 1) (gmf-lt! r2 1) (gmf-lt! 1 q1) (gmf-lt! 1 q2)
                        (gmf-I! r1 q1) (gmf-I! r2 q2)
                        (gmf-split! r1 q1 1)
                        (gmf-split! r2 q2 1)
                        (fact 'gamma-small-difference 'z '(real-part z) d r1 r2)
                        (fact 'gamma-large-difference 'z '(real-part z) gmf-cv-A m q1 q2)
                        (let* ((a (list '- (gmf-I r1 1) (gmf-I r2 1)))
                               (b (list '- (gmf-I 1 q1) (gmf-I 1 q2))))
                          (gmf-mag-typ! a) (gmf-mag-typ! b) (gmf-mag-typ! dg) (gmf-cc! (list '+ a b))
                          (dk-have! (list '= dg (list '+ a b))
                            (lambda ()
                              (subst (list '= i1 (list '+ (gmf-I r1 1) (gmf-I 1 q1))))
                              (subst (list '= i2 (list '+ (gmf-I r2 1) (gmf-I 1 q2))))
                              (crs)))
                          (gmf-and! (list 'IN a 'CC) (list 'IN b 'CC))
                          (fact 'cc-magnitude-triangle a b)
                          (gmf-rr! (list 'magnitude (list '+ a b)))
                          (dk-have! (list '= (list 'magnitude dg) (list 'magnitude (list '+ a b)))
                            (lambda () (gmf-subst-close! (list '= dg (list '+ a b)))))
                          (gmf-rr! (gmf-pw '(real-part z) d)) (gmf-rr! (gmf-ex gmf-cv-K m))
                          (gmf-ineq! (dk-goal)
                            (list '= (list 'magnitude dg) (list 'magnitude (list '+ a b)))
                            (list '<= (list 'magnitude (list '+ a b)) (list '+ (list 'magnitude a) (list 'magnitude b)))
                            (list '<= (list 'magnitude a) (gmf-pw '(real-part z) d))
                            (list '<= (gmf-pw '(real-part z) d) e2)
                            (list '<= (list 'magnitude b) (gmf-ex gmf-cv-K m))
                            (list '<= (gmf-ex gmf-cv-K m) e2)
                            (list '= (list '+ e2 e2) eps)))))))))))))))
(define gmf-cv-L (dk-skolem! (dk-cite! 'improper-int-cauchy '(GAMMA-INTEGRAND z))))
(fact 'improper-int-value '(GAMMA-INTEGRAND z) gmf-cv-L)
(mac 'GAMMA-FUNCTION)
(gmf-subst-close! (list '= '(IMPROPER-INT (GAMMA-INTEGRAND z)) gmf-cv-L))
(qed 'gamma-converges)
(topic! 'gamma-converges 'analysis)
(alias! 'gamma-converges "the improper integral defining Gamma(z) converges for re z > 0 (Definition 3.58)")
;;; ---------------------------------------------------------------------
;;; (12) THE TRUNCATIONS ARE HOLOMORPHIC (route (a): the difference quotient, through the
;;;      quadratic estimate |e^v - 1 - v| <= |v|^2 and `cc-diff-on-local-quadratic')
;;; ---------------------------------------------------------------------
;;; linearity of the integral over [p, q] for continuous functions on u
(define gmf-lc-k '(VNB-LAMBDA gmv2_ u (* c (f2 gmv2_))))
(sp (make-wff (gmf-all '(u f1 f2 p q) (gmf-imps (append (gmf-H 'u 'f1 'p 'q) (list '(IN f2 (FUN u CC)) (gmf-cont 'u 'f2)))
  (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'h (gmf-imps (list '(IN h (FUN u CC))
      '(FORALL gmv_ (IMPLIES (IN gmv_ u) (== (h gmv_) (+ (f1 gmv_) (* c (f2 gmv_)))))))
    (list 'AND (gmf-cont 'u 'h) '(= (CC-INT h p q) (+ (CC-INT f1 p q) (* c (CC-INT f2 p q)))))))))))))
(dk-peel!)
(gmf-road! 'u 'p 'q)
(fact 'cc-is-set)
(fact 'subclass-of-set-is-set 'u 'CC)
(dk-have! (list 'IN gmf-lc-k '(FUN u CC))
  (lambda ()
    (for-each (lambda (leaf) (dk-focus! leaf)
                (if (not (eq? (dk-head (dk-goal)) 'FORALL)) (dk-ass!)
                    (let ((w (dk-di-var!)))
                      (fact 'subset-mem-fwd 'u 'CC w)
                      (fact 'fun-apply-type-c 'f2 'u 'CC w)
                      (gmf-cc! (list '* 'c (list 'f2 w)))
                      (dk-ass!))))
              (dk-opened (lambda () (lam-t))))))
(define (gmf-lc-ptw! lhs-of rhs-of)
  (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES '(IN aix_ u) (list '== (lhs-of 'aix_) (rhs-of 'aix_))))
    (lambda ()
      (let ((w (dk-di-var!)))
        (fact 'subset-mem-fwd 'u 'CC w)
        (fact 'fun-apply-type-c 'f2 'u 'CC w)
        (fact 'fun-apply-type-c 'f1 'u 'CC w)
        (dk-apply! (dk-ctx-form '(FORALL gmv_ (IMPLIES (IN gmv_ u) (== (h gmv_) (+ (f1 gmv_) (* c (f2 gmv_))))))) w)
        (let ((g (dk-goal)))
          (if (dk--redex? g) (dk-lam-b!))
          (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
              (let ((g2 (dk-goal)))
                (if (equal? (cadr g2) (list 'h w))
                    (subst (list '= (list 'h w) (list '+ (list 'f1 w) (list '* 'c (list 'f2 w))))))
                (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (qrfl)))))))))
(gmf-lc-ptw! (lambda (w) (list gmf-lc-k w)) (lambda (w) (list '* 'c (list 'f2 w))))
(fact 'aif-cont-scale 'u 'c 'f2 gmf-lc-k)
(gmf-lc-ptw! (lambda (w) (list 'h w)) (lambda (w) (list '+ (list 'f1 w) (list gmf-lc-k w))))
(fact 'aif-cont-sum 'u 'f1 gmf-lc-k 'h)
(fact 'line-int-sum 'u 'f1 gmf-lc-k (gmf-ab-id 'p 'q) (gmf-ab-one 'p 'q) 'p 'q 'h)
(gmf-lc-ptw! (lambda (w) (list gmf-lc-k w)) (lambda (w) (list '* 'c (list 'f2 w))))
(fact 'line-int-scalar 'u 'f2 (gmf-ab-id 'p 'q) (gmf-ab-one 'p 'q) 'p 'q 'c gmf-lc-k)
(fact 'cc-int-as-line-int 'u 'h 'p 'q)
(fact 'cc-int-as-line-int 'u 'f1 'p 'q)
(fact 'cc-int-as-line-int 'u 'f2 'p 'q)
(fact 'line-int-in-cc 'u 'f1 (gmf-ab-id 'p 'q) (gmf-ab-one 'p 'q) 'p 'q)
(fact 'line-int-in-cc 'u 'f2 (gmf-ab-id 'p 'q) (gmf-ab-one 'p 'q) 'p 'q)
(gmf-cc! (list '+ (gmf-li 'f1 'p 'q) (list '* 'c (gmf-li 'f2 'p 'q))))
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (dk-ass!)
      (begin
        (subst (list '= '(CC-INT h p q) (gmf-li 'h 'p 'q)))
        (subst (list '= '(CC-INT f1 p q) (gmf-li 'f1 'p 'q)))
        (subst (list '= '(CC-INT f2 p q) (gmf-li 'f2 'p 'q)))
        (subst (list '= (gmf-li 'h 'p 'q) (list '+ (gmf-li 'f1 'p 'q) (gmf-li gmf-lc-k 'p 'q))))
        (gmf-subst-close! (list '= (gmf-li gmf-lc-k 'p 'q) (list '* 'c (gmf-li 'f2 'p 'q))))))))
(qed 'cc-int-linear-combination)
(topic! 'cc-int-linear-combination 'analysis)
(alias! 'cc-int-linear-combination "the integral over [a, b] is linear for functions continuous on a set containing [a, b]")

;;; the integrand's second-order expansion in z at a real point t > 0
(define gmf-ex-GI (lambda (y t) (list (list 'GAMMA-INTEGRAND y) t)))
(sp (make-wff (gmf-all '(x a t) (gmf-imps (list '(IN x CC) '(IN a CC) '(IN t RR) '(< 0 t))
  (list '= (list '- (list '- (gmf-ex-GI 'x 't) (gmf-ex-GI 'a 't)) (list '* '(- x a) (list '* (gmf-ex-GI 'a 't) '(LOG t))))
           (list '* (gmf-ex-GI 'a 't) '(- (- (CC-EXP (* (- x a) (LOG t))) 1) (* (- x a) (LOG t)))))))))
(dk-peel!)
(gmf-pos-in-rhp! 't)
(mac 'GAMMA-INTEGRAND)
(dk-lam-b!)
(fact 'cc-log-real 't)
(subst '(= (CC-LOG t) (LOG t)))
(let* ((L '(LOG t)) (u1 (list '* '(- a 1) L)) (u2 (list '* '(- x a) L)) (u3 (list '* '(- x 1) L)))
  (fact 'log-in-rr 't) (gmf-cc! L)
  (for-each gmf-cc! (list u1 u2 u3 '(- t) (list 'CC-EXP u1) (list 'CC-EXP u2) (list 'CC-EXP u3) '(CC-EXP (- t))))
  (fact 'cc-exp-add u1 u2)
  (gmf-cc! (list '+ u1 u2))
  (dk-have! (list '= u3 (list '+ u1 u2)) (lambda () (crs)))
  (dk-have! (list '= (list 'CC-EXP u3) (list '* (list 'CC-EXP u1) (list 'CC-EXP u2)))
    (lambda () (subst (list '= u3 (list '+ u1 u2))) (dk-ass!)))
  (subst (list '= (list 'CC-EXP u3) (list '* (list 'CC-EXP u1) (list 'CC-EXP u2))))
  (crs))
(qed 'gamma-integrand-expansion)

;;; |log t| <= |log p| + |log q| on [p, q], 0 < p
(define gmf-lam '(+ (abs (LOG p)) (abs (LOG q))))
(sp (make-wff (gmf-all '(p q t) (gmf-imps (list '(IN p RR) '(IN q RR) '(IN t RR) '(< 0 p) '(<= p t) '(<= t q))
  (list '<= '(abs (LOG t)) gmf-lam)))))
(dk-peel!)
(gmf-lt! 0 't)
(fact 'log-monotone 'p 't)
(fact 'log-monotone 't 'q)
(for-each (lambda (x) (fact 'log-in-rr x)) '(p q t))
(for-each (lambda (x) (gmf-rr! (list 'abs (list 'LOG x)))) '(p q t))
(fact 'rr-neg-abs-le '(LOG p)) (fact 'rr-le-abs '(LOG q))
(fact 'rr-abs-nonneg '(LOG p)) (fact 'rr-abs-nonneg '(LOG q))
(gmf-rr! gmf-lam)
(gmf-ineq! (list '<= (list '- gmf-lam) '(LOG t)) '(<= (- (abs (LOG p))) (LOG p)) '(<= (LOG p) (LOG t)) '(<= 0 (abs (LOG q))))
(gmf-ineq! (list '<= '(LOG t) gmf-lam) '(<= (LOG t) (LOG q)) '(<= (LOG q) (abs (LOG q))) '(<= 0 (abs (LOG p))))
(fact 'rr-abs-le-of-parts '(LOG t) gmf-lam)
(dk-ass!)
(qed 'log-abs-bound-on-interval)

;;; |GI(a)(t)| <= exp(|re a - 1| Lambda) on [p, q]
(define gmf-C1 (list 'CC-EXP (list '* '(abs (- (real-part a) 1)) gmf-lam)))
(sp (make-wff (gmf-all '(a p q t) (gmf-imps (list '(IN a CC) '(IN p RR) '(IN q RR) '(IN t RR) '(< 0 p) '(<= p t) '(<= t q))
  (list '<= (list 'magnitude (gmf-ex-GI 'a 't)) gmf-C1)))))
(dk-peel!)
(gmf-lt! 0 't)
(fact 'gamma-integrand-magnitude 'a 't)
(subst (list '= (list 'magnitude (gmf-ex-GI 'a 't)) '(CC-EXP (- (* (- (real-part a) 1) (LOG t)) t))))
(fact 'log-abs-bound-on-interval 'p 'q 't)
(let* ((c '(- (real-part a) 1)) (L '(LOG t)) (ac (list 'abs c)) (aL (list 'abs L)))
  (fact 'log-in-rr 't) (gmf-rr! c) (gmf-rr! ac) (gmf-rr! aL) (gmf-rr! gmf-lam)
  (gmf-rr! (list '* c L)) (gmf-rr! (list '* ac aL)) (gmf-rr! (list '* aL ac)) (gmf-rr! (list '* gmf-lam ac))
  (gmf-rr! (list '* ac gmf-lam))
  (fact 'rr-le-abs (list '* c L))
  (gmf-and! (list 'IN c 'RR) (list 'IN L 'RR))
  (fact 'rr-abs-mult c L)
  (fact 'rr-abs-nonneg c)
  (fact 'rr-mul-le-right aL gmf-lam ac)
  (dk-have! (list '= (list '* ac aL) (list '* aL ac)) (lambda () (crs)))
  (dk-have! (list '= (list '* gmf-lam ac) (list '* ac gmf-lam)) (lambda () (crs)))
  (gmf-rr! (list 'abs (list '* c L)))
  (gmf-rr! '(- (* (- (real-part a) 1) (LOG t)) t))
  (gmf-ineq! (list '<= '(- (* (- (real-part a) 1) (LOG t)) t) (list '* ac gmf-lam))
             (list '<= (list '* c L) (list 'abs (list '* c L)))
             (list '= (list 'abs (list '* c L)) (list '* ac aL))
             (list '= (list '* ac aL) (list '* aL ac))
             (list '<= (list '* aL ac) (list '* gmf-lam ac))
             (list '= (list '* gmf-lam ac) (list '* ac gmf-lam))
             '(< 0 t))
  (fact 'cc-exp-real-mono '(- (* (- (real-part a) 1) (LOG t)) t) (list '* ac gmf-lam))
  (dk-ass!))
(qed 'gamma-integrand-bound-interval)

;;; the pointwise quadratic estimate
(define gmf-mxa '(magnitude (- x a)))
(define gmf-qB (list '* (list '* gmf-C1 (list '* gmf-lam gmf-lam)) (list '* gmf-mxa gmf-mxa)))
(define gmf-qlhs (list '- (list '- (gmf-ex-GI 'x 't) (gmf-ex-GI 'a 't)) (list '* '(- x a) (list '* (gmf-ex-GI 'a 't) '(LOG t)))))
(sp (make-wff (gmf-all '(a x p q t) (gmf-imps (list '(IN a CC) '(IN x CC) '(IN p RR) '(IN q RR) '(IN t RR)
     '(< 0 p) '(<= p t) '(<= t q) (list '<= (list '* gmf-mxa gmf-lam) 1))
  (list '<= (list 'magnitude gmf-qlhs) gmf-qB)))))
(dk-peel!)
(gmf-lt! 0 't)
(gmf-pos-in-rhp! 't)
(let* ((GA (gmf-ex-GI 'a 't)) (L '(LOG t)) (v (list '* '(- x a) L))
       (wv (list '- (list '- (list 'CC-EXP v) 1) v)) (MV (list 'magnitude v)) (aL (list 'abs L))
       (B (list '* gmf-mxa gmf-lam)) (MW (list 'magnitude wv)) (MG (list 'magnitude GA)))
  (fact 'gamma-integrand-holomorphic 'a)
  (gmf-rhp-setup!)
  (dk-project! (list 'IN '(GAMMA-INTEGRAND a) (list 'FUN gmf-rhp 'CC))
               (lambda () (mac-h 'HOLOMORPHIC-ON (dk-ctx-form (list 'HOLOMORPHIC-ON gmf-rhp '(GAMMA-INTEGRAND a))))))
  (fact 'fun-apply-type-c '(GAMMA-INTEGRAND a) gmf-rhp 'CC 't)
  (fact 'gamma-integrand-expansion 'x 'a 't)
  (fact 'log-in-rr 't) (gmf-cc! L) (gmf-cc! '(- x a)) (gmf-cc! v) (gmf-cc! wv)
  (subst (list '= gmf-qlhs (list '* GA wv)))
  (gmf-and! (list 'IN GA 'CC) (list 'IN wv 'CC))
  (fact 'cc-magnitude-mul GA wv)
  (subst (list '= (list 'magnitude (list '* GA wv)) (list '* MG MW)))
  ;; |v| = |x - a| |log t| <= |x - a| Lambda <= 1
  (gmf-and! '(IN (- x a) CC) (list 'IN L 'CC))
  (fact 'cc-magnitude-mul '(- x a) L)
  (fact 'rr-magnitude-is-abs L)
  (for-each gmf-rr! (list MV gmf-mxa aL gmf-lam MW MG B gmf-C1 (list '* gmf-mxa aL) (list '* aL gmf-mxa)
                          (list '* gmf-lam gmf-mxa) (list '* MV MV) (list '* B MV) (list '* MV B) (list '* B B)
                          (list '* MG MW) (list '* gmf-C1 MW) (list '* MW gmf-C1) (list '* (list '* B B) gmf-C1) gmf-qB))
  (fact 'log-abs-bound-on-interval 'p 'q 't)
  (fact 'cc-magnitude-nonneg '(- x a))
  (fact 'rr-mul-le-right aL gmf-lam gmf-mxa)
  (dk-have! (list '= MV (list '* gmf-mxa aL))
    (lambda () (subst (list '= MV (list '* gmf-mxa (list 'magnitude L)))) (gmf-subst-close! (list '= (list 'magnitude L) aL))))
  (dk-have! (list '= (list '* gmf-mxa aL) (list '* aL gmf-mxa)) (lambda () (crs)))
  (dk-have! (list '= (list '* gmf-lam gmf-mxa) B) (lambda () (crs)))
  (gmf-ineq! (list '<= MV B) (list '= MV (list '* gmf-mxa aL)) (list '= (list '* gmf-mxa aL) (list '* aL gmf-mxa))
             (list '<= (list '* aL gmf-mxa) (list '* gmf-lam gmf-mxa)) (list '= (list '* gmf-lam gmf-mxa) B))
  (gmf-ineq! (list '<= MV 1) (list '<= MV B) (list '<= B 1))
  ;; |W| <= |v|^2 <= B B
  (fact 'cc-exp-near-one v)
  (gmf-rr! (list 'power MV 2))
  (dk-have! (list '= (list 'power MV 2) (list '* MV MV)) (lambda () (crs)))
  (fact 'cc-magnitude-nonneg v)
  (fact 'cc-magnitude-nonneg wv)
  (fact 'cc-magnitude-nonneg GA)
  (gmf-ineq! (list '<= 0 B) (list '<= 0 MV) (list '<= MV B))
  (fact 'rr-mul-le-right MV B MV)
  (fact 'rr-mul-le-right MV B B)
  (dk-have! (list '= (list '* B MV) (list '* MV B)) (lambda () (crs)))
  (gmf-ineq! (list '<= MW (list '* B B)) (list '<= MW (list 'power MV 2)) (list '= (list 'power MV 2) (list '* MV MV))
             (list '<= (list '* MV MV) (list '* B MV)) (list '= (list '* B MV) (list '* MV B)) (list '<= (list '* MV B) (list '* B B)))
  ;; |GA| |W| <= C1 |W| <= C1 B B
  (fact 'gamma-integrand-bound-interval 'a 'p 'q 't)
  (gmf-rr! (list '* (list 'abs '(- (real-part a) 1)) gmf-lam))
  (gmf-cite-split! 'cc-exp-real (list '* (list 'abs '(- (real-part a) 1)) gmf-lam))
  (gmf-ineq! (list '<= 0 gmf-C1) (list '< 0 gmf-C1))
  (fact 'rr-mul-le-right MG gmf-C1 MW)
  (fact 'rr-mul-le-right MW (list '* B B) gmf-C1)
  (dk-have! (list '= (list '* gmf-C1 MW) (list '* MW gmf-C1)) (lambda () (crs)))
  (dk-have! (list '= (list '* (list '* B B) gmf-C1) gmf-qB) (lambda () (crs)))
  (gmf-ineq! (dk-goal) (list '<= (list '* MG MW) (list '* gmf-C1 MW)) (list '= (list '* gmf-C1 MW) (list '* MW gmf-C1))
             (list '<= (list '* MW gmf-C1) (list '* (list '* B B) gmf-C1)) (list '= (list '* (list '* B B) gmf-C1) gmf-qB)))
(qed 'gamma-integrand-quadratic)

;;; the derivative integrand t |-> t^{a-1} e^{-t} log t, and the integral estimate
(define (gmf-DF a) (list 'VNB-LAMBDA 'gmw_ gmf-rhp
  (list '* (list '* (list 'CC-EXP (list '* (list '- a 1) '(CC-LOG gmw_))) '(CC-EXP (- gmw_))) '(CC-LOG gmw_))))
(define gmf-tq-h1 (list 'VNB-LAMBDA 'gmh_ gmf-rhp (list '+ '((GAMMA-INTEGRAND a) gmh_) (list '* '(- x a) (list (gmf-DF 'a) 'gmh_)))))
(define gmf-tq-h2 (list 'VNB-LAMBDA 'gmh_ gmf-rhp (list '+ '((GAMMA-INTEGRAND x) gmh_) (list '* -1 (list gmf-tq-h1 'gmh_)))))
(define gmf-tq-qB (gmf-subst-sym gmf-qB 't 't))
(define gmf-tq-goal
  (list '<= (list 'magnitude (list '- (list '- '(CC-INT (GAMMA-INTEGRAND x) p q) '(CC-INT (GAMMA-INTEGRAND a) p q))
                                   (list '* '(- x a) (list 'CC-INT (gmf-DF 'a) 'p 'q))))
        (list '* '(- q p) gmf-qB)))
(sp (make-wff (gmf-all '(a x p q) (gmf-imps (list '(IN a CC) '(IN x CC) '(IN p RR) '(IN q RR) '(< 0 p) '(< p q)
     (list '<= (list '* gmf-mxa gmf-lam) 1))
  gmf-tq-goal))))
(dk-peel!)
(gmf-rhp-setup!)
(gmf-GI-setup! 'a)
(gmf-GI-setup! 'x)
(fact 'ccint-in-right-half-plane 'p 'q)
(gmf-cc! '(- x a))
(gmf-holo-setup! (gmf-DF 'a))
(define (gmf-tq-typ! lam pre)
  (dk-have! (list 'IN lam (list 'FUN gmf-rhp 'CC))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((w (dk-di-var!)))
            (pre w)
            (gmf-cc! (cadr (dk-goal)))
            (dk-ass!)))))))
(define (gmf-tq-pt! w)
  (fact 'fun-apply-type-c '(GAMMA-INTEGRAND a) gmf-rhp 'CC w)
  (fact 'fun-apply-type-c '(GAMMA-INTEGRAND x) gmf-rhp 'CC w)
  (fact 'fun-apply-type-c (gmf-DF 'a) gmf-rhp 'CC w))
(gmf-tq-typ! gmf-tq-h1 (lambda (w) (gmf-tq-pt! w) (gmf-cc! (list '* '(- x a) (list (gmf-DF 'a) w)))))
;;; a pointwise beta identity h(w) == body, proved by reducing both sides
(define gmf-tq-ptw-prover
  (list (cons (lambda (an) (dk-head-is? an 'FORALL))
              (lambda ()
                (let ((w (dk-di-var!)))
                  (gmf-tq-pt! w)
                  (dk-lam-b!)
                  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (qrfl)))))))
(define gmf-tq-lc1 (dk-chain! (dk-cite! 'cc-int-linear-combination gmf-rhp '(GAMMA-INTEGRAND a) (gmf-DF 'a) 'p 'q '(- x a) gmf-tq-h1)
                              gmf-tq-ptw-prover))
(dk-split-all! (list gmf-tq-lc1))
(gmf-tq-typ! gmf-tq-h2 (lambda (w) (gmf-tq-pt! w) (fact 'fun-apply-type-c gmf-tq-h1 gmf-rhp 'CC w)
                         (gmf-cc! (list '* -1 (list gmf-tq-h1 w)))))
(define gmf-tq-lc2 (dk-chain! (dk-cite! 'cc-int-linear-combination gmf-rhp '(GAMMA-INTEGRAND x) gmf-tq-h1 'p 'q -1 gmf-tq-h2)
                              gmf-tq-ptw-prover))
(dk-split-all! (list gmf-tq-lc2))
;;; the comparison with the constant B on [p, q], B named bv
(gmf-rr! gmf-qB)
(define gmf-tq-bv (dk-name! gmf-qB))
(gmf-cc! gmf-tq-bv)
(define gmf-tq-gd (list 'VNB-LAMBDA 'gmw_ gmf-rhp gmf-tq-bv))
(define gmf-tq-gp (list 'VNB-LAMBDA 'gmw_ gmf-rhp (list '* gmf-tq-bv 'gmw_)))
(gmf-holo-setup! gmf-tq-gp)
(dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES (list 'IN 'hbz_ gmf-rhp)
            (list 'IS-DIFF-ON 'CC-NORMED-FIELD gmf-rhp gmf-tq-gp 'hbz_ (list gmf-tq-gd 'hbz_))))
  (lambda ()
    (let* ((w (dk-di-var!)))
      (dk-diff! gmf-rhp gmf-tq-gp w gmf-tq-bv)
      (dk-have! (list '= (list gmf-tq-gd w) gmf-tq-bv) (lambda () (if (not (dk-lam-b!)) (rfl))))
      (subst (list '= (list gmf-tq-gd w) gmf-tq-bv))
      (dk-ass!))))
(gmf-holo-setup! gmf-tq-gd)
(gmf-re-im-real! gmf-tq-bv)
(dk-have! (list 'FORALL 'gmy_ (list 'IMPLIES '(IN gmy_ (CCINT p q))
            (list '<= (list 'magnitude (list gmf-tq-h2 'gmy_)) (list 'real-part (list gmf-tq-gd 'gmy_)))))
  (lambda ()
    (let* ((y (dk-di-var!))
           (L (list 'LOG y)) (GA (gmf-ex-GI 'a y)) (GX (gmf-ex-GI 'x y))
           (e1 (list 'CC-EXP (list '* '(- a 1) L))) (e2 (list 'CC-EXP (list '- y)))
           (qlhs (list '- (list '- GX GA) (list '* '(- x a) (list '* GA L)))))
      (gmf-ccint-parts! y 'p 'q)
      (gmf-lt! 0 y)
      (gmf-pos-in-rhp! y)
      (gmf-tq-pt! y)
      (fact 'cc-log-real y)
      (fact 'log-in-rr y) (gmf-cc! L)
      (dk-lam-b!)
      (subst (list '= (list 'CC-LOG y) L))
      (gmf-cc! e1) (gmf-cc! e2)
      (dk-have! (list '= GA (list '* e1 e2))
        (lambda () (mac 'GAMMA-INTEGRAND) (dk-lam-b!)
                   (gmf-subst-close! (list '= (list 'CC-LOG y) L))))
      (subst (list '= (list '* e1 e2) GA))
      (subst (list '= (list 'real-part gmf-tq-bv) gmf-tq-bv))
      (subst (list '= gmf-tq-bv gmf-qB))
      (let* ((g (dk-goal)) (inner (cadr (cadr g))))
        (gmf-cc! inner) (gmf-cc! qlhs)
        (dk-have! (list '= inner qlhs) (lambda () (crs)))
        (subst (list '= inner qlhs)))
      (fact 'gamma-integrand-quadratic 'a 'x 'p 'q y)
      (dk-ass!))))
(fact 'cc-int-compare-primitive gmf-rhp gmf-tq-h2 gmf-tq-gd gmf-tq-gp 'p 'q)
(gmf-le! 'p 'p) (gmf-le! 'q 'q) (gmf-le! 'p 'q)
(gmf-pos-in-rhp! 'p)
(gmf-lt! 0 'q)
(gmf-pos-in-rhp! 'q)
(let* ((vq (list '* gmf-tq-bv 'q)) (vp (list '* gmf-tq-bv 'p))
       (dg (list '- (list gmf-tq-gp 'q) (list gmf-tq-gp 'p)))
       (Ix '(CC-INT (GAMMA-INTEGRAND x) p q)) (Ia '(CC-INT (GAMMA-INTEGRAND a) p q))
       (D (list 'CC-INT (gmf-DF 'a) 'p 'q)) (I1 (list 'CC-INT gmf-tq-h1 'p 'q)) (I2 (list 'CC-INT gmf-tq-h2 'p 'q))
       (tgt (list '- (list '- Ix Ia) (list '* '(- x a) D))))
  (gmf-rr! vq) (gmf-rr! vp) (gmf-rr! (list '- vq vp))
  (dk-have! (list '= (list gmf-tq-gp 'q) vq) (lambda () (if (not (dk-lam-b!)) (rfl))))
  (dk-have! (list '= (list gmf-tq-gp 'p) vp) (lambda () (if (not (dk-lam-b!)) (rfl))))
  (gmf-re-im-real! (list '- vq vp))
  (dk-have! (list '= (list 'real-part dg) (list '- vq vp))
    (lambda () (subst (list '= (list gmf-tq-gp 'q) vq)) (subst (list '= (list gmf-tq-gp 'p) vp))
                (gmf-subst-close! (list '= (list 'real-part (list '- vq vp)) (list '- vq vp)))))
  (for-each (lambda (f) (dk-cite! 'cc-int-in-cc-of-continuous gmf-rhp f 'p 'q))
            (list '(GAMMA-INTEGRAND x) '(GAMMA-INTEGRAND a) (gmf-DF 'a) gmf-tq-h1 gmf-tq-h2))
  (gmf-cc! tgt)
  (dk-have! (list '= tgt I2)
    (lambda ()
      (subst (list '= I2 (list '+ Ix (list '* -1 I1))))
      (subst (list '= I1 (list '+ Ia (list '* '(- x a) D))))
      (crs)))
  (subst (list '= tgt I2))
  (gmf-rr! (list 'magnitude I2)) (gmf-rr! (list 'real-part dg))
  (subst (list '= gmf-qB gmf-tq-bv))
  (gmf-rr! (list '* '(- q p) gmf-tq-bv))
  (dk-have! (list '= (list '- vq vp) (list '* '(- q p) gmf-tq-bv)) (lambda () (crs)))
  (gmf-ineq! (dk-goal) (list '<= (list 'magnitude I2) (list 'real-part dg)) (list '= (list 'real-part dg) (list '- vq vp))
            (list '= (list '- vq vp) (list '* '(- q p) gmf-tq-bv))))
(qed 'gamma-truncation-quadratic)
;;; ---------------------------------------------------------------------
;;; (13) THE TRUNCATIONS ARE HOLOMORPHIC ON THE HALF-PLANE
;;; ---------------------------------------------------------------------
(define (gmf-T p q) (list 'VNB-LAMBDA 'gmx_ gmf-rhp (list 'CC-INT '(GAMMA-INTEGRAND gmx_) p q)))
(define gmf-th-m (list '* '(- q p) (list '* gmf-C1 (list '* gmf-lam gmf-lam))))
(sp (make-wff (gmf-all '(p q) (gmf-imps (list '(IN p RR) '(IN q RR) '(< 0 p) '(< p q))
  (list 'HOLOMORPHIC-ON gmf-rhp (gmf-T 'p 'q))))))
(dk-peel!)
(gmf-rhp-setup!)
(dk-have! (list 'IN (gmf-T 'p 'q) (list 'FUN gmf-rhp 'CC))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((w (dk-di-var!)))
          (gmf-rhp-open! w)
          (dk-cite! 'gamma-integrand-locint w 'p 'q)
          (dk-ass!))))))
(mac 'HOLOMORPHIC-ON)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (dk-ass!)
      (let* ((a (dk-di-var!))
             (D (list 'CC-INT (gmf-DF a) 'p 'q))
             (lam (gmf-subst-sym gmf-lam 'p 'p))
             (C1 (gmf-subst-sym gmf-C1 'a a))
             (m (gmf-subst-sym gmf-th-m 'a a))
             (l1 (list '+ lam 1))
             (rho (list 'recip l1)))
        (gmf-rhp-open! a)
        ;; D is defined: the derivative integrand is holomorphic, hence continuous
        (gmf-holo-setup! (gmf-DF a))
        (fact 'ccint-in-right-half-plane 'p 'q)
        (dk-cite! 'cc-int-in-cc-of-continuous gmf-rhp (gmf-DF a) 'p 'q)
        (ew D)
        ;; the constants
        (for-each (lambda (x) (fact 'log-in-rr x) (gmf-rr! (list 'abs (list 'LOG x))) (fact 'rr-abs-nonneg (list 'LOG x))) '(p q))
        (gmf-rr! lam) (gmf-ineq! (list '<= 0 lam))
        (gmf-rr! (list '- (list 'real-part a) 1)) (gmf-rr! (list 'abs (list '- (list 'real-part a) 1)))
        (gmf-rr! (list '* (list 'abs (list '- (list 'real-part a) 1)) lam))
        (gmf-cite-split! 'cc-exp-real (list '* (list 'abs (list '- (list 'real-part a) 1)) lam))
        (gmf-rr! C1) (gmf-ineq! (list '<= 0 C1) (list '< 0 C1))
        (gmf-rr! l1) (gmf-ineq! (list '< 0 l1)) (gmf-ineq! (list '<= 0 l1)) (gmf-ineq! (list '<= 0 '(- q p)))
        (gmf-nonneg-mul! lam lam)
        (gmf-nonneg-mul! C1 (list '* lam lam))
        (gmf-nonneg-mul! '(- q p) (list '* C1 (list '* lam lam)))
        (fact 'rr-pos-ne-zero l1)
        (gmf-rr! rho) (fact 'rr-recip-pos l1) (fact 'rr-pos-rr-of-lt rho)
        (gmf-and! (list 'IN l1 'RR) (list 'NOT (list '= l1 0)))
        (fact 'rr-recip-inverse l1)
        (dk-chain! (dk-cite! 'cc-diff-on-local-quadratic gmf-rhp (gmf-T 'p 'q) a D m rho)
          (list (cons (lambda (an) (dk-head-is? an 'FORALL))
            (lambda ()
              (let* ((x (dk-di-var!)) (mxa (list 'magnitude (list '- x a))))
                (dk-peel!)
                (gmf-rhp-open! x)
                (gmf-cc! (list '- x a)) (gmf-rr! mxa) (fact 'cc-magnitude-nonneg (list '- x a))
                ;; |x - a| Lambda <= 1
                (gmf-rr! (list '* mxa l1)) (gmf-rr! (list '* rho l1)) (gmf-rr! (list '* l1 rho)) (gmf-rr! (list '* mxa lam))
                (gmf-ineq! (list '<= mxa rho))
                (fact 'rr-mul-le-right mxa rho l1)
                (dk-have! (list '= (list '* rho l1) (list '* l1 rho)) (lambda () (crs)))
                (dk-have! (list '= (list '* mxa l1) (list '+ (list '* mxa lam) mxa)) (lambda () (crs)))
                (gmf-ineq! (list '<= (list '* mxa lam) 1)
                           (list '<= (list '* mxa l1) (list '* rho l1)) (list '= (list '* rho l1) (list '* l1 rho))
                           (list '= (list '* l1 rho) 1) (list '= (list '* mxa l1) (list '+ (list '* mxa lam) mxa))
                           (list '<= 0 mxa))
                (fact 'gamma-truncation-quadratic a x 'p 'q)
                (dk-lam-b!)
                (let* ((qB (list '* (list '* C1 (list '* lam lam)) (list '* mxa mxa)))
                       (lhs (list '* '(- q p) qB)) (rhs (list '* m (list '* mxa mxa))))
                  (gmf-rr! qB) (gmf-rr! lhs) (gmf-rr! rhs)
                  (dk-have! (list '= lhs rhs) (lambda () (crs)))
                  (subst (list '= rhs lhs))
                  (dk-ass!)))))))
        (dk-ass!)))))
(qed 'gamma-truncation-holomorphic)
(topic! 'gamma-truncation-holomorphic 'analysis)
(alias! 'gamma-truncation-holomorphic "the truncated Gamma integrals int_r^R t^(z-1) e^(-t) dt are holomorphic in z")
;;; ---------------------------------------------------------------------
;;; (14) LOCALLY UNIFORM CONVERGENCE OF THE TRUNCATIONS, AND THE THEOREM OF 3.9:
;;;      GAMMA IS HOLOMORPHIC ON THE RIGHT HALF-PLANE (Proposition 3.59)
;;; ---------------------------------------------------------------------
(define gmf-er-K '(* A (- (LOG (* 2 A)) 1)))
(define gmf-er-T (list '+ (gmf-pw 's0 'rl) (gmf-ex gmf-er-K 'rh)))
(sp (make-wff (gmf-all '(z s0 s1 A rl rh) (gmf-imps (list '(IN z CC) '(IN s0 RR) '(IN s1 RR) '(IN A RR) '(IN rl RR) '(IN rh RR)
     '(< 0 s0) '(<= s0 (real-part z)) '(<= (real-part z) s1) '(<= 1 A) '(<= (- s1 1) A)
     '(< 0 rl) '(<= rl 1) '(<= 1 rh) '(< rl rh))
  (list '<= '(magnitude (- (GAMMA-FUNCTION z) (CC-INT (GAMMA-INTEGRAND z) rl rh))) gmf-er-T)))))
(dk-peel!)
(gmf-z-setup!)
(gmf-rr! '(real-part z))
(gmf-lt! 0 '(real-part z))
(fact 'gamma-converges 'z)
(gmf-conv-open! '(GAMMA-INTEGRAND z) '(GAMMA-FUNCTION z))
(gmf-I! 'rl 'rh)
(for-each gmf-rr! (list gmf-er-K (gmf-pw 's0 'rl) (gmf-ex gmf-er-K 'rh) gmf-er-T))
(dk-chain! (dk-cite! 'improper-int-tail-bound '(GAMMA-INTEGRAND z) '(GAMMA-FUNCTION z) 'rl 'rh gmf-er-T)
  (list (cons (lambda (an) (dk-head-is? an 'FORALL))
    (lambda ()
      (let* ((_ (dk-peel!))
             (i1 (cadr (cadr (cadr (dk-goal)))))
             (r1 (caddr i1)) (q1 (cadddr i1)))
        (gmf-lt! r1 'rh) (gmf-lt! 'rl q1) (gmf-lt! 0 'rh) (gmf-lt! 0 q1) (gmf-lt! r1 q1)
        (gmf-I! r1 q1)
        (gmf-split! r1 q1 'rl)
        (gmf-split! 'rl q1 'rh)
        (fact 'gamma-tail-small 'z 's0 r1 'rl)
        (fact 'gamma-tail-large 'z 's1 'A 'rh q1)
        (let* ((dd (list '- (gmf-I r1 q1) (gmf-I 'rl 'rh)))
               (u (gmf-I r1 'rl)) (v (gmf-I 'rh q1)))
          (gmf-mag-typ! dd) (gmf-mag-typ! u) (gmf-mag-typ! v) (gmf-cc! (list '+ u v))
          (dk-have! (list '= dd (list '+ u v))
            (lambda ()
              (subst (list '= (gmf-I r1 q1) (list '+ u (gmf-I 'rl q1))))
              (subst (list '= (gmf-I 'rl q1) (list '+ (gmf-I 'rl 'rh) v)))
              (crs)))
          (gmf-and! (list 'IN u 'CC) (list 'IN v 'CC))
          (fact 'cc-magnitude-triangle u v)
          (gmf-rr! (list 'magnitude (list '+ u v)))
          (dk-have! (list '= (list 'magnitude dd) (list 'magnitude (list '+ u v)))
            (lambda () (gmf-subst-close! (list '= dd (list '+ u v)))))
          (gmf-ineq! (dk-goal) (list '= (list 'magnitude dd) (list 'magnitude (list '+ u v)))
                     (list '<= (list 'magnitude (list '+ u v)) (list '+ (list 'magnitude u) (list 'magnitude v)))
                     (list '<= (list 'magnitude u) (gmf-pw 's0 'rl))
                     (list '<= (list 'magnitude v) (gmf-ex gmf-er-K 'rh)))))))))
(dk-ass!)
(qed 'gamma-truncation-error)

;;; the family of truncations g_k = int_{1/(k+1)}^{k+2}, and the Gamma function as a function on H
(define gmf-mn-fam (list 'VNB-LAMBDA 'gmk_ 'NN (gmf-T '(recip (+ gmk_ 1)) '(+ gmk_ 2))))
(define gmf-mn-f (list 'VNB-LAMBDA 'gmx_ gmf-rhp '(GAMMA-FUNCTION gmx_)))
(define (gmf-mn-unif S)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'aicap_ (list 'AND '(IN aicap_ NN)
      (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES '(<= aicap_ k)
        (list 'FORALL 'aiy_ (list 'IMPLIES (list 'IN 'aiy_ S)
          (list '<= (list 'magnitude (list '- (list (list gmf-mn-fam 'k) 'aiy_) (list gmf-mn-f 'aiy_))) 'eps)))))))))))
(define gmf-mn-LU
  (list 'FORALL 'mrlz_ (list 'IMPLIES (list 'IN 'mrlz_ gmf-rhp)
    (list 'FORSOME 'mrlr_ (list 'AND '(POS-RR mrlr_)
      (list 'AND (list 'SUBSET '(BALL CC-MS mrlz_ mrlr_) gmf-rhp) (gmf-mn-unif '(BALL CC-MS mrlz_ mrlr_))))))))
(define gmf-mn-famhol (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'HOLOMORPHIC-ON gmf-rhp (list gmf-mn-fam 'k)))))
;;; y in the ball about z0 of radius x0/2 (x0 = re z0): land y in CC and x0/2 <= re y <= 3 x0/2
(define (gmf-mn-ball-pt! z0 rho y)
  (let* ((x0 (list 'real-part z0)) (ry (list 'real-part y)) (dyz (list 'magnitude (list '- y z0))))
    (gmf-ball-open! z0 rho y)
    (gmf-rr! ry) (gmf-rr! dyz)
    (gmf-rr! (list '- ry x0))
    (fact 'cc-re-dist-le y z0)
    (gmf-cite-split! 'rr-abs-le-parts (list '- ry x0) dyz)
    (gmf-ineq! (list '< 0 ry) (list '<= (list '- dyz) (list '- ry x0)) (list '< dyz rho) (list '= rho (list '* 1/2 x0))
               (list '< 0 x0))
    (gmf-ineq! (list '<= (list '* 1/2 x0) ry) (list '<= (list '- dyz) (list '- ry x0)) (list '< dyz rho) (list '= rho (list '* 1/2 x0)))
    (gmf-ineq! (list '<= ry (list '* 3/2 x0)) (list '<= (list '- ry x0) dyz) (list '< dyz rho) (list '= rho (list '* 1/2 x0)))))

(sp (make-wff (list 'HOLOMORPHIC-ON gmf-rhp gmf-mn-f)))
(gmf-rhp-setup!)
(fact 'nn-is-set)
(dk-have! gmf-mn-famhol
  (lambda ()
    (let ((k (dk-di-var!)))
      (gmf-idx! k)
      (dk-lam-b!)
      (fact 'gamma-truncation-holomorphic '(recip (+ k 1)) '(+ k 2))
      (dk-ass!))))
(dk-have! (list 'IN gmf-mn-f (list 'FUN gmf-rhp 'CC))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((w (dk-di-var!)))
          (gmf-rhp-open! w)
          (gmf-rr! (list 'real-part w))
          (fact 'gamma-converges w)
          (mac-h 'IMPROPER-INT-CONVERGES-TO
                 (dk-ctx-form (list 'IMPROPER-INT-CONVERGES-TO (list 'GAMMA-INTEGRAND w) (list 'GAMMA-FUNCTION w))))
          (dk-split-all!)
          (dk-ass!))))))
(dk-have! gmf-mn-LU
  (lambda ()
    (let* ((z0 (dk-di-var!)) (x0 (list 'real-part z0)) (rho (list '* 1/2 x0)))
      (gmf-rhp-open! z0)
      (gmf-rr! x0) (gmf-rr! rho)
      (dk-have! (list '= rho (list '* 1/2 x0)) (lambda () (rfl)))
      (gmf-lt! 0 rho)
      (fact 'rr-pos-rr-of-lt rho)
      (ew rho)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-asm? g) (dk-ass!))
              ((dk-head-is? g 'SUBSET)
               (let ((y (subset-by-element!)))
                 (gmf-mn-ball-pt! z0 rho y)
                 (gmf-rhp-in! y)
                 (dk-ass!)))
              (#t
               (let* ((eps (dk-di-var! (lambda (g) (cadr (cadr g))))))
                 (dk-peel!)
                 (fact 'rr-pos-rr-in-rr eps)
                 (let* ((e2 (dk-halve! eps))
                        (s0 (list '* 1/2 x0)) (s1 (list '* 3/2 x0)) (A (list '+ s1 1))
                        (kexp (list '* A (list '- (list 'LOG (list '* 2 A)) 1))))
                   (for-each gmf-rr! (list s0 s1 A kexp))
                   (gmf-lt! 0 s0) (gmf-le! 1 A) (gmf-le! (list '- s1 1) A)
                   (let* ((d (dk-skolem! (dk-cite! 'rr-power-small-at-zero s0 e2)))
                          (m (dk-skolem! (dk-cite! 'exp-tail-small-at-infinity kexp e2)))
                          (_pd (fact 'rr-pos-rr-of-lt d))
                          (ns (gmf-big-index! d m))
                          (n1 (car ns)) (n2 (cadr ns))
                          (N (list '+ n1 n2)))
                     (gmf-and! (list 'IN n1 'NN) (list 'IN n2 'NN))
                     (fact 'nn-add-closed n1 n2)
                     (ew N)
                     (dk-conj-close!
                       (lambda ()
                         (if (dk-asm? (dk-goal)) (dk-ass!)
                           (let* ((_ (dk-peel!))
                                  (gl (dk-goal))
                                  (app (cadr (cadr (cadr gl))))          ; ((fam k) y)
                                  (k (cadr (car app))) (y (cadr app))
                                  (smallk (list 'recip (list '+ k 1))) (bigk (list '+ k 2))
                                  (I (list 'CC-INT (list 'GAMMA-INTEGRAND y) smallk bigk))
                                  (gamy (list 'GAMMA-FUNCTION y)))
                             (gmf-mn-ball-pt! z0 rho y)
                             (gmf-rhp-in! y)
                             (gmf-idx! k)
                             (gmf-le! n1 k)
                             (fact 'nn-recip-succ-antitone n1 k)
                             (gmf-le! smallk d)
                             (gmf-ineq! (list '<= m (list '* n2 1)))
                             (gmf-le! m bigk) (gmf-le! 1 bigk)
                             (fact 'gamma-truncation-error y s0 s1 A smallk bigk)
                             (fact 'rr-power-monotone s0 smallk d)
                             (fact 'exp-tail-monotone kexp m bigk)
                             (gmf-rr! (gmf-pw s0 smallk)) (gmf-rr! (gmf-pw s0 d))
                             (gmf-rr! (gmf-ex kexp bigk)) (gmf-rr! (gmf-ex kexp m))
                             (fact 'gamma-converges y)
                             (gmf-conv-open! (list 'GAMMA-INTEGRAND y) gamy)
                             (dk-cite! 'gamma-integrand-locint y smallk bigk)
                             (dk-lam-b!)
                             (fact 'cc-magnitude-sub-sym I gamy)
                             (gmf-mag-typ! (list '- I gamy)) (gmf-mag-typ! (list '- gamy I))
                             (gmf-ineq! (dk-goal)
                               (list '= (list 'magnitude (list '- I gamy)) (list 'magnitude (list '- gamy I)))
                               (list '<= (list 'magnitude (list '- gamy I)) (list '+ (gmf-pw s0 smallk) (gmf-ex kexp bigk)))
                               (list '<= (gmf-pw s0 smallk) (gmf-pw s0 d)) (list '<= (gmf-pw s0 d) e2)
                               (list '<= (gmf-ex kexp bigk) (gmf-ex kexp m)) (list '<= (gmf-ex kexp m) e2)
                               (list '= (list '+ e2 e2) eps)))))))))))))))))
