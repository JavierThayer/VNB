(fact 'line-int-in-cc 'u 'f (gmf-ab-id 'a 'b) (gmf-ab-one 'a 'b) 'a 'b)
(gmf-subst-close! (list '= '(CC-INT f a b) (gmf-li 'f 'a 'b)))
