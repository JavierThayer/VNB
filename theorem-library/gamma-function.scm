(gmf-rr! '(magnitude 1))
(dk-have! '(= (magnitude 1) 1) (lambda () (fact 'rr-magnitude-is-abs 1) (subst '(= (magnitude 1) (abs 1))) (arith)))
(define (gmf-cp-mul1! x)   ; land x * 1 = x
  (let ((e (list '= (list '* x 1) x))) (if (not (dk-asm? e)) (dk-have! e (lambda () (crs)))) e))
(dk-have! (list 'FORALL 'liy_ (list 'IMPLIES '(IN liy_ (CCINT a b))
            (list '== (list gmf-cp-liab 'liy_)
