(define gmf-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (gmf-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (gmf-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u)
    (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS gmf-nfm u) gmf-nfm f 'rgy_))))
(define (gmf-imps hyps body)
  (if (null? hyps) body (list 'IMPLIES (car hyps) (gmf-imps (cdr hyps) body))))
(define (gmf-all vars body)
  (if (null? vars) body (list 'FORALL (car vars) (gmf-all (cdr vars) body))))
(define (gmf-and! a b)
  (let* ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))

(define (gmf-rr! t)
  (let* ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((eq? t 'PI) (gmf-cite-split! 'pi-pos) typ)
          ((number? t) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((gmf-op? t 'succ 2) (gmf-nn! t) (fact 'nn-in-rr t) typ)
          ((gmf-op? t '* 3) (gmf-rr! (cadr t)) (gmf-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((gmf-op? t '+ 3) (gmf-rr! (cadr t)) (gmf-rr! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((gmf-op? t '- 3) (gmf-rr! (cadr t)) (gmf-rr! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((gmf-op? t '- 2) (gmf-rr! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((gmf-op? t 'magnitude 2) (gmf-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((gmf-op? t 'real-part 2) (gmf-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((gmf-op? t 'imag-part 2) (gmf-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((gmf-op? t 'abs 2) (gmf-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((gmf-op? t 'LOG 2) (fact 'log-in-rr (cadr t)) typ)
          ((and (gmf-op? t 'CC-EXP 2) (or (dk-asm? (list 'IN (cadr t) 'RR)) (begin (gmf-rr! (cadr t)) #t)))
           (gmf-cite-split! 'cc-exp-real (cadr t)) typ)
          ((gmf-op? t 'recip 2)
           (gmf-rr! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (if (dk-asm? (list '< 0 (cadr t)))
                   (fact 'rr-pos-ne-zero (cadr t))
                   (error "gmf-rr!: land the non-vanishing first" (expression->string (cadr t)))))
           (gmf-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t))
           typ)
          (#t (dk-real! t) typ))))
(define (gmf-nn! t)
  (let* ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((gmf-op? t 'succ 2) (gmf-nn! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          (#t (dk-type! t 'NN)))))
(define (gmf-cc! t)
  (let* ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((or (and (number? t) (real? t)) (eq? t 'PI) (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
               (gmf-op? t 'succ 2)
               (gmf-op? t 'magnitude 2) (gmf-op? t 'real-part 2) (gmf-op? t 'imag-part 2) (gmf-op? t 'LOG 2))
           (gmf-rr! t) (fact 'rr-subset-cc t) typ)
          ((gmf-op? t '- 3) (gmf-cc! (cadr t)) (gmf-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((gmf-op? t '- 2) (gmf-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((gmf-op? t '+ 3) (gmf-cc! (cadr t)) (gmf-cc! (caddr t))
           (gmf-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((gmf-op? t '* 3) (gmf-cc! (cadr t)) (gmf-cc! (caddr t))
           (gmf-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((gmf-op? t 'power 3) (gmf-cc! (cadr t)) (gmf-nn! (caddr t))
           (gmf-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((gmf-op? t 'CC-EXP 2) (gmf-cc! (cadr t))
           (gmf-cite-split! 'cc-exp-converges (cadr t)) typ)
          ((gmf-op? t 'recip 2) (gmf-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "gmf-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (gmf-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (dk-type! t 'CC)))))

(define (gmf-steps . thunks)
  ;; run THUNKS in order while the leaf focused at the start stays open
  (let* ((leaf (proof-state-focus *ps*)))
    (let loop ((ts thunks))
      (if (and (pair? ts) (not (sequent-node-grounded? leaf)))
          (begin ((car ts)) (loop (cdr ts)))))))



(define (gmf-only-prop! . fs) (if (apply dk-only! fs) (prop)))

;;; subst EQ in a == goal, then qrfl on the same leaf unless the subst closed it
(define (gmf-subst-qrfl! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (qrfl))))
;;; x in BALL(CC-MS, c, r) in context: land x in CC and |x - c| < r; return the latter
(define (gmf-ball-open! c r x)
  ;; x in BALL(CC-MS, c, r) in context: land x in CC and |x - c| < r (stops early when a
  ;; landing closes the focus leaf, the claim being the goal)
  (let* ((dcx (list '(DIST CC-MS) c x))
         (mag (list 'magnitude (list '- c x)))
         (mag2 (list 'magnitude (list '- x c)))
         (cj  (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list '<= dcx r) (list 'NOT (list '= dcx r))))))
    (gmf-steps
      (lambda () (fact 'cc-is-metric-space))
      (lambda () (let* ((iff (dk-cite! 'ball-membership 'CC-MS c r x)))
                   (dk-have! cj (lambda () (gmf-only-prop! iff (list 'IN x (list 'BALL 'CC-MS c r)))))))
      (lambda () (dk-split-all! (list (dk-ctx-form cj))))
      (lambda () (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl))))
      (lambda () (dk-have! (list 'IN x 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass))))
      (lambda () (dk-cite! 'cc-ms-dist c x))
      (lambda () (gmf-rr! mag))
      (lambda () (gmf-rr! mag2))
      (lambda () (dk-cite! 'cc-magnitude-sub-sym c x))
      (lambda () (dk-have! (list 'AND (list '<= mag r) (list 'NOT (list '= mag r)))
                   (lambda () (subst (list '= mag dcx)) (dk-conj-close! dk-ass!))))
      (lambda () (dk-cite! 'rr-le-ne-lt mag r))
      (lambda () (dk-have! (list '< mag2 r) (lambda () (dk-ineq! (list '< mag r) (list '= mag mag2))))))))

(define (gmf-subst-sym e from to)
  (cond ((eq? e from) to)
        ((pair? e) (cons (gmf-subst-sym (car e) from to) (gmf-subst-sym (cdr e) from to)))
        (#t e)))

;;; subst EQ, then close the SAME leaf by rfl (sides equal) or ass, unless the subst closed it
(define (gmf-subst-close! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf))
        (let ((g (dk-goal)))
          (cond ((dk-asm? g) (dk-ass!))
                ((and (memq (dk-head g) '(= ==)) (alpha-equiv? (cadr g) (caddr g)))
                 (if (eq? (car g) '==) (qrfl)
                     (begin
                       (if (not (or (dk-asm? (list 'IN (cadr g) 'CC)) (dk-asm? (list 'IN (cadr g) 'RR))))
                           (quietly (lambda () (vnb-guard (lambda () (gmf-cc! (cadr g)))))))
                       (rfl))))
                (#t (error "gmf-subst-close!: goal still open" (expression->string g))))))))
;;; x in RR, a <= x, x <= b in context: land x in CCINT(a, b); the strict form for OOINT
(define (gmf-in-ccint! x a b)
  (let* ((m (list 'IN x (list 'CCINT a b))))
    (if (not (dk-asm? m))
        (let ((iff (dk-cite! 'ccint-membership a b x)))
          (dk-have! m (lambda () (gmf-only-prop! iff (list 'IN x 'RR) (list '<= a x) (list '<= x b))))))
    m))
(define (gmf-in-ooint! x a b)
  (let* ((m (list 'IN x (list 'OOINT a b))))
    (if (not (dk-asm? m))
        (let ((iff (dk-cite! 'ooint-membership a b x)))
          (dk-have! m (lambda () (gmf-only-prop! iff (list 'IN x 'RR) (list '< a x) (list '< x b))))))
    m))
;;; x in CCINT(a, b) in context: land x in RR, a <= x, x <= b
(define (gmf-ccint-parts! x a b)
  (if (not (and (dk-asm? (list 'IN x 'RR)) (dk-asm? (list '<= a x)) (dk-asm? (list '<= x b))))
      (let ((c (dk-cite! 'ccint-parts a b x)))
        (if (dk-head-is? c 'AND) (dk-split-all! (list c))))))
(define (gmf-ooint-parts! x a b)
  (let ((iff (dk-cite! 'ooint-membership a b x)))
    (dk-have! (list 'IN x 'RR) (lambda () (gmf-only-prop! iff (list 'IN x (list 'OOINT a b)))))
    (dk-have! (list '< a x) (lambda () (gmf-only-prop! iff (list 'IN x (list 'OOINT a b)))))
    (dk-have! (list '< x b) (lambda () (gmf-only-prop! iff (list 'IN x (list 'OOINT a b)))))))
(define (gmf-syms t)   ; the symbols of T in argument position (heads skipped)
  (cond ((symbol? t) (list t))
        ((pair? t) (apply append (map gmf-syms (cdr t))))
        (#t '())))
;;; the atoms of a linear term (abs looked through); a premise is usable when each is typed
(define (gmf-atoms t)
  (cond ((number? t) '())
        ((and (pair? t) (memq (car t) '(+ - abs))) (apply append (map gmf-atoms (cdr t))))
        ((and (pair? t) (eq? (car t) '*) (= (length t) 3) (number? (cadr t))) (gmf-atoms (caddr t)))
        ((and (pair? t) (eq? (car t) '*) (= (length t) 3) (number? (caddr t))) (gmf-atoms (cadr t)))
        (#t (list t))))
(define (gmf-typed-atom? a)
  (or (dk-asm? (list 'IN a 'RR))
      (and (pair? a) (eq? (car a) '*) (= (length a) 3)
           (gmf-typed-atom? (cadr a)) (gmf-typed-atom? (caddr a)))))
(define (gmf-nonlinear? t)
  (and (pair? t)
       (or (and (eq? (car t) '*) (= (length t) 3) (not (number? (cadr t))) (not (number? (caddr t))))
           (any-pred gmf-nonlinear? (cdr t)))))
(define (gmf-usable? fm)
  (and (not (gmf-nonlinear? fm))
       (every gmf-typed-atom? (append (gmf-atoms (cadr fm)) (gmf-atoms (caddr fm))))))
;;; the order atoms of the context connected to GOAL through shared symbols (two rounds),
;;; each with all its atoms typed (one uncertifiable premise poisons an ineq call)
(define (gmf-order-prems goal)
  (let* ((cands (filter (lambda (fm) (and (pair? fm) (memq (car fm) '(< <= =)) (= (length fm) 3)
                                          (gmf-usable? fm)))
                        (dk-asms)))
         (skip '(RR CC NN PI))
         (share? (lambda (fm gs) (any-pred (lambda (x) (and (memq x gs) (not (memq x skip)))) (gmf-syms fm)))))
    (let loop ((gs (gmf-syms goal)) (round 0))
      (let ((sel (filter (lambda (fm) (share? fm gs)) cands)))
        (if (>= round 2) sel
            (loop (append gs (apply append (map gmf-syms sel))) (+ round 1)))))))
(define (gmf-ineq! goal . extra)
  (if (not (dk-asm? goal))
      (dk-have! goal (lambda () (apply dk-ineq! (if (null? extra) (gmf-order-prems goal) extra)))))
  goal)
(define (gmf-le! x y) (gmf-ineq! (list '<= x y)))
(define (gmf-lt! x y) (gmf-ineq! (list '< x y)))
(define (gmf-mark . xs) (display "\n;; MARK ") (for-each (lambda (x) (display (if (string? x) x (expression->string x))) (display " ")) xs) (newline))

;;; land (IN a RR) for each NN-typed atom of the linear term T
(define (gmf-atoms-rr! t)
  (for-each (lambda (a) (if (and (not (dk-asm? (list 'IN a 'RR))) (dk-asm? (list 'IN a 'NN))) (fact 'nn-in-rr a)))
            (gmf-atoms t)))
(define (gmf-dump-open!)
  (for-each (lambda (l) (gmf-mark "OPEN" (dk-goal-of l))) (dk-open-leaves)))
;;; cite, then split the instance only when some conjunct is not yet in context
(define (gmf-conjs f) (if (dk-head-is? f 'AND) (append (gmf-conjs (cadr f)) (gmf-conjs (caddr f))) (list f)))
(define (gmf-cite-split! . args)
  (let ((c (apply dk-cite! args)))
    (if (and (dk-head-is? c 'AND) (not (every dk-asm? (gmf-conjs c))))
        (dk-split-all! (list c)))
    c))
;;; 0 <= x and 0 <= y typed in context: land 0 <= x * y
(define (gmf-nonneg-mul! x y)
  (let ((g (list '<= 0 (list '* x y))))
    (if (not (dk-asm? g))
        (begin
          (gmf-rr! (list '* x y)) (fact 'rr-zero-in) (gmf-rr! (list '* 0 y))
          (fact 'rr-mul-le-right 0 x y)
          (dk-have! (list '= (list '* 0 y) 0) (lambda () (crs)))
          (gmf-ineq! g (list '<= (list '* 0 y) (list '* x y)) (list '= (list '* 0 y) 0))))
    g))
;;; ---------------------------------------------------------------------
;;; (1) THE RIGHT HALF-PLANE {w in CC : 0 < re w} IS OPEN.
;;; ---------------------------------------------------------------------
(define gmf-rhp '(SEP gmu_ CC (< 0 (real-part gmu_))))
;;; y in RHP in context: land y in CC and 0 < re y (the membership survives)
(define (gmf-rhp-open! y)
  (let* ((m (list 'IN y gmf-rhp)))
    (dk-project! (list 'IN y 'CC) (lambda () (sep-me (dk-ctx-form m))))
    (dk-project! (list '< 0 (list 'real-part y)) (lambda () (sep-me (dk-ctx-form m))))))
;;; y in CC, 0 < re y in context: close the goal y in RHP
(define (gmf-rhp-in! y)
  (dk-have! (list 'IN y gmf-rhp)
    (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!))))))

(sp (make-wff (list 'IS-OPEN gmf-nfm gmf-rhp)))
(fact 'nf-cc-is-metric-space)
(fact 'cc-is-metric-space)
(define gmf-rhp-iff (dk-cite! 'cc-ms-open-iff gmf-rhp))
  (dk-have! (list 'IS-OPEN 'CC-MS gmf-rhp)
    (lambda ()
      (mac 'IS-OPEN)
      (dk-conj-close!
        (lambda ()
          (let* ((g (dk-goal)))
            (cond
              ((dk-asm? g) (dk-ass!))
              ((dk-head-is? g 'SUBSET)
               (let* ((x (subset-by-element!)))
                 (gmf-rhp-open! x)
                 (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
                 (subst '(= (PTS CC-MS) CC))
                 (dk-ass!)))
              (#t
               (let* ((y (dk-di-var!)))
                 (gmf-rhp-open! y)
                 (gmf-rr! (list 'real-part y))
                 (dk-cite! 'rr-pos-rr-of-lt (list 'real-part y))
                 (ew (list 'real-part y))
                 (dk-conj-close!
                   (lambda ()
                     (if (dk-asm? (dk-goal))
                         (dk-ass!)
                         (let* ((w (subset-by-element!)))
                           (gmf-ball-open! y (list 'real-part y) w)
                           (gmf-rr! (list 'real-part w))
                           (gmf-rr! (list 'magnitude (list '- w y)))
                           (gmf-rr! (list 'real-part y))
                           (gmf-rr! (list '- (list 'real-part w) (list 'real-part y)))
                           (let* ((le (dk-cite! 'cc-re-dist-le w y))
                                  (pr (dk-cite! 'rr-abs-le-parts
                                                (list '- (list 'real-part w) (list 'real-part y))
                                                (list 'magnitude (list '- w y)))))
                             (dk-split-all! (list pr))
                             (dk-have! (list '< 0 (list 'real-part w))
                               (lambda ()
                                 (dk-ineq! (list '<= (list '- (list 'magnitude (list '- w y)))
                                                 (list '- (list 'real-part w) (list 'real-part y)))
                                           (list '< (list 'magnitude (list '- w y)) (list 'real-part y))))))
                             (gmf-rhp-in! w)
                             (dk-ass!)))))))))))))
(gmf-only-prop! gmf-rhp-iff (list 'IS-OPEN 'CC-MS gmf-rhp))
(qed 'right-half-plane-open)
;;; ---------------------------------------------------------------------
;;; (2) THE REAL INTERVAL [a, b] IS A ROAD: t |-> t, with derivative 1.
;;;     (the driver of `segment-is-road', road-laws.scm, on [a, b])
;;; ---------------------------------------------------------------------
;;; x in RR in context: land re x = x and im x = 0 (cc-re-im-of: x = x + 0 i)
(define (gmf-re-im-real! x)
  (let* ((e1 (list '= (list 'real-part x) x))
         (e2 (list '= (list 'imag-part x) 0)))
    (if (not (and (dk-asm? e1) (dk-asm? e2)))
        (begin
          (gmf-rr! x) (gmf-cc! x) (fact 'rr-zero-in)
          (gmf-cc! (list '+ x (list '* 0 +i)))
          (dk-have! (list '= x (list '+ x (list '* 0 +i))) (lambda () (crs)))
          (dk-split-all! (list (dk-cite! 'cc-re-im-of x x 0)))))
    e1))
(define (gmf-ab-id a b) (list 'VNB-LAMBDA 'gmt_ (list 'CCINT a b) 'gmt_))
(define (gmf-ab-one a b) (list 'VNB-LAMBDA 'gmt_ (list 'CCINT a b) 1))

(define gmf-rd-I '(CCINT a b))
(define gmf-rd-gam (gmf-ab-id 'a 'b))
(define gmf-rd-dgm (gmf-ab-one 'a 'b))
(define (gmf-rd-coord proj f) (list 'VNB-LAMBDA 'pat_ gmf-rd-I (list proj (list f 'pat_))))
(define gmf-rd-gr (gmf-rd-coord 'real-part gmf-rd-gam))
(define gmf-rd-gi (gmf-rd-coord 'imag-part gmf-rd-gam))
(define gmf-rd-dr (gmf-rd-coord 'real-part gmf-rd-dgm))
(define gmf-rd-di (gmf-rd-coord 'imag-part gmf-rd-dgm))

(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IN a RR) (list 'FORALL 'b (list 'IMPLIES '(IN b RR)
  (list 'IMPLIES '(< a b) (list 'IS-ROAD gmf-rd-gam gmf-rd-dgm 'a 'b))))))))
(dk-peel!)
(fact 'rr-zero-in)
(fact 'rr-one-in)
(fact 'rr-is-set)
(fact 'ccint-subset-rr 'a 'b)
(fact 'subclass-of-set-is-set gmf-rd-I 'RR)
(gmf-cc! 1)
(define (gmf-rd-point! z)
  (fact 'ccint-elt-in-rr 'a 'b z)
  (fact 'rr-subset-cc z))
(define (gmf-rd-lam-cc! lam)
  (dk-have! (list 'IN lam (list 'FUN gmf-rd-I 'CC))
    (lambda ()
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (not (eq? (dk-head (dk-goal)) 'FORALL))
             (dk-ass!)
             (let ((z (dk-di-var!))) (gmf-rd-point! z) (dk-ass!))))
       (dk-opened (lambda () (lam-t)))))))
(gmf-rd-lam-cc! gmf-rd-gam)
(gmf-rd-lam-cc! gmf-rd-dgm)
(define (gmf-rd-coord-in-fun! lam proj src)
  (dk-have! (list 'IN lam (list 'FUN gmf-rd-I 'RR))
    (lambda ()
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (not (eq? (dk-head (dk-goal)) 'FORALL))
             (dk-ass!)
             (let ((z (dk-di-var!)))
               (gmf-rd-point! z)
               (fact 'fun-apply-type-c src gmf-rd-I 'CC z)
               (fact (if (eq? proj 'real-part) 'real-part-in-rr 'imag-part-in-rr)
                     (list src z))
               (dk-ass!))))
       (dk-opened (lambda () (lam-t)))))))
(gmf-rd-coord-in-fun! gmf-rd-gr 'real-part gmf-rd-gam)
(gmf-rd-coord-in-fun! gmf-rd-gi 'imag-part gmf-rd-gam)
(gmf-rd-coord-in-fun! gmf-rd-dr 'real-part gmf-rd-dgm)
(gmf-rd-coord-in-fun! gmf-rd-di 'imag-part gmf-rd-dgm)
;;; the coordinate values: re t = 0 + 1 t, im t = 0 + 0 t, re 1 = 1, im 1 = 0
(gmf-re-im-real! 1)
(define (gmf-rd-value! lam rhs-of val-of)
  ;; lam(z) == rhs(z), where val-of z is the reduced value (real-part z) etc.
  (dk-have! (list 'FORALL 'pay_ (list 'IMPLIES (list 'IN 'pay_ gmf-rd-I)
              (list '== (list lam 'pay_) (rhs-of 'pay_))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (gmf-rd-point! z)
        (gmf-re-im-real! z)
        (dk-lam-b!)
        (let* ((v (val-of z)) (r (rhs-of z)))
          (dk-have! (list '= v r) (lambda () (gmf-re-im-real! z) (gmf-rr! (list 'real-part z)) (gmf-rr! (list 'imag-part z)) (gmf-rr! (list 'real-part 1)) (gmf-rr! (list 'imag-part 1)) (dk-ineq! (dk-ctx-form (list '= (list 'real-part z) z)) (dk-ctx-form (list '= (list 'imag-part z) 0)) (dk-ctx-form '(= (real-part 1) 1)) (dk-ctx-form '(= (imag-part 1) 0)))))
          (gmf-subst-qrfl! (list '= v r)))))))
(gmf-rd-value! gmf-rd-gr (lambda (z) (list '+ 0 (list '* 1 z))) (lambda (z) (list 'real-part z)))
(gmf-rd-value! gmf-rd-gi (lambda (z) (list '+ 0 (list '* 0 z))) (lambda (z) (list 'imag-part z)))
(gmf-rd-value! gmf-rd-dr (lambda (z) 1) (lambda (z) '(real-part 1)))
(gmf-rd-value! gmf-rd-di (lambda (z) 0) (lambda (z) '(imag-part 1)))
(fact 'pw-affine-antiderivative 'a 'b 0 1 gmf-rd-gr gmf-rd-dr)
(fact 'pw-affine-antiderivative 'a 'b 0 0 gmf-rd-gi gmf-rd-di)
(fact 'primitive-continuous gmf-rd-gr gmf-rd-dr 'a 'b)
(fact 'primitive-continuous gmf-rd-gi gmf-rd-di 'a 'b)
(define (gmf-rd-regulated! lam c)
  (let ((tot (list 'VNB-LAMBDA 'x 'RR c)))
    (fact 'const-lam-in-fun c)
    (dk-have! (list 'FORALL 'pay_ (list 'IMPLIES '(IN pay_ RR)
                (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS tot 'pay_)))
      (lambda ()
        (let ((z (dk-di-var!))) (fact 'const-continuous-at c z) (dk-ass!))))
    (dk-have! (list 'FORALL 'pay_ (list 'IMPLIES (list 'IN 'pay_ gmf-rd-I)
                (list '== (list lam 'pay_) (list tot 'pay_))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (gmf-rd-point! z)
          (gmf-re-im-real! 1)
          (dk-lam-b!)
          (let ((g (dk-goal)))
            (cond ((alpha-equiv? (cadr g) (caddr g)) (qrfl))
                  (#t (gmf-subst-qrfl! (list '= (cadr g) (caddr g)))))))))
    (fact 'pw-restrict-continuous-on 'a 'b tot lam)
    (fact 'continuous-on-implies-regulated-on lam 'a 'b)))
(gmf-rd-regulated! gmf-rd-dr 1)
(gmf-rd-regulated! gmf-rd-di 0)
(define (gmf-rd-path-eq! lam proj)
  (dk-have! (list 'FORALL 'pay_ (list 'IMPLIES (list 'IN 'pay_ gmf-rd-I)
              (list '= (list proj (list gmf-rd-gam 'pay_)) (list lam 'pay_))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (gmf-rd-point! z)
        (fact (if (eq? proj 'real-part) 'real-part-in-rr 'imag-part-in-rr) z)
        (dk-lam-b!)
        (rfl)))))
(gmf-rd-path-eq! gmf-rd-gr 'real-part)
(gmf-rd-path-eq! gmf-rd-gi 'imag-part)
(fact 'is-path-of-coords 'a 'b gmf-rd-gam gmf-rd-gr gmf-rd-gi)
(mac 'IS-ROAD)
(dk-conj-close! (lambda () (dk-ass!)))
(qed 'real-interval-is-road)
