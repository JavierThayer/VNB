;;; ---------------------------------------------------------------------
;;; (7) THE IMPROPER INTEGRAL, ABSTRACTLY: two small order facts, the Cauchy
;;;     criterion (CC is complete), the tail bound, uniqueness, the value.
;;; ---------------------------------------------------------------------
(sp (make-wff '(FORALL d (IMPLIES (IN d RR) (FORALL r (IMPLIES (IN r RR) (IMPLIES (< 0 d) (IMPLIES (< 0 r)
   (FORSOME x (AND (IN x RR) (AND (< 0 x) (AND (< x d) (< x r)))))))))))))
(dk-peel!)
(gmf-and! '(IN d RR) '(IN r RR))
(define gmf-bt-or (dk-cite! 'rr-leq-total 'd 'r))
(define (gmf-bt-witness! w)
  (gmf-rr! w)
  (ew w)
  (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!) (gmf-ineq! (dk-goal))))))
(use-cases gmf-bt-or
  (lambda () (gmf-bt-witness! '(* 1/2 d)))
  (lambda () (gmf-bt-witness! '(* 1/2 r))))
(qed 'rr-positive-below-two)

(sp (make-wff '(FORALL m (IMPLIES (IN m RR) (FORALL r (IMPLIES (IN r RR)
   (FORSOME x (AND (IN x RR) (AND (< m x) (< r x))))))))))
(dk-peel!)
(fact 'rr-le-abs 'm) (fact 'rr-le-abs 'r)
(gmf-rr! '(abs m)) (gmf-rr! '(abs r))
(fact 'rr-abs-nonneg 'm) (fact 'rr-abs-nonneg 'r)
(gmf-bt-witness! '(+ (+ (abs m) (abs r)) 1))
(qed 'rr-above-two)

;;; f integrable on every [r, R] with 0 < r < R
(define (gmf-locint f)
  (list 'FORALL 'ipr_ (list 'IMPLIES '(IN ipr_ RR) (list 'FORALL 'ipq_ (list 'IMPLIES '(IN ipq_ RR)
    (list 'IMPLIES '(< 0 ipr_) (list 'IMPLIES '(< ipr_ ipq_) (list 'IN (list 'CC-INT f 'ipr_ 'ipq_) 'CC))))))))
;;; the Cauchy condition of the double limit
(define (gmf-cauchy f)
  (list 'FORALL 'gce_ (list 'IMPLIES '(POS-RR gce_)
    (list 'FORSOME 'gcd_ (list 'AND '(POS-RR gcd_)
      (list 'FORSOME 'gcm_ (list 'AND '(IN gcm_ RR)
        (gmf-all '(gcr1_ gcr2_ gcq1_ gcq2_)
          (gmf-imps (list '(IN gcr1_ RR) '(IN gcr2_ RR) '(IN gcq1_ RR) '(IN gcq2_ RR)
                          '(< 0 gcr1_) '(< gcr1_ gcd_) '(< 0 gcr2_) '(< gcr2_ gcd_)
                          '(< gcm_ gcq1_) '(< gcm_ gcq2_) '(< gcr1_ gcq1_) '(< gcr2_ gcq2_))
            (list '<= (list 'magnitude (list '- (list 'CC-INT f 'gcr1_ 'gcq1_) (list 'CC-INT f 'gcr2_ 'gcq2_))) 'gce_))))))))))

;;; k in NN: recip(k + 1) in (0, 1], below k + 2
(define (gmf-idx! k)
  (let* ((r (list 'recip (list '+ k 1))) (big (list '+ k 2)))
    (fact 'nn-in-rr k)
    (fact 'nn-zero-le k)
    (gmf-atoms-rr! k)
    (gmf-rr! (list '+ k 1)) (gmf-rr! big)
    (fact 'nn-recip-succ-pos k)
    (fact 'rr-pos-rr-in-rr r)
    (fact 'rr-lt-of-pos-rr r)
    (fact 'nn-zero-in)
    (fact 'nn-recip-succ-antitone 0 k)
    (dk-have! '(= (recip (+ 0 1)) 1) (lambda () (arith)))
    (dk-have! '(IN (recip (+ 0 1)) RR) (lambda () (subst '(= (recip (+ 0 1)) 1)) (dk-ass!)))
    (gmf-ineq! (list '<= r 1) '(= (recip (+ 0 1)) 1) (list '<= r '(recip (+ 0 1))))
    (gmf-ineq! (list '< r big) (list '<= r 1) (list '<= 0 k))))

(define gmf-ab-seq '(VNB-LAMBDA gmk_ NN (CC-INT f (recip (+ gmk_ 1)) (+ gmk_ 2))))
;;; k in NN: land seq(k) = CC-INT(f, recip(k + 1), k + 2) and its typing
(define (gmf-seq-at! k)
  (let* ((v (list 'CC-INT 'f (list 'recip (list '+ k 1)) (list '+ k 2)))
         (e (list '= (list gmf-ab-seq k) v)))
    (gmf-idx! k)
    (if (not (dk-asm? (list 'IN v 'CC)))
        (dk-apply! (dk-ctx-form (gmf-locint 'f)) (list 'recip (list '+ k 1)) (list '+ k 2)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (if (not (dk-lam-b!)) (rfl)))))
    e))
;;; N in NN with recip(N + 1) < del and M < N; returns N
(define (gmf-big-index! del m)
  (let* ((n1 (dk-skolem! (dk-fact! 'nn-recip-succ-small del)))
         (_  (fact 'rr-one-in))
         (_1 (gmf-lt! 0 1))
         (_2 (fact 'rr-pos-rr-of-lt 1))
         (n2 (dk-skolem! (dk-apply! (dk-cite! 'rr-archimedean-multiple 1) m))))
    (gmf-idx! n1)
    (fact 'nn-in-rr n2) (fact 'nn-zero-le n2)
    (list n1 n2)))

(define gmf-ab-conv '(IMPROPER-INT-CONVERGES-TO f gmL_))
(sp (make-wff (list 'FORALL 'f (gmf-imps (list (gmf-locint 'f) (gmf-cauchy 'f))
  (list 'FORSOME 'gmL_ gmf-ab-conv)))))
(dk-peel!)
(fact 'cc-is-metric-space)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(fact 'nn-is-set)
(dk-have! (list 'IN gmf-ab-seq '(FUN NN CC))
  (lambda ()
    (for-each (lambda (leaf) (dk-focus! leaf)
                (if (not (eq? (dk-head (dk-goal)) 'FORALL)) (dk-ass!)
                    (let ((k (dk-di-var!)))
                      (gmf-idx! k)
                      (dk-apply! (dk-ctx-form (gmf-locint 'f)) (list 'recip (list '+ k 1)) (list '+ k 2))
                      (dk-ass!))))
              (dk-opened (lambda () (lam-t))))))
(dk-have! (list 'IN gmf-ab-seq '(FUN NN (PTS CC-MS))) (lambda () (subst '(= (PTS CC-MS) CC)) (dk-ass!)))
;;; the sequence is Cauchy
(dk-have! (list 'IS-CAUCHY-SEQ 'CC-MS gmf-ab-seq)
  (lambda ()
    (mac 'IS-CAUCHY-SEQ)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (dk-ass!)
          (let* ((eps (dk-di-var! (lambda (g) (cadr (cadr g))))))
            (dk-peel!)
            (let* ((ch (dk-apply! (dk-ctx-form (gmf-cauchy 'f)) eps))
                   (del (dk-skolem! ch 'top))
                   (_ (dk-split-all!))
                   (m (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the M") 'top))
                   (_2 (dk-split-all!))
                   (ns (gmf-big-index! del m))
                   (n1 (car ns)) (n2 (cadr ns))
                   (N (list '+ n1 n2)))
              (fact 'rr-pos-rr-in-rr del) (fact 'rr-lt-of-pos-rr del)
              (gmf-and! (list 'IN n1 'NN) (list 'IN n2 'NN))
              (fact 'nn-add-closed n1 n2)
              (ew N)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal)) (dk-ass!)
                    (let* ((ms (dk-peel!))
                           (vs (map cadr (filter (lambda (x) (and (dk-head-is? x 'IN) (equal? (caddr x) 'NN))) ms)))
                           (p (car vs)) (q (cadr vs)))
                      (dk-split-all!)
                      (for-each (lambda (k)
                                  (gmf-seq-at! k)
                                  (fact 'nn-in-rr n1) (fact 'nn-in-rr n2) (fact 'nn-zero-le n1) (fact 'nn-zero-le n2)
                                  (gmf-le! n1 k)
                                  (fact 'nn-recip-succ-antitone n1 k)
                                  (gmf-lt! (list 'recip (list '+ k 1)) del)
                                  (gmf-ineq! (list '<= m (list '* n2 1)))
                                  (gmf-lt! m (list '+ k 2)))
                                (list p q))
                      (let* ((sp_ (list gmf-ab-seq p)) (sq_ (list gmf-ab-seq q)))
                        (let ((vp (caddr (gmf-seq-at! p))) (vq (caddr (gmf-seq-at! q))))
                          (subst (list '= sp_ vp))
                          (subst (list '= sq_ vq))
                          (fact 'cc-ms-dist vp vq)
                          (subst (list '= (list '(DIST CC-MS) vp vq) (list 'magnitude (list '- vp vq)))))
                        (dk-apply! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm del) (dk-contains? fm 'CC-INT))) "the Cauchy universal")
                                   (list 'recip (list '+ p 1)) (list 'recip (list '+ q 1)) (list '+ p 2) (list '+ q 2))
                        (dk-ass!)))))))))))))
;;; CC is complete: the sequence converges
(fact 'cc-complete)
(dk-project! (list 'CONVERGES 'CC-MS gmf-ab-seq)
  (lambda () (mac-h 'IS-COMPLETE (dk-ctx-form '(IS-COMPLETE CC-MS)))
             (dk-split-all!)
             (dk-apply! (dk-pick (dk-head? 'FORALL) "the completeness universal") gmf-ab-seq)))
(define gmf-ab-L
  (let ((ex (dk-project! (list 'FORSOME 'l (list 'CONVERGES-TO 'CC-MS gmf-ab-seq 'l))
              (lambda () (mac-h 'CONVERGES (dk-ctx-form (list 'CONVERGES 'CC-MS gmf-ab-seq)))))))
    (dk-skolem! ex)))
(define gmf-ab-cv (list 'CONVERGES-TO 'CC-MS gmf-ab-seq gmf-ab-L))
(dk-project! (list 'IN gmf-ab-L '(PTS CC-MS)) (lambda () (mac-h 'CONVERGES-TO (dk-ctx-form gmf-ab-cv))))
(define gmf-ab-cvu
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'n (list 'AND '(IN n NN)
    (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IMPLIES '(<= n n_)
      (list '<= (list '(DIST CC-MS) (list gmf-ab-seq 'n_) gmf-ab-L) 'eps)))))))))
(dk-project! gmf-ab-cvu (lambda () (mac-h 'CONVERGES-TO (dk-ctx-form gmf-ab-cv))))
(dk-have! (list 'IN gmf-ab-L 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (dk-ass!)))
(ew gmf-ab-L)
(mac 'IMPROPER-INT-CONVERGES-TO)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (dk-ass!)
      (let* ((eps (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-peel!)
        (let* ((e2 (dk-halve! eps))
               (ch (dk-apply! (dk-ctx-form (gmf-cauchy 'f)) e2))
               (del (dk-skolem! ch 'top))
               (_ (dk-split-all!))
               (m (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the M") 'top))
               (_2 (dk-split-all!))
               (cu (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm del) (dk-contains? fm 'CC-INT))) "the Cauchy universal"))
               (n0 (dk-skolem! (dk-apply! (dk-ctx-form gmf-ab-cvu) e2) 'top))
               (_3 (dk-split-all!))
               (cvn (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm n0) (dk-contains? fm 'DIST))) "the convergence universal"))
               (ns (gmf-big-index! del m))
               (n1 (car ns)) (n2 (cadr ns))
               (N (list '+ n0 (list '+ n1 n2))))
          (fact 'rr-pos-rr-in-rr del) (fact 'rr-lt-of-pos-rr del)
          (gmf-and! (list 'IN n1 'NN) (list 'IN n2 'NN))
          (fact 'nn-add-closed n1 n2)
          (gmf-and! (list 'IN n0 'NN) (list 'IN (list '+ n1 n2) 'NN))
          (fact 'nn-add-closed n0 (list '+ n1 n2))
          (ew del)
          (dk-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal)) (dk-ass!)
                (begin
                  (ew m)
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-asm? (dk-goal)) (dk-ass!)
                        (let* ((ms (dk-peel!))
                               (r (cadr (dk-goal)))
                               (I (cadr (cadr (cadr (dk-goal)))))
                               (q (cadddr I))
                               (rn (list 'recip (list '+ N 1))) (bign (list '+ N 2))
                               (In (list 'CC-INT 'f rn bign)))
                          (gmf-seq-at! N)
                          (for-each (lambda (k) (fact 'nn-in-rr k) (fact 'nn-zero-le k)) (list n0 n1 n2))
                          (gmf-le! n1 N)
                          (fact 'nn-recip-succ-antitone n1 N)
                          (gmf-lt! rn del)
                          (gmf-ineq! (list '<= m (list '* n2 1)))
                          (gmf-lt! m bign)
                          (gmf-le! n0 N)
                          (dk-apply! (dk-ctx-form (gmf-locint 'f)) (caddr I) q)
                          (dk-apply! cu (caddr I) rn q bign)
                          (dk-apply! cvn N)
                          (dk-have! (list 'IN (list gmf-ab-seq N) 'CC)
                            (lambda () (subst (list '= (list gmf-ab-seq N) In)) (dk-ass!)))
                          (fact 'cc-ms-dist (list gmf-ab-seq N) gmf-ab-L)
                          (let* ((pp (list '- I gmf-ab-L)) (qq (list '- In gmf-ab-L)))
                            (gmf-cc! pp) (gmf-cc! qq)
                            (fact 'cc-magnitude-le-add pp qq)
                            (gmf-cc! (list '- pp qq)) (gmf-cc! (list '- I In))
                            (dk-have! (list '= (list '- pp qq) (list '- I In)) (lambda () (crs)))
                            (gmf-rr! (list 'magnitude (list '- pp qq)))
                            (gmf-rr! (list 'magnitude (list '- I In)))
                            (gmf-rr! (list 'magnitude qq))
                            (gmf-rr! (list 'magnitude pp))
                            (dk-have! (list '= (list 'magnitude (list '- pp qq)) (list 'magnitude (list '- I In)))
                              (lambda () (gmf-subst-close! (list '= (list '- pp qq) (list '- I In)))))
                            (dk-have! (list '<= (list 'magnitude qq) e2)
                              (lambda ()
                                (subst (list '= In (list gmf-ab-seq N)))
                                (subst (list '= (list 'magnitude (list '- (list gmf-ab-seq N) gmf-ab-L))
                                             (list '(DIST CC-MS) (list gmf-ab-seq N) gmf-ab-L)))
                                (dk-ass!)))
                            (fact 'rr-pos-rr-in-rr eps)
                            (dk-ineq! (list '<= (list 'magnitude pp) (list '+ (list 'magnitude (list '- pp qq)) (list 'magnitude qq)))
                                      (list '= (list 'magnitude (list '- pp qq)) (list 'magnitude (list '- I In)))
                                      (list '<= (list 'magnitude (list '- I In)) e2)
                                      (list '<= (list 'magnitude qq) e2)
                                      (list '= (list '+ e2 e2) eps))))))))))))))))
(qed 'improper-int-cauchy)
(topic! 'improper-int-cauchy 'analysis)
(alias! 'improper-int-cauchy "the Cauchy criterion for the improper integral on (0, +inf)")
;;; the body of IMPROPER-INT-CONVERGES-TO(f, L), as the definition spells it
(define (gmf-conv-univ f l)
  (list 'FORALL 'ipe_ (list 'IMPLIES '(POS-RR ipe_)
    (list 'FORSOME 'ipd_ (list 'AND '(POS-RR ipd_)
      (list 'FORSOME 'ipm_ (list 'AND '(IN ipm_ RR)
        (list 'FORALL 'ipr_ (list 'IMPLIES '(IN ipr_ RR)
          (list 'FORALL 'ipq_ (list 'IMPLIES '(IN ipq_ RR)
            (list 'IMPLIES '(< 0 ipr_)
              (list 'IMPLIES '(< ipr_ ipd_)
                (list 'IMPLIES '(< ipm_ ipq_)
                  (list 'IMPLIES '(< ipr_ ipq_)
                    (list '<= (list 'magnitude (list '- (list 'CC-INT f 'ipr_ 'ipq_) l)) 'ipe_))))))))))))))))
;;; IMPROPER-INT-CONVERGES-TO(f, L) in context: land L in CC and the universal (both survive)
(define (gmf-conv-open! f l)
  (let ((c (list 'IMPROPER-INT-CONVERGES-TO f l)))
    (dk-project! (list 'IN l 'CC) (lambda () (mac-h 'IMPROPER-INT-CONVERGES-TO (dk-ctx-form c))))
    (dk-project! (gmf-conv-univ f l) (lambda () (mac-h 'IMPROPER-INT-CONVERGES-TO (dk-ctx-form c))))))
;;; at d > 0: delta, M and r', R' with 0 < r' < min(delta, r), R' > max(M, R) (r < R given);
;;; lands |CC-INT(f, r', R') - L| <= d and returns (r' R')
(define (gmf-conv-near! f l d r big)
  (let* ((del (dk-skolem! (dk-apply! (dk-ctx-form (gmf-conv-univ f l)) d) 'top))
         (_ (dk-split-all!))
         (m (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm del))) "the M") 'top))
         (_2 (dk-split-all!))
         (cu (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm del) (dk-contains? fm m))) "the universal"))
         (_3 (begin (fact 'rr-pos-rr-in-rr del) (fact 'rr-lt-of-pos-rr del)))
         (r1 (dk-skolem! (dk-cite! 'rr-positive-below-two del r)))
         (q1 (dk-skolem! (dk-cite! 'rr-above-two m big))))
    (gmf-lt! r1 q1)
    (dk-apply! cu r1 q1)
    (list r1 q1)))

(define (gmf-tail-hyp f r big tt)
  (list 'FORALL 'gtr2_ (list 'IMPLIES '(IN gtr2_ RR) (list 'FORALL 'gtq2_ (list 'IMPLIES '(IN gtq2_ RR)
    (gmf-imps (list '(< 0 gtr2_) (list '< 'gtr2_ r) (list '< big 'gtq2_))
      (list '<= (list 'magnitude (list '- (list 'CC-INT f 'gtr2_ 'gtq2_) (list 'CC-INT f r big))) tt)))))))
(sp (make-wff (list 'FORALL 'f (gmf-imps (list (gmf-locint 'f))
  (list 'FORALL 'gmL_ (gmf-imps (list gmf-ab-conv)
    (gmf-all '(gtr_ gtq_ gtt_) (gmf-imps (list '(IN gtr_ RR) '(IN gtq_ RR) '(IN gtt_ RR) '(< 0 gtr_) '(< gtr_ gtq_)
                                               (gmf-tail-hyp 'f 'gtr_ 'gtq_ 'gtt_))
      '(<= (magnitude (- gmL_ (CC-INT f gtr_ gtq_))) gtt_)))))))))
(dk-peel!)
(gmf-conv-open! 'f 'gmL_)
(dk-apply! (dk-ctx-form (gmf-locint 'f)) 'gtr_ 'gtq_)
(define gmf-tl-I '(CC-INT f gtr_ gtq_))
(gmf-cc! (list '- 'gmL_ gmf-tl-I))
(gmf-rr! (list 'magnitude (list '- 'gmL_ gmf-tl-I)))
(dk-chain! (dk-cite! 'rr-le-of-le-add-all-pos (list 'magnitude (list '- 'gmL_ gmf-tl-I)) 'gtt_)
  (list (cons (lambda (an) (dk-head-is? an 'FORALL))
    (lambda ()
      (let* ((d (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-peel!)
        (fact 'rr-pos-rr-in-rr d) (fact 'rr-lt-of-pos-rr d)
        (let* ((rq (gmf-conv-near! 'f 'gmL_ d 'gtr_ 'gtq_))
               (r1 (car rq)) (q1 (cadr rq))
               (I1 (list 'CC-INT 'f r1 q1)))
          (dk-apply! (dk-ctx-form (gmf-tail-hyp 'f 'gtr_ 'gtq_ 'gtt_)) r1 q1)
          (dk-apply! (dk-ctx-form (gmf-locint 'f)) r1 q1)
          (let* ((pp (list '- 'gmL_ gmf-tl-I)) (qq (list '- 'gmL_ I1)))
            (gmf-cc! qq)
            (fact 'cc-magnitude-le-add pp qq)
            (gmf-cc! (list '- pp qq)) (gmf-cc! (list '- I1 gmf-tl-I)) (gmf-cc! (list '- I1 'gmL_))
            (dk-have! (list '= (list '- pp qq) (list '- I1 gmf-tl-I)) (lambda () (crs)))
            (for-each gmf-rr! (list (list 'magnitude (list '- pp qq)) (list 'magnitude (list '- I1 gmf-tl-I))
                                    (list 'magnitude qq) (list 'magnitude (list '- I1 'gmL_))))
            (dk-have! (list '= (list 'magnitude (list '- pp qq)) (list 'magnitude (list '- I1 gmf-tl-I)))
              (lambda () (gmf-subst-close! (list '= (list '- pp qq) (list '- I1 gmf-tl-I)))))
            (fact 'cc-magnitude-sub-sym 'gmL_ I1)
            (dk-ineq! (list '<= (list 'magnitude pp) (list '+ (list 'magnitude (list '- pp qq)) (list 'magnitude qq)))
                      (list '= (list 'magnitude (list '- pp qq)) (list 'magnitude (list '- I1 gmf-tl-I)))
                      (list '<= (list 'magnitude (list '- I1 gmf-tl-I)) 'gtt_)
                      (list '= (list 'magnitude qq) (list 'magnitude (list '- I1 'gmL_)))
                      (list '<= (list 'magnitude (list '- I1 'gmL_)) d)))))))))
(dk-ass!)
(qed 'improper-int-tail-bound)
;;; IMPROPER-INT-CONVERGES-TO(f, L) opened at d: returns (delta M universal), split into context
(define (gmf-conv-pick! f l d)
  (let* ((del (dk-skolem! (dk-apply! (dk-ctx-form (gmf-conv-univ f l)) d) 'top))
         (_ (dk-split-all!))
         (m (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm del))) "the M") 'top))
         (_2 (dk-split-all!))
         (cu (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm del) (dk-contains? fm m))) "the universal")))
    (fact 'rr-pos-rr-in-rr del) (fact 'rr-lt-of-pos-rr del)
    (list del m cu)))

(sp (make-wff (list 'FORALL 'f (gmf-imps (list (gmf-locint 'f))
  (gmf-all '(gmL1_ gmL2_) (gmf-imps (list '(IMPROPER-INT-CONVERGES-TO f gmL1_) '(IMPROPER-INT-CONVERGES-TO f gmL2_))
    '(= gmL1_ gmL2_)))))))
(dk-peel!)
(gmf-conv-open! 'f 'gmL1_)
(gmf-conv-open! 'f 'gmL2_)
(define gmf-un-pp '(- gmL1_ gmL2_))
(gmf-cc! gmf-un-pp)
(gmf-rr! (list 'magnitude gmf-un-pp))
(fact 'rr-zero-in)
(dk-chain! (dk-cite! 'rr-le-of-le-add-all-pos (list 'magnitude gmf-un-pp) 0)
  (list (cons (lambda (an) (dk-head-is? an 'FORALL))
    (lambda ()
      (let* ((d (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-peel!)
        (fact 'rr-pos-rr-in-rr d)
        (let* ((h (dk-halve! d))
               (p1 (gmf-conv-pick! 'f 'gmL1_ h))
               (p2 (gmf-conv-pick! 'f 'gmL2_ h))
               (r0 (dk-skolem! (dk-cite! 'rr-positive-below-two (car p1) (car p2))))
               (_ (begin (fact 'rr-one-in) (gmf-lt! 0 1)))
               (r1 (dk-skolem! (dk-cite! 'rr-positive-below-two r0 1)))
               (x1 (dk-skolem! (dk-cite! 'rr-above-two (cadr p1) (cadr p2))))
               (q1 (dk-skolem! (dk-cite! 'rr-above-two x1 1)))
               (I (list 'CC-INT 'f r1 q1)))
          (gmf-lt! r1 (car p1)) (gmf-lt! r1 (car p2)) (gmf-lt! (cadr p1) q1) (gmf-lt! (cadr p2) q1) (gmf-lt! r1 q1)
          (dk-apply! (caddr p1) r1 q1)
          (dk-apply! (caddr p2) r1 q1)
          (dk-apply! (dk-ctx-form (gmf-locint 'f)) r1 q1)
          (let* ((qq (list '- I 'gmL2_)))
            (gmf-cc! qq) (gmf-cc! (list '- I 'gmL1_)) (gmf-cc! (list '- gmf-un-pp qq)) (gmf-cc! (list '- 'gmL1_ I))
            (fact 'cc-magnitude-le-add gmf-un-pp qq)
            (dk-have! (list '= (list '- gmf-un-pp qq) (list '- 'gmL1_ I)) (lambda () (crs)))
            (for-each gmf-rr! (list (list 'magnitude (list '- gmf-un-pp qq)) (list 'magnitude (list '- 'gmL1_ I))
                                    (list 'magnitude qq) (list 'magnitude (list '- I 'gmL1_))))
            (dk-have! (list '= (list 'magnitude (list '- gmf-un-pp qq)) (list 'magnitude (list '- 'gmL1_ I)))
              (lambda () (gmf-subst-close! (list '= (list '- gmf-un-pp qq) (list '- 'gmL1_ I)))))
            (fact 'cc-magnitude-sub-sym 'gmL1_ I)
            (dk-ineq! (list '<= (list 'magnitude gmf-un-pp) (list '+ (list 'magnitude (list '- gmf-un-pp qq)) (list 'magnitude qq)))
                      (list '= (list 'magnitude (list '- gmf-un-pp qq)) (list 'magnitude (list '- 'gmL1_ I)))
                      (list '= (list 'magnitude (list '- 'gmL1_ I)) (list 'magnitude (list '- I 'gmL1_)))
                      (list '<= (list 'magnitude (list '- I 'gmL1_)) h)
                      (list '<= (list 'magnitude qq) h)
                      (list '= (list '+ h h) d)))))))))
(fact 'cc-magnitude-nonneg gmf-un-pp)
(gmf-ineq! (list '= (list 'magnitude gmf-un-pp) 0) (list '<= (list 'magnitude gmf-un-pp) 0) (list '<= 0 (list 'magnitude gmf-un-pp)))
(let ((iff (dk-cite! 'cc-magnitude-zero-iff gmf-un-pp)))
  (dk-have! (list '= gmf-un-pp 0) (lambda () (gmf-only-prop! iff (list '= (list 'magnitude gmf-un-pp) 0)))))
(fact 'cc-sub-zero-eq 'gmL1_ 'gmL2_)
(dk-ass!)
(qed 'improper-int-unique)

;;; the value of the description
(sp (make-wff (list 'FORALL 'f (gmf-imps (list (gmf-locint 'f))
  (list 'FORALL 'gmL_ (gmf-imps (list gmf-ab-conv) '(= (IMPROPER-INT f) gmL_)))))))
(dk-peel!)
(mac 'IMPROPER-INT)
(define gmf-iv-io (cadr (dk-goal)))
(for-each
  (lambda (k)
    (dk-focus! k)
    (if (dk-head-is? (dk-goal) 'FORSOME)
        (begin
          (ew 'gmL_)
          (dk-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal)) (dk-ass!)
                  (let* ((y (dk-di-var! (lambda (g) (if (dk-head-is? g 'IMPLIES) (caddr (cadr g)) (cadr g))))))
                    (dk-peel!)
                    (fact 'improper-int-unique 'f 'gmL_ y)
                    (dk-ass!))))))
        (begin
          (fact 'improper-int-unique 'f gmf-iv-io 'gmL_)
          (dk-ass!))))
  (dk-opened (lambda () (iota-d gmf-iv-io))))
(qed 'improper-int-value)
