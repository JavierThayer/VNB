;;; ---------------------------------------------------------------------
;;; (6) THE INTEGRAND: holomorphic in w on the half-plane, its modulus on (0, +inf)
;;; ---------------------------------------------------------------------
(define gmf-slit '(SEP cxsu_ CC (NOT (AND (= (imag-part cxsu_) 0) (<= (real-part cxsu_) 0)))))
(define (gmf-slit-guard t) (list 'NOT (list 'AND (list '= (list 'imag-part t) 0) (list '<= (list 'real-part t) 0))))
;;; the half-plane lies in the slit plane and avoids 0
(sp (make-wff (list 'FORALL 'gmy_ (list 'IMPLIES (list 'IN 'gmy_ gmf-rhp)
  (list 'AND (gmf-slit-guard 'gmy_) (list 'AND '(NOT (= gmy_ 0)) (list 'IN 'gmy_ gmf-slit)))))))
(let* ((y (dk-di-var!)))
  (gmf-rhp-open! y)
  (gmf-rr! (list 'real-part y))
  (dk-have! (gmf-slit-guard y)
    (lambda () (di) (dk-split-all!) (dk-absurd! (list '< 0 (list 'real-part y)) (list '<= (list 'real-part y) 0))))
  (dk-have! (list 'NOT (list '= y 0))
    (lambda () (di)
      (fact 'rr-zero-in) (gmf-re-im-real! 0)
      (dk-have! (list '= (list 'real-part y) 0) (lambda () (subst (list '= y 0)) (dk-ass!)))
      (dk-absurd! (list '< 0 (list 'real-part y)) (list '= (list 'real-part y) 0))))
  (dk-have! (list 'IN y gmf-slit) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
  (dk-conj-close! (lambda () (dk-ass!))))
(qed 'right-half-plane-in-slit)

;;; H setup in a proof: the half-plane open, inside CC, the three slit facts as universals
(define (gmf-rhp-setup!)
  (fact 'right-half-plane-open)
  (fact 'cc-open-subset-cc gmf-rhp)
  (fact 'cc-is-set)
  (fact 'subclass-of-set-is-set gmf-rhp 'CC)
  (for-each
    (lambda (part)
      (dk-have! (list 'FORALL 'gmy_ (list 'IMPLIES (list 'IN 'gmy_ gmf-rhp) (part 'gmy_)))
        (lambda ()
          (let ((y (dk-di-var!)))
            (dk-split-all! (list (dk-cite! 'right-half-plane-in-slit y)))
            (dk-ass!)))))
    (list gmf-slit-guard (lambda (y) (list 'NOT (list '= y 0))) (lambda (y) (list 'IN y gmf-slit)))))

(define gmf-GI-body '(* (CC-EXP (* (- z 1) (CC-LOG gmw_))) (CC-EXP (- gmw_))))
(define (gmf-GI z) (list 'VNB-LAMBDA 'gmw_ gmf-rhp (gmf-subst-sym gmf-GI-body 'z z)))
