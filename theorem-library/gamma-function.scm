;;; a primitive of liab: |q| with q the integrand, regulated by its coordinates
(dk-split-all! (list (dk-fact! 'road-integrand-regulated 'u 'f gmf-cp-ID gmf-cp-ONE 'a 'b)))
(define (gmf-cp-reg proj)
  (cadr (dk-pick (lambda (fm) (and (dk-head-is? fm 'IS-REGULATED-ON) (dk-contains? fm proj)
                                   (dk-contains? fm '(f ((VNB-LAMBDA gmt_ (CCINT a b) gmt_) pat_)))))
                 "a regulated coordinate of the integrand")))
(define gmf-cp-regm
  (dk-fact! 'regulated-on-magnitude (gmf-cp-reg 'real-part) (gmf-cp-reg 'imag-part) gmf-cp-liab 'a 'b))
(dk-chain! gmf-cp-regm
  (list (cons (lambda (an) (dk-head-is? an 'FORALL))
    (lambda ()
      (let* ((z (dk-di-var!)))
        (gmf-cp-pt! z)
        (dk-lam-b!)
        (let* ((gdr (dk-goal))
               (q (cadr (cadr (cadr (caddr gdr))))))   ; magnitude(re(q) + im(q) * i)
          (gmf-cc! q)
          (fact 'real-part-in-rr q) (fact 'imag-part-in-rr q)
          (fact 'cc-re-im-decompose q)
          (fact 'rr-subset-cc (list 'imag-part q))
          (fact 'cc-i-in)
          (gmf-and! (list 'IN (list 'imag-part q) 'CC) '(IN +i CC))
          (fact 'cc-mul-comm (list 'imag-part q) '+i)
          (subst (list '= (list '* (list 'imag-part q) '+i) (list '* '+i (list 'imag-part q))))
          (subst (list '= (list '+ (list 'real-part q) (list '* '+i (list 'imag-part q))) q))
          (if (not (equal? q (list 'f z)))
              (begin (dk-have! (list '= q (list 'f z)) (lambda () (crs)))
                     (subst (list '= q (list 'f z)))))
          (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (qrfl))))))))
(define gmf-cp-pl (dk-skolem! (dk-fact! 'regulated-on-has-primitive 'a 'b gmf-cp-liab)))
;;; re(LI g) = PW-INT(re coordinate of g's integrand)
(define gmf-cp-gprims
  (let* ((ex (dk-fact! 'line-int-exists 'u 'gdr gmf-cp-ID gmf-cp-ONE 'a 'b))
         (p1 (dk-skolem! ex 'top))
         (p2 (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the second primitive") 'top)))
    (dk-split-all!)
    (list p1 p2)))
(define gmf-cp-gphi (list 'VNB-LAMBDA 'pat_ gmf-cp-I (list '* (list 'gdr (list gmf-cp-ID 'pat_)) (list gmf-cp-ONE 'pat_))))
(define gmf-cp-gre (list 'VNB-LAMBDA 'pat_ gmf-cp-I (list 'real-part (list gmf-cp-gphi 'pat_))))
(define gmf-cp-gim (list 'VNB-LAMBDA 'pat_ gmf-cp-I (list 'imag-part (list gmf-cp-gphi 'pat_))))
(let* ((p1 (car gmf-cp-gprims)) (p2 (cadr gmf-cp-gprims)))
  (fact 'line-int-unfold 'gdr gmf-cp-ID gmf-cp-ONE 'a 'b)
  (fact 'cc-int-value 'a 'b gmf-cp-gphi p1 p2)
  (fact 'cc-int-in-cc 'a 'b gmf-cp-gphi p1 p2)
  (fact 'primitive-in-fun p1 gmf-cp-gre 'a 'b)
  (fact 'primitive-in-fun p2 gmf-cp-gim 'a 'b)
  (for-each (lambda (p) (for-each (lambda (x) (fact 'fun-apply-type-c p gmf-cp-I 'RR x)) '(a b))) (list p1 p2))
  (gmf-rr! (list '- (list p1 'b) (list p1 'a)))
  (gmf-rr! (list '- (list p2 'b) (list p2 'a)))
  (fact 'cc-re-im-of (list 'CC-INT gmf-cp-gphi 'a 'b) (list '- (list p1 'b) (list p1 'a)) (list '- (list p2 'b) (list p2 'a)))
  (dk-split-all!)
  (fact 'pw-int-value p1 gmf-cp-gre 'a 'b)
  (fact 'pw-int-in-rr p1 gmf-cp-gre 'a 'b)
  (fact 'pw-int-in-rr gmf-cp-pl gmf-cp-liab 'a 'b)
  ;; liab <= re coordinate, pointwise
  (dk-chain! (dk-fact! 'pw-int-monotone gmf-cp-pl gmf-cp-liab p1 gmf-cp-gre 'a 'b)
    (list (cons (lambda (an) (dk-head-is? an 'FORALL))
      (lambda ()
        (let* ((z (dk-di-var!)) (q (list '* (list 'gdr z) 1)))
          (gmf-cp-pt! z)
          (gmf-cc! q)
          (dk-lam-b!)
          (dk-have! (list '= q (list 'gdr z)) (lambda () (crs)))
          (subst (list '= q (list 'gdr z)))
          (dk-apply! (dk-ctx-form gmf-cp-bound) z)
          (dk-ass!))))))
  (subst (list '= (gmf-li 'gdr 'a 'b) (list 'CC-INT gmf-cp-gphi 'a 'b)))
  (gmf-rr! (list 'real-part (list 'CC-INT gmf-cp-gphi 'a 'b)))
  (gmf-rr! (list 'magnitude (gmf-li 'f 'a 'b)))
  (dk-ineq! (list '<= (list 'magnitude (gmf-li 'f 'a 'b)) (list 'PW-INT gmf-cp-liab 'a 'b))
            (list '<= (list 'PW-INT gmf-cp-liab 'a 'b) (list 'PW-INT gmf-cp-gre 'a 'b))
            (list '= (list 'PW-INT gmf-cp-gre 'a 'b) (list '- (list p1 'b) (list p1 'a)))
            (list '= (list 'real-part (list 'CC-INT gmf-cp-gphi 'a 'b)) (list '- (list p1 'b) (list p1 'a)))))
(qed 'cc-int-compare-primitive)
