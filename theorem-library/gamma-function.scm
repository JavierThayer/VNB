;;; ---------------------------------------------------------------------
;;; (3) THE INTEGRAL OVER [a, b] OF A CONTINUOUS FUNCTION ON u, [a, b] INSIDE u:
;;;     the trace of the interval road, CC-INT as a line integral.
;;; ---------------------------------------------------------------------
;;; (gmf-id-at! a b x) -- x in CCINT(a, b) in context: land (= (id_ab x) x)
(define (gmf-id-at! a b x)
  (let* ((e (list '= (list (gmf-ab-id a b) x) x)))
    (if (not (dk-asm? e))
        (dk-have! e (lambda () (if (not (dk-lam-b!)) (if (not (dk-ass!)) (rfl))))))
    e))
(define (gmf-one-at! a b x)
  (let* ((e (list '= (list (gmf-ab-one a b) x) 1)))
    (if (not (dk-asm? e))
        (dk-have! e (lambda () (if (not (dk-lam-b!)) (if (not (dk-ass!)) (rfl))))))
    e))

(sp (make-wff (gmf-all '(a b u) (gmf-imps (list '(IN a RR) '(IN b RR) '(< a b) '(SUBSET (CCINT a b) u))
  (list 'SUBSET (list 'TRACE (gmf-ab-id 'a 'b) 'a 'b) 'u)))))
(dk-peel!)
(mac 'TRACE)
(let* ((w (subset-by-element!))
       (ex (dk-image-hyp! (dk-ctx-form (list 'IN w (list 'IMAGE (gmf-ab-id 'a 'b) '(CCINT a b))))))
       (x (dk-skolem! ex)))
  (fact 'ccint-elt-in-rr 'a 'b x)
  (gmf-id-at! 'a 'b x)
  (fact 'subset-mem-fwd '(CCINT a b) 'u x)
  (dk-have! (list '= x w) (lambda () (subst (list '= x (list (gmf-ab-id 'a 'b) x))) (dk-ass!)))
  (subst (list '= w x))
  (dk-ass!))
(qed 'real-interval-trace)

;;; the hypotheses H(u, f, a, b): f continuous on u inside CC, [a, b] inside u
(define (gmf-H u f a b)
  (list (list 'SUBSET u 'CC) (list 'IN f (list 'FUN u 'CC)) (gmf-cont u f)
        (list 'IN a 'RR) (list 'IN b 'RR) (list '< a b) (list 'SUBSET (list 'CCINT a b) u)))
(define (gmf-li f a b) (list 'LINE-INT f (gmf-ab-id a b) (gmf-ab-one a b) a b))

;;; H(u, f, a, b) in context: land the road, its trace in u (with the eigenvariables a b)
(define (gmf-road! u a b)
  (fact 'real-interval-is-road a b)
  (fact 'real-interval-trace a b u))

(sp (make-wff (gmf-all '(u f a b) (gmf-imps (gmf-H 'u 'f 'a 'b)
  (list '= (list 'CC-INT 'f 'a 'b) (gmf-li 'f 'a 'b))))))
(dk-peel!)
(gmf-road! 'u 'a 'b)
(define gmf-li-ID (gmf-ab-id 'a 'b))
(define gmf-li-ONE (gmf-ab-one 'a 'b))
(define gmf-li-phi (list 'VNB-LAMBDA 'pat_ '(CCINT a b) (list '* (list 'f (list gmf-li-ID 'pat_)) (list gmf-li-ONE 'pat_))))
(define gmf-li-prims
  (let* ((ex (dk-fact! 'line-int-exists 'u 'f gmf-li-ID gmf-li-ONE 'a 'b))
         (p1 (dk-skolem! ex 'top))
         (p2 (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the second primitive") 'top)))
    (dk-split-all!)
    (list p1 p2)))
(fact 'line-int-in-cc 'u 'f gmf-li-ID gmf-li-ONE 'a 'b)
(fact 'restrict-in-fun 'f 'u 'CC '(CCINT a b))
(define gmf-li-R '(RESTRICT f (CCINT a b)))
(dk-have! (list 'FORALL 'liy_ (list 'IMPLIES '(IN liy_ (CCINT a b))
            (list '== (list gmf-li-phi 'liy_) (list gmf-li-R 'liy_))))
  (lambda ()
    (let* ((y (dk-di-var!)))
      (fact 'ccint-elt-in-rr 'a 'b y)
      (fact 'subset-mem-fwd '(CCINT a b) 'u y)
      (fact 'fun-apply-type-c 'f 'u 'CC y)
      (fact 'restrict-apply 'f '(CCINT a b) y)
      (subst (list '= (list gmf-li-R y) (list 'f y)))
      (dk-lam-b!)
      (gmf-cc! 1)
      (let* ((g (dk-goal)))
        (if (not (alpha-equiv? (cadr g) (caddr g)))
            (begin
              (dk-have! (list '= (cadr g) (caddr g)) (lambda () (crs)))
              (gmf-subst-qrfl! (list '= (cadr g) (caddr g)))))))))
(fact 'cc-int-congruence gmf-li-phi gmf-li-R 'a 'b (car gmf-li-prims) (cadr gmf-li-prims))
;;; CC-INT(RESTRICT(f, [a,b])) == CC-INT(f): the coordinate lambdas are equal
(define (gmf-li-coord proj g) (list 'VNB-LAMBDA 'pat_ '(CCINT a b) (list proj (list g 'pat_))))
(fact 'rr-is-set)
(fact 'ccint-subset-rr 'a 'b)
(fact 'subclass-of-set-is-set '(CCINT a b) 'RR)
(define (gmf-li-coord-typ! lam proj g)
  (dk-have! (list 'IN lam '(FUN (CCINT a b) RR))
    (lambda ()
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (not (eq? (dk-head (dk-goal)) 'FORALL))
             (dk-ass!)
             (let ((z (dk-di-var!)))
               (fact 'subset-mem-fwd '(CCINT a b) 'u z)
               (fact 'fun-apply-type-c 'f 'u 'CC z)
               (if (not (eq? g 'f))
                   (begin (fact 'restrict-apply 'f '(CCINT a b) z)
                          (subst (list '= (list g z) (list 'f z)))))
               (fact (if (eq? proj 'real-part) 'real-part-in-rr 'imag-part-in-rr) (list 'f z))
               (dk-ass!))))
       (dk-opened (lambda () (lam-t)))))))
(define (gmf-li-coord-eq! proj)
  (let* ((l1 (gmf-li-coord proj gmf-li-R)) (l2 (gmf-li-coord proj 'f)))
    (gmf-li-coord-typ! l1 proj gmf-li-R)
    (gmf-li-coord-typ! l2 proj 'f)
    (dk-fun-ext! l1 l2 '(CCINT a b) 'RR #f #f
      (lambda (v)
        (fact 'subset-mem-fwd '(CCINT a b) 'u v)
        (fact 'fun-apply-type-c 'f 'u 'CC v)
        (fact 'restrict-apply 'f '(CCINT a b) v)
        (gmf-rr! (list proj (list 'f v)))
        (dk-lam-b!)
        (gmf-subst-close! (list '= (list gmf-li-R v) (list 'f v)))))))
(define gmf-li-eqr (gmf-li-coord-eq! 'real-part))
(define gmf-li-eqi (gmf-li-coord-eq! 'imag-part))
(fact 'cc-int-unfold gmf-li-R 'a 'b)
(fact 'line-int-unfold 'f gmf-li-ID gmf-li-ONE 'a 'b)
(define gmf-li-unf (dk-pick (lambda (fm) (and (dk-head-is? fm '==) (equal? (cadr fm) (list 'CC-INT gmf-li-R 'a 'b)))) "the unfold of CC-INT(R)"))
(mac 'CC-INT)
(subst (list '= (gmf-li-coord 'real-part 'f) (gmf-li-coord 'real-part gmf-li-R)))
(subst (list '= (gmf-li-coord 'imag-part 'f) (gmf-li-coord 'imag-part gmf-li-R)))
(subst (list '= (caddr gmf-li-unf) (list 'CC-INT gmf-li-R 'a 'b)))
(subst (list '= (list 'CC-INT gmf-li-R 'a 'b) (list 'CC-INT gmf-li-phi 'a 'b)))
(subst (list '= (gmf-li 'f 'a 'b) (list 'CC-INT gmf-li-phi 'a 'b)))
(rfl)
(qed 'cc-int-as-line-int)
(topic! 'cc-int-as-line-int 'analysis)
(alias! 'cc-int-as-line-int "the integral over [a, b] of a function continuous on a set containing [a, b] is its line integral along the real interval")

(sp (make-wff (gmf-all '(u f a b) (gmf-imps (gmf-H 'u 'f 'a 'b) '(IN (CC-INT f a b) CC)))))
(dk-peel!)
(gmf-road! 'u 'a 'b)
