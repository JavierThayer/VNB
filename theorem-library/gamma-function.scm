                                  (gmf-ineq! (list '<= (list 'magnitude gz1b) e4) (list '<= (list 'magnitude gz1b) eb)
                                             (list '<= (gmf-ex kx bigr) (gmf-ex kx m2)) (list '<= (gmf-ex kx m2) e4) (list '< 0 eb)))
                                (gmf-ineq! (dk-goal)
                                  (list '<= (list 'magnitude tot) (list '+ (list 'magnitude (list '+ a0 hbig)) (list 'magnitude (list '- hr))))
                                  (list '<= (list 'magnitude (list '+ a0 hbig)) (list '+ (list 'magnitude a0) (list 'magnitude hbig)))
                                  (list '= (list 'magnitude (list '- hr)) (list 'magnitude hr))
                                  (list '= (list 'magnitude hr) (list 'magnitude gz1r)) (list '= (list 'magnitude hbig) (list 'magnitude gz1b))
                                  (list '<= (list 'magnitude a0) e2) (list '<= (list 'magnitude gz1r) e4) (list '<= (list 'magnitude gz1b) e4)
                                  (list '= (list '+ e4 e4) e2) (list '= (list '+ e2 e2) eps))))))))))))))))))
(fact 'improper-int-value (list 'GAMMA-INTEGRAND gmf-fe-z1) gmf-fe-L)
(dk-have! (list '= (list 'GAMMA-FUNCTION gmf-fe-z1) (list 'IMPROPER-INT (list 'GAMMA-INTEGRAND gmf-fe-z1)))
  (lambda () (mac 'GAMMA-FUNCTION) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
(subst (list '= (list 'GAMMA-FUNCTION gmf-fe-z1) (list 'IMPROPER-INT (list 'GAMMA-INTEGRAND gmf-fe-z1))))
(gmf-subst-close! (list '= (list 'IMPROPER-INT (list 'GAMMA-INTEGRAND gmf-fe-z1)) gmf-fe-L))
(qed 'gamma-recursion)
(topic! 'gamma-recursion 'analysis)
(alias! 'gamma-recursion "Gamma(z + 1) = z Gamma(z) for re z > 0 (equation (101))")

;;; Gamma(n + 1) = n!, equation (102)
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (= (GAMMA-FUNCTION (+ n 1)) (FACTORIAL n))))))
(ni)
(for-each
  (lambda (leaf)
    (dk-focus! leaf)
    (let ((g (dk-goal)))
      (if (not (dk-head-is? g 'FORALL))
          ;; base: Gamma(0 + 1) = 0! = succ(0) = 1
          (begin
            (fact 'gamma-at-one)
            (fact 'factorial-zero)
            (dk-have! '(= (+ 0 1) 1) (lambda () (arith)))
            (dk-have! '(= (succ 0) 1) (lambda () (arith)))
            (subst '(= (+ 0 1) 1))
            (subst '(= (FACTORIAL 0) (succ 0)))
            (subst '(= (succ 0) 1))
            (dk-ass!))
          (let* ((k (dk-di-var!)))
            (dk-peel!)
            (let* ((sk (list 'succ k)) (k1 (list '+ k 1)))
              (fact 'nn-succ-closed k)
              (fact 'nn-in-rr k) (fact 'nn-in-rr sk) (fact 'nn-zero-le k)
              (fact 'nn-succ-plus-one k)
              (gmf-rr! k1) (gmf-cc! sk)
              (gmf-re-im-real! sk)
              (gmf-ineq! (list '< 0 sk) (list '= sk k1) (list '<= 0 k))
              (dk-have! (list '< 0 (list 'real-part sk)) (lambda () (subst (list '= (list 'real-part sk) sk)) (dk-ass!)))
              (fact 'gamma-recursion sk)
              (fact 'factorial-succ k)
              ;; Gamma(succ k) = Gamma(k + 1) = k!
              (dk-have! (list '= (list 'GAMMA-FUNCTION sk) (list 'FACTORIAL k))
                (lambda () (subst (list '= sk k1)) (dk-ass!)))
              (subst (list '= (list 'GAMMA-FUNCTION (list '+ sk 1)) (list '* sk (list 'GAMMA-FUNCTION sk))))
              (subst (list '= (list 'GAMMA-FUNCTION sk) (list 'FACTORIAL k)))
              (subst (list '= (list 'FACTORIAL sk) (list '* sk (list 'FACTORIAL k))))
              (fact 'factorial-in-nn k)
              (gmf-cc! (list '* sk (list 'FACTORIAL k)))
              (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))))
  (dk-open-leaves))
(qed 'gamma-factorial)
(topic! 'gamma-factorial 'analysis)
(alias! 'gamma-factorial "Gamma(n + 1) = n! (equation (102))")
