(alias! 'cc-exp-magnitude "|exp v| = exp(re v)")

(sp (make-wff '(FORALL u (IMPLIES (IN u RR) (FORALL v (IMPLIES (IN v RR) (IMPLIES (<= u v)
   (<= (CC-EXP u) (CC-EXP v)))))))))
(dk-peel!)
(fact 'cc-exp-real-is-r-exp 'u)
(fact 'cc-exp-real-is-r-exp 'v)
(fact 'r-exp-mono 'u 'v)
