;;; ---------------------------------------------------------------------
;;; (4) ADDITIVITY: int_a^b f = int_a^c f + int_c^b f   (a < c < b, [a, b] in u)
;;; ---------------------------------------------------------------------
;;; the interval road on [p, q] restricted from [a, b]: line-int over it = over the road on [p, q]
(define (gmf-li-restrict! u f a b p q)
  ;; context: H(u, f, a, b), p q in RR, a <= p < q <= b; lands
  ;; LINE-INT(f, RESTRICT(id_ab, [p,q]), RESTRICT(one_ab, [p,q]), p, q) = LINE-INT(f, id_pq, one_pq, p, q)
  (let* ((Ipq (list 'CCINT p q)) (Iab (list 'CCINT a b))
         (idab (gmf-ab-id a b)) (oneab (gmf-ab-one a b))
         (qg (list 'RESTRICT idab Ipq)) (qd (list 'RESTRICT oneab Ipq)))
    (fact 'ccint-subset-ccint a b p q)
    (fact 'subset-trans Ipq Iab u)
    (gmf-road! u p q)
    (fact 'is-road-is-path idab oneab a b)
    (fact 'is-path-in-fun idab a b)
    (fact 'is-road-dgam-in-fun idab oneab a b)
    (fact 'restrict-in-fun idab Iab 'CC Ipq)
    (fact 'restrict-in-fun oneab Iab 'CC Ipq)
    (let ((ptw (lambda (g whole part)
                 (lambda ()
                   (let* ((t (dk-di-var!)))
                     (if (dk-asm? (list 'IN t (list 'OOINT p q)))
                         (begin (gmf-ooint-parts! t p q) (gmf-le! p t) (gmf-le! t q) (gmf-in-ccint! t p q)))
                     (gmf-ccint-parts! t p q)
                     (gmf-le! a t) (gmf-le! t b)
                     (gmf-in-ccint! t a b)
                     (fact 'restrict-apply whole Ipq t)
                     (subst (list '= (list (list 'RESTRICT whole Ipq) t) (list whole t)))
                     (dk-lam-b!)
                     (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                         (let ((gg (dk-goal))) (if (alpha-equiv? (cadr gg) (caddr gg)) (qrfl)))))))))
      (dk-have! (list 'FORALL 't (list 'IMPLIES (list 'IN 't Ipq) (list '== (list qg 't) (list (gmf-ab-id p q) 't))))
        (ptw qg idab Ipq))
      (dk-have! (list 'FORALL 't (list 'IMPLIES (list 'IN 't (list 'OOINT p q)) (list '== (list qd 't) (list (gmf-ab-one p q) 't))))
        (ptw qd oneab Ipq))
      (fact 'line-int-interior-congruence u f (gmf-ab-id p q) (gmf-ab-one p q) p q qg qd))))

(sp (make-wff (gmf-all '(u f a b) (gmf-imps (gmf-H 'u 'f 'a 'b)
  (list 'FORALL 'c (gmf-imps (list '(IN c RR) '(< a c) '(< c b))
    '(= (CC-INT f a b) (+ (CC-INT f a c) (CC-INT f c b)))))))))
(dk-peel!)
(gmf-road! 'u 'a 'b)
(gmf-in-ooint! 'c 'a 'b)
(gmf-le! 'a 'a) (gmf-le! 'c 'c) (gmf-le! 'b 'b) (gmf-le! 'a 'c) (gmf-le! 'c 'b)
(fact 'line-int-adjacent 'u 'f (gmf-ab-id 'a 'b) (gmf-ab-one 'a 'b) 'a 'b 'c)
(gmf-li-restrict! 'u 'f 'a 'b 'a 'c)
(gmf-li-restrict! 'u 'f 'a 'b 'c 'b)
(fact 'cc-int-as-line-int 'u 'f 'a 'b)
(fact 'cc-int-as-line-int 'u 'f 'a 'c)
(fact 'cc-int-as-line-int 'u 'f 'c 'b)
(define (gmf-sp-rli p q) (list 'LINE-INT 'f (list 'RESTRICT (gmf-ab-id 'a 'b) (list 'CCINT p q))
