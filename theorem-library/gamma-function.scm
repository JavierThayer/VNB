(alias! 'improper-int-value "the improper integral is the limit when the limit exists")
;;; ---------------------------------------------------------------------
;;; (8) EXP AND LOG ON THE LINE; THE MODULUS OF THE INTEGRAND (the notes' |t^z| = t^{re z})
;;; ---------------------------------------------------------------------
(sp (make-wff '(FORALL v (IMPLIES (IN v CC) (= (magnitude (CC-EXP v)) (CC-EXP (real-part v)))))))
(dk-peel!)
(let* ((x '(real-part v)) (y '(imag-part v)) (iy (list '* +i y)) (ex (list 'CC-EXP x)) (ey (list 'CC-EXP iy)))
  (gmf-rr! x) (gmf-rr! y) (gmf-cc! x) (gmf-cc! y) (fact 'cc-i-in)
  (gmf-cc! iy) (gmf-cc! (list '+ x iy))
  (fact 'cc-re-im-decompose 'v)
  (fact 'cc-exp-add x iy)
  (gmf-cite-split! 'cc-exp-real x)
  (gmf-cc! ex) (gmf-cc! ey) (gmf-cc! '(CC-EXP v))
  (dk-have! (list '= '(CC-EXP v) (list '* ex ey))
    (lambda ()
      (subst (list '= (list '* ex ey) (list 'CC-EXP (list '+ x iy))))
      (subst (list '= (list '+ x iy) 'v))
      (rfl)))
  (subst (list '= '(CC-EXP v) (list '* ex ey)))
  (gmf-and! (list 'IN ex 'CC) (list 'IN ey 'CC))
  (fact 'cc-magnitude-mul ex ey)
  (subst (list '= (list 'magnitude (list '* ex ey)) (list '* (list 'magnitude ex) (list 'magnitude ey))))
  (fact 'cc-exp-magnitude-imaginary y)
  (subst (list '= (list 'magnitude ey) 1))
  (fact 'rr-magnitude-is-abs ex)
  (subst (list '= (list 'magnitude ex) (list 'abs ex)))
  (gmf-ineq! (list '<= 0 ex))
  (fact 'rr-abs-of-nonneg ex)
  (subst (list '= (list 'abs ex) ex))
  (crs))
(qed 'cc-exp-magnitude)
