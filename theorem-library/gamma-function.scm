;;; |LI f| <= PW-INT(liab)
(define gmf-cp-liab '(VNB-LAMBDA gmy_ (CCINT a b) (magnitude (f gmy_))))
(dk-have! (list 'IN gmf-cp-liab '(FUN (CCINT a b) RR))
  (lambda ()
    (for-each (lambda (leaf) (dk-focus! leaf)
