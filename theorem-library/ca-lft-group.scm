;;; ca-lft-group.scm -- Cor. 1.19 of complex-analysis.pdf: the linear fractional transformations
;;; form a group under composition.
;;; CA-LFT, 2026-10-19.  Library: complex-analysis.  Vocabulary: structure-library/ca-lft-vocab.scm.
;;;
;;;   lfts-intro            LFT(a, b, c, d) in LFTS when ad - bc /= 0
;;;   lfts-in-fun           a member of LFTS maps C u {oo} to itself
;;;   lfts-compose-closed   LFTS is closed under composition
;;;   id-in-lfts            the identity is LFT(1, 0, 0, 1)
;;;   lft-adjugate-left, lft-adjugate-right
;;;                         L(d, -b, -c, a) o L(a, b, c, d) = id = L(a, b, c, d) o L(d, -b, -c, a)
;;;   lfts-bijection        a member of LFTS is a bijection of C u {oo}
;;;   lfts-inverse-in       its inverse is in LFTS
;;;   lfts-inverse-left, lfts-inverse-right
;;;   lft-group-is-group    IS-GROUP(LFT-GROUP)                                 (Cor. 1.19)
;;;
;;; Helper prefix clg-.

(define (clg-finish-ass!)
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))

(define (clg-finish!)
  (let ((leaf (proof-state-focus *ps*)))
    (if (not (sequent-node-grounded? leaf))
        (if (and (dk-head-is? (dk-goal) '=) (equal? (cadr (dk-goal)) (caddr (dk-goal))))
            (rfl)
            (ass)))))

(define (clg-type! t)
  (if (not (dk-asm? (list 'IN t 'CC)))
      (dk-have! (list 'IN t 'CC) (lambda () (type-term)))))

(define (clg-rewrite! s t prove)
  (if (not (equal? s t))
      (begin (dk-have! (list '= s t) prove) (subst (list '= s t)))))
(define (clg-crs-rewrite! s t) (clg-rewrite! s t (lambda () (crs))))

(define (clg-conj fs)
  (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (clg-conj (cdr fs)))))
(define (clg-cite-and! thm fs . terms)
  (let ((c (clg-conj fs)))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    (apply dk-cite! thm terms)))

(define clg-fh '(FUN CC-HAT CC-HAT))
(define clg-id '(ID-FUN CC-HAT))

(define (clg-sep-of-lfts) (caddr (lookup-theorem 'lfts-def)))

;;; (IN f LFTS) in context: land a, b, c, d with ad - bc /= 0 and f = LFT(a, b, c, d); the
;;; membership itself SURVIVES (it is re-derived on a lane in its SEP form).
(define (clg-open! f)
  (let ((sepm (list 'IN f (clg-sep-of-lfts))))
    (fact 'lfts-def)
    (dk-have! sepm (lambda () (subst (list '= (clg-sep-of-lfts) 'LFTS)) (clg-finish-ass!)))
    (sep-me sepm)
    (let loop ((k 4) (acc '()))
      (if (= k 0)
          (reverse acc)
          (let ((ex (or (find-first (lambda (h) (and (dk-head-is? h 'FORSOME) (memq f (free-vars h)))) (dk-asms))
                        (error "clg-open!: no existential for" f))))
            (loop (- k 1) (cons (dk-skolem! ex) acc)))))))

(define (clg-witnesses! ws)
  (ew (car ws))
  (dk-conj-close!
    (lambda ()
      (cond ((dk-head-is? (dk-goal) 'FORSOME) (clg-witnesses! (cdr ws)))
            (#t (clg-finish!))))))

;;; ---------------------------------------------------------------------------

(sp (make-wff "forall([a in cc, b in cc, c in cc, d in cc], not(a * d - b * c = 0) implies lft(a, b, c, d) in lfts)"))
(let ((vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
  (apply dk-cite! 'lft-in-fun vs)
  (mac 'lfts-def)
  (in-sep! (lambda () (clg-finish-ass!)) (lambda () (clg-witnesses! vs))))
(qed 'lfts-intro)

(sp (make-wff "forall([f in lfts], f in fun(cc-hat, cc-hat))"))
(let ((f (dk-di-var!)))
  (let ((sepm (list 'IN f (clg-sep-of-lfts))))
    (fact 'lfts-def)
    (dk-have! sepm (lambda () (subst (list '= (clg-sep-of-lfts) 'LFTS)) (clg-finish-ass!)))
    (sep-me sepm)
    (clg-finish-ass!)))
(qed 'lfts-in-fun)

(sp (make-wff "forall([f in lfts, g in lfts], compose(f, g) in lfts)"))
(let* ((vs (map cadr (dk-peel!))) (f (car vs)) (g (cadr vs)))
  (let* ((p (clg-open! f)) (q (clg-open! g)))
    (subst (list '= f (cons 'LFT p)))
    (subst (list '= g (cons 'LFT q)))
    (subst (apply dk-cite! 'lft-compose (append p q)))
    (let ((l3 (cadr (dk-goal))))
      (for-each clg-type! (cdr l3))
      (apply dk-cite! 'lft-det-mul (append p q))
      (apply dk-cite! 'lfts-intro (cdr l3))
      (clg-finish-ass!))))
(qed 'lfts-compose-closed)

(sp (make-wff "id-fun(cc-hat) in lfts"))
(fact 'cc-one-in) (fact 'cc-zero-in)
(dk-have! '(NOT (= 1 0)) (lambda () (arith)))
(dk-have! '(NOT (= (- (* 1 1) (* 0 0)) 0)) (lambda () (clg-crs-rewrite! '(- (* 1 1) (* 0 0)) 1) (clg-finish-ass!)))
(dk-cite! 'lfts-intro 1 0 0 1)
(dk-cite! 'lft-scalar-identity 1)
(subst (list '= clg-id '(LFT 1 0 0 1)))
(clg-finish-ass!)
(qed 'id-in-lfts)

;;; The adjugate: L(d, -b, -c, a) inverts L(a, b, c, d) on both sides.
(define (clg-adj! left?)
  (let* ((vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))
         (a (car vs)) (b (cadr vs)) (c (caddr vs)) (d (cadddr vs))
         (dt (list '- (list '* a d) (list '* b c)))
         (adj (list d (list '- b) (list '- c) a)))
    (clg-type! (list '- b)) (clg-type! (list '- c)) (clg-type! dt)
    (dk-have! (list 'NOT (list '= (list '- (list '* d a) (list '* (list '- b) (list '- c))) 0))
      (lambda () (clg-crs-rewrite! (list '- (list '* d a) (list '* (list '- b) (list '- c))) dt) (clg-finish-ass!)))
    (subst (apply dk-cite! 'lft-compose (if left? (append adj vs) (append vs adj))))
    (let ((l3 (caddr (dk-goal))))
      (if (not (dk-head-is? l3 'LFT)) (set! l3 (cadr (dk-goal))))
      (clg-crs-rewrite! (cadr l3) dt)
      (clg-crs-rewrite! (caddr l3) 0)
      (clg-crs-rewrite! (cadddr l3) 0)
      (clg-crs-rewrite! (car (cddddr l3)) dt)
      (subst (dk-cite! 'lft-scalar-identity dt))
      (clg-finish!))))

(sp (make-wff "forall([a in cc, b in cc, c in cc, d in cc], not(a * d - b * c = 0) implies compose(lft(d, -b, -c, a), lft(a, b, c, d)) = id-fun(cc-hat))"))
(clg-adj! #t)
(qed 'lft-adjugate-left)

(sp (make-wff "forall([a in cc, b in cc, c in cc, d in cc], not(a * d - b * c = 0) implies compose(lft(a, b, c, d), lft(d, -b, -c, a)) = id-fun(cc-hat))"))
(clg-adj! #f)
(qed 'lft-adjugate-right)

;;; pointwise forms: OUTER(INNER(u)) = u from OUTER o INNER = id (THM)
(define (clg-pointwise! thm left?)
  (let* ((lk (dk-peel!))
         (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC))) lk)))
         (u  (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC-HAT))) lk)))
         (a (car vs)) (b (cadr vs)) (c (caddr vs)) (d (cadddr vs))
         (l (cons 'LFT vs))
         (g (list 'LFT d (list '- b) (list '- c) a))
         (outer (if left? g l)) (inner (if left? l g)))
    (clg-type! (list '- b)) (clg-type! (list '- c))
    (apply dk-cite! 'lft-in-fun vs)
    (apply dk-cite! 'lft-in-fun (cdr g))
    (apply dk-cite! thm vs)
    (clg-cite-and! 'compose-apply (list (list 'IN inner clg-fh) (list 'IN outer clg-fh))
                   'CC-HAT 'CC-HAT 'CC-HAT outer inner u)
    (subst (list '= (list outer (list inner u)) (list (list 'COMPOSE outer inner) u)))
    (subst (list '= (list 'COMPOSE outer inner) clg-id))
    (subst (dk-cite! 'id-fun-apply 'CC-HAT u))
    (clg-finish!)))

(sp (make-wff "forall([a in cc, b in cc, c in cc, d in cc], not(a * d - b * c = 0) implies forall([u in cc-hat], (lft(d, -b, -c, a))((lft(a, b, c, d))(u)) = u))"))
(clg-pointwise! 'lft-adjugate-left #t)
(qed 'lft-adjugate-apply-left)

(sp (make-wff "forall([a in cc, b in cc, c in cc, d in cc], not(a * d - b * c = 0) implies forall([u in cc-hat], (lft(a, b, c, d))((lft(d, -b, -c, a))(u)) = u))"))
(clg-pointwise! 'lft-adjugate-right #f)
(qed 'lft-adjugate-apply-right)

;;; L(a, b, c, d) is a bijection of C u {oo}, and its inverse is the adjugate's LFT.
(sp (make-wff "forall([a in cc, b in cc, c in cc, d in cc], not(a * d - b * c = 0) implies lft(a, b, c, d) in bijection(cc-hat, cc-hat))"))
(let* ((vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))
       (a (car vs)) (b (cadr vs)) (c (caddr vs)) (d (cadddr vs))
       (l (cons 'LFT vs))
       (g (list 'LFT d (list '- b) (list '- c) a)))
  (clg-type! (list '- b)) (clg-type! (list '- c))
  (apply dk-cite! 'lft-in-fun vs)
  (apply dk-cite! 'lft-in-fun (cdr g))
  (apply dk-cite! 'lft-adjugate-apply-left vs)
  (apply dk-cite! 'lft-adjugate-apply-right vs)
  (dk-cite! 'bijection-from-inverse 'CC-HAT 'CC-HAT l g)
  (clg-finish-ass!))
(qed 'lft-bijection)

(sp (make-wff "forall([a in cc, b in cc, c in cc, d in cc], not(a * d - b * c = 0) implies inverse-bij(lft(a, b, c, d), cc-hat, cc-hat) = lft(d, -b, -c, a))"))
(let* ((vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))
       (a (car vs)) (b (cadr vs)) (c (caddr vs)) (d (cadddr vs))
       (l (cons 'LFT vs))
       (g (list 'LFT d (list '- b) (list '- c) a))
       (iv (list 'INVERSE-BIJ l 'CC-HAT 'CC-HAT)))
  (clg-type! (list '- b)) (clg-type! (list '- c))
  (apply dk-cite! 'lft-in-fun vs)
  (apply dk-cite! 'lft-in-fun (cdr g))
  (apply dk-cite! 'lft-bijection vs)
  (dk-cite! 'inverse-bij-in-fun 'CC-HAT 'CC-HAT l)
  (apply dk-cite! 'lft-adjugate-apply-left vs)
  (dk-fun-ext! iv g 'CC-HAT 'CC-HAT #f #f
    (lambda (y)
      (let ((x (list iv y)))
        (dk-cite! 'inverse-bij-right 'CC-HAT 'CC-HAT l y)
        (dk-cite! 'fun-codomain-iff 'CC-HAT 'CC-HAT iv)
        (dk-have! (list 'IN x 'CC-HAT)
          (lambda ()
            (let ((iff (dk-ctx-form (list 'IFF (list 'IN iv clg-fh)
                                          (caddr (dk--fact-instance 'fun-codomain-iff (list 'CC-HAT 'CC-HAT iv)))))))
              (dk-have! (caddr iff) (lambda () (dk-only! iff (list 'IN iv clg-fh)) (prop)))
              (dk-split-all!)
              (let ((all (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h iv))) (dk-asms))))
                (dk-apply! all y)
                (clg-finish-ass!)))))
        (dk-apply! (dk-ctx-form (dk--fact-instance 'lft-adjugate-apply-left vs)) x)
        (subst (list '= x (list g (list l x))))
        (subst (list '= (list l x) y))
        (clg-finish!)))))
(qed 'lft-inverse-bij)

(sp (make-wff "lfts in set"))
(mac 'lfts-def)
(fact 'cc-hat-in-set)
(let ((iff (dk-cite! 'fun-set-iff 'CC-HAT 'CC-HAT)))
  (dk-have! (list 'IN clg-fh 'SET) (lambda () (dk-only! iff '(IN CC-HAT SET)) (prop))))
(sep-set)
(if (pair? (dk-open-leaves)) (clg-finish-ass!))
(qed 'lfts-in-set)

(sp (make-wff "forall([f in lfts], inverse-bij(f, cc-hat, cc-hat) in lfts)"))
(let* ((f (dk-di-var!))
       (p (clg-open! f))
       (a (car p)) (b (cadr p)) (c (caddr p)) (d (cadddr p)))
  (subst (list '= f (cons 'LFT p)))
  (subst (apply dk-cite! 'lft-inverse-bij p))
  (clg-type! (list '- b)) (clg-type! (list '- c))
  (dk-have! (list 'NOT (list '= (list '- (list '* d a) (list '* (list '- b) (list '- c))) 0))
    (lambda () (clg-crs-rewrite! (list '- (list '* d a) (list '* (list '- b) (list '- c)))
                                 (list '- (list '* a d) (list '* b c)))
               (clg-finish-ass!)))
  (dk-cite! 'lfts-intro d (list '- b) (list '- c) a)
  (clg-finish-ass!))
(qed 'lfts-inverse-in)

;;; ---------------------------------------------------------------------------
;;; Cor. 1.19.

(define clg-tuple (cdr (caddr (lookup-theorem 'lft-group-def))))   ; [LFTS, opr, id, inv]
(define clg-opr (cadr clg-tuple))
(define clg-inv (cadddr clg-tuple))

(define (clg-cart-close!)
  (mac 'cartesian-set-iff)
  (fact 'lfts-in-set)
  (dk-conj-close! (lambda () (clg-finish-ass!))))

(define (clg-lfts-vars landed)
  (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'LFTS) (symbol? (cadr f)))) landed)))

;;; the composition of the group, typed
(sp (make-wff (list 'IN clg-opr '(FUN (CARTESIAN LFTS LFTS) LFTS))))
(dk-lam-type!
  (lambda ()
    (dk-peel!)
    (let ((t (cadr (dk-goal))))
      (dk-cite! 'lfts-compose-closed (cadr t) (caddr t))
      (clg-finish-ass!)))
  clg-cart-close!)
(qed 'lft-group-opr-type)

;;; the inverse of the group, typed
(sp (make-wff (list 'IN clg-inv '(FUN LFTS LFTS))))
(dk-lam-type!
  (lambda ()
    (let ((u (dk-di-var!)))
      (dk-cite! 'lfts-inverse-in u)
      (clg-finish-ass!)))
  (lambda () (fact 'lfts-in-set) (clg-finish-ass!)))
(qed 'lft-group-inv-type)

(define (clg-tuple-sets!)               ; each component of LFT-GROUP is a set
  (fact 'lfts-in-set) (fact 'id-in-lfts)
  (fact 'lft-group-opr-type) (fact 'lft-group-inv-type)
  (dk-cite! 'membership-implies-sethood clg-id 'LFTS)
  (dk-cite! 'membership-implies-sethood clg-opr '(FUN (CARTESIAN LFTS LFTS) LFTS))
  (dk-cite! 'membership-implies-sethood clg-inv '(FUN LFTS LFTS)))

(define (clg-group-leaf!)
  (let ((g (dk-goal)))
    (cond
      ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH))
       (let ((def (dk-cite! 'lft-group-def)))
         (subst def))
       (len-r) (clg-finish!))
      ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g)))
       (clg-tuple-sets!) (rfl))
      ((equal? g '(IN LFTS SET)) (fact 'lfts-in-set) (clg-finish-ass!))
      ((equal? g (list 'IN clg-id 'LFTS)) (fact 'id-in-lfts) (clg-finish-ass!))
      ((equal? g (list 'IN clg-opr '(FUN (CARTESIAN LFTS LFTS) LFTS))) (fact 'lft-group-opr-type) (clg-finish-ass!))
      ((equal? g (list 'IN clg-inv '(FUN LFTS LFTS))) (fact 'lft-group-inv-type) (clg-finish-ass!))
      ((dk-head-is? g 'is-associative)
       (mac 'is-associative)
       (let* ((vs (clg-lfts-vars (dk-peel!)))
              (u (car vs)) (v (cadr vs)) (w (caddr vs)))
         (fact 'cc-hat-in-set)
         (for-each (lambda (x) (dk-cite! 'lfts-in-fun x)) vs)
         (dk-cite! 'lfts-compose-closed u v)
         (dk-cite! 'lfts-compose-closed v w)
         (dk-cite! 'lfts-compose-closed (list 'COMPOSE u v) w)
         (dk-cite! 'lfts-compose-closed u (list 'COMPOSE v w))
         (dk-lam-b!)
         (dk-cite! 'compose-assoc 'CC-HAT 'CC-HAT 'CC-HAT 'CC-HAT w v u)
         (subst (list '= (list 'COMPOSE (list 'COMPOSE u v) w) (list 'COMPOSE u (list 'COMPOSE v w))))
         (clg-finish!)))
      ((dk-head-is? g 'is-identity)
       (mac 'is-identity)
       (let ((u (car (clg-lfts-vars (dk-peel!)))))
         (fact 'cc-hat-in-set) (fact 'id-in-lfts)
         (dk-cite! 'lfts-in-fun u)
         (dk-lam-b!)
         (dk-cite! 'compose-id-left 'CC-HAT 'CC-HAT u)
         (dk-cite! 'compose-id-right 'CC-HAT 'CC-HAT u)
         (dk-conj-close! (lambda () (clg-finish-ass!)))))
      ((dk-head-is? g 'has-inverses)
       (mac 'has-inverses)
       (let* ((u (car (clg-lfts-vars (dk-peel!)))))
         (dk-cite! 'lfts-inverse-in u)
         (dk-lam-b!)
         (let* ((p (clg-open! u)))
           (subst (list '= u (cons 'LFT p)))
           (subst (apply dk-cite! 'lft-inverse-bij p))
           (apply dk-cite! 'lft-adjugate-left p)
           (apply dk-cite! 'lft-adjugate-right p)
           (dk-conj-close! (lambda () (clg-finish-ass!))))))
      (#t (error "clg-group-leaf!: unexpected conjunct" (expression->string g))))))

(sp (make-wff '(IS-GROUP LFT-GROUP)))
(mac 'is-group)
(slot 'CARR)
(slot 'OPR)
(slot 'IDEN)
(slot 'INV)
(dk-conj-close! clg-group-leaf!)
(let sweep ((fuel 10))
  (let ((open (dk-open-leaves)))
    (if (and (pair? open) (> fuel 0))
        (begin (dk-focus! (car open)) (clg-group-leaf!) (sweep (- fuel 1))))))
(qed 'lft-group-is-group)
