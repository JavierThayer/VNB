;;; ch3f-line.scm -- CH3-F: Proposition 3.45 (holomorphy across a straight line).
;;; Loaded after ch3f-rem.scm (cc-cont-at-mag, cc-cont-at-of-mag) and the orientation files.
;;; Helper prefix ln-.
;;;   (1) cc-uniform-continuity-ball: a function continuous on an open U is uniformly continuous on a
;;;       closed ball inside U (Bolzano-Weierstrass, by contradiction).
;;; Library: complex-analysis.

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

;;; ---- helper defines COPIED 2026-10-30 (wave-2 integration) from ch3e/ch3e-angle.scm, ch3e/ch3e-orient.scm, ch3e/ch3e-wind.scm:
;;; the probe loaded this chain in ONE environment; load.scm gives each file its own.
(define (an-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "an-pick: nothing matching" what) (car l))))
(define (an-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (an-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (an-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))
(define (an-lt-of-le-ne! a b)    ; a <= b and NOT (b = a) in context => a < b
  (if (not (dk-asm? (list 'NOT (list '= a b))))
      (dk-have! (list 'NOT (list '= a b))
        (lambda () (di) (dk-have! (list '= b a) (lambda () (subst (list '= a b)) (rfl))) (ai (list 'NOT (list '= b a))))))
  (an-rr! a) (an-rr! b)
  (let ((ch (dk-cite! 'rr-le-ne-lt a b)))
    (if (and (pair? ch) (eq? (car ch) 'IMPLIES))
        (detach-with! ch (lambda () (dk-conj-close! (lambda () (ass))))))))
(define (ao-cr z w) (list 'imag-part (list '* z (list 'conjugate w))))
(define (ao-base! z)
  (an-cc! z)
  (fact 'real-part-in-rr z) (fact 'imag-part-in-rr z)
  (let* ((dec (dk-cite! 'cc-re-im-decompose z))
         (x (dk-name! (list 'real-part z) 'RR))
         (d1 (dk-rewrite-h! dec (list 'real-part z) x))
         (y (dk-name! (list 'imag-part z) 'RR)))
    (dk-rewrite-h! d1 (list 'imag-part z) y)
    (cons z (cons x y))))
(define (ao-eval e env)                       ; -> (X . Y); (* c e) has c real
  (let ((hit (assoc e env)))
    (cond (hit (cdr hit))
          ((eqv? e 0) (cons 0 0))
          ((and (pair? e) (eq? (car e) '+))
           (let ((a (ao-eval (cadr e) env)) (b (ao-eval (caddr e) env)))
             (cons (list '+ (car a) (car b)) (list '+ (cdr a) (cdr b)))))
          ((and (pair? e) (eq? (car e) '-) (= (length e) 3))
           (let ((a (ao-eval (cadr e) env)) (b (ao-eval (caddr e) env)))
             (cons (list '- (car a) (car b)) (list '- (cdr a) (cdr b)))))
          ((and (pair? e) (eq? (car e) '-))
           (let ((a (ao-eval (cadr e) env))) (cons (list '- (car a)) (list '- (cdr a)))))
          ((and (pair? e) (eq? (car e) '*))
           (let ((a (ao-eval (caddr e) env))) (cons (list '* (cadr e) (car a)) (list '* (cadr e) (cdr a)))))
          (#t (error "ao-eval: no coordinates for" e)))))
(define (ao-coords! e env)                    ; lands Re e = X, Im e = Y; returns (X . Y)
  (let* ((xy (ao-eval e env)) (X (car xy)) (Y (cdr xy)))
    (an-cc! e) (an-rr! X) (an-rr! Y)
    (let ((eq (list '= e (list '+ X (list '* Y '+i)))))
      (if (not (dk-asm? eq))
          (dk-have! eq (lambda ()
                         (for-each (lambda (b) (if (dk-contains? (cadr (dk-goal)) (car b))
                                                   (subst (list '= (car b) (list '+ (cadr b) (list '* '+i (cddr b)))))))
                                   env)
                         (crs))))
      (if (not (and (dk-asm? (list '= (list 'real-part e) X)) (dk-asm? (list '= (list 'imag-part e) Y))))
          (dk-split-all! (list (dk-cite! 'cc-re-im-of e X Y))))
      xy)))
(define (ao-cross! z w env)                   ; lands cr(z, w) = Yz Xw - Xz Yw; returns the RHS
  (let* ((a (ao-coords! z env)) (b (ao-coords! w env))
         (rhs (list '- (list '* (cdr a) (car b)) (list '* (car a) (cdr b))))
         (eq (list '= (ao-cr z w) rhs)))
    (if (not (dk-asm? eq))
        (let ((t1 (dk-cite! 'cc-cross-coords z w)))
          (dk-have! eq (lambda ()
                         (subst t1)
                         (subst (list '= (list 'imag-part z) (cdr a))) (subst (list '= (list 'real-part w) (car b)))
                         (subst (list '= (list 'real-part z) (car a))) (subst (list '= (list 'imag-part w) (cdr b)))
                         (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass) (crs)))))))
    rhs))
(define (ao-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (ao-unit! v)
  (let ((mem (list 'IN v '(CCINT 0 1))))
    (fact 'ccint-elt-in-rr 0 1 v)
    (if (not (and (dk-asm? (list '<= 0 v)) (dk-asm? (list '<= v 1))))
        (let ((cj (list 'AND (list '<= 0 v) (list '<= v 1))))
          (dk-have! cj (lambda () (mac-h 'ccint-membership mem) (dk-split-all!) (dk-conj-close! (lambda () (ass)))))
          (dk-split! cj)))))
(define (ao-conv3-open! mem)
  (let* ((new (dk-landed* (lambda () (mac-h 'conv3-member-iff mem))))
         (parts (dk-split-all! new))
         (ex1 (find-first (dk-head? 'FORSOME) (append parts new)))
         (l (dk-skolem! ex1))
         (m (dk-skolem! (dk-pick (lambda (f) (and (ao-op? f 'FORSOME 3) (dk-contains? f l))) "the second coefficient")))
         (n (dk-skolem! (dk-pick (lambda (f) (and (ao-op? f 'FORSOME 3) (dk-contains? f m))) "the third coefficient"))))
    (dk-split-all!)
    (for-each ao-unit! (list l m n))
    (list l m n)))
(define (aw-H mu u) (list 'SEP 'aohw_ 'CC (list '< 0 (list 'real-part (list '* mu (list '- 'aohw_ u))))))
;;; ---- end of copied helpers ----

(define ln-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (ln-cont u f) (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u) (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS ln-nfm u) ln-nfm f 'rgy_))))
(define ln-seq-family '())
(define (ln-choose-seq! A Pf witness-of)
  (let* ((L   (list 'VNB-LAMBDA 'lnk_ 'NN (list 'SEP 'lnw_ A (Pf 'lnk_ 'lnw_))))
         (inh (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
                (list 'FORSOME 'w (list 'AND (list 'IN 'w A) (list 'IN 'w (list L 'k))))))))
    (dk-have! inh
      (lambda ()
        (let* ((k (dk-di-var!)))
          (dk-lam-b!)
          (let ((w (witness-of k)))
            (ew w)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (caddr (dk-goal)) 'SEP)
                    (dk-close-all! (lambda () (sep-mi)))
                    (ass))))))))
    (let ((g (dk-skolem! (dk-cite! 'rmm-nn-choice A L))))
      (set! ln-seq-family (cons (cons g L) ln-seq-family))
      g)))
(define (ln-seq-at! g k)                    ; lands g(k) in A and the chosen property at k
  (let* ((L  (cdr (assq g ln-seq-family)))
         (cl (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IN (list g 'k) (list L 'k))))))
         (h  (dk-apply! (or cl (error "ln-seq-at!: the choice clause is not in context" g)) k)))
    (dk-lam-b-h! h)
    (let ((m (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list g k))
                                       (dk-head-is? (caddr f) 'SEP)))
                      "the chosen membership")))
      (dk-split-all! (dk-landed (lambda () (sep-me m)))))))

;;; ---------------------------------------------------------------------------
;;; uniform continuity on a closed ball inside U
(define ln-CB '(CLOSED-BALL CC-MS lnc_ lnr_))
(define (ln-close x y) (list '< (list 'magnitude (list '- x y)) 'del))
(define ln-Q
  (list 'FORSOME 'del (list 'AND '(POS-RR del)
    (list 'FORALL 'lnx_ (list 'IMPLIES (list 'IN 'lnx_ ln-CB) (list 'FORALL 'lny_ (list 'IMPLIES (list 'IN 'lny_ ln-CB)
      (list 'IMPLIES (ln-close 'lnx_ 'lny_) '(<= (magnitude (- (f lnx_) (f lny_))) eps)))))))))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ln-nfm 'u) (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN u CC)) (list 'IMPLIES (ln-cont 'u 'f)
  (list 'FORALL 'lnc_ (list 'IMPLIES '(IN lnc_ CC) (list 'FORALL 'lnr_ (list 'IMPLIES '(IN lnr_ RR) (list 'IMPLIES '(< 0 lnr_)
  (list 'IMPLIES (list 'SUBSET ln-CB 'u)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) ln-Q)))))))))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (memq (car (dk-goal)) '(IMPLIES FORALL))) (begin (di) (loop))))
(fact 'cc-is-metric-space)
(fact 'cc-open-subset-cc 'u)
(dk-have! '(SUBSET (CLOSED-BALL CC-MS lnc_ lnr_) CC)
  (lambda () (let ((z (subset-by-element!))) (dk-split-all! (list (dk-cite! 'cc-closed-ball-mem 'lnc_ 'lnr_ z))) (dk-ass!))))
(fact 'rr-pos-rr-in-rr 'eps) (fact 'rr-lt-of-pos-rr 'eps)
(use-em ln-Q
  (lambda () (ass))
  (lambda ()
    (let* ((CB ln-CB)
           (rk (lambda (k) (list 'recip (list '+ k 1))))
           (P (lambda (k w) (list 'FORSOME 'lny_ (list 'AND (list 'IN 'lny_ CB)
                              (list 'AND (list '< (list 'magnitude (list '- w 'lny_)) (rk k))
                                         (list 'NOT (list '<= (list 'magnitude (list '- (list 'f w) '(f lny_))) 'eps)))))))
           (rk-facts! (lambda (k)                ; recip(k + 1) in RR, > 0, POS-RR
                        (fact 'nn-in-rr k) (an-rr! (list '+ k 1))
                        (dk-have! (list '< 0 (list '+ k 1)) (lambda () (fact 'nn-zero-le k) (dk-ineq! (list '<= 0 k))))
                        (dk-have! (list 'NOT (list '= (list '+ k 1) 0)) (lambda () (di) (dk-absurd! (list '= (list '+ k 1) 0) (list '< 0 (list '+ k 1)))))
                        (an-and! (list 'IN (list '+ k 1) 'RR) (list 'NOT (list '= (list '+ k 1) 0)))
                        (fact 'rr-recip-closed (list '+ k 1)) (fact 'rr-recip-pos (list '+ k 1))
                        (dk-cite! 'rr-pos-rr-of-lt (rk k))))
           (xs (ln-choose-seq! CB P
                 (lambda (k)
                   (let ((ex (list 'FORSOME 'lnw_ (list 'AND (list 'IN 'lnw_ CB) (P k 'lnw_)))))
                     (rk-facts! k)
                     (dk-have! ex
                       (lambda ()
                         (use-em ex (lambda () (ass))
                           (lambda ()
                             (dk-have! ln-Q
                               (lambda ()
                                 (ew (rk k))
                                 (dk-conj-close!
                                   (lambda ()
                                     (if (dk-asm? (dk-goal)) (ass)
                                         (let* ((new (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
                                                (cl (find-first (lambda (x) (and (ao-op? x '< 3) (dk-head-is? (cadr x) 'magnitude))) new))
                                                (x (cadr (cadr (cadr cl)))) (y (caddr (cadr (cadr cl)))))
                                           (use-em (list '<= (list 'magnitude (list '- (list 'f x) (list 'f y))) 'eps)
                                             (lambda () (ass))
                                             (lambda ()
                                               (dk-have! ex (lambda () (ew x) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                                                                           (begin (ew y) (dk-conj-close! (lambda () (ass)))))))))
                                               (dk-only! ex (list 'NOT ex))
                                               (prop)))))))))
                             (dk-only! ln-Q (list 'NOT ln-Q))
                             (prop)))))
                     (let ((w (dk-skolem! ex))) (dk-split-all!) w)))))
           (ys (ln-choose-seq! CB
                 (lambda (k y) (list 'AND (list '< (list 'magnitude (list '- (list xs k) y)) (rk k))
                                          (list 'NOT (list '<= (list 'magnitude (list '- (list 'f (list xs k)) (list 'f y))) 'eps))))
                 (lambda (k)
                   (ln-seq-at! xs k)
                   (let ((y (dk-skolem! (an-pick "the partner" (lambda (x) (and (ao-op? x 'FORSOME 3) (eq? (cadr x) 'lny_)))) #t)))
                     (dk-split-all!)
                     (an-and! (list '< (list 'magnitude (list '- (list xs k) y)) (rk k))
                              (list 'NOT (list '<= (list 'magnitude (list '- (list 'f (list xs k)) (list 'f y))) 'eps)))
                     y)))))
      (let* ((c 'lnc_) (R 'lnr_) (bd (list '+ (list 'magnitude c) R)))
        (fact 'cc-magnitude-closed c) (an-rr! bd)
        (define (mag! z) (an-cc! z) (fact 'cc-magnitude-closed z) (fact 'cc-magnitude-nonneg z))
        (define (in-cb! k)                     ; xs(k) or the like in CB: typings and |. - c| <= R
          (dk-split-all! (list (dk-cite! 'cc-closed-ball-mem c R k)))
          (mag! (list '- k c)) (mag! k))
        (dk-have! (list 'FORALL 'lni_ (list 'IMPLIES '(IN lni_ NN) (list '<= (list 'magnitude (list xs 'lni_)) bd)))
          (lambda ()
            (let* ((i (dk-di-var!)))
              (ln-seq-at! xs i)
              (in-cb! (list xs i))
              (dk-cite! 'cc-magnitude-le-add (list xs i) c)
              (dk-ineq! (list '<= (list 'magnitude (list xs i)) (list '+ (list 'magnitude (list '- (list xs i) c)) (list 'magnitude c)))
                        (list '<= (list 'magnitude (list '- (list xs i) c)) R)))))
        (fact 'fun-codomain-superset xs 'NN CB 'CC)
        (let* ((phi (dk-skolem! (dk-cite! 'cc-bolzano-weierstrass xs bd) #t))
               (l (dk-skolem! (an-pick "the limit" (lambda (x) (and (ao-op? x 'FORSOME 3) (dk-contains? x 'converges-to)))) #t))
               (sq (list 'SUBSEQ xs phi)))
          (dk-split-all!)
          (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
          (dk-have! (list 'IN c '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
          (dk-apply! (dk-cite! 'closed-ball-is-closed 'CC-MS) c R)
          (let ((spm (dk-cite! 'strictly-mono-nn phi)))
            (dk-have! (caddr spm) (lambda () (prop)))
            (dk-split-all! (list (caddr spm))))
          (dk-have! (list 'FORALL 'lnn_ (list 'IMPLIES '(IN lnn_ NN) (list 'IN (list sq 'lnn_) CB)))
            (lambda ()
              (let* ((n (dk-di-var!)))
                (fact 'fun-apply-type-c phi 'NN 'NN n)
                (ln-seq-at! xs (list phi n))
                (subst (dk-cite! 'subseq-apply xs phi n))
                (dk-ass!))))
          (dk-fact! 'closed-set-limit-in 'CC-MS CB sq l)
          (dk-fact! 'subset-mem-fwd CB 'u l)
          ;; continuity at l, with eps / 2
          (dk-apply! (ln-cont 'u 'f) l)
          (let* ((mg (dk-cite! 'cc-cont-at-mag 'u 'f l))
                 (e2 (dk-halve! 'eps))
                 (dl (dk-skolem! (dk-apply! mg e2) #t))
                 (M (an-pick "the continuity clause" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x dl)))))
                 (d2 (dk-halve! dl)))
            (fact 'rr-pos-rr-in-rr dl) (fact 'rr-lt-of-pos-rr dl) (fact 'rr-pos-rr-in-rr e2) (fact 'rr-lt-of-pos-rr e2)
            (fact 'rr-lt-of-pos-rr d2)
            (let* ((cv (dk-cite! 'converges-to 'CC-MS sq l))
                   (fwd (begin (ai cv) (dk-landed-1 (lambda () (detach! (list 'IMPLIES (cadr cv) (caddr cv))))))))
              (dk-split-all! (list fwd))
              (let* ((cvq (an-pick "the convergence clause" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x 'POS-RR) (dk-contains? x sq)))))
                     (bN (dk-skolem! (dk-apply! cvq d2) #t))
                     (tail (an-pick "the tail" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x bN)))))
                     (bK (dk-skolem! (dk-cite! 'nn-recip-succ-small d2) #t))
                     (j (list '+ bN bK)) (pj (list phi j)))
                (dk-split-all!)
                (an-and! (list 'IN bN 'NN) (list 'IN bK 'NN)) (fact 'nn-add-closed bN bK)
                (fact 'nn-le-add-right bK bN) (fact 'nn-le-add-left bN bK)
                (dk-cite! 'strictly-mono-ge-id phi j)
                (fact 'fun-apply-type-c phi 'NN 'NN j)
                (for-each (lambda (x) (fact 'nn-in-rr x)) (list bN bK j pj))
                (dk-have! (list '<= bK pj) (lambda () (dk-ineq! (list '<= bK j) (list '<= j pj))))
                (dk-cite! 'nn-recip-succ-antitone bK pj)
                (dk-apply! tail j)
                (ln-seq-at! xs pj) (ln-seq-at! ys pj)
                (let* ((xj (list xs pj)) (yj (list ys pj)))
                  (in-cb! xj) (in-cb! yj)
                  (rk-facts! pj) (rk-facts! bK)
                  (let* ((tl (list '<= (list '(DIST CC-MS) (list sq j) l) d2))
                         (sa (dk-cite! 'subseq-apply xs phi j))
                         (t1 (dk-rewrite-h! tl (list sq j) xj))
                         (cd (dk-cite! 'cc-ms-dist xj l))
                         (t2 (dk-rewrite-h! t1 (list '(DIST CC-MS) xj l) (list 'magnitude (list '- xj l)))))
                    (for-each mag! (list (list '- xj l) (list '- yj l) (list '- yj xj) (list '- xj yj)))
                    (dk-cite! 'cc-magnitude-sub-sym yj xj)
                    (dk-cite! 'cc-magnitude-sub-chain yj xj l)
                    (dk-have! (list '< (list 'magnitude (list '- yj l)) dl)
                      (lambda () (dk-ineq! (list '<= (list 'magnitude (list '- yj l)) (list '+ (list 'magnitude (list '- yj xj)) (list 'magnitude (list '- xj l))))
                                           (list '= (list 'magnitude (list '- yj xj)) (list 'magnitude (list '- xj yj)))
                                           (list '< (list 'magnitude (list '- xj yj)) (rk pj))
                                           (list '<= (rk pj) (rk bK)) (list '< (rk bK) d2)
                                           t2 (list '= (list '+ d2 d2) dl))))
                    (dk-have! (list '< (list 'magnitude (list '- xj l)) dl)
                      (lambda () (dk-ineq! t2 (list '< 0 d2) (list '= (list '+ d2 d2) dl))))
                    (dk-fact! 'subset-mem-fwd CB 'u xj) (dk-fact! 'subset-mem-fwd CB 'u yj)
                    (dk-apply! M xj) (dk-apply! M yj)
                    (let* ((fx (list 'f xj)) (fy (list 'f yj)) (fl (list 'f l)))
                      (fact 'fun-apply-type-c 'f 'u 'CC xj) (fact 'fun-apply-type-c 'f 'u 'CC yj) (fact 'fun-apply-type-c 'f 'u 'CC l)
                      (for-each mag! (list (list '- fx fy) (list '- fx fl) (list '- fl fy) (list '- fy fl)))
                      (dk-cite! 'cc-magnitude-sub-chain fx fl fy)
                      (dk-cite! 'cc-magnitude-sub-sym fl fy)
                      (let ((X (list '<= (list 'magnitude (list '- fx fy)) 'eps)))
                        (dk-have! X (lambda () (dk-ineq! (list '<= (list 'magnitude (list '- fx fy)) (list '+ (list 'magnitude (list '- fx fl)) (list 'magnitude (list '- fl fy))))
                                                         (list '= (list 'magnitude (list '- fl fy)) (list 'magnitude (list '- fy fl)))
                                                         (list '< (list 'magnitude (list '- fx fl)) e2)
                                                         (list '< (list 'magnitude (list '- fy fl)) e2)
                                                         (list '= (list '+ e2 e2) 'eps))))
                        (if (dk-only! X (list 'NOT X)) (prop)))))))))))
      #t)))
(qed 'cc-uniform-continuity-ball)
;;; ---------------------------------------------------------------------------
;;; (2) the restriction of a continuous function to an open subset is continuous
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ln-nfm 'u) (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN u CC)) (list 'IMPLIES (ln-cont 'u 'f)
  (list 'FORALL 'lnw_ (list 'IMPLIES (list 'IS-OPEN ln-nfm 'lnw_) (list 'IMPLIES '(SUBSET lnw_ u)
    (list 'FORALL 'lnq_ (list 'IMPLIES '(IN lnq_ lnw_) (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS ln-nfm 'lnw_) ln-nfm '(RESTRICT f lnw_) 'lnq_)))))))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (memq (car (dk-goal)) '(IMPLIES FORALL))) (begin (di) (loop))))
(let* ((u 'u) (f 'f) (w 'lnw_) (Fr (list 'RESTRICT f w)) (z (list-ref (dk-goal) 4)))
  (fact 'restrict-in-fun f u 'CC w)
  (fact 'cc-open-subset-cc u) (fact 'cc-open-subset-cc w)
  (dk-fact! 'subset-mem-fwd w u z)
  (dk-apply! (ln-cont u f) z)
  (let* ((mg (dk-cite! 'cc-cont-at-mag u f z))
         (ch (dk-cite! 'cc-cont-at-of-mag w Fr z)))
    (detach-with! ch
      (lambda ()
        (let* ((e (cadr (find-first (lambda (x) (dk-head-is? x 'POS-RR)) (dk-landed (lambda () (di) (if (eq? (car (dk-goal)) 'IMPLIES) (di))))))))
          (let* ((dl (dk-skolem! (dk-apply! mg e) #t))
                 (cl (an-pick "the clause" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x dl))))))
            (ew dl)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (ass)
                    (let* ((new (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
                           (y (cadr (find-first (lambda (x) (and (ao-op? x 'IN 3) (eq? (caddr x) w))) new))))
                      (dk-fact! 'subset-mem-fwd w u y)
                      (dk-apply! cl y)
                      (subst (dk-cite! 'restrict-apply f w y))
                      (subst (dk-cite! 'restrict-apply f w z))
                      (dk-ass!)))))))))
    (if (not (proof-done? *ps*)) (dk-ass!))))
(qed 'ln-restrict-continuous)

;;; ---------------------------------------------------------------------------
;;; (3) THE LINE (complex-analysis.pdf 3.45 "an infinite straight line"): the points z with
;;;     (z - p) conj(d) real, i.e. the line through p in the direction d /= 0.


(define (ln-psi z p0 d) (ao-cr (list '- z p0) d))

;;; the unfold of CC-LINE as a theorem (mac-h cannot unfold a functoid by its own name)
(sp (make-wff '(FORALL clnp_ (FORALL clnd_ (== (CC-LINE clnp_ clnd_) (SEP clnz_ CC (= (imag-part (* (- clnz_ clnp_) (conjugate clnd_))) 0)))))))
(dk-peel!) (mac 'CC-LINE) (if (not (proof-done? *ps*)) (qrfl))
(qed 'cc-line-unfold)

;;; (4) a complex number of modulus at most e P for every e > 0 is 0
(sp (make-wff (forall-guarded '(lnz_ lnp_) '((IN lnz_ CC) (IN lnp_ RR))
  (list 'IMPLIES '(<= 0 lnp_)
    (list 'IMPLIES '(FORALL lne_ (IMPLIES (POS-RR lne_) (<= (magnitude lnz_) (* lne_ lnp_))))
      '(= lnz_ 0))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (eq? (car (dk-goal)) 'IMPLIES)) (begin (di) (loop))))
(let* ((z 'lnz_) (P 'lnp_) (m '(magnitude lnz_))
       (H (an-pick "the bound" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x 'POS-RR))))))
  (fact 'cc-magnitude-closed z) (fact 'cc-magnitude-nonneg z)
  (use-em (list '= z 0) (lambda () (ass))
    (lambda ()
      (let ((iff (dk-cite! 'cc-magnitude-zero-iff z)))
        (dk-have! (list 'NOT (list '= m 0))
          (lambda () (di) (ai iff) (detach! (list 'IMPLIES (list '= m 0) (list '= z 0))) (ai (list 'NOT (list '= z 0))))))
      (an-lt-of-le-ne! 0 m)
      (let* ((Q (list '* 2 (list '+ P 1))))
        (an-rr! Q)
        (dk-have! (list '< 0 Q) (lambda () (dk-ineq! (list '<= 0 P))))
        (dk-have! (list 'NOT (list '= Q 0)) (lambda () (di) (dk-absurd! (list '= Q 0) (list '< 0 Q))))
        (an-and! (list 'IN Q 'RR) (list 'NOT (list '= Q 0)))
        (fact 'rr-recip-closed Q) (fact 'rr-recip-inverse Q) (fact 'rr-recip-pos Q)
        (let* ((rq (dk-name! (list 'recip Q) 'RR))
               (inv (dk-rewrite-h! (list '= (list '* Q (list 'recip Q)) 1) (list 'recip Q) rq)))
          (dk-rewrite-h! (list '< 0 (list 'recip Q)) (list 'recip Q) rq)
          (an-rr! (list '* m rq)) (fact 'rr-mul-pos m rq)
          (let* ((e (dk-name! (list '* m rq) 'RR)))
            (dk-rewrite-h! (list '< 0 (list '* m rq)) (list '* m rq) e)
            (dk-cite! 'rr-pos-rr-of-lt e)
            (dk-apply! H e)
            (an-rr! (list '* e P))
            ;; e (2 P + 2) = m, so e P = m/2 - e < m
            (dk-have! (list '= (list '* e P) (list '- (list '* 1/2 m) e))
              (lambda ()
                (let* ((lnn-hq (list '= (list '* (list '* m rq) P) (list '- (list '* (list '* 1/2 m) (list '* Q rq)) (list '* m rq)))))
                  (dk-have! lnn-hq (lambda () (crs)))
                  (let* ((h2 (dk-rewrite-h! lnn-hq (list '* Q rq) 1)))
                    (subst (list '= e (list '* m rq)))
                    (subst h2) (crs)))))
            (dk-absurd! (list '<= m (list '* e P)) (list '= (list '* e P) (list '- (list '* 1/2 m) e)) (list '< 0 e) (list '< 0 m))))))))
(qed 'ln-zero-of-small)

;;; (5) psi(z) = Im((z - p) conj d) is affine: at a point of the hull it is the weighted mean, so
;;;     a sign shared by the three vertices is shared by the hull
(sp (make-wff (forall-guarded '(aoa_ aob_ aoc_ lnp0_ lnd_ lns_) '((IN aoa_ CC) (IN aob_ CC) (IN aoc_ CC) (IN lnp0_ CC) (IN lnd_ CC) (IN lns_ RR))
  (list 'IMPLIES (list '<= 0 (list '* 'lns_ (ln-psi 'aoa_ 'lnp0_ 'lnd_)))
  (list 'IMPLIES (list '<= 0 (list '* 'lns_ (ln-psi 'aob_ 'lnp0_ 'lnd_)))
  (list 'IMPLIES (list '<= 0 (list '* 'lns_ (ln-psi 'aoc_ 'lnp0_ 'lnd_)))
    (list 'FORALL 'aoz_ (list 'IMPLIES '(IN aoz_ (CONV3 aoa_ aob_ aoc_)) (list '<= 0 (list '* 'lns_ (ln-psi 'aoz_ 'lnp0_ 'lnd_)))))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (memq (car (dk-goal)) '(IMPLIES FORALL))) (begin (di) (loop))))
(let* ((a 'aoa_) (b 'aob_) (c 'aoc_) (p0 'lnp0_) (d 'lnd_) (sg 'lns_) (z 'aoz_)
       (lmn (ao-conv3-open! (list 'IN z (list 'CONV3 a b c))))
       (wl (car lmn)) (wm (cadr lmn)) (wn (caddr lmn))
       (zeq (an-pick "z = combination" (lambda (x) (and (ao-op? x '= 3) (eq? (cadr x) z)))))
       (sum (an-pick "l + m + n = 1" (lambda (x) (and (ao-op? x '= 3) (equal? (caddr x) 1) (dk-contains? x wl)))))
       (env (map ao-base! (list a b c p0 d)))
       (comb (caddr zeq))
       (psis (map (lambda (v) (ao-cross! (list '- v p0) d env)) (list a b c comb))))
  (dk-have! (list '= wl (list '- 1 (list '+ wm wn)))
    (lambda () (let ((h (list '= wl (list '- (cadr sum) (list '+ wm wn)))))
                 (dk-have! h (lambda () (crs))) (dk-rewrite-h! h (cadr sum) 1) (ass))))
  (subst zeq)
  ;; psi(comb) = l psi(a) + m psi(b) + n psi(c)
  (let* ((pa (ln-psi a p0 d)) (pb (ln-psi b p0 d)) (pc (ln-psi c p0 d)) (pz (ln-psi comb p0 d)))
    (for-each (lambda (v) (an-cc! (list '- v p0)) (an-cc! (list '* (list '- v p0) (list 'conjugate d))) (fact 'imag-part-in-rr (list '* (list '- v p0) (list 'conjugate d))))
              (list a b c comb))
    (fact 'cc-conjugate-closed d)
    (dk-have! (list '= pz (list '+ (list '+ (list '* wl pa) (list '* wm pb)) (list '* wn pc)))
      (lambda ()
        (for-each (lambda (v R) (subst (list '= (ln-psi v p0 d) R))) (list a b c comb) psis)
        (subst (list '= wl (list '- 1 (list '+ wm wn))))
        (crs)))
    (for-each (lambda (pv) (an-rr! (list '* sg pv))) (list pa pb pc pz))
    (let* ((names (map (lambda (pv)
                         (let ((x (dk-name! (list '* sg pv) 'RR)))
                           (dk-rewrite-h! (list '<= 0 (list '* sg pv)) (list '* sg pv) x)
                           x))
                       (list pa pb pc)))
           (sa (car names)) (sb (cadr names)) (sc (caddr names))
           (S (list '+ (list '+ (list '* wl sa) (list '* wm sb)) (list '* wn sc))))
      (dk-have! (list '= (list '* sg pz) S)
        (lambda ()
          (subst (list '= pz (list '+ (list '+ (list '* wl pa) (list '* wm pb)) (list '* wn pc))))
          (subst (list '= sa (list '* sg pa))) (subst (list '= sb (list '* sg pb))) (subst (list '= sc (list '* sg pc)))
          (crs)))
      (let ((qs (map (lambda (w x)
                       (an-and! (list 'IN w 'RR) (list 'IN x 'RR)) (an-and! (list '<= 0 w) (list '<= 0 x))
                       (fact 'rr-leq-mul-nonneg w x)
                       (an-rr! (list '* w x))
                       (let ((q (dk-name! (list '* w x) 'RR)))
                         (dk-rewrite-h! (list '<= 0 (list '* w x)) (list '* w x) q)
                         q))
                     (list wl wm wn) (list sa sb sc))))
        (let ((e2 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (list '= (list '* sg pz) S)
                                                               (list '* wl sa) (car qs)) (list '* wm sb) (cadr qs)) (list '* wn sc) (caddr qs))))
          (dk-ineq! e2 (list '<= 0 (car qs)) (list '<= 0 (cadr qs)) (list '<= 0 (caddr qs))))))))
(qed 'ln-psi-conv)

;;; (6) the shifted half-plane and the shift of psi, in coordinates.  V = i (s d).
(define (ln-V sg d) (list '* '+i (list '* sg d)))
(define (ln-coords-V! sg d env)               ; V as a base, with its coordinates (- s Im d, s Re d)
  (let* ((Ds (list '* sg d)) (V (ln-V sg d)) (DXY (ao-coords! Ds env)))
    (fact 'cc-i-in) (an-cc! V)
    (dk-cite! 'cc-re-i-mul Ds) (dk-cite! 'cc-im-i-mul Ds)
    (let* ((b (ao-base! V)) (vx (cadr b)) (vy (cddr b)))
      (dk-have! (list '= vx (list '- (cdr DXY)))
        (lambda () (subst (list '= vx (list 'real-part V))) (subst (list '= (list 'real-part V) (list '- (list 'imag-part Ds))))
                   (subst (list '= (list 'imag-part Ds) (cdr DXY))) (crs)))
      (dk-have! (list '= vy (car DXY))
        (lambda () (subst (list '= vy (list 'imag-part V))) (subst (list '= (list 'imag-part V) (list 'real-part Ds)))
                   (subst (list '= (list 'real-part Ds) (car DXY))) (crs)))
      b)))
(sp (make-wff (forall-guarded '(aow_ lnp0_ lnd_ lns_ lneta_) '((IN aow_ CC) (IN lnp0_ CC) (IN lnd_ CC) (IN lns_ RR) (IN lneta_ RR))
  (list 'AND
    (list '= (list 'real-part (list '* (list 'conjugate (ln-V 'lns_ 'lnd_)) (list '- 'aow_ (list '- 'lnp0_ (list '* (list '* 1/2 'lneta_) (ln-V 'lns_ 'lnd_))))))
             (list '+ (list '* 'lns_ (ln-psi 'aow_ 'lnp0_ 'lnd_)) (list '* (list '* 1/2 'lneta_) (list '* (list '* 'lns_ 'lns_) '(* (magnitude lnd_) (magnitude lnd_))))))
    (list '= (ln-psi (list '+ 'aow_ (list '* 'lneta_ (ln-V 'lns_ 'lnd_))) 'lnp0_ 'lnd_)
             (list '+ (ln-psi 'aow_ 'lnp0_ 'lnd_) (list '* 'lneta_ (list '* 'lns_ '(* (magnitude lnd_) (magnitude lnd_))))))))))
(dk-peel!)
(let* ((w 'aow_) (p0 'lnp0_) (d 'lnd_) (sg 'lns_) (eta 'lneta_)
       (env0 (map ao-base! (list w p0 d)))
       (bV (ln-coords-V! sg d env0))
       (V (car bV))
       (env (cons bV env0))
       (DD (cdr (assoc d env)))
       (msq (dk-cite! 'cc-magnitude-sq d)))
  (fact 'real-part-in-rr d) (fact 'imag-part-in-rr d)
  (let* ((Z (list '- w (list '- p0 (list '* (list '* 1/2 eta) V))))
         (ZXY (ao-coords! Z env))
         (dot (dk-cite! 'cc-dot-coords V Z))
         (R1 (ao-cross! (list '- w p0) d env))
         (W2 (list '+ w (list '* eta V)))
         (R2 (ao-cross! (list '- W2 p0) d env)))
    (define (fin!)
      (if (dk-contains? (dk-goal) '(* (magnitude lnd_) (magnitude lnd_))) (subst msq))
      (for-each (lambda (pr) (if (dk-contains? (dk-goal) (car pr)) (subst (list '= (car pr) (cdr pr)))))
                (list (cons (list 'real-part d) (car DD)) (cons (list 'imag-part d) (cdr DD))
                      (cons (cadr bV) (list '- (list '* sg (cdr DD)))) (cons (cddr bV) (list '* sg (car DD)))))
      (crs))
    (dk-conj-close!
      (lambda ()
        (let ((lhs (cadr (dk-goal))))
          (if (dk-head-is? lhs 'real-part)
              (begin (subst dot)
                     (subst (list '= (list 'real-part V) (cadr bV))) (subst (list '= (list 'imag-part V) (cddr bV)))
                     (subst (list '= (list 'real-part Z) (car ZXY))) (subst (list '= (list 'imag-part Z) (cdr ZXY)))
                     (subst (list '= (ln-psi w p0 d) R1))
                     (fin!))
              (begin (subst (list '= (ln-psi W2 p0 d) R2))
                     (subst (list '= (ln-psi w p0 d) R1))
                     (fin!))))))))
(qed 'ln-shift-identities)

;;; ---------------------------------------------------------------------------
;;; (7) A TRIANGLE ON ONE CLOSED SIDE OF THE LINE.  f continuous on U, holomorphic off the line,
;;;     the triangle inside Bb(c0, r) with the closed ball Bb(c0, 2 r) in U, and s psi >= 0 at the
;;;     three vertices (s = 1 or -1).  Then the triangle integral is 0.
;;;     Proof: for e > 0 shift by h = eta i (s d), |h| small: g(w) = f(w + h) is holomorphic near the
;;;     hull (the shifted hull misses the line), so TRI-INT(g) = 0 (Goursat), and |f - g| <= e on the
;;;     hull (uniform continuity), so |TRI-INT(f)| <= e P.
(define (ln-ball c r) (list 'BALL 'CC-MS c r))
(define ln-V0 '(DIFFERENCE u (CC-LINE lnp0_ lnd_)))
(define (ln-ball-in! z c r)                   ; z in BALL(c, r) in context: z in CC, |z - c| < r
  (let ((bi (dk-cite! 'cc-ms-ball-membership c r z)))
    (dk-have! (list 'AND (list 'IN z 'CC) (list '< (list 'magnitude (list '- z c)) r))
      (lambda () (ai bi) (detach! (list 'IMPLIES (cadr bi) (caddr bi))) (dk-ass!)))
    (dk-split-all! (list (list 'AND (list 'IN z 'CC) (list '< (list 'magnitude (list '- z c)) r))))
    (an-cc! (list '- z c)) (fact 'cc-magnitude-closed (list '- z c))))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ln-nfm 'u) (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN u CC)) (list 'IMPLIES (ln-cont 'u 'f)
  (list 'FORALL 'lnp0_ (list 'IMPLIES '(IN lnp0_ CC) (list 'FORALL 'lnd_ (list 'IMPLIES '(IN lnd_ CC) (list 'IMPLIES '(NOT (= lnd_ 0))
  (list 'IMPLIES (list 'HOLOMORPHIC-ON ln-V0 (list 'RESTRICT 'f ln-V0))
  (list 'FORALL 'lnc_ (list 'IMPLIES '(IN lnc_ CC) (list 'FORALL 'lnr_ (list 'IMPLIES '(IN lnr_ RR) (list 'IMPLIES '(< 0 lnr_)
  (list 'IMPLIES '(SUBSET (CLOSED-BALL CC-MS lnc_ (* 2 lnr_)) u)
  (list 'FORALL 'lns_ (list 'IMPLIES '(IN lns_ RR) (list 'IMPLIES '(= (* lns_ lns_) 1) (list 'IMPLIES '(= (magnitude lns_) 1)
  (list 'FORALL 'aoa_ (list 'IMPLIES (list 'IN 'aoa_ (ln-ball 'lnc_ 'lnr_)) (list 'FORALL 'aob_ (list 'IMPLIES (list 'IN 'aob_ (ln-ball 'lnc_ 'lnr_))
  (list 'FORALL 'aoc_ (list 'IMPLIES (list 'IN 'aoc_ (ln-ball 'lnc_ 'lnr_))
  (list 'IMPLIES (list '<= 0 (list '* 'lns_ (ln-psi 'aoa_ 'lnp0_ 'lnd_)))
  (list 'IMPLIES (list '<= 0 (list '* 'lns_ (ln-psi 'aob_ 'lnp0_ 'lnd_)))
  (list 'IMPLIES (list '<= 0 (list '* 'lns_ (ln-psi 'aoc_ 'lnp0_ 'lnd_)))
    '(= (TRI-INT f aoa_ aob_ aoc_) 0)))))))))))))))))))))))))))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (memq (car (dk-goal)) '(IMPLIES FORALL))) (begin (di) (loop))))
(let* ((u 'u) (f 'f) (p0 'lnp0_) (d 'lnd_) (c0 'lnc_) (r 'lnr_) (sg 'lns_) (a 'aoa_) (b 'aob_) (c 'aoc_)
       (Bb (ln-ball c0 r)) (r2 (list '* 2 r)) (CB2 (list 'CLOSED-BALL 'CC-MS c0 r2))
       (Vl ln-V0) (T3 (list 'CONV3 a b c)) (TI (list 'TRI-INT f a b c))
       (P (list '+ (list '+ (list 'magnitude (list '- b a)) (list 'magnitude (list '- c b))) (list 'magnitude (list '- a c)))))
  (fact 'cc-is-metric-space) (fact 'nf-cc-is-metric-space)
  (fact 'cc-open-subset-cc u)
  (an-rr! r2)
  (for-each (lambda (v) (ln-ball-in! v c0 r)) (list a b c))
  (dk-cite! 'cc-ball-is-convex c0 r)
  (dk-fact! 'conv3-in-convex Bb a b c)
  ;; Bb inside the closed ball of radius 2r, hence in U
  (dk-have! (list 'SUBSET Bb CB2)
    (lambda () (let ((z (subset-by-element!)))
                 (ln-ball-in! z c0 r)
                 (dk-have! (list '<= (list 'magnitude (list '- z c0)) r2) (lambda () (dk-ineq! (list '< (list 'magnitude (list '- z c0)) r) (list '< 0 r))))
                 (dk-fact! 'cc-closed-ball-mem-intro c0 r2 z) (dk-ass!))))
  (fact 'subset-trans Bb CB2 u) (fact 'subset-trans T3 Bb u)
  (dk-split-all! (list (dk-cite! 'conv3-vertices-in a b c)))
  (fact 'tri-int-in-cc u f a b c)
  (dk-cite! 'ln-psi-conv a b c p0 d sg)
    (for-each (lambda (pq) (an-cc! (list '- (car pq) (cadr pq))) (fact 'cc-magnitude-closed (list '- (car pq) (cadr pq))) (fact 'cc-magnitude-nonneg (list '- (car pq) (cadr pq))))
            (list (list b a) (list c b) (list a c)))
  (an-rr! P)
  (dk-have! (list '<= 0 P) (lambda () (dk-ineq! (list '<= 0 (list 'magnitude (list '- b a))) (list '<= 0 (list 'magnitude (list '- c b))) (list '<= 0 (list 'magnitude (list '- a c))))))
  (let* ((Pn (dk-name! P 'RR)))
    (dk-rewrite-h! (list '<= 0 P) P Pn)
    (detach-with! (dk-cite! 'ln-zero-of-small TI Pn)
      (lambda ()
        (let* ((e (cadr (find-first (lambda (x) (dk-head-is? x 'POS-RR)) (dk-landed (lambda () (di) (if (eq? (car (dk-goal)) 'IMPLIES) (di))))))))
          (fact 'rr-pos-rr-in-rr e) (fact 'rr-lt-of-pos-rr e)
          (dk-have! (list '< 0 r2) (lambda () (dk-ineq! (list '< 0 r))))
          (let* ((ucx (dk-apply! (dk-cite! 'cc-uniform-continuity-ball u f c0 r2) e))
                 (dl (dk-skolem! ucx #t))
                 (ucf (an-pick "uniform continuity" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x dl))))))
            (fact 'rr-pos-rr-in-rr dl) (fact 'rr-lt-of-pos-rr dl)
            ;; m <= min(delta, r), m > 0
            (let* ((mex (list 'FORSOME 'lnm_ (list 'AND '(IN lnm_ RR) (list 'AND '(< 0 lnm_) (list 'AND (list '<= 'lnm_ dl) (list '<= 'lnm_ r)))))))
              (dk-have! mex
                (lambda () (fact 'rr-le-total dl r)
                           (use-cases (list (list '<= dl r) (list '<= r dl))
                             (lambda () (ew dl) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '<= dl r) (list '< 0 dl))))))
                             (lambda () (ew r) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '<= r dl) (list '< 0 r)))))))))
              (let* ((m (dk-skolem! mex #t)))
                (dk-split-all!)
                ;; eta = m rho, rho = recip(2 (|d| + 1));  |h| = eta |d| = m/2 - eta < m
                (let* ((md (list 'magnitude d)) (Qd (list '* 2 (list '+ md 1))))
                  (fact 'cc-magnitude-closed d) (fact 'cc-magnitude-nonneg d) (an-rr! Qd)
                  (dk-have! (list '< 0 Qd) (lambda () (dk-ineq! (list '<= 0 md))))
                  (dk-have! (list 'NOT (list '= Qd 0)) (lambda () (di) (dk-absurd! (list '= Qd 0) (list '< 0 Qd))))
                  (an-and! (list 'IN Qd 'RR) (list 'NOT (list '= Qd 0)))
                  (fact 'rr-recip-closed Qd) (fact 'rr-recip-inverse Qd) (fact 'rr-recip-pos Qd)
                  (let* ((rho (dk-name! (list 'recip Qd) 'RR))
                         (inv (dk-rewrite-h! (list '= (list '* Qd (list 'recip Qd)) 1) (list 'recip Qd) rho)))
                    (dk-rewrite-h! (list '< 0 (list 'recip Qd)) (list 'recip Qd) rho)
                    (an-rr! (list '* m rho)) (fact 'rr-mul-pos m rho)
                    (let* ((eta (dk-name! (list '* m rho) 'RR)))
                      (dk-rewrite-h! (list '< 0 (list '* m rho)) (list '* m rho) eta)
                      (dk-have! (list '= (list '* eta md) (list '- (list '* 1/2 m) eta))
                        (lambda ()
                          (let* ((hh (list '= (list '* (list '* m rho) md) (list '- (list '* (list '* 1/2 m) (list '* Qd rho)) (list '* m rho)))))
                            (dk-have! hh (lambda () (crs)))
                            (let ((h2 (dk-rewrite-h! hh (list '* Qd rho) 1)))
                              (subst (list '= eta (list '* m rho)))
                              (subst h2) (crs)))))
                      (let* ((V (ln-V sg d)) (h (list '* eta V)) (u0 (list '- p0 (list '* (list '* 1/2 eta) V)))
                             (cV (list 'conjugate V)) (Hp (aw-H cV u0)) (Wst (list 'INTERSECTION Bb Hp)))
                        (fact 'cc-i-in) (fact 'rr-subset-cc sg) (fact 'rr-subset-cc eta)
                        (an-cc! (list '* sg d)) (an-cc! V) (fact 'cc-conjugate-closed V) (an-cc! h) (an-cc! u0)
                        ;; |h| < m
                        (an-and! (list 'IN eta 'CC) (list 'IN V 'CC)) (fact 'cc-magnitude-mul eta V)
                        (an-and! '(IN +i CC) (list 'IN (list '* sg d) 'CC)) (fact 'cc-magnitude-mul '+i (list '* sg d))
                        (an-and! (list 'IN sg 'CC) (list 'IN d 'CC)) (fact 'cc-magnitude-mul sg d)
                        (fact 'cc-magnitude-i) (fact 'rr-magnitude-is-abs eta)
                        (dk-have! (list '<= 0 eta) (lambda () (dk-ineq! (list '< 0 eta))))
                        (fact 'rr-abs-of-nonneg eta)
                        (an-rr! (list 'magnitude h))
                        (dk-have! (list '= (list 'magnitude h) (list '* eta md))
                          (lambda ()
                            (subst (list '= (list 'magnitude h) (list '* (list 'magnitude eta) (list 'magnitude V))))
                            (subst (list '= (list 'magnitude V) (list '* '(magnitude +i) (list 'magnitude (list '* sg d)))))
                            (subst (list '= (list 'magnitude (list '* sg d)) (list '* (list 'magnitude sg) md)))
                            (subst (list '= (list 'magnitude eta) (list 'abs eta))) (subst (list '= (list 'abs eta) eta))
                            (subst '(= (magnitude +i) 1)) (subst (list '= (list 'magnitude sg) 1))
                            (crs)))
                        (an-rr! (list '* eta md))
                        (let* ((emd (dk-name! (list '* eta md) 'RR))
                               (q1 (dk-rewrite-h! (list '= (list 'magnitude h) (list '* eta md)) (list '* eta md) emd))
                               (q2 (dk-rewrite-h! (list '= (list '* eta md) (list '- (list '* 1/2 m) eta)) (list '* eta md) emd)))
                          (dk-have! (list '< (list 'magnitude h) m)
                            (lambda () (dk-ineq! q1 q2 (list '< 0 eta) (list '< 0 m)))))
                        ;; the sets: Wst = B(c0, r) intersect {Re(conj V (w - u0)) > 0}, open, inside U
                        (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
                        (dk-have! (list 'IN c0 '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
                        (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
                        (dk-have! (list 'NOT (list '= 0 r)) (lambda () (di) (dk-absurd! (list '= 0 r) (list '< 0 r))))
                        (dk-have! (list 'AND (list 'IN r 'RR) (list 'AND (list '<= 0 r) (list 'NOT (list '= 0 r)))) (lambda () (dk-conj-close! (lambda () (ass)))))
                        (dk-apply! (dk-cite! 'ball-is-open 'CC-MS) c0 r)
                        (let ((oi (dk-cite! 'cc-ms-open-iff Bb)))
                          (dk-have! (list 'IS-OPEN ln-nfm Bb) (lambda () (if (dk-only! oi (list 'IS-OPEN 'CC-MS Bb)) (prop)))))
                        (dk-cite! 'cc-half-plane-open cV u0)
                        (an-and! (list 'IS-OPEN ln-nfm Bb) (list 'IS-OPEN ln-nfm Hp))
                        (dk-apply! (dk-cite! 'inter-of-opens-open ln-nfm) Bb Hp)
                        (define (in-W! z)                 ; z in Wst in context: z in B, z in H
                          (let ((bi (dk-cite! 'intersection-membership Bb Hp z)))
                            (dk-have! (list 'AND (list 'IN z Bb) (list 'IN z Hp))
                              (lambda () (ai bi) (detach! (list 'IMPLIES (cadr bi) (caddr bi))) (dk-ass!)))
                            (dk-split-all! (list (list 'AND (list 'IN z Bb) (list 'IN z Hp))))))
                        (dk-have! (list 'SUBSET Wst Bb) (lambda () (let ((z (subset-by-element!))) (in-W! z) (dk-ass!))))
                        (fact 'subset-trans Wst Bb u) (fact 'subset-trans Wst u 'CC)
                        ;; |d|^2 > 0
                        (let ((iff (dk-cite! 'cc-magnitude-zero-iff d)))
                          (dk-have! (list 'NOT (list '= md 0))
                            (lambda () (di) (ai iff) (detach! (list 'IMPLIES (list '= md 0) (list '= d 0))) (ai (list 'NOT (list '= d 0))))))
                        (an-lt-of-le-ne! 0 md)
                        (let* ((dsq (list '* md md)))
                          (an-rr! dsq) (fact 'rr-mul-pos md md)
                          (an-rr! (list '* eta dsq)) (fact 'rr-mul-pos eta dsq)
                          (define (ids! wq)                ; the shift identities at w, with s s = 1; returns (Re-eq . psi-eq)
                            (let* ((two (dk-cite! 'ln-shift-identities wq p0 d sg eta))
                                   (e1 (cadr two)) (e2 (caddr two)))
                              (dk-split-all! (list two))
                              (let* ((e1b (dk-rewrite-h! e1 (list '* sg sg) 1)))
                                (cons e1b e2))))
                          (define (psi-typ! wq)
                            (an-cc! (list '- wq p0)) (fact 'cc-conjugate-closed d)
                            (an-cc! (list '* (list '- wq p0) (list 'conjugate d))) (fact 'imag-part-in-rr (list '* (list '- wq p0) (list 'conjugate d)))
                            (an-rr! (list '* sg (ln-psi wq p0 d))))
                          ;; the hull lies in Wst
                          (dk-have! (list 'SUBSET T3 Wst)
                            (lambda ()
                              (let* ((z (subset-by-element!)))
                                (dk-fact! 'subset-mem-fwd T3 Bb z)
                                (ln-ball-in! z c0 r)
                                (dk-apply! (an-pick "the hull sign" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x 'CONV3) (dk-contains? x sg)))) z)
                                (psi-typ! z)
                                (let* ((pr (ids! z)) (X (list '* cV (list '- z u0))))
                                  (an-cc! X) (fact 'real-part-in-rr X)
                                  (an-rr! (list '* (list '* 1/2 eta) (list '* 1 dsq)))
                                  (dk-have! (list '= (list '* (list '* 1/2 eta) (list '* 1 dsq)) (list '* 1/2 (list '* eta dsq))) (lambda () (crs)))
                                  (dk-have! (list '< 0 (list 'real-part X))
                                    (lambda () (dk-ineq! (car pr) (list '<= 0 (list '* sg (ln-psi z p0 d)))
                                                         (list '= (list '* (list '* 1/2 eta) (list '* 1 dsq)) (list '* 1/2 (list '* eta dsq)))
                                                         (list '< 0 (list '* eta dsq)))))
                                  (dk-have! (list 'IN z Hp) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
                                  (mac 'intersection-membership) (dk-conj-close! (lambda () (dk-ass!)))))))
                          (for-each (lambda (vx) (dk-fact! 'subset-mem-fwd T3 Wst vx)) (list a b c))
                          ;; f restricted to the punctured set, as a symbol
                          (dk-have! (list 'SUBSET Vl u)
                            (lambda () (let* ((z (subset-by-element!)) (bi (dk-cite! 'difference-membership u (list 'CC-LINE p0 d) z)))
                                         (ai bi) (detach! (list 'IMPLIES (cadr bi) (caddr bi))) (dk-split-all!) (dk-ass!))))
                          (fact 'restrict-in-fun f u 'CC Vl)
                          (let* ((fv (dk-name! (list 'RESTRICT f Vl) (list 'FUN Vl 'CC))))
                            (dk-rewrite-h! (list 'HOLOMORPHIC-ON Vl (list 'RESTRICT f Vl)) (list 'RESTRICT f Vl) fv)
                            ;; for y in Wst, y + h is in U and off the line
                            (dk-have! (list 'FORALL 'lnty_ (list 'IMPLIES (list 'IN 'lnty_ Wst) (list 'IN (list '+ 'lnty_ h) Vl)))
                              (lambda ()
                                (let* ((y (dk-di-var!)) (yh (list '+ y h)))
                                  (in-W! y)
                                  (ln-ball-in! y c0 r)
                                  (an-cc! yh) (an-cc! (list '- yh c0))
                                  (an-and! (list 'IN (list '- y c0) 'CC) (list 'IN h 'CC))
                                  (fact 'cc-magnitude-triangle (list '- y c0) h)
                                  (an-cc! (list '+ (list '- y c0) h)) (fact 'cc-magnitude-closed (list '+ (list '- y c0) h))
                                  (dk-have! (list '= (list '- yh c0) (list '+ (list '- y c0) h)) (lambda () (crs)))
                                  (fact 'cc-magnitude-closed (list '- yh c0))
                                  (dk-have! (list '<= (list 'magnitude (list '- yh c0)) r2)
                                    (lambda () (subst (list '= (list '- yh c0) (list '+ (list '- y c0) h)))
                                               (dk-ineq! (list '<= (list 'magnitude (list '+ (list '- y c0) h)) (list '+ (list 'magnitude (list '- y c0)) (list 'magnitude h)))
                                                         (list '< (list 'magnitude (list '- y c0)) r) (list '< (list 'magnitude h) m) (list '<= m r))))
                                  (dk-fact! 'cc-closed-ball-mem-intro c0 r2 yh)
                                  (dk-fact! 'subset-mem-fwd CB2 u yh)
                                  ;; off the line
                                  (psi-typ! y) (psi-typ! yh)
                                  (let* ((pr (ids! y)) (X (list '* cV (list '- y u0)))
                                         (py (ln-psi y p0 d)) (pyh (ln-psi yh p0 d)))
                                    (an-cc! X) (fact 'real-part-in-rr X)
                                    (dk-project! (list '< 0 (list 'real-part X)) (lambda () (sep-me (dk-ctx-form (list 'IN y Hp)))))
                                    (dk-have! (list 'NOT (list 'IN yh (list 'CC-LINE p0 d)))
                                      (lambda ()
                                        (di)
                                        (mac-h 'cc-line-unfold (list 'IN yh (list 'CC-LINE p0 d)))
                                        (dk-split-all! (dk-landed (lambda () (sep-me (dk-pick (lambda (xx) (and (dk-head-is? xx 'IN) (equal? (cadr xx) yh) (dk-head-is? (caddr xx) 'SEP))) "sep")))))
                                        (an-rr! (list '* sg pyh))
                                        (dk-have! (list '= (list '* sg pyh) (list '+ (list '* sg py) (list '* eta (list '* (list '* sg sg) dsq))))
                                          (lambda () (subst (cdr pr)) (crs)))
                                        (let* ((k1 (dk-rewrite-h! (list '= (list '* sg pyh) (list '+ (list '* sg py) (list '* eta (list '* (list '* sg sg) dsq))))
                                                                  (list '* sg sg) 1)))
                                          (dk-have! (list '= (list '* sg pyh) 0) (lambda () (subst (list '= pyh 0)) (crs)))
                                          (an-rr! (list '* eta (list '* 1 dsq)))
                                          (dk-have! (list '= (list '* eta (list '* 1 dsq)) (list '* eta dsq)) (lambda () (crs)))
                                          (an-rr! (list '* (list '* 1/2 eta) (list '* 1 dsq)))
                                          (dk-have! (list '= (list '* (list '* 1/2 eta) (list '* 1 dsq)) (list '* 1/2 (list '* eta dsq))) (lambda () (crs)))
                                          (dk-absurd! k1 (list '= (list '* sg pyh) 0) (car pr) (list '< 0 (list 'real-part X))
                                                      (list '= (list '* eta (list '* 1 dsq)) (list '* eta dsq))
                                                      (list '= (list '* (list '* 1/2 eta) (list '* 1 dsq)) (list '* 1/2 (list '* eta dsq)))
                                                      (list '< 0 (list '* eta dsq)))))))
                                    (mac 'difference-membership) (dk-conj-close! (lambda () (dk-ass!))))))
                            (let* ((g (list 'VNB-LAMBDA 'lnt_ Wst (list fv (list '+ 'lnt_ h))))
                                   (F1 (list 'RESTRICT f Wst))
                                   (Dfn (list 'VNB-LAMBDA 'cfz_ Wst (list '- (list F1 'cfz_) (list g 'cfz_))))
                                   (CF (list 'CC-CONT-FNS Wst)))
                              (dk-have! (list 'HOLOMORPHIC-ON Wst g) (lambda () (dk-holomorphic! Wst g)))
                              (fact 'holomorphic-on-in-fun Wst g) (fact 'holomorphic-on-continuous Wst g)
                              (let ((gz (dk-cite! 'goursat-triangle Wst g a b c)))
                                (fact 'restrict-in-fun f u 'CC Wst)
                                (dk-apply! (dk-cite! 'ln-restrict-continuous u f) Wst)
                                (for-each (lambda (k)
                                            (dk-have! (list 'IN k CF)
                                              (lambda () (mac 'cc-cont-fns-membership) (dk-conj-close! (lambda () (dk-ass!))))))
                                          (list F1 g))
                                (dk-apply! (dk-cite! 'cc-cont-fns-diff Wst) F1 g)
                                (let ((mb (dk-cite! 'cc-cont-fns-membership Wst Dfn)))
                                  (dk-have! (caddr mb) (lambda () (ai mb) (detach! (list 'IMPLIES (cadr mb) (caddr mb))) (dk-ass!)))
                                  (dk-split-all! (list (caddr mb))))
                                ;; F1 = g + D on W
                                (dk-have! (list 'FORALL 'lntz_ (list 'IMPLIES (list 'IN 'lntz_ Wst) (list '== (list F1 'lntz_) (list '+ (list g 'lntz_) (list Dfn 'lntz_)))))
                                  (lambda ()
                                    (let* ((z (dk-di-var!)))
                                      (dk-apply! (list 'FORALL 'lnty_ (list 'IMPLIES (list 'IN 'lnty_ Wst) (list 'IN (list '+ 'lnty_ h) Vl))) z)
                                      (fact 'fun-apply-type-c F1 Wst 'CC z) (fact 'fun-apply-type-c g Wst 'CC z)
                                      (dk-lam-b!)
                                      (let* ((gl (dk-goal)) (lhs (cadr gl)) (rhs (caddr gl)))
                                        (fact 'fun-apply-type-c fv Vl 'CC (list '+ z h))
                                        (let* ((x1 (dk-name! (list F1 z) 'CC)) (x2 (dk-name! (list fv (list '+ z h)) 'CC)))
                                          (subst (list '= (list F1 z) x1)) (subst (list '= (list fv (list '+ z h)) x2))
                                          (let ((g2 (dk-goal)))
                                            (dk-have! (list '= (caddr g2) (cadr g2)) (lambda () (crs)))
                                            (subst (list '= (caddr g2) (cadr g2)))
                                            (if (not (proof-done? *ps*)) (qrfl))))))))
                                (let* ((ts (dk-apply! (dk-cite! 'tri-int-sum Wst g Dfn) F1 a b c))
                                       (tr (dk-cite! 'tri-int-restrict u f Wst a b c))
                                       (bnd (dk-have! (list 'FORALL 'lntw_ (list 'IMPLIES (list 'IN 'lntw_ T3) (list '<= (list 'magnitude (list Dfn 'lntw_)) e)))
                                              (lambda ()
                                                (let* ((z (dk-di-var!)) (zh (list '+ z h)))
                                                  (dk-fact! 'subset-mem-fwd T3 Wst z)
                                                  (dk-apply! (list 'FORALL 'lnty_ (list 'IMPLIES (list 'IN 'lnty_ Wst) (list 'IN (list '+ 'lnty_ h) Vl))) z)
                                                  (dk-fact! 'subset-mem-fwd T3 Bb z) (dk-fact! 'subset-mem-fwd Bb CB2 z)
                                                  (ln-ball-in! z c0 r)
                                                  (dk-lam-b!)
                                                  (subst (dk-cite! 'restrict-apply f Wst z))
                                                  (subst (list '= fv (list 'RESTRICT f Vl)))
                                                  (subst (dk-cite! 'restrict-apply f Vl zh))
                                                  ;; z + h in the closed ball of radius 2r
                                                  (an-cc! zh) (an-cc! (list '- zh c0))
                                                  (an-and! (list 'IN (list '- z c0) 'CC) (list 'IN h 'CC))
                                                  (fact 'cc-magnitude-triangle (list '- z c0) h)
                                                  (an-cc! (list '+ (list '- z c0) h)) (fact 'cc-magnitude-closed (list '+ (list '- z c0) h))
                                                  (dk-have! (list '= (list '- zh c0) (list '+ (list '- z c0) h)) (lambda () (crs)))
                                                  (fact 'cc-magnitude-closed (list '- zh c0))
                                                  (dk-have! (list '<= (list 'magnitude (list '- zh c0)) r2)
                                                    (lambda () (subst (list '= (list '- zh c0) (list '+ (list '- z c0) h)))
                                                               (dk-ineq! (list '<= (list 'magnitude (list '+ (list '- z c0) h)) (list '+ (list 'magnitude (list '- z c0)) (list 'magnitude h)))
                                                                         (list '< (list 'magnitude (list '- z c0)) r) (list '< (list 'magnitude h) m) (list '<= m r))))
                                                  (dk-fact! 'cc-closed-ball-mem-intro c0 r2 zh)
                                                  ;; |z - (z + h)| = |h| < delta
                                                  (an-cc! (list '- z zh)) (fact 'cc-magnitude-closed (list '- z zh))
                                                  (dk-have! (list '= (list '- z zh) (list '- h)) (lambda () (crs)))
                                                  (fact 'cc-magnitude-neg h)
                                                  (dk-have! (list '< (list 'magnitude (list '- z zh)) dl)
                                                    (lambda () (subst (list '= (list '- z zh) (list '- h))) (subst (list '= (list 'magnitude (list '- h)) (list 'magnitude h)))
                                                               (dk-ineq! (list '< (list 'magnitude h) m) (list '<= m dl))))
                                                  (dk-apply! ucf z zh)
                                                  (dk-ass!)))))
                                       (ab (dk-cite! 'tri-int-abs-bound Wst Dfn a b c e)))
                                  ;; TI = TRI(F1) = TRI(g) + TRI(D) = TRI(D)
                                  (fact 'tri-int-in-cc Wst Dfn a b c)
                                  (let* ((TD (list 'TRI-INT Dfn a b c))
                                         (ab2 (dk-rewrite-h! ab P Pn)))
                                    (fact 'cc-magnitude-closed TD) (an-rr! (list '* Pn e)) (an-rr! (list '* e Pn))
                                    (dk-have! (list '= TI TD)
                                      (lambda () (subst (list '= TI (list 'TRI-INT F1 a b c))) (subst ts) (subst gz) (crs)))
                                    (subst (list '= TI TD))
                                    (dk-have! (list '= (list '* Pn e) (list '* e Pn)) (lambda () (crs)))
                                    (dk-ineq! ab2 (list '= (list '* Pn e) (list '* e Pn)))))))))
                        #t))))))))))
    (if (not (proof-done? *ps*)) (dk-ass!))))
(qed 'tri-int-half-plane)

;;; ---------------------------------------------------------------------------
;;; (8) psi along a segment, and the point where a segment crosses the line
(sp (make-wff (forall-guarded '(aop_ aoq_ lnp0_ lnd_ lnt_) '((IN aop_ CC) (IN aoq_ CC) (IN lnp0_ CC) (IN lnd_ CC) (IN lnt_ RR))
  (list '= (ln-psi '(+ aop_ (* lnt_ (- aoq_ aop_))) 'lnp0_ 'lnd_)
           (list '+ (ln-psi 'aop_ 'lnp0_ 'lnd_) (list '* 'lnt_ (list '- (ln-psi 'aoq_ 'lnp0_ 'lnd_) (ln-psi 'aop_ 'lnp0_ 'lnd_))))))))
(dk-peel!)
(let* ((p 'aop_) (q 'aoq_) (p0 'lnp0_) (d 'lnd_) (t 'lnt_)
       (env (map ao-base! (list p q p0 d)))
       (Rs (map (lambda (z) (ao-cross! (list '- z p0) d env)) (list (list '+ p (list '* t (list '- q p))) p q))))
  (for-each (lambda (z R) (subst (list '= (ln-psi z p0 d) R))) (list (list '+ p (list '* t (list '- q p))) p q) Rs)
  (crs))
(qed 'ln-psi-seg)

(define (ln-psi-typ! w p0 d)
  (an-cc! (list '- w p0)) (fact 'cc-conjugate-closed d)
  (an-cc! (list '* (list '- w p0) (list 'conjugate d))) (fact 'imag-part-in-rr (list '* (list '- w p0) (list 'conjugate d))))
(sp (make-wff (forall-guarded '(aop_ aoq_ lnp0_ lnd_ lns_) '((IN aop_ CC) (IN aoq_ CC) (IN lnp0_ CC) (IN lnd_ CC) (IN lns_ RR))
  (list 'IMPLIES '(= (* lns_ lns_) 1)
  (list 'IMPLIES (list '< 0 (list '* 'lns_ (ln-psi 'aop_ 'lnp0_ 'lnd_)))
  (list 'IMPLIES (list '< (list '* 'lns_ (ln-psi 'aoq_ 'lnp0_ 'lnd_)) 0)
    (list 'FORSOME 'lny_ (list 'AND '(IN lny_ (TRACE (SEG-PATH aop_ aoq_) 0 1)) (list '= (ln-psi 'lny_ 'lnp0_ 'lnd_) 0)))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (eq? (car (dk-goal)) 'IMPLIES)) (begin (di) (loop))))
(let* ((p 'aop_) (q 'aoq_) (p0 'lnp0_) (d 'lnd_) (sg 'lns_)
       (pp (ln-psi p p0 d)) (pq (ln-psi q p0 d)) (A (list '* sg pp)) (Bq (list '* sg pq)))
  (ln-psi-typ! p p0 d) (ln-psi-typ! q p0 d) (an-rr! A) (an-rr! Bq)
  (let* ((An (dk-name! A 'RR)) (Bn (dk-name! Bq 'RR)))
    (dk-rewrite-h! (list '< 0 A) A An) (dk-rewrite-h! (list '< Bq 0) Bq Bn)
    (let* ((Dn (list '- An Bn)))
      (an-rr! Dn)
      (dk-have! (list '< 0 Dn) (lambda () (dk-ineq! (list '< 0 An) (list '< Bn 0))))
      (dk-have! (list 'NOT (list '= Dn 0)) (lambda () (di) (dk-absurd! (list '= Dn 0) (list '< 0 Dn))))
      (an-and! (list 'IN Dn 'RR) (list 'NOT (list '= Dn 0)))
      (fact 'rr-recip-closed Dn) (fact 'rr-recip-inverse Dn) (fact 'rr-recip-pos Dn)
      (let* ((rD (dk-name! (list 'recip Dn) 'RR))
             (inv (dk-rewrite-h! (list '= (list '* Dn (list 'recip Dn)) 1) (list 'recip Dn) rD)))
        (dk-rewrite-h! (list '< 0 (list 'recip Dn)) (list 'recip Dn) rD)
        (an-rr! (list '* An rD)) (fact 'rr-mul-pos An rD)
        (let* ((t (dk-name! (list '* An rD) 'RR)))
          (dk-rewrite-h! (list '< 0 (list '* An rD)) (list '* An rD) t)
          ;; t D = A, so t <= 1 and sigma psi(y) = A - t D = 0
          (dk-have! (list '= (list '* t Dn) An)
            (lambda () (subst (list '= t (list '* An rD)))
                       (dk-have! (list '= (list '* (list '* An rD) Dn) (list '* An (list '* Dn rD))) (lambda () (crs)))
                       (subst (list '= (list '* (list '* An rD) Dn) (list '* An (list '* Dn rD)))) (subst inv) (crs)))
          (an-rr! (list '* t Dn))
          (let* ((tDn (dk-name! (list '* t Dn) 'RR)))
            (dk-rewrite-h! (list '= (list '* t Dn) An) (list '* t Dn) tDn)
            ;; t <= 1: (1 - t) D = D - A = -B >= 0 with D > 0
            (dk-have! (list '<= t 1)
              (lambda ()
                (use-em (list '<= t 1) (lambda () (ass))
                  (lambda ()
                    (dk-fact! 'rr-not-le-lt t 1)
                    (an-rr! (list '- t 1))
                    (dk-have! (list '< 0 (list '- t 1)) (lambda () (dk-ineq! (list '< 1 t))))
                    (fact 'rr-mul-pos (list '- t 1) Dn)
                    (an-rr! (list '* (list '- t 1) Dn))
                    (dk-have! (list '= (list '* (list '- t 1) Dn) (list '- tDn Dn))
                      (lambda () (subst (list '= tDn (list '* t Dn))) (crs)))
                    (dk-absurd! (list '< 0 (list '* (list '- t 1) Dn)) (list '= (list '* (list '- t 1) Dn) (list '- tDn Dn))
                                (list '= tDn An) (list '< Bn 0))))))
            (dk-have! (list 'IN t '(CCINT 0 1))
              (lambda () (mac 'ccint-membership) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 0 t)))))))
            (let ((y (list '+ p (list '* t (list '- q p)))))
              (ew y)
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'IN)
                      (begin (dk-cite! 'seg-trace-intro p q t) (dk-ass!))
                      (let ((ps (dk-cite! 'ln-psi-seg p q p0 d t)))
                        (ln-psi-typ! y p0 d)
                        (subst ps)
                        ;; psi(p) + t (psi(q) - psi(p)) = s (A + t (B - A)) = s (A - t D) = 0
                        (dk-have! (list '= (list '+ pp (list '* t (list '- pq pp))) (list '* sg (list '+ An (list '* t (list '- Bn An)))))
                          (lambda () (subst (list '= An A)) (subst (list '= Bn Bq))
                                     (dk-have! (list '= (list '* sg (list '+ (list '* sg pp) (list '* t (list '- (list '* sg pq) (list '* sg pp)))))
                                                        (list '* (list '* sg sg) (list '+ pp (list '* t (list '- pq pp))))) (lambda () (crs)))
                                     (subst (list '= (list '* sg (list '+ (list '* sg pp) (list '* t (list '- (list '* sg pq) (list '* sg pp)))))
                                                  (list '* (list '* sg sg) (list '+ pp (list '* t (list '- pq pp))))))
                                     (subst (list '= (list '* sg sg) 1)) (crs)))
                        (subst (list '= (list '+ pp (list '* t (list '- pq pp))) (list '* sg (list '+ An (list '* t (list '- Bn An))))))
                        (dk-have! (list '= (list '+ An (list '* t (list '- Bn An))) (list '- An tDn))
                          (lambda () (subst (list '= tDn (list '* t Dn))) (crs)))
                        (subst (list '= (list '+ An (list '* t (list '- Bn An))) (list '- An tDn)))
                        (subst (list '= tDn An))
                        (crs))))))))))))
(qed 'ln-cut-point)

;;; ---------------------------------------------------------------------------
;;; (9) triangles with a vertex on the line, and then any triangle in the ball
(define (ln-ctx body)                         ; the standing hypotheses of (7)
  (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ln-nfm 'u) (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN u CC)) (list 'IMPLIES (ln-cont 'u 'f)
  (list 'FORALL 'lnp0_ (list 'IMPLIES '(IN lnp0_ CC) (list 'FORALL 'lnd_ (list 'IMPLIES '(IN lnd_ CC) (list 'IMPLIES '(NOT (= lnd_ 0))
  (list 'IMPLIES (list 'HOLOMORPHIC-ON ln-V0 (list 'RESTRICT 'f ln-V0))
  (list 'FORALL 'lnc_ (list 'IMPLIES '(IN lnc_ CC) (list 'FORALL 'lnr_ (list 'IMPLIES '(IN lnr_ RR) (list 'IMPLIES '(< 0 lnr_)
  (list 'IMPLIES '(SUBSET (CLOSED-BALL CC-MS lnc_ (* 2 lnr_)) u) body))))))))))))))))))
(define (ln-in-ball v body) (list 'FORALL v (list 'IMPLIES (list 'IN v (ln-ball 'lnc_ 'lnr_)) body)))
(define (ln-ctx-setup!)                       ; ball inside U, etc.
  (let* ((c0 'lnc_) (r 'lnr_) (r2 '(* 2 lnr_)) (Bb (ln-ball 'lnc_ 'lnr_)) (CB2 '(CLOSED-BALL CC-MS lnc_ (* 2 lnr_))))
    (fact 'cc-is-metric-space) (fact 'cc-open-subset-cc 'u) (an-rr! r2)
    (dk-cite! 'cc-ball-is-convex c0 r)
    (dk-have! (list 'SUBSET Bb CB2)
      (lambda () (let ((z (subset-by-element!)))
                   (ln-ball-in! z c0 r)
                   (dk-have! (list '<= (list 'magnitude (list '- z c0)) r2) (lambda () (dk-ineq! (list '< (list 'magnitude (list '- z c0)) r) (list '< 0 r))))
                   (dk-fact! 'cc-closed-ball-mem-intro c0 r2 z) (dk-ass!))))
    (fact 'subset-trans Bb CB2 'u)))
(define (ln-half! sg a b c) (dk-cite! 'tri-int-half-plane 'u 'f 'lnp0_ 'lnd_ 'lnc_ 'lnr_ sg a b c))
(define (ln-nonneg-sg! sg v how)              ; lands (<= 0 (* sg psi(v))): how = 'zero | 'pos | 'neg (sg psi < 0 known for -sg) | 'ge
  (let* ((pv (ln-psi v 'lnp0_ 'lnd_)) (goal (list '<= 0 (list '* sg pv))))
    (ln-psi-typ! v 'lnp0_ 'lnd_) (an-rr! (list '* sg pv))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (cond ((eq? how 'zero) (dk-have! (list '= (list '* sg pv) 0) (lambda () (subst (list '= pv 0)) (crs))) (dk-ineq! (list '= (list '* sg pv) 0)))
                  (#t (how))))))
    goal))

(sp (make-wff (ln-ctx (list 'FORALL 'lns_ (list 'IMPLIES '(IN lns_ RR) (list 'IMPLIES '(= (* lns_ lns_) 1) (list 'IMPLIES '(= (magnitude lns_) 1)
  (ln-in-ball 'aop_ (ln-in-ball 'aoq_ (ln-in-ball 'aox_
    (list 'IMPLIES (list '< 0 (list '* 'lns_ (ln-psi 'aop_ 'lnp0_ 'lnd_)))
    (list 'IMPLIES (list '< (list '* 'lns_ (ln-psi 'aoq_ 'lnp0_ 'lnd_)) 0)
    (list 'IMPLIES (list '= (ln-psi 'aox_ 'lnp0_ 'lnd_) 0)
      '(= (TRI-INT f aop_ aoq_ aox_) 0))))))))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (memq (car (dk-goal)) '(IMPLIES FORALL))) (begin (di) (loop))))
(ln-ctx-setup!)
(let* ((p 'aop_) (q 'aoq_) (x 'aox_) (sg 'lns_) (ns (list '- 'lns_)) (p0 'lnp0_) (d 'lnd_)
       (Bb (ln-ball 'lnc_ 'lnr_)) (T3 (list 'CONV3 p q x)))
  (for-each (lambda (v) (ln-ball-in! v 'lnc_ 'lnr_)) (list p q x))
  (dk-fact! 'conv3-in-convex Bb p q x)
  (fact 'subset-trans T3 Bb 'u)
  (let* ((y (dk-skolem! (dk-cite! 'ln-cut-point p q p0 d sg) #t)))
    (dk-split-all!)
    (dk-split-all! (list (dk-cite! 'seg-trace-in-conv3 p q x)))
    (dk-fact! 'subset-mem-fwd (list 'TRACE (list 'SEG-PATH p q) 0 1) T3 y)
    (dk-fact! 'subset-mem-fwd T3 Bb y)
    (ln-ball-in! y 'lnc_ 'lnr_)
    (let* ((fan (dk-apply! (dk-cite! 'tri-int-fan 'u 'f p q x) y)))
      ;; the collinear piece
      (dk-fact! 'conv3-in-convex Bb p q y) (fact 'subset-trans (list 'CONV3 p q y) Bb 'u)
      (let ((col (dk-cite! 'tri-int-collinear 'u 'f p q y)))
        (if (and (pair? col) (eq? (car col) 'IMPLIES))
            (detach-with! col (lambda () (if (dk-only! (list 'IN y (list 'TRACE (list 'SEG-PATH p q) 0 1)) (dk-goal)) (prop))))))
      ;; -s on (q, x, y) and s on (x, p, y)
      (fact 'rr-subset-cc sg) (fact 'cc-magnitude-neg sg) (an-rr! ns)
      (dk-have! (list '= (list '* ns ns) 1) (lambda () (dk-have! (list '= (list '* ns ns) (list '* sg sg)) (lambda () (crs))) (subst (list '= (list '* ns ns) (list '* sg sg))) (ass)))
      (dk-have! (list '= (list 'magnitude ns) 1) (lambda () (subst (list '= (list 'magnitude ns) (list 'magnitude sg))) (ass)))
      (let ((pq (ln-psi q p0 d)))
        (ln-nonneg-sg! ns q (lambda () (an-rr! (list '* sg pq))
                                       (dk-have! (list '= (list '* ns pq) (list '- (list '* sg pq))) (lambda () (crs)))
                                       (dk-ineq! (list '= (list '* ns pq) (list '- (list '* sg pq))) (list '< (list '* sg pq) 0)))))
      (ln-nonneg-sg! ns x 'zero) (ln-nonneg-sg! ns y 'zero)
      (ln-half! ns q x y)
      (let ((pp (ln-psi p p0 d)))
        (ln-nonneg-sg! sg p (lambda () (dk-ineq! (list '< 0 (list '* sg pp))))))
      (ln-nonneg-sg! sg x 'zero) (ln-nonneg-sg! sg y 'zero)
      (ln-half! sg x p y)
      (subst fan)
      (subst (list '= (list 'TRI-INT 'f p q y) 0)) (subst (list '= (list 'TRI-INT 'f q x y) 0)) (subst (list '= (list 'TRI-INT 'f x p y) 0))
      (if (not (proof-done? *ps*)) (crs)))))
(qed 'tri-int-line-cross-vertex)

(define (ln-signs!)                           ; 1 and -1 as signs
  (fact 'rr-one-in) (fact 'rr-subset-cc 1) (an-rr! '(- 1))
  (dk-have! '(= (* 1 1) 1) (lambda () (crs)))
  (dk-have! '(= (* (- 1) (- 1)) 1) (lambda () (crs)))
  (fact 'cc-magnitude-one) (dk-cite! 'cc-magnitude-neg 1)
  (dk-have! '(= (magnitude (- 1)) 1) (lambda () (subst '(= (magnitude (- 1)) (magnitude 1))) (ass))))
(define (ln-sg-eq! sg v)                       ; lands (= (* sg psi(v)) +-psi(v)) for sg = 1 / (- 1)
  (let ((pv (ln-psi v 'lnp0_ 'lnd_)))
    (ln-psi-typ! v 'lnp0_ 'lnd_) (an-rr! (list '* sg pv))
    (let ((e (list '= (list '* sg pv) (if (equal? sg 1) pv (list '- pv)))))
      (if (not (dk-asm? e)) (dk-have! e (lambda () (crs))))
      e)))
(define (ln-sg! sg v rel)                      ; lands (rel (* sg psi v)) from the sign facts on psi v; rel = '<=0 | '<0 | '>0
  (let* ((pv (ln-psi v 'lnp0_ 'lnd_)) (e (ln-sg-eq! sg v)) (t (list '* sg pv))
         (goal (cond ((eq? rel '<=0) (list '<= 0 t)) ((eq? rel '>0) (list '< 0 t)) (#t (list '< t 0)))))
    (if (not (dk-asm? goal))
        (dk-have! goal (lambda ()
                         (let ((facts (filter (lambda (f) (and (memq (car f) '(< <= =)) (= (length f) 3) (or (equal? (cadr f) pv) (equal? (caddr f) pv))
                                                               (or (eqv? (cadr f) 0) (eqv? (caddr f) 0))))
                                              (dk-asms))))
                           (apply dk-ineq! (cons e facts))))))
    goal))
(sp (make-wff (ln-ctx (ln-in-ball 'aop_ (ln-in-ball 'aoq_ (ln-in-ball 'aox_
    (list 'IMPLIES (list '= (ln-psi 'aox_ 'lnp0_ 'lnd_) 0) '(= (TRI-INT f aop_ aoq_ aox_) 0))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (memq (car (dk-goal)) '(IMPLIES FORALL))) (begin (di) (loop))))
(ln-ctx-setup!) (ln-signs!)
(let* ((p 'aop_) (q 'aoq_) (x 'aox_) (pp (ln-psi 'aop_ 'lnp0_ 'lnd_)) (pq (ln-psi 'aoq_ 'lnp0_ 'lnd_)))
  (for-each (lambda (v) (ln-ball-in! v 'lnc_ 'lnr_) (ln-psi-typ! v 'lnp0_ 'lnd_)) (list p q x))
  (define (half! sg) (for-each (lambda (v) (ln-sg! sg v '<=0)) (list p q x)) (ln-half! sg p q x) (dk-ass!))
  (define (cross! sg) (ln-sg! sg p '>0) (ln-sg! sg q '<0)
    (dk-cite! 'tri-int-line-cross-vertex 'u 'f 'lnp0_ 'lnd_ 'lnc_ 'lnr_ sg p q x) (dk-ass!))
  (use-em (list '<= 0 pp)
    (lambda ()
      (use-em (list '<= 0 pq)
        (lambda () (half! 1))
        (lambda ()
          (dk-fact! 'rr-not-le-lt 0 pq)
          (use-em (list '= pp 0)
            (lambda () (half! '(- 1)))
            (lambda () (an-lt-of-le-ne! 0 pp) (cross! 1))))))
    (lambda ()
      (dk-fact! 'rr-not-le-lt 0 pp)
      (use-em (list '<= pq 0)
        (lambda () (half! '(- 1)))
        (lambda () (dk-fact! 'rr-not-le-lt pq 0) (cross! '(- 1)))))))
(qed 'tri-int-line-vertex)

(sp (make-wff (ln-ctx (ln-in-ball 'aoa_ (ln-in-ball 'aob_ (ln-in-ball 'aoc_ '(= (TRI-INT f aoa_ aob_ aoc_) 0)))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (memq (car (dk-goal)) '(IMPLIES FORALL))) (begin (di) (loop))))
(ln-ctx-setup!) (ln-signs!)
(let* ((a 'aoa_) (b 'aob_) (c 'aoc_) (Bb (ln-ball 'lnc_ 'lnr_)) (T3 (list 'CONV3 a b c))
       (ps (map (lambda (v) (ln-psi v 'lnp0_ 'lnd_)) (list a b c))) (pa (car ps)) (pb (cadr ps)) (pc (caddr ps)))
  (for-each (lambda (v) (ln-ball-in! v 'lnc_ 'lnr_) (ln-psi-typ! v 'lnp0_ 'lnd_)) (list a b c))
  (dk-fact! 'conv3-in-convex Bb a b c)
  (fact 'subset-trans T3 Bb 'u)
  (dk-split-all! (list (dk-cite! 'conv3-vertices-in a b c)))
  (dk-split-all! (list (dk-cite! 'seg-trace-in-conv3 a b c)))
  (define (fan-at! x)                         ; x in the hull, psi(x) = 0
    (dk-fact! 'subset-mem-fwd T3 Bb x)
    (let ((fan (dk-apply! (dk-cite! 'tri-int-fan 'u 'f a b c) x)))
      (for-each (lambda (pq) (dk-cite! 'tri-int-line-vertex 'u 'f 'lnp0_ 'lnd_ 'lnc_ 'lnr_ (car pq) (cadr pq) x))
                (list (list a b) (list b c) (list c a)))
      (subst fan)
      (for-each (lambda (pq) (subst (list '= (list 'TRI-INT 'f (car pq) (cadr pq) x) 0))) (list (list a b) (list b c) (list c a)))
      (if (not (proof-done? *ps*)) (crs))))
  (define (cut-at! sg p q)                    ; edge (p, q) of the triangle, s psi(p) > 0 > s psi(q)
    (ln-sg! sg p '>0) (ln-sg! sg q '<0)
    (let ((y (dk-skolem! (dk-cite! 'ln-cut-point p q 'lnp0_ 'lnd_ sg) #t)))
      (dk-split-all!)
      (dk-fact! 'subset-mem-fwd (list 'TRACE (list 'SEG-PATH p q) 0 1) T3 y)
      (fan-at! y)))
  (define (neg! v) (let ((pv (ln-psi v 'lnp0_ 'lnd_)))   ; NOT 0 < pv and NOT pv = 0  ==>  pv < 0
                     (dk-have! (list '< pv 0)
                       (lambda () (use-em (list '<= 0 pv)
                                    (lambda () (an-lt-of-le-ne! 0 pv) (ai (list 'NOT (list '< 0 pv))))
                                    (lambda () (dk-fact! 'rr-not-le-lt 0 pv) (dk-ass!)))))))
  (use-em (list '= pa 0) (lambda () (fan-at! a))
    (lambda ()
      (use-em (list '= pb 0) (lambda () (fan-at! b))
        (lambda ()
          (use-em (list '= pc 0) (lambda () (fan-at! c))
            (lambda ()
              (use-em (list '< 0 pa)
                (lambda ()
                  (use-em (list '< 0 pb)
                    (lambda ()
                      (use-em (list '< 0 pc)
                        (lambda () (for-each (lambda (v) (ln-sg! 1 v '<=0)) (list a b c)) (ln-half! 1 a b c) (dk-ass!))
                        (lambda () (neg! c) (cut-at! 1 b c))))
                    (lambda () (neg! b) (cut-at! 1 a b))))
                (lambda ()
                  (neg! a)
                  (use-em (list '< 0 pb)
                    (lambda () (cut-at! '(- 1) a b))
                    (lambda ()
                      (neg! b)
                      (use-em (list '< 0 pc)
                        (lambda () (cut-at! '(- 1) b c))
                        (lambda () (neg! c) (for-each (lambda (v) (ln-sg! '(- 1) v '<=0)) (list a b c)) (ln-half! '(- 1) a b c) (dk-ass!))))))))))))))
(qed 'tri-int-line-ball)

;;; ---------------------------------------------------------------------------
;;; PROPOSITION 3.45: f continuous on the open set U and holomorphic on U minus an infinite straight
;;; line L is holomorphic on U.  Morera on a small ball around each point, with (9).
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ln-nfm 'u) (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN u CC)) (list 'IMPLIES (ln-cont 'u 'f)
  (list 'FORALL 'lnp0_ (list 'IMPLIES '(IN lnp0_ CC) (list 'FORALL 'lnd_ (list 'IMPLIES '(IN lnd_ CC) (list 'IMPLIES '(NOT (= lnd_ 0))
  (list 'IMPLIES (list 'HOLOMORPHIC-ON ln-V0 (list 'RESTRICT 'f ln-V0))
    '(HOLOMORPHIC-ON u f))))))))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (eq? (car (dk-goal)) 'IMPLIES)) (begin (di) (loop))))
(fact 'cc-is-metric-space) (fact 'nf-cc-is-metric-space) (fact 'cc-open-subset-cc 'u)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(mac 'HOLOMORPHIC-ON)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (dk-ass!)
      (let* ((a (dk-di-var!)) (u 'u) (f 'f))
        (fact 'subset-mem-fwd u 'CC a)
        ;; a ball B(a, rho) inside U, and r = rho / 3
        (let ((oi (dk-cite! 'cc-ms-open-iff u)))
          (dk-have! (list 'IS-OPEN 'CC-MS u) (lambda () (if (dk-only! oi (list 'IS-OPEN ln-nfm u)) (prop)))))
        (dk-project! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y u) (list 'FORSOME 'r (list 'AND (list 'POS-RR 'r) (list 'SUBSET (list 'BALL 'CC-MS 'y 'r) u)))))
                     (lambda () (mac-h 'IS-OPEN (list 'IS-OPEN 'CC-MS u)) (dk-split-all!)))
        (let* ((rho (dk-skolem! (dk-apply! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y u) (list 'FORSOME 'r (list 'AND (list 'POS-RR 'r) (list 'SUBSET (list 'BALL 'CC-MS 'y 'r) u))))) a) #t))
               (r (list '* 1/3 rho)) (Bb (ln-ball a r)) (CB2 (list 'CLOSED-BALL 'CC-MS a (list '* 2 r))))
          (fact 'rr-pos-rr-in-rr rho) (fact 'rr-lt-of-pos-rr rho)
          (an-rr! r) (an-rr! (list '* 2 r))
          (dk-have! (list '< 0 r) (lambda () (dk-ineq! (list '< 0 rho))))
          (dk-have! (list 'SUBSET CB2 u)
            (lambda () (let ((z (subset-by-element!)))
                         (dk-split-all! (list (dk-cite! 'cc-closed-ball-mem a (list '* 2 r) z)))
                         (an-cc! (list '- z a)) (fact 'cc-magnitude-closed (list '- z a))
                         (dk-have! (list 'IN z (ln-ball a rho))
                           (lambda () (mac 'cc-ms-ball-membership)
                                      (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!)
                                                                     (dk-ineq! (list '<= (list 'magnitude (list '- z a)) (list '* 2 r)) (list '< 0 rho)))))))
                         (dk-fact! 'subset-mem-fwd (ln-ball a rho) u z) (dk-ass!))))
          ;; Morera on B(a, r)
          (dk-have! (list 'IN a '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
          (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
          (dk-have! (list 'NOT (list '= 0 r)) (lambda () (di) (dk-absurd! (list '= 0 r) (list '< 0 r))))
          (dk-have! (list 'AND (list 'IN r 'RR) (list 'AND (list '<= 0 r) (list 'NOT (list '= 0 r)))) (lambda () (dk-conj-close! (lambda () (ass)))))
          (dk-apply! (dk-cite! 'ball-is-open 'CC-MS) a r)
          (let ((oi2 (dk-cite! 'cc-ms-open-iff Bb)))
            (dk-have! (list 'IS-OPEN ln-nfm Bb) (lambda () (if (dk-only! oi2 (list 'IS-OPEN 'CC-MS Bb)) (prop)))))
          (dk-have! (list 'SUBSET Bb u)
            (lambda () (let ((z (subset-by-element!)))
                         (ln-ball-in! z a r)
                         (dk-have! (list '<= (list 'magnitude (list '- z a)) (list '* 2 r)) (lambda () (dk-ineq! (list '< (list 'magnitude (list '- z a)) r) (list '< 0 r))))
                         (dk-fact! 'cc-closed-ball-mem-intro a (list '* 2 r) z)
                         (dk-fact! 'subset-mem-fwd CB2 u z) (dk-ass!))))
          (let* ((F1 (list 'RESTRICT f Bb)))
            (fact 'restrict-in-fun f u 'CC Bb)
            (dk-apply! (dk-cite! 'ln-restrict-continuous u f) Bb)
            (dk-have! (list 'FORALL 'mrta_ (list 'IMPLIES (list 'IN 'mrta_ Bb) (list 'FORALL 'mrtb_ (list 'IMPLIES (list 'IN 'mrtb_ Bb) (list 'FORALL 'mrtc_ (list 'IMPLIES (list 'IN 'mrtc_ Bb)
                         (list 'IMPLIES (list 'SUBSET '(CONV3 mrta_ mrtb_ mrtc_) Bb) (list '= (list 'TRI-INT F1 'mrta_ 'mrtb_ 'mrtc_) 0))))))))
              (lambda ()
                (let* ((new (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
                       (gl (dk-goal)) (tri (cadr gl)) (ta (list-ref tri 2)) (tb (list-ref tri 3)) (tc (list-ref tri 4)))
                  (for-each (lambda (v) (ln-ball-in! v a r)) (list ta tb tc))
                  (subst (dk-cite! 'tri-int-restrict u f Bb ta tb tc))
                  (dk-cite! 'tri-int-line-ball u f 'lnp0_ 'lnd_ a r ta tb tc)
                  (dk-ass!))))
            (let* ((hol (dk-cite! 'morera Bb F1)))
              (dk-have! (list 'IN a Bb)
                (lambda () (mac 'cc-ms-ball-membership)
                           (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!)
                                                          (begin (dk-have! (list '= (list '- a a) 0) (lambda () (crs)))
                                                                 (subst (list '= (list '- a a) 0)) (fact 'cc-magnitude-zero)
                                                                 (subst '(= (magnitude 0) 0)) (dk-ineq! (list '< 0 r))))))))
              (let* ((l (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff Bb F1) a))))
                (dk-apply! (dk-cite! 'diff-on-local u) f Bb a l)
                (ew l)
                (dk-ass!)))))))))
(qed 'holomorphic-across-line)

  
