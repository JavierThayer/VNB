;;; la-z5-dsumcard.scm -- counting: a finite direct sum has the product of the summands'
;;; cardinalities as its cardinality (LA-Z5, 2026-10-25).  Prefix lz5d-.
;;;
;;; THE THEOREMS.  For n in NN and F with every VEC(F(i)), i in [1, n], a finite set:
;;;   dsum-vec-set-gen: DSUM-VEC(n, F) is a set (no module hypothesis; dsum-vec-set of
;;;       la-z3-dsum asks F(i) to be modules over one ring);
;;;   dsum-succ-bijection: (g, v) |-> (i |-> IF(i <= n, g(i), v)) is a bijection of
;;;       DSUM-VEC(n, F) x VEC(F(n+1)) onto DSUM-VEC(n+1, F);
;;;   dsum-card: CARD(DSUM-VEC(n, F)) = PROD-RING(ZZ-RING, k |-> CARD(VEC(F(k))), [1, n]),
;;;       by induction on n (n = 0: the one function on the empty interval; the step:
;;;       the bijection, card-cartesian, card-bijection-eq, lzd-prod-succ).
;;; DSUM-VEC is the carrier of DIRECT-SUM (la-z3-vocab); the statements ask nothing of
;;; F but the finiteness of the VEC(F(i)), so they serve any family of finite sets that
;;; is presented as the VEC of something.
;;;
;;; Destination theorem-library/.  Library: linear-algebra (DSUM-VEC).  LOAD WINDOW: after
;;; theorem-library/la-z3-dsum (dsum-vec-in, dsum-vec-out, dsum-in-union; load.scm 2684),
;;; la-z2-diag (lzd-prod-succ, 2191), and the LA-Z5 files la-z5-card (card-cartesian) and
;;; la-z5-zzmod (zz-ring-mul-is-mul).  Nothing in the tree cites the file.

(define (lz5d-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z5-dsumcard: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'combinatorial))
(define (lz5d-detach-all! inst)
  (let loop ((f inst))
    (if (and (pair? f) (eq? (car f) 'IMPLIES))
        (let ((a (cadr f)))
          (if (not (dk-asm? a)) (dk-have! a (dk-lane (lambda () (dk-lane-if! prop)))))
          (loop (if (dk-asm? (caddr f)) (dk-ctx-form (caddr f))
                    (dk-landed-1 (lambda () (detach! f))))))
        f)))
(define (lz5d-cite! thm . args) (lz5d-detach-all! (apply dk-cite! thm args)))
(define (lz5d-ass-ctx!) (if (and (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-asm? (dk-goal))) (ass)))
(define (lz5d-ass-if! g)
  (if (and (not (sequent-node-grounded? (proof-state-focus *ps*))) (equal? (dk-goal) g)) (ass)))
(define (lz5d-by! thunk) (let ((g0 (dk-goal))) (thunk) (lz5d-ass-if! g0)))
(define (lz5d-split! r) (if (dk-head-is? r 'AND) (dk-split! r)) r)
(define (lz5d-iff-r! iff)
  (let ((lhs (cadr iff)))
    (dk-have! lhs (dk-lane (lambda () (dk-only! iff (caddr iff)) (dk-lane-if! prop))))
    lhs))

(define LZ5D-I '(INTERVAL 1 n))
(define LZ5D-I1 '(INTERVAL 1 (succ n)))
(define LZ5D-BU '(BIG-UNION dsk_ (INTERVAL 1 n) (VEC (F dsk_))))
(define LZ5D-BU1 '(BIG-UNION dsk_ (INTERVAL 1 (succ n)) (VEC (F dsk_))))
(define LZ5D-V '(DSUM-VEC n F))
(define LZ5D-V1 '(DSUM-VEC (succ n) F))
(define LZ5D-W '(VEC (F (succ n))))
(define LZ5D-C (list 'CARTESIAN LZ5D-V LZ5D-W))
(define (lz5d-body u i) (list 'IF (list '<= i 'n) (list (list 'NTH 1 u) i) (list 'NTH 2 u)))
(define LZ5D-PSI (list 'VNB-LAMBDA 'dcu_ LZ5D-C (list 'VNB-LAMBDA 'dci_ LZ5D-I1 (lz5d-body 'dcu_ 'dci_))))
(define (lz5d-sets-hyp m) (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 m)) '(IN (VEC (F i_)) SET))))
(define (lz5d-fin-hyp m) (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 m)) '(IN (CARD (VEC (F i_))) NN))))

;;; ---- DSUM-VEC is a set ----
(sp (make-wff (forall-guarded '(n F) (list '(IN n NN) (lz5d-sets-hyp 'n)) (list 'IN LZ5D-V 'SET))))
(dk-peel!)
(fact 'interval-in-set 1 'n)
(dk-have! (list 'IN LZ5D-BU 'SET)
  (lambda ()
    (for-each (lambda (l)
                (dk-focus! l)
                (let ((g (dk-goal)))
                  (cond ((dk-asm? g) (ass))
                        (#t (let* ((ld (dk-peel!))
                                   (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) LZ5D-I))) ld))))
                              (dk-apply! (lz5d-sets-hyp 'n) i)
                              (lz5d-ass-if! (list 'IN (list 'VEC (list 'F i)) 'SET)))))))
              (dk-opened (lambda () (bu-set))))))
(mac 'DSUM-VEC)
(sep-set)
(if (not (proof-done? *ps*))
    (begin (mac 'fun-set-iff) (dk-conj-close! (lambda () (ass)))))
(lz5d-done! 'dsum-vec-set-gen)

;;; ---- the step bijection ----
(define (lz5d-idx! i)                   ; i in [1, succ n]: i in NN, 1 <= i <= succ n, in RR
  (lz5d-cite! 'interval-elt-in-nn 1 '(succ n) i)
  (lz5d-cite! 'interval-lo 1 '(succ n) i)
  (lz5d-cite! 'interval-hi 1 '(succ n) i)
  (lz5d-cite! 'nn-in-rr i))
(define (lz5d-lo! i)                    ; i in [1, succ n], i <= n: i in [1, n]
  (if (not (dk-asm? (list 'IN i LZ5D-I)))
      (lz5d-cite! 'interval-mem-intro 1 'n i)))
(define (lz5d-top! i)                   ; i in [1, succ n], not(i <= n): i = succ n
  (lz5d-cite! 'rr-not-le-lt i 'n)
  (lz5d-cite! 'nn-lt-succ-le 'n i)
  (lz5d-cite! 'nn-le-antisym i '(succ n)))
(define (lz5d-widen! j)                 ; j in [1, n]: j in [1, succ n]
  (if (not (dk-asm? (list 'IN j LZ5D-I1)))
      (begin
        (dk-have! '(<= n (succ n)) (lambda () (dk-nn!)))
        (lz5d-cite! 'interval-widen 'n '(succ n) 1 j))))
(define (lz5d-proj! u)                  ; u in C: NTH(1, u) in V, NTH(2, u) in W
  (if (not (dk-asm? (list 'IN (list 'NTH 1 u) LZ5D-V)))
      (lz5d-split! (lz5d-cite! 'cartesian-nth u LZ5D-V LZ5D-W))))
(define (lz5d-out! m g)                 ; g in DSUM-VEC(m, F): its FUN typing and the pointwise law
  (if (not (dk-asm? (lz5d-pt m g)))
      (lz5d-split! (lz5d-cite! 'dsum-vec-out m 'F g))))
(define (lz5d-pt m g)
  (list 'FORALL 'dsj_ (list 'IMPLIES (list 'IN 'dsj_ (list 'INTERVAL 1 m)) (list 'IN (list g 'dsj_) '(VEC (F dsj_))))))
;; (== IFT branch), the condition (or its negation) in context
(define (lz5d-if-eq! ift true?)
  (let ((val (if true? (caddr ift) (cadddr ift))))
    (dk-have! (list '== ift val)
      (lambda () (dk-if-branch! true? ift #f (lambda () (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (qrfl))))))
    (list '== ift val)))
;; u in C, i in [1, succ n]: (IN (body u i) (VEC (F i)))
(define (lz5d-val! u i)
  (let ((goal (list 'IN (lz5d-body u i) (list 'VEC (list 'F i))))
        (ift (lz5d-body u i)))
    (lz5d-proj! u)
    (dk-have! goal
      (lambda ()
        (use-em (list '<= i 'n)
          (lambda ()
            (lz5d-lo! i)
            (lz5d-out! 'n (list 'NTH 1 u))
            (dk-apply! (lz5d-pt 'n (list 'NTH 1 u)) i)
            (let ((e (lz5d-if-eq! ift #t)))
              (subst e) (ass)))
          (lambda ()
            (lz5d-top! i)
            (let ((e (lz5d-if-eq! ift #f)))
              (subst e) (subst (list '= i '(succ n))) (ass))))))
    goal))
(define (lz5d-psi-at! u i)              ; (== ((PSI u) i) (body u i))
  (let ((e (list '== (list (list LZ5D-PSI u) i) (lz5d-body u i))))
    (dk-have! e (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (qrfl))))
    e))

(define LZ5D-HS1 (lz5d-sets-hyp '(succ n)))
(sp (make-wff (forall-guarded '(n F) (list '(IN n NN) LZ5D-HS1)
  (list 'IN LZ5D-PSI (list 'BIJECTION LZ5D-C LZ5D-V1)))))
(dk-peel!)
(fact 'nn-succ-closed 'n)
(fact 'nn-in-rr 'n)
(fact 'interval-in-set 1 '(succ n))
(fact 'interval-in-set 1 'n)
;; the sets hypothesis on [1, n] and VEC(F(succ n)) a set
(dk-have! (lz5d-sets-hyp 'n)
  (lambda () (let* ((ld (dk-peel!)) (j (cadr (car ld)))) (lz5d-widen! j) (dk-apply! LZ5D-HS1 j) (lz5d-ass-ctx!))))
(lz5d-cite! 'dsum-vec-set-gen 'n 'F)
(lz5d-cite! 'dsum-vec-set-gen '(succ n) 'F)
(dk-have! '(IN (succ n) (INTERVAL 1 (succ n)))
  (lambda () (dk-have! '(<= 1 (succ n)) (lambda () (dk-nn!))) (dk-have! '(<= (succ n) (succ n)) (lambda () (dk-nn!)))
             (lz5d-by! (lambda () (lz5d-cite! 'interval-mem-intro 1 '(succ n) '(succ n))))))
(dk-apply! LZ5D-HS1 '(succ n))
(dk-have! (list 'IN LZ5D-C 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
(define LZ5D-IFF (dk-cite! 'bijection-membership-iff LZ5D-C LZ5D-V1 LZ5D-PSI))
(define LZ5D-PARTS (let ((r (caddr LZ5D-IFF))) (list (cadr r) (cadr (caddr r)) (caddr (caddr r)))))
;; (a) PSI maps into DSUM-VEC(succ n, F)
(define (lz5d-fun!)
  (dk-lam-type!
    (lambda ()
      (let* ((u (dk-di-var!))
             (g (dk-goal))
             (lam (cadr g)))
        (lz5d-proj! u)
        (dk-have! (list 'IN lam (list 'FUN LZ5D-I1 LZ5D-BU1))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((i (dk-di-var!)))
                  (lz5d-idx! i)
                  (if (dk--redex? (dk-goal)) (dk-lam-b!))
                  (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                      (let ((g0 (dk-goal)))
                        (lz5d-val! u i)
                        (lz5d-cite! 'dsum-in-union '(succ n) 'F i (lz5d-body u i))
                        (lz5d-ass-if! g0)))))
              (lambda () (ass)))))
        (dk-have! (lz5d-pt '(succ n) lam)
          (lambda ()
            (let ((i (dk-di-var!)))
              (lz5d-idx! i)
              (dk-lam-b!)
              (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                  (let ((g0 (dk-goal))) (lz5d-val! u i) (lz5d-ass-if! g0))))))
        (let ((g0 (dk-goal)))
          (lz5d-cite! 'dsum-vec-in '(succ n) 'F lam)
          (lz5d-ass-if! g0))))
    (lambda () (ass))))
(dk-have! (car LZ5D-PARTS) lz5d-fun!)
;; (b) PSI is injective
(define (lz5d-sym! e)                   ; (= a b) in context: land (= b a)
  (let ((r (list '= (caddr e) (cadr e))))
    (if (not (dk-asm? r)) (dk-have! r (lambda () (subst e) (rfl))))
    r))
(define (lz5d-inj!)
  (let* ((ld (dk-peel!))
         (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) LZ5D-C))) ld))
         (a (cadr (car ins))) (b (cadr (cadr ins)))
         (E (find-first (dk-head? '=) ld)))
    (lz5d-proj! a) (lz5d-proj! b)
    (let ((a1 (list 'NTH 1 a)) (a2 (list 'NTH 2 a)) (b1 (list 'NTH 1 b)) (b2 (list 'NTH 2 b)))
      (lz5d-out! 'n a1) (lz5d-out! 'n b1)
      ;; ((PSI a) j) = ((PSI b) j) read as body a j = body b j
      (define (at! j)
        (let* ((c (dk-congr! E (lambda (t) (list t j)) '==))
               (ea (lz5d-psi-at! a j))
               (eb (lz5d-psi-at! b j))
               (c1 (dk-rewrite-h! c (list (list LZ5D-PSI a) j) (lz5d-body a j))))
          (dk-rewrite-h! c1 (list (list LZ5D-PSI b) j) (lz5d-body b j))))
      ;; the first components agree
      (let ((e1 (dk-fun-ext! a1 b1 LZ5D-I LZ5D-BU #f #f
                  (lambda (j)
                    (lz5d-widen! j)
                    (dk-have! (list '<= j 'n) (lambda () (lz5d-cite! 'interval-hi 1 'n j) (lz5d-ass-if! (list '<= j 'n))))
                    (let* ((c (at! j))
                           (fa (lz5d-if-eq! (lz5d-body a j) #t))
                           (fb (lz5d-if-eq! (lz5d-body b j) #t))
                           (c2 (dk-rewrite-h! c (lz5d-body a j) (list a1 j))))
                      (let ((c3 (dk-rewrite-h! c2 (lz5d-body b j) (list b1 j))))
                        (dk-apply! (lz5d-pt 'n a1) j)
                        (subst c3) (rfl)))))))
        ;; the second components agree
        (let* ((sn '(succ n))
               (ignore (fact 'nn-succ-not-le 'n))
               (c (at! sn))
               (fa (lz5d-if-eq! (lz5d-body a sn) #f))
               (fb (lz5d-if-eq! (lz5d-body b sn) #f))
               (c2 (dk-rewrite-h! c (lz5d-body a sn) a2))
               (e2q (dk-rewrite-h! c2 (lz5d-body b sn) b2))
               (e2 (list '= a2 b2)))
          (dk-have! e2 (lambda () (subst e2q) (rfl)))
          ;; a = [a1, a2] = [b1, b2] = b, through names for the projections
          (lz5d-cite! 'cartesian-pair-eq a LZ5D-V LZ5D-W)
          (lz5d-cite! 'cartesian-pair-eq b LZ5D-V LZ5D-W)
          (let* ((pa1 (dk-name! a1 LZ5D-V)) (pa2 (dk-name! a2 LZ5D-W))
                 (pb1 (dk-name! b1 LZ5D-V)) (pb2 (dk-name! b2 LZ5D-W))
                 (ha (dk-rewrite-h! (dk-rewrite-h! (list '= a (list 'LIST a1 a2)) a1 pa1) a2 pa2))
                 (hb (dk-rewrite-h! (dk-rewrite-h! (list '= b (list 'LIST b1 b2)) b1 pb1) b2 pb2))
                 (q1 (dk-rewrite-h! (dk-rewrite-h! e1 a1 pa1) b1 pb1))
                 (q2 (dk-rewrite-h! (dk-rewrite-h! e2 a2 pa2) b2 pb2)))
            (for-each (lambda (x c) (fact 'membership-implies-sethood x c))
                      (list pa1 pa2) (list LZ5D-V LZ5D-W))
            (subst ha)
            (subst hb)
            (subst (list '= pb1 pa1))
            (subst (list '= pb2 pa2))
            (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))))))
(dk-have! (cadr LZ5D-PARTS) lz5d-inj!)
;; (c) PSI is onto: f = PSI([j |-> f(j) on [1, n], f(succ n)])
(define (lz5d-onto!)
  (let* ((f (dk-di-var!))
         (g (list 'VNB-LAMBDA 'dcj_ LZ5D-I (list f 'dcj_)))
         (v (list f '(succ n)))
         (z (list 'LIST g v)))
    (lz5d-out! '(succ n) f)
    (dk-apply! (lz5d-pt '(succ n) f) '(succ n))
    ;; g is in DSUM-VEC(n, F)
    (dk-have! (list 'IN g (list 'FUN LZ5D-I LZ5D-BU))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((j (dk-di-var!)))
              (lz5d-widen! j)
              (if (dk--redex? (dk-goal)) (dk-lam-b!))
              (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                  (lz5d-by! (lambda ()
                              (dk-apply! (lz5d-pt '(succ n) f) j)
                              (lz5d-cite! 'dsum-in-union 'n 'F j (list f j)))))))
          (lambda () (ass)))))
    (dk-have! (lz5d-pt 'n g)
      (lambda ()
        (let ((j (dk-di-var!)))
          (lz5d-widen! j)
          (dk-lam-b!)
          (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
              (lz5d-by! (lambda () (dk-apply! (lz5d-pt '(succ n) f) j)))))))
    (lz5d-cite! 'dsum-vec-in 'n 'F g)
    (lz5d-cite! 'pair-in-cartesian LZ5D-V LZ5D-W g v)
    (fact 'membership-implies-sethood g LZ5D-V)
    (fact 'membership-implies-sethood v LZ5D-W)
    (let* ((n1 (lz5d-cite! 'nth1-pair g v))
          (n2 (lz5d-cite! 'nth2-pair g v)))
      (lz5d-cite! 'fun-apply-type-c LZ5D-PSI LZ5D-C LZ5D-V1 z)
      (lz5d-out! '(succ n) (list LZ5D-PSI z))
      (ew z)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (dk-fun-ext! (list LZ5D-PSI z) f LZ5D-I1 LZ5D-BU1 #f #f
                (lambda (i)
                  (lz5d-idx! i)
                  (let ((e (lz5d-psi-at! z i)))
                    (dk-apply! (lz5d-pt '(succ n) f) i)
                    (subst e)
                    (subst n1)
                    (subst n2)
                    (let ((ift (list 'IF (list '<= i 'n) (list g i) v)))
                      (use-em (list '<= i 'n)
                        (lambda ()
                          (lz5d-lo! i)
                          (subst (lz5d-if-eq! ift #t))
                          (dk-lam-b!)
                          (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
                        (lambda ()
                          (lz5d-top! i)
                          (subst (lz5d-if-eq! ift #f))
                          (subst (list '= i '(succ n)))
                          (rfl)))))))))))))
(dk-have! (caddr LZ5D-PARTS) lz5d-onto!)
(dk-have! (caddr LZ5D-IFF) (lambda () (dk-conj-close! (lambda () (ass)))))
(lz5d-iff-r! LZ5D-IFF)
(lz5d-done! 'dsum-succ-bijection)
(gloss! 'dsum-succ-bijection "(g, v) |-> (i |-> g(i) for i <= n, v for i = n+1) is a bijection of DSUM-VEC(n, F) x VEC(F(n+1)) onto DSUM-VEC(n+1, F).")

;;; ---- the count, by induction on n ----
(define (lz5d-prod m) (list 'PROD-RING 'ZZ-RING (list 'VNB-LAMBDA 'dck_ (list 'INTERVAL 1 m) '(CARD (VEC (F dck_)))) (list 'INTERVAL 1 m)))
(define (lz5d-body-claim m)
  (list 'AND (list 'IN (list 'CARD (list 'DSUM-VEC m 'F)) 'NN)
             (list '= (list 'CARD (list 'DSUM-VEC m 'F)) (lz5d-prod m))))
(define (lz5d-rename e from to)
  (cond ((eq? e from) to) ((pair? e) (cons (lz5d-rename (car e) from to) (lz5d-rename (cdr e) from to))) (#t e)))
(define (lz5d-claim m)                  ; the family is bound as dcfam_, so no statement binds F twice
  (list 'FORALL 'dcfam_
    (lz5d-rename (list 'IMPLIES (lz5d-sets-hyp m) (list 'IMPLIES (lz5d-fin-hyp m) (lz5d-body-claim m))) 'F 'dcfam_)))
(define (lz5d-zz-carr! t)               ; t in NN: land t in ZZ and t in CARR(ZZ-RING)
  (lz5d-cite! 'nn-subset-zz t)
  (dk-have! (list 'IN t '(CARR ZZ-RING)) (lambda () (subst '(== (CARR ZZ-RING) ZZ)) (ass))))

;; the step, n -> succ n
(sp (make-wff (forall-guarded '(n F)
  (list '(IN n NN) (lz5d-sets-hyp '(succ n)) (lz5d-fin-hyp '(succ n))
        (lz5d-claim 'n))
  (lz5d-body-claim '(succ n)))))
(dk-peel!)
(fact 'nn-succ-closed 'n)
(fact 'interval-in-set 1 '(succ n))
(fact 'interval-in-set 1 'n)
(fact 'zz-is-commutative-ring)
(dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl)))
(dk-have! (lz5d-sets-hyp 'n)
  (lambda () (let* ((ld (dk-peel!)) (j (cadr (car ld)))) (lz5d-widen! j) (lz5d-by! (lambda () (dk-apply! (lz5d-sets-hyp '(succ n)) j))))))
(dk-have! (lz5d-fin-hyp 'n)
  (lambda () (let* ((ld (dk-peel!)) (j (cadr (car ld)))) (lz5d-widen! j) (lz5d-by! (lambda () (dk-apply! (lz5d-fin-hyp '(succ n)) j))))))
(define LZ5D-IHI (list 'IMPLIES (lz5d-sets-hyp 'n) (list 'IMPLIES (lz5d-fin-hyp 'n) (lz5d-body-claim 'n))))
(dk-apply! (lz5d-claim 'n) 'F)
(lz5d-split! (lz5d-detach-all! (dk-ctx-form LZ5D-IHI)))
(dk-have! '(IN (succ n) (INTERVAL 1 (succ n)))
  (lambda () (dk-have! '(<= 1 (succ n)) (lambda () (dk-nn!))) (dk-have! '(<= (succ n) (succ n)) (lambda () (dk-nn!)))
             (lz5d-by! (lambda () (lz5d-cite! 'interval-mem-intro 1 '(succ n) '(succ n))))))
(dk-apply! (lz5d-sets-hyp '(succ n)) '(succ n))
(dk-apply! (lz5d-fin-hyp '(succ n)) '(succ n))
(lz5d-cite! 'dsum-vec-set-gen 'n 'F)
(define LZ5D-CW (list 'CARD LZ5D-W))
(define LZ5D-CV (list 'CARD LZ5D-V))
(define LZ5D-P0 (lz5d-prod 'n))
(define LZ5D-G1 (list 'VNB-LAMBDA 'dck_ LZ5D-I1 '(CARD (VEC (F dck_)))))
(define LZ5D-G0 (caddr LZ5D-P0))
(lz5d-cite! 'card-cartesian LZ5D-V LZ5D-W)
(dk-have! (list 'AND (list 'IN LZ5D-CV 'NN) (list 'IN LZ5D-CW 'NN)) (lambda () (dk-conj-close! (lambda () (ass)))))
(fact 'nn-mul-closed LZ5D-CV LZ5D-CW)
(dk-have! (list 'IN LZ5D-C 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
(dk-have! (list 'IN (list 'CARD LZ5D-C) 'NN) (lambda () (subst (list '= (list 'CARD LZ5D-C) (list '* LZ5D-CV LZ5D-CW))) (ass)))
(lz5d-cite! 'dsum-succ-bijection 'n 'F)
(lz5d-cite! 'card-bijection-eq LZ5D-C LZ5D-V1 LZ5D-PSI)
;; the product over [1, succ n]
(dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ LZ5D-I1) (list 'IN (list LZ5D-G1 'z_) '(CARR ZZ-RING))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (dk-apply! (lz5d-fin-hyp '(succ n)) z)
      (dk-lam-b!)
      (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
          (lz5d-by! (lambda () (lz5d-zz-carr! (list 'CARD (list 'VEC (list 'F z))))))))))
(lz5d-cite! 'lzd-prod-succ 'ZZ-RING 'n LZ5D-G1)
(lz5d-cite! 'interval-card-in-nn 1 'n)
(dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ LZ5D-I) (list '= (list LZ5D-G1 'z_) (list LZ5D-G0 'z_))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (lz5d-widen! z)
      (dk-apply! (lz5d-fin-hyp 'n) z)
      (dk-lam-b!)
      (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
(fact 'nn-one-in)
(lz5d-cite! 'prod-ring-congruence-q 'ZZ-RING LZ5D-I LZ5D-G1 LZ5D-G0)
(define LZ5D-G1S (list LZ5D-G1 '(succ n)))
(dk-have! (list '= LZ5D-G1S LZ5D-CW) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
(lz5d-zz-carr! LZ5D-CW)
(dk-have! (list 'IN LZ5D-P0 'ZZ) (lambda () (subst (list '= LZ5D-P0 LZ5D-CV)) (lz5d-by! (lambda () (lz5d-cite! 'nn-subset-zz LZ5D-CV)))))
(lz5d-cite! 'zz-ring-mul-is-mul LZ5D-P0 LZ5D-CW)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IN)
        (begin (subst (list '= (list 'CARD LZ5D-V1) (list 'CARD LZ5D-C))) (ass))
        (begin
          (subst (list '= (list 'CARD LZ5D-V1) (list 'CARD LZ5D-C)))
          (subst (list '= (list 'CARD LZ5D-C) (list '* LZ5D-CV LZ5D-CW)))
          (subst (list '= LZ5D-CV LZ5D-P0))
          (subst (list '= (list 'PROD-RING 'ZZ-RING LZ5D-G1 LZ5D-I1)
                       (list '(MUL ZZ-RING) (list 'PROD-RING 'ZZ-RING LZ5D-G1 LZ5D-I) LZ5D-G1S)))
          (subst (list '== (list 'PROD-RING 'ZZ-RING LZ5D-G1 LZ5D-I) (list 'PROD-RING 'ZZ-RING LZ5D-G0 LZ5D-I)))
          (subst (list '= LZ5D-G1S LZ5D-CW))
          (subst (list '= (list '(MUL ZZ-RING) LZ5D-P0 LZ5D-CW) (list '* LZ5D-P0 LZ5D-CW)))
          (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
              (begin (dk-have! (list 'AND (list 'IN LZ5D-P0 'ZZ) (list 'IN LZ5D-CW 'ZZ)) (lambda () (dk-conj-close! (lambda () (ass)))))
                     (fact 'zz-mul-closed LZ5D-P0 LZ5D-CW)
                     (rfl)))))))
(lz5d-done! 'dsum-card-step)

;; the base, n = 0: DSUM-VEC(0, F) = {e}, e the function on the empty interval
(define LZ5D-I0 '(INTERVAL 1 0))
(define LZ5D-BU0 '(BIG-UNION dsk_ (INTERVAL 1 0) (VEC (F dsk_))))
(define LZ5D-V0 '(DSUM-VEC 0 F))
(define LZ5D-E (list 'VNB-LAMBDA 'dce_ LZ5D-I0 0))
(define (lz5d-empty-absurd! z)          ; z in [1, 0] in context: close the goal
  (fact 'interval-1-0-empty)
  (let ((h (dk-rewrite-h! (list 'IN z LZ5D-I0) LZ5D-I0 'EMPTY-SET)))
    (fact 'empty-set-has-no-members z)
    (if (not (eq? (dk-goal) 'FALSITY)) (pbc))
    (ai (list 'NOT (list 'IN z 'EMPTY-SET)))))
(sp (make-wff (list 'FORALL 'F (list 'IMPLIES (lz5d-sets-hyp 0) (list 'IMPLIES (lz5d-fin-hyp 0) (lz5d-body-claim 0))))))
(dk-peel!)
(fact 'interval-in-set 1 0)
(fact 'nn-zero-in)
(lz5d-cite! 'dsum-vec-set-gen 0 'F)
(dk-have! (list 'IN LZ5D-BU0 'SET)
  (lambda ()
    (for-each (lambda (l)
                (dk-focus! l)
                (cond ((dk-asm? (dk-goal)) (ass))
                      (#t (let* ((ld (dk-peel!))
                                 (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) LZ5D-I0))) ld))))
                            (lz5d-empty-absurd! i)))))
              (dk-opened (lambda () (bu-set))))))
(dk-have! (list 'IN LZ5D-E (list 'FUN LZ5D-I0 LZ5D-BU0))
  (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (lz5d-empty-absurd! z))) (lambda () (ass)))))
(dk-have! (lz5d-pt 0 LZ5D-E)
  (lambda () (let ((z (dk-di-var!))) (lz5d-empty-absurd! z))))
(lz5d-cite! 'dsum-vec-in 0 'F LZ5D-E)
(fact 'membership-implies-sethood LZ5D-E LZ5D-V0)
(define LZ5D-SG (list 'PAIR LZ5D-E LZ5D-E))
(dk-have! (list 'AND (list 'IN LZ5D-E 'SET) (list 'IN LZ5D-E 'SET)) (lambda () (dk-conj-close! (lambda () (ass)))))
(define LZ5D-PM (lz5d-cite! 'pairing-membership LZ5D-E LZ5D-E))
(dk-have! (list 'FORALL 'lzz_ (list 'IFF (list 'IN 'lzz_ LZ5D-V0) (list 'IN 'lzz_ LZ5D-SG)))
  (lambda ()
    (let ((x (begin (di) (cadr (cadr (dk-goal))))))
      (let ((pmx (dk-apply! LZ5D-PM x)))
        (dk-iff! (lambda (g) (equal? g (list 'IN x LZ5D-SG)))
          (lambda ()
            (lz5d-out! 0 x)
            (dk-fun-ext! x LZ5D-E LZ5D-I0 LZ5D-BU0 #f #f (lambda (z) (lz5d-empty-absurd! z)))
            (dk-have! (list 'OR (list '= x LZ5D-E) (list '= x LZ5D-E)) (lambda () (oi-l) (ass)))
            (dk-have! (list 'IN x LZ5D-SG) (dk-lane (lambda () (dk-only! pmx (list 'OR (list '= x LZ5D-E) (list '= x LZ5D-E))) (dk-lane-if! prop))))
            (lz5d-ass-if! (list 'IN x LZ5D-SG)))
          (lambda ()
            (dk-have! (list '= x LZ5D-E) (dk-lane (lambda () (dk-only! pmx (list 'IN x LZ5D-SG)) (dk-lane-if! prop))))
            (subst (list '= x LZ5D-E))
            (ass)))))))
(let ((ch (dk-cite! 'class-extensionality LZ5D-V0 LZ5D-SG)))
  (if (and (pair? ch) (eq? (car ch) 'IMPLIES)) (detach! ch)))
(lz5d-cite! 'card-singleton LZ5D-E)
(lz5d-cite! 'nn-succ-plus-one 0)
(fact 'interval-1-0-empty)
(fact 'zz-is-commutative-ring)
(lz5d-cite! 'prod-ring-empty 'ZZ-RING (caddr (lz5d-prod 0)))
(fact 'nn-succ-closed 0)
(dk-conj-close!
  (lambda ()
    (subst (list '= LZ5D-V0 LZ5D-SG))
    (subst (list '= (list 'CARD LZ5D-SG) '(succ 0)))
    (if (dk-head-is? (dk-goal) 'IN)
        (ass)
        (begin
          (subst (dk-rewrite-h! (list '= (list 'PROD-RING 'ZZ-RING (caddr (lz5d-prod 0)) 'EMPTY-SET) '(ONE ZZ-RING))
                                'EMPTY-SET LZ5D-I0))
          (fact 'zz-ring@one)
          (subst '(== (ONE ZZ-RING) 1))
          (subst '(= (succ 0) (+ 0 1)))
          (arith)))))
(lz5d-done! 'dsum-card-zero)

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (lz5d-claim 'n)))))
(let* ((opened (dk-opened (lambda () (ni))))
       (step (find-first (lambda (l) (dk-contains? (dk-goal-of l) 'succ)) opened))
       (base (find-first (lambda (l) (not (eq? l step))) opened)))
  (dk-focus! base)
  (fact 'dsum-card-zero)
  (if (not (sequent-node-grounded? base)) (ass))
  (dk-focus! step)
  (let* ((ld (dk-peel!))
         (g (dk-goal))
         (k (let find ((e g)) (cond ((and (pair? e) (eq? (car e) 'succ) (symbol? (cadr e))) (cadr e))
                                    ((pair? e) (or (find (car e)) (find (cdr e))))
                                    (#t #f))))
         (ih (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'DSUM-VEC))) ld))
         (fv (car (cadr (cadr (caddr (caddr (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'SET)
                                                                (not (dk-contains? f 'DSUM-VEC)))) ld))))))))
    (if (not ih) (error "dsum-card: no induction hypothesis"))
    (lz5d-by! (lambda () (lz5d-cite! 'dsum-card-step k fv)))))
(lz5d-done! 'dsum-card-ind)

(sp (make-wff (forall-guarded '(n F) (list '(IN n NN) (lz5d-sets-hyp 'n) (lz5d-fin-hyp 'n)) (lz5d-body-claim 'n))))
(dk-peel!)
(let ((c (lz5d-cite! 'dsum-card-ind 'n)))
  (lz5d-by! (lambda () (lz5d-detach-all! (dk-apply! c 'F)))))
(lz5d-done! 'dsum-card)
(gloss! 'dsum-card "If VEC(F(1)), ..., VEC(F(n)) are finite sets, the direct-sum carrier DSUM-VEC(n, F) has CARD(VEC(F(1))) * ... * CARD(VEC(F(n))) elements.")
