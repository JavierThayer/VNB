(sp (make-wff (forall-guarded '(v t_ ix e lm tfd_) (append tqf-ehyps '((POS-RR tfd_)))
  (list 'IN (list 'CARD (tqf-large 'tfd_)) 'NN))))
(dk-peel!)
(tqf-try "large-finite" (lambda ()
  (let* ((S (tqf-large 'tfd_))
         (r (tqf-iff-fwd! 'is-orthonormal-family 'v 'ix 'e))
