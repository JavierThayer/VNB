;;; tqf helpers (TH3-A4): copy of TH3-A3 tqd-helpers.scm, prefix tqf-. Was: copy of TH3-A2 tqb-helpers.scm (itself a copy of TH3-A tqa-helpers.scm) (scratchpad/th3-1109/a/), prefix tqf-.
;;; tqa helpers: copies of ba-bh2.scm's bb2- helpers (themselves copies of ba-bh.scm's bbh- and hilbert-projection.scm's hpr- kit), prefix tqf-.
(define tqf-v 'v)
(define (tqf-ip a b) (list (list 'IP tqf-v) a b))
(define (tqf-sub a b) (list (list 'VADD tqf-v) a (list (list 'VNEG tqf-v) b)))
(define (tqf-add a b) (list (list 'VADD tqf-v) a b))
(define (tqf-act c a) (list (list 'ACT tqf-v) c a))
(define (tqf-q a) (tqf-ip a a))

(define (tqf-op? e op)
  (and (pair? e) (pair? (car e)) (eq? (car (car e)) op) (equal? (cadr (car e)) tqf-v)))
(define (tqf-zero? e) (equal? e (list 'VZERO tqf-v)))

;;; land (IN e (VEC v)) for a vector term built from typed atoms
(define (tqf-vt! e)
  (let ((goal (list 'IN e (list 'VEC tqf-v))))
    (cond ((and (dk-asm? goal) (not (or (tqf-op? e 'VADD) (tqf-op? e 'VNEG) (tqf-op? e 'ACT))))
           goal)
          ((dk-asm? goal)                  ; typed: still type the parts, which the laws need
           (cond ((tqf-op? e 'VADD) (tqf-vt! (cadr e)) (tqf-vt! (caddr e)))
                 ((tqf-op? e 'VNEG) (tqf-vt! (cadr e)))
                 ((tqf-op? e 'ACT)  (tqf-ct! (cadr e)) (tqf-vt! (caddr e))))
           goal)
          ((tqf-op? e 'VADD) (tqf-vt! (cadr e)) (tqf-vt! (caddr e))
                             (dk-cite! 'cips-vadd-type tqf-v (cadr e) (caddr e)) goal)
          ((tqf-op? e 'VNEG) (tqf-vt! (cadr e))
                             (dk-cite! 'cips-vneg-type tqf-v (cadr e)) goal)
          ((tqf-op? e 'ACT)  (tqf-ct! (cadr e)) (tqf-vt! (caddr e))
                             (dk-cite! 'cips-act-type tqf-v (cadr e) (caddr e)) goal)
          ((tqf-zero? e) (dk-cite! 'cips-vzero-in tqf-v) goal)
          ((tqf-app-fun e) => (lambda (ft) (tqf-arg-t! (cadr e) (cadr (caddr ft)))
                                    (dk-cite! 'fun-apply-type-c (car e) (cadr (caddr ft)) (caddr (caddr ft)) (cadr e))
                                    goal))
          (#t (error "tqf-vt!: no typing for the vector" (expression->string e))))))

;;; an application (f a) with (IN f (FUN D (VEC v))) in context: that typing
(define (tqf-app-fun e)
  (and (pair? e) (= (length e) 2)
       (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (cadr h) (car e))
                                    (pair? (caddr h)) (eq? (car (caddr h)) 'FUN)
                                    (= (length (caddr h)) 3)
                                    (equal? (caddr (caddr h)) (list 'VEC tqf-v))))
                   (dk-asms))))
;;; type the argument a in D: by recursion when D is VEC v, else from context
(define (tqf-arg-t! a d)
  (cond ((dk-asm? (list 'IN a d)) #t)
        ((equal? d (list 'VEC tqf-v)) (tqf-vt! a))
        ((and (pair? d) (eq? (car d) 'VEC))
         (fluid-let ((tqf-v (cadr d))) (tqf-vt! a)))
        (#t (error "tqf-arg-t!: argument not typed" (expression->string (list 'IN a d))))))

;;; land (IN c CC) for a scalar term
(define (tqf-ct! c)
  (let ((goal (list 'IN c 'CC)))
    (cond ((dk-asm? goal) goal)
          ((eqv? c +i) (dk-cite! 'cc-i-in) goal)
          ((number? c) (dk-have! goal (lambda () (arith))) goal)
          ((dk-asm? (list 'IN c 'RR)) (dk-cite! 'rr-subset-cc c) goal)
          ((tqf-op? c 'IP) (tqf-vt! (cadr c)) (tqf-vt! (caddr c))
                           (dk-cite! 'cips-ip-type tqf-v (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) 'conjugate))
           (tqf-ct! (cadr c)) (dk-cite! 'cc-conjugate-closed (cadr c)) goal)
          ((and (pair? c) (memq (car c) '(* +)) (= (length c) 3))
           (tqf-ct! (cadr c)) (tqf-ct! (caddr c))
           (tqf-have-and! (list 'IN (cadr c) 'CC) (list 'IN (caddr c) 'CC))
           (dk-cite! (if (eq? (car c) '*) 'cc-mul-closed 'cc-add-closed) (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 3))
           (tqf-ct! (cadr c)) (tqf-ct! (caddr c))
           (dk-cite! 'cc-sub-in-cc (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 2))
           (tqf-ct! (cadr c)) (dk-cite! 'cc-neg-closed (cadr c)) goal)
          (#t (dk-have! goal (lambda () (type-term))) goal))))

;;; the first inner-product term in E (preorder) with a compound argument
(define (tqf-find-redex e)
  (cond ((not (pair? e)) #f)
        ((and (tqf-op? e 'IP) (= (length e) 3)
              (or (tqf-compound? (cadr e)) (tqf-compound? (caddr e))))
         e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((tqf-find-redex (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
(define (tqf-compound? e)
  (or (tqf-op? e 'VADD) (tqf-op? e 'VNEG) (tqf-op? e 'ACT) (tqf-zero? e)))

;;; the law instance that opens the redex <a, b>
(define (tqf-open-law! r)
  (let ((a (cadr r)) (b (caddr r)))
    (tqf-vt! a) (tqf-vt! b)
    (cond ((tqf-op? a 'VADD) (dk-cite! 'cips-ip-add-left tqf-v (cadr a) (caddr a) b))
          ((tqf-op? a 'VNEG) (dk-cite! 'cips-ip-neg-left tqf-v (cadr a) b))
          ((tqf-op? a 'ACT)  (dk-cite! 'cips-ip-homog-left tqf-v (cadr a) (caddr a) b))
          ((tqf-zero? a)     (dk-cite! 'cips-ip-zero-left tqf-v b))
          ((tqf-op? b 'VADD) (dk-cite! 'cips-ip-add-right tqf-v a (cadr b) (caddr b)))
          ((tqf-op? b 'VNEG) (dk-cite! 'cips-ip-neg-right tqf-v a (cadr b)))
          ((tqf-op? b 'ACT)  (dk-cite! 'cips-ip-conj-homog-right tqf-v (cadr b) a (caddr b)))
          ((tqf-zero? b)     (dk-cite! 'cips-ip-zero-right tqf-v a))
          (#t (error "tqf-open-law!: not a redex" (expression->string r))))))

;;; a conjugate that can be pushed inwards: of a real (a numeral, or typed RR
;;; in context), of a product, sum, negation or conjugate, of an inner product
(define (tqf-conj-redex? e)
  (and (pair? e) (eq? (car e) 'conjugate) (= (length e) 2)
       (let ((x (cadr e)))
         (or (number? x) (dk-asm? (list 'IN x 'RR))
             (and (pair? x) (memq (car x) '(* + conjugate)))
             (and (pair? x) (eq? (car x) '-) (= (length x) 2))
             (and (tqf-op? x 'IP) (= (length x) 3))))))
(define (tqf-find-real-conj e)
  (cond ((not (pair? e)) #f)
        ((tqf-conj-redex? e) e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((tqf-find-real-conj (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))

;;; EXPAND the goal: every inner product of a constructed vector is opened by
;;; its law (first argument first), and every conjugate of a real is dropped,
;;; until the goal is a polynomial in inner products of ATOMS.  Loops on a redex
;;; test, never on a count.
(define (tqf-expand!)
  (let loop ((fuel 200))
    (if (<= fuel 0) (error "tqf-expand!: out of fuel"))
    (let ((r (tqf-find-redex (dk-goal))))
      (if r
          (let ((eq (tqf-open-law! r)))
            (subst eq)
            (loop (- fuel 1)))
          (let ((c (tqf-find-real-conj (dk-goal))))
            (if c
                (begin
                  (tqf-push-conj! c)
                  (loop (- fuel 1)))))))))

;;; one step of pushing a conjugate inwards
(define (tqf-push-conj! c)
  (let ((x (cadr c)))
    (cond ((or (number? x) (dk-asm? (list 'IN x 'RR)))
           (if (number? x) (dk-have! (list 'IN x 'RR) (lambda () (arith))))
           (subst (dk-cite! 'cc-conjugate-fixes-rr x)))
          ((tqf-op? x 'IP)
           (tqf-vt! (cadr x)) (tqf-vt! (caddr x))
           (dk-cite! 'cips-ip-conj-sym tqf-v (cadr x) (caddr x))
           (subst (list '= c (tqf-ip (caddr x) (cadr x)))))
          ((eq? (car x) 'conjugate)
           (tqf-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-involution (cadr x))))
          ((eq? (car x) '-)
           (tqf-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-neg (cadr x))))
          (#t
           (tqf-ct! (cadr x)) (tqf-ct! (caddr x))
           (tqf-have-and! (list 'IN (cadr x) 'CC) (list 'IN (caddr x) 'CC))
           (subst (dk-cite! (if (eq? (car x) '*) 'cc-conjugate-mul 'cc-conjugate-add)
                            (cadr x) (caddr x)))))))

;;; with (IN a RR) and (0 <= a) in context: land (IN (SQRT a) RR), 0 <= SQRT(a)
;;; and SQRT(a) * SQRT(a) = a
(define (tqf-sqrt! a)
  (if (not (dk-asm? (list 'IN (list 'SQRT a) 'RR)))
      (begin
        (dk-have! (list 'AND (list 'IN a 'RR) (list '<= 0 a)))
        (dk-split! (dk-cite! 'sqrt-nonneg a))
        (dk-cite! 'sqrt-sq a))))

;;; <u,u> is real and nonnegative
(define (tqf-q-facts! u)
  (tqf-vt! u)
  (dk-cite! 'cips-ip-self-real tqf-v u)
  (dk-cite! 'cips-ip-self-nonneg tqf-v u))

;;; rewrite ||u|| * ||u|| in the goal to <u, u>
(define (tqf-norm-sq! u)
  (tqf-vt! u)
  (subst (dk-cite! 'ip-norm-unfold tqf-v u))
  (tqf-q-facts! u)
  (tqf-sqrt! (tqf-q u))
  (subst (dk-cite! 'sqrt-sq (tqf-q u))))
(define (tqf-nsq u) (list '* (list 'IP-NORM tqf-v u) (list 'IP-NORM tqf-v u)))

;;; an IFF instance used forwards: cite THM at ARGS, land its right side (split)
(define (tqf-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))

;;; an IFF instance used backwards: its right side's conjuncts are in context;
;;; land the left side and return it
(define (tqf-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))

;;; the right-nested conjunction of FS, landed from its conjuncts in context
(define (tqf-and fs)
  (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (tqf-and (cdr fs)))))
(define (tqf-have-and! . fs)
  (let ((c (tqf-and fs)))
    (dk-have! c (lambda () (dk-conj-close! dk-ass!)))
    c))

;;; type every inner product of atoms in the goal (crs wants its atoms in CC)
(define (tqf-type-ips! e)
  (cond ((not (pair? e)) #t)
        ((tqf-op? e 'IP) (tqf-ct! e))
        ((and (eq? (car e) 'conjugate) (= (length e) 2)) (tqf-ct! e))
        (#t (for-each tqf-type-ips! e))))

(define (tqf-qd p xi) (tqf-q (tqf-sub p xi)))
(define (tqf-vec-eq! a b)
  (let ((goal (list '= a b)))
    (if (not (dk-asm? goal))
        (begin
          (tqf-vt! a) (tqf-vt! b)
          (dk-have! (list '= (tqf-qd a b) 0)
            (lambda () (tqf-expand!) (tqf-type-ips! (dk-goal)) (crs)))
          (dk-cite! 'cips-eq-of-dist-sq-zero tqf-v a b)))
    goal))

;;; Q(A) = Q(B) for two expressions of one vector, by expansion
(define (tqf-q-eq! a b)
  (let ((goal (list '= (tqf-q a) (tqf-q b))))
    (if (not (dk-asm? goal))
        (begin (tqf-vt! a) (tqf-vt! b)
               (dk-have! goal (lambda () (tqf-expand!) (tqf-type-ips! (dk-goal)) (crs)))))
    goal))

;;; ---- BA-BH additions -------------------------------------------------------------------
;;; qed, or a dump of the open leaves and an error
(define (tqf-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** TQD: ") (display name) (display " did NOT close.  Open leaves:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (if tqf-keep-going? (begin (display ";TQD-UNFINISHED ") (display name) (newline) (set! *ps* #f)) (error "TQD: unfinished" name
               (map (lambda (l) (expression->string (dk-goal-of l))) (dk-open-leaves))
               (map expression->string (dk-asms-of (car (dk-open-leaves)))))))))
;;; dump the focus leaf (debugging)
(define (tqf-show! tag)
  (display "\n--- TQD ") (display tag) (display " GOAL: ") (display (expression->string (dk-goal))) (newline)
  (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline)) (dk-asms)))
;;; x in ks, ks a submodule of v: x in VEC v
(define (tqf-sub! ks x)
  (dk-cite! 'submodule-subset tqf-v ks)
  (dk-cite! 'subset-mem-fwd ks (list 'VEC tqf-v) x))
;;; c in CC => c in CARR(SCAL v)
(define (tqf-scal! c)
  (dk-cite! 'cips-scal-carrier tqf-v)
  (dk-have! (list 'IN c (list 'CARR (list 'SCAL tqf-v)))
            (lambda () (subst (list '= (list 'CARR (list 'SCAL tqf-v)) 'CC)) (ass))))

;;; ---- from ba-bh.scm parts 2-5 (prefix tqf-) -----------------------------------------------
(define tqf-w 'w)
(define (tqf-n u) (list 'IP-NORM tqf-v u))
(define (tqf-ipv a b) (list '(IP v) a b))
(define (tqf-ipw a b) (list '(IP w) a b))
(define (tqf-mul-in! u w2)
  (dk-have! (list 'AND (list 'IN u 'RR) (list 'IN w2 'RR)) (lambda () (dk-conj-close! dk-ass!)))
  (dk-cite! 'rr-mul-closed u w2))
(define (tqf-prod? t) (and (pair? t) (eq? (car t) '*) (= (length t) 3)
                           (not (number? (cadr t))) (not (number? (caddr t)))))
(define (tqf-prods e)
  (cond ((tqf-prod? e) (list e))
        ((and (pair? e) (memq (car e) '(<= < = + -))) (append-map tqf-prods (cdr e)))
        (#t '())))
(define (tqf-mul-type! p)
  (if (not (dk-asm? (list 'IN p 'RR)))
      (begin
        (if (tqf-prod? (cadr p)) (tqf-mul-type! (cadr p)))
        (if (tqf-prod? (caddr p)) (tqf-mul-type! (caddr p)))
        (dk-cite! 'rr-mul-in-rr (cadr p) (caddr p)))))
;;; (tqf-lin! TYPINGS PREMS): every product in PREMS and in the GOAL named, then dk-ineq!
(define (tqf-lin! typings prems)
  (let* ((ps (let loop ((l (append (append-map tqf-prods prems) (tqf-prods (dk-goal)))) (acc '()))
               (cond ((null? l) (reverse acc)) ((member (car l) acc) (loop (cdr l) acc))
                     (#t (loop (cdr l) (cons (car l) acc))))))
         (names (map (lambda (p)
                       (tqf-mul-type! p)
                       (cons p (dk-name! p)))
                     ps))
         (new (map (lambda (f)
                     (let loop ((f f) (ns names))
                       (cond ((null? ns) f)
                             ((dk-contains? f (caar ns)) (loop (dk-rewrite-h! f (caar ns) (cdar ns)) (cdr ns)))
                             (#t (loop f (cdr ns))))))
                   prems)))
    (for-each (lambda (n) (if (dk-contains? (dk-goal) (car n)) (subst (list '= (car n) (cdr n))))) names)
    (apply dk-ineq! (append typings (map (lambda (n) (list 'IN (cdr n) 'RR)) names) new))))
;;; the least-bound clause of opnorm-spec for T (spec split into context first)
(define (tqf-least t)
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'd_) (dk-contains? h t)
                            (dk-contains? h 'OPNORM)))
           "the least-bound clause"))
;;; the bound clause  forall x in VEC v. ||t x|| <= d ||x||
(define (tqf-ub v w t d)
  (list 'FORALL 'box_ (list 'IMPLIES (list 'IN 'box_ (list 'VEC v))
     (list '<= (list 'IP-NORM w (list t 'box_)) (list '* d (list 'IP-NORM v 'box_))))))
;;; ||x|| typed and nonnegative
(define (tqf-nt! v x) (dk-cite! 'ip-norm-in-rr v x) (dk-cite! 'ip-norm-nonneg v x))
;;; debugging: dump every open leaf (goal + context)
(define (tqf-dump! tag)
  (display "\n=== TQD DUMP ") (display tag) (newline)
  (for-each (lambda (l)
              (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
              (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                        (dk-asms-of l)))
            (dk-open-leaves)))
;;; run THUNK; on an error print the condition and dump, then re-raise
(define (tqf-try tag thunk)
  (call-with-current-continuation
    (lambda (k)
      (with-exception-handler
        (lambda (e)
          (display "\n*** TQD ERROR in ") (display tag) (display ": ")
          (display (if (condition? e) (condition/report-string e) e)) (newline)
          (tqf-dump! tag)
          (k (if tqf-keep-going? (begin (display ";TQD-SKIP ") (display tag) (newline) #f) (error "TQD stop" tag (if (condition? e) (condition/report-string e) e)
                    (if (pair? (dk-open-leaves)) (expression->string (dk-goal)) "no open leaf")))))
        thunk))))
(define tqf-keep-going? #f)

;;; ---- TH3-A2 additions ----------------------------------------------------------------------
;;; the focus goal is (= a a) / (== a a)
(define (tqf-trivial-goal?)
  (and (pair? (dk-open-leaves))
       (let ((g (dk-goal)))
         (and (pair? g) (memq (car g) '(= ==)) (= (length g) 3) (equal? (cadr g) (caddr g))))))
(define (tqf-rfl-trivial!) (if (tqf-trivial-goal?) (rfl)))

;;; ==========================================================================================
;;; (D1) DENSITY OF THE EIGENVECTORS: the closed span of the eigenspaces of a compact
;;; self-adjoint operator on a Hilbert space is the whole space (Teorema 3.1 (iii), the
;;; passage from K-perp = {0} to "H is the closure of K").  Library: operator-algebras.
;;; E is the union of the eigenspaces (TH3-A3's tqd-E, same binders, so sa-eigen-perp-zero
;;; applies literally).  "The closed span of E is H" is stated without a span constructor:
;;; EVERY submodule kk containing E is dense (sa-eigen-span-dense); equivalently its double
;;; perp is H (sa-eigen-perp-perp, through BA-G1's perp-perp-closure); and every CLOSED
;;; submodule containing E is H (sa-eigen-closed-span).
;;; ==========================================================================================

(define tqf-E '(SEP tsez_ (VEC v) (FORSOME tsec_ (AND (IN tsec_ CC) (IN tsez_ (EIGENSPACE v t_ tsec_))))))
(define tqf-PE (list 'PERP 'v tqf-E))
(define tqf-dhyps
  (list '(IS-HILBERT-SPACE v) '(IS-COMPACT-OP v v t_) '(IS-SELF-ADJOINT-OP v t_)
        '(IS-SUBMODULE v kk) (list 'SUBSET tqf-E 'kk)))

;;; sa-eigen-span-dense
(sp (make-wff (forall-guarded '(v t_ kk) tqf-dhyps '(= (CLOSURE (IP-METRIC-SPACE v) kk) (VEC v)))))
(dk-peel!)
(tqf-try "dense" (lambda ()
  (let* ((iff (dk-cite! 'hilbert-dense-iff-perp-zero 'v 'kk))
         (p0 (dk-cite! 'sa-eigen-perp-zero 'v 't_)))
    (dk-have! (caddr iff)
      (lambda ()
        (let* ((z (dk-di-var!))
               (r (tqf-iff-fwd! 'perp-membership 'v 'kk z))
               (orth (caddr r)))
          (dk-have! (list 'FORALL 'prk_ (list 'IMPLIES (list 'IN 'prk_ tqf-E) (list '= (list '(IP v) z 'prk_) 0)))
            (lambda ()
              (let ((k (dk-di-var!)))
                (dk-cite! 'subset-mem-fwd tqf-E 'kk k)
                (dk-apply! orth k)
                (dk-close-if-asm!))))
          (tqf-iff-bwd! 'perp-membership 'v tqf-E z)
          (dk-apply! p0 z)
          (dk-close-if-asm!))))
    (tqf-iff-bwd! 'hilbert-dense-iff-perp-zero 'v 'kk)
    (dk-close-if-asm!))))
(tqf-qed! 'sa-eigen-span-dense)

;;; sa-eigen-perp-perp
(sp (make-wff (forall-guarded '(v t_ kk) tqf-dhyps '(= (PERP v (PERP v kk)) (VEC v)))))
(dk-peel!)
(tqf-try "perpperp" (lambda ()
