;;; ==========================================================================================
;;; (D2) AN ORTHONORMAL BASIS OF EIGENVECTORS (Cor 3.3, without separability).
;;; Library: operator-algebras.
;;; eigenspace-submodule: N_c(T) is a submodule for T bounded, c in CC.
;;; eigen-canon-onb: the chosen orthonormal basis B_c of the inner product space N_c (CANON-ONB
;;; of SUB-CIPS(v, N_c)) is an orthonormal set of v inside N_c, complete in N_c.
;;; ==========================================================================================

(define tqf-N '(EIGENSPACE v t_ c_))
(define tqf-W (list 'SUB-CIPS 'v tqf-N))
(define tqf-B (list 'CANON-ONB tqf-W))
(define tqf-L (list 'VNB-LAMBDA 'kqe_ tqf-B 'kqe_))

;;; close a vector equation goal by expansion
(define (tqf-vec-close!)
  (let ((g (dk-goal)))
    (tqf-vec-eq! (cadr g) (caddr g))
    (dk-close-if-asm!)))
;;; land (IN z N_c) from z in VEC v and the eigen-equation proved by EQ!
(define (tqf-eig-in! c z eq!)
  (tqf-vt! z)
  (dk-have! (list '= (list 't_ z) (list '(ACT v) c z)) eq!)
  (tqf-iff-bwd! 'eigenspace-membership 'v 't_ c z))

;;; eigenspace-submodule
(sp (make-wff (forall-guarded '(v t_ c_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN t_ (BOUNDED-OPS v v)) (IN c_ CC))
  '(IS-SUBMODULE v (EIGENSPACE v t_ c_)))))
(dk-peel!)
(tqf-try "eig-sub" (lambda ()
  (dk-cite! 'bop-fun 'v 'v 't_)
  (let* ((S tqf-N)
         (iff (dk-cite! 'is-submodule 'v S))
         (mem (lambda (ld) (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) S))) ld))))
         (eig! (lambda (z) (tqf-iff-fwd! 'eigenspace-membership 'v 't_ 'c_ z) (list '= (list 't_ z) (list '(ACT v) 'c_ z)))))
    (dk-have! (caddr iff)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond
                ((dk-head-is? g 'SUBSET)
                 (let ((z (subset-by-element!)))
                   (eig! z)
                   (dk-close-if-asm!)))
                ((dk-head-is? g 'IN)
                 (dk-cite! 'cips-vzero-in 'v)
                 (tqf-eig-in! 'c_ '(VZERO v)
                   (lambda ()
                     (subst (dk-cite! 'bop-zero-value 'v 'v 't_))
                     (tqf-vec-close!)))
                 (dk-close-if-asm!))
                ((dk-contains? g '(SCAL v))
                 (let* ((ld (dk-peel!))
                        (r (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(CARR (SCAL v))))) ld)))
                        (x (car (mem ld))))
                   (dk-cite! 'cips-scal-carrier 'v)
                   (dk-rewrite-h! (list 'IN r '(CARR (SCAL v))) '(CARR (SCAL v)) 'CC)
                   (let ((ex (eig! x)))
                     (tqf-eig-in! 'c_ (cadr (dk-goal))
                       (lambda ()
                         (subst (dk-cite! 'bop-act 'v 'v 't_ r x))
                         (subst ex)
                         (tqf-vec-close!))))
                   (dk-close-if-asm!)))
                ((dk-contains? g '(VADD v))
                 (let* ((ld (dk-peel!))
                        (xs (mem ld)) (x (car xs)) (y (cadr xs)))
                   (let ((ex (eig! x)) (ey (eig! y)))
                     (tqf-eig-in! 'c_ (cadr (dk-goal))
                       (lambda ()
                         (subst (dk-cite! 'bop-add 'v 'v 't_ x y))
                         (subst ex) (subst ey)
                         (tqf-vec-close!))))
                   (dk-close-if-asm!)))
                (#t
                 (let* ((ld (dk-peel!))
                        (x (car (mem ld))))
                   (let ((ex (eig! x)))
                     (tqf-eig-in! 'c_ (cadr (dk-goal))
                       (lambda ()
                         (subst (dk-cite! 'bop-vneg 'v 'v 't_ x))
                         (subst ex)
                         (tqf-vec-close!))))
                   (dk-close-if-asm!)))))))))
    (tqf-iff-bwd! 'is-submodule 'v S)
    (dk-close-if-asm!))))
(tqf-qed! 'eigenspace-submodule)

;;; eigen-canon-onb
(define tqf-cpl
  (list 'FORALL 'tfy_ (list 'IMPLIES (list 'IN 'tfy_ tqf-N)
    (list 'IMPLIES (list 'FORALL 'tfu_ (list 'IMPLIES (list 'IN 'tfu_ tqf-B) '(= ((IP v) tfy_ tfu_) 0)))
          '(= tfy_ (VZERO v))))))
(sp (make-wff (forall-guarded '(v t_ c_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN t_ (BOUNDED-OPS v v)) (IN c_ CC))
  (list 'AND (list 'SUBSET tqf-B tqf-N) (list 'AND (list 'IS-ORTHONORMAL-SET 'v tqf-B) tqf-cpl)))))
(dk-peel!)
(tqf-try "canon-onb" (lambda ()
  (let* ((N tqf-N) (W tqf-W) (B tqf-B) (L tqf-L))
    (dk-cite! 'eigenspace-submodule 'v 't_ 'c_)
    (dk-cite! 'sub-cips-is-cips 'v N)
    (dk-cite! 'submodule-subset 'v N)
    (let* ((onb (dk-cite! 'canon-onb-is-onb W))
           (vec-eq (dk-cite! 'sub-cips-vec 'v N))
           (z-eq (dk-cite! 'sub-cips-vzero 'v N))
           (r1 (tqf-iff-fwd! 'is-orthonormal-basis W B L))
           (cplw (caddr r1))
           (r2 (tqf-iff-fwd! 'is-orthonormal-family W B L))
           (ft (cadr r2))
           (unit (cadr (caddr r2)))
           (orth (caddr (caddr r2)))
           (inB (lambda (z) (dk-cite! 'fun-apply-type-c L B (list 'VEC W) z)
                            (dk-lam-b-h! (list 'IN (list L z) (list 'VEC W)))
                            (dk-rewrite-h! (list 'IN z (list 'VEC W)) (list 'VEC W) N))))
      ;; B subset N
      (dk-have! (list 'SUBSET B N)
        (lambda () (let ((z (subset-by-element!))) (inB z) (dk-close-if-asm!))))
      (dk-cite! 'subset-trans B N '(VEC v))
      ;; orthonormal in v
      (dk-have! (list 'FORALL 'osa_ (list 'IMPLIES (list 'IN 'osa_ B) '(= ((IP v) osa_ osa_) 1)))
        (lambda ()
          (let ((z (dk-di-var!)))
            (dk-cite! 'subset-mem-fwd B N z)
            (dk-apply! unit z)
            (dk-lam-b-h! (list '= (list (list 'IP W) (list L z) (list L z)) 1))
            (let ((e (dk-cite! 'sub-cips-ip-apply 'v N z z)))
              (dk-rewrite-h! (list '= (list (list 'IP W) z z) 1) (cadr e) (caddr e)))
            (dk-close-if-asm!))))
      (dk-have! (list 'FORALL 'osa_ (list 'IMPLIES (list 'IN 'osa_ B)
                  (list 'FORALL 'osb_ (list 'IMPLIES (list 'IN 'osb_ B)
                    '(IMPLIES (NOT (= osa_ osb_)) (= ((IP v) osa_ osb_) 0))))))
        (lambda ()
          (let* ((ld (dk-peel!))
                 (zs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) B))) ld)))
                 (za (car zs)) (zb (cadr zs)))
            (if (not (dk-asm? (list 'NOT (list '= za zb)))) (di))
            (dk-cite! 'subset-mem-fwd B N za)
            (dk-cite! 'subset-mem-fwd B N zb)
            (dk-apply! orth za zb)
            (dk-lam-b-h! (list '= (list (list 'IP W) (list L za) (list L zb)) 0))
            (let ((e (dk-cite! 'sub-cips-ip-apply 'v N za zb)))
              (dk-rewrite-h! (list '= (list (list 'IP W) za zb) 0) (cadr e) (caddr e)))
            (dk-close-if-asm!))))
      (dk-have! (list 'AND (list 'SUBSET B N) (list 'AND (list 'IS-ORTHONORMAL-SET 'v B) tqf-cpl))
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond
                  ((dk-head-is? g 'IS-ORTHONORMAL-SET)
                   (tqf-iff-bwd! 'is-orthonormal-set 'v B)
                   (dk-close-if-asm!))
                  ((dk-head-is? g 'FORALL)
                   (let* ((ld (dk-peel!))
                          (y (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) N))) ld)))
                          (h (find-first (lambda (h) (dk-head-is? h 'FORALL)) ld)))
                     (dk-have! (list 'IN y (list 'VEC W)) (lambda () (subst (list '== (list 'VEC W) N)) (dk-close-if-asm!)))
                     (dk-have! (list 'FORALL 'oni_ (list 'IMPLIES (list 'IN 'oni_ B)
                                 (list '= (list (list 'IP W) y (list L 'oni_)) 0)))
                       (lambda ()
                         (let ((u (dk-di-var!)))
                           (dk-cite! 'subset-mem-fwd B N u)
                           (dk-lam-b!)
                           (subst (dk-cite! 'sub-cips-ip-apply 'v N y u))
                           (dk-apply! h u)
                           (dk-close-if-asm!))))
                     (dk-apply! cplw y)
                     (dk-rewrite-h! (list '= y (list 'VZERO W)) (list 'VZERO W) '(VZERO v))
                     (dk-close-if-asm!)))
                  (#t (dk-close-if-asm!))))))))
      (dk-close-if-asm!)))))
(tqf-qed! 'eigen-canon-onb)

;;; ==========================================================================================
;;; (D3) sa-eigen-onb: a compact self-adjoint operator on a Hilbert space has an orthonormal
;;; basis of eigenvectors, T e_i = <T e_i | e_i> e_i (Cor 3.3, any Hilbert space).
;;; The basis is O, the union over c in CC of the chosen bases B_c of the eigenspaces N_c.
;;; Completeness of O: x orthogonal to O lies in PERP(v, M), M = {a u : a in CC, u in O},
;;; which is T-invariant; a nonzero x there gives (TH3-A3's sa-has-eigenvector on the
;;; restriction, as in sa-eigen-perp-zero) an eigenvector eta /= 0 in N_c orthogonal to B_c,
;;; against the completeness of B_c in N_c (eigen-canon-onb).  No closedness of N_c is used.
;;; Library: operator-algebras.
;;; ==========================================================================================

(define (tqf-Nc c) (list 'EIGENSPACE 'v 't_ c))
(define (tqf-Bc c) (list 'CANON-ONB (list 'SUB-CIPS 'v (tqf-Nc c))))
(define tqf-O (list 'SEP 'tfoz_ '(VEC v) (list 'FORSOME 'tfoc_ (list 'AND '(IN tfoc_ CC) (list 'IN 'tfoz_ (tqf-Bc 'tfoc_))))))
(define tqf-M (list 'SEP 'tfmz_ '(VEC v)
  (list 'FORSOME 'tfma_ (list 'AND '(IN tfma_ CC)
    (list 'FORSOME 'tfmu_ (list 'AND (list 'IN 'tfmu_ tqf-O) '(= tfmz_ ((ACT v) tfma_ tfmu_))))))))
(define (tqf-unit-of s) (list 'FORALL 'osa_ (list 'IMPLIES (list 'IN 'osa_ s) '(= ((IP v) osa_ osa_) 1))))
(define (tqf-orth-of s)
  (list 'FORALL 'osa_ (list 'IMPLIES (list 'IN 'osa_ s)
    (list 'FORALL 'osb_ (list 'IMPLIES (list 'IN 'osb_ s)
      '(IMPLIES (NOT (= osa_ osb_)) (= ((IP v) osa_ osb_) 0)))))))
(define (tqf-cpl-of c)
  (list 'FORALL 'tfy_ (list 'IMPLIES (list 'IN 'tfy_ (tqf-Nc c))
    (list 'IMPLIES (list 'FORALL 'tfu_ (list 'IMPLIES (list 'IN 'tfu_ (tqf-Bc c)) '(= ((IP v) tfy_ tfu_) 0)))
          '(= tfy_ (VZERO v))))))

;;; the facts of eigen-canon-onb at c (once per branch)
(define (tqf-c-facts! c)
  (if (not (dk-asm? (tqf-unit-of (tqf-Bc c))))
      (let ((r (dk-cite! 'eigen-canon-onb 'v 't_ c)))
        (dk-split-all! (list r))
        ;; B_c is a CHOICE term: IS-ORTHONORMAL-BASIS(W_c, B_c, id) in context certifies it
        (dk-cite! 'eigenspace-submodule 'v 't_ c)
        (dk-cite! 'sub-cips-is-cips 'v (tqf-Nc c))
        (dk-cite! 'canon-onb-is-onb (list 'SUB-CIPS 'v (tqf-Nc c)))
        (tqf-iff-fwd! 'is-orthonormal-set 'v (tqf-Bc c)))))

;;; z in O in context (kept): return c with c in CC, z in B_c, z in N_c, T z = c z, <z|z> = 1
(define (tqf-O-open! z)
  (dk-project! (list 'IN z '(VEC v)) (lambda () (sep-me (list 'IN z tqf-O))))
  (let* ((ex (dk-project! (list 'FORSOME 'tfoc_ (list 'AND '(IN tfoc_ CC) (list 'IN z (tqf-Bc 'tfoc_))))
                          (lambda () (sep-me (list 'IN z tqf-O)))))
         (c (dk-skolem! ex #t)))
    (tqf-c-facts! c)
    (dk-cite! 'subset-mem-fwd (tqf-Bc c) (tqf-Nc c) z)
    (if (not (dk-asm? (list '= (list 't_ z) (list '(ACT v) c z))))
        (tqf-iff-fwd! 'eigenspace-membership 'v 't_ c z))
    (dk-apply! (tqf-unit-of (tqf-Bc c)) z)
    c))

;;; with (= ((IP v) z z) 1) in context: land (NOT (= z (VZERO v)))
(define (tqf-nz! z)
  (let ((g (list 'NOT (list '= z '(VZERO v)))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (di)
            (dk-cite! 'cips-vzero-in 'v)
            (dk-rewrite-h! (list '= (list '(IP v) z z) 1) z '(VZERO v))
            (dk-cite! 'cips-ip-zero-left 'v '(VZERO v))
            (dk-cite! 'cips-ip-self-real 'v '(VZERO v))
            (let ((q '((IP v) (VZERO v) (VZERO v))))
              (dk-absurd! (list '= q 0) (list '= q 1) (list 'IN q 'RR))))))
    g))

;;; z in M in context (consumed, so call it inside a lane or where z in M is not needed):
;;; return (a u) with a in CC, u in O, z = a u
(define (tqf-M-open! z)
  (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN z tqf-M)))))
  (let* ((ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'tfma_) (memq z (free-vars h)))) "the M witness"))
         (a (dk-skolem! ex #t))
         (ex2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'tfmu_) (memq z (free-vars h)))) "the M vector"))
         (u (dk-skolem! ex2 #t)))
    (list a u)))

;;; sa-eigen-onb
(sp (make-wff (forall-guarded '(v t_)
  '((IS-HILBERT-SPACE v) (IS-COMPACT-OP v v t_) (IS-SELF-ADJOINT-OP v t_))
  '(FORSOME tfix_ (FORSOME tfe_ (AND (IS-ORTHONORMAL-BASIS v tfix_ tfe_)
     (FORALL tfi_ (IMPLIES (IN tfi_ tfix_)
       (= (t_ (tfe_ tfi_)) ((ACT v) ((IP v) (t_ (tfe_ tfi_)) (tfe_ tfi_)) (tfe_ tfi_)))))))))))
(dk-peel!)
(tqf-try "eigen-onb" (lambda ()
  (let* ((O tqf-O) (M tqf-M))
    (tqf-iff-fwd! 'is-hilbert-space 'v)
    (tqf-iff-fwd! 'is-self-adjoint-op 'v 't_)
    (dk-cite! 'bop-fun 'v 'v 't_)
    ;; (1) O is an orthonormal set
    (dk-have! (list 'SUBSET O '(VEC v))
      (lambda () (let ((z (subset-by-element!))) (sep-me (list 'IN z O)) (dk-close-if-asm!))))
    (dk-have! (tqf-unit-of O)
      (lambda () (let ((z (dk-di-var!))) (tqf-O-open! z) (dk-close-if-asm!))))
    (dk-have! (tqf-orth-of O)
      (lambda ()
        (let* ((ld (dk-peel!))
               (zs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) O))) ld)))
               (a (car zs)) (b (cadr zs)))
          (if (not (dk-asm? (list 'NOT (list '= a b)))) (di))
          (let* ((ca (tqf-O-open! a)) (cb (tqf-O-open! b)))
            (use-em (list '= ca cb)
              (lambda ()
                (dk-rewrite-h! (list 'IN b (tqf-Bc cb)) cb ca)
                (dk-apply! (tqf-orth-of (tqf-Bc ca)) a b)
                (dk-close-if-asm!))
              (lambda ()
                (tqf-nz! b)
                (dk-cite! 'sa-eigenvalue-real 'v 't_ cb b)
                (dk-cite! 'sa-eigenvectors-orthogonal 'v 't_ ca cb a b)
                (dk-close-if-asm!)))))))
    (tqf-iff-bwd! 'is-orthonormal-set 'v O)
    ;; (2) O is complete
    (let ((cplO (list 'FORALL 'onx_ (list 'IMPLIES '(IN onx_ (VEC v))
                  (list 'IMPLIES (list 'FORALL 'onu_ (list 'IMPLIES (list 'IN 'onu_ O) '(= ((IP v) onx_ onu_) 0)))
                        '(= onx_ (VZERO v)))))))
      (dk-have! cplO
        (lambda ()
          (let* ((ld (dk-peel!))
                 (x (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(VEC v)))) ld)))
                 (hx (find-first (lambda (h) (dk-head-is? h 'FORALL)) ld))
                 (pvs (list 'PERP 'v M))
                 (svs (list 'SUB-CIPS 'v pvs))
                 (rt (list 'RESTRICT 't_ pvs)))
            ;; M is a subset of VEC v, invariant under t
            (dk-have! (list 'SUBSET M '(VEC v))
              (lambda () (let ((z (subset-by-element!))) (sep-me (list 'IN z M)) (dk-close-if-asm!))))
            (dk-have! (list 'FORALL 'tsbx_ (list 'IMPLIES (list 'IN 'tsbx_ M) (list 'IN '(t_ tsbx_) M)))
              (lambda ()
                (let* ((z (dk-di-var!))
                       (au (tqf-M-open! z)) (a (car au)) (u (cadr au))
                       (c (tqf-O-open! u)))
                  (dk-cite! 'cips-act-type 'v a u)
                  (dk-have! (list 'IN (list 't_ z) '(VEC v))
                    (lambda () (subst (list '= z (list '(ACT v) a u))) (tqf-vt! (cadr (dk-goal))) (dk-close-if-asm!)))
                  (in-sep! (lambda () (dk-close-if-asm!))
                           (lambda ()
                             (tqf-ct! (list '* a c))
                             (witness! (list '* a c)
                               (lambda ()
                                 (dk-conj-close!
                                   (lambda ()
                                     (if (dk-asm? (dk-goal)) (ass)
                                         (witness! u
                                           (lambda ()
                                             (dk-conj-close!
                                               (lambda ()
                                                 (if (dk-asm? (dk-goal)) (ass)
                                                     (begin
                                                       (subst (list '= z (list '(ACT v) a u)))
                                                       (subst (dk-cite! 'bop-act 'v 'v 't_ a u))
                                                       (subst (list '= (list 't_ u) (list '(ACT v) c u)))
                                                       (tqf-vec-close!)))))))))))))))))
            ;; x is in PERP(v, M)
            (dk-have! (list 'FORALL 'prk_ (list 'IMPLIES (list 'IN 'prk_ M) (list '= (list '(IP v) x 'prk_) 0)))
              (lambda ()
                (let* ((z (dk-di-var!))
                       (au (tqf-M-open! z)) (a (car au)) (u (cadr au)))
                  (dk-project! (list 'IN u '(VEC v)) (lambda () (sep-me (list 'IN u O))))
                  (subst (list '= z (list '(ACT v) a u)))
                  (subst (dk-cite! 'cips-ip-conj-homog-right 'v a x u))
                  (subst (dk-apply! hx u))
                  (tqf-type-ips! (dk-goal))
                  (dk-cite! 'cc-conjugate-closed a)
                  (crs))))
            (tqf-iff-bwd! 'perp-membership 'v M x)
            ;; the restriction to PERP(v, M)
            (dk-cite! 'sa-perp-invariant 'v M 't_)
            (dk-cite! 'perp-is-submodule 'v M)
            (dk-cite! 'perp-is-closed 'v M)
            (dk-cite! 'sub-cips-is-cips 'v pvs)
            (dk-cite! 'sub-cips-restrict-compact 'v pvs 't_)
            (dk-cite! 'sub-cips-perp-self-adjoint 'v M 't_)
            (let* ((vec-eq (dk-cite! 'sub-cips-vec 'v pvs))
                   (z-eq (dk-cite! 'sub-cips-vzero 'v pvs)))
              (pbc)
              (let ((nz (dk-pick (lambda (h) (and (dk-head-is? h 'NOT) (dk-contains? h x) (dk-contains? h 'VZERO))) "the negated goal")))
                (dk-have! (list 'IN x (list 'VEC svs)) (lambda () (subst (list '= (list 'VEC svs) pvs)) (dk-close-if-asm!)))
                (dk-have! (list 'NOT (list '= x (list 'VZERO svs))) (lambda () (subst (list '= (list 'VZERO svs) '(VZERO v))) (dk-close-if-asm!)))
                (let* ((c (dk-skolem! (dk-cite! 'sa-has-eigenvector svs rt x))))
                  (tqf-iff-fwd! 'is-eigenvalue svs rt c)
                  (let* ((ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'EIGENSPACE) (dk-contains? h rt))) "the eigenvector"))
                         (eta (dk-skolem! ex))
                         (ne (list 'NOT (list '= eta (list 'VZERO svs)))))
                    (tqf-iff-fwd! 'eigenspace-membership svs rt c eta)
                    (let* ((inP (dk-rewrite-h! (list 'IN eta (list 'VEC svs)) (list 'VEC svs) pvs))
                           (eq0 (list '= (list rt eta) (list (list 'ACT svs) c eta)))
                           (r1 (dk-cite! 'restrict-apply 't_ pvs eta))
                           (e2 (dk-rewrite-h! eq0 (cadr r1) (caddr r1)))
                           (a1 (dk-cite! 'sub-cips-act-apply 'v pvs c eta))
                           (e3 (dk-rewrite-h! e2 (cadr a1) (caddr a1)))
                           (ne2 (dk-rewrite-h! ne (list 'VZERO svs) '(VZERO v))))
                      (tqf-iff-fwd! 'perp-membership 'v M eta)
                      (tqf-iff-bwd! 'eigenspace-membership 'v 't_ c eta)
                      (tqf-c-facts! c)
                      (dk-have! (list 'FORALL 'tfu_ (list 'IMPLIES (list 'IN 'tfu_ (tqf-Bc c)) (list '= (list '(IP v) eta 'tfu_) 0)))
                        (lambda ()
                          (let ((u (dk-di-var!)))
                            (dk-cite! 'subset-mem-fwd (tqf-Bc c) (tqf-Nc c) u)
                            (tqf-iff-fwd! 'eigenspace-membership 'v 't_ c u)
                            (dk-have! (list 'IN u O)
                              (lambda () (in-sep! (lambda () (dk-close-if-asm!))
                                                  (lambda () (witness! c (lambda () (dk-conj-close! dk-ass!)))))))
                            (dk-have! (list 'IN u M)
                              (lambda ()
                                (in-sep! (lambda () (dk-close-if-asm!))
                                         (lambda ()
                                           (tqf-ct! 1)
                                           (witness! 1
                                             (lambda ()
                                               (dk-conj-close!
                                                 (lambda ()
                                                   (if (dk-asm? (dk-goal)) (ass)
                                                       (witness! u
                                                         (lambda ()
                                                           (dk-conj-close!
                                                             (lambda ()
                                                               (if (dk-asm? (dk-goal)) (ass) (tqf-vec-close!)))))))))))))))
                            (dk-cite! 'perp-orth 'v M eta u)
                            (dk-close-if-asm!))))
                      (dk-apply! (tqf-cpl-of c) eta)
                      (ai ne2))))))))))
    ;; (3) the basis, and the eigen-equation
    (let ((onb (dk-cite! 'onb-of-complete-orthonormal-set 'v O)))
      (witness! O
        (lambda ()
          (witness! (caddr (cdr onb))
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal)) (ass)
                      (let ((i (dk-di-var!)))
                        (dk-lam-b!)
                        (let ((c (tqf-O-open! i)))
                          (subst (list '= (list 't_ i) (list '(ACT v) c i)))
                          (subst (dk-cite! 'cips-ip-homog-left 'v c i i))
                          (subst (list '= (list '(IP v) i i) 1))
                          (tqf-vec-close!))))))))))))))
(tqf-qed! 'sa-eigen-onb)

;;; ==========================================================================================
;;; (D4) A BOUNDED OPERATOR CARRIES AN UNORDERED SUM TO AN UNORDERED SUM, and the
;;; eigen-expansion  T x = sum_i lam_i <x | e_i> e_i  for an orthonormal basis of eigenvectors.
;;; Library: operator-algebras.
;;; bop-hom-ag: T is a homomorphism of the additive groups of v and w.
;;; bop-sums-to: SUMS-TO(v, f, r) gives SUMS-TO(w, T o f, T r) (hom-ag-finsum on each finite
;;;   partial sum, then ||T r - T S|| <= ||T|| ||r - S||, rr-scale-eps for the epsilon).
;;; op-eigen-expansion: T e_i = lam_i e_i for an ONB (ix, e) gives, for every x,
;;;   T x = sum_i (lam_i <x | e_i>) e_i  (SUMS-TO in IP-NORMED-AG v): onb-expansion + bop-sums-to.
;;; ==========================================================================================

(define (tqf-G v) (list 'IP-NORMED-AG v))
(define (tqf-AG v) (list 'NORMED-AG-AS-ABELIAN-GROUP (list 'IP-NORMED-AG v)))

;;; (== (ACC (VIEW G)) (ACC G)): the view read-off (TH3-A3's tqd-slot-close!)
(define (tqf-slot-close! view acc)
  (mac view)
  (let loop ((n 0))
    (let ((g (dk-goal)))
      (if (and (< n 8) (not (equal? (cadr g) (caddr g))))
          (begin (quietly (lambda () (slot acc)))
                 (quietly (lambda () (nth-r)))
                 (if (not (equal? (dk-goal) g)) (loop (+ n 1)))))))
  (qrfl))
(define (tqf-view-eq! acc g val src-eq)
  (let* ((vg (list 'NORMED-AG-AS-ABELIAN-GROUP g))
         (e1 (list '== (list acc vg) (list acc g)))
         (claim (list '== (list acc vg) val)))
    (if (not (dk-asm? claim))
        (begin
          (if (not (dk-asm? e1)) (dk-have! e1 (lambda () (tqf-slot-close! 'NORMED-AG-AS-ABELIAN-GROUP acc))))
          (dk-have! claim (lambda () (subst e1) (subst src-eq) (dk-close-if! (lambda () #t) (lambda () (qrfl)))))))
    claim))
;;; the vector group of v and its read-offs
(define (tqf-ag-setup! v)
  (let ((h (tqf-G v)))
    (dk-cite! 'ip-normed-ag-is-normed-ag v)
    (dk-cite! 'normed-ag-as-abelian-group-is-abelian-group h)
    (tqf-view-eq! 'CARR h (list 'VEC v)  (dk-cite! 'ip-normed-ag-carrier v))
    (tqf-view-eq! 'OPR  h (list 'VADD v) (dk-cite! 'ip-normed-ag-opr v))
    (let ((ide (list '== (list 'IDEN h) (list 'VZERO v))))
      (if (not (dk-asm? ide))
          (dk-have! ide (lambda () (mac 'IP-NORMED-AG) (slot 'IDEN) (nth-r) (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
      (tqf-view-eq! 'IDEN h (list 'VZERO v) ide))
    (tqf-view-eq! 'INV  h (list 'VNEG v) (dk-cite! 'ip-normed-ag-inv v))))

;;; bop-hom-ag
(sp (make-wff (forall-guarded '(v w t_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN t_ (BOUNDED-OPS v w)))
  (list 'IS-HOM-ABELIAN-GROUP (tqf-AG 'v) (tqf-AG 'w) 't_))))
(dk-peel!)
(tqf-try "bop-hom" (lambda ()
  (tqf-ag-setup! 'v)
  (tqf-ag-setup! 'w)
  (dk-cite! 'bop-fun 'v 'w 't_)
  (let* ((VG (tqf-AG 'v)) (WG (tqf-AG 'w))
         (iff (dk-cite! 'is-hom-abelian-group-def VG WG 't_))
         (vv! (lambda (x) (dk-rewrite-h! (list 'IN x (list 'CARR VG)) (list 'CARR VG) '(VEC v)))))
    (dk-have! (caddr iff)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond
                ((dk-head-is? g 'IS-ABELIAN-GROUP) (dk-close-if-asm!))
                ((dk-head-is? g 'IN)
                 (subst (list '== (list 'CARR VG) '(VEC v)))
                 (subst (list '== (list 'CARR WG) '(VEC w)))
                 (dk-close-if-asm!))
                ((dk-head-is? g '=)
                 (subst (list '== (list 'IDEN VG) '(VZERO v)))
                 (subst (list '== (list 'IDEN WG) '(VZERO w)))
                 (dk-cite! 'bop-zero-value 'v 'w 't_)
                 (dk-close-if-asm!))
                ((dk-contains? g (list 'OPR VG))
                 (let* ((lk (dk-peel!))
                        (xs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (list 'CARR VG)))) lk))))
                   (for-each vv! xs)
                   (subst (list '== (list 'OPR VG) '(VADD v)))
                   (subst (list '== (list 'OPR WG) '(VADD w)))
                   (dk-cite! 'bop-add 'v 'w 't_ (car xs) (cadr xs))
                   (dk-close-if-asm!)))
                (#t
                 (let* ((lk (dk-peel!))
                        (x (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (list 'CARR VG)))) lk))))
                   (vv! x)
                   (subst (list '== (list 'INV VG) '(VNEG v)))
                   (subst (list '== (list 'INV WG) '(VNEG w)))
                   (dk-cite! 'bop-vneg 'v 'w 't_ x)
                   (dk-close-if-asm!)))))))))
    (tqf-iff-bwd! 'is-hom-abelian-group-def VG WG 't_)
    (dk-close-if-asm!))))
(tqf-qed! 'bop-hom-ag)

;;; land (IN f (FUN D)), (= (DOM f) D) from (IN f (FUN D C)), D in SET in context
(define (tqf-dom! f d c)
  (dk-project! (list 'IN f (list 'FUN d)) 'fun-codomain-iff (list 'IN f (list 'FUN d c)))
  (dk-have-and! (list 'IN f (list 'FUN d)) (list 'IN d 'SET))
  (let ((r (dk-cite! 'dom-of-fun d f)))
    (if (and (pair? r) (eq? (car r) 'AND)) (dk-split-all! (list r))))
  (list '= (list 'DOM f) d))

;;; bop-sums-to
(define tqf-gfam '(VNB-LAMBDA tfk_ ix (t_ (fam_ tfk_))))
(sp (make-wff (forall-guarded '(v w t_ ix fam_ r_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN t_ (BOUNDED-OPS v w))
    (IN ix SET) (IN fam_ (FUN ix (VEC v))) (IN r_ (VEC v)) (SUMS-TO (IP-NORMED-AG v) fam_ r_))
  (list 'SUMS-TO '(IP-NORMED-AG w) tqf-gfam '(t_ r_)))))
(dk-peel!)
(tqf-try "bop-sums" (lambda ()
  (let* ((G1 (tqf-G 'v)) (G2 (tqf-G 'w)) (A1 (tqf-AG 'v)) (A2 (tqf-AG 'w))
         (g tqf-gfam)
         (nT '(OPNORM v w t_)))
    (tqf-ag-setup! 'v)
    (tqf-ag-setup! 'w)
    (dk-cite! 'bop-fun 'v 'w 't_)
    (dk-cite! 'bop-hom-ag 'v 'w 't_)
    (dk-cite! 'opnorm-in-rr 'v 'w 't_)
    (dk-cite! 'opnorm-nonneg 'v 'w 't_)
    (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) 'r_)
    (dk-have! (list 'IN g '(FUN ix (VEC w)))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((k (dk-di-var!)))
              (dk-cite! 'fun-apply-type-c 'fam_ 'ix '(VEC v) k)
              (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) (list 'fam_ k))
              (dk-close-if-asm!)))
          (lambda () (dk-close-if-asm!)))))
    (let* ((df (tqf-dom! 'fam_ 'ix '(VEC v)))
           (dg (tqf-dom! g 'ix '(VEC w)))
           (r1 (tqf-iff-fwd! 'sums-to G1 'fam_ 'r_))
           (iff (dk-cite! 'sums-to G2 g '(t_ r_))))
      (dk-have! (caddr iff)
        (lambda ()
          (let* ((lk (dk-peel!))
                 (eps (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) lk)))
                 (d (dk-halve! eps))
                 (sc (dk-skolem! (dk-cite! 'rr-scale-eps nT d) #t))
                 (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq sc (free-vars f)))) "the scale clause"))
                 (fin (dk-skolem! (dk-apply! r1 sc) #t))
                 (tail (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (memq fin (free-vars f)))) "the tail")))
            (dk-rewrite-h! (list 'SUBSET fin '(DOM fam_)) '(DOM fam_) 'ix)
            (witness! fin
              (lambda ()
                (dk-conj-close!
                  (lambda ()
                    (cond
                      ((dk-asm? (dk-goal)) (ass))
                      ((dk-head-is? (dk-goal) 'SUBSET)
                       (subst dg) (dk-close-if-asm!))
                      (#t
                       (let* ((lk2 (dk-peel!))
                              (hc (find-first (lambda (f) (dk-head-is? f 'AND)) lk2))
                              (parts (if hc (dk-split-all! (list hc)) lk2))
                              (ext (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'SET))) parts)))
                              (s1 (list 'FINSUM A1 'fam_ ext))
                              (s2 (list 'FINSUM A2 g ext)))
                         (dk-rewrite-h! (list 'SUBSET ext (list 'DOM g)) (list 'DOM g) 'ix)
                         (dk-rewrite-h! (list 'SUBSET ext 'ix) 'ix '(DOM fam_))
                         (tqf-have-and! (list 'IN ext 'SET) (list 'IN (list 'CARD ext) 'NN)
                                        (list 'SUBSET fin ext) (list 'SUBSET ext '(DOM fam_)))
                         (let ((bnd (dk-apply! tail ext)))
                           ;; the partial sums: S1 in VEC v, T S1 = S2
                           (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z ext) (list 'IN '(fam_ z) (list 'CARR A1))))
                             (lambda ()
                               (let ((z (dk-di-var!)))
                                 (dk-cite! 'subset-mem-fwd ext 'ix z)
                                 (dk-cite! 'fun-apply-type-c 'fam_ 'ix '(VEC v) z)
                                 (subst (list '== (list 'CARR A1) '(VEC v)))
                                 (dk-close-if-asm!))))
                           (dk-cite! 'finsum-type-ptwise A1 ext 'fam_)
                           (dk-rewrite-h! (list 'IN s1 (list 'CARR A1)) (list 'CARR A1) '(VEC v))
                           (dk-have! (list 'FORALL 'tqdz_ (list 'IMPLIES (list 'IN 'tqdz_ ext) (list 'IN '(fam_ tqdz_) (list 'CARR A1))))
                             (lambda ()
                               (let ((z (dk-di-var!)))
                                 (dk-cite! 'subset-mem-fwd ext 'ix z)
                                 (dk-cite! 'fun-apply-type-c 'fam_ 'ix '(VEC v) z)
                                 (subst (list '== (list 'CARR A1) '(VEC v)))
                                 (dk-close-if-asm!))))
                           (dk-have! (list 'FORALL 'tqdz_ (list 'IMPLIES (list 'IN 'tqdz_ ext) (list '= (list g 'tqdz_) '(t_ (fam_ tqdz_)))))
                             (lambda ()
                               (let ((z (dk-di-var!)))
                                 (dk-cite! 'subset-mem-fwd ext 'ix z)
                                 (dk-cite! 'fun-apply-type-c 'fam_ 'ix '(VEC v) z)
                                 (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) (list 'fam_ z))
                                 (dk-close-if! (lambda () (dk-lam-b!)) (lambda () (rfl))))))
                           (let* ((hs (dk-cite! 'hom-ag-finsum A1 A2 't_ ext 'fam_ g))
                                  (xd (list '(VADD v) 'r_ (list '(VNEG v) s1))))
                             ;; the bound, in v's terms
                             (let* ((b1 (dk-rewrite-h! bnd (list 'OPR G1) '(VADD v)))
                                    (b2 (dk-rewrite-h! b1 (list 'INV G1) '(VNEG v))))
                               (tqf-vt! xd)
                               (let* ((nv (dk-cite! 'ip-normed-ag-norm-value 'v xd))
                                      (b3 (dk-rewrite-h! b2 (cadr nv) (caddr nv))))
                                 ;; the goal, in w's terms
                                 (subst (list '== (list 'OPR G2) '(VADD w)))
                                 (subst (list '== (list 'INV G2) '(VNEG w)))
                                 (let* ((yd (cadr (cadr (dk-goal)))))
                                   (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) s1)
                                   (dk-rewrite-h! (list 'IN (list 't_ s1) '(VEC w)) (list 't_ s1) s2)
                                   (dk-cite! 'cips-vneg-type 'w s2)
                                   (fluid-let ((tqf-v (quote w))) (tqf-vt! yd))
                                   (subst (dk-cite! 'ip-normed-ag-norm-value 'w yd))
                                   ;; T xd = T r - S2
                                   (dk-cite! 'cips-vneg-type 'v s1)
                                   (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) s1)
                                   (let* ((e1 (dk-cite! 'bop-add 'v 'w 't_ 'r_ (list '(VNEG v) s1)))
                                          (e2 (dk-cite! 'bop-vneg 'v 'w 't_ s1)))
                                     (dk-have! (list '= (list 't_ xd) yd)
                                       (lambda ()
                                         (subst e1) (subst e2) (subst hs)
                                         (dk-close-if! (lambda () #t) (lambda () (rfl)))))
                                     (subst (list '= yd (list 't_ xd)))
                                     (let* ((nx (list 'IP-NORM 'v xd))
                                            (ob (dk-apply! (dk-cite! 'opnorm-bound 'v 'w 't_) xd)))
                                       (dk-cite! 'ip-norm-in-rr 'v xd)
                                       (dk-cite! 'ip-norm-nonneg 'v xd)
                                       (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) xd)
                                       (dk-cite! 'ip-norm-in-rr 'w (list 't_ xd))
                                       (dk-cite! 'rr-pos-rr-in-rr sc)
                                       (dk-have! (list '<= nx sc) (lambda () (dk-ineq! b3)))
                                       (let ((s3 (dk-apply! cl nx)))
                                         (dk-cite! 'rr-pos-rr-in-rr eps)
                                         (tqf-lin! (list (list 'IN (list 'IP-NORM 'w (list 't_ xd)) 'RR) (list 'IN d 'RR) (list 'IN eps 'RR))
                                                   (list ob s3 (list '= (list '+ d d) eps) (list '< 0 d)))))))))))))))))))))
      (tqf-iff-bwd! 'sums-to G2 g '(t_ r_))
      (dk-close-if-asm!)))))
(tqf-qed! 'bop-sums-to)

;;; ==========================================================================================
;;; (D5) THE EIGEN-EXPANSION.  Library: operator-algebras.
;;; op-eigen-expansion: (ix, e) an orthonormal basis of the Hilbert space v, T bounded with
;;;   T e_i = lam_i e_i: for every x, T x = sum_i (lam_i <x | e_i>) e_i, unordered, in norm.
;;; ==========================================================================================

(define tqf-xfam '(VNB-LAMBDA onk_ ix ((ACT v) (* (lm onk_) ((IP v) x (e onk_))) (e onk_))))

;;; op-eigen-expansion
(sp (make-wff (forall-guarded '(v t_ ix e lm)
  '((IS-HILBERT-SPACE v) (IN t_ (BOUNDED-OPS v v)) (IS-ORTHONORMAL-BASIS v ix e) (IN lm (FUN ix CC))
    (FORALL tfi_ (IMPLIES (IN tfi_ ix) (= (t_ (e tfi_)) ((ACT v) (lm tfi_) (e tfi_))))))
  (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC v)) (list 'SUMS-TO '(IP-NORMED-AG v) tqf-xfam '(t_ x)))))))
(dk-peel!)
(tqf-try "expansion" (lambda ()
  (let* ((goal (dk-goal))
         (x (cadr (cadddr goal)))
         (L2 (caddr goal))
         (eig (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'lm) (dk-contains? h 't_))) "the eigen-equations"))
         (cf (list 'VNB-LAMBDA 'onk_ 'ix (list '(ACT v) (list '(IP v) x '(e onk_)) '(e onk_))))
         (L1 (list 'VNB-LAMBDA 'tfk_ 'ix (list 't_ (list cf 'tfk_)))))
    (tqf-iff-fwd! 'is-hilbert-space 'v)
    (dk-project! '(IS-ORTHONORMAL-FAMILY v ix e) 'is-orthonormal-basis '(IS-ORTHONORMAL-BASIS v ix e))
    (dk-project! '(IN e (FUN ix (VEC v))) 'is-orthonormal-family '(IS-ORTHONORMAL-FAMILY v ix e))
    (dk-cite! 'fun-domain-in-set 'ix '(VEC v) 'e)
    (dk-cite! 'bop-fun 'v 'v 't_)
    (let ((ek! (lambda (k)
                 (dk-cite! 'fun-apply-type-c 'e 'ix '(VEC v) k)
                 (dk-cite! 'fun-apply-type-c 'lm 'ix 'CC k)
                 (tqf-ct! (list '(IP v) x (list 'e k))))))
      (dk-cite! 'onb-expansion 'v 'ix 'e x)
      (dk-have! (list 'IN cf '(FUN ix (VEC v)))
        (lambda ()
          (dk-lam-type!
            (lambda () (let ((k (dk-di-var!))) (ek! k) (tqf-vt! (cadr (dk-goal))) (dk-close-if-asm!)))
            (lambda () (dk-close-if-asm!)))))
      (let ((st (dk-cite! 'bop-sums-to 'v 'v 't_ 'ix cf x)))
        (dk-fun-ext! L1 L2 'ix '(VEC v)
          (lambda ()
            (dk-lam-type!
              (lambda () (let ((k (dk-di-var!))) (ek! k) (dk-lam-b!) (tqf-vt! (cadr (dk-goal))) (dk-close-if-asm!)))
              (lambda () (dk-close-if-asm!))))
          (lambda ()
            (dk-lam-type!
              (lambda () (let ((k (dk-di-var!))) (ek! k) (tqf-vt! (cadr (dk-goal))) (dk-close-if-asm!)))
              (lambda () (dk-close-if-asm!))))
          (lambda (k)
            (ek! k)
            (dk-lam-b!)
            (tqf-vt! (list '(ACT v) (list '(IP v) x (list 'e k)) (list 'e k)))
            (subst (dk-cite! 'bop-act 'v 'v 't_ (list '(IP v) x (list 'e k)) (list 'e k)))
            (subst (dk-apply! eig k))
            (tqf-vec-close!)))
        (dk-rewrite-h! st L1 L2)
        (dk-close-if-asm!))))))
(tqf-qed! 'op-eigen-expansion)

;;; ==========================================================================================
;;; (D6) THE NONZERO EIGENVALUES (Teorema 3.1 (i), (iv)).
;;; ord-nn-in-segment-of-infinite: an ordinal outside NN has every natural number below it.
;;; infinite-set-nn-injection: an infinite set receives an injective sequence (Zermelo's
;;;   bijection onto ORD-SEGMENT(CARD s), inverted, restricted to NN).
;;; ip-unit-norm-one: <x|x> = 1 gives ||x|| = 1.
;;; compact-eigen-large-finite: for an orthonormal family of eigenvectors of a compact T, the
;;;   indices whose eigenvalue has modulus >= d (d > 0) form a FINITE set (lambda_k -> 0).
;;; compact-eigen-nonzero-countable: the indices with nonzero eigenvalue form a COUNTABLE set.
;;; ==========================================================================================

;;; ord-nn-in-segment-of-infinite
(sp (make-wff '(FORALL oal_ (IMPLIES (IN oal_ ORD) (IMPLIES (NOT (IN oal_ NN))
                 (FORALL onn_ (IMPLIES (IN onn_ NN) (IN onn_ (ORD-SEGMENT oal_)))))))))
(dk-peel!)
(tqf-try "seg" (lambda ()
  (let* ((g (dk-goal)) (n (cadr g)) (a (cadr (caddr g)))
         (na (list 'NOT (list 'IN a 'NN)))
         (bad! (lambda (eqn)
                 (dk-rewrite-h! (list 'IN n 'NN) n a)
                 (ai na))))
    (dk-cite! 'nn-subset-ord n)
    (dk-have-and! (list 'IN n 'ORD) (list 'IN a 'ORD))
    (let ((tot (dk-cite! 'ord-le-total n a))
          (ne1 (list 'NOT (list '= n a)))
          (ne2 (list 'NOT (list '= a n))))
      (dk-have! ne1 (lambda () (di) (bad! (list '= n a))))
      (dk-have! ne2 (lambda () (di) (bad! (list '= a n))))
      (dk-or-each! tot
        (lambda (h)
          (if (equal? h (list 'ORD-LE n a))
              (begin
                (dk-have-and! h ne1)
                (tqf-iff-bwd! 'ord-lt-iff n a)
                (tqf-iff-bwd! 'ord-segment-membership a n)
                (dk-close-if-asm!))
              (begin
                (dk-have-and! h ne2)
                (tqf-iff-bwd! 'ord-lt-iff a n)
                (tqf-iff-bwd! 'ord-segment-membership n a)
                (dk-cite! 'ord-segment-nn-subset n a)
                (ai na)))))))))
(tqf-qed! 'ord-nn-in-segment-of-infinite)

;;; infinite-set-nn-injection
(sp (make-wff '(FORALL ins_ (IMPLIES (IN ins_ SET) (IMPLIES (NOT (IN (CARD ins_) NN))
  (FORSOME ing_ (AND (IN ing_ (FUN NN ins_))
    (FORALL ina_ (IMPLIES (IN ina_ NN) (FORALL inb_ (IMPLIES (IN inb_ NN)
      (IMPLIES (= (ing_ ina_) (ing_ inb_)) (= ina_ inb_)))))))))))))
(dk-peel!)
(tqf-try "inj" (lambda ()
  (let* ((s 'ins_)
         (seg (list 'ORD-SEGMENT (list 'CARD s)))
         (ph (dk-skolem! (dk-cite! 'card-zermelo s) #t))
         (psi (list 'INVERSE-BIJ ph s seg))
         (L (list 'VNB-LAMBDA 'tfgk_ 'NN (list psi 'tfgk_))))
    (dk-cite! 'inverse-bij-in-fun s seg ph)
    (dk-cite! 'inverse-bij-is-bijection s seg ph)
    (let ((inseg (dk-cite! 'ord-nn-in-segment-of-infinite (list 'CARD s))))
      (if (not (dk-asm? '(IN NN SET))) (fact 'nn-is-set))
      (witness! L
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'IN)
                  (dk-lam-type!
                    (lambda () (let ((k (dk-di-var!)))
                                 (dk-apply! inseg k)
                                 (dk-cite! 'fun-apply-type-c psi seg s k)
                                 (dk-close-if-asm!)))
                    (lambda () (dk-close-if-asm!)))
                  (let* ((ld (dk-peel!))
                         (ks (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) ld)))
                         (ka (car ks)) (kb (cadr ks))
                         (eqh (find-first (lambda (h) (dk-head-is? h '=)) ld)))
                    (dk-lam-b-h! eqh)
                    (dk-apply! inseg ka)
                    (dk-apply! inseg kb)
                    (dk-cite! 'bijection-injective seg s psi ka kb)
                    (dk-close-if-asm!)))))))))))
(tqf-qed! 'infinite-set-nn-injection)

;;; ip-unit-norm-one
