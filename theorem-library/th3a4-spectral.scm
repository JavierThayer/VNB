;;; ==========================================================================================
;;; (D7) sa-eigen-expansion: THE SPECTRAL THEOREM FOR A COMPACT SELF-ADJOINT OPERATOR in the
;;; form Mercer and Karhunen-Loeve use (Teorema 3.1 with Cor 3.3).  On a Hilbert space v there
;;; are an orthonormal basis (ix, e) and eigenvalues lm : ix -> CC with
;;;   * lm_i real (lm_i = conj lm_i) and T e_i = lm_i e_i;
;;;   * T x = sum_i (lm_i <x|e_i>) e_i for every x (unordered sum, in norm);
;;;   * for every d > 0 only finitely many i have |lm_i| >= d (lm_i -> 0);
;;;   * the i with lm_i /= 0 form a countable set.
;;; Library: operator-algebras.
;;; ==========================================================================================

(define tqf-xfam7 '(VNB-LAMBDA onk_ tfix_ ((ACT v) (* (tflm_ onk_) ((IP v) x (tfe_ onk_))) (tfe_ onk_))))
(sp (make-wff (forall-guarded '(v t_)
  '((IS-HILBERT-SPACE v) (IS-COMPACT-OP v v t_) (IS-SELF-ADJOINT-OP v t_))
  (list 'FORSOME 'tfix_ (list 'FORSOME 'tfe_ (list 'FORSOME 'tflm_
    (list 'AND '(IS-ORTHONORMAL-BASIS v tfix_ tfe_)
    (list 'AND '(IN tflm_ (FUN tfix_ CC))
    (list 'AND '(FORALL tfi_ (IMPLIES (IN tfi_ tfix_)
                   (AND (= (tflm_ tfi_) (conjugate (tflm_ tfi_))) (= (t_ (tfe_ tfi_)) ((ACT v) (tflm_ tfi_) (tfe_ tfi_))))))
    (list 'AND (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC v)) (list 'SUMS-TO '(IP-NORMED-AG v) tqf-xfam7 '(t_ x))))
    (list 'AND '(FORALL tfd_ (IMPLIES (POS-RR tfd_)
                   (IN (CARD (SEP tflz_ tfix_ (<= tfd_ (magnitude (tflm_ tflz_))))) NN)))
               '(IS-COUNTABLE (SEP tflz_ tfix_ (NOT (= (tflm_ tflz_) 0)))))))))))))))
(dk-peel!)
(tqf-try "sa-expansion" (lambda ()
  (tqf-iff-fwd! 'is-hilbert-space 'v)
  (tqf-iff-fwd! 'is-self-adjoint-op 'v 't_)
  (dk-cite! 'bop-fun 'v 'v 't_)
  (let* ((ex (dk-cite! 'sa-eigen-onb 'v 't_))
         (ix (dk-skolem! ex #t))
         (ex2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'tfe_))) "the basis"))
         (e (dk-skolem! ex2 #t))
         (eigh (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (memq e (free-vars h)) (dk-contains? h '(IP v)))) "the eigen-equations"))
         (L (list 'VNB-LAMBDA 'tflk_ ix (list '(IP v) (list 't_ (list e 'tflk_)) (list e 'tflk_))))
         (fam (dk-project! (list 'IS-ORTHONORMAL-FAMILY 'v ix e) 'is-orthonormal-basis (list 'IS-ORTHONORMAL-BASIS 'v ix e)))
         (r (tqf-iff-fwd! 'is-orthonormal-family 'v ix e))
         (unit (cadr (caddr r)))
         (ek! (lambda (k)
                (dk-cite! 'fun-apply-type-c e ix '(VEC v) k)
                (tqf-vt! (list 't_ (list e k)))
                (tqf-ct! (list '(IP v) (list 't_ (list e k)) (list e k))))))
    (dk-cite! 'fun-domain-in-set ix '(VEC v) e)
    (dk-have! (list 'IN L (list 'FUN ix 'CC))
      (lambda ()
        (dk-lam-type!
          (lambda () (let ((k (dk-di-var!))) (ek! k) (dk-close-if-asm!)))
          (lambda () (dk-close-if-asm!)))))
    (let ((eigL (list 'FORALL 'tfi_ (list 'IMPLIES (list 'IN 'tfi_ ix)
                  (list '= (list 't_ (list e 'tfi_)) (list '(ACT v) (list L 'tfi_) (list e 'tfi_)))))))
      (dk-have! eigL
        (lambda ()
          (let ((k (dk-di-var!)))
            (ek! k)
            (dk-lam-b!)
            (dk-apply! eigh k)
            (dk-close-if-asm!))))
      (dk-cite! 'op-eigen-expansion 'v 't_ ix e L)
      (dk-cite! 'compact-eigen-nonzero-countable 'v 't_ ix e L)
      (dk-have! (list 'FORALL 'tfd_ (list 'IMPLIES '(POS-RR tfd_)
                  (list 'IN (list 'CARD (list 'SEP 'tflz_ ix (list '<= 'tfd_ (list 'magnitude (list L 'tflz_))))) 'NN)))
        (lambda ()
          (let* ((ld (dk-peel!))
                 (d (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) ld))))
            (dk-cite! 'compact-eigen-large-finite 'v 't_ ix e L d)
            (dk-close-if-asm!))))
      (dk-have! (list 'FORALL 'tfi_ (list 'IMPLIES (list 'IN 'tfi_ ix)
                  (list 'AND (list '= (list L 'tfi_) (list 'conjugate (list L 'tfi_)))
                             (list '= (list 't_ (list e 'tfi_)) (list '(ACT v) (list L 'tfi_) (list e 'tfi_))))))
        (lambda ()
          (let* ((k (dk-di-var!)) (ek (list e k)))
            (ek! k)
            (dk-apply! eigL k)
            (dk-apply! unit k)
            (dk-have! (list 'IN (list L k) 'CC) (lambda () (dk-lam-b!) (dk-close-if-asm!)))
            (tqf-nz! ek)
            (dk-cite! 'sa-eigenvalue-real 'v 't_ (list L k) ek)
            (dk-conj-close! (lambda () (dk-close-if-asm!))))))
      (witness! ix
        (lambda ()
          (witness! e
            (lambda ()
              (witness! L
                (lambda ()
                  (dk-conj-close! (lambda () (dk-close-if-asm!)))))))))))))
(tqf-qed! 'sa-eigen-expansion)

;;; ==========================================================================================
;;; (D8) eigenspace-onb-finite: for T compact and c /= 0 the chosen orthonormal basis B_c of
;;; the eigenspace N_c is FINITE (Teorema 3.1 (ii): dim N_c < infinity for c /= 0).  B_c, as a
;;; family indexed by itself, is an orthonormal family of eigenvectors all with eigenvalue c,
;;; so compact-eigen-large-finite at d = |c| bounds it.  Library: operator-algebras.
;;; ==========================================================================================

;;; with z in CC and NOT (z = 0) in context: land (POS-RR (magnitude z)); return the magnitude
(define (tqf-mag-pos! z)
  (let ((mg (list 'magnitude z)))
    (if (not (dk-asm? (list 'POS-RR mg)))
        (begin
          (dk-cite! 'cc-magnitude-closed z)
          (dk-cite! 'cc-magnitude-nonneg z)
          (let ((zi (dk-cite! 'cc-magnitude-zero-iff z)))
            (dk-have! (list 'NOT (list '= 0 mg))
              (lambda ()
                (di)
                (dk-have! (list '= mg 0) (lambda () (subst (list '= mg 0)) (dk-close-if! (lambda () #t) (lambda () (rfl)))))
                (dk-iff-fwd! zi)
                (ai (list 'NOT (list '= z 0))))))
          (tqf-iff-bwd! 'pos-rr mg)))
    mg))

(sp (make-wff (forall-guarded '(v t_ c_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPACT-OP v v t_) (IN c_ CC) (NOT (= c_ 0)))
  (list 'IN (list 'CARD (tqf-Bc 'c_)) 'NN))))
(dk-peel!)
(tqf-try "eigen-finite" (lambda ()
  (let* ((B (tqf-Bc 'c_)) (N (tqf-Nc 'c_))
         (I (list 'VNB-LAMBDA 'tfqe_ B 'tfqe_))
         (LM (list 'VNB-LAMBDA 'tfqe_ B 'c_)))
    (dk-cite! 'compact-op-bounded 'v 'v 't_)
    (dk-cite! 'bop-fun 'v 'v 't_)
    (tqf-c-facts! 'c_)
    (let* ((unit (tqf-unit-of B)) (orth (tqf-orth-of B))
           (inB! (lambda (z)
                   (dk-cite! 'subset-mem-fwd B N z)
                   (if (not (dk-asm? (list 'IN z '(VEC v))))
                       (dk-cite! 'subset-mem-fwd N '(VEC v) z)))))
      (dk-cite! 'submodule-subset 'v N)
      (dk-have! (list 'IN I (list 'FUN B '(VEC v)))
        (lambda ()
          (dk-lam-type!
            (lambda () (let ((k (dk-di-var!))) (inB! k) (dk-close-if-asm!)))
            (lambda () (dk-have! (list 'SUBSET B '(VEC v)) (lambda () (let ((z (subset-by-element!))) (inB! z) (dk-close-if-asm!))))
                       (dk-cite! 'cips-vec-set 'v)
                       (dk-cite! 'subclass-of-set-is-set B '(VEC v))
                       (dk-close-if-asm!)))))
      (dk-cite! 'fun-domain-in-set B '(VEC v) I)
      (dk-have! (list 'IN LM (list 'FUN B 'CC))
        (lambda ()
          (dk-lam-type!
            (lambda () (dk-di-var!) (dk-close-if-asm!))
            (lambda () (dk-close-if-asm!)))))
      ;; the orthonormal family (B, id)
      (dk-have! (list 'FORALL 'oni_ (list 'IMPLIES (list 'IN 'oni_ B) (list '= (list '(IP v) (list I 'oni_) (list I 'oni_)) 1)))
        (lambda ()
          (let ((k (dk-di-var!)))
            (dk-lam-b!)
            (dk-apply! unit k)
            (dk-close-if-asm!))))
      (dk-have! (list 'FORALL 'oni_ (list 'IMPLIES (list 'IN 'oni_ B) (list 'FORALL 'onj_ (list 'IMPLIES (list 'IN 'onj_ B)
                  (list 'IMPLIES '(NOT (= oni_ onj_)) (list '= (list '(IP v) (list I 'oni_) (list I 'onj_)) 0))))))
        (lambda ()
          (let* ((ld (dk-peel!))
                 (zs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) B))) ld)))
                 (za (car zs)) (zb (cadr zs)))
            (if (not (dk-asm? (list 'NOT (list '= za zb)))) (di))
            (dk-lam-b!)
            (dk-apply! orth za zb)
            (dk-close-if-asm!))))
      (tqf-iff-bwd! 'is-orthonormal-family 'v B I)
      ;; the eigen-equations
      (dk-have! (list 'FORALL 'tfi_ (list 'IMPLIES (list 'IN 'tfi_ B)
                  (list '= (list 't_ (list I 'tfi_)) (list '(ACT v) (list LM 'tfi_) (list I 'tfi_)))))
        (lambda ()
          (let ((k (dk-di-var!)))
            (inB! k)
            (dk-lam-b!)
            (tqf-iff-fwd! 'eigenspace-membership 'v 't_ 'c_ k)
            (dk-close-if-asm!))))
      (let* ((d (tqf-mag-pos! 'c_))
             (S (list 'SEP 'tflz_ B (list '<= d (list 'magnitude (list LM 'tflz_))))))
        (dk-cite! 'compact-eigen-large-finite 'v 't_ B I LM d)
        (dk-have! (list 'IN S 'SET) (lambda () (sep-set) (dk-close-if-asm!)))
        (dk-have-and! (list 'IN S 'SET) (list 'IN (list 'CARD S) 'NN))
        (let ((cs (dk-cite! 'card-subset-nn S)))
          (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z B) (list 'IN 'z S)))
            (lambda ()
              (let ((z (dk-di-var!)))
                (in-sep! (lambda () (dk-close-if-asm!))
                         (lambda ()
                           (dk-lam-b!)
                           (dk-cite! 'cc-magnitude-closed 'c_)
                           (dk-ineq!))))))
          (dk-have-and! (list 'IN B 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z B) (list 'IN 'z S))))
          (dk-apply! cs B)
          (dk-close-if-asm!)))))))
(tqf-qed! 'eigenspace-onb-finite)
