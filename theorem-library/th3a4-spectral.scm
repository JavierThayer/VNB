    (if (not (dk-asm? '(IN NN SET))) (fact 'nn-is-set))
    (pbc)
    (let* ((g (dk-skolem! (dk-cite! 'infinite-set-nn-injection S) #t))
           (inj (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'ina_))) "injectivity"))
           (E2 (list 'VNB-LAMBDA 'tfsk_ 'NN (list 'e (list g 'tfsk_))))
           (LM2 (list 'VNB-LAMBDA 'tfsk_ 'NN (list 'lm (list g 'tfsk_))))
           (gk! (lambda (k)
                  (let ((gk (list g k)))
                    (if (not (dk-asm? (list 'IN gk 'ix)))
                        (begin
                          (dk-cite! 'fun-apply-type-c g 'NN S k)
                          (dk-sep-parts! (list 'IN gk S))
                          (dk-cite! 'fun-apply-type-c 'e 'ix '(VEC v) gk)
                          (dk-cite! 'fun-apply-type-c 'lm 'ix 'CC gk)))
                    gk)))
           (typ! (lambda (body)
                   (lambda ()
                     (dk-lam-type!
                       (lambda () (let ((k (dk-di-var!))) (gk! k) (dk-close-if-asm!)))
                       (lambda () (dk-close-if-asm!)))))))
      (dk-have! (list 'IN E2 '(FUN NN (VEC v))) (typ! 'e))
      (dk-have! (list 'IN LM2 '(FUN NN CC)) (typ! 'lm))
      (dk-have! (list 'FORALL 'un_ (list 'IMPLIES '(IN un_ NN) (list '= (list 'IP-NORM 'v (list E2 'un_)) 1)))
        (lambda ()
          (let* ((k (dk-di-var!)) (gk (gk! k)))
            (dk-lam-b!)
            (dk-apply! unit gk)
            (dk-cite! 'ip-unit-norm-one 'v (list 'e gk))
            (dk-close-if-asm!))))
      (dk-have! (list 'FORALL 'oi_ (list 'IMPLIES '(IN oi_ NN) (list 'FORALL 'oj_ (list 'IMPLIES '(IN oj_ NN)
                  (list 'IMPLIES '(< oi_ oj_) (list '= (list '(IP v) (list E2 'oi_) (list E2 'oj_)) 0))))))
        (lambda ()
          (let* ((ld (dk-peel!))
                 (lt (find-first (lambda (h) (dk-head-is? h '<)) ld))
                 (i (cadr lt)) (j (caddr lt))
                 (gi (gk! i)) (gj (gk! j)))
            (dk-lam-b!)
            (dk-cite! 'nn-in-rr i)
            (dk-cite! 'nn-in-rr j)
            (dk-ne! i j lt)
            (dk-have! (list 'NOT (list '= gi gj))
              (lambda ()
                (di)
                (dk-apply! inj i j)
                (ai (list 'NOT (list '= i j)))))
            (dk-apply! orth gi gj)
            (dk-close-if-asm!))))
      (dk-have! (list 'FORALL 'en_ (list 'IMPLIES '(IN en_ NN)
                  (list '= (list 't_ (list E2 'en_)) (list '(ACT v) (list LM2 'en_) (list E2 'en_)))))
        (lambda ()
          (let* ((k (dk-di-var!)) (gk (gk! k)))
            (dk-lam-b!)
            (dk-apply! eig gk)
            (dk-close-if-asm!))))
      (dk-have! (list 'FORALL 'ln_ (list 'IMPLIES '(IN ln_ NN) (list '<= 'tfd_ (list 'magnitude (list LM2 'ln_)))))
        (lambda ()
          (let* ((k (dk-di-var!)) (gk (gk! k)))
            (dk-lam-b!)
            (dk-close-if-asm!))))
      (dk-cite! 'compact-op-eigen-not-separated 'v 't_ E2 LM2 'tfd_)
      (dk-close-if-asm!)))))
(tqf-qed! 'compact-eigen-large-finite)

