;;; compact-eigen-large-finite
(define tqf-ehyps
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPACT-OP v v t_) (IS-ORTHONORMAL-FAMILY v ix e) (IN lm (FUN ix CC))
    (FORALL tfi_ (IMPLIES (IN tfi_ ix) (= (t_ (e tfi_)) ((ACT v) (lm tfi_) (e tfi_)))))))
