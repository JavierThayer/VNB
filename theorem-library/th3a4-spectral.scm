(tqf-qed! 'sa-eigen-perp-perp)

;;; sa-eigen-closed-span: a CLOSED submodule containing every eigenvector is the whole space
(sp (make-wff (forall-guarded '(v t_ kk) (append tqf-dhyps '((IS-CLOSED (IP-METRIC-SPACE v) kk))) '(= kk (VEC v)))))
