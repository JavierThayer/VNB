;;; family-nn-enum.scm -- agent BA-1117-TRACE (round 2), 2026-11-17.
;;; The support of an absolutely summable family is enumerated by a subset of NN, and the family
;;; transported along the enumeration (zero off it) is an NN-indexed family with the same unordered sum
;;; and a convergent series with that sum (finding F2 of BA-1117-TRACE-REPORT.md).
;;; Helpers nne- are copies of esum-cartesian.scm's tb3- helpers (helpers do not cross file environments).
;;; Nothing asserted.
(define (nne-open?)
  (let ((leaf (or *dk-lane-leaf* (proof-state-focus *ps*))))
    (not (sequent-node-grounded? leaf))))
(define (nne-have! f th) (dk-have! f (dk-lane th)))
(define (nne-and! . ps)
  (let ((f (let build ((l ps)) (if (null? (cdr l)) (car l) (list 'AND (car l) (build (cdr l)))))))
    (if (not (dk-asm? f)) (nne-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (nne-cite! thm . args)
  (let loop ((r (apply dk-cite! thm args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (if (dk-asm? (caddr r))
            (loop (caddr r))
            (loop (dk-landed-1 (lambda () (detach! r)))))
        r)))
(define (nne-close!)
  (cond ((not (nne-open?)) #t)
        ((dk-asm? (dk-goal)) (ass))
        ((dk-head-is? (dk-goal) '==) (qrfl))
        ((and (dk-head-is? (dk-goal) '=) (dk-asm? (list '= (caddr (dk-goal)) (cadr (dk-goal)))))
         (subst (list '= (caddr (dk-goal)) (cadr (dk-goal)))) (if (nne-open?) (rfl)))
        (#t (rfl))))
(define (nne-ctx f)
  (or (dk-ctx-form f) (error "nne-ctx: not in context" (expression->string f))))
(define (nne-ap! f a b x) (if (not (dk-asm? (list 'IN (list f x) b))) (fact 'fun-apply-type-c f a b x)))
(define (nne-try tag thunk)
  (with-exception-handler
    (lambda (e)
      (let ((asms (dk-asms)))
        (error (string-append "NNE-TRY " tag ": "
                              (if (condition? e) (condition/report-string e) "non-condition"))
               (list 'GOAL (expression->string (dk-goal)))
               (list 'N (length asms) 'W (map expression->string (filter (lambda (a) (string-search-forward "tbz_" (expression->string a) 0)) asms))))))
    thunk))
(define (nne-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; tb3: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l) (display ";;   ") (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'analysis))
;;; shared helpers for the product sums
;;; ====================================================================
(define nne-m 'RR-POS-STAR-ADD-MONOID)
(define (nne-fs f s) (list 'FINSUM nne-m f s))
;;; f in FUN(dd, cod) in context: land (IN dd SET), (= (DOM f) dd), f in FUN(DOM f, cod)
(define (nne-dom! f dd cod)
  (if (not (dk-asm? (list 'IN dd 'SET))) (fact 'fun-domain-in-set dd cod f))
  (if (not (dk-asm? (list '= (list 'DOM f) dd)))
      (begin
        (dk-project! (list 'IN f (list 'FUN dd)) 'fun-codomain-iff (list 'IN f (list 'FUN dd cod)))
        (nne-and! (list 'IN f (list 'FUN dd)) (list 'IN dd 'SET))
        (fact 'dom-of-fun dd f)
        (let ((x (dk-ctx-form (list 'AND (list 'IN (list 'DOM f) 'SET) (list '= (list 'DOM f) dd)))))
          (if x (dk-split-all! (list x))))))
  (if (not (dk-asm? (list 'IN f (list 'FUN (list 'DOM f) cod))))
      (nne-have! (list 'IN f (list 'FUN (list 'DOM f) cod))
        (lambda () (subst (list '= (list 'DOM f) dd)) (ass))))
  (if (and (eq? cod 'RR-POS-STAR) (not (dk-asm? (list 'IN (list 'ESUM f) 'RR-POS-STAR))))
      (fact 'esum-in f)))
(define (nne-bound f b)
  (let ((v (if (memq 'tbs_ (free-vars (list 'AND f b))) 'tbt_ 'tbs_)))
    (list 'FORALL v (list 'IMPLIES (list 'AND (list 'IN v 'SET) (list 'AND (list 'IN (list 'CARD v) 'NN) (list 'SUBSET v (list 'DOM f))))
                             (list '<= (nne-fs f v) b)))))
(define (nne-peel-set! f dd)
  (dk-peel!)
  (dk-split-all!)
  (let ((sv (cadddr (cadr (dk-goal)))))
    (if (and (not (dk-asm? (list 'SUBSET sv dd))) (dk-asm? (list 'SUBSET sv (list 'DOM f))))
        (dk-rewrite-h! (list 'SUBSET sv (list 'DOM f)) (list 'DOM f) dd))
    sv))
(define (nne-sub! s d)          ; (SUBSET s d) from (nne-subs s d)
  (if (not (dk-asm? (list 'SUBSET s d)))
      (nne-have! (list 'SUBSET s d) (lambda () (mac 'subset-def) (nne-close!)))))
(define (nne-partial! f dd sv)
  (if (and (not (dk-asm? (list 'SUBSET sv dd))) (dk-asm? (nne-subs sv dd))) (nne-sub! sv dd))
  (if (not (dk-asm? (list 'SUBSET sv (list 'DOM f))))
      (nne-have! (list 'SUBSET sv (list 'DOM f)) (lambda () (subst (list '= (list 'DOM f) dd)) (ass))))
  (nne-and! (list 'IN sv 'SET) (list 'IN (list 'CARD sv) 'NN) (list 'SUBSET sv (list 'DOM f)))
  (if (not (dk-asm? (list 'IN (nne-fs f sv) 'RR-POS-STAR))) (nne-cite! 'esum-partial-sum-type f sv))
  (if (not (dk-asm? (list '<= (nne-fs f sv) (list 'ESUM f)))) (nne-cite! 'esum-upper f sv)))
(define (nne-trans! x y z)
  (if (not (dk-asm? (list '<= x z)))
      (begin
        (nne-and! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR) (list 'IN z 'RR-POS-STAR))
        (nne-and! (list '<= x y) (list '<= y z))
        (fact 'rr-pos-star-le-trans x y z)))
  (list '<= x z))
;;; forall z_ in s. (phi z_) in cod
(define (nne-maps phi s cod) (list 'FORALL 'tbz_ (list 'IMPLIES (list 'IN 'tbz_ s) (list 'IN (list phi 'tbz_) cod))))
(define (nne-subs s d) (list 'FORALL 'tbz_ (list 'IMPLIES (list 'IN 'tbz_ s) (list 'IN 'tbz_ d))))
;;; prove (nne-maps phi s cod) from s subset dd (as nne-subs or SUBSET) and phi in FUN(dd, cod)
(define (nne-maps-sub! phi s dd cod)
  (let ((cl (nne-maps phi s cod)))
    (if (not (dk-asm? cl))
        (nne-have! cl
          (lambda ()
            (let ((z (dk-di-var!)))
              (if (dk-asm? (list 'SUBSET s dd)) (fact 'subset-mem-fwd s dd z) (dk-apply! (nne-ctx (nne-subs s dd)) z))
              (nne-ap! phi dd cod z)
              (nne-close!)))))
    cl))
;;; with (IN s SET), (IN (CARD s) NN) and (nne-maps phi s cod) in context: the image is a finite
;;; set, phi maps s into it, and it lies inside cod.  Returns the image.
(define (nne-img! phi s cod)
  (let* ((img (list 'IMAGE phi s))
         (maps (nne-ctx (nne-maps phi s cod)))
         (into (nne-maps phi s img))
         (sub (nne-subs img cod)))
    (if (not (dk-asm? (list 'IN img 'SET))) (fact 'image-set phi s))
    (if (not (dk-asm? (list 'IN (list 'CARD img) 'NN))) (fact 'card-image-finite phi s))
    (if (not (dk-asm? into))
        (nne-have! into
          (lambda ()
            (let ((z (dk-di-var!)))
              (dk-apply! maps z)
              (fact 'membership-implies-sethood (list phi z) cod)
              (mac 'image-membership-iff)
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'FORSOME)
                      (begin (ew z) (dk-conj-close! nne-close!))
                      (nne-close!))))))))
    (if (not (dk-asm? sub))
        (nne-have! sub
          (lambda ()
            (let* ((z (dk-di-var!))
                   (ex (car (dk-landed (lambda () (mac-h 'image-membership-iff (list 'IN z img))))))
                   (x (dk-skolem! ex)))
              (subst (list '= z (list phi x)))
              (dk-apply! maps x)
              (nne-close!)))))
    img))
;;; (IN (SEP ..) SET)
(define (nne-sep-set! sp)
  (if (not (dk-asm? (list 'IN sp 'SET)))
      (nne-have! (list 'IN sp 'SET)
        (lambda () (for-each (lambda (l) (dk-focus! l) (nne-close!)) (dk-opened (lambda () (sep-set))))))))
;;; a SEP over a finite set s: it is a finite set inside s
(define (nne-sep-fin! sp s)
  (nne-sep-set! sp)
  (let ((sub (nne-subs sp s)))
    (if (not (dk-asm? sub))
        (nne-have! sub (lambda () (let ((z (dk-di-var!))) (sep-me (list 'IN z sp)) (dk-split-all!) (nne-close!)))))
    (if (not (dk-asm? (list 'IN (list 'CARD sp) 'NN)))
        (begin
          (nne-and! (list 'IN s 'SET) (list 'IN (list 'CARD s) 'NN))
          (nne-and! (list 'IN sp 'SET) sub)
          (nne-cite! 'card-subset-nn s sp)))))
(define (nne-rps-carr!)
  (if (not (dk-asm? (list '== (list 'CARR nne-m) 'RR-POS-STAR))) (dk-cite! 'rr-pos-star-add-monoid@carr))
  (if (not (dk-asm? (list 'IS-COMM-MONOID nne-m))) (fact 'rr-pos-star-is-comm-monoid)))


;;; s subset d (as SUBSET or nne-subs) in context: land z in d
(define (nne-in-sub! s d z)
  (if (not (dk-asm? (list 'IN z d)))
      (if (dk-asm? (list 'SUBSET s d)) (fact 'subset-mem-fwd s d z) (dk-apply! (nne-ctx (nne-subs s d)) z))))
(define nne-inj-J '(FORALL x_ (IMPLIES (IN x_ J) (FORALL y_ (IMPLIES (IN y_ J) (IMPLIES (= (ph x_) (ph y_)) (= x_ y_)))))))
(define nne-maps-J '(FORALL nej_ (IMPLIES (IN nej_ J) (IN (ph nej_) ix))))
(define nne-heq-J '(FORALL x_ (IMPLIES (IN x_ J) (= (h x_) (g (ph x_))))))

;;; ====================================================================
;;; esum-inj-le: an injective reindexing does not increase an unordered sum in [0, +inf]
;;; ====================================================================
(sp (make-wff (list 'FORALL 'J (list 'FORALL 'ix (list 'FORALL 'ph (list 'FORALL 'g (list 'FORALL 'h
  (list 'IMPLIES nne-maps-J (list 'IMPLIES nne-inj-J
    (list 'IMPLIES '(IN g (FUN ix RR-POS-STAR)) (list 'IMPLIES '(IN h (FUN J RR-POS-STAR))
      (list 'IMPLIES nne-heq-J '(<= (ESUM h) (ESUM g))))))))))))))
(dk-peel!)
(nne-rps-carr!)
(nne-dom! 'h 'J 'RR-POS-STAR)
(nne-dom! 'g 'ix 'RR-POS-STAR)
(let ((eg '(ESUM g)) (maps (nne-ctx nne-maps-J)) (inj (nne-ctx nne-inj-J)) (heq (nne-ctx nne-heq-J)))
  (nne-have! (nne-bound 'h eg)
    (lambda ()
      (let ((sv (nne-peel-set! 'h 'J)))
        (nne-have! (nne-maps 'ph sv 'ix)
          (lambda () (let ((z (dk-di-var!))) (nne-in-sub! sv 'J z) (dk-apply! maps z) (nne-close!))))
        (let ((img (nne-img! 'ph sv 'ix)))
          (nne-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ sv) '(IN (ph x_) SET)))
            (lambda () (let ((z (dk-di-var!))) (nne-in-sub! sv 'J z) (dk-apply! maps z)
                         (fact 'membership-implies-sethood (list 'ph z) 'ix) (nne-close!))))
          (nne-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ sv) (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ sv)
                       '(IMPLIES (= (ph x_) (ph y_)) (= x_ y_))))))
            (lambda ()
              (dk-peel!)
              (let* ((g0 (dk-goal)) (x (cadr g0)) (y (caddr g0)))
                (nne-in-sub! sv 'J x) (nne-in-sub! sv 'J y)
                (dk-apply! inj x y)
                (nne-close!))))
          (nne-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ img) (list 'IN '(g z_) (list 'CARR nne-m))))
            (lambda ()
              (subst (list '= (list 'CARR nne-m) 'RR-POS-STAR))
              (let ((z (dk-di-var!)))
                (nne-in-sub! img 'ix z)
                (nne-ap! 'g 'ix 'RR-POS-STAR z)
                (nne-close!))))
          (nne-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ sv) '(= (h x_) (g (ph x_)))))
            (lambda () (let ((z (dk-di-var!))) (nne-in-sub! sv 'J z) (dk-apply! heq z) (nne-close!))))
          (let ((l1 (nne-cite! 'finsum-cm-image-inj nne-m sv 'ph 'g 'h)))
            (nne-partial! 'g 'ix img)
            (subst l1)
            (nne-close!))))))
  (nne-and! (list 'IN eg 'RR-POS-STAR) (nne-bound 'h eg))
  (nne-cite! 'esum-least 'h eg)
  (nne-close!))
(nne-done! 'esum-inj-le)

;;; ====================================================================
;;; esum-superlevel-finite: a finite unordered sum has finite superlevel sets {g >= d}, d > 0
;;; ====================================================================
(sp (make-wff (list 'FORALL 'ix (list 'FORALL 'g
  (list 'IMPLIES '(IN g (FUN ix RR-POS-STAR)) (list 'IMPLIES '(IN (ESUM g) RR)
    '(FORALL d (IMPLIES (POS-RR d) (IN (CARD (SEP nex_ ix (<= d (g nex_)))) NN)))))))))
(dk-peel!)
(nne-rps-carr!)
(nne-dom! 'g 'ix 'RR-POS-STAR)
(let* ((gl (dk-goal)) (S (cadr (cadr gl))) (d (cadr (cadddr S))))
  (dk-pos-parts! d)
  (fact 'rmc-rps-of-nonneg d)
  (nne-sep-set! S)
  (use-em (list 'IN (list 'CARD S) 'NN)
    (lambda () (ass))
    (lambda ()
      (let* ((ex (nne-cite! 'infinite-set-nn-injection S))
             (ing (dk-skolem! ex)))
        (dk-split-all!)
        (let* ((injh (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q ing) (dk-contains? q 'ina_))) "injectivity"))
               (h (list 'VNB-LAMBDA 'nek_ 'NN (list 'g (list ing 'nek_))))
               (c (list 'VNB-LAMBDA 'nek_ 'NN d))
               (in-S! (lambda (k)        ; ing k in S, in ix, d <= g(ing k), g(ing k) in RPS
                        (nne-ap! ing 'NN S k)
                        (sep-me (list 'IN (list ing k) S))
                        (dk-split-all!)
                        (nne-ap! 'g 'ix 'RR-POS-STAR (list ing k)))))
          (nne-have! (list 'IN h '(FUN NN RR-POS-STAR))
            (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (in-S! k) (nne-close!)))
                                     (lambda () (fact 'nn-is-set) (nne-close!)))))
          (nne-have! (list 'IN c '(FUN NN RR-POS-STAR))
            (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (nne-close!)))
                                     (lambda () (fact 'nn-is-set) (nne-close!)))))
          (nne-have! (list 'FORALL 'nej_ (list 'IMPLIES '(IN nej_ NN) (list 'IN (list ing 'nej_) 'ix)))
            (lambda () (let ((k (dk-di-var!))) (in-S! k) (nne-close!))))
          (nne-have! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ NN) (list 'FORALL 'y_ (list 'IMPLIES '(IN y_ NN)
                       (list 'IMPLIES (list '= (list ing 'x_) (list ing 'y_)) '(= x_ y_))))))
            (lambda () (dk-peel!) (let* ((g0 (dk-goal))) (dk-apply! injh (cadr g0) (caddr g0)) (nne-close!))))
          (nne-have! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ NN) (list '= (list h 'x_) (list 'g (list ing 'x_)))))
            (lambda () (let ((k (dk-di-var!))) (in-S! k) (dk-lam-b!) (nne-close!))))
          (nne-cite! 'esum-inj-le 'NN 'ix ing 'g h)
          (nne-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ NN) (list '<= (list c 'z_) (list h 'z_))))
            (lambda () (let ((k (dk-di-var!))) (in-S! k) (dk-lam-b!) (nne-close!))))
          (nne-cite! 'esum-le-ptwise 'NN c h)
          (nne-dom! c 'NN 'RR-POS-STAR) (nne-dom! h 'NN 'RR-POS-STAR)
          (nne-trans! (list 'ESUM c) (list 'ESUM h) '(ESUM g))
          (nne-cite! 'rps-below-real-is-real (list 'ESUM c) '(ESUM g))
          (nne-have! (list 'FORALL 'mvk_ (list 'IMPLIES '(IN mvk_ NN) (list '= (list c 'mvk_) d)))
            (lambda () (let ((k (dk-di-var!))) (dk-lam-b!) (nne-close!))))
          (let ((r (nne-cite! 'esum-constant-positive-not-finite c d)))
            (if (dk-only! (list 'IN (list 'ESUM c) 'RR) r) (prop))))))))
(nne-done! 'esum-superlevel-finite)

;;; ====================================================================
;;; esum-support-enum: the support {g > 0} of a finite unordered sum is the bijective image of a
;;; subset of NN (an initial segment when it is finite, NN itself when it is not)
;;; ====================================================================
(define nne-P '(SEP nex_ ix (< 0 (g nex_))))
(define nne-enum-concl
  (list 'FORSOME 'nem_ (list 'FORSOME 'neph_
    (list 'AND '(IN nem_ SET) (list 'AND '(FORALL nen_ (IMPLIES (IN nen_ nem_) (IN nen_ NN)))
      (list 'IN 'neph_ (list 'BIJECTION 'nem_ nne-P)))))))
(sp (make-wff (list 'FORALL 'ix (list 'FORALL 'g
  (list 'IMPLIES '(IN g (FUN ix RR)) (list 'IMPLIES '(IN g (FUN ix RR-POS-STAR)) (list 'IMPLIES '(IN (ESUM g) RR)
    nne-enum-concl)))))))
(dk-peel!)
(fact 'fun-domain-in-set 'ix 'RR 'g)
(nne-cite! 'esum-superlevel-finite 'ix 'g)
(let ((o (nne-cite! 'srt-superlevel-sort 'ix 'g)))
  (dk-or-each! o
    (lambda (dj)
      (dk-split-all! (list dj))
      (let* ((ex (dk-pick (lambda (q) (dk-head-is? q 'FORSOME)) "the sorted enumeration"))
             (ph (dk-skolem! ex)))
        (dk-split-all!)
        (let* ((bij (dk-pick (lambda (q) (and (dk-head-is? q 'IN) (eq? (cadr q) ph))) "the bijection"))
               (M (cadr (caddr bij))))
          (if (equal? M 'NN)
              (fact 'nn-is-set)
              (let ((n (cadr M)))
                (fact 'nn-subset-ord n)
                (fact 'ord-segment-is-set n)))
          (ew M) (ew ph)
          (dk-conj-close!
            (lambda ()
              (cond ((not (nne-open?)) #t)
                    ((dk-asm? (dk-goal)) (ass))
                    ((dk-head-is? (dk-goal) 'FORALL)
                     (let ((k (dk-di-var!)))
                       (if (not (equal? M 'NN)) (fact 'ord-segment-nn-subset (cadr M) k))
                       (nne-close!)))
                    (#t (nne-close!))))))))))
(nne-done! 'esum-support-enum)

;;; ====================================================================
;;; finsum-ag-pad-ptwise: padding a finite sum with zeros (abelian group, pointwise typing);
;;; the abelian-group twin of finsum-cm-pad-ptwise
;;; ====================================================================
(sp (make-wff (list 'FORALL 'ag (list 'IMPLIES '(IS-ABELIAN-GROUP ag)
  (list 'FORALL 't (list 'IMPLIES '(IN t SET) (list 'IMPLIES '(IN (CARD t) NN)
    (list 'FORALL 'r (list 'IMPLIES '(IN r SET) (list 'IMPLIES '(FORALL z_ (IMPLIES (IN z_ r) (IN z_ t)))
      (list 'FORALL 'h (list 'IMPLIES '(FORALL z_ (IMPLIES (IN z_ t) (IN (h z_) (CARR ag))))
        (list 'IMPLIES '(FORALL z_ (IMPLIES (IN z_ t) (IMPLIES (NOT (IN z_ r)) (= (h z_) (IDEN ag)))))
          '(= (FINSUM ag h t) (FINSUM ag h r)))))))))))))))
(dk-peel!)
(let* ((hr '(VNB-LAMBDA paz_ t (h paz_)))
       (hty (nne-ctx '(FORALL z_ (IMPLIES (IN z_ t) (IN (h z_) (CARR ag))))))
       (hoff (nne-ctx '(FORALL z_ (IMPLIES (IN z_ t) (IMPLIES (NOT (IN z_ r)) (= (h z_) (IDEN ag)))))))
       (hsub (nne-ctx '(FORALL z_ (IMPLIES (IN z_ r) (IN z_ t))))))
  (nne-have! (list 'IN hr '(FUN t (CARR ag)))
    (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (dk-apply! hty z) (nne-close!)))
                             (lambda () (nne-close!)))))
  (nne-have! '(SUBSET r t) (lambda () (mac 'subset-def) (nne-close!)))
  (nne-and! '(IN t SET) '(IN (CARD t) NN))
  (nne-and! '(IN r SET) '(FORALL z (IMPLIES (IN z r) (IN z t))))
  (nne-cite! 'card-subset-nn 't 'r)
  (nne-have! (list 'FORALL 'z (list 'IMPLIES '(AND (IN z t) (NOT (IN z r))) (list '= (list hr 'z) '(IDEN ag))))
    (lambda ()
      (dk-peel!) (dk-split-all!)
      (let ((z (cadr (cadr (dk-goal)))))
        (dk-apply! hty z)
        (dk-lam-b!)
        (dk-apply! hoff z)
        (nne-close!))))
  (let* ((e (nne-cite! 'finsum-embed 'ag 'r 't hr))
         (pw (lambda (s)
               (nne-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list '= (list hr 'z) '(h z))))
                 (lambda () (let ((z (dk-di-var!)))
                              (if (eq? s 'r) (dk-apply! hsub z))
                              (dk-apply! hty z) (dk-lam-b!) (nne-close!))))
               (nne-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN (list hr 'z) '(CARR ag))))
                 (lambda () (let ((z (dk-di-var!)))
                              (if (eq? s 'r) (dk-apply! hsub z))
                              (dk-apply! hty z) (dk-lam-b!) (nne-close!))))
               (nne-cite! 'finsum-congruence 'ag s hr 'h)))
         (c1 (pw 't)) (c2 (pw 'r)))
    (subst (list '= (caddr c1) (cadr c1)))
    (subst e)
    (subst c2)
    (nne-close!)))
(nne-done! 'finsum-ag-pad-ptwise)

;;; ====================================================================
;;; card-of-inj-into-finite: a set mapped injectively into a finite set is finite
;;; ====================================================================
(sp (make-wff (list 'FORALL 'X (list 'FORALL 'Y (list 'FORALL 'ph
  (list 'IMPLIES '(IN X SET) (list 'IMPLIES '(IN Y SET) (list 'IMPLIES '(IN (CARD Y) NN)
    (list 'IMPLIES '(FORALL nej_ (IMPLIES (IN nej_ X) (IN (ph nej_) Y)))
      (list 'IMPLIES '(FORALL x_ (IMPLIES (IN x_ X) (FORALL y_ (IMPLIES (IN y_ X) (IMPLIES (= (ph x_) (ph y_)) (= x_ y_))))))
        '(IN (CARD X) NN)))))))))))
(dk-peel!)
(let ((maps (nne-ctx '(FORALL nej_ (IMPLIES (IN nej_ X) (IN (ph nej_) Y)))))
      (inj (nne-ctx '(FORALL x_ (IMPLIES (IN x_ X) (FORALL y_ (IMPLIES (IN y_ X) (IMPLIES (= (ph x_) (ph y_)) (= x_ y_)))))))))
  (use-em '(IN (CARD X) NN)
    (lambda () (ass))
    (lambda ()
      (let* ((ex (nne-cite! 'infinite-set-nn-injection 'X))
             (ing (dk-skolem! ex)))
        (dk-split-all!)
        (let* ((injg (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q ing) (dk-contains? q 'ina_))) "injectivity"))
               (cy '(CARD Y)) (n (list 'succ cy)) (seg (list 'ORD-SEGMENT n))
               (q (list 'VNB-LAMBDA 'neq_ seg (list 'ph (list ing 'neq_))))
               (pt! (lambda (k)        ; k in seg: k in NN, ing k in X, ph(ing k) in Y
                      (fact 'ord-segment-nn-subset n k)
                      (nne-ap! ing 'NN 'X k)
                      (dk-apply! maps (list ing k)))))
          (fact 'nn-succ-closed cy)
          (fact 'nn-subset-ord n)
          (fact 'ord-segment-is-set n)
          (nne-have! (list 'IN q (list 'FUN seg 'Y))
            (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (pt! k) (nne-close!)))
                                     (lambda () (nne-close!)))))
          (nne-have! (list 'IN q (list 'INJECTION seg 'Y))
            (lambda ()
              (mac 'injection-membership-iff)
              (dk-conj-close!
                (lambda ()
                  (cond ((not (nne-open?)) #t)
                        ((dk-asm? (dk-goal)) (ass))
                        (#t
                         (dk-peel!)
                         (let* ((g0 (dk-goal)) (a (cadr g0)) (b (caddr g0))
                                (hy (dk-pick (lambda (f) (and (dk-head-is? f '=) (dk-contains? f a) (dk-contains? f b) (dk-contains? f 'VNB-LAMBDA))) "q a = q b")))
                           (pt! a) (pt! b)
                           (let ((h2 (dk-landed-1 (lambda () (dk-lam-b-h! hy)))))
                             (dk-apply! inj (list ing a) (list ing b))
                             (dk-apply! injg a b)
                             (nne-close!)))))))))
          (fact 'card-segment n)
          (nne-have! (list 'IN (list 'CARD seg) 'NN) (lambda () (subst (list '= (list 'CARD seg) n)) (nne-close!)))
          (nne-and! (list 'IN q (list 'INJECTION seg 'Y)) (list 'IN seg 'SET) (list 'IN (list 'CARD seg) 'NN))
          (let ((ci (nne-cite! 'card-image-injection seg 'Y q))
                (img (list 'IMAGE q seg)))
            (nne-have! (list 'SUBSET img 'Y)
              (lambda ()
                (mac 'subset-def)
                (let* ((z (dk-di-var!))
                       (ex2 (car (dk-landed (lambda () (mac-h 'image-membership-iff (list 'IN z img))))))
                       (k (dk-skolem! ex2)))
                  (dk-split-all!)
                  (subst (list '= z (list q k)))
                  (nne-ap! q seg 'Y k)
                  (nne-close!))))
            (let* ((le (nne-cite! 'card-subset-mono 'Y img))
                   (sp1 (car (dk-landed (lambda () (fact 'nn-succ-plus-one cy)))))
                   (cs (list '= (list 'CARD seg) n)))
              (fact 'nn-in-rr cy)
              (let ((bad (list '<= (list '+ cy 1) cy)))
                (nne-have! bad
                  (lambda ()
                    (subst (list '= (caddr sp1) (cadr sp1)))
                    (subst (list '= (caddr cs) (cadr cs)))
                    (subst (list '= (caddr ci) (cadr ci)))
                    (nne-close!)))
                (dk-absurd! bad (list 'IN cy 'RR))))))))))
(nne-done! 'card-of-inj-into-finite)

;;; ====================================================================
;;; finsum-ag-image-inj: the abelian-group twin of finsum-cm-image-inj (via finsum-reindex-ag)
;;; ====================================================================
(define nne-ii-h1 '(FORALL x_ (IMPLIES (IN x_ t) (IN (phi x_) SET))))
(define nne-ii-h2 '(FORALL x_ (IMPLIES (IN x_ t) (FORALL y_ (IMPLIES (IN y_ t) (IMPLIES (= (phi x_) (phi y_)) (= x_ y_)))))))
(define nne-ii-h3 '(FORALL z_ (IMPLIES (IN z_ (IMAGE phi t)) (IN (f z_) (CARR ag)))))
(define nne-ii-h4 '(FORALL x_ (IMPLIES (IN x_ t) (= (k x_) (f (phi x_))))))
(sp (make-wff (list 'FORALL 'ag (list 'IMPLIES '(IS-ABELIAN-GROUP ag)
  (list 'FORALL 't (list 'IMPLIES '(IN t SET) (list 'IMPLIES '(IN (CARD t) NN)
    (list 'FORALL 'phi (list 'FORALL 'f (list 'FORALL 'k
      (list 'IMPLIES nne-ii-h1 (list 'IMPLIES nne-ii-h2 (list 'IMPLIES nne-ii-h3 (list 'IMPLIES nne-ii-h4
        '(= (FINSUM ag k t) (FINSUM ag f (IMAGE phi t)))))))))))))))))
(dk-peel!)
(let* ((h1 (nne-ctx nne-ii-h1)) (h2 (nne-ctx nne-ii-h2)) (h3 (nne-ctx nne-ii-h3)) (h4 (nne-ctx nne-ii-h4))
       (s '(IMAGE phi t))
       (psi '(VNB-LAMBDA nez_ t (phi nez_)))
       (fs (list 'VNB-LAMBDA 'nez_ s '(f nez_))))
  (nne-have! (nne-maps 'phi 't 'SET) (lambda () (let ((z (dk-di-var!))) (dk-apply! h1 z) (nne-close!))))
  (nne-img! 'phi 't 'SET)
  (let ((into (nne-ctx (nne-maps 'phi 't s))))
    (nne-have! (list 'IN psi (list 'FUN 't s))
      (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (dk-apply! into z) (nne-close!)))
                               (lambda () (nne-close!)))))
    (nne-have! (list 'IN fs (list 'FUN s '(CARR ag)))
      (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (dk-apply! h3 z) (nne-close!)))
                               (lambda () (nne-close!)))))
    (nne-have! (list 'IN psi (list 'BIJECTION 't s))
      (lambda ()
        (mac 'bijection-membership-iff)
        (dk-conj-close!
          (lambda ()
            (cond ((not (nne-open?)) #t)
                  ((dk-asm? (dk-goal)) (ass))
                  ((dk-contains? (dk-goal) 'FORSOME)
                   (let* ((w (dk-di-var!))
                          (ex (car (dk-landed (lambda () (mac-h 'image-membership-iff (list 'IN w s))))))
                          (x (dk-skolem! ex)))
                     (dk-split-all!)
                     (ew x)
                     (dk-conj-close!
                       (lambda ()
                         (cond ((not (nne-open?)) #t)
                               ((dk-asm? (dk-goal)) (ass))
                               (#t (dk-apply! into x) (dk-lam-b!) (nne-close!)))))))
                  (#t
                   (dk-peel!)
                   (let* ((g0 (dk-goal)) (a (cadr g0)) (b (caddr g0))
                          (hy (dk-pick (lambda (q) (and (dk-head-is? q '=) (dk-contains? q 'VNB-LAMBDA) (dk-contains? q a) (dk-contains? q b))) "psi a = psi b")))
                     (dk-apply! into a) (dk-apply! into b)
                     (dk-lam-b-h! hy)
                     (dk-apply! h2 a b)
                     (nne-close!))))))))
    (nne-and! '(IN t SET) '(IN (CARD t) NN))
    (let* ((re (nne-cite! 'finsum-reindex-ag 'ag s 't psi fs))
           (lam (caddr (caddr re)))
           (cong (lambda (dom f1 f2 pt!)
                   (nne-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z dom) (list '= (list f1 'z) (list f2 'z))))
                     (lambda () (let ((z (dk-di-var!))) (pt! z) (dk-lam-b!) (nne-close!))))
                   (nne-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z dom) (list 'IN (list f1 'z) '(CARR ag))))
                     (lambda () (let ((z (dk-di-var!))) (pt! z) (dk-lam-b!) (nne-close!))))
                   (nne-cite! 'finsum-congruence 'ag dom f1 f2)))
           (c1 (cong s fs 'f (lambda (z) (dk-apply! h3 z))))
           (c2 (cong 't lam 'k (lambda (z) (dk-apply! into z) (dk-apply! h3 (list 'phi z)) (dk-apply! h4 z)))))
      (subst (list '= (caddr c2) (cadr c2)))
      (subst (list '= (caddr re) (cadr re)))
      (subst c1)
      (nne-close!))))
(nne-done! 'finsum-ag-image-inj)

;;; ====================================================================
;;; sums-to-nn-transfer: f on ix vanishes off P; ph : M -> P a bijection from a subset M of NN;
;;; g on NN is f o ph on M and zero off M.  Then f sums to r implies g sums to r.
;;; ====================================================================
(define nne-A '(NORMED-AG-AS-ABELIAN-GROUP grp))
(define nne-Z (list 'IDEN nne-A))
(define nne-t2-hyps
  (list '(IS-NORMED-AG grp) '(IN M SET) '(FORALL nen_ (IMPLIES (IN nen_ M) (IN nen_ NN)))
        '(IN ph (BIJECTION M P)) '(FORALL nep_ (IMPLIES (IN nep_ P) (IN nep_ ix)))
        (list 'IN 'f (list 'FUN 'ix (list 'CARR nne-A)))
        (list 'FORALL 'nep_ (list 'IMPLIES '(IN nep_ ix) (list 'IMPLIES '(NOT (IN nep_ P)) (list '= '(f nep_) nne-Z))))
        (list 'IN 'g (list 'FUN 'NN (list 'CARR nne-A)))
        '(FORALL nen_ (IMPLIES (IN nen_ M) (= (g nen_) (f (ph nen_)))))
        (list 'FORALL 'nen_ (list 'IMPLIES '(IN nen_ NN) (list 'IMPLIES '(NOT (IN nen_ M)) (list '= '(g nen_) nne-Z))))))
(define (nne-replace t v w) (cond ((eq? t v) w) ((pair? t) (map (lambda (x) (nne-replace x v w)) t)) (#t t)))
(define (nne-absurd! a) (if (dk-only! a (list 'NOT a)) (prop)))
(define (nne-union-in! z a b side)      ; land z in union(a, b) from z in a (side 'l) or z in b
  (let ((u (list 'UNION a b)))
    (if (not (dk-asm? (list 'IN z u)))
        (let ((iff (nne-cite! 'union-membership a b z))
              (o (list 'OR (list 'IN z a) (list 'IN z b))))
          (nne-have! o (lambda () (if (dk-only! (if (eq? side 'l) (list 'IN z a) (list 'IN z b))) (prop))))
          (dk-iff-bwd! iff)))))
(sp (make-wff (list 'FORALL 'grp (list 'FORALL 'ix (list 'FORALL 'M (list 'FORALL 'P (list 'FORALL 'ph
  (list 'FORALL 'f (list 'FORALL 'g (list 'FORALL 'r
    (dk-curry nne-t2-hyps '(IMPLIES (SUMS-TO grp f r) (SUMS-TO grp g r)))))))))))))
(dk-peel!)
(fact 'normed-ag-as-abelian-group-is-abelian-group 'grp)
(nne-dom! 'f 'ix (list 'CARR nne-A))
(nne-dom! 'g 'NN (list 'CARR nne-A))
(dk-iff-fwd! (nne-cite! 'bijection-membership-iff 'M 'P 'ph))
(let* ((agA nne-A) (zer nne-Z)
       (Mnn (nne-ctx '(FORALL nen_ (IMPLIES (IN nen_ M) (IN nen_ NN)))))
       (Pix (nne-ctx '(FORALL nep_ (IMPLIES (IN nep_ P) (IN nep_ ix)))))
       (foff (nne-ctx (list-ref nne-t2-hyps 6)))
       (gon (nne-ctx (list-ref nne-t2-hyps 8)))
       (goff (nne-ctx (list-ref nne-t2-hyps 9)))
       (inj (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q 'ph) (not (dk-contains? q 'FORSOME))
                                      (dk-contains? q 'IMPLIES) (not (dk-contains? q 'g)) (not (dk-contains? q 'f)))) "injectivity"))
       (surj (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q 'ph) (dk-contains? q 'FORSOME))) "surjectivity"))
       (ph-in! (lambda (n)        ; n in M: ph n in P, in ix, in SET
                 (nne-ap! 'ph 'M 'P n)
                 (dk-apply! Pix (list 'ph n))
                 (fact 'membership-implies-sethood (list 'ph n) 'P))))
  (mac-h 'SUMS-TO '(SUMS-TO grp f r))
  (let ((hsum (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q 'fin) (dk-contains? q 'f))) "f sums to r")))
    (mac 'SUMS-TO)
    (let* ((eps (cadr (car (dk-peel!))))
           (ex (dk-apply! hsum eps))
           (fin0 (dk-skolem! ex)))
      (dk-split-all!)
      (let* ((U (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q fin0) (dk-contains? q 'ext))) "the tail bound"))
             (Fp (list 'SEP 'nen_ 'M (list 'IN '(ph nen_) fin0)))
             (in-Fp! (lambda (n) (sep-me (list 'IN n Fp)) (dk-split-all!))))
        (fact 'fun-domain-in-set 'M 'P 'ph)
        (nne-sep-set! Fp)
        (if (not (dk-asm? (list 'SUBSET fin0 'ix)))
            (dk-rewrite-h! (list 'SUBSET fin0 '(DOM f)) '(DOM f) 'ix))
        (nne-have! (list 'FORALL 'nej_ (list 'IMPLIES (list 'IN 'nej_ Fp) (list 'IN '(ph nej_) fin0)))
          (lambda () (let ((n (dk-di-var!))) (in-Fp! n) (nne-close!))))
        (nne-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ Fp) (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ Fp)
                     '(IMPLIES (= (ph x_) (ph y_)) (= x_ y_))))))
          (lambda () (dk-peel!) (let* ((g0 (dk-goal)) (a (cadr g0)) (b (caddr g0)))
                                  (in-Fp! a) (in-Fp! b) (dk-apply! inj a b) (nne-close!))))
        (nne-cite! 'card-of-inj-into-finite Fp fin0 'ph)
        (nne-have! (list 'SUBSET Fp '(DOM g))
          (lambda () (subst '(= (DOM g) NN)) (mac 'subset-def)
                     (let ((n (dk-di-var!))) (in-Fp! n) (dk-apply! Mnn n) (nne-close!))))
        (ew Fp)
        (dk-conj-close!
          (lambda ()
            (cond
              ((not (nne-open?)) #t)
              ((dk-asm? (dk-goal)) (ass))
              (#t
               (dk-peel!) (dk-split-all!)
               (let* ((gl (dk-goal))
                      (ext (let find ((t gl)) (cond ((and (pair? t) (eq? (car t) 'FINSUM)) (cadddr t))
                                                    ((pair? t) (or (find (car t)) (find (cdr t)))) (#t #f))))
                      (E1 (list 'SEP 'nen_ ext '(IN nen_ M)))
                      (I (list 'IMAGE 'ph E1))
                      (bigE (list 'UNION I fin0)))
                 (if (not (dk-asm? (list 'SUBSET ext 'NN)))
                     (dk-rewrite-h! (list 'SUBSET ext '(DOM g)) '(DOM g) 'NN))
                 (nne-sep-fin! E1 ext)
                 (let ((in-E1! (lambda (n) (sep-me (list 'IN n E1)) (dk-split-all!))))
                   ;; (1) pad ext down to E1
                   (nne-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ E1) (list 'IN 'z_ ext)))
                     (lambda () (let ((n (dk-di-var!))) (in-E1! n) (nne-close!))))
                   (nne-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ ext) (list 'IN '(g z_) (list 'CARR agA))))
                     (lambda () (let ((n (dk-di-var!))) (fact 'subset-mem-fwd ext 'NN n) (nne-ap! 'g 'NN (list 'CARR agA) n) (nne-close!))))
                   (nne-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ ext) (list 'IMPLIES (list 'NOT (list 'IN 'z_ E1)) (list '= '(g z_) zer))))
                     (lambda ()
                       (dk-peel!)
                       (let ((n (cadr (cadr (dk-goal)))))
                         (fact 'subset-mem-fwd ext 'NN n)
                         (use-em (list 'IN n 'M)
                           (lambda () (nne-have! (list 'IN n E1) (lambda () (in-sep! (lambda () (nne-close!)) (lambda () (nne-close!)))))
                                      (nne-absurd! (list 'IN n E1)))
                           (lambda () (dk-apply! goff n) (nne-close!))))))
                   (let ((p1 (nne-cite! 'finsum-ag-pad-ptwise agA ext E1 'g)))
                     ;; (2) E1 -> its image under ph
                     (nne-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ E1) '(IN (ph x_) SET)))
                       (lambda () (let ((n (dk-di-var!))) (in-E1! n) (ph-in! n) (nne-close!))))
                     (nne-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ E1) (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ E1)
                                  '(IMPLIES (= (ph x_) (ph y_)) (= x_ y_))))))
                       (lambda () (dk-peel!) (let* ((g0 (dk-goal)) (a (cadr g0)) (b (caddr g0)))
                                               (in-E1! a) (in-E1! b) (dk-apply! inj a b) (nne-close!))))
                     (nne-have! (nne-maps 'ph E1 'ix)
                       (lambda () (let ((n (dk-di-var!))) (in-E1! n) (ph-in! n) (nne-close!))))
                     (nne-img! 'ph E1 'ix)
                     (nne-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ I) (list 'IN '(f z_) (list 'CARR agA))))
                       (lambda () (let ((z (dk-di-var!))) (nne-in-sub! I 'ix z) (nne-ap! 'f 'ix (list 'CARR agA) z) (nne-close!))))
                     (nne-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ E1) '(= (g x_) (f (ph x_)))))
                       (lambda () (let ((n (dk-di-var!))) (in-E1! n) (dk-apply! gon n) (nne-close!))))
                     (let ((p2 (nne-cite! 'finsum-ag-image-inj agA E1 'ph 'f 'g)))
                       ;; (3) pad bigE = I u fin0 down to I
                       (nne-and! (list 'IN I 'SET) (list 'IN fin0 'SET))
                       (nne-cite! 'union-set-closure I fin0)
                       (nne-cite! 'card-union-nn I fin0)
                       (nne-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ I) (list 'IN 'z_ bigE)))
                         (lambda () (let ((z (dk-di-var!))) (nne-union-in! z I fin0 'l) (nne-close!))))
                       (nne-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ fin0) (list 'IN 'z_ bigE)))
                         (lambda () (let ((z (dk-di-var!))) (nne-union-in! z I fin0 'r) (nne-close!))))
                       (let ((ext-cases! (lambda (z on-I on-F)
                                           (let ((iff (nne-cite! 'union-membership I fin0 z)))
                                             (ai iff)
                                             (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
                                             (dk-or-each! (caddr iff)
                                               (lambda (dj) (if (equal? dj (list 'IN z I)) (on-I) (on-F))))))))
                         (nne-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ bigE) (list 'IN 'z_ 'ix)))
                           (lambda () (let ((z (dk-di-var!)))
                                        (ext-cases! z (lambda () (nne-in-sub! I 'ix z) (nne-close!))
                                                      (lambda () (fact 'subset-mem-fwd fin0 'ix z) (nne-close!))))))
                         (nne-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ bigE) (list 'IN '(f z_) (list 'CARR agA))))
                           (lambda () (let ((z (dk-di-var!)))
                                        (dk-apply! (nne-ctx (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ bigE) (list 'IN 'z_ 'ix)))) z)
                                        (nne-ap! 'f 'ix (list 'CARR agA) z) (nne-close!))))
                         (nne-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ bigE) (list 'IMPLIES (list 'NOT (list 'IN 'z_ I)) (list '= '(f z_) zer))))
                           (lambda ()
                             (dk-peel!)
                             (let ((z (cadr (cadr (dk-goal)))))
                               (dk-apply! (nne-ctx (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ bigE) (list 'IN 'z_ 'ix)))) z)
                               (use-em (list 'IN z 'P)
                                 (lambda ()
                                   (let* ((exn (dk-apply! surj z)) (n (dk-skolem! exn)))
                                     (dk-split-all!)
                                     (ext-cases! z
                                       (lambda () (nne-absurd! (list 'IN z I)))
                                       (lambda ()
                                         (nne-have! (list 'IN n Fp)
                                           (lambda () (in-sep! (lambda () (nne-close!))
                                                               (lambda () (subst (list '= (list 'ph n) z)) (nne-close!)))))
                                         (fact 'subset-mem-fwd Fp ext n)
                                         (nne-have! (list 'IN n E1) (lambda () (in-sep! (lambda () (nne-close!)) (lambda () (nne-close!)))))
                                         (dk-apply! (nne-ctx (nne-maps 'ph E1 I)) n)
                                         (nne-have! (list 'IN z I) (lambda () (subst (list '= z (list 'ph n))) (nne-close!)))
                                         (nne-absurd! (list 'IN z I))))))
                                 (lambda () (dk-apply! foff z) (nne-close!)))))))
                       (let ((p3 (nne-cite! 'finsum-ag-pad-ptwise agA bigE I 'f)))
                         ;; (4) the bound at bigE
                         (nne-have! (list 'SUBSET fin0 bigE) (lambda () (mac 'subset-def) (nne-close!)))
                         (nne-have! (list 'SUBSET bigE '(DOM f))
                           (lambda () (subst '(= (DOM f) ix)) (mac 'subset-def) (nne-close!)))
                         (let* ((uv (cadr U)) (ante (nne-replace (cadr (caddr U)) uv bigE)))
                           (nne-have! ante (lambda () (dk-conj-close! (lambda () (nne-close!)))))
                           (dk-apply! U bigE)
                           (subst p1) (subst p2)
                           (subst (list '= (caddr p3) (cadr p3)))
                           (nne-close!)))))))))))))))
(nne-done! 'sums-to-nn-transfer)

;;; ====================================================================
;;; cc-nag-dist: the SUMS-TO distance of CC-NAG is |a - b|
;;; ====================================================================
(sp (make-wff '(FORALL a_ (IMPLIES (IN a_ CC) (FORALL b_ (IMPLIES (IN b_ CC)
  (= ((NRM CC-NAG) ((OPR CC-NAG) a_ ((INV CC-NAG) b_))) (magnitude (- a_ b_)))))))))
(dk-peel!)
(fact 'cc-nag@opr) (fact 'cc-nag@inv) (fact 'cc-nag@nrm)
(fact 'cc-neg-closed 'b_)
(nne-and! '(IN a_ CC) '(IN (- b_) CC))
(fact 'cc-add-closed 'a_ '(- b_))
(fact 'pair-in-cartesian 'CC 'CC 'a_ '(- b_))
(nne-have! '(= (- a_ b_) (+ a_ (- b_))) (lambda () (crs)))
(subst '(= (- a_ b_) (+ a_ (- b_))))
(subst (dk-ctx-form '(== (INV CC-NAG) (VNB-LAMBDA x_ CC (- x_)))))
(let loop ((n 0)) (if (and (< n 6) (nne-open?) (dk-contains? (dk-goal) 'VNB-LAMBDA)) (begin (dk-lam-b!) (loop (+ n 1)))))
(subst (dk-pick (lambda (q) (and (dk-head-is? q '==) (equal? (cadr q) '(OPR CC-NAG)))) "opr"))
(let loop ((n 0)) (if (and (< n 6) (nne-open?) (dk-contains? (dk-goal) 'VNB-LAMBDA)) (begin (dk-lam-b!) (loop (+ n 1)))))
(subst (dk-pick (lambda (q) (and (dk-head-is? q '==) (equal? (cadr q) '(NRM CC-NAG)))) "nrm"))
(let loop ((n 0)) (if (and (< n 6) (nne-open?) (dk-contains? (dk-goal) 'VNB-LAMBDA)) (begin (dk-lam-b!) (loop (+ n 1)))))
(if (nne-open?) (begin (fact 'cc-magnitude-closed '(+ a_ (- b_))) (nne-close!)))
(nne-done! 'cc-nag-dist)

;;; ====================================================================
;;; finsum-ord-segment-partial-sum: the finite sum over {0, ..., k-1} is the k-th partial sum
;;; ====================================================================
(define nne-AG '(NORMED-AG-AS-ABELIAN-GROUP CC-NAG))
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'g (list 'IMPLIES '(IN g (FUN NN CC))
  (list '= (list 'FINSUM nne-AG 'g '(ORD-SEGMENT k)) '(CC-SERIES-PARTIAL-SUM g k))))))))
(let* ((bs (dk-ni-leaves)) (base (car bs)) (step (cadr bs)))
  (dk-focus! base)
  (dk-peel!)
  (fact 'ord-segment-zero)
  (subst '(= (ORD-SEGMENT 0) EMPTY-SET))
  (dk-cite! 'finsum-empty nne-AG 'g)
  (subst (list '== (list 'FINSUM nne-AG 'g 'EMPTY-SET) (list 'IDEN nne-AG)))
  (dk-cite! 'cc-nag-ag-iden)
  (subst (list '== (list 'IDEN nne-AG) 0))
  (dk-cite! 'cc-series-partial-sum-zero 'g)
  (subst '(== (CC-SERIES-PARTIAL-SUM g 0) 0))
  (fact 'cc-zero-in)
  (nne-close!)
  (dk-focus! step)
  (dk-peel!)
  (let* ((gl (dk-goal)) (pk (caddr gl)) (sk (caddr pk))
         (k (cadr sk)) (gv (cadr pk))
         (ih (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'CC-SERIES-PARTIAL-SUM))) "the IH"))
         (s (list 'ORD-SEGMENT k)) (pr (list 'PAIR k k)) (u (list 'UNION s pr))
         (e (dk-apply! ih gv)))
    (fact 'cc-nag-ag-is-abelian-group)
    (fact 'cc-nag-ag-carr)
    (fact 'nn-subset-ord k) (fact 'ord-segment-is-set k) (fact 'card-segment k)
    (fact 'nn-succ-closed k)
    (nne-have! (list 'IN (list 'CARD s) 'NN) (lambda () (subst (list '= (list 'CARD s) k)) (nne-close!)))
    (fact 'membership-implies-sethood k 'NN)
    (fact 'ord-segment-self k)
    (let ((oi (nne-cite! 'ord-segment-insert k)))
      (nne-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ u) (list 'IN (list gv 'z_) (list 'CARR nne-AG))))
        (lambda ()
          (subst (list '== (list 'CARR nne-AG) 'CC))
          (let ((z (dk-di-var!)))
            (dk-rewrite-h! (list 'IN z u) u (list 'ORD-SEGMENT sk))
            (fact 'ord-segment-nn-subset sk z)
            (nne-ap! gv 'NN 'CC z)
            (nne-close!))))
      (let ((ins (nne-cite! 'finsum-insert-ptwise nne-AG s k gv)))
        (subst oi)
        (subst ins)
        (subst e)
        (fact 'cc-series-partial-sum-in-cc k gv)
        (nne-ap! gv 'NN 'CC k)
        (subst (nne-cite! 'cc-nag-ag-opr (list 'CC-SERIES-PARTIAL-SUM gv k) (list gv k)))
        (let ((sc (nne-cite! 'cc-series-partial-sum-succ gv k)))
          (subst sc)
          (nne-and! (list 'IN (list 'CC-SERIES-PARTIAL-SUM gv k) 'CC) (list 'IN (list gv k) 'CC))
          (fact 'cc-add-closed (list 'CC-SERIES-PARTIAL-SUM gv k) (list gv k))
          (nne-close!))))))
(nne-done! 'finsum-ord-segment-partial-sum)

;;; ====================================================================
;;; nn-sums-to-series: an NN-indexed family summing to r (unordered) has the series sum r
;;; ====================================================================
(sp (make-wff '(FORALL g (FORALL r (IMPLIES (IN g (FUN NN CC)) (IMPLIES (IN r CC)
  (IMPLIES (SUMS-TO CC-NAG g r) (CC-SERIES-CONVERGES-TO g r))))))))
(dk-peel!)
(nne-dom! 'g 'NN 'CC)
(fact 'cc-ms@pts)
(mac-h 'SUMS-TO '(SUMS-TO CC-NAG g r))
(let ((hsum (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q 'fin))) "g sums to r"))
      (L '(VNB-LAMBDA k NN (CC-SERIES-PARTIAL-SUM g k))))
  (mac 'cc-series-converges-to)
  (mac 'converges-to)
  (dk-conj-close!
    (lambda ()
      (cond
        ((not (nne-open?)) #t)
        ((dk-asm? (dk-goal)) (ass))
        ((dk-head-is? (dk-goal) 'IS-METRIC-SPACE) (fact 'cc-is-metric-space) (nne-close!))
        ((and (dk-head-is? (dk-goal) 'IN) (equal? (cadr (dk-goal)) 'r))
         (subst '(== (PTS CC-MS) CC)) (nne-close!))
        ((dk-head-is? (dk-goal) 'IN)
         (subst '(== (PTS CC-MS) CC))
         (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (fact 'cc-series-partial-sum-in-cc k 'g) (nne-close!)))
                       (lambda () (fact 'nn-is-set) (nne-close!))))
        (#t
         (let* ((eps (cadr (car (dk-peel!))))
                (ex (dk-apply! hsum eps))
                (fin0 (dk-skolem! ex)))
           (dk-split-all!)
           (let ((U (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q fin0) (dk-contains? q 'ext))) "the tail bound")))
             (if (not (dk-asm? (list 'SUBSET fin0 'NN)))
                 (dk-rewrite-h! (list 'SUBSET fin0 '(DOM g)) '(DOM g) 'NN))
             (let* ((exn (nne-cite! 'nn-finite-subset-bounded fin0))
                    (nb (dk-skolem! exn)))
               (dk-split-all!)
               (let ((far (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q nb) (dk-contains? q fin0))) "beyond N")))
                 (ew nb)
                 (dk-conj-close!
                   (lambda ()
                     (cond
                       ((not (nne-open?)) #t)
                       ((dk-asm? (dk-goal)) (ass))
                       (#t
                        (let* ((landed (dk-peel!))
                               (n (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) landed)))
                               (ext (list 'ORD-SEGMENT n))
                               (ps (list 'CC-SERIES-PARTIAL-SUM 'g n)))
                          (fact 'nn-subset-ord n) (fact 'ord-segment-is-set n) (fact 'card-segment n)
                          (nne-have! (list 'IN (list 'CARD ext) 'NN) (lambda () (subst (list '= (list 'CARD ext) n)) (nne-close!)))
                          (nne-have! (list 'SUBSET fin0 ext)
                            (lambda ()
                              (mac 'subset-def)
                              (let ((z (dk-di-var!)))
                                (fact 'subset-mem-fwd fin0 'NN z)
                                (fact 'nn-in-rr z) (fact 'nn-in-rr n) (fact 'nn-in-rr nb)
                                (use-em (list '< z n)
                                  (lambda () (dk-iff-bwd! (nne-cite! 'seg-mem-lt n z)) (nne-close!))
                                  (lambda ()
                                    (nne-cite! 'nn-not-lt-le z n)
                                    (nne-have! (list '<= nb z) (lambda () (dk-ineq! (list '<= n z) (list '<= nb n))))
                                    (dk-apply! far z)
                                    (nne-absurd! (list 'IN z fin0)))))))
                          (nne-have! (list 'SUBSET ext '(DOM g))
                            (lambda () (subst '(= (DOM g) NN)) (mac 'subset-def)
                                       (let ((z (dk-di-var!))) (fact 'ord-segment-nn-subset n z) (nne-close!))))
                          (let ((ante (nne-replace (cadr (caddr U)) (cadr U) ext)))
                            (nne-have! ante (lambda () (dk-conj-close! (lambda () (nne-close!))))))
                          (let* ((b (dk-apply! U ext))
                                 (br (nne-cite! 'finsum-ord-segment-partial-sum n 'g)))
                            (fact 'cc-series-partial-sum-in-cc n 'g)
                            (let* ((b1 (dk-rewrite-h! b (cadr br) (caddr br)))
                                   (dd (nne-cite! 'cc-nag-dist 'r ps))
                                   (b2 (dk-rewrite-h! b1 (cadr dd) (caddr dd))))
                              (dk-lam-b!)
                              (subst (nne-cite! 'cc-ms-dist ps 'r))
                              (subst (nne-cite! 'cc-magnitude-sub-sym ps 'r))
                              (let ((df (list '- 'r ps)))
                                (nne-have! (list 'IN df 'CC) (lambda () (dk-type! df 'CC)))
                                (fact 'cc-magnitude-closed df)
                                (dk-pos-parts! eps)
                                (dk-ineq! b2 (list 'IN (list 'magnitude df) 'RR) (list 'IN eps 'RR)))))))))))))))))))
(nne-done! 'nn-sums-to-series)

;;; ====================================================================
;;; esum-nn-transfer-le: h on NN is g o ph on M (ph injective on M) and zero off M:
;;; ESUM h <= ESUM g
;;; ====================================================================
(define nne-tl-hyps
  (list '(IN M SET) '(FORALL nen_ (IMPLIES (IN nen_ M) (IN nen_ NN)))
        '(FORALL nej_ (IMPLIES (IN nej_ M) (IN (ph nej_) ix)))
        '(FORALL x_ (IMPLIES (IN x_ M) (FORALL y_ (IMPLIES (IN y_ M) (IMPLIES (= (ph x_) (ph y_)) (= x_ y_))))))
        '(IN g (FUN ix RR-POS-STAR)) '(IN h (FUN NN RR-POS-STAR))
        '(FORALL nen_ (IMPLIES (IN nen_ M) (= (h nen_) (g (ph nen_)))))
        '(FORALL nen_ (IMPLIES (IN nen_ NN) (IMPLIES (NOT (IN nen_ M)) (= (h nen_) 0))))))
(sp (make-wff (list 'FORALL 'ix (list 'FORALL 'M (list 'FORALL 'ph (list 'FORALL 'g (list 'FORALL 'h
  (dk-curry nne-tl-hyps '(<= (ESUM h) (ESUM g))))))))))
(dk-peel!)
(nne-rps-carr!)
(dk-cite! 'rr-pos-star-add-monoid@iden)
(nne-dom! 'h 'NN 'RR-POS-STAR)
(nne-dom! 'g 'ix 'RR-POS-STAR)
(let ((eg '(ESUM g))
      (maps (nne-ctx (list-ref nne-tl-hyps 2))) (inj (nne-ctx (list-ref nne-tl-hyps 3)))
      (hon (nne-ctx (list-ref nne-tl-hyps 6))) (hoff (nne-ctx (list-ref nne-tl-hyps 7))))
  (nne-have! (nne-bound 'h eg)
    (lambda ()
      (let* ((sv (nne-peel-set! 'h 'NN))
             (E1 (list 'SEP 'nen_ sv '(IN nen_ M)))
             (in-E1! (lambda (n) (sep-me (list 'IN n E1)) (dk-split-all!))))
        (nne-sep-fin! E1 sv)
        (nne-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ E1) (list 'IN 'z_ sv)))
          (lambda () (let ((n (dk-di-var!))) (in-E1! n) (nne-close!))))
        (nne-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ sv) (list 'IN '(h z_) (list 'CARR nne-m))))
          (lambda () (subst (list '= (list 'CARR nne-m) 'RR-POS-STAR))
                     (let ((n (dk-di-var!))) (fact 'subset-mem-fwd sv 'NN n) (nne-ap! 'h 'NN 'RR-POS-STAR n) (nne-close!))))
        (nne-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ sv) (list 'IMPLIES (list 'NOT (list 'IN 'z_ E1)) (list '= '(h z_) (list 'IDEN nne-m)))))
          (lambda ()
            (subst (list '= (list 'IDEN nne-m) 0))
            (dk-peel!)
            (let ((n (cadr (cadr (dk-goal)))))
              (fact 'subset-mem-fwd sv 'NN n)
              (use-em (list 'IN n 'M)
                (lambda () (nne-have! (list 'IN n E1) (lambda () (in-sep! (lambda () (nne-close!)) (lambda () (nne-close!)))))
                           (nne-absurd! (list 'IN n E1)))
                (lambda () (dk-apply! hoff n) (nne-close!))))))
        (let ((p1 (nne-cite! 'finsum-cm-pad-ptwise nne-m sv E1 'h)))
          (nne-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ E1) '(IN (ph x_) SET)))
            (lambda () (let ((n (dk-di-var!))) (in-E1! n) (dk-apply! maps n)
                         (fact 'membership-implies-sethood (list 'ph n) 'ix) (nne-close!))))
          (nne-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ E1) (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ E1)
                       '(IMPLIES (= (ph x_) (ph y_)) (= x_ y_))))))
            (lambda () (dk-peel!) (let* ((g0 (dk-goal)) (a (cadr g0)) (b (caddr g0)))
                                    (in-E1! a) (in-E1! b) (dk-apply! inj a b) (nne-close!))))
          (nne-have! (nne-maps 'ph E1 'ix)
            (lambda () (let ((n (dk-di-var!))) (in-E1! n) (dk-apply! maps n) (nne-close!))))
          (let ((img (nne-img! 'ph E1 'ix)))
            (nne-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ img) (list 'IN '(g z_) (list 'CARR nne-m))))
              (lambda () (subst (list '= (list 'CARR nne-m) 'RR-POS-STAR))
                         (let ((z (dk-di-var!))) (nne-in-sub! img 'ix z) (nne-ap! 'g 'ix 'RR-POS-STAR z) (nne-close!))))
            (nne-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ E1) '(= (h x_) (g (ph x_)))))
              (lambda () (let ((n (dk-di-var!))) (in-E1! n) (dk-apply! hon n) (nne-close!))))
            (let ((p2 (nne-cite! 'finsum-cm-image-inj nne-m E1 'ph 'g 'h)))
              (nne-partial! 'g 'ix img)
              (subst p1) (subst p2)
              (nne-close!)))))))
  (nne-and! (list 'IN eg 'RR-POS-STAR) (nne-bound 'h eg))
  (nne-cite! 'esum-least 'h eg)
  (nne-close!))
(nne-done! 'esum-nn-transfer-le)

;;; ====================================================================
;;; cc-family-nn-series (finding F2): an absolutely summable complex family a on any index set,
;;; summing to r, is carried by a bijection ph : M -> supp(a), M a subset of NN, to the NN-indexed
;;; series n |-> (a(ph n) if n in M, else 0), which converges to r and has absolute sum <= sum |a|.
;;; ====================================================================
(define nne-cP '(SEP nex_ ix (< 0 (m nex_))))
(define nne-cG '(VNB-LAMBDA nen_ NN (IF (IN nen_ nem_) (a (neph_ nen_)) 0)))
(define nne-cH '(VNB-LAMBDA nen_ NN (IF (IN nen_ nem_) (m (neph_ nen_)) 0)))
(define nne-c-hyps
  (list '(IN a (FUN ix CC)) '(IN m (FUN ix RR)) '(IN m (FUN ix RR-POS-STAR))
        '(FORALL nex_ (IMPLIES (IN nex_ ix) (= (m nex_) (magnitude (a nex_)))))
        '(IN (ESUM m) RR) '(IN r CC) '(SUMS-TO CC-NAG a r)))
(define nne-c-concl
  (list 'FORSOME 'nem_ (list 'FORSOME 'neph_
    (list 'AND '(IN nem_ SET) (list 'AND '(FORALL nen_ (IMPLIES (IN nen_ nem_) (IN nen_ NN)))
      (list 'AND (list 'IN 'neph_ (list 'BIJECTION 'nem_ nne-cP))
        (list 'AND (list 'CC-SERIES-CONVERGES-TO nne-cG 'r)
                   (list '<= (list 'ESUM nne-cH) '(ESUM m)))))))))
(sp (make-wff (list 'FORALL 'ix (list 'FORALL 'a (list 'FORALL 'm (list 'FORALL 'r
  (dk-curry nne-c-hyps nne-c-concl)))))))
(dk-peel!)
(fact 'fun-domain-in-set 'ix 'CC 'a)
(fact 'cc-nag-is-normed-ag)
(fact 'cc-nag-ag-carr) (fact 'cc-nag-ag-iden)
(fact 'cc-zero-in) (fact 'rr-zero-in) (fact 'rmc-rps-of-nonneg 0)
(let* ((ex (nne-cite! 'esum-support-enum 'ix 'm))
       (M (dk-skolem! ex))
       (ex2 (dk-pick (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q M))) "the bijection"))
       (ph (dk-skolem! ex2)))
  (dk-split-all!)
  (let* ((P nne-cP)
         (sub (lambda (t) (nne-replace (nne-replace t 'nem_ M) 'neph_ ph)))
         (G (sub nne-cG)) (H (sub nne-cH))
         (AG nne-AG)
         (mdef (nne-ctx (list-ref nne-c-hyps 3)))
         (Mnn (nne-ctx (list 'FORALL 'nen_ (list 'IMPLIES (list 'IN 'nen_ M) '(IN nen_ NN))))))
    (dk-iff-fwd! (nne-cite! 'bijection-membership-iff M P ph))
    (let* ((inj (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q ph) (not (dk-contains? q 'FORSOME))
                                          (not (dk-contains? q 'SEP)) (dk-contains? q 'IMPLIES))) "injectivity"))
           (ph-in! (lambda (n)       ; n in M: n in NN, ph n in P, ph n in ix, a(ph n) in CC, m(ph n) in RPS
                     (if (not (dk-asm? (list 'IN n 'NN))) (dk-apply! Mnn n))
                     (nne-ap! ph M P n)
                     (sep-me (list 'IN (list ph n) P)) (dk-split-all!)
                     (nne-ap! 'a 'ix 'CC (list ph n))
                     (nne-ap! 'm 'ix 'RR-POS-STAR (list ph n))))
           (ift (lambda (body n) (list 'IF (list 'IN n M) body 0))))
      (nne-have! '(FORALL nep_ (IMPLIES (IN nep_ (SEP nex_ ix (< 0 (m nex_)))) (IN nep_ ix)))
        (lambda () (let ((x (dk-di-var!))) (sep-me (list 'IN x P)) (dk-split-all!) (nne-close!))))
      (nne-have! (list 'FORALL 'nej_ (list 'IMPLIES (list 'IN 'nej_ M) (list 'IN (list ph 'nej_) 'ix)))
        (lambda () (let ((n (dk-di-var!))) (ph-in! n) (nne-close!))))
      (nne-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ M) (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ M)
                   (list 'IMPLIES (list '= (list ph 'x_) (list ph 'y_)) '(= x_ y_))))))
        (lambda () (dk-peel!) (let* ((g0 (dk-goal))) (dk-apply! inj (cadr g0) (caddr g0)) (nne-close!))))
      (for-each
        (lambda (lam cls fn)
          (nne-have! (list 'IN lam (list 'FUN 'NN cls))
            (lambda ()
              (dk-lam-type!
                (lambda ()
                  (let ((n (dk-di-var!)))
                    (dk-case-if! (ift (list fn (list ph n)) n)
                      (lambda (true? val)
                        (if true? (ph-in! n))
                        (nne-close!)))))
                (lambda () (fact 'nn-is-set) (nne-close!))))))
        (list G H) '(CC RR-POS-STAR) '(a m))
      (nne-have! (list 'IN G (list 'FUN 'NN (list 'CARR AG)))
        (lambda () (subst (list '== (list 'CARR AG) 'CC)) (nne-close!)))
      (nne-have! (list 'IN 'a (list 'FUN 'ix (list 'CARR AG)))
        (lambda () (subst (list '== (list 'CARR AG) 'CC)) (nne-close!)))
      ;; pointwise values of G and H
      (for-each
        (lambda (lam fn zero)
          (nne-have! (list 'FORALL 'nen_ (list 'IMPLIES (list 'IN 'nen_ M) (list '= (list lam 'nen_) (list fn (list ph 'nen_)))))
            (lambda ()
              (let ((n (dk-di-var!)))
                (ph-in! n) (dk-lam-b!)
                (dk-if-branch! #t (ift (list fn (list ph n)) n) #f (lambda () (nne-close!))))))
          (nne-have! (list 'FORALL 'nen_ (list 'IMPLIES '(IN nen_ NN) (list 'IMPLIES (list 'NOT (list 'IN 'nen_ M)) (list '= (list lam 'nen_) zero))))
            (lambda ()
              (dk-peel!)
              (let ((n (cadr (cadr (dk-goal)))))
                (dk-lam-b!)
                (if (nne-open?)
                    (dk-if-branch! #f (ift (list fn (list ph n)) n) #f
                      (lambda () (if (dk-contains? (dk-goal) 'IDEN) (subst (list '== (list 'IDEN AG) 0))) (nne-close!))))))))
        (list G H) '(a m) (list (list 'IDEN AG) 0))
      ;; a vanishes off its support
      (nne-have! (list 'FORALL 'nep_ (list 'IMPLIES '(IN nep_ ix) (list 'IMPLIES (list 'NOT (list 'IN 'nep_ P)) (list '= '(a nep_) (list 'IDEN AG)))))
        (lambda ()
          (dk-peel!)
          (let* ((x (cadr (cadr (dk-goal)))) (ax (list 'a x)) (mx (list 'm x)))
            (subst (list '== (list 'IDEN AG) 0))
            (nne-ap! 'a 'ix 'CC x) (nne-ap! 'm 'ix 'RR x)
            (fact 'cc-magnitude-nonneg ax) (fact 'cc-magnitude-closed ax)
            (dk-apply! mdef x)
            (use-em (list '< 0 mx)
              (lambda () (nne-have! (list 'IN x P) (lambda () (in-sep! (lambda () (nne-close!)) (lambda () (nne-close!)))))
                         (nne-absurd! (list 'IN x P)))
              (lambda ()
                (nne-cite! 'rr-not-lt-ge 0 mx)
                (nne-have! (list '= (list 'magnitude ax) 0)
                  (lambda () (dk-ineq! (list '<= mx 0) (list '= mx (list 'magnitude ax)) (list '<= 0 (list 'magnitude ax)))))
                (dk-iff-fwd! (nne-cite! 'cc-magnitude-zero-iff ax))
                (nne-close!))))))
      (nne-cite! 'sums-to-nn-transfer 'CC-NAG 'ix M P ph 'a G 'r)
      (nne-cite! 'nn-sums-to-series G 'r)
      (nne-cite! 'esum-nn-transfer-le 'ix M ph 'm H)
      (ew M) (ew ph)
      (dk-conj-close! (lambda () (nne-close!))))))
(nne-done! 'cc-family-nn-series)
