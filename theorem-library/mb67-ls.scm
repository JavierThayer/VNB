;;; mb67-ls.scm -- construction of measures, chapter 5 sections 1.6-1.7 (M-B67, 2026-10-26): Borel partitions of a
;;; separable space into small pieces (Proposition 5.28) and the Lusin-Souslin theorem (Proposition 5.30: an
;;; injective continuous image of a Polish space is Borel), with Corollary 5.31 (in a Polish space the Borel sets are
;;; exactly the Lusin sets).  The partition of level i is cut out of the balls of radius 1/(i+1) about a dense
;;; sequence (5.28); the cells of level n are the intersections along the codes m of N (BAIRE-CODE), one cell per
;;; finite sequence (the least code of each prefix); their images are separated level by level by Corollary 5.27,
;;; and the separators are kept coherent along the tree; no closure is used (the closure of an image is replaced by
;;; its open 1/(n+1)-neighbourhood).
;;; Library: measure.  Helper prefixes mr- (copied), mls-.
;;; Load window: after mb67-sep (souslin-disjoint-envelopes), mb67-baire (baire-code-prefix), mb67-souslin
;;; (borel-polish-souslin, souslin-continuous-image), nn-least-element, push-forward (pfw-open-borel), ball-is-open.
(define (mr-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (mr-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (mr-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
(define (mr-iff-parts! iff)
  ;; the conjunct equal to the focus GOAL (if any) is projected LAST: proving it closes the leaf, and a
  ;; projection after that would fire on a sibling (focus drift)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc)))))
         (goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
         (opener (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
         (rest (filter (lambda (c) (not (goal? c))) cs))
         (last (filter goal? cs)))
    (append (mr-map (lambda (c) (mr-project! c opener)) rest)
            (mr-map (lambda (c) (mr-project! c opener)) last))))
(define (mr-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (mr-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))
(define (mr-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
(define (mr-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
(define (mr-ne! a b lt)
  (dk-have! (list 'NOT (list '= a b))
    (lambda ()
      (di)
      (dk-have! '(< 0 0) (lambda () (dk-ineq! lt (list '= a b))))
      (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
      (ai (dk-cite! 'rr-lt-irrefl 0)))))
(define (mr-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s0 (caddr m)) (v (cadr s0)) (dom (caddr s0))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s0)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "mr-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (ai (dk-ctx-form conj))))
    p))
(define (mr-and-close! closer)
  (if (dk-head-is? (dk-goal) 'AND)
      (for-each (lambda (k) (dk-focus! k) (mr-and-close! closer)) (dk-opened (lambda () (di))))
      (closer)))
(define (mr-find tag pred lst)
  (or (find-first pred lst) (error "mr-find: nothing matches at" tag (map expression->string lst))))
(define (mr-real! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)) (list 'IN t 'RR))
(define (mr-pos! e) (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))
(define (mr-recip! k)              ; recip(k + 1), k in NN: typed, positive (idempotent)
  (let* ((k1 (list '+ k 1)) (rq (list 'RECIP k1)))
   (if (dk-asm? (list 'POS-RR rq))
    rq
    (begin
    (dk-cite! 'nn-in-rr k) (dk-type! k1 'RR)
    (dk-have! (list '< 0 k1) (lambda () (dk-cite! 'nn-zero-le k) (dk-ineq! (list '<= 0 k))))
    (mr-ne! k1 0 (list '< 0 k1))
    (mr-chain! (dk-fact! 'rr-recip-closed k1))
    (dk-cite! 'rr-recip-pos k1)
    (dk-cite! 'rr-pos-rr-of-lt rq)
    rq))))
(define (mr-sep-open! sp0)           ; IS-SEPARABLE(sp0) in context: is-metric-space and a dense sequence, returned
  (let* ((iff (dk-cite! 'is-separable sp0)) (rhs (caddr iff)) (ex (caddr rhs)))
    (dk-project! (list 'IS-METRIC-SPACE sp0) (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (dk-project! ex (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (let ((d (dk-skolem! ex))) (dk-split-all!) d)))
(define (mr-dense ds sp0) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'PTS sp0)) (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
  (list 'FORSOME 'n (list 'AND '(IN n NN) (list '< (list (list 'DIST sp0) 'x (list ds 'n)) 'eps))))))))
(define (mr-iff-back! iff)           ; the right side of an IFF in context (proved by the caller): land the left side
  (ai iff)
  (detach! (list 'IMPLIES (caddr iff) (cadr iff))))

(define mls-F '(FUN NN NN))
(define mls-BT '(BOREL-SETS t))
(define (mls-R i) (list 'RECIP (list '+ i 1)))
(define (mls-fball r) (list 'VNB-LAMBDA 'mbj_ 'NN (list 'BALL 't '(ds mbj_) r)))
(define (mls-segU r k) (list 'BIG-UNION 'uj_ (list 'ORD-SEGMENT k) (list (mls-fball r) 'uj_)))
(define (mls-P r k) (list 'COMPLEMENT-IN (list 'BALL 't (list 'ds k) r) (mls-segU r k)))
(define mls-dense (mr-dense 'ds 't))
(define (mls-hyp body) (list 'FORALL 't (list 'IMPLIES '(IS-METRIC-SPACE t) (list 'FORALL 'ds (list 'IMPLIES '(IN ds (FUN NN (PTS t)))
                         (list 'IMPLIES mls-dense (list 'FORALL 'r (list 'IMPLIES '(POS-RR r) body))))))))
(define (mls-ball-borel! c r)        ; c in PTS t, r typed positive: BALL(t, c, r) Borel
  (if (not (dk-asm? (list 'IN (list 'BALL 't c r) mls-BT)))
      (begin
        (if (not (dk-asm? (list '<= 0 r))) (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r)))))
        (if (not (dk-asm? (list 'NOT (list '= 0 r)))) (mr-ne! 0 r (list '< 0 r)))
        (mr-chain! (dk-fact! 'ball-is-open 't c r))
        (dk-cite! 'pfw-open-borel 't (list 'BALL 't c r)))))
(define (mls-ball-lt! c y r)         ; y in BALL(t, c, r) in context: y in PTS t and d(c, y) < r
  (let* ((d (list '(DIST t) c y))
         (ps (mr-iff-parts! (dk-cite! 'ball-membership 't c r y))))
    (dk-cite! 'metric-dist-real 't c y)
    (if (not (dk-asm? (list '< d r)))
        (begin
          (dk-have! (list 'AND (list '<= d r) (list 'NOT (list '= d r))) (lambda () (dk-conj-close! (lambda () (ass)))))
          (mr-chain! (dk-fact! 'rr-le-ne-lt d r))))
    (list '< d r)))
(define (mls-in-ball! c y r)         ; y in PTS t, d(c, y) < r, typed: y in BALL(t, c, r)
  (let ((d (list '(DIST t) c y)))
    (dk-cite! 'metric-dist-real 't c y)
    (if (not (dk-asm? (list '<= d r))) (dk-have! (list '<= d r) (lambda () (dk-ineq! (list '< d r)))))
    (if (not (dk-asm? (list 'NOT (list '= d r)))) (mr-ne! d r (list '< d r)))
    (dk-have! (list 'IN y (list 'BALL 't c r))
      (lambda () (mac 'ball-membership) (dk-conj-close! (lambda () (ass)))))))
(define (mls-close-owed! ls)          ; ls opened by a beta step: close the owed typings, refocus the main leaf
  (let ((main #f))
    (for-each (lambda (l0) (if (not (sequent-node-grounded? l0))
                               (begin (dk-focus! l0) (if (dk-asm? (dk-goal)) (ass) (set! main l0)))))
              ls)
    (if main (dk-focus! main))))
(define (mls-lam-b1!) (mls-close-owed! (dk-opened (lambda () (lam-b)))))
(define (mls-lam-bh1! f) (mls-close-owed! (dk-opened (lambda () (lam-b-h f)))))
(define (mls-lam-app? x) (and (pair? x) (pair? (car x)) (eq? (car (car x)) 'VNB-LAMBDA)))
(define (mls-app-goal?)              ; the goal is (IN z (COMPLEMENT-IN a X)) or (IN z X) with X an applied lambda
  (let ((g (dk-goal)))
    (and (dk-head-is? g 'IN)
         (or (mls-lam-app? (caddr g))
             (and (dk-head-is? (caddr g) 'COMPLEMENT-IN) (mls-lam-app? (caddr (caddr g))))))))
(define (mls-sep-of! z)              ; z in (lambda applied) or z in SEP in context: reduce if needed, return the SEP membership
  (let ((app (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) z) (mls-lam-app? (caddr f)))) (dk-asms))))
    (if app (mls-lam-bh1! app))
    (mr-find 'zs (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) z) (dk-head-is? (caddr f) 'SEP))) (dk-asms))))
(define (mls-close-at! kn)           ; the open leaves under kn, if a citation did not already close them
  (for-each (lambda (lf)
              (if (not (sequent-node-grounded? lf))
                  (begin (dk-focus! lf)
                         (if (not (dk-ctx-form (dk-goal))) (mls-lam-b1!))
                         (if (not (sequent-node-grounded? lf)) (begin (dk-focus! lf) (ass))))))
            (dk--open-below kn)))
(define (mls-lam-type! claim per-var!) ; claim (IN lambda (FUN A B)): lam-t, PER-VAR! on the peeled variable of each pointwise leaf
  (dk-have! claim
    (lambda ()
      (for-each (lambda (kn)
                  (if (not (sequent-node-grounded? kn))
                      (begin (dk-focus! kn)
                             (if (dk-asm? (dk-goal)) (ass)
                                 (let ((v (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                                   (per-var! v)
                                   (mls-close-at! kn))))))
                (dk-opened (lambda () (lam-t)))))))
(define (mls-fball-type! r)          ; the family of balls about ds of radius r is in FUN(NN, BOREL(t))
  (mls-lam-type! (list 'IN (mls-fball r) (list 'FUN 'NN mls-BT))
    (lambda (j) (dk-cite! 'fun-apply-type-c 'ds 'NN '(PTS t) j) (mls-ball-borel! (list 'ds j) r))))
(define (mls-segU-open! x r k)       ; x in segU(r, k) in context: j < k, j in NN, x in BALL(ds j, r); returns j
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN x (mls-segU r k))))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'ORD-SEGMENT k)))) landed))
         (j (cadr ein)))
    (dk-cite! 'ord-segment-nn-subset k j)
    (mr-iff-parts! (dk-cite! 'seg-mem-lt k j))
    (for-each (lambda (f) (if (and (not (eq? f ein)) (dk-contains? f 'mbj_)) (dk-lam-b-h! f))) landed)
    j))
(define (mls-segU-in! x r k j)       ; j < k (j, k in NN), x in BALL(ds j, r): x in segU(r, k)
  (if (not (dk-asm? (list 'IN j (list 'ORD-SEGMENT k)))) (mr-iff-back! (dk-cite! 'seg-mem-lt k j)))
  (dk-have! (list 'IN x (mls-segU r k))
    (lambda ()
      (for-each (lambda (l0) (if (not (sequent-node-grounded? l0))
                                 (begin (dk-focus! l0)
                                        (if (dk-asm? (dk-goal)) (ass) (begin (dk-lam-b!) (mr-close-open!))))))
                (dk-opened (lambda () (bu-mi j)))))))
(define (mls-P-parts! x r k)         ; x in P(r, k) in context: x in BALL(ds k, r), x not in segU(r, k)
  (mr-iff-parts! (dk-cite! 'complement-in-membership (list 'BALL 't (list 'ds k) r) (mls-segU r k) x)))

