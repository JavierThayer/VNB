(define (mls-hval! a)                ; a in PTS t: h(a) in e and in PTS s
  (dk-cite! 'fun-apply-type-c 'h '(PTS t) 'e a)
  (dk-cite! 'subset-mem-fwd 'e '(PTS s) (list 'h a)))
(let ((iff (dk-cite! 'fun-codomain-iff '(PTS t) '(PTS s) 'h)))
  (dk-have! (caddr iff)
    (lambda () (mr-and-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (let ((a (dk-di-var!))) (mls-hval! a) (mr-close-open!)))))))
  (mr-iff-back! iff))
(define mls-call (mr-find 'call (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-CONTINUOUS-AT))) (dk-asms)))
(let ((iff (dk-cite! 'is-continuous 't 's 'h)))
  (dk-have! (caddr iff)
    (lambda ()
      (mr-and-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (let ((a (dk-di-var!)))
                (dk-apply! mls-call a)
                (let* ((ps (mr-iff-parts! (dk-cite! 'is-continuous-at 't mls-sub 'h a)))
                       (cl (car (last-pair ps)))
                       (iff2 (dk-cite! 'is-continuous-at 't 's 'h a)))
                  (mls-hval! a)
                  (dk-have! (caddr iff2)
                    (lambda ()
                      (mr-and-close!
                        (lambda ()
                          (if (dk-asm? (dk-goal)) (ass)
                              (let* ((ls (dk-peel!)) (eps (cadr (mr-find 'eps (lambda (f) (dk-head-is? f 'POS-RR)) ls)))
                                     (dl (dk-skolem! (dk-apply! cl eps))))
                                (dk-split-all!)
                                (ew dl)
                                (mr-and-close!
                                  (lambda ()
                                    (if (dk-asm? (dk-goal)) (ass)
                                        (let* ((lb (dk-peel!))
                                               (b (cadr (mr-find 'b (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(PTS t)))) lb))))
                                          (mls-hval! b)
                                          (dk-apply! (mr-find 'bcl (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f dl))) (dk-asms)) b)
                                          (dk-cite! 'subspace-dist 's 'e (list 'h a) (list 'h b))
                                          (subst (list '= (list '(DIST s) (list 'h a) (list 'h b)) (list (list 'DIST mls-sub) (list 'h a) (list 'h b))))
                                          (mr-close-open!)))))))))))
                  (mr-iff-back! iff2)
                  (mr-close-open!))))))))
  (mr-iff-back! iff))
(mr-close-open!)
(qed 'continuous-into-subspace-ambient)
(topic! 'continuous-into-subspace-ambient 'analysis)

;;; a Lusin set is Borel
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (FORALL e (IMPLIES (SUBSET e (PTS s)) (IMPLIES (IS-LUSIN s e) (IN e (BOREL-SETS s)))))))))
(dk-peel!)
(let* ((ps (mr-iff-parts! (dk-cite! 'is-lusin 's 'e)))
       (t0 (dk-skolem! (car ps))))
  (dk-split-all!)
  (let ((h0 (dk-skolem! (mr-find 'lh (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f t0))) (dk-asms)))))
    (dk-split-all!)
    (let ((iff (dk-cite! 'is-polish t0))) (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (ass))))) (mr-iff-back! iff))
    (dk-cite! 'continuous-into-subspace-ambient 's 'e t0 h0)
    (dk-cite! 'lusin-souslin t0 's h0)
    (subst (list '= 'e (list 'IMAGE h0 (list 'PTS t0))))
    (mr-close-open!)))
(qed 'lusin-borel)
(topic! 'lusin-borel 'analysis)

;;; COROLLARY 5.31: in a Polish space the Borel sets are exactly the Lusin sets (and the empty set)
(sp (make-wff '(FORALL s (IMPLIES (IS-POLISH s) (FORALL e (IMPLIES (SUBSET e (PTS s))
  (IFF (IN e (BOREL-SETS s)) (IMPLIES (FORSOME mbx_ (IN mbx_ e)) (IS-LUSIN s e)))))))))
(dk-peel!)
(mr-iff-parts! (dk-cite! 'is-polish 's))
(mr-iff-parts! (dk-cite! 'is-complete 's))
(dk-cite! 'pfw-borel-sigma-algebra 's)
(dk-iff! (lambda (g) (dk-head-is? g 'IMPLIES))
  (lambda () (di) (dk-cite! 'borel-polish-lusin 's 'e) (mr-close-open!))
  (lambda ()
    (use-em '(FORSOME mbx_ (IN mbx_ e))
      (lambda () (mr-chain! (dk-ctx-form '(IMPLIES (FORSOME mbx_ (IN mbx_ e)) (IS-LUSIN s e)))) (dk-cite! 'lusin-borel 's 'e) (mr-close-open!))
      (lambda ()
        (dk-cite! 'sigma-algebra-empty-in '(PTS s) '(BOREL-SETS s))
        (mr-ext2! 'e 'EMPTY-SET
          (lambda (z) (dk-have! '(FORSOME mbx_ (IN mbx_ e)) (lambda () (ew z) (mr-close-open!))) (pbc) (ai '(NOT (FORSOME mbx_ (IN mbx_ e)))))
          (lambda (z) (dk-cite! 'empty-set-has-no-members z) (pbc) (ai (list 'NOT (list 'IN z 'EMPTY-SET)))))
        (subst '(= e EMPTY-SET))
        (mr-close-open!)))))
(qed 'polish-borel-iff-lusin)
(topic! 'polish-borel-iff-lusin 'analysis)

;;; ======================================================================
;;; composition of continuous maps of metric spaces; PROPOSITION 5.30 in the notes' form
;;; ======================================================================
(define mls-comp '(VNB-LAMBDA cz_ (PTS r) (f (g cz_))))
;;; CUT 2026-10-27 (integration): `continuous-compose-ms' was an accidental duplicate -- its statement is alpha-equal to the tree's
;;; `ms-compose-continuous', which is cited below in its place (proven-duplicate audit).

;;; PROPOSITION 5.30 as stated in the notes: eb Borel in a Polish X, phi continuous and injective on eb => phi(eb) Borel
(define mls-cmp-cur #f) (define mls-g0-cur #f) (define mls-t0-cur #f)
(define (mls-gv! x)                  ; x in PTS t0: g0 x in eb, phi (g0 x) in PTS s
  (dk-cite! 'fun-apply-type-c mls-g0-cur (list 'PTS mls-t0-cur) 'eb x)
  (dk-cite! 'fun-apply-type-c 'phi 'eb '(PTS s) (list mls-g0-cur x)))
(define (mls-cmpv! x)                    ; x in PTS t0: cmp(x) = phi(g0 x)
  (mls-gv! x)
  (dk-have! (list '= (list mls-cmp-cur x) (list 'phi (list mls-g0-cur x)))
    (lambda () (mls-lam-b1!) (if (not (dk-ctx-form (dk-goal))) (rfl) (ass)))))
(define mls-injE '(FORALL x (IMPLIES (IN x eb) (FORALL x2 (IMPLIES (IN x2 eb) (IMPLIES (= (phi x) (phi x2)) (= x x2)))))))
(sp (make-wff (list 'FORALL 'xsp (list 'IMPLIES '(IS-POLISH xsp) (list 'FORALL 'eb (list 'IMPLIES '(IN eb (BOREL-SETS xsp))
  (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'FORALL 'phi (list 'IMPLIES '(IS-CONTINUOUS (SUBSPACE-MS xsp eb) s phi)
    (list 'IMPLIES mls-injE '(IN (IMAGE phi eb) (BOREL-SETS s)))))))))))))
(dk-peel!)
(mr-iff-parts! (dk-cite! 'is-polish 'xsp))
(mr-iff-parts! (dk-cite! 'is-complete 'xsp))
(dk-cite! 'pfw-borel-sigma-algebra 's)
(dk-cite! 'pfw-borel-sigma-algebra 'xsp)
(mr-iff-parts! (dk-cite! 'is-sigma-algebra '(PTS xsp) '(BOREL-SETS xsp)))
(dk-cite! 'subset-mem-fwd '(BOREL-SETS xsp) '(POWER (PTS xsp)) 'eb)
(dk-cite! 'ms-pts-is-set 'xsp)
(dk-have! '(SUBSET eb (PTS xsp)) (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (dk-cite! 'power-mem-in '(PTS xsp) 'eb z) (mr-close-open!))))
(dk-cite! 'subclass-of-set-is-set 'eb '(PTS xsp))
(dk-cite! 'subspace-pts 'xsp 'eb)
(mr-iff-parts! (dk-cite! 'is-continuous '(SUBSPACE-MS xsp eb) 's 'phi))
(dk-have! '(IN phi (FUN eb (PTS s))) (lambda () (subst '(= eb (PTS (SUBSPACE-MS xsp eb)))) (mr-close-open!)))
(use-em '(FORSOME mbx_ (IN mbx_ eb))
  (lambda ()
    (dk-cite! 'borel-polish-lusin 'xsp 'eb)
    (let* ((ps (mr-iff-parts! (dk-cite! 'is-lusin 'xsp 'eb)))
           (t0 (dk-skolem! (car ps))))
      (dk-split-all!)
      (let* ((g0 (dk-skolem! (mr-find 'lh (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f t0))) (dk-asms))))
             (cmp (subst-free 'r t0 (subst-free 'g g0 (subst-free 'f 'phi mls-comp)))))
        (set! mls-cmp-cur cmp) (set! mls-g0-cur g0) (set! mls-t0-cur t0)
        (dk-split-all!)
        (let ((iff (dk-cite! 'is-polish t0))) (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (ass))))) (mr-iff-back! iff))
        (dk-cite! 'ms-compose-continuous t0 '(SUBSPACE-MS xsp eb) 's g0 'phi)
        (mr-iff-parts! (dk-cite! 'is-continuous t0 '(SUBSPACE-MS xsp eb) g0))
        (dk-have! (list 'IN g0 (list 'FUN (list 'PTS t0) 'eb)) (lambda () (subst '(= eb (PTS (SUBSPACE-MS xsp eb)))) (mr-close-open!)))
        ;; injective
        (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'PTS t0)) (list 'FORALL 'x2 (list 'IMPLIES (list 'IN 'x2 (list 'PTS t0))
                    (list 'IMPLIES (list '= (list cmp 'x) (list cmp 'x2)) '(= x x2))))))
          (lambda ()
            (let* ((ls (dk-peel!)) (xs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'PTS t0)))) ls)))
                   (a (car xs)) (b (cadr xs)))
              (mls-cmpv! a) (mls-cmpv! b)
              (dk-have! (list '= (list 'phi (list g0 a)) (list 'phi (list g0 b)))
                (lambda () (subst (list '= (list 'phi (list g0 a)) (list cmp a))) (subst (list '= (list 'phi (list g0 b)) (list cmp b))) (mr-close-open!)))
              (dk-apply! (dk-ctx-form mls-injE) (list g0 a) (list g0 b))
              (dk-apply! (mr-find 'ginj (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f (list 'PTS t0)) (dk-contains? f 'IMPLIES) (dk-contains? f '=)
                                                         (not (dk-contains? f cmp)) (not (dk-contains? f 'phi)))) (dk-asms)) a b)
              (mr-close-open!))))
        (dk-cite! 'lusin-souslin t0 's cmp)
        ;; the image of the composite is phi(eb)
        (let ((ieq (list 'IMAGE g0 (list 'PTS t0))))
          (mr-ext2! (list 'IMAGE cmp (list 'PTS t0)) '(IMAGE phi eb)
            (lambda (y)
              (let ((x (mls-img-open! cmp (list 'PTS t0) y)))
                (mls-cmpv! x)
                (dk-cite! 'membership-implies-sethood y '(PTS s))
                (let ((iff (dk-cite! 'image-membership-iff 'phi 'eb y)))
                  (dk-have! (caddr iff)
                    (lambda () (mr-and-close! (lambda () (cond ((dk-asm? (dk-goal)) (ass))
                                                               ((dk-head-is? (dk-goal) 'FORSOME)
                                                                (ew (list g0 x))
                                                                (mr-and-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                                                              (begin (subst (list '= (list 'phi (list g0 x)) (list cmp x))) (mr-close-open!))))))
                                                               (#t (error "img1" (expression->string (dk-goal)))))))))
                  (mr-iff-back! iff)
                  (mr-close-open!))))
            (lambda (y)
              (let* ((e1 (mls-img-open! 'phi 'eb y))
                     (h1 (dk-rewrite-h! (list 'IN e1 'eb) 'eb ieq))
                     (x (mls-img-open! g0 (list 'PTS t0) e1)))
                (mls-cmpv! x)
                (dk-cite! 'fun-apply-type-c 'phi 'eb '(PTS s) e1)
                (dk-cite! 'membership-implies-sethood y '(PTS s))
                (let ((iff (dk-cite! 'image-membership-iff cmp (list 'PTS t0) y)))
                  (dk-have! (caddr iff)
                    (lambda () (mr-and-close! (lambda () (cond ((dk-asm? (dk-goal)) (ass))
                                                               ((dk-head-is? (dk-goal) 'FORSOME)
                                                                (ew x)
                                                                (mr-and-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                                                              (begin (subst (list '= (list cmp x) (list 'phi (list g0 x))))
                                                                                                     (subst (list '= (list g0 x) e1))
                                                                                                     (mr-close-open!))))))
                                                               (#t (error "img2" (expression->string (dk-goal)))))))))
                  (mr-iff-back! iff)
                  (mr-close-open!))))))
        (subst (list '= '(IMAGE phi eb) (list 'IMAGE cmp (list 'PTS t0))))
        (mr-close-open!))))
  (lambda ()
    (dk-cite! 'sigma-algebra-empty-in '(PTS s) '(BOREL-SETS s))
    (mr-ext2! '(IMAGE phi eb) 'EMPTY-SET
      (lambda (y) (let ((x (mls-img-open! 'phi 'eb y)))
                    (dk-have! '(FORSOME mbx_ (IN mbx_ eb)) (lambda () (ew x) (mr-close-open!)))
                    (pbc) (ai '(NOT (FORSOME mbx_ (IN mbx_ eb))))))
      (lambda (y) (dk-cite! 'empty-set-has-no-members y) (pbc) (ai (list 'NOT (list 'IN y 'EMPTY-SET)))))
    (subst '(= (IMAGE phi eb) EMPTY-SET))
    (mr-close-open!)))
(qed 'lusin-souslin-borel-domain)
(topic! 'lusin-souslin-borel-domain 'analysis)
