(define mls-inj '(FORALL x (IMPLIES (IN x (PTS t)) (FORALL x2 (IMPLIES (IN x2 (PTS t)) (IMPLIES (= (h x) (h x2)) (= x x2)))))))
(define (mls-hyp3 body) (list 'FORALL 't (list 'IMPLIES '(IS-POLISH t) (list 'FORALL 'ds (list 'IMPLIES '(IN ds (FUN NN (PTS t)))
  (list 'IMPLIES mls-dense (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'FORALL 'h (list 'IMPLIES '(IS-CONTINUOUS t s h)
    (list 'IMPLIES mls-inj body)))))))))))
(define (mls-dj e) (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'l (list 'IMPLIES '(IN l NN) (list 'IMPLIES '(NOT (= k l))
                     (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list e 'k)) (list 'NOT (list 'IN 'x (list e 'l)))))))))))
(define (mls-seh e) (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES (list 'FORSOME 'mbx_ (list 'IN 'mbx_ (list e 'k))) (list 'IS-SOUSLIN 's (list e 'k))))))
(define mls-BS '(BOREL-SETS s))
(define (mls-env n) (list 'FORSOME 'g (list 'AND (list 'IN 'g (list 'FUN 'NN mls-BS))
  (list 'AND (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'SUBSET (list 'IMAGE 'h (mls-cell n 'm)) '(g m)))) (mls-dj 'g)))))
(define (mls-tsetup!)                ; after the peel of mls-hyp3: the standing facts about t, s, h
  (mr-iff-parts! (dk-cite! 'is-polish 't))
  (mr-iff-parts! (dk-cite! 'is-complete 't))
  (mr-iff-parts! (dk-cite! 'is-continuous 't 's 'h))
  (fact 'nn-is-set)
  (dk-cite! 'ms-pts-is-set 't)
  (dk-cite! 'ms-pts-is-set 's))
(define (mls-cell-sub! n m)          ; cell(n, m) subset PTS t, and a set
  (let ((c (mls-cell n m)))
    (if (not (dk-asm? (list 'SUBSET c '(PTS t))))
        (begin
          (dk-have! (list 'SUBSET c '(PTS t))
            (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (mr-sep-parts! (list 'IN z c)) (mr-close-open!))))
          (dk-cite! 'subclass-of-set-is-set c '(PTS t))))))
(define (mls-img-open! f dom p)      ; p in IMAGE(f, dom) in context: the witness x, x in dom and f(x) = p landed
  (let* ((ps (mr-iff-parts! (dk-cite! 'image-membership-iff f dom p)))
         (x (dk-skolem! (cadr ps))))
    (dk-split-all!)
    x))
(define (mls-img-power! n m)         ; IMAGE(h, cell(n, m)) in POWER(PTS s)
  (let* ((c (mls-cell n m)) (im (list 'IMAGE 'h c)))
    (mls-cell-sub! n m)
    (dk-cite! 'image-set 'h c)
    (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ im) '(IN z_ (PTS s))))
      (lambda ()
        (let* ((y (dk-di-var!)) (x (mls-img-open! 'h c y)))
          (dk-cite! 'subset-mem-fwd c '(PTS t) x)
          (dk-cite! 'fun-apply-type-c 'h '(PTS t) '(PTS s) x)
          (subst (list '= y (list 'h x)))
          (mr-close-open!))))
    (dk-cite! 'power-mem-intro '(PTS s) im)))
(sp (make-wff (mls-hyp3 (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (mls-env 'n))))))
(dk-peel!)
(mls-tsetup!)
(define mls-BF (list 'VNB-LAMBDA 'mbm_ 'NN (list 'IMAGE 'h (mls-cell 'n 'mbm_))))
(mls-lam-type! (list 'IN mls-BF '(FUN NN (POWER (PTS s)))) (lambda (m) (mls-img-power! 'n m)))
(dk-have! (mls-seh mls-BF)
  (lambda ()
    (let* ((ls (dk-peel!)) (k (cadr (mr-find 'k (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ls)))
           (ex (if (eq? (dk-goal) 'FALSITY) #f (begin (if (dk-head-is? (dk-goal) 'IMPLIES) (di)) #t)))
           (y (dk-skolem! (mr-find 'ey (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'mbx_))) (dk-asms)))))
      (dk-split-all!)
      (mls-lam-bh1! (list 'IN y (list mls-BF k)))
      (let* ((c (mls-cell 'n k)) (x (mls-img-open! 'h c y)))
        (mls-cell-sub! 'n k)
        (dk-cite! 'dense-cell-borel 't 'ds 'n k)
        (dk-have! (list 'FORSOME 'x (list 'IN 'x c)) (lambda () (ew x) (mr-close-open!)))
        (dk-cite! 'borel-polish-souslin 't c)
        (dk-cite! 'souslin-continuous-image 't 's 'h c)
        (if (mls-lam-app? (caddr (dk-goal))) (mls-lam-b1!))
        (mr-close-open!)))))
(dk-have! (mls-dj mls-BF)
  (lambda ()
    (let* ((ls (dk-peel!))
           (ne (cadr (mr-find 'ne (lambda (f) (and (dk-head-is? f 'NOT) (dk-head-is? (cadr f) '=))) ls)))
           (k (cadr ne)) (l (caddr ne))
           (y (cadr (mr-find 'y (lambda (f) (and (dk-head-is? f 'IN) (mls-lam-app? (caddr f)))) ls))))
      (if (not (eq? (dk-goal) 'FALSITY)) (di))
      (mls-lam-bh1! (list 'IN y (list mls-BF k)))
      (mls-lam-bh1! (list 'IN y (list mls-BF l)))
      (let* ((ck (mls-cell 'n k)) (cl (mls-cell 'n l))
             (x (mls-img-open! 'h ck y)) (x2 (mls-img-open! 'h cl y)))
        (mls-cell-sub! 'n k) (mls-cell-sub! 'n l)
        (dk-cite! 'subset-mem-fwd ck '(PTS t) x)
        (dk-cite! 'subset-mem-fwd cl '(PTS t) x2)
        (dk-have! (list '= (list 'h x) (list 'h x2)) (lambda () (subst (list '= (list 'h x) y)) (subst (list '= (list 'h x2) y)) (dk-cite! 'fun-apply-type-c 'h '(PTS t) '(PTS s) x2) (rfl)))
        (dk-apply! (dk-ctx-form mls-inj) x x2)
        (dk-apply! (dk-cite! 'dense-cell-disjoint 't 'ds 'n k l) x)
        (dk-rewrite-h! (list 'NOT (list 'IN x cl)) x x2)
        (ai (list 'NOT (list 'IN x2 cl)))))))
(define mls-ee (dk-skolem! (dk-cite! 'souslin-disjoint-envelopes 's mls-BF)))
(dk-split-all!)
(ew mls-ee)
(mr-and-close!
  (lambda ()
    (cond
      ((dk-asm? (dk-goal)) (ass))
      ((dk-ctx-form (dk-goal)) (ass))
      (#t
       (let ((m (cadr (car (dk-peel!)))))
         (dk-apply! (mr-find 'esub (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'SUBSET) (dk-contains? f mls-ee))) (dk-asms)) m)
         (mls-lam-bh1! (list 'SUBSET (list mls-BF m) (list mls-ee m)))
         (mr-close-open!))))))
(qed 'dense-image-envelopes)
(topic! 'dense-image-envelopes 'analysis)

;;; ======================================================================
;;; the envelopes of all levels at once (countable choice)
;;; ======================================================================
(define (mls-GGprop n) (list 'AND (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'SUBSET (list 'IMAGE 'h (mls-cell n 'm)) (list (list 'GG n) 'm))))
                              (mls-dj (list 'GG n))))
(define mls-GGty (list 'IN 'GG (list 'FUN 'NN (list 'FUN 'NN mls-BS))))
(define mls-GGall (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (mls-GGprop 'n))))
(define mls-gfam (list 'VNB-LAMBDA 'mgn_ 'NN (list 'SEP 'mgg_ (list 'FUN 'NN mls-BS)
  (list 'AND (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'SUBSET (list 'IMAGE 'h (mls-cell 'mgn_ 'm)) '(mgg_ m)))) (mls-dj 'mgg_)))))
(sp (make-wff (mls-hyp3 (list 'FORSOME 'GG (list 'AND mls-GGty mls-GGall)))))
(dk-peel!)
(dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'FORSOME 'y (list 'AND (list 'IN 'y (list 'FUN 'NN mls-BS)) (list 'IN 'y (list mls-gfam 'i))))))
  (lambda ()
    (let* ((i (dk-di-var!)) (g (dk-skolem! (dk-cite! 'dense-image-envelopes 't 'ds 's 'h i))))
      (dk-split-all!)
      (ew g)
      (mr-and-close!
        (lambda ()
          (if (dk-ctx-form (dk-goal)) (ass)
              (begin (mls-lam-b1!) (in-sep! (lambda () (mr-and-close! (lambda () (if (dk-ctx-form (dk-goal)) (ass) (mr-close-open!)))))))))))))
(define mls-GGc (dk-skolem! (dk-cite! 'rmm-nn-choice (list 'FUN 'NN mls-BS) mls-gfam)))
(dk-split-all!)
(define mls-gch (mr-find 'gch (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f mls-GGc) (dk-contains? f 'mgg_))) (dk-asms)))
(ew mls-GGc)
(mr-and-close!
  (lambda ()
    (if (dk-ctx-form (dk-goal)) (ass)
        (let ((n (cadr (car (dk-peel!)))))
          (dk-apply! mls-gch n)
          (dk-cite! 'fun-apply-type-c mls-GGc 'NN (list 'FUN 'NN mls-BS) n)
          (dk-split-all! (list (mr-sep-parts! (mls-sep-of! (list mls-GGc n)))))
          (mr-and-close! (lambda () (if (dk-ctx-form (dk-goal)) (ass) (mr-close-open!))))))))
(qed 'dense-envelopes-all-levels)
(topic! 'dense-envelopes-all-levels 'analysis)

;;; ======================================================================
;;; the Borel set F = intersection over n of the union over m of D(n, m)
;;; ======================================================================
(define (mls-hyp4 body) (mls-hyp3 (list 'FORALL 'GG (list 'IMPLIES mls-GGty (list 'IMPLIES mls-GGall body)))))
(define (mls-G n m) (list (list 'GG n) m))
(define (mls-B n m) (list 'IMAGE 'h (mls-cell n m)))
(define (mls-U n m) (mls-NB (mls-B n m) (mls-R n)))
(define (mls-W i m2 m) (list 'SEP 'mwy_ '(PTS s) (list 'AND (list 'AND (mls-minL (list 'succ i) m2) (mls-agree-codes m2 m (list 'succ i)))
                                                       (list 'IN 'mwy_ (mls-G i m2)))))
(define (mls-V i m) (list 'BIG-UNION 'vm_ 'NN (mls-W i 'vm_ m)))
(define (mls-Vp n m i) (list 'SEP 'mvy_ '(PTS s) (list 'IMPLIES (list '< i n) (list 'IN 'mvy_ (mls-V i m)))))
(define (mls-H n m) (list 'COMPLEMENT-IN '(PTS s) (list 'BIG-UNION 'hi_ 'NN (list 'COMPLEMENT-IN '(PTS s) (mls-Vp n m 'hi_)))))
(define (mls-D n m) (list 'INTERSECTION (mls-G n m) (list 'INTERSECTION (mls-U n m) (mls-H n m))))
(define (mls-FF n) (list 'BIG-UNION 'fm_ 'NN (mls-D n 'fm_)))
(define mls-FINAL (list 'COMPLEMENT-IN '(PTS s) (list 'BIG-UNION 'fn_ 'NN (list 'COMPLEMENT-IN '(PTS s) (mls-FF 'fn_)))))
(define (mls-bs-parts!)              ; the Borel sets of s: a sigma-algebra on PTS s, members subsets
  (if (not (dk-asm? (list 'SUBSET mls-BS '(POWER (PTS s)))))
      (begin (dk-cite! 'pfw-borel-sigma-algebra 's)
             (mr-iff-parts! (dk-cite! 'is-sigma-algebra '(PTS s) mls-BS)))))
(define (mls-bs-pts! c x)            ; c Borel(s), x in c: x in PTS s
  (mls-bs-parts!)
  (dk-cite! 'subset-mem-fwd mls-BS '(POWER (PTS s)) c)
  (dk-cite! 'power-mem-in '(PTS s) c x))
(define (mls-sep-and-borel-s! y a b) ; b Borel(s): SEP y (PTS s) (AND a (IN y b)) Borel(s)
  (let ((sp0 (list 'SEP y '(PTS s) (list 'AND a (list 'IN y b)))))
    (mls-bs-parts!)
    (dk-have! (list 'IN sp0 mls-BS)
      (lambda ()
        (use-em a
          (lambda ()
            (mr-ext2! sp0 b
              (lambda (z) (dk-split-all! (list (mr-sep-parts! (list 'IN z sp0)))) (mr-close-open!))
              (lambda (z) (mls-bs-pts! b z) (if (dk-head-is? a 'AND) (dk-split-all! (list a))) (in-sep! (lambda () (dk-conj-close! (lambda () (ass)))))))
            (subst (list '= sp0 b))
            (mr-close-open!))
          (lambda ()
            (dk-cite! 'sigma-algebra-empty-in '(PTS s) mls-BS)
            (mr-ext2! sp0 'EMPTY-SET
              (lambda (z) (dk-split-all! (list (mr-sep-parts! (list 'IN z sp0)))) (pbc)
                          (if (not (dk-ctx-form a)) (dk-have! a (lambda () (dk-conj-close! (lambda () (ass))))))
                          (ai (list 'NOT a)))
              (lambda (z) (dk-cite! 'empty-set-has-no-members z) (pbc) (ai (list 'NOT (list 'IN z 'EMPTY-SET)))))
            (subst (list '= sp0 'EMPTY-SET))
            (mr-close-open!)))))))
(define (mls-sep-imp-borel-s! y a b) ; b Borel(s): SEP y (PTS s) (IMPLIES a (IN y b)) Borel(s)
  (let ((sp0 (list 'SEP y '(PTS s) (list 'IMPLIES a (list 'IN y b)))))
    (mls-bs-parts!)
    (dk-have! (list 'IN sp0 mls-BS)
      (lambda ()
        (use-em a
          (lambda ()
            (mr-ext2! sp0 b
              (lambda (z) (dk-split-all! (list (mr-sep-parts! (list 'IN z sp0)))) (mr-chain! (dk-ctx-form (list 'IMPLIES a (list 'IN z b)))) (mr-close-open!))
              (lambda (z) (mls-bs-pts! b z) (in-sep! (lambda () (di) (mr-close-open!)))))
            (subst (list '= sp0 b))
            (mr-close-open!))
          (lambda ()
            (dk-cite! 'sigma-algebra-whole-in '(PTS s) mls-BS)
            (mr-ext2! sp0 '(PTS s)
              (lambda (z) (mr-sep-parts! (list 'IN z sp0)) (mr-close-open!))
              (lambda (z) (in-sep! (lambda () (di) (pbc) (ai (list 'NOT a))))))
            (subst (list '= sp0 '(PTS s)))
            (mr-close-open!)))))))
(define (mls-borel-of! claim lam cite!) ; claim (IN X BS) where X is the beta-reduct of the lemma's form at lam: cite, reduce, close
  (dk-have! claim
    (lambda ()
      (let ((before (dk-asms)))
        (cite! lam)
        (let ((new (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) mls-BS) (dk-contains? f lam))) (dk-asms))))
          (if new (mls-lam-bh1! new))
          (ass))))))
(define (mls-G! i m)                 ; i, m in NN: G(i, m) Borel(s)
  (dk-cite! 'fun-apply-type-c 'GG 'NN (list 'FUN 'NN mls-BS) i)
  (dk-cite! 'fun-apply-type-c (list 'GG i) 'NN mls-BS m))
(define (mls-V! i m)                 ; V(i, m) Borel(s)
  (let ((lam (list 'VNB-LAMBDA 'vm2_ 'NN (mls-W i 'vm2_ m))))
    (mls-lam-type! (list 'IN lam (list 'FUN 'NN mls-BS))
      (lambda (m2) (mls-G! i m2) (mls-sep-and-borel-s! 'mwy_ (list 'AND (mls-minL (list 'succ i) m2) (mls-agree-codes m2 m (list 'succ i))) (mls-G i m2))))
    (mls-borel-of! (list 'IN (mls-V i m) mls-BS) lam (lambda (l) (dk-cite! 'sigma-algebra-union-closed '(PTS s) mls-BS l)))))
(define (mls-H! n m)                 ; H(n, m) Borel(s)
  (let ((lam (list 'VNB-LAMBDA 'hi2_ 'NN (mls-Vp n m 'hi2_))))
    (mls-lam-type! (list 'IN lam (list 'FUN 'NN mls-BS))
      (lambda (i) (mls-V! i m) (mls-sep-imp-borel-s! 'mvy_ (list '< i n) (mls-V i m))))
    (mls-borel-of! (list 'IN (mls-H n m) mls-BS) lam (lambda (l) (dk-cite! 'sigma-algebra-countable-inter '(PTS s) mls-BS l)))))
(define (mls-B-sub! n m)             ; B(n, m) subset PTS s
  (let ((b (mls-B n m)))
    (if (not (dk-asm? (list 'SUBSET b '(PTS s))))
        (begin
          (mls-img-power! n m)
          (dk-have! (list 'SUBSET b '(PTS s))
            (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (dk-cite! 'power-mem-in '(PTS s) b z) (mr-close-open!))))))))
(define (mls-D! n m)                 ; D(n, m) Borel(s)
  (mls-bs-parts!)
  (mls-G! n m) (mls-H! n m) (mls-B-sub! n m) (mr-recip! n)
  (dk-cite! 'nbhd-borel 's (mls-B n m) (mls-R n))
  (dk-cite! 'sigma-algebra-inter-closed-2 '(PTS s) mls-BS (mls-U n m) (mls-H n m))
  (dk-cite! 'sigma-algebra-inter-closed-2 '(PTS s) mls-BS (mls-G n m) (list 'INTERSECTION (mls-U n m) (mls-H n m))))
(define (mls-FF! n)                  ; FF(n) Borel(s)
  (let ((lam (list 'VNB-LAMBDA 'fm2_ 'NN (mls-D n 'fm2_))))
    (mls-lam-type! (list 'IN lam (list 'FUN 'NN mls-BS)) (lambda (m) (mls-D! n m)))
    (mls-borel-of! (list 'IN (mls-FF n) mls-BS) lam (lambda (l) (dk-cite! 'sigma-algebra-union-closed '(PTS s) mls-BS l)))))
(sp (make-wff (mls-hyp4 (list 'IN mls-FINAL mls-BS))))
(dk-peel!)
(mls-tsetup!)
(mls-bs-parts!)
(let ((lam (list 'VNB-LAMBDA 'fn2_ 'NN (mls-FF 'fn2_))))
  (mls-lam-type! (list 'IN lam (list 'FUN 'NN mls-BS)) (lambda (n) (mls-FF! n)))
  (mls-borel-of! (list 'IN mls-FINAL mls-BS) lam (lambda (l) (dk-cite! 'sigma-algebra-countable-inter '(PTS s) mls-BS l))))
(mr-close-open!)
(qed 'dense-final-borel)
(topic! 'dense-final-borel 'analysis)

;;; ======================================================================
;;; membership helpers for D, H, F
;;; ======================================================================
(define mls-BUfn (caddr mls-FINAL))
(define (mls-inter-in! y a b)        ; y in a and y in b in context: y in INTERSECTION(a, b)
  (let ((iff (dk-cite! 'intersection-membership a b y)))
    (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (ass)))))
    (mr-iff-back! iff)))
(define (mls-D-parts! y n m)         ; y in D(n, m) in context: y in G, U, H
  (mr-iff-parts! (dk-cite! 'intersection-membership (mls-G n m) (list 'INTERSECTION (mls-U n m) (mls-H n m)) y))
  (mr-iff-parts! (dk-cite! 'intersection-membership (mls-U n m) (mls-H n m) y)))
(define (mls-cmp-in! y a b)          ; y in a, NOT y in b in context: y in COMPLEMENT-IN(a, b)
  (let ((iff (dk-cite! 'complement-in-membership a b y)))
    (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (ass)))))
    (mr-iff-back! iff)))
(define (mls-GGprop! n)              ; n in NN: the envelope facts of level n
  (dk-split-all! (list (dk-apply! (dk-ctx-form mls-GGall) n))))
(define (mls-inG! y n m)             ; y in B(n, m) in context: y in G(n, m)
  (mls-GGprop! n)
  (mls-G! n m)
  (dk-apply! (mr-find 'gsub (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'SUBSET) (dk-contains? f (list 'GG n)))) (dk-asms)) m)
  (dk-cite! 'subset-mem-fwd (mls-B n m) (mls-G n m) y))
(define (mls-inB! y x n m)           ; x in cell(n, m), h(x) = y, y in PTS s in context: y in B(n, m)
  (dk-cite! 'membership-implies-sethood y '(PTS s))
  (let ((iff (dk-cite! 'image-membership-iff 'h (mls-cell n m) y)))
    (dk-have! (caddr iff)
      (lambda () (mr-and-close! (lambda () (cond ((dk-asm? (dk-goal)) (ass))
                                                 ((dk-head-is? (dk-goal) 'FORSOME) (ew x) (mr-and-close! (lambda () (mr-close-open!))))
                                                 (#t (error "mls-inB!" (expression->string (dk-goal)))))))))
    (mr-iff-back! iff)))

;;; ======================================================================
;;; the image lies in F
;;; ======================================================================
(sp (make-wff (mls-hyp4 (list 'SUBSET '(IMAGE h (PTS t)) mls-FINAL))))
(dk-peel!)
(mls-tsetup!)
(mls-bs-parts!)
(fact 'rr-zero-in)
(mac 'subset-def)
(define mls-y2 (dk-di-var!))
(define mls-x2 (mls-img-open! 'h '(PTS t) mls-y2))
(dk-cite! 'fun-apply-type-c 'h '(PTS t) '(PTS s) mls-x2)
(dk-have! (list 'IN mls-y2 '(PTS s)) (lambda () (subst (list '= mls-y2 (list 'h mls-x2))) (mr-close-open!)))
(define mls-w2 (dk-skolem! (dk-cite! 'dense-cell-cover 't 'ds mls-x2)))
(dk-split-all!)
(define mls-cov (mr-find 'cov (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f mls-w2) (dk-contains? f 'mcx_))) (dk-asms)))
(define (mls-mn! n)                  ; n in NN: the cell of level n holding x along w, its code returned
  (let ((m (dk-skolem! (dk-apply! mls-cov n))))
    (dk-split-all!)
    m))
(define (mls-y-in-D! n m)
  (let ((y mls-y2) (x mls-x2))
    (mls-inB! y x n m)
    (mls-inG! y n m)
    ;; U
    (dk-have! (list 'IN y (mls-U n m))
      (lambda ()
        (in-sep! (lambda () (ew y) (mr-and-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                                 (begin (mr-recip! n) (dk-cite! 'metric-self-zero 's y)
                                                                        (subst (list '= (list '(DIST s) y y) 0)) (mr-close-open!)))))))))
    ;; H
    (let ((iff (dk-cite! 'complement-in-membership '(PTS s) (caddr (mls-H n m)) y)))
      (dk-have! (caddr iff)
        (lambda ()
          (dk-conj-close!
            (lambda ()
