;;; ch3c-prod.scm -- the product of two compact metric spaces is compact (PRODUCT2-MS, the max metric).
;;; Prefix cx-.  Library: analysis.  Destination: theorem-library/product2-compact.scm, after product2-laws.
;;; Route: sequential compactness, a subsequence in the first coordinate, then a further one in the
;;; second (compact-iff-seq-compact, subseq-of-convergent, product2-converges-to-iff).

(define (cx-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "cx-pick: nothing matching" what) (car l))))
(define (cx-split-goal!)
  (let loop ((todo (list (proof-state-focus *ps*))) (acc '()))
    (if (null? todo) (reverse acc)
        (begin (dk-focus! (car todo))
               (if (dk-head-is? (dk-goal) 'AND)
                   (loop (append (dk-opened (lambda () (di))) (cdr todo)) acc)
                   (loop (cdr todo) (cons (car todo) acc)))))))
(define (cx-sc-parts! sp)                       ; seq-compact(sp) in context: returns the clause
  (let ((rhs (caddr (dk-cite! 'seq-compact sp))))
    (dk-project! rhs 'seq-compact (list 'SEQ-COMPACT sp))
    (dk-split-all! (list rhs))
    (cx-pick 'clause (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'SUBSEQ) (dk-contains? f (list 'PTS sp)))))))

(sp (make-wff '(FORALL s (FORALL t (IMPLIES (IS-COMPACT s) (IMPLIES (IS-COMPACT t) (IS-COMPACT (PRODUCT2-MS s t))))))))
(dk-peel!)
(let* ((P '(PRODUCT2-MS s t)) (ps '(PTS s)) (pt '(PTS t)) (cst (list 'CARTESIAN ps pt)))
  (dk-project! '(IS-METRIC-SPACE s) 'is-compact '(IS-COMPACT s))
  (dk-project! '(IS-METRIC-SPACE t) 'is-compact '(IS-COMPACT t))
  (fact 'product2-is-metric-space 's 't)
  (fact 'product2-pts 's 't)
  (for-each (lambda (x)
              (let ((iff (dk-cite! 'compact-iff-seq-compact x)))
                (dk-have! (list 'SEQ-COMPACT x) (lambda () (if (dk-only! iff (list 'IS-COMPACT x)) (prop))))))
            '(s t))
  (let ((iffp (dk-cite! 'compact-iff-seq-compact P)))
    (dk-have! (list 'SEQ-COMPACT P)
      (lambda ()
        (mac 'seq-compact)
        (for-each
         (lambda (leaf)
           (dk-focus! leaf)
           (if (dk-asm? (dk-goal)) (ass)
               (let* ((pl (dk-peel!)) (u (cadr (car pl)))
                      (a (list 'VNB-LAMBDA 'cxk_ 'NN (list 'NTH 1 (list u 'cxk_))))
                      (b (list 'VNB-LAMBDA 'cxk_ 'NN (list 'NTH 2 (list u 'cxk_)))))
                 (dk-have! (list 'IN u (list 'FUN 'NN cst)) (lambda () (subst (list '= cst (list 'PTS P))) (ass)))
                 (fact 'nn-is-set)
                 (define (coord-typed! k)
                   (fact 'fun-apply-type-c u 'NN cst k)
                   (dk-split-all! (list (dk-fact! 'cartesian-nth (list u k) ps pt))))
                 (dk-have! (list 'IN a (list 'FUN 'NN ps)) (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (coord-typed! k) (ass))) (lambda () (ass)))))
                 (dk-have! (list 'IN b (list 'FUN 'NN pt)) (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (coord-typed! k) (ass))) (lambda () (ass)))))
                 (let* ((cs (cx-sc-parts! 's))
                        (phi (dk-skolem! (dk-apply! cs a) #t))
                        (l1 (dk-skolem! (cx-pick 'l1 (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f phi)))) #t))
                        (g (list 'SUBSEQ b phi)))
                   (dk-split-all!)
                   (fact 'subseq-is-fun 't b phi) (dk-have! (list 'AND (list 'IN b (list 'FUN 'NN pt)) (list 'STRICTLY-MONO-NN phi))) (fact 'subseq-is-fun 't b phi)
                   (let* ((ct (cx-sc-parts! 't))
                          (psi (dk-skolem! (dk-apply! ct g) #t))
                          (l2 (dk-skolem! (cx-pick 'l2 (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f psi)))) #t))
                          (sa (list 'SUBSEQ (list 'SUBSEQ a phi) psi))
                          (sb (list 'SUBSEQ g psi))
                          (chi (list 'VNB-LAMBDA 'cxk_ 'NN (list phi (list psi 'cxk_)))))
                     (dk-split-all!)
                     (fact 'subseq-of-convergent 's (list 'SUBSEQ a phi) psi l1)
                     ;; chi is strictly increasing
                     (let* ((rp (caddr (dk-cite! 'strictly-mono-nn phi))) (rq (caddr (dk-cite! 'strictly-mono-nn psi))))
                       (dk-project! rp 'strictly-mono-nn (list 'STRICTLY-MONO-NN phi)) (dk-split-all! (list rp))
                       (dk-project! rq 'strictly-mono-nn (list 'STRICTLY-MONO-NN psi)) (dk-split-all! (list rq))
                       (let ((mp (cx-pick 'mp (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f (list phi 'm))))))
                             (mq (cx-pick 'mq (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f (list psi 'm)))))))
                         (dk-have! (list 'STRICTLY-MONO-NN chi)
                           (lambda ()
                             (mac 'strictly-mono-nn)
                             (for-each
                              (lambda (l2_)
                                (dk-focus! l2_)
                                (cond ((dk-asm? (dk-goal)) (ass))
                                      ((dk-head-is? (dk-goal) 'IN)
                                       (dk-lam-type! (lambda () (let ((k (dk-di-var!)))
                                                                  (fact 'fun-apply-type-c psi 'NN 'NN k)
                                                                  (fact 'fun-apply-type-c phi 'NN 'NN (list psi k)) (ass)))
                                                     (lambda () (ass))))
                                      (#t (let* ((pl3 (dk-peel!))
                                                 (lt (car (filter (lambda (f) (dk-head-is? f '<)) pl3)))
                                                 (mm (cadr lt)) (nn_ (caddr lt)))
                                            (for-each (lambda (k) (fact 'fun-apply-type-c psi 'NN 'NN k)) (list mm nn_))
                                            (dk-lam-b!)
                                            (inst*! mq mm nn_)
                                            (inst*! mp (list psi mm) (list psi nn_))
                                            (ass)))))
                              (cx-split-goal!))))))
                     ;; the coordinates of u along chi
                     (fact 'subseq-is-fun 's (list 'SUBSEQ a phi) psi)
                     (dk-have! (list 'AND (list 'IN g (list 'FUN 'NN pt)) (list 'STRICTLY-MONO-NN psi))) (fact 'subseq-is-fun 't g psi)
                     (dk-have! (list 'AND (list 'IN a (list 'FUN 'NN ps)) (list 'STRICTLY-MONO-NN phi))) (fact 'subseq-is-fun 's a phi)
                     (dk-have! (list 'AND (list 'IN (list 'SUBSEQ a phi) (list 'FUN 'NN ps)) (list 'STRICTLY-MONO-NN psi))) (fact 'subseq-is-fun 's (list 'SUBSEQ a phi) psi)
                     (dk-have! (list 'AND (list 'IN u (list 'FUN 'NN (list 'PTS P))) (list 'STRICTLY-MONO-NN chi))) (fact 'subseq-is-fun P u chi)
                     (dk-have! (list 'IN (list 'SUBSEQ u chi) (list 'FUN 'NN cst))
                       (lambda () (subst (list '= cst (list 'PTS P))) (ass)))
                     (dk-have! (list 'FORALL 'p2n_ (list 'IMPLIES '(IN p2n_ NN)
                                 (list '= (list (list 'SUBSEQ u chi) 'p2n_) (list 'LIST (list sa 'p2n_) (list sb 'p2n_)))))
                       (lambda ()
                         (let* ((k (dk-di-var!)) (pk (list psi k)) (fk (list phi pk)))
                           (fact 'fun-apply-type-c psi 'NN 'NN k) (fact 'fun-apply-type-c phi 'NN 'NN pk)
                           (subst (dk-cite! 'subseq-apply u chi k))
                           (subst (dk-cite! 'subseq-apply (list 'SUBSEQ a phi) psi k))
                           (subst (dk-cite! 'subseq-apply a phi pk))
                           (subst (dk-cite! 'subseq-apply g psi k))
                           (subst (dk-cite! 'subseq-apply b phi pk))
                           (dk-lam-b!)
                           (coord-typed! fk)
                           (fact 'cartesian-pair-eq (list u fk) ps pt)
                           (ass))))
                     (let ((iffc (dk-fact! 'product2-converges-to-iff 's 't (list 'SUBSEQ u chi) sa sb l1 l2)))
                       (dk-have! (list 'CONVERGES-TO P (list 'SUBSEQ u chi) (list 'LIST l1 l2))
                         (lambda () (if (dk-only! iffc (list 'CONVERGES-TO 's sa l1) (list 'CONVERGES-TO 't sb l2)) (prop)))))
                     (fact 'pair-in-cartesian ps pt l1 l2)
                     (ew chi)
                     (for-each (lambda (l) (dk-focus! l)
                                 (cond ((dk-asm? (dk-goal)) (ass))
                                       (#t (ew (list 'LIST l1 l2))
                                           (for-each (lambda (l3) (dk-focus! l3)
                                                       (if (dk-asm? (dk-goal)) (ass)
                                                           (begin (subst (list '= (list 'PTS P) cst)) (ass))))
                                                     (cx-split-goal!)))))
                               (cx-split-goal!)))))))
         (cx-split-goal!))))
    (if (dk-only! iffp (list 'SEQ-COMPACT P)) (prop))))
(qed 'product2-compact)

(display ";; CX qed failures: ") (display *vnb-qed-failures*) (newline)
