;;; mb67-lusin.scm -- construction of measures, chapter 5 section 1.5 (M-B67, 2026-10-26): Lusin sets.
;;;   lusin-is-souslin           (after Definition 5.19) a Lusin set is Souslin
;;;   lusin-closed, lusin-open   nonempty closed and nonempty open subsets of a Polish space are Lusin (the base cases
;;;                              of Corollary 5.21)
;;;   borel-from-inter-disjoint-union   Lemma 5.23 (for any metric space)
;;; Vocabulary: mb67-vocab.scm (IS-LUSIN).  Library: measure.  Helper prefixes mr- (copied) and mlu-.
;;;
;;; Load window: after mb67-souslin (closed-polish-souslin's construction is repeated here), mb35-regular
;;; (dist-layer-closed), mb4-polish-open (polish-open-subspace, pt-set-dist-*), mb35-souslin.
(define (mr-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (mr-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (mr-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
(define (mr-iff-parts! iff)
  ;; the conjunct equal to the focus GOAL (if any) is projected LAST: proving it closes the leaf, and a
  ;; projection after that would fire on a sibling (focus drift)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc)))))
         (goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
         (opener (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
         (rest (filter (lambda (c) (not (goal? c))) cs))
         (last (filter goal? cs)))
    (append (mr-map (lambda (c) (mr-project! c opener)) rest)
            (mr-map (lambda (c) (mr-project! c opener)) last))))
(define (mr-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (mr-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))
(define (mr-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
(define (mr-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
(define (mr-ne! a b lt)
  (dk-have! (list 'NOT (list '= a b))
    (lambda ()
      (di)
      (dk-have! '(< 0 0) (lambda () (dk-ineq! lt (list '= a b))))
      (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
      (ai (dk-cite! 'rr-lt-irrefl 0)))))
(define (mr-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s0 (caddr m)) (v (cadr s0)) (dom (caddr s0))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s0)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "mr-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (ai (dk-ctx-form conj))))
    p))
(define (mr-and-close! closer)
  (if (dk-head-is? (dk-goal) 'AND)
      (for-each (lambda (k) (dk-focus! k) (mr-and-close! closer)) (dk-opened (lambda () (di))))
      (closer)))
(define (mr-find tag pred lst)
  (or (find-first pred lst) (error "mr-find: nothing matches at" tag (map expression->string lst))))
(define (mr-real! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)) (list 'IN t 'RR))
(define (mr-pos! e) (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))
(define (mr-recip! k)              ; recip(k + 1), k in NN: typed, positive (idempotent)
  (let* ((k1 (list '+ k 1)) (rq (list 'RECIP k1)))
   (if (dk-asm? (list 'POS-RR rq))
    rq
    (begin
    (dk-cite! 'nn-in-rr k) (dk-type! k1 'RR)
    (dk-have! (list '< 0 k1) (lambda () (dk-cite! 'nn-zero-le k) (dk-ineq! (list '<= 0 k))))
    (mr-ne! k1 0 (list '< 0 k1))
    (mr-chain! (dk-fact! 'rr-recip-closed k1))
    (dk-cite! 'rr-recip-pos k1)
    (dk-cite! 'rr-pos-rr-of-lt rq)
    rq))))
(define (mr-sep-open! sp0)           ; IS-SEPARABLE(sp0) in context: is-metric-space and a dense sequence, returned
  (let* ((iff (dk-cite! 'is-separable sp0)) (rhs (caddr iff)) (ex (caddr rhs)))
    (dk-project! (list 'IS-METRIC-SPACE sp0) (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (dk-project! ex (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (let ((d (dk-skolem! ex))) (dk-split-all!) d)))
(define (mr-dense ds sp0) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'PTS sp0)) (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
  (list 'FORSOME 'n (list 'AND '(IN n NN) (list '< (list (list 'DIST sp0) 'x (list ds 'n)) 'eps))))))))
(define (mr-iff-back! iff)           ; the right side of an IFF in context (proved by the caller): land the left side
  (ai iff)
  (detach! (list 'IMPLIES (caddr iff) (cadr iff))))

(define (mlu-C a) (list 'COMPLEMENT-IN '(PTS s) a))
(define (mlu-power! a)               ; a subset PTS s in context: a in POWER(PTS s)
  (let ((g0 (list 'IN a '(POWER (PTS s)))))
    (if (not (dk-asm? g0))
        (begin
          (dk-cite! 'ms-pts-is-set 's)
          (dk-cite! 'subclass-of-set-is-set a '(PTS s))
          (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ a) '(IN z_ (PTS s))))
            (lambda () (let ((z (dk-di-var!))) (dk-cite! 'subset-mem-fwd a '(PTS s) z) (mr-close-open!))))
          (dk-cite! 'power-mem-intro '(PTS s) a)))
    g0))
(define (mlu-sub! a)                 ; a in POWER(PTS s) in context: a subset PTS s
  (let ((g0 (list 'SUBSET a '(PTS s))))
    (if (not (dk-asm? g0))
        (dk-have! g0 (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (dk-cite! 'power-mem-in '(PTS s) a w) (mr-close-open!)))))
    g0))
(define (mlu-img-open! f dom p)
  (let* ((ps (mr-iff-parts! (dk-cite! 'image-membership-iff f dom p)))
         (w (dk-skolem! (cadr ps))))
    (dk-split-all!)
    w))
(define (mlu-near A T)
  (list 'FORALL 'gx_ (list 'IMPLIES (list 'IN 'gx_ A) (list 'FORALL 'ge_ (list 'IMPLIES '(POS-RR ge_) (list 'FORSOME 'gd_ (list 'AND '(POS-RR gd_)
    (list 'FORALL 'gy_ (list 'IMPLIES (list 'IN 'gy_ A) (list 'IMPLIES '(<= ((DIST s) gx_ gy_) gd_) (list '< (list (list 'DIST T) 'gx_ 'gy_) 'ge_)))))))))))
(define (mlu-near! A T)
  (dk-have! (mlu-near A T)
    (lambda ()
      (let* ((lx (dk-peel!))
             (x (cadr (mr-find 'lnx (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) A))) lx)))
             (e (cadr (mr-find 'lne (lambda (f) (dk-head-is? f 'POS-RR)) lx)))
             (d (dk-halve! e)))
        (ew d)
        (mr-and-close!
          (lambda ()
            (if (dk-asm? (dk-goal)) (ass)
                (let* ((ly (dk-peel!))
                       (y (cadr (mr-find 'lny (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) A))) ly)))
                       (dxy (list '(DIST s) x y)))
                  (dk-cite! 'subset-mem-fwd A '(PTS s) x)
                  (dk-cite! 'subset-mem-fwd A '(PTS s) y)
                  (dk-cite! 'metric-dist-real 's x y)
                  (dk-cite! 'subspace-dist 's A x y)
                  (subst (list '= (list (list 'DIST T) x y) dxy))
                  (dk-cite! 'rr-pos-rr-in-rr e)
                  (dk-ineq! (list '<= dxy d) (list '= (list '+ d d) e) (list '< 0 d) (list 'IN dxy 'RR) (list 'IN d 'RR) (list 'IN e 'RR))))))))))

;;; ======================================================================
;;; Lusin sets are Souslin
;;; ======================================================================
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (FORALL e (IMPLIES (SUBSET e (PTS s)) (IMPLIES (IS-LUSIN s e) (IS-SOUSLIN s e))))))))
(dk-peel!)
(let* ((ps (mr-iff-parts! (dk-cite! 'is-lusin 's 'e)))
       (t0 (dk-skolem! (car ps))))
  (dk-split-all!)
  (let ((h0 (dk-skolem! (mr-find 'lh (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f t0))) (dk-asms)))))
    (dk-split-all!)
    (mr-chain! (dk-cite! 'continuous-image-polish-souslin 's 'e t0 h0))
    (mr-close-open!)))
(qed 'lusin-is-souslin)
(topic! 'lusin-is-souslin 'analysis)

;;; ======================================================================
;;; nonempty closed and open subsets of a Polish space are Lusin
;;; ======================================================================
(define mlu-TT '(SUBSPACE-MS s F))
(define mlu-id '(VNB-LAMBDA mlj_ F mlj_))
(define (mlu-id! x)
  (let ((eqn (list '== (list mlu-id x) x)))
    (if (not (dk-asm? eqn)) (dk-have! eqn (lambda () (dk-lam-b!) (qrfl))))
    x))
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-POLISH s) (list 'FORALL 'F (list 'IMPLIES '(IS-CLOSED s F)
  (list 'IMPLIES '(FORSOME x (IN x F)) '(IS-LUSIN s F))))))))
(dk-peel!)
(mr-iff-parts! (dk-cite! 'is-polish 's))
(mr-iff-parts! (dk-cite! 'is-closed 's 'F))
(dk-cite! 'ms-pts-is-set 's)
(dk-cite! 'subclass-of-set-is-set 'F '(PTS s))
(dk-cite! 'subspace-complete 's 'F)
(dk-cite! 'subspace-is-metric-space 's 'F)
(dk-cite! 'subspace-pts 's 'F)
(mlu-near! 'F mlu-TT)
(mr-chain! (dk-cite! 'coarser-metric-separable 's 'F mlu-TT))
(dk-have! (list 'IN mlu-id '(FUN F F))
  (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (mlu-id! z) (mr-close-open!))))))
(dk-have! (list 'IS-CONTINUOUS mlu-TT mlu-TT mlu-id)
  (lambda ()
    (let ((iff (dk-cite! 'is-continuous mlu-TT mlu-TT mlu-id)))
      (dk-have! (caddr iff)
        (lambda ()
          (mr-and-close!
            (lambda ()
              (cond
                ((dk-asm? (dk-goal)) (ass))
                ((dk-head-is? (dk-goal) 'IN) (subst (list '= (list 'PTS mlu-TT) 'F)) (mr-close-open!))
                (#t
                 (let* ((a (cadr (car (dk-peel!))))
                        (_0 (dk-have! (list 'IN a 'F) (lambda () (subst (list '= 'F (list 'PTS mlu-TT))) (mr-close-open!))))
                        (iff2 (dk-cite! 'is-continuous-at mlu-TT mlu-TT mlu-id a)))
                   (mlu-id! a)
                   (dk-have! (caddr iff2)
                     (lambda ()
                       (mr-and-close!
                         (lambda ()
                           (cond
                             ((dk-asm? (dk-goal)) (ass))
                             ((dk-head-is? (dk-goal) 'IN) (subst (list '= (list 'PTS mlu-TT) 'F)) (mr-close-open!))
                             (#t
                              (let ((eps (cadr (car (dk-peel!)))))
                                (ew eps)
                                (mr-and-close!
                                  (lambda ()
                                    (if (dk-asm? (dk-goal)) (ass)
                                        (let* ((lb (dk-peel!))
                                               (b (cadr (mr-find 'lb (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'PTS mlu-TT)))) lb))))
                                          (dk-have! (list 'IN b 'F) (lambda () (subst (list '= 'F (list 'PTS mlu-TT))) (mr-close-open!)))
                                          (mlu-id! b)
                                          (subst (list '= (list mlu-id a) a))
                                          (subst (list '= (list mlu-id b) b))
                                          (mr-close-open!))))))))))))
                   (mr-iff-back! iff2)
                   (mr-close-open!))))))))
      (mr-iff-back! iff)
      (mr-close-open!))))
(dk-have! (list '= (list 'IMAGE mlu-id (list 'PTS mlu-TT)) 'F)
  (lambda ()
    (subst (list '= (list 'PTS mlu-TT) 'F))
    (mr-ext2! (list 'IMAGE mlu-id 'F) 'F
      (lambda (p)
        (let ((z (mlu-img-open! mlu-id 'F p)))
          (mlu-id! z)
          (subst (list '= p (list mlu-id z)))
          (subst (list '= (list mlu-id z) z))
          (mr-close-open!)))
      (lambda (p)
        (mlu-id! p)
        (dk-cite! 'membership-implies-sethood p 'F)
        (mac 'image-membership-iff)
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal)) (ass)
                (begin (ew p)
                       (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                      (begin (subst (list '= (list mlu-id p) p)) (if (dk-asm? (dk-goal)) (ass) (rfl))))))))))))
    (mr-close-open!)))
(let ((iff (dk-cite! 'is-lusin 's 'F)))
  (dk-have! (caddr iff)
    (lambda ()
      (ew mlu-TT)
      (mr-and-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (begin
                (ew mlu-id)
                (mr-and-close!
                  (lambda ()
                    (if (dk-asm? (dk-goal)) (ass)
                        (let* ((lk (dk-peel!))
                               (xs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'PTS mlu-TT)))) lk)))
                               (x (car xs)) (y (cadr xs)))
                          (dk-have! (list 'IN x 'F) (lambda () (subst (list '= 'F (list 'PTS mlu-TT))) (mr-close-open!)))
                          (dk-have! (list 'IN y 'F) (lambda () (subst (list '= 'F (list 'PTS mlu-TT))) (mr-close-open!)))
                          (mlu-id! x) (mlu-id! y)
                          (let ((h (mr-find 'ideq (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) (list mlu-id x)))) (dk-asms))))
                            (dk-rewrite-h! h (list mlu-id x) x)
                            (dk-rewrite-h! (list '= x (list mlu-id y)) (list mlu-id y) y)
                            (mr-close-open!))))))))))))
  (mr-iff-back! iff))
(mr-close-open!)
(qed 'lusin-closed)
(topic! 'lusin-closed 'analysis)

(define mlu-sub '(SUBSPACE-MS s u))
(sp (make-wff '(FORALL s (IMPLIES (IS-POLISH s) (FORALL u (IMPLIES (IS-OPEN s u) (IMPLIES (FORSOME z (IN z u)) (IS-LUSIN s u))))))))
(dk-peel!)
(mr-iff-parts! (dk-cite! 'is-polish 's))
(mr-iff-parts! (dk-cite! 'is-complete 's))
(mr-iff-parts! (dk-cite! 'is-open 's 'u))
(dk-cite! 'ms-pts-is-set 's)
(dk-cite! 'subclass-of-set-is-set 'u '(PTS s))
(dk-cite! 'subspace-pts 's 'u)
(define mlu-t (dk-skolem! (dk-cite! 'polish-open-subspace 's 'u)))
(dk-split-all!)
(define mlu-h (dk-skolem! (mr-find 'lhm (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'IS-HOMEOMORPHISM))) (dk-asms))))
(define mlu-hp (mr-iff-parts! (dk-cite! 'is-homeomorphism mlu-t mlu-sub mlu-h)))
(mr-iff-parts! (dk-cite! 'is-polish mlu-t))
(dk-rewrite-h! (car mlu-hp) (list 'PTS mlu-sub) 'u)
(dk-cite! 'bijection-in-fun (list 'PTS mlu-t) 'u mlu-h)
(define mlu-img (list 'IMAGE mlu-h (list 'PTS mlu-t)))
(dk-have! (list '= mlu-img 'u)
  (lambda ()
    (mr-ext2! mlu-img 'u
      (lambda (p)
        (let ((b (mlu-img-open! mlu-h (list 'PTS mlu-t) p)))
          (dk-cite! 'fun-apply-type-c mlu-h (list 'PTS mlu-t) 'u b)
          (subst (list '= p (list mlu-h b)))
          (mr-close-open!)))
      (lambda (p)
        (let ((b (dk-skolem! (dk-cite! 'bijection-surjective (list 'PTS mlu-t) 'u mlu-h p))))
          (dk-split-all!)
          (dk-cite! 'subset-mem-fwd 'u '(PTS s) p)
          (dk-cite! 'membership-implies-sethood p '(PTS s))
          (mac 'image-membership-iff)
          (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew b) (dk-conj-close! (lambda () (ass))))))))))
    (mr-close-open!)))
(let ((iff (dk-cite! 'is-lusin 's 'u)))
  (dk-have! (caddr iff)
    (lambda ()
      (ew mlu-t)
      (mr-and-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (begin
                (ew mlu-h)
                (mr-and-close!
                  (lambda ()
                    (if (dk-asm? (dk-goal)) (ass)
                        (let* ((lk (dk-peel!))
                               (xs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'PTS mlu-t)))) lk))))
                          (dk-cite! 'bijection-injective (list 'PTS mlu-t) 'u mlu-h (car xs) (cadr xs))
                          (mr-close-open!)))))))))))
  (mr-iff-back! iff))
(mr-close-open!)
(qed 'lusin-open)
(topic! 'lusin-open 'analysis)

;;; ======================================================================
;;; LEMMA 5.23: a class containing the open sets and closed under countable intersections and countable
;;; disjoint unions contains the Borel sets (any metric space)
;;; ======================================================================
(define (mlz-inter g) (list 'SEP 'mbq_ '(PTS s) (list 'FORALL 'mbn_ (list 'IMPLIES '(IN mbn_ NN) (list 'IN 'mbq_ (list g 'mbn_))))))
(define (mlz-disj g) (list 'FORALL 'mbi_ (list 'IMPLIES '(IN mbi_ NN) (list 'FORALL 'mbj_ (list 'IMPLIES '(IN mbj_ NN)
  (list 'FORALL 'mbx_ (list 'IMPLIES (list 'IN 'mbx_ (list g 'mbi_)) (list 'IMPLIES (list 'IN 'mbx_ (list g 'mbj_)) '(= mbi_ mbj_)))))))))
(define (mlz-bu g) (list 'BIG-UNION 'n_ 'NN (list g 'n_)))
(define mlz-HP '(SUBSET cb (POWER (PTS s))))
(define mlz-HI (list 'FORALL 'g (list 'IMPLIES '(IN g (FUN NN cb)) (list 'IN (mlz-inter 'g) 'cb))))
(define mlz-HU (list 'FORALL 'g (list 'IMPLIES '(IN g (FUN NN cb)) (list 'IMPLIES (mlz-disj 'g) (list 'IN (mlz-bu 'g) 'cb)))))
(define mlz-HO '(FORALL u (IMPLIES (IS-OPEN s u) (IN u cb))))
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'FORALL 'cb (list 'IMPLIES mlz-HP (list 'IMPLIES mlz-HI
  (list 'IMPLIES mlz-HU (list 'IMPLIES mlz-HO '(SUBSET (BOREL-SETS s) cb))))))))))
(dk-peel!)
(dk-cite! 'ms-pts-is-set 's)
(dk-cite! 'nn-is-set)
(define mlz-pts '(PTS s))
(define (mlz-in-cb! a)               ; a in cb: a in POWER(PTS s), a subset PTS s
  (dk-cite! 'subset-mem-fwd 'cb '(POWER (PTS s)) a)
  (mlu-sub! a))
(define (mlz-inter! g)               ; g in FUN(NN, cb) in context: (inter g) in cb
  (dk-apply! mlz-HI g))
;; the empty set C(PTS s) is open, and PTS s is open
(dk-cite! 'carrier-is-open 's)
(dk-cite! 'complement-in-subset mlz-pts mlz-pts)
(dk-have! (list 'IS-OPEN 's (mlu-C mlz-pts))
  (lambda ()
    (let ((iff (dk-cite! 'is-open 's (mlu-C mlz-pts))))
      (dk-have! (caddr iff)
        (lambda ()
          (mr-and-close!
            (lambda ()
              (if (dk-asm? (dk-goal)) (ass)
                  (let ((y (dk-di-var!)))
                    (mr-iff-parts! (dk-cite! 'complement-in-membership mlz-pts mlz-pts y))
                    (ai (list 'NOT (list 'IN y mlz-pts)))))))))
      (mr-iff-back! iff)
      (mr-close-open!))))
(dk-apply! mlz-HO mlz-pts)
(dk-apply! mlz-HO (mlu-C mlz-pts))
;; closed sets lie in cb
(define mlz-fcl 'fcl)
(dk-have! '(FORALL fcl (IMPLIES (IS-CLOSED s fcl) (IN fcl cb)))
  (lambda ()
    (let* ((lf (dk-peel!))
           (Fcl (caddr (mr-find 'zF (lambda (f) (dk-head-is? f 'IS-CLOSED)) lf)))
           (cp (mr-iff-parts! (dk-cite! 'is-closed 's Fcl)))
           (cF (mlu-C Fcl)))
      (dk-cite! 'complement-in-double mlz-pts Fcl)
