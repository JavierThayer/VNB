;;; poly-fn-roots.scm -- division by z - a, the root bound, uniqueness of coefficients, degree, composition
;;; (CA-MONTEL "POLY-2", 2026-10-26).  Vocabulary: poly-fn-vocab.scm (+ the degree vocabulary below).
;;; Library: analysis.  Helper prefix pfr- in drafting; renamed pfr- with the copied helpers at the head.

;;; helpers copied from poly-fn-laws.scm (prefix pfr- renamed pfr-): each proof file has its own environment
(define (pfr-H c z) (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list c 'pfj_) (list 'power z 'pfj_))))
(define (pfr-PS c z n) (list 'CC-SERIES-PARTIAL-SUM (pfr-H c z) n))
(define (pfr-only-prop! . fs) (dk-close-if! (lambda () (apply dk-only! fs)) prop))
(define (pfr-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (pfr-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-type! t 'CC)))
(define (pfr-nn! t) (if (not (dk-asm? (list 'IN t 'NN))) (dk-type! t 'NN)))
(define (pfr-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (pfr-H-typ! c z)
  (let ((g (list 'IN (pfr-H c z) '(FUN NN CC))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let* ((j (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                  (fact 'fun-apply-type-c c 'NN 'CC j)
                  (if (not (sequent-node-grounded? leaf)) (dk-type! (cadr (dk-goal)) 'CC))
                  (pfr-close-open!)))))))
    g))
(define (pfr-H-at! c z j)
  (let ((e (list '= (list (pfr-H c z) j) (list '* (list c j) (list 'power z j)))))
    (if (not (dk-asm? e))
        (begin
          (fact 'fun-apply-type-c c 'NN 'CC j)
          (pfr-cc! (list '* (list c j) (list 'power z j)))
          (dk-have! e (lambda () (dk-close-if! (lambda () (dk-lam-b!)) rfl)))))
    e))
(define (pfr-PS-typ! c z n)
  (pfr-H-typ! c z) (pfr-nn! n)
  (let ((g (list 'IN (pfr-PS c z n) 'CC)))
    (if (not (dk-asm? g)) (dk-cite! 'cc-series-partial-sum-in-cc n (pfr-H c z)))
    g))
(define (pfr-PS-succ! c z n)
  (pfr-PS-typ! c z n)
  (fact 'fun-apply-type-c (pfr-H c z) 'NN 'CC n)
  (let ((s (pfr-chain! (dk-fact! 'cc-series-partial-sum-succ (pfr-H c z) n))))
    (pfr-H-at! c z n)
    s))
(define (pfr-cons-cc! b c)
  (let ((g (list 'IN (list 'CF-CONS b c) '(FUN NN CC))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (subst (dk-cite! 'cf-cons-unfold b c))
            (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-one-in)
            (dk-lam-type!
              (lambda ()
                (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                  (fact 'nn-minus-in-nn k 1)
                  (fact 'fun-apply-type-c c 'NN 'CC (list 'NN-MINUS k 1))
                  (if (not (sequent-node-grounded? leaf)) (dk-type! (cadr (dk-goal)) 'CC))
                  (pfr-close-open!)))))))
    g))
(define (pfr-vanish c n) (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) (list 'IMPLIES (list '<= n 'pfk_) (list '= (list c 'pfk_) 0)))))
(define (pfr-lcomb e c d al be) (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) (list '= (list e 'pfk_) (list '+ (list '* al (list c 'pfk_)) (list '* be (list d 'pfk_)))))))
(define (pfr-poly-intro! kc a g n c val!)
  (let* ((iff (dk-cite! 'is-poly-fn-on kc a g)) (rhs (caddr iff)))
    (dk-have! rhs
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (cond ((dk-asm? (dk-goal)) (ass))
                  ((dk-head-is? (dk-goal) 'FORSOME)
                   (ew n)
                   (dk-conj-close!
                     (lambda ()
                       (cond ((dk-asm? (dk-goal)) (ass))
                             ((dk-head-is? (dk-goal) 'FORSOME)
                              (ew c)
                              (dk-conj-close!
                                (lambda ()
                                  (cond ((dk-asm? (dk-goal)) (ass))
                                        (#t (let ((z (dk-di-var!))) (val! z) (pfr-close-open!)))))))
                             (#t (error "pfr-poly-intro!: unexpected goal" (expression->string (dk-goal))))))))
                  (#t (error "pfr-poly-intro!: unexpected goal" (expression->string (dk-goal)))))))))
    (pfr-only-prop! iff rhs)))
(define (pfr-beta! close!)
  (let ((leaf (proof-state-focus *ps*)))
    (dk-lam-b!)
    (if (not (sequent-node-grounded? leaf)) (close!))))
(define (pfr-succ-case! k n kq!)
  (use-cases (dk-cite! 'nn-zero-or-succ k)
    (lambda ()
      (dk-rewrite-h! (list '<= (list 'succ n) k) k 0)
      (pfr-nn! (list 'succ n))
      (fact 'nn-le-zero-is-zero (list 'succ n))
      (fact 'nn-succ-nonzero n)
      (pfr-only-prop! (list '= (list 'succ n) 0) (list 'NOT (list '= (list 'succ n) 0))))
    (lambda ()
      (let* ((q (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f k))) "k = succ q")))
             (_0 (dk-split-all!)))
        (dk-rewrite-h! (list '<= (list 'succ n) k) k (list 'succ q))
        (subst (list '= k (list 'succ q)))
        (pfr-chain! (dk-fact! 'nn-succ-le-cancel n q))
        (kq! q)))))
(define pfr-Z '(VNB-LAMBDA pfk_ NN 0))
(define (pfr-Z-typ! kc)
  (for-each (lambda (cls)
              (let ((g (list 'IN pfr-Z (list 'FUN 'NN cls))))
                (if (not (dk-asm? g))
                    (dk-have! g (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (pfr-close-open!)))))))))
            (list kc 'CC)))
(define (pfr-tail-val t c) (list 'FORALL 'pftk_ (list 'IMPLIES '(IN pftk_ NN) (list '= (list t 'pftk_) (list c '(succ pftk_))))))
(define (pfr-tail-sym! kc c)
  (let* ((lam (list 'VNB-LAMBDA 'pftk_ 'NN (list c '(succ pftk_))))
         (ex (list 'FORSOME 'pftt_ (list 'AND (list 'IN 'pftt_ (list 'FUN 'NN kc))
                (list 'AND (list 'IN 'pftt_ '(FUN NN CC)) (pfr-tail-val 'pftt_ c))))))
    (dk-have! ex
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (let ((cls (caddr (caddr (dk-goal)))))
                  (dk-lam-type!
                    (lambda ()
                      (let* ((k (dk-di-var!)))
                        (fact 'nn-succ-closed k)
                        (fact 'fun-apply-type-c c 'NN cls (list 'succ k))
                        (pfr-close-open!)))))
                (let ((k (dk-di-var!)))
                  (fact 'nn-succ-closed k)
                  (fact 'fun-apply-type-c c 'NN 'CC (list 'succ k))
                  (pfr-beta! rfl)))))))
    (let ((t (dk-skolem! ex)))
      (dk-split-all!)
      t)))
(define (pfr-split! kc c t v z)
  (let* ((c0 (list c 0))
         (e (list '= (pfr-PS c z (list 'succ v)) (list '+ c0 (list '* z (pfr-PS t z v))))))
    (if (not (dk-asm? e))
        (begin
          (fact 'nn-zero-in)
          (fact 'fun-apply-type-c c 'NN 'CC 0)
          (pfr-cons-cc! c0 t)
          (fact 'nn-succ-closed v)
          (dk-have! (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) (list '= (list c 'pfk_) (list (list 'CF-CONS c0 t) 'pfk_))))
            (lambda ()
              (let ((k (dk-di-var!)))
                (use-cases (dk-cite! 'nn-zero-or-succ k)
                  (lambda () (subst (list '= k 0)) (subst (dk-cite! 'cf-cons-zero c0 t)) (rfl))
                  (lambda ()
                    (let* ((q (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f k))) "k = succ q")))
                           (_0 (dk-split-all!)))
                      (subst (list '= k (list 'succ q)))
                      (subst (dk-cite! 'cf-cons-succ c0 t q))
                      (fact 'nn-succ-closed q)
                      (fact 'fun-apply-type-c c 'NN 'CC (list 'succ q))
                      (subst (dk-apply! (pfr-tail-val t c) q))
                      (rfl)))))))
          (dk-have! e
            (lambda ()
              (subst (pfr-chain! (dk-fact! 'cc-ps-congr (list 'succ v) c (list 'CF-CONS c0 t) z)))
              (subst (dk-cite! 'cc-ps-cons v c0 t z))
              (rfl)))))
    e))
(define (pfr-tail-vanish! c t v)
  (dk-have! (pfr-vanish t v)
    (lambda ()
      (let* ((lk (dk-peel!)) (k (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk)))))
        (fact 'nn-succ-closed k)
        (pfr-chain! (dk-fact! 'nn-succ-mono v k))
        (dk-apply! (pfr-vanish c (list 'succ v)) (list 'succ k))
        (fact 'fun-apply-type-c c 'NN 'CC (list 'succ k))
        (subst (dk-apply! (pfr-tail-val t c) k))
        (subst (list '= (list c (list 'succ k)) 0))
        (rfl)))))

;;; ======================================================================
;;; (1) DIVISION BY z - a.  For c of length n + 1 and a in CC there is d of length n with
;;;     c(k + 1) = d(k) - a d(k + 1),  c(0) = p(a) - a d(0),  and  p(z) = p(a) + (z - a) q(z)
;;;     (p, q the polynomials of c, d)
;;; ======================================================================
(define (pfr-rel c d a) (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) (list '= (list c '(succ pfk_)) (list '- (list d 'pfk_) (list '* a (list d '(succ pfk_))))))))
(define (pfr-c0 c d a n) (list '= (list c 0) (list '- (pfr-PS c a (list 'succ n)) (list '* a (list d 0)))))
(define (pfr-ident c d a n) (list 'FORALL 'pfz_ (list 'IMPLIES '(IN pfz_ CC)
  (list '= (pfr-PS c 'pfz_ (list 'succ n)) (list '+ (pfr-PS c a (list 'succ n)) (list '* (list '- 'pfz_ a) (pfr-PS d 'pfz_ n)))))))
(define (pfr-div-concl c a n)
  (list 'FORSOME 'prd_ (list 'AND '(IN prd_ (FUN NN CC)) (list 'AND (pfr-vanish 'prd_ n)
    (list 'AND (pfr-rel c 'prd_ a) (list 'AND (pfr-c0 c 'prd_ a n) (pfr-ident c 'prd_ a n)))))))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'pfc_ (list 'IMPLIES '(IN pfc_ (FUN NN CC))
  (list 'IMPLIES (pfr-vanish 'pfc_ '(succ n)) (list 'FORALL 'pra_ (list 'IMPLIES '(IN pra_ CC) (pfr-div-concl 'pfc_ 'pra_ 'n))))))))))
;; close a conjunction of the division conclusion, given closers per conjunct shape
(define (pfr-div-close! d n vanish! rel! c0! ident!)
  (ew d)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (ass))
              ((and (dk-head-is? g 'FORALL) (dk-contains? g 'pfz_)) (let ((z (dk-di-var!))) (ident! z) (pfr-close-open!)))
              ((and (dk-head-is? g 'FORALL) (dk-contains? g '<=)) (let* ((lk (dk-peel!)) (k (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk))))) (vanish! k) (pfr-close-open!)))
              ((dk-head-is? g 'FORALL) (let ((k (dk-di-var!))) (rel! k) (pfr-close-open!)))
              (#t (c0!) (pfr-close-open!)))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  ;; base: c is the constant c(0); d = 0
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-zero-in) (fact 'nn-succ-closed 0)
  (pfr-Z-typ! 'CC)
  (fact 'fun-apply-type-c 'pfc_ 'NN 'CC 0)
  (let* ((zero-at (lambda (k) (fact 'fun-apply-type-c pfr-Z 'NN 'CC k) (dk-have! (list '= (list pfr-Z k) 0) (lambda () (pfr-beta! rfl)))))
         (ps1 (lambda (z)                       ; PS(c, z, 1) = c(0)
                (pfr-cc! (list 'power z 0))
                (subst (pfr-PS-succ! 'pfc_ z 0))
                (subst (dk-cite! 'cc-series-partial-sum-zero (pfr-H 'pfc_ z)))
                (subst (pfr-H-at! 'pfc_ z 0))
                (subst (dk-cite! 'power-zero z)))))
    (pfr-div-close! pfr-Z 0
      (lambda (k) (zero-at k))
      (lambda (k)
        (fact 'nn-succ-closed k) (zero-at k) (zero-at (list 'succ k))
        (fact 'nn-zero-le k)
        (pfr-chain! (dk-fact! 'nn-succ-mono 0 k))
        (subst (dk-apply! (pfr-vanish 'pfc_ '(succ 0)) (list 'succ k)))
        (subst (list '= (list pfr-Z k) 0)) (subst (list '= (list pfr-Z (list 'succ k)) 0))
        (crs))
      (lambda () (zero-at 0) (subst (list '= (list pfr-Z 0) 0)) (ps1 'pra_) (crs))
      (lambda (z)
        (pfr-H-typ! pfr-Z z)
        (ps1 z) (ps1 'pra_)
        (subst (dk-cite! 'cc-series-partial-sum-zero (pfr-H pfr-Z z)))
        (crs))))
  ;; step
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-zero-in)
  (fact 'nn-succ-closed v) (fact 'nn-succ-closed (list 'succ v))
  (fact 'fun-apply-type-c 'pfc_ 'NN 'CC 0)
  (let* ((sv (list 'succ v))
         (t (pfr-tail-sym! 'CC 'pfc_))
         (_0 (pfr-tail-vanish! 'pfc_ t sv))
         (ex (dk-apply! ih t 'pra_))
         (e (dk-skolem! ex))
         (_1 (dk-split-all!))
         (tT (pfr-PS t 'pra_ sv))
         (d (list 'CF-CONS tT e)))
    (pfr-PS-typ! t 'pra_ sv)
    (pfr-cons-cc! tT e)
    (fact 'fun-apply-type-c e 'NN 'CC 0)
    (pfr-div-close! d sv
      (lambda (k)
        (pfr-succ-case! k v (lambda (q) (subst (dk-cite! 'cf-cons-succ tT e q)) (dk-apply! (pfr-vanish e v) q) (pfr-close-open!))))
      (lambda (k)
        (fact 'nn-succ-closed k)
        (dk-apply! (pfr-tail-val t 'pfc_) k)
        (subst (list '= (list 'pfc_ (list 'succ k)) (list t k)))
        (use-cases (dk-cite! 'nn-zero-or-succ k)
          (lambda ()
            (subst (list '= k 0))
            (subst (dk-cite! 'cf-cons-zero tT e))
            (subst (dk-cite! 'cf-cons-succ tT e 0))
            (subst (pfr-c0 t e 'pra_ v))
            (pfr-cc! (list e 0)) (crs))
          (lambda ()
            (let* ((q (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f k))) "k = succ q")))
                   (_2 (dk-split-all!)))
              (subst (list '= k (list 'succ q)))
              (fact 'nn-succ-closed q)
              (subst (dk-cite! 'cf-cons-succ tT e q))
              (subst (dk-cite! 'cf-cons-succ tT e (list 'succ q)))
              (subst (dk-apply! (pfr-rel t e 'pra_) q))
              (fact 'fun-apply-type-c e 'NN 'CC q) (fact 'fun-apply-type-c e 'NN 'CC (list 'succ q))
              (crs)))))
      (lambda ()
        (subst (pfr-split! 'CC 'pfc_ t sv 'pra_))
        (subst (dk-cite! 'cf-cons-zero tT e))
        (crs))
      (lambda (z)
        (pfr-PS-typ! t z sv) (pfr-PS-typ! e z v)
        (subst (pfr-split! 'CC 'pfc_ t sv z))
        (subst (pfr-split! 'CC 'pfc_ t sv 'pra_))
        (subst (dk-apply! (pfr-ident t e 'pra_ v) z))
        (subst (dk-cite! 'cc-ps-cons v tT e z))
        (crs)))))
(qed 'cc-ps-divide)
(topic! 'cc-ps-divide 'analysis)

;;; ======================================================================
;;; (2) THE ROOT BOUND: coefficients vanishing from n + 1 on (degree <= n) and n + 1 distinct zeros
;;;     s(0), ..., s(n) force every coefficient to be 0.  (Over CC; a subring K of CC is the same.)
;;; ======================================================================
(define (pfr-inj s n) (list 'FORALL 'pri_ (list 'IMPLIES '(IN pri_ NN) (list 'IMPLIES (list '<= 'pri_ n)
  (list 'FORALL 'prj_ (list 'IMPLIES '(IN prj_ NN) (list 'IMPLIES (list '<= 'prj_ n)
    (list 'IMPLIES (list '= (list s 'pri_) (list s 'prj_)) '(= pri_ prj_)))))))))
(define (pfr-zeros c s n) (list 'FORALL 'pri_ (list 'IMPLIES '(IN pri_ NN) (list 'IMPLIES (list '<= 'pri_ n)
  (list '= (pfr-PS c (list s 'pri_) (list 'succ n)) 0)))))
(define (pfr-allzero c) (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) (list '= (list c 'pfk_) 0))))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'pfc_ (list 'IMPLIES '(IN pfc_ (FUN NN CC))
  (list 'IMPLIES (pfr-vanish 'pfc_ '(succ n)) (list 'FORALL 'prs_ (list 'IMPLIES '(IN prs_ (FUN NN CC))
    (list 'IMPLIES (pfr-inj 'prs_ 'n) (list 'IMPLIES (pfr-zeros 'pfc_ 'prs_ 'n) (pfr-allzero 'pfc_))))))))))))
(define (pfr-goal-k) (cadr (cadr (dk-goal))))      ; goal (= (c k) 0)
;; the conclusion at k from c(0) = 0 (landed) and the values c(succ q) (by CLOSE-SUCC! q)
(define (pfr-k-cases! k close-succ!)
  (use-cases (dk-cite! 'nn-zero-or-succ k)
    (lambda () (subst (list '= k 0)) (pfr-close-open!))
    (lambda ()
      (let* ((q (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f k))) "k = succ q")))
             (_0 (dk-split-all!)))
        (subst (list '= k (list 'succ q)))
        (close-succ! q)
        (pfr-close-open!)))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  ;; base: one zero s(0) of the constant c(0)
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (fact 'cc-zero-in) (fact 'nn-zero-in) (fact 'nn-le-refl 0) (fact 'nn-succ-closed 0)
  (fact 'fun-apply-type-c 'prs_ 'NN 'CC 0)
  (fact 'fun-apply-type-c 'pfc_ 'NN 'CC 0)
  (let* ((k (pfr-goal-k))
         (s0 '(prs_ 0))
         (z0 (dk-apply! (pfr-zeros 'pfc_ 'prs_ 0) 0))
         (ps (pfr-PS 'pfc_ s0 '(succ 0))))
    (pfr-cc! (list 'power s0 0))
    (dk-have! (list '= ps '(pfc_ 0))
      (lambda ()
        (subst (pfr-PS-succ! 'pfc_ s0 0))
        (subst (dk-cite! 'cc-series-partial-sum-zero (pfr-H 'pfc_ s0)))
        (subst (pfr-H-at! 'pfc_ s0 0))
        (subst (dk-cite! 'power-zero s0))
        (crs)))
    (dk-rewrite-h! z0 ps '(pfc_ 0))
    (pfr-k-cases! k
      (lambda (q)
        (fact 'nn-zero-le q) (fact 'nn-succ-closed q)
        (pfr-chain! (dk-fact! 'nn-succ-mono 0 q))
        (dk-apply! (pfr-vanish 'pfc_ '(succ 0)) (list 'succ q)))))
  ;; step: divide by z - s(n), the quotient has the n other zeros
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (fact 'cc-zero-in) (fact 'nn-zero-in)
  (let* ((k (pfr-goal-k))
         (sv (list 'succ v)) (ssv (list 'succ sv))
         (_0 (begin (fact 'nn-succ-closed v) (fact 'nn-succ-closed sv) (fact 'nn-le-refl sv)))
         (a (list 'prs_ sv))
         (_1 (fact 'fun-apply-type-c 'prs_ 'NN 'CC sv))
         (d (dk-skolem! (dk-cite! 'cc-ps-divide sv 'pfc_ a)))
         (_2 (dk-split-all!))
         (pa (dk-apply! (pfr-zeros 'pfc_ 'prs_ sv) sv)))
    (dk-have! (pfr-zeros d 'prs_ v)
      (lambda ()
        (let* ((lk (dk-peel!))
               (i (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk))))
               (si (list 'prs_ i))
               (q (pfr-PS d si sv)))
          (fact 'nn-le-succ v)
          (pfr-chain! (dk-fact! 'nn-le-trans-guarded i v sv))
          (fact 'fun-apply-type-c 'prs_ 'NN 'CC i)
          (pfr-PS-typ! d si sv) (pfr-PS-typ! 'pfc_ si ssv) (pfr-PS-typ! 'pfc_ a ssv)
          (let* ((zi (dk-apply! (pfr-zeros 'pfc_ 'prs_ sv) i))
                 (idi (dk-apply! (pfr-ident 'pfc_ d a sv) si))
                 (dif (list '- si a)))
            (pfr-cc! dif) (pfr-cc! (list '* dif q))
            (dk-have! (list '= (list '* dif q) 0)
              (lambda ()
                (dk-have! (list '= (list '* dif q) (list '- (pfr-PS 'pfc_ si ssv) (pfr-PS 'pfc_ a ssv)))
                  (lambda () (subst idi) (crs)))
                (subst (list '= (list '* dif q) (list '- (pfr-PS 'pfc_ si ssv) (pfr-PS 'pfc_ a ssv))))
                (subst zi) (subst pa) (crs)))
            (dk-have! (list 'NOT (list '= dif 0))
              (lambda ()
                (di)
                (dk-have! (list '= si a)
                  (lambda ()
                    (dk-have! (list '= si (list '+ dif a)) (lambda () (crs)))
                    (subst (list '= si (list '+ dif a)))
                    (subst (list '= dif 0))
                    (crs)))
                (let ((ij (dk-apply! (pfr-inj 'prs_ sv) i sv)))
                  (dk-rewrite-h! (list '<= i v) i sv)
                  (fact 'nn-succ-not-le v)
                  (pfr-only-prop! (list '<= sv v) (list 'NOT (list '<= sv v))))))
            (use-em (list '= q 0)
              (lambda () (ass))
              (lambda ()
                (pfr-chain! (dk-fact! 'cc-mul-nonzero dif q))
                (pfr-only-prop! (list '= (list '* dif q) 0) (list 'NOT (list '= (list '* dif q) 0)))))))))
    (dk-have! (pfr-inj 'prs_ v)
      (lambda ()
        (let* ((lk (dk-peel!))
               (eqf (car (filter (lambda (f) (and (dk-head-is? f '=) (pair? (cadr f)) (eq? (car (cadr f)) 'prs_))) lk)))
               (i (cadr (cadr eqf))) (j (cadr (caddr eqf))))
          (fact 'nn-le-succ v)
          (pfr-chain! (dk-fact! 'nn-le-trans-guarded i v sv))
          (pfr-chain! (dk-fact! 'nn-le-trans-guarded j v sv))
          (dk-apply! (pfr-inj 'prs_ sv) i j)
          (pfr-close-open!))))
    (dk-apply! ih d 'prs_)
    (fact 'fun-apply-type-c d 'NN 'CC 0)
    (dk-have! '(= (pfc_ 0) 0)
      (lambda ()
        (subst (pfr-c0 'pfc_ d a sv))
        (subst pa)
        (subst (dk-apply! (pfr-allzero d) 0))
        (crs)))
    (pfr-k-cases! k
      (lambda (q)
        (fact 'nn-succ-closed q)
        (subst (dk-apply! (pfr-rel 'pfc_ d a) q))
        (subst (dk-apply! (pfr-allzero d) q))
        (subst (dk-apply! (pfr-allzero d) (list 'succ q)))
        (crs)))
    ))
(qed 'cc-ps-root-bound)
(topic! 'cc-ps-root-bound 'analysis)

;;; ======================================================================
;;; (3) UNIQUENESS OF COEFFICIENTS on an infinite set (one with an injective sequence of points)
;;; ======================================================================
(define pfr-infinite '(FORSOME prs_ (AND (IN prs_ (FUN NN a)) (FORALL pri_ (IMPLIES (IN pri_ NN) (FORALL prj_ (IMPLIES (IN prj_ NN)
                        (IMPLIES (= (prs_ pri_) (prs_ prj_)) (= pri_ prj_)))))))))
(define pfr-agree '(FORALL pfz_ (IMPLIES (IN pfz_ a) (= (CC-SERIES-PARTIAL-SUM (VNB-LAMBDA pfj_ NN (* (pfc_ pfj_) (power pfz_ pfj_))) n)
                                                       (CC-SERIES-PARTIAL-SUM (VNB-LAMBDA pfj_ NN (* (pfd_ pfj_) (power pfz_ pfj_))) m)))))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(SUBSET a CC) (list 'IMPLIES pfr-infinite
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'pfc_ (list 'IMPLIES '(IN pfc_ (FUN NN CC)) (list 'IMPLIES (pfr-vanish 'pfc_ 'n)
    (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'pfd_ (list 'IMPLIES '(IN pfd_ (FUN NN CC)) (list 'IMPLIES (pfr-vanish 'pfd_ 'm)
      (list 'IMPLIES pfr-agree (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) '(= (pfc_ pfk_) (pfd_ pfk_))))))))))))))))))))
(dk-peel!)
(fact 'cc-zero-in) (fact 'cc-one-in)
(dk-have! '(IN -1 CC) (lambda () (arith)))
(let* ((k (cadr (cadr (dk-goal))))
       (s (dk-skolem! pfr-infinite))
       (_0 (dk-split-all!))
       (nm '(+ n m)) (snm (list 'succ '(+ n m)))
       (e (list 'VNB-LAMBDA 'pfk_ 'NN (list '+ (list '* 1 '(pfc_ pfk_)) (list '* -1 '(pfd_ pfk_))))))
  (fact 'fun-codomain-superset s 'NN 'a 'CC)
  (pfr-nn! nm) (pfr-nn! '(+ m n)) (fact 'nn-succ-closed nm)
  (dk-have! (list '= nm '(+ m n)) (lambda () (pfr-chain! (dk-fact! 'nn-add-comm 'n 'm)) (pfr-close-open!)))
  (dk-have! (list 'IN e '(FUN NN CC))
    (lambda () (dk-lam-type! (lambda () (let* ((j (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                          (fact 'fun-apply-type-c 'pfc_ 'NN 'CC j) (fact 'fun-apply-type-c 'pfd_ 'NN 'CC j)
                                          (if (not (sequent-node-grounded? leaf)) (pfr-cc! (cadr (dk-goal))))
                                          (pfr-close-open!))))))
  (dk-have! (pfr-lcomb e 'pfc_ 'pfd_ 1 -1)
    (lambda () (let ((j (dk-di-var!))) (fact 'fun-apply-type-c 'pfc_ 'NN 'CC j) (fact 'fun-apply-type-c 'pfd_ 'NN 'CC j)
                 (pfr-cc! (list '+ (list '* 1 (list 'pfc_ j)) (list '* -1 (list 'pfd_ j)))) (pfr-beta! rfl))))
  ;; e vanishes from n + m + 1 on
  (dk-have! (pfr-vanish e snm)
    (lambda ()
      (let* ((lk (dk-peel!)) (j (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk)))))
        (dk-cite! 'nn-le-add-right 'm 'n) (dk-cite! 'nn-le-add-right 'n 'm)
        (fact 'nn-le-succ nm)
        (pfr-chain! (dk-fact! 'nn-le-trans-guarded nm snm j))
        (pfr-chain! (dk-fact! 'nn-le-trans-guarded 'n nm j))
        (dk-rewrite-h! (list '<= nm j) nm '(+ m n))
        (pfr-chain! (dk-fact! 'nn-le-trans-guarded 'm '(+ m n) j))
        (fact 'fun-apply-type-c 'pfc_ 'NN 'CC j) (fact 'fun-apply-type-c 'pfd_ 'NN 'CC j)
        (pfr-beta! (lambda ()
                     (subst (dk-apply! (pfr-vanish 'pfc_ 'n) j))
                     (subst (dk-apply! (pfr-vanish 'pfd_ 'm) j))
                     (crs))))))
  ;; s injective on [0, n + m]; e vanishes at s(0), ..., s(n + m)
  (dk-have! (pfr-inj s nm)
    (lambda ()
      (let* ((lk (dk-peel!))
             (eqf (car (filter (lambda (f) (and (dk-head-is? f '=) (pair? (cadr f)) (eq? (car (cadr f)) s))) lk))))
        (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f s) (dk-contains? f 'prj_))) "injectivity")
                   (cadr (cadr eqf)) (cadr (caddr eqf)))
        (pfr-close-open!))))
  (dk-have! (pfr-zeros e s nm)
    (lambda ()
      (let* ((lk (dk-peel!))
             (i (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk))))
             (si (list s i)))
        (fact 'fun-apply-type-c s 'NN 'a i)
        (fact 'subset-mem-fwd 'a 'CC si)
        (pfr-PS-typ! 'pfc_ si 'n) (pfr-PS-typ! 'pfd_ si 'm)
        (pfr-PS-typ! 'pfc_ si snm) (pfr-PS-typ! 'pfd_ si snm)
        (subst (pfr-chain! (dk-fact! 'cc-ps-lincomb snm 'pfc_ 'pfd_ e 1 -1 si)))
        (fact 'nn-succ-closed 'm) (fact 'nn-succ-closed 'n)
        (pfr-nn! '(+ n (succ m))) (pfr-nn! '(+ m (succ n))) (fact 'nn-succ-closed '(+ m n))
        (dk-have! (list '= snm '(+ n (succ m))) (lambda () (subst (dk-cite! 'nn-add-succ 'n 'm)) (rfl)))
        (dk-have! (list '= '(succ (+ m n)) '(+ m (succ n))) (lambda () (subst (dk-cite! 'nn-add-succ 'm 'n)) (rfl)))
        (dk-have! (list '= (pfr-PS 'pfc_ si snm) (pfr-PS 'pfc_ si 'n))
          (lambda ()
            (subst (list '= snm '(+ n (succ m))))
            (pfr-chain! (dk-fact! 'cc-ps-stable '(succ m) 'n 'pfc_ si))
            (pfr-close-open!)))
        (dk-have! (list '= (pfr-PS 'pfd_ si snm) (pfr-PS 'pfd_ si 'm))
          (lambda ()
            (subst (list '= nm '(+ m n)))
            (subst (list '= (list 'succ '(+ m n)) '(+ m (succ n))))
            (pfr-chain! (dk-fact! 'cc-ps-stable '(succ n) 'm 'pfd_ si))
            (pfr-close-open!)))
        (subst (list '= (pfr-PS 'pfc_ si snm) (pfr-PS 'pfc_ si 'n)))
        (subst (list '= (pfr-PS 'pfd_ si snm) (pfr-PS 'pfd_ si 'm)))
        (subst (dk-apply! pfr-agree si))
        (crs))))
  (dk-cite! 'cc-ps-root-bound nm e s)
  (let ((ek (dk-apply! (pfr-allzero e) k)))
    (fact 'fun-apply-type-c 'pfc_ 'NN 'CC k) (fact 'fun-apply-type-c 'pfd_ 'NN 'CC k)
    (pfr-cc! (list '+ (list '* 1 (list 'pfc_ k)) (list '* -1 (list 'pfd_ k))))
    (dk-have! (list '= (list e k) (list '+ (list '* 1 (list 'pfc_ k)) (list '* -1 (list 'pfd_ k)))) (lambda () (pfr-beta! rfl)))
    (dk-rewrite-h! ek (list e k) (list '+ (list '* 1 (list 'pfc_ k)) (list '* -1 (list 'pfd_ k))))
    (dk-have! (list '= (list 'pfc_ k) (list '+ (list '+ (list '* 1 (list 'pfc_ k)) (list '* -1 (list 'pfd_ k))) (list 'pfd_ k))) (lambda () (crs)))
    (subst (list '= (list 'pfc_ k) (list '+ (list '+ (list '* 1 (list 'pfc_ k)) (list '* -1 (list 'pfd_ k))) (list 'pfd_ k))))
    (subst (list '= (list '+ (list '* 1 (list 'pfc_ k)) (list '* -1 (list 'pfd_ k))) 0))
    (crs)))
(qed 'cc-ps-coef-unique)
(topic! 'cc-ps-coef-unique 'analysis)

;; a coefficient sequence LAM (in FUN(NN, CC), typed in context) as a fresh symbol: returns (sym . value-universal)
(define pfr-ev #f)
(define (pfr-seq-sym! lam)
  (let* ((val (lambda (sy) (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) (list '= (list sy 'pfk_) (subst-free (cadr lam) 'pfk_ (cadddr lam)))))))
         (ex (list 'FORSOME 'pfes_ (list 'AND '(IN pfes_ (FUN NN CC)) (val 'pfes_)))))
    (dk-have! ex
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (let ((k (dk-di-var!)))
                  (fact 'fun-apply-type-c lam 'NN 'CC k)
                  (pfr-cc! (subst-free (cadr lam) k (cadddr lam)))
                  (pfr-beta! rfl)))))))
    (let ((sy (dk-skolem! ex)))
      (dk-split-all!)
      (cons sy (val sy)))))

;;; ======================================================================
;;; (4) DEGREE OF A PRODUCT over CC: lengths n + 1 and m + 1 with nonzero top coefficients give a
;;;     product of length n + m + 1 with nonzero top coefficient c(n) d(m)
;;; ======================================================================
(define (pfr-deg-concl n m)
  (list 'FORSOME 'pre_ (list 'AND '(IN pre_ (FUN NN CC)) (list 'AND (pfr-vanish 'pre_ (list 'succ (list '+ n m)))
    (list 'AND (list 'NOT (list '= (list 'pre_ (list '+ n m)) 0))
      (list 'FORALL 'pfz_ (list 'IMPLIES '(IN pfz_ CC)
        (list '= (list '* (pfr-PS 'pfc_ 'pfz_ (list 'succ n)) (pfr-PS 'pfd_ 'pfz_ (list 'succ m)))
                 (pfr-PS 'pre_ 'pfz_ (list 'succ (list '+ n m)))))))))))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'pfc_ (list 'IMPLIES '(IN pfc_ (FUN NN CC))
  (list 'IMPLIES (pfr-vanish 'pfc_ '(succ n)) (list 'IMPLIES '(NOT (= (pfc_ n) 0))
    (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'pfd_ (list 'IMPLIES '(IN pfd_ (FUN NN CC))
      (list 'IMPLIES (pfr-vanish 'pfd_ '(succ m)) (list 'IMPLIES '(NOT (= (pfd_ m) 0)) (pfr-deg-concl 'n 'm)))))))))))))))
;; the witness: e, typed, with the three properties proved by VAN!, TOP!, IDENT! (each on its own goal)
(define (pfr-deg-close! e van! top! ident!)
  (ew e)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (ass))
              ((dk-head-is? g 'NOT) (top!) (pfr-close-open!))
              ((dk-contains? g 'pfz_) (let ((z (dk-di-var!))) (ident! z) (pfr-close-open!)))
              (#t (let* ((lk (dk-peel!)) (k (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk))))) (van! k) (pfr-close-open!))))))))
;; PS(c, z, 1) = c(0)
(define (pfr-ps1! c z)
  (let ((e (list '= (pfr-PS c z '(succ 0)) (list c 0))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (fact 'nn-zero-in) (fact 'fun-apply-type-c c 'NN 'CC 0)
            (pfr-cc! (list 'power z 0))
            (subst (pfr-PS-succ! c z 0))
            (subst (dk-cite! 'cc-series-partial-sum-zero (pfr-H c z)))
            (subst (pfr-H-at! c z 0))
            (subst (dk-cite! 'power-zero z))
            (crs))))
    e))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  ;; base: c is the nonzero constant c(0)
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (fact 'cc-zero-in) (fact 'nn-zero-in) (fact 'nn-succ-closed 'm)
  (fact 'fun-apply-type-c 'pfc_ 'NN 'CC 0)
  (pfr-nn! '(+ 0 m))
  (dk-have! '(= (+ 0 m) m) (lambda () (subst (pfr-chain! (dk-fact! 'nn-add-comm 0 'm))) (subst (dk-cite! 'nn-add-zero 'm)) (rfl)))
  (subst '(= (+ 0 m) m))
  (let ((e '(VNB-LAMBDA pfk_ NN (* (pfc_ 0) (pfd_ pfk_)))))
    (dk-have! (list 'IN e '(FUN NN CC))
      (lambda () (dk-lam-type! (lambda () (let* ((j (dk-di-var!)) (leaf (proof-state-focus *ps*))) (fact 'fun-apply-type-c 'pfd_ 'NN 'CC j)
                                            (if (not (sequent-node-grounded? leaf)) (pfr-cc! (cadr (dk-goal)))) (pfr-close-open!))))))
    (pfr-deg-close! e
      (lambda (k)
        (fact 'fun-apply-type-c 'pfd_ 'NN 'CC k)
        (pfr-beta! (lambda () (subst (dk-apply! (pfr-vanish 'pfd_ '(succ m)) k)) (crs))))
      (lambda ()
        (fact 'fun-apply-type-c 'pfd_ 'NN 'CC 'm)
        (pfr-chain! (dk-fact! 'cc-mul-nonzero '(pfc_ 0) '(pfd_ m)))
        (pfr-cc! '(* (pfc_ 0) (pfd_ m)))
        (dk-have! (list '= (list e 'm) '(* (pfc_ 0) (pfd_ m))) (lambda () (pfr-beta! rfl)))
        (subst (list '= (list e 'm) '(* (pfc_ 0) (pfd_ m))))
        (ass))
      (lambda (z)
        (pfr-PS-typ! 'pfd_ z '(succ m))
        (subst (pfr-ps1! 'pfc_ z))
        (dk-have! (pfr-lcomb e 'pfd_ 'pfd_ '(pfc_ 0) 0)
          (lambda () (let ((k (dk-di-var!))) (fact 'fun-apply-type-c 'pfd_ 'NN 'CC k)
                       (pfr-cc! (list '+ (list '* '(pfc_ 0) (list 'pfd_ k)) (list '* 0 (list 'pfd_ k))))
                       (pfr-beta! crs))))
        (subst (pfr-chain! (dk-fact! 'cc-ps-lincomb '(succ m) 'pfd_ 'pfd_ e '(pfc_ 0) 0 z)))
        (crs))))
  ;; step
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-zero-in)
  (let* ((sv (list 'succ v)) (nm (list '+ v 'm)) (snm (list 'succ nm)) (M (list '+ sv 'm)) (sM (list 'succ M))
         (_0 (begin (fact 'nn-succ-closed v) (fact 'nn-succ-closed sv) (fact 'nn-succ-closed 'm)
                    (pfr-nn! nm) (pfr-nn! M) (fact 'nn-succ-closed nm) (fact 'nn-succ-closed snm)))
         (t (pfr-tail-sym! 'CC 'pfc_))
         (_1 (pfr-tail-vanish! 'pfc_ t sv))
         (_2 (dk-have! (list 'NOT (list '= (list t v) 0))
               (lambda () (subst (dk-apply! (pfr-tail-val t 'pfc_) v)) (ass))))
         (e1 (dk-skolem! (dk-apply! ih t 'm 'pfd_)))
         (_3 (dk-split-all!))
         (cn (list 'CF-CONS 0 e1))
         (e (list 'VNB-LAMBDA 'pfk_ 'NN (list '+ (list '* '(pfc_ 0) '(pfd_ pfk_)) (list '* 1 (list cn 'pfk_))))))
    (fact 'fun-apply-type-c 'pfc_ 'NN 'CC 0)
    (pfr-cons-cc! 0 e1)
    (dk-have! (list '= M snm) (lambda () (subst (dk-cite! 'tab-succ-add v 'm)) (rfl)))
    (subst (list '= M snm))
    (dk-have! (list 'IN e '(FUN NN CC))
      (lambda () (dk-lam-type! (lambda () (let* ((j (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                            (fact 'fun-apply-type-c 'pfd_ 'NN 'CC j) (fact 'fun-apply-type-c cn 'NN 'CC j)
                                            (if (not (sequent-node-grounded? leaf)) (pfr-cc! (cadr (dk-goal)))) (pfr-close-open!))))))
    ;; e as a fresh symbol with its value equation (beta would otherwise act inside the partial sums)
    (set! pfr-ev (pfr-seq-sym! e))
    ;; d vanishes at every k >= n + m + 1 (>= m + 1)
    (dk-cite! 'nn-le-add-right v 'm)
    (fact 'nn-le-succ nm)
    (let ((d-zero! (lambda (k)                   ; k with (<= snm k) in context: d(k) = 0
                     (pfr-chain! (dk-fact! 'nn-succ-mono 'm nm))
                     (pfr-chain! (dk-fact! 'nn-le-trans-guarded '(succ m) snm k))
                     (dk-apply! (pfr-vanish 'pfd_ '(succ m)) k)))
          (dm (begin
                (dk-have! (list '= (list '+ 'm v) nm) (lambda () (pfr-chain! (dk-fact! 'nn-add-comm 'm v)) (pfr-close-open!)))
                (dk-rewrite-h! (list '<= 'm (list '+ 'm v)) (list '+ 'm v) nm))))
      (pfr-deg-close! (car pfr-ev)
        (lambda (k)                              ; k >= succ snm
          (fact 'fun-apply-type-c 'pfd_ 'NN 'CC k) (fact 'fun-apply-type-c cn 'NN 'CC k)
          (fact 'nn-le-succ snm)
          (pfr-chain! (dk-fact! 'nn-le-trans-guarded snm (list 'succ snm) k))
          (d-zero! k)
          (dk-have! (list '= (list cn k) 0)
            (lambda () (pfr-succ-case! k snm (lambda (q) (subst (dk-cite! 'cf-cons-succ 0 e1 q)) (dk-apply! (pfr-vanish e1 snm) q) (pfr-close-open!)))))
          (subst (dk-apply! (cdr pfr-ev) k)) (subst (list '= (list 'pfd_ k) 0)) (subst (list '= (list cn k) 0)) (crs))
        (lambda ()                               ; e(n + m + 1) = e1(n + m) /= 0
          (fact 'nn-le-refl snm)
          (d-zero! snm)
          (fact 'fun-apply-type-c 'pfd_ 'NN 'CC snm) (fact 'fun-apply-type-c cn 'NN 'CC snm) (fact 'fun-apply-type-c e1 'NN 'CC nm)
          (pfr-cc! (list '+ (list '* '(pfc_ 0) (list 'pfd_ snm)) (list '* 1 (list cn snm))))
          (dk-have! (list '= (list (car pfr-ev) snm) (list e1 nm))
            (lambda ()
              (subst (dk-apply! (cdr pfr-ev) snm))
              (subst (list '= (list 'pfd_ snm) 0))
              (subst (dk-cite! 'cf-cons-succ 0 e1 nm))
              (crs)))
          (subst (list '= (list (car pfr-ev) snm) (list e1 nm)))
          (ass))
        (lambda (z)
          (let* ((D (pfr-PS 'pfd_ z '(succ m)))
                 (es (car pfr-ev))
                 (P (pfr-PS es z (list 'succ snm)))
                 (Y (list '* (pfr-PS 'pfc_ z (list 'succ sv)) D))
                 (_0 (begin (pfr-PS-typ! 'pfd_ z '(succ m)) (pfr-PS-typ! t z sv) (pfr-PS-typ! e1 z snm)
                            (pfr-PS-typ! es z (list 'succ snm)) (pfr-PS-typ! 'pfc_ z (list 'succ sv))
                            (pfr-PS-typ! 'pfd_ z (list 'succ snm)) (pfr-PS-typ! cn z (list 'succ snm))))
                 (lc (pfr-chain! (dk-fact! 'cc-ps-lincomb (list 'succ snm) 'pfd_ cn es '(pfc_ 0) 1 z)))
                 (X (caddr lc)))
            (pfr-cc! Y) (pfr-cc! X)
            (dk-have! (list '= Y X)
              (lambda ()
                (subst (pfr-split! 'CC 'pfc_ t sv z))
                (let ((ce (list '= (pfr-PS cn z (list 'succ snm)) (list '+ 0 (list '* z (pfr-PS e1 z snm))))))
                  (dk-have! ce (lambda () (dk-cite! 'cc-ps-cons snm 0 e1 z) (pfr-close-open!)))
                  (subst ce))
                ;; PS(d, z, n + m + 2) = PS(d, z, m + 1)
                (pfr-nn! (list '+ '(succ m) (list 'succ sv)))
                (dk-have! (list '= (pfr-PS 'pfd_ z (list 'succ snm)) D)
                  (lambda ()
                    (dk-have! (list '= (list 'succ snm) (list '+ '(succ m) (list 'succ v)))
                      (lambda ()
                        (subst (dk-cite! 'tab-succ-add 'm (list 'succ v)))
                        (subst (dk-cite! 'nn-add-succ 'm v))
                        (subst (list '= (list '+ 'm v) nm))
                        (rfl)))
                    (subst (list '= (list 'succ snm) (list '+ '(succ m) (list 'succ v))))
                    (pfr-chain! (dk-fact! 'cc-ps-stable (list 'succ v) '(succ m) 'pfd_ z))
                    (pfr-close-open!)))
                (subst (list '= (pfr-PS 'pfd_ z (list 'succ snm)) D))
                (let ((ihz (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f e1) (dk-contains? f t) (dk-contains? f 'pfz_))) "IH identity") z)))
                  (subst (list '= (caddr ihz) (cadr ihz))))
                (crs)))
            (subst (list '= Y X))
            (subst (list '= X P))
            (rfl)))))))
(qed 'cc-ps-deg-mul)
(topic! 'cc-ps-deg-mul 'analysis)

;;; ----------------------------------------------------------------------
;;; degree at the level of functions
;;; ----------------------------------------------------------------------
(define (pfr-allzero-eq c d) (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) (list '= (list c 'pfk_) (list d 'pfk_)))))
(define (pfr-dval f a c n) (list 'FORALL 'pfz_ (list 'IMPLIES (list 'IN 'pfz_ a) (list '= (list f 'pfz_) (pfr-PS c 'pfz_ (list 'succ n))))))
;; open IS-POLY-DEG(kc, a, f, n): land a subset kc, f in FUN(a, kc), skolem c with its four facts; return c
(define (pfr-deg-open! kc a f n)
  (let* ((h (list 'IS-POLY-DEG kc a f n))
         (iff (dk-cite! 'is-poly-deg kc a f n))
         (rhs (caddr iff)))
    (dk-project! (list 'SUBSET a kc) (lambda () (dk-only! iff h)))
    (dk-project! (list 'IN f (list 'FUN a kc)) (lambda () (dk-only! iff h)))
    (let ((ex (caddr (caddr rhs))))
      (dk-project! ex (lambda () (dk-only! iff h)))
      (let ((c (dk-skolem! ex)))
        (dk-split-all!)
        c))))
;; prove IS-POLY-DEG(kc, a, g, n) with coefficients c: the facts in context, VAL! closes (= (g z) PS(c, z, succ n))
(define (pfr-deg-intro! kc a g n c val!)
  (let* ((iff (dk-cite! 'is-poly-deg kc a g n)) (rhs (caddr iff)))
    (dk-have! rhs
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (cond ((dk-asm? (dk-goal)) (ass))
                  ((dk-head-is? (dk-goal) 'FORSOME)
                   (ew c)
                   (dk-conj-close!
                     (lambda ()
                       (cond ((dk-asm? (dk-goal)) (ass))
                             (#t (let ((z (dk-di-var!))) (val! z) (pfr-close-open!)))))))
                  (#t (error "pfr-deg-intro!: unexpected goal" (expression->string (dk-goal)))))))))
    (pfr-only-prop! iff rhs)))

;;; a polynomial function of degree n is a polynomial function
(sp (make-wff '(FORALL kk (FORALL a (FORALL f (FORALL n (IMPLIES (IN n NN) (IMPLIES (IS-POLY-DEG kk a f n) (IS-POLY-FN-ON kk a f)))))))))
(dk-peel!)
(let ((c (pfr-deg-open! 'kk 'a 'f 'n)))
  (fact 'nn-succ-closed 'n)
  (pfr-poly-intro! 'kk 'a 'f '(succ n) c (lambda (z) (dk-apply! (pfr-dval 'f 'a c 'n) z))))
(qed 'poly-deg-is-poly-fn)
(topic! 'poly-deg-is-poly-fn 'analysis)

;;; deg(f g) = deg f + deg g over CC
(sp (make-wff '(FORALL a (FORALL f (FORALL g (FORALL n (IMPLIES (IN n NN) (FORALL m (IMPLIES (IN m NN)
  (IMPLIES (IS-POLY-DEG CC a f n) (IMPLIES (IS-POLY-DEG CC a g m)
    (IS-POLY-DEG CC a (VNB-LAMBDA pfx_ a (* (f pfx_) (g pfx_))) (+ n m)))))))))))))
(dk-peel!)
(fact 'cc-is-set)
(let* ((c (pfr-deg-open! 'CC 'a 'f 'n)) (d (pfr-deg-open! 'CC 'a 'g 'm))
       (e (dk-skolem! (dk-cite! 'cc-ps-deg-mul 'n c 'm d)))
       (_0 (dk-split-all!))
       (h '(VNB-LAMBDA pfx_ a (* (f pfx_) (g pfx_)))))
  (fact 'subclass-of-set-is-set 'a 'CC)
  (pfr-nn! '(+ n m))
  (dk-have! (list 'IN h '(FUN a CC))
    (lambda () (dk-lam-type! (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                          (fact 'fun-apply-type-c 'f 'a 'CC x) (fact 'fun-apply-type-c 'g 'a 'CC x)
                                          (if (not (sequent-node-grounded? leaf)) (pfr-cc! (cadr (dk-goal)))) (pfr-close-open!))))))
  (pfr-deg-intro! 'CC 'a h '(+ n m) e
    (lambda (z)
      (fact 'subset-mem-fwd 'a 'CC z)
      (fact 'fun-apply-type-c 'f 'a 'CC z) (fact 'fun-apply-type-c 'g 'a 'CC z)
      (pfr-cc! '(* (f pfz_) (g pfz_)))
      (pfr-cc! (list '* (list 'f z) (list 'g z)))
      (dk-have! (list '= (list h z) (list '* (list 'f z) (list 'g z))) (lambda () (pfr-beta! rfl)))
      (subst (list '= (list h z) (list '* (list 'f z) (list 'g z))))
      (subst (dk-apply! (pfr-dval 'f 'a c 'n) z))
      (subst (dk-apply! (pfr-dval 'g 'a d 'm) z))
      (dk-apply! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm e) (dk-contains? fm 'pfz_))) "the product identity") z))))
(qed 'poly-deg-mul)
(topic! 'poly-deg-mul 'analysis)

;;; on an infinite set the degree is unique
(define pfr-inf-a '(FORSOME prs_ (AND (IN prs_ (FUN NN a)) (FORALL pri_ (IMPLIES (IN pri_ NN) (FORALL prj_ (IMPLIES (IN prj_ NN)
                        (IMPLIES (= (prs_ pri_) (prs_ prj_)) (= pri_ prj_)))))))))
(sp (make-wff (list 'FORALL 'kk (list 'IMPLIES '(SUBSET kk CC) (list 'FORALL 'a (list 'IMPLIES pfr-inf-a
  (list 'FORALL 'f (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'm (list 'IMPLIES '(IN m NN)
    (list 'IMPLIES '(IS-POLY-DEG kk a f n) (list 'IMPLIES '(IS-POLY-DEG kk a f m) '(= n m))))))))))))))
(dk-peel!)
(let* ((c (pfr-deg-open! 'kk 'a 'f 'n)) (d (pfr-deg-open! 'kk 'a 'f 'm)))
  (fact 'subset-trans 'a 'kk 'CC)
  (fact 'fun-codomain-superset c 'NN 'kk 'CC) (fact 'fun-codomain-superset d 'NN 'kk 'CC)
  (fact 'nn-succ-closed 'n) (fact 'nn-succ-closed 'm)
  (dk-have! (list 'FORALL 'pfz_ (list 'IMPLIES '(IN pfz_ a) (list '= (pfr-PS c 'pfz_ '(succ n)) (pfr-PS d 'pfz_ '(succ m)))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (fact 'subset-mem-fwd 'a 'CC z)
        (let* ((ec (dk-apply! (pfr-dval 'f 'a c 'n) z))
              (ed (dk-apply! (pfr-dval 'f 'a d 'm) z)))
          (pfr-PS-typ! d z '(succ m))
          (subst (list '= (caddr ec) (cadr ec)))
          (subst ed)
          (rfl)))))
  (let ((same (dk-cite! 'cc-ps-coef-unique 'a '(succ n) c '(succ m) d)))
    (fact 'nn-in-rr 'n) (fact 'nn-in-rr 'm)
    (use-cases (dk-fact! 'rr-lt-trichotomy 'n 'm)
      (lambda ()
        (pfr-chain! (dk-fact! 'nn-lt-succ-le 'n 'm))
        (dk-apply! (pfr-vanish c '(succ n)) 'm)
        (dk-apply! (pfr-allzero-eq c d) 'm)
        (dk-rewrite-h! (list '= (list c 'm) 0) (list c 'm) (list d 'm))
        (pfr-only-prop! (list '= (list d 'm) 0) (list 'NOT (list '= (list d 'm) 0))))
      (lambda () (ass))
      (lambda ()
        (pfr-chain! (dk-fact! 'nn-lt-succ-le 'm 'n))
        (dk-apply! (pfr-vanish d '(succ m)) 'n)
        (dk-apply! (pfr-allzero-eq c d) 'n)
        (dk-rewrite-h! (list '= (list d 'n) 0) (list d 'n) (list c 'n))
        (pfr-only-prop! (list '= (list c 'n) 0) (list 'NOT (list '= (list c 'n) 0)))))))
(qed 'poly-deg-unique)
(topic! 'poly-deg-unique 'analysis)

;;; DEG(K, A, f) = n when f has degree n on an infinite A
(sp (make-wff (list 'FORALL 'kk (list 'IMPLIES '(SUBSET kk CC) (list 'FORALL 'a (list 'IMPLIES pfr-inf-a
  (list 'FORALL 'f (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(IS-POLY-DEG kk a f n) '(= (POLY-FN-DEG kk a f) n)))))))))))
(dk-peel!)
(mac 'POLY-FN-DEG)
(define pfr-io (cadr (dk-goal)))
(define (pfr-uniq!)                         ; goal (= u w), both of degree: cite uniqueness in that orientation
  (dk-cite! 'poly-deg-unique 'kk 'a 'f (cadr (dk-goal)) (caddr (dk-goal))))
(for-each
  (lambda (leaf)
    (dk-focus! leaf)
    (if (dk-head-is? (dk-goal) 'FORSOME)
        (begin
          (ew 'n)
          (dk-conj-close!
            (lambda ()
              (cond ((dk-asm? (dk-goal)) (ass))
                    ((dk-head-is? (dk-goal) 'FORALL)
                     (let* ((lk (dk-peel!)))
                       (dk-split-all!)
                       (let ((y (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-asms))))))
                         (pfr-uniq!)
                         (pfr-close-open!))))
                    (#t (dk-conj-close! (lambda () (ass))))))))
        (begin
          (dk-split-all!)
          (pfr-uniq!)
          (pfr-close-open!))))
  (dk-opened (lambda () (iota-d pfr-io))))
(qed 'deg-value)
(topic! 'deg-value 'analysis)

;;; DEG(f g) = DEG f + DEG g over CC, on an infinite set
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(SUBSET a CC) (list 'IMPLIES pfr-inf-a
  (list 'FORALL 'f (list 'FORALL 'g (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'm (list 'IMPLIES '(IN m NN)
    (list 'IMPLIES '(IS-POLY-DEG CC a f n) (list 'IMPLIES '(IS-POLY-DEG CC a g m)
      '(= (POLY-FN-DEG CC a (VNB-LAMBDA pfx_ a (* (f pfx_) (g pfx_)))) (+ (POLY-FN-DEG CC a f) (POLY-FN-DEG CC a g))))))))))))))))
(dk-peel!)
(dk-have! '(SUBSET CC CC) (lambda () (let ((x (subset-by-element!))) (pfr-close-open!))))
(pfr-nn! '(+ n m))
(dk-cite! 'poly-deg-mul 'a 'f 'g 'n 'm)
(subst (dk-cite! 'deg-value 'CC 'a 'f 'n))
(subst (dk-cite! 'deg-value 'CC 'a 'g 'm))
(subst (dk-cite! 'deg-value 'CC 'a '(VNB-LAMBDA pfx_ a (* (f pfx_) (g pfx_))) '(+ n m)))
(rfl)
(qed 'deg-mul)
(topic! 'deg-mul 'analysis)

;;; ROOTS: a polynomial function of degree n on A has no n + 1 distinct zeros in A
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'f (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(IS-POLY-DEG CC a f n)
  (list 'FORALL 'prs_ (list 'IMPLIES '(IN prs_ (FUN NN a)) (list 'IMPLIES (pfr-inj 'prs_ 'n)
    (list 'NOT (list 'FORALL 'pri_ (list 'IMPLIES '(IN pri_ NN) (list 'IMPLIES '(<= pri_ n) '(= (f (prs_ pri_)) 0)))))))))))))))
(dk-peel!)
(let* ((c (pfr-deg-open! 'CC 'a 'f 'n))
       (zf '(FORALL pri_ (IMPLIES (IN pri_ NN) (IMPLIES (<= pri_ n) (= (f (prs_ pri_)) 0))))))
  (fact 'fun-codomain-superset 'prs_ 'NN 'a 'CC)
  (di)
  (dk-have! (pfr-zeros c 'prs_ 'n)
    (lambda ()
      (let* ((lk (dk-peel!))
             (i (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk))))
             (si (list 'prs_ i)))
        (fact 'fun-apply-type-c 'prs_ 'NN 'a i)
        (let* ((fv (dk-apply! (pfr-dval 'f 'a c 'n) si))
               (z0 (dk-apply! zf i)))
          (subst (list '= (caddr fv) (cadr fv)))
          (pfr-close-open!)))))
  (dk-cite! 'cc-ps-root-bound 'n c 'prs_)
  (dk-apply! (pfr-allzero c) 'n)
  (pfr-only-prop! (list '= (list c 'n) 0) (list 'NOT (list '= (list c 'n) 0))))
(qed 'poly-deg-roots)
(topic! 'poly-deg-roots 'analysis)
