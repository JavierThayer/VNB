                 (dk-if-branch! #f (cadr (dk-goal)) #f (lambda () (if (not (proof-done? *ps*)) (rfl)))))))
  (dk-have! (list 'IN g (list 'FUN WW 'CC))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((x (dk-di-var!)) (ift (cadr (dk-goal))))
