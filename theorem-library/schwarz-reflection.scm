;;; a derivative transfers to a function that agrees near the point
(define (rx-min! x y)                        ; x, y > 0: a fresh m with m in RR, 0 < m, m <= x, m <= y
  (let ((mex (list 'FORSOME 'rxm_ (list 'AND '(IN rxm_ RR) (list 'AND '(< 0 rxm_) (list 'AND (list '<= 'rxm_ x) (list '<= 'rxm_ y)))))))
    (dk-have! mex
      (lambda () (fact 'rr-le-total x y)
                 (use-cases (list (list '<= x y) (list '<= y x))
                   (lambda () (ew x) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '<= x y) (list '< 0 x))))))
                   (lambda () (ew y) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '<= y x) (list '< 0 y)))))))))
    (let ((m (dk-skolem! mex #t))) (dk-split-all!) m)))
(define rx-near '(FORSOME rxr_ (AND (POS-RR rxr_) (FORALL rxz_ (IMPLIES (IN rxz_ rxb_) (IMPLIES (< (magnitude (- rxz_ rxp_)) rxr_) (AND (IN rxz_ rxa_) (= (rxg_ rxz_) (rxh_ rxz_)))))))))
(sp (make-wff (list 'FORALL 'rxa_ (list 'FORALL 'rxh_ (list 'FORALL 'rxp_ (list 'FORALL 'rxl_ (list 'IMPLIES '(IS-DIFF-ON CC-NORMED-FIELD rxa_ rxh_ rxp_ rxl_)
  (list 'FORALL 'rxb_ (list 'IMPLIES (list 'IS-OPEN rf-nf 'rxb_) (list 'FORALL 'rxg_ (list 'IMPLIES '(IN rxg_ (FUN rxb_ CC)) (list 'IMPLIES '(IN rxp_ rxb_) (list 'IMPLIES '(IN rxl_ CC)
  (list 'IMPLIES rx-near '(IS-DIFF-ON CC-NORMED-FIELD rxb_ rxg_ rxp_ rxl_)))))))))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (memq (car (dk-goal)) '(IMPLIES FORALL))) (begin (di) (loop))))
(let* ((A 'rxa_) (h 'rxh_) (p 'rxp_) (L 'rxl_) (B 'rxb_) (G 'rxg_)
       (r (dk-skolem! (an-pick "near" (lambda (x) (and (ao-op? x 'FORSOME 3) (eq? (cadr x) 'rxr_)))) #t))
       (NR (an-pick "near clause" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x r))))))
  (fact 'rr-pos-rr-in-rr r) (fact 'rr-lt-of-pos-rr r)
  (fact 'cc-open-subset-cc B) (fact 'subset-mem-fwd B 'CC p)
  (fact 'fun-apply-type-c G B 'CC p)
  (an-cc! (list '- p p)) (fact 'cc-magnitude-closed (list '- p p))
  (dk-have! (list '< (list 'magnitude (list '- p p)) r)
    (lambda () (dk-have! (list '= (list '- p p) 0) (lambda () (crs))) (subst (list '= (list '- p p) 0)) (fact 'cc-magnitude-zero) (subst '(= (magnitude 0) 0)) (dk-ineq! (list '< 0 r))))
  (dk-split-all! (list (dk-apply! NR p)))
  (let* ((rem (dk-cite! 'caratheodory-remainder-small A h p L))
         (ch (dk-cite! 'cc-diff-on-of-eps-bound B G p L)))
    (detach-with! ch
      (lambda ()
        (let* ((e (cadr (find-first (lambda (x) (dk-head-is? x 'POS-RR)) (dk-landed (lambda () (di) (if (eq? (car (dk-goal)) 'IMPLIES) (di))))))))
          (fact 'rr-pos-rr-in-rr e) (fact 'rr-lt-of-pos-rr e)
          (let* ((rh (dk-skolem! (dk-apply! rem e) #t))
                 (RHc (an-pick "remainder clause" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x rh))))))
            (fact 'rr-pos-rr-in-rr rh) (fact 'rr-lt-of-pos-rr rh)
            (let ((m (rx-min! r rh)))
              (ew m)
              (dk-conj-close!
                (lambda ()
                  (cond
                    ((dk-asm? (dk-goal)) (dk-ass!))
                    ((dk-head-is? (dk-goal) 'POS-RR) (dk-cite! 'rr-pos-rr-of-lt m) (dk-ass!))
                    (#t
                     (let* ((new (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
                            (y (cadr (find-first (lambda (x) (and (ao-op? x 'IN 3) (eq? (caddr x) B))) new))))
                       (fact 'subset-mem-fwd B 'CC y) (fact 'fun-apply-type-c G B 'CC y)
                       (an-cc! (list '- y p)) (fact 'cc-magnitude-closed (list '- y p))
                       (dk-have! (list '< (list 'magnitude (list '- y p)) r) (lambda () (dk-ineq! (list '< (list 'magnitude (list '- y p)) m) (list '<= m r))))
                       (dk-have! (list '< (list 'magnitude (list '- y p)) rh) (lambda () (dk-ineq! (list '< (list 'magnitude (list '- y p)) m) (list '<= m rh))))
                       (dk-split-all! (list (dk-apply! NR y)))
                       (dk-apply! RHc y)
                       (subst (list '= (list G y) (list h y))) (subst (list '= (list G p) (list h p)))
                       (dk-rewrite-h! (list 'IN (list G y) 'CC) (list G y) (list h y)) (dk-rewrite-h! (list 'IN (list G p) 'CC) (list G p) (list h p))
                       (let* ((X (dk-name! (list h y) 'CC)) (Yv (dk-name! (list h p) 'CC))
                              (lhs (list '- (list '- (list h y) (list h p)) (list '* (list '- y p) L)))
                              (rhs (list '- (list h y) (list '+ (list h p) (list '* L (list '- y p))))))
                         (dk-have! (list '= lhs rhs)
                           (lambda () (subst (list '= (list h y) X)) (subst (list '= (list h p) Yv)) (crs)))
                         (subst (list '= lhs rhs))
                         (dk-ass!))))))))))))
    (if (not (proof-done? *ps*)) (dk-ass!))))
(qed 'diff-on-transfer-near)

;;; ---------------------------------------------------------------------------
;;; the reflection z -> conj h(conj z) of av holomorphic function is holomorphic on the conjugate set
(define (rx-R A h) (list 'VNB-LAMBDA 'rxw_ (list 'CONJ-SET A) (list 'conjugate (list h (list 'conjugate 'rxw_)))))
(sp (make-wff (list 'FORALL 'rxa_ (list 'FORALL 'rxh_ (list 'IMPLIES '(HOLOMORPHIC-ON rxa_ rxh_) (list 'HOLOMORPHIC-ON '(CONJ-SET rxa_) (rx-R 'rxa_ 'rxh_)))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (eq? (car (dk-goal)) 'IMPLIES)) (begin (di) (loop))))
(let* ((A 'rxa_) (h 'rxh_) (CS '(CONJ-SET rxa_)) (R (rx-R 'rxa_ 'rxh_)))
  (fact 'holomorphic-on-open A h) (fact 'holomorphic-on-in-fun A h) (fact 'cc-open-subset-cc A)
  (dk-cite! 'conj-set-open A)
  (mac 'HOLOMORPHIC-ON)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'IN)
           (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (rx-cs-mem! x A) (rx-conj! x)
                                      (fact 'fun-apply-type-c h A 'CC (list 'conjugate x)) (fact 'cc-conjugate-closed (list h (list 'conjugate x))) (dk-ass!)))
                         (lambda () (mac 'conj-set-unfold) (fact 'cc-is-set) (sep-set) (dk-ass!))))
          (#t
           (let* ((av (dk-di-var!)))
             (rx-cs-mem! av A) (rx-conj! av)
             (let* ((ab (list 'conjugate av))
                    (l0 (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff A h) ab)))
                    (cl (list 'conjugate l0)))
               (fact 'fun-apply-type-c h A 'CC ab)
               (dk-project! (list 'IN l0 'CC)
                 (lambda () (mac-h 'IS-DIFF-ON (dk-ctx-form (list 'IS-DIFF-ON 'CC-NORMED-FIELD A h ab l0))) (dk-split-all!) (fact 'cc-nf-carr)
                            (dk-rewrite-h! (list 'IN l0 '(CARR CC-NORMED-FIELD)) '(CARR CC-NORMED-FIELD) 'CC) (dk-ass!)))
               (fact 'cc-conjugate-closed l0)
               (ew cl)
               (dk-have! (list 'IN R (list 'FUN CS 'CC))
                 (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (rx-cs-mem! x A) (rx-conj! x)
                                                       (fact 'fun-apply-type-c h A 'CC (list 'conjugate x)) (fact 'cc-conjugate-closed (list h (list 'conjugate x))) (dk-ass!)))
                                          (lambda () (mac 'conj-set-unfold) (fact 'cc-is-set) (sep-set) (dk-ass!)))))
               (let* ((dd (list 'IS-DIFF-ON 'CC-NORMED-FIELD A h ab l0)))
                 (let* ((rem (dk-cite! 'caratheodory-remainder-small A h ab l0))
                        (ch (dk-cite! 'cc-diff-on-of-eps-bound CS R av cl)))
                   (detach-with! ch
                     (lambda ()
                       (let* ((e (cadr (find-first (lambda (x) (dk-head-is? x 'POS-RR)) (dk-landed (lambda () (di) (if (eq? (car (dk-goal)) 'IMPLIES) (di))))))))
                         (fact 'rr-pos-rr-in-rr e) (fact 'rr-lt-of-pos-rr e)
                         (let* ((rr (dk-skolem! (dk-apply! rem e) #t))
                                (RH (an-pick "remainder clause" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x rr))))))
                           (fact 'rr-pos-rr-in-rr rr)
                           (ew rr)
                           (dk-conj-close!
                             (lambda ()
                               (if (dk-asm? (dk-goal)) (dk-ass!)
                                   (let* ((new (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
                                          (y (cadr (find-first (lambda (x) (and (ao-op? x 'IN 3) (equal? (caddr x) CS))) new)))
                                          (yb (list 'conjugate y)))
                                     (rx-cs-mem! y A) (rx-conj! y)
                                     (an-cc! (list '- y av)) (an-cc! (list '- yb ab))
                                     (dk-cite! 'cc-conjugate-sub y av)
                                     (fact 'cc-conjugate-closed (list '- y av)) (dk-cite! 'cc-magnitude-conjugate (list '- y av))
                                     (fact 'cc-magnitude-closed (list '- y av)) (fact 'cc-magnitude-closed (list '- yb ab))
                                     (dk-have! (list '= (list 'magnitude (list '- yb ab)) (list 'magnitude (list '- y av)))
                                       (lambda () (subst (list '= (list '- yb ab) (list 'conjugate (list '- y av)))) (dk-ass!)))
                                     (dk-have! (list '< (list 'magnitude (list '- yb ab)) rr)
                                       (lambda () (dk-ineq! (list '= (list 'magnitude (list '- yb ab)) (list 'magnitude (list '- y av))) (list '< (list 'magnitude (list '- y av)) rr))))
                                     (dk-apply! RH yb)
                                     (fact 'fun-apply-type-c h A 'CC yb)
                                     (dk-lam-b!)
                                     (let* ((X (list h yb)) (Yv (list h ab))
                                            (Z (list '- X (list '+ Yv (list '* l0 (list '- yb ab)))))
                                            (lhs (list '- (list '- (list 'conjugate X) (list 'conjugate Yv)) (list '* (list '- y av) cl))))
                                       (an-cc! Z) (fact 'cc-magnitude-closed Z) (fact 'cc-conjugate-closed Z)
                                       (an-cc! (list '+ Yv (list '* l0 (list '- yb ab)))) (an-cc! (list '* l0 (list '- yb ab)))
                                       (dk-cite! 'cc-conjugate-sub X (list '+ Yv (list '* l0 (list '- yb ab))))
                                       (an-and! (list 'IN Yv 'CC) (list 'IN (list '* l0 (list '- yb ab)) 'CC)) (fact 'cc-conjugate-add Yv (list '* l0 (list '- yb ab)))
                                       (an-and! (list 'IN l0 'CC) (list 'IN (list '- yb ab) 'CC)) (fact 'cc-conjugate-mul l0 (list '- yb ab))
                                       (dk-cite! 'cc-conjugate-sub yb ab)
                                       (fact 'cc-conjugate-closed X) (fact 'cc-conjugate-closed Yv)
                                       (dk-have! (list '= lhs (list 'conjugate Z))
                                         (lambda ()
                                           (subst (list '= (list 'conjugate Z) (list '- (list 'conjugate X) (list 'conjugate (list '+ Yv (list '* l0 (list '- yb ab)))))))
                                           (subst (list '= (list 'conjugate (list '+ Yv (list '* l0 (list '- yb ab)))) (list '+ (list 'conjugate Yv) (list 'conjugate (list '* l0 (list '- yb ab))))))
                                           (subst (list '= (list 'conjugate (list '* l0 (list '- yb ab))) (list '* cl (list 'conjugate (list '- yb ab)))))
                                           (subst (list '= (list 'conjugate (list '- yb ab)) (list '- (list 'conjugate yb) (list 'conjugate ab))))
                                           (subst (list '= (list 'conjugate yb) y)) (subst (list '= (list 'conjugate ab) av))
                                           (let* ((cx (dk-name! (list 'conjugate X) 'CC)) (cy (dk-name! (list 'conjugate Yv) 'CC)) (cl0 (dk-name! cl 'CC)))
                                             (subst (list '= (list 'conjugate X) cx)) (subst (list '= (list 'conjugate Yv) cy)) (subst (list '= cl cl0))
                                             (crs))))
                                       (subst (list '= lhs (list 'conjugate Z)))
                                       (dk-cite! 'cc-magnitude-conjugate Z)
                                       (subst (list '= (list 'magnitude (list 'conjugate Z)) (list 'magnitude Z)))
                                       (subst (list '= (list 'magnitude (list '- y av)) (list 'magnitude (list '- yb ab))))
                                       (dk-ass!)))))))))))
                   (if (not (proof-done? *ps*)) (dk-ass!)))))))))))
(qed 'reflection-holomorphic)

