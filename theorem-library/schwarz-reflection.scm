              (lambda () (rx-abar! x) (dk-if-branch! #f ift #f (lambda () (dk-ass!)))))))
        (lambda () (dk-apply! (dk-cite! 'interior-is-set 'CC-MS) rx-SS) (dk-ass!)))))
  ;; g is continuous on W
  (dk-have! (rf-cont WW g)
