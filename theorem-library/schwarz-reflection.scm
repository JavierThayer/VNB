;;; ---- helper defines COPIED 2026-10-30 (wave-2 integration) from ch3e/ch3e-angle.scm, ch3e/ch3e-orient.scm, ch3e/ch3f-line.scm, ch3e/ch3f-rem.scm:
;;; the probe loaded this chain in ONE environment; load.scm gives each file its own.
(define (an-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "an-pick: nothing matching" what) (car l))))
(define (an-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (an-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (an-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))
(define an-r2i '(recip (* 2 +i)))
(define (an-r2i! )                             ; recip(2 i) typed, named; returns the name and (= (* (* 2 +i) n) 1)
  (fact 'cc-i-in)
  (an-cc! '(* 2 +i))
  (dk-have! '(NOT (= (* 2 +i) 0)) (lambda () (arith)))
  (an-and! '(IN (* 2 +i) CC) '(NOT (= (* 2 +i) 0)))
  (fact 'cc-recip-closed '(* 2 +i))
  (fact 'cc-recip-inverse '(* 2 +i))
  (let ((v (dk-name! an-r2i 'CC)))
    (dk-rewrite-h! (list '= '(* (* 2 +i) (recip (* 2 +i))) 1) an-r2i v)
    v))
(define (an-r2! )
  (dk-have! '(IN 2 RR)) (dk-have! '(NOT (= 2 0)) (lambda () (arith)))
  (an-and! '(IN 2 RR) '(NOT (= 2 0)))
  (fact 'rr-recip-closed 2) (fact 'rr-recip-inverse 2) (fact 'rr-subset-cc '(recip 2))
  (let ((v (dk-name! '(recip 2) 'CC)))
    (dk-rewrite-h! '(= (* 2 (recip 2)) 1) '(recip 2) v)
    v))
(define (an-name-recips!)
  (if (dk-contains? (dk-goal) an-r2i) (let ((v (an-r2i!))) (subst (list '= an-r2i v))))
  (if (dk-contains? (dk-goal) '(recip 2)) (let ((v (an-r2!))) (subst (list '= '(recip 2) v)))))
(define (an-lt-of-le-ne! a b)    ; a <= b and NOT (b = a) in context => a < b
  (if (not (dk-asm? (list 'NOT (list '= a b))))
      (dk-have! (list 'NOT (list '= a b))
        (lambda () (di) (dk-have! (list '= b a) (lambda () (subst (list '= a b)) (rfl))) (ai (list 'NOT (list '= b a))))))
  (an-rr! a) (an-rr! b)
  (let ((ch (dk-cite! 'rr-le-ne-lt a b)))
    (if (and (pair? ch) (eq? (car ch) 'IMPLIES))
        (detach-with! ch (lambda () (dk-conj-close! (lambda () (ass))))))))
(define (ao-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define rf-nf '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (rf-sub u) (list 'SUBSPACE-MS rf-nf u))
(define (rf-cont u g)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u)
    (list 'IS-CONTINUOUS-AT (rf-sub u) rf-nf g 'rgy_))))
(define (rf-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "rf-pick: nothing matching" what) (car l))))
(define (rf-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (rf-mag! t) (rf-cc! t) (fact 'cc-magnitude-closed t) (fact 'cc-magnitude-nonneg t) (list 'magnitude t))
(define (rf-nfdist! a b)
  (let ((g (list '== (list (list 'DIST rf-nf) a b) (list 'magnitude (list '- a b)))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (rf-cc! a) (rf-cc! b)
            (dk-have! (list 'IN a '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
            (dk-have! (list 'IN b '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
            (fact 'nf-cc-agree-dist a b)
            (fact 'cc-ms-dist a b)
            (subst (list '== (list (list 'DIST rf-nf) a b) (list '(DIST CC-MS) a b)))
            (subst (list '== (list '(DIST CC-MS) a b) (list 'magnitude (list '- a b))))
            (rf-cc! (list '- a b))
            (qrfl))))
    g))
(define (rf-subdist! u a b)
  (let ((g (list '== (list (list 'DIST (rf-sub u)) a b) (list 'magnitude (list '- a b)))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (fact 'subspace-dist rf-nf u a b)
            (fact 'subset-mem-fwd u 'CC a) (fact 'subset-mem-fwd u 'CC b)
            (rf-nfdist! a b)
            (subst (list '== (list (list 'DIST (rf-sub u)) a b) (list (list 'DIST rf-nf) a b)))
            (subst (list '== (list (list 'DIST rf-nf) a b) (list 'magnitude (list '- a b))))
            (rf-cc! (list '- a b))
            (qrfl))))
    g))
(define (rf-mag-stmt g a)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'del (list 'AND '(POS-RR del)
      (list 'FORALL 'z (list 'IMPLIES '(IN z u)
        (list 'IMPLIES (list '< (list 'magnitude (list '- 'z a)) 'del)
              (list '< (list 'magnitude (list '- (list g 'z) (list g a))) 'eps)))))))))
(define (ln-ball-in! z c r)                   ; z in BALL(c, r) in context: z in CC, |z - c| < r
  (let ((bi (dk-cite! 'cc-ms-ball-membership c r z)))
    (dk-have! (list 'AND (list 'IN z 'CC) (list '< (list 'magnitude (list '- z c)) r))
      (lambda () (ai bi) (detach! (list 'IMPLIES (cadr bi) (caddr bi))) (dk-ass!)))
    (dk-split-all! (list (list 'AND (list 'IN z 'CC) (list '< (list 'magnitude (list '- z c)) r))))
    (an-cc! (list '- z c)) (fact 'cc-magnitude-closed (list '- z c))))
;;; ---- end of copied helpers ----

(define (rx-sub! u)
  (fact 'cc-is-metric-space)
  (fact 'nf-cc-is-metric-space)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl))))
  (fact 'nf-cc-agree-pts)
  (fact 'cc-is-set)
  (if (not (dk-asm? (list 'IN u 'SET))) (fact 'subclass-of-set-is-set u 'CC))
  (fact 'subspace-pts rf-nf u)
  (if (not (dk-asm? (list 'SUBSET u (list 'PTS rf-nf))))
      (dk-have! (list 'SUBSET u (list 'PTS rf-nf))
        (lambda () (subst (list '== (list 'PTS rf-nf) '(PTS CC-MS))) (subst '(== (PTS CC-MS) CC)) (ass))))
  (fact 'subspace-is-metric-space rf-nf u))

;;; ---------------------------------------------------------------------------
;;; continuity at a, in magnitudes
(sp (make-wff (forall-guarded '(u g a)
  (list '(SUBSET u CC) '(IN g (FUN u CC)) '(IN a u) (list 'IS-CONTINUOUS-AT (rf-sub 'u) rf-nf 'g 'a))
  (rf-mag-stmt 'g 'a))))
(dk-peel!)
(rx-sub! 'u)
(let* ((cont (rf-pick 'cont (lambda (f) (dk-head-is? f 'IS-CONTINUOUS-AT))))
       (rhs (caddr (dk-cite! 'is-continuous-at (rf-sub 'u) rf-nf 'g 'a)))
       (_u (dk-project! rhs 'is-continuous-at cont))
       (_s (dk-split-all! (list rhs)))
       (ccl (rf-pick 'ccl (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR) (dk-contains? f 'g))))))
  (let* ((_pk (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!)))
         (e (cadr (rf-pick 'pe (lambda (f) (dk-head-is? f 'POS-RR)))))
         (h (dk-halve! e))
         (del (dk-skolem! (dk-apply! ccl h) #t))
         (dcl (rf-pick 'dcl (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f del))))))
    (dk-pos-parts! e) (dk-pos-parts! h) (dk-pos-parts! del)
    (ew del)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
            (let* ((pl2 (dk-peel!)) (z (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) pl2))))
                   (az (list '- 'a z)) (za (list '- z 'a))
                   (fd (list '- (list 'g z) '(g a))) (fd2 (list '- '(g a) (list 'g z))))
              (fact 'subset-mem-fwd 'u 'CC z) (fact 'subset-mem-fwd 'u 'CC 'a)
              (fact 'fun-apply-type-c 'g 'u 'CC z) (fact 'fun-apply-type-c 'g 'u 'CC 'a)
              (rf-mag! az) (rf-mag! za) (rf-mag! fd) (rf-mag! fd2)
              (fact 'cc-magnitude-sub-sym 'a z)
              (fact 'cc-magnitude-sub-sym '(g a) (list 'g z))
              (dk-have! (list 'IN z (list 'PTS (rf-sub 'u))) (lambda () (subst (list '== (list 'PTS (rf-sub 'u)) 'u)) (ass)))
              (rf-subdist! 'u 'a z)
              (dk-have! (list '<= (list (list 'DIST (rf-sub 'u)) 'a z) del)
                (lambda () (subst (list '== (list (list 'DIST (rf-sub 'u)) 'a z) (list 'magnitude az)))
                           (dk-ineq! (list '= (list 'magnitude az) (list 'magnitude za)) (list '< (list 'magnitude za) del))))
              (dk-apply! dcl z)
              (rf-nfdist! '(g a) (list 'g z))
              (dk-have! (list '<= (list 'magnitude fd2) h)
                (lambda () (subst (list '== (list 'magnitude fd2) (list (list 'DIST rf-nf) '(g a) (list 'g z)))) (ass)))
              (dk-ineq! (list '= (list 'magnitude fd2) (list 'magnitude fd)) (list '<= (list 'magnitude fd2) h)
                        (rf-pick 'eqh (lambda (f) (and (dk-head-is? f '=) (dk-contains? f h) (dk-contains? f e))))
                        (list '< 0 h))))))))
(qed 'cc-cont-at-mag-sub)

;;; ---------------------------------------------------------------------------
;;; the converse: magnitudes give continuity at a
(sp (make-wff (forall-guarded '(u g a)
  (list '(SUBSET u CC) '(IN g (FUN u CC)) '(IN a u) (rf-mag-stmt 'g 'a))
  (list 'IS-CONTINUOUS-AT (rf-sub 'u) rf-nf 'g 'a))))
(dk-peel!)
(rx-sub! 'u)
(let ((mg (rf-pick 'mg (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR))))))
  (mac 'is-continuous-at)
  (dk-conj-close!
    (lambda ()
      (let ((gl (dk-goal)))
        (cond
         ((dk-asm? gl) (ass))
         ((dk-head-is? gl 'IN)
          (subst (list '== (list 'PTS (rf-sub 'u)) 'u))
          (if (dk-contains? (dk-goal) (list 'PTS rf-nf)) (subst (list '== (list 'PTS rf-nf) '(PTS CC-MS))))
          (if (dk-contains? (dk-goal) '(PTS CC-MS)) (subst '(== (PTS CC-MS) CC)))
          (if (dk-asm? (dk-goal)) (ass)))
         ((dk-head-is? gl 'FORALL)
          (let* ((pl (dk-peel!)) (e (cadr (car (filter (lambda (f) (dk-head-is? f 'POS-RR)) pl))))
                 (del (dk-skolem! (dk-apply! mg e) #t))
                 (dcl (rf-pick 'dcl (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f del)))))
                 (_p (dk-pos-parts! del))
                 (h (dk-halve! del)))
            (dk-pos-parts! e) (dk-pos-parts! h)
            (ew h)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (ass)
                    (let* ((pl2 (dk-peel!))
                           (b (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) (list 'PTS (rf-sub 'u))))) pl2))))
                           (ba (list '- b 'a)) (ab (list '- 'a b))
                           (fd (list '- (list 'g b) '(g a))) (fd2 (list '- '(g a) (list 'g b))))
                      (dk-have! (list 'IN b 'u) (lambda () (subst (list '== 'u (list 'PTS (rf-sub 'u)))) (ass)))
                      (fact 'subset-mem-fwd 'u 'CC b) (fact 'subset-mem-fwd 'u 'CC 'a)
                      (fact 'fun-apply-type-c 'g 'u 'CC b) (fact 'fun-apply-type-c 'g 'u 'CC 'a)
                      (rf-mag! ba) (rf-mag! ab) (rf-mag! fd) (rf-mag! fd2)
                      (fact 'cc-magnitude-sub-sym 'a b)
                      (fact 'cc-magnitude-sub-sym '(g a) (list 'g b))
                      (rf-subdist! 'u 'a b)
                      (dk-rewrite-h! (list '<= (list (list 'DIST (rf-sub 'u)) 'a b) h) (list (list 'DIST (rf-sub 'u)) 'a b) (list 'magnitude ab))
                      (dk-have! (list '< (list 'magnitude ba) del)
                        (lambda () (dk-ineq! (list '= (list 'magnitude ab) (list 'magnitude ba)) (list '<= (list 'magnitude ab) h)
                                             (rf-pick 'eqh (lambda (f) (and (dk-head-is? f '=) (dk-contains? f h) (dk-contains? f del))))
                                             (list '< 0 h))))
                      (dk-apply! dcl b)
                      (rf-nfdist! '(g a) (list 'g b))
                      (subst (list '== (list (list 'DIST rf-nf) '(g a) (list 'g b)) (list 'magnitude fd2)))
                      (dk-ineq! (list '= (list 'magnitude fd2) (list 'magnitude fd)) (list '< (list 'magnitude fd) e))))))))
         (#t (ass)))))))
(qed 'cc-cont-at-of-mag-sub)

;;; ---------------------------------------------------------------------------
;;; THE CONJUGATE OF A SET (complex-analysis.pdf 3.46: "the set of complex conjugates of elements of U")


(sp (make-wff '(FORALL cjsa_ (== (CONJ-SET cjsa_) (SEP cjsz_ CC (IN (conjugate cjsz_) cjsa_))))))
(dk-peel!) (mac 'CONJ-SET) (if (not (proof-done? *ps*)) (qrfl))
(qed 'conj-set-unfold)
(define (rx-cs-mem! z A)                     ; z in CONJ-SET(A) in context: lands z in CC and conj z in A
  (let* ((m (list 'IN z (list 'CONJ-SET A)))
         (cj (list 'AND (list 'IN z 'CC) (list 'IN (list 'conjugate z) A))))
    (if (not (and (dk-asm? (list 'IN z 'CC)) (dk-asm? (list 'IN (list 'conjugate z) A))))
        (begin
          (dk-have! cj
            (lambda ()
              (mac-h 'conj-set-unfold (dk-ctx-form m))
              (dk-split-all! (dk-landed (lambda () (sep-me (dk-pick (lambda (x) (and (dk-head-is? x 'IN) (equal? (cadr x) z) (dk-head-is? (caddr x) 'SEP))) "sep")))))
              (dk-conj-close! (lambda () (dk-ass!)))))
          (dk-split-all! (list cj))))))
(define (rx-cs-in! z A)                      ; z in CC and conj z in A in context: close the goal z in CONJ-SET(A)
  (mac 'conj-set-unfold) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!))))
(define (rx-conj! z)                         ; conj z typed, conj conj z = z
  (an-cc! z) (fact 'cc-conjugate-closed z) (fact 'cc-conjugate-involution z))
(define (rx-ball-in! z c r)                  ; z in BALL(CC-MS, c, r): z in CC, |z - c| < r
  (ln-ball-in! z c r))

;;; the conjugate of an open set is open
(sp (make-wff (list 'FORALL 'rxa_ (list 'IMPLIES (list 'IS-OPEN rf-nf 'rxa_) (list 'IS-OPEN rf-nf '(CONJ-SET rxa_))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (eq? (car (dk-goal)) 'IMPLIES)) (begin (di) (loop))))
(let* ((A 'rxa_) (CS '(CONJ-SET rxa_)))
  (fact 'cc-is-metric-space) (fact 'nf-cc-is-metric-space) (fact 'cc-open-subset-cc A)
  (let ((oi (dk-cite! 'cc-ms-open-iff A)))
    (dk-have! (list 'IS-OPEN 'CC-MS A) (lambda () (if (dk-only! oi (list 'IS-OPEN rf-nf A)) (prop)))))
  (dk-project! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y A) (list 'FORSOME 'r (list 'AND (list 'POS-RR 'r) (list 'SUBSET (list 'BALL 'CC-MS 'y 'r) A)))))
               (lambda () (mac-h 'IS-OPEN (list 'IS-OPEN 'CC-MS A)) (dk-split-all!)))
  (let ((oi2 (dk-cite! 'cc-ms-open-iff CS)))
    (dk-have! (list 'IS-OPEN 'CC-MS CS)
      (lambda ()
        (mac 'IS-OPEN)
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond
                ((dk-asm? g) (dk-ass!))
                ((dk-head-is? g 'SUBSET)
                 (let ((x (subset-by-element!)))
                   (rx-cs-mem! x A)
                   (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
                   (subst '(= (PTS CC-MS) CC)) (dk-ass!)))
                (#t
                 (let* ((y (dk-di-var!)))
                   (rx-cs-mem! y A) (rx-conj! y)
                   (let* ((r (dk-skolem! (dk-apply! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y A) (list 'FORSOME 'r (list 'AND (list 'POS-RR 'r) (list 'SUBSET (list 'BALL 'CC-MS 'y 'r) A))))) (list 'conjugate y)) #t)))
                     (fact 'rr-pos-rr-in-rr r)
                     (ew r)
                     (dk-conj-close!
                       (lambda ()
                         (if (dk-asm? (dk-goal)) (dk-ass!)
                             (let* ((w (subset-by-element!)))
                               (rx-ball-in! w y r) (rx-conj! w)
                               (an-cc! (list '- (list 'conjugate w) (list 'conjugate y)))
                               (dk-cite! 'cc-conjugate-sub w y)
                               (fact 'cc-conjugate-closed (list '- w y)) (dk-cite! 'cc-magnitude-conjugate (list '- w y))
                               (fact 'cc-magnitude-closed (list '- (list 'conjugate w) (list 'conjugate y)))
                               (dk-have! (list 'IN (list 'conjugate w) (list 'BALL 'CC-MS (list 'conjugate y) r))
                                 (lambda () (mac 'cc-ms-ball-membership)
                                            (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!)
                                                                           (begin (subst (list '= (list '- (list 'conjugate w) (list 'conjugate y)) (list 'conjugate (list '- w y))))
                                                                                  (subst (list '= (list 'magnitude (list 'conjugate (list '- w y))) (list 'magnitude (list '- w y))))
                                                                                  (dk-ass!)))))))
                               (dk-fact! 'subset-mem-fwd (list 'BALL 'CC-MS (list 'conjugate y) r) A (list 'conjugate w))
                               (rx-cs-in! w A))))))))))))))
    (if (dk-only! oi2 (list 'IS-OPEN 'CC-MS CS)) (prop))))
(qed 'conj-set-open)

