                        (dk-apply! (an-pick "upper" (lambda (q) (and (ao-op? q 'FORALL 3) (dk-contains? q '(< 0 (imag-part rxz_)))))) xb)
                        (rx-imc! x)
                        (an-rr! (list '- (list 'imag-part x)))
                        (dk-have! (list '< 0 (list '- (list 'imag-part x)))
                          (lambda () (dk-ineq! (list '< 0 (list 'imag-part xb)) (list '= (list 'imag-part xb) (list '- (list 'imag-part x))))))
                        (rx-gval! x #f)
                        (let* ((pr (rx-f-mag! xb e)) (dl (car pr)) (cl (cdr pr)) (m (rx-min! dl (list '- (list 'imag-part x)))))
                          (close-with! m
                            (lambda (z)
                              (subst (rx-gval2-form x))
                              (dk-have! (list 'NOT (list 'IN z OM))
                                (lambda () (di) (rx-om-typ! z) (dk-apply! rx-Fa z) (rx-im-close! z x)
                                           (dk-absurd! (list '<= 0 (list 'imag-part z))
                                                       (list '<= (list '- (list 'imag-part z) (list 'imag-part x)) (list 'magnitude (list '- z x)))
                                                       (list '< (list 'magnitude (list '- z x)) m) (list '<= m (list '- (list 'imag-part x))))))
                              (rx-abar! z) (rx-gval! z #f) (subst (rx-gval2-form z))
                              (let ((zb (list 'conjugate z)))
                                (rx-conj-diff! z x)
                                (rx-mag! (list '- zb xb))
                                (dk-have! (list '< (list 'magnitude (list '- zb xb)) dl)
                                  (lambda () (dk-ineq! (list '= (list 'magnitude (list '- zb xb)) (list 'magnitude (list '- z x)))
                                                       (list '< (list 'magnitude (list '- z x)) m) (list '<= m dl))))
                                (dk-apply! cl zb)
                                (rx-conj-diff! (list 'f zb) (list 'f xb))
                                (dk-ineq! (list '= (list 'magnitude (list '- (list 'conjugate (list 'f zb)) (list 'conjugate (list 'f xb)))) (list 'magnitude (list '- (list 'f zb) (list 'f xb))))
                                          (list '< (list 'magnitude (list '- (list 'f zb) (list 'f xb))) e))))))))))))))
        (if (not (proof-done? *ps*)) (dk-ass!)))))
  ;; the line R = CC-LINE(0, 1): z on it iff Im z = 0
  (fact 'rr-one-in) (fact 'rr-subset-cc 1) (fact 'cc-conjugate-fixes-rr 1)
  (let* ((Vp (list 'DIFFERENCE WW rx-LN)) (Gp (list 'RESTRICT g Vp)) (u 'u) (hu '(RESTRICT f u)))
    (cc-open! WW)
    ;; V' is open
    (dk-have! (list 'SUBSET Vp WW) (lambda () (let ((z (subset-by-element!))) (in-vp! z) (dk-ass!))))
