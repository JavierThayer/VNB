                          (lambda () (di) (fact 'cc-conjugate-fixes-rr ab)
                                     (dk-rewrite-h! (list '= (list 'conjugate ab) ab) (list 'conjugate ab) a)
                                     (dk-rewrite-h! (list 'IN ab 'RR) ab a)
                                     (ai (list 'NOT (list 'IN a 'RR)))))
                        (dk-apply! rx-Fb ab)
                        (dk-have! (list 'IN a CSu) (lambda () (rx-cs-in! a u)))
                        (let* ((l (deriv-of! CSu Rr a)) (r (ms-ball! CSu a)))
                          (near! CSu Rr a r
                            (lambda (z)
                              (rx-cs-mem! z u) (rx-conj! z) (fact 'imag-part-in-rr z) (fact 'imag-part-in-rr (list 'conjugate z))
                              (dk-apply! (an-pick "upper" (lambda (q) (and (ao-op? q 'FORALL 3) (dk-contains? q '(< 0 (imag-part rxz_)))))) (list 'conjugate z))
                              (rx-imc! z)
                              (dk-have! (list 'NOT (list 'IN z OM))
                                (lambda () (di) (dk-apply! rx-Fa z)
                                           (dk-absurd! (list '<= 0 (list 'imag-part z)) (list '< 0 (list 'imag-part (list 'conjugate z)))
                                                       (list '= (list 'imag-part (list 'conjugate z)) (list '- (list 'imag-part z))))))
                              (rx-abar! z) (rx-gval! z #f) (subst (rx-gval2-form z))
                              (dk-lam-b!)
                              (subst (dk-cite! 'restrict-apply 'f u (list 'conjugate z)))
                              (if (not (proof-done? *ps*)) (rfl))))
                          (dk-cite! 'diff-on-transfer-near CSu Rr a l Vp Gp)
                          (ew l) (dk-ass!))))))))))))
    ;; 3.45 across the real axis
    (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
    (dk-cite! 'holomorphic-across-line WW g 0 1)
    ;; the conclusion
    (ew g)
    (dk-conj-close!
      (lambda ()
        (cond
          ((dk-asm? (dk-goal)) (dk-ass!))
          (#t
           (let* ((z (dk-di-var!)) (zb (list 'conjugate z)))
             (rx-in-ww! z) (rx-conj! z)
             (dk-apply! (list 'FORALL 'rxz_ (list 'IMPLIES (list 'IN 'rxz_ WW) (list 'IN '(conjugate rxz_) WW))) z)
             (rx-in-ww! zb)
             (dk-conj-close!
               (lambda ()
                 (if (dk-asm? (dk-goal)) (dk-ass!)
                   (use-em (list 'IN z OM)
                     (lambda ()
                       (rx-om-typ! z) (fact 'cc-conjugate-closed (list 'f z)) (rx-gval! z #t)
                       (use-em (list 'IN z 'RR)
                         (lambda ()
                           (fact 'cc-conjugate-fixes-rr z) (dk-apply! rx-Fc z) (fact 'cc-conjugate-fixes-rr (list 'f z))
                           (subst (list '= zb z)) (subst (rx-gval1-form z)) (subst (list '= (list 'conjugate (list 'f z)) (list 'f z)))
                           (if (not (proof-done? *ps*)) (rfl)))
                         (lambda ()
                           (dk-apply! rx-Fb z)
                           (dk-apply! (an-pick "upper" (lambda (q) (and (ao-op? q 'FORALL 3) (dk-contains? q '(< 0 (imag-part rxz_)))))) z)
                           (rx-imc! z) (fact 'imag-part-in-rr zb) (fact 'imag-part-in-rr z)
                           (dk-have! (list 'NOT (list 'IN zb OM))
                             (lambda () (di) (dk-apply! rx-Fa zb)
                                        (dk-absurd! (list '<= 0 (list 'imag-part zb)) (list '< 0 (list 'imag-part z)) (list '= (list 'imag-part zb) (list '- (list 'imag-part z))))))
                           (rx-abar! zb) (rx-gval! zb #f)
                           (subst (rx-gval2-form zb)) (subst (list '= (list 'conjugate zb) z)) (subst (rx-gval1-form z))
                           (if (not (proof-done? *ps*)) (rfl)))))
                     (lambda ()
                       (rx-abar! z) (rx-gval! z #f) (rx-gval! zb #t)
                       (subst (rx-gval1-form zb)) (subst (rx-gval2-form z))
                       (fact 'cc-conjugate-involution (list 'f zb))
                       (subst (list '= (list 'conjugate (list 'conjugate (list 'f zb))) (list 'f zb)))
                       (if (not (proof-done? *ps*)) (rfl))))))))))))
    #t)
  #t)
(qed 'schwarz-reflection)


  
