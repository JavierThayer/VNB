;;; the interior of a conjugation-symmetric set is conjugation-symmetric
(sp (make-wff '(FORALL rxs_ (IMPLIES (SUBSET rxs_ CC) (IMPLIES (FORALL rxz_ (IMPLIES (IN rxz_ rxs_) (IN (conjugate rxz_) rxs_)))
  (FORALL rxz_ (IMPLIES (IN rxz_ (INTERIOR CC-MS rxs_)) (IN (conjugate rxz_) (INTERIOR CC-MS rxs_)))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (memq (car (dk-goal)) '(IMPLIES FORALL))) (begin (di) (loop))))
(let* ((Sv 'rxs_) (z (cadr (dk-goal))) (I2 (list 'INTERIOR 'CC-MS Sv))
       (SY (an-pick "symmetry" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x 'conjugate))))))
  (set! z (cadr (cadr (dk-goal))))
  (fact 'cc-is-metric-space) (fact 'nf-cc-is-metric-space)
  (dk-split-all! (dk-landed* (lambda () (mac-h 'interior-membership (list 'IN z I2)))))
  (let* ((O (dk-skolem! (an-pick "the neighbourhood" (lambda (x) (and (ao-op? x 'FORSOME 3) (dk-contains? x 'IS-OPEN)))) #t))
         (OS (list 'CONJ-SET O)))
    (dk-split-all!)
    (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
    (dk-have! (list 'IN z 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass)))
    (rx-conj! z)
    (let ((oi (dk-cite! 'cc-ms-open-iff O)))
      (dk-have! (list 'IS-OPEN rf-nf O) (lambda () (if (dk-only! oi (list 'IS-OPEN 'CC-MS O)) (prop)))))
    (dk-cite! 'conj-set-open O)
    (let ((oi2 (dk-cite! 'cc-ms-open-iff OS)))
      (dk-have! (list 'IS-OPEN 'CC-MS OS) (lambda () (if (dk-only! oi2 (list 'IS-OPEN rf-nf OS)) (prop)))))
    (dk-have! (list 'SUBSET OS Sv)
      (lambda () (let ((w (subset-by-element!)))
                   (rx-cs-mem! w O) (rx-conj! w)
                   (dk-fact! 'subset-mem-fwd O Sv (list 'conjugate w))
                   (dk-apply! SY (list 'conjugate w))
                   (dk-rewrite-h! (list 'IN (list 'conjugate (list 'conjugate w)) Sv) (list 'conjugate (list 'conjugate w)) w)
                   (dk-ass!))))
    (dk-have! (list 'IN (list 'conjugate z) OS)
      (lambda () (fact 'cc-conjugate-closed z)
                 (dk-have! (list 'IN (list 'conjugate (list 'conjugate z)) O) (lambda () (subst (list '= (list 'conjugate (list 'conjugate z)) z)) (dk-ass!)))
                 (rx-cs-in! (list 'conjugate z) O)))
    (dk-fact! 'interior-mem-intro 'CC-MS Sv OS (list 'conjugate z))
    (dk-ass!)))
(qed 'interior-conj-symmetric)

;;; ---------------------------------------------------------------------------
;;; PROPOSITION 3.46 (Schwarz reflection).  U open in the upper half plane, Omega = U union (closure(U)
;;; intersect R), f continuous on Omega, holomorphic on U and real on closure(U) intersect R.  Then f
;;; extends to g holomorphic on the interior W of Omega union conj(Omega) with g(conj z) = conj g(z).
(define rx-CLR '(INTERSECTION (CLOSURE CC-MS u) RR))
(define rx-OM (list 'UNION 'u rx-CLR))
(define rx-SS (list 'UNION rx-OM (list 'CONJ-SET rx-OM)))
(define rx-WW (list 'INTERIOR 'CC-MS rx-SS))
(define rx-LN '(CC-LINE 0 1))
(define rx-g (list 'VNB-LAMBDA 'rxw_ rx-WW (list 'IF (list 'IN 'rxw_ rx-OM) '(f rxw_) '(conjugate (f (conjugate rxw_))))))
(define (rx-onom x) (list 'FORALL 'rxv_ (list 'IMPLIES (list 'IN 'rxv_ rx-OM) x)))
(define rx-Fa (rx-onom '(<= 0 (imag-part rxv_))))
(define rx-Fb (rx-onom '(IMPLIES (NOT (IN rxv_ RR)) (IN rxv_ u))))
(define rx-Fc (rx-onom '(IMPLIES (IN rxv_ RR) (IN (f rxv_) RR))))
(define rx-Fd (list 'FORALL 'rxv_ (list 'IMPLIES (list 'IN 'rxv_ rx-SS) (list 'IMPLIES (list 'NOT (list 'IN 'rxv_ rx-OM)) (list 'IN '(conjugate rxv_) rx-OM)))))
(define (rx-un-cases! z A B k1 k2)            ; z in UNION(A, B) in context: case split
  (let ((bi (dk-cite! 'union-membership A B z)))
    (dk-have! (list 'OR (list 'IN z A) (list 'IN z B))
      (lambda () (ai bi) (detach! (list 'IMPLIES (cadr bi) (caddr bi))) (dk-ass!)))
    (use-cases (list (list 'IN z A) (list 'IN z B)) k1 k2)))
(define (rx-in-int! z A B)                    ; z in A and z in B in context: close (IN z (INTERSECTION A B))
  (mac 'intersection-membership) (dk-conj-close! (lambda () (dk-ass!))))
(define (rx-int-parts! z A B)
  (let ((bi (dk-cite! 'intersection-membership A B z)))
    (dk-have! (list 'AND (list 'IN z A) (list 'IN z B)) (lambda () (ai bi) (detach! (list 'IMPLIES (cadr bi) (caddr bi))) (dk-ass!)))
    (dk-split-all! (list (list 'AND (list 'IN z A) (list 'IN z B))))))
(define (rx-setup!)
  (fact 'cc-is-metric-space) (fact 'nf-cc-is-metric-space) (fact 'cc-open-subset-cc 'u)
  (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
  (fact 'rr-zero-in) (fact 'rr-subset-cc 0)
  (dk-cite! 'rx-im-conj)
  ;; Omega and S inside CC
  (dk-have! (list 'SUBSET rx-OM 'CC)
    (lambda () (let ((z (subset-by-element!)))
                 (rx-un-cases! z 'u rx-CLR (lambda () (dk-fact! 'subset-mem-fwd 'u 'CC z) (dk-ass!))
                                           (lambda () (rx-int-parts! z '(CLOSURE CC-MS u) 'RR) (fact 'rr-subset-cc z) (dk-ass!))))))
  (dk-have! (list 'SUBSET rx-SS 'CC)
    (lambda () (let ((z (subset-by-element!)))
                 (rx-un-cases! z rx-OM (list 'CONJ-SET rx-OM) (lambda () (dk-fact! 'subset-mem-fwd rx-OM 'CC z) (dk-ass!))
                                                                (lambda () (rx-cs-mem! z rx-OM) (dk-ass!))))))
  ;; the facts F_a ... F_d
  (dk-have! rx-Fa
    (lambda () (let ((z (dk-di-var!)))
                 (dk-fact! 'subset-mem-fwd rx-OM 'CC z) (fact 'imag-part-in-rr z)
                 (rx-un-cases! z 'u rx-CLR
                   (lambda () (dk-apply! (an-pick "upper" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x '(< 0 (imag-part rxz_)))))) z)
                              (dk-ineq! (list '< 0 (list 'imag-part z))))
                   (lambda () (rx-int-parts! z '(CLOSURE CC-MS u) 'RR) (fact 'rr-imag-part-zero z) (dk-ineq! (list '= (list 'imag-part z) 0)))))))
  (dk-have! rx-Fb
    (lambda () (let ((z (dk-di-var!)))
                 (di)
                 (rx-un-cases! z 'u rx-CLR (lambda () (dk-ass!))
                   (lambda () (rx-int-parts! z '(CLOSURE CC-MS u) 'RR) (ai (list 'NOT (list 'IN z 'RR))))))))
  (dk-have! rx-Fc
    (lambda () (let ((z (dk-di-var!)))
                 (di)
                 (dk-fact! 'subset-mem-fwd rx-OM 'CC z) (fact 'imag-part-in-rr z)
                 (rx-un-cases! z 'u rx-CLR
                   (lambda () (dk-apply! (an-pick "upper" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x '(< 0 (imag-part rxz_)))))) z)
                              (fact 'rr-imag-part-zero z) (dk-absurd! (list '< 0 (list 'imag-part z)) (list '= (list 'imag-part z) 0)))
                   (lambda () (dk-apply! (an-pick "real values" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x 'CLOSURE) (dk-contains? x 'f)))) z)
                              (dk-ass!))))))
  (dk-have! rx-Fd
    (lambda () (let ((z (dk-di-var!)))
                 (di)
                 (rx-un-cases! z rx-OM (list 'CONJ-SET rx-OM) (lambda () (ai (list 'NOT (list 'IN z rx-OM))))
                                                               (lambda () (rx-cs-mem! z rx-OM) (dk-ass!))))))
  ;; S is symmetric, so W is
  (dk-have! (list 'FORALL 'rxz_ (list 'IMPLIES (list 'IN 'rxz_ rx-SS) (list 'IN '(conjugate rxz_) rx-SS)))
    (lambda () (let ((z (dk-di-var!)))
                 (dk-fact! 'subset-mem-fwd rx-SS 'CC z) (rx-conj! z)
                 (rx-un-cases! z rx-OM (list 'CONJ-SET rx-OM)
                   (lambda () (dk-have! (list 'IN (list 'conjugate (list 'conjugate z)) rx-OM) (lambda () (subst (list '= (list 'conjugate (list 'conjugate z)) z)) (dk-ass!)))
                              (dk-have! (list 'IN (list 'conjugate z) (list 'CONJ-SET rx-OM)) (lambda () (rx-cs-in! (list 'conjugate z) rx-OM)))
                              (mac 'union-membership) (if (dk-only! (list 'IN (list 'conjugate z) (list 'CONJ-SET rx-OM)) (dk-goal)) (prop)))
                   (lambda () (rx-cs-mem! z rx-OM)
                              (mac 'union-membership) (if (dk-only! (list 'IN (list 'conjugate z) rx-OM) (dk-goal)) (prop)))))))
  (dk-cite! 'interior-conj-symmetric rx-SS)
  (dk-apply! (dk-cite! 'interior-is-open 'CC-MS) rx-SS)
  (let ((oi (dk-cite! 'cc-ms-open-iff rx-WW)))
    (dk-have! (list 'IS-OPEN rf-nf rx-WW) (lambda () (if (dk-only! oi (list 'IS-OPEN 'CC-MS rx-WW)) (prop)))))
  (dk-apply! (dk-cite! 'interior-in-set 'CC-MS) rx-SS)
  (fact 'subset-trans rx-WW rx-SS 'CC))
(define rx-hyps                               ; the statement's hypotheses, around BODY
  (lambda (body)
    (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN rf-nf 'u) (list 'IMPLIES '(FORALL rxz_ (IMPLIES (IN rxz_ u) (< 0 (imag-part rxz_))))
      (list 'FORALL 'f (list 'IMPLIES (list 'IN 'f (list 'FUN rx-OM 'CC)) (list 'IMPLIES (rf-cont rx-OM 'f) (list 'IMPLIES '(HOLOMORPHIC-ON u (RESTRICT f u))
        (list 'IMPLIES (list 'FORALL 'rxx_ (list 'IMPLIES (list 'IN 'rxx_ rx-CLR) '(IN (f rxx_) RR))) body))))))))))
(define rx-concl
  (list 'FORSOME 'rxg_ (list 'AND (list 'HOLOMORPHIC-ON rx-WW 'rxg_)
    (list 'AND (list 'FORALL 'rxz_ (list 'IMPLIES (list 'IN 'rxz_ rx-WW) (list 'IMPLIES (list 'IN 'rxz_ rx-OM) '(= (rxg_ rxz_) (f rxz_)))))
               (list 'FORALL 'rxz_ (list 'IMPLIES (list 'IN 'rxz_ rx-WW) (list 'AND (list 'IN '(conjugate rxz_) rx-WW) '(= (rxg_ (conjugate rxz_)) (conjugate (rxg_ rxz_))))))))))
(define (rx-gval1-form z) (list '= (list rx-g z) (list 'f z)))
(define (rx-gval2-form z) (list '= (list rx-g z) (list 'conjugate (list 'f (list 'conjugate z)))))
(define rx-GV1 (list 'FORALL 'rxq_ (list 'IMPLIES (list 'IN 'rxq_ rx-WW) (list 'IMPLIES (list 'IN 'rxq_ rx-OM) (rx-gval1-form 'rxq_)))))
(define rx-GV2 (list 'FORALL 'rxq_ (list 'IMPLIES (list 'IN 'rxq_ rx-WW) (list 'IMPLIES (list 'NOT (list 'IN 'rxq_ rx-OM)) (rx-gval2-form 'rxq_)))))
(define (rx-in-ww! z)                         ; z in W in context: z in S, z in CC
  (dk-fact! 'subset-mem-fwd rx-WW rx-SS z) (dk-fact! 'subset-mem-fwd rx-WW 'CC z))
(define (rx-om-typ! z)                        ; z in Omega: z in CC, f z in CC, Im z typed
  (dk-fact! 'subset-mem-fwd rx-OM 'CC z) (fact 'fun-apply-type-c 'f rx-OM 'CC z) (fact 'imag-part-in-rr z))
(define (rx-abar! z)                          ; z in W, not in Omega: conj z in Omega, its typings
  (dk-apply! rx-Fd z) (rx-conj! z) (rx-om-typ! (list 'conjugate z)) (fact 'cc-conjugate-closed (list 'f (list 'conjugate z))))
(define (rx-gval! z in-om?)                   ; lands the value of g at z (z in W in context)
  (if in-om? (dk-apply! rx-GV1 z) (dk-apply! rx-GV2 z)))
(define (rx-imc! z) (dk-apply! '(FORALL rxz_ (IMPLIES (IN rxz_ CC) (= (imag-part (conjugate rxz_)) (- (imag-part rxz_))))) z))
(define (rx-mag! t) (an-cc! t) (fact 'cc-magnitude-closed t) (fact 'cc-magnitude-nonneg t))
(define (rx-f-mag! y e)                       ; y in Omega: the continuity of f at y with eps e; returns (delta . clause)
  (dk-apply! (rf-cont rx-OM 'f) y)
  (let* ((mg (dk-cite! 'cc-cont-at-mag-sub rx-OM 'f y))
         (dl (dk-skolem! (dk-apply! mg e) #t))
         (cl (an-pick "f clause" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x dl))))))
    (fact 'rr-pos-rr-in-rr dl) (fact 'rr-lt-of-pos-rr dl)
    (cons dl cl)))
(define (rx-conj-diff! a b)                   ; |conj a - conj b| = |a - b|  (a, b in CC)
  (rx-conj! a) (rx-conj! b) (rx-mag! (list '- a b)) (rx-mag! (list '- (list 'conjugate a) (list 'conjugate b)))
  (dk-cite! 'cc-conjugate-sub a b) (fact 'cc-conjugate-closed (list '- a b)) (dk-cite! 'cc-magnitude-conjugate (list '- a b))
  (let ((e (list '= (list 'magnitude (list '- (list 'conjugate a) (list 'conjugate b))) (list 'magnitude (list '- a b)))))
    (if (not (dk-asm? e))
        (dk-have! e (lambda () (subst (list '= (list '- (list 'conjugate a) (list 'conjugate b)) (list 'conjugate (list '- a b)))) (dk-ass!))))
    e))
(define (rx-im-close! z x)                    ; Im z - Im x bounded by |z - x|: lands the two linear bounds
  (fact 'imag-part-in-rr z) (fact 'imag-part-in-rr x) (rx-mag! (list '- z x))
  (dk-cite! 'cc-im-dist-le z x)
  (an-rr! (list '- (list 'imag-part z) (list 'imag-part x)))
  (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list '- (list 'imag-part z) (list 'imag-part x)) (list 'magnitude (list '- z x))))))

(define rx-Vp (list 'DIFFERENCE rx-WW rx-LN))
  (define (rx-im0-of-ln! z)                   ; z in R in context: lands Im z = 0
    (let ((cj (list '= (list 'imag-part z) 0)))
      (if (not (dk-asm? cj))
          (dk-have! cj
            (lambda ()
              (mac-h 'cc-line-unfold (dk-ctx-form (list 'IN z rx-LN)))
              (dk-split-all! (dk-landed (lambda () (sep-me (dk-pick (lambda (q) (and (dk-head-is? q 'IN) (equal? (cadr q) z) (dk-head-is? (caddr q) 'SEP))) "sep")))))
              (an-cc! z)
              (dk-have! (list '= (list '* (list '- z 0) '(conjugate 1)) z) (lambda () (subst '(= (conjugate 1) 1)) (crs)))
              (let ((e (dk-pick (lambda (q) (and (dk-head-is? q '=) (dk-contains? q '(conjugate 1)) (dk-contains? q 'imag-part))) "line eq")))
                (dk-rewrite-h! e (list '* (list '- z 0) '(conjugate 1)) z)
                (dk-ass!)))))))
  (define (rx-not-ln! z)                      ; z in CC, Im z /= 0 in context: NOT z in R
    (dk-have! (list 'NOT (list 'IN z rx-LN))
      (lambda () (di) (rx-im0-of-ln! z) (ai (list 'NOT (list '= (list 'imag-part z) 0))))))
    (define (in-vp! z)                        ; z in V' in context: z in W, NOT z in R, Im z /= 0, NOT z in RR
      (let ((bi (dk-cite! 'difference-membership rx-WW rx-LN z)))
        (dk-have! (list 'AND (list 'IN z rx-WW) (list 'NOT (list 'IN z rx-LN)))
          (lambda () (ai bi) (detach! (list 'IMPLIES (cadr bi) (caddr bi))) (dk-ass!)))
        (dk-split-all! (list (list 'AND (list 'IN z rx-WW) (list 'NOT (list 'IN z rx-LN))))))
      (rx-in-ww! z) (fact 'imag-part-in-rr z)
      (dk-have! (list 'NOT (list '= (list 'imag-part z) 0))
        (lambda () (di)
                   (dk-have! (list 'IN z rx-LN)
                     (lambda () (mac 'cc-line-unfold)
                                (in-sep! (lambda () (dk-ass!))
                                         (lambda () (dk-have! (list '= (list '* (list '- z 0) '(conjugate 1)) z) (lambda () (subst '(= (conjugate 1) 1)) (crs)))
                                                    (subst (list '= (list '* (list '- z 0) '(conjugate 1)) z)) (dk-ass!)))))
                   (ai (list 'NOT (list 'IN z rx-LN)))))
      (dk-have! (list 'NOT (list 'IN z 'RR))
        (lambda () (di) (fact 'rr-imag-part-zero z) (ai (list 'NOT (list '= (list 'imag-part z) 0))))))
    (define (ms-ball! A y)                    ; A open (CC-MS form in context), y in A: returns r > 0 with BALL(y, r) subset A
      (dk-project! (list 'FORALL 'yb (list 'IMPLIES (list 'IN 'yb A) (list 'FORSOME 'rb (list 'AND (list 'POS-RR 'rb) (list 'SUBSET (list 'BALL 'CC-MS 'yb 'rb) A)))))
                   (lambda () (mac-h 'IS-OPEN (list 'IS-OPEN 'CC-MS A)) (dk-split-all!)))
      (let ((r (dk-skolem! (dk-apply! (list 'FORALL 'yb (list 'IMPLIES (list 'IN 'yb A) (list 'FORSOME 'rb (list 'AND (list 'POS-RR 'rb) (list 'SUBSET (list 'BALL 'CC-MS 'yb 'rb) A))))) y) #t)))
        (fact 'rr-pos-rr-in-rr r) (fact 'rr-lt-of-pos-rr r)
        r))
    (define (cc-open! A)                      ; IS-OPEN nfm A in context: land the CC-MS form
      (let ((oi (dk-cite! 'cc-ms-open-iff A)))
        (if (not (dk-asm? (list 'IS-OPEN 'CC-MS A)))
            (dk-have! (list 'IS-OPEN 'CC-MS A) (lambda () (if (dk-only! oi (list 'IS-OPEN rf-nf A)) (prop)))))))
    (define (ball-mem! z c r)                 ; z in CC, |z - c| < r in context: close (IN z (BALL CC-MS c r))
      (mac 'cc-ms-ball-membership) (dk-conj-close! (lambda () (dk-ass!))))

(sp (make-wff (rx-hyps rx-concl)))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (memq (car (dk-goal)) '(IMPLIES FORALL))) (begin (di) (loop))))
(rx-setup!)
(let* ((OM rx-OM) (WW rx-WW) (g rx-g))
  ;; the values of g
  (dk-have! rx-GV1
    (lambda () (let* ((z (dk-di-var!)))
                 (di) (rx-om-typ! z)
