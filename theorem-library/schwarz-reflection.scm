        (fact 'fun-apply-type-c g WW 'CC x)
        (detach-with! ch
          (lambda ()
            (let* ((e (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) (dk-landed (lambda () (di) (if (eq? (car (dk-goal)) 'IMPLIES) (di)))))))
                   (gx (list g x)))
              (fact 'rr-pos-rr-in-rr e) (fact 'rr-lt-of-pos-rr e)
              (define (close-with! dlt pointwise)   ; ew dlt; for z in W with |z - x| < dlt run POINTWISE z
                (ew dlt)
                (dk-conj-close!
                  (lambda ()
                    (cond ((dk-asm? (dk-goal)) (dk-ass!))
                          ((dk-head-is? (dk-goal) 'POS-RR) (dk-cite! 'rr-pos-rr-of-lt dlt) (dk-ass!))
                          (#t (let* ((new (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
                                     (z (cadr (find-first (lambda (q) (and (ao-op? q 'IN 3) (equal? (caddr q) WW))) new))))
                                (rx-in-ww! z) (rx-conj! z) (fact 'fun-apply-type-c g WW 'CC z)
                                (rx-mag! (list '- z x)) (rx-mag! (list '- (list g z) gx))
                                (pointwise z)))))))
              (define (via-f! z y dlt cl conj?)     ; g z, g x both from f at z / y (or both conjugated); close |g z - g x| < e
                (dk-apply! cl z)
                (let* ((fz (list 'f z)) (fy (list 'f y)))
                  (if conj?
                      (begin
                        (rx-conj-diff! fz fy)
                        (dk-have! (list '< (list 'magnitude (list '- (list 'conjugate fz) (list 'conjugate fy))) e)
                          (lambda () (dk-ineq! (list '= (list 'magnitude (list '- (list 'conjugate fz) (list 'conjugate fy))) (list 'magnitude (list '- fz fy)))
                                               (list '< (list 'magnitude (list '- fz fy)) e)))))
                      #t)))
              (use-em (list 'IN x 'RR)
                ;; (i) x real: x in Omega, f x real
                (lambda ()
                  (fact 'cc-conjugate-fixes-rr x)
                  (dk-have! (list 'IN x OM)
                    (lambda () (use-em (list 'IN x OM) (lambda () (ass))
                                 (lambda () (dk-apply! rx-Fd x) (dk-rewrite-h! (list 'IN (list 'conjugate x) OM) (list 'conjugate x) x)
                                            (ai (list 'NOT (list 'IN x OM)))))))
                  (rx-om-typ! x)
                  (dk-apply! rx-Fc x)
                  (fact 'cc-conjugate-fixes-rr (list 'f x))
                  (rx-gval! x #t)
                  (let* ((pr (rx-f-mag! x e)) (dl (car pr)) (cl (cdr pr)))
                    (close-with! dl
                      (lambda (z)
                        (subst (rx-gval1-form x))
                        (use-em (list 'IN z OM)
                          (lambda () (rx-om-typ! z) (rx-gval! z #t) (subst (rx-gval1-form z)) (dk-apply! cl z) (dk-ass!))
                          (lambda ()
                            (rx-abar! z) (rx-gval! z #f) (subst (rx-gval2-form z))
                            (let ((zb (list 'conjugate z)))
                              (rx-conj-diff! z x)
                              (dk-rewrite-h! (list '= (list 'magnitude (list '- zb (list 'conjugate x))) (list 'magnitude (list '- z x))) (list 'conjugate x) x)
                              (rx-mag! (list '- zb x))
                              (dk-have! (list '< (list 'magnitude (list '- zb x)) dl)
                                (lambda () (dk-ineq! (list '= (list 'magnitude (list '- zb x)) (list 'magnitude (list '- z x))) (list '< (list 'magnitude (list '- z x)) dl))))
                              (dk-apply! cl zb)
                              (subst (list '= (list 'f x) (list 'conjugate (list 'f x))))
                              (rx-conj-diff! (list 'f zb) (list 'f x))
                              (dk-ineq! (list '= (list 'magnitude (list '- (list 'conjugate (list 'f zb)) (list 'conjugate (list 'f x)))) (list 'magnitude (list '- (list 'f zb) (list 'f x))))
                                        (list '< (list 'magnitude (list '- (list 'f zb) (list 'f x))) e)))))))))
                (lambda ()
                  (use-em (list 'IN x OM)
                    ;; (ii) x in Omega, not real: x in U, Im x > 0
                    (lambda ()
                      (rx-om-typ! x)
                      (dk-apply! rx-Fb x)
                      (dk-apply! (an-pick "upper" (lambda (q) (and (ao-op? q 'FORALL 3) (dk-contains? q '(< 0 (imag-part rxz_)))))) x)
                      (rx-gval! x #t)
                      (let* ((pr (rx-f-mag! x e)) (dl (car pr)) (cl (cdr pr)) (m (rx-min! dl (list 'imag-part x))))
                        (close-with! m
                          (lambda (z)
                            (subst (rx-gval1-form x))
                            (dk-have! (list 'IN z OM)
                              (lambda () (use-em (list 'IN z OM) (lambda () (ass))
                                           (lambda () (rx-abar! z) (dk-apply! rx-Fa (list 'conjugate z)) (rx-im-close! z x) (rx-imc! z)
                                                      (dk-absurd! (list '<= 0 (list 'imag-part (list 'conjugate z))) (list '= (list 'imag-part (list 'conjugate z)) (list '- (list 'imag-part z)))
                                                                  (list '<= (list '- (list 'magnitude (list '- z x))) (list '- (list 'imag-part z) (list 'imag-part x)))
                                                                  (list '< (list 'magnitude (list '- z x)) m) (list '<= m (list 'imag-part x)))))))
                            (rx-om-typ! z) (rx-gval! z #t) (subst (rx-gval1-form z))
                            (dk-have! (list '< (list 'magnitude (list '- z x)) dl) (lambda () (dk-ineq! (list '< (list 'magnitude (list '- z x)) m) (list '<= m dl))))
                            (dk-apply! cl z) (dk-ass!)))))
                    ;; (iii) x not in Omega: conj x in U, Im x < 0
                    (lambda ()
                      (rx-abar! x)
                      (let ((xb (list 'conjugate x)))
                        (dk-have! (list 'NOT (list 'IN xb 'RR))
                          (lambda () (di) (fact 'cc-conjugate-fixes-rr xb)
