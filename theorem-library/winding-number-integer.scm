;;; ---- each coordinate of PQ takes the same value at b and at a
(define (wzi-const! fl proj)
  (let* ((u  (dk-fact! 'zero-deriv-off-countable-constant 'a 'b fl wzi-un))
         (e  (dk-apply! u 'b 'a))
         (pb (list '* '(pgam b) '(qgam b)))
         (pa (list '* '(pgam a) '(qgam a))))
    (if (not (eq? (wzi-head e) '=))
        (error "wzi-const!: the constancy did not detach" (expression->string e)))
    (dk-have! (list '= (list proj pb) (list proj pa))
      (lambda ()
        (dk-have! (list '= (list fl 'b) (list proj pb)) (lambda () (dk-lam-b!) (rfl)))
        (dk-have! (list '= (list fl 'a) (list proj pa)) (lambda () (dk-lam-b!) (rfl)))
        (subst (list '= (list proj pb) (list fl 'b)))
        (subst (list '= (list proj pa) (list fl 'a)))
        (dk-ass!)))))
(wzi-const! wzi-r1 'real-part)
(wzi-const! wzi-i1 'imag-part)
(let* ((pb '(* (pgam b) (qgam b)))
       (pa '(* (pgam a) (qgam a)))
       (db (dk-cite! 'cc-re-im-decompose pb))
       (da (dk-cite! 'cc-re-im-decompose pa)))
  (dk-have! (list '= (caddr db) (caddr da))
    (lambda ()
      (subst (list '= (list 'real-part pb) (list 'real-part pa)))
      (subst (list '= (list 'imag-part pb) (list 'imag-part pa)))
      (rfl)))
  (subst db)
  (subst da)
  (dk-ass!))
