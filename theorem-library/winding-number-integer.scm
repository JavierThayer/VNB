  (let ((v (list '* (list 'f (list 'pgam y)) (list 'dgam y))))
    (fact 'cc-mul-closed (list 'f (list 'pgam y)) (list 'dgam y))
    (fact 'real-part-in-rr v)
    (fact 'imag-part-in-rr v)))

