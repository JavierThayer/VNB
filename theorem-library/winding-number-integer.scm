            (list 'IS-DIFF-ON 'CC-NORMED-FIELD wzi-u wzi-k 'hbz_ (list wzi-dk 'hbz_))))
  (lambda ()
    (let* ((y (dk-di-var!))
           (d (list '- y wzi-z))
           (v (list '- (list 'recip (list '* d d)))))
      (wzi-dk-at! y)
      (dk-diff! wzi-u wzi-k y)
      (dk-have! (list '= (list wzi-dk y) v) (lambda () (dk-lam-b!) (rfl)))
      (subst (list '= (list wzi-dk y) v))
      (dk-ass!))))
(dk-have! (list 'HOLOMORPHIC-ON wzi-u wzi-dk) (lambda () (dk-holomorphic! wzi-u wzi-dk)))
(dk-cite! 'holomorphic-on-continuous wzi-u wzi-dk)
(define wzi-rb (dk-fact! 'road-holomorphic-image wzi-u wzi-k wzi-dk 'pgam 'dgam 'a 'b))
(if (not (eq? (wzi-head wzi-rb) 'IS-ROAD)) (error "wzi: road-holomorphic-image (kernel) did not detach" (expression->string wzi-rb)))
;;; ---- the product A B has derivative 0: road-product-constant
(define wzi-a (cadr wzi-ra))
(define wzi-da (caddr wzi-ra))
(define wzi-b (cadr wzi-rb))
(define wzi-db (caddr wzi-rb))
;;; y in [a, b]: the values typed, gamma(y) - z /= 0, H(y) in CC; returns
;;; (e k d w) with e = exp(H y), k = recip(gamma y - z), d = gamma'(y), w = gamma y - z
(define (wzi-abpt! y)
  (let* ((w (list '- (list 'pgam y) wzi-z))
         (k (list 'recip w))
         (hy (list wzi-hh y))
         (e (list 'CC-EXP hy))
         (d (list 'dgam y)))
    (fact 'fun-apply-type-c 'pgam wzi-cc 'CC y)
    (fact 'fun-apply-type-c 'dgam wzi-cc 'CC y)
    (fact 'fun-apply-type-c wzi-hh wzi-cc 'CC y)
    (dk-apply! wzi-pgu3 y)
    (wzi-pz-open! wzi-z (list 'pgam y))
    (wzi-cc! w) (wzi-cc! k) (wzi-cc! e)
    (dk-cite! 'cc-mul-nonzero w w)
    (wzi-cc! (list '- (list 'recip (list '* w w))))
    (wzi-cc! (list '* k d))
    (list e k d w)))
(dk-have! (list 'FORALL 'wzt_ (list 'IMPLIES (list 'IN 'wzt_ wzi-cc)
            (list '= (list '+ (list '* (list wzi-da 'wzt_) (list wzi-b 'wzt_))
                              (list '* (list wzi-a 'wzt_) (list wzi-db 'wzt_))) 0)))
  (lambda ()
    (let* ((y (dk-di-var!))
           (ekdw (wzi-abpt! y))
           (e (car ekdw)) (k (cadr ekdw)) (d (caddr ekdw)) (w (cadddr ekdw)))
      (dk-lam-b!)

      (dk-cite! 'cc-recip-mul w w)
      (subst (list '= (list 'recip (list '* w w)) (list '* k k)))
      (let ((kv (dk-name! k 'CC)) (ev (dk-name! e 'CC)))
        (subst (list '= k kv))
        (subst (list '= e ev))
        (crs)))))
(define wzi-pc (dk-fact! 'road-product-constant wzi-a wzi-da wzi-b wzi-db 'a 'b))
;;; ---- read off: exp(H b) / (gamma b - z) = exp(H a) / (gamma a - z)
;;; from (= (* x c) (* y c)) and (= (* ci c) 1) in context, c and ci free of recip:
;;; land (= x y)
(define (wzi-cancel! x y c ci)
  (for-each (lambda (t)
              (dk-have! (list '= (list '* (list '* t c) ci) (list '* t (list '* ci c))) (lambda () (crs)))
              (dk-have! (list '= (list '* (list '* t c) ci) t)
                (lambda ()
                  (subst (list '= (list '* (list '* t c) ci) (list '* t (list '* ci c))))
                  (subst (list '= (list '* ci c) 1))
                  (crs))))
            (list x y))
  (dk-have! (list '= x y)
    (lambda ()
      (subst (list '= x (list '* (list '* x c) ci)))
      (subst (list '= (list '* x c) (list '* y c)))
      (dk-ass!))))
(define wzi-kk #f)
(define (wzi-pick-univ-eq lint)
  (dk-pick (lambda (fm) (and (pair? fm) (eq? (car fm) '=) (equal? (cadr fm) lint))) "the line integral as H(b) - H(a)"))
(let* ((pa (wzi-abpt! 'a)) (pb (wzi-abpt! 'b))
       (ea (car pa)) (ka (cadr pa)) (wa (cadddr pa))
       (eb (car pb)) (kb (cadr pb))
       (ha (list wzi-hh 'a)) (hb (list wzi-hh 'b))
       (lint wzi-lint)
       (el (list 'CC-EXP lint)))
  (for-each (lambda (z e k)
              (dk-have! (list '= (list wzi-a z) e) (lambda () (dk-lam-b!) (rfl)))
              (dk-have! (list '= (list wzi-b z) k) (lambda () (dk-lam-b!) (rfl))))
            '(a b) (list ea eb) (list ka kb))
  (dk-have! (list '= kb ka) (lambda () (subst '(= (pgam b) (pgam a))) (rfl)))
  (dk-cite! 'cc-recip-inverse wa)
  (let ((kv (dk-name! ka 'CC)))
    (dk-have! (list '= (list '* wa kv) 1) (lambda () (subst (list '= kv ka)) (dk-ass!)))
    (dk-have! (list '= kv (list wzi-b 'b))
      (lambda () (subst (list '= (list wzi-b 'b) kb)) (subst (list '= kb ka)) (dk-ass!)))
    (dk-have! (list '= kv (list wzi-b 'a))
      (lambda () (subst (list '= (list wzi-b 'a) ka)) (dk-ass!)))
    (for-each (lambda (z e)
                (dk-have! (list '= (list '* e kv) (list '* (list wzi-a z) (list wzi-b z)))
                  (lambda () (subst (list '= (list wzi-a z) e)) (subst (list '= (list wzi-b z) kv)) (rfl))))
              '(b a) (list eb ea))
    (dk-have! (list '= (list '* eb kv) (list '* ea kv))
      (lambda ()
        (subst (list '= (list '* eb kv) (list '* (list wzi-a 'b) (list wzi-b 'b))))
        (subst (list '= (list '* ea kv) (list '* (list wzi-a 'a) (list wzi-b 'a))))
        (dk-ass!)))
    (wzi-cancel! eb ea kv wa)))
;;; ---- exp(L) = 1, L in 2 pi i ZZ, WINDING = k
(let* ((ha (list wzi-hh 'a)) (hb (list wzi-hh 'b))
       (ea (list 'CC-EXP ha)) (eb (list 'CC-EXP hb))
       (lint wzi-lint)
       (el (list 'CC-EXP lint))
       (leq (wzi-pick-univ-eq lint)))
  (dk-have! (list 'IN lint 'CC)
    (lambda () (subst leq) (wzi-cc! (list '- hb ha)) (dk-ass!)))
  (wzi-cc! el)
  (dk-have! (list '= (list '+ ha lint) hb) (lambda () (subst leq) (crs)))
  (dk-cite! 'cc-exp-add ha lint)
  (dk-have! (list '= eb (list '* ea el))
    (lambda () (subst (list '= hb (list '+ ha lint))) (dk-ass!)))
  (dk-cite! 'cc-exp-nonzero ha)
  (let ((ev (wzi-inv! ea)))
    (dk-have! (list '= (list '* ev ea) (list '* ea ev)) (lambda () (crs)))
    (dk-have! (list '= (list '* ev ea) 1)
      (lambda () (subst (list '= (list '* ev ea) (list '* ea ev))) (dk-ass!)))
    (dk-have! (list '= (list '* el ea) (list '* 1 ea))
      (lambda ()
        (dk-have! (list '= (list '* el ea) eb) (lambda () (subst (list '= eb (list '* ea el))) (crs)))
        (subst (list '= (list '* el ea) eb))
        (subst (list '= eb ea))
        (crs)))
    (wzi-cancel! el 1 ea ev))
  ;; the kernel of exp
  (let* ((iff (dk-cite! 'cc-exp-one-iff lint))
         (ex  (caddr iff)))
    (dk-have! ex (lambda () (wzi-kp! iff (list '= el 1))))
    (let* ((k (dk-skolem! (dk-ctx-form ex)))
           (keq (list '= lint (list '* k wzi-tpi))))
      (fact 'zz-in-rr k)
      (fact 'rr-subset-cc k)
      (wzi-tpi!)
      (let ((tv (wzi-inv! wzi-tpi)))
        (ew k)
        (dk-conj-close!
         (lambda ()
           (if (dk-ass!)
               #t
               (begin
                 (mac 'WINDING)
                 (subst keq)
                 (subst (list '= (list 'recip wzi-tpi) tv))
                 (dk-have! (list '= (list '* tv (list '* k wzi-tpi)) (list '* k (list '* wzi-tpi tv))) (lambda () (crs)))
                 (subst (list '= (list '* tv (list '* k wzi-tpi)) (list '* k (list '* wzi-tpi tv))))
                 (subst (list '= (list '* wzi-tpi tv) 1))
                 (crs)))))))))
(qed 'winding-number-integer)

