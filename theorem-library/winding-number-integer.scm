;;; winding-number-integer.scm -- THE WINDING NUMBER IS AN INTEGER (complex-analysis.pdf
;;; ch. 3, Proposition 3.27, first half), with the two pieces of road calculus it rests on.
;;; Agent CA-5 of week 3 of the October roadmap, 2026-10-04.
;;; Definitions: structure-library/winding-number.scm (WINDING, by the integral (73)).
;;;
;;; THE NOTES' PROOF.  For a closed path gamma on [a, b] and z off its trace put
;;; H(t) = int_a^t gamma'(s) / (gamma(s) - z) ds; then (gamma(t) - z) exp(-H(t)) has
;;; derivative 0, so it is constant; at t = b, since gamma(b) = gamma(a), exp(H(b)) = 1,
;;; and H(b) = 2 pi i ind(gamma, z) lies in 2 pi i ZZ.
;;;
;;; THE PROOF HERE has the same three steps, each a theorem:
;;;  (1) road-product-constant   two roads (P, dP), (Q, dQ) on [a, b] with
;;;                              dP Q + P dQ = 0 on [a, b] have P(b) Q(b) = P(a) Q(a).
;;;                              The product rule is applied COORDINATEWISE
;;;                              (Re(PQ) = Re P Re Q - Im P Im Q, `cc-re-mul'), with
;;;                              `has-deriv-at-product' on a window inside [a, b], off
;;;                              the union of the four exceptional sets; the constancy is
;;;                              `zero-deriv-off-countable-constant' (Dieudonne 8.5.1).
;;;  (2) line-int-primitive-road for f continuous on u, the road's trace in u: there is a
;;;                              road (H, h) on [a, b], h the line integral's integrand
;;;                              t |-> f(gamma(t)) gamma'(t), with
;;;                              LINE-INT(f, gamma, gamma', a, b) = H(b) - H(a).
;;;                              H is the notes' integral "as a function of its upper
;;;                              limit": its coordinates are primitives of the
;;;                              integrand's (`regulated-on-has-primitive').
;;;  (3) winding-number-integer  the closed road, z off the trace: WINDING = k, k in ZZ.
;;;                              The notes' (gamma - z) exp(-H) is replaced by
;;;                              exp(H) * 1/(gamma - z): both factors are images of
;;;                              roads under holomorphic maps (`road-holomorphic-image',
;;;                              exp on CC and w |-> 1/(w - z) on CC \ {z}), which is
;;;                              what (1) wants; no road difference or negation is needed.
;;;                              Then exp(H(b)) = exp(H(a)), exp(L) = 1 for the line
;;;                              integral L, and `cc-exp-one-iff'.
;;;
;;; STATEMENT CHECKS.  The roads are typed by IS-ROAD (which carries a < b, the reals a,
;;; b and the FUN typings).  (1) asks the derivative identity on the CLOSED interval, which
;;; is what (3) has; nothing is said about the endpoints' derivatives.  (2) is
;;; existential: H is not unique (a constant may be added), so no IOTA is formed.  (3)
;;; carries z in CC (SINGLETON z is defined only on a set) and not(z in TRACE), which
;;; puts the trace inside the integrand's domain CC \ {z}; closedness is pgam(b) = pgam(a)
;;; (a closed road has no name in the tree).  No strict `=' is asserted of a term that
;;; might not denote: LINE-INT's definedness is earned from the primitives
;;; (`line-int-value'), WINDING's from `winding-in-cc'.
;;;
;;; BINDERS: wzt_ (the hypothesis of (1)), the path-integral binders pat_, rgy_, hbz_,
;;; msy_, lft_ as in the laws cited.  No binder folds onto a class name or an accessor.
;;; Helper prefix wzi-.  NOTHING asserted; no definition here.
;;; LOAD WINDOW: lo = theorem-library/winding-number-laws (road-holomorphic-image,
;;; winding-integrand-holomorphic, cc-punctured-*), above cc-exp-kernel (cc-exp-one-iff),
;;; cc-exp, line-int-laws (line-int-value), regulated-algebra, regulated-has-primitive,
;;; zero-deriv-off-countable, has-deriv-at-more, interval-calculus-laws, cc-coords-laws,
;;; line-int-fundamental (cc-product-continuous-at).  hi: none.  Tactics: the early kit
;;; and dk-diff! / dk-holomorphic! (driver-kit).

;;; ======================================================================
;;; local helpers
;;; ======================================================================
(define wzi-cc '(CCINT a b))
(define wzi-scc (list 'SUBSPACE-MS 'RR-MS wzi-cc))
(define (wzi-plam body) (list 'VNB-LAMBDA 'pat_ wzi-cc body))
(define (wzi-crd proj f) (wzi-plam (list proj (list f 'pat_))))
(define (wzi-head g) (and (pair? g) (car g)))
(define (wzi-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
;;; keep FS, then prop -- unless the keep already grounded the lane's leaf
(define (wzi-kp! . fs)
  (let ((node (proof-state-focus *ps*)))
    (apply keep fs)
    (if (not (sequent-node-grounded? node)) (prop))))
(define (wzi-pick-univ what . needles)
  (dk-pick (lambda (fm) (and (pair? fm) (eq? (car fm) 'FORALL)
                             (let loop ((n needles))
                               (or (null? n) (and (dk-contains? fm (car n)) (loop (cdr n)))))))
           what))

;;; the interval and its subspace: the standing facts (a < b, a, b in RR in context)
(define (wzi-interval-setup!)
  (fact 'rr-is-metric-space)
  (fact 'rr-is-set)
  (dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl)))
  (fact 'ccint-subset-rr 'a 'b)
  (fact 'subclass-of-set-is-set wzi-cc 'RR)
  (fact 'ooint-subset-ccint 'a 'b)
  (dk-have! (list 'SUBSET wzi-cc '(PTS RR-MS)) (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
  (fact 'subspace-is-metric-space 'RR-MS wzi-cc)
  (fact 'subspace-pts 'RR-MS wzi-cc)
  (fact 'rr-leq-reflexive 'a)
  (fact 'rr-leq-reflexive 'b)
  (fact 'rr-lt-implies-le 'a 'b)
  (for-each (lambda (z)
              (dk-have! (list 'IN z wzi-cc)
                (lambda () (mac 'ccint-membership) (dk-conj-close! dk-ass!))))
            '(a b)))

;;; y in [a, b] in context: f(y) in CC for each f of FS (members of FUN([a,b], CC)),
;;; with its two coordinates in RR
(define (wzi-cc-at! fs y)
  (for-each (lambda (f)
              (fact 'fun-apply-type-c f wzi-cc 'CC y)
              (fact 'real-part-in-rr (list f y))
              (fact 'imag-part-in-rr (list f y)))
            fs))

;;; ======================================================================
;;; (1) ROAD-PRODUCT-CONSTANT
;;; ======================================================================
(define wzi-r1 (wzi-plam '(real-part (* (pgam pat_) (qgam pat_)))))
(define wzi-i1 (wzi-plam '(imag-part (* (pgam pat_) (qgam pat_)))))

;;; at y in [a, b]: the four road values typed, the product typed with its coordinates
(define (wzi-pq-at! y)
  (wzi-cc-at! '(pgam qgam dgam dqgam) y)
  (let ((pq (list '* (list 'pgam y) (list 'qgam y))))
    (wzi-and! (list 'IN (list 'pgam y) 'CC) (list 'IN (list 'qgam y) 'CC))
    (fact 'cc-mul-closed (list 'pgam y) (list 'qgam y))
    (fact 'real-part-in-rr pq)
    (fact 'imag-part-in-rr pq)))

(define (wzi-pq-type! claim)
  (dk-have! claim
    (lambda ()
      (dk-lam-type! (lambda () (let ((y (dk-di-var!))) (wzi-pq-at! y)
                                 (if (dk--redex? (dk-goal)) (dk-lam-b!)) (ass))) ass))))

(sp (make-wff '(FORALL pgam (FORALL dgam (FORALL qgam (FORALL dqgam (FORALL a (FORALL b
  (IMPLIES (IS-ROAD pgam dgam a b) (IMPLIES (IS-ROAD qgam dqgam a b)
    (IMPLIES (FORALL wzt_ (IMPLIES (IN wzt_ (CCINT a b))
               (= (+ (* (dgam wzt_) (qgam wzt_)) (* (pgam wzt_) (dqgam wzt_))) 0)))
      (= (* (pgam b) (qgam b)) (* (pgam a) (qgam a))))))))))))))
(dk-peel!)
(define wzi-hyp (wzi-pick-univ "the derivative identity" 'wzt_ 'dqgam))
(for-each (lambda (pg dg)
            (fact 'is-road-is-path pg dg 'a 'b)
            (fact 'is-path-in-fun pg 'a 'b)
            (fact 'is-road-dgam-in-fun pg dg 'a 'b)
            (fact 'is-road-re-antiderivative pg dg 'a 'b)
            (fact 'is-road-im-antiderivative pg dg 'a 'b))
          '(pgam qgam) '(dgam dqgam))
(dk-split! (dk-fact! 'is-path-endpoints 'pgam 'a 'b))
(dk-split-all!)
(define wzi-pcont (dk-fact! 'is-path-continuous 'pgam 'a 'b))
(define wzi-qcont (dk-fact! 'is-path-continuous 'qgam 'a 'b))
(wzi-interval-setup!)
(wzi-pq-at! 'a)
(wzi-pq-at! 'b)
(wzi-pq-type! (list 'IN wzi-r1 (list 'FUN wzi-cc 'RR)))
(wzi-pq-type! (list 'IN wzi-i1 (list 'FUN wzi-cc 'RR)))

;;; ---- continuity of the two coordinates of PQ on [a, b]
(dk-have! (list 'IN wzi-r1 (list 'FUN (list 'PTS wzi-scc) 'RR))
  (lambda () (subst (list '== (list 'PTS wzi-scc) wzi-cc)) (ass)))
(dk-have! (list 'IN wzi-i1 (list 'FUN (list 'PTS wzi-scc) 'RR))
  (lambda () (subst (list '== (list 'PTS wzi-scc) wzi-cc)) (ass)))
(define (wzi-in-cc-of-pts! z)
  (dk-have! (list 'IN z wzi-cc)
    (lambda () (subst (list '= wzi-cc (list 'PTS wzi-scc))) (ass))))
(define (wzi-pq-cont! y)
  (wzi-pq-at! y)
  (dk-have! (list 'IN y (list 'PTS wzi-scc))
    (lambda () (subst (list '== (list 'PTS wzi-scc) wzi-cc)) (ass)))
  (dk-apply! wzi-pcont y)
  (dk-apply! wzi-qcont y)
  (let* ((r (dk-fact! 'cc-product-continuous-at wzi-scc 'pgam 'qgam y))
         (c (list-ref r 3)))
    (if (not (eq? (wzi-head r) 'IS-CONTINUOUS-AT))
        (error "wzi-pq-cont!: expected the product's continuity" (expression->string r)))
    (dk-have! (list 'IN c (list 'FUN (list 'PTS wzi-scc) 'CC))
      (lambda ()
        (fact 'ms-pts-is-set wzi-scc)
        (dk-lam-type! (lambda () (let ((z (dk-di-var!)))
                                   (wzi-in-cc-of-pts! z)
                                   (wzi-pq-at! z)
                                   (if (dk--redex? (dk-goal)) (dk-lam-b!))
                                   (ass))) ass)))
    (for-each
     (lambda (proj fl)
       (dk-have! (list 'FORALL 'u_ (list 'IMPLIES (list 'IN 'u_ (list 'PTS wzi-scc))
                   (list '= (list proj (list c 'u_)) (list fl 'u_))))
         (lambda ()
           (let ((z (dk-di-var!)))
             (wzi-in-cc-of-pts! z)
             (wzi-pq-at! z)
             (dk-lam-b!)
             (rfl)))))
     '(real-part imag-part) (list wzi-r1 wzi-i1))
    (let ((iff (dk-fact! 'cc-continuous-at-iff-coords wzi-scc c wzi-r1 wzi-i1 y)))
      (if (not (eq? (wzi-head iff) 'IFF))
          (error "wzi-pq-cont!: expected the coordinate iff" (expression->string iff)))
      (cons iff r))))
(define wzi-both-cont
  (list 'FORALL 'icp_ (list 'IMPLIES (list 'IN 'icp_ wzi-cc)
    (list 'AND (list 'IS-CONTINUOUS-AT wzi-scc 'RR-MS wzi-r1 'icp_)
               (list 'IS-CONTINUOUS-AT wzi-scc 'RR-MS wzi-i1 'icp_)))))
(dk-have! wzi-both-cont
  (lambda ()
    (let* ((y (dk-di-var!))
           (ir (wzi-pq-cont! y)))
      (keep (car ir) (cdr ir))
      (prop))))
(define (wzi-cont-on! fl)
  (dk-have! (list 'IS-CONTINUOUS-ON fl wzi-cc)
    (lambda ()
      (mac 'IS-CONTINUOUS-ON)
      (dk-conj-close!
       (lambda ()
         (if (not (eq? (wzi-head (dk-goal)) 'FORALL))
             (dk-ass!)
             (let ((y (dk-di-var!)))
               (dk-split-all! (list (dk-apply! (dk-ctx-form wzi-both-cont) y)))
               (dk-ass!))))))))
(wzi-cont-on! wzi-r1)
(wzi-cont-on! wzi-i1)

;;; ---- the exceptional set: the union of the four of the two roads
(define (wzi-exc! pf df proj)
  (let ((s (dk-skolem! (dk-fact! 'primitive-exceptional-set (wzi-crd proj pf) (wzi-crd proj df) 'a 'b))))
    (dk-split-all!)
    (cons s (wzi-pick-univ "a coordinate derivative universal" 'HAS-DERIV-AT s))))
(define wzi-e1 (wzi-exc! 'pgam 'dgam 'real-part))
(define wzi-e2 (wzi-exc! 'pgam 'dgam 'imag-part))
(define wzi-e3 (wzi-exc! 'qgam 'dqgam 'real-part))
(define wzi-e4 (wzi-exc! 'qgam 'dqgam 'imag-part))
(define wzi-u12 (list 'UNION (car wzi-e1) (car wzi-e2)))
(define wzi-u34 (list 'UNION (car wzi-e3) (car wzi-e4)))
(define wzi-un (list 'UNION wzi-u12 wzi-u34))
(fact 'countable-union-2 (car wzi-e1) (car wzi-e2))
(fact 'countable-union-2 (car wzi-e3) (car wzi-e4))
(fact 'countable-union-2 wzi-u12 wzi-u34)
(define (wzi-union-sub! s1 s2)
  (dk-have! (list 'SUBSET (list 'UNION s1 s2) wzi-cc)
    (lambda ()
      (let* ((w  (subset-by-element!))
             (um (dk-fact! 'union-membership s1 s2 w)))
        (fact 'subset-mem-fwd s1 wzi-cc w)
        (fact 'subset-mem-fwd s2 wzi-cc w)
        (keep um (list 'IN w (list 'UNION s1 s2))
              (list 'IMPLIES (list 'IN w s1) (list 'IN w wzi-cc))
              (list 'IMPLIES (list 'IN w s2) (list 'IN w wzi-cc)))
        (prop)))))
(wzi-union-sub! (car wzi-e1) (car wzi-e2))
(wzi-union-sub! (car wzi-e3) (car wzi-e4))
(wzi-union-sub! wzi-u12 wzi-u34)

;;; ---- THE DERIVATIVE of each coordinate of PQ is 0 off the union
(fact 'cc-zero-in)
(fact 'rr-zero-in)
(for-each
 (lambda (proj)
   (dk-have! (list '= (list proj 0) 0)
     (lambda ()
       (dk-have! '(= 0 (+ 0 (* 0 +i))) (lambda () (crs)))
       (dk-split-all! (list (dk-cite! 'cc-re-im-of 0 0 0)))
       (dk-ass!))))
 '(real-part imag-part))

;;; at the eigenvariable tv with the window nb = OOINT(tv - rad, tv + rad) inside [a, b]:
;;; restrict(h, nb) typed, for h a member of FUN([a, b], RR)
(define (wzi-restrict! h nb)
  (fact 'restrict-in-fun h wzi-cc 'RR nb))
;;; the product h of the coordinate lambdas F (of pgam) and G (of qgam), typed, with its
;;; derivative at tv landed in reduced form; F, G are (lambda . value-at-tv)
(define (wzi-prod! tv rad nb f g)
  (let* ((pf (car (cadddr (car f))))
         (pg (car (cadddr (car g))))
         (h  (wzi-plam (list '* (list pf '(pgam pat_)) (list pg '(qgam pat_)))))
         (fv (list pf (list 'pgam tv)))
         (gv (list pg (list 'qgam tv))))
    (dk-have! (list 'IN h (list 'FUN wzi-cc 'RR))
      (lambda ()
        (dk-lam-type! (lambda () (let ((y (dk-di-var!)))
                                   (wzi-pq-at! y)
                                   (if (dk--redex? (dk-goal)) (dk-lam-b!))
                                   (fact 'rr-mul-in-rr (list pf (list 'pgam y)) (list pg (list 'qgam y)))
                                   (dk-ass!))) ass)))
    (wzi-restrict! h nb)
    (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ nb)
                (list '== (list h 'hbx_) (list '* (list (car f) 'hbx_) (list (car g) 'hbx_)))))
      (lambda ()
        (let ((w (dk-di-var!)))
          (fact 'subset-mem-fwd nb wzi-cc w)
          (wzi-pq-at! w)
          (dk-lam-b!)
          (qrfl))))
    (let* ((r  (dk-fact! 'has-deriv-at-product rad (car f) (car g) h tv (cdr f) (cdr g)))
           (val (cadddr r))
           (nv (list '+ (list '* (cdr f) gv) (list '* (cdr g) fv))))
      (if (not (eq? (wzi-head r) 'HAS-DERIV-AT))
          (error "wzi-prod!: the product rule did not detach" (expression->string r)))
      (dk-have! (list '= (list (car g) tv) gv) (lambda () (dk-lam-b!) (rfl)))
      (dk-have! (list '= (list (car f) tv) fv) (lambda () (dk-lam-b!) (rfl)))
      (dk-have! (list 'HAS-DERIV-AT h tv nv)
        (lambda ()
          (dk-have! (list '= nv val)
            (lambda ()
              (subst (list '= gv (list (car g) tv)))
              (subst (list '= fv (list (car f) tv)))
              (rfl)))
          (subst (list '= nv val))
          (dk-ass!)))
      (cons h nv))))

;;; the coordinate PROJ of PQ as h1 -/+ h2 on the window, its derivative landed;
;;; returns the value
(define (wzi-coord-deriv! tv rad nb proj fl h1 h2 law op lawname)
  (wzi-restrict! fl nb)
  (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ nb)
              (list '== (list fl 'hbx_) (list op (list (car h1) 'hbx_) (list (car h2) 'hbx_)))))
    (lambda ()
      (let ((w (dk-di-var!)))
        (fact 'subset-mem-fwd nb wzi-cc w)
        (wzi-pq-at! w)
        (dk-lam-b!)
        (let ((eq (dk-cite! lawname (list 'pgam w) (list 'qgam w))))
          (subst eq)
          (qrfl)))))
  (let ((r (if (eq? op '-)
               (dk-fact! 'has-deriv-at-difference rad (car h1) (car h2) fl tv (cdr h1) (cdr h2))
               (dk-fact! 'has-deriv-at-sum rad (car h1) (car h2) fl tv (cdr h1) (cdr h2)))))
    (if (not (eq? (wzi-head r) 'HAS-DERIV-AT))
        (error "wzi-coord-deriv!: the sum/difference rule did not detach" (expression->string r)))
    (cadddr r)))

(define wzi-both-deriv
  (list 'FORALL 'lft_ (list 'IMPLIES '(IN lft_ (OOINT a b))
    (list 'IMPLIES (list 'NOT (list 'IN 'lft_ wzi-un))
      (list 'AND (list 'HAS-DERIV-AT wzi-r1 'lft_ 0)
                 (list 'HAS-DERIV-AT wzi-i1 'lft_ 0))))))
(dk-have! wzi-both-deriv
  (lambda ()
    (dk-peel!)
    (let* ((tv (cadr (dk-pick (lambda (fm) (and (pair? fm) (eq? (car fm) 'IN)
                                                 (equal? (caddr fm) '(OOINT a b))))
                              "the point of the open interval")))
           (u1 (dk-fact! 'union-membership wzi-u12 wzi-u34 tv))
           (u2 (dk-fact! 'union-membership (car wzi-e1) (car wzi-e2) tv))
           (u3 (dk-fact! 'union-membership (car wzi-e3) (car wzi-e4) tv))
           (nots (map (lambda (e) (list 'NOT (list 'IN tv (car e)))) (list wzi-e1 wzi-e2 wzi-e3 wzi-e4))))
      (for-each (lambda (nf)
                  (dk-have! nf (lambda () (wzi-kp! u1 u2 u3 (list 'NOT (list 'IN tv wzi-un))))))
                nots)
      (fact 'subset-mem-fwd '(OOINT a b) wzi-cc tv)
      (wzi-pq-at! tv)
      (let* ((cds (map (lambda (e pf df proj)
                         (let* ((gl (wzi-crd proj pf)) (dl (wzi-crd proj df)) (dt (list df tv)))
                           (fact 'fun-apply-type-c dl wzi-cc 'RR tv)
                           (dk-apply! (cdr e) tv)
                           (dk-have! (list '= (list dl tv) (list proj dt)) (lambda () (dk-lam-b!) (rfl)))
                           (dk-have! (list 'HAS-DERIV-AT gl tv (list proj dt))
                             (lambda () (subst (list '= (list proj dt) (list dl tv))) (dk-ass!)))
                           (cons gl (list proj dt))))
                       (list wzi-e1 wzi-e2 wzi-e3 wzi-e4)
                       '(pgam pgam qgam qgam) '(dgam dgam dqgam dqgam)
                       '(real-part imag-part real-part imag-part)))
             (pr (list-ref cds 0)) (pim (list-ref cds 1))
             (qr (list-ref cds 2)) (qim (list-ref cds 3))
             (rad (dk-skolem! (dk-fact! 'ooint-inner-radius 'a 'b tv)))
             (nb  (list 'OOINT (list '- tv rad) (list '+ tv rad)))
             (x   (list 'dgam tv)) (y (list 'qgam tv))
             (p   (list 'pgam tv)) (dq (list 'dqgam tv))
             (xy  (list '* x y)) (pdq (list '* p dq))
             (ex  (list '+ xy pdq)))
        (dk-split-all!)
        (let* ((h1 (wzi-prod! tv rad nb pr qr))
               (h2 (wzi-prod! tv rad nb pim qim))
               (h3 (wzi-prod! tv rad nb pr qim))
               (h4 (wzi-prod! tv rad nb pim qr))
               (vr (wzi-coord-deriv! tv rad nb 'real-part wzi-r1 h1 h2 'cc-re-mul '- 'cc-re-mul))
               (vi (wzi-coord-deriv! tv rad nb 'imag-part wzi-i1 h3 h4 'cc-im-mul '+ 'cc-im-mul)))
          ;; the identity at tv, and its two coordinates
          (dk-apply! wzi-hyp tv)
          (wzi-and! (list 'IN x 'CC) (list 'IN y 'CC))
          (wzi-and! (list 'IN p 'CC) (list 'IN dq 'CC))
          (fact 'cc-mul-closed x y)
          (fact 'cc-mul-closed p dq)
          (for-each
           (lambda (proj addlaw mullaw v)
             (let* ((ea (dk-cite! addlaw xy pdq))
                    (e1 (dk-cite! mullaw x y))
                    (e2 (dk-cite! mullaw p dq))
                    (expd (list '+ (caddr e1) (caddr e2))))
               (dk-have! (list '= (list proj ex) 0)
                 (lambda () (subst (list '= ex 0)) (dk-ass!)))
               (dk-have! (list '= v 0)
                 (lambda ()
                   (dk-real! expd)
                   (dk-have! (list '= 0 expd)
                     (lambda ()
                       (subst (list '= 0 (list proj ex)))
                       (subst ea)
                       (subst e1)
                       (subst e2)
                       (rfl)))
                   (subst (list '= 0 expd))
                   (crs)))))
           '(real-part imag-part) '(cc-re-add cc-im-add) '(cc-re-mul cc-im-mul) (list vr vi))
          (dk-have! (list 'HAS-DERIV-AT wzi-r1 tv 0)
            (lambda () (subst (list '= 0 vr)) (dk-ass!)))
          (dk-have! (list 'HAS-DERIV-AT wzi-i1 tv 0)
            (lambda () (subst (list '= 0 vi)) (dk-ass!)))
          (dk-conj-close! dk-ass!))))))
(define (wzi-deriv-univ! fl)
