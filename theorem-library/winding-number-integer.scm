;;; copies of winding-number-laws.scm's wnd- typers (that file is not ours)
(define (wzi-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (wzi-rr! t)
  (let ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((eq? t 'PI) (dk-split-all! (list (dk-cite! 'pi-pos))) typ)
          ((number? t) (dk-have! typ (lambda () (arith))) typ)
          ((wzi-op? t '* 3) (wzi-rr! (cadr t)) (wzi-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          (#t (dk-real! t) typ))))
(define (wzi-cc! t)
  (let ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((or (and (number? t) (real? t)) (eq? t 'PI) (dk-asm? (list 'IN t 'RR)))
           (wzi-rr! t) (fact 'rr-subset-cc t) typ)
          ((wzi-op? t '- 3) (wzi-cc! (cadr t)) (wzi-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((wzi-op? t '- 2) (wzi-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((wzi-op? t '+ 3) (wzi-cc! (cadr t)) (wzi-cc! (caddr t))
           (wzi-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((wzi-op? t '* 3) (wzi-cc! (cadr t)) (wzi-cc! (caddr t))
           (wzi-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((wzi-op? t 'CC-EXP 2) (wzi-cc! (cadr t))
           (dk-split-all! (list (dk-cite! 'cc-exp-converges (cadr t)))) typ)
          ((wzi-op? t 'recip 2) (wzi-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "wzi-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (wzi-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (error "wzi-cc!: cannot type" (expression->string t))))))
(define (wzi-pz z) (list 'DIFFERENCE 'CC (list 'SINGLETON z)))
(define (wzi-kern z) (list 'VNB-LAMBDA 'wnw_ (wzi-pz z) (list 'recip (list '- 'wnw_ z))))
(define (wzi-sub-nz! y z)
  (let ((nz (list 'NOT (list '= (list '- y z) 0))))
    (dk-have! nz
      (lambda ()
        (di)
        (dk-cite! 'cc-sub-zero-eq y z)
        (ai (dk-ctx-form (list 'NOT (list '= y z))))))
    nz))
(define (wzi-pz-open! z y)
  (let ((iff (dk-cite! 'cc-punctured-membership z y)))
    (dk-have! (list 'IN y 'CC) (lambda () (wzi-kp! iff (list 'IN y (wzi-pz z)))))
    (dk-have! (list 'NOT (list '= y z)) (lambda () (wzi-kp! iff (list 'IN y (wzi-pz z)))))
    (wzi-sub-nz! y z)))
(define (wzi-pz-in! z y)
  (let ((iff (dk-cite! 'cc-punctured-membership z y)))
    (dk-have! (list 'IN y (wzi-pz z))
      (lambda () (wzi-kp! iff (list 'IN y 'CC) (list 'NOT (list '= y z)))))))
(define wzi-tpi '(* (* 2 PI) +i))
(define (wzi-tpi!)
  (wzi-rr! '(* 2 PI))
  (dk-have! '(< 0 (* 2 PI)) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'rr-pos-ne-zero '(* 2 PI))
  (wzi-cc! '(* 2 PI))
  (fact 'cc-i-in)
  (dk-have! '(NOT (= +i 0))
    (lambda ()
      (di)
      (fact 'cc-i-squared)
      (dk-have! '(= (* 0 0) -1) (lambda () (subst '(= 0 +i)) (ass)))
      (dk-have! '(NOT (= (* 0 0) -1)) (lambda () (arith)))
      (ai '(NOT (= (* 0 0) -1)))))
  (dk-cite! 'cc-mul-nonzero '(* 2 PI) +i)
  (wzi-cc! wzi-tpi))
;;; x in CC, x /= 0: name v = recip(x), land x * v = 1; return v
(define (wzi-inv! x)
  (wzi-and! (list 'IN x 'CC) (list 'NOT (list '= x 0)))
  (fact 'cc-recip-closed x)
  (dk-cite! 'cc-recip-inverse x)
  (let ((v (dk-name! (list 'recip x) 'CC)))
    (dk-have! (list '= (list '* x v) 1)
      (lambda () (subst (list '= v (list 'recip x))) (dk-ass!)))
    v))

