;;; btg-graphs.scm -- BA-1111-A, 2026-11-11.  BanachAlgebras.pdf ch. 3 s.5-6 for graphs
;;; (decision D4: an unbounded operator is its graph G, a subset of H x H; ba-unbdd-vocab).
;;;
;;;   graph-compose-pair-iff            [a, b] in G o H iff [a, y] in H and [y, b] in G for some y
;;;   graph-adjoint-compose-pair-iff    eq. (75): [xi, eta] in T* T iff for some zeta, [xi, zeta]
;;;                                     in T and <psi | eta> = <phi | zeta> for every [psi, phi] in T
;;;   commutes-adjoint-compose-iff      Prop 3.30: S commutes with T* T (Remark 3.29's graph
;;;                                     form) iff (79)
;;;   commutes-adjoint-compose-of       Cor 3.31: (80) in graph form implies S commutes with T* T
;;;   graph-of-map-pair-iff             [a, b] in graph(f) iff a in dd and b = f(a)
;;;   form-operator-pair-iff            membership in FORM-OPERATOR(v, dd, q), pointwise
;;;   graph-compose-subset              G o H lies in H x H
;;;   form-operator-subset              FORM-OPERATOR(v, dd, q) lies in H x H
;;;   adjoint-compose-form-operator-pair-iff  Prop 3.23 (the T_Q half) for the graph of a map
;;;   adjoint-compose-form-operator-pointwise f : dd -> H: pointwise form of the next
;;;   adjoint-compose-form-operator     Prop 3.23 (the T_Q half): T* T = T_Q, Q(x, y) = <f x | f y>
;;;
;;; No closedness, linearity or functionality of the graph is used: (75) and 3.30 hold for any
;;; G in H x H, 3.31 for any G when H is a Hilbert space (S*, R* exist).
;;; LOAD WINDOW: after theorem-library/ba-g1 (graph-adjoint-pair-iff, load.scm 4275) and
;;; ba-bh (op-adjoint-ip, op-adjoint-type).  Library: operator-algebras.  Helper prefix btg-.

(define btg-HH '(CARTESIAN (VEC v) (VEC v)))
(define (btg-pr a b) (list 'LIST a b))
(define (btg-set! x c)
  (if (not (dk-asm? (list 'IN x 'SET))) (dk-cite! 'membership-implies-sethood x c)))
(define (btg-sets!)
  (for-each (lambda (h)
              (if (and (dk-head-is? h 'IN) (symbol? (cadr h)) (not (eq? (caddr h) 'SET))
                       (not (dk-asm? (list 'IN (cadr h) 'SET))))
                  (dk-cite! 'membership-implies-sethood (cadr h) (caddr h))))
            (dk-asms)))
(define (btg-nth-goal!)
  (btg-sets!)
  (let loop ((k 0))
    (if (and (< k 40) (not (proof-done? *ps*))
             (not (equal? (reduce-nth-in-expr (dk-goal)) (dk-goal))))
        (begin (nth-r) (loop (+ k 1))))))
(define (btg-nth-hs! landed)
  (btg-sets!)
  (map (lambda (h) (if (dk-asm? h) (dk-nth-h! h) h)) landed))
(define (btg-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** BTG: ") (display name) (display " did NOT close.  Open leaves:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "BTG: unfinished" name))))
(define (btg-iff-fwd! iff)
  (ai iff)
  (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
  (caddr iff))
(define (btg-iff-bwd! iff)
  (ai iff)
  (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
  (cadr iff))
(define (btg-vec! x)                      ; (s_ y) typed in VEC v, s_ in FUN in context
  (if (not (dk-asm? (list 'IN x '(VEC v))))
      (fact 'fun-apply-type-c (car x) '(VEC v) '(VEC v) (cadr x))))

;;; instantiate the in-context universal F at TERMS and detach every antecedent in context
(define (btg-inst! f . terms)
  (let loop ((r (apply inst*! f terms)))
    (if (and (dk-head-is? r 'IMPLIES) (dk-asm? (cadr r)))
        (loop (dk-landed-1 (lambda () (detach! r))))
        r)))
;;; peel a goal  forall a in VEC. forall b in VEC. A => B ; return (a b) read off the typings
(define (btg-peel-pair!)
  (let* ((ls (dk-landed (lambda () (dk-peel!))))
         (ts (filter (lambda (f) (and (dk-head-is? f 'IN) (symbol? (cadr f)) (equal? (caddr f) '(VEC v)))) ls)))
    (if (< (length ts) 2) (error "btg-peel-pair!: two typings expected" (map expression->string ls)))
    (list (cadr (car ts)) (cadr (cadr ts)))))

;;; ====================================================================
;;; graph-compose-pair-iff
;;; ====================================================================
(define btg-cmp-rhs
  '(FORSOME bgy_ (AND (IN bgy_ (VEC v)) (AND (IN (LIST a_ bgy_) hh) (IN (LIST bgy_ b_) gg)))))
(sp (make-wff (forall-guarded '(v gg hh a_ b_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN a_ (VEC v)) (IN b_ (VEC v)))
  (list 'IFF '(IN (LIST a_ b_) (GRAPH-COMPOSE v gg hh)) btg-cmp-rhs))))
(dk-peel!)
(btg-sets!)
(dk-cite! 'pair-in-cartesian '(VEC v) '(VEC v) 'a_ 'b_)
(mac 'GRAPH-COMPOSE)
(let* ((g (dk-goal)) (mem (cadr g)))
  (dk-iff! (lambda (gl) (alpha-equiv? gl btg-cmp-rhs))
    (lambda ()
      (let* ((ls (dk-landed (lambda () (sep-me mem))))
             (ls2 (btg-nth-hs! (filter (lambda (h) (not (and (dk-head-is? h 'IN) (equal? (cadr h) '(LIST a_ b_))))) ls))))
        (ass)))
    (lambda ()
      (in-sep! (lambda () (ass)) (lambda () (btg-nth-goal!) (if (not (proof-done? *ps*)) (ass)))))))
(btg-qed! 'graph-compose-pair-iff)

;;; ====================================================================
;;; graph-adjoint-compose-pair-iff: eq. (75) of the proof of Prop 3.23
;;; ====================================================================
(define (btg-P a b)                       ; the right side of (75) at the pair [a, b]
  (list 'FORSOME 'bgz_ (list 'AND '(IN bgz_ (VEC v))
    (list 'AND (list 'IN (list 'LIST a 'bgz_) 'gg)
      (list 'FORALL 'ugc_ (list 'IMPLIES '(IN ugc_ (VEC v)) (list 'FORALL 'ugd_ (list 'IMPLIES '(IN ugd_ (VEC v))
        (list 'IMPLIES '(IN (LIST ugc_ ugd_) gg) (list '= (list '(IP v) 'ugc_ b) '((IP v) ugd_ bgz_)))))))))))
(define btg-C '(GRAPH-COMPOSE v (GRAPH-ADJOINT v gg) gg))
(sp (make-wff (forall-guarded '(v gg a_ b_)
  (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) (list 'SUBSET 'gg btg-HH) '(IN a_ (VEC v)) '(IN b_ (VEC v)))
  (list 'IFF (list 'IN '(LIST a_ b_) btg-C) (btg-P 'a_ 'b_)))))
(dk-peel!)
(let ((i1 (dk-cite! 'graph-compose-pair-iff 'v '(GRAPH-ADJOINT v gg) 'gg 'a_ 'b_)))
  (dk-iff! (lambda (gl) (alpha-equiv? gl (btg-P 'a_ 'b_)))
    (lambda ()
      (let* ((ex (btg-iff-fwd! i1))
             (y (dk-skolem! ex #t)))
        (dk-split-all!)
        (let ((i2 (dk-cite! 'graph-adjoint-pair-iff 'v 'gg y 'b_)))
          (btg-iff-fwd! i2)
          (ew y)
          (dk-conj-close! (lambda () (ass))))))
    (lambda ()
      (let* ((ex (dk-ctx-form (btg-P 'a_ 'b_)))
             (z (dk-skolem! ex #t)))
        (dk-split-all!)
        (let ((i2 (dk-cite! 'graph-adjoint-pair-iff 'v 'gg z 'b_)))
          (btg-iff-bwd! i2)
          (dk-have! (caddr i1) (lambda () (ew z) (dk-conj-close! (lambda () (ass)))))
          (btg-iff-bwd! i1)
          (ass))))))
(btg-qed! 'graph-adjoint-compose-pair-iff)

;;; ====================================================================
;;; commutes-adjoint-compose-iff (Prop 3.30)
;;; ====================================================================
(define (btg-comm-lhs)
  (list 'FORALL 'bga_ (list 'IMPLIES '(IN bga_ (VEC v)) (list 'FORALL 'bgb_ (list 'IMPLIES '(IN bgb_ (VEC v))
    (list 'IMPLIES (list 'IN '(LIST bga_ bgb_) btg-C) (list 'IN '(LIST (s_ bga_) (s_ bgb_)) btg-C)))))))
(define (btg-comm-rhs)
  (list 'FORALL 'bga_ (list 'IMPLIES '(IN bga_ (VEC v)) (list 'FORALL 'bgb_ (list 'IMPLIES '(IN bgb_ (VEC v))
    (list 'IMPLIES (btg-P 'bga_ 'bgb_) (btg-P '(s_ bga_) '(s_ bgb_))))))))
(sp (make-wff (forall-guarded '(v gg s_)
  (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) (list 'SUBSET 'gg btg-HH) '(IN s_ (BOUNDED-OPS v v)))
  (list 'IFF (btg-comm-lhs) (btg-comm-rhs)))))
(dk-peel!)
(fact 'bop-fun 'v 'v 's_)
(define (btg-dir! from-pair?)
  ;; goal: forall a b. A(a,b) => A(s a, s b); context: the other universal
  (let* ((other (dk-ctx-form (if from-pair? (btg-comm-lhs) (btg-comm-rhs))))
         (ab (btg-peel-pair!)) (a (car ab)) (b (cadr ab)))
    (btg-vec! (list 's_ a)) (btg-vec! (list 's_ b))
    (let* ((i1 (dk-cite! 'graph-adjoint-compose-pair-iff 'v 'gg a b))
           (i2 (dk-cite! 'graph-adjoint-compose-pair-iff 'v 'gg (list 's_ a) (list 's_ b))))
      (if from-pair?
          (begin (btg-iff-bwd! i1) (btg-inst! other a b) (btg-iff-fwd! i2) (ass))
          (begin (btg-iff-fwd! i1) (btg-inst! other a b) (btg-iff-bwd! i2) (ass))))))
(dk-iff! (lambda (gl) (alpha-equiv? gl (btg-comm-rhs)))
  (lambda () (btg-dir! #t))
  (lambda () (btg-dir! #f)))
(btg-qed! 'commutes-adjoint-compose-iff)

;;; ====================================================================
;;; commutes-adjoint-compose-of (Cor 3.31)
;;; ====================================================================
(define btg-80
  '(FORALL bgc_ (IMPLIES (IN bgc_ (VEC v)) (FORALL bgd_ (IMPLIES (IN bgd_ (VEC v))
     (IMPLIES (IN (LIST bgc_ bgd_) gg)
       (AND (IN (LIST (s_ bgc_) (r_ bgd_)) gg)
            (IN (LIST ((OP-ADJOINT v v s_) bgc_) ((OP-ADJOINT v v r_) bgd_)) gg))))))))
(sp (make-wff (forall-guarded '(v gg r_ s_)
  (list '(IS-HILBERT-SPACE v) (list 'SUBSET 'gg btg-HH) '(IN r_ (BOUNDED-OPS v v)) '(IN s_ (BOUNDED-OPS v v)) btg-80)
  (btg-comm-lhs))))
(define btg-ab31 (btg-peel-pair!))
(fact 'hilbert-space-is-cips 'v)
(fact 'bop-fun 'v 'v 's_)
(fact 'bop-fun 'v 'v 'r_)
(let* ((h80 (dk-ctx-form btg-80))
       (ab btg-ab31) (a (car ab)) (b (cadr ab)))
  (btg-vec! (list 's_ a)) (btg-vec! (list 's_ b))
  (let* ((i1 (dk-cite! 'graph-adjoint-compose-pair-iff 'v 'gg a b))
         (pab (btg-iff-fwd! i1))
         (z (dk-skolem! (dk-ctx-form pab) #t)))
    (dk-split-all!)
    (let* ((uu (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q z) (dk-contains? q 'ugd_))) "the adjoint condition"))
           (rz (list 'r_ z)))
      (btg-vec! rz)
      (dk-split-all! (list (btg-inst! h80 a z)))
      (let ((i2 (dk-cite! 'graph-adjoint-compose-pair-iff 'v 'gg (list 's_ a) (list 's_ b))))
        (dk-have! (caddr i2)
          (lambda ()
            (ew rz)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'FORALL)
                    (let* ((cd (btg-peel-pair!)) (c (car cd)) (d (cadr cd))
                           (sc (list '(OP-ADJOINT v v s_) c)) (rd (list '(OP-ADJOINT v v r_) d)))
                      (dk-split-all! (list (btg-inst! h80 c d)))
                      (if (not (dk-asm? (list 'IN sc '(VEC v)))) (dk-cite! 'op-adjoint-type 'v 'v 's_ c))
                      (if (not (dk-asm? (list 'IN rd '(VEC v)))) (dk-cite! 'op-adjoint-type 'v 'v 'r_ d))
                      (btg-inst! uu sc rd)
                      (let* ((e1 (dk-cite! 'cips-ip-conj-sym 'v (list 's_ b) c))
                             (e2 (dk-cite! 'op-adjoint-ip 'v 'v 's_ b c))
                             (e3 (dk-cite! 'cips-ip-conj-sym 'v b sc))
                             (e4 (dk-cite! 'cips-ip-conj-sym 'v rz d))
                             (e5 (dk-cite! 'op-adjoint-ip 'v 'v 'r_ z d))
                             (e6 (dk-cite! 'cips-ip-conj-sym 'v z rd)))
                        (subst e1) (subst e2) (subst (list '= (caddr e3) (cadr e3)))
                        (subst e4) (subst e5) (subst (list '= (caddr e6) (cadr e6)))
                        (ass)))
                    (ass))))))
        (btg-iff-bwd! i2)
        (ass)))))
(btg-qed! 'commutes-adjoint-compose-of)

;;; ====================================================================
;;; Prop 3.23, second clause: for T the graph of a map ff : dd -> H, T* T is the operator
;;; T_Q of the form Q(xi, eta) = <T xi | T eta> (Prop 3.17's FORM-OPERATOR), as graphs.
;;; ====================================================================
(define btg-G '(SEP bgp_ (CARTESIAN (VEC v) (VEC v)) (AND (IN (NTH 1 bgp_) dd) (= (NTH 2 bgp_) (ff (NTH 1 bgp_))))))
(define btg-Q '(VNB-LAMBDA (LIST bgx_ bgy_) (CARTESIAN dd dd) ((IP v) (ff bgx_) (ff bgy_))))
(define (btg-mem-iff! name vars guards elt setterm unfold rhs)
  (sp (make-wff (forall-guarded vars guards (list 'IFF (list 'IN elt setterm) rhs))))
  (dk-peel!)
  (btg-sets!)
  (unfold)
  (let* ((g (dk-goal)) (mem (cadr g)))
    (dk-iff! (lambda (gl) (alpha-equiv? gl rhs))
      (lambda ()
        (let* ((ls (dk-landed (lambda () (sep-me mem))))
               (ls2 (btg-nth-hs! (filter (lambda (h) (not (and (dk-head-is? h 'IN) (equal? (cadr h) elt)))) ls))))
          (if (dk-asm? (dk-goal))
              (ass)
              (begin (dk-split-all! ls2) (dk-conj-close! dk-ass!)))))
      (lambda ()
        (in-sep! (lambda () (ass)) (lambda () (btg-nth-goal!) (if (not (proof-done? *ps*)) (ass)))))))
  (btg-qed! name))

;;; [a, b] in graph(ff) iff a in dd and b = ff(a)
(btg-mem-iff! 'graph-of-map-pair-iff '(v dd ff a_ b_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN a_ (VEC v)) (IN b_ (VEC v)))
  '(LIST a_ b_) btg-G
  (lambda () (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC v) 'a_ 'b_))
  '(AND (IN a_ dd) (= b_ (ff a_))))

;;; [a, b] in T_Q iff a in dom Q and <x | b> = Q(x, a) for every x in dom Q
(btg-mem-iff! 'form-operator-pair-iff '(v dd bgq_ a_ b_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN a_ (VEC v)) (IN b_ (VEC v)))
  '(LIST a_ b_) '(FORM-OPERATOR v dd bgq_)
  (lambda () (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC v) 'a_ 'b_) (mac 'FORM-OPERATOR))
  '(AND (IN a_ dd) (FORALL bgx_ (IMPLIES (IN bgx_ dd) (= ((IP v) bgx_ b_) (bgq_ bgx_ a_))))))

;;; the composite graph and the form operator lie in H x H
(define (btg-sep-subset! name vars stmt-set fun)
  (sp (make-wff (forall-guarded vars '((IS-COMPLEX-INNER-PRODUCT-SPACE v)) (list 'SUBSET stmt-set btg-HH))))
  (dk-peel!)
  (dk-cite! 'cips-vec-set 'v)
  (mac fun)
  (mac 'subset-def)
  (let ((home (proof-state-focus *ps*)))
    (for-each (lambda (l)
                (let ((g (dk-goal-of l)))
                  (if (and (dk-head-is? g '=) (equal? (cadr g) (caddr g)))
                      (begin (dk-focus! l) (rfl)))))
              (dk-open-leaves))
    (if (not (sequent-node-grounded? home)) (dk-focus! home)))
  (dk-peel!)
  (let ((h (car (filter (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) (dk-asms)))))
    (sep-me h)
    (dk-split-all!)
    (ass))
  (btg-qed! name))
(btg-sep-subset! 'graph-compose-subset '(v gg hh) '(GRAPH-COMPOSE v gg hh) 'GRAPH-COMPOSE)
(btg-sep-subset! 'form-operator-subset '(v dd bgq_) '(FORM-OPERATOR v dd bgq_) 'FORM-OPERATOR)

(define btg-FO (list 'FORM-OPERATOR 'v 'dd btg-Q))
(define btg-CG (list 'GRAPH-COMPOSE 'v (list 'GRAPH-ADJOINT 'v btg-G) btg-G))
(define (btg-in-dd! x)                       ; x in dd: x in VEC v, ff x in VEC v, both sets
  (if (not (dk-asm? (list 'IN x '(VEC v)))) (dk-cite! 'subset-mem-fwd 'dd '(VEC v) x))
  (if (not (dk-asm? (list 'IN (list 'ff x) '(VEC v)))) (fact 'fun-apply-type-c 'ff 'dd '(VEC v) x))
  (btg-set! x '(VEC v)) (btg-set! (list 'ff x) '(VEC v)))
(define (btg-qval! x a)                      ; Q(x, a) = <ff x | ff a> for x, a in dd
  (list '= (list btg-Q x a) (list '(IP v) (list 'ff x) (list 'ff a))))
(sp (make-wff (forall-guarded '(v dd ff c_ d_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (SUBSET dd (VEC v)) (IN ff (FUN dd (VEC v))) (IN c_ (VEC v)) (IN d_ (VEC v)))
  (list 'IFF (list 'IN '(LIST c_ d_) btg-CG) (list 'IN '(LIST c_ d_) btg-FO)))))
(dk-peel!)
(dk-cite! 'cips-vec-set 'v)
(let ((gG (list 'SUBSET btg-G btg-HH)))
  (dk-have! gG (lambda ()
    (mac 'subset-def)
    (dk-peel!)
    (let ((h (car (filter (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) (dk-asms)))))
      (sep-me h) (dk-split-all!) (ass)))))
(let* ((c 'c_) (d 'd_)
       (i75 (dk-cite! 'graph-adjoint-compose-pair-iff 'v btg-G c d))
       (ifo (dk-cite! 'form-operator-pair-iff 'v 'dd btg-Q c d)))
  (dk-iff! (lambda (gl) (alpha-equiv? gl (list 'IN (list 'LIST c d) btg-FO)))
          (lambda ()                         ; [c, d] in T* T  =>  [c, d] in T_Q
            (let* ((p (btg-iff-fwd! i75))
                   (z (dk-skolem! (dk-ctx-form p) #t)))
              (dk-split-all!)
              (let* ((uu (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q z) (dk-contains? q 'ugd_))) "U"))
                     (gz (btg-iff-fwd! (dk-cite! 'graph-of-map-pair-iff 'v 'dd 'ff c z))))
                (dk-split-all! (list gz))
                (btg-in-dd! c)
                (dk-have! (caddr ifo)
                  (lambda ()
                    (dk-conj-close!
                      (lambda ()
                        (if (dk-head-is? (dk-goal) 'FORALL)
                            (let* ((x (dk-di-var!)))
                              (btg-in-dd! x)
                              (let ((gx (dk-cite! 'graph-of-map-pair-iff 'v 'dd 'ff x (list 'ff x))))
                                (dk-have! (caddr gx) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))
                                (btg-iff-bwd! gx))
                              (btg-inst! uu x (list 'ff x))
                              (dk-lam-b!)
                              (subst (list '= (list 'ff c) z))
                              (ass))
                            (ass))))))
                (btg-iff-bwd! ifo)
                (ass))))
          (lambda ()                         ; [c, d] in T_Q  =>  [c, d] in T* T
            (let* ((fo (btg-iff-fwd! ifo)))
              (dk-split-all! (list fo))
              (btg-in-dd! c)
              (let* ((ww (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q 'bgx_))) "W"))
                     (fc (list 'ff c))
                     (gc (dk-cite! 'graph-of-map-pair-iff 'v 'dd 'ff c fc)))
                (dk-have! (caddr gc) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))
                (btg-iff-bwd! gc)
                (dk-have! (caddr i75)
                  (lambda ()
                    (ew fc)
                    (dk-conj-close!
                      (lambda ()
                        (if (dk-head-is? (dk-goal) 'FORALL)
                            (let* ((cd (btg-peel-pair!)) (c2 (car cd)) (d2 (cadr cd))
                                   (g2 (btg-iff-fwd! (dk-cite! 'graph-of-map-pair-iff 'v 'dd 'ff c2 d2))))
                              (dk-split-all! (list g2))
                              (btg-in-dd! c2)
                              (let ((wi (btg-inst! ww c2)))
                                (dk-lam-b-h! wi)
                                (subst (list '= d2 (list 'ff c2)))
                                (ass)))
                            (ass))))))
                (btg-iff-bwd! i75)
                (ass)))))
)
(btg-qed! 'adjoint-compose-form-operator-pair-iff)

;;; the pointwise universal, as its own theorem
(define btg-PW
  (list 'FORALL 'ugc_ (list 'IMPLIES '(IN ugc_ (VEC v)) (list 'FORALL 'ugd_ (list 'IMPLIES '(IN ugd_ (VEC v))
     (list 'IFF (list 'IN '(LIST ugc_ ugd_) btg-CG) (list 'IN '(LIST ugc_ ugd_) btg-FO)))))))
(sp (make-wff (forall-guarded '(v dd ff)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (SUBSET dd (VEC v)) (IN ff (FUN dd (VEC v))))
  btg-PW)))
(let ((cd (btg-peel-pair!)))
  (dk-cite! 'adjoint-compose-form-operator-pair-iff 'v 'dd 'ff (car cd) (cadr cd))
  (ass))
(btg-qed! 'adjoint-compose-form-operator-pointwise)

(sp (make-wff (forall-guarded '(v dd ff)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (SUBSET dd (VEC v)) (IN ff (FUN dd (VEC v))))
