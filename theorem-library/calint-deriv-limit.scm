;;; calint-deriv-limit.scm -- WAVE 2 (2026-10-27..30), wired 2026-10-30 from scratchpad/calint/calint-deriv-limit.scm.
;;; Library: analysis.

;;; calint-deriv-limit.scm -- calculus.pdf Prop 4.16 as the notes state it, and what it needs:
;;;   (1) continuity on a set of reals, in abs form, both directions (no metric-space bookkeeping
;;;       in the rest of the file);
;;;   (2) a derivative within W bounds g near x (has-deriv-at-within => local continuity);
;;;   (3) HAS-DERIV-ON-CCINT => continuous on [a, b] => a primitive (empty exceptional set);
;;;   (4) a derivative within W from a little-o bound (has-deriv-at-of-eps-bound for any W);
;;;   (5) THE FUNDAMENTAL THEOREM ON [a, b]: a primitive of a function continuous on [a, b] has it
;;;       as its derivative on [a, b], one-sided at the ends;
;;;   (6) a uniform limit of functions continuous on [a, b] is continuous on [a, b];
;;;   (7) Prop 4.16.
;;; Library: analysis.  Needs calint-vocab (HAS-DERIV-ON-CCINT).  Load window: after
;;; primitive-uniform-limit, calc2-segment and one-sided-derivative-laws.  Prefix cdl-.

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (cdl-and! a b) (dk-have! (list 'AND a b) (lambda () (dk-conj-close! (lambda () (ass))))))
(define (cdl-find pred lst what)
  (let ((r (filter pred lst)))
    (if (null? r) (error "cdl-find: nothing matching" what) (car r))))
(define (cdl-sub-setup! w)
  (fact 'rr-is-set)
  (dk-cite! 'subclass-of-set-is-set w 'RR)
  (fact 'rr-is-metric-space)
  (fact 'r7q-rr-pts)
  (dk-have! (list 'SUBSET w '(PTS RR-MS)) (lambda () (subst '(= (PTS RR-MS) RR)) (ass)))
  (dk-cite! 'subspace-is-metric-space 'RR-MS w)
  (dk-cite! 'subspace-pts 'RR-MS w))

;;; =====================================================================
;;; (1) CONTINUITY IN ABS FORM
;;; =====================================================================
(define (cdl-absform w p x)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'cdd_ (list 'AND '(POS-RR cdd_)
      (list 'FORALL 'cdy_ (list 'IMPLIES (list 'IN 'cdy_ w)
        (list 'IMPLIES (list '<= (list 'ABS (list '- x 'cdy_)) 'cdd_)
          (list '<= (list 'ABS (list '- (list p x) (list p 'cdy_))) 'eps)))))))))

(sp (make-wff (list 'FORALL 'cdw_ (list 'FORALL 'cdp_ (list 'FORALL 'cdx_
  (list 'IMPLIES '(SUBSET cdw_ RR)
    (list 'IMPLIES '(IS-CONTINUOUS-AT (SUBSPACE-MS RR-MS cdw_) RR-MS cdp_ cdx_)
      (cdl-absform 'cdw_ 'cdp_ 'cdx_))))))))
(dk-peel!)
(cdl-sub-setup! 'cdw_)
(define cdl-c0-sub '(SUBSPACE-MS RR-MS cdw_))
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'IS-CONTINUOUS-AT (dk-pick (dk-head? 'IS-CONTINUOUS-AT) "the continuity")))))
(define cdl-c0-ec (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'DIST))) "the eps clause"))
(dk-have! '(IN cdx_ cdw_) (lambda () (subst (list '= 'cdw_ (list 'PTS cdl-c0-sub))) (ass)))
(dk-have! '(IN cdp_ (FUN cdw_ RR))
  (lambda () (subst (list '= 'cdw_ (list 'PTS cdl-c0-sub))) (subst '(= RR (PTS RR-MS))) (ass)))
(let* ((e (cadr (dk-pick (dk-head? 'POS-RR) "eps")))
       (dd (dk-skolem! (dk-apply! cdl-c0-ec e)))
       (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f dd))) "the delta clause")))
  (ew dd)
  (dk-conj-close!
   (lambda ()
     (if (not (dk-head-is? (dk-goal) 'FORALL))
         (ass)
         (let* ((ls (dk-peel!))
                (y (cadr (cdl-find (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'cdw_))) ls "y"))))
           (fact 'subset-mem-fwd 'cdw_ 'RR 'cdx_)
           (fact 'subset-mem-fwd 'cdw_ 'RR y)
           (fact 'fun-apply-type-c 'cdp_ 'cdw_ 'RR 'cdx_)
           (fact 'fun-apply-type-c 'cdp_ 'cdw_ 'RR y)
           (dk-have! (list 'IN y (list 'PTS cdl-c0-sub)) (lambda () (subst (list '= (list 'PTS cdl-c0-sub) 'cdw_)) (ass)))
           (fact 'subspace-dist 'RR-MS 'cdw_ 'cdx_ y)
           (fact 'rr-ms-dist 'cdx_ y)
           (dk-have! (list '<= (list (list 'DIST cdl-c0-sub) 'cdx_ y) dd)
             (lambda ()
               (subst (list '= (list (list 'DIST cdl-c0-sub) 'cdx_ y) (list '(DIST RR-MS) 'cdx_ y)))
               (subst (list '= (list '(DIST RR-MS) 'cdx_ y) (list 'ABS (list '- 'cdx_ y))))
               (ass)))
           (dk-apply! cl y)
           (let ((px '(cdp_ cdx_)) (py (list 'cdp_ y)))
             (fact 'rr-ms-dist px py)
             (subst (list '= (list 'ABS (list '- px py)) (list '(DIST RR-MS) px py)))
             (ass)))))))
(qed 'continuous-at-subspace-abs)

(sp (make-wff (list 'FORALL 'cdw_ (list 'FORALL 'cdp_
  (list 'IMPLIES '(SUBSET cdw_ RR)
    (list 'IMPLIES '(IS-CONTINUOUS-ON cdp_ cdw_)
      (list 'FORALL 'cdx_ (list 'IMPLIES '(IN cdx_ cdw_) (cdl-absform 'cdw_ 'cdp_ 'cdx_)))))))))
(dk-peel!)
(dk-split-all! (dk-landed* (lambda () (mac-h 'IS-CONTINUOUS-ON '(IS-CONTINUOUS-ON cdp_ cdw_)))))
(let* ((cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-CONTINUOUS-AT))) "continuity"))
       (x (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'cdw_))) "x")))
       (e (cadr (dk-pick (dk-head? 'POS-RR) "eps"))))
  (dk-apply! cl x)
  (dk-apply! (dk-cite! 'continuous-at-subspace-abs 'cdw_ 'cdp_ x) e)
  (ass))
(qed 'continuous-on-abs-fwd)

(sp (make-wff (list 'FORALL 'cdw_ (list 'FORALL 'cdp_
  (list 'IMPLIES '(SUBSET cdw_ RR)
    (list 'IMPLIES '(IN cdp_ (FUN cdw_ RR))
      (list 'IMPLIES (list 'FORALL 'cdx_ (list 'IMPLIES '(IN cdx_ cdw_) (cdl-absform 'cdw_ 'cdp_ 'cdx_)))
        '(IS-CONTINUOUS-ON cdp_ cdw_))))))))
(dk-peel!)
(cdl-sub-setup! 'cdw_)
(define cdl-c1-sub '(SUBSPACE-MS RR-MS cdw_))
(define cdl-c1-h (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR))) "the abs form"))
(mac 'IS-CONTINUOUS-ON)
(dk-conj-close!
 (lambda ()
   (if (not (dk-head-is? (dk-goal) 'FORALL))
       (ass)
       (let ((x (dk-di-var!)))
         (mac 'IS-CONTINUOUS-AT)
         (subst (list '= (list 'PTS cdl-c1-sub) 'cdw_))
         (subst '(= (PTS RR-MS) RR))
         (dk-conj-close!
          (lambda ()
            (if (not (dk-head-is? (dk-goal) 'FORALL))
                (ass)
                (let* ((pe (dk-peel!))
                       (e (cadr (cdl-find (dk-head? 'POS-RR) pe "eps")))
                       (dd (dk-skolem! (dk-apply! cdl-c1-h x e)))
                       (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f dd))) "the delta clause")))
                  (ew dd)
                  (dk-conj-close!
                   (lambda ()
                     (if (not (dk-head-is? (dk-goal) 'FORALL))
                         (ass)
                         (let* ((ls (dk-peel!))
                                (y (cadr (cdl-find (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'cdw_)
                                                                     (not (eq? (cadr f) x))))
                                                   ls "y")))
                                (dh (cdl-find (dk-head? '<=) ls "the distance")))
                           (fact 'subset-mem-fwd 'cdw_ 'RR x)
                           (fact 'subset-mem-fwd 'cdw_ 'RR y)
                           (fact 'fun-apply-type-c 'cdp_ 'cdw_ 'RR x)
                           (fact 'fun-apply-type-c 'cdp_ 'cdw_ 'RR y)
                           (let* ((ds (dk-cite! 'subspace-dist 'RR-MS 'cdw_ x y))
                                  (h1 (dk-rewrite-h! dh (cadr ds) (caddr ds)))
                                  (dr (dk-cite! 'rr-ms-dist x y))
                                  (h2 (dk-rewrite-h! h1 (cadr dr) (caddr dr))))
                             (dk-apply! cl y)
                             (subst (dk-cite! 'rr-ms-dist (list 'cdp_ x) (list 'cdp_ y)))
                             (ass))))))))))))))
(qed 'continuous-on-abs-bwd)

;;; =====================================================================
;;; (2) A DERIVATIVE WITHIN W BOUNDS THE FUNCTION NEAR x:  |g(x) - g(y)| <= eps for y in W near x.
;;; g(y) - g(x) = p(y)(y - x) with p continuous at x and p(x) = l, so |p(y)| <= |l| + 1 =: A near
;;; x, and |y - x| <= eps / (A + 1) gives A |y - x| <= eps, proved inline (aif-scale-small is in the complex-analysis library).
;;; =====================================================================
(sp (make-wff (list 'FORALL 'cdw_ (list 'FORALL 'g (list 'FORALL 'cdx_ (list 'FORALL 'cdl_
  (list 'IMPLIES '(SUBSET cdw_ RR)
    (list 'IMPLIES '(HAS-DERIV-AT-WITHIN g cdw_ cdx_ cdl_)
      (cdl-absform 'cdw_ 'g 'cdx_)))))))))
(dk-peel!)
(define cdl-a1-e (cadr (dk-pick (dk-head? 'POS-RR) "eps")))
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'HAS-DERIV-AT-WITHIN (dk-pick (dk-head? 'HAS-DERIV-AT-WITHIN) "the derivative")))))
(define cdl-a1-p (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the slope function")))
(dk-split-all!)
(define cdl-a1-id (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f cdl-a1-p) (dk-contains? f 'g)))
                           "the slope identity"))
(cdl-sub-setup! 'cdw_)
(define cdl-a1-W '(RESTRICT g cdw_))
(let* ((e cdl-a1-e) (p cdl-a1-p) (x 'cdx_) (l 'cdl_) (px (list p x))
       (cab (dk-cite! 'continuous-at-subspace-abs 'cdw_ p x)))
  (fact 'rr-one-in)
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (fact 'rr-pos-rr-of-lt 1)
  (fact 'subset-mem-fwd 'cdw_ 'RR x)
  (fact 'fun-apply-type-c p 'cdw_ 'RR x)
  (fact 'rr-pos-rr-in-rr e)
  (fact 'rr-lt-of-pos-rr e)
  (let* ((d1 (dk-skolem! (dk-apply! cab 1)))
         (c1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d1))) "the slope bound clause")))
    (fact 'rr-pos-rr-in-rr d1)
    (fact 'rr-lt-of-pos-rr d1)
    (fact 'rr-abs-closed l)
    (fact 'rr-abs-nonneg l)
    (fact 'rr-neg-abs-le l)
    (fact 'rr-le-abs l)
    (fact 'rr-add-in-rr (list 'ABS l) 1)
    (let* ((av (dk-name! (list '+ (list 'ABS l) 1) 'RR)))
      (dk-have! (list '<= 0 av)
        (lambda () (dk-ineq! (list 'IN av 'RR) (list '= av (list '+ (list 'ABS l) 1)) (list '<= 0 (list 'ABS l)))))
      ;; e' = e / (A + 1): positive, and A e' <= e
      (let* ((B (list '+ av 1))
             (_b0 (fact 'rr-add-in-rr av 1))
             (_b1 (dk-have! (list '< 0 B) (lambda () (dk-ineq! (list 'IN av 'RR) (list '<= 0 av)))))
             (_b2 (fact 'rr-pos-ne-zero B))
             (_b3 (cdl-and! (list 'IN B 'RR) (list 'NOT (list '= B 0))))
             (_b4 (fact 'rr-recip-closed B))
             (_b5 (fact 'rr-recip-pos B))
             (_b6 (fact 'rr-recip-inverse B))
             (rv (dk-name! (list 'recip B) 'RR))
             (_b7 (fact 'rr-mul-in-rr e rv))
             (ev (dk-name! (list '* e rv) 'RR))
             (_b8 (dk-have! (list '< 0 rv) (lambda () (subst (list '= rv (list 'recip B))) (ass))))
             (_b9 (dk-have! (list '< 0 ev)
                    (lambda () (subst (list '= ev (list '* e rv))) (fact 'rr-mul-pos e rv) (ass))))
             (pos1 (fact 'rr-pos-rr-of-lt ev))
             (_c1 (dk-have! (list '= (list '* B rv) 1)
                    (lambda () (subst (list '= rv (list 'recip B))) (ass))))
             (_c2 (fact 'rr-mul-in-rr av ev))
             (_c3 (dk-have! (list '= e (list '+ (list '* av ev) ev))
                    (lambda ()
                      (subst (list '= ev (list '* e rv)))
                      (dk-have! (list '= (list '+ (list '* av (list '* e rv)) (list '* e rv)) (list '* e (list '* B rv)))
                        (lambda () (crs)))
                      (subst (list '= (list '+ (list '* av (list '* e rv)) (list '* e rv)) (list '* e (list '* B rv))))
                      (subst (list '= (list '* B rv) 1))
                      (crs))))
             (le1 (dk-have! (list '<= (list '* av ev) e)
                    (lambda () (dk-ineq! (list 'IN (list '* av ev) 'RR) (list 'IN e 'RR) (list 'IN ev 'RR)
                                         (list '= e (list '+ (list '* av ev) ev)) (list '< 0 ev))))))
        (set! le1 (list '<= (list '* av ev) e))
        (fact 'rr-lt-of-pos-rr ev)
        (let* ((w (dk-skolem! (dk-cite! 'rr-min-pos d1 ev))))
          (fact 'rr-pos-rr-of-lt w)
          (ew w)
          (dk-conj-close!
           (lambda ()
             (if (not (dk-head-is? (dk-goal) 'FORALL))
                 (ass)
                 (let* ((ls (dk-peel!))
                        (y (cadr (cdl-find (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'cdw_))) ls "y")))
                        (py (list p y)) (gx (list 'g x)) (gy (list 'g y))
                        (yx (list '- y x)) (xy (list '- x y)))
                   (fact 'subset-mem-fwd 'cdw_ 'RR y)
                   (fact 'fun-apply-type-c p 'cdw_ 'RR y)
                   (fact 'fun-apply-type-c cdl-a1-W 'cdw_ 'RR y)
                   (fact 'fun-apply-type-c cdl-a1-W 'cdw_ 'RR x)
                   (fact 'restrict-apply 'g 'cdw_ y)
                   (fact 'restrict-apply 'g 'cdw_ x)
                   (dk-have! (list 'IN gy 'RR) (lambda () (subst (list '== gy (list cdl-a1-W y))) (ass)))
                   (dk-have! (list 'IN gx 'RR) (lambda () (subst (list '== gx (list cdl-a1-W x))) (ass)))
                   (fact 'rr-sub-in-rr x y) (fact 'rr-sub-in-rr y x)
                   (fact 'rr-sub-in-rr px py)
                   (fact 'rr-abs-closed xy) (fact 'rr-abs-closed yx)
                   (fact 'rr-abs-closed py) (fact 'rr-abs-nonneg yx)
                   (fact 'rr-abs-closed (list '- px py))
                   ;; |p(y)| <= A
                   (dk-have! (list '<= (list 'ABS xy) d1)
                     (lambda () (dk-ineq! (list 'IN (list 'ABS xy) 'RR) (list '<= (list 'ABS xy) w) (list '<= w d1))))
                   (dk-apply! c1 y)
                   (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list '- px py) 1)))
                   (let ((prem (list (list 'IN px 'RR) (list 'IN py 'RR) (list 'IN l 'RR) (list 'IN av 'RR)
                                     (list '= px l) (list '= av (list '+ (list 'ABS l) 1))
                                     (list '<= (list '- (list 'ABS l)) l) (list '<= l (list 'ABS l))
                                     (list '<= (list '- 1) (list '- px py)) (list '<= (list '- px py) 1))))
                     (dk-have! (list '<= (list '- av) py) (lambda () (apply dk-ineq! prem)))
                     (dk-have! (list '<= py av) (lambda () (apply dk-ineq! prem))))
                   (dk-cite! 'rr-abs-le-of-parts py av)
                   ;; |y - x| <= e'
                   (fact 'rr-abs-sub-sym x y)
                   (dk-have! (list '<= (list 'ABS yx) ev)
                     (lambda ()
                       (subst (list '= (list 'ABS yx) (list 'ABS xy)))
                       (dk-ineq! (list 'IN (list 'ABS xy) 'RR) (list 'IN ev 'RR) (list '<= (list 'ABS xy) w) (list '<= w ev))))
                   ;; the goal
                   (fact 'rr-abs-sub-sym gx gy)
                   (fact 'rr-sub-in-rr gx gy) (fact 'rr-sub-in-rr gy gx)
                   (subst (list '= (list 'ABS (list '- gx gy)) (list 'ABS (list '- gy gx))))
                   (subst (dk-apply! cdl-a1-id y))
                   (cdl-and! (list 'IN py 'RR) (list 'IN yx 'RR))
                   (subst (dk-cite! 'rr-abs-mult py yx))
                   (let* ((pv (dk-name! (list 'ABS py) 'RR)) (_1 (subst (list '= (list 'ABS py) pv)))
                          (qv (dk-name! (list 'ABS yx) 'RR)) (_2 (subst (list '= (list 'ABS yx) qv)))
                          (h1 (dk-rewrite-h! (list '<= (list 'ABS py) av) (list 'ABS py) pv))
                          (h2 (dk-rewrite-h! (list '<= (list 'ABS yx) ev) (list 'ABS yx) qv))
                          (h3 (dk-rewrite-h! (list '<= 0 (list 'ABS yx)) (list 'ABS yx) qv)))
                     (dk-cite! 'rr-mul-le-right pv av qv)
                     (dk-cite! 'rr-mul-le-right qv ev av)
                     (fact 'rr-mul-in-rr pv qv) (fact 'rr-mul-in-rr av qv) (fact 'rr-mul-in-rr qv av)
                     (fact 'rr-mul-in-rr ev av) (fact 'rr-mul-in-rr av ev)
                     (dk-have! (list '= (list '* av qv) (list '* qv av)) (lambda () (crs)))
                     (dk-have! (list '= (list '* ev av) (list '* av ev)) (lambda () (crs)))
                     (dk-ineq! (list 'IN (list '* pv qv) 'RR) (list 'IN (list '* av qv) 'RR) (list 'IN (list '* qv av) 'RR)
                               (list 'IN (list '* ev av) 'RR) (list 'IN (list '* av ev) 'RR) (list 'IN e 'RR)
                               (list '<= (list '* pv qv) (list '* av qv))
                               (list '= (list '* av qv) (list '* qv av))
                               (list '<= (list '* qv av) (list '* ev av))
                               (list '= (list '* ev av) (list '* av ev))
                               le1)))))))))))
(qed 'deriv-within-local-bound)

;;; =====================================================================
;;; (3) A FUNCTION WITH A DERIVATIVE ON [a, b] IS CONTINUOUS THERE, AND A PRIMITIVE OF IT
;;; =====================================================================
;;; one-sided local bounds, with no interval: from the within-derivative on [x, x + e0) / (x - e0, x]
(define (cdl-side-form x right?)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'cdd_ (list 'AND '(POS-RR cdd_)
      (list 'FORALL 'cdy_ (list 'IMPLIES '(IN cdy_ RR)
        (list 'IMPLIES (if right? (list '<= x 'cdy_) (list '<= 'cdy_ x))
          (list 'IMPLIES (list '<= (list 'ABS (list '- x 'cdy_)) 'cdd_)
            (list '<= (list 'ABS (list '- (list 'g x) (list 'g 'cdy_))) 'eps))))))))))
(define (cdl-side-proof! right?)
  (dk-peel!)
  (let* ((e (cadr (dk-pick (dk-head? 'POS-RR) "eps")))
         (dh (dk-pick (dk-head? (if right? 'HAS-RIGHT-DERIV-AT 'HAS-LEFT-DERIV-AT)) "the one-sided derivative"))
         (_0 (fact (if right? 'has-right-deriv-at-pt-in-rr 'has-left-deriv-at-pt-in-rr) 'g 'cdx_ 'cdl_))
         (e0 (dk-skolem! (dk-landed-1 (lambda ()
               (mac-h (if right? 'HAS-RIGHT-DERIV-AT 'HAS-LEFT-DERIV-AT) dh)))))
         (_1 (dk-split-all!))
         (WIN (if right? (list 'COINT 'cdx_ (list '+ 'cdx_ e0)) (list 'OCINT (list '- 'cdx_ e0) 'cdx_))))
    (fact 'rr-pos-rr-in-rr e0) (fact 'rr-lt-of-pos-rr e0)
    (fact 'rr-pos-rr-in-rr e)
    (fact (if right? 'coint-subset-rr 'ocint-subset-rr) (cadr WIN) (caddr WIN))
    (let* ((lb (dk-cite! 'deriv-within-local-bound WIN 'g 'cdx_ 'cdl_))
           (d1 (dk-skolem! (dk-apply! lb e)))
           (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d1))) "the bound clause"))
           (h (dk-halve! e0)))
      (fact 'rr-pos-rr-in-rr d1) (fact 'rr-lt-of-pos-rr d1)
      (let ((w (dk-skolem! (dk-cite! 'rr-min-pos d1 h))))
        (fact 'rr-pos-rr-of-lt w)
        (ew w)
        (dk-conj-close!
         (lambda ()
           (if (not (dk-head-is? (dk-goal) 'FORALL))
               (ass)
               (let* ((ls (dk-peel!))
                      (y (cadr (cdl-find (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR)
                                                           (not (eq? (cadr f) 'cdx_))
                                                           (not (memq (cadr f) (list e e0 d1 h w)))))
                                         ls "y")))
                      (xy (list '- 'cdx_ y)))
                 (fact 'rr-sub-in-rr 'cdx_ y)
                 (dk-split-all! (list (dk-cite! 'rr-abs-le-parts xy w)))
                 (fact 'rr-abs-closed xy)
                 (let ((prem (list (list 'IN 'cdx_ 'RR) (list 'IN y 'RR) (list 'IN e0 'RR) (list 'IN h 'RR) (list 'IN w 'RR)
                                   (list '<= (list '- w) xy) (list '<= xy w) (list '<= w h)
                                   (list '= (list '+ h h) e0) (list '< 0 h)
                                   (if right? (list '<= 'cdx_ y) (list '<= y 'cdx_)))))
                   (dk-have! (list 'IN y WIN)
                     (lambda ()
                       (mac (if right? 'coint-membership 'ocint-membership))
                       (dk-conj-close! (lambda () (if (dk-ctx-form (dk-goal)) (ass) (apply dk-ineq! prem)))))))
                 (dk-have! (list '<= (list 'ABS xy) d1)
                   (lambda () (dk-ineq! (list 'IN (list 'ABS xy) 'RR) (list 'IN d1 'RR) (list 'IN w 'RR)
                                        (list '<= (list 'ABS xy) w) (list '<= w d1))))
                 (dk-apply! cl y)
                 (ass)))))))))

(sp (make-wff (list 'FORALL 'g (list 'FORALL 'cdx_ (list 'FORALL 'cdl_
  (list 'IMPLIES '(HAS-RIGHT-DERIV-AT g cdx_ cdl_) (cdl-side-form 'cdx_ #t)))))))
(cdl-side-proof! #t)
(qed 'right-deriv-local-bound)
(sp (make-wff (list 'FORALL 'g (list 'FORALL 'cdx_ (list 'FORALL 'cdl_
  (list 'IMPLIES '(HAS-LEFT-DERIV-AT g cdx_ cdl_) (cdl-side-form 'cdx_ #f)))))))
(cdl-side-proof! #f)
(qed 'left-deriv-local-bound)

;;; the one-sided derivatives at every point of [a, b]
(sp (make-wff "forall([g, dg, a, b], has-deriv-on-ccint(g, dg, a, b) implies
   forall([cdx_ in ccint(a, b)], (cdx_ < b implies has-right-deriv-at(g, cdx_, dg(cdx_)))
                              and (a < cdx_ implies has-left-deriv-at(g, cdx_, dg(cdx_)))))"))
(dk-peel!)
(dk-split-all! (dk-landed* (lambda () (mac-h 'HAS-DERIV-ON-CCINT (dk-pick (dk-head? 'HAS-DERIV-ON-CCINT) "hyp")))))
(define cdl-os-int (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'HAS-DERIV-AT))) "interior"))
(define cdl-os-x (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(CCINT a b)))) "x")))
(dk-split-all! (list (dk-cite! 'ccint-parts 'a 'b cdl-os-x)))
(dk-conj-close!
 (lambda ()
   (let* ((g (dk-goal)) (right? (dk-contains? g 'HAS-RIGHT-DERIV-AT)) (x cdl-os-x))
     (dk-peel!)
     (dk-cite! 'rr-le-cases (if right? 'a x) (if right? x 'b))
     (use-cases (if right? (list 'OR (list '< 'a x) (list '= 'a x)) (list 'OR (list '< x 'b) (list '= x 'b)))
       (lambda ()
         (dk-have! (list 'IN x '(OOINT a b))
           (lambda () (mac 'ooint-membership) (dk-conj-close! (lambda () (ass)))))
         (dk-apply! cdl-os-int x)
         (fact (if right? 'has-deriv-at-implies-right 'has-deriv-at-implies-left) 'g x (list 'dg x))
         (ass))
       (lambda ()
         (subst (if right? (list '= x 'a) (list '= x 'b)))
         (ass))))))
(qed 'deriv-on-ccint-one-sided)

;;; continuity on [a, b]
(define cdl-cc-I '(CCINT a b))
(define (cdl-cc-side! x e imp right?)
  ;; the one-sided bound of g at x, on the side of x within [a, b]
  (let ((claim (list 'FORSOME 'cdd_ (list 'AND '(POS-RR cdd_)
                 (list 'FORALL 'cdy_ (list 'IMPLIES (list 'IN 'cdy_ cdl-cc-I)
                   (list 'IMPLIES (if right? (list '<= x 'cdy_) (list '<= 'cdy_ x))
                     (list 'IMPLIES (list '<= (list 'ABS (list '- x 'cdy_)) 'cdd_)
                       (list '<= (list 'ABS (list '- (list 'g x) (list 'g 'cdy_))) e)))))))))
    (dk-have! claim
      (lambda ()
        (dk-cite! 'rr-le-cases (if right? x 'a) (if right? 'b x))
        (use-cases (if right? (list 'OR (list '< x 'b) (list '= x 'b)) (list 'OR (list '< 'a x) (list '= 'a x)))
          (lambda ()
            (detach! imp)
            (let* ((lb (dk-cite! (if right? 'right-deriv-local-bound 'left-deriv-local-bound) 'g x (list 'dg x)))
                   (d (dk-skolem! (dk-apply! lb e)))
                   (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d))) "the side clause")))
              (ew d)
              (dk-conj-close!
               (lambda ()
                 (if (not (dk-head-is? (dk-goal) 'FORALL))
                     (ass)
                     (let* ((ls (dk-peel!))
                            (y (cadr (cdl-find (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cdl-cc-I))) ls "y"))))
                       (fact 'ccint-elt-in-rr 'a 'b y)
                       (dk-apply! cl y)
                       (ass)))))))
          (lambda ()
            (fact 'rr-one-in)
            (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
            (fact 'rr-pos-rr-of-lt 1)
            (ew 1)
            (dk-conj-close!
             (lambda ()
               (if (not (dk-head-is? (dk-goal) 'FORALL))
                   (ass)
                   (let* ((ls (dk-peel!))
                          (y (cadr (cdl-find (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cdl-cc-I))) ls "y")))
                          (gx (list 'g x)))
                     (dk-split-all! (list (dk-cite! 'ccint-parts 'a 'b y)))
                     (dk-have! (if right? (list '<= y x) (list '<= x y))
                       (lambda () (dk-ineq! (list 'IN x 'RR) (list 'IN y 'RR) (list 'IN 'a 'RR) (list 'IN 'b 'RR)
                                            (if right? (list '= x 'b) (list '= 'a x))
                                            (if right? (list '<= y 'b) (list '<= 'a y)))))
                     (cdl-and! (list '<= y x) (list '<= x y))
                     (fact 'ccint-elt-in-rr 'a 'b y)
                     (cdl-and! (list 'IN y 'RR) (list 'IN x 'RR))
                     (dk-cite! 'rr-leq-antisymmetric y x)
                     (subst (list '= y x))
                     (dk-have! (list '= (list '- gx gx) 0) (lambda () (crs)))
                     (subst (list '= (list '- gx gx) 0))
                     (fact 'rr-abs-zero-value)
                     (subst '(= (ABS 0) 0))
                     (fact 'rr-lt-of-pos-rr e)
                     (fact 'rr-pos-rr-in-rr e)
                     (dk-ineq! (list 'IN e 'RR) (list '< 0 e))))))))))
    claim))

(sp (make-wff "forall([g, dg, a, b], has-deriv-on-ccint(g, dg, a, b) implies is-continuous-on(g, ccint(a, b)))"))
(dk-peel!)
(define cdl-cc-h (dk-pick (dk-head? 'HAS-DERIV-ON-CCINT) "hyp"))
(dk-project! '(IN g (FUN (CCINT a b) RR)) 'HAS-DERIV-ON-CCINT cdl-cc-h)
(dk-project! '(IN a RR) 'HAS-DERIV-ON-CCINT cdl-cc-h)
(dk-project! '(IN b RR) 'HAS-DERIV-ON-CCINT cdl-cc-h)
(define cdl-cc-os (dk-cite! 'deriv-on-ccint-one-sided 'g 'dg 'a 'b))
(fact 'ccint-subset-rr 'a 'b)
(dk-have! (list 'FORALL 'cdx_ (list 'IMPLIES (list 'IN 'cdx_ cdl-cc-I) (cdl-absform cdl-cc-I 'g 'cdx_)))
  (lambda ()
    (let* ((x (dk-di-var!))
           (_0 (dk-peel!))
           (e (cadr (dk-pick (dk-head? 'POS-RR) "eps")))
           (both (dk-apply! cdl-cc-os x))
           (_1 (dk-split! both))
           (ri (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-contains? f 'HAS-RIGHT-DERIV-AT))) "right"))
           (li (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-contains? f 'HAS-LEFT-DERIV-AT))) "left")))
      (dk-split-all! (list (dk-cite! 'ccint-parts 'a 'b x)))
      (fact 'fun-apply-type-c 'g cdl-cc-I 'RR x)
      (let* ((cr (cdl-cc-side! x e ri #t))
             (dr (dk-skolem! cr))
             (clr (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f dr))) "right clause"))
             (cl (cdl-cc-side! x e li #f))
             (dl (dk-skolem! cl))
             (cll (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f dl))) "left clause")))
        (fact 'rr-pos-rr-in-rr dr) (fact 'rr-lt-of-pos-rr dr)
        (fact 'rr-pos-rr-in-rr dl) (fact 'rr-lt-of-pos-rr dl)
        (let ((w (dk-skolem! (dk-cite! 'rr-min-pos dr dl))))
          (fact 'rr-pos-rr-of-lt w)
          (ew w)
          (dk-conj-close!
           (lambda ()
             (if (not (dk-head-is? (dk-goal) 'FORALL))
                 (ass)
                 (let* ((ls (dk-peel!))
                        (y (cadr (cdl-find (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cdl-cc-I))) ls "y")))
                        (xy (list '- x y)))
                   (fact 'ccint-elt-in-rr 'a 'b y)
                   (fact 'rr-sub-in-rr x y)
                   (fact 'rr-abs-closed xy)
                   (cdl-and! (list 'IN x 'RR) (list 'IN y 'RR))
                   (dk-cite! 'rr-leq-total x y)
                   (use-cases (list 'OR (list '<= x y) (list '<= y x))
                     (lambda ()
                       (dk-have! (list '<= (list 'ABS xy) dr)
                         (lambda () (dk-ineq! (list 'IN (list 'ABS xy) 'RR) (list '<= (list 'ABS xy) w) (list '<= w dr))))
                       (dk-apply! clr y)
                       (ass))
                     (lambda ()
                       (dk-have! (list '<= (list 'ABS xy) dl)
                         (lambda () (dk-ineq! (list 'IN (list 'ABS xy) 'RR) (list '<= (list 'ABS xy) w) (list '<= w dl))))
                       (dk-apply! cll y)
                       (ass))))))))))))
(dk-cite! 'continuous-on-abs-bwd cdl-cc-I 'g)
(ass)
(qed 'deriv-on-ccint-continuous)

(define (cdl-prim-close!)
  (let ((g (dk-goal)))
    (cond ((dk-head-is? g 'FORSOME) (ew 'EMPTY-SET) (dk-conj-close! cdl-prim-close!))
          ((dk-head-is? g 'IS-COUNTABLE) (fact 'countable-empty) (ass))
          ((dk-head-is? g 'SUBSET) (fact 'empty-subset-any '(CCINT a b)) (ass))
          ((dk-head-is? g 'FORALL)
           (let ((t (dk-di-var!)))
             (dk-peel!)
             (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'HAS-DERIV-AT))) "interior") t)
             (ass)))
          (#t (ass)))))
(sp (make-wff "forall([g, dg, a, b], has-deriv-on-ccint(g, dg, a, b) implies is-primitive(g, dg, a, b))"))
(dk-peel!)
(fact 'deriv-on-ccint-continuous 'g 'dg 'a 'b)
(dk-split-all! (dk-landed* (lambda () (mac-h 'HAS-DERIV-ON-CCINT (dk-pick (dk-head? 'HAS-DERIV-ON-CCINT) "hyp")))))
(mac 'IS-PRIMITIVE)
(dk-conj-close! cdl-prim-close!)
(qed 'deriv-on-ccint-primitive)

;;; =====================================================================
;;; (4) A DERIVATIVE WITHIN W FROM A LITTLE-O BOUND: the proof of calc2-segment's
;;; has-deriv-at-of-eps-bound, for an arbitrary W subset RR containing c.
;;; =====================================================================

(define cdw-W 'ew_)
(define (cdw-err t) (list '- (list '- (list 'eg_ t) '(eg_ ec_)) (list '* (list '- t 'ec_) 'el_)))
(define cdw-eb
  (list 'FORALL 'ee_ (list 'IMPLIES '(POS-RR ee_)
    (list 'FORSOME 'ed_ (list 'AND '(POS-RR ed_)
      (list 'FORALL 'et_ (list 'IMPLIES (list 'IN 'et_ cdw-W)
        (list 'IMPLIES '(< (abs (- et_ ec_)) ed_)
          (list '<= (list 'abs (cdw-err 'et_)) '(* ee_ (abs (- et_ ec_))))))))))))
(sp (make-wff (forall-guarded '(eg_ ec_ ew_ el_)
  (list '(SUBSET ew_ RR) '(IN ec_ ew_) '(IN el_ RR)
        (list 'FORALL 'et_ (list 'IMPLIES (list 'IN 'et_ cdw-W) '(IN (eg_ et_) RR)))
        cdw-eb)
  '(HAS-DERIV-AT-WITHIN eg_ ew_ ec_ el_))))
(dk-peel!)
(fact 'subset-mem-fwd 'ew_ 'RR 'ec_)
(define cdw-gty (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (not (dk-contains? f 'ee_)))) "g typing"))
(define cdw-ebf (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ee_))) "the bound"))
(fact 'rr-is-set)
(dk-cite! 'subclass-of-set-is-set cdw-W 'RR)
(fact 'rr-is-metric-space)
(fact 'r7q-rr-pts)
(dk-have! (list 'SUBSET cdw-W '(PTS RR-MS)) (lambda () (subst '(= (PTS RR-MS) RR)) (ass)))
(dk-cite! 'subspace-is-metric-space 'RR-MS cdw-W)
(dk-cite! 'subspace-pts 'RR-MS cdw-W)
(dk-apply! cdw-gty 'ec_)
(define (cdw-quot v) (list '* (list '- (list 'eg_ v) '(eg_ ec_)) (list 'recip (list '- v 'ec_))))
(define (cdw-ift v) (list 'IF (list '= v 'ec_) 'el_ (cdw-quot v)))
(define cdw-phi (list 'VNB-LAMBDA 'hpv_ cdw-W (cdw-ift 'hpv_)))
;;; v in W, v /= c: v - c /= 0, recip(v - c) real, q(v) real, (v - c) recip(v - c) = 1
(define (cdw-nz! v)
  (let ((d (list '- v 'ec_)))
    (fact 'subset-mem-fwd 'ew_ 'RR v)
    (dk-apply! cdw-gty v)
    (dk-type! d)
    (dk-have! (list 'NOT (list '= d 0))
      (lambda ()
        (di)
        (dk-have! (list '= v 'ec_)
          (lambda ()
            (dk-have! (list '= v (list '+ d 'ec_)) (lambda () (crs)))
            (subst (list '= v (list '+ d 'ec_)))
            (subst (list '= d 0))
            (crs)))
        (ai (list 'NOT (list '= v 'ec_)))))
    (cdl-and! (list 'IN d 'RR) (list 'NOT (list '= d 0)))
    (dk-cite! 'rr-recip-closed d)
    (dk-cite! 'rr-recip-inverse d)
    (dk-type! (list '- (list 'eg_ v) '(eg_ ec_)))
    (cdl-and! (list 'IN (list '- (list 'eg_ v) '(eg_ ec_)) 'RR) (list 'IN (list 'recip d) 'RR))
    (dk-cite! 'rr-mul-closed (list '- (list 'eg_ v) '(eg_ ec_)) (list 'recip d))))
;;; the factor is real on W, so phi is a function W -> RR
(define cdw-pt
  (list 'FORALL 'hpv_ (list 'IMPLIES (list 'IN 'hpv_ cdw-W) (list 'IN (cdw-ift 'hpv_) 'RR))))
(dk-have! cdw-pt
  (lambda ()
    (let ((v (dk-di-var!)))
      (use-em (list '= v 'ec_)
        (lambda () (dk-if-branch! #t (cdw-ift v) #f (lambda () (ass))))
        (lambda () (cdw-nz! v) (dk-if-branch! #f (cdw-ift v) #f (lambda () (ass))))))))
(dk-have! (list 'IN cdw-phi (list 'FUN cdw-W 'RR))
  (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (dk-apply! cdw-pt v) (ass))) (lambda () (ass)))))
(define cdw-pa (list '= (list cdw-phi 'ec_) 'el_))
(dk-have! cdw-pa
  (lambda () (dk-lam-b!) (dk-if-branch! #t (cdw-ift 'ec_) (lambda () (rfl)) (lambda () (rfl)))))
;;; the restriction of g to W is a function W -> RR
(dk-have! (list 'IN (list 'RESTRICT 'eg_ cdw-W) (list 'FUN cdw-W 'RR))
  (lambda () (mac 'RESTRICT)
    (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (dk-apply! cdw-gty v) (ass))) (lambda () (ass)))))
;;; continuity of phi at c
(define (cdw-cont-eps!)
  (dk-peel!)
  (let* ((eps (cadr (dk-pick (lambda (f) (dk-head-is? f 'POS-RR)) "eps")))
         (d1 (dk-skolem! (dk-apply! cdw-ebf eps) #t))
         (eb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d1))) "the bound at eps")))
    (dk-cite! 'rr-pos-rr-in-rr eps) (dk-cite! 'rr-lt-of-pos-rr eps)
    (dk-cite! 'rr-pos-rr-in-rr d1) (dk-cite! 'rr-lt-of-pos-rr d1)
    (let ((del (dk-halve! d1)))
      (ew del)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-head-is? (dk-goal) 'FORALL)) (ass)
            (let* ((b (begin (dk-peel!) (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cdw-W)
                                                                        (not (eq? (cadr f) 'ec_)))) "b"))))
                   (dh (dk-pick (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f 'DIST))) "the distance hypothesis"))
                   (dsub (dk-cite! 'subspace-dist 'RR-MS cdw-W 'ec_ b))
                   (h1 (dk-rewrite-h! dh (cadr dsub) (caddr dsub)))
                   (dk1 (begin (fact 'subset-mem-fwd 'ew_ 'RR b) (dk-cite! 'rr-ms-dist 'ec_ b)))
                   (h2 (dk-rewrite-h! h1 (cadr dk1) (caddr dk1)))
                   (dba (list 'abs (list '- b 'ec_))))
              (dk-type! (list '- 'ec_ b)) (dk-type! (list '- b 'ec_))
              (dk-cite! 'rr-abs-closed (list '- 'ec_ b)) (dk-cite! 'rr-abs-closed (list '- b 'ec_))
              (dk-cite! 'rr-abs-sub-sym 'ec_ b)
              (dk-have! (list '< dba d1)
                (lambda () (subst (list '= dba (list 'abs (list '- 'ec_ b))))
                  (dk-ineq! h2 (list '= (list '+ del del) d1) (list '< 0 del))))
              (subst cdw-pa)
              (dk-lam-b!)
              (let ((pb (cdw-ift b)))
                (dk-apply! cdw-pt b)
                (subst (dk-cite! 'rr-ms-dist 'el_ pb))
                (use-em (list '= b 'ec_)
                  (lambda ()
                    (dk-if-branch! #t pb #f (lambda ()
                      (dk-have! '(= (- el_ el_) 0) (lambda () (crs)))
                      (subst '(= (- el_ el_) 0))
                      (fact 'rr-abs-zero-value) (subst '(= (abs 0) 0))
                      (dk-ineq! (list '< 0 eps)))))
                  (lambda ()
                    (cdw-nz! b)
                    (dk-if-branch! #f pb #f (lambda ()
                      (let* ((q (cdw-quot b)) (lq (list '- 'el_ q)) (d (list '- b 'ec_)) (e (cdw-err b))
                             (mlq (list 'abs lq)))
                        (dk-type! lq) (dk-type! e)
                        (dk-cite! 'rr-abs-closed lq) (dk-cite! 'rr-abs-closed e)
                        (dk-have! (list '= (list '* lq d) (list '- e))
                          (lambda ()
                            (let ((ex (list '- (list '* 'el_ d)
                                               (list '* (list '- (list 'eg_ b) '(eg_ ec_)) (list '* d (list 'recip d))))))
                              (dk-have! (list '= (list '* lq d) ex) (lambda () (dk-crs-opaque!)))
                              (subst (list '= (list '* lq d) ex))
                              (subst (list '= (list '* d (list 'recip d)) 1))
                              (crs))))
                        (cdl-and! (list 'IN lq 'RR) (list 'IN d 'RR))
                        (dk-cite! 'rr-abs-mult lq d)
                        (dk-cite! 'rr-abs-neg e)
                        (dk-apply! eb b)
                        (dk-type! (list '* mlq dba)) (dk-type! (list '* eps dba))
                        (dk-have! (list '<= (list '* mlq dba) (list '* eps dba))
                          (lambda ()
                            (subst (list '= (list '* mlq dba) (list 'abs (list '* lq d))))
                            (subst (list '= (list '* lq d) (list '- e)))
                            (subst (list '= (list 'abs (list '- e)) (list 'abs e)))
                            (ass)))
                        ;; |b - c| > 0: cancel it
                        (dk-cite! 'rr-abs-nonneg d)
                        (dk-have! (list 'NOT (list '= dba 0))
                          (lambda () (di) (dk-meta-iff-r! (dk-cite! 'rr-abs-zero d)) (ai (list 'NOT (list '= d 0)))))
                        (dk-cite! 'neq-sym dba 0)
                        (cdl-and! (list '<= 0 dba) (list 'NOT (list '= 0 dba)))
                        (dk-cite! 'rr-le-ne-lt 0 dba)
                        (dk-cite! 'rr-mul-le-cancel-pos mlq dba eps)
                        (ass))))))))))))))
(dk-have! (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS 'RR-MS cdw-W) 'RR-MS cdw-phi 'ec_)
  (lambda ()
    (mac 'IS-CONTINUOUS-AT)
    (subst (list '= (list 'PTS (list 'SUBSPACE-MS 'RR-MS cdw-W)) cdw-W))
    (subst '(= (PTS RR-MS) RR))
    (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'FORALL) (cdw-cont-eps!) (ass))))))
;;; the identity g(t) - g(c) = phi(t) (t - c) on W
(dk-have! (list 'FORALL 'ost_ (list 'IMPLIES (list 'IN 'ost_ cdw-W)
            (list '= '(- (eg_ ost_) (eg_ ec_)) (list '* (list cdw-phi 'ost_) '(- ost_ ec_)))))
  (lambda ()
    (let* ((t (dk-di-var!)) (pt (cdw-ift t)))
      (dk-apply! cdw-pt t)
      (dk-lam-b!)
      (use-em (list '= t 'ec_)
        (lambda () (dk-if-branch! #t pt #f (lambda () (subst (list '= t 'ec_)) (crs))))
        (lambda ()
          (cdw-nz! t)
          (dk-if-branch! #f pt #f (lambda ()
            (let* ((d (list '- t 'ec_))
                   (ex (list '* (list '- (list 'eg_ t) '(eg_ ec_)) (list '* d (list 'recip d)))))
              (dk-have! (list '= (list '* (cdw-quot t) d) ex) (lambda () (dk-crs-opaque!)))
              (subst (list '= (list '* (cdw-quot t) d) ex))
              (subst (list '= (list '* d (list 'recip d)) 1))
              (crs)))))))))
(fact 'subset-mem-fwd 'ew_ 'RR 'ec_)
(mac 'HAS-DERIV-AT-WITHIN)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'FORSOME)
        (begin (ew cdw-phi) (dk-conj-close! (lambda () (ass))))
        (ass))))
(qed 'deriv-within-of-eps-bound)

;;; =====================================================================
;;; (5) THE FUNDAMENTAL THEOREM ON [a, b].
;;; (5a) the little-o bound at t of a primitive g of a function ps continuous on [a, b]: on the
;;; interval between t and x, g and the affine y |-> ps(t) y are primitives of ps and of the
;;; constant ps(t), which differ by at most eps there (primitive-pair-lipschitz-abs).
;;; =====================================================================
(define cdl-I '(CCINT a b))
(define (cdl-eb-form w c l)
  (list 'FORALL 'ee_ (list 'IMPLIES '(POS-RR ee_)
    (list 'FORSOME 'ed_ (list 'AND '(POS-RR ed_)
      (list 'FORALL 'et_ (list 'IMPLIES (list 'IN 'et_ w)
        (list 'IMPLIES (list '< (list 'ABS (list '- 'et_ c)) 'ed_)
          (list '<= (list 'ABS (list '- (list '- '(g et_) (list 'g c)) (list '* (list '- 'et_ c) l)))
                (list '* 'ee_ (list 'ABS (list '- 'et_ c))))))))))))
(define (cdl-in-cc! z lo hi prems)
  (dk-have! (list 'IN z (list 'CCINT lo hi))
    (lambda () (mac 'ccint-membership)
      (dk-conj-close! (lambda () (if (dk-ctx-form (dk-goal)) (ass) (apply dk-ineq! prems)))))))

;;; the strict case of (5a), on [lo, hi] with {lo, hi} = {t, x}
(define (cdl-b2-side! lo hi x t e d0 c0)
  (let* ((pst (list 'ps t)) (gt (list 'g t)) (gx (list 'g x)) (xt (list '- x t))
         (RG (list 'RESTRICT 'g (list 'CCINT lo hi)))
                    (RP (list 'RESTRICT 'ps (list 'CCINT lo hi)))
                    (L (list 'VNB-LAMBDA 'cdq_ (list 'CCINT lo hi) (list '+ 0 (list '* pst 'cdq_))))
                    (C (list 'VNB-LAMBDA 'cdq_ (list 'CCINT lo hi) pst))
                    (prem (list (list 'IN 'a 'RR) (list 'IN 'b 'RR) (list 'IN x 'RR) (list 'IN t 'RR)
                                (list '<= 'a x) (list '<= x 'b) (list '<= 'a t) (list '<= t 'b) (list '< lo hi))))
               (dk-have! (list '<= 'a lo) (lambda () (apply dk-ineq! prem)))
               (dk-have! (list '<= hi 'b) (lambda () (apply dk-ineq! prem)))
               (dk-cite! 'pw-antiderivative-restrict 'a 'b lo hi 'g 'ps)
               (fact 'rr-is-set)
               (fact 'ccint-subset-rr lo hi)
               (dk-cite! 'subclass-of-set-is-set (list 'CCINT lo hi) 'RR)
               (dk-have! (list 'IN L (list 'FUN (list 'CCINT lo hi) 'RR))
                 (lambda () (dk-lam-type! (lambda ()
                   (let ((y (dk-di-var!)))
                     (fact 'ccint-elt-in-rr lo hi y)
                     (fact 'rr-mul-in-rr pst y)
                     (fact 'rr-zero-in)
                     (fact 'rr-add-in-rr 0 (list '* pst y))
                     (ass))))))
               (dk-have! (list 'IN C (list 'FUN (list 'CCINT lo hi) 'RR))
                 (lambda () (dk-lam-type! (lambda () (dk-di-var!) (ass)))))
               (let ((af (dk-cite! 'pw-affine-antiderivative lo hi)))
                 (fact 'rr-zero-in)
                 (dk-have! (list 'FORALL 'pay_ (list 'IMPLIES (list 'IN 'pay_ (list 'CCINT lo hi))
                             (list '== (list L 'pay_) (list '+ 0 (list '* pst 'pay_)))))
                   (lambda () (let ((y (dk-di-var!))) (fact 'ccint-elt-in-rr lo hi y) (dk-lam-b!) (qrfl))))
                 (dk-have! (list 'FORALL 'pay_ (list 'IMPLIES (list 'IN 'pay_ (list 'CCINT lo hi))
                             (list '== (list C 'pay_) pst)))
                   (lambda () (let ((y (dk-di-var!))) (fact 'ccint-elt-in-rr lo hi y) (dk-lam-b!) (qrfl))))
                 (dk-apply! af 0 pst L C))
               ;; the integrands differ by at most eps on [lo, hi]
               (dk-have! (list 'FORALL 'pux_ (list 'IMPLIES (list 'IN 'pux_ (list 'CCINT lo hi))
                           (list '<= (list 'ABS (list '- (list RP 'pux_) (list C 'pux_))) e)))
                 (lambda ()
                   (let* ((y (dk-di-var!)) (psy (list 'ps y)) (ty (list '- t y)))
                     (dk-split-all! (list (dk-cite! 'ccint-parts lo hi y)))
                     (cdl-in-cc! y 'a 'b (append (list (list 'IN y 'RR) (list '<= lo y) (list '<= y hi)
                                                       (list '<= 'a lo) (list '<= hi 'b)) prem))
                     (fact 'fun-apply-type-c 'ps cdl-I 'RR y)
                     (fact 'restrict-apply 'ps (list 'CCINT lo hi) y)
                     (subst (list '== (list RP y) psy))
                     (dk-lam-b!)
                     (fact 'rr-sub-in-rr t y)
                     (let ((pp (append (list (list 'IN y 'RR) (list '<= lo y) (list '<= y hi) (list 'IN d0 'RR)
                                             (list '< (list '- d0) xt) (list '< xt d0)) prem)))
                       (dk-have! (list '<= (list '- d0) ty) (lambda () (apply dk-ineq! pp)))
                       (dk-have! (list '<= ty d0) (lambda () (apply dk-ineq! pp))))
                     (dk-cite! 'rr-abs-le-of-parts ty d0)
                     (dk-apply! c0 y)
                     (fact 'rr-abs-sub-sym psy pst)
                     (subst (list '= (list 'ABS (list '- psy pst)) (list 'ABS (list '- pst psy))))
                     (ass))))
               (fact 'rr-pos-rr-in-rr e)
               (let ((lip (dk-cite! 'primitive-pair-lipschitz-abs lo hi RG RP L C e)))
                 (cdl-in-cc! x lo hi (cons (list '<= lo hi) prem))
                 (cdl-in-cc! t lo hi (cons (list '<= lo hi) prem))
                 (let* ((inst (dk-apply! lip t x))
                        (target (cadr (cadr inst))))
                   (fact 'restrict-apply 'g (list 'CCINT lo hi) x)
                   (fact 'restrict-apply 'g (list 'CCINT lo hi) t)
                   (dk-have! (list '= (list '- (list '- gx gt) (list '* xt pst)) target)
                     (lambda ()
                       (subst (list '== (list RG x) gx))
                       (subst (list '== (list RG t) gt))
                       (dk-lam-b!)
                       (crs)))
                   (subst (list '= (list '- (list '- gx gt) (list '* xt pst)) target))
                   (ass)))))

;;; the case x = t of (5a): both sides are 0
(define (cdl-b2-eq! x t e)
  (let* ((gt (list 'g t)) (pst (list 'ps t)))
    (subst (list '= x t))
    (dk-have! (list '= (list '- (list '- gt gt) (list '* (list '- t t) pst)) 0) (lambda () (crs)))
    (subst (list '= (list '- (list '- gt gt) (list '* (list '- t t) pst)) 0))
    (dk-have! (list '= (list '- t t) 0) (lambda () (crs)))
    (subst (list '= (list '- t t) 0))
    (fact 'rr-abs-zero-value)
    (subst '(= (ABS 0) 0))
    (dk-have! (list '= (list '* e 0) 0) (lambda () (crs)))
    (subst (list '= (list '* e 0) 0))
    (fact 'rr-zero-in)
    (dk-ineq! '(IN 0 RR))))

(sp (make-wff (list 'FORALL 'g (list 'FORALL 'ps (list 'FORALL 'a (list 'FORALL 'b
  (list 'IMPLIES '(IS-PRIMITIVE g ps a b)
    (list 'IMPLIES (list 'IS-CONTINUOUS-ON 'ps cdl-I)
      (list 'FORALL 'cdt_ (list 'IMPLIES (list 'IN 'cdt_ cdl-I)
        (cdl-eb-form cdl-I 'cdt_ '(ps cdt_))))))))))))
(dk-peel!)
(define cdl-b2-pr (dk-pick (dk-head? 'IS-PRIMITIVE) "the primitive"))
(dk-project! '(IN a RR) 'IS-PRIMITIVE cdl-b2-pr)
(dk-project! '(IN b RR) 'IS-PRIMITIVE cdl-b2-pr)
(fact 'primitive-in-fun 'g 'ps 'a 'b)
(fact 'primitive-integrand-in-fun 'g 'ps 'a 'b)
(fact 'ccint-subset-rr 'a 'b)
(let* ((t (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cdl-I))) "t")))
       (e (cadr (dk-pick (dk-head? 'POS-RR) "eps")))
       (pst (list 'ps t)) (gt (list 'g t))
       (ca (dk-cite! 'continuous-on-abs-fwd cdl-I 'ps))
       (d0 (dk-skolem! (dk-apply! ca t e)))
       (c0 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d0))) "the continuity clause")))
  (dk-split-all! (list (dk-cite! 'ccint-parts 'a 'b t)))
  (fact 'fun-apply-type-c 'ps cdl-I 'RR t)
  (fact 'fun-apply-type-c 'g cdl-I 'RR t)
  (fact 'rr-pos-rr-in-rr e) (fact 'rr-lt-of-pos-rr e)
  (fact 'rr-pos-rr-in-rr d0)
  (ew d0)
  (dk-conj-close!
   (lambda ()
     (if (not (dk-head-is? (dk-goal) 'FORALL))
         (ass)
         (let* ((ls (dk-peel!))
                (x (cadr (cdl-find (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cdl-I))) ls "x")))
                (gx (list 'g x)) (xt (list '- x t)))
           (dk-split-all! (list (dk-cite! 'ccint-parts 'a 'b x)))
           (fact 'fun-apply-type-c 'g cdl-I 'RR x)
           (fact 'rr-sub-in-rr x t)
           (dk-split-all! (list (dk-cite! 'rr-abs-lt-parts xt d0)))
           (cdl-and! (list 'IN t 'RR) (list 'IN x 'RR))
           (dk-cite! 'rr-leq-total t x)
           (use-cases (list 'OR (list '<= t x) (list '<= x t))
             (lambda ()
               (dk-cite! 'rr-le-cases t x)
               (use-cases (list 'OR (list '< t x) (list '= t x))
                 (lambda () (cdl-b2-side! t x x t e d0 c0))
                 (lambda () (cdl-b2-eq! x t e))))
             (lambda ()
               (dk-cite! 'rr-le-cases x t)
               (use-cases (list 'OR (list '< x t) (list '= x t))
                 (lambda () (cdl-b2-side! x t x t e d0 c0))
                 (lambda () (cdl-b2-eq! x t e))))))))))
(qed 'primitive-continuous-eps-bound)

;;; (5b) a primitive of a function continuous on [a, b] has it as its derivative on [a, b]
(define (cdl-memb! z w)
  ;; z in w (an interval inside [a, b] given by the context bounds): land z in RR, z in [a, b]
  (let* ((hd (car w))
         (mem (case hd ((OOINT) 'ooint-membership) ((COINT) 'coint-membership) ((OCINT) 'ocint-membership)
                (else (error "cdl-memb!: interval kind" w))))
         (iff (dk-cite! mem (cadr w) (caddr w) z)))
    (dk-split-all! (list (dk-meta-iff-r! iff)))))
(define (cdl-tsubst v z t)
  (cond ((eq? t v) z) ((pair? t) (map (lambda (u) (cdl-tsubst v z u)) t)) (#t t)))
(define (cdl-w-facts! w prems0)
  (let ((typ (list 'FORALL 'et_ (list 'IMPLIES (list 'IN 'et_ w) '(IN (g et_) RR)))))
    (dk-have! typ
      (lambda ()
        (let* ((z (dk-di-var!)) (prems (cons (list 'IN z 'RR) (cdl-tsubst 'et_ z prems0))))
          (cdl-memb! z w)
          (cdl-in-cc! z 'a 'b prems)
          (fact 'fun-apply-type-c 'g cdl-I 'RR z)
          (ass))))))
(define (cdl-eb-on! w c ebt prems0)
  (dk-have! (cdl-eb-form w c (list 'ps c))
    (lambda ()
      (dk-peel!)
      (let* ((ee (cadr (dk-pick (dk-head? 'POS-RR) "ee")))
             (ed (dk-skolem! (dk-apply! ebt c ee)))
             (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ed))) "the bound clause")))
        (ew ed)
        (dk-conj-close!
         (lambda ()
           (if (not (dk-head-is? (dk-goal) 'FORALL))
               (ass)
               (let* ((ls (dk-peel!))
                      (z (cadr (cdl-find (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) w))) ls "et")))
                      (prems (cons (list 'IN z 'RR) (cdl-tsubst 'et_ z prems0))))
                 (cdl-memb! z w)
                 (cdl-in-cc! z 'a 'b prems)
                 (dk-apply! cl z)
                 (ass)))))))))

(sp (make-wff "forall([g, ps, a, b], is-primitive(g, ps, a, b) implies is-continuous-on(ps, ccint(a, b))
   implies has-deriv-on-ccint(g, ps, a, b))"))
(dk-peel!)
(define cdl-b3-pr (dk-pick (dk-head? 'IS-PRIMITIVE) "the primitive"))
(dk-project! '(IN a RR) 'IS-PRIMITIVE cdl-b3-pr)
(dk-project! '(IN b RR) 'IS-PRIMITIVE cdl-b3-pr)
(dk-project! '(< a b) 'IS-PRIMITIVE cdl-b3-pr)
(fact 'primitive-in-fun 'g 'ps 'a 'b)
(fact 'primitive-integrand-in-fun 'g 'ps 'a 'b)
(fact 'ccint-subset-rr 'a 'b)
(define cdl-b3-eb (dk-cite! 'primitive-continuous-eps-bound 'g 'ps 'a 'b))
(fact 'rr-sub-in-rr 'b 'a)
(dk-have! '(< 0 (- b a)) (lambda () (dk-ineq! '(IN a RR) '(IN b RR) '(< a b))))
(fact 'rr-pos-rr-of-lt '(- b a))
(mac 'HAS-DERIV-ON-CCINT)
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
      ((dk-head-is? g 'FORALL)
       (let* ((t (dk-di-var!)))
         (cdl-memb! t '(OOINT a b))
         (fact 'rr-sub-in-rr t 'a) (fact 'rr-sub-in-rr 'b t)
         (dk-have! (list '< 0 (list '- t 'a)) (lambda () (dk-ineq! (list 'IN t 'RR) '(IN a RR) (list '< 'a t))))
         (dk-have! (list '< 0 (list '- 'b t)) (lambda () (dk-ineq! (list 'IN t 'RR) '(IN b RR) (list '< t 'b))))
         (let* ((r (dk-skolem! (dk-cite! 'rr-min-pos (list '- t 'a) (list '- 'b t))))
                (w (list 'OOINT (list '- t r) (list '+ t r)))
                (prems (list '(IN a RR) '(IN b RR) (list 'IN t 'RR) (list 'IN r 'RR) (list '< 0 r)
                             (list '<= r (list '- t 'a)) (list '<= r (list '- 'b t))
                             (list '< (list '- t r) 'et_) (list '< 'et_ (list '+ t r)))))
           (fact 'rr-pos-rr-of-lt r)
           (cdl-in-cc! t 'a 'b (list (list 'IN t 'RR) '(IN a RR) '(IN b RR) (list '< 'a t) (list '< t 'b)))
           (fact 'fun-apply-type-c 'ps cdl-I 'RR t)
           (cdl-w-facts! w prems)
           (cdl-eb-on! w t cdl-b3-eb prems)
           (dk-cite! 'has-deriv-at-of-eps-bound 'g t r (list 'ps t))
           (ass))))
      ((dk-head-is? g 'HAS-RIGHT-DERIV-AT)
       (let* ((r '(- b a)) (w (list 'COINT 'a (list '+ 'a r)))
              (prems (list '(IN a RR) '(IN b RR) '(< a b) '(<= a et_) (list '< 'et_ (list '+ 'a r)))))
         (fact 'coint-subset-rr 'a (list '+ 'a r))
         (fact 'rr-leq-reflexive 'a)
         (dk-have! (list 'IN 'a w)
           (lambda () (mac 'coint-membership) (dk-conj-close! (lambda () (if (dk-ctx-form (dk-goal)) (ass) (dk-ineq! '(IN a RR) '(IN b RR) '(< a b)))))))
         (cdl-in-cc! 'a 'a 'b (list '(IN a RR) '(IN b RR) '(< a b)))
         (fact 'fun-apply-type-c 'ps cdl-I 'RR 'a)
         (cdl-w-facts! w prems)
         (cdl-eb-on! w 'a cdl-b3-eb prems)
         (dk-cite! 'deriv-within-of-eps-bound 'g 'a w '(ps a))
         (dk-cite! 'has-right-deriv-at-intro 'g 'a '(ps a) r)
         (ass)))
      ((dk-head-is? g 'HAS-LEFT-DERIV-AT)
       (let* ((r '(- b a)) (w (list 'OCINT (list '- 'b r) 'b))
              (prems (list '(IN a RR) '(IN b RR) '(< a b) (list '< (list '- 'b r) 'et_) '(<= et_ b))))
         (fact 'ocint-subset-rr (list '- 'b r) 'b)
         (fact 'rr-leq-reflexive 'b)
         (dk-have! (list 'IN 'b w)
           (lambda () (mac 'ocint-membership) (dk-conj-close! (lambda () (if (dk-ctx-form (dk-goal)) (ass) (dk-ineq! '(IN a RR) '(IN b RR) '(< a b)))))))
         (cdl-in-cc! 'b 'a 'b (list '(IN a RR) '(IN b RR) '(< a b)))
         (fact 'fun-apply-type-c 'ps cdl-I 'RR 'b)
         (cdl-w-facts! w prems)
         (cdl-eb-on! w 'b cdl-b3-eb prems)
         (dk-cite! 'deriv-within-of-eps-bound 'g 'b w '(ps b))
         (dk-cite! 'has-left-deriv-at-intro 'g 'b '(ps b) r)
         (ass)))
      (#t (ass))))))
(qed 'primitive-continuous-deriv-on-ccint)

;;; =====================================================================
;;; (6) A UNIFORM LIMIT OF FUNCTIONS CONTINUOUS ON [a, b] IS CONTINUOUS ON [a, b] (eps/4 x 3).
;;; =====================================================================
(define (cdl-unif dfam ps)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'n (list 'AND '(IN n NN)
      (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
        (list 'IMPLIES '(<= n k)
          (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x cdl-I)
            (list '<= (list 'ABS (list '- (list ps 'x) (list (list dfam 'k) 'x))) 'eps)))))))))))
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'b (list 'FORALL 'dfam (list 'FORALL 'psi
  (list 'IMPLIES (list 'IN 'dfam (list 'FUN 'NN (list 'FUN cdl-I 'RR)))
    (list 'IMPLIES (list 'IN 'psi (list 'FUN cdl-I 'RR))
      (list 'IMPLIES (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IS-CONTINUOUS-ON '(dfam k) cdl-I)))
        (list 'IMPLIES (cdl-unif 'dfam 'psi)
          (list 'IS-CONTINUOUS-ON 'psi cdl-I)))))))))))
(dk-peel!)
(define cdl-u-hc (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-CONTINUOUS-ON))) "continuity"))
(define cdl-u-hu (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR))) "uniform"))
(fact 'ccint-subset-rr 'a 'b)
(dk-have! (list 'FORALL 'cdx_ (list 'IMPLIES (list 'IN 'cdx_ cdl-I) (cdl-absform cdl-I 'psi 'cdx_)))
  (lambda ()
    (let* ((x (dk-di-var!))
           (_0 (dk-peel!))
           (e (cadr (dk-pick (dk-head? 'POS-RR) "eps")))
           (h (dk-halve! e))
           (q (dk-halve! h))
           (n (dk-skolem! (dk-apply! cdl-u-hu q)))
           (cu (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n))) "the uniform clause"))
           (fk (list 'dfam n)))
      (fact 'nn-in-rr n)
      (fact 'rr-leq-reflexive n)
      (fact 'fun-apply-type-c 'dfam 'NN (list 'FUN cdl-I 'RR) n)
      (dk-apply! cdl-u-hc n)
      (let* ((ca (dk-cite! 'continuous-on-abs-fwd cdl-I fk))
             (d (dk-skolem! (dk-apply! ca x q)))
             (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d))) "the continuity clause")))
        (ew d)
        (dk-conj-close!
         (lambda ()
           (if (not (dk-head-is? (dk-goal) 'FORALL))
               (ass)
               (let* ((ls (dk-peel!))
                      (y (cadr (cdl-find (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cdl-I))) ls "y")))
                      (px (list 'psi x)) (py (list 'psi y)) (fx (list fk x)) (fy (list fk y)))
                 (dk-apply! cl y)
                 (dk-apply! cu n x)
                 (dk-apply! cu n y)
                 (for-each (lambda (z) (fact 'fun-apply-type-c 'psi cdl-I 'RR z) (fact 'fun-apply-type-c fk cdl-I 'RR z))
                           (list x y))
                 (fact 'rr-sub-in-rr px fx) (fact 'rr-sub-in-rr py fy) (fact 'rr-sub-in-rr fx fy) (fact 'rr-sub-in-rr px py)
                 (fact 'rr-pos-rr-in-rr q) (fact 'rr-pos-rr-in-rr h) (fact 'rr-pos-rr-in-rr e)
                 (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list '- px fx) q)))
                 (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list '- py fy) q)))
                 (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list '- fx fy) q)))
                 (let ((prem (list (list 'IN px 'RR) (list 'IN py 'RR) (list 'IN fx 'RR) (list 'IN fy 'RR)
                                   (list 'IN q 'RR) (list 'IN h 'RR) (list 'IN e 'RR)
                                   (list '= (list '+ q q) h) (list '= (list '+ h h) e) (list '< 0 q)
                                   (list '<= (list '- q) (list '- px fx)) (list '<= (list '- px fx) q)
                                   (list '<= (list '- q) (list '- py fy)) (list '<= (list '- py fy) q)
                                   (list '<= (list '- q) (list '- fx fy)) (list '<= (list '- fx fy) q))))
                   (dk-have! (list '<= (list '- e) (list '- px py)) (lambda () (apply dk-ineq! prem)))
                   (dk-have! (list '<= (list '- px py) e) (lambda () (apply dk-ineq! prem))))
                 (dk-cite! 'rr-abs-le-of-parts (list '- px py) e)
                 (ass)))))))))
(dk-cite! 'continuous-on-abs-bwd cdl-I 'psi)
(ass)
(qed 'uniform-limit-continuous-on-ccint)

;;; =====================================================================
;;; (7) calculus.pdf Prop 4.16.  f_k' defined and continuous on [a, b], f_k(a) convergent, f_k' -> psi
;;; uniformly on [a, b]  ==>  f(x) = lim f_k(x) exists on [a, b], f' = psi on [a, b] (one-sided at
;;; the ends), f' continuous, f_k' -> f' uniformly.
;;; Proof: g_k = f_k - f_k(a) are primitives of f_k' vanishing at a (deriv-on-ccint-primitive,
;;; primitive-shift-const); primitive-uniform-limit gives a primitive G of psi with g_k -> G; f = G + c
;;; is a primitive of psi, and psi is continuous (uniform-limit-continuous-on-ccint), so f has
;;; derivative psi on [a, b] (primitive-continuous-deriv-on-ccint); f_k(x) = g_k(x) + f_k(a) -> G(x) + c.
;;; =====================================================================
(define cdl-m-GN (list 'VNB-LAMBDA 'cdk_ 'NN
                   (list 'VNB-LAMBDA 'cdv_ cdl-I (list '- '((fam cdk_) cdv_) '((fam cdk_) a)))))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IN a RR) (list 'FORALL 'b (list 'IMPLIES '(IN b RR)
  (list 'IMPLIES '(< a b)
    (list 'FORALL 'fam (list 'IMPLIES (list 'IN 'fam (list 'FUN 'NN (list 'FUN cdl-I 'RR)))
    (list 'FORALL 'dfam (list 'IMPLIES (list 'IN 'dfam (list 'FUN 'NN (list 'FUN cdl-I 'RR)))
    (list 'FORALL 'psi (list 'IMPLIES (list 'IN 'psi (list 'FUN cdl-I 'RR))
      (list 'IMPLIES '(FORALL k (IMPLIES (IN k NN) (HAS-DERIV-ON-CCINT (fam k) (dfam k) a b)))
        (list 'IMPLIES (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IS-CONTINUOUS-ON '(dfam k) cdl-I)))
          (list 'IMPLIES '(FORSOME c (AND (IN c RR) (CONVERGES-TO RR-MS (VNB-LAMBDA k NN ((fam k) a)) c)))
            (list 'IMPLIES (cdl-unif 'dfam 'psi)
              (list 'FORSOME 'f (list 'AND (list 'IN 'f (list 'FUN cdl-I 'RR))
                (list 'AND (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x cdl-I)
                             '(CONVERGES-TO RR-MS (VNB-LAMBDA k NN ((fam k) x)) (f x))))
                  (list 'AND '(HAS-DERIV-ON-CCINT f psi a b)
                    (list 'AND (list 'IS-CONTINUOUS-ON 'psi cdl-I)
                               (cdl-unif 'dfam 'psi)))))))))))))))))))))))
(dk-peel!)
(define cdl-m-hd (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'HAS-DERIV-ON-CCINT))) "derivatives"))
(define cdl-m-hu (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR))) "uniform"))
(define cdl-m-c (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the limit at a")))
(define cdl-m-cv (dk-pick (dk-head? 'CONVERGES-TO) "the convergence at a"))
(fact 'rr-is-set) (fact 'nn-is-set)
(fact 'ccint-subset-rr 'a 'b)
(dk-cite! 'subclass-of-set-is-set cdl-I 'RR)
(cdl-in-cc! 'a 'a 'b '((IN a RR) (IN b RR) (< a b)))
(dk-cite! 'uniform-limit-continuous-on-ccint 'a 'b 'dfam 'psi)
(dk-have! '(FORALL k (IMPLIES (IN k NN) (IS-PRIMITIVE (fam k) (dfam k) a b)))
  (lambda ()
    (let ((k (dk-di-var!)))
      (dk-apply! cdl-m-hd k)
      (dk-cite! 'deriv-on-ccint-primitive (list 'fam k) (list 'dfam k) 'a 'b)
      (ass))))
(define cdl-m-pf (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-PRIMITIVE))) "primitives"))
;; the normalised family and its three properties
(dk-have! (list 'IN cdl-m-GN (list 'FUN 'NN (list 'FUN cdl-I 'RR)))
  (lambda ()
    (dk-lam-type!
     (lambda ()
       (let* ((k (dk-di-var!)) (fk (list 'fam k)))
         (fact 'fun-apply-type-c 'fam 'NN (list 'FUN cdl-I 'RR) k)
         (fact 'fun-apply-type-c fk cdl-I 'RR 'a)
         (dk-lam-type!
          (lambda ()
            (let ((y (dk-di-var!)))
              (fact 'fun-apply-type-c fk cdl-I 'RR y)
              (fact 'rr-sub-in-rr (list fk y) (list fk 'a))
              (ass)))
          ass)))
     ass)))
(dk-have! (list 'FORALL 'puk_ (list 'IMPLIES '(IN puk_ NN) (list 'IS-PRIMITIVE (list cdl-m-GN 'puk_) '(dfam puk_) 'a 'b)))
  (lambda ()
    (let* ((k (dk-di-var!)) (fk (list 'fam k)))
      (fact 'fun-apply-type-c 'fam 'NN (list 'FUN cdl-I 'RR) k)
      (fact 'fun-apply-type-c fk cdl-I 'RR 'a)
      (dk-apply! cdl-m-pf k)
      (dk-lam-b!)
      (dk-cite! 'primitive-shift-const fk (list 'dfam k) 'a 'b (list fk 'a))
      (ass))))
(dk-have! (list 'FORALL 'puk_ (list 'IMPLIES '(IN puk_ NN) (list '= (list (list cdl-m-GN 'puk_) 'a) 0)))
  (lambda ()
    (let* ((k (dk-di-var!)) (fk (list 'fam k)))
      (fact 'fun-apply-type-c 'fam 'NN (list 'FUN cdl-I 'RR) k)
      (fact 'fun-apply-type-c fk cdl-I 'RR 'a)
      (dk-lam-b!)
      (crs))))
(dk-have! '(FORALL eps (IMPLIES (POS-RR eps) (FORSOME pun_ (AND (IN pun_ NN)
             (FORALL puk_ (IMPLIES (IN puk_ NN) (IMPLIES (<= pun_ puk_)
               (FORALL pux_ (IMPLIES (IN pux_ (CCINT a b)) (<= (ABS (- ((dfam puk_) pux_) (psi pux_))) eps))))))))))
  (lambda ()
    (dk-peel!)
    (let* ((e (cadr (dk-pick (dk-head? 'POS-RR) "eps")))
           (n (dk-skolem! (dk-apply! cdl-m-hu e)))
           (cu (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n))) "clause")))
      (ew n)
      (dk-conj-close!
       (lambda ()
         (if (not (dk-head-is? (dk-goal) 'FORALL))
             (ass)
             (let* ((ls (dk-peel!))
                    (k (cadr (cdl-find (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN) (not (eq? (cadr f) n)))) ls "k")))
                    (x (cadr (cdl-find (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cdl-I))) ls "x")))
                    (fk (list 'dfam k)))
               (dk-apply! cu k x)
               (fact 'fun-apply-type-c 'dfam 'NN (list 'FUN cdl-I 'RR) k)
               (fact 'fun-apply-type-c fk cdl-I 'RR x)
               (fact 'fun-apply-type-c 'psi cdl-I 'RR x)
               (fact 'rr-abs-sub-sym (list fk x) (list 'psi x))
               (subst (list '= (list 'ABS (list '- (list fk x) (list 'psi x))) (list 'ABS (list '- (list 'psi x) (list fk x)))))
               (ass))))))))
(define cdl-m-G (dk-skolem! (dk-cite! 'primitive-uniform-limit 'a 'b cdl-m-GN 'dfam 'psi)))
(define cdl-m-gl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'CONVERGES-TO) (dk-contains? f cdl-m-G)))
                          "g_k -> G"))
(fact 'rr-neg-closed cdl-m-c)
(define cdl-m-F (list 'VNB-LAMBDA 'rhpy_ cdl-I (list '- (list cdl-m-G 'rhpy_) (list '- cdl-m-c))))
(dk-cite! 'primitive-shift-const cdl-m-G 'psi 'a 'b (list '- cdl-m-c))
(fact 'primitive-in-fun cdl-m-F 'psi 'a 'b)
(fact 'primitive-in-fun cdl-m-G 'psi 'a 'b)
(dk-cite! 'primitive-continuous-deriv-on-ccint cdl-m-F 'psi 'a 'b)
(ew cdl-m-F)
(dk-conj-close!
 (lambda ()
   (if (not (dk-head-is? (dk-goal) 'FORALL))
       (if (dk-head-is? (dk-goal) 'AND) (dk-conj-close! (lambda () (ass))) (ass))
       (if (not (dk-contains? (dk-goal) 'CONVERGES-TO))
           (ass)
           (let* ((x (dk-di-var!))
                  (G cdl-m-G) (c cdl-m-c) (gx (list G x))
                  (S1 (list 'VNB-LAMBDA 'puk_ 'NN (list (list cdl-m-GN 'puk_) x)))
                  (S2 '(VNB-LAMBDA k NN ((fam k) a)))
                  (H (list 'VNB-LAMBDA 'k 'NN (list '(fam k) x))))
             (fact 'fun-apply-type-c G cdl-I 'RR x)
             (dk-apply! cdl-m-gl x)
             (for-each
              (lambda (S)
                (dk-have! (list 'IN S '(FUN NN RR))
                  (lambda ()
                    (dk-lam-type!
                     (lambda ()
                       (let* ((k (dk-di-var!)) (fk (list 'fam k)))
                         (fact 'fun-apply-type-c 'fam 'NN (list 'FUN cdl-I 'RR) k)
                         (fact 'fun-apply-type-c fk cdl-I 'RR 'a)
                         (fact 'fun-apply-type-c fk cdl-I 'RR x)
                         (fact 'rr-sub-in-rr (list fk x) (list fk 'a))
                         (if (dk--redex? (dk-goal)) (dk-lam-b!))
                         (ass)))
                     ass))))
              (list S1 S2 H))
             (dk-have! (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ NN) (list '= (list H 'j_) (list '+ (list S1 'j_) (list S2 'j_)))))
               (lambda ()
                 (let* ((k (dk-di-var!)) (fk (list 'fam k)))
                   (fact 'fun-apply-type-c 'fam 'NN (list 'FUN cdl-I 'RR) k)
                   (fact 'fun-apply-type-c fk cdl-I 'RR 'a)
                   (fact 'fun-apply-type-c fk cdl-I 'RR x)
                   (dk-lam-b!)
                   (crs))))
             (dk-cite! 'rr-limit-add S1 S2 H gx c)
             (dk-have! (list '= (list cdl-m-F x) (list '+ gx c))
               (lambda () (dk-lam-b!) (crs)))
             (subst (list '= (list cdl-m-F x) (list '+ gx c)))
             (ass))))))
(qed 'deriv-uniform-limit-on-ccint)
