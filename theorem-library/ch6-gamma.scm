;;; ch6-gamma.scm -- CH6-B: section 6.6, the Gamma function as a product (6.27, 6.28).  Loads after ch6-quot (and its
;;; dependencies).  Prefix c6g-.  Library: complex-analysis.
;;; KIT-9 link skipping, opt-in per file since 2026-10-29 (this file was developed with it on); guarded for bands that predate it


;;; ---------------------------------------------------------------- vocabulary (to move to structure-library at wiring)
;;; EULER-GAMMA = 1 - sum_k (log(k + 2) - log(k + 1) - 1/(k + 2)), the notes' (179) written as the sum of the
;;; decrements of H_m - ln m (euler-gamma-limit: H_{n+1} - ln(n + 1) -> EULER-GAMMA).
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

;;; ---- helper defines COPIED 2026-10-30 (wave-2 integration) from ch6/ch6-fun.scm, ch6/ch6-mult.scm, ch6/ch6-prod.scm, ch6/ch6-weier.scm, ch6/zero-order-laws.scm:
;;; the probe loaded this chain in ONE environment; load.scm gives each file its own.
(define (c6-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (c6-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (c6-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (c6-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))
(define (c6-nn! n) (fact 'nn-in-rr n) (fact 'rr-subset-cc n))
(define (c6-steps!)                          ; peel FORALL / IMPLIES; return the landed formulas
  (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
(define (c6-var new cls) (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (c6-vars new cls) (map cadr (filter (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (c6-lam-typ! lam cod typer)          ; (IN lam (FUN NN cod)); TYPER gets the eigenvariable, must ground
  (let ((typ (list 'IN lam (list 'FUN 'NN cod))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda () (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*))) (typer k) (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
              (lambda () (fact 'nn-is-set) (dk-ass!))))))
    typ))
(define c6-debug #f)
(define (c6-first-map f l) (cond ((null? l) #f) ((f (car l)) => (lambda (x) x)) (#t (c6-first-map f (cdr l)))))
(define (c6-prod-sub t)
  (cond ((not (pair? t)) #f)
        ((not (memq (car t) '(+ - * < <= = AND))) #f)                ; any other head is an atom for ineq
        (#t (or (c6-first-map c6-prod-sub (cdr t))
                (and (eq? (car t) '*) (= (length t) 3) (not (number? (cadr t))) (not (number? (caddr t))) t)))))
(define (c6-ineq*! . prems)
  (let loop ((prems prems))
    (let ((pt (c6-first-map c6-prod-sub (cons (dk-goal) prems))))
      (if (not pt)
          (begin
            (if c6-debug (for-each (lambda (q) (display ";; C6I ") (display (expression->string q)) (newline)) (cons (dk-goal) prems)))
            (apply dk-ineq! prems))
          (begin
            (c6-rr! pt)
            (let ((v (dk-name! pt 'RR)))
              (if (dk-contains? (dk-goal) pt) (subst (list '= pt v)))
              (loop (map (lambda (f) (if (dk-contains? f pt) (dk-rewrite-h! f pt v) f)) prems))))))))
(define (c6-chain-end f) (if (c6-op? f 'IMPLIES 3) (c6-chain-end (caddr f)) f))
(define (c6-cite! . args)                     ; dk-cite! that refuses to return an undetached implication link
  (let ((r (apply dk-cite! args)))
    (cond ((not (c6-op? r 'IMPLIES 3)) r)
          ((dk-asm? (c6-chain-end r)) (dk-ctx-form (c6-chain-end r)))     ; the consequent was already in context
          (#t (error "c6-cite!: the chain stopped at an antecedent not in context" (car args) (expression->string (cadr r)))))))
(define (c6-pts!)
  (fact 'cc-is-metric-space)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (c6-sk! ex) (dk-skolem! (dk-ctx-form ex) #t))
(define (c6-pow2! x)                           ; (= (power x 2) (* x x)), x in CC
  (let ((e (list '= (list 'power x 2) (list '* x x))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (fact 'nn-two-is-succ-succ-zero) (subst '(= 2 (succ (succ 0))))
            (fact 'nn-zero-in) (fact 'nn-succ-closed 0)
            (c6-and! (list 'IN x 'CC) '(IN (succ 0) NN)) (subst (dk-fact! 'power-succ x '(succ 0)))
            (c6-and! (list 'IN x 'CC) '(IN 0 NN)) (subst (dk-fact! 'power-succ x 0))
            (subst (dk-fact! 'power-zero x))
            (crs))))
    e))
(define c6-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (c6f-typ-on! lam u typer)              ; (IN lam (FUN u CC)); TYPER gets the eigenvariable
  (let ((typ (list 'IN lam (list 'FUN u 'CC))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*))) (typer x) (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
              (lambda () (dk-ass!))))))
    typ))
(define (c6f-rfl-close!) (dk-close-if! (lambda () #t) (lambda () (rfl))))
(define (c6f-rr-mul-nonneg! x y)               ; 0 <= x, 0 <= y in context: lands 0 <= x * y
  (let ((r (list '<= 0 (list '* x y))))
    (if (not (dk-asm? r))
        (let ((k (c6-cite! 'rr-mul-le-right 0 x y)))
          (dk-have! (list '= (list '* 0 y) 0) (lambda () (crs)))
          (dk-have! r (lambda () (dk-ineq! (dk-rewrite-h! k (list '* 0 y) 0))))))
    r))
(define (c6f-cc-and-closed! law x y)            ; law cc-mul-closed / cc-add-closed: (IN (op x y) CC)
  (c6-and! (list 'IN x 'CC) (list 'IN y 'CC)) (fact law x y))
(define (c6w-coef w) (list 'VNB-LAMBDA 'clhk_ 'NN (list '* (list 'RECIP-STAR 'clhk_) (list 'power w 'clhk_))))
(define (c6w-qs w m) (list 'CC-SERIES-PARTIAL-SUM (c6w-coef w) m))
(define (c6w-e n w) (list '* (list '- 1 w) (list 'CC-EXP (c6w-qs w (list 'succ n)))))
(define (c6w-exp-typ! q) (if (not (dk-asm? (list 'IN (list 'CC-EXP q) 'CC))) (dk-split-all! (list (dk-cite! 'cc-exp-converges q)))))
(define (c6w-e-typ! n w)
  (let ((q (c6w-qs w (list 'succ n))))
    (fact 'nn-succ-closed n) (c6w-coef-typ! w) (dk-cite! 'cc-series-partial-sum-in-cc (list 'succ n) (c6w-coef w))
    (c6w-exp-typ! q) (fact 'cc-one-in) (c6-cc! (list '- 1 w))
    (if (not (dk-asm? (list 'IN (c6w-e n w) 'CC))) (c6f-cc-and-closed! 'cc-mul-closed (list '- 1 w) (list 'CC-EXP q)))))
(define (c6w-cc-setup!) (fact 'cc-is-set) (fact 'cc-one-in) (fact 'cc-zero-in) (fact 'nn-zero-in) (fact 'rr-zero-in) (fact 'rr-one-in))
(define (c6w-pow-typ! w m)                       ; w in CC, m in NN: w^m in CC
  (c6-and! (list 'IN w 'CC) (list 'IN m 'NN)) (fact 'power-typing-nonneg w m) (list 'IN (list 'power w m) 'CC))
(define (c6w-coef-typ! w)                         ; w in CC: k -> RECIP-STAR(k) w^k in FUN(NN, CC)
  (c6-lam-typ! (c6w-coef w) 'CC (lambda (k) (c6-nn! k) (fact 'recip-star-in-rr k) (fact 'rr-subset-cc (list 'RECIP-STAR k))
                                    (c6w-pow-typ! w k) (c6f-cc-and-closed! 'cc-mul-closed (list 'RECIP-STAR k) (list 'power w k)))))
(define (c6w-el c n) (list 'VNB-LAMBDA 'c6x_ 'CC (list '- (c6w-e n (list '* 'c6x_ c)) 1)))
(define (c6w-induct-on! v base step)             ; after (ni) on the variable V: the step leaf is the one whose goal mentions V
  (let* ((ls (dk-open-leaves)) (st (find-first (lambda (l) (dk-contains? (dk-goal-of l) v)) ls))
         (b (find-first (lambda (l) (not (eq? l st))) ls)))
    (if (not (and b st)) (error "c6w-induct-on!: leaves not found"))
    (dk-focus! b) (base) (dk-focus! st) (step)))
(define (c6w-fam a mu) (list 'VNB-LAMBDA 'c6k_ 'NN (c6w-el (list 'recip (list a 'c6k_)) (list mu 'c6k_))))
(define (c6w-h167 a mu)
  (list 'FORALL 'c6r_ (list 'IMPLIES '(IN c6r_ RR) (list 'IMPLIES '(<= 0 c6r_)
    (list 'SERIES-CONVERGES (list 'VNB-LAMBDA 'c6k_ 'NN (list '* (list 'power (list '* 'c6r_ (list 'recip (list 'magnitude (list a 'c6k_)))) (list 'succ (list mu 'c6k_)))
                                                          (list 'recip (list 'succ (list mu 'c6k_))))))))))
(define (c6w-grow a)
  (list 'FORALL 'c6r_ (list 'IMPLIES '(IN c6r_ RR)
    (list 'FORSOME 'c6m_ (list 'AND '(IN c6m_ NN) (list 'FORALL 'c6q_ (list 'IMPLIES '(IN c6q_ NN) (list 'IMPLIES '(<= c6m_ c6q_) (list '<= 'c6r_ (list 'magnitude (list a 'c6q_)))))))))))
(define (c6w-anz a) (list 'FORALL 'c6q_ (list 'IMPLIES '(IN c6q_ NN) (list 'NOT (list '= (list a 'c6q_) 0)))))
(define (c6w-feq f a mu)
  (list 'FORALL 'c6k_ (list 'IMPLIES '(IN c6k_ NN) (list 'FORALL 'c6x_ (list 'IMPLIES '(IN c6x_ CC)
    (list '= (list (list f 'c6k_) 'c6x_) (list '- (c6w-e (list mu 'c6k_) (list '* 'c6x_ (list 'recip (list a 'c6k_)))) 1)))))))
(define (zol-hol-basics! u f)                     ; HOLOMORPHIC-ON(u, f) in context: f in FUN(u, CC), u open, u subset CC
  (dk-cite! 'holomorphic-on-in-fun u f) (dk-cite! 'holomorphic-on-open u f) (dk-cite! 'cc-open-subset-cc u)
  (fact 'cc-is-set) (fact 'cc-one-in) (fact 'cc-zero-in) (fact 'nn-zero-in))
(define (c6m-cc-open!)
  (c6w-cc-setup!) (fact 'nn-is-set) (fact 'cc-is-metric-space) (c6-pts!)
  (fact 'carrier-is-open 'CC-MS)
  (dk-have! '(IS-OPEN CC-MS CC) (lambda () (subst '(== CC (PTS CC-MS))) (dk-ass!)))
  (let ((oi (c6-cite! 'cc-ms-open-iff 'CC))) (dk-have! (list 'IS-OPEN c6-nfm 'CC) (lambda () (keep oi '(IS-OPEN CC-MS CC)) (prop))))
  (dk-have! '(SUBSET CC CC) (lambda () (let ((iff (dk-cite! 'subset-def 'CC 'CC)))
                                         (dk-have! (caddr iff) (lambda () (dk-di-var!) (dk-ass!)))
                                         (keep iff (caddr iff)) (prop)))))
;;; ---- end of copied helpers ----

(define c6g-hr '(VNB-LAMBDA egj_ NN (recip (succ egj_))))                                  ; j -> 1/(j + 1)
(define c6g-ed '(VNB-LAMBDA egk_ NN (- (- (LOG (succ (succ egk_))) (LOG (succ egk_))) (recip (succ (succ egk_))))))
(define c6g-es (list 'VNB-LAMBDA 'egn_ 'NN (list '- (list 'SERIES-PARTIAL-SUM c6g-hr '(succ egn_)) '(LOG (succ egn_)))))
(def-constant 'EULER-GAMMA
  (list 'euler-gamma-def (list '== 'EULER-GAMMA (list '- 1 (list 'SERIES-LIMIT c6g-ed)))))
(notation! 'EULER-GAMMA 'kind 'constant 'arity 0 'english "Euler's constant")

;;; ---------------------------------------------------------------- helpers
(define (c6g-nn! n) (fact 'nn-succ-closed n) (c6-nn! n) (c6-nn! (list 'succ n)))
(define (c6g-pos! t)                              ; t = succ(..) in NN: 0 < t, t /= 0, recip t in RR, > 0
  (let ((pred (cadr t)))
    (c6g-nn! pred) (fact 'nn-zero-le pred) (fact 'nn-succ-plus-one pred) (c6-nn! pred)
    (dk-have! (list '< 0 t) (lambda () (dk-ineq! (list '<= 0 pred) (list '= t (list '+ pred 1)))))
    (c6-cite! 'rr-pos-ne-zero t) (c6-and! (list 'IN t 'RR) (list 'NOT (list '= t 0))) (fact 'rr-recip-closed t) (c6-cite! 'rr-recip-pos t)
    (fact 'rr-recip-inverse t) (fact 'log-in-rr t)))

;;; 1/(k+2) <= log(k+2) - log(k+1) <= 1/(k+1)
(sp (make-wff '(FORALL egk_ (IMPLIES (IN egk_ NN)
  (AND (<= (recip (succ (succ egk_))) (- (LOG (succ (succ egk_))) (LOG (succ egk_))))
       (<= (- (LOG (succ (succ egk_))) (LOG (succ egk_))) (recip (succ egk_))))))))
(let* ((k (dk-di-var!)) (a (list 'succ k)) (b (list 'succ a)) (ra (list 'recip a)) (rb (list 'recip b))
       (x1 (list '* b ra)) (x2 (list '* a rb)))
  (fact 'nn-succ-closed k) (c6g-pos! a) (c6g-pos! b) (fact 'nn-succ-plus-one a) (fact 'rr-zero-in) (fact 'rr-one-in)
  (c6-rr! x1) (c6-rr! x2) (c6-cite! 'rr-mul-pos b ra) (c6-cite! 'rr-mul-pos a rb)
  (fact 'log-in-rr x1) (fact 'log-in-rr x2)
  (let* ((va (dk-name! ra 'RR)) (vb (dk-name! rb 'RR))
         (ia (dk-rewrite-h! (list '= (list '* a ra) 1) ra va)) (ib (dk-rewrite-h! (list '= (list '* b rb) 1) rb vb)))
    ;; a x1 = b and b x2 = a; x1 = 1 + 1/a and x2 = 1 - 1/b
    (let* ((e1 (list '= (list '* a x1) b)) (e2 (list '= (list '* b x2) a)) (e3 (list '= x1 (list '+ 1 ra))) (e4 (list '= x2 (list '- 1 rb))))
      (dk-have! e1 (lambda () (subst (list '= ra va)) (dk-have! (list '= (list '* a (list '* b va)) (list '* b (list '* a va))) (lambda () (crs)))
                              (subst (list '= (list '* a (list '* b va)) (list '* b (list '* a va)))) (subst (list '= (list '* a va) 1)) (crs)))
      (dk-have! e2 (lambda () (subst (list '= rb vb)) (dk-have! (list '= (list '* b (list '* a vb)) (list '* a (list '* b vb))) (lambda () (crs)))
                              (subst (list '= (list '* b (list '* a vb)) (list '* a (list '* b vb)))) (subst (list '= (list '* b vb) 1)) (crs)))
      (dk-have! e3 (lambda () (subst (list '= ra va)) (subst (list '= b (list '+ a 1))) (dk-have! (list '= (list '* (list '+ a 1) va) (list '+ (list '* a va) va)) (lambda () (crs)))
                              (subst (list '= (list '* (list '+ a 1) va) (list '+ (list '* a va) va))) (subst (list '= (list '* a va) 1)) (c6f-rfl-close!)))
      (dk-have! e4 (lambda () (subst (list '= rb vb)) (dk-have! (list '= a (list '- b 1)) (lambda () (dk-ineq! (list '= b (list '+ a 1)))))
                              (subst (list '= a (list '- b 1))) (dk-have! (list '= (list '* (list '- b 1) vb) (list '- (list '* b vb) vb)) (lambda () (crs)))
                              (subst (list '= (list '* (list '- b 1) vb) (list '- (list '* b vb) vb))) (subst (list '= (list '* b vb) 1)) (c6f-rfl-close!)))
      (let* ((m1 (dk-rewrite-h! (c6-cite! 'log-mul a x1) (list '* a x1) b))
             (m2 (dk-rewrite-h! (c6-cite! 'log-mul b x2) (list '* b x2) a))
             (l1 (c6-cite! 'log-le-minus-one x1)) (l2 (c6-cite! 'log-le-minus-one x2)))
        (let* ((g1 (dk-name! (list 'LOG x1) 'RR)) (g2 (dk-name! (list 'LOG x2) 'RR))
               (m1b (dk-rewrite-h! m1 (list 'LOG x1) g1)) (m2b (dk-rewrite-h! m2 (list 'LOG x2) g2))
               (l1b (dk-rewrite-h! l1 (list 'LOG x1) g1)) (l2b (dk-rewrite-h! l2 (list 'LOG x2) g2))
               (h1 (dk-name! x1 'RR)) (h2 (dk-name! x2 'RR))
               (l1c (dk-rewrite-h! l1b x1 h1)) (l2c (dk-rewrite-h! l2b x2 h2))
               (e3b (dk-rewrite-h! e3 x1 h1)) (e4b (dk-rewrite-h! e4 x2 h2)))
          (dk-conj-close!
            (lambda () (dk-ineq! m1b m2b l1c l2c e3b e4b))))))))
(qed 'log-step-bounds)

;;; ---------------------------------------------------------------- H_{n+1} - log(n + 1) -> EULER-GAMMA (the notes' (179))
(define (c6g-hr-typ!) (c6-lam-typ! c6g-hr 'RR (lambda (k) (c6g-pos! (list 'succ k)))))
(define (c6g-ed-typ!)
  (c6-lam-typ! c6g-ed 'RR (lambda (k) (c6g-pos! (list 'succ k)) (c6g-pos! (list 'succ (list 'succ k)))
                             (c6-rr! (list '- (list 'LOG (list 'succ (list 'succ k))) (list 'LOG (list 'succ k))))
                             (c6-rr! (list '- (list '- (list 'LOG (list 'succ (list 'succ k))) (list 'LOG (list 'succ k))) (list 'recip (list 'succ (list 'succ k))))))))
(define (c6g-sps-succ! f n)                       ; f in FUN(NN, RR) in context: S(f, succ n) == S(f, n) + f(n)
  (c6-nn! n) (fact 'series-partial-sum-in-rr n f) (fact 'fun-apply-type-c f 'NN 'RR n)
  (dk-cite! 'series-partial-sum-succ f n))
(define (c6g-val! f n)                           ; f(n) = <its beta-reduct>, landed; returns the equation
  (fact 'fun-apply-type-c f 'NN 'RR n)
  (let* ((body (caddr (cdr f))) (val (subst-free (cadr f) n body)) (e (list '= (list f n) val)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (dk-lam-b!) (c6f-rfl-close!))))
    e))
(define (c6g-one!)                               ; succ 0 = 1, LOG 1 = 0, recip 1 = 1 in context
  (fact 'nn-zero-in) (c6g-pos! '(succ 0)) (fact 'nn-succ-plus-one 0) (fact 'rr-one-in)
  (dk-have! '(= (succ 0) 1) (lambda () (dk-ineq! '(= (succ 0) (+ 0 1)))))
  (fact 'log-one) (fact 'rr-recip-inverse 1) (fact 'rr-recip-closed 1)
  (dk-have! '(= (recip 1) 1) (lambda () (dk-ineq! '(= (* 1 (recip 1)) 1)))))

;;; log(n + 1) <= H_n
(sp (make-wff (list 'FORALL 'egn_ (list 'IMPLIES '(IN egn_ NN) (list '<= '(LOG (succ egn_)) (list 'SERIES-PARTIAL-SUM c6g-hr 'egn_))))))
(ni)
(c6w-induct-on! 'egn_
  (lambda ()
    (c6g-hr-typ!) (c6g-one!) (subst (dk-cite! 'series-partial-sum-zero c6g-hr)) (subst '(= (succ 0) 1)) (subst '(= (LOG 1) 0)) (dk-ineq!))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-var new 'NN))
           (ih (find-first (lambda (q) (dk-head-is? q '<=)) new)))
      (c6g-hr-typ!) (c6g-pos! (list 'succ n)) (c6g-pos! (list 'succ (list 'succ n)))
      (subst (c6g-sps-succ! c6g-hr n))
      (let* ((v (c6g-val! c6g-hr n)) (lb (c6-cite! 'log-step-bounds n)))
        (dk-split! lb)
        (dk-ineq! ih v (caddr lb))))))
(qed 'log-le-harmonic)

;;; H_{n+1} - log(n + 1) = 1 - sum_{k < n} d_k
(sp (make-wff (list 'FORALL 'egn_ (list 'IMPLIES '(IN egn_ NN)
  (list '= (list '- (list 'SERIES-PARTIAL-SUM c6g-hr '(succ egn_)) '(LOG (succ egn_))) (list '- 1 (list 'SERIES-PARTIAL-SUM c6g-ed 'egn_)))))))
(ni)
(c6w-induct-on! 'egn_
  (lambda ()
    (c6g-hr-typ!) (c6g-ed-typ!) (c6g-one!)
    (subst (c6g-sps-succ! c6g-hr 0))
    (subst (dk-cite! 'series-partial-sum-zero c6g-hr)) (subst (dk-cite! 'series-partial-sum-zero c6g-ed))
    (let ((v (c6g-val! c6g-hr 0)))
      (subst '(= (succ 0) 1))
      (subst '(= (LOG 1) 0))
      (fact 'fun-apply-type-c c6g-hr 'NN 'RR 0)
      (dk-ineq! (dk-rewrite-h! (dk-rewrite-h! v '(succ 0) 1) '(recip 1) 1))))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-var new 'NN)) (sn (list 'succ n))
           (ih (find-first (lambda (q) (dk-head-is? q '=)) new)))
      (c6g-hr-typ!) (c6g-ed-typ!) (fact 'nn-succ-closed n) (c6g-pos! sn) (c6g-pos! (list 'succ sn))
      (subst (c6g-sps-succ! c6g-hr sn)) (subst (c6g-sps-succ! c6g-ed n))
      (fact 'series-partial-sum-in-rr sn c6g-hr)
      (let* ((v1 (c6g-val! c6g-hr sn)) (v2 (c6g-val! c6g-ed n)))
        (dk-ineq! ih v1 v2)))))
(qed 'harmonic-minus-log-identity)

;;; H_{n+1} - log(n + 1) -> EULER-GAMMA
(define c6g-cst '(VNB-LAMBDA egc_ NN 1))
(sp (make-wff (list 'CONVERGES-TO 'RR-MS c6g-es 'EULER-GAMMA)))
(c6g-hr-typ!) (c6g-ed-typ!) (fact 'rr-zero-in) (fact 'rr-one-in)
(c6-lam-typ! c6g-es 'RR (lambda (k) (c6g-pos! (list 'succ k)) (fact 'series-partial-sum-in-rr (list 'succ k) c6g-hr)
                           (c6-rr! (list '- (list 'SERIES-PARTIAL-SUM c6g-hr (list 'succ k)) (list 'LOG (list 'succ k))))))
(c6-lam-typ! c6g-cst 'RR (lambda (k) (fact 'rr-one-in)))
(dk-have! '(FORALL cpsk_ (IMPLIES (IN cpsk_ NN) (<= 0 ((VNB-LAMBDA egk_ NN (- (- (LOG (succ (succ egk_))) (LOG (succ egk_))) (recip (succ (succ egk_))))) cpsk_))))
  (lambda () (let* ((k (dk-di-var!)) (p1 (c6g-pos! (list 'succ k))) (p2 (c6g-pos! (list 'succ (list 'succ k))))
                    (p3 (c6-rr! (list '- (list 'LOG (list 'succ (list 'succ k))) (list 'LOG (list 'succ k)))))
                    (v (c6g-val! c6g-ed k)) (lb (c6-cite! 'log-step-bounds k)))
               (dk-split! lb) (dk-ineq! v (cadr lb)))))
(dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN) (list '<= (list 'SERIES-PARTIAL-SUM c6g-ed 'cpsk_) 1)))
  (lambda () (let* ((k (dk-di-var!)) (sk (list 'succ k)))
               (c6g-pos! sk) (fact 'series-partial-sum-in-rr k c6g-ed) (fact 'series-partial-sum-in-rr k c6g-hr)
               (fact 'series-partial-sum-in-rr sk c6g-hr)
               (let* ((id (c6-cite! 'harmonic-minus-log-identity k)) (lh (c6-cite! 'log-le-harmonic k))
                      (ss (c6g-sps-succ! c6g-hr k)) (v (c6g-val! c6g-hr k)))
                 (dk-ineq! (dk-rewrite-h! id (cadr ss) (caddr ss)) lh v (list '< 0 (list 'recip sk)))))))
(let* ((cv (c6-cite! 'series-bounded-converges c6g-ed 1))
       (ct (c6-cite! 'series-limit-converges-to c6g-ed))
       (lin (c6-cite! 'series-limit-in-rr c6g-ed))
       (lv (list 'SERIES-LIMIT c6g-ed))
       (cto (dk-landed-1 (lambda () (mac-h 'series-converges-to ct))))
       (psq (caddr cto))
       (k1 (dk-cite! 'rr-const-converges-to 1)))
  (c6-lam-typ! psq 'RR (lambda (k) (fact 'series-partial-sum-in-rr k c6g-ed)))
  (dk-have! (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ NN) (list '= (list c6g-es 'j_) (list '- (list c6g-cst 'j_) (list psq 'j_)))))
    (lambda () (let ((j (dk-di-var!)))
                 (c6-nn! j) (fact 'nn-succ-closed j) (c6g-pos! (list 'succ j))
                 (fact 'series-partial-sum-in-rr (list 'succ j) c6g-hr) (fact 'series-partial-sum-in-rr j c6g-ed)
                 (dk-lam-b!)
                 (c6-cite! 'harmonic-minus-log-identity j)
                 (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))))
  (let ((r (c6-cite! 'rr-limit-sub c6g-cst psq c6g-es 1 lv)))
    (mac 'euler-gamma-def)
    (dk-close-if! (lambda () #t) (lambda () (dk-ass!)))))
(qed 'euler-gamma-limit)

;;; ---------------------------------------------------------------- the canonical product of 6.27: a_k = -(k + 1), p_k = 1
;;; 1/(2(n+1)^2) <= 1/(n+1) - 1/(n+2), and 0 <= 1/(n+1) - 1/(n+2)
(define (c6g-u n) (list 'recip (list 'succ n)))
(define (c6g-v n) (list 'recip (list 'succ (list 'succ n))))
(sp (make-wff (list 'FORALL 'egn_ (list 'IMPLIES '(IN egn_ NN)
  (list 'AND (list '<= (list '* (list '* (c6g-u 'egn_) (c6g-u 'egn_)) 1/2) (list '- (c6g-u 'egn_) (c6g-v 'egn_)))
             (list '<= 0 (list '- (c6g-u 'egn_) (c6g-v 'egn_))))))))
(let* ((n (dk-di-var!)) (sn (list 'succ n)) (tn (list 'succ sn)))
  (fact 'nn-succ-closed n) (c6g-pos! sn) (c6g-pos! tn) (fact 'nn-succ-plus-one sn) (fact 'nn-zero-le n) (fact 'nn-succ-plus-one n)
  (fact 'rr-one-in) (fact 'rr-zero-in)
  (let* ((u (dk-name! (c6g-u n) 'RR)) (v (dk-name! (c6g-v n) 'RR))
         (p0 (dk-rewrite-h! (list '= (list '* sn (c6g-u n)) 1) (c6g-u n) u))
         (q0 (dk-rewrite-h! (dk-rewrite-h! (list '= (list '* tn (c6g-v n)) 1) (c6g-v n) v) tn (list '+ sn 1)))
         (up (dk-rewrite-h! (list '< 0 (c6g-u n)) (c6g-u n) u)) (vp (dk-rewrite-h! (list '< 0 (c6g-v n)) (c6g-v n) v))
         (sv (dk-name! sn 'RR))
         (p1 (dk-rewrite-h! p0 sn sv)) (q1 (dk-rewrite-h! q0 sn sv))
         (s1 (dk-have! (list '<= 1 sv) (lambda () (dk-ineq! (list '= sv sn) (list '= sn (list '+ n 1)) (list '<= 0 n)))))
         (cc (list '* (list '* (list '* u u) v) (list '* (list '- sv 1) 1/2)))
         (lhs (list '- (list '- (list '- u v) (list '* (list '* u u) 1/2)) cc))
         (aa (list '- v (list '* u v))) (bb (list '- (list '* (list '* u u) 1/2) u))
         (i0 (list '= lhs (list '+ (list '* aa (list '- (list '* sv u) 1)) (list '* bb (list '- (list '* (list '+ sv 1) v) 1))))))
    (dk-have! i0 (lambda () (crs)))
    (let* ((i1 (dk-rewrite-h! (dk-rewrite-h! i0 (list '* sv u) 1) (list '* (list '+ sv 1) v) 1))
           (z (list '= (list '+ (list '* aa (list '- 1 1)) (list '* bb (list '- 1 1))) 0)))
      (dk-have! z (lambda () (crs)))
      (let ((i2 (dk-rewrite-h! i1 (cadr z) 0)))
        (c6-rr! (list '* u u)) (fact 'rr-sq-nonneg u) (c6-rr! (list '* (list '* u u) v))
        (dk-have! (list '<= 0 v) (lambda () (dk-ineq! vp)))
        (c6-rr! (list '* (list '* u u) v)) (c6f-rr-mul-nonneg! (list '* u u) v)
        (c6-rr! (list '- sv 1)) (c6-rr! (list '* (list '- sv 1) 1/2))
        (dk-have! (list '<= 0 (list '* (list '- sv 1) 1/2)) (lambda () (dk-ineq! (list '<= 1 sv))))
        (let* ((xe (list '* (list '* u u) v)) (ye (list '* (list '- sv 1) 1/2))
               (x1 (dk-name! xe 'RR)) (y1 (dk-name! ye 'RR))
               (xn (dk-rewrite-h! (list '<= 0 xe) xe x1)) (yn (dk-rewrite-h! (list '<= 0 ye) ye y1))
               (c1 (begin (c6-rr! (list '* x1 y1)) (c6f-rr-mul-nonneg! x1 y1)))
               (i3 (dk-rewrite-h! (dk-rewrite-h! i2 xe x1) ye y1)))
          (subst (list '= (c6g-u n) u)) (subst (list '= (c6g-v n) v))
          (dk-conj-close!
            (lambda () (c6-ineq*! i3 c1 (list '<= 0 (list '* u u))))))))))
(qed 'recip-square-step)

;;; the telescoping majorant: S(g_r, n) + r^2/(n+1) = r^2 for g_r(q) = r^2 (1/(q+1) - 1/(q+2))
(define (c6g-g r) (list 'VNB-LAMBDA 'egq_ 'NN (list '* (list '* r r) (list '- (c6g-u 'egq_) (c6g-v 'egq_)))))
(define (c6g-g-typ! r)
  (c6-lam-typ! (c6g-g r) 'RR (lambda (k) (c6g-pos! (list 'succ k)) (c6g-pos! (list 'succ (list 'succ k)))
                                (c6-rr! (list '* r r)) (c6-rr! (list '- (c6g-u k) (c6g-v k))) (c6-rr! (list '* (list '* r r) (list '- (c6g-u k) (c6g-v k)))))))
(sp (make-wff (list 'FORALL 'egn_ (list 'IMPLIES '(IN egn_ NN) (list 'FORALL 'egr_ (list 'IMPLIES '(IN egr_ RR)
  (list '= (list '+ (list 'SERIES-PARTIAL-SUM (c6g-g 'egr_) 'egn_) (list '* '(* egr_ egr_) (c6g-u 'egn_))) '(* egr_ egr_))))))))
(ni)
(c6w-induct-on! 'egn_
  (lambda ()
    (let* ((new (c6-steps!)) (r (c6-var new 'RR)))
      (c6g-g-typ! r) (c6g-one!) (c6-rr! (list '* r r))
      (subst (dk-cite! 'series-partial-sum-zero (c6g-g r))) (subst '(= (succ 0) 1)) (subst '(= (recip 1) 1))
      (crs)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-var new 'NN)) (r (c6-var new 'RR)) (sn (list 'succ n))
           (ih (find-first (lambda (q) (c6-op? q 'FORALL 3)) new)))
      (c6g-g-typ! r) (fact 'nn-succ-closed n) (c6g-pos! sn) (c6g-pos! (list 'succ sn)) (c6-rr! (list '* r r))
      (let* ((ihe (dk-apply! ih r)))
        (subst (c6g-sps-succ! (c6g-g r) n))
        (let* ((gv (c6g-val! (c6g-g r) n))
               (dd (list '= (list '* (list '* r r) (list '- (c6g-u n) (c6g-v n))) (list '- (list '* (list '* r r) (c6g-u n)) (list '* (list '* r r) (c6g-v n))))))
          (dk-have! dd (lambda () (dk-crs-opaque!)))
          (subst gv)
          (let* ((st (list 'SERIES-PARTIAL-SUM (c6g-g r) n)) (sv (dk-name! st 'RR)))
            (subst (list '= st sv))
            (c6-ineq*! (dk-rewrite-h! ihe st sv) dd)))))))
(qed 'recip-square-telescope)

;;; the zero sequence a_k = -(k + 1) and the genus p_k = 1
(define c6g-a '(VNB-LAMBDA c6gk_ NN (- (succ c6gk_))))
(define c6g-mu '(VNB-LAMBDA c6gk_ NN 1))
(define (c6g-mag! k)                             ; |-(k + 1)| = k + 1
  (let* ((s (list 'succ k)) (ns (list '- s)) (e (list '= (list 'magnitude ns) s)))
    (if (not (dk-asm? e))
        (begin
          (c6g-pos! s) (c6-rr! ns) (fact 'rr-subset-cc ns)
          (dk-have! (list '<= ns 0) (lambda () (dk-ineq! (list '< 0 s))))
          (let* ((m1 (c6-cite! 'rr-magnitude-is-abs ns)) (m2 (c6-cite! 'rr-abs-of-nonpos ns)))
            (c6-rr! (list 'magnitude ns)) (c6-rr! (list 'abs ns))
            (dk-have! e (lambda () (dk-ineq! m1 m2))))))
    e))
(define (c6g-a-typ!)
  (c6-lam-typ! c6g-a 'CC (lambda (k) (c6g-pos! (list 'succ k)) (c6-rr! (list '- (list 'succ k))) (fact 'rr-subset-cc (list '- (list 'succ k))))))
(define (c6g-mu-typ!) (c6-lam-typ! c6g-mu 'NN (lambda (k) (fact 'nn-one-in))))

(sp (make-wff (c6w-anz c6g-a)))
(let* ((q (dk-di-var!)) (s (list 'succ q)))
  (c6g-pos! s) (c6-rr! (list '- s))
  (dk-lam-b!)
  (di)
  (dk-absurd! (list '< 0 s) (list '= (list '- s) 0)))
(qed 'gamma-zeros-nonzero)

(sp (make-wff (c6w-grow c6g-a)))
(let* ((r (dk-di-var!)) (ex (c6-cite! 'nn-unbounded-in-rr r)) (m (dk-skolem! ex)))
  (c6-nn! m)
  (ew m)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IN)
          (dk-ass!)
          (let* ((new (c6-steps!)) (q (c6-var new 'NN)) (lev (find-first (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) m))) new)))
            (c6-nn! q) (c6g-mag! q) (fact 'nn-succ-plus-one q)
            (dk-lam-b!)
            (subst (c6g-mag! q))
            (dk-ineq! (list '< r m) lev (list '= (list 'succ q) (list '+ q 1))))))))
(qed 'gamma-zeros-grow)

(define (c6g-mul-nonneg! a b)                    ; 0 <= a, 0 <= b in context: lands 0 <= a * b
  (let ((r (list '<= 0 (list '* a b))))
    (if (not (dk-asm? r))
        (begin
          (c6-rr! a) (c6-rr! b)
          (let* ((aa (dk-name! a 'RR)) (bb (dk-name! b 'RR)))
            (dk-rewrite-h! (list '<= 0 a) a aa) (dk-rewrite-h! (list '<= 0 b) b bb)
            (c6-rr! (list '* aa bb)) (c6f-rr-mul-nonneg! aa bb)
            (dk-have! r (lambda () (subst (list '= a aa)) (subst (list '= b bb)) (dk-ass!))))))
    r))
(define (c6g-hfacts! r k)                        ; the facts that evaluate the k-th term of the 6.20 series at genus 1
  (let ((x (list '* r (c6g-u k))))
    (c6g-pos! (list 'succ k)) (c6g-pos! (list 'succ (list 'succ k))) (c6g-mag! k)
    (fact 'nn-one-in) (fact 'nn-succ-plus-one 1) (fact 'nn-succ-closed 1) (c6-nn! '(succ 1)) (fact 'rr-one-in)
    (if (not (dk-asm? '(= (succ 1) 2))) (dk-have! '(= (succ 1) 2) (lambda () (dk-ineq! '(= (succ 1) (+ 1 1))))))
    (if (not (dk-asm? '(= (recip 2) 1/2)))
        (begin (c6-rr! 2) (dk-have! '(NOT (= 2 0)) (lambda () (di) (dk-absurd! '(= 2 0))))
               (c6-and! '(IN 2 RR) '(NOT (= 2 0))) (fact 'rr-recip-closed 2) (fact 'rr-recip-inverse 2)
               (dk-have! '(= (recip 2) 1/2) (lambda () (dk-ineq! '(= (* 2 (recip 2)) 1))))))
    (c6-rr! x) (fact 'rr-subset-cc x) (c6-pow2! x) (c6-rr! (list '* x x)) (c6-rr! (list '* (list '* x x) 1/2))
    x))
(define (c6g-hv! h r k)                          ; h(k) = (r/(k+1))^2 / 2
  (let* ((x (c6g-hfacts! r k)) (e (list '= (list h k) (list '* (list '* x x) 1/2))))
    (fact 'fun-apply-type-c h 'NN 'RR k)
    (if (not (dk-asm? e))
        (dk-have! e (lambda () (dk-lam-b!) (subst (c6g-mag! k)) (subst '(= (succ 1) 2)) (subst (c6-pow2! x)) (subst '(= (recip 2) 1/2))
                               (c6f-rfl-close!))))
    e))

(sp (make-wff (c6w-h167 c6g-a c6g-mu)))
(let* ((new (c6-steps!)) (r (c6-var new 'RR)) (h (cadr (dk-goal))) (g (c6g-g r)))
  (c6g-g-typ! r) (fact 'rr-zero-in) (c6-rr! (list '* r r)) (fact 'rr-sq-nonneg r)
  (c6-lam-typ! h 'RR (lambda (k) (let ((x (c6g-hfacts! r k)))
                                   (dk-lam-b!) (subst (c6g-mag! k)) (subst '(= (succ 1) 2)) (subst (c6-pow2! x)) (subst '(= (recip 2) 1/2))
                                   (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))))
  ;; 0 <= h(k) <= g(k)
  (dk-have! (list 'FORALL 'egp_ (list 'IMPLIES '(IN egp_ NN) (list 'AND (list '<= 0 (list h 'egp_)) (list '<= (list h 'egp_) (list g 'egp_)))))
    (lambda ()
      (let* ((k (dk-di-var!)) (hv (c6g-hv! h r k)) (gv (c6g-val! g k)) (st (c6-cite! 'recip-square-step k)))
        (dk-split! st)
        (subst hv) (subst gv)
        (let* ((uu (dk-name! (c6g-u k) 'RR)) (vv (dk-name! (c6g-v k) 'RR))
               (s1 (dk-rewrite-h! (dk-rewrite-h! (cadr st) (c6g-u k) uu) (c6g-v k) vv)))
          (subst (list '= (c6g-u k) uu)) (subst (list '= (c6g-v k) vv))
          (let* ((dd (list '- (list '- uu vv) (list '* (list '* uu uu) 1/2)))
                 (xu (list '* r uu)))
            (c6-rr! (list '* uu uu)) (c6-rr! dd) (c6-rr! xu) (c6-rr! (list '* xu xu)) (fact 'rr-sq-nonneg xu)
            (dk-have! (list '<= 0 dd) (lambda () (dk-ineq! s1)))
            (c6g-mul-nonneg! (list '* r r) dd)
            (let ((id0 (list '= (list '* (list '* r r) dd) (list '- (list '* (list '* r r) (list '- uu vv)) (list '* (list '* xu xu) 1/2)))))
              (dk-have! id0 (lambda () (crs)))
              (dk-conj-close!
                (lambda () (c6-ineq*! id0 (list '<= 0 (list '* (list '* r r) dd)) (list '<= 0 (list '* xu xu)))))))))))
  ;; 0 <= g(k)
  (dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN) (list '<= 0 (list g 'cpsk_))))
    (lambda ()
      (let* ((k (dk-di-var!)) (p1 (c6g-pos! (list 'succ k))) (p2 (c6g-pos! (list 'succ (list 'succ k))))
             (gv (c6g-val! g k)) (st (c6-cite! 'recip-square-step k)))
        (dk-split! st)
        (subst gv)
        (c6g-mul-nonneg! (list '* r r) (list '- (c6g-u k) (c6g-v k)))
        (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))))
  ;; S(g, k) <= r^2
  (dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN) (list '<= (list 'SERIES-PARTIAL-SUM g 'cpsk_) (list '* r r))))
    (lambda ()
      (let* ((k (dk-di-var!)) (p1 (c6g-pos! (list 'succ k))) (tl (c6-cite! 'recip-square-telescope k r)))
        (fact 'series-partial-sum-in-rr k g)
        (dk-have! (list '<= 0 (c6g-u k)) (lambda () (dk-ineq! (list '< 0 (c6g-u k)))))
        (c6g-mul-nonneg! (list '* r r) (c6g-u k))
        (let* ((st (list 'SERIES-PARTIAL-SUM g k)) (sv (dk-name! st 'RR)))
          (subst (list '= st sv))
          (c6-ineq*! (dk-rewrite-h! tl st sv) (list '<= 0 (list '* (list '* r r) (c6g-u k))))))))
  (c6-cite! 'series-bounded-converges g (list '* r r))
  (c6-and! (list 'FORALL 'egp_ (list 'IMPLIES '(IN egp_ NN) (list 'AND (list '<= 0 (list h 'egp_)) (list '<= (list h 'egp_) (list g 'egp_)))))
           (list 'SERIES-CONVERGES g))
  (c6-cite! 'comparison-test h g)
  (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))
(qed 'gamma-zeros-h167)

;;; ---------------------------------------------------------------- 6.20 with multiplicities, for the family c6w-fam itself
(sp (make-wff (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC)) (list 'IMPLIES (c6w-anz 'c6a_) (list 'IMPLIES (c6w-grow 'c6a_)
  (list 'FORALL 'c6u_ (list 'IMPLIES '(IN c6u_ (FUN NN NN)) (list 'IMPLIES (c6w-h167 'c6a_ 'c6u_)
    (list 'FORALL 'c6z_ (list 'IMPLIES '(IN c6z_ CC) (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN)
      (list 'IMPLIES '(FORALL c6q_ (IMPLIES (IN c6q_ NN) (IMPLIES (<= c6n_ c6q_) (NOT (= (c6a_ c6q_) c6z_)))))
        (list 'HAS-ZERO-OF-ORDER 'CC (list 'PROD-FUN 'CC (c6w-fam 'c6a_ 'c6u_)) 'c6z_ '(COUNT-HITS c6a_ c6z_ c6n_))))))))))))))))
(let* ((new (c6-steps!))
       (a (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) '(FUN NN CC)))) new)))
       (mu (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) '(FUN NN NN)))) new)))
       (z (c6-var new 'CC)) (nv (c6-var new 'NN))
       (anz (dk-ctx-form (c6w-anz a))) (fam (c6w-fam a mu))
       (ak! (lambda (k) (fact 'fun-apply-type-c a 'NN 'CC k) (fact 'fun-apply-type-c mu 'NN 'NN k) (dk-apply! anz k)
                        (c6-and! (list 'IN (list a k) 'CC) (list 'NOT (list '= (list a k) 0))) (fact 'cc-recip-closed (list a k)))))
  (c6w-cc-setup!) (fact 'nn-is-set)
  (c6-lam-typ! fam '(FUN CC CC)
    (lambda (k) (ak! k)
      (c6f-typ-on! (c6w-el (list 'recip (list a k)) (list mu k)) 'CC
        (lambda (x) (let ((xc (list '* x (list 'recip (list a k)))))
                      (c6f-cc-and-closed! 'cc-mul-closed x (list 'recip (list a k))) (c6w-e-typ! (list mu k) xc)
                      (c6-cc! (list '- (c6w-e (list mu k) xc) 1)))))))
  (dk-have! (c6w-feq fam a mu)
    (lambda () (let* ((nk (c6-steps!)) (k (c6-var nk 'NN)) (x (begin (ak! k) (c6-var nk 'CC))) (xc (list '* x (list 'recip (list a k)))))
                 (c6f-cc-and-closed! 'cc-mul-closed x (list 'recip (list a k))) (c6w-e-typ! (list mu k) xc)
                 (c6-cc! (list '- (c6w-e (list mu k) xc) 1))
                 (dk-lam-b!) (c6f-rfl-close!))))
  (c6-cite! 'theorem-6-20-multiplicity a mu fam z nv)
  (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))
(qed 'theorem-6-20-multiplicity-fam)

;;; COUNT-HITS(s, z, j) = 0 when no s_q, q < j, equals z
(sp (make-wff '(FORALL egj_ (IMPLIES (IN egj_ NN) (FORALL egs_ (FORALL egz_
  (IMPLIES (FORALL egq_ (IMPLIES (IN egq_ NN) (IMPLIES (< egq_ egj_) (NOT (= (egs_ egq_) egz_)))))
           (= (COUNT-HITS egs_ egz_ egj_) 0))))))))
(dk-ni-fixed! '(egs_ egz_))   ; W1G-A: egs_, egz_ fixed
(c6w-induct-on! 'egj_
  (lambda ()
    (let* ((new (c6-steps!)) (g (dk-goal)) (sq (cadr (cadr g))) (z (caddr (cadr g))))
      (fact 'nn-zero-in) (fact 'rr-zero-in)
      (subst (dk-fact! 'count-hits-zero sq z))
      (c6f-rfl-close!)))
  (lambda ()
