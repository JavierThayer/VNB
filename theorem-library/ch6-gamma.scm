;;; ---------------------------------------------------------------- Definition 6.27 and Proposition 6.28
;;; 1/Gamma(z) = z e^{gamma z} prod_{k >= 1} (1 + z/k) e^{-z/k}: the k-th factor is E_1(z / a_k) with a_k = -(k + 1)
;;; (index from 0).  Gamma itself is meromorphic; the tree has no pole vocabulary yet (CH4-B), so 6.28 is stated for
;;; RECIP-GAMMA = 1/Gamma: entire, a zero of order exactly 1 at each -n (n >= 0), no other zero.
(define c6g-fam (c6w-fam c6g-a c6g-mu))
(define c6g-p (list 'PROD-FUN 'CC c6g-fam))
(def-constant 'RECIP-GAMMA (list 'recip-gamma-def (list '== 'RECIP-GAMMA (c6g-gp c6g-p))))
(notation! 'RECIP-GAMMA 'kind 'constant 'arity 0 'english "the reciprocal of the Gamma function")
(define (c6g-aval! k)                            ; a_k = -(k + 1)
  (let* ((s (list 'succ k)) (e (list '= (list c6g-a k) (list '- s))))
    (c6g-pos! s) (c6-rr! (list '- s)) (fact 'rr-subset-cc (list '- s)) (fact 'fun-apply-type-c c6g-a 'NN 'CC k)
    (if (not (dk-asm? e)) (dk-have! e (lambda () (dk-lam-b!) (c6f-rfl-close!))))
    e))

(sp (make-wff (list 'AND '(HOLOMORPHIC-ON CC RECIP-GAMMA)
  (list 'AND '(FORALL egn_ (IMPLIES (IN egn_ NN) (HAS-ZERO-OF-ORDER CC RECIP-GAMMA (- egn_) 1)))
             '(FORALL egw_ (IMPLIES (IN egw_ CC) (IMPLIES (FORALL egn_ (IMPLIES (IN egn_ NN) (NOT (= egw_ (- egn_)))))
                                                          (NOT (= (RECIP-GAMMA egw_) 0)))))))))
(fact 'recip-gamma-def)
(subst (list '= 'RECIP-GAMMA (c6g-gp c6g-p)))
(c6w-cc-setup!) (fact 'nn-is-set) (c6g-one!)
(c6g-a-typ!) (c6g-mu-typ!)
(fact 'gamma-zeros-nonzero) (fact 'gamma-zeros-grow) (fact 'gamma-zeros-h167)
(let* ((t620 (c6-cite! 'theorem-6-20 c6g-a c6g-mu))
       (parts (dk-split-all! (list t620)))
       (holp (list 'HOLOMORPHIC-ON 'CC c6g-p))
       (zi (find-first (lambda (q) (c6-op? q 'FORALL 3)) (dk-asms)))
       (mult (c6-cite! 'theorem-6-20-multiplicity-fam c6g-a c6g-mu)))
  (dk-cite! 'holomorphic-on-in-fun 'CC c6g-p)
  (let* ((zi0 (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'IFF) (dk-contains? q c6g-p))) (dk-asms)))
         (pv (dk-name! c6g-p '(FUN CC CC)))
         (holv (dk-rewrite-h! holp c6g-p pv)) (ziv (dk-rewrite-h! zi0 c6g-p pv)) (mulv (dk-rewrite-h! mult c6g-p pv))
         (gg (c6g-gp pv)))
    (subst (list '= c6g-p pv))
    (c6-cite! 'gamma-g-holomorphic pv)
    (let ((z0 (list '- 0)))
      (c6-rr! z0) (dk-have! (list '= z0 0) (lambda () (dk-ineq!))))
    ;; the zeros, each of order 1
    (dk-have! (list 'FORALL 'egn_ (list 'IMPLIES '(IN egn_ NN) (list 'HAS-ZERO-OF-ORDER 'CC gg '(- egn_) 1)))
      (lambda ()
        (let ((n (dk-di-var!)))
          (c6-nn! n)
          (use-em (list '= n 0)
            (lambda ()
              (subst (list '= n 0)) (subst '(= (- 0) 0))
              (let ((iz (dk-apply! ziv 0)))
                (fact 'fun-apply-type-c pv 'CC 'CC 0)
                (dk-have! (list 'NOT (caddr iz))
                  (lambda () (di)
                    (let* ((q (c6-sk! (caddr iz))) (av (c6g-aval! q)))
                      (dk-absurd! (dk-rewrite-h! (list '= 0 (list c6g-a q)) (list c6g-a q) (list '- (list 'succ q))) (list '< 0 (list 'succ q))))))
                (dk-have! (list 'NOT (cadr iz)) (lambda () (keep iz (list 'NOT (caddr iz))) (prop))))
              (c6-cite! 'gamma-g-order-at-zero pv)
              (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))
            (lambda ()
              (let* ((zs (c6-cite! 'nn-zero-or-succ n)) (ex (caddr zs)))
                (dk-have! ex (lambda () (keep zs (list 'NOT (list '= n 0))) (prop)))
                (let* ((m (c6-sk! ex)) (sm (list 'succ m)) (z (list '- sm)) (cnt (list 'COUNT-HITS c6g-a z sm)) (c0 (list 'COUNT-HITS c6g-a z m)))
                  (c6-nn! m) (fact 'nn-succ-closed m) (c6-nn! sm) (fact 'nn-succ-plus-one m)
                  (subst (list '= n sm))
                  (c6g-aval! m)
                  (dk-have! (list 'FORALL 'c6q_ (list 'IMPLIES '(IN c6q_ NN) (list 'IMPLIES (list '<= sm 'c6q_) (list 'NOT (list '= (list c6g-a 'c6q_) z)))))
                    (lambda () (let* ((nq (c6-steps!)) (q (find-first (lambda (v) (not (eq? v m))) (c6-vars nq 'NN))))
                                 (c6-nn! q) (fact 'nn-succ-plus-one q) (c6g-aval! q)
                                 (dk-lam-b!) (di)
                                 (dk-absurd! (list '= (list '- (list 'succ q)) z) (list '<= sm q) (list '= sm (list '+ m 1)) (list '= (list 'succ q) (list '+ q 1))))))
                  (dk-have! (list 'FORALL 'egq_ (list 'IMPLIES '(IN egq_ NN) (list 'IMPLIES (list '< 'egq_ m) (list 'NOT (list '= (list c6g-a 'egq_) z)))))
                    (lambda () (let* ((nq (c6-steps!)) (q (find-first (lambda (v) (not (eq? v m))) (c6-vars nq 'NN))))
                                 (c6-nn! q) (fact 'nn-succ-plus-one q) (c6g-aval! q)
                                 (dk-lam-b!) (di)
                                 (dk-absurd! (list '= (list '- (list 'succ q)) z) (list '< q m) (list '= sm (list '+ m 1)) (list '= (list 'succ q) (list '+ q 1))))))
                  (let ((hz (dk-apply! mulv z sm)))
                    (dk-have! (list '= cnt 1)
                      (lambda ()
                        (c6-cite! 'count-hits-none m c6g-a z)
                        (dk-cite! 'count-hits-in-nn m c6g-a z)
                        (subst (dk-fact! 'count-hits-succ c6g-a z m))
                        (dk-if-branch! #t (list 'IF (list '= (list c6g-a m) z) (list 'succ c0) c0) #f
                          (lambda () (subst (list '= c0 0)) (subst '(= (succ 0) 1)) (c6f-rfl-close!)))))
                    (dk-rewrite-h! hz cnt 1)
                    (dk-have! (list 'NOT (list '= z 0)) (lambda () (di) (dk-absurd! (list '= z 0) (list '< 0 sm))))
                    (c6-cite! 'gamma-g-order-at-p-zero pv z)
                    (dk-close-if! (lambda () #t) (lambda () (dk-ass!)))))))))))
    ;; no other zeros
    (dk-have! (list 'FORALL 'egw_ (list 'IMPLIES '(IN egw_ CC) (list 'IMPLIES '(FORALL egn_ (IMPLIES (IN egn_ NN) (NOT (= egw_ (- egn_)))))
                                                                   '(NOT (= (RECIP-GAMMA egw_) 0)))))
      (lambda ()
        (let* ((new (c6-steps!)) (w (c6-var new 'CC)) (hw (find-first (lambda (q) (c6-op? q 'FORALL 3)) new)))
          (fact 'nn-zero-in)
          (dk-rewrite-h! (dk-apply! hw 0) '(- 0) 0)
          (let ((iz (dk-apply! ziv w)))
            (fact 'fun-apply-type-c pv 'CC 'CC w)
            (dk-have! (list 'NOT (caddr iz))
              (lambda () (di)
                (let* ((q (c6-sk! (caddr iz))) (av (c6g-aval! q)))
                  (dk-rewrite-h! (list '= w (list c6g-a q)) (list c6g-a q) (list '- (list 'succ q)))
                  (fact 'nn-succ-closed q)
                  (dk-apply! hw (list 'succ q))
                  (ai (list 'NOT (list '= w (list '- (list 'succ q))))))))
            (dk-have! (list 'NOT (cadr iz)) (lambda () (keep iz (list 'NOT (caddr iz))) (prop))))
          (c6-cite! 'gamma-g-nonzero pv w)
          (subst (dk-cite! 'apply-congruence-1 'RECIP-GAMMA (c6g-gp c6g-p) w))
          (subst (list '= c6g-p pv))
          (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))))
    (dk-conj-close! (lambda () (dk-ass!)))))
(qed 'proposition-6-28)
  
