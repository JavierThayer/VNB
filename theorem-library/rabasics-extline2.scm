;;; rabasics-extline2.scm -- calculus.pdf 1.13, last sentence: x |-> x / (1 - |x|) extends to an order
;;; preserving bijection of [-1, 1] onto the extended line RR-STAR, sending 1 to POS-INF and -1 to
;;; NEG-INF.
;;;
;;;   rr-star-is-set                RR-STAR is a set (RR u {POS-INF, NEG-INF})
;;;   ccint-unit-cases              x in [-1, 1]  =>  x = 1 or x = -1 or x in (-1, 1)
;;;   ccint-rr-star-iso-extends     F(x) = x / (1 - |x|) on (-1, 1)
;;;   ccint-rr-star-iso-bijection   F in BIJECTION([-1, 1], RR-STAR); the inverse is
;;;                                 G(y) = 1, -1, y / (1 + |y|) for y = POS-INF, NEG-INF, real
;;;   ccint-rr-star-iso-strict      x < y in [-1, 1]  =>  F(x) < F(y)
;;;   ccint-rr-star-order-iso       IS-ORDER-ISO(F, [-1, 1], RR-STAR)  (rabasics-vocab)
;;; with F = VNB-LAMBDA(x, [-1, 1], IF(x = 1, POS-INF, IF(x = -1, NEG-INF, x / (1 - |x|)))).
;;;
;;; "Order preserving" is proven as STRICT monotonicity (< on RR-STAR is <= and /=, by the
;;; definition of <).  (Updated 2026-10-27: the converse F(x) <= F(y) => x <= y was not derivable
;;; when this file was written; since the RR-STAR order primitives of 2026-10-26 it is proven,
;;; as ccint-rr-star-iso-reflects / ccint-rr-star-iso-le-iff in theorem-library/extorder-iso.scm.)
;;;
;;; Library: analysis (RR-STAR is structure-library/extended-reals).  Load window: after
;;; rabasics-extline (the ooint-rr-iso lemmas), theorem-library/rake-infinity-points
;;; (pos-inf-in-rr-star, pos-inf-not-in-rr, pos-inf-neq-neg-inf, rr-subset-rr-star); no citer yet.
;;; Helper prefix: rb2-.

(define (rb2-find what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "rb2-find: nothing matching" what) (car l))))

(define rb2-dom '(CCINT (- 1) 1))
(define rb2-oo '(OOINT (- 1) 1))
(define (rb2-fterm x) (list 'IF (list '= x 1) 'POS-INF (list 'IF (list '= x '(- 1)) 'NEG-INF (list '/ x (list '- 1 (list 'abs x))))))
(define (rb2-gterm y) (list 'IF (list '= y 'POS-INF) 1 (list 'IF (list '= y 'NEG-INF) '(- 1) (list '/ y (list '+ 1 (list 'abs y))))))
(define rb2-F (list 'VNB-LAMBDA 'x rb2-dom (rb2-fterm 'x)))
(define rb2-G (list 'VNB-LAMBDA 'y 'RR-STAR (rb2-gterm 'y)))
(define (rb2-const? t) (memq t '(POS-INF NEG-INF)))

;;; land (NOT (= a b)); EXTRA are linear premises (formulas in context) for the real-real case
(define (rb2-neq! a b . extra)
  (let ((goal (list 'NOT (list '= a b))))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (di)                                            ; (= a b) assumed, goal FALSITY
            (let ((e (list '= a b)))
              (cond ((and (rb2-const? a) (rb2-const? b))
                     (fact 'pos-inf-neq-neg-inf)
                     (if (eq? a 'POS-INF)
                         (begin (if (dk-only! e '(NOT (= POS-INF NEG-INF))) (prop)))
                         (begin
                           (dk-have! '(= POS-INF NEG-INF) (lambda () (subst (list '= 'POS-INF 'NEG-INF)) (rfl)))
                           (if (dk-only! '(= POS-INF NEG-INF) '(NOT (= POS-INF NEG-INF))) (prop)))))
                    ((or (rb2-const? a) (rb2-const? b))
                     (let* ((c (if (rb2-const? a) a b)) (r (if (rb2-const? a) b a)))
                       (if (eq? c 'POS-INF) (fact 'pos-inf-not-in-rr) (fact 'neg-inf-not-in-rr))
                       (dk-have! (list 'IN c 'RR) (lambda () (subst (list '= c r)) (ass)))
                       (if (dk-only! (list 'IN c 'RR) (list 'NOT (list 'IN c 'RR))) (prop))))
                    (#t (apply dk-absurd! e extra)))))))))

;;; close ANY goal from contradictory linear premises (named by formula)
(define (rb2-contra! . prems)
  (fact 'rr-zero-in)
  (fact 'rr-lt-irrefl 0)
  (dk-have! '(< 0 0) (lambda () (apply dk-ineq! prems)))
  (if (dk-only! '(< 0 0) '(NOT (< 0 0))) (prop)))

;;; use-cases that skips a branch hash-consing already grounded (a positional body would run on
;;; whatever leaf the focus fell back to)
(define (rb2-use-cases! disjuncts . bodies)
  (let* ((result (use-cases disjuncts))
         (ob     (cases-obligation result))
         (cs     (cdr (assq 'cases result))))
    (if ob (error "rb2-use-cases!: the disjunction is not in context" disjuncts))
    (if (not (= (length cs) (length bodies)))
        (error "rb2-use-cases!: branch count" (length cs) (length bodies)))
    (for-each (lambda (mc body)
                (if (not (sequent-node-grounded? (cdr mc)))
                    (begin (dk-focus! (cdr mc)) (body))))
              cs bodies)))

;;; the first (IF ...) subterm of T, outermost first
(define (rb2-first-if t)
  (cond ((not (pair? t)) #f)
        ((and (eq? (car t) 'IF) (= (length t) 4)) t)
        (#t (let loop ((l (cdr t)))
              (cond ((null? l) #f)
                    ((rb2-first-if (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
;;; resolve the first IF of the goal on side TRUE?; the condition (or its negation) must be in
;;; context, or (= c c)-closable by rfl
(define (rb2-if! true?)
  (let ((ift (rb2-first-if (dk-goal))))
    (if (not ift) (error "rb2-if!: no IF in the goal" (dk-goal)))
    (dk-if-branch! true? ift
                   (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))
                   (lambda () #t))))

;;; ---------------------------------------------------------------------------
(sp (make-wff '(IN RR-STAR SET)))
(define rb2-pr '(PAIR POS-INF NEG-INF))
(define rb2-un (list 'UNION 'RR rb2-pr))
(fact 'rr-is-set)
(fact 'pos-inf-in-rr-star)
(fact 'neg-inf-in-rr-star)
(fact 'membership-implies-sethood 'POS-INF 'RR-STAR)
(fact 'membership-implies-sethood 'NEG-INF 'RR-STAR)
(dk-have! '(AND (IN POS-INF SET) (IN NEG-INF SET)))
(fact 'pairing 'POS-INF 'NEG-INF)
(dk-have! (list 'AND '(IN RR SET) (list 'IN rb2-pr 'SET)))
(fact 'union-set-closure 'RR rb2-pr)
(dk-have! (list 'SUBSET 'RR-STAR rb2-un)
  (lambda ()
    (mac 'subset-def)
    (let* ((pl (dk-peel!))
           (y  (cadr (car (filter (lambda (f) (eq? (car f) 'IN)) pl))))
           (pm (dk-fact! 'pairing-membership 'POS-INF 'NEG-INF y)))
      (mac-h 'rr-star-membership (list 'IN y 'RR-STAR))
      (mac 'union-membership)
      (if (dk-only! pm (list 'OR (list 'IN y 'RR) (list 'OR (list '= y 'POS-INF) (list '= y 'NEG-INF)))) (prop)))))
(fact 'subclass-of-set-is-set 'RR-STAR rb2-un)
(ass)
(qed 'rr-star-is-set)

(sp (make-wff '(FORALL x (IMPLIES (IN x (CCINT (- 1) 1))
                 (OR (= x 1) (OR (= x (- 1)) (IN x (OOINT (- 1) 1))))))))
(dk-peel!)
(let* ((x (cadr (rb2-find 'x (lambda (f) (and (eq? (car f) 'IN) (equal? (caddr f) rb2-dom))))))
       (h (list 'IN x rb2-dom)))
  (dk-project! (list 'IN x 'RR) 'ccint-membership h)
  (dk-project! (list '<= '(- 1) x) 'ccint-membership h)
  (dk-project! (list '<= x 1) 'ccint-membership h)
  (fact 'rr-one-in)
  (fact 'rr-neg-closed 1)
  (fact 'rr-le-cases x 1)
  (fact 'rr-le-cases '(- 1) x)
  (use-cases (list (list '< x 1) (list '= x 1))
    (lambda ()
      (use-cases (list (list '< '(- 1) x) (list '= '(- 1) x))
        (lambda ()
          (oi-r) (oi-r)
          (mac 'ooint-membership)
          (for-each (lambda (l) (dk-focus! l) (if (eq? (car (dk-goal)) 'AND)
                                                 (for-each (lambda (l2) (dk-focus! l2) (ass)) (dk-opened (lambda () (di))))
                                                 (ass)))
                    (dk-opened (lambda () (di)))))
        (lambda ()
          (oi-r) (oi-l)
          (subst (list '= x '(- 1)))
          (rfl))))
    (lambda () (oi-l) (ass))))
(qed 'ccint-unit-cases)

;;; x in [-1, 1] in context: split into the three cases; THUNKS are run on each with the case's
;;; facts landed: case 1: (= x 1); case -1: (= x (- 1)), (NOT (= x 1)); interior: x in (-1, 1),
;;; x in RR, |x| < 1, (NOT (= x 1)), (NOT (= x (- 1))), f(x) typed.
(define (rb2-cases! x one! mone! inner!)
  (dk-project! (list 'IN x 'RR) 'ccint-membership (list 'IN x rb2-dom))
  (fact 'ccint-unit-cases x)
  (fact 'rr-one-in)
  (fact 'rr-neg-closed 1)
  (rb2-use-cases! (list (list '= x 1) (list '= x '(- 1)) (list 'IN x rb2-oo))
    (lambda () (one!))
    (lambda ()
      (dk-have! (list 'NOT (list '= x 1))
        (lambda () (di) (dk-absurd! (list '= x 1) (list '= x '(- 1)))))
      (mone!))
    (lambda ()
      (let ((h (list 'IN x rb2-oo)))
        (dk-project! (list 'IN x 'RR) 'ooint-membership h)
        (dk-project! (list '< '(- 1) x) 'ooint-membership h)
        (dk-project! (list '< x 1) 'ooint-membership h)
        (fact 'rr-abs-lt-of-parts x 1)
        (rb2-neq! x 1 (list '< x 1))
        (rb2-neq! x '(- 1) (list '< '(- 1) x))
        (fact 'ooint-rr-iso-f-real x)
        (let ((fx (list '/ x (list '- 1 (list 'abs x)))))
          (dk-have! (list 'IN fx 'RR) (lambda () (mac 'binary-divide-def) (ass)))
          (inner! fx))))))

;;; y in RR-STAR in context: three cases; thunks get: POS-INF case (= y POS-INF); NEG-INF case
;;; (= y NEG-INF), (NOT (= y POS-INF)); real case y in RR, both NOTs, g(y) typed and in (-1, 1).
(define (rb2-star-cases! y pinf! ninf! real!)
  (dk-project! (list 'OR (list 'IN y 'RR) (list 'OR (list '= y 'POS-INF) (list '= y 'NEG-INF)))
               'rr-star-membership (list 'IN y 'RR-STAR))
  (rb2-use-cases! (list (list 'IN y 'RR) (list '= y 'POS-INF) (list '= y 'NEG-INF))
    (lambda ()
      (rb2-neq! y 'POS-INF)
      (rb2-neq! y 'NEG-INF)
      (fact 'ooint-rr-iso-right-inverse y)
      (dk-split-all!)
      (let ((gy (list '/ y (list '+ 1 (list 'abs y)))))
        (real! gy)))
    (lambda () (pinf!))
    (lambda ()
      (dk-have! (list 'NOT (list '= y 'POS-INF))
        (lambda ()
          (di)
          (fact 'pos-inf-neq-neg-inf)
          (dk-have! '(= POS-INF NEG-INF) (lambda () (subst (list '= 'POS-INF y)) (ass)))
          (if (dk-only! '(= POS-INF NEG-INF) '(NOT (= POS-INF NEG-INF))) (prop))))
      (ninf!))))

;;; ---------------------------------------------------------------------------
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u rb2-oo)
                 (list '= (list rb2-F 'u) (list '/ 'u (list '- 1 (list 'abs 'u))))))))
(dk-peel!)
(let ((u (cadr (rb2-find 'u (lambda (f) (and (eq? (car f) 'IN) (equal? (caddr f) rb2-oo)))))))
  (fact 'rr-one-in) (fact 'rr-neg-closed 1)
  (dk-project! (list 'IN u 'RR) 'ooint-membership (list 'IN u rb2-oo))
  (dk-project! (list '< u 1) 'ooint-membership (list 'IN u rb2-oo))
  (dk-project! (list '< '(- 1) u) 'ooint-membership (list 'IN u rb2-oo))
  (fact 'ooint-subset-ccint '(- 1) 1)
  (mac-h 'subset-def (list 'SUBSET rb2-oo rb2-dom))
  (inst+ (rb2-find 'sub (lambda (f) (eq? (car f) 'FORALL))) u)
  (dk-lam-b!)
  (rb2-neq! u 1 (list '< u 1))
  (rb2-neq! u '(- 1) (list '< '(- 1) u))
  (fact 'rr-abs-lt-of-parts u 1)
  (fact 'ooint-rr-iso-f-real u)
  (dk-have! (list 'IN (list '/ u (list '- 1 (list 'abs u))) 'RR) (lambda () (mac 'binary-divide-def) (ass)))
  (rb2-if! #f)
  (rb2-if! #f)
  (rfl))
(qed 'ccint-rr-star-iso-extends)

;;; ---------------------------------------------------------------------------
;;; the IF subterm of the goal whose CONDITION is COND; resolve it on side TRUE?
(define (rb2-find-if t cnd)
  (cond ((not (pair? t)) #f)
        ((and (eq? (car t) 'IF) (= (length t) 4) (equal? (cadr t) cnd)) t)
        (#t (let loop ((l t))
              (cond ((null? l) #f)
                    ((rb2-find-if (car l) cnd) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
(define (rb2-if-on! cnd true?)
  (let ((ift (rb2-find-if (dk-goal) cnd)))
    (if (not ift) (error "rb2-if-on!: no IF with condition" cnd (dk-goal)))
    (dk-if-branch! true? ift
                   (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))
                   (lambda () #t))))
;;; resolve F's two IFs at x on the case: 'one, 'mone or 'inner
(define (rb2-F-at! x case)
  (cond ((eq? case 'one)  (rb2-if-on! (list '= x 1) #t))
        ((eq? case 'mone) (rb2-if-on! (list '= x 1) #f) (rb2-if-on! (list '= x '(- 1)) #t))
        (#t               (rb2-if-on! (list '= x 1) #f) (rb2-if-on! (list '= x '(- 1)) #f))))
;;; resolve G's two IFs at y on the case: 'pinf, 'ninf or 'real
(define (rb2-G-at! y case)
  (cond ((eq? case 'pinf) (rb2-if-on! (list '= y 'POS-INF) #t))
        ((eq? case 'ninf) (rb2-if-on! (list '= y 'POS-INF) #f) (rb2-if-on! (list '= y 'NEG-INF) #t))
        (#t               (rb2-if-on! (list '= y 'POS-INF) #f) (rb2-if-on! (list '= y 'NEG-INF) #f))))

(define (rb2-star! t)
  (if (not (dk-asm? (list 'IN t 'RR-STAR)))
      (dk-have! (list 'IN t 'RR-STAR) (lambda () (mac 'rr-star-membership) (oi-l) (ass)))))
(define (rb2-oo-to-cc! t)
  (dk-have! (list 'IN t rb2-dom)
    (lambda ()
      (fact 'rr-one-in) (fact 'rr-neg-closed 1)
      (fact 'ooint-subset-ccint '(- 1) 1)
      (mac-h 'subset-def (list 'SUBSET rb2-oo rb2-dom))
      (inst+ (rb2-find 'sub (lambda (f) (and (eq? (car f) 'FORALL) (dk-contains? f 'CCINT)))) t)
      (ass))))
;;; goal (IN c (CCINT (- 1) 1)) for the numerals 1, -1
(define (rb2-const-in-dom!)
  (fact 'rr-one-in) (fact 'rr-neg-closed 1)
  (mac 'ccint-membership)
  (let loop ((todo (list (proof-state-focus *ps*))))
    (if (pair? todo)
        (begin
          (dk-focus! (car todo))
          (if (eq? (car (dk-goal)) 'AND)
              (loop (append (dk-opened (lambda () (di))) (cdr todo)))
              (begin
                (if (eq? (car (dk-goal)) 'IN) (ass) (dk-ineq!))
                (loop (cdr todo))))))))
;;; goal (< a b) on RR-STAR: split by the definition of <, close <= by LE! and /= by rb2-neq!
(define (rb2-lt! a b le!)
  (mac '<)
  (for-each (lambda (leaf)
              (dk-focus! leaf)
              (if (eq? (car (dk-goal)) 'NOT)
                  (rb2-neq! a b)
                  (le!)))
            (dk-opened (lambda () (di)))))

;;; ---------------------------------------------------------------------------
(sp (make-wff (list 'IN rb2-F (list 'BIJECTION rb2-dom 'RR-STAR))))
(fact 'rr-is-set)
(fact 'ccint-subset-rr '(- 1) 1)
(fact 'subclass-of-set-is-set rb2-dom 'RR)
(fact 'rr-star-is-set)
(fact 'pos-inf-in-rr-star)
(fact 'neg-inf-in-rr-star)
(dk-have! (list 'IN rb2-F (list 'FUN rb2-dom 'RR-STAR))
  (lambda ()
    (dk-lam-type!
     (lambda ()
       (let* ((pl (dk-peel!))
              (x  (cadr (car (filter (lambda (f) (eq? (car f) 'IN)) pl)))))
         (rb2-cases! x
           (lambda () (rb2-F-at! x 'one) (ass))
           (lambda () (rb2-F-at! x 'mone) (ass))
           (lambda (fx) (rb2-F-at! x 'inner) (rb2-star! fx)))))
     (lambda () (if (dk-asm? (dk-goal)) (ass))))))
(dk-have! (list 'IN rb2-G (list 'FUN 'RR-STAR rb2-dom))
  (lambda ()
    (dk-lam-type!
     (lambda ()
       (let* ((pl (dk-peel!))
              (y  (cadr (car (filter (lambda (f) (eq? (car f) 'IN)) pl)))))
         (rb2-star-cases! y
           (lambda () (rb2-G-at! y 'pinf) (rb2-const-in-dom!))
           (lambda () (rb2-G-at! y 'ninf) (rb2-const-in-dom!))
           (lambda (gy) (rb2-G-at! y 'real) (rb2-oo-to-cc! gy)))))
     (lambda () (if (dk-asm? (dk-goal)) (ass))))))
(define rb2-bij (dk-fact! 'bijection-from-inverse rb2-dom 'RR-STAR rb2-F rb2-G))
(dk-have! (cadr rb2-bij)
  (lambda ()
    (let* ((pl (dk-peel!))
           (u  (cadr (car (filter (lambda (f) (eq? (car f) 'IN)) pl)))))
      (fact 'fun-apply-type-c rb2-F rb2-dom 'RR-STAR u)
      (dk-lam-b-h! (list 'IN (list rb2-F u) 'RR-STAR))
      (dk-lam-b!)
      (rb2-cases! u
        (lambda ()
          (rb2-F-at! u 'one)
          (rb2-G-at! 'POS-INF 'pinf)
          (subst (list '= u 1)) (rfl))
        (lambda ()
          (rb2-F-at! u 'mone)
          (rb2-neq! 'NEG-INF 'POS-INF)
          (rb2-G-at! 'NEG-INF 'ninf)
          (subst (list '= u '(- 1))) (rfl))
        (lambda (fx)
          (rb2-F-at! u 'inner)
          (rb2-neq! fx 'POS-INF)
          (rb2-neq! fx 'NEG-INF)
          (rb2-G-at! fx 'real)
          (fact 'ooint-rr-iso-left-inverse u)
          (ass))))))
(detach! rb2-bij)
(define rb2-bij2 (caddr rb2-bij))
(dk-have! (cadr rb2-bij2)
  (lambda ()
    (let* ((pl (dk-peel!))
           (v  (cadr (car (filter (lambda (f) (eq? (car f) 'IN)) pl)))))
      (fact 'fun-apply-type-c rb2-G 'RR-STAR rb2-dom v)
      (dk-lam-b-h! (list 'IN (list rb2-G v) rb2-dom))
      (dk-lam-b!)
      (rb2-star-cases! v
        (lambda ()
          (rb2-G-at! v 'pinf)
          (rb2-F-at! 1 'one)
          (subst (list '= v 'POS-INF)) (rfl))
        (lambda ()
          (rb2-G-at! v 'ninf)
          (rb2-neq! '(- 1) 1)
          (rb2-F-at! '(- 1) 'mone)
          (subst (list '= v 'NEG-INF)) (rfl))
        (lambda (gy)
          (rb2-G-at! v 'real)
          (let ((h (list 'IN gy rb2-oo)))
            (dk-project! (list '< gy 1) 'ooint-membership h)
            (dk-project! (list '< '(- 1) gy) 'ooint-membership h)
            (dk-project! (list 'IN gy 'RR) 'ooint-membership h)
            (rb2-neq! gy 1 (list '< gy 1))
            (rb2-neq! gy '(- 1) (list '< '(- 1) gy))
            (rb2-F-at! gy 'inner)
            (ass)))))))
(detach! rb2-bij2)
(if (dk-asm? (dk-goal)) (ass))
(qed 'ccint-rr-star-iso-bijection)

;;; ---------------------------------------------------------------------------
(sp (make-wff
  (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u rb2-dom) (list 'FORALL 'v (list 'IMPLIES (list 'IN 'v rb2-dom)
    (list 'IMPLIES '(< u v) (list '< (list rb2-F 'u) (list rb2-F 'v)))))))))
(dk-peel!)
(let* ((lt (rb2-find 'u<v (lambda (f) (and (eq? (car f) '<) (symbol? (cadr f)) (symbol? (caddr f))))))
       (u (cadr lt)) (v (caddr lt)))
  (dk-project! (list 'IN u 'RR) 'ccint-membership (list 'IN u rb2-dom))
  (dk-project! (list 'IN v 'RR) 'ccint-membership (list 'IN v rb2-dom))
  (dk-project! (list '<= u 1) 'ccint-membership (list 'IN u rb2-dom))
  (dk-project! (list '<= v 1) 'ccint-membership (list 'IN v rb2-dom))
  (dk-project! (list '<= '(- 1) u) 'ccint-membership (list 'IN u rb2-dom))
  (dk-project! (list '<= '(- 1) v) 'ccint-membership (list 'IN v rb2-dom))
  (fact 'pos-inf-in-rr-star)
  (fact 'neg-inf-in-rr-star)
  (dk-lam-b!)
  (rb2-cases! u
    (lambda () (rb2-contra! (list '= u 1) (list '< u v) (list '<= v 1)))
    (lambda ()
      (rb2-F-at! u 'mone)
      (rb2-cases! v
        (lambda ()
          (rb2-F-at! v 'one)
          (rb2-lt! 'NEG-INF 'POS-INF (lambda () (fact 'neg-inf-lower-bound 'POS-INF) (ass))))
        (lambda () (rb2-contra! (list '= u '(- 1)) (list '= v '(- 1)) (list '< u v)))
        (lambda (fv)
          (rb2-F-at! v 'inner)
          (rb2-star! fv)
          (rb2-lt! 'NEG-INF fv (lambda () (fact 'neg-inf-lower-bound fv) (ass))))))
    (lambda (fu)
      (rb2-F-at! u 'inner)
      (rb2-cases! v
        (lambda ()
          (rb2-F-at! v 'one)
          (rb2-star! fu)
          (rb2-lt! fu 'POS-INF (lambda () (fact 'pos-inf-upper-bound fu) (ass))))
        (lambda () (rb2-contra! (list '= v '(- 1)) (list '< u v) (list '<= '(- 1) u)))
        (lambda (fv)
          (rb2-F-at! v 'inner)
          (fact 'ooint-rr-iso-strict u v)
          (ass))))))
(qed 'ccint-rr-star-iso-strict)

;;; ---------------------------------------------------------------------------
(sp (make-wff (list 'IS-ORDER-ISO rb2-F rb2-dom 'RR-STAR)))
(mac 'is-order-iso)
(for-each
 (lambda (leaf)
   (dk-focus! leaf)
   (if (eq? (car (dk-goal)) 'IN)
       (begin (fact 'ccint-rr-star-iso-bijection) (ass))
