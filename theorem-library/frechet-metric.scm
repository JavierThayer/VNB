;;; (IN v (CARR (SCAL m))) from (IN v (CARR fld)); needs (= (SCAL m) view) and the
;;; carrier read-off in context
(define (frm-sc! v)
  (let ((ty (list 'IN v '(CARR (SCAL m)))))
    (frm-once! ty
      (lambda ()
        (dk-rewrite-h! (dk-rewrite-h! (list 'IN v '(CARR fld)) '(CARR fld) (list 'CARR frm-nfv))
                       frm-nfv '(SCAL m))))
    ty))

(sp (make-wff (frm-fstmt
  (forall-guarded 'ss '(IN ss (FUN NN (CARR fld)))
   (forall-guarded 'sx '(IN sx (FUN NN (VEC m)))
    (forall-guarded 'sl '(IN sl (CARR fld))
     (forall-guarded 'x '(IN x (VEC m))
      (list 'IMPLIES (list 'CONVERGES-TO frm-nfms 'ss 'sl)
        (list 'IMPLIES '(CONVERGES-TO (FR-METRIC-SPACE m fam) sx x)
          (list 'CONVERGES-TO frm-fms frm-act-seq (frm-act 'm 'sl 'x)))))))))))
(dk-peel!)
(dk-cite! 'frm-fam-module 'fld 'm 'fam)
(dk-cite! 'frm-fam-field 'fld 'm 'fam)
(dk-cite! 'frm-fam-scal 'fld 'm 'fam)
(dk-cite! 'normed-field-ring-view-carr 'fld)
(dk-cite! 'normed-field-ring-view-add 'fld)
(dk-cite! 'normed-field-ring-view-neg 'fld)
(dk-cite! 'module-scalar-ring 'm)
(let* ((fa (dk-cite! 'frm-conv-of-converges 'fld 'm 'fam 'sx 'x))
       (cs (list 'CONVERGES-TO frm-nfms 'ss 'sl))
       (su (frm-landed-last (lambda () (mac-h 'converges-to cs) (dk-split-all!))))
       (su (frm-pick-forall-with 'NF-METRIC-SPACE "the scalar eps-universal"))
       (slx (frm-act 'm 'sl 'x))
       (nsl '((NEG fld) sl)))
  (frm-sc! 'sl)
  (dk-cite! 'module-act-type 'm 'sl 'x)
  (dk-cite! 'nf-norm-in-rr 'fld 'sl)
  (dk-cite! 'nf-norm-nonneg 'fld 'sl)
  (dk-cite! 'nf-neg-in-carr 'fld 'sl)
  (dk-have! (list 'IN frm-act-seq '(FUN NN (VEC m)))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((i (cadr (car (dk-peel!)))))
