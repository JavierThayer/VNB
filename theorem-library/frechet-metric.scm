                 (dk-cite! 'nn-in-rr i)
                 (dk-cite! 'fun-apply-type-c 'ss 'NN '(CARR fld) i)
                 (frm-sc! r)
                 (frm-seq-at! 'sx i)
                 (dk-lam-b!)
                 (subst (dk-cite! 'frm-act-diff 'm r 'sl xi 'x))
                 ;; typings
                 (frm-vec! 'm u)
                 (dk-cite! 'ring-neg-in-carr '(SCAL m) 'sl)
                 (dk-have! (list 'AND '(IS-RING (SCAL m)) (list 'AND (list 'IN r '(CARR (SCAL m)))
                                  '(IN ((NEG (SCAL m)) sl) (CARR (SCAL m)))))
                           (lambda () (dk-conj-close! ass)))
                 (dk-cite! 'ring-carrier-closed-add '(SCAL m) r '((NEG (SCAL m)) sl))
                 (dk-cite! 'module-act-type 'm r u)
                 (dk-cite! 'module-act-type 'm rs 'x)
                 (frm-p-real! k u) (frm-p-real! k uu) (frm-p-real! k vv) (frm-p-real! k (frm-add 'm uu vv))
                 (dk-cite! 'nf-norm-in-rr 'fld r)
                 (dk-cite! 'nf-add-in-carr 'fld r nsl)
                 (dk-cite! 'nf-norm-in-rr 'fld (list '(ADD fld) r nsl))
                 (dk-cite! 'nf-norm-nonneg 'fld (list '(ADD fld) r nsl))
                 (let* ((sub (dk-apply! (dk-cite! 'frm-sn-subadd 'fld 'm p) uu vv))
                        (hu (dk-cite! 'frm-sn-homog 'fld 'm p))
                        (h1 (dk-apply! hu r u))
                        (h2a (dk-apply! hu rs 'x))
                        (bbs (list '(FNRM fld) rs))
                        (_ (dk-have! (list '= bbs bb)
                             (lambda () (subst (list '= '(SCAL m) frm-nfv))
                                        (subst (list '== (list 'ADD frm-nfv) '(ADD fld)))
                                        (subst (list '== (list 'NEG frm-nfv) '(NEG fld)))
                                        (rfl))))
                        (h2 (dk-rewrite-h! h2a bbs bb))
                        (anon (dk-apply! (dk-cite! 'frm-sn-nonneg 'fld 'm p) u))
                        ;; the scalar thresholds at i
                        (_ (for-each (lambda (c)
                                       (dk-have! (list '<= (car c) i)
                                         (lambda () (dk-ineq! (list '<= (car c) m1) (list '<= m1 mx) (list '<= mx i))))
                                       (dk-have! (list 'AND (list 'IN i 'NN) (list '<= (car c) i))
                                         (lambda () (dk-close-all! (lambda () (di))))))
                                     (list cx c1)))
                        (_ (dk-have! (list '<= (car c2) i) (lambda () (dk-ineq! (list '<= (car c2) mx) (list '<= mx i)))))
                        (ax (dk-apply! (cdr cx) i))                      ; p(u) < d1
                        (dist (dk-cite! 'nf-metric-distance 'fld r 'sl))
                        (b1 (dk-rewrite-h! (dk-apply! (cdr c1) i) (cadr dist) (caddr dist)))   ; B <= 1
                        (b2 (dk-rewrite-h! (dk-apply! (cdr c2) i) (cadr dist) (caddr dist)))   ; B <= d2
                        (tri (dk-cite! 'nf-norm-le-add 'fld r 'sl))                           ; A <= B + |sl|
                        (_ (dk-have! (list '<= aa cc)
                             (lambda () (dk-ineq! tri b1 (list '= cc (list '+ '((FNRM fld) sl) 1))))))
                        (_ (dk-have! (list '<= av d1) (lambda () (dk-ineq! ax))))
                        (ca (dk-apply! s1 av))                                  ; cc * p(u) <= e4
                        (aca (dk-cite! 'rr-mul-le-right aa cc av))              ; A p(u) <= cc p(u)
                        (pb (dk-apply! s2 bb))                                  ; p(x) B <= e4
                        (_ (dk-have! (list 'AND (list 'IN bb 'RR) (list 'IN pv 'RR)) (lambda () (dk-conj-close! ass))))
                        (cm (dk-cite! 'rr-mul-comm bb pv)))
