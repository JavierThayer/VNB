  (dk-have! (list 'FR-CONV 'm 'fam frm-act-seq slx)
    (lambda ()
      (mac 'fr-conv)
      (let* ((landed (dk-peel!))
             (k (cadr (find-first (dk-head? 'IN) landed)))
             (e (cadr (find-first (dk-head? 'POS-RR) landed)))
             (e2 (begin (dk-cite! 'rr-pos-rr-in-rr e) (dk-halve! e)))
             (e4 (dk-halve! e2))
