                   (let* ((n1 (dk-name! (list '* aa av))) (n2 (dk-name! (list '* cc av)))
                          (n3 (dk-name! (list '* bb pv))) (n4 (dk-name! (list '* pv bb)))
                          (rw (lambda (f) (fold-left (lambda (f pr) (if (dk-contains? f (car pr))
