      (dk-landed (lambda () (detach! (list 'IMPLIES rhs lhs))))
      (let* ((cu (begin (mac-h 'is-continuous-at lhs) (dk-split-all!)
                        (frm-pick-forall-with 'DIST "the epsilon-delta clause")))
             (_ (begin (dk-cite! 'rr-one-in) (dk-cite! 'rr-zero-lt-one) (dk-cite! 'rr-pos-rr-of-lt 1)))
             (dl2 (dk-skolem! (dk-apply! (dk-cite! 'frm-ball-seminorm 'fld 'm2 'fam2) kk 1)))
             (bl2 (frm-pick-forall-with dl2 "the codomain ball"))
             (h (begin (dk-cite! 'rr-pos-rr-in-rr dl2) (dk-halve! dl2)))
             (de (dk-skolem! (dk-apply! cu h)))
             (bu (frm-pick-forall-with de "the delta universal"))
             (ex1 (dk-apply! (dk-cite! 'frm-seminorm-ball 'fld 'm1 'fam1) de))
             (nb (dk-skolem! ex1))
             (dl (dk-skolem! (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORSOME) (dk-contains? f nb)))
                                      "the dl existential")))
             (ub (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f dl)
                                           (dk-contains? f 'DIST)))
                          "the prefix-ball universal")))
        (ew nb)
        (for-each
         (lambda (leaf)
           (dk-focus! leaf)
           (if (dk-head-is? (dk-goal) 'IN)
               (ass)
               (begin
                 (ew dl)
                 (for-each
                  (lambda (leaf2)
                    (dk-focus! leaf2)
                    (if (dk-head-is? (dk-goal) 'POS-RR)
                        (ass)
                        (let* ((ls (dk-peel!))
                               (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC m1)))) ls)))
                               (hx (find-first (dk-head? 'FORALL) ls))
                               (tx (list 'tt x)))
                          (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) x)
                          (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'IMPLIES (list '<= 'j nb)
                                      (list '< (list '(fam1 j) (frm-sub 'm1 x z1)) dl))))
                            (lambda ()
                              (let ((j (cadr (car (dk-peel!)))))
                                (subst (dk-cite! 'frm-v-sub-zero 'm1 x))
                                (dk-apply! hx j)
                                (ass))))
                          (let* ((px (dk-rewrite-h! (list 'IN x '(VEC m1)) '(VEC m1) (list 'PTS frm-f1)))
                                 (pz (dk-ctx-form (list 'IN z1 (list 'PTS frm-f1))))
                                 (d1 (dk-apply! ub x z1))
                                 (s1 (dk-cite! 'metric-sym frm-f1 x z1))
                                 (d1b (dk-rewrite-h! d1 (cadr s1) (caddr s1)))
                                 (d2 (dk-apply! bu x))
                                 (ptx (dk-rewrite-h! (list 'IN tx '(VEC m2)) '(VEC m2) (list 'PTS frm-f2)))
                                 (ptz (dk-rewrite-h! (list 'IN tz '(VEC m2)) '(VEC m2) (list 'PTS frm-f2)))
                                 (s2 (dk-cite! 'metric-sym frm-f2 tz tx))
                                 (d2b (dk-rewrite-h! d2 (cadr s2) (caddr s2)))
                                 (dr (dk-cite! 'metric-dist-real frm-f2 tx tz))
                                 (lt (dk-have! (list '< (caddr s2) dl2)
                                       (lambda () (dk-ineq! d2b (list '= (list '+ h h) dl2) (list '< 0 h)))))
                                 (q (dk-apply! bl2 tx tz))
                                 (q1 (dk-rewrite-h! q tz '(VZERO m2)))
                                 (sz (dk-cite! 'frm-v-sub-zero 'm2 tx))
                                 (q2 (dk-rewrite-h! q1 (cadr sz) tx)))
                            (ass)))))
                  (dk-opened (lambda () (di)))))))
         (dk-opened (lambda () (di))))))))
(qed 'frm-cont-lin-nbhd)

;;; =====================================================================
;;; (15) A NON-TRIVIALLY VALUED FIELD HAS SCALARS OF EVERY SIZE, UP TO |c|:
;;;      for u, v > 0 some s has  |s| v < u <= |c| |s| v  (frm-nf-bracket).
;;;      The book rescales by the real delta r^-1; over a normed field the
;;;      powers c^n, b^n (b = c^-1) bracket the ratio u / v instead.  The
;;;      ladder (frm-nf-ladder) is the induction: at stage n it holds
;;;      sc = c^n, sb = b^n with |sc| |sb| = 1, the Bernoulli bound
;;;      |sc| >= 1 + n(|c| - 1), and the bracket for every ratio in
;;;      (1, |sc|] (UP) and in (|sb|, 1] (DN).  No least-number principle.
;;; =====================================================================

(define (frm-nfn t) (list '(FNRM fld) t))
(define frm-g '((FNRM fld) c))
(define (frm-brk u v)
  (list 'FORSOME 'fbs_ (list 'AND '(IN fbs_ (CARR fld))
    (list 'AND (list '< (list '* '((FNRM fld) fbs_) v) u)
               (list '<= u (list '* frm-g (list '* '((FNRM fld) fbs_) v)))))))
(define (frm-up sc)
  (forall-guarded 'fbu_ '(IN fbu_ RR) (forall-guarded 'fbv_ '(IN fbv_ RR)
    (list 'IMPLIES '(< 0 fbu_) (list 'IMPLIES '(< 0 fbv_) (list 'IMPLIES '(< fbv_ fbu_)
      (list 'IMPLIES (list '<= 'fbu_ (list '* (frm-nfn sc) 'fbv_)) (frm-brk 'fbu_ 'fbv_))))))))
(define (frm-dn sb)
  (forall-guarded 'fbu_ '(IN fbu_ RR) (forall-guarded 'fbv_ '(IN fbv_ RR)
    (list 'IMPLIES '(< 0 fbu_) (list 'IMPLIES '(< 0 fbv_)
      (list 'IMPLIES (list '< (list '* (frm-nfn sb) 'fbv_) 'fbu_)
        (list 'IMPLIES '(<= fbu_ fbv_) (frm-brk 'fbu_ 'fbv_))))))))
(define (frm-ladder-at n)
  (list 'FORSOME 'fsc_ (list 'AND '(IN fsc_ (CARR fld))
    (list 'FORSOME 'fsb_ (list 'AND '(IN fsb_ (CARR fld))
      (list 'AND (list '= (list '* '((FNRM fld) fsc_) '((FNRM fld) fsb_)) 1)
        (list 'AND '(<= 1 ((FNRM fld) fsc_))
          (list 'AND (list '<= (list '+ 1 (list '- (list '* n frm-g) n)) '((FNRM fld) fsc_))
            (list 'AND (frm-up 'fsc_) (frm-dn 'fsb_))))))))))
(define (frm-field-hyps body)
  (list 'FORALL 'fld (list 'IMPLIES '(IS-NORMED-FIELD fld)
    (forall-guarded 'c '(IN c (CARR fld)) (forall-guarded 'b '(IN b (CARR fld))
      (list 'IMPLIES (list '< 1 frm-g) (list 'IMPLIES '(= ((MUL fld) c b) (ONE fld)) body)))))))

;;; |1| = 1 in a normed field with an element of nonzero norm (no 0 /= 1 needed)
(sp (make-wff (list 'FORALL 'fld (list 'IMPLIES '(IS-NORMED-FIELD fld)
  (forall-guarded 'c '(IN c (CARR fld))
    (list 'IMPLIES (list '< 0 frm-g) '(= ((FNRM fld) (ONE fld)) 1)))))))
(dk-peel!)
(let* ((one '(ONE fld)) (c1 (list '(MUL fld) 'c one)) (o (frm-nfn one)))
  (dk-cite! 'nf-one-in-carr 'fld)
  (dk-cite! 'nf-norm-in-rr 'fld 'c)
  (dk-cite! 'nf-norm-in-rr 'fld one)
  (dk-have! (list '= c1 'c)
    (lambda ()
      (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'fld)
      (dk-cite! 'commutative-ring-is-ring frm-nfv)
      (dk-cite! 'normed-field-ring-view-carr 'fld)
      (dk-cite! 'normed-field-ring-view-mul 'fld)
      (dk-cite! 'normed-field-ring-view-one 'fld)
      (for-each (lambda (u)
                  (dk-have! (list 'IN u (list 'CARR frm-nfv))
                    (lambda () (subst (list '== (list 'CARR frm-nfv) '(CARR fld))) (ass))))
                (list 'c))
      (subst (list '== '(MUL fld) (list 'MUL frm-nfv)))
      (subst (list '== '(ONE fld) (list 'ONE frm-nfv)))
      (crs)))
  (let* ((e (dk-cite! 'nf-norm-mult 'fld 'c one))
         (e1 (dk-rewrite-h! e c1 'c)))                 ; |c| = |c| |1|
    (dk-have! (list 'NOT (list '= frm-g 0)) (lambda () (di) (dk-absurd! (list '= frm-g 0) (list '< 0 frm-g))))
    (dk-have! (list '= (list '* frm-g o) (list '* frm-g 1))
      (lambda () (dk-real! (list '* frm-g o)) (dk-ineq! e1)))
    (dk-cite! 'rr-cancel-mul-left frm-g o 1)
    (ass)))
(qed 'frm-nf-norm-one)

;;; peel a frm-field-hyps statement; returns (fld c b)
(define (frm-field-peel!)
  (let* ((ls (dk-peel!))
         (lt (find-first (lambda (f) (and (dk-head-is? f '<) (equal? (cadr f) 1))) ls))
         (eq (find-first (lambda (f) (and (dk-head-is? f '=) (pair? (cadr f)) (pair? (car (cadr f)))
                                          (eq? (car (car (cadr f))) 'MUL))) ls)))
    (if (not (and lt eq)) (error "frm-field-peel!: hypotheses not found"))
    (list (cadr (car (cadr eq))) (cadr (caddr lt)) (caddr (cadr eq)))))

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (frm-field-hyps (frm-ladder-at 'n))))))
(let* ((ind (use-induction))
       (base (cdr (assq 'base ind))) (step (cdr (assq 'step ind)))
       (ih (cdr (assq 'ih ind))) (nv (cdr (assq 'var ind))))
  ;; ---- base: sc = sb = 1
  (dk-focus! base)
  (let* ((fcb (frm-field-peel!))
         (_ (if (not (equal? fcb '(fld c b))) (error "frm-nf-ladder: base binders renamed" fcb)))
         (one '(ONE fld)) (o (frm-nfn one)))
    (dk-cite! 'nf-one-in-carr 'fld)
    (dk-cite! 'nf-norm-in-rr 'fld 'c)
    (dk-have! (list '< 0 frm-g) (lambda () (dk-ineq! (list '< 1 frm-g))))
    (dk-cite! 'frm-nf-norm-one 'fld 'c)
    (ew one)
    (for-each
     (lambda (l0)
       (dk-focus! l0)
       (if (dk-head-is? (dk-goal) 'IN)
           (ass)
           (begin
             (ew one)
             (for-each
              (lambda (leaf)
                (dk-focus! leaf)
                (let ((g (dk-goal)))
                  (cond
                    ((dk-head-is? g 'IN) (ass))
                    ((dk-head-is? g 'FORALL)
                     (let ((ls (dk-peel!)))
                       (pbc)
                       (apply dk-absurd!
                              (frm-seq-map (lambda (f) (if (dk-contains? f o) (dk-rewrite-h! f o 1) f))
                                   (filter (lambda (f) (memq (car f) '(< <=))) ls)))))
                    (#t (subst (list '= o 1)) (dk-real! frm-g) (dk-ineq!)))))
              (frm-goal-leaves-shallow!)))))
     (dk-opened (lambda () (di)))))
  ;; ---- step: sc' = c sc, sb' = b sb
  (dk-focus! step)
  (let* ((fcb (frm-field-peel!))
         (_ (if (not (equal? fcb '(fld c b))) (error "frm-nf-ladder: step binders renamed" fcb)))
         (g frm-g) (be (frm-nfn 'b))
         (sc (dk-skolem! (dk-apply! ih 'fld 'c 'b)))
         (sb (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f sc)))
                                  "the sb existential")))
         (s (frm-nfn sc)) (t (frm-nfn sb))
         (upsc (frm-pick-forall-with s "UP of sc"))
         (dnsb (frm-pick-forall-with t "DN of sb"))
         (sc2 (list '(MUL fld) 'c sc)) (sb2 (list '(MUL fld) 'b sb))
         (s2 (frm-nfn sc2)) (t2 (frm-nfn sb2))
         (gm1 (list '- g 1)))
    (dk-cite! 'nf-mul-in-carr 'fld 'c sc)
    (dk-cite! 'nf-mul-in-carr 'fld 'b sb)
    (for-each (lambda (u) (dk-cite! 'nf-norm-in-rr 'fld u) (dk-cite! 'nf-norm-nonneg 'fld u)) (list 'c 'b sc sb))
    (dk-have! (list '< 0 g) (lambda () (dk-ineq! (list '< 1 g))))
    (dk-cite! 'frm-nf-norm-one 'fld 'c)
    (let* ((ms (dk-cite! 'nf-norm-mult 'fld 'c sc))          ; |c sc| = g s
           (mt (dk-cite! 'nf-norm-mult 'fld 'b sb))          ; |b sb| = be t
           (mg (dk-cite! 'nf-norm-mult 'fld 'c 'b))          ; |c b| = g be
           (mg1 (dk-rewrite-h! mg '((MUL fld) c b) '(ONE fld)))
           (gb (dk-rewrite-h! mg1 '((FNRM fld) (ONE fld)) 1))    ; 1 = g be
           (_ (begin (dk-real! gm1) (dk-real! (list '* g s)) (dk-real! (list '* gm1 s)) (dk-real! (list '* gm1 1))
                     (dk-have! (list '<= 0 gm1) (lambda () (dk-ineq! (list '< 1 g))))
                     (dk-have! (list 'AND (list '<= 0 gm1) (list '<= 1 s)) (lambda () (dk-conj-close! ass)))))
           (k1 (dk-cite! 'rr-le-scale-nonneg gm1 1 s))        ; (g-1) 1 <= (g-1) s
           (e1 (begin (dk-have! (list '= (list '* gm1 s) (list '- (list '* g s) s)) (lambda () (crs)))
                      (list '= (list '* gm1 s) (list '- (list '* g s) s))))
           (e2 (begin (dk-have! (list '= (list '* gm1 1) gm1) (lambda () (crs)))
                      (list '= (list '* gm1 1) gm1)))
           (k2 (dk-rewrite-h! (dk-rewrite-h! k1 (list '* gm1 s) (list '- (list '* g s) s))
                              (list '* gm1 1) gm1)))          ; g - 1 <= g s - s
      (ew sc2)
      (for-each
       (lambda (l0)
         (dk-focus! l0)
         (if (dk-head-is? (dk-goal) 'IN)
             (ass)
             (begin
               (ew sb2)
               (for-each
                (lambda (leaf)
                  (dk-focus! leaf)
                  (let ((gl (dk-goal)))
                    (cond
                      ((dk-head-is? gl 'IN) (ass))
                      ;; |sc'| |sb'| = 1
                      ((and (dk-head-is? gl '=) (dk-contains? gl t2))
                       (subst ms) (subst mt)
                       (dk-have! (list '= (list '* (list '* g s) (list '* be t)) (list '* (list '* g be) (list '* s t)))
                                 (lambda () (crs)))
                       (subst (list '= (list '* (list '* g s) (list '* be t)) (list '* (list '* g be) (list '* s t))))
                       (subst (list '= (list '* g be) 1))
                       (subst (list '= (list '* s t) 1))
                       (crs))
                      ;; 1 <= |sc'|
                      ((and (dk-head-is? gl '<=) (equal? (cadr gl) 1))
                       (subst ms)
                       (dk-ineq! k2 (list '<= 1 s) (list '< 1 g)))
                      ;; the Bernoulli bound at succ n
                      ((and (dk-head-is? gl '<=) (dk-contains? gl (list 'succ nv)))
                       (let* ((sp1 (dk-cite! 'nn-succ-plus-one nv))
                             (pn (list '+ nv 1)))
                         (dk-cite! 'nn-in-rr nv)
                         (subst (list '= (list 'succ nv) pn))
                         (dk-have! (list '= (list '* pn g) (list '+ (list '* nv g) g)) (lambda () (crs)))
                         (subst (list '= (list '* pn g) (list '+ (list '* nv g) g)))
                         (subst ms)
                         (dk-real! (list '* nv g))
                         (dk-ineq! k2 (list '<= (list '+ 1 (list '- (list '* nv g) nv)) s))))
                      ;; UP of sc'
                      ((and (dk-head-is? gl 'FORALL) (dk-contains? gl s2))
                       (let* ((ls (dk-peel!))
                              (h (find-first (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f s2))) ls))
                              (u (cadr h)) (v (caddr (caddr h)))
                              (h1 (dk-rewrite-h! h s2 (list '* g s)))
                              (sv (list '* s v)))
                         (dk-real! sv)
                         (use-em (list '<= u sv)
                           (lambda () (dk-apply! upsc u v) (ass))
                           (lambda ()
                             (dk-cite! 'rr-not-le-lt u sv)
                             (ew sc)
                             (dk-have! (list '= (list '* (list '* g s) v) (list '* g sv)) (lambda () (crs)))
                             (dk-rewrite-h! h1 (list '* (list '* g s) v) (list '* g sv))
                             (dk-conj-close! ass)))))
                      ;; DN of sb'
                      ((and (dk-head-is? gl 'FORALL) (dk-contains? gl t2))
                       (let* ((ls (dk-peel!))
                              (h1 (find-first (lambda (f) (and (dk-head-is? f '<) (dk-contains? f t2))) ls))
                              (u (caddr h1)) (v (caddr (cadr h1)))
                              (tv (list '* t v)))
                         (dk-real! tv)
                         (use-em (list '<= u tv)
                           (lambda ()
                             (ew sb2)
                             (dk-have! (list '= (list '* g (list '* (list '* be t) v)) (list '* (list '* g be) tv))
                                       (lambda () (crs)))
                             (dk-conj-close!
                               (lambda ()
                                 (if (or (dk-head-is? (dk-goal) 'IN) (dk-head-is? (dk-goal) '<))
                                     (ass)
                                     (begin (subst mt)
                                            (subst (list '= (list '* g (list '* (list '* be t) v)) (list '* (list '* g be) tv)))
                                            (subst (list '= (list '* g be) 1))
                                            (dk-ineq! (list '<= u tv)))))))
                           (lambda ()
                             (dk-cite! 'rr-not-le-lt u tv)
                             (dk-apply! dnsb u v)
                             (ass)))))
                      (#t (error "frm-nf-ladder: unexpected step leaf" (expression->string gl))))))
                (frm-goal-leaves-shallow!)))))
       (dk-opened (lambda () (di)))))))
(qed 'frm-nf-ladder)

;;; type each term in RR and name it; returns the alist ((term . name) ...)
(define (frm-names! terms)
  (frm-seq-map (lambda (t) (dk-real! t) (cons t (dk-name! t 'RR))) terms))
(define (frm-rw al f)                  ; a formula in context with the named terms replaced
  (fold-left (lambda (f pr) (if (dk-contains? f (car pr)) (dk-rewrite-h! f (car pr) (cdr pr)) f))
             f al))
(define (frm-rw-goal! al)              ; the goal with the named terms replaced
  (for-each (lambda (pr) (if (dk-contains? (dk-goal) (car pr)) (subst (list '= (car pr) (cdr pr))))) al))

;;; al * recip(g) < q  =>  al < q * g, for g > 0, in the running proof.  (The tree's
;;; `rr-lt-mul-of-div-lt' says this, but it lives in the MEASURE library and loads
;;; late; three lines here keep this file in analysis and in TVS-1's load window.)
;;; Needs (IN al RR), (IN q RR), (< 0 g) and (IN (recip g) RR) in context.
(define (frm-div-lt! al g q)
  (let* ((rg (list 'recip g)) (ag (list '* al rg)))
    (dk-real! ag)
    (dk-have! (list 'AND (list 'IN g 'RR) (list 'NOT (list '= g 0))) (lambda () (dk-conj-close! ass)))
    (dk-cite! 'rr-recip-inverse g)                                      ; g recip(g) = 1
    (dk-have! (list 'AND (list '< 0 g) (list '< ag q)) (lambda () (dk-conj-close! ass)))
    (let* ((sc (dk-cite! 'rr-lt-scale-pos g ag q))                      ; g ag < g q
           (eq (list '= (list '* g ag) (list '* al (list '* g rg)))))
      (dk-have! eq (lambda () (dk-crs-opaque!)))
      (dk-real! (list '* g q)) (dk-real! (list '* q g))
      (dk-have! (list '= (list '* g q) (list '* q g)) (lambda () (crs)))
      (let* ((sc1 (dk-rewrite-h! (dk-rewrite-h! sc (list '* g ag) (list '* al (list '* g rg)))
                                 (list '* g rg) 1))
             (al2 (frm-names! (list (list '* g q) (list '* q g)))))
        (dk-have! (list '< al (list '* q g))
          (lambda ()
            (frm-rw-goal! al2)
            (apply dk-ineq! (frm-seq-map (lambda (f) (frm-rw al2 f)) (list sc1 (list '= (list '* g q) (list '* q g)))))))))))

;;; the bracket: for u, v > 0, some s has |s| v < u <= |c| |s| v
(sp (make-wff (frm-field-hyps
  (forall-guarded 'u '(IN u RR) (forall-guarded 'v '(IN v RR)
    (list 'IMPLIES '(< 0 u) (list 'IMPLIES '(< 0 v) (frm-brk 'u 'v))))))))
(let* ((fcb (frm-field-peel!))
       (_ (if (not (and (equal? fcb '(fld c b)) (dk-contains? (dk-goal) 'u) (dk-contains? (dk-goal) 'v)))
              (error "frm-nf-bracket: binders renamed" fcb)))
       (g frm-g) (gm1 (list '- frm-g 1))
       (recip! (lambda (a)                      ; (IN (recip a) RR) for a > 0 in context
                 (dk-have! (list 'NOT (list '= a 0)) (lambda () (di) (dk-absurd! (list '= a 0) (list '< 0 a))))
                 (dk-have! (list 'AND (list 'IN a 'RR) (list 'NOT (list '= a 0))) (lambda () (dk-conj-close! ass)))
                 (dk-cite! 'rr-recip-closed a)))
       ;; a rung of the ladder with |sc| > q; returns (sc . sb)
       (big! (lambda (q)
               (let* ((x (begin (recip! gm1) (dk-real! (list '* q (list 'recip gm1))) (list '* q (list 'recip gm1))))
                      (n (dk-skolem! (dk-cite! 'nn-unbounded-in-rr x)))
                      (_ (dk-cite! 'nn-in-rr n))
                      (_ (frm-div-lt! q gm1 n))
                      (sc (dk-skolem! (dk-cite! 'frm-nf-ladder n 'fld 'c 'b)))
                      (sb (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f sc)))
                                               "the sb existential")))
                      (s (frm-nfn sc)))
                 (dk-real! (list '* n g))
                 (dk-have! (list '= (list '* n gm1) (list '- (list '* n g) n)) (lambda () (crs)))
                 (dk-cite! 'nf-norm-in-rr 'fld sc) (dk-cite! 'nf-norm-in-rr 'fld sb)
                 (dk-cite! 'nf-norm-nonneg 'fld sb)
                 (dk-have! (list '< q s)
                   (lambda ()
                     (dk-ineq! (dk-rewrite-h! (list '< q (list '* n gm1)) (list '* n gm1) (list '- (list '* n g) n))
                               (list '<= (list '+ 1 (list '- (list '* n g) n)) s))))
                 (cons sc sb)))))
  (dk-cite! 'nf-norm-in-rr 'fld 'c)
  (dk-real! gm1)
  (dk-have! (list '< 0 gm1) (lambda () (dk-ineq! (list '< 1 g))))
  (use-em '(<= u v)
    ;; u <= v: go down the ladder, |sb| v < u
    (lambda ()
      (recip! 'u)
      (let* ((q '(* v (recip u)))
             (_ (dk-real! q))
             (pr (big! q)) (sc (car pr)) (sb (cdr pr))
             (s (frm-nfn sc)) (t (frm-nfn sb))
             (dn (frm-pick-forall-with t "DN of sb"))
             (prod (dk-ctx-form (list '= (list '* s t) 1))))
        (frm-div-lt! 'v 'u s)                                         ; v < s u
        (dk-have! (list 'NOT (list '= 0 t))
          (lambda () (di)
            (dk-absurd! (dk-rewrite-h! prod t 0))))
        (dk-have! (list 'AND (list '<= 0 t) (list 'NOT (list '= 0 t))) (lambda () (dk-conj-close! ass)))
        (dk-cite! 'rr-le-ne-lt 0 t)
        (dk-real! (list '* s 'u))
        (dk-have! (list 'AND (list '< 0 t) (list '< 'v (list '* s 'u))) (lambda () (dk-conj-close! ass)))
        (let* ((sl (dk-cite! 'rr-lt-scale-pos t 'v (list '* s 'u))))  ; t v < t (s u)
          (dk-have! (list '= (list '* t (list '* s 'u)) (list '* (list '* s t) 'u)) (lambda () (crs)))
          (let* ((sl1 (dk-rewrite-h! sl (list '* t (list '* s 'u)) (list '* (list '* s t) 'u)))
                 (sl2 (dk-rewrite-h! sl1 (list '* s t) 1)))
            (dk-real! (list '* t 'v))
            (dk-have! (list '< (list '* t 'v) 'u) (lambda () (dk-ineq! sl2)))
            (dk-apply! dn 'u 'v)
            (ass)))))
    ;; v < u: go up the ladder, u <= |sc| v
    (lambda ()
      (dk-cite! 'rr-not-le-lt 'u 'v)
      (recip! 'v)
      (let* ((q '(* u (recip v)))
             (_ (dk-real! q))
             (pr (big! q)) (sc (car pr))
             (s (frm-nfn sc))
             (up (frm-pick-forall-with s "UP of sc")))
        (frm-div-lt! 'u 'v s)                                         ; u < s v
        (dk-real! (list '* s 'v))
        (dk-have! (list '<= 'u (list '* s 'v)) (lambda () (dk-ineq! (list '< 'u (list '* s 'v)))))
        (dk-apply! up 'u 'v)
        (ass)))))
(qed 'frm-nf-bracket)

;;; =====================================================================
;;; (16) PROP. 8.26, continuity => bound, over a non-trivially valued field:
;;;      with {p_j < dl, j <= nb} mapped into {q_k < 1} (frm-cont-lin-nbhd),
;;;      q_k(tt x) <= (|c| / dl) r whenever p_j(x) <= r for j <= nb.  For every
;;;      r' > r the bracket gives s with |s| r' < dl <= |c| |s| r'; then s.x lies
;;;      in the prefix ball, so |s| q_k(tt x) = q_k(tt(s.x)) < 1, and
;;;      dl q_k(tt x) <= |c| r'.  Letting r' -> r: dl q_k(tt x) <= |c| r.
;;; =====================================================================

(define (frm-sc-in! md v)              ; (IN v (CARR (SCAL md))) from (IN v (CARR fld))
  (let ((ty (list 'IN v (list 'CARR (list 'SCAL md)))))
    (frm-once! ty
      (lambda ()
        (dk-rewrite-h! (dk-rewrite-h! (list 'IN v '(CARR fld)) '(CARR fld) (list 'CARR frm-nfv))
                       frm-nfv (list 'SCAL md))))
    ty))
(define (frm-sn-at! md fm k)           ; (IS-SEMINORM fld md (fm k)), k typed in NN
  (let ((sn (list 'IS-SEMINORM 'fld md (list fm k))))
    (frm-once! sn
      (lambda ()
        (dk-apply! (dk-cite! 'frm-fam-seminorm 'fld md fm) k)))
    sn))
(sp (make-wff (frm-stmt-826 (list 'IMPLIES '(IS-NONTRIVIALLY-VALUED fld)
                (list 'IMPLIES '(IS-CONT-LIN m1 fam1 m2 fam2 tt) frm-bound-826)))))
(let* ((landed (dk-peel!))
       (kk (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) landed))))
  (mac-h 'is-nontrivially-valued '(IS-NONTRIVIALLY-VALUED fld))
  (dk-split-all!)
  (let* ((c (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'FNRM))) "the scalar c")))
         (b (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'MUL))) "its inverse")))
         (g (list '(FNRM fld) c)))
    (dk-cite! 'frm-fam-module 'fld 'm1 'fam1)
    (dk-cite! 'frm-fam-module 'fld 'm2 'fam2)
    (dk-cite! 'frm-fam-scal 'fld 'm1 'fam1)
    (dk-cite! 'frm-fam-scal 'fld 'm2 'fam2)
    (dk-cite! 'normed-field-ring-view-carr 'fld)
    (dk-project! '(IN tt (FUN (VEC m1) (VEC m2))) (lambda () (mac-h 'is-linear-map '(IS-LINEAR-MAP m1 m2 tt))))
    (dk-cite! 'nf-norm-in-rr 'fld c)
    (dk-have! (list '< 0 g) (lambda () (dk-ineq! (list '< 1 g))))
    (dk-have! (list '<= 0 g) (lambda () (dk-ineq! (list '< 1 g))))
    (let* ((nbx (dk-apply! (dk-cite! 'frm-cont-lin-nbhd 'fld 'm1 'fam1 'm2 'fam2 'tt) kk))
           (nb (dk-skolem! nbx))
           (dl (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f nb))) "the dl existential")))
           (nbu (frm-pick-forall-with dl "the neighbourhood universal"))
           (rd (list 'recip dl))
           (ck (list '* g rd)))
      (dk-cite! 'rr-pos-rr-in-rr dl) (dk-cite! 'rr-lt-of-pos-rr dl)
      (dk-have! (list 'NOT (list '= dl 0)) (lambda () (di) (dk-absurd! (list '= dl 0) (list '< 0 dl))))
      (dk-have! (list 'AND (list 'IN dl 'RR) (list 'NOT (list '= dl 0))) (lambda () (dk-conj-close! ass)))
      (dk-cite! 'rr-recip-closed dl)
      (dk-cite! 'rr-recip-inverse dl)                                 ; dl * recip(dl) = 1
      (dk-cite! 'rr-recip-pos dl)
      (dk-cite! 'rr-mul-pos g rd)
      (dk-real! ck)
      (dk-cite! 'rr-pos-rr-of-lt ck)
      (ew nb)
      (for-each
       (lambda (l0)
         (dk-focus! l0)
         (if (dk-head-is? (dk-goal) 'IN)
             (ass)
             (begin
               (ew ck)
               (for-each
                (lambda (l1)
                  (dk-focus! l1)
                  (if (dk-head-is? (dk-goal) 'POS-RR)
                      (ass)
                      (let* ((ls (dk-peel!))
                             (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC m1)))) ls)))
                             (r (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'RR))) ls)))
                             (hx (find-first (dk-head? 'FORALL) ls))
                             (tx (list 'tt x))
                             (a (list (list 'fam2 kk) tx)))
                        (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) x)
                        (frm-pv! 'm2 'fam2 kk tx)
                        (frm-sn-at! 'm2 'fam2 kk)
                        (dk-apply! (dk-cite! 'frm-sn-nonneg 'fld 'm2 (list 'fam2 kk)) tx)      ; 0 <= a
                        ;; 0 <= r, from j = 0
                        (dk-cite! 'nn-zero-in) (dk-cite! 'nn-zero-le nb)
                        (frm-sn-at! 'm1 'fam1 0)
                        (frm-pv! 'm1 'fam1 0 x)
                        (let* ((h0 (dk-apply! hx 0))
                              (n0 (dk-apply! (dk-cite! 'frm-sn-nonneg 'fld 'm1 '(fam1 0)) x)))
                          (dk-have! (list '<= 0 r) (lambda () (dk-ineq! h0 n0))))
                        ;; the claim dl a <= g r, by r' = r + e for every e
                        (dk-real! (list '* dl a)) (dk-real! (list '* g r))
                        (dk-have! (list 'FORALL 'fd_ (list 'IMPLIES '(POS-RR fd_)
                                    (list '<= (list '* dl a) (list '+ (list '* g r) 'fd_))))
                          (lambda ()
                            (let* ((d (cadr (car (dk-peel!))))
                                   (_ (dk-cite! 'rr-pos-rr-in-rr d))
                                   (e (dk-skolem! (dk-cite! 'rr-scale-eps g d)))
                                   (se (frm-pick-forall-with e "the scaling of e"))
                                   (rp (list '+ r e)))
                              (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e)
                              (dk-cite! 'rr-pos-rr-in-rr d)
                              (dk-real! rp)
                              (dk-have! (list '< 0 rp) (lambda () (dk-ineq! (list '<= 0 r) (list '< 0 e))))
                              (let* ((s (dk-skolem! (dk-cite! 'frm-nf-bracket 'fld c b dl rp)))
                                     (sv (list '(FNRM fld) s))
                                     (y (frm-act 'm1 s x)))
                                (dk-cite! 'nf-norm-in-rr 'fld s)
                                (dk-cite! 'nf-norm-nonneg 'fld s)
                                (frm-sc-in! 'm1 s) (frm-sc-in! 'm2 s)
                                (dk-cite! 'module-act-type 'm1 s x)
                                ;; s.x is in the prefix ball
                                (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'IMPLIES (list '<= 'j nb)
                                            (list '< (list '(fam1 j) y) dl))))
                                  (lambda ()
                                    (let* ((j (cadr (car (dk-peel!))))
                                           (pj (list (list 'fam1 j) x)))
                                      (frm-sn-at! 'm1 'fam1 j)
                                      (frm-pv! 'm1 'fam1 j x)
                                      (subst (dk-apply! (dk-cite! 'frm-sn-homog 'fld 'm1 (list 'fam1 j)) s x))
                                      (let ((hj (dk-apply! hx j)))
                                        (dk-have! (list '<= pj rp) (lambda () (dk-ineq! hj (list '< 0 e))))
                                        (dk-have! (list 'AND (list '<= 0 sv) (list '<= pj rp)) (lambda () (dk-conj-close! ass)))
                                        (let* ((sc (dk-cite! 'rr-le-scale-nonneg sv pj rp))
                                               (al (frm-names! (list (list '* sv pj) (list '* sv rp)))))
                                          (frm-rw-goal! al)
                                          (apply dk-ineq! (frm-seq-map (lambda (f) (frm-rw al f)) (list sc (dk-ctx-form (list '< (list '* sv rp) dl))))))))))
                                (let* ((lh (dk-apply! (dk-cite! 'frm-linear-homog 'm1 'm2 'tt) s x))
                                       (qh (dk-apply! (dk-cite! 'frm-sn-homog 'fld 'm2 (list 'fam2 kk)) s tx))
                                       (q0 (dk-apply! nbu y))
                                       (q1 (dk-rewrite-h! q0 (list 'tt y) (frm-act 'm2 s tx)))
                                       (q2 (dk-rewrite-h! q1 (list (list 'fam2 kk) (frm-act 'm2 s tx)) (list '* sv a)))
                                       (xx (list '* g (list '* sv rp)))
                                       (br (dk-ctx-form (list '<= dl xx)))
                                       (_ (begin (dk-real! xx) (dk-real! (list '* sv a)) (dk-real! (list '* g rp))
                                                 (dk-cite! 'rr-zero-in) (dk-cite! 'rr-one-in)))
                                       (m1x (dk-cite! 'rr-mul-le-right dl xx a))
                                       (e1 (begin (dk-have! (list '= (list '* xx a) (list '* (list '* g rp) (list '* sv a)))
                                                            (lambda () (crs)))
                                                  (list '= (list '* xx a) (list '* (list '* g rp) (list '* sv a)))))
                                       (_ (dk-have! (list 'AND (list '<= 0 g) (list '<= 0 rp))
                                            (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 0 rp))))))))
                                       (g0 (dk-cite! 'rr-le-scale-nonneg g 0 rp))
                                       (al0 (frm-names! (list (list '* g rp) (list '* sv a))))
                                       (_ (dk-have! (list '<= 0 (list '* g rp))
                                            (lambda () (frm-rw-goal! al0) (dk-ineq! (frm-rw al0 g0)))))
                                       (_ (dk-have! (list '<= (list '* sv a) 1)
                                            (lambda () (frm-rw-goal! al0) (dk-ineq! (frm-rw al0 q2)))))
                                       (_ (dk-have! (list 'AND (list '<= 0 (list '* g rp)) (list '<= (list '* sv a) 1))
                                            (lambda () (dk-conj-close! ass))))
                                       (m2x (dk-cite! 'rr-le-scale-nonneg (list '* g rp) (list '* sv a) 1))
                                       (e2 (begin (dk-have! (list '= (list '* (list '* g rp) 1) (list '* g rp)) (lambda () (crs)))
                                                  (list '= (list '* (list '* g rp) 1) (list '* g rp))))
                                       (e3 (begin (dk-have! (list '= (list '* g rp) (list '+ (list '* g r) (list '* g e)))
                                                            (lambda () (crs)))
                                                  (list '= (list '* g rp) (list '+ (list '* g r) (list '* g e)))))
                                       (_ (dk-have! (list '<= e e) (lambda () (dk-ineq!))))
                                       (_ (dk-have! (list '<= 0 e) (lambda () (dk-ineq! (list '< 0 e)))))
                                       (ge (dk-apply! se e))
                                       (al (frm-names! (list (list '* dl a) (list '* xx a)
                                                             (list '* (list '* g rp) (list '* sv a))
                                                             (list '* (list '* g rp) 1) (list '* g rp)
                                                             (list '* g r) (list '* g e)))))
                                  (frm-rw-goal! al)
                                  (apply dk-ineq! (frm-seq-map (lambda (f) (frm-rw al f))
                                                                   (list m1x e1 m2x e2 e3 ge))))))))
                        (dk-cite! 'rr-le-of-le-add-all-pos (list '* dl a) (list '* g r))
                        ;; a <= ck r: scale dl a <= g r by recip(dl)
                        (dk-have! (list '<= 0 rd) (lambda () (dk-ineq! (list '< 0 rd))))
                        (dk-have! (list 'AND (list '<= 0 rd) (list '<= (list '* dl a) (list '* g r)))
                                  (lambda () (dk-conj-close! ass)))
                        (let* ((sc (dk-cite! 'rr-le-scale-nonneg rd (list '* dl a) (list '* g r)))
                               (e1 (list '= (list '* rd (list '* dl a)) (list '* a (list '* dl rd))))
                               (e2 (list '= (list '* rd (list '* g r)) (list '* ck r))))
                          (dk-have! e1 (lambda () (dk-crs-opaque!)))
                          (dk-have! e2 (lambda () (dk-crs-opaque!)))
                          (let* ((sc1 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! sc (cadr e1) (caddr e1)) (cadr e2) (caddr e2))
                                                     (list '* dl rd) 1))
                                 (_ (dk-real! (list '* a 1)))
                                 (al (frm-names! (list (list '* ck r)))))
                            (frm-rw-goal! al)
                            (dk-ineq! (frm-rw al sc1)))))))
                (dk-opened (lambda () (di)))))))
       (dk-opened (lambda () (di)))))))
(qed 'frm-bound-of-cont-lin)

;;; Prop. 8.26 as the book states it: over a non-trivially valued field, a linear
;;; map is continuous iff each q_k is bounded by a multiple of finitely many p_j.
(sp (make-wff (frm-stmt-826 (list 'IMPLIES '(IS-NONTRIVIALLY-VALUED fld)
                (list 'IFF '(IS-CONT-LIN m1 fam1 m2 fam2 tt) frm-bound-826)))))
(dk-peel!)
(dk-iff! (dk-head? 'FORALL)
  (lambda () (dk-cite! 'frm-bound-of-cont-lin 'fld 'm1 'fam1 'm2 'fam2 'tt) (ass))
  (lambda () (dk-cite! 'frm-cont-lin-of-bound 'fld 'm1 'fam1 'm2 'fam2 'tt) (ass)))
(qed 'frm-cont-lin-iff-bound)

;;; RR is non-trivially valued: c = 2, b = 1/2.
(sp (make-wff '(IS-NONTRIVIALLY-VALUED RR-NORMED-FIELD)))
(mac 'is-nontrivially-valued)
(dk-cite! 'rr-is-normed-field)
(dk-cite! 'rr-nf-carr)
(dk-have! '(IN 2 RR) (lambda () (in-rr)))
(dk-have! '(IN 1/2 RR) (lambda () (in-rr)))
(dk-have! '(<= 0 2) (lambda () (dk-ineq!)))
(dk-cite! 'rr-abs-of-nonneg 2)
(let* ((fa (dk-apply! (dk-cite! 'rr-nf-fnrm-apply) 2))
      (ma (dk-apply! (dk-cite! 'rr-nf-mul-apply) 2 1/2)))
  (for-each
   (lambda (leaf)
     (dk-focus! leaf)
     (if (dk-head-is? (dk-goal) 'IS-NORMED-FIELD)
         (ass)
         (begin
           (ew 2)
           (dk-conj-close!
             (lambda ()
               (let ((g (dk-goal)))
                 (cond
                   ((dk-head-is? g 'IN) (subst '(== (CARR RR-NORMED-FIELD) RR)) (ass))
                   ((dk-head-is? g '<) (subst fa) (subst '(= (abs 2) 2)) (dk-ineq!))
                   ((dk-head-is? g 'FORSOME)
                    (ew 1/2)
                    (dk-conj-close!
                      (lambda ()
                        (if (dk-head-is? (dk-goal) 'IN)
                            (begin (subst '(== (CARR RR-NORMED-FIELD) RR)) (ass))
                            (begin (subst ma) (slot 'ONE) (arith))))))
                   (#t (error "rr nontrivially valued: leaf" (expression->string g))))))))))
   (frm-goal-leaves-shallow!)))
(qed 'frm-rr-nontrivially-valued)

