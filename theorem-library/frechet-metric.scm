             (pv (begin (frm-p-real! k 'x) (frm-p k 'x)))
             (pnn (dk-apply! (dk-cite! 'frm-sn-nonneg 'fld 'm p) 'x))
             (cc (begin (dk-real! (list '+ '((FNRM fld) sl) 1))
                        (dk-name! (list '+ '((FNRM fld) sl) 1) 'RR)))
             (_ (dk-have! (list '<= 0 cc) (lambda () (dk-ineq! (list '= cc (list '+ '((FNRM fld) sl) 1))
                                                                 '(<= 0 ((FNRM fld) sl))))))
             (d1 (dk-skolem! (dk-cite! 'rr-scale-eps cc e4)))
             (s1 (frm-pick-forall-with d1 "the d1 scaling"))
             (d2 (dk-skolem! (dk-cite! 'rr-scale-eps pv e4)))
             (s2 (frm-pick-forall-with d2 "the d2 scaling"))
