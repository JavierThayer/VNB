;;; =====================================================================
;;; (13) PROP. 8.25 (i): scalar multiplication is continuous, stated
;;;      sequentially -- lam_n -> lam in the field (its metric NF-METRIC-SPACE)
;;;      and x_n -> x in the metric imply lam_n.x_n -> lam.x.  The estimate is
;;;      p(l_i x_i - l x) <= |l_i| p(x_i - x) + |l_i - l| p(x)   (frm-act-diff),
;;;      with |l_i| <= |l| + 1 eventually.  It needs the ONE absolute value of
;;;      the family: with a field per seminorm it was not even statable.
;;; =====================================================================

(define frm-act-seq '(VNB-LAMBDA frn_ NN ((ACT m) (ss frn_) (sx frn_))))
(define frm-nfv '(NORMED-FIELD-AS-COMMUTATIVE-RING fld))
