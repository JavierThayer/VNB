;;; frechet-metric.scm -- a seminormed space with a COUNTABLE separating family of
;;; seminorms as a METRIC space: Thayer, "Analise Funcional e Teoria Espectral",
;;; Ch. 8 s.4, Props. 8.24-8.26 (pp. 254-256).  Batch TVS-1, 2026-10-10.
;;; Vocabulary: structure-library/frechet-metric.scm (FR-C-SPACE, FR-METRIC-SPACE,
;;; FR-METRIC).  Every theorem here is proven modulo 0; nothing is asserted.
;;;
;;; THE ROUTE.  The tree already proves that the canonical metric of a countable
;;; separating family of PSEUDOMETRICS is a metric (C-METRIC-SPACE, C-METRIC,
;;; `c-metric-is-metric-space').  A seminorm family gives such a family,
;;; d_k(x, y) = p_k(x - y), and the one new structural fact is
;;; `frm-c-space-is-c-metric-space'.  After that the file proves, once, for a general
;;; C-METRIC-SPACE, the two NESTINGS of balls --
;;;   (L) frm-c-ball-prefix   a D-ball lies in a d_k-ball,
;;;   (U) frm-c-prefix-ball   a prefix ball {d_j < dl, j <= nb} lies in a D-ball --
;;; which are the only places a series is summed (series-term-le-sum for (L); for (U)
;;; the head of the series by series-partial-sum-agree-below, the tail by
;;; series-tail-small and series-block-le).  Everything else -- convergence, Cauchy
;;; sequences, completeness, continuity of addition, Prop. 8.26, uniform equivalence
;;; -- is epsilon-logic over (L) and (U), plus one induction (`frm-prefix-eventually':
;;; finitely many "eventually" thresholds have a common one, the max).
;;;
;;; WHAT THE BOOK STATES FOR NETS IS STATED FOR SEQUENCES: the tree's convergence
;;; (CONVERGES-TO, FR-CONV, IS-CONT-LIN) is sequential.  In a metrizable space that
;;; loses nothing.
;;;
;;; THE THEOREMS (book numbering):
;;;   8.24 (a)  frm-metric-space-is-metric-space, frm-metric-value (the book's series),
;;;             frm-metric-translation-invariant, frm-converges-iff
;;;   8.24 (b)  frm-metrics-uniformly-equivalent (general form: frm-ti-uniform)
;;;   8.24 (c)  frm-cauchy-iff;  Def. 8.28: frm-frechet-iff-complete
;;;   8.25 (i)  frm-scal-continuous (sequential: lam_n -> lam in NF-METRIC-SPACE(fld),
;;;             x_n -> x in the metric  =>  lam_n.x_n -> lam.x)
;;;   8.25 (ii) frm-add-continuous (sequential, in the metric)
;;;   8.26      frm-cont-lin-iff-bound: over a non-trivially valued field
;;;             (IS-NONTRIVIALLY-VALUED, seminorm-hahn-banach.scm), tt is continuous
;;;             iff every q_k is bounded by a multiple of finitely many p_j; the halves
;;;             are frm-cont-lin-of-bound (no hypothesis on the field) and
;;;             frm-bound-of-cont-lin.  RR qualifies: frm-rr-nontrivially-valued.
;;;
;;; THE FIELD (TVS-1R, 2026-10-10).  The seminorm vocabulary takes its scalar field as a
;;; parameter, IS-SEMINORM-FAMILY(fld, m, fam): until then IS-SEMINORM named a field per
;;; seminorm, two families could be homogeneous for different absolute values on one
;;; ring, and 8.26 (continuity => bound) was false in the model (TVS-1 report).  The
;;; first fifty theorems of the file were re-run on the parameter unchanged in
;;; substance; sections (12)-(16) are the theorems the shared field makes provable.
;;; 8.26 (=>) also needs |c| > 1 for some scalar: with the trivial absolute value there
;;; is no rescaling and the bound is false.  The book rescales by a real delta r^-1;
;;; here the powers of c and of its inverse bracket the ratio (frm-nf-ladder,
;;; frm-nf-bracket), by induction and without a least-number principle.
;;;
;;; LOAD WINDOW: [after theorem-library/taylor-cluster, end).  The latest citation is
;;; `series-partial-sum-agree-below' (taylor-cluster); sections (12)-(16) add nothing
;;; later (their latest are diff-on-laws-2's nf-one-in-carr and diff-on-laws's nf-*
;;; laws; `rr-lt-mul-of-div-lt' and `rr-mul-le-cancel-pos', which load after
;;; taylor-cluster and the first in the MEASURE library, are replaced by three local
;;; lines each); then one-sided-derivative-laws
;;; (rr-lt-min, rr-min-left-le), diff-on-laws-2, c-continuous-category
;;; (c-metric-canonical-carrier), c-metric-is-metric, sequential-continuity.  The
;;; vocabulary file loads after structure-library/frechet-open-mapping (and so after
;;; c-metric-space).
;;;
;;; Helper prefix: frm-.  Case folding: the helpers frm-dist / frm-d are distinct on
;;; purpose (frm-D would be frm-d).

;;; ---- the frm- kit ----------------------------------------------------

(define (frm-sub m a b) (list (list 'VADD m) a (list (list 'VNEG m) b)))
(define (frm-add m a b) (list (list 'VADD m) a b))
(define (frm-neg m a) (list (list 'VNEG m) a))
(define (frm-asm? f) (if (dk-asm? f) #t #f))
(define (frm-once! f thunk) (if (not (frm-asm? f)) (thunk)))
;;; map, LEFT TO RIGHT by construction: a recording step inside the procedure must run
;;; in the same order compiled and interpreted (CLAUDE.md: never two recording calls in
;;; one argument list or `let'; MIT's `map' promises no order).
(define (frm-seq-map f l)
  (let loop ((l l) (acc '()))
    (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))

;;; (IN v (VEC m)) for a vector term built from typed atoms by VADD / VNEG / VZERO.
(define (frm-vec! m v)
  (let ((ty (list 'IN v (list 'VEC m))))
    (if (not (frm-asm? ty))
        (cond ((and (pair? v) (equal? (car v) (list 'VADD m)))
               (frm-vec! m (cadr v)) (frm-vec! m (caddr v))
               (dk-cite! 'module-vadd-type m (cadr v) (caddr v)))
              ((and (pair? v) (equal? (car v) (list 'VNEG m)))
               (frm-vec! m (cadr v))
               (dk-cite! 'module-vneg-type m (cadr v)))
              ((equal? v (list 'VZERO m)) (dk-cite! 'module-vzero-in m))
              (#t (error "frm-vec!: cannot type" (expression->string v)))))
    (if (not (frm-asm? ty)) (error "frm-vec!: typing did not land" (expression->string v)))
    ty))

;;; ---- the read-off procedure of ag-view-read-offs.scm (avr-read-off!), local copy --
(define (frm-read-off! name var is-pred is-mac view acc val witness)
  (sp (make-wff (list 'FORALL var
                  (list 'IMPLIES is-pred
                    (list '= (list acc (list view var)) val)))))
  (di)
  (di)
  (mac-h is-mac is-pred)
  (dk-split-all!)
  (if (not (member witness (dk-asms)))
      (error "frm-read-off!: the typing conjunct is not in the context"
             name (expression->string witness)))
  (slot acc)
  (mac view)
  (nth-r)
  (rfl)
  (if (not (proof-done? *ps*))
      (error "frm-read-off!: proof did not close" name (dk-goal)))
  (qed name))

;;; =====================================================================
;;; (1) THE VECTOR GROUP OF A MODULE: the fourth read-off, and the group laws
;;;     on VEC m that the differences x - y need.
;;; =====================================================================

(frm-read-off! 'frm-mvag-inv 'md '(IS-MODULE md) 'is-module 'MODULE-VECTOR-AG
               'INV '(VNEG md) '(IN (VNEG md) (FUN (VEC md) (VEC md))))

;;; cite an ABELIAN-GROUP law at MODULE-VECTOR-AG(m) and land it in the module's own
;;; vocabulary (VADD / VZERO / VNEG / VEC).  The VECS must be typed in VEC m.
(define (frm-ag! thm m . vecs)
  (let* ((g (list 'MODULE-VECTOR-AG m))
         (rw (lambda (f from to) (if (dk-contains? f from) (dk-rewrite-h! f from to) f))))
    (dk-cite! 'module-vector-ag-is-abelian-group m)
    (dk-cite! 'mvag-carr m) (dk-cite! 'mvag-op m) (dk-cite! 'mvag-id m)
    (dk-cite! 'frm-mvag-inv m)
    (for-each (lambda (v)
                (let ((ty (frm-vec! m v)))
                  (frm-once! (list 'IN v (list 'CARR g))
                             (lambda () (dk-rewrite-h! ty (list 'VEC m) (list 'CARR g))))))
              vecs)
    (let* ((f0 (apply dk-cite! thm g vecs))
           (f1 (rw f0 (list 'OPR g) (list 'VADD m)))
           (f2 (rw f1 (list 'INV g) (list 'VNEG m)))
           (f3 (rw f2 (list 'IDEN g) (list 'VZERO m))))
      f3)))

(define (frm-vstmt vars body)
  (list 'FORALL 'm
    (list 'IMPLIES '(IS-MODULE m)
      (let loop ((vs vars))
        (if (null? vs) body
            (list 'FORALL (car vs)
                  (list 'IMPLIES (list 'IN (car vs) '(VEC m)) (loop (cdr vs)))))))))

(define (frm-ag-lemma! name thm vars body)
  (sp (make-wff (frm-vstmt vars body)))
  (dk-peel!)
  (apply frm-ag! thm 'm vars)
  (ass)
  (qed name))

;;; frm-v-comm and frm-v-interchange were proven here; they are the statements of
;;; hbs-vadd-comm and hbs-interchange (theorem-library/hahn-banach-sublinear.scm, loaded
;;; earlier), so they were removed at integration (2026-10-10, proven-duplicate-audit) and
;;; their citations renamed.
(frm-ag-lemma! 'frm-v-right-inv 'abelian-group-right-inv '(x)
  (list '= (frm-sub 'm 'x 'x) '(VZERO m)))
(frm-ag-lemma! 'frm-v-neg-add 'abelian-group-inv-opr '(x y)
  (list '= (frm-neg 'm (frm-add 'm 'x 'y)) (frm-add 'm (frm-neg 'm 'x) (frm-neg 'm 'y))))
(frm-ag-lemma! 'frm-v-neg-neg 'abelian-group-inv-inv '(x)
  (list '= (frm-neg 'm (frm-neg 'm 'x)) 'x))

;;; ---- differences x - y = x + (-y) ------------------------------------

(define (frm-subst-all! . eqs) (for-each (lambda (e) (subst e)) eqs))

;;; -(x - y) = y - x
(sp (make-wff (frm-vstmt '(x y) (list '= (frm-neg 'm (frm-sub 'm 'x 'y)) (frm-sub 'm 'y 'x)))))
(dk-peel!)
(frm-vec! 'm (frm-neg 'm 'y)) (frm-vec! 'm (frm-neg 'm 'x))
(let* ((e1 (dk-cite! 'frm-v-neg-add 'm 'x (frm-neg 'm 'y)))
       (e2 (dk-cite! 'frm-v-neg-neg 'm 'y))
       (e3 (dk-cite! 'hbs-vadd-comm 'm (frm-neg 'm 'x) 'y)))
  (frm-subst-all! e1 e2)
  (ass))
(qed 'frm-v-sub-anti)

;;; (x - y) + (y - z) = x - z
(sp (make-wff (frm-vstmt '(x y z)
  (list '= (frm-add 'm (frm-sub 'm 'x 'y) (frm-sub 'm 'y 'z)) (frm-sub 'm 'x 'z)))))
(dk-peel!)
(for-each (lambda (v) (frm-vec! 'm v))
          (list (frm-neg 'm 'x) (frm-neg 'm 'y) (frm-neg 'm 'z) (frm-sub 'm 'x 'z)))
(let* ((e1 (dk-cite! 'hbs-vadd-comm 'm 'y (frm-neg 'm 'z)))
       (e2 (dk-cite! 'hbs-interchange 'm 'x (frm-neg 'm 'y) (frm-neg 'm 'z) 'y))
       (e3 (dk-cite! 'hbs-vadd-comm 'm (frm-neg 'm 'y) 'y))
       (e4 (dk-cite! 'frm-v-right-inv 'm 'y))
       (e5 (dk-cite! 'abelian-group-right-id-module-vector-ag 'm (frm-sub 'm 'x 'z))))
  (frm-subst-all! e1 e2 e3 e4 e5)
  (rfl))
(qed 'frm-v-sub-chain)

;;; x - y = 0  =>  x = y
(sp (make-wff (frm-vstmt '(x y)
  (list 'IMPLIES (list '= (frm-sub 'm 'x 'y) '(VZERO m)) '(= x y)))))
(dk-peel!)
(frm-vec! 'm (frm-neg 'm 'y)) (frm-vec! 'm (frm-neg 'm 'x))
(let* ((e1 (dk-cite! 'abelian-group-inverse-unique-module-vector-ag 'm 'x (frm-neg 'm 'y)))
       (e2 (dk-cite! 'frm-v-neg-neg 'm 'x))
       (e3 (dk-cite! 'frm-v-neg-neg 'm 'y)))
  (subst (list '= 'x (frm-neg 'm (frm-neg 'm 'x))))
  (subst (list '= (frm-neg 'm 'x) (frm-neg 'm 'y)))
  (ass))
(qed 'frm-v-sub-zero-eq)

;;; (x + r) - (y + r) = x - y      (translation invariance of the difference)
(sp (make-wff (frm-vstmt '(x y r)
  (list '= (frm-sub 'm (frm-add 'm 'x 'r) (frm-add 'm 'y 'r)) (frm-sub 'm 'x 'y)))))
(dk-peel!)
(for-each (lambda (v) (frm-vec! 'm v))
          (list (frm-neg 'm 'y) (frm-neg 'm 'r) (frm-sub 'm 'x 'y)))
(let* ((e1 (dk-cite! 'frm-v-neg-add 'm 'y 'r))
       (e2 (dk-cite! 'hbs-interchange 'm 'x 'r (frm-neg 'm 'y) (frm-neg 'm 'r)))
       (e3 (dk-cite! 'frm-v-right-inv 'm 'r))
       (e4 (dk-cite! 'abelian-group-right-id-module-vector-ag 'm (frm-sub 'm 'x 'y))))
  (frm-subst-all! e1 e2 e3 e4)
  (rfl))
(qed 'frm-v-sub-shift)

;;; (x + y) - (u + v) = (x - u) + (y - v)
(sp (make-wff (frm-vstmt '(x y u v)
  (list '= (frm-sub 'm (frm-add 'm 'x 'y) (frm-add 'm 'u 'v))
           (frm-add 'm (frm-sub 'm 'x 'u) (frm-sub 'm 'y 'v))))))
(dk-peel!)
(for-each (lambda (v) (frm-vec! 'm v))
          (list (frm-neg 'm 'u) (frm-neg 'm 'v) (frm-add 'm (frm-sub 'm 'x 'u) (frm-sub 'm 'y 'v))))
(let* ((e1 (dk-cite! 'frm-v-neg-add 'm 'u 'v))
       (e2 (dk-cite! 'hbs-interchange 'm 'x 'y (frm-neg 'm 'u) (frm-neg 'm 'v))))
  (frm-subst-all! e1 e2)
  (rfl))
(qed 'frm-v-sub-add)

;;; =====================================================================
;;; (2) THE FAMILY'S SPACE FR-C-SPACE(m, fam): the read-offs.
;;; =====================================================================

(define frm-dists-lam
  '(VNB-LAMBDA frk_ NN
     (VNB-LAMBDA (LIST fru_ frv_) (CARTESIAN (VEC m) (VEC m))
       ((fam frk_) ((VADD m) fru_ ((VNEG m) frv_))))))

(sp (make-wff '(FORALL m (FORALL fam (== (PTS (FR-C-SPACE m fam)) (VEC m))))))
(di)
(mac 'FR-C-SPACE)
(slot 'PTS)
(nth-r)
(qrfl)
(qed 'frm-c-space-pts)

(sp (make-wff (list 'FORALL 'm (list 'FORALL 'fam
                (list '== '(DISTS (FR-C-SPACE m fam)) frm-dists-lam)))))
(di)
(mac 'FR-C-SPACE)
(slot 'DISTS)
(nth-r)
(qrfl)
(qed 'frm-c-space-dists)

(sp (make-wff (list 'FORALL 'm (list 'FORALL 'fam
  (forall-guarded '(k x y) '((IN k NN) (IN x (VEC m)) (IN y (VEC m)))
    (list '== '(((DISTS (FR-C-SPACE m fam)) k) x y)
          (list '(fam k) (frm-sub 'm 'x 'y))))))))
(dk-peel!)
(mac 'FR-C-SPACE)
(slot 'DISTS)
(nth-r)
(dk-lam-b!)
(qrfl)
(qed 'frm-c-space-dists-apply)

;;; =====================================================================
;;; (3) SEMINORMS: the projections of IS-SEMINORM, p(0) = 0 and p(-x) = p(x).
;;; =====================================================================

;;; ---- projections of IS-SEMINORM ------------------------------------------

(define (frm-snstmt body)
  (list 'FORALL 'fld (list 'FORALL 'm (list 'FORALL 'p (list 'IMPLIES '(IS-SEMINORM fld m p) body)))))

(define (frm-project! name pred mac-name stmt)
  (sp (make-wff stmt))
  (let loop ((n 0))
    (if (not (dk-asm? pred))
        (begin (if (> n 4) (error "frm-project!: guard did not land" name)) (di) (loop (+ n 1)))))
  (mac-h mac-name pred)
  (dk-split-all!)
  (ass)
  (qed name))

(frm-project! 'frm-sn-module '(IS-SEMINORM fld m p) 'is-seminorm (frm-snstmt '(IS-MODULE m)))
(frm-project! 'frm-sn-type '(IS-SEMINORM fld m p) 'is-seminorm (frm-snstmt '(IN p (FUN (VEC m) RR))))
(frm-project! 'frm-sn-nonneg '(IS-SEMINORM fld m p) 'is-seminorm
  (frm-snstmt '(FORALL x (IMPLIES (IN x (VEC m)) (<= 0 (p x))))))
(frm-project! 'frm-sn-subadd '(IS-SEMINORM fld m p) 'is-seminorm
  (frm-snstmt (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC m))
                (list 'FORALL 'y (list 'IMPLIES '(IN y (VEC m))
                  (list '<= (list 'p (frm-add 'm 'x 'y)) '(+ (p x) (p y)))))))))

;;; open IS-SEMINORM(fld, m, p) in context: the field (a parameter since 2026-10-10)
;;; and the homogeneity law.  Returns (fld . hu).
(define (frm-open-seminorm!)
  (mac-h 'is-seminorm '(IS-SEMINORM fld m p))
  (dk-split-all!)
  (let* ((hu  (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f 'FNRM)))
                       "the homogeneity law")))
    (cons 'fld hu)))

;;; p(0) = 0
(sp (make-wff (frm-snstmt '(= (p (VZERO m)) 0))))
(di) (di)
(let* ((fh (frm-open-seminorm!)) (fld (car fh)) (hu (cdr fh))
       (z '(ZERO (SCAL m))) (rv (list 'NORMED-FIELD-AS-COMMUTATIVE-RING fld)))
  (dk-cite! 'module-scalar-zero-in 'm)
  (frm-vec! 'm '(VZERO m))
  (let* ((e  (dk-apply! hu z '(VZERO m)))
         (a1 (dk-cite! 'module-act-zero-vec 'm z))
         (e2 (dk-rewrite-h! e (list '(ACT m) z '(VZERO m)) '(VZERO m)))
         (e3 (dk-rewrite-h! e2 '(SCAL m) rv))
         (c1 (dk-cite! 'normed-field-ring-view-zero fld))
         (e4 (dk-rewrite-h! e3 (list 'ZERO rv) (list 'ZERO fld)))
         (c2 (dk-cite! 'nf-norm-of-zero fld))
         (e5 (dk-rewrite-h! e4 (list (list 'FNRM fld) (list 'ZERO fld)) 0)))
    (dk-cite! 'fun-apply-type-c 'p '(VEC m) 'RR '(VZERO m))
    (dk-ineq! e5)))
(qed 'frm-sn-zero)

;;; p(-x) = p(x).  With c = |-1|: p(-x) = c p(x) and p(x) = p(-(-x)) = c p(-x), so
;;; (1 + c) p(-x) = p(-x) + p(x) = (1 + c) p(x), and 1 + c > 0.  (|-1| = 1 is NOT used:
;;; it needs 0 /= 1 in the scalar field, which IS-NORMED-FIELD does not say -- the
;;; asserted `normed-field-zero-not-one' does.)
(sp (make-wff (frm-snstmt '(FORALL x (IMPLIES (IN x (VEC m)) (= (p ((VNEG m) x)) (p x)))))))
(di) (di)
(let* ((fh (frm-open-seminorm!)) (fld (car fh)) (hu (cdr fh))
       (x (begin (dk-peel!) (cadr (caddr (dk-goal)))))
       (nx (frm-neg 'm x))
       (one '(ONE (SCAL m)))
       (n1 (list '(NEG (SCAL m)) one))
       (rv (list 'NORMED-FIELD-AS-COMMUTATIVE-RING fld)))
  (dk-cite! 'module-scalar-ring 'm)
  (dk-cite! 'ring-one-in '(SCAL m))
  (dk-cite! 'ring-neg-in-carr '(SCAL m) one)
  (frm-vec! 'm nx)
  (let* ((e1 (dk-apply! hu n1 x))
         ;; inst*! errors when a link of its chain is already in context: the
         ;; universal at n1 landed with e1, so the second instance starts from it
         (e2 (dk-apply! (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL)
                                                  (dk-contains? f n1) (dk-contains? f 'FNRM)))
                                 "the homogeneity law at -1")
                        nx))
         (a1 (dk-cite! 'module-act-neg-one 'm x))
         (a2 (dk-cite! 'module-act-neg-one 'm nx))
         (a3 (dk-cite! 'frm-v-neg-neg 'm x))
         (e1a (dk-rewrite-h! e1 (list '(ACT m) n1 x) nx))
         (e2a (dk-rewrite-h! e2 (list '(ACT m) n1 nx) (frm-neg 'm nx)))
         (e2b (dk-rewrite-h! e2a (frm-neg 'm nx) x))
         (t1  (dk-rewrite-h! (list 'IN n1 '(CARR (SCAL m))) '(SCAL m) rv))
         (n1r (cadr t1))
         (c1  (dk-cite! 'normed-field-ring-view-carr fld))
         (t2  (dk-rewrite-h! t1 (list 'CARR rv) (list 'CARR fld)))
         (e1b (dk-rewrite-h! e1a '(SCAL m) rv))
         (e2c (dk-rewrite-h! e2b '(SCAL m) rv))
         (cn  (list (list 'FNRM fld) n1r)))
    (dk-cite! 'nf-norm-in-rr fld n1r)
    (dk-cite! 'nf-norm-nonneg fld n1r)
    (dk-cite! 'fun-apply-type-c 'p '(VEC m) 'RR x)
    (dk-cite! 'fun-apply-type-c 'p '(VEC m) 'RR nx)
    (let* ((c (dk-name! cn 'RR))
           (a (dk-name! (list 'p x) 'RR))
           (b (dk-name! (list 'p nx) 'RR))
           (cpos (dk-rewrite-h! (list '<= 0 cn) cn c))
           (f1 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! e1b cn c) (list 'p nx) b) (list 'p x) a))
           (f2 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! e2c cn c) (list 'p nx) b) (list 'p x) a))
           (oc (list '+ 1 c)))
      (dk-have! (list 'NOT (list '= oc 0))
        (lambda () (di) (dk-absurd! (list '= oc 0) cpos)))
      (dk-have! (list '= (list '* oc b) (list '* oc a))
        (lambda ()
          (dk-have! (list '= (list '* oc b) (list '+ b (list '* c b))) (lambda () (crs)))
          (dk-have! (list '= (list '* oc a) (list '+ a (list '* c a))) (lambda () (crs)))
          (subst (list '= (list '* oc b) (list '+ b (list '* c b))))
          (subst (list '= (list '* oc a) (list '+ a (list '* c a))))
          (subst (list '= (list '* c b) a))
          (subst (list '= (list '* c a) b))
          (crs)))
      (dk-real! oc)
      (dk-cite! 'rr-cancel-mul-left oc b a)
      (subst (list '= (list 'p nx) b))
      (subst (list '= (list 'p x) a))
      (ass))))
(qed 'frm-sn-neg)

;;; ---- projections of IS-SEMINORM-FAMILY ----------------------------------

(define (frm-fstmt body)
  (list 'FORALL 'fld (list 'FORALL 'm (list 'FORALL 'fam
    (list 'IMPLIES '(IS-SEMINORM-FAMILY fld m fam) body)))))

(frm-project! 'frm-fam-module '(IS-SEMINORM-FAMILY fld m fam) 'is-seminorm-family
  (frm-fstmt '(IS-MODULE m)))
(frm-project! 'frm-fam-type '(IS-SEMINORM-FAMILY fld m fam) 'is-seminorm-family
  (frm-fstmt '(IN fam (FUN NN (FUN (VEC m) RR)))))
(frm-project! 'frm-fam-seminorm '(IS-SEMINORM-FAMILY fld m fam) 'is-seminorm-family
  (frm-fstmt '(FORALL k (IMPLIES (IN k NN) (IS-SEMINORM fld m (fam k))))))
(frm-project! 'frm-module-vec-set '(IS-MODULE m) 'is-module
  '(FORALL m (IMPLIES (IS-MODULE m) (IN (VEC m) SET))))

;;; separation, in the form the zero law wants: a vector all of whose seminorms
;;; vanish is the zero vector.
(sp (make-wff (frm-fstmt
  '(FORALL x (IMPLIES (IN x (VEC m))
     (IMPLIES (FORALL k (IMPLIES (IN k NN) (= ((fam k) x) 0))) (= x (VZERO m))))))))
(dk-peel!)
(mac-h 'is-seminorm-family '(IS-SEMINORM-FAMILY fld m fam))
(dk-split-all!)
(let* ((sep (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f 'FORSOME)))
                     "the separation clause"))
       (hz  (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f 0)
                                      (not (dk-contains? f 'FORSOME))))
                     "the vanishing hypothesis"))
       (sx  (inst*! sep 'x)))           ; NOT dk-apply!: it would try to detach
  (use-em '(= x (VZERO m))
    (lambda () (ass))
    (lambda ()
      (let* ((ex (dk-landed-1 (lambda () (detach! sx))))
             (k  (dk-skolem! ex))
             (z  (dk-apply! hz k))
             (nz (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'NOT) (dk-contains? f k)))
                          "the nonvanishing seminorm")))
        (ai nz)))))
(qed 'frm-fam-separates)

;;; typings of the seminorm values
(define (frm-fam-at! k)               ; (IN (fam k) (FUN (VEC m) RR)), (IS-SEMINORM fld m (fam k))
  (dk-cite! 'frm-fam-type 'fld 'm 'fam)
  (frm-once! (list 'IN (list 'fam k) '(FUN (VEC m) RR))
             (lambda () (dk-cite! 'fun-apply-type-c 'fam 'NN '(FUN (VEC m) RR) k)))
  (dk-cite! 'frm-fam-seminorm 'fld 'm 'fam)
  (frm-once! (list 'IS-SEMINORM 'fld 'm (list 'fam k))
             (lambda () (dk-apply! (dk-ctx-form '(FORALL k (IMPLIES (IN k NN) (IS-SEMINORM fld m (fam k))))) k))))
(define (frm-p-real! k v)             ; (IN ((fam k) v) RR), v a typed vector term
  (frm-vec! 'm v)
  (frm-fam-at! k)
  (let ((ty (list 'IN (list (list 'fam k) v) 'RR)))
    (frm-once! ty (lambda () (dk-cite! 'fun-apply-type-c (list 'fam k) '(VEC m) 'RR v)))
    ty))

;;; =====================================================================
;;; (4) THE FAMILY'S SPACE IS A C-METRIC-SPACE.
;;; =====================================================================

(define frm-frc '(FR-C-SPACE m fam))
(define (frm-dd k a b) (list (list (list 'DISTS frm-frc) k) a b))

;;; every d_k(a, b) in the GOAL rewritten to fam(k)(a - b), the points typed
(define (frm-dd-rewrite!)
  (let loop ((fuel 12))
    (let ((hit #f))
      (let walk ((e (dk-goal)))
        (if (and (not hit) (pair? e))
            (if (and (= (length e) 3) (pair? (car e)) (pair? (caar e))
                     (equal? (caar e) (list 'DISTS frm-frc)))
                (set! hit e)
                (for-each walk e))))
      (if (and hit (> fuel 0))
          (let ((k (cadr (car hit))) (a (cadr hit)) (b (caddr hit)))
            (subst (dk-cite! 'frm-c-space-dists-apply 'm 'fam k a b))
            (loop (- fuel 1)))))))

(define (frm-goal-leaves!)            ; split the focus goal's ANDs / peel, return leaves
  (let walk ((n (proof-state-focus *ps*)))
    (dk-focus! n)
    (let ((g (dk-goal)))
      (cond ((and (pair? g) (memq (car g) '(FORALL IMPLIES)))
             (dk-peel!) (walk (proof-state-focus *ps*)))
            ((and (pair? g) (eq? (car g) 'AND))
             (apply append (frm-seq-map walk (dk-opened (lambda () (di))))))
            (#t (list n))))))

(define (frm-pseudo-law!)
  (frm-dd-rewrite!)
  (let* ((g (dk-goal)) (k (let find ((e g)) (cond ((and (pair? e) (eq? (car e) 'fam)) (cadr e))
                                                  ((pair? e) (or (find (car e)) (find (cdr e))))
                                                  (#t #f)))))
    (frm-fam-at! k)
    (let ((sn (list 'IS-SEMINORM 'fld 'm (list 'fam k))) (p (list 'fam k)))
      (cond
        ;; p(u - u) = 0
        ((and (eq? (car g) '=) (equal? (caddr g) 0))
         (let* ((u (cadr (cadr g))) (u (cadr u)))
           (subst (dk-cite! 'frm-v-right-inv 'm u))
           (dk-cite! 'frm-sn-zero 'fld 'm p)
           (ass)))
        ;; 0 <= p(u - v)
        ((eq? (car g) '<=)
         (if (equal? (cadr g) 0)
             (let ((w (cadr (caddr g))))
               (frm-vec! 'm w)
               (dk-apply! (dk-cite! 'frm-sn-nonneg 'fld 'm p) w)
               (ass))
             ;; p(u - w) <= p(u - v) + p(v - w)
             (let* ((uw (cadr (cadr g))) (uv (cadr (cadr (caddr g)))) (vw (cadr (caddr (caddr g))))
                    (u (cadr uw)) (w (cadr (caddr uw))) (v (cadr (caddr uv))))
               (frm-vec! 'm uv) (frm-vec! 'm vw)
               (dk-cite! 'frm-v-sub-chain 'm u v w)
               (subst (list '= uw (frm-add 'm uv vw)))
               (dk-apply! (dk-cite! 'frm-sn-subadd 'fld 'm p) uv vw)
               (ass))))
        ;; p(u - v) = p(v - u)
        ((eq? (car g) '=)
         (let* ((uv (cadr (cadr g))) (vu (cadr (caddr g))) (u (cadr uv)) (v (cadr (caddr uv))))
           (frm-vec! 'm uv)
           (dk-cite! 'frm-v-sub-anti 'm u v)
           (subst (list '= vu (frm-neg 'm uv)))
           (subst (dk-apply! (dk-cite! 'frm-sn-neg 'fld 'm p) uv))
           (frm-p-real! k uv)
           (rfl)))
        (#t (error "frm-pseudo-law!: unexpected leaf" (expression->string g)))))))

(sp (make-wff (frm-fstmt '(IS-C-METRIC-SPACE (FR-C-SPACE m fam)))))
(di) (di)
(dk-cite! 'frm-fam-module 'fld 'm 'fam)
(dk-cite! 'frm-fam-type 'fld 'm 'fam)
(dk-cite! 'frm-module-vec-set 'm)
(dk-cite! 'frm-c-space-pts 'm 'fam)
;; the family's typing FIRST, on the main branch: the pseudometric law instantiates the
;; macete at (DISTS frc)(k_), which the certificate accepts only from this typing (repair 3)
(define (frm-dists-type!)
  (subst (dk-cite! 'frm-c-space-dists 'm 'fam))
  (dk-lam-type!
   (lambda ()
     (dk-peel!)
     (dk-lam-type!
      (lambda ()
        (dk-peel!)
        (let* ((t (cadr (dk-goal))) (k (cadr (car t))) (v (cadr t)))
          (frm-p-real! k v)
          (ass)))))))
(dk-have! (list 'IN (list 'DISTS frm-frc) '(FUN NN (FUN (CARTESIAN (VEC m) (VEC m)) RR)))
          frm-dists-type!)
(mac 'is-c-metric-space)
(subst '(= (PTS (FR-C-SPACE m fam)) (VEC m)))
(for-each
 (lambda (leaf)
   (dk-focus! leaf)
   (let ((g (dk-goal)))
     (cond
       ((and (eq? (car g) '=) (pair? (cadr g)) (eq? (car (cadr g)) 'LENGTH))
        (mac 'FR-C-SPACE) (len-r) (arith))
       ((equal? g '(IN (VEC m) SET)) (ass))
       ((and (eq? (car g) 'IN) (equal? (cadr g) (list 'DISTS frm-frc)))
        (ass))
       ((eq? (car g) 'IS-PSEUDOMETRIC)
        (mac 'is-pseudometric)
        (for-each (lambda (l) (dk-focus! l) (frm-pseudo-law!)) (frm-goal-leaves!)))
       ;; separation: all d_k(u, v) vanish  =>  u = v
       ((eq? (car g) '=)
        (let* ((u (cadr g)) (v (caddr g)) (uv (frm-sub 'm u v))
               (hz (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL))) "vanishing family"))
               (all (list 'FORALL 'frk_ (list 'IMPLIES '(IN frk_ NN) (list '= (list '(fam frk_) uv) 0)))))
          (frm-vec! 'm uv)
          (dk-have! all
            (lambda ()
              (let ((k (cadr (car (dk-peel!)))))
                (dk-apply! hz k)
                (let ((e (dk-cite! 'frm-c-space-dists-apply 'm 'fam k u v)))
                  (subst (list '= (caddr e) (cadr e))))
                (ass))))
          (dk-cite! 'frm-fam-separates 'fld 'm 'fam)
          (dk-apply! (dk-ctx-form '(FORALL x (IMPLIES (IN x (VEC m))
                        (IMPLIES (FORALL k (IMPLIES (IN k NN) (= ((fam k) x) 0))) (= x (VZERO m))))))
                     uv)
          (dk-apply! (dk-cite! 'frm-v-sub-zero-eq 'm u v))
          (ass)))
       (#t (error "is-c-metric-space leaf" (expression->string g))))))
 (frm-goal-leaves!))
(qed 'frm-c-space-is-c-metric-space)

;;; =====================================================================
;;; (5) THE METRIC SPACE.
;;; =====================================================================

(sp (make-wff (frm-fstmt '(IS-METRIC-SPACE (FR-METRIC-SPACE m fam)))))
(di) (di)
(dk-cite! 'frm-c-space-is-c-metric-space 'fld 'm 'fam)
(dk-cite! 'c-metric-is-metric-space frm-frc)
(mac 'FR-METRIC-SPACE)
(ass)
(qed 'frm-metric-space-is-metric-space)

(sp (make-wff (frm-fstmt '(== (PTS (FR-METRIC-SPACE m fam)) (VEC m)))))
(di) (di)
(dk-cite! 'frm-c-space-is-c-metric-space 'fld 'm 'fam)
(dk-cite! 'c-metric-canonical-carrier frm-frc)
(dk-cite! 'frm-c-space-pts 'm 'fam)
(mac 'FR-METRIC-SPACE)
(subst (list '== (list 'PTS (list 'C-METRIC frm-frc)) (list 'PTS frm-frc)))
(subst (list '== (list 'PTS frm-frc) '(VEC m)))
(qrfl)
(qed 'frm-metric-space-pts)

;;; =====================================================================
;;; (6) THE TWO NESTINGS, for a general countably-metrised space s and its
;;;     canonical metric D = C-METRIC(s):
;;;   (L) a D-ball lies in a d_k-ball:   forall k, eps  exists dl:  D < dl => d_k < eps
;;;   (U) a prefix ball lies in a D-ball: forall eps exists K, dl:
;;;                                  (d_j < dl for all j <= K) => D <= eps
;;; Everything about convergence, Cauchy sequences and continuity below is
;;; epsilon-logic over these two; no series is summed after this section.
;;; =====================================================================

(define frm-w '(VNB-LAMBDA n NN (/ 1 (power 2 (+ n 1)))))
(define frm-cm (list 'C-METRIC-W 's frm-w))
(define (frm-dist a b) (list (list 'DIST frm-cm) a b))
(define (frm-d k a b) (list (list '(DISTS s) k) a b))
(define (frm-T a b)
  (list 'VNB-LAMBDA 'k 'NN (list '* (list frm-w 'k) (list 'min 1 (frm-d 'k a b)))))

;;; the formula a thunk landed last (lam-b-h REPLACES its hypothesis)
(define (frm-landed-last thunk)
  (let ((new (dk-landed thunk)))
    (if (null? new) (error "frm-landed-last: nothing landed"))
    (car (last-pair new))))
(define (frm-redex? e)                ; an application whose head is a VNB-LAMBDA
  (and (pair? e)
       (or (and (pair? (car e)) (eq? (car (car e)) 'VNB-LAMBDA))
           (any-pred frm-redex? e))))
(define (frm-beta-h! f)               ; beta in a hypothesis to a fixpoint (dk-lam-b-h! is one pass)
  (let loop ((f f) (fuel 8))
    (if (and (frm-redex? f) (> fuel 0))
        (let* ((new (dk-landed (lambda () (dk-lam-b-h! f)))))
          (if (null? new) (error "frm-beta-h!: nothing landed" (expression->string f)))
          (loop (car (last-pair new)) (- fuel 1)))
        f)))

;;; the summation facts of the canonical metric at (x, y): T in FUN(NN,RR), its
;;; nonnegativity universal, and SERIES-CONVERGES-TO(T, D(x,y)).
(define (frm-series-at! x y)
  (dk-cite! 'product-metric-default-summable)
  (dk-cite! 'c-metric-term-seq-in-fun 's frm-w x y)
  (dk-cite! 'c-metric-dist-converges 's frm-w x y)
  (dk-cite! 'cmim-term-nonneg 's frm-w x y))

(sp (make-wff
  '(FORALL s (IMPLIES (IS-C-METRIC-SPACE s)
     (FORALL k (IMPLIES (IN k NN)
       (FORALL eps (IMPLIES (POS-RR eps)
         (FORSOME dl (AND (POS-RR dl)
           (FORALL x (IMPLIES (IN x (PTS s)) (FORALL y (IMPLIES (IN y (PTS s))
             (IMPLIES (< ((DIST (C-METRIC s)) x y) dl) (< (((DISTS s) k) x y) eps))))))))))))))))
(dk-peel!)
(mac 'C-METRIC)
(let* ((wpos (frm-beta-h! (dk-cite! 'dyadic-weight-pos 'k)))     ; 0 < w_k
       (wty  (begin (dk-cite! 'dyadic-weight-in-fun)
                    (frm-beta-h! (dk-cite! 'fun-apply-type-c frm-w 'NN 'RR 'k))))
       (wv   (caddr wpos))
       (me   (list 'min 1 'eps))
       (dl   (list '* wv me)))
  (dk-cite! 'rr-pos-rr-in-rr 'eps)
  (dk-cite! 'rr-lt-of-pos-rr 'eps)
  (dk-cite! 'rr-one-in) (dk-cite! 'rr-zero-in)
  (dk-real! wv)
  (dk-cite! 'rr-min-closed 1 'eps)
  (dk-real! dl)
  (dk-have! '(< 0 1) (lambda () (arith)))
  (dk-cite! 'rr-lt-min 0 1 'eps)
  (dk-cite! 'rr-mul-pos wv me)
  (ew dl)
  (for-each
   (lambda (leaf)
     (dk-focus! leaf)
     (if (eq? (car (dk-goal)) 'POS-RR)
         (begin (dk-cite! 'rr-pos-rr-of-lt dl) (ass))
         (let* ((landed (dk-peel!))
                (g (dk-goal))                    ; d_k(x, y) < eps -- read x, y off it
                (x (cadr (cadr g))) (y (caddr (cadr g)))
                (h (find-first (dk-head? '<) landed))
                (dxy (frm-d 'k x y)))
           (frm-series-at! x y)
           (dk-cite! 'c-metric-dist-real 's 'k x y)
           (let* ((le  (dk-cite! 'series-term-le-sum (frm-T x y)))
                  (tk0 (dk-apply! le (frm-dist x y) 'k))
                  (tk  (frm-beta-h! tk0))
                  (mk  (list 'min 1 dxy)))
             (dk-cite! 'rr-min-closed 1 dxy)
             (dk-real! (list '* wv mk))
             (dk-have! (list 'NOT (list '<= 'eps dxy))
               (lambda ()
                 (di)
                 (dk-cite! 'rr-min-one-mono 'eps dxy)
                 (dk-have! (list '<= 0 wv) (lambda () (dk-ineq! wpos)))
                 (dk-have! (list 'AND (list '<= 0 wv) (list '<= me mk))
                           (lambda () (dk-close-all! (lambda () (di)))))
                 (dk-cite! 'rr-le-scale-nonneg wv me mk)
                 (dk-cite! 'cmim-dist-in-rr 's frm-w x y)
                 (let* ((wm (list '* wv mk))
                        (a (dk-name! dl 'RR)) (b (dk-name! wm 'RR))
                        (p1 (dk-rewrite-h! (dk-rewrite-h! (list '<= dl wm) dl a) wm b))
                        (p2 (dk-rewrite-h! tk wm b))
                        (p3 (dk-rewrite-h! h dl a)))
                   (dk-absurd! p1 p2 p3))))
             (dk-cite! 'rr-not-le-lt 'eps dxy)
             (ass)))))
   (dk-opened (lambda () (di)))))
(qed 'frm-c-ball-prefix)

;;; ---- (U), first the head of the series --------------------------------
;;; If d_j(x, y) < e for every j <= nb, then SUM_{j < nb} w_j min(1, d_j(x,y)) <= e.
;;; The partial sum is compared termwise with e w_j -- but only below nb, so the
;;; comparison goes through T'(j) = min(T(j), e w_j): T' agrees with T below nb
;;; (series-partial-sum-agree-below) and is <= e w_j everywhere
;;; (series-partial-sum-le-termwise-ptwise), and SUM_{j<nb} e w_j = e (1 - 2^-nb).

(define (frm-wk k) (list frm-w k))
(define (frm-in-rr-term! t)          ; (IN t RR) for t = (frm-w k) or a T(k)-redex at typed k
  (frm-once! (list 'IN t 'RR)
    (lambda ()
      (cond ((equal? (car t) frm-w)
             (dk-cite! 'dyadic-weight-in-fun)
             (dk-cite! 'fun-apply-type-c frm-w 'NN 'RR (cadr t)))
            (#t (error "frm-in-rr-term!: " (expression->string t)))))))

;;; the weight at a typed index, reduced: returns wk with (IN wk RR), (< 0 wk), (<= 0 wk)
(define (frm-weight! k)
  (let* ((pos (frm-beta-h! (dk-cite! 'dyadic-weight-pos k)))
         (wk  (caddr pos)))
    (dk-cite! 'dyadic-weight-in-fun)
    (frm-once! (list 'IN wk 'RR)
               (lambda () (frm-beta-h! (dk-cite! 'fun-apply-type-c frm-w 'NN 'RR k))))
    (dk-have! (list '<= 0 wk) (lambda () (dk-ineq! pos)))
    wk))

(sp (make-wff
  (list 'FORALL 's (list 'IMPLIES '(IS-C-METRIC-SPACE s)
   (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS s)) (list 'FORALL 'y (list 'IMPLIES '(IN y (PTS s))
    (list 'FORALL 'nb (list 'IMPLIES '(IN nb NN)
     (list 'FORALL 'e (list 'IMPLIES '(IN e RR) (list 'IMPLIES '(<= 0 e)
      (list 'IMPLIES '(FORALL j (IMPLIES (IN j NN) (IMPLIES (<= j nb) (< (((DISTS s) j) x y) e))))
        (list '<= (list 'SERIES-PARTIAL-SUM (frm-T 'x 'y) 'nb) 'e)))))))))))))))
(dk-peel!)
(let* ((tt (frm-T 'x 'y))
       (hp (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f 'DISTS)))
                    "the prefix hypothesis"))
       (tp (list 'VNB-LAMBDA 'hj_ 'NN (list 'min (list tt 'hj_) (list '* 'e (frm-wk 'hj_)))))
       (hh (list 'VNB-LAMBDA 'hj_ 'NN (list '* 'e (frm-wk 'hj_))))
       (ptw (lambda (body) (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN) (body 'tck_)))))
       (ptw< (lambda (body) (list 'FORALL 'tck_ (list 'IMPLIES '(IN tck_ NN)
                               (list 'IMPLIES '(< tck_ nb) (body 'tck_))))))
       (ptk (lambda (body) (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN) (body 'k_)))))
       (point! (lambda () (let ((lv (dk-peel!))) (cadr (car lv)))))
       (term-facts! (lambda (k)        ; reduced: wk, m = min(1, d_k), their typings
                      (let* ((wk (frm-weight! k)) (dk (frm-d k 'x 'y)) (mk (list 'min 1 dk)))
                        (dk-cite! 'rr-one-in)
                        (dk-cite! 'c-metric-dist-real 's k 'x 'y)
                        (dk-cite! 'rr-min-closed 1 dk)
                        (dk-real! (list '* wk mk))
                        (dk-real! (list '* 'e wk))
                        (list wk dk mk)))))
  (dk-cite! 'product-metric-default-summable)
  (dk-cite! 'c-metric-term-seq-in-fun 's frm-w 'x 'y)
  (dk-cite! 'dyadic-weight-in-fun)
  ;; A1: T(k) in RR below nb
  (dk-have! (ptw< (lambda (k) (list 'IN (list tt k) 'RR)))
    (lambda () (let ((k (point!))) (dk-cite! 'fun-apply-type-c tt 'NN 'RR k) (ass))))
  ;; A2: T'(k) = T(k) below nb
  (dk-have! (ptw< (lambda (k) (list '= (list tp k) (list tt k))))
    (lambda ()
      (let* ((k (point!)) (f (term-facts! k)) (wk (car f)) (dk (cadr f)) (mk (caddr f)))
        (dk-have! (list '<= k 'nb) (lambda () (dk-nn! (list '< k 'nb))))
        (dk-apply! hp k)
        (dk-cite! 'rr-min-le-right 1 dk)
        (dk-have! (list '<= mk 'e) (lambda () (dk-ineq! (list '<= mk dk) (list '< dk 'e))))
        (dk-have! (list 'AND (list '<= 0 wk) (list '<= mk 'e))
                  (lambda () (dk-close-all! (lambda () (di)))))
        (dk-cite! 'rr-le-scale-nonneg wk mk 'e)
        (dk-have! (list '= (list '* wk 'e) (list '* 'e wk)) (lambda () (crs)))
        (let ((le (dk-rewrite-h! (list '<= (list '* wk mk) (list '* wk 'e))
                                 (list '* wk 'e) (list '* 'e wk))))
          (dk-cite! 'rr-min-left-le (list '* wk mk) (list '* 'e wk))
          (dk-lam-b!)
          (ass)))))
  (let ((ag (dk-cite! 'series-partial-sum-agree-below 'nb tp tt)))
    ;; B1, B2, B3 and the pointwise facts for the scaling
    (dk-have! (ptk (lambda (k) (list 'IN (list tp k) 'RR)))
      (lambda () (let* ((k (point!)) (f (term-facts! k)))
                   (dk-lam-b!)
                   (dk-cite! 'rr-min-closed (list '* (car f) (caddr f)) (list '* 'e (car f)))
                   (ass))))
    (dk-have! (ptk (lambda (k) (list 'IN (list hh k) 'RR)))
      (lambda () (let* ((k (point!)) (f (term-facts! k))) (dk-lam-b!) (ass))))
    (dk-have! (ptk (lambda (k) (list '<= (list tp k) (list hh k))))
      (lambda () (let* ((k (point!)) (f (term-facts! k)))
                   (dk-lam-b!)
                   (dk-cite! 'rr-min-le-right (list '* (car f) (caddr f)) (list '* 'e (car f)))
                   (ass))))
    (dk-have! (ptk (lambda (k) (list 'IN (list frm-w k) 'RR)))
      (lambda () (let ((k (point!))) (dk-cite! 'fun-apply-type-c frm-w 'NN 'RR k) (ass))))
    (dk-have! (ptk (lambda (k) (list '= (list hh k) (list '* 'e (list frm-w k)))))
      (lambda () (let* ((k (point!)) (f (term-facts! k))) (dk-lam-b!) (rfl))))
    (let* ((le  (dk-cite! 'series-partial-sum-le-termwise-ptwise 'nb tp hh))
           (sc  (dk-cite! 'series-partial-sum-scale-ptwise 'nb 'e frm-w hh))
           (dy  (dk-cite! 'dyadic-partial-sum 'nb))
           (p2  (list 'power 2 'nb))
           (s1  (list 'SERIES-PARTIAL-SUM tt 'nb))
           (s2  (list 'SERIES-PARTIAL-SUM tp 'nb))
           (s3  (list 'SERIES-PARTIAL-SUM hh 'nb))
           (sw  (list 'SERIES-PARTIAL-SUM frm-w 'nb)))
      (dk-cite! 'series-partial-sum-in-rr 'nb tt)
      (dk-cite! 'series-partial-sum-in-rr 'nb frm-w)
      (dk-cite! 'series-partial-sum-in-rr-ptwise 'nb tp)
      (dk-cite! 'series-partial-sum-in-rr-ptwise 'nb hh)
      (dk-cite! 'rr-zero-in) (dk-cite! 'rr-one-in)
      (dk-cite! 'power-two-pos 'nb)
      (dk-have! '(IN 2 RR) (lambda () (from-context!)))
      (dk-cite! 'power-real-closed 2 'nb)
      (dk-cite! 'rr-recip-pos p2)
      (dk-have! (list 'NOT (list '= p2 0))
                (lambda () (di) (dk-absurd! (list '= p2 0) (list '< 0 p2))))
      (dk-have! (list 'AND (list 'IN p2 'RR) (list 'NOT (list '= p2 0)))
                (lambda () (dk-close-all! (lambda () (di)))))
      (dk-cite! 'rr-recip-closed p2)
      (dk-have! (list '<= sw 1) (lambda () (dk-ineq! dy (list '< 0 (list 'recip p2)))))
      (dk-have! (list 'AND (list '<= 0 'e) (list '<= sw 1))
                (lambda () (dk-close-all! (lambda () (di)))))
      (dk-cite! 'rr-le-scale-nonneg 'e sw 1)
      (dk-have! (list '= (list '* 'e 1) 'e) (lambda () (crs)))
      (let* ((esw (list '* 'e sw))
             (_   (dk-real! esw))
             (v   (dk-name! esw 'RR))
             (q1  (dk-rewrite-h! sc esw v))
             (q2  (dk-rewrite-h! (dk-rewrite-h! (list '<= esw (list '* 'e 1)) esw v)
                                 (list '* 'e 1) 'e)))
        (dk-ineq! ag le q1 q2)))))
(qed 'frm-c-head-small)

;;; the n-th term of the canonical series lies in [0, w_n]
(sp (make-wff
  (list 'FORALL 's (list 'IMPLIES '(IS-C-METRIC-SPACE s)
   (forall-guarded '(x y) '((IN x (PTS s)) (IN y (PTS s)))
     (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ NN)
       (list 'AND (list '<= 0 (list (frm-T 'x 'y) 'i_))
                  (list '<= (list (frm-T 'x 'y) 'i_) (list frm-w 'i_))))))))))
(dk-peel!)
(let* ((wk (frm-weight! 'i_)) (dk (frm-d 'i_ 'x 'y)))
  (dk-lam-b!)
  (dk-split! (dk-cite! 'c-metric-term-bound 's 'i_ 'x 'y wk))
  (dk-close-all! (lambda () (di))))
(qed 'frm-c-term-bounds)

;;; (U)
(sp (make-wff
  '(FORALL s (IMPLIES (IS-C-METRIC-SPACE s)
     (FORALL eps (IMPLIES (POS-RR eps)
       (FORSOME nb (AND (IN nb NN)
         (FORSOME dl (AND (POS-RR dl)
           (FORALL x (IMPLIES (IN x (PTS s)) (FORALL y (IMPLIES (IN y (PTS s))
             (IMPLIES (FORALL j (IMPLIES (IN j NN) (IMPLIES (<= j nb) (< (((DISTS s) j) x y) dl))))
                      (<= ((DIST (C-METRIC s)) x y) eps))))))))))))))))
(dk-peel!)
(mac 'C-METRIC)
(let* ((e2 (dk-halve! 'eps)))
  (dk-cite! 'product-metric-default-summable)
  (dk-cite! 'dyadic-weight-in-fun)
  (dk-have! (list 'SERIES-CONVERGES frm-w)
    (lambda () (mac-h 'summable-weight (list 'SUMMABLE-WEIGHT frm-w)) (dk-split-all!) (ass)))
  (let* ((tl (dk-apply! (dk-cite! 'series-tail-small frm-w) e2))
         (nb (dk-skolem! tl))
         (tlu (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f nb)
                                        (dk-contains? f 'SERIES-PARTIAL-SUM)))
                       "the weight tail")))
    (ew nb)
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (if (dk-head-is? (dk-goal) 'IN)
           (ass)
           (begin
             (ew e2)
             (for-each
              (lambda (leaf2)
                (dk-focus! leaf2)
                (if (dk-head-is? (dk-goal) 'POS-RR)
                    (ass)
                    (let* ((landed (dk-peel!))
                           (g (dk-goal))                  ; D(x, y) <= eps
                           (x (cadr (cadr g))) (y (caddr (cadr g)))
                           (tt (frm-T x y))
                           (ps (list 'VNB-LAMBDA 'k 'NN (list 'SERIES-PARTIAL-SUM tt 'k)))
                           (dxy (frm-dist x y)))
                      (frm-series-at! x y)
                      (dk-cite! 'cmim-dist-in-rr 's frm-w x y)
                      (dk-cite! 'rr-pos-rr-in-rr 'eps)
                      (dk-have! (list '<= 0 e2) (lambda () (dk-ineq! (list '< 0 e2))))
                      (let* ((hd (dk-cite! 'frm-c-head-small 's x y nb e2))
                             (tb (dk-cite! 'frm-c-term-bounds 's x y))
                             (sct (list 'SERIES-CONVERGES-TO tt dxy))
                             (cv (list 'CONVERGES-TO 'RR-MS ps dxy)))
                        (dk-have! cv (lambda () (mac-h 'series-converges-to sct) (ass)))
                        (dk-have! (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN)
                                    (list 'IMPLIES (list '<= nb 'k_) (list '<= (list ps 'k_) 'eps))))
                          (lambda ()
                            (let ((k (begin (dk-peel!) (cadr (cadr (dk-goal))))))   ; ps(k) <= eps
                              (subst (dk-cite! 'series-partial-sum-seq-apply tt k))
                              (let* ((bl (dk-cite! 'series-block-le k nb tt frm-w))
                                     (tk (dk-apply! tlu k)))
                                (for-each (lambda (f n) (dk-cite! 'series-partial-sum-in-rr n f))
                                          (list tt tt frm-w frm-w) (list k nb k nb))
                                ;; name the four partial sums: `ineq' does not certify an
                                ;; atom with a lambda inside
                                (let* ((sk (list 'SERIES-PARTIAL-SUM tt k))
                                       (sn (list 'SERIES-PARTIAL-SUM tt nb))
                                       (wk (list 'SERIES-PARTIAL-SUM frm-w k))
                                       (wn (list 'SERIES-PARTIAL-SUM frm-w nb))
                                       (a1 (dk-name! sk 'RR)) (a2 (dk-name! sn 'RR))
                                       (a3 (dk-name! wk 'RR)) (a4 (dk-name! wn 'RR))
                                       (rw (lambda (f) (fold-left (lambda (f pr)
                                                                    (if (dk-contains? f (car pr))
                                                                        (dk-rewrite-h! f (car pr) (cdr pr)) f))
                                                                  f (list (cons sk a1) (cons sn a2)
                                                                          (cons wk a3) (cons wn a4))))))
                                  (subst (list '= sk a1))
                                  (apply dk-ineq! (append (frm-seq-map rw (list bl tk hd)) (list (list '= (list '+ e2 e2) 'eps)))))))))
                        (dk-cite! 'series-partial-sum-seq-in-fun tt)
                        (dk-cite! 'rr-limit-le-of-tail ps dxy 'eps nb)
                        (ass)))))
              (dk-opened (lambda () (di)))))))
     (dk-opened (lambda () (di))))))
(qed 'frm-c-prefix-ball)

;;; ---- (L) and (U) for the seminorm family ---------------------------------

(define frm-fms '(FR-METRIC-SPACE m fam))
(define (frm-fdist a b) (list (list 'DIST frm-fms) a b))
(define (frm-p k v) (list (list 'fam k) v))

;;; (IN v (PTS FRC)) from (IN v (VEC m))
(define (frm-in-frc! v)
  (dk-cite! 'frm-c-space-pts 'm 'fam)
  (let ((ty (list 'IN v (list 'PTS frm-frc))))
    (frm-once! ty (lambda () (dk-rewrite-h! (frm-vec! 'm v) '(VEC m) (list 'PTS frm-frc))))
    ty))

(sp (make-wff (frm-fstmt
  (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
    (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
      (list 'FORSOME 'dl (list 'AND '(POS-RR dl)
        (forall-guarded '(x y) '((IN x (VEC m)) (IN y (VEC m)))
          (list 'IMPLIES (list '< (frm-fdist 'x 'y) 'dl)
                         (list '< (frm-p 'k (frm-sub 'm 'x 'y)) 'eps))))))))))))
(dk-peel!)
(mac 'FR-METRIC-SPACE)
(dk-cite! 'frm-fam-module 'fld 'm 'fam)
(dk-cite! 'frm-c-space-is-c-metric-space 'fld 'm 'fam)
(let* ((ex (dk-cite! 'frm-c-ball-prefix frm-frc 'k 'eps))
       (dl (dk-skolem! ex))
       (bl (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f dl)))
                    "the D-ball universal")))
  (ew dl)
  (for-each
   (lambda (leaf)
     (dk-focus! leaf)
     (if (dk-head-is? (dk-goal) 'POS-RR)
         (ass)
         (let* ((g (begin (dk-peel!) (dk-goal)))    ; fam(k)(x - y) < eps
                (xy (cadr (cadr g))) (x (cadr xy)) (y (cadr (caddr xy))))
           (frm-in-frc! x) (frm-in-frc! y)
           (let* ((r (dk-apply! bl x y))
                  (e (dk-cite! 'frm-c-space-dists-apply 'm 'fam 'k x y)))
             (dk-rewrite-h! r (cadr e) (caddr e))
             (ass)))))
   (dk-opened (lambda () (di)))))
(qed 'frm-ball-seminorm)

(sp (make-wff (frm-fstmt
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'nb (list 'AND '(IN nb NN)
      (list 'FORSOME 'dl (list 'AND '(POS-RR dl)
        (forall-guarded '(x y) '((IN x (VEC m)) (IN y (VEC m)))
          (list 'IMPLIES
            (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'IMPLIES '(<= j nb)
               (list '< (frm-p 'j (frm-sub 'm 'x 'y)) 'dl))))
            (list '<= (frm-fdist 'x 'y) 'eps))))))))))))
(dk-peel!)
(mac 'FR-METRIC-SPACE)
(dk-cite! 'frm-fam-module 'fld 'm 'fam)
(dk-cite! 'frm-c-space-is-c-metric-space 'fld 'm 'fam)
(let* ((ex1 (dk-cite! 'frm-c-prefix-ball frm-frc 'eps))
       (nb  (dk-skolem! ex1))
       (ex2 (dk-pick (dk-head? 'FORSOME) "the dl existential"))
       (dl  (dk-skolem! ex2))
       (ub  (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f dl)
                                      (dk-contains? f 'DIST)))
                     "the prefix-ball universal")))
  (ew nb)
  (for-each
   (lambda (leaf)
     (dk-focus! leaf)
     (if (dk-head-is? (dk-goal) 'IN)
         (ass)
         (begin
           (ew dl)
           (for-each
            (lambda (leaf2)
              (dk-focus! leaf2)
              (if (dk-head-is? (dk-goal) 'POS-RR)
                  (ass)
                  (let* ((landed (dk-peel!))
                         (g (dk-goal))                       ; D(x, y) <= eps
                         (x (cadr (cadr g))) (y (caddr (cadr g)))
                         (hpf (find-first (dk-head? 'FORALL) landed)))
                    (frm-in-frc! x) (frm-in-frc! y)
                    (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'IMPLIES (list '<= 'j nb)
                                (list '< (list (list (list 'DISTS frm-frc) 'j) x y) dl))))
                      (lambda ()
                        (let ((j (begin (dk-peel!) (cadr (car (cadr (dk-goal))))))) ; d_j(x,y) < dl
                          (subst (dk-cite! 'frm-c-space-dists-apply 'm 'fam j x y))
                          (dk-apply! hpf j)
                          (ass))))
                    (dk-apply! ub x y)
                    (ass))))
            (dk-opened (lambda () (di)))))))
   (dk-opened (lambda () (di)))))
(qed 'frm-seminorm-ball)

;;; ---- finitely many "eventually"s at once: the induction on the prefix length ----

(define (frm-hyp-u)
  '(FORALL j (IMPLIES (IN j NN) (FORSOME cap (AND (IN cap NN)
     (FORALL i (IMPLIES (IN i NN) (FORALL i2 (IMPLIES (IN i2 NN)
       (IMPLIES (<= cap i) (IMPLIES (<= cap i2) (< (((u j) i) i2) dl))))))))))))
(define (frm-concl-u nb)
  (list 'FORSOME 'ct (list 'AND '(IN ct NN)
    (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'IMPLIES (list '<= 'j nb)
      '(FORALL i (IMPLIES (IN i NN) (FORALL i2 (IMPLIES (IN i2 NN)
         (IMPLIES (<= ct i) (IMPLIES (<= ct i2) (< (((u j) i) i2) dl)))))))))))))

(sp (make-wff (list 'FORALL 'nb (list 'IMPLIES '(IN nb NN)
                (list 'FORALL 'u (list 'FORALL 'dl
                  (list 'IMPLIES (frm-hyp-u) (frm-concl-u 'nb))))))))
(let* ((ind (use-induction))
       (base (cdr (assq 'base ind))) (step (cdr (assq 'step ind)))
       (ih (cdr (assq 'ih ind))) (nb (cdr (assq 'var ind))))
  ;; base: prefix {0}
  (dk-focus! base)
  (let* ((landed (dk-peel!))
         (hyp (find-first (dk-head? 'FORALL) landed)))
    (dk-cite! 'nn-zero-in)
    (let* ((c0 (dk-skolem! (dk-apply! hyp 0)))
           (cu (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f c0)))
                        "the threshold at 0")))
      (ew c0)
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (dk-head-is? (dk-goal) 'IN)
             (ass)
             (let* ((ls (dk-peel!))
                    (g (dk-goal))
                    (ux (cadr g))                       ; (((u j) i) i2)
                    (j (cadr (car (car ux)))) (i (cadr (car ux))) (i2 (cadr ux)))
               (dk-cite! 'nn-le-zero-is-zero j)
               (subst (list '= j 0))
               (dk-apply! cu i i2)
               (ass))))
       (dk-opened (lambda () (di))))))
  ;; step: prefix {0..nb} -> {0..nb+1}, the threshold max(c1, c2)
  (dk-focus! step)
  (let* ((g0 (dk-goal))
         (uv (cadr g0)) (dv (cadr (caddr g0)))       ; the binders u, dl (not free anywhere)
         (landed (dk-peel!))
         (hyp (find-first (dk-head? 'FORALL) landed))
         (sn (list 'succ nb)))
    (if (not (and (dk-contains? (dk-goal) uv) (dk-contains? (dk-goal) dv)))
        (error "frm: the step's eigenvariables were renamed" uv dv))
    (dk-cite! 'nn-succ-closed nb)
    (let* ((c1 (dk-skolem! (dk-apply! ih uv dv)))
           (cu1 (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f c1)))
                         "the threshold up to nb"))
           (c2 (dk-skolem! (dk-apply! hyp sn)))
           (cu2 (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f c2)))
                         "the threshold at nb + 1"))
           (mx (list 'max c1 c2)))
      (dk-cite! 'nn-max-closed c1 c2)
      (dk-cite! 'nn-in-rr c1) (dk-cite! 'nn-in-rr c2)
      (dk-cite! 'rr-le-max-left c1 c2) (dk-cite! 'rr-le-max-right c1 c2)
      (dk-cite! 'rr-max-closed c1 c2)
      (ew mx)
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (dk-head-is? (dk-goal) 'IN)
             (ass)
             (let* ((ls (dk-peel!))
                    (g (dk-goal))                         ; (((u j) i) i2) < dl
                    (ux (cadr g))                       ; (((u j) i) i2)
                    (j (cadr (car (car ux)))) (i (cadr (car ux))) (i2 (cadr ux)))
               (dk-cite! 'nn-in-rr i) (dk-cite! 'nn-in-rr i2)
               (dk-cite! 'nn-le-succ-cases nb j)
               (use-cases (list (list '<= j nb) (list '= j sn))
                 (lambda ()
                   (dk-have! (list '<= c1 i) (lambda () (dk-ineq! (list '<= c1 mx) (list '<= mx i))))
                   (dk-have! (list '<= c1 i2) (lambda () (dk-ineq! (list '<= c1 mx) (list '<= mx i2))))
                   (dk-apply! (dk-apply! cu1 j) i i2)
                   (ass))
                 (lambda ()
                   (dk-have! (list '<= c2 i) (lambda () (dk-ineq! (list '<= c2 mx) (list '<= mx i))))
                   (dk-have! (list '<= c2 i2) (lambda () (dk-ineq! (list '<= c2 mx) (list '<= mx i2))))
                   (subst (list '= j sn))
                   (dk-apply! cu2 i i2)
                   (ass))))))
       (dk-opened (lambda () (di)))))))
(qed 'frm-prefix-eventually)

;;; =====================================================================
;;; (7) PROP. 8.24 (a), (c): convergence and Cauchy sequences.
;;; =====================================================================

(define (frm-in-fms! v)              ; (IN v (PTS FRMS)) from (IN v (VEC m))
  (dk-cite! 'frm-metric-space-pts 'fld 'm 'fam)
  (let ((ty (list 'IN v (list 'PTS frm-fms))))
    (frm-once! ty (lambda () (dk-rewrite-h! (frm-vec! 'm v) '(VEC m) (list 'PTS frm-fms))))
    ty))
(define (frm-seq-at! sq i)           ; (IN (sq i) (VEC m))
  (let ((ty (list 'IN (list sq i) '(VEC m))))
    (frm-once! ty (lambda () (dk-cite! 'fun-apply-type-c sq 'NN '(VEC m) i)))
    ty))
(define (frm-dist-real! a b)         ; (IN D(a, b) RR)
  (frm-in-fms! a) (frm-in-fms! b)
  (dk-cite! 'frm-metric-space-is-metric-space 'fld 'm 'fam)
  (dk-cite! 'metric-dist-real frm-fms a b))
(define (frm-pick-forall-with sym what)
  (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f sym))) what))
(define (frm-ball! k eps)            ; skolemise (L) at k, eps: returns (dl . universal)
  (let* ((ex (dk-apply! (dk-cite! 'frm-ball-seminorm 'fld 'm 'fam) k eps))
         (dl (dk-skolem! ex)))
    (cons dl (frm-pick-forall-with dl "the D-ball universal"))))
(define (frm-pball! eps)             ; skolemise (U) at eps: returns (nb dl universal)
  (let* ((ex1 (dk-apply! (dk-cite! 'frm-seminorm-ball 'fld 'm 'fam) eps))
         (nb  (dk-skolem! ex1))
         (dl  (dk-skolem! (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORSOME)
                                                    (dk-contains? f nb)))
                                   "the dl existential"))))
    (list nb dl (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f dl)
                                          (dk-contains? f 'DIST)))
                         "the prefix-ball universal"))))
;;; split a landed (AND ...) guard among LANDED
(define (frm-split-landed! landed) (for-each (lambda (f) (if (dk-head-is? f 'AND) (dk-split! f))) landed))
;;; the triple family (j, i, i2) |-> fam(j)(BODY(i, i2)) for frm-prefix-eventually
(define (frm-u3 body) (list 'VNB-LAMBDA 'fuj_ 'NN (list 'VNB-LAMBDA 'fui_ 'NN (list 'VNB-LAMBDA 'fuk_ 'NN
                        (list (list 'fam 'fuj_) (body 'fui_ 'fuk_))))))
(define (frm-hyp-at u3 dl) (subst-free 'u u3 (subst-free 'dl dl (frm-hyp-u))))

(define frm-seqstmt
  (lambda (body) (frm-fstmt (forall-guarded '(seq lim) '((IN seq (FUN NN (VEC m))) (IN lim (VEC m))) body))))

;;; metric convergence  =>  FR-CONV
(sp (make-wff (frm-seqstmt '(IMPLIES (CONVERGES-TO (FR-METRIC-SPACE m fam) seq lim) (FR-CONV m fam seq lim)))))
(dk-peel!)
(dk-cite! 'frm-fam-module 'fld 'm 'fam)
(mac-h 'converges-to (list 'CONVERGES-TO frm-fms 'seq 'lim))
(dk-split-all!)
(let ((cu (frm-pick-forall-with 'DIST "the metric eps-universal")))
  (mac 'fr-conv)
  (let* ((landed (dk-peel!))                   ; k in NN, POS-RR eps
         (kk (cadr (find-first (dk-head? 'IN) landed)))
         (ee (cadr (find-first (dk-head? 'POS-RR) landed)))
         (bl (frm-ball! kk ee)) (dl (car bl)) (ball (cdr bl))
         (d2 (begin (dk-cite! 'rr-pos-rr-in-rr dl) (dk-halve! dl)))
         (cap (dk-skolem! (dk-apply! cu d2)))
         (cn (frm-pick-forall-with cap "the metric threshold")))
    (ew cap)
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (if (dk-head-is? (dk-goal) 'IN)
           (ass)
           (let* ((landed (dk-peel!))
                  (_ (frm-split-landed! landed))
                  (v (cadr (cadr (dk-goal))))      ; (seq i) - lim
                  (si (cadr v)) (i (cadr si)))
             (frm-seq-at! 'seq i)
             (frm-dist-real! si 'lim)
             (let ((le (dk-apply! cn i)))
               (dk-have! (list '< (frm-fdist si 'lim) dl)
                         (lambda () (dk-ineq! le (list '= (list '+ d2 d2) dl) (list '< 0 d2))))
               (dk-apply! ball si 'lim)
               (ass)))))
     (dk-opened (lambda () (di))))))
(qed 'frm-conv-of-converges)

;;; FR-CONV  =>  metric convergence
(sp (make-wff (frm-seqstmt '(IMPLIES (FR-CONV m fam seq lim) (CONVERGES-TO (FR-METRIC-SPACE m fam) seq lim)))))
(dk-peel!)
(dk-cite! 'frm-fam-module 'fld 'm 'fam)
(dk-cite! 'frm-metric-space-is-metric-space 'fld 'm 'fam)
(dk-cite! 'frm-metric-space-pts 'fld 'm 'fam)
(let ((fc '(FR-CONV m fam seq lim)))
  (mac 'converges-to)
  (subst (list '== (list 'PTS frm-fms) '(VEC m)))
  (for-each
   (lambda (leaf)
     (dk-focus! leaf)
     (if (not (dk-head-is? (dk-goal) 'FORSOME))
         (ass)
         (let* ((eps (cadr (find-first (dk-head? 'POS-RR) (reverse (dk-asms)))))
                (pb (frm-pball! eps)) (nb (car pb)) (dl (cadr pb)) (ub (caddr pb))
                (u3 (frm-u3 (lambda (i i2) (frm-sub 'm (list 'seq i) 'lim))))
                (hyp (frm-hyp-at u3 dl)))
           (dk-have! hyp
             (lambda ()
               (let* ((j (cadr (car (dk-peel!))))
                      (fcu2 (frm-landed-last (lambda () (mac-h 'fr-conv fc))))
                      (c (dk-skolem! (dk-apply! fcu2 j dl)))
                      (cu2 (frm-pick-forall-with c "the seminorm threshold")))
                 (ew c)
                 (for-each
                  (lambda (l2)
                    (dk-focus! l2)
                    (if (dk-head-is? (dk-goal) 'IN)
                        (ass)
                        (let* ((ls (dk-peel!))
                               (ux (cadr (dk-goal))) (i (cadr (car ux))))
                          (dk-lam-b!)
                          (dk-have! (list 'AND (list 'IN i 'NN) (list '<= c i))
                                    (lambda () (dk-close-all! (lambda () (di)))))
                          (dk-apply! cu2 i)
                          (ass))))
                  (dk-opened (lambda () (di)))))))
           (let* ((ct (dk-skolem! (dk-cite! 'frm-prefix-eventually nb u3 dl)))
                  (pu (frm-pick-forall-with ct "the common threshold")))
             (ew ct)
             (for-each
              (lambda (l3)
                (dk-focus! l3)
                (if (dk-head-is? (dk-goal) 'IN)
                    (ass)
                    (let* ((ls (dk-peel!))
                           (g (dk-goal))           ; D(seq n_, lim) <= eps
                           (sn (cadr (cadr g))) (n (cadr sn)))
                      (frm-seq-at! 'seq n)
                      (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'IMPLIES (list '<= 'j nb)
                                  (list '< (frm-p 'j (frm-sub 'm sn 'lim)) dl))))
                        (lambda ()
                          (let ((j (begin (dk-peel!) (cadr (car (cadr (dk-goal)))))))
                            (frm-beta-h! (dk-apply! (dk-apply! pu j) n n))
                            (ass))))
                      (dk-apply! ub sn 'lim)
                      (ass))))
              (dk-opened (lambda () (di))))))))
   (frm-goal-leaves!)))
(qed 'frm-converges-of-conv)

(define (frm-cstmt body) (frm-fstmt (list 'FORALL 'seq (list 'IMPLIES '(IN seq (FUN NN (VEC m))) body))))

;;; metric Cauchy  =>  FR-CAUCHY
(sp (make-wff (frm-cstmt '(IMPLIES (IS-CAUCHY-SEQ (FR-METRIC-SPACE m fam) seq) (FR-CAUCHY m fam seq)))))
(dk-peel!)
(dk-cite! 'frm-fam-module 'fld 'm 'fam)
(mac-h 'is-cauchy-seq (list 'IS-CAUCHY-SEQ frm-fms 'seq))
(dk-split-all!)
(let ((cu (frm-pick-forall-with 'DIST "the metric eps-universal")))
  (mac 'fr-cauchy)
  (let* ((landed (dk-peel!))
         (kk (cadr (find-first (dk-head? 'IN) landed)))
         (ee (cadr (find-first (dk-head? 'POS-RR) landed)))
         (bl (frm-ball! kk ee)) (dl (car bl)) (ball (cdr bl))
         (d2 (begin (dk-cite! 'rr-pos-rr-in-rr dl) (dk-halve! dl)))
         (cap (dk-skolem! (dk-apply! cu d2)))
         (cn (frm-pick-forall-with cap "the metric threshold")))
    (ew cap)
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (if (dk-head-is? (dk-goal) 'IN)
           (ass)
           (let* ((landed (dk-peel!))
                  (_ (frm-split-landed! landed))
                  (v (cadr (cadr (dk-goal))))      ; (seq i) - (seq j)
                  (si (cadr v)) (sj (cadr (caddr v))) (i (cadr si)) (j (cadr sj)))
             (frm-seq-at! 'seq i) (frm-seq-at! 'seq j)
             (frm-dist-real! si sj)
             (dk-have! (list 'AND (list '<= cap i) (list '<= cap j))
                       (lambda () (dk-close-all! (lambda () (di)))))
             (let ((le (dk-apply! cn i j)))
               (dk-have! (list '< (frm-fdist si sj) dl)
                         (lambda () (dk-ineq! le (list '= (list '+ d2 d2) dl) (list '< 0 d2))))
               (dk-apply! ball si sj)
               (ass)))))
     (dk-opened (lambda () (di))))))
(qed 'frm-cauchy-of-metric)

;;; FR-CAUCHY  =>  metric Cauchy
(sp (make-wff (frm-cstmt '(IMPLIES (FR-CAUCHY m fam seq) (IS-CAUCHY-SEQ (FR-METRIC-SPACE m fam) seq)))))
(dk-peel!)
(dk-cite! 'frm-fam-module 'fld 'm 'fam)
(dk-cite! 'frm-metric-space-is-metric-space 'fld 'm 'fam)
(dk-cite! 'frm-metric-space-pts 'fld 'm 'fam)
(let ((fcs '(FR-CAUCHY m fam seq)))
  (mac 'is-cauchy-seq)
  (subst (list '== (list 'PTS frm-fms) '(VEC m)))
  (for-each
   (lambda (leaf)
     (dk-focus! leaf)
     (if (not (dk-head-is? (dk-goal) 'FORSOME))
         (ass)
         (let* ((eps (cadr (find-first (dk-head? 'POS-RR) (reverse (dk-asms)))))
                (pb (frm-pball! eps)) (nb (car pb)) (dl (cadr pb)) (ub (caddr pb))
                (u3 (frm-u3 (lambda (i i2) (frm-sub 'm (list 'seq i) (list 'seq i2)))))
                (hyp (frm-hyp-at u3 dl)))
           (dk-have! hyp
             (lambda ()
               (let* ((j (cadr (car (dk-peel!))))
                      (fcu2 (frm-landed-last (lambda () (mac-h 'fr-cauchy fcs))))
                      (c (dk-skolem! (dk-apply! fcu2 j dl)))
                      (cu2 (frm-pick-forall-with c "the seminorm threshold")))
                 (ew c)
                 (for-each
                  (lambda (l2)
                    (dk-focus! l2)
                    (if (dk-head-is? (dk-goal) 'IN)
                        (ass)
                        (let* ((ls (dk-peel!))
                               (ux (cadr (dk-goal))) (i (cadr (car ux))) (i2 (cadr ux)))
                          (dk-lam-b!)
                          (dk-have! (list 'AND (list 'IN i 'NN) (list '<= c i))
                                    (lambda () (dk-close-all! (lambda () (di)))))
                          (dk-have! (list 'AND (list 'IN i2 'NN) (list '<= c i2))
                                    (lambda () (dk-close-all! (lambda () (di)))))
                          (dk-apply! (dk-apply! cu2 i) i2)
                          (ass))))
                  (dk-opened (lambda () (di)))))))
           (let* ((ct (dk-skolem! (dk-cite! 'frm-prefix-eventually nb u3 dl)))
                  (pu (frm-pick-forall-with ct "the common threshold")))
             (ew ct)
             (for-each
              (lambda (l3)
                (dk-focus! l3)
                (if (dk-head-is? (dk-goal) 'IN)
                    (ass)
                    (let* ((ls (dk-peel!))
                           (_ (frm-split-landed! ls))
                           (g (dk-goal))           ; D(seq a, seq b) <= eps
                           (sa (cadr (cadr g))) (sb (caddr (cadr g))) (a (cadr sa)) (b (cadr sb)))
                      (frm-seq-at! 'seq a) (frm-seq-at! 'seq b)
                      (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'IMPLIES (list '<= 'j nb)
                                  (list '< (frm-p 'j (frm-sub 'm sa sb)) dl))))
                        (lambda ()
                          (let ((j (begin (dk-peel!) (cadr (car (cadr (dk-goal)))))))
                            (frm-beta-h! (dk-apply! (dk-apply! pu j) a b))
                            (ass))))
                      (dk-apply! ub sa sb)
                      (ass))))
              (dk-opened (lambda () (di))))))))
   (frm-goal-leaves!)))
(qed 'frm-metric-cauchy-of-cauchy)

;;; ---- THE STATEMENTS ---------------------------------------------------------

;;; Prop. 8.24 (a), sequential form: d(seq_n, lim) -> 0 iff p_k(seq_n - lim) -> 0 for every k.
(sp (make-wff (frm-seqstmt '(IFF (CONVERGES-TO (FR-METRIC-SPACE m fam) seq lim) (FR-CONV m fam seq lim)))))
(dk-peel!)
(dk-iff! (dk-head? 'FR-CONV)
  (lambda () (dk-cite! 'frm-conv-of-converges 'fld 'm 'fam 'seq 'lim) (ass))
  (lambda () (dk-cite! 'frm-converges-of-conv 'fld 'm 'fam 'seq 'lim) (ass)))
(qed 'frm-converges-iff)

;;; Prop. 8.24 (c), sequential form.
(sp (make-wff (frm-cstmt '(IFF (IS-CAUCHY-SEQ (FR-METRIC-SPACE m fam) seq) (FR-CAUCHY m fam seq)))))
(dk-peel!)
(dk-iff! (dk-head? 'FR-CAUCHY)
  (lambda () (dk-cite! 'frm-cauchy-of-metric 'fld 'm 'fam 'seq) (ass))
  (lambda () (dk-cite! 'frm-metric-cauchy-of-cauchy 'fld 'm 'fam 'seq) (ass)))
(qed 'frm-cauchy-iff)

;;; Def. 8.28 for this model: a Frechet space is a seminormed space (countable family)
;;; complete in its metric.
(sp (make-wff '(FORALL fld (FORALL m (FORALL fam (IFF (IS-FRECHET-STRUCTURE fld m fam)
                 (AND (IS-SEMINORM-FAMILY fld m fam) (IS-COMPLETE (FR-METRIC-SPACE m fam)))))))))
(di)
(dk-iff! (dk-head? 'AND)
  (lambda ()
    (mac-h 'is-frechet-structure '(IS-FRECHET-STRUCTURE fld m fam))
    (dk-split-all!)
    (let ((fu (frm-pick-forall-with 'FR-CAUCHY "the completeness clause")))
      (dk-cite! 'frm-fam-module 'fld 'm 'fam)
      (dk-cite! 'frm-metric-space-is-metric-space 'fld 'm 'fam)
      (dk-cite! 'frm-metric-space-pts 'fld 'm 'fam)
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (dk-head-is? (dk-goal) 'IS-SEMINORM-FAMILY)
             (ass)
             (begin
               (mac 'is-complete)
               (for-each
                (lambda (l2)
                  (dk-focus! l2)
                  (if (dk-head-is? (dk-goal) 'IS-METRIC-SPACE)
                      (ass)
                      (let* ((landed (dk-peel!))
                             (cs (find-first (dk-head? 'IS-CAUCHY-SEQ) landed))
                             (f (caddr cs)))
                        (dk-have! (list 'IN f '(FUN NN (VEC m)))
                          (lambda ()
                            (mac-h 'is-cauchy-seq cs)
                            (dk-split-all!)
                            (dk-rewrite-h! (list 'IN f (list 'FUN 'NN (list 'PTS frm-fms)))
                                           (list 'PTS frm-fms) '(VEC m))
                            (ass)))
                        (dk-cite! 'frm-cauchy-of-metric 'fld 'm 'fam f)
                        (let ((lv (dk-skolem! (dk-apply! fu f))))
                          (dk-cite! 'frm-converges-of-conv 'fld 'm 'fam f lv)
                          (mac 'converges)
                          (ew lv)
                          (ass)))))
                (dk-opened (lambda () (di)))))))
       (dk-opened (lambda () (di))))))
  (lambda ()
    (dk-split! (find-first (dk-head? 'AND) (dk-asms)))
    (dk-cite! 'frm-fam-module 'fld 'm 'fam)
    (dk-cite! 'frm-metric-space-is-metric-space 'fld 'm 'fam)
    (dk-cite! 'frm-metric-space-pts 'fld 'm 'fam)
    (mac 'is-frechet-structure)
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (if (dk-head-is? (dk-goal) 'IS-SEMINORM-FAMILY)
           (ass)
           (let* ((landed (dk-peel!))
                  (sq (cadr (find-first (dk-head? 'IN) landed))))
             (dk-cite! 'frm-metric-cauchy-of-cauchy 'fld 'm 'fam sq)
             (let* ((cv (dk-cite! 'complete-cauchy-converges frm-fms sq))
                    (ex (frm-landed-last (lambda () (mac-h 'converges cv))))
                    (lv (dk-skolem! ex))
                    (ct (list 'CONVERGES-TO frm-fms sq lv)))
               (dk-have! (list 'IN lv '(VEC m))
                 (lambda ()
                   (mac-h 'converges-to ct)
                   (dk-split-all!)
                   (dk-rewrite-h! (list 'IN lv (list 'PTS frm-fms)) (list 'PTS frm-fms) '(VEC m))
                   (ass)))
               (dk-cite! 'frm-conv-of-converges 'fld 'm 'fam sq lv)
               (ew lv)
               (dk-close-all! (lambda () (di)))))))
     (dk-opened (lambda () (di))))))
(qed 'frm-frechet-iff-complete)

;;; =====================================================================
;;; (8) THE DISTANCE: its value (the book's formula) and translation invariance.
;;; =====================================================================

;;; two pairs with the same pseudodistances have the same canonical distance
(sp (make-wff
  (list 'FORALL 's (list 'IMPLIES '(IS-C-METRIC-SPACE s)
    (forall-guarded '(x y x2 y2) '((IN x (PTS s)) (IN y (PTS s)) (IN x2 (PTS s)) (IN y2 (PTS s)))
      (list 'IMPLIES '(FORALL k (IMPLIES (IN k NN) (= (((DISTS s) k) x y) (((DISTS s) k) x2 y2))))
            '(= ((DIST (C-METRIC s)) x y) ((DIST (C-METRIC s)) x2 y2))))))))
(dk-peel!)
(mac 'C-METRIC)
(let* ((hk (frm-pick-forall-with 'DISTS "the equal pseudodistances"))
       (t1 (frm-T 'x 'y)) (t2 (frm-T 'x2 'y2)))
  (dk-cite! 'product-metric-default-summable)
  (dk-cite! 'c-metric-term-seq-in-fun 's frm-w 'x 'y)
  (dk-cite! 'c-metric-term-seq-in-fun 's frm-w 'x2 'y2)
  (dk-fun-ext! t1 t2 'NN 'RR #f #f
    (lambda (v)
      (let* ((wv (frm-weight! v)) (d2 (frm-d v 'x2 'y2)))
        (dk-cite! 'rr-one-in)
        (dk-cite! 'c-metric-dist-real 's v 'x2 'y2)
        (dk-cite! 'rr-min-closed 1 d2)
        (dk-real! (list '* wv (list 'min 1 d2)))
        (dk-lam-b!)
        (subst (dk-apply! hk v))
        (rfl))))
  (let* ((e1 (dk-cite! 'c-metric-distance 's frm-w 'x 'y))
         (e2 (dk-cite! 'c-metric-distance 's frm-w 'x2 'y2))
         (e1b (dk-rewrite-h! e1 t1 t2)))
    (dk-cite! 'cmim-dist-in-rr 's frm-w 'x 'y)
    (subst e2)
    (subst (list '= (caddr e1b) (cadr e1b)))
    (rfl)))
(qed 'frm-c-dist-congr)

;;; Prop. 8.24 (a): d is translation invariant, d(x + r, y + r) = d(x, y).
(sp (make-wff (frm-fstmt
  (forall-guarded '(x y r) '((IN x (VEC m)) (IN y (VEC m)) (IN r (VEC m)))
    (list '= (frm-fdist (frm-add 'm 'x 'r) (frm-add 'm 'y 'r)) (frm-fdist 'x 'y))))))
(dk-peel!)
(mac 'FR-METRIC-SPACE)
(dk-cite! 'frm-fam-module 'fld 'm 'fam)
(dk-cite! 'frm-c-space-is-c-metric-space 'fld 'm 'fam)
(let ((xr (frm-add 'm 'x 'r)) (yr (frm-add 'm 'y 'r)))
  (for-each frm-in-frc! (list 'x 'y xr yr))
  (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
              (list '= (frm-dd 'k xr yr) (frm-dd 'k 'x 'y))))
    (lambda ()
      (let ((k (cadr (car (dk-peel!)))))
        (subst (dk-cite! 'frm-c-space-dists-apply 'm 'fam k xr yr))
        (subst (dk-cite! 'frm-c-space-dists-apply 'm 'fam k 'x 'y))
        (subst (dk-cite! 'frm-v-sub-shift 'm 'x 'y 'r))
        (frm-p-real! k (frm-sub 'm 'x 'y))
        (rfl))))
  (dk-cite! 'frm-c-dist-congr frm-frc xr yr 'x 'y)
  (ass))
(qed 'frm-metric-translation-invariant)

;;; Prop. 8.24 (a): the distance is the book's series,
;;;   d(x, y) = SUM_k 2^-(k+1) min(1, p_k(x - y)).
(define (frm-book-series a b)
  (list 'VNB-LAMBDA 'k 'NN (list '* '(/ 1 (power 2 (+ k 1)))
                                (list 'min 1 (frm-p 'k (frm-sub 'm a b))))))
(sp (make-wff (frm-fstmt
  (forall-guarded '(x y) '((IN x (VEC m)) (IN y (VEC m)))
    (list '== '((FR-METRIC m fam) x y) (list 'SERIES-LIMIT (frm-book-series 'x 'y)))))))
(dk-peel!)
(mac 'FR-METRIC)
(mac 'FR-METRIC-SPACE)
(mac 'C-METRIC)
(dk-cite! 'frm-fam-module 'fld 'm 'fam)
(dk-cite! 'frm-c-space-is-c-metric-space 'fld 'm 'fam)
(frm-in-frc! 'x) (frm-in-frc! 'y)
(let* ((tf (list 'VNB-LAMBDA 'k 'NN (list '* (list frm-w 'k)
                                         (list 'min 1 (list (list (list 'DISTS frm-frc) 'k) 'x 'y)))))
       (tb (frm-book-series 'x 'y))
       (e1 (dk-cite! 'c-metric-distance frm-frc frm-w 'x 'y)))
  (dk-cite! 'product-metric-default-summable)
  (dk-cite! 'c-metric-term-seq-in-fun frm-frc frm-w 'x 'y)
  (dk-fun-ext! tf tb 'NN 'RR #f
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((k (cadr (car (dk-peel!)))) (v (frm-sub 'm 'x 'y)))
            (frm-weight! k)
            (frm-p-real! k v)
            (dk-cite! 'rr-one-in)
            (dk-cite! 'rr-min-closed 1 (frm-p k v))
            (dk-real! (list '* (list '/ 1 (list 'power 2 (list '+ k 1))) (list 'min 1 (frm-p k v))))
            (ass)))))
    (lambda (v)
      (frm-weight! v)
      (frm-p-real! v (frm-sub 'm 'x 'y))
      (dk-cite! 'rr-one-in)
      (dk-cite! 'rr-min-closed 1 (frm-p v (frm-sub 'm 'x 'y)))
      (dk-lam-b!)
      (subst (dk-cite! 'frm-c-space-dists-apply 'm 'fam v 'x 'y))
      (dk-real! (list '* (list '/ 1 (list 'power 2 (list '+ v 1))) (list 'min 1 (frm-p v (frm-sub 'm 'x 'y)))))
      (rfl)))
  (subst e1)
  (subst (list '= tf tb))
  (qrfl))
(qed 'frm-metric-value)

;;; =====================================================================
;;; (9) PROP. 8.25 (ii): addition is continuous, stated sequentially in the
;;;     metric -- x_n -> x and y_n -> y imply x_n + y_n -> x + y.
;;; =====================================================================

(define (frm-max-threshold! c1 c2)    ; (IN max NN), c1, c2 <= max, all typed in RR
  (let ((mx (list 'max c1 c2)))
    (dk-cite! 'nn-max-closed c1 c2)
    (dk-cite! 'nn-in-rr c1) (dk-cite! 'nn-in-rr c2)
    (dk-cite! 'rr-le-max-left c1 c2) (dk-cite! 'rr-le-max-right c1 c2)
    (dk-cite! 'rr-max-closed c1 c2)
    mx))
;;; open FR-CONV(m, fam, sq, lv) at (k, e): returns (cap . universal)
(define (frm-conv-at! fc k e)
  (let* ((u (frm-landed-last (lambda () (dk-have! fc (lambda () (ass))) (mac-h 'fr-conv fc))))
         (c (dk-skolem! (dk-apply! u k e))))
    (cons c (frm-pick-forall-with c "the seminorm threshold"))))

(define frm-sum-seq '(VNB-LAMBDA frn_ NN ((VADD m) (sa frn_) (sb frn_))))

(sp (make-wff (frm-fstmt
  (forall-guarded '(sa sb a b)
                  '((IN sa (FUN NN (VEC m))) (IN sb (FUN NN (VEC m))) (IN a (VEC m)) (IN b (VEC m)))
    (list 'IMPLIES '(CONVERGES-TO (FR-METRIC-SPACE m fam) sa a)
      (list 'IMPLIES '(CONVERGES-TO (FR-METRIC-SPACE m fam) sb b)
        (list 'CONVERGES-TO frm-fms frm-sum-seq (frm-add 'm 'a 'b))))))))
(dk-peel!)
(dk-cite! 'frm-fam-module 'fld 'm 'fam)
(let* ((fa (dk-cite! 'frm-conv-of-converges 'fld 'm 'fam 'sa 'a))
       (fb (dk-cite! 'frm-conv-of-converges 'fld 'm 'fam 'sb 'b))
       (ab (frm-add 'm 'a 'b)))
  (frm-vec! 'm ab)
  (dk-have! (list 'IN frm-sum-seq '(FUN NN (VEC m)))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((i (cadr (car (dk-peel!)))))
            (frm-seq-at! 'sa i) (frm-seq-at! 'sb i)
            (frm-vec! 'm (frm-add 'm (list 'sa i) (list 'sb i)))
            (ass))))))
  (dk-have! (list 'FR-CONV 'm 'fam frm-sum-seq ab)
    (lambda ()
      (mac 'fr-conv)
      (let* ((landed (dk-peel!))
             (k (cadr (find-first (dk-head? 'IN) landed)))
             (e (cadr (find-first (dk-head? 'POS-RR) landed)))
             (e2 (begin (dk-cite! 'rr-pos-rr-in-rr e) (dk-halve! e)))
             (ca (frm-conv-at! fa k e2)) (cb (frm-conv-at! fb k e2))
             (mx (frm-max-threshold! (car ca) (car cb))))
        (frm-fam-at! k)
        (ew mx)
        (for-each
         (lambda (leaf)
           (dk-focus! leaf)
           (if (dk-head-is? (dk-goal) 'IN)
               (ass)
               (let* ((ls (dk-peel!))
                      (_ (frm-split-landed! ls))
                      (i (cadr (cadr (cadr (cadr (dk-goal))))))   ; p_k(S(i) - (a + b)) < eps
                      (ua (frm-sub 'm (list 'sa i) 'a)) (ub (frm-sub 'm (list 'sb i) 'b))
                      (p (list 'fam k)))
                 (frm-seq-at! 'sa i) (frm-seq-at! 'sb i)
                 (dk-cite! 'nn-in-rr i)
                 (dk-lam-b!)
                 (subst (dk-cite! 'frm-v-sub-add 'm (list 'sa i) (list 'sb i) 'a 'b))
                 (frm-p-real! k ua) (frm-p-real! k ub) (frm-p-real! k (frm-add 'm ua ub))
                 (let ((sub (dk-apply! (dk-cite! 'frm-sn-subadd 'fld 'm p) ua ub)))
                   (for-each
                    (lambda (cc)
                      (dk-have! (list '<= (car cc) i)
                                (lambda () (dk-ineq! (list '<= (car cc) mx) (list '<= mx i))))
                      (dk-have! (list 'AND (list 'IN i 'NN) (list '<= (car cc) i))
                                (lambda () (dk-close-all! (lambda () (di)))))
                      (dk-apply! (cdr cc) i))
                    (list ca cb))
                   (dk-ineq! sub (list '< (frm-p k ua) e2) (list '< (frm-p k ub) e2)
                             (list '= (list '+ e2 e2) e))))))
         (dk-opened (lambda () (di)))))))
  (dk-cite! 'frm-converges-of-conv 'fld 'm 'fam frm-sum-seq ab)
  (ass))
(qed 'frm-add-continuous)

;;; =====================================================================
;;; (10) PROP. 8.26, the bound => continuity half.
;;; =====================================================================

;;; a linear map commutes with differences: tt(a - b) = tt(a) - tt(b)
(sp (make-wff
  (list 'FORALL 'm1 (list 'FORALL 'm2 (list 'FORALL 'tt (list 'IMPLIES '(IS-LINEAR-MAP m1 m2 tt)
    (forall-guarded '(a b) '((IN a (VEC m1)) (IN b (VEC m1)))
      (list '= (list 'tt (frm-sub 'm1 'a 'b)) (frm-sub 'm2 '(tt a) '(tt b))))))))))
(dk-peel!)
(dk-project! '(IS-MODULE m1) (lambda () (mac-h 'is-linear-map '(IS-LINEAR-MAP m1 m2 tt))))
(dk-project! '(IS-MODULE m2) (lambda () (mac-h 'is-linear-map '(IS-LINEAR-MAP m1 m2 tt))))
(dk-project! '(IN tt (FUN (VEC m1) (VEC m2))) (lambda () (mac-h 'is-linear-map '(IS-LINEAR-MAP m1 m2 tt))))
(let* ((addu (frm-landed-last
               (lambda ()
                 (dk-have! '(FORALL x (IMPLIES (IN x (VEC m1)) (FORALL y (IMPLIES (IN y (VEC m1))
                              (= (tt ((VADD m1) x y)) ((VADD m2) (tt x) (tt y)))))))
                   (lambda () (mac-h 'is-linear-map '(IS-LINEAR-MAP m1 m2 tt)) (dk-split-all!) (ass))))))
       (z1 '(VZERO m1)) (nb1 (frm-neg 'm1 'b))
       (ty (lambda (v) (frm-vec! 'm1 v)
                       (frm-once! (list 'IN (list 'tt v) '(VEC m2))
                         (lambda () (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) v))))))
  (for-each ty (list z1 nb1 'a 'b (frm-add 'm1 'a nb1) (frm-add 'm1 'b nb1)))
  (let* ((t0 (list 'tt z1))
         (e0 (dk-apply! addu z1 z1))                         ; tt(0+0) = tt0 + tt0
         (r0 (dk-cite! 'abelian-group-right-id-module-vector-ag 'm1 z1))
         (e0b (dk-rewrite-h! e0 (frm-add 'm1 z1 z1) z1))      ; tt0 = tt0 + tt0
         (_ (dk-have! (list '= (frm-add 'm2 t0 t0) t0)
              (lambda () (subst (list '= (frm-add 'm2 t0 t0) t0)) (frm-vec! 'm2 t0) (rfl))))
         (z0 (dk-cite! 'abelian-group-idempotent-is-id-module-vector-ag 'm2 t0))   ; tt0 = 0
         (e1 (dk-apply! addu 'b nb1))                        ; tt(b + -b) = tt b + tt(-b)
         (r1 (dk-cite! 'frm-v-right-inv 'm1 'b))
         (e1b (dk-rewrite-h! (dk-rewrite-h! e1 (frm-add 'm1 'b nb1) z1) t0 '(VZERO m2)))
         (tb (list 'tt 'b)) (tnb (list 'tt nb1)))
    (dk-have! (list '= (frm-add 'm2 tb tnb) '(VZERO m2))
      (lambda () (subst (list '= (frm-add 'm2 tb tnb) '(VZERO m2))) (dk-cite! 'module-vzero-in 'm2) (rfl)))
    (let* ((iu (dk-cite! 'abelian-group-inverse-unique-module-vector-ag 'm2 tb tnb))  ; tt(-b) = -tt(b)
           (e2 (dk-apply! addu 'a nb1)))
      (subst e2)
      (subst iu)
      (frm-vec! 'm2 (frm-sub 'm2 '(tt a) tb))
      (rfl))))
(qed 'frm-linear-sub)

;;; the bound of Prop. 8.26, with "max_{j <= nb} p_j(x)" written through its upper
;;; bounds: (p_j(x) <= r for all j <= nb) => q_k(tt x) <= C r.
(define frm-bound-826
  '(FORALL k (IMPLIES (IN k NN) (FORSOME nb (AND (IN nb NN) (FORSOME ck (AND (POS-RR ck)
     (FORALL x (IMPLIES (IN x (VEC m1)) (FORALL r (IMPLIES (IN r RR)
       (IMPLIES (FORALL j (IMPLIES (IN j NN) (IMPLIES (<= j nb) (<= ((fam1 j) x) r))))
                (<= ((fam2 k) (tt x)) (* ck r))))))))))))))
(define (frm-stmt-826 body)
  (list 'FORALL 'fld (list 'FORALL 'm1 (list 'FORALL 'fam1 (list 'FORALL 'm2 (list 'FORALL 'fam2 (list 'FORALL 'tt
    (list 'IMPLIES '(IS-SEMINORM-FAMILY fld m1 fam1) (list 'IMPLIES '(IS-SEMINORM-FAMILY fld m2 fam2)
      (list 'IMPLIES '(IS-LINEAR-MAP m1 m2 tt) body))))))))))

(define (frm-pv! md fm k v)           ; (IN ((fm k) v) RR), v typed in VEC md, k in NN
  (dk-cite! 'frm-fam-type 'fld md fm)
  (let ((fk (list 'IN (list fm k) (list 'FUN (list 'VEC md) 'RR))))
    (frm-once! fk (lambda () (dk-cite! 'fun-apply-type-c fm 'NN (list 'FUN (list 'VEC md) 'RR) k)))
    (let ((ty (list 'IN (list (list fm k) v) 'RR)))
      (frm-once! ty (lambda () (dk-cite! 'fun-apply-type-c (list fm k) (list 'VEC md) 'RR v)))
      ty)))

(sp (make-wff (frm-stmt-826 (list 'IMPLIES frm-bound-826 '(IS-CONT-LIN m1 fam1 m2 fam2 tt)))))
(dk-peel!)
(dk-cite! 'frm-fam-module 'fld 'm1 'fam1)
(dk-cite! 'frm-fam-module 'fld 'm2 'fam2)
(dk-project! '(IN tt (FUN (VEC m1) (VEC m2))) (lambda () (mac-h 'is-linear-map '(IS-LINEAR-MAP m1 m2 tt))))
(let ((bnd (frm-pick-forall-with 'ck "the bound")))
  (mac 'is-cont-lin)
  (for-each
   (lambda (leaf)
     (dk-focus! leaf)
     (if (dk-head-is? (dk-goal) 'IS-LINEAR-MAP)
         (ass)
         (let* ((landed (dk-peel!))
                (fc (find-first (dk-head? 'FR-CONV) landed))
                (sq (caddr (cdr fc))) (lv (car (cddddr fc))))
           (mac 'fr-conv)
           (let* ((l2 (dk-peel!))
                  (k (cadr (find-first (dk-head? 'IN) l2)))
                  (e (cadr (find-first (dk-head? 'POS-RR) l2)))
                  (e2 (begin (dk-cite! 'rr-pos-rr-in-rr e) (dk-halve! e)))
                  (nb (dk-skolem! (dk-apply! bnd k)))
                  (ck (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f nb)))
                                           "the constant")))
                  (bu (frm-pick-forall-with ck "the bound at k"))
                  (_ (begin (dk-cite! 'rr-pos-rr-in-rr ck) (dk-cite! 'rr-lt-of-pos-rr ck)
                            (dk-have! (list '<= 0 ck) (lambda () (dk-ineq! (list '< 0 ck))))))
                  (d (dk-skolem! (dk-cite! 'rr-scale-eps ck e2)))
                  (su (frm-pick-forall-with d "the scaled bound"))
                  (u3 (list 'VNB-LAMBDA 'fuj_ 'NN (list 'VNB-LAMBDA 'fui_ 'NN (list 'VNB-LAMBDA 'fuk_ 'NN
                        (list '(fam1 fuj_) (frm-sub 'm1 (list sq 'fui_) lv))))))
                  (hyp (frm-hyp-at u3 d)))
             (dk-cite! 'rr-pos-rr-in-rr d) (dk-cite! 'rr-lt-of-pos-rr d)
             (dk-have! hyp
               (lambda ()
                 (let* ((j (cadr (car (dk-peel!))))
                        (u (frm-landed-last (lambda () (mac-h 'fr-conv fc))))
                        (c (dk-skolem! (dk-apply! u j d)))
                        (cu (frm-pick-forall-with c "the seminorm threshold")))
                   (ew c)
                   (for-each
                    (lambda (l3)
                      (dk-focus! l3)
                      (if (dk-head-is? (dk-goal) 'IN)
                          (ass)
                          (let* ((ls (dk-peel!)) (ux (cadr (dk-goal))) (i (cadr (car ux))))
                            (dk-lam-b!)
                            (dk-have! (list 'AND (list 'IN i 'NN) (list '<= c i))
                                      (lambda () (dk-close-all! (lambda () (di)))))
                            (dk-apply! cu i)
                            (ass))))
                    (dk-opened (lambda () (di)))))))
             (let* ((ct (dk-skolem! (dk-cite! 'frm-prefix-eventually nb u3 d)))
                    (pu (frm-pick-forall-with ct "the common threshold")))
               (ew ct)
               (for-each
                (lambda (l4)
                  (dk-focus! l4)
                  (if (dk-head-is? (dk-goal) 'IN)
                      (ass)
                      (let* ((ls (dk-peel!))
                             (_ (frm-split-landed! ls))
                             (i (cadr (cadr (cadr (cadr (dk-goal))))))  ; q(S(i) - tt lim) < eps
                             (si (list sq i)) (v (frm-sub 'm1 si lv)) (tv (list 'tt v)))
                        (dk-cite! 'fun-apply-type-c sq 'NN '(VEC m1) i)
                        (frm-vec! 'm1 v)
                        (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) v)
                        (dk-lam-b!)
                        (let ((ls (dk-cite! 'frm-linear-sub 'm1 'm2 'tt si lv)))
                          (subst (list '= (caddr ls) (cadr ls))))
                        (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'IMPLIES (list '<= 'j nb)
                                    (list '<= (list '(fam1 j) v) d))))
                          (lambda ()
                            (let ((j (begin (dk-peel!) (cadr (car (cadr (dk-goal)))))))
                              (frm-pv! 'm1 'fam1 j v)
                              (dk-ineq! (frm-beta-h! (dk-apply! (dk-apply! pu j) i i))))))
                        (let* ((b (dk-apply! bu v d))
                               (_ (dk-have! (list '<= 0 d) (lambda () (dk-ineq! (list '< 0 d)))))
                               (_ (dk-have! (list '<= d d) (lambda () (dk-ineq!))))
                               (sc (dk-apply! su d))
                               (_ (frm-pv! 'm2 'fam2 k tv))
                               (_ (dk-real! (list '* ck d)))
                               (w (dk-name! (list '* ck d) 'RR)))
                          (let* ((bw (dk-rewrite-h! b (list '* ck d) w))
                                 (sw (dk-rewrite-h! sc (list '* ck d) w)))
                            (dk-ineq! bw sw (list '= (list '+ e2 e2) e) (list '< 0 e2)))))))
                (dk-opened (lambda () (di)))))))))
   (dk-opened (lambda () (di)))))
(qed 'frm-cont-lin-of-bound)

;;; split the focus goal's ANDs only (no peeling); return the leaves
(define (frm-goal-leaves-shallow!)
  (let walk ((n (proof-state-focus *ps*)))
    (dk-focus! n)
    (if (dk-head-is? (dk-goal) 'AND)
        (apply append (frm-seq-map walk (dk-opened (lambda () (di)))))
        (list n))))

;;; =====================================================================
;;; (11) PROP. 8.24 (b): two translation-invariant metrics with the same
;;;      convergent sequences are uniformly equivalent.
;;; =====================================================================

(define (frm-ti s)                     ; s is translation invariant on VEC m
  (forall-guarded '(x y r) '((IN x (VEC m)) (IN y (VEC m)) (IN r (VEC m)))
    (list '= (list (list 'DIST s) (frm-add 'm 'x 'r) (frm-add 'm 'y 'r)) (list (list 'DIST s) 'x 'y))))
(define (frm-c12 s1 s2)                ; s1-null sequences are s2-null
  (list 'FORALL 'sq (list 'IMPLIES '(IN sq (FUN NN (VEC m)))
    (list 'IMPLIES (list 'CONVERGES-TO s1 'sq '(VZERO m)) (list 'CONVERGES-TO s2 'sq '(VZERO m))))))

;;; the general fact, for any two such metrics on a module: continuity of the
;;; identity at 0 (sequential, then epsilon-delta by continuous-at-iff-sequential)
;;; is uniform continuity, by translation.
(sp (make-wff
  (list 'FORALL 'm (list 'IMPLIES '(IS-MODULE m)
    (list 'FORALL 's1 (list 'FORALL 's2
      (list 'IMPLIES '(IS-METRIC-SPACE s1) (list 'IMPLIES '(IS-METRIC-SPACE s2)
        (list 'IMPLIES '(== (PTS s1) (VEC m)) (list 'IMPLIES '(== (PTS s2) (VEC m))
          (list 'IMPLIES (frm-ti 's1) (list 'IMPLIES (frm-ti 's2)
            (list 'IMPLIES (frm-c12 's1 's2)
              '(IS-UNIFORMLY-CONTINUOUS s1 s2 (ID-FUN (VEC m))))))))))))))))
(dk-peel!)
(let* ((id '(ID-FUN (VEC m))) (z '(VZERO m))
       (ti1 (dk-ctx-form (frm-ti 's1))) (ti2 (dk-ctx-form (frm-ti 's2)))
       (c12 (dk-ctx-form (frm-c12 's1 's2)))
       (to-vec (lambda ()
                 (if (dk-contains? (dk-goal) '(PTS s1)) (subst '(== (PTS s1) (VEC m))))
                 (if (dk-contains? (dk-goal) '(PTS s2)) (subst '(== (PTS s2) (VEC m)))))))
  (dk-cite! 'frm-module-vec-set 'm)
  (dk-cite! 'nn-is-set)
  (dk-cite! 'id-fun-type '(VEC m))
  (dk-cite! 'module-vzero-in 'm)
  (dk-have! (list 'IN id '(FUN (PTS s1) (PTS s2))) (lambda () (to-vec) (ass)))
  (dk-have! (list 'IN z '(PTS s1)) (lambda () (to-vec) (ass)))
  (let* ((cas (dk-cite! 'continuous-at-iff-sequential 's1 's2 id z))
         (lhs (cadr cas)) (rhs (caddr cas)))
    (ai cas)
    (dk-have! rhs
      (lambda ()
        (let* ((landed (dk-peel!))
               (sm (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-contains? f 'SQN))) landed))
               (sq (cadr sm)))
          (frm-landed-last (lambda () (mac-h 'sqn-membership sm)))
          (dk-rewrite-h! (list 'IN sq '(FUN NN (PTS s1))) '(PTS s1) '(VEC m))
          (dk-apply! c12 sq)
          (subst (dk-cite! 'compose-id-left 'NN '(VEC m) sq))
          (subst (dk-cite! 'id-fun-apply '(VEC m) z))
          (ass))))
    (dk-landed (lambda () (detach! (list 'IMPLIES rhs lhs))))
    (let* ((cu (begin (mac-h 'is-continuous-at lhs) (dk-split-all!)
                      (frm-pick-forall-with 'DIST "the epsilon-delta clause"))))
      (mac 'is-uniformly-continuous)
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (not (dk-head-is? (dk-goal) 'FORALL))
             (ass)
             (let* ((e (cadr (car (dk-peel!))))
                    (dl (dk-skolem! (dk-apply! cu e)))
                    (bu (frm-pick-forall-with dl "the delta universal")))
               (ew dl)
               (for-each
                (lambda (l2)
                  (dk-focus! l2)
                  (if (dk-head-is? (dk-goal) 'POS-RR)
                      (ass)
                      (let* ((ls (dk-peel!))
                             (h (find-first (dk-head? '<=) ls))
                             (a (cadr (cadr h))) (b (caddr (cadr h)))
                             (na (frm-neg 'm a)) (v (frm-sub 'm b a)))
                        (dk-rewrite-h! (list 'IN a '(PTS s1)) '(PTS s1) '(VEC m))
                        (dk-rewrite-h! (list 'IN b '(PTS s1)) '(PTS s1) '(VEC m))
                        (frm-vec! 'm v) (frm-vec! 'm na)
                        (dk-have! (list 'IN v '(PTS s1)) (lambda () (to-vec) (ass)))
                        (dk-cite! 'frm-v-right-inv 'm a)
                        (let* ((t1 (dk-rewrite-h! (dk-apply! ti1 a b na) (frm-add 'm a na) z))
                               (t2 (dk-rewrite-h! (dk-apply! ti2 a b na) (frm-add 'm a na) z)))
                          (dk-have! (list '<= (list '(DIST s1) z v) dl)
                                    (lambda () (subst t1) (ass)))
                          (dk-cite! 'id-fun-apply '(VEC m) z)
                          (dk-cite! 'id-fun-apply '(VEC m) v)
                          (let* ((r (dk-apply! bu v))
                                 (r1 (dk-rewrite-h! r (list id z) z))
                                 (r2 (dk-rewrite-h! r1 (list id v) v)))
                            #t)
                          (subst (dk-cite! 'id-fun-apply '(VEC m) a))
                          (subst (dk-cite! 'id-fun-apply '(VEC m) b))
                          (subst (list '= (caddr t2) (cadr t2)))
                          (ass)))))
                (dk-opened (lambda () (di)))))))
       (frm-goal-leaves-shallow!)))))
(qed 'frm-ti-uniform)

;;; Prop. 8.24 (b) for the seminorm family: any translation-invariant metric t on
;;; VEC m whose convergent sequences are those of the family (the book's condition
;;; (a), sequentially) is uniformly equivalent to FR-METRIC-SPACE(m, fam).
(sp (make-wff (frm-fstmt
  (list 'FORALL 't (list 'IMPLIES '(IS-METRIC-SPACE t) (list 'IMPLIES '(== (PTS t) (VEC m))
    (list 'IMPLIES (frm-ti 't)
      (list 'IMPLIES (forall-guarded '(seq lim) '((IN seq (FUN NN (VEC m))) (IN lim (VEC m)))
                       '(IFF (CONVERGES-TO t seq lim) (FR-CONV m fam seq lim)))
        (list 'AND (list 'IS-UNIFORMLY-CONTINUOUS frm-fms 't '(ID-FUN (VEC m)))
                   (list 'IS-UNIFORMLY-CONTINUOUS 't frm-fms '(ID-FUN (VEC m))))))))))))
(dk-peel!)
(dk-cite! 'frm-fam-module 'fld 'm 'fam)
(dk-cite! 'frm-metric-space-is-metric-space 'fld 'm 'fam)
(dk-cite! 'frm-metric-space-pts 'fld 'm 'fam)
(dk-cite! 'frm-metric-translation-invariant 'fld 'm 'fam)
(dk-cite! 'module-vzero-in 'm)
(let ((ifft (frm-pick-forall-with 'IFF "the convergence hypothesis"))
      (z '(VZERO m)))
  (dk-have! (frm-c12 frm-fms 't)
    (lambda ()
      (let ((sq (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-contains? f 'FUN))) (dk-peel!)))))
        (dk-cite! 'frm-conv-of-converges 'fld 'm 'fam sq z)
        (let ((iff (dk-apply! ifft sq z)))
          (ai iff)
          (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
          (ass)))))
  (dk-have! (frm-c12 't frm-fms)
    (lambda ()
      (let ((sq (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-contains? f 'FUN))) (dk-peel!)))))
        (let ((iff (dk-apply! ifft sq z)))
          (ai iff)
          (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
          (dk-cite! 'frm-converges-of-conv 'fld 'm 'fam sq z)
          (ass)))))
  (dk-cite! 'frm-ti-uniform 'm frm-fms 't)
  (dk-cite! 'frm-ti-uniform 'm 't frm-fms)
  (dk-close-all! (lambda () (di))))
(qed 'frm-metrics-uniformly-equivalent)


;;; =====================================================================
;;; (12) THE SHARED FIELD (TVS-1R, 2026-10-10): projections that read the field
;;;      parameter, and the scalar-action laws 8.25 (i) needs.
;;; =====================================================================

(frm-project! 'frm-sn-homog '(IS-SEMINORM fld m p) 'is-seminorm
  (frm-snstmt (forall-guarded 'lam '(IN lam (CARR (SCAL m)))
                (forall-guarded 'x '(IN x (VEC m))
                  '(= (p ((ACT m) lam x)) (* ((FNRM fld) lam) (p x)))))))
(frm-project! 'frm-fam-field '(IS-SEMINORM-FAMILY fld m fam) 'is-seminorm-family
  (frm-fstmt '(IS-NORMED-FIELD fld)))
(frm-project! 'frm-fam-scal '(IS-SEMINORM-FAMILY fld m fam) 'is-seminorm-family
  (frm-fstmt '(= (SCAL m) (NORMED-FIELD-AS-COMMUTATIVE-RING fld))))

(define (frm-act m r v) (list (list 'ACT m) r v))
(define (frm-mstmt vars guards body)
  (list 'FORALL 'm (list 'IMPLIES '(IS-MODULE m) (forall-guarded vars guards body))))

;;; r.(-x) = -(r.x)
(sp (make-wff (frm-mstmt '(r x) '((IN r (CARR (SCAL m))) (IN x (VEC m)))
  (list '= (frm-act 'm 'r (frm-neg 'm 'x)) (frm-neg 'm (frm-act 'm 'r 'x))))))
(dk-peel!)
(let* ((nx (frm-neg 'm 'x)) (ax (frm-act 'm 'r 'x)) (anx (frm-act 'm 'r nx)))
  (frm-vec! 'm nx)
  (dk-cite! 'module-act-type 'm 'r 'x)
  (dk-cite! 'module-act-type 'm 'r nx)
  (let* ((e1 (dk-cite! 'module-act-distrib-vec 'm 'r 'x nx))
         (e2 (dk-cite! 'frm-v-right-inv 'm 'x))
         (e3 (dk-cite! 'module-act-zero-vec 'm 'r)))
    (dk-have! (list '= (frm-add 'm ax anx) '(VZERO m))
      (lambda ()
        (subst (list '= (frm-add 'm ax anx) (frm-act 'm 'r (frm-add 'm 'x nx))))
        (subst e2)
        (ass)))
    (dk-cite! 'abelian-group-inverse-unique-module-vector-ag 'm ax anx)
    (ass)))
(qed 'frm-act-neg-vec)

;;; (-r).x = -(r.x)
(sp (make-wff (frm-mstmt '(r x) '((IN r (CARR (SCAL m))) (IN x (VEC m)))
  (list '= (frm-act 'm '((NEG (SCAL m)) r) 'x) (frm-neg 'm (frm-act 'm 'r 'x))))))
(dk-peel!)
(let* ((nr '((NEG (SCAL m)) r)) (ax (frm-act 'm 'r 'x)) (anx (frm-act 'm nr 'x)))
  (dk-cite! 'module-scalar-ring 'm)
  (dk-cite! 'ring-neg-in-carr '(SCAL m) 'r)
  (dk-cite! 'module-act-type 'm 'r 'x)
  (dk-cite! 'module-act-type 'm nr 'x)
  (let* ((e1 (dk-cite! 'module-act-distrib-scalar 'm 'r nr 'x))
         (e2 (dk-cite! 'ring-add-right-inv '(SCAL m) 'r))
         (e3 (dk-cite! 'module-zero-act 'm 'x)))
