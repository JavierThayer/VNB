        (for-each
         (lambda (leaf)
           (dk-focus! leaf)
           (if (dk-head-is? (dk-goal) 'IN)
               (ass)
               (let* ((ls (dk-peel!))
                      (_ (frm-split-landed! ls))
                      (i (cadr (cadr (cadr (cadr (dk-goal))))))     ; p_k(S(i) - sl.x) < e
                      (r (list 'ss i)) (xi (list 'sx i))
