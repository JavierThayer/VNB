(for-each (lambda (p)
            (sipw-read-off! (symbol-append 'cips-rsip- (car p)) 'CIPS-RSIP (car p) (cadr p))
            (sipw-read-off! (symbol-append 'cips-real- (car p)) 'CIPS-REAL (car p) (cadr p)))
          sipw-rsip-vals)
(sipw-read-off! 'cips-real-jop 'CIPS-REAL 'JOP '(CIPS-J w))

;;; ---- the drive of a conjunct of the real structure -----------------------------------------
(define sipw-props '(IS-REAL-LINEAR-OP IS-SQUARE-MINUS-ID IS-ANTISYMMETRIC-OP))   ; unfolded by the opener
(define (sipw-readoffs! fn)
  (for-each (lambda (p)
              (let ((e (dk-cite! (symbol-append (if (eq? fn 'CIPS-RSIP) 'cips-rsip- 'cips-real-) (car p)) 'w)))
                (if (dk--occurs? (cadr e) (dk-goal)) (subst (list '= (cadr e) (caddr e))))))
            (append sipw-rsip-vals (if (eq? fn 'CIPS-REAL) '((JOP (CIPS-J w))) '()))))
(define (sipw-law-open! fn)
  (di) (di)
  (fact 'rr-is-normed-field)
  (fact 'normed-field-as-commutative-ring-is-commutative-ring 'RR-NORMED-FIELD)
  (fact 'commutative-ring-is-ring sipb-rr-ring)
  (fact 'cc-i-in)
  (fact 'cips-scal-carrier 'w)
  (sipw-readoffs! fn)
  (if (and (pair? (dk-goal)) (memq (car (dk-goal)) sipw-props))
      (begin (mac (car (dk-goal))) (sipw-readoffs! fn)))
  (for-each (lambda (m) (if (dk--occurs? (list (car m) sipb-rr-ring) (dk-goal)) (mac (cadr m))))
            '((CARR rr-scalar-ring-carr) (ONE rr-scalar-ring-one))))
;;; after the peel: type what the betas will owe, rewrite the ring operations, unfold, beta
(define (sipw-pretype! lk)
  (let ((vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC w)))) lk)))
        (ss (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) lk))))
    (dk-have! '(IN 1 RR) (lambda () (arith)))
    (if (not (dk-asm? '(IN 1 CC))) (fact 'cc-one-in))
    (for-each sipw-cc! ss)
    (for-each (lambda (r) (for-each (lambda (s) (dk-real! (list '+ r s)) (dk-real! (list '* r s))
                                       (sipw-cc! (list '+ r s)) (sipw-cc! (list '* r s))) ss)) ss)
    (for-each (lambda (x) (for-each (lambda (y) (dk-cite! 'module-vadd-type-complex-inner-product-space-as-module 'w x y)) vs)) vs)
    (for-each (lambda (x)
                (for-each (lambda (s) (dk-cite! 'cips-act-type 'w s x))
                          (cons '+i (cons 1 (append ss (append-map (lambda (r) (append-map (lambda (s) (list (list '+ r s) (list '* r s))) ss)) ss))))))
              vs)
    (for-each (lambda (x) (for-each (lambda (s) (dk-cite! 'cips-act-type 'w s (list '(ACT w) '+i x))) (cons '+i ss))) vs)
    (cons ss vs)))
(define (sipw-reduce!)
  (let loop ((fuel 6))
    (let* ((g (dk-goal))
           (ra (let find ((e g)) (cond ((not (pair? e)) #f)
                                       ((and (equal? (car e) (list 'ADD sipb-rr-ring)) (= (length e) 3)) e)
                                       ((and (equal? (car e) (list 'MUL sipb-rr-ring)) (= (length e) 3)) e)
                                       (#t (or (find (car e)) (find (cdr e))))))))
      (if (and ra (> fuel 0))
          (begin (subst (dk-cite! (if (equal? (car ra) (list 'ADD sipb-rr-ring)) 'sip-rr-ring-add-value 'sip-rr-ring-mul-value)
                                  (cadr ra) (caddr ra)))
                 (loop (- fuel 1))))))
  ;; unfold a map only where it is APPLIED (a typing conjunct names it bare), then beta.
  ;; The walks go over the ELEMENTS of each application, never down list tails (a tail's
  ;; car is an argument, not an operator).
  (let* ((app-of? (lambda (pred)
                    (lambda (e) (let walk ((e e))
                                  (and (pair? e) (list? e)
                                       (or (pred (car e)) (any-pred walk e)))))))
         (applied? (lambda (f) ((app-of? (lambda (h) (equal? h (list f 'w)))) (dk-goal)))))
    (for-each (lambda (f) (if (applied? f) (mac f))) '(CIPS-RACT CIPS-RIP CIPS-J))
    (if ((app-of? (lambda (h) (and (pair? h) (eq? (car h) 'VNB-LAMBDA)))) (dk-goal))
        (dk-lam-b!))))
;;; cite LEMMA at every ordering of the scalars, then of the vectors, until the goal is in context
(define (sipw-cite-close! lemmas)
  (lambda (sv)
    (let ((ss (car sv)) (vs (cdr sv)))
      (let try ((ls lemmas))
        (cond ((sequent-node-grounded? (proof-state-focus *ps*)) #t)
              ((dk-asm? (dk-goal)) (ass))
              ((null? ls) (error "sipw-cite-close!: no citation gives the goal" (expression->string (dk-goal))))
              (#t (for-each (lambda (ps) (for-each (lambda (pv)
                                                     (if (not (dk-asm? (dk-goal)))
                                                         (vnb-guard (lambda () (apply fact (car ls) 'w (append ps pv))))))
                                                   (sipb-perms vs)))
                            (sipb-perms ss))
                  (try (cdr ls))))))))
(define (sipw-law! name fn str closer)
  (sp str)
  (sipw-law-open! fn)
  (dk-conj-close!
    (lambda ()
      (let* ((g (dk-goal))
             (sv (if (dk-head-is? g 'FORALL) (sipw-pretype! (dk-peel!)) (cons '() '()))))
        (sipw-reduce!)
        (closer sv))))
  (sipb-qed! name))
(define (sipw-stmt body) (string-append "forall([w], is-complex-inner-product-space(w) implies " body ")"))
(define (sipw-ass-of! . lemmas)            ; cite each (lemma args...) at w, then ass
  (lambda (sv) (for-each (lambda (l) (apply fact (car l) 'w (cdr l))) lemmas) (ass)))

