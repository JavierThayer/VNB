(sipb-ci-law! 'csip-cips-ip-definite
  (sipb-ci-stmt "forall([x_ in vec(csip-cips(v))], (ip(csip-cips(v))(x_, x_) = 0) iff (x_ = vzero(csip-cips(v))))")
