;;; ==========================================================================================
;;; J DESCENDS: the quotient of a complex semi-inner-product space by its null vectors is a
;;; complex pre-Hilbert space.  V = CSIP-AS-SIP(v), S = SIP-SETOID(V), Q = QUOTIENT(S),
;;; CQ = CSIP-QUOTIENT(v).  J respects the congruence because it is linear and ISOMETRIC:
;;; J x - J y = J(x - y) and <J d, J d> = <d, d>.
;;; ==========================================================================================
(define sipk-V '(CSIP-AS-SIP v))
(define sipk-S '(SIP-SETOID (CSIP-AS-SIP v)))
(define sipk-Q '(QUOTIENT (SIP-SETOID (CSIP-AS-SIP v))))
(define sipk-CQ '(CSIP-QUOTIENT v))
(define sipk-Q7 '(SIP-QUOTIENT (CSIP-AS-SIP v)))
(define (sipk-cl t) (list 'CLASS sipk-S t))
(define (sipk-d a b) (list '(VADD v) a (list '(VNEG v) b)))
(define (sipk-nul t) (list '= (list '(RIP v) t t) 0))
(define sipk-lj '(VNB-LAMBDA sqa_ (VEC v) (CLASS (SIP-SETOID (CSIP-AS-SIP v)) ((JOP v) sqa_))))

;;; Proposition 1.24 (2) for the structure: J is isometric
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
    (= ((RIP v) ((JOP v) x_) ((JOP v) y_)) ((RIP v) x_ y_))))))))))
(dk-peel!)
(sipc-pin!)
(let ((jx '((JOP v) x_)) (jy '((JOP v) y_)))
  (sipc-vt (list '(JOP v) jx)) (sipc-vt jy) (sipc-vt '((VNEG v) x_))
  (fact 'csip-jop-antisym 'v jx 'y_)
  (fact 'csip-jop-sq 'v 'x_)
  (fact 'sip-rip-neg-left-csip-as-sip 'v 'x_ 'y_)
  (for-each (lambda (p) (sipc-ft (car p) (cdr p)))
            (list (cons jx jy) (cons (list '(JOP v) jx) 'y_) (cons 'x_ 'y_) (cons '((VNEG v) x_) 'y_)))
  (let ((e (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) (list '(RIP v) (list '(JOP v) jx) 'y_)))) "antisymmetry")))
    (dk-rewrite-h! e (list '(JOP v) jx) '((VNEG v) x_)))
  (dk-ineq! (list '= (list '(RIP v) '((VNEG v) x_) 'y_) (list '- (list '(RIP v) jx jy)))
            (list '= (list '(RIP v) '((VNEG v) x_) 'y_) '(- ((RIP v) x_ y_)))
            (list 'IN (list '(RIP v) jx jy) 'RR) '(IN ((RIP v) x_ y_) RR) (list 'IN (list '(RIP v) '((VNEG v) x_) 'y_) 'RR)))
(sipb-qed! 'csip-jop-isometric)

;;; J(x - y) = Jx - Jy
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
    (= ((JOP v) ((VADD v) x_ ((VNEG v) y_))) ((VADD v) ((JOP v) x_) ((VNEG v) ((JOP v) y_))))))))))))
(dk-peel!)
(sipc-pin!)
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-real! '(- 1))
(sipc-vt '((VNEG v) y_)) (sipc-vt '((JOP v) y_))
(fact 'csip-jop-add 'v 'x_ '((VNEG v) y_))
(fact 'sip-act-neg-scalar-csip-as-sip 'v 1 'y_)
(fact 'sip-act-neg-scalar-csip-as-sip 'v 1 '((JOP v) y_))
(fact 'hbs-act-one-sip-as-module-csip-as-sip 'v 'y_)
(fact 'hbs-act-one-sip-as-module-csip-as-sip 'v '((JOP v) y_))
(fact 'csip-jop-act 'v '(- 1) 'y_)
(subst '(= ((JOP v) ((VADD v) x_ ((VNEG v) y_))) ((VADD v) ((JOP v) x_) ((JOP v) ((VNEG v) y_)))))
(dk-have! '(= ((VNEG v) y_) ((ACT v) (- 1) y_))
  (lambda () (subst '(= ((ACT v) (- 1) y_) ((VNEG v) ((ACT v) 1 y_)))) (subst '(= ((ACT v) 1 y_) y_)) (rfl)))
(dk-have! '(= ((VNEG v) ((JOP v) y_)) ((ACT v) (- 1) ((JOP v) y_)))
  (lambda () (subst '(= ((ACT v) (- 1) ((JOP v) y_)) ((VNEG v) ((ACT v) 1 ((JOP v) y_))))) (subst '(= ((ACT v) 1 ((JOP v) y_)) ((JOP v) y_))) (rfl)))
(subst '(= ((VNEG v) y_) ((ACT v) (- 1) y_)))
(subst '(= ((VNEG v) ((JOP v) y_)) ((ACT v) (- 1) ((JOP v) y_))))
(subst '(= ((JOP v) ((ACT v) (- 1) y_)) ((ACT v) (- 1) ((JOP v) y_))))
(sipc-vt '((VADD v) ((JOP v) x_) ((ACT v) (- 1) ((JOP v) y_))))
(if (not (proof-done? *ps*)) (rfl))
(sipb-qed! 'csip-jop-sub)

;;; ---- the descended J -------------------------------------------------------------------------
(define (sipk-setup!)
  (sipc-pin!)
  (fact 'sip-setoid-is-setoid-csip-as-sip 'v)
  (fact 'sip-setoid-pts-csip-as-sip 'v)
  (fact 'sip-vec-set-csip-as-sip 'v))
(define (sipk-pts! t)
  (sipc-vt t)
  (dk-have! (list 'IN t (list 'PTS sipk-S)) (lambda () (subst (list '= (list 'PTS sipk-S) '(VEC v))) (ass))))
(define (sipk-clq! t) (sipk-pts! t) (dk-cite! 'class-in-quotient sipk-S t))

(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (list 'IN sipk-lj (list 'FUN (list 'PTS sipk-S) sipk-Q))))))
(dk-peel!)
(sipk-setup!)
(subst (list '= (list 'PTS sipk-S) '(VEC v)))
(dk-lam-type! (lambda () (dk-peel!) (sipk-clq! (caddr (cadr (dk-goal)))) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))
(sipb-qed! 'csip-qj-lam-fun)

(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v) (list 'RESPECTS sipk-S sipk-lj)))))
(dk-peel!)
(sipk-setup!)
(mac 'respects-unfold)
(subst (list '= (list 'PTS sipk-S) '(VEC v)))
(let ((lk (dk-peel!)))
  (dk-split-all! lk)
  (let* ((g (dk-goal)) (x (cadr (cadr g))) (u (cadr (caddr g))))
    (fact 'sip-related-out-csip-as-sip 'v x u)
    (dk-lam-b!)
    (let ((jx (list '(JOP v) x)) (ju (list '(JOP v) u)))
      (sipc-vt (sipk-d x u)) (sipc-vt jx) (sipc-vt ju)
      (fact 'csip-jop-isometric 'v (sipk-d x u) (sipk-d x u))
      (fact 'csip-jop-sub 'v x u)
      (dk-have! (sipk-nul (sipk-d jx ju))
        (lambda ()
          (subst (list '= (sipk-d jx ju) (list '(JOP v) (sipk-d x u))))
          (subst (list '= (list '(RIP v) (list '(JOP v) (sipk-d x u)) (list '(JOP v) (sipk-d x u))) (list '(RIP v) (sipk-d x u) (sipk-d x u))))
          (ass)))
      (let ((iff (dk-cite! 'sip-class-eq-iff-csip-as-sip 'v jx ju)))
        (dk-only! iff (sipk-nul (sipk-d jx ju)))
        (prop)))))
(sipb-qed! 'csip-qj-respects)

(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (list 'FORALL 'a_ (list 'IMPLIES '(IN a_ (VEC v))
    (list '= (list '(CSIP-QJ v) (sipk-cl 'a_)) (sipk-cl '((JOP v) a_)))))))))
(dk-peel!)
(sipk-setup!)
(sipk-pts! 'a_)
(fact 'csip-qj-lam-fun 'v)
(fact 'csip-qj-respects 'v)
(dk-have! (list 'AND (list 'IN sipk-lj (list 'FUN (list 'PTS sipk-S) sipk-Q)) (list 'RESPECTS sipk-S sipk-lj)))
(mac 'CSIP-QJ)
(let ((e (dk-fact! 'descend-computes sipk-S sipk-Q sipk-lj 'a_)))
  (dk-lam-b-h! e))
(ass)
(sipb-qed! 'csip-qj-computes)

(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (list 'IN '(CSIP-QJ v) (list 'FUN sipk-Q sipk-Q))))))
(dk-peel!)
(sipk-setup!)
(fact 'csip-qj-lam-fun 'v)
(fact 'csip-qj-respects 'v)
(dk-have! (list 'AND (list 'IN sipk-lj (list 'FUN (list 'PTS sipk-S) sipk-Q)) (list 'RESPECTS sipk-S sipk-lj)))
(mac 'CSIP-QJ)
(fact 'descend-in-fun sipk-S sipk-Q sipk-lj)
(ass)
(sipb-qed! 'csip-qj-fun)

;;; ---- the read-offs of CQ, and its operations on classes --------------------------------------
(define (sipk-read-off! name acc val)
  (sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
                  (list '== (list acc sipk-CQ) val)))))
  (di) (di)
  (slot acc)
  (mac 'CSIP-QUOTIENT)
  (nth-r)
  (if (and (not (proof-done? *ps*)) (sipb-has-head? acc (dk-goal))) (slot acc))
  (if (not (proof-done? *ps*)) (qrfl))
  (sipb-qed! name))
(define sipk-vals
  (list '(SCAL (SCAL v)) (list 'VEC sipk-Q) (list 'VADD (list 'SIP-QVADD sipk-V)) (list 'VZERO (sipk-cl '(VZERO v)))
        (list 'VNEG (list 'SIP-QVNEG sipk-V)) (list 'ACT (list 'SIP-QACT sipk-V)) (list 'RIP (list 'SIP-QRIP sipk-V))
        '(JOP (CSIP-QJ v))))
(for-each (lambda (p) (sipk-read-off! (symbol-append 'csip-quotient- (car p)) (car p) (cadr p))) sipk-vals)

;;; CQ's operations on classes: the companion computation of the real quotient, read across
(define (sipk-computes! name stmt-tail comp acc)
  (sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v) stmt-tail))))
  (let* ((lk (dk-peel!)))
    (sipk-setup!)
    (fact (symbol-append 'csip-quotient- acc) 'v)
    (if (not (eq? acc 'JOP)) (fact (symbol-append 'sipq- (symbol-append (case acc ((VADD) 'vadd) ((VNEG) 'vneg) ((ACT) 'act) ((RIP) 'rip)) '-csip-as-sip)) 'v))
    (let* ((g (dk-goal)) (val (cadr (assq acc sipk-vals))))
      (subst (list '= (list acc sipk-CQ) val))
      (if (not (eq? acc 'JOP)) (subst (list '= val (list acc sipk-Q7))))
      (apply fact comp 'v (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (reverse lk))))
      (ass)))
  (sipb-qed! name))
(sipk-computes! 'csip-quotient-vadd-computes
  (forall-guarded '(a_ b_) '((IN a_ (VEC v)) (IN b_ (VEC v)))
    (list '= (list (list 'VADD sipk-CQ) (sipk-cl 'a_) (sipk-cl 'b_)) (sipk-cl '((VADD v) a_ b_))))
  'sipq-vadd-computes-csip-as-sip 'VADD)
(sipk-computes! 'csip-quotient-vneg-computes
  (forall-guarded '(a_) '((IN a_ (VEC v)))
    (list '= (list (list 'VNEG sipk-CQ) (sipk-cl 'a_)) (sipk-cl '((VNEG v) a_))))
  'sipq-vneg-computes-csip-as-sip 'VNEG)
(sipk-computes! 'csip-quotient-act-computes
  (forall-guarded '(r_ a_) '((IN r_ RR) (IN a_ (VEC v)))
    (list '= (list (list 'ACT sipk-CQ) 'r_ (sipk-cl 'a_)) (sipk-cl '((ACT v) r_ a_))))
  'sipq-act-computes-csip-as-sip 'ACT)
(sipk-computes! 'csip-quotient-rip-computes
  (forall-guarded '(a_ b_) '((IN a_ (VEC v)) (IN b_ (VEC v)))
    (list '= (list (list 'RIP sipk-CQ) (sipk-cl 'a_) (sipk-cl 'b_)) '((RIP v) a_ b_)))
  'sipq-rip-computes-csip-as-sip 'RIP)
(sipk-computes! 'csip-quotient-jop-computes
  (forall-guarded '(a_) '((IN a_ (VEC v)))
    (list '= (list (list 'JOP sipk-CQ) (sipk-cl 'a_)) (sipk-cl '((JOP v) a_))))
  'csip-qj-computes 'JOP)

;;; ---- the drive of a conjunct of CQ ------------------------------------------------------------
(define sipk-q7-readoffs '(sipq-scal-csip-as-sip sipq-vec-csip-as-sip sipq-vadd-csip-as-sip sipq-vzero-csip-as-sip
                           sipq-vneg-csip-as-sip sipq-act-csip-as-sip sipq-rip-csip-as-sip))
(define (sipk-open!)
  (di) (di)
  (sipk-setup!)
  (fact 'sip-scal-carr-csip-as-sip 'v)
  (fact 'sip-scal-ring-csip-as-sip 'v)
  (for-each (lambda (p) (fact (symbol-append 'csip-quotient- (car p)) 'v)) sipk-vals)
  ;; before unfolding a property of J, CQ's accessors are TYPED in context (META-10: the
  ;; unfolding owes t = t for a matched value the context does not certify)
  (if (and (pair? (dk-goal)) (memq (car (dk-goal)) sipw-props))
      (begin
        (for-each (lambda (n) (fact n 'v))
                  '(csip-quotient-scal-ring csip-quotient-vec-set csip-quotient-vadd-fun csip-quotient-vzero-in
                    csip-quotient-vneg-fun csip-quotient-act-fun csip-quotient-rip-fun csip-quotient-jop-fun))
        (mac (car (dk-goal))))))
(define (sipk-subst-readoffs!)          ; every accessor of CQ in the goal to its value
  (for-each (lambda (p) (if (dk--occurs? (list (car p) sipk-CQ) (dk-goal)) (subst (list '= (list (car p) sipk-CQ) (cadr p)))))
            sipk-vals))
;;; a typing conjunct: the companion typing of the real quotient, read across
(define (sipk-via-q7! comp)
  (lambda ()
    (sipk-subst-readoffs!)
    (let ((h (dk-cite! comp 'v)))
      (let loop ((h h) (ns sipk-q7-readoffs))
        (if (null? ns) (ass)
            (let* ((e (dk-cite! (car ns) 'v)))
              (loop (if (dk--occurs? (cadr e) h) (dk-rewrite-h! h (cadr e) (caddr e)) h) (cdr ns))))))))
(define (sipk-lift-var! u)
  (dk-have! (list 'IN u sipk-Q) (lambda () (subst (list '= sipk-Q (list 'VEC sipk-CQ))) (ass)))
  (let* ((ex (dk-cite! 'quotient-rep sipk-S u))
         (a  (dk-skolem! ex)))
    (dk-have! (list 'IN a '(VEC v)) (lambda () (subst (list '= '(VEC v) (list 'PTS sipk-S))) (ass)))
    (subst (list '= u (sipk-cl a)))
    a))
(define (sipk-class? e) (and (pair? e) (eq? (car e) 'CLASS) (equal? (cadr e) sipk-S)))
(define (sipk-redex e)
  (if (not (and (pair? e) (list? e)))
      #f
      (or (let loop ((xs e)) (cond ((null? xs) #f) ((sipk-redex (car xs))) (#t (loop (cdr xs)))))
          (let ((h (car e)))
            (cond ((and (equal? h (list 'VADD sipk-CQ)) (= (length e) 3) (sipk-class? (cadr e)) (sipk-class? (caddr e))) e)
                  ((and (equal? h (list 'RIP sipk-CQ)) (= (length e) 3) (sipk-class? (cadr e)) (sipk-class? (caddr e))) e)
                  ((and (equal? h (list 'VNEG sipk-CQ)) (= (length e) 2) (sipk-class? (cadr e))) e)
                  ((and (equal? h (list 'JOP sipk-CQ)) (= (length e) 2) (sipk-class? (cadr e))) e)
                  ((and (equal? h (list 'ACT sipk-CQ)) (= (length e) 3) (sipk-class? (caddr e))) e)
                  (#t #f))))))
(define (sipk-norm!)
  (if (dk--occurs? (list 'VZERO sipk-CQ) (dk-goal)) (subst (list '= (list 'VZERO sipk-CQ) (sipk-cl '(VZERO v)))))
  (let loop ((fuel 40))
    (let ((rx (sipk-redex (dk-goal))))
      (if (and rx (> fuel 0))
          (let* ((h (car (car rx)))
                 (eqn (case h
                        ((VADD) (sipc-vt (caddr (cadr rx))) (sipc-vt (caddr (caddr rx)))
                                (dk-cite! 'csip-quotient-vadd-computes 'v (caddr (cadr rx)) (caddr (caddr rx))))
                        ((RIP)  (sipc-vt (caddr (cadr rx))) (sipc-vt (caddr (caddr rx)))
                                (dk-cite! 'csip-quotient-rip-computes 'v (caddr (cadr rx)) (caddr (caddr rx))))
                        ((VNEG) (sipc-vt (caddr (cadr rx)))
                                (dk-cite! 'csip-quotient-vneg-computes 'v (caddr (cadr rx))))
                        ((JOP)  (sipc-vt (caddr (cadr rx)))
                                (dk-cite! 'csip-quotient-jop-computes 'v (caddr (cadr rx))))
                        ((ACT)  (sipc-vt (caddr (caddr rx)))
                                (dk-cite! 'csip-quotient-act-computes 'v (cadr rx) (caddr (caddr rx))))
                        (else (error "sipk-norm!: unexpected redex" rx)))))
            (subst eqn)
            (loop (- fuel 1)))))))
;;; a law leaf: lift, normalise, close by citing LEMMA at every ordering (class equations by a
;;; chain, real equations directly)
(define (sipk-law-leaf! lemma)
  (lambda ()
    (if (dk--occurs? (list 'VEC sipk-CQ) (dk-goal)) (subst (list '= (list 'VEC sipk-CQ) sipk-Q)))
    (let* ((lk (dk-peel!))
           (us (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) sipk-Q))) lk)))
           (rs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) lk)))
           (as (sipb-map! sipk-lift-var! us)))
      (sipk-norm!)
      (let ((leaf (proof-state-focus *ps*)) (g (dk-goal)))
        (for-each (lambda (pr) (for-each (lambda (pa) (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (apply fact lemma 'v (append pr pa))))))
                                          (sipb-perms as)))
                  (sipb-perms rs))
        (cond ((sequent-node-grounded? leaf) #t)
              ((dk-asm? g) (ass))
              ((and (dk-head-is? g '=) (sipk-class? (cadr g))) (sipb-close-class-eq!))
              (#t (error "sipk-law-leaf!: cannot close" (expression->string g))))))))
(define (sipk-law! name str closer)
  (sp str)
  (sipk-open!)
  (dk-conj-close! closer)
  (sipb-qed! name))
(define (sipk-stmt body) (string-append "forall([v], is-complex-semi-inner-product-space(v) implies " body ")"))

(sipk-law! 'csip-quotient-length (sipk-stmt "length(csip-quotient(v)) = 8")
  (lambda () (mac 'CSIP-QUOTIENT) (len-r) (if (not (proof-done? *ps*)) (arith))))
(sipk-law! 'csip-quotient-scal-ring (sipk-stmt "is-ring(scal(csip-quotient(v)))") (lambda () (sipk-subst-readoffs!) (ass)))
(sipk-law! 'csip-quotient-vec-set (sipk-stmt "vec(csip-quotient(v)) in set")
  (lambda () (sipk-subst-readoffs!) (fact 'quotient-is-set sipk-S) (ass)))
(sipk-law! 'csip-quotient-vadd-fun
  (sipk-stmt "vadd(csip-quotient(v)) in fun(cartesian(vec(csip-quotient(v)), vec(csip-quotient(v))), vec(csip-quotient(v)))")
  (sipk-via-q7! 'sipq-vadd-fun-csip-as-sip))
(sipk-law! 'csip-quotient-vzero-in (sipk-stmt "vzero(csip-quotient(v)) in vec(csip-quotient(v))")
  (sipk-via-q7! 'sipq-vzero-in-csip-as-sip))
(sipk-law! 'csip-quotient-vneg-fun (sipk-stmt "vneg(csip-quotient(v)) in fun(vec(csip-quotient(v)), vec(csip-quotient(v)))")
  (sipk-via-q7! 'sipq-vneg-fun-csip-as-sip))
(sipk-law! 'csip-quotient-act-fun
  (sipk-stmt "act(csip-quotient(v)) in fun(cartesian(carr(scal(csip-quotient(v))), vec(csip-quotient(v))), vec(csip-quotient(v)))")
  (sipk-via-q7! 'sipq-act-fun-csip-as-sip))
(sipk-law! 'csip-quotient-rip-fun
  (sipk-stmt "rip(csip-quotient(v)) in fun(cartesian(vec(csip-quotient(v)), vec(csip-quotient(v))), rr)")
  (sipk-via-q7! 'sipq-rip-fun-csip-as-sip))
(sipk-law! 'csip-quotient-jop-fun (sipk-stmt "jop(csip-quotient(v)) in fun(vec(csip-quotient(v)), vec(csip-quotient(v)))")
  (lambda () (sipk-subst-readoffs!) (fact 'csip-qj-fun 'v) (ass)))
(sipk-law! 'csip-quotient-sip
  (sipk-stmt "is-semi-inner-product-space([scal(csip-quotient(v)), vec(csip-quotient(v)), vadd(csip-quotient(v)), vzero(csip-quotient(v)), vneg(csip-quotient(v)), act(csip-quotient(v)), rip(csip-quotient(v))])")
  (lambda ()
    (sipk-subst-readoffs!)
    (let* ((p (dk-cite! 'sip-quotient-is-pre-hilbert-csip-as-sip 'v))
           (h (dk-cite! 'phs-is-sip sipk-Q7))
           (u (dk-cite! 'sipq-unfold-csip-as-sip 'v)))
      (dk-rewrite-h! h sipk-Q7 (caddr u))
      (ass))))
(sipk-law! 'csip-quotient-linear (sipk-stmt "is-real-linear-op(csip-quotient(v), jop(csip-quotient(v)))")
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IN)
        (begin (sipk-subst-readoffs!) (fact 'csip-qj-fun 'v) (ass))
        (let ((g (dk-goal)))
          ((sipk-law-leaf! (if (sipb-has-head? 'ACT g) 'csip-jop-act 'csip-jop-add)))))))
(sipk-law! 'csip-quotient-square (sipk-stmt "is-square-minus-id(csip-quotient(v), jop(csip-quotient(v)))")
  (sipk-law-leaf! 'csip-jop-sq))
(sipk-law! 'csip-quotient-antisym (sipk-stmt "is-antisymmetric-op(csip-quotient(v), jop(csip-quotient(v)))")
  (sipk-law-leaf! 'csip-jop-antisym))
(sipk-law! 'csip-quotient-definite
  (sipk-stmt "forall([x_ in vec(csip-quotient(v))], rip(csip-quotient(v))(x_, x_) = 0 implies x_ = vzero(csip-quotient(v)))")
  (lambda ()
    (subst (list '= (list 'VEC sipk-CQ) sipk-Q))
    (let* ((lk (dk-peel!))
           (u (cadr (any-pred (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) sipk-Q))) lk)))
           (h (any-pred (lambda (f) (dk-head-is? f '=)) lk))
           (a (sipk-lift-var! u))
           (h1 (dk-rewrite-h! h u (sipk-cl a)))
           (e (dk-cite! 'csip-quotient-rip-computes 'v a a))
           (h2 (dk-rewrite-h! h1 (cadr e) (caddr e))))
      (sipk-norm!)
      (sipc-vt (sipk-d a '(VZERO v)))
      (dk-cite! 'frm-v-sub-zero-sip-as-module-csip-as-sip 'v a)
      (dk-have! (sipk-nul (sipk-d a '(VZERO v))) (lambda () (subst (list '= (sipk-d a '(VZERO v)) a)) (ass)))
      (sipc-vt '(VZERO v))
      (let ((iff (dk-cite! 'sip-class-eq-iff-csip-as-sip 'v a '(VZERO v))))
        (dk-only! iff (sipk-nul (sipk-d a '(VZERO v))))
        (prop)))))

;;; J DESCENDS: the quotient of a complex semi-inner-product space is a complex pre-Hilbert space.
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v) (IS-COMPLEX-PRE-HILBERT-SPACE (CSIP-QUOTIENT v))))))
(dk-peel!)
(for-each (lambda (n) (fact n 'v))
  '(csip-quotient-length csip-quotient-scal-ring csip-quotient-vec-set csip-quotient-vadd-fun csip-quotient-vzero-in
    csip-quotient-vneg-fun csip-quotient-act-fun csip-quotient-rip-fun csip-quotient-jop-fun csip-quotient-sip
    csip-quotient-linear csip-quotient-square csip-quotient-antisym csip-quotient-definite))
(mac 'is-complex-pre-hilbert-space-def)
(mac 'IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE)
(dk-conj-close! (lambda () (ass)))
(sipb-qed! 'csip-quotient-is-cphs)
(alias! 'csip-quotient-is-cphs "the quotient of a complex semi-inner-product space is a complex pre-Hilbert space")

;;; ==========================================================================================
;;; PROPOSITION 1.23 (THE COMPLEX POLARIZATION IDENTITY) AND THE UNIQUENESS IN 1.25.
;;; ==========================================================================================
;;; cact(-1, x) = -x and cact(-i, x) = -(i.x)
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (= ((CACT v) -1 x_) ((VNEG v) x_))))))))
(dk-peel!)
(sipc-pin!)
(dk-have! '(IN -1 RR) (lambda () (arith)))
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-have! '(IN 0 RR) (lambda () (arith)))
(sipw-cc! -1)
(dk-have! '(= -1 (+ -1 (* 0 +i))) (lambda () (crs)))
(dk-split-all! (list (dk-cite! 'cc-re-im-of -1 -1 0)))
(fact 'csip-cact-value 'v -1 'x_)
(sipc-vt '((JOP v) x_))
(fact 'hbs-act-zero-sip-as-module-csip-as-sip 'v '((JOP v) x_))
(fact 'sip-act-neg-scalar-csip-as-sip 'v 1 'x_)
(fact 'hbs-act-one-sip-as-module-csip-as-sip 'v 'x_)
(dk-have! '(= -1 (- 1)) (lambda () (arith)))
(sipc-vt '((ACT v) -1 x_))
(fact 'hbs-vzero-r-sip-as-module-csip-as-sip 'v '((ACT v) -1 x_))
(subst (list '= '((CACT v) -1 x_) (sipc-nf '(real-part -1) '(imag-part -1) 'x_)))
(subst '(= (real-part -1) -1))
(subst '(= (imag-part -1) 0))
(subst '(= ((ACT v) 0 ((JOP v) x_)) (VZERO v)))
(subst '(= ((VADD v) ((ACT v) -1 x_) (VZERO v)) ((ACT v) -1 x_)))
(subst '(= -1 (- 1)))
(subst '(= ((ACT v) (- 1) x_) ((VNEG v) ((ACT v) 1 x_))))
(subst '(= ((ACT v) 1 x_) x_))
(if (not (proof-done? *ps*)) (rfl))
(sipb-qed! 'csip-cact-neg-one)

(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (= ((CACT v) (- +i) x_) ((VNEG v) ((CACT v) +i x_)))))))))
(dk-peel!)
(sipc-pin!)
(fact 'cc-i-in)
(dk-have! '(IN -1 RR) (lambda () (arith)))
(sipw-cc! -1)
(fact 'cc-neg-closed '+i)
(sipc-vt '((CACT v) +i x_))
(fact 'csip-cact-mul 'v -1 '+i 'x_)
(fact 'csip-cact-neg-one 'v '((CACT v) +i x_))
(dk-have! '(= (- +i) (* -1 +i)) (lambda () (crs)))
(subst '(= (- +i) (* -1 +i)))
(subst '(= ((CACT v) (* -1 +i) x_) ((CACT v) -1 ((CACT v) +i x_))))
(subst '(= ((CACT v) -1 ((CACT v) +i x_)) ((VNEG v) ((CACT v) +i x_))))
(if (not (proof-done? *ps*)) (rfl))
(sipb-qed! 'csip-cact-neg-i)

;;; ---- a sesquilinear form: its laws as citable universals ----------------------------------
(define (sipp-stmt body)                ; forall v sqf. CSIP(v) => sesquilinear(v, sqf) => BODY
  (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
    (list 'FORALL 'sqf (list 'IMPLIES '(IS-SESQUILINEAR-FORM v sqf) body)))))
(define sipp-laws '())                  ; the four conjuncts, CAPTURED WHEN THEY LAND
(define (sipp-open!)                    ; land the four conjuncts of the sesquilinearity hypothesis
  ;; on a LANE: `mac-h' consumes the hypothesis, and the lemmas cited later are guarded on it
  (let* ((h (dk-pick (lambda (f) (dk-head-is? f 'IS-SESQUILINEAR-FORM)) "sesquilinearity"))
         (body (caddr (dk-cite! 'IS-SESQUILINEAR-FORM 'v 'sqf))))
    (dk-have! body (lambda () (mac-h 'IS-SESQUILINEAR-FORM h) (ass)))
    (set! sipp-laws (dk-split-all! (list body)))))
(define (sipp-law pred what)            ; never a shape search of the context: a partial
  (or (any-pred (lambda (f) (and (dk-head-is? f 'FORALL) (pred f))) sipp-laws)   ; instance would match
      (error "sipp-law: no such conjunct" what)))
(define (sipp-add) (sipp-law (lambda (f) (sipb-has-head? 'VADD f)) "additivity"))
(define (sipp-hom) (sipp-law (lambda (f) (sipb-has-head? 'CACT f)) "homogeneity"))
(define (sipp-sym) (sipp-law (lambda (f) (sipb-has-head? 'conjugate f)) "conjugate symmetry"))

(sp (make-wff (sipp-stmt '(FORALL sx_ (IMPLIES (IN sx_ (VEC v)) (FORALL sy_ (IMPLIES (IN sy_ (VEC v)) (IN (sqf sx_ sy_) CC))))))))
(dk-peel!)
(sipp-open!)
(fact 'pair-in-cartesian '(VEC v) '(VEC v) 'sx_ 'sy_)
(fact 'fun-apply-type-c 'sqf '(CARTESIAN (VEC v) (VEC v)) 'CC '(LIST sx_ sy_))
(fact 'apply-tupling-2 'sqf 'sx_ 'sy_)
(subst '(= (sqf sx_ sy_) (sqf (LIST sx_ sy_))))
(ass)
(sipb-qed! 'ses-type)

;;; the three laws of the definition as citable theorems (citations tolerate an instance already
;;; in context, where instantiating an in-context universal twice lands nothing)
(define (sipp-proj! name conj)
  (sp (make-wff (sipp-stmt conj)))
  (di) (di) (di) (di)                   ; v, the structure, sqf, sesquilinearity -- the law stays
  (sipp-open!)
  (ass)
  (sipb-qed! name))
(sipp-proj! 'ses-add-left
  '(FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v)) (FORALL z_ (IMPLIES (IN z_ (VEC v))
     (= (sqf ((VADD v) x_ y_) z_) (+ (sqf x_ z_) (sqf y_ z_))))))))))
(sipp-proj! 'ses-homog-left
  '(FORALL a_ (IMPLIES (IN a_ CC) (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
     (= (sqf ((CACT v) a_ x_) y_) (* a_ (sqf x_ y_))))))))))
(sipp-proj! 'ses-conj-sym
  '(FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
     (= (sqf y_ x_) (conjugate (sqf x_ y_))))))))

(define (sipp-cc! t) (dk-cite! 'ses-type 'v 'sqf (cadr t) (caddr t)))     ; t = (sqf a b)
(sp (make-wff (sipp-stmt '(FORALL sx_ (IMPLIES (IN sx_ (VEC v)) (FORALL sy_ (IMPLIES (IN sy_ (VEC v)) (FORALL sz_ (IMPLIES (IN sz_ (VEC v))
  (= (sqf sx_ ((VADD v) sy_ sz_)) (+ (sqf sx_ sy_) (sqf sx_ sz_))))))))))))
(dk-peel!)
(sipp-open!)
(sipc-pin!)
(let ((yz '((VADD v) sy_ sz_)))
  (sipc-vt yz)
  (fact 'ses-conj-sym 'v 'sqf yz 'sx_)
  (fact 'ses-add-left 'v 'sqf 'sy_ 'sz_ 'sx_)
  (fact 'ses-conj-sym 'v 'sqf 'sy_ 'sx_)
  (fact 'ses-conj-sym 'v 'sqf 'sz_ 'sx_)
  (sipp-cc! '(sqf sy_ sx_)) (sipp-cc! '(sqf sz_ sx_))
  (dk-have! '(AND (IN (sqf sy_ sx_) CC) (IN (sqf sz_ sx_) CC)))
  (fact 'cc-conjugate-add '(sqf sy_ sx_) '(sqf sz_ sx_))
  (subst (list '= (list 'sqf 'sx_ yz) (list 'conjugate (list 'sqf yz 'sx_))))
  (subst (list '= (list 'sqf yz 'sx_) '(+ (sqf sy_ sx_) (sqf sz_ sx_))))
  (subst '(= (conjugate (+ (sqf sy_ sx_) (sqf sz_ sx_))) (+ (conjugate (sqf sy_ sx_)) (conjugate (sqf sz_ sx_)))))
  (subst '(= (sqf sx_ sy_) (conjugate (sqf sy_ sx_))))
  (subst '(= (sqf sx_ sz_) (conjugate (sqf sz_ sx_))))
  (fact 'cc-conjugate-closed '(sqf sy_ sx_))
  (fact 'cc-conjugate-closed '(sqf sz_ sx_))
  (if (not (proof-done? *ps*)) (rfl)))
(sipb-qed! 'ses-add-right)

(sp (make-wff (sipp-stmt '(FORALL sk_ (IMPLIES (IN sk_ CC) (FORALL sx_ (IMPLIES (IN sx_ (VEC v)) (FORALL sy_ (IMPLIES (IN sy_ (VEC v))
  (= (sqf sx_ ((CACT v) sk_ sy_)) (* (conjugate sk_) (sqf sx_ sy_))))))))))))
(dk-peel!)
(sipp-open!)
(sipc-pin!)
(let ((ay '((CACT v) sk_ sy_)))
  (sipc-vt ay)
  (fact 'ses-conj-sym 'v 'sqf ay 'sx_)
  (fact 'ses-homog-left 'v 'sqf 'sk_ 'sy_ 'sx_)
  (fact 'ses-conj-sym 'v 'sqf 'sy_ 'sx_)
  (sipp-cc! '(sqf sy_ sx_))
  (dk-have! '(AND (IN sk_ CC) (IN (sqf sy_ sx_) CC)))
  (fact 'cc-conjugate-mul 'sk_ '(sqf sy_ sx_))
  (subst (list '= (list 'sqf 'sx_ ay) (list 'conjugate (list 'sqf ay 'sx_))))
  (subst (list '= (list 'sqf ay 'sx_) '(* sk_ (sqf sy_ sx_))))
  (subst '(= (conjugate (* sk_ (sqf sy_ sx_))) (* (conjugate sk_) (conjugate (sqf sy_ sx_)))))
  (subst '(= (sqf sx_ sy_) (conjugate (sqf sy_ sx_))))
  (if (not (proof-done? *ps*)) (rfl)))
(sipb-qed! 'ses-homog-right)

;;; the expansion  B(x + c.y, x + c.y) = B(x,x) + conj(c) B(x,y) + c B(y,x) + c conj(c) B(y,y)
(sp (make-wff (sipp-stmt '(FORALL sc_ (IMPLIES (IN sc_ CC) (FORALL sx_ (IMPLIES (IN sx_ (VEC v)) (FORALL sy_ (IMPLIES (IN sy_ (VEC v))
  (= (sqf ((VADD v) sx_ ((CACT v) sc_ sy_)) ((VADD v) sx_ ((CACT v) sc_ sy_)))
     (+ (+ (+ (sqf sx_ sx_) (* (conjugate sc_) (sqf sx_ sy_))) (* sc_ (sqf sy_ sx_))) (* (* sc_ (conjugate sc_)) (sqf sy_ sy_)))))))))))))
(dk-peel!)
(sipp-open!)
(sipc-pin!)
(let* ((u '((CACT v) sc_ sy_)) (w (list '(VADD v) 'sx_ u)))
  (sipc-vt w)
  (fact 'ses-add-left 'v 'sqf 'sx_ u w)
  (fact 'ses-add-right 'v 'sqf 'sx_ 'sx_ u)
  (fact 'ses-add-right 'v 'sqf u 'sx_ u)
  (fact 'ses-homog-right 'v 'sqf 'sc_ 'sx_ 'sy_)
  (fact 'ses-homog-left 'v 'sqf 'sc_ 'sy_ 'sx_)
  (fact 'ses-homog-left 'v 'sqf 'sc_ 'sy_ u)
  (fact 'ses-homog-right 'v 'sqf 'sc_ 'sy_ 'sy_)
  (subst (list '= (list 'sqf w w) (list '+ (list 'sqf 'sx_ w) (list 'sqf u w))))
  (subst (list '= (list 'sqf 'sx_ w) (list '+ '(sqf sx_ sx_) (list 'sqf 'sx_ u))))
  (subst (list '= (list 'sqf u w) (list '+ (list 'sqf u 'sx_) (list 'sqf u u))))
  (subst (list '= (list 'sqf 'sx_ u) '(* (conjugate sc_) (sqf sx_ sy_))))
  (subst (list '= (list 'sqf u 'sx_) '(* sc_ (sqf sy_ sx_))))
  (subst (list '= (list 'sqf u u) (list '* 'sc_ (list 'sqf 'sy_ u))))
  (subst (list '= (list 'sqf 'sy_ u) '(* (conjugate sc_) (sqf sy_ sy_))))
  (for-each sipp-cc! '((sqf sx_ sx_) (sqf sx_ sy_) (sqf sy_ sx_) (sqf sy_ sy_)))
  (fact 'cc-conjugate-closed 'sc_)
  (crs))
(sipb-qed! 'ses-expand)

;;; PROPOSITION 1.23:  4 B(x,y) = B(x+y, x+y) - B(x-y, x-y) + i B(x+iy, x+iy) - i B(x-iy, x-iy)
(define sipp-iy '((CACT v) +i sy_))
(define sipp-p '((VADD v) sx_ sy_))
(define sipp-m '((VADD v) sx_ ((VNEG v) sy_)))
(define sipp-pi (list '(VADD v) 'sx_ sipp-iy))
(define sipp-mi (list '(VADD v) 'sx_ (list '(VNEG v) sipp-iy)))
(define (sipp-polar f)
  (list '- (list '+ (list '- (list f sipp-p sipp-p) (list f sipp-m sipp-m)) (list '* '+i (list f sipp-pi sipp-pi)))
           (list '* '+i (list f sipp-mi sipp-mi))))
(sp (make-wff (sipp-stmt (list 'FORALL 'sx_ (list 'IMPLIES '(IN sx_ (VEC v)) (list 'FORALL 'sy_ (list 'IMPLIES '(IN sy_ (VEC v))
  (list '= '(* 4 (sqf sx_ sy_)) (sipp-polar 'sqf)))))))))
(dk-peel!)
(sipp-open!)
(sipc-pin!)
(fact 'cc-i-in)
(fact 'cc-one-in)
(fact 'cc-neg-closed '+i)
(dk-have! '(IN -1 RR) (lambda () (arith)))
(dk-have! '(IN 1 RR) (lambda () (arith)))
(sipw-cc! -1)
(let* ((e1 (dk-cite! 'ses-expand 'v 'sqf 1 'sx_ 'sy_))
       (e2 (dk-cite! 'ses-expand 'v 'sqf -1 'sx_ 'sy_))
       (e3 (dk-cite! 'ses-expand 'v 'sqf '+i 'sx_ 'sy_))
       (e4 (dk-cite! 'ses-expand 'v 'sqf '(- +i) 'sx_ 'sy_)))
  (fact 'csip-cact-one 'v 'sy_)
  (fact 'csip-cact-neg-one 'v 'sy_)
  (fact 'csip-cact-neg-i 'v 'sy_)
  (let ((e1b (dk-rewrite-h! e1 '((CACT v) 1 sy_) 'sy_))
        (e2b (dk-rewrite-h! e2 '((CACT v) -1 sy_) '((VNEG v) sy_)))
        (e4b (dk-rewrite-h! e4 '((CACT v) (- +i) sy_) (list '(VNEG v) sipp-iy))))
    (subst (list '= (list 'sqf sipp-p sipp-p) (caddr e1b)))
    (subst (list '= (list 'sqf sipp-m sipp-m) (caddr e2b)))
    (subst (list '= (list 'sqf sipp-pi sipp-pi) (caddr e3)))
    (subst (list '= (list 'sqf sipp-mi sipp-mi) (caddr e4b)))))
(fact 'cc-conjugate-fixes-rr 1)
(fact 'cc-conjugate-fixes-rr -1)
(fact 'cc-conjugate-i)
(fact 'cc-conjugate-neg '+i)
(subst '(= (conjugate 1) 1))
(subst '(= (conjugate -1) -1))
(subst '(= (conjugate (- +i)) (- (conjugate +i))))
(subst '(= (conjugate +i) (- +i)))
(for-each sipp-cc! '((sqf sx_ sx_) (sqf sx_ sy_) (sqf sy_ sx_) (sqf sy_ sy_)))
(crs)
(sipb-qed! 'ses-polarization)
(alias! 'ses-polarization "the complex polarization identity (Proposition 1.23)")

;;; ---- the complex form (38) is sesquilinear ---------------------------------------------------
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v) (IS-SESQUILINEAR-FORM v (CRIP v))))))
(dk-peel!)
(for-each (lambda (n) (fact n 'v)) '(csip-crip-fun csip-crip-add-left csip-crip-homog-left csip-crip-conj-sym))
(mac 'IS-SESQUILINEAR-FORM)
(dk-conj-close! (lambda () (ass)))
(sipb-qed! 'csip-crip-sesquilinear)

;;; 4a = 4b => a = b in CC, through the real and imaginary parts
(sp (make-wff '(FORALL ca_ (IMPLIES (IN ca_ CC) (FORALL cb_ (IMPLIES (IN cb_ CC)
  (IMPLIES (= (* 4 ca_) (* 4 cb_)) (= ca_ cb_))))))))
(dk-peel!)
(let ((d '(- ca_ cb_)))
  (dk-have! (list 'IN d 'CC) (lambda () (type-term)))
  (dk-have! (list '= (list '* 4 d) 0)
    (lambda ()
      (dk-have! (list '= (list '* 4 d) '(- (* 4 ca_) (* 4 cb_))) (lambda () (crs)))
      (subst (list '= (list '* 4 d) '(- (* 4 ca_) (* 4 cb_))))
      (subst '(= (* 4 ca_) (* 4 cb_)))
      (dk-have! '(IN (* 4 cb_) CC) (lambda () (type-term)))
      (crs)))
  (dk-have! '(IN 4 RR) (lambda () (arith)))
  (dk-have! '(IN 0 RR) (lambda () (arith)))
  (fact 'cc-zero-in)
  (dk-cite! 'real-part-in-rr d) (dk-cite! 'imag-part-in-rr d)
  (let* ((re4 (dk-cite! 'cc-re-real-mul 4 d))
         (im4 (dk-cite! 'cc-im-real-mul 4 d))
         (z0  (dk-have! '(= 0 (+ 0 (* 0 +i))) (lambda () (crs))))
         (zz  (dk-split-all! (list (dk-cite! 'cc-re-im-of 0 0 0))))
         (re4b (dk-rewrite-h! re4 (list '* 4 d) 0))
         (im4b (dk-rewrite-h! im4 (list '* 4 d) 0)))
    (dk-have! (list '= (list 'real-part d) 0)
      (lambda () (dk-cite! 'real-part-in-rr 0)
                 (dk-ineq! re4b '(= (real-part 0) 0) (list 'IN (list 'real-part d) 'RR) '(IN (real-part 0) RR))))
    (dk-have! (list '= (list 'imag-part d) 0)
      (lambda () (dk-cite! 'imag-part-in-rr 0)
                 (dk-ineq! im4b '(= (imag-part 0) 0) (list 'IN (list 'imag-part d) 'RR) '(IN (imag-part 0) RR))))
    (let* ((dec (dk-cite! 'cc-re-im-decompose d))
           (d1 (dk-rewrite-h! dec (list 'real-part d) 0))
           (d2 (dk-rewrite-h! d1 (list 'imag-part d) 0)))
      (dk-have! (list '= d 0) (lambda () (subst (list '= d (caddr d2))) (crs)))
      (dk-have! '(= ca_ (+ (- ca_ cb_) cb_)) (lambda () (crs)))
      (subst '(= ca_ (+ (- ca_ cb_) cb_)))
      (subst (list '= d 0))
      (crs))))
(sipb-qed! 'cc-four-cancel)

;;; THE UNIQUENESS IN PROPOSITION 1.25 (semidefinite form): a sesquilinear form whose diagonal is
;;; the real form's is the complex form (38).  By polarization, both are fixed by the diagonal.
(sp (make-wff (sipp-stmt '(IMPLIES (FORALL ux_ (IMPLIES (IN ux_ (VEC v)) (= (sqf ux_ ux_) ((RIP v) ux_ ux_))))
  (FORALL sx_ (IMPLIES (IN sx_ (VEC v)) (FORALL sy_ (IMPLIES (IN sy_ (VEC v))
    (= (sqf sx_ sy_) ((CRIP v) sx_ sy_))))))))))
(di) (di) (di) (di)
(let ((diag (dk-landed-1 (lambda () (di)))))
  (dk-peel!)
  (sipc-pin!)
  (fact 'csip-crip-sesquilinear 'v)
  (fact 'cc-i-in)
  (let* ((e1 (dk-cite! 'ses-polarization 'v 'sqf 'sx_ 'sy_))
         (e2 (dk-cite! 'ses-polarization 'v '(CRIP v) 'sx_ 'sy_))
         (ws (list sipp-p sipp-m sipp-pi sipp-mi)))
    (for-each sipc-vt ws)
    (let loop ((ws ws) (f1 e1) (f2 e2))
      (if (null? ws)
          (begin
            (dk-have! '(= (* 4 (sqf sx_ sy_)) (* 4 ((CRIP v) sx_ sy_)))
              (lambda ()
                (subst (list '= '(* 4 (sqf sx_ sy_)) (caddr f1)))
                (subst (list '= '(* 4 ((CRIP v) sx_ sy_)) (caddr f2)))
                (for-each (lambda (w) (sipc-ft w w) (sipw-cc! (list '(RIP v) w w))) (list sipp-p sipp-m sipp-pi sipp-mi))
                (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (crs))))
            (fact 'ses-type 'v 'sqf 'sx_ 'sy_)
            (fact 'csip-crip-type-pt 'v 'sx_ 'sy_)
            (fact 'cc-four-cancel '(sqf sx_ sy_) '((CRIP v) sx_ sy_))
            (ass))
          (let* ((w (car ws))
                 (h (dk-apply! diag w))
                 (c (dk-cite! 'csip-crip-self 'v w)))
            (loop (cdr ws) (dk-rewrite-h! f1 (list 'sqf w w) (list '(RIP v) w w))
                           (dk-rewrite-h! f2 (list '(CRIP v) w w) (list '(RIP v) w w))))))))
(sipb-qed! 'csip-crip-unique)
(alias! 'csip-crip-unique "the complex form (38) is the unique sesquilinear form with the given diagonal (Proposition 1.25)")

;;; ==========================================================================================
;;; THE COMPLEXIFICATION: for a semi-inner-product space v, the pairs (x1, x2) with
;;; componentwise operations, the form <x1,y1> + <x2,y2> and J(x1, x2) = (-x2, x1) form a
;;; complex semi-inner-product space.  (Complex L^2 is the complexification of real L^2.)
;;; ==========================================================================================
(define sipx-C '(CARTESIAN (VEC v) (VEC v)))
(define (sipx-n1 x) (list 'NTH 1 x))
(define (sipx-n2 x) (list 'NTH 2 x))
(define (sipx-pin!) (fact 'sip-scal-pin 'v) (fact 'sip-scal-carr 'v))
(define (sipx-vt x)                     ; type a vector expression over the SIP v
  (let ((want (list 'IN x '(VEC v))))
    (cond ((dk-asm? want) x)
          ((equal? x '(VZERO v)) (dk-cite! 'module-vzero-in-sip-as-module 'v) x)
          ((and (pair? x) (equal? (car x) '(VADD v)))
           (sipx-vt (cadr x)) (sipx-vt (caddr x)) (dk-cite! 'module-vadd-type-sip-as-module 'v (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG v)))
           (sipx-vt (cadr x)) (dk-cite! 'module-vneg-type-sip-as-module 'v (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT v)))
           (sipx-vt (caddr x)) (dk-real! (cadr x)) (dk-cite! 'hbs-act-in-sip-as-module 'v (cadr x) (caddr x)) x)
          (#t (error "sipx-vt: cannot type" (expression->string x))))))
(define (sipx-ft x y) (sipx-vt x) (sipx-vt y) (dk-cite! 'sip-rip-type 'v x y))
(define (sipx-open-var! x)              ; x in C: its components typed, and x = [x1, x2]
  (if (not (and (dk-asm? (list 'IN (list 'NTH 1 x) '(VEC v))) (dk-asm? (list 'IN (list 'NTH 2 x) '(VEC v)))))
      (begin
        (dk-split-all! (list (dk-cite! 'cartesian-nth x '(VEC v) '(VEC v))))
        (dk-cite! 'cartesian-pair-eq x '(VEC v) '(VEC v)))))
(define (sipx-pair-in! p)               ; p = (LIST a b), a, b typable: (IN p C)
  (sipx-vt (cadr p)) (sipx-vt (caddr p))
  (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC v) (cadr p) (caddr p)))
(define (sipx-stmt vars typs body)      ; forall v. SIP(v) => forall vars typed => body
  (list 'FORALL 'v (list 'IMPLIES '(IS-SEMI-INNER-PRODUCT-SPACE v) (forall-guarded vars typs body))))

;;; ---- the values of the operations on pairs ----------------------------------------------
(define (sipx-value! name stmt fn)
  (sp (make-wff stmt))
  (dk-peel!)
  (sipx-pin!)
  (fact 'sip-vec-set 'v)
  (for-each (lambda (f) (if (and (dk-head-is? f 'IN) (equal? (caddr f) sipx-C)) (sipx-open-var! (cadr f)))) (dk-asms))
  (let ((r (caddr (dk-goal))))
    (if (and (pair? r) (eq? (car r) 'LIST)) (begin (sipx-vt (cadr r)) (sipx-vt (caddr r)) (sipx-pair-in! r)))
    (if (and (pair? r) (eq? (car r) '+)) (begin (sipx-ft (cadr (cadr r)) (caddr (cadr r))) (sipx-ft (cadr (caddr r)) (caddr (caddr r))) (dk-real! r))))
  (if (dk-asm? '(IN rx_ RR)) (dk-have! '(IN rx_ (CARR (SCAL v))) (lambda () (subst '(= (CARR (SCAL v)) RR)) (ass))))
  (mac fn)
  (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl)))
  (sipb-qed! name))
(sipx-value! 'cx-vadd-value
  (sipx-stmt '(px_ qx_) (list (list 'IN 'px_ sipx-C) (list 'IN 'qx_ sipx-C))
    (list '= '((CX-VADD v) px_ qx_)
          (list 'LIST (list '(VADD v) (sipx-n1 'px_) (sipx-n1 'qx_)) (list '(VADD v) (sipx-n2 'px_) (sipx-n2 'qx_)))))
  'CX-VADD)
(sipx-value! 'cx-vneg-value
  (sipx-stmt '(px_) (list (list 'IN 'px_ sipx-C))
    (list '= '((CX-VNEG v) px_) (list 'LIST (list '(VNEG v) (sipx-n1 'px_)) (list '(VNEG v) (sipx-n2 'px_)))))
  'CX-VNEG)
(sipx-value! 'cx-act-value
  (sipx-stmt '(rx_ px_) (list '(IN rx_ RR) (list 'IN 'px_ sipx-C))
    (list '= '((CX-ACT v) rx_ px_) (list 'LIST (list '(ACT v) 'rx_ (sipx-n1 'px_)) (list '(ACT v) 'rx_ (sipx-n2 'px_)))))
  'CX-ACT)
(sipx-value! 'cx-rip-value
  (sipx-stmt '(px_ qx_) (list (list 'IN 'px_ sipx-C) (list 'IN 'qx_ sipx-C))
    (list '= '((CX-RIP v) px_ qx_)
          (list '+ (list '(RIP v) (sipx-n1 'px_) (sipx-n1 'qx_)) (list '(RIP v) (sipx-n2 'px_) (sipx-n2 'qx_)))))
  'CX-RIP)
(sipx-value! 'cx-j-value
  (sipx-stmt '(px_) (list (list 'IN 'px_ sipx-C))
    (list '= '((CX-J v) px_) (list 'LIST (list '(VNEG v) (sipx-n2 'px_)) (sipx-n1 'px_))))
  'CX-J)

;;; ---- read-offs of the two tuples -----------------------------------------------------------
(define sipx-vals
  (list '(SCAL (SCAL v)) (list 'VEC sipx-C) '(VADD (CX-VADD v)) '(VZERO (LIST (VZERO v) (VZERO v)))
        '(VNEG (CX-VNEG v)) '(ACT (CX-ACT v)) '(RIP (CX-RIP v))))
(define (sipx-read-off! name fn acc val)
  (sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-SEMI-INNER-PRODUCT-SPACE v) (list '== (list acc (list fn 'v)) val)))))
  (di) (di)
  (fact 'sip-vec-set 'v)
  (fact 'sip-scal-ring 'v)
  (fact 'module-vzero-in-sip-as-module 'v)
  (dk-have! (list 'IN sipx-C 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
  (slot acc)
  (mac fn)
  (nth-r)
  (if (and (not (proof-done? *ps*)) (sipb-has-head? acc (dk-goal))) (slot acc))
  (if (not (proof-done? *ps*)) (qrfl))
  (if (not (proof-done? *ps*)) (begin (dk-focus! (car (dk-open-leaves))) (rfl)))
  (sipb-qed! name))
(for-each (lambda (p)
            (sipx-read-off! (symbol-append 'cx-sip- (car p)) 'CX-SIP (car p) (cadr p))
            (sipx-read-off! (symbol-append 'complexify- (car p)) 'COMPLEXIFY (car p) (cadr p)))
          sipx-vals)
(sipx-read-off! 'complexify-jop 'COMPLEXIFY 'JOP '(CX-J v))

;;; ---- the drive of a conjunct of the complexification -------------------------------------------
(define sipx-props '(IS-REAL-LINEAR-OP IS-SQUARE-MINUS-ID IS-ANTISYMMETRIC-OP))
(define sipx-rr-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define (sipx-subst-readoffs! fn)
  (for-each (lambda (p)
              (let ((e (dk-cite! (symbol-append (if (eq? fn 'CX-SIP) 'cx-sip- 'complexify-) (car p)) 'v)))
                (if (dk--occurs? (cadr e) (dk-goal)) (subst (list '= (cadr e) (caddr e))))))
            (append sipx-vals (if (eq? fn 'COMPLEXIFY) '((JOP (CX-J v))) '()))))
(define (sipx-open! fn)
  (di) (di)
  (sipx-pin!)
  (fact 'sip-vec-set 'v)
  (fact 'sip-scal-ring 'v)
  (fact 'module-vzero-in-sip-as-module 'v)
  (sipx-subst-readoffs! fn)
  (if (and (pair? (dk-goal)) (memq (car (dk-goal)) sipx-props))
      (begin (fact 'cx-j-fun 'v) (mac (car (dk-goal))) (sipx-subst-readoffs! fn)))
  (if (dk--occurs? '(CARR (SCAL v)) (dk-goal)) (subst '(= (CARR (SCAL v)) RR)))
  (if (dk--occurs? '(ONE (SCAL v)) (dk-goal))
      (begin (subst (list '= '(SCAL v) sipx-rr-ring)) (mac 'rr-scalar-ring-one))))
(define (sipx-cx-ops) '((CX-VADD v) (CX-VNEG v) (CX-ACT v) (CX-RIP v) (CX-J v) (ADD (SCAL v)) (MUL (SCAL v))))
(define (sipx-in? x lst) (cond ((null? lst) #f) ((equal? x (car lst)) #t) (#t (sipx-in? x (cdr lst)))))
(define (sipx-app-of? pred e) (let walk ((e e)) (and (pair? e) (list? e) (or (pred e) (any-pred walk e)))))
(define (sipx-redex e)
  (if (not (and (pair? e) (list? e)))
      #f
      (or (let loop ((xs e)) (cond ((null? xs) #f) ((sipx-redex (car xs))) (#t (loop (cdr xs)))))
          (and (sipx-in? (car e) (sipx-cx-ops))
               (not (any-pred (lambda (a) (sipx-app-of? (lambda (x) (and (pair? x) (sipx-in? (car x) (sipx-cx-ops)))) a)) (cdr e)))
               e))))
(define (sipx-arg-in! a)                ; an argument of a pair operation: in C
  (if (and (pair? a) (eq? (car a) 'LIST)) (sipx-pair-in! a)))
(define (sipx-has-nth-list?)
  (sipx-app-of? (lambda (x) (and (eq? (car x) 'NTH) (pair? (caddr x)) (eq? (car (caddr x)) 'LIST))) (dk-goal)))
(define (sipx-norm!)
  (let loop ((fuel 30))
    (if (sipx-has-nth-list?) (nth-r))
    (let ((rx (sipx-redex (dk-goal))))
      (if (and rx (> fuel 0))
          (let ((h (car rx)))
            (cond ((equal? h '(CX-VADD v)) (sipx-arg-in! (cadr rx)) (sipx-arg-in! (caddr rx))
                                           (subst (dk-cite! 'cx-vadd-value 'v (cadr rx) (caddr rx))))
                  ((equal? h '(CX-VNEG v)) (sipx-arg-in! (cadr rx)) (subst (dk-cite! 'cx-vneg-value 'v (cadr rx))))
                  ((equal? h '(CX-J v)) (sipx-arg-in! (cadr rx)) (subst (dk-cite! 'cx-j-value 'v (cadr rx))))
                  ((equal? h '(CX-ACT v)) (dk-real! (cadr rx)) (sipx-arg-in! (caddr rx))
                                          (subst (dk-cite! 'cx-act-value 'v (cadr rx) (caddr rx))))
                  ((equal? h '(CX-RIP v)) (sipx-arg-in! (cadr rx)) (sipx-arg-in! (caddr rx))
                                          (subst (dk-cite! 'cx-rip-value 'v (cadr rx) (caddr rx))))
                  (#t (subst (list '= '(SCAL v) sipx-rr-ring))
                      (subst (dk-cite! (if (equal? h '(ADD (SCAL v))) 'sip-rr-ring-add-value 'sip-rr-ring-mul-value)
                                       (cadr rx) (caddr rx)))))
            (loop (- fuel 1)))))))
;;; a chain of context equations from T1 to T2 (either orientation, at most three links)
(define (sipx-chain t1 t2)
  (let* ((eqs (filter (lambda (f) (dk-head-is? f '=)) (dk-asms)))
         (nbrs (lambda (t) (append (map caddr (filter (lambda (f) (equal? (cadr f) t)) eqs))
                                   (map cadr (filter (lambda (f) (equal? (caddr f) t)) eqs))))))
    (let search ((t t1) (d 0) (seen (list t1)))
      (cond ((equal? t t2) '())
            ((> d 2) #f)
            (#t (let try ((ns (nbrs t)))
                  (cond ((null? ns) #f)
                        ((member (car ns) seen) (try (cdr ns)))
                        (#t (let ((p (search (car ns) (+ d 1) (cons (car ns) seen))))
                              (if p (cons (cons t (car ns)) p) (try (cdr ns))))))))))))
;;; the law leaf: peel, open the vector variables, normalise, close componentwise by the
;;; laws of v cited at the components
(define (sipx-leaf! lemmas . opt)      ; OPT: a custom closer (lambda (xs rs) ...) for a real law
  (lambda ()
    ((apply sipx-leaf-after! (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!) '()) lemmas opt))))
;;; the same, the peel already done (LK its landings): a two-sided law peels ONE binder over a conjunction
(define (sipx-leaf-after! lk0 lemmas . opt)
  (lambda ()
    (let* ((lk lk0)
           (xs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) sipx-C))) lk)))
           (rs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) lk))))
      (for-each sipx-open-var! xs)
      (for-each (lambda (r) (dk-have! (list 'IN r '(CARR (SCAL v))) (lambda () (subst '(= (CARR (SCAL v)) RR)) (ass)))) rs)
      (for-each (lambda (x) (subst (list '= x (list 'LIST (sipx-n1 x) (sipx-n2 x))))) xs)
      (sipx-norm!)
      (let ((leaf (proof-state-focus *ps*)))
        (if (pair? opt)
            ((car opt) xs rs)
            (begin
              ;; cite the laws of v at the components, every ordering, then chain each component
              (for-each (lambda (i)
                          (let ((atoms (map (lambda (x) (list 'NTH i x)) xs)))
                            (for-each (lambda (lm)
                                        (for-each (lambda (pr) (for-each (lambda (pa) (vnb-guard (lambda () (apply fact lm 'v (append pr pa)))))
                                                                         (sipb-perms atoms)))
                                                  (sipb-perms rs)))
                                      lemmas)))
                        '(1 2))
              (let ((g (dk-goal)))
                (if (dk-asm? g) (ass)
                    (begin
                      (for-each (lambda (k)
                                  (if (not (sequent-node-grounded? leaf))
                                      (let* ((g2 (dk-goal)) (a (list-ref (cadr g2) k)) (b (list-ref (caddr g2) k)))
                                        (if (not (equal? a b))
                                            (let ((path (sipx-chain a b)))
                                              (if (not path) (error "sipx-leaf!: no chain" (expression->string a) (expression->string b)))
                                              (for-each (lambda (st) (if (not (sequent-node-grounded? leaf)) (subst (list '= (car st) (cdr st))))) path))))))
                                '(1 2))
                      (if (not (sequent-node-grounded? leaf))
                          (let ((g3 (dk-goal))) (sipx-pair-in! (cadr g3)) (rfl))))))))))))
;;; a real law: cite each (LEMMA . arg-builder) at the components, rewrite the instances whose
;;; left side is in the goal, type the form values, and finish by crs or ineq
(define (sipx-real-closer specs)
  (lambda (xs rs)
    (let ((leaf (proof-state-focus *ps*)))
      (for-each (lambda (i)
                  (for-each (lambda (sp)
                              (let ((e (apply dk-cite! (car sp) 'v ((cdr sp) rs (map (lambda (x) (list 'NTH i x)) xs)))))
                                (if (and (dk-head-is? e '=) (sipx-occ? (cadr e))) (subst e))))
                            specs))
                '(1 2))
      (for-each (lambda (t) (if (and (pair? t) (equal? (car t) '(RIP v))) (sipx-ft (cadr t) (caddr t))))
                (let collect ((e (dk-goal))) (if (and (pair? e) (list? e)) (cons e (append-map collect e)) '())))
      (if (not (sequent-node-grounded? leaf))
          (if (dk-head-is? (dk-goal) '<=)
              (apply dk-ineq! (filter (lambda (f) (or (and (dk-head-is? f '<=) (sipx-occ-atoms? f))
                                                      (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR) (sipx-occ? (cadr f)))))
                                      (dk-asms)))
              (crs))))))
(define (sipx-occ? t) (dk--occurs? t (dk-goal)))
(define (sipx-occ-atoms? f) (dk--occurs? (caddr f) (dk-goal)))
(define (sipx-law! name fn str closer)
  (sp str)
  (sipx-open! fn)
  (dk-conj-close! closer)
  (sipb-qed! name))
(define (sipx-stmt2 fn body)
  (string-append "forall([v], is-semi-inner-product-space(v) implies " body ")"))

;;; ---- IS-SEMI-INNER-PRODUCT-SPACE(CX-SIP(v)) -------------------------------------------------
(define (sipx-s body) (string-append "forall([v], is-semi-inner-product-space(v) implies " body ")"))
(define (sipx-typing! lemma) (lambda () (fact lemma 'v) (ass)))
(sp (make-wff (sipx-stmt '() '() (list 'IN '(CX-J v) (list 'FUN sipx-C sipx-C)))))
(dk-peel!) (sipx-pin!) (fact 'sip-vec-set 'v)
(mac 'CX-J)
(dk-lam-type! (lambda () (let* ((lk (dk-peel!)) (x (cadr (car lk)))) (sipx-open-var! x) (sipx-pair-in! (cadr (dk-goal))) (ass)))
              (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
(sipb-qed! 'cx-j-fun)
(define (sipx-fun! name fn dom rng)
  (sp (make-wff (sipx-stmt '() '() (list 'IN (list fn 'v) (list 'FUN dom rng)))))
  (dk-peel!) (sipx-pin!) (fact 'sip-vec-set 'v) (fact 'rr-is-set)
  (dk-have! (list 'IN sipx-C 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
  (mac fn)
  (if (dk--occurs? '(CARR (SCAL v)) (dk-goal)) (subst '(= (CARR (SCAL v)) RR)))
  (dk-lam-type!
    (lambda ()
      (let* ((lk (dk-peel!))
             (xs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) sipx-C))) lk))))
        (for-each sipx-open-var! xs)
        (let ((body (cadr (dk-goal))))
          (if (and (pair? body) (eq? (car body) 'LIST)) (sipx-pair-in! body)
              (begin (sipx-ft (cadr (cadr body)) (caddr (cadr body))) (sipx-ft (cadr (caddr body)) (caddr (caddr body))) (dk-real! body))))
        (if (not (sequent-node-grounded? (car (dk-open-leaves)))) #t)
        (if (dk-asm? (dk-goal)) (ass))))
    (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
  (sipb-qed! name))
(sipx-fun! 'cx-vadd-fun 'CX-VADD (list 'CARTESIAN sipx-C sipx-C) sipx-C)
(sipx-fun! 'cx-vneg-fun 'CX-VNEG sipx-C sipx-C)
(sipx-fun! 'cx-act-fun 'CX-ACT (list 'CARTESIAN 'RR sipx-C) sipx-C)
(sipx-fun! 'cx-rip-fun 'CX-RIP (list 'CARTESIAN sipx-C sipx-C) 'RR)

(sipx-law! 'cx-sip-length 'CX-SIP (sipx-s "length(cx-sip(v)) = 7")
  (lambda () (mac 'CX-SIP) (len-r) (if (not (proof-done? *ps*)) (arith))))
(sipx-law! 'cx-sip-scal-ring 'CX-SIP (sipx-s "is-ring(scal(cx-sip(v)))") (lambda () (ass)))
(sipx-law! 'cx-sip-vec-set 'CX-SIP (sipx-s "vec(cx-sip(v)) in set")
  (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
(sipx-law! 'cx-sip-vadd-fun 'CX-SIP (sipx-s "vadd(cx-sip(v)) in fun(cartesian(vec(cx-sip(v)), vec(cx-sip(v))), vec(cx-sip(v)))")
  (sipx-typing! 'cx-vadd-fun))
(sipx-law! 'cx-sip-vzero-in 'CX-SIP (sipx-s "vzero(cx-sip(v)) in vec(cx-sip(v))")
  (lambda () (sipx-pair-in! '(LIST (VZERO v) (VZERO v))) (ass)))
(sipx-law! 'cx-sip-vneg-fun 'CX-SIP (sipx-s "vneg(cx-sip(v)) in fun(vec(cx-sip(v)), vec(cx-sip(v)))") (sipx-typing! 'cx-vneg-fun))
(sipx-law! 'cx-sip-act-fun 'CX-SIP (sipx-s "act(cx-sip(v)) in fun(cartesian(carr(scal(cx-sip(v))), vec(cx-sip(v))), vec(cx-sip(v)))")
  (sipx-typing! 'cx-act-fun))
(sipx-law! 'cx-sip-rip-fun 'CX-SIP (sipx-s "rip(cx-sip(v)) in fun(cartesian(vec(cx-sip(v)), vec(cx-sip(v))), rr)") (sipx-typing! 'cx-rip-fun))
(sipx-law! 'cx-sip-assoc 'CX-SIP (sipx-s "is-associative(vadd(cx-sip(v)), vec(cx-sip(v)))")
  (lambda () (mac 'is-associative) ((sipx-leaf! '(hbs-vadd-assoc-sip-as-module)))))
(sipx-law! 'cx-sip-comm 'CX-SIP (sipx-s "is-commutative(vadd(cx-sip(v)), vec(cx-sip(v)))")
  (lambda () (mac 'is-commutative) ((sipx-leaf! '(hbs-vadd-comm-sip-as-module)))))
(sipx-law! 'cx-sip-identity 'CX-SIP (sipx-s "is-identity(vadd(cx-sip(v)), vzero(cx-sip(v)), vec(cx-sip(v)))")
  (lambda () (mac 'is-identity)
             (let* ((lk (dk-peel!)))
               (dk-conj-close! (sipx-leaf-after! lk '(hbs-vzero-l-sip-as-module hbs-vzero-r-sip-as-module))))))
(sipx-law! 'cx-sip-inverses 'CX-SIP (sipx-s "has-inverses(vadd(cx-sip(v)), vzero(cx-sip(v)), vneg(cx-sip(v)), vec(cx-sip(v)))")
  (lambda () (mac 'has-inverses)
             (let* ((lk (dk-peel!)) (x (cadr (car lk))))
               (dk-conj-close!
                 (lambda ()
                   (for-each (lambda (i) (let ((a (list 'NTH i x)))
                                           (sipx-open-var! x)
                                           (sipx-vt (list '(VNEG v) a))
                                           (dk-cite! 'hbs-vadd-comm-sip-as-module 'v (list '(VNEG v) a) a)))
                             '(1 2))
                   ((sipx-leaf-after! lk '(frm-v-right-inv-sip-as-module))))))))
(sipx-law! 'cx-sip-scal-pin 'CX-SIP (sipx-s "scal(cx-sip(v)) = normed-field-as-commutative-ring(rr-normed-field)") (lambda () (ass)))
(sipx-law! 'cx-sip-scal-carr 'CX-SIP (sipx-s "carr(scal(cx-sip(v))) = rr") (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))
(sipx-law! 'cx-sip-act-vadd 'CX-SIP
  (sipx-s "forall([r_ in carr(scal(cx-sip(v))), x_ in vec(cx-sip(v)), y_ in vec(cx-sip(v))],
     act(cx-sip(v))(r_, vadd(cx-sip(v))(x_, y_)) = vadd(cx-sip(v))(act(cx-sip(v))(r_, x_), act(cx-sip(v))(r_, y_)))")
  (sipx-leaf! '(hbs-act-vadd-sip-as-module)))
(sipx-law! 'cx-sip-act-add 'CX-SIP
  (sipx-s "forall([r_ in carr(scal(cx-sip(v))), s_ in carr(scal(cx-sip(v))), x_ in vec(cx-sip(v))],
     act(cx-sip(v))(add(scal(cx-sip(v)))(r_, s_), x_) = vadd(cx-sip(v))(act(cx-sip(v))(r_, x_), act(cx-sip(v))(s_, x_)))")
  (sipx-leaf! '(hbs-act-add-sip-as-module)))
(sipx-law! 'cx-sip-act-mul 'CX-SIP
  (sipx-s "forall([r_ in carr(scal(cx-sip(v))), s_ in carr(scal(cx-sip(v))), x_ in vec(cx-sip(v))],
     act(cx-sip(v))(mul(scal(cx-sip(v)))(r_, s_), x_) = act(cx-sip(v))(r_, act(cx-sip(v))(s_, x_)))")
  (sipx-leaf! '(hbs-act-mul-sip-as-module)))
(sipx-law! 'cx-sip-act-one 'CX-SIP
  (sipx-s "forall([x_ in vec(cx-sip(v))], act(cx-sip(v))(one(scal(cx-sip(v))), x_) = x_)")
  (sipx-leaf! '(hbs-act-one-sip-as-module)))
(sipx-law! 'cx-sip-rip-sym 'CX-SIP
  (sipx-s "forall([x_ in vec(cx-sip(v)), y_ in vec(cx-sip(v))], rip(cx-sip(v))(x_, y_) = rip(cx-sip(v))(y_, x_))")
  (sipx-leaf! '() (sipx-real-closer (list (cons 'sip-rip-sym (lambda (rs as) as))))))
(sipx-law! 'cx-sip-rip-add-left 'CX-SIP
  (sipx-s "forall([x_ in vec(cx-sip(v)), y_ in vec(cx-sip(v)), z_ in vec(cx-sip(v))],
     rip(cx-sip(v))(vadd(cx-sip(v))(x_, y_), z_) = rip(cx-sip(v))(x_, z_) + rip(cx-sip(v))(y_, z_))")
  (sipx-leaf! '() (sipx-real-closer (list (cons 'sip-rip-add-left (lambda (rs as) as))))))
(sipx-law! 'cx-sip-rip-homog-left 'CX-SIP
  (sipx-s "forall([a_ in rr, x_ in vec(cx-sip(v)), y_ in vec(cx-sip(v))],
     rip(cx-sip(v))(act(cx-sip(v))(a_, x_), y_) = a_ * rip(cx-sip(v))(x_, y_))")
  (sipx-leaf! '() (sipx-real-closer (list (cons 'sip-rip-homog-left (lambda (rs as) (append rs as)))))))
(sipx-law! 'cx-sip-rip-self-nonneg 'CX-SIP
  (sipx-s "forall([x_ in vec(cx-sip(v))], 0 <= rip(cx-sip(v))(x_, x_))")
  (sipx-leaf! '() (sipx-real-closer (list (cons 'sip-rip-self-nonneg (lambda (rs as) as))))))

(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v) (IS-SEMI-INNER-PRODUCT-SPACE (CX-SIP v))))))
(dk-peel!)
(for-each (lambda (n) (fact n 'v))
  '(cx-sip-length cx-sip-scal-ring cx-sip-vec-set cx-sip-vadd-fun cx-sip-vzero-in cx-sip-vneg-fun
    cx-sip-act-fun cx-sip-rip-fun cx-sip-assoc cx-sip-comm cx-sip-identity cx-sip-inverses
    cx-sip-scal-pin cx-sip-scal-carr cx-sip-act-vadd cx-sip-act-add cx-sip-act-mul cx-sip-act-one
    cx-sip-rip-sym cx-sip-rip-add-left cx-sip-rip-homog-left cx-sip-rip-self-nonneg))
(mac 'IS-SEMI-INNER-PRODUCT-SPACE)
(dk-conj-close! (lambda () (ass)))
(sipb-qed! 'cx-sip-is-sip)

;;; ---- IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE(COMPLEXIFY(v)) -------------------------------------
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (== (CX-SIP v) (LIST (SCAL v) (CARTESIAN (VEC v) (VEC v)) (CX-VADD v) (LIST (VZERO v) (VZERO v)) (CX-VNEG v)
                       (CX-ACT v) (CX-RIP v)))))))
(di) (di)
(mac 'CX-SIP)
(qrfl)
(sipb-qed! 'cx-sip-unfold)

(sipx-law! 'complexify-length 'COMPLEXIFY (sipx-s "length(complexify(v)) = 8")
  (lambda () (mac 'COMPLEXIFY) (len-r) (if (not (proof-done? *ps*)) (arith))))
(sipx-law! 'complexify-scal-ring 'COMPLEXIFY (sipx-s "is-ring(scal(complexify(v)))") (lambda () (ass)))
(sipx-law! 'complexify-vec-set 'COMPLEXIFY (sipx-s "vec(complexify(v)) in set")
  (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
(sipx-law! 'complexify-vadd-fun 'COMPLEXIFY (sipx-s "vadd(complexify(v)) in fun(cartesian(vec(complexify(v)), vec(complexify(v))), vec(complexify(v)))")
  (sipx-typing! 'cx-vadd-fun))
(sipx-law! 'complexify-vzero-in 'COMPLEXIFY (sipx-s "vzero(complexify(v)) in vec(complexify(v))")
  (lambda () (sipx-pair-in! '(LIST (VZERO v) (VZERO v))) (ass)))
(sipx-law! 'complexify-vneg-fun 'COMPLEXIFY (sipx-s "vneg(complexify(v)) in fun(vec(complexify(v)), vec(complexify(v)))") (sipx-typing! 'cx-vneg-fun))
(sipx-law! 'complexify-act-fun 'COMPLEXIFY (sipx-s "act(complexify(v)) in fun(cartesian(carr(scal(complexify(v))), vec(complexify(v))), vec(complexify(v)))")
  (sipx-typing! 'cx-act-fun))
(sipx-law! 'complexify-rip-fun 'COMPLEXIFY (sipx-s "rip(complexify(v)) in fun(cartesian(vec(complexify(v)), vec(complexify(v))), rr)") (sipx-typing! 'cx-rip-fun))
(sipx-law! 'complexify-jop-fun 'COMPLEXIFY (sipx-s "jop(complexify(v)) in fun(vec(complexify(v)), vec(complexify(v)))") (sipx-typing! 'cx-j-fun))
(sipx-law! 'complexify-sip 'COMPLEXIFY
  (sipx-s "is-semi-inner-product-space([scal(complexify(v)), vec(complexify(v)), vadd(complexify(v)), vzero(complexify(v)), vneg(complexify(v)), act(complexify(v)), rip(complexify(v))])")
  (lambda ()
    (let ((h (dk-cite! 'cx-sip-is-sip 'v)) (u (dk-cite! 'cx-sip-unfold 'v)))
      (dk-rewrite-h! h '(CX-SIP v) (caddr u))
      (ass))))
(sipx-law! 'complexify-linear 'COMPLEXIFY (sipx-s "is-real-linear-op(complexify(v), jop(complexify(v)))")
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (ass))
            ((sipb-has-head? 'CX-ACT g)
             ((sipx-leaf! '() (lambda (xs rs)
                                (let ((x (car xs)) (r (car rs)))
                                  (sipx-vt (list '(VNEG v) (list 'NTH 2 x)))
                                  (dk-cite! 'frm-act-neg-vec-sip-as-module 'v r (list 'NTH 2 x))
                                  (subst (list '= (list '(ACT v) r (list '(VNEG v) (list 'NTH 2 x))) (list '(VNEG v) (list '(ACT v) r (list 'NTH 2 x)))))
                                  (let ((g3 (dk-goal))) (sipx-pair-in! (cadr g3)) (if (not (proof-done? *ps*)) (rfl))))))))
            (#t
             ((sipx-leaf! '() (lambda (xs rs)
                                (let ((x (car xs)) (y (cadr xs)))
                                  (dk-cite! 'frm-v-neg-add-sip-as-module 'v (list 'NTH 2 x) (list 'NTH 2 y))
                                  (subst (list '= (list '(VNEG v) (list '(VADD v) (list 'NTH 2 x) (list 'NTH 2 y)))
                                               (list '(VADD v) (list '(VNEG v) (list 'NTH 2 x)) (list '(VNEG v) (list 'NTH 2 y)))))
                                  (let ((g3 (dk-goal))) (sipx-pair-in! (cadr g3)) (if (not (proof-done? *ps*)) (rfl))))))))))))
(sipx-law! 'complexify-square 'COMPLEXIFY (sipx-s "is-square-minus-id(complexify(v), jop(complexify(v)))")
  (sipx-leaf! '() (lambda (xs rs) (let ((g3 (dk-goal))) (sipx-pair-in! (cadr g3)) (rfl)))))
(sipx-law! 'complexify-antisym 'COMPLEXIFY (sipx-s "is-antisymmetric-op(complexify(v), jop(complexify(v)))")
  (sipx-leaf! '() (lambda (xs rs)
                    (let* ((x (car xs)) (y (cadr xs)) (x1 (list 'NTH 1 x)) (x2 (list 'NTH 2 x)) (y1 (list 'NTH 1 y)) (y2 (list 'NTH 2 y)))
                      (dk-cite! 'sip-rip-neg-left 'v x2 y1)
                      (dk-cite! 'sip-rip-neg-right 'v x1 y2)
                      (subst (list '= (list '(RIP v) (list '(VNEG v) x2) y1) (list '- (list '(RIP v) x2 y1))))
                      (subst (list '= (list '(RIP v) x1 (list '(VNEG v) y2)) (list '- (list '(RIP v) x1 y2))))
                      (for-each (lambda (p) (sipx-ft (car p) (cdr p))) (list (cons x2 y1) (cons x1 y2)))
                      (crs)))))

;;; THE COMPLEXIFICATION OF A SEMI-INNER-PRODUCT SPACE IS A COMPLEX SEMI-INNER-PRODUCT SPACE
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v) (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE (COMPLEXIFY v))))))
(dk-peel!)
(for-each (lambda (n) (fact n 'v))
  '(complexify-length complexify-scal-ring complexify-vec-set complexify-vadd-fun complexify-vzero-in complexify-vneg-fun
    complexify-act-fun complexify-rip-fun complexify-jop-fun complexify-sip complexify-linear complexify-square complexify-antisym))
(mac 'IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE)
(dk-conj-close! (lambda () (ass)))
(sipb-qed! 'complexify-is-csip)
(alias! 'complexify-is-csip "the complexification of a semi-inner-product space is a complex semi-inner-product space")
