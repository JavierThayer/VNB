          (one (list 'ONE sipb-cc-ring)))
      (cond ((and rx (> fuel 0))
             (let ((e (dk-cite! (if (equal? (car rx) (list 'ADD sipb-cc-ring)) 'sip-cc-ring-add-value 'sip-cc-ring-mul-value)
                                (cadr rx) (caddr rx))))
               (loop (dk-rewrite-h! f rx (caddr e)) (- fuel 1))))
            ((dk--occurs? one f)
             (fact 'sip-cc-ring-one)
             (loop (dk-rewrite-h! f one 1) (- fuel 1)))
            (#t (dk-asms))))))

