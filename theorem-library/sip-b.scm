;;; sip-b.scm -- THE COMPLEX STRUCTURE BY J (SIP-1, 2026-10-18; STOP POINT B of
;;; scratchpad/triage/SIP-1.md).  All PROVEN modulo 0.
;;;
;;; Source: the user's notes topological-vector-space.pdf, Ch. 1 s.3.1, Remark 1.22,
;;; equations (29)-(31) and (37)-(38), Propositions 1.23 (polarization), 1.24 and 1.25.
;;; Vocabulary: structure-library/sip-complex-vocab.scm.
;;;
;;; CONTENTS: Proposition 1.24 (all three implications, the third on a pre-Hilbert space); the
;;; laws of J; Proposition 1.25 in the semidefinite case -- (37) is a complex module structure,
;;; (38) is sesquilinear and conjugate symmetric with <x,x>_C = <x,x>; Proposition 1.23 and the
;;; uniqueness of (38); the bridge (37)-(38) to COMPLEX-INNER-PRODUCT-SPACE on a complex
;;; pre-Hilbert space; the bridge (29)-(30) back; J descends, so the quotient of a complex
;;; semi-inner-product space is a complex pre-Hilbert space; and the COMPLEXIFICATION of any
;;; semi-inner-product space is a complex semi-inner-product space.
;;;
;;; PROPOSITION 1.24 IN THE SEMIDEFINITE CASE.  Of the three properties of J -- (1)
;;; antisymmetric, (2) isometric, (3) J^2 = -I -- (1)+(3) => (2) and (2)+(3) => (1) hold on
;;; any semi-inner-product space; (1)+(2) => (3) needs definiteness and is proved on a
;;; pre-Hilbert space.  It FAILS on a semi-inner-product space: on RR with the zero form,
;;; J = the identity is antisymmetric and isometric (every value of the form is 0) and
;;; J^2 = I, not -I.  None of the three needs J to be linear: only J in FUN(VEC, VEC).
;;;
;;; Helper prefix: sipb-.
;;;
;;; LOAD WINDOW: after structure-library/sip-complex-vocab (which follows sip-a.scm: the companions
;;; `<name>-csip-as-sip' of the sip-a theorems are installed there) and theorem-library/rake-asm-b3
;;; (rb3-re-im-i); before theorem-library/sip-c.  Library: analysis -- nothing here cites the
;;; measure or complex-analysis libraries (cc-conjugate-sub, the cc-scalar-ring-* read-offs and
;;; cartesian-membership-nth live there and are avoided: see the report).

(define (sipb-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** sip-b: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (proof-leaves))
        (error "sip-b: unfinished" name))))

;;; ---- local copies of four sip-a.scm helpers (each theorem-library file loads in its own
;;; environment; the kit is the place for them -- see the report)
(define (sipb-has-head? h e)
  (and (pair? e) (or (eq? (car e) h) (sipb-has-head? h (car e)) (sipb-has-head? h (cdr e)))))
(define (sipb-map! f xs)
  (let loop ((xs xs) (acc '()))
    (if (null? xs) (reverse acc) (loop (cdr xs) (cons (f (car xs)) acc)))))
(define (sipb-perms xs)
  (if (null? xs) '(())
      (append-map (lambda (x) (map (lambda (p) (cons x p)) (sipb-perms (delete x xs)))) xs)))
(define (sipb-close-class-eq!)
  (let* ((leaf (proof-state-focus *ps*))
         (g (dk-goal)) (t1 (caddr (cadr g))) (t2 (caddr (caddr g)))
         (eqs (filter (lambda (f) (dk-head-is? f '=)) (dk-asms)))
         (nbrs (lambda (t) (append (map caddr (filter (lambda (f) (equal? (cadr f) t)) eqs))
                                   (map cadr (filter (lambda (f) (equal? (caddr f) t)) eqs))))))
    (let ((path (let search ((t t1) (d 0) (seen (list t1)))
                  (cond ((equal? t t2) '())
                        ((> d 2) #f)
                        (#t (let try ((ns (nbrs t)))
                              (cond ((null? ns) #f)
                                    ((member (car ns) seen) (try (cdr ns)))
                                    (#t (let ((p (search (car ns) (+ d 1) (cons (car ns) seen))))
                                          (if p (cons (cons t (car ns)) p) (try (cdr ns))))))))))))
      (if (not path) (error "sipb-close-class-eq!: no chain from" (expression->string t1) 'to (expression->string t2)))
      (for-each (lambda (st) (if (not (sequent-node-grounded? leaf)) (subst (list '= (car st) (cdr st))))) path)
      ;; the rewritten sequent may be one a sibling already proved (hash-consing): then the
      ;; leaf is grounded and there is nothing left to close
      (if (not (sequent-node-grounded? leaf)) (rfl)))))

;;; ---- typing helpers on a semi-inner-product space v with an operator jo ------------------
(define (sipb-vt x)                     ; type a vector expression over v (VADD VNEG VZERO ACT jo)
  (let ((want (list 'IN x '(VEC v))))
    (cond ((dk-asm? want) x)
          ((and (pair? x) (eq? (car x) 'jo))
           (sipb-vt (cadr x))
           (dk-cite! 'fun-apply-type-c 'jo '(VEC v) '(VEC v) (cadr x)) x)
          ((equal? x '(VZERO v)) (dk-cite! 'module-vzero-in-sip-as-module 'v) x)
          ((and (pair? x) (equal? (car x) '(VADD v)))
           (sipb-vt (cadr x)) (sipb-vt (caddr x))
           (dk-cite! 'module-vadd-type-sip-as-module 'v (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG v)))
           (sipb-vt (cadr x))
           (dk-cite! 'module-vneg-type-sip-as-module 'v (cadr x)) x)
          (#t (error "sipb-vt: cannot type" (expression->string x))))))
(define (sipb-ft x y) (sipb-vt x) (sipb-vt y) (dk-cite! 'sip-rip-type 'v x y))
;;; unfold a property hypothesis of jo (a def-predicate) into its universal and return it
(define (sipb-open! pred)
  (let ((h (dk-pick (lambda (f) (and (dk-head-is? f pred))) (symbol->string pred))))
    (dk-landed-1 (lambda () (mac-h pred h)))))

;;; ---- Proposition 1.24: (1) antisymmetric and (3) J^2 = -I give (2) isometric ------------
;;;   <Jx, Jy> = -<J(Jx), y> = -<-x, y> = <x, y>
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL jo (IMPLIES (IN jo (FUN (VEC v) (VEC v)))
    (IMPLIES (IS-ANTISYMMETRIC-OP v jo) (IMPLIES (IS-SQUARE-MINUS-ID v jo) (IS-ISOMETRIC-OP v jo)))))))))
(dk-peel!)
(let ((anti (sipb-open! 'IS-ANTISYMMETRIC-OP))
      (sq   (sipb-open! 'IS-SQUARE-MINUS-ID)))
  (mac 'IS-ISOMETRIC-OP)
  (dk-peel!)
  (let* ((g (dk-goal)) (x (cadr (cadr (cadr g)))) (y (cadr (caddr (cadr g)))))
    (sipb-vt '(jo (jo x_)))
    (sipb-vt (list 'jo y))
    (dk-apply! anti (list 'jo x) y)
    (dk-apply! sq x)
    (fact 'sip-rip-neg-left 'v x y)
    (sipb-ft (list 'jo x) (list 'jo y))
    (sipb-ft (list 'jo (list 'jo x)) y)
    (sipb-ft x y)
    (sipb-vt (list '(VNEG v) x))
    (sipb-ft (list '(VNEG v) x) y)
    (let ((e (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) (list '(RIP v) (list 'jo (list 'jo x)) y))))
                      "the antisymmetry instance")))
      (dk-rewrite-h! e (list 'jo (list 'jo x)) (list '(VNEG v) x)))
    (dk-ineq! (list '= (list '(RIP v) (list '(VNEG v) x) y) (list '- (list '(RIP v) (list 'jo x) (list 'jo y))))
              (list '= (list '(RIP v) (list '(VNEG v) x) y) (list '- (list '(RIP v) x y)))
              (list 'IN (list '(RIP v) (list '(VNEG v) x) y) 'RR)
              (list 'IN (list '(RIP v) (list 'jo x) (list 'jo y)) 'RR)
              (list 'IN (list '(RIP v) x y) 'RR))))
(sipb-qed! 'sip-isometric-of-antisym-sq)

;;; ---- Proposition 1.24: (2) isometric and (3) J^2 = -I give (1) antisymmetric ------------
;;;   <Jx, y> = <J(Jx), Jy> = <-x, Jy> = -<x, Jy>
(sp (make-wff '(FORALL v (IMPLIES (IS-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL jo (IMPLIES (IN jo (FUN (VEC v) (VEC v)))
    (IMPLIES (IS-ISOMETRIC-OP v jo) (IMPLIES (IS-SQUARE-MINUS-ID v jo) (IS-ANTISYMMETRIC-OP v jo)))))))))
(dk-peel!)
(let ((iso (sipb-open! 'IS-ISOMETRIC-OP))
      (sq  (sipb-open! 'IS-SQUARE-MINUS-ID)))
  (mac 'IS-ANTISYMMETRIC-OP)
  (dk-peel!)
  (let* ((g (dk-goal)) (x (cadr (cadr (cadr g)))) (y (caddr (cadr g))))
    (sipb-vt (list 'jo (list 'jo x)))
    (sipb-vt (list 'jo y))
    (dk-apply! iso (list 'jo x) y)
    (dk-apply! sq x)
    (sipb-vt (list '(VNEG v) x))
    (fact 'sip-rip-neg-left 'v x (list 'jo y))
    (sipb-ft (list 'jo x) y)
    (sipb-ft x (list 'jo y))
    (sipb-ft (list '(VNEG v) x) (list 'jo y))
    (let ((e (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) (list '(RIP v) (list 'jo (list 'jo x)) (list 'jo y)))))
                      "the isometry instance")))
      (dk-rewrite-h! e (list 'jo (list 'jo x)) (list '(VNEG v) x)))
    (dk-ineq! (list '= (list '(RIP v) (list '(VNEG v) x) (list 'jo y)) (list '(RIP v) (list 'jo x) y))
              (list '= (list '(RIP v) (list '(VNEG v) x) (list 'jo y)) (list '- (list '(RIP v) x (list 'jo y))))
              (list 'IN (list '(RIP v) (list 'jo x) y) 'RR)
              (list 'IN (list '(RIP v) x (list 'jo y)) 'RR)
              (list 'IN (list '(RIP v) (list '(VNEG v) x) (list 'jo y)) 'RR))))
(sipb-qed! 'sip-antisym-of-isometric-sq)

;;; ---- Proposition 1.24: (1) and (2) give (3), on a PRE-HILBERT space ------------------------
;;;   u = J(Jx) + x has <u, y> = -<Jx, Jy> + <x, y> = 0 for every y; so <u,u> = 0 and u = 0.
(sp (make-wff '(FORALL v (IMPLIES (IS-PRE-HILBERT-SPACE v)
  (FORALL jo (IMPLIES (IN jo (FUN (VEC v) (VEC v)))
    (IMPLIES (IS-ANTISYMMETRIC-OP v jo) (IMPLIES (IS-ISOMETRIC-OP v jo) (IS-SQUARE-MINUS-ID v jo)))))))))
(dk-peel!)
(fact 'phs-is-sip 'v)
(let ((anti (sipb-open! 'IS-ANTISYMMETRIC-OP))
      (iso  (sipb-open! 'IS-ISOMETRIC-OP)))
  (mac 'IS-SQUARE-MINUS-ID)
  (dk-peel!)
  (let* ((g (dk-goal)) (x (cadr (cadr (cadr g))))
         (jjx (list 'jo (list 'jo x)))
         (u (list '(VADD v) jjx x)))
    (sipb-vt u)
    (sipb-vt (list 'jo u))
    (dk-apply! anti (list 'jo x) u)
    (dk-apply! iso x u)
    (fact 'sip-rip-add-left 'v jjx x u)
    (for-each (lambda (p) (sipb-ft (car p) (cdr p)))
              (list (cons u u) (cons jjx u) (cons x u) (cons (list 'jo x) (list 'jo u))))
    (dk-have! (list '= (list '(RIP v) u u) 0)
      (lambda ()
        (dk-ineq! (list '= (list '(RIP v) u u) (list '+ (list '(RIP v) jjx u) (list '(RIP v) x u)))
                  (list '= (list '(RIP v) jjx u) (list '- (list '(RIP v) (list 'jo x) (list 'jo u))))
                  (list '= (list '(RIP v) (list 'jo x) (list 'jo u)) (list '(RIP v) x u))
                  (list 'IN (list '(RIP v) u u) 'RR) (list 'IN (list '(RIP v) jjx u) 'RR)
                  (list 'IN (list '(RIP v) x u) 'RR) (list 'IN (list '(RIP v) (list 'jo x) (list 'jo u)) 'RR))))
    (fact 'phs-definite 'v u)
    (sipb-vt (list '(VNEG v) x))
    (fact 'frm-v-neg-neg-sip-as-module 'v x)
    (dk-have! (list '= (list '(VADD v) jjx (list '(VNEG v) (list '(VNEG v) x))) '(VZERO v))
      (lambda () (subst (list '= (list '(VNEG v) (list '(VNEG v) x)) x)) (ass)))
    (fact 'frm-v-sub-zero-eq-sip-as-module 'v jjx (list '(VNEG v) x))
    (ass)))
(sipb-qed! 'phs-square-of-antisym-isometric)

;;; ==========================================================================================
;;; THE COMPLEX SEMI-INNER-PRODUCT SPACE: projections and the laws of J
;;; ==========================================================================================
(define (sipb-cproj! name conj)
  (sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v) conj))))
  (di) (di)
  (dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE '(IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v))))))
  (ass)
  (sipb-qed! name))
(sipb-cproj! 'csip-jop-fun '(IN (JOP v) (FUN (VEC v) (VEC v))))
(sipb-cproj! 'csip-real-linear '(IS-REAL-LINEAR-OP v (JOP v)))
(sipb-cproj! 'csip-square '(IS-SQUARE-MINUS-ID v (JOP v)))
(sipb-cproj! 'csip-antisym '(IS-ANTISYMMETRIC-OP v (JOP v)))

;;; the laws of J, as citable universals
(define (sipb-jlaw! name pred conj)
  (sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v) conj))))
  (di) (di)
  (let ((h (dk-cite! (cdr (assq pred '((IS-REAL-LINEAR-OP . csip-real-linear) (IS-SQUARE-MINUS-ID . csip-square)
                                        (IS-ANTISYMMETRIC-OP . csip-antisym))))
                     'v)))
    (dk-split-all! (list (dk-landed-1 (lambda () (mac-h pred h))))))
  (ass)
  (sipb-qed! name))
(sipb-jlaw! 'csip-jop-add 'IS-REAL-LINEAR-OP
  '(FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
     (= ((JOP v) ((VADD v) x_ y_)) ((VADD v) ((JOP v) x_) ((JOP v) y_))))))))
(sipb-jlaw! 'csip-jop-act 'IS-REAL-LINEAR-OP
  '(FORALL a_ (IMPLIES (IN a_ RR) (FORALL x_ (IMPLIES (IN x_ (VEC v))
     (= ((JOP v) ((ACT v) a_ x_)) ((ACT v) a_ ((JOP v) x_))))))))
(sipb-jlaw! 'csip-jop-sq 'IS-SQUARE-MINUS-ID
  '(FORALL x_ (IMPLIES (IN x_ (VEC v)) (= ((JOP v) ((JOP v) x_)) ((VNEG v) x_)))))
(sipb-jlaw! 'csip-jop-antisym 'IS-ANTISYMMETRIC-OP
  '(FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
     (= ((RIP v) ((JOP v) x_) y_) (- ((RIP v) x_ ((JOP v) y_)))))))))

(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (IN ((JOP v) x_) (VEC v))))))))
(dk-peel!)
(fact 'csip-jop-fun 'v)
(fact 'fun-apply-type-c '(JOP v) '(VEC v) '(VEC v) 'x_)
(ass)
(sipb-qed! 'csip-jop-type)

;;; ==========================================================================================
;;; PROPOSITION 1.25, THE SEMIDEFINITE CASE.  The two-term normal form
;;;     NF(p, q, x) = p.x + q.Jx              (p, q real)
;;; carries every computation: CACT(v)(z, x) = NF(Re z, Im z, x), and
;;;     NF(p,q,x) + NF(r,s,x) = NF(p+r, q+s, x)       t.NF(p,q,x) = NF(tp, tq, x)
;;;     J NF(p,q,x) = NF(-q, p, x).
;;; ==========================================================================================
(define (sipc-nf p q x) (list '(VADD v) (list '(ACT v) p x) (list '(ACT v) q (list '(JOP v) x))))
(define (sipc-pin!) (fact 'sip-scal-pin-csip-as-sip 'v))
;;; type a vector expression over a complex semi-inner-product space v
(define (sipc-vt x)
  (let ((want (list 'IN x '(VEC v))))
    (cond ((dk-asm? want) x)
          ((equal? x '(VZERO v)) (dk-cite! 'module-vzero-in-sip-as-module-csip-as-sip 'v) x)
          ((and (pair? x) (equal? (car x) '(VADD v)))
           (sipc-vt (cadr x)) (sipc-vt (caddr x))
           (dk-cite! 'module-vadd-type-sip-as-module-csip-as-sip 'v (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG v)))
           (sipc-vt (cadr x))
           (dk-cite! 'module-vneg-type-sip-as-module-csip-as-sip 'v (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT v)))
           (sipc-vt (caddr x))
           (dk-real! (cadr x))
           (dk-cite! 'hbs-act-in-sip-as-module-csip-as-sip 'v (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(JOP v)))
           (sipc-vt (cadr x))
           (dk-cite! 'csip-jop-type 'v (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(CACT v)))
           (sipc-vt (caddr x))
           (dk-cite! 'csip-cact-type-pt 'v (cadr x) (caddr x)) x)
          (#t (error "sipc-vt: cannot type" (expression->string x))))))
(define (sipc-ft x y) (sipc-vt x) (sipc-vt y) (dk-cite! 'sip-rip-type-csip-as-sip 'v x y))

(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (forall-guarded '(p_ q_ r_ s_ x_) '((IN p_ RR) (IN q_ RR) (IN r_ RR) (IN s_ RR) (IN x_ (VEC v)))
    (list '= (list '(VADD v) (sipc-nf 'p_ 'q_ 'x_) (sipc-nf 'r_ 's_ 'x_)) (sipc-nf '(+ p_ r_) '(+ q_ s_) 'x_)))))))
(dk-peel!)
(sipc-pin!)
(define sipc-jx '((JOP v) x_))
(sipc-vt (sipc-nf 'p_ 'q_ 'x_)) (sipc-vt (sipc-nf 'r_ 's_ 'x_))
(dk-real! '(+ p_ r_)) (dk-real! '(+ q_ s_))
(fact 'hbs-interchange-sip-as-module-csip-as-sip 'v '((ACT v) p_ x_) (list '(ACT v) 'q_ sipc-jx) '((ACT v) r_ x_) (list '(ACT v) 's_ sipc-jx))
(fact 'hbs-act-add-sip-as-module-csip-as-sip 'v 'p_ 'r_ 'x_)
(fact 'hbs-act-add-sip-as-module-csip-as-sip 'v 'q_ 's_ sipc-jx)
(subst (list '= (list '(VADD v) (sipc-nf 'p_ 'q_ 'x_) (sipc-nf 'r_ 's_ 'x_))
             (list '(VADD v) '((VADD v) ((ACT v) p_ x_) ((ACT v) r_ x_))
                   (list '(VADD v) (list '(ACT v) 'q_ sipc-jx) (list '(ACT v) 's_ sipc-jx)))))
(subst '(= ((ACT v) (+ p_ r_) x_) ((VADD v) ((ACT v) p_ x_) ((ACT v) r_ x_))))
(subst (list '= (list '(ACT v) '(+ q_ s_) sipc-jx) (list '(VADD v) (list '(ACT v) 'q_ sipc-jx) (list '(ACT v) 's_ sipc-jx))))
(rfl)
(sipb-qed! 'csip-nf-add)

(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (forall-guarded '(t_ p_ q_ x_) '((IN t_ RR) (IN p_ RR) (IN q_ RR) (IN x_ (VEC v)))
    (list '= (list '(ACT v) 't_ (sipc-nf 'p_ 'q_ 'x_)) (sipc-nf '(* t_ p_) '(* t_ q_) 'x_)))))))
(dk-peel!)
(sipc-pin!)
(sipc-vt (sipc-nf 'p_ 'q_ 'x_))
(dk-real! '(* t_ p_)) (dk-real! '(* t_ q_))
(fact 'hbs-act-vadd-sip-as-module-csip-as-sip 'v 't_ '((ACT v) p_ x_) (list '(ACT v) 'q_ sipc-jx))
(fact 'hbs-act-mul-sip-as-module-csip-as-sip 'v 't_ 'p_ 'x_)
(fact 'hbs-act-mul-sip-as-module-csip-as-sip 'v 't_ 'q_ sipc-jx)
(subst (list '= (list '(ACT v) 't_ (sipc-nf 'p_ 'q_ 'x_))
             (list '(VADD v) '((ACT v) t_ ((ACT v) p_ x_)) (list '(ACT v) 't_ (list '(ACT v) 'q_ sipc-jx)))))
(subst '(= ((ACT v) (* t_ p_) x_) ((ACT v) t_ ((ACT v) p_ x_))))
(subst (list '= (list '(ACT v) '(* t_ q_) sipc-jx) (list '(ACT v) 't_ (list '(ACT v) 'q_ sipc-jx))))
(rfl)
(sipb-qed! 'csip-nf-scale)

(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (forall-guarded '(p_ q_ x_) '((IN p_ RR) (IN q_ RR) (IN x_ (VEC v)))
    (list '= (list '(JOP v) (sipc-nf 'p_ 'q_ 'x_)) (sipc-nf '(- q_) 'p_ 'x_)))))))
(dk-peel!)
(sipc-pin!)
(dk-real! '(- q_))
(define sipc-px '((ACT v) p_ x_))
(define sipc-qjx (list '(ACT v) 'q_ sipc-jx))
(sipc-vt sipc-px) (sipc-vt sipc-qjx) (sipc-vt (list '(JOP v) sipc-jx)) (sipc-vt '((ACT v) q_ x_))
(fact 'csip-jop-add 'v sipc-px sipc-qjx)
(fact 'csip-jop-act 'v 'p_ 'x_)
(fact 'csip-jop-act 'v 'q_ sipc-jx)
(fact 'csip-jop-sq 'v 'x_)
(fact 'hbs-in-carr-sip-as-module-csip-as-sip 'v 'q_)
(fact 'frm-act-neg-vec-sip-as-module-csip-as-sip 'v 'q_ 'x_)
(fact 'sip-act-neg-scalar-csip-as-sip 'v 'q_ 'x_)
(sipc-vt '((VNEG v) ((ACT v) q_ x_)))
(sipc-vt (list '(ACT v) 'p_ sipc-jx))
(fact 'hbs-vadd-comm-sip-as-module-csip-as-sip 'v (list '(ACT v) 'p_ sipc-jx) '((VNEG v) ((ACT v) q_ x_)))
(subst (list '= (list '(JOP v) (sipc-nf 'p_ 'q_ 'x_)) (list '(VADD v) (list '(JOP v) sipc-px) (list '(JOP v) sipc-qjx))))
(subst (list '= (list '(JOP v) sipc-px) (list '(ACT v) 'p_ sipc-jx)))
(subst (list '= (list '(JOP v) sipc-qjx) (list '(ACT v) 'q_ (list '(JOP v) sipc-jx))))
(subst (list '= (list '(JOP v) sipc-jx) '((VNEG v) x_)))
(subst '(= ((ACT v) q_ ((VNEG v) x_)) ((VNEG v) ((ACT v) q_ x_))))
(subst '(= ((ACT v) (- q_) x_) ((VNEG v) ((ACT v) q_ x_))))
(subst (list '= (list '(VADD v) (list '(ACT v) 'p_ sipc-jx) '((VNEG v) ((ACT v) q_ x_)))
             (list '(VADD v) '((VNEG v) ((ACT v) q_ x_)) (list '(ACT v) 'p_ sipc-jx))))
(rfl)
(sipb-qed! 'csip-nf-jop)

;;; ---- (37): the complex scalar multiplication --------------------------------------------
(define (sipc-reim! z)                  ; type Re z, Im z in RR (z in CC in context)
  (dk-cite! 'real-part-in-rr z) (dk-cite! 'imag-part-in-rr z))
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL z_ (IMPLIES (IN z_ CC) (FORALL x_ (IMPLIES (IN x_ (VEC v))
    (= ((CACT v) z_ x_)
       ((VADD v) ((ACT v) (real-part z_) x_) ((ACT v) (imag-part z_) ((JOP v) x_))))))))))))
(dk-peel!)
(sipc-pin!)
(sipc-reim! 'z_)
(sipc-vt (sipc-nf '(real-part z_) '(imag-part z_) 'x_))
(mac 'CACT)
(dk-lam-b!)
(if (not (proof-done? *ps*)) (rfl))
(sipb-qed! 'csip-cact-value)

(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL z_ (IMPLIES (IN z_ CC) (FORALL x_ (IMPLIES (IN x_ (VEC v)) (IN ((CACT v) z_ x_) (VEC v))))))))))
(dk-peel!)
(sipc-pin!)
(sipc-reim! 'z_)
(fact 'csip-cact-value 'v 'z_ 'x_)
(subst (list '= '((CACT v) z_ x_) (sipc-nf '(real-part z_) '(imag-part z_) 'x_)))
(sipc-vt (sipc-nf '(real-part z_) '(imag-part z_) 'x_))
(ass)
(sipb-qed! 'csip-cact-type-pt)

(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (IN (CACT v) (FUN (CARTESIAN CC (VEC v)) (VEC v)))))))
(dk-peel!)
(sipc-pin!)
(fact 'sip-vec-set-csip-as-sip 'v)
(fact 'cc-is-set)
(mac 'CACT)
(dk-lam-type!
  (lambda ()
    (let* ((lk (dk-peel!))
           (z (cadr (or (any-pred (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC))) lk)
                        (error "csip-cact-fun: no complex variable")))))
      (sipc-reim! z)
      (sipc-vt (cadr (dk-goal)))
      (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))
  (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
(sipb-qed! 'csip-cact-fun)

;;; z.(x + y) = z.x + z.y
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL z_ (IMPLIES (IN z_ CC) (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
    (= ((CACT v) z_ ((VADD v) x_ y_)) ((VADD v) ((CACT v) z_ x_) ((CACT v) z_ y_)))))))))))))
(dk-peel!)
(sipc-pin!)
(sipc-reim! 'z_)
(let* ((a '(real-part z_)) (b '(imag-part z_)) (xy '((VADD v) x_ y_))
       (jx '((JOP v) x_)) (jy '((JOP v) y_)))
  (sipc-vt xy) (sipc-vt jx) (sipc-vt jy)
  (fact 'csip-cact-value 'v 'z_ xy)
  (fact 'csip-cact-value 'v 'z_ 'x_)
  (fact 'csip-cact-value 'v 'z_ 'y_)
  (subst (list '= (list '(CACT v) 'z_ xy) (sipc-nf a b xy)))
  (subst (list '= '((CACT v) z_ x_) (sipc-nf a b 'x_)))
  (subst (list '= '((CACT v) z_ y_) (sipc-nf a b 'y_)))
  (fact 'hbs-act-vadd-sip-as-module-csip-as-sip 'v a 'x_ 'y_)
  (fact 'csip-jop-add 'v 'x_ 'y_)
  (fact 'hbs-act-vadd-sip-as-module-csip-as-sip 'v b jx jy)
  (sipc-vt (list '(ACT v) a 'x_)) (sipc-vt (list '(ACT v) b jx)) (sipc-vt (list '(ACT v) a 'y_)) (sipc-vt (list '(ACT v) b jy))
  (fact 'hbs-interchange-sip-as-module-csip-as-sip 'v (list '(ACT v) a 'x_) (list '(ACT v) b jx) (list '(ACT v) a 'y_) (list '(ACT v) b jy))
  (subst (list '= (list '(ACT v) a xy) (list '(VADD v) (list '(ACT v) a 'x_) (list '(ACT v) a 'y_))))
  (subst (list '= (list '(JOP v) xy) (list '(VADD v) jx jy)))
  (subst (list '= (list '(ACT v) b (list '(VADD v) jx jy)) (list '(VADD v) (list '(ACT v) b jx) (list '(ACT v) b jy))))
  (subst (list '= (list '(VADD v) (sipc-nf a b 'x_) (sipc-nf a b 'y_))
               (list '(VADD v) (list '(VADD v) (list '(ACT v) a 'x_) (list '(ACT v) a 'y_))
                               (list '(VADD v) (list '(ACT v) b jx) (list '(ACT v) b jy)))))
  (rfl))
(sipb-qed! 'csip-cact-vadd)

;;; (z + w).x = z.x + w.x
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL z_ (IMPLIES (IN z_ CC) (FORALL w_ (IMPLIES (IN w_ CC) (FORALL x_ (IMPLIES (IN x_ (VEC v))
    (= ((CACT v) (+ z_ w_) x_) ((VADD v) ((CACT v) z_ x_) ((CACT v) w_ x_)))))))))))))
(dk-peel!)
(sipc-pin!)
(sipc-reim! 'z_) (sipc-reim! 'w_)
(dk-have! '(IN (+ z_ w_) CC) (lambda () (dk-have! '(AND (IN z_ CC) (IN w_ CC))) (fact 'cc-add-closed 'z_ 'w_) (ass)))
(sipc-reim! '(+ z_ w_))
(fact 'csip-cact-value 'v '(+ z_ w_) 'x_)
(fact 'csip-cact-value 'v 'z_ 'x_)
(fact 'csip-cact-value 'v 'w_ 'x_)
(fact 'cc-re-add 'z_ 'w_)
(fact 'cc-im-add 'z_ 'w_)
(fact 'csip-nf-add 'v '(real-part z_) '(imag-part z_) '(real-part w_) '(imag-part w_) 'x_)
(subst (list '= '((CACT v) (+ z_ w_) x_) (sipc-nf '(real-part (+ z_ w_)) '(imag-part (+ z_ w_)) 'x_)))
(subst '(= (real-part (+ z_ w_)) (+ (real-part z_) (real-part w_))))
(subst '(= (imag-part (+ z_ w_)) (+ (imag-part z_) (imag-part w_))))
(subst (list '= '((CACT v) z_ x_) (sipc-nf '(real-part z_) '(imag-part z_) 'x_)))
(subst (list '= '((CACT v) w_ x_) (sipc-nf '(real-part w_) '(imag-part w_) 'x_)))
(subst (list '= (list '(VADD v) (sipc-nf '(real-part z_) '(imag-part z_) 'x_) (sipc-nf '(real-part w_) '(imag-part w_) 'x_))
             (sipc-nf '(+ (real-part z_) (real-part w_)) '(+ (imag-part z_) (imag-part w_)) 'x_)))
(rfl)
(sipb-qed! 'csip-cact-add)

;;; (z w).x = z.(w.x)
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL z_ (IMPLIES (IN z_ CC) (FORALL w_ (IMPLIES (IN w_ CC) (FORALL x_ (IMPLIES (IN x_ (VEC v))
    (= ((CACT v) (* z_ w_) x_) ((CACT v) z_ ((CACT v) w_ x_)))))))))))))
(dk-peel!)
(sipc-pin!)
(sipc-reim! 'z_) (sipc-reim! 'w_)
(dk-have! '(IN (* z_ w_) CC) (lambda () (dk-have! '(AND (IN z_ CC) (IN w_ CC))) (fact 'cc-mul-closed 'z_ 'w_) (ass)))
(sipc-reim! '(* z_ w_))
(let* ((a '(real-part z_)) (b '(imag-part z_)) (c '(real-part w_)) (d '(imag-part w_))
       (y (sipc-nf c d 'x_))
       (ac (list '* a c)) (ad (list '* a d)) (bnd (list '* b (list '- d))) (bc (list '* b c)))
  (for-each dk-real! (list (list '- d) ac ad bnd bc (list '+ ac bnd) (list '+ ad bc)))
  (sipc-vt y)
  (fact 'csip-cact-value 'v '(* z_ w_) 'x_)
  (fact 'csip-cact-value 'v 'w_ 'x_)
  (fact 'csip-cact-value 'v 'z_ y)
  (fact 'cc-re-mul 'z_ 'w_)
  (fact 'cc-im-mul 'z_ 'w_)
  (fact 'csip-nf-scale 'v a c d 'x_)
  (fact 'csip-nf-jop 'v c d 'x_)
  (fact 'csip-nf-scale 'v b (list '- d) c 'x_)
  (fact 'csip-nf-add 'v ac ad bnd bc 'x_)
  (dk-have! (list '= (list '- ac (list '* b d)) (list '+ ac bnd)) (lambda () (crs)))
  ;; the left side: NF(Re zw, Im zw, x)
  (subst (list '= '((CACT v) (* z_ w_) x_) (sipc-nf '(real-part (* z_ w_)) '(imag-part (* z_ w_)) 'x_)))
  (subst (list '= '(real-part (* z_ w_)) (list '- ac (list '* b d))))
  (subst (list '= '(imag-part (* z_ w_)) (list '+ ad bc)))
  (subst (list '= (list '- ac (list '* b d)) (list '+ ac bnd)))
  ;; the right side: z.NF(c,d,x) = a.NF(c,d,x) + b.J NF(c,d,x)
  (subst (list '= '((CACT v) w_ x_) y))
  (subst (list '= (list '(CACT v) 'z_ y) (list '(VADD v) (list '(ACT v) a y) (list '(ACT v) b (list '(JOP v) y)))))
  (subst (list '= (list '(ACT v) a y) (sipc-nf ac ad 'x_)))
  (subst (list '= (list '(JOP v) y) (sipc-nf (list '- d) c 'x_)))
  (subst (list '= (list '(ACT v) b (sipc-nf (list '- d) c 'x_)) (sipc-nf bnd bc 'x_)))
  (subst (list '= (list '(VADD v) (sipc-nf ac ad 'x_) (sipc-nf bnd bc 'x_)) (sipc-nf (list '+ ac bnd) (list '+ ad bc) 'x_)))
  (rfl))
(sipb-qed! 'csip-cact-mul)

;;; 1.x = x
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (= ((CACT v) 1 x_) x_)))))))
(dk-peel!)
(sipc-pin!)
(fact 'cc-one-in)
(dk-have! '(IN 0 RR) (lambda () (arith)))
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-have! '(= 1 (+ 1 (* 0 +i))) (lambda () (crs)))
(dk-split-all! (list (dk-cite! 'cc-re-im-of 1 1 0)))
(fact 'csip-cact-value 'v 1 'x_)
(sipc-vt '((JOP v) x_))
(fact 'hbs-act-one-sip-as-module-csip-as-sip 'v 'x_)
(fact 'hbs-act-zero-sip-as-module-csip-as-sip 'v '((JOP v) x_))
(fact 'hbs-vzero-r-sip-as-module-csip-as-sip 'v 'x_)
(subst (list '= '((CACT v) 1 x_) (sipc-nf '(real-part 1) '(imag-part 1) 'x_)))
(subst '(= (real-part 1) 1))
(subst '(= (imag-part 1) 0))
(subst '(= ((ACT v) 1 x_) x_))
(subst '(= ((ACT v) 0 ((JOP v) x_)) (VZERO v)))
(subst '(= ((VADD v) x_ (VZERO v)) x_))
(if (not (proof-done? *ps*)) (rfl))
(sipb-qed! 'csip-cact-one)

;;; ---- (38): the complex form <x,y>_C = <x,y> - i <Jx, y> -----------------------------------
(define (sipc-crip-val x y) (list '- (list '(RIP v) x y) (list '* '+i (list '(RIP v) (list '(JOP v) x) y))))
(define (sipc-cc! t) (dk-cite! 'rr-subset-cc t))     ; a real is complex (t in RR in context)
(define (sipc-i!) (if (not (dk-asm? '(IN +i CC))) (fact 'cc-i-in)))
(define (sipc-fcc x y) (sipc-ft x y) (sipc-cc! (list '(RIP v) x y)))

(sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (forall-guarded '(x_ y_) '((IN x_ (VEC v)) (IN y_ (VEC v)))
    (list '= '((CRIP v) x_ y_) (sipc-crip-val 'x_ 'y_)))))))
(dk-peel!)
(sipc-pin!)
(sipc-fcc 'x_ 'y_) (sipc-fcc '((JOP v) x_) 'y_) (sipc-i!)
(dk-have! (list 'IN (sipc-crip-val 'x_ 'y_) 'CC) (lambda () (type-term)))
(mac 'CRIP)
(dk-lam-b!)
(if (not (proof-done? *ps*)) (rfl))
(sipb-qed! 'csip-crip-value)

(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v)) (IN ((CRIP v) x_ y_) CC)))))))))
(dk-peel!)
(sipc-pin!)
(sipc-fcc 'x_ 'y_) (sipc-fcc '((JOP v) x_) 'y_) (sipc-i!)
(fact 'csip-crip-value 'v 'x_ 'y_)
(subst (list '= '((CRIP v) x_ y_) (sipc-crip-val 'x_ 'y_)))
(type-term)
(sipb-qed! 'csip-crip-type-pt)

(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (IN (CRIP v) (FUN (CARTESIAN (VEC v) (VEC v)) CC))))))
(dk-peel!)
(sipc-pin!)
(fact 'sip-vec-set-csip-as-sip 'v)
(mac 'CRIP)
(dk-lam-type!
  (lambda ()
    (dk-peel!)
    (let* ((body (cadr (dk-goal))) (x (cadr (cadr body))) (y (caddr (cadr body))))
      (sipc-fcc x y) (sipc-fcc (list '(JOP v) x) y) (sipc-i!)
      (type-term))))
(sipb-qed! 'csip-crip-fun)

;;; <x + y, z>_C = <x,z>_C + <y,z>_C
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v)) (FORALL z_ (IMPLIES (IN z_ (VEC v))
    (= ((CRIP v) ((VADD v) x_ y_) z_) (+ ((CRIP v) x_ z_) ((CRIP v) y_ z_)))))))))))))
(dk-peel!)
(sipc-pin!)
(let ((xy '((VADD v) x_ y_)) (jx '((JOP v) x_)) (jy '((JOP v) y_)))
  (sipc-vt xy)
  (for-each (lambda (p) (sipc-fcc (car p) (cdr p)))
            (list (cons 'x_ 'z_) (cons 'y_ 'z_) (cons jx 'z_) (cons jy 'z_)))
  (fact 'csip-crip-value 'v xy 'z_)
  (fact 'csip-crip-value 'v 'x_ 'z_)
  (fact 'csip-crip-value 'v 'y_ 'z_)
  (fact 'sip-rip-add-left-csip-as-sip 'v 'x_ 'y_ 'z_)
  (fact 'csip-jop-add 'v 'x_ 'y_)
  (fact 'sip-rip-add-left-csip-as-sip 'v jx jy 'z_)
  (subst (list '= (list '(CRIP v) xy 'z_) (sipc-crip-val xy 'z_)))
  (subst (list '= '((CRIP v) x_ z_) (sipc-crip-val 'x_ 'z_)))
  (subst (list '= '((CRIP v) y_ z_) (sipc-crip-val 'y_ 'z_)))
  (subst (list '= (list '(RIP v) xy 'z_) (list '+ '((RIP v) x_ z_) '((RIP v) y_ z_))))
  (subst (list '= (list '(JOP v) xy) (list '(VADD v) jx jy)))
  (subst (list '= (list '(RIP v) (list '(VADD v) jx jy) 'z_) (list '+ (list '(RIP v) jx 'z_) (list '(RIP v) jy 'z_))))
  (crs))
(sipb-qed! 'csip-crip-add-left)

;;; <z.x, y>_C = z <x,y>_C
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL z_ (IMPLIES (IN z_ CC) (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
    (= ((CRIP v) ((CACT v) z_ x_) y_) (* z_ ((CRIP v) x_ y_)))))))))))))
(dk-peel!)
(sipc-pin!)
(sipc-reim! 'z_)
(let* ((ra (dk-name! '(real-part z_)))
       (rb (dk-name! '(imag-part z_)))
       (jx '((JOP v) x_))
       (zx (sipc-nf ra rb 'x_))
       (jzx (sipc-nf (list '- rb) ra 'x_))
       (dec (dk-cite! 'cc-re-im-decompose 'z_))
       (dec1 (dk-rewrite-h! dec '(real-part z_) ra))
       (dec2 (dk-rewrite-h! dec1 '(imag-part z_) rb)))
  (dk-real! (list '- rb))
  (sipc-vt zx) (sipc-vt jzx)
  (for-each (lambda (p) (sipc-fcc (car p) (cdr p)))
            (list (cons 'x_ 'y_) (cons jx 'y_) (cons (list '(ACT v) ra 'x_) 'y_) (cons (list '(ACT v) rb jx) 'y_)
                  (cons (list '(ACT v) (list '- rb) 'x_) 'y_) (cons (list '(ACT v) ra jx) 'y_)))
  (fact 'csip-cact-value 'v 'z_ 'x_)
  (fact 'csip-crip-value 'v zx 'y_)
  (fact 'csip-crip-value 'v 'x_ 'y_)
  (fact 'csip-nf-jop 'v ra rb 'x_)
  (fact 'sip-rip-add-left-csip-as-sip 'v (list '(ACT v) ra 'x_) (list '(ACT v) rb jx) 'y_)
  (fact 'sip-rip-add-left-csip-as-sip 'v (list '(ACT v) (list '- rb) 'x_) (list '(ACT v) ra jx) 'y_)
  (fact 'sip-rip-homog-left-csip-as-sip 'v ra 'x_ 'y_)
  (fact 'sip-rip-homog-left-csip-as-sip 'v rb jx 'y_)
  (fact 'sip-rip-homog-left-csip-as-sip 'v (list '- rb) 'x_ 'y_)
  (fact 'sip-rip-homog-left-csip-as-sip 'v ra jx 'y_)
  (subst (list '= '((CACT v) z_ x_) (sipc-nf '(real-part z_) '(imag-part z_) 'x_)))
  (subst (list '= '(real-part z_) ra))
  (subst (list '= '(imag-part z_) rb))
  (subst (list '= (list '(CRIP v) zx 'y_) (sipc-crip-val zx 'y_)))
  (subst (list '= '((CRIP v) x_ y_) (sipc-crip-val 'x_ 'y_)))
  (subst (list '= (list '(JOP v) zx) jzx))
  (subst (list '= (list '(RIP v) zx 'y_) (list '+ (list '(RIP v) (list '(ACT v) ra 'x_) 'y_) (list '(RIP v) (list '(ACT v) rb jx) 'y_))))
  (subst (list '= (list '(RIP v) jzx 'y_) (list '+ (list '(RIP v) (list '(ACT v) (list '- rb) 'x_) 'y_) (list '(RIP v) (list '(ACT v) ra jx) 'y_))))
  (subst (list '= (list '(RIP v) (list '(ACT v) ra 'x_) 'y_) (list '* ra '((RIP v) x_ y_))))
  (subst (list '= (list '(RIP v) (list '(ACT v) rb jx) 'y_) (list '* rb (list '(RIP v) jx 'y_))))
  (subst (list '= (list '(RIP v) (list '(ACT v) (list '- rb) 'x_) 'y_) (list '* (list '- rb) '((RIP v) x_ y_))))
  (subst (list '= (list '(RIP v) (list '(ACT v) ra jx) 'y_) (list '* ra (list '(RIP v) jx 'y_))))
  (subst (list '= 'z_ (caddr dec2)))
  (sipc-cc! ra) (sipc-cc! rb)
  (crs))
(sipb-qed! 'csip-crip-homog-left)

;;; <y, x>_C = conj <x, y>_C
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v))
    (= ((CRIP v) y_ x_) (conjugate ((CRIP v) x_ y_)))))))))))
(dk-peel!)
(sipc-pin!)
(let ((jx '((JOP v) x_)) (jy '((JOP v) y_)))
  (for-each (lambda (p) (sipc-fcc (car p) (cdr p)))
            (list (cons 'x_ 'y_) (cons 'y_ 'x_) (cons jx 'y_) (cons jy 'x_) (cons 'y_ jx)))
  (fact 'csip-crip-value 'v 'y_ 'x_)
  (fact 'csip-crip-value 'v 'x_ 'y_)
  (fact 'cc-i-in)
  (dk-have! (list 'IN (list '* '+i (list '(RIP v) jx 'y_)) 'CC) (lambda () (type-term)))
  (dk-have! (list 'AND (list 'IN (list '(RIP v) 'x_ 'y_) 'CC) (list 'IN (list '* '+i (list '(RIP v) jx 'y_)) 'CC)))
  ;; conj(a - b) = conj a - conj b, by binary-minus-def and the conjugate of a sum and of a negative
  (let* ((a (list '(RIP v) 'x_ 'y_)) (b (list '* '+i (list '(RIP v) jx 'y_))))
    (fact 'cc-conjugate-closed a) (fact 'cc-conjugate-closed b)
    (fact 'cc-neg-closed b)
    (dk-have! (list '= (list 'conjugate (list '- a b)) (list '- (list 'conjugate a) (list 'conjugate b)))
      (lambda ()
        (mac 'binary-minus-def)
        (dk-have! (list 'AND (list 'IN a 'CC) (list 'IN (list '- b) 'CC)) (lambda () (dk-conj-close! (lambda () (ass)))))
        (fact 'cc-conjugate-add a (list '- b))
        (fact 'cc-conjugate-neg b)
        (subst (list '= (list 'conjugate (list '+ a (list '- b))) (list '+ (list 'conjugate a) (list 'conjugate (list '- b)))))
        (subst (list '= (list 'conjugate (list '- b)) (list '- (list 'conjugate b))))
        (fact 'cc-conjugate-closed (list '- b))
        (rfl))))
  (dk-have! (list 'AND '(IN +i CC) (list 'IN (list '(RIP v) jx 'y_) 'CC)))
  (fact 'cc-conjugate-mul '+i (list '(RIP v) jx 'y_))
  (fact 'cc-conjugate-i)
  (fact 'cc-conjugate-fixes-rr (list '(RIP v) 'x_ 'y_))
  (fact 'cc-conjugate-fixes-rr (list '(RIP v) jx 'y_))
  (fact 'csip-jop-antisym 'v 'y_ 'x_)
  (fact 'sip-rip-sym-csip-as-sip 'v 'y_ jx)
  (fact 'sip-rip-sym-csip-as-sip 'v 'y_ 'x_)
  (subst (list '= '((CRIP v) y_ x_) (sipc-crip-val 'y_ 'x_)))
  (subst (list '= '((CRIP v) x_ y_) (sipc-crip-val 'x_ 'y_)))
  (subst (list '= (list 'conjugate (sipc-crip-val 'x_ 'y_))
               (list '- (list 'conjugate (list '(RIP v) 'x_ 'y_)) (list 'conjugate (list '* '+i (list '(RIP v) jx 'y_))))))
  (subst (list '= (list 'conjugate (list '* '+i (list '(RIP v) jx 'y_)))
               (list '* '(conjugate +i) (list 'conjugate (list '(RIP v) jx 'y_)))))
  (subst '(= (conjugate +i) (- +i)))
  (subst (list '= (list 'conjugate (list '(RIP v) 'x_ 'y_)) (list '(RIP v) 'x_ 'y_)))
  (subst (list '= (list 'conjugate (list '(RIP v) jx 'y_)) (list '(RIP v) jx 'y_)))
  (subst (list '= (list '(RIP v) jy 'x_) (list '- (list '(RIP v) 'y_ jx))))
  (subst (list '= (list '(RIP v) 'y_ jx) (list '(RIP v) jx 'y_)))
  (subst (list '= (list '(RIP v) 'y_ 'x_) (list '(RIP v) 'x_ 'y_)))
  (crs))
(sipb-qed! 'csip-crip-conj-sym)

;;; <x, x>_C = <x, x>: <Jx, x> = -<x, Jx> = -<Jx, x> vanishes
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (= ((CRIP v) x_ x_) ((RIP v) x_ x_))))))))
(dk-peel!)
(sipc-pin!)
(let ((jx '((JOP v) x_)))
  (sipc-fcc 'x_ 'x_) (sipc-fcc jx 'x_) (sipc-fcc 'x_ jx)
  (fact 'csip-jop-antisym 'v 'x_ 'x_)
  (fact 'sip-rip-sym-csip-as-sip 'v 'x_ jx)
  (dk-have! (list '= (list '(RIP v) jx 'x_) 0)
    (lambda () (dk-ineq! (list '= (list '(RIP v) jx 'x_) (list '- (list '(RIP v) 'x_ jx)))
                         (list '= (list '(RIP v) 'x_ jx) (list '(RIP v) jx 'x_))
                         (list 'IN (list '(RIP v) jx 'x_) 'RR) (list 'IN (list '(RIP v) 'x_ jx) 'RR))))
  (fact 'csip-crip-value 'v 'x_ 'x_)
  (subst (list '= '((CRIP v) x_ x_) (sipc-crip-val 'x_ 'x_)))
  (subst (list '= (list '(RIP v) jx 'x_) 0))
  (crs))
(sipb-qed! 'csip-crip-self)

;;; ---- the complex scalar ring's operations at complex numbers, as value equations ------------
(define sipb-cc-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define (sipb-cc-view! name acc stmt)
  (sp (make-wff stmt))
  (let ((lk (dk-peel!)))
    (fact 'cc-is-normed-field)
    (slot acc)
    (mac 'NORMED-FIELD-AS-COMMUTATIVE-RING)
    (nth-r)
    (slot acc)
    (let ((leaf (proof-state-focus *ps*)))
      (if (let walk ((e (dk-goal))) (and (pair? e) (list? e) (or (and (pair? (car e)) (eq? (caar e) 'VNB-LAMBDA)) (any-pred walk e))))
          (dk-lam-b!))
      (if (not (sequent-node-grounded? leaf)) (rfl))))
  (sipb-qed! name))
(sipb-cc-view! 'sip-cc-ring-carr 'CARR (list '= (list 'CARR sipb-cc-ring) 'CC))
(sipb-cc-view! 'sip-cc-ring-one 'ONE (list '= (list 'ONE sipb-cc-ring) 1))
(sipb-cc-view! 'sip-cc-ring-add-value 'ADD
  (forall-guarded '(ca_ cb_) '((IN ca_ CC) (IN cb_ CC)) (list '= (list (list 'ADD sipb-cc-ring) 'ca_ 'cb_) '(+ ca_ cb_))))
(sipb-cc-view! 'sip-cc-ring-mul-value 'MUL
  (forall-guarded '(ca_ cb_) '((IN ca_ CC) (IN cb_ CC)) (list '= (list (list 'MUL sipb-cc-ring) 'ca_ 'cb_) '(* ca_ cb_))))
(sipb-cc-view! 'sip-cc-ring-neg-value 'NEG
  (forall-guarded '(ca_) '((IN ca_ CC)) (list '= (list (list 'NEG sipb-cc-ring) 'ca_) '(- ca_))))
;;; the redexes ((ADD ring) a b), ((MUL ring) a b) of the complex scalar ring in the GOAL, to + and *
(define (sipb-cc-norm!)
  (let loop ((fuel 8))
    (let ((rx (let find ((e (dk-goal)))
                (and (pair? e) (list? e)
                     (or (let inner ((xs e)) (cond ((null? xs) #f) ((find (car xs))) (#t (inner (cdr xs)))))
                         (and (or (equal? (car e) (list 'ADD sipb-cc-ring)) (equal? (car e) (list 'MUL sipb-cc-ring))) (= (length e) 3) e))))))
      (if (and rx (> fuel 0))
          (begin (subst (dk-cite! (if (equal? (car rx) (list 'ADD sipb-cc-ring)) 'sip-cc-ring-add-value 'sip-cc-ring-mul-value)
                                  (cadr rx) (caddr rx)))
                 (loop (- fuel 1)))))))

;;; ==========================================================================================
;;; THE BRIDGE (37)-(38): a complex PRE-HILBERT space with the complex operations is a
;;; COMPLEX-INNER-PRODUCT-SPACE (structure-library/complex-inner-product.scm, unchanged).
;;; One lemma per conjunct of that definition at s := CSIP-CIPS(v), stated in the definition's
;;; own words; the capstone unfolds the definition and finds each.
;;; ==========================================================================================
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-PRE-HILBERT-SPACE v) (IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)))))
(di) (di)
(dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'is-complex-pre-hilbert-space-def '(IS-COMPLEX-PRE-HILBERT-SPACE v))))))
(ass)
(sipb-qed! 'cphs-is-csip)

(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-PRE-HILBERT-SPACE v)
  (FORALL x_ (IMPLIES (IN x_ (VEC v)) (IMPLIES (= ((RIP v) x_ x_) 0) (= x_ (VZERO v)))))))))
(di) (di)
(dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'is-complex-pre-hilbert-space-def '(IS-COMPLEX-PRE-HILBERT-SPACE v))))))
(ass)
(sipb-qed! 'cphs-definite)

;;; read-offs of the CSIP-CIPS tuple
(define (sipb-ci-read-off! name acc val)
  (sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-SEMI-INNER-PRODUCT-SPACE v)
                  (list '== (list acc '(CSIP-CIPS v)) val)))))
  (di) (di)
  (fact 'cc-is-normed-field)
  (fact 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
  (slot acc)
  (mac 'CSIP-CIPS)
  (nth-r)
  (if (and (not (proof-done? *ps*)) (sipb-has-head? acc (dk-goal))) (slot acc))
  (if (not (proof-done? *ps*)) (qrfl))
  (sipb-qed! name))
(sipb-ci-read-off! 'csip-cips-scal 'SCAL sipb-cc-ring)
(sipb-ci-read-off! 'csip-cips-vec 'VEC '(VEC v))
(sipb-ci-read-off! 'csip-cips-vadd 'VADD '(VADD v))
(sipb-ci-read-off! 'csip-cips-vzero 'VZERO '(VZERO v))
(sipb-ci-read-off! 'csip-cips-vneg 'VNEG '(VNEG v))
(sipb-ci-read-off! 'csip-cips-act 'ACT '(CACT v))
(sipb-ci-read-off! 'csip-cips-ip 'IP '(CRIP v))

;;; THE DRIVE of a conjunct: rewrite the accessors of CSIP-CIPS(v) to their values, the
;;; scalar ring's operations to CC's, peel, beta, and let CLOSER finish.
(define sipb-ci-readoffs
  '((SCAL . csip-cips-scal) (VEC . csip-cips-vec) (VADD . csip-cips-vadd) (VZERO . csip-cips-vzero)
    (VNEG . csip-cips-vneg) (ACT . csip-cips-act) (IP . csip-cips-ip)))
(define (sipb-ci-open!)
  (di) (di)
  (fact 'cphs-is-csip 'v)
  (fact 'cc-is-normed-field)
  (fact 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
  (fact 'commutative-ring-is-ring sipb-cc-ring)
  (sipc-pin!)
  (for-each (lambda (p)
              (let ((e (dk-cite! (cdr p) 'v)))
                (if (dk--occurs? (cadr e) (dk-goal)) (subst (list '= (cadr e) (caddr e))))))
            sipb-ci-readoffs)
  (fact 'sip-cc-ring-carr)
  (fact 'sip-cc-ring-one)
  (if (dk--occurs? (list 'CARR sipb-cc-ring) (dk-goal)) (subst (list '= (list 'CARR sipb-cc-ring) 'CC)))
  (if (dk--occurs? (list 'ONE sipb-cc-ring) (dk-goal)) (subst (list '= (list 'ONE sipb-cc-ring) 1))))
(define (sipb-ci-law! name str closer)
  (sp str)
  (sipb-ci-open!)
  (let ((lk (dk-peel!)))
    (sipb-cc-norm!)
    (closer lk))
  (sipb-qed! name))
;;; close by citing LEMMA at the eigenvariables (every ordering), or the goal is in context
(define (sipb-cite-close! lemma)
  (lambda (lk)
    (let* ((vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) lk))))
      (let loop ((ps (sipb-perms vs)))
        (cond ((sequent-node-grounded? (proof-state-focus *ps*)) #t)
              ((dk-asm? (dk-goal)) (ass))
              ((null? ps) (error "sipb-cite-close!: no ordering of the variables gives the goal" lemma (expression->string (dk-goal))))
              (#t (vnb-guard (lambda () (apply fact lemma 'v (car ps)))) (loop (cdr ps))))))))

