  (let loop ((f (dk-rewrite-h! f '(SCAL w) sipb-cc-ring)) (fuel 8))
    (let ((rx (let find ((e f))
                (and (pair? e) (list? e)
                     (or (let inner ((xs e)) (cond ((null? xs) #f) ((find (car xs))) (#t (inner (cdr xs)))))
