          (dk-conj-close!
           (lambda ()
             (if (dk-head-is? (dk-goal) 'SUBSET)
                 (begin (mac 'subset-def)
                        (let ((z (cvt-peel-var!))) (dk-landed (lambda () (sep-me (list 'IN z cvt-N)))) (cvt-ass!)))
                 (let* ((pl (dk-peel!))
                        (ins (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) cvt-N))) pl))
