;;; cvx-tb.scm -- Lemma 1.12 of the compact-groups notes: the convex hull of a totally bounded
;;; subset of a real normed vector space is totally bounded.  Route: the join of a totally bounded
;;; set to a point is totally bounded (a net of the set times a grid of [0, 1]); the hull of a
;;; finite set is totally bounded (induction on the finite set, the hull of S + {a} lying in the
;;; join of hull(S) to a); and hull(E) lies within r/3 of hull(A) for a finite r/3-net A of E,
;;; since the closed r/3-neighbourhood of a convex set is convex.
;;; Agent ISOM, 2026-10-26.  Helper prefix: cvt-.  Library: linear-algebra.

(define (cvt-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (cvt-ass-rfl!) (if (dk-asm? (dk-goal)) (ass) (rfl)))
(define (cvt-peel-var!) (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!)))))
(define (cvt-split-if! pred)
  (let ((hs (filter (lambda (h) (and (dk-head-is? h 'AND) (pred h))) (dk-asms))))
    (if (pair? hs) (dk-split-all! hs))))
(define (cvt-act r x) (list '(ACT m) r x))
(define (cvt-add x y) (list '(VADD m) x y))
(define (cvt-neg x) (list '(VNEG m) x))
(define (cvt-cvx x y t) (cvt-add (cvt-act (list '- 1 t) x) (cvt-act t y)))
(define (cvt-forall vs body) (if (null? vs) body (list 'FORALL (car vs) (cvt-forall (cdr vs) body))))
(define (cvt-implies hs concl) (if (null? hs) concl (list 'IMPLIES (car hs) (cvt-implies (cdr hs) concl))))
(define (cvt-unit v) (list (list 'IN v 'RR) (list '<= 0 v) (list '<= v 1)))
;; land (IN v (VEC m)) for a vector term built from typed atoms by VADD, ACT, VNEG, VZERO
(define (cvt-type! v)
  (let ((goal (list 'IN v '(VEC m))))
    (cond ((dk-asm? goal) #t)
          ((equal? v '(VZERO m)) (dk-cite! 'nvs-vzero-in-vec 'm))
          ((and (pair? v) (equal? (car v) '(VADD m)))
           (cvt-type! (cadr v)) (cvt-type! (caddr v)) (dk-cite! 'nvs-vadd-in-vec 'm (cadr v) (caddr v)))
          ((and (pair? v) (equal? (car v) '(ACT m)))
           (dk-real! (cadr v)) (cvt-type! (caddr v)) (dk-cite! 'nvs-act-in-vec 'm (cadr v) (caddr v)))
          ((and (pair? v) (equal? (car v) '(VNEG m)))
           (cvt-type! (cadr v)) (dk-cite! 'nvs-vneg-in-vec 'm (cadr v)))
          (#t (error "cvt-type!: an untyped vector atom" v)))))
;; cite THM at ARGS (an equation) after typing every vector argument, and rewrite the goal with it
(define (cvt-rw! thm . args)
  (let ((eq (apply dk-cite! thm 'm args)))
    (subst eq)
    eq))
(define (cvt-negone x)                   ; the scalar the tree writes as -1, read off nvs-neg-one-act
  (cadr (cadr (dk-cite! 'nvs-neg-one-act 'm x))))

;;; ---- two shift identities ----
;;;   (1-t) z + t a  =  ((1-t) x + t a) + (1-t)(z - x)
;;;   (1-tau) f + tau a  =  ((1-t) f + t a) + (tau - t)(a - f)
;;; =====================================================================
;;; W1 (2026-11-04): total boundedness read over CLASSES of centres
;;; =====================================================================
;;; IS-TOTALLY-BOUNDED-IN (structure-library/cvx-vocab.scm) now bounds the finite family of
;;; centres tbf_ by SET, so that it is predicative in a comprehension condition.  The bound
;;; changes nothing: a class with a finite cardinal is a set (card-nn-is-set,
;;; theorem-library/top-product.scm).  The proofs below cite the class form.
(define (w1tb-step! law)               ; goal: forall r. POS-RR r => FORSOME ...; law: the context's
  (let* ((r (cadr (car (filter (lambda (q) (dk-head-is? q 'POS-RR)) (dk-peel!)))))
         (w (dk-skolem! (dk-apply! law r) #t)))
    (if (not (dk-asm? (list 'IN w 'SET))) (dk-cite! 'card-nn-is-set w))
    (ew w)
    (dk-conj-close! (lambda () (ass)))))
(define (w1tb-fwd!)
  (let* ((hyp (or (find-first (lambda (f) (dk-head-is? f 'IS-TOTALLY-BOUNDED-IN)) (dk-asms)) (error "w1tb-fwd!: no hypothesis")))
         (law (dk-landed-1 (lambda () (mac-h 'is-totally-bounded-in hyp)))))
    (w1tb-step! law)))
(define (w1tb-bwd!)
  (let ((law (or (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR))) (dk-asms))
                 (error "w1tb-bwd!: no class-form hypothesis"))))
    (mac 'is-totally-bounded-in)
    (w1tb-step! law)))
(sp (make-wff '(FORALL tbm_ (FORALL tba_ (IFF (IS-TOTALLY-BOUNDED-IN tbm_ tba_)
  (FORALL tbr_ (IMPLIES (POS-RR tbr_)
     (FORSOME tbf_ (AND (IN (CARD tbf_) NN) (AND (SUBSET tbf_ (PTS tbm_))
       (FORALL tbp_ (IMPLIES (IN tbp_ tba_)
         (FORSOME tbc_ (AND (IN tbc_ tbf_) (< ((DIST tbm_) tbc_ tbp_) tbr_)))))))))))))))
(di)
(dk-iff! (lambda (g) (dk-head-is? g 'FORALL)) w1tb-fwd! w1tb-bwd!)
(qed 'is-totally-bounded-in-classes)

(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m) (cvt-forall '(x z a t)
   (cvt-implies (list '(IN x (VEC m)) '(IN z (VEC m)) '(IN a (VEC m)) '(IN t RR))
     (list '= (cvt-cvx 'z 'a 't) (cvt-add (cvt-cvx 'x 'a 't) (cvt-act '(- 1 t) (cvt-add 'z (cvt-neg 'x)))))))))))
(dk-peel!)
(let* ((c '(- 1 t)) (n1 (cvt-negone 'x)) (cn (list '* c n1))
       (cx (cvt-act c 'x)) (ta (cvt-act 't 'a)) (cz (cvt-act c 'z)) (cnx (cvt-act cn 'x)))
  (dk-real! n1) (dk-real! cn) (dk-real! (list '+ c cn))
  (for-each cvt-type! (list (cvt-add 'z (cvt-neg 'x)) cx ta cz cnx (cvt-act n1 'x) (cvt-add cx ta) (cvt-add cz cnx) (cvt-add cnx cz)
                            (cvt-add cx cnx) (cvt-add ta cz) (cvt-cvx 'z 'a 't)))
  (cvt-rw! 'nvs-act-distrib-vec-rr c 'z (cvt-neg 'x))
  (subst (list '= (cvt-neg 'x) (cvt-act n1 'x)))
  (cvt-rw! 'nvs-act-scale-assoc c n1 'x)
  (cvt-rw! 'nvs-vadd-comm cz cnx)
  (cvt-rw! 'nvs-vadd-shuffle cx cnx ta cz)
  (cvt-rw! 'nvs-act-add-scalars c cn 'x)
  (dk-have! (list '= (list '+ c cn) 0) (lambda () (crs)))
  (subst (list '= (list '+ c cn) 0))
  (cvt-rw! 'nvs-zero-act 'x)
  (cvt-rw! 'nvs-vzero-left (cvt-add ta cz))
  (cvt-rw! 'nvs-vadd-comm ta cz)
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(qed 'convex-combination-shift-point)
(topic! 'convex-combination-shift-point 'algebra)

(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m) (cvt-forall '(f a t tau)
   (cvt-implies (list '(IN f (VEC m)) '(IN a (VEC m)) '(IN t RR) '(IN tau RR))
     (list '= (cvt-cvx 'f 'a 'tau) (cvt-add (cvt-cvx 'f 'a 't) (cvt-act '(- tau t) (cvt-add 'a (cvt-neg 'f)))))))))))
(dk-peel!)
(let* ((c '(- 1 t)) (d '(- tau t)) (n1 (cvt-negone 'f)) (dn (list '* d n1))
       (cf (cvt-act c 'f)) (ta (cvt-act 't 'a)) (da (cvt-act d 'a)) (dnf (cvt-act dn 'f)))
  (dk-real! n1) (dk-real! dn) (dk-real! (list '+ c dn)) (dk-real! (list '+ 't d)) (dk-real! '(- 1 tau))
  (for-each cvt-type! (list (cvt-add 'a (cvt-neg 'f)) cf ta da dnf (cvt-act n1 'f) (cvt-add cf ta) (cvt-add da dnf) (cvt-add dnf da)
                            (cvt-add cf dnf) (cvt-add ta da) (cvt-cvx 'f 'a 'tau)))
  (cvt-rw! 'nvs-act-distrib-vec-rr d 'a (cvt-neg 'f))
  (subst (list '= (cvt-neg 'f) (cvt-act n1 'f)))
  (cvt-rw! 'nvs-act-scale-assoc d n1 'f)
  (cvt-rw! 'nvs-vadd-comm da dnf)
  (cvt-rw! 'nvs-vadd-shuffle cf dnf ta da)
  (cvt-rw! 'nvs-act-add-scalars c dn 'f)
  (cvt-rw! 'nvs-act-add-scalars 't d 'a)
  (dk-have! (list '= (list '+ c dn) '(- 1 tau)) (lambda () (crs)))
  (dk-have! (list '= (list '+ 't d) 'tau) (lambda () (crs)))
  (subst (list '= (list '+ c dn) '(- 1 tau)))
  (subst (list '= (list '+ 't d) 'tau))
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(qed 'convex-combination-shift-coefficient)
(topic! 'convex-combination-shift-coefficient 'algebra)

;;; ---- the distances these give ----
(define cvt-ms '(NVS-METRIC-SPACE m))
(define (cvt-D u v) (list (list 'DIST cvt-ms) u v))
(define (cvt-msetup!)                    ; the metric space of m, and its points are the vectors
  (dk-cite! 'nvs-metric-is-ms 'm)
  (dk-cite! 'nvs-ms-pts 'm))
(define (cvt-pts! v)                     ; v in VEC m: v in PTS of the metric space
  (if (not (dk-asm? (list 'IN v (list 'PTS cvt-ms))))
      (begin (cvt-type! v)
             (dk-rewrite-h! (list 'IN v '(VEC m)) '(VEC m) (list 'PTS cvt-ms)))))
(define (cvt-dreal! u v) (cvt-pts! u) (cvt-pts! v) (dk-cite! 'metric-dist-real cvt-ms u v))

(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m) (cvt-forall '(x z a t)
   (cvt-implies (list '(IN x (VEC m)) '(IN z (VEC m)) '(IN a (VEC m)) '(IN t RR))
     (list '= (cvt-D (cvt-cvx 'x 'a 't) (cvt-cvx 'z 'a 't)) (list '* '(abs (- 1 t)) (cvt-D 'z 'x)))))))))
(dk-peel!)
(cvt-msetup!)
(let* ((w (cvt-add 'z (cvt-neg 'x))) (u (cvt-cvx 'x 'a 't)))
  (for-each cvt-type! (list w u (cvt-act '(- 1 t) w)))
  (cvt-dreal! 'z 'x)
  (dk-real! '(- 1 t)) (dk-cite! 'rr-abs-closed '(- 1 t))
  (dk-cite! 'convex-combination-shift-point 'm 'x 'z 'a 't)
  (subst (list '= (cvt-cvx 'z 'a 't) (cvt-add u (cvt-act '(- 1 t) w))))
  (cvt-rw! 'nvs-dist-shift u (cvt-act '(- 1 t) w))
  (cvt-rw! 'nvs-vnrm-homog '(- 1 t) w)
  (dk-cite! 'nvs-metric-distance 'm 'z 'x)
  (subst (list '= (list '(VNRM m) w) (cvt-D 'z 'x)))
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(qed 'convex-combination-dist-point)
(topic! 'convex-combination-dist-point 'analysis)

(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m) (cvt-forall '(f a t tau)
   (cvt-implies (list '(IN f (VEC m)) '(IN a (VEC m)) '(IN t RR) '(IN tau RR))
     (list '= (cvt-D (cvt-cvx 'f 'a 't) (cvt-cvx 'f 'a 'tau)) (list '* '(abs (- tau t)) (cvt-D 'a 'f)))))))))
(dk-peel!)
(cvt-msetup!)
(let* ((w (cvt-add 'a (cvt-neg 'f))) (u (cvt-cvx 'f 'a 't)))
  (for-each cvt-type! (list w u (cvt-act '(- tau t) w)))
  (cvt-dreal! 'a 'f)
  (dk-real! '(- tau t)) (dk-cite! 'rr-abs-closed '(- tau t))
  (dk-cite! 'convex-combination-shift-coefficient 'm 'f 'a 't 'tau)
  (subst (list '= (cvt-cvx 'f 'a 'tau) (cvt-add u (cvt-act '(- tau t) w))))
  (cvt-rw! 'nvs-dist-shift u (cvt-act '(- tau t) w))
  (cvt-rw! 'nvs-vnrm-homog '(- tau t) w)
  (dk-cite! 'nvs-metric-distance 'm 'a 'f)
  (subst (list '= (list '(VNRM m) w) (cvt-D 'a 'f)))
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(qed 'convex-combination-dist-coefficient)
(topic! 'convex-combination-dist-coefficient 'analysis)

;;; ---- a finite set of vectors lies at bounded distance from a point ----
(define (cvt-bound-of fs mv) (list 'FORALL 'bdf_ (list 'IMPLIES (list 'IN 'bdf_ fs) (list '<= (cvt-D 'a 'bdf_) mv))))
(define cvt-BC (list 'SEP 'bdz_ 'SET (list 'IMPLIES '(SUBSET bdz_ (VEC m))
                 (list 'FORSOME 'bdm_ (list 'AND '(IN bdm_ RR) (list 'AND '(<= 0 bdm_) (cvt-bound-of 'bdz_ 'bdm_)))))))
(define (cvt-union-in! z A B left?)
  (let ((iff (dk-cite! 'union-membership A B z)))
    (dk-have! (caddr iff) (lambda () (if left? (oi-l) (oi-r)) (cvt-ass!)))
    (dk-meta-iff-l! iff)))
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m) (cvt-forall '(a F)
   (cvt-implies (list '(IN a (VEC m)) '(IN F SET) '(IN (CARD F) NN) '(SUBSET F (VEC m)))
     (list 'FORSOME 'bnd (list 'AND '(IN bnd RR) (list 'AND '(<= 0 bnd) (cvt-bound-of 'F 'bnd))))))))))
(dk-peel!)
(cvt-msetup!)
(define cvt-ind
  (let ((ind0 (lookup-theorem 'finite-set-induction)))
    (subst-free (quantifier-var ind0) cvt-BC (quantifier-body ind0))))
(define cvt-hbase (cadr (cadr cvt-ind)))
(define cvt-hstep (caddr (cadr cvt-ind)))
(dk-have! cvt-hbase
  (lambda ()
    (in-sep! (lambda () (fact 'empty-set-is-set) (cvt-ass!))
             (lambda ()
               (di)
               (fact 'rr-zero-in)
               (ew 0)
               (dk-conj-close!
                (lambda ()
                  (cond ((dk-head-is? (dk-goal) 'FORALL)
                         (let ((u (cvt-peel-var!))) (ai (dk-cite! 'empty-set-has-no-members u))))
                        ((dk-asm? (dk-goal)) (ass))
                        (#t (dk-ineq!)))))))))
(dk-have! cvt-hstep
  (lambda ()
    (dk-split-all! (filter (lambda (f) (dk-head-is? f 'AND)) (dk-peel!)))
    (let* ((gl (dk-goal)) (u (cadr gl)) (s0 (cadr u)) (pxx (caddr u)) (x0 (cadr pxx))
           (ih (begin (dk-landed (lambda () (sep-me (list 'IN s0 cvt-BC))))
                      (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (equal? (cadr f) (list 'SUBSET s0 '(VEC m)))))
                               "the class property of the smaller set"))))
      (in-sep!
        (lambda ()
          (dk-meta-and! (list 'IN x0 'SET) (list 'IN x0 'SET))
          (dk-cite! 'pairing x0 x0)
          (dk-meta-and! (list 'IN s0 'SET) (list 'IN pxx 'SET))
          (dk-cite! 'union-set-closure s0 pxx)
          (cvt-ass!))
        (lambda ()
          (di)
          (dk-cite! 'pair-self-member x0)
          (cvt-union-in! x0 s0 pxx #f)
          (dk-cite! 'subset-mem-fwd u '(VEC m) x0)
          (dk-have! (list 'SUBSET s0 '(VEC m))
            (lambda () (mac 'subset-def)
                       (let ((z (cvt-peel-var!)))
                         (cvt-union-in! z s0 pxx #t)
                         (dk-cite! 'subset-mem-fwd u '(VEC m) z)
                         (cvt-ass!))))
          (detach! ih)
          (let* ((mv (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h s0))) "the bound of the smaller set")))
                 (_ (cvt-split-if! (lambda (h) (dk-contains? h mv))))
                 (_2 (cvt-split-if! (lambda (h) (dk-contains? h mv))))
                 (dx (cvt-D 'a x0))
                 (mm (list '+ mv dx)))
            (cvt-dreal! 'a x0)
            (dk-cite! 'metric-pos cvt-ms 'a x0)
            (dk-real! mm)
            (ew mm)
            (dk-conj-close!
             (lambda ()
               (cond
                ((dk-head-is? (dk-goal) 'FORALL)
                 (let ((w (cvt-peel-var!)))
                   (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'union-membership s0 pxx w))))
                   (use-em (list 'IN w s0)
                     (lambda ()
                       (dk-apply! (dk-ctx-form (cvt-bound-of s0 mv)) w)
                       (dk-cite! 'subset-mem-fwd s0 '(VEC m) w)
                       (cvt-dreal! 'a w)
                       (dk-ineq! (list '<= (cvt-D 'a w) mv) (list '<= 0 dx)))
                     (lambda ()
                       (dk-have! (list 'IN w pxx) (lambda () (if (dk-only! (list 'OR (list 'IN w s0) (list 'IN w pxx)) (list 'NOT (list 'IN w s0))) (prop))))
                       (dk-cite! 'pair-self-eq x0 w)
                       (subst (list '= w x0))
                       (dk-ineq! (list '<= 0 mv))))))
                ((dk-asm? (dk-goal)) (ass))
                (#t (dk-ineq! (list '<= 0 mv) (list '<= 0 dx))))))))))))
(dk-meta-and! cvt-hbase cvt-hstep)
(dk-cite! 'finite-set-induction cvt-BC)
(dk-meta-and! '(IN F SET) '(IN (CARD F) NN))
(dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h cvt-BC) (not (dk-contains? h 'EMPTY-SET)))) "the induction conclusion") 'F)
(dk-landed (lambda () (sep-me (list 'IN 'F cvt-BC))))
(detach! (dk-pick (lambda (h) (and (dk-head-is? h 'IMPLIES) (equal? (cadr h) '(SUBSET F (VEC m))))) "the property of F"))
(cvt-ass!)
(qed 'finite-set-bounded-distance)
(topic! 'finite-set-bounded-distance 'analysis)

;;; ---- the estimate behind the net of a join ----
(define (cvt-lmul! c x y)                ; 0 <= c, x <= y, all real: (* c x) <= (* c y)
  (dk-real! (list '* c x)) (dk-real! (list '* c y)) (dk-real! (list '* x c)) (dk-real! (list '* y c))
  (dk-cite! 'rr-mul-le-right x y c)
  (dk-have! (list '= (list '* x c) (list '* c x)) (lambda () (crs)))
  (dk-have! (list '= (list '* y c) (list '* c y)) (lambda () (crs)))
  (dk-rewrite-h! (list '<= (list '* x c) (list '* y c)) (list '* x c) (list '* c x))
  (dk-rewrite-h! (list '<= (list '* c x) (list '* y c)) (list '* y c) (list '* c y)))
(define (cvt-rmul! x y c)                ; x <= y, 0 <= c: (* x c) <= (* y c)
  (dk-real! (list '* x c)) (dk-real! (list '* y c))
  (dk-cite! 'rr-mul-le-right x y c))
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IS-NORMED-VECTOR-SPACE m) (cvt-forall '(y f a t tau rho dl bnd)
   (cvt-implies (append (list '(IN y (VEC m)) '(IN f (VEC m)) '(IN a (VEC m))) (cvt-unit 't)
                        (list '(IN tau RR) '(<= tau t) '(< t (+ tau dl)) '(IN rho RR) '(IN dl RR) '(IN bnd RR) '(<= 0 dl)
                              (list '< (cvt-D 'f 'y) 'rho) (list '<= (cvt-D 'a 'f) 'bnd)))
     (list '< (cvt-D (cvt-cvx 'f 'a 'tau) (cvt-cvx 'y 'a 't)) '(+ rho (* dl bnd)))))))))
(dk-peel!)
(cvt-msetup!)
(let* ((c (cvt-cvx 'f 'a 'tau)) (q (cvt-cvx 'f 'a 't)) (p (cvt-cvx 'y 'a 't))
       (dcq (cvt-D c q)) (dqp (cvt-D q p)) (dcp (cvt-D c p))
       (dyf (cvt-D 'y 'f)) (dfy (cvt-D 'f 'y)) (daf (cvt-D 'a 'f))
       (at '(abs (- t tau))) (a1 '(abs (- 1 t))))
  (for-each cvt-pts! (list c q p 'y 'f 'a))
  (for-each (lambda (uv) (cvt-dreal! (car uv) (cadr uv))) (list (list c q) (list q p) (list c p) (list 'y 'f) (list 'f 'y) (list 'a 'f)))
  (dk-cite! 'metric-triangle cvt-ms c q p)
  (dk-cite! 'convex-combination-dist-coefficient 'm 'f 'a 'tau 't)
  (dk-cite! 'convex-combination-dist-point 'm 'f 'y 'a 't)
  (dk-cite! 'metric-sym cvt-ms 'y 'f)
  (dk-cite! 'metric-pos cvt-ms 'a 'f)
  (dk-cite! 'metric-pos cvt-ms 'y 'f)
  (dk-real! '(- t tau)) (dk-real! '(- 1 t))
  (dk-have! '(<= 0 (- t tau)) (lambda () (dk-ineq! '(<= tau t))))
  (dk-have! '(<= 0 (- 1 t)) (lambda () (dk-ineq! '(<= t 1))))
  (dk-cite! 'rr-abs-of-nonneg '(- t tau))
  (dk-cite! 'rr-abs-of-nonneg '(- 1 t))
  (dk-cite! 'rr-abs-closed '(- t tau)) (dk-cite! 'rr-abs-closed '(- 1 t))
  (dk-have! (list '<= at 'dl) (lambda () (subst (list '= at '(- t tau))) (dk-ineq! '(< t (+ tau dl)))))
  (dk-have! (list '<= a1 1) (lambda () (subst (list '= a1 '(- 1 t))) (dk-ineq! '(<= 0 t))))
  (fact 'rr-one-in)
  (cvt-rmul! at 'dl daf)
  (cvt-rmul! a1 1 dyf)
  (cvt-lmul! 'dl daf 'bnd)
  (dk-real! (list '* 1 dyf))
  (dk-have! (list '= (list '* 1 dyf) dyf) (lambda () (crs)))
  (dk-ineq! (list '<= dcp (list '+ dcq dqp)) (list '= dcq (list '* at daf)) (list '= dqp (list '* a1 dyf))
            (list '<= (list '* at daf) (list '* 'dl daf)) (list '<= (list '* 'dl daf) '(* dl bnd))
            (list '<= (list '* a1 dyf) (list '* 1 dyf)) (list '= (list '* 1 dyf) dyf) (list '= dyf dfy) (list '< dfy 'rho)))
