;;; me-rn.scm -- THE RADON-NIKODYM THEOREM (construction-of-measures.pdf Thm 3.10), the converse, by von Neumann's
;;; Hilbert-space proof (the notes' proof).  Agent M-D (M-E), worker-02, 2026-10-28.
;;; DESTINATION: theorem-library/radon-nikodym.scm (beside md-rn.scm's easy direction).  Library: measure.
;;; Helper prefix: mrn-.  Load window: after me-l2.scm, me-rz.scm (sip-riesz-representation), real-integral.scm.

(define (mrn-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MRN OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mrn-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (mrn-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define (mrn-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define (mrn-split! c)
  (if (and (pair? c) (eq? (car c) 'AND) (dk-asm? (cadr c)) (dk-asm? (caddr c))) c (dk-split! c)))
(define (mrn-has-lam? g)
  (and (pair? g)
       (or (and (pair? (car g)) (eq? (caar g) 'VNB-LAMBDA))
           (let loop ((l g)) (and (pair? l) (or (mrn-has-lam? (car l)) (loop (cdr l))))))))
(define (mrn-beta!) (if (mrn-has-lam? (dk-goal)) (dk-lam-b!)))
(define (mrn-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (mrn-rps! t) (if (not (dk-asm? (list 'IN t 'RR-POS-STAR))) (dk-cite! 'rmc-rps-of-nonneg t)))
(define (mrn-tsub x y t) (cond ((equal? t x) y) ((pair? t) (map (lambda (u) (mrn-tsub x y u)) t)) (#t t)))
(define mrn-le '(FORALL mma_ (IMPLIES (IN mma_ ca) (<= (mu mma_) (nu mma_)))))
(define (mrn-meas-setup!)
  (dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measure '(IS-MEASURE omega ca mu))
  (dk-project! '(IN mu (FUN ca RR-POS-STAR)) 'is-measure '(IS-MEASURE omega ca mu))
  (dk-project! '(IN nu (FUN ca RR-POS-STAR)) 'is-measure '(IS-MEASURE omega ca nu))
  (dk-cite! 'sigma-algebra-ambient-set 'omega 'ca))

;;; ===========================================================================
;;; (1) mu <= nu on sets gives mu-integrals <= nu-integrals ((47) of the notes)
;;; ===========================================================================
(define (mrn-si m) (list 'SIMPLE-INTEGRAL 'omega m 's))
(sp (make-wff (mrn-alls '(omega ca mu nu s) (mrn-imps (list '(IS-MEASURE omega ca mu) '(IS-MEASURE omega ca nu) mrn-le '(IS-SIMPLE-FN omega ca s))
   (list '<= (mrn-si 'mu) (mrn-si 'nu))))))
(dk-peel!)
(mrn-meas-setup!)
(dk-project! '(IS-MEASURABLE-FN omega ca s) 'is-simple-fn '(IS-SIMPLE-FN omega ca s))
(dk-project! '(IN (CARD (IMAGE s omega)) NN) 'is-simple-fn '(IS-SIMPLE-FN omega ca s))
(dk-project! '(FORALL x_ (IMPLIES (IN x_ omega) (IN (s x_) RR))) 'is-simple-fn '(IS-SIMPLE-FN omega ca s))
(dk-project! '(IN s (FUN omega RR-POS-STAR)) 'is-measurable-fn '(IS-MEASURABLE-FN omega ca s))
(dk-cite! 'image-set 's 'omega)
(define mrn-R '(IMAGE s omega))
(define (mrn-lam m) (list 'VNB-LAMBDA 'siy_ mrn-R (list 'etimes 'siy_ (list m '(SEP six_ omega (= (s six_) siy_))))))
(subst (dk-cite! 'simple-integral-unfold 'omega 'mu 's))
(subst (dk-cite! 'simple-integral-unfold 'omega 'nu 's))
(dk-cite! 'image-subset-codomain 'omega 'RR-POS-STAR 's)
(dk-cite! 'measurable-fn-level-set 'omega 'ca 's)
(define (mrn-zv! z)                    ; z in R: z real in RPS, its level set in ca, the lambda values; returns (vmu . vnu)
  (dk-apply! (dk-ctx-form '(FORALL w (IMPLIES (IN w (IMAGE s omega)) (IN w RR-POS-STAR)))) z)
  (let* ((lev (list 'SEP 'six_ 'omega (list '= '(s six_) z)))
         (vm (list 'etimes z (list 'mu lev))) (vn (list 'etimes z (list 'nu lev))))
    ;; z is real: it is a value of s
    (if (not (dk-asm? (list 'IN z 'RR)))
        (dk-have! (list 'IN z 'RR)
          (lambda ()
            (let* ((ex (dk-image-hyp! (list 'IN z mrn-R))) (x (dk-skolem! ex #t)))
              (dk-apply! (dk-ctx-form '(FORALL x_ (IMPLIES (IN x_ omega) (IN (s x_) RR)))) x)
              (subst (list '= z (list 's x))) (dk-ass!)))))
    (dk-apply! (dk-ctx-form '(FORALL a (IMPLIES (IN a RR) (IN (SEP gx_ omega (= (s gx_) a)) ca)))) z)
    (dk-have! (list 'IN lev 'ca) (lambda () (dk-ass!)))
    (dk-cite! 'fun-apply-type-c 'mu 'ca 'RR-POS-STAR lev)
    (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-POS-STAR lev)
    (dk-apply! (dk-ctx-form mrn-le) lev)
    (mrn-and! (list 'IN z 'RR-POS-STAR) (list 'IN (list 'mu lev) 'RR-POS-STAR))
    (dk-cite! 'etimes-closed z (list 'mu lev))
    (mrn-and! (list 'IN z 'RR-POS-STAR) (list 'IN (list 'nu lev) 'RR-POS-STAR))
    (dk-cite! 'etimes-closed z (list 'nu lev))
    (for-each (lambda (m v)
                (let ((e (list '= (list (mrn-lam m) z) v)))
                  (if (not (dk-asm? e))
                      (begin
                        (if (not (dk-asm? (list 'IN lev 'SET))) (dk-have! (list 'IN lev 'SET) (lambda () (dk-sethood! lev))))
                        (dk-have! e (lambda () (mrn-beta!) (if (mrn-open?) (rfl))))))))
              (list 'mu 'nu) (list vm vn))
    (cons vm vn)))
(define (mrn-ptw prop) (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ mrn-R) prop)))
(for-each
  (lambda (m)
    (dk-have! (mrn-ptw (list 'IN (list (mrn-lam m) 'z_) 'RR-POS-STAR))
      (lambda () (let* ((z (dk-di-var!)) (vv (mrn-zv! z)) (v (if (eq? m 'mu) (car vv) (cdr vv))))
                   (subst (list '= (list (mrn-lam m) z) v)) (dk-ass!)))))
  '(mu nu))
(dk-have! (mrn-ptw (list '<= (list (mrn-lam 'mu) 'z_) (list (mrn-lam 'nu) 'z_)))
  (lambda () (let* ((z (dk-di-var!)) (vv (mrn-zv! z)))
               (subst (list '= (list (mrn-lam 'mu) z) (car vv)))
               (subst (list '= (list (mrn-lam 'nu) z) (cdr vv)))
               (dk-cite! 'rr-pos-star-le-refl z)
               (let ((lev (list 'SEP 'six_ 'omega (list '= '(s six_) z))))
                 (dk-cite! 'etimes-mono-star z z (list 'mu lev) (list 'nu lev)))
               (dk-ass!))))
(dk-cite! 'rps-finsum-le-ptwise mrn-R (mrn-lam 'mu) (mrn-lam 'nu))
(dk-ass!)
(mrn-qed! 'simple-integral-measure-le)

;;; the integral of a measurable [0, +inf] function
(define (mrn-I m) (list 'INTEGRAL 'omega 'ca m 'h))
(sp (make-wff (mrn-alls '(omega ca mu nu h) (mrn-imps (list '(IS-MEASURE omega ca mu) '(IS-MEASURE omega ca nu) mrn-le '(IS-MEASURABLE-FN omega ca h))
   (list '<= (mrn-I 'mu) (mrn-I 'nu))))))
(dk-peel!)
(mrn-meas-setup!)
(let* ((um (dk-cite! 'integral-unfold 'omega 'ca 'mu 'h)) (un (dk-cite! 'integral-unfold 'omega 'ca 'nu 'h))
       (sm (cadr (caddr um))) (sn (cadr (caddr un))))
  (subst um) (subst un)
  (define (sub! st)
    (dk-have! (list 'SUBSET st 'RR-POS-STAR)
      (lambda () (mac 'subset-def)
                 (let ((y (dk-di-var!))) (sep-me (dk-ctx-form (list 'IN y st))) (dk-split-all!) (dk-ass!)))))
  (sub! sm) (sub! sn)
  (dk-cite! 'esup-in sn)
  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x sm) (list '<= 'x (list 'ESUP sn))))
    (lambda ()
      (let* ((y (dk-di-var!)))
        (sep-me (dk-ctx-form (list 'IN y sm)))
        (dk-split-all!)
        (let* ((ex (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the simple function"))
               (sf (dk-skolem! ex #t))
               (vm (list 'SIMPLE-INTEGRAL 'omega 'mu sf)) (vn (list 'SIMPLE-INTEGRAL 'omega 'nu sf)))
          (dk-cite! 'simple-integral-in 'omega 'ca 'mu sf)
          (dk-cite! 'simple-integral-in 'omega 'ca 'nu sf)
          (dk-cite! 'simple-integral-measure-le 'omega 'ca 'mu 'nu sf)
          (dk-have! (list 'IN vn sn)
            (lambda () (in-sep! (lambda () (dk-ass!))
                         (lambda () (ew sf) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))
          (dk-cite! 'esup-upper sn vn)
          (subst (list '= y vm))
          (mrn-and! (list 'IN vm 'RR-POS-STAR) (list 'IN vn 'RR-POS-STAR) (list 'IN (list 'ESUP sn) 'RR-POS-STAR))
          (mrn-and! (list '<= vm vn) (list '<= vn (list 'ESUP sn)))
          (dk-cite! 'rr-pos-star-le-trans vm vn (list 'ESUP sn))
          (dk-ass!)))))
  (mrn-and! (list 'IN (list 'ESUP sn) 'RR-POS-STAR) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x sm) (list '<= 'x (list 'ESUP sn)))))
  (dk-cite! 'esup-least sm (list 'ESUP sn))
  (dk-ass!))
(mrn-qed! 'integral-measure-le)

;;; ===========================================================================
;;; (2) for a finite measure, L^2 functions are integrable:  int |g| <= nu(omega)^{1/2} <g, g>^{1/2}
;;; ===========================================================================
;; ||ABS-FN g||_p = ||g||_p
(sp (make-wff (mrn-alls '(omega ca mu p g) (mrn-imps '((IS-MEASURE omega ca mu) (IS-REAL-MEASURABLE-FN omega ca g))
   '(== (LP-NORM omega ca mu p (ABS-FN omega g)) (LP-NORM omega ca mu p g))))))
(dk-peel!)
(let* ((a '(ABS-FN omega g)) (aa (list 'ABS-FN 'omega a)))
  (dk-project! '(IN g (FUN omega RR)) 'is-real-measurable-fn '(IS-REAL-MEASURABLE-FN omega ca g))
  (dk-cite! 'abs-fn-real-measurable 'omega 'ca 'mu 'g)
  (dk-project! (list 'IN a '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca a))
  (dk-cite! 'abs-fn-real-measurable 'omega 'ca 'mu a)
  (dk-project! (list 'IN aa '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca aa))
  (let ((fi (lambda (f) (let ((c (dk-cite! 'fun-codomain-iff 'omega 'RR f)))
                          (dk-have! (caddr c) (lambda () (if (dk-only! c (list 'IN f '(FUN omega RR))) (prop))))
                          (mrn-split! (caddr c))))))
    (fi aa) (fi a))
  (dk-have! (list 'FORALL 'mdtz_ (list 'IMPLIES '(IN mdtz_ omega) (list '= (list aa 'mdtz_) (list a 'mdtz_))))
    (lambda ()
      (let ((x (dk-di-var!)))
        (dk-cite! 'fun-apply-type-c a 'omega 'RR x)
        (dk-cite! 'fun-apply-type-c 'g 'omega 'RR x)
        (dk-cite! 'abs-fn-value 'omega a x)
        (dk-cite! 'abs-fn-value 'omega 'g x)
        (dk-cite! 'rr-abs-nonneg (list 'g x))
        (dk-have! (list '<= 0 (list a x)) (lambda () (subst (list '== (list a x) (list 'abs (list 'g x)))) (dk-ass!)))
        (dk-cite! 'rr-abs-of-nonneg (list a x))
        (subst (list '== (list aa x) (list 'abs (list a x))))
        (dk-ass!))))
  (dk-cite! 'fun-domain-extensionality 'omega aa a)
  (subst (dk-cite! 'lp-norm-unfold 'omega 'ca 'mu 'p a))
  (subst (dk-cite! 'lp-norm-unfold 'omega 'ca 'mu 'p 'g))
  (subst (list '= aa a))
  (if (mrn-open?) (qrfl)))
(mrn-qed! 'lp-norm-abs-fn)

(define mrn-LS '(L2-SPACE omega ca nu))
(define mrn-L2 '(L2-SET omega ca nu))
(define mrn-one '(VNB-LAMBDA cx_ omega 1))
(define (mrn-prod x y) (list 'VNB-LAMBDA 'lx_ 'omega (list '* (list x 'lx_) (list y 'lx_))))
(define (mrn-rip x y) (list (list 'RIP mrn-LS) x y))
(define (mrn-rint m h) (list 'RINTEGRAL 'omega 'ca m h))
(define (mrn-rip! x y)                 ; x, y in L2: (= <x,y> (RINTEGRAL nu (x y)))
  (let ((e (list '= (mrn-rip x y) (mrn-rint 'nu (mrn-prod x y)))))
    (if (not (dk-asm? e))
        (let ((r1 (dk-cite! 'l2-space-RIP 'omega 'ca 'nu)) (r2 (dk-cite! 'l2-rip-value 'omega 'ca 'nu x y)))
          (dk-have! e (lambda () (subst r1) (subst r2) (if (mrn-open?) (rfl))))))
    e))
(define (mrn-fun1! f cod)
  (if (not (dk-asm? (list 'IN f '(FUN omega))))
      (let ((fi (dk-cite! 'fun-codomain-iff 'omega cod f)))
        (dk-have! (caddr fi) (lambda () (if (dk-only! fi (list 'IN f (list 'FUN 'omega cod))) (prop))))
        (mrn-split! (caddr fi)))))
(define (mrn-funext! f g cf cg pt!)
  (mrn-fun1! f cf) (mrn-fun1! g cg)
  (dk-have! (list 'FORALL 'mdtz_ (list 'IMPLIES '(IN mdtz_ omega) (list '= (list f 'mdtz_) (list g 'mdtz_))))
    (lambda () (let ((x (dk-di-var!))) (pt! x))))
  (dk-cite! 'fun-domain-extensionality 'omega f g))
(define mrn-a '(ABS-FN omega g))
(define mrn-Ia (list 'INTEGRAL 'omega 'ca 'nu mrn-a))
(define mrn-Rgg (mrn-rip 'g 'g))
(sp (make-wff (mrn-alls '(omega ca nu g) (mrn-imps (list '(IS-MEASURE omega ca nu) '(IN (nu omega) RR) (list 'IN 'g mrn-L2))
   (list 'AND '(IS-INTEGRABLE omega ca nu g)
              (list '<= mrn-Ia (list '* (list 'SQRT mrn-Rgg) '(SQRT (nu omega)))))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'nn-one-in)
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-have! '(IN 2 RR) (lambda () (arith)))
(dk-have! '(< 0 2) (lambda () (dk-ineq!)))
(dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measure '(IS-MEASURE omega ca nu))
(dk-project! '(IN nu (FUN ca RR-POS-STAR)) 'is-measure '(IS-MEASURE omega ca nu))
(dk-cite! 'sigma-algebra-ambient-set 'omega 'ca)
(dk-cite! 'sigma-algebra-whole-in 'omega 'ca)
(dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-POS-STAR 'omega)
(dk-cite! 'rr-pos-star-nonneg '(nu omega))
(dk-cite! 'l2-space-is-sip 'omega 'ca 'nu)
(dk-cite! 'l2-space-VEC 'omega 'ca 'nu)
(dk-split-all! (list (dk-cite! 'l2-out 'omega 'ca 'nu 'g)))
;; |g| in L^2
(dk-cite! 'abs-fn-real-measurable 'omega 'ca 'nu 'g)
(dk-project! (list 'IN mrn-a '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca mrn-a))
(dk-cite! 'lp-norm-abs-fn 'omega 'ca 'nu 2 'g)
(let ((ig (dk-cite! 'l2-iff-lp2-finite 'omega 'ca 'nu 'g)) (ia (dk-cite! 'l2-iff-lp2-finite 'omega 'ca 'nu mrn-a)))
  (dk-have! '(IN (LP-NORM omega ca nu 2 g) RR) (lambda () (if (dk-only! ig (list 'IN 'g mrn-L2)) (prop))))
  (dk-have! (list 'IN (list 'LP-NORM 'omega 'ca 'nu 2 mrn-a) 'RR) (lambda () (subst (list '== (list 'LP-NORM 'omega 'ca 'nu 2 mrn-a) '(LP-NORM omega ca nu 2 g))) (dk-ass!)))
  (dk-have! (list 'IN mrn-a mrn-L2) (lambda () (if (dk-only! ia (list 'IN (list 'LP-NORM 'omega 'ca 'nu 2 mrn-a) 'RR)) (prop)))))
;; the constant 1 in L^2
(dk-cite! 'real-measurable-const 'omega 'ca 1)
(dk-project! (list 'IN mrn-one '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca mrn-one))
(define mrn-ind '(INDICATOR omega omega))
