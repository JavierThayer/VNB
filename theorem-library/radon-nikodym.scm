;;; md-rn.scm -- construction-of-measures.pdf Theorem 3.10 (Radon-Nikodym): the "if" direction -- a measure with a
;;; density is absolutely continuous.  (The converse is blocked: see M-D-REPORT.md.)
;;; Agent M-D (worker-02), 2026-10-28.  DESTINATION: theorem-library/radon-nikodym.scm.  Library: measure.
;;; Helper prefix: mdr-.  Load window: after integral-laws.scm, md-vocab.scm.

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (mdr-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MDR OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mdr-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define mdr-dens '(FORALL rna_ (IMPLIES (IN rna_ ca) (= (mu rna_) (INTEGRAL omega ca nu (PTWISE-ETIMES omega f (INDICATOR omega rna_)))))))
(define mdr-Z '(VNB-LAMBDA cx_ omega 0))
(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'ca (list 'FORALL 'mu (list 'FORALL 'nu (list 'FORALL 'f
  (list 'IMPLIES '(IS-MEASURE omega ca mu) (list 'IMPLIES '(IS-MEASURE omega ca nu) (list 'IMPLIES '(IS-MEASURABLE-FN omega ca f)
    (list 'IMPLIES mdr-dens '(IS-ABSOLUTELY-CONTINUOUS omega ca mu nu))))))))))))
(dk-peel!)
(dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measure '(IS-MEASURE omega ca nu))
(mac 'is-absolutely-continuous)
(let* ((ld (dk-peel!)) (a (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'ca))) ld)))
       (h (list 'PTWISE-ETIMES 'omega 'f (list 'INDICATOR 'omega a))))
  (dk-apply! (dk-ctx-form mdr-dens) a)
  (dk-cite! 'measurable-fn-indicator 'omega 'ca a)
  (dk-cite! 'measurable-fn-etimes 'omega 'ca 'f (list 'INDICATOR 'omega a))
  (fact 'rr-zero-in) (dk-have! '(<= 0 0) (lambda () (dk-ineq!))) (dk-cite! 'rmc-rps-of-nonneg 0)
  (dk-cite! 'measurable-fn-const 'omega 'ca 0)
  (dk-cite! 'integral-zero-fn 'omega 'ca 'nu)
  (dk-project! '(IN f (FUN omega RR-POS-STAR)) 'is-measurable-fn '(IS-MEASURABLE-FN omega ca f))
  (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'NOT (list 'IN 'x a)) (list '<= (list h 'x) (list mdr-Z 'x)))))
    (lambda ()
      (let ((x (dk-di-var!)))
        (di)
        (dk-cite! 'indicator-value-out 'omega a x)
        (dk-cite! 'fun-apply-type-c 'f 'omega 'RR-POS-STAR x)
        (dk-cite! 'etimes-zero-right (list 'f x))
        (dk-have! (list '= (list mdr-Z x) 0) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
        (dk-have! (list '= (list h x) 0)
          (lambda () (mac 'PTWISE-ETIMES) (dk-lam-b!)
                     (subst (list '= (list (list 'INDICATOR 'omega a) x) 0))
                     (subst (list '= (list 'etimes (list 'f x) 0) 0))
                     (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
        (subst (list '= (list h x) 0)) (subst (list '= (list mdr-Z x) 0))
        (dk-ass!))))
  (let ((le (dk-cite! 'integral-le-off-null 'omega 'ca 'nu a h mdr-Z)))
    (dk-rewrite-h! le (list 'INTEGRAL 'omega 'ca 'nu mdr-Z) 0))
  (dk-cite! 'integral-in 'omega 'ca 'nu h)
  (dk-project! '(IN mu (FUN ca RR-POS-STAR)) 'is-measure '(IS-MEASURE omega ca mu))
  (dk-cite! 'fun-apply-type-c 'mu 'ca 'RR-POS-STAR a)
  (subst (list '= (list 'mu a) (list 'INTEGRAL 'omega 'ca 'nu h)))
  (dk-cite! 'rr-pos-star-nonneg (list 'INTEGRAL 'omega 'ca 'nu h))
  (let ((mi (dk-cite! 'rr-pos-star-membership (list 'INTEGRAL 'omega 'ca 'nu h))))
    (dk-have! (caddr mi) (lambda () (if (dk-only! mi (list 'IN (list 'INTEGRAL 'omega 'ca 'nu h) 'RR-POS-STAR)) (prop))))
    (use-em (list 'IN (list 'INTEGRAL 'omega 'ca 'nu h) 'RR)
      (lambda () (dk-ineq! (list 'IN (list 'INTEGRAL 'omega 'ca 'nu h) 'RR) (list '<= 0 (list 'INTEGRAL 'omega 'ca 'nu h)) (list '<= (list 'INTEGRAL 'omega 'ca 'nu h) 0)))
      (lambda ()
        (dk-have! (list '= (list 'INTEGRAL 'omega 'ca 'nu h) 'POS-INF) (lambda () (if (dk-only! (caddr mi) (list 'NOT (list 'IN (list 'INTEGRAL 'omega 'ca 'nu h) 'RR))) (prop))))
        (fact 'rr-zero-in)
        (dk-cite! 'pos-inf-above-reals 0)
        (dk-have! '(<= POS-INF 0) (lambda () (subst (list '= 'POS-INF (list 'INTEGRAL 'omega 'ca 'nu h))) (dk-ass!)))
        (pbc) (ai '(NOT (<= POS-INF 0)))))))
(mdr-qed! 'density-implies-absolutely-continuous)

