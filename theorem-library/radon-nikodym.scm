(define mr3-cl (list 'VNB-LAMBDA 'cn_ 'NN (list 'INTERSECTION (list mr3-a 'cn_) (list mr3-b 'cn_))))
(dk-have! (list 'IN mr3-cl '(FUN NN ca))
  (lambda () (dk-lam-type! (lambda () (let ((n (dk-di-var!)))
                                        (mr3-beta!)
                                        (mr3-ab! n)
                                        (dk-cite! 'sigma-algebra-inter-closed-2 'omega 'ca (list mr3-a n) (list mr3-b n))
                                        (mr3-close-ass!)))
                           (lambda () (dk-ass!)))))
(define mr3-c (dk-name! mr3-cl '(FUN NN ca)))
(define (mr3-cv! n)                    ; n in NN: (= (c n) (INTERSECTION (a n) (b n))), (c n) in ca
  (let ((e (list '= (list mr3-c n) (list 'INTERSECTION (list mr3-a n) (list mr3-b n)))))
    (if (not (dk-asm? e))
        (begin
          (mr3-ab! n)
          (dk-cite! 'fun-apply-type-c mr3-c 'NN 'ca n)
          (dk-cite! 'sigma-algebra-inter-closed-2 'omega 'ca (list mr3-a n) (list mr3-b n))
          (dk-have! e (lambda () (subst (list '= mr3-c mr3-cl)) (mr3-beta!) (if (mr3-open?) (rfl))))))
    e))
(define (mr3-c-in! z n)                ; (IN z (c n)): lands (IN z (a n)), (IN z (b n)); never closes the focus
  (mr3-cv! n)
  (let* ((int (list 'INTERSECTION (list mr3-a n) (list mr3-b n)))
         (h2 (dk-rewrite-h! (dk-ctx-form (list 'IN z (list mr3-c n))) (list mr3-c n) int))
         (conj (list 'AND (list 'IN z (list mr3-a n)) (list 'IN z (list mr3-b n)))))
    (if (not (and (dk-asm? (cadr conj)) (dk-asm? (caddr conj))))
        (let ((iff (dk-cite! 'intersection-membership (list mr3-a n) (list mr3-b n) z)))
          (if (not (dk-asm? conj)) (dk-have! conj (lambda () (if (dk-only! iff h2) (prop)))))
          (dk-split! conj)))))
(define (mr3-c-out! z n)               ; (IN z (a n)), (IN z (b n)): lands (IN z (c n))
  (mr3-cv! n)
  (dk-have! (list 'IN z (list mr3-c n))
    (lambda () (subst (mr3-cv! n)) (mac 'intersection-membership) (dk-conj-close! (lambda () (dk-ass!))))))
;; c covers omega
(define mr3-incr-a (list 'FORALL 'sfn_ (list 'IMPLIES '(IN sfn_ NN) (list 'SUBSET (list mr3-a 'sfn_) (list mr3-a '(succ sfn_))))))
(define mr3-incr-b (list 'FORALL 'sfn_ (list 'IMPLIES '(IN sfn_ NN) (list 'SUBSET (list mr3-b 'sfn_) (list mr3-b '(succ sfn_))))))
(define (mr3-sets! f)
  (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IN (list f 'k) 'SET)))
    (lambda () (let ((k (dk-di-var!)))
                 (dk-cite! 'fun-apply-type-c f 'NN 'ca k)
                 (dk-cite! 'membership-implies-sethood (list f k) 'ca)
                 (mr3-close-ass!)))))
(mr3-sets! mr3-a) (mr3-sets! mr3-b)
(define mr3-bua (list 'BIG-UNION 'sfk_ 'NN (list mr3-a 'sfk_)))
(define mr3-bub (list 'BIG-UNION 'sfk_ 'NN (list mr3-b 'sfk_)))
(define mr3-buc (list 'BIG-UNION 'n_ 'NN (list mr3-c 'n_)))
(define (mr3-bu-open! w bu)            ; consume (IN w bu): (index . membership)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (eq? (car f) 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
(define (mr3-bu-in! e)
  (for-each (lambda (n) (dk-focus! n) (ass)) (dk-opened (lambda () (bu-mi e)))))
(mr3-class-ext! mr3-buc 'omega
  (lambda (z)
    (let* ((op (mr3-bu-open! z mr3-buc)) (n (car op)))
      (mr3-c-in! z n)
      (mr3-in-omega! (list mr3-a n) z)
      (mr3-close-ass!)))
  (lambda (z)
    (dk-rewrite-h! (dk-ctx-form (list 'IN z 'omega)) 'omega mr3-bua)
    (let* ((i (car (mr3-bu-open! z mr3-bua))))
      (dk-rewrite-h! (dk-ctx-form (list 'IN z 'omega)) 'omega mr3-bub)
      (let* ((j (car (mr3-bu-open! z mr3-bub)))
             (kk (list '+ i j)))
        (mr3-and! (list 'IN i 'NN) (list 'IN j 'NN))
        (dk-cite! 'nn-add-closed i j)
        (mr3-ab! i) (mr3-ab! j) (mr3-ab! kk)
        (dk-have! (list '<= i kk) (lambda () (dk-nn!)))
        (dk-have! (list '<= j kk) (lambda () (dk-nn!)))
        (dk-cite! 'increasing-sets-chain mr3-a kk i)
        (dk-cite! 'increasing-sets-chain mr3-b kk j)
        (dk-cite! 'subset-mem-fwd (list mr3-a i) (list mr3-a kk) z)
        (dk-cite! 'subset-mem-fwd (list mr3-b j) (list mr3-b kk) z)
        (mr3-c-out! z kk)
        (mr3-bu-in! kk)))))
;; disjointify c
(define mr3-dj (list 'VNB-LAMBDA 'bk_ 'NN (list 'COMPLEMENT-IN (list mr3-c 'bk_) (list 'BIG-UNION 'uj_ '(ORD-SEGMENT bk_) (list mr3-c 'uj_)))))
(dk-cite! 'disjointify-type 'omega 'ca mr3-c)
(dk-cite! 'disjointify-union mr3-c 'ca)
(define (mr3-fin-piece! m n)           ; n in NN: (IN (m (dj n)) RR) from (dj n) subset (a n) or (b n)
  (let* ((big (if (eq? m 'mu) mr3-a mr3-b))
         (djn (list mr3-dj n))
         (bu (list 'BIG-UNION 'uj_ (list 'ORD-SEGMENT n) (list mr3-c 'uj_)))
         (val (list 'COMPLEMENT-IN (list mr3-c n) bu)))
    (dk-cite! 'fun-apply-type-c mr3-dj 'NN 'ca n)
    (mr3-ab! n)
    (dk-have! (list 'SUBSET djn (list big n))
      (lambda ()
        (let ((z (subset-by-element!)))
          (dk-have! (list '= djn val) (lambda () (mr3-beta!) (if (mr3-open?) (rfl))))
          (dk-rewrite-h! (dk-ctx-form (list 'IN z djn)) djn val)
          (dk-project! (list 'IN z (list mr3-c n)) 'complement-in-membership (list 'IN z val))
          (mr3-c-in! z n)
          (mr3-close-ass!))))
    (dk-cite! 'measure-monotone 'omega 'ca m djn (list big n))
    (dk-apply! (dk-ctx-form (mr3-fin m big)) n)
    (dk-cite! 'fun-apply-type-c m 'ca 'RR-POS-STAR djn)
    (mr3-and! (list 'IN (list m djn) 'RR-POS-STAR) (list 'IN (list m (list big n)) 'RR))
    (dk-cite! 'rr-pos-star-le-real-in-rr (list m djn) (list m (list big n)))))
(dk-project! '(IN mu (FUN ca RR-POS-STAR)) 'is-measure '(IS-MEASURE omega ca mu))
(dk-project! '(IN nu (FUN ca RR-POS-STAR)) 'is-measure '(IS-MEASURE omega ca nu))
(ew mr3-dj)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-head-is? g 'IN) (dk-ass!))
            ((dk-head-is? g '=) (subst (dk-ctx-form (list '= (list 'BIG-UNION 'n_ 'NN (list mr3-dj 'n_)) mr3-buc))) (mr3-close-ass!))
            ((dk-contains? g 'INTERSECTION)
             (let* ((ld (dk-peel!))
                    (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ld)))
               (dk-cite! 'disjointify-disjoint mr3-c 'ca (cadr (car ins)) (cadr (cadr ins)))
               (mr3-close-ass!)))
            (#t (let ((n (dk-di-var!)))
                  (mr3-fin-piece! (if (dk-contains? g 'mu) 'mu 'nu) n)
                  (mr3-close-ass!)))))))
(mr3-qed! 'sigma-finite-common-partition)

;;; ===========================================================================
;;; (3) one piece: v in ca with mu(v), nu(v) finite.  The restrictions mu_v, nu_v are finite measures, mu_v << nu_v,
;;;     so radon-nikodym-finite gives q; the change of density with h = 1_v moves the integral back to nu.
;;; ===========================================================================
(define mr3-muv '(VNB-LAMBDA mrr_ ca (mu (INTERSECTION mrr_ v))))
(define mr3-nuv '(VNB-LAMBDA mrr_ ca (nu (INTERSECTION mrr_ v))))
(define mr3-iv '(INDICATOR omega v))
(define mr3-piece
  '(FORSOME rpq_ (AND (IS-MEASURABLE-FN omega ca rpq_)
     (FORALL rna_ (IMPLIES (IN rna_ ca)
       (= (mu (INTERSECTION rna_ v))
          (INTEGRAL omega ca nu (PTWISE-ETIMES omega (INDICATOR omega rna_) (PTWISE-ETIMES omega (INDICATOR omega v) rpq_)))))))))
(sp (make-wff (mr3-alls '(omega ca mu nu v)
   (mr3-imps '((IS-MEASURE omega ca mu) (IS-MEASURE omega ca nu) (IS-ABSOLUTELY-CONTINUOUS omega ca mu nu) (IN v ca) (IN (mu v) RR) (IN (nu v) RR))
     mr3-piece))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'nn-one-in)
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
(dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
(dk-cite! 'rmc-rps-of-nonneg 0) (dk-cite! 'rmc-rps-of-nonneg 1)
(dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measure '(IS-MEASURE omega ca mu))
(dk-project! '(IN mu (FUN ca RR-POS-STAR)) 'is-measure '(IS-MEASURE omega ca mu))
(dk-project! '(IN nu (FUN ca RR-POS-STAR)) 'is-measure '(IS-MEASURE omega ca nu))
(dk-cite! 'sigma-algebra-ambient-set 'omega 'ca)
(dk-cite! 'sigma-algebra-whole-in 'omega 'ca)
(dk-cite! 'measure-restrict-to-set 'omega 'ca 'mu 'v)
(dk-cite! 'measure-restrict-to-set 'omega 'ca 'nu 'v)
(define (mr3-rv! m mv a)               ; a in ca: (= (mv a) (m (INTERSECTION a v))), typings
  (let ((e (list '= (list mv a) (list m (list 'INTERSECTION a 'v)))))
    (if (not (dk-asm? e))
        (begin
          (dk-cite! 'sigma-algebra-inter-closed-2 'omega 'ca a 'v)
          (dk-cite! 'fun-apply-type-c m 'ca 'RR-POS-STAR (list 'INTERSECTION a 'v))
          (dk-have! e (lambda () (mr3-beta!) (if (mr3-open?) (rfl))))))
    e))
(define (mr3-inter-in! z a b)          ; (IN z (INTERSECTION a b)): lands (IN z a), (IN z b); never closes the focus
  (let ((conj (list 'AND (list 'IN z a) (list 'IN z b))))
    (if (not (and (dk-asm? (cadr conj)) (dk-asm? (caddr conj))))
        (let ((iff (dk-cite! 'intersection-membership a b z)))
          (if (not (dk-asm? conj)) (dk-have! conj (lambda () (if (dk-only! iff (list 'IN z (list 'INTERSECTION a b))) (prop)))))
          (dk-split! conj)))))
;; mu_v(omega), nu_v(omega) finite
(define (mr3-fin-whole! m mv)
  (mr3-rv! m mv 'omega)
  (dk-have! '(SUBSET (INTERSECTION omega v) v)
    (lambda () (let ((z (subset-by-element!))) (mr3-inter-in! z 'omega 'v) (mr3-close-ass!))))
  (dk-cite! 'measure-monotone 'omega 'ca m '(INTERSECTION omega v) 'v)
  (mr3-and! (list 'IN (list m '(INTERSECTION omega v)) 'RR-POS-STAR) (list 'IN (list m 'v) 'RR))
  (dk-cite! 'rr-pos-star-le-real-in-rr (list m '(INTERSECTION omega v)) (list m 'v))
  (dk-have! (list 'IN (list mv 'omega) 'RR)
    (lambda () (subst (list '= (list mv 'omega) (list m '(INTERSECTION omega v)))) (dk-ass!))))
(mr3-fin-whole! 'mu mr3-muv)
(mr3-fin-whole! 'nu mr3-nuv)
;; mu_v << nu_v
(define mr3-ac '(FORALL ace_ (IMPLIES (IN ace_ ca) (IMPLIES (= (nu ace_) 0) (= (mu ace_) 0)))))
(dk-project! mr3-ac 'is-absolutely-continuous '(IS-ABSOLUTELY-CONTINUOUS omega ca mu nu))
(dk-have! (list 'IS-ABSOLUTELY-CONTINUOUS 'omega 'ca mr3-muv mr3-nuv)
  (lambda ()
    (mac 'is-absolutely-continuous)
    (let* ((ld (dk-peel!))
           (a (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'ca))) ld))))
      (mr3-rv! 'nu mr3-nuv a) (mr3-rv! 'mu mr3-muv a)
      (dk-rewrite-h! (dk-ctx-form (list '= (list mr3-nuv a) 0)) (list mr3-nuv a) (list 'nu (list 'INTERSECTION a 'v)))
      (dk-apply! (dk-ctx-form mr3-ac) (list 'INTERSECTION a 'v))
      (subst (list '= (list mr3-muv a) (list 'mu (list 'INTERSECTION a 'v))))
      (mr3-close-ass!))))
(define mr3-rq (dk-skolem! (dk-cite! 'radon-nikodym-finite 'omega 'ca mr3-muv mr3-nuv) #t))
(define mr3-qdens (list 'FORALL 'rna_ (list 'IMPLIES '(IN rna_ ca)
   (list '= (list mr3-muv 'rna_) (list 'INTEGRAL 'omega 'ca mr3-nuv (list 'PTWISE-ETIMES 'omega mr3-rq '(INDICATOR omega rna_)))))))
(define (mr3-pf! f) (dk-project! (list 'IN f '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'ca f)))
(define (mr3-val! f x) (dk-cite! 'fun-apply-type-c f 'omega 'RR-POS-STAR x))
(define (mr3-fext! f g pt!)            ; f, g in FUN(omega, RPS): (= f g)
  (mr3-fun-any! f 'omega 'RR-POS-STAR) (mr3-fun-any! g 'omega 'RR-POS-STAR)
  (mr3-ext! f g 'omega pt! 'mrfz_))
(define (mr3-ival! a x in?)            ; x in omega: the value of (INDICATOR omega a) at x, by IN?; returns it
  (dk-cite! (if in? 'indicator-value-in 'indicator-value-out) 'omega a x)
  (if in? 1 0))
(define (mr3-ityp! a x k)              ; (ia x) real, nonneg; K called with the value
  (let ((ix (list (list 'INDICATOR 'omega a) x)))
    (use-em (list 'IN x a)
      (lambda ()
        (mr3-ival! a x #t)
        (dk-have! (list 'IN ix 'RR) (lambda () (subst (list '= ix 1)) (dk-ass!)))
        (dk-have! (list '<= 0 ix) (lambda () (subst (list '= ix 1)) (dk-ass!)))
        (k 1))
      (lambda ()
        (mr3-ival! a x #f)
        (dk-have! (list 'IN ix 'RR) (lambda () (subst (list '= ix 0)) (dk-ass!)))
        (dk-have! (list '<= 0 ix) (lambda () (subst (list '= ix 0)) (dk-ass!)))
        (k 0)))))
(dk-cite! 'measurable-fn-indicator 'omega 'ca 'v)
(mr3-pf! mr3-iv)
;; nu_v(a) = int 1_v 1_a dnu
(dk-have! (list 'FORALL 'rna_ (list 'IMPLIES '(IN rna_ ca)
            (list '= (list mr3-nuv 'rna_) (list 'INTEGRAL 'omega 'ca 'nu (list 'PTWISE-ETIMES 'omega mr3-iv '(INDICATOR omega rna_))))))
  (lambda ()
    (let* ((a (dk-di-var!))
           (ia (list 'INDICATOR 'omega a))
           (av (list 'INTERSECTION a 'v))
           (iav (list 'INDICATOR 'omega av))
           (pr (list 'PTWISE-ETIMES 'omega mr3-iv ia)))
      (mr3-rv! 'nu mr3-nuv a)
      (dk-cite! 'measurable-fn-indicator 'omega 'ca a)
      (dk-cite! 'measurable-fn-indicator 'omega 'ca av)
      (dk-cite! 'measurable-fn-etimes 'omega 'ca mr3-iv ia)
      (for-each mr3-pf! (list ia iav pr))
      (mr3-fext! pr iav
        (lambda (x)
          (mr3-val! mr3-iv x) (mr3-val! ia x)
          (dk-cite! 'ptwise-etimes-value 'omega mr3-iv ia x)
          (subst (list '= (list pr x) (list 'etimes (list mr3-iv x) (list ia x))))
          (use-em (list 'IN x 'v)
            (lambda ()
              (subst (list '= (list mr3-iv x) (mr3-ival! 'v x #t)))
              (use-em (list 'IN x a)
                (lambda ()
                  (subst (list '= (list ia x) (mr3-ival! a x #t)))
                  (dk-have! (list 'IN x av) (lambda () (mac 'intersection-membership) (dk-conj-close! (lambda () (dk-ass!)))))
                  (subst (list '= (list iav x) (mr3-ival! av x #t)))
                  (dk-cite! 'etimes-one-left 1)
                  (mr3-close-ass!))
                (lambda ()
                  (subst (list '= (list ia x) (mr3-ival! a x #f)))
                  (dk-have! (list 'NOT (list 'IN x av)) (lambda () (di) (mr3-inter-in! x a 'v) (ai (list 'NOT (list 'IN x a)))))
                  (subst (list '= (list iav x) (mr3-ival! av x #f)))
                  (dk-cite! 'etimes-zero-right 1)
                  (mr3-close-ass!))))
            (lambda ()
              (subst (list '= (list mr3-iv x) (mr3-ival! 'v x #f)))
              (dk-have! (list 'NOT (list 'IN x av)) (lambda () (di) (mr3-inter-in! x a 'v) (ai (list 'NOT (list 'IN x 'v)))))
              (subst (list '= (list iav x) (mr3-ival! av x #f)))
              (dk-cite! 'etimes-zero-left (list ia x))
              (mr3-close-ass!)))))
      (dk-cite! 'integral-indicator 'omega 'ca 'nu av)
      (subst (list '= (list mr3-nuv a) (list 'nu av)))
      (subst (list '= pr iav))
      (subst (list '= (list 'INTEGRAL 'omega 'ca 'nu iav) (list 'nu av)))
      (if (mr3-open?) (rfl)))))
(define mr3-dc (dk-cite! 'density-change 'omega 'ca 'nu mr3-nuv mr3-iv))
(mr3-pf! mr3-rq)
(dk-have! (list 'FORALL 'rna_ (list 'IMPLIES '(IN rna_ ca)
            (list '= '(mu (INTERSECTION rna_ v))
                     (list 'INTEGRAL 'omega 'ca 'nu (list 'PTWISE-ETIMES 'omega '(INDICATOR omega rna_) (list 'PTWISE-ETIMES 'omega mr3-iv mr3-rq))))))
  (lambda ()
    (let* ((a (dk-di-var!))
           (ia (list 'INDICATOR 'omega a))
           (qa (list 'PTWISE-ETIMES 'omega mr3-rq ia))
           (vqa (list 'PTWISE-ETIMES 'omega mr3-iv qa))
           (vq (list 'PTWISE-ETIMES 'omega mr3-iv mr3-rq))
           (avq (list 'PTWISE-ETIMES 'omega ia vq)))
      (mr3-rv! 'mu mr3-muv a)
      (dk-cite! 'measurable-fn-indicator 'omega 'ca a)
      (dk-cite! 'measurable-fn-etimes 'omega 'ca mr3-rq ia)
      (dk-cite! 'measurable-fn-etimes 'omega 'ca mr3-iv qa)
      (dk-cite! 'measurable-fn-etimes 'omega 'ca mr3-iv mr3-rq)
      (dk-cite! 'measurable-fn-etimes 'omega 'ca ia vq)
      (for-each mr3-pf! (list ia qa vqa vq avq))
      (mr3-fext! vqa avq
        (lambda (x)
          (for-each (lambda (f) (mr3-val! f x)) (list mr3-iv ia mr3-rq qa vq))
          (dk-cite! 'ptwise-etimes-value 'omega mr3-iv qa x)
          (dk-cite! 'ptwise-etimes-value 'omega mr3-rq ia x)
          (dk-cite! 'ptwise-etimes-value 'omega ia vq x)
          (dk-cite! 'ptwise-etimes-value 'omega mr3-iv mr3-rq x)
          (subst (list '= (list vqa x) (list 'etimes (list mr3-iv x) (list qa x))))
          (subst (list '= (list qa x) (list 'etimes (list mr3-rq x) (list ia x))))
          (subst (list '= (list avq x) (list 'etimes (list ia x) (list vq x))))
          (subst (list '= (list vq x) (list 'etimes (list mr3-iv x) (list mr3-rq x))))
          (mr3-ityp! a x
            (lambda (val)
              (mr3-and! (list 'IN (list mr3-rq x) 'RR-POS-STAR) (list 'IN (list ia x) 'RR-POS-STAR))
              (dk-cite! 'etimes-comm (list mr3-rq x) (list ia x))
              (subst (list '= (list 'etimes (list mr3-rq x) (list ia x)) (list 'etimes (list ia x) (list mr3-rq x))))
              (dk-cite! 'etimes-left-commute (list mr3-iv x) (list mr3-rq x) (list ia x))
              (mr3-close-ass!)))))
      (dk-apply! (dk-ctx-form mr3-qdens) a)
      (dk-apply! mr3-dc qa)
      (subst (list '= (list 'mu (list 'INTERSECTION a 'v)) (list mr3-muv a)))
      (subst (list '= (list mr3-muv a) (list 'INTEGRAL 'omega 'ca mr3-nuv qa)))
      (subst (list '= (list 'INTEGRAL 'omega 'ca mr3-nuv qa) (list 'INTEGRAL 'omega 'ca 'nu vqa)))
      (subst (list '= vqa avq))
      (dk-cite! 'integral-in 'omega 'ca 'nu avq)
      (if (mr3-open?) (rfl)))))
(ew mr3-rq)
(dk-conj-close! (lambda () (dk-ass!)))
(mr3-qed! 'rn-on-finite-piece)

