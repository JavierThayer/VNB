(dk-cite! 'rmc-rps-of-nonneg 0) (dk-cite! 'rmc-rps-of-nonneg 1)
(dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measure '(IS-MEASURE omega ca mu))
(dk-project! '(SUBSET ca (POWER omega)) 'IS-SIGMA-ALGEBRA '(IS-SIGMA-ALGEBRA omega ca))
(dk-project! '(IN mu (FUN ca RR-POS-STAR)) 'is-measure '(IS-MEASURE omega ca mu))
(dk-project! '(IN nu (FUN ca RR-POS-STAR)) 'is-measure '(IS-MEASURE omega ca nu))
(dk-cite! 'sigma-algebra-ambient-set 'omega 'ca)
(define mr3-d (dk-skolem! (dk-cite! 'sigma-finite-common-partition 'omega 'ca 'mu 'nu) #t))
(define (mr3-dn! n)                    ; n in NN: (d n) in ca, mu, nu finite on it
  (dk-cite! 'fun-apply-type-c mr3-d 'NN 'ca n)
  (if (not (dk-asm? (list 'IN (list 'mu (list mr3-d n)) 'RR))) (dk-apply! (dk-ctx-form (mr3-fin 'mu mr3-d)) n))
  (if (not (dk-asm? (list 'IN (list 'nu (list mr3-d n)) 'RR))) (dk-apply! (dk-ctx-form (mr3-fin 'nu mr3-d)) n)))
(define (mr3-prop-of q v)              ; the density property of q on the piece v
  (list 'FORALL 'rna_ (list 'IMPLIES '(IN rna_ ca)
    (list '= (list 'mu (list 'INTERSECTION 'rna_ v))
             (list 'INTEGRAL 'omega 'ca 'nu (list 'PTWISE-ETIMES 'omega '(INDICATOR omega rna_) (list 'PTWISE-ETIMES 'omega (list 'INDICATOR 'omega v) q)))))))
(define (mr3-qset n) (list 'SEP 'qq_ '(FUN omega RR-POS-STAR) (list 'AND '(IS-MEASURABLE-FN omega ca qq_) (mr3-prop-of 'qq_ (list mr3-d n)))))
(define mr3-ql (list 'VNB-LAMBDA 'qn_ 'NN (list 'CHOICE (mr3-qset 'qn_))))
(define (mr3-choice-mem! n)            ; n in NN: (IN (CHOICE (qset n)) (qset n)) only
  (let* ((s (mr3-qset n)) (mem (list 'IN (list 'CHOICE s) s)))
    (if (not (dk-asm? mem))
        (begin
          (mr3-dn! n)
          (let ((w (dk-skolem! (dk-cite! 'rn-on-finite-piece 'omega 'ca 'mu 'nu (list mr3-d n)) #t)))
            (mr3-pf! w)
            (choose-mem! s w (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-conj-close! (lambda () (dk-ass!))))))))))
    mem))
(define (mr3-choice! n)                ; n in NN: (IN (CHOICE (qset n)) (qset n)) and its two properties
  (let* ((s (mr3-qset n)) (c (list 'CHOICE s)) (mem (list 'IN c s))
         (cond2 (list 'AND (list 'IS-MEASURABLE-FN 'omega 'ca c) (mr3-prop-of c (list mr3-d n)))))
    (mr3-choice-mem! n)
    (if (not (dk-asm? (list 'IN c '(FUN omega RR-POS-STAR))))
        (dk-project! (list 'IN c '(FUN omega RR-POS-STAR)) (lambda () (sep-me (dk-ctx-form mem)) (dk-split-all!))))
    (if (not (dk-asm? (caddr cond2)))
        (begin
          (dk-project! cond2 (lambda () (sep-me (dk-ctx-form mem)) (dk-split-all!)))
          (dk-split! cond2)))
    c))
(dk-have! (list 'IN mr3-ql '(FUN NN (FUN omega RR-POS-STAR)))
  (lambda () (dk-lam-type! (lambda () (let ((n (dk-di-var!)))
                                        (mr3-beta!)
                                        (sep-me (dk-ctx-form (mr3-choice-mem! n)))
                                        (dk-split-all!)
                                        (mr3-close-ass!)))
                           (lambda () (dk-ass!)))))
(define mr3-q0 (dk-name! mr3-ql '(FUN NN (FUN omega RR-POS-STAR))))
(define (mr3-q! n)                     ; n in NN: (q0 n) typed, measurable, with its density property on (d n)
  (let* ((qn (list mr3-q0 n)) (pr (mr3-prop-of qn (list mr3-d n))))
    (if (not (dk-asm? pr))
        (let ((c (mr3-choice! n)))
          (dk-cite! 'fun-apply-type-c mr3-q0 'NN '(FUN omega RR-POS-STAR) n)
          (dk-have! (list '= qn c) (lambda () (subst (list '= mr3-q0 mr3-ql)) (mr3-beta!) (if (mr3-open?) (rfl))))
          (dk-rewrite-h! (dk-ctx-form (list 'IS-MEASURABLE-FN 'omega 'ca c)) c qn)
          (dk-rewrite-h! (dk-ctx-form (mr3-prop-of c (list mr3-d n))) c qn)))
    pr))
(define (mr3-gv n) (list 'PTWISE-ETIMES 'omega (list 'INDICATOR 'omega (list mr3-d n)) (list mr3-q0 n)))
(define mr3-gl (list 'VNB-LAMBDA 'gn_ 'NN (mr3-gv 'gn_)))
(define (mr3-gpre! n)                  ; n in NN: (gv n) measurable, typed
  (mr3-q! n) (mr3-dn! n)
  (dk-cite! 'measurable-fn-indicator 'omega 'ca (list mr3-d n))
  (dk-cite! 'measurable-fn-etimes 'omega 'ca (list 'INDICATOR 'omega (list mr3-d n)) (list mr3-q0 n))
  (mr3-pf! (mr3-gv n)))
(dk-have! (list 'IN mr3-gl '(FUN NN (FUN omega RR-POS-STAR)))
  (lambda () (dk-lam-type! (lambda () (let ((n (dk-di-var!))) (mr3-beta!) (mr3-gpre! n) (mr3-close-ass!)))
                           (lambda () (dk-ass!)))))
(define mr3-g0 (dk-name! mr3-gl '(FUN NN (FUN omega RR-POS-STAR))))
(define (mr3-g! n)                     ; n in NN: (= (g0 n) (gv n)), (g0 n) measurable and typed
  (let ((e (list '= (list mr3-g0 n) (mr3-gv n))))
    (if (not (dk-asm? e))
        (begin
          (mr3-gpre! n)
          (dk-cite! 'fun-apply-type-c mr3-g0 'NN '(FUN omega RR-POS-STAR) n)
          (dk-have! e (lambda () (subst (list '= mr3-g0 mr3-gl)) (mr3-beta!) (if (mr3-open?) (rfl))))
          (dk-rewrite-h! (dk-ctx-form (list 'IS-MEASURABLE-FN 'omega 'ca (mr3-gv n))) (mr3-gv n) (list mr3-g0 n))))
    e))
;; ESUM typing for a lambda over NN
(define (mr3-esum-type! fv)            ; fv in FUN(NN, RPS): (IN (ESUM fv) RPS)
  (if (not (dk-asm? (list 'IN (list 'ESUM fv) 'RR-POS-STAR)))
      (begin
        (mr3-fun-any! fv 'NN 'RR-POS-STAR)
        (mr3-and! (list 'IN fv '(FUN NN)) '(IN NN SET))
        (let ((dd (dk-cite! 'dom-of-fun 'NN fv)))
          (if (and (pair? dd) (eq? (car dd) 'AND) (not (dk-asm? (caddr dd)))) (dk-split! dd)))
        (dk-have! (list 'IN fv (list 'FUN (list 'DOM fv) 'RR-POS-STAR))
                  (lambda () (subst (list '= (list 'DOM fv) 'NN)) (dk-ass!)))
        (dk-cite! 'esum-in fv))))
(define (mr3-seq-at g x) (list 'VNB-LAMBDA 'ifv_ 'NN (list (list g 'ifv_) x)))
(define (mr3-seq-type! g gv! x)        ; x in omega, (g k) typed by GV!: (IN (seq g x) (FUN NN RPS)), ESUM typed
  (let ((sq (mr3-seq-at g x)))
    (if (not (dk-asm? (list 'IN sq '(FUN NN RR-POS-STAR))))
        (dk-have! (list 'IN sq '(FUN NN RR-POS-STAR))
          (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!)))
                                                (mr3-beta!)
                                                (gv! k)
                                                (dk-cite! 'fun-apply-type-c (list g k) 'omega 'RR-POS-STAR x)
                                                (mr3-close-ass!)))
                                   (lambda () (dk-ass!))))))
    (mr3-esum-type! sq)
    sq))
(define mr3-fl (list 'VNB-LAMBDA 'fx_ 'omega (list 'ESUM (mr3-seq-at mr3-g0 'fx_))))
(dk-have! (list 'IN mr3-fl '(FUN omega RR-POS-STAR))
  (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (mr3-beta!) (mr3-seq-type! mr3-g0 mr3-g! x) (mr3-close-ass!)))
                           (lambda () (dk-ass!)))))
(define mr3-f0 (dk-name! mr3-fl '(FUN omega RR-POS-STAR)))
(define (mr3-f! x)                     ; x in omega: (= (f0 x) (ESUM (seq g0 x)))
  (let ((e (list '= (list mr3-f0 x) (list 'ESUM (mr3-seq-at mr3-g0 x)))))
    (if (not (dk-asm? e))
        (begin
          (mr3-seq-type! mr3-g0 mr3-g! x)
          (dk-cite! 'fun-apply-type-c mr3-f0 'omega 'RR-POS-STAR x)
          (dk-have! e (lambda () (subst (list '= mr3-f0 mr3-fl)) (mr3-beta!) (if (mr3-open?) (rfl))))))
    e))
(define (mr3-meas-seq! g g!)
  (dk-have! (list 'FORALL 'ifv_ (list 'IMPLIES '(IN ifv_ NN) (list 'IS-MEASURABLE-FN 'omega 'ca (list g 'ifv_))))
    (lambda () (let ((k (dk-di-var!))) (g! k) (mr3-close-ass!)))))
(mr3-meas-seq! mr3-g0 mr3-g!)
(dk-have! (list 'FORALL 'bex_ (list 'IMPLIES '(IN bex_ omega) (list '= (list mr3-f0 'bex_) (list 'ESUM (mr3-seq-at mr3-g0 'bex_)))))
  (lambda () (let ((x (dk-di-var!))) (mr3-f! x) (mr3-close-ass!))))
(define mr3-fes (dk-cite! 'integral-esum 'omega 'ca 'nu mr3-g0 mr3-f0))
(if (and (pair? mr3-fes) (eq? (car mr3-fes) 'AND)) (dk-split! mr3-fes))
;; the density identity, set by set
(define mr3-cadd
  (forall-guarded '(f_) (list '(IN f_ (FUN NN ca))
                              (forall-guarded '(i_ j_) '((IN i_ NN) (IN j_ NN) (NOT (= i_ j_))) '(= (INTERSECTION (f_ i_) (f_ j_)) EMPTY-SET)))
    '(= (mu (BIG-UNION n_ NN (f_ n_))) (ESUM (VNB-LAMBDA n_ NN (mu (f_ n_)))))))
(dk-project! mr3-cadd 'is-measure '(IS-MEASURE omega ca mu))
(define mr3-bud (list 'BIG-UNION 'n_ 'NN (list mr3-d 'n_)))
(dk-have! (list 'FORALL 'rna_ (list 'IMPLIES '(IN rna_ ca)
            (list '= '(mu rna_) (list 'INTEGRAL 'omega 'ca 'nu (list 'PTWISE-ETIMES 'omega mr3-f0 '(INDICATOR omega rna_))))))
  (lambda ()
    (let* ((a (dk-di-var!))
           (ia (list 'INDICATOR 'omega a))
           (h (list 'PTWISE-ETIMES 'omega mr3-f0 ia))
           (gal (list 'VNB-LAMBDA 'gan_ 'NN (list 'PTWISE-ETIMES 'omega ia (list mr3-g0 'gan_))))
           (eal (list 'VNB-LAMBDA 'ean_ 'NN (list 'INTERSECTION a (list mr3-d 'ean_)))))
      (dk-cite! 'measurable-fn-indicator 'omega 'ca a)
      (mr3-pf! ia)
      (dk-cite! 'measurable-fn-etimes 'omega 'ca mr3-f0 ia)
      (mr3-pf! h)
      ;; gA
      (define (gapre! n) (mr3-g! n)
        (dk-cite! 'measurable-fn-etimes 'omega 'ca ia (list mr3-g0 n))
        (mr3-pf! (list 'PTWISE-ETIMES 'omega ia (list mr3-g0 n))))
      (dk-have! (list 'IN gal '(FUN NN (FUN omega RR-POS-STAR)))
        (lambda () (dk-lam-type! (lambda () (let ((n (dk-di-var!))) (mr3-beta!) (gapre! n) (mr3-close-ass!)))
                                 (lambda () (dk-ass!)))))
      (let ((ga (dk-name! gal '(FUN NN (FUN omega RR-POS-STAR)))))
        (define (ga! n)
          (let* ((gv (list 'PTWISE-ETIMES 'omega ia (list mr3-g0 n))) (e (list '= (list ga n) gv)))
            (if (not (dk-asm? e))
                (begin
                  (gapre! n)
                  (dk-cite! 'fun-apply-type-c ga 'NN '(FUN omega RR-POS-STAR) n)
                  (dk-have! e (lambda () (subst (list '= ga gal)) (mr3-beta!) (if (mr3-open?) (rfl))))
                  (dk-rewrite-h! (dk-ctx-form (list 'IS-MEASURABLE-FN 'omega 'ca gv)) gv (list ga n))))
            e))
        (mr3-meas-seq! ga ga!)
        (dk-have! (list 'FORALL 'bex_ (list 'IMPLIES '(IN bex_ omega) (list '= (list h 'bex_) (list 'ESUM (mr3-seq-at ga 'bex_)))))
          (lambda ()
            (let* ((x (dk-di-var!)) (ix (list ia x)) (gs (mr3-seq-at mr3-g0 x)) (hs (mr3-seq-at ga x)))
              (mr3-f! x)
              (mr3-seq-type! ga ga! x)
              (mr3-val! mr3-f0 x) (mr3-val! ia x)
              (dk-cite! 'ptwise-etimes-value 'omega mr3-f0 ia x)
              (subst (list '= (list h x) (list 'etimes (list mr3-f0 x) ix)))
              (subst (list '= (list mr3-f0 x) (list 'ESUM gs)))
              (mr3-ityp! a x
                (lambda (val)
                  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ NN) (list '= (list hs 'z_) (list 'etimes ix (list gs 'z_)))))
                    (lambda ()
                      (let ((k (dk-di-var!)))
                        (ga! k) (mr3-g! k)
                        (mr3-beta!)
                        (mr3-val! (list mr3-g0 k) x)
                        (dk-cite! 'ptwise-etimes-value 'omega ia (list mr3-g0 k) x)
                        (subst (list '= (list ga k) (list 'PTWISE-ETIMES 'omega ia (list mr3-g0 k))))
                        (mr3-close-ass!))))
                  (dk-cite! 'esum-scale-ptwise ix 'NN gs hs)
                  (mr3-and! (list 'IN (list 'ESUM gs) 'RR-POS-STAR) (list 'IN ix 'RR-POS-STAR))
                  (dk-cite! 'etimes-comm (list 'ESUM gs) ix)
                  (subst (list '= (list 'etimes (list 'ESUM gs) ix) (list 'etimes ix (list 'ESUM gs))))
                  (subst (list '= (list 'ESUM hs) (list 'etimes ix (list 'ESUM gs))))
                  (if (mr3-open?) (rfl)))))))
        (let* ((hes (dk-cite! 'integral-esum 'omega 'ca 'nu ga h))
               (l1 (list 'VNB-LAMBDA 'ifv_ 'NN (list 'INTEGRAL 'omega 'ca 'nu (list ga 'ifv_)))))
          (if (and (pair? hes) (eq? (car hes) 'AND)) (dk-split! hes))
          ;; eA
          (dk-have! (list 'IN eal '(FUN NN ca))
            (lambda () (dk-lam-type! (lambda () (let ((n (dk-di-var!))) (mr3-beta!) (mr3-dn! n)
                                                  (dk-cite! 'sigma-algebra-inter-closed-2 'omega 'ca a (list mr3-d n))
                                                  (mr3-close-ass!)))
                                     (lambda () (dk-ass!)))))
          (let* ((ea (dk-name! eal '(FUN NN ca)))
                 (l2 (list 'VNB-LAMBDA 'n_ 'NN (list 'mu (list ea 'n_))))
                 (bue (list 'BIG-UNION 'n_ 'NN (list ea 'n_))))
            (define (ea! n)
              (let ((e (list '= (list ea n) (list 'INTERSECTION a (list mr3-d n)))))
                (if (not (dk-asm? e))
                    (begin
                      (mr3-dn! n)
                      (dk-cite! 'sigma-algebra-inter-closed-2 'omega 'ca a (list mr3-d n))
                      (dk-cite! 'fun-apply-type-c ea 'NN 'ca n)
                      (dk-have! e (lambda () (subst (list '= ea eal)) (mr3-beta!) (if (mr3-open?) (rfl))))))
                e))
            (define (ea-in! z n)       ; (IN z (ea n)): lands (IN z a), (IN z (d n))
              (ea! n)
              (dk-rewrite-h! (dk-ctx-form (list 'IN z (list ea n))) (list ea n) (list 'INTERSECTION a (list mr3-d n)))
              (mr3-inter-in! z a (list mr3-d n)))
            ;; disjoint
            (dk-have! (forall-guarded '(i_ j_) '((IN i_ NN) (IN j_ NN) (NOT (= i_ j_))) (list '= (list 'INTERSECTION (list ea 'i_) (list ea 'j_)) 'EMPTY-SET))
              (lambda ()
                (let* ((ld (dk-peel!))
                       (ne (find-first (lambda (f) (and (dk-head-is? f 'NOT) (dk-head-is? (cadr f) '=))) ld))
                       (i (cadr (cadr ne))) (j (caddr (cadr ne))))
                  (ea! i) (ea! j)
                  (dk-apply! (dk-ctx-form (mr3-disj mr3-d)) i j)
                  (mr3-class-ext! (list 'INTERSECTION (list ea i) (list ea j)) 'EMPTY-SET
                    (lambda (z)
                      (mr3-inter-in! z (list ea i) (list ea j))
                      (ea-in! z i) (ea-in! z j)
                      (dk-have! (list 'IN z (list 'INTERSECTION (list mr3-d i) (list mr3-d j)))
                        (lambda () (mac 'intersection-membership) (dk-conj-close! (lambda () (dk-ass!)))))
                      (dk-rewrite-h! (dk-ctx-form (list 'IN z (list 'INTERSECTION (list mr3-d i) (list mr3-d j))))
                                     (list 'INTERSECTION (list mr3-d i) (list mr3-d j)) 'EMPTY-SET)
                      (mr3-close-ass!))
                    (lambda (z)
                      (dk-cite! 'empty-set-has-no-members z)
                      (ai (list 'NOT (list 'IN z 'EMPTY-SET)))))
                  (mr3-close-ass!))))
            (dk-apply! (dk-ctx-form mr3-cadd) ea)
            ;; the union of the ea is a
            (dk-cite! 'subset-mem-fwd 'ca '(POWER omega) a)
            (mr3-class-ext! bue a
              (lambda (z)
                (let ((n (car (mr3-bu-open! z bue))))
                  (ea-in! z n)
                  (mr3-close-ass!)))
              (lambda (z)
                (dk-cite! 'power-mem-in 'omega a z)
                (dk-rewrite-h! (dk-ctx-form (list 'IN z 'omega)) 'omega mr3-bud)
                (let ((n (car (mr3-bu-open! z mr3-bud))))
                  (ea! n)
                  (dk-have! (list 'IN z (list ea n))
                    (lambda () (subst (list '= (list ea n) (list 'INTERSECTION a (list mr3-d n))))
                               (mac 'intersection-membership) (dk-conj-close! (lambda () (dk-ass!)))))
                  (mr3-bu-in! n))))
            ;; the two series agree term by term
            (dk-have! (list 'IN l1 '(FUN NN RR-POS-STAR))
              (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (mr3-beta!) (ga! k)
                                                    (dk-cite! 'integral-in 'omega 'ca 'nu (list ga k)) (mr3-close-ass!)))
                                       (lambda () (dk-ass!)))))
            (dk-have! (list 'IN l2 '(FUN NN RR-POS-STAR))
              (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (mr3-beta!) (ea! k)
                                                    (dk-cite! 'fun-apply-type-c 'mu 'ca 'RR-POS-STAR (list ea k)) (mr3-close-ass!)))
                                       (lambda () (dk-ass!)))))
            (mr3-fun-any! l1 'NN 'RR-POS-STAR) (mr3-fun-any! l2 'NN 'RR-POS-STAR)
            (mr3-ext! l1 l2 'NN
              (lambda (k)
                (ga! k) (mr3-g! k) (ea! k)
                (let* ((ad (list 'INTERSECTION a (list mr3-d k)))
                       (int (list 'INTEGRAL 'omega 'ca 'nu (list 'PTWISE-ETIMES 'omega ia (mr3-gv k)))))
                  (dk-apply! (dk-ctx-form (mr3-q! k)) a)
                  (dk-cite! 'fun-apply-type-c 'mu 'ca 'RR-POS-STAR ad)
                  (mr3-beta!)
                  (subst (list '= (list ga k) (list 'PTWISE-ETIMES 'omega ia (list mr3-g0 k))))
                  (subst (list '= (list mr3-g0 k) (mr3-gv k)))
                  (subst (list '= (list ea k) ad))
                  (subst (list '= int (list 'mu ad)))
                  (if (mr3-open?) (rfl))))
              'mrsk_)
            (mr3-esum-type! l2)
            (dk-cite! 'fun-apply-type-c 'mu 'ca 'RR-POS-STAR a)
            (subst (list '= (list 'INTEGRAL 'omega 'ca 'nu h) (list 'ESUM l1)))
            (subst (list '= l1 l2))
            (subst (list '= (list 'ESUM l2) (list 'mu bue)))
            (subst (list '= bue a))
            (if (mr3-open?) (rfl))))))))
(ew mr3-f0)
(dk-conj-close! (lambda () (dk-ass!)))
(mr3-qed! 'radon-nikodym-sigma-finite)

;;; ===========================================================================
;;; (5) THEOREM 3.10 as the notes state it
;;; ===========================================================================
(sp (make-wff (mr3-alls '(omega ca mu nu)
   (mr3-imps '((IS-MEASURE omega ca mu) (IS-MEASURE omega ca nu) (IS-SIGMA-FINITE omega ca mu) (IS-SIGMA-FINITE omega ca nu))
     (list 'IFF '(IS-ABSOLUTELY-CONTINUOUS omega ca mu nu) mr3-rnconc)))))
(dk-peel!)
(dk-iff! (lambda (gg) (equal? gg mr3-rnconc))
  (lambda () (dk-cite! 'radon-nikodym-sigma-finite 'omega 'ca 'mu 'nu) (mr3-close-ass!))
  (lambda ()
    (let ((f (dk-skolem! (dk-ctx-form mr3-rnconc) #t)))
      (dk-cite! 'density-implies-absolutely-continuous 'omega 'ca 'mu 'nu f)
      (mr3-close-ass!))))
(mr3-qed! 'radon-nikodym)
