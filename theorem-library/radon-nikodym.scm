;; the hypotheses of integral-unique (md-unique.scm), with mu := nu and jj := the functional
(define mr2-Hs
  (map (lambda (h) (mr2-tsub 'jj mr2-jj (mr2-tsub 'mu 'nu h)))
    (list
     '(FORALL mdf_ (IMPLIES (IS-MEASURABLE-FN omega ca mdf_) (IN (jj mdf_) RR-POS-STAR)))
     '(FORALL mda_ (IMPLIES (IN mda_ ca) (= (jj (INDICATOR omega mda_)) (mu mda_))))
     '(FORALL mda_ (IMPLIES (IN mda_ ca) (IMPLIES (= (mu mda_) 0) (= (jj (PTWISE-SCALE omega POS-INF (INDICATOR omega mda_))) 0))))
     '(FORALL mdf_ (IMPLIES (IS-MEASURABLE-FN omega ca mdf_) (FORALL mdg_ (IMPLIES (IS-MEASURABLE-FN omega ca mdg_)
                     (= (jj (PTWISE-EPLUS omega mdf_ mdg_)) (eplus (jj mdf_) (jj mdg_)))))))
     '(FORALL mdf_ (IMPLIES (IS-MEASURABLE-FN omega ca mdf_) (FORALL mdc_ (IMPLIES (IN mdc_ RR) (IMPLIES (<= 0 mdc_)
                     (= (jj (PTWISE-SCALE omega mdc_ mdf_)) (etimes mdc_ (jj mdf_))))))))
     '(FORALL mdf_ (IMPLIES (IS-MEASURABLE-FN omega ca mdf_) (FORALL mdg_ (IMPLIES (IS-MEASURABLE-FN omega ca mdg_)
                     (IMPLIES (PTWISE-LE omega mdf_ mdg_) (<= (jj mdf_) (jj mdg_)))))))
     '(FORALL mdcf_ (IMPLIES (IN mdcf_ (FUN NN (FUN omega RR-POS-STAR)))
                     (IMPLIES (FORALL n_ (IMPLIES (IN n_ NN) (IS-MEASURABLE-FN omega ca (mdcf_ n_))))
                       (IMPLIES (FORALL n_ (IMPLIES (IN n_ NN) (PTWISE-LE omega (mdcf_ n_) (mdcf_ (succ n_)))))
                         (= (jj (PTWISE-SUP omega mdcf_)) (ESUP (IMAGE (VNB-LAMBDA n_ NN (jj (mdcf_ n_))) NN))))))))))
