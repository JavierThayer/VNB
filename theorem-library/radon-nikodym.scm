           (cf (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (equal? (caddr x) '(FUN NN (FUN omega RR-POS-STAR))))) ld)))
           (sup (list 'PTWISE-SUP 'omega cf))
           (cg (mr2-tsub 'cf cf mr2-cg))
           (cgs (list 'PTWISE-SUP 'omega cg))
           (fm (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN 'omega 'ca (list cf 'n_)))))
           (inc (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'PTWISE-LE 'omega (list cf 'n_) (list cf '(succ n_)))))))
      (define (cfk! k)                 ; cf k measurable, its h-product measurable, cg k = h (cf k)
        (dk-apply! (dk-ctx-form fm) k)
        (dk-cite! 'fun-apply-type-c cf 'NN '(FUN omega RR-POS-STAR) k)
        (dk-cite! 'measurable-fn-etimes 'omega 'ca 'h (list cf k))
        (mr2-proj-fun! (mr2-hf (list cf k)))
        (let ((e (list '= (list cg k) (mr2-hf (list cf k)))))
          (if (not (dk-asm? e)) (dk-have! e (lambda () (mac 'PTWISE-ETIMES) (mr2-beta!) (if (mr2-open?) (rfl))))))
        (mr2-jjv! (list cf k)))
      (dk-cite! 'measurable-fn-sup 'omega 'ca cf)
      (mr2-sub-e! sup)
      (mr2-proj-fun! sup) (mr2-proj-fun! (mr2-hf sup))
      (dk-have! (list 'IN cg '(FUN NN (FUN omega RR-POS-STAR)))
        (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!)))
                                              (cfk! k) (mr2-beta!)
                                              (if (mr2-open?)
                                                  (let ((lam (cadr (dk-goal))))
                                                    (if (dk-head-is? lam 'VNB-LAMBDA)
                                                        (begin (dk-have! (list '= lam (mr2-hf (list cf k))) (lambda () (mac 'PTWISE-ETIMES) (if (mr2-open?) (rfl))))
                                                               (subst (list '= lam (mr2-hf (list cf k))))))
                                                    (if (mr2-open?) (dk-ass!))))))
                                 (lambda () (dk-ass!)))))
      (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN 'omega 'ca (list cg 'n_))))
        (lambda () (let ((k (dk-di-var!))) (cfk! k) (subst (list '= (list cg k) (mr2-hf (list cf k)))) (dk-ass!))))
      (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'PTWISE-LE 'omega (list cg 'n_) (list cg '(succ n_)))))
        (lambda ()
          (let* ((k (dk-di-var!)) (sk (list 'succ k)))
            (fact 'nn-succ-closed k)
            (cfk! k) (cfk! sk)
            (subst (list '= (list cg k) (mr2-hf (list cf k))))
            (subst (list '= (list cg sk) (mr2-hf (list cf sk))))
            (dk-apply! (dk-ctx-form inc) k)
            (mac 'PTWISE-LE)
            (let ((x (dk-di-var!)))
              (mr2-proj-fun! (list cf k)) (mr2-proj-fun! (list cf sk))
              (mr2-val! 'h x) (mr2-val! (list cf k) x) (mr2-val! (list cf sk) x)
              (dk-cite! 'ptwise-etimes-value 'omega 'h (list cf k) x)
              (dk-cite! 'ptwise-etimes-value 'omega 'h (list cf sk) x)
              (subst (list '= (list (mr2-hf (list cf k)) x) (list 'etimes (list 'h x) (list (list cf k) x))))
              (subst (list '= (list (mr2-hf (list cf sk)) x) (list 'etimes (list 'h x) (list (list cf sk) x))))
              (dk-project! (list '<= (list (list cf k) x) (list (list cf sk) x))
                           (lambda () (mac-h 'PTWISE-LE (list 'PTWISE-LE 'omega (list cf k) (list cf sk)))
                                      (dk-apply! (dk-ctx-form (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ omega) (list '<= (list (list cf k) 'x_) (list (list cf sk) 'x_))))) x)))
              (dk-cite! 'rr-pos-star-le-refl (list 'h x))
              (dk-cite! 'etimes-mono-star (list 'h x) (list 'h x) (list (list cf k) x) (list (list cf sk) x))
              (dk-ass!)))))
      (mr2-split! (dk-cite! 'monotone-convergence 'omega 'ca 'rho cg))
      (mr2-proj-fun! cgs)
      ;; h * sup = sup of h * cf
      (dk-cite! 'ptwise-etimes-sup 'omega 'h cf)
      (let ((jl (list 'VNB-LAMBDA 'n_ 'NN (list mr2-jj (list cf 'n_))))
            (il (list 'VNB-LAMBDA 'n_ 'NN (list 'INTEGRAL 'omega 'ca 'rho (list cg 'n_)))))
        (define (jlk! k)               ; jl k = il k (both reduced to the integral of h (cf k))
          (cfk! k)
          (mr2-beta!)
          (if (mr2-open?)
              (let* ((g (dk-goal)) (rl (list-ref (caddr g) 4)))
                (if (dk-head-is? rl 'VNB-LAMBDA)
                    (begin (dk-have! (list '= rl (mr2-hf (list cf k))) (lambda () (mac 'PTWISE-ETIMES) (if (mr2-open?) (rfl))))
                           (subst (list '= rl (mr2-hf (list cf k))))))
                (if (mr2-open?) (rfl)))))
        (dk-have! (list 'IN jl '(FUN NN RR-POS-STAR))
          (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (cfk! k) (mr2-beta!) (if (mr2-open?) (dk-ass!)))) (lambda () (dk-ass!)))))
        (dk-have! (list 'IN il '(FUN NN RR-POS-STAR))
          (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (cfk! k)
                                                (dk-cite! 'integral-in 'omega 'ca 'rho (mr2-hf (list cf k)))
                                                (mr2-beta!)
                                                (if (mr2-open?)
                                                    (let* ((g (dk-goal)) (rl (list-ref (cadr g) 4)))
                                                      (if (dk-head-is? rl 'VNB-LAMBDA)
                                                          (begin (dk-have! (list '= rl (mr2-hf (list cf k))) (lambda () (mac 'PTWISE-ETIMES) (if (mr2-open?) (rfl))))
                                                                 (subst (list '= rl (mr2-hf (list cf k))))))
                                                      (if (mr2-open?) (dk-ass!))))))
                                   (lambda () (dk-ass!)))))
        (mr2-ext! jl il 'NN (lambda (k) (jlk! k)) 'mrez_)
        (subst (list '= jl il))
        (subst (list '= (mr2-hf sup) cgs))
        (if (mr2-open?) (dk-ass!)))
      #t)))
;; the uniqueness of the integral
(let* ((iu (dk-cite! 'integral-unique 'omega 'ca 'nu mr2-jj))
       (g (cadddr (dk-pick (lambda (x) (and (dk-head-is? x 'IS-MEASURABLE-FN) (not (eq? (cadddr x) 'h)))) "the function g"))))
  (dk-apply! (dk-ctx-form (list 'FORALL 'f (list 'IMPLIES '(IS-MEASURABLE-FN omega ca f) (list '= (list mr2-jj 'f) '(INTEGRAL omega ca nu f))))) g)
  (mr2-jjv! g)
  (subst (list '= (list 'INTEGRAL 'omega 'ca 'nu g) (list mr2-jj g)))
  (subst (list '= (list mr2-jj g) (mr2-J g)))
  (if (mr2-open?) (rfl)))
(mr2-qed! 'density-change)

;;; ===========================================================================
;;; (5) the reciprocal of a nonnegative measurable real function, set to 0 where it vanishes, is measurable
;;; ===========================================================================
;; a < 1/t  <=>  a t < 1   (t > 0)
(sp (make-wff '(FORALL a (FORALL t (IMPLIES (IN a RR) (IMPLIES (IN t RR) (IMPLIES (< 0 t) (IFF (< a (recip t)) (< (* a t) 1)))))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'nn-one-in)
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-have! '(NOT (= t 0)) (lambda () (di) (dk-absurd! '(IN t RR) '(= t 0) '(< 0 t))))
(mr2-and! '(IN t RR) '(NOT (= t 0)))
(dk-cite! 'rr-recip-closed 't) (dk-cite! 'rr-recip-inverse 't) (dk-cite! 'rr-recip-pos 't)
(define mr2-rt (dk-name! '(recip t)))
(dk-rewrite-h! '(= (* t (recip t)) 1) '(recip t) mr2-rt)
(dk-have! (list '< 0 mr2-rt) (lambda () (subst (list '= mr2-rt '(recip t))) (dk-ass!)))
(subst (list '= '(recip t) mr2-rt))
(dk-type! '(* a t))
(define mr2-p (dk-name! '(* a t)))
(dk-have! (list '= 'a (list '* mr2-p mr2-rt))
  (lambda () (subst (list '= mr2-p '(* a t)))
             (dk-have! (list '= (list '* '(* a t) mr2-rt) (list '* 'a (list '* 't mr2-rt))) (lambda () (crs)))
             (subst (list '= (list '* '(* a t) mr2-rt) (list '* 'a (list '* 't mr2-rt))))
             (subst (list '= (list '* 't mr2-rt) 1))
             (if (mr2-open?) (crs))))
(dk-have! (list '= 1 (list '* mr2-rt 't))
  (lambda () (dk-have! (list '= (list '* mr2-rt 't) (list '* 't mr2-rt)) (lambda () (crs)))
             (subst (list '= (list '* mr2-rt 't) (list '* 't mr2-rt))) (subst (list '= (list '* 't mr2-rt) 1)) (if (mr2-open?) (arith))))
(dk-have! '(<= 0 t) (lambda () (dk-ineq! '(IN t RR) '(< 0 t))))
(dk-have! (list '<= 0 mr2-rt) (lambda () (dk-ineq! (list 'IN mr2-rt 'RR) (list '< 0 mr2-rt))))
(dk-iff! (lambda (g) (equal? g '(< (* a t) 1)))
  (lambda ()
    (subst (list '= '(* a t) mr2-p))
    (pbc)
    (dk-have! (list '<= 1 mr2-p) (lambda () (pbc) (dk-cite! 'rr-not-le-lt 1 mr2-p) (ai (list 'NOT (list '< mr2-p 1)))))
    (dk-cite! 'rr-mul-le-right 1 mr2-p mr2-rt)
    (dk-type! (list '* 1 mr2-rt)) (dk-type! (list '* mr2-p mr2-rt))
    (dk-have! (list '= (list '* 1 mr2-rt) mr2-rt) (lambda () (crs)))
    (dk-absurd! '(IN a RR) (list 'IN mr2-rt 'RR) (list 'IN (list '* 1 mr2-rt) 'RR) (list 'IN (list '* mr2-p mr2-rt) 'RR)
                (list '< 'a mr2-rt) (list '= 'a (list '* mr2-p mr2-rt)) (list '= (list '* 1 mr2-rt) mr2-rt)
                (list '<= (list '* 1 mr2-rt) (list '* mr2-p mr2-rt))))
  (lambda ()
    (pbc)
    (dk-have! (list '<= mr2-rt 'a) (lambda () (pbc) (dk-cite! 'rr-not-le-lt mr2-rt 'a) (ai (list 'NOT (list '< 'a mr2-rt)))))
    (dk-cite! 'rr-mul-le-right mr2-rt 'a 't)
    (dk-type! (list '* mr2-rt 't))
    (dk-absurd! '(IN (* a t) RR) '(IN 1 RR) (list 'IN (list '* mr2-rt 't) 'RR)
                '(< (* a t) 1) (list '= 1 (list '* mr2-rt 't)) (list '<= (list '* mr2-rt 't) '(* a t)))))
(mr2-qed! 'recip-compare)

(define mr2-R '(VNB-LAMBDA rrx_ omega (IF (< 0 (h rrx_)) (recip (h rrx_)) 0)))
(define mr2-hreal '(FORALL rhx_ (IMPLIES (IN rhx_ omega) (IN (h rhx_) RR))))
(sp (make-wff (mr2-alls '(omega ca h) (mr2-imps (list '(IS-MEASURABLE-FN omega ca h) mr2-hreal) (list 'IS-MEASURABLE-FN 'omega 'ca mr2-R)))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'nn-one-in)
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
(dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
(mr2-rps! 0) (mr2-rps! 1)
(dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measurable-fn '(IS-MEASURABLE-FN omega ca h))
(dk-project! '(IN h (FUN omega RR-POS-STAR)) 'is-measurable-fn '(IS-MEASURABLE-FN omega ca h))
(dk-cite! 'sigma-algebra-ambient-set 'omega 'ca)
(define (mr2-hx! x)                    ; x in omega: h x real, nonneg
  (dk-apply! (dk-ctx-form mr2-hreal) x)
  (dk-cite! 'fun-apply-type-c 'h 'omega 'RR-POS-STAR x)
  (dk-cite! 'rr-pos-star-nonneg (list 'h x)))
(define (mr2-Rx! x k)                  ; x in omega: K with (= (R x) value) where value is recip or 0, case-wise
  (mr2-hx! x)
  (let* ((hx (list 'h x))
         (pos (lambda ()
                (dk-have! (list 'NOT (list '= hx 0)) (lambda () (di) (dk-absurd! (list 'IN hx 'RR) (list '= hx 0) (list '< 0 hx))))
                (mr2-and! (list 'IN hx 'RR) (list 'NOT (list '= hx 0)))
                (dk-cite! 'rr-recip-closed hx)
                (dk-cite! 'rr-recip-pos hx)
                (dk-have! (list '<= 0 (list 'recip hx)) (lambda () (dk-ineq! (list 'IN (list 'recip hx) 'RR) (list '< 0 (list 'recip hx)))))
                (mr2-rps! (list 'recip hx))
                (dk-have! (list '= (list mr2-R x) (list 'recip hx))
                  (lambda () (mr2-beta!) (if (mr2-open?) (dk-if-branch! #t (cadr (dk-goal)) (lambda () (dk-ass!)) (lambda () (if (mr2-open?) (rfl)))))))
                (k #t (list 'recip hx))))
         (neg (lambda ()
                (dk-have! (list '= (list mr2-R x) 0)
                  (lambda () (mr2-beta!) (if (mr2-open?) (dk-if-branch! #f (cadr (dk-goal)) (lambda () (dk-ass!)) (lambda () (if (mr2-open?) (rfl)))))))
                (k #f 0))))
    (cond ((dk-asm? (list '< 0 hx)) (pos))
          ((dk-asm? (list 'NOT (list '< 0 hx))) (neg))
          (#t (use-em (list '< 0 hx) pos neg)))))
(dk-have! (list 'IN mr2-R '(FUN omega RR-POS-STAR))
  (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!)))
                                        (mr2-Rx! x (lambda (pos? v)
                                                     (if (mr2-open?)
                                                         (dk-if-branch! pos? (cadr (dk-goal))
                                                                        (lambda () (dk-ass!))
                                                                        (lambda () (if (mr2-open?) (dk-ass!)))))))))
                           (lambda () (dk-ass!)))))
(define mr2-A '(SEP x_ omega (< 0 (h x_))))
(dk-project! '(FORALL alpha_ (IMPLIES (IN alpha_ RR) (IN (SEP x_ omega (< alpha_ (h x_))) ca))) 'is-measurable-fn '(IS-MEASURABLE-FN omega ca h))
(dk-apply! (dk-ctx-form '(FORALL alpha_ (IMPLIES (IN alpha_ RR) (IN (SEP x_ omega (< alpha_ (h x_))) ca)))) 0)
(dk-cite! 'measurable-fn-const 'omega 'ca 1)
(define mr2-one '(VNB-LAMBDA cx_ omega 1))
(dk-have! (list 'FORALL 'al_ (list 'IMPLIES '(IN al_ RR) (list 'IMPLIES '(<= 0 al_) (list 'IN (list 'SEP 'x_ 'omega (list '< 'al_ (list mr2-R 'x_))) 'ca))))
  (lambda ()
    (let* ((ld (dk-peel!)) (al (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'RR))) ld)))
           (v (list 'PTWISE-SCALE 'omega al 'h))
           (bset (list 'SEP 'x_ 'omega (list '< (list v 'x_) (list mr2-one 'x_))))
           (cset (list 'INTERSECTION mr2-A bset))
           (tset (list 'SEP 'x_ 'omega (list '< al (list mr2-R 'x_)))))
      (mr2-rps! al)
      (dk-cite! 'ptwise-scale-measurable 'omega 'ca 'h al)
      (dk-cite! 'measurable-fn-lt-set 'omega 'ca mr2-one v)
      (dk-cite! 'sigma-algebra-inter-closed-2 'omega 'ca mr2-A bset)
      (define (vx! x)                  ; v x = al * h x, one x = 1
        (mr2-hx! x)
        (dk-cite! 'ptwise-scale-value 'omega al 'h x)
        (dk-cite! 'etimes-real-defined al (list 'h x))
        (dk-cite! 'bintimes-apply al (list 'h x))
        (dk-type! (list '* al (list 'h x)))
        (dk-have! (list '= (list v x) (list '* al (list 'h x)))
          (lambda () (subst (list '= (list v x) (list 'etimes al (list 'h x))))
                     (subst (list '= (list 'etimes al (list 'h x)) (list 'bintimes al (list 'h x))))
                     (subst (list '== (list 'bintimes al (list 'h x)) (list '* al (list 'h x))))
                     (if (mr2-open?) (rfl))))
        (dk-have! (list '= (list mr2-one x) 1) (lambda () (mr2-beta!) (if (mr2-open?) (rfl)))))
      (dk-have! (list '= tset cset)
        (lambda ()
          (dk-have! (list 'FORALL 'mszx_ (list 'IFF (list 'IN 'mszx_ tset) (list 'IN 'mszx_ cset)))
            (lambda ()
              (let ((x (begin (di) (cadr (cadr (dk-goal))))))
                (dk-cite! 'intersection-membership mr2-A bset x)
                (dk-iff! (lambda (gg) (equal? gg (list 'IN x cset)))
                  (lambda ()
                    (sep-me (dk-ctx-form (list 'IN x tset))) (dk-split-all!)
                    (vx! x)
                    (mr2-Rx! x
                      (lambda (pos? val)
                        (if pos?
                            (let ((rc (dk-cite! 'recip-compare al (list 'h x))))
                              (dk-rewrite-h! (dk-ctx-form (list '< al (list mr2-R x))) (list mr2-R x) val)
                              (dk-have! (list '< (list '* al (list 'h x)) 1) (lambda () (if (dk-only! rc (list '< al val)) (prop))))
                              (dk-have! (list 'IN x mr2-A) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
                              (dk-have! (list 'IN x bset) (lambda () (in-sep! (lambda () (dk-ass!))
                                                                    (lambda () (subst (list '= (list v x) (list '* al (list 'h x))))
                                                                               (subst (list '= (list mr2-one x) 1)) (dk-ass!)))))
                              (if (dk-only! (dk-ctx-form (list 'IFF (list 'IN x cset) (list 'AND (list 'IN x mr2-A) (list 'IN x bset)))) (list 'IN x mr2-A) (list 'IN x bset)) (prop)))
                            (begin
                              (dk-rewrite-h! (dk-ctx-form (list '< al (list mr2-R x))) (list mr2-R x) 0)
                              (dk-absurd! (list 'IN al 'RR) '(<= 0 al_) (list '< al 0)))))))
                  (lambda ()
                    (dk-have! (list 'AND (list 'IN x mr2-A) (list 'IN x bset))
                      (lambda () (if (dk-only! (dk-ctx-form (list 'IFF (list 'IN x cset) (list 'AND (list 'IN x mr2-A) (list 'IN x bset)))) (list 'IN x cset)) (prop))))
                    (dk-split-all! (list (list 'AND (list 'IN x mr2-A) (list 'IN x bset))))
                    (sep-me (dk-ctx-form (list 'IN x mr2-A))) (dk-split-all!)
                    (sep-me (dk-ctx-form (list 'IN x bset))) (dk-split-all!)
                    (vx! x)
                    (in-sep! (lambda () (dk-ass!))
                      (lambda ()
                        (mr2-Rx! x
                          (lambda (pos? val)
                            (if pos?
                                (let ((rc (dk-cite! 'recip-compare al (list 'h x))))
                                  (dk-rewrite-h! (dk-ctx-form (list '< (list v x) (list mr2-one x))) (list v x) (list '* al (list 'h x)))
                                  (dk-rewrite-h! (dk-ctx-form (list '< (list '* al (list 'h x)) (list mr2-one x))) (list mr2-one x) 1)
                                  (dk-have! (list '< al val) (lambda () (if (dk-only! rc (list '< (list '* al (list 'h x)) 1)) (prop))))
                                  (subst (list '= (list mr2-R x) val))
                                  (dk-ass!))
                                (ai (list 'NOT (list '< 0 (list 'h x))))))))))))))
          (dk-cite! 'class-extensionality tset cset)
          (if (mr2-open?) (dk-ass!))))
      (subst (list '= tset cset))
      (dk-ass!))))
(mr2-and! '(IS-SIGMA-ALGEBRA omega ca) (list 'IN mr2-R '(FUN omega RR-POS-STAR)))
(dk-cite! 'measurable-fn-of-nonneg-tails 'omega 'ca mr2-R)
(if (mr2-open?) (dk-ass!))
(mr2-qed! 'measurable-fn-recip)

;;; ===========================================================================
;;; (6) RADON-NIKODYM FOR FINITE MEASURES (Theorem 3.10, the converse, mu and nu finite)
;;;     rho = mu + nu; mu = f rho, nu = h rho (rn-finite-dominated); nu(h = 0) = 0, so mu(h = 0) = 0 and
;;;     f = 0 rho-a.e. there; q = f / h on {h > 0}; mu(A) = int f 1_A drho = int h (q 1_A) drho = int q 1_A dnu.
;;; ===========================================================================
(define mr2-rnconc
  '(FORSOME rnq_ (AND (IS-MEASURABLE-FN omega ca rnq_)
     (FORALL rna_ (IMPLIES (IN rna_ ca) (= (mu rna_) (INTEGRAL omega ca nu (PTWISE-ETIMES omega rnq_ (INDICATOR omega rna_)))))))))
(sp (make-wff (mr2-alls '(omega ca mu nu) (mr2-imps (list '(IS-MEASURE omega ca mu) '(IS-MEASURE omega ca nu) '(IN (mu omega) RR) '(IN (nu omega) RR)
                                                         '(IS-ABSOLUTELY-CONTINUOUS omega ca mu nu))
   mr2-rnconc))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'nn-one-in) (fact 'nn-is-set)
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
(dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
(mr2-rps! 0) (mr2-rps! 1)
(dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measure '(IS-MEASURE omega ca mu))
(dk-project! '(IN mu (FUN ca RR-POS-STAR)) 'is-measure '(IS-MEASURE omega ca mu))
(dk-project! '(IN nu (FUN ca RR-POS-STAR)) 'is-measure '(IS-MEASURE omega ca nu))
(dk-cite! 'sigma-algebra-ambient-set 'omega 'ca)
(dk-cite! 'sigma-algebra-whole-in 'omega 'ca)
(dk-cite! 'measure-sum 'omega 'ca 'mu 'nu)
(define mr2-rh mr2-rho)
(define (mr2-rhv! a)                   ; a in ca: (= (rho a) (eplus (mu a) (nu a))), typings
  (dk-cite! 'fun-apply-type-c 'mu 'ca 'RR-POS-STAR a)
  (dk-cite! 'fun-apply-type-c 'nu 'ca 'RR-POS-STAR a)
  (mr2-and! (list 'IN (list 'mu a) 'RR-POS-STAR) (list 'IN (list 'nu a) 'RR-POS-STAR))
  (dk-cite! 'eplus-closed (list 'mu a) (list 'nu a))
  (let ((e (list '= (list mr2-rh a) (list 'eplus (list 'mu a) (list 'nu a)))))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (mr2-beta!) (if (mr2-open?) (rfl)))))
    e))
;; rho(omega) is finite
(mr2-rhv! 'omega)
