(sp (make-wff (mr3-alls '(omega ca mu nu)
   (mr3-imps '((IS-MEASURE omega ca mu) (IS-MEASURE omega ca nu) (IS-SIGMA-FINITE omega ca mu) (IS-SIGMA-FINITE omega ca nu)
