;;; mh-hausdorff.scm -- construction-of-measures.pdf ch. 4 section 4: Hausdorff measures.
;;; Props 4.32, 4.38 (comparison for comparable metrics), 4.53 (Hausdorff dimension), 4.54 (local
;;; dimension), 4.55 (restriction to a subspace).  Needs mh-vocab and mh-method2.  Helper prefix mhh-.

;;; ---- helper defines COPIED 2026-10-27 (integration) from method-ii: this file loads in its own environment
(define (mh2-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "mh2-pick: nothing matching" what) (car l))))
(define (mh2-split-goal!)
  (let loop ((todo (list (proof-state-focus *ps*))) (acc '()))
    (if (null? todo) (reverse acc)
        (begin (dk-focus! (car todo))
               (if (dk-head-is? (dk-goal) 'AND)
                   (loop (append (dk-opened (lambda () (di))) (cdr todo)) acc)
                   (loop (cdr todo) (cons (car todo) acc)))))))
(define (mh2-diam-set m a)
  (list 'SEP 'mhw_ 'RR-POS-STAR (list 'FORSOME 'mhx_ (list 'AND (list 'IN 'mhx_ a)
        (list 'FORSOME 'mhy_ (list 'AND (list 'IN 'mhy_ a) (list '= 'mhw_ (list (list 'DIST m) 'mhx_ 'mhy_))))))))
(define (mh2-sep-sub! s)
  (dk-have! (list 'SUBSET s (caddr s))
    (lambda () (mac 'subset-def) (di)
               (sep-me (mh2-pick 'member (lambda (z) (and (dk-head-is? z 'IN) (equal? (caddr z) s)))))
               (ass))))
(define (mh2-esum-type! fv)
  (fact 'nn-is-set)
  (dk-project! (list 'IN fv '(FUN NN)) 'fun-codomain-iff (list 'IN fv '(FUN NN RR-POS-STAR)))
  (dk-have! (list 'AND (list 'IN fv '(FUN NN)) '(IN NN SET)))
  (fact 'dom-of-fun 'NN fv)
  (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN (list 'DOM fv) 'SET) (list '= (list 'DOM fv) 'NN)))))
  (dk-have! (list 'IN fv (list 'FUN (list 'DOM fv) 'RR-POS-STAR))
            (lambda () (subst (list '= (list 'DOM fv) 'NN)) (ass)))
  (fact 'esum-in fv))
;;; ---- end of copied helpers ----

(define (mhh-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "mhh-pick: nothing matching" what) (car l))))
(define (mhh-rps! t)                       ; (IN t RR-POS-STAR) from (IN t RR), (<= 0 t)
  (if (not (dk-asm? (list 'IN t 'RR-POS-STAR)))
      (dk-have! (list 'IN t 'RR-POS-STAR)
        (lambda () (mac 'rr-pos-star-membership) (oi-l) (dk-conj-close! (lambda () (ass)))))))
(define (mhh-and! . fs)
  (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l))))))
(define (mhh-have-and! . fs) (dk-have! (apply mhh-and! fs)))
(define (mhh-le-trans! x y z)
  (mhh-have-and! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR) (list 'IN z 'RR-POS-STAR))
  (mhh-have-and! (list '<= x y) (list '<= y z))
  (fact 'rr-pos-star-le-trans x y z))

;;; ---------------------------------------------------------------------------
;;; b <= k.v for every v in S (k > 0 real)  ==>  b <= k.einf(S)
(sp (make-wff (forall-guarded '(s k b)
  '((SUBSET s RR-POS-STAR) (IN k RR) (< 0 k) (IN b RR-POS-STAR)
    (FORALL v (IMPLIES (IN v s) (<= b (etimes k v)))))
  '(<= b (etimes k (EINF s))))))
(dk-peel!)
(define mhh1-h (mhh-pick 'h (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'etimes)))))
(fact 'rr-pos-ne-zero 'k)
(dk-have! '(AND (IN k RR) (NOT (= k 0))))
(fact 'rr-recip-closed 'k)
(fact 'rr-recip-pos 'k)
(fact 'rr-recip-inverse 'k)
(dk-have! '(= (* (recip k) k) (* k (recip k))) (lambda () (dk-crs-opaque!)))
(dk-have! '(= (* (recip k) k) 1) (lambda () (subst '(= (* (recip k) k) (* k (recip k)))) (ass)))
(fact 'rr-lt-implies-le 0 'k)
(fact 'rr-lt-implies-le 0 '(recip k))
(mhh-rps! 'k) (mhh-rps! '(recip k))
(define mhh1-bp '(etimes (recip k) b))
(dk-have! '(AND (IN (recip k) RR-POS-STAR) (IN b RR-POS-STAR)))
(fact 'etimes-closed '(recip k) 'b)
(fact 'einf-in 's)
(dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x s) (list '<= mhh1-bp 'x)))
  (lambda ()
    (let* ((pl (dk-peel!)) (v (cadr (car pl))) (kv (list 'etimes 'k v)))
      (fact 'subset-mem-fwd 's 'RR-POS-STAR v)
      (inst+ mhh1-h v)
      (dk-have! (list 'AND '(IN k RR-POS-STAR) (list 'IN v 'RR-POS-STAR)))
      (fact 'etimes-closed 'k v)
      (fact 'rr-pos-star-le-refl '(recip k))
      (fact 'etimes-mono-star '(recip k) '(recip k) 'b kv)
      (fact 'etimes-assoc-real '(recip k) 'k v)
      (fact 'etimes-one-left v)
      (dk-rewrite-h! (list '<= mhh1-bp (list 'etimes '(recip k) kv)) (list 'etimes '(recip k) kv) (list 'etimes '(* (recip k) k) v))
      (dk-rewrite-h! (list '<= mhh1-bp (list 'etimes '(* (recip k) k) v)) '(* (recip k) k) 1)
      (dk-rewrite-h! (list '<= mhh1-bp (list 'etimes 1 v)) (list 'etimes 1 v) v)
      (ass))))
(fact 'einf-greatest 's)
(inst+ (mhh-pick 'gr (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'cpsb_) (not (dk-contains? z 'cpss_))))) mhh1-bp)
(fact 'rr-pos-star-le-refl 'k)
(fact 'etimes-mono-star 'k 'k mhh1-bp '(EINF s))
(fact 'etimes-assoc-real 'k '(recip k) 'b)
(fact 'etimes-one-left 'b)
(dk-rewrite-h! (list '<= (list 'etimes 'k mhh1-bp) '(etimes k (EINF s))) (list 'etimes 'k mhh1-bp) '(etimes (* k (recip k)) b))
(dk-rewrite-h! '(<= (etimes (* k (recip k)) b) (etimes k (EINF s))) '(* k (recip k)) 1)
(dk-rewrite-h! '(<= (etimes 1 b) (etimes k (EINF s))) '(etimes 1 b) 'b)
(ass)
(qed 'einf-etimes-bound)

;;; ---------------------------------------------------------------------------
;;; THE COMPARISON LEMMA behind 4.32 and 4.38: two metrics on one set, DIAM <= c DIAM1 and
;;; p <= k p1 on every subset  ==>  METHOD-II(p) <= k METHOD-II(p1).  A cover by sets of
;;; d1-diameter <= delta/c is a cover by sets of d-diameter <= delta.
(define mhh-P '(POWER (PTS m)))
(define mhh-P1 '(POWER (PTS m1)))
(define (mhh-cd mm cls d) (list 'SEP 'mha_ cls (list '<= (list 'DIAM mm 'mha_) d)))
(define (mhh-r pp mm cls d) (list 'RESTRICT pp (mhh-cd mm cls d)))
(define (mhh-cs mm cls pp d es) (list 'COVER-SUMS (list 'PTS mm) (mhh-cd mm cls d) (mhh-r pp mm cls d) es))
(define mhh-cmp-hyps
  '((IS-METRIC-SPACE m) (IS-METRIC-SPACE m1) (= (PTS m1) (PTS m))
    (IS-PREMEASURE (PTS m) (POWER (PTS m)) p) (IS-PREMEASURE (PTS m1) (POWER (PTS m1)) p1)
    (IN c RR) (< 0 c) (IN k RR) (< 0 k)
    (FORALL a (IMPLIES (IN a (POWER (PTS m))) (<= (DIAM m a) (etimes c (DIAM m1 a)))))
    (FORALL a (IMPLIES (IN a (POWER (PTS m))) (<= (p a) (etimes k (p1 a)))))
    (IN es (POWER (PTS m)))))
(define (mhh-pre-parts! pp mm)
  (let ((h (list 'IS-PREMEASURE (list 'PTS mm) (list 'POWER (list 'PTS mm)) pp)))
    (for-each (lambda (c) (dk-project! c 'is-premeasure h))
              (list (list 'IN (list 'PTS mm) 'SET) (list 'IN pp (list 'FUN (list 'POWER (list 'PTS mm)) 'RR-POS-STAR))))))
(sp (make-wff (forall-guarded '(m m1 p p1 c k es) mhh-cmp-hyps
  '(<= ((METHOD-II m (POWER (PTS m)) p) es) (etimes k ((METHOD-II m1 (POWER (PTS m1)) p1) es))))))
(dk-peel!)
(define mhh2-hd (mhh-pick 'hd (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'DIAM)))))
(define mhh2-hp (mhh-pick 'hp (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'p1) (not (dk-contains? z 'DIAM))))))
(mhh-pre-parts! 'p 'm) (mhh-pre-parts! 'p1 'm1)
(dk-have! (list 'IN 'es mhh-P1) (lambda () (subst '(= (PTS m1) (PTS m))) (ass)))
(define mhh2-mii1 '((METHOD-II m1 (POWER (PTS m1)) p1) es))
(define mhh2-mii '((METHOD-II m (POWER (PTS m)) p) es))
(fact 'method-ii-in 'm1 mhh-P1 'p1 'es)
(fact 'method-ii-in 'm mhh-P 'p 'es)
(fact 'rr-lt-implies-le 0 'k) (mhh-rps! 'k)
(fact 'rr-lt-implies-le 0 'c) (mhh-rps! 'c)
(dk-have! (list 'AND '(IN k RR-POS-STAR) (list 'IN mhh2-mii1 'RR-POS-STAR)))
(fact 'etimes-closed 'k mhh2-mii1)
(fact 'rr-pos-ne-zero 'c)
(dk-have! '(AND (IN c RR) (NOT (= c 0))))
(fact 'rr-recip-closed 'c)
(fact 'rr-recip-pos 'c)
(fact 'nn-is-set)
(define (mhh2-delta! d)
  (let* ((d1 (list '* d '(recip c)))
         (cd (mhh-cd 'm mhh-P d)) (cd1 (mhh-cd 'm1 mhh-P1 d1))
         (r (mhh-r 'p 'm mhh-P d)) (r1 (mhh-r 'p1 'm1 mhh-P1 d1))
         (cs (mhh-cs 'm mhh-P 'p d 'es)) (cs1 (mhh-cs 'm1 mhh-P1 'p1 d1 'es))
         (x (list 'EINF cs)) (y (list 'EINF cs1)))
    (dk-pos-parts! d)
    (dk-have! (list 'AND (list 'IN d 'RR) '(IN (recip c) RR)))
    (fact 'rr-mul-closed d '(recip c))
    (fact 'rr-mul-pos d '(recip c))
    (fact 'rr-pos-rr-of-lt d1)
    (dk-pos-parts! d1)
    ;; c . d1 = d, also as etimes
    (fact 'rr-recip-cancel-right d 'c)
    (dk-have! (list '= (list '* 'c d1) (list '* d1 'c)) (lambda () (dk-crs-opaque!)))
    (dk-have! (list 'AND (list 'IN d1 'RR) '(IN c RR)))
    (fact 'rr-mul-closed d1 'c)
    (dk-have! (list 'AND '(IN c RR) (list 'IN d1 'RR)))
    (fact 'rr-mul-closed 'c d1)
    (dk-have! (list '= (list '* d1 'c) d) (lambda () (dk-ineq! (list '= d (list '* d1 'c)))))
    (dk-have! (list '= (list '* 'c d1) d) (lambda () (dk-ineq! (list '= (list '* 'c d1) (list '* d1 'c)) (list '= (list '* d1 'c) d))))
    (fact 'etimes-real-defined 'c d1)
    (dk-have! (list '= (list 'etimes 'c d1) d)
      (lambda () (subst (list '= (list 'etimes 'c d1) (list 'bintimes 'c d1)))
                 (dk-have! (list '= (list 'bintimes 'c d1) (list '* 'c d1)) (lambda () (crs)))
                 (subst (list '= (list 'bintimes 'c d1) (list '* 'c d1)))
                 (ass)))
    (mh2-sep-sub! cd)
    ;; the premeasures at scale
    (fact 'method-ii-delta-premeasure 'm mhh-P 'p d)
    (fact 'method-ii-delta-premeasure 'm1 mhh-P1 'p1 d1)
    (for-each (lambda (pr) (dk-project! (list 'IN (car pr) (list 'FUN (cadr pr) 'RR-POS-STAR)) 'is-premeasure (caddr pr)))
              (list (list r cd (list 'IS-PREMEASURE '(PTS m) cd r)) (list r1 cd1 (list 'IS-PREMEASURE '(PTS m1) cd1 r1))))
    (fact 'cover-sums-subset '(PTS m) cd r 'es)
    (fact 'cover-sums-subset '(PTS m1) cd1 r1 'es)
    (fact 'einf-in cs) (fact 'einf-in cs1)
    (fact 'einf-lower cs)
    ;; CD1 subset CD
    (dk-have! (list 'SUBSET cd1 cd)
      (lambda ()
        (mac 'subset-def)
        (let* ((pl (dk-peel!)) (a (cadr (car pl))))
          (dk-project! (list 'IN a mhh-P1) (lambda () (sep-me (list 'IN a cd1))))
          (dk-project! (list '<= (list 'DIAM 'm1 a) d1) (lambda () (sep-me (list 'IN a cd1))))
          (dk-have! (list 'IN a mhh-P) (lambda () (subst '(= (PTS m) (PTS m1))) (ass)))
          (inst+ mhh2-hd a)
          (fact 'diam-in 'm a) (fact 'diam-in 'm1 a)
          (mhh-rps! d1)
          (fact 'rr-pos-star-le-refl 'c)
          (fact 'etimes-mono-star 'c 'c (list 'DIAM 'm1 a) d1)
          (dk-have! (list 'AND '(IN c RR-POS-STAR) (list 'IN (list 'DIAM 'm1 a) 'RR-POS-STAR)))
          (fact 'etimes-closed 'c (list 'DIAM 'm1 a))
          (dk-have! (list 'AND '(IN c RR-POS-STAR) (list 'IN d1 'RR-POS-STAR)))
          (fact 'etimes-closed 'c d1)
          (mhh-le-trans! (list 'DIAM 'm a) (list 'etimes 'c (list 'DIAM 'm1 a)) (list 'etimes 'c d1))
          (in-sep! (lambda () (subst (list '= d (list 'etimes 'c d1))) (ass))))))
    ;; every v in CS1:  x <= k.v
    (dk-have! (list 'FORALL 'v (list 'IMPLIES (list 'IN 'v cs1) (list '<= x (list 'etimes 'k 'v))))
      (lambda ()
        (let* ((pl (dk-peel!)) (v (cadr (car pl)))
               (ex (dk-cite! 'cover-sums-elim '(PTS m1) cd1 r1 'es v))
               (sq (dk-skolem! ex #t))
               (l1 (list 'VNB-LAMBDA 'cvk_ 'NN (list r1 (list sq 'cvk_))))
               (l0 (list 'VNB-LAMBDA 'cvk_ 'NN (list r (list sq 'cvk_))))
               (lh (list 'VNB-LAMBDA 'cvk_ 'NN (list 'etimes 'k (list r1 (list sq 'cvk_))))))
          (fact 'fun-codomain-superset sq 'NN cd1 cd)
          (define (lam-typed! lam body!)
            (dk-have! (list 'IN lam '(FUN NN RR-POS-STAR))
              (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (body! j) (ass))) (lambda () (ass))))))
          (define (r1-typed! j) (fact 'fun-apply-type-c sq 'NN cd1 j) (fact 'fun-apply-type-c r1 cd1 'RR-POS-STAR (list sq j)))
          (define (r0-typed! j) (fact 'fun-apply-type-c sq 'NN cd j) (fact 'fun-apply-type-c r cd 'RR-POS-STAR (list sq j)))
          (lam-typed! l1 r1-typed!)
          (lam-typed! l0 r0-typed!)
          (lam-typed! lh (lambda (j) (r1-typed! j)
                           (dk-have! (list 'AND '(IN k RR-POS-STAR) (list 'IN (list r1 (list sq j)) 'RR-POS-STAR)))
                           (fact 'etimes-closed 'k (list r1 (list sq j)))))
          ;; the cover is a d-cover
          (dk-have! (list 'SUBSET 'es (list 'BIG-UNION 'cvn_ 'NN (list sq 'cvn_))) (lambda () (ass)))
          (fact 'cover-sums-intro '(PTS m) cd r 'es sq)
          (inst+ (mhh-pick 'low (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z cs) (dk-contains? z 'EINF)))) (list 'ESUM l0))
          ;; termwise R(s j) <= k R1(s j)
          (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list '<= (list l0 'j) (list lh 'j))))
            (lambda ()
              (let ((j (dk-di-var!)))
                (r0-typed! j) (r1-typed! j)
                (dk-lam-b!)
                (fact 'subset-mem-fwd cd mhh-P (list sq j))
                (subst (dk-cite! 'restrict-apply 'p cd (list sq j)))
                (subst (dk-cite! 'restrict-apply 'p1 cd1 (list sq j)))
                (inst+ mhh2-hp (list sq j))
                (ass))))
          (fact 'esum-nn-le-termwise l0 lh)
          (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ NN) (list '= (list lh 'z_) (list 'etimes 'k (list l1 'z_)))))
            (lambda () (let ((j (dk-di-var!))) (r1-typed! j) (dk-lam-b!)
                         (dk-have! (list 'AND '(IN k RR-POS-STAR) (list 'IN (list r1 (list sq j)) 'RR-POS-STAR)))
                         (fact 'etimes-closed 'k (list r1 (list sq j)))
                         (rfl))))
          (fact 'esum-scale-ptwise 'k 'NN l1 lh)
          (mh2-esum-type! l0) (mh2-esum-type! lh) (mh2-esum-type! l1)
          (subst (list '= v (list 'ESUM l1)))
          (dk-have! (list 'AND '(IN k RR-POS-STAR) (list 'IN (list 'ESUM l1) 'RR-POS-STAR)))
          (fact 'etimes-closed 'k (list 'ESUM l1))
          (dk-rewrite-h! (list '<= (list 'ESUM l0) (list 'ESUM lh)) (list 'ESUM lh) (list 'etimes 'k (list 'ESUM l1)))
          (mhh-le-trans! x (list 'ESUM l0) (list 'etimes 'k (list 'ESUM l1)))
          (ass))))
    (fact 'einf-etimes-bound cs1 'k x)
    ;; and k.mu1_d1(E) <= k.mu1_0(E)
    (fact 'method-ii-delta-le 'm1 mhh-P1 'p1 'es d1)
    (subst (dk-cite! 'method-ii-delta-value 'm mhh-P 'p d 'es))
    (let ((v1 (dk-cite! 'method-ii-delta-value 'm1 mhh-P1 'p1 d1 'es)))
      (dk-rewrite-h! (list '<= (list (list 'METHOD-II-DELTA 'm1 mhh-P1 'p1 d1) 'es) mhh2-mii1)
                     (list (list 'METHOD-II-DELTA 'm1 mhh-P1 'p1 d1) 'es) y))
    (fact 'rr-pos-star-le-refl 'k)
    (fact 'etimes-mono-star 'k 'k y mhh2-mii1)
    (dk-have! (list 'AND '(IN k RR-POS-STAR) (list 'IN y 'RR-POS-STAR)))
    (fact 'etimes-closed 'k y)
    (mhh-le-trans! x (list 'etimes 'k y) (list 'etimes 'k mhh2-mii1))
    (ass)))
(dk-have! (list 'FORALL 'dl (list 'IMPLIES '(POS-RR dl)
             (list '<= (list (list 'METHOD-II-DELTA 'm mhh-P 'p 'dl) 'es) (list 'etimes 'k mhh2-mii1))))
  (lambda () (let* ((pl (dk-peel!)) (d (cadr (car pl)))) (mhh2-delta! d))))
(fact 'method-ii-least 'm mhh-P 'p 'es (list 'etimes 'k mhh2-mii1))
(ass)
(qed 'method-ii-compare)

;;; ---------------------------------------------------------------------------
;;; d <= c d1 pointwise  ==>  DIAM(A) <= c DIAM1(A)
(define mhh-dist-hyp '(FORALL x (IMPLIES (IN x (PTS m)) (FORALL y (IMPLIES (IN y (PTS m))
                        (<= ((DIST m) x y) (* c ((DIST m1) x y))))))))
(sp (make-wff (forall-guarded '(m m1 c a)
  (list '(IS-METRIC-SPACE m) '(IS-METRIC-SPACE m1) '(= (PTS m1) (PTS m)) '(IN c RR) '(< 0 c) mhh-dist-hyp
        '(IN a (POWER (PTS m))))
  '(<= (DIAM m a) (etimes c (DIAM m1 a))))))
(dk-peel!)
(define mhh3-h (mhh-pick 'h (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'DIST)))))
(fact 'rr-lt-implies-le 0 'c) (mhh-rps! 'c)
(dk-project! '(SUBSET a (PTS m)) (lambda () (mac-h 'power-set-membership '(IN a (POWER (PTS m)))) (dk-split-all!) (mac 'subset-def)))
(dk-have! '(SUBSET a (PTS m1)) (lambda () (subst '(= (PTS m1) (PTS m))) (ass)))
(fact 'diam-in 'm1 'a)
(dk-have! '(AND (IN c RR-POS-STAR) (IN (DIAM m1 a) RR-POS-STAR)))
(fact 'etimes-closed 'c '(DIAM m1 a))
(define mhh3-S (mh2-diam-set 'm 'a))
(mh2-sep-sub! mhh3-S)
(fact 'esup-in mhh3-S)
(dk-have! (list '= '(DIAM m a) (list 'ESUP mhh3-S)) (lambda () (mac 'DIAM) (rfl)))
(subst (list '= '(DIAM m a) (list 'ESUP mhh3-S)))
(let* ((S mhh3-S) (b '(etimes c (DIAM m1 a))))
  (dk-have! (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w S) (list '<= 'w b)))
    (lambda ()
      (let* ((pl (dk-peel!)) (w (cadr (car pl))))
        (sep-me (list 'IN w S))
        (let* ((x (dk-skolem! (mhh-pick 'x (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z w)))) #t))
               (y (dk-skolem! (mhh-pick 'y (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z w)))) #t))
               (d0 (list '(DIST m) x y)) (d1 (list '(DIST m1) x y)))
          (fact 'subset-mem-fwd 'a '(PTS m) x) (fact 'subset-mem-fwd 'a '(PTS m) y)
          (fact 'subset-mem-fwd 'a '(PTS m1) x) (fact 'subset-mem-fwd 'a '(PTS m1) y)
          (inst+ mhh3-h x)
          (inst+ (mhh-pick 'hx (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'DIST) (dk-contains? z x)))) y)
          (fact 'metric-dist-real 'm1 x y) (fact 'metric-pos 'm1 x y) (mhh-rps! d1)
          (fact 'metric-dist-real 'm x y)
          (fact 'diam-dist-le 'm1 'a x y)
          (fact 'etimes-real-defined 'c d1)
          (fact 'rr-pos-star-le-refl 'c)
          (fact 'etimes-mono-star 'c 'c d1 '(DIAM m1 a))
          (dk-have! (list '= (list 'bintimes 'c d1) (list '* 'c d1)) (lambda () (crs)))
          (dk-rewrite-h! (list '<= (list 'etimes 'c d1) b) (list 'etimes 'c d1) (list 'bintimes 'c d1))
          (dk-rewrite-h! (list '<= (list 'bintimes 'c d1) b) (list 'bintimes 'c d1) (list '* 'c d1))
          (subst (mhh-pick 'weq (lambda (z) (and (dk-head-is? z '=) (equal? (cadr z) w)))))
          (fact 'metric-pos 'm x y) (mhh-rps! d0)
          (dk-have! (list 'AND '(IN c RR) (list 'IN d1 'RR))) (fact 'rr-mul-closed 'c d1)
          (fact 'rr-leq-mul-nonneg 'c d1)
          (dk-have! (list 'AND '(<= 0 c) (list '<= 0 d1)))
          (fact 'rr-leq-mul-nonneg 'c d1)
          (mhh-rps! (list '* 'c d1))
