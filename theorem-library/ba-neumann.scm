;;; ---- the partial sums ----------------------------------------------------------------------
(define (ban-ind!) (let ((br (dk-use-induction-fixed!)))
  (list (cdr (assq 'base br)) (cdr (assq 'step br)) (cdr (assq 'ih br)) (cdr (assq 'var br)))))
(define (ban-s0! x) (fact 'NEUMANN-SUM-zero 'a x) (subst (list '== (ban-s x 0) ban-zero)))
(define (ban-ss! x v) (fact 'NEUMANN-SUM-succ 'a x v)
  (subst (list '== (ban-s x (list 'succ v)) (ban-ad (ban-s x v) (ban-p x v)))))

(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a)
  (FORALL x (IMPLIES (IN x (VEC a)) (IN (NEUMANN-SUM a x n) (VEC a))))))))))
(let* ((br (ban-ind!)) (base (car br)) (step (cadr br)) (ih (caddr br)) (v (cadddr br)))
  (dk-focus! base)
  (dk-peel!)
  (ban-s0! 'x)
  (ban-vt ban-zero) (dk-ass!)
  (dk-focus! step)
  (dk-peel!)
  (ban-ss! 'x v)
  (dk-apply! ih 'x)
  (ban-vt (ban-p 'x v))
  (dk-cite! 'ring-add-closed-uba-as-ring 'a (ban-s 'x v) (ban-p 'x v))
  (dk-ass!))
(ban-qed! 'ban-nsum-type)

