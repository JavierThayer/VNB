;;; (1 - x) S_n = 1 - x^n   and   S_n (1 - x) = 1 - x^n
(define (ban-nsum-side! name side)
  (sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a)
    (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
      (list '= (if (eq? side 'left) (ban-m ban-om (ban-s 'x 'n)) (ban-m (ban-s 'x 'n) ban-om))
               (ban-sb ban-one (ban-p 'x 'n)))))))))))
  (let* ((br (ban-ind!)) (base (car br)) (step (cadr br)) (ih (caddr br)) (v (cadddr br)))
    (dk-focus! base)
    (dk-peel!)
    (ban-s0! 'x)
    (fact 'EL-POW-zero 'a 'x) (subst (list '== (ban-p 'x 0) ban-one))
    (ban-vt ban-om)
    (if (eq? side 'left)
        (begin (dk-cite! 'ring-mul-zero-right-uba-as-ring 'a ban-om)
               (ban-rw! (ban-m ban-om ban-zero) ban-zero))
        (begin (dk-cite! 'ring-mul-zero-left-uba-as-ring 'a ban-om)
               (ban-rw! (ban-m ban-zero ban-om) ban-zero)))
    (dk-cite! 'ring-add-right-inv-uba-as-ring 'a ban-one)
    (ban-rw! (ban-sb ban-one ban-one) ban-zero)
    (rfl)
    (dk-focus! step)
    (dk-peel!)
    (let* ((sv (ban-s 'x v)) (pv (ban-p 'x v)))
      (dk-apply! ih 'x)
      (ban-vt sv) (ban-vt pv) (ban-vt ban-om)
      (ban-ss! 'x v)
      (if (eq? side 'left)
          (begin
            (fact 'EL-POW-succ 'a 'x v)
            (subst (list '== (ban-p 'x (list 'succ v)) (ban-m 'x pv)))
            (dk-cite! 'ring-left-dist-uba-as-ring 'a ban-om sv pv)
            (ban-rw! (ban-m ban-om (ban-ad sv pv)) (ban-ad (ban-m ban-om sv) (ban-m ban-om pv)))
            (ban-rw! (ban-m ban-om sv) (ban-sb ban-one pv))
            (dk-cite! 'ban-one-minus-left 'a 'x pv)
            (ban-rw! (ban-m ban-om pv) (ban-sb pv (ban-m 'x pv)))
            (ban-vt (ban-m 'x pv))
            (dk-cite! 'ban-telescope 'a ban-one pv (ban-m 'x pv)))
          (begin
            (dk-cite! 'bae-el-pow-succ-right v 'a 'x)
            (ban-rw! (ban-p 'x (list 'succ v)) (ban-m pv 'x))
            (dk-cite! 'ring-right-dist-uba-as-ring 'a sv pv ban-om)
            (ban-rw! (ban-m (ban-ad sv pv) ban-om) (ban-ad (ban-m sv ban-om) (ban-m pv ban-om)))
            (ban-rw! (ban-m sv ban-om) (ban-sb ban-one pv))
            (dk-cite! 'ban-one-minus-right 'a 'x pv)
            (ban-rw! (ban-m pv ban-om) (ban-sb pv (ban-m pv 'x)))
            (ban-vt (ban-m pv 'x))
            (dk-cite! 'ban-telescope 'a ban-one pv (ban-m pv 'x))))
      (dk-ass!)))
  (ban-qed! name))
(ban-nsum-side! 'ban-nsum-left 'left)
(ban-nsum-side! 'ban-nsum-right 'right)

;;; ||S_n - S_(n+1)|| = ||x^n||, bounded by ||x||^n
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a)
  (FORALL x (IMPLIES (IN x (VEC a))
    (<= ((DIST (BA-METRIC-SPACE a)) (NEUMANN-SUM a x n) (NEUMANN-SUM a x (succ n))) (POWER ((VNRM a) x) n))))))))))
(dk-peel!)
(let* ((sn (ban-s 'x 'n)) (pn (ban-p 'x 'n)) (s1 (ban-s 'x '(succ n))))
  (ban-vt sn) (ban-vt pn)
  (dk-cite! 'nn-succ-closed 'n)
  (ban-vt s1)
  (dk-cite! 'ban-dist 'a sn s1)
  (ban-rw! (ban-dist sn s1) (ban-nr (ban-sb sn s1)))
  (dk-cite! 'ban-dist-sym 'a sn s1)
  (ban-rw! (ban-nr (ban-sb sn s1)) (ban-nr (ban-sb s1 sn)))
  (ban-ss! 'x 'n)
  (dk-cite! 'ring-add-comm-uba-as-ring 'a sn pn)
  (ban-rw! (ban-ad sn pn) (ban-ad pn sn))
  (dk-cite! 'fom-v-shift-back-uba-as-module 'a pn sn)
  (ban-rw! (ban-sb (ban-ad pn sn) sn) pn)
  (dk-cite! 'bae-el-pow-norm 'n 'a 'x)
  (dk-ass!))
(ban-qed! 'ban-nsum-step)

;;; ---- sequences in the algebra ---------------------------------------------------------------
;;; (ban-dist-rr! u v) -- u, v typed in VEC: land dist(u, v) = ||u - v|| and dist(u, v) in RR
(define (ban-dist-rr! u v)
  (ban-vt u) (ban-vt v)
  (let ((d (ban-dist u v)))
    (dk-cite! 'ban-dist 'a u v)
    (ban-vt (ban-sb u v))
    (dk-cite! 'bae-vnrm-type 'a (ban-sb u v))
    (if (not (dk-asm? (list 'IN d 'RR)))
        (dk-have! (list 'IN d 'RR) (lambda () (ban-rw! d (ban-nr (ban-sb u v))) (dk-ass!))))
    d))
;;; (ban-rr! t) -- type a real term built from norms, distances, products, powers
(define (ban-rr! t)
  (cond ((dk-asm? (list 'IN t 'RR)) t)
        ((and (pair? t) (eq? (car t) '*))
         (ban-rr! (cadr t)) (ban-rr! (caddr t)) (dk-cite! 'rr-mul-in-rr (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) 'POWER))
         (ban-rr! (cadr t)) (dk-cite! 'power-real-closed (cadr t) (caddr t)) t)
        ((and (pair? t) (equal? (car t) '(VNRM a)))
         (ban-vt (cadr t)) (dk-cite! 'bae-vnrm-type 'a (cadr t)) t)
        ((and (pair? t) (equal? (car t) (list 'DIST ban-bam)))
         (ban-dist-rr! (cadr t) (caddr t)) t)
        (#t (error "ban-rr!: cannot type" (expression->string t)))))
;;; type the application (h v) of a sequence variable h in FUN(NN, VEC a)
(define (ban-app! h v) (dk-cite! 'fun-apply-type-c h 'NN '(VEC a) v) (list h v))
;;; (ban-lam-type! LAM) -- LAM = (VNB-LAMBDA w NN body): land LAM in FUN(NN, RR)
(define (ban-lam-rr! lam)
  (let ((f (list 'IN lam '(FUN NN RR))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda ()
          (dk-lam-type! (lambda ()
            (let* ((v (dk-di-var!)) (claim (dk-goal)))
              (ban-rr-term! (cadr claim) v)
              (if (equal? (dk-goal) claim) (dk-ass!))))))))
    f))
;;; a body term: applications of sequence VARIABLES at v are typed first
(define (ban-rr-term! t v)
  (let walk ((e t))
    (if (pair? e)
        (begin
          (if (and (symbol? (car e)) (= (length e) 2) (equal? (cadr e) v)
                   (dk-asm? (list 'IN (car e) '(FUN NN (VEC a)))))
              (ban-app! (car e) v))
          (for-each walk e))))
  (ban-rr! t))
;;; (ban-lam-vec! LAM) -- LAM = (VNB-LAMBDA w NN body), body an algebra term: land LAM in FUN(NN, VEC a)
(define (ban-lam-vec! lam)
  (let ((f (list 'IN lam '(FUN NN (VEC a)))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda ()
          (dk-lam-type! (lambda ()
            (dk-di-var!)
            (let ((claim (dk-goal)))
              (ban-vt (cadr claim))
              (if (equal? (dk-goal) claim) (dk-ass!))))))))
    f))
(define (ban-fun-pts! h)
  (dk-cite! 'ban-pts 'a)
  (let ((f (list 'IN h (list 'FUN 'NN (list 'PTS ban-bam)))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (subst (list '== (list 'PTS ban-bam) '(VEC a))) (dk-ass!))))
    f))

;;; multiplication is continuous: f_j -> lm implies y f_j -> y lm and f_j y -> lm y
(define (ban-mul-conv! name side)
  (let* ((prod (lambda (u w) (if (eq? side 'left) (ban-m u w) (ban-m w u)))))
    (sp (ban-st (list 'FORALL 'y (list 'IMPLIES '(IN y (VEC a)) (list 'FORALL 'lm (list 'IMPLIES '(IN lm (VEC a))
      (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN NN (VEC a))) (list 'IMPLIES (list 'CONVERGES-TO ban-bam 'f 'lm)
        (list 'FORALL 'g (list 'IMPLIES '(IN g (FUN NN (VEC a)))
          (list 'IMPLIES (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list '= '(g j) (prod 'y '(f j)))))
            (list 'CONVERGES-TO ban-bam 'g (prod 'y 'lm))))))))))))))
    (dk-peel!)
    (let* ((ylm (prod 'y 'lm)) (ny (ban-nr 'y))
           (hyp (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list '= '(g j) (prod 'y '(f j)))))))
      (dk-cite! 'ban-ms 'a)
      (ban-fun-pts! 'f) (ban-fun-pts! 'g)
      (ban-in-pts! 'lm) (ban-in-pts! ylm)
      (ban-rr! ny)
      (dk-cite! 'bal-uba-vnrm-nonneg 'a 'y)
      (let* ((nul1 (dk-cite! 'converges-dist-null-fwd ban-bam 'f 'lm))
             (lam1 (caddr nul1))
             (lamh (list 'VNB-LAMBDA 'bnj_ 'NN (list '* ny (ban-dist '(f bnj_) 'lm))))
             (ch (dk-cite! 'converges-dist-null-bwd ban-bam 'g ylm))
             (lam2 (caddr (cadr ch))))
        (detach-with! ch
          (lambda ()
            (ban-lam-rr! lam1) (ban-lam-rr! lamh) (ban-lam-rr! lam2)
            (detach-with! (dk-cite! 'rr-null-scale ny lam1 lamh)
              (lambda ()
                (let ((j (dk-di-var!)))
                  (dk-lam-b!)
                  (ban-app! 'f j)
                  (ban-rr! (ban-dist (list 'f j) 'lm))
                  (rfl))))
            (detach-with! (dk-cite! 'rr-null-squeeze lamh lam2)
              (lambda ()
                (let* ((j (dk-di-var!)) (fj (list 'f j)) (w (ban-sb fj 'lm)) (yfj (prod 'y fj)) (yw (prod 'y w)))
                  (dk-lam-b!)
                  (ban-app! 'f j) (ban-app! 'g j)
                  (dk-apply! hyp j)
                  (subst (list '= (list 'g j) yfj))
                  (ban-vt yfj)
                  (dk-cite! 'ban-dist 'a yfj ylm)
                  (ban-rw! (ban-dist yfj ylm) (ban-nr (ban-sb yfj ylm)))
                  (dk-cite! (if (eq? side 'left) 'ban-mul-sub-left 'ban-mul-sub-right) 'a 'y fj 'lm)
                  (ban-rw! (ban-sb yfj ylm) yw)
                  (dk-cite! 'ban-dist 'a fj 'lm)
                  (ban-rw! (ban-dist fj 'lm) (ban-nr w))
                  (ban-vt yw)
                  (ban-rr! (ban-nr yw)) (ban-rr! (ban-nr w))
                  (dk-cite! 'bal-uba-vnrm-nonneg 'a yw)
                  (if (eq? side 'left)
                      (dk-cite! 'bal-uba-vnrm-submult 'a 'y w)
                      (begin
                        (dk-cite! 'bal-uba-vnrm-submult 'a w 'y)
                        (dk-have! (list '= (list '* (ban-nr w) ny) (list '* ny (ban-nr w))) (lambda () (crs)))))
                  (dk-conj-close!
                    (lambda ()
                      (if (not (dk-ass!))
                          (if (eq? side 'left)
                              (dk-ass!)
                              (dk-le-chain! (ban-nr yw) (list '* (ban-nr w) ny) (list '* ny (ban-nr w))))))))))
            (dk-ass!)))
        (dk-ass!)))
    (ban-qed! name)))
(ban-mul-conv! 'ban-lmul-conv 'left)
(ban-mul-conv! 'ban-rmul-conv 'right)

;;; ||x|| < 1:  g_j = 1 - x^j  implies  g_j -> 1
(sp (ban-st '(FORALL x (IMPLIES (IN x (VEC a)) (IMPLIES (< ((VNRM a) x) 1)
  (FORALL g (IMPLIES (IN g (FUN NN (VEC a)))
    (IMPLIES (FORALL j (IMPLIES (IN j NN) (= (g j) ((VADD a) (VONE a) ((VNEG a) (EL-POW a x j))))))
      (CONVERGES-TO (BA-METRIC-SPACE a) g (VONE a))))))))))
(dk-peel!)
(let* ((nx (ban-nr 'x))
       (hyp '(FORALL j (IMPLIES (IN j NN) (= (g j) ((VADD a) (VONE a) ((VNEG a) (EL-POW a x j))))))))
  (dk-cite! 'ban-ms 'a)
  (ban-fun-pts! 'g) (ban-in-pts! ban-one)
  (ban-rr! nx)
  (dk-cite! 'bal-uba-vnrm-nonneg 'a 'x)
  (let* ((ch (dk-cite! 'converges-dist-null-bwd ban-bam 'g ban-one))
         (lam2 (caddr (cadr ch))))
    (detach-with! ch
      (lambda ()
        (dk-cite! 'rr-abs-of-nonneg nx)
        (dk-have! (list '< (list 'abs nx) 1) (lambda () (subst (list '= (list 'abs nx) nx)) (dk-ass!)))
        (let* ((pz (ban-cite2! 'power-tends-to-zero nx))
               (rad (caddr pz)))
          (ban-lam-rr! rad) (ban-lam-rr! lam2)
          (detach-with! (dk-cite! 'rr-null-squeeze rad lam2)
            (lambda ()
              (let* ((j (dk-di-var!)) (pj (ban-p 'x j)) (npj (ban-ng pj)))
                (dk-lam-b!)
                (ban-app! 'g j)
                (dk-apply! hyp j)
                (subst (list '= (list 'g j) (ban-sb ban-one pj)))
                (ban-vt npj) (ban-vt (ban-sb ban-one pj))
                (dk-cite! 'ban-dist 'a (ban-sb ban-one pj) ban-one)
                (ban-rw! (ban-dist (ban-sb ban-one pj) ban-one) (ban-nr (ban-sb (ban-sb ban-one pj) ban-one)))
                (dk-cite! 'ring-add-comm-uba-as-ring 'a ban-one npj)
                (ban-rw! (ban-sb ban-one pj) (ban-ad npj ban-one))
                (dk-cite! 'fom-v-shift-back-uba-as-module 'a npj ban-one)
                (ban-rw! (ban-sb (ban-ad npj ban-one) ban-one) npj)
                (dk-cite! 'ban-neg-norm 'a pj)
                (ban-rw! (ban-nr npj) (ban-nr pj))
                (dk-cite! 'bal-uba-vnrm-nonneg 'a pj)
                (dk-cite! 'bae-el-pow-norm j 'a 'x)
                (dk-conj-close! (lambda () (dk-ass!))))))
          (dk-ass!))))
    (dk-ass!)))
(ban-qed! 'ban-conv-one-minus-pow)

;;; ---- Proposition 1.3 -----------------------------------------------------------------------
(define ban-F '(VNB-LAMBDA bnj_ NN (NEUMANN-SUM a x bnj_)))

(sp (ban-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'IMPLIES '(< ((VNRM a) x) 1)
  (list 'CONVERGES ban-bam ban-F))))))
(dk-peel!)
(let* ((nx (ban-nr 'x)))
  (ban-rr! nx)
  (dk-cite! 'bal-uba-vnrm-nonneg 'a 'x)
  (let* ((gs (dk-cite! 'geometric-series-converges nx))
         (rad (cadr gs))
         (ch (dk-cite! 'summable-bound-converges ban-bam ban-F rad)))
    (detach-with! ch
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond ((dk-head-is? g 'IS-COMPLETE) (dk-cite! 'bal-uba-complete 'a) (dk-ass!))
                    ((dk-head-is? g 'SERIES-CONVERGES) (dk-ass!))
                    ((and (dk-head-is? g 'IN) (equal? (caddr g) '(FUN NN RR)))
                     (ban-lam-rr! rad) (if (equal? (dk-goal) g) (dk-ass!)))
                    ((dk-head-is? g 'IN)
                     (ban-lam-vec! ban-F) (ban-fun-pts! ban-F) (if (equal? (dk-goal) g) (dk-ass!)))
                    (#t
                     (let ((k (dk-di-var!)))
                       (dk-cite! 'nn-succ-closed k)
                       (dk-lam-b!)
                       (dk-cite! 'ban-nsum-step k 'a 'x)
                       (dk-ass!)))))))))
    (dk-ass!)))
(ban-qed! 'ban-nsum-converges)

;;; Proposition 1.3 (1): ||x|| < 1 implies 1 - x invertible, (1 - x)^(-1) = sum_k x^k
(sp (ban-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'IMPLIES '(< ((VNRM a) x) 1)
  (list 'AND (list 'IS-INVERTIBLE-EL 'a ban-om)
             (list 'CONVERGES-TO ban-bam ban-F (list 'INVERSE-EL 'a ban-om))))))))
(dk-peel!)
(let* ((cv (dk-cite! 'ban-nsum-converges 'a 'x))
       (ex (dk-landed-1 (lambda () (mac-h 'converges cv))))
       (lm (dk-skolem! ex))
       (G (list 'VNB-LAMBDA 'bnj_ 'NN (ban-m ban-om '(NEUMANN-SUM a x bnj_))))
       (H (list 'VNB-LAMBDA 'bnj_ 'NN (ban-m '(NEUMANN-SUM a x bnj_) ban-om))))
  (dk-project! (list 'IN lm (list 'PTS ban-bam)) 'converges-to (list 'CONVERGES-TO ban-bam ban-F lm))
  (dk-cite! 'ban-pts 'a)
  (dk-have! (list 'IN lm '(VEC a)) (lambda () (subst (list '== '(VEC a) (list 'PTS ban-bam))) (dk-ass!)))
  (ban-vt ban-om)
  (ban-lam-vec! ban-F) (ban-lam-vec! G) (ban-lam-vec! H)
  (let ((pw! (lambda (thm)
               (lambda ()
                 (let ((j (dk-di-var!)))
                   (dk-lam-b!)
                   (if thm
                       (begin (dk-cite! thm j 'a 'x) (dk-ass!))
                       (begin (ban-vt (cadr (dk-goal))) (rfl))))))))
    (let ((ch (dk-cite! 'ban-lmul-conv 'a ban-om lm ban-F G))) (detach-with! ch (pw! #f)))
    (let ((ch (dk-cite! 'ban-conv-one-minus-pow 'a 'x G))) (detach-with! ch (pw! 'ban-nsum-left)))
    (let ((ch (dk-cite! 'ban-rmul-conv 'a ban-om lm ban-F H))) (detach-with! ch (pw! #f)))
    (let ((ch (dk-cite! 'ban-conv-one-minus-pow 'a 'x H))) (detach-with! ch (pw! 'ban-nsum-right))))
  (dk-cite! 'metric-limit-unique ban-bam G (ban-m ban-om lm) ban-one)
  (dk-cite! 'metric-limit-unique ban-bam H (ban-m lm ban-om) ban-one)
  (dk-cite! 'bae-invertible-intro 'a ban-om lm)
  (dk-cite! 'bae-inverse-eq 'a ban-om lm)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin (subst (list '= (list 'INVERSE-EL 'a ban-om) lm)) (dk-ass!))))))
(ban-qed! 'neumann-series)

;;; ---- Corollary 1.4 ---------------------------------------------------------------------------
;;; p - (p - w) = w
(sp (ban-st '(FORALL p (IMPLIES (IN p (VEC a)) (FORALL w (IMPLIES (IN w (VEC a))
  (= ((VADD a) p ((VNEG a) ((VADD a) p ((VNEG a) w)))) w)))))))
(dk-peel!)
(let* ((pw (ban-vt (ban-sb 'p 'w))) (wp (ban-vt (ban-sb 'w 'p))) (np (ban-vt (ban-ng 'p))))
  (dk-have! (list '= (ban-ad pw wp) ban-zero)
    (lambda ()
      (dk-cite! 'ban-telescope 'a 'p 'w 'p)
      (ban-rw! (ban-ad pw wp) (ban-sb 'p 'p))
      (dk-cite! 'ring-add-right-inv-uba-as-ring 'a 'p)
      (dk-ass!)))
  (dk-cite! 'ring-add-inverse-unique-uba-as-ring 'a pw wp)
  (ban-rw! (ban-ng pw) wp)
  (dk-cite! 'ring-add-assoc-uba-as-ring 'a 'p 'w np)
  (ban-rw! (ban-ad 'p wp) (ban-ad (ban-ad 'p 'w) np))
  (dk-cite! 'ring-add-comm-uba-as-ring 'a 'p 'w)
  (ban-rw! (ban-ad 'p 'w) (ban-ad 'w 'p))
  (dk-cite! 'fom-v-shift-back-uba-as-module 'a 'w 'p)
  (dk-ass!))
(ban-qed! 'ban-sub-sub)

;;; the norm of the inverse is positive
(sp (ban-st '(FORALL b (IMPLIES (IS-INVERTIBLE-EL a b) (< 0 ((VNRM a) (INVERSE-EL a b)))))))
(dk-peel!)
(let* ((bi '(INVERSE-EL a b)) (nbi (ban-nr bi)) (nb (ban-nr 'b)))
  (dk-project! '(IN b (VEC a)) 'IS-INVERTIBLE-EL '(IS-INVERTIBLE-EL a b))
  (ban-vt bi)
  (ban-rr! nbi) (ban-rr! nb)
  (dk-cite! 'bal-uba-vnrm-nonneg 'a bi)
  (dk-cite! 'bae-inverse-right 'a 'b)
  (dk-cite! 'bal-uba-vnrm-submult 'a 'b bi)
  (dk-cite! 'bal-uba-vone-norm 'a)
  (let* ((le (dk-have! (list '<= 1 (list '* nb nbi))
               (lambda ()
                 (ban-rw! 1 (ban-nr ban-one))
                 (ban-rw! ban-one (ban-m 'b bi))
                 (dk-ass!))))
         (le-f (list '<= 1 (list '* nb nbi))))
    (dk-have! (list 'NOT (list '= nbi 0))
      (lambda ()
        (di)
        (let ((le0 (dk-rewrite-h! le-f nbi 0)))
          (dk-absurd! le0))))
    (dk-cite! 'dual-rr-pos-of-nonneg-nonzero nbi)
    (dk-ass!)))
(ban-qed! 'ban-inverse-norm-pos)

;;; Corollary 1.4: if b is invertible and ||b - x|| < ||b^(-1)||^(-1), then x is invertible
(sp (ban-st '(FORALL b (IMPLIES (IS-INVERTIBLE-EL a b) (FORALL x (IMPLIES (IN x (VEC a))
  (IMPLIES (< ((VNRM a) ((VADD a) b ((VNEG a) x))) (recip ((VNRM a) (INVERSE-EL a b))))
    (IS-INVERTIBLE-EL a x))))))))
(dk-peel!)
(let* ((bi '(INVERSE-EL a b)) (nbi (ban-nr bi)) (bx (ban-sb 'b 'x)) (d (ban-nr bx))
       (xbi (ban-m 'x bi)) (z (ban-sb ban-one xbi)) (nz (ban-nr z)) (r (list 'recip nbi)))
  (dk-project! '(IN b (VEC a)) 'IS-INVERTIBLE-EL '(IS-INVERTIBLE-EL a b))
  (ban-vt bi) (ban-vt bx) (ban-vt xbi) (ban-vt z)
  (ban-rr! nbi) (ban-rr! d) (ban-rr! nz)
  (dk-cite! 'ban-inverse-norm-pos 'a 'b)
  ;; z = (b - x) b^-1, so ||z|| <= ||b - x|| ||b^-1||
  (dk-cite! 'ban-mul-sub-right 'a bi 'b 'x)
  (dk-cite! 'bae-inverse-right 'a 'b)
  (dk-have! (list '= (ban-m bx bi) z)
    (lambda () (ban-rw! (ban-m bx bi) (ban-sb (ban-m 'b bi) xbi)) (ban-rw! (ban-m 'b bi) ban-one) (ban-vt z) (rfl)))
  (dk-cite! 'bal-uba-vnrm-submult 'a bx bi)
  (dk-have! (list '<= nz (list '* d nbi))
    (lambda () (ban-rw! z (ban-m bx bi)) (dk-ass!)))
  ;; ||b - x|| ||b^-1|| < 1
  (ban-rr! (list '* d nbi))
  (dk-have! '(NOT (= ((VNRM a) (INVERSE-EL a b)) 0))
    (lambda () (di) (dk-absurd! (dk-rewrite-h! (list '< 0 nbi) nbi 0))))
  (ban-cite2! 'rr-recip-closed nbi)
  (dk-cite! 'rr-mul-recip-cancel d nbi)
  (dk-have! (list '< (list '* (list '* d nbi) r) r)
    (lambda () (ban-rw! (list '* (list '* d nbi) r) d) (dk-ass!)))
  (dk-cite! 'rr-lt-mul-of-div-lt (list '* d nbi) r nbi)
  (ban-cite2! 'rr-recip-inverse nbi)
  (dk-have! (list '= (list '* r nbi) 1)
    (lambda () (dk-have! (list '= (list '* r nbi) (list '* nbi r)) (lambda () (crs)))
               (ban-rw! (list '* r nbi) (list '* nbi r)) (dk-ass!)))
  (ban-rr! (list '* r nbi))
  (ban-cite2! 'rr-le-lt-trans nz (list '* d nbi) (list '* r nbi))
  (dk-have! (list '< nz 1)
    (lambda () (ban-rw! 1 (list '* r nbi)) (dk-ass!)))
  ;; Neumann: 1 - z = x b^-1 is invertible, so x = (x b^-1) b is
  (dk-cite! 'neumann-series 'a z)
  (dk-cite! 'ban-sub-sub 'a ban-one xbi)
  (dk-have! (list 'IS-INVERTIBLE-EL 'a xbi)
    (lambda ()
      (ban-rw! xbi (ban-sb ban-one z))
      (dk-split-all!)
      (dk-ass!)))
  (dk-cite! 'bae-invertible-mul 'a xbi 'b)
  (dk-cite! 'ring-mul-assoc-uba-as-ring 'a 'x bi 'b)
  (dk-cite! 'bae-inverse-left 'a 'b)
  (dk-cite! 'ring-mul-right-id-uba-as-ring 'a 'x)
  (ban-rw! 'x (ban-m 'x ban-one))
  (ban-rw! ban-one (ban-m bi 'b))
  (ban-rw! (ban-m 'x (ban-m bi 'b)) (ban-m xbi 'b))
  (dk-ass!))
(ban-qed! 'invertible-near-invertible)

;;; Corollary 1.4: the set of invertible elements is open
(sp (ban-st '(IS-OPEN (BA-METRIC-SPACE a) (INVERTIBLES a))))
(dk-peel!)
(dk-cite! 'ban-ms 'a)
(dk-cite! 'ban-pts 'a)
(mac 'is-open)
(mac 'INVERTIBLES)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-head-is? g 'IS-METRIC-SPACE) (dk-ass!))
            ((dk-head-is? g 'SUBSET)
             (mac 'subset-def)
             (dk-di-var!)
             (let* ((mem (car (filter (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) (dk-asms))))
                    (y (cadr mem)))
               (dk-project! (list 'IN y '(VEC a)) (lambda () (sep-me mem)))
               (subst (list '== (list 'PTS ban-bam) '(VEC a)))
               (dk-ass!)))
            (#t
             (let* ((y (dk-di-var!))
                    (mem (list 'IN y (caddr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (cadr f) y)
                                                                         (dk-head-is? (caddr f) 'SEP)))
                                                         (dk-asms))))))
                    (sepc (caddr mem))
                    (yi (list 'INVERSE-EL 'a y)) (nyi (ban-nr yi)) (r (list 'recip nyi)))
               (dk-project! (list 'IN y '(VEC a)) (lambda () (sep-me mem)))
               (dk-project! (list 'IS-INVERTIBLE-EL 'a y) (lambda () (sep-me mem)))
               (ban-vt yi) (ban-rr! nyi)
               (dk-cite! 'ban-inverse-norm-pos 'a y)
               (dk-have! (list 'NOT (list '= nyi 0))
                 (lambda () (di) (dk-absurd! (dk-rewrite-h! (list '< 0 nyi) nyi 0))))
               (ban-cite2! 'rr-recip-closed nyi)
               (dk-cite! 'rr-recip-pos nyi)
               (ew r)
               (dk-conj-close!
                 (lambda ()
                   (let ((g2 (dk-goal)))
                     (cond ((dk-head-is? g2 'POS-RR)
                            (mac 'pos-rr)
                            (dk-conj-close!
                              (lambda ()
                                (cond ((dk-ass!) #t)
                                      ((dk-head-is? (dk-goal) 'NOT)
                                       (di) (dk-absurd! (dk-rewrite-h! (list '< 0 r) r 0)))
                                      (#t (dk-ineq! (list '< 0 r)))))))
                           (#t
                            (mac 'subset-def)
                            (let* ((zv (dk-di-var!))
                                   (bm (list 'IN zv (list 'BALL ban-bam y r)))
                                   (dz (ban-dist y zv)))
                              (dk-project! (list 'IN zv (list 'PTS ban-bam)) 'ball-membership bm)
                              (dk-project! (list '<= dz r) 'ball-membership bm)
                              (dk-project! (list 'NOT (list '= dz r)) 'ball-membership bm)
                              (dk-have! (list 'IN zv '(VEC a))
                                (lambda () (subst (list '== '(VEC a) (list 'PTS ban-bam))) (dk-ass!)))
                              (ban-rr! dz) (ban-rr! r)
                              (dk-cite! 'ban-dist 'a y zv)
                              (dk-have! (list '< (ban-nr (ban-sb y zv)) r)
                                (lambda ()
                                  (ban-rw! (ban-nr (ban-sb y zv)) dz)
                                  (ban-cite2! 'rr-le-ne-lt dz r)
                                  (dk-ass!)))
                              (dk-cite! 'invertible-near-invertible 'a y zv)
                              (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))))))))))))
(ban-qed! 'invertibles-open)

