;;; th3-sort.scm -- sorting a set with finite superlevel sets by a real key.  Agent TH3-SORT,
;;; 2026-11-10 (wave TH3, the Operadores book ch. 3, for Definicao 3.6).  Library: core.
;;; Helper prefix srt-.  Every qed modulo 0; nothing asserted.
;;;
;;; THE GENERAL LEMMA (srt-superlevel-sort).  Let S be a set and f in FUN(S, RR) such that
;;; {x in S : d <= f(x)} is finite for every d > 0.  Put P = {x in S : 0 < f(x)}.  Then either
;;;   * CARD(P) in NN and some bijection ph : ORD-SEGMENT(CARD P) -> P has f(ph(n+1)) <= f(ph n)
;;;     whenever n + 1 < CARD P; or
;;;   * P is infinite and some bijection ph : NN -> P has f(ph(n+1)) <= f(ph n) for all n, and
;;;     f(ph n) -> 0 (for every d > 0 there is j with f(ph n) < d for n >= j).
;;; No hypothesis f >= 0 is needed.  The P-level forms, srt-sort-finite and srt-sort-infinite
;;; (P a set, f real and positive on P), are what Definicao 3.6 cites.
;;;
;;; PLAN.  srt-finite-max: a real function on a finite nonempty set has a maximiser
;;; (finite-set-induction).  srt-maximizer: every nonempty subset of P has one, given that the
;;; superlevel set of each point is finite.  srt-chain: by dc-on-nn-pred over the finite subsets
;;; of P, T(0) = {} and T(k+1) is T(k) when T(k) covers P, else T(k) plus a maximiser outside it.
;;; srt-inf-picks: for P infinite the added points form ph : NN -> P (a second dependent choice).
;;; srt-picks-sorted: ph is a bijection, nonincreasing, and a value bound below by c > 0 makes the
;;; superlevel set at c infinite.  srt-sort-infinite / srt-sort-finite / srt-superlevel-sort.
;;;
;;; Load window: after theorem-library/pair-self-cartesian3 (pair-self-member, pair-self-eq), the
;;; latest of its citations; also card-subset-mono, card-subset-nn, rake-card-star-laws,
;;; rake-dc-on-nn, rr-order-basics, fun-apply-type-proof, nn-order-proof.  No citer in the tree.
;;; srt- helpers (TH3-SORT, 2026-11-10).  File-local to th3-sort.scm.
(define (srt-un s x) (list 'UNION s (list 'PAIR x x)))
(define (srt-and! . fs) (apply dk-have-and! fs))
;; z in sv  ==>  z in sv u {xv}
(define (srt-in-union-left! z sv xv)
  (let ((iff (dk-cite! 'union-membership sv (list 'PAIR xv xv) z)))
    (dk-have! (list 'IN z (srt-un sv xv)) (lambda () (if (dk-only! iff (list 'IN z sv)) (prop))))))
;; xv in SET  ==>  xv in sv u {xv}
(define (srt-in-union-new! sv xv)
  (dk-cite! 'pair-self-member xv)
  (let ((iff (dk-cite! 'union-membership sv (list 'PAIR xv xv) xv)))
    (dk-have! (list 'IN xv (srt-un sv xv)) (lambda () (if (dk-only! iff (list 'IN xv (list 'PAIR xv xv))) (prop))))))
;; w in sv u {xv}, not w in sv, xv in SET  ==>  w = xv
(define (srt-new-point! w sv xv)
  (let ((iff (dk-cite! 'union-membership sv (list 'PAIR xv xv) w)))
    (dk-have! (list 'IN w (list 'PAIR xv xv))
      (lambda () (if (dk-only! iff (list 'IN w (srt-un sv xv)) (list 'NOT (list 'IN w sv))) (prop))))
    (dk-cite! 'pair-self-eq xv w)))
;; the eigenvariable of a peeled guard (IN v C): read the LAST landed (IN _ C) for a given C
(define (srt-var-of landed cls)
  (cadr (dk-find "srt-var-of" (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cls))) landed)))
;; run a branching tactic; close every leaf it opened by `ass' (ERROR if one stays open)
(define (srt-close-opened! thunk)
  (for-each (lambda (l)
              (if (not (sequent-node-grounded? l))
                  (begin (dk-focus! l) (ass)
                         (if (not (sequent-node-grounded? l))
                             (error "srt-close-opened!: leaf left open" (expression->string (dk-goal-of l)))))))
            (dk-opened thunk)))
;; land (IN t (SEP v D p)) when (IN t D) and p[v:=t] are in context
(define (srt-sep-in! t sep)
  (let ((c (list 'IN t sep)))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (srt-close-opened! (lambda () (sep-mi))))))
    c))
;; land (IN (SEP v D p) SET) when (IN D SET) is in context
(define (srt-sep-set! sep)
  (let ((c (list 'IN sep 'SET)))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (srt-close-opened! (lambda () (sep-set))))))
    c))
;; ---- the sorting chain: formula builders over the set P and the key f ----
(define (srt-X p) (list 'SEP 'sru_ (list 'POWER p) '(IN (CARD sru_) NN)))
(define (srt-cov p u) (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ p) (list 'IN 'srz_ u))))
(define (srt-maxout p f u x)
  (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ p)
    (list 'IMPLIES (list 'NOT (list 'IN 'srz_ u)) (list '<= (list f 'srz_) (list f x))))))
(define (srt-pick p f u x y)            ; x is a maximiser outside u and y = u + {x}
  (list 'AND (list 'IN x p) (list 'AND (list 'NOT (list 'IN x u))
    (list 'AND (srt-maxout p f u x) (list '= y (srt-un u x))))))
(define (srt-phi p f u y)
  (list 'OR (list 'AND (srt-cov p u) (list '= y u))
            (list 'FORSOME 'srx_ (srt-pick p f u 'srx_ y))))
(define (srt-hyps p f body)             ; P a set, f a set real on P, superlevel sets of points finite
  (list 'IMPLIES (list 'IN p 'SET) (list 'FORALL f (list 'IMPLIES (list 'IN f 'SET)
    (list 'IMPLIES (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x p) (list 'IN (list f 'x) 'RR)))
      (list 'IMPLIES (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x p)
                        (list 'IN (list 'CARD (list 'SEP 'y p (list '<= (list f 'x) (list f 'y)))) 'NN)))
        body))))))
;; u in X in context: land u in SET, forall z in u. z in P, CARD(u) in NN
(define (srt-x-parts! p u)
  (dk-sep-parts! (list 'IN u (srt-X p)))
  (let ((iff (dk-cite! 'power-set-membership p u))
        (sub (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ u) (list 'IN 'srz_ p)))))
    (dk-have! (list 'AND (list 'IN u 'SET) sub)
      (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-close-if-asm!)))
    (dk-split-all!)))
;; z in u, u in X (srt-x-parts! done): z in P
(define (srt-sub-apply! u p z)
  (dk-apply! (dk-find "u in POWER(P)" (lambda (h) (and (dk-head-is? h 'FORALL) (dk-head-is? (caddr h) 'IMPLIES)
                                                       (equal? (caddr (cadr (caddr h))) u)
                                                       (equal? (caddr (caddr (caddr h))) p)))
                      (dk-asms))
             z))
;; y in SET and forall z in y. z in P in context: y in POWER(P)
(define (srt-power-in! p y sub)
  (srt-and! (list 'IN y 'SET) sub)
  (dk-iff-bwd! (dk-cite! 'power-set-membership p y)))
;; read P and f off the real-valuedness hypothesis (FORALL x (IMPLIES (IN x P) (IN (f x) RR))) in LANDED
(define (srt-read-pf landed)
  (let* ((typ (dk-find "f real on P" (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'RR)
                                                     (not (dk-contains? h 'CARD))
                                                     (dk-head-is? (caddr h) 'IMPLIES)
                                                     (dk-head-is? (caddr (caddr h)) 'IN)
                                                     (eq? (caddr (caddr (caddr h))) 'RR)))
                       landed))
         (imp (caddr typ)))
    (list (caddr (cadr imp)) (car (cadr (caddr imp))) typ)))
;; a typing (IN v (FUN NN C)) in LANDED with C satisfying PRED: v
(define (srt-read-fun landed cls)
  (cadr (dk-find "a FUN typing" (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (list 'FUN 'NN cls)))) landed)))
;; the limit clause: f(ph n) -> 0 from above, as "eventually below every d > 0"
(define (srt-lim f ph)
  (list 'FORALL 'd (list 'IMPLIES '(POS-RR d)
    (list 'FORSOME 'j (list 'AND '(IN j NN)
      (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(<= j n) (list '< (list f (list ph 'n)) 'd)))))))))
;; P a set, f a set real on P, f > 0 on P, every superlevel set at d > 0 finite
(define (srt-pos-hyps p f body)
  (list 'IMPLIES (list 'IN p 'SET) (list 'FORALL f (list 'IMPLIES (list 'IN f 'SET)
    (list 'IMPLIES (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x p) (list 'IN (list f 'x) 'RR)))
      (list 'IMPLIES (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x p) (list '< 0 (list f 'x))))
        (list 'IMPLIES (list 'FORALL 'd (list 'IMPLIES '(POS-RR d)
                          (list 'IN (list 'CARD (list 'SEP 'y p (list '<= 'd (list f 'y)))) 'NN)))
          body)))))))
;; (IN w A) and an equation between A and B in context: land (IN w B).  A goal-side subst of the
;; WHOLE term B, so it is safe when B contains A (dk-rewrite-h! is not: it rewrites A inside B too)
(define (srt-mem-transport! w a b)
  (let ((c (list 'IN w b)))
    (if (not (dk-asm? c))
        (dk-have! c (lambda () (subst (list '= b a)) (dk-close-if-asm!))))
    c))
;;; ---------------------------------------------------------------------------------------
;;; (1) srt-finite-max: a real-valued f on a finite nonempty set s attains its maximum.
;;; finite-set-induction over the class of finite sets s on which every f in SET that is
;;; real on s and every nonempty s give a maximiser.
;;; ---------------------------------------------------------------------------------------
(define (srt-max-body s)
  (list 'FORALL 'srf_ (list 'IMPLIES '(IN srf_ SET)
    (list 'IMPLIES (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ s) '(IN (srf_ srz_) RR)))
      (list 'IMPLIES (list 'FORSOME 'srw_ (list 'IN 'srw_ s))
        (list 'FORSOME 'srm_ (list 'AND (list 'IN 'srm_ s)
          (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ s) '(<= (srf_ srz_) (srf_ srm_)))))))))))
(define srt-max-cls (list 'COMP 'srs_ (srt-max-body 'srs_)))

;; the function variable, read off a goal (FORSOME m (AND (IN m s) (FORALL z (IMPLIES _ (<= (f z) (f m))))))
(define (srt-max-fv g) (car (cadr (caddr (caddr (caddr (caddr g)))))))

;; on a goal (FORALL z (IMPLIES (IN z un) (<= (fv z) (fv B)))): close it.
;;   ON-SV! closes (<= (fv z) (fv B)) for z in sv;  the new point z = xv is closed here
(define (srt-max-close-forall! fv sv xv b on-sv!)
  (let ((z (cadr (car (dk-peel!)))))
    (use-em (list 'IN z sv)
      (lambda () (on-sv! z))
      (lambda ()
        (srt-new-point! z sv xv)
        (subst (list '= z xv))
        (if (equal? b xv)
            (begin (dk-cite! 'rr-leq-reflexive (list fv xv)) (dk-close-if-asm!))
            (dk-close-if-asm!))))))

(sp (make-wff '(FORALL s (IMPLIES (IN s SET) (IMPLIES (IN (CARD s) NN)
  (FORALL f (IMPLIES (IN f SET) (IMPLIES (FORALL z (IMPLIES (IN z s) (IN (f z) RR)))
    (IMPLIES (FORSOME w (IN w s))
      (FORSOME m (AND (IN m s) (FORALL z (IMPLIES (IN z s) (<= (f z) (f m)))))))))))))))
(dk-peel!)
(define srt-max-s (caddr (cadr (caddr (dk-goal)))))
(define srt-max-f (srt-max-fv (dk-goal)))

;; base: EMPTY-SET is in the class
(dk-have! (list 'IN 'EMPTY-SET srt-max-cls)
  (lambda ()
    (for-each (lambda (leaf) (dk-focus! leaf)
                (if (and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET))
                    (begin (fact 'empty-set-is-set) (dk-close-if-asm!))
                    (begin
                      (dk-peel!)
                      (let ((w (dk-skolem! (dk-pick (dk-head? 'FORSOME) "a member of the empty set"))))
                        (dk-cite! 'empty-set-has-no-members w)
                        (ai (list 'NOT (list 'IN w 'EMPTY-SET)))))))
              (dk-opened (lambda () (comp-mi))))))

;; step: sv in the class, xv not in sv  ==>  sv u {xv} in the class
(define srt-max-step-claim
  (list 'FORALL 'pcs_
    (list 'IMPLIES (list 'AND '(IN pcs_ SET) (list 'AND '(IN (CARD pcs_) NN) (list 'IN 'pcs_ srt-max-cls)))
      (list 'FORALL 'pcx_
        (list 'IMPLIES (list 'AND '(IN pcx_ SET) '(NOT (IN pcx_ pcs_)))
              (list 'IN '(UNION pcs_ (PAIR pcx_ pcx_)) srt-max-cls))))))

(define (srt-max-step! ih sv xv)
  (dk-peel!)
  (let* ((g (dk-goal))
         (fv (srt-max-fv g))
         (un (srt-un sv xv))
         (tun (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h un) (dk-contains? h 'RR)))
                       "f real on sv u {xv}"))
         (tsv (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ sv) (list 'IN (list fv 'srz_) 'RR))))
         (fx (list fv xv)))
    (dk-have! tsv
      (lambda ()
        (let ((z (cadr (car (dk-peel!)))))
          (srt-in-union-left! z sv xv)
          (dk-apply! tun z)
          (dk-close-if-asm!))))
    (srt-in-union-new! sv xv)
    (dk-apply! tun xv)
    (use-em (list 'FORSOME 'srw_ (list 'IN 'srw_ sv))
      (lambda ()
        (let* ((ex (dk-apply! ih fv))
               (m (dk-skolem! ex))
               (fm (list fv m))
               (mcl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m) (dk-contains? h '<=)))
                             "the maximum on sv")))
          (dk-apply! tsv m)
          (use-em (list '<= fx fm)
            (lambda ()
              (ew m)
              (dk-conj-close!
               (lambda ()
                 (if (dk-head-is? (dk-goal) 'FORALL)
                     (srt-max-close-forall! fv sv xv m
                       (lambda (z) (dk-apply! mcl z) (dk-close-if-asm!)))
                     (srt-in-union-left! m sv xv)))))
            (lambda ()
              (dk-cite! 'rr-not-le-lt fx fm)
              (ew xv)
              (dk-conj-close!
               (lambda ()
                 (if (dk-head-is? (dk-goal) 'FORALL)
                     (srt-max-close-forall! fv sv xv xv
                       (lambda (z)
                         (dk-apply! mcl z)
                         (dk-apply! tsv z)
                         (dk-ineq! (list '<= (list fv z) fm) (list '< fm fx)
                                   (list 'IN (list fv z) 'RR) (list 'IN fm 'RR) (list 'IN fx 'RR))))
                     (dk-close-if-asm!))))))))
      (lambda ()
        (let ((none (list 'NOT (list 'FORSOME 'srw_ (list 'IN 'srw_ sv)))))
          (ew xv)
          (dk-conj-close!
           (lambda ()
             (if (dk-head-is? (dk-goal) 'FORALL)
                 (srt-max-close-forall! fv sv xv xv
                   (lambda (z)
                     (dk-have! (list 'FORSOME 'srw_ (list 'IN 'srw_ sv))
                       (lambda () (witness! z (lambda () (dk-close-if-asm!)))))
                     (ai none)))
                 (dk-close-if-asm!)))))))))

(dk-have! srt-max-step-claim
  (lambda ()
    (dk-peel!)
    (dk-split-all!)
    (let* ((g (dk-goal)) (un (cadr g)) (sv (cadr un)) (xv (cadr (caddr un))))
      (srt-and! (list 'IN xv 'SET) (list 'IN xv 'SET))
      (dk-cite! 'pairing xv xv)
      (srt-and! (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET))
      (dk-cite! 'union-set-closure sv (list 'PAIR xv xv))
      (let ((ih (dk-landed-find (lambda () (comp-me (list 'IN sv srt-max-cls))) (dk-head? 'FORALL))))
        (for-each (lambda (leaf) (dk-focus! leaf)
                    (if (and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET))
                        (dk-close-if-asm!)
                        (srt-max-step! ih sv xv)))
                  (dk-opened (lambda () (comp-mi))))))))

(srt-and! (list 'IN 'EMPTY-SET srt-max-cls) srt-max-step-claim)
(let ((ind (dk-fact! 'finite-set-induction srt-max-cls)))
  (srt-and! (list 'IN srt-max-s 'SET) (list 'IN (list 'CARD srt-max-s) 'NN))
  (dk-apply! ind srt-max-s)
  (let ((body (dk-landed-find (lambda () (comp-me (list 'IN srt-max-s srt-max-cls))) (dk-head? 'FORALL))))
    (dk-apply! body srt-max-f)
    (dk-close-if-asm!)))
(qed 'srt-finite-max)
;;; ---------------------------------------------------------------------------------------
;;; (2) srt-maximizer: if every point of P has finitely many points of P at least as large,
;;; every nonempty subset Q of P has a maximiser of f.
;;; ---------------------------------------------------------------------------------------
(sp (make-wff '(FORALL P (IMPLIES (IN P SET) (FORALL f (IMPLIES (IN f SET)
  (IMPLIES (FORALL x (IMPLIES (IN x P) (IN (f x) RR)))
    (IMPLIES (FORALL x (IMPLIES (IN x P) (IN (CARD (SEP y P (<= (f x) (f y)))) NN)))
      (FORALL Q (IMPLIES (FORALL z (IMPLIES (IN z Q) (IN z P)))
        (FORALL w (IMPLIES (IN w Q)
          (FORSOME m (AND (IN m Q) (FORALL z (IMPLIES (IN z Q) (<= (f z) (f m))))))))))))))))))
(dk-peel!)
(let* ((g (dk-goal))
       (q (caddr (cadr (caddr g))))
       (f (car (cadr (caddr (caddr (caddr (caddr g)))))))
       (sub (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h q))) "Q in P"))
       (p (caddr (caddr (caddr sub))))
       (w (cadr (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) q))) "w in Q")))
       (typ (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'RR) (not (dk-contains? h 'CARD))))
                     "f real on P"))
       (hfin (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'CARD))) "finite superlevel sets"))
       (fw (list f w))
       (u (list 'SEP 'sry_ p (list '<= fw (list f 'sry_))))
       (l (list 'SEP 'srv_ u (list 'IN 'srv_ q)))
       (inP! (lambda (z) (dk-apply! sub z) (dk-apply! typ z))))
  (inP! w)
  (dk-apply! hfin w)                                 ; CARD(U) in NN (the binder is alpha-renamed)
  (srt-sep-set! u)
  (srt-sep-set! l)
  ;; L is a finite subset of U
  (dk-have! (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ l) (list 'IN 'srz_ u)))
    (lambda () (let ((z (cadr (car (dk-peel!))))) (dk-sep-parts! (list 'IN z l)) (dk-close-if-asm!))))
  (let ((cu (dk-find "card U" (lambda (h) (and (dk-head-is? h 'IN) (dk-head-is? (cadr h) 'CARD)
                                                (alpha-equiv? (cadr (cadr h)) u))) (dk-asms))))
    (srt-and! (list 'IN u 'SET) cu))
  (dk-cite! 'card-subset-nn u)
  (srt-and! (list 'IN l 'SET) (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ l) (list 'IN 'srz_ u))))
  (let ((sn (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(CARD s))))
                     "card-subset-nn instance")))
    (dk-apply! sn l))
  ;; w in L
  (dk-cite! 'rr-leq-reflexive fw)
  (srt-sep-in! w u)
  (srt-sep-in! w l)
  ;; f real on L
  (let ((tl (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ l) (list 'IN (list f 'srz_) 'RR)))))
    (dk-have! tl
      (lambda () (let ((z (cadr (car (dk-peel!)))))
                   (dk-sep-parts! (list 'IN z l)) (dk-sep-parts! (list 'IN z u)) (dk-apply! typ z)
                   (dk-close-if-asm!))))
    (dk-have! (list 'FORSOME 'srw_ (list 'IN 'srw_ l)) (lambda () (witness! w (lambda () (dk-close-if-asm!)))))
    (let* ((ex (dk-apply! (dk-cite! 'srt-finite-max l) f))
           (m (dk-skolem! ex))
           (fm (list f m))
           (mcl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m) (dk-contains? h '<=)))
                         "the maximum on L")))
      (dk-sep-parts! (list 'IN m l))
      (dk-sep-parts! (list 'IN m u))
      (dk-apply! typ m)
      (ew m)
      (dk-conj-close!
       (lambda ()
         (if (dk-head-is? (dk-goal) 'FORALL)
             (let* ((z (cadr (car (dk-peel!)))) (fz (list f z)))
               (inP! z)
               (srt-and! (list 'IN fw 'RR) (list 'IN fz 'RR))
               (dk-or-each! (dk-cite! 'rr-leq-total fw fz)
                 (lambda (h)
                   (if (equal? h (list '<= fw fz))
                       (begin (srt-sep-in! z u) (srt-sep-in! z l) (dk-apply! mcl z) (dk-close-if-asm!))
                       (dk-ineq! h (list '<= fw fm) (list 'IN fw 'RR) (list 'IN fz 'RR) (list 'IN fm 'RR))))))
             (dk-close-if-asm!)))))))
(qed 'srt-maximizer)
;;; ---------------------------------------------------------------------------------------
;;; (3) srt-chain: the stages of the sort.  T(0) = {}, and T(k+1) is T(k) when T(k) covers P,
;;; else T(k) u {x} for a maximiser x of f outside T(k).  Each T(k) is a finite subset of P.
;;; dc-on-nn-pred over X = the finite subsets of P.
;;; ---------------------------------------------------------------------------------------
(define srt-chain-stmt
  (list 'FORALL 'P (srt-hyps 'P 'f
    (list 'FORSOME 'T (list 'AND (list 'IN 'T (list 'FUN 'NN (srt-X 'P)))
      (list 'AND '(= (T 0) EMPTY-SET)
        (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (srt-phi 'P 'f '(T k) '(T (succ k)))))))))))
(sp (make-wff srt-chain-stmt))
(define srt-ch-landed (dk-peel!))
(define srt-ch-hyps
  ;; P and f: P is the set whose typing guard is the real-valuedness hypothesis; read off it
  (let* ((typ (dk-find "f real on P" (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'RR)
                                                     (not (dk-contains? h 'CARD)))) srt-ch-landed))
         (imp (caddr typ)))
    (list (caddr (cadr imp)) (car (cadr (caddr imp))) typ
          (dk-find "superlevel" (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'CARD))) srt-ch-landed))))
(define srt-ch-p (car srt-ch-hyps))
(define srt-ch-f (cadr srt-ch-hyps))
(define srt-ch-typ (caddr srt-ch-hyps))
(define srt-ch-X (srt-X srt-ch-p))
(define srt-ch-nxt
  (list 'VNB-LAMBDA '(LIST srk_ srv_) (list 'CARTESIAN 'NN srt-ch-X)
        (list 'SEP 'sry_ srt-ch-X (srt-phi srt-ch-p srt-ch-f 'srv_ 'sry_))))

;; X is a set, and EMPTY-SET is in X
(dk-cite! 'power-set srt-ch-p)
(srt-sep-set! srt-ch-X)
(dk-have! (list 'FORALL 'srz_ (list 'IMPLIES '(IN srz_ EMPTY-SET) (list 'IN 'srz_ srt-ch-p)))
  (lambda () (let ((z (cadr (car (dk-peel!)))))
               (dk-cite! 'empty-set-has-no-members z) (ai (list 'NOT (list 'IN z 'EMPTY-SET))))))
(fact 'empty-set-is-set)
(srt-power-in! srt-ch-p 'EMPTY-SET (list 'FORALL 'srz_ (list 'IMPLIES '(IN srz_ EMPTY-SET) (list 'IN 'srz_ srt-ch-p))))
(fact 'card-empty)
(fact 'nn-zero-in)
(dk-have! '(IN (CARD EMPTY-SET) NN) (lambda () (subst '(= (CARD EMPTY-SET) 0)) (dk-close-if-asm!)))
(srt-sep-in! 'EMPTY-SET srt-ch-X)

;; the totality dc-on-nn-pred asks for
(define srt-ch-tot
  (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
    (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u srt-ch-X)
      (list 'FORSOME 'y (list 'AND (list 'IN 'y srt-ch-X) (list 'IN 'y (list srt-ch-nxt 'k 'u)))))))))
(dk-have! srt-ch-tot
  (lambda ()
    (let* ((landed (dk-peel!))
           (kv (srt-var-of landed 'NN))
           (uv (srt-var-of landed srt-ch-X))
           (p srt-ch-p) (f srt-ch-f))
      (dk-lam-b!)
      (srt-x-parts! p uv)
      (let ((cov (srt-cov p uv))
            (sepy (list 'SEP 'sry_ srt-ch-X (srt-phi p f uv 'sry_))))
        (use-em cov
          (lambda ()                               ; covered: stay
            (witness! uv
              (lambda ()
                (dk-conj-close!
                 (lambda ()
                   (if (equal? (dk-goal) (list 'IN uv sepy))
                       (srt-close-opened!
                        (lambda ()
                          (sep-mi)
                          (if (and (pair? (dk-open-leaves)) (dk-head-is? (dk-goal) 'OR))
                              (begin (oi-l)
                                     (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) '=) (rfl) (dk-close-if-asm!))))))))
                       (dk-close-if-asm!)))))))
          (lambda ()                               ; not covered: add a maximiser
            (let* ((ex (dk-landed-find (lambda () (push-not-h (list 'NOT cov))) (dk-head? 'FORSOME)))
                   (z0 (dk-skolem! ex))
                   (q (list 'SEP 'srq_ p (list 'NOT (list 'IN 'srq_ uv))))
                   (qsub (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ q) (list 'IN 'srz_ p)))))
              (dk-have! qsub (lambda () (let ((z (cadr (car (dk-peel!))))) (dk-sep-parts! (list 'IN z q)) (dk-close-if-asm!))))
              (srt-sep-in! z0 q)
              (let* ((ex2 (dk-apply! (dk-cite! 'srt-maximizer p f) q z0))
                     (m (dk-skolem! ex2))
                     (mcl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m) (dk-contains? h '<=)))
                                   "the maximiser"))
                     (y (srt-un uv m)))
                (dk-sep-parts! (list 'IN m q))
                (dk-cite! 'membership-implies-sethood m p)
                (srt-and! (list 'IN m 'SET) (list 'IN m 'SET))
                (dk-cite! 'pairing m m)
                (srt-and! (list 'IN uv 'SET) (list 'IN (list 'PAIR m m) 'SET))
                (dk-cite! 'union-set-closure uv (list 'PAIR m m))
                ;; y in POWER P
                (dk-have! (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ y) (list 'IN 'srz_ p)))
                  (lambda ()
                    (let ((z (cadr (car (dk-peel!)))))
                      (use-em (list 'IN z uv)
                        (lambda () (srt-sub-apply! uv p z) (dk-close-if-asm!))
                        (lambda () (srt-new-point! z uv m) (subst (list '= z m)) (dk-close-if-asm!))))))
                (srt-power-in! p y (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ y) (list 'IN 'srz_ p))))
                ;; CARD(y) in NN
                (dk-cite! 'card-insert-curried uv m)
                (dk-cite! 'ord-succ-nn (list 'CARD uv))
                (dk-cite! 'nn-succ-closed (list 'CARD uv))
                (dk-have! (list 'IN (list 'CARD y) 'NN)
                  (lambda ()
                    (subst (list '= (list 'CARD y) (list 'SUCC_ORD (list 'CARD uv))))
                    (subst (list '= (list 'SUCC_ORD (list 'CARD uv)) (list 'succ (list 'CARD uv))))
                    (dk-close-if-asm!)))
                (srt-sep-in! y srt-ch-X)
                ;; y satisfies the second clause
                (dk-have! (srt-maxout p f uv m)
                  (lambda ()
                    (let ((z (srt-var-of (dk-peel!) p)))
                      (srt-sep-in! z q)
                      (dk-apply! mcl z)
                      (dk-close-if-asm!))))
                (witness! y
                  (lambda ()
                    (dk-conj-close!
                     (lambda ()
                       (if (equal? (dk-goal) (list 'IN y sepy))
                           (srt-close-opened!
                            (lambda ()
                              (sep-mi)
                              (if (and (pair? (dk-open-leaves)) (dk-head-is? (dk-goal) 'OR))
                                  (begin (oi-r)
                                         (ew m)
                                         (dk-conj-close!
                                          (lambda () (if (dk-head-is? (dk-goal) '=) (rfl) (dk-close-if-asm!))))))))
                           (dk-close-if-asm!))))))))))))))

(define srt-ch-EX (dk-fact! 'dc-on-nn-pred srt-ch-X 'EMPTY-SET srt-ch-nxt))
(define srt-ch-T (dk-skolem! srt-ch-EX))
(define srt-ch-fall
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h srt-ch-T) (dk-contains? h 'succ)))
           "the per-stage step"))
(witness! srt-ch-T
  (lambda ()
    (dk-conj-close!
     (lambda ()
       (if (dk-head-is? (dk-goal) 'FORALL)
           (let* ((kv (dk-di-var!))
                  (h (dk-apply! srt-ch-fall kv))
                  (tk (list srt-ch-T kv)))
             (dk-cite! 'fun-apply-type-c srt-ch-T 'NN srt-ch-X kv)
             (dk-cite! 'nn-succ-closed kv)
             (let ((r (car (dk-landed (lambda () (lam-b-h h))))))
               (dk-sep-parts! r)
               (dk-close-if-asm!)))
           (dk-close-if-asm!))))))
(qed 'srt-chain)
;;; ---------------------------------------------------------------------------------------
;;; (4) srt-inf-picks: when P is infinite no stage covers P, so every step adds a point;
;;; dc-on-nn-pred chooses them: ph(k) is the maximiser added at stage k.
;;; ---------------------------------------------------------------------------------------
(define srt-picks-stmt
  (list 'FORALL 'P (srt-hyps 'P 'f
    (list 'IMPLIES '(NOT (IN (CARD P) NN))
      (list 'FORALL 'T (list 'IMPLIES (list 'IN 'T (list 'FUN 'NN (srt-X 'P)))
        (list 'IMPLIES (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (srt-phi 'P 'f '(T k) '(T (succ k)))))
          (list 'FORSOME 'ph (list 'AND '(IN ph (FUN NN P))
            (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (srt-pick 'P 'f '(T k) '(ph k) '(T (succ k))))))))))))))
(sp (make-wff srt-picks-stmt))
(define srt-pk-landed (dk-peel!))
(define srt-pk-p (car (srt-read-pf srt-pk-landed)))
(define srt-pk-f (cadr (srt-read-pf srt-pk-landed)))
(define srt-pk-X (srt-X srt-pk-p))
(define srt-pk-T (srt-read-fun srt-pk-landed srt-pk-X))
(define srt-pk-phiall
  (dk-find "the stage law" (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'OR))) srt-pk-landed))
(define (srt-pk-stage k) (list srt-pk-T k))
(define srt-pk-ex-claim
  (list 'FORALL 'srk_ (list 'IMPLIES '(IN srk_ NN)
    (list 'FORSOME 'srx_ (srt-pick srt-pk-p srt-pk-f (srt-pk-stage 'srk_) 'srx_ (srt-pk-stage '(succ srk_)))))))
(dk-have! srt-pk-ex-claim
  (lambda ()
    (let* ((kv (dk-di-var!))
           (o (dk-apply! srt-pk-phiall kv)))
      (dk-cite! 'fun-apply-type-c srt-pk-T 'NN srt-pk-X kv)
      (dk-or-each! o
        (lambda (h)
          (if (dk-head-is? h 'AND)
              (begin
                (dk-split! h)
                (srt-x-parts! srt-pk-p (srt-pk-stage kv))
                (srt-and! (list 'IN (srt-pk-stage kv) 'SET) (list 'IN (list 'CARD (srt-pk-stage kv)) 'NN))
                (dk-cite! 'card-subset-nn (srt-pk-stage kv))
                (srt-and! (list 'IN srt-pk-p 'SET) (srt-cov srt-pk-p (srt-pk-stage kv)))
                (let ((sn (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(CARD s))))
                                   "card-subset-nn instance")))
                  (dk-apply! sn srt-pk-p))
                (ai (list 'NOT (list 'IN (list 'CARD srt-pk-p) 'NN))))
              (dk-close-if-asm!)))))))
;; a point of P
(fact 'nn-zero-in)
(define srt-pk-x0
  (let ((ex (dk-apply! srt-pk-ex-claim 0))) (dk-skolem! ex)))
(define srt-pk-nxt
  (list 'VNB-LAMBDA '(LIST srk_ srv_) (list 'CARTESIAN 'NN srt-pk-p)
        (list 'SEP 'sry_ srt-pk-p (srt-pick srt-pk-p srt-pk-f (srt-pk-stage 'srk_) 'sry_ (srt-pk-stage '(succ srk_))))))
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
            (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u srt-pk-p)
              (list 'FORSOME 'y (list 'AND (list 'IN 'y srt-pk-p) (list 'IN 'y (list srt-pk-nxt 'k 'u))))))))
  (lambda ()
    (let* ((landed (dk-peel!))
           (kv (srt-var-of landed 'NN)))
      (dk-lam-b!)
      (let* ((ex (dk-apply! srt-pk-ex-claim kv))
             (x (dk-skolem! ex #f))
             (pk (srt-pick srt-pk-p srt-pk-f (srt-pk-stage kv) x (srt-pk-stage (list 'succ kv)))))
        (dk-have! (list 'IN x srt-pk-p) (lambda () (dk-split! (dk-ctx-form pk)) (dk-close-if-asm!)))
        (witness! x
          (lambda ()
            (dk-conj-close!
             (lambda ()
               (if (dk-head-is? (caddr (dk-goal)) 'SEP)
                   (srt-close-opened! (lambda () (sep-mi)))
                   (dk-close-if-asm!))))))))))
(define srt-pk-EX (dk-fact! 'dc-on-nn-pred srt-pk-p srt-pk-x0 srt-pk-nxt))
(define srt-pk-g (dk-skolem! srt-pk-EX))
(define srt-pk-gstep
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h srt-pk-g) (dk-contains? h 'succ)))
           "the per-stage step of g"))
(fact 'nn-is-set)
(witness! (list 'VNB-LAMBDA 'srn_ 'NN (list srt-pk-g '(succ srn_)))
  (lambda ()
    (dk-conj-close!
     (lambda ()
       (if (dk-head-is? (dk-goal) 'FORALL)
           (let* ((kv (dk-di-var!))
                  (sk (list 'succ kv)))
             (dk-cite! 'nn-succ-closed kv)
             (dk-cite! 'fun-apply-type-c srt-pk-g 'NN srt-pk-p kv)
             (dk-cite! 'fun-apply-type-c srt-pk-g 'NN srt-pk-p sk)
             (dk-lam-b!)
             (let* ((h (dk-apply! srt-pk-gstep kv))
                    (r (car (dk-landed (lambda () (lam-b-h h))))))
               (dk-sep-parts! r)
               (dk-close-if-asm!)))
           (dk-lam-type!
            (lambda ()
              (let ((nv (dk-di-var!)))
                (dk-cite! 'nn-succ-closed nv)
                (dk-cite! 'fun-apply-type-c srt-pk-g 'NN srt-pk-p (list 'succ nv))
                (dk-close-if-asm!)))))))))
(qed 'srt-inf-picks)
;;; ---------------------------------------------------------------------------------------
;;; (5) srt-picks-sorted: the points ph(k) picked along the stages enumerate P without
;;; repetition, in nonincreasing order of f, and f(ph k) eventually leaves every superlevel
;;; set that is finite.
;;; ---------------------------------------------------------------------------------------
(define (srt-b2 f ph) (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (list f (list ph '(succ n))) (list f (list ph 'n))))))
(define (srt-b3 f ph)
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'm (list 'IMPLIES '(IN m NN)
    (list 'IMPLIES '(<= m n) (list '<= (list f (list ph 'n)) (list f (list ph 'm)))))))))
(define (srt-lvl p f c) (list 'SEP 'y p (list '<= c (list f 'y))))
(define (srt-b4 p f ph)
  (list 'FORALL 'c (list 'IMPLIES '(IN c RR)
    (list 'IMPLIES (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= 'c (list f (list ph 'n)))))
      (list 'NOT (list 'IN (list 'CARD (srt-lvl p f 'c)) 'NN))))))
(define (srt-sorted-body p f ph)
  (list 'AND (list 'IN ph (list 'BIJECTION 'NN p))
    (list 'AND (srt-b2 f ph) (list 'AND (srt-b3 f ph) (srt-b4 p f ph)))))
(define (srt-picks-ctx p f body)
  (srt-hyps p f
    (list 'FORALL 'T (list 'IMPLIES (list 'IN 'T (list 'FUN 'NN (srt-X p)))
      (list 'IMPLIES '(= (T 0) EMPTY-SET)
        (list 'FORALL 'ph (list 'IMPLIES (list 'IN 'ph (list 'FUN 'NN p))
          (list 'IMPLIES (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (srt-pick p f '(T k) '(ph k) '(T (succ k)))))
            body))))))))

(sp (make-wff (list 'FORALL 'P (srt-picks-ctx 'P 'f (srt-sorted-body 'P 'f 'ph)))))
(define srt-so-landed (dk-peel!))
(define srt-so-p (car (srt-read-pf srt-so-landed)))
(define srt-so-f (cadr (srt-read-pf srt-so-landed)))
(define srt-so-typ (caddr (srt-read-pf srt-so-landed)))
(define srt-so-X (srt-X srt-so-p))
(define srt-so-T (srt-read-fun srt-so-landed srt-so-X))
(define srt-so-ph (srt-read-fun srt-so-landed srt-so-p))
(define srt-so-picks
  (dk-find "the picks" (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'UNION) (dk-contains? h srt-so-ph)))
           srt-so-landed))
(define srt-so-hfin
  (dk-find "finite superlevel sets" (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'CARD))) srt-so-landed))
(define srt-so-T0 (dk-find "T(0)" (lambda (h) (dk-head-is? h '=)) srt-so-landed))
(define (srt-so-stage k) (list srt-so-T k))
(define (srt-so-pt k) (list srt-so-ph k))
(define (srt-so-val k) (list srt-so-f (list srt-so-ph k)))
(define (srt-so-un k) (srt-un (srt-so-stage k) (srt-so-pt k)))
(define (srt-so-next-eq k) (list '= (srt-so-stage (list 'succ k)) (srt-so-un k)))

;; everything known at an index k in NN
(define (srt-so-at! k)
  (if (not (dk-asm? (srt-so-next-eq k)))
      (begin
        (dk-cite! 'fun-apply-type-c srt-so-T 'NN srt-so-X k)
        (srt-x-parts! srt-so-p (srt-so-stage k))
        (dk-cite! 'fun-apply-type-c srt-so-ph 'NN srt-so-p k)
        (dk-cite! 'membership-implies-sethood (srt-so-pt k) srt-so-p)
        (dk-apply! srt-so-typ (srt-so-pt k))
        (dk-split! (dk-apply! srt-so-picks k)))))
;; the point / value at an index, typed (no pick facts)
(define (srt-so-typed! k)
  (dk-cite! 'fun-apply-type-c srt-so-ph 'NN srt-so-p k)
  (dk-apply! srt-so-typ (srt-so-pt k)))

;; an induction lane: CLAIM = (FORALL v (IMPLIES (IN v NN) BODY)); BASE! on the base leaf;
;; STEP! called as (STEP! n ih) on the step leaf with n and the IH landed
(define (srt-induct! claim base! step!)
  (dk-have! claim
    (lambda ()
      (let* ((v (cadr claim)) (body (caddr (caddr claim)))
             (b0 (subst-free v 0 body))
             (leaves (dk-opened (lambda () (ni))))
             (base (dk-find "srt-induct! base" (lambda (l) (alpha-equiv? (dk-goal-of l) b0)) leaves))
             (step (dk-find "srt-induct! step" (lambda (l) (not (eq? l base))) leaves)))
        (dk-focus! base) (base!)
        (dk-focus! step)
        (let* ((nv (dk-di-var!))
               (ih (dk-landed-1 (lambda () (di)))))
          (step! nv ih))))))

;; C1: CARD(T n) = n
(define srt-so-c1 (list 'FORALL 'srn_ (list 'IMPLIES '(IN srn_ NN) (list '= (list 'CARD (srt-so-stage 'srn_)) 'srn_))))
(fact 'card-empty)
(srt-induct! srt-so-c1
  (lambda ()
    (subst srt-so-T0)
    (dk-subst-rfl! '(= (CARD EMPTY-SET) 0)))
  (lambda (n ih)
    (srt-so-at! n)
    (let ((cn (list 'CARD (srt-so-stage n))))
      (dk-cite! 'card-insert-curried (srt-so-stage n) (srt-so-pt n))
      (dk-cite! 'ord-succ-nn n)
      (subst (srt-so-next-eq n))
      (subst (list '= (list 'CARD (srt-so-un n)) (list 'SUCC_ORD cn)))
      (subst (list '= cn n))
      (dk-subst-rfl! (list '= (list 'SUCC_ORD n) (list 'succ n))))))

;; C2: j < n  ==>  ph(j) in T(n)
(define srt-so-c2
  (list 'FORALL 'srn_ (list 'IMPLIES '(IN srn_ NN) (list 'FORALL 'srj_ (list 'IMPLIES '(IN srj_ NN)
    (list 'IMPLIES '(< srj_ srn_) (list 'IN (srt-so-pt 'srj_) (srt-so-stage 'srn_))))))))
(srt-induct! srt-so-c2
  (lambda ()
    (let* ((landed (dk-peel!)) (j (srt-var-of landed 'NN)))
      (dk-nn-absurd! (list '< j 0))))
  (lambda (n ih)
    (let* ((landed (dk-peel!)) (j (srt-var-of landed 'NN)))
      (srt-so-at! n)
      (subst (srt-so-next-eq n))
      (use-em (list '= n j)
        (lambda () (subst (list '= j n)) (srt-in-union-new! (srt-so-stage n) (srt-so-pt n)))
        (lambda ()
          (dk-cite! 'nn-succ-closed n)
          (dk-cite! 'nn-lt-succ-le j (list 'succ n))
          (dk-have! (list '<= j n) (lambda () (dk-nn! (list '<= (list 'succ j) (list 'succ n))
                                                      (list '< j (list 'succ n)))))
          (dk-cite! 'nn-le-ne-succ j n)
          (dk-have! (list '< j n) (lambda () (dk-nn! (list '<= (list 'succ j) n))))
          (dk-apply! ih j)
          (srt-in-union-left! (srt-so-pt j) (srt-so-stage n) (srt-so-pt n)))))))

;; B2: f(ph(n+1)) <= f(ph(n))
(define srt-so-b2 (srt-b2 srt-so-f srt-so-ph))
(dk-have! srt-so-b2
  (lambda ()
    (let* ((n (dk-di-var!)) (sn (list 'succ n)))
      (dk-cite! 'nn-succ-closed n)
      (srt-so-at! n)
      (srt-so-at! sn)
      (dk-have! (list 'NOT (list 'IN (srt-so-pt sn) (srt-so-stage n)))
        (lambda ()
          (di)
          (srt-in-union-left! (srt-so-pt sn) (srt-so-stage n) (srt-so-pt n))
          (dk-rewrite-h! (list 'IN (srt-so-pt sn) (srt-so-un n)) (srt-so-un n) (srt-so-stage sn))
          (ai (list 'NOT (list 'IN (srt-so-pt sn) (srt-so-stage sn))))))
      (let ((mo (dk-find "maxout at n" (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h (srt-so-val n))
                                                         (dk-contains? h 'NOT)))
                         (dk-asms))))
        (dk-apply! mo (srt-so-pt sn))
        (dk-close-if-asm!)))))

;; B3: m <= n  ==>  f(ph n) <= f(ph m)
(define srt-so-b3 (srt-b3 srt-so-f srt-so-ph))
(srt-induct! srt-so-b3
  (lambda ()
    (let* ((landed (dk-peel!)) (m (srt-var-of landed 'NN)))
      (fact 'nn-zero-in)
      (dk-cite! 'nn-le-zero-is-zero m)
      (subst (list '= m 0))
      (srt-so-typed! 0)
      (dk-cite! 'rr-leq-reflexive (srt-so-val 0))
      (dk-close-if-asm!)))
  (lambda (n ih)
    (let* ((landed (dk-peel!)) (m (srt-var-of landed 'NN)) (sn (list 'succ n)))
      (dk-cite! 'nn-succ-closed n)
      (srt-so-typed! sn) (srt-so-typed! n) (srt-so-typed! m)
      (dk-or-each! (dk-cite! 'nn-le-succ-cases n m)
        (lambda (h)
          (if (dk-head-is? h '=)
              (begin (subst h) (dk-cite! 'rr-leq-reflexive (srt-so-val sn)) (dk-close-if-asm!))
              (begin
                (dk-apply! ih m)
                (dk-apply! srt-so-b2 n)
                (dk-ineq! (list '<= (srt-so-val sn) (srt-so-val n)) (list '<= (srt-so-val n) (srt-so-val m))
                          (list 'IN (srt-so-val sn) 'RR) (list 'IN (srt-so-val n) 'RR) (list 'IN (srt-so-val m) 'RR)))))))))

;; B4: if c <= f(ph n) for every n, the superlevel set at c is infinite
(define srt-so-b4 (srt-b4 srt-so-p srt-so-f srt-so-ph))
(dk-have! srt-so-b4
  (lambda ()
    (let* ((landed (dk-peel!))
           (c (srt-var-of landed 'RR))
           (hb (dk-find "the lower bound" (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h srt-so-ph))) landed))
           (l (srt-lvl srt-so-p srt-so-f c)))
      (if (dk-head-is? (dk-goal) 'NOT) (di))
      (let ((cl (list 'CARD l))
            (c5 (list 'FORALL 'srn_ (list 'IMPLIES '(IN srn_ NN)
                  (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ (srt-so-stage 'srn_)) (list 'IN 'srz_ l)))))))
        (srt-induct! c5
          (lambda ()
            (let* ((landed (dk-peel!))
                   (z (cadr (dk-find "z in T 0" (lambda (h) (dk-head-is? h 'IN)) landed))))
              (dk-rewrite-h! (list 'IN z (srt-so-stage 0)) (srt-so-stage 0) 'EMPTY-SET)
              (dk-cite! 'empty-set-has-no-members z)
              (ai (list 'NOT (list 'IN z 'EMPTY-SET)))))
          (lambda (n ih)
            (let* ((landed (dk-peel!))
                   (z (cadr (dk-find "z in T(n+1)" (lambda (h) (dk-head-is? h 'IN)) landed))))
              (srt-so-at! n)
              (dk-rewrite-h! (list 'IN z (srt-so-stage (list 'succ n))) (srt-so-stage (list 'succ n)) (srt-so-un n))
              (use-em (list 'IN z (srt-so-stage n))
                (lambda () (dk-apply! ih z) (dk-close-if-asm!))
                (lambda ()
                  (srt-new-point! z (srt-so-stage n) (srt-so-pt n))
                  (subst (list '= z (srt-so-pt n)))
                  (dk-apply! hb n)
                  (srt-sep-in! (srt-so-pt n) l))))))
        (dk-cite! 'nn-succ-closed cl)
        (let* ((m (list 'succ cl)) (tm (srt-so-stage m)))
          (srt-so-at! m)
          (dk-apply! srt-so-c1 m)
          (let ((iff (dk-cite! 'subset-def tm l)))
            (dk-apply! c5 m)
            (dk-iff-bwd! iff))
          (srt-sep-set! l)
          (srt-and! (list 'IN l 'SET) (list 'IN cl 'NN))
          (dk-apply! (dk-cite! 'card-subset-mono l) tm)
          (dk-rewrite-h! (list '<= (list 'CARD tm) cl) (list 'CARD tm) m)
          (dk-nn-absurd! (list '<= m cl)))))))

;; B1: ph is a bijection NN -> P
(define srt-so-iff (dk-cite! 'bijection-membership-iff 'NN srt-so-p srt-so-ph))
(define srt-so-inj (cadr (caddr (caddr srt-so-iff))))
(define srt-so-surj (caddr (caddr (caddr srt-so-iff))))
;; a < b, ph(a) = ph(b): absurd
(define (srt-so-lt-absurd! a b eqn)
  (dk-apply! srt-so-c2 b a)
  (srt-so-at! b)
  (dk-rewrite-h! (list 'IN (srt-so-pt a) (srt-so-stage b)) (srt-so-pt a) (srt-so-pt b))
  (ai (list 'NOT (list 'IN (srt-so-pt b) (srt-so-stage b)))))
(dk-have! srt-so-inj
  (lambda ()
    (let* ((landed (dk-peel!))
           (ab (filter (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) landed))
           (a (cadr (car ab))) (b (cadr (cadr ab)))
           (eqn (list '= (srt-so-pt a) (srt-so-pt b))))
      (use-em (list '= a b)
        (lambda () (dk-close-if-asm!))
        (lambda ()
          (dk-have! (list 'NOT (list '= b a))
            (lambda () (di) (dk-have! (list '= a b) (lambda () (dk-subst-rfl! (list '= a b))))
                       (ai (list 'NOT (list '= a b)))))
          (dk-cite! 'nn-in-rr a) (dk-cite! 'nn-in-rr b)
          (srt-and! (list 'IN a 'RR) (list 'IN b 'RR))
          (dk-or-each! (dk-cite! 'rr-leq-total a b)
            (lambda (h)
              (if (equal? h (list '<= a b))
                  (begin (dk-cite! 'nn-le-ne-succ a b)
                         (dk-have! (list '< a b) (lambda () (dk-nn! (list '<= (list 'succ a) b))))
                         (srt-so-lt-absurd! a b eqn))
                  (begin (dk-cite! 'nn-le-ne-succ b a)
                         (dk-have! (list '< b a) (lambda () (dk-nn! (list '<= (list 'succ b) a))))
                         (srt-so-lt-absurd! b a eqn))))))))))
(dk-have! srt-so-surj
  (lambda ()
    (let* ((x (dk-di-var!)) (g (dk-goal)))
      (use-em g
        (lambda () (dk-close-if-asm!))
        (lambda ()
          (let ((never (list 'FORALL 'srn_ (list 'IMPLIES '(IN srn_ NN) (list 'NOT (list '= (srt-so-pt 'srn_) x)))))
                (absent (list 'FORALL 'srn_ (list 'IMPLIES '(IN srn_ NN) (list 'NOT (list 'IN x (srt-so-stage 'srn_))))))
                (fx (list srt-so-f x)))
            (dk-have! never
              (lambda ()
                (let ((n (dk-di-var!)))
                  (di)
                  (dk-have! g (lambda () (witness! n (lambda () (dk-conj-close! (lambda () (dk-close-if-asm!)))))))
                  (ai (list 'NOT g)))))
            (srt-induct! absent
              (lambda ()
                (di)
                (dk-rewrite-h! (list 'IN x (srt-so-stage 0)) (srt-so-stage 0) 'EMPTY-SET)
                (dk-cite! 'empty-set-has-no-members x)
                (ai (list 'NOT (list 'IN x 'EMPTY-SET))))
              (lambda (n ih)
                (di)
                (srt-so-at! n)
                (dk-rewrite-h! (list 'IN x (srt-so-stage (list 'succ n))) (srt-so-stage (list 'succ n)) (srt-so-un n))
                (srt-new-point! x (srt-so-stage n) (srt-so-pt n))
                (dk-apply! never n)
                (dk-have! (list '= (srt-so-pt n) x) (lambda () (dk-subst-rfl! (list '= x (srt-so-pt n)))))
                (ai (list 'NOT (list '= (srt-so-pt n) x)))))
            (dk-apply! srt-so-typ x)
            (dk-have! (list 'FORALL 'srn_ (list 'IMPLIES '(IN srn_ NN) (list '<= fx (srt-so-val 'srn_))))
              (lambda ()
                (let ((n (dk-di-var!)))
                  (srt-so-at! n)
                  (dk-apply! absent n)
                  (let ((mo (dk-find "maxout at n" (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h (srt-so-val n))
                                                                     (dk-contains? h 'NOT)))
                                     (dk-asms))))
                    (dk-apply! mo x)
                    (dk-close-if-asm!)))))
            (dk-apply! srt-so-b4 fx)
            (dk-apply! srt-so-hfin x)
            (ai (list 'NOT (list 'IN (list 'CARD (srt-lvl srt-so-p srt-so-f fx)) 'NN)))))))))
(srt-and! (list 'IN srt-so-ph (list 'FUN 'NN srt-so-p)) srt-so-inj srt-so-surj)
(dk-iff-bwd! srt-so-iff)
(dk-conj-close! (lambda () (dk-close-if-asm!)))
(qed 'srt-picks-sorted)
;;; ---------------------------------------------------------------------------------------
;;; (6) srt-sort-infinite: P infinite, f > 0 on P with finite superlevel sets: a bijection
;;; ph : NN -> P along which f is nonincreasing and tends to 0.
;;; ---------------------------------------------------------------------------------------
(sp (make-wff (list 'FORALL 'P (srt-pos-hyps 'P 'f
  (list 'IMPLIES '(NOT (IN (CARD P) NN))
    (list 'FORSOME 'ph (list 'AND '(IN ph (BIJECTION NN P))
      (list 'AND (srt-b2 'f 'ph) (srt-lim 'f 'ph)))))))))
(define srt-in-landed (dk-peel!))
(define srt-in-p (car (srt-read-pf srt-in-landed)))
(define srt-in-f (cadr (srt-read-pf srt-in-landed)))
(define srt-in-typ (caddr (srt-read-pf srt-in-landed)))
(define srt-in-pos (dk-find "f > 0" (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '<))) srt-in-landed))
(define srt-in-hd (dk-find "superlevel at d" (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'POS-RR))) srt-in-landed))
;; the superlevel set at each point is finite
(dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x srt-in-p)
            (list 'IN (list 'CARD (list 'SEP 'y srt-in-p (list '<= (list srt-in-f 'x) (list srt-in-f 'y)))) 'NN)))
  (lambda ()
    (let* ((x (dk-di-var!)) (fx (list srt-in-f x)))
      (dk-apply! srt-in-typ x)
      (dk-apply! srt-in-pos x)
      (dk-cite! 'rr-pos-rr-of-lt fx)
      (dk-apply! srt-in-hd fx)
      (dk-close-if-asm!))))
(define srt-in-T (dk-skolem! (dk-apply! (dk-cite! 'srt-chain srt-in-p srt-in-f))))
(define srt-in-ph (dk-skolem! (dk-apply! (dk-cite! 'srt-inf-picks srt-in-p srt-in-f) srt-in-T)))
(dk-split! (dk-apply! (dk-cite! 'srt-picks-sorted srt-in-p srt-in-f) srt-in-T srt-in-ph))
(define srt-in-b3 (srt-b3 srt-in-f srt-in-ph))
(define srt-in-b4 (srt-b4 srt-in-p srt-in-f srt-in-ph))
(define (srt-in-val k) (list srt-in-f (list srt-in-ph k)))
(define (srt-in-typed! k)
  (dk-cite! 'fun-apply-type-c srt-in-ph 'NN srt-in-p k)
  (dk-apply! srt-in-typ (list srt-in-ph k)))
(dk-cite! 'bijection-in-fun 'NN srt-in-p srt-in-ph)
(witness! srt-in-ph
  (lambda ()
    (dk-conj-close!
     (lambda ()
       (if (dk-head-is? (dk-goal) 'FORALL)
           (if (dk-contains? (dk-goal) 'POS-RR)
               (let* ((landed (dk-peel!))
                      (d (cadr (dk-find "d" (lambda (h) (dk-head-is? h 'POS-RR)) landed)))
                      (ex (list 'FORSOME 'srq_ (list 'AND '(IN srq_ NN) (list '< (srt-in-val 'srq_) d)))))
                 (dk-cite! 'rr-pos-rr-in-rr d)
                 (use-em ex
                   (lambda ()
                     (let ((nn0 (dk-skolem! ex)))
                       (ew nn0)
                       (dk-conj-close!
                        (lambda ()
                          (if (dk-head-is? (dk-goal) 'FORALL)
                              (let* ((landed (dk-peel!))
                                     (n (srt-var-of landed 'NN)))
                                (srt-in-typed! n) (srt-in-typed! nn0)
                                (dk-apply! srt-in-b3 n nn0)
                                (dk-ineq! (list '<= (srt-in-val n) (srt-in-val nn0)) (list '< (srt-in-val nn0) d)
                                          (list 'IN (srt-in-val n) 'RR) (list 'IN (srt-in-val nn0) 'RR) (list 'IN d 'RR)))
                              (dk-close-if-asm!))))))
                   (lambda ()
                     (dk-have! (list 'FORALL 'srn_ (list 'IMPLIES '(IN srn_ NN) (list '<= d (srt-in-val 'srn_))))
                       (lambda ()
                         (let ((n (dk-di-var!)))
                           (srt-in-typed! n)
                           (use-em (list '<= d (srt-in-val n))
                             (lambda () (dk-close-if-asm!))
                             (lambda ()
                               (dk-cite! 'rr-not-le-lt d (srt-in-val n))
                               (dk-have! ex (lambda () (witness! n (lambda () (dk-conj-close! (lambda () (dk-close-if-asm!)))))))
                               (ai (list 'NOT ex)))))))
                     (dk-apply! srt-in-b4 d)
                     (dk-apply! srt-in-hd d)
                     (ai (list 'NOT (list 'IN (list 'CARD (srt-lvl srt-in-p srt-in-f d)) 'NN))))))
               (dk-close-if-asm!))
           (dk-close-if-asm!))))))
(qed 'srt-sort-infinite)


;;; ---------------------------------------------------------------------------------------
;;; (7) srt-sort-finite: a finite set P with a real key f is enumerated by a bijection
;;; ORD-SEGMENT(CARD P) -> P along which f is nonincreasing.  The stages of srt-chain; the
;;; k-th point is CHOICE of the maximisers added at stage k (k < CARD P).
;;; ---------------------------------------------------------------------------------------
(sp (make-wff '(FORALL P (IMPLIES (IN P SET) (IMPLIES (IN (CARD P) NN)
  (FORALL f (IMPLIES (IN f SET) (IMPLIES (FORALL x (IMPLIES (IN x P) (IN (f x) RR)))
    (FORSOME ph (AND (IN ph (BIJECTION (ORD-SEGMENT (CARD P)) P))
      (FORALL n (IMPLIES (IN n NN) (IMPLIES (< (succ n) (CARD P)) (<= (f (ph (succ n))) (f (ph n))))))))))))))))
(define srt-fi-landed (dk-peel!))
(define srt-fi-p (car (srt-read-pf srt-fi-landed)))
(define srt-fi-f (cadr (srt-read-pf srt-fi-landed)))
(define srt-fi-typ (caddr (srt-read-pf srt-fi-landed)))
(define srt-fi-m (list 'CARD srt-fi-p))
(define srt-fi-X (srt-X srt-fi-p))
;; superlevel sets of points are finite: they are subsets of P
(dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x srt-fi-p)
            (list 'IN (list 'CARD (list 'SEP 'y srt-fi-p (list '<= (list srt-fi-f 'x) (list srt-fi-f 'y)))) 'NN)))
  (lambda ()
    (let* ((x (dk-di-var!))
           (s (list 'SEP 'y srt-fi-p (list '<= (list srt-fi-f x) (list srt-fi-f 'y)))))
      (srt-sep-set! s)
      (srt-and! (list 'IN srt-fi-p 'SET) (list 'IN srt-fi-m 'NN))
      (dk-cite! 'card-subset-nn srt-fi-p)
      (dk-have! (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ s) (list 'IN 'srz_ srt-fi-p)))
        (lambda () (let ((z (cadr (car (dk-peel!))))) (dk-sep-parts! (list 'IN z s)) (dk-close-if-asm!))))
      (srt-and! (list 'IN s 'SET) (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ s) (list 'IN 'srz_ srt-fi-p))))
      (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(CARD s)))) "card-subset-nn") s)
      (dk-close-if-asm!))))
(define srt-fi-T (dk-skolem! (dk-apply! (dk-cite! 'srt-chain srt-fi-p srt-fi-f))))
(define srt-fi-phiall (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'OR) (dk-contains? h srt-fi-T)))
                               "the stage law"))
(define srt-fi-T0 (dk-pick (lambda (h) (and (dk-head-is? h '=) (equal? (cadr h) (list srt-fi-T 0)))) "T(0)"))
(define (srt-fi-stage k) (list srt-fi-T k))
(define (srt-fi-D k)
  (list 'SEP 'srd_ srt-fi-p (srt-pick srt-fi-p srt-fi-f (srt-fi-stage k) 'srd_ (srt-fi-stage (list 'succ k)))))
(define (srt-fi-pt k) (list 'CHOICE (srt-fi-D k)))
(define (srt-fi-val k) (list srt-fi-f (srt-fi-pt k)))
(define (srt-fi-un k) (srt-un (srt-fi-stage k) (srt-fi-pt k)))
(define (srt-fi-at! k)
  (dk-cite! 'fun-apply-type-c srt-fi-T 'NN srt-fi-X k)
  (srt-x-parts! srt-fi-p (srt-fi-stage k)))
(fact 'card-empty)
(fact 'nn-zero-in)
;; card T(n) = n, with n < CARD P in context: T(n) does not cover P
(define (srt-fi-notcov! n)
  (let ((cov (srt-cov srt-fi-p (srt-fi-stage n))))
    (dk-have! (list 'NOT cov)
      (lambda ()
        (di)
        (let ((iff (dk-cite! 'subset-def srt-fi-p (srt-fi-stage n))))
          (dk-iff-bwd! iff))
        (srt-and! (list 'IN (srt-fi-stage n) 'SET) (list 'IN (list 'CARD (srt-fi-stage n)) 'NN))
        (dk-apply! (dk-cite! 'card-subset-mono (srt-fi-stage n)) srt-fi-p)
        (dk-rewrite-h! (list '<= srt-fi-m (list 'CARD (srt-fi-stage n))) (list 'CARD (srt-fi-stage n)) n)
        (dk-nn-absurd! (list '<= srt-fi-m n) (list '< n srt-fi-m))))
    (list 'NOT cov)))

;; F1: n <= CARD P  ==>  CARD(T n) = n
(define srt-fi-f1
  (list 'FORALL 'srn_ (list 'IMPLIES '(IN srn_ NN)
    (list 'IMPLIES (list '<= 'srn_ srt-fi-m) (list '= (list 'CARD (srt-fi-stage 'srn_)) 'srn_)))))
(srt-induct! srt-fi-f1
  (lambda ()
    (di)
    (subst srt-fi-T0)
    (dk-subst-rfl! '(= (CARD EMPTY-SET) 0)))
  (lambda (n ih)
    (di)
    (dk-have! (list '<= n srt-fi-m) (lambda () (dk-nn! (list '<= (list 'succ n) srt-fi-m))))
    (dk-have! (list '< n srt-fi-m) (lambda () (dk-nn! (list '<= (list 'succ n) srt-fi-m))))
    (dk-apply! ih)
    (srt-fi-at! n)
    (let ((nc (srt-fi-notcov! n)))
      (dk-or-each! (dk-apply! srt-fi-phiall n)
        (lambda (h)
          (if (dk-head-is? h 'AND)
              (begin (dk-split! h) (ai nc))
              (let* ((x (dk-skolem! h))
                     (cn (list 'CARD (srt-fi-stage n)))
                     (un (srt-un (srt-fi-stage n) x)))
                (dk-cite! 'membership-implies-sethood x srt-fi-p)
                (dk-cite! 'card-insert-curried (srt-fi-stage n) x)
                (dk-cite! 'ord-succ-nn n)
                (subst (list '= (srt-fi-stage (list 'succ n)) un))
                (subst (list '= (list 'CARD un) (list 'SUCC_ORD cn)))
                (subst (list '= cn n))
                (dk-subst-rfl! (list '= (list 'SUCC_ORD n) (list 'succ n))))))))))

;; G: k < CARD P  ==>  CHOICE(D k) is the point picked at stage k
(define srt-fi-g
  (list 'FORALL 'srk_ (list 'IMPLIES '(IN srk_ NN)
    (list 'IMPLIES (list '< 'srk_ srt-fi-m)
      (srt-pick srt-fi-p srt-fi-f (srt-fi-stage 'srk_) (srt-fi-pt 'srk_) (srt-fi-stage '(succ srk_)))))))
(dk-have! srt-fi-g
  (lambda ()
    (let ((k (dk-di-var!)))
      (di)
      (dk-have! (list '<= k srt-fi-m) (lambda () (dk-nn! (list '< k srt-fi-m))))
      (dk-apply! srt-fi-f1 k)
      (srt-fi-at! k)
      (let ((nc (srt-fi-notcov! k)))
        (dk-or-each! (dk-apply! srt-fi-phiall k)
          (lambda (h)
            (if (dk-head-is? h 'AND)
                (begin (dk-split! h) (ai nc))
                (let* ((x (dk-skolem! h #f))
                       (pk (srt-pick srt-fi-p srt-fi-f (srt-fi-stage k) x (srt-fi-stage (list 'succ k)))))
                  (dk-have! (list 'IN x srt-fi-p) (lambda () (dk-split! (dk-ctx-form pk)) (dk-close-if-asm!)))
                  (choose-mem! (srt-fi-D k) x (lambda () (srt-close-opened! (lambda () (sep-mi)))))
                  (dk-sep-parts! (list 'IN (srt-fi-pt k) (srt-fi-D k)))
                  (dk-close-if-asm!)))))))))

;; everything known at an index k with k < CARD P in context
(define (srt-fi-get! k)
  (if (not (dk-asm? (list '= (srt-fi-stage (list 'succ k)) (srt-fi-un k))))
      (begin
        (srt-fi-at! k)
        (dk-split! (dk-apply! srt-fi-g k))
        (dk-cite! 'membership-implies-sethood (srt-fi-pt k) srt-fi-p)
        (dk-apply! srt-fi-typ (srt-fi-pt k)))))

;; F2: j < n <= CARD P  ==>  pt(j) in T(n)
(define srt-fi-f2
  (list 'FORALL 'srn_ (list 'IMPLIES '(IN srn_ NN) (list 'FORALL 'srj_ (list 'IMPLIES '(IN srj_ NN)
    (list 'IMPLIES '(< srj_ srn_) (list 'IMPLIES (list '<= 'srn_ srt-fi-m)
      (list 'IN (srt-fi-pt 'srj_) (srt-fi-stage 'srn_)))))))))
(srt-induct! srt-fi-f2
  (lambda ()
    (let* ((landed (dk-peel!)) (j (srt-var-of landed 'NN)))
      (dk-nn-absurd! (list '< j 0))))
  (lambda (n ih)
    (let* ((landed (dk-peel!)) (j (srt-var-of landed 'NN)))
      (dk-have! (list '< n srt-fi-m) (lambda () (dk-nn! (list '<= (list 'succ n) srt-fi-m))))
      (srt-fi-get! n)
      (subst (list '= (srt-fi-stage (list 'succ n)) (srt-fi-un n)))
      (use-em (list '= n j)
        (lambda () (subst (list '= j n)) (srt-in-union-new! (srt-fi-stage n) (srt-fi-pt n)))
        (lambda ()
          (dk-cite! 'nn-succ-closed n)
          (dk-cite! 'nn-lt-succ-le j (list 'succ n))
          (dk-have! (list '<= j n) (lambda () (dk-nn! (list '<= (list 'succ j) (list 'succ n)))))
          (dk-cite! 'nn-le-ne-succ j n)
          (dk-have! (list '< j n) (lambda () (dk-nn! (list '<= (list 'succ j) n))))
          (dk-have! (list '<= n srt-fi-m) (lambda () (dk-nn! (list '< n srt-fi-m))))
          (dk-apply! ih j)
          (srt-in-union-left! (srt-fi-pt j) (srt-fi-stage n) (srt-fi-pt n)))))))

;; the enumeration
(define srt-fi-seg (list 'ORD-SEGMENT srt-fi-m))
(define srt-fi-ph (list 'VNB-LAMBDA 'srk_ srt-fi-seg (srt-fi-pt 'srk_)))
(dk-cite! 'nn-subset-ord srt-fi-m)
(dk-cite! 'ord-segment-is-set srt-fi-m)
;; k in ORD-SEGMENT(CARD P): k in NN and k < CARD P
(define (srt-fi-seg-parts! k)
  (dk-cite! 'ord-segment-nn-subset srt-fi-m k)
  (dk-iff-fwd! (dk-cite! 'seg-mem-lt srt-fi-m k)))
;; k in NN and k < CARD P: k in ORD-SEGMENT(CARD P)
(define (srt-fi-seg-in! k)
  (if (not (dk-asm? (list 'IN k srt-fi-seg)))
      (dk-iff-bwd! (dk-cite! 'seg-mem-lt srt-fi-m k))))
(define srt-fi-iff (dk-cite! 'bijection-membership-iff srt-fi-seg srt-fi-p srt-fi-ph))
(define srt-fi-fun (cadr (caddr srt-fi-iff)))
(define srt-fi-inj (cadr (caddr (caddr srt-fi-iff))))
(define srt-fi-surj (caddr (caddr (caddr srt-fi-iff))))
(dk-have! srt-fi-fun
  (lambda ()
    (dk-lam-type!
     (lambda ()
       (let ((k (dk-di-var!)))
         (srt-fi-seg-parts! k)
         (srt-fi-get! k)
         (dk-close-if-asm!))))))
;; a < b < CARD P, pt(a) = pt(b): absurd
(define (srt-fi-lt-absurd! a b)
  (dk-have! (list '<= b srt-fi-m) (lambda () (dk-nn! (list '< b srt-fi-m))))
  (dk-apply! srt-fi-f2 b a)
  (srt-fi-get! b)
  (dk-rewrite-h! (list 'IN (srt-fi-pt a) (srt-fi-stage b)) (srt-fi-pt a) (srt-fi-pt b))
  (ai (list 'NOT (list 'IN (srt-fi-pt b) (srt-fi-stage b)))))
(dk-have! srt-fi-inj
  (lambda ()
    (let* ((landed (dk-peel!))
           (ab (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) srt-fi-seg))) landed))
           (a (cadr (car ab))) (b (cadr (cadr ab)))
           (eq0 (dk-find "ph a = ph b" (lambda (h) (dk-head-is? h '=)) landed)))
      (srt-fi-seg-parts! a) (srt-fi-seg-parts! b)
      (dk-lam-b-h! eq0)
      (use-em (list '= a b)
        (lambda () (dk-close-if-asm!))
        (lambda ()
          (dk-have! (list 'NOT (list '= b a))
            (lambda () (di) (dk-have! (list '= a b) (lambda () (dk-subst-rfl! (list '= a b))))
                       (ai (list 'NOT (list '= a b)))))
          (dk-cite! 'nn-in-rr a) (dk-cite! 'nn-in-rr b)
          (srt-and! (list 'IN a 'RR) (list 'IN b 'RR))
          (dk-or-each! (dk-cite! 'rr-leq-total a b)
            (lambda (h)
              (if (equal? h (list '<= a b))
                  (begin (dk-cite! 'nn-le-ne-succ a b)
                         (dk-have! (list '< a b) (lambda () (dk-nn! (list '<= (list 'succ a) b))))
                         (srt-fi-lt-absurd! a b))
                  (begin (dk-cite! 'nn-le-ne-succ b a)
                         (dk-have! (list '< b a) (lambda () (dk-nn! (list '<= (list 'succ b) a))))
                         (srt-fi-lt-absurd! b a))))))))))
(define (srt-fi-surj-main! w m tm)
      ;; F3: w in T(n), n <= CARD P  ==>  w = pt(k) for some k < n
      (let ((f3 (list 'FORALL 'srn_ (list 'IMPLIES '(IN srn_ NN)
                  (list 'IMPLIES (list '<= 'srn_ m) (list 'IMPLIES (list 'IN w (srt-fi-stage 'srn_))
                    (list 'FORSOME 'srk_ (list 'AND '(IN srk_ NN) (list 'AND '(< srk_ srn_)
                                                                   (list '= (srt-fi-pt 'srk_) w))))))))))
        (srt-induct! f3
          (lambda ()
            (di) (di)
            (dk-rewrite-h! (list 'IN w (srt-fi-stage 0)) (srt-fi-stage 0) 'EMPTY-SET)
            (dk-cite! 'empty-set-has-no-members w)
            (ai (list 'NOT (list 'IN w 'EMPTY-SET))))
          (lambda (n ih)
            (di) (di)
            (let ((sn (list 'succ n)))
              (dk-have! (list '< n m) (lambda () (dk-nn! (list '<= sn m))))
              (dk-have! (list '<= n m) (lambda () (dk-nn! (list '<= sn m))))
              (srt-fi-get! n)
              (srt-mem-transport! w (srt-fi-stage sn) (srt-fi-un n))
              (use-em (list 'IN w (srt-fi-stage n))
                (lambda ()
                  (let ((k (dk-skolem! (dk-apply! ih))))
                    (ew k)
                    (dk-conj-close!
                     (lambda ()
                       (if (dk-head-is? (dk-goal) '<)
                           (dk-nn! (list '< k n))
                           (dk-close-if-asm!))))))
                (lambda ()
                  (srt-new-point! w (srt-fi-stage n) (srt-fi-pt n))
                  (ew n)
                  (dk-conj-close!
                   (lambda ()
                     (cond ((dk-head-is? (dk-goal) '<) (dk-nn!))
                           ((dk-head-is? (dk-goal) '=) (dk-subst-rfl! (list '= w (srt-fi-pt n))))
                           (#t (dk-close-if-asm!))))))))))
        (let ((k (dk-skolem! (dk-apply! f3 m))))
          (srt-fi-seg-in! k)
          (ew k)
          (dk-conj-close!
           (lambda ()
             (if (dk-head-is? (dk-goal) '=)
                 (begin (dk-lam-b!) (dk-close-if-asm!))
                 (dk-close-if-asm!)))))))

(dk-have! srt-fi-surj
  (lambda ()
    (let* ((w (dk-di-var!))
           (m srt-fi-m)
           (tm (srt-fi-stage m)))
      (dk-cite! 'membership-implies-sethood w srt-fi-p)
      (dk-cite! 'nn-le-refl m)
      (srt-fi-at! m)
      (dk-apply! srt-fi-f1 m)
      ;; w is in T(CARD P)
      (use-em (list 'IN w tm)
        (lambda () (srt-fi-surj-main! w m tm))
        (lambda ()
          (let ((un (srt-un tm w)))
            (dk-cite! 'card-insert-curried tm w)
            (dk-cite! 'ord-succ-nn m)
            (dk-have! (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ un) (list 'IN 'srz_ srt-fi-p)))
              (lambda ()
                (let ((z (cadr (car (dk-peel!)))))
                  (use-em (list 'IN z tm)
                    (lambda ()
                               (srt-sub-apply! tm srt-fi-p z)
                               (dk-close-if-asm!))
                    (lambda () (srt-new-point! z tm w) (subst (list '= z w)) (dk-close-if-asm!))))))
            (dk-iff-bwd! (dk-cite! 'subset-def un srt-fi-p))
            (srt-and! (list 'IN srt-fi-p 'SET) (list 'IN m 'NN))
            (dk-apply! (dk-cite! 'card-subset-mono srt-fi-p) un)
            (dk-rewrite-h! (list '<= (list 'CARD un) m) (list 'CARD un) (list 'SUCC_ORD (list 'CARD tm)))
            (dk-rewrite-h! (list '<= (list 'SUCC_ORD (list 'CARD tm)) m) (list 'CARD tm) m)
            (dk-rewrite-h! (list '<= (list 'SUCC_ORD m) m) (list 'SUCC_ORD m) (list 'succ m))
            (dk-nn-absurd! (list '<= (list 'succ m) m))))))))
(srt-and! srt-fi-fun srt-fi-inj srt-fi-surj)
(dk-iff-bwd! srt-fi-iff)
;; the order
(define srt-fi-ord
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES (list '< '(succ n) srt-fi-m)
    (list '<= (list srt-fi-f (list srt-fi-ph '(succ n))) (list srt-fi-f (list srt-fi-ph 'n)))))))
(dk-have! srt-fi-ord
  (lambda ()
    (let* ((n (dk-di-var!)) (sn (list 'succ n)))
      (di)
      (dk-cite! 'nn-succ-closed n)
      (dk-have! (list '< n srt-fi-m) (lambda () (dk-nn! (list '< sn srt-fi-m))))
      (srt-fi-seg-in! n) (srt-fi-seg-in! sn)
      (dk-lam-b!)
      (srt-fi-get! n) (srt-fi-get! sn)
      (dk-have! (list 'NOT (list 'IN (srt-fi-pt sn) (srt-fi-stage n)))
        (lambda ()
          (di)
          (srt-in-union-left! (srt-fi-pt sn) (srt-fi-stage n) (srt-fi-pt n))
          (dk-rewrite-h! (list 'IN (srt-fi-pt sn) (srt-fi-un n)) (srt-fi-un n) (srt-fi-stage sn))
          (ai (list 'NOT (list 'IN (srt-fi-pt sn) (srt-fi-stage sn))))))
      (let ((mo (dk-find "maxout at n" (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h (srt-fi-val n))
                                                         (dk-contains? h 'NOT)))
                         (dk-asms))))
        (dk-apply! mo (srt-fi-pt sn))
        (dk-close-if-asm!)))))
(witness! srt-fi-ph (lambda () (dk-conj-close! (lambda () (dk-close-if-asm!)))))
(qed 'srt-sort-finite)
;;; ---------------------------------------------------------------------------------------
;;; (8) srt-superlevel-sort: f : S -> RR with {x in S : d <= f(x)} finite for every d > 0.
;;; Then P = {x in S : 0 < f(x)} is enumerated in nonincreasing order of f: either P is
;;; finite and ORD-SEGMENT(CARD P) -> P, or P is infinite and NN -> P with f(ph n) -> 0.
;;; ---------------------------------------------------------------------------------------
(define (srt-sl-pos s f) (list 'SEP 'x s (list '< 0 (list f 'x))))
(define srt-sl-P (srt-sl-pos 'S 'f))
(define srt-sl-stmt
  (list 'FORALL 'S (list 'IMPLIES '(IN S SET) (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN S RR))
    (list 'IMPLIES (list 'FORALL 'd (list 'IMPLIES '(POS-RR d) (list 'IN (list 'CARD (list 'SEP 'x 'S '(<= d (f x)))) 'NN)))
      (list 'OR
        (list 'AND (list 'IN (list 'CARD srt-sl-P) 'NN)
          (list 'FORSOME 'ph (list 'AND (list 'IN 'ph (list 'BIJECTION (list 'ORD-SEGMENT (list 'CARD srt-sl-P)) srt-sl-P))
            (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES (list '< '(succ n) (list 'CARD srt-sl-P))
                                                          '(<= (f (ph (succ n))) (f (ph n)))))))))
        (list 'AND (list 'NOT (list 'IN (list 'CARD srt-sl-P) 'NN))
          (list 'FORSOME 'ph (list 'AND (list 'IN 'ph (list 'BIJECTION 'NN srt-sl-P))
            (list 'AND (srt-b2 'f 'ph) (srt-lim 'f 'ph))))))))))))
(sp (make-wff srt-sl-stmt))
(define srt-sl-landed (dk-peel!))
(define srt-sl-ft (dk-find "f in FUN(S, RR)" (lambda (h) (and (dk-head-is? h 'IN) (dk-head-is? (caddr h) 'FUN))) srt-sl-landed))
(define srt-sl-f (cadr srt-sl-ft))
(define srt-sl-s (cadr (caddr srt-sl-ft)))
(define srt-sl-hd (dk-find "superlevel at d" (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'POS-RR))) srt-sl-landed))
(define srt-sl-p (srt-sl-pos srt-sl-s srt-sl-f))
(srt-sep-set! srt-sl-p)
(srt-and! srt-sl-ft (list 'IN srt-sl-s 'SET))
(dk-cite! 'fun-elements-are-sets srt-sl-s 'RR srt-sl-f)
(dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x srt-sl-p) (list 'IN (list srt-sl-f 'x) 'RR)))
  (lambda () (let ((x (dk-di-var!)))
               (dk-sep-parts! (list 'IN x srt-sl-p))
               (dk-cite! 'fun-apply-type-c srt-sl-f srt-sl-s 'RR x)
               (dk-close-if-asm!))))
(dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x srt-sl-p) (list '< 0 (list srt-sl-f 'x))))
  (lambda () (let ((x (dk-di-var!)))
               (dk-sep-parts! (list 'IN x srt-sl-p))
               (dk-close-if-asm!))))
(dk-have! (list 'FORALL 'd (list 'IMPLIES '(POS-RR d)
            (list 'IN (list 'CARD (list 'SEP 'y srt-sl-p (list '<= 'd (list srt-sl-f 'y)))) 'NN)))
  (lambda ()
    (let* ((landed (dk-peel!))
           (d (cadr (dk-find "d" (lambda (h) (dk-head-is? h 'POS-RR)) landed)))
           (big (list 'SEP 'x srt-sl-s (list '<= d (list srt-sl-f 'x))))
           (small (list 'SEP 'y srt-sl-p (list '<= d (list srt-sl-f 'y))))
           (sub (list 'FORALL 'srz_ (list 'IMPLIES (list 'IN 'srz_ small) (list 'IN 'srz_ big)))))
      (dk-apply! srt-sl-hd d)
      (srt-sep-set! big)
      (srt-sep-set! small)
      (dk-have! sub
        (lambda ()
          (let ((z (cadr (car (dk-peel!)))))
            (dk-sep-parts! (list 'IN z small))
            (dk-sep-parts! (list 'IN z srt-sl-p))
            (srt-sep-in! z big))))
      (let ((cb (dk-find "card big" (lambda (h) (and (dk-head-is? h 'IN) (dk-head-is? (cadr h) 'CARD)
                                                     (alpha-equiv? (cadr (cadr h)) big))) (dk-asms))))
        (srt-and! (list 'IN big 'SET) cb))
      (let ((sn (dk-cite! 'card-subset-nn big)))
        (srt-and! (list 'IN small 'SET) sub)
        (dk-apply! sn small))
      (dk-close-if-asm!))))
(use-em (list 'IN (list 'CARD srt-sl-p) 'NN)
  (lambda ()
    (oi-l)
    (dk-conj-close!
     (lambda ()
       (if (dk-head-is? (dk-goal) 'FORSOME)
           (begin (dk-apply! (dk-cite! 'srt-sort-finite srt-sl-p) srt-sl-f) (dk-close-if-asm!))
           (dk-close-if-asm!)))))
  (lambda ()
    (oi-r)
    (dk-conj-close!
     (lambda ()
       (if (dk-head-is? (dk-goal) 'FORSOME)
           (begin (dk-apply! (dk-cite! 'srt-sort-infinite srt-sl-p) srt-sl-f) (dk-close-if-asm!))
           (dk-close-if-asm!))))))
(qed 'srt-superlevel-sort)
