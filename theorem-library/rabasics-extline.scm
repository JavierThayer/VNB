;;; rabasics-extline.scm -- calculus.pdf 1.13: x |-> x / (1 - |x|) is an order preserving bijection
;;; of (-1, 1) onto R, with inverse s |-> s / (1 + |s|), and it is odd.
;;;
;;; The real-algebra core (helper prefix rbe-):
;;;   rr-quot-abs               |a * recip(c)| = |a| * recip(c) for c > 0
;;;   rr-pos-of-mul-eq-one      d * a = 1, a > 0  =>  d > 0
;;;   ooint-rr-iso-g-den        (1 - |g(s)|) * (1 + |s|) = 1            g(s) = s * recip(1 + |s|)
;;;   ooint-rr-iso-f-den        (1 + |f(x)|) * (1 - |x|) = 1  (|x| < 1) f(x) = x * recip(1 - |x|)
;;;   ooint-rr-iso-g-small      |g(s)| < 1
;;;   ooint-rr-iso-f-real       f(x) in RR (|x| < 1)
;;;   ooint-rr-iso-g-inv        f(g(s)) = s
;;;   ooint-rr-iso-f-inv        g(f(x)) = x  (|x| < 1)
;;;   ooint-rr-iso-g-mono       s <= t  =>  g(s) <= g(t)
;;; and the notes' statements, with `/' as the notes write them:
;;;   ooint-rr-iso-strict       x < y in (-1, 1)  =>  f(x) < f(y)
;;;   ooint-rr-iso-odd          f(-x) = -f(x)
;;;   ooint-rr-iso-bijection    VNB-LAMBDA(x, (-1, 1), x / (1 - |x|)) in BIJECTION((-1, 1), RR),
;;;                             the inverse map being VNB-LAMBDA(s, RR, s / (1 + |s|))
;;;   ooint-rr-iso-inverse      for s in RR: s / (1 + |s|) in (-1, 1) and f of it is s; for x in
;;;                             (-1, 1): g(f(x)) = x
;;;
;;;   ooint-rr-order-iso        IS-ORDER-ISO(that map, (-1, 1), RR)  (rabasics-vocab)
;;;
;;; Library: core (RR, OOINT, BIJECTION, abs, recip).  Needs rabasics-vocab (IS-ORDER-ISO).  Load window: after
;;; theorem-library/rr-order-basics, rr-abs-basics, rr-recip-order (rr-recip-antitone), the
;;; ooint vocabulary and theorem-library/bijection laws (bijection-from-inverse); no citer yet.

(define (rbe-find what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "rbe-find: nothing matching" what) (car l))))

;;; type an arithmetic term in RR from typed atoms (recursively); a recip needs its argument's
;;; non-vanishing in context.
(define (rbe-rr! t)
  (let ((goal (list 'IN t 'RR)))
    (cond ((dk-asm? goal) #t)
          ((eqv? t 0) (fact 'rr-zero-in))
          ((eqv? t 1) (fact 'rr-one-in))
          ((not (pair? t)) (error "rbe-rr!: untyped atom" t))
          ((and (eq? (car t) '+) (= (length t) 3))
           (rbe-rr! (cadr t)) (rbe-rr! (caddr t))
           (dk-have! (list 'AND (list 'IN (cadr t) 'RR) (list 'IN (caddr t) 'RR)))
           (fact 'rr-add-closed (cadr t) (caddr t)))
          ((and (eq? (car t) '*) (= (length t) 3))
           (rbe-rr! (cadr t)) (rbe-rr! (caddr t))
           (dk-have! (list 'AND (list 'IN (cadr t) 'RR) (list 'IN (caddr t) 'RR)))
           (fact 'rr-mul-closed (cadr t) (caddr t)))
          ((and (eq? (car t) '-) (= (length t) 3))
           (rbe-rr! (cadr t)) (rbe-rr! (caddr t))
           (fact 'rr-sub-in-rr (cadr t) (caddr t)))
          ((and (eq? (car t) '-) (= (length t) 2))
           (rbe-rr! (cadr t)) (fact 'rr-neg-closed (cadr t)))
          ((eq? (car t) 'abs)
           (rbe-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)))
          ((eq? (car t) 'recip)
           (rbe-rr! (cadr t))
           (dk-have! (list 'AND (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0))))
           (fact 'rr-recip-closed (cadr t)))
          (#t (error "rbe-rr!: no typing rule for" t)))
    (if (not (dk-asm? goal)) (error "rbe-rr!: typing did not land" goal))))

;;; a in RR and 0 < a in context: land a /= 0, recip(a) in RR, 0 < recip(a), a * recip(a) = 1.
(define (rbe-recip! a)
  (rbe-rr! a)
  (if (not (dk-asm? (list 'NOT (list '= a 0)))) (fact 'rr-pos-ne-zero a))
  (rbe-rr! (list 'recip a))
  (if (not (dk-asm? (list '< 0 (list 'recip a)))) (fact 'rr-recip-pos a))
  (if (not (dk-asm? (list '<= 0 (list 'recip a)))) (fact 'rr-lt-implies-le 0 (list 'recip a)))
  (if (not (dk-asm? (list '= (list '* a (list 'recip a)) 1)))
      (fact 'rr-recip-inverse a)))

;;; a ring identity with recip subterms treated as opaque reals
(define (rbe-ring! eqn)
  (dk-have! eqn (lambda () (dk-crs-opaque!))))

;;; ---------------------------------------------------------------------------
(sp (make-wff
  '(FORALL a (IMPLIES (IN a RR) (FORALL c (IMPLIES (IN c RR)
     (IMPLIES (< 0 c) (= (abs (* a (recip c))) (* (abs a) (recip c))))))))))
(dk-peel!)
(let* ((g (dk-goal)) (a (cadr (cadr (cadr g)))) (c (cadr (caddr (cadr (cadr g))))))
  (rbe-recip! c)
  (rbe-rr! (list 'abs a))
  (dk-have! (list 'AND (list 'IN a 'RR) (list 'IN (list 'recip c) 'RR)))
  (fact 'rr-abs-mult a (list 'recip c))
  (fact 'rr-abs-of-nonneg (list 'recip c))
  (subst (list '= (list 'abs (list '* a (list 'recip c))) (list '* (list 'abs a) (list 'abs (list 'recip c)))))
  (subst (list '= (list 'abs (list 'recip c)) (list 'recip c)))
  (rfl))
(qed 'rr-quot-abs)

(sp (make-wff
  '(FORALL d (IMPLIES (IN d RR) (FORALL a (IMPLIES (IN a RR)
     (IMPLIES (< 0 a) (IMPLIES (= (* d a) 1) (< 0 d)))))))))
(dk-peel!)
(let* ((d (caddr (dk-goal)))
       (e (rbe-find 'eqn (lambda (f) (and (eq? (car f) '=) (pair? (cadr f)) (eq? (car (cadr f)) '*)))))
       (a (caddr (cadr e))))
  (rbe-recip! a)
  (fact 'rr-one-in)
  (dk-have! (list 'AND (list 'IN a 'RR) (list 'IN d 'RR)))
  (fact 'rr-mul-comm a d)
  (dk-have! (list '= 1 (list '* a d))
    (lambda () (subst (list '= (list '* a d) (list '* d a))) (subst (list '= (list '* d a) 1)) (rfl)))
  (fact 'rr-recip-solve a 1 d)                     ; d = recip(a) * 1
  (rbe-rr! (list '* (list 'recip a) 1))
  (dk-ineq! (list '= d (list '* (list 'recip a) 1)) (list '< 0 (list 'recip a))))
(qed 'rr-pos-of-mul-eq-one)

;;; ---------------------------------------------------------------------------
;;; 1 = c * v (either order in context) -> land (= (recip c) v), c typed, nonzero.
(define (rbe-recip-is! c v)
  (rbe-rr! v)
  (fact 'rr-one-in)
  (if (not (dk-asm? (list '= 1 (list '* c v))))
      (dk-have! (list '= 1 (list '* c v))
        (lambda () (subst (list '= (list '* c v) 1)) (rfl))))
  (fact 'rr-recip-solve c 1 v)                            ; v = recip(c) * 1
  (let ((rc (list 'recip c)))
    (rbe-rr! (list '* rc 1))
    (dk-have! (list '= (list '* rc 1) rc) (lambda () (dk-crs-opaque!)))
    (dk-rewrite-h! (list '= v (list '* rc 1)) (list '* rc 1) rc)
    (dk-have! (list '= rc v) (lambda () (subst (list '= rc v)) (rfl)))))

;;; s in RR: A = 1 + |s|, its recip, 0 < A.
(define (rbe-gden-setup! s)
  (let ((A (list '+ 1 (list 'abs s))))
    (rbe-rr! (list 'abs s))
    (fact 'rr-abs-nonneg s)
    (rbe-rr! A)
    (dk-have! (list '< 0 A) (lambda () (dk-ineq! (list '<= 0 (list 'abs s)))))
    (rbe-recip! A)
    A))
;;; x in RR, |x| < 1: D = 1 - |x|, its recip, 0 < D.
(define (rbe-fden-setup! x)
  (let ((D (list '- 1 (list 'abs x))))
    (rbe-rr! (list 'abs x))
    (rbe-rr! D)
    (dk-have! (list '< 0 D) (lambda () (dk-ineq! (list '< (list 'abs x) 1))))
    (rbe-recip! D)
    D))

(define rbe-g-den-stmt
  '(FORALL s (IMPLIES (IN s RR)
     (= (* (- 1 (abs (* s (recip (+ 1 (abs s)))))) (+ 1 (abs s))) 1))))
(sp (make-wff rbe-g-den-stmt))
(dk-peel!)
(let* ((s  (cadr (car (filter (lambda (f) (eq? (car f) 'IN)) (dk-asms)))))
       (A  (rbe-gden-setup! s))
       (rA (list 'recip A)))
  (fact 'rr-quot-abs s A)
  (subst (list '= (list 'abs (list '* s rA)) (list '* (list 'abs s) rA)))
  (rbe-ring! (list '= (list '* (list '- 1 (list '* (list 'abs s) rA)) A)
                      (list '- A (list '* (list 'abs s) (list '* A rA)))))
  (subst (list '= (list '* (list '- 1 (list '* (list 'abs s) rA)) A)
                  (list '- A (list '* (list 'abs s) (list '* A rA)))))
  (subst (list '= (list '* A rA) 1))
  (dk-crs-opaque!))
(qed 'ooint-rr-iso-g-den)

(define rbe-f-den-stmt
  '(FORALL x (IMPLIES (IN x RR) (IMPLIES (< (abs x) 1)
     (= (* (+ 1 (abs (* x (recip (- 1 (abs x)))))) (- 1 (abs x))) 1)))))
(sp (make-wff rbe-f-den-stmt))
(dk-peel!)
(let* ((x  (cadr (car (filter (lambda (f) (eq? (car f) 'IN)) (dk-asms)))))
       (D  (rbe-fden-setup! x))
       (rD (list 'recip D)))
  (fact 'rr-quot-abs x D)
  (subst (list '= (list 'abs (list '* x rD)) (list '* (list 'abs x) rD)))
  (rbe-ring! (list '= (list '* (list '+ 1 (list '* (list 'abs x) rD)) D)
                      (list '+ D (list '* (list 'abs x) (list '* D rD)))))
  (subst (list '= (list '* (list '+ 1 (list '* (list 'abs x) rD)) D)
                  (list '+ D (list '* (list 'abs x) (list '* D rD)))))
  (subst (list '= (list '* D rD) 1))
  (dk-crs-opaque!))
(qed 'ooint-rr-iso-f-den)

(sp (make-wff
  '(FORALL s (IMPLIES (IN s RR) (< (abs (* s (recip (+ 1 (abs s))))) 1)))))
(dk-peel!)
(let* ((s  (cadr (car (filter (lambda (f) (eq? (car f) 'IN)) (dk-asms)))))
       (A  (rbe-gden-setup! s))
       (q  (list '* s (list 'recip A)))
       (Dq (list '- 1 (list 'abs q))))
  (rbe-rr! Dq)
  (fact 'ooint-rr-iso-g-den s)
  (fact 'rr-pos-of-mul-eq-one Dq A)
  (dk-ineq! (list '< 0 Dq)))
(qed 'ooint-rr-iso-g-small)

(sp (make-wff
  '(FORALL x (IMPLIES (IN x RR) (IMPLIES (< (abs x) 1) (IN (* x (recip (- 1 (abs x)))) RR))))))
(dk-peel!)
(let* ((x (cadr (car (filter (lambda (f) (eq? (car f) 'IN)) (dk-asms)))))
       (D (rbe-fden-setup! x)))
  (rbe-rr! (list '* x (list 'recip D)))
  (ass))
(qed 'ooint-rr-iso-f-real)

(sp (make-wff
  '(FORALL s (IMPLIES (IN s RR)
     (= (* (* s (recip (+ 1 (abs s)))) (recip (- 1 (abs (* s (recip (+ 1 (abs s)))))))) s)))))
(dk-peel!)
(let* ((s  (cadr (car (filter (lambda (f) (eq? (car f) 'IN)) (dk-asms)))))
       (A  (rbe-gden-setup! s))
       (q  (list '* s (list 'recip A)))
       (Dq (list '- 1 (list 'abs q))))
  (rbe-rr! Dq)
  (fact 'ooint-rr-iso-g-den s)
  (fact 'rr-pos-of-mul-eq-one Dq A)
  (rbe-recip! Dq)
  (rbe-recip-is! Dq A)
  (subst (list '= (list 'recip Dq) A))
  (fact 'rr-recip-cancel-right s A)
  (subst (list '= (list '* q A) s))
  (rfl))
(qed 'ooint-rr-iso-g-inv)

(sp (make-wff
  '(FORALL x (IMPLIES (IN x RR) (IMPLIES (< (abs x) 1)
     (= (* (* x (recip (- 1 (abs x)))) (recip (+ 1 (abs (* x (recip (- 1 (abs x)))))))) x))))))
(dk-peel!)
(let* ((x  (cadr (car (filter (lambda (f) (eq? (car f) 'IN)) (dk-asms)))))
       (D  (rbe-fden-setup! x))
       (p  (list '* x (list 'recip D)))
       (Ep (list '+ 1 (list 'abs p))))
  (rbe-rr! p)
  (fact 'rr-abs-nonneg p)
  (rbe-rr! Ep)
  (dk-have! (list '< 0 Ep) (lambda () (dk-ineq! (list '<= 0 (list 'abs p)))))
  (rbe-recip! Ep)
  (fact 'ooint-rr-iso-f-den x)
  (rbe-recip-is! Ep D)
  (subst (list '= (list 'recip Ep) D))
  (fact 'rr-recip-cancel-right x D)
  (subst (list '= (list '* p D) x))
  (rfl))
(qed 'ooint-rr-iso-f-inv)

;;; ---------------------------------------------------------------------------
;;; the two closed forms of g on each sign: a * r = 1 and a = 1 + s gives s * r = 1 - r;
;;; a * r = 1 and a = 1 + (-s) gives s * r = r - 1.
(sp (make-wff
  '(FORALL s (IMPLIES (IN s RR) (FORALL a (IMPLIES (IN a RR) (FORALL r (IMPLIES (IN r RR)
     (IMPLIES (= (* a r) 1) (IMPLIES (= a (+ 1 s)) (= (* s r) (- 1 r))))))))))))
(dk-peel!)
(let* ((g (dk-goal)) (sv (cadr (cadr g))) (r (caddr (cadr g)))
       (e (rbe-find 'eq (lambda (f) (and (eq? (car f) '=) (pair? (caddr f)) (eq? (car (caddr f)) '+)))))
       (a (cadr e)))
  (dk-rewrite-h! (list '= (list '* a r) 1) a (list '+ 1 sv))
  (rbe-ring! (list '= (list '* sv r) (list '- (list '* (list '+ 1 sv) r) r)))
  (subst (list '= (list '* sv r) (list '- (list '* (list '+ 1 sv) r) r)))
  (subst (list '= (list '* (list '+ 1 sv) r) 1))
  (rfl))
(qed 'rr-recip-form-nonneg)

(sp (make-wff
  '(FORALL s (IMPLIES (IN s RR) (FORALL a (IMPLIES (IN a RR) (FORALL r (IMPLIES (IN r RR)
     (IMPLIES (= (* a r) 1) (IMPLIES (= a (+ 1 (- s))) (= (* s r) (- r 1))))))))))))
(dk-peel!)
(let* ((g (dk-goal)) (sv (cadr (cadr g))) (r (caddr (cadr g)))
       (e (rbe-find 'eq (lambda (f) (and (eq? (car f) '=) (pair? (caddr f)) (eq? (car (caddr f)) '+)))))
       (a (cadr e)))
  (dk-rewrite-h! (list '= (list '* a r) 1) a (list '+ 1 (list '- sv)))
  (rbe-ring! (list '= (list '* sv r) (list '- r (list '* (list '+ 1 (list '- sv)) r))))
  (subst (list '= (list '* sv r) (list '- r (list '* (list '+ 1 (list '- sv)) r))))
  (subst (list '= (list '* (list '+ 1 (list '- sv)) r) 1))
  (rfl))
(qed 'rr-recip-form-neg)

;;; with the sign case of s landed ((= (abs s) s) or (= (abs s) (- s))), land g(s) in closed form
(define (rbe-gform! s)
  (let* ((A  (list '+ 1 (list 'abs s)))
         (rA (list 'recip A)))
    (if (dk-asm? (list '= (list 'abs s) s))
        (begin
          (dk-have! (list '= A (list '+ 1 s)) (lambda () (subst (list '= (list 'abs s) s)) (rfl)))
          (fact 'rr-recip-form-nonneg s A rA))
        (begin
          (dk-have! (list '= A (list '+ 1 (list '- s))) (lambda () (subst (list '= (list 'abs s) (list '- s))) (rfl)))
          (fact 'rr-recip-form-neg s A rA)))))

;;; rA <= 1 for A = 1 + |s|
(define (rbe-recip-le-one! s)
  (let* ((A (list '+ 1 (list 'abs s))) (rA (list 'recip A)))
    (fact 'rr-one-in)
    (fact 'rr-zero-lt-one)
    (dk-have! (list '<= 1 A) (lambda () (dk-ineq! (list '<= 0 (list 'abs s)))))
    (fact 'rr-recip-antitone 1 A)
    (fact 'rr-recip-one)
    (dk-rewrite-h! (list '<= rA (list 'recip 1)) (list 'recip 1) 1)))

(sp (make-wff
  '(FORALL s (IMPLIES (IN s RR) (FORALL t (IMPLIES (IN t RR) (IMPLIES (<= s t)
     (<= (* s (recip (+ 1 (abs s)))) (* t (recip (+ 1 (abs t))))))))))))
(dk-peel!)
(let* ((g  (dk-goal))
       (sv (cadr (cadr g))) (tv (cadr (caddr g)))
       (As (rbe-gden-setup! sv)) (At (rbe-gden-setup! tv))
       (rAs (list 'recip As)) (rAt (list 'recip At))
       (gs (cadr g)) (gt (caddr g)))
  (rbe-rr! gs) (rbe-rr! gt)
  (rbe-recip-le-one! sv) (rbe-recip-le-one! tv)
  (fact 'rr-abs-cases sv)
  (fact 'rr-abs-cases tv)
  (let ((cs (rbe-find 'cases-s (lambda (f) (and (eq? (car f) 'OR) (dk-contains? f sv) (not (dk-contains? f tv))))))
        (ct (rbe-find 'cases-t (lambda (f) (and (eq? (car f) 'OR) (dk-contains? f tv) (not (dk-contains? f sv)))))))
    (define (t-cases! s-nonneg?)
      (use-cases ct
        (lambda ()                                           ; t >= 0
          (dk-split-all!)
          (rbe-gform! sv) (rbe-gform! tv)
          (if s-nonneg?
              (begin
                (dk-have! (list '<= As At)
                  (lambda () (dk-ineq! (list '= (list 'abs sv) sv) (list '= (list 'abs tv) tv) (list '<= sv tv))))
                (fact 'rr-recip-antitone As At)
                (dk-ineq! (list '= gs (list '- 1 rAs)) (list '= gt (list '- 1 rAt)) (list '<= rAt rAs)))
              (dk-ineq! (list '= gs (list '- rAs 1)) (list '= gt (list '- 1 rAt))
                        (list '<= rAs 1) (list '<= rAt 1))))
        (lambda ()                                           ; t < 0
          (dk-split-all!)
          (if s-nonneg?
              (begin
                (dk-have! (list '<= 0 tv) (lambda () (dk-ineq! (list '<= 0 sv) (list '<= sv tv))))
                (dk-only! (list '<= 0 tv) (list 'NOT (list '<= 0 tv)))
                (prop))
              (begin
                (rbe-gform! sv) (rbe-gform! tv)
                (dk-have! (list '<= At As)
                  (lambda () (dk-ineq! (list '= (list 'abs sv) (list '- sv)) (list '= (list 'abs tv) (list '- tv))
                                       (list '<= sv tv))))
                (fact 'rr-recip-antitone At As)
                (dk-ineq! (list '= gs (list '- rAs 1)) (list '= gt (list '- rAt 1)) (list '<= rAs rAt)))))))
    (use-cases cs
      (lambda () (dk-split-all!) (t-cases! #t))
      (lambda () (dk-split-all!) (t-cases! #f)))))
(qed 'ooint-rr-iso-g-mono)

;;; rewrite every `/' in the goal by binary-divide-def (one mac pass rewrites the outermost
;;; occurrences only, so a nested quotient needs a second pass)
(define (rbe-undiv!)
  (let loop ((n 0))
    (if (and (dk-contains? (dk-goal) '/) (< n 6))
        (begin (mac 'binary-divide-def) (loop (+ n 1))))))

;;; ---------------------------------------------------------------------------
;;; THE NOTES' STATEMENTS.  (- 1) is the notes' -1.

;;; land (IN (/ num den) RR) on a lane; den must be typed and nonzero in context
(define (rbe-div-typed! num den)
  (dk-have! (list 'IN (list '/ num den) 'RR)
    (lambda () (rbe-undiv!) (rbe-rr! (list '* num (list 'recip den))) (ass))))

;;; x in OOINT(-1, 1) in context: land x in RR, -1 < x, x < 1, |x| < 1.
(define (rbe-ooint! x)
  (let ((h (list 'IN x '(OOINT (- 1) 1))))
    (dk-project! (list 'IN x 'RR) 'ooint-membership h)
    (dk-project! (list '< '(- 1) x) 'ooint-membership h)
    (dk-project! (list '< x 1) 'ooint-membership h)
    (fact 'rr-one-in)
    (fact 'rr-abs-lt-of-parts x 1)))

;;; on the focus goal (IN (* s (recip (+ 1 (abs s)))) (OOINT (- 1) 1)), s in RR
(define (rbe-g-in-ooint! s)
  (let ((q (list '* s (list 'recip (list '+ 1 (list 'abs s))))))
    (rbe-gden-setup! s)
    (rbe-rr! q)
    (fact 'ooint-rr-iso-g-small s)
    (fact 'rr-one-in)
    (dk-split! (dk-fact! 'rr-abs-lt-parts q 1))
    (mac 'ooint-membership)
    (for-each (lambda (leaf) (dk-focus! leaf) (ass))
              (let loop ((todo (list (proof-state-focus *ps*))) (acc '()))
                (if (null? todo) (reverse acc)
                    (begin (dk-focus! (car todo))
                           (if (eq? (car (dk-goal)) 'AND)
                               (loop (append (dk-opened (lambda () (di))) (cdr todo)) acc)
                               (loop (cdr todo) (cons (car todo) acc)))))))))

(sp (make-wff
  '(FORALL x (IMPLIES (IN x (OOINT (- 1) 1)) (FORALL y (IMPLIES (IN y (OOINT (- 1) 1))
     (IMPLIES (< x y) (< (/ x (- 1 (abs x))) (/ y (- 1 (abs y)))))))))))
(dk-peel!)
(let* ((ins (filter (lambda (f) (and (eq? (car f) 'IN) (equal? (caddr f) '(OOINT (- 1) 1)))) (dk-asms)))
       (lt  (rbe-find 'x<y (lambda (f) (and (eq? (car f) '<) (symbol? (cadr f)) (symbol? (caddr f))))))
       (x (cadr lt)) (y (caddr lt)))
  (rbe-ooint! x) (rbe-ooint! y)
  (rbe-undiv!)
  (let* ((p  (cadr (dk-goal))) (q (caddr (dk-goal)))
         (gp (list '* p (list 'recip (list '+ 1 (list 'abs p)))))
         (gq (list '* q (list 'recip (list '+ 1 (list 'abs q))))))
    (fact 'ooint-rr-iso-f-real x) (fact 'ooint-rr-iso-f-real y)
    (fact 'ooint-rr-iso-f-inv x) (fact 'ooint-rr-iso-f-inv y)
    (rbe-gden-setup! p) (rbe-gden-setup! q)
    (rbe-rr! gp) (rbe-rr! gq)
    (fact 'rr-lt-trichotomy p q)
    (use-cases (list (list '< p q) (list '= p q) (list '< q p))
      (lambda () (ass))
      (lambda ()
        (dk-rewrite-h! (list '= gp x) p q)
        (dk-ineq! (list '= gq x) (list '= gq y) (list '< x y)))
      (lambda ()
        (fact 'rr-lt-implies-le q p)
        (fact 'ooint-rr-iso-g-mono q p)
