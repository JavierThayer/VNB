      (dk-rewrite-h! `(IN w2 ,bzt-M) bzt-M (bzt-P 'w))
      (dk-cite! 'nv-principal-norm-le 'K 'A 'w 'w2)
      (dk-cite! 'nv-domain-sub 'K 'A 'w)
      (dk-cite! 'nv-domain-sub 'K 'A 'w2)
      (bzt-typek! 'w) (bzt-typek! 'w2)
      (dk-have-and! `(IN ,(bzt-n 'w2) RR) `(IN ,(bzt-n 'w) RR))
      (dk-chain-ass! (dk-cite! 'rr-leq-antisymmetric (bzt-n 'w2) (bzt-n 'w)))
      (let* ((ex (dk-chain-ass! (dk-cite! 'nv-compact-units-transitive 'K 'A 'w 'w2)))
             (u (dk-skolem! ex)))
        (dk-split-all! (list (dk-cite! 'ccr-remark-4-4-unit 'K 'A 'w u)))
        (subst `(= w2 ,(bzt-mul u 'w)))
        (dk-ass!)))))
(bzt-show-open)
(qed 'ccr-remark-4-5)

;;; -----------------------------------------------------------------------
;;; 2. The collapse of Definition 4.20 (CCR-1109-C-REPORT F1): Z_F(K) = pi_M^{-1}(F) contains M(K) as soon as
;;; F contains the zero class (every subfield does), and every element of K is a quotient of two elements of
;;; M(K) (nv-fractions-of-maximal), so the field of fractions B_F(K) of Z_F(K) is K itself, for every F.

(define bzt-view '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define (bzt-view!)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
  (dk-cite! 'commutative-ring-is-ring bzt-view)
  (for-each (lambda (r) (dk-cite! r 'K))
            '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
              normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one)))
(define (bzt-in-view! x)
  (if (not (dk-asm? `(IN ,x (CARR ,bzt-view))))
      (dk-have! `(IN ,x (CARR ,bzt-view)) (lambda () (subst `(= (CARR ,bzt-view) (CARR K))) (dk-ass!)))))
(define (bzt-crs! vs)
  (bzt-view!)
  (for-each bzt-in-view! vs)
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,bzt-view))))) '(ADD MUL NEG))
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,bzt-view))))) '(ZERO ONE))
  (crs))
(define (bzt-ring-eq! eq vs) (dk-have! eq (lambda () (bzt-crs! vs))) eq)

;; the field of fractions of a subset grows with the subset
(sp (make-wff '(FORALL K (FORALL A (FORALL B (IMPLIES (SUBSET A B) (IMPLIES (IS-FRACTIONS-OF K A) (IS-FRACTIONS-OF K B))))))))
(dk-peel!)
(let ((fa (dk-iff-fwd! (dk-cite! 'is-fractions-of 'K 'A))))
  (mac 'is-fractions-of)
  (let* ((x (cadr (car (dk-landed (lambda () (dk-peel!))))))
         (hx (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f 'A))) "the fractions hypothesis"))
         (ex (dk-chain-ass! (dk-apply! hx x)))
         (u (dk-skolem! ex))
         (ex2 (dk-pick (dk-head? 'FORSOME) "the second existential"))
         (v (dk-skolem! ex2)))
    (dk-cite! 'subset-mem-fwd 'A 'B u)
    (dk-cite! 'subset-mem-fwd 'A 'B v)
    (witness! u (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!)) (witness! v (lambda () (dk-conj-close! dk-ass!))))))))))
(qed 'is-fractions-of-mono)

(define bzt-Z '(NV-INTEGERS K))
(define bzt-MZ '(NV-MAXIMAL K (NV-INTEGERS K)))
(define bzt-res '(NV-RESIDUE K (NV-INTEGERS K)))
(define bzt-st '(RINGOID-SETOID (NV-RES-RINGOID K (NV-INTEGERS K))))

(sp (make-wff '(FORALL K (FORALL A (== (NV-RESIDUE K A) (RINGOID-QUOTIENT-RING (NV-RES-RINGOID K A)))))))
(dk-peel!) (mac 'NV-RESIDUE) (qrfl)
(qed 'nv-residue-unfold)

;; the zero class of the residue field is the class of 0
(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K)
   (== (ZERO ,bzt-res) (CLASS ,bzt-st (ZERO K)))))))
(dk-peel!)
(dk-cite! 'nv-integers-domain 'K)
(dk-cite! 'rs-zero 'K bzt-Z)
(dk-cite! 'rs-is-ringoid 'K bzt-Z)          ; the guard of rq-zero (D8, 2026-11-15)
