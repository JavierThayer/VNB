(mac 'rq-zero)
(subst `(== (ZERO (NV-RES-RINGOID K ,bzt-Z)) (ZERO K)))
(qrfl)
(qed 'nv-residue-zero-class)

;; M(K) lies in Z_F(K) when F contains the zero class
(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL F (IMPLIES (IN (ZERO ,bzt-res) F)
   (SUBSET ,bzt-MZ (NV-ZF K F))))))))
(dk-peel!)
(dk-cite! 'nv-field-normed 'K)
(dk-cite! 'nv-integers-domain 'K)
(dk-cite! 'nv-residue-zero-class 'K)
(dk-rewrite-h! `(IN (ZERO ,bzt-res) F) `(ZERO ,bzt-res) `(CLASS ,bzt-st (ZERO K)))
(let ((z (subset-by-element!)))
  (dk-cite! 'nv-maximal-sub 'K bzt-Z z)
  (dk-cite! 'nv-domain-zero 'K bzt-Z)
  (dk-cite! 'nv-domain-sub 'K bzt-Z z)
  (dk-cite! 'nf-zero-in-carr 'K)
  (bzt-ring-eq! `(= ,(bzt-sub z '(ZERO K)) ,z) (list z))
  (dk-have! `(IN ,(bzt-sub z '(ZERO K)) ,bzt-MZ) (lambda () (subst `(= ,(bzt-sub z '(ZERO K)) ,z)) (dk-ass!)))
  (dk-iff-bwd! (dk-cite! 'rs-class-eq-iff 'K bzt-Z z '(ZERO K)))
  (mac 'NV-ZF)
  (in-sep! (lambda () (dk-ass!))
           (lambda () (subst `(= (CLASS ,bzt-st ,z) (CLASS ,bzt-st (ZERO K)))) (dk-ass!))))
(qed 'nv-maximal-in-zf)

;; THE COLLAPSE: for every F containing the zero class (in particular every subfield F of the residue field),
;; K is the field of fractions of Z_F(K), i.e. B_F(K) = K.
(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL w (IMPLIES (IN w (CARR K)) (IMPLIES (NOT (= w (ZERO K)))
   (IMPLIES (< ((FNRM K) w) 1) (FORALL F (IMPLIES (IN (ZERO ,bzt-res) F) (IS-FRACTIONS-OF K (NV-ZF K F))))))))))))
(dk-peel!)
(dk-cite! 'nv-fractions-of-maximal 'K 'w)
(dk-cite! 'nv-maximal-in-zf 'K 'F)
(dk-chain-ass! (dk-cite! 'is-fractions-of-mono 'K bzt-MZ '(NV-ZF K F)))
(dk-ass!)
(qed 'ccr-4-20-collapse)

;;; -----------------------------------------------------------------------
;;; 3. Closure in a normed field, by approximation.

(define bzt-ms '(NF-METRIC-SPACE K))
(define (bzt-cl s) `(CLOSURE (NF-METRIC-SPACE K) ,s))
(define (bzt-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))
(define (bzt-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))
;; X in SET, SET subset CARR K in context: land X in CARR K
(define (bzt-in! x set)
  (if (not (dk-asm? `(IN ,x (CARR K)))) (dk-cite! 'subset-mem-fwd set '(CARR K) x)))
(define (bzt-sub-typ! x y)
  (dk-cite! 'nf-neg-in-carr 'K y)
  (dk-cite! 'nf-add-in-carr 'K x (bzt-neg y))
  (bzt-typek! (bzt-sub x y)))
(define (bzt-pts! x)
  (if (not (dk-asm? `(IN ,x (PTS ,bzt-ms))))
      (dk-have! `(IN ,x (PTS ,bzt-ms)) (lambda () (subst `(== (PTS ,bzt-ms) (CARR K))) (dk-ass!)))))
(define (bzt-nfh) '((IS-NORMED-FIELD K)))

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL A (SUBSET ,(bzt-cl 'A) (CARR K)))))))
(dk-peel!)
(dk-cite! 'nf-metric-space-is-metric-space 'K)
(dk-cite! 'nf-metric-carrier 'K)
(dk-cite! 'closure-in-carrier bzt-ms 'A)
(subst `(== (CARR K) (PTS ,bzt-ms)))
(dk-ass!)
(qed 'nf-closure-in-carr)

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL A (IMPLIES (SUBSET A (CARR K))
   (FORALL x (IMPLIES (IN x ,(bzt-cl 'A)) (FORALL eps (IMPLIES (POS-RR eps)
     (FORSOME pa (AND (IN pa A) (< ,(bzt-n (bzt-sub 'x 'pa)) eps)))))))))))))
(dk-peel!)
(dk-cite! 'nf-metric-space-is-metric-space 'K)
(dk-cite! 'nf-closure-in-carr 'K 'A)
(bzt-in! 'x (bzt-cl 'A))
(let* ((ex (dk-chain-ass! (dk-cite! 'fom-closure-near bzt-ms 'A 'x 'eps)))
       (pa (dk-skolem! ex)))
  (bzt-in! pa 'A)
  (let ((de (dk-cite! 'nf-metric-distance 'K 'x pa)))
    (witness! pa (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst `(= ,(caddr de) ,(cadr de))) (dk-ass!)))))))))
(qed 'nf-closure-near)

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL A (IMPLIES (SUBSET A (CARR K))
   (FORALL x (IMPLIES (IN x (CARR K))
     (IMPLIES (FORALL eps (IMPLIES (POS-RR eps) (FORSOME pa (AND (IN pa A) (< ,(bzt-n (bzt-sub 'x 'pa)) eps)))))
       (IN x ,(bzt-cl 'A)))))))))))
(dk-peel!)
(dk-cite! 'nf-metric-space-is-metric-space 'K)
(dk-cite! 'nf-metric-carrier 'K)
(bzt-pts! 'x)
(let ((hyp (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (dk-contains? f 'POS-RR))) "the approximation hypothesis")))
  (dk-have! `(FORALL u (IMPLIES (AND (IS-OPEN ,bzt-ms u) (IN x u)) (FORSOME y (AND (IN y u) (IN y A)))))
    (lambda ()
      (dk-peel!)
      (dk-split-all!)
      (let* ((u (caddr (cadr (caddr (dk-goal)))))
             (op (bzt-iff-fwd! 'is-open bzt-ms u))
             (all (caddr (caddr op)))
             (r (dk-skolem! (dk-apply! all 'x)))
             (pa (dk-skolem! (dk-apply! hyp r))))
        (dk-cite! 'rr-pos-rr-in-rr r)
        (bzt-in! pa 'A)
        (bzt-pts! pa)
        (bzt-sub-typ! 'x pa)
        (let* ((de (dk-cite! 'nf-metric-distance 'K 'x pa))
               (d (cadr de)) (nv (caddr de)))
          (dk-have! `(<= ,d ,nv) (lambda () (subst de) (dk-ineq!)))
          (dk-have-and! `(IN ,pa (PTS ,bzt-ms)) `(IN ,nv RR) `(IN ,r RR) `(<= ,d ,nv) `(< ,nv ,r))
          (dk-cite! 'ball-mem-from-le bzt-ms 'x pa nv r)
          (dk-cite! 'subset-mem-fwd `(BALL ,bzt-ms x ,r) u pa)
          (witness! pa (lambda () (dk-conj-close! dk-ass!)))))))
  (bzt-iff-bwd! 'closure-membership bzt-ms 'A 'x)
  (dk-ass!))
(qed 'nf-closure-approx)

;; approximation with a scaled error: for c in K, the approximant pa can be taken with |x - pa| < eta and
;; |c| |x - pa| < eps
(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL A (IMPLIES (SUBSET A (CARR K))
   (FORALL x (IMPLIES (IN x ,(bzt-cl 'A)) (FORALL c (IMPLIES (IN c (CARR K))
     (FORALL eta (IMPLIES (POS-RR eta) (FORALL eps (IMPLIES (POS-RR eps)
       (FORSOME pa (AND (IN pa A) (AND (< ,(bzt-n (bzt-sub 'x 'pa)) eta)
                                       (< (* ,(bzt-n 'c) ,(bzt-n (bzt-sub 'x 'pa))) eps))))))))))))))))))
(dk-peel!)
(dk-cite! 'nf-closure-in-carr 'K 'A)
(bzt-in! 'x (bzt-cl 'A))
(dk-cite! 'rr-pos-rr-in-rr 'eta) (dk-cite! 'rr-lt-of-pos-rr 'eta)
(dk-cite! 'rr-pos-rr-in-rr 'eps) (dk-cite! 'rr-lt-of-pos-rr 'eps)
(bzt-typek! 'c)
(use-em '(= c (ZERO K))
  (lambda ()
    (let ((pa (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-closure-near 'K 'A 'x 'eta)))))
      (bzt-in! pa 'A)
      (bzt-sub-typ! 'x pa)
      (dk-cite! 'nf-norm-of-zero 'K)
      (dk-have! `(= ,(bzt-n 'c) 0) (lambda () (subst '(= c (ZERO K))) (dk-ass!)))
      (witness! pa (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst `(= ,(bzt-n 'c) 0)) (dk-ineq! '(< 0 eps))))))))))
  (lambda ()
    (let* ((d (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-inverse 'K 'c))))
           (nd (bzt-n d)) (nc (bzt-n 'c)))
      (bzt-typek! d)
      (dk-cite! 'nf-norm-mult 'K 'c d)
      (dk-cite! 'nf-norm-one 'K)
      (dk-have! `(= (* ,nc ,nd) 1) (lambda () (subst `(= (* ,nc ,nd) ,(bzt-n (bzt-mul 'c d)))) (subst `(= ,(bzt-mul 'c d) (ONE K))) (dk-ass!)))
      (bzt-norm-pos! d)
      (bzt-norm-pos! 'c)
      (let ((e2 `(* eps ,nd)))
        (dk-have! `(IN ,e2 RR) (lambda () (type-term)))
        (dk-cite! 'rr-mul-pos 'eps nd)
        (let* ((m (dk-skolem! (dk-chain-ass! (dk-cite! 'rr-min-pos 'eta e2))))
               (_ (dk-cite! 'rr-pos-rr-of-lt m))
               (pa (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-closure-near 'K 'A 'x m))))
               (q (bzt-n (bzt-sub 'x pa))))
          (bzt-in! pa 'A)
          (bzt-sub-typ! 'x pa)
          (dk-have! `(< ,q ,e2) (lambda () (dk-ineq! `(< ,q ,m) `(<= ,m ,e2))))
          (dk-have! `(<= ,nc ,nc) (lambda () (dk-ineq!)))
          (dk-chain-ass! (dk-cite! 'rr-prod-lt-gen-right nc q nc e2))
          (dk-have! `(= (* ,nc ,e2) eps)
            (lambda ()
              (dk-have! `(= (* ,nc ,e2) (* eps (* ,nc ,nd))) (lambda () (crs)))
              (subst `(= (* ,nc ,e2) (* eps (* ,nc ,nd))))
              (subst `(= (* ,nc ,nd) 1))
              (crs)))
          (witness! pa
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (cond ((dk-ass!) #t)
                        ((dk-contains? (dk-goal) 'eta) (dk-ineq! `(< ,q ,m) `(<= ,m eta)))
                        (#t (subst `(= eps (* ,nc ,e2))) (dk-ass!))))))))))))
(qed 'nf-closure-near-scaled)

;;; -----------------------------------------------------------------------
;;; 4. Subfields: the closure of a subfield of an NV field is a subfield; the subfield generated by a set.

(define (bzt-and-list f) (if (and (pair? f) (eq? (car f) 'AND)) (cons (cadr f) (bzt-and-list (caddr f))) (list f)))
;; prove IS-NF-SUBFIELD(K, T) from seven provers, one per conjunct (each runs with that conjunct as the goal)
(define (bzt-prove-subfield! t provers)
  (let* ((iff (dk-cite! 'is-nf-subfield 'K t))
         (cs (bzt-and-list (caddr iff))))
    (for-each (lambda (c p) (if (not (dk-asm? c)) (dk-have! c p))) cs provers)
    (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!)))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (dk-ass!)))
;; open IS-NF-SUBFIELD(K, S) in context; land SUBSET S (CARR K) too; return the conjunct list
(define (bzt-sf-open! s)
  (let* ((rhs (bzt-iff-fwd! 'is-nf-subfield 'K s))
         (cs (bzt-and-list rhs)))
    (if (not (dk-asm? `(SUBSET ,s (CARR K))))
        (dk-have! `(SUBSET ,s (CARR K))
          (lambda () (let ((z (subset-by-element!))) (dk-chain-ass! (dk-apply! (car cs) z)) (dk-ass!)))))
    cs))
;; the goal's peeled eigenvariables, read off the IN-guards that landed
(define (bzt-peel-vars!)
  (map cadr (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN))) (dk-landed (lambda () (dk-peel!))))))

(sp (make-wff '(FORALL p (IMPLIES (IN p RR) (FORALL u (IMPLIES (IN u RR) (FORALL v (IMPLIES (IN v RR)
   (IMPLIES (= (* p u) 1) (IMPLIES (= (* p v) 1) (= u v)))))))))))
(dk-peel!)
(dk-have! '(= u (* u (* p v))) (lambda () (subst '(= (* p v) 1)) (crs)))
(dk-have! '(= (* u (* p v)) (* (* p u) v)) (lambda () (crs)))
(subst '(= u (* u (* p v))))
(subst '(= (* u (* p v)) (* (* p u) v)))
(subst '(= (* p u) 1))
(crs)
(qed 'rr-recip-unique)

(define (bzt-cl-hyps) '((IS-NORMED-FIELD K) (IS-NF-SUBFIELD K S)))
(define (bzt-sfthm body) `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL S (IMPLIES (IS-NF-SUBFIELD K S) ,body)))))
(define (bzt-sfthm-nv body) `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL S (IMPLIES (IS-NF-SUBFIELD K S) ,body)))))
(define (bzt-approx-goal t)
  `(FORALL eps (IMPLIES (POS-RR eps) (FORSOME pa (AND (IN pa S) (< ,(bzt-n (bzt-sub t 'pa)) eps))))))
;; finish "T in closure(S)" from the approximation property proved by BODY (run with eps peeled)
(define (bzt-approx! t body)
  (dk-have! (bzt-approx-goal t) (lambda () (dk-peel!) (body)))
  (dk-chain-ass! (dk-cite! 'nf-closure-approx 'K 'S t))
  (dk-ass!))

;; - x
(sp (make-wff (bzt-sfthm `(FORALL x (IMPLIES (IN x ,(bzt-cl 'S)) (IN ,(bzt-neg 'x) ,(bzt-cl 'S)))))))
(dk-peel!)
(let ((cs (bzt-sf-open! 'S)))
  (dk-cite! 'nf-closure-in-carr 'K 'S)
  (bzt-in! 'x (bzt-cl 'S))
  (dk-cite! 'nf-neg-in-carr 'K 'x)
  (bzt-approx! (bzt-neg 'x)
    (lambda ()
      (let ((pb (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-closure-near 'K 'S 'x 'eps)))))
        (bzt-in! pb 'S)
        (dk-chain-ass! (dk-apply! (list-ref cs 5) pb))
        (dk-cite! 'nf-norm-neg-diff 'K 'x pb)
        (witness! (bzt-neg pb)
          (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst (dk-pick (lambda (f) (and (pair? f) (eq? (car f) '=) (dk-contains? f '(FNRM K)))) "the norm identity")) (dk-ass!)))))))))))
(qed 'nf-closure-neg)

;; x + y
(sp (make-wff (bzt-sfthm `(FORALL x (IMPLIES (IN x ,(bzt-cl 'S)) (FORALL y (IMPLIES (IN y ,(bzt-cl 'S)) (IN ,(bzt-add 'x 'y) ,(bzt-cl 'S)))))))))
(dk-peel!)
(let ((cs (bzt-sf-open! 'S)))
  (dk-cite! 'nf-closure-in-carr 'K 'S)
  (bzt-in! 'x (bzt-cl 'S)) (bzt-in! 'y (bzt-cl 'S))
  (dk-cite! 'nf-add-in-carr 'K 'x 'y)
  (bzt-approx! (bzt-add 'x 'y)
    (lambda ()
      (dk-cite! 'rr-pos-rr-in-rr 'eps) (dk-cite! 'rr-lt-of-pos-rr 'eps)
      (let ((h '(* 1/2 eps)))
        (dk-have! `(IN ,h RR) (lambda () (type-term)))
        (dk-have! `(< 0 ,h) (lambda () (dk-ineq! '(< 0 eps))))
        (dk-cite! 'rr-pos-rr-of-lt h)
        (let* ((pa (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-closure-near 'K 'S 'x h))))
               (pb (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-closure-near 'K 'S 'y h)))))
          (bzt-in! pa 'S) (bzt-in! pb 'S)
          (dk-chain-ass! (dk-apply! (list-ref cs 3) pa pb))
          (bzt-sub-typ! 'x pa) (bzt-sub-typ! 'y pb)
          (dk-cite! 'nf-add-in-carr 'K pa pb)
          (bzt-sub-typ! (bzt-add 'x 'y) (bzt-add pa pb))
          (let ((sd (dk-cite! 'nf-norm-sum-diff 'K 'x 'y pa pb)))
            (witness! (bzt-add pa pb)
              (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!))
                (dk-ineq! sd `(< ,(bzt-n (bzt-sub 'x pa)) ,h) `(< ,(bzt-n (bzt-sub 'y pb)) ,h)))))))))))))
(qed 'nf-closure-add)

;; c x for c in S
(sp (make-wff (bzt-sfthm `(FORALL c (IMPLIES (IN c S) (FORALL y (IMPLIES (IN y ,(bzt-cl 'S)) (IN ,(bzt-mul 'c 'y) ,(bzt-cl 'S)))))))))
(dk-peel!)
(let ((cs (bzt-sf-open! 'S)))
  (dk-cite! 'nf-closure-in-carr 'K 'S)
  (bzt-in! 'c 'S) (bzt-in! 'y (bzt-cl 'S))
  (dk-cite! 'nf-mul-in-carr 'K 'c 'y)
  (fact 'rr-one-in) (fact 'rr-zero-in)
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (dk-cite! 'rr-pos-rr-of-lt 1)
  (bzt-approx! (bzt-mul 'c 'y)
    (lambda ()
      (let* ((ex (dk-chain-ass! (dk-cite! 'nf-closure-near-scaled 'K 'S 'y 'c 1 'eps)))
             (pb (dk-skolem! ex))
             (d (bzt-sub 'y pb)))
        (bzt-in! pb 'S)
        (dk-chain-ass! (dk-apply! (list-ref cs 4) 'c pb))
        (bzt-sub-typ! 'y pb)
        (dk-cite! 'nf-mul-in-carr 'K 'c pb)
        (bzt-ring-eq! `(= ,(bzt-sub (bzt-mul 'c 'y) (bzt-mul 'c pb)) ,(bzt-mul 'c d)) (list 'c 'y pb))
        (dk-cite! 'nf-norm-mult 'K 'c d)
        (witness! (bzt-mul 'c pb)
          (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!))
            (begin (subst `(= ,(bzt-sub (bzt-mul 'c 'y) (bzt-mul 'c pb)) ,(bzt-mul 'c d)))
                   (subst `(= ,(bzt-n (bzt-mul 'c d)) (* ,(bzt-n 'c) ,(bzt-n d))))
                   (dk-ass!)))))))))))
(qed 'nf-closure-smul)

;; x y
(sp (make-wff (bzt-sfthm `(FORALL x (IMPLIES (IN x ,(bzt-cl 'S)) (FORALL y (IMPLIES (IN y ,(bzt-cl 'S)) (IN ,(bzt-mul 'x 'y) ,(bzt-cl 'S)))))))))
(dk-peel!)
(let ((cs (bzt-sf-open! 'S))
      (cl (bzt-cl 'S)))
  (dk-cite! 'nf-metric-space-is-metric-space 'K)
  (dk-cite! 'nf-closure-in-carr 'K 'S)
  (bzt-in! 'x cl) (bzt-in! 'y cl)
  (dk-cite! 'nf-mul-in-carr 'K 'x 'y)
  (fact 'rr-one-in) (fact 'rr-zero-in)
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (dk-cite! 'rr-pos-rr-of-lt 1)
  (dk-have! `(FORALL eps (IMPLIES (POS-RR eps) (FORSOME pa (AND (IN pa ,cl) (< ,(bzt-n (bzt-sub (bzt-mul 'x 'y) 'pa)) eps)))))
    (lambda ()
      (dk-peel!)
      (let* ((ex (dk-chain-ass! (dk-cite! 'nf-closure-near-scaled 'K 'S 'x 'y 1 'eps)))
             (pa (dk-skolem! ex))
             (d (bzt-sub 'x pa))
             (t (bzt-mul pa 'y)))
        (bzt-in! pa 'S)
        (dk-chain-ass! (dk-cite! 'nf-closure-smul 'K 'S pa 'y))
        (bzt-sub-typ! 'x pa)
        (dk-cite! 'nf-mul-in-carr 'K pa 'y)
        (bzt-ring-eq! `(= ,(bzt-sub (bzt-mul 'x 'y) t) ,(bzt-mul 'y d)) (list 'x 'y pa))
        (dk-cite! 'nf-norm-mult 'K 'y d)
        (witness! t
          (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!))
            (begin (subst `(= ,(bzt-sub (bzt-mul 'x 'y) t) ,(bzt-mul 'y d)))
                   (subst `(= ,(bzt-n (bzt-mul 'y d)) (* ,(bzt-n 'y) ,(bzt-n d))))
                   (dk-ass!))))))))))
  (dk-cite! 'subset-refl cl)
  (dk-cite! 'closure-is-closed bzt-ms 'S)
  (dk-cite! 'closure-in-closed bzt-ms cl cl)
  (dk-chain-ass! (dk-cite! 'nf-closure-approx 'K cl (bzt-mul 'x 'y)))
  (dk-cite! 'subset-mem-fwd (bzt-cl cl) cl (bzt-mul 'x 'y))
  (dk-ass!))
(qed 'nf-closure-mul)

;; x^{-1}, in an NV field
(sp (make-wff (bzt-sfthm-nv `(FORALL x (IMPLIES (IN x ,(bzt-cl 'S)) (IMPLIES (NOT (= x (ZERO K)))
   (FORSOME y (AND (IN y ,(bzt-cl 'S)) (= ,(bzt-mul 'x 'y) (ONE K))))))))))
(dk-peel!)
(dk-cite! 'nv-field-normed 'K)
(let ((cs (bzt-sf-open! 'S))
      (cl (bzt-cl 'S)))
  (dk-cite! 'nf-closure-in-carr 'K 'S)
  (bzt-in! 'x cl)
  (dk-cite! 'nf-one-in-carr 'K)
  (dk-cite! 'nf-norm-one 'K)
  (bzt-norm-pos! 'x)
  (dk-cite! 'rr-pos-rr-of-lt (bzt-n 'x))
  (let* ((d (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-inverse 'K 'x))))
         (dd (bzt-mul d d)) (nd (bzt-n d)) (nx (bzt-n 'x)))
    (bzt-typek! d)
    (dk-cite! 'nf-mul-in-carr 'K d d)
    (dk-cite! 'nf-norm-mult 'K 'x d)
    (dk-cite! 'nf-norm-mult 'K d d)
    (dk-have! `(= (* ,nx ,nd) 1)
      (lambda () (subst `(= (* ,nx ,nd) ,(bzt-n (bzt-mul 'x d)))) (subst `(= ,(bzt-mul 'x d) (ONE K))) (dk-ass!)))
    (bzt-approx! d
      (lambda ()
        (let* ((ex (dk-chain-ass! (dk-cite! 'nf-closure-near-scaled 'K 'S 'x dd nx 'eps)))
               (pa (dk-skolem! ex))
               (q (bzt-n (bzt-sub 'x pa))))
          (bzt-in! pa 'S)
          (bzt-sub-typ! 'x pa)
          (bzt-sub-typ! pa 'x)
          (bzt-typek! pa)
          (dk-cite! 'nf-norm-sub-sym 'K pa 'x)
          ;; |pa| = |x|
          (dk-have! `(< ,(bzt-n (bzt-sub pa 'x)) ,nx) (lambda () (subst `(= ,(bzt-n (bzt-sub pa 'x)) ,q)) (dk-ass!)))
          (dk-cite! 'nv-strict-dominance 'K (bzt-sub pa 'x) 'x)
          (dk-cite! 'nf-sub-add-back 'K pa 'x)
          (dk-have! `(= ,(bzt-n pa) ,nx)
            (lambda () (subst `(= ,pa ,(bzt-add (bzt-sub pa 'x) 'x))) (dk-ass!)))
          (dk-have! `(NOT (= ,pa (ZERO K)))
            (lambda ()
              (di)
              (dk-cite! 'nf-norm-of-zero 'K)
              (dk-have! `(= ,nx 0) (lambda () (subst `(= ,nx ,(bzt-n pa))) (subst `(= ,pa (ZERO K))) (dk-ass!)))
              (dk-absurd! `(= ,nx 0) `(< 0 ,nx))))
          (let* ((e (dk-skolem! (dk-chain-ass! (dk-apply! (list-ref cs 6) pa))))
                 (ne (bzt-n e)))
            (bzt-in! e 'S)
            (bzt-typek! e)
            (dk-cite! 'nf-norm-mult 'K pa e)
            (dk-have! `(= (* ,nx ,ne) 1)
              (lambda () (subst `(= ,nx ,(bzt-n pa))) (subst `(= (* ,(bzt-n pa) ,ne) ,(bzt-n (bzt-mul pa e)))) (subst `(= ,(bzt-mul pa e) (ONE K))) (dk-ass!)))
            (dk-chain-ass! (dk-cite! 'rr-recip-unique nx ne nd))
            (dk-cite! 'nf-mul-in-carr 'K d e)
            (let* ((de (bzt-mul d e))
                   (rhs (bzt-mul de (bzt-sub pa 'x)))
                   (e1 (bzt-ring-eq! `(= ,rhs ,(bzt-sub (bzt-mul d (bzt-mul pa e)) (bzt-mul e (bzt-mul 'x d)))) (list d e pa 'x))))
              (dk-have! `(= ,rhs ,(bzt-sub d e))
                (lambda ()
                  (subst e1)
                  (subst `(= ,(bzt-mul pa e) (ONE K)))
                  (subst `(= ,(bzt-mul 'x d) (ONE K)))
                  (bzt-crs! (list d e))))
              (dk-cite! 'nf-norm-mult 'K de (bzt-sub pa 'x))
              (dk-cite! 'nf-norm-mult 'K d e)
              (witness! e
                (lambda ()
                  (dk-conj-close!
                    (lambda ()
                      (if (not (dk-ass!))
                          (begin
                            (subst `(= ,(bzt-sub d e) ,rhs))
                            (subst `(= ,(bzt-n rhs) (* ,(bzt-n de) ,(bzt-n (bzt-sub pa 'x)))))
                            (subst `(= ,(bzt-n de) (* ,nd ,ne)))
                            (subst `(= ,ne ,nd))
                            (subst `(= ,(bzt-n (bzt-sub pa 'x)) ,q))
                            (subst `(= (* ,nd ,nd) ,(bzt-n dd)))
                            (dk-ass!))))))))))))
    (witness! d (lambda () (dk-conj-close! dk-ass!)))))
(qed 'nf-closure-inv)

;; THE CLOSURE OF A SUBFIELD OF AN NV FIELD IS A SUBFIELD
(sp (make-wff (bzt-sfthm-nv `(IS-NF-SUBFIELD K ,(bzt-cl 'S)))))
(dk-peel!)
(dk-cite! 'nv-field-normed 'K)
(let ((cs (bzt-sf-open! 'S))
      (cl (bzt-cl 'S)))
  (dk-cite! 'nf-metric-space-is-metric-space 'K)
  (dk-cite! 'nf-metric-carrier 'K)
  (dk-cite! 'nf-closure-in-carr 'K 'S)
  (dk-have! `(SUBSET S (PTS ,bzt-ms)) (lambda () (subst `(== (PTS ,bzt-ms) (CARR K))) (dk-ass!)))
  (dk-cite! 'closure-contains bzt-ms 'S)
  (dk-cite! 'subset-mem-fwd 'S cl '(ZERO K))
  (dk-cite! 'subset-mem-fwd 'S cl '(ONE K))
  (bzt-prove-subfield! cl
    (list (lambda () (let ((z (car (bzt-peel-vars!)))) (bzt-in! z cl) (dk-ass!)))
          (lambda () (dk-ass!))
          (lambda () (dk-ass!))
          (lambda () (bzt-peel-vars!) (let ((t (cadr (dk-goal)))) (dk-chain-ass! (dk-cite! 'nf-closure-add 'K 'S (cadr t) (caddr t))) (dk-ass!)))
          (lambda () (bzt-peel-vars!) (let ((t (cadr (dk-goal)))) (dk-chain-ass! (dk-cite! 'nf-closure-mul 'K 'S (cadr t) (caddr t))) (dk-ass!)))
          (lambda () (bzt-peel-vars!) (let ((t (cadr (dk-goal)))) (dk-chain-ass! (dk-cite! 'nf-closure-neg 'K 'S (cadr t))) (dk-ass!)))
          (lambda () (let ((z (car (bzt-peel-vars!)))) (dk-chain-ass! (dk-cite! 'nf-closure-inv 'K 'S z)) (dk-ass!))))))
(qed 'nf-closure-subfield)

;;; The subfield generated by a set X: a subfield, containing X, inside every subfield containing X.
(define (bzt-gen x) `(NF-SUBFIELD-GEN K ,x))
(sp (make-wff '(FORALL K (FORALL X (== (NF-SUBFIELD-GEN K X)
  (SEP bzz_ (CARR K) (FORALL bzs_ (IMPLIES (IN bzs_ (POWER (CARR K)))
     (IMPLIES (IS-NF-SUBFIELD K bzs_) (IMPLIES (SUBSET X bzs_) (IN bzz_ bzs_)))))))))))
(dk-peel!) (mac 'NF-SUBFIELD-GEN) (qrfl)
(qed 'nf-subfield-gen-unfold)

;; Z in GEN(X) in context: land its separating property (a universal over subfields) and return it
(define (bzt-gen-prop! z x)
  (let* ((s (car (dk-landed (lambda () (mac-h 'nf-subfield-gen-unfold `(IN ,z ,(bzt-gen x)))))))
         (ls (dk-landed (lambda () (sep-me s)))))
    (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'FORALL) (member f ls))) "the generated-subfield property")))
;; Z in GEN(X), and S in POWER(CARR K), IS-NF-SUBFIELD(K, S), X subset S in context: land Z in S
(define (bzt-gen-at! z x s)
  (if (not (dk-asm? `(IN ,z ,s)))
      (dk-have! `(IN ,z ,s)
        (lambda () (let ((pr (bzt-gen-prop! z x))) (dk-chain-ass! (dk-apply! pr s)) (dk-ass!))))))
;; goal (IN T (GEN X)) with T in CARR K in context: BODY gets the arbitrary subfield S (its three guards landed)
(define (bzt-gen-in! body)
  (mac 'NF-SUBFIELD-GEN)
  (in-sep! (lambda () (dk-ass!))
    (lambda ()
      (let* ((ls (dk-landed (lambda () (dk-peel!))))
             (sf (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'IS-NF-SUBFIELD))) ls))))
        (body (caddr sf))))))

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL X (SUBSET ,(bzt-gen 'X) (CARR K)))))))
(dk-peel!)
(let ((z (subset-by-element!)))
  (let ((s (car (dk-landed (lambda () (mac-h 'nf-subfield-gen-unfold `(IN ,z ,(bzt-gen 'X))))))))
    (sep-me s) (dk-ass!)))
(qed 'nf-subfield-gen-sub)

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL X (IMPLIES (SUBSET X (CARR K)) (SUBSET X ,(bzt-gen 'X))))))))
(dk-peel!)
(let ((z (subset-by-element!)))
  (bzt-in! z 'X)
  (bzt-gen-in! (lambda (s) (dk-cite! 'subset-mem-fwd 'X s z) (dk-ass!))))
(qed 'nf-subfield-gen-contains)

(sp (make-wff `(FORALL K (FORALL X (FORALL S (IMPLIES (IN S (POWER (CARR K))) (IMPLIES (IS-NF-SUBFIELD K S)
   (IMPLIES (SUBSET X S) (SUBSET ,(bzt-gen 'X) S)))))))))
(dk-peel!)
(let ((z (subset-by-element!)))
  (bzt-gen-at! z 'X 'S)
  (dk-ass!))
(qed 'nf-subfield-gen-least)

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL X (IS-NF-SUBFIELD K ,(bzt-gen 'X)))))))
(dk-peel!)
(let ((g (bzt-gen 'X)))
  (dk-cite! 'nf-subfield-gen-sub 'K 'X)
  (dk-cite! 'nf-zero-in-carr 'K)
  (dk-cite! 'nf-one-in-carr 'K)
  (bzt-prove-subfield! g
    (list (lambda () (let ((z (car (bzt-peel-vars!)))) (bzt-in! z g) (dk-ass!)))
          (lambda () (bzt-gen-in! (lambda (s) (bzt-sf-open! s) (dk-ass!))))
          (lambda () (bzt-gen-in! (lambda (s) (bzt-sf-open! s) (dk-ass!))))
          (lambda ()
            (bzt-peel-vars!)
            (let* ((t (cadr (dk-goal))) (z1 (cadr t)) (z2 (caddr t)))
              (bzt-in! z1 g) (bzt-in! z2 g)
              (dk-cite! 'nf-add-in-carr 'K z1 z2)
              (bzt-gen-in! (lambda (s) (let ((cs (bzt-sf-open! s))) (bzt-gen-at! z1 'X s) (bzt-gen-at! z2 'X s)
                                         (dk-chain-ass! (dk-apply! (list-ref cs 3) z1 z2)) (dk-ass!))))))
          (lambda ()
            (bzt-peel-vars!)
            (let* ((t (cadr (dk-goal))) (z1 (cadr t)) (z2 (caddr t)))
              (bzt-in! z1 g) (bzt-in! z2 g)
              (dk-cite! 'nf-mul-in-carr 'K z1 z2)
              (bzt-gen-in! (lambda (s) (let ((cs (bzt-sf-open! s))) (bzt-gen-at! z1 'X s) (bzt-gen-at! z2 'X s)
                                         (dk-chain-ass! (dk-apply! (list-ref cs 4) z1 z2)) (dk-ass!))))))
          (lambda ()
            (bzt-peel-vars!)
            (let* ((t (cadr (dk-goal))) (z1 (cadr t)))
              (bzt-in! z1 g)
              (dk-cite! 'nf-neg-in-carr 'K z1)
              (bzt-gen-in! (lambda (s) (let ((cs (bzt-sf-open! s))) (bzt-gen-at! z1 'X s)
                                         (dk-chain-ass! (dk-apply! (list-ref cs 5) z1)) (dk-ass!))))))
          (lambda ()
            (let ((z (car (bzt-peel-vars!))))
              (bzt-in! z g)
              (let ((d (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-inverse 'K z)))))
                (witness! d
                  (lambda ()
                    (dk-conj-close!
                      (lambda ()
                        (if (not (dk-ass!))
                            (bzt-gen-in!
                              (lambda (s)
                                (let ((cs (bzt-sf-open! s)))
                                  (bzt-gen-at! z 'X s)
                                  (let ((y (dk-skolem! (dk-chain-ass! (dk-apply! (list-ref cs 6) z)))))
                                    (bzt-in! y s)
                                    (dk-have! `(= ,(bzt-mul y z) ,(bzt-mul d z))
                                      (lambda ()
                                        (subst (bzt-ring-eq! `(= ,(bzt-mul y z) ,(bzt-mul z y)) (list y z)))
                                        (subst (bzt-ring-eq! `(= ,(bzt-mul d z) ,(bzt-mul z d)) (list d z)))
                                        (subst `(= ,(bzt-mul z y) (ONE K)))
                                        (subst `(= ,(bzt-mul z d) (ONE K)))
                                        (rfl)))
                                    (dk-chain-ass! (dk-cite! 'nf-mul-cancel 'K y d z))
                                    (subst `(= ,d ,y))
                                    (dk-ass!))))))))))))))))
(qed 'nf-subfield-gen-is-subfield)

;;; -----------------------------------------------------------------------
;;; 5. B(K) (the user's definition): a closed subfield of K, containing w in prime characteristic, and generated
;;; by nothing in characteristic 0.

(define bzt-B '(NV-BASE K w))
(define bzt-bgen '(NV-BASE-GEN K w))
(sp (make-wff '(FORALL K (FORALL w (== (NV-BASE K w) (CLOSURE (NF-METRIC-SPACE K) (NF-SUBFIELD-GEN K (NV-BASE-GEN K w))))))))
(dk-peel!) (mac 'NV-BASE) (qrfl)
(qed 'nv-base-unfold)

(sp (make-wff '(FORALL K (FORALL w (== (NV-BASE-GEN K w)
  (SEP bzz_ (CARR K) (AND (= bzz_ w) (FORSOME bzp_ (HAS-CHARACTERISTIC (NORMED-FIELD-AS-COMMUTATIVE-RING K) bzp_)))))))))
(dk-peel!) (mac 'NV-BASE-GEN) (qrfl)
(qed 'nv-base-gen-unfold)

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL w (SUBSET ,bzt-bgen (CARR K)))))))
(dk-peel!)
(let ((z (subset-by-element!)))
  (let ((s (car (dk-landed (lambda () (mac-h 'nv-base-gen-unfold `(IN ,z ,bzt-bgen)))))))
    (sep-me s) (dk-ass!)))
(qed 'nv-base-gen-sub)

;; B(K) is a subfield of K
(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL w (IS-NF-SUBFIELD K ,bzt-B))))))
(dk-peel!)
(dk-cite! 'nv-field-normed 'K)
(dk-cite! 'nf-subfield-gen-is-subfield 'K bzt-bgen)
(dk-cite! 'nf-closure-subfield 'K (bzt-gen bzt-bgen))
(mac 'nv-base-unfold)
(dk-ass!)
(qed 'nv-base-subfield)

;; B(K) is closed in K
(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL w (IS-CLOSED (NF-METRIC-SPACE K) ,bzt-B))))))
(dk-peel!)
(dk-cite! 'nf-metric-space-is-metric-space 'K)
(dk-cite! 'closure-is-closed bzt-ms (bzt-gen bzt-bgen))
(mac 'nv-base-unfold)
(dk-ass!)
(qed 'nv-base-closed)

;; B(K) contains the subfield generated by its generators (the prime field, with w in prime characteristic)
(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL w (SUBSET ,(bzt-gen bzt-bgen) ,bzt-B))))))
(dk-peel!)
(dk-cite! 'nf-metric-space-is-metric-space 'K)
(dk-cite! 'nf-metric-carrier 'K)
(dk-cite! 'nf-subfield-gen-sub 'K bzt-bgen)
(dk-have! `(SUBSET ,(bzt-gen bzt-bgen) (PTS ,bzt-ms)) (lambda () (subst `(== (PTS ,bzt-ms) (CARR K))) (dk-ass!)))
(dk-cite! 'closure-contains bzt-ms (bzt-gen bzt-bgen))
(mac 'nv-base-unfold)
(dk-ass!)
(qed 'nv-base-contains-gen)

;; in prime characteristic, w lies in B(K)
(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL w (IMPLIES (IN w (CARR K))
   (FORALL p (IMPLIES (HAS-CHARACTERISTIC (NORMED-FIELD-AS-COMMUTATIVE-RING K) p) (IN w ,bzt-B)))))))))
(dk-peel!)
(dk-have! `(IN w ,bzt-bgen)
  (lambda ()
    (mac 'NV-BASE-GEN)
    (in-sep! (lambda () (dk-ass!))
             (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!)) (if (dk-head-is? (dk-goal) '=) (rfl) (witness! 'p (lambda () (dk-ass!)))))))))))
(dk-cite! 'nv-base-gen-sub 'K 'w)
(dk-cite! 'nf-subfield-gen-contains 'K bzt-bgen)
(dk-cite! 'subset-mem-fwd bzt-bgen (bzt-gen bzt-bgen) 'w)
(dk-cite! 'nv-base-contains-gen 'K 'w)
(dk-cite! 'subset-mem-fwd (bzt-gen bzt-bgen) bzt-B 'w)
(dk-ass!)
(qed 'nv-base-char-p)

;; in characteristic 0 (no prime characteristic) B(K) has no generators: it is the closure of the prime field
(sp (make-wff `(FORALL K (FORALL w (IMPLIES (FORALL p (NOT (HAS-CHARACTERISTIC (NORMED-FIELD-AS-COMMUTATIVE-RING K) p)))
   (FORALL z (NOT (IN z ,bzt-bgen))))))))
(dk-peel!)
(let ((hp (dk-pick (dk-head? 'FORALL) "the characteristic-0 hypothesis")))
  (di)
  (let* ((z (cadr (car (filter (lambda (f) (and (pair? f) (eq? (car f) 'IN) (equal? (caddr f) bzt-bgen))) (dk-asms)))))
         (s (car (dk-landed (lambda () (mac-h 'nv-base-gen-unfold `(IN ,z ,bzt-bgen))))))
         (ls (dk-landed (lambda () (sep-me s))))
         (cj (car (filter (dk-head? 'AND) ls)))
         (parts (dk-split! cj))
         (p (dk-skolem! (car (filter (dk-head? 'FORSOME) parts)))))
    (dk-apply! hp p)
    (ai `(NOT (HAS-CHARACTERISTIC (NORMED-FIELD-AS-COMMUTATIVE-RING K) ,p)))))
(qed 'nv-base-char-0)

;;; -----------------------------------------------------------------------
;;; 6. Proposition 4.21 and Remark 4.23 for B(K), in K's metric (see the report: packaging B(K) as a normed field
;;; of its own, SUB-NF, is the step not taken).

(define bzt-ZK '(NV-INTEGERS K))
;; Proposition 4.21 (content): for K with compact integers, B(K) is a closed subfield whose unit ball B(K) n Z(K)
;; is compact.
(sp (make-wff `(FORALL K (IMPLIES (IS-COMPACT-NV-DOMAIN K ,bzt-ZK) (FORALL w
   (AND (IS-NF-SUBFIELD K ,bzt-B) (AND (IS-CLOSED ,bzt-ms ,bzt-B)
        (IS-COMPACT (SUBSPACE-MS ,bzt-ms (INTERSECTION ,bzt-ZK ,bzt-B))))))))))
(dk-peel!)
(dk-cite! 'nv-compact-domain 'K bzt-ZK)
(dk-cite! 'nv-domain-field 'K bzt-ZK)
(dk-cite! 'nv-field-normed 'K)
(bzt-iff-fwd! 'is-compact-nv-domain 'K bzt-ZK)
(dk-cite! 'nf-metric-space-is-metric-space 'K)
(dk-cite! 'nf-metric-carrier 'K)
(dk-have! `(SUBSET ,bzt-ZK (PTS ,bzt-ms))
  (lambda () (subst `(== (PTS ,bzt-ms) (CARR K)))
    (let ((z (subset-by-element!))) (dk-cite! 'nv-domain-sub 'K bzt-ZK z) (dk-ass!))))
(dk-cite! 'nv-base-subfield 'K 'w)
(dk-cite! 'nv-base-closed 'K 'w)
(dk-cite! 'compact-inter-closed bzt-ms bzt-ZK bzt-B)
(dk-conj-close! dk-ass!)
(qed 'ccr-4-21-base)

;; Proposition 4.21, characteristic p: B(K) contains the uniformizing parameter w, 0 < |w| < 1, so B(K) is not
;; discrete.
(sp (make-wff `(FORALL K (IMPLIES (IS-COMPACT-NV-DOMAIN K ,bzt-ZK) (FORALL w (IMPLIES (IN w ,bzt-ZK)
   (IMPLIES (= (NV-MAXIMAL K ,bzt-ZK) (NV-PRINCIPAL K ,bzt-ZK w)) (IMPLIES (NOT (= w (ZERO K)))
   (FORALL p (IMPLIES (HAS-CHARACTERISTIC (NORMED-FIELD-AS-COMMUTATIVE-RING K) p)
     (AND (IN w ,bzt-B) (AND (< 0 ((FNRM K) w)) (< ((FNRM K) w) 1)))))))))))))
(dk-peel!)
(dk-cite! 'nv-compact-domain 'K bzt-ZK)
(dk-cite! 'nv-domain-normed 'K bzt-ZK)
(dk-cite! 'nv-domain-sub 'K bzt-ZK 'w)
(dk-cite! 'nv-base-char-p 'K 'w 'p)
(bzt-norm-pos! 'w)
(dk-split-all! (list (dk-cite! 'ccr-remark-4-4-norm 'K bzt-ZK 'w)))
(dk-conj-close! dk-ass!)
(qed 'ccr-4-21-base-char-p)

;; Remark 4.23 for B(K), characteristic p, in the form that holds: w is a uniformizing parameter of B(K) in the
;; sense of Remark 4.5 -- among the elements of B(K) of absolute value < 1 it has the largest absolute value.
;; (The notes' M(B(K)) = M(K) is false for d > 1: see the report.)
(sp (make-wff `(FORALL K (IMPLIES (IS-COMPACT-NV-DOMAIN K ,bzt-ZK) (FORALL w (IMPLIES (IN w ,bzt-ZK)
   (IMPLIES (= (NV-MAXIMAL K ,bzt-ZK) (NV-PRINCIPAL K ,bzt-ZK w)) (IMPLIES (NOT (= w (ZERO K)))
   (FORALL p (IMPLIES (HAS-CHARACTERISTIC (NORMED-FIELD-AS-COMMUTATIVE-RING K) p)
     (AND (IN w ,bzt-B) (FORALL x (IMPLIES (IN x ,bzt-B) (IMPLIES (< ((FNRM K) x) 1) (<= ((FNRM K) x) ((FNRM K) w))))))))))))))))
(dk-peel!)
(dk-cite! 'nv-compact-domain 'K bzt-ZK)
(dk-cite! 'nv-domain-field 'K bzt-ZK)
(dk-cite! 'nv-domain-normed 'K bzt-ZK)
(dk-cite! 'nv-domain-sub 'K bzt-ZK 'w)
(dk-cite! 'nv-base-char-p 'K 'w 'p)
(dk-cite! 'nv-base-subfield 'K 'w)
(bzt-sf-open! bzt-B)
(dk-cite! 'nv-principal-self 'K bzt-ZK 'w)
(let* ((iff (dk-cite! 'ccr-remark-4-5 'K bzt-ZK 'w 'w))
       (mx (begin (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (caddr (caddr iff)))))
  (dk-split-all! (list (caddr iff)))
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let ((x (car (bzt-peel-vars!))))
            (dk-split-all!)
            (bzt-in! x bzt-B)
            (bzt-typek! x)
            (dk-have! `(IN ,x ,bzt-ZK)
              (lambda () (mac 'nv-integers-unfold) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ineq! `(< ,(bzt-n x) 1))))))
            (dk-have! `(IN ,x (NV-MAXIMAL K ,bzt-ZK))
              (lambda () (mac 'nv-maximal-unfold) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
            (dk-chain-ass! (dk-apply! mx x))
            (dk-ass!))))))
(qed 'ccr-4-23-base-char-p)
