;;; Convention for "K local with uniformizing parameter w" (as in ccr4x-zpow, ccr2-nv): A a compact NV domain of
;;; K, w in A, M(A) = (w), w /= 0.
;;;
;;; 1. Remarks 4.4 / 4.5 (uniformizers).
;;; 2. The collapse remark: Z_F(K) contains M(K) whenever F contains the zero class, so its field of fractions is
;;;    K (Definition 4.20's B_F(K) is K for every F; CCR-1109-C-REPORT F1).
;;; 3. Closure in a normed field by approximation (intro / elim).
;;; 4. The subfield generated by a set.
;;; 5. The closure of a subfield of an NV field is a subfield; B(K) is a closed subfield of K containing w in
;;;    prime characteristic.

(define bzt-M '(NV-MAXIMAL K A))
(define (bzt-n x) `((FNRM K) ,x))
(define (bzt-mul x y) `((MUL K) ,x ,y))
(define (bzt-add x y) `((ADD K) ,x ,y))
(define (bzt-neg x) `((NEG K) ,x))
(define (bzt-sub x y) `((ADD K) ,x ((NEG K) ,y)))
(define (bzt-P g) `(NV-PRINCIPAL K A ,g))
(define bzt-unif-hyps '((IS-COMPACT-NV-DOMAIN K A) (IN w A) (= (NV-MAXIMAL K A) (NV-PRINCIPAL K A w)) (NOT (= w (ZERO K)))))
(define (bzt-unif body)
  `(FORALL K (FORALL A (IMPLIES (IS-COMPACT-NV-DOMAIN K A) (FORALL w (IMPLIES (IN w A)
     (IMPLIES (= (NV-MAXIMAL K A) (NV-PRINCIPAL K A w)) (IMPLIES (NOT (= w (ZERO K))) ,body))))))))
(define (bzt-unit-in! u)
  (if (not (dk-asm? `(IN ,u A)))
      (dk-have! `(IN ,u A)
        (lambda () (let ((s (car (dk-landed (lambda () (mac-h 'nv-units-unfold `(IN ,u (NV-UNITS K A)))))))) (sep-me s) (dk-ass!))))))
(define (bzt-typek! x)
  (dk-cite! 'nf-norm-in-rr 'K x)
  (dk-cite! 'nf-norm-nonneg 'K x))
(define (bzt-show-open)
  (for-each (lambda (l) (display ";; OPEN: ") (display (expression->string (dk-goal-of l))) (newline)
              )
            (dk-open-leaves)))
(define (bzt-and! . fs)
  (let ((c (let loop ((fs fs)) (if (null? (cdr fs)) (car fs) `(AND ,(car fs) ,(loop (cdr fs)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
;; X /= ZERO K in context: land 0 < |X|
(define (bzt-norm-pos! x)
  (bzt-typek! x)
  (if (not (dk-asm? `(< 0 ,(bzt-n x))))
   (begin
    (dk-have! `(NOT (= 0 ,(bzt-n x)))
      (lambda ()
        (di)
        (let ((iff (dk-cite! 'nf-norm-zero-iff 'K x)))
          (dk-have! `(= ,(bzt-n x) 0) (lambda () (subst `(= ,(bzt-n x) 0)) (rfl)))
          (dk-have! `(= ,x (ZERO K)) (lambda () (ai iff) (detach! `(IMPLIES (= ,(bzt-n x) 0) (= ,x (ZERO K)))) (dk-ass!)))
          (ai `(NOT (= ,x (ZERO K)))))))
    (bzt-and! `(<= 0 ,(bzt-n x)) `(NOT (= 0 ,(bzt-n x))))
    (dk-cite! 'rr-le-ne-lt 0 (bzt-n x)))))
(define (bzt-dom!)
  (dk-cite! 'nv-compact-domain 'K 'A)
  (dk-cite! 'nv-domain-normed 'K 'A))

;;; -----------------------------------------------------------------------
;;; 1. Uniformizers (Remarks 4.4, 4.5).

;; Remark 4.4, second paragraph: a uniformizing parameter lies in M(A), so |w| < 1.
(sp (make-wff (bzt-unif `(AND (IN w ,bzt-M) (< ,(bzt-n 'w) 1)))))
(dk-peel!)
(bzt-dom!)
(dk-cite! 'nv-principal-self 'K 'A 'w)
(dk-rewrite-h! `(IN w ,(bzt-P 'w)) (bzt-P 'w) bzt-M)
(dk-cite! 'nv-maximal-norm 'K 'A 'w)
(dk-conj-close! dk-ass!)
(qed 'ccr-remark-4-4-norm)

;; Remark 4.4: w u is a uniformizing parameter for every unit u.
(sp (make-wff (bzt-unif `(FORALL u (IMPLIES (IN u (NV-UNITS K A))
   (AND (IN ,(bzt-mul 'u 'w) A) (AND (= ,bzt-M ,(bzt-P (bzt-mul 'u 'w))) (NOT (= ,(bzt-mul 'u 'w) (ZERO K))))))))))
(dk-peel!)
(bzt-dom!)
(dk-cite! 'nv-uniformizer-pid 'K 'A 'w)
(bzt-unit-in! 'u)
(let ((uw (bzt-mul 'u 'w)))
  (dk-cite! 'nv-domain-mul 'K 'A 'u 'w)
  (dk-cite! 'nv-domain-sub 'K 'A 'u)
  (dk-cite! 'nv-domain-sub 'K 'A 'w)
  (dk-cite! 'nf-norm-mult 'K 'u 'w)
  (dk-cite! 'nv-unit-norm 'K 'A 'u)
  (bzt-typek! 'w)
  (dk-have! `(= ,(bzt-n uw) ,(bzt-n 'w))
    (lambda () (subst `(= ,(bzt-n uw) (* ,(bzt-n 'u) ,(bzt-n 'w)))) (subst `(= ,(bzt-n 'u) 1)) (crs)))
  (dk-cite! 'nv-compact-pid-principal-ball 'K 'A 'w)
  (dk-cite! 'nv-compact-pid-principal-ball 'K 'A uw)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-ass!) #t)
            ((dk-head-is? (dk-goal) '=)
             (subst `(= ,(bzt-P uw) (NV-BALL K A ,(bzt-n uw))))
             (subst `(= ,(bzt-n uw) ,(bzt-n 'w)))
             (subst `(= (NV-BALL K A ,(bzt-n 'w)) ,(bzt-P 'w)))
             (dk-ass!))
            (#t
             (di)
             (dk-cite! 'nf-norm-of-zero 'K)
             (dk-have! `(= ,(bzt-n 'w) 0)
               (lambda () (subst `(= ,(bzt-n 'w) ,(bzt-n uw))) (subst `(= ,uw (ZERO K))) (dk-ass!)))
             (dk-cite! 'nf-norm-zero-implies 'K 'w)
             (ai '(NOT (= w (ZERO K)))))))))
(qed 'ccr-remark-4-4-unit)

;; Remark 4.4: every uniformizing parameter is w u for a unit u (the notes write w u; the product is commutative).
(sp (make-wff (bzt-unif `(FORALL w2 (IMPLIES (IN w2 A) (IMPLIES (= ,bzt-M ,(bzt-P 'w2))
   (FORSOME u (AND (IN u (NV-UNITS K A)) (= w2 ,(bzt-mul 'u 'w))))))))))
(dk-peel!)
(bzt-dom!)
(dk-have! `(= ,(bzt-P 'w2) ,(bzt-P 'w)) (lambda () (subst `(= ,(bzt-P 'w2) ,bzt-M)) (dk-ass!)))
(dk-chain-ass! (dk-cite! 'nv-generators-associate 'K 'A 'w2 'w))
(dk-ass!)
(qed 'ccr-remark-4-4)

;; Remark 4.5: the uniformizing parameters are exactly the elements of M(A) of maximal absolute value.
(sp (make-wff (bzt-unif `(FORALL w2 (IMPLIES (IN w2 A)
   (IFF (= ,bzt-M ,(bzt-P 'w2))
        (AND (IN w2 ,bzt-M) (FORALL x (IMPLIES (IN x ,bzt-M) (<= ,(bzt-n 'x) ,(bzt-n 'w2)))))))))))
(dk-peel!)
(bzt-dom!)
(dk-cite! 'ccr-remark-4-4-norm 'K 'A 'w)
(dk-iff! (dk-head? 'AND)
  (lambda ()
    (dk-cite! 'nv-principal-self 'K 'A 'w2)
    (dk-rewrite-h! `(IN w2 ,(bzt-P 'w2)) (bzt-P 'w2) bzt-M)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (dk-peel!)
              (let ((x (cadr (cadr (dk-goal)))))
                (dk-rewrite-h! `(IN ,x ,bzt-M) bzt-M (bzt-P 'w2))
                (dk-cite! 'nv-principal-norm-le 'K 'A 'w2 x)
