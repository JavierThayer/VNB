;;; (E12)-(E14) THE FUNDAMENTAL THEOREM OF ALGEBRA (the notes' 1.5) for the polynomial
;;; function z |-> sum_{k <= n} p(k) z^k with p(n) /= 0, n >= 1, written as the partial sum
;;; CC-SERIES-PARTIAL-SUM(k |-> p(k) z^k, n + 1) of a coefficient function p in FUN(NN, CC).
(define (cie-pterm w) (list 'VNB-LAMBDA 'k 'NN (list '* '(ciep_ k) (list 'power w 'k))))
(define (cie-poly w n) (list 'CC-SERIES-PARTIAL-SUM (cie-pterm w) n))
(define cie-A '(VNB-LAMBDA k NN (magnitude (ciep_ k))))
(define (cie-F n) (list 'VNB-LAMBDA 'cifw_ 'CC (cie-poly 'cifw_ n)))
(define (cie-cc-open!)
  (fact 'cc-is-metric-space)
  (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
  (dk-cite! 'carrier-is-open 'CC-MS)
  (dk-have! '(IS-OPEN CC-MS CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass)))
  (fact 'cc-is-set))
;;; w in CC, j in NN, p in FUN(NN, CC): T_w typed, T_w(j) and the partial sums typed
(define (cie-pterm-typ! w)
  (cie-lam-typ! (cie-pterm w) 'NN (lambda (k) (fact 'fun-apply-type-c 'ciep_ 'NN 'CC k))))
(define (cie-ps-typ! w n)
  (cie-pterm-typ! w)
  (cie-nn! n)
  (dk-cite! 'cc-series-partial-sum-in-cc n (cie-pterm w)))
;;; (cie-ps-succ! w n): PS(T_w, succ n) == PS(T_w, n) + p(n) w^n, landed
(define (cie-ps-succ! w n)
  (let* ((tn (list (cie-pterm w) n)) (v (list '* (list 'ciep_ n) (list 'power w n))))
    (cie-ps-typ! w n)
    (fact 'fun-apply-type-c 'ciep_ 'NN 'CC n)
    (cie-cc! v)
    (dk-have! (list 'IN tn 'CC) (lambda () (cie-steps cie-lam-b-if! ass)))
    (let* ((e (dk-cite! 'cc-series-partial-sum-succ (cie-pterm w) n)))
      (dk-have! (list '== (list 'CC-SERIES-PARTIAL-SUM (cie-pterm w) (list 'succ n)) (list '+ (cie-poly w n) v))
        (lambda () (subst e) (dk-lam-b!) (qrfl))))))

