               (R (list '+ (list '+ 'ciea_ 1) (list '* 'ciek_ re))))
          (dk-have! (list '= (list '* e re) 1) (lambda () (subst (list '= re (list 'recip e))) (ass)))
          (dk-have! (list '< 0 re) (lambda () (subst (list '= re (list 'recip e))) (ass)))
          (cie-and! '(IN ciek_ RR) (list 'IN re 'RR))
          (dk-have! (list '<= 0 re) (lambda () (dk-ineq! (list '< 0 re))))
          (cie-and! '(<= 0 ciek_) (list '<= 0 re))
          (dk-cite! 'rr-leq-mul-nonneg 'ciek_ re)
          (cie-rr! R)
          (let* ((rv (dk-name! R)))
            (dk-have! (list '< 'ciea_ rv) (lambda () (dk-ineq! (list '= rv R) (list '<= 0 (list '* 'ciek_ re)))))
            (dk-have! (list '< 0 rv) (lambda () (dk-ineq! (list '= rv R) (list '<= 0 (list '* 'ciek_ re)) '(<= 0 ciea_))))
            (dk-apply! cie-sq-h rv)
            (fact 'rr-pos-ne-zero rv)
            (cie-and! (list 'IN rv 'RR) (list 'NOT (list '= rv 0)))
            (dk-cite! 'rr-recip-closed rv)
            (dk-cite! 'rr-recip-inverse rv)
            (let* ((rr (dk-name! (list 'recip rv)))
                   (p1 (begin (cie-rr! (list '* 'ciek_ rr)) (dk-name! (list '* 'ciek_ rr))))
                   (p2 (begin (cie-rr! (list '* e rv)) (dk-name! (list '* e rv)))))
              (dk-have! (list '= (list '* rv rr) 1) (lambda () (subst (list '= rr (list 'recip rv))) (ass)))
              (dk-have! (list '< 0 rr) (lambda () (dk-cite! 'rr-recip-pos rv) (subst (list '= rr (list 'recip rv))) (ass)))
              ;; e R = e (a + 1) + K
              (dk-have! (list '= p2 (list '+ (list '* e (list '+ 'ciea_ 1)) 'ciek_))
                (lambda ()
                  (subst (list '= p2 (list '* e rv)))
                  (subst (list '= rv R))
                  (let* ((eq (list '= (list '* e (list '+ (list '+ 'ciea_ 1) (list '* 'ciek_ re)))
                                  (list '+ (list '* e (list '+ 'ciea_ 1)) (list '* (list '* e re) 'ciek_)))))
                    (dk-have! eq (lambda () (crs)))
                    (subst eq)
                    (subst (list '= (list '* e re) 1))
                    (crs))))
              (cie-rr! (list '+ 'ciea_ 1))
              (cie-and! (list 'IN e 'RR) (list 'IN (list '+ 'ciea_ 1) 'RR))
              (dk-have! (list '<= 0 e) (lambda () (dk-ineq! (list '< 0 e))))
              (dk-have! (list '<= 0 (list '+ 'ciea_ 1)) (lambda () (dk-ineq! '(<= 0 ciea_))))
              (cie-and! (list '<= 0 e) (list '<= 0 (list '+ 'ciea_ 1)))
              (dk-cite! 'rr-leq-mul-nonneg e (list '+ 'ciea_ 1))
              (cie-rr! (list '* e (list '+ 'ciea_ 1)))
              (dk-have! (list '<= 'ciek_ p2)
                (lambda () (dk-ineq! (list '= p2 (list '+ (list '* e (list '+ 'ciea_ 1)) 'ciek_))
                                     (list '<= 0 (list '* e (list '+ 'ciea_ 1))))))
              (dk-have! (list '<= 0 rr) (lambda () (dk-ineq! (list '< 0 rr))))
              (dk-cite! 'rr-mul-le-right 'ciek_ p2 rr)
              (cie-rr! (list '* p2 rr))
              (dk-have! (list '= (list '* p2 rr) e)
                (lambda ()
                  (subst (list '= p2 (list '* e rv)))
                  (let* ((eq (list '= (list '* (list '* e rv) rr) (list '* e (list '* rv rr)))))
                    (dk-have! eq (lambda () (crs)))
                    (subst eq)
                    (subst (list '= (list '* rv rr) 1))
                    (crs))))
              (dk-have! (list '<= 'ciex_ p1)
                (lambda () (subst (list '= p1 (list '* 'ciek_ rr))) (subst (list '= rr (list 'recip rv))) (ass)))
              (dk-have! (list '<= p1 e)
                (lambda () (subst (list '= p1 (list '* 'ciek_ rr))) (subst (list '= e (list '* p2 rr))) (ass)))
              (dk-ineq! (list '<= 'ciex_ p1) (list '<= p1 e))))))))
  (ass))
(qed 'cie-squeeze)
