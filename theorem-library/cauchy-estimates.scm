             (fact 'rr-subset-cc mw)
             (subst (dk-cite! 'power-zero mw))
             (dk-have! (list '= (list '+ 0 (list '* '(ciep_ 0) 1)) '(ciep_ 0)) (lambda () (crs)))
             (subst (list '= (list '+ 0 (list '* '(ciep_ 0) 1)) '(ciep_ 0)))
             (subst (list '= sa a0))
             (dk-ineq! (list 'IN a0 'RR)))))))))
(dk-focus! (cdr (assq 'step cie-gb-br)))
(define cie-gb-n (cdr (assq 'var cie-gb-br)))
(define cie-gb-ih (cdr (assq 'ih cie-gb-br)))
(dk-peel!)
(cie-A-typ!)
(dk-split-all! (list (dk-apply! cie-gb-ih 'ciep_)))
(let* ((n cie-gb-n) (sn (list 'succ n)) (ssn (list 'succ sn))
       (sa (cie-SA sn)) (sa2 (cie-SA ssn)) (an (list 'magnitude (list 'ciep_ sn)))
       (bnd (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'ciew_))) "the bound at n")))
  (fact 'nn-succ-closed n)
  (cie-sa-succ! sn)
  (dk-cite! 'cc-magnitude-nonneg (list 'ciep_ sn))
  (cie-rr! an)
  (dk-have! (list 'IN sa2 'RR) (lambda () (subst (list '== sa2 (list '+ sa an))) (cie-rr! (list '+ sa an)) (ass)))
  (dk-have! (list '<= 0 sa2) (lambda () (subst (list '== sa2 (list '+ sa an))) (dk-ineq! (list '<= 0 sa) (list '<= 0 an))))
  (dk-conj-close!
    (lambda ()
      (let* ((g (dk-goal)))
        (cond
          ((dk-asm? g) (ass))
          (#t
           (let* ((lk (dk-peel!))
                  (w (cadr (car (filter (dk-head? 'IN) lk))))
                  (mw (list 'magnitude w))
                  (q (cie-poly w sn))
                  (t (list '* (list 'ciep_ sn) (list 'power w sn)))
                  (x (list 'power mw n)) (y (list 'power mw sn)))
             (dk-apply! bnd w)
             (cie-ps-succ! w sn)
             (subst (list '== (cie-poly w ssn) (list '+ q t)))
             (cie-cc! q) (cie-cc! t)
             (cie-and! (list 'IN q 'CC) (list 'IN t 'CC))
             (dk-cite! 'cc-magnitude-triangle q t)
             (fact 'fun-apply-type-c 'ciep_ 'NN 'CC sn)
             (cie-cc! (list 'power w sn))
             (cie-and! (list 'IN (list 'ciep_ sn) 'CC) (list 'IN (list 'power w sn) 'CC))
             (dk-cite! 'cc-magnitude-mul (list 'ciep_ sn) (list 'power w sn))
             (dk-cite! 'cc-magnitude-power sn w)
             (cie-rr! mw)
             (fact 'power-real-closed mw n)
             (fact 'power-real-closed mw sn)
             (fact 'rr-subset-cc mw)
             (let* ((ys (cie-pow-succ! mw n))
                    (xv (dk-name! x)) (yv (dk-name! y)))
               (dk-have! (list '= yv (list '* mw xv)) (lambda () (subst (list '= yv y)) (subst (list '= xv x)) (ass)))
               (dk-have! (list '<= 0 mw) (lambda () (dk-ineq! (list '<= 1 mw))))
               (dk-have! (list '<= 0 xv) (lambda () (subst (list '= xv x)) (dk-cite! 'rr-power-nonneg n mw) (ass)))
               (cie-and! (list 'IN mw 'RR) (list 'IN xv 'RR))
               ;; x <= y: y - x = (|w| - 1) x >= 0
               (let* ((d (list '- mw 1)))
                 (cie-rr! d)
                 (dk-have! (list '<= 0 d) (lambda () (dk-ineq! (list '<= 1 mw))))
                 (cie-and! (list 'IN d 'RR) (list 'IN xv 'RR))
                 (cie-and! (list '<= 0 d) (list '<= 0 xv))
                 (dk-cite! 'rr-leq-mul-nonneg d xv)
                 (cie-rr! (list '* d xv))
                 (dk-have! (list '= (list '* d xv) (list '- yv xv)) (lambda () (subst (list '= yv (list '* mw xv))) (crs))))
               (dk-have! (list '<= xv yv) (lambda () (dk-ineq! (list '<= 0 (list '* (list '- mw 1) xv)) (list '= (list '* (list '- mw 1) xv) (list '- yv xv)))))
               (cie-and! (list '<= 0 sa) (list '<= xv yv))
               (dk-cite! 'rr-le-scale-nonneg sa xv yv)
               (let* ((p1 (begin (cie-rr! (list '* sa xv)) (dk-name! (list '* sa xv))))
                      (p2 (begin (cie-rr! (list '* sa yv)) (dk-name! (list '* sa yv))))
                      (p3 (begin (cie-rr! (list '* an yv)) (dk-name! (list '* an yv))))
                      (mq (list 'magnitude q)) (mt (list 'magnitude t)))
                 (cie-rr! mq) (cie-rr! mt)
                 (dk-have! (list '<= mq p1) (lambda () (subst (list '= p1 (list '* sa xv))) (subst (list '= xv x)) (ass)))
                 (dk-have! (list '<= p1 p2) (lambda () (subst (list '= p1 (list '* sa xv))) (subst (list '= p2 (list '* sa yv))) (ass)))
                 (dk-have! (list '= mt p3)
                   (lambda () (subst (list '= p3 (list '* an yv))) (subst (list '= yv y))
                              (subst (list '= mt (list '* an (list 'magnitude (list 'power w sn)))))
                              (subst (list '= (list 'magnitude (list 'power w sn)) y)) (rfl)))
                 (dk-have! (list '= (list '* sa2 y) (list '+ p2 p3))
                   (lambda () (subst (list '== sa2 (list '+ sa an))) (subst (list '= y yv))
                              (subst (list '= p2 (list '* sa yv))) (subst (list '= p3 (list '* an yv))) (crs)))
                 (cie-rr! (list 'magnitude (list '+ q t)))
                 (cie-rr! (list '* sa2 y))
                 (dk-ineq! (list '<= (list 'magnitude (list '+ q t)) (list '+ mq mt))
                           (list '<= mq p1) (list '<= p1 p2) (list '= mt p3)
                           (list '= (list '* sa2 y) (list '+ p2 p3))))))))))))
(qed 'polynomial-growth-bound)
;;; (E14) THE FUNDAMENTAL THEOREM OF ALGEBRA.  A polynomial function of degree n >= 1 with
;;; no zero would have an entire reciprocal g = 1/p; on the circle |w| = R (R large) the
;;; growth bound gives |g| <= K / R, so |g(0)| <= K / R for every large R
;;; (cauchy-estimate-center), g(0) = 0, against g(0) p(0) = 1.  (The notes route it through
;;; Liouville; the centre bound is the same estimate one step shorter.)
(define cie-fta-n '(succ ciem_))
(define cie-fta-top '(succ (succ ciem_)))
(define cie-fta-goal (list 'FORSOME 'z (list 'AND '(IN z CC) (list '= (cie-poly 'z cie-fta-top) 0))))
(sp (make-wff (list 'FORALL 'ciep_ (list 'IMPLIES '(IN ciep_ (FUN NN CC))
  (list 'FORALL 'ciem_ (list 'IMPLIES '(IN ciem_ NN) (list 'IMPLIES (list 'NOT (list '= (list 'ciep_ cie-fta-n) 0))
    cie-fta-goal)))))))
(dk-peel!)
(pbc)
(define cie-fta-nz
  (list 'FORALL 'cifz_ (list 'IMPLIES '(IN cifz_ CC) (list 'NOT (list '= (cie-poly 'cifz_ cie-fta-top) 0)))))
(dk-have! cie-fta-nz
  (lambda ()
    (let* ((z (dk-di-var!)))
      (di)
      (dk-have! cie-fta-goal (lambda () (ew z) (dk-conj-close! dk-ass!)))
      (ai (dk-ctx-form (list 'NOT cie-fta-goal))))))
(cie-cc-open!)
(fact 'nn-succ-closed 'ciem_)
(fact 'nn-succ-closed cie-fta-n)
(define cie-fta-F (cie-F cie-fta-top))
(define cie-fta-g (list 'VNB-LAMBDA 'cifv_ 'CC (list 'recip (cie-poly 'cifv_ cie-fta-top))))
(define (cie-fta-pt! v)
  ;; v in CC: P(v) typed, non-zero, its reciprocal typed
  (cie-ps-typ! v cie-fta-top)
  (dk-apply! (dk-ctx-form cie-fta-nz) v)
  (cie-cc! (list 'recip (cie-poly v cie-fta-top))))
(dk-cite! 'polynomial-holomorphic cie-fta-top 'ciep_)
(cie-lam-typ! cie-fta-F 'CC (lambda (v) (cie-ps-typ! v cie-fta-top)))
(cie-lam-typ! cie-fta-g 'CC (lambda (v) (cie-fta-pt! v)))
(dk-have! (list 'FORALL 'cry_ (list 'IMPLIES '(IN cry_ CC) (list 'NOT (list '= (list cie-fta-F 'cry_) 0))))
  (lambda () (let* ((v (dk-di-var!)) (leaf (proof-state-focus *ps*)))
               (cie-fta-pt! v) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (ass)))))
(dk-have! (list 'FORALL 'cry_ (list 'IMPLIES '(IN cry_ CC) (list '== (list cie-fta-g 'cry_) (list 'recip (list cie-fta-F 'cry_)))))
  (lambda () (let* ((v (dk-di-var!))) (cie-fta-pt! v) (dk-lam-b!) (qrfl))))
(dk-cite! 'holomorphic-recip-of 'CC cie-fta-F cie-fta-g)
;; |p(n)| > 0
(define cie-fta-an (list 'ciep_ cie-fta-n))
(define cie-fta-al (list 'magnitude cie-fta-an))
(fact 'fun-apply-type-c 'ciep_ 'NN 'CC cie-fta-n)
(cie-rr! cie-fta-al)
(dk-cite! 'cc-magnitude-nonneg cie-fta-an)
(let* ((iff (dk-cite! 'cc-magnitude-zero-iff cie-fta-an)))
  (dk-have! (list 'NOT (list '= 0 cie-fta-al))
    (lambda () (di) (fact 'eq-sym 0 cie-fta-al)
                (dk-have! (list '= cie-fta-an 0) (lambda () (cie-only-prop! iff (list '= cie-fta-al 0))))
                (ai (dk-ctx-form (list 'NOT (list '= cie-fta-an 0)))))))
(cie-and! (list '<= 0 cie-fta-al) (list 'NOT (list '= 0 cie-fta-al)))
(dk-cite! 'rr-le-ne-lt 0 cie-fta-al)
;; the growth bound at degree n - 1 = m
(cie-A-typ!)
(dk-split-all! (list (dk-cite! 'polynomial-growth-bound 'ciem_ 'ciep_)))
(define cie-fta-sa (cie-SA cie-fta-n))
(define cie-fta-gb (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'ciew_))) "the growth bound"))
(fact 'rr-pos-ne-zero cie-fta-al)
(cie-and! (list 'IN cie-fta-al 'RR) (list 'NOT (list '= cie-fta-al 0)))
(dk-cite! 'rr-recip-closed cie-fta-al)
(dk-cite! 'rr-recip-inverse cie-fta-al)
(dk-cite! 'rr-recip-pos cie-fta-al)
(define cie-fta-ra (dk-name! (list 'recip cie-fta-al)))
(dk-have! (list '= (list '* cie-fta-al cie-fta-ra) 1) (lambda () (subst (list '= cie-fta-ra (list 'recip cie-fta-al))) (ass)))
(dk-have! (list '< 0 cie-fta-ra) (lambda () (subst (list '= cie-fta-ra (list 'recip cie-fta-al))) (ass)))
(define cie-fta-k (list '* 2 cie-fta-ra))
(cie-rr! cie-fta-k)
(dk-have! (list '<= 0 cie-fta-k) (lambda () (dk-ineq! (list '< 0 cie-fta-ra))))
(cie-and! (list 'IN cie-fta-sa 'RR) (list 'IN cie-fta-ra 'RR))
(dk-have! (list '<= 0 cie-fta-ra) (lambda () (dk-ineq! (list '< 0 cie-fta-ra))))
(cie-and! (list '<= 0 cie-fta-sa) (list '<= 0 cie-fta-ra))
(dk-cite! 'rr-leq-mul-nonneg cie-fta-sa cie-fta-ra)
(define cie-fta-sr (begin (cie-rr! (list '* cie-fta-sa cie-fta-ra)) (dk-name! (list '* cie-fta-sa cie-fta-ra))))
(dk-have! (list '<= 0 cie-fta-sr) (lambda () (subst (list '= cie-fta-sr (list '* cie-fta-sa cie-fta-ra))) (ass)))
(define cie-fta-r0 (list '+ 1 (list '* 2 cie-fta-sr)))
(cie-rr! cie-fta-r0)
(dk-have! (list '<= 0 cie-fta-r0) (lambda () (dk-ineq! (list '<= 0 cie-fta-sr))))
;; on a circle |w| = R, R > R0: |g(w)| <= K / R
(define (cie-fta-circle-bound! rv)
  ;; rv in RR, R0 < rv in context
  (let* ((tr (list 'TRACE (list 'CIRCLE-PATH 0 rv) 0 cie-tp))
         (rr (list 'recip rv)))
    (dk-have! (list '< 0 rv) (lambda () (dk-ineq! (list '< cie-fta-r0 rv) (list '<= 0 cie-fta-sr))))
    (fact 'rr-pos-ne-zero rv)
    (cie-and! (list 'IN rv 'RR) (list 'NOT (list '= rv 0)))
    (dk-cite! 'rr-recip-closed rv)
    (dk-cite! 'rr-recip-inverse rv)
    (dk-have! (list '<= 0 rv) (lambda () (dk-ineq! (list '< 0 rv))))
    (cie-rr! rr)
    (cie-rr! (list '* cie-fta-k rr))
    (dk-cite! 'circle-is-road 0 rv)
    (fact 'is-road-is-path (list 'CIRCLE-PATH 0 rv) (list 'CIRCLE-DERIV 0 rv) 0 cie-tp)
    (fact 'is-path-in-fun (list 'CIRCLE-PATH 0 rv) 0 cie-tp)
    (dk-cite! 'trace-subset-cc (list 'CIRCLE-PATH 0 rv) 0 cie-tp)
    (dk-have! (list 'FORALL 'ciey_ (list 'IMPLIES (list 'IN 'ciey_ tr)
                (list '<= (list 'magnitude (list cie-fta-g 'ciey_)) (list '* cie-fta-k rr))))
      (lambda ()
        (let* ((y (dk-di-var!))
               (rho (list 'magnitude y))
               (q (cie-poly y cie-fta-n))
               (top (list '* cie-fta-an (list 'power y cie-fta-n)))
               (pp (cie-poly y cie-fta-top)))
          (fact 'subset-mem-fwd tr 'CC y)
          (cie-fta-pt! y)
          (dk-lam-b!)
          ;; |y| = R
          (dk-cite! 'circle-trace-magnitude 0 rv y)
          (cie-cc! (list '- y 0))
          (dk-have! (list '= (list '- y 0) y) (lambda () (crs)))
          (cie-rr! rho)
          (cie-rr! (list 'magnitude (list '- y 0)))
          (dk-congr! (list '= (list '- y 0) y) (lambda (w) (list 'magnitude w)))
          (dk-have! (list '= rho rv) (lambda () (dk-ineq! (list '= (list 'magnitude (list '- y 0)) rv) (list '= (list 'magnitude (list '- y 0)) rho))))
          (dk-have! (list '<= 1 rho) (lambda () (dk-ineq! (list '= rho rv) (list '< cie-fta-r0 rv) (list '<= 0 cie-fta-sr))))
          (dk-apply! cie-fta-gb y)
          ;; P = Q + top
          (cie-ps-succ! y cie-fta-n)
          (cie-cc! q) (cie-cc! top) (cie-cc! pp)
          (cie-cc! (list '- q))
          (dk-have! (list '= top (list '+ pp (list '- q)))
            (lambda () (subst (list '== pp (list '+ q top))) (crs)))
          (cie-and! (list 'IN pp 'CC) (list 'IN (list '- q) 'CC))
          (dk-cite! 'cc-magnitude-triangle pp (list '- q))
          (dk-cite! 'cc-magnitude-neg q)
          (cie-and! (list 'IN cie-fta-an 'CC) (list 'IN (list 'power y cie-fta-n) 'CC))
          (dk-cite! 'cc-magnitude-mul cie-fta-an (list 'power y cie-fta-n))
          (dk-cite! 'cc-magnitude-power cie-fta-n y)
          (fact 'power-real-closed rho 'ciem_)
          (fact 'rr-subset-cc rho)
          (cie-pow-succ! rho 'ciem_)
          (let* ((x (list 'power rho 'ciem_))
                 (mp (list 'magnitude pp)) (mq (list 'magnitude q)) (mt (list 'magnitude top))
                 (xv (dk-name! x)))
            (cie-rr! mp) (cie-rr! mq) (cie-rr! mt) (cie-rr! (list 'magnitude (list '- q)))
            (cie-rr! (list 'magnitude (list '+ pp (list '- q))))
            ;; X >= 1
            (fact 'rr-one-in)
            (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
            (dk-cite! 'rr-power-mono-base 'ciem_ 1 rho)
            (dk-cite! 'rr-power-one 'ciem_)
            (dk-have! (list '<= 1 xv) (lambda () (subst (list '= xv x)) (subst (list '= 1 (list 'power 1 'ciem_))) (ass)))
            (let* ((u (begin (cie-rr! (list '* cie-fta-al rho)) (dk-name! (list '* cie-fta-al rho))))
                   (ux (begin (cie-rr! (list '* u xv)) (dk-name! (list '* u xv))))
                   (sx (begin (cie-rr! (list '* cie-fta-sa xv)) (dk-name! (list '* cie-fta-sa xv)))))
              ;; |top| = U X, |Q| <= SA X
              (dk-have! (list '= mt ux)
                (lambda ()
                  (subst (list '= mt (list '* cie-fta-al (list 'magnitude (list 'power y cie-fta-n)))))
                  (subst (list '= (list 'magnitude (list 'power y cie-fta-n)) (list 'power rho cie-fta-n)))
                  (subst (list '= (list 'power rho cie-fta-n) (list '* rho x)))
                  (subst (list '= x xv))
                  (subst (list '= ux (list '* u xv)))
                  (subst (list '= u (list '* cie-fta-al rho)))
                  (crs)))
              (dk-have! (list '<= mq sx)
                (lambda () (subst (list '= sx (list '* cie-fta-sa xv))) (subst (list '= xv x)) (ass)))
              ;; U >= 2 SA
              (dk-have! (list '<= cie-fta-r0 rho) (lambda () (dk-ineq! (list '= rho rv) (list '< cie-fta-r0 rv))))
              (cie-and! (list '<= 0 cie-fta-al) (list '<= cie-fta-r0 rho))
              (dk-cite! 'rr-le-scale-nonneg cie-fta-al cie-fta-r0 rho)
              (cie-rr! (list '* cie-fta-al cie-fta-r0))
              (dk-have! (list '= (list '* cie-fta-al cie-fta-r0) (list '+ cie-fta-al (list '* 2 cie-fta-sa)))
                (lambda ()
                  (subst (list '= cie-fta-sr (list '* cie-fta-sa cie-fta-ra)))
                  (let* ((e (list '= (list '* cie-fta-al (list '+ 1 (list '* 2 (list '* cie-fta-sa cie-fta-ra))))
                                  (list '+ cie-fta-al (list '* (list '* 2 cie-fta-sa) (list '* cie-fta-al cie-fta-ra))))))
                    (dk-have! e (lambda () (crs)))
                    (subst e)
                    (subst (list '= (list '* cie-fta-al cie-fta-ra) 1))
                    (crs))))
              (dk-have! (list '<= (list '* 2 cie-fta-sa) u)
                (lambda () (dk-ineq! (list '<= (list '* cie-fta-al cie-fta-r0) (list '* cie-fta-al rho))
                                     (list '= (list '* cie-fta-al cie-fta-r0) (list '+ cie-fta-al (list '* 2 cie-fta-sa)))
                                     (list '= u (list '* cie-fta-al rho)) (list '<= 0 cie-fta-al))))
              ;; (U - SA) X >= U - SA
              (let* ((d (list '- u cie-fta-sa)))
                (cie-rr! d)
                (dk-have! (list '<= 0 d) (lambda () (dk-ineq! (list '<= (list '* 2 cie-fta-sa) u) (list '<= 0 cie-fta-sa))))
                (cie-and! (list '<= 0 d) (list '<= 1 xv))
                (dk-cite! 'rr-le-scale-nonneg d 1 xv)
                (let* ((dx (begin (cie-rr! (list '* d xv)) (dk-name! (list '* d xv)))))
                  (dk-have! (list '= dx (list '- ux sx))
                    (lambda () (subst (list '= dx (list '* d xv))) (subst (list '= ux (list '* u xv)))
                                (subst (list '= sx (list '* cie-fta-sa xv))) (crs)))
                  (dk-have! (list '<= d dx)
                    (lambda () (dk-ineq! (list '<= (list '* d 1) (list '* d xv)) (list '= dx (list '* d xv)))))
                  ;; |P| >= U/2
                  (dk-have! (list '<= mt (list '+ mp (list 'magnitude (list '- q))))
                    (lambda () (subst (list '= top (list '+ pp (list '- q)))) (ass)))
                  (dk-have! (list '<= (list '* 1/2 u) mp)
                    (lambda () (dk-ineq! (list '<= mt (list '+ mp (list 'magnitude (list '- q))))
                                         (list '= (list 'magnitude (list '- q)) mq)
                                         (list '= mt ux) (list '<= mq sx)
                                         (list '= dx (list '- ux sx)) (list '<= d dx)
                                         (list '<= (list '* 2 cie-fta-sa) u))))))
              ;; 1/|P| <= 1/(U/2) = K / R
              (let* ((h (list '* 1/2 u)))
                (cie-rr! h)
                (dk-have! (list '< 0 rho) (lambda () (dk-ineq! (list '= rho rv) (list '< 0 rv))))
                (dk-have! (list '< 0 u)
                  (lambda () (cie-steps (lambda () (subst (list '= u (list '* cie-fta-al rho))))
                                        (lambda () (dk-cite! 'rr-mul-pos cie-fta-al rho))
                                        ass)))
                (dk-have! (list '< 0 h) (lambda () (dk-ineq! (list '< 0 u))))
                (fact 'cc-magnitude-zero-iff pp)
                (dk-cite! 'aif-magnitude-recip pp)
                (subst (list '= (list 'magnitude (list 'recip pp)) (list 'recip mp)))
                (dk-cite! 'rr-recip-antitone h mp)
                (cie-rr! rr)
                (cie-rr! (list '* cie-fta-k rr))
                (dk-have! (list '= 1 (list '* h (list '* cie-fta-k rr)))
                  (lambda ()
                    (subst (list '= u (list '* cie-fta-al rho)))
                    (subst (list '= rho rv))
                    (let* ((e (list '= (list '* (list '* 1/2 (list '* cie-fta-al rv)) (list '* (list '* 2 cie-fta-ra) rr))
                                    (list '* (list '* cie-fta-al cie-fta-ra) (list '* rv rr)))))
                      (dk-have! e (lambda () (crs)))
                      (subst e)
                      (subst (list '= (list '* cie-fta-al cie-fta-ra) 1))
                      (subst (list '= (list '* rv rr) 1))
                      (crs))))
                (fact 'rr-pos-ne-zero h)
                (dk-cite! 'rr-recip-solve h 1 (list '* cie-fta-k rr))
                (cie-rr! (list 'recip h))
                (dk-have! (list '< 0 mp) (lambda () (dk-ineq! (list '< 0 h) (list '<= h mp))))
                (cie-rr! (list 'recip mp))
                (dk-ineq! (list '<= (list 'recip mp) (list 'recip h))
                          (list '= (list '* cie-fta-k rr) (list '* (list 'recip h) 1)))))))))
    ;; the centre bound
    (let* ((s (list '+ rv 1)))
      (cie-rr! s)
      (dk-have! (list '< 0 s) (lambda () (dk-ineq! (list '< 0 rv))))
      (dk-have! (list '< rv s) (lambda () (dk-ineq!)))
      (dk-have! (list 'SUBSET (list 'BALL 'CC-MS 0 s) 'CC)
        (lambda () (let* ((x (subset-by-element!))) (cie-ball-open! 0 s x))))
      (dk-cite! 'cauchy-estimate-center 'CC cie-fta-g 0 s rv (list '* cie-fta-k rr)))))
