;;; ca-lft-topology.scm -- Lemma 1.16 of complex-analysis.pdf: convergence in the topology of the
;;; extended plane C u {oo} is Euclidean convergence at a finite point, and |x_n| -> +oo at oo.
;;; CA-LFT, 2026-10-19.  Library: complex-analysis.  Vocabulary: structure-library/ca-lft-vocab.scm.
;;;
;;; WHAT THE NOTES LEAVE TO THE READER ("immediate from the definitions"): a compact subset K of C
;;; is BOUNDED and CLOSED.  Both come here from one citation, cc-exhaust-exhaustive (the exhaustion
;;; of an open set by compacta, analytic-from-integral.scm's machinery): K inside the open set C,
;;; resp. C \ {x}, lies in some CC-EXHAUST(U, n) = {z : |z| <= n, B(z, 1/(n+1)) inside U}.
;;;
;;;   cc-compact-bounded      K compact in C: |z| <= n on K for some n
;;;   cc-compact-separated    K compact in C, x not in K: some ball around x misses K
;;;   cc-hat-opens-membership the notes' topology, as a membership
;;;   cc-hat-ball-open        a Euclidean ball is open in C u {oo}
;;;   cc-hat-ball-complement-open   C u {oo} minus a closed ball is open
;;;   cc-hat-nbhd-finite      an open set containing x in C contains a Euclidean ball around x
;;;   cc-hat-nbhd-inf         an open set containing oo contains {|y| > M}
;;;   cc-hat-converges-iff    Lemma 1.16, first sentence
;;;   cc-hat-converges-inf-iff  Lemma 1.16, second sentence
;;;
;;; Helper prefix clt-.

(define (clt-finish-ass!)
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))
(define (clt-finish!)
  (let ((leaf (proof-state-focus *ps*)))
    (if (not (sequent-node-grounded? leaf))
        (if (and (dk-head-is? (dk-goal) '=) (equal? (cadr (dk-goal)) (caddr (dk-goal))))
            (rfl)
            (ass)))))
(define (clt-rewrite! s t prove)
  (if (not (equal? s t))
      (begin (dk-have! (list '= s t) prove) (subst (list '= s t)))))

(define (clt-type! t)
  (if (not (dk-asm? (list 'IN t 'CC)))
      (dk-have! (list 'IN t 'CC) (lambda () (type-term)))))
(define (clt-real! t)
  (if (not (dk-asm? (list 'IN t 'RR)))
      (dk-have! (list 'IN t 'RR) (lambda () (type-term)))))
(define (clt-conj fs)
  (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (clt-conj (cdr fs)))))
(define (clt-cite-and! thm fs . terms)
  (let ((c (clt-conj fs)))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    (apply dk-cite! thm terms)))

;;; keep FS and close by prop -- unless keep already landed on a proven sequent
(define (clt-keep-prop! . fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))

;;; (SUBSET A B) and (IN x A) in context: land (IN x B)
(define (clt-subset-elim! a b x)
  (let* ((iff (dk-cite! 'subset-def a b))
         (all (caddr iff)))
    (if (not (dk-asm? all)) (dk-have! all (lambda () (clt-keep-prop! iff (list 'SUBSET a b)))))
    (dk-apply! (dk-ctx-form all) x)))

;;; from (IFF P Q) and P in context, land Q (P survives)
(define (clt-iff-fwd! iff)
  (if (not (dk-asm? (caddr iff)))
      (dk-have! (caddr iff) (lambda () (clt-keep-prop! iff (cadr iff)))))
  (caddr iff))

;;; C is open in the normed-field metric of CC
(define (clt-cc-open-nf!)
  (fact 'cc-is-metric-space)
  (fact 'cc-ms@pts)
  (dk-have! '(IS-OPEN CC-MS CC)
    (lambda () (dk-cite! 'carrier-is-open 'CC-MS) (subst '(= CC (PTS CC-MS))) (clt-finish-ass!)))
  (let ((iff (dk-cite! 'cc-ms-open-iff 'CC)))
    (dk-have! '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) CC) (lambda () (dk-only! iff '(IS-OPEN CC-MS CC)) (prop)))))

;;; ---------------------------------------------------------------------------

(sp (make-wff "forall([kk], kk subset cc implies is-compact(subspace-ms(cc-ms, kk)) implies forsome([n in nn], forall([z in kk], magnitude(z) <= n)))"))
(let ((kk (cadr (dk-goal))))
  (dk-peel!)
  (clt-cc-open-nf!)
  (let* ((n (dk-skolem! (dk-cite! 'cc-exhaust-exhaustive 'CC kk)))
         (ex (list 'CC-EXHAUST 'CC n)))
    (ew n)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'FORALL)
            (let ((z (car (map cadr (dk-peel!)))))
              (clt-subset-elim! kk ex z)
              (let ((m (dk-cite! 'cc-exhaust-membership 'CC n z)))
                (clt-iff-fwd! m)
                (dk-split-all!)
                (clt-finish-ass!)))
            (clt-finish-ass!))))))
(qed 'cc-compact-bounded)

(sp (make-wff "forall([kk], kk subset cc implies is-compact(subspace-ms(cc-ms, kk)) implies forall([x in cc], not(x in kk) implies forsome([r], pos-rr(r) and forall([y in cc], magnitude(y - x) < r implies not(y in kk)))))"))
(let ((kk (cadr (dk-goal))))
  (let* ((lk (dk-peel!))
         (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC) (symbol? (cadr f)))) lk)))
         (u (list 'DIFFERENCE 'CC (list 'SINGLETON x))))
    (clt-cc-open-nf!)
    (dk-cite! 'cif-open-minus-point 'CC x)
    (dk-cite! 'membership-implies-sethood x 'CC)
    (dk-have! (list 'SUBSET kk u)
      (lambda ()
        (let ((z (subset-by-element!)))
          (clt-subset-elim! kk 'CC z)
          (let ((dm (dk-cite! 'difference-membership 'CC (list 'SINGLETON x) z))
                (sm (dk-cite! 'singleton-membership x z)))
            (dk-have! (list 'NOT (list '= z x))
              (lambda () (di) (dk-have! (list 'IN x kk) (lambda () (subst (list '= x z)) (clt-finish-ass!)))
                         (dk-only! (list 'IN x kk) (list 'NOT (list 'IN x kk))) (prop)))
            (dk-only! dm sm (list 'IN z 'CC) (list 'NOT (list '= z x)))
            (prop)))))
    (let* ((n (dk-skolem! (dk-cite! 'cc-exhaust-exhaustive u kk)))
           (ex (list 'CC-EXHAUST u n))
           (r (list 'recip (list '+ n 1))))
      (dk-cite! 'nn-recip-succ-pos n)
      (ew r)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let* ((lk2 (dk-peel!))
                     (y (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC) (symbol? (cadr f)) (not (eq? (cadr f) x)))) lk2))))
                (di)
                (clt-subset-elim! kk ex y)
                (let ((m (dk-cite! 'cc-exhaust-membership u n y)))
                  (clt-iff-fwd! m)
                  (dk-split-all!))
                (let ((ball (list 'BALL 'CC-MS y r)))
                  ;; x lies in B(y, r): |y - x| < r
                  (fact 'cc-is-metric-space) (fact 'cc-ms@pts)
                  (dk-have! (list 'IN y '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (clt-finish-ass!)))
                  (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (clt-finish-ass!)))
                  (dk-cite! 'rr-pos-rr-in-rr r)
                  (clt-type! (list '- y x))
                  (dk-cite! 'cc-magnitude-closed (list '- y x))
                  (dk-cite! 'cc-ms-dist y x)
                  (dk-have! (list '<= (list '(DIST CC-MS) y x) (list 'magnitude (list '- y x)))
                    (lambda () (subst (list '= (list '(DIST CC-MS) y x) (list 'magnitude (list '- y x)))) (dk-ineq!)))
                  (clt-cite-and! 'ball-mem-from-le
                    (list (list 'IN x '(PTS CC-MS)) (list 'IN (list 'magnitude (list '- y x)) 'RR) (list 'IN r 'RR)
                          (list '<= (list '(DIST CC-MS) y x) (list 'magnitude (list '- y x)))
                          (list '< (list 'magnitude (list '- y x)) r))
                    'CC-MS y x (list 'magnitude (list '- y x)) r)
                  (clt-subset-elim! ball u x)
                  (let ((dm (dk-cite! 'difference-membership 'CC (list 'SINGLETON x) x))
                        (sm (dk-cite! 'singleton-membership x x)))
                    (dk-have! (list '= x x) (lambda () (rfl)))
                    (dk-only! dm sm (list 'IN x u) (list '= x x) (list 'IN x 'SET))
                    (prop))))
              (clt-finish-ass!)))))))
(qed 'cc-compact-separated)

;;; ---------------------------------------------------------------------------
;;; The notes' topology.

(define clt-caseb
  (lambda (u) (list 'FORSOME 'kh_ (list 'AND '(SUBSET kh_ CC)
                                   (list 'AND '(IS-COMPACT (SUBSPACE-MS CC-MS kh_))
                                         (list '= u '(DIFFERENCE CC-HAT kh_)))))))

(sp (make-wff `(FORALL u (IFF (IN u CC-HAT-OPENS)
      (AND (IN u (POWER CC-HAT))
           (OR (AND (SUBSET u CC) (IS-OPEN CC-MS u)) ,(clt-caseb 'u)))))))
(let ((u (dk-di-var! (lambda (g) (cadr (cadr g))))))
  (mac 'cc-hat-opens-def)
  (dk-iff! (lambda (g) (dk-head-is? g 'AND))
    (lambda ()
      (let ((h (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) u) (dk-head-is? (caddr f) 'SEP))) (dk-asms))))
        (sep-me h)
        (dk-conj-close! (lambda () (clt-finish-ass!)))))
    (lambda () (dk-split-all!) (in-sep! (lambda () (clt-finish-ass!))))))
(qed 'cc-hat-opens-membership)

;;; U subset CC-HAT and U a set: U in POWER(CC-HAT)
(define (clt-in-power! u)
  (let ((pm (dk-cite! 'power-set-membership 'CC-HAT u))
        (sd (dk-cite! 'subset-def u 'CC-HAT)))
    (dk-have! (caddr sd) (lambda () (dk-only! sd (list 'SUBSET u 'CC-HAT)) (prop)))
    (dk-have! (list 'IN u '(POWER CC-HAT)) (lambda () (dk-only! pm (list 'IN u 'SET) (caddr sd)) (prop)))))

;;; A Euclidean ball is open in C u {oo}.
(sp (make-wff "forall([x in cc, r], pos-rr(r) implies ball(cc-ms, x, r) in cc-hat-opens)"))
(let* ((vs (dk-peel!))
       (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC))) vs)))
       (r (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) (dk-asms))))
       (b (list 'BALL 'CC-MS x r)))
  (fact 'cc-is-metric-space) (fact 'cc-ms@pts) (fact 'cc-subset-cc-hat)
  (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (clt-finish-ass!)))
  (dk-cite! 'rr-pos-rr-in-rr r)
  (let ((pr (list 'AND (list '<= 0 r) (list 'NOT (list '= 0 r)))))
    (dk-have! pr (lambda () (mac-h 'pos-rr (list 'POS-RR r)) (dk-split-all!) (dk-conj-close! (lambda () (clt-finish-ass!)))))
    (dk-split-all! (list pr)))
  (clt-cite-and! 'ball-is-open (list (list 'IN r 'RR) (list '<= 0 r) (list 'NOT (list '= 0 r))) 'CC-MS x r)
  (dk-cite! 'ball-is-set 'CC-MS x r)
  (dk-have! (list 'SUBSET b 'CC)
    (lambda ()
      (let ((y (subset-by-element!)))
        (let ((bm (dk-cite! 'ball-membership 'CC-MS x r y)))
          (clt-iff-fwd! bm) (dk-split-all!)
          (subst '(= CC (PTS CC-MS))) (clt-finish-ass!)))))
  (dk-have! (list 'SUBSET b 'CC-HAT)
    (lambda ()
      (let ((y (subset-by-element!)))
        (clt-subset-elim! b 'CC y)
        (clt-subset-elim! 'CC 'CC-HAT y)
        (clt-finish-ass!))))
  (clt-in-power! b)
  (let ((m (dk-cite! 'cc-hat-opens-membership b)))
    (dk-only! m (list 'IN b '(POWER CC-HAT)) (list 'SUBSET b 'CC) (list 'IS-OPEN 'CC-MS b))
    (prop)))
(qed 'cc-hat-ball-open)

;;; C u {oo} minus a closed ball is open.
(sp (make-wff "forall([m in rr], difference(cc-hat, closed-ball(cc-ms, 0, m)) in cc-hat-opens)"))
(let* ((m (dk-di-var!))
       (cb (list 'CLOSED-BALL 'CC-MS 0 m))
       (u (list 'DIFFERENCE 'CC-HAT cb)))
  (fact 'cc-zero-in) (fact 'cc-ms@pts) (fact 'cc-hat-in-set)
  (dk-cite! 'cc-closed-ball-compact 0 m)
  (dk-have! (list 'SUBSET cb 'CC)
    (lambda ()
      (let ((y (subset-by-element!)))
        (clt-iff-fwd! (dk-cite! 'closed-ball-membership 'CC-MS 0 m y)) (dk-split-all!)
        (subst '(= CC (PTS CC-MS))) (clt-finish-ass!))))
  (dk-cite! 'difference-set 'CC-HAT cb)
  (dk-have! (list 'SUBSET u 'CC-HAT)
    (lambda ()
      (let ((y (subset-by-element!)))
        (clt-iff-fwd! (dk-cite! 'difference-membership 'CC-HAT cb y)) (dk-split-all!) (clt-finish-ass!))))
  (clt-in-power! u)
  (dk-have! (clt-caseb u)
    (lambda () (ew cb) (dk-conj-close! (lambda () (clt-finish!)))))
  (let ((mm (dk-cite! 'cc-hat-opens-membership u)))
    (dk-only! mm (list 'IN u '(POWER CC-HAT)) (clt-caseb u))
    (prop)))
(qed 'cc-hat-ball-complement-open)

;;; The two cases of an open set, landed: case A conjunction or case B existential (skolemised).
;;; Returns 'a or the compact set kh.
(define (clt-open-cases! u a-body b-body)
  (let* ((m (dk-cite! 'cc-hat-opens-membership u))
         (rhs (clt-iff-fwd! m)))
    (dk-split-all! (list rhs))
    (let ((orf (caddr rhs)))
      (use-cases orf
        (lambda () (dk-split-all! (list (cadr orf))) (a-body))
        (lambda ()
          (let* ((kh (dk-skolem! (caddr orf))))
            (b-body kh)))))))

;;; An open set containing x in C contains the Euclidean ball B(x, r) for some r > 0.
(sp (make-wff "forall([u in cc-hat-opens, x in cc], x in u implies forsome([r], pos-rr(r) and forall([y in cc], magnitude(y - x) < r implies y in u)))"))
(let* ((lk (dk-peel!))
       (u (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC-HAT-OPENS))) lk)))
       (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC))) lk))))
  (fact 'cc-is-metric-space) (fact 'cc-ms@pts) (fact 'cc-subset-cc-hat)
  (clt-open-cases! u
    (lambda ()
      ;; case A: U open in the Euclidean metric
      (let* ((oi (dk-cite! 'is-open 'CC-MS u))
             (rhs (clt-iff-fwd! oi)))
        (dk-split-all! (list rhs))
        (let* ((all (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'BALL) (dk-contains? f u))) (dk-asms)))
               (ex (dk-apply! all x))
               (r (dk-skolem! ex)))
          (ew r)
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'FORALL)
                  (let* ((lk2 (dk-peel!))
                         (y (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC) (not (eq? (cadr f) x)))) lk2))))
                    (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (clt-finish-ass!)))
                    (dk-have! (list 'IN y '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (clt-finish-ass!)))
                    (dk-cite! 'rr-pos-rr-in-rr r)
                    (clt-type! (list '- x y)) (clt-type! (list '- y x))
                    (dk-cite! 'cc-magnitude-closed (list '- y x))
                    (dk-cite! 'cc-magnitude-sub-sym x y)
                    (dk-cite! 'cc-ms-dist x y)
                    (dk-have! (list '<= (list '(DIST CC-MS) x y) (list 'magnitude (list '- y x)))
                      (lambda () (subst (list '= (list '(DIST CC-MS) x y) (list 'magnitude (list '- x y))))
                                 (subst (list '= (list 'magnitude (list '- x y)) (list 'magnitude (list '- y x))))
                                 (dk-ineq!)))
                    (clt-cite-and! 'ball-mem-from-le
                      (list (list 'IN y '(PTS CC-MS)) (list 'IN (list 'magnitude (list '- y x)) 'RR) (list 'IN r 'RR)
                            (list '<= (list '(DIST CC-MS) x y) (list 'magnitude (list '- y x)))
                            (list '< (list 'magnitude (list '- y x)) r))
                      'CC-MS x y (list 'magnitude (list '- y x)) r)
                    (clt-subset-elim! (list 'BALL 'CC-MS x r) u y)
                    (clt-finish-ass!))
                  (clt-finish-ass!)))))))
    (lambda (kh)
      ;; case B: U = C u {oo} minus a compact K, and x is not in K
      (let ((dm (dk-cite! 'difference-membership 'CC-HAT kh x)))
        (dk-have! (list 'IN x (list 'DIFFERENCE 'CC-HAT kh)) (lambda () (subst (list '= (list 'DIFFERENCE 'CC-HAT kh) u)) (clt-finish-ass!)))
        (dk-have! (list 'NOT (list 'IN x kh)) (lambda () (dk-only! dm (list 'IN x (list 'DIFFERENCE 'CC-HAT kh))) (prop)))
        (let* ((sep (dk-cite! 'cc-compact-separated kh x))
               (r (dk-skolem! sep)))
          (ew r)
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'FORALL)
                  (let* ((lk2 (dk-peel!))
                         (y (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC) (not (eq? (cadr f) x)))) lk2)))
                         (all (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f kh) (dk-contains? f r))) (dk-asms))))
                    (dk-apply! all y)
                    (clt-subset-elim! 'CC 'CC-HAT y)
                    (subst (list '= u (list 'DIFFERENCE 'CC-HAT kh)))
                    (let ((dmy (dk-cite! 'difference-membership 'CC-HAT kh y)))
                      (dk-only! dmy (list 'IN y 'CC-HAT) (list 'NOT (list 'IN y kh)))
                      (prop)))
                  (clt-finish-ass!)))))))))
(qed 'cc-hat-nbhd-finite)

;;; An open set containing oo contains {y in C : |y| > M} for some real M.
(sp (make-wff "forall([u in cc-hat-opens], cc-inf in u implies forsome([m in rr], forall([y in cc], m < magnitude(y) implies y in u)))"))
(let* ((lk (dk-peel!))
       (u (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC-HAT-OPENS))) lk))))
  (fact 'cc-subset-cc-hat) (fact 'cc-inf-not-in-cc)
  (clt-open-cases! u
    (lambda ()
      (clt-subset-elim! u 'CC 'CC-INF)
      (dk-only! '(IN CC-INF CC) '(NOT (IN CC-INF CC)))
      (prop))
    (lambda (kh)
      (let* ((n (dk-skolem! (dk-cite! 'cc-compact-bounded kh)))
             (bd (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f kh) (dk-contains? f n))) (dk-asms))))
        (dk-cite! 'nn-in-rr n)
        (ew n)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'FORALL)
                (let* ((lk2 (dk-peel!))
                       (y (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC))) lk2))))
                  (dk-cite! 'cc-magnitude-closed y)
                  (dk-have! (list 'NOT (list 'IN y kh))
                    (lambda ()
                      (di)
                      (dk-apply! bd y)
                      (dk-have! (list '< n n)
                        (lambda () (dk-ineq! (list '<= (list 'magnitude y) n) (list '< n (list 'magnitude y)))))
                      (dk-cite! 'rr-lt-irrefl n)
                      (dk-only! (list '< n n) (list 'NOT (list '< n n)))
                      (prop)))
                  (clt-subset-elim! 'CC 'CC-HAT y)
                  (subst (list '= u (list 'DIFFERENCE 'CC-HAT kh)))
                  (let ((dmy (dk-cite! 'difference-membership 'CC-HAT kh y)))
                    (dk-only! dmy (list 'IN y 'CC-HAT) (list 'NOT (list 'IN y kh)))
                    (prop)))
                (clt-finish-ass!))))))))
(qed 'cc-hat-nbhd-inf)

;;; ---------------------------------------------------------------------------
;;; Lemma 1.16.

(define clt-pts '(PTS CC-HAT-TOP))
(define clt-opens '(OPENS CC-HAT-TOP))

;;; f in FUN(NN, CC) in context: land f(k) in CC for typed k (returns the pointwise universal)
(define (clt-fun-pointwise! f)
  (let* ((iff (dk-cite! 'fun-codomain-iff 'NN 'CC f))
         (rhs (clt-iff-fwd! iff)))
    (dk-split-all! (list rhs))
    (caddr rhs)))

;;; f in FUN(NN, CC) |- f in FUN(NN, CC-HAT)
(define (clt-widen! f)
  (let* ((pw (clt-fun-pointwise! f))
         (iff (dk-cite! 'fun-codomain-iff 'NN 'CC-HAT f))
         (rhs (caddr iff)))
    (fact 'cc-subset-cc-hat)
    (dk-have! (caddr rhs)
      (lambda ()
        (let ((k (car (map cadr (dk-peel!)))))
          (dk-apply! pw k)
          (clt-subset-elim! 'CC 'CC-HAT (list f k))
          (clt-finish-ass!))))
    (dk-have! (list 'IN f '(FUN NN CC-HAT))
      (lambda () (clt-keep-prop! iff (cadr rhs) (caddr rhs))))
    pw))

(define (clt-common! f x)
  (fact 'cc-is-metric-space) (fact 'cc-ms@pts) (fact 'cc-hat-top@pts) (fact 'cc-hat-top@opens)
  (let ((pw (clt-widen! f)))
    (dk-have! (list 'IN f (list 'FUN 'NN clt-pts)) (lambda () (subst (list '= clt-pts 'CC-HAT)) (clt-finish-ass!)))
    (dk-have! (list 'IN f '(FUN NN (PTS CC-MS))) (lambda () (subst '(= (PTS CC-MS) CC)) (clt-finish-ass!)))
    (if x
        (begin
          (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (clt-finish-ass!)))
          (dk-have! (list 'IN x clt-pts) (lambda () (subst (list '= clt-pts 'CC-HAT)) (clt-subset-elim! 'CC 'CC-HAT x) (clt-finish-ass!)))))
    pw))

;;; dist(CC-MS)(a, b) == magnitude(a - b) landed as a strict equation with its value typed
(define (clt-dist! a b)
  (clt-type! (list '- a b))
  (dk-cite! 'cc-magnitude-closed (list '- a b))
  (dk-cite! 'cc-ms-dist a b)
  (let ((d (list '(DIST CC-MS) a b)))
    (dk-have! (list '= d (list 'magnitude (list '- a b)))
      (lambda () (subst (list '= d (list 'magnitude (list '- a b)))) (clt-finish!)))
    (dk-have! (list 'IN d 'RR)
      (lambda () (subst (list '= d (list 'magnitude (list '- a b)))) (clt-finish-ass!)))
    d))

(sp (make-wff "forall([f in fun(nn, cc), x in cc], top-converges-to(cc-hat-top, f, x) iff converges-to(cc-ms, f, x))"))
(let* ((lk (dk-peel!))
       (f (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (dk-head-is? (caddr h) 'FUN))) lk)))
       (x (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'CC))) lk))))
  (let* ((pw (clt-common! f x))
         (tc (dk-cite! 'top-converges-to 'CC-HAT-TOP f x))
         (cv (dk-cite! 'converges-to 'CC-MS f x)))
    (dk-iff! (lambda (g) (dk-head-is? g 'CONVERGES-TO))
      (lambda ()
        ;; topological => metric
        (clt-iff-fwd! tc)
        (dk-split-all!)
        (let ((tq (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'OPENS))) (dk-asms))))
          (dk-have! (caddr cv)
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'FORALL)
                      (let* ((lk2 (dk-peel!))
                             (eps (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) (dk-asms))))
                             (b (list 'BALL 'CC-MS x eps)))
                        (dk-cite! 'cc-hat-ball-open x eps)
                        (dk-have! (list 'IN b clt-opens) (lambda () (subst (list '= clt-opens 'CC-HAT-OPENS)) (clt-finish-ass!)))
                        ;; x in B(x, eps)
                        (dk-cite! 'rr-pos-rr-in-rr eps) (dk-cite! 'rr-lt-of-pos-rr eps)
                        (fact 'rr-zero-in)
                        (let ((dxx (clt-dist! x x)))
                          (fact 'cc-magnitude-zero)
                          (dk-have! (list '<= dxx 0)
                            (lambda () (subst (list '= dxx (list 'magnitude (list '- x x))))
                                       (clt-rewrite! (list '- x x) 0 (lambda () (crs)))
                                       (subst '(= (magnitude 0) 0)) (dk-ineq!))))
                        (clt-cite-and! 'ball-mem-from-le
                          (list (list 'IN x '(PTS CC-MS)) '(IN 0 RR) (list 'IN eps 'RR)
                                (list '<= (list '(DIST CC-MS) x x) 0) (list '< 0 eps))
                          'CC-MS x x 0 eps)
                        (let* ((ex (dk-apply! tq b))
                               (n (dk-skolem! ex))
                               (ev (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h n) (dk-contains? h b))) (dk-asms))))
                          (ew n)
                          (dk-conj-close!
                            (lambda ()
                              (if (dk-head-is? (dk-goal) 'FORALL)
                                  (let* ((lk3 (dk-peel!))
                                         (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN) (not (eq? (cadr h) n)))) lk3))))
                                    (dk-apply! ev k)
                                    (dk-apply! pw k)
                                    (clt-iff-fwd! (dk-cite! 'ball-membership 'CC-MS x eps (list f k)))
                                    (dk-split-all!)
                                    (let ((d1 (clt-dist! x (list f k)))
                                          (d2 (clt-dist! (list f k) x)))
                                      (dk-cite! 'cc-magnitude-sub-sym x (list f k))
                                      (dk-ineq! (list '<= d1 eps) (list '= d1 (list 'magnitude (list '- x (list f k))))
                                                (list '= d2 (list 'magnitude (list '- (list f k) x)))
                                                (list '= (list 'magnitude (list '- x (list f k))) (list 'magnitude (list '- (list f k) x))))))
                                  (clt-finish-ass!))))))
                      (clt-finish-ass!))))))
          (dk-only! cv (caddr cv))
          (prop)))
      (lambda ()
        ;; metric => topological
        (clt-iff-fwd! cv)
        (dk-split-all!)
        (let ((mq (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'POS-RR))) (dk-asms))))
          (dk-have! (caddr tc)
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'FORALL)
                      (let* ((lk2 (dk-peel!))
                             (u (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) clt-opens))) lk2))))
                        (dk-have! (list 'IN u 'CC-HAT-OPENS) (lambda () (subst (list '= 'CC-HAT-OPENS clt-opens)) (clt-finish-ass!)))
                        (let* ((r (dk-skolem! (dk-cite! 'cc-hat-nbhd-finite u x)))
                               (rt (dk-cite! 'rr-pos-rr-in-rr r))
                               (nb (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h r) (dk-contains? h u))) (dk-asms)))
                               (d (dk-halve! r))
                               (ex (dk-apply! mq d))
                               (n (dk-skolem! ex))
                               (ev (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h n) (dk-contains? h d))) (dk-asms))))
                          (ew n)
                          (dk-conj-close!
                            (lambda ()
                              (if (dk-head-is? (dk-goal) 'FORALL)
                                  (let* ((lk3 (dk-peel!))
                                         (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN) (not (eq? (cadr h) n)))) lk3))))
                                    (dk-apply! ev k)
                                    (dk-apply! pw k)
                                    (let ((d2 (clt-dist! (list f k) x)))
                                      (dk-have! (list '< (list 'magnitude (list '- (list f k) x)) r)
                                        (lambda () (dk-ineq! (list '<= d2 d) (list '= d2 (list 'magnitude (list '- (list f k) x)))
                                                             (list '= (list '+ d d) r) (list '< 0 d)))))
                                    (dk-apply! nb (list f k))
                                    (clt-finish-ass!))
                                  (clt-finish-ass!))))))
                      (clt-finish-ass!))))))
          (dk-only! tc (caddr tc))
          (prop))))))
(qed 'cc-hat-converges-iff)

(sp (make-wff "forall([f in fun(nn, cc)], top-converges-to(cc-hat-top, f, cc-inf) iff forall([m in rr], forsome([n in nn], forall([k in nn], n <= k implies m <= magnitude(f(k))))))"))
(let* ((lk (dk-peel!))
       (f (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (dk-head-is? (caddr h) 'FUN))) lk))))
  (let* ((pw (clt-common! f #f))
         (tc (dk-cite! 'top-converges-to 'CC-HAT-TOP f 'CC-INF)))
    (fact 'cc-inf-in-cc-hat) (fact 'cc-inf-not-in-cc) (fact 'cc-zero-in)
    (dk-have! (list 'IN 'CC-INF clt-pts) (lambda () (subst (list '= clt-pts 'CC-HAT)) (clt-finish-ass!)))
    (dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
      (lambda ()
        ;; topological => |f(k)| -> +oo
        (clt-iff-fwd! tc)
        (dk-split-all!)
        (let ((tq (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'OPENS))) (dk-asms))))
          (let* ((m (car (map cadr (dk-peel!))))
                 (cb (list 'CLOSED-BALL 'CC-MS 0 m))
                 (u (list 'DIFFERENCE 'CC-HAT cb)))
            (dk-cite! 'cc-hat-ball-complement-open m)
            (dk-have! (list 'IN u clt-opens) (lambda () (subst (list '= clt-opens 'CC-HAT-OPENS)) (clt-finish-ass!)))
            (let ((dm (dk-cite! 'difference-membership 'CC-HAT cb 'CC-INF))
                  (cm (dk-cite! 'closed-ball-membership 'CC-MS 0 m 'CC-INF)))
              (fact 'cc-ms@pts)
              (dk-have! '(NOT (IN CC-INF (PTS CC-MS))) (lambda () (subst '(= (PTS CC-MS) CC)) (clt-finish-ass!)))
              (dk-have! (list 'IN 'CC-INF u)
                (lambda () (clt-keep-prop! dm cm '(IN CC-INF CC-HAT) '(NOT (IN CC-INF (PTS CC-MS)))))))
            (let* ((ex (dk-apply! tq u))
                   (n (dk-skolem! ex))
                   (ev (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h n) (dk-contains? h u))) (dk-asms))))
              (ew n)
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'FORALL)
                      (let* ((lk3 (dk-peel!))
                             (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN) (not (eq? (cadr h) n)))) lk3)))
                             (fk (list f k)))
                        (dk-apply! ev k)
                        (dk-apply! pw k)
                        (let ((dm2 (dk-cite! 'difference-membership 'CC-HAT cb fk))
                              (cm2 (dk-cite! 'closed-ball-membership 'CC-MS 0 m fk)))
                          (dk-have! (list 'IN fk '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (clt-finish-ass!)))
                          (let ((d0 (clt-dist! 0 fk)))
                            (dk-have! (list 'NOT (list '<= d0 m))
                              (lambda () (clt-keep-prop! dm2 cm2 (list 'IN fk u) (list 'IN fk '(PTS CC-MS)))))
                            (dk-have! (list '= (list 'magnitude (list '- 0 fk)) (list 'magnitude fk))
                              (lambda () (clt-rewrite! (list '- 0 fk) (list '- fk) (lambda () (crs)))
                                         (subst (dk-cite! 'cc-magnitude-neg fk)) (clt-finish!)))
                            (dk-cite! 'cc-magnitude-closed fk)
                            ;; not(d0 <= m) gives m < d0 by trichotomy
                            (fact 'rr-zero-in)
                            (let ((tri (dk-cite! 'rr-lt-trichotomy m d0)))
                              (use-cases tri
                                (lambda () (dk-ineq! (list '< m d0) (list '= d0 (list 'magnitude (list '- 0 fk)))
                                                     (list '= (list 'magnitude (list '- 0 fk)) (list 'magnitude fk))))
                                (lambda ()
                                  (dk-have! (list '<= d0 m) (lambda () (dk-ineq! (list '= m d0))))
                                  (clt-keep-prop! (list '<= d0 m) (list 'NOT (list '<= d0 m))))
                                (lambda ()
                                  (dk-have! (list '<= d0 m) (lambda () (dk-ineq! (list '< d0 m))))
                                  (clt-keep-prop! (list '<= d0 m) (list 'NOT (list '<= d0 m)))))))))
                      (clt-finish-ass!))))))))
      (lambda ()
        ;; |f(k)| -> +oo => topological
        (let ((mq (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'magnitude))) (dk-asms))))
          (dk-have! (caddr tc)
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'FORALL)
                      (let* ((lk2 (dk-peel!))
                             (u (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) clt-opens))) lk2))))
                        (dk-have! (list 'IN u 'CC-HAT-OPENS) (lambda () (subst (list '= 'CC-HAT-OPENS clt-opens)) (clt-finish-ass!)))
                        (let* ((m (dk-skolem! (dk-cite! 'cc-hat-nbhd-inf u)))
                               (nb (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m) (dk-contains? h u))) (dk-asms)))
                               (m1 (list '+ m 1)))
                          (clt-real! m1)
                          (let* ((ex (dk-apply! mq m1))
                                 (n (dk-skolem! ex))
                                 (ev (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h n) (dk-contains? h m1))) (dk-asms))))
                            (ew n)
                            (dk-conj-close!
                              (lambda ()
                                (if (dk-head-is? (dk-goal) 'FORALL)
                                    (let* ((lk3 (dk-peel!))
                                           (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN) (not (eq? (cadr h) n)))) lk3)))
                                           (fk (list f k)))
                                      (dk-apply! ev k)
                                      (dk-apply! pw k)
                                      (dk-cite! 'cc-magnitude-closed fk)
                                      (dk-have! (list '< m (list 'magnitude fk))
                                        (lambda () (dk-ineq! (list '<= m1 (list 'magnitude fk)))))
                                      (dk-apply! nb fk)
                                      (clt-finish-ass!))
                                    (clt-finish-ass!)))))))
                      (clt-finish-ass!))))))
          (clt-keep-prop! tc (caddr tc)))))))
(qed 'cc-hat-converges-inf-iff)
