;; a ring identity in KF's MUL of atoms A, B typed in CARR KF: (MUL a b) = (MUL b a)
(define (c6f-mul-comm! kf a b)
  (let ((eq `(= ((MUL ,kf) ,a ,b) ((MUL ,kf) ,b ,a))) (v `(NORMED-FIELD-AS-COMMUTATIVE-RING ,kf)))
    (if (not (dk-asm? eq))
