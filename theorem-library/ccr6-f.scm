;; equality in K by separation: run PTWISE (a procedure of b, goal (= (wk L b) (wk R b))) and conclude L = R
(define (c6f-by-inj! l r ptwise)
  (let ((ch (dk-cite! 'c6f-wk-inj 'kf 'wk l r)))
    (if (and (pair? ch) (eq? (car ch) 'IMPLIES))
        (begin
          (dk-have! (cadr ch) (lambda () (let ((b (dk-di-var!))) (ptwise b))))
          (detach! ch)))
    (dk-close-if-asm!)))

