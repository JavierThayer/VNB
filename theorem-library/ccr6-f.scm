(sp (make-wff `(FORALL kf (IMPLIES (IS-NV-FIELD kf) (FORALL wk (IMPLIES (IS-UNIPOLAR kf wk)
  (FORALL n (IMPLIES (IN n NN) (FORALL c6fm_
    (IMPLIES (FORALL i (IMPLIES (IN i ,c6f-I) (FORALL j (IMPLIES (IN j ,c6f-I) (IN (ENTRY c6fm_ i j) ,c6f-Z)))))
      (FORALL y (IMPLIES (FORALL z (IMPLIES (IN z ,c6f-I) (IN (y z) ,c6f-Z)))
        (FORALL x (IMPLIES (FORALL z (IMPLIES (IN z ,c6f-I) (IN (x z) ,c6f-Z)))
          (= ,(c6f-W 'c6fm_) 1)))))))))))))))
(dk-peel!)
(c6f-cm!)
(dk-cite! 'nv-field-normed 'kf)
(dk-cite! 'nv-integers-domain 'kf)
(dk-project! `(= (BICHAR-POLAR kf wk ,c6f-Z) ,c6f-Z) 'is-unipolar '(IS-UNIPOLAR kf wk))
(dk-cite! 'interval-in-set 1 'n) (dk-cite! 'interval-card-in-nn 1 'n)
(let* ((ivl c6f-I) (zset c6f-Z) (gl (dk-goal)) (wbig (cadr gl)) (gbig (caddr wbig)) (mA (cadr (cadr (cadr (cadddr (caddr (cadddr gbig)))))))
       (hA (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ENTRY))) "entries integral"))
       (pk (lambda (fn) (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(,fn z)))) "a typing")))
       (hy (pk 'y)) (hx (pk 'x))
       (to-one! (lambda () (subst `(= (IDEN ,c6f-cm) (ONE ,c6f-ccv))) (subst `(== (ONE ,c6f-ccv) 1)))))
  (dk-have! `(FORALL z (IMPLIES (IN z ,ivl) (= (,gbig z) (IDEN ,c6f-cm))))
    (lambda ()
      (let ((i (dk-di-var!)))
        (dk-lam-b!)
        (let* ((g1 (caddr (cadr (dk-goal)))))
          (dk-have! `(FORALL c6fz_ (IMPLIES (IN c6fz_ ,ivl) (= (,g1 c6fz_) (IDEN ,c6f-cm))))
            (lambda ()
              (let* ((j (dk-di-var!)) (a `(ENTRY ,mA ,i ,j)) (ay `((MUL kf) ,a (y ,i))))
                (dk-apply! hA i j) (dk-apply! hy i) (dk-apply! hx j)
                (dk-cite! 'nv-domain-mul 'kf zset a `(y ,i))
                (dk-have! `(IN ,ay (BICHAR-POLAR kf wk ,zset))
                  (lambda () (subst `(= (BICHAR-POLAR kf wk ,zset) ,zset)) (dk-ass!)))
                (let ((iff (dk-cite! 'c5-polar-mem 'kf 'wk zset ay)))
                  (ai iff) (detach! `(IMPLIES ,(cadr iff) ,(caddr iff))) (dk-split-all!))
                (let ((pol (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ay) (dk-contains? f 'wk))) "the polar law")))
                  (dk-apply! pol `(x ,j)))
                (dk-lam-b!)
                (to-one!)
                (dk-close-if-asm!))))
          (dk-cite! 'finsum-cm-all-iden-ptwise c6f-cm ivl g1)
          (dk-close-if-asm!)))))
  (dk-cite! 'finsum-cm-all-iden-ptwise c6f-cm ivl gbig)
  (subst `(= ,wbig (IDEN ,c6f-cm)))
  (to-one!)
  (rfl))
(c6f-dump!)
(qed 'ccr-6-28-ball)

;;; =======================================================================
;;; 6. A FINITE PRODUCT OF CONTINUOUS CHARACTERS IS A CONTINUOUS CHARACTER: for characters chs(1), ..., chs(n)
;;;    of K+, h |-> prod_k chs(k)(h) (the product in the multiplicative monoid of CC) is a character of K+.
;;;    Induction on n: ch-trivial-character at 0, ch-product-character at each step.

;; (= ((MUL ccv) x y) (* x y)), x, y typed in CC (D3's c6-mul-eq!)
(define (c6f-mul-eq! x y)
  (let ((eq `(= ((MUL ,c6f-ccv) ,x ,y) (* ,x ,y))))
    (if (not (dk-asm? eq))
        (dk-have! eq
          (lambda ()
            (let* ((w1 (if (pair? x) (dk-name! x 'CC) x))
                   (w2 (cond ((equal? x y) w1) ((pair? y) (dk-name! y 'CC)) (#t y))))
              (if (and (pair? y) (not (equal? x y))) (subst (list '= y w2)))
              (if (pair? x) (subst (list '= x w1)))
              (subst (dk-cite! 'cc-scalar-ring-mul))
              (if (not (dk-lam-b!)) (rfl))))))
    eq))
;; with IS-ADD-CHARACTER KF CH in context and H in CARR KF: land (IN (CH H) CC)
(define (c6f-char-cc! kf ch h)
  (let ((t `(IN (,ch ,h) CC)))
    (if (not (dk-asm? t))
        (begin
          (dk-project! `(IN ,ch (FUN (CARR ,kf) UNIT-CIRCLE)) 'is-add-character `(IS-ADD-CHARACTER ,kf ,ch))
          (dk-cite! 'fun-apply-type-c ch `(CARR ,kf) 'UNIT-CIRCLE h)
          (c6f-uc-cc! `(,ch ,h))))
    t))
(define (c6f-L kf chs m)
  `(VNB-LAMBDA c6fh_ (CARR ,kf) (FINSUM ,c6f-cm (VNB-LAMBDA c6fk_ (INTERVAL 1 ,m) ((,chs c6fk_) c6fh_)) (INTERVAL 1 ,m))))
(define (c6f-to-one!) (subst `(= (IDEN ,c6f-cm) (ONE ,c6f-ccv))) (subst `(== (ONE ,c6f-ccv) 1)))
;; (IN (FINSUM cm (VNB-LAMBDA c6fk_ D ((chs c6fk_) h)) S) CC), D a superset of S = INTERVAL(1, m); WIDEN! proves
;; (IN z D) from (IN z S)
(define (c6f-fs-cc! kf chs h fs m widen! hyp)
  (let* ((g (caddr fs)) (S (cadddr fs)))
    (dk-cite! 'interval-in-set 1 m) (dk-cite! 'interval-card-in-nn 1 m)
    (dk-have! `(FORALL c6fz_ (IMPLIES (IN c6fz_ ,S) (IN (,g c6fz_) (CARR ,c6f-cm))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (widen! z)
          (if (not (dk-asm? `(IS-ADD-CHARACTER ,kf (,chs ,z)))) (dk-apply! hyp z))
          (dk-lam-b!)
          (if (not (proof-done? *ps*))
              (begin
                (c6f-char-cc! kf `(,chs ,z) h)
                (subst `(= (CARR ,c6f-cm) CC))
                (dk-close-if-asm!))))))
    (dk-cite! 'finsum-comm-monoid-type-ptwise c6f-cm S g)
    (dk-rewrite-h! `(IN ,fs (CARR ,c6f-cm)) `(CARR ,c6f-cm) 'CC)))

(sp (make-wff `(FORALL n (IMPLIES (IN n NN) (FORALL kf (IMPLIES (IS-NORMED-FIELD kf) (FORALL chs
  (IMPLIES (FORALL k (IMPLIES (IN k (INTERVAL 1 n)) (IS-ADD-CHARACTER kf (chs k))))
    (IS-ADD-CHARACTER kf ,(c6f-L 'kf 'chs 'n))))))))))
(define c6f-cases (dk-ni-fixed!))
;; base
(dk-focus! (cdr (assq 'base c6f-cases)))
(c6f-cm!)
(dk-peel!)
(let* ((gl (dk-goal)) (kf (cadr gl)) (L0 (caddr gl)) (ck `(CARR ,kf))
       (chs (car (car (cadddr (caddr (cadddr L0))))))
       (lt `(VNB-LAMBDA chx_ ,ck 1))
       (fs0! (lambda ()                 ; the goal holds FINSUM cm g EMPTY-SET: rewrite it to 1
               (subst (dk-cite! 'interval-1-0-empty))
               (let* ((g (dk-goal))
                      (fs (let find ((t g)) (cond ((and (pair? t) (eq? (car t) 'FINSUM)) t)
                                                  ((pair? t) (or (find (car t)) (find (cdr t))))
                                                  (#t #f)))))
                 (subst (dk-cite! 'finsum-empty c6f-cm (caddr fs)))
                 (c6f-to-one!)))))
  (dk-project! `(IN ,ck SET) 'is-normed-field `(IS-NORMED-FIELD ,kf))
  (dk-fun-ext! L0 lt ck 'CC
    (lambda ()
      (dk-lam-type!
        (lambda () (dk-peel!) (fs0!) (dk-cite! 'cc-one-in) (dk-close-if-asm!))
        (lambda () (dk-close-if-asm!))))
    (lambda ()
      (dk-lam-type!
        (lambda () (dk-peel!) (dk-close-if-asm!))
        (lambda () (dk-close-if-asm!))))
    (lambda (h) (dk-lam-b!) (if (not (proof-done? *ps*)) (begin (fs0!) (rfl)))))
  (subst `(= ,L0 ,lt))
  (dk-cite! 'ch-trivial-character kf)
  (dk-close-if-asm!))
;; step
(dk-focus! (cdr (assq 'step c6f-cases)))
(c6f-cm!)
(let* ((n (dk-di-var!)) (ih (cadr (dk-goal))))
  (di)
  (dk-peel!)
  (let* ((gl (dk-goal)) (kf (cadr gl)) (Ls (caddr gl)) (ck `(CARR ,kf))
         (chs (car (car (cadddr (caddr (cadddr Ls))))))
         (sn `(succ ,n)) (In `(INTERVAL 1 ,n)) (Is `(INTERVAL 1 ,sn)) (U `(UNION ,In (PAIR ,sn ,sn)))
         (Ln (c6f-L kf chs n))
         (hk (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x Is) (dk-contains? x 'IS-ADD-CHARACTER))) "the characters")))
    (dk-project! `(IN ,ck SET) 'is-normed-field `(IS-NORMED-FIELD ,kf))
    (dk-cite! 'nn-succ-closed n)
    (dk-cite! 'nn-le-succ n)
    (dk-have! `(FORALL k (IMPLIES (IN k ,In) (IS-ADD-CHARACTER ,kf (,chs k))))
      (lambda () (let ((z (dk-di-var!))) (dk-cite! 'interval-widen n sn 1 z) (dk-apply! hk z) (dk-close-if-asm!))))
    (let loop ((h ih))
      (if (dk-head-is? h 'IMPLIES)
          (begin (if (not (dk-asm? (caddr h))) (detach! h)) (loop (caddr h)))))
    (dk-cite! 'interval-in-set 1 n) (dk-cite! 'interval-card-in-nn 1 n)
    (dk-cite! 'interval-in-set 1 sn) (dk-cite! 'interval-card-in-nn 1 sn)
    (dk-cite! 'membership-implies-sethood sn 'NN)
    (dk-cite! 'nn-in-rr n) (dk-cite! 'nn-in-rr sn)
    (dk-have! `(NOT (IN ,sn ,In))
      (lambda ()
        (di)
        (dk-cite! 'interval-hi 1 n sn)
        (dk-have! `(< ,n ,sn) (lambda () (dk-nn!)))
        (dk-absurd! `(< ,n ,sn) `(<= ,sn ,n) `(IN ,n RR) `(IN ,sn RR))))
    (dk-have! `(<= 1 ,sn) (lambda () (dk-nn!)))
    (dk-have! `(<= ,sn ,sn) (lambda () (dk-nn!)))
    (dk-cite! 'interval-mem-intro 1 sn sn)
    (dk-apply! hk sn)
    (let* ((pr (dk-cite! 'ch-product-character kf Ln `(,chs ,sn)))
           (P (caddr pr))
           (widen-s! (lambda (z) (if (not (dk-asm? `(IN ,z ,Is))) (dk-cite! 'interval-widen n sn 1 z)))))
      (dk-fun-ext! Ls P ck 'CC
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let ((h (dk-di-var!)))
                (c6f-fs-cc! kf chs h (cadr (dk-goal)) sn (lambda (z) #t) hk)
                (dk-close-if-asm!)))
            (lambda () (dk-close-if-asm!))))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let ((h (dk-di-var!)))
                (c6f-char-cc! kf Ln h) (c6f-char-cc! kf `(,chs ,sn) h)
                (let ((a `(,Ln ,h)) (b `((,chs ,sn) ,h)))
                  (dk-have! `(AND (IN ,a CC) (IN ,b CC)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                  (dk-cite! 'cc-mul-closed a b)
                  (dk-close-if-asm!))))
            (lambda () (dk-close-if-asm!))))
        (lambda (h)
          (dk-lam-b!)
          (let* ((g (dk-goal)) (fss (cadr g)) (gs (caddr fss)) (fsn (cadr (caddr g))) (gn (caddr fsn)))
            ;; the summands over U are in the monoid
            (dk-cite! 'interval-succ-insert n)
            (dk-have! `(FORALL c6fz_ (IMPLIES (IN c6fz_ ,U) (IN (,gs c6fz_) (CARR ,c6f-cm))))
              (lambda ()
                (let ((z (dk-di-var!)))
                  (dk-rewrite-h! `(IN ,z ,U) U Is)
                  (dk-apply! hk z)
                  (dk-lam-b!)
                  (if (not (proof-done? *ps*))
                      (begin (c6f-char-cc! kf `(,chs ,z) h) (subst `(= (CARR ,c6f-cm) CC)) (dk-close-if-asm!))))))
            (let* ((e (dk-cite! 'finsum-cm-insert-ptwise c6f-cm In sn gs))
                   (e2 (dk-rewrite-h! e U Is)))
              ;; FINSUM gs In == FINSUM gn In
              (dk-have! `(FORALL c6fz_ (IMPLIES (IN c6fz_ ,In) (= (,gs c6fz_) (,gn c6fz_))))
                (lambda ()
                  (let ((z (dk-di-var!)))
                    (widen-s! z)
                    (dk-apply! hk z)
                    (c6f-char-cc! kf `(,chs ,z) h)
                    (dk-lam-b!)
                    (if (not (proof-done? *ps*)) (rfl)))))
              (dk-cite! 'finsum-cm-congruence-q c6f-cm In gs gn)
              (c6f-fs-cc! kf chs h fsn n widen-s! hk)
              (c6f-char-cc! kf `(,chs ,sn) h)
              (subst e2)
              (subst `(= (FINSUM ,c6f-cm ,gs ,In) ,fsn))
              (dk-lam-b!)
              (if (not (proof-done? *ps*))
                  (begin
                    (subst `(= (OPR ,c6f-cm) (MUL ,c6f-ccv)))
                    (let ((eq `(= ((MUL ,c6f-ccv) ,fsn ((,chs ,sn) ,h)) (* ,fsn ((,chs ,sn) ,h)))))
                      (if (alpha-equiv? (dk-goal) eq)
                          (c6f-mul-eq! fsn `((,chs ,sn) ,h))      ; proved in place
                          (begin (subst (c6f-mul-eq! fsn `((,chs ,sn) ,h))) (rfl))))))))))
      (subst `(= ,Ls ,P))
      (dk-close-if-asm!))))
(c6f-dump!)
(qed 'c6f-char-finprod)
