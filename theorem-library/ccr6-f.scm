;; (c6f-app2-type! F A B [D1 D2 COD]) -- land (IN (F A B) COD) from F in FUN(CARTESIAN(D1, D2), COD), A in D1,
;; B in D2.  Without D1 D2 COD the FUN typing of F is read off the context.  Errors, naming it, when an argument
;; is not typed.  When the claim is the focus goal it is proved in place and #t is returned (no `dk-have!', whose
;; in-place proof leaves the caller's next closer to drift); otherwise the claim is returned.
(define (c6f-app2-type! f a b . typ)
  (let* ((ty (if (pair? typ) typ
                 (let ((h (dk-pick (lambda (x) (and (dk-head-is? x 'IN) (equal? (cadr x) f)
                                                     (pair? (caddr x)) (eq? (car (caddr x)) 'FUN)
                                                     (pair? (cdr (caddr x))) (pair? (cadr (caddr x)))
                                                     (eq? (car (cadr (caddr x))) 'CARTESIAN)))
                                   "dk-app2-type!: the typing F in FUN(CARTESIAN(A, B), C)")))
                   (list (cadr (cadr (caddr h))) (caddr (cadr (caddr h))) (caddr (caddr h))))))
         (d1 (car ty)) (d2 (cadr ty)) (cod (caddr ty))
         (g `(IN (,f ,a ,b) ,cod))
         (steps (lambda ()
                  (dk-cite! 'pair-in-cartesian d1 d2 a b)
                  (dk-cite! 'fun-apply-type-c f `(CARTESIAN ,d1 ,d2) cod `(LIST ,a ,b))
                  (subst (dk-cite! 'apply-tupling-2 f a b))
                  (dk-ass!))))
    (cond ((dk-asm? g) g)
          (#t
           (if (not (dk-asm? `(IN ,a ,d1)))
               (error "dk-app2-type!: TYPE THE ARGUMENT FIRST:" (expression->string `(IN ,a ,d1))))
           (if (not (dk-asm? `(IN ,b ,d2)))
               (error "dk-app2-type!: TYPE THE ARGUMENT FIRST:" (expression->string `(IN ,b ,d2))))
           (if (alpha-equiv? (dk-goal) g)
               (begin (steps) #t)
               (begin (dk-have! g steps) g))))))

