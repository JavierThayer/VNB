;;; ch4a-coef.scm -- WAVE 2 (2026-10-27..30), wired 2026-10-30 from scratchpad/ch4a/ch4a-coef.scm.
;;; Library: complex-analysis.

;;; ch4a-coef.scm -- Proposition 4.2 (CH4-A, 2026-10-29): the Laurent coefficients by a circle integral.
;;; Prefix lc-.  Library: complex-analysis.

;;; (1) a complex series whose terms vanish except at one index n converges to its n-th term
   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define lc-tz '(FORALL lcj_ (IMPLIES (IN lcj_ NN) (IMPLIES (NOT (= lcj_ lcn_)) (= (lct_ lcj_) 0)))))
(define (lc-ps k) (list 'CC-SERIES-PARTIAL-SUM 'lct_ k))
(define (lc-step-facts! k)        ; k in NN: the partial sum and the term at k typed, the succ law landed
  (fact 'cc-series-partial-sum-in-cc k 'lct_)
  (fact 'fun-apply-type-c 'lct_ 'NN 'CC k)
  (fact 'nn-succ-closed k)
  (dk-fact! 'cc-series-partial-sum-succ 'lct_ k))
;; (1a) before n: S(t, k) = 0 for k <= n
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
  (list 'FORALL 'lct_ (list 'IMPLIES '(IN lct_ (FUN NN CC)) (list 'FORALL 'lcn_ (list 'IMPLIES '(IN lcn_ NN)
    (list 'IMPLIES lc-tz (list 'IMPLIES '(<= k lcn_) (list '= (lc-ps 'k) 0)))))))))))
(define lc-a (use-induction))
(dk-focus! (cdr (assq 'base lc-a)))
(dk-peel!)
(subst (dk-fact! 'cc-series-partial-sum-zero 'lct_))
(fact 'cc-zero-in)
(rfl)
(dk-focus! (cdr (assq 'step lc-a)))
(let ((k (cdr (assq 'var lc-a))) (ih (cdr (assq 'ih lc-a))))
  (dk-peel!)
  (dk-have! (list '< k 'lcn_) (lambda () (dk-nn!)))
  (dk-have! (list '<= k 'lcn_) (lambda () (dk-nn!)))
  (fact 'nn-in-rr k) (fact 'nn-in-rr 'lcn_)
  (dk-have! (list 'NOT (list '= k 'lcn_)) (lambda () (di) (dk-absurd! (list 'IN k 'RR) '(IN lcn_ RR) (list '< k 'lcn_) (list '= k 'lcn_))))
  (dk-apply! ih 'lct_ 'lcn_)
  (dk-apply! (dk-ctx-form lc-tz) k)
  (lc-step-facts! k)
  (subst (list '== (lc-ps (list 'succ k)) (list '+ (lc-ps k) (list 'lct_ k))))
  (subst (list '= (lc-ps k) 0))
  (subst (list '= (list 'lct_ k) 0))
  (crs))
(qed 'lc-partial-sum-before)
;; (1b) after n: S(t, m) = t(n) for n < m
(sp (make-wff (list 'FORALL 'm (list 'IMPLIES '(IN m NN)
  (list 'FORALL 'lct_ (list 'IMPLIES '(IN lct_ (FUN NN CC)) (list 'FORALL 'lcn_ (list 'IMPLIES '(IN lcn_ NN)
    (list 'IMPLIES lc-tz (list 'IMPLIES '(< lcn_ m) (list '= (lc-ps 'm) '(lct_ lcn_))))))))))))
(define lc-ind (use-induction))
(dk-focus! (cdr (assq 'base lc-ind)))
(dk-peel!)
(fact 'nn-zero-le 'lcn_) (fact 'nn-in-rr 'lcn_)
(dk-absurd! '(IN lcn_ RR) '(< lcn_ 0) '(<= 0 lcn_))
(dk-focus! (cdr (assq 'step lc-ind)))
(let ((m (cdr (assq 'var lc-ind))) (ih (cdr (assq 'ih lc-ind))))
  (dk-peel!)
  (lc-step-facts! m)
  (fact 'fun-apply-type-c 'lct_ 'NN 'CC 'lcn_)
  (subst (list '== (lc-ps (list 'succ m)) (list '+ (lc-ps m) (list 'lct_ m))))
  (use-em (list '= m 'lcn_)
    (lambda ()
      (fact 'nn-in-rr 'lcn_) (dk-have! '(<= lcn_ lcn_) (lambda () (dk-ineq! '(IN lcn_ RR))))
      (dk-have! (list '= (lc-ps m) 0)
        (lambda () (subst (list '= m 'lcn_)) (dk-apply! (dk-cite! 'lc-partial-sum-before 'lcn_) 'lct_ 'lcn_) (ass)))
      (subst (list '= (lc-ps m) 0))
      (subst (list '= m 'lcn_))
      (crs))
    (lambda ()
      (fact 'nn-succ-closed m)
      (fact 'nn-lt-succ-le 'lcn_ (list 'succ m))
      (dk-have! (list '<= 'lcn_ m) (lambda () (dk-nn!)))
      (fact 'nn-in-rr m) (fact 'nn-in-rr 'lcn_)
      (dk-have! (list 'NOT (list '= 'lcn_ m)) (lambda () (di) (dk-have! (list '= m 'lcn_) (lambda () (subst (list '= 'lcn_ m)) (rfl))) (ai (list 'NOT (list '= m 'lcn_)))))
      (dk-have! (list 'AND (list '<= 'lcn_ m) (list 'NOT (list '= 'lcn_ m))))
      (fact 'rr-le-ne-lt 'lcn_ m)
      (dk-apply! ih 'lct_ 'lcn_)
      (dk-apply! (dk-ctx-form lc-tz) m)
      (subst (list '= (lc-ps m) '(lct_ lcn_)))
      (subst (list '= (list 'lct_ m) 0))
      (crs))))
(qed 'lc-partial-sum-after)
;; (1c) the series converges to t(n)
(sp (make-wff (list 'FORALL 'lct_ (list 'IMPLIES '(IN lct_ (FUN NN CC)) (list 'FORALL 'lcn_ (list 'IMPLIES '(IN lcn_ NN)
  (list 'IMPLIES lc-tz '(CC-SERIES-CONVERGES-TO lct_ (lct_ lcn_)))))))))
(dk-peel!)
(fact 'fun-apply-type-c 'lct_ 'NN 'CC 'lcn_)
(fact 'cc-is-metric-space)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(mac 'cc-series-converges-to)
(define lc-P '(VNB-LAMBDA k NN (CC-SERIES-PARTIAL-SUM lct_ k)))
(mac 'converges-to)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-head-is? g 'IS-METRIC-SPACE) (ass))
        ((and (dk-head-is? g 'IN) (equal? (cadr g) lc-P))
         (subst '(== (PTS CC-MS) CC))
         (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (fact 'cc-series-partial-sum-in-cc k 'lct_) (if (pair? (dk-open-leaves)) (ass))))))
        ((dk-head-is? g 'IN) (subst '(== (PTS CC-MS) CC)) (ass))
        (#t
         (dk-peel!)
         (fact 'nn-succ-closed 'lcn_)
         (ew '(succ lcn_))
         (dk-conj-close!
           (lambda ()
             (if (dk-head-is? (dk-goal) 'IN) (ass)
                 (let* ((pl (dk-peel!)) (k (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) pl)))))
                   (dk-have! (list '< 'lcn_ k) (lambda () (dk-nn!)))
                   (dk-apply! (dk-cite! 'lc-partial-sum-after k) 'lct_ 'lcn_)
                   (fact 'cc-series-partial-sum-in-cc k 'lct_)
                   (dk-lam-b!)
                   (subst (list '= (lc-ps k) '(lct_ lcn_)))
                   (dk-cite! 'cc-ms-dist '(lct_ lcn_) '(lct_ lcn_))
                   (subst (list '== (list '(DIST CC-MS) '(lct_ lcn_) '(lct_ lcn_)) '(magnitude (- (lct_ lcn_) (lct_ lcn_)))))
                   (dk-have! '(= (- (lct_ lcn_) (lct_ lcn_)) 0) (lambda () (crs)))
                   (subst '(= (- (lct_ lcn_) (lct_ lcn_)) 0))
                   (fact 'cc-magnitude-zero)
                   (subst '(= (magnitude 0) 0))
                   (fact 'rr-pos-rr-in-rr 'eps) (fact 'rr-lt-of-pos-rr 'eps)
                   (dk-ineq! '(IN eps RR) '(< 0 eps)))))))))))
(qed 'cc-series-single-term)

;;; (2) the power algebra of x^j (1/x)^m, x /= 0
(define lc-e '(recip lcx_))
(define (lc-pw b n) (list 'power b n))
(define (lc-x-setup!)
  (dk-have! '(AND (IN lcx_ CC) (NOT (= lcx_ 0))))
  (fact 'cc-recip-closed 'lcx_)
  (dk-cite! 'cc-recip-inverse 'lcx_))
(define (lc-typ-pw! b n) (dk-have! (list 'AND (list 'IN b 'CC) (list 'IN n 'NN))) (fact 'power-typing-nonneg b n))
;; (2a) x^j (1/x)^j = 1
(sp (make-wff '(FORALL lcx_ (IMPLIES (IN lcx_ CC) (IMPLIES (NOT (= lcx_ 0)) (FORALL lcj_ (IMPLIES (IN lcj_ NN)
  (= (* (power lcx_ lcj_) (power (recip lcx_) lcj_)) 1))))))))
(dk-peel!)
(lc-x-setup!)
(dk-cite! 'cc-power-mul-base 'lcj_ 'lcx_ lc-e)
(subst (list '= (list '* (lc-pw 'lcx_ 'lcj_) (lc-pw lc-e 'lcj_)) (lc-pw (list '* 'lcx_ lc-e) 'lcj_)))
(subst (list '= (list '* 'lcx_ lc-e) 1))
(dk-cite! 'rr-power-one 'lcj_)
(ass)
(qed 'lc-power-cancel)
;; (2b) m = succ j: x^j (1/x)^m = 1/x
(sp (make-wff '(FORALL lcx_ (IMPLIES (IN lcx_ CC) (IMPLIES (NOT (= lcx_ 0)) (FORALL lcj_ (IMPLIES (IN lcj_ NN)
  (= (* (power lcx_ lcj_) (power (recip lcx_) (succ lcj_))) (recip lcx_)))))))))
(dk-peel!)
(lc-x-setup!)
(lc-typ-pw! 'lcx_ 'lcj_) (lc-typ-pw! lc-e 'lcj_)
(dk-have! (list 'AND (list 'IN lc-e 'CC) '(IN lcj_ NN)))
(subst (dk-cite! 'power-succ lc-e 'lcj_))
(dk-cite! 'lc-power-cancel 'lcx_ 'lcj_)
(let* ((a (lc-pw 'lcx_ 'lcj_)) (b (lc-pw lc-e 'lcj_))
       (an (dk-name! a 'CC)) (bn (dk-name! b 'CC)) (ev (dk-name! lc-e 'CC)))
  (subst (list '= a an)) (subst (list '= b bn)) (subst (list '= lc-e ev))
  (dk-have! (list '= (list '* an bn) 1) (lambda () (subst (list '= an a)) (subst (list '= bn b)) (ass)))
  (let ((lhs (cadr (dk-goal))))
    (dk-have! (list '= lhs (list '* (list '* an bn) ev)) (lambda () (crs)))
    (subst (list '= lhs (list '* (list '* an bn) ev)))
    (subst (list '= (list '* an bn) 1))
    (crs)))
(qed 'lc-power-one-left)
;; (2c) m = succ(succ j) + t: x^j (1/x)^m = (1/x)^(succ(succ t))
(sp (make-wff '(FORALL lcx_ (IMPLIES (IN lcx_ CC) (IMPLIES (NOT (= lcx_ 0)) (FORALL lcj_ (IMPLIES (IN lcj_ NN) (FORALL lct_ (IMPLIES (IN lct_ NN)
  (= (* (power lcx_ lcj_) (power (recip lcx_) (+ (succ (succ lcj_)) lct_))) (power (recip lcx_) (succ (succ lct_)))))))))))))
(dk-peel!)
(lc-x-setup!)
(fact 'nn-succ-closed 'lcj_) (fact 'nn-succ-closed '(succ lcj_)) (fact 'nn-succ-closed 'lct_)
(for-each (lambda (n) (lc-typ-pw! lc-e n)) '(lcj_ (succ lcj_) (succ (succ lcj_)) lct_ (succ lct_)))
(lc-typ-pw! 'lcx_ 'lcj_)
(subst (dk-cite! 'cc-power-add 'lct_ '(succ (succ lcj_)) lc-e))
(dk-have! (list 'AND (list 'IN lc-e 'CC) '(IN (succ lcj_) NN)))
(subst (dk-cite! 'power-succ lc-e '(succ lcj_)))
(subst (dk-cite! 'power-succ lc-e 'lcj_))
(dk-have! (list 'AND (list 'IN lc-e 'CC) '(IN (succ lct_) NN)))
(subst (dk-cite! 'power-succ lc-e '(succ lct_)))
(dk-have! (list 'AND (list 'IN lc-e 'CC) '(IN lct_ NN)))
(subst (dk-cite! 'power-succ lc-e 'lct_))
(dk-cite! 'lc-power-cancel 'lcx_ 'lcj_)
(let* ((a (lc-pw 'lcx_ 'lcj_)) (b (lc-pw lc-e 'lcj_)) (tt (lc-pw lc-e 'lct_))
       (ev (dk-name! lc-e 'CC)) (an (dk-name! a 'CC)) (bn (dk-name! b 'CC)) (tn (dk-name! tt 'CC)))
  (subst (list '= a an)) (subst (list '= b bn)) (subst (list '= tt tn)) (subst (list '= lc-e ev))
  (dk-have! (list '= (list '* an bn) 1) (lambda () (subst (list '= an a)) (subst (list '= bn b)) (ass)))
  (let ((lhs (cadr (dk-goal))))
    (dk-have! (list '= lhs (list '* (list '* an bn) (list '* ev (list '* ev tn)))) (lambda () (crs)))
    (subst (list '= lhs (list '* (list '* an bn) (list '* ev (list '* ev tn)))))
    (subst (list '= (list '* an bn) 1))
    (crs)))
(qed 'lc-power-recip-excess)
;; (2d) j = m + t: x^j (1/x)^m = x^t
(sp (make-wff '(FORALL lcx_ (IMPLIES (IN lcx_ CC) (IMPLIES (NOT (= lcx_ 0)) (FORALL lcm_ (IMPLIES (IN lcm_ NN) (FORALL lct_ (IMPLIES (IN lct_ NN)
  (= (* (power lcx_ (+ lcm_ lct_)) (power (recip lcx_) lcm_)) (power lcx_ lct_)))))))))))
(dk-peel!)
(lc-x-setup!)
(lc-typ-pw! 'lcx_ 'lcm_) (lc-typ-pw! 'lcx_ 'lct_) (lc-typ-pw! lc-e 'lcm_)
(subst (dk-cite! 'cc-power-add 'lct_ 'lcm_ 'lcx_))
(dk-cite! 'lc-power-cancel 'lcx_ 'lcm_)
(let* ((a (lc-pw 'lcx_ 'lcm_)) (b (lc-pw lc-e 'lcm_)) (tt (lc-pw 'lcx_ 'lct_))
       (an (dk-name! a 'CC)) (bn (dk-name! b 'CC)) (tn (dk-name! tt 'CC)))
  (subst (list '= a an)) (subst (list '= b bn)) (subst (list '= tt tn))
  (dk-have! (list '= (list '* an bn) 1) (lambda () (subst (list '= an a)) (subst (list '= bn b)) (ass)))
  (let ((lhs (cadr (dk-goal))))
    (dk-have! (list '= lhs (list '* (list '* an bn) tn)) (lambda () (crs)))
    (subst (list '= lhs (list '* (list '* an bn) tn)))
    (subst (list '= (list '* an bn) 1))
    (crs)))
(qed 'lc-power-x-excess)

;;; (3) the monomials x^j (1/x)^m, x = w - c, integrated round the circle |w - c| = r (integrand on the trace):
;;;   2 pi i when m = j + 1, and 0 otherwise -- the orthogonality relations (86) in the form 4.2 uses.
(define lc-tp '(* 2 PI))
(define lc-C '(CIRCLE-PATH c r))
(define lc-Cd '(CIRCLE-DERIV c r))
(define lc-T (list 'TRACE lc-C 0 lc-tp))
(define lc-D '(DIFFERENCE CC (SINGLETON c)))
(define (lc-LI f) (list 'LINE-INT f lc-C lc-Cd 0 lc-tp))
(define (lc-M j m) (list 'VNB-LAMBDA 'lcw_ lc-T (list '* (list 'power '(- lcw_ c) j) (list 'power '(recip (- lcw_ c)) m))))
(define lc-kern '(VNB-LAMBDA wnw_ (DIFFERENCE CC (SINGLETON c)) (recip (- wnw_ c))))
(define (lc-setup!)
  (fact 'rr-zero-in)
  (dk-split-all! (list (dk-cite! 'pi-pos)))
  (fact 'rr-mul-in-rr 2 'PI)
  (dk-have! (list '< 0 lc-tp) (lambda () (dk-ineq! '(IN PI RR) '(< 0 PI))))
  (dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
  (dk-cite! 'circle-is-road 'c 'r)
  (fact 'is-road-is-path lc-C lc-Cd 0 lc-tp)
  (fact 'is-path-in-fun lc-C 0 lc-tp)
  (fact 'trace-subset-cc lc-C 0 lc-tp)
  (dk-cite! 'trace-is-set lc-C 0 lc-tp)
  (fact 'subset-refl lc-T)
  (fact 'cc-is-set)
  (dk-cite! 'difference-set 'CC '(SINGLETON c))
  (dk-cite! 'cc-punctured-open 'c)
  (dk-cite! 'winding-integrand-holomorphic 'c)
  (dk-cite! 'holomorphic-on-open lc-D lc-kern)
  (dk-cite! 'cc-open-subset-cc lc-D)
  (fact 'subset-refl 'CC)
  (dk-have! (list 'SUBSET lc-T lc-D)
    (lambda () (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
                 (lc-tpt! y)
                 (if (not (sequent-node-grounded? leaf)) (ass))))))
(define (lc-steps . thunks)
  (let ((leaf (proof-state-focus *ps*)))
    (let loop ((ts thunks))
      (if (and (pair? ts) (not (sequent-node-grounded? leaf))) (begin ((car ts)) (loop (cdr ts)))))))
(define (lc-tpt! y)                  ; y on the trace: y in CC, y /= c, y - c /= 0, y in CC \ {c}
  (let ((m (list 'magnitude (list '- y 'c))))
    (lc-steps
      (lambda () (fact 'subset-mem-fwd lc-T 'CC y))
      (lambda () (dk-cite! 'circle-trace-magnitude 'c 'r y))
      (lambda () (fact 'cc-sub-in-cc y 'c))
      (lambda () (fact 'cc-magnitude-closed (list '- y 'c)))
      (lambda () (if (not (dk-asm? (list 'NOT (list '= (list '- y 'c) 0))))
                     (dk-have! (list 'NOT (list '= (list '- y 'c) 0))
                       (lambda () (di)
                         (dk-have! (list '= m 0) (lambda () (subst (list '= (list '- y 'c) 0)) (fact 'cc-magnitude-zero) (ass)))
                         (dk-absurd! (list 'IN m 'RR) '(IN r RR) (list '= m 0) (list '= m 'r) '(< 0 r))))))
      (lambda () (if (not (dk-asm? (list 'NOT (list '= y 'c))))
                     (dk-have! (list 'NOT (list '= y 'c))
                       (lambda () (di) (dk-have! (list '= (list '- y 'c) 0) (lambda () (subst (list '= y 'c)) (crs)))
                                  (ai (list 'NOT (list '= (list '- y 'c) 0)))))))
      (lambda () (if (not (dk-asm? (list 'IN y lc-D)))
                     (let ((iff (dk-cite! 'cc-punctured-membership 'c y)))
                       (dk-have! (list 'IN y lc-D) (lambda () (if (dk-only! iff (list 'IN y 'CC) (list 'NOT (list '= y 'c))) (prop))))))))))
(define (lc-M-typ! j m)
  (let ((mlam (lc-M j m)))
    (dk-have! (list 'IN mlam (list 'FUN lc-T 'CC))
      (lambda () (dk-lam-type! (lambda () (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*)) (d (list '- y 'c)))
                                            (lc-tpt! y)
                                            (if (not (sequent-node-grounded? leaf))
                                                (begin
                                                  (dk-have! (list 'AND (list 'IN d 'CC) (list 'NOT (list '= d 0))))
                                                  (fact 'cc-recip-closed d)
                                                  (lc-typ-pw! d j) (lc-typ-pw! (list 'recip d) m)
                                                  (dk-have! (list 'AND (list 'IN (list 'power d j) 'CC) (list 'IN (list 'power (list 'recip d) m) 'CC)))
                                                  (fact 'cc-mul-closed (list 'power d j) (list 'power (list 'recip d) m))
                                                  (if (not (sequent-node-grounded? leaf)) (ass)))))))))
    mlam))
;; move the integral of M to a reference lambda REF on a set U (continuous there), given the pointwise value
(define (lc-move! U REF M ptw!)
  (dk-have! (list 'FORALL 'wnx_ (list 'IMPLIES (list 'IN 'wnx_ lc-T) (list '== (list M 'wnx_) (list REF 'wnx_))))
    (lambda () (let* ((y (dk-di-var!))) (lc-tpt! y) (fact 'subset-mem-fwd lc-T U y) (dk-lam-b!) (if (pair? (dk-open-leaves)) (ptw! y)))))
  (dk-cite! 'line-int-domain-congruence U REF lc-C lc-Cd 0 lc-tp lc-T M))
(sp (make-wff '(FORALL c (IMPLIES (IN c CC) (FORALL r (IMPLIES (IN r RR) (IMPLIES (< 0 r) (FORALL lcj_ (IMPLIES (IN lcj_ NN)
  (= (LINE-INT (VNB-LAMBDA lcw_ (TRACE (CIRCLE-PATH c r) 0 (* 2 PI)) (* (power (- lcw_ c) lcj_) (power (recip (- lcw_ c)) (succ lcj_))))
               (CIRCLE-PATH c r) (CIRCLE-DERIV c r) 0 (* 2 PI))
     (* (* 2 PI) +i)))))))))))
(dk-peel!)
(lc-setup!)
(fact 'nn-succ-closed 'lcj_)
(dk-cite! 'winding-integrand-holomorphic 'c)
(dk-cite! 'holomorphic-on-in-fun lc-D lc-kern)
(dk-cite! 'holomorphic-on-continuous lc-D lc-kern)
(let ((mlam (lc-M-typ! 'lcj_ '(succ lcj_))))
  (lc-move! lc-D lc-kern mlam
    (lambda (y) (let ((d (list '- y 'c)))
                  (subst (dk-cite! 'lc-power-one-left d 'lcj_))
                  (if (pair? (dk-open-leaves)) (qrfl)))))
  (dk-cite! 'circle-recip-integral 'c 'r)
  (subst (list '= (lc-LI mlam) (lc-LI lc-kern)))
  (ass))
(qed 'lc-monomial-one)
(sp (make-wff '(FORALL c (IMPLIES (IN c CC) (FORALL r (IMPLIES (IN r RR) (IMPLIES (< 0 r)
  (FORALL lcj_ (IMPLIES (IN lcj_ NN) (FORALL lcm_ (IMPLIES (IN lcm_ NN) (IMPLIES (NOT (= lcm_ (succ lcj_)))
  (= (LINE-INT (VNB-LAMBDA lcw_ (TRACE (CIRCLE-PATH c r) 0 (* 2 PI)) (* (power (- lcw_ c) lcj_) (power (recip (- lcw_ c)) lcm_)))
               (CIRCLE-PATH c r) (CIRCLE-DERIV c r) 0 (* 2 PI))
     0)))))))))))))
(dk-peel!)
(lc-setup!)
(fact 'nn-succ-closed 'lcj_) (fact 'nn-succ-closed '(succ lcj_))
(fact 'nn-in-rr 'lcj_) (fact 'nn-in-rr 'lcm_)
(define lc-Mz (lc-M-typ! 'lcj_ 'lcm_))
(use-em '(<= lcm_ lcj_)
  (lambda ()
    ;; j = m + t: the integrand is (w - c)^t
    (let* ((tv (dk-skolem! (dk-apply! (dk-cite! 'nn-le-gap 'lcj_ 'lcm_)))))
      (dk-split-all!)
      (let* ((S '(VNB-LAMBDA lcrw_ CC (- lcrw_ c)))
             (G (list 'VNB-LAMBDA 'lcrw_ 'CC (list 'power '(- lcrw_ c) tv))))
        (dk-have! (list 'IN S '(FUN CC CC)) (lambda () (dk-lam-type! (lambda () (let ((y (dk-di-var!))) (dk-type! (list '- y 'c) 'CC))))))
        (dk-have! (list 'IN G '(FUN CC CC))
          (lambda () (dk-lam-type! (lambda () (let ((y (dk-di-var!))) (fact 'cc-sub-in-cc y 'c) (lc-typ-pw! (list '- y 'c) tv) (if (pair? (dk-open-leaves)) (ass)))))))
        (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES '(IN aix_ CC) (list '== (list S 'aix_) '(- aix_ c))))
          (lambda () (dk-di-var!) (if (not (dk-lam-b!)) (qrfl))))
        (dk-cite! 'aif-cont-shift 'CC 'c S)
        (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES '(IN aix_ CC) (list '== (list G 'aix_) (list 'power (list S 'aix_) tv))))
          (lambda () (let ((y (dk-di-var!))) (fact 'cc-sub-in-cc y 'c) (dk-lam-b!) (if (pair? (dk-open-leaves)) (qrfl)))))
        (dk-cite! 'aif-cont-power-of 'CC S tv G)
        (lc-move! 'CC G lc-Mz
          (lambda (y) (let ((d (list '- y 'c)))
                        (subst (list '= 'lcj_ (list '+ 'lcm_ tv)))
                        (subst (dk-cite! 'lc-power-x-excess d 'lcm_ tv))
                        (if (pair? (dk-open-leaves)) (qrfl)))))
        (dk-cite! 'circle-power-integral 'c 'r tv)
        (subst (list '= (lc-LI lc-Mz) (lc-LI G)))
        (ass))))
  (lambda ()
    ;; m >= j + 2: the integrand is (1/(w - c))^(succ(succ t))
    (fact 'rr-not-le-lt 'lcm_ 'lcj_)
    (fact 'nn-lt-succ-le 'lcj_ 'lcm_)
    (fact 'nn-in-rr '(succ lcj_))
    (dk-have! '(NOT (= (succ lcj_) lcm_)) (lambda () (di) (dk-have! '(= lcm_ (succ lcj_)) (lambda () (subst '(= (succ lcj_) lcm_)) (rfl))) (ai '(NOT (= lcm_ (succ lcj_))))))
    (dk-have! '(AND (<= (succ lcj_) lcm_) (NOT (= (succ lcj_) lcm_))))
    (fact 'rr-le-ne-lt '(succ lcj_) 'lcm_)
    (fact 'nn-lt-succ-le '(succ lcj_) 'lcm_)
    (let* ((tv (dk-skolem! (dk-apply! (dk-cite! 'nn-le-gap 'lcm_ '(succ (succ lcj_)))))))
      (dk-split-all!)
      (fact 'nn-succ-closed tv) (fact 'nn-succ-closed (list 'succ tv))
      (let* ((R '(VNB-LAMBDA lcrw_ (DIFFERENCE CC (SINGLETON c)) (recip (- lcrw_ c))))
             (G (list 'VNB-LAMBDA 'lcrw_ lc-D (list 'power '(recip (- lcrw_ c)) (list 'succ (list 'succ tv))))))
        (define (dpt! y) (fact 'subset-mem-fwd lc-D 'CC y)
          (let ((iff (dk-cite! 'cc-punctured-membership 'c y)))
            (dk-have! (list 'NOT (list '= y 'c)) (lambda () (if (dk-only! iff (list 'IN y lc-D)) (prop)))))
          (fact 'cc-sub-in-cc y 'c)
          (dk-have! (list 'NOT (list '= (list '- y 'c) 0)) (lambda () (di) (dk-cite! 'cc-sub-zero-eq y 'c) (ai (list 'NOT (list '= y 'c)))))
          (dk-have! (list 'AND (list 'IN (list '- y 'c) 'CC) (list 'NOT (list '= (list '- y 'c) 0))))
          (fact 'cc-recip-closed (list '- y 'c)))
        (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ lc-D) '(NOT (= aix_ c))))
          (lambda () (let ((y (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                       (fact 'subset-mem-fwd lc-D 'CC y)
                       (let ((iff (dk-cite! 'cc-punctured-membership 'c y))) (if (dk-only! iff (list 'IN y lc-D)) (prop))))))
        (dk-have! (list 'IN R (list 'FUN lc-D 'CC)) (lambda () (dk-lam-type! (lambda () (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*))) (dpt! y) (if (not (sequent-node-grounded? leaf)) (ass)))))))
        (dk-have! (list 'IN G (list 'FUN lc-D 'CC))
          (lambda () (dk-lam-type! (lambda () (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*))) (dpt! y) (lc-typ-pw! (list 'recip (list '- y 'c)) (list 'succ (list 'succ tv))) (if (not (sequent-node-grounded? leaf)) (ass)))))))
        (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ lc-D) (list '== (list R 'aix_) '(recip (- aix_ c)))))
          (lambda () (let ((y (dk-di-var!))) (dpt! y) (if (not (dk-lam-b!)) (qrfl)))))
        (dk-cite! 'aif-cont-recip-shift lc-D 'c R)
        (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ lc-D) (list '== (list G 'aix_) (list 'power (list R 'aix_) (list 'succ (list 'succ tv))))))
          (lambda () (let ((y (dk-di-var!))) (dpt! y) (dk-lam-b!) (if (pair? (dk-open-leaves)) (qrfl)))))
        (dk-cite! 'aif-cont-power-of lc-D R (list 'succ (list 'succ tv)) G)
        (lc-move! lc-D G lc-Mz
          (lambda (y) (let ((d (list '- y 'c)))
                        (subst (list '= 'lcm_ (list '+ '(succ (succ lcj_)) tv)))
                        (subst (dk-cite! 'lc-power-recip-excess d 'lcj_ tv))
                        (if (pair? (dk-open-leaves)) (qrfl)))))
        (dk-cite! 'circle-recip-power-integral 'c 'r tv)
        (subst (list '= (lc-LI lc-Mz) (lc-LI G)))
        (ass)))))
