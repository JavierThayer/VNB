;; the two power series at a trace point x: A1(x) = sum cp(k) (x - c)^k, B1(x) = sum cn(k) (1/(x - c))^k, both convergent
(define (lc-A1 x) (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list lc-cp 'cpsk_) (list 'power (list '- x 'c) 'cpsk_))))
(define (lc-B1 x) (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list lc-cn 'cpsk_) (list 'power (list 'recip (list '- x 'c)) 'cpsk_))))
(define (lc-LS-unfold! x)            ; x on the trace: LAURENT-SUM(lcc_, c, x) = LIMIT A1 + 1/(x - c) LIMIT B1, typed
  (let* ((d (list '- x 'c)) (e (list 'recip d)) (A1 (lc-A1 x)) (B1 (lc-B1 x))
         (rhs (list '+ (list 'CC-SERIES-LIMIT A1) (list '* e (list 'CC-SERIES-LIMIT B1)))))
    (lc-tpt2! x)
    (fact 'cc-magnitude-closed d)
    (dk-cite! 'circle-trace-magnitude 'c 'r x)
    (dk-cite! 'aif-magnitude-recip d)
    (fact 'cc-magnitude-closed e)
    (dk-have! (list '<= (list 'magnitude d) 'r) (lambda () (dk-ineq! (list '= (list 'magnitude d) 'r) (list 'IN (list 'magnitude d) 'RR))))
    (dk-have! (list '<= (list 'magnitude e) '(recip r))
      (lambda () (subst (list '= (list 'magnitude e) (list 'recip (list 'magnitude d)))) (subst (list '= (list 'magnitude d) 'r)) (dk-ineq! '(IN (recip r) RR))))
    (lc-in-cb2! d 'r) (lc-in-cb2! e '(recip r))
    (dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
    (dk-apply! (dk-cite! 'cps-converges-closed-ball lc-cp 'r) d)
    (dk-apply! (dk-cite! 'cps-converges-closed-ball lc-cn '(recip r)) e)
    (for-each (lambda (S)
                (if (not (dk-asm? (list 'IN S '(FUN NN CC))))
                    (dk-have! (list 'IN S '(FUN NN CC))
                      (lambda () (dk-lam-type! (lambda () (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                                            (lc-cp-val! k)
                                                            (if (not (sequent-node-grounded? leaf)) (dk-type! (cadr (dk-goal)) 'CC)))))))))
              (list A1 B1))
    (fact 'cc-series-limit-in-cc A1) (fact 'cc-series-limit-in-cc B1)
    (dk-type! rhs 'CC)
    (if (not (dk-asm? (list '= (list 'LAURENT-SUM 'lcc_ 'c x) rhs)))
        (dk-have! (list '= (list 'LAURENT-SUM 'lcc_ 'c x) rhs)
          (lambda ()
            (mac 'LAURENT-SUM)
            (let* ((g (dk-goal)) (lhs (cadr g))
                   (LP (cadr (cadr lhs))) (LN (cadr (caddr (caddr lhs)))))
              (for-each (lambda (pr)
                          (let ((L0 (car pr)) (L1 (cadr pr)))
                            (dk-fun-ext! L0 L1 'NN 'CC
                              (lambda () (dk-lam-type! (lambda () (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                                                    (lc-cp-val! k)
                                                                    (if (not (sequent-node-grounded? leaf)) (dk-type! (cadr (dk-goal)) 'CC))))))
                              #f
                              (lambda (k) (lc-cp-val! k) (dk-lam-b!)
                                (if (dk-contains? (dk-goal) (list lc-cp k)) (subst (list '= (list lc-cp k) (list 'lcc_ k))))
                                (if (dk-contains? (dk-goal) (list lc-cn k)) (subst (list '= (list lc-cn k) (list 'lcc_ (list '- (list '+ k 1))))))
                                (if (pair? (dk-open-leaves)) (begin (dk-type! (cadr (dk-goal)) 'CC) (rfl)))))
                            (subst (list '= L0 L1))))
                        (list (list LP A1) (list LN B1)))
              (if (pair? (dk-open-leaves)) (rfl))))))
    (list A1 B1 rhs)))
