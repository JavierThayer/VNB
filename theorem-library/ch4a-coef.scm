    (lambda () (dk-lam-b!) (if (pair? (dk-open-leaves)) (qrfl))))
  (dk-have! (list 'IN (list 'CC-SERIES-LIMIT (lc-tz (list 'lczf_ x))) 'CC)
    (lambda () (subst (list '== (list 'CC-SERIES-LIMIT (lc-tz (list 'lczf_ x))) (list lc-FS (list 'lczf_ x)))) (ass))))
(dk-have! (list 'IN lc-h1 '(FUN u CC))
  (lambda () (dk-lam-type! (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*))) (lc-SZ! x) (if (not (sequent-node-grounded? leaf)) (ass)))))))
(dk-have! (lc-ptw 'u lc-h1 (lambda (x) (list lc-FS (list 'lczf_ x))))
  (lambda () (let ((x (dk-di-var!))) (lc-SZ! x) (dk-lam-b!) (if (pair? (dk-open-leaves)) (qrfl)))))
(dk-cite! 'aif-cont-compose 'u 'lczf_ lc-B lc-FS lc-h1)
(dk-have! (list 'IN lc-g '(FUN u CC))
  (lambda () (dk-lam-type! (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                        (lc-SZ! x)
                                        (if (not (sequent-node-grounded? leaf)) (dk-type! (list '* (list 'CC-SERIES-LIMIT (lc-tz (list 'lczf_ x))) (list 'lcwf_ x)) 'CC)))))))
(dk-have! (lc-ptw 'u lc-g (lambda (x) (list '* (list lc-h1 x) (list 'lcwf_ x))))
  (lambda () (let ((x (dk-di-var!))) (lc-SZ! x) (dk-lam-b!) (if (pair? (dk-open-leaves)) (qrfl)))))
(dk-cite! 'aif-cont-product 'u lc-h1 'lcwf_ lc-g)
;; the family hf(j) = cf(j) Z^j W, and M_j = Z^j W: typed and continuous
(define lc-HF (list 'VNB-LAMBDA 'lcj_ 'NN (list 'VNB-LAMBDA 'lcw_ 'u (list '* (list '* '(cf lcj_) '(power (lczf_ lcw_) lcj_)) '(lcwf_ lcw_)))))
(define (lc-H j) (list 'VNB-LAMBDA 'lcw_ 'u (list '* (list '* (list 'cf j) (list 'power '(lczf_ lcw_) j)) '(lcwf_ lcw_))))
(define (lc-lamtyp! lam)
  (if (not (dk-asm? (list 'IN lam '(FUN u CC))))
      (dk-have! (list 'IN lam '(FUN u CC))
        (lambda () (dk-lam-type! (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                              (lc-upt! x)
                                              (if (not (sequent-node-grounded? leaf))
                                                  (begin (if (dk--redex? (dk-goal)) (dk-lam-b!))
                                                         (if (not (sequent-node-grounded? leaf)) (dk-type! (cadr (dk-goal)) 'CC)))))))))))
(define (lc-ptw! lam rhs-of)
  (dk-have! (lc-ptw 'u lam rhs-of)
    (lambda () (let ((x (dk-di-var!))) (lc-upt! x) (dk-lam-b!) (if (pair? (dk-open-leaves)) (qrfl))))))
(define (lc-fam! j)                  ; j in NN: H_j, M_j typed and continuous, their integrals complex
  (let* ((P (list 'VNB-LAMBDA 'lcw_ 'u (list 'power '(lczf_ lcw_) j)))
         (Q (list 'VNB-LAMBDA 'lcw_ 'u (list '* (list 'cf j) (list 'power '(lczf_ lcw_) j))))
         (H (lc-H j)) (M (lc-Mk j)))
    (fact 'fun-apply-type-c 'cf 'NN 'CC j)
    (for-each lc-lamtyp! (list P Q H M))
    (lc-ptw! P (lambda (x) (list 'power (list 'lczf_ x) j)))
    (dk-cite! 'aif-cont-power-of 'u 'lczf_ j P)
    (lc-ptw! Q (lambda (x) (list '* (list 'cf j) (list P x))))
    (dk-cite! 'aif-cont-scale 'u (list 'cf j) P Q)
    (lc-ptw! H (lambda (x) (list '* (list Q x) (list 'lcwf_ x))))
    (dk-cite! 'aif-cont-product 'u Q 'lcwf_ H)
    (lc-ptw! M (lambda (x) (list '* (list P x) (list 'lcwf_ x))))
    (dk-cite! 'aif-cont-product 'u P 'lcwf_ M)
    (dk-cite! 'line-int-in-cc 'u H 'pgam 'dgam 'a 'b)
    (dk-cite! 'line-int-in-cc 'u M 'pgam 'dgam 'a 'b)
    (list H M)))
(dk-have! (list 'FORALL 'twj_ (list 'IMPLIES '(IN twj_ NN) (list 'IN (list lc-HF 'twj_) '(FUN u CC))))
  (lambda () (let ((j (dk-di-var!))) (lc-fam! j) (dk-lam-b!) (if (pair? (dk-open-leaves)) (ass)))))
(dk-have! (list 'FORALL 'twj_ (list 'IMPLIES '(IN twj_ NN) (lc-cont 'u (list lc-HF 'twj_))))
  (lambda () (let ((j (dk-di-var!))) (lc-fam! j) (dk-lam-b!)
               (let ((y (list-ref (dk-goal) 4)))
                 (dk-apply! (dk-ctx-form (lc-cont 'u (lc-H j))) y)
                 (if (pair? (dk-open-leaves)) (ass))))))
;; the uniform estimate on the trace
(define (lc-inner y) (list 'VNB-LAMBDA 'twj_ 'NN (list (list lc-HF 'twj_) y)))
(define lc-unif
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'twcap_ (list 'AND '(IN twcap_ NN)
      (list 'FORALL 'twk_ (list 'IMPLIES '(IN twk_ NN) (list 'IMPLIES '(<= twcap_ twk_)
        (list 'FORALL 'twy_ (list 'IMPLIES '(IN twy_ (TRACE pgam a b))
          (list '<= (list 'magnitude (list '- (list 'CC-SERIES-PARTIAL-SUM (lc-inner 'twy_) 'twk_) (list lc-g 'twy_))) 'eps)))))))))))
(fact 'is-road-is-path 'pgam 'dgam 'a 'b)
(define lc-MW (dk-skolem! (dk-fact! 'aif-trace-bounded 'u 'lcwf_ 'pgam 'a 'b)))
(dk-split-all!)
(define lc-bnd (list 'FORALL 'aiy_ (list 'IMPLIES '(IN aiy_ (TRACE pgam a b)) (list '<= '(magnitude (lcwf_ aiy_)) lc-MW))))
(define (lc-in-cb! z)                ; z in CC, |z| <= rho: z in CLOSED-BALL(CC-MS, 0, rho)
  (let ((iff (dk-cite! 'closed-ball-membership 'CC-MS 0 'rho z)))
