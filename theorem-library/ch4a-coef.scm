                   (if (dk-asm? (dk-goal)) (ass)
                       (begin (subst (list '= (list '- z 0) z))
                              (dk-ineq! (list 'IN (list 'magnitude z) 'RR) '(IN rho RR) (list 'IN lc-rad 'RR) (list '<= (list 'magnitude z) 'rho) (list '< 'rho lc-rad))))))))
    (dk-have! (list 'IN z lc-B) (lambda () (if (dk-only! iff (list 'AND (list 'IN z 'CC) (list '< (list 'magnitude (list '- z 0)) lc-rad))) (prop))))))
