;;; (5) TERMWISE INTEGRATION OF A POWER SERIES composed with a bounded continuous map, against a weight:
;;;   |Z| <= rho < CPS-RADIUS(cf) on u, Z and W continuous on u, a road with its trace in u:
;;;   sum_k cf(k) int Z(w)^k W(w) dw  converges to  int S(Z(w)) W(w) dw,   S(z) = sum_k cf(k) z^k.
(define lc-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (lc-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u) (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS lc-nfm u) lc-nfm f 'rgy_))))
(define (lc-ptw u h rhs-of)
  (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ u) (list '== (list h 'aix_) (rhs-of 'aix_)))))
(define (lc-tz x) (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* '(cf cpsk_) (list 'power x 'cpsk_))))
(define lc-g (list 'VNB-LAMBDA 'lcw_ 'u (list '* (list 'CC-SERIES-LIMIT (lc-tz '(lczf_ lcw_))) '(lcwf_ lcw_))))
(define (lc-Mk k) (list 'VNB-LAMBDA 'lcw_ 'u (list '* (list 'power '(lczf_ lcw_) k) '(lcwf_ lcw_))))
(define lc-SER (list 'VNB-LAMBDA 'lck_ 'NN (list '* '(cf lck_) (list 'LINE-INT (lc-Mk 'lck_) 'pgam 'dgam 'a 'b))))
(sp (make-wff
  (list 'FORALL 'u (list 'FORALL 'pgam (list 'FORALL 'dgam (list 'FORALL 'a (list 'FORALL 'b
  (list 'IMPLIES '(SUBSET u CC) (list 'IMPLIES '(IS-ROAD pgam dgam a b) (list 'IMPLIES '(SUBSET (TRACE pgam a b) u)
  (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN CC)) (list 'FORALL 'rho (list 'IMPLIES '(IN rho RR) (list 'IMPLIES '(<= 0 rho) (list 'IMPLIES '(< rho (CPS-RADIUS cf))
  (list 'FORALL 'lczf_ (list 'IMPLIES '(IN lczf_ (FUN u CC)) (list 'IMPLIES (lc-cont 'u 'lczf_)
    (list 'IMPLIES '(FORALL aix_ (IMPLIES (IN aix_ u) (<= (magnitude (lczf_ aix_)) rho)))
  (list 'FORALL 'lcwf_ (list 'IMPLIES '(IN lcwf_ (FUN u CC)) (list 'IMPLIES (lc-cont 'u 'lcwf_)
    (list 'AND (list 'IN lc-g '(FUN u CC)) (list 'AND (lc-cont 'u lc-g) (list 'AND (list 'IN lc-SER '(FUN NN CC))
      (list 'CC-SERIES-CONVERGES-TO lc-SER (list 'LINE-INT lc-g 'pgam 'dgam 'a 'b))))))))))))))))))))))))))))
(dk-peel!)
(fact 'nf-cc-is-metric-space)
(fact 'cc-is-normed-field) (fact 'nf-metric-carrier 'CC-NORMED-FIELD)
(fact 'cc-nf-carr)
(dk-have! (list '== (list 'PTS lc-nfm) 'CC) (lambda () (subst (list '== (list 'PTS lc-nfm) '(CARR CC-NORMED-FIELD))) (ass)))
(dk-have! (list 'SUBSET 'u (list 'PTS lc-nfm)) (lambda () (subst (list '== (list 'PTS lc-nfm) 'CC)) (ass)))
(dk-have! '(IN u SET) (lambda () (fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC) (ass)))
(fact 'subspace-is-metric-space lc-nfm 'u)
(fact 'subspace-pts lc-nfm 'u)
(fact 'nn-is-set) (fact 'cc-zero-in) (fact 'rr-zero-in)
(fact 'cc-is-metric-space)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
;; a point of u: Z(x), W(x) complex, |Z(x)| <= rho
(define (lc-upt! x)
  (fact 'subset-mem-fwd 'u 'CC x)
  (fact 'fun-apply-type-c 'lczf_ 'u 'CC x)
  (fact 'fun-apply-type-c 'lcwf_ 'u 'CC x)
  (dk-apply! (dk-ctx-form '(FORALL aix_ (IMPLIES (IN aix_ u) (<= (magnitude (lczf_ aix_)) rho)))) x)
  (fact 'cc-magnitude-closed (list 'lczf_ x)))
;; the ball of holomorphy
(define lc-rad (dk-skolem! (dk-apply! (dk-cite! 'lc-radius-mid 'cf 'rho))))
