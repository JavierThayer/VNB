      (lambda () (if (dk-only! iff (list 'IN z '(PTS CC-MS)) (list '<= (list '(DIST CC-MS) 0 z) 'rho)) (prop))))))
(define (lc-est! k y eps epsp cap)
  (let* ((z (list 'lczf_ y)) (wy (list 'lcwf_ y)) (tz (lc-tz z))
         (ps (list 'CC-SERIES-PARTIAL-SUM tz k)) (lz (list 'CC-SERIES-LIMIT tz)) (inn (lc-inner y)))
    (fact 'rr-pos-rr-in-rr epsp)
    (fact 'subset-mem-fwd '(TRACE pgam a b) 'u y)
    (lc-SZ! y)
    (lc-in-cb! z)
    (dk-apply! (dk-ctx-form lc-bnd) y)
    (fact 'cc-magnitude-closed wy)
