;;; (6) PROPOSITION 4.2: for a two-sided family lcc_ in fun(zz, cc) with r inside both radii, the coefficients are
;;; read off the Laurent sum on the circle |w - c| = r:
;;;   lcc_(n)        = 1/(2 pi i) int LAURENT-SUM(lcc_, c, w) (1/(w - c))^(n+1) dw,
;;;   lcc_(-(n+1))   = 1/(2 pi i) int LAURENT-SUM(lcc_, c, w) (w - c)^n dw.
(define lc-tpi '(* (* 2 PI) +i))
