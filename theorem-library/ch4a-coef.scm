  (list 'FORALL 'r (list 'IMPLIES '(IN r RR) (list 'IMPLIES '(< 0 r)
    (list 'IMPLIES (list '< 'r (list 'CPS-RADIUS lc-cp)) (list 'IMPLIES (list '< '(recip r) (list 'CPS-RADIUS lc-cn))
      (list 'FORALL 'lcn_ (list 'IMPLIES '(IN lcn_ NN)
        (list 'AND (list '= '(lcc_ lcn_) (list '* (list 'recip lc-tpi) (lc-LI (lc-I lc-Epos))))
                   (list '= '(lcc_ (- (+ lcn_ 1))) (list '* (list 'recip lc-tpi) (lc-LI (lc-I lc-Eneg))))))))))))))))))
