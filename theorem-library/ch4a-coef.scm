      (dk-have! (list '= (list lc-cn k) (list 'lcc_ (list '- (list '+ k 1)))) (lambda () (subst (list '= lc-cn lc-cnL)) (dk-lam-b!) (if (pair? (dk-open-leaves)) (rfl))))))
