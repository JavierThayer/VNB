;; the term of a cited series at k, and the move of its integrand onto a monomial
(define (lc-ser-at S k) (list S k))
(define (lc-term-to-mono! S k j m alg! val!)
  ;; lands (= (S k) (* coef VAL)) where VAL = LI(lc-M j m), evaluated by VAL! (which cites the monomial lemma)
  (let* ((body (lc-repl (cadddr S) (cadr S) k))      ; (* (cf k) (LINE-INT MX ...))
         (cfk (cadr body)) (MM (lc-M-typ! j m)) (val (val!)))
    (dk-have! (list '= (list S k) (list '* cfk val))
      (lambda ()
        (dk-lam-b!)
        (let* ((lhs (cadr (dk-goal))) (MXr (cadr (caddr lhs))))
          (lc-ttyp! MXr)
          (if (not (equal? MXr MM))
              (begin
                (dk-fun-ext! MXr MM lc-T 'CC #f #f
                  (lambda (x) (lc-tpt2! x) (dk-lam-b!) (if (pair? (dk-open-leaves)) (alg! x))))
                (subst (list '= MXr MM))))
          (subst (list '= (lc-LI MM) val))
          (if (pair? (dk-open-leaves)) (begin (dk-type! (caddr (dk-goal)) 'CC) (rfl))))))
    (list '= (list S k) (list '* cfk val))))
(define (lc-repl e from to)
  (cond ((eq? e from) to) ((pair? e) (cons (lc-repl (car e) from to) (lc-repl (cdr e) from to))) (#t e)))
;; ---- one side: E the factor, the two weights, the two termwise expansions, the split of the integrand
(define (lc-weights! E-of Wp-cont!)
  (let* ((Wp (lc-tlam E-of))
         (Wn (lc-tlam (lambda (w) (list '* (list 'recip (list '- w 'c)) (E-of w))))))
    (lc-ttyp! Wp) (lc-ttyp! Wn)
    (Wp-cont! Wp)
    (lc-tptw! Wn (lambda (x) (list '* (list lc-Zn x) (list Wp x))))
    (dk-cite! 'aif-cont-product lc-T lc-Zn Wp Wn)
    (list Wp Wn)))
(define (lc-expand! cf rad Z W)      ; cite the termwise lemma; returns (g SER) with g's facts and the convergence landed
  (let ((res (dk-cite! 'cc-power-series-termwise lc-T lc-C lc-Cd 0 lc-tp cf rad Z W)))
    (dk-split-all! (list res))
    (let* ((cv (caddr (caddr (caddr res)))) (S (cadr cv)) (g (cadr (caddr cv))))
      (list g S))))
(define (lc-split! I gA gB E-of)     ; LI(I) = LI(gA) + LI(gB)
  (lc-ttyp-I! I E-of)
  (dk-have! (list 'FORALL 'liz_ (list 'IMPLIES (list 'IN 'liz_ lc-T) (list '== (list I 'liz_) (list '+ (list gA 'liz_) (list gB 'liz_)))))
    (lambda ()
      (let* ((x (dk-di-var!)) (un (lc-LS-unfold! x)) (rhs (caddr un)) (Ex (E-of x)) (e (list 'recip (list '- x 'c))))
        (dk-type! Ex 'CC)
        (dk-lam-b!)
        (subst (list '= (list 'LAURENT-SUM 'lcc_ 'c x) rhs))
        (let* ((la (dk-name! (list 'CC-SERIES-LIMIT (car un)) 'CC)) (lb (dk-name! (list 'CC-SERIES-LIMIT (cadr un)) 'CC))
               (lc-ev0 (dk-name! e 'CC)) (lc-evx (dk-name! Ex 'CC)))
          (subst (list '= (list 'CC-SERIES-LIMIT (car un)) la)) (subst (list '= (list 'CC-SERIES-LIMIT (cadr un)) lb))
          (subst (list '= Ex lc-evx)) (subst (list '= e lc-evx))
          (let ((l (cadr (dk-goal))) (r (caddr (dk-goal))))
            (dk-have! (list '= l r) (lambda () (crs)))
            (subst (list '= l r))
            (if (pair? (dk-open-leaves)) (qrfl)))))))
  (dk-apply! (dk-cite! 'line-int-sum lc-T gA gB lc-C lc-Cd 0 lc-tp) I))
(define (lc-ttyp-I! I E-of)
  (dk-have! (list 'IN I (list 'FUN lc-T 'CC))
    (lambda () (dk-lam-type! (lambda () (let* ((x (dk-di-var!)) (un (lc-LS-unfold! x)))
                                          (dk-type! (E-of x) 'CC)
                                          (if (dk--redex? (dk-goal)) (dk-lam-b!))
                                          (subst (list '= (list 'LAURENT-SUM 'lcc_ 'c x) (caddr un)))
                                          (dk-type! (cadr (dk-goal)) 'CC)))))))
;; POSITIVE n
(define lc-wP (lc-weights! lc-Epos
  (lambda (Wp) (lc-tptw! Wp (lambda (x) (list 'power (list lc-Zn x) '(succ lcn_))))
               (dk-cite! 'aif-cont-power-of lc-T lc-Zn '(succ lcn_) Wp))))
(define lc-xA (lc-expand! lc-cp 'r lc-Zp (car lc-wP)))
(define lc-xB (lc-expand! lc-cn '(recip r) lc-Zn (cadr lc-wP)))
(define (lc-nn-eq! a b)               ; (= (succ a) (succ b)) or (= (succ b) (succ a)) in context, a, b in NN: land (= a b)
  (fact 'nn-in-rr a) (fact 'nn-in-rr b)
  (fact 'nn-succ-closed a) (fact 'nn-succ-closed b)
  (fact 'nn-in-rr (list 'succ a)) (fact 'nn-in-rr (list 'succ b))
  (fact 'nn-succ-plus-one a) (fact 'nn-succ-plus-one b)
  (let* ((e1 (list '= (list 'succ a) (list 'succ b))) (e2 (list '= (list 'succ b) (list 'succ a)))
         (eq (if (dk-asm? e1) e1 e2))
         (prem (list eq (list '= (list 'succ a) (list '+ a 1)) (list '= (list 'succ b) (list '+ b 1))
                     (list 'IN a 'RR) (list 'IN b 'RR) (list 'IN (list 'succ a) 'RR) (list 'IN (list 'succ b) 'RR))))
    (dk-have! (list '<= a b) (lambda () (apply dk-ineq! prem)))
    (dk-have! (list '<= b a) (lambda () (apply dk-ineq! prem)))
    (dk-have! (list 'AND (list 'IN a 'RR) (list 'IN b 'RR)))
    (dk-have! (list 'AND (list '<= a b) (list '<= b a)))
    (fact 'rr-leq-antisymmetric a b)))
;; the A-terms: lcc_(k) LI(M(k, succ n)); 2 pi i at k = n, 0 elsewhere
(define lc-SA (cadr lc-xA))
(define lc-SB (cadr lc-xB))
(define (lc-alg-id! x) (if (pair? (dk-open-leaves)) (begin (dk-type! (cadr (dk-goal)) 'CC) (rfl))))
(dk-have! (list 'FORALL 'lcj_ (list 'IMPLIES '(IN lcj_ NN) (list 'IMPLIES '(NOT (= lcj_ lcn_)) (list '= (list lc-SA 'lcj_) 0))))
  (lambda ()
    (let* ((pl (dk-peel!)) (k (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) pl)))))
      (fact 'nn-succ-closed k)
      (lc-cp-val! k)
      (let ((eq (lc-term-to-mono! lc-SA k k '(succ lcn_) lc-alg-id!
                  (lambda ()
                    (dk-have! (list 'NOT (list '= '(succ lcn_) (list 'succ k)))
                      (lambda () (di) (fact 'nn-in-rr k) (fact 'nn-in-rr 'lcn_)
                                 (lc-nn-eq! k 'lcn_)
                                 (ai (list 'NOT (list '= k 'lcn_)))))
                    (dk-cite! 'lc-monomial-zero 'c 'r k '(succ lcn_))
                    0))))
        (subst eq)
        (if (dk--redex? (dk-goal)) (dk-lam-b!))
        (crs)))))
;; the A-term at n is lcc_(n) 2 pi i, and the A-series converges to it
(lc-cp-val! 'lcn_)
(define lc-An (lc-term-to-mono! lc-SA 'lcn_ 'lcn_ '(succ lcn_) lc-alg-id!
                (lambda () (dk-cite! 'lc-monomial-one 'c 'r 'lcn_) lc-tpi)))
(define lc-cvA (dk-cite! 'cc-series-single-term lc-SA 'lcn_))
(define (lc-lim-eq! S L1 L2)         ; S converges to L1 and to L2: land (= L1 L2)
  (dk-split-all! (list (dk-cite! 'cc-series-limit-of-converges-to S L1)))
  (dk-split-all! (list (dk-cite! 'cc-series-limit-of-converges-to S L2)))
  (dk-have! (list '= L1 L2) (lambda () (subst (list '= L1 (list 'CC-SERIES-LIMIT S))) (ass))))
(define lc-gA (car lc-xA))
(define lc-gB (car lc-xB))
(lc-lim-eq! lc-SA (lc-LI lc-gA) (list lc-SA 'lcn_))
;; the B-terms all vanish: (1/(w - c))^k (1/(w - c)) (1/(w - c))^(n+1) = (w - c)^0 (1/(w - c))^(n+2+k)
(define (lc-mB k) (list '+ '(succ (succ lcn_)) k))
(define (lc-pos-B-alg! k)
  (lambda (x)
    (let* ((d (list '- x 'c)) (e (list 'recip d)) (m (lc-mB k)))
      (fact 'nn-succ-closed 'lcn_) (fact 'nn-succ-closed '(succ lcn_))
      (dk-have! (list 'AND (list 'IN e 'CC) '(IN (succ lcn_) NN)))
      (for-each (lambda (n) (lc-typ-pw! e n)) (list k '(succ lcn_) '(succ (succ lcn_))))
      (subst (dk-cite! 'cc-power-add k '(succ (succ lcn_)) e))
      (subst (dk-cite! 'power-succ e '(succ lcn_)))
      (subst (dk-cite! 'power-zero d))
      (let* ((ev (dk-name! e 'CC)) (pk (dk-name! (list 'power e k) 'CC)) (pn (dk-name! (list 'power e '(succ lcn_)) 'CC)))
        (subst (list '= (list 'power e k) pk)) (subst (list '= (list 'power e '(succ lcn_)) pn)) (subst (list '= e ev))
        (crs)))))
(define (lc-mB-ne! k)
  (fact 'nn-in-rr k) (fact 'nn-in-rr 'lcn_) (fact 'nn-zero-le k) (fact 'nn-zero-le 'lcn_)
  (fact 'nn-succ-closed 'lcn_) (fact 'nn-succ-closed '(succ lcn_)) (fact 'nn-zero-in) (fact 'nn-succ-closed 0)
  (fact 'nn-succ-plus-one 'lcn_) (fact 'nn-succ-plus-one '(succ lcn_)) (fact 'nn-succ-plus-one 0)
  (fact 'nn-in-rr '(succ lcn_)) (fact 'nn-in-rr '(succ (succ lcn_))) (fact 'nn-in-rr '(succ 0))
  (dk-have! (list 'NOT (list '= (lc-mB k) '(succ 0)))
    (lambda () (di)
      (dk-absurd! (list '= (lc-mB k) '(succ 0)) '(= (succ 0) (+ 0 1)) '(= (succ (succ lcn_)) (+ (succ lcn_) 1)) '(= (succ lcn_) (+ lcn_ 1))
                  (list '<= 0 k) '(<= 0 lcn_) (list 'IN k 'RR) '(IN lcn_ RR) '(IN (succ lcn_) RR) '(IN (succ (succ lcn_)) RR) '(IN (succ 0) RR)))))
(dk-have! (list 'FORALL 'lcj_ (list 'IMPLIES '(IN lcj_ NN) (list '= (list lc-SB 'lcj_) 0)))
  (lambda ()
    (let* ((k (dk-di-var!)))
      (lc-cp-val! k)
      (fact 'nn-succ-closed '(succ lcn_))
      (dk-have! (list 'AND '(IN (succ (succ lcn_)) NN) (list 'IN k 'NN)))
      (fact 'nn-add-closed '(succ (succ lcn_)) k)
      (let ((eq (lc-term-to-mono! lc-SB k 0 (lc-mB k) (lc-pos-B-alg! k)
                  (lambda () (lc-mB-ne! k) (dk-cite! 'lc-monomial-zero 'c 'r 0 (lc-mB k)) 0))))
        (subst eq)
        (if (dk--redex? (dk-goal)) (dk-lam-b!))
        (crs)))))
(define lc-zB (dk-cite! 'cc-series-of-zeros lc-SB))
(dk-apply! lc-zB (lc-LI lc-gB))
;; the split of the integrand, and the positive coefficient
(define lc-IP (lc-I lc-Epos))
(lc-split! lc-IP lc-gA lc-gB lc-Epos)
(define (lc-final! coef I gA gB SA-at)   ; land (= coef (* (recip tpi) LI(I))) from LI(I) = LI(gA) + LI(gB), LI(gA) = coef tpi, LI(gB) = 0
  (dk-have! (list '= coef (list '* (list 'recip lc-tpi) (lc-LI I)))
    (lambda ()
      (subst (list '= (lc-LI I) (list '+ (lc-LI gA) (lc-LI gB))))
      (subst (list '= (lc-LI gA) SA-at))
      (subst (list '= (lc-LI gB) 0))
      (let* ((pv (dk-name! (list 'recip lc-tpi) 'CC)))
        (subst (list '= (list 'recip lc-tpi) pv))
        (dk-have! (list '= (list '* lc-tpi pv) 1) (lambda () (subst (list '= pv (list 'recip lc-tpi))) (ass)))
        (let ((rhs (caddr (dk-goal))))
          (dk-have! (list '= rhs (list '* (list '* lc-tpi pv) coef)) (lambda () (crs)))
          (subst (list '= rhs (list '* (list '* lc-tpi pv) coef)))
          (subst (list '= (list '* lc-tpi pv) 1))
          (crs))))))
(dk-have! (list '= (list lc-SA 'lcn_) (list '* '(lcc_ lcn_) lc-tpi))
  (lambda () (subst lc-An) (subst (list '= (list lc-cp 'lcn_) '(lcc_ lcn_))) (if (pair? (dk-open-leaves)) (begin (dk-type! (cadr (dk-goal)) 'CC) (rfl)))))
(dk-have! (list '= (lc-LI lc-gA) (list '* '(lcc_ lcn_) lc-tpi))
  (lambda () (subst (list '= (lc-LI lc-gA) (list lc-SA 'lcn_))) (ass)))
(lc-final! '(lcc_ lcn_) lc-IP lc-gA lc-gB (list '* '(lcc_ lcn_) lc-tpi))
;; NEGATIVE index -(n+1): the factor (w - c)^n
(define lc-wN (lc-weights! lc-Eneg
  (lambda (Wp) (lc-tptw! Wp (lambda (x) (list 'power (list lc-Zp x) 'lcn_)))
               (dk-cite! 'aif-cont-power-of lc-T lc-Zp 'lcn_ Wp))))
(define lc-xA2 (lc-expand! lc-cp 'r lc-Zp (car lc-wN)))
(define lc-xB2 (lc-expand! lc-cn '(recip r) lc-Zn (cadr lc-wN)))
(define lc-SA2 (cadr lc-xA2))
(define lc-SB2 (cadr lc-xB2))
(define lc-gA2 (car lc-xA2))
(define lc-gB2 (car lc-xB2))
;; A-terms: (w - c)^k (w - c)^n = (w - c)^(n+k) (1/(w - c))^0: all vanish
(define (lc-neg-A-alg! k)
  (lambda (x)
    (let* ((d (list '- x 'c)) (e (list 'recip d)))
      (lc-typ-pw! d k) (lc-typ-pw! d 'lcn_)
      (subst (dk-cite! 'cc-power-add k 'lcn_ d))
      (subst (dk-cite! 'power-zero e))
      (let* ((pk (dk-name! (list 'power d k) 'CC)) (pn (dk-name! (list 'power d 'lcn_) 'CC)))
        (subst (list '= (list 'power d k) pk)) (subst (list '= (list 'power d 'lcn_) pn))
        (crs)))))
(dk-have! (list 'FORALL 'lcj_ (list 'IMPLIES '(IN lcj_ NN) (list '= (list lc-SA2 'lcj_) 0)))
  (lambda ()
    (let* ((k (dk-di-var!)) (j (list '+ 'lcn_ k)))
      (lc-cp-val! k)
      (dk-have! (list 'AND '(IN lcn_ NN) (list 'IN k 'NN)))
      (fact 'nn-add-closed 'lcn_ k)
      (fact 'nn-in-rr k) (fact 'nn-in-rr 'lcn_) (fact 'nn-zero-le k) (fact 'nn-zero-le 'lcn_)
      (fact 'nn-succ-closed j) (fact 'nn-succ-plus-one j) (fact 'nn-in-rr (list 'succ j))
      (let ((eq (lc-term-to-mono! lc-SA2 k j 0 (lc-neg-A-alg! k)
                  (lambda ()
                    (dk-have! (list 'NOT (list '= 0 (list 'succ j)))
                      (lambda () (di) (dk-absurd! (list '= 0 (list 'succ j)) (list '= (list 'succ j) (list '+ j 1)) (list '<= 0 k) '(<= 0 lcn_)
                                                  (list 'IN k 'RR) '(IN lcn_ RR) (list 'IN (list 'succ j) 'RR))))
                    (dk-cite! 'lc-monomial-zero 'c 'r j 0)
                    0))))
        (subst eq)
        (if (dk--redex? (dk-goal)) (dk-lam-b!))
        (crs)))))
(dk-apply! (dk-cite! 'cc-series-of-zeros lc-SA2) (lc-LI lc-gA2))
;; B-terms: (1/(w - c))^k (1/(w - c)) (w - c)^n = (w - c)^n (1/(w - c))^(k+1): 2 pi i at k = n, 0 elsewhere
(define (lc-neg-B-alg! k)
  (lambda (x)
    (let* ((d (list '- x 'c)) (e (list 'recip d)))
      (lc-typ-pw! e k) (lc-typ-pw! d 'lcn_)
      (dk-have! (list 'AND (list 'IN e 'CC) (list 'IN k 'NN)))
      (subst (dk-cite! 'power-succ e k))
      (let* ((ev (dk-name! e 'CC)) (pk (dk-name! (list 'power e k) 'CC)) (pn (dk-name! (list 'power d 'lcn_) 'CC)))
        (subst (list '= (list 'power e k) pk)) (subst (list '= (list 'power d 'lcn_) pn)) (subst (list '= e ev))
        (crs)))))
(dk-have! (list 'FORALL 'lcj_ (list 'IMPLIES '(IN lcj_ NN) (list 'IMPLIES '(NOT (= lcj_ lcn_)) (list '= (list lc-SB2 'lcj_) 0))))
  (lambda ()
    (let* ((pl (dk-peel!)) (k (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) pl)))))
      (fact 'nn-succ-closed k)
      (lc-cp-val! k)
      (let ((eq (lc-term-to-mono! lc-SB2 k 'lcn_ (list 'succ k) (lc-neg-B-alg! k)
                  (lambda ()
                    (dk-have! (list 'NOT (list '= (list 'succ k) '(succ lcn_)))
                      (lambda () (di) (lc-nn-eq! k 'lcn_) (ai (list 'NOT (list '= k 'lcn_)))))
                    (dk-cite! 'lc-monomial-zero 'c 'r 'lcn_ (list 'succ k))
                    0))))
        (subst eq)
        (if (dk--redex? (dk-goal)) (dk-lam-b!))
        (crs)))))
(define lc-Bn (lc-term-to-mono! lc-SB2 'lcn_ 'lcn_ '(succ lcn_) (lc-neg-B-alg! 'lcn_)
                (lambda () (dk-cite! 'lc-monomial-one 'c 'r 'lcn_) lc-tpi)))
(dk-cite! 'cc-series-single-term lc-SB2 'lcn_)
(lc-lim-eq! lc-SB2 (lc-LI lc-gB2) (list lc-SB2 'lcn_))
(define lc-cneg '(lcc_ (- (+ lcn_ 1))))
(dk-have! (list '= (lc-LI lc-gB2) (list '* lc-cneg lc-tpi))
  (lambda () (subst (list '= (lc-LI lc-gB2) (list lc-SB2 'lcn_))) (subst lc-Bn) (subst (list '= (list lc-cn 'lcn_) lc-cneg))
             (if (pair? (dk-open-leaves)) (begin (dk-type! (cadr (dk-goal)) 'CC) (rfl)))))
(define lc-IN (lc-I lc-Eneg))
(lc-split! lc-IN lc-gA2 lc-gB2 lc-Eneg)
(dk-have! (list '= lc-cneg (list '* (list 'recip lc-tpi) (lc-LI lc-IN)))
  (lambda ()
    (subst (list '= (lc-LI lc-IN) (list '+ (lc-LI lc-gA2) (lc-LI lc-gB2))))
    (subst (list '= (lc-LI lc-gA2) 0))
    (subst (list '= (lc-LI lc-gB2) (list '* lc-cneg lc-tpi)))
    (let* ((pv (dk-name! (list 'recip lc-tpi) 'CC)))
      (subst (list '= (list 'recip lc-tpi) pv))
      (dk-have! (list '= (list '* lc-tpi pv) 1) (lambda () (subst (list '= pv (list 'recip lc-tpi))) (ass)))
      (let ((rhs (caddr (dk-goal))))
        (dk-have! (list '= rhs (list '* (list '* lc-tpi pv) lc-cneg)) (lambda () (crs)))
        (subst (list '= rhs (list '* (list '* lc-tpi pv) lc-cneg)))
        (subst (list '= (list '* lc-tpi pv) 1))
        (crs)))))
(dk-conj-close! (lambda () (ass)))
(qed 'laurent-coefficients)

;;; (7) A GEOMETRIC BOUND ON THE COEFFICIENTS BOUNDS THE RADIUS: |cf(k)| <= C (1/q)^k for all k gives
;;;   x < CPS-RADIUS(cf) for every real x < q.
(define lr-S '(SEP cpsr_ RR (AND (<= 0 cpsr_) (SERIES-CONVERGES (VNB-LAMBDA cpsk_ NN (* (magnitude (cf cpsk_)) (power cpsr_ cpsk_)))))))
(define lr-bnd '(FORALL lrk_ (IMPLIES (IN lrk_ NN) (<= (magnitude (cf lrk_)) (* lrc_ (power (recip lrq_) lrk_))))))
(sp (make-wff (list 'FORALL 'cf (list 'IMPLIES '(IN cf (FUN NN CC))
  (list 'FORALL 'lrc_ (list 'IMPLIES '(IN lrc_ RR) (list 'IMPLIES '(<= 0 lrc_)
  (list 'FORALL 'lrq_ (list 'IMPLIES '(IN lrq_ RR) (list 'IMPLIES '(< 0 lrq_) (list 'IMPLIES lr-bnd
  (list 'FORALL 'lrx_ (list 'IMPLIES '(IN lrx_ RR) (list 'IMPLIES '(< lrx_ lrq_) '(< lrx_ (CPS-RADIUS cf))))))))))))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'rr-one-in)
(fact 'cps-radius-in 'cf)
(dk-cite! 'cps-radius-unfold 'cf)
(use-em '(<= 0 lrx_)
  (lambda ()
    (let* ((t '(* 1/2 (+ lrx_ lrq_))) (rq '(recip lrq_)) (tq (list '* t rq))
           (prem (list '(IN lrx_ RR) '(IN lrq_ RR) '(<= 0 lrx_) '(< lrx_ lrq_) '(< 0 lrq_))))
      (dk-type! t 'RR)
      (dk-have! '(<= 0 lrq_) (lambda () (dk-ineq! '(< 0 lrq_))))
      (fact 'rr-pos-ne-zero 'lrq_)
      (dk-have! '(AND (IN lrq_ RR) (NOT (= lrq_ 0))))
      (fact 'rr-recip-closed 'lrq_) (fact 'rr-recip-pos 'lrq_) (fact 'rr-recip-inverse 'lrq_)
      (dk-have! (list '<= 0 t) (lambda () (apply dk-ineq! (cons (list 'IN t 'RR) prem))))
      (dk-have! (list '< 'lrx_ t) (lambda () (apply dk-ineq! (cons (list 'IN t 'RR) prem))))
      (dk-have! (list '< t 'lrq_) (lambda () (apply dk-ineq! (cons (list 'IN t 'RR) prem))))
      (dk-type! tq 'RR)
      (dk-have! (list '<= 0 rq) (lambda () (dk-ineq! (list 'IN rq 'RR) (list '< 0 rq))))
      (dk-have! (list 'AND (list 'IN t 'RR) (list 'IN rq 'RR)))
      (dk-have! (list 'AND (list '<= 0 t) (list '<= 0 rq)))
      (fact 'rr-leq-mul-nonneg t rq)
      (dk-have! (list '< tq 1)
        (lambda ()
          (dk-have! (list '= (list '* tq 'lrq_) t)
            (lambda () (let ((rv (dk-name! rq 'RR))) (subst (list '= rq rv))
                         (dk-have! (list '= (list '* 'lrq_ rv) 1) (lambda () (subst (list '= rv rq)) (ass)))
                         (dk-have! (list '= (list '* (list '* t rv) 'lrq_) (list '* t (list '* 'lrq_ rv))) (lambda () (crs)))
                         (subst (list '= (list '* (list '* t rv) 'lrq_) (list '* t (list '* 'lrq_ rv))))
                         (subst (list '= (list '* 'lrq_ rv) 1)) (crs))))
          (dk-type! (list '* tq 'lrq_) 'RR)
          (dk-have! (list 'NOT (list '<= 1 tq))
            (lambda () (di)
              (dk-have! (list 'AND (list '<= 1 tq) '(<= 0 lrq_)))
              (fact 'rr-mul-le-right 1 tq 'lrq_)
              (dk-absurd! (list 'IN (list '* tq 'lrq_) 'RR) (list 'IN t 'RR) '(IN lrq_ RR) (list '<= '(* 1 lrq_) (list '* tq 'lrq_))
                          (list '= (list '* tq 'lrq_) t) (list '< t 'lrq_))))
          (fact 'rr-not-le-lt 1 tq)
          (if (pair? (dk-open-leaves)) (ass))))
      ;; the geometric majorant converges
      (let* ((gs (list 'VNB-LAMBDA 'n 'NN (list 'power tq 'n)))
             (G (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* 'lrc_ (list 'power tq 'cpsk_))))
             (F (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* '(magnitude (cf cpsk_)) (list 'power t 'cpsk_)))))
        (dk-have! (list 'AND (list '<= 0 tq) (list '< tq 1)))
        (dk-cite! 'geometric-series-converges tq)
        (define (typ-at! k)
          (fact 'power-real-closed tq k) (fact 'power-real-closed t k) (fact 'power-real-closed rq k)
          (fact 'rr-power-nonneg k tq) (fact 'rr-power-nonneg k t)
          (fact 'fun-apply-type-c 'cf 'NN 'CC k) (fact 'cc-magnitude-closed (list 'cf k)) (fact 'cc-magnitude-nonneg (list 'cf k)))
        (for-each (lambda (S)
                    (dk-have! (list 'IN S '(FUN NN RR))
                      (lambda () (dk-lam-type! (lambda () (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                                            (typ-at! k)
                                                            (if (not (sequent-node-grounded? leaf))
                                                                (if (dk-asm? (dk-goal)) (ass) (dk-type! (cadr (dk-goal)) 'RR)))))))))
                  (list gs G F))
        (dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN) (list '<= 0 (list gs 'cpsk_))))
          (lambda () (let ((k (dk-di-var!))) (typ-at! k) (dk-lam-b!) (if (pair? (dk-open-leaves)) (ass)))))
        (dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN) (list '= (list G 'cpsk_) (list '* 'lrc_ (list gs 'cpsk_)))))
          (lambda () (let ((k (dk-di-var!))) (typ-at! k) (dk-lam-b!) (if (pair? (dk-open-leaves)) (begin (dk-type! (cadr (dk-goal)) 'RR) (rfl))))))
        (dk-cite! 'series-scale-converges gs 'lrc_ G)
        (dk-have! (list 'AND (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'AND (list '<= 0 (list F 'n)) (list '<= (list F 'n) (list G 'n)))))
                         (list 'SERIES-CONVERGES G))
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (dk-goal) 'SERIES-CONVERGES) (ass)
                    (let ((k (dk-di-var!)))
                      (typ-at! k)
                      (dk-apply! (dk-ctx-form lr-bnd) k)
                      (dk-lam-b!)
                      (let* ((mc (list 'magnitude (list 'cf k))) (pt (list 'power t k)) (pr (list 'power rq k)) (pq (list 'power tq k)))
                        (fact 'rr-subset-cc t) (fact 'rr-subset-cc rq)
                        (dk-have! (list 'AND (list 'IN t 'CC) (list 'IN rq 'CC)))
                        (dk-cite! 'cc-power-mul-base k t rq)
                        (dk-type! (list '* 'lrc_ pr) 'RR)
                        (dk-have! (list 'AND (list '<= mc (list '* 'lrc_ pr)) (list '<= 0 pt)))
                        (fact 'rr-mul-le-right mc (list '* 'lrc_ pr) pt)
                        (dk-have! (list 'AND (list '<= 0 mc) (list '<= 0 pt)))
                        (dk-have! (list 'AND (list 'IN mc 'RR) (list 'IN pt 'RR)))
                        (fact 'rr-leq-mul-nonneg mc pt)
                        (dk-conj-close!
                          (lambda ()
                            (if (dk-asm? (dk-goal)) (ass)
                                (begin
                                  (subst (list '= pq (list '* pt pr)))
                                  (dk-have! (list '= (list '* 'lrc_ (list '* pt pr)) (list '* (list '* 'lrc_ pr) pt)) (lambda () (crs)))
                                  (subst (list '= (list '* 'lrc_ (list '* pt pr)) (list '* (list '* 'lrc_ pr) pt)))
                                  (ass))))))))))))
        (fact 'comparison-test F G)
        ;; t is in the radius set, so t <= CPS-RADIUS(cf), and x < t
        (dk-have! (list 'SUBSET lr-S 'RR-POS-STAR)
          (lambda () (mac 'subset-def)
                     (let ((x (dk-di-var!))) (sep-me (list 'IN x lr-S)) (dk-split-all!) (mac 'rr-pos-star-membership) (oi-l) (dk-conj-close! (lambda () (ass))))))
        (fact 'esup-in lr-S)
        (dk-have! (list 'IN t lr-S) (lambda () (in-sep! (lambda () (dk-conj-close! (lambda () (ass)))))))
        (dk-cite! 'esup-upper lr-S t)
        (dk-have! '(IN lrx_ RR-POS-STAR) (lambda () (mac 'rr-pos-star-membership) (oi-l) (dk-conj-close! (lambda () (ass)))))
        (dk-have! (list 'IN t 'RR-POS-STAR) (lambda () (mac 'rr-pos-star-membership) (oi-l) (dk-conj-close! (lambda () (ass)))))
        (dk-cite! 'rps-lt-le-trans 'lrx_ t (list 'ESUP lr-S))
        (subst (list '== '(CPS-RADIUS cf) (list 'ESUP lr-S)))
        (ass))))
  (lambda ()
    (fact 'rr-not-le-lt 0 'lrx_)
    (let ((dj (dk-project! '(OR (AND (IN (CPS-RADIUS cf) RR) (<= 0 (CPS-RADIUS cf))) (= (CPS-RADIUS cf) POS-INF)) 'rr-pos-star-membership '(IN (CPS-RADIUS cf) RR-POS-STAR))))
      (use-cases dj
        (lambda () (dk-split-all!) (dk-ineq! '(IN lrx_ RR) '(IN (CPS-RADIUS cf) RR) '(< lrx_ 0) '(<= 0 (CPS-RADIUS cf))))
        (lambda () (dk-cite! 'rr-lt-pos-inf 'lrx_) (subst '(= (CPS-RADIUS cf) POS-INF)) (ass))))))
(qed 'cps-radius-from-bound)
