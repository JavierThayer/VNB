;;; catools-gal-b1.scm -- Euclidean domains (galois-theory notes, Lemma 1.7, Corollary 1.5)
;;; (CA-TOOLS, galois-theory B1, 2026-10-26).  Destination: theorem-library/catools-gal-b1.scm, library algebra.
;;; Vocabulary: catools-gal-vocab.scm (IS-UNIT, DIVIDES, IS-PRIME-ELEMENT, IS-DEGREE-FUNCTION,
;;; IS-EUCLIDEAN-DOMAIN).
;;;
;;;   degree-proper-divisor          LEMMA 1.7: a = k b, a /= 0, k not a unit ==> nu(b) < nu(a)
;;;   euclidean-domain-is-euclidean-ring   the notes' Euclidean domain is the tree's IS-EUCLIDEAN-RING
;;;   euclid-lemma                   COROLLARY 1.5: a prime dividing ab divides a or b
;;; Helper prefix gb1-.
;;; ======================================================================
(define (gb1-op? t op) (and (pair? t) (equal? (car t) (list op 's))))
(define (gb1-in! t)
  (if (not (dk-asm? (list 'IN t '(CARR s))))
      (cond ((gb1-op? t 'MUL) (gb1-in! (cadr t)) (gb1-in! (caddr t)) (dk-cite! 'ring-carrier-closed-mul 's (cadr t) (caddr t)))
            ((gb1-op? t 'ADD) (gb1-in! (cadr t)) (gb1-in! (caddr t)) (dk-cite! 'ring-add-closed 's (cadr t) (caddr t)))
            ((gb1-op? t 'NEG) (gb1-in! (cadr t)) (dk-cite! 'ring-neg-in-carr 's (cadr t)))
            (#t (dk-type! t '(CARR s))))))
(define (gb1-mul a b) (list '(MUL s) a b))
(define (gb1-add a b) (list '(ADD s) a b))
(define (gb1-neg a) (list '(NEG s) a))
(define (gb1-ring!)
  (dk-cite! 'integral-domain-is-commutative-ring 's)
  (dk-cite! 'commutative-ring-is-ring 's)
  (dk-cite! 'ring-one-in 's)
  (dk-cite! 'ring-zero-in 's))

;;; ======================================================================
;;; LEMMA 1.7
;;; ======================================================================
(sp (make-wff '(FORALL s (FORALL dfn (IMPLIES (IS-DEGREE-FUNCTION s dfn)
  (FORALL a (IMPLIES (IN a (CARR s)) (FORALL b (IMPLIES (IN b (CARR s)) (FORALL k (IMPLIES (IN k (CARR s))
    (IMPLIES (NOT (= a (ZERO s))) (IMPLIES (= a ((MUL s) k b)) (IMPLIES (NOT (IS-UNIT s k))
      (< (dfn b) (dfn a))))))))))))))))
(dk-peel!)
(let ((di_ (dk-cite! 'is-degree-function 's 'dfn)))
  (dk-have! (caddr di_) (lambda () (prop)))
  (dk-split-all! (list (caddr di_))))
(gb1-ring!)
(define gb1-p1 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm '<=))) "property (1)"))
(define gb1-p2 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'FORSOME))) "property (2)"))
(define (gb1-nu! t) (gb1-in! t) (fact 'fun-apply-type-c 'dfn '(CARR s) 'NN t) (fact 'nn-in-rr (list 'dfn t)))
;; b /= 0
(dk-have! '(NOT (= b (ZERO s)))
  (lambda ()
    (di)
    (dk-cite! 'ring-mul-zero-right 's 'k)
    (dk-rewrite-h! '(= a ((MUL s) k b)) 'b '(ZERO s))
    (dk-have! '(= a (ZERO s)) (lambda () (subst '(= a ((MUL s) k (ZERO s)))) (ass)))
    (dk-only! '(= a (ZERO s)) '(NOT (= a (ZERO s))))
    (prop)))
(let* ((q (dk-skolem! (dk-apply! gb1-p2 'a 'b)))
       (_ (dk-split-all!))
       (kq (gb1-mul 'k q))
       (aq (gb1-mul 'a q))
       (omk (gb1-add '(ONE s) (gb1-neg kq))))
  (gb1-in! kq) (gb1-in! aq) (gb1-in! omk)
  ;; k q /= 1, since k is not a unit
  (dk-have! (list 'NOT (list '= kq '(ONE s)))
    (lambda ()
      (di)
      (let ((ui (dk-cite! 'is-unit 's 'k)))
        (dk-have! (caddr ui) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew q) (dk-conj-close!)))))))
        (dk-only! ui (caddr ui) '(NOT (IS-UNIT s k)))
        (prop))))
  ;; 1 - k q /= 0
  (dk-have! (list 'NOT (list '= omk '(ZERO s)))
    (lambda ()
      (di)
      (dk-have! (list '= '(ONE s) (gb1-add omk kq)) (lambda () (crs)))
      (dk-rewrite-h! (list '= '(ONE s) (gb1-add omk kq)) omk '(ZERO s))
      (dk-have! (list '= kq '(ONE s)) (lambda () (subst (list '= '(ONE s) (gb1-add '(ZERO s) kq))) (crs)))
      (dk-only! (list '= kq '(ONE s)) (list 'NOT (list '= kq '(ONE s))))
      (prop)))
  ;; not (b = a q): else a (1 - k q) = 0
  (dk-have! (list 'NOT (list '= 'b aq))
    (lambda ()
      (di)
      (dk-rewrite-h! '(= a ((MUL s) k b)) 'b aq)
      (dk-have! (list '= (gb1-mul omk 'a) '(ZERO s))
        (lambda ()
          (dk-have! (list '= (gb1-mul omk 'a) (gb1-add 'a (gb1-neg (gb1-mul 'k aq)))) (lambda () (crs)))
          (subst (list '= (gb1-mul omk 'a) (gb1-add 'a (gb1-neg (gb1-mul 'k aq)))))
          (subst (list '= (gb1-mul 'k aq) 'a))
          (crs)))
      (dk-cite! 'integral-domain-cancel-zero 's omk 'a)
      (dk-only! (list '= omk '(ZERO s)) (list 'NOT (list '= omk '(ZERO s))))
      (prop)))
  (let* ((r (gb1-add 'b (gb1-neg aq))))
    (gb1-in! r)
    (dk-have! (list '< (list 'dfn r) '(dfn a)) (lambda () (dk-only! (list 'OR (list '= 'b aq) (list '< (list 'dfn r) '(dfn a))) (list 'NOT (list '= 'b aq))) (prop)))
    ;; r = b (1 - k q)
    (dk-have! (list '= r (gb1-mul 'b omk))
      (lambda ()
        (subst '(= a ((MUL s) k b)))
        (crs)))
    (dk-apply! gb1-p1 'b omk)
    (gb1-nu! 'b) (gb1-nu! 'a) (gb1-nu! r) (gb1-nu! (gb1-mul 'b omk))
    (dk-rewrite-h! (list '< (list 'dfn r) '(dfn a)) r (gb1-mul 'b omk))
    (dk-ineq! (list '<= '(dfn b) (list 'dfn (gb1-mul 'b omk)))
              (list '< (list 'dfn (gb1-mul 'b omk)) '(dfn a)))))
(qed 'degree-proper-divisor)
(topic! 'degree-proper-divisor 'algebra)

;;; ======================================================================
;;; the notes' Euclidean domain is a Euclidean ring of the tree
;;; ======================================================================
(sp (make-wff '(FORALL s (IMPLIES (IS-EUCLIDEAN-DOMAIN s) (IS-EUCLIDEAN-RING s)))))
(dk-peel!)
(let ((ei (dk-cite! 'is-euclidean-domain 's)))
  (dk-have! (caddr ei) (lambda () (prop)))
  (dk-split-all! (list (caddr ei))))
(define gb2-nu (dk-skolem! (dk-pick (lambda (fm) (dk-head-is? fm 'FORSOME)) "the degree function")))
(let ((di_ (dk-cite! 'is-degree-function 's gb2-nu)))
  (dk-have! (caddr di_) (lambda () (prop)))
  (dk-split-all! (list (caddr di_))))
(gb1-ring!)
(define gb2-p2 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'FORSOME))) "property (2)"))
(let ((ri (dk-cite! 'is-euclidean-ring-def 's)))
  (dk-have! (caddr ri)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (begin
                (ew gb2-nu)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-asm? (dk-goal))
                        (ass)
                        (let* ((ls (dk-peel!))
                               (ins (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) '(CARR s)))) ls))
                               (g (dk-goal))
                               (b (let ((ne (car (filter (dk-head? 'NOT) ls)))) (cadr (cadr ne))))
                               (a (cadr (car (filter (lambda (fm) (not (eq? (cadr fm) b))) ins))))
                               (q (dk-skolem! (dk-apply! gb2-p2 b a)))
                               (_ (dk-split-all!))
                               (bq (gb1-mul b q))
                               (r (gb1-add a (gb1-neg bq))))
                          (gb1-in! r)
                          (ew q)
                          (dk-conj-close!
                            (lambda ()
                              (if (dk-asm? (dk-goal))
                                  (ass)
                                  (begin
                                    (ew r)
                                    (dk-conj-close!
                                      (lambda ()
                                        (let ((g2 (dk-goal)))
                                          (cond ((dk-asm? g2) (ass))
                                                ((dk-head-is? g2 '=) (crs))
                                                (#t
                                                 (use-em (list '= a bq)
                                                   (lambda ()
                                                     (dk-have! (list '= r '(ZERO s)) (lambda () (subst (list '= a bq)) (crs)))
                                                     (prop))
                                                   (lambda ()
                                                     (fact 'fun-apply-type-c gb2-nu '(CARR s) 'NN r)
                                                     (fact 'fun-apply-type-c gb2-nu '(CARR s) 'NN b)
                                                     (dk-have! (list '< (list gb2-nu r) (list gb2-nu b))
                                                       (lambda () (dk-only! (list 'OR (list '= a bq) (list '< (list gb2-nu r) (list gb2-nu b))) (list 'NOT (list '= a bq))) (prop)))
                                                     (dk-cite! 'nn-lt-succ-le (list gb2-nu r) (list gb2-nu b))
                                                     (prop))))))))))))))))))))))
  (prop))
(qed 'euclidean-domain-is-euclidean-ring)
(topic! 'euclidean-domain-is-euclidean-ring 'algebra)

;;; ======================================================================
;;; the ideal u p + v a, and COROLLARY 1.5 (Euclid's lemma)
;;; ======================================================================
(define (gb3-idl p a)
  (list 'SEP 'gix_ '(CARR s)
        (list 'FORSOME 'giu_ (list 'AND '(IN giu_ (CARR s))
          (list 'FORSOME 'giv_ (list 'AND '(IN giv_ (CARR s))
            (list '= 'gix_ (gb1-add (gb1-mul 'giu_ p) (gb1-mul 'giv_ a)))))))))
;; close (IN x IDL) with the coefficients u, v (both typed); EQ! proves x = u p + v a
(define (gb3-in! x idl u v eq!)
  (gb1-in! x)
  (for-each (lambda (lv)
              (if (memq lv (dk-open-leaves))
                  (begin (dk-focus! lv)
                         (if (dk-asm? (dk-goal))
                             (ass)
                             (begin (ew u) (dk-conj-close!
                                       (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                      (begin (ew v) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (eq!)))))))))))))
            (dk-opened (lambda () (sep-mi)))))
;; open (IN x IDL): land x in CARR and x = u p + v a; return (u . v)
(define (gb3-out! x idl)
  (sep-me (list 'IN x idl))
  (let* ((u (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm x))) "the u coefficient")))
         (_ (dk-split-all!))
         (v (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm x))) "the v coefficient"))))
    (dk-split-all!)
    (cons u v)))

(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-COMMUTATIVE-RING s)
  (list 'FORALL 'p (list 'IMPLIES '(IN p (CARR s)) (list 'FORALL 'a (list 'IMPLIES '(IN a (CARR s))
    (list 'IS-IDEAL 's (gb3-idl 'p 'a))))))))))
(dk-peel!)
(dk-cite! 'commutative-ring-is-ring 's)
(dk-cite! 'ring-one-in 's)
(dk-cite! 'ring-zero-in 's)
(define gb3-I (gb3-idl 'p 'a))
(let ((ii (dk-cite! 'is-ideal 's gb3-I)))
  (dk-have! (caddr ii)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-asm? g) (ass))
              ((dk-head-is? g 'SUBSET) (let ((x (subset-by-element!))) (sep-me (list 'IN x gb3-I)) (ass)))
              ((dk-head-is? g 'IN)
               (gb3-in! '(ZERO s) gb3-I '(ZERO s) '(ZERO s) (lambda () (crs))))
              (#t
               (let* ((ls (dk-peel!))
                      (vs (map cadr (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) gb3-I))) ls)))
                      (rs (map cadr (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) '(CARR s)))) ls)))
                      (cs (map (lambda (x) (gb3-out! x gb3-I)) vs))
                      (gl (cadr (dk-goal))))
                 (cond
                   ((= (length vs) 2)
                    (let ((u (gb1-add (car (car cs)) (car (cadr cs)))) (v (gb1-add (cdr (car cs)) (cdr (cadr cs)))))
                      (gb1-in! u) (gb1-in! v)
                      (gb3-in! gl gb3-I u v
                        (lambda ()
                          (subst (dk-pick (lambda (fm) (and (dk-head-is? fm '=) (eq? (cadr fm) (car vs)))) "eq1"))
                          (subst (dk-pick (lambda (fm) (and (dk-head-is? fm '=) (eq? (cadr fm) (cadr vs)))) "eq2"))
                          (crs)))))
                   ((null? rs)
                    (let ((u (gb1-neg (car (car cs)))) (v (gb1-neg (cdr (car cs)))))
                      (gb1-in! u) (gb1-in! v)
                      (gb3-in! gl gb3-I u v
                        (lambda ()
                          (subst (dk-pick (lambda (fm) (and (dk-head-is? fm '=) (eq? (cadr fm) (car vs)))) "eq1"))
                          (crs)))))
                   (#t
                    (let ((u (gb1-mul (car rs) (car (car cs)))) (v (gb1-mul (car rs) (cdr (car cs)))))
                      (gb1-in! u) (gb1-in! v)
                      (gb3-in! gl gb3-I u v
                        (lambda ()
                          (subst (dk-pick (lambda (fm) (and (dk-head-is? fm '=) (eq? (cadr fm) (car vs)))) "eq1"))
                          (crs))))))))))))))
  (prop))
(qed 'two-element-ideal)
(topic! 'two-element-ideal 'algebra)

(sp (make-wff '(FORALL s (IMPLIES (IS-EUCLIDEAN-DOMAIN s) (FORALL p (IMPLIES (IS-PRIME-ELEMENT s p)
  (FORALL a (IMPLIES (IN a (CARR s)) (FORALL b (IMPLIES (IN b (CARR s))
    (IMPLIES (DIVIDES s p ((MUL s) a b)) (OR (DIVIDES s p a) (DIVIDES s p b)))))))))))))
(dk-peel!)
(dk-cite! 'euclidean-domain-is-euclidean-ring 's)
(let ((ei (dk-cite! 'is-euclidean-domain 's)))
  (dk-have! (caddr ei) (lambda () (dk-close-if! (lambda () (dk-only! ei '(IS-EUCLIDEAN-DOMAIN s))) prop)))
  (dk-split-all! (list (caddr ei))))
(gb1-ring!)
(let ((pi (dk-cite! 'is-prime-element 's 'p)))
  (dk-have! (caddr pi) (lambda () (dk-close-if! (lambda () (dk-only! pi '(IS-PRIME-ELEMENT s p))) prop)))
  (dk-split-all! (list (caddr pi))))
(define gb4-pr (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-UNIT))) "p is prime"))
(gb1-in! '((MUL s) a b))
(define gb4-c
  (let ((di_ (dk-cite! 'divides 's 'p '((MUL s) a b))))
    (dk-have! (caddr di_) (lambda () (dk-close-if! (lambda () (dk-only! di_ '(DIVIDES s p ((MUL s) a b)))) prop)))
    (dk-split-all! (list (caddr di_)))
    (let ((c (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm '((MUL s) a b)))) "the cofactor"))))
      (dk-split-all!)
      c)))
(define gb4-I (gb3-idl 'p 'a))
(dk-cite! 'two-element-ideal 's 'p 'a)
(define gb4-g (dk-skolem! (dk-cite! 'euclidean-ideal-has-generator 's gb4-I)))
(dk-split-all!)
(define gb4-gen (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'PRINCIPAL-IDEAL))) "the generator clause"))
(define (gb4-mult! x)              ; x in I: return k with x = k g
  (dk-apply! gb4-gen x)
  (let ((pm (dk-cite! 'principal-ideal-membership 's gb4-g x)))
    (dk-have! (caddr pm) (lambda () (dk-close-if! (lambda () (dk-only! pm (list 'IN x (list 'PRINCIPAL-IDEAL 's gb4-g)))) prop)))
    (dk-split-all! (list (caddr pm)))
    (let ((k (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm x) (dk-contains? fm gb4-g))) "the multiplier"))))
      (dk-split-all!)
      k)))
(dk-have! (list 'IN 'p gb4-I) (lambda () (gb3-in! 'p gb4-I '(ONE s) '(ZERO s) (lambda () (crs)))))
(dk-have! (list 'IN 'a gb4-I) (lambda () (gb3-in! 'a gb4-I '(ZERO s) '(ONE s) (lambda () (crs)))))
(define gb4-k (gb4-mult! 'p))
(define gb4-m (gb4-mult! 'a))
(define gb4-uv (gb3-out! gb4-g gb4-I))
(dk-apply! gb4-pr gb4-k gb4-g)
(define (gb4-divides! x kk eq!)    ; close (DIVIDES s p x) with x = kk p
  (gb1-in! kk)
  (let ((di_ (dk-cite! 'divides 's 'p x)))
    (dk-have! (caddr di_)
      (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew kk) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (eq!))))))))))
    (dk-close-if! (lambda () (dk-only! di_ (caddr di_))) prop)))
(use-em (list 'IS-UNIT 's gb4-k)
  (lambda ()
    ;; k is a unit: g = z p, so p divides a = m g
    (let ((ui (dk-cite! 'is-unit 's gb4-k)))
      (dk-have! (caddr ui) (lambda () (dk-close-if! (lambda () (dk-only! ui (list 'IS-UNIT 's gb4-k))) prop)))
      (dk-split-all! (list (caddr ui))))
    (let* ((z (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm gb4-k) (dk-contains? fm '(ONE s)))) "the inverse of k")))
           (_ (dk-split-all!))
           (k gb4-k) (g gb4-g) (m gb4-m)
           (mz (gb1-mul m z)))
      (dk-have! (list 'DIVIDES 's 'p 'a)
        (lambda ()
          (gb4-divides! 'a mz
            (lambda ()
              (subst (list '= 'a (gb1-mul m g)))
              (subst (list '= 'p (gb1-mul k g)))
              (dk-have! (list '= (gb1-mul mz (gb1-mul k g)) (gb1-mul (gb1-mul m g) (gb1-mul k z))) (lambda () (crs)))
              (subst (list '= (gb1-mul mz (gb1-mul k g)) (gb1-mul (gb1-mul m g) (gb1-mul k z))))
              (subst (list '= (gb1-mul k z) '(ONE s)))
              (crs)))))
      (prop)))
  (lambda ()
    ;; g is a unit: 1 is in I, so p divides b
    (dk-have! (list 'IS-UNIT 's gb4-g) (lambda () (dk-only! (list 'OR (list 'IS-UNIT 's gb4-k) (list 'IS-UNIT 's gb4-g)) (list 'NOT (list 'IS-UNIT 's gb4-k))) (prop)))
    (let ((ui (dk-cite! 'is-unit 's gb4-g)))
      (dk-have! (caddr ui) (lambda () (dk-close-if! (lambda () (dk-only! ui (list 'IS-UNIT 's gb4-g))) prop)))
      (dk-split-all! (list (caddr ui))))
    (let* ((w (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm gb4-g) (dk-contains? fm '(ONE s)))) "the inverse of g")))
           (_ (dk-split-all!))
           (g gb4-g) (u (car gb4-uv)) (v (cdr gb4-uv)) (c gb4-c)
           (kp (gb1-add (gb1-mul (gb1-mul u w) 'b) (gb1-mul (gb1-mul v w) c)))
           (x1 (gb1-add (gb1-mul (gb1-mul u w) (gb1-mul 'b 'p)) (gb1-mul (gb1-mul v w) (gb1-mul c 'p))))
           (x2 (gb1-add (gb1-mul (gb1-mul u w) (gb1-mul 'b 'p)) (gb1-mul (gb1-mul v w) (gb1-mul 'a 'b))))
           (gu (gb1-add (gb1-mul u 'p) (gb1-mul v 'a))))
      (dk-have! (list 'DIVIDES 's 'p 'b)
        (lambda ()
          (gb4-divides! 'b kp
            (lambda ()
              (dk-have! (list '= (gb1-mul kp 'p) x1) (lambda () (crs)))
              (subst (list '= (gb1-mul kp 'p) x1))
              (subst (list '= (gb1-mul c 'p) (gb1-mul 'a 'b)))
              (dk-have! (list '= x2 (gb1-mul (gb1-mul w 'b) gu)) (lambda () (crs)))
              (subst (list '= x2 (gb1-mul (gb1-mul w 'b) gu)))
              (subst (list '= gu g))
              (dk-have! (list '= (gb1-mul (gb1-mul w 'b) g) (gb1-mul 'b (gb1-mul g w))) (lambda () (crs)))
              (subst (list '= (gb1-mul (gb1-mul w 'b) g) (gb1-mul 'b (gb1-mul g w))))
              (subst (list '= (gb1-mul g w) '(ONE s)))
              (crs)))))
      (prop))))
(qed 'euclid-lemma)
(topic! 'euclid-lemma 'algebra)
