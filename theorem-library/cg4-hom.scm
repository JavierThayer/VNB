;;; cg4-hom.scm -- the extension psi of a group segment is a homomorphism R -> G (Prop. 5.36):
;;; first on t >= 0 (psi(n al + r) = c^n phi(r), the overflow of phi past al), then on all of R
;;; through psi(t) = psi(-t)^-1 for t < 0.
;;; Agent ISOM, 2026-10-26/27.  Helper prefix: hm4-.  Library: analysis.

(define (hm4-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (hm4-ass-rfl!) (if (dk-asm? (dk-goal)) (ass) (rfl)))
(define (hm4-split-if! pred)
  (let ((hs (filter (lambda (h) (and (dk-head-is? h 'AND) (pred h))) (dk-asms))))
    (if (pair? hs) (dk-split-all! hs))))
(define (hm4-op x y) (list '(OPR g) x y))
(define (hm4-inv x) (list '(INV g) x))
(define hm4-E '(IDEN g))
(define hm4-c '(phi al))
(define (hm4-pow n) (list 'GPOW 'g hm4-c n))
(define (hm4-P t) (list 'OPG-VAL 'g 'al 'phi t))
(define (hm4-forall vs body) (if (null? vs) body (list 'FORALL (car vs) (hm4-forall (cdr vs) body))))
(define (hm4-implies hs concl) (if (null? hs) concl (list 'IMPLIES (car hs) (hm4-implies (cdr hs) concl))))
(define hm4-law '(FORALL gsr_ (IMPLIES (IN gsr_ (CCINT 0 al)) (FORALL gsu_ (IMPLIES (IN gsu_ (CCINT 0 al))
                   (IMPLIES (<= (+ gsr_ gsu_) al) (= (phi (+ gsr_ gsu_)) ((OPR g) (phi gsr_) (phi gsu_)))))))))
(define hm4-hyps (list '(IS-GROUP g) '(IN al RR) '(< 0 al) '(IN phi (FUN (CCINT 0 al) (CARR g))) hm4-law))
(define (hm4-cc! t)
  (let ((iff (dk-cite! 'ccint-membership 0 'al t)))
    (if (not (dk-asm? (cadr iff)))
        (begin (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (hm4-ass!)))))
               (dk-meta-iff-l! iff)))
    (dk-cite! 'fun-apply-type-c 'phi '(CCINT 0 al) '(CARR g) t)))
(define (hm4-cl! a b) (dk-cite! 'group-carrier-closed-opr 'g a b) (hm4-op a b))
(define (hm4-setup!)
  (fact 'rr-zero-in) (fact 'rr-one-in) (fact 'group-identity-in 'g)
  (dk-have! '(<= 0 al) (lambda () (dk-ineq! '(< 0 al))))
  (dk-have! '(<= al al) (lambda () (dk-ineq!)))
  (hm4-cc! 'al)
  (dk-cite! 'rr-pos-rr-of-lt 'al))
(define (hm4-floor! u)                   ; u real, 0 <= u: (n r), r = u - n al in [0, al)
  (let* ((n (dk-skolem! (dk-cite! 'rr-nn-floor-mul u 'al))))
    (hm4-split-if! (lambda (h) (dk-contains? h n)))
    (hm4-split-if! (lambda (h) (dk-contains? h n)))
    (dk-cite! 'nn-in-rr n)
    (let ((r (list '- u (list '* n 'al))))
      (dk-real! (list '* n 'al)) (dk-real! r)
      (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '<= (list '* n 'al) u))))
      (dk-have! (list '< r 'al) (lambda () (dk-ineq! (list '< u (list '+ (list '* n 'al) 'al)))))
      (dk-have! (list '<= r 'al) (lambda () (dk-ineq! (list '< r 'al))))
      (dk-real! (list '+ (list '* n 'al) r))
      (dk-have! (list '= u (list '+ (list '* n 'al) r)) (lambda () (crs)))
      (hm4-cc! r)
      (dk-cite! 'gpow-type n 'g hm4-c)
      (hm4-cl! (hm4-pow n) (list 'phi r))
      (list n r))))

;;; ---- two group facts ----
(sp (make-wff (hm4-forall '(g x) (hm4-implies (list '(IS-GROUP g) '(IN x (CARR g))) '(= (GPOW g x 1) x)))))
(dk-peel!)
(fact 'nn-zero-in)
(fact 'group-identity-in 'g)
(dk-cite! 'gpow-succ 'g 'x 0)
(dk-cite! 'gpow-zero 'g 'x)
(dk-cite! 'nn-succ-plus-one 0)
(dk-have! '(= (succ 0) 1) (lambda () (subst '(= (succ 0) (+ 0 1))) (crs)))
(dk-rewrite-h! '(== (GPOW g x (succ 0)) ((OPR g) x (GPOW g x 0))) '(succ 0) 1)
(dk-split-all! (list (dk-cite! 'group-right-inv-id 'g 'x)))
(subst '(= (GPOW g x 1) ((OPR g) x (GPOW g x 0))))
(subst (list '= '(GPOW g x 0) hm4-E))
(subst (list '= (hm4-op 'x hm4-E) 'x))
(hm4-ass-rfl!)
(qed 'gpow-one)
(topic! 'gpow-one 'algebra)

(sp (make-wff (hm4-forall '(g a b c d)
   (hm4-implies (list '(IS-GROUP g) '(IN a (CARR g)) '(IN b (CARR g)) '(IN c (CARR g)) '(IN d (CARR g)) (list '= (hm4-op 'b 'c) (hm4-op 'c 'b)))
     (list '= (hm4-op (hm4-op 'a 'b) (hm4-op 'c 'd)) (hm4-op (hm4-op 'a 'c) (hm4-op 'b 'd)))))))
(dk-peel!)
(for-each (lambda (pq) (hm4-cl! (car pq) (cadr pq)))
          (list '(a b) '(c d) '(b c) '(c b) '(a c) '(b d)))
(hm4-cl! (hm4-op 'b 'c) 'd) (hm4-cl! (hm4-op 'c 'b) 'd) (hm4-cl! 'b (hm4-op 'c 'd)) (hm4-cl! 'c (hm4-op 'b 'd))
(dk-cite! 'group-assoc 'g 'a 'b (hm4-op 'c 'd))
(dk-cite! 'group-assoc 'g 'b 'c 'd)
(dk-cite! 'group-assoc 'g 'c 'b 'd)
(dk-cite! 'group-assoc 'g 'a 'c (hm4-op 'b 'd))
(subst (list '= (hm4-op (hm4-op 'a 'b) (hm4-op 'c 'd)) (hm4-op 'a (hm4-op 'b (hm4-op 'c 'd)))))
(subst (list '= (hm4-op 'b (hm4-op 'c 'd)) (hm4-op (hm4-op 'b 'c) 'd)))
(subst (list '= (hm4-op 'b 'c) (hm4-op 'c 'b)))
(subst (list '= (hm4-op (hm4-op 'c 'b) 'd) (hm4-op 'c (hm4-op 'b 'd))))
(subst (list '= (hm4-op (hm4-op 'a 'c) (hm4-op 'b 'd)) (hm4-op 'a (hm4-op 'c (hm4-op 'b 'd)))))
(hm4-ass-rfl!)
(qed 'group-interchange)
(topic! 'group-interchange 'algebra)

;;; ---- the values of psi ----
(sp (make-wff (hm4-forall '(g al phi n r t) (hm4-implies (append hm4-hyps
   (list '(IN n NN) '(IN r RR) '(<= 0 r) '(< r al) '(IN t RR) '(<= 0 t) '(= t (+ (* n al) r))))
     (list '= (hm4-P 't) (hm4-op (hm4-pow 'n) '(phi r)))))))
(dk-peel!)
(hm4-setup!)
(dk-have! '(<= r al) (lambda () (dk-ineq! '(< r al))))
(hm4-cc! 'r)
(dk-cite! 'gpow-type 'n 'g hm4-c)
(define hm4-y (hm4-cl! (hm4-pow 'n) '(phi r)))
(let ((iff (dk-cite! 'opg-rep 'g 'al 'phi 't hm4-y)))
  (dk-have! (caddr iff)
    (lambda () (oi-l)
      (dk-conj-close!
       (lambda ()
         (if (dk-head-is? (dk-goal) 'FORSOME)
             (begin (ew 'n)
                    (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'FORSOME)
                                                   (begin (ew 'r) (dk-conj-close! hm4-ass-rfl!))
                                                   (hm4-ass!)))))
             (hm4-ass!))))))
  (dk-meta-iff-l! iff))
(dk-cite! 'opg-val-value 'g 'al 'phi 't hm4-y)
(hm4-ass!)
(qed 'opg-val-nonneg)
(topic! 'opg-val-nonneg 'analysis)

;;; ---- psi(a + b) = psi(a) psi(b) for a, b >= 0 ----
(sp (make-wff (hm4-forall '(g al phi a b) (hm4-implies (append hm4-hyps (list '(IN a RR) '(<= 0 a) '(IN b RR) '(<= 0 b)))
   (list '= (hm4-P '(+ a b)) (hm4-op (hm4-P 'a) (hm4-P 'b)))))))
(dk-peel!)
(hm4-setup!)
(let* ((nr1 (hm4-floor! 'a)) (n1 (car nr1)) (r1 (cadr nr1))
       (nr2 (hm4-floor! 'b)) (n2 (car nr2)) (r2 (cadr nr2))
       (p1 (hm4-op (hm4-pow n1) (list 'phi r1))) (p2 (hm4-op (hm4-pow n2) (list 'phi r2)))
       (n12 (list '+ n1 n2)) (r12 (list '+ r1 r2)))
  (dk-real! '(+ a b))
  (dk-have! '(<= 0 (+ a b)) (lambda () (dk-ineq! '(<= 0 a) '(<= 0 b))))
  (dk-real! r12)
  (dk-meta-and! (list 'IN n1 'NN) (list 'IN n2 'NN))
  (dk-cite! 'nn-add-closed n1 n2)
  (dk-cite! 'gpow-type n12 'g hm4-c)
  (dk-cite! 'opg-val-nonneg 'g 'al 'phi n1 r1 'a)
  (dk-cite! 'opg-val-nonneg 'g 'al 'phi n2 r2 'b)
  (subst (list '= (hm4-P 'a) p1))
  (subst (list '= (hm4-P 'b) p2))
  ;; c^n1 c^n2 (phi r1 phi r2) = (c^n1 phi r1)(c^n2 phi r2)
  (hm4-cl! (list 'phi r1) (list 'phi r2))
  (hm4-cl! (hm4-pow n1) (hm4-pow n2))
  (dk-cite! 'segment-commutes-with-end 'g 'al 'phi r1)
  (dk-cite! 'gpow-commute n2 'g hm4-c (list 'phi r1))
  (dk-cite! 'group-interchange 'g (hm4-pow n1) (list 'phi r1) (hm4-pow n2) (list 'phi r2))
  (dk-cite! 'gpow-add n2 'g hm4-c n1)
  (define (hm4-finish!)                  ; goal (= (OPR (GPOW n12) (OPR phi r1 phi r2)) (OPR p1 p2))
    (subst (list '= (hm4-op p1 p2) (hm4-op (hm4-op (hm4-pow n1) (hm4-pow n2)) (hm4-op (list 'phi r1) (list 'phi r2)))))
    (subst (list '= (hm4-pow n12) (hm4-op (hm4-pow n1) (hm4-pow n2))))
    (hm4-ass-rfl!))
  (use-em (list '< r12 'al)
    (lambda ()
      (dk-cite! 'nn-in-rr n12)
      (dk-real! (list '* n12 'al))
      (dk-have! (list '= '(+ a b) (list '+ (list '* n12 'al) r12)) (lambda () (crs)))
      (dk-have! (list '<= 0 r12) (lambda () (dk-ineq! (list '<= 0 r1) (list '<= 0 r2))))
      (dk-have! (list '<= r12 'al) (lambda () (dk-ineq! (list '< r12 'al))))
      (hm4-cc! r12)
      (dk-cite! 'opg-val-nonneg 'g 'al 'phi n12 r12 '(+ a b))
      (dk-apply! (dk-ctx-form hm4-law) r1 r2)
      (subst (list '= (hm4-P '(+ a b)) (hm4-op (hm4-pow n12) (list 'phi r12))))
      (subst (list '= (list 'phi r12) (hm4-op (list 'phi r1) (list 'phi r2))))
      (hm4-finish!))
    (lambda ()
      (let* ((n3 (list '+ n12 1)) (d (list '- r12 'al)))
        (dk-have! '(IN 1 NN) (lambda () (arith)))
        (dk-meta-and! (list 'IN n12 'NN) '(IN 1 NN))
        (dk-cite! 'nn-add-closed n12 1)
        (dk-cite! 'nn-in-rr n3)
        (dk-real! (list '* n3 'al)) (dk-real! d)
        (dk-have! (list '<= 'al r12) (lambda () (dk-cite! 'rr-lt-trichotomy r12 'al)
                                             (use-em (list '= r12 'al)
                                               (lambda () (dk-ineq! (list '= r12 'al)))
                                               (lambda () (dk-have! (list '< 'al r12)
                                                            (lambda () (if (dk-only! (list 'OR (list '< r12 'al) (list 'OR (list '= r12 'al) (list '< 'al r12)))
                                                                                     (list 'NOT (list '< r12 'al)) (list 'NOT (list '= r12 'al))) (prop))))
                                                          (dk-ineq! (list '< 'al r12))))))
        (dk-have! (list '<= 0 d) (lambda () (dk-ineq! (list '<= 'al r12))))
        (dk-have! (list '< d 'al) (lambda () (dk-ineq! (list '< r1 'al) (list '< r2 'al))))
        (dk-have! (list '= '(+ a b) (list '+ (list '* n3 'al) d)) (lambda () (crs)))
        (dk-cite! 'gpow-type n3 'g hm4-c)
        (dk-have! (list '<= d 'al) (lambda () (dk-ineq! (list '< d 'al))))
        (hm4-cc! d)
        (dk-cite! 'opg-val-nonneg 'g 'al 'phi n3 d '(+ a b))
        (dk-cite! 'segment-overflow 'g 'al 'phi r1 r2)
        (dk-cite! 'gpow-add 1 'g hm4-c n12)
        (dk-cite! 'gpow-one 'g hm4-c)
        (hm4-cl! (hm4-pow n12) hm4-c) (hm4-cl! hm4-c (list 'phi d)) (hm4-cl! (hm4-pow n12) (hm4-op hm4-c (list 'phi d)))
        (dk-cite! 'group-assoc 'g (hm4-pow n12) hm4-c (list 'phi d))
        (subst (list '= (hm4-P '(+ a b)) (hm4-op (hm4-pow n3) (list 'phi d))))
        (subst (list '= (hm4-pow n3) (hm4-op (hm4-pow n12) (hm4-pow 1))))
        (subst (list '= (hm4-pow 1) hm4-c))
        (subst (list '= (hm4-op (hm4-op (hm4-pow n12) hm4-c) (list 'phi d)) (hm4-op (hm4-pow n12) (hm4-op hm4-c (list 'phi d)))))
        (subst (list '= (hm4-op hm4-c (list 'phi d)) (hm4-op (list 'phi r1) (list 'phi r2))))
        (hm4-finish!)))))
(qed 'opg-val-additive-nonneg)
(topic! 'opg-val-additive-nonneg 'analysis)

;;; ---- four small group identities ----
(define (hm4-gpre! . xs) (for-each (lambda (x) (dk-cite! 'group-inv-in 'g x)) xs))
(sp (make-wff (hm4-forall '(g a b c) (hm4-implies (list '(IS-GROUP g) '(IN a (CARR g)) '(IN b (CARR g)) '(IN c (CARR g)) (list '= 'a (hm4-op 'b 'c)))
   (list 'AND (list '= 'b (hm4-op 'a (hm4-inv 'c))) (list '= 'c (hm4-op (hm4-inv 'b) 'a)))))))
(dk-peel!)
(fact 'group-identity-in 'g)
(hm4-gpre! 'b 'c)
(hm4-cl! 'a (hm4-inv 'c)) (hm4-cl! (hm4-inv 'b) 'a) (hm4-cl! 'b 'c) (hm4-cl! 'c (hm4-inv 'c)) (hm4-cl! (hm4-inv 'b) 'b)
(dk-split-all! (list (dk-cite! 'group-right-inv-id 'g 'c)))
(dk-split-all! (list (dk-cite! 'group-right-inv-id 'g 'b)))
(dk-cite! 'group-left-inv 'g 'b)
(dk-cite! 'group-left-id 'g 'c)
(dk-cite! 'group-assoc 'g 'b 'c (hm4-inv 'c))
(dk-cite! 'group-assoc 'g (hm4-inv 'b) 'b 'c)
(dk-conj-close!
 (lambda ()
   (if (equal? (cadr (dk-goal)) 'b)
       (begin (subst (list '= 'a (hm4-op 'b 'c)))
              (subst (list '= (hm4-op (hm4-op 'b 'c) (hm4-inv 'c)) (hm4-op 'b (hm4-op 'c (hm4-inv 'c)))))
              (subst (list '= (hm4-op 'c (hm4-inv 'c)) hm4-E))
              (subst (list '= (hm4-op 'b hm4-E) 'b))
              (hm4-ass-rfl!))
       (begin (subst (list '= 'a (hm4-op 'b 'c)))
              (subst (list '= (hm4-op (hm4-inv 'b) (hm4-op 'b 'c)) (hm4-op (hm4-op (hm4-inv 'b) 'b) 'c)))
              (subst (list '= (hm4-op (hm4-inv 'b) 'b) hm4-E))
              (subst (list '= (hm4-op hm4-E 'c) 'c))
              (hm4-ass-rfl!)))))
(qed 'group-solve-factor)
(topic! 'group-solve-factor 'algebra)

(sp (make-wff (hm4-forall '(g a b) (hm4-implies (list '(IS-GROUP g) '(IN a (CARR g)) '(IN b (CARR g)))
   (list 'AND (list '= (hm4-inv (hm4-op 'a (hm4-inv 'b))) (hm4-op 'b (hm4-inv 'a)))
              (list '= (hm4-inv (hm4-op (hm4-inv 'b) 'a)) (hm4-op (hm4-inv 'a) 'b)))))))
(dk-peel!)
(hm4-gpre! 'a 'b)
(dk-cite! 'group-inv-opr 'g 'a (hm4-inv 'b))
(dk-cite! 'group-inv-opr 'g (hm4-inv 'b) 'a)
(dk-cite! 'group-inv-inv 'g 'b)
(dk-cite! 'group-inv-in 'g (hm4-inv 'b))
(hm4-cl! 'b (hm4-inv 'a)) (hm4-cl! (hm4-inv 'a) 'b)
(dk-conj-close!
 (lambda ()
   (let ((lhs (cadr (dk-goal))))
     (subst (list '= lhs (if (equal? (cadr lhs) (hm4-op 'a (hm4-inv 'b)))
                             (hm4-op (hm4-inv (hm4-inv 'b)) (hm4-inv 'a))
                             (hm4-op (hm4-inv 'a) (hm4-inv (hm4-inv 'b))))))
     (subst (list '= (hm4-inv (hm4-inv 'b)) 'b))
     (hm4-ass-rfl!))))
(qed 'group-inv-quotient)
(topic! 'group-inv-quotient 'algebra)

;;; ---- psi on t < 0 ----
(define (hm4-neg x) (list '- 0 x))
(sp (make-wff (hm4-forall '(g al phi t) (hm4-implies (append hm4-hyps (list '(IN t RR) '(< t 0)))
   (list '= (hm4-P 't) (hm4-inv (hm4-P (hm4-neg 't))))))))
(dk-peel!)
(hm4-setup!)
(define hm4-u (hm4-neg 't))
(dk-real! hm4-u)
(dk-have! (list '<= 0 hm4-u) (lambda () (dk-ineq! '(< t 0))))
(let* ((nr (hm4-floor! hm4-u)) (n (car nr)) (r (cadr nr))
       (v (hm4-op (hm4-pow n) (list 'phi r))) (y (hm4-inv v)))
  (dk-cite! 'group-inv-in 'g v)
  (dk-cite! 'opg-val-nonneg 'g 'al 'phi n r hm4-u)
  (let ((iff (dk-cite! 'opg-rep 'g 'al 'phi 't y)))
    (dk-have! (caddr iff)
      (lambda () (oi-r)
        (dk-conj-close!
         (lambda ()
           (if (dk-head-is? (dk-goal) 'FORSOME)
               (begin (ew n)
                      (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'FORSOME)
                                                     (begin (ew r) (dk-conj-close! hm4-ass-rfl!))
                                                     (hm4-ass!)))))
               (hm4-ass!))))))
    (dk-meta-iff-l! iff))
  (dk-cite! 'opg-val-value 'g 'al 'phi 't y)
  (subst (list '= (hm4-P 't) y))
  (subst (list '= (hm4-P hm4-u) v))
  (hm4-ass-rfl!))
(qed 'opg-val-negative)
(topic! 'opg-val-negative 'analysis)

;;; ---- psi(a + b) = psi(a) psi(b) for all real a, b ----
(define (hm4-pt! t) (dk-real! t) (dk-split-all! (list (dk-cite! 'opg-val-rep 'g 'al 'phi t))))
(define (hm4-nonneg-from-not-neg! x)     ; NOT (< x 0) in context: land (<= 0 x)
  (dk-cite! 'rr-lt-trichotomy x 0)
  (dk-have! (list '<= 0 x)
    (lambda () (use-em (list '= x 0)
                 (lambda () (dk-ineq! (list '= x 0)))
                 (lambda () (dk-have! (list '< 0 x) (lambda () (if (dk-only! (list 'OR (list '< x 0) (list 'OR (list '= x 0) (list '< 0 x)))
                                                                             (list 'NOT (list '< x 0)) (list 'NOT (list '= x 0))) (prop))))
                            (dk-ineq! (list '< 0 x)))))))
(define (hm4-sum! x y z)                 ; land (= (+ x y) z) by crs, typed
  (dk-real! (list '+ x y)) (dk-real! z)
  (dk-have! (list '= (list '+ x y) z) (lambda () (crs))))
(define (hm4-hplus! x y z)               ; x, y >= 0, x + y = z: land (= (P z) (OPR (P x) (P y)))
  (dk-cite! 'opg-val-additive-nonneg 'g 'al 'phi x y)
  (hm4-sum! x y z)
  (dk-rewrite-h! (list '= (hm4-P (list '+ x y)) (hm4-op (hm4-P x) (hm4-P y))) (list '+ x y) z))
(sp (make-wff (hm4-forall '(g al phi a b) (hm4-implies (append hm4-hyps (list '(IN a RR) '(IN b RR)))
   (list '= (hm4-P '(+ a b)) (hm4-op (hm4-P 'a) (hm4-P 'b)))))))
(dk-peel!)
(hm4-setup!)
(define hm4-s '(+ a b))
(define hm4-na (hm4-neg 'a))
(define hm4-nb (hm4-neg 'b))
(define hm4-ns (hm4-neg hm4-s))
(for-each hm4-pt! (list 'a 'b hm4-s hm4-na hm4-nb hm4-ns))
(for-each (lambda (x) (dk-cite! 'group-inv-in 'g (hm4-P x))) (list 'a 'b hm4-na hm4-nb hm4-ns))
(define (hm4-case-neg-a!)                ; a < 0
  (dk-have! (list '<= 0 hm4-na) (lambda () (dk-ineq! '(< a 0))))
  (dk-cite! 'opg-val-negative 'g 'al 'phi 'a)
  (use-em '(< b 0)
    (lambda ()                           ; E: a, b < 0
      (dk-have! (list '<= 0 hm4-nb) (lambda () (dk-ineq! '(< b 0))))
      (dk-have! (list '< hm4-s 0) (lambda () (dk-ineq! '(< a 0) '(< b 0))))
      (dk-cite! 'opg-val-negative 'g 'al 'phi 'b)
      (dk-cite! 'opg-val-negative 'g 'al 'phi hm4-s)
      (hm4-hplus! hm4-nb hm4-na hm4-ns)
      (dk-cite! 'group-inv-opr 'g (hm4-P hm4-nb) (hm4-P hm4-na))
      (subst (list '= (hm4-P hm4-s) (hm4-inv (hm4-P hm4-ns))))
      (subst (list '= (hm4-P hm4-ns) (hm4-op (hm4-P hm4-nb) (hm4-P hm4-na))))
      (subst (list '= (hm4-inv (hm4-op (hm4-P hm4-nb) (hm4-P hm4-na))) (hm4-op (hm4-inv (hm4-P hm4-na)) (hm4-inv (hm4-P hm4-nb)))))
      (subst (list '= (hm4-P 'a) (hm4-inv (hm4-P hm4-na))))
      (subst (list '= (hm4-P 'b) (hm4-inv (hm4-P hm4-nb))))
      (hm4-cl! (hm4-inv (hm4-P hm4-na)) (hm4-inv (hm4-P hm4-nb)))
      (hm4-ass-rfl!))
    (lambda ()
      (hm4-nonneg-from-not-neg! 'b)
      (use-em (list '< hm4-s 0)
        (lambda ()                       ; D2: a < 0 <= b, a + b < 0
          (dk-have! (list '<= 0 hm4-ns) (lambda () (dk-ineq! (list '< hm4-s 0))))
          (dk-cite! 'opg-val-negative 'g 'al 'phi hm4-s)
          (hm4-hplus! 'b hm4-ns hm4-na)
          (dk-split-all! (list (dk-cite! 'group-solve-factor 'g (hm4-P hm4-na) (hm4-P 'b) (hm4-P hm4-ns))))
          (dk-split-all! (list (dk-cite! 'group-inv-quotient 'g (hm4-P hm4-na) (hm4-P 'b))))
          (subst (list '= (hm4-P hm4-s) (hm4-inv (hm4-P hm4-ns))))
          (subst (list '= (hm4-P hm4-ns) (hm4-op (hm4-inv (hm4-P 'b)) (hm4-P hm4-na))))
          (subst (list '= (hm4-inv (hm4-op (hm4-inv (hm4-P 'b)) (hm4-P hm4-na))) (hm4-op (hm4-inv (hm4-P hm4-na)) (hm4-P 'b))))
          (subst (list '= (hm4-P 'a) (hm4-inv (hm4-P hm4-na))))
          (hm4-cl! (hm4-inv (hm4-P hm4-na)) (hm4-P 'b))
          (hm4-ass-rfl!))
        (lambda ()                       ; D: a < 0 <= b, 0 <= a + b
          (hm4-nonneg-from-not-neg! hm4-s)
          (hm4-hplus! hm4-na hm4-s 'b)
          (dk-split-all! (list (dk-cite! 'group-solve-factor 'g (hm4-P 'b) (hm4-P hm4-na) (hm4-P hm4-s))))
          (subst (list '= (hm4-P hm4-s) (hm4-op (hm4-inv (hm4-P hm4-na)) (hm4-P 'b))))
          (subst (list '= (hm4-P 'a) (hm4-inv (hm4-P hm4-na))))
          (hm4-cl! (hm4-inv (hm4-P hm4-na)) (hm4-P 'b))
          (hm4-ass-rfl!))))))
(define (hm4-case-nonneg-a!)             ; 0 <= a
  (use-em '(< b 0)
    (lambda ()
      (dk-have! (list '<= 0 hm4-nb) (lambda () (dk-ineq! '(< b 0))))
      (dk-cite! 'opg-val-negative 'g 'al 'phi 'b)
      (use-em (list '< hm4-s 0)
        (lambda ()                       ; C: 0 <= a, b < 0, a + b < 0
          (dk-have! (list '<= 0 hm4-ns) (lambda () (dk-ineq! (list '< hm4-s 0))))
          (dk-cite! 'opg-val-negative 'g 'al 'phi hm4-s)
          (hm4-hplus! hm4-ns 'a hm4-nb)
          (dk-split-all! (list (dk-cite! 'group-solve-factor 'g (hm4-P hm4-nb) (hm4-P hm4-ns) (hm4-P 'a))))
          (dk-split-all! (list (dk-cite! 'group-inv-quotient 'g (hm4-P hm4-nb) (hm4-P 'a))))
          (subst (list '= (hm4-P hm4-s) (hm4-inv (hm4-P hm4-ns))))
          (subst (list '= (hm4-P hm4-ns) (hm4-op (hm4-P hm4-nb) (hm4-inv (hm4-P 'a)))))
          (subst (list '= (hm4-inv (hm4-op (hm4-P hm4-nb) (hm4-inv (hm4-P 'a)))) (hm4-op (hm4-P 'a) (hm4-inv (hm4-P hm4-nb)))))
          (subst (list '= (hm4-P 'b) (hm4-inv (hm4-P hm4-nb))))
          (hm4-cl! (hm4-P 'a) (hm4-inv (hm4-P hm4-nb)))
          (hm4-ass-rfl!))
        (lambda ()                       ; B: 0 <= a, b < 0, 0 <= a + b
          (hm4-nonneg-from-not-neg! hm4-s)
          (hm4-hplus! hm4-s hm4-nb 'a)
          (dk-split-all! (list (dk-cite! 'group-solve-factor 'g (hm4-P 'a) (hm4-P hm4-s) (hm4-P hm4-nb))))
          (subst (list '= (hm4-P hm4-s) (hm4-op (hm4-P 'a) (hm4-inv (hm4-P hm4-nb)))))
          (subst (list '= (hm4-P 'b) (hm4-inv (hm4-P hm4-nb))))
          (hm4-cl! (hm4-P 'a) (hm4-inv (hm4-P hm4-nb)))
          (hm4-ass-rfl!))))
    (lambda ()                           ; A: both >= 0
      (hm4-nonneg-from-not-neg! 'b)
      (dk-cite! 'opg-val-additive-nonneg 'g 'al 'phi 'a 'b)
      (hm4-ass!))))
(use-em '(< a 0)
  hm4-case-neg-a!
  (lambda () (hm4-nonneg-from-not-neg! 'a) (hm4-case-nonneg-a!)))
(qed 'opg-val-additive)
