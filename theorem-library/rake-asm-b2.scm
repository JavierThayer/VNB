;;; rake-asm-b2.scm -- RAKE-ASM-B agent RB-2 (2026-10-12): four assumptions PROVEN.
;;;
;;; Each theorem below is stated LITERALLY as the assumption it replaces, under the
;;; same name; nothing here is asserted.  Helper prefix: rb2-.
;;;
;;;   totally-bounded-has-cauchy-subseq-rad   one citation of the proven rad-free
;;;                                            headline (cauchy-subseq-proof.scm): the
;;;                                            radius sequence is never used
;;;   summable-bound-converges                 summable-bound-implies-cauchy
;;;                                            (rake-series2.scm) + the second conjunct
;;;                                            of IS-COMPLETE, read off by UNFOLDING (not
;;;                                            the asserted complete-cauchy-converges)
;;;   sums-to-unique                           in the metric NAG-METRIC-SPACE(grp):
;;;                                            d(r1,r2) <= d(r1,S) + d(r2,S) < eps with S
;;;                                            the partial sum over fin1 u fin2
;;;   absolute-summable-implies-summable       see its own header below
;;;
;;; Helper theorems proven here on the way (all modulo 0): rb2-nrm-finsum-le,
;;; rb2-dist-union, rb2-dist-subset, rb2-esum-approx, rb2-choice-seq.
;;;
;;; LOAD WINDOW [rake-asm-1 + 1, pss-topics).  lo: the latest citations are the
;;; NORMED-AG norm laws normed-ag-nrm-{type,nonneg,definite,subadditive}
;;; (theorem-library/rake-asm-1.scm); the others are earlier (summable-bound-implies-
;;; cauchy in rake-series2, the nag-metric-* laws in rake-norm-metrics,
;;; totally-bounded-has-cauchy-subsequence in cauchy-subseq-proof, the ESUM laws in
;;; rake-esum-defined / rake-extended-order, the finsum laws, metric-laws, ...).
;;; hi: theorem-library/pss-topics files a topic for absolute-summable-implies-summable
;;; and summable-bound-converges; nothing in the tree cites any of the four names.
;;; Library: analysis.

;;; ---- file-local helpers --------------------------------------------------------
(define (rb2-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; rb2: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l)
                    (display ";;   ") (display (expression->string (dk-goal-of l))) (newline))
                  (proof-leaves))
        (error "rb2: proof not complete" name)))
  (qed name))

(define (rb2-hyp head what) (dk-pick (dk-head? head) what))

;; a def-functor view's slot read-off (rake-norm-metrics.scm's r5r-slot-close!)
(define (rb2-slot-close! view acc)
  (mac view)
  (let loop ((n 0))
    (let ((g (dk-goal)))
      (if (and (< n 8) (not (equal? (cadr g) (caddr g))))
          (begin (quietly (lambda () (slot acc)))
                 (quietly (lambda () (nth-r)))
                 (if (not (equal? (dk-goal) g)) (loop (+ n 1)))))))
  (qrfl))

(define (rb2-readoff! acc src view)
  (let* ((lhs (list acc (list view src)))
         (rhs (list acc src)))
    (dk-have! (list '== lhs rhs) (lambda () (rb2-slot-close! view acc)))
    (dk-have! (list '== rhs lhs) (lambda () (rb2-slot-close! view acc)))))

;; (SUBSET (UNION a b) c) from (SUBSET a c), (SUBSET b c) in context
(define (rb2-union-sub! a b c)
  (dk-have! (list 'SUBSET (list 'UNION a b) c)
    (lambda ()
      (mac 'subset-def)
      (let* ((landed (dk-peel!))
             (mem (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN)
                                               (equal? (caddr f) (list 'UNION a b))))
                              landed))
             (x (cadr mem))
             (cases (dk-landed-1 (lambda () (mac-h 'union-membership mem)))))
        (use-cases cases
          (lambda () (fact 'subset-mem-fwd a c x) (ass))
          (lambda () (fact 'subset-mem-fwd b c x) (ass)))))))

;; (SUBSET a (UNION a b)) and (SUBSET b (UNION a b))
(define (rb2-sub-union! a b)
  (dk-have! (list 'SUBSET b (list 'UNION a b))
    (lambda () (fact 'union-right-subset a b) (ass)))
  (dk-have! (list 'SUBSET a (list 'UNION a b))
    (lambda ()
      (fact 'union-right-subset b a)
      (fact 'union-comm b a)
      (subst (list '= (list 'UNION a b) (list 'UNION b a)))
      (ass))))

;;; =================================================================================
;;; totally-bounded-has-cauchy-subseq-rad: the radius sequence is idle; the rad-free
;;; headline (theorem-library/cauchy-subseq-proof.scm) is exactly the conclusion.
(sp (make-wff
  '(FORALL s
     (IMPLIES (TOTALLY-BOUNDED s)
       (FORALL f
         (IMPLIES (IN f (FUN NN (PTS s)))
           (FORALL rad
             (IMPLIES (NULL-RR-SEQ rad)
               (FORSOME phi
                 (AND (STRICTLY-MONO-NN phi)
                      (IS-CAUCHY-SEQ s (SUBSEQ f phi))))))))))))
(let* ((landed (dk-peel!))
       (tb (find-first (dk-head? 'TOTALLY-BOUNDED) landed))
       (ty (find-first (dk-head? 'IN) landed)))
  (fact 'totally-bounded-has-cauchy-subsequence (cadr tb) (cadr ty))
  (ass))
(rb2-done! 'totally-bounded-has-cauchy-subseq-rad)
(topic! 'totally-bounded-has-cauchy-subseq-rad 'analysis)

;;; =================================================================================
;;; summable-bound-converges.
(sp (make-wff
  '(FORALL s (FORALL f (FORALL rad
     (IMPLIES (AND (IS-COMPLETE s)
              (AND (IN f (FUN NN (PTS s)))
              (AND (IN rad (FUN NN RR))
              (AND (SERIES-CONVERGES rad)
                   (FORALL k (IMPLIES (IN k NN)
                     (<= ((DIST s) (f k) (f (succ k))) (rad k))))))))
       (CONVERGES s f)))))))
(dk-split-all! (dk-peel!))
(let* ((g (dk-goal))
       (s (cadr g))
       (f (caddr g))
       (ty-rad (dk-pick (lambda (a) (and (pair? a) (eq? (car a) 'IN)
                                         (equal? (caddr a) '(FUN NN RR))))
                        "the typing of rad"))
       (rad (cadr ty-rad))
       (bnd (dk-pick (lambda (a) (and (pair? a) (eq? (car a) 'FORALL)
                                      (dk-contains? a (list 'DIST s))))
                     "the consecutive-distance bound"))
       (ms  (list 'IS-METRIC-SPACE s))
       (cpl (list 'FORALL 'f (list 'IMPLIES (list 'IS-CAUCHY-SEQ s 'f)
                                     (list 'CONVERGES s 'f)))))
  (dk-project! ms 'is-complete (list 'IS-COMPLETE s))
  (dk-project! cpl 'is-complete (list 'IS-COMPLETE s))
  (dk-have! (list 'AND ms
                  (list 'AND (list 'IN f (list 'FUN 'NN (list 'PTS s)))
                        (list 'AND ty-rad
                              (list 'AND (list 'SERIES-CONVERGES rad) bnd))))
            (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'summable-bound-implies-cauchy s f rad)
  (dk-apply! (dk-ctx-form cpl) f)
  (ass))
(rb2-done! 'summable-bound-converges)
(topic! 'summable-bound-converges 'analysis)

;;; =================================================================================
;;; sums-to-unique.  M = NAG-METRIC-SPACE(grp).  For eps > 0 with h + h = eps, the
;;; two SUMS-TO hypotheses at h give fin1, fin2; at ext = fin1 u fin2 the partial sum
;;; S = FINSUM(view, f, ext) has d(r1,S) < h and d(r2,S) < h, so d(r1,r2) <= eps.
;;; rr-le-all-pos-nonpos, metric-pos and metric-zero-eq close.

;; with (SUMS-TO grp f r) in context (it is CONSUMED) and (POS-RR h): skolemize the
;; finite set and return (fin . ext-universal)
(define (rb2-open-sums-to! grp f r h)
  (let* ((st (list 'SUMS-TO grp f r))
         (un (dk-landed-1 (lambda () (mac-h 'sums-to st))))
         (ex (dk-apply! un h))
         (fin (dk-skolem! ex))
         (eu (dk-pick (lambda (a) (and (pair? a) (eq? (car a) 'FORALL)
                                       (dk-contains? a fin) (dk-contains? a r)))
                      "the ext universal")))
    (cons fin eu)))

;; with the finite set data of S in context: (IN (FINSUM view f U) (CARR grp))
(define (rb2-finsum-type! grp f U)
  (let* ((view (list 'NORMED-AG-AS-ABELIAN-GROUP grp))
         (sm (list 'FINSUM view f U))
         (claim (list 'IN sm (list 'CARR grp))))
    (dk-have! claim
      (lambda ()
        (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z U)
                                        (list 'IN (list f 'z) (list 'CARR view))))
          (lambda ()
            (let* ((landed (dk-peel!))
                   (z (cadr (car landed))))
              (subst (list '== (list 'CARR view) (list 'CARR grp)))
              (fact 'subset-mem-fwd U (list 'DOM f) z)
              (fact 'fun-apply-type-c f (list 'DOM f) (list 'CARR grp) z)
              (ass))))
        (fact 'finsum-type-ptwise view U f)
        (subst (list '== (list 'CARR grp) (list 'CARR view)))
        (ass)))
    sm))

(sp (make-wff
  '(FORALL grp
     (IMPLIES (IS-NORMED-AG grp)
       (FORALL f
         (IMPLIES (IN f (FUN (DOM f) (CARR grp)))
           (FORALL r1
             (IMPLIES (IN r1 (CARR grp))
               (FORALL r2
                 (IMPLIES (IN r2 (CARR grp))
                   (IMPLIES (AND (SUMS-TO grp f r1) (SUMS-TO grp f r2))
                     (= r1 r2))))))))))))
(dk-split-all! (dk-peel!))
(let* ((g (dk-goal))
       (r1 (cadr g))
       (r2 (caddr g))
       (grp (cadr (rb2-hyp 'IS-NORMED-AG "the normed AG")))
       (sth (rb2-hyp 'SUMS-TO "a SUMS-TO hypothesis"))
       (f (caddr sth))
       (view (list 'NORMED-AG-AS-ABELIAN-GROUP grp))
       (M (list 'NAG-METRIC-SPACE grp))
       (dM (list 'DIST M))
       (D (list dM r1 r2)))
  (fact 'normed-ag-as-abelian-group-is-abelian-group grp)
  (rb2-readoff! 'CARR grp 'NORMED-AG-AS-ABELIAN-GROUP)
  (fact 'nag-metric-space-is-metric-space grp)
  (fact 'nag-metric-carrier grp)
  (for-each (lambda (r)
              (dk-have! (list 'IN r (list 'PTS M))
                (lambda () (subst (list '== (list 'PTS M) (list 'CARR grp))) (ass))))
            (list r1 r2))
  (fact 'metric-dist-real M r1 r2)
  ;; the eps-universal
  (dk-have! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list '<= D 'eps)))
    (lambda ()
      (let* ((landed (dk-peel!))
             (eps (cadr (car landed)))
             (h (dk-halve! eps))
             (p1 (rb2-open-sums-to! grp f r1 h))
             (p2 (rb2-open-sums-to! grp f r2 h))
             (fin1 (car p1)) (fin2 (car p2))
             (U (list 'UNION fin1 fin2)))
        (fact 'rr-pos-rr-in-rr eps)
        ;; ext := fin1 u fin2 is a finite subset of DOM f containing both
        (dk-have! (list 'AND (list 'IN fin1 'SET) (list 'IN fin2 'SET))
                  (lambda () (dk-conj-close! (lambda () (ass)))))
        (fact 'union-set-closure fin1 fin2)
        (fact 'card-union-nn fin1 fin2)
        (rb2-sub-union! fin1 fin2)
        (rb2-union-sub! fin1 fin2 (list 'DOM f))
        (let ((sm (rb2-finsum-type! grp f U)))
          (dk-have! (list 'IN sm (list 'PTS M))
            (lambda () (subst (list '== (list 'PTS M) (list 'CARR grp)))
                       (ass)))
          (let ((rb2-one!
                 (lambda (r fin eu)
                   (dk-have! (list 'AND (list 'IN U 'SET)
                                   (list 'AND (list 'IN (list 'CARD U) 'NN)
                                         (list 'AND (list 'SUBSET fin U)
                                               (list 'SUBSET U (list 'DOM f)))))
                             (lambda () (dk-conj-close! (lambda () (ass)))))
                   (dk-apply! eu U)
                   (fact 'nag-metric-distance grp r sm)
                   (fact 'metric-dist-real M r sm)
                   (dk-have! (list '< (list dM r sm) h)
                     (lambda ()
                       (subst (list '= (list dM r sm)
                                    (list (list 'NRM grp)
                                          (list (list 'OPR grp) r (list (list 'INV grp) sm)))))
                       (ass))))))
            (rb2-one! r1 fin1 (cdr p1))
            (rb2-one! r2 fin2 (cdr p2)))
          (fact 'metric-triangle M r1 sm r2)
          (fact 'metric-sym M sm r2)
          (fact 'metric-dist-real M sm r2)
          (dk-ineq! (list '<= D (list '+ (list dM r1 sm) (list dM sm r2)))
                    (list '= (list dM sm r2) (list dM r2 sm))
                    (list '< (list dM r1 sm) h)
                    (list '< (list dM r2 sm) h)
                    (list '= (list '+ h h) eps)
                    (list 'IN D 'RR) (list 'IN (list dM r1 sm) 'RR)
                    (list 'IN (list dM r2 sm) 'RR) (list 'IN (list dM sm r2) 'RR)
                    (list 'IN h 'RR) (list 'IN eps 'RR))))))
  (fact 'rr-le-all-pos-nonpos D)
  (fact 'metric-pos M r1 r2)
  (fact 'nn-zero-in)
  (fact 'nn-in-rr 0)
  (dk-have! (list 'AND (list 'IN D 'RR) (list 'IN 0 'RR))
            (lambda () (dk-conj-close! (lambda () (ass)))))
  (dk-have! (list 'AND (list '<= D 0) (list '<= 0 D))
            (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'rr-leq-antisymmetric D 0)
  (fact 'metric-zero-eq M r1 r2)
  (ass))
(rb2-done! 'sums-to-unique)
(topic! 'sums-to-unique 'analysis)


;;; =================================================================================
;;; absolute-summable-implies-summable.
;;;
;;; Notation: V = NORMED-AG-AS-ABELIAN-GROUP(grp), M = NAG-METRIC-SPACE(grp),
;;; S(w) = FINSUM(V, f, w), RM = RR-POS-STAR-ADD-MONOID, P(w) = FINSUM(RM, g, w) with
;;; g the norm family i |-> NRM(f(i)), E = ESUM(g) (a real by hypothesis).
;;;
;;;  rb2-nrm-finsum-le   for finite w <= dd: P(w) is real and NRM(S(w)) <= P(w)
;;;                      (finite-set induction; the triangle inequality of the norm)
;;;  rb2-dist-union      a, c finite, disjoint, in dd: P(a u c) = P(a) + P(c) and
;;;                      d_M(S(a), S(a u c)) <= P(c)
;;;  rb2-dist-subset     a <= b <= dd finite: d_M(S(a), S(b)) <= P(b) - P(a)
;;;  rb2-esum-approx     E real, dl > 0: some finite t <= DOM g with E < P(t) + dl
;;;  the theorem         G(n) := CHOICE of a finite t with E < P(t) + rad(n), rad a
;;;                      positive null sequence; n |-> S(G(n)) is Cauchy in M
;;;                      (through S(G(m) u G(n))), converges by completeness to L, and
;;;                      L is the SUMS-TO limit (through S(G(n0)) for n0 large).

(define rb2-RM 'RR-POS-STAR-ADD-MONOID)
(define (rb2-V grp) (list 'NORMED-AG-AS-ABELIAN-GROUP grp))
(define (rb2-P g w) (list 'FINSUM 'RR-POS-STAR-ADD-MONOID g w))
(define (rb2-S grp f w) (list 'FINSUM (rb2-V grp) f w))
(define (rb2-N grp x) (list (list 'NRM grp) x))

;; (OPR RM) == eplus, (IDEN RM) == 0, (CARR RM) == RR-POS-STAR (measure-laws.scm's door)
(define (rb2-rm-readoff! eqn)
  (dk-have! eqn
    (lambda ()
      (quietly (lambda () (surface-goal! 'RR-POS-STAR-ADD-MONOID)))
      (qrfl))))
(define (rb2-rm-readoffs!)
  (rb2-rm-readoff! '(== (OPR RR-POS-STAR-ADD-MONOID) eplus))
  (rb2-rm-readoff! '(== (IDEN RR-POS-STAR-ADD-MONOID) 0))
  (rb2-rm-readoff! '(== (CARR RR-POS-STAR-ADD-MONOID) RR-POS-STAR))
  (rb2-rm-readoff! '(== RR-POS-STAR (CARR RR-POS-STAR-ADD-MONOID))))

;; the view facts: IS-ABELIAN-GROUP V and the slot read-offs, both orientations
(define (rb2-view-setup! grp)
  (fact 'normed-ag-as-abelian-group-is-abelian-group grp)
  (for-each (lambda (acc) (rb2-readoff! acc grp 'NORMED-AG-AS-ABELIAN-GROUP))
            '(CARR OPR IDEN INV)))

;; the two pointwise hypotheses over dd, read off the context
;; the consequent of a (FORALL v (IMPLIES A C)), else #f
(define (rb2-cq a)
  (and (pair? a) (eq? (car a) 'FORALL) (= (length a) 3)
       (let ((b (caddr a)))
         (and (pair? b) (eq? (car b) 'IMPLIES) (= (length b) 3) (caddr b)))))
(define (rb2-ptw-hyp grp)
  (dk-pick (lambda (a) (let ((c (rb2-cq a)))
                         (and (pair? c) (eq? (car c) 'IN) (= (length c) 3)
                              (equal? (caddr c) (list 'CARR grp)))))
           "the pointwise typing over dd"))
(define (rb2-eq-hyp grp)
  (dk-pick (lambda (a) (let ((c (rb2-cq a)))
                         (and (pair? c) (eq? (car c) '=)
                              (dk-contains? c (list 'NRM grp)))))
           "the pointwise norm equation over dd"))

;; with (SUBSET w dd) in context: (FORALL z_ (IMPLIES (IN z_ w) (IN (f z_) (CARR V))))
(define (rb2-ptw-f! grp f dd w)
  (let ((claim (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ w)
                                       (list 'IN (list f 'z_) (list 'CARR (rb2-V grp)))))))
    (dk-have! claim
      (lambda ()
        (let* ((landed (dk-peel!))
               (z (cadr (car landed))))
          (fact 'subset-mem-fwd w dd z)
          (dk-apply! (rb2-ptw-hyp grp) z)
          (subst (list '== (list 'CARR (rb2-V grp)) (list 'CARR grp)))
          (ass))))
    claim))

;; with (SUBSET w dd) in context, the RM readoffs and (IN (NRM grp) (FUN (CARR grp) RR)):
;; (FORALL z_ (IMPLIES (IN z_ w) (IN (g z_) (CARR RM))))
(define (rb2-ptw-g! grp f g dd w)
  (let ((claim (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ w)
                                       (list 'IN (list g 'z_) '(CARR RR-POS-STAR-ADD-MONOID))))))
    (dk-have! claim
      (lambda ()
        (let* ((landed (dk-peel!))
               (z (cadr (car landed)))
               (fz (list f z))
               (nfz (rb2-N grp fz)))
          (fact 'subset-mem-fwd w dd z)
          (dk-apply! (rb2-ptw-hyp grp) z)
          (let ((eqz (dk-apply! (rb2-eq-hyp grp) z)))
            (fact 'fun-apply-type-c (list 'NRM grp) (list 'CARR grp) 'RR fz)
            (fact 'normed-ag-nrm-nonneg grp fz)
            (subst '(== (CARR RR-POS-STAR-ADD-MONOID) RR-POS-STAR))
            (subst eqz)
            (let ((iff (dk-cite! 'rr-pos-star-membership nfz)))
              (dk-only! iff (list 'IN nfz 'RR) (list '<= 0 nfz))
              (prop))))))
    claim))

;; (IN x (UNION u (PAIR x x))), (SUBSET u (UNION u (PAIR x x))) for x a set
(define (rb2-insert-facts! u x)
  (let* ((pr (list 'PAIR x x))
         (t1 (list 'UNION u pr))
         (eq (list '= t1 (list 'UNION pr u))))
    (fact 'union-singleton-mem x u)
    (fact 'union-comm u pr)
    (fact 'union-right-subset pr u)
    (dk-have! (list 'IN x t1) (lambda () (subst eq) (ass)))
    (dk-have! (list 'SUBSET u t1) (lambda () (subst eq) (ass)))))

;;; ---------------------------------------------------------------------------------
;;; rb2-nrm-finsum-le
(define (rb2-T-body grp f g dd w)
  (list 'IMPLIES (list 'SUBSET w dd)
        (list 'AND (list 'IN (rb2-P g w) 'RR)
              (list '<= (rb2-N grp (rb2-S grp f w)) (rb2-P g w)))))

(sp (make-wff
  '(FORALL grp (IMPLIES (IS-NORMED-AG grp)
     (FORALL f (FORALL g (FORALL dd
       (IMPLIES (FORALL z_ (IMPLIES (IN z_ dd) (IN (f z_) (CARR grp))))
         (IMPLIES (FORALL z_ (IMPLIES (IN z_ dd) (= (g z_) ((NRM grp) (f z_)))))
           (FORALL w_ (IMPLIES (IN w_ SET) (IMPLIES (IN (CARD w_) NN)
             (IMPLIES (SUBSET w_ dd)
               (AND (IN (FINSUM RR-POS-STAR-ADD-MONOID g w_) RR)
                    (<= ((NRM grp) (FINSUM (NORMED-AG-AS-ABELIAN-GROUP grp) f w_))
                        (FINSUM RR-POS-STAR-ADD-MONOID g w_))))))))))))))))
(let loop ((n 0))
  (let ((gl (dk-goal)))
    (if (not (and (eq? (car gl) 'FORALL) (eq? (cadr gl) 'w_)))
        (if (> n 8) (error "rb2 T: never reached the w_ universal")
            (begin (di) (loop (+ n 1)))))))
(let* ((grp (cadr (rb2-hyp 'IS-NORMED-AG "the normed AG")))
       (ptw (rb2-ptw-hyp grp))
       (eqh (rb2-eq-hyp grp))
       (dd  (caddr (cadr (caddr ptw))))
       (f   (car (cadr (caddr (caddr ptw)))))
       (g   (car (cadr (caddr (caddr eqh)))))
       (V   (rb2-V grp))
       (cls (list 'COMP 'wv_ (rb2-T-body grp f g dd 'wv_)))
       (stp (list 'FORALL 'u_
              (list 'IMPLIES (list 'AND (list 'IN 'u_ 'SET)
                                   (list 'AND (list 'IN (list 'CARD 'u_) 'NN)
                                         (list 'IN 'u_ cls)))
                (list 'FORALL 'x_
                  (list 'IMPLIES (list 'AND (list 'IN 'x_ 'SET)
                                       (list 'NOT (list 'IN 'x_ 'u_)))
                        (list 'IN (list 'UNION 'u_ (list 'PAIR 'x_ 'x_)) cls)))))))
  (display ";; rb2 T vars: ") (display (list grp f g dd)) (newline)
  (rb2-view-setup! grp)
  (rb2-rm-readoffs!)
  (fact 'rr-pos-star-is-comm-monoid)
  (fact 'normed-ag-nrm-type grp)
  (fact 'abelian-group-is-group V)
  (fact 'group-identity-in V)
  (fact 'rr-zero-in)
  ;; base
  (dk-have! (list 'IN 'EMPTY-SET cls)
    (lambda ()
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (equal? (dk-goal) '(IN EMPTY-SET SET))
             (begin (fact 'empty-set-is-set) (ass))
             (let ((e (list 'IDEN grp)))
               (di)
               (fact 'finsum-empty rb2-RM g)
               (subst (list '== (rb2-P g 'EMPTY-SET) (list 'IDEN rb2-RM)))
               (subst (list '== (list 'IDEN rb2-RM) 0))
               (fact 'finsum-empty V f)
               (subst (list '== (rb2-S grp f 'EMPTY-SET) (list 'IDEN V)))
               (subst (list '== (list 'IDEN V) e))
               (dk-have! (list 'IN e (list 'CARR grp))
                 (lambda ()
                   (subst (list '== e (list 'IDEN V)))
                   (subst (list '== (list 'CARR grp) (list 'CARR V)))
                   (ass)))
               (dk-have! (list '= e e) (lambda () (rfl)))
               (let ((iff (dk-cite! 'normed-ag-nrm-definite grp e)))
                 (dk-have! (list '= (rb2-N grp e) 0)
                   (lambda () (dk-only! iff (list '= e e)) (prop))))
               (subst (list '= (rb2-N grp e) 0))
               (dk-conj-close!
                 (lambda ()
                   (if (equal? (dk-goal) '(IN 0 RR))
                       (ass)
                       (begin (fact 'rr-leq-reflexive 0) (ass))))))))
       (dk-opened (lambda () (comp-mi))))))
  ;; step
  (dk-have! stp
    (lambda ()
      (dk-split-all! (dk-peel!))
      (let* ((gl (dk-goal))
             (t1 (cadr gl))
             (u  (cadr t1))
             (x  (cadr (caddr t1)))
             (pr (list 'PAIR x x))
             (ih (dk-landed-find (lambda () (comp-me (list 'IN u cls))) (dk-head? 'IMPLIES))))
        (dk-have! (list 'AND (list 'IN x 'SET) (list 'IN x 'SET))
                  (lambda () (dk-conj-close! (lambda () (ass)))))
        (fact 'pairing x x)
        (dk-have! (list 'AND (list 'IN u 'SET) (list 'IN pr 'SET))
                  (lambda () (dk-conj-close! (lambda () (ass)))))
        (fact 'union-set-closure u pr)
        (for-each
         (lambda (leaf)
           (dk-focus! leaf)
           (if (equal? (dk-goal) (list 'IN t1 'SET))
               (ass)
               (let* ((fx (list f x)) (gx (list g x))
                      (su (rb2-S grp f u)) (pu (rb2-P g u))
                      (nsu (rb2-N grp su)) (nfx (rb2-N grp fx))
                      (opv (list 'OPR V)) (opg (list 'OPR grp)))
                 (di)
                 (rb2-insert-facts! u x)
                 (fact 'subset-mem-fwd t1 dd x)
                 (fact 'subset-trans u t1 dd)
                 (dk-split! (dk-landed-1 (lambda () (detach! ih))))
                 (rb2-ptw-f! grp f dd t1)
                 (rb2-ptw-f! grp f dd u)
                 (rb2-ptw-g! grp f g dd t1)
                 (fact 'finsum-insert-ptwise V u x f)
                 (fact 'finsum-cm-insert-ptwise rb2-RM u x g)
                 (fact 'finsum-type-ptwise V u f)
                 (dk-have! (list 'IN su (list 'CARR grp))
                   (lambda () (subst (list '== (list 'CARR grp) (list 'CARR V))) (ass)))
                 (dk-apply! (rb2-ptw-hyp grp) x)
                 (let ((eqx (dk-apply! (rb2-eq-hyp grp) x)))
                   (fact 'fun-apply-type-c (list 'NRM grp) (list 'CARR grp) 'RR fx)
                   (fact 'fun-apply-type-c (list 'NRM grp) (list 'CARR grp) 'RR su)
                   (fact 'normed-ag-nrm-nonneg grp fx)
                   (fact 'normed-ag-nrm-nonneg grp su)
                   (dk-have! (list 'IN gx 'RR) (lambda () (subst eqx) (ass)))
                   (dk-have! (list '<= 0 gx) (lambda () (subst eqx) (ass)))
                   (dk-have! (list '<= 0 pu)
                     (lambda () (dk-ineq! (list '<= 0 nsu) (list '<= nsu pu)
                                          (list 'IN nsu 'RR) (list 'IN pu 'RR))))
                   (fact 'eplus-real-defined pu gx)
                   (fact 'binplus-apply pu gx)
                   (fact 'normed-ag-nrm-subadditive grp su fx)
                   (dk-apply! (rb2-ptw-f! grp f dd t1) x)
                   (fact 'group-carrier-closed-opr V su fx)
                   (dk-have! (list 'IN (list opg su fx) (list 'CARR grp))
                     (lambda ()
                       (subst (list '== opg opv))
                       (subst (list '== (list 'CARR grp) (list 'CARR V)))
                       (ass)))
                   (fact 'fun-apply-type-c (list 'NRM grp) (list 'CARR grp) 'RR (list opg su fx))
                   (subst (list '= (rb2-S grp f t1) (list opv su fx)))
                   (subst (list '== opv opg))
                   (subst (list '= (rb2-P g t1) (list (list 'OPR rb2-RM) pu gx)))
                   (subst (list '== (list 'OPR rb2-RM) 'eplus))
                   (subst (list '= (list 'eplus pu gx) (list 'binplus pu gx)))
                   (subst (list '== (list 'binplus pu gx) (list '+ pu gx)))
                   (dk-conj-close!
                     (lambda ()
                       (if (eq? (car (dk-goal)) 'IN)
                           (begin
                             (dk-have! (list 'AND (list 'IN pu 'RR) (list 'IN gx 'RR))
                                       (lambda () (dk-conj-close! (lambda () (ass)))))
                             (fact 'rr-add-closed pu gx)
                             (ass))
                           (dk-ineq! (list '<= (rb2-N grp (list opg su fx)) (list '+ nsu nfx))
                                     (list '<= nsu pu) eqx
                                     (list 'IN nsu 'RR) (list 'IN nfx 'RR) (list 'IN pu 'RR)
                                     (list 'IN gx 'RR)
                                     (list 'IN (rb2-N grp (list opg su fx)) 'RR)))))))))
         (dk-opened (lambda () (comp-mi)))))))
  ;; the induction
  (dk-have! (list 'AND (list 'IN 'EMPTY-SET cls) stp)
            (lambda () (dk-conj-close! (lambda () (ass)))))
  (let ((ind (dk-fact! 'finite-set-induction cls)))
    (dk-split-all! (dk-peel!))
    (let* ((gl (dk-goal))
           (w  (cadddr (cadr (cadr gl)))))
      (dk-have! (list 'AND (list 'IN w 'SET) (list 'IN (list 'CARD w) 'NN))
                (lambda () (dk-conj-close! (lambda () (ass)))))
      (let* ((inw (dk-apply! ind w))
             (body (dk-landed-find (lambda () (comp-me inw)) (dk-head? 'IMPLIES))))
        (dk-landed-1 (lambda () (detach! body)))
        (ass)))))
(rb2-done! 'rb2-nrm-finsum-le)
(topic! 'rb2-nrm-finsum-le 'analysis)


;;; ---------------------------------------------------------------------------------
;;; rb2-dist-union
(define (rb2-M grp) (list 'NAG-METRIC-SPACE grp))
(define (rb2-d grp x y) (list (list 'DIST (rb2-M grp)) x y))

;; (IN t (CARR grp)) from (IN t (CARR V)) in context, and (IN t (PTS M))
(define (rb2-carr->pts! grp t)
  (dk-have! (list 'IN t (list 'CARR grp))
    (lambda () (subst (list '== (list 'CARR grp) (list 'CARR (rb2-V grp)))) (ass)))
  (dk-have! (list 'IN t (list 'PTS (rb2-M grp)))
    (lambda () (subst (list '== (list 'PTS (rb2-M grp)) (list 'CARR grp))) (ass))))

;; the prologue of the two lemmas below: everything up to the a_/c_ (or a_/b_) layer
(define (rb2-lemma-prologue!)
  (dk-peel!)
  (let* ((grp (cadr (rb2-hyp 'IS-NORMED-AG "the normed AG")))
         (ptw (rb2-ptw-hyp grp))
         (eqh (rb2-eq-hyp grp))
         (dd  (caddr (cadr (caddr ptw))))
         (f   (car (cadr (caddr (caddr ptw)))))
         (g   (car (cadr (caddr (caddr eqh))))))
    (rb2-view-setup! grp)
    (rb2-rm-readoffs!)
    (fact 'rr-pos-star-is-comm-monoid)
    (fact 'normed-ag-nrm-type grp)
    (fact 'abelian-group-is-group (rb2-V grp))
    (fact 'nag-metric-space-is-metric-space grp)
    (fact 'nag-metric-carrier grp)
    (list grp f g dd)))

;; for finite w <= dd: land P(w) in RR, NRM(S(w)) <= P(w), S(w) typed in CARR V, CARR grp,
;; PTS M, NRM(S(w)) in RR, 0 <= NRM(S(w)), 0 <= P(w)
(define (rb2-w-facts! grp f g dd w)
  (let* ((tl (dk-cite! 'rb2-nrm-finsum-le grp f g dd))
         (sw (rb2-S grp f w))
         (nsw (rb2-N grp sw))
         (pw (rb2-P g w)))
    (dk-split! (dk-apply! tl w))
    (rb2-ptw-f! grp f dd w)
    (fact 'finsum-type-ptwise (rb2-V grp) w f)
    (rb2-carr->pts! grp sw)
    (fact 'fun-apply-type-c (list 'NRM grp) (list 'CARR grp) 'RR sw)
    (fact 'normed-ag-nrm-nonneg grp sw)
    (dk-have! (list '<= 0 pw)
      (lambda () (dk-ineq! (list '<= 0 nsw) (list '<= nsw pw)
                           (list 'IN nsw 'RR) (list 'IN pw 'RR))))))

(sp (make-wff
  '(FORALL grp (IMPLIES (IS-NORMED-AG grp)
     (FORALL f (FORALL g (FORALL dd
       (IMPLIES (FORALL z_ (IMPLIES (IN z_ dd) (IN (f z_) (CARR grp))))
         (IMPLIES (FORALL z_ (IMPLIES (IN z_ dd) (= (g z_) ((NRM grp) (f z_)))))
           (FORALL a_ (IMPLIES (IN a_ SET) (IMPLIES (IN (CARD a_) NN)
             (FORALL c_ (IMPLIES (IN c_ SET) (IMPLIES (IN (CARD c_) NN)
               (IMPLIES (FORALL z_ (IMPLIES (IN z_ c_) (NOT (IN z_ a_))))
                 (IMPLIES (SUBSET a_ dd)
                   (IMPLIES (SUBSET c_ dd)
                     (AND (= (FINSUM RR-POS-STAR-ADD-MONOID g (UNION a_ c_))
                             (+ (FINSUM RR-POS-STAR-ADD-MONOID g a_)
                                (FINSUM RR-POS-STAR-ADD-MONOID g c_)))
                          (<= ((DIST (NAG-METRIC-SPACE grp))
                                 (FINSUM (NORMED-AG-AS-ABELIAN-GROUP grp) f a_)
                                 (FINSUM (NORMED-AG-AS-ABELIAN-GROUP grp) f (UNION a_ c_)))
                              (FINSUM RR-POS-STAR-ADD-MONOID g c_)))))))))))))))))))))
(let* ((vs  (rb2-lemma-prologue!))
       (grp (car vs)) (f (cadr vs)) (g (caddr vs)) (dd (cadddr vs))
       (gl  (dk-goal))
       (U   (cadddr (cadr (cadr gl))))
       (a   (cadr U)) (c (caddr U))
       (V   (rb2-V grp)) (opv (list 'OPR V)) (invv (list 'INV V))
       (opg (list 'OPR grp)) (invg (list 'INV grp))
       (sa  (rb2-S grp f a)) (sc (rb2-S grp f c)) (su (rb2-S grp f U))
       (pa  (rb2-P g a)) (pc (rb2-P g c)) (pu (rb2-P g U)))
  (display ";; rb2 dist-union vars: ") (display (list grp f g dd a c)) (newline)
  (dk-have! (list 'AND (list 'IN a 'SET) (list 'IN c 'SET))
            (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'union-set-closure a c)
  (fact 'card-union-nn a c)
  (rb2-union-sub! a c dd)
  (rb2-w-facts! grp f g dd a)
  (rb2-w-facts! grp f g dd c)
  (rb2-ptw-f! grp f dd U)
  (rb2-ptw-g! grp f g dd U)
  (fact 'finsum-cm-union-disjoint rb2-RM a c g)
  (fact 'finsum-union-disjoint V a c f)
  (fact 'eplus-real-defined pa pc)
  (fact 'binplus-apply pa pc)
  ;; S(U) typed
  (fact 'group-carrier-closed-opr V sa sc)
  (dk-have! (list 'IN su (list 'CARR V))
    (lambda () (subst (list '= su (list opv sa sc))) (ass)))
  (rb2-carr->pts! grp su)
  ;; the group algebra in V: (S(U) . S(a)^-1) = S(c)
  (fact 'group-inv-in V sa)
  (fact 'abelian-group-opr-comm V sa sc)
  (fact 'abelian-group-assoc V sc sa (list invv sa))
  (fact 'abelian-group-right-inv V sa)
  (fact 'abelian-group-right-id V sc)
  (let ((alg (list '= (list opg su (list invg sa)) sc)))
    (dk-have! alg
      (lambda ()
        (subst (list '== opg opv))
        (subst (list '== invg invv))
        (subst (list '= su (list opv sa sc)))
        (subst (list '= (list opv sa sc) (list opv sc sa)))
        (subst (list '= (list opv (list opv sc sa) (list invv sa))
                     (list opv sc (list opv sa (list invv sa)))))
        (subst (list '= (list opv sa (list invv sa)) (list 'IDEN V)))
        (subst (list '= (list opv sc (list 'IDEN V)) sc))
        (rfl)))
    (fact 'nag-metric-distance grp su sa)
    (let ((dus (rb2-d grp su sa)) (dsu (rb2-d grp sa su)) (nsc (rb2-N grp sc)))
      (dk-have! (list '= dus nsc)
        (lambda ()
          (subst (list '= dus (rb2-N grp (list opg su (list invg sa)))))
          (subst alg)
          (rfl)))
      (fact 'metric-sym (rb2-M grp) sa su)
      (fact 'metric-dist-real (rb2-M grp) sa su)
      (fact 'metric-dist-real (rb2-M grp) su sa)
      (dk-conj-close!
        (lambda ()
          (if (eq? (car (dk-goal)) '=)
              (begin
                (subst (list '= pu (list (list 'OPR rb2-RM) pa pc)))
                (subst (list '== (list 'OPR rb2-RM) 'eplus))
                (subst (list '= (list 'eplus pa pc) (list 'binplus pa pc)))
                (subst (list '== (list 'binplus pa pc) (list '+ pa pc)))
                (fact 'rr-add-closed pa pc)
                (rfl))
              (dk-ineq! (list '= dsu dus) (list '= dus nsc) (list '<= nsc pc)
                        (list 'IN dsu 'RR) (list 'IN dus 'RR) (list 'IN nsc 'RR)
                        (list 'IN pc 'RR))))))))
(rb2-done! 'rb2-dist-union)
(topic! 'rb2-dist-union 'analysis)


;;; ---------------------------------------------------------------------------------
;;; rb2-dist-subset: a <= b <= dd finite; c = COMPLEMENT-IN(b, a) is finite, disjoint
;;; from a, and b = a u c; rb2-dist-union at (a, c), rewritten from a u c to b.
(sp (make-wff
  '(FORALL grp (IMPLIES (IS-NORMED-AG grp)
     (FORALL f (FORALL g (FORALL dd
       (IMPLIES (FORALL z_ (IMPLIES (IN z_ dd) (IN (f z_) (CARR grp))))
         (IMPLIES (FORALL z_ (IMPLIES (IN z_ dd) (= (g z_) ((NRM grp) (f z_)))))
           (FORALL a_ (IMPLIES (IN a_ SET) (IMPLIES (IN (CARD a_) NN)
             (FORALL b_ (IMPLIES (IN b_ SET) (IMPLIES (IN (CARD b_) NN)
               (IMPLIES (SUBSET a_ b_)
                 (IMPLIES (SUBSET b_ dd)
                   (<= ((DIST (NAG-METRIC-SPACE grp))
                          (FINSUM (NORMED-AG-AS-ABELIAN-GROUP grp) f a_)
                          (FINSUM (NORMED-AG-AS-ABELIAN-GROUP grp) f b_))
                       (- (FINSUM RR-POS-STAR-ADD-MONOID g b_)
                          (FINSUM RR-POS-STAR-ADD-MONOID g a_))))))))))))))))))))
(let* ((vs  (rb2-lemma-prologue!))
       (grp (car vs)) (f (cadr vs)) (g (caddr vs)) (dd (cadddr vs))
       (gl  (dk-goal))
       (a   (cadddr (cadr (cadr gl))))
       (b   (cadddr (caddr (cadr gl))))
       (c   (list 'COMPLEMENT-IN b a))
       (U   (list 'UNION a c))
       (sa  (rb2-S grp f a)) (sb (rb2-S grp f b))
       (pa  (rb2-P g a)) (pb (rb2-P g b)) (pc (rb2-P g c))
       (dab (rb2-d grp sa sb)))
  (display ";; rb2 dist-subset vars: ") (display (list grp f g dd a b)) (newline)
  (fact 'complement-in-set-closure b a)
  (fact 'complement-in-subset a b)
  (fact 'subset-trans a b dd)
  (fact 'subset-trans c b dd)
  (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z c) (list 'IN 'z b)))
    (lambda ()
      (let ((z (cadr (car (dk-peel!)))))
        (fact 'subset-mem-fwd c b z)
        (ass))))
  (dk-have! (list 'AND (list 'IN b 'SET) (list 'IN (list 'CARD b) 'NN))
            (lambda () (dk-conj-close! (lambda () (ass)))))
  (dk-have! (list 'AND (list 'IN c 'SET)
                  (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z c) (list 'IN 'z b))))
            (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'card-subset-nn b c)
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ c) (list 'NOT (list 'IN 'z_ a))))
    (lambda ()
      (let* ((z (cadr (car (dk-peel!))))
             (iff (dk-cite! 'complement-in-membership b a z)))
        (dk-only! iff (list 'IN z c))
        (prop))))
  (fact 'union-complement-in a b)
  (rb2-w-facts! grp f g dd a)
  (rb2-w-facts! grp f g dd b)
  (rb2-w-facts! grp f g dd c)
  (let* ((kl (dk-cite! 'rb2-dist-union grp f g dd))
         (pr (dk-apply! kl a c))
         (parts (dk-split! pr))
         (e1 (dk-rewrite-h! (car parts) U b))
         (e2 (dk-rewrite-h! (cadr parts) U b)))
    (fact 'metric-dist-real (rb2-M grp) sa sb)
    (dk-ineq! e1 e2 (list 'IN dab 'RR) (list 'IN pa 'RR) (list 'IN pb 'RR) (list 'IN pc 'RR))))
(rb2-done! 'rb2-dist-subset)
(topic! 'rb2-dist-subset 'analysis)


;;; ---------------------------------------------------------------------------------
;;; rb2-esum-approx: a real ESUM is approached from below by finite partial sums.  By
;;; contradiction: otherwise E - dl bounds every partial sum (it is >= 0 because the
;;; empty partial sum is 0), and esum-least gives E <= E - dl.
(define (rb2-keep-prop! . keepers)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! keepers)
    (if (not (sequent-node-grounded? leaf)) (prop))))

(sp (make-wff
  '(FORALL g (IMPLIES (IN g (FUN (DOM g) RR-POS-STAR))
     (IMPLIES (IN (ESUM g) RR)
       (FORALL dl (IMPLIES (POS-RR dl)
         (FORSOME t (AND (IN t SET) (AND (IN (CARD t) NN) (AND (SUBSET t (DOM g))
           (< (ESUM g) (+ (FINSUM RR-POS-STAR-ADD-MONOID g t) dl)))))))))))))
(dk-peel!)
(let* ((Q   (dk-goal))
       (ty  (dk-pick (lambda (a) (and (pair? a) (eq? (car a) 'IN) (pair? (caddr a))
                                      (eq? (car (caddr a)) 'FUN)))
                     "the typing of g"))
       (g   (cadr ty))
       (E   (list 'ESUM g))
       (dl  (cadr (rb2-hyp 'POS-RR "the POS-RR hypothesis")))
       (b   (list '- E dl))
       (fin (lambda (s) (list 'AND (list 'IN s 'SET)
                              (list 'AND (list 'IN (list 'CARD s) 'NN)
                                    (list 'SUBSET s (list 'DOM g))))))
       (BU  (list 'FORALL 's (list 'IMPLIES (fin 's)
                                   (list '<= (rb2-P g 's) b)))))
  (display ";; rb2 esum-approx vars: ") (display (list g dl)) (newline)
  (use-em Q
    (lambda () (ass))
    (lambda ()
      (let ((notQ (list 'NOT Q)))
        (fact 'rr-pos-rr-in-rr dl)
        (fact 'rr-lt-of-pos-rr dl)
        (fact 'rr-sub-in-rr E dl)
        (dk-have! BU
          (lambda ()
            (let* ((landed (dk-peel!))
                   (s (cadr (cadr (car landed))))
                   (P (rb2-P g s))
                   (Pd (list '+ P dl)))
              (dk-split-all! landed)
              (dk-have! (fin s) (lambda () (dk-conj-close! (lambda () (ass)))))
              (fact 'esum-partial-sum-type g s)
              (fact 'esum-upper g s)
              (dk-have! (list 'AND (list 'IN P 'RR-POS-STAR) (list 'IN E 'RR))
                        (lambda () (dk-conj-close! (lambda () (ass)))))
              (fact 'rr-pos-star-le-real-in-rr P E)
              (dk-have! (list 'AND (list 'IN P 'RR) (list 'IN dl 'RR))
                        (lambda () (dk-conj-close! (lambda () (ass)))))
              (fact 'rr-add-closed P dl)
              (use-em (list '<= Pd E)
                (lambda ()
                  (dk-ineq! (list '<= Pd E) (list 'IN P 'RR) (list 'IN dl 'RR) (list 'IN E 'RR)))
                (lambda ()
                  (fact 'rr-not-le-lt Pd E)
                  (dk-have! Q
                    (lambda ()
                      (ew s)
                      (dk-conj-close! (lambda () (ass)))))
                  (rb2-keep-prop! Q notQ))))))
        ;; 0 <= b, from the empty partial sum
        (fact 'empty-set-is-set)
        (fact 'card-empty)
        (fact 'nn-zero-in)
        (dk-have! (list 'IN '(CARD EMPTY-SET) 'NN)
          (lambda () (subst '(= (CARD EMPTY-SET) 0)) (ass)))
        (fact 'empty-subset-any (list 'DOM g))
        (dk-have! (fin 'EMPTY-SET) (lambda () (dk-conj-close! (lambda () (ass)))))
        (let ((b0 (dk-apply! BU 'EMPTY-SET)))
          (rb2-rm-readoffs!)
          (fact 'finsum-empty rb2-RM g)
          (dk-have! (list '<= 0 b)
            (lambda ()
              (fact 'rr-zero-in)
              (dk-have! (list '<= 0 b)
                (lambda ()
                  (dk-have! (list '= (rb2-P g 'EMPTY-SET) 0)
                    (lambda ()
                      (subst (list '== (rb2-P g 'EMPTY-SET) (list 'IDEN rb2-RM)))
                      (subst (list '== (list 'IDEN rb2-RM) 0))
                      (rfl)))
                  (subst (list '= 0 (rb2-P g 'EMPTY-SET)))
                  (ass))))))
        (let ((iff (dk-cite! 'rr-pos-star-membership b)))
          (dk-have! (list 'IN b 'RR-POS-STAR)
            (lambda () (dk-only! iff (list 'IN b 'RR) (list '<= 0 b)) (prop))))
        (dk-have! (list 'AND (list 'IN b 'RR-POS-STAR) BU)
                  (lambda () (dk-conj-close! (lambda () (ass)))))
        (fact 'esum-least g b)
        (dk-have! 'FALSITY
          (lambda () (dk-absurd! (list '<= E b) (list '< 0 dl)
                                 (list 'IN E 'RR) (list 'IN dl 'RR))))
        (rb2-keep-prop! 'FALSITY)))))
(rb2-done! 'rb2-esum-approx)
(topic! 'rb2-esum-approx 'analysis)


;;; ---------------------------------------------------------------------------------
;;; rb2-choice-seq: a sequence of finite sets whose partial sums come within rad(n) of
;;; E.  The witness is the lambda n |-> CHOICE{t in SET : t finite <= DOM g and
;;; E < P(t) + rad(n)}; each SEP is inhabited by rb2-esum-approx at rad(n).
(sp (make-wff
  '(FORALL g (IMPLIES (IN g (FUN (DOM g) RR-POS-STAR))
     (IMPLIES (IN (ESUM g) RR)
       (FORALL rad (IMPLIES (FORALL k (IMPLIES (IN k NN) (POS-RR (rad k))))
         (FORSOME gs (FORALL n (IMPLIES (IN n NN)
           (AND (IN (gs n) SET) (AND (IN (CARD (gs n)) NN) (AND (SUBSET (gs n) (DOM g))
             (< (ESUM g) (+ (FINSUM RR-POS-STAR-ADD-MONOID g (gs n)) (rad n))))))))))))))))
(dk-peel!)
(let* ((ty  (dk-pick (lambda (a) (and (pair? a) (eq? (car a) 'IN) (pair? (caddr a))
                                      (eq? (car (caddr a)) 'FUN)))
                     "the typing of g"))
       (g   (cadr ty))
       (E   (list 'ESUM g))
       (posh (dk-pick (lambda (a) (let ((c (rb2-cq a))) (and (pair? c) (eq? (car c) 'POS-RR))))
                      "the positivity of rad"))
       (rad (car (cadr (rb2-cq posh))))
       (qb  (lambda (t k) (list 'AND (list 'IN (list 'CARD t) 'NN)
                                (list 'AND (list 'SUBSET t (list 'DOM g))
                                      (list '< E (list '+ (rb2-P g t) (list rad k)))))))
       (lamG (list 'VNB-LAMBDA 'kv_ 'NN
                   (list 'CHOICE (list 'SEP 'tv_ 'SET (qb 'tv_ 'kv_))))))
  (display ";; rb2 choice-seq vars: ") (display (list g rad)) (newline)
  (ew lamG)
  (let* ((landed (dk-peel!))
         (n (cadr (car landed)))
         (sep (list 'SEP 'tv_ 'SET (qb 'tv_ n)))
         (C (list 'CHOICE sep)))
    (dk-lam-b!)
    (dk-apply! posh n)
    (fact 'rr-pos-rr-in-rr (list rad n))
    (let* ((ap (dk-cite! 'rb2-esum-approx g))
           (ex (dk-apply! ap (list rad n)))
           (t  (dk-skolem! ex)))
      (dk-have! (list 'FORSOME 'cv_ (list 'IN 'cv_ sep))
        (lambda ()
          (ew t)
          (in-sep! (lambda () (dk-conj-close! (lambda () (ass)))))))
      (let ((mem (dk-fact! 'choice-axiom sep)))
        (dk-split-all! (dk-landed* (lambda () (sep-me mem))))
        (dk-conj-close! (lambda () (ass)))))))
(rb2-done! 'rb2-choice-seq)
(topic! 'rb2-choice-seq 'analysis)


;;; ---------------------------------------------------------------------------------
;;; THE THEOREM.
(define rb2-m-ctx #f)   ; (grp f g D gsq rad M) once read off

;; (IN v SET), (CARD v) in NN, (SUBSET v D) in context => P(v) <= E (esum-upper)
(define (rb2-upper! g D w)
  (dk-have! (list 'AND (list 'IN w 'SET)
                  (list 'AND (list 'IN (list 'CARD w) 'NN) (list 'SUBSET w (list 'DOM g))))
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (eq? (car (dk-goal)) 'SUBSET)
              (begin (subst (list '= (list 'DOM g) D)) (ass))
              (ass))))))
  (fact 'esum-upper g w))

;; for ni in NN: gsq(ni) finite <= D with E < P(gsq(ni)) + rad(ni); rad(ni) real; the w-facts at gsq(ni)
(define (rb2-gn! ni)
  (let* ((grp (list-ref rb2-m-ctx 0)) (f (list-ref rb2-m-ctx 1)) (g (list-ref rb2-m-ctx 2))
         (D (list-ref rb2-m-ctx 3)) (gsq (list-ref rb2-m-ctx 4)) (rad (list-ref rb2-m-ctx 5))
         (hq (dk-pick (lambda (a) (let ((c (rb2-cq a)))
                                    (and (pair? c) (eq? (car c) 'AND)
                                         (dk-contains? c (list 'CARD (list gsq (cadr (cadr (caddr a)))))))))
                      "the choice-sequence property")))
    (if (not (dk-asm? (list 'IN (list gsq ni) 'SET)))
        (begin
          (dk-split! (dk-apply! hq ni))
          (dk-have! (list 'SUBSET (list gsq ni) D)
            (lambda () (subst (list '= D (list 'DOM g))) (ass)))
          (fact 'fun-apply-type-c rad 'NN 'RR ni)
          (rb2-w-facts! grp f g D (list gsq ni))))))

(sp (make-wff
  '(FORALL grp
     (IMPLIES (AND (IS-NORMED-AG grp)
                   (IS-COMPLETE (NAG-METRIC-SPACE grp)))
       (FORALL f
         (IMPLIES (AND (IN f (FUN (DOM f) (CARR grp)))
                       (IS-ABSOLUTELY-SUMMABLE grp f))
           (IS-SUMMABLE grp f)))))))
(dk-split-all! (dk-peel!))
(let* ((ash (rb2-hyp 'IS-ABSOLUTELY-SUMMABLE "the absolute summability"))
       (grp (cadr ash))
       (f   (caddr ash))
       (D   (list 'DOM f))
       (M   (rb2-M grp))
       (V   (rb2-V grp))
       (cg  (list 'CARR grp))
       (er  (dk-landed-1 (lambda () (mac-h 'is-absolutely-summable ash))))
       (g   (cadr (cadr er)))
       (E   (list 'ESUM g)))
  (display ";; rb2 main vars: ") (display (list grp f g)) (newline)
  ;; ---- the context of the lemmas
  (rb2-view-setup! grp)
  (rb2-rm-readoffs!)
  (fact 'rr-pos-star-is-comm-monoid)
  (fact 'normed-ag-nrm-type grp)
  (fact 'abelian-group-is-group V)
  (fact 'nag-metric-space-is-metric-space grp)
  (fact 'nag-metric-carrier grp)
  (fact 'fun-domain-in-set D cg f)
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ D) (list 'IN (list f 'z_) cg)))
    (lambda ()
      (let ((z (cadr (car (dk-peel!)))))
        (fact 'fun-apply-type-c f D cg z)
        (ass))))
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ D)
                                    (list '= (list g 'z_) (rb2-N grp (list f 'z_)))))
    (lambda ()
      (let ((z (cadr (car (dk-peel!)))))
        (fact 'fun-apply-type-c f D cg z)
        (fact 'fun-apply-type-c (list 'NRM grp) cg 'RR (list f z))
        (if (not (dk-lam-b!)) (rfl)))))
  ;; g in FUN(DOM g, RR-POS-STAR)
  (dk-have! (list 'IN g (list 'FUN D 'RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((landed (dk-peel!))
                 (gl (dk-goal))
                 (t (cadr gl))
                 (z (cadr (car landed))))
            (fact 'fun-apply-type-c f D cg z)
            (fact 'fun-apply-type-c (list 'NRM grp) cg 'RR (list f z))
            (fact 'normed-ag-nrm-nonneg grp (list f z))
            (let ((iff (dk-cite! 'rr-pos-star-membership t)))
              (dk-only! iff (list 'IN t 'RR) (list '<= 0 t))
              (prop)))))))
  (dk-project! (list 'IN g (list 'FUN D)) 'fun-codomain-iff (list 'IN g (list 'FUN D 'RR-POS-STAR)))
  (dk-have! (list 'AND (list 'IN g (list 'FUN D)) (list 'IN D 'SET))
            (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'dom-of-fun D g)
  (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN (list 'DOM g) 'SET)
                                          (list '= (list 'DOM g) D)))))
  (dk-have! (list 'IN g (list 'FUN (list 'DOM g) 'RR-POS-STAR))
            (lambda () (subst (list '= (list 'DOM g) D)) (ass)))
  ;; ---- rad, a positive null sequence, and the choice sequence gsq
  (let* ((rex (dk-fact! 'null-rr-seq-exists))
         (rad (dk-skolem! rex))
         (nl  (dk-split! (dk-landed-1 (lambda () (mac-h 'null-rr-seq (list 'NULL-RR-SEQ rad))))))
         (nullh (dk-pick (lambda (a) (and (pair? a) (eq? (car a) 'FORALL)
                                          (dk-contains? a 'FORSOME) (dk-contains? a (list rad 'k))))
                         "the nullity of rad"))
         (cs  (dk-cite! 'rb2-choice-seq g))
         (gex (dk-apply! cs rad))
         (gsq   (dk-skolem! gex #f)))
    (set! rb2-m-ctx (list grp f g D gsq rad M))
    (display ";; rb2 main rad, G: ") (display (list rad gsq)) (newline)
    ;; ---- the sequence of partial sums
    (let* ((seq (list 'VNB-LAMBDA 'kv_ 'NN (rb2-S grp f (list gsq 'kv_))))
           (dM  (list 'DIST M)))
      (dk-have! (list 'IN seq (list 'FUN 'NN (list 'PTS M)))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              ;; the goal IS (IN S(gsq(k)) (PTS M)): rb2-gn! would prove it in place
              ;; through a dk-have! and go on working on another leaf, so by hand here
              (let* ((landed (dk-peel!))
                     (k (cadr (car landed)))
                     (gk (list gsq k))
                     (hq (dk-pick (lambda (a) (let ((c (rb2-cq a)))
                                                (and (pair? c) (eq? (car c) 'AND)
                                                     (dk-contains? c 'ESUM))))
                                  "the choice-sequence property")))
                (dk-split! (dk-apply! hq k))
                (dk-have! (list 'SUBSET gk D)
                  (lambda () (subst (list '= D (list 'DOM g))) (ass)))
                (rb2-ptw-f! grp f D gk)
                (fact 'finsum-type-ptwise V gk f)
                (subst (list '== (list 'PTS M) cg))
                (subst (list '== cg (list 'CARR V)))
                (ass))))))
      ;; ---- Cauchy
      (dk-have! (list 'IS-CAUCHY-SEQ M seq)
        (lambda ()
          (mac 'is-cauchy-seq)
          (dk-conj-close!
            (lambda ()
              (if (not (eq? (car (dk-goal)) 'FORALL))
                  (ass)
                  (let* ((landed (dk-peel!))
                         (eps (cadr (car landed)))
                         (h (dk-halve! eps))
                         (nx (dk-apply! nullh h))
                         (N0 (dk-skolem! nx))
                         (rbd (dk-pick (lambda (a) (and (pair? a) (eq? (car a) 'FORALL)
                                                        (dk-contains? a (list '<= N0 'k))))
                                       "the rad bound past N0")))
                    (fact 'rr-pos-rr-in-rr eps)
                    (ew N0)
                    (dk-conj-close!
                      (lambda ()
                        (if (not (eq? (car (dk-goal)) 'FORALL))
                            (ass)
                            (let* ((landed2 (dk-peel!))
                                   (dgl (cadr (dk-goal)))
                                   (mi (cadr (cadr dgl))) (ni (cadr (caddr dgl))))
                              (dk-split-all! landed2)
                              (dk-lam-b!)
                              (rb2-gn! mi)
                              (rb2-gn! ni)
                              (let* ((gm (list gsq mi)) (gn (list gsq ni))
                                     (W (list 'UNION gm gn))
                                     (sgm (rb2-S grp f gm)) (sgn (rb2-S grp f gn)) (sw (rb2-S grp f W))
                                     (pgm (rb2-P g gm)) (pgn (rb2-P g gn)) (pw (rb2-P g W))
                                     (rm (list rad mi)) (rn (list rad ni)))
                                (dk-have! (list 'AND (list 'IN gm 'SET) (list 'IN gn 'SET))
                                          (lambda () (dk-conj-close! (lambda () (ass)))))
                                (fact 'union-set-closure gm gn)
                                (fact 'card-union-nn gm gn)
                                (rb2-sub-union! gm gn)
                                (rb2-union-sub! gm gn D)
                                (rb2-w-facts! grp f g D W)
                                (rb2-upper! g D W)
                                (let ((kl (dk-cite! 'rb2-dist-subset grp f g D)))
                                  (dk-apply! kl gm W)
                                  (dk-apply! kl gn W))
                                (for-each (lambda (j)
                                            (dk-have! (list 'AND (list 'IN j 'NN) (list '<= N0 j))
                                                      (lambda () (dk-conj-close! (lambda () (ass)))))
                                            (dk-apply! rbd j))
                                          (list mi ni))
                                (fact 'metric-triangle M sgm sw sgn)
                                (fact 'metric-sym M sw sgn)
                                (for-each (lambda (pq) (fact 'metric-dist-real M (car pq) (cdr pq)))
                                          (list (cons sgm sgn) (cons sgm sw) (cons sw sgn) (cons sgn sw)))
                                (dk-ineq! (list '<= (list dM sgm sgn)
                                                (list '+ (list dM sgm sw) (list dM sw sgn)))
                                          (list '= (list dM sw sgn) (list dM sgn sw))
                                          (list '<= (list dM sgm sw) (list '- pw pgm))
                                          (list '<= (list dM sgn sw) (list '- pw pgn))
                                          (list '<= pw E)
                                          (list '< E (list '+ pgm rm))
                                          (list '< E (list '+ pgn rn))
                                          (list '<= rm h) (list '<= rn h)
                                          (list '= (list '+ h h) eps)
                                          (list 'IN (list dM sgm sgn) 'RR) (list 'IN (list dM sgm sw) 'RR)
                                          (list 'IN (list dM sw sgn) 'RR) (list 'IN (list dM sgn sw) 'RR)
                                          (list 'IN pw 'RR) (list 'IN pgm 'RR) (list 'IN pgn 'RR)
                                          (list 'IN E 'RR) (list 'IN rm 'RR) (list 'IN rn 'RR)
                                          (list 'IN h 'RR) (list 'IN eps 'RR)))))))))))))
      (display ";; rb2 main: Cauchy done") (newline)
      ;; ---- the limit
      (let* ((cpl (list 'FORALL 'f (list 'IMPLIES (list 'IS-CAUCHY-SEQ M 'f) (list 'CONVERGES M 'f))))
             (cpl* (dk-project! cpl 'is-complete (list 'IS-COMPLETE M)))
             (cv  (dk-apply! cpl* seq))
             (lex (dk-landed-1 (lambda () (mac-h 'converges cv))))
             (L   (dk-skolem! lex))
             (ct  (dk-split! (dk-landed-1 (lambda () (mac-h 'converges-to (list 'CONVERGES-TO M seq L))))))
             (convh (dk-pick (lambda (a) (and (pair? a) (eq? (car a) 'FORALL)
                                              (dk-contains? a L) (dk-contains? a 'FORSOME)))
                             "the convergence to L")))
        (display ";; rb2 main L: ") (display L) (newline)
        (dk-have! (list 'IN L cg)
          (lambda () (subst (list '== cg (list 'PTS M))) (ass)))
        (mac 'is-summable)
        (ew L)
        (dk-conj-close!
          (lambda ()
            (if (eq? (car (dk-goal)) 'IN)
                (ass)
                (begin
                  (mac 'sums-to)
                  (let* ((landed (dk-peel!))
                         (eps (cadr (car landed)))
                         (h (dk-halve! eps))
                         (nx (dk-apply! nullh h))
                         (N1 (dk-skolem! nx))
                         (rbd (dk-pick (lambda (a) (and (pair? a) (eq? (car a) 'FORALL)
                                                        (dk-contains? a (list '<= N1 'k))))
                                       "the rad bound past N1"))
                         (cx (dk-apply! convh h))
                         (N2 (dk-skolem! cx))
                         (cvb (dk-pick (lambda (a) (and (pair? a) (eq? (car a) 'FORALL)
                                                        (dk-contains? a N2) (dk-contains? a L)))
                                       "the convergence bound past N2"))
                         (n0 (list '+ N1 N2)))
                    (fact 'rr-pos-rr-in-rr eps)
                    (dk-have! (list 'AND (list 'IN N1 'NN) (list 'IN N2 'NN))
                              (lambda () (dk-conj-close! (lambda () (ass)))))
                    (fact 'nn-add-closed N1 N2)
                    (dk-have! (list '<= N1 n0) (lambda () (dk-nn!)))
                    (dk-have! (list '<= N2 n0) (lambda () (dk-nn!)))
                    (rb2-gn! n0)
                    (let* ((gn0 (list gsq n0))
                           (sg (rb2-S grp f gn0)) (pg (rb2-P g gn0)) (r0 (list rad n0))
                           (s0 (list seq n0)))
                      (dk-have! (list 'AND (list 'IN n0 'NN) (list '<= N1 n0))
                                (lambda () (dk-conj-close! (lambda () (ass)))))
                      (dk-apply! rbd n0)
                      (let* ((cb (dk-apply! cvb n0))
                             (seq-eq (list '= s0 sg)))
                        (dk-have! seq-eq (lambda () (if (not (dk-lam-b!)) (rfl))))
                        (let ((cb2 (dk-rewrite-h! cb s0 sg)))
                          (ew gn0)
                          (dk-conj-close!
                            (lambda ()
                              (cond ((not (eq? (car (dk-goal)) 'FORALL))
                                     (ass))
                                    (#t
                                     (let* ((landed3 (dk-peel!))
                                            (ext (cadr (cadr (car landed3))))
                                            (se (rb2-S grp f ext)) (pe (rb2-P g ext)))
                                       (dk-split-all! landed3)
                                       (rb2-w-facts! grp f g D ext)
                                       (rb2-upper! g D ext)
                                       (dk-apply! (dk-cite! 'rb2-dist-subset grp f g D) gn0 ext)
                                       (fact 'nag-metric-distance grp L se)
                                       (subst (list '= (rb2-N grp (list (list 'OPR grp) L
                                                                        (list (list 'INV grp) se)))
                                                    (list dM L se)))
                                       (fact 'metric-triangle M L sg se)
                                       (fact 'metric-sym M sg L)
                                       (for-each (lambda (pq) (fact 'metric-dist-real M (car pq) (cdr pq)))
                                                 (list (cons L se) (cons L sg) (cons sg se) (cons sg L)))
                                       (dk-ineq! (list '<= (list dM L se)
                                                       (list '+ (list dM L sg) (list dM sg se)))
                                                 (list '= (list dM sg L) (list dM L sg))
                                                 cb2
                                                 (list '<= (list dM sg se) (list '- pe pg))
                                                 (list '<= pe E)
                                                 (list '< E (list '+ pg r0))
                                                 (list '<= r0 h)
                                                 (list '= (list '+ h h) eps)
                                                 (list 'IN (list dM L se) 'RR) (list 'IN (list dM L sg) 'RR)
                                                 (list 'IN (list dM sg se) 'RR) (list 'IN (list dM sg L) 'RR)
                                                 (list 'IN pe 'RR) (list 'IN pg 'RR) (list 'IN E 'RR)
                                                 (list 'IN r0 'RR) (list 'IN h 'RR)
                                                 (list 'IN eps 'RR)))))))))))))))))))
(rb2-done! 'absolute-summable-implies-summable)
(topic! 'absolute-summable-implies-summable 'analysis)

(display ";; rb2 qed failures: ") (write *vnb-qed-failures*) (newline)
