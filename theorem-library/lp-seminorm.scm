;;; lp-seminorm.scm -- THE L^p SEMINORM: the seminorm laws (MEASURE-4-C,
;;; 2026-10-10).  Vocabulary: structure-library/lp-seminorm.scm (LP-NORM =
;;; EP-NORM of ABS-FN).
;;;
;;; SOURCE.  Thayer, Construction of Measures, Ch. 2, Def. 2.22 (p. 16) and
;;; Prop. 2.19 (Minkowski, p. 15).  Under the user's decision of 2026-10-09/10
;;; there is no quotient by equality a.e.: LP-NORM is a seminorm on the real
;;; measurable functions, and its kernel is "f = g except on a null set".
;;;
;;; THE THEOREMS.
;;;   lp-norm-unfold        the unfold equation.
;;;   real-measurable-add / -sub
;;;                         f + g, f - g real measurable (as x |-> f(x) +- g(x)),
;;;                         by pos-/neg-part-measurable-of-diff
;;;                         (theorem-library/real-integral.scm).
;;;   ep-norm-mono          h1 <= h2 pointwise => I_p(h1) <= I_p(h2), p > 0.
;;;   ep-norm-scale         I_p(k h) = k I_p(h), k real >= 0, p > 0 (k = 0
;;;                         separately: epow-etimes needs k > 0).
;;;   lp-norm-homogeneous   ||c f||_p = |c| ||f||_p, c real, p > 0.
;;;   lp-norm-triangle      ||f + g||_p <= ||f||_p + ||g||_p, p >= 1: |f + g| <=
;;;                         |f| + |g| pointwise, ep-norm-mono, Minkowski.
;;;   lp-norm-zero-iff      ||f - g||_p = 0 iff f = g except on a null set, p > 0
;;;                         (ep-norm-zero-null one way; integral-le-off-null
;;;                         and integral-zero-fn the other).
;;;
;;; LOAD WINDOW.  lo: theorem-library/lp-inequalities (minkowski,
;;; ep-norm-zero-null, ep-norm-unfold, epow-*, measurable-fn-epow,
;;; ptwise-scale-measurable (real-integral), ptwise-epow-value, ptwise-eplus-value,
;;; ptwise-scale-value); theorem-library/real-integral (integral-abs-fn,
;;; abs-fn-value, abs-fn-fun, part-values-at, pos-/neg-part-fun,
;;; pos-/neg-part-measurable-of-diff, ptwise-eplus-value-q, integral-zero-fn,
;;; is-null-set via the witness).  No late tactic.  hi: nothing cites these
;;; names.  Slot: structure-library/lp-seminorm then this file, immediately
;;; after "theorem-library/lp-inequalities".  Library: measure.
;;; ====================================================================

;;; =====================================================================
;;; (0) file-local kit.  Prefix lps-.  Copied from theorem-library/
;;;     real-integral.scm (the rin- helpers, local to that file), renamed.
;;; =====================================================================

(define (lps-keep-prop! . keepers)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! keepers)
    (if (not (sequent-node-grounded? leaf)) (prop))))

(define (lps-conj-close! . opt)
  (let ((closer (if (pair? opt) (car opt) from-context!)))
    (let walk ()
      (let ((g (dk-goal)))
        (if (and (pair? g) (eq? (car g) 'AND))
            (for-each (lambda (k)
                        (if (not (sequent-node-grounded? k))
                            (begin (dk-focus! k) (walk))))
                      (dk-opened (lambda () (di))))
            (closer))))))

(define (lps-rps! tm)
  (if (not (dk-asm? (list 'IN tm 'RR-POS-STAR)))
      (dk-have! (list 'IN tm 'RR-POS-STAR)
        (lambda ()
          (let ((inst (dk-fact! 'rr-pos-star-membership tm)))
            (lps-keep-prop! inst (list 'IN tm 'RR) (list '<= 0 tm)))))))

(define (lps-sep-in! closer)
  (for-each (lambda (l)
              (if (not (sequent-node-grounded? l))
                  (begin (dk-focus! l) (closer))))
            (dk-opened (lambda () (sep-mi)))))

(define (lps-parts! pred args)
  (let* ((iff (apply dk-cite! (cons pred args)))
         (rhs (caddr iff))
         (cs  (let loop ((r rhs) (acc '()))
                (if (and (pair? r) (eq? (car r) 'and))
                    (loop (caddr r) (cons (cadr r) acc))
                    (reverse (cons r acc))))))
    (map (lambda (c) (dk-project! c pred (cons pred args))) cs)))

(define (lps-eplus-eq! u v)
  (let ((e (list '= (list 'eplus u v) (list '+ u v))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (fact 'eplus-real-defined u v)
            (subst (list '= (list 'eplus u v) (list 'binplus u v)))
            (fact 'binplus-apply u v)
            (subst (list '== (list 'binplus u v) (list '+ u v)))
            (fact 'rr-add-closed u v)
            (rfl))))
    e))

(define (lps-absurd! . prems)
  (if (eq? (dk-goal) 'FALSITY)
      (apply dk-absurd! prems)
      (begin
        (dk-have! 'FALSITY (lambda () (apply dk-absurd! prems)))
        (lps-keep-prop! 'FALSITY))))

(define (lps-var-in landed om)
  (let ((hit (filter (lambda (f) (and (pair? f) (eq? (car f) 'in) (equal? (caddr f) om))) landed)))
    (if (null? hit) (error "lps-var-in: no typing landed in" om))
    (cadr (car hit))))

(define (lps-pos f) (list 'POS-PART 'omega f))

(define (lps-neg f) (list 'NEG-PART 'omega f))

(define (lps-parts-at! f x)
  (let ((px (list (lps-pos f) x)) (nx (list (lps-neg f) x)))
    (if (not (dk-asm? (list '= (list f x) (list '- px nx))))
        (let ((c (dk-cite! 'part-values-at 'omega f x)))
          (fact 'fun-apply-type-c f 'omega 'RR x)
          (if (and (pair? c) (eq? (car c) 'AND)) (dk-split-all! (list c)))))
    (list px nx)))

(define (lps-sign-cases! f x body)
  (let ((fx (list f x)))
    (fact 'fun-apply-type-c f 'omega 'RR x)
    (lps-parts-at! f x)
    (use-em (list '<= 0 fx)
      (lambda ()
        (let ((c (dk-cite! 'part-values-nonneg 'omega f x)))
          (if (and (pair? c) (eq? (car c) 'AND)) (dk-split! c)))
        (body #t))
      (lambda ()
        (fact 'rr-not-le-lt 0 fx)
        (let ((c (dk-cite! 'part-values-neg 'omega f x)))
          (if (and (pair? c) (eq? (car c) 'AND)) (dk-split! c)))
        (body #f)))))

(define (lps-ineq-goal! cands)
  (apply dk-ineq! (filter dk-asm? cands)))

(define (lps-pe-at! g1 g2 x)
  (let* ((w (list 'PTWISE-EPLUS 'omega g1 g2)) (ax (list g1 x)) (bx (list g2 x)))
    (lps-eplus-eq! ax bx)
    (dk-have! (list 'AND (list 'IN ax 'RR) (list 'IN bx 'RR)))
    (fact 'rr-add-closed ax bx)
    (dk-cite! 'ptwise-eplus-value-q 'omega g1 g2 x)
    (dk-have! (list '= (list w x) (list '+ ax bx))
      (lambda ()
        (subst (list '== (list w x) (list 'eplus ax bx)))
        (subst (list '= (list 'eplus ax bx) (list '+ ax bx)))
        (rfl)))
    (list '= (list w x) (list '+ ax bx))))

(define (lps-pt-prems f x . more)
  (let* ((fx (list f x)) (px (list (lps-pos f) x)) (nx (list (lps-neg f) x)))
    (append
      (list (list 'IN fx 'RR) (list 'IN px 'RR) (list 'IN nx 'RR)
            (list '<= 0 px) (list '<= 0 nx)
            (list '= fx (list '- px nx))
            (list '= px fx) (list '= px 0) (list '= nx 0) (list '= nx (list '- fx))
            (list '< fx 0) (list '<= 0 fx))
      more)))

(define (lps-int-facts! g)
  (let ((ig (list 'INTEGRAL 'omega 'cA 'mu g)))
    (fact 'integral-in 'omega 'cA 'mu g)
    (fact 'rr-pos-star-nonneg ig)))

(define (lps-rps-antisym! a b)
  (dk-have! (list 'AND (list 'IN a 'RR-POS-STAR) (list 'IN b 'RR-POS-STAR)))
  (dk-have! (list 'AND (list '<= a b) (list '<= b a)))
  (fact 'rr-pos-star-le-antisymm a b)
  (list '= a b))

(define (lps-forall-pt! body-of pt!)
  (let ((claim (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (body-of 'x)))))
    (dk-have! claim (lambda () (pt! (dk-di-var!))))
    claim))

(define (lps-etimes-eq! u v)
  (let ((e (list '= (list 'etimes u v) (list '* u v))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (fact 'etimes-real-defined u v)
            (subst (list '= (list 'etimes u v) (list 'bintimes u v)))
            (fact 'bintimes-apply u v)
            (subst (list '== (list 'bintimes u v) (list '* u v)))
            (dk-have! (list 'AND (list 'IN u 'RR) (list 'IN v 'RR)))
            (fact 'rr-mul-closed u v)
            (rfl))))
    e))

(define lps-zero-fn '(VNB-LAMBDA cx_ omega 0))

(define (lps-lam-at! s x val)
  (let ((e (list '= (list s x) val)))
    (if (not (dk-asm? e))
        (dk-have! e (lambda () (if (not (dk-lam-b!)) (rfl)))))
    e))

(define (lps-null-witness! ns)
  (let* ((iff (dk-cite! 'is-null-set 'omega 'cA 'mu ns))
         (rhs (caddr iff)))
    (dk-have! rhs (lambda () (lps-keep-prop! iff (list 'IS-NULL-SET 'omega 'cA 'mu ns))))
    (dk-skolem! (dk-ctx-form rhs))))

(define (lps-subset-elim! a b x)
  (dk-have! (list 'IN x b)
    (lambda ()
      (let* ((iff (dk-cite! 'subset-def a b)) (rhs (caddr iff)))
        (dk-have! rhs (lambda () (lps-keep-prop! iff (list 'SUBSET a b))))
        (dk-apply! (dk-ctx-form rhs) x)
        (dk-ass!)))))

(define (lps-not-in-ns! ns nb x)
  (dk-have! (list 'NOT (list 'IN x ns))
    (lambda ()
      (di)
      (lps-subset-elim! ns nb x)
      (lps-keep-prop! (list 'IN x nb) (list 'NOT (list 'IN x nb))))))
;;; =====================================================================
;;; (1) the unfold equation; sums and differences of real measurable
;;;     functions are real measurable
;;; =====================================================================

(define (lps-int u) (list 'INTEGRAL 'omega 'cA 'mu u))
(define (lps-abs u) (list 'ABS-FN 'omega u))
(define (lps-ep p u) (list 'EP-NORM 'omega 'cA 'mu p u))
(define (lps-epw u p) (list 'PTWISE-EPOW 'omega u p))
(define lps-sum '(VNB-LAMBDA sx_ omega (+ (f sx_) (g sx_))))
(define lps-dif '(VNB-LAMBDA sx_ omega (- (f sx_) (g sx_))))
(define lps-scl '(VNB-LAMBDA sx_ omega (* c (f sx_))))

;;; lp-norm-unfold
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL lpp_ (FORALL lpf_
  (== (LP-NORM omega cA mu lpp_ lpf_) (EP-NORM omega cA mu lpp_ (ABS-FN omega lpf_))))))))))
(di) (mac 'LP-NORM) (qrfl)
(qed 'lp-norm-unfold)
(topic! 'lp-norm-unfold 'plumbing)

;;; recip facts for p real > 0
(define (lps-recip! p)
  (let ((r (list 'recip p)))
    (if (not (dk-asm? (list '< 0 r)))
        (begin
          (fact 'rr-pos-ne-zero p)
          (dk-have! (list 'AND (list 'IN p 'RR) (list 'NOT (list '= p 0))))
          (fact 'rr-recip-closed p)
          (fact 'rr-recip-pos p)))
    r))

;;; IS-REAL-MEASURABLE-FN of S = H1 - H2 (OP '+ : H1 = f+ (+) g+, H2 = f- (+) g-;
;;; OP '- : H1 = f+ (+) g-, H2 = f- (+) g+), after the peel
(define (lps-real-meas-comb! op)
  (let* ((s (if (eq? op '+) lps-sum lps-dif))
         (pf (lps-pos 'f)) (nf (lps-neg 'f)) (pg (lps-pos 'g)) (ng (lps-neg 'g))
         (a1 pf) (b1 (if (eq? op '+) pg ng)) (a2 nf) (b2 (if (eq? op '+) ng pg))
         (h1 (list 'PTWISE-EPLUS 'omega a1 b1)) (h2 (list 'PTWISE-EPLUS 'omega a2 b2))
         (pt! (lambda (x)
                (lps-parts-at! 'f x) (lps-parts-at! 'g x)
                (lps-pe-at! a1 b1 x) (lps-pe-at! a2 b2 x))))
    (lps-parts! 'IS-REAL-MEASURABLE-FN '(omega cA f))
    (lps-parts! 'IS-REAL-MEASURABLE-FN '(omega cA g))
    (fact 'fun-domain-in-set 'omega 'RR 'f)
    (for-each (lambda (u) (fact 'pos-part-fun 'omega u) (fact 'neg-part-fun 'omega u)) '(f g))
    (fact 'measurable-fn-eplus 'omega 'cA a1 b1)
    (fact 'measurable-fn-eplus 'omega 'cA a2 b2)
    (dk-have! (list 'IN s '(FUN omega RR))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((x (dk-di-var!)))
              (fact 'fun-apply-type-c 'f 'omega 'RR x)
              (fact 'fun-apply-type-c 'g 'omega 'RR x)
              (if (eq? op '+)
                  (begin (dk-have! (list 'AND (list 'IN (list 'f x) 'RR) (list 'IN (list 'g x) 'RR)))
                         (fact 'rr-add-closed (list 'f x) (list 'g x)))
                  (fact 'rr-sub-in-rr (list 'f x) (list 'g x)))
              (ass))))))
    (lps-forall-pt! (lambda (x) (list 'IN (list h1 x) 'RR))
      (lambda (x) (pt! x) (subst (list '= (list h1 x) (list '+ (list a1 x) (list b1 x)))) (dk-ass!)))
    (lps-forall-pt! (lambda (x) (list 'IN (list h2 x) 'RR))
      (lambda (x) (pt! x) (subst (list '= (list h2 x) (list '+ (list a2 x) (list b2 x)))) (dk-ass!)))
    (lps-forall-pt! (lambda (x) (list '= (list s x) (list '- (list h1 x) (list h2 x))))
      (lambda (x)
        (pt! x)
        (let ((v (list op (list 'f x) (list 'g x))))
          (if (eq? op '+)
              (begin (dk-have! (list 'AND (list 'IN (list 'f x) 'RR) (list 'IN (list 'g x) 'RR)))
                     (fact 'rr-add-closed (list 'f x) (list 'g x)))
              (fact 'rr-sub-in-rr (list 'f x) (list 'g x)))
          (lps-lam-at! s x v)
          (subst (list '= (list s x) v))
          (subst (list '= (list h1 x) (list '+ (list a1 x) (list b1 x))))
          (subst (list '= (list h2 x) (list '+ (list a2 x) (list b2 x))))
          (lps-ineq-goal! (append (lps-pt-prems 'f x) (lps-pt-prems 'g x))))))
    (fact 'pos-part-measurable-of-diff 'omega 'cA s h1 h2)
    (fact 'neg-part-measurable-of-diff 'omega 'cA s h1 h2)
    (mac 'IS-REAL-MEASURABLE-FN)
    (lps-conj-close! (lambda () (dk-ass!)))))

;;; real-measurable-add
(sp (make-wff '(FORALL omega (FORALL cA (FORALL f (FORALL g
  (IMPLIES (IS-REAL-MEASURABLE-FN omega cA f) (IMPLIES (IS-REAL-MEASURABLE-FN omega cA g)
    (IS-REAL-MEASURABLE-FN omega cA (VNB-LAMBDA sx_ omega (+ (f sx_) (g sx_))))))))))))
(dk-peel!)
(lps-real-meas-comb! '+)
(qed 'real-measurable-add)
(topic! 'real-measurable-add 'analysis)

;;; real-measurable-sub
(sp (make-wff '(FORALL omega (FORALL cA (FORALL f (FORALL g
  (IMPLIES (IS-REAL-MEASURABLE-FN omega cA f) (IMPLIES (IS-REAL-MEASURABLE-FN omega cA g)
    (IS-REAL-MEASURABLE-FN omega cA (VNB-LAMBDA sx_ omega (- (f sx_) (g sx_))))))))))))
(dk-peel!)
(lps-real-meas-comb! '-)
(qed 'real-measurable-sub)
(topic! 'real-measurable-sub 'analysis)

;;; =====================================================================
;;; (2) I_p is monotone and positively homogeneous on [0,+inf]-valued
;;;     measurable functions
;;; =====================================================================

;;; (IN (EP-NORM p h) RR-POS-STAR), h measurable, p real > 0, recip facts in context
(define (lps-ep-rps! p h)
  (let* ((e (lps-ep p h)) (i (lps-int (lps-epw h p))) (r (list 'recip p)))
    (if (not (dk-asm? (list 'IN e 'RR-POS-STAR)))
        (dk-have! (list 'IN e 'RR-POS-STAR)
          (lambda ()
            (dk-cite! 'ep-norm-unfold 'omega 'cA 'mu p h)
            (subst (list '== e (list 'EPOW i r)))
            (fact 'measurable-fn-epow 'omega 'cA h p)
            (fact 'integral-in 'omega 'cA 'mu (lps-epw h p))
            (fact 'epow-in i r)
            (dk-ass!))))))

;;; ep-norm-mono
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL p (FORALL h1 (FORALL h2
  (IMPLIES (IS-MEASURE omega cA mu)
  (IMPLIES (IS-MEASURABLE-FN omega cA h1)
  (IMPLIES (IS-MEASURABLE-FN omega cA h2)
  (IMPLIES (FORALL x (IMPLIES (IN x omega) (<= (h1 x) (h2 x))))
  (IMPLIES (IN p RR)
  (IMPLIES (< 0 p)
    (<= (EP-NORM omega cA mu p h1) (EP-NORM omega cA mu p h2))))))))))))))))
(dk-peel!)
(let* ((e1 (lps-epw 'h1 'p)) (e2 (lps-epw 'h2 'p))
       (i1 (lps-int e1)) (i2 (lps-int e2))
       (hle '(FORALL x (IMPLIES (IN x omega) (<= (h1 x) (h2 x))))))
  (lps-parts! 'IS-MEASURABLE-FN '(omega cA h1))
  (lps-parts! 'IS-MEASURABLE-FN '(omega cA h2))
  (let ((r (lps-recip! 'p)))
    (dk-have! (list 'PTWISE-LE 'omega e1 e2)
      (lambda ()
        (mac 'PTWISE-LE)
        (let ((x (dk-di-var!)))
          (dk-apply! hle x)
          (fact 'fun-apply-type-c 'h1 'omega 'RR-POS-STAR x)
          (fact 'fun-apply-type-c 'h2 'omega 'RR-POS-STAR x)
          (dk-cite! 'ptwise-epow-value 'omega 'h1 'p x)
          (dk-cite! 'ptwise-epow-value 'omega 'h2 'p x)
          (fact 'epow-mono (list 'h1 x) (list 'h2 x) 'p)
          (subst (list '= (list e1 x) (list 'EPOW (list 'h1 x) 'p)))
          (subst (list '= (list e2 x) (list 'EPOW (list 'h2 x) 'p)))
          (dk-ass!))))
    (fact 'measurable-fn-epow 'omega 'cA 'h1 'p)
    (fact 'measurable-fn-epow 'omega 'cA 'h2 'p)
    (fact 'integral-monotone 'omega 'cA 'mu e1 e2)
    (fact 'integral-in 'omega 'cA 'mu e1)
    (fact 'integral-in 'omega 'cA 'mu e2)
    (fact 'epow-mono i1 i2 r)
    (dk-cite! 'ep-norm-unfold 'omega 'cA 'mu 'p 'h1)
    (dk-cite! 'ep-norm-unfold 'omega 'cA 'mu 'p 'h2)
    (subst (list '== (lps-ep 'p 'h1) (list 'EPOW i1 r)))
    (subst (list '== (lps-ep 'p 'h2) (list 'EPOW i2 r)))
    (dk-ass!)))
(qed 'ep-norm-mono)
(topic! 'ep-norm-mono 'analysis)

;;; ep-norm-scale
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL p (FORALL k (FORALL h
  (IMPLIES (IS-MEASURE omega cA mu)
  (IMPLIES (IS-MEASURABLE-FN omega cA h)
  (IMPLIES (IN k RR)
  (IMPLIES (<= 0 k)
  (IMPLIES (IN p RR)
  (IMPLIES (< 0 p)
    (= (EP-NORM omega cA mu p (PTWISE-SCALE omega k h))
       (etimes k (EP-NORM omega cA mu p h)))))))))))))))))
(dk-peel!)
(let* ((sc '(PTWISE-SCALE omega k h))
       (eh (lps-epw 'h 'p)) (es (lps-epw sc 'p))
       (ih (lps-int eh)) (is (lps-int es))
       (en (lps-ep 'p 'h)) (esn (lps-ep 'p sc))
       (cz lps-zero-fn)
       (r (lps-recip! 'p)))
  (lps-parts! 'IS-MEASURE '(omega cA mu))
  (lps-parts! 'IS-MEASURABLE-FN '(omega cA h))
  (fact 'sigma-algebra-ambient-set 'omega 'cA)
  (lps-rps! 'k)
  (fact 'ptwise-scale-measurable 'omega 'cA 'h 'k)
  (lps-parts! 'IS-MEASURABLE-FN (list 'omega 'cA sc))
  (fact 'measurable-fn-epow 'omega 'cA 'h 'p)
  (fact 'measurable-fn-epow 'omega 'cA sc 'p)
  (lps-parts! 'IS-MEASURABLE-FN (list 'omega 'cA es))
  (lps-parts! 'IS-MEASURABLE-FN (list 'omega 'cA eh))
  (lps-ep-rps! 'p 'h)
  (dk-cite! 'ep-norm-unfold 'omega 'cA 'mu 'p sc)
  (dk-cite! 'ep-norm-unfold 'omega 'cA 'mu 'p 'h)
  (fact 'integral-in 'omega 'cA 'mu eh)
  (fact 'integral-in 'omega 'cA 'mu es)
  (use-cases (dk-fact! 'rr-le-cases 0 'k)
    ;; k > 0: (k h)^p = k^p h^p, integral-homogeneous, (k^p J)^(1/p) = k J^(1/p)
    (lambda ()
      (let* ((kp (list 'EPOW 'k 'p))
             (sk (list 'PTWISE-SCALE 'omega kp eh)))
        (let ((c (dk-cite! 'epow-pos-real 'k 'p))) (dk-split! c))
        (dk-have! (list '<= 0 kp) (lambda () (dk-ineq! (list 'IN kp 'RR) (list '< 0 kp))))
        (lps-rps! kp)
        (fact 'ptwise-scale-measurable 'omega 'cA eh kp)
        (lps-parts! 'IS-MEASURABLE-FN (list 'omega 'cA sk))
        (dk-fun-ext! es sk 'omega 'RR-POS-STAR #f #f
          (lambda (v)
            (let ((hv (list 'h v)))
              (fact 'fun-apply-type-c 'h 'omega 'RR-POS-STAR v)
              (fact 'fun-apply-type-c sc 'omega 'RR-POS-STAR v)
              (fact 'fun-apply-type-c eh 'omega 'RR-POS-STAR v)
              (dk-cite! 'ptwise-scale-value 'omega 'k 'h v)
              (dk-cite! 'ptwise-epow-value 'omega sc 'p v)
              (dk-cite! 'ptwise-epow-value 'omega 'h 'p v)
              (dk-cite! 'ptwise-scale-value 'omega kp eh v)
              (dk-cite! 'epow-etimes 'k hv 'p)
              (fact 'epow-in hv 'p)
              (dk-have! (list 'AND (list 'IN kp 'RR-POS-STAR) (list 'IN (list 'EPOW hv 'p) 'RR-POS-STAR)))
              (fact 'etimes-closed kp (list 'EPOW hv 'p))
              (subst (list '= (list es v) (list 'EPOW (list sc v) 'p)))
              (subst (list '= (list sc v) (list 'etimes 'k hv)))
              (subst (list '= (list sk v) (list 'etimes kp (list eh v))))
              (subst (list '= (list eh v) (list 'EPOW hv 'p)))
              (subst (list '= (list 'EPOW (list 'etimes 'k hv) 'p) (list 'etimes kp (list 'EPOW hv 'p))))
              (rfl))))
        (fact 'integral-homogeneous 'omega 'cA 'mu eh kp)
        (let ((c (dk-cite! 'epow-inverse 'k 'p))) (dk-split! c))
        (dk-cite! 'epow-etimes kp ih r)
        (fact 'epow-in ih r)
        (dk-have! (list 'AND '(IN k RR-POS-STAR) (list 'IN (list 'EPOW ih r) 'RR-POS-STAR)))
        (fact 'etimes-closed 'k (list 'EPOW ih r))
        (subst (list '== esn (list 'EPOW is r)))
        (subst (list '== en (list 'EPOW ih r)))
        (subst (list '= es sk))
        (subst (list '= (lps-int sk) (list 'etimes kp ih)))
        (subst (list '= (list 'EPOW (list 'etimes kp ih) r) (list 'etimes (list 'EPOW kp r) (list 'EPOW ih r))))
        (subst (list '= (list 'EPOW kp r) 'k))
        (rfl)))
    ;; k = 0: everything is 0
    (lambda ()
      (fact 'rr-zero-in) (fact 'rr-leq-reflexive 0) (lps-rps! 0)
      (fact 'measurable-fn-const 'omega 'cA 0)
      (dk-have! (list 'PTWISE-LE 'omega es cz)
        (lambda ()
          (mac 'PTWISE-LE)
          (let* ((x (dk-di-var!)) (hx (list 'h x)))
            (fact 'fun-apply-type-c 'h 'omega 'RR-POS-STAR x)
            (fact 'fun-apply-type-c sc 'omega 'RR-POS-STAR x)
            (dk-cite! 'ptwise-scale-value 'omega 'k 'h x)
            (dk-cite! 'ptwise-epow-value 'omega sc 'p x)
            (fact 'etimes-zero-left hx)
            (fact 'epow-zero 'p)
            (lps-lam-at! cz x 0)
            (subst (list '= (list cz x) 0))
            (subst (list '= (list es x) (list 'EPOW (list sc x) 'p)))
            (subst (list '= (list sc x) (list 'etimes 'k hx)))
            (subst '(= k 0))
            (subst (list '= (list 'etimes 0 hx) 0))
            (subst '(= (EPOW 0 p) 0))
            (dk-ass!))))
      (fact 'integral-monotone 'omega 'cA 'mu es cz)
      (fact 'integral-zero-fn 'omega 'cA 'mu)
      (lps-int-facts! cz)
      (fact 'rr-pos-star-nonneg is)
      (dk-rewrite-h! (list '<= is (lps-int cz)) (lps-int cz) 0)
      (lps-rps-antisym! is 0)
      (fact 'epow-zero r)
      (fact 'etimes-zero-left en)
      (subst (list '== esn (list 'EPOW is r)))
      (subst (list '= is 0))
      (subst (list '= (list 'EPOW 0 r) 0))
      (subst '(= k 0))
      (subst (list '= (list 'etimes 0 en) 0))
      (rfl))))
(qed 'ep-norm-scale)
(topic! 'ep-norm-scale 'analysis)
;;; =====================================================================
;;; (3) THE SEMINORM LAWS
;;; =====================================================================

;;; ABS-FN(omega, u) measurable and in FUN(omega, RR-POS-STAR), u real measurable
(define (lps-abs-meas! u)
  (let ((c (dk-cite! 'integral-abs-fn 'omega 'cA 'mu u))) (dk-split! c))
  (lps-parts! 'IS-MEASURABLE-FN (list 'omega 'cA (lps-abs u))))

;;; (== ((ABS-FN omega u) x) (abs (u x))) landed, (u x) real, |u x| real >= 0
(define (lps-abs-at! u x)
  (fact 'fun-apply-type-c u 'omega 'RR x)
  (fact 'rr-abs-closed (list u x))
  (fact 'rr-abs-nonneg (list u x))
  (dk-cite! 'abs-fn-value 'omega u x)
  (fact 'fun-apply-type-c (lps-abs u) 'omega 'RR-POS-STAR x))

;;; lp-norm-homogeneous
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL p (FORALL f (FORALL c
  (IMPLIES (IS-MEASURE omega cA mu)
  (IMPLIES (IS-REAL-MEASURABLE-FN omega cA f)
  (IMPLIES (IN c RR)
  (IMPLIES (IN p RR)
  (IMPLIES (< 0 p)
    (= (LP-NORM omega cA mu p (VNB-LAMBDA sx_ omega (* c (f sx_))))
       (etimes (abs c) (LP-NORM omega cA mu p f))))))))))))))))
(dk-peel!)
(let* ((s lps-scl) (af (lps-abs 'f)) (as (lps-abs s))
       (ac '(abs c)) (sc (list 'PTWISE-SCALE 'omega '(abs c) af)))
  (lps-parts! 'IS-REAL-MEASURABLE-FN '(omega cA f))
  (fact 'fun-domain-in-set 'omega 'RR 'f)
  (lps-abs-meas! 'f)
  (fact 'rr-abs-closed 'c)
  (fact 'rr-abs-nonneg 'c)
  (lps-rps! ac)
  (fact 'ptwise-scale-measurable 'omega 'cA af ac)
  (lps-parts! 'IS-MEASURABLE-FN (list 'omega 'cA sc))
  (dk-have! (list 'IN s '(FUN omega RR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((x (dk-di-var!)))
            (fact 'fun-apply-type-c 'f 'omega 'RR x)
            (dk-have! (list 'AND '(IN c RR) (list 'IN (list 'f x) 'RR)))
            (fact 'rr-mul-closed 'c (list 'f x))
            (ass))))))
  (fact 'abs-fn-fun 'omega s)
  (dk-fun-ext! as sc 'omega 'RR-POS-STAR #f #f
    (lambda (v)
      (let* ((fv (list 'f v)) (afv (list 'abs fv)) (cfv (list '* 'c fv)))
        (lps-abs-at! 'f v)
        (dk-have! (list 'AND '(IN c RR) (list 'IN fv 'RR)))
        (fact 'rr-mul-closed 'c fv)
        (lps-lam-at! s v cfv)
        (fact 'rr-abs-mult 'c fv)
        (dk-cite! 'abs-fn-value 'omega s v)
        (dk-cite! 'ptwise-scale-value 'omega ac af v)
        (lps-etimes-eq! ac afv)
        (dk-have! (list 'AND (list 'IN ac 'RR) (list 'IN afv 'RR)))
        (fact 'rr-mul-closed ac afv)
        (subst (list '== (list as v) (list 'abs (list s v))))
        (subst (list '= (list s v) cfv))
        (subst (list '= (list 'abs cfv) (list '* ac afv)))
        (subst (list '= (list sc v) (list 'etimes ac (list af v))))
        (subst (list '== (list af v) afv))
        (subst (list '= (list 'etimes ac afv) (list '* ac afv)))
        (rfl))))
  (dk-cite! 'lp-norm-unfold 'omega 'cA 'mu 'p s)
  (dk-cite! 'lp-norm-unfold 'omega 'cA 'mu 'p 'f)
  (fact 'ep-norm-scale 'omega 'cA 'mu 'p ac af)
  (subst (list '== (list 'LP-NORM 'omega 'cA 'mu 'p s) (lps-ep 'p as)))
  (subst (list '== '(LP-NORM omega cA mu p f) (lps-ep 'p af)))
  (subst (list '= as sc))
  (dk-ass!))
(qed 'lp-norm-homogeneous)
(topic! 'lp-norm-homogeneous 'analysis)

;;; lp-norm-triangle (from Minkowski and |f + g| <= |f| + |g|)
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL p (FORALL f (FORALL g
  (IMPLIES (IS-MEASURE omega cA mu)
  (IMPLIES (IS-REAL-MEASURABLE-FN omega cA f)
  (IMPLIES (IS-REAL-MEASURABLE-FN omega cA g)
  (IMPLIES (IN p RR)
  (IMPLIES (<= 1 p)
    (<= (LP-NORM omega cA mu p (VNB-LAMBDA sx_ omega (+ (f sx_) (g sx_))))
        (eplus (LP-NORM omega cA mu p f) (LP-NORM omega cA mu p g))))))))))))))))
(dk-peel!)
(let* ((s lps-sum) (af (lps-abs 'f)) (ag (lps-abs 'g)) (as (lps-abs s))
       (pe (list 'PTWISE-EPLUS 'omega af ag))
       (es (lps-ep 'p as)) (ep (lps-ep 'p pe)) (ef (lps-ep 'p af)) (eg (lps-ep 'p ag))
       (efg (list 'eplus ef eg)))
  (fact 'real-measurable-add 'omega 'cA 'f 'g)
  (lps-parts! 'IS-REAL-MEASURABLE-FN (list 'omega 'cA s))
  (lps-parts! 'IS-REAL-MEASURABLE-FN '(omega cA f))
  (lps-parts! 'IS-REAL-MEASURABLE-FN '(omega cA g))
  (lps-abs-meas! 'f) (lps-abs-meas! 'g) (lps-abs-meas! s)
  (fact 'measurable-fn-eplus 'omega 'cA af ag)
  (lps-parts! 'IS-MEASURABLE-FN (list 'omega 'cA pe))
  (dk-have! '(< 0 p) (lambda () (dk-ineq! '(IN p RR) '(<= 1 p))))
  (lps-recip! 'p)
  (lps-forall-pt! (lambda (x) (list '<= (list as x) (list pe x)))
    (lambda (x)
      (let* ((fx (list 'f x)) (gx (list 'g x)) (afx (list 'abs fx)) (agx (list 'abs gx)))
        (lps-abs-at! 'f x) (lps-abs-at! 'g x) (lps-abs-at! s x)
        (dk-have! (list 'AND (list 'IN fx 'RR) (list 'IN gx 'RR)))
        (fact 'rr-add-closed fx gx)
        (lps-lam-at! s x (list '+ fx gx))
        (fact 'rr-abs-triangle-c fx gx)
        (dk-cite! 'ptwise-eplus-value 'omega af ag x)
        (lps-eplus-eq! afx agx)
        (subst (list '== (list as x) (list 'abs (list s x))))
        (subst (list '= (list s x) (list '+ fx gx)))
        (subst (list '= (list pe x) (list 'eplus (list af x) (list ag x))))
        (subst (list '== (list af x) afx))
        (subst (list '== (list ag x) agx))
        (subst (list '= (list 'eplus afx agx) (list '+ afx agx)))
        (dk-ass!))))
  (fact 'ep-norm-mono 'omega 'cA 'mu 'p as pe)
  (dk-have! '(AND (IN p RR) (<= 1 p)))
  (fact 'minkowski 'omega 'cA 'mu af ag 'p)
  (for-each (lambda (h) (lps-ep-rps! 'p h)) (list as pe af ag))
  (dk-have! (list 'AND (list 'IN ef 'RR-POS-STAR) (list 'IN eg 'RR-POS-STAR)))
  (fact 'eplus-closed ef eg)
  (dk-have! (list 'AND (list 'IN es 'RR-POS-STAR) (list 'AND (list 'IN ep 'RR-POS-STAR) (list 'IN efg 'RR-POS-STAR))))
  (dk-have! (list 'AND (list '<= es ep) (list '<= ep efg)))
  (fact 'rr-pos-star-le-trans es ep efg)
  (dk-cite! 'lp-norm-unfold 'omega 'cA 'mu 'p s)
  (dk-cite! 'lp-norm-unfold 'omega 'cA 'mu 'p 'f)
  (dk-cite! 'lp-norm-unfold 'omega 'cA 'mu 'p 'g)
  (subst (list '== (list 'LP-NORM 'omega 'cA 'mu 'p s) es))
  (subst (list '== '(LP-NORM omega cA mu p f) ef))
  (subst (list '== '(LP-NORM omega cA mu p g) eg))
  (dk-ass!))
(qed 'lp-norm-triangle)
(topic! 'lp-norm-triangle 'analysis)

;;; lp-norm-zero-iff: ||f - g||_p = 0 iff f = g except on a null set
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL p (FORALL f (FORALL g
  (IMPLIES (IS-MEASURE omega cA mu)
  (IMPLIES (IS-REAL-MEASURABLE-FN omega cA f)
  (IMPLIES (IS-REAL-MEASURABLE-FN omega cA g)
  (IMPLIES (IN p RR)
  (IMPLIES (< 0 p)
    (IFF (= (LP-NORM omega cA mu p (VNB-LAMBDA sx_ omega (- (f sx_) (g sx_)))) 0)
         (FORSOME ns (AND (IS-NULL-SET omega cA mu ns)
                          (FORALL x (IMPLIES (IN x omega) (IMPLIES (NOT (IN x ns)) (= (f x) (g x)))))))))))))))))))))
(dk-peel!)
(let* ((d lps-dif) (ad (lps-abs d))
       (ed (lps-epw ad 'p)) (ied (lps-int ed))
       (lp (list 'LP-NORM 'omega 'cA 'mu 'p d)) (en (lps-ep 'p ad))
       (zs (list 'SEP 'x_ 'omega (list '< 0 (list ad 'x_))))
       (cz lps-zero-fn)
       (r (lps-recip! 'p))
       (d-at! (lambda (x)          ; (= (d x) (- (f x) (g x))), typings
                (fact 'fun-apply-type-c 'f 'omega 'RR x)
                (fact 'fun-apply-type-c 'g 'omega 'RR x)
                (fact 'rr-sub-in-rr (list 'f x) (list 'g x))
                (lps-lam-at! d x (list '- (list 'f x) (list 'g x)))
                (lps-abs-at! d x))))
  (lps-parts! 'IS-MEASURE '(omega cA mu))
  (fact 'real-measurable-sub 'omega 'cA 'f 'g)
  (lps-parts! 'IS-REAL-MEASURABLE-FN (list 'omega 'cA d))
  (lps-parts! 'IS-REAL-MEASURABLE-FN '(omega cA f))
  (lps-parts! 'IS-REAL-MEASURABLE-FN '(omega cA g))
  (lps-abs-meas! d)
  (fact 'measurable-fn-epow 'omega 'cA ad 'p)
  (dk-cite! 'lp-norm-unfold 'omega 'cA 'mu 'p d)
  (dk-cite! 'ep-norm-unfold 'omega 'cA 'mu 'p ad)
  (dk-iff! (lambda (g) (dk-head-is? g 'FORSOME))
    ;; ||f - g|| = 0  =>  f = g off the null set { 0 < |f - g| }
    (lambda ()
      (dk-rewrite-h! (list '= lp 0) lp en)
      (let ((c (dk-cite! 'ep-norm-zero-null 'omega 'cA 'mu ad 'p))) (dk-split! c))
      (fact 'subset-refl zs)
      (ew zs)
      (lps-conj-close!
        (lambda ()
          (cond ((dk-asm? (dk-goal)) (ass))
                ((dk-head-is? (dk-goal) 'IS-NULL-SET)
                 (mac 'IS-NULL-SET) (ew zs) (lps-conj-close! (lambda () (dk-ass!))))
                (#t
                 (let* ((x (dk-di-var!)) (dx (list d x)) (adx (list 'abs dx)))
                   (di)
                   (d-at! x)
                   (use-em (list '<= adx 0)
                     (lambda ()
                       (dk-have! (list '= adx 0) (lambda () (dk-ineq! (list 'IN adx 'RR) (list '<= 0 adx) (list '<= adx 0))))
                       (let ((iff (dk-cite! 'rr-abs-zero dx)))
                         (dk-have! (list '= dx 0) (lambda () (lps-keep-prop! iff (list '= adx 0)))))
                       (dk-ineq! (list 'IN (list 'f x) 'RR) (list 'IN (list 'g x) 'RR)
                                 (list '= dx (list '- (list 'f x) (list 'g x))) (list '= dx 0)))
                     (lambda ()
                       (fact 'rr-not-le-lt adx 0)
                       (dk-have! (list 'IN x zs)
                         (lambda ()
                           (lps-sep-in!
                             (lambda ()
                               (if (dk-asm? (dk-goal))
                                   (ass)
                                   (begin (subst (list '== (list ad x) adx)) (dk-ass!)))))))
                       (lps-keep-prop! (list 'IN x zs) (list 'NOT (list 'IN x zs)))))))))))
    ;; f = g off a null set  =>  ||f - g|| = 0
    (lambda ()
      (let* ((ex (dk-pick (lambda (f) (and (pair? f) (eq? (car f) 'forsome))) "the null set"))
             (ns (dk-skolem! ex))
             (heq (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'NOT (list 'IN 'x ns))
                    '(= (f x) (g x))))))
             (nb (lps-null-witness! ns)))
        (fact 'rr-zero-in) (fact 'rr-leq-reflexive 0) (lps-rps! 0)
        (fact 'measurable-fn-const 'omega 'cA 0)
        (fact 'epow-zero 'p)
        (fact 'rr-abs-zero-value)
        (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'NOT (list 'IN 'x nb))
                    (list '<= (list ed 'x) (list cz 'x)))))
          (lambda ()
            (let* ((x (dk-di-var!)) (dx (list d x)))
              (di)
              (lps-not-in-ns! ns nb x)
              (dk-apply! heq x)
              (d-at! x)
              (dk-have! (list '= dx 0)
                (lambda () (dk-ineq! (list 'IN (list 'f x) 'RR) (list 'IN (list 'g x) 'RR)
                                     (list '= dx (list '- (list 'f x) (list 'g x))) (list '= (list 'f x) (list 'g x)))))
              (dk-cite! 'ptwise-epow-value 'omega ad 'p x)
              (lps-lam-at! cz x 0)
              (subst (list '= (list cz x) 0))
              (subst (list '= (list ed x) (list 'EPOW (list ad x) 'p)))
              (subst (list '== (list ad x) (list 'abs dx)))
              (subst (list '= dx 0))
              (subst '(= (abs 0) 0))
              (subst '(= (EPOW 0 p) 0))
              (dk-ass!))))
        (fact 'integral-le-off-null 'omega 'cA 'mu nb ed cz)
        (fact 'integral-zero-fn 'omega 'cA 'mu)
        (lps-int-facts! ed)
        (dk-rewrite-h! (list '<= ied (lps-int cz)) (lps-int cz) 0)
        (lps-rps-antisym! ied 0)
        (fact 'epow-zero r)
        (subst (list '== lp en))
        (subst (list '== en (list 'EPOW ied r)))
        (subst (list '= ied 0))
        (subst (list '= (list 'EPOW 0 r) 0))
        (rfl)))))
(qed 'lp-norm-zero-iff)
(topic! 'lp-norm-zero-iff 'analysis)

