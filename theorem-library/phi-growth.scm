;;; 2026-10-27): the growth of phi.
;;;   nn-power-closed, rr-power-ge-one, rr-power-mono-exp, rr-power-mono-le, rr-power-ge-base   natural powers
;;;   prime-divides-prime-power, prime-decomposition(-bounded), coprime-prime-power   n = q^a m, q not dividing m
;;;   fun-abs-bounded-initial                         |f| is bounded on {1..K}
;;;   multiplicative-bound-step, multiplicative-bounded   LEMMA 1.24 (|f(p^k)| <= 1 for p^k > N: the notes write
;;;                                                    f(p^k) <= 1, which does not suffice)
;;;   euler-phi-pos, euler-phi-prime-power            phi(n) >= 1; phi(p^(j+1)) = p^(j+1) (1 - 1/p)
;;;   euler-phi-ratio-multiplicative, -prime-power, -bounded   n^(1-t)/phi(n) is multiplicative, <= 1 on large
;;;                                                    prime powers, hence bounded
;;;   euler-phi-lower-bound                           COR. 1.26: phi(n) >= c n^(1-delta)
;;;   euler-phi-ratio-limit                           PROP. 1.25: n^(1-delta)/phi(n) -> 0
;;; Exponents delta, t are RATIONAL (RPOW, rpow-defined.scm, takes its exponent in QQ); the notes take delta real.
;;; LOAD WINDOW.  lo: euler-phi-product (and its window), rpow-defined, nn-unbounded-in-rr, rr-abs-basics,
;;; rr-recip-order, antiderivable-uniform-limit (rr-converges-to-abs), nn-parity-proof (nn-zero-or-succ),
;;; card-inequalities, card-singleton-proof, rake-combinatorics2 (interval-card).  hi: none.  Library: analysis.

;;; (0) the ma- kit (file-local copy of scratchpad/ma/final/kit-body.scm)
;;; (0) the ma- kit (file-local; most from push-forward.scm's pfw- kit and product-measure.scm's pms- kit)

(define (ma-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; dk-project!, except that a claim equal to the focus goal is proved in place
(define (ma-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
;;; sequential map (MIT evaluates arguments right to left)
(define (ma-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (ma-for-each f l) (let loop ((l l)) (if (pair? l) (begin (f (car l)) (loop (cdr l))))))
;;; the right-hand conjuncts of an IFF in context whose left side is in context, landed (by prop, on a lane)
(define (ma-iff-parts! iff0)
  (let* ((iff (or (dk-ctx-form iff0) (error "ma-iff-parts!: not in context" (expression->string iff0))))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    ;; the conjunct that is the focus goal (closed in place) goes LAST: closing it moves the focus
    (let* ((goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
           (late  (filter goal? cs))
           (early (filter (lambda (c) (not (goal? c))) cs)))
      (ma-map (lambda (c) (ma-by-prop! c (list iff (cadr iff)))) (append early late))
      cs)))
;;; the LEFT side of an IFF in context whose right side is in context, landed
(define (ma-iff-back! iff0)
  (let ((iff (or (dk-ctx-form iff0) (error "ma-iff-back!: not in context" (expression->string iff0)))))
    (ma-by-prop! (cadr iff)
      (cons iff (let ((r (caddr iff)))
                  (if (dk-asm? r)
                      (list r)
                      (let loop ((r r) (acc '()))
                        (if (and (pair? r) (eq? (car r) 'AND) (not (dk-asm? r)))
                            (loop (caddr r) (cons (cadr r) acc))
                            (reverse (cons r acc))))))))))
;;; CLAIM by prop from the formulas FS: on a lane, or in place when CLAIM is the focus goal; returns CLAIM
(define (ma-by-prop! claim fs)
  (cond ((dk-asm? claim) (dk-ctx-form claim))
        ((eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
         (ma-prop-with! fs) claim)
        (#t (dk-have! claim (lambda () (ma-prop-with! fs))) (dk-ctx-form claim))))
;;; (IN w (SEP v A P)) in context: land (IN w A) and P[w], the membership kept; return P[w].
(define (ma-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s (caddr m)) (v (cadr s)) (dom (caddr s))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "ma-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (let ((c (dk-ctx-form conj))) (if c (ai c)))))
    p))
;;; class extensionality, each direction driven: FWD / BWD procedures of the element; lands lhs = rhs
(define (ma-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'mew_ (list 'IFF (list 'IN 'mew_ lhs) (list 'IN 'mew_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs)
  (list '= lhs rhs))
;;; w in BIG-UNION(v, D, g(v)) gives the index and w in g(index): returns (k . formula)
(define (ma-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (caddr bu)))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
;;; prove the focus goal (IN w bu) at the index k (k in D and w in the k-th term in context)
(define (ma-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
;;; prop on the named formulas only
(define (ma-prop-with! fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))
;;; (IN z (UNION a b)) from (IN z a) / (IN z b) in context
(define (ma-in-union-left! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-l) (dk-ass!))))
(define (ma-in-union-right! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-r) (dk-ass!))))
;;; (IN x (PAIR x x)), x in SET in context
(define (ma-in-singleton! xv)
  (dk-have! (list 'IN xv (list 'PAIR xv xv))
    (lambda ()
      (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
      (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) xv)))
        (dk-have! (list '= xv xv) (lambda () (rfl)))
        (ma-prop-with! (list pm (list '= xv xv)))))))
;;; with (IN b (PAIR x x)) and x in SET in context, land b = x
(define (ma-singleton-eq! b xv)
  (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
  (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) b)))
    (dk-have! (list '= b xv)
      (lambda () (ma-prop-with! (list pm (list 'IN b (list 'PAIR xv xv))))))
    (list '= b xv)))

;;; FINITE-SET INDUCTION (pms-induct!, product-measure.scm).  PROP-OF builds P(s); BASE! proves P(EMPTY-SET)
;;; on its leaf; (STEP! sv xv u ih) proves P(u), u = sv u {xv}, with ih = P(sv) in context.  Returns P(xs).
(define (ma-class prop-of) (list 'COMP 'miu_ (prop-of 'miu_)))
(define (ma-step-formula c)
  (list 'FORALL 'is_
    (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ c)))
      (list 'FORALL 'ix_
        (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
          (list 'IN '(UNION is_ (PAIR ix_ ix_)) c))))))
(define (ma-induct! xs prop-of base! step!)
  (let* ((c     (ma-class prop-of))
         (stepf (ma-step-formula c)))
    (have! (list 'IN 'EMPTY-SET c)
      (lambda ()
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) '(in empty-set set))
                (begin (fact 'empty-set-is-set) (ass))
                (base!)))
          (dk-opened (lambda () (comp-mi))))))
    (have! stepf
      (lambda ()
        (let* ((landed (dk-peel!))
               (g      (dk-goal))
               (u      (cadr g))
               (sv     (cadr u))
               (xv     (cadr (caddr u))))
          (dk-split-all! landed)
          (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
          (fact 'pairing xv xv)
          (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET)))
          (fact 'union-set-closure sv (list 'PAIR xv xv))
          (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv c)))))
                 (ih (car (filter (lambda (f) (not (equal? f (list 'in sv 'set)))) ls))))
            (for-each
              (lambda (leaf)
                (dk-focus! leaf)
                (if (equal? (dk-goal) (list 'in u 'set))
                    (ass)
                    (step! sv xv u ih)))
              (dk-opened (lambda () (comp-mi))))))))
    (dk-have! (list 'AND (list 'IN 'EMPTY-SET c) stepf))
    (let ((ind (dk-fact! 'finite-set-induction c)))
      (dk-have! (list 'AND (list 'IN xs 'SET) (list 'IN (list 'CARD xs) 'NN)))
      (let* ((inx (dk-apply! ind xs))
             (ls  (dk-landed (lambda () (comp-me inx)))))
        (car (filter (lambda (f) (not (equal? f (list 'in xs 'set)))) ls))))))
;;; the membership laws whose instances make the two memberships propositionally equivalent
(define (ma-ext-prop! lhs rhs cites)
  (let ((side (lambda (have)
                (lambda (w)
                  (let ((fs (ma-map (lambda (c) (apply dk-cite! (car c) (cdr c))) (cites w))))
                    (ma-prop-with! (cons (list 'IN w have) fs)))))))
    (ma-ext2! lhs rhs (side lhs) (side rhs))))

;;; (SUBSET (SEP v d p) d)
(define (ma-sep-subset! sep)
  (dk-have! (list 'SUBSET sep (caddr sep))
    (lambda ()
      (mac 'subset-def)
      (let ((z (dk-di-var!)))
        (ma-sep-parts! (list 'IN z sep))
        (ass)))))
;;; s subset of the finite set ca (ca in SET, CARD ca in NN in context): land (IN s SET), (IN (CARD s) NN)
(define (ma-finite-sub! s ca)
  (fact 'subclass-of-set-is-set s ca)
  (dk-have! (list 'AND (list 'IN ca 'SET) (list 'IN (list 'CARD ca) 'NN)))
  (let ((cs (dk-fact! 'card-subset-nn ca)))
    (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s ca z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))))
    (dk-apply! cs s)))

;;; case split on a right-nested disjunction ORF in context, one THUNK per disjunct (each run with that
;;; disjunct in context, on its own leaf)
(define (ma-or-split! orf thunks)
  (let* ((o (or (dk-ctx-form orf) (error "ma-or-split!: not in context" (expression->string orf))))
         (l (cadr o)) (r (caddr o)))
    (for-each
      (lambda (leaf)
        (dk-focus! leaf)
        (cond ((dk-asm? l) ((car thunks)))
              ((pair? (cddr thunks)) (ma-or-split! r (cdr thunks)))
              (#t ((cadr thunks)))))
      (dk-opened (lambda () (ai o))))))
;;; f in FUN(NN, A) and every f(k) in B: f in FUN(NN, B)   (pfw-retype!, push-forward.scm)
(define (ma-retype! fv a b in-b!)
  (dk-have! (list 'IN fv (list 'FUN 'NN b))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c fv 'NN a kv)
                (ma-then-ass! (lambda () (in-b! (list fv kv)))))
              (begin
                (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN fv (list 'FUN 'NN a))))))
                (ass))))))))
;;; a function symbol G in FUN(DOM, COD) with G(k) == BODY(k): returns (G . VALUE-EQUATION)   (pfw-abstract!)
(define (ma-abstract! dom cod body-of typer pre)
  (let* ((body  (body-of 'mak_))
         (lam   (list 'VNB-LAMBDA 'mak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'mak_ (list 'IMPLIES (list 'IN 'mak_ dom)
                                                    (list '== (list g 'mak_) body)))))
         (claim (list 'FORSOME 'mag_ (list 'AND (list 'IN 'mag_ (list 'FUN dom cod))
                                            (vals 'mag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!))))
                (let ((kv (dk-di-var!)))
                  (pre kv)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "ma-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "ma-abstract!: the value equation did not land"))))
      (cons g ve))))

(define (ap-absurd!) (dk-cite! 'rr-lt-irrefl 0) (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0)))))
;;; helpers repeated from the earlier ALGNUM files (file-local there)
(define (nt-nn! . xs) (for-each (lambda (x) (fact 'nn-in-rr x)) xs))
(define (nt-qr a b) (list 'FORSOME 'ntn_ (list 'AND '(IN ntn_ NN) (list 'FORSOME 'ntr_ (list 'AND '(IN ntr_ NN) (list 'AND (list '= b (list '+ (list '* a 'ntn_) 'ntr_)) (list '< 'ntr_ a)))))))
(define (nt2-rfl!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(define (nt2-pw n k)
  ;; pairwise coprime below k
  (list 'FORALL 'cri_ (list 'IMPLIES '(IN cri_ NN) (list 'IMPLIES (list '< 'cri_ k)
    (list 'FORALL 'crj_ (list 'IMPLIES '(IN crj_ NN) (list 'IMPLIES (list '< 'crj_ k)
      (list 'IMPLIES '(NOT (= cri_ crj_)) (list 'ZZ-COPRIME (list n 'cri_) (list n 'crj_))))))))))
(define (nt2-solv n k)
  ;; every system x = a_i (mod n_i), i < k, has a solution
  (list 'FORALL 'cra_ (list 'IMPLIES '(IN cra_ (FUN NN ZZ))
    (list 'FORSOME 'crx_ (list 'AND '(IN crx_ ZZ)
      (list 'FORALL 'cri_ (list 'IMPLIES '(IN cri_ NN) (list 'IMPLIES (list '< 'cri_ k)
        (list 'ZZ-DIVIDES (list n 'cri_) '(- crx_ (cra_ cri_)))))))))))
(define (nt2-bez a b) (list 'FORSOME 'crx_ (list 'AND '(IN crx_ ZZ) (list 'FORSOME 'cry_ (list 'AND '(IN cry_ ZZ) (list '= (list '+ (list '* 'crx_ a) (list '* 'cry_ b)) 1))))))
(define (nt2-gcd-parts a b g)
  (list (list 'ZZ-DIVIDES g a) (list 'ZZ-DIVIDES g b)
        (forall-guarded '(e_) (list '(IN e_ ZZ) (list 'ZZ-DIVIDES 'e_ a) (list 'ZZ-DIVIDES 'e_ b)) (list 'ZZ-DIVIDES 'e_ g))))
(define (nt2-div-intro! d x c)
  ;; goal (ZZ-DIVIDES d x), d, x, c in ZZ, (= x (* d c)) provable by crs after the caller's substitutions: c the witness
  (mac 'zz-divides)
  (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew c) (dk-conj-close! dk-ass!))))))
(define (nt2-eq-last! i v)
  (fact 'nn-in-rr i) (fact 'nn-in-rr v)
  (dk-have! (list '= i v)
    (lambda ()
      (ma-or-split! (dk-apply! (dk-cite! 'rr-lt-trichotomy i v))
        (list (lambda () (ma-prop-with! (list (list '< i v) (list 'NOT (list '< i v)))))
              (lambda () (ass))
              (lambda ()
                (dk-apply! (dk-cite! 'nn-lt-succ-le v i))
                (dk-have! '(< 0 0) (lambda () (dk-nn! (list '<= (list 'succ v) i) (list '< i (list 'succ v)))))
                (ap-absurd!)))))))
(define (nt2-split-last! i v lt! eq!)
  ;; i < succ v: run LT! with (< i v), or EQ! with (= i v) in context
  (fact 'nn-in-rr i) (fact 'nn-in-rr v)
  (ma-or-split! (dk-apply! (dk-cite! 'rr-lt-trichotomy i v))
    (list lt! eq!
          (lambda ()
            (dk-apply! (dk-cite! 'nn-lt-succ-le v i))
            (dk-have! '(< 0 0) (lambda () (dk-nn! (list '<= (list 'succ v) i) (list '< i (list 'succ v)))))
            (ap-absurd!)))))
(define (nt2-below-absurd! i) (dk-have! '(< 0 0) (lambda () (dk-nn! (list '< i 0)))) (ap-absurd!))
(define (nt2-divall n k m) (list 'FORALL 'cri_ (list 'IMPLIES '(IN cri_ NN) (list 'IMPLIES (list '< 'cri_ k) (list 'ZZ-DIVIDES (list n 'cri_) m)))))
(define (nt2-copall n k q) (list 'FORALL 'cri_ (list 'IMPLIES '(IN cri_ NN) (list 'IMPLIES (list '< 'cri_ k) (list 'ZZ-COPRIME (list n 'cri_) q)))))
(define (nt2-strong k)
  (list 'FORSOME 'crm_ (list 'AND '(IN crm_ ZZ)
    (list 'AND (nt2-divall 'n k 'crm_)
      (list 'AND (list 'FORALL 'crq_ (list 'IMPLIES '(IN crq_ ZZ) (list 'IMPLIES (nt2-copall 'n k 'crq_) '(ZZ-COPRIME crm_ crq_))))
                 (nt2-solv 'n k))))))
(define (nt2-bez-open! a b)
  ;; ZZ-COPRIME a b in context: land x a + y b = 1, return (x y)
  (car (ma-iff-parts! (dk-cite! 'zz-coprime-bezout a b)))
  (let* ((x (dk-skolem! (dk-ctx-form (nt2-bez a b))))
         (y (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'cry_) (dk-contains? f x))) (dk-asms)))))
    (list x y)))
(define nt2-inv-set (lambda (t) (list 'SEP 'crv_ 'ZZ (list 'FORSOME 'crw_ (list 'AND '(IN crw_ ZZ) (list '= (list '+ (list '* 'crv_ (list 'c t)) (list '* 'crw_ (list 'n t))) 1))))))
(define (ie-rfl0!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(define (nt3-rr! . xs) (for-each (lambda (x) (dk-type! x 'RR)) xs))
(define (nt3-dv! d x) ;; (ZZ-DIVIDES d x) in context: return the witness c, x = d c
  (dk-project! (list 'IN d 'ZZ) 'zz-divides (list 'ZZ-DIVIDES d x))
  (dk-project! (list 'IN x 'ZZ) 'zz-divides (list 'ZZ-DIVIDES d x))
  (dk-skolem! (dk-project! (list 'FORSOME 'c_ (list 'AND '(IN c_ ZZ) (list '= x (list '* d 'c_)))) 'zz-divides (list 'ZZ-DIVIDES d x))))
(define (nt3-eq-from-diff! a b)
  ;; (= (- a b) 0) in context, a, b typed: land (= a b)
  (dk-have! (list '= a b)
    (lambda ()
      (let ((id (list '= a (list '+ b (list '- a b)))))
        (dk-have! id (lambda () (crs)))
        (subst id)
        (subst (list '= (list '- a b) 0))
        (crs)))))
(define (nt3-sset k m) (list 'SEP 'zrr_ (list 'INTERVAL 1 m) (list 'ZZ-DIVIDES m (list '- k 'zrr_))))
(define (nt3-phiset k) (list 'SEP 'ephk_ (list 'INTERVAL 1 k) (list 'ZZ-COPRIME 'ephk_ k)))
(define (nt3-fin! s sup)
  (ma-sep-subset! s)
  (fact 'subclass-of-set-is-set s sup)
  (dk-have! (list 'AND (list 'IN sup 'SET) (list 'IN (list 'CARD sup) 'NN)))
  (let ((cs (dk-cite! 'card-subset-nn sup)))
    (dk-have! (list 'FORALL 'ntv_ (list 'IMPLIES (list 'IN 'ntv_ s) (list 'IN 'ntv_ sup)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s sup z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'ntv_ (list 'IMPLIES (list 'IN 'ntv_ s) (list 'IN 'ntv_ sup)))))
    (dk-apply! cs s)))
(define (nt2-div-intro-h! d x c)
  ;; land (ZZ-DIVIDES d x) from (= x (* d c)), d, x, c in ZZ
  (dk-have! (list 'ZZ-DIVIDES d x) (lambda () (nt2-div-intro! d x c))))
(define (nt3-lc! d x y s t target)
  ;; d | x, d | y, s, t in ZZ, s x + t y = target by crs: land d | target
  (dk-apply! (dk-cite! 'zz-divides-lincomb) d x y s t)
  (let ((lc (list '+ (list '* s x) (list '* t y))))
    (dk-have! (list '= lc target) (lambda () (crs)))
    (dk-rewrite-h! (list 'ZZ-DIVIDES d lc) lc target)))
(define (nt4-open! name args hyp)
  (let* ((iff (apply dk-cite! name args)) (rhs (caddr iff)))
    (if (not (dk-asm? rhs)) (dk-project! rhs name hyp))
    (if (and (dk-head-is? rhs 'AND) (not (and (dk-asm? (cadr rhs)) (dk-asm? (caddr rhs))))) (dk-split-all! (list rhs)))
    rhs))
(define (nt4-close! name args rhs!)
  (let ((iff (apply dk-cite! name args)))
    (dk-have! (caddr iff) rhs!)
    (dk-close-if! (lambda () (dk-only! iff (caddr iff))) prop)))
(define (nt4-zzr!)
  ;; the read-offs of ZZ-RING
  (dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl)))
  (dk-have! '(== (ZERO ZZ-RING) 0) (lambda () (slot 'ZERO) (qrfl)))
  (dk-have! '(== (ONE ZZ-RING) 1) (lambda () (slot 'ONE) (qrfl)))
  (fact 'zz-zero-in) (fact 'zz-one-in))
(define (nt4-abs-nn! x)
  ;; x in ZZ: land (IN (abs x) NN), (IN (abs x) ZZ)
  (dk-type! x 'RR)
  (dk-apply! (dk-cite! 'rr-abs-nonneg) x)
  (dk-have! (list 'IN (list 'abs x) 'ZZ)
    (lambda ()
      (ma-or-split! (dk-apply! (dk-cite! 'rr-abs-cases) x)
        (list (lambda () (dk-split-all!) (subst (list '= (list 'abs x) x)) (ass))
              (lambda () (dk-split-all!) (subst (list '= (list 'abs x) (list '- x))) (dk-type! (list '- x) 'ZZ) (ass))))))
  (dk-apply! (dk-cite! 'zz-nonneg-in-nn) (list 'abs x)))
(define (nt4-mul! a b) (dk-apply! (dk-cite! 'zz-ring-mul-is-mul) a b) (list '= (list (list 'MUL 'ZZ-RING) a b) (list '* a b)))
(define nt4-unit-body (lambda (x) (list 'AND (list 'IN x '(CARR ZZ-RING)) (list 'FORSOME 'guv_ (list 'AND '(IN guv_ (CARR ZZ-RING)) (list '= (list '(MUL ZZ-RING) x 'guv_) '(ONE ZZ-RING)))))))
(define (nt4-irr p) (list 'FORALL 'gpa_ (list 'IMPLIES '(IN gpa_ (CARR ZZ-RING)) (list 'FORALL 'gpb_ (list 'IMPLIES '(IN gpb_ (CARR ZZ-RING))
  (list 'IMPLIES (list '= p '((MUL ZZ-RING) gpa_ gpb_)) '(OR (IS-UNIT ZZ-RING gpa_) (IS-UNIT ZZ-RING gpb_))))))))
(define (nt4-int0!)
  ;; land (= (INTERVAL 1 0) EMPTY-SET)
  (fact 'nn-zero-in) (fact 'interval-in-set 1 0)
  (dk-apply! (dk-cite! 'interval-card) 0)
  (dk-apply! (dk-cite! 'card-zero-is-empty) '(INTERVAL 1 0)))
(define (nt4-in-carr! t) (dk-have! (list 'IN t '(CARR ZZ-RING)) (lambda () (subst '(== (CARR ZZ-RING) ZZ)) (ass))))
(define (nt4-ptw f n typ!)
  ;; land (FORALL z_ (IMPLIES (IN z_ (INTERVAL 1 n)) (IN (f z_) (CARR ZZ-RING)))) with TYP! landing (IN (f z) ZZ)
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ (list 'INTERVAL 1 n)) (list 'IN (list f 'z_) '(CARR ZZ-RING))))
    (lambda () (let ((z (dk-di-var!))) (typ! z) (subst '(== (CARR ZZ-RING) ZZ)) (ass)))))
(define (nt4-prod-type! f n)
  ;; the pointwise typing over INTERVAL(1, n) in context: land (IN (PROD-RING ZZ-RING f (INTERVAL 1 n)) ZZ)
  (fact 'interval-in-set 1 n) (dk-apply! (dk-cite! 'interval-card-in-nn 1 n))
  (dk-apply! (dk-cite! 'prod-ring-type-ptwise 'ZZ-RING) (list 'INTERVAL 1 n) f)
  (dk-rewrite-h! (list 'IN (list 'PROD-RING 'ZZ-RING f (list 'INTERVAL 1 n)) '(CARR ZZ-RING)) '(CARR ZZ-RING) 'ZZ))
(define (nt4-restrict! q v)
  ;; (FORALL ntq_ (IMPLIES (IN ntq_ (INTERVAL 1 (succ v))) (IN (q ntq_) ZZ))) in context: land the same over INTERVAL(1, v)
  (dk-have! (list 'FORALL 'ntq_ (list 'IMPLIES (list 'IN 'ntq_ (list 'INTERVAL 1 v)) (list 'IN (list q 'ntq_) 'ZZ)))
    (lambda ()
      (let ((i (dk-di-var!)))
        (fact 'interval-elt-in-nn 1 v i) (fact 'interval-lo 1 v i) (fact 'interval-hi 1 v i)
        (dk-have! (list '<= i (list 'succ v)) (lambda () (dk-nn! (list '<= i v))))
        (dk-apply! (dk-cite! 'interval-mem-intro 1 (list 'succ v) i))
        (dk-apply! (dk-ctx-form (list 'FORALL 'ntq_ (list 'IMPLIES (list 'IN 'ntq_ (list 'INTERVAL 1 (list 'succ v))) (list 'IN (list q 'ntq_) 'ZZ)))) i)
        (ass)))))
(define (nt4-top! v)
  ;; land (IN (succ v) (INTERVAL 1 (succ v)))
  (fact 'nn-succ-closed v)
  (dk-have! (list '<= 1 (list 'succ v)) (lambda () (dk-nn!)))
  (dk-have! (list '<= (list 'succ v) (list 'succ v)) (lambda () (dk-nn!)))
  (dk-apply! (dk-cite! 'interval-mem-intro 1 (list 'succ v) (list 'succ v))))
(define (nt4-absl q) (list 'VNB-LAMBDA 'nti_ 'NN (list 'abs (list q 'nti_))))
(define (nt4-ptq q n) (list 'FORALL 'ntq_ (list 'IMPLIES (list 'IN 'ntq_ (list 'INTERVAL 1 n)) (list 'IN (list q 'ntq_) 'ZZ))))
(define (nt4-dvd p a n) (list 'FORSOME 'nti_ (list 'AND (list 'IN 'nti_ (list 'INTERVAL 1 n)) (list 'ZZ-DIVIDES p (list a 'nti_)))))
(define (nt4-ufd!)
  (nt4-zzr!)
  (dk-cite! 'zz-is-commutative-ring)
  (dk-cite! 'zz-is-euclidean-domain)
  (dk-apply! (dk-cite! 'euclidean-domain-is-ufd) 'ZZ-RING)
  (nt4-open! 'is-ufd '(ZZ-RING) '(IS-UFD ZZ-RING)))
(define (nt4-pseq-typ! q n)
  ;; IS-PRIME-SEQ ZZ-RING q n in context: land the pointwise ZZ typing of q on INTERVAL(1, n)
  (nt4-open! 'is-prime-seq (list 'ZZ-RING q n) (list 'IS-PRIME-SEQ 'ZZ-RING q n))
  (dk-have! (nt4-ptq q n)
    (lambda ()
      (let ((i (dk-di-var!)))
        (dk-apply! (dk-ctx-form (list 'FORALL 'gqi_ (list 'IMPLIES (list 'IN 'gqi_ (list 'INTERVAL 1 n)) (list 'IS-PRIME-ELEMENT 'ZZ-RING (list q 'gqi_))))) i)
        (dk-project! (list 'IN (list q i) '(CARR ZZ-RING)) 'is-prime-element (list 'IS-PRIME-ELEMENT 'ZZ-RING (list q i)))
        (dk-rewrite-h! (list 'IN (list q i) '(CARR ZZ-RING)) '(CARR ZZ-RING) 'ZZ)
        (ass)))))
(define (nt5-mult d n) (list 'SEP 'ntk_ (list 'INTERVAL 1 n) (list 'ZZ-DIVIDES d 'ntk_)))
(define (nt5-noprime k n) (list 'FORALL 'ntq_ (list 'IMPLIES '(IS-PRIME-NAT ntq_) (list 'IMPLIES (list 'ZZ-DIVIDES 'ntq_ n) (list 'NOT (list 'ZZ-DIVIDES 'ntq_ k))))))
(define ie-r '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define ie-ag (list 'RING-ADDITIVE-AG ie-r))
(define (ie-int x a f) (list 'SEP 'iex_ x (list 'FORALL 'iek_ (list 'IMPLIES (list 'IN 'iek_ f) (list 'IN 'iex_ (list a 'iek_))))))
(define (ie-out x a i) (list 'SEP 'iex_ x (list 'FORALL 'iek_ (list 'IMPLIES (list 'IN 'iek_ i) (list 'NOT (list 'IN 'iex_ (list a 'iek_)))))))
(define (ie-body x a f) (list '* (list 'power '(- 1) (list 'CARD f)) (list 'CARD (ie-int x a f))))
(define (ie-lam x a d) (list 'VNB-LAMBDA 'ief_ d (ie-body x a 'ief_)))
(define (ie-sum x a i) (list 'FINSUM ie-ag (ie-lam x a (list 'POWER i)) (list 'POWER i)))
(define (ie-sub x a j) (list 'SEP 'iey_ x (list 'IN 'iey_ (list a j))))
(define (ie-rfl!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(define (ie-ring!)
  (fact 'cc-is-normed-field)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
  (dk-cite! 'commutative-ring-is-ring ie-r)
  (dk-cite! 'ring-additive-ag-is-abelian-group ie-r)
  (fact 'cc-scalar-ring-carr)
  (dk-have! (list '= (list 'CARR ie-ag) 'CC) (lambda () (subst (dk-cite! 'ras-carr ie-r)) (subst (list '= (list 'CARR ie-r) 'CC)) (fact 'cc-is-set) (rfl)))
  (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-zero-in)
  (dk-type! '(- 1) 'CC))
(define (ie-fin! s x) (ma-sep-subset! s) (ie-finite-sub! s x))
(define (ie-finite-sub! s ca)
  ;; ma-finite-sub! with dk-cite! (the citation may already be in context)
  (fact 'subclass-of-set-is-set s ca)
  (dk-have! (list 'AND (list 'IN ca 'SET) (list 'IN (list 'CARD ca) 'NN)))
  (let ((cs (dk-cite! 'card-subset-nn ca)))
    (dk-have! (list 'FORALL 'iev_ (list 'IMPLIES (list 'IN 'iev_ s) (list 'IN 'iev_ ca)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s ca z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'iev_ (list 'IMPLIES (list 'IN 'iev_ s) (list 'IN 'iev_ ca)))))
    (dk-apply! cs s)))
(define (ie-body-type! x a f)
  (ie-fin! (ie-int x a f) x)
  (cp-type!* (list 'power '(- 1) (list 'CARD f)))
  (cp-type!* (ie-body x a f)))
(define (cp-type!* t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-type! t 'CC)))
(define (ie-or-split! k a b thunk-a thunk-b)
  ;; (IN k (UNION a b)) in context: case split
  (ma-or-split! (car (ma-iff-parts! (dk-cite! 'union-membership a b k))) (list thunk-a thunk-b)))
(define (ie-op-eq! op x y)
  (let* ((thm (if (eq? op 'MUL) 'cc-scalar-ring-mul 'cc-scalar-ring-add))
         (cop (if (eq? op 'MUL) '* '+))
         (eq (list '= (list (list op ie-r) x y) (list cop x y))))
    (if (not (dk-asm? eq))
        (dk-have! eq
          (lambda ()
            (let* ((w1 (if (pair? x) (dk-name! x 'CC) x))
                   (w2 (cond ((equal? x y) w1) ((pair? y) (dk-name! y 'CC)) (#t y))))
              (if (and (pair? y) (not (equal? x y))) (subst (list '= y w2)))
              (if (pair? x) (subst (list '= x w1)))
              (subst (dk-cite! thm))
              (if (not (dk-lam-b!)) (rfl))))))
    eq))
(define (ie-power-parts! z base)
  (ma-iff-parts! (dk-cite! 'power-set-membership base z))
  (dk-have! (list 'AND (list 'IN base 'SET) (list 'IN (list 'CARD base) 'NN)))
  (let ((cs (dk-cite! 'card-subset-nn base)))
    (dk-have! (list 'AND (list 'IN z 'SET) (list 'FORALL 'iez_ (list 'IMPLIES (list 'IN 'iez_ z) (list 'IN 'iez_ base)))))
    (dk-apply! cs z)))
(define (ie-union x a i) (list 'SEP 'iex_ x (list 'FORSOME 'iek_ (list 'AND (list 'IN 'iek_ i) (list 'IN 'iex_ (list a 'iek_))))))
(define ie-e1 '(PAIR EMPTY-SET EMPTY-SET))
(define (ie-dom i) (list 'DIFFERENCE (list 'POWER i) ie-e1))
(define (ie-body1 x a f) (list '* (list 'power '(- 1) (list 'NN-MINUS (list 'CARD f) 1)) (list 'CARD (ie-int x a f))))
(define (nt6-dump! n)
  (for-each
    (lambda (l)
      (display ";; OPEN LEAF ") (display (sequent-node-number l)) (newline)
      (display ";;   GOAL ") (display (expression->string (dk-goal-of l))) (newline)
      (let* ((as (dk-asms-of l)) (k (length as)))
        (for-each (lambda (a) (display ";;   ctx ") (display (expression->string a)) (newline))
                  (list-tail as (max 0 (- k n))))))
    (dk-open-leaves)))
(define nt6-idl '(VNB-LAMBDA nzp_ ZZ nzp_))
(define (nt6-pf s) (list 'PROD-RING 'ZZ-RING nt6-idl s))
(define (nt6-allprime s) (list 'FORALL 'ntp_ (list 'IMPLIES (list 'IN 'ntp_ s) '(IS-PRIME-NAT ntp_))))
(define (nt6-alldiv s k) (list 'FORALL 'ntp_ (list 'IMPLIES (list 'IN 'ntp_ s) (list 'ZZ-DIVIDES 'ntp_ k))))
(define (nt6-primdiv s pf) (list 'FORALL 'ntq_ (list 'IMPLIES '(IN ntq_ NN) (list 'IMPLIES '(IS-PRIME-NAT ntq_) (list 'IMPLIES (list 'ZZ-DIVIDES 'ntq_ pf) (list 'IN 'ntq_ s))))))
(define (nt6-body-of s pf)
  (list 'AND (list 'IN pf 'NN)
    (list 'AND (list '<= 1 pf)
      (list 'AND (nt6-alldiv s pf)
        (list 'AND (nt6-primdiv s pf)
                   (list 'FORALL 'ntk_ (list 'IMPLIES '(IN ntk_ ZZ) (list 'IMPLIES (nt6-alldiv s 'ntk_) (list 'ZZ-DIVIDES pf 'ntk_)))))))))
(define (nt6-prop s) (list 'IMPLIES (nt6-allprime s) (nt6-body-of s (nt6-pf s))))
(define (nt6-close-body! s pf typ! one! div! prim! all!)
  ;; goal (nt6-body-of s pf): run the five provers on their conjuncts
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-ass!) #t)
              ((and (dk-head-is? g 'IN) (equal? (caddr g) 'NN)) (typ!))
              ((dk-head-is? g '<=) (one!))
              ((and (dk-head-is? g 'FORALL) (eq? (cadr g) 'ntp_)) (div!))
              ((and (dk-head-is? g 'FORALL) (eq? (cadr g) 'ntq_)) (prim!))
              (#t (all!)))))))
(define n7-a '(VNB-LAMBDA nza_ NN (- (recip nza_))))
(define n7-b '(VNB-LAMBDA nzo_ NN 1))
(define (n7-pa s) (list 'PROD-RING ie-r n7-a s))
(define (n7-pb s) (list 'PROD-RING ie-r n7-b s))
(define (n7-allnn s) (list 'FORALL 'nzz_ (list 'IMPLIES (list 'IN 'nzz_ s) '(IN nzz_ NN))))
(define (n7-rfl!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(define (n7-one!)
  (dk-have! (list '= (list 'ONE ie-r) 1) (lambda () (mac 'cc-scalar-ring-one) (n7-rfl!))))
(define (n7-val! lam x val)
  (dk-have! (list '= (list lam x) val) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl))))))
(define (n7-card-insert! s x)
  (let ((u (list 'UNION s (list 'PAIR x x))))
    (dk-apply! (dk-cite! 'card-insert-curried s) x)
    (dk-apply! (dk-cite! 'ord-succ-nn) (list 'CARD s))
    (fact 'nn-succ-closed (list 'CARD s))
    (dk-have! (list '= (list 'CARD u) (list 'succ (list 'CARD s)))
      (lambda () (subst (list '= (list 'CARD u) (list 'succ_ord (list 'CARD s)))) (subst (list '= (list 'succ_ord (list 'CARD s)) (list 'succ (list 'CARD s)))) (n7-rfl!)))
    (dk-have! (list 'IN (list 'CARD u) 'NN) (lambda () (subst (list '= (list 'CARD u) (list 'succ (list 'CARD s)))) (ass)))))
(define (n7-pf-insert! s x u)
  (let ((p0 (nt6-pf s)) (p1 (list '* (nt6-pf s) x)))
    (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ u) (list 'IN (list nt6-idl 'z_) '(CARR ZZ-RING))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (dk-apply! (dk-ctx-form (nt6-allprime u)) z)
          (dk-split-all! (list (dk-apply! (dk-cite! 'prime-nat-gt-one) z)))
          (dk-type! z 'ZZ)
          (subst '(== (CARR ZZ-RING) ZZ))
          (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (ass))))))
    (dk-type! x 'ZZ) (dk-type! p0 'ZZ)
    (dk-apply! (dk-cite! 'prod-ring-insert-ptwise 'ZZ-RING) s x nt6-idl)
    (n7-val! nt6-idl x x)
    (nt4-mul! p0 x)
    (dk-have! (list '= (nt6-pf u) p1)
      (lambda ()
        (subst (list '= (nt6-pf u) (list '(MUL ZZ-RING) p0 (list nt6-idl x))))
        (subst (list '= (list nt6-idl x) x))
        (subst (list '= (list '(MUL ZZ-RING) p0 x) p1))
        (n7-rfl!)))))
(define (n7-bprop s) (list 'IMPLIES (nt6-allprime s) (list '= (n7-pa s) (list '* (list 'power '(- 1) (list 'CARD s)) (list 'recip (nt6-pf s))))))
(define n7-fam '(VNB-LAMBDA nzf_ NN (SEP nzm_ ZZ (ZZ-DIVIDES nzf_ nzm_))))
(define (n7-famv k) (list 'SEP 'nzm_ 'ZZ (list 'ZZ-DIVIDES k 'nzm_)))
(define (n7-ps n) (list 'SEP 'nzd_ (list 'INTERVAL 1 n) (list 'AND '(IS-PRIME-NAT nzd_) (list 'ZZ-DIVIDES 'nzd_ n))))
(define (n7-fam-open! w k)
  (n7-val! n7-fam k (n7-famv k))
  (dk-rewrite-h! (list 'IN w (list n7-fam k)) (list n7-fam k) (n7-famv k))
  (ma-sep-parts! (list 'IN w (n7-famv k))))
(define (n7-fam-intro! w k)
  (n7-val! n7-fam k (n7-famv k))
  (dk-have! (list 'IN w (list n7-fam k))
    (lambda () (subst (list '= (list n7-fam k) (n7-famv k))) (in-sep! dk-ass! (lambda () (ass))))))
(define (n7-prime-nn! p) (dk-split-all! (list (dk-apply! (dk-cite! 'prime-nat-gt-one) p))))
(define (n7-in-interval! w n)
  (ma-iff-parts! (dk-cite! 'interval-membership 1 n w))
  (dk-type! w 'ZZ))
(define (n7-lam-b-top!)
  ;; beta to a fixpoint where a redex under a SEP binder must stay standing (dk-lam-b! errors on it)
  (let loop ((k 0))
    (let ((g0 (dk-goal)))
      (lam-b)
      (if (and (< k 4) (not (sequent-node-grounded? (proof-state-focus *ps*))) (not (equal? g0 (dk-goal)))) (loop (+ k 1))))))
(define (n7-q ps) (list 'VNB-LAMBDA 'nzq_ ps '(- 1 (recip nzq_))))
(define (n7-ne0! z lo)
  ;; z typed in RR, (LO z) in context with lo the strict/weak bound 1: land (NOT (= z 0))
  (dk-have! (list 'NOT (list '= z 0)) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= z 0) (list lo 1 z)))) (ap-absurd!))))
(define (n7-a-ptw! s)
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ s) (list 'IN (list n7-a 'z_) (list 'CARR ie-r))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (dk-apply! (dk-ctx-form (nt6-allprime s)) z)
        (n7-prime-nn! z)
        (dk-type! z 'CC) (fact 'nn-in-rr z)
        (n7-ne0! z '<)
        (dk-have! (list 'AND (list 'IN z 'CC) (list 'NOT (list '= z 0))))
        (fact 'cc-recip-closed z)
        (dk-type! (list '- (list 'recip z)) 'CC)
        (subst (list '== (list 'CARR ie-r) 'CC))
        (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (ass)))))))
(define (n7-sub-facts! s ps n)
  (ie-power-parts! s ps)
  (dk-have! (nt6-allprime s)
    (lambda () (let ((p (dk-di-var!))) (dk-apply! (dk-ctx-form (list 'FORALL 'iez_ (list 'IMPLIES (list 'IN 'iez_ s) (list 'IN 'iez_ ps)))) p)
                 (dk-apply! (dk-ctx-form (nt6-allprime ps)) p) (ass))))
  (dk-have! (nt6-alldiv s n)
    (lambda () (let ((p (dk-di-var!))) (dk-apply! (dk-ctx-form (list 'FORALL 'iez_ (list 'IMPLIES (list 'IN 'iez_ s) (list 'IN 'iez_ ps)))) p)
                 (dk-apply! (dk-ctx-form (nt6-alldiv ps n)) p) (ass))))
  (n7-a-ptw! s)
  (dk-apply! (dk-cite! 'prod-ring-type-ptwise ie-r) s n7-a)
  (dk-have! (list 'IN (n7-pa s) 'CC) (lambda () (subst (list '== 'CC (list 'CARR ie-r))) (ass))))

;;; ==================================================================== from nt8.scm
;;; (48) ALGEBRAIC-NUMBERS ch. 1, bundle B3: Lemma 1.24 (a multiplicative f with |f(p^k)| <= 1 for all prime
;;; powers p^k > N is bounded).  The notes' bound max_{l <= N} |f(l)|^N is replaced by M^(t(n) + 1), where M >= 1
;;; bounds |f| on {1, ..., N + 1} and t(n) is the number of primes p <= N dividing n; t(n) <= N.  The proof is a
;;; strong induction on n: n = q^a m with q a prime factor of n and q not dividing m (a q-decomposition).
;;; The notes write f(p^k) <= 1; the proof uses |f(p^k)| <= 1, and the claim is false without the absolute value
;;; (f(p^k) = -2 for all prime powers), so the hypothesis is stated with |.|.  Helper prefix n8-.
(define (n8-rfl!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))
(define (n8-cc! x) (if (not (dk-asm? (list 'IN x 'CC))) (fact 'rr-subset-cc x)))
(define (n8-di-pred!)
  ;; goal (FORALL v (IMPLIES (PRED v) ...)): peel v, land (PRED v), return v
  (di)
  (let ((v (cadr (cadr (dk-goal))))) (di) v))
(define (n8-psucc! x k)
  ;; x in CC, k in NN: land (= (power x (succ k)) (* x (power x k)))
  (dk-have! (list 'AND (list 'IN x 'CC) (list 'IN k 'NN)))
  (fact 'power-succ x k)
  (list '= (list 'power x (list 'succ k)) (list '* x (list 'power x k))))

;;; powers of naturals are naturals
(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (FORALL x (IMPLIES (IN x NN) (IN (power x k) NN)))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (let ((x (dk-di-var!)))
    (dk-type! x 'CC) (fact 'power-zero x) (fact 'nn-one-in)
    (subst (list '= (list 'power x 0) 1)) (ass))
  (dk-focus! (cdr (assq 'step ind)))
  (let ((x (dk-di-var!)))
    (dk-apply! (dk-ctx-form (list 'FORALL 'x (list 'IMPLIES '(IN x NN) (list 'IN (list 'power 'x v) 'NN)))) x)
    (dk-type! x 'CC)
    (subst (n8-psucc! x v))
    (dk-have! (list 'AND (list 'IN x 'NN) (list 'IN (list 'power x v) 'NN)))
    (fact 'nn-mul-closed x (list 'power x v))
    (ass)))
(qed 'nn-power-closed)

;;; 1 <= x gives 1 <= x^k
(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (FORALL x (IMPLIES (IN x RR) (IMPLIES (<= 1 x) (<= 1 (power x k)))))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (let ((x (dk-di-var!)))
    (di)
    (n8-cc! x) (fact 'power-zero x)
    (subst (list '= (list 'power x 0) 1)) (dk-ineq!))
  (dk-focus! (cdr (assq 'step ind)))
  (let* ((x (dk-di-var!)) (p (list 'power x v)))
    (di)
    (dk-apply! (dk-ctx-form (list 'FORALL 'x (list 'IMPLIES '(IN x RR) (list 'IMPLIES '(<= 1 x) (list '<= 1 (list 'power 'x v)))))) x)
    (n8-cc! x)
    (subst (n8-psucc! x v))
    (fact 'power-real-closed x v)
    (dk-have! (list '<= 0 x) (lambda () (dk-ineq! (list '<= 1 x))))
    (dk-apply! (dk-cite! 'rr-mul-le-right 1 p x))
    (dk-have! (list '= (list '* x p) (list '* p x)) (lambda () (crs)))
    (subst (list '= (list '* x p) (list '* p x)))
    (dk-type! (list '* p x) 'RR) (dk-type! (list '* 1 x) 'RR)
    (dk-ineq! (list '<= (list '* 1 x) (list '* p x)) (list '<= 1 x) (list 'IN (list '* p x) 'RR) (list 'IN (list '* 1 x) 'RR))))
(qed 'rr-power-ge-one)

;;; for x >= 1 the powers increase: x^k <= x^(k + d)
(sp (make-wff '(FORALL d (IMPLIES (IN d NN) (FORALL k (IMPLIES (IN k NN) (FORALL x (IMPLIES (IN x RR) (IMPLIES (<= 1 x) (<= (power x k) (power x (+ k d))))))))))))
(dk-peel!)
(n8-cc! 'x)
(fact 'power-real-closed 'x 'k) (fact 'power-real-closed 'x 'd)
(dk-apply! (dk-cite! 'rr-power-ge-one 'd) 'x)
(dk-apply! (dk-cite! 'rr-power-ge-one 'k) 'x)
(dk-apply! (dk-cite! 'cc-power-add 'd) 'k 'x)
(subst '(= (power x (+ k d)) (* (power x k) (power x d))))
(dk-have! '(<= 0 (power x k)) (lambda () (dk-ineq! '(<= 1 (power x k)))))
(dk-apply! (dk-cite! 'rr-mul-le-right 1 '(power x d) '(power x k)))
(dk-have! '(= (* (power x d) (power x k)) (* (power x k) (power x d))) (lambda () (crs)))
(dk-type! '(* (power x k) (power x d)) 'RR) (dk-type! '(* 1 (power x k)) 'RR) (dk-type! '(* (power x d) (power x k)) 'RR)
(dk-ineq! '(<= (* 1 (power x k)) (* (power x d) (power x k))) '(= (* (power x d) (power x k)) (* (power x k) (power x d)))
          '(IN (* (power x k) (power x d)) RR) '(IN (* 1 (power x k)) RR) '(IN (* (power x d) (power x k)) RR))
(qed 'rr-power-mono-exp)

;;; a prime dividing a power of a prime q is q
(sp (make-wff '(FORALL a (IMPLIES (IN a NN) (FORALL q (IMPLIES (IS-PRIME-NAT q) (FORALL r (IMPLIES (IS-PRIME-NAT r) (IMPLIES (ZZ-DIVIDES r (power q a)) (= r q))))))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (let* ((q (n8-di-pred!)) (r (n8-di-pred!)))
    (di)
    (n7-prime-nn! q) (n7-prime-nn! r)
    (dk-type! q 'CC) (fact 'power-zero q)
    (let ((h (dk-rewrite-h! (list 'ZZ-DIVIDES r (list 'power q 0)) (list 'power q 0) 1)))
      (dk-type! r 'ZZ) (fact 'zz-one-in) (fact 'nn-in-rr r)
      (dk-have! (list '< 0 r) (lambda () (dk-ineq! (list '< 1 r))))
      (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
      (dk-apply! (dk-cite! 'zz-divides-small) r 1)
      (ma-prop-with! (list h (list 'NOT h)))))
  (dk-focus! (cdr (assq 'step ind)))
  (let* ((q (n8-di-pred!)) (r (n8-di-pred!)) (p (list 'power q v)))
    (di)
    (n7-prime-nn! q) (n7-prime-nn! r)
    (dk-cite! 'nn-power-closed v q)
    (dk-type! q 'ZZ) (fact 'nn-subset-zz p) (dk-type! q 'CC)
    (n8-psucc! q v)
    (let ((h (dk-rewrite-h! (list 'ZZ-DIVIDES r (list 'power q (list 'succ v))) (list 'power q (list 'succ v)) (list '* q p))))
      (ma-or-split! (dk-apply! (dk-cite! 'prime-nat-euclid) r q p)
        (list (lambda () (dk-apply! (dk-cite! 'prime-nat-divides-prime) r q) (ass))
              (lambda ()
                (dk-apply! (dk-ctx-form (list 'FORALL 'q (list 'IMPLIES '(IS-PRIME-NAT q) (list 'FORALL 'r (list 'IMPLIES '(IS-PRIME-NAT r) (list 'IMPLIES (list 'ZZ-DIVIDES 'r (list 'power 'q v)) '(= r q))))))) q r)
                (ass)))))))
(qed 'prime-divides-prime-power)

;;; the q-decomposition: n >= 1 is q^a m with q not dividing m (induction on a bound K for n)
(define (n8-dec n q) (list 'FORSOME 'qda_ (list 'AND '(IN qda_ NN) (list 'FORSOME 'qdm_ (list 'AND '(IN qdm_ NN) (list 'AND '(<= 1 qdm_)
                       (list 'AND (list '= n (list '* (list 'power q 'qda_) 'qdm_)) (list 'NOT (list 'ZZ-DIVIDES q 'qdm_)))))))))
(define (n8-close-dec! a m)
  ;; the goal (n8-dec n q), every conjunct at a, m in context
  (ew a)
  (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew m) (dk-conj-close! (lambda () (ass))))))))
(define (n8-absurd! . prems)
  ;; FALSITY or any goal from linear premises that contradict
  (dk-have! '(< 0 0) (lambda () (apply dk-ineq! prems)))
  (ap-absurd!))
(sp (make-wff (list 'FORALL 'K (list 'IMPLIES '(IN K NN) (list 'FORALL 'q (list 'IMPLIES '(IS-PRIME-NAT q)
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(<= 1 n) (list 'IMPLIES '(<= n K) (n8-dec 'n 'q)))))))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (let* ((q (n8-di-pred!)) (n (dk-di-var!)))
    (di) (di)
    (fact 'nn-in-rr n)
    (n8-absurd! (list '<= 1 n) (list '<= n 0)))
  (dk-focus! (cdr (assq 'step ind)))
  (let* ((q (n8-di-pred!)) (n (dk-di-var!)))
    (di) (di)
    (n7-prime-nn! q)
    (fact 'nn-zero-in) (fact 'zz-zero-in) (fact 'zz-one-in) (fact 'rr-zero-in)
    (dk-type! n 'ZZ) (dk-type! q 'ZZ) (dk-type! q 'CC)
    (fact 'nn-in-rr n) (fact 'nn-in-rr q)
    (use-em (list 'ZZ-DIVIDES q n)
      (lambda ()
        (let ((c (nt3-dv! q n)))
          (fact 'zz-in-rr c)
          (dk-type! (list '* q c) 'RR)
          (dk-have! (list '<= 1 c)
            (lambda ()
              (dk-have! (list 'AND (list 'IN c 'RR) '(IN 0 RR)))
              (fact 'rr-leq-total c 0)
              (ma-or-split! (list 'OR (list '<= c 0) (list '<= 0 c))
                (list (lambda ()
                        (dk-have! (list '<= 0 q) (lambda () (dk-ineq! (list '< 1 q))))
                        (dk-apply! (dk-cite! 'rr-mul-le-right c 0 q))
                        (dk-type! (list '* c q) 'RR) (dk-type! (list '* 0 q) 'RR)
                        (dk-have! (list '= (list '* c q) n) (lambda () (subst (list '= n (list '* q c))) (crs)))
                        (dk-have! (list '= (list '* 0 q) 0) (lambda () (crs)))
                        (n8-absurd! (list '<= (list '* c q) (list '* 0 q)) (list '= (list '* c q) n) (list '= (list '* 0 q) 0) (list '<= 1 n)
                                    (list 'IN (list '* c q) 'RR) (list 'IN (list '* 0 q) 'RR)))
                      (lambda ()
                        (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases 0 c))
                          (list (lambda () (dk-apply! (dk-cite! 'zz-discrete) c) (ass))
                                (lambda ()
                                  (dk-have! (list '= n 0) (lambda () (subst (list '= n (list '* q c))) (subst (list '= c 0)) (crs)))
                                  (n8-absurd! (list '= n 0) (list '<= 1 n))))))))))
          (dk-have! (list '<= 0 c) (lambda () (dk-ineq! (list '<= 1 c))))
          (dk-apply! (dk-cite! 'zz-nonneg-in-nn) c)
          (dk-have! (list '<= 2 q)
            (lambda ()
              (dk-type! (list '- q 1) 'ZZ) (dk-type! (list '- q 1) 'RR)
              (dk-have! (list '< 0 (list '- q 1)) (lambda () (dk-ineq! (list '< 1 q))))
              (dk-apply! (dk-cite! 'zz-discrete) (list '- q 1))
              (dk-ineq! (list '<= 1 (list '- q 1)))))
          (dk-apply! (dk-cite! 'rr-mul-le-right 2 q c))
          (dk-type! (list '* 2 c) 'RR)
          (dk-have! (list '< c n) (lambda () (dk-ineq! (list '<= (list '* 2 c) (list '* q c)) (list '= n (list '* q c)) (list '<= 1 c)
                                                       (list 'IN (list '* q c) 'RR) (list 'IN (list '* 2 c) 'RR))))
          (dk-type! (list '- n c) 'ZZ) (dk-type! (list '- n c) 'RR)
          (dk-have! (list '< 0 (list '- n c)) (lambda () (dk-ineq! (list '< c n))))
          (dk-apply! (dk-cite! 'zz-discrete) (list '- n c))
          (dk-have! (list '<= c v) (lambda () (dk-nn! (list '<= 1 (list '- n c)) (list '<= n (list 'succ v)))))
          (let* ((ex (dk-apply! (dk-ctx-form (list 'FORALL 'q (list 'IMPLIES '(IS-PRIME-NAT q) (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(<= 1 n) (list 'IMPLIES (list '<= 'n v) (n8-dec 'n 'q)))))))) q c))
                 (a1 (dk-skolem! ex #t))
                 (m (dk-skolem! (dk-ctx-form (list 'FORSOME 'qdm_ (list 'AND '(IN qdm_ NN) (list 'AND '(<= 1 qdm_) (list 'AND (list '= c (list '* (list 'power q a1) 'qdm_)) (list 'NOT (list 'ZZ-DIVIDES q 'qdm_))))))) #t))
                 (pa (list 'power q a1)))
            (fact 'nn-succ-closed a1)
            (dk-cite! 'nn-power-closed a1 q) (fact 'nn-in-rr pa) (fact 'rr-subset-cc pa)
            (n8-psucc! q a1)
            (dk-have! (list '= n (list '* (list 'power q (list 'succ a1)) m))
              (lambda ()
                (subst (list '= (list 'power q (list 'succ a1)) (list '* q pa)))
                (subst (list '= n (list '* q c)))
                (subst (list '= c (list '* pa m)))
                (let ((w (dk-name! pa 'CC))) (subst (list '= pa w)) (crs))))
            (n8-close-dec! (list 'succ a1) m))))
      (lambda ()
        (n8-cc! n) (fact 'power-zero q)
        (dk-have! (list '= n (list '* (list 'power q 0) n)) (lambda () (subst (list '= (list 'power q 0) 1)) (crs)))
        (n8-close-dec! 0 n)))))
(qed 'prime-decomposition-bounded)

(sp (make-wff (list 'FORALL 'q (list 'IMPLIES '(IS-PRIME-NAT q) (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(<= 1 n) (n8-dec 'n 'q))))))))
(let* ((q (n8-di-pred!)) (n (dk-di-var!)))
  (di)
  (dk-have! (list '<= n n) (lambda () (fact 'nn-in-rr n) (dk-ineq!)))
  (dk-apply! (dk-cite! 'prime-decomposition-bounded n) q n)
  (ass))
(qed 'prime-decomposition)

;;; q prime not dividing m: m and q^a are relatively prime
(sp (make-wff '(FORALL a (IMPLIES (IN a NN) (FORALL q (IMPLIES (IS-PRIME-NAT q) (FORALL m (IMPLIES (IN m ZZ) (IMPLIES (NOT (ZZ-DIVIDES q m)) (ZZ-COPRIME m (power q a)))))))))))
(dk-peel!)
(let* ((q (if (dk-asm? '(IS-PRIME-NAT q)) 'q (error "n8: q"))) (pa '(power q a)))
  (n7-prime-nn! 'q)
  (dk-cite! 'nn-power-closed 'a 'q) (fact 'nn-subset-zz pa) (fact 'nn-in-rr pa) (fact 'nn-in-rr 'q)
  (dk-type! 'q 'CC)
  (dk-have! '(<= 1 q) (lambda () (dk-ineq! '(< 1 q))))
  (dk-apply! (dk-cite! 'rr-power-ge-one 'a) 'q)
  (dk-have! (list 'NOT (list '= pa 0)) (lambda () (di) (n8-absurd! (list '= pa 0) (list '<= 1 pa))))
  (let ((iff (dk-cite! 'zz-coprime-iff-no-common-prime 'm pa)))
    (dk-have! (caddr iff)
      (lambda ()
        (di)
        (let ((r (cadr (cadr (dk-goal)))))
          (di) (di) (di)
          (dk-apply! (dk-cite! 'prime-divides-prime-power 'a) 'q r)
          (dk-rewrite-h! (list 'ZZ-DIVIDES r 'm) r 'q)
          (ma-prop-with! (list '(ZZ-DIVIDES q m) '(NOT (ZZ-DIVIDES q m)))))))
    (ma-iff-back! iff)))
(qed 'coprime-prime-power)

;;; |f| is bounded on {1, ..., K} by some M >= 1
(define (n8-bdd f k m) (list 'FORALL 'bdl_ (list 'IMPLIES '(IN bdl_ NN) (list 'IMPLIES '(<= 1 bdl_) (list 'IMPLIES (list '<= 'bdl_ k) (list '<= (list 'abs (list f 'bdl_)) m))))))
(sp (make-wff (list 'FORALL 'K (list 'IMPLIES '(IN K NN) (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN NN RR))
  (list 'FORSOME 'bdm_ (list 'AND '(IN bdm_ RR) (list 'AND '(<= 1 bdm_) (n8-bdd 'f 'K 'bdm_))))))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (fact 'rr-one-in)
  (ew 1)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-ass!) #t)
            ((dk-head-is? (dk-goal) '<=) (dk-ineq!))
            (#t (let ((l (dk-di-var!))) (di) (di) (fact 'nn-in-rr l) (n8-absurd! (list '<= 1 l) (list '<= l 0)))))))
  (dk-focus! (cdr (assq 'step ind)))
  (let* ((f (dk-di-var!)))
    (let* ((ex (dk-apply! (dk-ctx-form (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN NN RR)) (list 'FORSOME 'bdm_ (list 'AND '(IN bdm_ RR) (list 'AND '(<= 1 bdm_) (n8-bdd 'f v 'bdm_))))))) f))
           (m (dk-skolem! ex #t))
           (sv (list 'succ v)) (fv (list 'abs (list f sv))) (m1 (list '+ m fv)))
      (fact 'nn-succ-closed v)
      (fact 'fun-apply-type-c f 'NN 'RR sv)
      (fact 'rr-abs-closed (list f sv)) (fact 'rr-abs-nonneg (list f sv))
      (dk-type! m1 'RR)
      (ew m1)
      (dk-conj-close!
        (lambda ()
          (cond ((dk-ass!) #t)
                ((dk-head-is? (dk-goal) '<=) (dk-ineq! (list '<= 1 m) (list '<= 0 fv) (list 'IN fv 'RR)))
                (#t (let ((l (dk-di-var!)))
                      (di) (di)
                      (fact 'nn-in-rr l)
                      (ma-or-split! (dk-apply! (dk-cite! 'nn-le-succ-cases v) l)
                        (list (lambda ()
                                (dk-apply! (dk-ctx-form (n8-bdd f v m)) l)
                                (fact 'fun-apply-type-c f 'NN 'RR l)
                                (fact 'rr-abs-closed (list f l))
                                (dk-ineq! (list '<= (list 'abs (list f l)) m) (list '<= 0 fv) (list 'IN fv 'RR) (list 'IN (list 'abs (list f l)) 'RR)))
                              (lambda ()
                                (subst (list '= l sv))
                                (dk-ineq! (list '<= 1 m) (list 'IN fv 'RR)))))))))))))
(qed 'fun-abs-bounded-initial)

;;; x >= 1, a >= 1: x <= x^a
(sp (make-wff '(FORALL a (IMPLIES (IN a NN) (FORALL x (IMPLIES (IN x RR) (IMPLIES (<= 1 x) (IMPLIES (<= 1 a) (<= x (power x a))))))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (let ((x (dk-di-var!))) (di) (di) (n8-absurd! '(<= 1 0)))
  (dk-focus! (cdr (assq 'step ind)))
  (let* ((x (dk-di-var!)) (p (list 'power x v)))
    (di) (di)
    (n8-cc! x)
    (subst (n8-psucc! x v))
    (fact 'power-real-closed x v)
    (dk-apply! (dk-cite! 'rr-power-ge-one v) x)
    (dk-have! (list '<= 0 x) (lambda () (dk-ineq! (list '<= 1 x))))
    (dk-apply! (dk-cite! 'rr-mul-le-right 1 p x))
    (dk-have! (list '= (list '* x p) (list '* p x)) (lambda () (crs)))
    (subst (list '= (list '* x p) (list '* p x)))
    (dk-type! (list '* p x) 'RR) (dk-type! (list '* 1 x) 'RR)
    (dk-ineq! (list '<= (list '* 1 x) (list '* p x)) (list 'IN (list '* p x) 'RR) (list 'IN (list '* 1 x) 'RR))))
(qed 'rr-power-ge-base)

;;; x >= 1, k <= j: x^k <= x^j
(sp (make-wff '(FORALL j (IMPLIES (IN j NN) (FORALL k (IMPLIES (IN k NN) (FORALL x (IMPLIES (IN x RR) (IMPLIES (<= 1 x) (IMPLIES (<= k j) (<= (power x k) (power x j))))))))))))
(dk-peel!)
(dk-type! 'j 'ZZ) (dk-type! 'k 'ZZ)
(fact 'nn-in-rr 'j) (fact 'nn-in-rr 'k)
(dk-type! '(- j k) 'ZZ) (dk-type! '(- j k) 'RR)
(dk-have! '(<= 0 (- j k)) (lambda () (dk-ineq! '(<= k j))))
(dk-apply! (dk-cite! 'zz-nonneg-in-nn) '(- j k))
(dk-apply! (dk-cite! 'rr-power-mono-exp '(- j k)) 'k 'x)
(dk-have! '(= (+ k (- j k)) j) (lambda () (crs)))
(dk-rewrite-h! '(<= (power x k) (power x (+ k (- j k)))) '(+ k (- j k)) 'j)
(ass)
(qed 'rr-power-mono-le)

;;; the step of Lemma 1.24: |f(n)| <= M^(t(n) + 1) for n <= K, by induction on K
(define (n8-tset nn n) (list 'SEP 'mbt_ (list 'INTERVAL 1 nn) (list 'AND '(IS-PRIME-NAT mbt_) (list 'ZZ-DIVIDES 'mbt_ n))))
(define (n8-t nn n) (list 'CARD (n8-tset nn n)))
(define (n8-hyp f nn) (list 'FORALL 'mbp_ (list 'IMPLIES '(IS-PRIME-NAT mbp_) (list 'FORALL 'mbk_ (list 'IMPLIES '(IN mbk_ NN)
                       (list 'IMPLIES (list '< nn '(power mbp_ mbk_)) (list '<= (list 'abs (list f '(power mbp_ mbk_))) 1)))))))
(define (n8-claim f nn m k)
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(<= 1 n) (list 'IMPLIES (list '<= 'n k)
    (list '<= (list 'abs (list f 'n)) (list 'power m (list 'succ (n8-t nn 'n)))))))))
(define (n8-step-stmt k)
  (list 'FORALL 'f (list 'IMPLIES '(IS-MULTIPLICATIVE f) (list 'FORALL 'nb (list 'IMPLIES '(IN nb NN) (list 'IMPLIES (n8-hyp 'f 'nb)
    (list 'FORALL 'mb (list 'IMPLIES '(IN mb RR) (list 'IMPLIES '(<= 1 mb) (list 'IMPLIES (n8-bdd 'f '(succ nb) 'mb) (n8-claim 'f 'nb 'mb k)))))))))))
;;; t(x) is a natural (a subset of {1..N}), at most N
(define (n8-t-facts! nn x)
  (let ((s (n8-tset nn x)) (iv (list 'INTERVAL 1 nn)))
    (fact 'interval-in-set 1 nn) (dk-apply! (dk-cite! 'interval-card-in-nn 1 nn))
    (nt3-fin! s iv)
    (dk-have! (list 'SUBSET s iv) (lambda () (ma-sep-subset! s) (ass)))
    (dk-apply! (dk-cite! 'card-subset-mono iv) s)
    (dk-apply! (dk-cite! 'interval-card) nn)
    (fact 'nn-in-rr (list 'CARD s))))
;;; f(x) real, |f(x)| real and >= 0
(define (n8-fx! f x)
  (fact 'fun-apply-type-c f 'NN 'RR x)
  (fact 'rr-abs-closed (list f x)) (fact 'rr-abs-nonneg (list f x)))
;;; M^(succ t) typed, >= 1
(define (n8-pw! m t)
  (fact 'nn-succ-closed t)
  (fact 'power-real-closed m (list 'succ t))
  (dk-apply! (dk-cite! 'rr-power-ge-one (list 'succ t)) m))

(sp (make-wff (list 'FORALL 'K (list 'IMPLIES '(IN K NN) (n8-step-stmt 'K)))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (let ((n (cadr (cadr (cadr (dk-goal)))))) (fact 'nn-in-rr n) (n8-absurd! (list '<= 1 n) (list '<= n 0)))
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (nt4-open! 'is-multiplicative '(f) '(IS-MULTIPLICATIVE f))
  (let* ((n (cadr (cadr (cadr (dk-goal))))) (tn (n8-t 'nb n)) (pn (list 'power 'mb (list 'succ tn))))
    (fact 'nn-zero-in) (fact 'zz-zero-in) (fact 'zz-one-in) (fact 'rr-zero-in) (fact 'nn-one-in)
    (dk-type! n 'ZZ) (fact 'nn-in-rr n) (fact 'nn-succ-closed 'nb) (fact 'nn-in-rr 'nb)
    (n8-t-facts! 'nb n)
    (n8-pw! 'mb tn)
    (n8-fx! 'f n)
    (dk-have! '(<= 0 mb) (lambda () (dk-ineq! '(<= 1 mb))))
    (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases 1 n))
      (list
        ;; n > 1: n = q^a m
        (lambda ()
          (dk-have! (list 'NOT (list '= n 0)) (lambda () (di) (n8-absurd! (list '= n 0) (list '< 1 n))))
          (dk-have! (list 'NOT (list '= n 1)) (lambda () (di) (n8-absurd! (list '= n 1) (list '< 1 n))))
          (dk-have! (list 'NOT (list '= n '(- 1))) (lambda () (di) (n8-absurd! (list '= n '(- 1)) (list '< 1 n))))
          (let* ((q (dk-skolem! (dk-apply! (dk-cite! 'zz-prime-factor-exists) n) #t))
                 (_1 (n7-prime-nn! q))
                 (ex (dk-apply! (dk-cite! 'prime-decomposition) q n))
                 (a (dk-skolem! ex #t))
                 (m (dk-skolem! (dk-ctx-form (list 'FORSOME 'qdm_ (list 'AND '(IN qdm_ NN) (list 'AND '(<= 1 qdm_) (list 'AND (list '= n (list '* (list 'power q a) 'qdm_)) (list 'NOT (list 'ZZ-DIVIDES q 'qdm_))))))) #t))
                 (pa (list 'power q a)) (tm (n8-t 'nb m)) (pm (list 'power 'mb (list 'succ tm)))
                 (fm (list 'abs (list 'f m))) (fp (list 'abs (list 'f pa))))
            (dk-type! q 'ZZ) (dk-type! m 'ZZ) (fact 'nn-in-rr q) (fact 'nn-in-rr m)
            (dk-cite! 'nn-power-closed a q) (fact 'nn-subset-zz pa) (fact 'nn-in-rr pa) (fact 'rr-subset-cc pa)
            (dk-have! (list '<= 1 q) (lambda () (dk-ineq! (list '< 1 q))))
            (dk-apply! (dk-cite! 'rr-power-ge-one a) q)
            (dk-have! (list '= n (list '* m pa)) (lambda () (subst (list '= n (list '* pa m))) (crs)))
            ;; q^a /= 1, so a >= 1 and q^a >= q
            (dk-have! (list 'NOT (list '= pa 1))
              (lambda ()
                (di)
                (dk-have! (list '= n m) (lambda () (subst (list '= n (list '* pa m))) (subst (list '= pa 1)) (crs)))
                (dk-rewrite-h! (list 'ZZ-DIVIDES q n) n m)
                (ma-prop-with! (list (list 'ZZ-DIVIDES q m) (list 'NOT (list 'ZZ-DIVIDES q m))))))
            (dk-type! a 'ZZ) (fact 'nn-in-rr a)
            (dk-have! (list '<= 0 a) (lambda () (dk-nn!)))
            (dk-have! (list '<= 1 a)
              (lambda ()
                (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases 0 a))
                  (list (lambda () (dk-apply! (dk-cite! 'zz-discrete) a) (ass))
                        (lambda ()
                          (dk-type! q 'CC) (fact 'power-zero q)
                          (dk-have! (list '= pa 1) (lambda () (subst (list '= a 0)) (subst (list '= (list 'power q 0) 1)) (n8-rfl!)))
                          (ma-prop-with! (list (list '= pa 1) (list 'NOT (list '= pa 1)))))))))
            (dk-apply! (dk-cite! 'rr-power-ge-base a) q)
            (dk-have! (list '<= 0 a) (lambda () (dk-ineq! (list '<= 1 a))))
            ;; m < n, so m <= K
            (dk-type! (list '- pa 1) 'ZZ) (dk-type! (list '- pa 1) 'RR)
            (dk-have! (list '<= 2 pa)
              (lambda ()
                (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases 1 pa))
                  (list (lambda ()
                          (dk-have! (list '< 0 (list '- pa 1)) (lambda () (dk-ineq! (list '< 1 pa))))
                          (dk-apply! (dk-cite! 'zz-discrete) (list '- pa 1))
                          (dk-ineq! (list '<= 1 (list '- pa 1))))
                        (lambda () (dk-have! (list '= pa 1) (lambda () (subst (list '= pa 1)) (n8-rfl!)))
                                   (ma-prop-with! (list (list '= pa 1) (list 'NOT (list '= pa 1)))))))))
            (dk-have! (list '<= 0 m) (lambda () (dk-ineq! (list '<= 1 m))))
            (dk-apply! (dk-cite! 'rr-mul-le-right 2 pa m))
            (dk-type! (list '* pa m) 'RR) (dk-type! (list '* 2 m) 'RR)
            (dk-have! (list '< m n) (lambda () (dk-ineq! (list '<= (list '* 2 m) (list '* pa m)) (list '= n (list '* pa m)) (list '<= 1 m)
                                                         (list 'IN (list '* pa m) 'RR) (list 'IN (list '* 2 m) 'RR))))
            (dk-type! (list '- n m) 'ZZ) (dk-type! (list '- n m) 'RR)
            (dk-have! (list '< 0 (list '- n m)) (lambda () (dk-ineq! (list '< m n))))
            (dk-apply! (dk-cite! 'zz-discrete) (list '- n m))
            (dk-have! (list '<= m v) (lambda () (dk-nn! (list '<= 1 (list '- n m)) (list '<= n (list 'succ v)))))
            ;; the hypothesis of induction at m, multiplicativity at (m, q^a)
            (dk-apply! (dk-ctx-form ih) 'f 'nb 'mb m)
            (dk-apply! (dk-cite! 'coprime-prime-power a) q m)
            (dk-apply! (dk-ctx-form (list 'FORALL 'mlm_ (list 'IMPLIES '(IN mlm_ NN) (list 'FORALL 'mln_ (list 'IMPLIES '(IN mln_ NN)
              (list 'IMPLIES '(<= 1 mlm_) (list 'IMPLIES '(<= 1 mln_) (list 'IMPLIES '(ZZ-COPRIME mlm_ mln_)
                '(= (f (* mlm_ mln_)) (* (f mlm_) (f mln_))))))))))) m pa)
            (n8-fx! 'f m) (n8-fx! 'f pa)
            (dk-have! (list '= (list 'f n) (list '* (list 'f m) (list 'f pa)))
              (lambda () (subst (list '= n (list '* m pa))) (ass)))
            (dk-have! (list 'AND (list 'IN (list 'f m) 'RR) (list 'IN (list 'f pa) 'RR)))
            (fact 'rr-abs-mult (list 'f m) (list 'f pa))
            (dk-have! (list '= (list 'abs (list 'f n)) (list '* fm fp))
              (lambda () (subst (list '= (list 'f n) (list '* (list 'f m) (list 'f pa)))) (ass)))
            ;; t(m) <= t(n): S(m) is inside S(n)
            (n8-t-facts! 'nb m)
            (n8-pw! 'mb tm)
            (let* ((sm (n8-tset 'nb m)) (sn (n8-tset 'nb n)))
              (dk-have! (list 'FORALL 'iev_ (list 'IMPLIES (list 'IN 'iev_ sm) (list 'IN 'iev_ sn)))
                (lambda ()
                  (let ((r (dk-di-var!)))
                    (ma-sep-parts! (list 'IN r sm))
                    (dk-split-all! (list (list 'AND (list 'IS-PRIME-NAT r) (list 'ZZ-DIVIDES r m))))
                    (dk-apply! (dk-cite! 'zz-divides-mul-right) r m pa)
                    (dk-rewrite-h! (list 'ZZ-DIVIDES r (list '* m pa)) (list '* m pa) n)
                    (in-sep! dk-ass! (lambda () (dk-conj-close! (lambda () (ass))))))))
              (let ((case-in!
                      ;; q <= N: |f(q^a)| <= M and t(m) + 1 <= t(n)
                      (lambda ()
                        (dk-have! (list '<= fp 'mb)
                          (lambda ()
                            (dk-have! (list 'AND (list 'IN pa 'RR) (list 'IN (list 'succ 'nb) 'RR)) (lambda () (fact 'nn-in-rr (list 'succ 'nb)) (dk-conj-close! (lambda () (ass)))))
                            (fact 'rr-leq-total pa (list 'succ 'nb))
                            (ma-or-split! (list 'OR (list '<= pa (list 'succ 'nb)) (list '<= (list 'succ 'nb) pa))
                              (list (lambda () (dk-have! (list '<= 1 pa) (lambda () (ass))) (dk-apply! (dk-ctx-form (n8-bdd 'f '(succ nb) 'mb)) pa) (ass))
                                    (lambda ()
                                      (dk-have! (list '< 'nb pa) (lambda () (dk-nn! (list '<= (list 'succ 'nb) pa))))
                                      (dk-apply! (dk-ctx-form (n8-hyp 'f 'nb)) q a)
                                      (dk-ineq! (list '<= fp 1) '(<= 1 mb) (list 'IN fp 'RR)))))))
                        (dk-have! (list 'IN q (list 'INTERVAL 1 'nb))
                          (lambda () (ma-iff-back! (dk-cite! 'interval-membership 1 'nb q))))
                        (dk-have! (list 'IN q sn) (lambda () (in-sep! dk-ass! (lambda () (dk-conj-close! (lambda () (ass)))))))
                        (dk-have! (list 'NOT (list 'IN q sm))
                          (lambda () (di) (ma-sep-parts! (list 'IN q sm))
                                     (dk-split-all! (list (list 'AND (list 'IS-PRIME-NAT q) (list 'ZZ-DIVIDES q m))))
                                     (ma-prop-with! (list (list 'ZZ-DIVIDES q m) (list 'NOT (list 'ZZ-DIVIDES q m))))))
                        (let ((su (list 'UNION sm (list 'PAIR q q))))
                          (dk-have! (list 'IN q 'SET) (lambda () (fact 'membership-implies-sethood q 'NN) (dk-ass!)))
                          (n7-card-insert! sm q)
                          (dk-have! (list 'SUBSET su sn)
                            (lambda ()
                              (mac 'subset-def)
                              (let ((r (dk-di-var!)))
                                (ie-or-split! r sm (list 'PAIR q q)
                                  (lambda () (dk-apply! (dk-ctx-form (list 'FORALL 'iev_ (list 'IMPLIES (list 'IN 'iev_ sm) (list 'IN 'iev_ sn)))) r) (ass))
                                  (lambda () (ma-singleton-eq! r q) (subst (list '= r q)) (ass))))))
                          (dk-apply! (dk-cite! 'card-subset-mono sn) su)
                          (dk-have! (list '<= (list 'succ (list 'succ tm)) (list 'succ tn))
                            (lambda () (dk-rewrite-h! (list '<= (list 'CARD su) tn) (list 'CARD su) (list 'succ tm)) (dk-nn! (list '<= (list 'succ tm) tn)))))
                        ;; the chain |f n| = |f m| |f pa| <= M^(t(m)+1) M = M^(t(m)+2) <= M^(t(n)+1)
                        (fact 'nn-succ-closed (list 'succ tm))
                        (dk-apply! (dk-cite! 'rr-power-mono-le (list 'succ tn)) (list 'succ (list 'succ tm)) 'mb)
                        (dk-type! 'mb 'CC)
                        (n8-psucc! 'mb (list 'succ tm))
                        (dk-apply! (dk-cite! 'rr-mul-le-right fm pm fp))
                        (dk-have! (list '<= 0 pm) (lambda () (dk-ineq! (list '<= 1 pm))))
                        (dk-apply! (dk-cite! 'rr-mul-le-right fp 'mb pm))
                        (fact 'power-real-closed 'mb (list 'succ (list 'succ tm)))
                        (let ((ps2 (list 'power 'mb (list 'succ (list 'succ tm)))))
                          (dk-have! (list '= (list '* pm fp) (list '* fp pm)) (lambda () (crs)))
                          (dk-have! (list '= (list '* 'mb pm) (list '* pm 'mb)) (lambda () (crs)))
                          (for-each (lambda (t) (dk-type! t 'RR)) (list (list '* fm fp) (list '* pm fp) (list '* fp pm) (list '* 'mb pm) (list '* pm 'mb)))
                          (dk-ineq! (list '= (list 'abs (list 'f n)) (list '* fm fp)) (list '<= (list '* fm fp) (list '* pm fp))
                                    (list '= (list '* pm fp) (list '* fp pm)) (list '<= (list '* fp pm) (list '* 'mb pm))
                                    (list '= (list '* 'mb pm) (list '* pm 'mb)) (list '= ps2 (list '* 'mb pm)) (list '<= ps2 pn)
                                    (list 'IN (list '* fm fp) 'RR) (list 'IN (list '* pm fp) 'RR) (list 'IN (list '* fp pm) 'RR)
                                    (list 'IN (list '* 'mb pm) 'RR) (list 'IN (list '* pm 'mb) 'RR) (list 'IN ps2 'RR) (list 'IN pn 'RR)
                                    (list 'IN (list 'abs (list 'f n)) 'RR))))))
                (dk-have! (list 'AND (list 'IN q 'RR) (list 'IN 'nb 'RR)) (lambda () (fact 'nn-in-rr 'nb) (dk-conj-close! (lambda () (ass)))))
                (fact 'rr-leq-total q 'nb)
                (ma-or-split! (list 'OR (list '<= q 'nb) (list '<= 'nb q))
                  (list case-in!
                        (lambda ()
                          (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases 'nb q))
                            (list
                              ;; N < q: |f(q^a)| <= 1 and t(m) <= t(n)
                              (lambda ()
                                (dk-have! (list '< 'nb pa) (lambda () (dk-ineq! (list '< 'nb q) (list '<= q pa))))
                                (dk-apply! (dk-ctx-form (n8-hyp 'f 'nb)) q a)
                                (dk-have! (list 'SUBSET sm sn) (lambda () (mac 'subset-def) (ass)))
                                (dk-apply! (dk-cite! 'card-subset-mono sn) sm)
                                (dk-have! (list '<= (list 'succ tm) (list 'succ tn)) (lambda () (dk-nn! (list '<= tm tn))))
                                (dk-apply! (dk-cite! 'rr-power-mono-le (list 'succ tn)) (list 'succ tm) 'mb)
                                (dk-apply! (dk-cite! 'rr-mul-le-right fp 1 fm))
                                (dk-have! (list '= (list '* fm fp) (list '* fp fm)) (lambda () (crs)))
                                (for-each (lambda (t) (dk-type! t 'RR)) (list (list '* fm fp) (list '* fp fm) (list '* 1 fm)))
                                (dk-ineq! (list '= (list 'abs (list 'f n)) (list '* fm fp)) (list '= (list '* fm fp) (list '* fp fm))
                                          (list '<= (list '* fp fm) (list '* 1 fm)) (list '<= fm pm) (list '<= pm pn)
                                          (list 'IN (list '* fm fp) 'RR) (list 'IN (list '* fp fm) 'RR) (list 'IN (list '* 1 fm) 'RR)
                                          (list 'IN fm 'RR) (list 'IN pm 'RR) (list 'IN pn 'RR) (list 'IN (list 'abs (list 'f n)) 'RR)))
                              (lambda ()
                                (dk-have! (list '<= q 'nb) (lambda () (dk-ineq! (list '= 'nb q))))
                                (case-in!)))))))))))
        ;; n = 1
        (lambda ()
          (dk-have! (list '<= n '(succ nb)) (lambda () (dk-nn! (list '= 1 n))))
          (dk-apply! (dk-ctx-form (n8-bdd 'f '(succ nb) 'mb)) n)
          (dk-have! (list '<= 1 (list 'succ tn)) (lambda () (dk-nn!)))
          (dk-apply! (dk-cite! 'rr-power-ge-base (list 'succ tn)) 'mb)
          (dk-ineq! (list '<= (list 'abs (list 'f n)) 'mb) (list '<= 'mb pn) (list 'IN pn 'RR) (list 'IN (list 'abs (list 'f n)) 'RR)))))))
(qed 'multiplicative-bound-step)

;;; LEMMA 1.24
(sp (make-wff (list 'FORALL 'f (list 'IMPLIES '(IS-MULTIPLICATIVE f) (list 'FORALL 'nb (list 'IMPLIES '(IN nb NN) (list 'IMPLIES (n8-hyp 'f 'nb)
  (list 'FORSOME 'mbb_ (list 'AND '(IN mbb_ RR) (list 'FORALL 'mbn_ (list 'IMPLIES '(IN mbn_ NN) (list 'IMPLIES '(<= 1 mbn_) '(<= (abs (f mbn_)) mbb_)))))))))))))
(dk-peel!)
(nt4-open! 'is-multiplicative '(f) '(IS-MULTIPLICATIVE f))
(fact 'nn-succ-closed 'nb)
(let* ((m (dk-skolem! (dk-apply! (dk-cite! 'fun-abs-bounded-initial '(succ nb)) 'f) #t))
       (b (list 'power m '(succ nb))))
  (fact 'power-real-closed m '(succ nb))
  (ew b)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((n (dk-di-var!)) (tn (n8-t 'nb n)))
            (di)
            (fact 'nn-in-rr n)
            (dk-have! (list '<= n n) (lambda () (dk-ineq!)))
            (dk-apply! (dk-cite! 'multiplicative-bound-step n) 'f 'nb m n)
            (n8-t-facts! 'nb n)
            (n8-pw! m tn)
            (n8-fx! 'f n)
            (dk-have! (list '<= (list 'succ tn) '(succ nb)) (lambda () (dk-nn! (list '<= tn '(CARD (INTERVAL 1 nb))) '(= (CARD (INTERVAL 1 nb)) nb))))
            (dk-apply! (dk-cite! 'rr-power-mono-le '(succ nb)) (list 'succ tn) m)
            (dk-ineq! (list '<= (list 'abs (list 'f n)) (list 'power m (list 'succ tn))) (list '<= (list 'power m (list 'succ tn)) b)
                      (list 'IN (list 'power m (list 'succ tn)) 'RR) (list 'IN b 'RR) (list 'IN (list 'abs (list 'f n)) 'RR)))))))
(qed 'multiplicative-bounded)


;;; ==================================================================== from nt9.scm
;;; (49) ALGEBRAIC-NUMBERS ch. 1, bundle B3: Prop. 1.25 and Cor. 1.26 (growth of phi), the notes' route through
;;; Lemma 1.24: for tau > 0 the function g(n) = n^(1 - tau) / phi(n) is multiplicative and g(p^l) <= 1 once
;;; p^l > 2^(1/tau), so g is bounded.  Exponents are RATIONAL: the tree's RPOW (rpow-defined.scm) takes an
;;; exponent in QQ; the notes take delta real.  g(0) is set to 0 (an IF), since 1/phi(0) is undefined.
;;; Helper prefix n9-.
(define (n9-g e) (list 'VNB-LAMBDA 'gk_ 'NN (list 'IF '(= gk_ 0) 0 (list '* (list 'RPOW 'gk_ e) '(recip (EULER-PHI gk_))))))
(define (n9-gv e x) (list '* (list 'RPOW x e) (list 'recip (list 'EULER-PHI x))))
(define (n9-rfl!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))

;;; phi(n) >= 1 for n >= 1 (1 is prime to n)
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (IMPLIES (<= 1 n) (AND (IN (EULER-PHI n) NN) (<= 1 (EULER-PHI n))))))))
(dk-peel!)
(fact 'zz-zero-in) (fact 'zz-one-in) (fact 'nn-one-in)
(dk-type! 'n 'ZZ) (fact 'nn-in-rr 'n)
(let* ((s (nt3-phiset 'n)) (iv '(INTERVAL 1 n)))
  (fact 'interval-in-set 1 'n) (dk-apply! (dk-cite! 'interval-card-in-nn 1 'n))
  (nt3-fin! s iv)
  (dk-have! '(NOT (= n 0)) (lambda () (di) (n8-absurd! '(= n 0) '(<= 1 n))))
  (let ((iff (dk-cite! 'zz-coprime-iff-no-common-prime 1 'n)))
    (dk-have! (caddr iff)
      (lambda ()
        (di)
        (let ((q (cadr (cadr (dk-goal)))))
          (di) (di) (di)
          (n7-prime-nn! q) (dk-type! q 'ZZ) (fact 'nn-in-rr q)
          (dk-have! (list '< 0 q) (lambda () (dk-ineq! (list '< 1 q))))
          (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
          (dk-apply! (dk-cite! 'zz-divides-small) q 1)
          (ma-prop-with! (list (list 'ZZ-DIVIDES q 1) (list 'NOT (list 'ZZ-DIVIDES q 1)))))))
    (ma-iff-back! iff))
  (dk-have! '(<= 1 1) (lambda () (dk-ineq!)))
  (ma-iff-back! (dk-cite! 'interval-membership 1 'n 1))
  (dk-have! (list 'IN 1 s) (lambda () (in-sep! dk-ass! (lambda () (ass)))))
  (fact 'membership-implies-sethood 1 'NN)
  (dk-have! (list 'SUBSET '(PAIR 1 1) s)
    (lambda () (mac 'subset-def) (let ((r (dk-di-var!))) (ma-singleton-eq! r 1) (subst (list '= r 1)) (ass))))
  (dk-apply! (dk-cite! 'card-subset-mono s) '(PAIR 1 1))
  (fact 'card-singleton 1)
  (fact 'nn-zero-in)
  (dk-have! (list '<= 1 (list 'CARD s))
    (lambda () (dk-rewrite-h! (list '<= '(CARD (PAIR 1 1)) (list 'CARD s)) '(CARD (PAIR 1 1)) '(succ 0)) (dk-nn! (list '<= '(succ 0) (list 'CARD s)))))
  (mac 'EULER-PHI)
  (dk-conj-close! (lambda () (ass))))
(qed 'euler-phi-pos)

;;; phi(p^(j+1)) = p^(j+1) (1 - 1/p)
(sp (make-wff '(FORALL j (IMPLIES (IN j NN) (FORALL p (IMPLIES (IS-PRIME-NAT p)
  (= (EULER-PHI (power p (succ j))) (* (power p (succ j)) (- 1 (recip p))))))))))
(dk-peel!)
(ie-ring!) (n7-one!)
(n7-prime-nn! 'p)
(fact 'zz-zero-in) (fact 'zz-one-in) (fact 'nn-one-in)
(fact 'nn-succ-closed 'j)
(let* ((x '(power p (succ j))) (px '(power p j)) (ps (n7-ps x)) (sg '(PAIR p p)))
  (dk-cite! 'nn-power-closed '(succ j) 'p) (dk-cite! 'nn-power-closed 'j 'p)
  (dk-type! 'p 'ZZ) (fact 'nn-subset-zz x) (fact 'nn-subset-zz px)
  (fact 'nn-in-rr 'p) (fact 'nn-in-rr x) (dk-type! 'p 'CC)
  (dk-have! '(<= 1 p) (lambda () (dk-ineq! '(< 1 p))))
  (dk-have! '(<= 1 (succ j)) (lambda () (dk-nn!)))
  (dk-apply! (dk-cite! 'rr-power-ge-base '(succ j)) 'p)
  (dk-have! (list '<= 1 x) (lambda () (dk-ineq! '(<= 1 p) (list '<= 'p x))))
  (n8-psucc! 'p 'j)
  (dk-have! (list 'ZZ-DIVIDES 'p x) (lambda () (dk-have! (list '= x (list '* 'p px)) (lambda () (ass))) (nt2-div-intro! 'p x px)))
  (fact 'membership-implies-sethood 'p 'NN)
  ;; the prime divisors of p^(j+1): {p}
  (ma-ext2! ps sg
    (lambda (w)
      (ma-sep-parts! (list 'IN w ps))
      (dk-split-all! (list (list 'AND (list 'IS-PRIME-NAT w) (list 'ZZ-DIVIDES w x))))
      (dk-apply! (dk-cite! 'prime-divides-prime-power '(succ j)) 'p w)
      (subst (list '= w 'p)) (ma-in-singleton! 'p) (ass))
    (lambda (w)
      (ma-singleton-eq! w 'p) (subst (list '= w 'p))
      (ma-iff-back! (dk-cite! 'interval-membership 1 x 'p))
      (in-sep! dk-ass! (lambda () (dk-conj-close! (lambda () (ass)))))))
  (dk-apply! (dk-cite! 'euler-phi-product) x)
  (subst (list '= (list 'EULER-PHI x) (list '* x (list 'PROD-RING ie-r (n7-q ps) ps))))
  (subst (list '= ps sg))
  ;; the product over {p}
  (let ((f (n7-q sg)))
    (dk-have! '(NOT (= p 0)) (lambda () (di) (n8-absurd! '(= p 0) '(< 1 p))))
    (dk-have! '(AND (IN p CC) (NOT (= p 0)))) (fact 'cc-recip-closed 'p)
    (dk-type! '(- 1 (recip p)) 'CC)
    (dk-have! (list 'IN f (list 'FUN sg (list 'CARR ie-r)))
      (lambda ()
        (dk-lam-type!
          (lambda () (let ((z (dk-di-var!))) (ma-singleton-eq! z 'p) (subst (list '= z 'p)) (subst (list '== (list 'CARR ie-r) 'CC)) (ass)))
          (lambda () (dk-have! '(AND (IN p SET) (IN p SET))) (fact 'pairing 'p 'p) (dk-ass!)))))
    (dk-apply! (dk-cite! 'prod-ring-singleton ie-r) 'p f)
    (ma-in-singleton! 'p)
    (n7-val! f 'p '(- 1 (recip p)))
    (subst (list '= (list 'PROD-RING ie-r f sg) (list f 'p)))
    (subst (list '= (list f 'p) '(- 1 (recip p))))
    (n9-rfl!)))
(qed 'euler-phi-prime-power)

;;; x in NN, 1 <= x: the facts about x, phi(x) and the value g_e(x) (e in QQ in context)
(define (n9-facts! e x)
  (fact 'nn-in-rr x)
  (dk-have! (list '< 0 x) (lambda () (dk-ineq! (list '<= 1 x))))
  (dk-have! (list 'NOT (list '= x 0)) (lambda () (di) (n8-absurd! (list '= x 0) (list '<= 1 x))))
  (dk-have! (list 'AND (list 'IN x 'RR) (list '< 0 x)))
  (dk-split-all! (list (dk-apply! (dk-cite! 'rpow-pos) x e)))
  (if (not (dk-asm? (list '<= 1 (list 'EULER-PHI x)))) (dk-split-all! (list (dk-apply! (dk-cite! 'euler-phi-pos) x))))
  (let* ((ph (list 'EULER-PHI x)) (rp (list 'recip ph)))
    (fact 'nn-in-rr ph)
    (dk-have! (list 'NOT (list '= ph 0)) (lambda () (di) (n8-absurd! (list '= ph 0) (list '<= 1 ph))))
    (dk-have! (list 'AND (list 'IN ph 'RR) (list 'NOT (list '= ph 0))))
    (fact 'rr-recip-closed ph)
    (dk-have! (list '< 0 ph) (lambda () (dk-ineq! (list '<= 1 ph))))
    (if (not (dk-asm? (list '< 0 rp))) (dk-apply! (dk-cite! 'rr-recip-pos ph)))
    (dk-type! (n9-gv e x) 'RR)))
;;; x in NN, x /= 0 in context: 1 <= x
(define (n9-ge1! x)
  (dk-have! (list '<= 1 x)
    (lambda ()
      (ma-or-split! (dk-apply! (dk-cite! 'nn-zero-or-succ) x)
        (list (lambda () (ma-prop-with! (list (list '= x 0) (list 'NOT (list '= x 0)))))
              (lambda ()
                (let ((q (dk-skolem! (dk-ctx-form (list 'FORSOME 'q (list 'AND '(IN q NN) (list '= x '(succ q))))) #t)))
                  (dk-nn! (list '= x (list 'succ q))))))))))

;;; g_e is multiplicative
(sp (make-wff (list 'FORALL 'e (list 'IMPLIES '(IN e QQ) (list 'IS-MULTIPLICATIVE (n9-g 'e))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'nn-zero-in)
(let ((g (n9-g 'e)))
  (nt4-close! 'is-multiplicative (list g)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'IN)
              (dk-lam-type!
                (lambda ()
                  (let* ((z (dk-di-var!)) (ift (list 'IF (list '= z 0) 0 (n9-gv 'e z))))
                    (dk-case-if! ift
                      (lambda (true? br)
                        (if true? (ass) (begin (n9-ge1! z) (n9-facts! 'e z) (ass)))))))
                (lambda () (fact 'nn-is-set) (dk-ass!)))
              (let* ((mn (begin (dk-peel!) (cadr (cadr (dk-goal))))) (m (cadr mn)) (n (caddr mn)))
                (dk-have! (list 'AND (list 'IN m 'NN) (list 'IN n 'NN))) (fact 'nn-mul-closed m n)
                (fact 'nn-in-rr m) (fact 'nn-in-rr n)
                (dk-type! mn 'RR)
                (dk-have! (list '<= 1 mn) (lambda ()
                  (dk-have! (list '<= 0 m) (lambda () (dk-ineq! (list '<= 1 m))))
                  (dk-apply! (dk-cite! 'rr-mul-le-right 1 n m))
                  (dk-have! (list '= (list '* n m) mn) (lambda () (crs)))
                  (dk-type! (list '* 1 m) 'RR) (dk-type! (list '* n m) 'RR)
                  (dk-ineq! (list '<= (list '* 1 m) (list '* n m)) (list '= (list '* n m) mn) (list '<= 1 m)
                            (list 'IN (list '* 1 m) 'RR) (list 'IN (list '* n m) 'RR) (list 'IN mn 'RR))))
                (n9-facts! 'e m) (n9-facts! 'e n) (n9-facts! 'e mn)
                (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!))
                (dk-if-branch! #f (list 'IF (list '= mn 0) 0 (n9-gv 'e mn)) #f
                  (lambda ()
                    (dk-if-branch! #f (list 'IF (list '= m 0) 0 (n9-gv 'e m)) #f
                      (lambda ()
                        (dk-if-branch! #f (list 'IF (list '= n 0) 0 (n9-gv 'e n)) #f
                          (lambda ()
                            (let* ((a (list 'RPOW m 'e)) (b (list 'RPOW n 'e)) (pm (list 'EULER-PHI m)) (pn (list 'EULER-PHI n))
                                   (c (list 'recip pm)) (d (list 'recip pn)))
                              (dk-have! (list 'AND (list 'IN m 'RR) (list '< 0 m)))
                              (dk-have! (list 'AND (list 'IN n 'RR) (list '< 0 n)))
                              (dk-apply! (dk-cite! 'rpow-mul-base) m n 'e)
                              (dk-apply! (dk-cite! 'euler-phi-multiplicative) m n)
                              (fact 'rr-subset-cc pm) (fact 'rr-subset-cc pn)
                              (dk-apply! (dk-cite! 'cc-recip-mul) pm pn)
                              (subst (list '= (list 'RPOW mn 'e) (list '* a b)))
                              (subst (list '= (list 'EULER-PHI mn) (list '* pm pn)))
                              (subst (list '= (list 'recip (list '* pm pn)) (list '* c d)))
                              (let* ((va (dk-name! a 'RR)) (vb (dk-name! b 'RR)) (vc (dk-name! c 'RR)) (vd (dk-name! d 'RR)))
                                (subst (list '= a va)) (subst (list '= b vb)) (subst (list '= c vc)) (subst (list '= d vd))
                                (crs))))))))))))))))
(qed 'euler-phi-ratio-multiplicative)

;;; t in QQ, 0 < t: g_(1 - t)(p^(j+1)) <= 1 once p^(j+1) >= y with y^t = 2
(define (n9-two! p)
  ;; p prime: 2 <= p
  (dk-type! (list '- p 1) 'ZZ) (dk-type! (list '- p 1) 'RR)
  (dk-have! (list '< 0 (list '- p 1)) (lambda () (dk-ineq! (list '< 1 p))))
  (dk-apply! (dk-cite! 'zz-discrete) (list '- p 1))
  (dk-have! (list '<= 2 p) (lambda () (dk-ineq! (list '<= 1 (list '- p 1))))))
(define (n9-recip-facts! w)
  ;; w in RR, 0 < w: (IN (recip w) RR), (< 0 (recip w)), (= (* w (recip w)) 1)
  (dk-have! (list 'NOT (list '= w 0)) (lambda () (di) (n8-absurd! (list '= w 0) (list '< 0 w))))
  (dk-have! (list 'AND (list 'IN w 'RR) (list 'NOT (list '= w 0))))
  (fact 'rr-recip-closed w) (fact 'rr-recip-inverse w)
  (dk-apply! (dk-cite! 'rr-recip-pos w)))

(sp (make-wff '(FORALL t (IMPLIES (IN t QQ) (IMPLIES (< 0 t) (FORALL y (IMPLIES (IN y RR) (IMPLIES (< 0 y) (IMPLIES (= (RPOW y t) 2)
  (FORALL j (IMPLIES (IN j NN) (FORALL p (IMPLIES (IS-PRIME-NAT p) (IMPLIES (<= y (power p (succ j)))
    (<= (* (RPOW (power p (succ j)) (- 1 t)) (recip (EULER-PHI (power p (succ j))))) 1)))))))))))))))
(dk-peel!)
(fact 'qq-subset-rr 't) (fact 'qq-zero-in) (fact 'qq-one-in) (fact 'rr-zero-in) (fact 'rr-one-in)
(n7-prime-nn! 'p) (dk-type! 'p 'ZZ) (fact 'nn-in-rr 'p)
(fact 'nn-succ-closed 'j)
(let* ((x '(power p (succ j))) (e '(- 1 t)) (mt '(- 0 t)) (w (list 'RPOW x 't)) (r (list 'recip w))
       (rp '(recip p)) (u (list '- 1 rp)) (ru (list 'recip u)) (rx (list 'recip x)))
  (dk-cite! 'nn-power-closed '(succ j) 'p) (fact 'nn-in-rr x)
  (dk-have! '(<= 1 p) (lambda () (dk-ineq! '(< 1 p))))
  (dk-apply! (dk-cite! 'rr-power-ge-one '(succ j)) 'p)
  (dk-type! e 'QQ) (dk-type! mt 'QQ)
  (n9-facts! e x)
  (n9-two! 'p)
  ;; phi(x) = x (1 - 1/p); x^(1-t) = x / x^t
  (dk-apply! (dk-cite! 'euler-phi-prime-power 'j) 'p)
  (dk-have! (list 'AND (list 'IN x 'RR) (list '< 0 x)))
  (dk-apply! (dk-cite! 'rpow-add) x 1 mt)
  (dk-apply! (dk-cite! 'rpow-one) x)
  (dk-apply! (dk-cite! 'rpow-neg) x 't)
  (dk-have! '(<= 0 t) (lambda () (dk-ineq! '(< 0 t))))
  (dk-split-all! (list (dk-apply! (dk-cite! 'rpow-pos) x 't)))
  (n9-recip-facts! w)
  (dk-have! '(< 0 p) (lambda () (dk-ineq! '(< 1 p))))
  (n9-recip-facts! 'p)
  (n9-recip-facts! x)
  ;; 2 <= x^t, so 2 r <= 1
  (dk-have! (list '<= 'y x) (lambda () (ass)))
  (dk-have! (list 'AND '(IN y RR) '(< 0 y)))
  (dk-have! (list 'AND (list 'IN x 'RR) (list '<= 'y x)))
  (dk-have! '(AND (IN t QQ) (<= 0 t)))
  (dk-apply! (dk-cite! 'rpow-mono-base) 'y x 't)
  (dk-split-all! (list (dk-apply! (dk-cite! 'rpow-pos) 'y 't)))
  (dk-have! (list '<= 2 w) (lambda () (dk-ineq! (list '<= '(RPOW y t) w) '(= (RPOW y t) 2) '(IN (RPOW y t) RR) (list 'IN w 'RR))))
  (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
  (dk-apply! (dk-cite! 'rr-mul-le-right 2 w r))
  (dk-type! (list '* 2 r) 'RR) (dk-type! (list '* w r) 'RR)
  (dk-have! (list '<= (list '* 2 r) 1) (lambda () (dk-ineq! (list '<= (list '* 2 r) (list '* w r)) (list '= (list '* w r) 1) (list 'IN (list '* w r) 'RR) (list 'IN (list '* 2 r) 'RR))))
  ;; 2/p <= 1, so u = 1 - 1/p >= 1/2 and 1/u <= 2
  (dk-have! (list '<= 0 rp) (lambda () (dk-ineq! (list '< 0 rp))))
  (dk-apply! (dk-cite! 'rr-mul-le-right 2 'p rp))
  (dk-type! (list '* 2 rp) 'RR) (dk-type! (list '* 'p rp) 'RR)
  (dk-type! u 'RR)
  (dk-have! (list '<= 1 (list '* 2 u)) (lambda () (dk-ineq! (list '<= (list '* 2 rp) (list '* 'p rp)) (list '= (list '* 'p rp) 1)
                                                         (list 'IN (list '* 'p rp) 'RR) (list 'IN (list '* 2 rp) 'RR) (list 'IN rp 'RR))))
  (dk-have! (list '< 0 u) (lambda () (dk-ineq! (list '<= 1 (list '* 2 u)) (list 'IN u 'RR))))
  (n9-recip-facts! u)
  (dk-have! (list '<= 0 ru) (lambda () (dk-ineq! (list '< 0 ru))))
  (dk-type! (list '* 2 u) 'RR)
  (dk-apply! (dk-cite! 'rr-mul-le-right 1 (list '* 2 u) ru))
  (dk-have! (list '= (list '* (list '* 2 u) ru) (list '* 2 (list '* u ru))) (lambda () (crs)))
  (dk-type! (list '* 1 ru) 'RR) (dk-type! (list '* (list '* 2 u) ru) 'RR) (dk-type! (list '* u ru) 'RR)
  (dk-have! (list '<= ru 2) (lambda () (dk-ineq! (list '<= (list '* 1 ru) (list '* (list '* 2 u) ru)) (list '= (list '* (list '* 2 u) ru) (list '* 2 (list '* u ru)))
                                                  (list '= (list '* u ru) 1) (list 'IN (list '* 1 ru) 'RR) (list 'IN (list '* (list '* 2 u) ru) 'RR) (list 'IN (list '* u ru) 'RR))))
  ;; g(x) = r / u
  (fact 'rr-subset-cc x) (dk-type! u 'CC)
  (dk-have! (list 'NOT (list '= u 0)) (lambda () (di) (n8-absurd! (list '= u 0) (list '< 0 u))))
  (dk-apply! (dk-cite! 'cc-recip-mul) x u)
  (dk-have! (list '= (n9-gv e x) (list '* r ru))
    (lambda ()
      (dk-have! (list '= e (list '+ 1 mt)) (lambda () (crs)))
      (subst (list '= e (list '+ 1 mt)))
      (subst (list '= (list 'RPOW x (list '+ 1 mt)) (list '* (list 'RPOW x 1) (list 'RPOW x mt))))
      (subst (list '= (list 'RPOW x 1) x))
      (subst (list '= (list 'RPOW x mt) r))
      (subst (list '= (list 'EULER-PHI x) (list '* x u)))
      (subst (list '= (list 'recip (list '* x u)) (list '* rx ru)))
      (let* ((vr (dk-name! r 'RR)) (vru (dk-name! ru 'RR)) (vrx (dk-name! rx 'RR)))
        (dk-have! (list '= (list '* x vrx) 1) (lambda () (subst (list '= vrx rx)) (ass)))
        (subst (list '= r vr)) (subst (list '= ru vru)) (subst (list '= rx vrx))
        (dk-have! (list '= (list '* (list '* x vr) (list '* vrx vru)) (list '* (list '* x vrx) (list '* vr vru))) (lambda () (crs)))
        (subst (list '= (list '* (list '* x vr) (list '* vrx vru)) (list '* (list '* x vrx) (list '* vr vru))))
        (subst (list '= (list '* x vrx) 1))
        (crs))))
  ;; r / u <= 1
  (dk-type! (list '* 2 r) 'RR)
  (dk-have! (list '<= 0 (list '* 2 r)) (lambda () (dk-ineq! (list '<= 0 r))))
  (dk-apply! (dk-cite! 'rr-mul-le-right (list '* 2 r) 1 ru))
  (dk-have! (list '= (list '* (list '* 2 r) ru) (list '* 2 (list '* r ru))) (lambda () (crs)))
  (dk-type! (list '* (list '* 2 r) ru) 'RR) (dk-type! (list '* r ru) 'RR)
  (subst (list '= (n9-gv e x) (list '* r ru)))
  (dk-ineq! (list '<= (list '* (list '* 2 r) ru) (list '* 1 ru)) (list '= (list '* (list '* 2 r) ru) (list '* 2 (list '* r ru))) (list '<= ru 2)
            (list 'IN (list '* (list '* 2 r) ru) 'RR) (list 'IN (list '* r ru) 'RR) (list 'IN ru 'RR)))
(qed 'euler-phi-ratio-prime-power)

;;; n in NN, n >= 1 (facts of n9-facts! in context): (= (abs gv) gv), (<= 0 gv)
(define (n9-gv-nonneg! e x)
  (let* ((a (list 'RPOW x e)) (c (list 'recip (list 'EULER-PHI x))) (gv (n9-gv e x)))
    (dk-have! (list '<= 0 a) (lambda () (dk-ineq! (list '< 0 a))))
    (dk-have! (list '<= 0 c) (lambda () (dk-ineq! (list '< 0 c))))
    (fact 'rr-zero-in)
    (dk-apply! (dk-cite! 'rr-mul-le-right 0 a c))
    (dk-type! (list '* 0 c) 'RR)
    (dk-have! (list '<= 0 gv) (lambda () (dk-have! (list '= (list '* 0 c) 0) (lambda () (crs)))
                                          (dk-ineq! (list '<= (list '* 0 c) gv) (list '= (list '* 0 c) 0) (list 'IN (list '* 0 c) 'RR) (list 'IN gv 'RR))))
    (dk-apply! (dk-cite! 'rr-abs-of-nonneg) gv)))
;;; x in NN, x >= 1: (= (g x) gv)
(define (n9-g-val! e x)
  (let* ((g (n9-g e)) (gv (n9-gv e x)))
    (dk-have! (list '= (list g x) gv)
      (lambda ()
        (dk-lam-b!)
        (dk-if-branch! #f (list 'IF (list '= x 0) 0 gv) #f (lambda () (n9-rfl!)))))))
(define (n9-exp-facts! t)
  ;; t in QQ, 0 < t: (- 1 t) in QQ, y = 2^(1/t) with y^t = 2 and y >= 1
  (let* ((rt (list 'recip t)) (y (list 'RPOW 2 rt)))
    (fact 'qq-subset-rr t) (fact 'qq-zero-in) (fact 'qq-one-in) (fact 'rr-zero-in) (fact 'rr-one-in)
    (dk-type! (list '- 1 t) 'QQ)
    (dk-have! (list 'NOT (list '= t 0)) (lambda () (di) (n8-absurd! (list '= t 0) (list '< 0 t))))
    (dk-have! (list 'AND (list 'IN t 'QQ) (list 'NOT (list '= t 0))))
    (fact 'qq-recip-closed t) (fact 'qq-recip-inverse t)
    (fact 'qq-subset-rr rt)
    (dk-apply! (dk-cite! 'rr-recip-pos t))
    (dk-type! 2 'RR)
    (dk-have! '(< 0 2) (lambda () (dk-ineq!)))
    (dk-have! '(AND (IN 2 RR) (< 0 2)))
    (dk-split-all! (list (dk-apply! (dk-cite! 'rpow-pos) 2 rt)))
    (dk-apply! (dk-cite! 'rpow-pow) 2 rt t)
    (dk-apply! (dk-cite! 'rpow-one) 2)
    (dk-have! (list '= (list 'RPOW y t) 2)
      (lambda ()
        (subst (list '= (list 'RPOW y t) (list 'RPOW 2 (list '* rt t))))
        (dk-have! (list '= (list '* rt t) 1) (lambda () (dk-have! (list '= (list '* rt t) (list '* t rt)) (lambda () (crs)))
                                                     (subst (list '= (list '* rt t) (list '* t rt))) (ass)))
        (subst (list '= (list '* rt t) 1))
        (ass)))
    (dk-have! '(AND (IN 2 RR) (<= 1 2)) (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!)) (dk-ineq!))))))
    (dk-have! (list 'AND (list 'IN rt 'QQ) (list '<= 0 rt)) (lambda () (dk-conj-close! (lambda () (if (not (dk-ass!)) (dk-ineq! (list '< 0 rt)))))))
    (dk-apply! (dk-cite! 'rpow-mono-exp-ge1) 2 0 rt)
    (dk-apply! (dk-cite! 'rpow-zero) 2)
    (dk-rewrite-h! (list '<= '(RPOW 2 0) y) '(RPOW 2 0) 1)
    y))

;;; for t > 0 rational, n^(1 - t) / phi(n) is bounded
(sp (make-wff (list 'FORALL 't (list 'IMPLIES '(IN t QQ) (list 'IMPLIES '(< 0 t)
  (list 'FORSOME 'phb_ (list 'AND '(IN phb_ RR) (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(<= 1 n) (list '<= (n9-gv '(- 1 t) 'n) 'phb_)))))))))))
(dk-peel!)
(let* ((y (n9-exp-facts! 't)) (e '(- 1 t)) (g (n9-g e)))
  (dk-apply! (dk-cite! 'euler-phi-ratio-multiplicative) e)
  (let* ((nb (dk-skolem! (dk-apply! (dk-cite! 'nn-unbounded-in-rr) y) #t)))
    (fact 'nn-in-rr nb)
    ;; the hypothesis of Lemma 1.24 at N = nb
    (dk-have! (n8-hyp g nb)
      (lambda ()
        (dk-peel!)
        (let* ((x (cadr (cadr (cadr (dk-goal))))) (p (cadr x)) (k (caddr x)) (hk (list '< nb x)))
          (n7-prime-nn! p) (fact 'nn-in-rr p)
          (dk-have! (list '<= 1 p) (lambda () (dk-ineq! (list '< 1 p))))
          (ma-or-split! (dk-apply! (dk-cite! 'nn-zero-or-succ) k)
            (list (lambda ()
                    (dk-type! p 'CC) (fact 'power-zero p)
                    (let ((h (dk-rewrite-h! (dk-rewrite-h! hk k 0) (list 'power p 0) 1)))
                      (n8-absurd! h (list '< y nb) (list '<= 1 y) (list 'IN y 'RR))))
                  (lambda ()
                    (let* ((j (dk-skolem! (dk-ctx-form (list 'FORSOME 'q (list 'AND '(IN q NN) (list '= k '(succ q))))) #t))
                           (xs (list 'power p (list 'succ j))))
                      (fact 'nn-succ-closed j)
                      (dk-cite! 'nn-power-closed (list 'succ j) p) (fact 'nn-in-rr xs)
                      (dk-apply! (dk-cite! 'rr-power-ge-one (list 'succ j)) p)
                      (let ((h (dk-rewrite-h! hk k (list 'succ j))))
                        (dk-have! (list '<= y xs) (lambda () (dk-ineq! h (list '< y nb) (list 'IN xs 'RR)))))
                      (subst (list '= k (list 'succ j)))
                      (n9-facts! e xs)
                      (n9-g-val! e xs)
                      (subst (list '= (list g xs) (n9-gv e xs)))
                      (n9-gv-nonneg! e xs)
                      (subst (list '= (list 'abs (n9-gv e xs)) (n9-gv e xs)))
                      (dk-apply! (dk-cite! 'euler-phi-ratio-prime-power 't) y j p)
                      (ass))))))))
    (let ((b (dk-skolem! (dk-apply! (dk-cite! 'multiplicative-bounded) g nb) #t)))
      (ew b)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((n (begin (dk-peel!) (cadr (cadr (cadr (dk-goal))))) ))
                (n9-facts! e n)
                (dk-apply! (dk-ctx-form (list 'FORALL 'mbn_ (list 'IMPLIES '(IN mbn_ NN) (list 'IMPLIES '(<= 1 mbn_) (list '<= (list 'abs (list g 'mbn_)) b))))) n)
                (n9-g-val! e n)
                (n9-gv-nonneg! e n)
                (let ((h (dk-rewrite-h! (dk-rewrite-h! (list '<= (list 'abs (list g n)) b) (list g n) (n9-gv e n))
                                        (list 'abs (n9-gv e n)) (n9-gv e n))))
                  (ass)))))))))
(qed 'euler-phi-ratio-bounded)

;;; COROLLARY 1.26: for delta > 0 rational there is c > 0 with phi(n) >= c n^(1 - delta)
(sp (make-wff '(FORALL d (IMPLIES (IN d QQ) (IMPLIES (< 0 d)
  (FORSOME c (AND (IN c RR) (AND (< 0 c) (FORALL n (IMPLIES (IN n NN) (IMPLIES (<= 1 n) (<= (* c (RPOW n (- 1 d))) (EULER-PHI n)))))))))))))
(dk-peel!)
(fact 'qq-subset-rr 'd) (fact 'qq-one-in) (dk-type! '(- 1 d) 'QQ) (fact 'rr-one-in)
(let* ((b (dk-skolem! (dk-apply! (dk-cite! 'euler-phi-ratio-bounded) 'd) #t))
       (ab (list 'abs b)) (k (list '+ ab 1)) (c (list 'recip k)))
  (fact 'rr-abs-closed b) (fact 'rr-abs-nonneg b) (fact 'rr-le-abs b)
  (dk-type! k 'RR)
  (dk-have! (list '< 0 k) (lambda () (dk-ineq! (list '<= 0 ab) (list 'IN ab 'RR))))
  (n9-recip-facts! k)
  (ew c)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-ass!) #t)
            (#t
             (let* ((n (begin (dk-peel!) (cadr (caddr (cadr (dk-goal))))))
                    (a (list 'RPOW n '(- 1 d))) (ph (list 'EULER-PHI n)) (rph (list 'recip ph)) (gv (n9-gv '(- 1 d) n)))
               (n9-facts! '(- 1 d) n)
               (dk-apply! (dk-ctx-form (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(<= 1 n) (list '<= (n9-gv '(- 1 d) 'n) b))))) n)
               (dk-have! (list '<= gv k) (lambda () (dk-ineq! (list '<= gv b) (list '<= b ab) (list 'IN gv 'RR) (list 'IN ab 'RR))))
               (dk-have! (list '<= 0 ph) (lambda () (dk-ineq! (list '<= 1 ph))))
               (dk-apply! (dk-cite! 'rr-mul-le-right gv k ph))
               (fact 'rr-recip-inverse ph)
               (dk-have! (list '<= 0 c) (lambda () (dk-ineq! (list '< 0 c))))
               (dk-type! (list '* k ph) 'RR)
               (let* ((va (dk-name! a 'RR)) (vr (dk-name! rph 'RR)) (vp (dk-name! ph 'RR)) (vc (dk-name! c 'RR)) (vk (dk-name! k 'RR)))
                 (dk-have! (list '= (list '* vp vr) 1) (lambda () (subst (list '= vp ph)) (subst (list '= vr rph)) (ass)))
                 (dk-have! (list '= (list '* vk vc) 1) (lambda () (subst (list '= vk k)) (subst (list '= vc c)) (ass)))
                 (dk-have! (list '<= (list '* (list '* va vr) vp) (list '* vk vp))
                   (lambda () (subst (list '= va a)) (subst (list '= vr rph)) (subst (list '= vp ph)) (subst (list '= vk k)) (ass)))
                 (dk-have! (list '<= va (list '* vk vp))
                   (lambda ()
                     (dk-have! (list '= (list '* (list '* va vr) vp) (list '* va (list '* vp vr))) (lambda () (crs)))
                     (dk-rewrite-h! (dk-rewrite-h! (list '<= (list '* (list '* va vr) vp) (list '* vk vp)) (list '* (list '* va vr) vp) (list '* va (list '* vp vr)))
                                    (list '* vp vr) 1)
                     (dk-have! (list '= (list '* va 1) va) (lambda () (crs)))
                     (dk-type! (list '* va 1) 'RR) (dk-type! (list '* vk vp) 'RR)
                     (dk-ineq! (list '<= (list '* va 1) (list '* vk vp)) (list '= (list '* va 1) va) (list 'IN (list '* va 1) 'RR) (list 'IN (list '* vk vp) 'RR))))
                 (dk-have! (list '<= 0 vc) (lambda () (subst (list '= vc c)) (ass)))
                 (dk-type! (list '* vk vp) 'RR)
                 (dk-apply! (dk-cite! 'rr-mul-le-right va (list '* vk vp) vc))
                 (subst (list '= a va)) (subst (list '= c vc)) (subst (list '= ph vp))
                 (dk-have! (list '= (list '* (list '* vk vp) vc) (list '* (list '* vk vc) vp)) (lambda () (crs)))
                 (dk-have! (list '= (list '* vc va) (list '* va vc)) (lambda () (crs)))
                 (for-each (lambda (t) (dk-type! t 'RR)) (list (list '* va vc) (list '* vc va) (list '* (list '* vk vp) vc) (list '* (list '* vk vc) vp)))
                 (dk-rewrite-h! (list '<= (list '* va vc) (list '* (list '* vk vp) vc)) (list '* (list '* vk vp) vc) (list '* (list '* vk vc) vp))
                 (dk-have! (list '= (list '* (list '* vk vc) vp) vp) (lambda () (subst (list '= (list '* vk vc) 1)) (crs)))
                 (dk-ineq! (list '<= (list '* va vc) (list '* (list '* vk vc) vp)) (list '= (list '* (list '* vk vc) vp) vp) (list '= (list '* vc va) (list '* va vc))
                           (list 'IN (list '* va vc) 'RR) (list 'IN (list '* vc va) 'RR) (list 'IN (list '* (list '* vk vc) vp) 'RR) (list 'IN vp 'RR)))))))))
(qed 'euler-phi-lower-bound)

;;; 0 < a, 0 < b reals: 0 < a b
(define (n9-pos-mul! a b)
  (let ((ab (list '* a b)))
    (dk-type! ab 'RR)
    (dk-have! (list '< 0 ab)
      (lambda ()
        (dk-have! (list 'AND (list 'IN ab 'RR) '(IN 0 RR)))
        (fact 'rr-leq-total ab 0)
        (ma-or-split! (list 'OR (list '<= ab 0) (list '<= 0 ab))
          (list (lambda ()
                  (n9-recip-facts! b)
                  (dk-have! (list '<= 0 (list 'recip b)) (lambda () (dk-ineq! (list '< 0 (list 'recip b)))))
                  (dk-apply! (dk-cite! 'rr-mul-le-right ab 0 (list 'recip b)))
                  (let ((vb (dk-name! (list 'recip b) 'RR)))
                    (dk-have! (list '= (list '* b vb) 1) (lambda () (subst (list '= vb (list 'recip b))) (ass)))
                    (dk-have! (list '= (list '* ab vb) a) (lambda () (dk-have! (list '= (list '* ab vb) (list '* a (list '* b vb))) (lambda () (crs)))
                                                                 (subst (list '= (list '* ab vb) (list '* a (list '* b vb)))) (subst (list '= (list '* b vb) 1)) (crs)))
                    (dk-have! (list '= (list '* 0 vb) 0) (lambda () (crs)))
                    (dk-type! (list '* ab vb) 'RR) (dk-type! (list '* 0 vb) 'RR)
                    (dk-rewrite-h! (dk-rewrite-h! (list '<= (list '* ab (list 'recip b)) (list '* 0 (list 'recip b))) (list 'recip b) vb) (list '* ab vb) a)
                    (n8-absurd! (list '<= a (list '* 0 vb)) (list '= (list '* 0 vb) 0) (list '< 0 a) (list 'IN (list '* 0 vb) 'RR))))
                (lambda ()
                  (dk-have! (list 'NOT (list '= ab 0))
                    (lambda ()
                      (di)
                      (n9-recip-facts! b)
                      (let ((vb (dk-name! (list 'recip b) 'RR)))
                        (dk-have! (list '= (list '* b vb) 1) (lambda () (subst (list '= vb (list 'recip b))) (ass)))
                        (dk-have! (list '= a 0) (lambda () (dk-have! (list '= a (list '* ab vb)) (lambda () (dk-have! (list '= (list '* ab vb) (list '* a (list '* b vb))) (lambda () (crs)))
                                                                                                    (subst (list '= (list '* ab vb) (list '* a (list '* b vb)))) (subst (list '= (list '* b vb) 1)) (crs)))
                                                            (subst (list '= a (list '* ab vb))) (subst (list '= ab 0)) (crs)))
                        (n8-absurd! (list '= a 0) (list '< 0 a)))))
                  (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases 0 ab))
                    (list (lambda () (ass))
                          (lambda () (dk-have! (list '= ab 0) (lambda () (subst (list '= ab 0)) (n9-rfl!)))
                                     (ma-prop-with! (list (list '= ab 0) (list 'NOT (list '= ab 0))))))))))))))

;;; PROPOSITION 1.25: for delta > 0 rational, n^(1 - delta) / phi(n) -> 0 (the sequence indexed from n = 1)
(define n9-seq '(VNB-LAMBDA phk_ NN (* (RPOW (succ phk_) (- 1 d)) (recip (EULER-PHI (succ phk_))))))
(sp (make-wff (list 'FORALL 'd (list 'IMPLIES '(IN d QQ) (list 'IMPLIES '(< 0 d) (list 'CONVERGES-TO 'RR-MS n9-seq 0))))))
(dk-peel!)
(fact 'qq-subset-rr 'd) (fact 'qq-one-in) (fact 'qq-zero-in) (dk-type! '(- 1 d) 'QQ) (fact 'rr-one-in) (fact 'rr-zero-in) (fact 'nn-zero-in)
(let* ((ed '(- 1 d)))
  (dk-have! (list 'IN n9-seq '(FUN NN RR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((z (dk-di-var!)) (sz (list 'succ z)))
            (fact 'nn-succ-closed z)
            (dk-have! (list '<= 1 sz) (lambda () (dk-nn!)))
            (n9-facts! ed sz) (ass)))
        (lambda () (fact 'nn-is-set) (dk-ass!)))))
  (dk-have! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'n_ (list 'AND '(IN n_ NN) (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN) (list 'IMPLIES '(<= n_ k_) (list '<= (list 'abs (list '- (list n9-seq 'k_) 0)) 'eps))))))))
    (lambda ()
      (let* ((eps (n8-di-pred!)))
        (dk-apply! (dk-cite! 'rr-pos-rr-in-rr) eps) (dk-apply! (dk-cite! 'rr-lt-of-pos-rr) eps)
        (dk-type! 2 'QQ) (fact 'qq-subset-rr 2)
        (dk-have! '(NOT (= 2 0)) (lambda () (di) (n8-absurd! '(= 2 0))))
        (dk-have! '(AND (IN 2 QQ) (NOT (= 2 0)))) (fact 'qq-recip-closed 2) (fact 'qq-recip-inverse 2)
        (dk-type! '(* d (recip 2)) 'QQ)
        (let* ((vt (dk-name! '(* d (recip 2)) 'QQ))
               (_0 (fact 'qq-subset-rr vt))
               (_1 (dk-have! (list '= 'd (list '* 2 vt))
                     (lambda () (subst (list '= vt '(* d (recip 2))))
                                (dk-have! '(= (* 2 (* d (recip 2))) (* d (* 2 (recip 2)))) (lambda () (crs)))
                                (subst '(= (* 2 (* d (recip 2))) (* d (* 2 (recip 2))))) (subst '(= (* 2 (recip 2)) 1)) (crs))))
               (_2 (dk-have! (list '< 0 vt) (lambda () (dk-ineq! (list '= 'd (list '* 2 vt)) '(< 0 d)))))
               (et (list '- 1 vt))
               (_3 (dk-type! et 'QQ))
               (b (dk-skolem! (dk-apply! (dk-cite! 'euler-phi-ratio-bounded) vt) #t))
               (ab (list 'abs b)) (kk (list '+ ab 1)) (re (list 'recip eps)) (z (list '* kk re))
               (rt (list 'recip vt)) (y (list 'RPOW z rt)))
          (fact 'rr-abs-closed b) (fact 'rr-abs-nonneg b) (fact 'rr-le-abs b)
          (dk-type! kk 'RR)
          (dk-have! (list '< 0 kk) (lambda () (dk-ineq! (list '<= 0 ab) (list 'IN ab 'RR))))
          (n9-recip-facts! eps)
          (n9-pos-mul! kk re)
          (dk-have! (list '= (list '* z 'eps) kk)
            (lambda () (dk-have! (list '= (list '* z 'eps) (list '* kk (list '* 'eps re))) (lambda () (crs)))
                       (subst (list '= (list '* z 'eps) (list '* kk (list '* 'eps re)))) (subst (list '= (list '* 'eps re) 1)) (crs)))
          (dk-have! (list 'NOT (list '= vt 0)) (lambda () (di) (n8-absurd! (list '= vt 0) (list '< 0 vt))))
          (dk-have! (list 'AND (list 'IN vt 'QQ) (list 'NOT (list '= vt 0)))) (fact 'qq-recip-closed vt) (fact 'qq-recip-inverse vt)
          (dk-have! (list 'AND (list 'IN z 'RR) (list '< 0 z)))
          (dk-split-all! (list (dk-apply! (dk-cite! 'rpow-pos) z rt)))
          (dk-apply! (dk-cite! 'rpow-pow) z rt vt)
          (dk-apply! (dk-cite! 'rpow-one) z)
          (dk-have! (list '= (list 'RPOW y vt) z)
            (lambda ()
              (subst (list '= (list 'RPOW y vt) (list 'RPOW z (list '* rt vt))))
              (dk-have! (list '= (list '* rt vt) 1) (lambda () (dk-have! (list '= (list '* rt vt) (list '* vt rt)) (lambda () (crs)))
                                                            (subst (list '= (list '* rt vt) (list '* vt rt))) (ass)))
              (subst (list '= (list '* rt vt) 1)) (ass)))
          (let ((n0 (dk-skolem! (dk-apply! (dk-cite! 'nn-unbounded-in-rr) y) #t)))
            (fact 'nn-in-rr n0)
            (ew n0)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (let* ((k (begin (dk-peel!) (cadr (cadr (cadr (cadr (dk-goal))))))) (n (list 'succ k))
                           (w (list 'RPOW n vt)) (rw (list 'recip w)) (gd (n9-gv ed n)) (gt (n9-gv et n)))
                      (fact 'nn-succ-closed k) (fact 'nn-in-rr k)
                      (dk-have! (list '<= 1 n) (lambda () (dk-nn!)))
                      (n9-facts! ed n) (n9-facts! et n)
                      (n9-gv-nonneg! ed n) (n9-gv-nonneg! et n)
                      (dk-have! (list '<= k n) (lambda () (dk-nn!)))
                      (dk-have! (list '<= y n) (lambda () (dk-ineq! (list '< y n0) (list '<= n0 k) (list '<= k n) (list 'IN y 'RR) (list 'IN n 'RR))))
                      ;; the sequence term
                      (dk-have! (list '= (list n9-seq k) gd) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (n9-rfl!)))))
                      (dk-have! (list '= (list '- gd 0) gd) (lambda () (crs)))
                      (subst (list '= (list n9-seq k) gd))
                      (subst (list '= (list '- gd 0) gd))
                      (subst (list '= (list 'abs gd) gd))
                      ;; gd = (1 / n^t) gt
                      (dk-have! (list 'AND (list 'IN n 'RR) (list '< 0 n)))
                      (dk-type! (list '- 0 vt) 'QQ)
                      (dk-apply! (dk-cite! 'rpow-add) n (list '- 0 vt) et)
                      (dk-apply! (dk-cite! 'rpow-neg) n vt)
                      (dk-split-all! (list (dk-apply! (dk-cite! 'rpow-pos) n vt)))
                      (n9-recip-facts! w)
                      (dk-have! (list '= gd (list '* rw gt))
                        (lambda ()
                          (dk-have! (list '= ed (list '+ (list '- 0 vt) et)) (lambda () (subst (list '= 'd (list '* 2 vt))) (crs)))
                          (subst (list '= ed (list '+ (list '- 0 vt) et)))
                          (subst (list '= (list 'RPOW n (list '+ (list '- 0 vt) et)) (list '* (list 'RPOW n (list '- 0 vt)) (list 'RPOW n et))))
                          (subst (list '= (list 'RPOW n (list '- 0 vt)) rw))
                          (let* ((v1 (dk-name! rw 'RR)) (v2 (dk-name! (list 'RPOW n et) 'RR)) (v3 (dk-name! (list 'recip (list 'EULER-PHI n)) 'RR)))
                            (subst (list '= rw v1)) (subst (list '= (list 'RPOW n et) v2)) (subst (list '= (list 'recip (list 'EULER-PHI n)) v3))
                            (crs))))
                      (subst (list '= gd (list '* rw gt)))
                      ;; n^t >= y^t = z, so K / n^t <= eps
                      (dk-have! (list 'AND (list 'IN y 'RR) (list '< 0 y)))
                      (dk-split-all! (list (dk-apply! (dk-cite! 'rpow-pos) y vt)))
                      (dk-have! (list '<= 0 vt) (lambda () (dk-ineq! (list '< 0 vt))))
                      (dk-have! (list 'AND (list 'IN n 'RR) (list '<= y n)))
                      (dk-have! (list 'AND (list 'IN vt 'QQ) (list '<= 0 vt)))
                      (dk-apply! (dk-cite! 'rpow-mono-base) y n vt)
                      (dk-have! (list '<= z w) (lambda () (dk-ineq! (list '<= (list 'RPOW y vt) w) (list '= (list 'RPOW y vt) z) (list 'IN (list 'RPOW y vt) 'RR) (list 'IN w 'RR) (list 'IN z 'RR))))
                      (dk-apply! (dk-ctx-form (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(<= 1 n) (list '<= (n9-gv et 'n) b))))) n)
                      (dk-have! (list '<= gt kk) (lambda () (dk-ineq! (list '<= gt b) (list '<= b ab) (list 'IN gt 'RR) (list 'IN ab 'RR))))
                      (dk-have! (list '<= 0 rw) (lambda () (dk-ineq! (list '< 0 rw))))
                      (dk-have! '(<= 0 eps) (lambda () (dk-ineq! '(< 0 eps))))
                      (dk-apply! (dk-cite! 'rr-mul-le-right gt kk rw))
                      (dk-apply! (dk-cite! 'rr-mul-le-right z w 'eps))
                      (dk-type! (list '* w 'eps) 'RR)
                      (dk-have! (list '<= kk (list '* w 'eps)) (lambda () (dk-type! (list '* z 'eps) 'RR)
                        (dk-ineq! (list '<= (list '* z 'eps) (list '* w 'eps)) (list '= (list '* z 'eps) kk) (list 'IN (list '* z 'eps) 'RR) (list 'IN (list '* w 'eps) 'RR))))
                      (dk-apply! (dk-cite! 'rr-mul-le-right kk (list '* w 'eps) rw))
                      (dk-have! (list '= (list '* (list '* w 'eps) rw) 'eps)
                        (lambda () (dk-have! (list '= (list '* (list '* w 'eps) rw) (list '* 'eps (list '* w rw))) (lambda () (crs)))
                                   (subst (list '= (list '* (list '* w 'eps) rw) (list '* 'eps (list '* w rw)))) (subst (list '= (list '* w rw) 1)) (crs)))
                      (dk-have! (list '= (list '* rw gt) (list '* gt rw)) (lambda () (crs)))
                      (for-each (lambda (t) (dk-type! t 'RR)) (list (list '* rw gt) (list '* gt rw) (list '* kk rw) (list '* (list '* w 'eps) rw)))
                      (dk-ineq! (list '= (list '* rw gt) (list '* gt rw)) (list '<= (list '* gt rw) (list '* kk rw)) (list '<= (list '* kk rw) (list '* (list '* w 'eps) rw))
                                (list '= (list '* (list '* w 'eps) rw) 'eps)
                                (list 'IN (list '* rw gt) 'RR) (list 'IN (list '* gt rw) 'RR) (list 'IN (list '* kk rw) 'RR) (list 'IN (list '* (list '* w 'eps) rw) 'RR)))))))))))
  (dk-apply! (dk-cite! 'rr-converges-to-abs) n9-seq 0)
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))
(qed 'euler-phi-ratio-limit)

