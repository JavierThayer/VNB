;;; la-z3-dsum.scm -- the direct sum of finitely many modules over one scalar ring is a
;;; module (LA-Z3, 2026-10-24).  Vocabulary: structure-library/la-z3-vocab (DIRECT-SUM,
;;; DSUM-VEC, DSUM-VADD, DSUM-VZERO, DSUM-VNEG, DSUM-ACT).  Prefix lzs-.
;;;
;;; PLAN.  An element of the sum is a function f on [1,n] with f(i) in VEC(F(i)), so a
;;; member of FUN([1,n], U) with U the union of the VEC(F(i)).  The operations are
;;; componentwise lambdas; each COMPUTES at an index (beta); each law of the sum is the
;;; law of F(i) at every index, by function extensionality (dk-fun-ext!).
;;;
;;; Destination theorem-library/.  Library: linear-algebra.  LOAD WINDOW: after
;;; structure-library/la-z3-vocab and theorem-library/lastcoeff-ideal-proof (the
;;; module-vector-ag companions); and after la-z3-quotient (lzq-vadd-comm, lzq-vzero-l,
;;; lzq-inv-r, lzq-inv-l).

(define (lzs-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z3-dsum: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'algebra))
(define (lzs-has-head? h e)
  (and (pair? e) (or (eq? (car e) h) (lzs-has-head? h (car e)) (lzs-has-head? h (cdr e)))))
(define LZS-IV '(INTERVAL 1 n))
(define LZS-U '(BIG-UNION dsk_ (INTERVAL 1 n) (VEC (F dsk_))))
(define LZS-V '(DSUM-VEC n F))
(define LZS-DS '(DIRECT-SUM S n F))
(define LZS-HM '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 n)) (IS-MODULE (F i_)))))
(define LZS-HS '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 n)) (= (SCAL (F i_)) S))))
(define (lzs-stmt body) (forall-guarded '(S n F) (list '(IS-RING S) '(IN n NN) LZS-HM LZS-HS) body))
(define (lzs-hdr!) (di) (di) (di) (di) (di))

;;; ---- membership of the carrier --------------------------------------------------------
(sp (make-wff (list 'FORALL 'n (list 'FORALL 'F (list '== LZS-V
  (list 'SEP 'dsv_ (list 'FUN LZS-IV LZS-U)
    '(FORALL dsj_ (IMPLIES (IN dsj_ (INTERVAL 1 n)) (IN (dsv_ dsj_) (VEC (F dsj_)))))))))))
(di)
(mac 'DSUM-VEC)
(qrfl)
(lzs-done! 'dsum-vec-unfold)

(sp (make-wff (list 'FORALL 'n (list 'FORALL 'F (list 'FORALL 'g_
  (list 'IMPLIES (list 'IN 'g_ (list 'FUN LZS-IV LZS-U))
    (list 'IMPLIES '(FORALL dsj_ (IMPLIES (IN dsj_ (INTERVAL 1 n)) (IN (g_ dsj_) (VEC (F dsj_)))))
      (list 'IN 'g_ LZS-V))))))))
(dk-peel!)
(mac 'DSUM-VEC)
(in-sep! (lambda () (ass)) (lambda () (ass)))
(lzs-done! 'dsum-vec-in)

(sp (make-wff (list 'FORALL 'n (list 'FORALL 'F (list 'FORALL 'g_
  (list 'IMPLIES (list 'IN 'g_ LZS-V)
    (list 'AND (list 'IN 'g_ (list 'FUN LZS-IV LZS-U))
      '(FORALL dsj_ (IMPLIES (IN dsj_ (INTERVAL 1 n)) (IN (g_ dsj_) (VEC (F dsj_))))))))))))
(dk-peel!)
(let* ((h (dk-landed-1 (lambda () (mac-h 'dsum-vec-unfold (list 'IN 'g_ LZS-V))))))
  (dk-landed (lambda () (sep-me h))))
(dk-conj-close! (lambda () (ass)))
(lzs-done! 'dsum-vec-out)

;;; x in VEC(F i), i in [1,n] => x in U
(sp (make-wff (list 'FORALL 'n (list 'FORALL 'F (forall-guarded '(i_ x_) (list '(IN i_ (INTERVAL 1 n)) '(IN x_ (VEC (F i_))))
  (list 'IN 'x_ LZS-U))))))
(dk-peel!)
(for-each (lambda (l) (dk-focus! l) (ass)) (dk-opened (lambda () (bu-mi 'i_))))
(lzs-done! 'dsum-in-union)

;;; ---- sethood of U and V --------------------------------------------------------------
(define (lzs-mod-at! i)                 ; IS-MODULE(F i) and SCAL(F i) = S, for i in [1,n] in context
  (dk-apply! LZS-HM i)
  (dk-apply! LZS-HS i))
(sp (make-wff (lzs-stmt (list 'IN LZS-U 'SET))))
(lzs-hdr!)
(for-each (lambda (l)
            (dk-focus! l)
            (let ((g (dk-goal)))
              (cond ((dk-asm? g) (ass))
                    ((and (dk-head-is? g 'IN) (equal? (cadr g) LZS-IV)) (fact 'interval-in-set 1 'n) (ass))
                    ((and (dk-head-is? g 'IN) (equal? (cadr g) LZS-IV)) (ass))
                    (#t (let* ((ld (dk-peel!))
                               (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) LZS-IV))) ld))))
                          (lzs-mod-at! i)
                          (fact 'lzq-vec-set (list 'F i))
                          (ass))))))
          (dk-opened (lambda () (bu-set))))
(lzs-done! 'dsum-union-set)

(sp (make-wff (lzs-stmt (list 'IN LZS-V 'SET))))
(lzs-hdr!)
(fact 'dsum-union-set 'S 'n 'F)
(fact 'interval-in-set 1 'n)
(mac 'DSUM-VEC)
(sep-set)
(if (not (proof-done? *ps*))
    (begin (mac 'fun-set-iff) (dk-conj-close! (lambda () (ass)))))
(lzs-done! 'dsum-vec-set)

;;; ---- a pointwise lambda on [1,n] lies in V --------------------------------------------
;;; goal (IN LAM V); TYPER, called with the index i, lands (IN B[i] (VEC (F i))) for the
;;; body after beta, and returns it.
(define (lzs-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
(define (lzs-lam-V! lam typer)
  (let ((pt (list 'FORALL 'dsj_ (list 'IMPLIES '(IN dsj_ (INTERVAL 1 n)) (list 'IN (list lam 'dsj_) '(VEC (F dsj_)))))))
    (dk-have! (list 'IN lam (list 'FUN LZS-IV LZS-U))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let* ((ld (dk-peel!))
                   (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) LZS-IV))) ld))))
              (lzs-beta!)
              (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                  (let* ((g (dk-goal)) (x (cadr g)))
                    (lzs-mod-at! i)
                    (typer i x)
                    (fact 'dsum-in-union 'n 'F i x)
                    (ass)))))
          (lambda () (fact 'interval-in-set 1 'n) (ass)))))
    (dk-have! pt
      (lambda ()
        (let* ((ld (dk-peel!))
               (i (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) LZS-IV))) ld))))
          (lzs-beta!)
          (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
              (let* ((g (dk-goal)) (x (cadr g)))
                (lzs-mod-at! i)
                (typer i x)
                (ass))))))
    (fact 'dsum-vec-in 'n 'F lam)
    (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))
;; f in V, i in [1,n] => (f i) in VEC(F i)
(define (lzs-pt! f i)
  (let ((want (list 'IN (list f i) (list 'VEC (list 'F i)))))
    (if (not (dk-asm? want))
        (let ((pt (list 'FORALL 'dsj_ (list 'IMPLIES '(IN dsj_ (INTERVAL 1 n)) (list 'IN (list f 'dsj_) '(VEC (F dsj_)))))))
          (if (not (dk-asm? pt)) (dk-split! (dk-cite! 'dsum-vec-out 'n 'F f)))
          (dk-apply! pt i)
          #t))))
;; f in V => f in FUN([1,n], U)
(define (lzs-fun! f)
  (let ((want (list 'IN f (list 'FUN LZS-IV LZS-U))))
    (if (not (dk-asm? want)) (dk-split! (dk-cite! 'dsum-vec-out 'n 'F f)))))

;;; ---- the operations are functions on V ---------------------------------------------
(define (lzs-pair-typer!)               ; lam-t typer of a destructuring lambda into V
  (lambda (inner-typer)
    (lambda ()
      (let* ((ld (dk-peel!))
             (g (dk-goal)))
        (lzs-lam-V! (cadr g) inner-typer)))))
(sp (make-wff (lzs-stmt (list 'IN '(DSUM-VZERO n F) LZS-V))))
(lzs-hdr!)
(mac 'DSUM-VZERO)
(lzs-lam-V! (dk--replace '(VNB-LAMBDA dsi_ (INTERVAL 1 n) (VZERO (F dsi_))) 'zzz 'zzz)
  (lambda (i x) (fact 'module-vzero-in (list 'F i))))
(lzs-done! 'dsum-vzero-in0)

(sp (make-wff (lzs-stmt (list 'IN '(DSUM-VADD n F) (list 'FUN (list 'CARTESIAN LZS-V LZS-V) LZS-V)))))
(lzs-hdr!)
(fact 'dsum-vec-set 'S 'n 'F)
(mac 'DSUM-VADD)
(dk-lam-type!
  (lambda ()
    (let* ((ld (dk-peel!))
           (fs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) LZS-V))) ld)))
           (g (dk-goal)))
      (lzs-lam-V! (cadr g)
        (lambda (i x)
          (for-each (lambda (f) (lzs-pt! f i)) fs)
          (fact 'module-vadd-type (list 'F i) (cadr x) (caddr x))))))
  (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
(lzs-done! 'dsum-vadd-fun0)

(sp (make-wff (lzs-stmt (list 'IN '(DSUM-VNEG n F) (list 'FUN LZS-V LZS-V)))))
(lzs-hdr!)
(fact 'dsum-vec-set 'S 'n 'F)
(mac 'DSUM-VNEG)
(dk-lam-type!
  (lambda ()
    (let* ((ld (dk-peel!))
           (fs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) LZS-V))) ld)))
           (g (dk-goal)))
      (lzs-lam-V! (cadr g)
        (lambda (i x)
          (for-each (lambda (f) (lzs-pt! f i)) fs)
          (fact 'module-vneg-type (list 'F i) (cadr x))))))
  (lambda () (ass)))
(lzs-done! 'dsum-vneg-fun0)

(sp (make-wff (lzs-stmt (list 'IN '(DSUM-ACT S n F) (list 'FUN (list 'CARTESIAN '(CARR S) LZS-V) LZS-V)))))
(lzs-hdr!)
(fact 'dsum-vec-set 'S 'n 'F)
(fact 'ring-carr-in-set 'S)
(mac 'DSUM-ACT)
(dk-lam-type!
  (lambda ()
    (let* ((ld (dk-peel!))
           (fs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) LZS-V))) ld)))
           (rs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(CARR S)))) ld)))
           (g (dk-goal)))
      (lzs-lam-V! (cadr g)
        (lambda (i x)
          (for-each (lambda (f) (lzs-pt! f i)) fs)
          (let ((r (cadr x)))
            (dk-have! (list 'IN r (list 'CARR (list 'SCAL (list 'F i))))
              (lambda () (subst (list '= (list 'SCAL (list 'F i)) 'S)) (ass)))
            (fact 'module-act-type (list 'F i) r (caddr x)))))))
  (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
(lzs-done! 'dsum-act-fun0)

;;; ---- the read-offs of the tuple --------------------------------------------------------
(define (lzs-components!)
  (let ((iff (dk-meta-iff! 'ring-class 'S)))
    (dk-meta-iff-l! iff)
    (fact 'membership-implies-sethood 'S 'RING))
  (fact 'dsum-vec-set 'S 'n 'F)
  (for-each (lambda (n) (fact n 'S 'n 'F)) '(dsum-vzero-in0 dsum-vadd-fun0 dsum-vneg-fun0 dsum-act-fun0)))
(define (lzs-read-off! name acc val)
  (sp (make-wff (lzs-stmt (list '== (list acc LZS-DS) val))))
  (lzs-hdr!)
  (lzs-components!)
  (slot acc)
  (mac 'DIRECT-SUM)
  (nth-r)
  (if (and (not (proof-done? *ps*)) (lzs-has-head? acc (dk-goal))) (slot acc))
  (if (not (proof-done? *ps*)) (qrfl))
  (lzs-done! name))
(lzs-read-off! 'dsum-ro-scal 'SCAL 'S)
(lzs-read-off! 'dsum-ro-vec 'VEC LZS-V)
(lzs-read-off! 'dsum-ro-vadd 'VADD '(DSUM-VADD n F))
(lzs-read-off! 'dsum-ro-vzero 'VZERO '(DSUM-VZERO n F))
(lzs-read-off! 'dsum-ro-vneg 'VNEG '(DSUM-VNEG n F))
(lzs-read-off! 'dsum-ro-act 'ACT '(DSUM-ACT S n F))
(define lzs-ro-names '(dsum-ro-scal dsum-ro-vec dsum-ro-vadd dsum-ro-vzero dsum-ro-vneg dsum-ro-act))
(define (lzs-readoffs!)
  (lzs-components!)
  (for-each (lambda (nm) (fact nm 'S 'n 'F)) lzs-ro-names))
(define (lzs-sub-acc! acc val) (subst (list '= (list acc LZS-DS) val)))

;;; ---- closure and computation at an index --------------------------------------------
(define LZS-VADD '(VADD (DIRECT-SUM S n F)))
(define LZS-VNEG '(VNEG (DIRECT-SUM S n F)))
(define LZS-ACT '(ACT (DIRECT-SUM S n F)))
(define LZS-VZERO '(VZERO (DIRECT-SUM S n F)))
(sp (make-wff (lzs-stmt (forall-guarded '(a_ b_) (list (list 'IN 'a_ LZS-V) (list 'IN 'b_ LZS-V))
  (list 'IN (list LZS-VADD 'a_ 'b_) LZS-V)))))
(dk-peel!)
(lzs-readoffs!)
(lzs-sub-acc! 'VADD '(DSUM-VADD n F))
(fact 'pair-in-cartesian LZS-V LZS-V 'a_ 'b_)
(fact 'fun-apply-type-c '(DSUM-VADD n F) (list 'CARTESIAN LZS-V LZS-V) LZS-V '(LIST a_ b_))
(fact 'apply-tupling-2 '(DSUM-VADD n F) 'a_ 'b_)
(subst '(= ((DSUM-VADD n F) a_ b_) ((DSUM-VADD n F) (LIST a_ b_))))
(ass)
(lzs-done! 'dsum-vadd-closed)
(sp (make-wff (lzs-stmt (forall-guarded '(a_) (list (list 'IN 'a_ LZS-V))
  (list 'IN (list LZS-VNEG 'a_) LZS-V)))))
(dk-peel!)
(lzs-readoffs!)
(lzs-sub-acc! 'VNEG '(DSUM-VNEG n F))
(fact 'fun-apply-type-c '(DSUM-VNEG n F) LZS-V LZS-V 'a_)
(ass)
(lzs-done! 'dsum-vneg-closed)
(sp (make-wff (lzs-stmt (forall-guarded '(r_ a_) (list '(IN r_ (CARR S)) (list 'IN 'a_ LZS-V))
  (list 'IN (list LZS-ACT 'r_ 'a_) LZS-V)))))
(dk-peel!)
(lzs-readoffs!)
(lzs-sub-acc! 'ACT '(DSUM-ACT S n F))
(fact 'pair-in-cartesian '(CARR S) LZS-V 'r_ 'a_)
(fact 'fun-apply-type-c '(DSUM-ACT S n F) (list 'CARTESIAN '(CARR S) LZS-V) LZS-V '(LIST r_ a_))
(fact 'apply-tupling-2 '(DSUM-ACT S n F) 'r_ 'a_)
(subst '(= ((DSUM-ACT S n F) r_ a_) ((DSUM-ACT S n F) (LIST r_ a_))))
(ass)
(lzs-done! 'dsum-act-closed)
(sp (make-wff (lzs-stmt (list 'IN LZS-VZERO LZS-V))))
(lzs-hdr!)
(lzs-readoffs!)
(lzs-sub-acc! 'VZERO '(DSUM-VZERO n F))
(ass)
(lzs-done! 'dsum-vzero-closed)

(define (lzs-at-close!)                 ; after beta: (= t t) with t a vector of some F(i)
  (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
      (let ((g (dk-goal)))
        (if (dk-asm? g) (ass)
            (rfl)))))
(sp (make-wff (lzs-stmt (forall-guarded '(a_ b_ i_) (list (list 'IN 'a_ LZS-V) (list 'IN 'b_ LZS-V) '(IN i_ (INTERVAL 1 n)))
  '(= (((VADD (DIRECT-SUM S n F)) a_ b_) i_) ((VADD (F i_)) (a_ i_) (b_ i_)))))))
(dk-peel!)
(lzs-readoffs!)
(lzs-mod-at! 'i_)
(lzs-pt! 'a_ 'i_) (lzs-pt! 'b_ 'i_)
(fact 'module-vadd-type '(F i_) '(a_ i_) '(b_ i_))
(lzs-sub-acc! 'VADD '(DSUM-VADD n F))
(mac 'DSUM-VADD)
(dk-lam-b!)
(lzs-at-close!)
(lzs-done! 'dsum-vadd-at)
(sp (make-wff (lzs-stmt (forall-guarded '(a_ i_) (list (list 'IN 'a_ LZS-V) '(IN i_ (INTERVAL 1 n)))
  '(= (((VNEG (DIRECT-SUM S n F)) a_) i_) ((VNEG (F i_)) (a_ i_)))))))
(dk-peel!)
(lzs-readoffs!)
(lzs-mod-at! 'i_)
(lzs-pt! 'a_ 'i_)
(fact 'module-vneg-type '(F i_) '(a_ i_))
(lzs-sub-acc! 'VNEG '(DSUM-VNEG n F))
(mac 'DSUM-VNEG)
(dk-lam-b!)
(lzs-at-close!)
(lzs-done! 'dsum-vneg-at)
(sp (make-wff (lzs-stmt (forall-guarded '(r_ a_ i_) (list '(IN r_ (CARR S)) (list 'IN 'a_ LZS-V) '(IN i_ (INTERVAL 1 n)))
  '(= (((ACT (DIRECT-SUM S n F)) r_ a_) i_) ((ACT (F i_)) r_ (a_ i_)))))))
(dk-peel!)
(lzs-readoffs!)
(lzs-mod-at! 'i_)
(lzs-pt! 'a_ 'i_)
(dk-have! '(IN r_ (CARR (SCAL (F i_)))) (lambda () (subst '(= (SCAL (F i_)) S)) (ass)))
(fact 'module-act-type '(F i_) 'r_ '(a_ i_))
(lzs-sub-acc! 'ACT '(DSUM-ACT S n F))
(mac 'DSUM-ACT)
(dk-lam-b!)
(lzs-at-close!)
(lzs-done! 'dsum-act-at)
(sp (make-wff (lzs-stmt (forall-guarded '(i_) '((IN i_ (INTERVAL 1 n)))
  '(= ((VZERO (DIRECT-SUM S n F)) i_) (VZERO (F i_)))))))
(dk-peel!)
(lzs-readoffs!)
(lzs-mod-at! 'i_)
(fact 'module-vzero-in '(F i_))
(lzs-sub-acc! 'VZERO '(DSUM-VZERO n F))
(mac 'DSUM-VZERO)
(dk-lam-b!)
(lzs-at-close!)
(lzs-done! 'dsum-vzero-at)

;;; =====================================================================
;;; The laws.
;;; =====================================================================
(define (lzs-vt! t)                      ; land (IN t V) for t built of DS operations
  (let ((want (list 'IN t LZS-V)))
    (cond ((dk-asm? want) #t)
          ((equal? t LZS-VZERO) (fact 'dsum-vzero-closed 'S 'n 'F))
          ((and (pair? t) (equal? (car t) LZS-VADD))
           (lzs-vt! (cadr t)) (lzs-vt! (caddr t)) (dk-cite! 'dsum-vadd-closed 'S 'n 'F (cadr t) (caddr t)))
          ((and (pair? t) (equal? (car t) LZS-VNEG))
           (lzs-vt! (cadr t)) (dk-cite! 'dsum-vneg-closed 'S 'n 'F (cadr t)))
          ((and (pair? t) (equal? (car t) LZS-ACT))
           (lzs-scal! (cadr t)) (lzs-vt! (caddr t)) (dk-cite! 'dsum-act-closed 'S 'n 'F (cadr t) (caddr t)))
          (#t (error "lzs-vt!: cannot type" (expression->string t))))))
(define (lzs-scal! t)
  (let ((want (list 'IN t '(CARR S))))
    (cond ((dk-asm? want) #t)
          ((and (pair? t) (equal? (car t) '(ADD S)))
           (lzs-scal! (cadr t)) (lzs-scal! (caddr t)) (dk-cite! 'ring-add-closed 'S (cadr t) (caddr t)))
          ((and (pair? t) (equal? (car t) '(MUL S)))
           (lzs-scal! (cadr t)) (lzs-scal! (caddr t)) (dk-cite! 'ring-carrier-closed-mul 'S (cadr t) (caddr t)))
          ((equal? t '(ONE S)) (dk-cite! 'ring-one-in 'S))
          (#t (error "lzs-scal!: cannot type" (expression->string t))))))
;; the innermost DS operation applied at the index v
(define (lzs-redex-at e v)
  (if (not (pair? e))
      #f
      (or (let loop ((xs e)) (cond ((not (pair? xs)) #f) ((lzs-redex-at (car xs) v)) (#t (loop (cdr xs)))))
          (and (= (length e) 2) (equal? (cadr e) v)
               (let ((h (car e)))
                 (cond ((equal? h LZS-VZERO) e)
                       ((and (pair? h) (member (car h) (list LZS-VADD LZS-VNEG LZS-ACT))) e)
                       (#t #f)))))))
(define (lzs-norm-at! v)
  (let loop ((fuel 40))
    (let ((rx (lzs-redex-at (dk-goal) v)))
      (if (and rx (> fuel 0))
          (let* ((h (car rx))
                 (eqn (cond ((equal? h LZS-VZERO) (dk-cite! 'dsum-vzero-at 'S 'n 'F v))
                            ((equal? (car h) LZS-VADD)
                             (lzs-vt! (cadr h)) (lzs-vt! (caddr h))
                             (dk-cite! 'dsum-vadd-at 'S 'n 'F (cadr h) (caddr h) v))
                            ((equal? (car h) LZS-VNEG)
                             (lzs-vt! (cadr h))
                             (dk-cite! 'dsum-vneg-at 'S 'n 'F (cadr h) v))
                            (#t
                             (lzs-scal! (cadr h)) (lzs-vt! (caddr h))
                             (dk-cite! 'dsum-act-at 'S 'n 'F (cadr h) (caddr h) v)))))
            (subst eqn)
            (loop (- fuel 1)))))))
(define (lzs-perms xs)
  (if (null? xs) '(())
      (append-map (lambda (x) (map (lambda (p) (cons x p)) (lzs-perms (delete x xs)))) xs)))
(define (lzs-law-leaf! lemmas)
  (let* ((lk (dk-peel!))
         (us (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'VEC LZS-DS)))) lk)))
         (ks (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'CARR (list 'SCAL LZS-DS))))) lk))))
    (for-each (lambda (u) (dk-have! (list 'IN u LZS-V) (lambda () (subst (list '= LZS-V (list 'VEC LZS-DS))) (ass)))) us)
    (for-each (lambda (r) (dk-have! (list 'IN r '(CARR S)) (lambda () (subst (list '= 'S (list 'SCAL LZS-DS))) (ass)))) ks)
    (if (lzs-has-head? 'SCAL (dk-goal)) (vnb-guard (lambda () (lzs-sub-acc! 'SCAL 'S))))
    (dk-conj-close!
      (lambda ()
        (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
          (dk-fun-ext! l r LZS-IV LZS-U
            (lambda () (lzs-vt! l) (lzs-fun! l) (ass))
            (lambda () (lzs-vt! r) (lzs-fun! r) (ass))
            (lambda (v)
              (lzs-mod-at! v)
              (lzs-norm-at! v)
              (for-each (lambda (u) (lzs-pt! u v)) us)
              (let ((sv (list 'SCAL (list 'F v))))
                (for-each (lambda (k) (dk-have! (list 'IN k (list 'CARR sv)) (lambda () (subst (list '= sv 'S)) (ass)))) ks)
                (if (dk--occurs? 'S (dk-goal)) (subst (list '= 'S sv)))
                (let ((atoms (map (lambda (u) (list u v)) us)))
                  (for-each (lambda (lm)
                              (for-each (lambda (pa)
                                          (for-each (lambda (pr)
                                                      (vnb-guard (lambda () (apply dk-cite! (car lm) (list 'F v) ((cdr lm) pa pr)))))
                                                    (lzs-perms ks)))
                                        (lzs-perms atoms)))
                            lemmas)
                  (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                      (lzs-close-chain!)))))))))))
;; close (= A B) by a chain of at most three context equations (either orientation), then rfl
(define (lzs-close-chain!)
  (let* ((leaf (proof-state-focus *ps*))
         (g (dk-goal)) (t1 (cadr g)) (t2 (caddr g))
         (eqs (filter (lambda (f) (dk-head-is? f '=)) (dk-asms)))
         (nbrs (lambda (t) (append (map caddr (filter (lambda (f) (equal? (cadr f) t)) eqs))
                                   (map cadr (filter (lambda (f) (equal? (caddr f) t)) eqs))))))
    (let ((path (let search ((t t1) (d 0) (seen (list t1)))
                  (cond ((equal? t t2) '())
                        ((> d 2) #f)
                        (#t (let try ((ns (nbrs t)))
                              (cond ((null? ns) #f)
                                    ((member (car ns) seen) (try (cdr ns)))
                                    (#t (let ((p (search (car ns) (+ d 1) (cons (car ns) seen))))
                                          (if p (cons (cons t (car ns)) p) (try (cdr ns))))))))))))
      (if (not path) (error "lzs-close-chain!: no chain from" (expression->string t1) 'to (expression->string t2)))
      (for-each (lambda (st) (if (not (sequent-node-grounded? leaf)) (subst (list '= (car st) (cdr st))))) path)
      (if (not (sequent-node-grounded? leaf)) (rfl)))))
(define (lzs-qlaw! name conj unfold lemmas)
  (sp (make-wff (lzs-stmt conj)))
  (lzs-hdr!)
  (lzs-readoffs!)
  (for-each (lambda (nm) (fact nm 'S 'n 'F)) lzs-acc-typings)
  (if unfold (mac unfold))
  (dk-conj-close! (lambda () (lzs-law-leaf! lemmas)))
  (lzs-done! name))

(define (lzs-simple! name conj closer)
  (sp (make-wff (lzs-stmt conj)))
  (lzs-hdr!)
  (lzs-readoffs!)
  (for-each (lambda (acc val) (if (lzs-has-head? acc (dk-goal)) (lzs-sub-acc! acc val)))
            '(SCAL VEC VADD VZERO VNEG ACT)
            (list 'S LZS-V '(DSUM-VADD n F) '(DSUM-VZERO n F) '(DSUM-VNEG n F) '(DSUM-ACT S n F)))
  (closer)
  (lzs-done! name))
(lzs-simple! 'dsum-length '(= (LENGTH (DIRECT-SUM S n F)) 6)
  (lambda () (mac 'DIRECT-SUM) (len-r) (if (not (proof-done? *ps*)) (arith))))
(lzs-simple! 'dsum-scal-ring '(IS-RING (SCAL (DIRECT-SUM S n F))) (lambda () (ass)))
(lzs-simple! 'dsum-vec-set2 '(IN (VEC (DIRECT-SUM S n F)) SET) (lambda () (ass)))
(lzs-simple! 'dsum-vzero-in '(IN (VZERO (DIRECT-SUM S n F)) (VEC (DIRECT-SUM S n F))) (lambda () (ass)))
(lzs-simple! 'dsum-vadd-fun
  '(IN (VADD (DIRECT-SUM S n F)) (FUN (CARTESIAN (VEC (DIRECT-SUM S n F)) (VEC (DIRECT-SUM S n F))) (VEC (DIRECT-SUM S n F))))
  (lambda () (ass)))
(lzs-simple! 'dsum-vneg-fun
  '(IN (VNEG (DIRECT-SUM S n F)) (FUN (VEC (DIRECT-SUM S n F)) (VEC (DIRECT-SUM S n F))))
  (lambda () (ass)))
(lzs-simple! 'dsum-act-fun
  '(IN (ACT (DIRECT-SUM S n F)) (FUN (CARTESIAN (CARR (SCAL (DIRECT-SUM S n F))) (VEC (DIRECT-SUM S n F))) (VEC (DIRECT-SUM S n F))))
  (lambda () (ass)))
(define lzs-acc-typings '(dsum-scal-ring dsum-vec-set2 dsum-vzero-in dsum-vadd-fun dsum-vneg-fun dsum-act-fun))

(define LZSV '(VEC (DIRECT-SUM S n F)))
(define LZSC '(CARR (SCAL (DIRECT-SUM S n F))))
(lzs-qlaw! 'dsum-assoc (list 'is-associative LZS-VADD LZSV) 'is-associative
  (list (cons 'abelian-group-assoc-module-vector-ag (lambda (as rs) as))))
(lzs-qlaw! 'dsum-comm (list 'is-commutative LZS-VADD LZSV) 'is-commutative
  (list (cons 'lzq-vadd-comm (lambda (as rs) as))))
(lzs-qlaw! 'dsum-identity (list 'is-identity LZS-VADD LZS-VZERO LZSV) 'is-identity
  (list (cons 'lzq-vzero-l (lambda (as rs) as)) (cons 'abelian-group-right-id-module-vector-ag (lambda (as rs) as))))
(lzs-qlaw! 'dsum-inverses (list 'has-inverses LZS-VADD LZS-VZERO LZS-VNEG LZSV) 'has-inverses
  (list (cons 'lzq-inv-l (lambda (as rs) as)) (cons 'lzq-inv-r (lambda (as rs) as))))
(lzs-qlaw! 'dsum-act-distrib-vec
  (list 'FORALL 'r_ (list 'IMPLIES (list 'IN 'r_ LZSC)
    (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ LZSV) (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ LZSV)
      (list '= (list LZS-ACT 'r_ (list LZS-VADD 'x_ 'y_)) (list LZS-VADD (list LZS-ACT 'r_ 'x_) (list LZS-ACT 'r_ 'y_)))))))))
  #f (list (cons 'module-act-distrib-vec (lambda (as rs) (append rs as)))))
(lzs-qlaw! 'dsum-act-distrib-scalar
  (list 'FORALL 'r_ (list 'IMPLIES (list 'IN 'r_ LZSC)
    (list 'FORALL 's_ (list 'IMPLIES (list 'IN 's_ LZSC) (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ LZSV)
      (list '= (list LZS-ACT '((ADD (SCAL (DIRECT-SUM S n F))) r_ s_) 'x_) (list LZS-VADD (list LZS-ACT 'r_ 'x_) (list LZS-ACT 's_ 'x_)))))))))
  #f (list (cons 'module-act-distrib-scalar (lambda (as rs) (append rs as)))))
(lzs-qlaw! 'dsum-act-mul-compat
  (list 'FORALL 'r_ (list 'IMPLIES (list 'IN 'r_ LZSC)
    (list 'FORALL 's_ (list 'IMPLIES (list 'IN 's_ LZSC) (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ LZSV)
      (list '= (list LZS-ACT '((MUL (SCAL (DIRECT-SUM S n F))) r_ s_) 'x_) (list LZS-ACT 'r_ (list LZS-ACT 's_ 'x_)))))))))
  #f (list (cons 'module-act-mul-compat (lambda (as rs) (append rs as)))))
(lzs-qlaw! 'dsum-act-unital
  (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ LZSV)
     (list '= (list LZS-ACT '(ONE (SCAL (DIRECT-SUM S n F))) 'x_) 'x_)))
  #f (list (cons 'module-act-unital (lambda (as rs) as))))

;;; THE DIRECT SUM.
(sp (make-wff (lzs-stmt '(IS-MODULE (DIRECT-SUM S n F)))))
(lzs-hdr!)
(for-each (lambda (nm) (fact nm 'S 'n 'F))
  '(dsum-length dsum-scal-ring dsum-vec-set2 dsum-vadd-fun dsum-vzero-in dsum-vneg-fun dsum-act-fun
    dsum-assoc dsum-comm dsum-identity dsum-inverses
    dsum-act-distrib-vec dsum-act-distrib-scalar dsum-act-mul-compat dsum-act-unital))
(mac 'IS-MODULE)
(dk-conj-close! (lambda () (ass)))
(lzs-done! 'direct-sum-is-module)
(gloss! 'direct-sum-is-module "The direct sum of finitely many modules F(1), ..., F(n) over one scalar ring, with the operations taken componentwise, is a module.")

;;; ---- the members of the direct sum, packaged for use elsewhere -----------------------
(sp (make-wff (lzs-stmt (list 'FORALL 'g_ (list 'IMPLIES '(IN g_ (FUN (INTERVAL 1 n)))
  (list 'IMPLIES '(FORALL dsj_ (IMPLIES (IN dsj_ (INTERVAL 1 n)) (IN (g_ dsj_) (VEC (F dsj_)))))
    (list 'IN 'g_ LZSV)))))))
(dk-peel!)
(lzs-readoffs!)
(lzs-sub-acc! 'VEC LZS-V)
(let ((pt '(FORALL dsj_ (IMPLIES (IN dsj_ (INTERVAL 1 n)) (IN (g_ dsj_) (VEC (F dsj_)))))))
  (dk-have! (list 'IN 'g_ (list 'FUN LZS-IV LZS-U))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (let* ((ld (dk-peel!)) (i (cadr (car ld))))
                (dk-apply! pt i)
                (fact 'dsum-in-union 'n 'F i (list 'g_ i))
                (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))))))
  (fact 'dsum-vec-in 'n 'F 'g_)
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))
(lzs-done! 'dsum-member-intro)
(gloss! 'dsum-member-intro "A function g on [1,n] with g(i) a vector of F(i) for every i is a vector of the direct sum.")

(sp (make-wff (lzs-stmt (forall-guarded '(g_ i_) (list (list 'IN 'g_ LZSV) '(IN i_ (INTERVAL 1 n)))
  '(IN (g_ i_) (VEC (F i_)))))))
(dk-peel!)
(lzs-readoffs!)
(dk-have! (list 'IN 'g_ LZS-V) (lambda () (subst (list '= LZS-V LZSV)) (ass)))
(lzs-pt! 'g_ 'i_)
(ass)
(lzs-done! 'dsum-member-elim)

(sp (make-wff (lzs-stmt (forall-guarded '(g_ h_) (list (list 'IN 'g_ LZSV) (list 'IN 'h_ LZSV)
    '(FORALL dsj_ (IMPLIES (IN dsj_ (INTERVAL 1 n)) (= (g_ dsj_) (h_ dsj_)))))
  '(= g_ h_)))))
(dk-peel!)
(lzs-readoffs!)
(dk-have! (list 'IN 'g_ LZS-V) (lambda () (subst (list '= LZS-V LZSV)) (ass)))
(dk-have! (list 'IN 'h_ LZS-V) (lambda () (subst (list '= LZS-V LZSV)) (ass)))
(lzs-fun! 'g_) (lzs-fun! 'h_)
(dk-fun-ext! 'g_ 'h_ LZS-IV LZS-U #f #f
  (lambda (v) (dk-apply! '(FORALL dsj_ (IMPLIES (IN dsj_ (INTERVAL 1 n)) (= (g_ dsj_) (h_ dsj_)))) v) (ass)))
(lzs-done! 'dsum-ext)
(gloss! 'dsum-ext "Two vectors of a direct sum with the same components are equal.")
