        (ca6x-and! (list '<= 0 d) (list 'NOT (list '= 0 d)))
        (dk-cite! 'rr-le-ne-lt 0 d)
        (dk-cite! 'rr-recip-pos d)
        (ca6x-rr! rd)
        (dk-cite! 'rr-recip-antitone rd bm)
        (dk-cite! 'rr-recip-recip-pos 'hdm_)
        (dk-cite! 'rr-recip-recip-pos d)
        (let* ((a1 (dk-ctx-form (list '<= (list 'recip bm) (list 'recip rd))))
               (a2 (dk-rewrite-h! a1 (list 'recip bm) 'hdm_)))
          (dk-rewrite-h! a2 (list 'recip rd) d)
          (if (pair? (dk-open-leaves)) (ass)))))))
(qed 'cc-hurwitz-disc-bound)
;;; ======================================================================
;;; (8) A GAP ON THE CIRCLE: f holomorphic on u, the disc B(c, R) inside u, f /= a on B(c, R)
;;;     except perhaps at c: some m > 0 has m <= |f - a| on the circle of radius r < R
;;;     (1/(f - a) is holomorphic, so continuous, on the punctured disc, and bounded on the
;;;     compact trace: cc-exhaust-exhaustive, cc-continuous-bounded-on-exhaust)
;;; ======================================================================
;; the context's copy of F, or an error naming F
(define (ca6-ctx f) (or (dk-ctx-form f) (error "ca6-ctx: not in context" (expression->string f))))
;; NOT w0 = 0, w0 in CC in context: land 0 < |w0|
(define (ca6-mag-pos! w0)
  (let ((d (list 'magnitude w0)))
    (ca6x-rr! d)
    (dk-cite! 'cc-magnitude-nonneg w0)
    (let ((zi (dk-cite! 'cc-magnitude-zero-iff w0)))
      (dk-have! (list 'NOT (list '= 0 d))
        (lambda ()
          (di)
          (dk-have! (list '= d 0) (lambda () (subst (list '= d 0)) (rfl)))
          (ca6x-only-prop! zi (list '= d 0) (list 'NOT (list '= w0 0))))))
    (ca6x-and! (list '<= 0 d) (list 'NOT (list '= 0 d)))
    (dk-cite! 'rr-le-ne-lt 0 d)))
;; y in DIFFERENCE(bb, {c}) in context: land y in bb and NOT y = c
(define (ca6-punct-out! y bb c)
  (let* ((vv (list 'DIFFERENCE bb (list 'SINGLETON c)))
         (di (dk-cite! 'difference-membership bb (list 'SINGLETON c) y))
         (si (dk-cite! 'singleton-membership c y)))
    (fact 'membership-implies-sethood y vv)
    (dk-have! (list 'IN y bb) (lambda () (ca6x-only-prop! di (list 'IN y vv))))
    (dk-have! (list 'NOT (list '= y c)) (lambda () (ca6x-only-prop! di si (list 'IN y vv) (list 'IN y 'SET))))))
;; y in bb, NOT y = c in context: land y in DIFFERENCE(bb, {c})
(define (ca6-punct-in! y bb c)
  (let* ((vv (list 'DIFFERENCE bb (list 'SINGLETON c)))
         (di (dk-cite! 'difference-membership bb (list 'SINGLETON c) y))
         (si (dk-cite! 'singleton-membership c y)))
    (dk-have! (list 'IN y vv) (lambda () (ca6x-only-prop! di si (list 'IN y bb) (list 'NOT (list '= y c)))))))

(define ca6-M-ne '(FORALL hdy_ (IMPLIES (IN hdy_ (BALL CC-MS c hdq_)) (IMPLIES (NOT (= hdy_ c)) (NOT (= (f hdy_) hda_))))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(HOLOMORPHIC-ON u f)
  (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'r (ca6-imps '((IN r RR) (< 0 r))
    (list 'FORALL 'hdq_ (ca6-imps '((IN hdq_ RR) (< r hdq_) (SUBSET (BALL CC-MS c hdq_) u))
      (list 'FORALL 'hda_ (ca6-imps (list '(IN hda_ CC) ca6-M-ne)
        (list 'FORSOME 'hdm_ (list 'AND '(IN hdm_ RR) (list 'AND '(< 0 hdm_)
          (list 'FORALL 'hdy_ (list 'IMPLIES (list 'IN 'hdy_ (ca6-tr 'c 'r)) '(<= hdm_ (magnitude (- (f hdy_) hda_)))))))))))))))))))))
(dk-peel!)
(fact 'holomorphic-on-open 'u 'f) (fact 'holomorphic-on-in-fun 'u 'f) (fact 'cc-open-subset-cc 'u)
(dk-have! '(< 0 hdq_) (lambda () (dk-ineq! '(< 0 r) '(< r hdq_))))
(dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
(let* ((bb (ca6-disc! 'c 'hdq_))
       (vv (list 'DIFFERENCE bb '(SINGLETON c)))
       (qq (list 'VNB-LAMBDA 'hdz_ vv '(recip (- (f hdz_) hda_))))
       (tr (ca6-tr 'c 'r))
       (nz (list 'FORALL 'hdy_ (list 'IMPLIES (list 'IN 'hdy_ vv) '(NOT (= (- (f hdy_) hda_) 0))))))
  (dk-cite! 'cif-open-minus-point bb 'c)
  (fact 'cc-open-subset-cc vv)
  (dk-have! (list 'FORALL 'dkdoy_ (list 'IMPLIES (list 'IN 'dkdoy_ vv) '(IN dkdoy_ u)))
    (lambda () (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*))) (ca6-punct-out! y bb 'c) (fact 'subset-mem-fwd bb 'u y) (ca6-fin! leaf))))
  (dk-have! nz
    (lambda ()
      (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*)))
        (ca6-punct-out! y bb 'c)
        (fact 'subset-mem-fwd bb 'u y) (fact 'fun-apply-type-c 'f 'u 'CC y)
        (ca6-apply! (ca6-ctx ca6-M-ne) y)
        (ca6-sub-ne! (list 'f y) 'hda_)
        (ca6-fin! leaf))))
  (dk-have! (list 'HOLOMORPHIC-ON vv qq) (lambda () (dk-holomorphic! vv qq)))
  (dk-cite! 'holomorphic-on-continuous vv qq)
  (dk-cite! 'holomorphic-on-in-fun vv qq)
  (dk-cite! 'circle-is-road 'c 'r)
  (fact 'is-road-is-path '(CIRCLE-PATH c r) '(CIRCLE-DERIV c r) 0 '(* 2 PI))
  (dk-cite! 'path-trace-compact '(CIRCLE-PATH c r) 0 '(* 2 PI))
  (dk-have! (list 'SUBSET tr vv)
    (lambda ()
      (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
        (dk-split! (dk-cite! 'circle-trace-in-punctured-ball 'c 'r 'hdq_ y))
        (ca6-punct-in! y bb 'c)
        (ca6-fin! leaf))))
  (let* ((n (dk-skolem! (dk-cite! 'cc-exhaust-exhaustive vv tr)))
         (kn (list 'CC-EXHAUST vv n)))
    (dk-split-all!)
    (let* ((bm (dk-skolem! (dk-cite! 'cc-continuous-bounded-on-exhaust vv qq n)))
           (bcl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm bm) (dk-contains? fm 'CC-EXHAUST))) "the bound"))
           (b1 (list '+ bm 1))
           (mm (list 'recip b1)))
      (dk-split-all!)
      (ca6x-rr! b1)
      (dk-have! (list '< 0 b1) (lambda () (dk-ineq! (list '<= 0 bm))))
      (ca6x-rr! mm)
      (dk-cite! 'rr-recip-pos b1)
      (ew mm)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*))
                     (w (list '- (list 'f y) 'hda_)) (d (list 'magnitude w)) (rd (list 'recip d)))
                (fact 'subset-mem-fwd tr vv y) (fact 'subset-mem-fwd tr kn y)
                (ca6-punct-out! y bb 'c)
                (fact 'subset-mem-fwd bb 'u y) (fact 'fun-apply-type-c 'f 'u 'CC y)
                (ca6x-cc! w)
                (ca6-apply! (ca6-ctx nz) y)
                (ca6x-cc! (list 'recip w))
                (ca6-apply! bcl y)
                (dk-have! (list '= (list qq y) (list 'recip w)) (lambda () (let ((lf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? lf)) (rfl)))))
                (let* ((h1 (dk-rewrite-h! (list '<= (list 'magnitude (list qq y)) bm) (list qq y) (list 'recip w))))
                  (dk-cite! 'aif-magnitude-recip w)
                  (dk-rewrite-h! h1 (list 'magnitude (list 'recip w)) rd))
                (ca6-mag-pos! w)
                (dk-cite! 'rr-recip-pos d)
                (ca6x-rr! rd)
                (dk-have! (list '<= rd b1) (lambda () (dk-ineq! (list '<= rd bm))))
                (dk-cite! 'rr-recip-antitone rd b1)
                (dk-cite! 'rr-recip-recip-pos d)
                (dk-rewrite-h! (list '<= mm (list 'recip rd)) (list 'recip rd) d)
                (ca6-fin! leaf))))))))
(qed 'cc-hurwitz-circle-gap)
;;; ======================================================================
;;; (9) THE LOCAL HURWITZ THEOREM: f_k -> f uniformly on compacta, f(c) = a, and f /= a near c
;;;     except at c: for every r > 0, for all large k, f_k takes the value a in B(c, r) (inside u).
;;;     The elementary route: a circle about c on which |f - a| >= m > 0 (8); |f_k - f| <= m/4
;;;     there and at c for large k; if f_k /= a near c, the minimum modulus (7) gives
;;;     |f_k(c) - a| >= 3m/4, against |f_k(c) - a| = |f_k(c) - f(c)| <= m/4.
;;; ======================================================================
(define ca6-L-ne '(FORALL hzx_ (IMPLIES (IN hzx_ u) (IMPLIES (IN hzx_ (BALL CC-MS hzc_ hzp_)) (IMPLIES (NOT (= hzx_ hzc_)) (NOT (= (f hzx_) hza_)))))))
(define ca6-L-concl
  '(FORSOME hzn_ (AND (IN hzn_ NN)
     (FORALL hzk_ (IMPLIES (IN hzk_ NN) (IMPLIES (<= hzn_ hzk_)
       (FORSOME hzz_ (AND (IN hzz_ u) (AND (IN hzz_ (BALL CC-MS hzc_ hzr_)) (= ((s hzk_) hzz_) hza_))))))))))
;; the members of s are holomorphic on u, and so is the limit f
(define (ca6-hol-limit! s0 f0)
  (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'HOLOMORPHIC-ON 'u (list s0 'k))))
    (lambda ()
      (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*)))
        (fact 'fun-apply-type-c s0 'NN ca6-H k)
        (ca6-hol! (list s0 k))
        (ca6-fin! leaf))))
  (dk-cite! 'holomorphic-limit-on-compacta 'u s0 f0))
;; x in BALL(CC-MS, c, q), q <= p in context: x in BALL(CC-MS, c, p)
(define (ca6-ball-sub! c q p)
  (dk-cite! 'cc-ms-ball-mono c q p))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ca6-nfm 'u)
  (list 'FORALL 's (list 'IMPLIES (list 'IN 's (list 'FUN 'NN ca6-H))
    (list 'FORALL 'f (ca6-imps '((IN f (FUN u CC)) (UNIF-ON-COMPACTA u s f))
      (list 'FORALL 'hza_ (list 'IMPLIES '(IN hza_ CC)
        (list 'FORALL 'hzc_ (ca6-imps '((IN hzc_ u) (= (f hzc_) hza_))
          (list 'FORALL 'hzp_ (ca6-imps (list '(IN hzp_ RR) '(< 0 hzp_) ca6-L-ne)
            (list 'FORALL 'hzr_ (ca6-imps '((IN hzr_ RR) (< 0 hzr_)) ca6-L-concl))))))))))))))))
(dk-peel!)
(ca6-open-facts!)
(ca6-sty! 's)
(ca6-hol-limit! 's 'f)
(fact 'subset-mem-fwd 'u 'CC 'hzc_)
(fact 'fun-apply-type-c 'f 'u 'CC 'hzc_)
(let* ((rho1 (ca6v-open-ball! 'hzc_)))
  (fact 'rr-pos-rr-in-rr rho1) (fact 'rr-lt-of-pos-rr rho1)
  (let* ((w1 (dk-skolem! (dk-cite! 'rr-min-pos rho1 'hzp_)))
         (w2 (begin (dk-split-all!) (dk-skolem! (dk-cite! 'rr-min-pos w1 'hzr_))))
         (qq w2) (rho (list '* 1/2 w2))
         (bq (list 'BALL 'CC-MS 'hzc_ qq))
         (tr (ca6-tr 'hzc_ rho)))
    (dk-split-all!)
    (ca6x-rr! rho)
    (dk-have! (list '< 0 rho) (lambda () (dk-ineq! (list '< 0 w2))))
    (dk-have! (list '< rho qq) (lambda () (dk-ineq! (list '< 0 w2))))
    (dk-have! (list '<= qq rho1) (lambda () (dk-ineq! (list '<= w2 w1) (list '<= w1 rho1))))
    (dk-have! (list '<= qq 'hzp_) (lambda () (dk-ineq! (list '<= w2 w1) (list '<= w1 'hzp_))))
    (ca6-ball-sub! 'hzc_ qq rho1)
    (fact 'subset-trans bq (list 'BALL 'CC-MS 'hzc_ rho1) 'u)
    (ca6-ball-sub! 'hzc_ qq 'hzp_)
    (ca6-ball-sub! 'hzc_ qq 'hzr_)
    ;; f /= a on the punctured disc B(c, q)
    (dk-have! (list 'FORALL 'hdy_ (list 'IMPLIES (list 'IN 'hdy_ bq) '(IMPLIES (NOT (= hdy_ hzc_)) (NOT (= (f hdy_) hza_)))))
      (lambda ()
        (let* ((y (dk-di-var!)))
          (dk-peel!)
          (let ((leaf (proof-state-focus *ps*)))
            (fact 'subset-mem-fwd bq 'u y)
            (fact 'subset-mem-fwd bq (list 'BALL 'CC-MS 'hzc_ 'hzp_) y)
            (ca6-apply! (ca6-ctx ca6-L-ne) y)
            (ca6-fin! leaf)))))
    (let* ((mm (dk-skolem! (dk-cite! 'cc-hurwitz-circle-gap 'u 'f 'hzc_ rho qq 'hza_)))
           (e (list '* 1/4 mm)) (m3 (list '* 3/4 mm)))
      (dk-split-all!)
      (ca6x-rr! e) (ca6x-rr! m3)
      (dk-have! (list '< 0 e) (lambda () (dk-ineq! (list '< 0 mm))))
      (dk-have! (list '< 0 m3) (lambda () (dk-ineq! (list '< 0 mm))))
      (dk-cite! 'rr-pos-rr-of-lt e)
      ;; the circle: compact, inside the disc
      (dk-cite! 'circle-is-road 'hzc_ rho)
      (fact 'is-road-is-path (list 'CIRCLE-PATH 'hzc_ rho) (list 'CIRCLE-DERIV 'hzc_ rho) 0 '(* 2 PI))
      (dk-cite! 'path-trace-compact (list 'CIRCLE-PATH 'hzc_ rho) 0 '(* 2 PI))
      (dk-have! (list 'SUBSET tr 'u)
        (lambda ()
          (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
            (dk-split! (dk-cite! 'circle-trace-in-punctured-ball 'hzc_ rho qq y))
            (fact 'subset-mem-fwd bq 'u y)
            (ca6-fin! leaf))))
      ;; a compact K_n0 holding c
      (let* ((n0 (dk-skolem! (dk-cite! 'cc-exhaust-covers 'u 'hzc_)))
             (k0 (list 'CC-EXHAUST 'u n0)))
        (dk-split-all!)
        (dk-cite! 'cc-exhaust-subset 'u n0)
        (dk-cite! 'cc-exhaust-compact 'u n0)
        (let* ((n1 (ca6-unif-tail! 's 'f tr e))
               (sp1 (dk-split-all!))
               (t1 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm n1))) "the tail on the circle"))
               (n2 (ca6-unif-tail! 's 'f k0 e))
               (sp2 (dk-split-all!))
               (t2 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm n2))) "the tail on K_n0"))
               (nn (list '+ n1 n2)))
          (ca6x-and! (list 'IN n1 'NN) (list 'IN n2 'NN))
          (fact 'nn-add-closed n1 n2)
          (ew nn)
          (dk-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal))
                  (ass)
                  (let* ((lk (dk-peel!)) (k (ca6-in-of lk 'NN))
                         (sk (list 's k))
                         (neg (car (filter (dk-head? 'NOT) (dk-landed (lambda () (pbc)))))))
                    (dk-have! (list '<= n1 k) (lambda () (dk-nn! (list '<= nn k))))
                    (dk-have! (list '<= n2 k) (lambda () (dk-nn! (list '<= nn k))))
                    (fact 'fun-apply-type-c 's 'NN ca6-H k)
                    (ca6-hol! sk)
                    ;; f_k /= a on the disc B(c, q)
                    (dk-have! (list 'FORALL 'hdy_ (list 'IMPLIES (list 'IN 'hdy_ bq) (list 'NOT (list '= (list sk 'hdy_) 'hza_))))
                      (lambda ()
                        (let* ((y (dk-di-var!)))
                          (di)
                          (fact 'subset-mem-fwd bq 'u y)
                          (fact 'subset-mem-fwd bq '(BALL CC-MS hzc_ hzr_) y)
                          (dk-have! (cadr neg)
                            (lambda () (ew y) (dk-conj-close! dk-ass!)))
                          (ca6x-only-prop! neg (cadr neg)))))
                    ;; m3 <= |f_k - a| on the circle
                    (dk-have! (list 'FORALL 'hdy_ (list 'IMPLIES (list 'IN 'hdy_ tr) (list '<= m3 (list 'magnitude (list '- (list sk 'hdy_) 'hza_)))))
                      (lambda ()
                        (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*))
                               (fy (list 'f y)) (sy (list sk y)))
                          (fact 'subset-mem-fwd tr 'u y) (fact 'subset-mem-fwd 'u 'CC y)
                          (fact 'fun-apply-type-c 'f 'u 'CC y)
                          (ca6-sval! 's k y)
                          (ca6-apply! (ca6-ctx (list 'FORALL 'hdy_ (list 'IMPLIES (list 'IN 'hdy_ tr) (list '<= mm '(magnitude (- (f hdy_) hza_)))))) y)
                          (ca6-apply! t1 k y)
                          (dk-cite! 'cc-magnitude-sub-chain fy sy 'hza_)
                          (dk-cite! 'cc-magnitude-sub-sym fy sy)
                          (ca6x-rr! (list 'magnitude (list '- fy sy))) (ca6x-rr! (list 'magnitude (list '- sy fy)))
                          (ca6x-rr! (list 'magnitude (list '- fy 'hza_))) (ca6x-rr! (list 'magnitude (list '- sy 'hza_)))
                          (dk-ineq! (list '<= mm (list 'magnitude (list '- fy 'hza_)))
                                    (list '<= (list 'magnitude (list '- fy 'hza_)) (list '+ (list 'magnitude (list '- fy sy)) (list 'magnitude (list '- sy 'hza_))))
                                    (list '= (list 'magnitude (list '- fy sy)) (list 'magnitude (list '- sy fy)))
                                    (list '<= (list 'magnitude (list '- sy fy)) e))
                          (ca6-fin! leaf))))
                    ;; the minimum modulus at c, against the estimate at c
                    (dk-cite! 'cc-hurwitz-disc-bound 'u sk 'hzc_ rho qq 'hza_ m3)
                    (fact 'subset-mem-fwd k0 'u 'hzc_)
                    (ca6-sval! 's k 'hzc_)
                    (ca6-apply! t2 k 'hzc_)
                    (let ((h1 (dk-rewrite-h! (list '<= (list 'magnitude (list '- (list sk 'hzc_) '(f hzc_))) e) '(f hzc_) 'hza_)))
                      (ca6x-rr! (list 'magnitude (list '- (list sk 'hzc_) 'hza_)))
                      (dk-absurd! h1 (list '<= m3 (list 'magnitude (list '- (list sk 'hzc_) 'hza_))) (list '< 0 mm))))))))))))
(qed 'cc-hurwitz-local)
;;; ======================================================================
;;; (10) REMARK 5.24, second part: on a connected u, if f is not constant and f(c) = a, then for
;;;      every r > 0 the f_k take the value a in B(c, r) for all large k.  (The zeros of f - a do
;;;      not accumulate at c, else f = a on u by 2.12 (holomorphic-identity-principle); then (9).)
;;; ======================================================================
(define ca6-const '(FORSOME hcc_ (AND (IN hcc_ CC) (FORALL hcz_ (IMPLIES (IN hcz_ u) (= (f hcz_) hcc_))))))
(define ca6-gl '(VNB-LAMBDA hgz_ u (- (f hgz_) hza_)))
;; x in u, (= (f x) hza_) in context: close the goal (= (ca6-gl x) 0)
(define (ca6-gl-zero!)
  (let ((leaf (proof-state-focus *ps*)))
    (dk-lam-b!)
    (if (not (sequent-node-grounded? leaf))
        (let ((g (dk-goal)))
          (subst (list '= (cadr (cadr g)) 'hza_))
          (if (not (sequent-node-grounded? leaf)) (crs))))))
(sp (make-wff (list 'FORALL 'u (ca6-imps (list (list 'IS-OPEN ca6-nfm 'u) '(IS-CONNECTED CC-MS u))
  (list 'FORALL 's (list 'IMPLIES (list 'IN 's (list 'FUN 'NN ca6-H))
    (list 'FORALL 'f (ca6-imps (list '(IN f (FUN u CC)) '(UNIF-ON-COMPACTA u s f) (list 'NOT ca6-const))
      (list 'FORALL 'hza_ (list 'IMPLIES '(IN hza_ CC)
        (list 'FORALL 'hzc_ (ca6-imps '((IN hzc_ u) (= (f hzc_) hza_))
          (list 'FORALL 'hzr_ (ca6-imps '((IN hzr_ RR) (< 0 hzr_)) ca6-L-concl))))))))))))))
(dk-peel!)
(ca6-open-facts!)
(ca6-hol-limit! 's 'f)
(fact 'holomorphic-on-in-fun 'u 'f)
(dk-have! (list 'HOLOMORPHIC-ON 'u ca6-gl) (lambda () (dk-holomorphic! 'u ca6-gl)))
(let* ((za (list 'ZEROS-ACCUMULATE-AT 'u ca6-gl 'hzc_))
       (ee (list 'FORSOME 'hzp_ (list 'AND '(IN hzp_ RR) (list 'AND '(< 0 hzp_) ca6-L-ne)))))
  ;; the zeros of f - a do not accumulate at c: else f = a on u
  (dk-have! (list 'NOT za)
    (lambda ()
      (di)
      (let ((allz (dk-cite! 'holomorphic-identity-principle 'u ca6-gl 'hzc_)))
        (dk-have! ca6-const
          (lambda ()
            (ew 'hza_)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal))
                    (ass)
                    (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*)) (fz (list 'f z)) (d (list '- fz 'hza_)))
                      (fact 'fun-apply-type-c 'f 'u 'CC z)
                      (ca6x-cc! d)
                      (ca6-apply! allz z)
                      (dk-have! (list '= (list ca6-gl z) d) (lambda () (let ((lf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? lf)) (rfl)))))
                      (dk-rewrite-h! (list '= (list ca6-gl z) 0) (list ca6-gl z) d)
                      (dk-have! (list '= fz (list '+ d 'hza_)) (lambda () (crs)))
                      (subst (list '= fz (list '+ d 'hza_)))
                      (subst (list '= d 0))
                      (if (not (sequent-node-grounded? leaf)) (crs))))))))
        (ca6x-only-prop! ca6-const (list 'NOT ca6-const)))))
  ;; so a punctured disc about c is free of the value a
  (dk-have! ee
    (lambda ()
      (let ((nege (car (filter (dk-head? 'NOT) (dk-landed (lambda () (pbc)))))))
        (dk-have! za
          (lambda ()
            (mac 'ZEROS-ACCUMULATE-AT)
            (let* ((rv (cadr (car (filter (dk-head? 'POS-RR) (dk-peel!)))))
                   (negx (car (filter (dk-head? 'NOT) (dk-landed (lambda () (pbc)))))))
              (fact 'rr-pos-rr-in-rr rv) (fact 'rr-lt-of-pos-rr rv)
              (dk-have! ee
                (lambda ()
                  (ew rv)
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-asm? (dk-goal))
                          (ass)
                          (let* ((lk (dk-peel!)) (x (ca6-in-of lk 'u)))
                            (di)
                            (fact 'fun-apply-type-c 'f 'u 'CC x)
                            (dk-have! (cadr negx)
                              (lambda ()
                                (ew x)
                                (dk-conj-close!
                                  (lambda () (if (dk-asm? (dk-goal)) (ass) (ca6-gl-zero!))))))
                            (ca6x-only-prop! negx (cadr negx))))))))
              (ca6x-only-prop! nege ee))))
        (ca6x-only-prop! za (list 'NOT za)))))
  (let ((rp (dk-skolem! (ca6-ctx ee))))
    (dk-split-all!)
    (dk-cite! 'cc-hurwitz-local 'u 's 'f 'hza_ 'hzc_ rp 'hzr_)
    (if (pair? (dk-open-leaves)) (ass))))
(qed 'cc-hurwitz-eventually)

;;; ======================================================================
;;; (11) REMARK 5.24, first part: if no f_k takes the value a, f is constant or does not take it
;;; ======================================================================
(define ca6-avoid '(FORALL k (IMPLIES (IN k NN) (FORALL z (IMPLIES (IN z u) (NOT (= ((s k) z) hza_)))))))
(define ca6-omits '(FORALL z (IMPLIES (IN z u) (NOT (= (f z) hza_)))))
(sp (make-wff (list 'FORALL 'u (ca6-imps (list (list 'IS-OPEN ca6-nfm 'u) '(IS-CONNECTED CC-MS u))
  (list 'FORALL 's (list 'IMPLIES (list 'IN 's (list 'FUN 'NN ca6-H))
    (list 'FORALL 'hza_ (ca6-imps (list '(IN hza_ CC) ca6-avoid)
      (list 'FORALL 'f (ca6-imps '((IN f (FUN u CC)) (UNIF-ON-COMPACTA u s f))
        (list 'OR ca6-const ca6-omits)))))))))))
(dk-peel!)
(let ((neg (car (filter (dk-head? 'NOT) (dk-landed (lambda () (pbc)))))))
  (dk-have! (list 'NOT ca6-const) (lambda () (di) (ca6x-only-prop! neg ca6-const)))
  (dk-have! ca6-omits
    (lambda ()
      (let* ((z (dk-di-var!)))
        (di)
        (dk-split-all! (list (dk-cite! 'rr-one-in)))
        (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
        (let* ((ev (dk-cite! 'cc-hurwitz-eventually 'u 's 'f 'hza_ z 1))
               (nv (dk-skolem! ev)))
          (dk-split-all!)
          (fact 'nn-le-refl nv)
          (let* ((tl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm nv) (dk-contains? fm 'BALL))) "the tail"))
                 (zz (dk-skolem! (ca6-apply! tl nv))))
            (dk-split-all!)
            (ca6-apply! (ca6-ctx ca6-avoid) nv zz)
            (ca6x-only-prop! (list '= (list (list 's nv) zz) 'hza_) (list 'NOT (list '= (list (list 's nv) zz) 'hza_))))))))
  (ca6x-only-prop! neg ca6-omits))
(qed 'cc-hurwitz-value)

;;; ======================================================================
;;; (12) PROPOSITION 5.23 (HURWITZ): nowhere vanishing f_k -> f on a connected u: f is constant
;;;      or nowhere vanishing
;;; ======================================================================
(sp (make-wff (list 'FORALL 'u (ca6-imps (list (list 'IS-OPEN ca6-nfm 'u) '(IS-CONNECTED CC-MS u))
  (list 'FORALL 's (ca6-imps (list (list 'IN 's (list 'FUN 'NN ca6-H))
                                   '(FORALL k (IMPLIES (IN k NN) (FORALL z (IMPLIES (IN z u) (NOT (= ((s k) z) 0)))))))
    (list 'FORALL 'f (ca6-imps '((IN f (FUN u CC)) (UNIF-ON-COMPACTA u s f))
      (list 'OR ca6-const '(FORALL z (IMPLIES (IN z u) (NOT (= (f z) 0)))))))))))))
(dk-peel!)
(fact 'cc-zero-in)
(dk-cite! 'cc-hurwitz-value 'u 's 0 'f)
(if (pair? (dk-open-leaves)) (ass))
(qed 'cc-hurwitz)

;;; ======================================================================
;;; (13) PROPOSITION 5.25: injective f_k -> f on a connected u: f is constant or injective
;;; ======================================================================
(define ca6-inj-s '(FORALL k (IMPLIES (IN k NN) (FORALL z (IMPLIES (IN z u) (FORALL w (IMPLIES (IN w u) (IMPLIES (= ((s k) z) ((s k) w)) (= z w)))))))))
(define ca6-inj-f '(FORALL z (IMPLIES (IN z u) (FORALL w (IMPLIES (IN w u) (IMPLIES (= (f z) (f w)) (= z w)))))))
(sp (make-wff (list 'FORALL 'u (ca6-imps (list (list 'IS-OPEN ca6-nfm 'u) '(IS-CONNECTED CC-MS u))
  (list 'FORALL 's (ca6-imps (list (list 'IN 's (list 'FUN 'NN ca6-H)) ca6-inj-s)
    (list 'FORALL 'f (ca6-imps '((IN f (FUN u CC)) (UNIF-ON-COMPACTA u s f))
      (list 'OR ca6-const ca6-inj-f)))))))))
(dk-peel!)
(ca6-open-facts!)
(ca6-sty! 's)
(let ((neg (car (filter (dk-head? 'NOT) (dk-landed (lambda () (pbc)))))))
  (dk-have! (list 'NOT ca6-const) (lambda () (di) (ca6x-only-prop! neg ca6-const)))
  (dk-have! ca6-inj-f
    (lambda ()
      (let* ((lk (dk-peel!))
             (eqn (car (filter (dk-head? '=) lk)))
             (z (cadr (cadr eqn))) (w (cadr (caddr eqn)))
             (nzw (car (filter (dk-head? 'NOT) (dk-landed (lambda () (pbc))))))
             (fz (list 'f z)) (d (list '- z w)) (md (list 'magnitude d)) (r (list '* 1/2 md)))
        (fact 'subset-mem-fwd 'u 'CC z) (fact 'subset-mem-fwd 'u 'CC w)
        (fact 'fun-apply-type-c 'f 'u 'CC z) (fact 'fun-apply-type-c 'f 'u 'CC w)
        (ca6-sub-ne! z w)
        (ca6-mag-pos! d)
        (ca6x-rr! r)
        (dk-have! (list '< 0 r) (lambda () (dk-ineq! (list '< 0 md))))
        (dk-have! (list '= (list 'f w) fz) (lambda () (subst (list '= (list 'f w) fz)) (if (pair? (dk-open-leaves)) (rfl))))
        (dk-have! (list '= fz fz) (lambda () (rfl)))
        (let* ((n1 (dk-skolem! (dk-cite! 'cc-hurwitz-eventually 'u 's 'f fz z r)))
               (sp1 (dk-split-all!))
               (t1 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm n1) (dk-contains? fm 'BALL))) "tail 1"))
               (n2 (dk-skolem! (dk-cite! 'cc-hurwitz-eventually 'u 's 'f fz w r)))
               (sp2 (dk-split-all!))
               (t2 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm n2) (dk-contains? fm 'BALL))) "tail 2"))
               (kk (list '+ n1 n2)))
          (ca6x-and! (list 'IN n1 'NN) (list 'IN n2 'NN))
          (fact 'nn-add-closed n1 n2)
          (fact 'nn-le-refl kk)
          (dk-have! (list '<= n1 kk) (lambda () (dk-nn! (list '<= kk kk))))
          (dk-have! (list '<= n2 kk) (lambda () (dk-nn! (list '<= kk kk))))
          (let* ((z1 (dk-skolem! (ca6-apply! t1 kk)))
                 (sp3 (dk-split-all!))
                 (w1 (dk-skolem! (ca6-apply! t2 kk)))
                 (sp4 (dk-split-all!))
                 (sk (list 's kk)))
            (dk-have! (list '= (list sk z1) (list sk w1))
              (lambda () (subst (list '= (list sk z1) fz)) (subst (list '= (list sk w1) fz)) (if (pair? (dk-open-leaves)) (rfl))))
            (ca6-sval! 's kk z1)
            (ca6-apply! (ca6-ctx ca6-inj-s) kk z1 w1)
            (ca6x-ball-open! z r z1)
            (ca6x-ball-open! w r w1)
            (fact 'subset-mem-fwd 'u 'CC z1) (fact 'subset-mem-fwd 'u 'CC w1)
            (dk-cite! 'cc-magnitude-sub-chain z z1 w)
            (dk-cite! 'cc-magnitude-sub-sym z z1)
            (ca6x-rr! (list 'magnitude (list '- z z1))) (ca6x-rr! (list 'magnitude (list '- z1 z)))
            (ca6x-rr! (list 'magnitude (list '- z1 w))) (ca6x-rr! (list 'magnitude (list '- w1 w)))
            (dk-have! (list '= (list 'magnitude (list '- z1 w)) (list 'magnitude (list '- w1 w)))
              (lambda () (subst (list '= z1 w1)) (if (pair? (dk-open-leaves)) (rfl))))
            (dk-absurd! (list '<= md (list '+ (list 'magnitude (list '- z z1)) (list 'magnitude (list '- z1 w))))
                        (list '= (list 'magnitude (list '- z z1)) (list 'magnitude (list '- z1 z)))
                        (list '< (list 'magnitude (list '- z1 z)) r)
                        (list '= (list 'magnitude (list '- z1 w)) (list 'magnitude (list '- w1 w)))
                        (list '< (list 'magnitude (list '- w1 w)) r)))))))
  (ca6x-only-prop! neg ca6-inj-f))
(qed 'cc-hurwitz-injective)
;;; ======================================================================
;;; (14) THE MODULE OF FUNCTIONS ON ANY CLASS v CLOSED UNDER THE POINTWISE OPERATIONS
;;;      (the general form of CA-5's cc-fn-module-is-module, whose laws are stated for C(u):
;;;      the same proof, with the closure of v taken as hypotheses -- so that H(u) is one
;;;      citation, and any later class of functions too)
;;; ======================================================================
(define ca6-ccr '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define (ca6-fsum a b) (list 'VNB-LAMBDA 'cfz_ 'u (list '+ (list a 'cfz_) (list b 'cfz_))))
(define (ca6-fneg a) (list 'VNB-LAMBDA 'cfz_ 'u (list '- (list a 'cfz_))))
(define (ca6-fscale c a) (list 'VNB-LAMBDA 'cfz_ 'u (list '* c (list a 'cfz_))))
(define (ca6-faddneg a b) (list 'VNB-LAMBDA 'cfz_ 'u (list '+ (list a 'cfz_) (list '- (list b 'cfz_)))))
(define ca6-fz '(VNB-LAMBDA cfz_ u 0))
;; the closure hypotheses on a class V of functions on u
(define (ca6-cl-sum vv) (list 'FORALL 'a (list 'IMPLIES (list 'IN 'a vv) (list 'FORALL 'b (list 'IMPLIES (list 'IN 'b vv) (list 'IN (ca6-fsum 'a 'b) vv))))))
(define (ca6-cl-zero vv) (list 'IN ca6-fz vv))
(define (ca6-cl-neg vv) (list 'FORALL 'a (list 'IMPLIES (list 'IN 'a vv) (list 'IN (ca6-fneg 'a) vv))))
(define (ca6-cl-scale vv) (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'a (list 'IMPLIES (list 'IN 'a vv) (list 'IN (ca6-fscale 'c 'a) vv))))))
(define (ca6-cl-addneg vv) (list 'FORALL 'a (list 'IMPLIES (list 'IN 'a vv) (list 'FORALL 'b (list 'IMPLIES (list 'IN 'b vv) (list 'IN (ca6-faddneg 'a 'b) vv))))))
(define (ca6-cl vv)
  (list (list 'IN vv 'SET) (list 'SUBSET vv '(FUN u CC))
        (ca6-cl-sum vv) (ca6-cl-zero vv) (ca6-cl-neg vv) (ca6-cl-scale vv) (ca6-cl-addneg vv)))
;; the closure instances, from the hypotheses in context
(define (ca6-in-v! vv x) (fact 'subset-mem-fwd vv '(FUN u CC) x))
(define (ca6-sum-v! vv a b) (ca6-apply! (ca6-ctx (ca6-cl-sum vv)) a b))
(define (ca6-neg-v! vv a) (ca6-apply! (ca6-ctx (ca6-cl-neg vv)) a))
(define (ca6-scale-v! vv c a) (ca6-apply! (ca6-ctx (ca6-cl-scale vv)) c a))
(define (ca6-addneg-v! vv a b) (ca6-apply! (ca6-ctx (ca6-cl-addneg vv)) a b))
;; the six slot values of CC-FN-MODULE(u, V)
(define (ca6-opadd vv) (list 'VNB-LAMBDA '(LIST cfa_ cfb_) (list 'CARTESIAN vv vv) '(VNB-LAMBDA cfz_ u (+ (cfa_ cfz_) (cfb_ cfz_)))))
(define (ca6-opneg vv) (list 'VNB-LAMBDA 'cfa_ vv '(VNB-LAMBDA cfz_ u (- (cfa_ cfz_)))))
(define (ca6-opact vv) (list 'VNB-LAMBDA '(LIST cfc_ cfa_) (list 'CARTESIAN 'CC vv) '(VNB-LAMBDA cfz_ u (* cfc_ (cfa_ cfz_)))))
(define (ca6-mv vv) (list 'CC-FN-MODULE 'u vv))
(define (ca6-slots-of! vv)       ; cite the six slot read-offs (u, V in SET in context)
  (for-each (lambda (nm) (dk-cite! nm 'u vv))
            '(cc-fn-module-scal cc-fn-module-vec cc-fn-module-vadd cc-fn-module-vzero cc-fn-module-vneg cc-fn-module-act)))
(define (ca6-subst-slots! vv)
  (for-each (lambda (acc val) (if (dk-contains? (dk-goal) (list acc (ca6-mv vv))) (subst (list '== (list acc (ca6-mv vv)) val))))
            '(SCAL VEC VADD VZERO VNEG ACT)
            (list ca6-ccr vv (ca6-opadd vv) ca6-fz (ca6-opneg vv) (ca6-opact vv))))
(define (ca6-redex? t)
  (and (pair? t)
       (or (and (pair? (car t)) (eq? (car (car t)) 'VNB-LAMBDA))
           (let loop ((xs t)) (and (pair? xs) (or (ca6-redex? (car xs)) (loop (cdr xs))))))))
(define (ca6-beta!)
  (let ((leaf (proof-state-focus *ps*)))
    (if (ca6-redex? (dk-goal)) (dk-lam-b!))
    (sequent-node-grounded? leaf)))
(define (ca6-base-at! vecs z) (for-each (lambda (a) (fact 'fun-apply-type-c a 'u 'CC z)) vecs))
(define (ca6-lam-typer vecs)
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*)))
          (ca6-base-at! vecs z)
          (ca6-beta!)
          (if (not (sequent-node-grounded? leaf))
              (begin (dk-type! (cadr (dk-goal)) 'CC) (ca6-fin! leaf))))))))
;; a pointwise module law on the focus goal: VS vectors of V, SS scalars in context
(define (ca6-law-inline! vv vs ss)
  (let ((leaf (proof-state-focus *ps*)))
    (fact 'cc-one-in)
    (for-each (lambda (a) (ca6-in-v! vv a) (ca6-neg-v! vv a)) vs)
    (for-each (lambda (a) (for-each (lambda (b) (ca6-sum-v! vv a b)) vs)) vs)
    (for-each (lambda (c) (for-each (lambda (a) (ca6-scale-v! vv c a)) vs)) ss)
    (for-each (lambda (r) (for-each (lambda (s0) (ca6x-cc! (list '+ r s0)) (ca6x-cc! (list '* r s0))) ss)) ss)
    (if (not (sequent-node-grounded? leaf)) (ca6-beta!))
    (if (not (sequent-node-grounded? leaf))
        (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
          (dk-fun-ext! l r 'u 'CC
            (if (symbol? l) #f (ca6-lam-typer vs))
            (if (symbol? r) #f (ca6-lam-typer vs))
            (lambda (w)
              (ca6-base-at! vs w)
              (if (not (ca6-beta!))
                  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (crs)))))))
    (if (not (sequent-node-grounded? leaf)) (error "ca6-law-inline!: did not close" (expression->string (dk-goal))))))
(define (ca6-peel-vars! vv)
  (let* ((lk (dk-peel!))
         (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) vv))) lk)))
         (ss (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC))) lk))))
    (cons vs ss)))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC)
  (list 'FORALL 'v (ca6-imps (ca6-cl 'v) (list 'IS-MODULE (ca6-mv 'v))))))))
(dk-peel!)
(fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC)
(fact 'cc-is-normed-field)
(fact 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
(fact 'commutative-ring-is-ring ca6-ccr)
(ca6-slots-of! 'v)
(let* ((iff (dk-cite! 'is-module (ca6-mv 'v)))
       (rhs (caddr iff)))
  (dk-have! rhs
    (lambda ()
      (ca6-subst-slots! 'v)
      (for-each (lambda (m) (vnb-guard (lambda () (mac m))))
                '(cc-scalar-ring-carr cc-scalar-ring-add cc-scalar-ring-mul cc-scalar-ring-one))
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-asm? g) (ass))
              ((and (dk-head-is? g '=) (pair? (cadr g)) (eq? (car (cadr g)) 'LENGTH))
               (mac 'CC-FN-MODULE) (len-r) (if (not (proof-done? *ps*)) (vnb-guard (lambda () (arith)))))
              ((and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'FUN))
               (dk-lam-type!
                 (lambda ()
                   (let* ((vss (ca6-peel-vars! 'v)) (vs (car vss)) (ss (cdr vss))
                          (leaf (proof-state-focus *ps*))
                          (body (cadddr (cadr (dk-goal)))))
                     (case (car body)
                       ((+) (ca6-sum-v! 'v (car vs) (cadr vs)))
                       ((*) (ca6-scale-v! 'v (car ss) (car vs)))
                       ((-) (ca6-neg-v! 'v (car vs)))
                       (else (error "ca6: unexpected op body" body)))
                     (ca6-fin! leaf)))))
              ((memq (car g) '(IS-ASSOCIATIVE IS-COMMUTATIVE IS-IDENTITY HAS-INVERSES is-associative is-commutative is-identity has-inverses))
               (mac (car g))
               (let ((vss (ca6-peel-vars! 'v)))
                 (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (ca6-law-inline! 'v (car vss) (cdr vss)))))))
              ((dk-head-is? g 'FORALL)
               (let ((vss (ca6-peel-vars! 'v)))
                 (ca6-law-inline! 'v (car vss) (cdr vss))))
              (#t (error "ca6: unexpected conjunct" (expression->string g)))))))))
  (mac 'IS-MODULE)
  (ass))
(qed 'cc-fn-module-is-module-of)
;;; ======================================================================
;;; (15) THE SEMINORM OF A DIFFERENCE, read pointwise, for any closed class v
;;; ======================================================================
(define (ca6-fdiff a b) (list 'VNB-LAMBDA 'cfz_ 'u (list '- (list a 'cfz_) (list b 'cfz_))))
(define (ca6-pv vv) (list 'CC-EXHAUST-SEMINORMS 'u vv))
(define (ca6-famdiff vv k a b)
  (list (list (ca6-pv vv) k) (list (list 'VADD (ca6-mv vv)) a (list (list 'VNEG (ca6-mv vv)) b))))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC)
  (list 'FORALL 'v (ca6-imps (ca6-cl 'v)
    (list 'FORALL 'a (list 'IMPLIES '(IN a v) (list 'FORALL 'b (list 'IMPLIES '(IN b v)
      (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
        (list '== (ca6-famdiff 'v 'k 'a 'b) (list 'CC-SUP-NORM (ca6-fdiff 'a 'b) '(CC-EXHAUST u k)))))))))))))))
(dk-peel!)
(fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC)
(ca6-slots-of! 'v)
(ca6-subst-slots! 'v)
(mac 'CC-EXHAUST-SEMINORMS)
(ca6-in-v! 'v 'a) (ca6-in-v! 'v 'b)
(ca6-neg-v! 'v 'b)
(ca6-sum-v! 'v 'a (ca6-fneg 'b))
(ca6-addneg-v! 'v 'a 'b)
(dk-lam-b!)
(if (not (proof-done? *ps*))
    (let* ((g (dk-goal)) (l (cadr (cadr g))) (r (cadr (caddr g))))
      (if (not (equal? l r))
          (begin
            (dk-fun-ext! l r 'u 'CC (ca6-lam-typer '(a b)) (ca6-lam-typer '(a b))
              (lambda (w)
                (ca6-base-at! '(a b) w)
                (if (not (ca6-beta!))
                    (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (crs)))))
            (subst (list '= l r))))
      (if (not (proof-done? *ps*)) (qrfl))))
(qed 'cc-fn-seminorm-of-difference-of)

;;; ======================================================================
;;; (16) FR-CONV DOES NOT DEPEND ON THE CLASS: a sequence and a limit lying in two closed
;;;      classes converge in the one Frechet vocabulary exactly when in the other
;;; ======================================================================
(define (ca6-sin vv) (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'IN '(s i) vv))))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC)
  (list 'FORALL 'fva_ (ca6-imps (ca6-cl 'fva_)
    (list 'FORALL 'fvb_ (ca6-imps (ca6-cl 'fvb_)
      (list 'FORALL 's (ca6-imps (list (ca6-sin 'fva_) (ca6-sin 'fvb_))
        (list 'FORALL 'f (ca6-imps (list '(IN f fva_) '(IN f fvb_) (list 'FR-CONV (ca6-mv 'fva_) (ca6-pv 'fva_) 's 'f))
          (list 'FR-CONV (ca6-mv 'fvb_) (ca6-pv 'fvb_) 's 'f)))))))))))))
(dk-peel!)
(dk-cite! 'cc-fn-module-is-module-of 'u 'fva_)
(dk-cite! 'cc-fn-module-is-module-of 'u 'fvb_)
(let* ((ia (dk-cite! 'fr-conv (ca6-mv 'fva_) (ca6-pv 'fva_) 's 'f)) (ra (caddr ia))
       (ib (dk-cite! 'fr-conv (ca6-mv 'fvb_) (ca6-pv 'fvb_) 's 'f)) (rb (caddr ib)))
  (dk-have! ra (lambda () (ca6x-only-prop! ia (list 'FR-CONV (ca6-mv 'fva_) (ca6-pv 'fva_) 's 'f))))
  (dk-have! rb
    (lambda ()
      (let* ((lk (dk-peel!)) (k (ca6-in-of lk 'NN))
             (eps (cadr (car (filter (dk-head? 'POS-RR) lk))))
             (cap (dk-skolem! (ca6-apply! (ca6-ctx ra) k eps))))
        (dk-split-all!)
        (ew cap)
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (let* ((lk2 (dk-peel!))
                       (cj (car (filter (dk-head? 'AND) lk2)))
                       (i (cadr (cadr cj)))
                       (si (list 's i))
                       (leaf (proof-state-focus *ps*))
                       (tl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm cap) (dk-contains? fm eps))) "the tail")))
                  (dk-split-all!)
                  (ca6x-and! (list 'IN i 'NN) (list '<= cap i))
                  (ca6-apply! (ca6-ctx (ca6-sin 'fva_)) i)
                  (ca6-apply! (ca6-ctx (ca6-sin 'fvb_)) i)
                  (dk-cite! 'cc-fn-seminorm-of-difference-of 'u 'fva_ si 'f k)
                  (dk-cite! 'cc-fn-seminorm-of-difference-of 'u 'fvb_ si 'f k)
                  (ca6-apply! tl i)
                  (let ((sup (list 'CC-SUP-NORM (ca6-fdiff si 'f) (list 'CC-EXHAUST 'u k))))
                    (subst (list '= (ca6-famdiff 'fvb_ k si 'f) sup))
                    (if (not (sequent-node-grounded? leaf)) (subst (list '= sup (ca6-famdiff 'fva_ k si 'f))))
                    (ca6-fin! leaf)))))))))
  (ca6x-only-prop! ib rb))
(qed 'cc-fr-conv-transfer)

;;; ======================================================================
;;; (17) H(u) IS CLOSED UNDER THE POINTWISE OPERATIONS, AND CC-FN-MODULE(u, H(u)) IS A MODULE
;;; ======================================================================
;; land (IN lam H) from lam in FUN(u, CC) and HOLOMORPHIC-ON(u, lam) (dk-holomorphic!)
(define (ca6-hol-in! lam vecs)
  (dk-have! (list 'IN lam '(FUN u CC)) (ca6-lam-typer vecs))
  (dk-have! (list 'HOLOMORPHIC-ON 'u lam) (lambda () (dk-holomorphic! 'u lam)))
  (let* ((hi (dk-cite! 'cc-hol-fns-membership 'u lam)) (hr (caddr hi)))
    (dk-have! hr (lambda () (dk-conj-close! dk-ass!)))
    (dk-have! (list 'IN lam ca6-H) (lambda () (ca6x-only-prop! hi hr)))))
(define (ca6-hol-closure! name vecs scals lam)
  (sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ca6-nfm 'u)
    (let loop ((ss scals))
      (if (null? ss)
          (let loop2 ((vs vecs))
            (if (null? vs) (list 'IN lam ca6-H)
                (list 'FORALL (car vs) (list 'IMPLIES (list 'IN (car vs) ca6-H) (loop2 (cdr vs))))))
          (list 'FORALL (car ss) (list 'IMPLIES (list 'IN (car ss) 'CC) (loop (cdr ss))))))))))
  (dk-peel!)
  (fact 'cc-open-subset-cc 'u)
  (fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC)
  (for-each ca6-hol! vecs)
  (ca6-hol-in! lam vecs)
  (if (not (proof-done? *ps*)) (ass))
  (qed name))
(ca6-hol-closure! 'cc-hol-fns-add '(a b) '() (ca6-fsum 'a 'b))
(ca6-hol-closure! 'cc-hol-fns-zero '() '() ca6-fz)
(ca6-hol-closure! 'cc-hol-fns-neg '(a) '() (ca6-fneg 'a))
(ca6-hol-closure! 'cc-hol-fns-scale '(a) '(c) (ca6-fscale 'c 'a))
;; a + (-b): holomorphic-sum of a and the holomorphic -b (cc-hol-fns-neg), read pointwise
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ca6-nfm 'u)
  (list 'FORALL 'a (list 'IMPLIES (list 'IN 'a ca6-H) (list 'FORALL 'b (list 'IMPLIES (list 'IN 'b ca6-H)
    (list 'IN (ca6-faddneg 'a 'b) ca6-H)))))))))
(dk-peel!)
(fact 'cc-open-subset-cc 'u)
(fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC)
(ca6-hol! 'a) (ca6-hol! 'b)
(dk-cite! 'cc-hol-fns-neg 'u 'b)
(ca6-hol! (ca6-fneg 'b))
(let ((lam (ca6-faddneg 'a 'b)))
  (dk-have! (list 'IN lam '(FUN u CC)) (ca6-lam-typer '(a b)))
  (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES '(IN hbx_ u) (list '== (list lam 'hbx_) (list '+ '(a hbx_) (list (ca6-fneg 'b) 'hbx_)))))
    (lambda ()
      (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
        (ca6-base-at! '(a b) x)
        (dk-lam-b!)
        (if (not (sequent-node-grounded? leaf)) (qrfl)))))
  (dk-cite! 'holomorphic-sum 'u 'a (ca6-fneg 'b) lam)
  (let* ((hi (dk-cite! 'cc-hol-fns-membership 'u lam)) (hr (caddr hi)))
    (dk-have! hr (lambda () (dk-conj-close! dk-ass!)))
    (ca6x-only-prop! hi hr)))
(qed 'cc-hol-fns-add-neg)

;; land the seven closure hypotheses (ca6-cl V) for V = H(u) (u open) or C(u) (u subset CC)
(define (ca6-cl-land! vv)
  (let* ((hol? (equal? vv ca6-H))
         (nm (lambda (op) (string->symbol (string-append (if hol? "cc-hol-fns-" "cc-cont-fns-") op)))))
    (fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC)
    (if hol?
        (begin (dk-cite! 'cc-cont-fns-is-set 'u) (dk-cite! 'cc-hol-fns-subset-cont 'u)
               (fact 'subclass-of-set-is-set ca6-H ca6-C))
        (dk-cite! 'cc-cont-fns-is-set 'u))
    (dk-have! (list 'SUBSET vv '(FUN u CC))
      (lambda ()
        (let* ((a (subset-by-element!)) (leaf (proof-state-focus *ps*)))
          (if hol? (ca6-hol! a) (dk-cite! 'cc-cont-fns-fun 'u a))
          (ca6-fin! leaf))))
    (dk-cite! (nm "zero") 'u)
    (for-each
      (lambda (form op)
        (dk-have! form
          (lambda ()
            (let* ((lk (dk-peel!)) (leaf (proof-state-focus *ps*))
                   (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) vv))) lk)))
                   (ss (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC))) lk))))
              (apply dk-cite! (nm op) 'u (append ss vs))
              (ca6-fin! leaf)))))
      (list (ca6-cl-sum vv) (ca6-cl-neg vv) (ca6-cl-scale vv) (ca6-cl-addneg vv))
      '("add" "neg" "scale" "add-neg"))))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ca6-nfm 'u) (list 'IS-MODULE (ca6-mv ca6-H))))))
(dk-peel!)
(fact 'cc-open-subset-cc 'u)
(ca6-cl-land! ca6-H)
(dk-cite! 'cc-fn-module-is-module-of 'u ca6-H)
(if (not (proof-done? *ps*)) (ass))
(qed 'cc-hol-fn-module-is-module)
;;; ======================================================================
;;; (18) PROPOSITION 5.20 AS AN OPERATOR: D : f |-> f' is a continuous linear map of the module
;;;      CC-FN-MODULE(u, H(u)) with the seminorms of the exhaustion (IS-CONT-LIN, the tree's
;;;      sequential continuity for a seminorm family)
;;; ======================================================================
(define ca6-MH (ca6-mv ca6-H))
(define ca6-PH (ca6-pv ca6-H))
(define ca6-MC (ca6-mv ca6-C))
(define ca6-PC (ca6-pv ca6-C))
(define ca6-D (list 'VNB-LAMBDA 'cdf_ ca6-H '(VNB-LAMBDA wcvw_ u (DERIV-ON CC-NORMED-FIELD u cdf_ wcvw_))))
(define (ca6-dg g) (list 'VNB-LAMBDA 'wcvw_ 'u (list 'DERIV-ON 'CC-NORMED-FIELD 'u g 'wcvw_)))
;; HOLOMORPHIC-ON(u, g) in context: land (IN (ca6-dg g) H)
(define (ca6-deriv-in-h! g)
  (let ((dg (ca6-dg g)))
    (if (not (dk-asm? (list 'IN dg ca6-H)))
        (begin
          (dk-cite! 'holomorphic-deriv-holomorphic 'u g)
          (dk-cite! 'holomorphic-on-in-fun 'u (list 'VNB-LAMBDA 'cifdw_ 'u (list 'DERIV-ON 'CC-NORMED-FIELD 'u g 'cifdw_)))
          (let* ((hi (dk-cite! 'cc-hol-fns-membership 'u dg)) (hr (caddr hi)))
            (dk-have! hr (lambda () (dk-conj-close! dk-ass!)))
            (dk-have! (list 'IN dg ca6-H) (lambda () (ca6x-only-prop! hi hr))))))
    dg))
;; HOLOMORPHIC-ON(u, g), w in u: land DERIV-ON(u, g, w) in CC
(define (ca6-deriv-typ! g w)
  (let ((typ (list 'IN (list 'DERIV-ON 'CC-NORMED-FIELD 'u g w) 'CC)))
    (if (not (dk-asm? typ))
        (let* ((l (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff 'u g) w))))
          (dk-cite! 'cc-deriv-on-of-is-diff-on 'u g w l)
          (dk-cite! 'diff-on-deriv-in-carr 'CC-NORMED-FIELD 'u g w l)
          (fact 'cc-nf-carr)
          (dk-have! (list 'IN l 'CC) (lambda () (subst '(== CC (CARR CC-NORMED-FIELD))) (ass)))
          (dk-have! typ (lambda () (subst (list '= (list 'DERIV-ON 'CC-NORMED-FIELD 'u g w) l)) (ass)))))
    typ))
;; the focus goal (= L R) between two lambdas over u: fun-ext, PT run at the point after beta
(define (ca6-ext-goal! typer pt)
  (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
    (dk-fun-ext! l r 'u 'CC typer typer
      (lambda (w)
        (let ((leaf (proof-state-focus *ps*)))
          (ca6-beta!)
          (if (not (sequent-node-grounded? leaf)) (pt w)))))))
;; the linear combination law at w: DERIV(u, LAM, w) = rhs, with LAM equal on u to
;; cdw_ |-> c1 x(cdw_) + c2 y(cdw_) (cc-deriv-linear)
(define (ca6-lin-at! lam x y c1 c2 w)
  (let ((lam1 (list 'VNB-LAMBDA 'cdw_ 'u (list '+ (list '* c1 (list x 'cdw_)) (list '* c2 (list y 'cdw_))))))
    (dk-fun-ext! lam lam1 'u 'CC #f (ca6-lam-typer (list x y))
      (lambda (z)
        (let ((leaf (proof-state-focus *ps*)))
          (ca6-base-at! (list x y) z)
          (ca6-beta!)
          (if (not (sequent-node-grounded? leaf)) (crs)))))
    (subst (list '= lam lam1))
    (dk-cite! 'cc-deriv-linear 'u x y c1 c2 w)
    (subst (list '= (list 'DERIV-ON 'CC-NORMED-FIELD 'u lam1 w)
                 (list '+ (list '* c1 (list 'DERIV-ON 'CC-NORMED-FIELD 'u x w)) (list '* c2 (list 'DERIV-ON 'CC-NORMED-FIELD 'u y w)))))))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ca6-nfm 'u) (list 'IS-CONT-LIN ca6-MH ca6-PH ca6-MH ca6-PH ca6-D)))))
(dk-peel!)
(fact 'cc-open-subset-cc 'u)
(ca6-cl-land! ca6-C)
(ca6-cl-land! ca6-H)
(dk-cite! 'cc-hol-fn-module-is-module 'u)
(dk-cite! 'cc-fn-module-is-module-of 'u ca6-C)
(fact 'cc-zero-in) (fact 'cc-one-in)
(ca6-slots-of! ca6-H)
(let* ((ci (dk-cite! 'is-cont-lin ca6-MH ca6-PH ca6-MH ca6-PH ca6-D)) (cr (caddr ci)))
  (dk-have! cr
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-asm? g) (ass))
              ((dk-head-is? g 'IS-LINEAR-MAP)
               (let* ((li (dk-cite! 'is-linear-map ca6-MH ca6-MH ca6-D)) (lr (caddr li)))
                 (dk-have! lr
                   (lambda ()
                     (ca6-subst-slots! ca6-H)
                     (vnb-guard (lambda () (mac 'cc-scalar-ring-carr)))
                     (dk-conj-close!
                       (lambda ()
                         (let ((g2 (dk-goal)))
                           (cond
                             ((dk-asm? g2) (ass))
                             ((dk-head-is? g2 '=) (rfl))
                             ((dk-head-is? g2 'IN)
                              (ca6-lam-goal! (lambda (f) (ca6-hol! f) (ca6-deriv-in-h! f))))
                             (#t
                              (let* ((vss (ca6-peel-vars! ca6-H)) (vs (car vss)) (ss (cdr vss)) (leaf (proof-state-focus *ps*)))
                                (for-each (lambda (a) (ca6-hol! a) (ca6-deriv-in-h! a)) vs)
                                (if (null? ss)
                                    ;; additivity
                                    (let* ((x (car vs)) (y (cadr vs)) (sxy (ca6-fsum x y)))
                                      (dk-cite! 'cc-hol-fns-add 'u x y)
                                      (ca6-hol! sxy)
                                      (ca6-deriv-in-h! sxy)
                                      (ca6-beta!)
                                      (if (not (sequent-node-grounded? leaf))
                                          (ca6-ext-goal!
                                            (lambda () (ca6-lam-goal! (lambda (w) (ca6-deriv-typ! sxy w) (ca6-deriv-typ! x w) (ca6-deriv-typ! y w))))
                                            (lambda (w)
                                              (ca6-deriv-typ! sxy w) (ca6-deriv-typ! x w) (ca6-deriv-typ! y w)
                                              (ca6-lin-at! sxy x y 1 1 w)
                                              (if (pair? (dk-open-leaves)) (crs))))))
                                    ;; homogeneity
                                    (let* ((c (car ss)) (x (car vs)) (cx (ca6-fscale c x)))
                                      (dk-cite! 'cc-hol-fns-scale 'u c x)
                                      (ca6-hol! cx)
                                      (ca6-deriv-in-h! cx)
                                      (ca6-beta!)
                                      (if (not (sequent-node-grounded? leaf))
                                          (ca6-ext-goal!
                                            (lambda () (ca6-lam-goal! (lambda (w) (ca6-deriv-typ! cx w) (ca6-deriv-typ! x w))))
                                            (lambda (w)
                                              (ca6-deriv-typ! cx w) (ca6-deriv-typ! x w)
                                              (ca6-lin-at! cx x x c 0 w)
                                              (if (pair? (dk-open-leaves)) (crs)))))))))))))))
                 (ca6x-only-prop! li lr)))
              (#t
               ;; sequential continuity, through C(u) and CA-5's cc-deriv-continuous-on-hol
               (let* ((lk (dk-peel!))
                      (cv (car (filter (dk-head? 'FR-CONV) lk)))
                      (sq (cadddr cv)) (lim (car (cddddr cv)))
                      (dfam (list 'VNB-LAMBDA 'wcvk_ 'NN (list 'VNB-LAMBDA 'wcvw_ 'u (list 'DERIV-ON 'CC-NORMED-FIELD 'u (list sq 'wcvk_) 'wcvw_))))
                      (dlim (ca6-dg lim))
                      (li (list 'VNB-LAMBDA 'i 'NN (list ca6-D (list sq 'i)))))
                 (dk-have! (list 'IN sq (list 'FUN 'NN ca6-H)) (lambda () (subst (list '= ca6-H (list 'VEC ca6-MH))) (ass)))
                 (dk-have! (list 'IN lim ca6-H) (lambda () (subst (list '= ca6-H (list 'VEC ca6-MH))) (ass)))
                 (fact 'subset-mem-fwd ca6-H ca6-C lim)
                 (ca6-hol! lim)
                 (ca6-deriv-in-h! lim)
                 (fact 'subset-mem-fwd ca6-H ca6-C dlim)
                 (for-each
                   (lambda (vv)
                     (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'IN (list sq 'i) vv)))
                       (lambda ()
                         (let* ((i (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                           (fact 'fun-apply-type-c sq 'NN ca6-H i)
                           (if (equal? vv ca6-C) (fact 'subset-mem-fwd ca6-H ca6-C (list sq i)))
                           (ca6-fin! leaf))))
                     (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'IN (list dfam 'i) vv)))
                       (lambda ()
                         (let* ((i (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                           (fact 'fun-apply-type-c sq 'NN ca6-H i)
                           (ca6-hol! (list sq i))
                           (ca6-deriv-in-h! (list sq i))
                           (if (equal? vv ca6-C) (fact 'subset-mem-fwd ca6-H ca6-C (ca6-dg (list sq i))))
                           (ca6-beta!)
                           (ca6-fin! leaf)))))
                   (list ca6-H ca6-C))
                 (dk-cite! 'cc-fr-conv-transfer 'u ca6-H ca6-C sq lim)
                 (dk-cite! 'cc-deriv-continuous-on-hol 'u sq lim)
                 (dk-cite! 'cc-fr-conv-transfer 'u ca6-C ca6-H dfam dlim)
                 ;; the image sequence and limit, read off by beta
                 (dk-fun-ext! li dfam 'NN ca6-H
                   (lambda () (ca6-lam-goal! (lambda (i) (fact 'fun-apply-type-c sq 'NN ca6-H i) (ca6-hol! (list sq i)) (ca6-deriv-in-h! (list sq i)))))
                   (lambda () (ca6-lam-goal! (lambda (i) (fact 'fun-apply-type-c sq 'NN ca6-H i) (ca6-hol! (list sq i)) (ca6-deriv-in-h! (list sq i)))))
                   (lambda (i)
                     (let ((leaf (proof-state-focus *ps*)))
                       (fact 'fun-apply-type-c sq 'NN ca6-H i) (ca6-hol! (list sq i)) (ca6-deriv-in-h! (list sq i))
                       (ca6-beta!)
                       (if (not (sequent-node-grounded? leaf)) (rfl)))))
                 (dk-have! (list '= (list ca6-D lim) dlim) (lambda () (let ((leaf (proof-state-focus *ps*))) (ca6-beta!) (if (not (sequent-node-grounded? leaf)) (rfl)))))
                 (let ((leaf (proof-state-focus *ps*)))
                   (subst (list '= li dfam))
                   (subst (list '= (list ca6-D lim) dlim))
                   (ca6-fin! leaf))))))))))
  (ca6x-only-prop! ci cr))
(qed 'cc-deriv-cont-lin)
