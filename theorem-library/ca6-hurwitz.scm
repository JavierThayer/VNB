(define ca6v-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (ca6v-open-ball! z)
  (fact 'cc-open-subset-cc 'u)
  (fact 'subset-mem-fwd 'u 'CC z)
  (fact 'cc-is-metric-space) (ca6v-pts-cc!)
  (if (not (dk-asm? (list 'IN z '(PTS CC-MS))))
      (dk-have! (list 'IN z '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass))))
  (if (not (dk-asm? '(IS-OPEN CC-MS u)))
      (begin
        (dk-split-all! (list (dk-cite! 'cc-ms-open-iff 'u)))
        (dk-have! '(IS-OPEN CC-MS u) (lambda () (prop)))))
  (let* ((oiff (dk-cite! 'is-open 'CC-MS 'u))
         (oball (let loop ((r (caddr oiff))) (if (eq? (car r) 'AND) (loop (caddr r)) r))))
    (if (not (dk-asm? oball))
        (dk-have! oball (lambda () (ca6x-only-prop! oiff '(IS-OPEN CC-MS u)))))
    (let ((rho (dk-skolem! (dk-apply! oball z))))
      (dk-split-all!)
      rho)))
(define (ca6v-head g) (and (pair? g) (car g)))
(define (ca6v-csub-and! closer)
  (if (eq? (ca6v-head (dk-goal)) 'AND)
      (for-each (lambda (k) (dk-focus! k) (ca6v-csub-and! closer))
                (dk-opened (lambda () (di))))
      (closer)))
(define (ca6v-ball-in-ball! y a z b)
  (let ()
    (dk-have! (list 'SUBSET (list 'BALL 'CC-MS y a) (list 'BALL 'CC-MS z b))
      (lambda ()
        (let* ((w (subset-by-element!)))
          (ca6x-ball-open! y a w)
          (let* ((wy (list '- w y)) (yz (list '- y z)) (wz (list '- w z)))
            (ca6v-cc! wy) (ca6v-cc! yz) (ca6v-cc! wz)
            (ca6v-and! (list 'IN wy 'CC) (list 'IN yz 'CC))
            (let ((tri (dk-cite! 'cc-magnitude-triangle wy yz)))
              (dk-have! (list '= (list '+ wy yz) wz) (lambda () (crs)))
              (dk-rewrite-h! tri (list '+ wy yz) wz)
              (ca6v-rr! (list 'magnitude wy)) (ca6v-rr! (list 'magnitude yz)) (ca6v-rr! (list 'magnitude wz))
              (dk-have! (list '< (list 'magnitude wz) b)
                (lambda () (dk-ineq! (list '<= (list 'magnitude wz) (list '+ (list 'magnitude wy) (list 'magnitude yz)))
                                     (list '< (list 'magnitude wy) a)
                                     (list '<= (list '+ (list 'magnitude yz) a) b))))
              (ca6x-in-ball! w z b)
              (if (not (dk-asm? (dk-goal))) (error "ca6v-ball-in-ball!: no membership")) (ass))))))))
(define (ca6v-deriv-typ! g w)
  (let ((typ (list 'IN (list 'DERIV-ON 'CC-NORMED-FIELD 'u g w) 'CC)))
    (if (not (dk-asm? typ))
        (let* ((l (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff 'u g) w))))
          (dk-cite! 'cc-deriv-on-of-is-diff-on 'u g w l)
          (dk-cite! 'diff-on-deriv-in-carr 'CC-NORMED-FIELD 'u g w l)
          (fact 'cc-nf-carr)
          (dk-have! (list 'IN l 'CC) (lambda () (subst '(== CC (CARR CC-NORMED-FIELD))) (ass)))
          (dk-have! typ (lambda () (subst (list '= (list 'DERIV-ON 'CC-NORMED-FIELD 'u g w) l)) (ass)))))
    typ))

;;; ======================================================================
;;; (1) Cauchy's estimate for the derivative, in the form 5.8 uses:
;;;     |f'(y)| <= M / q  when |f| <= M on B(y, 2q) inside u
;;; ======================================================================
(define (ca6-strip-imps g)
  (if (and (pair? g) (eq? (car g) 'IMPLIES) (dk-asm? (cadr g))) (ca6-strip-imps (caddr g)) g))
(define (ca6-apply! f . terms)
  (let loop ((g (->raw-formula f)) (ts terms) (best f) (rest terms))
    (let* ((g1 (ca6-strip-imps g))
           (here (and (not (eq? g (->raw-formula f))) (dk-ctx-form g1)))
           (best2 (if here here best))
           (rest2 (if here ts rest)))
      (cond ((null? ts)
             (or (dk-ctx-form g1)
                 (if (null? rest2) best2 (apply dk-apply! best2 rest2))))
            ((and (pair? g1) (eq? (car g1) 'FORALL))
             (loop (subst-free (cadr g1) (car ts) (caddr g1)) (cdr ts) best2 rest2))
            (#t (apply dk-apply! best2 rest2))))))
;;; ======================================================================
;;; (1) UNIFORM CONVERGENCE ON COMPACTA GIVES POINTWISE CONVERGENCE
;;; ======================================================================
(define ca6-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define ca6-H '(CC-HOL-FNS u))
(define ca6-C '(CC-CONT-FNS u))
(define (ca6-imps hyps body) (if (null? hyps) body (list 'IMPLIES (car hyps) (ca6-imps (cdr hyps) body))))
;; the pointwise typing of a sequence of functions on u, and its pointwise sequence at z
(define (ca6-sty s) (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list 'IN (list (list s 'k) 'z) 'CC))))))
(define (ca6-pt s z) (list 'VNB-LAMBDA 'cpk_ 'NN (list (list s 'cpk_) z)))
;; the open set u in context: land u subset CC, u in SET, IS-OPEN(CC-MS, u), PTS(CC-MS) == CC
(define (ca6-open-facts!)
  (fact 'cc-open-subset-cc 'u)
  (fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC)
  (fact 'cc-is-metric-space) (ca6v-pts-cc!)
  (if (not (dk-asm? '(IS-OPEN CC-MS u)))
      (begin
        (dk-split-all! (list (dk-cite! 'cc-ms-open-iff 'u)))
        (dk-have! '(IS-OPEN CC-MS u) (lambda () (prop))))))
;; the focus goal (IN (VNB-LAMBDA v A body) (FUN A CC)): lam-t, PRE on the eigenvariable, beta, type, ass
(define (ca6-lam-goal! pre)
  (dk-lam-type! (lambda ()
                  (let* ((v (dk-di-var!)))
                    (ca6x-steps
                      (lambda () (pre v))
                      (lambda () (if (dk--redex? (dk-goal)) (dk-lam-b!)))
                      (lambda () (if (not (dk-asm? (dk-goal))) (ca6x-cc! (cadr (dk-goal)))))
                      (lambda () (ass)))))))
;; the typing of s at k, z (the pointwise typing in context)
(define (ca6-sval! s k z)
  (let ((typ (list 'IN (list (list s k) z) 'CC)))
    (if (not (dk-asm? typ)) (ca6-apply! (dk-ctx-form (ca6-sty s)) k z))
    typ))
;; the eps clause of UNIF-ON-COMPACTA(u, s, h) at the compact kk and eps: return N
(define (ca6-unif-tail! s h kk eps)
  (let* ((ui (dk-cite! 'unif-on-compacta 'u s h)) (ur (caddr ui)))
    (if (not (dk-asm? ur)) (dk-have! ur (lambda () (ca6x-only-prop! ui (list 'UNIF-ON-COMPACTA 'u s h)))))
    (let ((n (dk-skolem! (ca6-apply! (dk-ctx-form ur) kk eps))))
      n)))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ca6-nfm 'u)
  (list 'FORALL 's (list 'IMPLIES (ca6-sty 's)
    (list 'FORALL 'h (ca6-imps (list '(IN h (FUN u CC)) '(UNIF-ON-COMPACTA u s h))
      (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list 'CONVERGES-TO 'CC-MS (ca6-pt 's 'z) '(h z))))))))))))
(dk-peel!)
(ca6-open-facts!)
(fact 'subset-mem-fwd 'u 'CC 'z)
(fact 'fun-apply-type-c 'h 'u 'CC 'z)
(let* ((n (dk-skolem! (dk-cite! 'cc-exhaust-covers 'u 'z)))
       (kk (list 'CC-EXHAUST 'u n)))
  (dk-split-all!)
  (dk-cite! 'cc-exhaust-subset 'u n)
  (dk-cite! 'cc-exhaust-compact 'u n)
  (fact 'subset-mem-fwd kk 'u 'z)
  (mac 'CONVERGES-TO)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (ass))
              ((and (dk-head-is? g 'IN) (dk-head-is? (cadr g) 'VNB-LAMBDA))
               (subst '(== (PTS CC-MS) CC))
               (ca6-lam-goal! (lambda (v) (ca6-sval! 's v 'z))))
              ((dk-head-is? g 'IN)
               (subst '(== (PTS CC-MS) CC)) (ass))
              (#t
               (let* ((eps (cadr (car (filter (dk-head? 'POS-RR) (dk-peel!)))))
                      (nn0 (ca6-unif-tail! 's 'h kk eps)))
                 (dk-split-all!)
                 (ew nn0)
                 (dk-conj-close!
                   (lambda ()
                     (if (dk-asm? (dk-goal))
                         (ass)
                         (let* ((lk (dk-peel!))
                                (j (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) lk))))
                                (tl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm nn0) (dk-contains? fm eps))) "the tail")))
                           (dk-lam-b!)
                           (ca6-sval! 's j 'z)
                           (dk-cite! 'cc-ms-dist (list (list 's j) 'z) '(h z))
                           (subst (list '= (list '(DIST CC-MS) (list (list 's j) 'z) '(h z))
                                        (list 'magnitude (list '- (list (list 's j) 'z) '(h z)))))
                           (ca6-apply! tl j 'z)
                           (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))))))))))
(qed 'cc-unif-on-compacta-pointwise)
;;; ======================================================================
;;; (2) A SUBSEQUENCE OF A SEQUENCE IN FUN(NN, A) IS IN FUN(NN, A)
;;; ======================================================================
(define (ca6-in-of lk cls)       ; the eigenvariable of the landed typing (IN v CLS)
  (let ((hit (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) cls))) lk)))
    (if (null? hit) (error "ca6-in-of: no landed typing in" (expression->string cls)))
    (cadr (car hit))))
(define (ca6-mono-fun! phi)     ; STRICTLY-MONO-NN(phi) in context: land phi in FUN(NN, NN)
  (let ((typ (list 'IN phi '(FUN NN NN))))
    (if (not (dk-asm? typ))
        (let ((iff (dk-cite! 'strictly-mono-nn phi)))
          (dk-have! typ (lambda () (ca6x-only-prop! iff (list 'STRICTLY-MONO-NN phi))))))
    typ))
(sp (make-wff '(FORALL f (FORALL ssa_ (IMPLIES (IN f (FUN NN ssa_))
                 (FORALL phi (IMPLIES (STRICTLY-MONO-NN phi) (IN (SUBSEQ f phi) (FUN NN ssa_)))))))))
(dk-peel!)
(ca6-mono-fun! 'phi)
(mac 'SUBSEQ)
(ca6-lam-goal! (lambda (v) (fact 'fun-apply-type-c 'phi 'NN 'NN v) (fact 'fun-apply-type-c 'f 'NN 'ssa_ (list 'phi v))))
(qed 'subseq-fun-typing)

;;; ======================================================================
;;; (3) A SUBSEQUENCE OF A POINTWISE CONVERGENT SEQUENCE OF FUNCTIONS CONVERGES POINTWISE
;;; ======================================================================
(sp (make-wff (list 'FORALL 'u (list 'FORALL 's (list 'IMPLIES (ca6-sty 's)
  (list 'FORALL 'phi (list 'IMPLIES '(STRICTLY-MONO-NN phi)
    (list 'FORALL 'z (list 'IMPLIES '(IN z u)
      (list 'FORALL 'w (list 'IMPLIES (list 'CONVERGES-TO 'CC-MS (ca6-pt 's 'z) 'w)
        (list 'CONVERGES-TO 'CC-MS (ca6-pt '(SUBSEQ s phi) 'z) 'w))))))))))))
(dk-peel!)
(ca6-mono-fun! 'phi)
(let* ((pt (ca6-pt 's 'z)) (pt2 (ca6-pt '(SUBSEQ s phi) 'z)) (sl (list 'SUBSEQ pt 'phi)))
  (dk-cite! 'subseq-of-convergent 'CC-MS pt 'phi 'w)
  (dk-fun-ext! sl pt2 'NN 'CC
    (lambda () (mac 'SUBSEQ)
               (ca6-lam-goal! (lambda (v) (fact 'fun-apply-type-c 'phi 'NN 'NN v) (ca6-sval! 's (list 'phi v) 'z))))
    (lambda () (ca6-lam-goal! (lambda (v) (fact 'fun-apply-type-c 'phi 'NN 'NN v) (ca6-sval! 's (list 'phi v) 'z) (mac 'SUBSEQ))))
    (lambda (v)
      (let ((leaf (proof-state-focus *ps*)))
        (fact 'fun-apply-type-c 'phi 'NN 'NN v)
        (ca6-sval! 's (list 'phi v) 'z)
        (mac 'SUBSEQ)
        (dk-lam-b!)
        (if (not (sequent-node-grounded? leaf)) (if (dk-asm? (dk-goal)) (ass) (rfl))))))
  (subst (list '= pt2 sl))
  (if (pair? (dk-open-leaves)) (ass)))
(qed 'cc-pointwise-subseq)

;;; ======================================================================
;;; (4) A UNIFORM LIMIT ON COMPACTA AGREES WITH A POINTWISE LIMIT
;;; ======================================================================
(define ca6-ptlim '(FORALL z (IMPLIES (IN z u) (CONVERGES-TO CC-MS (VNB-LAMBDA cpk_ NN ((s cpk_) z)) (g z)))))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ca6-nfm 'u)
  (list 'FORALL 's (list 'IMPLIES (ca6-sty 's)
    (list 'FORALL 'h (ca6-imps (list '(IN h (FUN u CC)) '(UNIF-ON-COMPACTA u s h))
      (list 'FORALL 'g (ca6-imps (list '(IN g (FUN u CC)) ca6-ptlim) '(= h g)))))))))))
(dk-peel!)
(ca6-open-facts!)
(dk-fun-ext! 'h 'g 'u 'CC #f #f
  (lambda (v)
    (let ((leaf (proof-state-focus *ps*)))
      (fact 'fun-apply-type-c 'h 'u 'CC v) (fact 'fun-apply-type-c 'g 'u 'CC v)
      (dk-cite! 'cc-unif-on-compacta-pointwise 'u 's 'h v)
      (ca6-apply! (dk-ctx-form ca6-ptlim) v)
      (dk-have! (list 'IN (ca6-pt 's v) '(FUN NN CC)) (lambda () (ca6-lam-goal! (lambda (k) (ca6-sval! 's k v)))))
      (dk-cite! 'cc-limit-unique (ca6-pt 's v) (list 'h v) (list 'g v))
      (if (not (sequent-node-grounded? leaf)) (ass)))))
(qed 'cc-unif-pointwise-agree)

;;; ======================================================================
;;; (5) BOUNDED SETS OF HOLOMORPHIC FUNCTIONS: subsets, and the image of a subsequence
;;; ======================================================================
(sp (make-wff '(FORALL u (FORALL ca6b_ (IMPLIES (CC-HOL-BOUNDED u ca6b_)
                 (FORALL ca6a_ (IMPLIES (SUBSET ca6a_ ca6b_) (CC-HOL-BOUNDED u ca6a_))))))))
(dk-peel!)
(let* ((bi (dk-cite! 'cc-hol-bounded 'u 'ca6b_)) (br (caddr bi)))
  (dk-have! br (lambda () (ca6x-only-prop! bi '(CC-HOL-BOUNDED u ca6b_))))
  (dk-split-all! (list br))
  (let ((bcl (caddr br)))
    (mac 'CC-HOL-BOUNDED)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond ((dk-asm? g) (ass))
                ((dk-head-is? g 'SUBSET) (fact 'subset-trans 'ca6a_ 'ca6b_ ca6-H) (ass))
                (#t
                 (let* ((n (dk-di-var!))
                        (m (dk-skolem! (ca6-apply! (dk-ctx-form bcl) n))))
                   (dk-split-all!)
                   (ew m)
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-asm? (dk-goal))
                           (ass)
                           (let* ((lk (dk-peel!))
                                  (fv (ca6-in-of lk 'ca6a_))
                                  (zv (ca6-in-of lk (list 'CC-EXHAUST 'u n)))
                                  (fcl (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm m) (dk-contains? fm 'ca6b_))) "the bound")))
                             (fact 'subset-mem-fwd 'ca6a_ 'ca6b_ fv)
                             (ca6-apply! fcl fv zv)
                             (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass)))))))))))))))
(qed 'cc-hol-bounded-mono)

(sp (make-wff '(FORALL u (FORALL s (IMPLIES (CC-HOL-BOUNDED u (IMAGE s NN))
                 (FORALL phi (IMPLIES (STRICTLY-MONO-NN phi) (CC-HOL-BOUNDED u (IMAGE (SUBSEQ s phi) NN)))))))))
(dk-peel!)
(ca6-mono-fun! 'phi)
(dk-have! '(SUBSET (IMAGE (SUBSEQ s phi) NN) (IMAGE s NN))
  (lambda ()
    (let* ((w (subset-by-element!))
           (i1 (dk-cite! 'image-membership-iff '(SUBSEQ s phi) 'NN w)) (r1 (caddr i1)))
      (dk-have! r1 (lambda () (ca6x-only-prop! i1 (list 'IN w '(IMAGE (SUBSEQ s phi) NN)))))
      (dk-split-all! (list r1))
      (let* ((x (dk-skolem! (dk-ctx-form (caddr r1))))
             (px (list 'phi x)))
        (dk-split-all!)
        (dk-cite! 'subseq-apply 's 'phi x)
        (fact 'fun-apply-type-c 'phi 'NN 'NN x)
        (let* ((i2 (dk-cite! 'image-membership-iff 's 'NN w)) (r2 (caddr i2)))
          (dk-have! (caddr r2)
            (lambda ()
              (ew px)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal))
                      (ass)
                      (let ((leaf (proof-state-focus *ps*)))
                        (subst (list '= (list 's px) (list '(SUBSEQ s phi) x)))
                        (if (not (sequent-node-grounded? leaf)) (ass))))))))
          (dk-have! r2 (lambda () (dk-conj-close! dk-ass!)))
          (ca6x-only-prop! i2 r2))))))
(dk-cite! 'cc-hol-bounded-mono 'u '(IMAGE s NN) '(IMAGE (SUBSEQ s phi) NN))
(if (pair? (dk-open-leaves)) (ass))
(qed 'cc-hol-bounded-subseq)
;;; ======================================================================
;;; (6) COROLLARY 5.19: a bounded sequence in H(u) converging POINTWISE to g:
;;;     g in H(u), and the convergence is uniform on the compact subsets of u
;;; ======================================================================
(define (ca6-ptlim-of s0)
  (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list 'CONVERGES-TO 'CC-MS (ca6-pt s0 'z) '(g z)))))
;; (IN f H) in context: land f in FUN(u, CC) and HOLOMORPHIC-ON(u, f)
(define (ca6-hol! f)
  (let* ((hi (dk-cite! 'cc-hol-fns-membership 'u f)) (hr (caddr hi)))
    (if (not (dk-asm? hr)) (dk-have! hr (lambda () (ca6x-only-prop! hi (list 'IN f ca6-H)))))
    (dk-split-all! (list (dk-ctx-form hr)))))
;; (IN s0 (FUN NN H)) in context: land the pointwise typing of s0
(define (ca6-sty! s0)
  (if (not (dk-asm? (ca6-sty s0)))
      (dk-have! (ca6-sty s0)
        (lambda ()
          (let* ((lk (dk-peel!)) (k (ca6-in-of lk 'NN)) (z (ca6-in-of lk 'u)) (leaf (proof-state-focus *ps*)))
            (fact 'fun-apply-type-c s0 'NN ca6-H k)
            (ca6-hol! (list s0 k))
            (fact 'fun-apply-type-c (list s0 k) 'u 'CC z)
            (if (not (sequent-node-grounded? leaf)) (ass))))))
  (dk-ctx-form (ca6-sty s0)))
;; s0 in FUN(NN, H), its typing and pointwise limit g in context, phi strictly monotone:
;; the same three facts for SUBSEQ(s0, phi); returns it
(define (ca6-sub-facts! s0 phi)
  (let ((t1 (list 'SUBSEQ s0 phi)))
    (dk-cite! 'subseq-fun-typing s0 ca6-H phi)
    (ca6-sty! t1)
    (dk-have! (ca6-ptlim-of t1)
      (lambda ()
        (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*)))
          (ca6-apply! (dk-ctx-form (ca6-ptlim-of s0)) z)
          (fact 'fun-apply-type-c 'g 'u 'CC z)
          (dk-cite! 'cc-pointwise-subseq 'u s0 phi z (list 'g z))
          (if (not (sequent-node-grounded? leaf)) (ass)))))
    t1))
;; Montel on s0 (bounded): skolemise phi and the limit h; return (phi h)
(define (ca6-montel! s0)
  (let* ((phi (dk-skolem! (dk-cite! 'cc-montel 'u s0)))
         (ex (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm phi) (dk-contains? fm 'UNIF-ON-COMPACTA))) "the limit"))
         (h (dk-skolem! ex)))
    (dk-split-all!)
    (list phi h)))
(define ca6-M '(CC-FN-MODULE u (CC-CONT-FNS u)))
(define ca6-P '(CC-EXHAUST-SEMINORMS u (CC-CONT-FNS u)))
(define ca6-FR (list 'FR-METRIC-SPACE ca6-M ca6-P))
(define (ca6-vec-in! x)         ; x in C(u) in context: land x in VEC(M) and x in PTS(FR)
  (dk-have! (list 'IN x (list 'VEC ca6-M)) (lambda () (subst (list '== (list 'VEC ca6-M) ca6-C)) (ass)))
  (dk-have! (list 'IN x (list 'PTS ca6-FR)) (lambda () (subst (list '== (list 'PTS ca6-FR) (list 'VEC ca6-M))) (ass))))
(define (ca6-vec-seq! x)        ; x in FUN(NN, C(u)) in context: the same for FUN(NN, -)
  (dk-have! (list 'IN x (list 'FUN 'NN (list 'VEC ca6-M))) (lambda () (subst (list '== (list 'VEC ca6-M) ca6-C)) (ass)))
  (dk-have! (list 'IN x (list 'FUN 'NN (list 'PTS ca6-FR))) (lambda () (subst (list '== (list 'PTS ca6-FR) (list 'VEC ca6-M))) (ass))))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ca6-nfm 'u)
  (list 'FORALL 's (list 'IMPLIES (list 'IN 's (list 'FUN 'NN ca6-H)) (list 'IMPLIES (list 'CC-HOL-BOUNDED 'u '(IMAGE s NN))
    (list 'FORALL 'g (ca6-imps (list '(IN g (FUN u CC)) (ca6-ptlim-of 's))
      (list 'AND (list 'IN 'g ca6-H) '(UNIF-ON-COMPACTA u s g)))))))))))
(dk-peel!)
(ca6-open-facts!)
(dk-cite! 'cc-hol-fns-subset-cont 'u)
(fact 'fun-codomain-superset 's 'NN ca6-H ca6-C)
(ca6-sty! 's)
;; g is the limit of a subsequence in H(u): g in H(u)
(let* ((ph (ca6-montel! 's)) (phi (car ph)) (h (cadr ph))
       (t1 (ca6-sub-facts! 's phi)))
  (ca6-hol! h)
  (dk-cite! 'cc-unif-pointwise-agree 'u t1 h 'g)
  (dk-have! (list 'IN 'g ca6-H) (lambda () (subst (list '= 'g h)) (ass))))
(fact 'subset-mem-fwd ca6-H ca6-C 'g)
;; the Frechet metric space of C(u)
(dk-cite! 'cc-exhaust-seminorms-family 'u)
(dk-cite! 'cc-cont-fns-is-set 'u)
(dk-cite! 'cc-fn-module-vec 'u ca6-C)
(dk-cite! 'frm-metric-space-pts 'CC-NORMED-FIELD ca6-M ca6-P)
(dk-cite! 'frm-metric-space-is-metric-space 'CC-NORMED-FIELD ca6-M ca6-P)
(ca6-vec-in! 'g)
(ca6-vec-seq! 's)
;; every subsequence has a subsequence converging to g in the metric
(let* ((spr (dk-cite! 'subsequence-principle ca6-FR 's 'g))
       (claim (cadr spr)))
  (dk-have! claim
    (lambda ()
      (let* ((phi (cadr (car (filter (dk-head? (quote STRICTLY-MONO-NN)) (dk-peel!)))))
             (t1 (begin (ca6-mono-fun! phi) (ca6-sub-facts! 's phi))))
        (dk-cite! 'cc-hol-bounded-subseq 'u 's phi)
        (let* ((ph (ca6-montel! t1)) (psi (car ph)) (h (cadr ph))
               (t2 (ca6-sub-facts! t1 psi)))
          (ca6-hol! h)
          (dk-cite! 'cc-unif-pointwise-agree 'u t2 h 'g)
          (dk-have! (list 'UNIF-ON-COMPACTA 'u t2 'g) (lambda () (subst (list '= 'g h)) (ass)))
          (fact 'fun-codomain-superset t2 'NN ca6-H ca6-C)
          (let ((ci (dk-cite! 'cc-fr-conv-iff-unif-on-compacta 'u t2 'g)))
            (dk-have! (list 'FR-CONV ca6-M ca6-P t2 'g) (lambda () (ca6x-only-prop! ci (list 'UNIF-ON-COMPACTA 'u t2 'g)))))
          (ca6-vec-seq! t2)
          (dk-cite! 'frm-converges-of-conv 'CC-NORMED-FIELD ca6-M ca6-P t2 'g)
          (ew psi)
          (dk-conj-close! dk-ass!)))))
  (detach! spr))
(dk-cite! 'frm-conv-of-converges 'CC-NORMED-FIELD ca6-M ca6-P 's 'g)
(let ((ci (dk-cite! 'cc-fr-conv-iff-unif-on-compacta 'u 's 'g)))
  (dk-have! '(UNIF-ON-COMPACTA u s g) (lambda () (ca6x-only-prop! ci (list 'FR-CONV ca6-M ca6-P 's 'g)))))
(dk-conj-close! dk-ass!)
(qed 'cc-montel-pointwise-limit)
;;; ======================================================================
;;; (7) THE MINIMUM MODULUS ON A DISC: g holomorphic on u, the disc B(c, R) inside u, g /= a on
;;;     B(c, R), m > 0 with m <= |g - a| on the circle of radius r < R: m <= |g(c) - a|
;;;     (the mean value inequality, holomorphic-mean-value-bound, for 1/(g - a))
;;; ======================================================================
(define (ca6-fin! leaf) (if (not (sequent-node-grounded? leaf)) (ass)))
(define (ca6-tr c r) (list 'TRACE (list 'CIRCLE-PATH c r) 0 '(* 2 PI)))
(define (ca6-pos-parts! q)      ; (< 0 q), (IN q RR) in context: land 0 <= q and NOT 0 = q, the ball conjunction
  (dk-have! (list '<= 0 q) (lambda () (dk-ineq! (list '< 0 q))))
  (dk-have! (list 'NOT (list '= 0 q)) (lambda () (di) (dk-absurd! (list '= 0 q) (list '< 0 q))))
  (ca6x-and! (list 'IN q 'RR) (ca6x-and! (list '<= 0 q) (list 'NOT (list '= 0 q)))))
;; the disc B = BALL(CC-MS, c, q): open (both spellings), c in B, B subset CC
(define (ca6-disc! c q)
  (let ((bb (list 'BALL 'CC-MS c q)))
    (fact 'cc-is-metric-space) (ca6v-pts-cc!)
    (if (not (dk-asm? (list 'IN c '(PTS CC-MS))))
        (dk-have! (list 'IN c '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass))))
    (ca6-pos-parts! q)
    (dk-cite! 'ball-is-open 'CC-MS c q)
    (dk-cite! 'ball-center-in 'CC-MS c q)
    (let ((oi (dk-cite! 'cc-ms-open-iff bb)))
      (if (not (dk-asm? (list 'IS-OPEN ca6-nfm bb)))
          (dk-have! (list 'IS-OPEN ca6-nfm bb) (lambda () (ca6x-only-prop! oi (list 'IS-OPEN 'CC-MS bb))))))
    (fact 'cc-open-subset-cc bb)
    bb))
;; y /= a from (- y a) = 0 is absurd: land NOT (- (g y) a) = 0 from NOT (g y) = a
(define (ca6-sub-ne! gy a)
  (let ((d (list '- gy a)))
    (ca6x-cc! gy) (ca6x-cc! a) (ca6x-cc! d)
    (dk-have! (list 'NOT (list '= d 0))
      (lambda ()
        (di)
        (dk-have! (list '= gy (list '+ d a)) (lambda () (crs)))
        (dk-have! (list '= gy a)
          (lambda ()
            (subst (list '= gy (list '+ d a)))
            (subst (list '= d 0))
            (crs)))
        (ca6x-only-prop! (list '= gy a) (list 'NOT (list '= gy a)))))))

(define ca6-K-ne '(FORALL hdy_ (IMPLIES (IN hdy_ (BALL CC-MS c hdq_)) (NOT (= (g hdy_) hda_)))))
(define ca6-K-low (list 'FORALL 'hdy_ (list 'IMPLIES (list 'IN 'hdy_ (ca6-tr 'c 'r)) '(<= hdm_ (magnitude (- (g hdy_) hda_))))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'g (list 'IMPLIES '(HOLOMORPHIC-ON u g)
  (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'r (ca6-imps '((IN r RR) (< 0 r))
    (list 'FORALL 'hdq_ (ca6-imps '((IN hdq_ RR) (< r hdq_) (SUBSET (BALL CC-MS c hdq_) u))
      (list 'FORALL 'hda_ (ca6-imps (list '(IN hda_ CC) ca6-K-ne)
        (list 'FORALL 'hdm_ (ca6-imps (list '(IN hdm_ RR) '(< 0 hdm_) ca6-K-low)
          '(<= hdm_ (magnitude (- (g c) hda_))))))))))))))))))
(dk-peel!)
(fact 'holomorphic-on-open 'u 'g) (fact 'holomorphic-on-in-fun 'u 'g) (fact 'cc-open-subset-cc 'u)
(dk-have! '(< 0 hdq_) (lambda () (dk-ineq! '(< 0 r) '(< r hdq_))))
(dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
(let* ((bb (ca6-disc! 'c 'hdq_))
       (hh (list 'VNB-LAMBDA 'hdz_ bb '(recip (- (g hdz_) hda_))))
       (bm '(recip hdm_)))
  (dk-have! (list 'FORALL 'dkdoy_ (list 'IMPLIES (list 'IN 'dkdoy_ bb) '(IN dkdoy_ u)))
    (lambda () (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*))) (fact 'subset-mem-fwd bb 'u y) (ca6-fin! leaf))))
  (dk-have! (list 'FORALL 'hdy_ (list 'IMPLIES (list 'IN 'hdy_ bb) '(NOT (= (- (g hdy_) hda_) 0))))
    (lambda ()
      (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*)))
