        (ca6-apply! (dk-ctx-form ca6-K-ne) y)
        (ca6-sub-ne! (list 'g y) 'hda_)
        (ca6-fin! leaf))))
  (dk-have! (list 'HOLOMORPHIC-ON bb hh) (lambda () (dk-holomorphic! bb hh)))
  (ca6x-rr! bm)
  (dk-cite! 'rr-recip-pos 'hdm_)
  (fact 'subset-refl bb)
  (dk-have! (list 'FORALL 'cmvy_ (list 'IMPLIES (list 'IN 'cmvy_ (ca6-tr 'c 'r)) (list '<= (list 'magnitude (list hh 'cmvy_)) bm)))
    (lambda ()
      (let* ((y (dk-di-var!)) (leaf (proof-state-focus *ps*))
             (w (list '- (list 'g y) 'hda_)))
        (dk-split! (dk-cite! 'circle-trace-in-punctured-ball 'c 'r 'hdq_ y))
        (fact 'subset-mem-fwd bb 'u y) (fact 'fun-apply-type-c 'g 'u 'CC y)
        (ca6x-cc! w)
        (ca6-apply! (dk-ctx-form (list 'FORALL 'hdy_ (list 'IMPLIES (list 'IN 'hdy_ bb) '(NOT (= (- (g hdy_) hda_) 0))))) y)
        (dk-lam-b!)
        (dk-cite! 'aif-magnitude-recip w)
        (subst (list '= (list 'magnitude (list 'recip w)) (list 'recip (list 'magnitude w))))
        (ca6-apply! (dk-ctx-form ca6-K-low) y)
        (ca6x-rr! (list 'magnitude w))
        (dk-cite! 'rr-recip-antitone 'hdm_ (list 'magnitude w))
        (ca6-fin! leaf))))
  (dk-cite! 'holomorphic-mean-value-bound bb hh 'c 'r 'hdq_ bm)
  (let* ((w0 '(- (g c) hda_)) (d (list 'magnitude w0)) (rd (list 'recip d)))
    (fact 'subset-mem-fwd bb 'u 'c) (fact 'fun-apply-type-c 'g 'u 'CC 'c)
    (ca6x-cc! w0)
    (ca6-apply! (dk-ctx-form (list 'FORALL 'hdy_ (list 'IMPLIES (list 'IN 'hdy_ bb) '(NOT (= (- (g hdy_) hda_) 0))))) 'c)
    (ca6x-cc! (list 'recip w0))
    (dk-have! (list '= (list hh 'c) (list 'recip w0)) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl)))))
    (let* ((h1 (dk-rewrite-h! (list '<= (list 'magnitude (list hh 'c)) bm) (list hh 'c) (list 'recip w0))))
      (dk-cite! 'aif-magnitude-recip w0)
