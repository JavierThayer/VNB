(define (c6m-fk-hol! a mu f feq k)                ; HOLOMORPHIC-ON(CC, f_k) from the values of f_k
  (let* ((c (list 'recip (list a k))) (el (c6w-el c (list mu k))))
    (fact 'fun-apply-type-c a 'NN 'CC k) (fact 'fun-apply-type-c mu 'NN 'NN k) (dk-apply! (dk-ctx-form (c6w-anz a)) k)
    (c6-and! (list 'IN (list a k) 'CC) (list 'NOT (list '= (list a k) 0))) (fact 'cc-recip-closed (list a k))
    (fact 'fun-apply-type-c f 'NN '(FUN CC CC) k)
    (c6f-typ-on! el 'CC (lambda (x) (let ((xc (list '* x c))) (c6f-cc-and-closed! 'cc-mul-closed x c) (c6w-e-typ! (list mu k) xc) (c6-cc! (list '- (c6w-e (list mu k) xc) 1)))))
    (c6-cite! 'weier-e-holomorphic (list mu k) c)
    (dk-have! (c6f-ptw 'CC (list f k) (lambda (y) (list el y)))
      (lambda () (let ((y (dk-di-var!))) (subst (dk-apply! feq k y)) (dk-lam-b!) (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
    (c6-cite! 'holomorphic-transfer-ptwise-eq 'CC (list f k) el)))
(define (c6m-gnn! a mu r k)                       ; 0 <= r: (r / |a_k|)^{mu_k + 1} / (mu_k + 1) real and >= 0
  (let* ((ma (list 'magnitude (list a k))) (rma (list 'recip ma)) (b (list '* r rma)) (m (list 'succ (list mu k)))
         (gb (list '* (list 'power b m) (list 'recip m))))
    (if (not (dk-asm? (list '<= 0 gb)))
        (begin
          (fact 'fun-apply-type-c a 'NN 'CC k) (fact 'fun-apply-type-c mu 'NN 'NN k) (dk-apply! (dk-ctx-form (c6w-anz a)) k)
          (c6-mag! (list a k)) (fact 'nn-succ-closed (list mu k)) (c6-nn! m) (c6-nn! (list mu k))
          (let ((iff (c6-cite! 'cc-magnitude-zero-iff (list a k))))
            (dk-have! (list 'NOT (list '= ma 0)) (lambda () (keep iff (list 'NOT (list '= (list a k) 0))) (prop))))
          (c6-and! (list 'IN ma 'RR) (list 'NOT (list '= ma 0))) (fact 'rr-recip-closed ma)
          (dk-have! (list 'NOT (list '= 0 ma)) (lambda () (di) (dk-have! (list '= ma 0) (lambda () (subst (list '= 0 ma)) (c6f-rfl-close!))) (ai (list 'NOT (list '= ma 0)))))
          (c6-and! (list '<= 0 ma) (list 'NOT (list '= 0 ma))) (c6-cite! 'rr-le-ne-lt 0 ma) (c6-cite! 'rr-recip-pos ma)
          (dk-have! (list '<= 0 rma) (lambda () (dk-ineq! (list '< 0 rma))))
          (c6-rr! b) (c6w-mul-nonneg! r rma) (fact 'power-real-closed b m) (fact 'rr-power-nonneg m b)
          (dk-have! (list '< 0 m) (lambda () (fact 'nn-zero-le (list mu k)) (fact 'nn-succ-plus-one (list mu k)) (dk-ineq! (list '<= 0 (list mu k)) (list '= m (list '+ (list mu k) 1)))))
          (c6-cite! 'rr-pos-ne-zero m) (c6-and! (list 'IN m 'RR) (list 'NOT (list '= m 0))) (fact 'rr-recip-closed m) (c6-cite! 'rr-recip-pos m)
          (dk-have! (list '<= 0 (list 'recip m)) (lambda () (dk-ineq! (list '< 0 (list 'recip m)))))
          (c6w-mul-nonneg! (list 'power b m) (list 'recip m)) (c6-rr! gb)))
    gb))

