(define (c6m-pick-afz new)
  (list (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) '(FUN NN CC)))) new))
        (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) '(FUN NN NN)))) new))
        (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) '(FUN NN (FUN CC CC))))) new))
