;;; ---------------------------------------------------------------- the order of the finite partial products
(define (c6m-gk f n) (list 'VNB-LAMBDA 'c6x_ 'CC (list '+ 1 (list (list f n) 'c6x_))))
(define (c6m-hk a mu n) (list 'VNB-LAMBDA 'c6x_ 'CC (list '* (list '- (list 'recip (list a n))) (list 'CC-EXP (c6w-qs (list '* 'c6x_ (list 'recip (list a n))) (list 'succ (list mu n)))))))
;;; the factor 1 + f_n = E_{mu_n}(x / a_n): order 1 at a_n
(sp (make-wff (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC)) (list 'IMPLIES (c6w-anz 'c6a_)
  (list 'FORALL 'c6u_ (list 'IMPLIES '(IN c6u_ (FUN NN NN))
    (list 'FORALL 'c6f_ (list 'IMPLIES '(IN c6f_ (FUN NN (FUN CC CC))) (list 'IMPLIES (c6w-feq 'c6f_ 'c6a_ 'c6u_)
      (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'HAS-ZERO-OF-ORDER 'CC (c6m-gk 'c6f_ 'c6n_) '(c6a_ c6n_) 1)))))))))))))
(let* ((new (c6-steps!))
       (a (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) '(FUN NN CC)))) new)))
       (mu (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) '(FUN NN NN)))) new)))
       (f (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) '(FUN NN (FUN CC CC))))) new)))
       (n (c6-var new 'NN)) (an (list a n)) (ra (list 'recip an)) (mn (list mu n))
       (feq (dk-ctx-form (c6w-feq f a mu))) (gk (c6m-gk f n)) (hk (c6m-hk a mu n)) (ql (c6w-ql ra (list 'succ mn))))
  (c6w-cc-setup!) (fact 'nn-is-set) (fact 'cc-is-metric-space) (c6-pts!)
  (fact 'fun-apply-type-c a 'NN 'CC n) (fact 'fun-apply-type-c mu 'NN 'NN n) (fact 'nn-succ-closed mn)
  (dk-apply! (dk-ctx-form (c6w-anz a)) n)
  (c6-and! (list 'IN an 'CC) (list 'NOT (list '= an 0))) (fact 'cc-recip-closed an) (fact 'cc-recip-inverse an)
  (c6-cc! (list '- ra))
  (fact 'carrier-is-open 'CC-MS)
  (dk-have! '(IS-OPEN CC-MS CC) (lambda () (subst '(== CC (PTS CC-MS))) (dk-ass!)))
  (let ((oi (c6-cite! 'cc-ms-open-iff 'CC))) (dk-have! (list 'IS-OPEN c6-nfm 'CC) (lambda () (keep oi '(IS-OPEN CC-MS CC)) (prop))))
  (fact 'fun-apply-type-c f 'NN '(FUN CC CC) n)
  ;; h is holomorphic and h(a_n) /= 0
  (let* ((hq (c6-cite! 'weier-q-holomorphic (list 'succ mn) ra))
         (qv (begin (c6w-ql-typ! ra (list 'succ mn)) (dk-name! ql '(FUN CC CC))))
         (tg (list 'VNB-LAMBDA 'c6x_ 'CC (list '* (list '- ra) (list 'CC-EXP (list qv 'c6x_))))))
    (dk-rewrite-h! hq ql qv)
    (dk-have! (list 'HOLOMORPHIC-ON 'CC tg) (lambda () (dk-holomorphic! 'CC tg)))
    (c6f-typ-on! hk 'CC (lambda (x) (let ((xc (list '* x ra))) (c6f-cc-and-closed! 'cc-mul-closed x ra) (c6w-coef-typ! xc)
                                      (dk-cite! 'cc-series-partial-sum-in-cc (list 'succ mn) (c6w-coef xc)) (c6w-exp-typ! (c6w-qs xc (list 'succ mn)))
                                      (c6f-cc-and-closed! 'cc-mul-closed (list '- ra) (list 'CC-EXP (c6w-qs xc (list 'succ mn)))))))
    (dk-have! (c6f-ptw 'CC hk (lambda (y) (list tg y)))
      (lambda () (let ((x (dk-di-var!))) (c6f-cc-and-closed! 'cc-mul-closed x ra) (dk-lam-b!) (subst (list '= qv ql)) (dk-lam-b!) (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
    (c6-cite! 'holomorphic-transfer-ptwise-eq 'CC hk tg))
  ;; g_n is holomorphic
  (let* ((el (c6w-el ra mn)))
    (c6-cite! 'weier-e-holomorphic mn ra)
    (c6f-typ-on! gk 'CC (lambda (x) (fact 'fun-apply-type-c (list f n) 'CC 'CC x) (c6-cc! (list '+ 1 (list (list f n) x)))))
    (c6f-typ-on! el 'CC (lambda (x) (let ((xc (list '* x ra))) (c6f-cc-and-closed! 'cc-mul-closed x ra) (c6w-e-typ! mn xc) (c6-cc! (list '- (c6w-e mn xc) 1)))))
    (let ((ev (dk-name! el '(FUN CC CC))))
      (dk-rewrite-h! (list 'HOLOMORPHIC-ON 'CC el) el ev)
      (let ((tg (list 'VNB-LAMBDA 'c6x_ 'CC (list '+ 1 (list ev 'c6x_)))))
        (dk-have! (list 'HOLOMORPHIC-ON 'CC tg) (lambda () (dk-holomorphic! 'CC tg)))
        (dk-have! (c6f-ptw 'CC gk (lambda (y) (list tg y)))
          (lambda () (let ((x (dk-di-var!))) (dk-lam-b!) (subst (dk-apply! feq n x)) (subst (list '= ev el)) (dk-lam-b!) (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
        (c6-cite! 'holomorphic-transfer-ptwise-eq 'CC gk tg))))
  (dk-have! '(IN 1 NN) (lambda () (arith)))
  (mac 'HAS-ZERO-OF-ORDER)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-asm? (dk-goal)) (dk-ass!))
            ((dk-head-is? (dk-goal) 'FORSOME)
             (ew hk)
             (dk-conj-close!
               (lambda ()
                 (cond ((dk-asm? (dk-goal)) (dk-ass!))
                       ((dk-head-is? (dk-goal) 'NOT)
                        (let* ((w (list '* an ra)) (q (c6w-qs w (list 'succ mn))))
                          (c6-cc! w) (c6w-coef-typ! w) (dk-cite! 'cc-series-partial-sum-in-cc (list 'succ mn) (c6w-coef w)) (c6w-exp-typ! q)
                          (c6-cite! 'cc-exp-nonzero q)
                          (dk-have! (list 'NOT (list '= (list '- ra) 0))
                            (lambda () (let ((r (dk-name! ra 'CC)))
                                       (subst (list '= ra r)) (dk-rewrite-h! (list '= (list '* an ra) 1) ra r)
                                       (di)
                                       (dk-have! (list '= r (list '- 0 (list '- r))) (lambda () (crs)))
                                       (dk-have! '(= 1 0) (lambda () (subst (list '= 1 (list '* an r))) (subst (list '= r (list '- 0 (list '- r)))) (subst (list '= (list '- r) 0)) (crs))))
                                       (dk-absurd! '(= 1 0))))
                          (dk-lam-b!)
                          (dk-close-if! (lambda () (dk-cite! 'cc-mul-nonzero (list '- ra) (list 'CC-EXP q))) (lambda () (dk-ass!)))))
                       (#t
                        (let* ((y (dk-di-var!)) (ya (list '- y an)) (w (list '* y ra)) (q (c6w-qs w (list 'succ mn))) (eq (list 'CC-EXP q)))
                          (c6f-cc-and-closed! 'cc-mul-closed y ra) (c6-cc! ya) (c6w-coef-typ! w) (dk-cite! 'cc-series-partial-sum-in-cc (list 'succ mn) (c6w-coef w)) (c6w-exp-typ! q)
                          (dk-lam-b!)
                          (subst (dk-apply! feq n y))
                          (subst (dk-fact! 'nn-one-is-succ-zero))
                          (fact 'nn-zero-in) (c6-and! (list 'IN ya 'CC) '(IN 0 NN))
                          (subst (dk-fact! 'power-succ ya 0)) (subst (dk-cite! 'power-zero ya))
                          (let* ((v (dk-name! eq 'CC)) (r (dk-name! ra 'CC)))
                            (subst (list '= eq v)) (subst (list '= ra r))
                            (dk-rewrite-h! (list '= (list '* an ra) 1) ra r)
                            (let* ((lhs (list '+ 1 (list '- (list '* (list '- 1 (list '* y r)) v) 1)))
                                   (mid (list '+ (list '* (list '* (list '- 1 (list '* y r)) v) 1) 0)))
                              (dk-have! (list '= (list '* (list '* ya 1) (list '* (list '- r) v)) (list '- (list '* (list '* an r) v) (list '* (list '* y r) v))) (lambda () (crs)))
                              (subst (list '= (list '* (list '* ya 1) (list '* (list '- r) v)) (list '- (list '* (list '* an r) v) (list '* (list '* y r) v))))
                              (subst (list '= (list '* an r) 1))
                              (crs)))))))))
            (#t (dk-ass!))))))
(qed 'weier-factor-order-one)

