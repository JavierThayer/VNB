;;; ---------------------------------------------------------------- limits of shifted sequences
;;; s -> L and h(j) = s(N + j): h -> L
;;; KIT-9 link skipping, opt-in per file since 2026-10-29 (this file was developed with it on); guarded for bands that predate it

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

;;; ---- helper defines COPIED 2026-10-30 (wave-2 integration) from ch6/ch6-fun.scm, ch6/ch6-prod.scm, ch6/ch6-weier.scm, ch6/zero-order-laws.scm:
;;; the probe loaded this chain in ONE environment; load.scm gives each file its own.
(define (c6-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (c6-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (c6-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (c6-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))
(define (c6-nn! n) (fact 'nn-in-rr n) (fact 'rr-subset-cc n))
(define (c6-has-sub? t u) (or (equal? t u) (and (pair? t) (any-pred (lambda (x) (c6-has-sub? x u)) t))))
(define (c6-steps!)                          ; peel FORALL / IMPLIES; return the landed formulas
  (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
(define (c6-var new cls) (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (c6-vars new cls) (map cadr (filter (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (c6-tl f n) (list 'VNB-LAMBDA 'c6k_ 'NN (list f (list '+ n 'c6k_))))
(define (c6-tl-typ! f n)                     ; f in FUN(NN, CC), n in NN: the tail sequence is in FUN(NN, CC)
  (let ((typ (list 'IN (c6-tl f n) '(FUN NN CC))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let* ((k (dk-di-var!)) (nk (list '+ n k)))
                  (c6-and! (list 'IN n 'NN) (list 'IN k 'NN)) (fact 'nn-add-closed n k)
                  (fact 'fun-apply-type-c f 'NN 'CC nk)
                  (dk-ass!)))
              (lambda () (fact 'nn-is-set) (dk-ass!))))))
    typ))
(define (c6-lam-typ! lam cod typer)          ; (IN lam (FUN NN cod)); TYPER gets the eigenvariable, must ground
  (let ((typ (list 'IN lam (list 'FUN 'NN cod))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda () (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*))) (typer k) (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
              (lambda () (fact 'nn-is-set) (dk-ass!))))))
    typ))
(define (c6-mag! t) (fact 'cc-magnitude-closed t) (fact 'cc-magnitude-nonneg t) (list 'magnitude t))
(define (c6-nonneg r) (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list '<= 0 (list r 'c6i_)))))
(define (c6-chain-end f) (if (c6-op? f 'IMPLIES 3) (c6-chain-end (caddr f)) f))
(define (c6-cite! . args)                     ; dk-cite! that refuses to return an undetached implication link
  (let ((r (apply dk-cite! args)))
    (cond ((not (c6-op? r 'IMPLIES 3)) r)
          ((dk-asm? (c6-chain-end r)) (dk-ctx-form (c6-chain-end r)))     ; the consequent was already in context
          (#t (error "c6-cite!: the chain stopped at an antecedent not in context" (car args) (expression->string (cadr r)))))))
(define (c6-pts!)
  (fact 'cc-is-metric-space)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (c6-sk! ex) (dk-skolem! (dk-ctx-form ex) #t))
(define (c6-nk! nv k)                         ; nv, k in NN: (+ nv k) in NN, RR, CC and nv <= nv + k
  (let ((j (list '+ nv k)))
    (c6-and! (list 'IN nv 'NN) (list 'IN k 'NN)) (fact 'nn-add-closed nv k) (c6-nn! nv) (c6-nn! k) (c6-nn! j) (fact 'nn-zero-le k)
    (if (not (dk-asm? (list '<= nv j))) (dk-have! (list '<= nv j) (lambda () (dk-ineq! (list '<= 0 k)))))
    j))
(define (c6-famty u f) (list 'IN f (list 'FUN 'NN (list 'FUN u 'CC))))
(define (c6-sn f xs) (list 'VNB-LAMBDA 'cpsi_ 'NN (list 'CC-SUP-NORM (list f 'cpsi_) xs)))
(define (c6-fv! f u k y)                        ; f in FUN(NN, FUN(u, CC)), k in NN, y in u: f_k in FUN(u, CC), f_k(y) in CC
  (fact 'fun-apply-type-c f 'NN (list 'FUN u 'CC) k) (fact 'fun-apply-type-c (list f k) u 'CC y))
(define (c6-opx f x) (list 'VNB-LAMBDA 'c6k_ 'NN (list '+ 1 (list (list f 'c6k_) x))))
(define c6-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (c6-famhol u f) (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list 'HOLOMORPHIC-ON u (list f 'c6i_)))))
(define (c6-ppx u f n) (list 'VNB-LAMBDA 'c6x_ u (list 'PPROD (c6-opx f 'c6x_) n)))
(define (c6-sn-setup! u f n pn)
  (let* ((kn (list 'CC-EXHAUST u n)) (sn (c6-sn f kn)))
    (dk-have! (list 'IS-NORMALLY-CONVERGENT f kn)
      (lambda () (dk-split-all! (dk-landed (lambda () (mac-h 'PROD-NORMAL-ON-COMPACTA (dk-ctx-form pn)))))
                 (dk-apply! (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'IS-NORMALLY-CONVERGENT))) (dk-asms)) n)
                 (dk-ass!)))
    (dk-split-all! (dk-landed (lambda () (mac-h 'IS-NORMALLY-CONVERGENT (list 'IS-NORMALLY-CONVERGENT f kn)))))
    (c6-cite! 'cc-exhaust-subset u n)
    (let* ((snr (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'CC-SUP-NORM) (dk-contains? q kn) (not (dk-contains? q 'SERIES-CONVERGES)))) (dk-asms)))
           (kty! (lambda (k)
                   (dk-have! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y kn) (list 'IN (list (list f k) 'y) 'CC)))
                     (lambda () (let ((y (dk-di-var!))) (fact 'subset-mem-fwd kn u y) (c6-fv! f u k y) (dk-ass!))))))
           (up! (lambda (k x)
                  (fact 'subset-mem-fwd kn u x) (c6-fv! f u k x) (c6-mag! (list (list f k) x))
                  (kty! k) (dk-apply! snr k)
                  (dk-apply! (c6-cite! 'cc-sup-norm-upper (list f k) kn) x))))
      (c6-lam-typ! sn 'RR (lambda (k) (dk-apply! snr k) (dk-ass!)))
      (dk-have! (c6-nonneg sn)
        (lambda () (let* ((k (dk-di-var!)) (snk (list 'CC-SUP-NORM (list f k) kn)))
                     (dk-lam-b!) (dk-apply! snr k) (kty! k)
                     (let ((ab (list 'abs snk)))
                       (fact 'rr-abs-closed snk) (c6-cite! 'rr-abs-nonneg snk) (c6-rr! (list '- snk)) (fact 'rr-abs-closed (list '- snk))
                       (c6-cite! 'rr-neg-abs-le (list '- snk))
                       (dk-have! (list '<= snk ab) (lambda () (c6-cite! 'rr-abs-neg snk) (dk-ineq! (dk-ctx-form (list '<= (list '- (list 'abs (list '- snk))) (list '- snk))) (list '= (list 'abs (list '- snk)) ab))))
                       (dk-have! (list 'FORALL 'cpsx_ (list 'IMPLIES (list 'IN 'cpsx_ kn) (list '<= (list 'magnitude (list (list f k) 'cpsx_)) ab)))
                         (lambda () (let ((x (dk-di-var!))) (up! k x) (dk-ineq! (list '<= (list 'magnitude (list (list f k) x)) snk) (list '<= snk ab)))))
                       (dk-split-all! (list (c6-cite! 'cc-sup-norm-bound (list f k) kn ab)))
                       (dk-ass!)))))
      (list sn snr up!))))
(define (c6f-typ-on! lam u typer)              ; (IN lam (FUN u CC)); TYPER gets the eigenvariable
  (let ((typ (list 'IN lam (list 'FUN u 'CC))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*))) (typer x) (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
              (lambda () (dk-ass!))))))
    typ))
(define (c6f-ptw u h rhs-of)                   ; forall y in u. h(y) == RHS(y)
  (list 'FORALL 'c6y_ (list 'IMPLIES (list 'IN 'c6y_ u) (list '== (list h 'c6y_) (rhs-of 'c6y_)))))
(define (c6f-ppx-typ! u f n)
  (c6f-typ-on! (c6-ppx u f n) u
    (lambda (x) (c6-lam-typ! (c6-opx f x) 'CC (lambda (k) (c6-fv! f u k x) (fact 'cc-one-in) (c6-cc! (list '+ 1 (list (list f k) x)))))
                (dk-cite! 'pprod-in-cc n (c6-opx f x)))))
(define (c6f-lb!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
(define (c6f-tl-eq tv gv nv) (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list '= (list tv 'c6j_) (list gv (list '+ nv 'c6j_))))))
(define (c6f-pick-u new) (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) new)))
(define (c6f-pick-f new) (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (c6-op? (caddr q) 'FUN 3) (eq? (cadr (caddr q)) 'NN) (c6-op? (caddr (caddr q)) 'FUN 3))) new)))
(define (c6f-rfl-close!) (dk-close-if! (lambda () #t) (lambda () (rfl))))
(define (c6f-lb-close!) (dk-close-if! (lambda () (c6f-lb!)) (lambda () (dk-ass!))))
(define (c6f-cc-and-closed! law x y)            ; law cc-mul-closed / cc-add-closed: (IN (op x y) CC)
  (c6-and! (list 'IN x 'CC) (list 'IN y 'CC)) (fact law x y))
(define (c6w-coef w) (list 'VNB-LAMBDA 'clhk_ 'NN (list '* (list 'RECIP-STAR 'clhk_) (list 'power w 'clhk_))))
(define (c6w-qs w m) (list 'CC-SERIES-PARTIAL-SUM (c6w-coef w) m))
(define (c6w-e n w) (list '* (list '- 1 w) (list 'CC-EXP (c6w-qs w (list 'succ n)))))
(define (c6w-exp-typ! q) (if (not (dk-asm? (list 'IN (list 'CC-EXP q) 'CC))) (dk-split-all! (list (dk-cite! 'cc-exp-converges q)))))
(define (c6w-e-typ! n w)
  (let ((q (c6w-qs w (list 'succ n))))
    (fact 'nn-succ-closed n) (c6w-coef-typ! w) (dk-cite! 'cc-series-partial-sum-in-cc (list 'succ n) (c6w-coef w))
    (c6w-exp-typ! q) (fact 'cc-one-in) (c6-cc! (list '- 1 w))
    (if (not (dk-asm? (list 'IN (c6w-e n w) 'CC))) (c6f-cc-and-closed! 'cc-mul-closed (list '- 1 w) (list 'CC-EXP q)))))
(define (c6w-mul-nonneg! x y)                    ; x, y in RR and >= 0 in context: 0 <= x y (no typing of the product needed)
  (c6-and! (list 'IN x 'RR) (list 'IN y 'RR)) (c6-and! (list '<= 0 x) (list '<= 0 y)) (fact 'rr-leq-mul-nonneg x y))
(define (c6w-cc-setup!) (fact 'cc-is-set) (fact 'cc-one-in) (fact 'cc-zero-in) (fact 'nn-zero-in) (fact 'rr-zero-in) (fact 'rr-one-in))
(define (c6w-pow-typ! w m)                       ; w in CC, m in NN: w^m in CC
  (c6-and! (list 'IN w 'CC) (list 'IN m 'NN)) (fact 'power-typing-nonneg w m) (list 'IN (list 'power w m) 'CC))
(define (c6w-ql c m) (list 'VNB-LAMBDA 'c6x_ 'CC (c6w-qs (list '* 'c6x_ c) m)))
(define (c6w-coef-typ! w)                         ; w in CC: k -> RECIP-STAR(k) w^k in FUN(NN, CC)
  (c6-lam-typ! (c6w-coef w) 'CC (lambda (k) (c6-nn! k) (fact 'recip-star-in-rr k) (fact 'rr-subset-cc (list 'RECIP-STAR k))
                                    (c6w-pow-typ! w k) (c6f-cc-and-closed! 'cc-mul-closed (list 'RECIP-STAR k) (list 'power w k)))))
(define (c6w-ql-typ! c m)
  (c6f-typ-on! (c6w-ql c m) 'CC (lambda (x) (c6f-cc-and-closed! 'cc-mul-closed x c) (c6w-coef-typ! (list '* x c))
                                  (dk-cite! 'cc-series-partial-sum-in-cc m (c6w-coef (list '* x c))))))
(define (c6w-el c n) (list 'VNB-LAMBDA 'c6x_ 'CC (list '- (c6w-e n (list '* 'c6x_ c)) 1)))
(define (c6w-induct-on! v base step)             ; after (ni) on the variable V: the step leaf is the one whose goal mentions V
  (let* ((ls (dk-open-leaves)) (st (find-first (lambda (l) (dk-contains? (dk-goal-of l) v)) ls))
         (b (find-first (lambda (l) (not (eq? l st))) ls)))
    (if (not (and b st)) (error "c6w-induct-on!: leaves not found"))
    (dk-focus! b) (base) (dk-focus! st) (step)))
(define (c6w-h167 a mu)
  (list 'FORALL 'c6r_ (list 'IMPLIES '(IN c6r_ RR) (list 'IMPLIES '(<= 0 c6r_)
    (list 'SERIES-CONVERGES (list 'VNB-LAMBDA 'c6k_ 'NN (list '* (list 'power (list '* 'c6r_ (list 'recip (list 'magnitude (list a 'c6k_)))) (list 'succ (list mu 'c6k_)))
                                                          (list 'recip (list 'succ (list mu 'c6k_))))))))))
(define (c6w-grow a)
  (list 'FORALL 'c6r_ (list 'IMPLIES '(IN c6r_ RR)
    (list 'FORSOME 'c6m_ (list 'AND '(IN c6m_ NN) (list 'FORALL 'c6q_ (list 'IMPLIES '(IN c6q_ NN) (list 'IMPLIES '(<= c6m_ c6q_) (list '<= 'c6r_ (list 'magnitude (list a 'c6q_)))))))))))
(define (c6w-anz a) (list 'FORALL 'c6q_ (list 'IMPLIES '(IN c6q_ NN) (list 'NOT (list '= (list a 'c6q_) 0)))))
(define (c6w-feq f a mu)
  (list 'FORALL 'c6k_ (list 'IMPLIES '(IN c6k_ NN) (list 'FORALL 'c6x_ (list 'IMPLIES '(IN c6x_ CC)
    (list '= (list (list f 'c6k_) 'c6x_) (list '- (c6w-e (list mu 'c6k_) (list '* 'c6x_ (list 'recip (list a 'c6k_)))) 1)))))))
(define (zol-steps!) (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
(define (zol-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (zol-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (dk-ass!)))))) f))
(define (zol-pow-cc! w m) (zol-and! (list 'IN w 'CC) (list 'IN m 'NN)) (fact 'power-typing-nonneg w m) (list 'IN (list 'power w m) 'CC))
(define (zol-rfl!) (dk-close-if! (lambda () #t) (lambda () (rfl))))
(define (zol-hol-basics! u f)                     ; HOLOMORPHIC-ON(u, f) in context: f in FUN(u, CC), u open, u subset CC
  (dk-cite! 'holomorphic-on-in-fun u f) (dk-cite! 'holomorphic-on-open u f) (dk-cite! 'cc-open-subset-cc u)
  (fact 'cc-is-set) (fact 'cc-one-in) (fact 'cc-zero-in) (fact 'nn-zero-in))
(define (zol-pt! u x) (fact 'subset-mem-fwd u 'CC x))
(define (acn-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (acn-and! a b)
  (let* ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (acn-rr! t)
  (let* ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((eq? t 'PI) (dk-split-all! (list (dk-cite! 'pi-pos))) typ)
          ((number? t) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((acn-op? t 'succ 2) (acn-nn! t) (fact 'nn-in-rr t) typ)
          ((acn-op? t '* 3) (acn-rr! (cadr t)) (acn-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((acn-op? t '+ 3) (acn-rr! (cadr t)) (acn-rr! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((acn-op? t '- 3) (acn-rr! (cadr t)) (acn-rr! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((acn-op? t '- 2) (acn-rr! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((acn-op? t 'magnitude 2) (acn-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((acn-op? t 'real-part 2) (acn-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((acn-op? t 'imag-part 2) (acn-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((acn-op? t 'abs 2) (acn-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((acn-op? t 'recip 2)
           (acn-rr! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (if (dk-asm? (list '< 0 (cadr t)))
                   (fact 'rr-pos-ne-zero (cadr t))
                   (error "acn-rr!: land the non-vanishing first" (expression->string (cadr t)))))
           (acn-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t))
           typ)
          (#t (dk-real! t) typ))))
(define (acn-nn! t)
  (let* ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((acn-op? t 'succ 2) (acn-nn! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          (#t (dk-type! t 'NN)))))
(define (acn-cc! t)
  (let* ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((or (and (number? t) (real? t)) (eq? t 'PI) (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
               (acn-op? t 'succ 2)
               (acn-op? t 'magnitude 2) (acn-op? t 'real-part 2) (acn-op? t 'imag-part 2))
           (acn-rr! t) (fact 'rr-subset-cc t) typ)
          ((acn-op? t '- 3) (acn-cc! (cadr t)) (acn-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((acn-op? t '- 2) (acn-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((acn-op? t '+ 3) (acn-cc! (cadr t)) (acn-cc! (caddr t))
           (acn-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((acn-op? t '* 3) (acn-cc! (cadr t)) (acn-cc! (caddr t))
           (acn-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((acn-op? t 'power 3) (acn-cc! (cadr t)) (acn-nn! (caddr t))
           (acn-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((acn-op? t 'CC-EXP 2) (acn-cc! (cadr t))
           (dk-split-all! (list (dk-cite! 'cc-exp-converges (cadr t)))) typ)
          ((acn-op? t 'recip 2) (acn-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "acn-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (acn-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (dk-type! t 'CC)))))
(define (acn-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC)))
      (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (acn-ptcc! p)
  (acn-cc! p)
  (if (not (dk-asm? (list 'IN p '(PTS CC-MS))))
      (dk-have! (list 'IN p '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))))
(define (acn-open-ball! u c)
  (fact 'cc-is-metric-space) (acn-pts-cc!)
  (acn-ptcc! c)
  (let* ((oiff (dk-cite! 'is-open 'CC-MS u))
         (oball (let loop ((r (caddr oiff))) (if (eq? (car r) 'AND) (loop (caddr r)) r))))
    (if (not (dk-asm? oball))
        (dk-have! oball (lambda () (if (dk-only! oiff (list 'IS-OPEN 'CC-MS u)) (prop)))))
    (let ((rho (dk-skolem! (dk-apply! (dk-ctx-form oball) c))))
      (dk-split-all!)
      rho)))
