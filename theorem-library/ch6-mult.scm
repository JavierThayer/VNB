(ni)
(c6w-induct-on! 'c6n_
  (lambda ()
    (let* ((new (c6-steps!)) (st (c6m-pick-shift new)) (s (car st)) (h (cadr st)) (lv (caddr st)) (eqh (cadddr st)))
      (fact 'cc-one-in) (fact 'cc-zero-in) (fact 'nn-zero-in)
      (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '= (list h 'cpdj_) (list '+ (list '* 1 (list s 'cpdj_)) (list '* 0 (list s 'cpdj_))))))
        (lambda () (let* ((j (dk-di-var!)) (e (dk-apply! eqh j)))
                     (fact 'fun-apply-type-c s 'NN 'CC j) (c6-and! '(IN 0 NN) (list 'IN j 'NN)) (fact 'nn-add-comm 0 j) (fact 'nn-add-zero j)
                     (dk-rewrite-h! (dk-rewrite-h! e (list '+ 0 j) (list '+ j 0)) (list '+ j 0) j)
                     (subst (list '= (list h j) (list s j)))
                     (crs))))
      (let* ((r (c6-cite! 'cc-limit-lincomb s s h lv lv 1 0)) (val (cadddr r)))
        (c6-cc! val)
        (dk-have! (list '= val lv) (lambda () (crs)))
        (dk-rewrite-h! r val lv)
        (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))))
  (lambda ()
    (let* ((new (c6-steps!)) (st (c6m-pick-shift new)) (s (car st)) (h (cadr st)) (lv (caddr st)) (eqh (cadddr st))
           (n (find-first (lambda (v) (c6-has-sub? eqh (list 'succ v))) (c6-vars new 'NN)))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'CONVERGES-TO))) new))
           (g (list 'VNB-LAMBDA 'c6k_ 'NN (list s '(succ c6k_)))))
      (fact 'nn-succ-closed n)
      (c6-lam-typ! g 'CC (lambda (k) (fact 'nn-succ-closed k) (fact 'fun-apply-type-c s 'NN 'CC (list 'succ k))))
      (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '= (list g 'cpdj_) (list s '(succ cpdj_)))))
        (lambda () (let ((j (dk-di-var!))) (fact 'nn-succ-closed j) (fact 'fun-apply-type-c s 'NN 'CC (list 'succ j)) (dk-lam-b!) (c6f-rfl-close!))))
      (c6-cite! 'cc-limit-shift s g lv)
      (dk-have! (c6f-tl-eq h g n)
        (lambda () (let* ((j (dk-di-var!)) (e (dk-apply! eqh j)) (sn (list 'succ n)))
                     (c6-nn! j)
                     (c6-and! (list 'IN sn 'NN) (list 'IN j 'NN)) (fact 'nn-add-comm sn j)
                     (c6-and! (list 'IN j 'NN) (list 'IN n 'NN)) (fact 'nn-add-comm j n) (c6-and! (list 'IN n 'NN) (list 'IN j 'NN)) (fact 'nn-add-closed n j) (fact 'nn-add-closed j n)
                     (dk-cite! 'nn-add-succ j n)
                     (fact 'nn-succ-closed (list '+ n j))
                     (fact 'fun-apply-type-c s 'NN 'CC (list 'succ (list '+ n j)))
                     (let ((e2 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! e (list '+ sn j) (list '+ j sn)) (list '+ j sn) (list 'succ (list '+ j n))) (list '+ j n) (list '+ n j))))
                       (dk-lam-b!)
                       (dk-close-if! (lambda () #t) (lambda () (dk-ass!)))))))
      (dk-apply! ih g h lv)
      (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))))
