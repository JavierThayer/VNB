(define (c6m-pick-shift new)                     ; s, h, L, eq of the shift lemmas
  (let* ((eqh (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q '=) (not (dk-contains? q 'CONVERGES-TO)))) new))
         (eqb (caddr (caddr eqh))) (h (car (cadr eqb))) (s (car (caddr eqb)))
