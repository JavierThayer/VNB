;;; isom2-rrvs.scm -- the real vector space of functions RR -> RR in a set closed under
;;; the pointwise operations, and calculus.pdf Proposition 4.8: the antiderivable
;;; functions on [a, b] form a vector space.  Agent ISOM, 2026-10-26.
;;;
;;;   rr-scal-carr / -add / -mul / -one        the field ring FIELD-AS-INTEGRAL-DOMAIN(RR-FIELD)
;;;   rr-fn-space-*-type, rr-fn-space-scal / -vec / -vadd / -vzero / -vneg / -act
;;;                                            the components and read-offs of RR-FN-SPACE
;;;   rr-fn-space-is-vector-space              v closed under the operations => a vector space
;;;   antiderivable-fns-membership             phi in ANTIDERIVABLE-FNS(a,b) iff ...
;;;   antiderivable-fns-vector-space           (Prop 4.8)
;;;
;;; The module laws are pointwise: extensionality (dk-fun-ext!) and `crs' at a point,
;;; the model being cc-fn-module-is-module-of (ca6-hurwitz.scm) for CC.
;;;
;;; WINDOW.  Citations: isom2-rrfield.scm, field-id-* (views), is-module, is-vector-space-def,
;;; antiderivable-add / -scale / -sub / -fn-in-fun / -from-deriv, the derivative of a
;;; constant.  lo = after isom2-rrfield.scm and the antiderivable laws; hi = none.
;;; Library: analysis.
;;;
;;; Helper prefix: rvs-.

(define (rvs-head g) (and (pair? g) (car g)))
(define rvs-SR '(FIELD-AS-INTEGRAL-DOMAIN RR-FIELD))
(define rvs-F '(FUN RR RR))
(define rvs-add-lam '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN RR RR) (+ x_ y_)))
(define rvs-mul-lam '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN RR RR) (* x_ y_)))
(define (rvs-sum f g) (list 'VNB-LAMBDA 'rfx_ 'RR (list '+ (list f 'rfx_) (list g 'rfx_))))
(define rvs-zero '(VNB-LAMBDA rfx_ RR 0))
(define (rvs-neg f) (list 'VNB-LAMBDA 'rfx_ 'RR (list '- (list f 'rfx_))))
(define (rvs-scale c f) (list 'VNB-LAMBDA 'rfx_ 'RR (list '* c (list f 'rfx_))))
(define rvs-vadd '(VNB-LAMBDA (LIST rff_ rfg_) (CARTESIAN v v) (VNB-LAMBDA rfx_ RR (+ (rff_ rfx_) (rfg_ rfx_)))))
(define rvs-vneg '(VNB-LAMBDA rff_ v (VNB-LAMBDA rfx_ RR (- (rff_ rfx_)))))
(define rvs-act '(VNB-LAMBDA (LIST rfc_ rff_) (CARTESIAN RR v) (VNB-LAMBDA rfx_ RR (* rfc_ (rff_ rfx_)))))
(define rvs-M '(RR-FN-SPACE v))
(define (rvs-each-leaf! opener body)
  (for-each (lambda (kn) (if (not (sequent-node-grounded? kn)) (begin (dk-focus! kn) (body))))
            (dk-opened opener)))

;;; =====================================================================
;;; the scalar field ring
;;; =====================================================================
(define (rvs-scal-readoff! name acc val)
  (sp (make-wff (list '== (list acc rvs-SR) val)))
  (fact 'rr-field-is-field)
  (let ((thm (cdr (assq acc '((CARR . field-id-carr) (ADD . field-id-add) (MUL . field-id-mul) (ONE . field-id-one) (ZERO . field-id-zero))))))
    (fact thm 'RR-FIELD))
  (subst (list '== (list acc rvs-SR) (list acc 'RR-FIELD)))
  (slot acc)
  (qrfl)
  (qed name)
  (topic! name 'plumbing))
(rvs-scal-readoff! 'rr-scal-carr 'CARR 'RR)
(rvs-scal-readoff! 'rr-scal-add 'ADD rvs-add-lam)
(rvs-scal-readoff! 'rr-scal-mul 'MUL rvs-mul-lam)
(rvs-scal-readoff! 'rr-scal-one 'ONE 1)
(rvs-scal-readoff! 'rr-scal-zero 'ZERO 0)

;;; =====================================================================
;;; RR-FN-SPACE(v): the component typings and the read-offs
;;; (v a set of functions RR -> RR)
;;; =====================================================================
(define rvs-hyps '((IN v SET) (SUBSET v (FUN RR RR))))
(define (rvs-imps hs body) (if (null? hs) body (list 'IMPLIES (car hs) (rvs-imps (cdr hs) body))))
(define (rvs-in-F! f)                  ; f in v: f in FUN(RR, RR)
  (if (not (dk-asm? (list 'IN f rvs-F))) (fact 'subset-mem-fwd 'v rvs-F f)))
;;; the focus goal (IN L (FUN RR RR)) for L = (VNB-LAMBDA rfx_ RR body), FS the functions
;;; of v occurring in body
(define (rvs-fun-type! fs)
  (rvs-each-leaf! (lambda () (lam-t))
    (lambda ()
      (if (and (eq? (rvs-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
          (dk-close-if! (lambda () (fact 'rr-is-set)) ass)
          (let ((x (dk-di-var!)))
            (for-each (lambda (f) (rvs-in-F! f) (fact 'fun-apply-type-c f 'RR 'RR x)) fs)
            (type-term))))))
(define (rvs-ins pl cls) (map cadr (filter (lambda (f) (and (eq? (rvs-head f) 'IN) (equal? (caddr f) cls))) pl)))

(sp (make-wff (list 'FORALL 'v (rvs-imps rvs-hyps
     (list 'IN rvs-vadd (list 'FUN '(CARTESIAN v v) rvs-F))))))
(dk-peel!)
(rvs-each-leaf! (lambda () (lam-t))
  (lambda ()
    (if (and (eq? (rvs-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
        (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))
        (let ((fs (rvs-ins (dk-peel!) 'v)))
          (rvs-fun-type! fs)))))
(qed 'rr-fn-space-vadd-type)
(topic! 'rr-fn-space-vadd-type 'plumbing)

(sp (make-wff (list 'IN rvs-zero rvs-F)))
(rvs-fun-type! '())
(qed 'rr-fn-space-vzero-type)
(topic! 'rr-fn-space-vzero-type 'plumbing)

(sp (make-wff (list 'FORALL 'v (rvs-imps rvs-hyps (list 'IN rvs-vneg (list 'FUN 'v rvs-F))))))
(dk-peel!)
(rvs-each-leaf! (lambda () (lam-t))
  (lambda ()
    (if (and (eq? (rvs-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
        (ass)
        (let ((f (dk-di-var!))) (rvs-fun-type! (list f))))))
(qed 'rr-fn-space-vneg-type)
(topic! 'rr-fn-space-vneg-type 'plumbing)

(sp (make-wff (list 'FORALL 'v (rvs-imps rvs-hyps (list 'IN rvs-act (list 'FUN '(CARTESIAN RR v) rvs-F))))))
(dk-peel!)
(rvs-each-leaf! (lambda () (lam-t))
  (lambda ()
    (if (and (eq? (rvs-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
        (begin (fact 'rr-is-set) (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))
        (let ((fs (rvs-ins (dk-peel!) 'v)))
          (rvs-fun-type! fs)))))
(qed 'rr-fn-space-act-type)
(topic! 'rr-fn-space-act-type 'plumbing)

(define (rvs-typings!)                 ; the hypotheses in context
  (fact 'rr-field-is-field-ring)
  (fact 'rr-fn-space-vadd-type 'v)
  (fact 'rr-fn-space-vzero-type)
  (fact 'rr-fn-space-vneg-type 'v)
  (fact 'rr-fn-space-act-type 'v))
(define (rvs-readoff! name acc val)
  (sp (make-wff (list 'FORALL 'v (rvs-imps rvs-hyps (list '== (list acc rvs-M) val)))))
  (dk-peel!)
  (rvs-typings!)
  (mac 'RR-FN-SPACE)
  (slot acc)
  (nth-r)
  (qrfl)
  (qed name)
  (topic! name 'plumbing))
(rvs-readoff! 'rr-fn-space-scal 'SCAL rvs-SR)
(rvs-readoff! 'rr-fn-space-vec 'VEC 'v)
(rvs-readoff! 'rr-fn-space-vadd 'VADD rvs-vadd)
(rvs-readoff! 'rr-fn-space-vzero 'VZERO rvs-zero)
(rvs-readoff! 'rr-fn-space-vneg 'VNEG rvs-vneg)
(rvs-readoff! 'rr-fn-space-act 'ACT rvs-act)

;;; =====================================================================
;;; rr-fn-space-is-vector-space
;;; =====================================================================
(define rvs-cl-sum '(FORALL f (IMPLIES (IN f v) (FORALL g (IMPLIES (IN g v)
                       (IN (VNB-LAMBDA rfx_ RR (+ (f rfx_) (g rfx_))) v))))))
(define rvs-cl-zero '(IN (VNB-LAMBDA rfx_ RR 0) v))
(define rvs-cl-neg '(FORALL f (IMPLIES (IN f v) (IN (VNB-LAMBDA rfx_ RR (- (f rfx_))) v))))
(define rvs-cl-scale '(FORALL c (IMPLIES (IN c RR) (FORALL f (IMPLIES (IN f v)
                         (IN (VNB-LAMBDA rfx_ RR (* c (f rfx_))) v))))))
(define (rvs-redex? t)
  (and (pair? t)
       (or (and (pair? (car t)) (eq? (car (car t)) 'VNB-LAMBDA))
           (let loop ((xs t)) (and (pair? xs) (or (rvs-redex? (car xs)) (loop (cdr xs))))))))
(define (rvs-beta!)                    ; lam-b while a redex is left and it changes the goal
  (let loop ((fuel 10))
    (let ((g (dk-goal)))
      (if (and (> fuel 0) (rvs-redex? g))
          (begin (lam-b) (if (not (equal? g (dk-goal))) (loop (- fuel 1))))))))
(define (rvs-cl! cl . ts)              ; a closure instance, landed
  (dk-apply! (dk-pick (lambda (h) (alpha-equiv? h cl)) "the closure hypothesis") (car ts))
  (if (pair? (cdr ts)) (apply dk-apply! (dk-pick (lambda (h) (alpha-equiv? h cl)) "the closure hypothesis") ts)))
(define (rvs-law! vs ss)
  (let ((leaf (proof-state-focus *ps*)))
    (if (not (dk-asm? '(IN 1 RR))) (fact 'rr-one-in))
    (for-each (lambda (a) (rvs-in-F! a) (rvs-cl! rvs-cl-neg a)) vs)
    (for-each (lambda (a) (for-each (lambda (b) (rvs-cl! rvs-cl-sum a b)) vs)) vs)
    (for-each (lambda (c) (for-each (lambda (a) (rvs-cl! rvs-cl-scale c a)) vs)) ss)
    (for-each (lambda (r) (for-each (lambda (s0)
                (dk-have! (list 'IN (list '+ r s0) 'RR) (lambda () (type-term)))
                (dk-have! (list 'IN (list '* r s0) 'RR) (lambda () (type-term)))) ss)) ss)
    (for-each (lambda (c) (for-each (lambda (a)
                (for-each (lambda (r) (rvs-cl! rvs-cl-scale r (list 'VNB-LAMBDA 'rfx_ 'RR (list '* c (list a 'rfx_))))) ss)) vs)) ss)
    (for-each (lambda (c) (for-each (lambda (a) (for-each (lambda (b)
                (rvs-cl! rvs-cl-scale c (rvs-sum a b))) vs)) vs)) ss)
    (for-each (lambda (c) (for-each (lambda (a) (for-each (lambda (b)
                (if (not (eq? a b)) (rvs-cl! rvs-cl-sum (rvs-scale c a) (rvs-scale c b)))) vs)) vs)) ss)
    (for-each (lambda (r) (for-each (lambda (s0) (for-each (lambda (a)
                (rvs-cl! rvs-cl-sum (rvs-scale r a) (rvs-scale s0 a))) vs)) ss)) ss)
    (rvs-beta!)
    (if (not (sequent-node-grounded? leaf))
        (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g))
               (typer (lambda () (rvs-fun-type! vs))))
          (dk-fun-ext! l r 'RR 'RR
            (if (symbol? l) #f typer)
            (if (symbol? r) #f typer)
            (lambda (w)
              (for-each (lambda (a) (fact 'fun-apply-type-c a 'RR 'RR w)) vs)
              (rvs-beta!)
              (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (crs))))))
    (if (not (sequent-node-grounded? leaf)) (error "rvs-law!: did not close" (expression->string (dk-goal))))))
(define (rvs-peel-vars!)
  (let ((pl (dk-peel!)))
    (cons (rvs-ins pl 'v) (rvs-ins pl 'RR))))
(define (rvs-op-type!)                 ; (IN <op lambda> (FUN D v)) by lam-t and a closure
  (rvs-each-leaf! (lambda () (lam-t))
    (lambda ()
      (let ((gg (dk-goal)))
        (if (and (eq? (rvs-head gg) 'IN) (eq? (caddr gg) 'SET))
            (begin (fact 'rr-is-set)
                   (if (dk-head-is? (cadr gg) 'CARTESIAN) (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))
                       (ass)))
            (let* ((vss (rvs-peel-vars!)) (vs (car vss)) (ss (cdr vss)) (body (cadr (dk-goal))) (op (car (cadddr body))))
              (dk-close-if!
               (lambda ()
                 (cond ((eq? op '+) (rvs-cl! rvs-cl-sum (car vs) (cadr vs)))
                       ((eq? op '-) (rvs-cl! rvs-cl-neg (car vs)))
                       (#t (rvs-cl! rvs-cl-scale (car ss) (car vs)))))
               ass)))))))

(sp (make-wff (list 'FORALL 'v (rvs-imps (append rvs-hyps (list rvs-cl-sum rvs-cl-zero rvs-cl-neg rvs-cl-scale))
     (list 'IS-VECTOR-SPACE rvs-M)))))
(dk-peel!)
(rvs-typings!)
(for-each (lambda (n) (fact n 'v)) '(rr-fn-space-scal rr-fn-space-vec rr-fn-space-vadd rr-fn-space-vzero rr-fn-space-vneg rr-fn-space-act))
(for-each (lambda (n) (fact n)) '(rr-scal-carr rr-scal-add rr-scal-mul rr-scal-one rr-scal-zero))
(fact 'rr-is-set)
(dk-project! (list 'IS-COMMUTATIVE-RING rvs-SR) 'is-field-ring-def (list 'IS-FIELD-RING rvs-SR))
(fact 'commutative-ring-is-ring rvs-SR)
(mac 'is-vector-space-def)
(define (rvs-subst-all!)
  (for-each (lambda (pr)
              (if (dk-contains? (dk-goal) (car pr)) (subst (list '== (car pr) (cdr pr)))))
            (list (cons (list 'SCAL rvs-M) rvs-SR) (cons (list 'VEC rvs-M) 'v) (cons (list 'VADD rvs-M) rvs-vadd)
                  (cons (list 'VZERO rvs-M) rvs-zero) (cons (list 'VNEG rvs-M) rvs-vneg) (cons (list 'ACT rvs-M) rvs-act)
                  (cons (list 'CARR rvs-SR) 'RR) (cons (list 'ADD rvs-SR) rvs-add-lam) (cons (list 'MUL rvs-SR) rvs-mul-lam)
                  (cons (list 'ONE rvs-SR) 1))))
(dk-conj-close!
 (lambda ()
   (rvs-subst-all!)
   (if (eq? (rvs-head (dk-goal)) 'IS-MODULE)
       (begin
         (mac 'is-module)
         (rvs-subst-all!)
         (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond
               ((dk-asm? g) (ass))
               ((and (eq? (rvs-head g) '=) (dk-head-is? (cadr g) 'LENGTH))
                (mac 'RR-FN-SPACE) (len-r)
                (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (vnb-guard (lambda () (arith)))))
               ((and (eq? (rvs-head g) 'IN) (dk-head-is? (caddr g) 'FUN)) (rvs-op-type!))
               ((memq (rvs-head g) '(IS-ASSOCIATIVE IS-COMMUTATIVE IS-IDENTITY HAS-INVERSES))
                (mac (rvs-head g))
                (let ((vss (rvs-peel-vars!)))
                  (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rvs-law! (car vss) (cdr vss)))))))
               ((eq? (rvs-head g) 'FORALL)
                (let ((vss (rvs-peel-vars!)))
                  (rvs-law! (car vss) (cdr vss))))
               (#t (error "rvs: unexpected module conjunct" (expression->string g))))))))
       (ass))))
(qed 'rr-fn-space-is-vector-space)
(topic! 'rr-fn-space-is-vector-space 'algebra)
(alias! 'rr-fn-space-is-vector-space
        "a set of real functions closed under the pointwise operations is a real vector space")

;;; =====================================================================
;;; Prop 4.8: the antiderivable functions on [a, b] form a vector space
;;; =====================================================================
(define rvs-AD '(ANTIDERIVABLE-FNS a b))
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'b (list '== rvs-AD
     '(SEP adp_ (FUN RR RR) (IS-ANTIDERIVABLE adp_ a b)))))))
(di) (mac 'ANTIDERIVABLE-FNS) (qrfl)
(qed 'antiderivable-fns-unfold)
(topic! 'antiderivable-fns-unfold 'plumbing)

(sp (make-wff (list 'FORALL 'a (list 'FORALL 'b (list 'FORALL 'phi
     (list 'IFF (list 'IN 'phi rvs-AD)
           '(AND (IN phi (FUN RR RR)) (IS-ANTIDERIVABLE phi a b))))))))
(di)
(dk-iff! (dk-head? 'AND)
  (lambda ()
    (mac-h 'antiderivable-fns-unfold (list 'IN 'phi rvs-AD))
    (sep-me '(IN phi (SEP adp_ (FUN RR RR) (IS-ANTIDERIVABLE adp_ a b))))
    (prop))
  (lambda ()
    (dk-split-all!)
    (mac 'ANTIDERIVABLE-FNS)
    (in-sep! (lambda () (ass)) (lambda () (ass)))))
(qed 'antiderivable-fns-membership)
(topic! 'antiderivable-fns-membership 'analysis)

(define (rvs-ad-in! f)                 ; (IN f AD) in context: f in FUN(RR,RR), antiderivable
  (if (not (dk-asm? (list 'IS-ANTIDERIVABLE f 'a 'b)))
      (begin
        (dk-project! (list 'IN f rvs-F) 'antiderivable-fns-membership (list 'IN f rvs-AD))
        (dk-project! (list 'IS-ANTIDERIVABLE f 'a 'b) 'antiderivable-fns-membership (list 'IN f rvs-AD)))))
(define (rvs-into-ad! L fs anti!)      ; the focus goal (IN L AD): typing and antiderivability
  (mac 'antiderivable-fns-membership)
  (dk-conj-close!
   (lambda ()
     (if (eq? (rvs-head (dk-goal)) 'IN)
         (rvs-each-leaf! (lambda () (lam-t))
           (lambda ()
             (if (and (eq? (rvs-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
                 (dk-close-if! (lambda () (fact 'rr-is-set)) ass)
                 (let ((x (dk-di-var!)))
                   (for-each (lambda (f) (fact 'fun-apply-type-c f 'RR 'RR x)) fs)
                   (type-term)))))
         (anti!)))))

(sp (make-wff '(FORALL a (FORALL b (IMPLIES (IN a RR) (IMPLIES (IN b RR) (IMPLIES (< a b)
     (IS-VECTOR-SPACE (RR-FN-SPACE (ANTIDERIVABLE-FNS a b))))))))))
(dk-peel!)
(fact 'rr-is-set)
(dk-have! (list 'SUBSET rvs-AD rvs-F)
  (lambda ()
    (mac 'subset-def)
    (let ((f (dk-di-var!)))
      (dk-split-all! (dk-landed (lambda () (mac-h 'antiderivable-fns-membership (list 'IN f rvs-AD)))))
      (ass))))
(dk-have! (list 'IN rvs-F 'SET)
  (lambda () (mac 'fun-set-iff) (dk-conj-close! (lambda () (ass)))))
(dk-close-if! (lambda () (fact 'subclass-of-set-is-set rvs-AD rvs-F)) (lambda () #t))
(define rvs-vs (dk-cite! 'rr-fn-space-is-vector-space rvs-AD))
;;; closure under sums
(dk-have! (cadr rvs-vs)
  (lambda ()
    (let* ((pl (dk-peel!)) (fs (map cadr (filter (lambda (q) (eq? (rvs-head q) 'IN)) pl))))
      (for-each rvs-ad-in! fs)
      (rvs-into-ad! (cadr (dk-goal)) fs
        (lambda () (dk-close-if! (lambda () (fact 'antiderivable-add (car fs) (cadr fs) 'a 'b)) ass))))))
;;; the zero function
(dk-have! (cadr (caddr rvs-vs))
  (lambda ()
    (let ((z rvs-zero))
      (rvs-into-ad! z '()
        (lambda ()
          (dk-have! (list 'IN z rvs-F) (lambda () (rvs-fun-type! '())))
          (dk-have! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ RR) (list 'IS-DIFF-AT z 'x_ (list z 'x_))))
            (lambda ()
              (let ((x (dk-di-var!)))
                (dk-lam-b!)
                (fact 'rr-zero-in)
                (dk-have! (list 'AND '(IN 0 RR) (list 'IN x 'RR)) (lambda () (dk-conj-close! (lambda () (ass)))))
                (dk-close-if! (lambda () (fact 'deriv-const 0 x)) ass))))
          (dk-have! '(AND (IN a RR) (AND (IN b RR) (< a b))) (lambda () (dk-conj-close! (lambda () (ass)))))
          (dk-close-if! (lambda () (fact 'antiderivable-from-deriv z z 'a 'b)) ass))))))
;;; negatives, through the scalar -1
(dk-have! (cadr (caddr (caddr rvs-vs)))
  (lambda ()
    (let* ((f (dk-di-var!)) (m1 '(- 1)))
      (rvs-ad-in! f)
      (fact 'rr-one-in)
      (fact 'rr-neg-closed 1)
      (fact 'antiderivable-scale m1 f 'a 'b)
      (rvs-into-ad! (cadr (dk-goal)) (list f)
        (lambda ()
          (let ((L (cadr (dk-goal)))
                (S (list 'VNB-LAMBDA 'x 'RR (list '* m1 (list f 'x)))))
            (dk-have! (list 'IN L rvs-F) (lambda () (rvs-fun-type! (list f))))
            (dk-have! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ RR) (list '== (list L 'x_) (list S 'x_))))
              (lambda ()
                (let ((x (dk-di-var!)))
                  (fact 'fun-apply-type-c f 'RR 'RR x)
                  (dk-lam-b!)
                  (let ((g (dk-goal)))
                    (dk-have! (list '= (cadr g) (caddr g)) (lambda () (crs)))
                    (subst (list '= (cadr g) (caddr g)))
                    (qrfl)))))
            (dk-close-if! (lambda () (fact 'antiderivable-integrand-transfer S L 'a 'b)) ass)))))))
;;; scalar multiples
(dk-have! (cadr (caddr (caddr (caddr rvs-vs))))
  (lambda ()
    (let* ((pl (dk-peel!))
           (c (cadr (car (filter (lambda (q) (and (eq? (rvs-head q) 'IN) (eq? (caddr q) 'RR))) pl))))
           (f (cadr (car (filter (lambda (q) (and (eq? (rvs-head q) 'IN) (equal? (caddr q) rvs-AD))) pl)))))
      (rvs-ad-in! f)
      (rvs-into-ad! (cadr (dk-goal)) (list f)
        (lambda () (dk-close-if! (lambda () (fact 'antiderivable-scale c f 'a 'b)) ass))))))
(dk-close-if! (lambda () (dk-apply! rvs-vs)) ass)
(qed 'antiderivable-fns-vector-space)
(topic! 'antiderivable-fns-vector-space 'analysis)
(alias! 'antiderivable-fns-vector-space "the antiderivable functions on [a, b] form a real vector space")
