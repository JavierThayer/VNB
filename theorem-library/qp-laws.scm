        (dk-sep-parts! h5)
        (dk-close-if-asm!)))
    (lambda ()
      (fp-pz-in! d)
      (dk-have! rin
        (lambda ()
          (subst `(== (ADD ,fp-r) ,fp-ladd)) (subst `(== (NEG ,fp-r) ,fp-lneg)) (subst `(== (IDL ,fp-r) ,fp-pz))
          (subst `(= (,fp-lneg xb) (- xb))) (subst `(= (,fp-ladd xa (- xb)) ,d))
          (dk-close-if-asm!)))
      (dk-chain-ass! (dk-cite! 'r6b-related-in fp-r 'xa 'xb))
