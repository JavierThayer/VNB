;; ZZ-RING's ring laws, stated on ZZ, 0, 1; p in ZZ; pZ's facts
(define (fp-setup!)
  (qp-or-asm '(IN p ZZ) (lambda () (dk-project! '(IN p ZZ) 'zz-prime '(ZZ-PRIME p))))
  (fact 'zz-is-set) (fact 'zz-zero-in) (fact 'zz-one-in)
