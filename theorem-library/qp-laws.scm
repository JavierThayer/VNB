              (let* ((h1 (dk-rewrite-h! `(<= ,(qe-ab (qe-sub sa1 sb1)) ,r1) (qe-sub sa1 sb1) dif))
                     (m0 (dk-cite! 'nf-norm-mult qf (qe-sub ea eb) pnv))
