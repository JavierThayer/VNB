;;; -----------------------------------------------------------------------
;;; 23. Proposition 4.19: every x in Q_p is uniquely sum_{k >= n} a_k p^k with digits a_k in {0, ..., p-1}.
;;;
;;; Vocabulary (qp-vocab): QP-DIGIT(p, y), the digit of y in Z_p (the d in [0, p) with |y - d| < 1); QP-TERM and
;;; QP-PSUM, the terms a_{n+j} p^{n+j} and the partial sums sum_{j < m} of the series; IS-QP-DIGITS(p, a, n) (a : ZZ
;;; -> ZZ, digits in [0, p), zero below n) and IS-QP-EXPANSION(p, a, n, x) (digits, and the partial sums converge
;;; to x in Q_p).  Plan: (A) the integer powers QP-PPOW: the characterisation by any a - b = k and p^k p = p^(k+1);
;;; (B) the partial-sum laws; (C) the ultrametric in |.| form; (D) the digit; (E) the digit sequence of y in Z_p by
;;; dependent choice, y_k = d_k + p y_(k+1); (F) existence: p^n y = S_m + p^(n+m) y_m; (G) uniqueness: the tail
;;; bound |x - S_m| <= 2^-(n+m), padding by zeros to a common start, and the digit-by-digit induction.

(define (qe-sub u v) `((ADD ,qf) ,u ((NEG ,qf) ,v)))
(define (qe-ab u) `((QP-ABS p) ,u))
(define (qe-mul u v) `((MUL ,qf) ,u ,v))
(define (qe-add u v) `((ADD ,qf) ,u ,v))
;; U built by ADD / MUL / NEG of QF from terms typed in CARR(QF): land U in CARR(QF); return U
(define (qe-in-carr! u)
  (cond ((dk-asm? `(IN ,u (CARR ,qf))) u)
        ((and (pair? u) (equal? (car u) `(NEG ,qf)))
         (qe-in-carr! (cadr u)) (dk-cite! 'nf-neg-in-carr qf (cadr u)) u)
        ((and (pair? u) (equal? (car u) `(ADD ,qf)))
         (qe-in-carr! (cadr u)) (qe-in-carr! (caddr u)) (dk-cite! 'nf-add-in-carr qf (cadr u) (caddr u)) u)
        ((and (pair? u) (equal? (car u) `(MUL ,qf)))
         (qe-in-carr! (cadr u)) (qe-in-carr! (caddr u)) (dk-cite! 'nf-mul-in-carr qf (cadr u) (caddr u)) u)
        (#t (error "qe-in-carr!: not typed in CARR(QF)" (expression->string u)))))
;; U in QQ: land EMBED(U) in PTS(QP p) and CARR(QF); return EMBED(U)
(define (qe-em-carr! u)
  (qp-or-asm `(IN ,(qp-em u) (CARR ,qf))
    (lambda ()
      (qp-or-asm `(IN ,(qp-em u) (PTS (QP p))) (lambda () (dk-split-all! (list (dk-cite! 'qp-embed-abs 'p u)))))
      (dk-have! `(IN ,(qp-em u) (CARR ,qf)) (lambda () (subst `(== (CARR ,qf) (PTS (QP p)))) (dk-close-if-asm!)))))
  (qp-em u))
;; K in ZZ: land p^K in CARR(QF), p^K /= 0, |p^K| = 2^(-K); return p^K
(define (qe-pp! k)
  (qp-or-asm `(= ((QP-ABS p) ,(qo-pp k)) ,(qo-rp `(- ,k))) (lambda () (dk-split-all! (list (dk-cite! 'qo-ppow-abs 'p k)))))
  (qo-pp k))
;; S, T in NN: land EMBED(p^S) EMBED(p^T) = EMBED(p^(S+T)), all three in CARR(QF); return the equation
(define (qe-pmul! s t)
  (let ((ps `(power p ,s)) (pt `(power p ,t)) (pst `(power p (+ ,s ,t))))
    (qp-or-asm '(IN p CC) (lambda () (dk-cite! 'zz-in-rr 'p) (dk-cite! 'rr-subset-cc 'p)))
    (qp-or-asm `(IN (+ ,s ,t) NN) (lambda () (dk-have-and! `(IN ,s NN) `(IN ,t NN)) (dk-cite! 'nn-add-closed s t)))
    (for-each (lambda (e) (qp-or-asm `(IN (power p ,e) ZZ) (lambda () (dk-cite! 'pz-power-in-zz 'p e)))
                          (qp-or-asm `(IN (power p ,e) QQ) (lambda () (dk-cite! 'zz-subset-qq `(power p ,e))))
                          (qe-em-carr! `(power p ,e)))
              (list s t `(+ ,s ,t)))
    (let ((eq `(= ,(qe-mul (qp-em ps) (qp-em pt)) ,(qp-em pst))))
      (qp-or-asm eq
        (lambda ()
          (dk-cite! 'cc-power-add t s 'p)
          (let ((e0 (dk-cite! 'qp-embed-mul 'p ps pt)))
            (dk-have! eq (lambda () (subst `(= ,pst (* ,ps ,pt))) (subst e0) (qp-rfl!)))))))))
;; U in Z_p: land U in PTS(QP p) and CARR(QF); return U
(define (qe-zp-carr! u)
  (qp-or-asm `(IN ,u (PTS (QP p))) (lambda () (dk-chain-ass! (dk-cite! 'subset-mem-fwd '(ZP p) '(PTS (QP p)) u))))
  (qp-or-asm `(IN ,u (CARR ,qf)) (lambda () (dk-have! `(IN ,u (CARR ,qf)) (lambda () (subst `(== (CARR ,qf) (PTS (QP p)))) (dk-close-if-asm!)))))
  u)

