;; K in ZZ with N <= K in context, F the digit sequence: land K - N in NN, F(K - N) in Z_p and its digit facts
(define (qe-dig-at! f k)
  (let ((j `(+ ,k (- n))))
    (qp-or-asm `(IN ,k RR) (lambda () (dk-cite! 'zz-in-rr k)))
    (qp-or-asm `(IN ,j ZZ) (lambda () (dk-have-and! `(IN ,k ZZ) '(IN (- n) ZZ)) (dk-cite! 'zz-add-closed k '(- n))))
    (qp-or-asm `(<= 0 ,j) (lambda () (dk-have! `(<= 0 ,j) (lambda () (dk-ineq! `(<= n ,k))))))
    (qp-or-asm `(IN ,j NN) (lambda () (dk-chain-ass! (dk-cite! 'zz-nonneg-in-nn j))))
    (qp-or-asm `(IN (,f ,j) (ZP p)) (lambda () (dk-cite! 'fun-apply-type-c f 'NN '(ZP p) j)))
    (qp-or-asm `(IN (QP-DIGIT p (,f ,j)) ZZ) (lambda () (dk-split-all! (list (dk-cite! 'qe-digit-def 'p `(,f ,j))))))
    j))
;; the IS-QP-DIGITS / IS-QP-EXPANSION laws, landed from a hypothesis (kept)
(define (qe-open-exp! a n x)
  (let ((h `(IS-QP-EXPANSION p ,a ,n ,x)))
    (dk-split-all! (list (dk-project! `(AND (IS-QP-DIGITS p ,a ,n) (CONVERGES-TO (QP p) (VNB-LAMBDA qtm_ NN (QP-PSUM p ,a ,n qtm_)) ,x))
                                      'is-qp-expansion h)))
    (dk-split-all! (list (dk-project! `(AND (IN ,a (FUN ZZ ZZ))
          (FORALL qtk_ (IMPLIES (IN qtk_ ZZ) (AND (<= 0 (,a qtk_)) (AND (< (,a qtk_) p) (IMPLIES (< qtk_ ,n) (= (,a qtk_) 0)))))))
       'is-qp-digits `(IS-QP-DIGITS p ,a ,n))))))
(define (qe-dig-law-of a n) (qp-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'qtk_) (dk-contains? h a) (dk-contains? h n))) "the digit law"))
;; the digit law of A at K (in ZZ): land 0 <= a k, a k < p, and k < n => a k = 0
(define (qe-dig-pt! a n k)
  (let ((dl (qe-dig-law-of a n)))
    (dk-split-all! (list (dk-chain-ass! (dk-apply! dl k))))))

;; existence, for an exponent n with p^(-n) x in Z_p
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (CARR ,qf)) (FORALL n (IMPLIES (IN n ZZ)
  (IMPLIES (IN ((MUL ,qf) ,(qo-pp '(- n)) x) (ZP p)) (FORSOME a (IS-QP-EXPANSION p a n x)))))))))))
(dk-peel!)
(qp-zp-setup!) (qo-field-setup!)
(fact 'zz-zero-in) (fact 'nn-zero-in) (fact 'zz-is-set) (fact 'nn-is-set)
