  (subst (dk-cite! 'qe-psum-zero 'p 'a 'n))
  (qo-zr! 'n)
  (dk-have! '(= (+ n 0) n) (lambda () (crs)))
  (subst '(= (+ n 0) n))
  (qe-pp! 'n)
  (dk-cite! 'nf-zero-in-carr qf)
  (qk-crs! qf (list (qo-pp 'n) '(f 0)))
  (dk-focus! step)
  (dk-peel!)
  (qp-zp-setup!) (qo-field-setup!)
  (let* ((k (pc-succ-var-qp (dk-goal)))
         (ih (qp-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'QP-PSUM))) "the IH"))
