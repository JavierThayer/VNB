;; A in FUN(ZZ, ZZ), N in ZZ, J in NN: land the term a_(n+j) p^(n+j) and its two factors in CARR(QF); return it
(define (qe-term! a n j)
  (let* ((nj `(+ ,n ,j)) (aj `(,a ,nj)))
    (qp-or-asm `(IN ,j ZZ) (lambda () (dk-cite! 'nn-subset-zz j)))
    (qp-or-asm `(IN ,nj ZZ) (lambda () (dk-have-and! `(IN ,n ZZ) `(IN ,j ZZ)) (dk-cite! 'zz-add-closed n j)))
    (qp-or-asm `(IN ,aj ZZ) (lambda () (dk-cite! 'fun-apply-type-c a 'ZZ 'ZZ nj)))
    (qp-or-asm `(IN ,aj QQ) (lambda () (dk-cite! 'zz-subset-qq aj)))
    (qe-em-carr! aj)
    (qe-pp! nj)
    (qe-in-carr! (qe-term a n j))))

(sp (make-wff `(FORALL m (IMPLIES (IN m NN) (FORALL p (IMPLIES (ZZ-PRIME p) (FORALL a (IMPLIES (IN a (FUN ZZ ZZ))
  (FORALL n (IMPLIES (IN n ZZ) (IN (QP-PSUM p a n m) (CARR ,qf))))))))))))
(let* ((bs (dk-ni-leaves)) (base (car bs)) (step (cadr bs)))
