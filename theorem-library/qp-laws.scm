;;; 11. Q_p is a non-archimedean valued field (Definition 1.26).

(define qf '(QP-FIELD p))
;; land the unfolded conjuncts of IS-RING(QP-RING p) and the typing of |.| on CARR(QP-RING p)
(define (qp-field-setup!)
  (qp-ring-setup!)
  (dk-cite! 'qp-carr 'p)
  (dk-cite! 'qp-abs-fun 'p)
  (qp-or-asm `(IN (QP-ABS p) (FUN (CARR ,qr) RR))
    (lambda () (dk-rewrite-h! `(IN (QP-ABS p) (FUN (QUOTIENT ,qs) RR)) `(QUOTIENT ,qs) `(CARR ,qr))))
  (qp-or-asm `(IN (CARR ,qr) SET)
    (lambda () (dk-have! `(IS-RING ,qr) (lambda () (dk-cite! 'qp-ring-is-ring 'p) (dk-close-if-asm!)))
               (dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'IS-RING `(IS-RING ,qr))))))
               (dk-cite! 'qp-ring-is-ring 'p))))

(define (qp-nth-residues e)
  (let ((found '()))
    (let walk ((t e))
      (if (pair? t)
          (begin
            (if (and (eq? (car t) 'NTH) (= (length t) 3)
                     (not (and (pair? (caddr t)) (eq? (car (caddr t)) 'LIST))))
                (if (not (member t found)) (set! found (cons t found))))
            (for-each walk (cdr t))
            (if (pair? (car t)) (walk (car t))))))
    (reverse found)))
(define (qp-read-back! acc)
  (for-each (lambda (r)
              (let ((src (list acc (caddr r))))
                (have! (list '== r src) (lambda () (slot acc) (qrfl)))
                (subst (list '== r src))))
            (qp-nth-residues (dk-goal))))
(define (qp-field-read-off! name acc val)
  (dk-sp-qed! (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (== (,acc ,qf) ,val))))
  (lambda ()
  (dk-peel!)
  (qp-field-setup!)
  (slot acc)
  (mac 'QP-FIELD)
  (nth-r)
  (qp-read-back! acc)
  (qrfl)
  )
  name))
(qp-field-read-off! 'qp-field-carr 'CARR `(CARR ,qr))
(qp-field-read-off! 'qp-field-add 'ADD `(ADD ,qr))
(qp-field-read-off! 'qp-field-mul 'MUL `(MUL ,qr))
