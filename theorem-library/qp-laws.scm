  (let* ((h1 (dk-rewrite-h! `(<= ,(qe-ab (qe-sub 'x s1)) ,r1) s1 t0)))
    ;; |a_n|_p = 1: 0 < a_n < p
    (qe-dig-pt! 'a 'n 'n)
    (dk-have! `(NOT (= 0 ,an)) (lambda () (di) (dk-have! `(= ,an 0) (lambda () (subst `(= ,an 0)) (qp-rfl!))) (ai `(NOT (= ,an 0)))))
    (dk-have-and! `(<= 0 ,an) `(NOT (= 0 ,an)))
    (dk-chain-ass! (dk-cite! 'rr-le-ne-lt 0 an))
    (dk-have! `(NOT (ZZ-DIVIDES p ,an)) (lambda () (di) (qe-dvd-small! an `(< 0 ,an))))
    (dk-chain-ass! (dk-cite! 'pc-abs-unit 'p an))
    ;; |a_n p^n| = 2^-n
    (let* ((at (qo-abs! t0)) (aea (qo-abs! ea)) (apn (qo-abs! pn)) (ax (qo-abs! 'x))
           (m0 (dk-cite! 'nf-norm-mult qf ea pn)) (m1 (dk-rewrite-h! m0 `(FNRM ,qf) '(QP-ABS p))))
      (dk-rr-mul! aea apn)
      (dk-have! `(= ,at ,rn) (lambda () (subst m1) (subst `(= ,aea ,(qp-a an))) (subst `(= ,(qp-a an) 1)) (subst `(= ,apn ,rn)) (crs)))
      ;; 2^-(n+1) < 2^-n
      (dk-have! '(< (- (+ n (succ 0))) (- n)) (lambda () (dk-ineq! '(= (succ 0) (+ 0 1)))))
      (dk-chain-ass! (dk-cite! 'rpow-star-mono-exp 2 '(- (+ n (succ 0))) '(- n)))
      (qe-in-carr! (qe-sub 'x t0)) (qe-in-carr! (qe-sub t0 'x)) (qe-in-carr! (qe-sub 'x zr)) (qe-in-carr! (qe-sub t0 zr))
      (qo-abs! (qe-sub 'x t0)) (qo-abs! (qe-sub t0 'x)) (qo-abs! (qe-sub 'x zr)) (qo-abs! (qe-sub t0 zr))
      (qx-ab0! 'x) (qx-ab0! t0 ea pn)
      (dk-cite! 'qe-abs-swap 'p t0 'x)
      ;; |x| <= 2^-n
      (dk-have! `(<= ,(qe-ab (qe-sub 'x t0)) ,rn) (lambda () (dk-ineq! h1 `(< ,r1 ,rn))))
      (dk-have! `(<= ,(qe-ab (qe-sub t0 zr)) ,rn) (lambda () (dk-ineq! `(= ,(qe-ab (qe-sub t0 zr)) ,at) `(= ,at ,rn))))
      (dk-chain-ass! (dk-cite! 'qe-ultra-le 'p 'x t0 zr rn))
      (dk-have! `(<= ,ax ,rn) (lambda () (dk-ineq! `(<= ,(qe-ab (qe-sub 'x zr)) ,rn) `(= ,(qe-ab (qe-sub 'x zr)) ,ax))))
      ;; 2^-n <= |x|
      (dk-have! `(<= ,rn ,ax)
        (lambda ()
          (pbc)
          (dk-chain-ass! (dk-cite! 'rr-not-le-lt rn ax))
          (dk-have! `(< ,(qe-ab (qe-sub t0 'x)) ,rn)
            (lambda () (dk-ineq! h1 `(< ,r1 ,rn) `(= ,(qe-ab (qe-sub t0 'x)) ,(qe-ab (qe-sub 'x t0))))))
          (dk-have! `(< ,(qe-ab (qe-sub 'x zr)) ,rn) (lambda () (dk-ineq! `(< ,ax ,rn) `(= ,(qe-ab (qe-sub 'x zr)) ,ax))))
          (dk-chain-ass! (dk-cite! 'qe-ultra-lt 'p t0 'x zr rn))
          (dk-absurd! `(< ,(qe-ab (qe-sub t0 zr)) ,rn) `(= ,(qe-ab (qe-sub t0 zr)) ,at) `(= ,at ,rn))))
      (dk-have-and! `(IN ,ax RR) `(IN ,rn RR))
      (dk-have-and! `(<= ,ax ,rn) `(<= ,rn ,ax))
      (dk-chain-ass! (dk-cite! 'rr-leq-antisymmetric ax rn))
      (dk-close-if-asm!))))
(qed 'ccr-4-18-qp)

