            ;; the tails at nv + 1
            (dk-chain-ass! (dk-cite! 'qe-tail 'p 'a 'n 'x `(succ ,nv)))
            (dk-chain-ass! (dk-cite! 'qe-tail 'p 'b 'n 'x `(succ ,nv)))
            (for-each (lambda (z w) (dk-cite! 'qe-psum-type w 'p z 'n)) (list 'a 'b 'a 'b) (list nv nv `(succ ,nv) `(succ ,nv)))
            (dk-have-and! '(IN n RR) `(IN (succ ,nv) RR)) (dk-cite! 'rr-add-closed 'n `(succ ,nv)) (dk-cite! 'rr-neg-closed `(+ n (succ ,nv)))
            (qo-rp! s1)
            (qe-in-carr! (qe-sub 'x sa1)) (qe-in-carr! (qe-sub sa1 'x)) (qe-in-carr! (qe-sub sa1 sb1))
