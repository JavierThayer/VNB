  (dk-have! '(< 0 1) (lambda () (arith)))
  (dk-cite! 'nv-field-ultrametric qf)
  (dk-chain-ass! (dk-cite! 'ultra-closed-ball-open qo-ms c 1))
  (let* ((z0 (dk-cite! 'qp-zp-closed-ball 'p))
         (z1 (dk-rewrite-h! z0 '(QP p) qo-ms)))
    (dk-have! `(IS-OPEN ,qo-ms (ZP p)) (lambda () (subst z1) (dk-close-if-asm!))))
