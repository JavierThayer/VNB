  (dk-focus! step)
  (dk-peel!)
  (let* ((k (pc-succ-var-qp (dk-goal)))
         (ih (qp-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'QP-PSUM))) "the IH")))
    (qo-field-setup!)
    (dk-chain-ass! (dk-apply! ih 'p 'a 'n))
    (subst (dk-cite! 'qe-psum-succ 'p 'a 'n k))
    (qe-term! 'a 'n k)
    (dk-cite! 'nf-add-in-carr qf `(QP-PSUM p a n ,k) (qe-term 'a 'n k))
    (dk-close-if-asm!)))
(qed 'qe-psum-type)

;;; (C) the ultrametric, in |.| = QP-ABS form

;; |u - v| = |v - u|
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL u (IMPLIES (IN u (CARR ,qf)) (FORALL v (IMPLIES (IN v (CARR ,qf))
  (= ,(qe-ab (qe-sub 'u 'v)) ,(qe-ab (qe-sub 'v 'u)))))))))))
(dk-peel!)
(qo-field-setup!)
