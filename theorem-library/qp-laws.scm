(let* ((c `(CLASS ,qs ,qz)))
  (dk-have! `(SUBSET (ZP p) (PTS ,qo-ms))
    (lambda () (subst `(== (PTS ,qo-ms) (CARR ,qf))) (subst `(== (CARR ,qf) (PTS (QP p)))) (dk-close-if-asm!)))
  ;; Z_p is open in Q_p
  (dk-cite! 'qp-zero-class 'p) (dk-cite! 'qp-field-zero 'p) (dk-cite! 'nf-zero-in-carr qf)
  (dk-have! `(IN ,c (PTS ,qo-ms))
