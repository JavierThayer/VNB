(for-each mac '(qp-field-carr qp-field-add qp-field-mul qp-field-neg qp-field-zero qp-field-one qp-field-fnrm))
(let split ((fuel 40))
  (let ((andl (find-first (lambda (s) (dk-head-is? (dk-goal-of s) 'AND)) (dk-open-leaves))))
    (when andl
      (if (= fuel 0) (error "qp: AND split did not terminate"))
      (dk-focus! andl) (di) (split (- fuel 1)))))
(define (qp-norm-body!)
  ;; goal: forall a in CARR(QR). 0 <= |a| and (|a| = 0 iff a = 0) and forall b ...
  (let* ((landed (dk-landed (lambda () (dk-peel!))))
         (a (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed)))
         (x (qp-class-of! a)))
    (subst (dk-cite! 'qp-zero-class 'p))
    (let disp ()
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'AND) (for-each (lambda (l) (dk-focus! l) (disp)) (dk-opened (lambda () (di)))))
          ((dk-head-is? g '<=)
           (if (eqv? (cadr g) 0)
               (begin (dk-cite! 'qp-abs-nonneg 'p x) (dk-close-if-asm!))
               (let* ((s (caddr (cadr (cadr g)))) (y (caddr s)) (ax (qp-ab x)) (ay (qp-ab y)))
                 ;; goal |[x + y]| <= |[x]| + |[y]|, already rewritten to classes of sums
                 (qp-ab! s)
                 (dk-cite! 'qp-abs-ultra 'p x y)
                 (dk-cite! 'qp-abs-nonneg 'p x) (dk-cite! 'qp-abs-nonneg 'p y)
                 (dk-cite! 'rr-max-closed ax ay)
                 (dk-have-and! `(IN ,ax RR) `(IN ,ay RR)) (dk-cite! 'rr-add-closed ax ay)
                 (dk-have! `(<= ,ax (+ ,ax ,ay)) (lambda () (dk-ineq! `(<= 0 ,ay))))
                 (dk-have! `(<= ,ay (+ ,ax ,ay)) (lambda () (dk-ineq! `(<= 0 ,ax))))
                 (dk-chain-ass! (dk-cite! 'rr-max-le ax ay `(+ ,ax ,ay)))
                 (dk-ineq! `(<= ,(qp-ab s) (MAX ,ax ,ay)) `(<= (MAX ,ax ,ay) (+ ,ax ,ay))))))
          ((dk-head-is? g 'IFF)
           (dk-iff! (lambda (g) (dk-head-is? (caddr g) 'CLASS))
             (lambda () (dk-iff-fwd! (dk-cite! 'qp-abs-zero-iff 'p x)) (dk-iff-bwd! (dk-cite! 'qp-class-zero-iff 'p x)) (dk-close-if-asm!))
             (lambda () (dk-iff-fwd! (dk-cite! 'qp-class-zero-iff 'p x)) (dk-iff-bwd! (dk-cite! 'qp-abs-zero-iff 'p x)) (dk-close-if-asm!))))
          ((dk-head-is? g 'FORALL)
           (let* ((landed2 (dk-landed (lambda () (dk-peel!))))
                  (b (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed2)))
                  (y (qp-class-of! b)))
             (qp-type! `((QP-SADD p) ,x ,y)) (qp-type! `((QP-SMUL p) ,x ,y))
             (subst (dk-cite! 'qp-mul-class 'p x y))
             (subst (dk-cite! 'qp-add-class 'p x y))
             (disp)))
          ((dk-head-is? g '=)
           (let ((y (caddr (caddr (cadr (cadr g))))))
             (dk-cite! 'qp-abs-mul 'p x y) (dk-close-if-asm!)))
          (#t (error "qp-norm-body!: unexpected" g)))))))
(define (qp-inverse-body!)
  (let* ((landed (dk-landed (lambda () (dk-peel!))))
         (a (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed)))
         (nz (find-first (lambda (f) (dk-head-is? f 'NOT)) landed))
         (x (qp-class-of! a)))
    (subst (dk-cite! 'qp-zero-class 'p))
    (subst (dk-cite! 'qp-one-class 'p))
    (let ((nz1 (dk-rewrite-h! nz a `(CLASS ,qs ,x))))
      (dk-rewrite-h! nz1 `(ZERO ,qr) `(CLASS ,qs ,qz)))
    (dk-have! `(NOT (IN ,x (QP-NULL p)))
      (lambda () (di) (dk-iff-bwd! (dk-cite! 'qp-class-zero-iff 'p x))
              (ai `(NOT (= (CLASS ,qs ,x) (CLASS ,qs ,qz))))))
    (let* ((y (dk-skolem! (dk-chain-ass! (dk-cite! 'qp-inverse-seq 'p x))))
           (xy `((QP-SMUL p) ,x ,y)))
      (qp-ab! y)
      (qp-type! xy) (dk-cite! 'qp-one-cs 'p)
      (dk-chain-ass! (dk-cite! 'qp-class-eq-intro 'p xy q1))
      (dk-cite! 'qp-mul-class 'p x y)
      (dk-cite! 'qp-zero-ne-one 'p)
      (dk-cite! 'qp-zero-class 'p)
      (ew `(CLASS ,qs ,y))
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-asm? g) (dk-ass!))
              ((dk-head-is? g 'IN) (subst `(== (CARR ,qr) (QUOTIENT ,qs))) (dk-close-if-asm!))
              ((dk-head-is? g 'NOT)
               (di)
               (dk-cite! 'qp-zero-cs 'p) (qp-class! qz)
               (dk-have! `(IN (CLASS ,qs ,x) (CARR ,qr)) (lambda () (subst `(== (CARR ,qr) (QUOTIENT ,qs))) (dk-close-if-asm!)))
               (let* ((z0 (dk-chain-ass! (dk-cite! 'ring-mul-zero-right qr `(CLASS ,qs ,x))))
                      (z1 (dk-rewrite-h! z0 `(ZERO ,qr) `(CLASS ,qs ,qz)))
                      (m0 `(= ((MUL ,qr) (CLASS ,qs ,x) (CLASS ,qs ,y)) (CLASS ,qs ,xy)))
                      (m1 (dk-rewrite-h! m0 `(CLASS ,qs ,y) `(CLASS ,qs ,qz)))
                      (m2 (dk-rewrite-h! m1 `((MUL ,qr) (CLASS ,qs ,x) (CLASS ,qs ,qz)) `(CLASS ,qs ,qz)))
                      (m3 (dk-rewrite-h! m2 `(CLASS ,qs ,xy) `(CLASS ,qs ,q1))))
                 (ai `(NOT (= (CLASS ,qs ,qz) (CLASS ,qs ,q1))))))
              (#t (subst `(= ((MUL ,qr) (CLASS ,qs ,x) (CLASS ,qs ,y)) (CLASS ,qs ,xy))) (dk-close-if-asm!)))))))))
(for-each
  (lambda (l)
    (if (not (sequent-node-grounded? l))
        (begin
          (dk-focus! l)
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (dk-ass!))
                  ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH)) (mac 'QP-FIELD) (len-r) (arith))
                  ((dk-head-is? g 'is-commutative) (mac 'is-commutative) (dk-close-if-asm!))
