(qp-abs-seq-type! 'x)
(use-em '(IN x (QP-NULL p))
  (lambda ()
    (let ((law (qp-null-open! 'x)))
      (dk-cite! 'qp-abs-null 'p 'x)
      (subst `(= ,(qp-ab 'x) 0))
      (fact 'rr-zero-in)
      (qp-abs-converges! 'x 0
        (lambda (ep)
          (let ((na (qp-small-at! law ep)))
            (ew (car na))
            (qp-past-close!
              (lambda (k)
                (let ((xk (qp-at! 'x k)))
                  (dk-chain-ass! (dk-apply! (cdr na) k))
                  (dk-lam-b!)
                  (qp-abs-minus-zero! (qp-a xk))))))))
      (dk-close-if-asm!)))
  (lambda ()
    (let* ((e (qp-evc! 'x)) (nc (car e)) (c (cadr e)) (law (caddr e)))
      (subst `(= ,(qp-ab 'x) ,c))
      (qp-abs-converges! 'x c
        (lambda (ep)
          (ew nc)
          (qp-past-close!
            (lambda (k)
              (let ((xk (qp-at! 'x k)))
                (dk-chain-ass! (dk-apply! law k))
                (dk-lam-b!)
                (subst `(= ,(qp-a xk) ,c))
                (qp-abs-minus-self! c ep))))))
      (dk-close-if-asm!))))
