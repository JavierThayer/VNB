  (qe-in-carr! a) (qe-in-carr! b)
  (dk-have! `(= ,b ((NEG ,qf) ,a)) (lambda () (qk-crs! qf '(u v))))
  (subst `(= ,b ((NEG ,qf) ,a)))
  (subst `(== (QP-ABS p) (FNRM ,qf)))
  (dk-cite! 'nf-norm-neg qf a)
  (subst `(= ((FNRM ,qf) ((NEG ,qf) ,a)) ((FNRM ,qf) ,a)))
  (qp-rfl!))
(qed 'qe-abs-swap)

;; |u - w| REL r from |u - v| REL r and |v - w| REL r, REL one of < and <=
(define (qe-ultra-lemma! name rel)
  (dk-sp-qed! (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL u (IMPLIES (IN u (CARR ,qf)) (FORALL v (IMPLIES (IN v (CARR ,qf))
    (FORALL w (IMPLIES (IN w (CARR ,qf)) (FORALL r (IMPLIES (IN r RR)
      (IMPLIES (,rel ,(qe-ab (qe-sub 'u 'v)) r) (IMPLIES (,rel ,(qe-ab (qe-sub 'v 'w)) r) (,rel ,(qe-ab (qe-sub 'u 'w)) r))))))))))))))
  (lambda ()
  (dk-peel!)
  (qo-field-setup!)
  (dk-cite! 'qp-is-nv-field 'p)
  (let* ((a (qe-sub 'u 'v)) (b (qe-sub 'v 'w)) (c (qe-sub 'u 'w)))
    (qe-in-carr! a) (qe-in-carr! b) (qe-in-carr! c)
    (dk-have! `(= ,(qe-add a b) ,c) (lambda () (qk-crs! qf '(u v w))))
    (let* ((aa (qo-abs! a)) (ab (qo-abs! b)) (ac (qo-abs! c))
           (h0 (dk-cite! 'nv-ultra qf a b))
           (h1 (dk-rewrite-h! h0 (qe-add a b) c))
           (h2 (dk-rewrite-h! h1 `(FNRM ,qf) '(QP-ABS p))))
      (dk-cite! 'rr-max-closed aa ab)
      (dk-or-each! (dk-cite! 'rr-max-cases aa ab)
        (lambda (o)
          (dk-ineq! h2 o `(,rel ,aa r) `(,rel ,ab r))))))
  )
  name))
(qe-ultra-lemma! 'qe-ultra-lt '<)
(qe-ultra-lemma! 'qe-ultra-le '<=)

;; |embed u - embed v| = |u - v|_p
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL u (IMPLIES (IN u QQ) (FORALL v (IMPLIES (IN v QQ)
  (= ,(qe-ab (qe-sub (qp-em 'u) (qp-em 'v))) ((PADIC-ABS p) (+ u (- v))))))))))))
(dk-peel!)
(qo-field-setup!)
(qe-em-carr! 'u) (qe-em-carr! 'v)
(let* ((eu (qp-em 'u)) (ev (qp-em 'v)))
  (dk-cite! 'ccr-1-26-metric 'p eu ev)
  (dk-cite! 'ccr-1-26-embed 'p 'u 'v)
  (subst `(== (QP-ABS p) (FNRM ,qf)))
  (subst `(= ((FNRM ,qf) ,(qe-sub eu ev)) ((DIST (QP p)) ,eu ,ev)))
  (dk-close-if-asm!))
(qed 'qe-embed-diff)

;;; (D) the digit

;; p | m with 0 < m < p in context (the formula POS): absurd
(define (qe-dvd-small! m pos)
  (dk-have! `(NOT (= ,m 0)) (lambda () (di) (dk-absurd! `(= ,m 0) pos)))
  (dk-chain-ass! (dk-cite! 'pz-dvd-bound 'p m))
  (dk-have! '(<= 0 p) (lambda () (dk-ineq! '(< 0 p))))
  (dk-have! `(<= 0 ,m) (lambda () (dk-ineq! pos)))
  (dk-cite! 'rr-abs-of-nonneg 'p) (dk-cite! 'rr-abs-of-nonneg m)
  (dk-absurd! `(<= (abs p) (abs ,m)) '(= (abs p) p) `(= (abs ,m) ,m) `(< ,m p)))
;; two digits closer than 1 are equal
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL d (IMPLIES (IN d ZZ) (FORALL e (IMPLIES (IN e ZZ)
  (IMPLIES (<= 0 d) (IMPLIES (< d p) (IMPLIES (<= 0 e) (IMPLIES (< e p)
    (IMPLIES (< ((PADIC-ABS p) (+ d (- e))) 1) (= d e))))))))))))))
(dk-peel!)
(qp-setup!)
(dk-project! '(< 1 p) 'zz-prime '(ZZ-PRIME p))
(let ((df '(+ d (- e))))
  (dk-cite! 'zz-neg-closed 'e)
  (dk-have-and! '(IN d ZZ) '(IN (- e) ZZ)) (dk-cite! 'zz-add-closed 'd '(- e))
  (dk-iff-fwd! (dk-cite! 'qo-int-small-iff 'p df))
  (for-each (lambda (z) (dk-cite! 'zz-in-rr z)) (list 'd 'e 'p df))
  (dk-have! '(< 0 p) (lambda () (dk-ineq! '(< 1 p))))
  (dk-have! `(= d (+ ,df e)) (lambda () (crs)))
  (dk-or-each! (dk-cite! 'zz-trichotomy df)
    (lambda (c)
      (cond ((equal? c `(= ,df 0))
             (subst `(= d (+ ,df e)))
             (subst c)
             (crs))
            ((equal? c `(< 0 ,df))
             (dk-have! `(< ,df p) (lambda () (dk-ineq! '(< d p) '(<= 0 e))))
             (qe-dvd-small! df c))
            (#t
             (let ((nd `(- ,df)))
               (dk-cite! 'zz-neg-closed df) (dk-cite! 'zz-in-rr nd)
               (dk-have! `(< 0 ,nd) (lambda () (dk-ineq! c)))
               (dk-have! `(< ,nd p) (lambda () (dk-ineq! '(< e p) '(<= 0 d))))
               (dk-cite! 'pz-dvd-neg 'p df)
               (qe-dvd-small! nd `(< 0 ,nd))))))))
(qed 'qe-digit-unique)

;; the same, read in Q_p
(define (qe-dbody y d) `(AND (IN ,d ZZ) (AND (<= 0 ,d) (AND (< ,d p) (< ,(qe-ab (qe-sub y (qp-em d))) 1)))))
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL y (IMPLIES (IN y (CARR ,qf)) (FORALL d (IMPLIES (IN d ZZ) (FORALL e (IMPLIES (IN e ZZ)
  (IMPLIES (<= 0 d) (IMPLIES (< d p) (IMPLIES (<= 0 e) (IMPLIES (< e p)
    (IMPLIES (< ,(qe-ab (qe-sub 'y (qp-em 'd))) 1) (IMPLIES (< ,(qe-ab (qe-sub 'y (qp-em 'e))) 1) (= d e)))))))))))))))))
(dk-peel!)
(qo-field-setup!)
(fact 'rr-one-in)
(dk-cite! 'zz-subset-qq 'd) (dk-cite! 'zz-subset-qq 'e)
(let* ((ed (qe-em-carr! 'd)) (ee (qe-em-carr! 'e)))
  (let* ((s0 (dk-cite! 'qe-abs-swap 'p 'y ed))
         (s1 (dk-rewrite-h! `(< ,(qe-ab (qe-sub 'y ed)) 1) (qe-ab (qe-sub 'y ed)) (qe-ab (qe-sub ed 'y)))))
    (dk-chain-ass! (dk-cite! 'qe-ultra-lt 'p ed 'y ee 1))
    (let ((q (dk-cite! 'qe-embed-diff 'p 'd 'e)))
      (dk-rewrite-h! `(< ,(qe-ab (qe-sub ed ee)) 1) (qe-ab (qe-sub ed ee)) '((PADIC-ABS p) (+ d (- e))))
      (dk-chain-ass! (dk-cite! 'qe-digit-unique 'p 'd 'e))
      (dk-close-if-asm!))))
(qed 'qe-digit-unique-qp)

;; every y in Z_p has a digit: an integer approximant (1.28), reduced mod p (1.19 with k = 1)
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL y (IMPLIES (IN y (ZP p)) (FORSOME dg ,(qe-dbody 'y 'dg))))))))
(dk-peel!)
(qp-zp-setup!)
(qo-field-setup!)
(qe-zp-carr! 'y)
(dk-project! '(< 1 p) 'zz-prime '(ZZ-PRIME p))
(dk-have! '(< 0 1) (lambda () (arith)))
(qp-pos-rr! 1)
(dk-split-all! (list (dk-cite! 'ccr-1-28 'p)))
(let* ((dl (qp-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR) (dk-contains? f 'EMBED))) "density"))
       (t0 (dk-skolem! (dk-chain-ass! (dk-apply! dl 'y 1))))
       (et (qp-em t0)))
  (dk-cite! 'zz-subset-qq t0)
  (qp-abs! t0)
  (dk-cite! 'pc-abs-int 'p t0)
  (dk-cite! 'pc-nv-integers-eq 'p)
  (dk-have! `(IN ,t0 ,qp-zq) (lambda () (subst `(= ,qp-zq ,qp-zqs)) (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!)))))
  (fact 'nn-one-in)
  (let* ((th (dk-skolem! (dk-cite! 'ccr-1-19 'p t0 1)))
         (eth (qp-em th)))
    (dk-cite! 'zz-subset-qq th) (dk-cite! 'zz-in-rr 'p) (dk-cite! 'zz-subset-qq 'p)
    (qp-abs! 'p)
    (dk-cite! 'qo-power-one 'p)
    (dk-cite! 'qo-power-one (qp-a 'p))
    (dk-cite! 'qo-abs-p 'p)
    (qp-qq-sub! t0 th)
    (dk-have! `(= (- ,t0 ,th) (+ ,t0 (- ,th))) (lambda () (mac 'binary-minus-def) (rfl)))
    (let* ((h0 (qp-pick (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f `(- ,t0 ,th)))) "the 1.19 bound"))
           (h1 (dk-rewrite-h! h0 `(- ,t0 ,th) `(+ ,t0 (- ,th))))
           (h2 (dk-rewrite-h! h1 `(power ,(qp-a 'p) 1) (qp-a 'p))))
      (dk-rewrite-h! `(< ,th (power p 1)) '(power p 1) 'p)
      (dk-have! `(< ,(qp-a `(+ ,t0 (- ,th))) 1) (lambda () (dk-ineq! h2 `(= (* ,(qp-a 'p) 2) 1))))
      (qe-em-carr! t0) (qe-em-carr! th)
      (qe-in-carr! (qe-sub et eth))
      (qo-abs! (qe-sub et eth))
      (let ((q (dk-cite! 'qe-embed-diff 'p t0 th)))
        (dk-have! `(< ,(qe-ab (qe-sub et eth)) 1) (lambda () (dk-ineq! q `(< ,(qp-a `(+ ,t0 (- ,th))) 1)))))
      ;; |y - embed t0| = d(y, embed t0) < 1
      (let* ((m0 (dk-cite! 'ccr-1-26-metric 'p 'y et))
             (m1 (dk-rewrite-h! `(< ((DIST (QP p)) y ,et) 1) `((DIST (QP p)) y ,et) (caddr m0)))
             (m2 (dk-rewrite-h! m1 `(FNRM ,qf) '(QP-ABS p))))
        (dk-chain-ass! (dk-cite! 'qe-ultra-lt 'p 'y et eth 1))
        (ew th)
        (dk-conj-close! (lambda () (dk-close-if-asm!)))))))
(qed 'qe-digit-exists)

;; the digit QP-DIGIT(p, y) of y in Z_p
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL y (IMPLIES (IN y (ZP p)) ,(qe-dbody 'y '(QP-DIGIT p y))))))))
(dk-peel!)
(qp-zp-setup!)
(qo-field-setup!)
(qe-zp-carr! 'y)
(mac 'QP-DIGIT)
(let* ((io (cadr (cadr (dk-goal))))
       (ls (dk-opened (lambda () (iota-d io)))))
  (for-each
    (lambda (l)
      (if (not (sequent-node-grounded? l))
          (begin
            (dk-focus! l)
            (if (dk-head-is? (dk-goal) 'FORSOME)
                (let ((v (dk-skolem! (dk-cite! 'qe-digit-exists 'p 'y))))
                  (ew v)
                  (dk-conj-close!
                    (lambda ()
                      (cond ((dk-asm? (dk-goal)) (dk-ass!))
                            ((dk-head-is? (dk-goal) 'FORALL)
                             (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                    (ante (find-first (lambda (f) (dk-head-is? f 'AND)) landed)))
                               (if ante (dk-split-all! (list ante)))
                               (let ((w (caddr (dk-goal))))
                                 (dk-chain-ass! (dk-cite! 'qe-digit-unique-qp 'p 'y v w))
                                 (dk-close-if-asm!))))
                            (#t (dk-close-if-asm!))))))))))
    ls))
(for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (prop)))) (dk-open-leaves))
(qed 'qe-digit-def)

;; y = d + p z with z in Z_p, d the digit of y
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL y (IMPLIES (IN y (ZP p))
  (FORSOME z (AND (IN z (ZP p)) (= y ((ADD ,qf) ,(qp-em '(QP-DIGIT p y)) ((MUL ,qf) ,(qp-em 'p) z)))))))))))
(dk-peel!)
(qp-zp-setup!)
(qo-field-setup!)
(dk-cite! 'qp-is-nv-field 'p)
(qe-zp-carr! 'y)
(dk-have! `(== (ZP p) (NV-INTEGERS ,qf)) (lambda () (mac 'ZP) (qrfl)))
(dk-rewrite-h! (dk-cite! 'nv-integers-domain qf) `(NV-INTEGERS ,qf) '(ZP p))
(dk-cite! 'nv-maximal-unfold qf '(ZP p))
(dk-cite! 'qp-maximal-principal 'p)
(dk-cite! 'zz-subset-qq 'p) (dk-cite! 'pc-abs-int 'p 'p)
(qp-em-zp! 'p)
(qe-em-carr! 'p)
(dk-cite! 'nv-principal-unfold qf '(ZP p) (qp-em 'p))
(dk-split-all! (list (dk-cite! 'qe-digit-def 'p 'y)))
(let* ((d '(QP-DIGIT p y)) (ed (qp-em d)) (w (qe-sub 'y ed)) (ep (qp-em 'p))
       (m `(NV-MAXIMAL ,qf (ZP p)))
       (ms `(SEP cwx_ (ZP p) (< ((FNRM ,qf) cwx_) 1)))
       (pr `(NV-PRINCIPAL ,qf (ZP p) ,ep))
       (ps `(SEP cwx_ (ZP p) (FORSOME cwm_ (AND (IN cwm_ (ZP p)) (= cwx_ ((MUL ,qf) cwm_ ,ep)))))))
  (dk-cite! 'zz-subset-qq d) (dk-cite! 'pc-abs-int 'p d)
