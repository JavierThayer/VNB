              (subst '(= (+ 1 (- 1)) 0))
              (dk-have! '(= 0 0) (lambda () (arith)))
              (dk-iff-bwd! (dk-cite! 'pz-abs-zero 'p 0))
              (subst `(= ,(qp-a 0) 0))
              (dk-cite! 'rr-pos-rr-in-rr ep) (dk-cite! 'rr-lt-of-pos-rr ep)
              (dk-ineq! `(< 0 ,ep)))))))
    (ew y)
    (dk-conj-close! dk-ass!)))
(qed 'qp-inverse-seq)

