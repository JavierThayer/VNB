(let* ((a (qo-amax 'k)) (b (qo-bmax 'k)) (y (qo-pp 'k))
       (d0 `(= ((MUL ,qf) ,y ,(qo-pk b)) ,(qo-pk a)))
       (av (dk-name! a 'NN)) (bv (dk-name! b 'NN))
       (d1 (dk-rewrite-h! d0 a av)) (d2 (dk-rewrite-h! d1 b bv))
       (h1 (dk-rewrite-h! `(= (+ ,a (- ,b)) k) a av)) (h2 (dk-rewrite-h! h1 b bv)))
  (for-each (lambda (n) (dk-cite! 'nn-in-rr n)) (list av bv 's 't))
