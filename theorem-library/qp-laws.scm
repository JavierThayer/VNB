  (dk-have! `(= ,av (+ k ,bv)) (lambda () (subst `(= k (+ ,av (- ,bv)))) (crs)))
  (dk-have! `(= (+ s ,bv) (+ ,av t)) (lambda () (subst '(= s (+ k t))) (subst `(= ,av (+ k ,bv))) (crs)))
  (let* ((et (qo-pk 't)) (es (qo-pk 's)) (eb (qo-pk bv)) (ea (qo-pk av))
         (p1 (qe-pmul! av 't)) (p2 (qe-pmul! 's bv)))
    (dk-split-all! (list (dk-cite! 'qo-ppos-abs 'p bv)))
    (qe-in-carr! (qe-mul y et))
    (dk-have! `(= ,(qe-mul (qe-mul y et) eb) ,(qe-mul es eb))
      (lambda ()
        (subst (have-f! `(= ,(qe-mul (qe-mul y et) eb) ,(qe-mul (qe-mul y eb) et)) (lambda () (qk-crs! qf (list y et eb)))))
        (subst d2)
        (subst p1)
        (subst p2)
        (subst `(= (+ s ,bv) (+ ,av t)))
        (qp-rfl!)))
    (dk-chain-ass! (dk-cite! 'nf-mul-cancel qf (qe-mul y et) es eb))
    (dk-close-if-asm!)))
(qed 'qe-ppow-char)

;; p^k p = p^(k+1)
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL k (IMPLIES (IN k ZZ)
  (= ((MUL ,qf) ,(qo-pp 'k) ,(qp-em 'p)) ,(qo-pp '(+ k 1)))))))))
(dk-peel!)
(qo-field-setup!)
(dk-split-all! (list (dk-cite! 'qo-int-halves 'k)))
(dk-split-all! (list (dk-cite! 'qo-ppow-def 'p 'k)))
(fact 'zz-one-in) (fact 'nn-one-in)
(dk-have-and! '(IN k ZZ) '(IN 1 ZZ)) (dk-cite! 'zz-add-closed 'k 1)
(dk-split-all! (list (dk-cite! 'qo-ppow-def 'p '(+ k 1))))
(let* ((a (qo-amax 'k)) (b (qo-bmax 'k)) (y (qo-pp 'k)) (y1 (qo-pp '(+ k 1)))
       (d0 `(= ((MUL ,qf) ,y ,(qo-pk b)) ,(qo-pk a)))
       (av (dk-name! a 'NN)) (bv (dk-name! b 'NN))
       (d1 (dk-rewrite-h! d0 a av)) (d2 (dk-rewrite-h! d1 b bv))
       (h1 (dk-rewrite-h! `(= (+ ,a (- ,b)) k) a av)) (h2 (dk-rewrite-h! h1 b bv)))
  (for-each (lambda (n) (dk-cite! 'nn-in-rr n)) (list av bv))
  (qo-zr! 'k)
  (dk-have-and! `(IN ,av NN) '(IN 1 NN)) (dk-cite! 'nn-add-closed av 1)
  (dk-have! `(= (+ (+ ,av 1) (- ,bv)) (+ k 1)) (lambda () (subst `(= k (+ ,av (- ,bv)))) (crs)))
  (let* ((c (dk-chain-ass! (dk-cite! 'qe-ppow-char 'p '(+ k 1) `(+ ,av 1) bv)))
         (eb (qo-pk bv)) (ea (qo-pk av)) (ep (qp-em 'p)) (e1 (qo-pk 1))
         (p1 (qe-pmul! av 1)))
    (dk-cite! 'zz-in-rr 'p)
    (dk-cite! 'qo-power-one 'p)
    (dk-cite! 'zz-subset-qq 'p)
    (qe-em-carr! 'p)
    (dk-have! `(= ,ep ,e1) (lambda () (subst '(= (power p 1) p)) (qp-rfl!)))
    (dk-split-all! (list (dk-cite! 'qo-ppos-abs 'p bv)))
    (qe-in-carr! (qe-mul y ep))
    (dk-have! `(= ,(qe-mul (qe-mul y ep) eb) ,(qe-mul y1 eb))
      (lambda ()
        (subst (have-f! `(= ,(qe-mul (qe-mul y ep) eb) ,(qe-mul (qe-mul y eb) ep)) (lambda () (qk-crs! qf (list y ep eb)))))
        (subst d2)
        (subst `(= ,ep ,e1))
        (subst p1)
        (subst c)
        (qp-rfl!)))
    (dk-chain-ass! (dk-cite! 'nf-mul-cancel qf (qe-mul y ep) y1 eb))
    (dk-close-if-asm!)))
(qed 'qe-ppow-succ)

;;; (B) the partial sums

