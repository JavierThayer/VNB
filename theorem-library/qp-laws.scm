;; classes mod p agree iff p divides the difference
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL xa (IMPLIES (IN xa ZZ) (FORALL xb (IMPLIES (IN xb ZZ)
  (IFF (= (CLASS ,fp-s xa) (CLASS ,fp-s xb)) (ZZ-DIVIDES p (+ xa (- xb))))))))))))
(dk-peel!)
