;; Proposition 1.32: for x /= 0 in Q_p, -ord_p(x) is the smallest integer k such that p^k x is in Z_p
(define (qo-ord x) `((QP-ORD p) ,x))
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (CARR ,qf)) (IMPLIES (NOT (= x (ZERO ,qf)))
  (AND (IN ((MUL ,qf) ,(qo-pp `(- ,(qo-ord 'x))) x) (ZP p))
       (FORALL kq (IMPLIES (IN kq ZZ) (IMPLIES (IN ((MUL ,qf) ,(qo-pp 'kq) x) (ZP p)) (<= (- ,(qo-ord 'x)) kq))))))))))))
(dk-peel!)
(qo-field-setup!)
(dk-cite! 'ccr-1-26-zp 'p)
(let* ((m (dk-skolem! (dk-chain-ass! (dk-cite! 'qo-abs-power 'p 'x))))
       (ax (qo-abs! 'x)))
  (qo-zr! m) (qo-rp! m) (dk-cite! 'zz-neg-closed m) (dk-cite! 'rr-neg-closed m)
  (dk-chain-ass! (dk-cite! 'qo-ord-value 'p 'x m))
  (dk-have! `(= (- ,(qo-ord 'x)) ,m) (lambda () (subst `(= ,(qo-ord 'x) (- ,m))) (crs)))
  (subst `(= (- ,(qo-ord 'x)) ,m))
  (subst `(== (ZP p) ,qp-zp-sep))
  (let ((step! (lambda (kk)
                 ;; kk in ZZ: land p^kk x in CARR and PTS(QP p), and |p^kk x| = 2^(-kk + m); return p^kk x
                 (qo-zr! kk) (dk-cite! 'rr-neg-closed kk)
                 (dk-split-all! (list (dk-cite! 'qo-ppow-abs 'p kk)))
                 (let* ((pp (qo-pp kk)) (ppx `((MUL ,qf) ,pp x)) (s `(+ (- ,kk) ,m)))
                   (dk-cite! 'nf-mul-in-carr qf pp 'x)
                   (dk-rewrite-h! `(IN ,ppx (CARR ,qf)) `(CARR ,qf) '(PTS (QP p)))
                   (let* ((app (qo-abs! pp)) (appx (qo-abs! ppx))
                          (m0 (dk-cite! 'nf-norm-mult qf pp 'x))
                          (m1 (dk-rewrite-h! m0 `((FNRM ,qf) ,ppx) appx))
                          (m2 (dk-rewrite-h! m1 `((FNRM ,qf) ,pp) app))
                          (m3 (dk-rewrite-h! m2 `((FNRM ,qf) x) ax))
                          (m4 (dk-rewrite-h! m3 app (qo-rp `(- ,kk))))
                          (m5 (dk-rewrite-h! m4 ax (qo-rp m))))
                     (dk-have-and! `(IN (- ,kk) RR) `(IN ,m RR)) (dk-cite! 'rr-add-closed `(- ,kk) m)
                     (qo-rp! `(- ,kk)) (qo-rp! s)
                     (let ((r0 (dk-cite! 'rpow-star-add 2 `(- ,kk) m)))
                       (dk-rewrite-h! m5 `(* ,(qo-rp `(- ,kk)) ,(qo-rp m)) (qo-rp s)))
                     (list ppx appx s))))))
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IN)
            ;; k = -ord x: |p^k x| = 2^0 = 1
            (let* ((r (step! m)) (ppx (car r)) (appx (cadr r)) (s (caddr r)))
              (dk-have! `(= ,s 0) (lambda () (crs)))
              (dk-cite! 'rpow-star-zero 2)
              (dk-have! `(<= ,appx 1)
                (lambda () (subst `(= ,appx ,(qo-rp s))) (subst `(= ,s 0)) (subst `(= ,(qo-rp 0) 1)) (dk-ineq!)))
              (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!))))
            ;; any k with p^k x in Z_p has m <= k
            (let* ((landed (dk-landed (lambda () (dk-peel!))))
                   (kq (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'ZZ))) landed)))
                   (mem (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-contains? f 'SEP))) landed))
                   (r (step! kq)) (ppx (car r)) (appx (cadr r)) (s (caddr r)))
              (dk-sep-parts! mem)
              (pbc)
              (dk-chain-ass! (dk-cite! 'rr-not-le-lt m kq))
              (dk-have! `(< 0 ,s) (lambda () (dk-ineq! `(< ,kq ,m))))
              (dk-have! '(< 1 2) (lambda () (arith)))
              (fact 'rr-zero-in) (fact 'rr-one-in)
              (dk-cite! 'rpow-star-zero 2)
              (let* ((u0 (dk-chain-ass! (dk-cite! 'rpow-star-mono-exp 2 0 s)))
                     (u1 (dk-rewrite-h! u0 (qo-rp 0) 1)))
                (dk-absurd! u1 `(= ,appx ,(qo-rp s)) `(<= ,appx 1)))))))))
(qed 'ccr-1-32)

