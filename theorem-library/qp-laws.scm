;; THE GENERIC STEP: an "integer map" io : ZZ -> A that is additive, multiplicative, odd, sends 0, 1 to 0, 1,
;; has io(n) in M(A) iff p | n, and is dense mod M(A), induces F_p ~ A / M(A)
(define iso-hyps
  '((ZZ-PRIME p) (IS-NV-DOMAIN K A) (IN io (FUN ZZ A))
    (FORALL im (IMPLIES (IN im ZZ) (FORALL jn (IMPLIES (IN jn ZZ)
      (AND (= (io (+ im jn)) ((ADD K) (io im) (io jn))) (= (io (* im jn)) ((MUL K) (io im) (io jn))))))))
    (FORALL im (IMPLIES (IN im ZZ) (= (io (- im)) ((NEG K) (io im)))))
    (= (io 0) (ZERO K)) (= (io 1) (ONE K))
    (FORALL im (IMPLIES (IN im ZZ) (IFF (IN (io im) (NV-MAXIMAL K A)) (ZZ-DIVIDES p im))))
    (FORALL xa (IMPLIES (IN xa A) (FORSOME im (AND (IN im ZZ) (IN ((ADD K) xa ((NEG K) (io im))) (NV-MAXIMAL K A))))))))
(define (iso-curry hs body) (if (null? hs) body `(IMPLIES ,(car hs) ,(iso-curry (cdr hs) body))))
(sp (make-wff `(FORALL p (FORALL K (FORALL A (FORALL io ,(iso-curry iso-hyps
  '(FORSOME ff (IS-RING-ISO (FP p) (NV-RESIDUE K A) ff)))))))))
(dk-peel!)
(rs-ring-setup!)
(fp-ring-setup!)
(dk-split-all! (list (dk-cite! 'fp-is-field 'p)))
(for-each (lambda (r) (dk-cite! 'rq-carr r) (dk-cite! 'rq-one r) (dk-cite! 'rq-zero r) (dk-cite! 'ringoid-quotient-is-ring r)) (list fp-r rs-r))
(dk-have! '(IS-RING (FP p)) (lambda () (mac 'FP) (dk-close-if-asm!)))
(dk-have! '(IS-RING (NV-RESIDUE K A)) (lambda () (mac 'NV-RESIDUE) (dk-close-if-asm!)))
(let* ((rq `(QUOTIENT ,rs-rs))
       (g `(VNB-LAMBDA gn_ ZZ (CLASS ,rs-rs (io gn_))))
       (f `(DESCEND ,fp-s ,g))
       (hlaw (qp-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(+ im jn)) (dk-contains? f 'io))) "io laws"))
       (nlaw (qp-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(- im)) (dk-contains? f 'io))) "io neg"))
       (mlaw (qp-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ZZ-DIVIDES) (dk-contains? f 'io))) "io kernel"))
       (dlaw (qp-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'xa) (dk-contains? f 'io))) "io density"))
       (io-at! (lambda (n)
                 (qp-or-asm `(IN (io ,n) A) (lambda () (dk-have-and! '(IN io (FUN ZZ A)) `(IN ,n ZZ)) (dk-cite! 'fun-apply-type 'io 'ZZ 'A n)))
                 (rs-in! `(io ,n)) (rs-pt! `(io ,n))
                 `(io ,n)))
       (io-laws! (lambda (a b)
                   ;; land io(a+b) = io a + io b, io(a*b) = io a io b
                   (dk-split-all! (list (dk-chain-ass! (dk-apply! hlaw a b))))))
       (g-val! (lambda (n)
                 (io-at! n)
                 (qp-or-asm `(= (,g ,n) (CLASS ,rs-rs (io ,n)))
                   (lambda () (dk-have! `(= (,g ,n) (CLASS ,rs-rs (io ,n))) (lambda () (fact 'zz-is-set) (dk-lam-b!) (qp-rfl!)))))))
       (sum! (lambda (a b)
               ;; a, b in ZZ: land (io (+ a (- b))) = (ADD K) (io a) ((NEG K) (io b)) pieces; return the K term
               (dk-cite! 'zz-neg-closed b)
               (dk-have-and! `(IN ,a ZZ) `(IN (- ,b) ZZ)) (dk-cite! 'zz-add-closed a `(- ,b))
               (io-at! a) (io-at! b) (io-at! `(- ,b)) (io-at! `(+ ,a (- ,b)))
               (io-laws! a `(- ,b))
               (dk-chain-ass! (dk-apply! nlaw b))
               (rs-close! 'NEG `(io ,b) #f) (rs-close! 'ADD `(io ,a) `((NEG K) (io ,b)))
               `((ADD K) (io ,a) ((NEG K) (io ,b))))))
  ;; g is a function on the points of F_p's setoid, and respects the congruence
  (dk-have! `(IN ,g (FUN (PTS ,fp-s) ,rq))
    (lambda ()
      (subst `(== (PTS ,fp-s) ZZ))
      (dk-each-leaf! (lambda () (lam-t))
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let* ((landed (dk-landed (lambda () (dk-peel!))))
                     (n (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
                (io-at! n) (dk-cite! 'class-in-quotient rs-rs `(io ,n)) (dk-close-if-asm!))
              (begin (fact 'zz-is-set) (dk-close-if-asm!)))))))
  (let ((riff (dk-cite! 'respects-unfold fp-s g)))
    (dk-have! (caddr riff)
      (lambda ()
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed)))
               (a (car vs)) (b (cadr vs)))
          (for-each (lambda (v) (dk-have! `(IN ,v ZZ) (lambda () (subst `(== ZZ (PTS ,fp-s))) (dk-close-if-asm!)))) (list a b))
          (dk-iff-bwd! (dk-cite! 'class-eq-iff fp-s a b))
          (dk-iff-fwd! (dk-cite! 'fp-class-eq-iff 'p a b))
          (let* ((kt (sum! a b)) (d `(+ ,a (- ,b))))
            (dk-iff-bwd! (dk-chain-ass! (dk-apply! mlaw d)))
            (let* ((h1 (dk-rewrite-h! `(IN (io ,d) ,rs-m) `(io ,d) `((ADD K) (io ,a) (io (- ,b)))))
                   (h2 (dk-rewrite-h! h1 `(io (- ,b)) `((NEG K) (io ,b)))))
              (dk-iff-bwd! (dk-cite! 'rs-class-eq-iff 'K 'A `(io ,a) `(io ,b)))
              (g-val! a) (g-val! b)
              (subst `(= (,g ,a) (CLASS ,rs-rs (io ,a)))) (subst `(= (,g ,b) (CLASS ,rs-rs (io ,b))))
              (dk-close-if-asm!))))))
    (dk-iff-bwd! riff))
  ;; f = DESCEND(g): a function on the classes, f([a]) = [io a]
  (dk-have-and! `(IN ,g (FUN (PTS ,fp-s) ,rq)) `(RESPECTS ,fp-s ,g))
  (dk-chain-ass! (dk-cite! 'descend-in-fun fp-s rq g))
  (let* ((claw (dk-chain-ass! (dk-cite! 'descend-computes fp-s rq g)))
         (f-at! (lambda (a)
                  ;; a in ZZ: land f([a]) = [io a]; return it
                  (fp-pt! a) (g-val! a)
                  (let ((e (dk-chain-ass! (dk-apply! claw a))))
                    (qp-or-asm `(= (,f (CLASS ,fp-s ,a)) (CLASS ,rs-rs (io ,a)))
                      (lambda () (dk-rewrite-h! e `(,g ,a) `(CLASS ,rs-rs (io ,a))))))))
         (fq fp-q) (rqr rs-q))
    (ew f)
    (mac 'FP) (mac 'NV-RESIDUE)
    (mac 'IS-RING-ISO)
    (dk-conj-close!
      (lambda ()
        (let ((g0 (dk-goal)))
          (cond
            ((dk-asm? g0) (dk-ass!))
            ((dk-head-is? g0 'IS-HOM-RING)
             (mac 'IS-HOM-RING)
             (let hom-leaf! ()
                       (let ((g1 (dk-goal)))
                         (cond
                           ((dk-asm? g1) (dk-ass!))
                           ((dk-head-is? g1 'AND) (for-each (lambda (l) (dk-focus! l) (hom-leaf!)) (dk-opened (lambda () (di)))))
                           ((dk-head-is? g1 'IN)
                            (subst `(== (CARR ,fq) (QUOTIENT ,fp-s))) (subst `(== (CARR ,rqr) ,rq)) (dk-close-if-asm!))
                           ((dk-head-is? g1 'FORALL)
                            (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                   (vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed)))
                                   (xs (map fp-rep! vs))
                                   (g2 (dk-goal))
                                   (op (car (car (cadr (cadr g2))))))
                              (for-each f-at! xs)
                              (cond
                                ((eq? op 'NEG)
                                 (let ((a (car xs)))
                                   (subst (dk-cite! 'rq-neg-computes fp-r a))
                                   (subst `(== (NEG ,fp-r) ,fp-lneg))
                                   (let ((v (fp-eval! `(,fp-lneg ,a))))
                                     (f-at! v) (subst `(= (,f (CLASS ,fp-s ,v)) (CLASS ,rs-rs (io ,v)))))
                                   (subst `(= (,f (CLASS ,fp-s ,a)) (CLASS ,rs-rs (io ,a))))
                                   (rs-pt! `(io ,a))
                                   (subst (dk-cite! 'rq-neg-computes rs-r `(io ,a)))
                                   (subst `(== (NEG ,rs-r) ,rs-lneg))
                                   (rs-eval! `(,rs-lneg (io ,a)))
                                   (dk-chain-ass! (dk-apply! nlaw a))
                                   (subst `(= (io (- ,a)) ((NEG K) (io ,a))))
                                   (rs-pt! `((NEG K) (io ,a)))
                                   (qp-rfl!)))
                                (#t
                                 (let* ((a (car xs)) (b (cadr xs)) (add? (eq? op 'ADD))
                                        (lop (if add? fp-ladd fp-lmul)) (rop (if add? rs-ladd rs-lmul)))
                                   (subst (dk-cite! (if add? 'rq-add-computes 'rq-mul-computes) fp-r a b))
                                   (subst `(== (,op ,fp-r) ,lop))
                                   (let ((v (fp-eval! `(,lop ,a ,b))))
                                     (f-at! v) (subst `(= (,f (CLASS ,fp-s ,v)) (CLASS ,rs-rs (io ,v))))
                                     (subst `(= (,f (CLASS ,fp-s ,a)) (CLASS ,rs-rs (io ,a))))
                                     (subst `(= (,f (CLASS ,fp-s ,b)) (CLASS ,rs-rs (io ,b))))
                                     (subst (dk-cite! (if add? 'rq-add-computes 'rq-mul-computes) rs-r `(io ,a) `(io ,b)))
                                     (subst `(== (,op ,rs-r) ,rop))
                                     (let ((kt (rs-eval! `(,rop (io ,a) (io ,b)))))
                                       (io-laws! a b)
                                       (subst `(= (io ,v) ,kt))
                                       (rs-pt! kt)
                                       (qp-rfl!))))))))
                           (#t
                            ;; f(0) = 0 and f(1) = 1
                            (let ((z? (dk-contains? g1 'ZERO)))
                              (subst `(== (,(if z? 'ZERO 'ONE) ,fq) (CLASS ,fp-s (,(if z? 'ZERO 'ONE) ,fp-r))))
                              (subst `(== (,(if z? 'ZERO 'ONE) ,fp-r) ,(if z? 0 1)))
                              (f-at! (if z? 0 1))
                              (subst `(= (,f (CLASS ,fp-s ,(if z? 0 1))) (CLASS ,rs-rs (io ,(if z? 0 1)))))
                              (subst `(= (io ,(if z? 0 1)) (,(if z? 'ZERO 'ONE) K)))
                              (subst `(== (,(if z? 'ZERO 'ONE) ,rqr) (CLASS ,rs-rs (,(if z? 'ZERO 'ONE) ,rs-r))))
                              (subst `(== (,(if z? 'ZERO 'ONE) ,rs-r) (,(if z? 'ZERO 'ONE) K)))
                              (rs-pt! `(,(if z? 'ZERO 'ONE) K))
                              (qp-rfl!)))))))
            ((dk-contains? g0 'riu_)
             ;; injective
             (let* ((landed (dk-landed (lambda () (dk-peel!))))
                    (vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed)))
                    (e0 (find-first (lambda (f) (dk-head-is? f '=)) landed))
                    (c1 (car vs)) (c2 (cadr vs))
                    (a (fp-rep! c1)) (b (fp-rep! c2))
                    (e1 (dk-rewrite-h! e0 c1 `(CLASS ,fp-s ,a)))
                    (e2 (dk-rewrite-h! e1 c2 `(CLASS ,fp-s ,b))))
               (f-at! a) (f-at! b)
               (let* ((e3 (dk-rewrite-h! e2 `(,f (CLASS ,fp-s ,a)) `(CLASS ,rs-rs (io ,a))))
                      (e4 (dk-rewrite-h! e3 `(,f (CLASS ,fp-s ,b)) `(CLASS ,rs-rs (io ,b)))))
                 (dk-iff-fwd! (dk-cite! 'rs-class-eq-iff 'K 'A `(io ,a) `(io ,b)))
                 (let* ((kt (sum! a b)) (d `(+ ,a (- ,b)))
                        (h0 `(IN ,kt ,rs-m))
                        (h1 (dk-rewrite-h! h0 `((NEG K) (io ,b)) `(io (- ,b))))
                        (h2 (dk-rewrite-h! h1 `((ADD K) (io ,a) (io (- ,b))) `(io ,d))))
                   (dk-iff-fwd! (dk-chain-ass! (dk-apply! mlaw d)))
                   (dk-iff-bwd! (dk-cite! 'fp-class-eq-iff 'p a b))
                   (dk-close-if-asm!)))))
            (#t
             ;; surjective, by density
             (let* ((landed (dk-landed (lambda () (dk-peel!))))
                    (yr (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed)))
                    (x (rs-rep! yr))
                    (n (dk-skolem! (dk-chain-ass! (dk-apply! dlaw x)))))
               (io-at! n)
               (dk-iff-bwd! (dk-cite! 'rs-class-eq-iff 'K 'A x `(io ,n)))
               (f-at! n)
               (ew `(CLASS ,fp-s ,n))
               (dk-conj-close!
                 (lambda ()
                   (if (dk-head-is? (dk-goal) 'IN)
                       (begin (subst `(== (CARR ,fq) (QUOTIENT ,fp-s))) (dk-cite! 'class-in-quotient fp-s n) (dk-close-if-asm!))
                       (begin
                         (subst `(= (,f (CLASS ,fp-s ,n)) (CLASS ,rs-rs (io ,n))))
                         (subst `(= (CLASS ,rs-rs ,x) (CLASS ,rs-rs (io ,n))))
                         (qp-rfl!)))))))))))))
(qed 'nv-residue-fp-iso)


;; the integers of an NV field form an NV domain
(sp (make-wff '(FORALL K (IMPLIES (IS-NV-FIELD K) (IS-NV-DOMAIN K (NV-INTEGERS K))))))
(dk-peel!)
(ql-ms-setup!)
(fact 'rr-one-in) (fact 'rr-zero-in)
(dk-cite! 'nv-integers-unfold 'K)
(dk-cite! 'nf-one-in-carr 'K) (dk-cite! 'nf-norm-one 'K) (dk-cite! 'nf-norm-of-zero 'K)
(let* ((zk '(NV-INTEGERS K))
       (open! (lambda (v) (dk-sep-parts! (dk-rewrite-h! `(IN ,v ,zk) zk ql-nvi)) (ql-typek! v)))
       (close! (lambda (v le) (dk-have! `(IN ,v ,zk) (lambda () (subst `(== ,zk ,ql-nvi)) (in-sep! (lambda () (dk-close-if-asm!)) le))))))
  (mac 'IS-NV-DOMAIN)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (dk-ass!))
          ((equal? g `(IN (ZERO K) ,zk)) (ql-typek! '(ZERO K)) (close! '(ZERO K) (lambda () (dk-ineq! '(= ((FNRM K) (ZERO K)) 0)))) (dk-close-if-asm!))
          ((equal? g `(IN (ONE K) ,zk)) (ql-typek! '(ONE K)) (close! '(ONE K) (lambda () (dk-ineq! '(= ((FNRM K) (ONE K)) 1)))) (dk-close-if-asm!))
          (#t
           (let* ((landed (dk-landed (lambda () (dk-peel!))))
                  (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) zk))) landed))))
             (for-each open! vs)
             (let ((g2 (dk-goal)))
               (cond
                 ((dk-asm? g2) (dk-ass!))
                 ((dk-head-is? g2 '<=) (dk-close-if-asm!))
                 (#t
                  (let* ((t (cadr g2)) (x (car vs)))
                    (cond
                      ((equal? (car t) '(ADD K))
                       (let ((y (cadr vs)))
                         (dk-cite! 'nf-add-in-carr 'K x y) (ql-typek! t)
                         (dk-cite! 'nv-ultra 'K x y)
                         (dk-cite! 'rr-max-closed (ql-n x) (ql-n y))
                         (dk-chain-ass! (dk-cite! 'rr-max-le (ql-n x) (ql-n y) 1))
                         (close! t (lambda () (dk-ineq! `(<= ,(ql-n t) (MAX ,(ql-n x) ,(ql-n y))) `(<= (MAX ,(ql-n x) ,(ql-n y)) 1))))))
                      ((equal? (car t) '(MUL K))
                       (let ((y (cadr vs)))
                         (dk-cite! 'nf-mul-in-carr 'K x y) (ql-typek! t)
                         (dk-cite! 'nf-norm-mult 'K x y)
                         (dk-chain-ass! (dk-cite! 'rr-mul-le-right (ql-n x) 1 (ql-n y)))
                         (dk-rr-mul! (ql-n x) (ql-n y)) (dk-rr-mul! 1 (ql-n y))
                         (dk-have! `(= (* 1 ,(ql-n y)) ,(ql-n y)) (lambda () (crs)))
                         (close! t (lambda () (dk-ineq! `(= ,(ql-n t) (* ,(ql-n x) ,(ql-n y))) `(<= (* ,(ql-n x) ,(ql-n y)) (* 1 ,(ql-n y)))
                                                        `(= (* 1 ,(ql-n y)) ,(ql-n y)) `(<= ,(ql-n y) 1))))))
                      (#t
                       (dk-cite! 'nf-neg-in-carr 'K x) (ql-typek! t)
                       (dk-cite! 'nf-norm-neg 'K x)
                       (close! t (lambda () (dk-ineq! `(= ,(ql-n t) ,(ql-n x)) `(<= ,(ql-n x) 1))))))
                    (dk-close-if-asm!))))))))))))
(qed 'nv-integers-domain)

;; Proposition 1.22: Z(Q) / M(Q) is (isomorphic to) the field F_p
(define q22-k '(QQ-PADIC p))
(define q22-z '(NV-INTEGERS (QQ-PADIC p)))
(define q22-io '(VNB-LAMBDA ion_ ZZ ion_))
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORSOME ff (IS-RING-ISO (FP p) (NV-RESIDUE ,q22-k ,q22-z) ff))))))
(dk-peel!)
(qp-setup!)
(fact 'rr-one-in) (fact 'qq-is-set) (fact 'zz-is-set)
(dk-cite! 'qq-padic-is-nv-field 'p)
(dk-cite! 'nv-integers-domain q22-k)
(dk-cite! 'pc-nv-integers-eq 'p)
(for-each (lambda (n) (dk-cite! n 'p)) '(pq-add pq-mul pq-neg pq-zero pq-one pq-fnrm))
(dk-cite! 'nv-maximal-unfold q22-k q22-z)
(let* ((m `(NV-MAXIMAL ,q22-k ,q22-z))
       (ms `(SEP cwx_ ,q22-z (< ((FNRM ,q22-k) cwx_) 1)))
       (zin! (lambda (n)
               ;; n in QQ with |n| <= 1: land n in Z(Q)
               (qp-or-asm `(IN ,n ,q22-z)
                 (lambda () (dk-have! `(IN ,n ,q22-z) (lambda () (subst `(= ,q22-z ,qp-zqs)) (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!))))))))))
  ;; io maps ZZ into Z(Q)
  (dk-have! `(IN ,q22-io (FUN ZZ ,q22-z))
    (lambda ()
      (dk-each-leaf! (lambda () (lam-t))
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let* ((landed (dk-landed (lambda () (dk-peel!))))
                     (n (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
                (dk-cite! 'zz-subset-qq n) (dk-cite! 'pc-abs-int 'p n) (zin! n) (dk-close-if-asm!))
              (dk-close-if-asm!))))))
  ;; the ring laws of io
  (let ((ring! (lambda ()
                 ;; goal: an io-equation; beta, unfold the QQ-PADIC operations, beta, close
                 (dk-lam-b!)
                 (for-each (lambda (r) (if (dk-contains? (dk-goal) `(,(car r) ,q22-k)) (subst `(= (,(car r) ,q22-k) ,(cadr r)))))
                           '((ADD (VNB-LAMBDA (LIST x_ y_) (CARTESIAN QQ QQ) (+ x_ y_))) (MUL (VNB-LAMBDA (LIST x_ y_) (CARTESIAN QQ QQ) (* x_ y_)))
                             (NEG (VNB-LAMBDA x_ QQ (- x_))) (ZERO 0) (ONE 1)))
                 (if (dk-contains? (dk-goal) 'VNB-LAMBDA) (dk-lam-b!))
                 (qp-rfl!))))
    (dk-have! `(FORALL im (IMPLIES (IN im ZZ) (FORALL jn (IMPLIES (IN jn ZZ)
                 (AND (= (,q22-io (+ im jn)) ((ADD ,q22-k) (,q22-io im) (,q22-io jn))) (= (,q22-io (* im jn)) ((MUL ,q22-k) (,q22-io im) (,q22-io jn))))))))
      (lambda ()
        (dk-peel!)
        (dk-have-and! '(IN im ZZ) '(IN jn ZZ)) (dk-cite! 'zz-add-closed 'im 'jn) (dk-cite! 'zz-mul-closed 'im 'jn)
        (for-each (lambda (v) (dk-cite! 'zz-subset-qq v)) '(im jn (+ im jn) (* im jn)))
        (dk-conj-close! (lambda () (ring!)))))
    (dk-have! `(FORALL im (IMPLIES (IN im ZZ) (= (,q22-io (- im)) ((NEG ,q22-k) (,q22-io im)))))
      (lambda () (dk-peel!) (dk-cite! 'zz-neg-closed 'im) (dk-cite! 'zz-subset-qq 'im) (dk-cite! 'zz-subset-qq '(- im)) (ring!)))
    (fact 'zz-zero-in) (fact 'zz-one-in)
    (dk-have! `(= (,q22-io 0) (ZERO ,q22-k)) (lambda () (ring!)))
    (dk-have! `(= (,q22-io 1) (ONE ,q22-k)) (lambda () (ring!))))
  ;; io(n) in M iff p | n
  (dk-have! `(FORALL im (IMPLIES (IN im ZZ) (IFF (IN (,q22-io im) ,m) (ZZ-DIVIDES p im))))
    (lambda ()
      (dk-peel!)
      (dk-lam-b!)
      (dk-cite! 'zz-subset-qq 'im) (dk-cite! 'pc-abs-int 'p 'im) (zin! 'im)
      (let ((iff (dk-cite! 'qo-int-small-iff 'p 'im)))
        (dk-iff! (lambda (g) (dk-head-is? g 'ZZ-DIVIDES))
          (lambda ()
            (dk-sep-parts! (dk-rewrite-h! `(IN im ,m) m ms))
            (dk-rewrite-h! `(< ((FNRM ,q22-k) im) 1) `(FNRM ,q22-k) '(PADIC-ABS p))
            (dk-iff-fwd! iff) (dk-close-if-asm!))
          (lambda ()
            (dk-iff-bwd! iff)
            (subst `(== ,m ,ms))
            (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (subst `(= (FNRM ,q22-k) (PADIC-ABS p))) (dk-close-if-asm!))))))))
  ;; density (Corollary 1.20)
  (dk-have! `(FORALL xa (IMPLIES (IN xa ,q22-z) (FORSOME im (AND (IN im ZZ) (IN ((ADD ,q22-k) xa ((NEG ,q22-k) (,q22-io im))) ,m)))))
    (lambda ()
      (dk-peel!)
      (dk-have! '(< 0 1) (lambda () (arith)))
      (qp-pos-rr! 1)
      (let ((th (dk-skolem! (dk-chain-ass! (dk-cite! 'ccr-1-20 'p 'xa 1)))))
        (dk-sep-parts! (dk-rewrite-h! `(IN xa ,q22-z) q22-z qp-zqs))
        (dk-cite! 'zz-subset-qq th)
        (qp-qq-sub! th 'xa) (qp-qq-sub! 'xa th)
        (dk-cite! 'pc-dist 'p th 'xa)
        (dk-rewrite-h! `(< ((DIST ,qm) ,th xa) 1) `((DIST ,qm) ,th xa) (qp-a `(+ ,th (- xa))))
        (dk-have! `(= (+ xa (- ,th)) (- (+ ,th (- xa)))) (lambda () (crs)))
        (dk-cite! 'qq-neg-closed `(+ ,th (- xa)))
        (dk-cite! 'pc-abs-neg 'p `(+ ,th (- xa)))
        (dk-have! `(< ,(qp-a `(+ xa (- ,th))) 1)
          (lambda () (subst `(= (+ xa (- ,th)) (- (+ ,th (- xa))))) (subst `(= ,(qp-a `(- (+ ,th (- xa)))) ,(qp-a `(+ ,th (- xa))))) (dk-close-if-asm!)))
        (dk-have! `(<= ,(qp-a `(+ xa (- ,th))) 1) (lambda () (dk-ineq! `(< ,(qp-a `(+ xa (- ,th))) 1))))
        (zin! `(+ xa (- ,th)))
        (ew th)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (begin
                  (dk-lam-b!)
                  (subst `(= (NEG ,q22-k) (VNB-LAMBDA x_ QQ (- x_))))
                  (subst `(= (ADD ,q22-k) (VNB-LAMBDA (LIST x_ y_) (CARTESIAN QQ QQ) (+ x_ y_))))
                  (dk-lam-b!)
                  (subst `(== ,m ,ms))
                  (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (subst `(= (FNRM ,q22-k) (PADIC-ABS p))) (dk-close-if-asm!)))))))))))
(dk-chain-ass! (dk-cite! 'nv-residue-fp-iso 'p q22-k q22-z q22-io))
(dk-close-if-asm!)
(qed 'ccr-1-22)

;; the embedding Q -> Q_p is a ring homomorphism
(define (qp-embed-op! name args lhs-arg rhs)
  (dk-sp-qed! (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p)
     ,(let wrap ((as args)) (if (null? as) `(= ,(qp-em lhs-arg) ,rhs) `(FORALL ,(car as) (IMPLIES (IN ,(car as) QQ) ,(wrap (cdr as)))))))))
  (lambda ()
  (dk-peel!)
  (qp-field-setup!)
  (fact 'nn-is-set)
  (for-each (lambda (n) (dk-cite! n 'p)) '(qp-field-add qp-field-mul qp-field-neg qp-field-zero qp-field-one qp-zero-class qp-one-class))
  (qp-or-asm `(IN ,lhs-arg QQ)
    (lambda () (cond ((dk-head-is? lhs-arg '+) (dk-have-and! `(IN ,(cadr lhs-arg) QQ) `(IN ,(caddr lhs-arg) QQ)) (dk-cite! 'qq-add-closed (cadr lhs-arg) (caddr lhs-arg)))
                     ((dk-head-is? lhs-arg '*) (dk-have-and! `(IN ,(cadr lhs-arg) QQ) `(IN ,(caddr lhs-arg) QQ)) (dk-cite! 'qq-mul-closed (cadr lhs-arg) (caddr lhs-arg)))
                     ((dk-head-is? lhs-arg '-) (dk-cite! 'qq-neg-closed (cadr lhs-arg)))
                     (#t (fact (if (eqv? lhs-arg 0) 'qq-zero-in 'qq-one-in))))))
  (for-each (lambda (u) (subst (dk-cite! 'qp-embed-value 'p u)) (qp-type! (qp-cseq u))) (cons lhs-arg args))
  (for-each (lambda (r) (if (dk-contains? (dk-goal) `(,(car r) ,qf)) (subst `(== (,(car r) ,qf) (,(car r) ,qr)))))
            '((ADD) (MUL) (NEG) (ZERO) (ONE)))
  (cond ((dk-contains? (dk-goal) `(ADD ,qr)) (subst (dk-cite! 'qp-add-class 'p (qp-cseq (car args)) (qp-cseq (cadr args)))))
        ((dk-contains? (dk-goal) `(MUL ,qr)) (subst (dk-cite! 'qp-mul-class 'p (qp-cseq (car args)) (qp-cseq (cadr args)))))
        ((dk-contains? (dk-goal) `(NEG ,qr)) (subst (dk-cite! 'qp-neg-class 'p (qp-cseq (car args)))))
        ((dk-contains? (dk-goal) `(ZERO ,qr)) (subst `(= (ZERO ,qr) (CLASS ,qs ,qz))))
        (#t (subst `(= (ONE ,qr) (CLASS ,qs ,q1)))))
  (let ((g (dk-goal)))
    (if (not (equal? (cadr g) (caddr g)))
        (let ((l (caddr (cadr g))) (r (caddr (caddr g))))
          (qp-type! r)
          (dk-have! `(= ,r ,l) (lambda () (qp-seq-eq!)))
          (subst `(= ,r ,l)))))
  (qp-class! (qp-cseq lhs-arg))
  (qp-rfl!)
  )
  name))
(qp-embed-op! 'qp-embed-add '(u v) '(+ u v) `((ADD ,qf) ,(qp-em 'u) ,(qp-em 'v)))
(qp-embed-op! 'qp-embed-mul '(u v) '(* u v) `((MUL ,qf) ,(qp-em 'u) ,(qp-em 'v)))
(qp-embed-op! 'qp-embed-neg '(u) '(- u) `((NEG ,qf) ,(qp-em 'u)))
(qp-embed-op! 'qp-embed-zero '() 0 `(ZERO ,qf))
(qp-embed-op! 'qp-embed-one '() 1 `(ONE ,qf))

;; Corollary 2.24: the residue field Z_p / M(Q_p) of Q_p is (isomorphic to) F_p
(define q24-io `(VNB-LAMBDA ion_ ZZ ((EMBED ,qm) ion_)))
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORSOME ff (IS-RING-ISO (FP p) (NV-RESIDUE ,qf (ZP p)) ff))))))
(dk-peel!)
(qp-zp-setup!)
(qo-field-setup!)
(fact 'zz-is-set)
(dk-cite! 'qp-is-nv-field 'p)
(dk-have! `(== (ZP p) (NV-INTEGERS ,qf)) (lambda () (mac 'ZP) (qrfl)))
(dk-rewrite-h! (dk-cite! 'nv-integers-domain qf) `(NV-INTEGERS ,qf) '(ZP p))
(dk-cite! 'nv-maximal-unfold qf '(ZP p))
(for-each (lambda (n) (dk-cite! n 'p)) '(qp-embed-add qp-embed-mul qp-embed-neg qp-embed-zero qp-embed-one))
(let* ((m `(NV-MAXIMAL ,qf (ZP p)))
       (ms `(SEP cwx_ (ZP p) (< ((FNRM ,qf) cwx_) 1)))
       (zq! (lambda (n) (dk-cite! 'zz-subset-qq n) (dk-cite! 'pc-abs-int 'p n) (qp-em-zp! n))))
  (dk-have! `(IN ,q24-io (FUN ZZ (ZP p)))
    (lambda ()
      (dk-each-leaf! (lambda () (lam-t))
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let* ((landed (dk-landed (lambda () (dk-peel!))))
                     (n (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
                (zq! n) (dk-close-if-asm!))
              (dk-close-if-asm!))))))
  (let ((hom! (lambda () (dk-lam-b!) (dk-close-if-asm!))))
    (dk-have! `(FORALL im (IMPLIES (IN im ZZ) (FORALL jn (IMPLIES (IN jn ZZ)
                 (AND (= (,q24-io (+ im jn)) ((ADD ,qf) (,q24-io im) (,q24-io jn))) (= (,q24-io (* im jn)) ((MUL ,qf) (,q24-io im) (,q24-io jn))))))))
      (lambda ()
        (dk-peel!)
        (dk-have-and! '(IN im ZZ) '(IN jn ZZ)) (dk-cite! 'zz-add-closed 'im 'jn) (dk-cite! 'zz-mul-closed 'im 'jn)
        (for-each (lambda (v) (dk-cite! 'zz-subset-qq v)) '(im jn))
        (dk-cite! 'qp-embed-add 'p 'im 'jn) (dk-cite! 'qp-embed-mul 'p 'im 'jn)
        (dk-conj-close! (lambda () (hom!)))))
    (dk-have! `(FORALL im (IMPLIES (IN im ZZ) (= (,q24-io (- im)) ((NEG ,qf) (,q24-io im)))))
      (lambda () (dk-peel!) (dk-cite! 'zz-neg-closed 'im) (dk-cite! 'zz-subset-qq 'im) (dk-cite! 'qp-embed-neg 'p 'im) (hom!)))
    (fact 'zz-zero-in) (fact 'zz-one-in)
    (dk-have! `(= (,q24-io 0) (ZERO ,qf)) (lambda () (hom!)))
    (dk-have! `(= (,q24-io 1) (ONE ,qf)) (lambda () (hom!))))
  (dk-have! `(FORALL im (IMPLIES (IN im ZZ) (IFF (IN (,q24-io im) ,m) (ZZ-DIVIDES p im))))
    (lambda ()
      (dk-peel!)
      (dk-lam-b!)
      (zq! 'im)
      (qp-abs! 'im)
      (let ((iff (dk-cite! 'qo-int-small-iff 'p 'im)) (e (qp-em 'im)))
        (dk-iff! (lambda (g) (dk-head-is? g 'ZZ-DIVIDES))
          (lambda ()
            (dk-sep-parts! (dk-rewrite-h! `(IN ,e ,m) m ms))
            (let* ((h1 (dk-rewrite-h! `(< ((FNRM ,qf) ,e) 1) `(FNRM ,qf) '(QP-ABS p))))
              (dk-rewrite-h! h1 `((QP-ABS p) ,e) (qp-a 'im)))
            (dk-iff-fwd! iff) (dk-close-if-asm!))
          (lambda ()
            (dk-iff-bwd! iff)
            (subst `(== ,m ,ms))
            (in-sep! (lambda () (dk-close-if-asm!))
                     (lambda () (subst `(== (FNRM ,qf) (QP-ABS p))) (subst `(= ((QP-ABS p) ,e) ,(qp-a 'im))) (dk-close-if-asm!))))))))
  (dk-have! `(FORALL xa (IMPLIES (IN xa (ZP p)) (FORSOME im (AND (IN im ZZ) (IN ((ADD ,qf) xa ((NEG ,qf) (,q24-io im))) ,m)))))
    (lambda ()
      (dk-peel!)
      (dk-have! '(< 0 1) (lambda () (arith)))
      (qp-pos-rr! 1)
      (dk-split-all! (list (dk-cite! 'ccr-1-28 'p)))
      (let* ((dl (qp-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR) (dk-contains? f 'EMBED))) "density"))
             (n (dk-skolem! (dk-chain-ass! (dk-apply! dl 'xa 1))))
             (e (qp-em n)))
        (zq! n)
        (dk-chain-ass! (dk-cite! 'subset-mem-fwd '(ZP p) '(PTS (QP p)) 'xa))
        (dk-chain-ass! (dk-cite! 'subset-mem-fwd '(ZP p) '(PTS (QP p)) e))
        (let* ((d0 (dk-cite! 'ccr-1-26-metric 'p 'xa e))
               (h (dk-rewrite-h! `(< ((DIST (QP p)) xa ,e) 1) `((DIST (QP p)) xa ,e) (caddr d0))))
          (dk-cite! 'nv-domain-neg qf '(ZP p) e)
          (dk-cite! 'nv-domain-add qf '(ZP p) 'xa `((NEG ,qf) ,e))
          (ew n)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (begin
                    (dk-lam-b!)
                    (subst `(== ,m ,ms))
                    (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!))))))))))))
(dk-chain-ass! (dk-cite! 'nv-residue-fp-iso 'p qf '(ZP p) q24-io))
(dk-close-if-asm!)
(qed 'ccr-2-24)

