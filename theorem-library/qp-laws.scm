  (qp-or-asm `(IN ,fp-ladd (FUN (CARTESIAN ZZ ZZ) ZZ))
    (lambda ()
      (dk-have! '(IS-RING ZZ-RING) (lambda () (fact 'zz-is-ring) (dk-close-if-asm!)))
      (let ((parts (dk-split! (dk-landed-1 (lambda () (mac-h 'IS-RING '(IS-RING ZZ-RING)))))))
        (for-each (lambda (f)
                    (let loop ((f f) (rs (list (list '(CARR ZZ-RING) 'ZZ) (list '(ZERO ZZ-RING) 0) (list '(ONE ZZ-RING) 1)
                                              (list '(ADD ZZ-RING) fp-ladd) (list '(MUL ZZ-RING) fp-lmul) (list '(NEG ZZ-RING) fp-lneg))))
                      (if (pair? rs)
                          (loop (if (dk-contains? f (car (car rs))) (dk-rewrite-h! f (car (car rs)) (cadr (car rs))) f) (cdr rs)))))
                  parts)))))
(define (fp-in! n) (qp-or-asm `(IN ,n ZZ) (lambda () (error "fp-in!: untyped" n))) n)

