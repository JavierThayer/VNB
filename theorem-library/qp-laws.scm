(dk-isx-set!)   ; W1J-C: the conjunct t in SET, from the typings
(for-each (lambda (n) (dk-cite! n 'p)) '(fp-carr fp-add fp-mul fp-neg fp-zero fp-one fp-idl))
(for-each (lambda (r) (subst `(== (,(car r) ,fp-r) ,(cadr r))))
          (list (list 'CARR 'ZZ) (list 'ADD fp-ladd) (list 'MUL fp-lmul) (list 'NEG fp-lneg) (list 'ZERO 0) (list 'ONE 1) (list 'IDL fp-pz)))
(let split ((fuel 40))
  (let ((andl (find-first (lambda (s) (dk-head-is? (dk-goal-of s) 'AND)) (dk-open-leaves))))
    (when andl
      (if (= fuel 0) (error "fp: AND split did not terminate"))
      (dk-focus! andl) (di) (split (- fuel 1)))))
(for-each
  (lambda (l)
    (if (not (sequent-node-grounded? l))
        (begin
          (dk-focus! l)
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (dk-ass!))
                  ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH)) (mac 'FP-RINGOID) (len-r) (arith))
                  ((dk-head-is? g 'is-ideal-in) (mac 'is-ideal-in) (fp-ideal-leaf!))
                  (#t (error "fp ringoid: unexpected conjunct" g)))))))
  (dk-open-leaves))
