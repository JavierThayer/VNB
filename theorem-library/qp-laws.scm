;;; 22. Corollary 4.13: open additive subgroups of Q_p other than Q_p are principal modules.

;; Z_p is a compact NV domain of the field Q_p
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (IS-COMPACT-NV-DOMAIN ,qf (ZP p))))))
(dk-peel!)
(dk-cite! 'qp-is-nv-field 'p)
(dk-cite! 'qp-nf-metric-eq 'p)
(dk-cite! 'qp-zp-compact 'p)
(dk-have! `(== (ZP p) (NV-INTEGERS ,qf)) (lambda () (mac 'ZP) (qrfl)))
(dk-rewrite-h! (dk-cite! 'nv-integers-domain qf) `(NV-INTEGERS ,qf) '(ZP p))
(mac 'IS-COMPACT-NV-DOMAIN)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (begin (subst `(== (NF-METRIC-SPACE ,qf) (QP p))) (dk-close-if-asm!)))))
(qed 'qp-zp-compact-domain)

;; |p|_p 2 = 1
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (= (* ((PADIC-ABS p) p) 2) 1)))))
(dk-peel!)
(qp-setup!)
(fact 'nn-one-in)
(dk-cite! 'zz-subset-qq 'p) (dk-cite! 'zz-in-rr 'p)
(dk-have! '(IN 2 RR) (lambda () (arith)))
(dk-cite! 'qo-power-one 'p) (dk-cite! 'qo-power-one 2)
(let* ((e0 (dk-cite! 'pc-abs-power-two 'p 1))
       (e1 (dk-rewrite-h! e0 '(power p 1) 'p)))
  (dk-rewrite-h! e1 '(power 2 1) 2)
  (dk-close-if-asm!))
(qed 'qo-abs-p)

;; for m in ZZ: 2^m < 1 gives 2^m 2 <= 1 (the values of |.| are discrete)
(sp (make-wff `(FORALL m (IMPLIES (IN m ZZ) (IMPLIES (< ,(qo-rp 'm) 1) (<= (* ,(qo-rp 'm) 2) 1))))))
(dk-peel!)
(qo-zr! 'm) (qo-rp! 'm)
(fact 'rr-zero-in) (fact 'rr-one-in) (fact 'zz-zero-in) (fact 'zz-one-in)
(dk-cite! 'rpow-star-zero 2) (dk-cite! 'rpow-star-one 2)
(dk-have! '(< 1 2) (lambda () (arith)))
(let ((rm (qo-rp 'm)) (m1 '(+ m 1)))
  (dk-have! '(< m 0)
    (lambda ()
      (pbc)
      (dk-chain-ass! (dk-cite! 'rr-not-lt-ge 'm 0))
      (use-em '(= m 0)
        (lambda () (dk-have! `(= ,rm 1) (lambda () (subst '(= m 0)) (subst `(= ,(qo-rp 0) 1)) (qp-rfl!)))
                   (dk-absurd! `(= ,rm 1) `(< ,rm 1)))
        (lambda ()
          (dk-have! '(NOT (= 0 m)) (lambda () (di) (dk-have! '(= m 0) (lambda () (subst '(= m 0)) (qp-rfl!))) (ai '(NOT (= m 0)))))
          (dk-have-and! '(<= 0 m) '(NOT (= 0 m)))
          (dk-chain-ass! (dk-cite! 'rr-le-ne-lt 0 'm))
          (let* ((u0 (dk-chain-ass! (dk-cite! 'rpow-star-mono-exp 2 0 'm))) (u1 (dk-rewrite-h! u0 (qo-rp 0) 1)))
            (dk-absurd! u1 `(< ,rm 1)))))))
  (dk-chain-ass! (dk-cite! 'zz-lt-succ-le 'm 0))
  (dk-have-and! '(IN m RR) '(IN 1 RR)) (dk-cite! 'rr-add-closed 'm 1)
  (qo-rp! m1)
  (let* ((a0 (dk-cite! 'rpow-star-add 2 'm 1)) (a1 (dk-rewrite-h! a0 (qo-rp 1) 2)))
    (subst `(= (* ,rm 2) ,(qo-rp m1)))
    (use-em `(= ,m1 0)
      (lambda () (subst `(= ,m1 0)) (subst `(= ,(qo-rp 0) 1)) (dk-ineq!))
      (lambda ()
        (dk-have-and! `(<= ,m1 0) `(NOT (= ,m1 0)))
        (dk-chain-ass! (dk-cite! 'rr-le-ne-lt m1 0))
        (let* ((u0 (dk-chain-ass! (dk-cite! 'rpow-star-mono-exp 2 m1 0))) (u1 (dk-rewrite-h! u0 (qo-rp 0) 1)))
          (dk-ineq! u1))))))
(qed 'qo-rpow-half)

;; M(Z_p) = p Z_p
(define qo-uw (qp-em 'p))
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (= (NV-MAXIMAL ,qf (ZP p)) (NV-PRINCIPAL ,qf (ZP p) ,qo-uw))))))
(dk-peel!)
(qp-zp-setup!)
(qo-field-setup!)
(dk-cite! 'qp-is-nv-field 'p)
(dk-have! `(== (ZP p) (NV-INTEGERS ,qf)) (lambda () (mac 'ZP) (qrfl)))
(dk-rewrite-h! (dk-cite! 'nv-integers-domain qf) `(NV-INTEGERS ,qf) '(ZP p))
(dk-cite! 'nv-maximal-unfold qf '(ZP p))
(dk-cite! 'zz-subset-qq 'p)
(dk-cite! 'qo-abs-p 'p)
(qp-abs! 'p)
(dk-have! '(IN 2 RR) (lambda () (arith)))
(fact 'rr-one-in) (fact 'rr-zero-in)
(dk-cite! 'pc-abs-int 'p 'p)
(qp-em-zp! 'p)
(dk-cite! 'nv-principal-unfold qf '(ZP p) qo-uw)
(dk-cite! 'nf-one-in-carr qf) (dk-cite! 'nf-norm-one qf) (dk-cite! 'nf-zero-in-carr qf)
(let* ((zp '(ZP p)) (m `(NV-MAXIMAL ,qf ,zp)) (pr `(NV-PRINCIPAL ,qf ,zp ,qo-uw))
       (ms `(SEP cwx_ ,zp (< ((FNRM ,qf) cwx_) 1)))
       (ps `(SEP cwx_ ,zp (FORSOME cwm_ (AND (IN cwm_ ,zp) (= cwx_ ((MUL ,qf) cwm_ ,qo-uw))))))
       (ap (qp-a 'p))
       (incarr! (lambda (v) (qp-or-asm `(IN ,v (CARR ,qf)) (lambda () (dk-chain-ass! (dk-cite! 'nv-domain-sub qf zp v)))) v)))
  (incarr! qo-uw)
  (let ((auw (qo-abs! qo-uw)))
    (dk-have! `(< 0 ,ap) (lambda () (dk-ineq! `(= (* ,ap 2) 1))))
    (dk-have! `(NOT (= ,qo-uw (ZERO ,qf)))
      (lambda () (di)
        (let* ((z0 (dk-cite! 'nf-norm-of-zero qf)) (z1 (dk-rewrite-h! z0 `(ZERO ,qf) qo-uw)))
          (dk-absurd! z1 `(= ((FNRM ,qf) ,qo-uw) ,auw) `(= ,auw ,ap) `(< 0 ,ap)))))
    (let ((ch (dk-cite! 'class-extensionality m pr)))
      (dk-have! (cadr ch)
        (lambda ()
          (dk-peel!)
          (let ((z (cadr (cadr (dk-goal)))))
            (dk-iff! (lambda (g) (dk-contains? g 'NV-PRINCIPAL))
              (lambda ()
                ;; |z| < 1: z = (z / p) p with |z / p| = 2 |z| <= 1
                (dk-sep-parts! (dk-rewrite-h! `(IN ,z ,m) m ms))
                (incarr! z)
                (let ((az (qo-abs! z)))
                  (dk-rewrite-h! `(< ((FNRM ,qf) ,z) 1) `((FNRM ,qf) ,z) az)
                  (subst `(== ,pr ,ps))
                  (in-sep! (lambda () (dk-close-if-asm!))
                    (lambda ()
                      (use-em `(= ,z (ZERO ,qf))
                        (lambda ()
                          (dk-chain-ass! (dk-cite! 'nv-domain-zero qf zp))
                          (ew `(ZERO ,qf))
                          (dk-conj-close!
                            (lambda () (if (not (dk-ass!)) (begin (subst `(= ,z (ZERO ,qf))) (qk-crs! qf (list qo-uw)))))))
                        (lambda ()
                          (let* ((k (dk-skolem! (dk-chain-ass! (dk-cite! 'qo-abs-power 'p z))))
                                 (rk (qo-rp k)))
                            (qo-zr! k) (qo-rp! k)
                            (dk-have! `(< ,rk 1) (lambda () (subst `(= ,rk ,az)) (dk-close-if-asm!)))
                            (dk-chain-ass! (dk-cite! 'qo-rpow-half k))
                            (let* ((b (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-inverse qf qo-uw))))
                                   (ab (qo-abs! b)) (mm `((MUL ,qf) ,z ,b)))
                              (dk-cite! 'nf-mul-in-carr qf z b)
                              (let* ((n0 (dk-cite! 'nf-norm-mult qf qo-uw b))
                                     (n1 (dk-rewrite-h! n0 `((MUL ,qf) ,qo-uw ,b) `(ONE ,qf)))
                                     (n2 (dk-rewrite-h! n1 `((FNRM ,qf) (ONE ,qf)) 1))
                                     (n3 (dk-rewrite-h! n2 `((FNRM ,qf) ,qo-uw) auw))
                                     (n4 (dk-rewrite-h! n3 `((FNRM ,qf) ,b) ab))
                                     (n5 (dk-rewrite-h! n4 auw ap)))
                                (dk-have! `(= ,ab 2)
                                  (lambda ()
                                    (let* ((h0 (have-f! `(= (* (* ,ap ,ab) 2) (* ,ab (* ,ap 2))) (lambda () (qo-crs! (list ap ab)))))
                                           (h1 (dk-rewrite-h! h0 `(* ,ap 2) 1))
                                           (h2 (dk-rewrite-h! h1 `(* ,ap ,ab) 1)))
                                      (dk-have! `(= (* ,ab 1) ,ab) (lambda () (qo-crs! (list ab))))
                                      (dk-have! '(= (* 1 2) 2) (lambda () (crs)))
                                      (let* ((h3 (dk-rewrite-h! h2 `(* ,ab 1) ab)) (h4 (dk-rewrite-h! h3 '(* 1 2) 2)))
                                        (subst `(= ,ab 2))
                                        (qp-rfl!))))))
                              (let* ((amm (qo-abs! mm))
                                     (k0 (dk-cite! 'nf-norm-mult qf z b))
                                     (k1 (dk-rewrite-h! k0 `((FNRM ,qf) ,mm) amm))
                                     (k2 (dk-rewrite-h! k1 `((FNRM ,qf) ,z) az))
                                     (k3 (dk-rewrite-h! k2 `((FNRM ,qf) ,b) ab))
                                     (k4 (dk-rewrite-h! k3 ab 2))
                                     (k5 (dk-rewrite-h! k4 az rk)))
                                (dk-rewrite-h! `(IN ,mm (CARR ,qf)) `(CARR ,qf) '(PTS (QP p)))
                                (dk-have! `(<= ,amm 1) (lambda () (dk-ineq! k5 `(<= (* ,rk 2) 1))))
                                (qp-zp-in! mm)
                                (ew mm)
                                (dk-conj-close!
                                  (lambda ()
                                    (if (not (dk-ass!))
                                        (begin
                                          (dk-have! `(= ((MUL ,qf) ,mm ,qo-uw) ((MUL ,qf) ,z ((MUL ,qf) ,qo-uw ,b)))
                                            (lambda () (qk-crs! qf (list z b qo-uw))))
                                          (subst `(= ((MUL ,qf) ,mm ,qo-uw) ((MUL ,qf) ,z ((MUL ,qf) ,qo-uw ,b))))
                                          (subst `(= ((MUL ,qf) ,qo-uw ,b) (ONE ,qf)))
                                          (qk-crs! qf (list z)))))))))))))))
              (lambda ()
                ;; z = m p with m in Z_p: |z| <= |p| < 1
                (dk-sep-parts! (dk-rewrite-h! `(IN ,z ,pr) pr ps))
                (let* ((mm (dk-skolem! (qp-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f z))) "the cofactor"))))
                  (incarr! mm) (incarr! z)
                  (dk-chain-ass! (dk-cite! 'nv-domain-norm qf zp mm))
                  (let* ((amm (qo-abs! mm)) (az (qo-abs! z))
                         (k0 (dk-cite! 'nf-norm-mult qf mm qo-uw))
                         (k1 (dk-rewrite-h! k0 `((MUL ,qf) ,mm ,qo-uw) z))
                         (k2 (dk-rewrite-h! k1 `((FNRM ,qf) ,mm) amm))
                         (k3 (dk-rewrite-h! k2 `((FNRM ,qf) ,qo-uw) auw))
                         (k4 (dk-rewrite-h! k3 auw ap)))
                    (dk-rewrite-h! `(<= ((FNRM ,qf) ,mm) 1) `((FNRM ,qf) ,mm) amm)
                    (dk-chain-ass! (dk-cite! 'rr-mul-le-right amm 1 ap))
                    (dk-rr-mul! amm ap) (dk-rr-mul! 1 ap)
                    (dk-have! `(= (* 1 ,ap) ,ap) (lambda () (crs)))
                    (subst `(== ,m ,ms))
                    (in-sep! (lambda () (dk-close-if-asm!))
                             (lambda ()
                               (dk-ineq! k4 `(= ((FNRM ,qf) ,z) ,az) `(<= (* ,amm ,ap) (* 1 ,ap)) `(= (* 1 ,ap) ,ap) `(= (* ,ap 2) 1)))))))))))
      (detach! ch)
      (dk-close-if-asm!))))
(qed 'qp-maximal-principal)

;; an additive subgroup U of Q_p in context: land its four laws (kept as formulas); return them
(define (qsg-laws! u)
  (let ((h `(IS-ADD-SUBGROUP ,qf ,u)))
    (dk-split-all! (list (dk-project! (list 'AND
       `(FORALL asx_ (IMPLIES (IN asx_ ,u) (IN asx_ (CARR ,qf))))
       (list 'AND `(IN (ZERO ,qf) ,u)
         (list 'AND `(FORALL asx_ (IMPLIES (IN asx_ ,u) (FORALL asy_ (IMPLIES (IN asy_ ,u) (IN ((ADD ,qf) asx_ asy_) ,u)))))
                    `(FORALL asx_ (IMPLIES (IN asx_ ,u) (IN ((NEG ,qf) asx_) ,u))))))
       'is-add-subgroup h)))))
(define (qsg-law u key) (qp-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'asx_) (dk-contains? f u) (dk-contains? f key))) "subgroup law"))
;; embedded rationals are points of Q_p's field
(define (qo-em-carr! u)
  (dk-split-all! (list (dk-cite! 'qp-embed-abs 'p u)))
