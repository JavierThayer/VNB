       (law (qp-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h f) (dk-contains? h 'succ))) "the step law"))
       (dg `(VNB-LAMBDA qek_ ZZ (IF (<= n qek_) (QP-DIGIT p (,f (+ qek_ (- n)))) 0)))
