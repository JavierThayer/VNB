;;; that of its absolute value; Q sits in it isometrically; Z_p = Z(Q_p).

;; |x_k|_p converges to |[x]|
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (QP-CS p)) (CONVERGES-TO RR-MS ,(qp-abs-seq 'x) ,(qp-ab 'x))))))))
(dk-peel!)
