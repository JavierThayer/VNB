;;; 18. Proposition 2.7: the residue ring of a compact NV domain is a finite field.

;; the metric of an NV field is an ultrametric
(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (IS-ULTRAMETRIC ,qlm)))))
(dk-peel!)
(ql-ms-setup!)
(mac 'IS-ULTRAMETRIC)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed)))
               (x (car vs)) (y (cadr vs)) (z (caddr vs)))
          (subst (ql-dist! x y)) (subst (ql-dist! x z)) (subst (ql-dist! z y))
          (let* ((u (ql-add x (ql-neg z))) (w (ql-add z (ql-neg y))) (xy (ql-add x (ql-neg y))))
            (ql-ring-eq! `(= ,(ql-add u w) ,xy) (list x y z))
            (dk-rewrite-h! (dk-cite! 'nv-ultra 'K u w) (ql-add u w) xy)
            (dk-close-if-asm!))))))
(qed 'nv-field-ultrametric)

;; a subspace of an ultrametric space is ultrametric
(sp (make-wff '(FORALL s (IMPLIES (IS-ULTRAMETRIC s) (FORALL A (IMPLIES (IN A SET) (IMPLIES (SUBSET A (PTS s))
  (IS-ULTRAMETRIC (SUBSPACE-MS s A)))))))))
(dk-peel!)
(dk-project! '(IS-METRIC-SPACE s) 'is-ultrametric '(IS-ULTRAMETRIC s))
(let ((law (dk-project! '(FORALL umx_ (IMPLIES (IN umx_ (PTS s)) (FORALL umy_ (IMPLIES (IN umy_ (PTS s)) (FORALL umz_ (IMPLIES (IN umz_ (PTS s))
              (<= ((DIST s) umx_ umy_) (MAX ((DIST s) umx_ umz_) ((DIST s) umz_ umy_)))))))))
                        'is-ultrametric '(IS-ULTRAMETRIC s))))
  (dk-cite! 'subspace-is-metric-space 's 'A)
  (dk-cite! 'subspace-pts 's 'A)
  (mac 'IS-ULTRAMETRIC)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((landed (dk-landed (lambda () (dk-peel!))))
                 (vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed))))
            (for-each (lambda (v)
                        (dk-rewrite-h! `(IN ,v (PTS (SUBSPACE-MS s A))) '(PTS (SUBSPACE-MS s A)) 'A)
                        (dk-chain-ass! (dk-cite! 'subset-mem-fwd 'A '(PTS s) v)))
                      vs)
            (let ((x (car vs)) (y (cadr vs)) (z (caddr vs)))
              (for-each (lambda (pr) (subst (dk-cite! 'subspace-dist 's 'A (car pr) (cadr pr))))
                        (list (list x y) (list x z) (list z y)))
              (dk-chain-ass! (dk-apply! law x y z))
              (dk-close-if-asm!)))))))
(qed 'subspace-ultrametric)

;; the residue ringoid of an NV domain
(define rs-r '(NV-RES-RINGOID K A))
(define rs-ladd '(VNB-LAMBDA (LIST rsu_ rsv_) (CARTESIAN A A) ((ADD K) rsu_ rsv_)))
(define rs-lmul '(VNB-LAMBDA (LIST rsu_ rsv_) (CARTESIAN A A) ((MUL K) rsu_ rsv_)))
(define rs-lneg '(VNB-LAMBDA rsu_ A ((NEG K) rsu_)))
(define rs-m '(NV-MAXIMAL K A))
;; IS-NV-DOMAIN K A in context: K's facts, A a set inside CARR K
(define (rs-setup!)
  (qp-or-asm '(IS-NORMED-FIELD K) (lambda () (dk-cite! 'nv-domain-normed 'K 'A)))
  (qp-or-asm '(IS-NV-FIELD K) (lambda () (dk-cite! 'nv-domain-field 'K 'A)))
  (for-each (lambda (n) (dk-cite! n 'K 'A)) '(nv-domain-sub nv-domain-zero nv-domain-one nv-domain-add nv-domain-mul nv-domain-neg))
  (dk-cite! 'nv-maximal-unfold 'K 'A)
  (qp-or-asm '(IN (CARR K) SET) (lambda () (dk-project! '(IN (CARR K) SET) 'is-normed-field '(IS-NORMED-FIELD K))))
  (qp-or-asm '(SUBSET A (CARR K))
    (lambda () (dk-have! '(SUBSET A (CARR K))
                 (lambda () (mac 'subset-def) (dk-close-if-asm!)))))
  (qp-or-asm '(IN A SET) (lambda () (dk-chain-ass! (dk-cite! 'subclass-of-set-is-set 'A '(CARR K))))))
;; U in A: land U in CARR K
(define (rs-in! u)
  (qp-or-asm `(IN ,u (CARR K)) (lambda () (dk-chain-ass! (dk-apply! (qp-pick (lambda (f) (equal? f '(FORALL x (IMPLIES (IN x A) (IN x (CARR K)))))) "A in K") u))))
  u)
(define (rs-close! op u v)
  ;; U, V in A: land (OP K) U V in A
  (let ((t (if v `((,op K) ,u ,v) `((,op K) ,u)))
        (law (cdr (assq op '((ADD . (FORALL x (IMPLIES (IN x A) (FORALL y (IMPLIES (IN y A) (IN ((ADD K) x y) A))))))
                              (MUL . (FORALL x (IMPLIES (IN x A) (FORALL y (IMPLIES (IN y A) (IN ((MUL K) x y) A))))))
                              (NEG . (FORALL x (IMPLIES (IN x A) (IN ((NEG K) x) A)))))))))
    (qp-or-asm `(IN ,t A) (lambda () (dk-chain-ass! (if v (dk-apply! law u v) (dk-apply! law u)))))
    (rs-in! t)
    t))

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (IN (NV-MAXIMAL K A) (POWER A)))))))
(dk-peel!)
(rs-setup!)
(dk-have! `(IN ,rs-m SET) (lambda () (subst `(== ,rs-m (SEP cwx_ A (< ((FNRM K) cwx_) 1)))) (dk-each-leaf! (lambda () (sep-set)) (lambda () (dk-close-if-asm!)))))
(dk-have! `(FORALL z (IMPLIES (IN z ,rs-m) (IN z A))) (lambda () (dk-peel!) (dk-cite! 'nv-maximal-sub 'K 'A 'z) (dk-close-if-asm!)))
(dk-have-and! `(IN ,rs-m SET) `(FORALL z (IMPLIES (IN z ,rs-m) (IN z A))))
(dk-iff-bwd! (dk-cite! 'power-set-membership 'A rs-m))
(dk-close-if-asm!)
(qed 'rs-maximal-power)

;; the restricted operations: values and typings
(define (rs-val! name lam args val)
  (dk-sp-qed! (make-wff `(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A)
     ,(let wrap ((as args))
        (if (null? as) `(= (,lam ,@args) ,val)
            `(FORALL ,(car as) (IMPLIES (IN ,(car as) A) ,(wrap (cdr as))))))))))
  (lambda ()
  (dk-peel!)
  (rs-setup!)
  (for-each rs-in! args)
  (dk-lam-b!)
  (qp-rfl!)
  )
  name))
(rs-val! 'rs-add-val rs-ladd '(u v) '((ADD K) u v))
(rs-val! 'rs-mul-val rs-lmul '(u v) '((MUL K) u v))
(rs-val! 'rs-neg-val rs-lneg '(u) '((NEG K) u))

(define (rs-fun! name lam arity op)
  (dk-sp-qed! (make-wff `(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (IN ,lam (FUN ,(if (= arity 2) '(CARTESIAN A A) 'A) A))))))
  (lambda ()
  (dk-peel!)
  (rs-setup!)
  (dk-each-leaf! (lambda () (lam-t))
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORALL)
          (let* ((landed (dk-landed (lambda () (dk-peel!))))
                 (vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed))))
            (if (= arity 2)
                (rs-close! op (car vs) (cadr vs))
                (rs-close! 'NEG (car vs) #f))
            (dk-close-if-asm!))
          (if (equal? (dk-goal) '(IN A SET))
              (dk-close-if-asm!)
              (begin (dk-have-and! '(IN A SET) '(IN A SET)) (mac 'cartesian-set-iff) (dk-close-if-asm!))))))
  )
  name))
(rs-fun! 'rs-add-fun rs-ladd 2 'ADD)
(rs-fun! 'rs-mul-fun rs-lmul 2 'MUL)
(rs-fun! 'rs-neg-fun rs-lneg 1 'NEG)

;; the slots of the residue ringoid
(define (rs-read-off! name acc val)
  (dk-sp-qed! (make-wff `(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (== (,acc ,rs-r) ,val)))))
  (lambda ()
  (dk-peel!)
  (rs-setup!)
  (for-each (lambda (n) (dk-cite! n 'K 'A)) '(rs-add-fun rs-mul-fun rs-neg-fun rs-maximal-power))
  (slot acc)
  (mac 'NV-RES-RINGOID)
  (nth-r)
  (qp-read-back! acc)
  (qrfl)
  )
  name))
(rs-read-off! 'rs-carr 'CARR 'A)
(rs-read-off! 'rs-add 'ADD rs-ladd)
(rs-read-off! 'rs-mul 'MUL rs-lmul)
(rs-read-off! 'rs-neg 'NEG rs-lneg)
(rs-read-off! 'rs-zero 'ZERO '(ZERO K))
(rs-read-off! 'rs-one 'ONE '(ONE K))
(rs-read-off! 'rs-idl 'IDL rs-m)

;; rewrite (T) in the goal bottom-up through the restricted operations; return the K-term (typed in A)
(define (rs-eval! t)
  (cond ((and (pair? t) (member (car t) (list rs-ladd rs-lmul)))
         (let* ((a (rs-eval! (cadr t))) (b (rs-eval! (caddr t)))
                (op (if (equal? (car t) rs-ladd) 'ADD 'MUL))
                (e (dk-cite! (if (eq? op 'ADD) 'rs-add-val 'rs-mul-val) 'K 'A a b)))
           (if (dk-contains? (dk-goal) (list (car t) a b)) (subst e))
           (rs-close! op a b)))
        ((and (pair? t) (equal? (car t) rs-lneg))
         (let* ((a (rs-eval! (cadr t))) (e (dk-cite! 'rs-neg-val 'K 'A a)))
           (if (dk-contains? (dk-goal) (list (car t) a)) (subst e))
           (rs-close! 'NEG a #f)))
        (#t (rs-in! t) t)))
(define (rs-atoms t)
  (cond ((symbol? t) (list t)) ((pair? t) (delete-duplicates (append-map rs-atoms (cdr t)))) (#t '())))
;; an identity goal L = R between restricted-operation terms over atoms in A
(define (rs-identity!)
  (let* ((g (dk-goal)) (atoms (filter (lambda (v) (dk-asm? `(IN ,v A))) (rs-atoms g))))
    (rs-eval! (cadr g)) (rs-eval! (caddr g))
    (ql-crs! atoms)))
(define (rs-law-leaf!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'AND) (for-each (lambda (l) (dk-focus! l) (rs-law-leaf!)) (dk-opened (lambda () (di)))))
          ((memq (dk-head g) '(FORALL IMPLIES)) (dk-peel!) (rs-law-leaf!))
          ((dk-head-is? g '=) (rs-identity!))
          (#t (error "rs-law-leaf!: unexpected" g)))))
(define (rs-ideal-leaf!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'AND) (for-each (lambda (l) (dk-focus! l) (rs-ideal-leaf!)) (dk-opened (lambda () (di)))))
          ((dk-head-is? g 'SUBSET)
           (mac 'subset-def) (dk-peel!) (dk-cite! 'nv-maximal-sub 'K 'A (cadr (dk-goal))) (dk-close-if-asm!))
          ((memq (dk-head g) '(FORALL IMPLIES)) (dk-peel!) (rs-ideal-leaf!))
          ((equal? g `(IN (ZERO K) ,rs-m)) (dk-cite! 'nv-maximal-zero 'K 'A) (dk-close-if-asm!))
          ((dk-head-is? g 'IN)
           (let* ((t (cadr g)) (args (cdr t)))
             (for-each (lambda (a) (if (dk-asm? `(IN ,a ,rs-m)) (dk-cite! 'nv-maximal-sub 'K 'A a))) args)
             (rs-eval! t)
             (let ((g2 (cadr (dk-goal))))
               (cond ((equal? (car g2) '(ADD K)) (dk-cite! 'nv-maximal-add 'K 'A (cadr g2) (caddr g2)))
                     ((equal? (car g2) '(NEG K)) (dk-cite! 'nv-maximal-neg 'K 'A (cadr g2)))
                     ((dk-asm? `(IN ,(caddr g2) ,rs-m)) (dk-cite! 'nv-maximal-mul 'K 'A (cadr g2) (caddr g2)))
                     (#t (subst (ql-ring-eq! `(= ,g2 ((MUL K) ,(caddr g2) ,(cadr g2))) (list (cadr g2) (caddr g2))))
                         (dk-cite! 'nv-maximal-mul 'K 'A (caddr g2) (cadr g2))))
               (dk-close-if-asm!))))
          (#t (error "rs-ideal-leaf!: unexpected" g)))))

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (IS-RINGOID (NV-RES-RINGOID K A)))))))
(dk-peel!)
(rs-setup!)
(for-each (lambda (n) (dk-cite! n 'K 'A)) '(rs-add-fun rs-mul-fun rs-neg-fun rs-maximal-power))
(mac 'IS-RINGOID)
(dk-isx-set!)   ; W1J-C: the conjunct t in SET, from the typings
(for-each (lambda (n) (dk-cite! n 'K 'A)) '(rs-carr rs-add rs-mul rs-neg rs-zero rs-one rs-idl))
(for-each (lambda (r) (subst `(== (,(car r) ,rs-r) ,(cadr r))))
          (list (list 'CARR 'A) (list 'ADD rs-ladd) (list 'MUL rs-lmul) (list 'NEG rs-lneg) (list 'ZERO '(ZERO K)) (list 'ONE '(ONE K)) (list 'IDL rs-m)))
(let split ((fuel 40))
  (let ((andl (find-first (lambda (s) (dk-head-is? (dk-goal-of s) 'AND)) (dk-open-leaves))))
    (when andl
      (if (= fuel 0) (error "rs: AND split did not terminate"))
      (dk-focus! andl) (di) (split (- fuel 1)))))
(for-each
  (lambda (l)
    (if (not (sequent-node-grounded? l))
        (begin
          (dk-focus! l)
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (dk-ass!))
                  ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH)) (mac 'NV-RES-RINGOID) (len-r) (arith))
                  ((memq (dk-head g) '(is-associative is-commutative is-identity has-inverses is-distributive))
                   (mac (dk-head g)) (rs-law-leaf!))
                  ((dk-head-is? g 'is-ideal-in) (mac 'is-ideal-in) (rs-ideal-leaf!))
                  (#t (error "rs ringoid: unexpected conjunct" g)))))))
  (dk-open-leaves))
(qed 'rs-is-ringoid)

(define rs-rs `(RINGOID-SETOID ,rs-r))
(define rs-q `(RINGOID-QUOTIENT-RING ,rs-r))
;; the ringoid facts in context
(define (rs-ring-setup!)
  (rs-setup!)
  (for-each (lambda (n) (dk-cite! n 'K 'A)) '(rs-add-fun rs-mul-fun rs-neg-fun rs-maximal-power rs-is-ringoid
                                              rs-carr rs-add rs-mul rs-neg rs-zero rs-one rs-idl))
  (dk-cite! 'ringoid-setoid-is-setoid rs-r)
  (dk-cite! 'ringoid-setoid-pts rs-r)
  (qp-or-asm `(== (PTS ,rs-rs) A)
    (lambda () (dk-have! `(== (PTS ,rs-rs) A) (lambda () (subst `(== (PTS ,rs-rs) (CARR ,rs-r))) (subst `(== (CARR ,rs-r) A)) (qrfl))))))
;; U in A: land U in CARR r and in PTS RS
(define (rs-pt! u)
  (qp-or-asm `(IN ,u (CARR ,rs-r)) (lambda () (dk-have! `(IN ,u (CARR ,rs-r)) (lambda () (subst `(== (CARR ,rs-r) A)) (dk-close-if-asm!)))))
  (qp-or-asm `(IN ,u (PTS ,rs-rs)) (lambda () (dk-have! `(IN ,u (PTS ,rs-rs)) (lambda () (subst `(== (PTS ,rs-rs) A)) (dk-close-if-asm!)))))
  u)

;; classes agree iff the difference is in M(A)
(sp (make-wff `(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (FORALL xa (IMPLIES (IN xa A) (FORALL xb (IMPLIES (IN xb A)
  (IFF (= (CLASS ,rs-rs xa) (CLASS ,rs-rs xb)) (IN ((ADD K) xa ((NEG K) xb)) ,rs-m)))))))))))
(dk-peel!)
(rs-ring-setup!)
(rs-pt! 'xa) (rs-pt! 'xb) (rs-in! 'xa) (rs-in! 'xb)
(let* ((nb (rs-close! 'NEG 'xb #f)) (d (rs-close! 'ADD 'xa nb))
       (rin `(IN ((ADD ,rs-r) xa ((NEG ,rs-r) xb)) (IDL ,rs-r)))
       (e1 (dk-cite! 'rs-neg-val 'K 'A 'xb))
       (e2 (dk-cite! 'rs-add-val 'K 'A 'xa nb))
       (to-k (lambda (h)
               (let* ((h1 (dk-rewrite-h! h `(ADD ,rs-r) rs-ladd))
                      (h2 (dk-rewrite-h! h1 `(NEG ,rs-r) rs-lneg))
                      (h3 (dk-rewrite-h! h2 `(IDL ,rs-r) rs-m))
                      (h4 (dk-rewrite-h! h3 `(,rs-lneg xb) nb)))
                 (dk-rewrite-h! h4 `(,rs-ladd xa ,nb) d)))))
  (dk-iff! (lambda (g) (dk-head-is? g 'IN))
    (lambda ()
      (dk-iff-fwd! (dk-cite! 'class-eq-iff rs-rs 'xa 'xb))
      (to-k (dk-chain-ass! (dk-cite! 'r6b-related-out rs-r 'xa 'xb)))
      (dk-close-if-asm!))
    (lambda ()
      (dk-have! rin
        (lambda ()
          (subst `(== (ADD ,rs-r) ,rs-ladd)) (subst `(== (NEG ,rs-r) ,rs-lneg)) (subst `(== (IDL ,rs-r) ,rs-m))
          (subst `(= (,rs-lneg xb) ,nb)) (subst `(= (,rs-ladd xa ,nb) ,d))
          (dk-close-if-asm!)))
      (dk-chain-ass! (dk-cite! 'r6b-related-in rs-r 'xa 'xb))
      (dk-iff-bwd! (dk-cite! 'class-eq-iff rs-rs 'xa 'xb))
      (dk-close-if-asm!))))
(qed 'rs-class-eq-iff)

;; the congruence mod M(A) is the relation d(x, y) < 1 on A
(define rs-ss `(SUBSPACE-MS ,qlm A))
(sp (make-wff `(FORALL K (FORALL A (IMPLIES (IS-NV-DOMAIN K A) (== ,rs-rs (EPS-SETOID ,rs-ss 1)))))))
(dk-peel!)
(rs-ring-setup!)
(ql-ms-setup!)
(fact 'rr-one-in)
(dk-cite! 'nv-domain-subset-pts 'K 'A)
(dk-cite! 'subspace-pts qlm 'A)
(let ((ms `(SEP cwx_ A (< ((FNRM K) cwx_) 1))))
  (dk-have! `(= (RINGOID-REL ,rs-r) (EPS-REL ,rs-ss 1))
    (lambda ()
      (mac 'RINGOID-REL) (mac 'EPS-REL)
      (for-each (lambda (r) (if (dk-contains? (dk-goal) (car r)) (subst `(== ,(car r) ,(cadr r)))))
                (list (list `(CARR ,rs-r) 'A) (list `(ADD ,rs-r) rs-ladd) (list `(NEG ,rs-r) rs-lneg) (list `(IDL ,rs-r) rs-m)
                      (list `(PTS ,rs-ss) 'A)))
      (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)) (ch (dk-cite! 'class-extensionality l r)))
        (dk-have! (cadr ch)
          (lambda ()
            (dk-peel!)
            (let* ((z (cadr (cadr (dk-goal))))
                   (n1 `(NTH 1 ,z)) (n2 `(NTH 2 ,z))
                   (prep! (lambda (m)
                            (dk-sep-parts! m)
                            (dk-split-all! (list (dk-cite! 'cartesian-nth z 'A 'A)))
                            (rs-in! n1) (rs-in! n2)
                            (let* ((nb (rs-close! 'NEG n2 #f)) (d (rs-close! 'ADD n1 nb)))
                              (dk-cite! 'rs-neg-val 'K 'A n2) (dk-cite! 'rs-add-val 'K 'A n1 nb)
                              (ql-typek! d)
                              (ql-carr! n1) (ql-carr! n2)
                              (dk-cite! 'subspace-dist qlm 'A n1 n2)
                              (ql-dist! n1 n2)
                              (list nb d)))))
              (dk-iff! (lambda (gg) (equal? (caddr gg) r))
                (lambda ()
                  (let* ((nd (prep! `(IN ,z ,l))) (nb (car nd)) (d (cadr nd))
                         (c0 `(IN (,rs-ladd ,n1 (,rs-lneg ,n2)) ,rs-m))
                         (c1 (dk-rewrite-h! c0 `(,rs-lneg ,n2) nb))
                         (c2 (dk-rewrite-h! c1 `(,rs-ladd ,n1 ,nb) d)))
                    (dk-cite! 'nv-maximal-norm 'K 'A d)
                    (in-sep! (lambda () (dk-close-if-asm!))
                             (lambda ()
                               (subst `(== ((DIST ,rs-ss) ,n1 ,n2) ((DIST ,qlm) ,n1 ,n2)))
                               (subst `(= ((DIST ,qlm) ,n1 ,n2) ,(ql-n d)))
                               (dk-close-if-asm!)))))
                (lambda ()
                  (let* ((nd (prep! `(IN ,z ,r))) (nb (car nd)) (d (cadr nd))
                         (h0 `(< ((DIST ,rs-ss) ,n1 ,n2) 1))
                         (h1 (dk-rewrite-h! h0 `((DIST ,rs-ss) ,n1 ,n2) `((DIST ,qlm) ,n1 ,n2)))
                         (h2 (dk-rewrite-h! h1 `((DIST ,qlm) ,n1 ,n2) (ql-n d))))
                    (in-sep! (lambda () (dk-close-if-asm!))
                             (lambda ()
                               (subst `(= (,rs-lneg ,n2) ,nb)) (subst `(= (,rs-ladd ,n1 ,nb) ,d))
                               (subst `(== ,rs-m ,ms))
                               (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!)))))))))))
        (detach! ch)
        (dk-close-if-asm!))))
  (mac 'RINGOID-SETOID) (mac 'EPS-SETOID)
  (subst `(== (CARR ,rs-r) A)) (subst `(== (PTS ,rs-ss) A))
  (subst `(= (RINGOID-REL ,rs-r) (EPS-REL ,rs-ss 1)))
  (qrfl))
(qed 'rs-setoid-eq)

;; a point C of the residue ring: land its representative X in A (also in CARR r, PTS RS), rewrite C in the goal
(define (rs-rep! c)
  (if (not (dk-asm? `(IN ,c (QUOTIENT ,rs-rs))))
      (dk-rewrite-h! `(IN ,c (CARR ,rs-q)) `(CARR ,rs-q) `(QUOTIENT ,rs-rs)))
  (let ((x (dk-skolem! (dk-cite! 'quotient-rep rs-rs c))))
    (dk-have! `(IN ,x A) (lambda () (subst `(== A (PTS ,rs-rs))) (dk-close-if-asm!)))
    (rs-pt! x) (rs-in! x)
    (subst `(= ,c (CLASS ,rs-rs ,x)))
    x))

;; Proposition 2.7: if A is a compact NV domain, A / M(A) is a finite field
(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-COMPACT-NV-DOMAIN K A)
  (AND (IS-FIELD-RING (NV-RESIDUE K A)) (IN (CARD (CARR (NV-RESIDUE K A))) NN)))))))
(dk-peel!)
(dk-cite! 'nv-compact-domain 'K 'A)
(dk-project! `(IS-COMPACT ,rs-ss) 'is-compact-nv-domain '(IS-COMPACT-NV-DOMAIN K A))
(rs-ring-setup!)
(ql-ms-setup!)
(fact 'rr-one-in) (fact 'rr-zero-in)
(dk-cite! 'rq-carr rs-r) (dk-cite! 'rq-one rs-r) (dk-cite! 'rq-zero rs-r)
(dk-cite! 'ringoid-quotient-is-ring rs-r)
(dk-have! '(IS-RING (NV-RESIDUE K A)) (lambda () (mac 'NV-RESIDUE) (dk-close-if-asm!)))
(mac 'NV-RESIDUE)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (dk-ass!))
        ((dk-head-is? g 'IN)
         ;; finitely many classes: the classes are those of d(x, y) < 1, finite by compactness (Prop 1.7)
         (subst `(== (CARR ,rs-q) (QUOTIENT ,rs-rs)))
         (subst (dk-cite! 'rs-setoid-eq 'K 'A))
         (dk-cite! 'nv-domain-subset-pts 'K 'A)
         (dk-cite! 'nv-field-ultrametric 'K)
         (dk-chain-ass! (dk-cite! 'subspace-ultrametric qlm 'A))
         (dk-cite! 'compact-implies-totally-bounded rs-ss)
         (dk-iff-fwd! (dk-cite! 'ultra-totally-bounded-iff rs-ss))
         (dk-have! '(< 0 1) (lambda () (arith)))
         (dk-chain-ass! (dk-apply! (qp-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'EPS-SETOID))) "the class count") 1))
         (dk-close-if-asm!))
        (#t
         (mac 'IS-FIELD-RING)
         (dk-conj-close!
           (lambda ()
             (let ((g2 (dk-goal)))
               (cond
                 ((dk-asm? g2) (dk-ass!))
                 ((dk-head-is? g2 'IS-COMMUTATIVE-RING)
                  (mac 'IS-COMMUTATIVE-RING)
                  (dk-conj-close!
                    (lambda ()
                      (if (not (dk-ass!))
                          (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                 (vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed)))
                                 (x (rs-rep! (car vs))) (y (rs-rep! (cadr vs))))
                            (subst (dk-cite! 'rq-mul-computes rs-r x y))
                            (subst (dk-cite! 'rq-mul-computes rs-r y x))
                            (subst `(== (MUL ,rs-r) ,rs-lmul))
                            (subst (dk-cite! 'rs-mul-val 'K 'A x y))
                            (subst (dk-cite! 'rs-mul-val 'K 'A y x))
                            (rs-close! 'MUL x y) (rs-close! 'MUL y x)
                            (rs-pt! `((MUL K) ,y ,x))
                            (subst (ql-ring-eq! `(= ((MUL K) ,x ,y) ((MUL K) ,y ,x)) (list x y)))
                            (qp-rfl!))))))
                 ((dk-head-is? g2 'NOT)
                  (subst `(== (ONE ,rs-q) (CLASS ,rs-rs (ONE ,rs-r))))
                  (subst `(== (ZERO ,rs-q) (CLASS ,rs-rs (ZERO ,rs-r))))
                  (subst `(== (ONE ,rs-r) (ONE K))) (subst `(== (ZERO ,rs-r) (ZERO K)))
                  (di)
                  (dk-cite! 'nf-one-in-carr 'K) (dk-cite! 'nf-norm-one 'K)
                  (dk-iff-fwd! (dk-cite! 'rs-class-eq-iff 'K 'A '(ONE K) '(ZERO K)))
                  (let* ((d `((ADD K) (ONE K) ((NEG K) (ZERO K)))))
                    (ql-ring-eq! `(= ,d (ONE K)) '())
                    (let* ((h0 (dk-cite! 'nv-maximal-norm 'K 'A d))
                           (h1 (dk-rewrite-h! h0 d '(ONE K))))
                      (ql-typek! '(ONE K))
                      (dk-absurd! h1 '(= ((FNRM K) (ONE K)) 1)))))
                 (#t
                  (let* ((landed (dk-landed (lambda () (dk-peel!))))
                         (c (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed)))
                         (nz0 (find-first (lambda (f) (dk-head-is? f 'NOT)) landed))
                         (x (rs-rep! c))
                         (nz1 (dk-rewrite-h! nz0 c `(CLASS ,rs-rs ,x)))
                         (nz2 (dk-rewrite-h! nz1 `(ZERO ,rs-q) `(CLASS ,rs-rs (ZERO ,rs-r))))
                         (nz3 (dk-rewrite-h! nz2 `(ZERO ,rs-r) '(ZERO K)))
                         (ms `(SEP cwx_ A (< ((FNRM K) cwx_) 1)))
                         (ax (ql-n x)))
                    (ql-typek! x)
                    (dk-have! `(NOT (IN ,x ,rs-m))
                      (lambda ()
                        (di)
                        (let ((d `((ADD K) ,x ((NEG K) (ZERO K)))))
                          (rs-close! 'NEG '(ZERO K) #f) (rs-close! 'ADD x '((NEG K) (ZERO K)))
                          (dk-have! `(IN ,d ,rs-m) (lambda () (subst (ql-ring-eq! `(= ,d ,x) (list x))) (dk-close-if-asm!)))
                          (dk-iff-bwd! (dk-cite! 'rs-class-eq-iff 'K 'A x '(ZERO K)))
                          (ai nz3))))
                    (dk-chain-ass! (dk-cite! 'nv-domain-norm 'K 'A x))
                    (dk-have! `(NOT (< ,ax 1))
                      (lambda ()
                        (di)
                        (dk-have! `(IN ,x ,rs-m) (lambda () (subst `(== ,rs-m ,ms)) (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!)))))
                        (ai `(NOT (IN ,x ,rs-m)))))
                    (dk-have! `(= ,ax 1)
                      (lambda ()
                        (pbc)
                        (dk-have-and! `(<= ,ax 1) `(NOT (= ,ax 1)))
                        (dk-chain-ass! (dk-cite! 'rr-le-ne-lt ax 1))
                        (ai `(NOT (< ,ax 1)))))
                    (dk-chain-ass! (dk-cite! 'nv-compact-norm-one-unit 'K 'A x))
                    (dk-cite! 'nv-units-unfold 'K 'A)
                    (dk-sep-parts! (dk-rewrite-h! `(IN ,x (NV-UNITS K A)) '(NV-UNITS K A)
                                     `(SEP cwx_ A (FORSOME cwy_ (AND (IN cwy_ A) (= ((MUL K) cwx_ cwy_) (ONE K)))))))
                    (let ((y (dk-skolem! (qp-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f x) (dk-contains? f 'ONE))) "the inverse"))))
                      (rs-pt! y) (rs-in! y)
                      (ew `(CLASS ,rs-rs ,y))
                      (dk-conj-close!
                        (lambda ()
                          (if (dk-head-is? (dk-goal) 'IN)
                              (begin (subst `(== (CARR ,rs-q) (QUOTIENT ,rs-rs)))
                                     (dk-cite! 'class-in-quotient rs-rs y) (dk-close-if-asm!))
                              (begin
                                (subst (dk-cite! 'rq-mul-computes rs-r x y))
                                (subst `(== (MUL ,rs-r) ,rs-lmul))
                                (subst (dk-cite! 'rs-mul-val 'K 'A x y))
                                (subst `(= ((MUL K) ,x ,y) (ONE K)))
                                (subst `(== (ONE ,rs-q) (CLASS ,rs-rs (ONE ,rs-r))))
                                (subst `(== (ONE ,rs-r) (ONE K)))
                                (rs-pt! '(ONE K))
                                (qp-rfl!)))))))))))))))))
(qed 'ccr-2-7)

;;; -----------------------------------------------------------------------
;;; 19. Proposition 4.10: x = u p^k with u a unit of Z_p and k in ZZ, both unique.

;; ql-crs! for an arbitrary normed field term FLD
(define (qk-crs! fld vs)
  (let ((view `(NORMED-FIELD-AS-COMMUTATIVE-RING ,fld)))
    (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring fld)
    (for-each (lambda (r) (dk-cite! r fld))
              '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
                normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one))
    (for-each (lambda (u)
                (dk-have! `(IN ,u (CARR ,view)) (lambda () (subst `(= (CARR ,view) (CARR ,fld))) (dk-close-if-asm!))))
              vs)
    (for-each (lambda (op)
                (if (dk-contains? (dk-goal) `(,op ,fld)) (subst `(= (,op ,fld) (,op ,view)))))
              '(ADD MUL NEG ZERO ONE))
    (crs)))

;; the units of Z(K) are the elements of absolute value 1
(define ql-nvi '(SEP cwx_ (CARR K) (<= ((FNRM K) cwx_) 1)))
(define ql-nvu '(SEP cwx_ (NV-INTEGERS K) (FORSOME cwy_ (AND (IN cwy_ (NV-INTEGERS K)) (= ((MUL K) cwx_ cwy_) (ONE K))))))
(sp (make-wff '(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL u (IMPLIES (IN u (CARR K))
  (IFF (IN u (NV-UNITS K (NV-INTEGERS K))) (= ((FNRM K) u) 1))))))))
(dk-peel!)
(ql-ms-setup!)
(fact 'rr-one-in) (fact 'rr-zero-in)
(dk-cite! 'nf-one-in-carr 'K) (dk-cite! 'nf-norm-one 'K)
(dk-cite! 'nv-integers-unfold 'K)
(dk-cite! 'nv-units-unfold 'K '(NV-INTEGERS K))
(ql-typek! 'u)
(dk-iff! (lambda (g) (dk-head-is? g '=))
  (lambda ()
    (dk-sep-parts! (dk-rewrite-h! '(IN u (NV-UNITS K (NV-INTEGERS K))) '(NV-UNITS K (NV-INTEGERS K)) ql-nvu))
    (let ((y (dk-skolem! (qp-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'u) (dk-contains? f 'ONE))) "the inverse"))))
      (dk-sep-parts! (dk-rewrite-h! '(IN u (NV-INTEGERS K)) '(NV-INTEGERS K) ql-nvi))
      (dk-sep-parts! (dk-rewrite-h! `(IN ,y (NV-INTEGERS K)) '(NV-INTEGERS K) ql-nvi))
      (ql-typek! y)
      (let* ((m0 (dk-cite! 'nf-norm-mult 'K 'u y))
             (m1 (dk-rewrite-h! m0 `((MUL K) u ,y) '(ONE K)))
             (m2 (dk-rewrite-h! m1 '((FNRM K) (ONE K)) 1)))
        (dk-rr-mul! (ql-n 'u) (ql-n y))
        (dk-have! `(= (* ,(ql-n 'u) ,(ql-n y)) 1) (lambda () (subst `(= 1 (* ,(ql-n 'u) ,(ql-n y)))) (qp-rfl!)))
        (dk-chain-ass! (dk-cite! 'rr-unit-interval-prod-one (ql-n 'u) (ql-n y)))
        (dk-close-if-asm!))))
  (lambda ()
    (dk-have! '(NOT (= u (ZERO K)))
      (lambda () (di) (dk-iff-bwd! (dk-cite! 'nf-norm-zero-iff 'K 'u)) (dk-absurd! '(= ((FNRM K) u) 0) '(= ((FNRM K) u) 1))))
    (let ((y (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-inverse 'K 'u)))))
      (ql-typek! y)
      (let* ((m0 (dk-cite! 'nf-norm-mult 'K 'u y))
             (m1 (dk-rewrite-h! m0 `((MUL K) u ,y) '(ONE K)))
             (m2 (dk-rewrite-h! m1 '((FNRM K) (ONE K)) 1))
             (m3 (dk-rewrite-h! m2 '((FNRM K) u) 1)))
        (dk-have! `(= ,(ql-n y) 1) (lambda () (dk-have! `(= (* 1 ,(ql-n y)) ,(ql-n y)) (lambda () (crs))) (dk-ineq! m3 `(= (* 1 ,(ql-n y)) ,(ql-n y)))))
        (let ((inz! (lambda (v) (dk-have! `(IN ,v (NV-INTEGERS K))
                                  (lambda () (subst `(== (NV-INTEGERS K) ,ql-nvi)) (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-ineq! `(= ,(ql-n v) 1)))))))))
          (inz! 'u) (inz! y)
          (subst `(== (NV-UNITS K (NV-INTEGERS K)) ,ql-nvu))
          (in-sep! (lambda () (dk-close-if-asm!))
                   (lambda () (ew y) (dk-conj-close! (lambda () (dk-close-if-asm!))))))))))
(qed 'nv-unit-iff-norm-one)

;; x w = u, y u = w, u, w /= 0 give x y = 1
(sp (make-wff '(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL x (IMPLIES (IN x (CARR K)) (FORALL y (IMPLIES (IN y (CARR K))
  (FORALL u (IMPLIES (IN u (CARR K)) (FORALL w (IMPLIES (IN w (CARR K))
    (IMPLIES (NOT (= u (ZERO K))) (IMPLIES (NOT (= w (ZERO K)))
      (IMPLIES (= ((MUL K) x w) u) (IMPLIES (= ((MUL K) y u) w) (= ((MUL K) x y) (ONE K))))))))))))))))))
(dk-peel!)
(dk-cite! 'nf-one-in-carr 'K)
(fact 'rr-zero-in)
(let* ((uw '((MUL K) u w)) (xy '((MUL K) x y)))
  (dk-cite! 'nf-mul-in-carr 'K 'u 'w) (dk-cite! 'nf-mul-in-carr 'K 'x 'y)
  (for-each ql-typek! (list 'u 'w uw))
  (for-each (lambda (v)
              (let ((nu (ql-n v)))
                (dk-have! `(NOT (= 0 ,nu))
                  (lambda () (di)
                    (dk-have! `(= ,nu 0) (lambda () (subst `(= ,nu 0)) (rfl)))
                    (dk-iff-fwd! (dk-cite! 'nf-norm-zero-iff 'K v)) (ai `(NOT (= ,v (ZERO K))))))
                (dk-have-and! `(<= 0 ,nu) `(NOT (= 0 ,nu)))
                (dk-chain-ass! (dk-cite! 'rr-le-ne-lt 0 nu))))
            '(u w))
  (dk-cite! 'rr-mul-pos (ql-n 'u) (ql-n 'w))
  (dk-cite! 'nf-norm-mult 'K 'u 'w)
  (dk-have! `(NOT (= ,uw (ZERO K)))
    (lambda () (di)
      (let* ((z0 (dk-cite! 'nf-norm-of-zero 'K)) (z1 (dk-rewrite-h! z0 '(ZERO K) uw)))
        (dk-rr-mul! (ql-n 'u) (ql-n 'w))
        (dk-absurd! z1 `(= ,(ql-n uw) (* ,(ql-n 'u) ,(ql-n 'w))) `(< 0 (* ,(ql-n 'u) ,(ql-n 'w)))))))
  (dk-have! `(= ((MUL K) ,xy ,uw) ((MUL K) (ONE K) ,uw))
    (lambda ()
      (subst (ql-ring-eq! `(= ((MUL K) ,xy ,uw) ((MUL K) ((MUL K) x w) ((MUL K) y u))) (list 'x 'y 'u 'w)))
      (subst '(= ((MUL K) x w) u)) (subst '(= ((MUL K) y u) w))
      (ql-crs! (list 'u 'w))))
  (dk-chain-ass! (dk-cite! 'nf-mul-cancel 'K xy '(ONE K) uw))
  (dk-close-if-asm!))
(qed 'nf-pair-inverse)

;; p^k p^(-k) = 1
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL k (IMPLIES (IN k ZZ)
  (= ((MUL ,qf) ,(qo-pp 'k) ,(qo-pp '(- k))) (ONE ,qf))))))))
(dk-peel!)
(qo-field-setup!)
(dk-cite! 'zz-neg-closed 'k)
(dk-split-all! (list (dk-cite! 'qo-int-halves 'k)))
(dk-split-all! (list (dk-cite! 'qo-ppow-def 'p 'k)))
(dk-split-all! (list (dk-cite! 'qo-ppow-def 'p '(- k))))
(let* ((a (qo-amax 'k)) (b (qo-bmax 'k)) (ea (qo-pk a)) (eb (qo-pk b)))
  (dk-split-all! (list (dk-cite! 'qo-ppos-abs 'p a)))
  (dk-split-all! (list (dk-cite! 'qo-ppos-abs 'p b)))
  (dk-have! '(= (- (- k)) k) (lambda () (crs)))
  (dk-have! `(= (MAX (- (- k)) 0) ,a) (lambda () (subst '(= (- (- k)) k)) (qp-rfl!)))
  (dk-rewrite-h! `(= ((MUL ,qf) ,(qo-pp '(- k)) ,(qo-pk '(MAX (- (- k)) 0))) ,eb) '(MAX (- (- k)) 0) a)
  (dk-chain-ass! (dk-cite! 'nf-pair-inverse qf (qo-pp 'k) (qo-pp '(- k)) ea eb))
  (dk-close-if-asm!))
(qed 'qo-ppow-inverse)

;; Proposition 4.10: every x /= 0 in Q_p is u p^k for a unique k in ZZ and a unique unit u of Z_p
(define qo-units `(NV-UNITS ,qf (ZP p)))
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (CARR ,qf)) (IMPLIES (NOT (= x (ZERO ,qf)))
  (AND (FORSOME k (AND (IN k ZZ) (FORSOME u (AND (IN u ,qo-units) (= x ((MUL ,qf) u ,(qo-pp 'k)))))))
       (FORALL k (IMPLIES (IN k ZZ) (FORALL l (IMPLIES (IN l ZZ) (FORALL u (IMPLIES (IN u ,qo-units) (FORALL v (IMPLIES (IN v ,qo-units)
         (IMPLIES (= ((MUL ,qf) u ,(qo-pp 'k)) ((MUL ,qf) v ,(qo-pp 'l))) (AND (= k l) (= u v)))))))))))))))))))
(dk-peel!)
(qo-field-setup!)
(dk-cite! 'qp-is-nv-field 'p)
(dk-have! `(== (ZP p) (NV-INTEGERS ,qf)) (lambda () (mac 'ZP) (qrfl)))
(subst `(== (ZP p) (NV-INTEGERS ,qf)))
(let ((unit-iff (lambda (v) (dk-cite! 'nv-unit-iff-norm-one qf v))))
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'FORSOME)
          ;; existence: k = -m where |x| = 2^m, u = p^m x
          (let* ((m (dk-skolem! (dk-chain-ass! (dk-cite! 'qo-abs-power 'p 'x))))
                 (ax (qo-abs! 'x)) (pm (qo-pp m)) (u `((MUL ,qf) ,pm x)) (k `(- ,m)))
            (qo-zr! m) (dk-cite! 'zz-neg-closed m) (dk-cite! 'rr-neg-closed m)
            (dk-split-all! (list (dk-cite! 'qo-ppow-abs 'p m)))
            (dk-split-all! (list (dk-cite! 'qo-ppow-abs 'p k)))
            (dk-cite! 'qo-ppow-inverse 'p m)
            (dk-cite! 'nf-mul-in-carr qf pm 'x)
            (let* ((app (qo-abs! pm)) (au (qo-abs! u))
                   (m0 (dk-cite! 'nf-norm-mult qf pm 'x))
                   (m1 (dk-rewrite-h! m0 `((FNRM ,qf) ,u) au))
                   (m2 (dk-rewrite-h! m1 `((FNRM ,qf) ,pm) app))
                   (m3 (dk-rewrite-h! m2 `((FNRM ,qf) x) ax))
                   (m4 (dk-rewrite-h! m3 app (qo-rp `(- ,m))))
                   (m5 (dk-rewrite-h! m4 ax (qo-rp m))))
              (qo-rp! `(- ,m)) (qo-rp! m)
              (dk-have! `(= (+ (- ,m) ,m) 0) (lambda () (crs)))
              (dk-cite! 'rpow-star-zero 2)
              (let* ((r0 (dk-cite! 'rpow-star-add 2 `(- ,m) m))
                     (r1 (dk-rewrite-h! r0 `(+ (- ,m) ,m) 0))
                     (r2 (dk-rewrite-h! r1 (qo-rp 0) 1)))
                (dk-have! `(= ((FNRM ,qf) ,u) 1)
                  (lambda () (subst `(= ((FNRM ,qf) ,u) ,au)) (subst `(= ,au (* ,(qo-rp `(- ,m)) ,(qo-rp m)))) (subst `(= (* ,(qo-rp `(- ,m)) ,(qo-rp m)) 1)) (qp-rfl!))))
              (dk-iff-bwd! (unit-iff u))
              (ew k)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal))
                      (dk-ass!)
                      (begin
                        (ew u)
                        (dk-conj-close!
                          (lambda ()
                            (if (dk-asm? (dk-goal))
                                (dk-ass!)
                                (begin
                                  (dk-have! `(= ((MUL ,qf) ,u ,(qo-pp k)) ((MUL ,qf) x ((MUL ,qf) ,pm ,(qo-pp k))))
                                    (lambda () (qk-crs! qf (list pm 'x (qo-pp k)))))
                                  (subst `(= ((MUL ,qf) ,u ,(qo-pp k)) ((MUL ,qf) x ((MUL ,qf) ,pm ,(qo-pp k)))))
                                  (subst `(= ((MUL ,qf) ,pm ,(qo-pp k)) (ONE ,qf)))
                                  (dk-cite! 'nf-one-in-carr qf)
                                  (qk-crs! qf (list 'x))))))))))))
          ;; uniqueness
          (let* ((landed (dk-landed (lambda () (dk-peel!))))
                 (ins (filter (lambda (f) (dk-head-is? f 'IN)) landed))
                 (zs (map cadr (filter (lambda (f) (eq? (caddr f) 'ZZ)) ins)))
                 (uq `(NV-UNITS ,qf (NV-INTEGERS ,qf)))
                 (us (map cadr (filter (lambda (f) (equal? (caddr f) uq)) ins)))
                 (k (car zs)) (l (cadr zs)) (u (car us)) (v (cadr us))
                 (e0 (find-first (lambda (f) (dk-head-is? f '=)) landed))
                 (nvi `(SEP cwx_ (CARR ,qf) (<= ((FNRM ,qf) cwx_) 1)))
                 (nvu `(SEP cwx_ (NV-INTEGERS ,qf) (FORSOME cwy_ (AND (IN cwy_ (NV-INTEGERS ,qf)) (= ((MUL ,qf) cwx_ cwy_) (ONE ,qf)))))))
            (dk-cite! 'nv-units-unfold qf `(NV-INTEGERS ,qf))
            (dk-cite! 'nv-integers-unfold qf)
            (for-each (lambda (w)
                        (dk-sep-parts! (dk-rewrite-h! `(IN ,w ,uq) uq nvu))
                        (dk-sep-parts! (dk-rewrite-h! `(IN ,w (NV-INTEGERS ,qf)) `(NV-INTEGERS ,qf) nvi))
                        (dk-iff-fwd! (unit-iff w)))
                      (list u v))
            (for-each (lambda (j) (qo-zr! j) (dk-cite! 'rr-neg-closed j) (qo-rp! `(- ,j)) (dk-split-all! (list (dk-cite! 'qo-ppow-abs 'p j)))) (list k l))
            (let* ((pk (qo-pp k)) (pl (qo-pp l)) (uk `((MUL ,qf) ,u ,pk)) (vl `((MUL ,qf) ,v ,pl))
                   (rk (qo-rp `(- ,k))) (rl (qo-rp `(- ,l))))
              (dk-cite! 'nf-mul-in-carr qf u pk) (dk-cite! 'nf-mul-in-carr qf v pl)
              (qo-abs! pk) (qo-abs! pl)
              (dk-cite! 'nf-norm-in-rr qf uk) (dk-cite! 'nf-norm-in-rr qf vl)
              (let* ((a0 (dk-cite! 'nf-norm-mult qf u pk)) (a1 (dk-rewrite-h! a0 `((FNRM ,qf) ,u) 1))
                     (a2 (dk-rewrite-h! a1 `((FNRM ,qf) ,pk) `((QP-ABS p) ,pk))) (a3 (dk-rewrite-h! a2 `((QP-ABS p) ,pk) rk))
                     (b0 (dk-cite! 'nf-norm-mult qf v pl)) (b1 (dk-rewrite-h! b0 `((FNRM ,qf) ,v) 1))
                     (b2 (dk-rewrite-h! b1 `((FNRM ,qf) ,pl) `((QP-ABS p) ,pl))) (b3 (dk-rewrite-h! b2 `((QP-ABS p) ,pl) rl))
                     (nk `((FNRM ,qf) ,uk)) (nl `((FNRM ,qf) ,vl)))
                (dk-have! `(= ,nk ,nl) (lambda () (subst e0) (qp-rfl!)))
                (dk-have! `(= ,k ,l)
                  (lambda ()
                    (pbc)
                    (dk-have! '(< 1 2) (lambda () (arith)))
                    (dk-have! `(NOT (= ,l ,k)) (lambda () (di) (dk-have! `(= ,k ,l) (lambda () (subst `(= ,l ,k)) (qp-rfl!))) (ai `(NOT (= ,k ,l)))))
                    (dk-have-and! `(IN ,k RR) `(IN ,l RR))
                    (dk-or-each! (dk-cite! 'rr-leq-total k l)
                      (lambda (c)
                        (let* ((lo (if (equal? c `(<= ,k ,l)) k l)) (hi (if (equal? c `(<= ,k ,l)) l k))
                               (nz (if (equal? c `(<= ,k ,l)) `(NOT (= ,k ,l)) `(NOT (= ,l ,k)))))
                          (dk-have-and! c nz)
                          (dk-chain-ass! (dk-cite! 'rr-le-ne-lt lo hi))
                          (dk-have! `(< (- ,hi) (- ,lo)) (lambda () (dk-ineq! `(< ,lo ,hi))))
                          (dk-chain-ass! (dk-cite! 'rpow-star-mono-exp 2 `(- ,hi) `(- ,lo)))
                          (dk-absurd! a3 b3 `(= ,nk ,nl) `(< ,(qo-rp `(- ,hi)) ,(qo-rp `(- ,lo)))))))))
                (dk-rewrite-h! e0 l k)
                (dk-chain-ass! (dk-cite! 'nf-mul-cancel qf u v pk))
                (dk-conj-close! (lambda () (dk-close-if-asm!))))))))))
(qed 'ccr-4-10)

;;; -----------------------------------------------------------------------
;;; 20. F_p = Z / pZ is a field.

(define fp-r '(FP-RINGOID p))
(define fp-s `(RINGOID-SETOID ,fp-r))
(define fp-q `(RINGOID-QUOTIENT-RING ,fp-r))
(define fp-pz '(SEP fpn_ ZZ (ZZ-DIVIDES p fpn_)))
;; ZZ-RING's slots
(define (fp-zz-read-off! name acc val)
  (dk-sp-qed! (make-wff `(== (,acc ZZ-RING) ,val))
  (lambda ()
  (fact 'zz-is-ring)
  (slot acc)
  (qrfl)
  )
  name))
(fp-zz-read-off! 'fp-zz-carr 'CARR 'ZZ)
(fp-zz-read-off! 'fp-zz-zero 'ZERO 0)
(fp-zz-read-off! 'fp-zz-one 'ONE 1)
(define fp-ladd '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN ZZ ZZ) (+ x_ y_)))
(define fp-lmul '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN ZZ ZZ) (* x_ y_)))
(define fp-lneg '(VNB-LAMBDA x_ ZZ (- x_)))
(fp-zz-read-off! 'fp-zz-add 'ADD fp-ladd)
(fp-zz-read-off! 'fp-zz-mul 'MUL fp-lmul)
(fp-zz-read-off! 'fp-zz-neg 'NEG fp-lneg)
(define (fp-val! name lam args val)
