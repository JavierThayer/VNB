;;; Sections: 1-4 Cauchy and null sequences of rationals in |.|_p terms; 5 the ringoid QP-CSR(p) of Cauchy
;;; sequences with the ideal of null sequences; 6 its quotient ring and the identification of its setoid with
;;; the completion's Cauchy setoid; 7 |[x]| as the limit of |x_k|_p, eventually constant unless x is null;
;;; 8 the ring operations on classes; 9 the laws of |.|; 10 inverses; 11 IS-NORMED-FIELD and IS-NV-FIELD of
;;; QP-FIELD(p); 12 Definition 1.26; 13 Proposition 1.28; 14 Proposition 1.29; 15-16 local NV fields, Corollary
;;; 2.18; 17 Remark 1.31, Proposition 1.32; 18 Proposition 2.7; 19 Proposition 4.10; 20-21 F_p, Proposition 1.22,
;;; Corollary 2.24; 22 Corollary 4.13; 23 Proposition 4.19 (the p-adic expansion, prefix qe-); 24 Proposition 1.30;
;;; 25 absolute convergence of the expansion; 26 Lemma 5.17 and Proposition 5.20 (the character lambda, prefix qx-);
;;; 27 Remark 4.18 for Q_p.  A helper that opens a proof does so through dk-sp-qed! (certified loads).

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define qm '(NF-METRIC-SPACE (QQ-PADIC p)))
(define (qp-a x) `((PADIC-ABS p) ,x))
(define (qp-pick pred tag) (or (find-first pred (dk-asms)) (error "qp-pick: nothing matching" tag)))
(define (dk-chain-head ch) (let loop ((c ch)) (if (and (dk-head-is? c 'IMPLIES) (dk-asm? (cadr c))) (loop (caddr c)) c)))
(define (qp-or-asm f thunk) (if (not (dk-asm? f)) (thunk)) f)
;; ZZ-PRIME p in context: the metric space M, its points QQ
(define (qp-setup!)
  (qp-or-asm '(IN p ZZ) (lambda () (dk-project! '(IN p ZZ) 'zz-prime '(ZZ-PRIME p))))
  (qp-or-asm '(IS-NORMED-FIELD (QQ-PADIC p)) (lambda () (dk-cite! 'qq-padic-is-normed-field 'p)))
  (qp-or-asm `(IS-METRIC-SPACE ,qm) (lambda () (dk-cite! 'nf-metric-space-is-metric-space '(QQ-PADIC p))))
  (qp-or-asm `(== (PTS ,qm) (CARR (QQ-PADIC p))) (lambda () (dk-cite! 'nf-metric-carrier '(QQ-PADIC p))))
  (qp-or-asm '(= (CARR (QQ-PADIC p)) QQ) (lambda () (dk-cite! 'pq-carr 'p)))
  (qp-or-asm `(== (PTS ,qm) QQ)
    (lambda () (dk-have! `(== (PTS ,qm) QQ) (lambda () (subst `(== (PTS ,qm) (CARR (QQ-PADIC p)))) (subst '(= (CARR (QQ-PADIC p)) QQ)) (qrfl)))))
  (qp-or-asm '(IN (PADIC-ABS p) (FUN QQ RR)) (lambda () (dk-cite! 'pz-abs-type 'p))))
;; X in QQ: |X| in RR and 0 <= |X|
(define (qp-abs! x)
  (qp-or-asm `(IN ,(qp-a x) RR)
    (lambda () (dk-have-and! '(IN (PADIC-ABS p) (FUN QQ RR)) `(IN ,x QQ)) (dk-cite! 'fun-apply-type '(PADIC-ABS p) 'QQ 'RR x)))
  (qp-or-asm `(<= 0 ,(qp-a x)) (lambda () (dk-cite! 'pz-abs-nonneg 'p x))))
;; F in FUN(NN, QQ), N in NN: (F N) in QQ, RR, |F N| typed
(define (qp-at! f n)
  (let ((t `(,f ,n)))
    (qp-or-asm `(IN ,t QQ) (lambda () (dk-have-and! `(IN ,f (FUN NN QQ)) `(IN ,n NN)) (dk-cite! 'fun-apply-type f 'NN 'QQ n)))
    (qp-or-asm `(IN ,t RR) (lambda () (dk-cite! 'qq-subset-rr t)))
    (qp-abs! t)
    t))
(define (qp-qq-sub! a b)
  (qp-or-asm `(IN (- ,b) QQ) (lambda () (dk-cite! 'qq-neg-closed b)))
  (qp-or-asm `(IN (+ ,a (- ,b)) QQ) (lambda () (dk-have-and! `(IN ,a QQ) `(IN (- ,b) QQ)) (dk-cite! 'qq-add-closed a `(- ,b))))
  (qp-abs! `(+ ,a (- ,b)))
  `(+ ,a (- ,b)))
(define (qp-qq-add! a b)
  (qp-or-asm `(IN (+ ,a ,b) QQ) (lambda () (dk-have-and! `(IN ,a QQ) `(IN ,b QQ)) (dk-cite! 'qq-add-closed a b)))
  (qp-abs! `(+ ,a ,b))
  `(+ ,a ,b))
(define (qp-qq-mul! a b)
  (qp-or-asm `(IN (* ,a ,b) QQ) (lambda () (dk-have-and! `(IN ,a QQ) `(IN ,b QQ)) (dk-cite! 'qq-mul-closed a b)))
  (qp-abs! `(* ,a ,b))
  `(* ,a ,b))
(define (qp-pos-rr! e)
  (dk-have! `(POS-RR ,e)
    (lambda () (mac 'pos-rr)
      (dk-conj-close! (lambda () (cond ((dk-ass!) #t)
                                       ((dk-head-is? (dk-goal) 'NOT) (let ((at (cadr (dk-goal)))) (di) (dk-absurd! at `(< 0 ,e))))
                                       (#t (dk-ineq! `(< 0 ,e)))))))))
;; IS-CAUCHY-SEQ(M, F) in context: land F in FUN(NN, QQ); return the eps law
(define (qp-eps-law f)
  `(FORALL eps (IMPLIES (POS-RR eps) (FORSOME N (AND (IN N NN) (FORALL m (IMPLIES (IN m NN) (FORALL n_ (IMPLIES (IN n_ NN)
     (IMPLIES (AND (<= N m) (<= N n_)) (<= ((DIST ,qm) (,f m) (,f n_)) eps)))))))))))
(define (qp-cauchy-open! f)
  (qp-setup!)
  (let ((h `(IS-CAUCHY-SEQ ,qm ,f)))
    (dk-project! `(IN ,f (FUN NN (PTS ,qm))) 'is-cauchy-seq h)
    (qp-or-asm `(IN ,f (FUN NN QQ)) (lambda () (dk-rewrite-h! `(IN ,f (FUN NN (PTS ,qm))) `(PTS ,qm) 'QQ)))
    (dk-project! (qp-eps-law f) 'is-cauchy-seq h)))
;; the eps law at E (POS-RR E in context): return (N . the m,n law)
(define (qp-cauchy-at! law e)
  (let* ((nn (dk-skolem! (dk-apply! law e)))
         (lw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nn) (dk-contains? h 'DIST))) "the Cauchy law")))
    (cons nn lw)))
;; the Cauchy law at M1, M2 (both past N): land |F M1 + -(F M2)| <= E and return it
(define (qp-cauchy-pt! f nl m1 m2 e)
  (let ((nn (car nl)) (lw (cdr nl)))
    (for-each (lambda (mi) (if (and (equal? mi nn) (not (dk-asm? `(<= ,nn ,mi)))) (dk-cite! 'nn-le-refl nn))) (list m1 m2))
    (dk-have-and! `(<= ,nn ,m1) `(<= ,nn ,m2))
    (dk-chain-ass! (dk-apply! lw m1 m2))
    (qp-at! f m1) (qp-at! f m2)
    (let ((d (dk-cite! 'pc-dist 'p `(,f ,m1) `(,f ,m2))))
      (dk-rewrite-h! `(<= ((DIST ,qm) (,f ,m1) (,f ,m2)) ,e) `((DIST ,qm) (,f ,m1) (,f ,m2)) (caddr d)))))

(define (pc-succ-var-qp g)
  (let walk ((t g))
    (cond ((and (pair? t) (eq? (car t) 'succ) (symbol? (cadr t))) (cadr t))
          ((pair? t) (or (walk (car t)) (walk (cdr t))))
          (#t #f))))

;;; -----------------------------------------------------------------------
;;; 1. The isosceles law, and bounds.

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x QQ) (FORALL y (IMPLIES (IN y QQ)
  (IMPLIES (< ((PADIC-ABS p) (+ x (- y))) ((PADIC-ABS p) x)) (= ((PADIC-ABS p) y) ((PADIC-ABS p) x)))))))))))
(dk-peel!)
(qp-setup!)
(qp-abs! 'x) (qp-abs! 'y)
(let* ((d (qp-qq-sub! 'x 'y)) (nd `(- ,d)) (ax (qp-a 'x)) (ay (qp-a 'y)) (ad (qp-a d)))
  (dk-cite! 'qq-neg-closed d) (qp-abs! nd)
  (dk-cite! 'pc-abs-neg 'p d)
  ;; |y| <= |x|
  (qp-qq-add! 'x nd)
  (dk-have! `(= (+ x ,nd) y) (lambda () (crs)))
  (let* ((u1 (dk-cite! 'pz-abs-ultra 'p 'x nd))
         (u2 (dk-rewrite-h! u1 `(+ x ,nd) 'y))
         (u3 (dk-rewrite-h! u2 (qp-a nd) ad)))
    u3)
  (fact 'rr-zero-in)
  (dk-cite! 'rr-max-closed ax ad)
  (dk-have! `(<= ,ad ,ax) (lambda () (dk-ineq! `(< ,ad ,ax))))
  (dk-cite! 'rr-max-left-le ax ad)
  (dk-have! `(<= ,ay ,ax)
    (lambda () (dk-ineq! `(<= ,ay (MAX ,ax ,ad)) `(= (MAX ,ax ,ad) ,ax))))
  ;; |x| <= |y|
  (qp-qq-add! d 'y)
  (dk-have! `(= (+ ,d y) x) (lambda () (crs)))
  (let* ((v1 (dk-cite! 'pz-abs-ultra 'p d 'y))
         (v2 (dk-rewrite-h! v1 `(+ ,d y) 'x)))
    (dk-cite! 'rr-max-closed ad ay)
    (dk-or-each! (dk-cite! 'rr-max-cases ad ay)
      (lambda (o)
        (if (equal? (caddr o) ad)
            (dk-absurd! v2 o `(< ,ad ,ax))
            (dk-ineq! v2 o `(<= ,ay ,ax)))))))
(qed 'qp-isosceles)

;; |f n| bounded on an initial segment
(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (FORALL p (IMPLIES (ZZ-PRIME p) (FORALL f (IMPLIES (IN f (FUN NN QQ))
  (FORSOME B (AND (IN B RR) (AND (<= 0 B) (FORALL n (IMPLIES (IN n NN) (IMPLIES (< n k) (<= ((PADIC-ABS p) (f n)) B)))))))))))))))
(let* ((bs (dk-ni-leaves)) (base (car bs)) (step (cadr bs)))
  (dk-focus! base)
  (dk-peel!)
  (fact 'rr-zero-in)
  (ew 0)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-ass!) #t)
            ((dk-head-is? (dk-goal) '<=) (arith))
            (#t (let* ((landed (dk-landed (lambda () (dk-peel!))))
                       (lt (find-first (lambda (h) (dk-head-is? h '<)) landed)))
                  (dk-nn-absurd! lt))))))
  (dk-focus! step)
  (dk-peel!)
  (qp-setup!)
  (let* ((k (pc-succ-var-qp (dk-goal)))
         (ih (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'PADIC-ABS))) "the IH"))
         (b (dk-skolem! (dk-apply! ih 'p 'f)))
         (law (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h b))) "the bound law"))
         (fk (qp-at! 'f k))
         (mx `(MAX ,b ,(qp-a fk))))
    (dk-cite! 'rr-max-closed b (qp-a fk))
    (dk-cite! 'rr-le-max-left b (qp-a fk)) (dk-cite! 'rr-le-max-right b (qp-a fk))
    (ew mx)
    (dk-conj-close!
      (lambda ()
        (cond ((dk-ass!) #t)
              ((dk-head-is? (dk-goal) '<=) (dk-ineq! `(<= 0 ,b) `(<= ,b ,mx)))
              (#t
               (let* ((landed (dk-landed (lambda () (dk-peel!))))
                      (n (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) landed))))
                 (dk-cite! 'nn-in-rr n) (dk-cite! 'nn-in-rr k)
                 (dk-cite! 'nn-succ-closed k)
                 (dk-cite! 'nn-subset-zz n) (dk-cite! 'nn-subset-zz `(succ ,k))
                 (dk-cite! 'zz-lt-succ-le n `(succ ,k))
                 (dk-cite! 'nn-succ-plus-one k)
                 (dk-cite! 'nn-in-rr `(succ ,k))
                 (dk-have! `(<= ,n ,k) (lambda () (dk-ineq! `(<= (+ ,n 1) (succ ,k)) `(= (succ ,k) (+ ,k 1)))))
                 (qp-at! 'f n)
                 (use-em `(= ,n ,k)
                   (lambda () (subst `(= ,n ,k)) (dk-ass!))
                   (lambda ()
                     (dk-have-and! `(<= ,n ,k) `(NOT (= ,n ,k)))
                     (dk-cite! 'rr-le-ne-lt n k)
                     (dk-chain-ass! (dk-apply! law n))
                     (dk-ineq! `(<= ,(qp-a `(f ,n)) ,b) `(<= ,b ,mx)))))))))))
(qed 'qp-init-bound-ind)

;; a Cauchy sequence of rationals is bounded in |.|_p
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL f (IMPLIES (IS-CAUCHY-SEQ ,qm f)
  (FORSOME B (AND (IN B RR) (AND (<= 0 B) (FORALL n (IMPLIES (IN n NN) (<= ((PADIC-ABS p) (f n)) B))))))))))))
(dk-peel!)
(let* ((law (qp-cauchy-open! 'f))
       (one (begin (fact 'rr-one-in) (dk-have! '(< 0 1) (lambda () (arith))) (qp-pos-rr! 1) 1))
       (nl (qp-cauchy-at! law 1))
       (nn (car nl))
       (b0 (dk-skolem! (dk-cite! 'qp-init-bound-ind nn 'p 'f)))
       (law0 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h b0))) "the initial bound"))
       (fn (qp-at! 'f nn))
       (an (qp-a fn))
       (m1 `(MAX ,an 1))
       (c `(MAX ,b0 ,m1)))
  (dk-cite! 'rr-max-closed an 1) (dk-cite! 'rr-max-closed b0 m1)
  (dk-cite! 'rr-le-max-left an 1) (dk-cite! 'rr-le-max-right an 1)
  (dk-cite! 'rr-le-max-left b0 m1) (dk-cite! 'rr-le-max-right b0 m1)
  (ew c)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-ass!) #t)
            ((dk-head-is? (dk-goal) '<=) (dk-ineq! `(<= 0 ,b0) `(<= ,b0 ,c)))
            (#t
             (let* ((landed (dk-landed (lambda () (dk-peel!))))
                    (n (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) landed)))
                    (fx (qp-at! 'f n)))
               (dk-cite! 'nn-in-rr n) (dk-cite! 'nn-in-rr nn)
               (dk-or-each! (dk-cite! 'rr-le-total nn n)
                 (lambda (o)
                   (if (equal? o `(<= ,nn ,n))
                       (let* ((h (qp-cauchy-pt! 'f nl n nn 1))
                              (d (qp-qq-sub! fx fn)))
                         (qp-qq-add! d fn)
                         (dk-have! `(= (+ ,d ,fn) ,fx) (lambda () (crs)))
                         (let* ((u1 (dk-cite! 'pz-abs-ultra 'p d fn))
                                (u2 (dk-rewrite-h! u1 `(+ ,d ,fn) fx)))
                           (dk-cite! 'rr-max-closed (qp-a d) an)
                           (dk-have-and! `(IN ,(qp-a d) RR) `(IN ,an RR) `(IN ,m1 RR))
                           (dk-have! `(<= ,(qp-a d) ,m1) (lambda () (dk-ineq! h `(<= 1 ,m1))))
                           (dk-chain-ass! (dk-cite! 'rr-max-le (qp-a d) an m1))
                           (dk-ineq! u2 `(<= (MAX ,(qp-a d) ,an) ,m1) `(<= ,m1 ,c))))
                       (use-em `(= ,n ,nn)
                         (lambda () (subst `(= ,n ,nn)) (dk-ineq! `(<= ,an ,m1) `(<= ,m1 ,c)))
                         (lambda ()
                           (dk-have-and! `(<= ,n ,nn) `(NOT (= ,n ,nn)))
                           (dk-cite! 'rr-le-ne-lt n nn)
                           (dk-chain-ass! (dk-apply! law0 n))
                           (dk-ineq! `(<= ,(qp-a fx) ,b0) `(<= ,b0 ,c)))))))))))))
(qed 'qp-cauchy-bounded)

;;; -----------------------------------------------------------------------
;;; 2. Null distance, in |.|_p terms.

(define (qp-small-law f g)
  `(FORALL eps (IMPLIES (POS-RR eps) (FORSOME nb (AND (IN nb NN) (FORALL kb (IMPLIES (IN kb NN) (IMPLIES (<= nb kb)
     (<= ((PADIC-ABS p) (+ (,f kb) (- (,g kb)))) eps)))))))))
;; F in FUN(NN, QQ): land F in FUN(NN, PTS M)
(define (qp-ptsq! f)
  (qp-setup!)
  (qp-or-asm `(IN ,f (FUN NN (PTS ,qm))) (lambda () (dk-have! `(IN ,f (FUN NN (PTS ,qm))) (lambda () (subst `(== (PTS ,qm) QQ)) (dk-ass!))))))
;; for K in NN, F, G in FUN(NN, QQ): the value of DIST-SEQ at K as |F K - G K|; returns that term
(define (qp-dseq-at! f g k)
  (let* ((fk (qp-at! f k)) (gk (qp-at! g k)) (d (qp-qq-sub! fk gk)))
    (dk-cite! 'rko2-dist-seq-at qm f g k)
    (dk-cite! 'pc-dist 'p fk gk)
    (qp-a d)))

(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL f (IMPLIES (IN f (FUN NN QQ)) (FORALL g (IMPLIES (IN g (FUN NN QQ))
  (IMPLIES ,(qp-small-law 'f 'g) (CSEQ-EQUIV ,qm f g))))))))))
(dk-peel!)
(qp-setup!) (qp-ptsq! 'f) (qp-ptsq! 'g)
(let* ((hyp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'PADIC-ABS))) "the hypothesis"))
       (ds `(DIST-SEQ ,qm f g)))
  (dk-chain-ass! (dk-cite! 'rko2-dist-seq-type qm 'f 'g))
  (fact 'rr-zero-in)
  (mac 'cseq-equiv)
  (let* ((ch (dk-cite! 'rr-converges-to-abs ds 0))
         (ant (cadr ch)))
    (dk-have! ant
      (lambda ()
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (ep (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) landed)))
               (nn (dk-skolem! (dk-apply! hyp ep)))
               (law (qp-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nn) (dk-contains? h 'PADIC-ABS))) "the law")))
          (ew nn)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (let* ((landed2 (dk-landed (lambda () (dk-peel!))))
                         (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) landed2))))
                    (dk-chain-ass! (dk-apply! law k))
                    (let ((a (qp-dseq-at! 'f 'g k)))
                      (subst `(== ((DIST-SEQ ,qm f g) ,k) ((DIST ,qm) (f ,k) (g ,k))))
                      (subst `(= ((DIST ,qm) (f ,k) (g ,k)) ,a))
                      (dk-have! `(= (- ,a 0) ,a) (lambda () (mac 'binary-minus-def) (crs)))
                      (subst `(= (- ,a 0) ,a))
                      (dk-cite! 'rr-abs-of-nonneg a)
                      (subst `(= (abs ,a) ,a))
                      (dk-ass!)))))))))
    (dk-chain-ass! ch)
    (dk-ass!)))
(qed 'qp-equiv-intro)

(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL f (IMPLIES (IN f (FUN NN QQ)) (FORALL g (IMPLIES (IN g (FUN NN QQ))
  (IMPLIES (CSEQ-EQUIV ,qm f g) ,(qp-small-law 'f 'g))))))))))
(dk-peel!)
(qp-setup!) (qp-ptsq! 'f) (qp-ptsq! 'g)
(let ((ds `(DIST-SEQ ,qm f g)))
  (dk-chain-ass! (dk-cite! 'rko2-dist-seq-type qm 'f 'g))
  (dk-iff-fwd! (dk-cite! 'cseq-equiv qm 'f 'g))
  (let ((cl (dk-project! `(FORALL eps (IMPLIES (POS-RR eps) (FORSOME N (AND (IN N NN) (FORALL n_ (IMPLIES (IN n_ NN)
                             (IMPLIES (<= N n_) (<= ((DIST RR-MS) (,ds n_) 0) eps))))))))
                         'converges-to `(CONVERGES-TO RR-MS ,ds 0))))
    (let* ((ep (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) (dk-asms))))
           (nn (dk-skolem! (dk-apply! cl ep)))
           (law (qp-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nn) (dk-contains? h 'RR-MS))) "the law")))
      (ew nn)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((landed2 (dk-landed (lambda () (dk-peel!))))
                     (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) landed2)))
                     (h1 (dk-chain-ass! (dk-apply! law k)))
                     (a (qp-dseq-at! 'f 'g k)))
                (dk-have-and! `(IN ,ds (FUN NN RR)) `(IN ,k NN))
                (dk-cite! 'fun-apply-type ds 'NN 'RR k)
                (fact 'rr-zero-in)
                (dk-cite! 'rr-ms-dist `(,ds ,k) 0)
                (let* ((h2 (dk-rewrite-h! h1 `((DIST RR-MS) (,ds ,k) 0) `(abs (- (,ds ,k) 0))))
                       (h3 (dk-rewrite-h! h2 `(,ds ,k) `((DIST ,qm) (f ,k) (g ,k))))
                       (h4 (dk-rewrite-h! h3 `((DIST ,qm) (f ,k) (g ,k)) a)))
                  (dk-have! `(= (- ,a 0) ,a) (lambda () (mac 'binary-minus-def) (crs)))
                  (dk-cite! 'rr-abs-of-nonneg a)
                  (let* ((h5 (dk-rewrite-h! h4 `(- ,a 0) a))
                         (h6 (dk-rewrite-h! h5 `(abs ,a) a)))
                    (dk-ass!))))))))))
(qed 'qp-equiv-elim)

;;; -----------------------------------------------------------------------
;;; 3. Cauchy sequences, in |.|_p terms, and their arithmetic.

(define (qp-cauchy-law f)
  `(FORALL eps (IMPLIES (POS-RR eps) (FORSOME nb (AND (IN nb NN) (FORALL ka (IMPLIES (IN ka NN) (FORALL kc (IMPLIES (IN kc NN)
     (IMPLIES (<= nb ka) (IMPLIES (<= nb kc) (<= ((PADIC-ABS p) (+ (,f ka) (- (,f kc)))) eps))))))))))))

(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL f (IMPLIES (IN f (FUN NN QQ))
  (IMPLIES ,(qp-cauchy-law 'f) (IS-CAUCHY-SEQ ,qm f))))))))
(dk-peel!)
(qp-setup!) (qp-ptsq! 'f)
(let ((hyp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'PADIC-ABS) (dk-contains? h 'kc))) "the hypothesis")))
  (mac 'IS-CAUCHY-SEQ)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((landed (dk-landed (lambda () (dk-peel!))))
                 (ep (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) landed)))
                 (nn (dk-skolem! (dk-apply! hyp ep)))
                 (law (qp-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nn) (dk-contains? h 'PADIC-ABS))) "the law")))
            (ew nn)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (let* ((landed2 (dk-landed (lambda () (dk-peel!) (dk-split-all!))))
                           (g (dk-goal))
                           (fm (cadr (cadr g))) (fn (caddr (cadr g)))
                           (m (cadr fm)) (n (cadr fn)))
                      (dk-chain-ass! (dk-apply! law m n))
                      (qp-at! 'f m) (qp-at! 'f n)
                      (subst (dk-cite! 'pc-dist 'p fm fn))
                      (dk-ass!))))))))))
(qed 'qp-cauchy-intro)

(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL f (IMPLIES (IS-CAUCHY-SEQ ,qm f) ,(qp-cauchy-law 'f)))))))
(dk-peel!)
(let* ((law (qp-cauchy-open! 'f))
       (ep (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) (dk-asms))))
       (nl (qp-cauchy-at! law ep)))
  (ew (car nl))
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((landed (dk-landed (lambda () (dk-peel!))))
                 (ins (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) landed)))
                 (a (car ins)) (c (cadr ins)))
            (qp-cauchy-pt! 'f nl a c ep)
            (dk-ass!))))))
(qed 'qp-cauchy-elim)

;; the law of a sequence, at EPS, for an explicitly given sequence term: returns (N . law)
(define (qp-cauchy-law-at! f eps)
  (let* ((cl (dk-chain-ass! (dk-cite! 'qp-cauchy-elim 'p f)))
         (nn (dk-skolem! (dk-apply! cl eps)))
         (lw (qp-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nn) (dk-contains? h 'PADIC-ABS))) "the law")))
    (cons nn lw)))
;; goal (IS-CAUCHY-SEQ M H), H a lambda over NN with values in QQ: open the |.| law; run BODY on (eps)
;; with the goal (FORSOME nb ...) in focus
(define (qp-cauchy-goal! h typer body)
  (qp-setup!)
  (dk-have! `(IN ,h (FUN NN QQ))
    (lambda () (dk-each-leaf! (lambda () (lam-t))
                 (lambda () (if (dk-head-is? (dk-goal) 'FORALL)
                                (let* ((landed (dk-landed (lambda () (dk-peel!))))
                                       (k (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) landed))))
                                  (typer k) (dk-close-if-asm!))
                                (begin (fact 'nn-is-set) (dk-ass!)))))))
  (let ((ch (dk-cite! 'qp-cauchy-intro 'p h)))
    (dk-have! (cadr ch)
      (lambda ()
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (ep (cadr (find-first (lambda (x) (dk-head-is? x 'POS-RR)) landed))))
          (body ep))))
    (dk-chain-ass! ch)
    (dk-ass!)))
;; at points A, C of a lambda H over NN: beta both values in the goal
(define (qp-beta-goal!) (dk-lam-b!))

;; the sum of two Cauchy sequences is Cauchy
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL f (IMPLIES (IS-CAUCHY-SEQ ,qm f) (FORALL g (IMPLIES (IS-CAUCHY-SEQ ,qm g)
  (IS-CAUCHY-SEQ ,qm (VNB-LAMBDA qsn_ NN (+ (f qsn_) (g qsn_))))))))))))
(dk-peel!)
(qp-cauchy-open! 'f) (qp-cauchy-open! 'g)
(qp-cauchy-goal! '(VNB-LAMBDA qsn_ NN (+ (f qsn_) (g qsn_)))
  (lambda (k) (let* ((a (qp-at! 'f k)) (b (qp-at! 'g k))) (dk-have-and! `(IN ,a QQ) `(IN ,b QQ)) (dk-cite! 'qq-add-closed a b)))
  (lambda (ep)
    (let* ((nf (qp-cauchy-law-at! 'f ep)) (ng (qp-cauchy-law-at! 'g ep))
           (nn `(+ ,(car nf) ,(car ng))))
      (dk-have-and! `(IN ,(car nf) NN) `(IN ,(car ng) NN)) (dk-cite! 'nn-add-closed (car nf) (car ng))
      (ew nn)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((landed (dk-landed (lambda () (dk-peel!))))
                     (ins (map cadr (filter (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) landed)))
                     (a (car ins)) (c (cadr ins)))
                (for-each (lambda (v) (dk-cite! 'nn-in-rr v)) (list a c (car nf) (car ng)))
                (dk-cite! 'nn-zero-le (car nf)) (dk-cite! 'nn-zero-le (car ng))
                (for-each (lambda (pr)
                            (let ((n0 (car pr)) (v (cadr pr)))
                              (dk-have! `(<= ,n0 ,v) (lambda () (dk-ineq! `(<= ,nn ,v) `(<= 0 ,(car nf)) `(<= 0 ,(car ng)))))))
                          (list (list (car nf) a) (list (car nf) c) (list (car ng) a) (list (car ng) c)))
                (dk-chain-ass! (dk-apply! (cdr nf) a c)) (dk-chain-ass! (dk-apply! (cdr ng) a c))
                (dk-lam-b!)
                (let* ((fa (qp-at! 'f a)) (fc (qp-at! 'f c)) (ga (qp-at! 'g a)) (gc (qp-at! 'g c))
                       (s1 (qp-qq-add! fa ga)) (s2 (qp-qq-add! fc gc))
                       (df (qp-qq-sub! fa fc)) (dg (qp-qq-sub! ga gc))
                       (lhs `(+ ,s1 (- ,s2))))
                  (qp-qq-sub! s1 s2) (qp-qq-add! df dg)
                  (dk-have! `(= ,lhs (+ ,df ,dg)) (lambda () (crs)))
                  (subst `(= ,lhs (+ ,df ,dg)))
                  (dk-cite! 'pz-abs-ultra 'p df dg)
                  (dk-cite! 'rr-max-closed (qp-a df) (qp-a dg))
                  (fact 'rr-zero-in)
                  (dk-have! `(IN ,ep RR) (lambda () (dk-cite! 'rr-pos-rr-in-rr ep) (dk-ass!)))
                  (dk-chain-ass! (dk-cite! 'rr-max-le (qp-a df) (qp-a dg) ep))
                  (dk-ineq! `(<= ,(qp-a `(+ ,df ,dg)) (MAX ,(qp-a df) ,(qp-a dg))) `(<= (MAX ,(qp-a df) ,(qp-a dg)) ,ep))))))))))
(qed 'qp-sum-cauchy)

;; the negative of a Cauchy sequence is Cauchy
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL f (IMPLIES (IS-CAUCHY-SEQ ,qm f)
  (IS-CAUCHY-SEQ ,qm (VNB-LAMBDA qsn_ NN (- (f qsn_))))))))))
(dk-peel!)
(qp-cauchy-open! 'f)
(qp-cauchy-goal! '(VNB-LAMBDA qsn_ NN (- (f qsn_)))
  (lambda (k) (let ((a (qp-at! 'f k))) (dk-cite! 'qq-neg-closed a)))
  (lambda (ep)
    (let ((nf (qp-cauchy-law-at! 'f ep)))
      (ew (car nf))
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((landed (dk-landed (lambda () (dk-peel!))))
                     (ins (map cadr (filter (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) landed)))
                     (a (car ins)) (c (cadr ins)))
                (dk-chain-ass! (dk-apply! (cdr nf) a c))
                (dk-lam-b!)
                (let* ((fa (qp-at! 'f a)) (fc (qp-at! 'f c)) (d (qp-qq-sub! fa fc))
                       (lhs `(+ (- ,fa) (- (- ,fc)))))
                  (dk-cite! 'qq-neg-closed fa) (dk-cite! 'qq-neg-closed fc)
                  (qp-qq-sub! `(- ,fa) `(- ,fc))
                  (dk-have! `(= ,lhs (- ,d)) (lambda () (crs)))
                  (subst `(= ,lhs (- ,d)))
                  (subst (dk-cite! 'pc-abs-neg 'p d))
                  (dk-ass!)))))))))
(qed 'qp-neg-cauchy)

;; a constant sequence is Cauchy
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL c (IMPLIES (IN c QQ)
  (IS-CAUCHY-SEQ ,qm (VNB-LAMBDA qsn_ NN c))))))))
(dk-peel!)
(qp-setup!)
(fact 'qq-zero-in)
(dk-have! '(= 0 0) (lambda () (arith)))
(dk-iff-bwd! (dk-cite! 'pz-abs-zero 'p 0))
(qp-cauchy-goal! '(VNB-LAMBDA qsn_ NN c)
  (lambda (k) (dk-ass!))
  (lambda (ep)
    (fact 'nn-zero-in)
    (ew 0)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (dk-peel!)
              (dk-lam-b!)
              (dk-have! '(= (+ c (- c)) 0) (lambda () (crs)))
              (subst '(= (+ c (- c)) 0))
              (subst '(= ((PADIC-ABS p) 0) 0))
              (dk-cite! 'rr-pos-rr-in-rr ep) (dk-cite! 'rr-lt-of-pos-rr ep)
              (dk-ineq! `(< 0 ,ep))))))))
(qed 'qp-const-cauchy)

;; the product of two Cauchy sequences is Cauchy
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL f (IMPLIES (IS-CAUCHY-SEQ ,qm f) (FORALL g (IMPLIES (IS-CAUCHY-SEQ ,qm g)
  (IS-CAUCHY-SEQ ,qm (VNB-LAMBDA qsn_ NN (* (f qsn_) (g qsn_))))))))))))
(dk-peel!)
(qp-cauchy-open! 'f) (qp-cauchy-open! 'g)
(let* ((bf (dk-skolem! (dk-cite! 'qp-cauchy-bounded 'p 'f)))
       (lf (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h bf))) "f's bound"))
       (bg (dk-skolem! (dk-cite! 'qp-cauchy-bounded 'p 'g)))
       (lg (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h bg))) "g's bound"))
       (cc `(+ (+ ,bf ,bg) 1)))
  (fact 'rr-one-in)
  (dk-have-and! `(IN ,bf RR) `(IN ,bg RR)) (dk-cite! 'rr-add-closed bf bg)
  (dk-have-and! `(IN (+ ,bf ,bg) RR) '(IN 1 RR)) (dk-cite! 'rr-add-closed `(+ ,bf ,bg) 1)
  (dk-have! `(< 0 ,cc) (lambda () (dk-ineq! `(<= 0 ,bf) `(<= 0 ,bg))))
  (dk-have! `(NOT (= ,cc 0)) (lambda () (di) (dk-absurd! `(= ,cc 0) `(< 0 ,cc))))
  (dk-have-and! `(IN ,cc RR) `(NOT (= ,cc 0)))
  (dk-cite! 'rr-recip-closed cc) (dk-cite! 'rr-recip-inverse cc)
  (dk-cite! 'rr-recip-pos cc)
  (let ((rc (dk-name! `(recip ,cc))))
    (dk-rewrite-h! `(= (* ,cc (recip ,cc)) 1) `(recip ,cc) rc)
    (dk-rewrite-h! `(< 0 (recip ,cc)) `(recip ,cc) rc)
    (qp-cauchy-goal! '(VNB-LAMBDA qsn_ NN (* (f qsn_) (g qsn_)))
      (lambda (k) (let* ((a (qp-at! 'f k)) (b (qp-at! 'g k))) (dk-have-and! `(IN ,a QQ) `(IN ,b QQ)) (dk-cite! 'qq-mul-closed a b)))
      (lambda (ep)
        (dk-cite! 'rr-pos-rr-in-rr ep) (dk-cite! 'rr-lt-of-pos-rr ep)
        (dk-have-and! `(IN ,ep RR) `(IN ,rc RR)) (dk-cite! 'rr-mul-closed ep rc)
        (let ((dl `(* ,ep ,rc)))
          (dk-cite! 'rr-mul-pos ep rc)
          (qp-pos-rr! dl)
          (let* ((nf (qp-cauchy-law-at! 'f dl)) (ng (qp-cauchy-law-at! 'g dl))
                 (nn `(+ ,(car nf) ,(car ng))))
            (dk-have-and! `(IN ,(car nf) NN) `(IN ,(car ng) NN)) (dk-cite! 'nn-add-closed (car nf) (car ng))
            (ew nn)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (let* ((landed (dk-landed (lambda () (dk-peel!))))
                           (ins (map cadr (filter (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) landed)))
                           (a (car ins)) (c (cadr ins)))
                      (for-each (lambda (v) (dk-cite! 'nn-in-rr v)) (list a c (car nf) (car ng)))
                      (dk-cite! 'nn-zero-le (car nf)) (dk-cite! 'nn-zero-le (car ng))
                      (for-each (lambda (pr)
                                  (let ((n0 (car pr)) (v (cadr pr)))
                                    (dk-have! `(<= ,n0 ,v) (lambda () (dk-ineq! `(<= ,nn ,v) `(<= 0 ,(car nf)) `(<= 0 ,(car ng)))))))
                                (list (list (car nf) a) (list (car nf) c) (list (car ng) a) (list (car ng) c)))
                      (dk-chain-ass! (dk-apply! (cdr nf) a c)) (dk-chain-ass! (dk-apply! (cdr ng) a c))
                      (dk-chain-ass! (dk-apply! lf a)) (dk-chain-ass! (dk-apply! lg c))
                      (dk-lam-b!)
                      (let* ((fa (qp-at! 'f a)) (fc (qp-at! 'f c)) (ga (qp-at! 'g a)) (gc (qp-at! 'g c))
                             (p1 (qp-qq-mul! fa ga)) (p2 (qp-qq-mul! fc gc))
                             (df (qp-qq-sub! fa fc)) (dg (qp-qq-sub! ga gc))
                             (t1 (qp-qq-mul! fa dg)) (t2 (qp-qq-mul! df gc))
                             (lhs `(+ ,p1 (- ,p2))))
                        (qp-qq-sub! p1 p2) (qp-qq-add! t1 t2)
                        (dk-have! `(= ,lhs (+ ,t1 ,t2)) (lambda () (crs)))
                        (subst `(= ,lhs (+ ,t1 ,t2)))
                        (dk-cite! 'pz-abs-ultra 'p t1 t2)
                        (dk-cite! 'pz-abs-mul 'p fa dg) (dk-cite! 'pz-abs-mul 'p df gc)
                        (let ((afa (qp-a fa)) (agc (qp-a gc)) (adg (qp-a dg)) (adf (qp-a df)))
                          ;; |fa| |dg| <= bf dl, |df| |gc| <= dl bg
                          (dk-have! `(<= 0 ,dl) (lambda () (dk-ineq! `(< 0 ,dl))))
                          (dk-cite! 'rr-mul-le-right afa bf adg)
                          (dk-cite! 'rr-mul-le-right adg dl bf)
                          (dk-cite! 'rr-mul-le-right adf dl agc)
                          (dk-cite! 'rr-mul-le-right agc bg dl)
                          (for-each (lambda (pr) (dk-rr-mul! (car pr) (cadr pr)))
                                    (list (list afa adg) (list bf adg) (list adg bf) (list dl bf) (list adf agc) (list dl agc) (list agc dl) (list bg dl) (list cc dl) (list ep rc)))
                          (dk-have! `(= (* ,bf ,adg) (* ,adg ,bf)) (lambda () (crs)))
                          (dk-have! `(= (* ,dl ,agc) (* ,agc ,dl)) (lambda () (crs)))
                          (dk-have! `(= (* ,cc ,dl) ,ep) (lambda () (dk-have! `(= (* ,cc (* ,ep ,rc)) (* ,ep (* ,cc ,rc))) (lambda () (crs))) (subst `(= (* ,cc (* ,ep ,rc)) (* ,ep (* ,cc ,rc)))) (subst `(= (* ,cc ,rc) 1)) (crs)))
                          (dk-have! `(= (* ,cc ,dl) (+ (+ (* ,dl ,bf) (* ,bg ,dl)) ,dl)) (lambda () (crs)))
                          (for-each (lambda (pr)
                                      (let ((x (car pr)) (y (cadr pr)))
                                        (fact 'rr-zero-in)
                                        (dk-cite! 'rr-mul-le-right 0 x y)
                                        (dk-rr-mul! 0 y)
                                        (dk-have! `(= (* 0 ,y) 0) (lambda () (crs)))
                                        (dk-have! `(<= 0 (* ,x ,y)) (lambda () (dk-ineq! `(<= (* 0 ,y) (* ,x ,y)) `(= (* 0 ,y) 0))))))
                                    (list (list bg dl) (list dl bf)))
                          (dk-have! `(<= (* ,afa ,adg) ,ep)
                            (lambda () (dk-ineq! `(<= (* ,afa ,adg) (* ,bf ,adg)) `(= (* ,bf ,adg) (* ,adg ,bf)) `(<= (* ,adg ,bf) (* ,dl ,bf))
                                                 `(= (* ,cc ,dl) ,ep) `(= (* ,cc ,dl) (+ (+ (* ,dl ,bf) (* ,bg ,dl)) ,dl)) `(<= 0 ,dl)
                                                 `(<= 0 ,bg) `(<= 0 (* ,bg ,dl)))))
                          (dk-have! `(<= (* ,adf ,agc) ,ep)
                            (lambda () (dk-ineq! `(<= (* ,adf ,agc) (* ,dl ,agc)) `(= (* ,dl ,agc) (* ,agc ,dl)) `(<= (* ,agc ,dl) (* ,bg ,dl))
                                                 `(= (* ,cc ,dl) ,ep) `(= (* ,cc ,dl) (+ (+ (* ,dl ,bf) (* ,bg ,dl)) ,dl)) `(<= 0 ,dl)
                                                 `(<= 0 (* ,dl ,bf)))))
                          (dk-cite! 'rr-max-closed (qp-a t1) (qp-a t2))
                          (dk-have-and! `(IN ,(qp-a t1) RR) `(IN ,(qp-a t2) RR) `(IN ,ep RR))
                          (dk-have! `(<= ,(qp-a t1) ,ep) (lambda () (subst `(= ,(qp-a t1) (* ,afa ,adg))) (dk-ass!)))
                          (dk-have! `(<= ,(qp-a t2) ,ep) (lambda () (subst `(= ,(qp-a t2) (* ,adf ,agc))) (dk-ass!)))
                          (dk-chain-ass! (dk-cite! 'rr-max-le (qp-a t1) (qp-a t2) ep))
                          (dk-ineq! `(<= ,(qp-a `(+ ,t1 ,t2)) (MAX ,(qp-a t1) ,(qp-a t2))) `(<= (MAX ,(qp-a t1) ,(qp-a t2)) ,ep))))))))))))))
(qed 'qp-mul-cauchy)

;;; -----------------------------------------------------------------------
;;; 4. Membership in QP-CS and QP-NULL.

(define qz '(VNB-LAMBDA qsn_ NN 0))
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL h (IFF (IN h (QP-CS p)) (IS-CAUCHY-SEQ ,qm h)))))))
(dk-peel!)
(qp-setup!)
(dk-cite! 'rko2-cseq-unfold qm)
(mac 'QP-CS)
(subst `(== (CSEQ ,qm) (SEP f_ (FUN NN (PTS ,qm)) (IS-CAUCHY-SEQ ,qm f_))))
(dk-iff! (lambda (g) (dk-head-is? g 'IS-CAUCHY-SEQ))
  (lambda () (dk-sep-parts! (find-first (lambda (x) (and (dk-head-is? x 'IN) (dk-contains? x 'SEP))) (dk-asms))) (dk-ass!))
  (lambda ()
    (dk-project! `(IN h (FUN NN (PTS ,qm))) 'is-cauchy-seq `(IS-CAUCHY-SEQ ,qm h))
    (fact 'nn-is-set)
    (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
(qed 'qp-cs-iff)

(define (qp-small0-law f)
  `(FORALL eps (IMPLIES (POS-RR eps) (FORSOME nb (AND (IN nb NN) (FORALL kb (IMPLIES (IN kb NN) (IMPLIES (<= nb kb)
     (<= ((PADIC-ABS p) (,f kb)) eps)))))))))

(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL f (IMPLIES (IN f (FUN NN QQ))
  (IFF (CSEQ-EQUIV ,qm f ,qz) ,(qp-small0-law 'f))))))))
(dk-peel!)
(qp-setup!)
(fact 'qq-zero-in) (fact 'nn-is-set)
(dk-have! `(IN ,qz (FUN NN QQ))
  (lambda () (dk-each-leaf! (lambda () (lam-t)) (lambda () (if (dk-head-is? (dk-goal) 'FORALL) (begin (dk-peel!) (dk-ass!)) (dk-ass!))))))
(let ((conv (lambda (from-law to-law)
              ;; FROM-LAW in context: prove TO-LAW (they differ by f k vs f k + -(0-seq k))
              (dk-have! to-law
                (lambda ()
                  (let* ((landed (dk-landed (lambda () (dk-peel!))))
                         (ep (cadr (find-first (lambda (x) (dk-head-is? x 'POS-RR)) landed)))
                         (nn (dk-skolem! (dk-apply! from-law ep)))
                         (lw (qp-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x nn) (dk-contains? x 'PADIC-ABS))) "the law")))
                    (ew nn)
                    (dk-conj-close!
                      (lambda ()
                        (if (not (dk-ass!))
                            (let* ((landed2 (dk-landed (lambda () (dk-peel!))))
                                   (k (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) landed2)))
                                   (h (dk-chain-ass! (dk-apply! lw k)))
                                   (fk (qp-at! 'f k)))
                              (dk-have! `(= (,qz ,k) 0) (lambda () (dk-lam-b!) (dk-close-if-asm!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
                              (dk-have! `(= (+ ,fk (- 0)) ,fk) (lambda () (crs)))
                              (if (dk-contains? (dk-goal) qz)
                                  (begin (subst `(= (,qz ,k) 0)) (subst `(= (+ ,fk (- 0)) ,fk)) (dk-ass!))
                                  (let* ((h2 (dk-rewrite-h! h `(,qz ,k) 0)) (h3 (dk-rewrite-h! h2 `(+ ,fk (- 0)) fk))) (dk-ass!)))))))))))))
  (dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
    (lambda ()
      (let ((l1 (dk-chain-ass! (dk-cite! 'qp-equiv-elim 'p 'f qz))))
        (conv l1 (qp-small0-law 'f))
        (dk-ass!)))
    (lambda ()
      (let* ((l0 (find-first (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'PADIC-ABS) (dk-contains? x 'kb))) (dk-asms)))
             (ch (dk-cite! 'qp-equiv-intro 'p 'f qz)))
        (conv l0 (cadr (dk-chain-head ch)))
        (dk-chain-ass! ch)
        (dk-ass!)))))
(qed 'qp-null-iff)

(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL h (IFF (IN h (QP-NULL p)) (AND (IS-CAUCHY-SEQ ,qm h) ,(qp-small0-law 'h))))))))
(dk-peel!)
(qp-setup!)
(mac 'QP-NULL)
(dk-iff! (lambda (g) (dk-head-is? g 'AND))
  (lambda ()
    (dk-sep-parts! (find-first (lambda (x) (and (dk-head-is? x 'IN) (dk-contains? x 'SEP))) (dk-asms)))
    (dk-iff-fwd! (dk-cite! 'qp-cs-iff 'p 'h))
    (qp-cauchy-open! 'h)
    (dk-iff-fwd! (dk-cite! 'qp-null-iff 'p 'h))
    (dk-and-close! dk-ass!))
  (lambda ()
    (dk-split-all!)
    (qp-cauchy-open! 'h)
    (in-sep! (lambda () (dk-iff-bwd! (dk-cite! 'qp-cs-iff 'p 'h)) (dk-close-if-asm!))
             (lambda () (dk-iff-bwd! (dk-cite! 'qp-null-iff 'p 'h)) (dk-close-if-asm!)))))
(qed 'qp-null-member-iff)

;; open A in QP-NULL: land its Cauchy-ness, F in FUN(NN,QQ) and its small law (returned)
(define (qp-null-open! a)
  (qp-setup!)
  (dk-iff-fwd! (dk-cite! 'qp-null-member-iff 'p a))
  (qp-cauchy-open! a)
  (find-first (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'kb) (dk-contains? x a) (not (dk-contains? x 'kc)))) (dk-asms)))
;; the small law of A at EPS: return (N . law)
(define (qp-small-at! law eps)
  (let* ((nn (dk-skolem! (dk-apply! law eps)))
         (lw (qp-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nn) (dk-contains? h 'PADIC-ABS))) "the small law")))
    (cons nn lw)))
;; goal (IN H (QP-NULL p)), H Cauchy already in context: open the small law and run BODY on eps
(define (qp-null-goal! h body)
  (let ((iff (dk-cite! 'qp-null-member-iff 'p h)))
    (dk-have! (qp-small0-law h)
      (lambda ()
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (ep (cadr (find-first (lambda (x) (dk-head-is? x 'POS-RR)) landed))))
          (body ep))))
    (dk-have-and! `(IS-CAUCHY-SEQ ,qm ,h) (qp-small0-law h))
    (dk-iff-bwd! iff)
    (dk-close-if-asm!)))
(define (qp-past! nn v) ; nn, v in NN, (<= nn v): typing
  (dk-cite! 'nn-in-rr v) (dk-cite! 'nn-in-rr nn))

;; the null sequences are closed under +
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL a (IMPLIES (IN a (QP-NULL p)) (FORALL b (IMPLIES (IN b (QP-NULL p))
  (IN (VNB-LAMBDA qsn_ NN (+ (a qsn_) (b qsn_))) (QP-NULL p))))))))))
(dk-peel!)
(let* ((la (qp-null-open! 'a)) (lb (qp-null-open! 'b)) (h '(VNB-LAMBDA qsn_ NN (+ (a qsn_) (b qsn_)))))
  (dk-cite! 'qp-sum-cauchy 'p 'a 'b)
  (qp-null-goal! h
    (lambda (ep)
      (let* ((na (qp-small-at! la ep)) (nb (qp-small-at! lb ep)) (nn `(+ ,(car na) ,(car nb))))
        (dk-have-and! `(IN ,(car na) NN) `(IN ,(car nb) NN)) (dk-cite! 'nn-add-closed (car na) (car nb))
        (ew nn)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (let* ((landed (dk-landed (lambda () (dk-peel!))))
                       (k (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) landed))))
                  (for-each (lambda (v) (dk-cite! 'nn-in-rr v)) (list k (car na) (car nb)))
                  (dk-cite! 'nn-zero-le (car na)) (dk-cite! 'nn-zero-le (car nb))
                  (dk-have! `(<= ,(car na) ,k) (lambda () (dk-ineq! `(<= ,nn ,k) `(<= 0 ,(car nb)))))
                  (dk-have! `(<= ,(car nb) ,k) (lambda () (dk-ineq! `(<= ,nn ,k) `(<= 0 ,(car na)))))
                  (dk-chain-ass! (dk-apply! (cdr na) k)) (dk-chain-ass! (dk-apply! (cdr nb) k))
                  (dk-lam-b!)
                  (let* ((ak (qp-at! 'a k)) (bk (qp-at! 'b k)))
                    (qp-qq-add! ak bk)
                    (dk-cite! 'pz-abs-ultra 'p ak bk)
                    (dk-cite! 'rr-max-closed (qp-a ak) (qp-a bk))
                    (dk-cite! 'rr-pos-rr-in-rr ep)
                    (dk-chain-ass! (dk-cite! 'rr-max-le (qp-a ak) (qp-a bk) ep))
                    (dk-ineq! `(<= ,(qp-a `(+ ,ak ,bk)) (MAX ,(qp-a ak) ,(qp-a bk))) `(<= (MAX ,(qp-a ak) ,(qp-a bk)) ,ep)))))))))))
(qed 'qp-null-add)

;; ... under -
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL a (IMPLIES (IN a (QP-NULL p))
  (IN (VNB-LAMBDA qsn_ NN (- (a qsn_))) (QP-NULL p))))))))
(dk-peel!)
(let* ((la (qp-null-open! 'a)) (h '(VNB-LAMBDA qsn_ NN (- (a qsn_)))))
  (dk-cite! 'qp-neg-cauchy 'p 'a)
  (qp-null-goal! h
    (lambda (ep)
      (let ((na (qp-small-at! la ep)))
        (ew (car na))
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (let* ((landed (dk-landed (lambda () (dk-peel!))))
                       (k (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) landed))))
                  (dk-chain-ass! (dk-apply! (cdr na) k))
                  (dk-lam-b!)
                  (let ((ak (qp-at! 'a k)))
                    (subst (dk-cite! 'pc-abs-neg 'p ak))
                    (dk-ass!))))))))))
(qed 'qp-null-neg)

;; the zero sequence is null
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (IN ,qz (QP-NULL p))))))
(dk-peel!)
(qp-setup!)
(fact 'qq-zero-in)
(dk-cite! 'qp-const-cauchy 'p 0)
(dk-have! '(= 0 0) (lambda () (arith)))
(dk-iff-bwd! (dk-cite! 'pz-abs-zero 'p 0))
(qp-null-goal! qz
  (lambda (ep)
    (fact 'nn-zero-in)
    (ew 0)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (dk-peel!)
              (dk-lam-b!)
              (subst '(= ((PADIC-ABS p) 0) 0))
              (dk-cite! 'rr-pos-rr-in-rr ep) (dk-cite! 'rr-lt-of-pos-rr ep)
              (dk-ineq! `(< 0 ,ep))))))))
(qed 'qp-null-zero)

;; X Cauchy (bound B), A null: the products X*A and A*X are null
(define (qp-null-mul-proof! left? name)
  (dk-sp-qed! (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (QP-CS p)) (FORALL a (IMPLIES (IN a (QP-NULL p))
    (IN (VNB-LAMBDA qsn_ NN ,(if left? '(* (x qsn_) (a qsn_)) '(* (a qsn_) (x qsn_)))) (QP-NULL p)))))))))
  (lambda ()
  (dk-peel!)
  (qp-setup!)
  (dk-iff-fwd! (dk-cite! 'qp-cs-iff 'p 'x))
  (qp-cauchy-open! 'x)
  (let* ((la (qp-null-open! 'a))
         (h `(VNB-LAMBDA qsn_ NN ,(if left? '(* (x qsn_) (a qsn_)) '(* (a qsn_) (x qsn_)))))
         (bx (dk-skolem! (dk-cite! 'qp-cauchy-bounded 'p 'x)))
         (lx (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h bx))) "x's bound"))
         (cc `(+ ,bx 1)))
    (if left? (dk-cite! 'qp-mul-cauchy 'p 'x 'a) (dk-cite! 'qp-mul-cauchy 'p 'a 'x))
    (fact 'rr-one-in)
    (dk-have-and! `(IN ,bx RR) '(IN 1 RR)) (dk-cite! 'rr-add-closed bx 1)
    (dk-have! `(< 0 ,cc) (lambda () (dk-ineq! `(<= 0 ,bx))))
    (dk-have! `(NOT (= ,cc 0)) (lambda () (di) (dk-absurd! `(= ,cc 0) `(< 0 ,cc))))
    (dk-have-and! `(IN ,cc RR) `(NOT (= ,cc 0)))
    (dk-cite! 'rr-recip-closed cc) (dk-cite! 'rr-recip-inverse cc) (dk-cite! 'rr-recip-pos cc)
    (let ((rc (dk-name! `(recip ,cc))))
      (dk-rewrite-h! `(= (* ,cc (recip ,cc)) 1) `(recip ,cc) rc)
      (dk-rewrite-h! `(< 0 (recip ,cc)) `(recip ,cc) rc)
      (qp-null-goal! h
        (lambda (ep)
          (dk-cite! 'rr-pos-rr-in-rr ep) (dk-cite! 'rr-lt-of-pos-rr ep)
          (dk-rr-mul! ep rc)
          (let ((dl `(* ,ep ,rc)))
            (dk-cite! 'rr-mul-pos ep rc)
            (qp-pos-rr! dl)
            (let ((na (qp-small-at! la dl)))
              (ew (car na))
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (let* ((landed (dk-landed (lambda () (dk-peel!))))
                             (k (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) landed))))
                        (dk-chain-ass! (dk-apply! (cdr na) k))
                        (dk-chain-ass! (dk-apply! lx k))
                        (dk-lam-b!)
                        (let* ((xk (qp-at! 'x k)) (ak (qp-at! 'a k))
                               (pr (if left? (qp-qq-mul! xk ak) (qp-qq-mul! ak xk)))
                               (axk (qp-a xk)) (aak (qp-a ak)))
                          (if left? (dk-cite! 'pz-abs-mul 'p xk ak) (dk-cite! 'pz-abs-mul 'p ak xk))
                          (subst (if left? `(= ,(qp-a pr) (* ,axk ,aak)) `(= ,(qp-a pr) (* ,aak ,axk))))
                          (dk-have! `(<= 0 ,dl) (lambda () (dk-ineq! `(< 0 ,dl))))
                          (dk-cite! 'rr-mul-le-right axk bx aak)
                          (dk-cite! 'rr-mul-le-right aak dl bx)
                          (for-each (lambda (pq) (dk-rr-mul! (car pq) (cadr pq)))
                                    (list (list axk aak) (list aak axk) (list bx aak) (list aak bx) (list dl bx) (list cc dl)))
                          (dk-have! `(= (* ,bx ,aak) (* ,aak ,bx)) (lambda () (crs)))
                          (dk-have! `(= (* ,axk ,aak) (* ,aak ,axk)) (lambda () (crs)))
                          (dk-have! `(= (* ,cc ,dl) ,ep) (lambda () (dk-have! `(= (* ,cc (* ,ep ,rc)) (* ,ep (* ,cc ,rc))) (lambda () (crs))) (subst `(= (* ,cc (* ,ep ,rc)) (* ,ep (* ,cc ,rc)))) (subst `(= (* ,cc ,rc) 1)) (crs)))
                          (dk-have! `(= (* ,cc ,dl) (+ (* ,dl ,bx) ,dl)) (lambda () (crs)))
                          (dk-ineq! `(<= (* ,axk ,aak) (* ,bx ,aak)) `(= (* ,bx ,aak) (* ,aak ,bx)) `(<= (* ,aak ,bx) (* ,dl ,bx))
                                    `(= (* ,axk ,aak) (* ,aak ,axk)) `(= (* ,cc ,dl) ,ep) `(= (* ,cc ,dl) (+ (* ,dl ,bx) ,dl)) `(<= 0 ,dl))))))))))))))
  name))
(qp-null-mul-proof! #t 'qp-null-mul-left)
(qp-null-mul-proof! #f 'qp-null-mul-right)
;;; -----------------------------------------------------------------------
;;; 5. The ringoid of Cauchy sequences QP-CSR(p) = [QP-CS, +, *, -, 0, 1, QP-NULL].

(define (qp-rfl!) (dk-close-if-asm!) (if (pair? (dk-open-leaves)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
;; U in QP-CS in context: land IS-CAUCHY-SEQ(M, U) and U in FUN(NN, QQ)
(define (qp-cs! u)
  (qp-setup!)
  (qp-or-asm `(IS-CAUCHY-SEQ ,qm ,u) (lambda () (dk-iff-fwd! (dk-cite! 'qp-cs-iff 'p u))))
  (qp-cauchy-open! u))

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (IN (QP-CS p) SET)))))
(dk-peel!)
(qp-setup!)
(mac 'QP-CS)
(dk-cite! 'rkt-cseq-is-set qm)
(dk-close-if-asm!)
(qed 'qp-cs-set)

;; the operations at an index
(define (qp-op-at! name op args val)
  (dk-sp-qed! (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p)
     ,(let wrap ((as args))
        (if (null? as)
            `(FORALL k (IMPLIES (IN k NN) (= (((,op p) ,@args) k) ,val)))
            `(FORALL ,(car as) (IMPLIES (IN ,(car as) (QP-CS p)) ,(wrap (cdr as)))))))))
  (lambda ()
  (dk-peel!)
  (for-each (lambda (a) (qp-cs! a) (qp-at! a 'k)) args)
  (mac op)
  (dk-lam-b!)
  (qp-rfl!)
  )
  name))
(qp-op-at! 'qp-sadd-at 'QP-SADD '(u v) '(+ (u k) (v k)))
(qp-op-at! 'qp-smul-at 'QP-SMUL '(u v) '(* (u k) (v k)))
(qp-op-at! 'qp-sneg-at 'QP-SNEG '(u) '(- (u k)))

;; the operations stay in QP-CS
(define (qp-op-type! name op args lam cauchy)
  (dk-sp-qed! (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p)
     ,(let wrap ((as args))
        (if (null? as)
            `(IN ((,op p) ,@args) (QP-CS p))
            `(FORALL ,(car as) (IMPLIES (IN ,(car as) (QP-CS p)) ,(wrap (cdr as)))))))))
  (lambda ()
  (dk-peel!)
  (for-each qp-cs! args)
  (apply dk-cite! cauchy 'p args)
  (dk-iff-bwd! (dk-cite! 'qp-cs-iff 'p lam))
  (mac op)
  (dk-lam-b!)
  (dk-close-if-asm!)
  )
  name))
(qp-op-type! 'qp-sadd-type 'QP-SADD '(u v) '(VNB-LAMBDA qsn_ NN (+ (u qsn_) (v qsn_))) 'qp-sum-cauchy)
(qp-op-type! 'qp-smul-type 'QP-SMUL '(u v) '(VNB-LAMBDA qsn_ NN (* (u qsn_) (v qsn_))) 'qp-mul-cauchy)
(qp-op-type! 'qp-sneg-type 'QP-SNEG '(u) '(VNB-LAMBDA qsn_ NN (- (u qsn_))) 'qp-neg-cauchy)

;; the operations are functions on QP-CS
(define (qp-op-fun! name op arity cauchy)
  (dk-sp-qed! (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p)
     (IN (,op p) (FUN ,(if (= arity 2) '(CARTESIAN (QP-CS p) (QP-CS p)) '(QP-CS p)) (QP-CS p))))))
  (lambda ()
  (dk-peel!)
  (dk-cite! 'qp-cs-set 'p)
  (mac op)
  (let ((opened (dk-opened (lambda () (lam-t)))))
    (for-each
      (lambda (l)
        (dk-focus! l)
        (let ((g (dk-goal)))
          (cond
            ((dk-head-is? g 'FORALL)
             (let* ((landed (dk-landed (lambda () (dk-peel!))))
                    (vs (map cadr (filter (lambda (x) (dk-head-is? x 'IN)) landed))))
               (for-each qp-cs! vs)
               (apply dk-cite! cauchy 'p vs)
               (dk-iff-bwd! (dk-cite! 'qp-cs-iff 'p (cadr (dk-goal))))
               (dk-close-if-asm!)))
            ((equal? g '(IN (QP-CS p) SET)) (dk-ass!))
            (#t (dk-have-and! '(IN (QP-CS p) SET) '(IN (QP-CS p) SET))
                (mac 'cartesian-set-iff)
                (dk-close-if-asm!)))))
      opened))
  )
  name))
(qp-op-fun! 'qp-sadd-fun 'QP-SADD 2 'qp-sum-cauchy)
(qp-op-fun! 'qp-smul-fun 'QP-SMUL 2 'qp-mul-cauchy)
(qp-op-fun! 'qp-sneg-fun 'QP-SNEG 1 'qp-neg-cauchy)

;; the constant sequences 0 and 1
(define (qp-const-cs! c)
  (qp-setup!)
  (fact (if (eqv? c 0) 'qq-zero-in 'qq-one-in))
  (dk-cite! 'qp-const-cauchy 'p c)
  (dk-iff-bwd! (dk-cite! 'qp-cs-iff 'p `(VNB-LAMBDA qsn_ NN ,c)))
  (dk-close-if-asm!))
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (IN (VNB-LAMBDA qsn_ NN 0) (QP-CS p))))))
(dk-peel!) (qp-const-cs! 0)
(qed 'qp-zero-cs)
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (IN (VNB-LAMBDA qsn_ NN 1) (QP-CS p))))))
(dk-peel!) (qp-const-cs! 1)
(qed 'qp-one-cs)

;; the null sequences are Cauchy sequences
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL z (IMPLIES (IN z (QP-NULL p)) (IN z (QP-CS p))))))))
(dk-peel!)
(qp-setup!)
(dk-iff-fwd! (dk-cite! 'qp-null-member-iff 'p 'z))
(dk-iff-bwd! (dk-cite! 'qp-cs-iff 'p 'z))
(dk-close-if-asm!)
(qed 'qp-null-cs)

;; a Cauchy sequence is a sequence of rationals
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL h (IMPLIES (IN h (QP-CS p)) (IN h (FUN NN QQ))))))))
(dk-peel!)
(qp-cs! 'h)
(dk-close-if-asm!)
(qed 'qp-cs-fun)

;; the operations as sequences
(define (qp-op-value! name op args lam)
  (dk-sp-qed! (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p)
     ,(let wrap ((as args))
        (if (null? as)
            `(= ((,op p) ,@args) ,lam)
            `(FORALL ,(car as) (IMPLIES (IN ,(car as) (QP-CS p)) ,(wrap (cdr as)))))))))
  (lambda ()
  (dk-peel!)
  (fact 'nn-is-set)
  (for-each (lambda (a) (dk-cite! 'qp-cs-fun 'p a)) args)
  (mac op)
  (dk-lam-b!)
  (qp-rfl!)
  )
  name))
(qp-op-value! 'qp-sadd-value 'QP-SADD '(u v) '(VNB-LAMBDA qsn_ NN (+ (u qsn_) (v qsn_))))
(qp-op-value! 'qp-smul-value 'QP-SMUL '(u v) '(VNB-LAMBDA qsn_ NN (* (u qsn_) (v qsn_))))
(qp-op-value! 'qp-sneg-value 'QP-SNEG '(u) '(VNB-LAMBDA qsn_ NN (- (u qsn_))))

;; the null sequences are a subset of QP-CS
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (IN (QP-NULL p) (POWER (QP-CS p)))))))
(dk-peel!)
(dk-cite! 'qp-cs-set 'p)
(dk-have! '(IN (QP-NULL p) SET)
  (lambda () (mac 'QP-NULL) (dk-each-leaf! (lambda () (sep-set)) (lambda () (dk-close-if-asm!)))))
(dk-have! '(FORALL z (IMPLIES (IN z (QP-NULL p)) (IN z (QP-CS p))))
  (lambda ()
    (dk-peel!)
    (dk-iff-fwd! (dk-cite! 'qp-null-member-iff 'p 'z))
    (dk-iff-bwd! (dk-cite! 'qp-cs-iff 'p 'z))
    (dk-close-if-asm!)))
(dk-have-and! '(IN (QP-NULL p) SET) '(FORALL z (IMPLIES (IN z (QP-NULL p)) (IN z (QP-CS p)))))
(dk-iff-bwd! (dk-cite! 'power-set-membership '(QP-CS p) '(QP-NULL p)))
(dk-close-if-asm!)
(qed 'qp-null-power)

;; the slots of QP-CSR
(define (qp-csr-read-off! name acc val)
  (dk-sp-qed! (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (== (,acc (QP-CSR p)) ,val))))
  (lambda ()
  (dk-peel!)
  (for-each (lambda (n) (dk-cite! n 'p)) '(qp-cs-set qp-sadd-fun qp-smul-fun qp-sneg-fun qp-zero-cs qp-one-cs qp-null-power))
  (slot acc)
  (mac 'QP-CSR)
  (nth-r)
  (qrfl)
  )
  name))
(qp-csr-read-off! 'qp-csr-carr 'CARR '(QP-CS p))
(qp-csr-read-off! 'qp-csr-add 'ADD '(QP-SADD p))
(qp-csr-read-off! 'qp-csr-mul 'MUL '(QP-SMUL p))
(qp-csr-read-off! 'qp-csr-neg 'NEG '(QP-SNEG p))
(qp-csr-read-off! 'qp-csr-zero 'ZERO '(VNB-LAMBDA qsn_ NN 0))
(qp-csr-read-off! 'qp-csr-one 'ONE '(VNB-LAMBDA qsn_ NN 1))
(qp-csr-read-off! 'qp-csr-idl 'IDL '(QP-NULL p))

;;; the ring laws, pointwise
(define qp-op-table
  '((QP-SADD qp-sadd-type qp-sadd-at qp-sadd-value) (QP-SMUL qp-smul-type qp-smul-at qp-smul-value)
    (QP-SNEG qp-sneg-type qp-sneg-at qp-sneg-value)))
(define (qp-op-app? t) (and (pair? t) (pair? (car t)) (assq (car (car t)) qp-op-table)))
(define (qp-type! t)
  (cond ((dk-asm? `(IN ,t (QP-CS p))) #t)
        ((qp-op-app? t) => (lambda (row) (for-each qp-type! (cdr t)) (apply dk-cite! (cadr row) 'p (cdr t))))
        ((equal? t '(VNB-LAMBDA qsn_ NN 0)) (dk-cite! 'qp-zero-cs 'p))
        ((equal? t '(VNB-LAMBDA qsn_ NN 1)) (dk-cite! 'qp-one-cs 'p))
        ((and (dk-head-is? t 'VNB-LAMBDA) (eq? (cadr t) 'qsn_) (eq? (caddr t) 'NN) (not (dk-contains? (cadddr t) 'qsn_)))
         (dk-cite! 'qp-const-cauchy 'p (cadddr t))
         (dk-iff-bwd! (dk-cite! 'qp-cs-iff 'p t)))
        (#t (error "qp-type!: no typing for" t))))
;; rewrite (T K) in the goal into rational arithmetic
(define (qp-eval! t k)
  (cond ((qp-op-app? t)
         => (lambda (row)
              (let ((eq (apply dk-cite! (caddr row) 'p (append (cdr t) (list k)))))
                (if (dk-contains? (dk-goal) `(,t ,k)) (subst eq))
                (for-each (lambda (a) (qp-eval! a k)) (cdr t)))))
        ((symbol? t) (dk-cite! 'qp-cs-fun 'p t) (qp-at! t k))
        (#t #t)))
;; goal (= L R) of Cauchy sequences built from the operations
(define (qp-seq-eq!)
  (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
    (fact 'nn-is-set) (fact 'qq-is-set)
    (qp-type! l) (qp-type! r)
    (dk-cite! 'qp-cs-fun 'p l) (dk-cite! 'qp-cs-fun 'p r)
    (dk-fun-ext! l r 'NN 'QQ (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!))
      (lambda (k)
        (qp-eval! l k) (qp-eval! r k)
        (if (dk-contains? (dk-goal) 'VNB-LAMBDA) (dk-lam-b!))
        (if (pair? (dk-open-leaves)) (crs))))
    (dk-close-if-asm!)))
(define (qp-law-leaf!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'AND) (for-each (lambda (l) (dk-focus! l) (qp-law-leaf!)) (dk-opened (lambda () (di)))))
          ((memq (dk-head g) '(FORALL IMPLIES)) (dk-peel!) (qp-law-leaf!))
          ((dk-head-is? g '=) (qp-seq-eq!))
          (#t (error "qp-law-leaf!: unexpected" g)))))
;; the ideal conjuncts
(define (qp-ideal-leaf!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'AND) (for-each (lambda (l) (dk-focus! l) (qp-ideal-leaf!)) (dk-opened (lambda () (di)))))
          ((dk-head-is? g 'SUBSET)
           (mac 'subset-def) (dk-peel!) (dk-cite! 'qp-null-cs 'p (cadr (dk-goal))) (dk-close-if-asm!))
          ((memq (dk-head g) '(FORALL IMPLIES)) (dk-peel!) (qp-ideal-leaf!))
          ((and (dk-head-is? g 'IN) (qp-op-app? (cadr g)))
           (let* ((t (cadr g)) (row (qp-op-app? t)) (op (car (car t))) (args (cdr t)))
             (for-each (lambda (a) (if (dk-asm? `(IN ,a (QP-NULL p))) (dk-cite! 'qp-null-cs 'p a))) args)
             (subst (apply dk-cite! (cadddr row) 'p args))
             (cond ((eq? op 'QP-SADD) (dk-cite! 'qp-null-add 'p (car args) (cadr args)))
                   ((eq? op 'QP-SNEG) (dk-cite! 'qp-null-neg 'p (car args)))
                   ((dk-asm? `(IN ,(cadr args) (QP-NULL p))) (dk-cite! 'qp-null-mul-left 'p (car args) (cadr args)))
                   (#t (dk-cite! 'qp-null-mul-right 'p (cadr args) (car args))))
             (dk-close-if-asm!)))
          ((equal? g '(IN (VNB-LAMBDA qsn_ NN 0) (QP-NULL p))) (dk-cite! 'qp-null-zero 'p) (dk-close-if-asm!))
          (#t (error "qp-ideal-leaf!: unexpected" g)))))

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (IS-RINGOID (QP-CSR p))))))
(dk-peel!)
(qp-setup!)
(for-each (lambda (n) (dk-cite! n 'p)) '(qp-cs-set qp-sadd-fun qp-smul-fun qp-sneg-fun qp-zero-cs qp-one-cs qp-null-power))
(mac 'IS-RINGOID)
(dk-isx-set!)   ; W1J-C: the conjunct t in SET, from the typings
(for-each mac '(qp-csr-carr qp-csr-add qp-csr-mul qp-csr-neg qp-csr-zero qp-csr-one qp-csr-idl))
(let split ((fuel 40))
  (let ((andl (find-first (lambda (s) (dk-head-is? (dk-goal-of s) 'AND)) (dk-open-leaves))))
    (when andl
      (if (= fuel 0) (error "qp: AND split did not terminate"))
      (dk-focus! andl) (di) (split (- fuel 1)))))
(for-each
  (lambda (l)
    (if (not (sequent-node-grounded? l))
        (begin
          (dk-focus! l)
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (dk-ass!))
                  ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH)) (mac 'QP-CSR) (len-r) (arith))
                  ((memq (dk-head g) '(is-associative is-commutative is-identity has-inverses is-distributive))
                   (mac (dk-head g)) (qp-law-leaf!))
                  ((dk-head-is? g 'is-ideal-in) (mac 'is-ideal-in) (qp-ideal-leaf!))
                  (#t (error "qp ringoid: unexpected conjunct" g)))))))
  (dk-open-leaves))
(qed 'qp-csr-is-ringoid)

;;; -----------------------------------------------------------------------
;;; 6. The quotient ring, and its setoid is the Cauchy setoid of the completion.

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (IS-RING (QP-RING p))))))
(dk-peel!)
(dk-cite! 'qp-csr-is-ringoid 'p)
(mac 'QP-RING)
(dk-cite! 'ringoid-quotient-is-ring '(QP-CSR p))
(dk-close-if-asm!)
(qed 'qp-ring-is-ring)

;; FROM-LAW (an eps-law over kb with a PADIC-ABS body) in context: prove TO-LAW.  EQS, a procedure of
;; the index k, lands the equations and returns the (FROM TO) rewrites taking FROM's body to TO's.
(define (qp-law-conv! from-law to-law eqs)
  (dk-have! to-law
    (lambda ()
      (let* ((landed (dk-landed (lambda () (dk-peel!))))
             (ep (cadr (find-first (lambda (x) (dk-head-is? x 'POS-RR)) landed)))
             (nn (dk-skolem! (dk-apply! from-law ep)))
             (lw (qp-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x nn) (dk-contains? x 'PADIC-ABS))) "the law")))
        (ew nn)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (let* ((landed2 (dk-landed (lambda () (dk-peel!))))
                       (k (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) landed2)))
                       (h (dk-chain-ass! (dk-apply! lw k))))
                  (let loop ((h h) (rs (eqs k)))
                    (if (null? rs)
                        (dk-close-if-asm!)
                        (loop (dk-rewrite-h! h (car (car rs)) (cadr (car rs))) (cdr rs))))))))))))

;; a - b is null iff a and b are equivalent
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL a (IMPLIES (IN a (QP-CS p)) (FORALL b (IMPLIES (IN b (QP-CS p))
  (IFF (IN ((QP-SADD p) a ((QP-SNEG p) b)) (QP-NULL p)) (CSEQ-EQUIV ,qm a b))))))))))
(dk-peel!)
(qp-cs! 'a) (qp-cs! 'b)
(let* ((nb '((QP-SNEG p) b)) (h `((QP-SADD p) a ,nb))
       (eqs-fwd (lambda (k)
                  (dk-cite! 'qp-sadd-at 'p 'a nb k) (dk-cite! 'qp-sneg-at 'p 'b k)
                  (list (list `(,h ,k) `(+ (a ,k) (,nb ,k))) (list `(,nb ,k) `(- (b ,k))))))
       (eqs-bwd (lambda (k)
                  (dk-cite! 'qp-sadd-at 'p 'a nb k) (dk-cite! 'qp-sneg-at 'p 'b k)
                  (list (list `(- (b ,k)) `(,nb ,k)) (list `(+ (a ,k) (,nb ,k)) `(,h ,k))))))
  (qp-type! h)
  (qp-cs! h)
  (dk-iff! (lambda (g) (dk-head-is? g 'CSEQ-EQUIV))
    (lambda ()
      (dk-iff-fwd! (dk-cite! 'qp-null-member-iff 'p h))
      (qp-law-conv! (qp-small0-law h) (qp-small-law 'a 'b) eqs-fwd)
      (dk-chain-ass! (dk-cite! 'qp-equiv-intro 'p 'a 'b))
      (dk-close-if-asm!))
    (lambda ()
      (dk-chain-ass! (dk-cite! 'qp-equiv-elim 'p 'a 'b))
      (qp-law-conv! (qp-small-law 'a 'b) (qp-small0-law h) eqs-bwd)
      (dk-have-and! `(IS-CAUCHY-SEQ ,qm ,h) (qp-small0-law h))
      (dk-iff-bwd! (dk-cite! 'qp-null-member-iff 'p h))
      (dk-close-if-asm!))))
(qed 'qp-diff-null-iff)

;; CSEQ(M) is QP-CS
(sp (make-wff `(FORALL p (== (QP-CS p) (CSEQ ,qm)))))
(dk-peel!) (mac 'QP-CS) (qrfl)
(qed 'qp-cs-cseq)

;; the congruence of the ringoid is the Cauchy relation
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (= (RINGOID-REL (QP-CSR p)) (CREL ,qm))))))
(dk-peel!)
(qp-setup!)
(mac 'RINGOID-REL)
(for-each mac '(qp-csr-carr qp-csr-add qp-csr-neg qp-csr-idl))
(mac 'CREL)
(dk-cite! 'qp-cs-cseq 'p)
(subst `(= (CSEQ ,qm) (QP-CS p)))
(let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)) (ch (dk-cite! 'class-extensionality l r)))
  (dk-have! (cadr ch)
    (lambda ()
      (dk-peel!)
      (let* ((z (cadr (cadr (dk-goal))))
             (n1 `(NTH 1 ,z)) (n2 `(NTH 2 ,z))
             (parts! (lambda (m)
                       (dk-sep-parts! m)
                       (dk-split-all! (list (dk-cite! 'cartesian-nth z '(QP-CS p) '(QP-CS p)))))))
        (dk-iff! (lambda (g) (equal? (caddr g) r))
          (lambda ()
            (parts! `(IN ,z ,l))
            (dk-iff-fwd! (dk-cite! 'qp-diff-null-iff 'p n1 n2))
            (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!))))
          (lambda ()
            (parts! `(IN ,z ,r))
            (dk-iff-bwd! (dk-cite! 'qp-diff-null-iff 'p n1 n2))
            (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!))))))))
  (detach! ch)
  (dk-close-if-asm!))
(qed 'qp-rel-eq)

;; the setoid of the ringoid is the Cauchy setoid of M
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (== (RINGOID-SETOID (QP-CSR p)) (CAUCHY-SETOID ,qm))))))
(dk-peel!)
(dk-cite! 'qp-rel-eq 'p)
(dk-cite! 'qp-cs-cseq 'p)
(mac 'RINGOID-SETOID) (mac 'CAUCHY-SETOID) (mac 'qp-csr-carr)
(subst `(= (RINGOID-REL (QP-CSR p)) (CREL ,qm)))
(subst `(= (QP-CS p) (CSEQ ,qm)))
(qrfl)
(qed 'qp-setoid-eq)

;; multiplication of Cauchy sequences commutes
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL u (IMPLIES (IN u (QP-CS p)) (FORALL v (IMPLIES (IN v (QP-CS p))
  (= ((QP-SMUL p) u v) ((QP-SMUL p) v u))))))))))
(dk-peel!)
(qp-setup!)
(qp-seq-eq!)
(qed 'qp-smul-comm)

;; a point of the quotient ring: land its representative X in QP-CS with A = CLASS(RS, X); return X
(define qp-rs '(RINGOID-SETOID (QP-CSR p)))
(define qp-rqr '(RINGOID-QUOTIENT-RING (QP-CSR p)))
(define (qp-rep! a)
  (dk-cite! 'qp-csr-is-ringoid 'p)
  (dk-cite! 'ringoid-setoid-is-setoid '(QP-CSR p))
  (dk-cite! 'rq-carr '(QP-CSR p))
  (dk-cite! 'ringoid-setoid-pts '(QP-CSR p))
  (dk-cite! 'qp-csr-carr 'p)
  (if (not (dk-asm? `(IN ,a (QUOTIENT ,qp-rs))))
      (dk-rewrite-h! `(IN ,a (CARR ,qp-rqr)) `(CARR ,qp-rqr) `(QUOTIENT ,qp-rs)))
  (let* ((x (dk-skolem! (dk-cite! 'quotient-rep qp-rs a))))
    (dk-rewrite-h! `(IN ,x (PTS ,qp-rs)) `(PTS ,qp-rs) '(CARR (QP-CSR p)))
    (dk-rewrite-h! `(IN ,x (CARR (QP-CSR p))) '(CARR (QP-CSR p)) '(QP-CS p))
    x))

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (IS-COMMUTATIVE-RING (QP-RING p))))))
(dk-peel!)
(dk-cite! 'qp-ring-is-ring 'p)
(mac 'IS-COMMUTATIVE-RING)
(mac 'QP-RING)
(dk-cite! 'qp-csr-is-ringoid 'p)
(dk-cite! 'ringoid-quotient-is-ring '(QP-CSR p))
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed)))
               (a (car vs)) (b (cadr vs))
               (x (qp-rep! a)) (y (qp-rep! b)))
          (subst `(= ,a (CLASS ,qp-rs ,x)))
          (subst `(= ,b (CLASS ,qp-rs ,y)))
          (subst (dk-cite! 'rq-mul-computes '(QP-CSR p) x y))
          (subst (dk-cite! 'rq-mul-computes '(QP-CSR p) y x))
          (mac 'qp-csr-mul)
          (qp-type! `((QP-SMUL p) ,x ,y)) (qp-type! `((QP-SMUL p) ,y ,x))
          (subst (dk-cite! 'qp-smul-comm 'p x y))
          (qp-rfl!)))))
(qed 'qp-ring-is-commutative)

;;; -----------------------------------------------------------------------
;;; 7. The absolute value of Q_p: |[x]| is the limit of |x_k|_p, eventually constant unless x is null.

(define qs `(CAUCHY-SETOID ,qm))
(define (qp-comp-setup!)
  (qp-setup!)
  (qp-or-asm `(IS-SETOID ,qs) (lambda () (dk-cite! 'cauchy-setoid-is-setoid qm)))
  (qp-or-asm `(== (PTS ,qs) (CSEQ ,qm)) (lambda () (dk-cite! 'rkt-cauchy-setoid-pts qm)))
  (qp-or-asm `(== (QP-CS p) (CSEQ ,qm)) (lambda () (dk-cite! 'qp-cs-cseq 'p))))
;; X in QP-CS in context: land X in CSEQ(M), in PTS(S), and its class in QUOTIENT(S); return the class
(define (qp-class! x)
  (qp-comp-setup!)
  (qp-or-asm `(IN ,x (CSEQ ,qm)) (lambda () (dk-rewrite-h! `(IN ,x (QP-CS p)) '(QP-CS p) `(CSEQ ,qm))))
  (qp-or-asm `(IN ,x (PTS ,qs)) (lambda () (dk-rewrite-h! `(IN ,x (CSEQ ,qm)) `(CSEQ ,qm) `(PTS ,qs))))
  (qp-or-asm `(IN (CLASS ,qs ,x) (QUOTIENT ,qs)) (lambda () (dk-cite! 'class-in-quotient qs x)))
  `(CLASS ,qs ,x))
(define (qp-abs-seq x) `(VNB-LAMBDA qsn_ NN ((PADIC-ABS p) (,x qsn_))))
;; X in FUN(NN, QQ) in context: land |X| in FUN(NN, RR)
(define (qp-abs-seq-type! x)
  (let ((a (qp-abs-seq x)))
    (fact 'nn-is-set)
    (qp-or-asm `(IN ,a (FUN NN RR))
      (lambda ()
        (dk-have! `(IN ,a (FUN NN RR))
          (lambda ()
            (dk-each-leaf! (lambda () (lam-t))
              (lambda ()
                (if (dk-head-is? (dk-goal) 'FORALL)
                    (let* ((landed (dk-landed (lambda () (dk-peel!))))
                           (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))))
                      (qp-at! x k) (dk-close-if-asm!))
                    (dk-close-if-asm!))))))))
    a))
;; goal (<= (abs (- T L)) EP): with L = 0 (T >= 0 and T <= EP in context) or L = T' = T (rewritten first)
(define (qp-abs-minus-zero! t)
  (dk-have! `(= (- ,t 0) ,t) (lambda () (subst (dk-cite! 'binary-minus-def t 0)) (crs)))
  (subst `(= (- ,t 0) ,t))
  (subst (dk-cite! 'rr-abs-of-nonneg t))
  (dk-close-if-asm!))
(define (qp-abs-minus-self! c ep)
  (dk-have! `(= (- ,c ,c) 0) (lambda () (subst (dk-cite! 'binary-minus-def c c)) (crs)))
  (subst `(= (- ,c ,c) 0))
  (fact 'rr-abs-zero-value)
  (subst '(= (abs 0) 0))
  (dk-cite! 'rr-lt-of-pos-rr ep) (dk-cite! 'rr-pos-rr-in-rr ep)
  (dk-ineq! `(< 0 ,ep)))

;; |[x]| is the limit of |x_k|_p
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (QP-CS p)) (FORALL lv (IMPLIES (IN lv RR)
  (IMPLIES (CONVERGES-TO RR-MS ,(qp-abs-seq 'x) lv) (= ((QP-ABS p) (CLASS ,qs x)) lv))))))))))
(dk-peel!)
(qp-cs! 'x) (qp-class! 'x)
(dk-cite! 'qp-zero-cs 'p) (qp-cs! qz) (qp-class! qz)
(qp-abs-seq-type! 'x)
(fact 'qq-zero-in)
(let ((ds `(DIST-SEQ ,qm x ,qz)) (a (qp-abs-seq 'x)))
  (dk-chain-ass! (dk-cite! 'rko2-dist-seq-type qm 'x qz))
  (dk-have! `(FORALL j_ (IMPLIES (IN j_ NN) (= (,ds j_) (,a j_))))
    (lambda ()
      (let* ((landed (dk-landed (lambda () (dk-peel!))))
             (j (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed)))
             (xj (qp-at! 'x j)))
        (subst (dk-cite! 'rko2-dist-seq-at qm 'x qz j))
        (dk-have! `(= (,qz ,j) 0) (lambda () (dk-lam-b!) (qp-rfl!)))
        (subst `(= (,qz ,j) 0))
        (dk-lam-b!)
        (subst (dk-cite! 'pc-dist 'p xj 0))
        (dk-have! `(= (+ ,xj (- 0)) ,xj) (lambda () (crs)))
        (subst `(= (+ ,xj (- 0)) ,xj))
        (qp-rfl!))))
  (dk-chain-ass! (dk-cite! 'rr-limit-ptwise-eq a ds 'lv))
  (dk-chain-ass! (dk-cite! 'r7q-dist-value qm 'x qz 'lv))
  (mac 'QP-ABS)
  (dk-lam-b!)
  (dk-close-if-asm!))
(qed 'qp-abs-limit)

;; the eps-lane of rr-converges-to-abs for |X| at LV: BODY gets eps, must exhibit the index and close
(define (qp-abs-converges! x lv body)
  (let* ((a (qp-abs-seq x)) (ch (dk-cite! 'rr-converges-to-abs a lv)))
    (dk-have! (cadr ch)
      (lambda ()
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (ep (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) landed))))
          (body ep))))
    (detach! ch)))
;; inside that lane, after (ew N): the conjuncts; STEP gets the index k (typed, past N)
(define (qp-past-close! step)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((landed (dk-landed (lambda () (dk-peel!))))
                 (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))))
            (step k))))))

;; a null sequence has absolute value 0
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (QP-NULL p)) (= ((QP-ABS p) (CLASS ,qs x)) 0)))))))
(dk-peel!)
(let ((law (qp-null-open! 'x)))
  (dk-cite! 'qp-null-cs 'p 'x)
  (qp-abs-seq-type! 'x)
  (fact 'rr-zero-in)
  (qp-abs-converges! 'x 0
    (lambda (ep)
      (let ((na (qp-small-at! law ep)))
        (ew (car na))
        (qp-past-close!
          (lambda (k)
            (let ((xk (qp-at! 'x k)))
              (dk-chain-ass! (dk-apply! (cdr na) k))
              (dk-lam-b!)
              (qp-abs-minus-zero! (qp-a xk))))))))
  (dk-chain-ass! (dk-cite! 'qp-abs-limit 'p 'x 0))
  (dk-close-if-asm!))
(qed 'qp-abs-null)

;; an eventually constant |x_k| = c gives |[x]| = c
(define (qp-const-law x nc c) `(FORALL k (IMPLIES (IN k NN) (IMPLIES (<= ,nc k) (= ((PADIC-ABS p) (,x k)) ,c)))))
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (QP-CS p)) (FORALL nc (IMPLIES (IN nc NN)
  (FORALL c (IMPLIES (IN c RR) (IMPLIES ,(qp-const-law 'x 'nc 'c) (= ((QP-ABS p) (CLASS ,qs x)) c))))))))))))
(dk-peel!)
(qp-cs! 'x)
(qp-abs-seq-type! 'x)
(let ((law (qp-const-law 'x 'nc 'c)))
  (qp-abs-converges! 'x 'c
    (lambda (ep)
      (ew 'nc)
      (qp-past-close!
        (lambda (k)
          (let ((xk (qp-at! 'x k)))
            (dk-chain-ass! (dk-apply! law k))
            (dk-lam-b!)
            (subst `(= ,(qp-a xk) c))
            (qp-abs-minus-self! 'c ep))))))
  (dk-chain-ass! (dk-cite! 'qp-abs-limit 'p 'x 'c))
  (dk-close-if-asm!))
(qed 'qp-abs-const)

;; a Cauchy sequence that is not null has eventually constant, positive |x_k|_p
(define (qp-evc x) `(FORSOME nc (AND (IN nc NN) (FORSOME c (AND (IN c RR) (AND (< 0 c) ,(qp-const-law x 'nc 'c)))))))
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (QP-CS p)) (IMPLIES (NOT (IN x (QP-NULL p))) ,(qp-evc 'x))))))))
(dk-peel!)
(qp-cs! 'x)
(pbc)
(let ((cl (dk-chain-ass! (dk-cite! 'qp-cauchy-elim 'p 'x))))
  (dk-have! (qp-small0-law 'x)
    (lambda ()
      (let* ((landed (dk-landed (lambda () (dk-peel!))))
             (ep (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) landed)))
             (d (dk-halve! ep))
             (nn (dk-skolem! (dk-apply! cl d)))
             (lw (qp-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nn) (dk-contains? h 'PADIC-ABS))) "the Cauchy law")))
        (dk-cite! 'rr-pos-rr-in-rr ep) (dk-cite! 'rr-lt-of-pos-rr ep)
        (ew nn)
        (qp-past-close!
          (lambda (k)
            (let* ((xk (qp-at! 'x k)) (ak (qp-a xk)))
              (pbc)
              (dk-chain-ass! (dk-cite! 'rr-not-le-lt ak ep))
              (dk-have! (qp-evc 'x)
                (lambda ()
                  (ew nn)
                  (dk-conj-close!
                    (lambda ()
                      (if (not (dk-ass!))
                          (begin
                            (ew ak)
                            (dk-conj-close!
                              (lambda ()
                                (cond ((dk-ass!) #t)
                                      ((dk-head-is? (dk-goal) '<) (dk-ineq! `(< ,ep ,ak) `(< 0 ,ep)))
                                      (#t
                                       (let* ((landed2 (dk-landed (lambda () (dk-peel!))))
                                              (m (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed2)))
                                              (xm (qp-at! 'x m)))
                                         (dk-chain-ass! (dk-apply! lw k m))
                                         (qp-qq-sub! xk xm)
                                         (dk-have! `(< ,(qp-a `(+ ,xk (- ,xm))) ,ak)
                                           (lambda () (dk-ineq! `(<= ,(qp-a `(+ ,xk (- ,xm))) ,d) `(= (+ ,d ,d) ,ep) `(< 0 ,d) `(< ,ep ,ak))))
                                         (dk-chain-ass! (dk-cite! 'qp-isosceles 'p xk xm))
                                         (dk-close-if-asm!))))))))))))
              (ai `(NOT ,(qp-evc 'x)))))))))
  (dk-have-and! `(IS-CAUCHY-SEQ ,qm x) (qp-small0-law 'x))
  (dk-iff-bwd! (dk-cite! 'qp-null-member-iff 'p 'x))
  (ai '(NOT (IN x (QP-NULL p)))))
(qed 'qp-eventually-const)

;;; -----------------------------------------------------------------------
;;; 8. The ring Q_p on the classes of the Cauchy setoid.

(define q1 '(VNB-LAMBDA qsn_ NN 1))
(define qr '(QP-RING p))
;; land RS == S and IS-RING / the unfolded ring
(define (qp-ring-setup!)
  (qp-comp-setup!)
  (qp-or-asm `(IS-RING ,qr) (lambda () (dk-cite! 'qp-ring-is-ring 'p)))
  (qp-or-asm `(== ,qp-rs ,qs) (lambda () (dk-cite! 'qp-setoid-eq 'p))))
;; goal mentions QP-RING and CLASS(S, -): unfold to the ringoid quotient over RS
(define (qp-to-rs!)
  (qp-ring-setup!)
  (mac 'QP-RING)
  (if (dk-contains? (dk-goal) qs) (subst `(== ,qs ,qp-rs))))
(define (qp-csr-typed! x)
  (dk-cite! 'qp-csr-carr 'p)
  (qp-or-asm `(IN ,x (CARR (QP-CSR p))) (lambda () (dk-rewrite-h! `(IN ,x (QP-CS p)) '(QP-CS p) '(CARR (QP-CSR p))))))

(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (== (CARR ,qr) (QUOTIENT ,qs))))))
(dk-peel!)
(qp-to-rs!)
(mac 'rq-carr)
(qrfl)
(qed 'qp-carr)

(define (qp-op-class! name acc args sop computes readoff)
  (dk-sp-qed! (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p)
     ,(let wrap ((as args))
        (if (null? as)
            `(= ((,acc ,qr) ,@(map (lambda (a) `(CLASS ,qs ,a)) args)) (CLASS ,qs ((,sop p) ,@args)))
            `(FORALL ,(car as) (IMPLIES (IN ,(car as) (QP-CS p)) ,(wrap (cdr as)))))))))
  (lambda ()
  (dk-peel!)
  (qp-setup!)
  (for-each qp-csr-typed! args)
  (qp-type! `((,sop p) ,@args))
  (qp-csr-typed! `((,sop p) ,@args))
  (qp-to-rs!)
  (dk-cite! 'qp-csr-is-ringoid 'p)
  (subst (apply dk-cite! computes '(QP-CSR p) args))
  (mac readoff)
  (qp-rfl!)
  )
  name))
(qp-op-class! 'qp-add-class 'ADD '(x y) 'QP-SADD 'rq-add-computes 'qp-csr-add)
(qp-op-class! 'qp-mul-class 'MUL '(x y) 'QP-SMUL 'rq-mul-computes 'qp-csr-mul)
(qp-op-class! 'qp-neg-class 'NEG '(x) 'QP-SNEG 'rq-neg-computes 'qp-csr-neg)

(define (qp-const-class! name acc rq readoff c)
  (dk-sp-qed! (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (= (,acc ,qr) (CLASS ,qs ,c)))))
  (lambda ()
  (dk-peel!)
  (qp-type! c)
  (qp-to-rs!)
  (mac rq)
  (mac readoff)
  (qp-rfl!)
  )
  name))
(qp-const-class! 'qp-zero-class 'ZERO 'rq-zero 'qp-csr-zero qz)
(qp-const-class! 'qp-one-class 'ONE 'rq-one 'qp-csr-one q1)

;; every point of Q_p is the class of a Cauchy sequence
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL a (IMPLIES (IN a (QUOTIENT ,qs))
  (FORSOME x (AND (IN x (QP-CS p)) (= a (CLASS ,qs x))))))))))
(dk-peel!)
(qp-comp-setup!)
(let ((x (dk-skolem! (dk-cite! 'quotient-rep qs 'a))))
  (dk-rewrite-h! `(IN ,x (PTS ,qs)) `(PTS ,qs) `(CSEQ ,qm))
  (dk-rewrite-h! `(IN ,x (CSEQ ,qm)) `(CSEQ ,qm) '(QP-CS p))
  (ew x)
  (dk-conj-close! dk-ass!))
(qed 'qp-rep)

;; a class is zero iff its representative is null
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (QP-CS p))
  (IFF (= (CLASS ,qs x) (CLASS ,qs ,qz)) (IN x (QP-NULL p)))))))))
(dk-peel!)
(qp-cs! 'x) (qp-class! 'x)
(dk-cite! 'qp-zero-cs 'p) (qp-cs! qz) (qp-class! qz)
(dk-cite! 'rko2-cauchy-setoid-rel qm)
(let* ((iff0 (dk-cite! 'class-eq-iff qs 'x qz))
       (unf (dk-cite! 'rko2-related-unfold qs 'x qz))
       (inrel `(IN (LIST x ,qz) (REL ,qs))) (increl `(IN (LIST x ,qz) (CREL ,qm))))
  (dk-iff! (lambda (g) (dk-head-is? g 'IN))
    (lambda ()
      (dk-iff-fwd! iff0)
      (dk-iff-fwd! unf)
      (dk-rewrite-h! inrel `(REL ,qs) `(CREL ,qm))
      (dk-chain-ass! (dk-cite! 'rko2-crel-elim qm 'x qz))
      (dk-iff-fwd! (dk-cite! 'qp-null-iff 'p 'x))
      (dk-have-and! `(IS-CAUCHY-SEQ ,qm x) (qp-small0-law 'x))
      (dk-iff-bwd! (dk-cite! 'qp-null-member-iff 'p 'x))
      (dk-close-if-asm!))
    (lambda ()
      (dk-iff-fwd! (dk-cite! 'qp-null-member-iff 'p 'x))
      (dk-iff-bwd! (dk-cite! 'qp-null-iff 'p 'x))
      (dk-chain-ass! (dk-cite! 'rko2-crel-intro qm 'x qz))
      (dk-rewrite-h! increl `(CREL ,qm) `(REL ,qs))
      (dk-iff-bwd! unf)
      (dk-iff-bwd! iff0)
      (dk-close-if-asm!))))
(qed 'qp-class-zero-iff)

;;; -----------------------------------------------------------------------
;;; 9. The laws of |.| on Q_p, on classes.

(define (qp-ab x) `((QP-ABS p) (CLASS ,qs ,x)))
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (IN (QP-ABS p) (FUN (QUOTIENT ,qs) RR))))))
(dk-peel!)
(qp-comp-setup!)
(dk-cite! 'completion-is-metric-space qm)
(dk-cite! 'rkt-completion-pts qm)
(dk-cite! 'qp-zero-cs 'p) (qp-cs! qz) (qp-class! qz)
(dk-cite! 'quotient-is-set qs)
(mac 'QP-ABS)
(dk-each-leaf! (lambda () (lam-t))
  (lambda ()
    (if (dk-head-is? (dk-goal) 'FORALL)
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (z (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
          (dk-rewrite-h! `(IN ,z (QUOTIENT ,qs)) `(QUOTIENT ,qs) `(PTS (COMPLETION ,qm)))
          (dk-rewrite-h! `(IN (CLASS ,qs ,qz) (QUOTIENT ,qs)) `(QUOTIENT ,qs) `(PTS (COMPLETION ,qm)))
          (dk-cite! 'metric-dist-real `(COMPLETION ,qm) z `(CLASS ,qs ,qz))
          (dk-close-if-asm!))
        (dk-close-if-asm!))))
(qed 'qp-abs-fun)

;; X in QP-CS: land |[X]| in RR
(define (qp-ab! x)
  (qp-cs! x) (qp-class! x)
  (dk-cite! 'qp-abs-fun 'p)
  (qp-or-asm `(IN ,(qp-ab x) RR)
    (lambda () (dk-have-and! `(IN (QP-ABS p) (FUN (QUOTIENT ,qs) RR)) `(IN (CLASS ,qs ,x) (QUOTIENT ,qs)))
               (dk-cite! 'fun-apply-type '(QP-ABS p) `(QUOTIENT ,qs) 'RR `(CLASS ,qs ,x))))
  (qp-ab x))
;; X in QP-CS, not null, in context: land |X_k| = c from nc on, 0 < c, |[X]| = c; return (nc c law)
(define (qp-evc! x)
  (let* ((ev (dk-chain-ass! (dk-cite! 'qp-eventually-const 'p x)))
         (nc (dk-skolem! ev))
         (ex (qp-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f nc) (dk-contains? f 'PADIC-ABS))) "the constant"))
         (c (dk-skolem! ex))
         (law (qp-const-law x nc c)))
    (if (not (dk-asm? law)) (dk-split-all!))
    (if (not (dk-asm? law)) (error "qp-evc!: the law did not land" law))
    (dk-chain-ass! (dk-cite! 'qp-abs-const 'p x nc c))
    (list nc c law)))
;; K in NN past NC1 + ... : land (<= nci k) for each
(define (qp-past-sum! k ncs)
  (for-each (lambda (v) (dk-cite! 'nn-in-rr v) (dk-cite! 'nn-zero-le v)) (cons k ncs))
  (let ((tot (let lp ((l ncs)) (if (null? (cdr l)) (car l) `(+ ,(car l) ,(lp (cdr l)))))))
    (for-each (lambda (v) (if (not (dk-asm? `(<= ,v ,k)))
                              (dk-have! `(<= ,v ,k) (lambda () (apply dk-ineq! `(<= ,tot ,k) (map (lambda (w) `(<= 0 ,w)) ncs))))))
              ncs)))

;; |[x]| >= 0
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (QP-CS p)) (<= 0 ,(qp-ab 'x))))))))
(dk-peel!)
(qp-ab! 'x)
(use-em '(IN x (QP-NULL p))
  (lambda () (dk-cite! 'qp-abs-null 'p 'x) (dk-ineq! `(= ,(qp-ab 'x) 0)))
  (lambda () (let ((e (qp-evc! 'x))) (dk-ineq! `(= ,(qp-ab 'x) ,(cadr e)) `(< 0 ,(cadr e))))))
(qed 'qp-abs-nonneg)

;; |[x]| = 0 iff x is null
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (QP-CS p)) (IFF (= ,(qp-ab 'x) 0) (IN x (QP-NULL p)))))))))
(dk-peel!)
(qp-ab! 'x)
(dk-iff! (lambda (g) (dk-head-is? g 'IN))
  (lambda ()
    (use-em '(IN x (QP-NULL p))
      (lambda () (dk-ass!))
      (lambda () (let ((e (qp-evc! 'x))) (dk-absurd! `(= ,(qp-ab 'x) ,(cadr e)) `(< 0 ,(cadr e)) `(= ,(qp-ab 'x) 0))))))
  (lambda () (dk-cite! 'qp-abs-null 'p 'x) (dk-close-if-asm!)))
(qed 'qp-abs-zero-iff)

;; |[x y]| = |[x]| |[y]|
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (QP-CS p)) (FORALL y (IMPLIES (IN y (QP-CS p))
  (= ,(qp-ab '((QP-SMUL p) x y)) (* ,(qp-ab 'x) ,(qp-ab 'y)))))))))))
(dk-peel!)
(qp-setup!)
(let* ((xy '((QP-SMUL p) x y)) (vl (dk-cite! 'qp-smul-value 'p 'x 'y)) (lam (caddr vl)))
  (qp-type! xy)
  (qp-ab! 'x) (qp-ab! 'y) (qp-ab! xy)
  (let ((null-case (lambda (z other cite)
                     (cite)
                     (dk-rewrite-h! `(IN ,lam (QP-NULL p)) lam xy)
                     (dk-cite! 'qp-abs-null 'p xy) (dk-cite! 'qp-abs-null 'p z)
                     (subst `(= ,(qp-ab xy) 0)) (subst `(= ,(qp-ab z) 0))
                     (crs))))
    (use-em '(IN x (QP-NULL p))
      (lambda () (null-case 'x 'y (lambda () (dk-cite! 'qp-null-mul-right 'p 'y 'x))))
      (lambda ()
        (use-em '(IN y (QP-NULL p))
          (lambda () (null-case 'y 'x (lambda () (dk-cite! 'qp-null-mul-left 'p 'x 'y))))
          (lambda ()
            (let* ((ex (qp-evc! 'x)) (ey (qp-evc! 'y))
                   (nx (car ex)) (cx (cadr ex)) (ny (car ey)) (cy (cadr ey))
                   (n `(+ ,nx ,ny)) (c `(* ,cx ,cy)))
              (dk-have-and! `(IN ,nx NN) `(IN ,ny NN)) (dk-cite! 'nn-add-closed nx ny)
              (dk-rr-mul! cx cy)
              (dk-have! (qp-const-law xy n c)
                (lambda ()
                  (let* ((landed (dk-landed (lambda () (dk-peel!))))
                         (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed)))
                         (xk (qp-at! 'x k)) (yk (qp-at! 'y k)))
                    (qp-past-sum! k (list nx ny))
                    (dk-chain-ass! (dk-apply! (caddr ex) k)) (dk-chain-ass! (dk-apply! (caddr ey) k))
                    (subst (dk-cite! 'qp-smul-at 'p 'x 'y k))
                    (subst (dk-cite! 'pz-abs-mul 'p xk yk))
                    (subst `(= ,(qp-a xk) ,cx)) (subst `(= ,(qp-a yk) ,cy))
                    (qp-rfl!))))
              (dk-chain-ass! (dk-cite! 'qp-abs-const 'p xy n c))
              (subst `(= ,(qp-ab xy) ,c)) (subst `(= ,(qp-ab 'x) ,cx)) (subst `(= ,(qp-ab 'y) ,cy))
              (qp-rfl!))))))))
(qed 'qp-abs-mul)

;; classes of sequences whose difference is null are equal
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL a (IMPLIES (IN a (QP-CS p)) (FORALL b (IMPLIES (IN b (QP-CS p))
  (IMPLIES (IN ((QP-SADD p) a ((QP-SNEG p) b)) (QP-NULL p)) (= (CLASS ,qs a) (CLASS ,qs b)))))))))))
(dk-peel!)
(qp-cs! 'a) (qp-cs! 'b) (qp-class! 'a) (qp-class! 'b)
(dk-cite! 'rko2-cauchy-setoid-rel qm)
(dk-iff-fwd! (dk-cite! 'qp-diff-null-iff 'p 'a 'b))
(dk-chain-ass! (dk-cite! 'rko2-crel-intro qm 'a 'b))
(dk-rewrite-h! `(IN (LIST a b) (CREL ,qm)) `(CREL ,qm) `(REL ,qs))
(dk-iff-bwd! (dk-cite! 'rko2-related-unfold qs 'a 'b))
(dk-iff-bwd! (dk-cite! 'class-eq-iff qs 'a 'b))
(dk-close-if-asm!)
(qed 'qp-class-eq-intro)

;; the ultrametric inequality |[x + y]| <= max(|[x]|, |[y]|)
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (QP-CS p)) (FORALL y (IMPLIES (IN y (QP-CS p))
  (<= ,(qp-ab '((QP-SADD p) x y)) (MAX ,(qp-ab 'x) ,(qp-ab 'y)))))))))))
(dk-peel!)
(qp-setup!)
(let* ((s '((QP-SADD p) x y)) (ax (qp-ab 'x)) (ay (qp-ab 'y)) (as (qp-ab s)))
  (qp-type! s)
  (qp-ab! 'x) (qp-ab! 'y) (qp-ab! s)
  (dk-cite! 'rr-max-closed ax ay)
  (dk-cite! 'rr-le-max-left ax ay) (dk-cite! 'rr-le-max-right ax ay)
  (let ((null-case (lambda (z other)
                     ;; z null: s - other = z, so [s] = [other]
                     (let ((d `((QP-SADD p) ,s ((QP-SNEG p) ,other))))
                       (qp-type! d)
                       (dk-have! `(= ,d ,z) (lambda () (qp-seq-eq!)))
                       (dk-have! `(IN ,d (QP-NULL p)) (lambda () (subst `(= ,d ,z)) (dk-close-if-asm!)))
                       (dk-chain-ass! (dk-cite! 'qp-class-eq-intro 'p s other))
                       (subst `(= (CLASS ,qs ,s) (CLASS ,qs ,other)))
                       (dk-close-if-asm!)))))
    (use-em '(IN x (QP-NULL p))
      (lambda () (null-case 'x 'y))
      (lambda ()
        (use-em '(IN y (QP-NULL p))
          (lambda () (null-case 'y 'x))
          (lambda ()
            (let ((ex (qp-evc! 'x)) (ey 'later))
              (set! ey (qp-evc! 'y))
              (use-em `(IN ,s (QP-NULL p))
                (lambda ()
                  (dk-cite! 'qp-abs-null 'p s)
                  (dk-ineq! `(= ,as 0) `(= ,ax ,(cadr ex)) `(< 0 ,(cadr ex)) `(<= ,ax (MAX ,ax ,ay))))
                (lambda ()
                  (let* ((es (qp-evc! s))
                         (nx (car ex)) (ny (car ey)) (ns (car es))
                         (k `(+ ,nx (+ ,ny ,ns))))
                    (dk-have-and! `(IN ,ny NN) `(IN ,ns NN)) (dk-cite! 'nn-add-closed ny ns)
                    (dk-have-and! `(IN ,nx NN) `(IN (+ ,ny ,ns) NN)) (dk-cite! 'nn-add-closed nx `(+ ,ny ,ns))
                    (dk-cite! 'nn-le-refl k)
                    (qp-past-sum! k (list nx ny ns))
                    (let* ((xk (qp-at! 'x k)) (yk (qp-at! 'y k)))
                      (dk-chain-ass! (dk-apply! (caddr ex) k)) (dk-chain-ass! (dk-apply! (caddr ey) k))
                      (dk-chain-ass! (dk-apply! (caddr es) k))
                      (dk-cite! 'qp-sadd-at 'p 'x 'y k)
                      (let* ((h0 (dk-cite! 'pz-abs-ultra 'p xk yk))
                             (h1 (dk-rewrite-h! h0 `(+ ,xk ,yk) `(,s ,k)))
                             (h2 (dk-rewrite-h! h1 (qp-a `(,s ,k)) (cadr es)))
                             (h3 (dk-rewrite-h! h2 (qp-a xk) (cadr ex)))
                             (h4 (dk-rewrite-h! h3 (qp-a yk) (cadr ey))))
                        (subst `(= ,as ,(cadr es))) (subst `(= ,ax ,(cadr ex))) (subst `(= ,ay ,(cadr ey)))
                        (dk-close-if-asm!)))))))))))))
(qed 'qp-abs-ultra)

;; 0 /= 1 in Q_p
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (NOT (= (CLASS ,qs ,qz) (CLASS ,qs ,q1)))))))
(dk-peel!)
(qp-setup!)
(dk-cite! 'qp-zero-cs 'p) (dk-cite! 'qp-one-cs 'p) (dk-cite! 'qp-null-zero 'p)
(qp-ab! qz) (qp-ab! q1)
(dk-cite! 'qp-abs-null 'p qz)
(fact 'nn-zero-in) (fact 'rr-one-in) (fact 'qq-one-in)
(dk-cite! 'pc-abs-one 'p)
(dk-have! (qp-const-law q1 0 1)
  (lambda ()
    (dk-peel!)
    (dk-lam-b!)
    (dk-close-if-asm!)))
(dk-chain-ass! (dk-cite! 'qp-abs-const 'p q1 0 1))
(di)
(dk-rewrite-h! `(= ,(qp-ab q1) 1) `(CLASS ,qs ,q1) `(CLASS ,qs ,qz))
(dk-absurd! `(= ,(qp-ab qz) 1) `(= ,(qp-ab qz) 0))
(qed 'qp-zero-ne-one)

;;; -----------------------------------------------------------------------
;;; 10. Inverses: a Cauchy sequence that is not null has a Cauchy inverse modulo null sequences.

(define qp-inv-target
  (lambda (x y) `((QP-SADD p) ((QP-SMUL p) ,x ,y) ((QP-SNEG p) ,q1))))
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL x (IMPLIES (IN x (QP-CS p)) (IMPLIES (NOT (IN x (QP-NULL p)))
  (FORSOME y (AND (IN y (QP-CS p)) (IN ,(qp-inv-target 'x 'y) (QP-NULL p)))))))))))
(dk-peel!)
(qp-cs! 'x)
(let* ((e (qp-evc! 'x)) (nc (car e)) (c (cadr e)) (law (caddr e))
       (y `(VNB-LAMBDA qsn_ NN (recip (x (MAX qsn_ ,nc)))))
       ;; M in NN with NC <= M: |x M| = c, x M /= 0, recip typed, x M * recip(x M) = 1; return x M
       (inv-pt! (lambda (m)
                  (dk-chain-ass! (dk-apply! law m))
                  (let ((xm (qp-at! 'x m)))
                    (qp-or-asm `(NOT (= ,xm 0))
                      (lambda ()
                        (dk-have! `(NOT (= ,xm 0))
                          (lambda () (di) (dk-iff-bwd! (dk-cite! 'pz-abs-zero 'p xm))
                                  (dk-absurd! `(= ,(qp-a xm) 0) `(= ,(qp-a xm) ,c) `(< 0 ,c))))))
                    (dk-have-and! `(IN ,xm QQ) `(NOT (= ,xm 0)))
                    (dk-cite! 'qq-recip-closed xm)
                    (dk-cite! 'qq-recip-inverse xm)
                    xm)))
       (max-pt! (lambda (k)
                  (dk-cite! 'nn-in-rr k) (dk-cite! 'nn-in-rr nc)
                  (dk-cite! 'nn-max-closed k nc)
                  (dk-cite! 'rr-le-max-right k nc)
                  `(MAX ,k ,nc))))
  (fact 'nn-is-set) (fact 'qq-one-in) (fact 'rr-one-in) (fact 'qq-zero-in)
  (dk-cite! 'pc-abs-one 'p)
  (dk-have! `(IS-CAUCHY-SEQ ,qm ,y)
    (lambda ()
      (qp-cauchy-goal! y
        (lambda (k) (inv-pt! (max-pt! k)))
        (lambda (ep)
          (dk-cite! 'rr-pos-rr-in-rr ep) (dk-cite! 'rr-lt-of-pos-rr ep)
          (let* ((cc `(* ,c ,c)) (e2 `(* ,ep ,cc)))
            (dk-rr-mul! c c) (dk-rr-mul! ep cc)
            (dk-cite! 'rr-mul-pos c c) (dk-cite! 'rr-mul-pos ep cc)
            (qp-pos-rr! e2)
            (let* ((nf (qp-cauchy-law-at! 'x e2)) (nn `(+ ,nc ,(car nf))))
              (dk-have-and! `(IN ,nc NN) `(IN ,(car nf) NN)) (dk-cite! 'nn-add-closed nc (car nf))
              (ew nn)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (let* ((landed (dk-landed (lambda () (dk-peel!))))
                             (ins (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed)))
                             (ka (car ins)) (kc (cadr ins)))
                        (qp-past-sum! ka (list nc (car nf))) (qp-past-sum! kc (list nc (car nf)))
                        (dk-chain-ass! (dk-apply! (cdr nf) kc ka))
                        (dk-lam-b!)
                        (dk-chain-ass! (dk-cite! 'rr-max-left-le ka nc))
                        (dk-chain-ass! (dk-cite! 'rr-max-left-le kc nc))
                        (subst `(= (MAX ,ka ,nc) ,ka)) (subst `(= (MAX ,kc ,nc) ,kc))
                        (let* ((xa (inv-pt! ka)) (xb (inv-pt! kc))
                               (ru (dk-name! `(recip ,xa) 'QQ)) (rv (dk-name! `(recip ,xb) 'QQ)))
                          (subst `(= (recip ,xa) ,ru)) (subst `(= (recip ,xb) ,rv))
                          (dk-rewrite-h! `(= (* ,xa (recip ,xa)) 1) `(recip ,xa) ru)
                          (dk-rewrite-h! `(= (* ,xb (recip ,xb)) 1) `(recip ,xb) rv)
                          (let* ((dx (qp-qq-sub! xb xa)) (rr2 (qp-qq-mul! ru rv))
                                 (aru (begin (qp-abs! ru) (qp-a ru))) (arv (begin (qp-abs! rv) (qp-a rv)))
                                 (q (qp-a rr2)) (adx (qp-a dx)))
                            ;; ru - rv = (xb - xa) ru rv
                            (let* ((e1 (have-f! `(= (* ,dx ,rr2) (+ (* ,ru (* ,xb ,rv)) (- (* ,rv (* ,xa ,ru))))) (lambda () (crs))))
                                   (e1b (dk-rewrite-h! e1 `(* ,xb ,rv) 1))
                                   (e1c (dk-rewrite-h! e1b `(* ,xa ,ru) 1)))
                              (dk-have! `(= (+ (* ,ru 1) (- (* ,rv 1))) (+ ,ru (- ,rv))) (lambda () (crs)))
                              (subst `(= (+ ,ru (- ,rv)) (+ (* ,ru 1) (- (* ,rv 1)))))
                              (subst `(= (+ (* ,ru 1) (- (* ,rv 1))) (* ,dx ,rr2))))
                            (subst (dk-cite! 'pz-abs-mul 'p dx rr2))
                            ;; c |ru| = 1, c |rv| = 1
                            (for-each (lambda (pr)
                                        (let* ((xm (car pr)) (r (cadr pr))
                                               (h0 (dk-cite! 'pz-abs-mul 'p xm r))
                                               (h1 (dk-rewrite-h! h0 `(* ,xm ,r) 1))
                                               (h2 (dk-rewrite-h! h1 (qp-a 1) 1)))
                                          (dk-rewrite-h! h2 (qp-a xm) c)))
                                      (list (list xa ru) (list xb rv)))
                            (dk-cite! 'pz-abs-mul 'p ru rv)
                            (dk-chain-ass! (dk-cite! 'rr-mul-le-right adx e2 q))
                            (let* ((g1 (have-f! `(= (* ,e2 (* ,aru ,arv)) (* ,ep (* (* ,c ,aru) (* ,c ,arv)))) (lambda () (crs))))
                                   (g2 (dk-rewrite-h! g1 `(* ,c ,aru) 1))
                                   (g3 (dk-rewrite-h! g2 `(* ,c ,arv) 1))
                                   (g4 (dk-rewrite-h! g3 `(* ,aru ,arv) q)))
                              (dk-have! `(= (* ,ep (* 1 1)) ,ep) (lambda () (crs)))
                              (let ((g5 (dk-rewrite-h! g4 `(* ,ep (* 1 1)) ep)))
                                (dk-rewrite-h! `(<= (* ,adx ,q) (* ,e2 ,q)) `(* ,e2 ,q) ep)
                                (dk-close-if-asm!)))))))))))))))
  (dk-iff-bwd! (dk-cite! 'qp-cs-iff 'p y))
  (let ((h (qp-inv-target 'x y)))
    (dk-cite! 'qp-one-cs 'p)
    (qp-type! h)
    (qp-cs! h)
    (qp-null-goal! h
      (lambda (ep)
        (ew nc)
        (qp-past-close!
          (lambda (k)
            (qp-eval! h k)
            (dk-lam-b!)
            (dk-cite! 'nn-in-rr k) (dk-cite! 'nn-in-rr nc)
