;;; 24. Proposition 1.30: an open additive subgroup of Z_p is a principal ideal of Z_p.
;;; Open in Z_p (the subspace topology).  Z_p is a closed ball, hence open in the ultrametric Q_p (Prop 1.3), so U is
;;; open in Q_p; U /= Q_p (p^(-1) is not in Z_p), and Corollary 4.13 gives U = Z_p g; g = 1 g lies in U, inside Z_p.

(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL U (IMPLIES (IS-ADD-SUBGROUP ,qf U) (IMPLIES (SUBSET U (ZP p))
  (IMPLIES (IS-OPEN (SUBSPACE-MS ,qo-ms (ZP p)) U)
    (AND (IS-NV-MODULE ,qf (ZP p) U) (FORSOME g (AND (IN g (ZP p)) (= U (NV-MULTIPLES ,qf (ZP p) g)))))))))))))
(dk-peel!)
