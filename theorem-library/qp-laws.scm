;; a point C of F_p: its integer representative, C rewritten in the goal
(define (fp-rep! c)
  (if (not (dk-asm? `(IN ,c (QUOTIENT ,fp-s))))
      (dk-rewrite-h! `(IN ,c (CARR ,fp-q)) `(CARR ,fp-q) `(QUOTIENT ,fp-s)))
  (let ((x (dk-skolem! (dk-cite! 'quotient-rep fp-s c))))
    (dk-have! `(IN ,x ZZ) (lambda () (subst `(== ZZ (PTS ,fp-s))) (dk-close-if-asm!)))
    (fp-pt! x)
    (subst `(= ,c (CLASS ,fp-s ,x)))
    x))

;; F_p is a field
(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (IS-FIELD-RING (FP p))))))
(dk-peel!)
