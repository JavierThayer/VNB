(qp-field-read-off! 'qp-field-fnrm 'FNRM '(QP-ABS p))

;; a point A of CARR(QP-RING p) in context: land its representative and rewrite A to its class in the goal
(define (qp-class-of! a)
  (qp-field-setup!)
  (if (not (dk-asm? `(IN ,a (QUOTIENT ,qs))))
      (dk-rewrite-h! `(IN ,a (CARR ,qr)) `(CARR ,qr) `(QUOTIENT ,qs)))
  (let ((x (dk-skolem! (dk-cite! 'qp-rep 'p a))))
    (subst `(= ,a (CLASS ,qs ,x)))
    (qp-ab! x)
    x))

(sp (make-wff '(FORALL p (IMPLIES (ZZ-PRIME p) (IS-NORMED-FIELD (QP-FIELD p))))))
(dk-peel!)
(qp-field-setup!)
(dk-cite! 'qp-ring-is-commutative 'p)
(dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'is-commutative-ring-def `(IS-COMMUTATIVE-RING ,qr))))))
