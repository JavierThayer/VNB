      (subst `(= ((MUL ,qf) ((ADD ,qf) ,ek (ONE ,qf)) x) ((ADD ,qf) ((MUL ,qf) ,ek x) x)))
      (dk-chain-ass! (dk-apply! (qsg-law 'U 'ADD) `((MUL ,qf) ,ek x) 'x))
      (dk-close-if-asm!))))
