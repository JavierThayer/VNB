;; uniqueness when n <= m
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL a (FORALL n (IMPLIES (IN n ZZ) (FORALL b (FORALL m (IMPLIES (IN m ZZ) (FORALL x
  (IMPLIES (IS-QP-EXPANSION p a n x) (IMPLIES (IS-QP-EXPANSION p b m x) (IMPLIES (<= n m)
    (FORALL k (IMPLIES (IN k ZZ) (= (a k) (b k))))))))))))))))))
(dk-peel!)
(qp-qp-setup!) (qo-field-setup!)
(qo-zr! 'n) (qo-zr! 'm) (qo-zr! 'k)
(dk-chain-ass! (dk-cite! 'qe-pad 'p 'b 'm 'x 'n))
(qe-open-exp! 'a 'n 'x) (qe-open-exp! 'b 'm 'x)
(use-em '(< k n)
  (lambda ()
    (qe-dig-pt! 'a 'n 'k) (qe-dig-pt! 'b 'm 'k)
    (dk-have! '(< k m) (lambda () (dk-ineq! '(< k n) '(<= n m))))
    (detach! '(IMPLIES (< k n) (= (a k) 0)))
    (detach! '(IMPLIES (< k m) (= (b k) 0)))
    (subst '(= (a k) 0)) (subst '(= (b k) 0))
    (rfl))
  (lambda ()
    (dk-chain-ass! (dk-cite! 'rr-not-lt-ge 'k 'n))
    (let ((j '(+ k (- n))))
      (dk-cite! 'zz-neg-closed 'n) (dk-have-and! '(IN k ZZ) '(IN (- n) ZZ)) (dk-cite! 'zz-add-closed 'k '(- n))
      (dk-have! `(<= 0 ,j) (lambda () (dk-ineq! '(<= n k))))
      (dk-chain-ass! (dk-cite! 'zz-nonneg-in-nn j))
      (let ((jv (dk-name! j 'NN)))
        (dk-cite! 'nn-in-rr jv)
        (dk-have! `(= k (+ n ,jv)) (lambda () (subst `(= ,jv ,j)) (crs)))
        (dk-cite! 'nn-succ-closed jv) (dk-cite! 'nn-in-rr `(succ ,jv)) (dk-cite! 'nn-succ-plus-one jv)
        (dk-have! `(< ,jv (succ ,jv)) (lambda () (dk-ineq! `(= (succ ,jv) (+ ,jv 1)))))
        (let ((ss (dk-chain-ass! (dk-cite! 'qe-same-start `(succ ,jv) 'p 'a 'b 'n 'x))))
          (dk-chain-ass! (dk-apply! ss jv))
          (subst `(= k (+ n ,jv)))
          (dk-close-if-asm!))))))
