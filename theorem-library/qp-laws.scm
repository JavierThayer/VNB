                                            (s `(QP-PSUM p ,dg n ,m)) (fm `(,f ,m)) (nm `(+ n ,m)) (pnm (qo-pp nm)) (tt (qe-mul pnm fm)))
                                       (dk-lam-b!)
                                       (dk-cite! 'nn-in-rr m) (dk-cite! 'nn-subset-zz m)
