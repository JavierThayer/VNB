(mac 'IS-FIELD-RING)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (dk-ass!))
        ((dk-head-is? g 'IS-COMMUTATIVE-RING)
         (mac 'IS-COMMUTATIVE-RING)
         (dk-conj-close!
           (lambda ()
             (if (not (dk-ass!))
                 (let* ((landed (dk-landed (lambda () (dk-peel!))))
                        (vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed)))
                        (x (fp-rep! (car vs))) (y (fp-rep! (cadr vs))))
                   (subst (dk-cite! 'rq-mul-computes fp-r x y))
                   (subst (dk-cite! 'rq-mul-computes fp-r y x))
                   (subst `(== (MUL ,fp-r) ,fp-lmul))
                   (fp-eval! `(,fp-lmul ,x ,y)) (fp-eval! `(,fp-lmul ,y ,x))
                   (dk-have! `(= (* ,x ,y) (* ,y ,x)) (lambda () (crs)))
                   (subst `(= (* ,x ,y) (* ,y ,x)))
                   (fp-pt! `(* ,y ,x))
                   (qp-rfl!))))))
        ((dk-head-is? g 'NOT)
         (subst `(== (ONE ,fp-q) (CLASS ,fp-s (ONE ,fp-r)))) (subst `(== (ZERO ,fp-q) (CLASS ,fp-s (ZERO ,fp-r))))
         (subst `(== (ONE ,fp-r) 1)) (subst `(== (ZERO ,fp-r) 0))
         (di)
         (dk-iff-fwd! (dk-cite! 'fp-class-eq-iff 'p 1 0))
         (dk-have! '(= (+ 1 (- 0)) 1) (lambda () (crs)))
         (dk-rewrite-h! '(ZZ-DIVIDES p (+ 1 (- 0))) '(+ 1 (- 0)) 1)
         (ai (dk-cite! 'pc-prime-not-dvd-one 'p)))
        (#t
         (let* ((landed (dk-landed (lambda () (dk-peel!))))
                (c (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed)))
                (nz0 (find-first (lambda (f) (dk-head-is? f 'NOT)) landed))
                (x (fp-rep! c))
                (nz1 (dk-rewrite-h! nz0 c `(CLASS ,fp-s ,x)))
                (nz2 (dk-rewrite-h! nz1 `(ZERO ,fp-q) `(CLASS ,fp-s (ZERO ,fp-r))))
                (nz3 (dk-rewrite-h! nz2 `(ZERO ,fp-r) 0)))
           (dk-have! `(NOT (ZZ-DIVIDES p ,x))
             (lambda ()
               (di)
               (dk-have! `(= (+ ,x (- 0)) ,x) (lambda () (crs)))
               (dk-have! `(ZZ-DIVIDES p (+ ,x (- 0))) (lambda () (subst `(= (+ ,x (- 0)) ,x)) (dk-close-if-asm!)))
               (dk-iff-bwd! (dk-cite! 'fp-class-eq-iff 'p x 0))
               (ai nz3)))
           (let* ((cm (dk-skolem! (dk-chain-ass! (dk-cite! 'pc-bezout-prime 'p x))))
                  (cn (dk-skolem! (qp-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f cm))) "the cofactor")))
                  (bz `(= (+ (* ,cm p) (* ,cn ,x)) 1)))
             (fp-pt! cn)
             (ew `(CLASS ,fp-s ,cn))
             (dk-conj-close!
               (lambda ()
                 (if (dk-head-is? (dk-goal) 'IN)
                     (begin (subst `(== (CARR ,fp-q) (QUOTIENT ,fp-s))) (dk-cite! 'class-in-quotient fp-s cn) (dk-close-if-asm!))
                     (let* ((xc `(* ,x ,cn)) (d `(+ ,xc (- 1))))
                       (subst (dk-cite! 'rq-mul-computes fp-r x cn))
                       (subst `(== (MUL ,fp-r) ,fp-lmul))
                       (fp-eval! `(,fp-lmul ,x ,cn))
                       (subst `(== (ONE ,fp-q) (CLASS ,fp-s (ONE ,fp-r))))
                       (subst `(== (ONE ,fp-r) 1))
                       (fp-pt! xc)
                       (dk-cite! 'zz-neg-closed cm)
                       (dk-have-and! `(IN (- ,cm) ZZ) '(IN p ZZ)) (dk-cite! 'zz-mul-closed `(- ,cm) 'p)
                       (dk-cite! 'pz-dvd-refl 'p)
                       (dk-chain-ass! (dk-cite! 'pz-dvd-mul 'p 'p `(- ,cm)))
                       (dk-have! `(= ,d (* (- ,cm) p))
                         (lambda () (subst `(= 1 (+ (* ,cm p) (* ,cn ,x)))) (crs)))
                       (dk-have! `(ZZ-DIVIDES p ,d) (lambda () (subst `(= ,d (* (- ,cm) p))) (dk-close-if-asm!)))
                       (dk-iff-bwd! (dk-cite! 'fp-class-eq-iff 'p xc 1))
                       (dk-close-if-asm!))))))))))))
