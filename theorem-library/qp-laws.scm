;; p^n f(0) = S_m + p^(n+m) f(m), for the digit sequence f and digits a with a(n+j) = digit(f j)
(define (qe-dig-law a f) `(FORALL j (IMPLIES (IN j NN) (= (,a (+ n j)) (QP-DIGIT p (,f j))))))
