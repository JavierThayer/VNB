;; p^k is characterised by any a - b = k: p^k p^b = p^a
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL k (IMPLIES (IN k ZZ) (FORALL s (IMPLIES (IN s NN) (FORALL t (IMPLIES (IN t NN)
  (IMPLIES (= (+ s (- t)) k) (= ((MUL ,qf) ,(qo-pp 'k) ,(qo-pk 't)) ,(qo-pk 's)))))))))))))
(dk-peel!)
