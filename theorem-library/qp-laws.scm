;; T in ZZ: (OP ZZ-RING) T .. rewritten to the arithmetic term in the goal; return it (typed in ZZ)
(define (fp-eval! t)
  (cond ((and (pair? t) (member (car t) (list fp-ladd fp-lmul)))
         (let* ((a (fp-eval! (cadr t))) (b (fp-eval! (caddr t))) (add? (equal? (car t) fp-ladd)))
           (subst (dk-cite! (if add? 'fp-add-val 'fp-mul-val) a b))
           (dk-have-and! `(IN ,a ZZ) `(IN ,b ZZ)) (dk-cite! (if add? 'zz-add-closed 'zz-mul-closed) a b)
           (list (if add? '+ '*) a b)))
        ((and (pair? t) (equal? (car t) fp-lneg))
         (let ((a (fp-eval! (cadr t))))
           (subst (dk-cite! 'fp-neg-val a))
           (dk-cite! 'zz-neg-closed a)
           `(- ,a)))
        (#t (fp-in! t))))
(define (fp-pz-in! n)
  ;; (ZZ-DIVIDES p N), N in ZZ in context: land N in pZ
  (dk-have! `(IN ,n ,fp-pz) (lambda () (in-sep! (lambda () (dk-close-if-asm!)) (lambda () (dk-close-if-asm!))))))
(define (fp-ideal-leaf!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'AND) (for-each (lambda (l) (dk-focus! l) (fp-ideal-leaf!)) (dk-opened (lambda () (di)))))
          ((dk-head-is? g 'SUBSET)
           (mac 'subset-def) (dk-peel!) (dk-sep-parts! (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) fp-pz))) (dk-asms))) (dk-close-if-asm!))
          ((memq (dk-head g) '(FORALL IMPLIES))
           (let ((landed (dk-landed (lambda () (dk-peel!)))))
             (for-each (lambda (f) (if (and (dk-head-is? f 'IN) (equal? (caddr f) fp-pz)) (dk-sep-parts! f))) landed)
             (fp-ideal-leaf!)))
          ((equal? g `(IN 0 ,fp-pz)) (dk-cite! 'pz-dvd-zero 'p) (fp-pz-in! 0) (dk-close-if-asm!))
          ((dk-head-is? g 'IN)
           (let* ((v (fp-eval! (cadr g))))
             (cond ((dk-head-is? v '+) (dk-chain-ass! (dk-cite! 'pz-dvd-add 'p (cadr v) (caddr v))))
                   ((dk-head-is? v '-) (dk-chain-ass! (dk-cite! 'pz-dvd-neg 'p (cadr v))))
                   ((dk-asm? `(ZZ-DIVIDES p ,(caddr v))) (dk-chain-ass! (dk-cite! 'pz-dvd-mul 'p (caddr v) (cadr v))))
                   (#t (dk-chain-ass! (dk-cite! 'pz-dvd-mul 'p (cadr v) (caddr v)))
                       (dk-have! `(= ,v (* ,(caddr v) ,(cadr v))) (lambda () (crs)))
                       (subst `(= ,v (* ,(caddr v) ,(cadr v))))
                       (dk-have-and! `(IN ,(caddr v) ZZ) `(IN ,(cadr v) ZZ)) (dk-cite! 'zz-mul-closed (caddr v) (cadr v))))
             (if (not (dk-asm? (dk-goal))) (fp-pz-in! (cadr (dk-goal))))
             (dk-close-if-asm!)))
          (#t (error "fp-ideal-leaf!: unexpected" g)))))

(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (IS-RINGOID ,fp-r)))))
(dk-peel!)
