(dk-cite! 'fp-neg-val 'xb) (dk-cite! 'fp-add-val 'xa '(- xb))
(let* ((d '(+ xa (- xb)))
       (rin `(IN ((ADD ,fp-r) xa ((NEG ,fp-r) xb)) (IDL ,fp-r))))
