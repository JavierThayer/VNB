  ;; U /= Q_p: |p^(-1)| = 2
  (fact 'zz-one-in) (dk-cite! 'zz-neg-closed 1)
  (let* ((pm (qe-pp! '(- 1))) (apm (qo-abs! pm)) (rp (qo-rp '(- (- 1)))))
    (dk-cite! 'rr-neg-closed 1) (dk-cite! 'rr-neg-closed '(- 1))
