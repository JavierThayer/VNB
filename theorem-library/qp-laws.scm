(mac 'QP-PSUM) (mac 'QP-TERM)
(mac 'sum-ag-zero)
(subst (dk-cite! 'qe-ag-iden 'p))
(qp-rfl!)
(qed 'qe-psum-zero)

(define (qe-term a n j) `((MUL ,qf) ,(qp-em `(,a (+ ,n ,j))) ,(qo-pp `(+ ,n ,j))))
(sp (make-wff `(FORALL p (IMPLIES (ZZ-PRIME p) (FORALL a (FORALL n (FORALL m (IMPLIES (IN m NN)
  (== (QP-PSUM p a n (succ m)) ((ADD ,qf) (QP-PSUM p a n m) ,(qe-term 'a 'n 'm)))))))))))
