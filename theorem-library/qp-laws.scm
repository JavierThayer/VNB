                   (dk-cite! 'qp-zero-ne-one 'p) (dk-close-if-asm!))
                  ((dk-head-is? g 'FORALL) (qp-inverse-body!))
                  (#t (error "qp field: unexpected conjunct" g)))))))
  (dk-open-leaves))
