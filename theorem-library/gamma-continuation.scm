;;; gamma-continuation.scm -- WAVE 2 (2026-10-27..30), wired 2026-10-30 from scratchpad/ch3g/ch3g-gamma.scm (proofs).
;;; Library: complex-analysis.

;;; ch3g-gamma.scm -- CH3-G: Proposition 3.60, the analytic continuation of Gamma to the complement of the
;;; non-positive integers, with the recursion Gamma(z + 1) = z Gamma(z) there, and its uniqueness.
;;; Loaded after ca-connected, ch3a-vocab, ch3a-maxmod (wired in the tree, not in band 89840a097244) and
;;; the CH3-E/F files (aw-H, cc-half-plane-open).  Helper prefix gx-.
;;; VOCABULARY:
;;;   POCH(z, n)    the rising factorial z (z + 1) ... (z + n - 1), by recursion on n
;;;   GAMMA-EXT(z)  Gamma(z + N) / POCH(z, N), N a natural with Re z + N > 0 (the notes' continuation by (101))
;;; Library: complex-analysis.

;;; local helpers (copies of the CH3-E ones, gx- prefix)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (gx-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (gx-pick what pred) (let ((l (filter pred (dk-asms)))) (if (null? l) (error "gx-pick: nothing matching" what) (car l))))
(define (gx-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (gx-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (gx-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))



(define (gx-nn-cc! n) (fact 'nn-in-rr n) (fact 'rr-subset-cc n))
(define (gx-has-sub? t u) (or (equal? t u) (and (pair? t) (any-pred (lambda (x) (gx-has-sub? x u)) t))))
(define (gx-induct! base step)               ; after (ni): run BASE on the base leaf, STEP on the step leaf
  (let* ((ls (dk-open-leaves))
         (step? (lambda (l) (let ((g (dk-goal-of l)))
                              (and (gx-op? g 'FORALL 3) (gx-op? (caddr g) 'IMPLIES 3)
                                   (gx-op? (cadr (caddr g)) 'IN 3) (eq? (caddr (cadr (caddr g))) 'NN)
                                   (eq? (cadr (cadr (caddr g))) (cadr g))
                                   (gx-has-sub? g (list 'succ (cadr g)))))))
         (b (find-first (lambda (l) (not (step? l))) ls))
         (st (find-first step? ls)))
    (if (not (and b st)) (error "gx-induct!: leaves not found" (map dk-goal-of ls)))
    (dk-focus! b) (base)
    (dk-focus! st) (step)))
;;; POCH(z, n) is a complex number
(sp (make-wff '(FORALL gxn_ (IMPLIES (IN gxn_ NN) (FORALL gxz_ (IMPLIES (IN gxz_ CC) (IN (POCH gxz_ gxn_) CC)))))))
(ni)
(gx-induct!
  (lambda () (let ((z (dk-di-var!))) (subst (dk-cite! 'poch-zero z)) (fact 'rr-one-in) (fact 'rr-subset-cc 1) (dk-ass!)))
  (lambda ()
    (let* ((new (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
           (z (cadr (find-first (lambda (q) (and (gx-op? q 'IN 3) (eq? (caddr q) 'CC))) new)))
           (n (cadr (find-first (lambda (q) (and (gx-op? q 'IN 3) (eq? (caddr q) 'NN))) new)))
           (ih (find-first (lambda (q) (gx-op? q 'FORALL 3)) new)))
      (dk-apply! ih z)
      (gx-nn-cc! n)
      (subst (dk-cite! 'poch-succ z n))
      (gx-cc! (list '+ z n))
      (gx-cc! (list '* (list 'POCH z n) (list '+ z n)))
      (dk-ass!))))
(qed 'poch-in-cc)

;;; the complement of the non-positive integers
(define gx-OM '(SEP gdz_ CC (FORALL gdn_ (IMPLIES (IN gdn_ NN) (NOT (= (+ gdz_ gdn_) 0))))))
(define gx-RHP '(SEP gmu_ CC (< 0 (real-part gmu_))))
(define gx-GL (list 'VNB-LAMBDA 'gmx_ gx-RHP '(GAMMA-FUNCTION gmx_)))
(define (gx-steps!)                          ; peel a step leaf; returns the landed formulas
  (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
(define (gx-landed-var new cls) (cadr (find-first (lambda (q) (and (gx-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (gx-om-mem! z)                       ; z in OMEGA in context: z in CC and the universal (z + n /= 0)
  (let ((m (list 'IN z gx-OM)))
    (dk-project! (list 'IN z 'CC) (lambda () (sep-me (dk-ctx-form m))))
    (dk-project! (list 'FORALL 'gdn_ (list 'IMPLIES '(IN gdn_ NN) (list 'NOT (list '= (list '+ z 'gdn_) 0))))
                 (lambda () (sep-me (dk-ctx-form m))))))
(define (gx-om-ne! z n)                      ; lands NOT (= (+ z n) 0)
  (dk-apply! (list 'FORALL 'gdn_ (list 'IMPLIES '(IN gdn_ NN) (list 'NOT (list '= (list '+ z 'gdn_) 0)))) n))
;;; POCH(z, n) /= 0 off the non-positive integers
(sp (make-wff (list 'FORALL 'gxn_ (list 'IMPLIES '(IN gxn_ NN) (list 'FORALL 'gxz_ (list 'IMPLIES (list 'IN 'gxz_ gx-OM) '(NOT (= (POCH gxz_ gxn_) 0))))))))
(ni)
(gx-induct!
  (lambda () (let ((z (dk-di-var!))) (subst (dk-cite! 'poch-zero z)) (arith)))
  (lambda ()
    (let* ((new (gx-steps!)) (z (gx-landed-var new gx-OM)) (n (gx-landed-var new 'NN))
           (ih (find-first (lambda (q) (gx-op? q 'FORALL 3)) new)))
      (gx-om-mem! z) (gx-om-ne! z n)
      (dk-apply! ih z)
      (gx-nn-cc! n)
      (dk-cite! 'poch-in-cc n z)
      (subst (dk-cite! 'poch-succ z n))
      (gx-cc! (list '+ z n))
      (dk-fact! 'cc-mul-nonzero (list 'POCH z n) (list '+ z n))
      (dk-ass!))))
(qed 'poch-nonzero)

;;; POCH(z, n + 1) = z POCH(z + 1, n)
(sp (make-wff '(FORALL gxn_ (IMPLIES (IN gxn_ NN) (FORALL gxz_ (IMPLIES (IN gxz_ CC) (= (POCH gxz_ (succ gxn_)) (* gxz_ (POCH (+ gxz_ 1) gxn_)))))))))
(ni)
(gx-induct!
  (lambda () (let ((z (dk-di-var!)))
               (fact 'rr-zero-in) (fact 'nn-zero-in) (fact 'rr-one-in) (fact 'rr-subset-cc 1) (gx-cc! (list '+ z 1))
               (subst (dk-cite! 'poch-succ z 0)) (subst (dk-cite! 'poch-zero z)) (subst (dk-cite! 'poch-zero (list '+ z 1)))
               (crs)))
  (lambda ()
    (let* ((new (gx-steps!)) (z (gx-landed-var new 'CC)) (n (gx-landed-var new 'NN))
           (ih (find-first (lambda (q) (gx-op? q 'FORALL 3)) new)) (z1 (list '+ z 1)))
      (dk-apply! ih z)
      (gx-nn-cc! n) (fact 'nn-succ-closed n) (gx-nn-cc! (list 'succ n)) (fact 'nn-succ-plus-one n)
      (fact 'rr-one-in) (fact 'rr-subset-cc 1) (gx-cc! z1)
      (dk-cite! 'poch-in-cc n z1) (dk-cite! 'poch-in-cc n z) (dk-cite! 'poch-in-cc (list 'succ n) z)
      (subst (dk-cite! 'poch-succ z (list 'succ n)))
      (subst (dk-cite! 'poch-succ z1 n))
      (subst (list '= (list 'POCH z (list 'succ n)) (list '* z (list 'POCH z1 n))))
      (subst (list '= (list 'succ n) (list '+ n 1)))
      (let ((pp (dk-name! (list 'POCH z1 n) 'CC)))
        (subst (list '= (list 'POCH z1 n) pp))
        (crs)))))
(qed 'poch-shift)

;;; helpers for the quotient Gamma(z + n) / POCH(z, n)
(define (gx-Q z n) (list '* (list 'GAMMA-FUNCTION (list '+ z n)) (list 'recip (list 'POCH z n))))
(define (gx-re-shift! z n)                   ; z in CC, n in RR (and CC): Re(z + n) = Re z + n
  (let ((eq (list '= (list 'real-part (list '+ z n)) (list '+ (list 'real-part z) n))))
    (if (not (dk-asm? eq))
        (begin
          (fact 'real-part-in-rr z)
          (dk-cite! 'cc-re-add z n) (dk-cite! 'cc-re-of-real n)
          (dk-have! eq (lambda ()
            (subst (list '= (list 'real-part (list '+ z n)) (list '+ (list 'real-part z) (list 'real-part n))))
            (dk-close-if! (lambda () (subst (list '= (list 'real-part n) n))) (lambda () (rfl)))))))
    eq))
(define (gx-gam-cc! w)                       ; 0 < Re w and w in CC in context: GAMMA-FUNCTION(w) in CC
  (let ((goal (list 'IN (list 'GAMMA-FUNCTION w) 'CC)))
    (if (not (dk-asm? goal))
        (begin
          (dk-cite! 'gamma-holomorphic)
          (dk-project! (list 'IN gx-GL (list 'FUN gx-RHP 'CC)) 'HOLOMORPHIC-ON (list 'HOLOMORPHIC-ON gx-RHP gx-GL))
          (dk-have! (list 'IN w gx-RHP) (lambda () (in-sep! (lambda () (dk-ass!)))))
          (dk-have! goal (lambda ()
            (fact 'fun-apply-type-c gx-GL gx-RHP 'CC w)
            (dk-lam-b-h! (list 'IN (list gx-GL w) 'CC))
            (dk-ass!)))))
    goal))

;;; one step: Gamma(z + n + 1) / POCH(z, n + 1) = Gamma(z + n) / POCH(z, n) when Re z + n > 0
(sp (make-wff (list 'FORALL 'gxn_ (list 'IMPLIES '(IN gxn_ NN) (list 'FORALL 'gxz_ (list 'IMPLIES (list 'IN 'gxz_ gx-OM)
  (list 'IMPLIES '(< 0 (+ (real-part gxz_) gxn_)) (list '= (gx-Q 'gxz_ '(succ gxn_)) (gx-Q 'gxz_ 'gxn_)))))))))
(let* ((new (gx-steps!)) (z (gx-landed-var new gx-OM)) (n (gx-landed-var new 'NN))
       (w (list '+ z n)) (P (list 'POCH z n)) (GM (list 'GAMMA-FUNCTION w)))
  (gx-om-mem! z) (gx-om-ne! z n) (gx-nn-cc! n)
  (gx-cc! w)
  (let ((re (gx-re-shift! z n)))
    (dk-have! (list '< 0 (list 'real-part w)) (lambda () (subst re) (dk-ass!))))
  (gx-gam-cc! w)
  (dk-cite! 'gamma-recursion w)
  (fact 'nn-succ-plus-one n)
  (dk-cite! 'poch-in-cc n z) (dk-cite! 'poch-nonzero n z)
  (fact 'cc-recip-closed P)
  (gx-and! (list 'IN P 'CC) (list 'NOT (list '= P 0))) (fact 'cc-recip-closed P)
  (gx-and! (list 'IN w 'CC) (list 'NOT (list '= w 0))) (fact 'cc-recip-closed w) (fact 'cc-recip-inverse w)
  (dk-cite! 'cc-recip-mul P w)
  (subst (dk-cite! 'poch-succ z n))
  (subst (list '= (list 'succ n) (list '+ n 1)))
  (fact 'rr-one-in) (fact 'rr-subset-cc 1)
  (dk-have! (list '= (list '+ z (list '+ n 1)) (list '+ w 1)) (lambda () (crs)))
  (subst (list '= (list '+ z (list '+ n 1)) (list '+ w 1)))
  (subst (list '= (list 'GAMMA-FUNCTION (list '+ w 1)) (list '* w GM)))
  (subst (list '= (list 'recip (list '* P w)) (list '* (list 'recip P) (list 'recip w))))
  (let* ((gv (dk-name! GM 'CC)) (rp (dk-name! (list 'recip P) 'CC)) (rw (dk-name! (list 'recip w) 'CC)))
    (subst (list '= GM gv)) (subst (list '= (list 'recip P) rp)) (subst (list '= (list 'recip w) rw))
    (dk-rewrite-h! (list '= (list '* w (list 'recip w)) 1) (list 'recip w) rw)
    (let ((lhs (list '* (list '* w gv) (list '* rp rw))))
      (dk-have! (list '= lhs (list '* (list '* w rw) (list '* gv rp))) (lambda () (crs)))
      (subst (list '= lhs (list '* (list '* w rw) (list '* gv rp))))
      (subst (list '= (list '* w rw) 1))
      (crs))))
(qed 'gamma-poch-step)

;;; type the quotient at (z, n): z in OMEGA (projections landed), n in NN, RR, CC, 0 < Re z + n in context
(define (gx-q-typed! z n)
  (let ((w (list '+ z n)) (pz (list 'POCH z n)) (lt (list '< 0 (list 'real-part (list '+ z n)))))
    (gx-cc! w)
    (let ((re (gx-re-shift! z n)))
      (if (not (dk-asm? lt)) (dk-have! lt (lambda () (subst re) (dk-ass!)))))
    (gx-gam-cc! w)
    (dk-cite! 'poch-in-cc n z) (dk-cite! 'poch-nonzero n z)
    (if (not (dk-asm? (list 'IN (list 'recip pz) 'CC)))
        (begin (gx-and! (list 'IN pz 'CC) (list 'NOT (list '= pz 0))) (fact 'cc-recip-closed pz)))
    (gx-cc! (gx-Q z n))))

;;; the quotient does not depend on n: Q(z, n + k) = Q(z, n) once Re z + n > 0
(sp (make-wff (list 'FORALL 'gxk_ (list 'IMPLIES '(IN gxk_ NN) (list 'FORALL 'gxn_ (list 'IMPLIES '(IN gxn_ NN)
  (list 'FORALL 'gxz_ (list 'IMPLIES (list 'IN 'gxz_ gx-OM) (list 'IMPLIES '(< 0 (+ (real-part gxz_) gxn_))
    (list '= (gx-Q 'gxz_ '(+ gxn_ gxk_)) (gx-Q 'gxz_ 'gxn_)))))))))))
(ni)
(gx-induct!
  (lambda ()
    (let* ((new (gx-steps!)) (z (gx-landed-var new gx-OM)) (n (gx-landed-var new 'NN)))
      (gx-om-mem! z) (gx-nn-cc! n) (gx-q-typed! z n)
      (fact 'nn-zero-in) (fact 'nn-add-zero n)
      (dk-close-if! (lambda () (subst (list '= (list '+ n 0) n))) (lambda () (rfl)))))
  (lambda ()
    (let* ((new (gx-steps!)) (z (gx-landed-var new gx-OM))
           (ns (dk-landed-vars new 'NN))
           (ih (find-first (lambda (q) (gx-op? q 'FORALL 3)) new))
           (n (find-first (lambda (v) (gx-has-sub? (dk-goal) (list '+ v (list 'succ (car (filter (lambda (u) (not (eq? u v))) ns)))))) ns))
           (kk (car (filter (lambda (u) (not (eq? u n))) ns)))
           (nk (list '+ n kk)))
      (gx-om-mem! z) (gx-nn-cc! n) (gx-q-typed! z n)
      (gx-and! (list 'IN n 'NN) (list 'IN kk 'NN)) (fact 'nn-add-closed n kk) (gx-nn-cc! nk) (gx-nn-cc! kk) (fact 'nn-zero-le kk)
      (fact 'real-part-in-rr z)
      (dk-have! (list '< 0 (list '+ (list 'real-part z) nk))
        (lambda () (dk-ineq! (list '< 0 (list '+ (list 'real-part z) n)) (list '<= 0 kk))))
      (gx-q-typed! z nk)
      (dk-apply! ih n z)
      (dk-cite! 'gamma-poch-step nk z)
      (subst (dk-cite! 'nn-add-succ n kk))
      (subst (gx-pick "step eq" (lambda (q) (and (gx-op? q '= 3) (equal? (cadr q) (gx-Q z (list 'succ nk)))))))
      (dk-ass!))))
(qed 'gamma-poch-gap)

;;; THE CONTINUATION.  For z off the non-positive integers pick any n in NN with Re z + n > 0 and put
;;; GAMMA-EXT(z) = Gamma(z + n) / POCH(z, n); gamma-poch-gap says the value does not depend on n.


(define (gx-S z) (list 'SEP 'gek_ 'NN (list '< 0 (list '+ (list 'real-part z) 'gek_))))
(define (gx-nn-add-comm! a b)
  (gx-and! (list 'IN a 'NN) (list 'IN b 'NN)) (fact 'nn-add-comm a b)
  (gx-and! (list 'IN a 'NN) (list 'IN b 'NN)) (fact 'nn-add-closed a b)
  (gx-and! (list 'IN b 'NN) (list 'IN a 'NN)) (fact 'nn-add-closed b a))

;;; the value: GAMMA-EXT(z) = Gamma(z + n) / POCH(z, n) for EVERY n in NN with Re z + n > 0
(sp (make-wff (list 'FORALL 'gxn_ (list 'IMPLIES '(IN gxn_ NN) (list 'FORALL 'gxz_ (list 'IMPLIES (list 'IN 'gxz_ gx-OM)
  (list 'IMPLIES '(< 0 (+ (real-part gxz_) gxn_)) (list '= '(GAMMA-EXT gxz_) (gx-Q 'gxz_ 'gxn_)))))))))
(let* ((new (gx-steps!)) (z (gx-landed-var new gx-OM)) (n (gx-landed-var new 'NN))
       (sz (gx-S z)) (c (list 'CHOICE sz)))
  (gx-om-mem! z) (gx-nn-cc! n) (fact 'real-part-in-rr z)
  (choose-mem! sz n (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
  (let ((cj (list 'AND (list 'IN c 'NN) (list '< 0 (list '+ (list 'real-part z) c)))))
    (dk-have! cj (lambda ()
      (dk-split-all! (dk-landed (lambda () (sep-me (dk-ctx-form (list 'IN c sz))))))
      (dk-conj-close! (lambda () (dk-ass!)))))
    (dk-split-all! (list cj)))
  (gx-nn-add-comm! c n) (gx-q-typed! z n)
  (dk-cite! 'gamma-poch-gap n c z)
  (dk-cite! 'gamma-poch-gap c n z)
  (mac 'GAMMA-EXT)
  (subst (list '= (gx-Q z c) (gx-Q z (list '+ c n))))
  (subst (list '= (list '+ c n) (list '+ n c)))
  (dk-close-if! (lambda () (subst (list '= (gx-Q z (list '+ n c)) (gx-Q z n)))) (lambda () (rfl))))
(qed 'gamma-ext-value)

(define (gx-dump!) (for-each (lambda (l) (display ";; GXOPEN ") (display (expression->string (dk-goal-of l))) (newline)) (dk-open-leaves)))
(define (gx-z0! z)                           ; z in CC: z + 0 = z
  (let ((e (list '= (list '+ z 0) z)))
    (if (not (dk-asm? e)) (begin (fact 'rr-zero-in) (fact 'rr-subset-cc 0) (dk-have! e (lambda () (crs)))))
    e))

;;; the right half-plane lies off the non-positive integers
(sp (make-wff (list 'FORALL 'gxz_ (list 'IMPLIES '(IN gxz_ CC) (list 'IMPLIES '(< 0 (real-part gxz_)) (list 'IN 'gxz_ gx-OM))))))
(let* ((new (gx-steps!)) (z (gx-landed-var new 'CC)))
  (fact 'real-part-in-rr z)
  (in-sep! (lambda () (dk-ass!))
    (lambda ()
      (let* ((n (dk-di-var!)))
        (gx-nn-cc! n) (fact 'nn-zero-le n)
        (gx-cc! (list '+ z n))
        (let ((re (gx-re-shift! z n)))
          (di)
          (fact 'rr-zero-in) (fact 'cc-re-of-real 0)
          (let ((re0 (dk-rewrite-h! re (list '+ z n) 0)))
            (dk-absurd! (dk-rewrite-h! re0 (list 'real-part 0) 0) (list '< 0 (list 'real-part z)) (list '<= 0 n))))))))
(qed 'gamma-rhp-in-omega)

;;; the continuation extends Gamma
(sp (make-wff (list 'FORALL 'gxz_ (list 'IMPLIES '(IN gxz_ CC) (list 'IMPLIES '(< 0 (real-part gxz_))
  (list 'AND (list 'IN 'gxz_ gx-OM) '(= (GAMMA-EXT gxz_) (GAMMA-FUNCTION gxz_))))))))
(let* ((new (gx-steps!)) (z (gx-landed-var new 'CC)))
  (dk-cite! 'gamma-rhp-in-omega z)
  (fact 'nn-zero-in) (fact 'rr-zero-in) (fact 'rr-subset-cc 0) (fact 'real-part-in-rr z)
  (dk-have! (list '< 0 (list '+ (list 'real-part z) 0)) (lambda () (dk-ineq! (list '< 0 (list 'real-part z)))))
  (gx-om-mem! z)
  (gx-q-typed! z 0)
  (dk-cite! 'gamma-ext-value 0 z)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IN) (dk-ass!)
          (let* ((e0 (gx-z0! z)) (one-in (begin (fact 'rr-one-in) (fact 'rr-subset-cc 1) (list 'IN 1 'CC))))
            (subst (list '= (list 'GAMMA-EXT z) (gx-Q z 0)))
            (subst (dk-cite! 'poch-zero z))
            (subst e0)
            (if (not (dk-asm? '(NOT (= 1 0)))) (dk-have! '(NOT (= 1 0)) (lambda () (arith))))
            (gx-and! one-in '(NOT (= 1 0)))
            (fact 'cc-recip-closed 1) (fact 'cc-recip-inverse 1)
            (gx-gam-cc! z)
            (let* ((gv (dk-name! (list 'GAMMA-FUNCTION z) 'CC)) (r1 (dk-name! '(recip 1) 'CC)))
              (subst (list '= (list 'GAMMA-FUNCTION z) gv)) (subst (list '= '(recip 1) r1))
              (dk-rewrite-h! '(= (* 1 (recip 1)) 1) '(recip 1) r1)
              (dk-have! (list '= r1 (list '* 1 r1)) (lambda () (crs)))
              (subst (list '= r1 (list '* 1 r1)))
              (subst (list '= (list '* 1 r1) 1))
              (crs)))))))
(qed 'gamma-ext-extends)

;;; z + 1 stays off the non-positive integers
(sp (make-wff (list 'FORALL 'gxz_ (list 'IMPLIES (list 'IN 'gxz_ gx-OM) (list 'IN '(+ gxz_ 1) gx-OM)))))
(let* ((new (gx-steps!)) (z (gx-landed-var new gx-OM)) (z1 (list '+ z 1)))
  (gx-om-mem! z) (fact 'rr-one-in) (fact 'rr-subset-cc 1) (gx-cc! z1)
  (in-sep! (lambda () (dk-ass!))
    (lambda ()
      (let ((n (dk-di-var!)))
        (gx-nn-cc! n) (fact 'nn-succ-closed n) (fact 'nn-succ-plus-one n)
        (gx-om-ne! z (list 'succ n))
        (let ((e (list '= (list '+ z1 n) (list '+ z (list 'succ n)))))
          (dk-have! e (lambda () (subst (list '= (list 'succ n) (list '+ n 1))) (crs)))
          (subst e)
          (dk-ass!))))))
(qed 'gamma-omega-shift)

;;; the functional equation (101) off the non-positive integers
(sp (make-wff (list 'FORALL 'gxz_ (list 'IMPLIES (list 'IN 'gxz_ gx-OM)
  '(= (GAMMA-EXT (+ gxz_ 1)) (* gxz_ (GAMMA-EXT gxz_)))))))
(let* ((new (gx-steps!)) (z (gx-landed-var new gx-OM)) (z1 (list '+ z 1)) (rz (list 'real-part z)))
  (gx-om-mem! z) (fact 'real-part-in-rr z) (fact 'rr-one-in) (fact 'rr-subset-cc 1) (fact 'nn-zero-in)
  (gx-rr! (list '- rz))
  (let* ((ex (dk-cite! 'nn-unbounded-in-rr (list '- rz)))
         (n (begin (dk-skolem! (dk-ctx-form ex) #t)
                   (caddr (find-first (lambda (q) (and (gx-op? q '< 3) (equal? (cadr q) (list '- rz)))) (dk-asms)))))
         (n1 (list 'succ n)) (p1 (list 'POCH z1 n)) (w (list '+ z1 n)))
    (gx-nn-cc! n) (fact 'nn-succ-closed n) (fact 'nn-succ-plus-one n) (gx-nn-cc! n1)
    (dk-have! (list '< 0 (list '+ rz n)) (lambda () (dk-ineq! (list '< (list '- rz) n))))
    (dk-have! (list '< 0 (list '+ rz n1))
      (lambda () (subst (list '= n1 (list '+ n 1))) (dk-ineq! (list '< 0 (list '+ rz n)))))
    (dk-cite! 'gamma-omega-shift z) (gx-om-mem! z1)
    (let ((re1 (gx-re-shift! z 1)))
      (dk-have! (list '< 0 (list '+ (list 'real-part z1) n))
        (lambda () (subst re1) (dk-ineq! (list '< 0 (list '+ rz n))))))
    (gx-q-typed! z1 n)
    (dk-cite! 'gamma-ext-value n z1)
    (dk-cite! 'gamma-ext-value n1 z)
    (dk-cite! 'poch-shift n z)
    (gx-om-ne! z 0) (gx-z0! z)
    (let ((znz (dk-rewrite-h! (list 'NOT (list '= (list '+ z 0) 0)) (list '+ z 0) z)))
      (gx-and! (list 'IN z 'CC) znz))
    (fact 'cc-recip-closed z) (fact 'cc-recip-inverse z)
    (gx-cc! p1)
    (dk-cite! 'cc-recip-mul z p1)
    (let ((e (list '= (list '+ z n1) w)))
      (dk-have! e (lambda () (subst (list '= n1 (list '+ n 1))) (crs))))
    (subst (list '= (list 'GAMMA-EXT z1) (gx-Q z1 n)))
    (subst (list '= (list 'GAMMA-EXT z) (gx-Q z n1)))
    (subst (list '= (list 'POCH z n1) (list '* z p1)))
    (subst (list '= (list '+ z n1) w))
    (subst (list '= (list 'recip (list '* z p1)) (list '* (list 'recip z) (list 'recip p1))))
    (let* ((gv (dk-name! (list 'GAMMA-FUNCTION w) 'CC)) (rp (dk-name! (list 'recip p1) 'CC)) (rzv (dk-name! (list 'recip z) 'CC)))
      (subst (list '= (list 'GAMMA-FUNCTION w) gv)) (subst (list '= (list 'recip p1) rp)) (subst (list '= (list 'recip z) rzv))
      (dk-rewrite-h! (list '= (list '* z (list 'recip z)) 1) (list 'recip z) rzv)
      (let ((rhs (list '* z (list '* gv (list '* rzv rp)))))
        (dk-have! (list '= rhs (list '* (list '* z rzv) (list '* gv rp))) (lambda () (crs)))
        (subst (list '= rhs (list '* (list '* z rzv) (list '* gv rp))))
        (subst (list '= (list '* z rzv) 1))
        (crs)))))
(qed 'gamma-ext-recursion)

;;; ---------------------------------------------------------------- openness
(define (gx-mag-pos! z)                      ; z in CC, NOT z = 0 in context: |z| in RR, 0 <= |z|, 0 < |z|
  (let* ((t (list 'magnitude z)) (lt (list '< 0 t)))
    (if (not (dk-asm? lt))
        (begin
          (fact 'cc-magnitude-closed z) (fact 'cc-magnitude-nonneg z)
          (let ((iff (dk-cite! 'cc-magnitude-zero-iff z)))
            (dk-have! (list 'NOT (list '= t 0))
              (lambda () (di) (keep iff (list 'NOT (list '= z 0)) (list '= t 0)) (prop))))
          (fact 'rr-zero-in)
          (dk-have! lt
            (lambda ()
              (mac '<)
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'NOT)
                      (begin
                        (di)
                        (let ((h (dk-rewrite-h! (list 'NOT (list '= t 0)) t 0)))
                          (dk-have! '(= 0 0) (lambda () (rfl)))
                          (ai h)))
                      (dk-ass!))))))))
    lt))
(define (gx-lt-from-le! j m)                  ; j, m in NN; NOT j = m and j < succ m in context, succ m = m + 1: j < m
  (fact 'nn-succ-closed m)
  (dk-cite! 'nn-lt-succ-le j (list 'succ m))
  (fact 'nn-succ-plus-one j) (fact 'nn-succ-plus-one m) (fact 'nn-succ-closed j)
  (gx-nn-cc! j) (gx-nn-cc! m) (gx-nn-cc! (list 'succ j)) (gx-nn-cc! (list 'succ m))
  (dk-have! (list '<= j m)
    (lambda () (dk-ineq! (list '<= (list 'succ j) (list 'succ m)) (list '= (list 'succ j) (list '+ j 1)) (list '= (list 'succ m) (list '+ m 1)))))
  (dk-have! (list '< j m) (lambda () (mac '<) (dk-conj-close! (lambda () (dk-ass!))))))
(define (gx-sep-goal a m r)
  (list 'AND (list 'IN r 'RR) (list 'AND (list '< 0 r)
    (list 'FORALL 'gxj_ (list 'IMPLIES '(IN gxj_ NN) (list 'IMPLIES (list '< 'gxj_ m) (list '<= r (list 'magnitude (list '+ a 'gxj_)))))))))

;;; finitely many of the points a + j (j < m) are all nonzero: a common positive lower bound for |a + j|
(sp (make-wff (list 'FORALL 'gxm_ (list 'IMPLIES '(IN gxm_ NN) (list 'FORALL 'gxa_ (list 'IMPLIES '(IN gxa_ CC)
  (list 'IMPLIES '(FORALL gxj_ (IMPLIES (IN gxj_ NN) (IMPLIES (< gxj_ gxm_) (NOT (= (+ gxa_ gxj_) 0)))))
    (list 'FORSOME 'gxr_ (gx-sep-goal 'gxa_ 'gxm_ 'gxr_)))))))))
(ni)
(gx-induct!
  (lambda ()
    (let* ((new (gx-steps!)) (a (gx-landed-var new 'CC)))
      (fact 'rr-one-in) (fact 'rr-zero-in)
      (ew 1)
      (dk-conj-close!
        (lambda ()
          (cond ((dk-head-is? (dk-goal) 'IN) (dk-ass!))
                ((dk-head-is? (dk-goal) '<) (dk-ineq!))
                (#t (let* ((nj (gx-steps!)) (j (gx-landed-var nj 'NN)))
                      (gx-nn-cc! j) (fact 'nn-zero-le j)
                      (dk-absurd! (list '< j 0) (list '<= 0 j)))))))))
  (lambda ()
    (let* ((new (gx-steps!)) (a (gx-landed-var new 'CC)) (m (gx-landed-var new 'NN))
           (ih (find-first (lambda (q) (and (gx-op? q 'FORALL 3) (dk-contains? q 'FORSOME))) new))
           (hh (find-first (lambda (q) (and (gx-op? q 'FORALL 3) (not (dk-contains? q 'FORSOME)))) new))
           (am (list '+ a m)) (t (list 'magnitude am)))
      (gx-nn-cc! m) (fact 'nn-succ-plus-one m) (fact 'nn-succ-closed m)
      (dk-have! (list '< m (list 'succ m)) (lambda () (subst (list '= (list 'succ m) (list '+ m 1))) (dk-ineq!)))
      (dk-apply! hh m)
      (gx-cc! am) (gx-mag-pos! am)
      (let ((h2 (list 'FORALL 'gxj_ (list 'IMPLIES '(IN gxj_ NN) (list 'IMPLIES (list '< 'gxj_ m) (list 'NOT (list '= (list '+ a 'gxj_) 0)))))))
        (dk-have! h2
          (lambda ()
            (let* ((nj (gx-steps!)) (j (gx-landed-var nj 'NN)))
              (gx-nn-cc! j)
              (dk-have! (list '< j (list 'succ m)) (lambda () (subst (list '= (list 'succ m) (list '+ m 1))) (dk-ineq! (list '< j m))))
              (dk-apply! hh j)
              (dk-ass!))))
        (dk-apply! ih a))
      (let* ((r (dk-skolem! (dk-ctx-form (list 'FORSOME 'gxr_ (gx-sep-goal a m 'gxr_))) #t))
             (rall (begin (dk-split-all!) (dk-ctx-form (caddr (caddr (gx-sep-goal a m r))))))
             (branch!
               (lambda (wv)
                 (ew wv)
                 (dk-conj-close!
                   (lambda ()
                     (cond ((dk-head-is? (dk-goal) 'IN) (dk-ass!))
                           ((dk-head-is? (dk-goal) '<) (dk-ass!))
                           (#t (let* ((nj (gx-steps!)) (j (gx-landed-var nj 'NN)))
                                 (gx-nn-cc! j)
                                 (use-em (list '= j m)
                                   (lambda () (subst (list '= j m)) (if (eq? wv r) (dk-ineq! (list '<= r t)) (dk-ineq!)))
                                   (lambda ()
                                     (gx-lt-from-le! j m)
                                     (dk-apply! rall j)
                                     (gx-cc! (list '+ a j)) (fact 'cc-magnitude-closed (list '+ a j))
                                     (if (eq? wv r) (dk-ineq! (list '<= r (list 'magnitude (list '+ a j)))) (dk-ineq! (list '<= r (list 'magnitude (list '+ a j))) (list '<= t r)))))))))))))
        (gx-and! (list 'IN r 'RR) (list 'IN t 'RR))
        (use-cases (dk-fact! 'rr-leq-total r t)
          (lambda () (branch! r))
          (lambda () (branch! t)))))))
(qed 'gamma-finite-separation)

;;; the ball membership IFF at (c, r, w), as the context holds it
(define (gx-ball-iff! c r w)
  (let ((f (list 'IFF (list 'IN w (list 'BALL 'CC-MS c r)) (list 'AND (list 'IN w 'CC) (list '< (list 'magnitude (list '- w c)) r)))))
    (if (not (dk-asm? f))
        (let ((u (list 'FORALL 'y (list 'IFF (list 'IN 'y (list 'BALL 'CC-MS c r)) (list 'AND '(IN y CC) (list '< (list 'magnitude (list '- 'y c)) r))))))
          (if (dk-asm? u) (dk-apply! (dk-ctx-form u) w) (fact 'cc-ms-ball-membership c r w))))
    (or (dk-ctx-form f) (error "gx-ball-iff!: did not land" (expression->string f)))))
(define (gx-ball-parts! w c r)               ; w in BALL(CC-MS, c, r) in context, c in CC, r in RR: w in CC, |w - c| < r
  (let* ((iff (gx-ball-iff! c r w)) (mem (list 'IN w (list 'BALL 'CC-MS c r)))
         (lt (list '< (list 'magnitude (list '- w c)) r)))
    (dk-have! (list 'IN w 'CC) (lambda () (keep iff mem) (prop)))
    (dk-have! lt (lambda () (keep iff mem) (prop)))
    (fact 'cc-sub-in-cc w c) (fact 'cc-magnitude-closed (list '- w c))
    lt))
(define (gx-ball-goal a m)
  (list 'FORALL 'gxw_ (list 'IMPLIES (list 'IN 'gxw_ (list 'BALL 'CC-MS a 'gxr_))
    (list 'AND (list 'IN 'gxw_ gx-OM) (list '< 0 (list '+ '(real-part gxw_) m))))))

;;; each point of OMEGA has a ball about it inside OMEGA, on which Re w + m stays positive
(sp (make-wff (list 'FORALL 'gxa_ (list 'IMPLIES (list 'IN 'gxa_ gx-OM) (list 'FORALL 'gxm_ (list 'IMPLIES '(IN gxm_ NN)
  (list 'IMPLIES '(< 0 (+ (real-part gxa_) gxm_))
    (list 'FORSOME 'gxr_ (list 'AND '(POS-RR gxr_) (gx-ball-goal 'gxa_ 'gxm_))))))))))
(let* ((new (gx-steps!)) (a (gx-landed-var new gx-OM)) (m (gx-landed-var new 'NN))
       (ra (list 'real-part a)) (sv (list '+ ra m)))
  (gx-om-mem! a) (gx-nn-cc! m) (fact 'real-part-in-rr a) (gx-rr! sv)
  (dk-have! (list 'FORALL 'gxj_ (list 'IMPLIES '(IN gxj_ NN) (list 'IMPLIES (list '< 'gxj_ m) (list 'NOT (list '= (list '+ a 'gxj_) 0)))))
    (lambda () (let* ((nj (gx-steps!)) (j (gx-landed-var nj 'NN))) (gx-om-ne! a j) (dk-ass!))))
  (dk-cite! 'gamma-finite-separation m a)
  (let* ((r0 (dk-skolem! (dk-ctx-form (list 'FORSOME 'gxr_ (gx-sep-goal a m 'gxr_))) #t))
         (rall (begin (dk-split-all!) (dk-ctx-form (caddr (caddr (gx-sep-goal a m r0))))))
         (branch!
           (lambda (rho prem)                ; prem: the case hypothesis, rho <= the other
             (ew rho)
             (fact 'rr-pos-rr-of-lt rho)
             (dk-conj-close!
               (lambda ()
                 (if (dk-head-is? (dk-goal) 'POS-RR) (dk-ass!)
                   (let* ((nw (gx-steps!)) (w (cadr (find-first (lambda (q) (gx-op? q 'IN 3)) nw)))
                          (lt (gx-ball-parts! w a rho)) (wa (list '- w a)) (rw (list 'real-part w)))
                     (fact 'real-part-in-rr w) (fact 'real-part-in-rr wa)
                     (dk-cite! 'cc-re-sub w a) (dk-cite! 'cc-abs-re-le-magnitude wa)
                     (fact 'rr-abs-closed (list 'real-part wa)) (dk-cite! 'rr-neg-abs-le (list 'real-part wa))
                     (dk-have! (list '< 0 (list '+ rw m))
                       (lambda () (apply dk-ineq! lt (list '= (list 'real-part wa) (list '- rw ra))
                                            (list '<= (list 'abs (list 'real-part wa)) (list 'magnitude wa))
                                            (list '<= (list '- (list 'abs (list 'real-part wa))) (list 'real-part wa))
                                            (if (eq? rho r0) (list prem) '()))))
                     (dk-conj-close!
                       (lambda ()
                         (if (dk-head-is? (dk-goal) '<) (dk-ass!)
                           (in-sep! (lambda () (dk-ass!))
                             (lambda ()
                               (let* ((nj (gx-steps!)) (j (gx-landed-var nj 'NN)) (wj (list '+ w j)))
                                 (gx-nn-cc! j) (gx-cc! wj) (di)
                                 (use-em (list '< j m)
                                   (lambda ()
                                     (let* ((aj (list '+ a j)) (aw (list '- a w)))
                                       (dk-apply! rall j)
                                       (gx-cc! aj) (gx-cc! aw) (fact 'cc-magnitude-closed aj) (fact 'cc-magnitude-closed aw)
                                       (fact 'cc-magnitude-closed wj)
                                       (gx-and! (list 'IN aw 'CC) (list 'IN wj 'CC))
                                       (fact 'cc-magnitude-triangle aw wj)
                                       (dk-have! (list '= (list '+ aw wj) aj) (lambda () (crs)))
                                       (let* ((tri (dk-rewrite-h! (list '<= (list 'magnitude (list '+ aw wj)) (list '+ (list 'magnitude aw) (list 'magnitude wj)))
                                                                  (list '+ aw wj) aj))
                                              (sym (dk-cite! 'cc-magnitude-sub-sym a w))
                                              (z0 (list '= (list 'magnitude wj) 0)))
                                         (fact 'cc-magnitude-zero)
                                         (dk-have! z0 (lambda () (subst (list '= wj 0)) (dk-ass!)))
                                         (if (eq? rho r0)
                                             (dk-absurd! tri lt sym z0 (list '<= r0 (list 'magnitude aj)))
                                             (dk-absurd! tri lt sym z0 prem (list '<= r0 (list 'magnitude aj)))))))
                                   (lambda ()
                                     (dk-cite! 'nn-not-lt-le j m)
                                     (let ((re (gx-re-shift! w j)))
                                       (fact 'rr-zero-in) (fact 'cc-re-of-real 0)
                                       (let* ((re0 (dk-rewrite-h! re wj 0)) (re00 (dk-rewrite-h! re0 (list 'real-part 0) 0)))
                                         (dk-absurd! re00 (list '< 0 (list '+ rw m)) (list '<= m j)))))))))))))))))))
    (gx-and! (list 'IN r0 'RR) (list 'IN sv 'RR))
    (use-cases (dk-fact! 'rr-leq-total r0 sv)
      (lambda () (branch! r0 (list '<= r0 sv)))
      (lambda () (branch! sv (list '<= sv r0))))))
(qed 'gamma-omega-ball)

(define (gx-set! dm)                          ; dm a SEP over CC (or CC): (IN dm SET)
  (if (not (dk-asm? (list 'IN dm 'SET)))
      (dk-have! (list 'IN dm 'SET)
        (lambda () (let ((leaf (proof-state-focus *ps*)))
                     (if (eq? dm 'CC) (begin (fact 'cc-is-set) (dk-ass!))
                         (begin (sep-set) (if (not (sequent-node-grounded? leaf)) (begin (fact 'cc-is-set) (dk-ass!)))))))))
  (list 'IN dm 'SET))
(define (gx-lam-typ! lam dom cod typer)      ; (IN lam (FUN dom cod)); TYPER gets the eigenvariable
  (let ((typ (list 'IN lam (list 'FUN dom cod))))
    (if (not (dk-asm? typ))
        (begin
          (gx-set! dom)
          (dk-have! typ
            (lambda ()
              (dk-lam-type!
                (lambda ()
                  (let* ((j (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                    (typer j)
                    (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
                (lambda () (dk-ass!)))))))
    typ))
(define (gx-pick-m! a)                       ; a in CC: an n in NN with 0 < Re a + n; returns n
  (fact 'real-part-in-rr a)
  (gx-rr! (list '- (list 'real-part a)))
  (let* ((ex (dk-cite! 'nn-unbounded-in-rr (list '- (list 'real-part a))))
         (n (dk-skolem! (dk-ctx-form ex) #t)))
    (gx-nn-cc! n)
    (dk-have! (list '< 0 (list '+ (list 'real-part a) n)) (lambda () (dk-ineq! (list '< (list '- (list 'real-part a)) n))))
    n))
(define (gx-subst-r f r) (subst-free 'gxr_ r f))
(define (gx-ms-pts!)
  (fact 'cc-is-metric-space)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))

;;; OMEGA is open
(sp (make-wff (list 'IS-OPEN 'CC-MS gx-OM)))
(gx-ms-pts!)
(dk-have! (list 'SUBSET gx-OM '(PTS CC-MS))
  (lambda () (subst '(== (PTS CC-MS) CC)) (let ((x (subset-by-element!))) (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN x gx-OM))))) (dk-ass!))))
(mac 'IS-OPEN)
(dk-conj-close!
  (lambda ()
    (if (not (dk-head-is? (dk-goal) 'FORALL)) (dk-ass!)
      (let* ((a (dk-di-var!)))
        (gx-om-mem! a)
        (let* ((m (gx-pick-m! a))
               (ex (dk-cite! 'gamma-omega-ball a m))
               (r (dk-skolem! (dk-ctx-form ex) #t))
               (ball (dk-ctx-form (gx-subst-r (gx-ball-goal a m) r))))
          (ew r)
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'POS-RR) (dk-ass!)
                (let ((w (subset-by-element!)))
                  (dk-apply! ball w)
                  (dk-split-all!)
                  (dk-ass!))))))))))
(qed 'gamma-omega-open)

;;; POCH(., m) is entire
(define (gx-PL m) (list 'VNB-LAMBDA 'gpw_ 'CC (list 'POCH 'gpw_ m)))
(sp (make-wff (list 'FORALL 'gxm_ (list 'IMPLIES '(IN gxm_ NN) (list 'HOLOMORPHIC-ON 'CC (gx-PL 'gxm_))))))
(ni)
(gx-induct!
  (lambda ()
    (let ((g1 '(VNB-LAMBDA gpw_ CC 1)) (f (gx-PL 0)))
      (fact 'nn-zero-in)
      (dk-have! (list 'HOLOMORPHIC-ON 'CC g1) (lambda () (dk-holomorphic! 'CC g1)))
      (gx-lam-typ! f 'CC 'CC (lambda (y) (dk-cite! 'poch-in-cc 0 y)))
      (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES '(IN hbx_ CC) (list '== (list f 'hbx_) (list g1 'hbx_))))
        (lambda () (let ((y (dk-di-var!))) (dk-lam-b!) (dk-cite! 'poch-zero y) (dk-ass!))))
      (dk-cite! 'holomorphic-transfer-ptwise-eq 'CC f g1)
      (dk-ass!)))
  (lambda ()
    (let* ((new (gx-steps!)) (m (gx-landed-var new 'NN))
           (ih (find-first (lambda (q) (dk-head-is? q 'HOLOMORPHIC-ON)) new))
           (plm (gx-PL m)) (f (gx-PL (list 'succ m))))
      (gx-nn-cc! m) (fact 'nn-succ-closed m)
      (dk-project! (list 'IN plm '(FUN CC CC)) 'HOLOMORPHIC-ON ih)
      (let* ((pv (dk-name! plm '(FUN CC CC)))
             (g (list 'VNB-LAMBDA 'gpw_ 'CC (list '* (list pv 'gpw_) (list '+ 'gpw_ m)))))
        (dk-rewrite-h! ih plm pv)
        (dk-have! (list 'HOLOMORPHIC-ON 'CC g) (lambda () (dk-holomorphic! 'CC g)))
        (gx-lam-typ! f 'CC 'CC (lambda (y) (dk-cite! 'poch-in-cc (list 'succ m) y)))
        (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES '(IN hbx_ CC) (list '== (list f 'hbx_) (list g 'hbx_))))
          (lambda ()
            (let ((y (dk-di-var!)))
              (dk-lam-b!)
              (subst (list '= pv plm))
              (dk-lam-b!)
              (dk-cite! 'poch-succ y m)
              (dk-ass!))))
        (dk-cite! 'holomorphic-transfer-ptwise-eq 'CC f g)
        (dk-ass!)))))
(qed 'poch-holomorphic)

(define gx-FL (list 'VNB-LAMBDA 'gew_ gx-OM '(GAMMA-EXT gew_)))
(define gx-NFM '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (gx-ext-cc! y)                       ; y in OMEGA (projections landed): GAMMA-EXT(y) in CC
  (let ((goal (list 'IN (list 'GAMMA-EXT y) 'CC)))
    (if (not (dk-asm? goal))
        (let ((m (gx-pick-m! y)))
          (gx-q-typed! y m)
          (let ((e (dk-cite! 'gamma-ext-value m y)))
            (dk-have! goal (lambda () (subst e) (dk-ass!))))))
    goal))
(define (gx-nf-open! u ms-open)              ; IS-OPEN(CC-MS, u) in context: the NF form
  (dk-cite! 'cc-ms-open-iff u)
  (dk-have! (list 'IS-OPEN gx-NFM u) (lambda () (mac 'cc-ms-open-iff) (dk-ass!))))

;;; the continuation is holomorphic on OMEGA
(sp (make-wff (list 'HOLOMORPHIC-ON gx-OM gx-FL)))
(dk-cite! 'gamma-omega-open)
(gx-nf-open! gx-OM #t)
(gx-lam-typ! gx-FL gx-OM 'CC (lambda (y) (gx-om-mem! y) (gx-ext-cc! y)))
(dk-cite! 'gamma-holomorphic)
(dk-project! (list 'IN gx-GL (list 'FUN gx-RHP 'CC)) 'HOLOMORPHIC-ON (list 'HOLOMORPHIC-ON gx-RHP gx-GL))
(mac 'HOLOMORPHIC-ON)
(dk-conj-close!
  (lambda ()
    (if (not (dk-head-is? (dk-goal) 'FORALL)) (dk-ass!)
      (let* ((a (dk-di-var!)))
        (gx-om-mem! a)
        (let* ((m (gx-pick-m! a))
               (ex (dk-cite! 'gamma-omega-ball a m))
               (r (dk-skolem! (dk-ctx-form ex) #t))
               (ball (dk-ctx-form (gx-subst-r (gx-ball-goal a m) r)))
               (bb (list 'BALL 'CC-MS a r))
               (plm (gx-PL m)))
          (fact 'rr-pos-rr-in-rr r) (fact 'rr-lt-of-pos-rr r)
          (gx-ms-pts!)
          ;; the ball: open, inside OMEGA, contains a
          (dk-have! (list 'IN a '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (dk-ass!)))
          (fact 'rr-zero-in)
          (dk-have! (list 'AND (list 'IN r 'RR) (list 'AND (list '<= 0 r) (list 'NOT (list '= 0 r))))
            (lambda () (dk-conj-close! (lambda () (cond ((dk-asm? (dk-goal)) (dk-ass!)) ((dk-head-is? (dk-goal) '<=) (dk-ineq! (list '< 0 r)))
                                                         (#t (dk-ne! 0 r (list '< 0 r)) (dk-ass!)))))))
          (dk-cite! 'ball-is-open 'CC-MS a r)
          (gx-nf-open! bb #t)
          (dk-cite! 'cc-ms-ball-centre a r)
          (dk-have! (list 'SUBSET bb gx-OM)
            (lambda () (let ((w (subset-by-element!))) (dk-apply! ball w) (dk-split-all!) (dk-ass!))))
          (dk-have! (list 'SUBSET bb 'CC)
            (lambda () (let* ((w (subset-by-element!)) (iff (gx-ball-iff! a r w))) (keep iff (list 'IN w bb)) (prop))))
          ;; the two named functions
          (dk-cite! 'poch-holomorphic m)
          (dk-project! (list 'IN plm '(FUN CC CC)) 'HOLOMORPHIC-ON (list 'HOLOMORPHIC-ON 'CC plm))
          (let* ((gv (dk-name! gx-GL (list 'FUN gx-RHP 'CC)))
                 (pv (dk-name! plm '(FUN CC CC)))
                 (g (list 'VNB-LAMBDA 'gyw_ bb (list '* (list gv (list '+ 'gyw_ m)) (list 'recip (list pv 'gyw_))))))
            (dk-rewrite-h! (list 'HOLOMORPHIC-ON gx-RHP gx-GL) gx-GL gv)
            (dk-rewrite-h! (list 'HOLOMORPHIC-ON 'CC plm) plm pv)
            ;; side conditions, in the user's form
            (dk-have! (list 'FORALL 'gyw_ (list 'IMPLIES (list 'IN 'gyw_ bb) (list 'IN (list '+ 'gyw_ m) gx-RHP)))
              (lambda ()
                (let* ((w (dk-di-var!)))
                  (dk-apply! ball w) (dk-split-all!) (gx-om-mem! w) (gx-cc! (list '+ w m))
                  (let ((re (gx-re-shift! w m)))
                    (in-sep! (lambda () (dk-ass!)) (lambda () (subst re) (dk-ass!)))))))
            (dk-have! (list 'FORALL 'gyw_ (list 'IMPLIES (list 'IN 'gyw_ bb) (list 'NOT (list '= (list pv 'gyw_) 0))))
              (lambda ()
                (let* ((w (dk-di-var!)))
                  (dk-apply! ball w) (dk-split-all!) (gx-om-mem! w)
                  (subst (list '= pv plm)) (dk-lam-b!)
                  (dk-cite! 'poch-nonzero m w) (dk-ass!))))
            (dk-have! (list 'FORALL 'gyw_ (list 'IMPLIES (list 'IN 'gyw_ bb) '(IN gyw_ CC)))
              (lambda () (let* ((w (dk-di-var!)) (iff (gx-ball-iff! a r w))) (keep iff (list 'IN w bb)) (prop))))
            (dk-have! (list 'HOLOMORPHIC-ON bb g) (lambda () (dk-holomorphic! bb g)))
            (let ((rf (list 'RESTRICT gx-FL bb))
                  (side (list 'FORALL 'gyw_ (list 'IMPLIES (list 'IN 'gyw_ bb) (list 'IN (list '+ 'gyw_ m) gx-RHP)))))
              (dk-cite! 'restrict-in-fun gx-FL gx-OM 'CC bb)
              (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ bb) (list '== (list rf 'hbx_) (list g 'hbx_))))
                (lambda ()
                  (let ((w (dk-di-var!)))
                    (dk-apply! ball w) (dk-split-all!) (gx-om-mem! w)
                    (gx-q-typed! w m)
                    (subst (dk-cite! 'restrict-apply gx-FL bb w))
                    (dk-lam-b!)
                    (subst (list '= gv gx-GL)) (subst (list '= pv plm))
                    (dk-lam-b!)
                    (let ((e (dk-cite! 'gamma-ext-value m w)))
                      (dk-close-if! (lambda () (subst e)) (lambda () (qrfl)))))))
              (dk-cite! 'holomorphic-transfer-ptwise-eq bb rf g)
              (let* ((ex2 (dk-cite! 'holomorphic-on-diff bb rf a))
                     (l (dk-skolem! (dk-ctx-form ex2))))
                (dk-cite! 'diff-on-local gx-OM gx-FL bb a l)
                (ew l)
                (dk-ass!)))))))))
(qed 'gamma-ext-holomorphic)

;;; ---------------------------------------------------------------- uniqueness
(define gx-SL '(SEP cxsu_ CC (NOT (AND (= (imag-part cxsu_) 0) (<= (real-part cxsu_) 0)))))
(define (gx-slit-cond t) (list 'NOT (list 'AND (list '= (list 'imag-part t) 0) (list '<= (list 'real-part t) 0))))
(define (gx-im-real! t)                      ; t in RR: Im t = 0
  (let ((e (list '= (list 'imag-part t) 0)))
    (if (not (dk-asm? e))
        (begin
          (fact 'rr-subset-cc t) (fact 'rr-zero-in) (fact 'cc-i-in)
          (dk-have! (list '= t (list '+ t '(* 0 +i))) (lambda () (crs)))
          (dk-split-all! (list (dk-cite! 'cc-re-im-of t t 0)))))
    e))
(define (gx-ball-coord! w c r proj)          ; w in BALL(CC-MS, c, r), c in CC, r in RR: (proj c) < (proj w) + r
  (let* ((lt (gx-ball-parts! w c r)) (wc (list '- w c)) (goal (list '< (list proj c) (list '+ (list proj w) r)))
         (inrr (if (eq? proj 'real-part) 'real-part-in-rr 'imag-part-in-rr)))
    (if (not (dk-asm? goal))
        (begin
          (for-each (lambda (t) (fact inrr t)) (list w c wc))
          (let* ((se (dk-cite! (if (eq? proj 'real-part) 'cc-re-sub 'cc-im-sub) w c))
                (ab (dk-cite! (if (eq? proj 'real-part) 'cc-abs-re-le-magnitude 'cc-abs-im-le-magnitude) wc)))
            (fact 'rr-abs-closed (list proj wc))
            (let ((lo (dk-cite! 'rr-neg-abs-le (list proj wc))))
              (dk-have! goal (lambda () (dk-ineq! lt se ab lo)))))))
    goal))

;;; the slit plane lies in OMEGA
(sp (make-wff (list 'SUBSET gx-SL gx-OM)))
(let* ((xv (subset-by-element!)))
  (dk-sep-parts! (list 'IN xv gx-SL))
  (fact 'real-part-in-rr xv) (fact 'imag-part-in-rr xv)
  (in-sep! (lambda () (dk-ass!))
    (lambda ()
      (let* ((nj (gx-steps!)) (j (gx-landed-var nj 'NN)) (xj (list '+ xv j)))
        (gx-nn-cc! j) (gx-cc! xj) (fact 'nn-zero-le j) (fact 'rr-zero-in)
        (di)
        (let* ((re (gx-re-shift! xv j))
               (re0 (begin (fact 'cc-re-of-real 0) (dk-rewrite-h! (dk-rewrite-h! re xj 0) (list 'real-part 0) 0)))
               (im (dk-cite! 'cc-im-add xv j))
               (imj (gx-im-real! j))
               (im0 (begin (fact 'cc-im-zero) (dk-rewrite-h! (dk-rewrite-h! im xj 0) (list 'imag-part 0) 0)))
               (cj (list 'AND (list '= (list 'imag-part xv) 0) (list '<= (list 'real-part xv) 0))))
          (fact 'imag-part-in-rr j)
          (dk-have! cj
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) '=)
                      (dk-ineq! im0 imj)
                      (dk-ineq! re0 (list '<= 0 j)))))))
          (ai (gx-slit-cond xv)))))))
(qed 'gamma-slit-in-omega)

(define (gx-zero-hyps dfn)
  (list (list 'HOLOMORPHIC-ON gx-OM dfn)
        (list 'FORALL 'gyz_ (list 'IMPLIES '(IN gyz_ CC) (list 'IMPLIES '(< 0 (real-part gyz_)) (list '= (list dfn 'gyz_) 0))))))
(define (gx-rhp-slit! w)                     ; w in CC, 0 < Re w in context: w in RHP and w in the slit plane
  (if (not (dk-asm? (list 'IN w gx-SL)))
      (begin
        (dk-have! (list 'IN w gx-RHP) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
        (dk-split-all! (list (dk-cite! 'right-half-plane-in-slit w)))))
  (list 'IN w gx-SL))
(define (gx-slit-open!)
  (let ((hl (dk-cite! 'cc-log-holomorphic)))
    (dk-project! (list 'IS-OPEN gx-NFM gx-SL) 'HOLOMORPHIC-ON hl)))

;;; a holomorphic function on OMEGA vanishing on the right half-plane vanishes on the slit plane
(sp (make-wff (list 'FORALL 'gxd_ (dk-curry (gx-zero-hyps 'gxd_)
  (list 'FORALL 'gxz_ (list 'IMPLIES (list 'IN 'gxz_ gx-SL) '(= (gxd_ gxz_) 0)))))))
(let* ((new (gx-steps!)) (hol (find-first (lambda (q) (dk-head-is? q 'HOLOMORPHIC-ON)) new)) (dd (caddr hol))
       (hyp (find-first (lambda (q) (gx-op? q 'FORALL 3)) new))
       (z (cadr (find-first (lambda (q) (and (gx-op? q 'IN 3) (equal? (caddr q) gx-SL))) new)))
       (ds (list 'RESTRICT dd gx-SL)) (half 1/2) (b1 (list 'BALL 'CC-MS 1 1/2)))
  (gx-slit-open!)
  (dk-cite! 'gamma-slit-in-omega)
  (dk-cite! 'holomorphic-on-restrict gx-OM dd gx-SL)
  (dk-cite! 'cc-slit-plane-connected)
  (fact 'cc-one-in) (fact 'rr-one-in) (fact 'rr-zero-in) (fact 'cc-is-metric-space)
  (dk-cite! 'cc-re-of-real 1)
  (dk-have! '(< 0 (real-part 1)) (lambda () (subst '(= (real-part 1) 1)) (dk-ineq!)))
  (gx-rhp-slit! 1)
  (dk-have! '(IN 1/2 RR) (lambda () (arith)))
  (dk-have! '(< 0 1/2) (lambda () (dk-ineq!)))
  (fact 'rr-pos-rr-of-lt 1/2)
  (let ((pt! (lambda (w)                    ; w in the ball about 1: w in CC, 0 < Re w, w in SL
               (gx-ball-parts! w 1 half)
               (gx-ball-coord! w 1 half 'real-part)
               (fact 'real-part-in-rr w)
               (dk-have! (list '< 0 (list 'real-part w))
                 (lambda () (dk-ineq! (list '< '(real-part 1) (list '+ (list 'real-part w) half)) '(= (real-part 1) 1))))
               (gx-rhp-slit! w))))
    (dk-have! (list 'SUBSET b1 gx-SL) (lambda () (let ((w (subset-by-element!))) (pt! w) (dk-ass!))))
    (dk-have! (list 'FORALL 'gyz_ (list 'IMPLIES (list 'IN 'gyz_ b1) (list '= (list ds 'gyz_) 0)))
      (lambda ()
        (let ((w (dk-di-var!)))
          (pt! w)
          (subst (dk-cite! 'restrict-apply dd gx-SL w))
          (dk-apply! hyp w)
          (dk-ass!)))))
  (dk-cite! 'ball-zeros-accumulate gx-SL ds 1 half)
  (let ((all (dk-cite! 'holomorphic-identity-principle gx-SL ds 1)))
    (dk-apply! all z)
    (dk-cite! 'restrict-apply dd gx-SL z)
    (subst (list '= (list dd z) (list ds z)))
    (dk-ass!)))
(qed 'gamma-zero-on-slit)

;;; ... and on all of OMEGA: a real point -n < a < -n + 1 is reached through a small ball
(sp (make-wff (list 'FORALL 'gxd_ (dk-curry (gx-zero-hyps 'gxd_)
  (list 'FORALL 'gxz_ (list 'IMPLIES (list 'IN 'gxz_ gx-OM) '(= (gxd_ gxz_) 0)))))))
(let* ((new (gx-steps!)) (hol (find-first (lambda (q) (dk-head-is? q 'HOLOMORPHIC-ON)) new)) (dd (caddr hol))
       (z (gx-landed-var new gx-OM))
       (slz (dk-cite! 'gamma-zero-on-slit dd)))
  (gx-om-mem! z) (fact 'real-part-in-rr z) (fact 'imag-part-in-rr z)
  (use-em (list 'AND (list '= (list 'imag-part z) 0) (list '<= (list 'real-part z) 0))
    (lambda ()
      (let* ((m (gx-pick-m! z))
             (ex (dk-cite! 'gamma-omega-ball z m))
             (r (dk-skolem! (dk-ctx-form ex) #t))
             (ball (dk-ctx-form (gx-subst-r (gx-ball-goal z m) r)))
             (bb (list 'BALL 'CC-MS z r)) (db (list 'RESTRICT dd bb)))
        (dk-split-all! (list (list 'AND (list '= (list 'imag-part z) 0) (list '<= (list 'real-part z) 0))))
        (fact 'rr-pos-rr-in-rr r) (fact 'rr-lt-of-pos-rr r) (fact 'rr-zero-in)
        (gx-ms-pts!)
        (dk-have! (list 'IN z '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (dk-ass!)))
        (dk-have! (list 'AND (list 'IN r 'RR) (list 'AND (list '<= 0 r) (list 'NOT (list '= 0 r))))
          (lambda () (dk-conj-close! (lambda () (cond ((dk-asm? (dk-goal)) (dk-ass!)) ((dk-head-is? (dk-goal) '<=) (dk-ineq! (list '< 0 r)))
                                                       (#t (dk-ne! 0 r (list '< 0 r)) (dk-ass!)))))))
        (dk-cite! 'ball-is-open 'CC-MS z r)
        (gx-nf-open! bb #t)
        (dk-cite! 'cc-ms-ball-centre z r)
        (dk-have! (list 'SUBSET bb gx-OM)
          (lambda () (let ((w (subset-by-element!))) (dk-apply! ball w) (dk-split-all!) (dk-ass!))))
        (dk-cite! 'holomorphic-on-restrict gx-OM dd bb)
        ;; b = Re z + d i, d = r/2; the small ball about b of radius e = d/2
        (let* ((d (dk-halve! r)) (e (dk-halve! d)) (xr (list 'real-part z))
               (b0 (list '+ xr (list '* d '+i)))
               (b (begin (fact 'cc-i-in) (fact 'rr-subset-cc xr) (fact 'rr-subset-cc d) (gx-cc! b0) (dk-name! b0 'CC)))
               (bz (list '- b z)) (eb (list 'BALL 'CC-MS b e)))
          (fact 'rr-pos-rr-in-rr e) (fact 'rr-lt-of-pos-rr e)
          (dk-split-all! (list (dk-cite! 'cc-re-im-of b xr d)))
          (fact 'cc-sub-in-cc b z)
          (for-each (lambda (t) (fact 'real-part-in-rr t) (fact 'imag-part-in-rr t)) (list b bz))
          (let* ((rs (dk-cite! 'cc-re-sub b z)) (is (dk-cite! 'cc-im-sub b z))
                 (rbz (list 'real-part bz)) (ibz (list 'imag-part bz)))
            (dk-have! (list '<= (list '- 0) rbz) (lambda () (dk-ineq! rs (list '= (list 'real-part b) xr))))
            (dk-have! (list '<= rbz 0) (lambda () (dk-ineq! rs (list '= (list 'real-part b) xr))))
            (dk-have! (list '<= (list '- d) ibz) (lambda () (dk-ineq! is (list '= (list 'imag-part b) d) (list '= (list 'imag-part z) 0) (list '< 0 d))))
            (dk-have! (list '<= ibz d) (lambda () (dk-ineq! is (list '= (list 'imag-part b) d) (list '= (list 'imag-part z) 0))))
            (dk-cite! 'rr-abs-le-of-parts rbz 0) (dk-cite! 'rr-abs-le-of-parts ibz d)
            (fact 'rr-abs-closed rbz) (fact 'rr-abs-closed ibz) (fact 'cc-magnitude-closed bz)
            (let ((le (dk-cite! 'cc-magnitude-le-re-im bz)))
              (dk-have! (list '<= (list 'magnitude bz) d)
                (lambda () (dk-ineq! le (list '<= (list 'abs rbz) 0) (list '<= (list 'abs ibz) d))))
              (dk-have! (list '< (list 'magnitude bz) r)
                (lambda () (dk-ineq! le (list '<= (list 'abs rbz) 0) (list '<= (list 'abs ibz) d) (list '= (list '+ d d) r) (list '< 0 d))))))
          (let ((iffb (gx-ball-iff! z r b)))
            (dk-have! (list 'IN b bb) (lambda () (keep iffb (list 'IN b 'CC) (list '< (list 'magnitude bz) r)) (prop))))
          (fact 'cc-ms-ball-membership b e) (fact 'cc-ms-ball-membership z r)
;;           ept!: w in the small ball: w in the slit plane, then w in bb (LAST: in the SUBSET lane that claim is the goal)
          (let ((ept! (lambda (w)
                        (let* ((lt (gx-ball-parts! w b e)) (wz (list '- w z)))
                          (gx-ball-coord! w b e 'imag-part)
                          (fact 'imag-part-in-rr w) (fact 'real-part-in-rr w)
                          (dk-have! (list 'IN w gx-SL)
                            (lambda ()
                              (in-sep! (lambda () (dk-ass!))
                                (lambda ()
                                  (di)
                                  (dk-split-all!)
                                  (dk-absurd! (list '< (list 'imag-part b) (list '+ (list 'imag-part w) e))
                                              (list '= (list 'imag-part b) d) (list '= (list 'imag-part w) 0)
                                              (list '= (list '+ e e) d) (list '< 0 e))))))
                          (gx-cc! wz)
                          (let ((ch (dk-cite! 'cc-magnitude-sub-chain w b z)))
                            (fact 'cc-magnitude-closed wz)
                            (dk-have! (list '< (list 'magnitude wz) r)
                              (lambda () (dk-ineq! ch lt (list '<= (list 'magnitude bz) d) (list '= (list '+ e e) d) (list '= (list '+ d d) r) (list '< 0 e)))))
                          (let ((iffw (gx-ball-iff! z r w)))
                            (dk-have! (list 'IN w bb) (lambda () (keep iffw (list 'IN w 'CC) (list '< (list 'magnitude wz) r)) (prop))))))))
            (dk-have! (list 'SUBSET eb bb) (lambda () (let ((w (subset-by-element!))) (ept! w))))
            (dk-have! (list 'FORALL 'gyz_ (list 'IMPLIES (list 'IN 'gyz_ eb) (list '= (list db 'gyz_) 0)))
              (lambda ()
                (let ((w (dk-di-var!)))
                  (ept! w)
                  (subst (dk-cite! 'restrict-apply dd bb w))
                  (dk-apply! slz w)
                  (dk-ass!)))))
          (dk-cite! 'ball-zeros-accumulate bb db b e)
          (let ((all (dk-cite! 'identity-principle-ball z r)))
            (dk-apply! all db b z)
            (dk-cite! 'restrict-apply dd bb z)
            (subst (list '= (list dd z) (list db z)))
            (dk-ass!)))))
    (lambda ()
      (dk-have! (list 'IN z gx-SL) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
      (dk-apply! slz z)
      (dk-ass!))))
(qed 'gamma-continuation-zero)

;;; ======================================================================
;;; PROPOSITION 3.60.  Gamma has a unique analytic extension to the complement OMEGA of the
;;; non-positive integers, and the extension satisfies (101), Gamma(z + 1) = z Gamma(z), on OMEGA.
;;; ======================================================================
(define (gx-rhp-agree g)
  (list 'FORALL 'gyz_ (list 'IMPLIES '(IN gyz_ CC) (list 'IMPLIES '(< 0 (real-part gyz_)) (list '= (list g 'gyz_) '(GAMMA-FUNCTION gyz_))))))
(define (gx-close-diff! pa qa)                 ; goal (= P Q), (= (- P Q) 0) in context, P Q typed CC
  (dk-have! (list '= pa (list '+ (list '- pa qa) qa)) (lambda () (crs)))
  (subst (list '= pa (list '+ (list '- pa qa) qa)))
  (subst (list '= (list '- pa qa) 0))
  (crs))
(sp (make-wff
  (list 'AND (list 'HOLOMORPHIC-ON gx-OM gx-FL)
  (list 'AND '(FORALL gxz_ (IMPLIES (IN gxz_ CC) (IMPLIES (< 0 (real-part gxz_))
                 (= (GAMMA-EXT gxz_) (GAMMA-FUNCTION gxz_)))))
  (list 'AND (list 'FORALL 'gxz_ (list 'IMPLIES (list 'IN 'gxz_ gx-OM)
                 (list 'AND (list 'IN '(+ gxz_ 1) gx-OM) '(= (GAMMA-EXT (+ gxz_ 1)) (* gxz_ (GAMMA-EXT gxz_))))))
    (list 'FORALL 'gxg_ (list 'IMPLIES (list 'HOLOMORPHIC-ON gx-OM 'gxg_) (list 'IMPLIES (gx-rhp-agree 'gxg_)
      (list 'FORALL 'gxz_ (list 'IMPLIES (list 'IN 'gxz_ gx-OM) '(= (gxg_ gxz_) (GAMMA-EXT gxz_))))))))))))
(dk-cite! 'gamma-ext-holomorphic)
(dk-conj-close!
  (lambda ()
    (let ((goal (dk-goal)))
      (cond
        ((dk-asm? goal) (dk-ass!))
        ((dk-contains? goal 'gxg_)
         (let* ((new (gx-steps!)) (hol (find-first (lambda (q) (dk-head-is? q 'HOLOMORPHIC-ON)) new)) (g (caddr hol))
                (agree (find-first (lambda (q) (gx-op? q 'FORALL 3)) new))
                (z (gx-landed-var new gx-OM)))
           (dk-project! (list 'IN g (list 'FUN gx-OM 'CC)) 'HOLOMORPHIC-ON hol)
           (dk-cite! 'gamma-ext-holomorphic)
           (dk-project! (list 'IN gx-FL (list 'FUN gx-OM 'CC)) 'HOLOMORPHIC-ON (list 'HOLOMORPHIC-ON gx-OM gx-FL))
           (dk-cite! 'gamma-omega-open) (gx-nf-open! gx-OM #t)
           (let* ((fv (dk-name! gx-FL (list 'FUN gx-OM 'CC)))
                  (dl (list 'VNB-LAMBDA 'gyu_ gx-OM (list '- (list g 'gyu_) (list fv 'gyu_)))))
             (dk-rewrite-h! (list 'HOLOMORPHIC-ON gx-OM gx-FL) gx-FL fv)
             (dk-have! (list 'FORALL 'gyu_ (list 'IMPLIES (list 'IN 'gyu_ gx-OM) (list 'IN 'gyu_ gx-OM)))
               (lambda () (dk-di-var!) (dk-ass!)))
             (dk-have! (list 'HOLOMORPHIC-ON gx-OM dl) (lambda () (dk-holomorphic! gx-OM dl)))
             (let ((pt! (lambda (w)          ; w in OMEGA: (dl w) = g w - GAMMA-EXT w, all typed
                          (gx-om-mem! w)
                          (fact 'fun-apply-type-c g gx-OM 'CC w)
                          (gx-ext-cc! w)
                          (let ((e (list '= (list dl w) (list '- (list g w) (list 'GAMMA-EXT w)))))
                            (dk-have! e
                              (lambda ()
                                (dk-lam-b!)
                                (subst (list '= fv gx-FL))
                                (dk-lam-b!)
                                (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-close-if! (lambda () #t) (lambda () (rfl))))))
                            e))))
               (dk-have! (list 'FORALL 'gyz_ (list 'IMPLIES '(IN gyz_ CC) (list 'IMPLIES '(< 0 (real-part gyz_)) (list '= (list dl 'gyz_) 0))))
                 (lambda ()
                   (let* ((nw (gx-steps!)) (w (gx-landed-var nw 'CC)))
                     (dk-cite! 'gamma-rhp-in-omega w)
                     (let ((e (pt! w)))
                       (subst e)
                       (dk-apply! agree w)
                       (dk-cite! 'gamma-ext-extends w) (dk-split-all!)
                       (subst (list '= (list g w) (list 'GAMMA-FUNCTION w)))
                       (subst (list '= (list 'GAMMA-EXT w) (list 'GAMMA-FUNCTION w)))
                       (gx-gam-cc! w)
                       (crs)))))
               (let ((zz (dk-cite! 'gamma-continuation-zero dl)))
                 (dk-apply! zz z)
                 (let ((e (pt! z)))
                   (dk-rewrite-h! (list '= (list dl z) 0) (list dl z) (list '- (list g z) (list 'GAMMA-EXT z)))
                   (gx-close-diff! (list g z) (list 'GAMMA-EXT z))))))))
        ((dk-contains? goal 'GAMMA-FUNCTION)
         (let* ((new (gx-steps!)) (z (gx-landed-var new 'CC)))
           (dk-cite! 'gamma-ext-extends z) (dk-split-all!) (dk-ass!)))
        (#t
         (let* ((new (gx-steps!)) (z (gx-landed-var new gx-OM)))
           (dk-cite! 'gamma-omega-shift z) (dk-cite! 'gamma-ext-recursion z)
           (dk-conj-close! (lambda () (dk-ass!)))))))))
(qed 'gamma-analytic-continuation)

  
