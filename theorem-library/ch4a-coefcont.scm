;;; ch4a-coefcont.scm -- Proposition 5.26 (CH4-A, 2026-10-29): each Laurent coefficient is a continuous linear
;;; functional on H(u).  The scalars CC are the module RING-AS-MODULE(NFCR(CC-NORMED-FIELD)) with the family of
;;; seminorms k |-> |.|; H(u) is CC-FN-MODULE(u, CC-HOL-FNS(u)) with CC-EXHAUST-SEMINORMS (ca5-frechet,
;;; catools-hfrechet); continuity is read off frechet-metric's frm-cont-lin-of-bound.
;;; Library: complex-analysis.  Load window: after ch4a-expansion (laurent-coefs-in-fun), catools-hfrechet,
;;; frechet-metric, la-z3-quotient (ring-as-module-is-module), compact-image (path-trace-compact), ca6-hurwitz
;;; (cc-hol-fn-module-is-module, cc-hol-fns-add / -scale), ca5-function-spaces.  Prefix lk-.

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define lk-ccr '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define lk-MCC (list 'RING-AS-MODULE lk-ccr))
(define lk-PCC '(VNB-LAMBDA lkk_ NN (VNB-LAMBDA lkz_ CC (magnitude lkz_))))
;;; (1) the slots of RING-AS-MODULE(R) for a ring R (the tuple denotes: its components are sets)
(define (lk-occurs? s e) (or (equal? s e) (and (pair? e) (or (lk-occurs? s (car e)) (lk-occurs? s (cdr e))))))
(define (lk-ring-open!)
  (let* ((iff (dk-cite! 'is-ring 'R)) (rhs (dk-meta-iff-r! iff)))
    (dk-split-all! (list (dk-ctx-form rhs))))
  (let ((iff (dk-meta-iff! 'ring-class 'R)))
    (dk-meta-iff-l! iff)
    (fact 'membership-implies-sethood 'R 'RING)))
;;; CUT 2026-10-30 (wave-2 integration): the five generated read-offs lk-ram-scal / -vec / -vadd / -vzero / -act
;;; were alpha-equal duplicates of la-z3-quotient.scm's ram-ro-scal / -vec / -vadd / -vzero / -act (proven-duplicate
;;; audit); their generator lk-slot! (a helper calling bare sp / qed) is gone and the citations name ram-ro-*.






;;; (2) the scalars CC as a module over NFCR(CC-NORMED-FIELD), seminormed by k |-> |.|
(define (lk-scalar-setup!)
  (fact 'cc-is-normed-field)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
  (dk-cite! 'commutative-ring-is-ring lk-ccr)
  (dk-cite! 'ring-as-module-is-module lk-ccr)
  (for-each (lambda (n) (dk-cite! n lk-ccr)) '(ram-ro-scal ram-ro-vec ram-ro-vadd ram-ro-vzero ram-ro-act))
  (for-each (lambda (n) (fact n)) '(cc-scalar-ring-carr cc-scalar-ring-add cc-scalar-ring-mul cc-scalar-ring-zero))
  (fact 'cc-is-set) (fact 'cc-zero-in))
(define (lk-cc-of! x)                ; (IN x (VEC MCC)) or (IN x (CARR ccr)) in context: land (IN x CC)
  (if (not (dk-asm? (list 'IN x 'CC)))
      (dk-have! (list 'IN x 'CC)
        (lambda ()
          (cond ((dk-asm? (list 'IN x (list 'VEC lk-MCC)))
                 (subst (list '== 'CC (list 'CARR lk-ccr))) (subst (list '== (list 'CARR lk-ccr) (list 'VEC lk-MCC))) (ass))
                ((dk-asm? (list 'IN x (list 'CARR (list 'SCAL lk-MCC))))
                 (subst (list '== 'CC (list 'CARR lk-ccr))) (subst (list '== lk-ccr (list 'SCAL lk-MCC))) (ass))
                (#t (subst (list '== 'CC (list 'CARR lk-ccr))) (ass)))))))
(define (lk-slots!)                   ; read the module slots of MCC off the focus goal
  (for-each (lambda (pr) (if (lk-occurs? (car pr) (dk-goal)) (subst (list '== (car pr) (cadr pr)))))
            (list (list (list 'VADD lk-MCC) (list 'ADD lk-ccr)) (list (list 'ACT lk-MCC) (list 'MUL lk-ccr))
                  (list (list 'VZERO lk-MCC) (list 'ZERO lk-ccr)) (list (list 'VEC lk-MCC) (list 'CARR lk-ccr))
                  (list (list 'SCAL lk-MCC) lk-ccr)))
  (for-each (lambda (pr) (if (lk-occurs? (car pr) (dk-goal)) (subst (list '== (car pr) (cadr pr)))))
            (list (list (list 'ADD lk-ccr) '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (+ x_ y_)))
                  (list (list 'MUL lk-ccr) '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (* x_ y_)))
                  (list (list 'ZERO lk-ccr) 0) (list (list 'CARR lk-ccr) 'CC))))
(define (lk-red! g)                   ; read the module slots off a goal and beta-reduce
  (for-each (lambda (pr) (if (lk-occurs? (car pr) (dk-goal)) (subst (list '== (car pr) (cadr pr)))))
            (list (list (list 'VADD lk-MCC) (list 'ADD lk-ccr)) (list (list 'ACT lk-MCC) (list 'MUL lk-ccr))
                  (list (list 'VZERO lk-MCC) (list 'ZERO lk-ccr)) (list (list 'VEC lk-MCC) (list 'CARR lk-ccr))
                  (list (list 'SCAL lk-MCC) lk-ccr)))
  (for-each (lambda (pr) (if (lk-occurs? (car pr) (dk-goal)) (subst (list '== (car pr) (cadr pr)))))
            (list (list (list 'ADD lk-ccr) '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (+ x_ y_)))
                  (list (list 'MUL lk-ccr) '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (* x_ y_)))
                  (list (list 'ZERO lk-ccr) 0) (list (list 'CARR lk-ccr) 'CC)))
  (if (dk--redex? (dk-goal)) (dk-lam-b!)))
(sp (make-wff (list 'IS-SEMINORM-FAMILY 'CC-NORMED-FIELD lk-MCC lk-PCC)))
(lk-scalar-setup!)
(mac 'IS-SEMINORM-FAMILY)
(define (lk-typ-fam!)
  (dk-lam-type! (lambda () (let ((k (dk-di-var!)))
                             (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (fact 'cc-magnitude-closed x) (if (pair? (dk-open-leaves)) (ass)))))))))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ((dk-head-is? g '=) (lk-red! g) (if (pair? (dk-open-leaves)) (rfl)))
        ((dk-head-is? g 'IN) (lk-red! g) (if (pair? (dk-open-leaves)) (lk-typ-fam!)))
        ((dk-contains? g 'IS-SEMINORM)
         (let ((k (dk-di-var!)))
           (mac 'IS-SEMINORM)
           (dk-conj-close!
             (lambda ()
               (let ((g2 (dk-goal)))
                 (cond
                   ((dk-asm? g2) (ass))
                   ((dk-head-is? g2 '=) (lk-red! g2) (if (pair? (dk-open-leaves)) (rfl)))
                   ((dk-head-is? g2 'IN)
                    (lk-red! g2)
                    (if (pair? (dk-open-leaves))
                        (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (fact 'cc-magnitude-closed x) (if (pair? (dk-open-leaves)) (ass)))))))
                   ((dk-contains? g2 'FNRM)    ; homogeneity
                    (let* ((pl (dk-peel!)) (lam (cadr (car pl))) (x (cadr (cadr pl))))
                      (lk-cc-of! lam) (lk-cc-of! x)
                      (dk-have! (list 'AND (list 'IN lam 'CC) (list 'IN x 'CC)))
                      (fact 'cc-mul-closed lam x) (fact 'cc-magnitude-closed (list '* lam x)) (fact 'cc-magnitude-closed x)
                      (lk-red! g2) (if (dk--redex? (dk-goal)) (dk-lam-b!))
                      (dk-cite! 'cc-nf-fnrm-apply lam)
                      (subst (list '== (list '(FNRM CC-NORMED-FIELD) lam) (list 'magnitude lam)))
                      (dk-have! (list 'AND (list 'IN lam 'CC) (list 'IN x 'CC)))
                      (dk-cite! 'cc-magnitude-mul lam x)
                      (if (pair? (dk-open-leaves)) (ass))))
                   ((dk-contains? g2 '+)       ; subadditivity
                    (let* ((pl (dk-peel!)) (x (cadr (car pl))) (y (cadr (cadr pl))))
                      (lk-cc-of! x) (lk-cc-of! y)
                      (dk-have! (list 'AND (list 'IN x 'CC) (list 'IN y 'CC)))
                      (fact 'cc-add-closed x y)
                      (fact 'cc-magnitude-closed (list '+ x y))
                      (lk-red! g2) (if (dk--redex? (dk-goal)) (dk-lam-b!))
                      (dk-cite! 'cc-magnitude-le-add (list '+ x y) y)
                      (dk-have! (list '= (list '- (list '+ x y) y) x) (lambda () (crs)))
                      (fact 'cc-magnitude-closed x) (fact 'cc-magnitude-closed y) (fact 'cc-magnitude-closed (list '+ x y))
                      (fact 'cc-sub-in-cc (list '+ x y) y) (fact 'cc-magnitude-closed (list '- (list '+ x y) y))
                      (dk-have! (list '= (list 'magnitude (list '- (list '+ x y) y)) (list 'magnitude x))
                        (lambda () (subst (list '= (list '- (list '+ x y) y) x)) (rfl)))
                      (dk-ineq! (list '<= (list 'magnitude (list '+ x y)) (list '+ (list 'magnitude (list '- (list '+ x y) y)) (list 'magnitude y)))
                                (list '= (list 'magnitude (list '- (list '+ x y) y)) (list 'magnitude x))
                                (list 'IN (list 'magnitude x) 'RR) (list 'IN (list 'magnitude y) 'RR) (list 'IN (list 'magnitude (list '+ x y)) 'RR)
                                (list 'IN (list 'magnitude (list '- (list '+ x y) y)) 'RR))))
                   (#t                          ; nonnegativity
                    (let* ((x (dk-di-var!)))
                      (lk-cc-of! x)
                      (lk-red! g2) (if (dk--redex? (dk-goal)) (dk-lam-b!))
                      (fact 'cc-magnitude-nonneg x)
                      (if (pair? (dk-open-leaves)) (ass))))))))))
        (#t                                    ; separation
         (let* ((x (dk-di-var!)))
           (lk-cc-of! x)
           (di)
           (fact 'nn-zero-in)
           (ew 0)
           (dk-conj-close!
             (lambda ()
               (if (dk-asm? (dk-goal)) (ass)
                   (begin
                     (if (dk--redex? (dk-goal)) (dk-lam-b!))
                     (di)
                     (let ((iff (dk-cite! 'cc-magnitude-zero-iff x)))
                       (dk-have! (list '= x 0) (lambda () (if (dk-only! iff (list '= (list 'magnitude x) 0)) (prop))))
                       (dk-have! (list '= x (list 'VZERO lk-MCC))
                         (lambda () (subst (list '== (list 'VZERO lk-MCC) (list 'ZERO lk-ccr))) (subst (list '== (list 'ZERO lk-ccr) 0)) (ass)))
                       (ai (list 'NOT (list '= x (list 'VZERO lk-MCC)))))))))))))))
(for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (if (dk--redex? (dk-goal)) (dk-lam-b!)) (if (pair? (dk-open-leaves)) (rfl))))) (dk-open-leaves))
(qed 'lk-cc-seminorm-family)

;;; (3) PROPOSITION 5.26: for u open, the circle |w - a| = rho inside u and k in ZZ, f |-> c_k(f) = LAURENT-COEFS(f, a, rho)(k)
;;; is a continuous linear functional on H(u): linear by laurent-coef-add / -scale, and bounded by one seminorm of the
;;; exhaustion (the compact trace lies in some K_n) through the Cauchy estimate laurent-coef-sup-bound:
;;;   |c_k(f)| <= rho (1/rho)^(k+1) sup_{K_n} |f|  (k >= 0),    |c_-(l+1)(f)| <= rho rho^l sup_{K_n} |f|.
(define lk-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define lk-H '(CC-HOL-FNS u))
(define lk-C '(CC-CONT-FNS u))
(define lk-MH (list 'CC-FN-MODULE 'u lk-H))
(define lk-PH (list 'CC-EXHAUST-SEMINORMS 'u lk-H))
(define lk-tp '(* 2 PI))
(define lk-T (list 'TRACE '(CIRCLE-PATH a rho) 0 lk-tp))
(define (lk-cf F) (list 'LAURENT-COEFS F 'a 'rho))
(define (lk-L kk) (list 'VNB-LAMBDA 'lkf_ lk-H (list (lk-cf 'lkf_) kk)))
(define (lk-only-prop! . fs) ((dk-lane (lambda () (apply dk-only! fs) (dk-lane-if! prop)))))
(define (lk-hol! f)                    ; f in H in context: f in FUN(u, CC), HOLOMORPHIC-ON(u, f)
  (let* ((hi (dk-cite! 'cc-hol-fns-membership 'u f)) (hr (caddr hi)))
    (if (not (dk-asm? hr)) (dk-have! hr (lambda () (lk-only-prop! hi (list 'IN f lk-H)))))
    (dk-split-all! (list (dk-ctx-form hr)))))
(define (lk-cf-typ! f kk)              ; f holomorphic on u: (IN (CF_f kk) CC), kk in ZZ in context
  (let ((typ (list 'IN (list (lk-cf f) kk) 'CC)))
    (if (not (dk-asm? typ))
        (begin
          (dk-cite! 'laurent-coefs-in-fun 'u f 'a 'rho)
          (fact 'fun-apply-type-c (lk-cf f) 'ZZ 'CC kk)))
    typ))
(define (lk-fsum x y) (list 'VNB-LAMBDA 'cfz_ 'u (list '+ (list x 'cfz_) (list y 'cfz_))))
(define (lk-fscale c x) (list 'VNB-LAMBDA 'cfz_ 'u (list '* c (list x 'cfz_))))
(define (lk-pick-conj and-form pos?) (if pos? (cadr and-form) (caddr and-form)))
(define (lk-main! n pos?)
  (let* ((kk (if pos? n (list '- (list '+ n 1))))
         (L (lk-L kk))
         (fac (if pos? (list 'power '(recip rho) (list 'succ n)) (list 'power 'rho n)))
         (ck (list '* 'rho fac))
         (slot-eqs (map (lambda (nm) (dk-cite! nm 'u lk-H)) '(cc-fn-module-scal cc-fn-module-vec cc-fn-module-vadd cc-fn-module-act)))
         (vaddH (caddr (list-ref slot-eqs 2))) (actH (caddr (list-ref slot-eqs 3))))
    ;; linearity
    (let* ((li (dk-cite! 'is-linear-map lk-MH lk-MCC L)) (lr (caddr li)))
      (dk-have! lr
        (lambda ()
          (for-each (lambda (e) (if (lk-occurs? (cadr e) (dk-goal)) (subst e))) slot-eqs)
          (lk-slots!)
          (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond
                  ((dk-asm? g) (ass))
                  ((dk-head-is? g '=) (rfl))
                  ((dk-head-is? g 'IN)
                   (dk-lam-type!
                     (lambda ()
                       (let* ((f (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                         (lk-hol! f) (lk-cf-typ! f kk)
                         (if (dk--redex? (dk-goal)) (dk-lam-b!))
                         (if (not (sequent-node-grounded? leaf)) (ass))))))
                  (#t
                   (let* ((lk (dk-peel!)) (leaf (proof-state-focus *ps*))
                          (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) lk-H))) lk)))
                          (ss (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC))) lk))))
                     (for-each (lambda (x) (lk-hol! x) (lk-cf-typ! x kk)) vs)
                     (if (null? ss)
                         (let* ((x (car vs)) (y (cadr vs)) (h (lk-fsum x y)))
                           (dk-cite! 'cc-hol-fns-add 'u x y)
                           (lk-hol! h) (lk-cf-typ! h kk)
                           (dk-have! (list 'FORALL 'lxz_ (list 'IMPLIES '(IN lxz_ u) (list '== (list h 'lxz_) (list '+ (list x 'lxz_) (list y 'lxz_)))))
                             (lambda () (let ((z (dk-di-var!))) (if (not (dk-lam-b!)) (qrfl)))))
                           (dk-split-all! (list (dk-cite! 'laurent-coef-add 'u x y h 'a 'rho n)))
                           (dk-lam-b!)
                           (if (not (sequent-node-grounded? leaf)) (ass)))
                         (let* ((c (car ss)) (x (car vs)) (h (lk-fscale c x)))
                           (dk-cite! 'cc-hol-fns-scale 'u c x)
                           (lk-hol! h) (lk-cf-typ! h kk)
                           (dk-have! (list 'FORALL 'lxz_ (list 'IMPLIES '(IN lxz_ u) (list '== (list h 'lxz_) (list '* c (list x 'lxz_)))))
                             (lambda () (let ((z (dk-di-var!))) (if (not (dk-lam-b!)) (qrfl)))))
                           (dk-split-all! (list (dk-cite! 'laurent-coef-scale c 'u x h 'a 'rho n)))
                           (dk-lam-b!)
                           (if (not (sequent-node-grounded? leaf)) (ass))))))))))))
      (dk-have! (list 'IS-LINEAR-MAP lk-MH lk-MCC L) (lambda () (lk-only-prop! li lr))))
    ;; the bound, and the citation
    (let* ((imp (dk-cite! 'frm-cont-lin-of-bound 'CC-NORMED-FIELD lk-MH lk-PH lk-MCC lk-PCC L))
           (bnd (cadr imp)))
      (dk-have! bnd
        (lambda ()
          (let* ((kn (dk-di-var!)))
            (dk-cite! 'circle-is-road 'a 'rho)
            (fact 'is-road-is-path '(CIRCLE-PATH a rho) '(CIRCLE-DERIV a rho) 0 lk-tp)
            (dk-cite! 'path-trace-compact '(CIRCLE-PATH a rho) 0 lk-tp)
            (let* ((nb (dk-skolem! (dk-cite! 'cc-exhaust-exhaustive 'u lk-T)))
                   (K (list 'CC-EXHAUST 'u nb)))
              (dk-split-all!)
              (ew nb)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal)) (ass)
                      (begin
                        (fact 'rr-pos-ne-zero 'rho)
                        (dk-have! '(AND (IN rho RR) (NOT (= rho 0))))
                        (fact 'rr-recip-closed 'rho) (fact 'rr-recip-pos 'rho)
                        (if pos? (fact 'nn-succ-closed n))
                        (fact 'power-real-closed (cadr fac) (caddr fac))
                        (dk-type! ck 'RR)
                        (ew ck)
                        (dk-conj-close!
                          (lambda ()
                            (let ((g (dk-goal)))
                              (cond
                                ((dk-asm? g) (ass))
                                ((dk-head-is? g 'POS-RR)
                                 (fact 'rr-pos-ne-zero 'rho)
                                 (dk-have! '(AND (IN rho RR) (NOT (= rho 0))))
                                 (fact 'rr-recip-closed 'rho) (fact 'rr-recip-pos 'rho)
                                 (if pos? (fact 'nn-succ-closed n))
                                 (fact 'rr-power-pos (cadr fac) (caddr fac))
                                 (fact 'power-real-closed (cadr fac) (caddr fac))
                                 (dk-type! ck 'RR)
                                 (dk-have! (list 'AND (list '< 0 'rho) (list '< 0 fac)))
                                 (dk-have! (list '< 0 ck) (lambda () (fact 'rr-mul-pos 'rho fac) (if (pair? (dk-open-leaves)) (ass))))
                                 (fact 'rr-pos-rr-of-lt ck)
                                 (if (pair? (dk-open-leaves)) (ass)))
                                (#t
                                 (let* ((lk (dk-peel!)) (leaf (proof-state-focus *ps*))
                                        (x (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'VEC lk-MH)))) lk))))
                                        (r (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) lk))))
                                        (hyp (car (filter (lambda (f) (dk-head-is? f 'FORALL)) lk)))
                                        (S (list 'CC-SUP-NORM x K)))
                                   (dk-have! (list 'IN x lk-H) (lambda () (subst (list '== lk-H (list 'VEC lk-MH))) (ass)))
                                   (lk-hol! x) (lk-cf-typ! x kk)
                                   (dk-cite! 'holomorphic-on-continuous 'u x)
                                   (dk-split-all! (list (dk-cite! 'cc-exhaust-seminorm-real 'u x nb)))
                                   (fact 'nn-in-rr nb)
                                   (dk-have! (list '<= nb nb) (lambda () (dk-ineq! (list 'IN nb 'RR))))
                                   (let* ((h1 (dk-apply! hyp nb)))
                                     (let ((ue (dk-cite! 'cc-exhaust-seminorms-unfold 'u lk-H)))
                                       (dk-have! (list '= (list (list lk-PH nb) x) S)
                                         (lambda () (subst ue) (if (not (dk-lam-b!)) (rfl)))))
                                     (dk-rewrite-h! h1 (list (list lk-PH nb) x) S))
                                   (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '<= 0 S) (list '<= S r) (list 'IN S 'RR) (list 'IN r 'RR))))
                                   (dk-cite! 'cc-exhaust-subset 'u nb)
                                   (dk-have! (list 'FORALL 'lkby_ (list 'IMPLIES (list 'IN 'lkby_ K) (list 'IN (list x 'lkby_) 'CC)))
                                     (lambda () (let* ((y (dk-di-var!)) (lf (proof-state-focus *ps*))) (fact 'subset-mem-fwd K 'u y) (fact 'fun-apply-type-c x 'u 'CC y) (if (not (sequent-node-grounded? lf)) (ass)))))
                                   (let ((up (dk-cite! 'cc-sup-norm-upper x K)))
                                   (dk-have! (list 'FORALL 'aiy_ (list 'IMPLIES (list 'IN 'aiy_ lk-T) (list '<= (list 'magnitude (list x 'aiy_)) r)))
                                     (lambda ()
                                       (let ((w (dk-di-var!)))
                                         (fact 'subset-mem-fwd lk-T K w)
                                         (fact 'subset-mem-fwd K 'u w)
                                         (fact 'fun-apply-type-c x 'u 'CC w)
                                         (fact 'cc-magnitude-closed (list x w))
                                         (dk-apply! up w)
                                         (dk-ineq! (list '<= (list 'magnitude (list x w)) S) (list '<= S r) (list 'IN S 'RR) (list 'IN r 'RR)
                                                   (list 'IN (list 'magnitude (list x w)) 'RR))))))
                                   (let* ((sb (dk-cite! 'laurent-coef-sup-bound 'u x 'a 'rho r n)))
                                     (dk-split-all! (list (dk-ctx-form sb)))
                                     (dk-lam-b!)
                                     (if (not (sequent-node-grounded? leaf)) (ass)))))))))))))))
          ))
      (let ((leaf (proof-state-focus *ps*)))
        (detach! imp)
        (if (not (sequent-node-grounded? leaf)) (ass))))))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN lk-nfm 'u) (list 'FORALL 'a (list 'IMPLIES '(IN a CC)
  (list 'FORALL 'rho (list 'IMPLIES '(IN rho RR) (list 'IMPLIES '(< 0 rho) (list 'IMPLIES (list 'SUBSET lk-T 'u)
    (list 'FORALL 'lkq_ (list 'IMPLIES '(IN lkq_ ZZ) (list 'IS-CONT-LIN lk-MH lk-PH lk-MCC lk-PCC (lk-L 'lkq_))))))))))))))
(dk-peel!)
(lk-scalar-setup!)
(fact 'cc-open-subset-cc 'u)
(fact 'subclass-of-set-is-set 'u 'CC)
(dk-cite! 'cc-cont-fns-is-set 'u) (dk-cite! 'cc-hol-fns-subset-cont 'u)
(fact 'subclass-of-set-is-set lk-H lk-C)
(dk-cite! 'cc-hol-fn-module-is-module 'u)
(dk-cite! 'cc-hol-seminorms-family 'u)
(fact 'lk-cc-seminorm-family)
(fact 'rr-zero-in) (fact 'zz-zero-in) (fact 'zz-one-in)
(dk-have! '(<= 0 rho) (lambda () (dk-ineq! '(< 0 rho))))
(let* ((g (dk-goal)) (q (cadr (cadddr (list-ref g 5)))))
  (fact 'zz-in-rr q)
  (use-em (list '<= 0 q)
    (lambda () (fact 'zz-nonneg-in-nn q) (lk-main! q #t))
    (lambda ()
      (let ((l (list '- (list '+ q 1))))
        (fact 'rr-not-le-lt 0 q)
        (fact 'zz-lt-succ-le q 0)
        (dk-have! (list 'AND (list 'IN q 'ZZ) '(IN 1 ZZ)))
        (fact 'zz-add-closed q 1) (fact 'zz-neg-closed (list '+ q 1))
        (dk-type! (list '+ q 1) 'RR) (dk-type! l 'RR)
        (dk-have! (list '<= 0 l) (lambda () (dk-ineq! (list '<= (list '+ q 1) 0) (list 'IN q 'RR) (list 'IN l 'RR))))
        (fact 'zz-nonneg-in-nn l)
        (let* ((lv (dk-name! l 'NN)) (kk (list '- (list '+ lv 1))))
          (dk-have! (list '= q kk) (lambda () (subst (list '= lv l)) (crs)))
          (dk-have! (list 'IN kk 'ZZ) (lambda () (let ((leaf (proof-state-focus *ps*))) (subst (list '= kk q)) (if (not (sequent-node-grounded? leaf)) (ass)))))
          (subst (list '= q kk))
          (lk-main! lv #f))))))
(for-each (lambda (l) (display ";; OPEN ") (write (dk-goal-of l)) (newline)) (dk-open-leaves))
(qed 'laurent-coef-cont-lin)
