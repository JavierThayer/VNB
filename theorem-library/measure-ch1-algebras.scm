;;; theorem-library/measure-ch1-algebras.scm -- ALGEBRAS OF SETS: atoms, finite unions, rectangles of R^n
;;; (M-A, wave MAP-1026, 2026-10-26).  Vocabulary: structure-library/measure-ch1-vocab.scm.
;;; Source: Thayer, Construction of Measures, ch. 1 s. 1.  Helper prefix: ma-.
;;;
;;; THE HEADLINES.
;;;   finite-algebra-atoms          Prop. 1.2: an algebra cA of subsets of omega with CARD(cA) in NN has a finite
;;;                                 set of atoms (minimal non-empty members), pairwise disjoint, and every member
;;;                                 is the union of the atoms it contains and the union of its traces on the atoms.
;;;   finite-unions-algebra         Prop. 1.4: cI a family of subsets of omega, non-empty, closed under binary
;;;                                 intersection, every complement a finite union of members: the finite unions
;;;                                 of members form an algebra.  (The notes leave "non-empty" implicit: an empty
;;;                                 family gives {EMPTY-SET}, an algebra only on the empty set.)
;;;   rn-rectangles-finite-unions-algebra
;;;                                 Cor. 1.6: the finite unions of rectangles (products of intervals) in R^n form
;;;                                 an algebra of subsets of R^n.
;;;
;;; THE ROUTE.  Prop. 1.2 without the notes' "since A is finite there is a minimal C": the atom of a point x is
;;; the meet of the members containing x (algebra-point-atom), a member of cA because finite meets are
;;; (algebra-finite-meet-in, finite-set induction); every member is then the union of the atoms of its points.
;;; Prop. 1.4 by finite-set induction over the family of a finite union (meet with a member, meet, complement).
;;; Cor. 1.6 from Prop. 1.4 through Remark 1.5: the meet of two rectangles is the rectangle of the meets of the
;;; sides (is-interval-inter); the complement of a rectangle is the union of the 2n rectangles whose k-th side is
;;; the ray below or above the k-th side and whose other sides are R (interval-outside-below-or-above), a finite
;;; family as the union of two images of INTERVAL(1, n).
;;;
;;; LOAD WINDOW.  lo: theorem-library/monotone-class (algebra-whole-empty-in, algebra-inter-closed,
;;; algebra-complement-closed; load.scm 3638), structure-library/rn-vocab (3611), the vocabulary file.
;;; hi: none (no citer).  Library: measure.
;;;
;;; No top-level macro: the file may be compiled.

;;; =====================================================================
;;; (0) the ma- kit
;;; =====================================================================
;;; (0) the ma- kit (file-local; most from push-forward.scm's pfw- kit and product-measure.scm's pms- kit)

(define (ma-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; dk-project!, except that a claim equal to the focus goal is proved in place
(define (ma-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
;;; sequential map (MIT evaluates arguments right to left)
(define (ma-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (ma-for-each f l) (let loop ((l l)) (if (pair? l) (begin (f (car l)) (loop (cdr l))))))
;;; the right-hand conjuncts of an IFF in context whose left side is in context, landed (by prop, on a lane)
(define (ma-iff-parts! iff0)
  (let* ((iff (or (dk-ctx-form iff0) (error "ma-iff-parts!: not in context" (expression->string iff0))))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    ;; the conjunct that is the focus goal (closed in place) goes LAST: closing it moves the focus
    (let* ((goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
           (late  (filter goal? cs))
           (early (filter (lambda (c) (not (goal? c))) cs)))
      (ma-map (lambda (c) (ma-by-prop! c (list iff (cadr iff)))) (append early late))
      cs)))
;;; the LEFT side of an IFF in context whose right side is in context, landed
(define (ma-iff-back! iff0)
  (let ((iff (or (dk-ctx-form iff0) (error "ma-iff-back!: not in context" (expression->string iff0)))))
    (ma-by-prop! (cadr iff)
      (cons iff (let ((r (caddr iff)))
                  (if (dk-asm? r)
                      (list r)
                      (let loop ((r r) (acc '()))
                        (if (and (pair? r) (eq? (car r) 'AND) (not (dk-asm? r)))
                            (loop (caddr r) (cons (cadr r) acc))
                            (reverse (cons r acc))))))))))
;;; CLAIM by prop from the formulas FS: on a lane, or in place when CLAIM is the focus goal; returns CLAIM
(define (ma-by-prop! claim fs)
  (cond ((dk-asm? claim) (dk-ctx-form claim))
        ((eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
         (ma-prop-with! fs) claim)
        (#t (dk-have! claim (lambda () (ma-prop-with! fs))) (dk-ctx-form claim))))
;;; (IN w (SEP v A P)) in context: land (IN w A) and P[w], the membership kept; return P[w].
(define (ma-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s (caddr m)) (v (cadr s)) (dom (caddr s))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "ma-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (let ((c (dk-ctx-form conj))) (if c (ai c)))))
    p))
;;; class extensionality, each direction driven: FWD / BWD procedures of the element; lands lhs = rhs
(define (ma-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'mew_ (list 'IFF (list 'IN 'mew_ lhs) (list 'IN 'mew_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs)
  (list '= lhs rhs))
;;; w in BIG-UNION(v, D, g(v)) gives the index and w in g(index): returns (k . formula)
(define (ma-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (caddr bu)))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
;;; prove the focus goal (IN w bu) at the index k (k in D and w in the k-th term in context)
(define (ma-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
;;; prop on the named formulas only
(define (ma-prop-with! fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))
;;; (IN z (UNION a b)) from (IN z a) / (IN z b) in context
(define (ma-in-union-left! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-l) (dk-ass!))))
(define (ma-in-union-right! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-r) (dk-ass!))))
;;; (IN x (PAIR x x)), x in SET in context
(define (ma-in-singleton! xv)
  (dk-have! (list 'IN xv (list 'PAIR xv xv))
    (lambda ()
      (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
      (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) xv)))
        (dk-have! (list '= xv xv) (lambda () (rfl)))
        (ma-prop-with! (list pm (list '= xv xv)))))))
;;; with (IN b (PAIR x x)) and x in SET in context, land b = x
(define (ma-singleton-eq! b xv)
  (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
  (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) b)))
    (dk-have! (list '= b xv)
      (lambda () (ma-prop-with! (list pm (list 'IN b (list 'PAIR xv xv))))))
    (list '= b xv)))

;;; FINITE-SET INDUCTION (pms-induct!, product-measure.scm).  PROP-OF builds P(s); BASE! proves P(EMPTY-SET)
;;; on its leaf; (STEP! sv xv u ih) proves P(u), u = sv u {xv}, with ih = P(sv) in context.  Returns P(xs).
(define (ma-class prop-of) (list 'COMP 'miu_ (prop-of 'miu_)))
(define (ma-step-formula c)
  (list 'FORALL 'is_
    (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ c)))
      (list 'FORALL 'ix_
        (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
          (list 'IN '(UNION is_ (PAIR ix_ ix_)) c))))))
(define (ma-induct! xs prop-of base! step!)
  (let* ((c     (ma-class prop-of))
         (stepf (ma-step-formula c)))
    (have! (list 'IN 'EMPTY-SET c)
      (lambda ()
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) '(in empty-set set))
                (begin (fact 'empty-set-is-set) (ass))
                (base!)))
          (dk-opened (lambda () (comp-mi))))))
    (have! stepf
      (lambda ()
        (let* ((landed (dk-peel!))
               (g      (dk-goal))
               (u      (cadr g))
               (sv     (cadr u))
               (xv     (cadr (caddr u))))
          (dk-split-all! landed)
          (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
          (fact 'pairing xv xv)
          (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET)))
          (fact 'union-set-closure sv (list 'PAIR xv xv))
          (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv c)))))
                 (ih (car (filter (lambda (f) (not (equal? f (list 'in sv 'set)))) ls))))
            (for-each
              (lambda (leaf)
                (dk-focus! leaf)
                (if (equal? (dk-goal) (list 'in u 'set))
                    (ass)
                    (step! sv xv u ih)))
              (dk-opened (lambda () (comp-mi))))))))
    (dk-have! (list 'AND (list 'IN 'EMPTY-SET c) stepf))
    (let ((ind (dk-fact! 'finite-set-induction c)))
      (dk-have! (list 'AND (list 'IN xs 'SET) (list 'IN (list 'CARD xs) 'NN)))
      (let* ((inx (dk-apply! ind xs))
             (ls  (dk-landed (lambda () (comp-me inx)))))
        (car (filter (lambda (f) (not (equal? f (list 'in xs 'set)))) ls))))))
;;; the membership laws whose instances make the two memberships propositionally equivalent
(define (ma-ext-prop! lhs rhs cites)
  (let ((side (lambda (have)
                (lambda (w)
                  (let ((fs (ma-map (lambda (c) (apply dk-cite! (car c) (cdr c))) (cites w))))
                    (ma-prop-with! (cons (list 'IN w have) fs)))))))
    (ma-ext2! lhs rhs (side lhs) (side rhs))))

;;; (SUBSET (SEP v d p) d)
(define (ma-sep-subset! sep)
  (dk-have! (list 'SUBSET sep (caddr sep))
    (lambda ()
      (mac 'subset-def)
      (let ((z (dk-di-var!)))
        (ma-sep-parts! (list 'IN z sep))
        (ass)))))
;;; s subset of the finite set ca (ca in SET, CARD ca in NN in context): land (IN s SET), (IN (CARD s) NN)
(define (ma-finite-sub! s ca)
  (fact 'subclass-of-set-is-set s ca)
  (dk-have! (list 'AND (list 'IN ca 'SET) (list 'IN (list 'CARD ca) 'NN)))
  (let ((cs (dk-fact! 'card-subset-nn ca)))
    (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s ca z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))))
    (dk-apply! cs s)))

;;; case split on a right-nested disjunction ORF in context, one THUNK per disjunct (each run with that
;;; disjunct in context, on its own leaf)
(define (ma-or-split! orf thunks)
  (let* ((o (or (dk-ctx-form orf) (error "ma-or-split!: not in context" (expression->string orf))))
         (l (cadr o)) (r (caddr o)))
    (for-each
      (lambda (leaf)
        (dk-focus! leaf)
        (cond ((dk-asm? l) ((car thunks)))
              ((pair? (cddr thunks)) (ma-or-split! r (cdr thunks)))
              (#t ((cadr thunks)))))
      (dk-opened (lambda () (ai o))))))
;;; f in FUN(NN, A) and every f(k) in B: f in FUN(NN, B)   (pfw-retype!, push-forward.scm)
(define (ma-retype! fv a b in-b!)
  (dk-have! (list 'IN fv (list 'FUN 'NN b))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c fv 'NN a kv)
                (ma-then-ass! (lambda () (in-b! (list fv kv)))))
              (begin
                (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN fv (list 'FUN 'NN a))))))
                (ass))))))))
;;; a function symbol G in FUN(DOM, COD) with G(k) == BODY(k): returns (G . VALUE-EQUATION)   (pfw-abstract!)
(define (ma-abstract! dom cod body-of typer pre)
  (let* ((body  (body-of 'mak_))
         (lam   (list 'VNB-LAMBDA 'mak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'mak_ (list 'IMPLIES (list 'IN 'mak_ dom)
                                                    (list '== (list g 'mak_) body)))))
         (claim (list 'FORSOME 'mag_ (list 'AND (list 'IN 'mag_ (list 'FUN dom cod))
                                            (vals 'mag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!))))
                (let ((kv (dk-di-var!)))
                  (pre kv)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "ma-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "ma-abstract!: the value equation did not land"))))
      (cons g ve))))

;;; =====================================================================
;;; ATOMS (Prop. 1.2)
;;; =====================================================================
;;; (1) the finite meet of members of an algebra is a member

(define (ma-meet om s) (list 'SEP 'mmy_ om (list 'FORALL 'mmb_ (list 'IMPLIES (list 'IN 'mmb_ s) '(IN mmy_ mmb_)))))

(sp (make-wff (forall-guarded '(omega cA) '((IS-ALGEBRA-OF-SETS omega cA))
  (list 'FORALL 's (list 'IMPLIES '(IN s SET) (list 'IMPLIES '(IN (CARD s) NN)
    (list 'IMPLIES '(SUBSET s cA) (list 'IN (ma-meet 'omega 's) 'cA))))))))
(dk-peel!)
(dk-split! (dk-cite! 'algebra-whole-empty-in 'omega 'cA))
(let* ((pof (lambda (s) (list 'IMPLIES (list 'SUBSET s 'cA) (list 'IN (ma-meet 'omega s) 'cA))))
       (ps (ma-induct! 's pof
             (lambda ()
               (di)
               (let ((lhs (ma-meet 'omega 'EMPTY-SET)))
                 (ma-ext2! lhs 'omega
                   (lambda (w) (ma-sep-parts! (list 'IN w lhs)) (ass))
                   (lambda (w)
                     (in-sep! dk-ass!
                       (lambda ()
                         (let* ((ls (dk-peel!)) (bv (cadr (car ls))))
                           (dk-cite! 'empty-set-has-no-members bv)
                           (ma-prop-with! (list (list 'IN bv 'EMPTY-SET) (list 'NOT (list 'IN bv 'EMPTY-SET)))))))))
                 (subst (list '= lhs 'omega))
                 (ass)))
             (lambda (sv xv u ih)
               (di)
               (dk-have! (list 'SUBSET sv 'cA)
                 (lambda ()
                   (mac 'subset-def)
                   (let ((z (dk-di-var!)))
                     (ma-in-union-left! z sv (list 'PAIR xv xv))
                     (fact 'subset-mem-fwd u 'cA z)
                     (ass))))
               (detach! ih)
               (ma-in-singleton! xv)
               (ma-in-union-right! xv sv (list 'PAIR xv xv))
               (fact 'subset-mem-fwd u 'cA xv)
               (let* ((ms (ma-meet 'omega sv)) (mu (ma-meet 'omega u))
                      (rhs (list 'INTERSECTION ms xv)))
                 (ma-ext2! mu rhs
                   (lambda (w)
                     (let ((pw (ma-sep-parts! (list 'IN w mu))))
                       (mac 'intersection-membership)
                       (dk-conj-close!
                         (lambda ()
                           (if (equal? (dk-goal) (list 'IN w xv))
                               (begin (dk-apply! pw xv) (ass))
                               (in-sep! dk-ass!
                                 (lambda ()
                                   (let* ((ls (dk-peel!)) (bv (cadr (car ls))))
                                     (ma-in-union-left! bv sv (list 'PAIR xv xv))
                                     (dk-apply! pw bv)
                                     (ass)))))))))
                   (lambda (w)
                     (ma-iff-parts! (dk-cite! 'intersection-membership ms xv w))
                     (let ((pw (ma-sep-parts! (list 'IN w ms))))
                       (in-sep! dk-ass!
                         (lambda ()
                           (let* ((ls (dk-peel!)) (bv (cadr (car ls)))
                                  (or1 (car (ma-iff-parts! (dk-cite! 'union-membership sv (list 'PAIR xv xv) bv)))))
                             (for-each
                               (lambda (leaf)
                                 (dk-focus! leaf)
                                 (if (dk-asm? (list 'IN bv sv))
                                     (begin (dk-apply! pw bv) (ass))
                                     (begin (ma-singleton-eq! bv xv)
                                            (subst (list '= bv xv))
                                            (ass))))
                               (dk-opened (lambda () (ai or1))))))))))
                 (fact 'algebra-inter-closed 'omega 'cA ms xv)
                 (subst (list '= mu rhs))
                 (ass))))))
  (detach! ps)
  (ass))
(qed 'algebra-finite-meet-in)

;;; (2) ATOMS: the unfold, and membership
(sp (make-wff '(FORALL cA (== (ATOMS cA) (SEP mat_ cA (IS-ATOM cA mat_))))))
(dk-peel!)
(mac 'ATOMS)
(qrfl)
(qed 'atoms-unfold)

(define (ma-atom-parts ca a)
  (list (list 'IN a ca)
        (list 'NOT (list '= a 'EMPTY-SET))
        (list 'FORALL 'mab_ (list 'IMPLIES (list 'IN 'mab_ ca)
                              (list 'IMPLIES (list 'SUBSET 'mab_ a)
                                (list 'IMPLIES '(NOT (= mab_ EMPTY-SET)) (list '= 'mab_ a)))))))
;;; with (IS-ATOM ca a) in context, land its three parts; return them
(define (ma-atom-open! ca a)
  (ma-map (lambda (p) (dk-project! p 'is-atom (list 'IS-ATOM ca a))) (ma-atom-parts ca a)))

(sp (make-wff '(FORALL cA (FORALL a (IFF (IN a (ATOMS cA)) (IS-ATOM cA a))))))
(dk-peel!)
(let ((sp0 '(SEP mat_ cA (IS-ATOM cA mat_))))
  (dk-cite! 'atoms-unfold 'cA)
  (subst (list '= '(ATOMS cA) sp0))
  (dk-iff! (lambda (g) (dk-head-is? g 'IS-ATOM))
    (lambda () (ma-sep-parts! (list 'IN 'a sp0)) (ass))
    (lambda ()
      (dk-project! '(IN a cA) 'is-atom '(IS-ATOM cA a))
      (in-sep! dk-ass! dk-ass!))))
(qed 'atoms-membership)

;;; with (IN a (ATOMS ca)) in context, land (IS-ATOM ca a) and its parts
(define (ma-atom-of! ca a)
  (ma-iff-parts! (dk-cite! 'atoms-membership ca a))
  (ma-atom-open! ca a))

;;; the algebra's basics: (IN omega SET), (SUBSET cA (POWER omega)), (IN cA SET)
(define (ma-alg-basics! om ca)
  (let ((h (list 'IS-ALGEBRA-OF-SETS om ca)))
    (dk-project! (list 'IN om 'SET) 'is-algebra-of-sets h)
    (dk-project! (list 'SUBSET ca (list 'POWER om)) 'is-algebra-of-sets h)
    (fact 'power-set om)
    (fact 'subclass-of-set-is-set ca (list 'POWER om))))
;;; (3) the atom of a point: At(x) = the meet of the members of cA containing x
(define (ma-fam ca x) (list 'SEP 'mac_ ca (list 'IN x 'mac_)))
(define (ma-at om ca x) (ma-meet om (ma-fam ca x)))

(sp (make-wff (forall-guarded '(omega cA) '((IS-ALGEBRA-OF-SETS omega cA) (IN (CARD cA) NN))
  (forall-guarded '(x) '((IN x omega))
    (list 'AND (list 'IN (ma-at 'omega 'cA 'x) '(ATOMS cA))
      (list 'AND (list 'IN 'x (ma-at 'omega 'cA 'x))
        (list 'FORALL 'mqb_ (list 'IMPLIES '(IN mqb_ cA) (list 'IMPLIES '(IN x mqb_)
          (list 'SUBSET (ma-at 'omega 'cA 'x) 'mqb_))))))))))
(dk-peel!)
(ma-alg-basics! 'omega 'cA)
(let* ((fx (ma-fam 'cA 'x)) (at (ma-at 'omega 'cA 'x))
       (sclaim (list 'FORALL 'mqb_ (list 'IMPLIES '(IN mqb_ cA) (list 'IMPLIES '(IN x mqb_)
                 (list 'SUBSET at 'mqb_))))))
  (ma-sep-subset! fx)
  (ma-finite-sub! fx 'cA)
  (fact 'subset-mem-fwd fx 'cA 'x)
  (dk-apply! (dk-cite! 'algebra-finite-meet-in 'omega 'cA) fx)
  ;; x in At(x)
  (dk-have! (list 'IN 'x at)
    (lambda ()
      (in-sep! dk-ass!
        (lambda ()
          (let* ((ls (dk-peel!)) (bv (cadr (car ls))))
            (ma-sep-parts! (list 'IN bv fx))
            (ass))))))
  ;; At(x) is below every member containing x
  (dk-have! sclaim
    (lambda ()
      (let* ((ls (dk-peel!))
             (bv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'cA))) ls))))
        (mac 'subset-def)
        (let* ((z (dk-di-var!)) (pz (ma-sep-parts! (list 'IN z at))))
          (dk-have! (list 'IN bv fx) (lambda () (in-sep! dk-ass! dk-ass!)))
          (dk-apply! pz bv)
          (ass)))))
  ;; At(x) is an atom
  (dk-have! (list 'IS-ATOM 'cA at)
    (lambda ()
      (mac 'is-atom)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-ass!) #t)
                  ((dk-head-is? g 'NOT)
                   (di)
                   (let ((h (dk-rewrite-h! (list 'IN 'x at) at 'EMPTY-SET)))
                     (dk-cite! 'empty-set-has-no-members 'x)
                     (ma-prop-with! (list h (list 'NOT h)))))
                  (#t
                   (let* ((ls (dk-peel!))
                          (bv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'cA))) ls))))
                     (fact 'membership-implies-sethood bv 'cA)
                     (use-em (list 'IN 'x bv)
                       (lambda ()
                         (dk-apply! (dk-ctx-form sclaim) bv)
                         (ma-ext2! bv at
                           (lambda (w) (fact 'subset-mem-fwd bv at w) (ass))
                           (lambda (w) (fact 'subset-mem-fwd at bv w) (ass)))
                         (ass))
                       (lambda ()
                         (let ((cb (list 'COMPLEMENT-IN 'omega bv)))
                           (dk-have! (list 'AND '(IN x omega) (list 'NOT (list 'IN 'x bv))) (lambda () (dk-conj-close! dk-ass!)))
                           (ma-iff-back! (dk-cite! 'complement-in-membership 'omega bv 'x))
                           (fact 'algebra-complement-closed 'omega 'cA bv)
                           (dk-apply! (dk-ctx-form sclaim) cb)
                           (fact 'subset-trans bv at cb)
                           (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ bv) '(IN z_ EMPTY-SET)))
                             (lambda ()
                               (let ((z (dk-di-var!)))
                                 (fact 'subset-mem-fwd bv cb z)
                                 (let ((cm (car (ma-iff-parts! (dk-cite! 'complement-in-membership 'omega bv z)))))
                                   (ma-iff-parts! (dk-cite! 'complement-in-membership 'omega bv z))
                                   (ma-prop-with! (list (list 'IN z bv) (list 'NOT (list 'IN z bv))))))))
                           (dk-cite! 'subset-of-empty-is-empty bv)
                           (ma-prop-with! (list (list '= bv 'EMPTY-SET) (list 'NOT (list '= bv 'EMPTY-SET)))))))))))))))
  (ma-iff-back! (dk-cite! 'atoms-membership 'cA at))
  (dk-conj-close! dk-ass!))
(qed 'algebra-point-atom)

;;; (4) distinct atoms are disjoint
(sp (make-wff (forall-guarded '(omega cA) '((IS-ALGEBRA-OF-SETS omega cA))
  (forall-guarded '(a b) '((IN a (ATOMS cA)) (IN b (ATOMS cA)) (NOT (= a b)))
    '(= (INTERSECTION a b) EMPTY-SET)))))
(dk-peel!)
(let* ((pa (ma-atom-of! 'cA 'a)) (pb (ma-atom-of! 'cA 'b))
       (c '(INTERSECTION a b))
       (sub! (lambda (side)
               (dk-have! (list 'SUBSET c side)
                 (lambda ()
                   (mac 'subset-def)
                   (let ((z (dk-di-var!)))
                     (ma-iff-parts! (dk-cite! 'intersection-membership 'a 'b z))
                     (ass)))))))
  (fact 'algebra-inter-closed 'omega 'cA 'a 'b)
  (sub! 'a) (sub! 'b)
  (dk-have! (list 'IMPLIES (list 'NOT (list '= c 'EMPTY-SET)) '(= a b))
    (lambda ()
      (di)
      (dk-apply! (caddr pa) c)
      (dk-apply! (caddr pb) c)
      (subst (list '= 'a c))
      (ass)))
  (ma-prop-with! (list (list 'IMPLIES (list 'NOT (list '= c 'EMPTY-SET)) '(= a b)) '(NOT (= a b)))))
(qed 'atoms-pairwise-disjoint)

;;; (5) every member is the union of the atoms it contains, and the union of its traces on the atoms
(define (ma-dec1 ca a) (list 'BIG-UNION 'mau_ (list 'SEP 'mas_ (list 'ATOMS ca) (list 'SUBSET 'mas_ a)) 'mau_))
(define (ma-dec2 ca a) (list 'BIG-UNION 'mau_ (list 'ATOMS ca) (list 'INTERSECTION a 'mau_)))

(sp (make-wff (forall-guarded '(omega cA) '((IS-ALGEBRA-OF-SETS omega cA) (IN (CARD cA) NN))
  (forall-guarded '(a) '((IN a cA))
    (list 'AND (list '= 'a (ma-dec1 'cA 'a)) (list '= 'a (ma-dec2 'cA 'a)))))))
(dk-peel!)
(ma-alg-basics! 'omega 'cA)
(fact 'subset-mem-fwd 'cA '(POWER omega) 'a)
(let* ((d1 (ma-dec1 'cA 'a)) (d2 (ma-dec2 'cA 'a)) (s1 (caddr d1))
       (pt! (lambda (w)
              (fact 'power-mem-in 'omega 'a w)
              (let ((r (dk-apply! (dk-cite! 'algebra-point-atom 'omega 'cA) w)))
                (dk-split! r)
                (dk-apply! (caddr (caddr r)) 'a)
                (ma-at 'omega 'cA w)))))
  (ma-ext2! 'a d1
    (lambda (w)
      (let ((at (pt! w)))
        (dk-have! (list 'IN at s1) (lambda () (in-sep! dk-ass! dk-ass!)))
        (ma-bu-close! at)))
    (lambda (w)
      (let* ((r (ma-bu-open! w d1)) (k (car r)))
        (ma-sep-parts! (list 'IN k s1))
        (fact 'subset-mem-fwd k 'a w)
        (ass))))
  (ma-ext2! 'a d2
    (lambda (w)
      (let ((at (pt! w)))
        (dk-have! (list 'IN w (list 'INTERSECTION 'a at))
          (lambda () (mac 'intersection-membership) (dk-conj-close! dk-ass!)))
        (ma-bu-close! at)))
    (lambda (w)
      (let* ((r (ma-bu-open! w d2)) (k (car r)))
        (ma-iff-parts! (dk-cite! 'intersection-membership 'a k w))
        (ass))))
  (dk-conj-close! dk-ass!))
(qed 'algebra-atom-decomposition)

;;; (6) PROP. 1.2 as the notes state it
(sp (make-wff (forall-guarded '(omega cA) '((IS-ALGEBRA-OF-SETS omega cA) (IN (CARD cA) NN))
  (list 'AND '(IN (ATOMS cA) SET)
    (list 'AND '(IN (CARD (ATOMS cA)) NN)
      (list 'AND (forall-guarded '(a b) '((IN a (ATOMS cA)) (IN b (ATOMS cA)) (NOT (= a b)))
                   '(= (INTERSECTION a b) EMPTY-SET))
        (forall-guarded '(a) '((IN a cA))
          (list 'AND (list '= 'a (ma-dec1 'cA 'a)) (list '= 'a (ma-dec2 'cA 'a))))))))))
(dk-peel!)
(ma-alg-basics! 'omega 'cA)
(ma-sep-subset! '(SEP mat_ cA (IS-ATOM cA mat_)))
(dk-cite! 'atoms-unfold 'cA)
(dk-have! '(SUBSET (ATOMS cA) cA) (lambda () (subst '(= (ATOMS cA) (SEP mat_ cA (IS-ATOM cA mat_)))) (ass)))
(ma-finite-sub! '(ATOMS cA) 'cA)
(dk-cite! 'atoms-pairwise-disjoint 'omega 'cA)
(dk-cite! 'algebra-atom-decomposition 'omega 'cA)
(dk-conj-close! dk-ass!)
(qed 'finite-algebra-atoms)

;;; =====================================================================
;;; FINITE UNIONS (Prop. 1.4)
;;; =====================================================================
;;; (7) unions of families: of the empty family, a singleton, a union of two families
(define (ma-bu f) (list 'BIG-UNION 'mfw_ f 'mfw_))

(sp (make-wff (list '= (ma-bu 'EMPTY-SET) 'EMPTY-SET)))
(ma-ext2! (ma-bu 'EMPTY-SET) 'EMPTY-SET
  (lambda (w)
    (let* ((r (ma-bu-open! w (ma-bu 'EMPTY-SET))) (k (car r)))
      (dk-cite! 'empty-set-has-no-members k)
      (ma-prop-with! (list (list 'IN k 'EMPTY-SET) (list 'NOT (list 'IN k 'EMPTY-SET))))))
  (lambda (w)
    (dk-cite! 'empty-set-has-no-members w)
    (ma-prop-with! (list (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET))))))
(ass)
(qed 'big-union-of-empty-family)

(sp (make-wff (forall-guarded '(x) '((IN x SET)) (list '= (ma-bu '(PAIR x x)) 'x))))
(dk-peel!)
(ma-ext2! (ma-bu '(PAIR x x)) 'x
  (lambda (w)
    (let* ((r (ma-bu-open! w (ma-bu '(PAIR x x)))) (k (car r)))
      (ma-singleton-eq! k 'x)
      (dk-rewrite-h! (cdr r) k 'x)
      (ass)))
  (lambda (w)
    (ma-in-singleton! 'x)
    (ma-bu-close! 'x)))
(ass)
(qed 'big-union-of-singleton-family)

(sp (make-wff (list 'FORALL 'ff (list 'FORALL 'gg
  (list '= (ma-bu '(UNION ff gg)) (list 'UNION (ma-bu 'ff) (ma-bu 'gg)))))))
(dk-peel!)
(ma-ext2! (ma-bu '(UNION ff gg)) (list 'UNION (ma-bu 'ff) (ma-bu 'gg))
  (lambda (w)
    (let* ((r (ma-bu-open! w (ma-bu '(UNION ff gg)))) (k (car r))
           (or1 (car (ma-iff-parts! (dk-cite! 'union-membership 'ff 'gg k)))))
      (for-each
        (lambda (leaf)
          (dk-focus! leaf)
          (if (dk-asm? (list 'IN k 'ff))
              (begin (dk-have! (list 'IN w (ma-bu 'ff)) (lambda () (ma-bu-close! k)))
                     (ma-in-union-left! w (ma-bu 'ff) (ma-bu 'gg)))
              (begin (dk-have! (list 'IN w (ma-bu 'gg)) (lambda () (ma-bu-close! k)))
                     (ma-in-union-right! w (ma-bu 'ff) (ma-bu 'gg)))))
        (dk-opened (lambda () (ai or1))))))
  (lambda (w)
    (let ((or1 (car (ma-iff-parts! (dk-cite! 'union-membership (ma-bu 'ff) (ma-bu 'gg) w)))))
      (for-each
        (lambda (leaf)
          (dk-focus! leaf)
          (let* ((side (if (dk-asm? (list 'IN w (ma-bu 'ff))) 'ff 'gg))
                 (r (ma-bu-open! w (ma-bu side))) (k (car r)))
            (if (eq? side 'ff) (ma-in-union-left! k 'ff 'gg) (ma-in-union-right! k 'ff 'gg))
            (ma-bu-close! k)))
        (dk-opened (lambda () (ai or1)))))))
(ass)
(qed 'big-union-of-union-family)

;;; (8) FINITE-UNIONS: unfold, introduction, elimination
(define ma-fu '(FINITE-UNIONS omega cI))
(define (ma-fu-body s)
  (list 'FORSOME 'mff_ (list 'AND '(IN mff_ SET)
                          (list 'AND '(IN (CARD mff_) NN)
                            (list 'AND '(SUBSET mff_ cI) (list '= s (ma-bu 'mff_)))))))
(define ma-fu-sep (list 'SEP 'mfu_ '(POWER omega) (ma-fu-body 'mfu_)))

(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cI (list '== ma-fu ma-fu-sep)))))
(dk-peel!)
(mac 'FINITE-UNIONS)
(qrfl)
(qed 'finite-unions-unfold)

(sp (make-wff (forall-guarded '(omega cI) '((IN omega SET) (SUBSET cI (POWER omega)))
  (forall-guarded '(ff) '((IN ff SET) (IN (CARD ff) NN) (SUBSET ff cI))
    (list 'IN (ma-bu 'ff) ma-fu)))))
(dk-peel!)
(dk-cite! 'finite-unions-unfold 'omega 'cI)
(subst (list '= ma-fu ma-fu-sep))
(fact 'subset-trans 'ff 'cI '(POWER omega))
(dk-cite! 'power-big-union-closed 'omega 'ff)
(in-sep! dk-ass!
  (lambda ()
    (ew 'ff)
    (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))
(qed 'finite-unions-intro)

(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cI (list 'FORALL 's
  (list 'IMPLIES (list 'IN 's ma-fu) (list 'AND '(IN s (POWER omega)) (ma-fu-body 's))))))))
(dk-peel!)
(dk-cite! 'finite-unions-unfold 'omega 'cI)
(ma-sep-parts! (dk-rewrite-h! (list 'IN 's ma-fu) ma-fu ma-fu-sep))
(dk-conj-close! dk-ass!)
(qed 'finite-unions-elim)

;;; with (IN s FU) in context: land s in POWER(omega) and the family; return the family's eigenvariable
(define (ma-fu-open! s)
  (let ((r (dk-apply! (dk-cite! 'finite-unions-elim 'omega 'cI) s)))
    (dk-split! r)
    (dk-skolem! (caddr r))))
;;; (IN t FU) from (IN (BIG-UNION mfw_ ff mfw_) FU) and t = BIG-UNION(..) in context
(define (ma-fu-intro! ff)
  (dk-apply! (dk-cite! 'finite-unions-intro 'omega 'cI) ff))

;;; the empty set and the members of cI are finite unions
(sp (make-wff (forall-guarded '(omega cI) '((IN omega SET) (SUBSET cI (POWER omega)))
  (list 'IN 'EMPTY-SET ma-fu))))
(dk-peel!)
(fact 'empty-set-is-set)
(fact 'card-empty)
(dk-have! '(IN (CARD EMPTY-SET) NN) (lambda () (subst '(= (CARD EMPTY-SET) 0)) (fact 'nn-zero-in) (ass)))
(dk-have! '(SUBSET EMPTY-SET cI)
  (lambda ()
    (mac 'subset-def)
    (let ((z (dk-di-var!)))
      (dk-cite! 'empty-set-has-no-members z)
      (ma-prop-with! (list (list 'IN z 'EMPTY-SET) (list 'NOT (list 'IN z 'EMPTY-SET)))))))
(ma-fu-intro! 'EMPTY-SET)
(fact 'big-union-of-empty-family)
(subst (list '= 'EMPTY-SET (ma-bu 'EMPTY-SET)))
(ass)
(qed 'finite-unions-empty-in)

(sp (make-wff (forall-guarded '(omega cI) '((IN omega SET) (SUBSET cI (POWER omega)))
  (forall-guarded '(a) '((IN a cI)) (list 'IN 'a ma-fu)))))
(dk-peel!)
(fact 'membership-implies-sethood 'a 'cI)
(dk-have! '(AND (IN a SET) (IN a SET)))
(fact 'pairing 'a 'a)
(fact 'card-singleton 'a)
(dk-have! '(IN (CARD (PAIR a a)) NN) (lambda () (subst '(= (CARD (PAIR a a)) (succ 0))) (fact 'nn-zero-in) (fact 'nn-succ-closed 0) (ass)))
(dk-have! '(SUBSET (PAIR a a) cI)
  (lambda ()
    (mac 'subset-def)
    (let ((z (dk-di-var!)))
      (ma-singleton-eq! z 'a)
      (subst (list '= z 'a))
      (ass))))
(ma-fu-intro! '(PAIR a a))
(fact 'big-union-of-singleton-family 'a)
(subst (list '= 'a (ma-bu '(PAIR a a))))
(ass)
(qed 'finite-unions-member-in)

;;; the union of two finite unions
(sp (make-wff (forall-guarded '(omega cI) '((IN omega SET) (SUBSET cI (POWER omega)))
  (forall-guarded '(s tt) (list (list 'IN 's ma-fu) (list 'IN 'tt ma-fu)) (list 'IN '(UNION s tt) ma-fu)))))
(dk-peel!)
(let* ((ff (ma-fu-open! 's)) (gg (ma-fu-open! 'tt)) (fg (list 'UNION ff gg)))
  (dk-have! (list 'AND (list 'IN ff 'SET) (list 'IN gg 'SET)))
  (fact 'union-set-closure ff gg)
  (dk-apply! (dk-cite! 'card-union-nn ff) gg)
  (dk-have! (list 'SUBSET fg 'cI)
    (lambda ()
      (mac 'subset-def)
      (let* ((z (dk-di-var!))
             (or1 (car (ma-iff-parts! (dk-cite! 'union-membership ff gg z)))))
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (dk-asm? (list 'IN z ff)) (fact 'subset-mem-fwd ff 'cI z) (fact 'subset-mem-fwd gg 'cI z))
            (ass))
          (dk-opened (lambda () (ai or1)))))))
  (ma-fu-intro! fg)
  (fact 'big-union-of-union-family ff gg)
  (subst (list '= 's (ma-bu ff)))
  (subst (list '= 'tt (ma-bu gg)))
  (subst (list '= (list 'UNION (ma-bu ff) (ma-bu gg)) (ma-bu fg)))
  (ass))
(qed 'finite-unions-union-closed)

;;; (9) the inductions: meet with a member, meet of two finite unions, complement
(define ma-h-int (forall-guarded '(mia_ mib_) '((IN mia_ cI) (IN mib_ cI)) '(IN (INTERSECTION mia_ mib_) cI)))
(define ma-h-comp (forall-guarded '(mia_) '((IN mia_ cI)) (list 'IN '(COMPLEMENT-IN omega mia_) ma-fu)))
(define ma-h-ne '(FORSOME mie_ (IN mie_ cI)))

;;; in a step: (SUBSET u cI) in context, u = sv u {xv}; land (SUBSET sv cI), (IN xv cI), and the rewrite
;;; equation BIG-UNION(u) = UNION(BIG-UNION(sv), xv); return that equation
(define (ma-step-basics! sv xv u)
  (dk-have! (list 'SUBSET sv 'cI)
    (lambda ()
      (mac 'subset-def)
      (let ((z (dk-di-var!)))
        (ma-in-union-left! z sv (list 'PAIR xv xv))
        (fact 'subset-mem-fwd u 'cI z)
        (ass))))
  (ma-in-singleton! xv)
  (ma-in-union-right! xv sv (list 'PAIR xv xv))
  (fact 'subset-mem-fwd u 'cI xv)
  (fact 'big-union-of-union-family sv (list 'PAIR xv xv))
  (fact 'big-union-of-singleton-family xv)
  (let ((eq1 (list '= (ma-bu u) (list 'UNION (ma-bu sv) xv))))
    (dk-have! eq1
      (lambda ()
        (subst (list '= (ma-bu u) (list 'UNION (ma-bu sv) (ma-bu (list 'PAIR xv xv)))))
        (subst (list '= (ma-bu (list 'PAIR xv xv)) xv))
        (rfl)))
    eq1))
;;; the induction over the family of t = BIG-UNION(gg) in FU: P(G) = (SUBSET G cI) => TERM-OF(BIG-UNION G) in FU
(define (ma-fu-induct! gg term-of base-eq! step!)
  (let* ((pof (lambda (g) (list 'IMPLIES (list 'SUBSET g 'cI) (list 'IN (term-of (ma-bu g)) ma-fu))))
         (ps (ma-induct! gg pof
               (lambda ()
                 (di)
                 (fact 'big-union-of-empty-family)
                 (subst (list '= (ma-bu 'EMPTY-SET) 'EMPTY-SET))
                 (base-eq!))
               (lambda (sv xv u ih)
                 (di)
                 (let ((eq1 (ma-step-basics! sv xv u)))
                   (detach! ih)
                   (subst eq1)
                   (step! sv xv))))))
    (detach! ps)))

(sp (make-wff (forall-guarded '(omega cI) (list '(IN omega SET) '(SUBSET cI (POWER omega)) ma-h-int)
  (forall-guarded '(a tt) (list '(IN a cI) (list 'IN 'tt ma-fu)) (list 'IN '(INTERSECTION a tt) ma-fu)))))
(dk-peel!)
(fact 'finite-unions-empty-in 'omega 'cI)
(let ((gg (ma-fu-open! 'tt)))
  (subst (list '= 'tt (ma-bu gg)))
  (ma-fu-induct! gg (lambda (b) (list 'INTERSECTION 'a b))
    (lambda ()
      (ma-ext-prop! '(INTERSECTION a EMPTY-SET) 'EMPTY-SET
        (lambda (w) (list (list 'intersection-membership 'a 'EMPTY-SET w) (list 'empty-set-has-no-members w))))
      (subst '(= (INTERSECTION a EMPTY-SET) EMPTY-SET))
      (ass))
    (lambda (sv xv)
      (let* ((b (ma-bu sv)) (lhs (list 'INTERSECTION 'a (list 'UNION b xv)))
             (r1 (list 'INTERSECTION 'a b)) (r2 (list 'INTERSECTION 'a xv)) (rhs (list 'UNION r1 r2)))
        (dk-apply! (dk-ctx-form ma-h-int) 'a xv)
        (dk-apply! (dk-cite! 'finite-unions-member-in 'omega 'cI) r2)
        (dk-apply! (dk-cite! 'finite-unions-union-closed 'omega 'cI) r1 r2)
        (ma-ext-prop! lhs rhs
          (lambda (w) (list (list 'intersection-membership 'a (list 'UNION b xv) w) (list 'union-membership b xv w)
                            (list 'union-membership r1 r2 w) (list 'intersection-membership 'a b w)
                            (list 'intersection-membership 'a xv w))))
        (subst (list '= lhs rhs))
        (ass))))
  (ass))
(qed 'finite-unions-inter-member)

(sp (make-wff (forall-guarded '(omega cI) (list '(IN omega SET) '(SUBSET cI (POWER omega)) ma-h-int)
  (forall-guarded '(s tt) (list (list 'IN 's ma-fu) (list 'IN 'tt ma-fu)) (list 'IN '(INTERSECTION s tt) ma-fu)))))
(dk-peel!)
(fact 'finite-unions-empty-in 'omega 'cI)
(let ((ff (ma-fu-open! 's)))
  (subst (list '= 's (ma-bu ff)))
  (ma-fu-induct! ff (lambda (b) (list 'INTERSECTION b 'tt))
    (lambda ()
      (ma-ext-prop! '(INTERSECTION EMPTY-SET tt) 'EMPTY-SET
        (lambda (w) (list (list 'intersection-membership 'EMPTY-SET 'tt w) (list 'empty-set-has-no-members w))))
      (subst '(= (INTERSECTION EMPTY-SET tt) EMPTY-SET))
      (ass))
    (lambda (sv xv)
      (let* ((b (ma-bu sv)) (lhs (list 'INTERSECTION (list 'UNION b xv) 'tt))
             (r1 (list 'INTERSECTION b 'tt)) (r2 (list 'INTERSECTION xv 'tt)) (rhs (list 'UNION r1 r2)))
        (dk-apply! (dk-cite! 'finite-unions-inter-member 'omega 'cI) xv 'tt)
        (dk-apply! (dk-cite! 'finite-unions-union-closed 'omega 'cI) r1 r2)
        (ma-ext-prop! lhs rhs
          (lambda (w) (list (list 'intersection-membership (list 'UNION b xv) 'tt w) (list 'union-membership b xv w)
                            (list 'union-membership r1 r2 w) (list 'intersection-membership b 'tt w)
                            (list 'intersection-membership xv 'tt w))))
        (subst (list '= lhs rhs))
        (ass))))
  (ass))
(qed 'finite-unions-inter-closed)

(sp (make-wff (forall-guarded '(omega cI) (list '(IN omega SET) '(SUBSET cI (POWER omega)) ma-h-ne ma-h-int ma-h-comp)
  (forall-guarded '(s) (list (list 'IN 's ma-fu)) (list 'IN '(COMPLEMENT-IN omega s) ma-fu)))))
(dk-peel!)
;; omega is a finite union: a0 u (omega \ a0) for a member a0
(dk-have! (list 'IN 'omega ma-fu)
  (lambda ()
    (let* ((a0 (dk-skolem! (dk-ctx-form ma-h-ne))) (ca0 (list 'COMPLEMENT-IN 'omega a0))
           (un (list 'UNION a0 ca0)))
      (fact 'subset-mem-fwd 'cI '(POWER omega) a0)
      (dk-apply! (dk-cite! 'finite-unions-member-in 'omega 'cI) a0)
      (dk-apply! (dk-ctx-form ma-h-comp) a0)
      (dk-apply! (dk-cite! 'finite-unions-union-closed 'omega 'cI) a0 ca0)
      (ma-ext-prop! un 'omega
        (lambda (w) (list (list 'union-membership a0 ca0 w) (list 'complement-in-membership 'omega a0 w)
                          (list 'power-mem-in 'omega a0 w))))
      (dk-rewrite-h! (list 'IN un ma-fu) un 'omega)
      (ass))))
(let ((ff (ma-fu-open! 's)))
  (subst (list '= 's (ma-bu ff)))
  (ma-fu-induct! ff (lambda (b) (list 'COMPLEMENT-IN 'omega b))
    (lambda ()
      (ma-ext-prop! '(COMPLEMENT-IN omega EMPTY-SET) 'omega
        (lambda (w) (list (list 'complement-in-membership 'omega 'EMPTY-SET w) (list 'empty-set-has-no-members w))))
      (subst '(= (COMPLEMENT-IN omega EMPTY-SET) omega))
      (ass))
    (lambda (sv xv)
      (let* ((b (ma-bu sv)) (lhs (list 'COMPLEMENT-IN 'omega (list 'UNION b xv)))
             (r1 (list 'COMPLEMENT-IN 'omega b)) (r2 (list 'COMPLEMENT-IN 'omega xv)) (rhs (list 'INTERSECTION r1 r2)))
        (dk-apply! (dk-ctx-form ma-h-comp) xv)
        (dk-apply! (dk-cite! 'finite-unions-inter-closed 'omega 'cI) r1 r2)
        (ma-ext-prop! lhs rhs
          (lambda (w) (list (list 'complement-in-membership 'omega (list 'UNION b xv) w) (list 'union-membership b xv w)
                            (list 'intersection-membership r1 r2 w) (list 'complement-in-membership 'omega b w)
                            (list 'complement-in-membership 'omega xv w))))
        (subst (list '= lhs rhs))
        (ass))))
  (ass))
(qed 'finite-unions-complement-closed)

;;; (10) PROP. 1.4: the finite unions of a family closed under finite intersections whose members have
;;; complements that are finite unions form an algebra (the family non-empty: an empty family gives {EMPTY-SET},
;;; an algebra only of the empty set)
(sp (make-wff (forall-guarded '(omega cI) (list '(IN omega SET) '(SUBSET cI (POWER omega)) ma-h-ne ma-h-int ma-h-comp)
  (list 'IS-ALGEBRA-OF-SETS 'omega ma-fu))))
(dk-peel!)
(fact 'finite-unions-empty-in 'omega 'cI)
(mac 'is-algebra-of-sets)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-ass!) #t)
            ((dk-head-is? g 'SUBSET)
             (mac 'subset-def)
             (let ((z (dk-di-var!)))
               (dk-split! (dk-apply! (dk-cite! 'finite-unions-elim 'omega 'cI) z))
               (ass)))
            ((dk-head-is? g 'FORSOME) (ew 'EMPTY-SET) (ass))
            ((dk-contains? g 'COMPLEMENT-IN)
             (let ((ls (dk-peel!)))
               (dk-apply! (dk-cite! 'finite-unions-complement-closed 'omega 'cI) (cadr (car ls)))
               (ass)))
            ((dk-contains? g 'UNION)
             (let* ((ls (dk-peel!)) (g2 (cadr (dk-goal))))
               (dk-apply! (dk-cite! 'finite-unions-union-closed 'omega 'cI) (cadr g2) (caddr g2))
               (ass)))
            (#t
             (let* ((ls (dk-peel!)) (g2 (cadr (dk-goal))))
               (dk-apply! (dk-cite! 'finite-unions-inter-closed 'omega 'cI) (cadr g2) (caddr g2))
               (ass)))))))
(qed 'finite-unions-algebra)

;;; =====================================================================
;;; RECTANGLES OF R^n (Remark 1.5, Cor. 1.6)
;;; =====================================================================
;;; (11) intervals of R: R itself, intersections, the two rays outside an interval

(define (ma-int-parts es)
  (list (list 'SUBSET es 'RR)
        (list 'FORALL 'mia_ (list 'IMPLIES (list 'IN 'mia_ es)
          (list 'FORALL 'mib_ (list 'IMPLIES (list 'IN 'mib_ es)
            (list 'FORALL 'mix_ (list 'IMPLIES '(IN mix_ RR)
              (list 'IMPLIES '(<= mia_ mix_) (list 'IMPLIES '(<= mix_ mib_) (list 'IN 'mix_ es)))))))))))
;;; with (IS-INTERVAL es) in context, land its two parts; return them
(define (ma-int-open! es)
  (ma-map (lambda (p) (dk-project! p 'is-interval (list 'IS-INTERVAL es))) (ma-int-parts es)))
;;; prove (IS-INTERVAL es) on the focus: SUB! proves (SUBSET es RR); (CONV! a b x) proves (IN x es) with
;;; a, b in es, x in RR, a <= x <= b in context
(define (ma-int-prove! sub! conv!)
  (mac 'is-interval)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'SUBSET)
          (sub!)
          (let* ((ls (dk-peel!))
                 (vs (ma-map cadr (filter (lambda (f) (dk-head-is? f 'IN)) ls))))
            (conv! (car vs) (cadr vs) (caddr vs)))))))

(sp (make-wff '(IS-INTERVAL RR)))
(ma-int-prove! (lambda () (mac 'subset-def) (dk-di-var!) (ass)) (lambda (a b x) (ass)))
(qed 'is-interval-rr)

(sp (make-wff (forall-guarded '(es fs) '((IS-INTERVAL es) (IS-INTERVAL fs)) '(IS-INTERVAL (INTERSECTION es fs)))))
(dk-peel!)
(let* ((pe (ma-int-open! 'es)) (pf (ma-int-open! 'fs)))
  (ma-int-prove!
    (lambda ()
      (mac 'subset-def)
      (let ((z (dk-di-var!)))
        (ma-iff-parts! (dk-cite! 'intersection-membership 'es 'fs z))
        (fact 'subset-mem-fwd 'es 'RR z)
        (ass)))
    (lambda (a b x)
      (ma-iff-parts! (dk-cite! 'intersection-membership 'es 'fs a))
      (ma-iff-parts! (dk-cite! 'intersection-membership 'es 'fs b))
      (dk-apply! (cadr pe) a b x)
      (dk-apply! (cadr pf) a b x)
      (mac 'intersection-membership)
      (dk-conj-close! dk-ass!))))
(qed 'is-interval-inter)

;;; the ray below (above) the side jj(i), cut to the coordinate i = k: R when i /= k
(define (ma-lo jj i k) (list 'SEP 'mlz_ 'RR (list 'IMPLIES (list '= i k) (list 'FORALL 'mly_ (list 'IMPLIES (list 'IN 'mly_ (list jj i)) '(< mlz_ mly_))))))
(define (ma-hi jj i k) (list 'SEP 'mlz_ 'RR (list 'IMPLIES (list '= i k) (list 'FORALL 'mly_ (list 'IMPLIES (list 'IN 'mly_ (list jj i)) '(< mly_ mlz_))))))

(define (ma-ray-interval! ray lo?)
  (ma-int-prove!
    (lambda () (ma-sep-subset! ray))
    (lambda (a b x)
      (let* ((pa (ma-sep-parts! (list 'IN a ray))) (pb (ma-sep-parts! (list 'IN b ray))))
        (in-sep! dk-ass!
          (lambda ()
            (di)
            (let* ((fa (dk-landed-1 (lambda () (detach! pa))))
                   (fb (dk-landed-1 (lambda () (detach! pb))))
                   (ls (dk-peel!)) (yv (cadr (car ls))))
              (dk-apply! fa yv)
              (dk-apply! fb yv)
              (fact 'subset-mem-fwd '(jj i) 'RR yv)
              (if lo?
                  (dk-ineq! (list '<= x b) (list '< b yv))
                  (dk-ineq! (list '<= a x) (list '< yv a))))))))))

(sp (make-wff (forall-guarded '(jj i k) '((SUBSET (jj i) RR)) (list 'IS-INTERVAL (ma-lo 'jj 'i 'k)))))
(dk-peel!)
(ma-ray-interval! (ma-lo 'jj 'i 'k) #t)
(qed 'rn-ray-below-interval)

(sp (make-wff (forall-guarded '(jj i k) '((SUBSET (jj i) RR)) (list 'IS-INTERVAL (ma-hi 'jj 'i 'k)))))
(dk-peel!)
(ma-ray-interval! (ma-hi 'jj 'i 'k) #f)
(qed 'rn-ray-above-interval)

;;; a real outside an interval lies below all of it or above all of it (Remark 1.3, the complement half)
(define ma-below '(FORALL mly_ (IMPLIES (IN mly_ es) (< x mly_))))
(define ma-above '(FORALL mly_ (IMPLIES (IN mly_ es) (< mly_ x))))
(sp (make-wff (forall-guarded '(es x) '((IS-INTERVAL es) (IN x RR) (NOT (IN x es))) (list 'OR ma-below ma-above))))
(dk-peel!)
(let ((pe (ma-int-open! 'es)))
  (use-em ma-below
    (lambda () (oi-l) (ass))
    (lambda ()
      (oi-r)
      (let* ((ls (dk-peel!)) (yv (cadr (car ls)))
             (ex (dk-landed-1 (lambda () (push-not-h (list 'NOT ma-below)))))
             (y0 (dk-skolem! ex)))
        (fact 'subset-mem-fwd 'es 'RR yv)
        (fact 'subset-mem-fwd 'es 'RR y0)
        (dk-have! (list 'AND (list 'IN yv 'RR) '(IN x RR)))
        (dk-have! (list 'AND '(IN x RR) (list 'IN y0 'RR)))
        (let ((contra! (lambda () (ma-prop-with! (list '(IN x es) '(NOT (IN x es)))))))
          (ma-or-split! (dk-cite! 'rr-lt-trichotomy yv 'x)
            (list
              (lambda () (ass))
              (lambda () (dk-rewrite-h! (list 'IN yv 'es) yv 'x) (contra!))
              (lambda ()
                (ma-or-split! (dk-cite! 'rr-lt-trichotomy 'x y0)
                  (list
                    (lambda () (ma-prop-with! (list (list '< 'x y0) (list 'NOT (list '< 'x y0)))))
                    (lambda () (dk-rewrite-h! (list 'IN y0 'es) y0 'x) (contra!))
                    (lambda ()
                      (dk-have! (list '<= y0 'x) (lambda () (dk-ineq! (list '< y0 'x))))
                      (dk-have! (list '<= 'x yv) (lambda () (dk-ineq! (list '< 'x yv))))
                      (dk-apply! (cadr pe) y0 yv 'x)
                      (contra!))))))))))))
(qed 'interval-outside-below-or-above)

;;; (12) rectangles of R^n: unfolds, sethood, introduction, elimination, membership
(define ma-int '(INTERVAL 1 n))
(define ma-rn '(FUN (INTERVAL 1 n) RR))
(define (ma-box-sep jj) (list 'SEP 'mrx_ ma-rn (list 'FORALL 'mri_ (list 'IMPLIES (list 'IN 'mri_ ma-int) (list 'IN '(mrx_ mri_) (list jj 'mri_))))))
(define (ma-box jj) (list 'RN-BOX 'n jj))
(define ma-rects '(RN-RECTANGLES n))
(define (ma-rect-body r)
  (list 'FORSOME 'mrj_ (list 'AND (list 'IN 'mrj_ (list 'FUN ma-int '(POWER RR)))
                         (list 'AND (list 'FORALL 'mri_ (list 'IMPLIES (list 'IN 'mri_ ma-int) '(IS-INTERVAL (mrj_ mri_))))
                                    (list '= r (ma-box 'mrj_))))))
(define ma-rects-sep (list 'SEP 'mrr_ (list 'POWER ma-rn) (ma-rect-body 'mrr_)))

(sp (make-wff (list 'FORALL 'n (list 'FORALL 'jj (list '== (ma-box 'jj) (ma-box-sep 'jj))))))
(dk-peel!)
(mac 'RN-BOX)
(qrfl)
(qed 'rn-box-unfold)

(sp (make-wff (list 'FORALL 'n (list '== ma-rects ma-rects-sep))))
(dk-peel!)
(mac 'RN-RECTANGLES)
(qrfl)
(qed 'rn-rectangles-unfold)

(sp (make-wff (list 'FORALL 'n (list 'AND (list 'IN ma-int 'SET) (list 'IN ma-rn 'SET)))))
(dk-peel!)
(let ((isep '(SEP i NN (AND (<= 1 i) (<= i n)))))
  (dk-have! (list 'IN ma-int 'SET)
    (lambda ()
      (mac 'INTERVAL)
      (ma-sep-subset! isep)
      (fact 'nn-is-set)
      (fact 'subclass-of-set-is-set isep 'NN)
      (ass)))
  (fact 'rr-is-set)
  (dk-have! (list 'AND (list 'IN ma-int 'SET) '(IN RR SET)))
  (ma-iff-back! (dk-cite! 'fun-set-iff ma-int 'RR))
  (dk-conj-close! dk-ass!))
(qed 'rn-is-set)

(define (ma-rn-set!) (dk-split! (dk-cite! 'rn-is-set 'n)))

(sp (make-wff (list 'FORALL 'n (list 'FORALL 'x (list 'FORALL 'jj (list 'IFF (list 'IN 'x (ma-box 'jj))
  (list 'AND (list 'IN 'x ma-rn) (list 'FORALL 'mri_ (list 'IMPLIES (list 'IN 'mri_ ma-int) (list 'IN '(x mri_) '(jj mri_)))))))))))
(dk-peel!)
(dk-cite! 'rn-box-unfold 'n 'jj)
(subst (list '= (ma-box 'jj) (ma-box-sep 'jj)))
(dk-iff! (lambda (g) (dk-head-is? g 'AND))
  (lambda () (ma-sep-parts! (list 'IN 'x (ma-box-sep 'jj))) (dk-conj-close! dk-ass!))
  (lambda () (dk-split-all!) (in-sep! dk-ass! dk-ass!)))
(qed 'rn-box-membership)

(sp (make-wff (list 'FORALL 'n (list 'FORALL 'jj (list 'IN (ma-box 'jj) (list 'POWER ma-rn))))))
(dk-peel!)
(ma-rn-set!)
(dk-cite! 'rn-box-unfold 'n 'jj)
(subst (list '= (ma-box 'jj) (ma-box-sep 'jj)))
(ma-sep-subset! (ma-box-sep 'jj))
(fact 'subclass-of-set-is-set (ma-box-sep 'jj) ma-rn)
(dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ (ma-box-sep 'jj)) (list 'IN 'z_ ma-rn)))
  (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd (ma-box-sep 'jj) ma-rn z) (ass))))
(dk-apply! (dk-cite! 'power-mem-intro ma-rn (ma-box-sep 'jj)))
(ass)
(qed 'rn-box-in-power)

(define ma-side-int (list 'FORALL 'mri_ (list 'IMPLIES (list 'IN 'mri_ ma-int) '(IS-INTERVAL (jj mri_)))))
(sp (make-wff (list 'FORALL 'n (list 'FORALL 'jj (list 'IMPLIES (list 'IN 'jj (list 'FUN ma-int '(POWER RR)))
  (list 'IMPLIES ma-side-int (list 'IN (ma-box 'jj) ma-rects)))))))
(dk-peel!)
(dk-cite! 'rn-rectangles-unfold 'n)
(subst (list '= ma-rects ma-rects-sep))
(dk-cite! 'rn-box-in-power 'n 'jj)
(in-sep! dk-ass!
  (lambda ()
    (ew 'jj)
    (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))
(qed 'rn-rectangle-intro)

(sp (make-wff (list 'FORALL 'n (list 'FORALL 'r (list 'IMPLIES (list 'IN 'r ma-rects)
  (list 'AND (list 'IN 'r (list 'POWER ma-rn)) (ma-rect-body 'r)))))))
(dk-peel!)
(dk-cite! 'rn-rectangles-unfold 'n)
(ma-sep-parts! (dk-rewrite-h! (list 'IN 'r ma-rects) ma-rects ma-rects-sep))
(dk-conj-close! dk-ass!)
(qed 'rn-rectangle-elim)

;;; with (IN r RN-RECTANGLES(n)) in context: land the side family, its typing, intervals, r = RN-BOX(n, jj);
;;; return the family
(define (ma-rect-open! r)
  (let ((e (dk-apply! (dk-cite! 'rn-rectangle-elim 'n) r)))
    (dk-split! e)
    (dk-skolem! (caddr e))))

;;; (13) the intersection of two rectangles is a rectangle
(define (ma-sides-inter j1 j2) (list 'VNB-LAMBDA 'mki_ ma-int (list 'INTERSECTION (list j1 'mki_) (list j2 'mki_))))
(sp (make-wff (list 'FORALL 'n (forall-guarded '(r1 r2) (list (list 'IN 'r1 ma-rects) (list 'IN 'r2 ma-rects))
  (list 'IN '(INTERSECTION r1 r2) ma-rects)))))
(dk-peel!)
(ma-rn-set!)
(let* ((j1 (ma-rect-open! 'r1)) (j2 (ma-rect-open! 'r2)) (j3 (ma-sides-inter j1 j2))
       (int-of (lambda (j) (list 'FORALL 'mri_ (list 'IMPLIES (list 'IN 'mri_ ma-int) (list 'IS-INTERVAL (list j 'mri_))))))
       (pt (lambda (j x) (list 'FORALL 'mri_ (list 'IMPLIES (list 'IN 'mri_ ma-int) (list 'IN (list x 'mri_) (list j 'mri_)))))))
  (dk-have! (list 'IN j3 (list 'FUN ma-int '(POWER RR)))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((i (dk-di-var!)))
            (fact 'fun-apply-type-c j1 ma-int '(POWER RR) i)
            (fact 'fun-apply-type-c j2 ma-int '(POWER RR) i)
            (fact 'power-inter-closed 'RR (list j1 i) (list j2 i))
            (ass)))
        (lambda () (ass)))))
  (dk-have! (int-of j3)
    (lambda ()
      (let ((i (dk-di-var!)))
        (dk-lam-b!)
        (dk-apply! (dk-ctx-form (int-of j1)) i)
        (dk-apply! (dk-ctx-form (int-of j2)) i)
        (fact 'is-interval-inter (list j1 i) (list j2 i))
        (ass))))
  (dk-apply! (dk-cite! 'rn-rectangle-intro 'n) j3)
  (subst (list '= 'r1 (ma-box j1)))
  (subst (list '= 'r2 (ma-box j2)))
  (let ((lhs (list 'INTERSECTION (ma-box j1) (ma-box j2))))
    (ma-ext2! lhs (ma-box j3)
      (lambda (x)
        (ma-iff-parts! (dk-cite! 'intersection-membership (ma-box j1) (ma-box j2) x))
        (ma-iff-parts! (dk-cite! 'rn-box-membership 'n x j1))
        (ma-iff-parts! (dk-cite! 'rn-box-membership 'n x j2))
        (dk-have! (pt j3 x)
          (lambda ()
            (let ((i (dk-di-var!)))
              (dk-lam-b!)
              (dk-apply! (dk-ctx-form (pt j1 x)) i)
              (dk-apply! (dk-ctx-form (pt j2 x)) i)
              (mac 'intersection-membership)
              (dk-conj-close! dk-ass!))))
        (ma-iff-back! (dk-cite! 'rn-box-membership 'n x j3)))
      (lambda (x)
        (ma-iff-parts! (dk-cite! 'rn-box-membership 'n x j3))
        (ma-for-each
          (lambda (j)
            (dk-have! (pt j x)
              (lambda ()
                (let* ((i (dk-di-var!))
                       (h (dk-apply! (dk-ctx-form (pt j3 x)) i)))
                  (dk-lam-b-h! h)
                  (ma-iff-parts! (dk-cite! 'intersection-membership (list j1 i) (list j2 i) (list x i)))
                  (ass))))
            (ma-iff-back! (dk-cite! 'rn-box-membership 'n x j)))
          (list j1 j2))
        (mac 'intersection-membership)
        (dk-conj-close! dk-ass!)))
    (subst (list '= lhs (ma-box j3)))
    (ass)))
(qed 'rn-rectangles-inter-closed)

;;; (14) the complement of a rectangle is a finite union of rectangles (Remark 1.5, the complement half)
(define (ma-fam-ray jj k lo?) (list 'VNB-LAMBDA 'mki_ ma-int (if lo? (ma-lo jj 'mki_ k) (ma-hi jj 'mki_ k))))
(define (ma-pc jj lo?) (list 'VNB-LAMBDA 'mkk_ ma-int (ma-box (ma-fam-ray jj 'mkk_ lo?))))
(define ma-sides-pow (list 'IN 'jj (list 'FUN ma-int '(POWER RR))))

;;; the rectangle whose k-th side is the ray below (above) jj(k), the others R
(define (ma-ray-rect! lo?)
  (dk-peel!)
  (ma-rn-set!)
  (fact 'rr-is-set)
  (let* ((fam (ma-fam-ray 'jj 'k lo?)))
    (dk-have! (list 'IN fam (list 'FUN ma-int '(POWER RR)))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let* ((i (dk-di-var!)) (ray (if lo? (ma-lo 'jj i 'k) (ma-hi 'jj i 'k))))
              (ma-sep-subset! ray)
              (fact 'subclass-of-set-is-set ray 'RR)
              (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ ray) '(IN z_ RR)))
                (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd ray 'RR z) (ass))))
              (dk-apply! (dk-cite! 'power-mem-intro 'RR ray))
              (ass)))
          (lambda () (ass)))))
    (dk-have! (list 'FORALL 'mri_ (list 'IMPLIES (list 'IN 'mri_ ma-int) (list 'IS-INTERVAL (list fam 'mri_))))
      (lambda ()
        (let ((i (dk-di-var!)))
          (dk-lam-b!)
          (dk-apply! (dk-ctx-form ma-side-int) i)
          (car (ma-int-open! (list 'jj i)))
          (fact (if lo? 'rn-ray-below-interval 'rn-ray-above-interval) 'jj i 'k)
          (ass))))
    (dk-apply! (dk-cite! 'rn-rectangle-intro 'n) fam)
    (ass)))

(sp (make-wff (list 'FORALL 'n (list 'FORALL 'jj (list 'FORALL 'k (list 'IMPLIES ma-sides-pow (list 'IMPLIES ma-side-int
  (list 'IN (ma-box (ma-fam-ray 'jj 'k #t)) ma-rects))))))))
(ma-ray-rect! #t)
(qed 'rn-ray-below-rectangle)

(sp (make-wff (list 'FORALL 'n (list 'FORALL 'jj (list 'FORALL 'k (list 'IMPLIES ma-sides-pow (list 'IMPLIES ma-side-int
  (list 'IN (ma-box (ma-fam-ray 'jj 'k #f)) ma-rects))))))))
(ma-ray-rect! #f)
(qed 'rn-ray-above-rectangle)

(sp (make-wff (list 'FORALL 'n (list 'SUBSET ma-rects (list 'POWER ma-rn)))))
(dk-peel!)
(dk-cite! 'rn-rectangles-unfold 'n)
(subst (list '= ma-rects ma-rects-sep))
(ma-sep-subset! ma-rects-sep)
(ass)
(qed 'rn-rectangles-subset-power)

(define ma-rfu (list 'FINITE-UNIONS ma-rn ma-rects))
(sp (make-wff (forall-guarded '(n) '((IN n NN))
  (list 'FORALL 'jj (list 'IMPLIES ma-sides-pow (list 'IMPLIES ma-side-int
    (list 'IN (list 'COMPLEMENT-IN ma-rn (ma-box 'jj)) ma-rfu)))))))
(dk-peel!)
(ma-rn-set!)
(fact 'rr-is-set)
(fact 'nn-one-in)
(fact 'rn-rectangles-subset-power 'n)
(let* ((pl (ma-pc 'jj #t)) (ph (ma-pc 'jj #f))
       (il (list 'IMAGE pl ma-int)) (ih (list 'IMAGE ph ma-int)) (ff (list 'UNION il ih))
       (cb (list 'COMPLEMENT-IN ma-rn (ma-box 'jj))))
  ;; the family is a finite set of rectangles
  (dk-have! '(AND (IN 1 NN) (IN n NN)))
  (fact 'interval-card-in-nn 1 'n)
  (dk-cite! 'image-set pl ma-int)
  (dk-cite! 'image-set ph ma-int)
  (dk-cite! 'card-image-finite pl ma-int)
  (dk-cite! 'card-image-finite ph ma-int)
  (dk-have! (list 'AND (list 'IN il 'SET) (list 'IN ih 'SET)))
  (fact 'union-set-closure il ih)
  (dk-apply! (dk-cite! 'card-union-nn il) ih)
  (dk-have! (list 'SUBSET ff ma-rects)
    (lambda ()
      (mac 'subset-def)
      (let* ((z (dk-di-var!))
             (or1 (car (ma-iff-parts! (dk-cite! 'union-membership il ih z)))))
        (ma-or-split! or1
          (ma-map
            (lambda (lo?)
              (lambda ()
                (let* ((p (if lo? pl ph)) (im (list 'IMAGE p ma-int))
                       (ex (cadr (ma-iff-parts! (dk-cite! 'image-membership-iff p ma-int z))))
                       (k (dk-skolem! ex))
                       (eqn (dk-ctx-form (list '= (list p k) z))))
                  (dk-lam-b-h! eqn)
                  (let ((bx (ma-box (ma-fam-ray 'jj k lo?))))
                    (dk-apply! (dk-cite! (if lo? 'rn-ray-below-rectangle 'rn-ray-above-rectangle) 'n 'jj k))
                    (dk-rewrite-h! (list 'IN bx ma-rects) bx z)
                    (ass)))))
            (list #t #f))))))
  (dk-apply! (dk-cite! 'finite-unions-intro ma-rn ma-rects) ff)
  ;; the complement is the union of the family
  (ma-ext2! cb (ma-bu ff)
    (lambda (x)
      (ma-iff-parts! (dk-cite! 'complement-in-membership ma-rn (ma-box 'jj) x))
      (let* ((bm (dk-cite! 'rn-box-membership 'n x 'jj))
             (allf (caddr (caddr bm)))
             (nall (ma-by-prop! (list 'NOT allf) (list bm (list 'IN x ma-rn) (list 'NOT (list 'IN x (ma-box 'jj))))))
             (ex (dk-landed-1 (lambda () (push-not-h (list 'NOT allf)))))
             (k (dk-skolem! ex)))
        (fact 'fun-apply-type-c x ma-int 'RR k)
        (dk-apply! (dk-ctx-form ma-side-int) k)
        (let ((or1 (dk-apply! (dk-cite! 'interval-outside-below-or-above (list 'jj k) (list x k)))))
          (ma-or-split! or1
            (ma-map
              (lambda (lo?)
                (lambda ()
                  (let* ((fam (ma-fam-ray 'jj k lo?)) (bx (ma-box fam)) (p (if lo? pl ph)) (im (list 'IMAGE p ma-int))
                         (side (if lo? (cadr or1) (caddr or1))))
                    ;; x lies in the ray rectangle
                    (dk-have! (list 'FORALL 'mri_ (list 'IMPLIES (list 'IN 'mri_ ma-int) (list 'IN (list x 'mri_) (list fam 'mri_))))
                      (lambda ()
                        (let ((i (dk-di-var!)))
                          (dk-lam-b!)
                          (fact 'fun-apply-type-c x ma-int 'RR i)
                          (in-sep! dk-ass!
                            (lambda ()
                              (di)
                              (subst (list '= i k))
                              (ass))))))
                    (ma-iff-back! (dk-cite! 'rn-box-membership 'n x fam))
                    ;; the ray rectangle is a member of the family
                    (dk-cite! 'rn-box-in-power 'n fam)
                    (fact 'power-mem-sethood ma-rn bx)
                    (dk-have! (list 'IN bx im)
                      (lambda ()
                        (mac 'image-membership-iff)
                        (dk-conj-close!
                          (lambda ()
                            (cond ((dk-ass!) #t)
                                  ((dk-head-is? (dk-goal) 'FORSOME)
                                   (ew k)
                                   (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (dk-lam-b!) (rfl))))))
                                  (#t (dk-lam-b!) (rfl)))))))
                    (if lo? (ma-in-union-left! bx il ih) (ma-in-union-right! bx il ih))
                    (ma-bu-close! bx))))
              (list #t #f))))))
    (lambda (x)
      (let* ((r (ma-bu-open! x (ma-bu ff))) (rv (car r))
             (or1 (car (ma-iff-parts! (dk-cite! 'union-membership il ih rv)))))
        (ma-or-split! or1
          (ma-map
            (lambda (lo?)
              (lambda ()
                (let* ((p (if lo? pl ph))
                       (ex (cadr (ma-iff-parts! (dk-cite! 'image-membership-iff p ma-int rv))))
                       (k (dk-skolem! ex))
                       (eqn (dk-ctx-form (list '= (list p k) rv))))
                  (dk-lam-b-h! eqn)
                  (let* ((fam (ma-fam-ray 'jj k lo?)) (bx (ma-box fam))
                         (ray (if lo? (ma-lo 'jj k k) (ma-hi 'jj k k))))
                    (dk-rewrite-h! (cdr r) rv bx)
                    (ma-iff-parts! (dk-cite! 'rn-box-membership 'n x fam))
                    (let ((h (dk-apply! (dk-ctx-form (list 'FORALL 'mri_ (list 'IMPLIES (list 'IN 'mri_ ma-int) (list 'IN (list x 'mri_) (list fam 'mri_))))) k)))
                      (dk-lam-b-h! h))
                    (let ((pr (ma-sep-parts! (list 'IN (list x k) ray))))
                      (dk-have! (list '= k k) (lambda () (rfl)))
                      (let ((side (dk-landed-1 (lambda () (detach! pr)))))
                        (mac 'complement-in-membership)
                        (dk-conj-close!
                          (lambda ()
                            (if (not (dk-ass!))
                                (begin
                                  (di)
                                  (ma-iff-parts! (dk-cite! 'rn-box-membership 'n x 'jj))
                                  (dk-apply! (dk-ctx-form (list 'FORALL 'mri_ (list 'IMPLIES (list 'IN 'mri_ ma-int) (list 'IN (list x 'mri_) '(jj mri_))))) k)
                                  (fact 'fun-apply-type-c x ma-int 'RR k)
                                  (let ((lt (dk-apply! side (list x k))))
                                    (dk-cite! 'rr-lt-irrefl (list x k))
                                    (ma-prop-with! (list lt (list 'NOT lt))))))))))))))
            (list #t #f))))))
  (subst (list '= cb (ma-bu ff)))
  (ass))
(qed 'rn-rectangle-complement-finite-union)

;;; (15) COR. 1.6: the finite unions of rectangles in R^n form an algebra
(sp (make-wff (forall-guarded '(n) '((IN n NN)) (list 'IS-ALGEBRA-OF-SETS ma-rn ma-rfu))))
(dk-peel!)
(ma-rn-set!)
(fact 'rr-is-set)
(fact 'rn-rectangles-subset-power 'n)
(let* ((j0 (list 'VNB-LAMBDA 'mki_ ma-int 'RR))
       (bx (ma-box j0)))
  ;; R^n is a rectangle: the family is non-empty
  (dk-have! (list 'FORSOME 'mie_ (list 'IN 'mie_ ma-rects))
    (lambda ()
      (dk-have! (list 'IN j0 (list 'FUN ma-int '(POWER RR)))
        (lambda ()
          (dk-lam-type!
            (lambda () (dk-di-var!) (fact 'power-whole-in 'RR) (ass))
            (lambda () (ass)))))
      (dk-have! (list 'FORALL 'mri_ (list 'IMPLIES (list 'IN 'mri_ ma-int) (list 'IS-INTERVAL (list j0 'mri_))))
        (lambda () (dk-di-var!) (dk-lam-b!) (fact 'is-interval-rr) (ass)))
      (dk-apply! (dk-cite! 'rn-rectangle-intro 'n) j0)
      (ew bx)
      (ass)))
  ;; closed under intersection
  (dk-cite! 'rn-rectangles-inter-closed 'n)
  ;; complements are finite unions
  (dk-have! (forall-guarded '(mia_) (list (list 'IN 'mia_ ma-rects)) (list 'IN (list 'COMPLEMENT-IN ma-rn 'mia_) ma-rfu))
    (lambda ()
      (let* ((r (dk-di-var!)) (jj (ma-rect-open! r)))
        (subst (list '= r (ma-box jj)))
        (dk-apply! (dk-cite! 'rn-rectangle-complement-finite-union 'n) jj)
        (ass))))
  (dk-apply! (dk-cite! 'finite-unions-algebra ma-rn ma-rects))
  (ass))
(qed 'rn-rectangles-finite-unions-algebra)
