(dk-project! (list 'IN mlh-Ef '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'cA mlh-Ef))
(mlh-fun1! mlh-Af 'RR-POS-STAR) (mlh-fun1! mlh-Ef 'RR-POS-STAR)
(dk-have! (list 'FORALL 'mdtz_ (list 'IMPLIES '(IN mdtz_ omega) (list '= (list mlh-Af 'mdtz_) (list mlh-Ef 'mdtz_))))
  (lambda ()
    (let* ((x (dk-di-var!)) (fx (mlh-sqx! x)) (sq (list '* fx fx)) (afx (list 'abs fx)))
      (dk-cite! 'fun-apply-type-c mlh-sqf 'omega 'RR x)
      (dk-have! (list '= (list mlh-sqf x) sq) (lambda () (mlh-beta!) (if (mlh-open?) (rfl))))
      (dk-cite! 'abs-fn-value 'omega mlh-sqf x)
      (dk-cite! 'abs-fn-value 'omega 'f x)
      (mlh-rps! afx)
      (dk-cite! 'ptwise-epow-value 'omega '(ABS-FN omega f) 2 x)
