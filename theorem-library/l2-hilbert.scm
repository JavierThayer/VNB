;;; me-l2.scm -- REAL L^2 IS A HILBERT SPACE: the SIP quotient of L2-SPACE is complete (Riesz-Fischer, p = 2,
;;; transported to the quotient).  Agent M-D (M-E targets), worker-02, 2026-10-28.
;;; DESTINATION: theorem-library/l2-hilbert.scm.  Library: measure.  Helper prefix: mlh-.
;;; Load window: after me-rf.scm (lp-complete), sip-c.scm (L2-SPACE laws), sip-d1.scm (SIP-METRIC-SPACE).

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (mlh-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MLH OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mlh-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (mlh-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define (mlh-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define (mlh-split! c)
  (if (and (pair? c) (eq? (car c) 'AND) (dk-asm? (cadr c)) (dk-asm? (caddr c))) c (dk-split! c)))
(define (mlh-has-lam? g)
  (and (pair? g)
       (or (and (pair? (car g)) (eq? (caar g) 'VNB-LAMBDA))
           (let loop ((l g)) (and (pair? l) (or (mlh-has-lam? (car l)) (loop (cdr l))))))))
(define (mlh-beta!) (if (mlh-has-lam? (dk-goal)) (dk-lam-b!)))
(define (mlh-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (mlh-rps! t) (if (not (dk-asm? (list 'IN t 'RR-POS-STAR))) (dk-cite! 'rmc-rps-of-nonneg t)))
(define (mlh-pos-of fs) (find-first (lambda (h) (dk-head-is? h 'POS-RR)) fs))
(define (mlh-pos-parts! e) (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))

;;; ---------------------------------------------------------------------------
;;; t^2 in [0, +inf] is t * t for a nonnegative real
;;; ---------------------------------------------------------------------------
(sp (make-wff '(FORALL t (IMPLIES (IN t RR) (IMPLIES (<= 0 t) (= (EPOW t 2) (* t t)))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'nn-zero-in) (fact 'nn-one-in)
(dk-have! '(IN 2 RR) (lambda () (arith)))
(dk-have! '(< 0 2) (lambda () (dk-ineq!)))
(dk-have! '(IN 2 NN) (lambda () (arith)))
(use-em '(= t 0)
  (lambda ()
    (subst '(= t 0))
    (dk-cite! 'epow-zero 2)
    (subst '(= (EPOW 0 2) 0))
    (dk-have! '(= (* 0 0) 0) (lambda () (arith)))
    (subst '(= (* 0 0) 0))
    (if (mlh-open?) (rfl)))
  (lambda ()
    (dk-have! '(< 0 t) (lambda () (mac '<) (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (di) (dk-have! '(= t 0) (lambda () (dk-ineq! '(IN t RR) '(= 0 t)))) (ai '(NOT (= t 0)))))))))
    (dk-cite! 'epow-real 't 2)
    (dk-cite! 'rpow-star-nat 2 't)
    (dk-cite! 'rr-subset-cc 't)
    (mlh-and! '(IN t CC) '(IN 1 NN))
    (mlh-and! '(IN t CC) '(IN 0 NN))
    (dk-cite! 'power-succ 't 1)
    (dk-cite! 'power-succ 't 0)
    (dk-cite! 'power-zero 't)
    (dk-have! '(= (succ 1) 2) (lambda () (arith)))
    (dk-have! '(= (succ 0) 1) (lambda () (arith)))
    (dk-rewrite-h! '(= (power t (succ 1)) (* t (power t 1))) '(succ 1) 2)
    (dk-rewrite-h! '(= (power t (succ 0)) (* t (power t 0))) '(succ 0) 1)
    (subst '(== (EPOW t 2) (RPOW-STAR t 2)))
    (subst '(= (rpow-star t 2) (power t 2)))
    (subst '(= (power t 2) (* t (power t 1))))
    (subst '(= (power t 1) (* t (power t 0))))
    (subst '(= (power t 0) 1))
    (if (mlh-open?) (crs))))
(mlh-qed! 'epow-two-real)

;;; |a| * |a| = a * a
(sp (make-wff '(FORALL a (IMPLIES (IN a RR) (= (* (abs a) (abs a)) (* a a))))))
(dk-peel!)
(mlh-and! '(IN a RR) '(IN a RR))
(dk-cite! 'rr-abs-mult 'a 'a)
(dk-cite! 'rr-sq-nonneg 'a)
(dk-type! '(* a a))
(dk-cite! 'rr-abs-of-nonneg '(* a a))
(subst '(= (* (abs a) (abs a)) (abs (* a a))))
(subst '(= (abs (* a a)) (* a a)))
(if (mlh-open?) (rfl))
(mlh-qed! 'abs-times-abs)

;;; ---------------------------------------------------------------------------
;;; the L^2 distance of two square-integrable functions is their L^2 seminorm distance
;;; ---------------------------------------------------------------------------
(define mlh-L2 '(L2-SET omega cA mu))
(define mlh-LS '(L2-SPACE omega cA mu))
(define mlh-dfg '((VADD (L2-SPACE omega cA mu)) f ((VNEG (L2-SPACE omega cA mu)) g)))
(define mlh-dl '(VNB-LAMBDA sx_ omega (- (f sx_) (g sx_))))
(define mlh-ng '(VNB-LAMBDA lx_ omega (- (g lx_))))
(define mlh-D (list 'VNB-LAMBDA 'lx_ 'omega (list '+ '(f lx_) (list mlh-ng 'lx_))))
(define mlh-P (list 'VNB-LAMBDA 'lx_ 'omega (list '* (list mlh-D 'lx_) (list mlh-D 'lx_))))
(define mlh-PE (list 'PTWISE-EPOW 'omega (list 'ABS-FN 'omega mlh-dl) 2))
(sp (make-wff (mlh-alls '(omega cA mu f g) (mlh-imps (list '(IS-MEASURE omega cA mu) (list 'IN 'f mlh-L2) (list 'IN 'g mlh-L2))
   (list '= (list 'SQRT (list '(RIP (L2-SPACE omega cA mu)) mlh-dfg mlh-dfg)) (list 'LP-NORM 'omega 'cA 'mu 2 mlh-dl))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'nn-is-set)
(dk-project! '(IS-SIGMA-ALGEBRA omega cA) 'is-measure '(IS-MEASURE omega cA mu))
(dk-cite! 'sigma-algebra-ambient-set 'omega 'cA)
(dk-have! '(IN 2 RR) (lambda () (arith)))
(dk-have! '(< 0 2) (lambda () (dk-ineq!)))
(for-each (lambda (h) (dk-split-all! (list (dk-cite! 'l2-out 'omega 'cA 'mu h)))) '(f g))
(for-each (lambda (acc) (subst (dk-cite! (symbol-append 'l2-space- acc) 'omega 'cA 'mu)))
          '(VADD VNEG RIP))
(dk-cite! 'l2-neg-closed 'omega 'cA 'mu 'g)
(subst (dk-cite! 'l2-vneg-value 'omega 'cA 'mu 'g))
(dk-cite! 'l2-add-closed 'omega 'cA 'mu 'f mlh-ng)
(subst (dk-cite! 'l2-vadd-value 'omega 'cA 'mu 'f mlh-ng))
(subst (dk-cite! 'l2-rip-value 'omega 'cA 'mu mlh-D mlh-D))
;; the integrand, pointwise
(dk-cite! 'l2-prod-integrable 'omega 'cA 'mu mlh-D mlh-D)
(dk-split-all! (list (dk-cite! 'l2-out 'omega 'cA 'mu mlh-D)))
(define (mlh-pt! x)                    ; x in omega: (= (P x) (* d d)), d = f x - g x, typed
  (dk-cite! 'fun-apply-type-c 'f 'omega 'RR x)
  (dk-cite! 'fun-apply-type-c 'g 'omega 'RR x)
  (let* ((d (list '- (list 'f x) (list 'g x))) (e (list '= (list mlh-P x) (list '* d d))))
    (dk-type! d) (dk-type! (list '* d d)) (dk-cite! 'rr-sq-nonneg d)
    (if (not (dk-asm? e))
        (dk-have! e (lambda () (mlh-beta!) (if (mlh-open?) (crs)))))
    d))
(dk-have! (list 'IN mlh-P '(FUN omega RR))
  (lambda () (dk-lam-type! (lambda () (let* ((x (dk-di-var!)) (d (mlh-pt! x))) (mlh-beta!) (if (mlh-open?) (begin (dk-type! (cadr (dk-goal))) (dk-ass!)))))
                           (lambda () (dk-ass!)))))
(dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list '<= 0 (list mlh-P 'x))))
  (lambda () (let* ((x (dk-di-var!)) (d (mlh-pt! x))) (subst (list '= (list mlh-P x) (list '* d d))) (dk-ass!))))
(dk-split-all! (list (dk-cite! 'rintegral-of-nonneg 'omega 'cA 'mu mlh-P)))
(dk-cite! 'rintegral-in-rr 'omega 'cA 'mu mlh-P)
;; P = |d|^2
(dk-cite! 'real-measurable-sub 'omega 'cA 'f 'g)
(dk-project! (list 'IN mlh-dl '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'cA mlh-dl))
(dk-cite! 'abs-fn-fun 'omega mlh-dl)
(dk-cite! 'integral-abs-fn 'omega 'cA 'mu mlh-dl)
(mlh-split! (dk-ctx-form (list 'AND (list 'IS-MEASURABLE-FN 'omega 'cA (list 'ABS-FN 'omega mlh-dl))
                               (list '= (list 'INTEGRAL 'omega 'cA 'mu (list 'ABS-FN 'omega mlh-dl))
                                     (list 'eplus (list 'INTEGRAL 'omega 'cA 'mu (list 'POS-PART 'omega mlh-dl)) (list 'INTEGRAL 'omega 'cA 'mu (list 'NEG-PART 'omega mlh-dl)))))))
(dk-cite! 'measurable-fn-epow 'omega 'cA (list 'ABS-FN 'omega mlh-dl) 2)
(dk-project! (list 'IN mlh-PE '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'cA mlh-PE))
(define (mlh-fun1! f cod)
  (if (not (dk-asm? (list 'IN f '(FUN omega))))
      (let ((fi (dk-cite! 'fun-codomain-iff 'omega cod f)))
        (dk-have! (caddr fi) (lambda () (if (dk-only! fi (list 'IN f (list 'FUN 'omega cod))) (prop))))
        (mlh-split! (caddr fi)))))
(mlh-fun1! mlh-P 'RR) (mlh-fun1! mlh-PE 'RR-POS-STAR)
(dk-have! (list 'FORALL 'mdtz_ (list 'IMPLIES '(IN mdtz_ omega) (list '= (list mlh-P 'mdtz_) (list mlh-PE 'mdtz_))))
  (lambda ()
    (let* ((x (dk-di-var!)) (d (mlh-pt! x)) (ad (list 'abs d)) (dlx (list mlh-dl x)))
      (dk-cite! 'rr-abs-closed d) (dk-cite! 'rr-abs-nonneg d) (mlh-rps! ad)
      (dk-cite! 'fun-apply-type-c mlh-dl 'omega 'RR x)
      (dk-have! (list '= dlx d) (lambda () (mlh-beta!) (if (mlh-open?) (rfl))))
      (dk-cite! 'abs-fn-value 'omega mlh-dl x)
      (dk-cite! 'ptwise-epow-value 'omega (list 'ABS-FN 'omega mlh-dl) 2 x)
      (dk-cite! 'epow-two-real ad)
      (dk-cite! 'abs-times-abs d)
      (subst (list '= (list mlh-P x) (list '* d d)))
      (subst (list '= (list mlh-PE x) (list 'EPOW (list (list 'ABS-FN 'omega mlh-dl) x) 2)))
      (subst (list '== (list (list 'ABS-FN 'omega mlh-dl) x) (list 'abs dlx)))
      (subst (list '= dlx d))
      (subst (list '= (list 'EPOW ad 2) (list '* ad ad)))
      (subst (list '= (list '* ad ad) (list '* d d)))
      (if (mlh-open?) (rfl)))))
(dk-cite! 'fun-domain-extensionality 'omega mlh-P mlh-PE)
(define mlh-I (list 'INTEGRAL 'omega 'cA 'mu mlh-PE))
(dk-cite! 'integral-in 'omega 'cA 'mu mlh-PE)
(dk-have! (list '= (list 'RINTEGRAL 'omega 'cA 'mu mlh-P) mlh-I)
  (lambda () (subst (list '= (list 'RINTEGRAL 'omega 'cA 'mu mlh-P) (list 'INTEGRAL 'omega 'cA 'mu mlh-P))) (subst (list '= mlh-P mlh-PE)) (if (mlh-open?) (rfl))))
(dk-have! (list 'IN mlh-I 'RR) (lambda () (subst (list '= mlh-I (list 'RINTEGRAL 'omega 'cA 'mu mlh-P))) (dk-ass!)))
(dk-cite! 'integral-in 'omega 'cA 'mu mlh-PE)
(dk-cite! 'rr-pos-star-nonneg mlh-I)
;; the seminorm: e = I^{1/2}, e * e = I
(dk-have! '(IN (recip 2) RR) (lambda () (dk-have! '(NOT (= 2 0)) (lambda () (arith))) (mlh-and! '(IN 2 RR) '(NOT (= 2 0))) (dk-cite! 'rr-recip-closed 2) (if (mlh-open?) (dk-ass!))))
(dk-have! '(< 0 (recip 2)) (lambda () (dk-have! '(= (recip 2) 1/2) (lambda () (arith))) (subst '(= (recip 2) 1/2)) (dk-ineq!)))
(define mlh-e (list 'EPOW mlh-I '(recip 2)))
(mlh-split! (dk-apply! (dk-cite! 'epow-real-in mlh-I) '(recip 2)))
(mlh-split! (dk-cite! 'epow-inverse mlh-I 2))
(dk-cite! 'epow-two-real mlh-e)
(dk-have! (list '= (list '* mlh-e mlh-e) mlh-I) (lambda () (subst (list '= (list '* mlh-e mlh-e) (list 'EPOW mlh-e 2))) (dk-ass!)))
(mlh-and! (list 'IN mlh-I 'RR) (list '<= 0 mlh-I))
(mlh-and! (list 'IN mlh-e 'RR) (list '<= 0 mlh-e))
(dk-cite! 'sqrt-char mlh-I mlh-e)
(dk-cite! 'lp-norm-as-epow 'omega 'cA 'mu 2 mlh-dl)
(subst (list '= (list 'RINTEGRAL 'omega 'cA 'mu mlh-P) mlh-I))
(subst (list '= (list 'SQRT mlh-I) mlh-e))
(subst (list '== (list 'LP-NORM 'omega 'cA 'mu 2 mlh-dl) (list 'EPOW (list 'INTEGRAL 'omega 'cA 'mu (list 'PTWISE-EPOW 'omega (list 'ABS-FN 'omega mlh-dl) 2)) '(recip 2))))
(if (mlh-open?) (rfl))
(mlh-qed! 'l2-dist-lp-norm)

;;; ===========================================================================
;;; A semi-inner-product space complete for its seminorm has a complete (Hilbert) quotient
;;; ===========================================================================
(define (mlh-vd a b) (list '(VADD v) a (list '(VNEG v) b)))
(define (mlh-nv a b) (list 'SQRT (list '(RIP v) (mlh-vd a b) (mlh-vd a b))))
(define mlh-sc
  (list 'FORALL 's (list 'IMPLIES '(IN s (FUN NN (VEC v)))
    (list 'IMPLIES
      (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'nb (list 'AND '(IN nb NN)
        (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'q (list 'IMPLIES '(IN q NN)
          (list 'IMPLIES '(<= nb m) (list 'IMPLIES '(<= nb q) (list '<= (mlh-nv '(s m) '(s q)) 'eps)))))))))))
      (list 'FORSOME 'a (list 'AND '(IN a (VEC v))
        (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'nb (list 'AND '(IN nb NN)
          (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IMPLIES '(<= nb n_) (list '<= (mlh-nv '(s n_) 'a) 'eps))))))))))))))
(define mlh-Q '(SIP-QUOTIENT v))
(define mlh-S '(SIP-SETOID v))
(define mlh-M '(SIP-METRIC-SPACE (SIP-QUOTIENT v)))
(define (mlh-cl a) (list 'CLASS mlh-S a))
(define (mlh-vt! x)                    ; type a vector expression of v by citation
  (let ((want (list 'IN x '(VEC v))))
    (cond ((dk-asm? want) x)
          ((and (pair? x) (equal? (car x) '(VADD v)))
           (mlh-vt! (cadr x)) (mlh-vt! (caddr x))
           (dk-cite! 'module-vadd-type-sip-as-module 'v (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG v)))
           (mlh-vt! (cadr x))
           (dk-cite! 'module-vneg-type-sip-as-module 'v (cadr x)) x)
          (#t (error "mlh-vt!: cannot type" (expression->string x))))))
(define (mlh-nv-typed! a b)            ; nv(a,b) real nonneg
  (let ((d (mlh-vd a b)))
    (mlh-vt! d)
    (dk-cite! 'sip-rip-type 'v d d)
    (dk-cite! 'sip-rip-self-nonneg 'v d)
    (mlh-and! (list 'IN (list '(RIP v) d d) 'RR) (list '<= 0 (list '(RIP v) d d)))
    (mlh-split! (dk-cite! 'sqrt-nonneg (list '(RIP v) d d)))))
(define (mlh-dist! a b)                ; a, b in VEC v: (= (DIST M (CLASS a) (CLASS b)) nv(a,b))
  (let* ((ca (mlh-cl a)) (cb (mlh-cl b)) (nb (list '(VNEG v) b)) (d (mlh-vd a b))
         (e (list '= (list (list 'DIST mlh-M) ca cb) (mlh-nv a b))))
    (if (not (dk-asm? e))
        (begin
          (mlh-vt! d)
          (mlh-nv-typed! a b)
          (for-each (lambda (t) (if (not (dk-asm? (list 'IN (mlh-cl t) (list 'VEC mlh-Q))))
                                    (begin (mlh-vt! t)
                                           (if (not (dk-asm? (list 'IN t (list 'PTS mlh-S))))
                                               (dk-have! (list 'IN t (list 'PTS mlh-S)) (lambda () (subst (list '== (list 'PTS mlh-S) '(VEC v))) (dk-ass!))))
                                           (dk-cite! 'class-in-quotient mlh-S t)
                                           (dk-have! (list 'IN (mlh-cl t) (list 'VEC mlh-Q)) (lambda () (subst (list '== (list 'VEC mlh-Q) (list 'QUOTIENT mlh-S))) (dk-ass!))))))
                    (list a b d))
          (dk-cite! 'sip-metric-space-dist mlh-Q ca cb)
          (dk-cite! 'sipq-vneg-computes 'v b)
          (dk-cite! 'sipq-vadd-computes 'v a nb)
          (dk-cite! 'sipq-rip-computes 'v d d)
          (dk-have! e
            (lambda ()
              (subst (list '= (list (list 'DIST mlh-M) ca cb)
                           (list 'SQRT (list (list 'RIP mlh-Q) (list (list 'VADD mlh-Q) ca (list (list 'VNEG mlh-Q) cb))
                                                               (list (list 'VADD mlh-Q) ca (list (list 'VNEG mlh-Q) cb))))))
              (subst (list '= (list (list 'VNEG mlh-Q) cb) (mlh-cl nb)))
              (subst (list '= (list (list 'VADD mlh-Q) ca (mlh-cl nb)) (mlh-cl d)))
              (subst (list '= (list (list 'RIP mlh-Q) (mlh-cl d) (mlh-cl d)) (list '(RIP v) d d)))
              (if (mlh-open?) (rfl))))))
    e))
(define (mlh-tsub x y t) (cond ((equal? t x) y) ((pair? t) (map (lambda (u) (mlh-tsub x y u)) t)) (#t t)))
(define (mlh-sc-cauchy sq) (mlh-tsub 's sq (cadr (caddr (caddr mlh-sc)))))
(define (mlh-sc-conv sq a) (mlh-tsub 'a a (mlh-tsub 's sq (caddr (caddr (caddr (caddr (caddr mlh-sc))))))))
(define (mlh-main! fq)
  (let* ((pm (list 'PTS mlh-M)) (vq (list 'VEC mlh-Q)) (qs (list 'QUOTIENT mlh-S))
         (dm (list 'DIST mlh-M))
         (cyf (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'N (list 'AND '(IN N NN)
                (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                  (list 'IMPLIES '(AND (<= N m) (<= N n_)) (list '<= (list dm (list fq 'm) (list fq 'n_)) 'eps)))))))))))
         (fam (list 'VNB-LAMBDA 'rqk_ 'NN (list 'SEP 'rqa_ '(VEC v) (list '= (list fq 'rqk_) (mlh-cl 'rqa_)))))
         (famk (lambda (k) (list 'SEP 'rqa_ '(VEC v) (list '= (list fq k) (mlh-cl 'rqa_)))))
         (fam-at! (lambda (k)
                    (let ((e (list '= (list fam k) (famk k))))
                      (if (not (dk-asm? e))
                          (dk-have! e (lambda ()
                                        (dk-have! (list 'IN (famk k) 'SET) (lambda () (dk-sethood! (famk k))))
                                        (mlh-beta!) (if (mlh-open?) (rfl)))))
                      e))))
    (dk-project! (list 'IN fq (list 'FUN 'NN pm)) 'is-cauchy-seq (list 'IS-CAUCHY-SEQ mlh-M fq))
    (dk-rewrite-h! (list 'IN fq (list 'FUN 'NN pm)) pm vq)
    (dk-rewrite-h! (list 'IN fq (list 'FUN 'NN vq)) vq qs)
    (dk-project! cyf 'is-cauchy-seq (list 'IS-CAUCHY-SEQ mlh-M fq))
    (let ((ch (dk-fact! 'rmm-nn-choice '(VEC v) fam)))
      (dk-have! (cadr ch)
        (lambda ()
          (let* ((k (dk-di-var!)))
            (dk-cite! 'fun-apply-type-c fq 'NN qs k)
            (let* ((qr (dk-cite! 'quotient-rep mlh-S (list fq k)))
                   (a (dk-skolem! qr #t)))
              (dk-rewrite-h! (list 'IN a (list 'PTS mlh-S)) (list 'PTS mlh-S) '(VEC v))
              (ew a)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin (subst (fam-at! k))
                             (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))))))))
      (detach! ch)
      (let* ((sq (dk-skolem! (caddr ch) #t))
             (prop (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f sq))) "the choice property"))
             (rep-at! (lambda (k)
                        (dk-cite! 'fun-apply-type-c sq 'NN '(VEC v) k)
                        (let ((e (list '= (list fq k) (mlh-cl (list sq k)))))
                          (if (not (dk-asm? e))
                              (let ((m (dk-apply! prop k)))
                                (fam-at! k)
                                (dk-rewrite-h! m (list fam k) (famk k))
                                (sep-me (dk-ctx-form (list 'IN (list sq k) (famk k))))
                                (dk-split-all!)))
                          e))))
        ;; sq is Cauchy for the seminorm
        (dk-have! (mlh-sc-cauchy sq)
          (lambda ()
            (let* ((ld (begin (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!)) (dk-asms))) (eps (cadr (mlh-pos-of ld))))
              (let* ((nN (dk-skolem! (dk-apply! (dk-ctx-form cyf) eps) #t))
                     (tl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nN) (dk-contains? f eps))) "the Cauchy tail")))
                (ew nN)
                (dk-conj-close!
                  (lambda ()
                    (if (not (dk-ass!))
                        (let* ((ld2 (dk-peel!))
                               (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ld2))
                               (m (cadr (car ins))) (q (cadr (cadr ins))))
                          (rep-at! m) (rep-at! q)
                          (mlh-and! (list '<= nN m) (list '<= nN q))
                          (let* ((h (dk-apply! tl m q))
                                 (h1 (dk-rewrite-h! (dk-ctx-form (list '<= (list dm (list fq m) (list fq q)) eps)) (list fq m) (mlh-cl (list sq m))))
                                 (h2 (dk-rewrite-h! (dk-ctx-form (list '<= (list dm (mlh-cl (list sq m)) (list fq q)) eps)) (list fq q) (mlh-cl (list sq q)))))
                            (mlh-dist! (list sq m) (list sq q))
                            (dk-rewrite-h! (dk-ctx-form (list '<= (list dm (mlh-cl (list sq m)) (mlh-cl (list sq q))) eps))
                                           (list dm (mlh-cl (list sq m)) (mlh-cl (list sq q))) (mlh-nv (list sq m) (list sq q)))
                            (dk-ass!))))))))))
        (let* ((cv (dk-apply! (dk-ctx-form mlh-sc) sq))
               (ex (dk-ctx-form (mlh-tsub 's sq (caddr (caddr (caddr mlh-sc))))))
               (a (dk-skolem! ex #t))
               (cva (dk-ctx-form (mlh-sc-conv sq a)))
               (lq (mlh-cl a)))
          (mac 'CONVERGES)
          (ew lq)
          (mac 'CONVERGES-TO)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (let ((g (dk-goal)))
                    (cond
                      ((dk-head-is? g 'IN)
                       (dk-have! (list 'IN a (list 'PTS mlh-S)) (lambda () (subst (list '== (list 'PTS mlh-S) '(VEC v))) (dk-ass!)))
                       (dk-cite! 'class-in-quotient mlh-S a)
                       (subst (list '== pm vq)) (subst (list '== vq qs)) (dk-ass!))
                      (#t
                       (let* ((ld (dk-peel!)) (eps (cadr (mlh-pos-of (append ld (dk-asms))))))
                         (let* ((nb (dk-skolem! (dk-apply! cva eps) #t))
                                (tl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nb) (dk-contains? f eps))) "the conv tail")))
                           (ew nb)
                           (dk-conj-close!
                             (lambda ()
                               (if (not (dk-ass!))
                                   (let* ((ld2 (dk-peel!)) (n (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ld2))))
                                     (rep-at! n)
                                     (dk-apply! tl n)
                                     (mlh-dist! (list sq n) a)
                                     (subst (list '= (list fq n) (mlh-cl (list sq n))))
                                     (subst (list '= (list dm (mlh-cl (list sq n)) lq) (mlh-nv (list sq n) a)))
                                     (dk-ass!))))))))))))))))))
