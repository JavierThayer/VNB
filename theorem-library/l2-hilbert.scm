                   (nb (dk-skolem! (dk-apply! cy eps) #t))
                   (tl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nb) (dk-contains? f eps))) "the Cauchy tail")))
              (ew nb)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (let* ((ld3 (dk-peel!))
                             (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ld3))
                             (m (cadr (car ins))) (q (cadr (cadr ins))))
                        (sk! m) (sk! q)
                        (dk-apply! tl m q)
                        (let ((e (dk-cite! 'l2-dist-lp-norm 'omega 'cA 'mu (list s m) (list s q))))
                          (dk-rewrite-h! (dk-ctx-form (list '<= (mlh-nv2 (list s m) (list s q)) eps)) (mlh-nv2 (list s m) (list s q)) (mlh-lpd (list s m) (list s q))))
                        (dk-ass!)))))))))
      (let* ((lc (dk-cite! 'lp-complete 'omega 'cA 'mu 2 s))
             (f (dk-skolem! lc #t)))
        (let ((i (dk-cite! 'l2-iff-lp2-finite 'omega 'cA 'mu f)))
          (dk-have! (list 'IN f mlh-L2) (lambda () (if (dk-only! i (list 'IN (list 'LP-NORM 'omega 'cA 'mu 2 f) 'RR)) (prop)))))
        (ew f)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (if (dk-head-is? (dk-goal) 'IN)
                    (begin (subst (list '== (list 'VEC mlh-v2) mlh-L2)) (dk-ass!))
                    (let* ((ld4 (dk-peel!)) (eps (cadr (mlh-pos-of (append ld4 (dk-asms))))))
                      (mlh-pos-parts! eps)
                      (mlh-conv-tail! s f eps))))))))))
