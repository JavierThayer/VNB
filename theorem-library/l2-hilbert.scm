        (lambda () (let ((k (dk-di-var!))) (sk! k) (dk-ass!))))
      ;; the seminorm Cauchy condition in L^p form
      (let ((cyl (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'nb (list 'AND '(IN nb NN)
                    (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'q (list 'IMPLIES '(IN q NN)
