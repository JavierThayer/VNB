;;; ===========================================================================
;;; REAL L^2 MODULO NULL FUNCTIONS IS A (REAL) HILBERT SPACE
;;; ===========================================================================
(define mlh-v2 '(L2-SPACE omega cA mu))
(define mlh-sc2 (mlh-tsub 'v mlh-v2 mlh-sc))
(define (mlh-nv2 a b) (mlh-tsub 'v mlh-v2 (mlh-nv a b)))
(define (mlh-lpd a b) (list 'LP-NORM 'omega 'cA 'mu 2 (list 'VNB-LAMBDA 'sx_ 'omega (list '- (list a 'sx_) (list b 'sx_)))))
(define (mlh-sk! s k)                  ; s k in L2, real measurable, finite norm
  (dk-cite! 'fun-apply-type-c s 'NN mlh-L2 k)
  (dk-split-all! (list (dk-cite! 'l2-out 'omega 'cA 'mu (list s k))))
  (let ((i (dk-cite! 'l2-iff-lp2-finite 'omega 'cA 'mu (list s k))))
    (if (not (dk-asm? (list 'IN (list 'LP-NORM 'omega 'cA 'mu 2 (list s k)) 'RR)))
        (dk-have! (list 'IN (list 'LP-NORM 'omega 'cA 'mu 2 (list s k)) 'RR) (lambda () (if (dk-only! i (list 'IN (list s k) mlh-L2)) (prop)))))))
(define (mlh-recip2!)
  (if (not (dk-asm? '(< 0 (recip 2))))
      (begin
        (dk-have! '(IN (recip 2) RR) (lambda () (dk-have! '(NOT (= 2 0)) (lambda () (arith))) (mlh-and! '(IN 2 RR) '(NOT (= 2 0))) (dk-cite! 'rr-recip-closed 2) (if (mlh-open?) (dk-ass!))))
        (dk-have! '(< 0 (recip 2)) (lambda () (dk-have! '(= (recip 2) 1/2) (lambda () (arith))) (subst '(= (recip 2) 1/2)) (dk-ineq!))))))
(define (mlh-lp-rps! h)                ; h real measurable: (IN (LP-NORM .. 2 h) RPS)
  (let ((lp (list 'LP-NORM 'omega 'cA 'mu 2 h)) (ah (list 'ABS-FN 'omega h)))
    (if (not (dk-asm? (list 'IN lp 'RR-POS-STAR)))
        (let ((i (list 'INTEGRAL 'omega 'cA 'mu (list 'PTWISE-EPOW 'omega ah 2))))
          (mlh-recip2!)
          (mlh-split! (dk-cite! 'integral-abs-fn 'omega 'cA 'mu h))
          (dk-cite! 'measurable-fn-epow 'omega 'cA ah 2)
          (dk-cite! 'integral-in 'omega 'cA 'mu (list 'PTWISE-EPOW 'omega ah 2))
          (dk-cite! 'epow-in i '(recip 2))
          (let ((e (dk-cite! 'lp-norm-as-epow 'omega 'cA 'mu 2 h)))
            (dk-have! (list 'IN lp 'RR-POS-STAR) (lambda () (subst e) (dk-ass!))))))))
(define (mlh-conv-tail! s f eps)
  (let* ((bq (list 'VNB-LAMBDA 'k 'NN (mlh-lpd (list s 'k) f)))
         (bk! (lambda (k)                ; (bq k) = LPd real nonneg
                (mlh-sk! s k)
                (let ((t (mlh-lpd (list s k) f)) (d (list 'VNB-LAMBDA 'sx_ 'omega (list '- (list (list s k) 'sx_) (list f 'sx_)))))
                  (mlh-split! (dk-cite! 'lp-norm-sub-le 'omega 'cA 'mu 2 (list s k) f))
                  (dk-cite! 'real-measurable-sub 'omega 'cA (list s k) f)
                  (mlh-lp-rps! d)
                  (dk-cite! 'rr-pos-star-nonneg t)
                  (let ((e (list '= (list bq k) t)))
                    (if (not (dk-asm? e)) (dk-have! e (lambda () (mlh-beta!) (if (mlh-open?) (rfl))))))
                  t))))
    (dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN) (list 'IN (list bq 'cpsk_) 'RR)))
      (lambda () (let ((k (dk-di-var!))) (bk! k) (mlh-beta!) (if (mlh-open?) (dk-ass!)))))
    (dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN) (list '<= 0 (list bq 'cpsk_))))
      (lambda () (let ((k (dk-di-var!))) (bk! k) (mlh-beta!) (if (mlh-open?) (dk-ass!)))))
    (dk-project! (list '= (list 'ELIMSUP bq) 0) 'econverges-to (list 'ECONVERGES-TO bq 0))
    (dk-have! (list '< (list 'ELIMSUP bq) eps) (lambda () (subst (list '= (list 'ELIMSUP bq) 0)) (dk-ineq! (list 'IN eps 'RR) (list '< 0 eps))))
    (let* ((ev (dk-apply! (dk-cite! 'elimsup-eventually-below bq) eps))
           (nb (dk-skolem! ev #t))
           (tl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nb) (dk-contains? h eps))) "the tail")))
      (ew nb)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((ld (dk-peel!)) (n (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) ld)))
                     (t (bk! n)))
                (dk-apply! tl n)
                (dk-rewrite-h! (dk-ctx-form (list '< (list bq n) eps)) (list bq n) t)
                (dk-cite! 'l2-dist-lp-norm 'omega 'cA 'mu (list s n) f)
                (subst (list '= (mlh-nv2 (list s n) f) t))
                (dk-ineq! (list 'IN t 'RR) (list 'IN eps 'RR) (list '< t eps)))))))))
(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cA (list 'FORALL 'mu (list 'IMPLIES '(IS-MEASURE omega cA mu) mlh-sc2))))))
