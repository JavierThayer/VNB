    (let ((eta (dk-di-var!)))
      (subst '(= p_ (ZERO (POLY fk))))
      (fact 'nn-zero-in)
      (dk-have! '(DEG-BOUND fk (ZERO (POLY fk)) 0)
        (lambda ()
          (let ((bi (dk-cite! 'deg-bound 'fk '(ZERO (POLY fk)) 0)))
            (dk-have! (caddr bi) (lambda () (let ((k (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) (dk-peel!)))))) (dk-cite! 'poly-zero-apply 'fk k) (ass))))
            (dk-close-if! (lambda () (dk-only! bi (caddr bi))) prop))))
      (subst (dk-cite! 'poly-eval-constant 'fk '(ZERO (POLY fk)) eta))
      (subst (dk-cite! 'poly-zero-apply 'fk 0))
      (rfl))))
