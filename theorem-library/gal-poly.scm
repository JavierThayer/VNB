;; a point of xs outside the image
(define gp28-all (list 'FORALL 'gz_ (list 'IMPLIES '(IN gz_ xs_) (list 'IN 'gz_ gp28-IM))))
(use-em gp28-all
  (lambda ()
    (dk-have! (list 'AND (list 'IN gp28-IM 'SET) (list 'IN (list 'CARD gp28-IM) 'NN)) (lambda () (dk-conj-close!)))
    (dk-have! (list 'AND '(IN xs_ SET) gp28-all) (lambda () (dk-conj-close!)))
    (dk-cite! 'card-subset-nn gp28-IM 'xs_)
    (dk-close-if! (lambda () (dk-only! '(IN (CARD xs_) NN) '(NOT (IN (CARD xs_) NN)))) prop))
  (lambda ()
    (let* ((ex (push-not-h (list 'NOT gp28-all)))
           (x (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm gp28-IM))) "a point outside the image"))))
