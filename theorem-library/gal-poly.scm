         (h (dk-rewrite-h! mem '(INTERVAL 1 0) 'EMPTY-SET)))
    (dk-cite! 'empty-set-has-no-members z)
    (dk-close-if! (lambda () (dk-only! h (list 'NOT h))) prop)))
(define (gp-int-shrink! i n)
  (let ((sn (list 'succ n)))
    (gp-int-mem! i sn)
    (dk-have! (list 'NOT (list '= sn i))
      (lambda ()
        (di)
        (let ((h (dk-rewrite-h! (list 'NOT (list '= i sn)) sn i)))
          (dk-have! (list '= i i) (lambda () (rfl)))
          (dk-close-if! (lambda () (dk-only! h (list '= i i))) prop))))
    (fact 'nn-le-ne-succ i sn)
    (gp-int-in! i n)))
;; extend al by x at succ n
(define (gp28-ext x) (list 'VNB-LAMBDA 'gw_ (list 'INTERVAL 1 '(succ n_)) (list 'IF (list '= 'gw_ '(succ n_)) x (list gp28-al 'gw_))))
