  (let ((val (if top? x (list gp28-al v))))
    (dk-have! (list '= (list E v) val)
      (lambda ()
        (dk-lam-b!)
        (dk-if-branch! top? (list 'IF (list '= v '(succ n_)) x (list gp28-al v)) #f (lambda () (rfl)))))
    (list '= (list E v) val)))
;; x = al(b) with b in [1, n] contradicts x outside the image (goal FALSITY)
(define (gp28-in-image! x b)
  (let ((ii (dk-cite! 'image-membership-iff gp28-al gp28-S x)))
    (dk-cite! 'membership-implies-sethood x 'xs_)
    (dk-have! (list '= (list gp28-al b) x) (lambda () (subst (list '= x (list gp28-al b))) (rfl)))
    (dk-have! (caddr ii) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew b) (dk-conj-close!)))))))
    (dk-close-if! (lambda () (dk-only! ii (caddr ii) (list 'NOT (list 'IN x gp28-IM)))) prop)))
(define (gp28-extend! x)
  (let* ((E (gp28-ext x))
         (sn '(succ n_))
         (bi (dk-cite! 'injection-membership-iff gp28-T 'xs_ E)))
    (fact 'interval-in-set 1 sn)
    (ew E)
    (dk-have! (caddr bi)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type!
                  (lambda ()
                    (let* ((ls (dk-peel!))
                           (j (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) gp28-T))) ls)))))
                      (dk-case-if! (list 'IF (list '= j sn) x (list gp28-al j))
                        (lambda (tr v)
                          (if tr (ass)
                              (begin
                                (gp-int-shrink! j 'n_)
                                (dk-cite! 'fun-apply-type-c gp28-al gp28-S 'xs_ j)
                                (ass)))))))
                  (lambda () (ass)))
                (let* ((ls (dk-peel!))
                       (ins (map cadr (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) gp28-T))) ls)))
                       (a (car ins)) (b (cadr ins))
                       (h (list '= (list E a) (list E b))))
                  (use-em (list '= a sn)
                    (lambda ()
                      (use-em (list '= b sn)
                        (lambda () (subst (list '= a sn)) (subst (list '= b sn)) (rfl))
                        (lambda ()
                          (gp-int-shrink! b 'n_)
                          (let* ((ea (gp28-at! E x a #t)) (eb (gp28-at! E x b #f))
                                 (h1 (dk-rewrite-h! (dk-rewrite-h! h (list E a) x) (list E b) (list gp28-al b))))
                            (pbc)
                            (gp28-in-image! x b)))))
                    (lambda ()
                      (gp-int-shrink! a 'n_)
                      (use-em (list '= b sn)
                        (lambda ()
                          (let* ((ea (gp28-at! E x a #f)) (eb (gp28-at! E x b #t))
                                 (h1 (dk-rewrite-h! (dk-rewrite-h! h (list E b) x) (list E a) (list gp28-al a))))
                            (pbc)
                            (dk-have! (list '= x (list gp28-al a)) (lambda () (subst h1) (rfl)))
                            (gp28-in-image! x a)))
                        (lambda ()
                          (gp-int-shrink! b 'n_)
                          (let* ((ea (gp28-at! E x a #f)) (eb (gp28-at! E x b #f))
                                 (h1 (dk-rewrite-h! (dk-rewrite-h! h (list E a) (list gp28-al a)) (list E b) (list gp28-al b)))
                                 (inj (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm gp28-al) (not (dk-contains? fm 'IMAGE)) (dk-contains? fm 'IMPLIES) (not (dk-contains? fm 'xs_)))) "injectivity")))
                            (dk-apply! inj a b)
                            (dk-close-if! (lambda () #t) gu-rfl-or-ass!))))))))))))
    (dk-close-if! (lambda () (dk-only! bi (caddr bi))) prop)))
(define gp28-goal '(FORSOME gin_ (IN gin_ (INJECTION (INTERVAL 1 n_) xs_))))
(sp (make-wff (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'FORALL 'xs_ (list 'IMPLIES '(IN xs_ SET) (list 'IMPLIES '(NOT (IN (CARD xs_) NN))
  gp28-goal)))))))
