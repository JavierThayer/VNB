;;; COROLLARY 1.48: over an infinite field a polynomial is determined by its values
(sp (make-wff '(FORALL fk (IMPLIES (IS-FIELD-RING fk) (IMPLIES (NOT (IN (CARD (CARR fk)) NN))
  (FORALL p_ (IMPLIES (IN p_ (CARR (POLY fk))) (FORALL q_ (IMPLIES (IN q_ (CARR (POLY fk)))
    (IFF (= p_ q_) (FORALL eta_ (IMPLIES (IN eta_ (CARR fk)) (= (POLY-EVAL fk p_ eta_) (POLY-EVAL fk q_ eta_))))))))))))))
(dk-peel!)
(gp-fk!)
(dk-cite! 'ring-carr-in-set 'fk)
(dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
  (lambda ()
    (let ((eta (dk-di-var!)))
      (subst '(= p_ q_))
      (dk-cite! 'poly-eval-type 'fk 'q_ eta)
      (rfl)))
  (lambda ()
    (let* ((r (gp-pa 'p_ (gp-pn 'q_)))
           (Z '(ZERO (POLY fk)))
           (all (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'POLY-EVAL))) "equal values")))
      (gp-ptype! r)
      (gp-fs! 'fk r)
      (gp-split! (dk-cite! 'deg-well-defined 'fk r))
      (fact 'nn-succ-closed (list 'DEG 'fk r))
      (let* ((n1 (list 'succ (list 'DEG 'fk r)))
             (al (dk-skolem! (dk-cite! 'infinite-set-finite-injections n1 '(CARR fk)))))
        (dk-have! (list 'FORALL 'eta_ (list 'IMPLIES '(IN eta_ (CARR fk)) (list '= (list 'POLY-EVAL 'fk r 'eta_) '(ZERO fk))))
          (lambda ()
            (let ((eta (dk-di-var!)))
              (dk-cite! 'ring-neg-in-carr '(POLY fk) 'q_)
              (subst (dk-cite! 'poly-eval-add 'fk 'p_ (gp-pn 'q_) eta))
              (subst (dk-cite! 'poly-eval-neg 'fk 'q_ eta))
              (subst (dk-apply! all eta))
              (dk-cite! 'poly-eval-type 'fk 'q_ eta)
              (crs))))
        (let ((vz (dk-cite! 'poly-vanishing-iff-zero 'fk r al)))
          (dk-have! (caddr vz) (lambda () (dk-close-if! (lambda () (dk-only! vz (cadr vz))) prop)))
          (let ((zi (dk-cite! 'poly-zero-iff 'fk r)))
            (dk-have! (list '= r Z) (lambda () (dk-close-if! (lambda () (dk-only! zi (caddr vz))) prop)))
            (dk-have! (list '= 'p_ (gp-pa r 'q_)) (lambda () (crs)))
            (let ((h (dk-rewrite-h! (list '= 'p_ (gp-pa r 'q_)) r Z)))
              (dk-have! (list '= (gp-pa Z 'q_) 'q_) (lambda () (crs)))
              (dk-rewrite-h! h (gp-pa Z 'q_) 'q_)
              (ass))))))))
