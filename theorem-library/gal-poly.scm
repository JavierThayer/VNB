;;; unchanged: the typing of FIELD-AS-INTEGRAL-DOMAIN is now proven from it there.

(define gp-FG '((MUL (POLY a_)) f_ g_))
(define gp-Z '(ZERO (POLY a_)))
(sp (make-wff (list 'FORALL 'a_ (list 'IMPLIES '(IS-INTEGRAL-DOMAIN a_)
  (list 'FORALL 'f_ (list 'IMPLIES '(IN f_ (CARR (POLY a_))) (list 'IMPLIES (list 'NOT (list '= 'f_ gp-Z))
  (list 'FORALL 'g_ (list 'IMPLIES '(IN g_ (CARR (POLY a_))) (list 'IMPLIES (list 'NOT (list '= 'g_ gp-Z))
    (list 'AND (list 'NOT (list '= gp-FG gp-Z)) (list '= (list 'DEG 'a_ gp-FG) '(+ (DEG a_ f_) (DEG a_ g_))))))))))))))
(dk-peel!)
(dk-cite! 'integral-domain-is-commutative-ring 'a_)
(dk-cite! 'commutative-ring-is-ring 'a_)
(dk-cite! 'ring-zero-in 'a_)
(gp-monoid!)
(gp-nm-carr!)
(gp-fs! 'a_ 'f_) (gp-fs! 'a_ 'g_)
(define gp8-n '(DEG a_ f_))
(define gp8-d '(DEG a_ g_))
(define gp8-H '(MONALG-MUL a_ NN-ADD-MONOID f_ g_))
(define gp8-X (list '+ gp8-n gp8-d))
(dk-split-all! (list (dk-cite! 'deg-well-defined 'a_ 'f_)))
(dk-split-all! (list (dk-cite! 'deg-well-defined 'a_ 'g_)))
(define (gp8-lead! f n)
  (let* ((l (dk-cite! 'leadcoef-nonzero 'a_ f))
         (u (dk-cite! 'leadcoef-unfold 'a_ f)))
    (dk-rewrite-h! l (list 'LEADCOEF 'a_ f) (list f n))))
(gp8-lead! 'f_ gp8-n)
(gp8-lead! 'g_ gp8-d)
(subst (dk-cite! 'poly-mul-unfold 'a_ 'f_ 'g_))
(dk-cite! 'poly-mul-deg-bound 'a_ 'f_ 'g_ gp8-n gp8-d)
(define gp8-top (dk-cite! 'poly-mul-top-coef 'a_ 'f_ 'g_ gp8-n gp8-d))
(gp-val! 'a_ 'f_ gp8-n) (gp-val! 'a_ 'g_ gp8-d)
(define gp8-fn (list 'f_ gp8-n))
(define gp8-gd (list 'g_ gp8-d))
(define gp8-Hx (list gp8-H gp8-X))
(define gp8-idd (gp-iff! 'is-integral-domain-def '(IS-INTEGRAL-DOMAIN a_) 'a_))
(dk-have! (list 'NOT (list '= gp8-Hx '(ZERO a_)))
  (lambda ()
    (di)
    (let* ((h (dk-rewrite-h! gp8-top gp8-Hx '(ZERO a_)))
           (m (list '(MUL a_) gp8-fn gp8-gd))
           (x (dk-cite! 'ring-carrier-closed-mul 'a_ gp8-fn gp8-gd))
           (hs (dk-have! (list '= m '(ZERO a_)) (lambda () (subst h) (rfl))))
           (law (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'OR))) "no zero divisors"))
           (o (dk-apply! law gp8-fn gp8-gd)))
      (dk-close-if! (lambda () (dk-only! o (list 'NOT (list '= gp8-fn '(ZERO a_))) (list 'NOT (list '= gp8-gd '(ZERO a_))))) prop))))
(dk-cite! 'monalg-mul-fun 'a_ gp-NM 'f_ 'g_)
(dk-have! (list 'IN gp8-H '(CARR (POLY a_))) (lambda () (mac 'poly-carrier) (ass)))
(dk-have! '(AND (IN (DEG a_ f_) NN) (IN (DEG a_ g_) NN)) (lambda () (dk-conj-close!)))
(fact 'nn-add-closed gp8-n gp8-d)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'NOT)
        (begin
          (di)
          (let ((h (dk-rewrite-h! (list 'NOT (list '= gp8-Hx '(ZERO a_))) gp8-H gp-Z)))
            (dk-cite! 'poly-zero-apply 'a_ gp8-X)
            (dk-close-if! (lambda () (dk-only! h (list '= (list gp-Z gp8-X) '(ZERO a_)))) prop)))
        (begin
          (dk-have! (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ NN) (list 'IMPLIES (list 'DEG-BOUND 'a_ gp8-H 'j_) (list '<= gp8-X 'j_))))
            (lambda ()
              (let* ((ls (dk-peel!))
                     (j (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) ls)))))
                (pbc)
                (fact 'nn-in-rr j) (fact 'nn-in-rr gp8-X)
                (dk-cite! 'rr-not-le-lt gp8-X j)
                (dk-cite! 'deg-bound-apply 'a_ gp8-H j gp8-X)
                (dk-close-if! (lambda () (dk-only! (list '= gp8-Hx '(ZERO a_)) (list 'NOT (list '= gp8-Hx '(ZERO a_))))) prop))))
          (dk-cite! 'deg-is 'a_ gp8-H gp8-X)
          (dk-close-if! (lambda () #t) gu-rfl-or-ass!)))))
