;; the ring facts of F and F[x] for a field ring fk
(define (gp-fk!)
  (if (not (dk-asm? '(IS-COMMUTATIVE-RING (POLY fk))))
      (begin
        (gp-iff! 'is-field-ring-def '(IS-FIELD-RING fk) 'fk)
        (dk-cite! 'commutative-ring-is-ring 'fk)
        (dk-cite! 'ring-zero-in 'fk) (dk-cite! 'ring-one-in 'fk)
        (gp-monoid!) (gp-nm-carr!)
        (dk-have! '(IS-COMMUTATIVE-RING (POLY fk)) (lambda () (dk-cite! 'monalg-comm 'fk gp-NM) (mac 'POLY) (ass)))
        (dk-cite! 'commutative-ring-is-ring '(POLY fk))
        (dk-cite! 'ring-zero-in '(POLY fk)))))
(define (gp-pm a b) (list '(MUL (POLY fk)) a b))
(define (gp-pa a b) (list '(ADD (POLY fk)) a b))
(define (gp-pn a) (list '(NEG (POLY fk)) a))
(define gp-PZ '(ZERO (POLY fk)))
;; typing in CARR(POLY fk) of a ring expression over it
(define (gp-ptype! t)
  (let ((want (list 'IN t '(CARR (POLY fk)))))
    (if (not (dk-asm? want))
        (cond ((and (pair? t) (equal? (car t) '(MUL (POLY fk)))) (gp-ptype! (cadr t)) (gp-ptype! (caddr t)) (dk-cite! 'ring-carrier-closed-mul '(POLY fk) (cadr t) (caddr t)))
              ((and (pair? t) (equal? (car t) '(ADD (POLY fk)))) (gp-ptype! (cadr t)) (gp-ptype! (caddr t)) (dk-cite! 'ring-add-closed '(POLY fk) (cadr t) (caddr t)))
              ((and (pair? t) (equal? (car t) '(NEG (POLY fk)))) (gp-ptype! (cadr t)) (dk-cite! 'ring-neg-in-carr '(POLY fk) (cadr t)))
              (#t (error "gp-ptype!: cannot type" t))))))

(define gp-div-concl
  (list 'FORSOME 'ps_ (list 'AND '(IN ps_ (CARR (POLY fk)))
    (list 'OR (list '= 'pa_ (gp-pm 'pb_ 'ps_))
              (list '< (list 'DEG 'fk (gp-pa 'pa_ (gp-pn (gp-pm 'pb_ 'ps_)))) '(DEG fk pb_))))))
(sp (make-wff (list 'FORALL 'nb_ (list 'IMPLIES '(IN nb_ NN) (list 'FORALL 'fk (list 'IMPLIES '(IS-FIELD-RING fk)
  (list 'FORALL 'pa_ (list 'IMPLIES '(IN pa_ (CARR (POLY fk))) (list 'IMPLIES '(< (DEG fk pa_) nb_)
  (list 'FORALL 'pb_ (list 'IMPLIES '(IN pb_ (CARR (POLY fk))) (list 'IMPLIES (list 'NOT (list '= 'pb_ gp-PZ))
    gp-div-concl))))))))))))
(dk-ni-fixed! '(fk))   ; W1G-B: fk fixed; pa_ varies, pb_ stays inside
(dk-focus! (car (filter (lambda (l) (not (gu-step-goal? (dk-goal-of l)))) (dk-open-leaves))))
(dk-peel!)
(gp-fk!)
(gp-fs! 'fk 'pa_)
(dk-split-all! (list (dk-cite! 'deg-well-defined 'fk 'pa_)))
(fact 'nn-in-rr '(DEG fk pa_))
(fact 'nn-zero-le '(DEG fk pa_))
(pbc)
(dk-absurd! '(< (DEG fk pa_) 0) '(<= 0 (DEG fk pa_)) '(IN (DEG fk pa_) RR))
(define gp12-ls (dk-peel!))
(define gp12-t 'nb_)
(define gp12-ih (car (filter (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'ps_))) gp12-ls)))
(gp-fk!)
(gp-fs! 'fk 'pa_) (gp-fs! 'fk 'pb_)
(define gp12-n '(DEG fk pa_))
(define gp12-d '(DEG fk pb_))
(dk-split-all! (list (dk-cite! 'deg-well-defined 'fk 'pa_)))
(dk-split-all! (list (dk-cite! 'deg-well-defined 'fk 'pb_)))
(fact 'nn-in-rr gp12-n) (fact 'nn-in-rr gp12-d)
;; the main case of the division step: deg pb <= deg pa
(define (gp12-main!)
  (let* ((n gp12-n) (d gp12-d)
         (e (dk-skolem! (dk-cite! 'nn-le-gap n d))))
    (dk-split-all!)
    ;; the leading coefficient of pb and its inverse
    (let* ((l (dk-cite! 'leadcoef-nonzero 'fk 'pb_))
           (u (dk-cite! 'leadcoef-unfold 'fk 'pb_))
           (bd (list 'pb_ d))
           (nz (dk-rewrite-h! l '(LEADCOEF fk pb_) bd)))
      (gp-val! 'fk 'pb_ d) (gp-val! 'fk 'pa_ n)
      (let* ((inv (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'FORSOME) (dk-contains? fm '(ONE fk)))) "inverses"))
             (w (dk-skolem! (dk-apply! inv bd))))
        (dk-split-all!)
        (let* ((an (list 'pa_ n))
               (c (list '(MUL fk) an w))
               (m (list 'MONOMIAL 'fk c e))
               (hm (list 'MONALG-MUL 'fk gp-NM m 'pb_))
               (MP (gp-pm m 'pb_))
               (R (gp-pa 'pa_ (gp-pn MP)))
               (ed (list '+ e d)))
          (dk-cite! 'ring-carrier-closed-mul 'fk an w)
          (dk-cite! 'monomial-in-poly 'fk c e)
          (dk-cite! 'monomial-deg-bound 'fk c e)
          (gp-ptype! R)
          (gp-fs! 'fk m)
          (dk-have! (list 'AND (list 'IN e 'NN) (list 'IN d 'NN)) (lambda () (dk-conj-close!)))
          (fact 'nn-add-closed e d)
          (fact 'nn-add-comm e d)
          (dk-have! (list '= ed n) (lambda () (subst (list '= ed (list '+ d e))) (subst (list '= n (list '+ d e))) (rfl)))
          (dk-cite! 'poly-mul-deg-bound 'fk m 'pb_ e d)
          (define top (dk-cite! 'poly-mul-top-coef 'fk m 'pb_ e d))
          (define mu (dk-cite! 'poly-mul-unfold 'fk m 'pb_))
          (gp-ptype! (gp-pn MP))
          ;; R(k) = pa(k) - MP(k)
          (define (rk! k)
            (let* ((e1 (dk-cite! 'poly-add-at 'fk 'pa_ (gp-pn MP) k))
                   (e2 (dk-cite! 'poly-neg-at 'fk MP k)))
              (list e1 e2)))
          (dk-have! (list 'DEG-BOUND 'fk R n)
            (lambda ()
              (let ((bi (dk-cite! 'deg-bound 'fk R n)))
                (dk-have! (caddr bi)
                  (lambda ()
                    (let* ((ls (dk-peel!))
                           (k (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) ls))))
                           (ee (rk! k)))
                      (dk-cite! 'deg-bound-apply 'fk 'pa_ n k)
                      (dk-have! (list '< ed k) (lambda () (subst (list '= ed n)) (ass)))
                      (dk-cite! 'deg-bound-apply 'fk hm ed k)
                      (subst (car ee)) (subst (cadr ee)) (subst mu)
                      (subst (list '= (list 'pa_ k) '(ZERO fk)))
                      (subst (list '= (list hm k) '(ZERO fk)))
                      (crs))))
                (dk-close-if! (lambda () (dk-only! bi (caddr bi))) prop))))
          (dk-have! (list '= (list R n) '(ZERO fk))
            (lambda ()
              (let* ((ee (rk! n))
                     (t1 (dk-rewrite-h! top ed n))
                     (ma (dk-cite! 'monomial-at 'fk c e))
                     (i1 (list '= (list '(MUL fk) c bd) (list '(MUL fk) an (list '(MUL fk) bd w)))))
                (dk-have! i1 (lambda () (crs)))
                (let* ((i2 (dk-rewrite-h! i1 (list '(MUL fk) bd w) '(ONE fk)))
                       (ri (dk-cite! 'ring-mul-right-id 'fk an))
                       (i3 (dk-rewrite-h! i2 (list '(MUL fk) an '(ONE fk)) an)))
                  (subst (car ee)) (subst (cadr ee)) (subst mu)
                  (subst t1) (subst ma) (subst i3)
                  (crs)))))
          (define dd (dk-cite! 'deg-drop 'fk R n))
          (define pR (list '= 'pa_ (gp-pa R MP)))
          (dk-have! pR (lambda () (crs)))
          (use-em (list '= R gp-PZ)
            (lambda ()
              ;; R = 0: pa = pb m
              (let ((h (dk-rewrite-h! pR R gp-PZ)))
                (ew m)
                (dk-conj-close!
                  (lambda ()
                    (cond ((dk-asm? (dk-goal)) (ass))
                          ((dk-head-is? (dk-goal) 'OR)
                           (dk-have! (list '= (caddr h) (gp-pm 'pb_ m)) (lambda () (crs)))
                           (dk-rewrite-h! h (caddr h) (gp-pm 'pb_ m))
                           (dk-close-if! (lambda () (dk-only! (list '= 'pa_ (gp-pm 'pb_ m)))) prop))
                          (#t (error "gp12: unexpected goal")))))))
            (lambda ()
              ;; deg R < n <= t: the induction hypothesis
              (dk-have! (list '< (list 'DEG 'fk R) n) (lambda () (dk-close-if! (lambda () (dk-only! dd (list 'NOT (list '= R gp-PZ)))) prop)))
              (dk-split-all! (list (dk-cite! 'deg-well-defined 'fk R)))
              (fact 'nn-succ-closed gp12-t)
              (fact 'nn-lt-succ-le (list 'DEG 'fk R) n)
              (fact 'nn-lt-succ-le n (list 'succ gp12-t))
              (dk-have! (list '< (list 'DEG 'fk R) gp12-t) (lambda () (dk-nn! (list '<= (list 'succ (list 'DEG 'fk R)) n) (list '<= (list 'succ n) (list 'succ gp12-t)))))
              (let* ((ps1 (dk-skolem! (dk-apply! gp12-ih R 'pb_))))
                (dk-split-all!)
                (let ((S (gp-pa ps1 m)))
                  (gp-ptype! S)
                  (ew S)
                  (dk-conj-close!
                    (lambda ()
                      (cond ((dk-asm? (dk-goal)) (ass))
                            ((dk-head-is? (dk-goal) 'OR)
                             (use-em (list '= R (gp-pm 'pb_ ps1))
                               (lambda ()
                                 (let ((h (dk-rewrite-h! pR R (gp-pm 'pb_ ps1))))
                                   (dk-have! (list '= (caddr h) (gp-pm 'pb_ S)) (lambda () (crs)))
                                   (dk-rewrite-h! h (caddr h) (gp-pm 'pb_ S))
                                   (dk-close-if! (lambda () (dk-only! (list '= 'pa_ (gp-pm 'pb_ S)))) prop)))
                               (lambda ()
                                 (let* ((lt (list '< (list 'DEG 'fk (gp-pa R (gp-pn (gp-pm 'pb_ ps1)))) d))
                                        (x (dk-have! lt (lambda () (dk-close-if! (lambda () (dk-only! (list 'OR (list '= R (gp-pm 'pb_ ps1)) lt) (list 'NOT (list '= R (gp-pm 'pb_ ps1))))) prop))))
                                        (r2 (gp-pa 'pa_ (gp-pn (gp-pm 'pb_ S))))
                                        (eq (list '= r2 (caddr (cadr lt)))))
                                   (gp-ptype! r2)
                                   (dk-have! eq (lambda () (crs)))
                                   (dk-have! (list '< (list 'DEG 'fk r2) d) (lambda () (subst eq) (ass)))
                                   (dk-close-if! (lambda () (dk-only! (list '< (list 'DEG 'fk r2) d))) prop)))))
