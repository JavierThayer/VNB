;;; an infinite set receives an injection of every {1, ..., n}
(define (gp-vacuous!)
  ;; goal (FORALL z (IMPLIES (IN z (INTERVAL 1 0)) ...)), possibly with further antecedents
  (let* ((ls (dk-peel!))
         (mem (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) '(INTERVAL 1 0)))) ls)))
         (z (cadr mem))
