;;; ---- POLY over an integral domain is an integral domain ----
(sp (make-wff '(FORALL a_ (IMPLIES (IS-INTEGRAL-DOMAIN a_) (IS-INTEGRAL-DOMAIN (POLY a_))))))
(dk-peel!)
(dk-cite! 'integral-domain-is-commutative-ring 'a_)
(dk-cite! 'commutative-ring-is-ring 'a_)
(dk-cite! 'ring-zero-in 'a_) (dk-cite! 'ring-one-in 'a_)
(gp-monoid!)
(dk-cite! 'integral-domain-nontrivial 'a_)
(define gp9-ii (dk-cite! 'is-integral-domain-def '(POLY a_)))
(dk-have! (caddr gp9-ii)
  (lambda ()
    (dk-conj-close!
      (lambda ()
        (cond ((dk-asm? (dk-goal)) (ass))
              ((dk-head-is? (dk-goal) 'IS-COMMUTATIVE-RING)
               (dk-cite! 'monalg-comm 'a_ gp-NM)
               (mac 'POLY) (ass))
              ((dk-head-is? (dk-goal) 'NOT)
               (di)
               (fact 'nn-zero-in)
               (gp-km! 0)
               (dk-have! '(= ((ONE (POLY a_)) 0) (ONE a_))
                 (lambda ()
                   (mac 'POLY) (mac 'monalg-one-slot) (mac 'monalg-one-apply)
                   (dk-if-branch! #t '(IF (= 0 (IDEN NN-ADD-MONOID)) (ONE a_) (ZERO a_)) (lambda () (slot 'IDEN) (rfl)) (lambda () (rfl)))))
               (let* ((h (dk-rewrite-h! '(= ((ONE (POLY a_)) 0) (ONE a_)) '(ONE (POLY a_)) '(ZERO (POLY a_))))
                      (z (dk-cite! 'poly-zero-apply 'a_ 0))
                      (h2 (dk-rewrite-h! h '((ZERO (POLY a_)) 0) '(ZERO a_))))
                 (dk-have! '(= (ONE a_) (ZERO a_)) (lambda () (subst h2) (rfl)))
                 (dk-close-if! (lambda () (dk-only! '(= (ONE a_) (ZERO a_)) '(NOT (= (ONE a_) (ZERO a_))))) prop)))
              (#t
               (let* ((ls (dk-peel!))
                      (eq (car (filter (dk-head? '=) ls)))
                      (f (cadr (cadr eq))) (g (caddr (cadr eq))))
                 (use-em (list '= f gp-Z)
                   (lambda () (dk-close-if! (lambda () (dk-only! (list '= f gp-Z))) prop))
                   (lambda ()
                     (use-em (list '= g gp-Z)
                       (lambda () (dk-close-if! (lambda () (dk-only! (list '= g gp-Z))) prop))
                       (lambda ()
                         (let ((pm (dk-cite! 'poly-mul-deg 'a_ f g)))
                           (dk-close-if! (lambda () (dk-only! pm eq)) prop)))))))))))))
(dk-close-if! (lambda () (dk-only! gp9-ii (caddr gp9-ii))) prop)
(qed 'poly-is-integral-domain)
(topic! 'poly-is-integral-domain 'algebra)

;; n <= k and k /= n in context (n, k in NN): land n < k
(define (gp-lt-from-ne! n k)
  (fact 'nn-le-ne-succ n k)
  (dk-have! (list '< n k) (lambda () (dk-nn!))))

