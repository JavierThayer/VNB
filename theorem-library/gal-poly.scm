;;; COROLLARY 1.46: if F has more than deg p elements (an injection of {1, ..., deg p + 1} into F),
;;; then p vanishes everywhere on F iff all its coefficients vanish
(define gp27-n1 '(succ (DEG fk p_)))
(define gp27-S (list 'INTERVAL 1 gp27-n1))
(sp (make-wff (list 'FORALL 'fk (list 'IMPLIES '(IS-FIELD-RING fk)
  (list 'FORALL 'p_ (list 'IMPLIES '(IN p_ (CARR (POLY fk)))
    (list 'FORALL 'al_ (list 'IMPLIES (list 'IN 'al_ (list 'INJECTION gp27-S '(CARR fk)))
      (list 'IFF '(FORALL eta_ (IMPLIES (IN eta_ (CARR fk)) (= (POLY-EVAL fk p_ eta_) (ZERO fk))))
                 '(FORALL k_ (IMPLIES (IN k_ NN) (= (p_ k_) (ZERO fk)))))))))))))
(dk-peel!)
(gp-fk!)
(gp-fs! 'fk 'p_)
(gp-split! (dk-cite! 'deg-well-defined 'fk 'p_))
(fact 'nn-succ-closed '(DEG fk p_))
(gp-iff! 'injection-membership-iff (list 'IN 'al_ (list 'INJECTION gp27-S '(CARR fk))) gp27-S '(CARR fk) 'al_)
(define gp27-zi (dk-cite! 'poly-zero-iff 'fk 'p_))
(dk-iff! (lambda (g) (dk-contains? g 'k_))
  (lambda ()
    ;; vanishing everywhere: otherwise p /= 0 has deg p + 1 distinct roots
    (pbc)
    (dk-have! '(NOT (= p_ (ZERO (POLY fk)))) (lambda () (dk-close-if! (lambda () (dk-only! gp27-zi (list 'NOT (caddr gp27-zi)))) prop)))
    (let ((ev (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'POLY-EVAL))) "p vanishes")))
      (dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ gp27-S)
                  (list 'AND '(IN (al_ i_) (CARR fk)) '(= (POLY-EVAL fk p_ (al_ i_)) (ZERO fk)))))
        (lambda ()
          (let ((i (dk-di-var!)))
            (dk-cite! 'fun-apply-type-c 'al_ gp27-S '(CARR fk) i)
            (dk-apply! ev (list 'al_ i))
            (dk-conj-close!))))
      (dk-cite! 'poly-roots-at-most-degree gp27-n1 'fk 'p_ 'al_)
      (dk-have! '(< (DEG fk p_) (DEG fk p_)) (lambda () (dk-nn! (list '<= gp27-n1 '(DEG fk p_)))))
      (fact 'nn-in-rr '(DEG fk p_))
      (dk-cite! 'rr-lt-irrefl '(DEG fk p_))
      (dk-close-if! (lambda () (dk-only! '(< (DEG fk p_) (DEG fk p_)) '(NOT (< (DEG fk p_) (DEG fk p_))))) prop)))
