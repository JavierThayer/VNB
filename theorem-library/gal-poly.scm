  (list 'FORALL 'p_ (list 'IMPLIES '(IN p_ (CARR (POLY fk))) (list 'IMPLIES '(NOT (= p_ (ZERO (POLY fk))))
    (list 'FORALL 'al_ (list 'IMPLIES (gp-roots 'm_ 'p_) (list 'IMPLIES (gp-inj 'm_)
