;;; gal-poly.scm -- F[x]: degree of a product, division with remainder, F[x] a Euclidean
;;; domain, a PID and a UFD, evaluation and roots (galois-theory notes, Proposition 1.9,
;;; Corollary 1.10, Proposition 1.43, Corollaries 1.45, 1.46, 1.48) (GALOIS B2, 2026-10-26).
;;; Destination: theorem-library/gal-poly.scm, library algebra.  Load window: after
;;; poly-is-ring-proof (load.scm 2219), la-det-adjoint (2187, ladet-field-one-ne) and the
;;; unwired galois files catools-gal-vocab, catools-gal-b1, gal-ufd-vocab, gal-ufd, gal-poly-vocab.
;;; Uses the formal ring POLY(A) = MONALG(A, NN-ADD-MONOID) (polynomial.scm), DEG / MONOMIAL
;;; (poly-degree.scm) and their laws; a field is IS-FIELD-RING (the six-slot shape POLY takes).
;;; Statements against the notes:
;;;   1.9  "deg r < deg q" reads "r = 0 or deg r < deg q": the tree's DEG(0) is 0, not -infinity.
;;;   1.10 F[x] is a Euclidean domain (the degree is a degree function), a PID and a UFD.
;;;   1.45 "at most n roots": distinct roots al(1), ..., al(m) of p /= 0 give m <= deg p.
;;;   1.46 "deg p < card F" reads "an injection of {1, ..., deg p + 1} into F" (true for every
;;;        cardinality); infinite-set-finite-injections supplies one for an infinite field.
;;;   1.48 "infinite field": CARD(CARR F) is not in NN.
;;; Helper prefix gp-.
;;; ======================================================================
(define gp-NM 'NN-ADD-MONOID)
(define (gp-poly a) (list 'POLY a))
(define (gp-cp a) (list 'CARR (list 'POLY a)))
;; the monoid facts every MONALG read-off is guarded on
(define (gp-monoid!)
  (if (not (dk-asm? '(IS-MONOID NN-ADD-MONOID)))
      (begin (fact 'nn-add-monoid-is-comm-monoid) (fact 'comm-monoid-is-monoid 'NN-ADD-MONOID))))
;; f in CARR(POLY a) in context: land f in FINSUPP(a, NN-ADD-MONOID)
(define (gp-fs! a f)
  (let ((want (list 'IN f (list 'FINSUPP a gp-NM))))
    (if (not (dk-asm? want))
        (dk-have! want (lambda () (mac-h 'poly-carrier (list 'IN f (gp-cp a))) (ass))))))
;; CARR(NN-ADD-MONOID) = NN
(define (gp-nm-carr!)
  (if (not (dk-asm? '(= (CARR NN-ADD-MONOID) NN)))
      (dk-have! '(= (CARR NN-ADD-MONOID) NN) (lambda () (slot 'CARR) (rfl)))))
;; k in NN in context: land k in CARR(NN-ADD-MONOID)
(define (gp-km! k)
  (let ((want (list 'IN k '(CARR NN-ADD-MONOID))))
    (if (not (dk-asm? want))
        (dk-have! want (lambda () (slot 'CARR) (ass))))))

;;; ---- the ring operations of POLY(a), read pointwise ----
(sp (make-wff '(FORALL a_ (IMPLIES (IS-RING a_) (FORALL f_ (IMPLIES (IN f_ (CARR (POLY a_)))
  (FORALL g_ (IMPLIES (IN g_ (CARR (POLY a_)))
    (FORALL k_ (IMPLIES (IN k_ NN)
      (= (((ADD (POLY a_)) f_ g_) k_) ((ADD a_) (f_ k_) (g_ k_)))))))))))))
(dk-peel!)
(gp-monoid!)
(gp-fs! 'a_ 'f_) (gp-fs! 'a_ 'g_)
(gp-km! 'k_)
;; IN-IFF: cite the defining iff THM at ARGS, given its left side in context; land the conjuncts
(define (gp-iff! thm lhs . args)
  (let ((ii (apply dk-cite! thm args)))
    (if (not (every dk-asm? (gp-conjs (caddr ii))))
        (begin
          (dk-have! (caddr ii) (lambda () (dk-close-if! (lambda () (dk-only! ii lhs)) prop)))
          (dk-split-all! (list (caddr ii)))))
    (caddr ii)))
;; split a conjunction unless all its conjuncts are already in context
(define (gp-split! f)
  (if (not (every dk-asm? (gp-conjs f))) (dk-split-all! (list f)))
  f)
(define (gp-conjs f) (if (and (pair? f) (eq? (car f) 'AND)) (append (gp-conjs (cadr f)) (gp-conjs (caddr f))) (list f)))
;; f in FINSUPP(a, NN-ADD-MONOID), k in CARR(NN-ADD-MONOID): land f(k) in CARR(a)
(define (gp-val! a f k)
  (let ((want (list 'IN (list f k) (list 'CARR a))))
    (if (not (dk-asm? want))
        (begin
          (gp-km! k)
          (gp-iff! 'finsupp-membership (list 'IN f (list 'FINSUPP a gp-NM)) a gp-NM f)
          (dk-cite! 'fun-apply-type-c f '(CARR NN-ADD-MONOID) (list 'CARR a) k)))))
(mac 'POLY)
(mac 'monalg-add-op)
(dk-lam-b!)
(mac 'monalg-add-apply)
(gp-val! 'a_ 'f_ 'k_) (gp-val! 'a_ 'g_ 'k_)
(dk-cite! 'ring-add-closed 'a_ '(f_ k_) '(g_ k_))
(rfl)
(qed 'poly-add-at)
(topic! 'poly-add-at 'algebra)

(sp (make-wff '(FORALL a_ (IMPLIES (IS-RING a_) (FORALL f_ (IMPLIES (IN f_ (CARR (POLY a_)))
    (FORALL k_ (IMPLIES (IN k_ NN)
      (= (((NEG (POLY a_)) f_) k_) ((NEG a_) (f_ k_)))))))))))
(dk-peel!)
(gp-monoid!)
(gp-fs! 'a_ 'f_)
(gp-km! 'k_)
(mac 'POLY)
(mac 'monalg-neg-op)
(dk-lam-b!)
(mac 'monalg-neg-apply)
(gp-val! 'a_ 'f_ 'k_)
(dk-cite! 'ring-neg-in-carr 'a_ '(f_ k_))
(rfl)
(qed 'poly-neg-at)
(topic! 'poly-neg-at 'algebra)

(sp (make-wff '(FORALL a_ (IMPLIES (IS-RING a_) (FORALL f_ (IMPLIES (IN f_ (CARR (POLY a_)))
  (FORALL g_ (IMPLIES (IN g_ (CARR (POLY a_)))
      (= ((MUL (POLY a_)) f_ g_) (MONALG-MUL a_ NN-ADD-MONOID f_ g_))))))))))
(dk-peel!)
(gp-monoid!)
(gp-fs! 'a_ 'f_) (gp-fs! 'a_ 'g_)
(dk-cite! 'monalg-mul-fun 'a_ gp-NM 'f_ 'g_)
(mac 'POLY)
(mac 'monalg-mul-op)
(dk-lam-b!)
(rfl)
(qed 'poly-mul-unfold)
(topic! 'poly-mul-unfold 'algebra)

;;; ---- the product vanishes past the sum of two degree bounds ----
(define gp-mul '(MONALG-MUL a_ NN-ADD-MONOID f_ g_))
;; x in SUPP(a, NN-ADD-MONOID, f): land x in NN and f(x) /= 0
(define (gp-supp-nn! a f x)
  (gp-iff! 'supp-membership (list 'IN x (list 'SUPP a gp-NM f)) a gp-NM f x)
  (gp-nm-carr!)
  (if (not (dk-asm? (list 'IN x 'NN)))
      (dk-have! (list 'IN x 'NN) (lambda () (dk-rewrite-h! (list 'IN x '(CARR NN-ADD-MONOID)) '(CARR NN-ADD-MONOID) 'NN) (ass)))))
;; x in SUPP(a, NN-ADD-MONOID, f), DEG-BOUND(a, f, n): land x in NN and x <= n
(define (gp-supp-le! a f n x)
  (gp-supp-nn! a f x)
  (dk-have! (list '<= x n)
    (lambda ()
      (pbc)
      (fact 'nn-in-rr x) (fact 'nn-in-rr n)
      (dk-cite! 'rr-not-le-lt x n)
      (dk-cite! 'deg-bound-apply a f n x)
      (dk-close-if! (lambda () (dk-only! (list '= (list f x) (list 'ZERO a)) (list 'NOT (list '= (list f x) (list 'ZERO a))))) prop))))
;; k in SUPP(a_, NN-ADD-MONOID, f_ * g_), DEG-BOUND(a_, f_, n), DEG-BOUND(a_, g_, d): land k = i + j
;; with i, j in the supports, i <= n, j <= d, and k <= n + d; return (i j)
(define (gp-sum-in-image! k n d . raw)
  (let* ((im (dk-cite! 'monalg-mul-supp-in-image 'a_ gp-NM 'f_ 'g_ k))
         (lam (cadr (caddr im))) (cart (caddr (caddr im)))
         (ex (gp-iff! 'image-membership-iff im lam cart k))
         (x (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm cart))) "the preimage"))))
    (dk-split-all!)
    (gp-split! (dk-cite! 'cartesian-nth x (cadr cart) (caddr cart)))
    (let* ((i (list 'NTH 1 x)) (j (list 'NTH 2 x)))
      (if (pair? raw)
          (begin (gp-supp-nn! 'a_ 'f_ i) (gp-supp-nn! 'a_ 'g_ j))
          (begin (gp-supp-le! 'a_ 'f_ n i) (gp-supp-le! 'a_ 'g_ d j)))
      (let* ((h (dk-pick (lambda (fm) (and (dk-head-is? fm '=) (equal? (caddr fm) k) (dk-contains? fm lam))) "LAM(x) = k"))
             (h1 (begin (dk-have! (list '= (list lam x) (list '(OPR NN-ADD-MONOID) i j)) (lambda () (dk-close-if! (lambda () (dk-lam-b!)) gu-rfl-or-ass!)))
                        (dk-rewrite-h! h (list lam x) (list '(OPR NN-ADD-MONOID) i j))))
             (e (dk-have! (list '= (list '(OPR NN-ADD-MONOID) i j) (list '+ i j)) (lambda () (slot 'OPR) (dk-close-if! (lambda () (dk-lam-b!)) gu-rfl-or-ass!))))
             (h2 (dk-rewrite-h! h1 (list '(OPR NN-ADD-MONOID) i j) (list '+ i j))))
        (fact 'nn-in-rr i) (fact 'nn-in-rr j) (fact 'nn-in-rr n) (fact 'nn-in-rr d)
        (dk-have! (list 'IN k 'RR) (lambda () (subst (list '= k (list '+ i j))) (dk-type! (list '+ i j) 'RR)))
        (if (not (pair? raw)) (dk-have! (list '<= k (list '+ n d)) (lambda () (dk-ineq! h2 (list '<= i n) (list '<= j d) (list 'IN i 'RR) (list 'IN j 'RR) (list 'IN n 'RR) (list 'IN d 'RR) (list 'IN k 'RR)))))
        (list i j)))))
(define (gu-rfl-or-ass!) (if (dk-asm? (dk-goal)) (ass) (rfl)))
(define (gu-step-goal? gl)
  (let ((body (and (dk-head-is? gl 'FORALL) (caddr gl))))
    (and body (dk-head-is? body 'IMPLIES) (dk-head-is? (cadr body) 'IN) (eq? (caddr (cadr body)) 'NN))))


(sp (make-wff (list 'FORALL 'a_ (list 'IMPLIES '(IS-RING a_) (list 'FORALL 'f_ (list 'IMPLIES '(IN f_ (CARR (POLY a_)))
  (list 'FORALL 'g_ (list 'IMPLIES '(IN g_ (CARR (POLY a_)))
    (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'FORALL 'd_ (list 'IMPLIES '(IN d_ NN)
      (list 'IMPLIES '(DEG-BOUND a_ f_ n_) (list 'IMPLIES '(DEG-BOUND a_ g_ d_)
        (list 'DEG-BOUND 'a_ gp-mul '(+ n_ d_))))))))))))))))
(dk-peel!)
(gp-monoid!)
(gp-fs! 'a_ 'f_) (gp-fs! 'a_ 'g_)
(define gp1-bi (dk-cite! 'deg-bound 'a_ gp-mul '(+ n_ d_)))
(dk-have! (caddr gp1-bi)
  (lambda ()
    (let* ((ls (dk-peel!))
           (k (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) ls)))))
      (gp-km! k)
      (pbc)
      (dk-cite! 'supp-membership 'a_ gp-NM gp-mul k)
      (dk-have! (list 'IN k (list 'SUPP 'a_ gp-NM gp-mul)) (lambda () (dk-close-if! (lambda () (dk-only! (list 'IFF (list 'IN k (list 'SUPP 'a_ gp-NM gp-mul)) (list 'AND (list 'IN k '(CARR NN-ADD-MONOID)) (list 'NOT (list '= (list gp-mul k) '(ZERO a_))))) (list 'IN k '(CARR NN-ADD-MONOID)) (list 'NOT (list '= (list gp-mul k) '(ZERO a_))))) prop)))
      (gp-sum-in-image! k 'n_ 'd_)
      (dk-absurd! (list '< '(+ n_ d_) k) (list '<= k '(+ n_ d_)) (list 'IN k 'RR) '(IN n_ RR) '(IN d_ RR)))))
(dk-close-if! (lambda () (dk-only! gp1-bi (caddr gp1-bi))) prop)
(qed 'poly-mul-deg-bound)
(topic! 'poly-mul-deg-bound 'algebra)


;;; ---- the coefficient of the product at the sum of the two bounds ----
(define gp-X '(+ n_ d_))
(define gp-Sf '(SUPP a_ NN-ADD-MONOID f_))
(define gp-Sg '(SUPP a_ NN-ADD-MONOID g_))
(define gp-Q (list 'CARTESIAN gp-Sf gp-Sg))
(define gp-U (list 'SEP 'p gp-Q (list '= '((OPR NN-ADD-MONOID) (NTH 1 p) (NTH 2 p)) gp-X)))
(define gp-L (list 'VNB-LAMBDA 'p gp-U '((MUL a_) (f_ (NTH 1 p)) (g_ (NTH 2 p)))))
(define gp-ag '(RING-ADDITIVE-AG a_))
(define gp-i0 '(LIST n_ d_))
;; i, j in NN, i <= n, j <= d, i + j = n + d (as (= (+ i j) X) in context): land i = n and j = d
(define (gp-pin! i j)
  (fact 'nn-in-rr i) (fact 'nn-in-rr j) (fact 'nn-in-rr 'n_) (fact 'nn-in-rr 'd_)
  (let ((h (list '= (list '+ i j) gp-X)))
    (dk-have! (list '<= 'n_ i) (lambda () (dk-ineq! h (list '<= j 'd_) (list 'IN i 'RR) (list 'IN j 'RR) '(IN n_ RR) '(IN d_ RR))))
    (dk-have! (list '<= 'd_ j) (lambda () (dk-ineq! h (list '<= i 'n_) (list 'IN i 'RR) (list 'IN j 'RR) '(IN n_ RR) '(IN d_ RR))))
    (dk-cite! 'nn-le-antisym i 'n_)
    (dk-cite! 'nn-le-antisym j 'd_)))
;; (= ((OPR NN-ADD-MONOID) i j) X) in context, i, j in NN: land (= (+ i j) X)
(define (gp-opr-plus! i j)
  (let ((h (list '= (list '(OPR NN-ADD-MONOID) i j) gp-X)))
    (dk-have! (list '= (list '(OPR NN-ADD-MONOID) i j) (list '+ i j)) (lambda () (slot 'OPR) (dk-close-if! (lambda () (dk-lam-b!)) gu-rfl-or-ass!)))
    (dk-rewrite-h! h (list '(OPR NN-ADD-MONOID) i j) (list '+ i j))))

(sp (make-wff (list 'FORALL 'a_ (list 'IMPLIES '(IS-RING a_) (list 'FORALL 'f_ (list 'IMPLIES '(IN f_ (CARR (POLY a_)))
  (list 'FORALL 'g_ (list 'IMPLIES '(IN g_ (CARR (POLY a_)))
    (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'FORALL 'd_ (list 'IMPLIES '(IN d_ NN)
      (list 'IMPLIES '(DEG-BOUND a_ f_ n_) (list 'IMPLIES '(DEG-BOUND a_ g_ d_)
        (list '= (list gp-mul gp-X) '((MUL a_) (f_ n_) (g_ d_)))))))))))))))))
(dk-peel!)
(gp-monoid!)
(gp-nm-carr!)
(gp-fs! 'a_ 'f_) (gp-fs! 'a_ 'g_)
(dk-have! '(AND (IN n_ NN) (IN d_ NN)) (lambda () (dk-conj-close!)))
(fact 'nn-add-closed 'n_ 'd_)
(gp-km! gp-X) (gp-km! 'n_) (gp-km! 'd_)
(gp-val! 'a_ 'f_ 'n_) (gp-val! 'a_ 'g_ 'd_)
(dk-cite! 'ring-carrier-closed-mul 'a_ '(f_ n_) '(g_ d_))
(dk-cite! 'ring-zero-in 'a_)
(dk-cite! 'monalg-mul-value-in-carr 'a_ gp-NM 'f_ 'g_ gp-X)
;; if f(n) = 0 or g(d) = 0 both sides vanish
(define (gp6-degenerate! zero-f? pin!)
  (let ((z (if zero-f? '(= (f_ n_) (ZERO a_)) '(= (g_ d_) (ZERO a_)))))
    (subst z)
    (if zero-f? (subst (dk-cite! 'ring-mul-zero-left 'a_ '(g_ d_))) (subst (dk-cite! 'ring-mul-zero-right 'a_ '(f_ n_))))
    (pbc)
    (dk-cite! 'supp-membership 'a_ gp-NM gp-mul gp-X)
    (dk-have! (list 'IN gp-X (list 'SUPP 'a_ gp-NM gp-mul))
      (lambda () (dk-close-if! (lambda () (dk-only! (list 'IFF (list 'IN gp-X (list 'SUPP 'a_ gp-NM gp-mul)) (list 'AND (list 'IN gp-X '(CARR NN-ADD-MONOID)) (list 'NOT (list '= (list gp-mul gp-X) '(ZERO a_))))) (list 'IN gp-X '(CARR NN-ADD-MONOID)) (list 'NOT (list '= (list gp-mul gp-X) '(ZERO a_))))) prop)))
    (let* ((ij (gp-sum-in-image! gp-X 'n_ 'd_ 'raw)) (i (car ij)) (j (cadr ij)))
      (pin! i j)
      (let ((nz (if zero-f? (list 'NOT (list '= (list 'f_ i) '(ZERO a_))) (list 'NOT (list '= (list 'g_ j) '(ZERO a_))))))
        (dk-rewrite-h! nz (if zero-f? i j) (if zero-f? 'n_ 'd_))
        (dk-close-if! (lambda () (dk-only! z (list 'NOT z))) prop)))))
;; pv in CARTESIAN(Sf, Sg) in context: land its two components' memberships
(define (gp-cart! pv)
  (let ((c (dk-cite! 'cartesian-nth pv gp-Sf gp-Sg)))
    (if (not (dk-asm? (list 'IN (list 'NTH 1 pv) gp-Sf))) (dk-split-all! (list c)))))
;; the main case: f(n) /= 0, g(d) /= 0; the index set is the single pair [n, d]
(define (gp6-main! pin!)
  (fact 'monoid-carrier-is-set 'NN-ADD-MONOID)
  (fact 'ring-additive-ag-is-abelian-group 'a_)
  (dk-cite! 'supp-in-set 'a_ gp-NM 'f_) (dk-cite! 'supp-in-set 'a_ gp-NM 'g_)
  (gp-iff! 'finsupp-membership '(IN f_ (FINSUPP a_ NN-ADD-MONOID)) 'a_ gp-NM 'f_)
  (gp-iff! 'finsupp-membership '(IN g_ (FINSUPP a_ NN-ADD-MONOID)) 'a_ gp-NM 'g_)
  (dk-have! (list 'IN gp-Q 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close!)))
  (dk-have! (list 'AND (list 'IN gp-Sf 'SET) (list 'IN (list 'CARD gp-Sf) 'NN)) (lambda () (dk-conj-close!)))
  (dk-cite! 'card-cartesian-nn gp-Sf gp-Sg)
  (dk-have! (list 'IN gp-U 'SET) (lambda () (sep-set) (ass)))
  (dk-have! (list 'AND (list 'IN gp-Q 'SET) (list 'IN (list 'CARD gp-Q) 'NN)) (lambda () (dk-conj-close!)))
  (dk-have! (list 'AND (list 'IN gp-U 'SET) (list 'FORALL 'zc_ (list 'IMPLIES (list 'IN 'zc_ gp-U) (list 'IN 'zc_ gp-Q))))
    (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (let ((z (dk-di-var!))) (sep-me (list 'IN z gp-U)) (ass)))))))
  (dk-cite! 'card-subset-nn gp-Q gp-U)
  ;; the summand is typed
  (dk-have! (list 'IN gp-L (list 'FUN gp-U '(CARR a_)))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((pv (dk-di-var!)))
            (sep-me (list 'IN pv gp-U))
            (gp-cart! pv)
            (gp-iff! 'supp-membership (list 'IN (list 'NTH 1 pv) gp-Sf) 'a_ gp-NM 'f_ (list 'NTH 1 pv))
            (gp-iff! 'supp-membership (list 'IN (list 'NTH 2 pv) gp-Sg) 'a_ gp-NM 'g_ (list 'NTH 2 pv))
            (gp-val! 'a_ 'f_ (list 'NTH 1 pv)) (gp-val! 'a_ 'g_ (list 'NTH 2 pv))
            (dk-cite! 'ring-carrier-closed-mul 'a_ (list 'f_ (list 'NTH 1 pv)) (list 'g_ (list 'NTH 2 pv)))
            (ass)))
        (lambda () (ass)))))
  (dk-have! (list 'IN gp-L (list 'FUN gp-U (list 'CARR gp-ag))) (lambda () (mac 'raag-carr) (ass)))
  ;; [n, d] is an index
  (dk-have! (list 'IN 'n_ gp-Sf)
    (lambda () (let ((ii (dk-cite! 'supp-membership 'a_ gp-NM 'f_ 'n_)))
                 (dk-close-if! (lambda () (dk-only! ii '(IN n_ (CARR NN-ADD-MONOID)) '(NOT (= (f_ n_) (ZERO a_))))) prop))))
  (dk-have! (list 'IN 'd_ gp-Sg)
    (lambda () (let ((ii (dk-cite! 'supp-membership 'a_ gp-NM 'g_ 'd_)))
                 (dk-close-if! (lambda () (dk-only! ii '(IN d_ (CARR NN-ADD-MONOID)) '(NOT (= (g_ d_) (ZERO a_))))) prop))))
  (dk-cite! 'pair-in-cartesian gp-Sf gp-Sg 'n_ 'd_)
  (dk-have! (list 'IN gp-i0 gp-U)
    (lambda ()
      (for-each (lambda (l) (dk-focus! l)
                  (if (dk-head-is? (dk-goal) '=)
                      (begin (nth-r) (slot 'OPR) (dk-close-if! (lambda () (dk-lam-b!)) gu-rfl-or-ass!))
                      (ass)))
                (dk-opened (lambda () (sep-mi))))))
  ;; no other index
  (dk-have! (list 'FORALL 'j_ (list 'IMPLIES (list 'IN 'j_ gp-U) (list 'IMPLIES (list 'NOT (list '= 'j_ gp-i0)) (list '= (list gp-L 'j_) (list 'IDEN gp-ag)))))
    (lambda ()
      (let* ((ls (dk-peel!))
             (j (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (caddr fm) gp-U))) ls)))))
        (sep-me (list 'IN j gp-U))
        (gp-cart! j)
        (dk-cite! 'cartesian-pair-eq j gp-Sf gp-Sg)
        (gp-supp-nn! 'a_ 'f_ (list 'NTH 1 j))
        (gp-supp-nn! 'a_ 'g_ (list 'NTH 2 j))
        (gp-opr-plus! (list 'NTH 1 j) (list 'NTH 2 j))
        (pin! (list 'NTH 1 j) (list 'NTH 2 j))
        (dk-have! (list '= j gp-i0)
          (lambda ()
            (subst (list '= j (list 'LIST (list 'NTH 1 j) (list 'NTH 2 j))))
            (subst (list '= (list 'NTH 1 j) 'n_))
            (subst (list '= (list 'NTH 2 j) 'd_))
            (dk-cite! 'pair-tuple-is-set gp-Sf gp-Sg 'n_ 'd_)
            (rfl)))
        (dk-close-if! (lambda () (dk-only! (list '= j gp-i0) (list 'NOT (list '= j gp-i0)))) prop))))
  (mac 'monalg-mul-apply)
  (let ((e (dk-cite! 'finsum-single-support gp-ag gp-U gp-L gp-i0)))
    (subst e)
    (dk-lam-b!)
    (nth-r)
    (dk-close-if! (lambda () #t) gu-rfl-or-ass!)))
(define (gp6-bound-pin! i j)
  (gp-supp-le! 'a_ 'f_ 'n_ i) (gp-supp-le! 'a_ 'g_ 'd_ j) (gp-pin! i j))
(use-em '(= (f_ n_) (ZERO a_))
  (lambda () (gp6-degenerate! #t gp6-bound-pin!))
  (lambda ()
    (use-em '(= (g_ d_) (ZERO a_))
      (lambda () (gp6-degenerate! #f gp6-bound-pin!))
      (lambda ()
        (gp6-main! gp6-bound-pin!)))))
