(dk-cite! 'poly-eval-type 'fk 'p_ 'al_)
(define gp25-dv (dk-cite! 'divides '(POLY fk) gp25-XM 'p_))
(dk-iff! (lambda (g) (dk-head-is? g 'DIVIDES))
  (lambda ()
    ;; a root: divide by x - al; the remainder is a constant equal to p(al) = 0
    (let* ((s (dk-skolem! (dk-cite! 'poly-division-with-remainder 'fk 'p_ gp25-XM))))
      (dk-split-all!)
      (let* ((r (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm s))) "the remainder"))))
        (dk-split-all!)
        (let* ((xs (list '(MUL (POLY fk)) gp25-XM s))
               (eqp (list '= 'p_ (list '(ADD (POLY fk)) xs r)))
               (Z '(ZERO (POLY fk))))
          (gp-ptype!-fk xs)
          ;; the remainder vanishes
          (dk-have! (list '= r Z)
            (lambda ()
              (use-em (list '= r Z)
                (lambda () (ass))
                (lambda ()
                  (dk-have! (list '< (list 'DEG 'fk r) 1)
                    (lambda ()
                      (dk-have! (list '< (list 'DEG 'fk r) (list 'DEG 'fk gp25-XM))
                        (lambda () (dk-close-if! (lambda () (dk-only! (list 'OR (list '= r Z) (list '< (list 'DEG 'fk r) (list 'DEG 'fk gp25-XM))) (list 'NOT (list '= r Z)))) prop)))
                      (dk-rewrite-h! (list '< (list 'DEG 'fk r) (list 'DEG 'fk gp25-XM)) (list 'DEG 'fk gp25-XM) 1) (ass)))
                  (gp-fs! 'fk r)
                  (dk-split-all! (list (dk-cite! 'deg-well-defined 'fk r)))
                  (fact 'nn-zero-le (list 'DEG 'fk r))
                  (dk-have! '(IN 1 NN) (lambda () (arith)))
                  (fact 'nn-lt-succ-le (list 'DEG 'fk r) 1)
                  (dk-have! (list '<= (list 'DEG 'fk r) 0) (lambda () (dk-nn! (list '<= (list 'succ (list 'DEG 'fk r)) 1))))
                  (dk-cite! 'nn-le-antisym (list 'DEG 'fk r) 0)
                  (dk-rewrite-h! (list 'DEG-BOUND 'fk r (list 'DEG 'fk r)) (list 'DEG 'fk r) 0)
                  ;; p(al) = (al - al) s(al) + r(0)
                  (let* ((ev (list 'POLY-EVAL 'fk xs 'al_))
                         (e1 (dk-cite! 'poly-eval-add 'fk xs r 'al_))
                         (e2 (dk-cite! 'poly-eval-x-minus-mul 'fk 'al_ s 'al_))
                         (e3 (dk-cite! 'poly-eval-constant 'fk r 'al_))
                         (h0 (dk-rewrite-h! (list '= gp25-EV '(ZERO fk)) 'p_ (list '(ADD (POLY fk)) xs r)))
                         (h1 (dk-rewrite-h! h0 (cadr e1) (caddr e1)))
                         (h2 (dk-rewrite-h! h1 (cadr e2) (caddr e2)))
                         (h3 (dk-rewrite-h! h2 (cadr e3) (caddr e3))))
                    (dk-cite! 'poly-eval-type 'fk s 'al_)
                    (gp-val! 'fk r 0)
                    (dk-have! (list '= (list r 0) '(ZERO fk))
                      (lambda ()
                        (dk-have! (list '= (cadr h3) (list r 0)) (lambda () (crs)))
                        (subst (list '= (list r 0) (cadr h3)))
                        (ass)))
                    (let ((zi (dk-cite! 'poly-zero-iff 'fk r)))
                      (dk-have! (caddr zi)
                        (lambda ()
                          (let* ((ls (dk-peel!))
                                 (k (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) ls)))))
                            (use-em (list '= k 0)
                              (lambda () (subst (list '= k 0)) (ass))
                              (lambda ()
                                (dk-have! (list '< 0 k) (lambda () (fact 'nn-zero-le k) (gp-lt-from-ne! 0 k)))
                                (dk-cite! 'deg-bound-apply 'fk r 0 k)
                                (ass))))))
                      (dk-close-if! (lambda () (dk-only! zi (caddr zi))) prop)))))))
          ;; p = s (x - al)
          (dk-have! (caddr gp25-dv)
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal)) (ass)
                      (begin
                        (ew s)
                        (dk-conj-close!
                          (lambda ()
                            (if (dk-asm? (dk-goal)) (ass)
                                (let ((h (dk-rewrite-h! eqp r Z)))
                                  (dk-have! (list '= (caddr h) (caddr (dk-goal))) (lambda () (crs)))
                                  (dk-rewrite-h! h (caddr h) (caddr (dk-goal)))
                                  (ass)))))))))))
          (dk-close-if! (lambda () (dk-only! gp25-dv (caddr gp25-dv))) prop)))))
  (lambda ()
    ;; x - al divides p: p(al) = (al - al) k(al) = 0
    (gp-iff! 'divides (list 'DIVIDES '(POLY fk) gp25-XM 'p_) '(POLY fk) gp25-XM 'p_)
    (let* ((k (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm gp25-XM))) "the cofactor"))))
      (dk-split-all!)
      (let ((kx (list '(MUL (POLY fk)) k gp25-XM)) (xk (list '(MUL (POLY fk)) gp25-XM k)))
        (gp-ptype!-fk xk)
        (dk-have! (list '= kx xk) (lambda () (crs)))
        (subst (list '= 'p_ kx))
        (subst (list '= kx xk))
        (subst (dk-cite! 'poly-eval-x-minus-mul 'fk 'al_ k 'al_))
        (dk-cite! 'poly-eval-type 'fk k 'al_)
        (crs)))))
(qed 'poly-root-iff-x-minus-divides)
(topic! 'poly-root-iff-x-minus-divides 'algebra)

;; interval membership, read and proved (as gal-ufd.scm's gu-int-mem! / gu-int-in!)
(define (gp-int-mem! i hi)
  (gp-iff! 'interval-membership (list 'IN i (list 'INTERVAL 1 hi)) 1 hi i))
(define (gp-int-in! i hi)
  (if (not (dk-asm? (list 'IN i (list 'INTERVAL 1 hi))))
