;; a monomial c x^e has degree bound e
(sp (make-wff '(FORALL a_ (IMPLIES (IS-RING a_) (FORALL c_ (IMPLIES (IN c_ (CARR a_)) (FORALL e_ (IMPLIES (IN e_ NN)
  (DEG-BOUND a_ (MONOMIAL a_ c_ e_) e_)))))))))
(dk-peel!)
(define gp10-bi (dk-cite! 'deg-bound 'a_ '(MONOMIAL a_ c_ e_) 'e_))
(dk-have! (caddr gp10-bi)
  (lambda ()
    (let* ((ls (dk-peel!))
           (k (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) ls)))))
      (dk-have! (list 'NOT (list '= k 'e_)) (lambda () (dk-nn!)))
      (dk-cite! 'monomial-off 'a_ 'c_ 'e_ k)
      (ass))))
(dk-close-if! (lambda () (dk-only! gp10-bi (caddr gp10-bi))) prop)
(qed 'monomial-deg-bound)
(topic! 'monomial-deg-bound 'algebra)

;; a polynomial bounded by n whose coefficient at n vanishes is zero or of degree < n
(sp (make-wff '(FORALL a_ (IMPLIES (IS-RING a_) (FORALL h_ (IMPLIES (IN h_ (CARR (POLY a_))) (FORALL n_ (IMPLIES (IN n_ NN)
  (IMPLIES (DEG-BOUND a_ h_ n_) (IMPLIES (= (h_ n_) (ZERO a_))
    (OR (= h_ (ZERO (POLY a_))) (< (DEG a_ h_) n_))))))))))))
(dk-peel!)
(define gp11-bi (dk-cite! 'deg-bound 'a_ 'h_ 'n_))
(dk-have! (caddr gp11-bi) (lambda () (dk-close-if! (lambda () (dk-only! gp11-bi '(DEG-BOUND a_ h_ n_))) prop)))
(use-em '(= n_ 0)
  (lambda ()
    (let ((zi (dk-cite! 'poly-zero-iff 'a_ 'h_)))
      (dk-have! (caddr zi)
        (lambda ()
          (let* ((ls (dk-peel!))
                 (k (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) ls)))))
            (use-em (list '= k 'n_)
              (lambda () (subst (list '= k 'n_)) (ass))
              (lambda ()
                (fact 'nn-zero-le k)
                (dk-have! (list '<= 'n_ k) (lambda () (dk-nn!)))
                (gp-lt-from-ne! 'n_ k)
                (dk-apply! (caddr gp11-bi) k)
                (ass))))))
      (dk-close-if! (lambda () (dk-only! zi (caddr zi))) prop)))
  (lambda ()
    (let* ((n1 (dk-skolem! (dk-cite! 'nn-nonzero-is-succ 'n_))))
      (dk-split-all!)
      (dk-have! (list 'DEG-BOUND 'a_ 'h_ n1)
        (lambda ()
          (let ((b1 (dk-cite! 'deg-bound 'a_ 'h_ n1)))
            (dk-have! (caddr b1)
              (lambda ()
                (let* ((ls (dk-peel!))
                       (k (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) ls)))))
                  (use-em (list '= k 'n_)
                    (lambda () (subst (list '= k 'n_)) (ass))
                    (lambda ()
                      (fact 'nn-lt-succ-le n1 k)
                      (dk-have! (list '<= 'n_ k) (lambda () (dk-nn!)))
                      (gp-lt-from-ne! 'n_ k)
                      (dk-apply! (caddr gp11-bi) k)
                      (ass))))))
            (dk-close-if! (lambda () (dk-only! b1 (caddr b1))) prop))))
      (let ((parts (dk-split-all! (list (dk-cite! 'deg-well-defined 'a_ 'h_)))))
        (dk-apply! (car (filter (dk-head? 'FORALL) parts)) n1)
        (dk-have! '(< (DEG a_ h_) n_) (lambda () (dk-nn!)))
        (dk-close-if! (lambda () (dk-only! '(< (DEG a_ h_) n_))) prop)))))
