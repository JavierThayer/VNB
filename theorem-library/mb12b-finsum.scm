;;; mb12b-finsum.scm -- four general facts about real finite sums FINSUM over
;;; COMMUTATIVE-RING-ADDITIVE-AG(RR-NORMED-FIELD), each by finite-set-induction, for
;;; construction-of-measures 7.38.  Agent ISOM (brief M-B1B2, follow-up), 2026-10-26.
;;;
;;;   finsum-rr-const          f = c on a finite S  ==>  FINSUM f S = c * CARD(S)
;;;   finsum-rr-lt-termwise    a < b pointwise on a finite NONEMPTY S  ==>  FINSUM a S < FINSUM b S
;;;   finite-lower-bound-gt    every a(w) > t on a finite S  ==>  some m > t with m <= a(w) on S
;;;   finsum-rr-continuous-at  each h(w) continuous at t0  ==>  t |-> FINSUM (G t) S continuous at t0,
;;;                            where (G t)(w) = h(w)(t) on S
;;;
;;; The finite-set inductions run over a COMP class whose body quantifies everything else
;;; (the summands, the constant), so the step applies the hypothesis to the same data.
;;; Helper prefix: mfs-.  Library: analysis.

(define (mfs-head g) (and (pair? g) (car g)))
(define mfs-ag '(COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD))
(define (mfs-fs f s) (list 'FINSUM mfs-ag f s))
(define (mfs-un s x) (list 'UNION s (list 'PAIR x x)))

;;; the induction frame: proves  forall s. s in SET => CARD(s) in NN => s in COMP(body)
;;; BASE! runs with focus on body(EMPTY-SET); STEP! is (lambda (ih sv xv)) with focus on
;;; body(sv u {xv}) and ih = body(sv) in context.
(define (mfs-cls body) (list 'COMP 'mcs_ (body 'mcs_)))
(define (mfs-cls-thm! name body base! step!)
  (let* ((cls (mfs-cls body))
         (base-claim (list 'IN 'EMPTY-SET cls))
         (step-claim
          (list 'FORALL 'pcs_
            (list 'IMPLIES (list 'AND '(IN pcs_ SET) (list 'AND '(IN (CARD pcs_) NN) (list 'IN 'pcs_ cls)))
              (list 'FORALL 'pcx_
                (list 'IMPLIES (list 'AND '(IN pcx_ SET) '(NOT (IN pcx_ pcs_)))
                      (list 'IN '(UNION pcs_ (PAIR pcx_ pcx_)) cls)))))))
    (sp (make-wff (list 'FORALL 'mas_ (list 'IMPLIES '(IN mas_ SET) (list 'IMPLIES '(IN (CARD mas_) NN)
                    (list 'IN 'mas_ cls))))))
    (dk-peel!)
    (dk-have! base-claim
      (lambda ()
        (for-each (lambda (leaf) (dk-focus! leaf)
                    (if (and (eq? (mfs-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
                        (begin (fact 'empty-set-is-set) (ass))
                        (base!)))
                  (dk-opened (lambda () (comp-mi))))))
    (dk-have! step-claim
      (lambda ()
        (dk-peel!)
        (dk-split-all!)
        (let* ((g (dk-goal)) (un (cadr g)) (sv (cadr un)) (xv (cadr (caddr un))))
          (mfs-and! (list 'IN xv 'SET) (list 'IN xv 'SET))
          (fact 'pairing xv xv)
          (mfs-and! (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET))
          (fact 'union-set-closure sv (list 'PAIR xv xv))
          (let ((ih (dk-landed-find (lambda () (comp-me (list 'IN sv cls))) (dk-head? 'FORALL))))
            (for-each (lambda (leaf) (dk-focus! leaf)
                        (if (and (eq? (mfs-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
                            (ass)
                            (step! ih sv xv)))
                      (dk-opened (lambda () (comp-mi))))))))
    (dk-have! (list 'AND base-claim step-claim) (lambda () (dk-conj-close! (lambda () (ass)))))
    (let ((ind (dk-fact! 'finite-set-induction cls))
          (sv (cadr (dk-pick (lambda (h) (and (eq? (mfs-head h) 'IN) (eq? (caddr h) 'SET) (eq? (cadr h) 'mas_))) "S"))))
      (mfs-and! (list 'IN sv 'SET) (list 'IN (list 'CARD sv) 'NN))
      (dk-apply! ind sv)
      (ass))
    (qed name)
    (topic! name 'plumbing)))
;; lam-t on the focus goal (IN (VNB-LAMBDA v RR body) (FUN RR RR)); TYPER on the pointwise leaf
(define (mfs-lam-t! typer)
  (for-each (lambda (leaf)
              (dk-focus! leaf)
              (if (and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET))
                  (begin (fact 'rr-is-set) (ass))
                  (typer)))
            (dk-opened (lambda () (lam-t))))
)
(define (mfs-and! a b) (dk-have! (list 'AND a b) (lambda () (dk-conj-close! (lambda () (ass))))))
;; z in sv  ==>  z in sv u {xv}   (land it)
(define (mfs-in-union-left! z sv xv)
  (let ((iff (dk-cite! 'union-membership sv (list 'PAIR xv xv) z)))
    (dk-have! (list 'IN z (mfs-un sv xv)) (lambda () (if (dk-only! iff (list 'IN z sv)) (prop))))))
;; xv in sv u {xv}
(define (mfs-in-union-new! sv xv)
  (dk-cite! 'pair-self-member xv)
  (let ((iff (dk-cite! 'union-membership sv (list 'PAIR xv xv) xv)))
    (dk-have! (list 'IN xv (mfs-un sv xv)) (lambda () (if (dk-only! iff (list 'IN xv (list 'PAIR xv xv))) (prop))))))
;; CARD(sv u {xv}) = CARD(sv) + 1, landed
(define (mfs-card-insert! sv xv)
  (let ((n (list 'CARD sv)))
    (dk-cite! 'card-insert-curried sv xv)
    (dk-cite! 'ord-succ-nn n)
    (dk-cite! 'nn-succ-plus-one n)
    (dk-cite! 'nn-in-rr n)
    (dk-have! (list '= (list 'CARD (mfs-un sv xv)) (list '+ n 1))
      (lambda ()
        (subst (list '= (list 'CARD (mfs-un sv xv)) (list 'SUCC_ORD n)))
        (subst (list '= (list 'SUCC_ORD n) (list 'succ n)))
        (subst (list '= (list 'succ n) (list '+ n 1)))
        (dk-cite! 'rr-add-in-rr n 1)
        (rfl)))))

;;; =====================================================================
;;; (1) the sum of a constant
;;; =====================================================================
(define (mfs-const-body s)
  (list 'FORALL 'c (list 'IMPLIES '(IN c RR) (list 'FORALL 'f (list 'IMPLIES '(IN f SET)
    (list 'IMPLIES (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) '(= (f z) c)))
      (list '= (mfs-fs 'f s) (list '* 'c (list 'CARD s)))))))))

(mfs-cls-thm! 'finsum-rr-const-cls mfs-const-body
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (fs (cadr g)) (f (caddr fs)) (c (cadr (caddr g))))
      (fact 'finsum-empty mfs-ag f)
      (fact 'cra-ag-rr-iden)
      (fact 'card-empty)
      (fact 'rr-mul-zero c)
      (subst (list '== fs (list 'IDEN mfs-ag)))
      (subst (list '== (list 'IDEN mfs-ag) 0))
      (subst '(= (CARD EMPTY-SET) 0))
      (subst (list '= (list '* c 0) 0))
      (arith)))
  (lambda (ih sv xv)
    (dk-peel!)
    (let* ((g (dk-goal)) (fs (cadr g)) (f (caddr fs)) (c (cadr (caddr g)))
           (un (mfs-un sv xv))
           (hyp (dk-pick (lambda (h) (and (eq? (mfs-head h) 'FORALL) (dk-contains? h un) (dk-contains? h f))) "pointwise f = c")))
      (fact 'cra-ag-rr-is-abelian-group)
      (fact 'cra-ag-rr-carr)
      (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z sv) (list '= (list f 'z) c)))
        (lambda ()
          (let ((z (cadr (car (dk-peel!)))))
            (mfs-in-union-left! z sv xv)
            (dk-apply! hyp z)
            (ass))))
      (let ((ihe (dk-apply! ih c f)))
        (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ un) (list 'IN (list f 'z_) (list 'CARR mfs-ag))))
          (lambda ()
            (let ((z (cadr (car (dk-peel!)))))
              (dk-apply! hyp z)
              (subst (list '== (list 'CARR mfs-ag) 'RR))
              (subst (list '= (list f z) c))
              (ass))))
        (dk-cite! 'finsum-insert-ptwise mfs-ag sv xv f)
        (mfs-in-union-new! sv xv)
        (dk-apply! hyp xv)
        (mfs-card-insert! sv xv)
        (let* ((n (list 'CARD sv)) (fsv (mfs-fs f sv)))
          (dk-cite! 'rr-mul-in-rr c n)
          (dk-have! (list 'IN fsv 'RR) (lambda () (subst (list '= fsv (list '* c n))) (ass)))
          (dk-have! (list 'IN (list f xv) 'RR) (lambda () (subst (list '= (list f xv) c)) (ass)))
          (dk-cite! 'cra-ag-rr-opr-apply fsv (list f xv))
          (subst (list '= fs (list (list 'OPR mfs-ag) fsv (list f xv))))
          (subst (list '== (list (list 'OPR mfs-ag) fsv (list f xv)) (list '+ fsv (list f xv))))
          (subst (list '= fsv (list '* c n)))
          (subst (list '= (list f xv) c))
          (subst (list '= (list 'CARD un) (list '+ n 1)))
          (crs))))))

(sp (make-wff '(FORALL S (IMPLIES (IN S SET) (IMPLIES (IN (CARD S) NN)
   (FORALL c (IMPLIES (IN c RR) (FORALL f (IMPLIES (IN f (FUN S RR))
     (IMPLIES (FORALL z (IMPLIES (IN z S) (= (f z) c)))
       (= (FINSUM (COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD) f S) (* c (CARD S)))))))))))))
(dk-peel!)
(mfs-and! '(IN f (FUN S RR)) '(IN S SET))
(fact 'fun-elements-are-sets 'S 'RR 'f)
(let* ((iv (dk-cite! 'finsum-rr-const-cls 'S))
       (body (dk-landed-find (lambda () (comp-me iv)) (dk-head? 'FORALL))))
  (dk-apply! body 'c 'f)
  (ass))
(qed 'finsum-rr-const)
(topic! 'finsum-rr-const 'analysis)

;;; =====================================================================
;;; (2) a finite family of reals above t has a common lower bound above t
;;; =====================================================================
(define (mfs-lb-hyp s) (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w s) '(AND (IN (a w) RR) (< t (a w))))))
(define (mfs-lb-concl s) (list 'FORSOME 'm (list 'AND '(IN m RR)
                            (list 'AND '(< t m) (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w s) '(<= m (a w))))))))
(define (mfs-lb-body s)
  (list 'FORALL 't (list 'IMPLIES '(IN t RR) (list 'FORALL 'a (list 'IMPLIES '(IN a SET)
    (list 'IMPLIES (mfs-lb-hyp s) (mfs-lb-concl s)))))))
;; w in sv u {xv}, not in sv  ==>  w = xv
(define (mfs-new-point! w sv xv)
  (let ((iff (dk-cite! 'union-membership sv (list 'PAIR xv xv) w)))
    (dk-have! (list 'IN w (list 'PAIR xv xv))
      (lambda () (if (dk-only! iff (list 'IN w (mfs-un sv xv)) (list 'NOT (list 'IN w sv))) (prop))))
    (dk-cite! 'pair-self-eq xv w)))
;; t and a, read off the goal  (FORSOME m (AND (IN m RR) (AND (< t m) (FORALL w (IMPLIES _ (<= m (a w))))))))
(define (mfs-lb-vars)
  (let* ((and2 (caddr (caddr (dk-goal))))
         (t (cadr (cadr and2)))
         (le (caddr (caddr (caddr and2)))))
    (list t (car (caddr le)))))

(mfs-cls-thm! 'finite-lower-bound-gt-cls mfs-lb-body
  (lambda ()
    (let* ((pl (dk-peel!))
           (t (car (mfs-lb-vars))))
      (dk-cite! 'rr-add-in-rr t 1)
      (ew (list '+ t 1))
      (dk-conj-close!
       (lambda ()
         (cond ((dk-head-is? (dk-goal) 'IN) (ass))
               ((dk-head-is? (dk-goal) '<) (dk-ineq! (list 'IN t 'RR)))
               (#t (let ((w (cadr (car (dk-peel!)))))
                     (dk-cite! 'empty-set-has-no-members w)
                     (ai (list 'NOT (list 'IN w 'EMPTY-SET))))))))))
  (lambda (ih sv xv)
    (let* ((pl (dk-peel!))
           (ta (begin (mfs-lb-vars)))
           (t (car ta))
           (a (cadr ta))
           (un (mfs-un sv xv))
           (hyp (dk-pick (lambda (h) (and (eq? (mfs-head h) 'FORALL) (dk-contains? h un))) "the bound on sv u {xv}"))
           (aw (lambda (w) (list a w))))
      (dk-have! (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w sv) (list 'AND (list 'IN (aw 'w) 'RR) (list '< t (aw 'w)))))
        (lambda ()
          (let ((w (cadr (car (dk-peel!)))))
            (mfs-in-union-left! w sv xv)
            (dk-apply! hyp w)
            (ass))))
      (mfs-in-union-new! sv xv)
      (dk-split-all! (list (dk-apply! hyp xv)))
      (let* ((m (dk-skolem! (dk-apply! (dk-apply! ih t) a)))
             (mcl (dk-pick (lambda (h) (and (eq? (mfs-head h) 'FORALL) (dk-contains? h m))) "the bound on sv"))
             (ax (aw xv))
             (close-forall!
              (lambda (bound on-sv! )
                (let* ((w (cadr (car (dk-peel!)))))
                  (use-em (list 'IN w sv)
                    (lambda () (on-sv! w))
                    (lambda ()
                      (mfs-new-point! w sv xv)
                      (subst (list '= w xv))
                      (if (equal? bound ax)
                          (begin (dk-cite! 'rr-leq-reflexive ax) (ass))
                          (ass))))))))
        (use-em (list '<= m ax)
          (lambda ()
            (ew m)
            (dk-conj-close!
             (lambda ()
               (if (dk-head-is? (dk-goal) 'FORALL)
                   (close-forall! m (lambda (w) (dk-apply! mcl w) (ass)))
                   (ass)))))
          (lambda ()
            (dk-cite! 'rr-not-le-lt m ax)
            (ew ax)
            (dk-conj-close!
             (lambda ()
               (if (dk-head-is? (dk-goal) 'FORALL)
                   (close-forall! ax
                     (lambda (w)
                       (dk-apply! mcl w)
                       (dk-split-all! (list (dk-apply! (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w sv) (list 'AND (list 'IN (aw 'w) 'RR) (list '< t (aw 'w))))) w)))
                       (dk-ineq! (list '< ax m) (list '<= m (aw w)) (list 'IN ax 'RR) (list 'IN m 'RR) (list 'IN (aw w) 'RR))))
                   (ass))))))))))

(sp (make-wff '(FORALL S (IMPLIES (IN S SET) (IMPLIES (IN (CARD S) NN)
   (FORALL t (IMPLIES (IN t RR) (FORALL a (IMPLIES (IN a (FUN S RR))
     (IMPLIES (FORALL w (IMPLIES (IN w S) (< t (a w))))
       (FORSOME m (AND (IN m RR) (AND (< t m) (FORALL w (IMPLIES (IN w S) (<= m (a w)))))))))))))))))
(dk-peel!)
(mfs-and! '(IN a (FUN S RR)) '(IN S SET))
(fact 'fun-elements-are-sets 'S 'RR 'a)
(let ((wt (dk-pick (lambda (h) (and (eq? (mfs-head h) 'FORALL) (dk-contains? h '<))) "the bound")))
  (dk-have! (mfs-lb-hyp 'S)
    (lambda ()
      (let ((w (cadr (car (dk-peel!)))))
        (dk-cite! 'fun-apply-type-c 'a 'S 'RR w)
        (dk-apply! wt w)
        (dk-conj-close! (lambda () (ass)))))))
(let* ((iv (dk-cite! 'finite-lower-bound-gt-cls 'S))
       (body (dk-landed-find (lambda () (comp-me iv)) (dk-head? 'FORALL))))
  (dk-apply! body 't 'a)
  (ass))
(qed 'finite-lower-bound-gt)
(topic! 'finite-lower-bound-gt 'analysis)

;;; =====================================================================
;;; (3) strict monotonicity on a nonempty finite set
;;; =====================================================================
(define (mfs-lt-hyp s) (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w s)
                         '(AND (IN (a w) RR) (AND (IN (b w) RR) (< (a w) (b w)))))))
(define (mfs-lt-concl s)
  (let ((fa (mfs-fs 'a s)) (fb (mfs-fs 'b s)))
    (list 'AND (list 'IN fa 'RR) (list 'AND (list 'IN fb 'RR) (list 'AND (list '<= fa fb)
      (list 'IMPLIES (list 'FORSOME 'k (list 'IN 'k s)) (list '< fa fb)))))))
(define (mfs-lt-body s)
  (list 'FORALL 'a (list 'IMPLIES '(IN a SET) (list 'FORALL 'b (list 'IMPLIES '(IN b SET)
    (list 'IMPLIES (mfs-lt-hyp s) (mfs-lt-concl s)))))))
;; a and b read off the goal (AND (IN (FINSUM ag a s) RR) ...)
(define (mfs-lt-vars)
  (let* ((g (dk-goal)) (fa (cadr (cadr g))) (fb (cadr (cadr (caddr g)))))
    (list (caddr fa) (caddr fb))))

(mfs-cls-thm! 'finsum-rr-lt-termwise-cls mfs-lt-body
  (lambda ()
    (dk-peel!)
    (let* ((ab (mfs-lt-vars)) (a (car ab)) (b (cadr ab)))
      (fact 'cra-ag-rr-iden)
      (fact 'finsum-empty mfs-ag a)
      (fact 'finsum-empty mfs-ag b)
      (subst (list '== (mfs-fs a 'EMPTY-SET) (list 'IDEN mfs-ag)))
      (subst (list '== (mfs-fs b 'EMPTY-SET) (list 'IDEN mfs-ag)))
      (subst (list '== (list 'IDEN mfs-ag) 0))
      (dk-conj-close!
       (lambda ()
         (cond ((dk-head-is? (dk-goal) 'IMPLIES)
                (di)
                (let ((k (dk-skolem! (dk-pick (dk-head? 'FORSOME) "a member"))))
                  (dk-cite! 'empty-set-has-no-members k)
                  (ai (list 'NOT (list 'IN k 'EMPTY-SET)))))
               (#t (arith)))))))
  (lambda (ih sv xv)
    (dk-peel!)
    (let* ((ab (mfs-lt-vars)) (a (car ab)) (b (cadr ab))
           (un (mfs-un sv xv))
           (hyp (dk-pick (lambda (h) (and (eq? (mfs-head h) 'FORALL) (dk-contains? h un))) "the pointwise bound"))
           (rh (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w sv)
                 (list 'AND (list 'IN (list a 'w) 'RR) (list 'AND (list 'IN (list b 'w) 'RR) (list '< (list a 'w) (list b 'w))))))))
      (fact 'cra-ag-rr-is-abelian-group)
      (fact 'cra-ag-rr-carr)
      (dk-have! rh
        (lambda ()
          (let ((w (cadr (car (dk-peel!)))))
            (mfs-in-union-left! w sv xv)
            (dk-apply! hyp w)
            (ass))))
      (dk-split-all! (list (dk-apply! (dk-apply! ih a) b)))
      (mfs-in-union-new! sv xv)
      (dk-split-all! (list (dk-apply! hyp xv)))
      (for-each
       (lambda (f)
         (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ un) (list 'IN (list f 'z_) (list 'CARR mfs-ag))))
           (lambda ()
             (let ((z (cadr (car (dk-peel!)))))
               (dk-split-all! (list (dk-apply! hyp z)))
               (subst (list '== (list 'CARR mfs-ag) 'RR))
               (ass))))
         (dk-cite! 'finsum-insert-ptwise mfs-ag sv xv f)
         (dk-cite! 'cra-ag-rr-opr-apply (mfs-fs f sv) (list f xv)))
       (list a b))
      (let* ((fa (mfs-fs a sv)) (fb (mfs-fs b sv))
             (ax (list a xv)) (bx (list b xv))
             (fau (mfs-fs a un)) (fbu (mfs-fs b un))
             (sa (list '+ fa ax)) (sb (list '+ fb bx)))
        (dk-cite! 'rr-add-in-rr fa ax)
        (dk-cite! 'rr-add-in-rr fb bx)
        (dk-have! (list '= fau sa)
          (lambda () (subst (list '= fau (list (list 'OPR mfs-ag) fa ax)))
                     (subst (list '== (list (list 'OPR mfs-ag) fa ax) sa)) (rfl)))
        (dk-have! (list '= fbu sb)
          (lambda () (subst (list '= fbu (list (list 'OPR mfs-ag) fb bx)))
                     (subst (list '== (list (list 'OPR mfs-ag) fb bx) sb)) (rfl)))
        (dk-have! (list 'IN fau 'RR) (lambda () (subst (list '= fau sa)) (ass)))
        (dk-have! (list 'IN fbu 'RR) (lambda () (subst (list '= fbu sb)) (ass)))
        (dk-have! (list '< fau fbu)
          (lambda () (dk-ineq! (list '= fau sa) (list '= fbu sb) (list '<= fa fb) (list '< ax bx)
                               (list 'IN fa 'RR) (list 'IN fb 'RR) (list 'IN ax 'RR) (list 'IN bx 'RR)
                               (list 'IN fau 'RR) (list 'IN fbu 'RR))))
        (dk-conj-close!
         (lambda ()
           (cond ((dk-head-is? (dk-goal) 'IMPLIES) (di) (ass))
                 ((dk-head-is? (dk-goal) '<=) (dk-ineq! (list '< fau fbu) (list 'IN fau 'RR) (list 'IN fbu 'RR)))
                 (#t (ass)))))))))

(sp (make-wff '(FORALL S (IMPLIES (IN S SET) (IMPLIES (IN (CARD S) NN)
   (FORALL a (IMPLIES (IN a (FUN S RR)) (FORALL b (IMPLIES (IN b (FUN S RR))
     (IMPLIES (FORALL w (IMPLIES (IN w S) (< (a w) (b w))))
       (IMPLIES (FORSOME k (IN k S))
         (< (FINSUM (COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD) a S)
            (FINSUM (COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD) b S)))))))))))))
(dk-peel!)
(mfs-and! '(IN a (FUN S RR)) '(IN S SET))
(mfs-and! '(IN b (FUN S RR)) '(IN S SET))
(fact 'fun-elements-are-sets 'S 'RR 'a)
(fact 'fun-elements-are-sets 'S 'RR 'b)
(let ((wt (dk-pick (lambda (h) (and (eq? (mfs-head h) 'FORALL) (dk-contains? h '<))) "the bound")))
  (dk-have! (list 'FORALL 'w (list 'IMPLIES '(IN w S) '(AND (IN (a w) RR) (AND (IN (b w) RR) (< (a w) (b w))))))
    (lambda ()
      (let ((w (cadr (car (dk-peel!)))))
        (dk-cite! 'fun-apply-type-c 'a 'S 'RR w)
        (dk-cite! 'fun-apply-type-c 'b 'S 'RR w)
        (dk-apply! wt w)
        (dk-conj-close! (lambda () (ass)))))))
(let* ((iv (dk-cite! 'finsum-rr-lt-termwise-cls 'S))
       (body (dk-landed-find (lambda () (comp-me iv)) (dk-head? 'FORALL))))
  (dk-split-all! (list (dk-apply! (dk-apply! body 'a) 'b)))
  (dk-apply! (dk-pick (lambda (h) (and (eq? (mfs-head h) 'IMPLIES) (dk-head-is? (cadr h) 'FORSOME))) "the strict clause"))
  (ass))
(qed 'finsum-rr-lt-termwise)
(topic! 'finsum-rr-lt-termwise 'analysis)

;;; =====================================================================
;;; (4) a finite sum of functions continuous at t0 is continuous at t0
;;; =====================================================================
(define (mfs-F s) (list 'VNB-LAMBDA 't 'RR (mfs-fs '(G t) s)))
(define (mfs-ct-h1 s) (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w s)
                        '(AND (IN (h w) (FUN RR RR)) (IS-CONTINUOUS-AT RR-MS RR-MS (h w) t0)))))
(define (mfs-ct-h2 s) (list 'FORALL 't (list 'IMPLIES '(IN t RR) (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w s)
                        '(AND (IN ((G t) w) RR) (= ((G t) w) ((h w) t))))))))
(define (mfs-ct-concl s) (list 'AND (list 'IN (mfs-F s) '(FUN RR RR)) (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS (mfs-F s) 't0)))
(define (mfs-ct-body s)
  (list 'FORALL 'h (list 'IMPLIES '(IN h SET) (list 'FORALL 'G (list 'IMPLIES '(IN G (FUN RR SET))
    (list 'FORALL 't0 (list 'IMPLIES '(IN t0 RR)
      (list 'IMPLIES (mfs-ct-h1 s) (list 'IMPLIES (mfs-ct-h2 s) (mfs-ct-concl s))))))))))
;; h, G, t0 read off the goal (AND (IN (VNB-LAMBDA tv RR (FINSUM ag (G tv) s)) _) (IS-CONTINUOUS-AT _ _ _ t0))
(define (mfs-ct-vars)
  (let* ((g (dk-goal)) (lam (cadr (cadr g))) (fs (cadddr lam)) (gt (caddr fs))
         (t0 (car (last-pair (caddr g)))))
    (list (car gt) t0 lam)))
;; (G x)(w) in CARR ag for w in s, from the pointwise data H2 = (FORALL t (... (FORALL w (IMPLIES (IN w s) (AND ...)))))
(define (mfs-carr-ptwise! s G x h2)
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ s) (list 'IN (list (list G x) 'z_) (list 'CARR mfs-ag))))
    (lambda ()
      (let ((z (cadr (car (dk-peel!)))))
        (dk-split-all! (list (dk-apply! (dk-apply! h2 x) z)))
        (subst (list '== (list 'CARR mfs-ag) 'RR))
        (ass)))))
;; CARD(sv u {xv}) in NN
(define (mfs-card-u! sv xv)
  (let ((n (list 'CARD sv)))
    (dk-cite! 'card-insert-curried sv xv)
    (dk-cite! 'ord-succ-nn n)
    (dk-cite! 'nn-succ-closed n)
    (dk-have! (list 'IN (list 'CARD (mfs-un sv xv)) 'NN)
      (lambda ()
        (subst (list '= (list 'CARD (mfs-un sv xv)) (list 'SUCC_ORD n)))
        (subst (list '= (list 'SUCC_ORD n) (list 'succ n)))
        (ass)))))
;; FINSUM over s of (G x), real, given the pointwise data
(define (mfs-fs-real! s G x h2)
  (mfs-carr-ptwise! s G x h2)
  (dk-cite! 'finsum-type-ptwise mfs-ag s (list G x))
  (dk-have! (list 'IN (mfs-fs (list G x) s) 'RR)
    (lambda () (subst (list '== 'RR (list 'CARR mfs-ag))) (ass))))

(mfs-cls-thm! 'finsum-rr-continuous-at-cls mfs-ct-body
  (lambda ()
    (dk-peel!)
    (let* ((vs (mfs-ct-vars)) (G (car vs)) (t0 (cadr vs)) (lam (caddr vs))
           (zero '(VNB-LAMBDA x RR 0)))
      (fact 'cra-ag-rr-iden)
      (dk-have! (list 'IN lam '(FUN RR RR))
        (lambda ()
          (mfs-lam-t!
           (lambda ()
             (let ((v (cadr (car (dk-peel!)))))
               (dk-cite! 'fun-apply-type-c G 'RR 'SET v)
               (mac 'finsum-empty)
               (subst (list '== (list 'IDEN mfs-ag) 0))
               (arith))))))
      (dk-cite! 'const-continuous-at 0 t0)
      (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x RR) (list '= (list lam 'x) (list zero 'x))))
        (lambda ()
          (let ((v (cadr (car (dk-peel!)))))
            (dk-cite! 'fun-apply-type-c G 'RR 'SET v)
            (dk-lam-b!)
            (mac 'finsum-empty)
            (subst (list '== (list 'IDEN mfs-ag) 0))
            (arith))))
      (dk-cite! 'cont-transfer-ptwise-eq lam zero t0)
      (dk-conj-close! (lambda () (ass)))))
  (lambda (ih sv xv)
    (dk-peel!)
    (let* ((vs (mfs-ct-vars)) (G (car vs)) (t0 (cadr vs)) (lamu (caddr vs))
           (un (mfs-un sv xv))
           (h1 (dk-pick (lambda (h) (and (eq? (mfs-head h) 'FORALL) (dk-contains? h un) (dk-contains? h 'IS-CONTINUOUS-AT))) "continuity data"))
           (h2 (dk-pick (lambda (h) (and (eq? (mfs-head h) 'FORALL) (dk-contains? h un) (dk-contains? h G))) "pointwise data"))
           (hh (car (cadr (cadr (caddr (caddr h1))))))
           (rh1 (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w sv)
                  (list 'AND (list 'IN (list hh 'w) '(FUN RR RR)) (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS (list hh 'w) t0)))))
           (rh2 (list 'FORALL 't (list 'IMPLIES '(IN t RR) (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w sv)
                  (list 'AND (list 'IN (list (list G 't) 'w) 'RR) (list '= (list (list G 't) 'w) (list (list hh 'w) 't)))))))))
      (fact 'cra-ag-rr-is-abelian-group)
      (fact 'cra-ag-rr-carr)
      (dk-have! rh1
        (lambda ()
          (let ((w (cadr (car (dk-peel!)))))
            (mfs-in-union-left! w sv xv)
            (dk-apply! h1 w)
            (ass))))
      (dk-have! rh2
        (lambda ()
          (let* ((pl (dk-peel!))
                 (tv (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'RR))) pl))))
                 (w (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) sv))) pl)))))
            (mfs-in-union-left! w sv xv)
            (dk-apply! (dk-apply! h2 tv) w)
            (ass))))
      (dk-split-all! (list (dk-apply! (dk-apply! (dk-apply! ih hh) G) t0)))
      (mfs-in-union-new! sv xv)
      (dk-split-all! (list (dk-apply! h1 xv)))
      (mfs-card-u! sv xv)
      (let* ((fsv (list 'VNB-LAMBDA 't 'RR (mfs-fs '(G t) sv)))
             (fsv (dk-ctx-form (list 'IN (subst-free 'G G fsv) '(FUN RR RR))))
             (fsv (cadr fsv))
             (hx (list hh xv))
             (sumlam (list 'VNB-LAMBDA 'x 'RR (list '+ (list fsv 'x) (list hx 'x)))))
        (dk-cite! 'sum-continuous-at fsv hx t0)
        (dk-have! (list 'IN lamu '(FUN RR RR))
          (lambda ()
            (mfs-lam-t!
             (lambda ()
               (let ((v (cadr (car (dk-peel!)))))
                 (dk-cite! 'fun-apply-type-c G 'RR 'SET v)
                 (mfs-carr-ptwise! un G v h2)
                 (dk-cite! 'finsum-type-ptwise mfs-ag un (list G v))
                 (subst (list '== 'RR (list 'CARR mfs-ag)))
                 (ass))))))
        (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x RR) (list '= (list lamu 'x) (list sumlam 'x))))
          (lambda ()
            (let ((v (cadr (car (dk-peel!)))))
              (dk-cite! 'fun-apply-type-c G 'RR 'SET v)
              (dk-split-all! (list (dk-apply! (dk-apply! h2 v) xv)))
              (dk-cite! 'fun-apply-type-c hx 'RR 'RR v)
              (mfs-fs-real! sv G v rh2)
              (mfs-carr-ptwise! un G v h2)
              (dk-lam-b!)
              (let* ((gv (list G v)) (fs1 (mfs-fs gv sv)) (gx (list gv xv)))
                (dk-cite! 'finsum-insert-ptwise mfs-ag sv xv gv)
                (dk-cite! 'cra-ag-rr-opr-apply fs1 gx)
                (subst (list '= (mfs-fs gv un) (list (list 'OPR mfs-ag) fs1 gx)))
                (subst (list '== (list (list 'OPR mfs-ag) fs1 gx) (list '+ fs1 gx)))
                (subst (list '= gx (list hx v)))
                (dk-cite! 'rr-add-in-rr fs1 (list hx v))
                (rfl)))))
        (dk-cite! 'cont-transfer-ptwise-eq lamu sumlam t0)
        (dk-conj-close! (lambda () (ass)))))))

(sp (make-wff (list 'FORALL 'S (list 'IMPLIES '(IN S SET) (list 'IMPLIES '(IN (CARD S) NN)
   (list 'FORALL 'h (list 'IMPLIES '(IN h (FUN S (FUN RR RR))) (list 'FORALL 'G (list 'IMPLIES '(IN G (FUN RR (FUN S RR)))
     (list 'FORALL 't0 (list 'IMPLIES '(IN t0 RR)
       (list 'IMPLIES '(FORALL w (IMPLIES (IN w S) (IS-CONTINUOUS-AT RR-MS RR-MS (h w) t0)))
         (list 'IMPLIES '(FORALL t (IMPLIES (IN t RR) (FORALL w (IMPLIES (IN w S) (= ((G t) w) ((h w) t))))))
           (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS (mfs-F 'S) 't0))))))))))))))
(dk-peel!)
(fact 'rr-is-set)
(mfs-and! '(IN h (FUN S (FUN RR RR))) '(IN S SET))
(mfs-and! '(IN G (FUN RR (FUN S RR))) '(IN RR SET))
(fact 'fun-elements-are-sets 'S '(FUN RR RR) 'h)
(fact 'fun-elements-are-sets 'RR '(FUN S RR) 'G)
(dk--fun-dom! 'G 'RR '(FUN S RR))
(dk-have! '(IN G (FUN RR SET))
  (lambda ()
    (mac 'fun-codomain-iff)
    (dk-conj-close!
     (lambda ()
       (if (dk-head-is? (dk-goal) 'FORALL)
           (let ((v (cadr (car (dk-peel!)))))
             (dk-cite! 'fun-apply-type-c 'G 'RR '(FUN S RR) v)
             (dk-cite! 'membership-implies-sethood (list 'G v) '(FUN S RR))
             (ass))
           (ass))))))
(let ((c1 (dk-pick (lambda (h) (and (eq? (mfs-head h) 'FORALL) (dk-contains? h 'IS-CONTINUOUS-AT))) "continuity"))
      (c2 (dk-pick (lambda (h) (and (eq? (mfs-head h) 'FORALL) (dk-contains? h 'G))) "values")))
  (dk-have! (mfs-ct-h1 'S)
    (lambda ()
      (let ((w (cadr (car (dk-peel!)))))
        (dk-cite! 'fun-apply-type-c 'h 'S '(FUN RR RR) w)
        (dk-apply! c1 w)
        (dk-conj-close! (lambda () (ass))))))
  (dk-have! (mfs-ct-h2 'S)
    (lambda ()
      (let* ((pl (dk-peel!))
             (tv (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'RR))) pl))))
             (w (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'S))) pl)))))
        (dk-cite! 'fun-apply-type-c 'G 'RR '(FUN S RR) tv)
        (dk-cite! 'fun-apply-type-c (list 'G tv) 'S 'RR w)
        (dk-apply! (dk-apply! c2 tv) w)
        (dk-conj-close! (lambda () (ass)))))))
(let* ((iv (dk-cite! 'finsum-rr-continuous-at-cls 'S))
       (body (dk-landed-find (lambda () (comp-me iv)) (dk-head? 'FORALL))))
  (dk-split-all! (list (dk-apply! (dk-apply! (dk-apply! body 'h) 'G) 't0)))
  (ass))
(qed 'finsum-rr-continuous-at)
(topic! 'finsum-rr-continuous-at 'analysis)
