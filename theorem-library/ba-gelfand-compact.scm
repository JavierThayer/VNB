;;; ba-gelfand-compact.scm -- THE GELFAND SPACE IS COMPACT (BanachAlgebras.pdf Proposition 1.14).
;;; The characters of a unital Banach algebra form a closed subset of the product of copies of CC indexed by
;;; the algebra (characters-closed-in-product: each defining identity is the agreement set of two continuous
;;; maps of the product, cc-hom-separate), they lie in the product of the closed discs |z| <= ||x||
;;; (character-bounded), and so they are compact for the topology of pointwise convergence
;;; (confined-closed-compact, i.e. Tychonoff on the product of the discs).
;;; Agent BA-1F, wave 2026-11-09.  Destination: theorem-library/ba-gelfand-compact.scm.
;;; Library: operator-algebras.  All proofs modulo 0.  Helper prefix: gsc-.
;;; LOAD WINDOW: after cc-top-continuity.scm and top-power-compact.scm (this wave), BA-1D's cc-product.scm and
;;; ba-gelfand-continuous.scm (character-in-fun), BA-1's ba-spectrum.scm (bas-characters-unfold,
;;; character-bounded) and ba-laws.scm (bal-uba-vec-set, bal-uba-vone-in), and the cc-closed-ball files.

(define (gsc-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba-gelfand-compact: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (h) (display "      asm: ") (display (expression->string h)) (newline))
                              (list-head (dk-asms-of l) (min 50 (length (dk-asms-of l))))))
                  (dk-open-leaves))
        (error "ba-gelfand-compact: unfinished" name))))
(define (gsc-st body) (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a) body))))
(define (gsc-grounded?) (sequent-node-grounded? (proof-state-focus *ps*)))
(define (gsc-var landed cls)
  (let ((h (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cls))) landed)))
    (if h (cadr h) (error "gsc-var: no landed typing in" cls))))
(define (gsc-detach-close! ch th) (detach-with! ch th) (dk-ass!))
(define (gsc-cite2! . args)
  (let loop ((ch (apply dk-cite! args)))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))

(define gsc-MT '(METRIC-TOP CC-MS))
(define (gsc-cf-of ix) (list 'VNB-LAMBDA 'bgx_ ix gsc-MT))
(define (gsc-prp-of ix) (list 'TPROD-PTS ix (gsc-cf-of ix)))
(define (gsc-pr-of ix) (list 'TPRODUCT-TOP ix (gsc-cf-of ix)))
(define (gsc-mt!)
  (if (not (dk-asm? (list 'IS-TOP-SPACE gsc-MT)))
      (begin (dk-cite! 'cc-is-metric-space) (dk-cite! 'metric-top-is-top-space 'CC-MS)
             (dk-cite! 'cc-metric-top-pts) (dk-cite! 'cc-is-set) (dk-cite! 'cc-ms@pts))))
(define (gsc-cfy! ix y)
  (let ((e (list '= (list (gsc-cf-of ix) y) gsc-MT)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (if (not (dk-lam-b!)) (rfl)))))
    e))
(define (gsc-setup! ix)                ; (IN ix SET) in context
  (gsc-mt!)
  (if (not (dk-asm? (list 'IS-TOP-SPACE (gsc-pr-of ix))))
      (begin
        (dk-cite! 'cc-product-family ix)
        (dk-split! (dk-cite! 'tprod-sets ix (gsc-cf-of ix)))
        (dk-cite! 'tprod-top-pts ix (gsc-cf-of ix))
        (dk-cite! 'tprod-top-is-top-space ix (gsc-cf-of ix)))))
(define (gsc-coord! ix h y)            ; (IN h PRP), (IN y ix): land (IN (h y) CC)
  (let ((g (list 'IN (list h y) 'CC)))
    (if (not (dk-asm? g))
        (let* ((im (dk-cite! 'tprod-pts-mem ix (gsc-cf-of ix) h)) (r (caddr im)))
          (if (not (dk-asm? (caddr r)))
              (begin (dk-have! r (lambda () (if (dk-only! im (list 'IN h (gsc-prp-of ix))) (prop)))) (dk-split! r)))
          (dk-apply! (caddr r) y)
          (gsc-cfy! ix y)
          (let ((h1 (dk-rewrite-h! (list 'IN (list h y) (list 'PTS (list (gsc-cf-of ix) y))) (list (gsc-cf-of ix) y) gsc-MT)))
            (dk-rewrite-h! h1 (list 'PTS gsc-MT) 'CC))))
    g))

;;; ---- (1) a point of the product of copies of CC is a function into CC (the converse of fun-in-cc-product) --
(sp (make-wff (list 'FORALL 'ff (list 'FORALL 'f (list 'IMPLIES '(IN ff SET) (list 'IMPLIES (list 'IN 'f (gsc-prp-of 'ff))
  '(IN f (FUN ff CC))))))))
(dk-peel!)
(gsc-setup! 'ff)
(let* ((bu (list 'BIG-UNION 'tpj_ 'ff (list 'PTS (list (gsc-cf-of 'ff) 'tpj_))))
       (fi (dk-cite! 'fun-codomain-iff 'ff bu 'f))
       (im (dk-cite! 'tprod-pts-mem 'ff (gsc-cf-of 'ff) 'f))
       (fj (dk-cite! 'fun-codomain-iff 'ff 'CC 'f)))
  (dk-have! (caddr im) (lambda () (if (dk-only! im (list 'IN 'f (gsc-prp-of 'ff))) (prop))))
  (dk-split! (caddr im))
  (dk-have! '(IN f (FUN ff)) (lambda () (if (dk-only! fi (list 'IN 'f (list 'FUN 'ff bu))) (prop))))
  (dk-have! (caddr (caddr fj)) (lambda () (let ((y (dk-di-var!))) (gsc-coord! 'ff 'f y) (dk-ass!))))
  (dk-have! (caddr fj) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
  (if (dk-only! fj (caddr fj)) (prop)))
(gsc-qed! 'cc-product-fun)

;;; ---- (2) the characters are closed in the product -------------------------------------------------------
(define gsc-VA '(VEC a))
(define gsc-PR (gsc-pr-of gsc-VA))
(define gsc-PRP (gsc-prp-of gsc-VA))
(define gsc-CF (gsc-cf-of gsc-VA))
(define gsc-CH '(CHARACTERS a))
(define gsc-CHSEP '(SEP bac_ (FUN (VEC a) CC) (AND (IS-CC-LINEAR-ON a bac_) (AND (FORALL bax_ (IMPLIES (IN bax_ (VEC a))
  (FORALL bay_ (IMPLIES (IN bay_ (VEC a)) (= (bac_ ((VMUL a) bax_ bay_)) (* (bac_ bax_) (bac_ bay_))))))) (= (bac_ (VONE a)) 1)))))
(define (gsc-proj x) (list 'TPROJ gsc-VA gsc-CF x))
(define (gsc-u1 f) (list 'FORALL 'bax_ (list 'IMPLIES '(IN bax_ (VEC a)) (list 'FORALL 'bay_ (list 'IMPLIES '(IN bay_ (VEC a))
  (list '= (list f '((VADD a) bax_ bay_)) (list '+ (list f 'bax_) (list f 'bay_))))))))
(define (gsc-u2 f) (list 'FORALL 'baz_ (list 'IMPLIES '(IN baz_ CC) (list 'FORALL 'bax_ (list 'IMPLIES '(IN bax_ (VEC a))
  (list '= (list f '((ACT a) baz_ bax_)) (list '* 'baz_ (list f 'bax_))))))))
(define (gsc-u3 f) (list 'FORALL 'bax_ (list 'IMPLIES '(IN bax_ (VEC a)) (list 'FORALL 'bay_ (list 'IMPLIES '(IN bay_ (VEC a))
  (list '= (list f '((VMUL a) bax_ bay_)) (list '* (list f 'bax_) (list f 'bay_))))))))
(define (gsc-u4 f) (list '= (list f '(VONE a)) 1))
;; the failure of each identity at p, as an existential
(define (gsc-f1 f) (list 'FORSOME 'gsx_ (list 'FORSOME 'gsy_ (list 'AND '(IN gsx_ (VEC a)) (list 'AND '(IN gsy_ (VEC a))
  (list 'NOT (list '= (list f '((VADD a) gsx_ gsy_)) (list '+ (list f 'gsx_) (list f 'gsy_)))))))))
(define (gsc-f2 f) (list 'FORSOME 'gsz_ (list 'FORSOME 'gsx_ (list 'AND '(IN gsz_ CC) (list 'AND '(IN gsx_ (VEC a))
  (list 'NOT (list '= (list f '((ACT a) gsz_ gsx_)) (list '* 'gsz_ (list f 'gsx_)))))))))
(define (gsc-f3 f) (list 'FORSOME 'gsx_ (list 'FORSOME 'gsy_ (list 'AND '(IN gsx_ (VEC a)) (list 'AND '(IN gsy_ (VEC a))
  (list 'NOT (list '= (list f '((VMUL a) gsx_ gsy_)) (list '* (list f 'gsx_) (list f 'gsy_)))))))))

(define (gsc-vt! x)                    ; type an algebra element built from VADD VMUL ACT VONE over typed atoms
  (let ((want (list 'IN x gsc-VA)))
    (cond ((dk-asm? want) x)
          ((equal? x '(VONE a)) (dk-cite! 'bal-uba-vone-in 'a) x)
          ((and (pair? x) (equal? (car x) '(VADD a)))
           (gsc-vt! (cadr x)) (gsc-vt! (caddr x)) (dk-cite! 'ring-add-closed-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VMUL a)))
           (gsc-vt! (cadr x)) (gsc-vt! (caddr x)) (dk-cite! 'ring-carrier-closed-mul-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT a)))
           (gsc-vt! (caddr x)) (dk-cite! 'bae-act-type 'a (cadr x) (caddr x)) x)
          (#t (error "gsc-vt!: cannot type" (expression->string x))))))
(define (gsc-proj-hom! x)              ; x typed: (IS-HOM-TOP-SPACE PR MT (P x))
  (let ((g (list 'IS-HOM-TOP-SPACE gsc-PR gsc-MT (gsc-proj x))))
    (if (not (dk-asm? g))
        (begin (gsc-vt! x)
               (dk-cite! 'tproj-continuous gsc-VA gsc-CF x)
               (gsc-cfy! gsc-VA x)
               (dk-rewrite-h! (list 'IS-HOM-TOP-SPACE gsc-PR (list gsc-CF x) (gsc-proj x)) (list gsc-CF x) gsc-MT)))
    g))
(define (gsc-pval! x q)                ; q in PRP, x typed: (= ((P x) q) (q x))
  (let ((e (list '= (list (gsc-proj x) q) (list q x))))
    (if (not (dk-asm? e)) (begin (gsc-vt! x) (dk-cite! 'tproj-value gsc-VA gsc-CF x q)))
    (if (and (dk-asm? (list 'IN q '(FUN (VEC a) CC))) (not (dk-asm? (list 'IN (list q x) 'CC))))
        (dk-cite! 'fun-apply-type-c q gsc-VA 'CC x))
    e))
(define (gsc-pt! q)                    ; (IN q (FUN VA CC)) in context: q in PRP and in PTS PR
  (if (not (dk-asm? (list 'IN q gsc-PRP))) (dk-cite! 'fun-in-cc-product gsc-VA q))
  (if (not (dk-asm? (list 'IN q (list 'PTS gsc-PR))))
      (dk-have! (list 'IN q (list 'PTS gsc-PR)) (lambda () (subst (list '== (list 'PTS gsc-PR) gsc-PRP)) (dk-ass!)))))
(define (gsc-char! c)                  ; c in CHARACTERS: its FUN typing and the four identities, landed
  (if (not (dk-asm? (gsc-u4 c)))
      (begin
        (dk-cite! 'character-in-fun 'a c)
        (dk-cite! 'bas-characters-unfold 'a)
        (let ((m (dk-rewrite-h! (list 'IN c gsc-CH) gsc-CH gsc-CHSEP)))
          (dk-split-all! (dk-landed (lambda () (sep-me m)))))
        (dk-split-all! (dk-landed (lambda () (mac-h 'is-cc-linear-on (list 'IS-CC-LINEAR-ON 'a c))))))))
(define (gsc-hom-map h)                ; the map of a landed (IS-HOM-TOP-SPACE s t f)
  (if (and (pair? h) (eq? (car h) 'IS-HOM-TOP-SPACE)) (list-ref h 3)
      (error "gsc-hom-map: not a hom fact" h)))
(define (gsc-beta-val! e)              ; prove the value equation E by beta and the projection values in context
  (if (not (dk-asm? e))
      (dk-have! e (lambda ()
                    (dk-lam-b!)
                    (if (not (gsc-grounded?))
                        (begin
                          (for-each (lambda (h) (if (and (pair? h) (eq? (car h) '=) (pair? (cadr h)) (pair? (car (cadr h)))
                                                         (eq? (car (car (cadr h))) 'TPROJ) (dk-contains? (dk-goal) (cadr h)))
                                                    (subst h)))
                                    (dk-asms))
                          (if (not (gsc-grounded?)) (rfl)))))))
  e)
;; p in PTS PR with (NOT (= ta(p) tb(p))) in context; A, B homs PR -> MT in context; VALS! q lands (= (A q) ta) and
;; (= (B q) tb) and returns (ta . tb); at a character c, (= ta tb) follows from c's identities by CFACT! c ta tb.
(define (gsc-separate! p A B vals! cfact!)
  (let ((agree (list 'FORALL 'ctc_ (list 'IMPLIES (list 'IN 'ctc_ gsc-CH) (list '= (list A 'ctc_) (list B 'ctc_))))))
    (dk-have! agree
      (lambda ()
        (let ((c (dk-di-var!)))
          (gsc-char! c) (gsc-pt! c)
          (let ((v (vals! c)))
            (subst (list '= (list A c) (car v)))
            (subst (list '= (list B c) (cdr v)))
            (cfact! c (car v) (cdr v))))))
    (let ((v (vals! p)))
      (dk-have! (list 'NOT (list '= (list A p) (list B p)))
        (lambda ()
          (di)
          (dk-have! (list '= (car v) (cdr v))
            (lambda () (subst (list '= (car v) (list A p))) (subst (list '= (cdr v) (list B p))) (dk-ass!)))
          (ai (list 'NOT (list '= (car v) (cdr v)))))))
    (dk-cite! 'cc-hom-separate gsc-PR A B gsc-CH p)
    (dk-ass!)))
(define (gsc-skolem2! fail)            ; fail = FORSOME u (FORSOME v (AND ..)) in context: the two witnesses
  (let* ((w1 (dk-skolem! (dk-ctx-form fail) #f))
         (in2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h w1))) "the inner failure"))
         (w2 (dk-skolem! in2 #f)))
    (dk-split-all! (list (dk-pick (lambda (h) (and (dk-head-is? h 'AND) (dk-contains? h w1) (dk-contains? h w2))) "the failure body")))
    (list w1 w2)))
;; prove the identity U (two quantified variables) from NOT FAIL in context
(define (gsc-prove-u2! fail)
  (dk-peel!)
  (let* ((g (dk-goal)) (inner (cadr (cadr g))) (x (cadr inner)) (y (caddr inner)))
    (use-em g
      (lambda () (dk-ass!))
      (lambda ()
        (dk-have! fail (lambda () (ew x) (ew y) (dk-conj-close! (lambda () (dk-ass!)))))
        (ai (list 'NOT fail))))))

(sp (gsc-st (list 'IS-TOP-CLOSED gsc-PR gsc-CH)))
(dk-peel!)
(dk-cite! 'bal-uba-vec-set 'a)
(gsc-setup! gsc-VA)
(dk-have! (list 'SUBSET gsc-CH gsc-PRP)
  (lambda () (mac 'subset-def)
             (let ((c (gsc-var (dk-peel!) gsc-CH))) (dk-cite! 'character-in-fun 'a c) (dk-cite! 'fun-in-cc-product gsc-VA c) (dk-ass!))))
(mac 'is-top-closed)
(let ((co (list 'COMPLEMENT-IN (list 'PTS gsc-PR) gsc-CH)))
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? (dk-goal) 'SUBSET) (subst (list '== (list 'PTS gsc-PR) gsc-PRP)) (dk-ass!))
        (#t
         (let* ((ch (dk-cite! 'top-open-of-local gsc-PR co))
                (ch2 (detach-with! ch
                       (lambda ()
                         (mac 'subset-def)
                         (let* ((z (gsc-var (dk-peel!) co)) (cm (dk-cite! 'complement-in-membership (list 'PTS gsc-PR) gsc-CH z)))
                           (dk-have! (caddr cm) (lambda () (if (dk-only! cm (list 'IN z co)) (prop))))
                           (dk-split! (caddr cm))
                           (dk-ass!))))))
           (gsc-detach-close! ch2
             (lambda ()
               (let* ((p (gsc-var (dk-peel!) co)) (cm (dk-cite! 'complement-in-membership (list 'PTS gsc-PR) gsc-CH p)))
                 (dk-have! (caddr cm) (lambda () (if (dk-only! cm (list 'IN p co)) (prop))))
                 (dk-split! (caddr cm))
                 (dk-have! (list 'IN p gsc-PRP) (lambda () (subst (list '== gsc-PRP (list 'PTS gsc-PR))) (dk-ass!)))
                 (dk-cite! 'cc-product-fun gsc-VA p)
                 (let ((f1 (gsc-f1 p)) (f2 (gsc-f2 p)) (f3 (gsc-f3 p)))
                   (use-em f1
                     ;; additivity fails at x, y: P(x + y) against P(x) + P(y)
                     (lambda ()
                       (let* ((ws (gsc-skolem2! f1)) (x (car ws)) (y (cadr ws)) (xy (list '(VADD a) x y)))
                         (gsc-vt! xy)
                         (gsc-proj-hom! xy) (gsc-proj-hom! x) (gsc-proj-hom! y)
                         (let ((B (gsc-hom-map (dk-cite! 'cc-hom-add gsc-PR (gsc-proj x) (gsc-proj y)))))
                           (gsc-separate! p (gsc-proj xy) B
                             (lambda (q)
                               (gsc-pval! xy q) (gsc-pval! x q) (gsc-pval! y q)
                               (gsc-beta-val! (list '= (list B q) (list '+ (list q x) (list q y))))
                               (cons (list q xy) (list '+ (list q x) (list q y))))
                             (lambda (c ta tb) (dk-apply! (dk-ctx-form (gsc-u1 c)) x y) (dk-ass!))))))
                     (lambda ()
                       (dk-have! (gsc-u1 p) (lambda () (gsc-prove-u2! f1)))
                       (use-em f2
                         ;; homogeneity fails at z, x: P(z x) against the constant z times P(x)
                         (lambda ()
                           (let* ((ws (gsc-skolem2! f2)) (z (car ws)) (x (cadr ws)) (zx (list '(ACT a) z x)))
                             (gsc-vt! zx)
                             (gsc-proj-hom! zx) (gsc-proj-hom! x)
                             (let* ((K (gsc-hom-map (dk-cite! 'cc-hom-const gsc-PR z)))
                                    (B (gsc-hom-map (dk-cite! 'cc-hom-mul gsc-PR K (gsc-proj x)))))
                               (gsc-separate! p (gsc-proj zx) B
                                 (lambda (q)
                                   (gsc-pval! zx q) (gsc-pval! x q)
                                   (gsc-beta-val! (list '= (list B q) (list '* z (list q x))))
                                   (cons (list q zx) (list '* z (list q x))))
                                 (lambda (c ta tb) (dk-apply! (dk-ctx-form (gsc-u2 c)) z x) (dk-ass!))))))
                         (lambda ()
                           (dk-have! (gsc-u2 p) (lambda () (gsc-prove-u2! f2)))
                           (use-em f3
                             ;; multiplicativity fails at x, y: P(x y) against P(x) P(y)
                             (lambda ()
                               (let* ((ws (gsc-skolem2! f3)) (x (car ws)) (y (cadr ws)) (xy (list '(VMUL a) x y)))
                                 (gsc-vt! xy)
                                 (gsc-proj-hom! xy) (gsc-proj-hom! x) (gsc-proj-hom! y)
                                 (let ((B (gsc-hom-map (dk-cite! 'cc-hom-mul gsc-PR (gsc-proj x) (gsc-proj y)))))
                                   (gsc-separate! p (gsc-proj xy) B
                                     (lambda (q)
                                       (gsc-pval! xy q) (gsc-pval! x q) (gsc-pval! y q)
                                       (gsc-beta-val! (list '= (list B q) (list '* (list q x) (list q y))))
                                       (cons (list q xy) (list '* (list q x) (list q y))))
                                     (lambda (c ta tb) (dk-apply! (dk-ctx-form (gsc-u3 c)) x y) (dk-ass!))))))
                             (lambda ()
                               (dk-have! (gsc-u3 p) (lambda () (gsc-prove-u2! f3)))
                               (use-em (gsc-u4 p)
                                 ;; all four identities hold: p is a character, against p not in CHARACTERS
                                 (lambda ()
                                   (dk-cite! 'bas-characters-unfold 'a)
                                   (dk-have! (list 'IS-CC-LINEAR-ON 'a p)
                                     (lambda () (mac 'is-cc-linear-on) (dk-conj-close! (lambda () (dk-ass!)))))
                                   (dk-have! (list 'IN p gsc-CH)
                                     (lambda () (subst (list '== gsc-CH gsc-CHSEP))
                                                (in-sep! (lambda () (dk-conj-close! (lambda () (dk-ass!)))))))
                                   (ai (list 'NOT (list 'IN p gsc-CH))))
                                 ;; p(1) /= 1: P(1) against the constant 1
                                 (lambda ()
                                   (let ((one '(VONE a)))
                                     (gsc-vt! one)
                                     (gsc-proj-hom! one)
                                     (dk-real! 1)
                                     (if (not (dk-asm? '(IN 1 CC))) (dk-cite! 'cc-one-in))
                                     (let ((K (gsc-hom-map (dk-cite! 'cc-hom-const gsc-PR 1))))
                                       (gsc-separate! p (gsc-proj one) K
                                         (lambda (q)
                                           (gsc-pval! one q)
                                           (gsc-beta-val! (list '= (list K q) 1))
                                           (cons (list q one) 1))
                                         (lambda (c ta tb) (dk-ass!)))))))))))))))))))))))
(gsc-qed! 'characters-closed-in-product)

;;; ---- (3) Proposition 1.14: the Gelfand space is compact ---------------------------------------------------
(define gsc-KB '(VNB-LAMBDA gsw_ (VEC a) (CLOSED-BALL CC-MS 0 ((VNRM a) gsw_))))
(define (gsc-kb-of y) (list 'CLOSED-BALL 'CC-MS 0 (list '(VNRM a) y)))
(sp (gsc-st '(IS-COMPACT-T (GELFAND-SPACE a))))
(dk-peel!)
(dk-cite! 'bal-uba-vec-set 'a)
(gsc-setup! gsc-VA)
(dk-cite! 'characters-closed-in-product 'a)
(dk-have! (list 'SUBSET gsc-CH gsc-PRP)
  (lambda () (mac 'subset-def)
             (let ((c (gsc-var (dk-peel!) gsc-CH))) (dk-cite! 'character-in-fun 'a c) (dk-cite! 'fun-in-cc-product gsc-VA c) (dk-ass!))))
(dk-real! 0)
(dk-cite! 'cc-zero-in)
(define (gsc-kb-facts! y)              ; y in VA: the ball's typing facts and (= (KB y) ball)
  (let ((bl (gsc-kb-of y)) (r (list '(VNRM a) y)))
    (if (not (dk-asm? (list 'IN r 'RR))) (dk-cite! 'bae-vnrm-type 'a y))
    (if (not (dk-asm? (list 'SUBSET bl '(PTS CC-MS))))
        (begin (dk-apply! (dk-cite! 'closed-ball-in-carrier 'CC-MS) 0 r)
               (dk-apply! (dk-cite! 'closed-ball-in-power 'CC-MS) 0 r)
               (dk-apply! (dk-cite! 'closed-ball-is-set 'CC-MS) 0 r)))
    (let ((e (list '= (list gsc-KB y) bl)))
      (if (not (dk-asm? e)) (dk-have! e (lambda () (if (not (dk-lam-b!)) (rfl)))))
      e)))
