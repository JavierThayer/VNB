;;; ch3c-hom.scm -- homotopy (complex-analysis.pdf 3.3.2): 3.16, 3.17, 3.18, 3.20, 3.31 (and 3.15).
;;; Prefix ch-.  Library: complex-analysis.  Destination: theorem-library/homotopy.scm.
;;; The rectangle [0, 1] x [a, b] is Q(a, b) = PRODUCT2-MS(SUBSPACE-MS(RR-MS, [0, 1]), SUBSPACE-MS(RR-MS, [a, b])).

(define (ch-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "ch-pick: nothing matching" what) (car l))))
(define (ch-split-goal!)
  (let loop ((todo (list (proof-state-focus *ps*))) (acc '()))
    (if (null? todo) (reverse acc)
        (begin (dk-focus! (car todo))
               (if (dk-head-is? (dk-goal) 'AND)
                   (loop (append (dk-opened (lambda () (di))) (cdr todo)) acc)
                   (loop (cdr todo) (cons (car todo) acc)))))))
;;; local copies of the ch3c-ga / ch3c-poly helpers (each file loads in its own environment)
(define (ch-in-ccint! x lo hi . prems)
  (let ((g (list 'IN x (list 'CCINT lo hi))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda ()
                      (mac 'ccint-membership)
                      (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (apply dk-ineq! prems)))))))))
(define (ch-ccint-parts! z lo hi)               ; z in [lo, hi]: land z in RR, lo <= z, z <= hi (keeps the membership)
  (for-each (lambda (c) (if (not (dk-asm? c)) (dk-project! c (lambda () (mac-h 'ccint-membership (list 'IN z (list 'CCINT lo hi))) (dk-split-all!)))))
            (list (list 'IN z 'RR) (list '<= lo z) (list '<= z hi))))
(define ch-inc '(FORALL cgk_ (IMPLIES (IN cgk_ NN) (IMPLIES (< cgk_ n) (< (tq cgk_) (tq (succ cgk_)))))))
(define (ch-pks nn)
  (list 'FORALL 'hmk_ (list 'IMPLIES '(IN hmk_ NN) (list 'IMPLIES (list '< 'hmk_ nn)
    '(AND (< (tq hmk_) (tq (succ hmk_)))
     (AND (IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) (bs hmk_))
     (AND (IS-CONVEX-CC (bs hmk_))
     (AND (SUBSET (bs hmk_) u)
     (AND (IN (xq hmk_) (bs hmk_))
     (AND (IN (xq (succ hmk_)) (bs hmk_))
          (FORALL hmw_ (IMPLIES (IN hmw_ (CCINT (tq hmk_) (tq (succ hmk_)))) (IN (pgam hmw_) (bs hmk_))))))))))))))

(define (ch-S lo hi) (list 'SUBSPACE-MS 'RR-MS (list 'CCINT lo hi)))
(define (ch-Q a b) (list 'PRODUCT2-MS (ch-S 0 1) (ch-S a b)))
(define (ch-R a b) (list 'CARTESIAN '(CCINT 0 1) (list 'CCINT a b)))
(define (ch-sub-basics! lo hi)                 ; the subspace [lo, hi] of RR-MS: set, pts, metric space
  (let ((I (list 'CCINT lo hi)))
    (fact 'rr-is-metric-space) (fact 'rr-ms@pts) (fact 'rr-is-set)
    (fact 'ccint-subset-rr lo hi) (fact 'subclass-of-set-is-set I 'RR)
    (fact 'subspace-pts 'RR-MS I)
    (dk-have! (list 'SUBSET I '(PTS RR-MS)) (lambda () (subst '(= (PTS RR-MS) RR)) (ass)))
    (fact 'subspace-is-metric-space 'RR-MS I)))
(define (ch-rect-basics! a b)                  ; Q(a, b): metric space, (== (PTS Q) R)
  (let ((Q (ch-Q a b)) (R (ch-R a b)))
    (ch-sub-basics! 0 1) (ch-sub-basics! a b)
    (fact 'product2-is-metric-space (ch-S 0 1) (ch-S a b))
    (fact 'product2-pts (ch-S 0 1) (ch-S a b))
    (if (not (dk-asm? (list '== (list 'PTS Q) R)))
        (dk-have! (list '== (list 'PTS Q) R)
          (lambda () (subst (list '= (list 'PTS Q) (list 'CARTESIAN (list 'PTS (ch-S 0 1)) (list 'PTS (ch-S a b)))))
                     (subst (list '= (list 'PTS (ch-S 0 1)) '(CCINT 0 1)))
                     (subst (list '= (list 'PTS (ch-S a b)) (list 'CCINT a b)))
                     (qrfl))))))
(define (ch-coords! z a b)                     ; z in R: its coordinates, typed and in their intervals
  (if (not (dk-asm? (list 'IN (list 'NTH 1 z) '(CCINT 0 1))))
  (let ((R (ch-R a b)))
    (dk-split-all! (list (dk-fact! 'cartesian-nth z '(CCINT 0 1) (list 'CCINT a b))))
    (fact 'cartesian-pair-eq z '(CCINT 0 1) (list 'CCINT a b))
    (fact 'subset-mem-fwd '(CCINT 0 1) 'RR (list 'NTH 1 z))
    (fact 'subset-mem-fwd (list 'CCINT a b) 'RR (list 'NTH 2 z)))))

;;; ---------------------------------------------------------------------------
;;; K1: the distance of the rectangle is the max of the coordinate distances
(sp (make-wff (forall-guarded '(a b chy_ chz_) (list '(IN a RR) '(IN b RR) (list 'IN 'chy_ (ch-R 'a 'b)) (list 'IN 'chz_ (ch-R 'a 'b)))
  (list '== (list (list 'DIST (ch-Q 'a 'b)) 'chy_ 'chz_)
        '(max (abs (- (NTH 1 chy_) (NTH 1 chz_))) (abs (- (NTH 2 chy_) (NTH 2 chz_))))))))
(dk-peel!)
(ch-rect-basics! 'a 'b)
(ch-coords! 'chy_ 'a 'b) (ch-coords! 'chz_ 'a 'b)
(let ((Q (ch-Q 'a 'b)) (S1 (ch-S 0 1)) (S2 (ch-S 'a 'b)))
  (for-each (lambda (z) (dk-have! (list 'IN z (list 'CARTESIAN (list 'PTS S1) (list 'PTS S2)))
                          (lambda () (subst (list '= (list 'PTS S1) '(CCINT 0 1))) (subst (list '= (list 'PTS S2) '(CCINT a b))) (ass))))
            '(chy_ chz_))
  (subst (dk-cite! 'product2-dist S1 S2 'chy_ 'chz_))
  (subst (dk-cite! 'subspace-dist 'RR-MS '(CCINT 0 1) '(NTH 1 chy_) '(NTH 1 chz_)))
  (subst (dk-cite! 'subspace-dist 'RR-MS '(CCINT a b) '(NTH 2 chy_) '(NTH 2 chz_)))
  (subst (dk-cite! 'rr-ms-dist '(NTH 1 chy_) '(NTH 1 chz_)))
  (subst (dk-cite! 'rr-ms-dist '(NTH 2 chy_) '(NTH 2 chz_)))
  (qrfl))
(qed 'rect-dist)

;;; ---------------------------------------------------------------------------
;;; K2 / K3: continuity on the rectangle in coordinates
(define (ch-cfun) (list 'FUN (ch-R 'a 'b) 'CC))
(define ch-k2-hyp
  (list 'FORALL 'che_ (list 'IMPLIES '(POS-RR che_) (list 'FORSOME 'chd_ (list 'AND '(POS-RR chd_)
    (list 'FORALL 'chy_ (list 'IMPLIES (list 'IN 'chy_ (ch-R 'a 'b))
      '(IMPLIES (<= (abs (- (NTH 1 chx_) (NTH 1 chy_))) chd_) (IMPLIES (<= (abs (- (NTH 2 chx_) (NTH 2 chy_))) chd_)
         (<= (magnitude (- (f chx_) (f chy_))) che_))))))))))
(define (ch-max-split! y z d)                  ; (<= dist_Q(y, z) d) in context: both coordinate bounds
  (let ((d1 (list 'abs (list '- (list 'NTH 1 y) (list 'NTH 1 z)))) (d2 (list 'abs (list '- (list 'NTH 2 y) (list 'NTH 2 z)))))
    (fact 'rr-sub-in-rr (list 'NTH 1 y) (list 'NTH 1 z)) (fact 'rr-sub-in-rr (list 'NTH 2 y) (list 'NTH 2 z))
    (fact 'rr-abs-closed (list '- (list 'NTH 1 y) (list 'NTH 1 z))) (fact 'rr-abs-closed (list '- (list 'NTH 2 y) (list 'NTH 2 z)))
    (fact 'rr-le-max-left d1 d2) (fact 'rr-le-max-right d1 d2) (fact 'rr-max-closed d1 d2)
    (dk-have! (list '<= d1 d) (lambda () (dk-ineq! (list '<= d1 (list 'max d1 d2)) (list '<= (list 'max d1 d2) d))))
    (dk-have! (list '<= d2 d) (lambda () (dk-ineq! (list '<= d2 (list 'max d1 d2)) (list '<= (list 'max d1 d2) d))))))
(sp (make-wff (forall-guarded '(a b f chx_)
  (list '(IN a RR) '(IN b RR) '(< a b) (list 'IN 'f (ch-cfun)) (list 'IN 'chx_ (ch-R 'a 'b)) ch-k2-hyp)
  (list 'IS-CONTINUOUS-AT (ch-Q 'a 'b) 'CC-MS 'f 'chx_))))
(dk-peel!)
(ch-rect-basics! 'a 'b)
(fact 'cc-is-metric-space) (fact 'cc-ms@pts)
(let* ((Q (ch-Q 'a 'b)) (R (ch-R 'a 'b)) (hk (ch-pick 'hk (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'che_))))))
  (ch-coords! 'chx_ 'a 'b)
  (fact 'fun-apply-type-c 'f R 'CC 'chx_)
  (mac 'is-continuous-at)
  (for-each
   (lambda (leaf)
     (dk-focus! leaf)
     (cond ((dk-asm? (dk-goal)) (ass))
           ((dk-head-is? (dk-goal) 'IN)
            (subst (list '= (list 'PTS Q) R)) (if (dk-contains? (dk-goal) '(PTS CC-MS)) (subst '(= (PTS CC-MS) CC))) (ass))
           (#t
            (let* ((pl (dk-peel!)) (e (cadr (car (filter (lambda (z) (dk-head-is? z 'POS-RR)) pl))))
                   (d (dk-skolem! (dk-apply! hk e) #t))
                   (cl (ch-pick 'cl (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z d))))))
              (ew d)
              (for-each
               (lambda (l2)
                 (dk-focus! l2)
                 (if (dk-asm? (dk-goal)) (ass)
                     (let* ((pl2 (dk-peel!)) (y (cadr (car (filter (lambda (z) (and (dk-head-is? z 'IN) (equal? (caddr z) (list 'PTS Q)))) pl2)))))
                       (dk-have! (list 'IN y R) (lambda () (subst (list '= R (list 'PTS Q))) (ass)))
                       (ch-coords! y 'a 'b)
                       (fact 'fun-apply-type-c 'f R 'CC y)
                       (fact 'rect-dist 'a 'b 'chx_ y)
                       (dk-rewrite-h! (list '<= (list (list 'DIST Q) 'chx_ y) d) (list (list 'DIST Q) 'chx_ y)
                                      (list 'max (list 'abs (list '- '(NTH 1 chx_) (list 'NTH 1 y))) (list 'abs (list '- '(NTH 2 chx_) (list 'NTH 2 y)))))
                       (dk-pos-parts! d)
                       (ch-max-split! 'chx_ y d)
                       (inst*! cl y)
                       (subst (dk-cite! 'cc-ms-dist '(f chx_) (list 'f y)))
                       (ass))))
               (ch-split-goal!))))))
   (ch-split-goal!)))
(qed 'rect-cont-intro)

;;; K3: a map continuous on the (compact) rectangle is uniformly continuous, in coordinates
(define (ch-cont-all f) (list 'FORALL 'chx_ (list 'IMPLIES (list 'IN 'chx_ (ch-R 'a 'b)) (list 'IS-CONTINUOUS-AT (ch-Q 'a 'b) 'CC-MS f 'chx_))))
(define (ch-unif f)
  (list 'FORALL 'che_ (list 'IMPLIES '(POS-RR che_) (list 'FORSOME 'chd_ (list 'AND '(POS-RR chd_)
    (list 'FORALL 'chy_ (list 'IMPLIES (list 'IN 'chy_ (ch-R 'a 'b)) (list 'FORALL 'chz_ (list 'IMPLIES (list 'IN 'chz_ (ch-R 'a 'b))
      (list 'IMPLIES '(<= (abs (- (NTH 1 chy_) (NTH 1 chz_))) chd_) (list 'IMPLIES '(<= (abs (- (NTH 2 chy_) (NTH 2 chz_))) chd_)
        (list '<= (list 'magnitude (list '- (list f 'chy_) (list f 'chz_))) 'che_))))))))))))
(sp (make-wff (forall-guarded '(a b f) (list '(IN a RR) '(IN b RR) '(< a b) (list 'IN 'f (ch-cfun)) (ch-cont-all 'f))
  (ch-unif 'f))))
(dk-peel!)
(ch-rect-basics! 'a 'b)
(fact 'cc-is-metric-space) (fact 'cc-ms@pts)
(let* ((Q (ch-Q 'a 'b)) (R (ch-R 'a 'b)) (S1 (ch-S 0 1)) (S2 (ch-S 'a 'b))
       (ca (ch-pick 'ca (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'IS-CONTINUOUS-AT)))))
       (e (cadr (ch-pick 'e (lambda (z) (dk-head-is? z 'POS-RR))))))
  (dk-have! '(IN 0 RR)) (dk-have! '(IN 1 RR))
  (fact 'heine-borel-ccint 0 1) (fact 'heine-borel-ccint 'a 'b)
  (fact 'product2-compact S1 S2)
  (dk-have! (list 'IS-CONTINUOUS Q 'CC-MS 'f)
    (lambda ()
      (mac 'is-continuous)
      (for-each (lambda (l) (dk-focus! l)
                  (cond ((dk-asm? (dk-goal)) (ass))
                        ((dk-head-is? (dk-goal) 'IN) (subst (list '= (list 'PTS Q) R)) (subst '(= (PTS CC-MS) CC)) (ass))
                        (#t (let ((x (dk-di-var!)))
                              (dk-have! (list 'IN x R) (lambda () (subst (list '= R (list 'PTS Q))) (ass)))
                              (inst*! ca x) (ass)))))
                (ch-split-goal!))))
  (fact 'compact-continuous-uniformly-continuous Q 'CC-MS 'f)
  (let* ((rhs (caddr (dk-cite! 'is-uniformly-continuous Q 'CC-MS 'f))))
    (dk-project! rhs 'is-uniformly-continuous (list 'IS-UNIFORMLY-CONTINUOUS Q 'CC-MS 'f))
    (dk-split-all! (list rhs))
    (let* ((d (dk-skolem! (dk-apply! (ch-pick 'ue (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'delta)))) e) #t))
           (cl (ch-pick 'cl (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d))))))
      (dk-pos-parts! d)
      (ew d)
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (dk-asm? (dk-goal)) (ass)
             (let* ((pl (dk-peel!))
                    (lt1 (car (filter (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f '(NTH 1 chy_)))) pl)))
                    (y 'chy_) (z 'chz_)
                    (d1 (list 'abs (list '- (list 'NTH 1 y) (list 'NTH 1 z)))) (d2 (list 'abs (list '- (list 'NTH 2 y) (list 'NTH 2 z)))))
               (ch-coords! y 'a 'b) (ch-coords! z 'a 'b)
               (for-each (lambda (v) (dk-have! (list 'IN v (list 'PTS Q)) (lambda () (subst (list '= (list 'PTS Q) R)) (ass)))
                                     (fact 'fun-apply-type-c 'f R 'CC v))
                         (list y z))
               (fact 'rr-sub-in-rr (list 'NTH 1 y) (list 'NTH 1 z)) (fact 'rr-sub-in-rr (list 'NTH 2 y) (list 'NTH 2 z))
               (fact 'rr-abs-closed (list '- (list 'NTH 1 y) (list 'NTH 1 z))) (fact 'rr-abs-closed (list '- (list 'NTH 2 y) (list 'NTH 2 z)))
               (fact 'rr-max-le d1 d2 d)
               (fact 'rect-dist 'a 'b y z)
               (dk-have! (list '<= (list (list 'DIST Q) y z) d) (lambda () (subst (list '= (list (list 'DIST Q) y z) (list 'max d1 d2))) (ass)))
               (inst*! cl y z)
               (fact 'cc-ms-dist (list 'f y) (list 'f z))
               (dk-rewrite-h! (ch-pick 'res (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f '(DIST CC-MS)))))
                              (list '(DIST CC-MS) (list 'f y) (list 'f z)) (list 'magnitude (list '- (list 'f y) (list 'f z))))
               (ass))))
       (ch-split-goal!)))))
(qed 'rect-unif)

;;; ---------------------------------------------------------------------------
;;; helpers for homotopies
(define (ch-R-set! a b)                        ; R in SET
  (ch-sub-basics! 0 1) (ch-sub-basics! a b)
  (let ((iff (dk-cite! 'cartesian-set-iff '(CCINT 0 1) (list 'CCINT a b))))
    (dk-have! (list 'IN (ch-R a b) 'SET)
      (lambda () (if (dk-only! iff (list 'IN '(CCINT 0 1) 'SET) (list 'IN (list 'CCINT a b) 'SET)) (prop))))))
(define (ch-pair-in! s0 t0 a b)                ; (LIST s0 t0) in R, given s0 in [0, 1], t0 in [a, b]
  (if (not (dk-asm? (list 'IN (list 'LIST s0 t0) (ch-R a b))))
      (fact 'pair-in-cartesian '(CCINT 0 1) (list 'CCINT a b) s0 t0)))
;;; the K2 hypothesis for the map F at the point X
(define (ch-k2 F X) (subst-free 'chx_ X (subst-free 'f F ch-k2-hyp)))
;;; drive a goal (HOMOTOPIC ...) after (mac 'homotopic): HANDLERS is an alist head -> thunk
(define (ch-drive! wit handlers)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (ass))
          ((dk-head-is? g 'AND) (for-each (lambda (l) (dk-focus! l) (ch-drive! wit handlers)) (dk-opened (lambda () (di)))))
          ((dk-head-is? g 'FORSOME) (ew wit) (ch-drive! wit handlers))
          (#t (let ((h (assq (if (dk-head-is? g 'FORALL) (cadr g) (car g)) handlers)))
                (if h ((cdr h)) (ass)))))))

;;; HOMOTOPY IS REFLEXIVE (3.16)
(define ch-phi-refl (list 'VNB-LAMBDA 'chq_ (ch-R 'a 'b) '(pgam (NTH 2 chq_))))
(sp (make-wff (forall-guarded '(u pgam a b) '((IS-PATH pgam a b) (SUBSET (TRACE pgam a b) u))
  '(HOMOTOPIC u pgam pgam a b))))
(dk-peel!)
(fact 'is-path-endpoints 'pgam 'a 'b) (dk-split-all!)
(fact 'is-path-in-fun 'pgam 'a 'b)
(ch-rect-basics! 'a 'b) (ch-R-set! 'a 'b)
(dk-have! '(IN 0 RR)) (dk-have! '(IN 1 RR))
(let* ((R (ch-R 'a 'b)) (ph ch-phi-refl))
  (ch-in-ccint! 'a 'a 'b '(< a b)) (ch-in-ccint! 'b 'a 'b '(< a b))
  (ch-in-ccint! 0 0 1) (ch-in-ccint! 1 0 1)
  (fact 'fun-apply-type-c 'pgam '(CCINT a b) 'CC 'a) (fact 'fun-apply-type-c 'pgam '(CCINT a b) 'CC 'b)
  (define (val! z)                             ; z in R: (= (ph z) (pgam (NTH 2 z))), typed
    (ch-coords! z 'a 'b)
    (fact 'fun-apply-type-c 'pgam '(CCINT a b) 'CC (list 'NTH 2 z))
    (dk-have! (list '= (list ph z) (list 'pgam (list 'NTH 2 z))) (lambda () (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl)))))
  (for-each (lambda (cod)
              (dk-have! (list 'IN ph (list 'FUN R cod))
                (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!)))
                                                      (ch-coords! z 'a 'b)
                                                      (fact 'fun-apply-type-c 'pgam '(CCINT a b) 'CC (list 'NTH 2 z))
                                                      (if (eq? cod 'u)
                                                          (begin (fact 'trace-value-in 'pgam 'a 'b (list 'NTH 2 z))
                                                                 (fact 'subset-mem-fwd '(TRACE pgam a b) 'u (list 'pgam (list 'NTH 2 z)))))
                                                      (ass)))
                                         (lambda () (ass))))))
            '(CC u))
  (let ((uc (dk-fact! 'path-uniformly-continuous 'pgam 'a 'b)))
    (mac 'homotopic)
    (ch-drive! ph
      (list
       (cons '= (lambda () (rfl)))
       (cons 'hmz_
             (lambda ()
               (let* ((pl (dk-peel!)) (z (cadr (car pl))))
                 (dk-have! (ch-k2 ph z)
                   (lambda ()
                     (let* ((pl2 (dk-peel!)) (e (cadr (car (filter (lambda (f) (dk-head-is? f 'POS-RR)) pl2))))
                            (d (dk-skolem! (dk-apply! uc e) #t))
                            (cl (ch-pick 'cl (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d))))))
                       (ew d)
                       (for-each (lambda (l) (dk-focus! l)
                                   (if (dk-asm? (dk-goal)) (ass)
                                       (let* ((pl3 (dk-peel!)) (y (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) R))) pl3)))))
                                         (val! z) (val! y)
                                         (subst (list '= (list ph z) (list 'pgam (list 'NTH 2 z))))
                                         (subst (list '= (list ph y) (list 'pgam (list 'NTH 2 y))))
                                         (inst*! cl (list 'NTH 2 z) (list 'NTH 2 y))
                                         (ass))))
                                 (ch-split-goal!)))))
                 (fact 'rect-cont-intro 'a 'b ph z)
                 (ass))))
       (cons 'hmt_
             (lambda ()
               (let* ((tv (dk-di-var!)))
                 (fact 'fun-apply-type-c 'pgam '(CCINT a b) 'CC tv)
                 (for-each (lambda (l) (dk-focus! l)
                             (let ((s0 (cadr (cadr (cadr (dk-goal))))))
                               (ch-pair-in! s0 tv 'a 'b)
                               (dk-lam-b!) (nth-r)
                               (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass) (rfl)))))
                           (ch-split-goal!)))))
       (cons 'hms_
             (lambda ()
               (let* ((sv (dk-di-var!)))
                 (for-each (lambda (l) (dk-focus! l)
                             (let ((t0 (caddr (cadr (cadr (dk-goal))))))
                               (ch-pair-in! sv t0 'a 'b)
                               (dk-lam-b!) (nth-r)
                               (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass) (rfl)))))
                           (ch-split-goal!)))))))))
(qed 'homotopic-refl)

;;; ---------------------------------------------------------------------------
;;; open a HOMOTOPIC(u, g, r, a, b) hypothesis: returns the homotopy phi, with its typing in FUN(R, u)
;;; and FUN(R, CC), the continuity universal, the two boundary universals, and the endpoint equations
(define (ch-unpack! u g r a b)
  (let* ((hyp (list 'HOMOTOPIC u g r a b))
         (rhs (caddr (dk-cite! 'homotopic u g r a b))))
    (dk-project! rhs 'homotopic hyp)
    (dk-split-all! (list rhs))
    (let* ((phi (dk-skolem! (ch-pick 'ex (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'hmf_) (dk-contains? f g) (dk-contains? f r)))) #t))
           (Rr (ch-R a b)) (Q (ch-Q a b)))
      (dk-split-all!)
      (ch-rect-basics! a b)
      (fact 'cc-is-metric-space) (fact 'cc-ms@pts)
      (dk-have! '(IN 0 RR))
      (ch-in-ccint! 0 0 1)
      (fact 'is-path-endpoints g a b) (dk-split-all!)
      (ch-in-ccint! a a b (list '< a b)) (ch-in-ccint! b a b (list '< a b))
      (ch-pair-in! 0 a a b)
      (let* ((ca (ch-pick 'ca (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-CONTINUOUS-AT) (dk-contains? f phi)))))
             (c0 (inst*! ca (list 'LIST 0 a)))
             (crhs (caddr (dk-cite! 'is-continuous-at Q 'CC-MS phi (list 'LIST 0 a)))))
        (dk-project! (list 'IN phi (list 'FUN (list 'PTS Q) '(PTS CC-MS))) 'is-continuous-at c0)
        (dk-have! (list 'IN phi (list 'FUN Rr 'CC))
          (lambda () (subst (list '= Rr (list 'PTS Q))) (subst '(= CC (PTS CC-MS))) (ass))))
      phi)))

;;; HOMOTOPY IS SYMMETRIC (3.16)
(sp (make-wff (forall-guarded '(u pgam prho a b) '((HOMOTOPIC u pgam prho a b)) '(HOMOTOPIC u prho pgam a b))))
(dk-peel!)
(let* ((phi (ch-unpack! 'u 'pgam 'prho 'a 'b)) (R (ch-R 'a 'b))
       (ps (list 'VNB-LAMBDA 'chq_ R (list phi '(LIST (- 1 (NTH 1 chq_)) (NTH 2 chq_)))))
       (bt (ch-pick 'bt (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'hmt_)))))
       (bs (ch-pick 'bs (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'hms_)))))
       (unif (begin (fact 'rect-unif 'a 'b phi) (ch-pick 'un (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'che_) (dk-contains? f phi)))))))
  (ch-R-set! 'a 'b)
  (dk-have! '(IN 1 RR))
  (ch-in-ccint! 1 0 1)
  (define (flip! z)                            ; z in R: the flipped point is in R; returns it
    (ch-coords! z 'a 'b)
    (let ((p (list 'LIST (list '- 1 (list 'NTH 1 z)) (list 'NTH 2 z))))
      (ch-ccint-parts! (list 'NTH 1 z) 0 1)
      (fact 'rr-sub-in-rr 1 (list 'NTH 1 z))
      (ch-in-ccint! (list '- 1 (list 'NTH 1 z)) 0 1 (list '<= 0 (list 'NTH 1 z)) (list '<= (list 'NTH 1 z) 1))
      (ch-pair-in! (list '- 1 (list 'NTH 1 z)) (list 'NTH 2 z) 'a 'b)
      p))
  (for-each (lambda (cod)
              (dk-have! (list 'IN ps (list 'FUN R cod))
                (lambda () (dk-lam-type! (lambda () (let* ((z (dk-di-var!)) (p (flip! z))) (fact 'fun-apply-type-c phi R cod p) (ass)))
                                         (lambda () (ass))))))
            '(CC u))
  (define (val! z)
    (let ((p (flip! z)))
      (fact 'fun-apply-type-c phi R 'CC p)
      (dk-have! (list '= (list ps z) (list phi p)) (lambda () (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl))))
      p))
  (fact 'is-path-in-fun 'prho 'a 'b) (fact 'is-path-in-fun 'pgam 'a 'b)
  (for-each (lambda (c) (fact 'fun-apply-type-c c '(CCINT a b) 'CC 'a) (fact 'fun-apply-type-c c '(CCINT a b) 'CC 'b)) '(pgam prho))
  (mac 'homotopic)
  (ch-drive! ps
    (list
     (cons '= (lambda () (subst (dk-goal)) (rfl)))
     (cons 'hmz_
           (lambda ()
             (let* ((pl (dk-peel!)) (z (cadr (car pl))))
               (dk-have! (ch-k2 ps z)
                 (lambda ()
                   (let* ((pl2 (dk-peel!)) (e (cadr (car (filter (lambda (f) (dk-head-is? f 'POS-RR)) pl2))))
                          (d (dk-skolem! (dk-apply! unif e) #t))
                          (cl (ch-pick 'cl (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d))))))
                     (ew d)
                     (for-each (lambda (l) (dk-focus! l)
                                 (if (dk-asm? (dk-goal)) (ass)
                                     (let* ((pl3 (dk-peel!)) (y (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) R))) pl3))))
                                            (pz (val! z)) (py (val! y)))
                                       (subst (list '= (list ps z) (list phi pz)))
                                       (subst (list '= (list ps y) (list phi py)))
                                       (for-each (lambda (k) (dk-have! (list '<= (list 'abs (list '- (list 'NTH k pz) (list 'NTH k py))) d)
                                                               (lambda ()
                                                                 (nth-r)
                                                                 (if (= k 1)
                                                                     (let ((e1 (list '- (list '- 1 (list 'NTH 1 z)) (list '- 1 (list 'NTH 1 y))))
                                                                           (e2 (list '- (list 'NTH 1 y) (list 'NTH 1 z))))
                                                                       (dk-have! (list '= e1 e2) (lambda () (crs)))
                                                                       (subst (list '= e1 e2))
                                                                       (subst (dk-cite! 'rr-abs-sub-sym (list 'NTH 1 y) (list 'NTH 1 z)))
                                                                       (ass))
                                                                     (ass)))))
                                                 '(1 2))
                                       (inst*! cl pz py)
                                       (ass))))
                               (ch-split-goal!)))))
               (fact 'rect-cont-intro 'a 'b ps z)
               (ass))))
     (cons 'hmt_
           (lambda ()
             (let* ((tv (dk-di-var!)))
               (dk-split-all! (list (dk-apply! bt tv)))
               (for-each (lambda (l) (dk-focus! l)
                           (let* ((s0 (cadr (cadr (cadr (dk-goal))))) (s1 (if (eqv? s0 0) 1 0)))
                             (ch-pair-in! s0 tv 'a 'b)
                             (dk-lam-b!) (nth-r)
                             (dk-have! (list '= (list '- 1 s0) s1) (lambda () (dk-ineq!)))
                             (subst (list '= (list '- 1 s0) s1))
                             (ass)))
                         (ch-split-goal!)))))
     (cons 'hms_
           (lambda ()
             (let* ((sv (dk-di-var!)))
               (ch-ccint-parts! sv 0 1)
               (fact 'rr-sub-in-rr 1 sv)
               (ch-in-ccint! (list '- 1 sv) 0 1 (list '<= 0 sv) (list '<= sv 1))
               (dk-split-all! (list (dk-apply! bs (list '- 1 sv))))
               (for-each (lambda (l) (dk-focus! l)
                           (let ((t0 (caddr (cadr (cadr (dk-goal))))))
                             (ch-pair-in! sv t0 'a 'b)
                             (dk-lam-b!) (nth-r)
                             (if (dk-asm? (dk-goal)) (ass)
                                 (begin (subst (list '= (list phi (list 'LIST (list '- 1 sv) t0)) (list 'pgam t0)))
                                        (if (dk-asm? (dk-goal)) (ass) (begin (subst (list '= (list 'prho t0) (list 'pgam t0))) (rfl)))))))
                         (ch-split-goal!))))))))
(qed 'homotopic-sym)

;;; ---------------------------------------------------------------------------
;;; HOMOTOPY IS TRANSITIVE (3.16): tau(s, t) = phi(2s, t) for 2s <= 1, psi(2s - 1, t) otherwise
(define (ch-abs-parts! x y bnd)               ; (<= (abs (- x y)) bnd) in context: land both linear sides
  (fact 'rr-sub-in-rr x y)
  (if (not (dk-asm? (list '<= (list '- x y) bnd)))
      (dk-split-all! (list (dk-fact! 'rr-abs-le-parts (list '- x y) bnd)))))
(define (ch-abs-le! x y bnd . prems)           ; prove (<= (abs (- x y)) bnd) from linear premises
  (let ((g (list '<= (list 'abs (list '- x y)) bnd)))
    (if (not (dk-asm? g))
        (dk-have! g (lambda ()
                      (fact 'rr-sub-in-rr x y)
                      (dk-have! (list '<= (list '- bnd) (list '- x y)) (lambda () (apply dk-ineq! prems)))
                      (dk-have! (list '<= (list '- x y) bnd) (lambda () (apply dk-ineq! prems)))
                      (fact 'rr-abs-le-of-parts (list '- x y) bnd)
                      (ass))))))
(sp (make-wff (forall-guarded '(u pgam prho pq a b) '((HOMOTOPIC u pgam prho a b) (HOMOTOPIC u prho pq a b))
  '(HOMOTOPIC u pgam pq a b))))
(dk-peel!)
(let* ((phi (ch-unpack! 'u 'pgam 'prho 'a 'b))
       (btp (ch-pick 'bt (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'hmt_) (dk-contains? f phi)))))
       (bsp (ch-pick 'bs (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'hms_) (dk-contains? f phi)))))
       (psi (ch-unpack! 'u 'prho 'pq 'a 'b))
       (btq (ch-pick 'bt (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'hmt_) (dk-contains? f psi)))))
       (bsq (ch-pick 'bs (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'hms_) (dk-contains? f psi)))))
       (R (ch-R 'a 'b))
       (cnd (lambda (z) (list '<= (list '* 2 (list 'NTH 1 z)) 1)))
       (ptl (lambda (z) (list 'LIST (list '* 2 (list 'NTH 1 z)) (list 'NTH 2 z))))
       (ptr (lambda (z) (list 'LIST (list '- (list '* 2 (list 'NTH 1 z)) 1) (list 'NTH 2 z))))
       (tau (list 'VNB-LAMBDA 'chq_ R (list 'IF (cnd 'chq_) (list phi (ptl 'chq_)) (list psi (ptr 'chq_)))))
       (unp (begin (fact 'rect-unif 'a 'b phi) (ch-pick 'up (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'che_) (dk-contains? f phi))))))
       (unq (begin (fact 'rect-unif 'a 'b psi) (ch-pick 'uq (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'che_) (dk-contains? f psi)))))))
  (ch-R-set! 'a 'b)
  (dk-have! '(IN 1 RR)) (dk-have! '(IN 2 RR)) (ch-in-ccint! 1 0 1)
  (fact 'is-path-in-fun 'pgam 'a 'b) (fact 'is-path-in-fun 'prho 'a 'b) (fact 'is-path-in-fun 'pq 'a 'b)
  (for-each (lambda (c) (fact 'fun-apply-type-c c '(CCINT a b) 'CC 'a) (fact 'fun-apply-type-c c '(CCINT a b) 'CC 'b)) '(pgam prho pq))
  ;; z in R: the coordinates and, by the side, the point of phi or psi it goes to; returns (side . point)
  (define (side-pt! z left?)
    (ch-coords! z 'a 'b)
    (ch-ccint-parts! (list 'NTH 1 z) 0 1)
    (let ((s2 (list '* 2 (list 'NTH 1 z))))
      (dk-have! (list 'AND '(IN 2 RR) (list 'IN (list 'NTH 1 z) 'RR))) (fact 'rr-mul-closed 2 (list 'NTH 1 z))
      (if left?
          (begin (ch-in-ccint! s2 0 1 (list '<= 0 (list 'NTH 1 z)) (cnd z))
                 (ch-pair-in! s2 (list 'NTH 2 z) 'a 'b)
                 (ptl z))
          (begin (fact 'rr-sub-in-rr s2 1)
                 (fact 'rr-not-le-lt s2 1)
                 (ch-in-ccint! (list '- s2 1) 0 1 (list '< 1 s2) (list '<= (list 'NTH 1 z) 1))
                 (ch-pair-in! (list '- s2 1) (list 'NTH 2 z) 'a 'b)
                 (ptr z)))))
  (define (tau-val! z left?)                   ; land (= (tau z) (phi pL)) or (= (tau z) (psi pR)); returns the point
    (let* ((p (side-pt! z left?)) (phx (if left? phi psi)))
      (fact 'fun-apply-type-c phx R 'CC p)
      (dk-have! (list '= (list tau z) (list phx p))
        (lambda () (dk-lam-b!) (dk-if-branch! left? (list 'IF (cnd z) (list phi (ptl z)) (list psi (ptr z))) #f (lambda () #t))
                   (if (not (proof-done? *ps*)) (rfl))))
      p))
  (for-each (lambda (cod)
              (dk-have! (list 'IN tau (list 'FUN R cod))
                (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!)))
                                                      (dk-case-if! (list 'IF (cnd z) (list phi (ptl z)) (list psi (ptr z)))
                                                        (lambda (tv val) (let ((p (side-pt! z tv)))
                                                                           (fact 'fun-apply-type-c (if tv phi psi) R cod p)
                                                                           (if (dk-asm? (dk-goal)) (ass)))))))
                                         (lambda () (ass))))))
            '(CC u))
  ;; a uniform-continuity bound between two points p1, p2 of R for the map with clause CL and modulus DX;
  ;; PR1 / PR2: premises for the coordinate differences (after NTH reduction); returns the magnitude bound
  (define (uni! cl dx p1 p2 pr1 pr2)
    (for-each (lambda (k prems)
                (let ((g (list '<= (list 'abs (list '- (list 'NTH k p1) (list 'NTH k p2))) dx)))
                  (if (not (dk-asm? g))
                      (dk-have! g (lambda () (nth-r)
                                    (let* ((g2 (dk-goal)) (df (cadr (cadr g2))))
                                      (apply ch-abs-le! (cadr df) (caddr df) dx prems)))))))
              '(1 2) (list pr1 pr2))
    (inst*! cl p1 p2))
  (define (bnd-at! z)                          ; the boundary values phi([1, t]) = prho t = psi([0, t]) at t = NTH 2 z
    (let ((tz (list 'NTH 2 z)))
      (ch-pair-in! 1 tz 'a 'b) (ch-pair-in! 0 tz 'a 'b)
      (dk-split-all! (list (dk-apply! btp tz))) (dk-split-all! (list (dk-apply! btq tz)))
      (fact 'fun-apply-type-c 'prho '(CCINT a b) 'CC tz)))
  (define (tri! A Cm B e1 e2b)                  ; magnitude(A - B) <= e1 + e2b from the two halves through C
    (fact 'cc-sub-in-cc A Cm) (fact 'cc-sub-in-cc Cm B) (fact 'cc-sub-in-cc A B)
    (dk-have! (list 'AND (list 'IN (list '- A Cm) 'CC) (list 'IN (list '- Cm B) 'CC)))
    (fact 'cc-magnitude-triangle (list '- A Cm) (list '- Cm B))
    (dk-have! (list '= (list '+ (list '- A Cm) (list '- Cm B)) (list '- A B)) (lambda () (crs)))
    (dk-rewrite-h! (list '<= (list 'magnitude (list '+ (list '- A Cm) (list '- Cm B))) (list '+ (list 'magnitude (list '- A Cm)) (list 'magnitude (list '- Cm B))))
                   (list '+ (list '- A Cm) (list '- Cm B)) (list '- A B))
    (for-each (lambda (v) (fact 'cc-magnitude-closed v)) (list (list '- A Cm) (list '- Cm B) (list '- A B))))
  (define (endpoint! x)                        ; (= (pq x) (pgam x))
    (subst (list '= (list 'pq x) (list 'prho x))) (if (dk-asm? (dk-goal)) (ass) (begin (subst (dk-goal)) (rfl))))
  (mac 'homotopic)
  (ch-drive! tau
    (list
     (cons '= (lambda () (endpoint! (cadr (cadr (dk-goal))))))
     (cons 'hmz_
           (lambda ()
             (let* ((ptl (dk-peel!)) (z (cadr (car ptl))))
               (dk-have! (ch-k2 tau z)
                 (lambda ()
                   (let* ((pl2 (dk-peel!)) (e (cadr (car (filter (lambda (f) (dk-head-is? f 'POS-RR)) pl2))))
                          (e2 (dk-halve! e))
                          (dp (dk-skolem! (dk-apply! unp e2) #t))
                          (clp (ch-pick 'clp (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f dp)))))
                          (dq (dk-skolem! (dk-apply! unq e2) #t))
                          (clq (ch-pick 'clq (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f dq)))))
                          (hp (dk-halve! dp)) (hq (dk-halve! dq))
                          (eqp (ch-pick 'eqp (lambda (f) (and (dk-head-is? f '=) (dk-contains? f hp) (dk-contains? f dp)))))
                          (eqq (ch-pick 'eqq (lambda (f) (and (dk-head-is? f '=) (dk-contains? f hq) (dk-contains? f dq)))))
                          (eqe (ch-pick 'eqe (lambda (f) (and (dk-head-is? f '=) (dk-contains? f e2) (dk-contains? f e))))))
                     (for-each dk-pos-parts! (list e e2 dp dq hp hq))
                     (define (finish! d)
                       (ew d)
                       (for-each
                        (lambda (l)
                          (dk-focus! l)
                          (if (dk-asm? (dk-goal)) (ass)
                              (let* ((pl3 (dk-peel!)) (y (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) R))) pl3))))
                                     (sz (list 'NTH 1 z)) (sy (list 'NTH 1 y)) (tz (list 'NTH 2 z)) (ty (list 'NTH 2 y))
                                     (b1 (list '<= (list 'abs (list '- sz sy)) d)) (b2 (list '<= (list 'abs (list '- tz ty)) d)))
                                (ch-coords! z 'a 'b) (ch-coords! y 'a 'b)
                                (ch-abs-parts! sz sy d) (ch-abs-parts! tz ty d)
                                (let* ((ls1 (list (list '<= (list '- sz sy) d) (list '<= (list '- d) (list '- sz sy)) (list '<= d hp) (list '<= d hq) eqp eqq (list '< 0 d)))
                                       (ls2 (list (list '<= (list '- tz ty) d) (list '<= (list '- d) (list '- tz ty)) (list '<= d hp) (list '<= d hq) eqp eqq (list '< 0 d))))
                                  (fact 'fun-apply-type-c tau R 'CC z) (fact 'fun-apply-type-c tau R 'CC y)
                                  (use-em (cnd z)
                                    (lambda ()
                                      (use-em (cnd y)
                                        (lambda ()
                                          (let* ((pz (tau-val! z #t)) (py (tau-val! y #t)))
                                            (subst (list '= (list tau z) (list phi pz))) (subst (list '= (list tau y) (list phi py)))
                                            (fact 'cc-sub-in-cc (list phi pz) (list phi py)) (fact 'cc-magnitude-closed (list '- (list phi pz) (list phi py)))
                                            (let ((rres (uni! clp dp pz py ls1 ls2)))
                                              (dk-ineq! rres eqe (list '< 0 e2)))))
                                        (lambda ()
                                          (let* ((pz (tau-val! z #t)) (py (tau-val! y #f)) (c (list 'prho tz))
                                                 (p1 (list 'LIST 1 tz)) (p0 (list 'LIST 0 tz)))
                                            (fact 'rr-not-le-lt (list '* 2 sy) 1)
                                            (bnd-at! z)
                                            (subst (list '= (list tau z) (list phi pz))) (subst (list '= (list tau y) (list psi py)))
                                            (let* ((r1 (uni! clp dp pz p1 (cons (cnd z) (cons (list '< 1 (list '* 2 sy)) ls1)) ls2))
                                                   (r1b (dk-rewrite-h! r1 (list phi p1) c))
                                                   (r2 (uni! clq dq p0 py (cons (cnd z) (cons (list '< 1 (list '* 2 sy)) ls1)) ls2))
                                                   (r2b (dk-rewrite-h! r2 (list psi p0) c)))
                                              (tri! (list phi pz) c (list psi py) e2 e2)
                                              (dk-ineq! r1b r2b eqe
                                                        (list '<= (list 'magnitude (list '- (list phi pz) (list psi py)))
                                                              (list '+ (list 'magnitude (list '- (list phi pz) c)) (list 'magnitude (list '- c (list psi py)))))))))))
                                    (lambda ()
                                      (fact 'rr-not-le-lt (list '* 2 sz) 1)
                                      (use-em (cnd y)
                                        (lambda ()
                                          (let* ((pz (tau-val! z #f)) (py (tau-val! y #t)) (c (list 'prho ty))
                                                 (q1 (list 'LIST 1 ty)) (q0 (list 'LIST 0 ty)))
                                            (bnd-at! y)
                                            (subst (list '= (list tau z) (list psi pz))) (subst (list '= (list tau y) (list phi py)))
                                            (let* ((r1 (uni! clq dq pz q0 (cons (cnd y) (cons (list '< 1 (list '* 2 sz)) ls1)) ls2))
                                                   (r1b (dk-rewrite-h! r1 (list psi q0) c))
                                                   (r2 (uni! clp dp q1 py (cons (cnd y) (cons (list '< 1 (list '* 2 sz)) ls1)) ls2))
                                                   (r2b (dk-rewrite-h! r2 (list phi q1) c)))
                                              (tri! (list psi pz) c (list phi py) e2 e2)
                                              (dk-ineq! r1b r2b eqe
                                                        (list '<= (list 'magnitude (list '- (list psi pz) (list phi py)))
                                                              (list '+ (list 'magnitude (list '- (list psi pz) c)) (list 'magnitude (list '- c (list phi py)))))))))
                                        (lambda ()
                                          (let* ((pz (tau-val! z #f)) (py (tau-val! y #f)))
                                            (subst (list '= (list tau z) (list psi pz))) (subst (list '= (list tau y) (list psi py)))
                                            (fact 'cc-sub-in-cc (list psi pz) (list psi py)) (fact 'cc-magnitude-closed (list '- (list psi pz) (list psi py)))
                                            (let ((rres (uni! clq dq pz py ls1 ls2)))
                                              (dk-ineq! rres eqe (list '< 0 e2))))))))))))
                        (ch-split-goal!)))
                     (dk-have! (list 'AND (list 'IN hp 'RR) (list 'IN hq 'RR)))
                     (dk-fact! 'rr-leq-total hp hq)
                     (use-cases (list (list '<= hp hq) (list '<= hq hp))
                       (lambda () (dk-have! (list '<= hp hp) (lambda () (dk-ineq!))) (fact 'rr-pos-rr-of-lt hp) (finish! hp))
                       (lambda () (dk-have! (list '<= hq hq) (lambda () (dk-ineq!))) (fact 'rr-pos-rr-of-lt hq) (finish! hq))))))
               (fact 'rect-cont-intro 'a 'b tau z)
               (ass))))
     (cons 'hmt_
           (lambda ()
             (let* ((tv (dk-di-var!)))
               (dk-split-all! (list (dk-apply! btp tv))) (dk-split-all! (list (dk-apply! btq tv)))
               (for-each (lambda (l) (dk-focus! l)
                           (let* ((s0 (cadr (cadr (cadr (dk-goal))))))
                             (ch-pair-in! s0 tv 'a 'b)
                             (dk-lam-b!) (nth-r)
                             (let ((ift (cadr (dk-goal))))
                               (if (eqv? s0 0)
                                   (begin (dk-if-branch! #t ift (lambda () (dk-ineq!)) (lambda () #t))
                                          (dk-have! '(= (* 2 0) 0) (lambda () (crs))) (subst '(= (* 2 0) 0)) (ass))
                                   (begin (dk-have! '(NOT (<= (* 2 1) 1)) (lambda () (di) (dk-absurd! '(<= (* 2 1) 1))))
                                          (dk-if-branch! #f ift #f (lambda () #t))
                                          (dk-have! '(= (- (* 2 1) 1) 1) (lambda () (crs))) (subst '(= (- (* 2 1) 1) 1)) (ass))))))
                         (ch-split-goal!)))))
     (cons 'hms_
           (lambda ()
             (let* ((sv (dk-di-var!)))
               (ch-ccint-parts! sv 0 1)
               (dk-have! (list 'AND '(IN 2 RR) (list 'IN sv 'RR))) (fact 'rr-mul-closed 2 sv)
               (for-each (lambda (l) (dk-focus! l)
                           (let ((t0 (caddr (cadr (cadr (dk-goal))))) (s2 (list '* 2 sv)))
                             (ch-pair-in! sv t0 'a 'b)
                             (dk-lam-b!) (nth-r)
                             (let ((ift (cadr (dk-goal))))
                               (use-em (list '<= s2 1)
                                 (lambda ()
                                   (dk-if-branch! #t ift #f (lambda () #t))
                                   (ch-in-ccint! s2 0 1 (list '<= 0 sv) (list '<= s2 1))
                                   (dk-split-all! (list (dk-apply! bsp s2)))
                                   (ass))
                                 (lambda ()
                                   (dk-if-branch! #f ift #f (lambda () #t))
                                   (fact 'rr-sub-in-rr s2 1) (fact 'rr-not-le-lt s2 1)
                                   (ch-in-ccint! (list '- s2 1) 0 1 (list '< 1 s2) (list '<= sv 1))
                                   (dk-split-all! (list (dk-apply! bsq (list '- s2 1))))
                                   (subst (list '= (list psi (list 'LIST (list '- s2 1) t0)) (list 'prho t0)))
                                   (subst (list '= (list 'prho t0) (list 'pgam t0)))
                                   (rfl))))))
                         (ch-split-goal!))))))))
(qed 'homotopic-trans)

;;; ---------------------------------------------------------------------------
;;; EXAMPLE 3.15 and its four lemmas.  phi(s, t) = gamma(t) + s (rho(t) - gamma(t)).
;;; (1) the difference of two convex-combination values, regrouped
(sp (make-wff (forall-guarded '(chga chra chgb chrb chsa chsb)
  '((IN chga CC) (IN chra CC) (IN chgb CC) (IN chrb CC) (IN chsa RR) (IN chsb RR))
  '(= (- (+ chga (* chsa (- chra chga))) (+ chgb (* chsb (- chrb chgb))))
      (+ (- chga chgb) (+ (* chsb (- (- chra chga) (- chrb chgb))) (* (- chsa chsb) (- chra chga))))))))
(dk-peel!)
(fact 'rr-subset-cc 'chsa) (fact 'rr-subset-cc 'chsb)
(crs)
(qed 'convex-comb-diff)

;;; (2) a scalar in [0, 1] does not increase the modulus
(sp (make-wff (forall-guarded '(chs_ chw_) '((IN chs_ (CCINT 0 1)) (IN chw_ CC))
  '(<= (magnitude (* chs_ chw_)) (magnitude chw_)))))
(dk-peel!)
(ch-ccint-parts! 'chs_ 0 1)
(fact 'rr-subset-cc 'chs_)
(dk-have! '(AND (IN chs_ CC) (IN chw_ CC)))
(fact 'cc-magnitude-mul 'chs_ 'chw_)
(fact 'rr-magnitude-is-abs 'chs_)
(fact 'rr-abs-of-nonneg 'chs_)
(fact 'cc-magnitude-closed 'chw_)
(fact 'cc-magnitude-nonneg 'chw_)
(dk-have! '(IN 1 RR))
(dk-have! '(AND (<= 0 (magnitude chw_)) (<= chs_ 1)))
(fact 'rr-le-scale-nonneg-right 'chs_ 1 '(magnitude chw_))
(subst '(= (magnitude (* chs_ chw_)) (* (magnitude chs_) (magnitude chw_))))
(subst '(= (magnitude chs_) (abs chs_)))
(subst '(= (abs chs_) chs_))
(dk-real! '(* chs_ (magnitude chw_))) (dk-real! '(* 1 (magnitude chw_)))
(dk-ineq! '(<= (* chs_ (magnitude chw_)) (* 1 (magnitude chw_))))
(qed 'cc-unit-scale-le)

;;; (3) the change of a difference is at most the sum of the changes
(sp (make-wff (forall-guarded '(chpa chqa chpb chqb) '((IN chpa CC) (IN chqa CC) (IN chpb CC) (IN chqb CC))
  '(<= (magnitude (- (- chpa chqa) (- chpb chqb))) (+ (magnitude (- chpa chpb)) (magnitude (- chqa chqb)))))))
(dk-peel!)
(fact 'cc-sub-in-cc 'chpa 'chpb) (fact 'cc-sub-in-cc 'chqa 'chqb)
(dk-have! '(= (- (- chpa chqa) (- chpb chqb)) (- (- chpa chpb) (- chqa chqb))) (lambda () (crs)))
(subst '(= (- (- chpa chqa) (- chpb chqb)) (- (- chpa chpb) (- chqa chqb))))
(fact 'cc-magnitude-sub-triangle '(- chpa chpb) '(- chqa chqb))
(ass)
(qed 'cc-diff-change-le)

;;; (4) a fixed complex number times a small real is small
(sp (make-wff (forall-guarded '(chw_) '((IN chw_ CC))
  '(FORALL che_ (IMPLIES (POS-RR che_) (FORSOME chd_ (AND (POS-RR chd_)
     (FORALL chc_ (IMPLIES (IN chc_ RR) (IMPLIES (<= (abs chc_) chd_) (<= (magnitude (* chc_ chw_)) che_)))))))))))
(dk-peel!)
(dk-pos-parts! 'che_)
(let* ((K '(magnitude chw_)) (K1 (list '+ K 1)) (rk (list 'recip K1)) (dt (list '* 'che_ rk)))
  (fact 'cc-magnitude-closed 'chw_) (fact 'cc-magnitude-nonneg 'chw_)
  (dk-have! '(IN 1 RR)) (dk-real! K1)
  (dk-have! (list '< 0 K1) (lambda () (dk-ineq! (list '<= 0 K))))
  (fact 'rr-pos-ne-zero K1)
  (fact 'rr-recip-pos K1)
  (dk-have! (list 'AND (list 'IN K1 'RR) (list 'NOT (list '= K1 0))))
  (fact 'rr-recip-closed K1)
  (dk-real! dt)
  (fact 'rr-mul-pos 'che_ rk)
  (fact 'rr-recip-cancel-right 'che_ K1)
  (let ((v (dk-name! dt)))
    (dk-rewrite-h! (list '< 0 dt) dt v)
    (dk-rewrite-h! (list '= 'che_ (list '* dt K1)) dt v)
    (fact 'rr-pos-rr-of-lt v)
    (ew v)
    (for-each
      (lambda (l) (dk-focus! l)
        (if (dk-asm? (dk-goal)) (ass)
            (let* ((pl (dk-peel!)) (c (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) pl)))) (ac (list 'abs c)))
              (fact 'rr-abs-closed c)
              (fact 'rr-subset-cc c)
              (dk-have! (list 'AND (list 'IN c 'CC) '(IN chw_ CC)))
              (fact 'cc-magnitude-mul c 'chw_)
              (fact 'rr-magnitude-is-abs c)
              (dk-have! (list 'AND (list '<= 0 K) (list '<= ac v)))
              (fact 'rr-le-scale-nonneg-right ac v K)
              (dk-real! (list '* ac K)) (dk-real! (list '* v K)) (dk-real! (list '* v K1))
              (dk-have! (list '= (list '* v K1) (list '+ (list '* v K) v)) (lambda () (crs)))
              (subst (list '= (list 'magnitude (list '* c 'chw_)) (list '* (list 'magnitude c) K)))
              (subst (list '= (list 'magnitude c) ac))
              (dk-ineq! (list '<= (list '* ac K) (list '* v K)) (list '= (list '* v K1) (list '+ (list '* v K) v))
                        (list '= 'che_ (list '* v K1)) (list '< 0 v)))))
      (ch-split-goal!))))
(qed 'cc-scale-small)

;;; EXAMPLE 3.15: a good approximation is homotopic, by the straight-line homotopy
(define ch-phi-ga (list 'VNB-LAMBDA 'chq_ (ch-R 'a 'b) '(+ (pgam (NTH 2 chq_)) (* (NTH 1 chq_) (- (prho (NTH 2 chq_)) (pgam (NTH 2 chq_)))))))
(define (ch-cc! t)                             ; type a CC expression built from typed atoms by + - *
  (let ((ty (list 'IN t 'CC)))
    (cond ((dk-asm? ty) ty)
          ((dk-asm? (list 'IN t 'RR)) (fact 'rr-subset-cc t) ty)
          ((and (pair? t) (memq (car t) '(+ - *)) (= (length t) 3))
           (ch-cc! (cadr t)) (ch-cc! (caddr t))
           (if (eq? (car t) '-) (fact 'cc-sub-in-cc (cadr t) (caddr t))
               (begin (dk-have! (list 'AND (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)))
                      (fact (if (eq? (car t) '+) 'cc-add-closed 'cc-mul-closed) (cadr t) (caddr t))))
           ty)
          (#t (error "ch-cc!: cannot type" t)))))
(sp (make-wff (forall-guarded '(u pgam prho a b) '((GOOD-APPROX u pgam prho a b)) '(HOMOTOPIC u pgam prho a b))))
(dk-peel!)
(let* ((rhs (caddr (dk-cite! 'good-approx 'u 'pgam 'prho 'a 'b))))
  (dk-project! rhs 'good-approx '(GOOD-APPROX u pgam prho a b))
  (dk-split-all! (list rhs))
  (let* ((n (dk-skolem! (ch-pick 'en (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z 'hmn_)))) #t))
         (_s1 (dk-split-all!))
         (tq (dk-skolem! (ch-pick 'et (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z 'hmt_)))) #t))
         (_s2 (dk-split-all!))
         (bs (dk-skolem! (ch-pick 'eb (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z 'hmd_)))) #t))
         (_s3 (dk-split-all!))
         (pk (ch-pick 'pk (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'hmw_)))))
         (R (ch-R 'a 'b)) (ph ch-phi-ga))
    (fact 'is-path-endpoints 'pgam 'a 'b) (dk-split-all!)
    (fact 'is-path-in-fun 'pgam 'a 'b) (fact 'is-path-in-fun 'prho 'a 'b)
    (ch-rect-basics! 'a 'b) (ch-R-set! 'a 'b)
    (dk-have! '(IN 0 RR)) (dk-have! '(IN 1 RR))
    (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
    (ch-in-ccint! 'a 'a 'b '(< a b)) (ch-in-ccint! 'b 'a 'b '(< a b))
    (ch-in-ccint! 0 0 1 '(< 0 1)) (ch-in-ccint! 1 0 1 '(< 0 1))
    ;; the pieces: every t in [a, b] lies on a piece k < n
    (let* ((q (dk-skolem! (dk-fact! 'nn-pos-is-succ n) #t))
           (_s4 (dk-split-all!))
           (sq (list 'succ q)))
      (fact 'nn-in-rr q) (fact 'nn-in-rr n) (fact 'nn-succ-plus-one q) (fact 'nn-succ-closed q) (fact 'nn-in-rr sq)
      (dk-have! (list '< q n) (lambda () (dk-ineq! (list '= n sq) (list '= sq (list '+ q 1)))))
      (dk-have! (subst-free 'tq tq (subst-free 'n n ch-inc))
        (lambda () (let ((j (dk-di-var!))) (di) (dk-split-all! (list (dk-apply! pk j))) (ass))))
      (let* ((l1 (dk-fact! 'poly-piece-locate q n tq))
             (l2 (dk-rewrite-h! l1 (list tq 0) 'a))
             (l3 (dk-rewrite-h! l2 sq n))
             (loc (dk-rewrite-h! l3 (list tq n) 'b)))
        (define (piece! t)                     ; t in [a, b]: lands gamma(t), rho(t) in bs(k), bs(k) convex, inside u
          (let* ((k (dk-skolem! (inst*! loc t) #t)))
            (dk-split-all!)
            (fact 'nn-in-rr k)
            (dk-have! (list '< k n) (lambda () (dk-ineq! (list '<= k q) (list '= n sq) (list '= sq (list '+ q 1)))))
            (dk-split-all! (list (dk-apply! pk k)))
            (let ((pw (ch-pick 'pw (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'hmw_) (dk-contains? f (list bs k)))))))
              (dk-split-all! (list (dk-apply! pw t))))
            k))
        (define (val-of z) (let ((t (list 'NTH 2 z)) (s (list 'NTH 1 z)))
                             (list '+ (list 'pgam t) (list '* s (list '- (list 'prho t) (list 'pgam t))))))
        (define (typed! z)
          (ch-coords! z 'a 'b)
          (fact 'fun-apply-type-c 'pgam '(CCINT a b) 'CC (list 'NTH 2 z))
          (fact 'fun-apply-type-c 'prho '(CCINT a b) 'CC (list 'NTH 2 z))
          (ch-cc! (val-of z)))
        (define (val! z)
          (typed! z)
          (let ((g (list '= (list ph z) (val-of z))))
            (if (not (dk-asm? g)) (dk-have! g (lambda () (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl)))))))
        (for-each (lambda (cod)
                    (dk-have! (list 'IN ph (list 'FUN R cod))
                      (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!)))
                                                            (typed! z)
                                                            (if (eq? cod 'u)
                                                                (let* ((t (list 'NTH 2 z)) (k (piece! t)) (bk (list bs k)))
                                                                  (mac-h 'IS-CONVEX-CC (list 'IS-CONVEX-CC bk))
                                                                  (dk-split-all!)
                                                                  (let ((cu (ch-pick 'cu (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'cvt_) (dk-contains? f bk))))))
                                                                    (inst*! cu (list 'pgam t) (list 'prho t) (list 'NTH 1 z))
                                                                    (fact 'subset-mem-fwd bk 'u (val-of z)))))
                                                            (ass)))
                                               (lambda () (ass))))))
                  '(CC u))
        (let* ((ucg (dk-fact! 'path-uniformly-continuous 'pgam 'a 'b))
              (ucr (dk-fact! 'path-uniformly-continuous 'prho 'a 'b)))
          (mac 'homotopic)
          (ch-drive! ph
            (list
             (cons 'hmz_
                   (lambda ()
                     (let* ((pl (dk-peel!)) (z (cadr (car pl))))
                       (dk-have! (ch-k2 ph z)
                         (lambda ()
                           (let* ((pl2 (dk-peel!)) (e (cadr (car (filter (lambda (f) (dk-head-is? f 'POS-RR)) pl2))))
                                  (_p0 (dk-pos-parts! e))
                                  (e2 (dk-halve! e)) (_p1 (dk-pos-parts! e2))
                                  (e4 (dk-halve! e2)) (_p2 (dk-pos-parts! e4))
                                  (q1 (ch-pick 'q1 (lambda (f) (and (dk-head-is? f '=) (dk-contains? f e) (dk-contains? f e2)))))
                                  (q2 (ch-pick 'q2 (lambda (f) (and (dk-head-is? f '=) (dk-contains? f e2) (dk-contains? f e4)))))
                                  (t0 (list 'NTH 2 z)) (s0 (list 'NTH 1 z))
                                  (g0 (list 'pgam t0)) (r0 (list 'prho t0)) (d0 (list '- r0 g0))
                                  (_t (begin (typed! z) (ch-cc! d0)))
                                  (dg (dk-skolem! (dk-apply! ucg e4) #t))
                                  (clg (ch-pick 'clg (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f dg)))))
                                  (dr (dk-skolem! (dk-apply! ucr e4) #t))
                                  (clr (ch-pick 'clr (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f dr)))))
                                  (ds (dk-skolem! (dk-apply! (dk-fact! 'cc-scale-small d0) e4) #t))
                                  (cls (ch-pick 'cls (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ds)))))
                                  (_p3 (begin (dk-pos-parts! dg) (dk-pos-parts! dr) (dk-pos-parts! ds)))
                                  (w1 (dk-skolem! (dk-fact! 'rr-min-pos dg dr) #t))
                                  (_s5 (dk-split-all!))
                                  (w2 (dk-skolem! (dk-fact! 'rr-min-pos w1 ds) #t))
                                  (_s6 (dk-split-all!)))
                             (fact 'rr-pos-rr-of-lt w2)
                             (ew w2)
                             (for-each
                               (lambda (l) (dk-focus! l)
                                 (if (dk-asm? (dk-goal)) (ass)
                                     (let* ((pl3 (dk-peel!))
                                            (y (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) R))) pl3))))
                                            (t1 (list 'NTH 2 y)) (s1 (list 'NTH 1 y))
                                            (g1 (list 'pgam t1)) (r1 (list 'prho t1))
                                            (A (list '- g0 g1)) (Bw (list '- d0 (list '- r1 g1))) (B (list '* s1 Bw))
                                            (cdf (list '- s0 s1)) (C (list '* cdf d0)) (BC (list '+ B C)) (ABC (list '+ A BC))
                                            (mg (lambda (x) (list 'magnitude x))))
                                       (val! z) (val! y)
                                       (subst (list '= (list ph z) (val-of z)))
                                       (subst (list '= (list ph y) (val-of y)))
                                       (dk-fact! 'convex-comb-diff g0 r0 g1 r1 s0 s1)
                                       (subst (list '= (list '- (val-of z) (val-of y)) ABC))
                                       (for-each ch-cc! (list A Bw B C BC ABC (list '- r0 r1)))
                                       (fact 'rr-sub-in-rr s0 s1) (fact 'rr-sub-in-rr t0 t1)
                                       (for-each (lambda (x) (fact 'cc-magnitude-closed x)) (list A Bw B C BC ABC (list '- r0 r1)))
                                       (fact 'rr-abs-closed (list '- t0 t1)) (fact 'rr-abs-closed cdf)
                                       (let ((at (list '<= (list 'abs (list '- t0 t1)) w2)))
                                         (dk-have! (list '<= (list 'abs (list '- t0 t1)) dg) (lambda () (dk-ineq! at (list '<= w2 w1) (list '<= w1 dg))))
                                         (dk-have! (list '<= (list 'abs (list '- t0 t1)) dr) (lambda () (dk-ineq! at (list '<= w2 w1) (list '<= w1 dr)))))
                                       (dk-have! (list '<= (list 'abs cdf) ds) (lambda () (dk-ineq! (list '<= (list 'abs cdf) w2) (list '<= w2 ds))))
                                       (inst*! clg t0 t1) (inst*! clr t0 t1) (inst*! cls cdf)
                                       (fact 'cc-unit-scale-le s1 Bw)
                                       (fact 'cc-diff-change-le r0 g0 r1 g1)
                                       (fact 'cc-magnitude-triangle B C)
                                       (dk-have! (list 'AND (list 'IN A 'CC) (list 'IN BC 'CC)))
                                       (fact 'cc-magnitude-triangle A BC)
                                       (dk-ineq! (list '<= (mg ABC) (list '+ (mg A) (mg BC)))
                                                 (list '<= (mg BC) (list '+ (mg B) (mg C)))
                                                 (list '<= (mg B) (mg Bw))
                                                 (list '<= (mg Bw) (list '+ (mg (list '- r0 r1)) (mg A)))
                                                 (list '<= (mg A) e4) (list '<= (mg (list '- r0 r1)) e4) (list '<= (mg C) e4)
                                                 q1 q2))))
                               (ch-split-goal!)))))
                       (fact 'rect-cont-intro 'a 'b ph z)
                       (ass))))
             (cons 'hmt_
                   (lambda ()
                     (let* ((tv (dk-di-var!)))
                       (fact 'fun-apply-type-c 'pgam '(CCINT a b) 'CC tv) (fact 'fun-apply-type-c 'prho '(CCINT a b) 'CC tv)
                       (for-each (lambda (l) (dk-focus! l)
                                   (let ((sv (cadr (cadr (cadr (dk-goal))))))
                                     (ch-pair-in! sv tv 'a 'b)
                                     (dk-lam-b!) (nth-r)
                                     (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass) (crs)))))
                                 (ch-split-goal!)))))
             (cons 'hms_
                   (lambda ()
                     (let* ((sv (dk-di-var!)))
                       (ch-ccint-parts! sv 0 1) (fact 'rr-subset-cc sv)
                       (for-each (lambda (e) (fact 'fun-apply-type-c 'pgam '(CCINT a b) 'CC e) (fact 'fun-apply-type-c 'prho '(CCINT a b) 'CC e)) '(a b))
                       (for-each (lambda (l) (dk-focus! l)
                                   (let ((t0 (caddr (cadr (cadr (dk-goal))))))
                                     (ch-pair-in! sv t0 'a 'b)
                                     (dk-lam-b!) (nth-r)
                                     (if (not (proof-done? *ps*))
                                         (begin (subst (list '= (list 'prho t0) (list 'pgam t0))) (crs)))))
                                 (ch-split-goal!))))))))))))
(qed 'good-approx-homotopic)

;;; ---------------------------------------------------------------------------
;;; THE BALL FORM of good-approx-polygon: the k-th piece of the curve and the next node lie in the ball
;;; B(x_k, eps), which lies in u
(define ch-ra-pks
  '(FORALL hmk_ (IMPLIES (IN hmk_ NN) (IMPLIES (< hmk_ (succ m))
     (AND (< (tq hmk_) (tq (succ hmk_)))
     (AND (SUBSET (BALL CC-MS (xq hmk_) eps) u)
     (AND (IN (xq (succ hmk_)) (BALL CC-MS (xq hmk_) eps))
          (FORALL hmw_ (IMPLIES (IN hmw_ (CCINT (tq hmk_) (tq (succ hmk_)))) (IN (pgam hmw_) (BALL CC-MS (xq hmk_) eps)))))))))))
(sp (make-wff (forall-guarded '(u pgam a b m tq xq eps)
  (list '(IS-PATH pgam a b) '(SUBSET (TRACE pgam a b) u) '(IN m NN) '(IN tq (FUN NN RR)) '(IN xq (FUN NN CC))
        '(= (tq 0) a) '(= (tq (succ m)) b) '(= (xq 0) (pgam a)) '(= (xq (succ m)) (pgam b)) '(POS-RR eps) ch-ra-pks)
  '(AND (IS-ROAD (POLY-ROAD tq xq m) (POLY-DER tq xq m) a b) (GOOD-APPROX u pgam (POLY-ROAD tq xq m) a b)))))
(dk-peel!)
(let* ((BS '(VNB-LAMBDA chk_ NN (BALL CC-MS (xq chk_) eps)))
       (ra (ch-pick 'ra (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'hmw_))))))
  (dk-pos-parts! 'eps)
  (fact 'cc-is-metric-space) (fact 'cc-ms@pts) (fact 'nn-is-set)
  (dk-have! (list 'IN BS '(FUN NN (POWER CC)))
    (lambda () (dk-lam-type! (lambda () (let* ((k (dk-di-var!)) (B (list 'BALL 'CC-MS (list 'xq k) 'eps)))
                                          (fact 'ball-is-set 'CC-MS (list 'xq k) 'eps)
                                          (mac 'power-set-membership)
                                          (for-each (lambda (l) (dk-focus! l)
                                                      (if (dk-asm? (dk-goal)) (ass)
                                                          (let* ((pl (dk-peel!)) (z (cadr (car pl))) (bi (dk-cite! 'ball-membership 'CC-MS (list 'xq k) 'eps z)))
                                                            (dk-have! (list 'IN z '(PTS CC-MS)) (lambda () (if (dk-only! bi (list 'IN z B)) (prop))))
                                                            (subst '(= CC (PTS CC-MS))) (ass))))
                                                    (ch-split-goal!))))
                             (lambda () (ass)))))
  (let ((pks (subst-free 'bs BS (ch-pks '(succ m)))))
    (dk-have! pks
      (lambda ()
        (let* ((pl (dk-peel!)) (k (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) pl))))
               (c (list 'xq k)) (B (list 'BALL 'CC-MS c 'eps)))
          (dk-split-all! (list (dk-apply! ra k)))
          (fact 'fun-apply-type-c 'xq 'NN 'CC k)
          (fact 'cc-ms-ball-centre c 'eps)
          (dk-have! (list 'IN c '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
          (dk-have! (list 'AND (list 'IN 'eps 'RR) (list 'AND (list '<= 0 'eps) (list 'NOT (list '= 0 'eps)))))
          (fact 'ball-is-open 'CC-MS c 'eps)
          (let ((biff (dk-cite! 'cc-ms-open-iff B)))
            (dk-have! (list 'IS-OPEN '(NF-METRIC-SPACE CC-NORMED-FIELD) B) (lambda () (if (dk-only! biff (list 'IS-OPEN 'CC-MS B)) (prop)))))
          (fact 'cc-ball-is-convex c 'eps)
          (for-each (lambda (l) (dk-focus! l)
                      (if (dk-contains? (dk-goal) BS) (dk-lam-b!))
                      (if (dk-asm? (dk-goal)) (ass)
                          (if (dk-head-is? (dk-goal) 'FORALL)
                              (let ((w (dk-di-var!)))
                                (inst*! (ch-pick 'pw (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'hmw_) (dk-contains? f 'pgam) (dk-contains? f c)))) w)
                                (ass))
                              (if (dk-asm? (dk-goal)) (ass)))))
                    (ch-split-goal!)))))
    (dk-fact! 'good-approx-polygon 'u 'pgam 'a 'b 'm 'tq 'xq BS)
    (ass)))
(qed 'good-approx-balls)

;;; ---------------------------------------------------------------------------
;;; the ball form of the trace hypothesis of poly-trace-in
(define ch-bks
  '(FORALL hmk_ (IMPLIES (IN hmk_ NN) (IMPLIES (< hmk_ (succ m))
     (AND (< (tq hmk_) (tq (succ hmk_)))
     (AND (SUBSET (BALL CC-MS (xq hmk_) eps) u)
          (IN (xq (succ hmk_)) (BALL CC-MS (xq hmk_) eps))))))))
;;; PROPOSITION 3.17: homotopic curves are joined by a finite chain of polygonal roads, each a good
;;; approximation of the next; the first approximates pgam, the last prho.  sigma_j is the polygon
;;; through the grid points phi(s_j, t_k) of the homotopy, s_j = j hs, t_k = a + k ht.
(define (ch-sig j) (list 'POLY-ROAD 'chtq_ (list 'chxq_ j) 'chm_))
(define (ch-sigd j) (list 'POLY-DER 'chtq_ (list 'chxq_ j) 'chm_))
(define ch-317-body
  (list 'AND (list 'FORALL 'chj_ (list 'IMPLIES '(IN chj_ NN) (list 'IMPLIES '(<= chj_ (succ chn_)) (list 'IS-ROAD (ch-sig 'chj_) (ch-sigd 'chj_) 'a 'b))))
   (list 'AND (list 'GOOD-APPROX 'u 'pgam (ch-sig 0) 'a 'b)
   (list 'AND (list 'FORALL 'chj_ (list 'IMPLIES '(IN chj_ NN) (list 'IMPLIES '(<= chj_ chn_) (list 'GOOD-APPROX 'u (ch-sig 'chj_) (ch-sig '(succ chj_)) 'a 'b))))
              (list 'GOOD-APPROX 'u 'prho (ch-sig '(succ chn_)) 'a 'b)))))
(define ch-317-concl
  (list 'FORSOME 'chm_ (list 'AND '(IN chm_ NN) (list 'FORSOME 'chn_ (list 'AND '(IN chn_ NN)
    (list 'FORSOME 'chtq_ (list 'AND '(IN chtq_ (FUN NN RR)) (list 'FORSOME 'chxq_ (list 'AND '(IN chxq_ (FUN NN (FUN NN CC))) ch-317-body)))))))))
(sp (make-wff (forall-guarded '(u pgam prho a b) '((IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u) (HOMOTOPIC u pgam prho a b))
  ch-317-concl)))
(dk-peel!)
(let* ((phi (ch-unpack! 'u 'pgam 'prho 'a 'b))
       (bt (ch-pick 'bt (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'hmt_) (dk-contains? f phi)))))
       (bsv (ch-pick 'bs (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'hms_) (dk-contains? f phi)))))
       (ca (ch-pick 'ca (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'hmz_) (dk-contains? f phi)))))
       (R (ch-R 'a 'b)) (Q (ch-Q 'a 'b)) (S1 (ch-S 0 1)) (S2 (ch-S 'a 'b))
       (I (list 'IMAGE phi (list 'PTS Q))))
  (ch-R-set! 'a 'b)
  (dk-have! '(IN 1 RR)) (dk-have! '(IN 2 RR)) (ch-in-ccint! 1 0 1)
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (fact 'is-path-in-fun 'pgam 'a 'b) (fact 'is-path-in-fun 'prho 'a 'b)
  ;; the compact image of the homotopy, inside u, and its margin
  (fact 'heine-borel-ccint 0 1) (fact 'heine-borel-ccint 'a 'b)
  (fact 'product2-compact S1 S2)
  (dk-have! (list 'IS-CONTINUOUS Q 'CC-MS phi)
    (lambda ()
      (mac 'is-continuous)
      (for-each (lambda (l) (dk-focus! l)
                  (cond ((dk-asm? (dk-goal)) (ass))
                        ((dk-head-is? (dk-goal) 'IN) (subst (list '= (list 'PTS Q) R)) (subst '(= (PTS CC-MS) CC)) (ass))
                        (#t (let ((x (dk-di-var!)))
                              (dk-have! (list 'IN x R) (lambda () (subst (list '= R (list 'PTS Q))) (ass)))
                              (inst*! ca x) (ass)))))
                (ch-split-goal!))))
  (fact 'compact-image Q 'CC-MS phi)
  (dk-have! (list 'SUBSET I 'u)
    (lambda ()
      (mac 'subset-def)
      (let* ((pl (dk-peel!)) (z (cadr (car pl))) (iff (dk-cite! 'image-membership-iff phi (list 'PTS Q) z)))
        (dk-have! (caddr iff) (lambda () (prop)))
        (dk-split! (caddr iff))
        (let ((x (dk-skolem! (ch-pick 'ex (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f z)))) #t)))
          (dk-have! (list 'IN x R) (lambda () (subst (list '= R (list 'PTS Q))) (ass)))
          (fact 'fun-apply-type-c phi R 'u x)
          (subst (list '= z (list phi x)))
          (ass)))))
  (let ((oiff (dk-cite! 'cc-ms-open-iff 'u)))
    (dk-have! '(IS-OPEN CC-MS u) (lambda () (if (dk-only! oiff '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u)) (prop)))))
  (let* ((eps (dk-skolem! (dk-fact! 'compact-open-margin I 'u) #t))
         (mg (ch-pick 'mg (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f eps) (dk-contains? f 'BALL)))))
         (e2 (dk-halve! eps))
         (eqe (ch-pick 'eqe (lambda (f) (and (dk-head-is? f '=) (dk-contains? f e2) (dk-contains? f eps)))))
         (_p (begin (dk-pos-parts! eps) (dk-pos-parts! e2)))
         (dl (dk-skolem! (dk-apply! (dk-fact! 'rect-unif 'a 'b phi) e2) #t))
         (cl (ch-pick 'cl (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f dl)))))
         (_q (dk-pos-parts! dl))
         (N (dk-skolem! (dk-fact! 'uniform-grid 0 1 dl) #t))
         (_s1 (dk-split-all!))
         (hs (dk-skolem! (ch-pick 'eh (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'cph_) (dk-contains? f 1)))) #t))
         (_s2 (dk-split-all!))
         (gs (ch-pick 'gs (lambda (f) (and (dk-head-is? f '=) (dk-contains? f hs) (dk-contains? f (list '+ N 1))))))
         (M (dk-skolem! (dk-fact! 'uniform-grid 'a 'b dl) #t))
         (_s3 (dk-split-all!))
         (ht (dk-skolem! (ch-pick 'eh2 (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'cph_) (dk-contains? f 'b)))) #t))
         (_s4 (dk-split-all!))
         (gt (ch-pick 'gt (lambda (f) (and (dk-head-is? f '=) (dk-contains? f ht) (dk-contains? f (list '+ M 1))))))
         (sN (list 'succ N)) (sM (list 'succ M))
         (TQ (list 'VNB-LAMBDA 'chk_ 'NN (list '+ 'a (list '* 'chk_ ht))))
         (cnd (lambda (j k) (list 'AND (list '<= j sN) (list '<= k sM))))
         (chmX (list 'VNB-LAMBDA 'chi_ 'NN (list 'VNB-LAMBDA 'chk_ 'NN
              (list 'IF (cnd 'chi_ 'chk_) (list phi (list 'LIST (list '* 'chi_ hs) (list '+ 'a (list '* 'chk_ ht)))) 0))))
         (sj (lambda (j) (list '* j hs)))
         (tk (lambda (k) (list '+ 'a (list '* k ht))))
         (P (lambda (j k) (list 'LIST (sj j) (tk k)))))
    (fact 'nn-succ-plus-one N) (fact 'nn-succ-plus-one M)
    (fact 'nn-succ-closed N) (fact 'nn-succ-closed M)
    (fact 'nn-in-rr N) (fact 'nn-in-rr M) (fact 'nn-in-rr sN) (fact 'nn-in-rr sM)
    (dk-have! '(IN 0 NN)) (fact 'nn-in-rr 0)
    (dk-have! (list 'AND (list 'IN N 'RR) '(IN 1 RR))) (fact 'rr-add-closed N 1)
    (dk-have! (list 'AND (list 'IN M 'RR) '(IN 1 RR))) (fact 'rr-add-closed M 1)
    (dk-pos-parts! hs) (dk-pos-parts! ht)
    ;; grid coordinates: typed, and in [0, 1] / [a, b] for j <= N + 1, k <= M + 1
    (define (rmul! x y) (if (not (dk-asm? (list 'IN (list '* x y) 'RR))) (begin (dk-have! (list 'AND (list 'IN x 'RR) (list 'IN y 'RR))) (fact 'rr-mul-closed x y))))
    (define (s-in! j)                          ; j <= sN in context
      (fact 'nn-in-rr j) (rmul! j hs)
      (if (not (dk-asm? (list 'IN (sj j) '(CCINT 0 1))))
          (begin
            (dk-have! (list '<= j (list '+ N 1)) (lambda () (dk-ineq! (list '<= j sN) (list '= sN (list '+ N 1)))))
            (dk-have! (list '<= 0 j) (lambda () (dk-nn!)))
            (dk-have! (list 'AND (list '<= 0 j) (list '<= 0 hs))) (fact 'rr-leq-mul-nonneg j hs)
            (rmul! (list '+ N 1) hs)
            (dk-have! (list 'AND (list '<= 0 hs) (list '<= j (list '+ N 1)))) (fact 'rr-le-scale-nonneg-right j (list '+ N 1) hs)
            (ch-in-ccint! (sj j) 0 1 (list '<= 0 (sj j)) (list '<= (sj j) (list '* (list '+ N 1) hs)) gs))))
    (define (t-in! k)                          ; k <= sM in context
      (fact 'nn-in-rr k) (rmul! k ht)
      (if (not (dk-asm? (list 'IN (tk k) 'RR))) (begin (dk-have! (list 'AND '(IN a RR) (list 'IN (list '* k ht) 'RR))) (fact 'rr-add-closed 'a (list '* k ht))))
      (if (not (dk-asm? (list 'IN (tk k) '(CCINT a b))))
          (begin
            (dk-have! (list '<= k (list '+ M 1)) (lambda () (dk-ineq! (list '<= k sM) (list '= sM (list '+ M 1)))))
            (dk-have! (list '<= 0 k) (lambda () (dk-nn!)))
            (dk-have! (list 'AND (list '<= 0 k) (list '<= 0 ht))) (fact 'rr-leq-mul-nonneg k ht)
            (rmul! (list '+ M 1) ht)
            (dk-have! (list 'AND (list '<= 0 ht) (list '<= k (list '+ M 1)))) (fact 'rr-le-scale-nonneg-right k (list '+ M 1) ht)
            (ch-in-ccint! (tk k) 'a 'b (list '<= 0 (list '* k ht)) (list '<= (list '* k ht) (list '* (list '+ M 1) ht)) gt))))
    (define (P-in! j k) (s-in! j) (t-in! k) (ch-pair-in! (sj j) (tk k) 'a 'b) (fact 'fun-apply-type-c phi R 'CC (P j k)) (P j k))
    ;; node values
    (define (xval! j k)                        ; j <= sN, k <= sM: (= ((X j) k) (phi P(j, k)))
      (let ((pp (P-in! j k)) (g (list '= (list (list chmX j) k) (list phi (P j k)))))
        (if (not (dk-asm? g))
            (dk-have! g (lambda ()
                          (dk-have! (cnd j k))
                          (dk-lam-b!)
                          (dk-if-branch! #t (list 'IF (cnd j k) (list phi (P j k)) 0) #f (lambda () #t))
                          (if (not (proof-done? *ps*)) (rfl)))))
        pp))
    (define (tval! k)
      (t-in! k)
      (let ((g (list '= (list TQ k) (tk k))))
        (if (not (dk-asm? g)) (dk-have! g (lambda () (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl)))))))
    ;; phi(p1) is in the eps-ball about phi(p0), when the coordinates differ by at most dl
    (define (near! p0 p1 pr1 pr2)
      (for-each (lambda (k prems)
                  (let ((g (list '<= (list 'abs (list '- (list 'NTH k p1) (list 'NTH k p0))) dl)))
                    (if (not (dk-asm? g))
                        (dk-have! g (lambda () (nth-r)
                                      (let* ((g2 (dk-goal)) (df (cadr (cadr g2))))
                                        (apply ch-abs-le! (cadr df) (caddr df) dl prems)))))))
                '(1 2) (list pr1 pr2))
      (let* ((m1 (inst*! cl p1 p0)) (A (list phi p1)) (ctr (list phi p0)) (B (list 'BALL 'CC-MS ctr eps)))
        (fact 'cc-sub-in-cc A ctr) (fact 'cc-magnitude-closed (list '- A ctr))
        (let ((bi (dk-cite! 'cc-ms-ball-membership ctr eps A)))
          (dk-have! (list '< (list 'magnitude (list '- A ctr)) eps) (lambda () (dk-ineq! m1 eqe (list '< 0 e2))))
          (dk-have! (list 'IN A B) (lambda () (if (dk-only! bi (list 'IN A 'CC) (list '< (list 'magnitude (list '- A ctr)) eps)) (prop)))))))
    ;; the ball about a grid value lies in u
    (define (ball-in-u! pb)
      (let ((iff (dk-cite! 'image-membership-iff phi (list 'PTS Q) (list phi pb))))
        (fact 'membership-implies-sethood (list phi pb) 'CC)
        (dk-have! (list 'IN pb (list 'PTS Q)) (lambda () (subst (list '= (list 'PTS Q) R)) (ass)))
        (dk-have! (list 'IN (list phi pb) I)
          (lambda () (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew pb) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))))))))) (prop)))
        (dk-apply! mg (list phi pb))))
    ;; types of the families
    (fact 'nn-is-set)
    (dk-have! (list 'IN TQ '(FUN NN RR)) (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (fact 'nn-in-rr k) (rmul! k ht) (dk-have! (list 'AND '(IN a RR) (list 'IN (list '* k ht) 'RR))) (fact 'rr-add-closed 'a (list '* k ht)) (ass))) (lambda () (ass)))))
    (dk-have! '(IN 0 CC) (lambda () (fact 'rr-subset-cc 0) (ass)))
    (dk-have! (list 'IN chmX '(FUN NN (FUN NN CC)))
      (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                                            (dk-lam-type! (lambda () (let ((k (dk-di-var!)))
                                                                      (dk-case-if! (list 'IF (cnd j k) (list phi (P j k)) 0)
                                                                        (lambda (tv val) (if tv (begin (dk-split-all!) (P-in! j k) (if (dk-asm? (dk-goal)) (ass)))
                                                                                             (if (dk-asm? (dk-goal)) (ass)))))))
                                                          (lambda () (ass)))))
                               (lambda () (ass)))))
    (define (xq-typed! j) (fact 'fun-apply-type-c chmX 'NN '(FUN NN CC) j))
    (define (sig j) (list 'POLY-ROAD TQ (list chmX j) M))
    (define (sigd j) (list 'POLY-DER TQ (list chmX j) M))
    (dk-have! (list '<= 0 sM) (lambda () (dk-nn!))) (dk-have! (list '<= sM sM) (lambda () (dk-nn!)))
    (dk-have! (list '<= 0 sN) (lambda () (dk-nn!))) (dk-have! (list '<= sN sN) (lambda () (dk-nn!)))
    (dk-have! (list '<= M sM) (lambda () (dk-nn!)))
    (tval! 0) (tval! sM)
    (dk-have! (list '= (list TQ 0) 'a) (lambda () (subst (list '= (list TQ 0) (tk 0))) (crs)))
    (dk-have! (list '= (list TQ sM) 'b)
      (lambda () (subst (list '= (list TQ sM) (tk sM))) (subst (list '= sM (list '+ M 1))) (ass)))
    (dk-have! (list '= (tk 0) 'a) (lambda () (crs)))
    (dk-have! (list '= (tk sM) 'b) (lambda () (subst (list '= sM (list '+ M 1))) (ass)))
    ;; the polygon of row j: road on [a, b], value on piece k, ends
    (define inc-M (subst-free 'tq TQ (subst-free 'n sM ch-inc)))
    (dk-have! inc-M
      (lambda () (let* ((pl (dk-peel!)) (k (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) pl)))) (sk (list 'succ k)))
                   (fact 'nn-succ-closed k)
                   (if (not (dk-asm? (list 'IN sM 'NN))) (fact 'nn-succ-closed M))
                   (dk-have! (list '<= sk sM) (lambda () (dk-cite! 'nn-lt-succ-le k sM) (if (dk-asm? (dk-goal)) (ass))))
                   (dk-have! (list '<= k sM) (lambda () (dk-nn!)))
                   (tval! k) (tval! sk)
                   (fact 'nn-succ-plus-one k)
                   (rmul! k ht) (rmul! sk ht)
                   (dk-have! (list '= (list '* sk ht) (list '+ (list '* k ht) ht)) (lambda () (subst (list '= sk (list '+ k 1))) (crs)))
                   (subst (list '= (list TQ k) (tk k))) (subst (list '= (list TQ sk) (tk sk)))
                   (dk-ineq! (list '= (list '* sk ht) (list '+ (list '* k ht) ht)) (list '< 0 ht)))))
    (define (poly! j)                          ; returns the pv universal of row j; lands the road on [a, b] and the path
      (xq-typed! j)
      (if (not (dk-asm? (list '< M sM))) (dk-have! (list '< M sM) (lambda () (dk-nn!))))
      (let* ((pf (dk-fact! 'poly-road-facts M sM TQ (list chmX j))))
        (dk-split-all! (list pf))
        (let ((rd (list 'IS-ROAD (sig j) (sigd j) (list TQ 0) (list TQ (list 'succ M)))))
          (if (not (dk-asm? (list 'IS-ROAD (sig j) (sigd j) 'a 'b)))
              (begin (dk-rewrite-h! rd (list TQ 0) 'a)
                     (dk-rewrite-h! (list 'IS-ROAD (sig j) (sigd j) 'a (list TQ (list 'succ M))) (list TQ (list 'succ M)) 'b))))
        (fact 'is-road-is-path (sig j) (sigd j) 'a 'b)
        (ch-pick 'pv (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'th) (dk-contains? f (sig j)))))))
    ;; k < sM in context: succ k <= sM, k <= M, k <= sM
    (define (k-bounds! k)
      (let ((sk (list 'succ k)))
        (fact 'nn-succ-closed k) (fact 'nn-in-rr k) (fact 'nn-in-rr sk) (fact 'nn-succ-plus-one k)
        (if (not (dk-asm? (list '<= sk sM)))
            (dk-have! (list '<= sk sM) (lambda () (dk-cite! 'nn-lt-succ-le k sM) (if (dk-asm? (dk-goal)) (ass)))))
        (for-each (lambda (g) (if (not (dk-asm? g))
                                  (dk-have! g (lambda () (dk-ineq! (list '<= sk sM) (list '= sk (list '+ k 1)) (list '= sM (list '+ M 1)))))))
                  (list (list '<= k M) (list '<= k sM)))))
    ;; (= (* (succ x) h) (+ (* x h) h)), returned
    (define (sk-eq! x h)
      (let* ((sx (list 'succ x)) (g (list '= (list '* sx h) (list '+ (list '* x h) h))))
        (fact 'nn-succ-plus-one x) (fact 'nn-in-rr x) (fact 'nn-succ-closed x) (fact 'nn-in-rr sx) (rmul! x h) (rmul! sx h)
        (if (not (dk-asm? g)) (dk-have! g (lambda () (subst (list '= sx (list '+ x 1))) (crs))))
        g))
    ;; the grid values on the bottom and top edges: phi(s, a) = pgam(a), phi(s, b) = pgam(b)
    (define (edge-vals! j)                     ; j <= sN: (= ((X j) 0) (pgam a)), (= ((X j) sM) (pgam b))
      (s-in! j)
      (dk-split-all! (list (dk-apply! bsv (sj j))))
      (xval! j 0) (xval! j sM)
      (for-each (lambda (k e)
                  (let ((g (list '= (list (list chmX j) k) (list 'pgam e))))
                    (if (not (dk-asm? g))
                        (dk-have! g (lambda () (subst (list '= (list (list chmX j) k) (list phi (P j k))))
                                      (subst (list '= (tk k) e)) (if (dk-asm? (dk-goal)) (ass)))))))
                (list 0 sM) '(a b)))
    ;; the ends of the polygon of row j: (= ((sig j) a) (pgam a)), (= ((sig j) b) (pgam b))
    (define (sig-ends! j pv)
      (edge-vals! j) (xq-typed! j)
      (for-each (lambda (k th kk e)
                  (let ((sk (list 'succ k)) (sg (sig j)))
                    (if (not (dk-asm? (list '< k sM))) (dk-have! (list '< k sM) (lambda () (dk-nn!))))
                    (k-bounds! k)
                    (tval! k) (tval! sk)
                    (fact 'fun-apply-type-c (list chmX j) 'NN 'CC k) (fact 'fun-apply-type-c (list chmX j) 'NN 'CC sk)
                    (fact 'fun-apply-type-c TQ 'NN 'RR k) (fact 'fun-apply-type-c TQ 'NN 'RR sk)
                    (inst*! inc-M k)
                    (dk-have! (list '<= (list TQ k) (list TQ sk)) (lambda () (dk-ineq! (list '< (list TQ k) (list TQ sk)))))
                    (ch-in-ccint! th (list TQ k) (list TQ sk) (list '< (list TQ k) (list TQ sk)))
                    (let ((e1 (inst*! pv k th))
                          (c1 (list '= (list sg th) (list (list chmX j) kk))))
                      (dk-split-all! (list (dk-fact! 'aff-seg-ends (list (list chmX j) k) (list (list chmX j) sk) (list TQ k) (list TQ sk))))
                      (if (not (dk-asm? c1))
                          (dk-have! c1 (lambda ()
                                         (subst e1)
                                         (subst (list '= (list (list 'AFF-SEG (list (list chmX j) k) (list (list chmX j) sk) (list TQ k) (list TQ sk)) th)
                                                      (list (list chmX j) kk)))
                                         (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass) (rfl))))))
                      (dk-rewrite-h! c1 th e)
                      (let ((g (list '= (list sg e) (list 'pgam e))))
                        (if (not (dk-asm? g))
                            (dk-have! g (lambda () (subst (list '= (list sg e) (list (list chmX j) kk))) (if (dk-asm? (dk-goal)) (ass)))))))))
                (list 0 M) (list (list TQ 0) (list TQ sM)) (list 0 sM) '(a b)))
    ;; phi p lies in the image I, hence in u
    (define (in-u! pq)
      (let ((iff (dk-cite! 'image-membership-iff phi (list 'PTS Q) (list phi pq))))
        (fact 'membership-implies-sethood (list phi pq) 'CC)
        (dk-have! (list 'IN pq (list 'PTS Q)) (lambda () (subst (list '= (list 'PTS Q) R)) (ass)))
        (dk-have! (list 'IN (list phi pq) I)
          (lambda () (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew pq) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))))))))) (prop)))
        (fact 'subset-mem-fwd I 'u (list phi pq))))
    ;; the trace of the edge curve g = phi(s0, .) lies in u; sel picks the conjunct of bt
    (define (trace-g! g s0)
      (let ((goal (list 'SUBSET (list 'TRACE g 'a 'b) 'u)))
        (if (not (dk-asm? goal))
            (dk-have! goal
              (lambda ()
                (mac 'subset-def)
                (let* ((pl (dk-peel!)) (z (cadr (car pl))) (tr (list 'TRACE g 'a 'b)))
                  (fact 'trace-unfold g 'a 'b)
                  (dk-rewrite-h! (list 'IN z tr) tr (list 'IMAGE g '(CCINT a b)))
                  (let ((iff (dk-cite! 'image-membership-iff g '(CCINT a b) z)))
                    (dk-have! (caddr iff) (lambda () (prop)))
                    (dk-split! (caddr iff))
                    (let* ((x (dk-skolem! (ch-pick 'ex (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f z)))) #t))
                           (pq (list 'LIST s0 x)))
                      (dk-split-all! (list (dk-apply! bt x)))
                      (ch-pair-in! s0 x 'a 'b)
                      (fact 'fun-apply-type-c phi R 'CC pq)
                      (in-u! pq)
                      (subst (list '= z (list g x)))
                      (subst (list '= (list g x) (list phi pq)))
                      (ass)))))))
        goal))
    ;; the ball facts of row j (cp-bks form, for poly-trace-in): j <= sN in context
    (define (inst-pks form j)
      (subst-free 'xq (list chmX j) (subst-free 'tq TQ (subst-free 'eps eps (subst-free 'm M form)))))
    (define (row-node! j k)                    ; k < sM: ball about node k inside u, node k+1 in it (phi form)
      (k-bounds! k)
      (let ((sk (list 'succ k)))
        (xval! j k) (xval! j sk)
        (ball-in-u! (P j k))
        (near! (P j k) (P j sk) (list (list '< 0 dl)) (list (sk-eq! k ht) (list '<= ht dl) (list '< 0 ht)))
        (fact 'fun-apply-type-c TQ 'NN 'RR k) (fact 'fun-apply-type-c TQ 'NN 'RR sk)
        (inst*! inc-M k)))
    (define (x-close! j ks)                    ; rewrite the nodes (X j) k to phi form, close from context
      (for-each (lambda (kk) (if (dk-contains? (dk-goal) (list (list chmX j) kk)) (subst (list '= (list (list chmX j) kk) (list phi (P j kk))))))
                ks)
      (if (dk-asm? (dk-goal)) (ass)))
    (define (row-bks! j)
      (let ((f (inst-pks ch-bks j)))
        (if (not (dk-asm? f))
            (dk-have! f
              (lambda ()
                (let* ((pl (dk-peel!)) (k (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) pl)))))
                  (row-node! j k)
                  (for-each (lambda (l) (dk-focus! l) (x-close! j (list k (list 'succ k)))) (ch-split-goal!))))))
        f))
    (define (row-trace! j)
      (row-bks! j) (xq-typed! j)
      (dk-fact! 'poly-trace-in 'u 'a 'b M TQ (list chmX j) eps))
    ;; the good-approx-balls hypothesis for curve g against the nodes of row j; W-IN! k w lands
    ;; (IN (g w) (BALL CC-MS (phi (P j k)) eps)) for w on piece k
    (define (ra! g j w-in!)
      (let ((f (subst-free 'pgam g (inst-pks ch-ra-pks j))))
        (if (not (dk-asm? f))
            (dk-have! f
              (lambda ()
                (let* ((pl (dk-peel!)) (k (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) pl)))))
                  (row-node! j k)
                  (for-each (lambda (l) (dk-focus! l)
                              (if (dk-head-is? (dk-goal) 'FORALL)
                                  (let* ((pw (dk-peel!)) (w (cadr (car pw))))
                                    (w-in! k w)
                                    (if (dk-contains? (dk-goal) (list g w))
                                        (let ((e (ch-pick 'gw (lambda (f) (and (dk-head-is? f '=) (or (equal? (cadr f) (list g w)) (equal? (caddr f) (list g w))))))))
                                          (subst (if (equal? (cadr e) (list g w)) e (list '= (caddr e) (cadr e))))))
                                    (x-close! j (list k)))
                                  (x-close! j (list k (list 'succ k)))))
                            (ch-split-goal!))))))
        f))
    ;; w on piece k: w in [a, b], and its distance to t_k
    (define (w-piece! k w)
      (let ((sk (list 'succ k)))
        (tval! k) (tval! sk)
        (ch-ccint-parts! w (list TQ k) (list TQ sk))
        (ch-ccint-parts! (tk k) 'a 'b) (ch-ccint-parts! (tk sk) 'a 'b)
        (ch-in-ccint! w 'a 'b (list '<= (list TQ k) w) (list '= (list TQ k) (tk k)) (list '<= 'a (tk k))
                      (list '<= w (list TQ sk)) (list '= (list TQ sk) (tk sk)) (list '<= (tk sk) 'b))
        (list (list '<= (list TQ k) w) (list '<= w (list TQ sk)) (list '= (list TQ k) (tk k)) (list '= (list TQ sk) (tk sk))
              (sk-eq! k ht) (list '<= ht dl) (list '< 0 ht) (list '< 0 dl))))
    ;; an edge curve: g w = phi(s0, w), row j has s_j = s0 by EQ1
    (define (edge-w-in! g s0 j eq1)
      (lambda (k w)
        (let ((pr2 (w-piece! k w)) (p1 (list 'LIST s0 w)))
          (dk-split-all! (list (dk-apply! bt w)))
          (ch-pair-in! s0 w 'a 'b)
          (fact 'fun-apply-type-c phi R 'CC p1)
          (near! (P j k) p1 (list eq1 (list '< 0 dl)) pr2)
          (subst (list '= (list g w) (list phi p1))))))
    ;; the polygon of row j against the nodes of row j + 1
    (define (step-w-in! j pv)
      (lambda (k w)
        (let* ((sj1 (list 'succ j)) (sk (list 'succ k)) (c (list phi (P sj1 k))) (B (list 'BALL 'CC-MS c eps))
               (pr2 (w-piece! k w)) (ej (sk-eq! j hs)))
          (xval! j k) (xval! j sk)
          (near! (P sj1 k) (P j k) (list ej (list '<= hs dl) (list '< 0 hs)) (list (list '< 0 dl)))
          (near! (P sj1 k) (P j sk) (list ej (list '<= hs dl) (list '< 0 hs)) (list (sk-eq! k ht) (list '<= ht dl) (list '< 0 ht)))
          (xq-typed! j)
          (fact 'fun-apply-type-c (list chmX j) 'NN 'CC k) (fact 'fun-apply-type-c (list chmX j) 'NN 'CC sk)
          (for-each (lambda (kk) (let ((g (list 'IN (list (list chmX j) kk) B)))
                                   (if (not (dk-asm? g)) (dk-have! g (lambda () (x-close! j (list kk)))))))
                    (list k sk))
          (fact 'cc-ball-is-convex c eps)
          (fact 'aff-seg-in-convex (list (list chmX j) k) (list (list chmX j) sk) (list TQ k) (list TQ sk) B w)
          (subst (inst*! pv k w)))))
    (ch-in-ccint! 0 0 1 '(<= 0 1))
    (define z0 (list '= (list '* 0 hs) 0))
    (dk-have! z0 (lambda () (crs)))
    (define H1 (list '= (list '* sN hs) 1))
    (let ((Xn (list '* (list '+ N 1) hs)))
      (rmul! (list '+ N 1) hs)
      (dk-have! (list '= (list '+ 0 Xn) Xn) (lambda () (crs)))
      (dk-rewrite-h! gs (list '+ 0 Xn) Xn)
      (rmul! sN hs)
      (dk-have! H1 (lambda () (subst (list '= sN (list '+ N 1))) (ass))))
    ;; the three kinds of good approximation
    (define (ga-edge! g s0 j eq1 epa epb)      ; GOOD-APPROX(u, g, sigma_j): g = phi(s0, .), s_j = s0
      (trace-g! g s0) (fact 'is-path-in-fun g 'a 'b)
      (edge-vals! j) (xq-typed! j)
      (for-each (lambda (kk e ep)
                  (let ((gl (list '= (list (list chmX j) kk) (list g e))))
                    (if (not (dk-asm? gl)) (dk-have! gl (lambda () (subst (list '= (list (list chmX j) kk) (list 'pgam e))) (if ep (subst ep)) (if (dk-asm? (dk-goal)) (ass) (rfl)))))))
                (list 0 sM) '(a b) (list epa epb))
      (ra! g j (edge-w-in! g s0 j eq1))
      (dk-split-all! (list (dk-fact! 'good-approx-balls 'u g 'a 'b M TQ (list chmX j) eps)))
      (ass))
    (define (ga-step! j)                       ; j <= N peeled
      (let ((sj1 (list 'succ j)))
        (fact 'nn-succ-closed j) (fact 'nn-in-rr j) (fact 'nn-in-rr sj1) (fact 'nn-succ-plus-one j)
        (dk-have! (list '<= j sN) (lambda () (dk-ineq! (list '<= j N) (list '= sN (list '+ N 1)))))
        (dk-have! (list '<= sj1 sN) (lambda () (dk-ineq! (list '<= j N) (list '= sN (list '+ N 1)) (list '= sj1 (list '+ j 1)))))
        (let ((pv (poly! j)))
          (row-trace! j)
          (sig-ends! j pv)
          (edge-vals! sj1) (xq-typed! sj1)
          (for-each (lambda (kk e)
                      (let ((gl (list '= (list (list chmX sj1) kk) (list (sig j) e))))
                        (if (not (dk-asm? gl)) (dk-have! gl (lambda () (subst (list '= (list (list chmX sj1) kk) (list 'pgam e)))
                                                              (subst (list '= (list (sig j) e) (list 'pgam e))) (if (dk-asm? (dk-goal)) (ass) (rfl)))))))
                    (list 0 sM) '(a b))
          (ra! (sig j) sj1 (step-w-in! j pv))
          (dk-split-all! (list (dk-fact! 'good-approx-balls 'u (sig j) 'a 'b M TQ (list chmX sj1) eps)))
          (ass))))
    (define (pack!)
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (ass))
              ((dk-head-is? g 'AND) (for-each (lambda (l) (dk-focus! l) (pack!)) (dk-opened (lambda () (di)))))
              ((dk-head-is? g 'FORSOME)
               (ew (cond ((eq? (cadr g) 'chm_) M) ((eq? (cadr g) 'chn_) N) ((eq? (cadr g) 'chtq_) TQ) (#t chmX)))
               (pack!))
              ((dk-head-is? g 'GOOD-APPROX)
               (if (eq? (caddr g) 'pgam)
                   (ga-edge! 'pgam 0 0 z0 #f #f)
                   (ga-edge! 'prho 1 sN H1 (list '= '(prho a) '(pgam a)) (list '= '(prho b) '(pgam b)))))
              ((and (dk-head-is? g 'FORALL) (dk-contains? g 'IS-ROAD))
               (let* ((pl (dk-peel!)) (j (cadr (car pl)))) (poly! j) (ass)))
              ((dk-head-is? g 'FORALL)
               (let* ((pl (dk-peel!)) (j (cadr (car pl)))) (ga-step! j)))
              (#t (error "pack!: unexpected goal" g)))))
    (pack!)))
(qed 'homotopy-polygon-chain)

