       (kern (list 'VNB-LAMBDA 'wnw_ pz '(recip (- wnw_ z))))
       (tpi '(recip (* (* 2 PI) +i)))
       (l1 (list 'LINE-INT kern 'pgam 'dgam 'a 'b)) (l2 (list 'LINE-INT kern 'prho 'drho 'a 'b))
       (w1 '(WINDING pgam dgam a b z)) (w2 '(WINDING prho drho a b z))
       (b1 (list '* tpi l1)) (b2 (list '* tpi l2))
       (tr2 '(TRACE prho a b)))
  (dk-split-all! (list (dk-fact! 'homotopic-traces pz 'pgam 'prho 'a 'b)))
  (dk-have! (list 'NOT (list 'IN 'z tr2))
    (lambda ()
      (di)
      (fact 'subset-mem-fwd tr2 pz 'z)
      (let ((iff (dk-cite! 'cc-punctured-membership 'z 'z)))
        (dk-have! '(NOT (= z z)) (lambda () (if (dk-only! iff (list 'IN 'z pz)) (prop))))
        (dk-have! '(= z z) (lambda () (rfl)))
        (ai '(NOT (= z z))))))
  (dk-fact! 'winding-in-cc 'prho 'drho 'a 'b 'z)
