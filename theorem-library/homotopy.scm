;;; THEOREM 3.18, by induction along the chain of 3.17: the integral along sigma_j is the integral along pgam
(define ch-chain-R (cadr ch-317-body))
(define ch-chain-G0 (cadr (caddr ch-317-body)))
(define ch-chain-S (cadr (caddr (caddr ch-317-body))))
(define (ch-lint j) (list 'LINE-INT 'f (ch-sig j) (ch-sigd j) 'a 'b))
(sp (make-wff (list 'FORALL 'chq_ (list 'IMPLIES '(IN chq_ NN)
  (forall-guarded '(u f pgam dgam a b chm_ chn_ chtq_ chxq_)
    (list '(HOLOMORPHIC-ON u f) '(IS-ROAD pgam dgam a b) '(IN chn_ NN) ch-chain-R ch-chain-G0 ch-chain-S '(<= chq_ (succ chn_)))
    (list '= (ch-lint 'chq_) '(LINE-INT f pgam dgam a b)))))))
(define ch18-br (use-induction))
(define (ch18-parts)                           ; read the peeled names off the goal
  (let* ((g (dk-goal)) (lhs (cadr g)) (rhs (caddr g)) (sg (caddr lhs)))
    (list (cadr lhs) (caddr rhs) (cadddr rhs) (list-ref rhs 4) (list-ref rhs 5)
          (cadr sg) (car (caddr sg)) (cadddr sg) lhs rhs)))
(dk-focus! (cdr (assq 'base ch18-br)))
(let* ((pl (dk-peel!)) (ps (ch18-parts))
       (u (cadr (car (filter (lambda (z) (dk-head-is? z 'HOLOMORPHIC-ON)) pl))))
       (f (list-ref ps 0)) (pg (list-ref ps 1)) (dg (list-ref ps 2)) (a (list-ref ps 3)) (b (list-ref ps 4))
       (tq (list-ref ps 5)) (xq (list-ref ps 6)) (m (list-ref ps 7)) (lhs (list-ref ps 8)) (rhs (list-ref ps 9))
       (R (ch-pick 'R (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'IS-ROAD)))))
       (s0 (list 'POLY-ROAD tq (list xq 0) m)) (d0 (list 'POLY-DER tq (list xq 0) m)))
  (dk-have! '(IN 0 NN))
  (dk-have! (list '<= 0 (list 'succ (cadr (caddr (car (filter (lambda (z) (dk-head-is? z '<=)) pl)))))) (lambda () (dk-nn!)))
  (inst*! R 0)
  (let ((e (dk-fact! 'good-approx-integral u f pg dg s0 d0 a b)))
    (subst (list '= lhs rhs))
    (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass) (rfl)))))
(dk-focus! (cdr (assq 'step ch18-br)))
(let* ((v (cdr (assq 'var ch18-br))) (ih (cdr (assq 'ih ch18-br)))
       (pl (dk-peel!)) (ps (ch18-parts))
       (u (cadr (car (filter (lambda (z) (dk-head-is? z 'HOLOMORPHIC-ON)) pl))))
       (f (list-ref ps 0)) (pg (list-ref ps 1)) (dg (list-ref ps 2)) (a (list-ref ps 3)) (b (list-ref ps 4))
       (tq (list-ref ps 5)) (xq (list-ref ps 6)) (m (list-ref ps 7)) (lhs (list-ref ps 8)) (rhs (list-ref ps 9))
       (le (car (filter (lambda (z) (and (dk-head-is? z '<=) (equal? (cadr z) (list 'succ v)))) pl)))
       (n (cadr (caddr le))) (sv (list 'succ v)) (sn (list 'succ n))
       (R (ch-pick 'R (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'IS-ROAD)))))
       (S (ch-pick 'S (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'GOOD-APPROX)))))
       (sg (lambda (j) (list 'POLY-ROAD tq (list xq j) m))) (sd (lambda (j) (list 'POLY-DER tq (list xq j) m)))
       (lj (list 'LINE-INT f (sg v) (sd v) a b)))
  (fact 'nn-succ-closed v) (fact 'nn-succ-closed n)
  (fact 'nn-in-rr v) (fact 'nn-in-rr n) (fact 'nn-in-rr sv) (fact 'nn-in-rr sn)
  (fact 'nn-succ-plus-one v) (fact 'nn-succ-plus-one n)
  (let ((pr (list le (list '= sv (list '+ v 1)) (list '= sn (list '+ n 1)))))
    (dk-have! (list '<= v n) (lambda () (apply dk-ineq! pr)))
    (dk-have! (list '<= v sn) (lambda () (apply dk-ineq! pr))))
  (inst*! ih u f pg dg a b m n tq xq)
  (inst*! R v) (inst*! R sv) (inst*! S v)
  (dk-fact! 'good-approx-integral u f (sg v) (sd v) (sg sv) (sd sv) a b)
  (subst (list '= lhs lj))
  (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass))))
(qed 'homotopy-chain-line-int)

;;; THEOREM 3.18: homotopic roads in u give the same integral of a function holomorphic on u
(sp (make-wff (forall-guarded '(u f pgam dgam prho drho a b)
  '((IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u) (HOLOMORPHIC-ON u f) (IS-ROAD pgam dgam a b) (IS-ROAD prho drho a b)
    (HOMOTOPIC u pgam prho a b))
  '(= (LINE-INT f pgam dgam a b) (LINE-INT f prho drho a b)))))
(dk-peel!)
(let* ((ex (dk-fact! 'homotopy-polygon-chain 'u 'pgam 'prho 'a 'b))
       (m (dk-skolem! ex #t))
       (_1 (dk-split-all!))
       (n (dk-skolem! (ch-pick 'en (lambda (z) (and (dk-head-is? z 'FORSOME) (eq? (cadr z) 'chn_)))) #t))
       (_2 (dk-split-all!))
       (tq (dk-skolem! (ch-pick 'et (lambda (z) (and (dk-head-is? z 'FORSOME) (eq? (cadr z) 'chtq_)))) #t))
       (_3 (dk-split-all!))
       (xq (dk-skolem! (ch-pick 'ex (lambda (z) (and (dk-head-is? z 'FORSOME) (eq? (cadr z) 'chxq_)))) #t))
       (_4 (dk-split-all!))
       (sn (list 'succ n))
       (sg (list 'POLY-ROAD tq (list xq sn) m)) (sd (list 'POLY-DER tq (list xq sn) m))
       (R (ch-pick 'R (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'IS-ROAD)))))
       (ln (list 'LINE-INT 'f sg sd 'a 'b)))
  (fact 'nn-succ-closed n)
  (dk-have! (list '<= sn sn) (lambda () (dk-nn!)))
  (inst*! R sn)
  (dk-fact! 'homotopy-chain-line-int sn 'u 'f 'pgam 'dgam 'a 'b m n tq xq)
  (dk-fact! 'good-approx-integral 'u 'f 'prho 'drho sg sd 'a 'b)
  (subst (list '= '(LINE-INT f prho drho a b) ln))
  (subst (list '= ln '(LINE-INT f pgam dgam a b)))
  (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass) (rfl))))
