;;; COROLLARY 3.20: the integral along a null-homotopic closed road is 0
(define ch-kap '(VNB-LAMBDA cgq_ (CCINT a b) (pgam a)))
(define ch-kap1 '(VNB-LAMBDA cgq_ (CCINT a b) 0))
(sp (make-wff (forall-guarded '(u f pgam dgam a b)
  '((IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u) (HOLOMORPHIC-ON u f) (IS-ROAD pgam dgam a b) (NULL-HOMOTOPIC u pgam a b))
  '(= (LINE-INT f pgam dgam a b) 0))))
(dk-peel!)
(let* ((nh '(NULL-HOMOTOPIC u pgam a b))
       (rhs (caddr (dk-cite! 'null-homotopic 'u 'pgam 'a 'b))))
  (dk-project! rhs 'null-homotopic nh)
  (dk-split-all! (list rhs))
  (fact 'is-road-is-path 'pgam 'dgam 'a 'b)
  (dk-split-all! (list (dk-fact! 'is-path-endpoints 'pgam 'a 'b)))
  (let ((hm (ch-pick 'hm (lambda (z) (dk-head-is? z 'HOMOTOPIC)))))
    (dk-have! '(IN (pgam a) u)
      (lambda ()
        (let* ((phi (ch-unpack! 'u 'pgam (list-ref hm 3) 'a 'b))
               (bt (ch-pick 'bt (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'hmt_) (dk-contains? f phi))))))
          (ch-R-set! 'a 'b)
          (dk-have! '(IN 1 RR))
          (ch-in-ccint! 0 0 1 '(<= 0 1))
          (ch-in-ccint! 'a 'a 'b '(< a b))
          (dk-split-all! (list (dk-apply! bt 'a)))
          (ch-pair-in! 0 'a 'a 'b)
          (fact 'fun-apply-type-c phi (ch-R 'a 'b) 'u '(LIST 0 a))
          (subst (list '= '(pgam a) (list phi '(LIST 0 a))))
          (ass)))))
  (fact 'is-path-in-fun 'pgam 'a 'b)
  (ch-in-ccint! 'a 'a 'b '(< a b))
  (fact 'fun-apply-type-c 'pgam '(CCINT a b) 'CC 'a)
  (fact 'const-road '(pgam a) 'a 'b)
  (dk-fact! 'homotopy-line-int 'u 'f 'pgam 'dgam ch-kap ch-kap1 'a 'b)
  (dk-fact! 'const-road-line-int 'u 'f '(pgam a) 'a 'b)
  (subst (list '= '(LINE-INT f pgam dgam a b) (list 'LINE-INT 'f ch-kap ch-kap1 'a 'b)))
  (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass))))
(qed 'null-homotopic-line-int)

;;; the two ends of a homotopy in u have their traces in u
(sp (make-wff (forall-guarded '(u pgam prho a b) '((HOMOTOPIC u pgam prho a b))
  '(AND (SUBSET (TRACE pgam a b) u) (SUBSET (TRACE prho a b) u)))))
(dk-peel!)
(let* ((phi (ch-unpack! 'u 'pgam 'prho 'a 'b))
       (bt (ch-pick 'bt (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'hmt_) (dk-contains? f phi)))))
       (R (ch-R 'a 'b)))
  (dk-have! '(IN 1 RR))
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (ch-in-ccint! 0 0 1 '(< 0 1)) (ch-in-ccint! 1 0 1 '(< 0 1))
  (fact 'is-path-in-fun 'pgam 'a 'b) (fact 'is-path-in-fun 'prho 'a 'b)
  (for-each
    (lambda (g s0)
      (dk-have! (list 'SUBSET (list 'TRACE g 'a 'b) 'u)
        (lambda ()
          (mac 'subset-def)
          (let* ((pl (dk-peel!)) (z (cadr (car pl))) (tr (list 'TRACE g 'a 'b)))
            (fact 'trace-unfold g 'a 'b)
            (dk-rewrite-h! (list 'IN z tr) tr (list 'IMAGE g '(CCINT a b)))
            (let ((iff (dk-cite! 'image-membership-iff g '(CCINT a b) z)))
              (dk-have! (caddr iff) (lambda () (prop)))
              (dk-split! (caddr iff))
              (let* ((x (dk-skolem! (ch-pick 'ex (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f z)))) #t))
                     (pq (list 'LIST s0 x)))
                (dk-split-all! (list (dk-apply! bt x)))
                (ch-pair-in! s0 x 'a 'b)
                (fact 'fun-apply-type-c phi R 'u pq)
                (subst (list '= z (list g x)))
                (subst (list '= (list g x) (list phi pq)))
                (ass)))))))
    '(pgam prho) '(0 1))
  (dk-conj-close! (lambda () (ass))))
(qed 'homotopic-traces)

;;; COROLLARY 3.31: roads homotopic in CC minus {z} have the same winding number about z
(sp (make-wff (forall-guarded '(z pgam dgam prho drho a b)
  '((IN z CC) (IS-ROAD pgam dgam a b) (IS-ROAD prho drho a b) (HOMOTOPIC (DIFFERENCE CC (SINGLETON z)) pgam prho a b))
  '(= (WINDING pgam dgam a b z) (WINDING prho drho a b z)))))
