;;; rf-3.scm -- slice 3: the coefficients of the sum, and the Riesz-Fischer theorem.

(define (rf-keep-prop! . keepers)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! keepers)
    (if (not (sequent-node-grounded? leaf)) (prop))))
;; w in VEC: (IN (IP-NORM v w) RR), (== (IP-NORM v w) (SQRT <w,w>)), sqrt-prop at <w,w>
(define (rf-norm-facts! w)
  (let* ((q (rf-ip w w)) (n (list 'IP-NORM 'v w)))
    (fact 'cips-ip-self-real 'v w)
    (fact 'cips-ip-self-nonneg 'v w)
    (rf-and! (list 'IN q 'RR) (list '<= 0 q))
    (dk-split-all! (list (dk-cite! 'sqrt-prop q)))
    (dk-have! (list '== n (list 'SQRT q)) (lambda () (mac 'IP-NORM) (qrfl)))
    (dk-have! (list 'IN n 'RR) (lambda () (subst (list '== n (list 'SQRT q))) (dk-ass!)))
    n))
(define (rf-res-norm! bnd r yext)
  (let* ((ny (list '(VNEG v) yext)) (w (list '(VADD v) r ny)))
    (fact 'cips-vneg-type 'v yext)
    (fact 'cips-vadd-type 'v r ny)
    (fact 'ip-normed-ag-opr 'v)
    (fact 'ip-normed-ag-inv 'v)
    (fact 'ip-normed-ag-norm-value 'v w)
    (let* ((b1 (dk-rewrite-h! bnd (list 'OPR rf-G) '(VADD v)))
           (b2 (dk-rewrite-h! b1 (list 'INV rf-G) '(VNEG v)))
           (b3 (dk-rewrite-h! b2 (list (list 'NRM rf-G) w) (list 'IP-NORM 'v w))))
      b3)))
(define (rf-ext-guard! fin ext)
  (dk-have! (list 'SUBSET ext (list 'DOM rf-cf))
    (lambda () (subst (list '= (list 'DOM rf-cf) 'ix)) (dk-ass!)))
  (rf-and! (list 'IN ext 'SET) (list 'IN (list 'CARD ext) 'NN) (list 'SUBSET fin ext) (list 'SUBSET ext (list 'DOM rf-cf))))
(define (rf-sub-union! a b)
  (dk-have! (list 'SUBSET b (list 'UNION a b))
    (lambda () (fact 'union-right-subset a b) (ass)))
  (dk-have! (list 'SUBSET a (list 'UNION a b))
    (lambda ()
      (fact 'union-right-subset b a)
      (fact 'union-comm b a)
      (subst (list '= (list 'UNION a b) (list 'UNION b a)))
      (ass))))
(define (rf-union-sub! a b c)
  (dk-have! (list 'SUBSET (list 'UNION a b) c)
    (lambda ()
      (mac 'subset-def)
      (let* ((landed (dk-peel!))
             (mem (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN)
                                               (equal? (caddr f) (list 'UNION a b))))
                              landed))
             (x (cadr mem))
             (cases (dk-landed-1 (lambda () (mac-h 'union-membership mem)))))
        (use-cases cases
          (lambda () (fact 'subset-mem-fwd a c x) (ass))
          (lambda () (fact 'subset-mem-fwd b c x) (ass)))))))

;;; ---------------------------------------------------------------------------
;;; THE COEFFICIENTS OF A LIMIT.  If c_k e_k sums to L then <L, e_p> = c_p: for ext = fin u {p},
;;; |<L,e_p> - c_p| = |<L - Z_ext, e_p>| <= ||L - Z_ext|| < eps (hilbert-onb.scm's onb-coef-limit).
(sp (make-wff (rf-stmt
  (list 'FORALL 'rfl_ (list 'IMPLIES (list 'IN 'rfl_ rf-V)
    (list 'IMPLIES (list 'SUMS-TO rf-G rf-cf 'rfl_)
      (list 'FORALL 'rfp_ (list 'IMPLIES '(IN rfp_ ix)
        (list '= (rf-ip 'rfl_ '(e rfp_)) '(c rfp_))))))))))
(dk-peel!)
(rf-sum-setup!)
(rf-onf-setup!)
(rf-Q-dom!)
(rf-cf-dom!)
(let* ((st (dk-pick (dk-head? 'SUMS-TO) "the summation hypothesis"))
       (L (cadddr st))
       (gl (dk-goal))
       (k (cadr (caddr (cadr gl))))
       (ek (list 'e k))
       (p (rf-ip L ek)) (q (list 'c k))
       (cd (list '+ p (list '- q)))
       (m (list 'MAGNITUDE cd)))
  (rf-k-facts! k)
  (fact 'cips-ip-type 'v L ek)
  (fact 'cc-neg-closed q)
  (rf-and! (list 'IN p 'CC) (list 'IN (list '- q) 'CC))
  (fact 'cc-add-closed p (list '- q))
  (fact 'cc-magnitude-closed cd)
  (fact 'cc-magnitude-nonneg cd)
  (use-em (list '= m 0)
    (lambda ()
      (let ((iff (dk-cite! 'cc-magnitude-zero-iff cd)))
        (dk-have! (list '= cd 0) (lambda () (if (dk-only! iff (list '= m 0)) (prop))))
        (dk-have! (list '= p (list '+ cd q)) (lambda () (crs)))
        (subst (list '= p (list '+ cd q)))
        (subst (list '= cd 0))
        (crs)))
    (lambda ()
      (fact 'neq-sym m 0)
      (dk-have! (list 'POS-RR m) (lambda () (mac 'pos-rr) (dk-conj-close! (lambda () (dk-ass!)))))
      (let* ((sb (dk-landed-1 (lambda () (mac-h 'sums-to st))))
             (ex (dk-apply! sb m))
             (fin (dk-skolem! ex)))
        (dk-split-all!)
        (dk-rewrite-h! (list 'SUBSET fin (list 'DOM rf-cf)) (list 'DOM rf-cf) 'ix)
        (let* ((pr (list 'PAIR k k))
               (ext (list 'UNION fin pr))
               (ye (rf-Z ext)))
          (fact 'membership-implies-sethood k 'ix)
          (rf-and! (list 'IN k 'SET) (list 'IN k 'SET))
          (fact 'pairing k k)
          (fact 'card-singleton k)
          (dk-have! (list 'IN (list 'CARD pr) 'NN)
            (lambda () (subst (list '= (list 'CARD pr) '(succ 0))) (fact 'nn-zero-in) (fact 'nn-succ-closed 0) (dk-ass!)))
          (dk-have! (list 'SUBSET pr 'ix)
            (lambda ()
              (mac 'subset-def)
              (let* ((z (dk-di-var!))
                     (pm (dk-apply! (dk-cite! 'pairing-membership k k) z)))
                (dk-have! (list '= z k) (lambda () (if (dk-only! pm (list 'IN z pr)) (prop))))
                (subst (list '= z k))
                (dk-ass!))))
          (rf-and! (list 'IN fin 'SET) (list 'IN pr 'SET))
          (fact 'union-set-closure fin pr)
          (fact 'card-union-nn fin pr)
          (rf-sub-union! fin pr)
          (rf-union-sub! fin pr 'ix)
          (fact 'union-singleton-mem k fin)
          (fact 'union-comm fin pr)
          (dk-have! (list 'IN k ext) (lambda () (subst (list '= ext (list 'UNION pr fin))) (dk-ass!)))
          (let ((c1 (rf-pc! ext)))
            (rf-ext-guard! fin ext)
            (let* ((bnd (dk-apply! (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a (list 'NRM rf-G)) (dk-contains? a fin)))
                                            "the tail bound")
                                   ext))
                   (b3 (rf-res-norm! bnd L ye))
                   (d (list '(VADD v) L (list '(VNEG v) ye)))
                   (nd (rf-norm-facts! d))
                   (ne (list 'IP-NORM 'v ek)))
              (dk-apply! c1 k)
              (fact 'cips-ip-type 'v ye ek)
              (fact 'cips-ip-add-left 'v L (list '(VNEG v) ye) ek)
              (fact 'cips-ip-neg-left 'v ye ek)
              (dk-have! (list '= (rf-ip d ek) cd)
                (lambda ()
                  (subst (list '= (rf-ip d ek) (list '+ p (rf-ip (list '(VNEG v) ye) ek))))
                  (subst (list '= (rf-ip (list '(VNEG v) ye) ek) (list '- (rf-ip ye ek))))
                  (subst (list '= (rf-ip ye ek) q))
                  (dk-close-if! (lambda () #t) (lambda () (rfl)))))
              (dk-apply! rf-unit-h k)
              (fact 'rr-one-in)
              (dk-have! (list '<= 0 1) (lambda () (dk-ineq! '(IN 1 RR))))
              (rf-and! '(IN 1 RR) '(<= 0 1))
              (dk-have! '(= (* 1 1) 1) (lambda () (crs)))
              (fact 'sqrt-char 1 1)
              (dk-have! (list '= ne 1)
                (lambda () (mac 'IP-NORM) (subst (list '= (rf-ip ek ek) 1)) (dk-ass!)))
              (let* ((ml (dk-cite! 'cips-ip-magnitude-le 'v d ek))
                     (ml2 (dk-rewrite-h! ml (rf-ip d ek) cd))
                     (ml3 (dk-rewrite-h! ml2 ne 1)))
                (dk-have! 'FALSITY
                  (lambda ()
                    (dk-absurd! ml3 b3 (list 'IN nd 'RR) (list 'IN m 'RR))))
                (rf-keep-prop! 'FALSITY)))))))))
(rf-done! 'rf-coef-limit)

;;; ---------------------------------------------------------------------------
;;; RIESZ-FISCHER, the sum form.  H a Hilbert space, (e_i) an orthonormal family, c in l2(I): the
;;; family c_i e_i is summable in H, and its sum x has <x, e_i> = c_i for every i.
(define (rf-hil-stmt onx body)
  (list 'FORALL 'v (list 'IMPLIES '(IS-HILBERT-SPACE v)
    (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES onx
      (list 'FORALL 'c (list 'IMPLIES '(IN c (L2-FAMILIES ix)) body))))))))
(define rf-coef-form '(FORALL rfp_ (IMPLIES (IN rfp_ ix) (= ((IP v) x (e rfp_)) (c rfp_)))))
(sp (make-wff (rf-hil-stmt '(IS-ORTHONORMAL-FAMILY v ix e)
  (list 'FORSOME 'x (list 'AND (list 'IN 'x rf-V) (list 'AND (list 'SUMS-TO rf-G rf-cf 'x) rf-coef-form))))))
(dk-peel!)
(dk-project! '(IS-COMPLEX-INNER-PRODUCT-SPACE v) 'is-hilbert-space '(IS-HILBERT-SPACE v))
(dk-project! '(IS-COMPLETE (IP-METRIC-SPACE v)) 'is-hilbert-space '(IS-HILBERT-SPACE v))
(dk-split-all! (list (dk-cite! 'l2-families-elim 'ix 'c)))
(rf-sum-setup!)
(rf-onf-setup!)
(rf-Q-dom!)
(rf-cf-dom!)
(fact 'ip-metric-space-unfold 'v)
(dk-rewrite-h! '(IS-COMPLETE (IP-METRIC-SPACE v)) '(IP-METRIC-SPACE v) (rf-M rf-G))
(fact 'rf-cauchy-net 'v 'ix 'e 'c)
(fact 'summable-of-cauchy-net rf-G rf-cf)
(let* ((sm (list 'IS-SUMMABLE rf-G rf-cf))
       (ex (dk-landed-1 (lambda () (mac-h 'is-summable sm))))
       (L (dk-skolem! ex)))
  (dk-split-all!)
  (dk-have! (list 'IN L rf-V)
    (lambda () (subst (list '== rf-V (list 'CARR rf-G))) (dk-ass!)))
  (fact 'rf-coef-limit 'v 'ix 'e 'c L)
  (ew L)
  (dk-conj-close! (lambda () (dk-ass!))))
(rf-done! 'riesz-fischer-sum)

;;; ---------------------------------------------------------------------------
;;; RIESZ-FISCHER (th-main Prop 2.6, W onto).  For an orthonormal basis (e_i) of a Hilbert space
;;; H, every c in l2(I) is W x = (<x, e_i>)_i for some x in H.
(define (rf-W z) (list 'VNB-LAMBDA 'cfk_ 'ix (rf-ip z '(e cfk_))))
(sp (make-wff (rf-hil-stmt '(IS-ORTHONORMAL-BASIS v ix e)
  (list 'FORSOME 'x (list 'AND (list 'IN 'x rf-V) (list '= (rf-W 'x) 'c))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(dk-project! '(IS-ORTHONORMAL-FAMILY v ix e) 'is-orthonormal-basis '(IS-ORTHONORMAL-BASIS v ix e))
(rf-onf-setup!)
(dk-split-all! (list (dk-cite! 'l2-families-elim 'ix 'c)))
(let* ((ex (dk-cite! 'riesz-fischer-sum 'v 'ix 'e 'c))
       (x (dk-skolem! ex)))
  (dk-split-all!)
  (let ((cl (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a (list 'c 'rfp_)))) "the coefficients")))
    (ew x)
    (dk-conj-close!
      (lambda ()
        (cond
          ((dk-ass!) #t)
          (#t
           (dk-fun-ext! (rf-W x) 'c 'ix 'CC
             (lambda ()
               (dk-lam-type!
                 (lambda () (let ((k (dk-di-var!)))
                              (fact 'fun-apply-type-c 'e 'ix rf-V k)
                              (fact 'cips-ip-type 'v x (list 'e k))
                              (dk-ass!)))
                 (lambda () (ass))))
             (lambda () (ass))
             (lambda (k)
               (fact 'fun-apply-type-c 'e 'ix rf-V k)
               (dk-apply! cl k)
               (dk-lam-b!)
               (rf-close!)))
           (rf-close!)))))))
(rf-done! 'riesz-fischer)
