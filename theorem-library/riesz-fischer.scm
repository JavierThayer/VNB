;;; riesz-fischer.scm -- wave of 2026-11-09/10 (agent BA-ONB4), wired 2026-11-10 from scratchpad/baonb4-1109/rf-1.scm, scratchpad/baonb4-1109/rf-2.scm, scratchpad/baonb4-1109/rf-3.scm.
;;; Library: operator-algebras.

;;; rf-1.scm -- slice 1 of the Riesz-Fischer file: helpers and the coefficients of a finite
;;; partial sum of c_k e_k.  Agent BA-ONB4, 2026-11-09.  Prefix rf-.

(define (rf-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; rf: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l)
                    (display ";;   ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;     | ") (display (expression->string a)) (newline))
                              (list-head (dk-asms-of l) (min 6 (length (dk-asms-of l))))))
                  (dk-open-leaves))
        (error "rf: proof not complete" name)))
  (qed name)
  (topic! name 'analysis))
(define (rf-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (rf-close!)
  (cond ((not (rf-open?)) #t) ((dk-asm? (dk-goal)) (ass)) ((dk-head-is? (dk-goal) '==) (qrfl)) (#t (rfl))))
(define (rf-and! . fs)
  (let ((c (let loop ((fs fs)) (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (loop (cdr fs)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define (rf-dump! tag)
  (for-each (lambda (l)
              (display ";; RFOPEN ") (display tag) (display ": ") (display (expression->string (dk-goal-of l))) (newline)
              (for-each (lambda (a) (display ";;     | ") (display (expression->string a)) (newline))
                        (list-head (dk-asms-of l) (min 8 (length (dk-asms-of l))))))
            (dk-open-leaves)))

;;; the terms
(define rf-V '(VEC v))
(define (rf-ip a b) (list '(IP v) a b))
(define rf-G '(IP-NORMED-AG v))
(define rf-VG '(NORMED-AG-AS-ABELIAN-GROUP (IP-NORMED-AG v)))
(define rf-RM 'RR-POS-STAR-ADD-MONOID)
(define rf-B '(NORMED-AG-AS-ABELIAN-GROUP CC-NAG))
(define rf-cf '(VNB-LAMBDA rfk_ ix ((ACT v) (c rfk_) (e rfk_))))
(define rf-Q '(VNB-LAMBDA l2k_ ix (* (MAGNITUDE (c l2k_)) (MAGNITUDE (c l2k_)))))
(define (rf-Z w) (list 'FINSUM rf-VG rf-cf w))
(define (rf-P w) (list 'FINSUM rf-RM rf-Q w))
(define (rf-sq t) (list '* (list 'MAGNITUDE t) (list 'MAGNITUDE t)))
(define (rf-fin3 w sup) (list (list 'IN w 'SET) (list 'IN (list 'CARD w) 'NN) (list 'SUBSET w sup)))
(define (rf-curry ants body) (if (null? ants) body (list 'IMPLIES (car ants) (rf-curry (cdr ants) body))))
;; forall v CIPS, ix, e ONF, c in FUN(ix, CC) . body
(define (rf-stmt body)
  (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-INNER-PRODUCT-SPACE v)
    (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES '(IS-ORTHONORMAL-FAMILY v ix e)
      (list 'FORALL 'c (list 'IMPLIES '(IN c (FUN ix CC)) body))))))))

;;; view read-offs (hilbert-onb.scm's onb-slot-close! / onb-readoff! / onb-rm-readoff!)
(define (rf-slot-close! view acc)
  (mac view)
  (let loop ((n 0))
    (let ((g (dk-goal)))
      (if (and (< n 8) (not (equal? (cadr g) (caddr g))))
          (begin (quietly (lambda () (slot acc)))
                 (quietly (lambda () (nth-r)))
                 (if (not (equal? (dk-goal) g)) (loop (+ n 1)))))))
  (qrfl))
(define (rf-readoff! acc src view)
  (let* ((lhs (list acc (list view src))) (rhs (list acc src)))
    (dk-have! (list '== lhs rhs) (lambda () (rf-slot-close! view acc)))
    (dk-have! (list '== rhs lhs) (lambda () (rf-slot-close! view acc)))))
(define (rf-rm-readoff! eqn)
  (dk-have! eqn (lambda () (quietly (lambda () (surface-goal! 'RR-POS-STAR-ADD-MONOID))) (qrfl))))
(define (rf-sum-setup!)
  (fact 'ip-normed-ag-is-normed-ag 'v)
  (fact 'normed-ag-as-abelian-group-is-abelian-group rf-G)
  (for-each (lambda (acc) (rf-readoff! acc rf-G 'NORMED-AG-AS-ABELIAN-GROUP)) '(CARR OPR IDEN))
  (fact 'ip-normed-ag-carrier 'v)
  (fact 'ip-normed-ag-opr 'v)
  (fact 'onb-ip-normed-ag-iden 'v)
  (dk-have! (list '== (list 'CARR rf-VG) rf-V)
    (lambda () (subst (list '== (list 'CARR rf-VG) (list 'CARR rf-G))) (subst (list '== (list 'CARR rf-G) rf-V)) (qrfl)))
  (dk-have! (list '== (list 'OPR rf-VG) '(VADD v))
    (lambda () (subst (list '== (list 'OPR rf-VG) (list 'OPR rf-G))) (subst (list '== (list 'OPR rf-G) '(VADD v))) (qrfl)))
  (dk-have! (list '== (list 'IDEN rf-VG) '(VZERO v))
    (lambda () (subst (list '== (list 'IDEN rf-VG) (list 'IDEN rf-G))) (subst (list '== (list 'IDEN rf-G) '(VZERO v))) (qrfl)))
  (rf-rm-readoff! '(== (OPR RR-POS-STAR-ADD-MONOID) eplus))
  (rf-rm-readoff! '(== (IDEN RR-POS-STAR-ADD-MONOID) 0))
  (rf-rm-readoff! '(== (CARR RR-POS-STAR-ADD-MONOID) RR-POS-STAR))
  (fact 'rr-pos-star-is-comm-monoid)
  (fact 'cips-vzero-in 'v)
  (fact 'cips-vec-set 'v))
;;; the projections of IS-ORTHONORMAL-FAMILY(v, ix, e)
(define (rf-onf) '(IS-ORTHONORMAL-FAMILY v ix e))
(define (rf-onf-typ!) (dk-project! (list 'IN 'e (list 'FUN 'ix rf-V)) 'is-orthonormal-family (rf-onf)))
(define (rf-onf-unit!)
  (dk-project! (list 'FORALL 'oni_ (list 'IMPLIES (list 'IN 'oni_ 'ix) (list '= (rf-ip '(e oni_) '(e oni_)) 1)))
               'is-orthonormal-family (rf-onf)))
(define (rf-onf-orth!)
  (dk-project! (list 'FORALL 'oni_ (list 'IMPLIES (list 'IN 'oni_ 'ix)
                 (list 'FORALL 'onj_ (list 'IMPLIES (list 'IN 'onj_ 'ix)
                   (list 'IMPLIES (list 'NOT (list '= 'oni_ 'onj_)) (list '= (rf-ip '(e oni_) '(e onj_)) 0))))))
               'is-orthonormal-family (rf-onf)))
(define rf-unit-h #f)
(define rf-orth-h #f)
(define (rf-onf-setup!)
  (rf-onf-typ!)
  (set! rf-unit-h (rf-onf-unit!))
  (set! rf-orth-h (rf-onf-orth!))
  (fact 'fun-domain-in-set 'ix rf-V 'e))
;; k in ix in context: e k in VEC, c k in CC, c k e k in VEC
(define (rf-k-facts! k)
  (if (not (dk-asm? (list 'IN (list 'e k) rf-V))) (fact 'fun-apply-type-c 'e 'ix rf-V k))
  (if (not (dk-asm? (list 'IN (list 'c k) 'CC))) (fact 'fun-apply-type-c 'c 'ix 'CC k))
  (if (not (dk-asm? (list 'IN (list '(ACT v) (list 'c k) (list 'e k)) rf-V)))
      (fact 'cips-act-type 'v (list 'c k) (list 'e k))))
;; k in ix: |c k|^2 in RR, 0 <= it
(define (rf-m2-facts! k)
  (let* ((t (list 'c k)) (m (list 'MAGNITUDE t)))
    (rf-k-facts! k)
    (if (not (dk-asm? (list 'IN (rf-sq t) 'RR)))
        (begin
          (fact 'cc-magnitude-closed t)
          (fact 'cc-magnitude-nonneg t)
          (rf-and! (list 'IN m 'RR) (list 'IN m 'RR))
          (fact 'rr-mul-closed m m)
          (fact 'rr-sq-nonneg m)))))
(define (rf-beta! f a val)
  (let ((eq (list '= (list f a) val)))
    (if (not (dk-asm? eq)) (dk-have! eq (lambda () (dk-close-if! dk-lam-b! rf-close!))))
    eq))
;; w subset ix in context: forall z_ in w. cf z_ in CARR VG
(define (rf-ptw-cf! w)
  (let ((claim (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ w) (list 'IN (list rf-cf 'z_) (list 'CARR rf-VG))))))
    (if (not (dk-asm? claim))
        (dk-have! claim
          (lambda ()
            (let ((z (cadr (car (dk-peel!)))))
              (if (not (eq? w 'ix)) (fact 'subset-mem-fwd w 'ix z))
              (rf-k-facts! z)
              (subst (list '== (list 'CARR rf-VG) rf-V))
              (dk-lam-b!)
              (rf-close!)))))
    claim))
;; w subset ix in context: forall z_ in w. Q z_ in CARR RM
(define (rf-ptw-Q! w)
  (let ((claim (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ w) (list 'IN (list rf-Q 'z_) (list 'CARR rf-RM))))))
    (if (not (dk-asm? claim))
        (dk-have! claim
          (lambda ()
            (let* ((z (cadr (car (dk-peel!)))) (m (rf-sq (list 'c z))))
              (if (not (eq? w 'ix)) (fact 'subset-mem-fwd w 'ix z))
              (rf-m2-facts! z)
              (subst (list '== (list 'CARR rf-RM) 'RR-POS-STAR))
              (dk-lam-b!)
              (let ((iff (dk-cite! 'rr-pos-star-membership m)))
                (if (dk-only! iff (list 'IN m 'RR) (list '<= 0 m)) (prop)))))))
    claim))

;;; ---------------------------------------------------------------------------
;;; THE COEFFICIENTS OF A FINITE PARTIAL SUM.  For an orthonormal family e and c in FUN(ix, CC),
;;; and a finite w <= ix, Z_w = sum_{k in w} c_k e_k is a vector and <Z_w, e_q> = c_q for q in w.
;;; Through the homomorphism <., e_q> (ip-functional-hom, finsum-hom-ag) the inner product is the
;;; finite sum of c_k <e_k, e_q>, whose only nonzero term is at q (finsum-single-support).
(define rf-pc-body
  (lambda (w)
    (list 'AND (list 'IN (rf-Z w) rf-V)
      (list 'FORALL 'rfq_ (list 'IMPLIES (list 'IN 'rfq_ w)
        (list '= (rf-ip (rf-Z w) '(e rfq_)) '(c rfq_)))))))
(sp (make-wff (rf-stmt (list 'FORALL 'rfw_ (rf-curry (rf-fin3 'rfw_ 'ix) (rf-pc-body 'rfw_))))))
(dk-peel!)
(rf-sum-setup!)
(rf-onf-setup!)
(fact 'cc-nag-ag-is-abelian-group)
(fact 'cc-nag-ag-carr)
(fact 'cc-nag-ag-iden)
(let* ((w 'rfw_) (zw (rf-Z w)))
  (rf-ptw-cf! w)
  (fact 'finsum-type-ptwise rf-VG w rf-cf)
  (dk-have! (list 'IN zw rf-V) (lambda () (subst (list '== rf-V (list 'CARR rf-VG))) (dk-ass!)))
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        (#t
         (let* ((q (cadr (car (dk-peel!))))
                (eq_ (list 'e q))
                (hq (list 'VNB-LAMBDA 'ipw_ rf-V (rf-ip 'ipw_ eq_)))
                (LAM (list 'VNB-LAMBDA 'fhz_ w (list hq (list rf-cf 'fhz_)))))
           (fact 'subset-mem-fwd w 'ix q)
           (rf-k-facts! q)
           (fact 'ip-functional-hom 'v eq_)
           (let ((hom (dk-cite! 'finsum-hom-ag rf-VG rf-B hq w rf-cf)))
             (rf-beta! hq zw (rf-ip zw eq_))
             ;; LAM in FUN(w, CARR B)
             (dk-have! (list 'IN LAM (list 'FUN w (list 'CARR rf-B)))
               (lambda ()
                 (dk-lam-type!
                   (lambda ()
                     (let ((z (dk-di-var!)))
                       (fact 'subset-mem-fwd w 'ix z)
                       (rf-k-facts! z)
                       (fact 'cips-ip-type 'v (list '(ACT v) (list 'c z) (list 'e z)) eq_)
                       (subst (list '== (list 'CARR rf-B) 'CC))
                       (dk-lam-b!)
                       (rf-close!)))
                   (lambda () (ass)))))
             ;; LAM vanishes off q
             (dk-have! (list 'FORALL 'rfj_ (list 'IMPLIES (list 'IN 'rfj_ w)
                         (list 'IMPLIES (list 'NOT (list '= 'rfj_ q)) (list '= (list LAM 'rfj_) (list 'IDEN rf-B)))))
               (lambda ()
                 (let* ((ld (dk-peel!))
                        (j (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) w))) ld)))
                        (ej (list 'e j)) (cj (list 'c j)))
                   (fact 'subset-mem-fwd w 'ix j)
                   (rf-k-facts! j)
                   (fact 'cips-ip-homog-left 'v cj ej eq_)
                   (dk-apply! rf-orth-h j q)
                   (subst (list '== (list 'IDEN rf-B) 0))
                   (dk-lam-b!)
                   (subst (list '= (rf-ip (list '(ACT v) cj ej) eq_) (list '* cj (rf-ip ej eq_))))
                   (subst (list '= (rf-ip ej eq_) 0))
                   (crs))))
             (fact 'finsum-single-support rf-B w LAM q)
             (dk-apply! rf-unit-h q)
             (fact 'cips-ip-homog-left 'v (list 'c q) eq_ eq_)
             (subst (list '= (rf-ip zw eq_) (list hq zw)))
             (subst (list '= (list hq zw) (list 'FINSUM rf-B LAM w)))
             (subst (list '= (list 'FINSUM rf-B LAM w) (list LAM q)))
             (dk-lam-b!)
             (subst (list '= (rf-ip (list '(ACT v) (list 'c q) eq_) eq_) (list '* (list 'c q) (rf-ip eq_ eq_))))
             (subst (list '= (rf-ip eq_ eq_) 1))
             (crs))))))))
(rf-done! 'rf-partial-coef)

