;;; rf-2.scm -- slice 2: Pythagoras for the partial sums of c_k e_k, and the Cauchy net.

(define (rf-sub y z) (list '(VADD v) y (list '(VNEG v) z)))
(define (rf-cf-of y) (list 'VNB-LAMBDA 'onk_ 'ix (list '(ACT v) (list '(IP v) y '(e onk_)) '(e onk_))))
(define (rf-gq-of y) (list 'VNB-LAMBDA 'onk_ 'ix
                           (list '* (list 'MAGNITUDE (list '(IP v) y '(e onk_)))
                                    (list 'MAGNITUDE (list '(IP v) y '(e onk_))))))
;; cite rf-partial-coef at w (finite, <= ix, in context) and split; returns the coefficient clause
(define (rf-pc! w)
  (let* ((inst (dk-cite! 'rf-partial-coef 'v 'ix 'e 'c w))
         (parts (if (dk-head-is? inst 'AND) (dk-split! inst) (list inst)))
         (cl (list 'FORALL 'rfq_ (list 'IMPLIES (list 'IN 'rfq_ w)
                (list '= (rf-ip (rf-Z w) '(e rfq_)) '(c rfq_))))))
    (if (not (dk-asm? cl)) (error "rf-pc!: the coefficient clause did not land" w))
    (if (not (dk-asm? (list 'IN (rf-Z w) rf-V))) (error "rf-pc!: the typing did not land" w))
    cl))
;; with the clause of rf-pc! at a in context and u <= a <= ix: the two congruences over u
;; between the onb- families at y = Z_a and the rf- families; returns (Yu' Pu')
(define (rf-congr! a u)
  (let* ((za (rf-Z a)) (cl (list 'FORALL 'rfq_ (list 'IMPLIES (list 'IN 'rfq_ a)
                                (list '= (rf-ip za '(e rfq_)) '(c rfq_)))))
         (cf2 (rf-cf-of za)) (gq2 (rf-gq-of za))
         (pt! (lambda (lhs-f rhs-f)
                (let ((claim (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ u)
                                                     (list '= (list lhs-f 'z_) (list rhs-f 'z_))))))
                  (if (not (dk-asm? claim))
                      (dk-have! claim
                        (lambda ()
                          (let ((z (cadr (car (dk-peel!)))))
                            (if (not (eq? u a)) (fact 'subset-mem-fwd u a z))
                            (fact 'subset-mem-fwd a 'ix z)
                            (rf-m2-facts! z)
                            (fact 'cips-ip-type 'v za (list 'e z))
                            (dk-apply! cl z)
                            (dk-lam-b!)
                            (dk-close-if! (lambda () (subst (list '= (rf-ip za (list 'e z)) (list 'c z))))
                                          rf-close!)))))))))
    (pt! cf2 rf-cf)
    (pt! gq2 rf-Q)
    (fact 'finsum-congruence-q rf-VG u cf2 rf-cf)
    (fact 'finsum-cm-congruence-q rf-RM u gq2 rf-Q)
    (list (list 'FINSUM rf-VG cf2 u) (list 'FINSUM rf-RM gq2 u))))

;;; ---------------------------------------------------------------------------
;;; PYTHAGORAS.  For finite w <= a <= ix: the partial sums P_a, P_w of |c_k|^2 are real and
;;; <Z_a - Z_w, Z_a - Z_w> = P_a - P_w.  By onb-partial-diff at x = Z_a, whose coefficients are
;;; c on a (rf-partial-coef), so that its partial sums over a and w are Z_a and Z_w.
(sp (make-wff (rf-stmt
  (list 'FORALL 'rfa_ (rf-curry (rf-fin3 'rfa_ 'ix)
    (list 'FORALL 'rfb_ (rf-curry (rf-fin3 'rfb_ 'rfa_)
      (let ((d (rf-sub (rf-Z 'rfa_) (rf-Z 'rfb_))))
        (list 'AND (list 'IN (rf-P 'rfa_) 'RR)
          (list 'AND (list 'IN (rf-P 'rfb_) 'RR)
            (list '= (rf-ip d d) (list '+ (rf-P 'rfa_) (list '- (rf-P 'rfb_))))))))))))))
(dk-peel!)
(rf-sum-setup!)
(rf-onf-setup!)
(let* ((a 'rfa_) (w 'rfb_) (za (rf-Z a)))
  (fact 'subset-trans w a 'ix)
  (rf-pc! a)
  (let* ((ya (rf-congr! a a))
         (yw (rf-congr! a w))
         (pd (dk-cite! 'onb-partial-diff 'v 'ix 'e za a w))
         (psa (dk-split-all! (list (dk-cite! 'onb-partial-sums 'v 'ix 'e za a))))
         (psw (dk-split-all! (list (dk-cite! 'onb-partial-sums 'v 'ix 'e za w)))))
    (let* ((h1 (dk-rewrite-h! pd (cadr ya) (rf-P a)))
           (h2 (dk-rewrite-h! h1 (cadr yw) (rf-P w)))
           (h3 (dk-rewrite-h! h2 (car yw) (rf-Z w)))
           (h4 (dk-rewrite-h! h3 (car ya) za))
           (ra (dk-rewrite-h! (list 'IN (cadr ya) 'RR) (cadr ya) (rf-P a)))
           (rw (dk-rewrite-h! (list 'IN (cadr yw) 'RR) (cadr yw) (rf-P w))))
      (dk-conj-close! (lambda () (dk-ass!))))))
(rf-done! 'rf-partial-diff)

;;; ---------------------------------------------------------------------------
;;; THE CAUCHY NET.  If moreover sum_k |c_k|^2 < +inf, the family c_k e_k is a Cauchy net in the
;;; normed group of v (hilbert-onb.scm's onb-expansion-cauchy-net, with Pythagoras above).
(define (rf-NV grp) (list 'NORMED-AG-AS-ABELIAN-GROUP grp))
(define (rf-S grp f w) (list 'FINSUM (rf-NV grp) f w))
(define (rf-M grp) (list 'NAG-METRIC-SPACE grp))
(define (rf-d grp x y) (list (list 'DIST (rf-M grp)) x y))
(define (rf-cn-q grp f fin r)
  (list 'FORALL 'cna_ (list 'IMPLIES '(IN cna_ SET) (list 'IMPLIES '(IN (CARD cna_) NN)
    (list 'IMPLIES (list 'SUBSET fin 'cna_) (list 'IMPLIES (list 'SUBSET 'cna_ (list 'DOM f))
      (list 'FORALL 'cnb_ (list 'IMPLIES '(IN cnb_ SET) (list 'IMPLIES '(IN (CARD cnb_) NN)
        (list 'IMPLIES (list 'SUBSET fin 'cnb_) (list 'IMPLIES (list 'SUBSET 'cnb_ (list 'DOM f))
          (list '< (rf-d grp (rf-S grp f 'cna_) (rf-S grp f 'cnb_)) r))))))))))))
(define (rf-cn-fin grp f fin r)
  (list 'AND (list 'IN fin 'SET)
    (list 'AND (list 'IN (list 'CARD fin) 'NN)
      (list 'AND (list 'SUBSET fin (list 'DOM f)) (rf-cn-q grp f fin r)))))
(define (rf-cn grp f)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'fin (rf-cn-fin grp f 'fin 'eps)))))
(define rf-E (list 'ESUM rf-Q))
;; Q in FUN(ix, RPS), DOM Q = ix, Q in FUN(DOM Q, RPS); ix in SET in context
(define (rf-Q-dom!)
  (let ((dg (list 'DOM rf-Q)))
    (dk-have! (list 'IN rf-Q '(FUN ix RR-POS-STAR))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let* ((k (dk-di-var!)) (m (rf-sq (list 'c k))))
              (rf-m2-facts! k)
              (let ((iff (dk-cite! 'rr-pos-star-membership m)))
                (if (dk-only! iff (list 'IN m 'RR) (list '<= 0 m)) (prop)))))
          (lambda () (ass)))))
    (dk-project! (list 'IN rf-Q '(FUN ix)) 'fun-codomain-iff (list 'IN rf-Q '(FUN ix RR-POS-STAR)))
    (rf-and! (list 'IN rf-Q '(FUN ix)) '(IN ix SET))
    (fact 'dom-of-fun 'ix rf-Q)
    (let ((dd2 (dk-ctx-form (list 'AND (list 'IN dg 'SET) (list '= dg 'ix)))))
      (if dd2 (dk-split-all! (list dd2))))
    (dk-have! (list 'IN rf-Q (list 'FUN dg 'RR-POS-STAR))
      (lambda () (subst (list '= dg 'ix)) (dk-ass!)))))
;; cf in FUN(ix, VEC), DOM cf = ix, cf in FUN(DOM cf, CARR G)
(define (rf-cf-dom!)
  (let ((dc (list 'DOM rf-cf)))
    (dk-have! (list 'IN rf-cf (list 'FUN 'ix rf-V))
      (lambda ()
        (dk-lam-type!
          (lambda () (let ((k (dk-di-var!))) (rf-k-facts! k) (dk-ass!)))
          (lambda () (ass)))))
    (dk-project! (list 'IN rf-cf '(FUN ix)) 'fun-codomain-iff (list 'IN rf-cf (list 'FUN 'ix rf-V)))
    (rf-and! (list 'IN rf-cf '(FUN ix)) '(IN ix SET))
    (fact 'dom-of-fun 'ix rf-cf)
    (let ((dd2 (dk-ctx-form (list 'AND (list 'IN dc 'SET) (list '= dc 'ix)))))
      (if dd2 (dk-split-all! (list dd2))))
    (dk-have! (list 'IN rf-cf (list 'FUN dc (list 'CARR rf-G)))
      (lambda () (subst (list '= dc 'ix)) (subst (list '== (list 'CARR rf-G) rf-V)) (dk-ass!)))))
(define (rf-dom-subs! a)
  (let ((s1 (dk-rewrite-h! (list 'SUBSET a (list 'DOM rf-cf)) (list 'DOM rf-cf) 'ix)))
    (dk-have! (list 'SUBSET a (list 'DOM rf-Q))
      (lambda () (subst (list '= (list 'DOM rf-Q) 'ix)) (dk-ass!)))
    s1))
(define (rf-cfg-setup!)
  (rf-sum-setup!)
  (rf-onf-setup!)
  (rf-Q-dom!)
  (rf-cf-dom!)
  (fact 'nag-metric-space-is-metric-space rf-G)
  (fact 'nag-metric-carrier rf-G)
  (fact 'ip-metric-space-unfold 'v))

(sp (make-wff (rf-stmt (list 'IMPLIES (list 'IN rf-E 'RR) (rf-cn rf-G rf-cf)))))
(dk-peel!)
(rf-cfg-setup!)
(let* ((eps (cadr (dk-pick (dk-head? 'POS-RR) "eps")))
       (E rf-E)
       (M (rf-M rf-G)) (dM (list 'DIST M))
       (ept (begin (fact 'rr-pos-rr-in-rr eps) eps))
       (h (dk-halve! eps))
       (hp (begin (fact 'rr-pos-rr-of-lt h) (list 'POS-RR h)))
       (h2 (dk-halve! h))
       (dl (list '* h2 h2)))
  (fact 'rr-mul-pos h2 h2)
  (rf-and! (list 'IN h2 'RR) (list 'IN h2 'RR))
  (fact 'rr-mul-closed h2 h2)
  (fact 'rr-pos-rr-of-lt dl)
  (dk-have! (list '<= 0 dl) (lambda () (dk-ineq! (list '< 0 dl) (list 'IN dl 'RR))))
  (dk-have! (list '<= 0 h2) (lambda () (dk-ineq! (list '< 0 h2) (list 'IN h2 'RR))))
  (let* ((ap (dk-cite! 'rb2-esum-approx rf-Q))
         (ex (dk-apply! ap dl))
         (t (dk-skolem! ex)))
    (dk-split-all!)
    (let* ((Zt (rf-Z t)) (Pt (rf-P t))
           (st (dk-rewrite-h! (list 'SUBSET t (list 'DOM rf-Q)) (list 'DOM rf-Q) 'ix)))
      (rf-pc! t)
      (dk-have! (list '= dl dl) (lambda () (rfl)))
      (rf-and! (list 'IN dl 'RR) (list '<= 0 dl))
      (rf-and! (list 'IN h2 'RR) (list '<= 0 h2))
      (fact 'sqrt-char dl h2)
      (dk-split-all! (list (dk-cite! 'sqrt-prop dl)))
      (dk-have! (list 'IN Zt (list 'PTS M))
        (lambda () (subst (list '== (list 'PTS M) (list 'CARR rf-G)))
                   (subst (list '== (list 'CARR rf-G) rf-V)) (dk-ass!)))
      (ew t)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-ass!) #t)
              ((dk-head-is? g 'SUBSET)
               (subst (list '= (list 'DOM rf-cf) 'ix)) (dk-ass!))
              (#t
               (let* ((ld (dk-peel!))
                      (gl (dk-goal))
                      (a (cadddr (cadr (cadr gl))))
                      (b (cadddr (caddr (cadr gl))))
                      (bound!
                        (lambda (s)
                          (let* ((Zs (rf-Z s)) (Ps (rf-P s))
                                 (d (rf-sub Zs Zt)) (q (rf-ip d d)))
                            (rf-dom-subs! s)
                            (rf-pc! s)
                            (dk-split-all! (list (dk-cite! 'rf-partial-diff 'v 'ix 'e 'c s t)))
                            (rf-and! (list 'IN s 'SET) (list 'IN (list 'CARD s) 'NN) (list 'SUBSET s (list 'DOM rf-Q)))
                            (fact 'esum-upper rf-Q s)
                            (fact 'cips-vneg-type 'v Zt)
                            (fact 'cips-vadd-type 'v Zs (list '(VNEG v) Zt))
                            (fact 'cips-ip-self-real 'v d)
                            (fact 'cips-ip-self-nonneg 'v d)
                            (dk-have! (list '<= q dl)
                              (lambda ()
                                (dk-ineq! (list '= q (list '+ Ps (list '- Pt)))
                                          (list '<= Ps E)
                                          (list '< E (list '+ Pt dl))
                                          (list 'IN q 'RR) (list 'IN Ps 'RR) (list 'IN Pt 'RR)
                                          (list 'IN E 'RR) (list 'IN dl 'RR))))
                            (rf-and! (list 'IN q 'RR) (list '<= 0 q))
                            (rf-and! (list 'IN dl 'RR) (list '<= q dl))
                            (fact 'sqrt-mono q dl)
                            (let* ((de (dk-cite! 'ip-metric-space-dist 'v Zs Zt))
                                   (de2 (dk-rewrite-h! de '(IP-METRIC-SPACE v) M)))
                              (dk-have! (list 'IN Zs (list 'PTS M))
                                (lambda () (subst (list '== (list 'PTS M) (list 'CARR rf-G)))
                                           (subst (list '== (list 'CARR rf-G) rf-V)) (dk-ass!)))
                              (fact 'metric-dist-real M Zs Zt)
                              (dk-split-all! (list (dk-cite! 'sqrt-prop q)))
                              (dk-have! (list '<= (list dM Zs Zt) h2)
                                (lambda ()
                                  (dk-ineq! de2
                                            (list '<= (list 'SQRT q) (list 'SQRT dl))
                                            (list '= (list 'SQRT dl) h2)
                                            (list 'IN (list dM Zs Zt) 'RR)
                                            (list 'IN (list 'SQRT q) 'RR)
                                            (list 'IN (list 'SQRT dl) 'RR)
                                            (list 'IN h2 'RR)))))))))
                 (dk-split-all! ld)
                 (bound! a)
                 (bound! b)
                 (let ((Za (rf-Z a)) (Zb (rf-Z b)))
                   (fact 'metric-triangle M Za Zt Zb)
                   (fact 'metric-sym M Zt Zb)
                   (for-each (lambda (pq) (fact 'metric-dist-real M (car pq) (cdr pq)))
                             (list (cons Za Zb) (cons Za Zt) (cons Zt Zb) (cons Zb Zt)))
                   (dk-ineq! (list '<= (list dM Za Zb) (list '+ (list dM Za Zt) (list dM Zt Zb)))
                             (list '= (list dM Zt Zb) (list dM Zb Zt))
                             (list '<= (list dM Za Zt) h2)
                             (list '<= (list dM Zb Zt) h2)
                             (list '= (list '+ h2 h2) h)
                             (list '= (list '+ h h) eps)
                             (list '< 0 h)
                             (list 'IN (list dM Za Zb) 'RR) (list 'IN (list dM Za Zt) 'RR)
                             (list 'IN (list dM Zt Zb) 'RR) (list 'IN (list dM Zb Zt) 'RR)
                             (list 'IN h2 'RR) (list 'IN h 'RR) (list 'IN eps 'RR))))))))))))
(rf-done! 'rf-cauchy-net)

