;;; theorem-library/rake-asm-b4.scm  (RB-4, rake-asm-b, 2026-10-12)
;;; ====================================================================
;;; submodule-of-free-is-free (Cor 3.46, linear-algebra.tex
;;; cor:22195-45888-207248): over a euclidean ring, a submodule sm of a module
;;; with a free generating sequence u of length n is spanned by a relation-free
;;; sequence w of length k <= n.  Proven under its exact name and statement
;;; (copied from theorem-library/submodule-free.scm, built with the same
;;; builders), replacing the asserted support there.
;;;
;;; PLAN (the support's warrant, made precise).
;;;   submodule-fg          sm is spanned by some v of length m <= n.
;;;   m = 0                 w := v; REL-FREE over [1,0] is vacuous.
;;;   m >= 1 (so n >= 1)
;;;   generates-coeff-matrix  v = C.u, C m-by-n.
;;;   smith-normal-form     C ~ D, SMITH-STAIRCASE(D, kk): D = U C V.
;;;   rb4-equiv-act         U.v = U.(C.u) = D.(W.u), W = V^-1 invertible.
;;;   free-transport        e := W.u is relation-free.
;;;   spans-transport       U.v = D.e spans sm.
;;;   rb4-act-entry-zero-row  (D.e)_i = 0 past kk (rows of D vanish there).
;;;   rb4-span-trunc        so w := BLOCK(D.e, kk, 1) spans sm.
;;;   rb4-act-entry-single  w_i = D_ii . e_i (D diagonal).
;;;   rb4-diag-rel-free     D_ii /= 0 for i <= kk, e relation-free, integral
;;;                         domain  =>  w relation-free.
;;; Bricks proven here: rb4-finsum-ag-pad-ptwise (the abelian-group twin of
;;; finsum-cm-pad-ptwise, which loads at 3401 and is stated for a commutative
;;; monoid), rb4-lincomb-trunc, rb4-matmul-entry-single.
;;;
;;; LOAD WINDOW: after theorem-library/spans-transport-proof (its latest
;;; citation, spans-transport); nothing later cites submodule-of-free-is-free and
;;; pss-topics does not name it.  Library: linear-algebra.
;;; ====================================================================

;; ---- helpers (rb4- prefix) ----
(define (rb4-syms x)
  (cond ((symbol? x) (list x)) ((pair? x) (append (rb4-syms (car x)) (rb4-syms (cdr x)))) (#t '())))
(define (rb4-ptw u body-of)
  (let* ((used (append (rb4-syms u) (rb4-syms (body-of 'rb4-dummy))))
         (b    (let loop ((cs '(z_ zz_ zq_ zr_ zs_ zt_)))
                 (if (memq (car cs) used) (loop (cdr cs)) (car cs)))))
    (list 'FORALL b (list 'IMPLIES (list 'IN b u) (body-of b)))))
(define (rb4-fin-sub! big sub memb!)
  (let ((incl (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z sub) (list 'IN 'z big)))))
    (dk-have! incl (lambda () (let ((w (dk-di-var!))) (memb! w))))
    (dk-have! (list 'SUBSET sub big)
      (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (inst+ incl w) (ass))))
    (fact 'subclass-of-set-is-set sub big)
    (dk-have! (list 'AND (list 'IN big 'SET) (list 'IN (list 'CARD big) 'NN)))
    (dk-have! (list 'AND (list 'IN sub 'SET) incl))
    (fact 'card-subset-nn big sub)))


;; statement builder: (rb4-fa VARS HYPS BODY) = forall VARS. HYP1 => ... => BODY
(define (rb4-fa vs hs body)
  (fold-right (lambda (v b) (list 'FORALL v b)) (fold-right (lambda (h b) (list 'IMPLIES h b)) body hs) vs))

;;; =====================================================================
;;; rb4-finsum-ag-pad-ptwise: the abelian-group twin of finsum-cm-pad-ptwise
;;; (integral-laws.scm, which loads far too late to cite and is stated for a
;;; commutative monoid).  Summing over a finite superset T of R adds nothing
;;; when the summand is the identity on T \ R.  Same proof, AG bricks.
;;; =====================================================================
(sp (make-wff
     '(FORALL ag (IMPLIES (IS-ABELIAN-GROUP ag)
        (FORALL T (IMPLIES (IN T SET) (IMPLIES (IN (CARD T) NN)
          (FORALL R (IMPLIES (FORALL z_ (IMPLIES (IN z_ R) (IN z_ T)))
            (FORALL g
              (IMPLIES (FORALL z_ (IMPLIES (IN z_ T) (IN (g z_) (CARR ag))))
              (IMPLIES (FORALL z_ (IMPLIES (IN z_ T) (IMPLIES (NOT (IN z_ R)) (= (g z_) (IDEN ag)))))
                (= (FINSUM ag g T) (FINSUM ag g R))))))))))))))
(dk-peel!)
(let* ((d   '(COMPLEMENT-IN t r))
       (rd  (list 'UNION 'r d))
       (inc '(FORALL z_ (IMPLIES (IN z_ r) (IN z_ t))))
       (tg  (lambda (z) (list 'IN (list 'g z) '(CARR ag)))))
  (rb4-fin-sub! 't 'r (lambda (w) (inst+ inc w) (ass)))
  (fact 'complement-in-set-closure 't 'r)
  (rb4-fin-sub! 't d
    (lambda (w) (mac-h 'complement-in-membership (list 'IN w d)) (dk-split-all!) (ass)))
  (dk-have! '(SUBSET r t)
    (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (inst+ inc w) (ass))))
  (fact 'union-complement-in 'r 't)
  (dk-have! (rb4-ptw d (lambda (z) (list 'NOT (list 'IN z 'r))))
    (lambda ()
      (let ((w (dk-di-var!)))
        (mac-h 'complement-in-membership (list 'IN w d))
        (dk-split-all!)
        (ass))))
  (dk-have! (rb4-ptw rd tg)
    (lambda () (subst (list '= rd 't)) (ass)))
  (fact 'finsum-union-disjoint 'ag 'r d 'g)
  (dk-have! (rb4-ptw d (lambda (z) (list '= (list 'g z) '(IDEN ag))))
    (lambda ()
      (let ((w (dk-di-var!)))
        (mac-h 'complement-in-membership (list 'IN w d))
        (dk-split-all!)
        (inst+ '(FORALL z_ (IMPLIES (IN z_ t) (IMPLIES (NOT (IN z_ r)) (= (g z_) (IDEN ag))))) w)
        (ass))))
  (fact 'finsum-all-id-ptwise 'ag d 'g)
  (dk-have! (rb4-ptw 'r tg)
    (lambda () (let ((w (dk-di-var!))) (inst+ inc w) (inst+ (rb4-ptw 't tg) w) (ass))))
  (fact 'finsum-type-ptwise 'ag 'r 'g)
  (fact 'finsum-type-ptwise 'ag 't 'g)
  (fact 'abelian-group-right-id 'ag '(FINSUM ag g r))
  (dk-congr! (list '= rd 't) (lambda (x) (list 'FINSUM 'ag 'g x)))
  (subst (list '= '(FINSUM ag g t) (list 'FINSUM 'ag 'g rd)))
  (subst (list '= (list 'FINSUM 'ag 'g rd) (list '(OPR ag) '(FINSUM ag g r) (list 'FINSUM 'ag 'g d))))
  (subst (list '= (list 'FINSUM 'ag 'g d) '(IDEN ag)))
  (ass))
(qed 'rb4-finsum-ag-pad-ptwise)

;;; =====================================================================
;;; rb4-lincomb-trunc: a combination whose summands vanish past kk is its
;;; initial segment of length kk.  (LINCOMB reads only the entries it sums, so
;;; the SAME c and y serve both lengths.)
;;; =====================================================================
(define rb4-K   '(CARR (SCAL md)))
(define rb4-VAG '(MODULE-VECTOR-AG md))
(define (rb4-lam c y len) (list 'VNB-LAMBDA 'j (list 'INTERVAL 1 len)
                                (list '(ACT md) (list 'ENTRY c 1 'j) (list 'ENTRY y 'j 1))))
(define (rb4-sum f len) (list 'FINSUM rb4-VAG f (list 'INTERVAL 1 len)))
;; type the summand c_{1z}.y_{z1} at an index z with z in [1,len] in context
(define (rb4-act-type! c y len z)
  (fact 'one-in-interval-1)
  (fact 'entry-in-carrier 1 len rb4-K c 1 z)
  (fact 'entry-in-carrier len 1 '(VEC md) y z 1)
  (fact 'module-act-type 'md (list 'ENTRY c 1 z) (list 'ENTRY y z 1)))

(sp (make-wff
  '(FORALL md (IMPLIES (IS-MODULE md)
     (FORALL m (FORALL kk (FORALL c (FORALL y
       (IMPLIES (IN c (MAT 1 m (CARR (SCAL md))))
       (IMPLIES (IN y (MAT m 1 (VEC md)))
       (IMPLIES (IN kk NN)
       (IMPLIES (<= kk m)
       (IMPLIES (FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 m))
                  (IMPLIES (NOT (<= j_ kk))
                    (= ((ACT md) (ENTRY c 1 j_) (ENTRY y j_ 1)) (VZERO md)))))
         (= (LINCOMB md m c y) (LINCOMB md kk c y)))))))))))))))
(dk-peel!)
(define rb4-tr-hyp '(FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 m))
                  (IMPLIES (NOT (<= j_ kk))
                    (= ((ACT md) (ENTRY c 1 j_) (ENTRY y j_ 1)) (VZERO md))))))
(fact 'mat-cols-in-nn 1 'm rb4-K 'c)
(fact 'module-scalar-ring 'md)
(fact 'module-vector-ag-is-abelian-group 'md)
(fact 'mvag-carr 'md)
(fact 'mvag-id 'md)
(fact 'interval-in-set 1 'm) (fact 'interval-card-in-nn 1 'm)
(fact 'interval-in-set 1 'kk) (fact 'interval-card-in-nn 1 'kk)
(fact 'lincomb-unfold 'md 'm 'c 'y)
(fact 'lincomb-unfold 'md 'kk 'c 'y)
(subst (list '== '(LINCOMB md m c y) (rb4-sum (rb4-lam 'c 'y 'm) 'm)))
(subst (list '== '(LINCOMB md kk c y) (rb4-sum (rb4-lam 'c 'y 'kk) 'kk)))
(let* ((lm (rb4-lam 'c 'y 'm))
       (lk (rb4-lam 'c 'y 'kk))
       (inc '(FORALL z_ (IMPLIES (IN z_ (INTERVAL 1 kk)) (IN z_ (INTERVAL 1 m))))))
  (dk-have! inc
    (lambda () (let ((w (dk-di-var!))) (fact 'interval-widen 'kk 'm 1 w) (ass))))
  ;; the summand is typed on [1,m]
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ (INTERVAL 1 m))
                                    (list 'IN (list lm 'z_) (list 'CARR rb4-VAG))))
    (lambda ()
      (let ((w (dk-di-var!)))
        (lam-b)
        (subst (list '= (list 'CARR rb4-VAG) '(VEC md)))
        (rb4-act-type! 'c 'y 'm w)
        (ass))))
  ;; ... and is the identity off [1,kk]
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ (INTERVAL 1 m))
                    (list 'IMPLIES '(NOT (IN z_ (INTERVAL 1 kk)))
                                    (list '= (list lm 'z_) (list 'IDEN rb4-VAG)))))
    (lambda ()
      (let ((w (dk-di-var!)))
        (di)                                   ; NOT (w in [1,kk])
        (lam-b)
        (subst (list '= (list 'IDEN rb4-VAG) '(VZERO md)))
        (fact 'interval-elt-in-nn 1 'm w)
        (fact 'interval-lo 1 'm w)
        (dk-have! (list 'NOT (list '<= w 'kk))
          (lambda ()
            (di)
            (fact 'interval-mem-intro 1 'kk w)
            (ai (list 'NOT (list 'IN w '(INTERVAL 1 kk))))))
        (inst+ rb4-tr-hyp w)
        (ass))))
  (fact 'rb4-finsum-ag-pad-ptwise rb4-VAG '(INTERVAL 1 m) '(INTERVAL 1 kk) lm)
  ;; the [1,kk] sum of the long summand is the [1,kk] sum of the short one
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ (INTERVAL 1 kk))
                                    (list '= (list lm 'z_) (list lk 'z_))))
    (lambda ()
      (let ((w (dk-di-var!)))
        (inst+ inc w)
        (rb4-act-type! 'c 'y 'm w)
        (dk-lam-b!)
        (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
  (fact 'finsum-congruence-q rb4-VAG '(INTERVAL 1 kk) lm lk)
  (subst (list '= (rb4-sum lk 'kk) (rb4-sum lm 'kk)))
  (ass))
(qed 'rb4-lincomb-trunc)


;;; =====================================================================
;;; rb4-act-entry-single: if row i of P vanishes off the diagonal, the i-th
;;; entry of P.e is P_ii . e_i.   rb4-act-entry-zero-row: if row i of P
;;; vanishes, the i-th entry of P.e is the zero vector.
;;; =====================================================================
(define (rb4-act-lam P e i) (list 'VNB-LAMBDA 'j '(INTERVAL 1 n)
                               (list '(ACT md) (list 'ENTRY P i 'j) (list 'ENTRY e 'j 1))))
(sp (make-wff
  (rb4-fa '(md) '((IS-MODULE md))
   (rb4-fa '(m n P e i)
     '((IN P (MAT m n (CARR (SCAL md))))
       (IN e (MAT n 1 (VEC md)))
       (IN i (INTERVAL 1 m))
       (IN i (INTERVAL 1 n))
       (FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 n))
                  (IMPLIES (NOT (= j_ i)) (= (ENTRY P i j_) (ZERO (SCAL md)))))))
     '(= (ENTRY (MATACT md P e) i 1) ((ACT md) (ENTRY P i i) (ENTRY e i 1)))))))
(dk-peel!)
(fact 'mat-cols-in-nn 'm 'n rb4-K 'P)
(dk-one-le-from! 'i 'n)
(fact 'module-scalar-ring 'md)
(fact 'module-vector-ag-is-abelian-group 'md)
(fact 'mvag-id 'md)
(fact 'one-in-interval-1)
(fact 'interval-in-set 1 'n) (fact 'interval-card-in-nn 1 'n)
(let ((L (rb4-act-lam 'P 'e 'i))
      (hyp '(FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 n))
                  (IMPLIES (NOT (= j_ i)) (= (ENTRY P i j_) (ZERO (SCAL md))))))))
  (fact 'matact-entry 'md 'm 'n 1 'P 'e 'i 1)
  (subst (list '= '(ENTRY (MATACT md P e) i 1) (list 'FINSUM rb4-VAG L '(INTERVAL 1 n))))
  (fact 'matact-summand-type 'md 'm 'n 1 'P 'e 'i 1)
  (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 n))
               (list 'IMPLIES '(NOT (= j i)) (list '= (list L 'j) (list 'IDEN rb4-VAG)))))
    (lambda ()
      (let ((w (dk-di-var!)))
        (di)
        (lam-b)
        (subst (list '= (list 'IDEN rb4-VAG) '(VZERO md)))
        (inst+ hyp w)
        (subst (list '= (list 'ENTRY 'P 'i w) '(ZERO (SCAL md))))
        (fact 'entry-in-carrier 'n 1 '(VEC md) 'e w 1)
        (fact 'module-zero-act 'md (list 'ENTRY 'e w 1))
        (ass))))
  (fact 'finsum-single-support rb4-VAG '(INTERVAL 1 n) L 'i)
  (subst (list '= (list 'FINSUM rb4-VAG L '(INTERVAL 1 n)) (list L 'i)))
  (fact 'entry-in-carrier 'm 'n rb4-K 'P 'i 'i)
  (fact 'entry-in-carrier 'n 1 '(VEC md) 'e 'i 1)
  (fact 'module-act-type 'md '(ENTRY P i i) '(ENTRY e i 1))
  (if (not (dk-lam-b!)) (rfl)))
(qed 'rb4-act-entry-single)

(sp (make-wff
  (rb4-fa '(md) '((IS-MODULE md))
   (rb4-fa '(m n P e i)
     '((IN P (MAT m n (CARR (SCAL md))))
       (IN e (MAT n 1 (VEC md)))
       (IN i (INTERVAL 1 m))
       (<= 1 n)
       (FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 n)) (= (ENTRY P i j_) (ZERO (SCAL md))))))
     '(= (ENTRY (MATACT md P e) i 1) (VZERO md))))))
(dk-peel!)
(fact 'mat-cols-in-nn 'm 'n rb4-K 'P)
(fact 'module-scalar-ring 'md)
(fact 'module-vector-ag-is-abelian-group 'md)
(fact 'mvag-id 'md)
(fact 'one-in-interval-1)
(fact 'interval-in-set 1 'n) (fact 'interval-card-in-nn 1 'n)
(let ((L (rb4-act-lam 'P 'e 'i))
      (hyp '(FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 n)) (= (ENTRY P i j_) (ZERO (SCAL md)))))))
  (fact 'matact-entry 'md 'm 'n 1 'P 'e 'i 1)
  (subst (list '= '(ENTRY (MATACT md P e) i 1) (list 'FINSUM rb4-VAG L '(INTERVAL 1 n))))
  (fact 'matact-summand-type 'md 'm 'n 1 'P 'e 'i 1)
  (dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z (INTERVAL 1 n))
                                   (list '= (list L 'z) (list 'IDEN rb4-VAG))))
    (lambda ()
      (let ((w (dk-di-var!)))
        (lam-b)
        (subst (list '= (list 'IDEN rb4-VAG) '(VZERO md)))
        (inst+ hyp w)
        (subst (list '= (list 'ENTRY 'P 'i w) '(ZERO (SCAL md))))
        (fact 'entry-in-carrier 'n 1 '(VEC md) 'e w 1)
        (fact 'module-zero-act 'md (list 'ENTRY 'e w 1))
        (ass))))
  (fact 'finsum-all-id rb4-VAG '(INTERVAL 1 n) L)
  (subst (list '= (list 'FINSUM rb4-VAG L '(INTERVAL 1 n)) (list 'IDEN rb4-VAG)))
  (subst (list '= (list 'IDEN rb4-VAG) '(VZERO md)))
  (fact 'module-vzero-in 'md)
  (rfl))
(qed 'rb4-act-entry-zero-row)

;;; =====================================================================
;;; rb4-matmul-entry-single: the ring twin -- if column cl of Q vanishes off
;;; the diagonal, (P Q)_{rw,cl} = P_{rw,cl} Q_{cl,cl}.
;;; =====================================================================
(sp (make-wff
  (rb4-fa '(A) '((IS-RING A))
   (rb4-fa '(m n k P Q rw cl)
     '((IN P (MAT m n (CARR A)))
       (IN Q (MAT n k (CARR A)))
       (IN rw (INTERVAL 1 m))
       (IN cl (INTERVAL 1 n))
       (IN cl (INTERVAL 1 k))
       (FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 n))
                  (IMPLIES (NOT (= i_ cl)) (= (ENTRY Q i_ cl) (ZERO A))))))
     '(= (ENTRY (MATMUL A P Q) rw cl) ((MUL A) (ENTRY P rw cl) (ENTRY Q cl cl)))))))
(dk-peel!)
(fact 'mat-cols-in-nn 'm 'n '(CARR A) 'P)
(dk-one-le-from! 'cl 'n)
(fact 'ring-additive-ag-is-abelian-group 'A)
(fact 'ras-id 'A)
(fact 'interval-in-set 1 'n) (fact 'interval-card-in-nn 1 'n)
(let ((L '(VNB-LAMBDA j (INTERVAL 1 n) ((MUL A) (ENTRY P rw j) (ENTRY Q j cl))))
      (RAG '(RING-ADDITIVE-AG A))
      (hyp '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 n))
                  (IMPLIES (NOT (= i_ cl)) (= (ENTRY Q i_ cl) (ZERO A)))))))
  (fact 'matmul-entry 'A 'm 'n 'k 'P 'Q 'rw 'cl)
  (subst (list '= '(ENTRY (MATMUL A P Q) rw cl) (list 'FINSUM RAG L '(INTERVAL 1 n))))
  (fact 'matprod-summand-type 'A 'm 'n 'k 'P 'Q 'rw 'cl)
  (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 n))
               (list 'IMPLIES '(NOT (= j cl)) (list '= (list L 'j) (list 'IDEN RAG)))))
    (lambda ()
      (let ((w (dk-di-var!)))
        (di)
        (lam-b)
        (subst (list '= (list 'IDEN RAG) '(ZERO A)))
        (inst+ hyp w)
        (subst (list '= (list 'ENTRY 'Q w 'cl) '(ZERO A)))
        (fact 'entry-in-carrier 'm 'n '(CARR A) 'P 'rw w)
        (fact 'ring-mul-zero-right 'A (list 'ENTRY 'P 'rw w))
        (ass))))
  (fact 'finsum-single-support RAG '(INTERVAL 1 n) L 'cl)
  (subst (list '= (list 'FINSUM RAG L '(INTERVAL 1 n)) (list L 'cl)))
  (fact 'entry-in-carrier 'm 'n '(CARR A) 'P 'rw 'cl)
  (fact 'entry-in-carrier 'n 'k '(CARR A) 'Q 'cl 'cl)
  (if (not (dk-lam-b!)) (rfl)))
(qed 'rb4-matmul-entry-single)

;;; =====================================================================
;;; rb4-diag-rel-free: w_i = D_ii . e_i (i <= kk) with D diagonal, its first kk
;;; diagonal entries nonzero, e relation-free, over an integral domain  =>
;;; w is relation-free.  If c.w = 0 put B = BLOCK(D,kk,n), so B.e = w; then
;;; (cB).e = c.(B.e) = c.w = 0, so cB = 0 by REL-FREE of e; and (cB)_j =
;;; c_j D_jj, so c_j = 0 by cancellation.
;;; =====================================================================
;; (IMPLIES (= v 0) concl) with (<= 1 v) and (IN v NN) in context: vacuous.
(define (rb4-guard! v concl)
  (let ((g (list 'IMPLIES (list '= v 0) concl)))
    (dk-have! g
      (lambda ()
        (if (not (dk-asm? (list 'IN v 'RR))) (fact 'nn-in-rr v))
        (di) (pbc)
        (dk-absurd! (list '= v 0) (list '<= 1 v))))
    g))
;; close a goal built of AND and FORSOME from context, witnessing the
;; existentials in order with WITS
(define (rb4-close-with! wits)
  (letrec ((closer (lambda ()
             (let ((g (dk-goal)))
               (if (and (pair? g) (eq? (car g) 'FORSOME))
                   (let ((w (car wits)))
                     (set! wits (cdr wits))
                     (ew w)
                     (dk-conj-close! closer))
                   (from-context!))))))
    (dk-conj-close! closer)))
;; the variable of the typing (IN v CLS) among landed formulas
(define (rb4-var-in ls cls)
  (let ((f (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN) (equal? (caddr f) cls))) ls)))
    (if f (cadr f) (error "rb4-var-in: no typing in" cls ls))))
;; j in [1,1] in context: land j = 1
(define (rb4-one! j)
  (fact 'interval-elt-in-nn 1 1 j)
  (fact 'interval-lo 1 1 j)
  (fact 'interval-hi 1 1 j)
  (dk-have! (list '= j 1) (lambda () (dk-nn! (list '<= 1 j) (list '<= j 1)))))
;; i in [1,a], a <= b (a, b in NN): land i in [1,b]
(define (rb4-widen! i a b)
  (if (not (dk-asm? (list 'IN i (list 'INTERVAL 1 b))))
      (fact 'interval-widen a b 1 i)))

(sp (make-wff
  (rb4-fa '(md) '((IS-MODULE md) (IS-INTEGRAL-DOMAIN (SCAL md)))
   (rb4-fa '(m n kk D e w)
     '((IN m NN) (IN n NN) (IN kk NN) (<= kk m) (<= kk n)
       (IN D (MAT m n (CARR (SCAL md))))
       (IS-DIAGONAL (SCAL md) m n D)
       (FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 kk)) (NOT (= (ENTRY D i_ i_) (ZERO (SCAL md))))))
       (IN e (MAT n 1 (VEC md)))
       (REL-FREE md n e)
       (IN w (MAT kk 1 (VEC md)))
       (FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 kk))
                    (= (ENTRY w i_ 1) ((ACT md) (ENTRY D i_ i_) (ENTRY e i_ 1))))))
     '(REL-FREE md kk w)))))
(dk-peel!)
(fact 'module-scalar-ring 'md)
(fact 'integral-domain-is-commutative-ring '(SCAL md))
(fact 'one-in-interval-1)
(fact 'nn-one-in)
(mac 'REL-FREE)
(define rb4-rf-landed (dk-peel!))
(define rb4-rf-c
  (cadr (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN) (pair? (caddr f))
                                     (eq? (car (caddr f)) 'MAT) (equal? (cadr (caddr f)) 1)))
                    rb4-rf-landed)))
(define rb4-rf-j
  (cadr (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN)
                                     (equal? (caddr f) '(INTERVAL 1 kk))))
                    rb4-rf-landed)))
(let* ((c rb4-rf-c) (j rb4-rf-j)
       (B '(BLOCK D kk n))
       (Be `(MATACT md ,B e))
       (c2 `(MATMUL (SCAL md) ,c ,B)))
  (dk-one-le-from! j 'kk)
  (fact 'nn-in-rr 'kk) (fact 'nn-in-rr 'n)
  (dk-have! '(<= 1 n) (lambda () (dk-ineq! '(<= 1 kk) '(<= kk n))))
  (dk-have! '(<= n n) (lambda () (dk-nn!)))
  (fact 'block-type 'm 'n rb4-K 'D 'kk 'n)
  ;; ---- B.e = w ----
  (rb4-guard! 'n '(OR (= kk 0) (= 1 0)))
  (fact 'matact-type 'md 'kk 'n 1 B 'e)
  (dk-have! `(= ,Be w)
    (lambda ()
      (dk-have! `(FORALL i (IMPLIES (IN i (INTERVAL 1 kk))
                   (FORALL j (IMPLIES (IN j (INTERVAL 1 1))
                     (= (ENTRY ,Be i j) (ENTRY w i j))))))
        (lambda ()
          (let* ((ls (dk-peel!))
                 (ii (rb4-var-in ls '(INTERVAL 1 kk)))
                 (jj (rb4-var-in ls '(INTERVAL 1 1))))
            (rb4-one! jj)
            (subst (list '= jj 1))
            (rb4-widen! ii 'kk 'm) (rb4-widen! ii 'kk 'n)
            ;; row ii of B vanishes off the diagonal
            (dk-have! `(FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 n))
                          (IMPLIES (NOT (= j_ ,ii)) (= (ENTRY ,B ,ii j_) (ZERO (SCAL md))))))
              (lambda ()
                (let ((q (dk-di-var!)))
                  (di)
                  (fact 'entry-of-block 'D 'kk 'n ii q 'm 'n rb4-K)
                  (subst (list '= (list 'ENTRY B ii q) (list 'ENTRY 'D ii q)))
                  (dk-have! (list 'NOT (list '= ii q))
                    (lambda () (di)
                      (dk-have! (list '= q ii) (lambda () (subst (list '= q ii)) (rfl)))
                      (ai (list 'NOT (list '= q ii)))))
                  (fact 'diagonal-off-entry '(SCAL md) 'm 'n 'D ii q)
                  (ass))))
            (fact 'rb4-act-entry-single 'md 'kk 'n B 'e ii)
            (subst (list '= (list 'ENTRY Be ii 1)
                         (list '(ACT md) (list 'ENTRY B ii ii) (list 'ENTRY 'e ii 1))))
            (fact 'entry-of-block 'D 'kk 'n ii ii 'm 'n rb4-K)
            (subst (list '= (list 'ENTRY B ii ii) (list 'ENTRY 'D ii ii)))
            (inst+ '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 kk))
                    (= (ENTRY w i_ 1) ((ACT md) (ENTRY D i_ i_) (ENTRY e i_ 1))))) ii)
            (subst (list '= (list 'ENTRY 'w ii 1)
                         (list '(ACT md) (list 'ENTRY 'D ii ii) (list 'ENTRY 'e ii 1))))
            (rfl))))
      (fact 'matrix-entry-extensionality 'kk 1 '(VEC md) Be 'w)
      (ass)))
  ;; ---- c2 = c B annihilates e ----
  (rb4-guard! 'kk '(OR (= 1 0) (= n 0)))
  (fact 'matmul-type '(SCAL md) 1 'kk 'n c B)
  (rb4-guard! 'kk '(OR (= 1 0) (AND (= n 0) (= 1 0))))
  (rb4-guard! 'n '(OR (= 1 0) (AND (= kk 0) (= 1 0))))
  (fact 'matact-assoc 'md 1 'kk 'n 1 c B 'e)
  (fact 'matact-lincomb 'md 'n c2 'e)
  (fact 'matact-lincomb 'md 'kk c 'w)
  (fact 'module-vzero-in 'md)
  (dk-have! `(= (LINCOMB md n ,c2 e) (VZERO md))
    (lambda ()
      (subst `(= (LINCOMB md n ,c2 e) (ENTRY (MATACT md ,c2 e) 1 1)))
      (subst `(= (MATACT md ,c2 e) (MATACT md ,c ,Be)))
      (subst `(= ,Be w))
      (subst `(= (ENTRY (MATACT md ,c w) 1 1) (LINCOMB md kk ,c w)))
      (subst `(= (LINCOMB md kk ,c w) (VZERO md)))
      (rfl)))
  (rb4-widen! j 'kk 'n)
  (mac-h 'REL-FREE '(REL-FREE md n e))
  (inst+ `(FORALL c_ (IMPLIES (IN c_ (MAT 1 n (CARR (SCAL md))))
            (IMPLIES (= (LINCOMB md n c_ e) (VZERO md))
              (FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 n)) (= (ENTRY c_ 1 j_) (ZERO (SCAL md))))))))
         c2)
  (inst+ `(FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 n)) (= (ENTRY ,c2 1 j_) (ZERO (SCAL md))))) j)
  ;; ---- (c B)_{1j} = c_{1j} D_jj ----
  (dk-have! `(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 kk))
               (IMPLIES (NOT (= i_ ,j)) (= (ENTRY ,B i_ ,j) (ZERO (SCAL md))))))
    (lambda ()
      (let ((q (dk-di-var!)))
        (di)
        (rb4-widen! q 'kk 'm)
        (fact 'entry-of-block 'D 'kk 'n q j 'm 'n rb4-K)
        (subst (list '= (list 'ENTRY B q j) (list 'ENTRY 'D q j)))
        (fact 'diagonal-off-entry '(SCAL md) 'm 'n 'D q j)
        (ass))))
  (fact 'rb4-matmul-entry-single '(SCAL md) 1 'kk 'n c B 1 j)
  (fact 'entry-of-block 'D 'kk 'n j j 'm 'n rb4-K)
  (fact 'entry-in-carrier 1 'kk rb4-K c 1 j)
  (rb4-widen! j 'kk 'm)
  (fact 'entry-in-carrier 'm 'n rb4-K 'D j j)
  (inst+ '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 kk)) (NOT (= (ENTRY D i_ i_) (ZERO (SCAL md)))))) j)
  (dk-have! `(= ((MUL (SCAL md)) (ENTRY ,c 1 ,j) (ENTRY D ,j ,j)) (ZERO (SCAL md)))
    (lambda ()
      (subst `(= (ENTRY D ,j ,j) (ENTRY ,B ,j ,j)))
      (subst `(= ((MUL (SCAL md)) (ENTRY ,c 1 ,j) (ENTRY ,B ,j ,j)) (ENTRY ,c2 1 ,j)))
      (ass)))
  (fact 'integral-domain-cancel-zero '(SCAL md) (list 'ENTRY c 1 j) (list 'ENTRY 'D j j))
  (ass))
(qed 'rb4-diag-rel-free)

;;; =====================================================================
;;; rb4-span-trunc: if y spans sm and its entries past kk vanish, its leading
;;; kk entries span sm.  (x = c.y = c'.y' with c' the leading kk coefficients,
;;; by rb4-lincomb-trunc.)
;;; =====================================================================
(sp (make-wff
  (rb4-fa '(md) '((IS-MODULE md))
   (rb4-fa '(m kk y sm)
     '((IN m NN) (IN kk NN) (<= kk m)
       (IN y (MAT m 1 (VEC md)))
       (SPANS md m y sm)
       (FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 m))
                    (IMPLIES (NOT (<= j_ kk)) (= (ENTRY y j_ 1) (VZERO md))))))
     '(SPANS md kk (BLOCK y kk 1) sm)))))
(dk-peel!)
(fact 'module-scalar-ring 'md)
(fact 'module-vector-ag-is-abelian-group 'md)
(fact 'one-in-interval-1)
(fact 'nn-one-in)
(fact 'nn-in-rr 'kk) (fact 'nn-in-rr 'm)
(dk-have! '(<= 1 1) (lambda () (dk-nn!)))
(fact 'block-type 'm 1 '(VEC md) 'y 'kk 1)
(fact 'interval-in-set 1 'kk) (fact 'interval-card-in-nn 1 'kk)
(define rb4-st-conjs (dk-split! (dk-landed-1 (lambda () (mac-h 'SPANS '(SPANS md m y sm))))))
(define rb4-st-ent (find-first (lambda (f) (dk-contains? f '(IN (ENTRY y j_ 1) sm))) rb4-st-conjs))
(define rb4-st-comb (find-first (lambda (f) (dk-contains? f 'FORSOME)) rb4-st-conjs))
(let* ((w '(BLOCK y kk 1))
       (g1 `(FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 kk)) (IN (ENTRY ,w j_ 1) sm))))
       (g2 `(FORALL x_ (IMPLIES (IN x_ sm)
              (FORSOME c_ (AND (IN c_ (MAT 1 kk (CARR (SCAL md))))
                               (= x_ (LINCOMB md kk c_ ,w))))))))
  (dk-have! g1
    (lambda ()
      (let ((j (dk-di-var!)))
        (rb4-widen! j 'kk 'm)
        (fact 'entry-of-block 'y 'kk 1 j 1 'm 1 '(VEC md))
        (subst (list '= (list 'ENTRY w j 1) (list 'ENTRY 'y j 1)))
        (inst+ rb4-st-ent j)
        (ass))))
  (dk-have! g2
    (lambda ()
      (let* ((x (dk-di-var!))
             (ex (dk-deepest (lambda () (inst+ rb4-st-comb x))))
             (c (dk-skolem! ex))
             (c2 `(BLOCK ,c 1 kk))
             (lk  (rb4-lam c 'y 'kk))
             (lk2 (rb4-lam c2 w 'kk)))
        (fact 'block-type 1 'm rb4-K c 1 'kk)
        ;; the summands of c.y vanish past kk
        (dk-have! `(FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 m))
                     (IMPLIES (NOT (<= j_ kk))
                       (= ((ACT md) (ENTRY ,c 1 j_) (ENTRY y j_ 1)) (VZERO md)))))
          (lambda ()
            (let ((j (dk-di-var!)))
              (di)
              (inst+ '(FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 m))
                    (IMPLIES (NOT (<= j_ kk)) (= (ENTRY y j_ 1) (VZERO md))))) j)
              (subst (list '= (list 'ENTRY 'y j 1) '(VZERO md)))
              (fact 'entry-in-carrier 1 'm rb4-K c 1 j)
              (fact 'module-act-zero-vec 'md (list 'ENTRY c 1 j))
              (ass))))
        (fact 'rb4-lincomb-trunc 'md 'm 'kk c 'y)
        ;; c.y over [1,kk] is c'.w
        (fact 'lincomb-unfold 'md 'kk c 'y)
        (fact 'lincomb-unfold 'md 'kk c2 w)
        (dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z (INTERVAL 1 kk))
                                         (list '= (list lk 'z) (list lk2 'z))))
          (lambda ()
            (let ((z (dk-di-var!)))
              (rb4-widen! z 'kk 'm)
              (fact 'entry-of-block c 1 'kk 1 z 1 'm rb4-K)
              (fact 'entry-of-block 'y 'kk 1 z 1 'm 1 '(VEC md))
              (rb4-act-type! c 'y 'm z)
              (dk-lam-b!)
              (subst (list '= (list 'ENTRY c2 1 z) (list 'ENTRY c 1 z)))
              (subst (list '= (list 'ENTRY w z 1) (list 'ENTRY 'y z 1)))
              (rfl))))
        (fact 'finsum-congruence-q rb4-VAG '(INTERVAL 1 kk) lk lk2)
        (ew c2)
        (dk-have! `(= ,x (LINCOMB md kk ,c2 ,w))
          (lambda ()
            (subst (list '= (list 'LINCOMB 'md 'kk c2 w) (rb4-sum lk2 'kk)))
            (subst (list '= (rb4-sum lk2 'kk) (rb4-sum lk 'kk)))
            (subst (list '= (rb4-sum lk 'kk) (list 'LINCOMB 'md 'kk c 'y)))
            (subst (list '= (list 'LINCOMB 'md 'kk c 'y) (list 'LINCOMB 'md 'm c 'y)))
            (ass)))
        (dk-conj-close!))))
  (mac 'SPANS)
  (dk-conj-close!))
(qed 'rb4-span-trunc)

;;; =====================================================================
;;; rb4-equiv-act: D = U C V with U, V invertible  =>  U.(C.x) = D.(W.x), W = V^-1
;;; invertible; and D is m-by-n.
;;; =====================================================================
(sp (make-wff
  (rb4-fa '(md) '((IS-MODULE md))
   (rb4-fa '(m n cm dm xs)
     '((IN m NN) (IN n NN) (<= 1 m) (<= 1 n)
       (IN cm (MAT m n (CARR (SCAL md))))
       (IN xs (MAT n 1 (VEC md)))
       (MAT-EQUIV (SCAL md) m n cm dm))
     '(AND (IN dm (MAT m n (CARR (SCAL md))))
        (FORSOME pu_ (AND (IS-INVERTIBLE-MAT (SCAL md) m pu_)
          (FORSOME qw_ (AND (IS-INVERTIBLE-MAT (SCAL md) n qw_)
            (= (MATACT md pu_ (MATACT md cm xs)) (MATACT md dm (MATACT md qw_ xs))))))))))))
(dk-peel!)
(fact 'module-scalar-ring 'md)
(fact 'nn-in-rr 'm) (fact 'nn-in-rr 'n)
(define rb4-ea-ex1 (dk-landed-1 (lambda () (mac-h 'MAT-EQUIV '(MAT-EQUIV (SCAL md) m n cm dm)))))
(define rb4-ea-U (dk-skolem! rb4-ea-ex1))
(define rb4-ea-ex2 (find-first (lambda (f) (and (pair? f) (eq? (car f) 'FORSOME))) (dk-asms)))
(define rb4-ea-V (dk-skolem! rb4-ea-ex2))
(let* ((U rb4-ea-U) (V rb4-ea-V) (K '(SCAL md))
       (UC `(MATMUL ,K ,U cm)))
  (fact 'invertible-mat-is-mat K 'm U)
  (fact 'invertible-mat-is-mat K 'n V)
  (let* ((iv (dk-landed-1 (lambda () (mac-h 'IS-INVERTIBLE-MAT `(IS-INVERTIBLE-MAT ,K n ,V)))))
         (W (dk-skolem! (find-first (lambda (f) (and (pair? f) (eq? (car f) 'FORSOME)))
                                    (dk-split! iv)))))
    (fact 'inverse-is-invertible K 'n V W)
    (rb4-guard! 'm '(OR (= m 0) (= n 0)))
    (fact 'matmul-type K 'm 'm 'n U 'cm)
    (rb4-guard! 'n '(OR (= m 0) (= n 0)))
    (fact 'matmul-type K 'm 'n 'n UC V)
    (dk-have! '(IN dm (MAT m n (CARR (SCAL md))))
      (lambda () (subst `(= dm (MATMUL ,K ,UC ,V))) (ass)))
    (rb4-guard! 'm '(OR (= m 0) (AND (= n 0) (= 1 0))))
    (rb4-guard! 'n '(OR (= 1 0) (AND (= m 0) (= m 0))))
    (fact 'matact-assoc 'md 'm 'm 'n 1 U 'cm 'xs)
    (rb4-guard! 'n '(OR (= m 0) (AND (= n 0) (= 1 0))))
    (rb4-guard! 'n '(OR (= 1 0) (AND (= n 0) (= m 0))))
    (fact 'matact-assoc 'md 'm 'n 'n 1 'dm W 'xs)
    (rb4-guard! 'n '(OR (= m 0) (AND (= n 0) (= n 0))))
    (rb4-guard! 'n '(OR (= n 0) (AND (= n 0) (= m 0))))
    (fact 'matmul-assoc K 'm 'n 'n 'n UC V W)
    (fact 'identmat-right-identity K 'm 'n UC)
    (rb4-guard! 'n '(OR (= m 0) (= 1 0)))
    (fact 'matact-type 'md 'm 'n 1 UC 'xs)
    (dk-have! `(= (MATACT md ,U (MATACT md cm xs)) (MATACT md dm (MATACT md ,W xs)))
      (lambda ()
        (subst `(= (MATACT md ,U (MATACT md cm xs)) (MATACT md ,UC xs)))
        (subst `(= (MATACT md dm (MATACT md ,W xs)) (MATACT md (MATMUL ,K dm ,W) xs)))
        (subst `(= dm (MATMUL ,K ,UC ,V)))
        (subst `(= (MATMUL ,K (MATMUL ,K ,UC ,V) ,W) (MATMUL ,K ,UC (MATMUL ,K ,V ,W))))
        (subst `(= (MATMUL ,K ,V ,W) (IDENTMAT ,K n)))
        (subst `(= (MATMUL ,K ,UC (IDENTMAT ,K n)) ,UC))
        (rfl)))
    (rb4-close-with! (list U W))))
(qed 'rb4-equiv-act)

;;; =====================================================================
;;; submodule-of-free-is-free (Cor 3.46).  The statement is copied from
;;; theorem-library/submodule-free.scm, built with the same two builders.
;;; =====================================================================
(define (rb4-tf v type body) (list 'FORALL v (list 'IMPLIES type body)))
(define (rb4-ex v type body) (list 'FORSOME v (list 'AND type body)))
(define rb4-euclid '(AND (IS-MODULE md) (IS-EUCLIDEAN-RING (SCAL md))))
(sp (make-wff
  (rb4-tf 'md rb4-euclid
   (rb4-tf 'n '(IN n NN)
    (rb4-tf 'u '(IN u (MAT n 1 (VEC md)))
     (list 'IMPLIES '(AND (GENERATES md n u) (REL-FREE md n u))
      (rb4-tf 'sm '(IS-SUBMODULE md sm)
       (rb4-ex 'k '(AND (IN k NN) (<= k n))
        (rb4-ex 'w '(IN w (MAT k 1 (VEC md)))
               '(AND (SPANS md k w sm) (REL-FREE md k w)))))))))))
(dk-peel!)
(dk-have! '(IS-MODULE md) (lambda () (ai rb4-euclid) (ass)))
(dk-have! '(IS-EUCLIDEAN-RING (SCAL md)) (lambda () (ai rb4-euclid) (ass)))
(dk-split! '(AND (GENERATES md n u) (REL-FREE md n u)))
(fact 'module-scalar-ring 'md)
(fact 'euclidean-ring-is-integral-domain '(SCAL md))
(fact 'nn-in-rr 'n)
(fact 'nn-one-in)
(fact 'one-in-interval-1)
(define rb4-m-ex (dk-deepest (lambda () (fact 'submodule-fg 'md 'n 'u 'sm))))
(define rb4-m (dk-skolem! rb4-m-ex))
(define rb4-v (dk-skolem! (find-first (lambda (f) (and (pair? f) (eq? (car f) 'FORSOME)
                                                       (dk-contains? f 'SPANS)))
                                      (dk-asms))))
(let* ((m rb4-m) (v rb4-v) (K '(SCAL md)))
  (fact 'nn-in-rr m)
  (use-em (list '<= m 0)
   ;; ---- m = 0: v itself, vacuously relation-free ----
   (lambda ()
     (dk-have! `(REL-FREE md ,m ,v)
       (lambda ()
         (mac 'REL-FREE)
         (let* ((ls (dk-peel!))
                (j (rb4-var-in ls (list 'INTERVAL 1 m))))
           (dk-one-le-from! j m)
           (fact 'nn-in-rr j)
           (pbc)
           (dk-absurd! (list '<= 1 j) (list '<= j m) (list '<= m 0)))))
     (rb4-close-with! (list m v)))
   ;; ---- m >= 1 ----
   (lambda ()
     (fact 'nn-zero-in)
     (fact 'nn-not-le-succ-le m 0)
     (dk-have! (list '<= 1 m) (lambda () (dk-nn! (list '<= '(succ 0) m))))
     (dk-have! '(<= 1 n) (lambda () (dk-ineq! (list '<= 1 m) (list '<= m 'n))))
     (rb4-guard! 'n (list '= m 0))
     (let* ((cm (dk-skolem! (dk-deepest (lambda () (fact 'generates-coeff-matrix 'md 'n m 'u v)))))
            (ex1 (dk-deepest (lambda () (fact 'smith-normal-form K m 'n cm))))
            (D (dk-skolem! ex1))
            (kk (dk-skolem! (find-first (lambda (f) (and (pair? f) (eq? (car f) 'FORSOME)
                                                         (dk-contains? f 'SMITH-STAIRCASE)))
                                        (dk-asms))))
            (ea (dk-deepest (lambda () (fact 'rb4-equiv-act 'md m 'n cm D 'u))))
            (U (dk-skolem! ea))
            (qwm (dk-skolem! (find-first (lambda (f) (and (pair? f) (eq? (car f) 'FORSOME)
                                                        (dk-contains? f 'MATACT)))
                                       (dk-asms))))
            (e `(MATACT md ,qwm u))
            (y `(MATACT md ,D ,e))
            (wseq `(BLOCK ,y ,kk 1)))
       (fact 'invertible-mat-is-mat K m U)
       (fact 'invertible-mat-is-mat K 'n qwm)
       ;; e = W.u is relation-free; U.v spans sm, and U.v = D.e
       (rb4-guard! 'n '(OR (= n 0) (= 1 0)))
       (fact 'matact-type 'md 'n 'n 1 qwm 'u)
       (fact 'free-transport 'md 'n 'u qwm)
       (fact 'spans-transport 'md m v U 'sm)
       (dk-have! `(= (MATACT md ,U ,v) ,y)
         (lambda ()
           (subst `(= ,v (MATACT md ,cm u)))
           (ass)))
       (dk-rewrite-h! `(SPANS md ,m (MATACT md ,U ,v) sm) `(MATACT md ,U ,v) y)
       (rb4-guard! 'n `(OR (= ,m 0) (= 1 0)))
       (fact 'matact-type 'md m 'n 1 D e)
       ;; the staircase
       (dk-split! (dk-landed-1 (lambda () (mac-h 'SMITH-STAIRCASE `(SMITH-STAIRCASE ,K ,m n ,D ,kk)))))
       (let ((nz `(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 ,kk)) (NOT (= (ENTRY ,D i_ i_) (ZERO ,K))))))
             (rows `(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 ,m)) (IMPLIES (NOT (<= i_ ,kk))
                      (FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 n)) (= (ENTRY ,D i_ j_) (ZERO ,K)))))))))
         ;; y vanishes past kk
         (dk-have! `(FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 ,m))
                      (IMPLIES (NOT (<= j_ ,kk)) (= (ENTRY ,y j_ 1) (VZERO md)))))
           (lambda ()
             (let ((j (dk-di-var!)))
               (di)
               (let ((f (dk-deepest (lambda () (inst+ rows j)))))
                 (if (and (pair? f) (eq? (car f) 'IMPLIES)) (detach! f)))
               (fact 'rb4-act-entry-zero-row 'md m 'n D e j)
(ass))))
         (fact 'rb4-span-trunc 'md m kk y 'sm)
         (fact 'block-type m 1 '(VEC md) y kk 1)
         ;; w_i = D_ii . e_i
         (dk-have! `(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 ,kk))
                      (= (ENTRY ,wseq i_ 1) ((ACT md) (ENTRY ,D i_ i_) (ENTRY ,e i_ 1)))))
           (lambda ()
             (let ((i (dk-di-var!)))
               (rb4-widen! i kk m) (rb4-widen! i kk 'n)
               (fact 'entry-of-block y kk 1 i 1 m 1 '(VEC md))
               (subst (list '= (list 'ENTRY wseq i 1) (list 'ENTRY y i 1)))
               (dk-have! `(FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 n))
                             (IMPLIES (NOT (= j_ ,i)) (= (ENTRY ,D ,i j_) (ZERO ,K)))))
                 (lambda ()
                   (let ((q (dk-di-var!)))
                     (di)
                     (dk-have! (list 'NOT (list '= i q))
                       (lambda () (di)
                         (dk-have! (list '= q i) (lambda () (subst (list '= q i)) (rfl)))
                         (ai (list 'NOT (list '= q i)))))
                     (fact 'diagonal-off-entry K m 'n D i q)
                     (ass))))
               (fact 'rb4-act-entry-single 'md m 'n D e i)
               (ass))))
         (fact 'rb4-diag-rel-free 'md m 'n kk D e wseq)
         (rb4-close-with! (list kk wseq)))))))
(qed 'submodule-of-free-is-free)
