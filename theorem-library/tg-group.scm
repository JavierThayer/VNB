;;; tg-group.scm -- group algebra the topological-group work needs (right identity, right
;;; inverse, inverse of an inverse, inverse of a product) and the monoid underlying a group.
;;; Agent ISOM, 2026-10-26.  Helper prefix: tgg-.  Library: algebra (GRP-MONOID: tg-vocab).

(define (tgg-head g) (and (pair? g) (car g)))
(define (tgg-and! a b) (dk-have! (list 'AND a b) (lambda () (dk-conj-close! (lambda () (ass))))))
(define (tgg-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (tgg-op a b) (list '(OPR s) a b))
(define (tgg-inv a) (list '(INV s) a))
;; the conjuncts of IS-GROUP(s), landed
(define (tgg-open-group!)
  (let ((iff (dk-cite! 'is-group 's)))
    (dk-have! (caddr iff) (lambda () (if (dk-only! iff '(IS-GROUP s)) (prop))))
    (dk-split-all! (list (caddr iff)))))

;;; a a^-1 = e and a e = a
(sp (make-wff '(FORALL s (IMPLIES (IS-GROUP s) (FORALL a (IMPLIES (IN a (CARR s))
   (AND (= ((OPR s) a ((INV s) a)) (IDEN s)) (= ((OPR s) a (IDEN s)) a))))))))
(dk-peel!)
(tgg-open-group!)
(mac-h 'has-inverses '(HAS-INVERSES (OPR s) (IDEN s) (INV s) (CARR s)))
(mac-h 'is-identity '(IS-IDENTITY (OPR s) (IDEN s) (CARR s)))
(dk-split-all! (list (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(INV s)))) "inverses") 'a)))
(dk-split-all! (list (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (not (dk-contains? h '(INV s))) (dk-contains? h '(IDEN s)) (dk-contains? h '(OPR s)))) "identity") 'a)))
(dk-conj-close! (lambda () (tgg-ass!)))
(qed 'group-right-inv-id)
(topic! 'group-right-inv-id 'algebra)

;;; typing helpers
(define (tgg-in! a) (if (not (dk-asm? (list 'IN a '(CARR s)))) (error "tgg-in!: untyped" a)))
(define (tgg-mul! a b) (dk-cite! 'group-carrier-closed-opr 's a b))
(define (tgg-inv! a) (dk-cite! 'group-inv-in 's a))

;;; (a^-1)^-1 = a
(sp (make-wff '(FORALL s (IMPLIES (IS-GROUP s) (FORALL a (IMPLIES (IN a (CARR s))
   (= ((INV s) ((INV s) a)) a)))))))
(dk-peel!)
(tgg-inv! 'a)
(tgg-inv! (tgg-inv 'a))
(dk-split-all! (list (dk-cite! 'group-right-inv-id 's (tgg-inv 'a))))
(dk-cite! 'group-left-inv 's 'a)
(fact 'group-identity-in 's)
;; a^-1 (a^-1)^-1 = e = a^-1 a  ==>  (a^-1)^-1 = a, by left cancellation
(dk-have! (list '= (tgg-op (tgg-inv 'a) (tgg-inv (tgg-inv 'a))) (tgg-op (tgg-inv 'a) 'a))
  (lambda () (subst (list '= (tgg-op (tgg-inv 'a) (tgg-inv (tgg-inv 'a))) '(IDEN s)))
             (subst (list '= (tgg-op (tgg-inv 'a) 'a) '(IDEN s))) (rfl)))
(dk-cite! 'group-cancel-left 's (tgg-inv (tgg-inv 'a)) 'a (tgg-inv 'a))
(tgg-ass!)
(qed 'group-inv-inv)
(topic! 'group-inv-inv 'algebra)

;;; (a b)^-1 = b^-1 a^-1
(sp (make-wff '(FORALL s (IMPLIES (IS-GROUP s) (FORALL a (IMPLIES (IN a (CARR s)) (FORALL b (IMPLIES (IN b (CARR s))
   (= ((INV s) ((OPR s) a b)) ((OPR s) ((INV s) b) ((INV s) a)))))))))))
(dk-peel!)
(let* ((ab (tgg-op 'a 'b)) (ia (tgg-inv 'a)) (ib (tgg-inv 'b)) (iab (tgg-inv ab)) (r (tgg-op ib ia)))
  (tgg-mul! 'a 'b) (tgg-inv! 'a) (tgg-inv! 'b) (tgg-inv! ab) (tgg-mul! ib ia)
  (fact 'group-identity-in 's)
  (dk-split-all! (list (dk-cite! 'group-right-inv-id 's ab)))
  (dk-split-all! (list (dk-cite! 'group-right-inv-id 's 'a)))
  (dk-split-all! (list (dk-cite! 'group-right-inv-id 's 'b)))
  ;; (a b)(b^-1 a^-1) = a (b b^-1) a^-1 = a a^-1 = e
  (tgg-mul! 'b ib) (tgg-mul! ab ib) (tgg-mul! 'b r)
  (dk-cite! 'group-assoc 's ab ib ia)
  (dk-cite! 'group-assoc 's 'a 'b ib)
  (dk-cite! 'group-left-id 's ia)
  (dk-have! (list '= (tgg-op ab r) '(IDEN s))
    (lambda ()
      (subst (list '= (tgg-op ab r) (tgg-op (tgg-op ab ib) ia)))
      (subst (list '= (tgg-op ab ib) (tgg-op 'a (tgg-op 'b ib))))
      (subst (list '= (tgg-op 'b ib) '(IDEN s)))
      (subst (list '= (tgg-op 'a '(IDEN s)) 'a))
      (subst (list '= (tgg-op 'a ia) '(IDEN s)))
      (rfl)))
  (dk-have! (list '= (tgg-op ab iab) (tgg-op ab r))
    (lambda () (subst (list '= (tgg-op ab iab) '(IDEN s))) (subst (list '= (tgg-op ab r) '(IDEN s))) (rfl)))
  (dk-cite! 'group-cancel-left 's iab r ab)
  (tgg-ass!))
(qed 'group-inv-opr)
(topic! 'group-inv-opr 'algebra)

;;; e^-1 = e
(sp (make-wff '(FORALL s (IMPLIES (IS-GROUP s) (= ((INV s) (IDEN s)) (IDEN s))))))
(dk-peel!)
(fact 'group-identity-in 's)
(tgg-inv! '(IDEN s))
(dk-split-all! (list (dk-cite! 'group-right-inv-id 's '(IDEN s))))
(dk-cite! 'group-left-id 's (tgg-inv '(IDEN s)))
(dk-have! (list '= (tgg-inv '(IDEN s)) (tgg-op '(IDEN s) (tgg-inv '(IDEN s))))
  (lambda () (subst (list '= (tgg-op '(IDEN s) (tgg-inv '(IDEN s))) (tgg-inv '(IDEN s)))) (rfl)))
(subst (list '= (tgg-inv '(IDEN s)) (tgg-op '(IDEN s) (tgg-inv '(IDEN s)))))
(tgg-ass!)
(qed 'group-inv-iden)
(topic! 'group-inv-iden 'algebra)

;;; ---- the monoid underlying a group ----
(define (tgg-readoff! name acc val)
  (sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-GROUP s) (list '== (list acc '(GRP-MONOID s)) val)))))
  (dk-peel!)
  (tgg-open-group!)
  (mac 'GRP-MONOID)
  (slot acc)
  (nth-r)
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (slot acc))
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (qrfl))
  (qed name)
  (topic! name 'plumbing))
(tgg-readoff! 'grp-monoid-carr 'CARR '(CARR s))
(tgg-readoff! 'grp-monoid-opr 'OPR '(OPR s))
(tgg-readoff! 'grp-monoid-iden 'IDEN '(IDEN s))

(sp (make-wff '(FORALL s (IMPLIES (IS-GROUP s) (IS-MONOID (GRP-MONOID s))))))
(dk-peel!)
(tgg-open-group!)
(fact 'grp-monoid-carr 's)
(fact 'grp-monoid-opr 's)
(fact 'grp-monoid-iden 's)
(let ((iff (dk-cite! 'is-monoid '(GRP-MONOID s))))
  (dk-have! (caddr iff)
    (lambda ()
      (dk-isx-set!)                ; W1Q: the conjunct t in SET, from the typings
      (subst '(== (CARR (GRP-MONOID s)) (CARR s)))
      (subst '(== (OPR (GRP-MONOID s)) (OPR s)))
      (subst '(== (IDEN (GRP-MONOID s)) (IDEN s)))
      (dk-conj-close!
       (lambda ()
         (if (and (dk-head-is? (dk-goal) '=) (dk-head-is? (cadr (dk-goal)) 'LENGTH))
             (begin (mac 'GRP-MONOID) (len-r) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (vnb-guard (lambda () (arith)))))
             (tgg-ass!))))))
  (if (dk-only! iff (caddr iff)) (prop)))
(qed 'grp-monoid-is-monoid)
(topic! 'grp-monoid-is-monoid 'algebra)

(sp (make-wff '(FORALL s (IMPLIES (IS-GROUP s) (IN (CARR s) SET)))))
(dk-peel!)
(tgg-open-group!)
(tgg-ass!)
(qed 'group-carr-set)
(topic! 'group-carr-set 'plumbing)

;;; (a^-1 b)(b^-1 c) = a^-1 c
(sp (make-wff '(FORALL s (IMPLIES (IS-GROUP s) (FORALL a (IMPLIES (IN a (CARR s)) (FORALL b (IMPLIES (IN b (CARR s)) (FORALL c (IMPLIES (IN c (CARR s))
   (= ((OPR s) ((OPR s) ((INV s) a) b) ((OPR s) ((INV s) b) c)) ((OPR s) ((INV s) a) c))))))))))))
(dk-peel!)
(let* ((ia (tgg-inv 'a)) (ib (tgg-inv 'b)) (iab (tgg-op ia 'b)) (ibc (tgg-op ib 'c)))
  (tgg-inv! 'a) (tgg-inv! 'b) (tgg-mul! ia 'b) (tgg-mul! ib 'c) (tgg-mul! 'b ib)
  (fact 'group-identity-in 's)
  (dk-split-all! (list (dk-cite! 'group-right-inv-id 's 'b)))
  (dk-cite! 'group-assoc 's ia 'b ibc)
  (dk-cite! 'group-assoc 's 'b ib 'c)
  (dk-cite! 'group-left-id 's 'c)
  (subst (list '= (tgg-op iab ibc) (tgg-op ia (tgg-op 'b ibc))))
  (subst (list '= (tgg-op 'b ibc) (tgg-op (tgg-op 'b ib) 'c)))
  (subst (list '= (tgg-op 'b ib) '(IDEN s)))
  (subst (list '= (tgg-op '(IDEN s) 'c) 'c))
  (tgg-mul! ia 'c)
  (rfl))
(qed 'group-cancel-mid)
(topic! 'group-cancel-mid 'algebra)

;;; (a y)^-1 (a x) = y^-1 x
(sp (make-wff '(FORALL s (IMPLIES (IS-GROUP s) (FORALL a (IMPLIES (IN a (CARR s)) (FORALL x (IMPLIES (IN x (CARR s)) (FORALL y (IMPLIES (IN y (CARR s))
   (= ((OPR s) ((INV s) ((OPR s) a y)) ((OPR s) a x)) ((OPR s) ((INV s) y) x))))))))))))
(dk-peel!)
(let* ((ia (tgg-inv 'a)) (iy (tgg-inv 'y)) (ay (tgg-op 'a 'y)) (ax (tgg-op 'a 'x)))
  (tgg-inv! 'a) (tgg-inv! 'y) (tgg-mul! 'a 'y) (tgg-mul! 'a 'x) (tgg-mul! iy ia) (tgg-mul! ia 'a)
  (fact 'group-identity-in 's)
  (dk-cite! 'group-inv-opr 's 'a 'y)
  (dk-cite! 'group-assoc 's iy ia ax)
  (dk-cite! 'group-assoc 's ia 'a 'x)
  (dk-cite! 'group-left-inv 's 'a)
  (dk-cite! 'group-left-id 's 'x)
  (subst (list '= (tgg-inv ay) (tgg-op iy ia)))
  (subst (list '= (tgg-op (tgg-op iy ia) ax) (tgg-op iy (tgg-op ia ax))))
  (subst (list '= (tgg-op ia ax) (tgg-op (tgg-op ia 'a) 'x)))
  (subst (list '= (tgg-op ia 'a) '(IDEN s)))
  (subst (list '= (tgg-op '(IDEN s) 'x) 'x))
  (tgg-mul! iy 'x)
  (rfl))
(qed 'group-inv-translate)
(topic! 'group-inv-translate 'algebra)

;;; v^-1 u = e  ==>  u = v
(sp (make-wff '(FORALL s (IMPLIES (IS-GROUP s) (FORALL u (IMPLIES (IN u (CARR s)) (FORALL v (IMPLIES (IN v (CARR s))
   (IMPLIES (= ((OPR s) ((INV s) v) u) (IDEN s)) (= u v))))))))))
(dk-peel!)
(let* ((iv (tgg-inv 'v)) (ivu (tgg-op iv 'u)))
  (tgg-inv! 'v) (tgg-mul! iv 'u) (tgg-mul! 'v iv)
  (fact 'group-identity-in 's)
  (dk-split-all! (list (dk-cite! 'group-right-inv-id 's 'v)))
  (dk-cite! 'group-assoc 's 'v iv 'u)
  (dk-cite! 'group-left-id 's 'u)
  ;; u = e u = (v v^-1) u = v (v^-1 u) = v e = v
  (dk-have! (list '= (tgg-op 'v ivu) 'v) (lambda () (subst (list '= ivu '(IDEN s))) (subst (list '= (tgg-op 'v '(IDEN s)) 'v)) (rfl)))
  (dk-have! (list '= (tgg-op 'v ivu) 'u)
    (lambda () (subst (list '= (tgg-op 'v ivu) (tgg-op (tgg-op 'v iv) 'u))) (subst (list '= (tgg-op 'v iv) '(IDEN s)))
               (subst (list '= (tgg-op '(IDEN s) 'u) 'u)) (rfl)))
  (dk-have! (list '= 'u (tgg-op 'v ivu)) (lambda () (subst (list '= (tgg-op 'v ivu) 'u)) (rfl)))
  (subst (list '= 'u (tgg-op 'v ivu)))
  (tgg-ass!))
(qed 'group-eq-of-inv-eq-iden)
(topic! 'group-eq-of-inv-eq-iden 'algebra)

;;; y (y^-1 p) = p
(sp (make-wff '(FORALL s (IMPLIES (IS-GROUP s) (FORALL y (IMPLIES (IN y (CARR s)) (FORALL p (IMPLIES (IN p (CARR s))
   (= ((OPR s) y ((OPR s) ((INV s) y) p)) p)))))))))
(dk-peel!)
(tgg-inv! 'y) (tgg-mul! (tgg-inv 'y) 'p) (tgg-mul! 'y (tgg-inv 'y))
(fact 'group-identity-in 's)
(dk-split-all! (list (dk-cite! 'group-right-inv-id 's 'y)))
(dk-cite! 'group-assoc 's 'y (tgg-inv 'y) 'p)
(dk-cite! 'group-left-id 's 'p)
(subst (list '= (tgg-op 'y (tgg-op (tgg-inv 'y) 'p)) (tgg-op (tgg-op 'y (tgg-inv 'y)) 'p)))
(subst (list '= (tgg-op 'y (tgg-inv 'y)) '(IDEN s)))
(subst (list '= (tgg-op '(IDEN s) 'p) 'p))
(rfl)
(qed 'group-mul-inv-cancel)
(topic! 'group-mul-inv-cancel 'algebra)
