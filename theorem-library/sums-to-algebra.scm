;;; b3-sums.scm -- THE SUMS-TO ALGEBRA: sums of unordered sums, scaling and conjugation in CC,
;;; homomorphic images in two arguments, and the bridge from ESUM to an unordered sum in CC.
;;; Agent BA-ONB3, 2026-11-09.  Prefix b3s-.  Nothing asserted.
;;; DESTINATION: theorem-library/sums-to-algebra.scm.  Library: analysis.
;;; LOAD WINDOW [l2-families + 1, end): cites sums-to-uniform-hom, cc-nag-*, cc-family-sum-value
;;; (BA-ONB2's l2-families); finsum-add-ag, finsum-congruence-q, the abelian-group laws, the
;;; normed-AG norm laws (rake-asm-1), card-union-nn, union-set-closure.
(define (b3s-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; b3s: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l) (display ";;   ") (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))
        (error "b3s: proof not complete" name)))
  (qed name)
  (topic! name 'analysis))
(define (b3s-dump! tag)
  (display ";; b3s DUMP ") (display tag) (newline)
  (for-each (lambda (l) (display ";;   ") (display (expression->string (dk-goal-of l))) (newline))
            (dk-open-leaves)))
(define (b3s-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (b3s-close!) (cond ((not (b3s-open?)) #t) ((dk-asm? (dk-goal)) (ass)) ((dk-head-is? (dk-goal) '==) (qrfl)) (#t (rfl))))
(define (b3s-has-lam? g)
  (and (pair? g)
       (or (and (pair? (car g)) (eq? (car (car g)) 'VNB-LAMBDA))
           (let loop ((l g)) (and (pair? l) (or (b3s-has-lam? (car l)) (loop (cdr l))))))))
(define (b3s-beta!) (let loop ((n 0)) (if (and (< n 6) (b3s-open?) (b3s-has-lam? (dk-goal))) (begin (dk-lam-b!) (loop (+ n 1))))))

;;; the view V = NORMED-AG-AS-ABELIAN-GROUP(g) and its read-offs
(define (b3s-V g) (list 'NORMED-AG-AS-ABELIAN-GROUP g))
(define (b3s-slot-close! view acc)
  (mac view)
  (let loop ((n 0))
    (let ((g (dk-goal)))
      (if (and (< n 8) (not (equal? (cadr g) (caddr g))))
          (begin (quietly (lambda () (slot acc)))
                 (quietly (lambda () (nth-r)))
                 (if (not (equal? (dk-goal) g)) (loop (+ n 1)))))))
  (qrfl))
(define (b3s-view! g)
  (fact 'normed-ag-as-abelian-group-is-abelian-group g)
  (fact 'abelian-group-is-group (b3s-V g))
  (for-each (lambda (acc)
              (let ((lhs (list acc (b3s-V g))) (rhs (list acc g)))
                (dk-have! (list '== lhs rhs) (lambda () (b3s-slot-close! 'NORMED-AG-AS-ABELIAN-GROUP acc)))
                (dk-have! (list '== rhs lhs) (lambda () (b3s-slot-close! 'NORMED-AG-AS-ABELIAN-GROUP acc)))))
            '(CARR OPR INV IDEN)))
;; x in CARR g in context: land x in CARR V (and conversely)
(define (b3s-toV! g x)
  (dk-have! (list 'IN x (list 'CARR (b3s-V g))) (lambda () (subst (list '== (list 'CARR (b3s-V g)) (list 'CARR g))) (ass))))
(define (b3s-toG! g x)
  (dk-have! (list 'IN x (list 'CARR g)) (lambda () (subst (list '== (list 'CARR g) (list 'CARR (b3s-V g)))) (ass))))
(define (b3s-opg g) (list 'OPR g))
(define (b3s-invg g) (list 'INV g))
(define (b3s-opv g) (list 'OPR (b3s-V g)))
(define (b3s-invv g) (list 'INV (b3s-V g)))
;; a, b in CARR g (both views) in context: type (OPR g)(a, b) and (OPR V)(a, b) in both carriers
;; a, b in CARR g in context (grp-form terms): type (OPR g)(a, b) and (OPR V)(a, b) in both
;; carriers.  The kernel fact is read in V and rewritten, never the goal (a and b may hold OPR g).
(define (b3s-retype! f1 pairs claim)
  (dk-have! claim
    (lambda ()
      (dk-close-if! (lambda () (let loop ((f f1) (ps pairs))
                                 (if (pair? ps) (loop (dk-rewrite-h! f (car (car ps)) (cdr (car ps))) (cdr ps)))))
                    (lambda () (ass))))))
(define (b3s-opr-type! g a b)
  (b3s-toV! g a) (b3s-toV! g b)
  (let ((f1 (dk-cite! 'group-carrier-closed-opr (b3s-V g) a b)))
    (if (not (eq? #t (b3s-retype! f1 (list (cons (b3s-opv g) (b3s-opg g)) (cons (list 'CARR (b3s-V g)) (list 'CARR g)))
                                  (list 'IN (list (b3s-opg g) a b) (list 'CARR g)))))
        (b3s-retype! f1 (list (cons (b3s-opv g) (b3s-opg g)))
                     (list 'IN (list (b3s-opg g) a b) (list 'CARR (b3s-V g)))))
    (list (b3s-opv g) a b)))
(define (b3s-inv-type! g a)
  (b3s-toV! g a)
  (let ((f1 (dk-cite! 'group-inv-in (b3s-V g) a)))
    (if (not (eq? #t (b3s-retype! f1 (list (cons (b3s-invv g) (b3s-invg g)) (cons (list 'CARR (b3s-V g)) (list 'CARR g)))
                 (list 'IN (list (b3s-invg g) a) (list 'CARR g)))))
    (b3s-retype! f1 (list (cons (b3s-invv g) (b3s-invg g)))
                 (list 'IN (list (b3s-invg g) a) (list 'CARR (b3s-V g)))))
    (list (b3s-invv g) a)))

;; (SUBSET (UNION a b) c) from (SUBSET a c), (SUBSET b c) in context
(define (b3s-union-sub! a b c)
  (dk-have! (list 'SUBSET (list 'UNION a b) c)
    (lambda ()
      (mac 'subset-def)
      (let* ((landed (dk-peel!))
             (mem (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN) (equal? (caddr f) (list 'UNION a b)))) landed))
             (x (cadr mem))
             (cases (dk-landed-1 (lambda () (mac-h 'union-membership mem)))))
        (use-cases cases
          (lambda () (fact 'subset-mem-fwd a c x) (ass))
          (lambda () (fact 'subset-mem-fwd b c x) (ass)))))))
(define (b3s-sub-union! a b)
  (dk-have! (list 'SUBSET b (list 'UNION a b)) (lambda () (fact 'union-right-subset a b) (ass)))
  (dk-have! (list 'SUBSET a (list 'UNION a b))
    (lambda () (fact 'union-right-subset b a) (fact 'union-comm b a)
               (subst (list '= (list 'UNION a b) (list 'UNION b a))) (ass))))
;; fin1, fin2 finite subsets of D in context: U = fin1 u fin2 is one, containing both
(define (b3s-union-fin! fin1 fin2 D)
  (dk-have! (list 'AND (list 'IN fin1 'SET) (list 'IN fin2 'SET)) (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'union-set-closure fin1 fin2)
  (fact 'card-union-nn fin1 fin2)
  (b3s-sub-union! fin1 fin2)
  (b3s-union-sub! fin1 fin2 D)
  (list 'UNION fin1 fin2))
;; f in FUN(D, X) and D a set in context: land DOM f = D; returns the equation
(define (b3s-dom! f D X)
  (dk-project! (list 'IN f (list 'FUN D)) 'fun-codomain-iff (list 'IN f (list 'FUN D X)))
  (dk-have! (list 'AND (list 'IN f (list 'FUN D)) (list 'IN D 'SET)) (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'dom-of-fun D f)
  (dk-split-all! (list (list 'AND (list 'IN (list 'DOM f) 'SET) (list '= (list 'DOM f) D))))
  (list '= (list 'DOM f) D))
;; ext a finite subset of D, f in FUN(D, CARR g) in context: FINSUM(V, f, ext) typed in both carriers
(define (b3s-finsum-type! g f D ext)
  (let* ((V (b3s-V g)) (sm (list 'FINSUM V f ext)))
    (dk-have! (list 'FORALL 'fhz_ (list 'IMPLIES (list 'IN 'fhz_ ext) (list 'IN (list f 'fhz_) (list 'CARR V))))
      (lambda ()
        (let ((z (cadr (car (dk-peel!)))))
          (fact 'subset-mem-fwd ext D z)
          (fact 'fun-apply-type-c f D (list 'CARR g) z)
          (subst (list '== (list 'CARR V) (list 'CARR g))) (ass))))
    (dk-cite! 'finsum-type-ptwise V ext f)
    (b3s-toG! g sm)
    sm))
;; ext a finite subset of D, f in FUN(D, CARR g): FINSUM(V, f, ext) = FINSUM(V, f', ext) with f' the
;; restriction VNB-LAMBDA b3w_ ext (f b3w_), which is in FUN(ext, CARR V); returns f'
(define (b3s-restrict! g f D ext)
  (let* ((V (b3s-V g)) (fr (list 'VNB-LAMBDA 'b3w_ ext (list f 'b3w_))))
    (dk-have! (list 'IN fr (list 'FUN ext (list 'CARR V)))
      (lambda ()
        (dk-lam-type!
          (lambda () (let ((z (dk-di-var!)))
                       (fact 'subset-mem-fwd ext D z)
                       (fact 'fun-apply-type-c f D (list 'CARR g) z)
                       (dk-close-if! (lambda () (b3s-toV! g (list f z))) b3s-close!)))
          (lambda () (ass)))))
    (dk-have! (list 'FORALL 'b3z_ (list 'IMPLIES (list 'IN 'b3z_ ext) (list '= (list f 'b3z_) (list fr 'b3z_))))
      (lambda ()
        (let ((z (cadr (car (dk-peel!)))))
          (fact 'subset-mem-fwd ext D z)
          (fact 'fun-apply-type-c f D (list 'CARR g) z)
          (dk-close-if! (lambda () (b3s-beta!)) b3s-close!))))
    (subst (dk-cite! 'finsum-congruence-q V ext f fr))
    fr))

;;; ===========================================================================
;;; SUMS-TO-ADD: f sums to r and fb sums to s (same index set) => f + fb sums to r + s.
(define b3s-lam '(VNB-LAMBDA saz_ (DOM f) ((OPR grp) (f saz_) (fb saz_))))
(sp (make-wff
  (list 'FORALL 'grp (list 'IMPLIES '(IS-NORMED-AG grp)
    (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN (DOM f) (CARR grp)))
      (list 'FORALL 'fb (list 'IMPLIES '(IN fb (FUN (DOM f) (CARR grp)))
        (list 'FORALL 'r (list 'IMPLIES '(IN r (CARR grp))
          (list 'FORALL 's (list 'IMPLIES '(IN s (CARR grp))
            (list 'IMPLIES '(SUMS-TO grp f r)
              (list 'IMPLIES '(SUMS-TO grp fb s)
                (list 'SUMS-TO 'grp b3s-lam '((OPR grp) r s))))))))))))))))
(dk-peel!)
(define b3s-D '(DOM f))
(b3s-view! 'grp)
(fact 'fun-domain-in-set b3s-D '(CARR grp) 'f)
(define b3s-domfb (b3s-dom! 'fb b3s-D '(CARR grp)))
(b3s-opr-type! 'grp 'r 's)
;; the sum family typed, DOM lam = D
(dk-have! (list 'IN b3s-lam (list 'FUN b3s-D '(CARR grp)))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((z (dk-di-var!)))
          (fact 'fun-apply-type-c 'f b3s-D '(CARR grp) z)
          (fact 'fun-apply-type-c 'fb b3s-D '(CARR grp) z)
          (dk-close-if! (lambda () (b3s-opr-type! 'grp (list 'f z) (list 'fb z))) b3s-close!)))
      (lambda () (ass)))))
(define b3s-domlam (b3s-dom! b3s-lam b3s-D '(CARR grp)))
(mac-h 'SUMS-TO '(SUMS-TO grp f r))
(mac-h 'SUMS-TO '(SUMS-TO grp fb s))
(define b3s-shf (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a 'fin) (dk-contains? a 'r) (not (dk-contains? a 'fb)))) "f sums to r"))
(define b3s-shb0 (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a 'fin) (dk-contains? a 'fb))) "fb sums to s"))
(define b3s-shb (dk-rewrite-h! b3s-shb0 '(DOM fb) b3s-D))
(mac 'SUMS-TO)
(let* ((eps (cadr (car (dk-peel!))))
       (h (dk-halve! eps))
       (fin1 (dk-skolem! (dk-apply! b3s-shf h) #t))
       (e1 (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a fin1) (dk-contains? a h))) "the tail of f"))
       (fin2 (dk-skolem! (dk-apply! b3s-shb h) #t))
       (e2 (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a fin2) (dk-contains? a h))) "the tail of fb"))
       (U (b3s-union-fin! fin1 fin2 b3s-D)))
  (fact 'rr-pos-rr-in-rr eps)
  (ew U)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-asm? (dk-goal)) (ass))
            ((dk-head-is? (dk-goal) 'SUBSET) (subst b3s-domlam) (ass))
            (#t
             (let* ((landed (dk-peel!))
                    (ext (cadr (cadr (car landed)))))
               (dk-split-all!)
               (let ((sx (dk-pick (lambda (a) (and (dk-head-is? a 'SUBSET) (equal? (cadr a) ext))) "ext <= DOM lam")))
                 (dk-rewrite-h! sx (list 'DOM b3s-lam) b3s-D))
               (fact 'subset-trans fin1 U ext)
               (fact 'subset-trans fin2 U ext)
               (dk-have! (list 'AND (list 'IN ext 'SET) (list 'AND (list 'IN (list 'CARD ext) 'NN)
                                (list 'AND (list 'SUBSET fin1 ext) (list 'SUBSET ext b3s-D))))
                 (lambda () (dk-conj-close! (lambda () (ass)))))
               (dk-have! (list 'AND (list 'IN ext 'SET) (list 'AND (list 'IN (list 'CARD ext) 'NN)
                                (list 'AND (list 'SUBSET fin2 ext) (list 'SUBSET ext b3s-D))))
                 (lambda () (dk-conj-close! (lambda () (ass)))))
               (dk-apply! e1 ext)
               (dk-apply! e2 ext)
               (let* ((V (b3s-V 'grp)) (opv (b3s-opv 'grp)) (invv (b3s-invv 'grp))
                      (opg (b3s-opg 'grp)) (invg (b3s-invg 'grp))
                      (SA (b3s-finsum-type! 'grp 'f b3s-D ext))
                      (SB (b3s-finsum-type! 'grp 'fb b3s-D ext))
                      (FL (list 'FINSUM V b3s-lam ext)))
                 ;; FL = SA . B, through the restrictions and finsum-add-ag
                 (dk-have! (list '= FL (list opv SA SB))
                   (lambda ()
                     (let* ((fr (b3s-restrict! 'grp 'f b3s-D ext))
                            (fbr (b3s-restrict! 'grp 'fb b3s-D ext))
                            (ad (dk-cite! 'finsum-add-ag V ext fr fbr))
                            (L1 (cadr ad)) (lam1 (caddr L1)))
                       (dk-have! (list 'FORALL 'b3z_ (list 'IMPLIES (list 'IN 'b3z_ ext) (list '= (list b3s-lam 'b3z_) (list lam1 'b3z_))))
                         (lambda ()
                           (let ((z (cadr (car (dk-peel!)))))
                             (fact 'subset-mem-fwd ext b3s-D z)
                             (fact 'fun-apply-type-c 'f b3s-D '(CARR grp) z)
                             (fact 'fun-apply-type-c 'fb b3s-D '(CARR grp) z)
                             (b3s-opr-type! 'grp (list 'f z) (list 'fb z))
                             (b3s-beta!)
                             (if (b3s-open?) (subst (list '== opg opv)))
                             (b3s-close!))))
                       (subst (dk-cite! 'finsum-congruence-q V ext b3s-lam lam1))
                       (subst ad)
                       (b3s-close!))))
                 (subst (list '= FL (list opv SA SB)))
                 ;; the group algebra: (r s)(SA SB)^-1 = (r A^-1)(s B^-1)
                 (b3s-toV! 'grp SA) (b3s-toV! 'grp SB)
                 (let* ((iA (b3s-inv-type! 'grp SA)) (iB (b3s-inv-type! 'grp SB))
                        (X (begin (b3s-opr-type! 'grp 'r (list invg SA)) (list opv 'r iA)))
                        (Y (begin (b3s-opr-type! 'grp 's (list invg SB)) (list opv 's iB)))
                        (Xg (list opg 'r (list invg SA))) (Yg (list opg 's (list invg SB))))
                   (dk-cite! 'abelian-group-inv-opr V SA SB)
                   (dk-cite! 'abelian-group-opr-interchange V 'r 's iA iB)
                   (dk-have! (list '= (list opg (list opg 'r 's) (list invg (list opv SA SB))) (list opg Xg Yg))
                     (lambda ()
                       (subst (list '== opg opv)) (subst (list '== invg invv))
                       (subst (list '= (list invv (list opv SA SB)) (list opv iA iB)))
                       (subst (list '= (list opv (list opv 'r 's) (list opv iA iB)) (list opv X Y)))
                       (b3s-close!)))
                   (subst (list '= (list opg (list opg 'r 's) (list invg (list opv SA SB))) (list opg Xg Yg)))
                   (b3s-opr-type! 'grp Xg Yg)
                   (dk-cite! 'normed-ag-nrm-subadditive 'grp Xg Yg)
                   (dk-project! '(IN (NRM grp) (FUN (CARR grp) RR)) 'is-normed-ag '(IS-NORMED-AG grp))
                   (for-each (lambda (t) (fact 'fun-apply-type-c '(NRM grp) '(CARR grp) 'RR t)) (list Xg Yg (list opg Xg Yg)))
                   (let ((n (lambda (t) (list '(NRM grp) t))))
                     (dk-ineq! (list '<= (n (list opg Xg Yg)) (list '+ (n Xg) (n Yg)))
                               (list '< (n Xg) h) (list '< (n Yg) h) (list '= (list '+ h h) eps)
                               (list 'IN (n Xg) 'RR) (list 'IN (n Yg) 'RR) (list 'IN (n (list opg Xg Yg)) 'RR)
                               (list 'IN h 'RR) (list 'IN eps 'RR)))))))))))
(b3s-done! 'sums-to-add)

;;; ===========================================================================
;;; AN UNORDERED SUM IN CC PASSES THROUGH A BOUNDED ADDITIVE MAP h : CC -> CC
;;; (h(a + b) = h a + h b, h(-a) = -h a, h 0 = 0, |h a| <= L |a| with L >= 0).  The instances are
;;; scaling z |-> c z (L = |c|), conjugation (L = 1), Re and Im.  From sums-to-uniform-hom: h is a
;;; homomorphism of the additive group of CC-NAG, and del = eps / (L + 1) serves for continuity.
(define b3s-NB (b3s-V 'CC-NAG))
(define b3s-addl '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (+ x_ y_)))
(define b3s-negl '(VNB-LAMBDA x_ CC (- x_)))
(define b3s-nrml '(VNB-LAMBDA x_ CC (magnitude x_)))
(define b3s-cc-closure '((+ . cc-add-closed) (* . cc-mul-closed) (- . cc-neg-closed)
                         (conjugate . cc-conjugate-closed) (magnitude . cc-magnitude-closed)))
(define (b3s-cc-beta!)
  (let loop ((fuel 8))
    (dk-saturate-slot-ops! 'CC b3s-cc-closure)
    (if (and (> fuel 0) (b3s-has-lam? (dk-goal)))
        (let ((home (proof-state-focus *ps*)))
          (dk-lam-b!)
          (if (sequent-node-grounded? home) #t (loop (- fuel 1))))
        #f)))
(define (b3s-cc-readoff! acc val)
  (let ((l1 (list acc b3s-NB)) (l2 (list acc 'CC-NAG)))
    (dk-have! (list '== l1 l2) (lambda () (b3s-slot-close! 'NORMED-AG-AS-ABELIAN-GROUP acc)))
    (fact (symbol-append 'cc-nag@ acc))
    (dk-have! (list '== l1 val) (lambda () (subst (list '== l1 l2)) (subst (list '== l2 val)) (qrfl)))))
(define (b3s-cc-readoffs!)
  (fact 'cc-nag-is-normed-ag)
  (fact 'normed-ag-as-abelian-group-is-abelian-group 'CC-NAG)
  (b3s-cc-readoff! 'CARR 'CC)
  (b3s-cc-readoff! 'OPR b3s-addl)
  (b3s-cc-readoff! 'INV b3s-negl)
  (b3s-cc-readoff! 'IDEN 0)
  (fact 'cc-nag@nrm))
(define (b3s-beta-h! f)
  (let loop ((f f) (n 0))
    (if (and (< n 6) (b3s-has-lam? f)) (loop (dk-landed-1 (lambda () (dk-lam-b-h! f))) (+ n 1)) f)))
(define (b3s-and! a b) (dk-have! (list 'AND a b) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (arith)))))))
(define b3s-hadd '(FORALL a_ (IMPLIES (IN a_ CC) (FORALL b_ (IMPLIES (IN b_ CC) (= (h (+ a_ b_)) (+ (h a_) (h b_))))))))
(define b3s-hneg '(FORALL a_ (IMPLIES (IN a_ CC) (= (h (- a_)) (- (h a_))))))
(define b3s-hbd '(FORALL a_ (IMPLIES (IN a_ CC) (<= (MAGNITUDE (h a_)) (* lc (MAGNITUDE a_))))))
(define b3s-hlam '(VNB-LAMBDA shz_ (DOM f) (h (f shz_))))
(sp (make-wff
  (list 'FORALL 'h (list 'IMPLIES '(IN h (FUN CC CC))
    (list 'IMPLIES b3s-hadd (list 'IMPLIES b3s-hneg (list 'IMPLIES '(= (h 0) 0)
      (list 'FORALL 'lc (list 'IMPLIES '(IN lc RR) (list 'IMPLIES '(<= 0 lc) (list 'IMPLIES b3s-hbd
        (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN (DOM f) CC))
          (list 'FORALL 'r (list 'IMPLIES '(IN r CC)
            (list 'IMPLIES '(SUMS-TO CC-NAG f r) (list 'SUMS-TO 'CC-NAG b3s-hlam '(h r))))))))))))))))))
(dk-peel!)
(b3s-cc-readoffs!)
(define b3s-hadd-c (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a '+) (dk-contains? a 'h))) "additivity"))
(define b3s-hneg-c (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a '-) (not (dk-contains? a '+)) (dk-contains? a 'h))) "negation"))
(define b3s-hbd-c (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a 'lc))) "the bound"))
(define (b3s-hpt! a) (if (not (dk-asm? (list 'IN (list 'h a) 'CC))) (dk-cite! 'fun-apply-type-c 'h 'CC 'CC a)))
;; the homomorphism
(define b3s-hom (list 'IS-HOM-ABELIAN-GROUP b3s-NB b3s-NB 'h))
(dk-have! b3s-hom (lambda ()
(let* ((iff (dk-cite! 'is-hom-abelian-group-def b3s-NB b3s-NB 'h)) (rhs (caddr iff)))
  (dk-have! rhs
    (lambda ()
      (for-each (lambda (pr) (if (dk-contains? (dk-goal) (car pr)) (subst (list '== (car pr) (cdr pr)))))
                (list (cons (list 'CARR b3s-NB) 'CC) (cons (list 'OPR b3s-NB) b3s-addl)
                      (cons (list 'INV b3s-NB) b3s-negl) (cons (list 'IDEN b3s-NB) 0)))
      (dk-conj-close!
        (lambda ()
          (cond ((dk-asm? (dk-goal)) (ass))
                ((dk-head-is? (dk-goal) 'FORALL)
                 (let* ((landed (dk-peel!)) (xs (map cadr landed)))
                   (for-each b3s-hpt! xs)
                   (if (= (length xs) 2)
                       (let ((a (car xs)) (b (cadr xs)))
                         (b3s-and! (list 'IN a 'CC) (list 'IN b 'CC))
                         (fact 'cc-add-closed a b) (b3s-hpt! (list '+ a b))
                         (b3s-cc-beta!)
                         (if (b3s-open?) (dk-apply! b3s-hadd-c a b))
                         (b3s-close!))
                       (let ((a (car xs)))
                         (fact 'cc-neg-closed a) (b3s-hpt! (list '- a))
                         (b3s-cc-beta!)
                         (if (b3s-open?) (dk-apply! b3s-hneg-c a))
                         (b3s-close!)))))
                (#t (b3s-close!)))))))
  (dk-close-if! (lambda () (dk-only! iff rhs)) prop))))
;; the continuity, in the difference form of sums-to-uniform-hom
(define (b3s-nd g x y) (list (list 'NRM g) (list (list 'OPR g) x (list (list 'INV g) y))))
(define b3s-ucont
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'del (list 'AND '(POS-RR del)
      (list 'FORALL 'x (list 'IMPLIES '(IN x (CARR CC-NAG)) (list 'FORALL 'y (list 'IMPLIES '(IN y (CARR CC-NAG))
        (list 'IMPLIES (list '< (b3s-nd 'CC-NAG 'x 'y) 'del)
                       (list '< (b3s-nd 'CC-NAG '(h x) '(h y)) 'eps)))))))))))
(dk-have! b3s-ucont
  (lambda ()
    (let* ((eps (cadr (car (dk-peel!))))
           (D (list '+ 'lc 1)))
      (fact 'rr-pos-rr-in-rr eps)
      (fact 'rr-lt-of-pos-rr eps)
      (b3s-and! '(IN lc RR) '(IN 1 RR))
      (fact 'rr-add-closed 'lc 1)
      (dk-have! (list '< 0 D) (lambda () (dk-ineq! '(<= 0 lc))))
      (dk-have! (list 'NOT (list '= D 0)) (lambda () (di) (dk-absurd! (list '< 0 D) (list '= D 0))))
      (b3s-and! (list 'IN D 'RR) (list 'NOT (list '= D 0)))
      (fact 'rr-recip-closed D)
      (fact 'rr-recip-pos D)
      (b3s-and! (list 'IN eps 'RR) (list 'IN (list 'RECIP D) 'RR))
      (fact 'rr-mul-closed eps (list 'RECIP D))
      (fact 'rr-mul-pos eps (list 'RECIP D))
      (let* ((dl (dk-name! (list '* eps (list 'RECIP D))))
             (dleq (list '= dl (list '* eps (list 'RECIP D)))))
        (dk-have! (list '< 0 dl) (lambda () (subst dleq) (ass)))
        (fact 'rr-pos-rr-of-lt dl)
        (fact 'rr-recip-cancel-right eps D)
        (dk-have! (list '= eps (list '* dl D)) (lambda () (subst dleq) (ass)))
        (ew dl)
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal)) (ass)
                (let* ((landed (dk-peel!))
                       (xs (map cadr (filter (lambda (a) (dk-head-is? a 'IN)) landed)))
                       (x (car xs)) (y (cadr xs))
                       (hyp (dk-pick (lambda (a) (and (dk-head-is? a '<) (equal? (caddr a) dl))) "the del bound")))
                  (for-each (lambda (z) (dk-rewrite-h! (list 'IN z '(CARR CC-NAG)) '(CARR CC-NAG) 'CC)) xs)
                  (b3s-hpt! x) (b3s-hpt! y)
                  (fact 'cc-neg-closed y)
                  (b3s-and! (list 'IN x 'CC) (list 'IN (list '- y) 'CC))
                  (fact 'cc-add-closed x (list '- y))
                  (let* ((dv (list '+ x (list '- y)))
                         (h1 (dk-rewrite-h! hyp '(OPR CC-NAG) b3s-addl))
                         (h2 (dk-rewrite-h! h1 '(INV CC-NAG) b3s-negl))
                         (h3 (dk-rewrite-h! h2 '(NRM CC-NAG) b3s-nrml)))
                    ;; the hypothesis, beta-reduced: |x + -y| < dl
                    (let ((hb (b3s-beta-h! h3)))
                      (if (not (dk-asm? (list '< (list 'MAGNITUDE dv) dl))) (error "b3s: beta of the del bound" hb)))
                    (subst (list '== '(OPR CC-NAG) b3s-addl))
                    (subst (list '== '(INV CC-NAG) b3s-negl))
                    (subst (list '== '(NRM CC-NAG) b3s-nrml))
                    (fact 'cc-neg-closed (list 'h y))
                    (b3s-and! (list 'IN (list 'h x) 'CC) (list 'IN (list '- (list 'h y)) 'CC))
                    (fact 'cc-add-closed (list 'h x) (list '- (list 'h y)))
                    (b3s-cc-beta!)
                    ;; h x + -(h y) = h(x + -y)
                    (b3s-hpt! (list '- y)) (b3s-hpt! dv)
                    (let* ((e1 (dk-apply! b3s-hadd-c x (list '- y)))
                          (e2 (dk-apply! b3s-hneg-c y)))
                      (dk-have! (list '= (list '+ (list 'h x) (list '- (list 'h y))) (list 'h dv))
                        (lambda () (subst e1) (subst e2) (b3s-close!)))
                      (subst (list '= (list '+ (list 'h x) (list '- (list 'h y))) (list 'h dv))))
                    (let* ((bd (dk-apply! b3s-hbd-c dv))
                           (M (list 'MAGNITUDE dv)) (MH (list 'MAGNITUDE (list 'h dv))))
                      (fact 'cc-magnitude-closed dv)
                      (fact 'cc-magnitude-closed (list 'h dv))
                      (fact 'cc-magnitude-nonneg dv)
                      (b3s-and! '(IN lc RR) (list 'IN M 'RR))
                      (fact 'rr-mul-closed 'lc M)
                      (b3s-and! (list 'IN dl 'RR) '(IN lc RR))
                      (fact 'rr-mul-closed dl 'lc)
                      (b3s-and! (list 'IN dl 'RR) (list 'IN D 'RR))
                      (fact 'rr-mul-closed dl D)
                      (dk-have! (list '<= M dl) (lambda () (dk-ineq! (list '< M dl))))
                      (b3s-and! (list 'IN M 'RR) '(IN lc RR))
                      (fact 'rr-mul-closed M 'lc)
                      (fact 'rr-mul-le-right M dl 'lc)
                      (dk-have! (list '= (list '* 'lc M) (list '* M 'lc)) (lambda () (crs)))
                      (dk-have! (list '= (list '* dl D) (list '+ (list '* dl 'lc) dl)) (lambda () (crs)))
                      (dk-ineq! bd (list '= (list '* 'lc M) (list '* M 'lc)) (list '<= (list '* M 'lc) (list '* dl 'lc))
                                (list '= eps (list '* dl D)) (list '= (list '* dl D) (list '+ (list '* dl 'lc) dl))
                                (list '< 0 dl) (list 'IN MH 'RR) (list 'IN (list '* 'lc M) 'RR) (list 'IN (list '* M 'lc) 'RR)
                                (list 'IN (list '* dl 'lc) 'RR) (list 'IN dl 'RR) (list 'IN eps 'RR))))))))))))
(dk-have! '(IN f (FUN (DOM f) (CARR CC-NAG))) (lambda () (subst '(== (CARR CC-NAG) CC)) (ass)))
(dk-have! '(IN r (CARR CC-NAG)) (lambda () (subst '(== (CARR CC-NAG) CC)) (ass)))
(dk-have! (list 'IS-HOM-ABELIAN-GROUP b3s-NB b3s-NB 'h) (lambda () (ass)))
(define b3s-res (dk-cite! 'sums-to-uniform-hom 'CC-NAG 'CC-NAG 'h 'f 'r))
(b3s-close!)
(b3s-done! 'cc-sums-to-bounded-additive)

;;; ---------------------------------------------------------------------------
;;; the instances: scaling and conjugation of an unordered sum in CC
(define (b3s-tsub t al)
  (cond ((and (symbol? t) (assq t al)) => cdr)
        ((pair? t) (cons (b3s-tsub (car t) al) (b3s-tsub (cdr t) al)))
        (#t t)))
;; prove the four hypotheses of cc-sums-to-bounded-additive for the lambda HL with bound LC (typed
;; in RR, 0 <= LC in context); BOUND! proves |HL a| <= LC |a| for a typed a, after beta
(define (b3s-hyps! hl lc bound! . cls)
  (let ((al (list (cons 'h hl) (cons 'lc lc))))
    (dk-have! (list 'IN hl '(FUN CC CC))
      (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (dk-close-if! (lambda () (b3s-cc-beta!)) b3s-close!)))
                               (lambda () (fact 'cc-is-set) (ass)))))
    (dk-have! (b3s-tsub b3s-hadd al)
      (lambda () (let* ((xs (map cadr (dk-peel!))) (a (car xs)) (b (cadr xs)))
                   (b3s-and! (list 'IN a 'CC) (list 'IN b 'CC))
                   (fact 'cc-add-closed a b)
                   (dk-close-if! (lambda () (b3s-cc-beta!)) (if (pair? cls) (lambda () ((car cls) a b)) (lambda () (crs)))))))
    (dk-have! (b3s-tsub b3s-hneg al)
      (lambda () (let* ((a (cadr (car (dk-peel!)))))
                   (fact 'cc-neg-closed a)
                   (dk-close-if! (lambda () (b3s-cc-beta!)) (if (pair? cls) (lambda () ((cadr cls) a)) (lambda () (crs)))))))
    (dk-have! (list '= (list hl 0) 0)
      (lambda () (dk-have! '(IN 0 CC) (lambda () (arith)))
                 (dk-close-if! (lambda () (b3s-cc-beta!)) (if (pair? cls) (caddr cls) (lambda () (crs))))))
    (dk-have! (b3s-tsub b3s-hbd al)
      (lambda () (let* ((a (cadr (car (dk-peel!)))))
                   (b3s-cc-beta!)
                   (bound! a))))))
;; the conclusion of cc-sums-to-bounded-additive, its lambda and value brought to the user's form
(define (b3s-finish! res lam2 val2)
  (let* ((lam1 (caddr res)) (val1 (cadddr res)))
    (fact 'fun-domain-in-set '(DOM f) 'CC 'f)
    (dk-fun-ext! lam1 lam2 '(DOM f) 'CC
      (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (fact 'fun-apply-type-c 'f '(DOM f) 'CC z)
                                            (dk-close-if! (lambda () (b3s-cc-beta!)) b3s-close!)))
                               (lambda () (ass))))
      (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (fact 'fun-apply-type-c 'f '(DOM f) 'CC z)
                                            (dk-close-if! (lambda () (b3s-cc-beta!)) b3s-close!)))
                               (lambda () (ass))))
      (lambda (z) (fact 'fun-apply-type-c 'f '(DOM f) 'CC z)
                  (dk-close-if! (lambda () (b3s-cc-beta!)) b3s-close!)))
    (dk-have! (list '= val1 val2) (lambda () (dk-close-if! (lambda () (b3s-cc-beta!)) b3s-close!)))
    (let* ((r1 (dk-rewrite-h! res lam1 lam2)) (r2 (dk-rewrite-h! r1 val1 val2))) (ass))))

(define b3s-scl '(VNB-LAMBDA b3x_ CC (* c b3x_)))
(sp (make-wff
  '(FORALL c (IMPLIES (IN c CC)
     (FORALL f (IMPLIES (IN f (FUN (DOM f) CC))
       (FORALL r (IMPLIES (IN r CC)
         (IMPLIES (SUMS-TO CC-NAG f r)
           (SUMS-TO CC-NAG (VNB-LAMBDA scz_ (DOM f) (* c (f scz_))) (* c r)))))))))))
(dk-peel!)
(fact 'cc-magnitude-closed 'c)
(fact 'cc-magnitude-nonneg 'c)
(b3s-hyps! b3s-scl '(MAGNITUDE c)
  (lambda (a)
    (b3s-and! '(IN c CC) (list 'IN a 'CC))
    (fact 'cc-mul-closed 'c a)
    (fact 'cc-magnitude-closed a)
    (b3s-and! '(IN (MAGNITUDE c) RR) (list 'IN (list 'MAGNITUDE a) 'RR))
    (fact 'rr-mul-closed '(MAGNITUDE c) (list 'MAGNITUDE a))
    (let ((e (dk-cite! 'cc-magnitude-mul 'c a)))
      (fact 'cc-magnitude-closed (list '* 'c a))
      (dk-ineq! e (list 'IN (list 'MAGNITUDE (list '* 'c a)) 'RR) (list 'IN (list '* '(MAGNITUDE c) (list 'MAGNITUDE a)) 'RR)))))
(b3s-finish! (dk-cite! 'cc-sums-to-bounded-additive b3s-scl '(MAGNITUDE c) 'f 'r)
             '(VNB-LAMBDA scz_ (DOM f) (* c (f scz_))) '(* c r))
(b3s-done! 'cc-sums-to-scale)

(define b3s-cjl '(VNB-LAMBDA b3x_ CC (conjugate b3x_)))
(sp (make-wff
  '(FORALL f (IMPLIES (IN f (FUN (DOM f) CC))
     (FORALL r (IMPLIES (IN r CC)
       (IMPLIES (SUMS-TO CC-NAG f r)
         (SUMS-TO CC-NAG (VNB-LAMBDA scz_ (DOM f) (conjugate (f scz_))) (conjugate r)))))))))
(dk-peel!)
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-have! '(<= 0 1) (lambda () (arith)))
(b3s-hyps! b3s-cjl 1
  (lambda (a)
    (fact 'cc-conjugate-closed a)
    (fact 'cc-magnitude-closed a)
    (fact 'cc-magnitude-closed (list 'conjugate a))
    (let ((e (dk-cite! 'cc-magnitude-conjugate a)))
      (dk-ineq! e (list 'IN (list 'MAGNITUDE (list 'conjugate a)) 'RR) (list 'IN (list 'MAGNITUDE a) 'RR))))
  (lambda (a b) (fact 'cc-conjugate-add a b) (b3s-close!))
  (lambda (a) (fact 'cc-conjugate-neg a) (b3s-close!))
  (lambda () (dk-have! '(IN 0 RR) (lambda () (arith))) (fact 'cc-conjugate-fixes-rr 0) (b3s-close!)))
(b3s-finish! (dk-cite! 'cc-sums-to-bounded-additive b3s-cjl 1 'f 'r)
             '(VNB-LAMBDA scz_ (DOM f) (conjugate (f scz_))) '(conjugate r))
(b3s-done! 'cc-sums-to-conjugate)

;;; ===========================================================================
;;; THE BRIDGE FROM ESUM TO AN UNORDERED SUM IN CC.
;;; (1) For g : DOM g -> RR nonnegative and w a finite subset of DOM g, the partial sum in the
;;;     monoid RR-POS-STAR-ADD-MONOID is a nonnegative real and equals the partial sum in CC-NAG
;;;     (finite-set induction; the insertion laws of both finite sums).
;;; (2) A finite ESUM of a nonnegative real family is its unordered sum in CC.
(define b3s-RM 'RR-POS-STAR-ADD-MONOID)
(define (b3s-P g w) (list 'FINSUM b3s-RM g w))
(define (b3s-S g w) (list 'FINSUM b3s-NB g w))
(define (b3s-bridge-body g w)
  (list 'IMPLIES (list 'SUBSET w (list 'DOM g))
        (list 'AND (list 'IN (b3s-P g w) 'RR)
              (list 'AND (list '<= 0 (b3s-P g w)) (list '= (b3s-P g w) (b3s-S g w))))))
(define (b3s-rm-readoff! eqn) (dk-have! eqn (lambda () (quietly (lambda () (surface-goal! 'RR-POS-STAR-ADD-MONOID))) (qrfl))))
;; FINITE-SET INDUCTION (ma-induct!, algnum-countable.scm)
(define (b3s-induct! xs prop-of base! step!)
  (let* ((c     (list 'COMP 'miu_ (prop-of 'miu_)))
         (stepf (list 'FORALL 'is_
                  (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ c)))
                    (list 'FORALL 'ix_
                      (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
                        (list 'IN '(UNION is_ (PAIR ix_ ix_)) c)))))))
    (have! (list 'IN 'EMPTY-SET c)
      (lambda ()
        (for-each (lambda (leaf) (dk-focus! leaf)
                    (if (equal? (dk-goal) '(in empty-set set)) (begin (fact 'empty-set-is-set) (ass)) (base!)))
                  (dk-opened (lambda () (comp-mi))))))
    (have! stepf
      (lambda ()
        (let* ((landed (dk-peel!)) (g (dk-goal)) (u (cadr g)) (sv (cadr u)) (xv (cadr (caddr u))))
          (dk-split-all! landed)
          (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
          (fact 'pairing xv xv)
          (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET)))
          (fact 'union-set-closure sv (list 'PAIR xv xv))
          (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv c)))))
                 (ih (car (filter (lambda (f) (not (equal? f (list 'in sv 'set)))) ls))))
            (for-each (lambda (leaf) (dk-focus! leaf)
                        (if (equal? (dk-goal) (list 'in u 'set)) (ass) (step! sv xv u ih)))
                      (dk-opened (lambda () (comp-mi))))))))
    (dk-have! (list 'AND (list 'IN 'EMPTY-SET c) stepf))
    (let ((ind (dk-fact! 'finite-set-induction c)))
      (dk-have! (list 'AND (list 'IN xs 'SET) (list 'IN (list 'CARD xs) 'NN)))
      (let* ((inx (dk-apply! ind xs))
             (ls  (dk-landed (lambda () (comp-me inx)))))
        (car (filter (lambda (f) (not (equal? f (list 'in xs 'set)))) ls))))))
;; (IN x (UNION u (PAIR x x))), (SUBSET u (UNION u (PAIR x x))) for x a set
(define (b3s-insert-facts! u x)
  (let* ((pr (list 'PAIR x x)) (t1 (list 'UNION u pr)) (eq (list '= t1 (list 'UNION pr u))))
    (fact 'union-singleton-mem x u)
    (fact 'union-comm u pr)
    (fact 'union-right-subset pr u)
    (dk-have! (list 'IN x t1) (lambda () (subst eq) (ass)))
    (dk-have! (list 'SUBSET u t1) (lambda () (subst eq) (ass)))))
(define b3s-gnn '(FORALL z_ (IMPLIES (IN z_ (DOM g)) (<= 0 (g z_)))))
(sp (make-wff
  (list 'FORALL 'g (list 'IMPLIES '(IN g (FUN (DOM g) RR))
    (list 'IMPLIES b3s-gnn
      (list 'FORALL 'w_ (list 'IMPLIES '(IN w_ SET) (list 'IMPLIES '(IN (CARD w_) NN)
        (b3s-bridge-body 'g 'w_)))))))))
(dk-peel!)
(define b3s-w (cadddr (cadr (cadr (dk-goal)))))
(define b3s-D2 '(DOM g))
(define b3s-gnn-c (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a '<=))) "nonnegativity"))
(b3s-cc-readoffs!)
(b3s-rm-readoff! '(== (OPR RR-POS-STAR-ADD-MONOID) eplus))
(b3s-rm-readoff! '(== (IDEN RR-POS-STAR-ADD-MONOID) 0))
(b3s-rm-readoff! '(== (CARR RR-POS-STAR-ADD-MONOID) RR-POS-STAR))
(fact 'rr-pos-star-is-comm-monoid)
(fact 'rr-zero-in)
;; the pointwise facts at x in DOM g: g x in RR, 0 <= g x, g x in CC, g x in RR-POS-STAR
(define (b3s-gpt! x)
  (let ((gx (list 'g x)))
    (if (not (dk-asm? (list 'IN gx 'RR)))
        (begin
          (fact 'fun-apply-type-c 'g b3s-D2 'RR x)
          (dk-apply! b3s-gnn-c x)
          (fact 'rr-subset-cc gx)
          (let ((iff (dk-cite! 'rr-pos-star-membership gx)))
            (dk-have! (list 'IN gx 'RR-POS-STAR) (lambda () (dk-close-if! (lambda () (dk-only! iff (list 'IN gx 'RR) (list '<= 0 gx))) prop))))))))
;; over a subset w of DOM g: the pointwise typings both finite sums want
(define (b3s-ptw! w)
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ w) (list 'IN '(g z_) '(CARR RR-POS-STAR-ADD-MONOID))))
    (lambda () (let ((z (cadr (car (dk-peel!))))) (fact 'subset-mem-fwd w b3s-D2 z) (b3s-gpt! z)
                 (subst '(== (CARR RR-POS-STAR-ADD-MONOID) RR-POS-STAR)) (ass))))
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ w) (list 'IN '(g z_) (list 'CARR b3s-NB))))
    (lambda () (let ((z (cadr (car (dk-peel!))))) (fact 'subset-mem-fwd w b3s-D2 z) (b3s-gpt! z)
                 (subst (list '== (list 'CARR b3s-NB) 'CC)) (ass)))))
(define b3s-bridge
  (b3s-induct! b3s-w (lambda (w) (b3s-bridge-body 'g w))
    (lambda ()
      (di)
      (fact 'finsum-empty b3s-RM 'g)
      (fact 'finsum-empty b3s-NB 'g)
      (subst (list '== (b3s-P 'g 'EMPTY-SET) (list 'IDEN b3s-RM)))
      (subst (list '== (list 'IDEN b3s-RM) 0))
      (subst (list '== (b3s-S 'g 'EMPTY-SET) (list 'IDEN b3s-NB)))
      (subst (list '== (list 'IDEN b3s-NB) 0))
      (dk-conj-close! (lambda () (cond ((dk-asm? (dk-goal)) (ass)) ((dk-head-is? (dk-goal) '<=) (fact 'rr-leq-reflexive 0) (ass)) (#t (rfl))))))
    (lambda (sv xv u ih)
      (di)
      (b3s-insert-facts! sv xv)
      (fact 'subset-mem-fwd u b3s-D2 xv)
      (fact 'subset-trans sv u b3s-D2)
      (dk-split-all! (list (dk-landed-1 (lambda () (detach! ih)))))
      (b3s-gpt! xv)
      (b3s-ptw! u)
      (let* ((gx (list 'g xv)) (pu (b3s-P 'g sv)) (su (b3s-S 'g sv)))
        (fact 'finsum-cm-insert-ptwise b3s-RM sv xv 'g)
        (fact 'finsum-insert-ptwise b3s-NB sv xv 'g)
        (fact 'eplus-real-defined pu gx)
        (fact 'binplus-apply pu gx)
        (fact 'rr-subset-cc pu)
        (b3s-and! (list 'IN pu 'RR) (list 'IN gx 'RR))
        (fact 'rr-add-closed pu gx)
        (subst (list '= (b3s-P 'g u) (list (list 'OPR b3s-RM) pu gx)))
        (subst (list '== (list 'OPR b3s-RM) 'eplus))
        (subst (list '= (list 'eplus pu gx) (list 'binplus pu gx)))
        (subst (list '== (list 'binplus pu gx) (list '+ pu gx)))
        (subst (list '= (b3s-S 'g u) (list (list 'OPR b3s-NB) su gx)))
        (subst (list '= su pu))
        (dk-cite! 'cc-nag-ag-opr pu gx)
        (subst (list '= (list (list 'OPR b3s-NB) pu gx) (list '+ pu gx)))
        (dk-conj-close!
          (lambda () (cond ((dk-asm? (dk-goal)) (ass))
                           ((dk-head-is? (dk-goal) '<=) (dk-ineq! (list '<= 0 pu) (list '<= 0 gx) (list 'IN pu 'RR) (list 'IN gx 'RR)))
                           (#t (rfl)))))))))
(detach! b3s-bridge)
(b3s-close!)
(b3s-done! 'rps-finsum-eq-cc-finsum)

;;; (2) the bridge: a nonnegative real family with a finite ESUM sums to it in CC
(sp (make-wff
  (list 'FORALL 'g (list 'IMPLIES '(IN g (FUN (DOM g) RR))
    (list 'IMPLIES b3s-gnn
      (list 'IMPLIES '(IN (ESUM g) RR) '(SUMS-TO CC-NAG g (ESUM g))))))))
(dk-peel!)
(set! b3s-gnn-c (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a '<=))) "nonnegativity"))
(b3s-cc-readoffs!)
(fact 'fun-domain-in-set b3s-D2 'RR 'g)
(dk-have! (list 'IN 'g (list 'FUN b3s-D2 'RR-POS-STAR))
  (lambda ()
    (mac 'fun-codomain-iff)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'FORALL)
            (let ((kv (dk-di-var!))) (dk-close-if! (lambda () (b3s-gpt! kv)) (lambda () (ass))))
            (begin (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN 'g (list 'FUN b3s-D2 'RR))))))
                   (ass)))))))
(define b3s-E '(ESUM g))
(fact 'rr-subset-cc b3s-E)
(mac 'SUMS-TO)
(let* ((eps (cadr (car (dk-peel!))))
       (ap (dk-cite! 'rb2-esum-approx 'g eps))
       (t (dk-skolem! ap #t)))
  (fact 'rr-pos-rr-in-rr eps)
  (ew t)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (ass)
          (let* ((landed (dk-peel!))
                 (ext (cadr (cadr (car landed)))))
            (dk-split-all!)
            (dk-cite! 'rps-finsum-eq-cc-finsum 'g ext)
            (dk-split-all!)
            (dk-cite! 'rps-finsum-eq-cc-finsum 'g t)
            (dk-split-all!)
            (dk-have! (list 'AND (list 'IN ext 'SET) (list 'AND (list 'IN (list 'CARD ext) 'NN) (list 'SUBSET ext b3s-D2))))
            (fact 'esum-upper 'g ext)
            (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ ext) (list 'IN '(g z_) 'RR-POS-STAR)))
              (lambda () (let ((z (cadr (car (dk-peel!))))) (fact 'subset-mem-fwd ext b3s-D2 z)
                           (dk-close-if! (lambda () (b3s-gpt! z)) (lambda () (ass))))))
            (fact 'rps-finsum-mono-set 'g t ext)
            (let* ((Pe (b3s-P 'g ext)) (Pt (b3s-P 'g t)) (Se (b3s-S 'g ext))
                   (dv (list '+ b3s-E (list '- Pe))))
              (subst (list '= Se Pe))
              (subst (list '== '(OPR CC-NAG) b3s-addl))
              (subst (list '== '(INV CC-NAG) b3s-negl))
              (subst (list '== '(NRM CC-NAG) b3s-nrml))
              (fact 'rr-subset-cc Pe)
              (fact 'rr-neg-closed Pe)
              (b3s-and! (list 'IN b3s-E 'RR) (list 'IN (list '- Pe) 'RR))
              (fact 'rr-add-closed b3s-E (list '- Pe))
              (fact 'rr-subset-cc dv)
              (fact 'cc-neg-closed Pe)
              (b3s-cc-beta!)
              (fact 'rr-magnitude-is-abs dv)
              (fact 'cc-magnitude-closed dv)
              (dk-have! (list '<= 0 dv) (lambda () (dk-ineq! (list '<= Pe b3s-E) (list 'IN b3s-E 'RR) (list 'IN Pe 'RR))))
              (fact 'rr-abs-of-nonneg dv)
              (dk-ineq! (list '= (list 'MAGNITUDE dv) (list 'ABS dv)) (list '= (list 'ABS dv) dv)
                        (list '< b3s-E (list '+ Pt eps)) (list '<= Pt Pe) (list '<= Pe b3s-E)
                        (list 'IN b3s-E 'RR) (list 'IN Pe 'RR) (list 'IN Pt 'RR) (list 'IN eps 'RR)
                        (list 'IN (list 'MAGNITUDE dv) 'RR))))))))
(b3s-done! 'esum-sums-to-cc)
