(define (gs5-open-assoc! f)
  (let ((ex (list 'FORSOME 'gsw_ (list 'AND '(IS-UNIT s gsw_) (list '= (cadddr f) (list '(MUL s) 'gsw_ (caddr f)))))))
    (dk-have! ex (lambda () (mac-h 'associated f) (dk-split-all!) (ass))))
  (let ((w (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm (cadddr f)) (dk-contains? fm 'IS-UNIT))) "the unit"))))
    (dk-split-all!)
    w))
(define (gs5-unit-inv! u)
  (gs-iff! 'is-unit (list 'IS-UNIT 's u) 's u)
  (let ((v (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm u) (dk-contains? fm '(ONE s)))) "the inverse"))))
    (dk-split-all!)
    v))
(define gs5-PA gs5-A0)
(define gs5-PB gs5-B0)
