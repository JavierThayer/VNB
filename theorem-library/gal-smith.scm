(define gs-NM 'NN-ADD-MONOID)
(define (gs-monoid!)
  (if (not (dk-asm? '(IS-MONOID NN-ADD-MONOID)))
      (begin (fact 'nn-add-monoid-is-comm-monoid) (fact 'comm-monoid-is-monoid 'NN-ADD-MONOID))))
(define (gs-nm-carr!)
  (if (not (dk-asm? '(= (CARR NN-ADD-MONOID) NN)))
      (dk-have! '(= (CARR NN-ADD-MONOID) NN) (lambda () (slot 'CARR) (rfl)))))
(define (gs-fs! a f)
  (let ((want (list 'IN f (list 'FINSUPP a gs-NM))))
    (if (not (dk-asm? want))
        (dk-have! want (lambda () (mac-h 'poly-carrier (list 'IN f (gs-cp a))) (ass))))))
(define (gs-km! k)
  (let ((want (list 'IN k '(CARR NN-ADD-MONOID))))
    (if (not (dk-asm? want))
        (dk-have! want (lambda () (slot 'CARR) (ass))))))
(define (gs-iff! thm lhs . args)
  (let ((ii (apply dk-cite! thm args)))
    (if (not (every dk-asm? (gs-conjs (caddr ii))))
        (begin
          (dk-have! (caddr ii) (lambda () (dk-close-if! (lambda () (dk-only! ii lhs)) prop)))
          (dk-split-all! (list (caddr ii)))))
    (caddr ii)))
(define (gs-split! f)
  (if (not (every dk-asm? (gs-conjs f))) (dk-split-all! (list f)))
  f)
(define (gs-conjs f) (if (and (pair? f) (eq? (car f) 'AND)) (append (gs-conjs (cadr f)) (gs-conjs (caddr f))) (list f)))
(define (gs-val! a f k)
  (let ((want (list 'IN (list f k) (list 'CARR a))))
    (if (not (dk-asm? want))
        (begin
          (gs-km! k)
          (gs-iff! 'finsupp-membership (list 'IN f (list 'FINSUPP a gs-NM)) a gs-NM f)
          (dk-cite! 'fun-apply-type-c f '(CARR NN-ADD-MONOID) (list 'CARR a) k)))))
(define (gs-fk!)
  (if (not (dk-asm? '(IS-COMMUTATIVE-RING (POLY fk))))
      (begin
        (gs-iff! 'is-field-ring-def '(IS-FIELD-RING fk) 'fk)
        (dk-cite! 'commutative-ring-is-ring 'fk)
        (dk-cite! 'ring-zero-in 'fk) (dk-cite! 'ring-one-in 'fk)
        (gs-monoid!) (gs-nm-carr!)
        (dk-have! '(IS-COMMUTATIVE-RING (POLY fk)) (lambda () (dk-cite! 'monalg-comm 'fk gs-NM) (mac 'POLY) (ass)))
        (dk-cite! 'commutative-ring-is-ring '(POLY fk))
        (dk-cite! 'ring-zero-in '(POLY fk)))))
(define (gs-pm a b) (list '(MUL (POLY fk)) a b))
(define (gs-pa a b) (list '(ADD (POLY fk)) a b))
(define (gs-pn a) (list '(NEG (POLY fk)) a))
(define gs-PZ '(ZERO (POLY fk)))
(define (gs-pin! i j)
  (fact 'nn-in-rr i) (fact 'nn-in-rr j) (fact 'nn-in-rr 'n_) (fact 'nn-in-rr 'd_)
  (let ((h (list '= (list '+ i j) gs-X)))
    (dk-have! (list '<= 'n_ i) (lambda () (dk-ineq! h (list '<= j 'd_) (list 'IN i 'RR) (list 'IN j 'RR) '(IN n_ RR) '(IN d_ RR))))
    (dk-have! (list '<= 'd_ j) (lambda () (dk-ineq! h (list '<= i 'n_) (list 'IN i 'RR) (list 'IN j 'RR) '(IN n_ RR) '(IN d_ RR))))
    (dk-cite! 'nn-le-antisym i 'n_)
    (dk-cite! 'nn-le-antisym j 'd_)))
(define (gs-int-mem! i hi)
  (gs-iff! 'interval-membership (list 'IN i (list 'INTERVAL 1 hi)) 1 hi i))
(define (gs-int-in! i hi)
  (if (not (dk-asm? (list 'IN i (list 'INTERVAL 1 hi))))
      (dk-have! (list 'IN i (list 'INTERVAL 1 hi))
        (lambda ()
          (dk-have! (list '<= 1 i) (lambda () (dk-nn!)))
          (dk-have! (list '<= i hi) (lambda () (dk-nn!)))
          (dk-cite! 'interval-mem-intro 1 hi i)
          (ass)))))
(define (gs-int-shrink! i n)
  (let ((sn (list 'succ n)))
    (gs-int-mem! i sn)
    (dk-have! (list 'NOT (list '= sn i))
      (lambda ()
        (di)
        (let ((h (dk-rewrite-h! (list 'NOT (list '= i sn)) sn i)))
          (dk-have! (list '= i i) (lambda () (rfl)))
          (dk-close-if! (lambda () (dk-only! h (list '= i i))) prop))))
    (fact 'nn-le-ne-succ i sn)
    (gs-int-in! i n)))
(define (gs-lt-from-ne! n k)
  (fact 'nn-le-ne-succ n k)
  (dk-have! (list '< n k) (lambda () (dk-nn!))))
(define (gs-rfl-or-ass!) (if (dk-asm? (dk-goal)) (ass) (rfl)))
(define (gs-step-goal? gl)
  (let ((body (and (dk-head-is? gl 'FORALL) (caddr gl))))
    (and body (dk-head-is? body 'IMPLIES) (dk-head-is? (cadr body) 'IN) (eq? (caddr (cadr body)) 'NN))))
(define (gs-bound-mono! a p n m)
  ;; DEG-BOUND(a, p, n), n <= m in context, n m in NN: land DEG-BOUND(a, p, m)
  (let ((bi (dk-cite! 'deg-bound a p m)))
    (dk-have! (caddr bi)
      (lambda ()
        (let* ((ls (dk-peel!))
               (k (cadr (car (filter (lambda (fm) (and (dk-head-is? fm 'IN) (eq? (caddr fm) 'NN))) ls)))))
          (dk-have! (list '< n k) (lambda () (dk-nn!)))
          (dk-cite! 'deg-bound-apply a p n k)
          (ass))))
    (dk-have! (list 'DEG-BOUND a p m) (lambda () (dk-close-if! (lambda () (dk-only! bi (caddr bi))) prop)))))
(define (gs-cp a) (list 'CARR (list 'POLY a)))

;;; ---- elements dividing each other are associated (integral domain) ----
(sp (make-wff '(FORALL s (IMPLIES (IS-INTEGRAL-DOMAIN s) (FORALL a (FORALL b (IMPLIES (DIVIDES s a b) (IMPLIES (DIVIDES s b a) (ASSOCIATED s a b)))))))))
(dk-peel!)
(dk-cite! 'integral-domain-is-commutative-ring 's)
(dk-cite! 'commutative-ring-is-ring 's)
(dk-cite! 'ring-zero-in 's) (dk-cite! 'ring-one-in 's)
(gs-iff! 'divides '(DIVIDES s a b) 's 'a 'b)
(define gs1-k (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm '(= b ((MUL s) gdk_ a))))) "k")))
(dk-split-all!)
(gs-iff! 'divides '(DIVIDES s b a) 's 'b 'a)
(define gs1-l (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm '(= a ((MUL s) gdk_ b))))) "l")))
(dk-split-all!)
(define gs1-as (dk-cite! 'associated 's 'a 'b))
(define (gs1-unit! u w)
  ;; IS-UNIT(s, u) from u w = 1
  (let ((ui (dk-cite! 'is-unit 's u)))
    (dk-have! (caddr ui) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew w) (dk-conj-close!)))))))
    (dk-have! (list 'IS-UNIT 's u) (lambda () (dk-close-if! (lambda () (dk-only! ui (caddr ui))) prop)))))
(use-em '(= a (ZERO s))
  (lambda ()
    (dk-have! '(= ((MUL s) (ONE s) (ONE s)) (ONE s)) (lambda () (crs)))
    (gs1-unit! '(ONE s) '(ONE s))
    (dk-have! '(= b ((MUL s) (ONE s) a))
      (lambda ()
        (subst (list '= 'b (list '(MUL s) gs1-k 'a)))
        (subst '(= a (ZERO s)))
        (crs)))
    (dk-have! (caddr gs1-as) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew '(ONE s)) (dk-conj-close!)))))))
    (dk-close-if! (lambda () (dk-only! gs1-as (caddr gs1-as))) prop))
  (lambda ()
    (let* ((x (list '(ADD s) '(ONE s) (list '(NEG s) (list '(MUL s) gs1-l gs1-k))))
           (h0 (list '= (list '(MUL s) x 'a) (list '(ADD s) 'a (list '(NEG s) (list '(MUL s) gs1-l (list '(MUL s) gs1-k 'a)))))))
      (dk-cite! 'ring-carrier-closed-mul 's gs1-l gs1-k)
      (dk-cite! 'ring-neg-in-carr 's (list '(MUL s) gs1-l gs1-k))
      (dk-cite! 'ring-add-closed 's '(ONE s) (list '(NEG s) (list '(MUL s) gs1-l gs1-k)))
      (dk-have! h0 (lambda () (crs)))
      (let* ((h1 (dk-rewrite-h! h0 (list '(MUL s) gs1-k 'a) 'b))
             (h2 (dk-rewrite-h! h1 (list '(MUL s) gs1-l 'b) 'a)))
        (dk-have! (list '= (list '(MUL s) x 'a) '(ZERO s)) (lambda () (subst h2) (crs)))
        (dk-cite! 'integral-domain-cancel-zero 's x 'a)
        (dk-have! (list '= (list '(MUL s) gs1-k gs1-l) '(ONE s))
          (lambda ()
            (dk-have! (list '= '(ONE s) (list '(ADD s) x (list '(MUL s) gs1-l gs1-k))) (lambda () (crs)))
            (let ((h3 (dk-rewrite-h! (list '= '(ONE s) (list '(ADD s) x (list '(MUL s) gs1-l gs1-k))) x '(ZERO s))))
              (subst h3)
              (crs))))
        (gs1-unit! gs1-k gs1-l)
        (dk-have! (caddr gs1-as) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew gs1-k) (dk-conj-close!)))))))
        (dk-close-if! (lambda () (dk-only! gs1-as (caddr gs1-as))) prop)))))
(qed 'mutual-divides-associated)
(topic! 'mutual-divides-associated 'algebra)

;;; ---- COROLLARY 1.24: elementarily equivalent matrices have associated gcds of s-minors ----
(define (gs-sd a) (list 'SDET 's 'm 'n a 'sg_))
;; x in SDET(s, m, n, a, sg_): land x in CARR(s)
(define (gs-sd-carr! a x)
  (if (not (dk-asm? (list 'IN x '(CARR s))))
      (dk-have! (list 'IN x '(CARR s))
        (lambda () (mac-h 'sdet-unfold (list 'IN x (gs-sd a)))
                   (sep-me (dk-pick (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (cadr fm) x) (dk-head-is? (caddr fm) 'SEP))) "the SEP membership"))
                   (ass)))))
;; c a common divisor of SDET(a) (clause in context): c is a common divisor of SDET(b)
(define (gs-transfer! c a b gcd-hyp-of-b)
  (let* ((pa (list 'FORALL 'dvx_ (list 'IMPLIES (list 'IN 'dvx_ (gs-sd a))
               (list 'FORSOME 'dvy_ (list 'AND '(IN dvy_ (CARR s)) (list '= 'dvx_ (list '(MUL s) c 'dvy_)))))))
         (cda (list 'FORALL 'ggx_ (list 'IMPLIES (list 'IN 'ggx_ (gs-sd a)) (list 'DIVIDES 's c 'ggx_)))))
    (dk-have! pa
      (lambda ()
        (let ((x (dk-di-var!)))
          (dk-apply! cda x)
          (gs-iff! 'divides (list 'DIVIDES 's c x) 's c x)
          (let ((k (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm x) (dk-contains? fm c))) "k"))))
            (dk-split-all!)
            (ew k)
            (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (subst (list '= x (list '(MUL s) k c))) (crs)))))))))
    (let ((pb (dk-cite! 'sdet-divisor-equiv 's 'm 'n 'sg_ c a b))
          (cdb (list 'FORALL 'ggx_ (list 'IMPLIES (list 'IN 'ggx_ (gs-sd b)) (list 'DIVIDES 's c 'ggx_)))))
      (dk-have! cdb
        (lambda ()
          (let ((x (dk-di-var!)))
            (gs-sd-carr! b x)
            (let ((y (dk-skolem! (dk-apply! pb x))))
              (dk-split-all!)
              (let ((di (dk-cite! 'divides 's c x)))
                (dk-have! (caddr di)
                  (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                            (begin (ew y) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (subst (list '= x (list '(MUL s) c y))) (crs)))))))))))
                (dk-close-if! (lambda () (dk-only! di (caddr di))) prop))))))
      (dk-apply! gcd-hyp-of-b c))))
(sp (make-wff '(FORALL s (IMPLIES (IS-EUCLIDEAN-DOMAIN s) (FORALL m (IMPLIES (IN m NN) (FORALL n (IMPLIES (IN n NN) (FORALL sg_ (IMPLIES (IN sg_ NN)
  (FORALL a (IMPLIES (IN a (MAT m n (CARR s))) (FORALL b (IMPLIES (IN b (MAT m n (CARR s))) (IMPLIES (ELEM-EQUIV s m n a b)
    (FORALL d (IMPLIES (IS-GCD-SET s (SDET s m n a sg_) d) (FORALL e (IMPLIES (IS-GCD-SET s (SDET s m n b sg_) e)
      (ASSOCIATED s d e))))))))))))))))))))
(dk-peel!)
(gs-iff! 'is-euclidean-domain '(IS-EUCLIDEAN-DOMAIN s) 's)
(dk-cite! 'integral-domain-is-commutative-ring 's)
(dk-cite! 'commutative-ring-is-ring 's)
(dk-cite! 'elem-equiv-symmetric 's 'm 'n 'a 'b)
(gs-iff! 'is-gcd-set (list 'IS-GCD-SET 's (gs-sd 'a) 'd) 's (gs-sd 'a) 'd)
(gs-iff! 'is-gcd-set (list 'IS-GCD-SET 's (gs-sd 'b) 'e) 's (gs-sd 'b) 'e)
(define (gs2-gcd-clause S d)
  (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm S) (dk-contains? fm (list 'DIVIDES 's 'gge_ d)))) "gcd clause"))
(gs-transfer! 'd 'a 'b (gs2-gcd-clause (gs-sd 'b) 'e))
(gs-transfer! 'e 'b 'a (gs2-gcd-clause (gs-sd 'a) 'd))
