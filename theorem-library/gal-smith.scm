;; P(d, k) in CARR(s), with k <= m, k <= n in context
(define (gs-P-typ! d k)
  (fact 'interval-in-set 1 k)
  (if (not (dk-asm? (list 'IN (list 'CARD (list 'INTERVAL 1 k)) 'NN)))
      (dk-have! (list 'IN (list 'CARD (list 'INTERVAL 1 k)) 'NN) (lambda () (subst (dk-cite! 'interval-card k)) (ass))))
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ (list 'INTERVAL 1 k)) (list 'IN (list (gs-lam d k) 'z_) '(CARR s))))
    (lambda ()
      (let ((i (dk-di-var!)))
        (dk-cite! 'interval-widen k 'm 1 i)
        (dk-cite! 'interval-widen k 'n 1 i)
        (dk-cite! 'entry-in-carrier 'm 'n '(CARR s) d i i)
        (dk-close-if! (lambda () (lam-b)) gs-rfl-or-ass!))))
  (dk-cite! 'prod-ring-type-ptwise 's (list 'INTERVAL 1 k) (gs-lam d k)))
;; typing of a ring expression in CARR(s)
(define (gs-in-ring! t)
  (if (not (dk-asm? (list 'IN t '(CARR s))))
      (cond ((and (pair? t) (equal? (car t) '(MUL s))) (gs-in-ring! (cadr t)) (gs-in-ring! (caddr t)) (dk-cite! 'ring-carrier-closed-mul 's (cadr t) (caddr t)))
            ((and (pair? t) (equal? (car t) '(ADD s))) (gs-in-ring! (cadr t)) (gs-in-ring! (caddr t)) (dk-cite! 'ring-add-closed 's (cadr t) (caddr t)))
            ((and (pair? t) (equal? (car t) '(NEG s))) (gs-in-ring! (cadr t)) (dk-cite! 'ring-neg-in-carr 's (cadr t)))
            (#t (error "gs-in-ring!: cannot type" t)))))
;;; ---- PROPOSITION 1.27 (uniqueness): two normal forms of A have associated diagonal entries ----
(define (gs-nf-wrap d body)
  (list 'IMPLIES (list 'IN d '(MAT m n (CARR s))) (list 'IMPLIES (list 'IS-DIAGONAL 's 'm 'n d) (list 'IMPLIES (gs-ch d) (list 'IMPLIES (list 'ELEM-EQUIV 's 'm 'n 'a d) body)))))
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-EUCLIDEAN-DOMAIN s) (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
  (list 'FORALL 'a (list 'IMPLIES '(IN a (MAT m n (CARR s)))
    (list 'FORALL 'd (gs-nf-wrap 'd (list 'FORALL 'dd_ (gs-nf-wrap 'dd_
      (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN) (list 'IMPLIES '(<= (succ k_) m) (list 'IMPLIES '(<= (succ k_) n)
        (list 'ASSOCIATED 's (gs-e 'd '(succ k_)) (gs-e 'dd_ '(succ k_)))))))))))))))))))))
