(define gs5-a2 (gs5-assoc-P! '(succ k_)))
(define gs5-A0 (gs-P 'd 'k_))
(define gs5-B0 (gs-P 'dd_ 'k_))
(define gs5-e1 (gs-e 'd '(succ k_)))
(define gs5-e2 (gs-e 'dd_ '(succ k_)))
