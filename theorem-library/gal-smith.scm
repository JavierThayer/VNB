(set! gs5-B0 (dk-name! gs5-PB '(CARR s)))
(set! gs5-a1 (dk-rewrite-h! (dk-rewrite-h! gs5-a1 gs5-PA gs5-A0) gs5-PB gs5-B0))
(set! gs5-a2b (dk-rewrite-h! (dk-rewrite-h! gs5-a2b gs5-PA gs5-A0) gs5-PB gs5-B0))
(define gs5-u (gs5-open-assoc! gs5-a1))
(define gs5-w (gs5-open-assoc! gs5-a2b))
(define gs5-goal-as (dk-cite! 'associated 's gs5-e1 gs5-e2))

(define gs5-G (list 'ASSOCIATED 's gs5-e1 gs5-e2))
(define gs5-Z (list '= gs5-A0 '(ZERO s)))
(define (gs5-case! hyp body)
  (dk-have! (list 'IMPLIES hyp gs5-G) (lambda () (di) (body))))
(define gs5-v (gs5-unit-inv! gs5-u))
(define gs5-w2 (gs5-unit-inv! gs5-w))
(gs5-case! gs5-Z
  (lambda ()
    (dk-have! (list '= gs5-B0 '(ZERO s)) (lambda () (subst (list '= gs5-B0 (list '(MUL s) gs5-u gs5-A0))) (subst (list '= gs5-A0 '(ZERO s))) (crs)))
    (dk-cite! 'integral-domain-is-commutative-ring 's)
    (dk-have! (list '= gs5-PA '(ZERO s)) (lambda () (subst (list '= gs5-PA gs5-A0)) (ass)))
    (dk-have! (list '= gs5-PB '(ZERO s)) (lambda () (subst (list '= gs5-PB gs5-B0)) (ass)))
    (dk-cite! 'diagonal-chain-zero-propagates 'k_ 's 'm 'n 'd)
    (dk-cite! 'diagonal-chain-zero-propagates 'k_ 's 'm 'n 'dd_)
    (dk-have! '(= ((MUL s) (ONE s) (ONE s)) (ONE s)) (lambda () (crs)))
    (gs1-unit! '(ONE s) '(ONE s))
    (dk-have! (caddr gs5-goal-as)
      (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                (begin (ew '(ONE s)) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                                                                  (begin (subst (list '= gs5-e2 '(ZERO s))) (subst (list '= gs5-e1 '(ZERO s))) (crs)))))))))))
    (dk-close-if! (lambda () (dk-only! gs5-goal-as (caddr gs5-goal-as))) prop)))
(gs5-case! (list 'NOT gs5-Z)
  (lambda ()
    (let* ((v gs5-v)
           (w2 gs5-w2)
           (x (list '(ADD s) (list '(MUL s) gs5-u gs5-e2) (list '(NEG s) (list '(MUL s) gs5-w gs5-e1))))
           (h0 (list '= (list '(MUL s) x gs5-A0) (list '(ADD s) (list '(MUL s) (list '(MUL s) gs5-u gs5-A0) gs5-e2) (list '(NEG s) (list '(MUL s) gs5-w (list '(MUL s) gs5-A0 gs5-e1)))))))
      (gs-in-ring! x)
      (dk-have! h0 (lambda () (crs)))
      (let* ((h1 (dk-rewrite-h! h0 (list '(MUL s) gs5-u gs5-A0) gs5-B0))
             (h2 (dk-rewrite-h! h1 (list '(MUL s) gs5-B0 gs5-e2) (list '(MUL s) gs5-w (list '(MUL s) gs5-A0 gs5-e1)))))
        (dk-have! (list '= (list '(MUL s) x gs5-A0) '(ZERO s)) (lambda () (subst h2) (crs)))
        (dk-cite! 'integral-domain-cancel-zero 's x gs5-A0)
        (let* ((vw (list '(MUL s) v gs5-w))
               (i1 (list '= (list '(MUL s) v x) (list '(ADD s) (list '(MUL s) (list '(MUL s) gs5-u v) gs5-e2) (list '(NEG s) (list '(MUL s) vw gs5-e1)))))
               (zz (dk-have! i1 (lambda () (crs))))
               (i2 (dk-rewrite-h! (dk-rewrite-h! i1 (list '(MUL s) gs5-u v) '(ONE s)) x '(ZERO s)))
               (core (cadr (caddr i2))))
          (dk-have! (list '= gs5-e2 (list '(MUL s) vw gs5-e1))
            (lambda ()
              (dk-have! (list '= gs5-e2 (list '(ADD s) (caddr i2) (list '(MUL s) vw gs5-e1))) (lambda () (crs)))
              (let ((h3 (dk-rewrite-h! (list '= gs5-e2 (list '(ADD s) (caddr i2) (list '(MUL s) vw gs5-e1))) (caddr i2) (cadr i2))))
                (dk-have! (list '= (list '(ADD s) (cadr i2) (list '(MUL s) vw gs5-e1)) (list '(MUL s) vw gs5-e1)) (lambda () (crs)))
                (dk-rewrite-h! h3 (list '(ADD s) (cadr i2) (list '(MUL s) vw gs5-e1)) (list '(MUL s) vw gs5-e1))
                (ass))))
          ;; v w is a unit
          (let ((inv (list '(MUL s) w2 gs5-u)))
            (gs-in-ring! vw) (gs-in-ring! inv)
            (dk-have! (list '= (list '(MUL s) vw inv) '(ONE s))
              (lambda ()
                (dk-have! (list '= (list '(MUL s) vw inv) (list '(MUL s) (list '(MUL s) gs5-u v) (list '(MUL s) gs5-w w2))) (lambda () (crs)))
                (subst (list '= (list '(MUL s) vw inv) (list '(MUL s) (list '(MUL s) gs5-u v) (list '(MUL s) gs5-w w2))))
                (subst (list '= (list '(MUL s) gs5-u v) '(ONE s)))
                (subst (list '= (list '(MUL s) gs5-w w2) '(ONE s)))
                (crs)))
            (gs1-unit! vw inv))
          (dk-have! (caddr gs5-goal-as)
            (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew vw) (dk-conj-close!)))))))
          (dk-close-if! (lambda () (dk-only! gs5-goal-as (caddr gs5-goal-as))) prop))))))
(dk-close-if! (lambda () (dk-only! (list 'IMPLIES gs5-Z gs5-G) (list 'IMPLIES (list 'NOT gs5-Z) gs5-G))) prop)
