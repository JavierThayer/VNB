;;; ---- the product of the first sg diagonal entries is a gcd of the sg-minors of a normal form ----
(define (gs-ch d)
  (list 'FORALL 'ci_ (list 'FORALL 'cj_ (list 'IMPLIES '(IN ci_ (INTERVAL 1 m)) (list 'IMPLIES '(IN ci_ (INTERVAL 1 n))
    (list 'IMPLIES '(IN cj_ (INTERVAL 1 m)) (list 'IMPLIES '(IN cj_ (INTERVAL 1 n)) (list 'IMPLIES '(<= ci_ cj_)
      (list 'DIVIDES 's (list 'ENTRY d 'ci_ 'ci_) (list 'ENTRY d 'cj_ 'cj_))))))))))
(define (gs-chm d)
  (list 'FORALL 'ci_ (list 'FORALL 'cj_ (list 'IMPLIES '(IN ci_ (INTERVAL 1 m)) (list 'IMPLIES '(IN ci_ (INTERVAL 1 n))
    (list 'IMPLIES '(IN cj_ (INTERVAL 1 m)) (list 'IMPLIES '(IN cj_ (INTERVAL 1 n)) (list 'IMPLIES '(<= ci_ cj_)
      (list 'FORSOME 'dvy_ (list 'AND '(IN dvy_ (CARR s)) (list '= (list 'ENTRY d 'cj_ 'cj_) (list '(MUL s) (list 'ENTRY d 'ci_ 'ci_) 'dvy_))))))))))))
(define (gs-lam d k) (list 'VNB-LAMBDA 'pk_ (list 'INTERVAL 1 k) (list 'ENTRY d 'pk_ 'pk_)))
(define (gs-P d k) (list 'PROD-RING 's (gs-lam d k) (list 'INTERVAL 1 k)))
;; the chain with DIVIDES gives the chain in the multiplicative form the sdet lemmas use
(define (gs-chm! d)
  (dk-have! (gs-chm d)
    (lambda ()
      (let* ((ls (dk-peel!))
             (le (car (filter (dk-head? '<=) ls)))
             (ci (cadr le)) (cj (caddr le))
             (eii (list 'ENTRY d ci ci)) (ejj (list 'ENTRY d cj cj))
             (dv (dk-apply! (gs-ch d) ci cj)))
        (gs-iff! 'divides dv 's eii ejj)
        (let ((k (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm ejj) (dk-contains? fm 'gdk_))) "the quotient"))))
          (dk-split-all!)
          (ew k)
          (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (subst (list '= ejj (list '(MUL s) k eii))) (crs))))))))))

(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-COMMUTATIVE-RING s) (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
  (list 'FORALL 'd (list 'IMPLIES '(IN d (MAT m n (CARR s))) (list 'IMPLIES '(IS-DIAGONAL s m n d) (list 'IMPLIES (gs-ch 'd)
    (list 'FORALL 'sg_ (list 'IMPLIES '(IN sg_ NN) (list 'IMPLIES '(<= sg_ m) (list 'IMPLIES '(<= sg_ n)
      (list 'IS-GCD-SET 's '(SDET s m n d sg_) (gs-P 'd 'sg_))))))))))))))))))
(dk-peel!)
(dk-cite! 'commutative-ring-is-ring 's)
(gs-chm! 'd)
(define gs3-P (gs-P 'd 'sg_))
(fact 'interval-in-set 1 'sg_)
(dk-have! '(IN (CARD (INTERVAL 1 sg_)) NN) (lambda () (subst (dk-cite! 'interval-card 'sg_)) (ass)))
(dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ (INTERVAL 1 sg_)) (list 'IN (list (gs-lam 'd 'sg_) 'z_) '(CARR s))))
  (lambda ()
    (let ((k (dk-di-var!)))
      (dk-cite! 'interval-widen 'sg_ 'm 1 k)
      (dk-cite! 'interval-widen 'sg_ 'n 1 k)
      (dk-cite! 'entry-in-carrier 'm 'n '(CARR s) 'd k k)
      (dk-close-if! (lambda () (lam-b)) gs-rfl-or-ass!))))
(dk-cite! 'prod-ring-type-ptwise 's '(INTERVAL 1 sg_) (gs-lam 'd 'sg_))
;; the product is itself an sg-minor: the leading one
(define gs3-id '(VNB-LAMBDA idx_ (INTERVAL 1 sg_) idx_))
(dk-cite! 'lzd-id-injection 'sg_ 'm)
(dk-cite! 'lzd-id-injection 'sg_ 'n)
(dk-cite! 'sdet-intro 's 'm 'n 'sg_ 'd gs3-id gs3-id)
(define gs3-lead (dk-cite! 'diagonal-leading-minor 's 'm 'n 'd 'sg_))
(define gs3-Pin (dk-rewrite-h! (list 'IN (list 'DET 's 'sg_ (list 'SUBMATRIX 'd 'sg_ gs3-id gs3-id)) '(SDET s m n d sg_)) (cadr gs3-lead) gs3-P))
(define gs3-gi (dk-cite! 'is-gcd-set 's '(SDET s m n d sg_) gs3-P))
(dk-have! (caddr gs3-gi)
  (lambda ()
    (dk-conj-close!
      (lambda ()
        (cond ((dk-asm? (dk-goal)) (ass))
              ((dk-contains? (dk-goal) 'gge_)
               (let* ((ls (dk-peel!))
                      (cd (car (filter (dk-head? 'FORALL) ls))))
                 (dk-apply! cd gs3-P)
                 (ass)))
              (#t
               (let* ((x (dk-di-var!))
                      (ex (dk-cite! 'sdet-elim 's 'm 'n 'd 'sg_ x))
                      (pp (dk-skolem! ex)))
                 (dk-split-all!)
                 (let* ((qq (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm pp))) "q")))
                        (z (dk-split-all!))
                        (det (list 'DET 's 'sg_ (list 'SUBMATRIX 'd 'sg_ pp qq)))
                        (y (dk-skolem! (dk-cite! 'diagonal-chain-minor-divisible 'sg_ 's 'm 'n 'd pp qq))))
                   (dk-split-all!)
                   (mac-h 'sdet-unfold (list 'IN x '(SDET s m n d sg_)))
                   (sep-me (dk-pick (lambda (fm) (and (dk-head-is? fm 'IN) (equal? (cadr fm) x) (dk-head-is? (caddr fm) 'SEP))) "SEP membership"))
                   (let ((di (dk-cite! 'divides 's gs3-P x)))
                     (dk-have! (caddr di)
                       (lambda ()
                         (dk-conj-close!
                           (lambda ()
                             (if (dk-asm? (dk-goal)) (ass)
                                 (begin (ew y)
                                        (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                                       (begin (subst (list '= x det)) (subst (list '= det (list '(MUL s) gs3-P y))) (crs)))))))))))
                     (dk-close-if! (lambda () (dk-only! di (caddr di))) prop))))))))))
(dk-close-if! (lambda () (dk-only! gs3-gi (caddr gs3-gi))) prop)
(qed 'diagonal-chain-product-gcd)
(topic! 'diagonal-chain-product-gcd 'algebra)

;;; ---- in a chain, a vanishing partial product forces the next diagonal entry to vanish ----
(define (gs-e d k) (list 'ENTRY d k k))
(define (gs-diag-facts! d)
  ;; the chain in context (gs-ch d): land the multiplicative chain too
  (gs-chm! d))
(sp (make-wff (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN) (list 'FORALL 's (list 'IMPLIES '(IS-INTEGRAL-DOMAIN s)
  (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
  (list 'FORALL 'd (list 'IMPLIES '(IN d (MAT m n (CARR s))) (list 'IMPLIES (gs-ch 'd)
    (list 'IMPLIES '(<= (succ k_) m) (list 'IMPLIES '(<= (succ k_) n)
      (list 'IMPLIES (list '= (gs-P 'd 'k_) '(ZERO s)) (list '= (gs-e 'd '(succ k_)) '(ZERO s))))))))))))))))))
