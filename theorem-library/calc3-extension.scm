;;; calc3-extension.scm -- calculus.pdf Prop 3.26: A UNIFORMLY CONTINUOUS FUNCTION ON
;;; A DENSE SUBSPACE, WITH VALUES IN A COMPLETE SPACE, HAS A UNIQUE UNIFORMLY
;;; CONTINUOUS EXTENSION.  Agent CALC-3, 2026-10-19.
;;;
;;; THE NOTES.  "Suppose X, Y are metric spaces, A subset X is a dense subspace.
;;; Suppose Y is complete.  Then every uniformly continuous function f : A --> Y has a
;;; unique extension to a uniformly continuous function fbar : X --> Y."  The notes'
;;; proof stops after the value: fbar(a) is the limit of f(x_k) for x_k -> a in A
;;; (a Cauchy sequence, Remark 3.25), independent of the sequence (interleaving).
;;; Neither the uniform continuity of fbar nor the uniqueness is argued.
;;;
;;; THE VALUE WITHOUT A SEQUENCE.  "The limit of f(x_k), whichever sequence" is
;;; IS-LIMIT-ALONG(s, t, A, f, x, y) (structure-library/calc3-vocab.scm): f(a) tends to
;;; y as a tends to x through A.  The extension is
;;;
;;;     fbar = x |-> CHOICE {y in pts(t) : IS-LIMIT-ALONG(s, t, A, f, x, y)}
;;;
;;; and the proof is four lemmas:
;;;   dense-meets-every-ball      a dense A meets every ball B(x, eps)
;;;   limit-along-unique          two limits along a dense A at x agree
;;;   limit-along-exists          (Y complete, f uniformly continuous) a limit exists:
;;;                               x_k in A with d(x, x_k) < 1/(k+1) (countable choice),
;;;                               f(x_k) is Cauchy (Remark 3.25), its limit is one
;;;   limit-along-at-point        at a point of A the limit is f's own value
;;;   limit-along-of-continuous-at  a function continuous at x that agrees with f on A
;;;                               has its value at x as the limit along A
;;; and then: fbar is a function from pts(s) to pts(t) (the CHOICE is in the set,
;;; which is inhabited); fbar extends f (limit-along-at-point + uniqueness); fbar is
;;; uniformly continuous (an eps/4 + eps/2 + eps/4 estimate through points of A near x
;;; and near x'); and any uniformly continuous h extending f equals fbar pointwise
;;; (limit-along-of-continuous-at + uniqueness), hence as a function
;;; (fun-domain-extensionality).
;;;
;;; STATEMENT.  f is uniformly continuous on the SUBSPACE A, as the notes have it;
;;; EXTENDS-ON(A, g, f) is the tree's "g(x) = f(x) for x in A".  The uniqueness is
;;; stated as equality of functions, h = g.
;;;
;;; WINDOW.  Latest citations: rmm-nn-choice (theorem-library/riesz-markov-model),
;;; closure-membership (metric-closure-laws), subspace-dist / subspace-pts
;;; (metric-subspace-laws), rr-le-all-pos-nonpos, rr-min-pos, rr-le-ne-lt,
;;; nn-recip-succ-*, compose-apply / compose-type, choice-axiom,
;;; fun-domain-extensionality (through dk-fun-ext!), uniformly-continuous-is-continuous,
;;; continuous-is-continuous-at.  lo = theorem-library/riesz-markov-model; hi = none.
;;; Library: analysis.
;;;
;;; Helper prefix: c3e-.

(define (c3e-head g) (and (pair? g) (car g)))

(define (c3e-iff-rhs! iff)
  (let ((rhs (caddr iff)))
    (dk-have! rhs (lambda () (dk-only! iff (cadr iff)) (prop)))
    (if (eq? (c3e-head rhs) 'AND) (dk-split-all! (list rhs)))
    rhs))

(define (c3e-ds a b) (list '(DIST s) a b))
(define (c3e-dt a b) (list '(DIST t) a b))
(define (c3e-r n) (list 'RECIP (list '+ n 1)))
(define (c3e-landed-var landed head)
  (let ((f (find-first (lambda (f) (eq? (c3e-head f) head)) landed)))
    (if (not f) (error "c3e-landed-var: no landing headed" head))
    (cadr f)))

;;; =====================================================================
;;; (1) A DENSE SET MEETS EVERY BALL.
;;; =====================================================================
(sp (make-wff '(FORALL s (FORALL A (IMPLIES (IS-DENSE s A)
     (FORALL x (IMPLIES (IN x (PTS s))
       (FORALL eps (IMPLIES (POS-RR eps)
         (FORSOME pa (AND (IN pa A) (< ((DIST s) x pa) eps))))))))))))
(let* ((pl (dk-peel!))
       (x (cadr (find-first (lambda (f) (and (eq? (c3e-head f) 'IN) (equal? (caddr f) '(PTS s)))) pl)))
       (eps (c3e-landed-var pl 'POS-RR))
       (bl (list 'BALL 's x eps)))
  (c3e-iff-rhs! (dk-cite! 'is-dense 's 'A))
  (fact 'subset-mem-fwd '(PTS s) '(CLOSURE s A) x)
  (c3e-iff-rhs! (dk-cite! 'closure-membership 's 'A x))
  (dk-pos-parts! eps)
  (fact 'ball-is-open 's x eps)
  (fact 'ball-center-in 's x eps)
  (dk-have! (list 'AND (list 'IS-OPEN 's bl) (list 'IN x bl))
    (lambda () (dk-conj-close! (lambda () (ass)))))
  (let* ((uc (dk-pick (lambda (h) (and (eq? (c3e-head h) 'FORALL) (dk-contains? h 'IS-OPEN) (dk-contains? h 'FORSOME)))
                      "the closure universal"))
         (y (dk-skolem! (dk-apply! uc bl)))
         (d (c3e-ds x y)))
    (mac-h 'ball-membership (list 'IN y bl))
    (dk-split-all!)
    (fact 'metric-dist-real 's x y)
    (fact 'rr-pos-rr-in-rr eps)
    (dk-have! (list 'AND (list '<= d eps) (list 'NOT (list '= d eps)))
      (lambda () (dk-conj-close! (lambda () (ass)))))
    (fact 'rr-le-ne-lt d eps)
    (ew y)
    (dk-conj-close! (lambda () (ass)))))
(qed 'dense-meets-every-ball)
(topic! 'dense-meets-every-ball 'analysis)
(alias! 'dense-meets-every-ball "a dense set meets every ball of positive radius")

;;; =====================================================================
;;; (2) AT A POINT OF A, f's OWN VALUE IS THE LIMIT ALONG A.
;;; =====================================================================
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s)
     (FORALL t (FORALL A (FORALL f (IMPLIES (SUBSET A (PTS s))
       (IMPLIES (IS-UNIFORMLY-CONTINUOUS (SUBSPACE-MS s A) t f)
         (FORALL x (IMPLIES (IN x A) (IS-LIMIT-ALONG s t A f x (f x)))))))))))))
(define c3e-sub '(SUBSPACE-MS s A))
(let* ((pl (dk-peel!))
       (x (cadr (find-first (lambda (f) (and (eq? (c3e-head f) 'IN) (eq? (caddr f) 'A))) pl))))
  (c3e-iff-rhs! (dk-cite! 'is-uniformly-continuous c3e-sub 't 'f))
  (dk-have! '(IN A SET) (lambda () (dk-sethood! 'A)))
  (fact 'subspace-pts 's 'A)
  (dk-have! '(IN f (FUN A (PTS t)))
    (lambda () (subst (list '== 'A (list 'PTS c3e-sub))) (ass)))
  (fact 'fun-apply-type-c 'f 'A '(PTS t) x)
  (let ((uc (dk-pick (lambda (h) (and (eq? (c3e-head h) 'FORALL) (dk-contains? h 'POS-RR)))
                     "the uniform continuity universal")))
    (mac 'IS-LIMIT-ALONG)
    (dk-conj-close!
     (lambda ()
       (if (eq? (c3e-head (dk-goal)) 'FORALL)
           (let* ((pe (dk-peel!))
                  (eps (c3e-landed-var pe 'POS-RR))
                  (dl (dk-skolem! (dk-apply! uc eps)))
                  (cl (dk-pick (lambda (h) (and (eq? (c3e-head h) 'FORALL) (dk-contains? h dl)))
                               "the delta clause")))
             (ew dl)
             (dk-conj-close!
              (lambda ()
                (if (eq? (c3e-head (dk-goal)) 'FORALL)
                    (let* ((pz (dk-peel!))
                           (z (cadr (find-first (lambda (f) (and (eq? (c3e-head f) 'IN) (eq? (caddr f) 'A))) pz)))
                           (dsub (list (list 'DIST c3e-sub) x z))
                           (fx (list 'f x)) (fz (list 'f z)))
                      (dk-have! (list 'IN x (list 'PTS c3e-sub))
                        (lambda () (subst (list '== (list 'PTS c3e-sub) 'A)) (ass)))
                      (dk-have! (list 'IN z (list 'PTS c3e-sub))
                        (lambda () (subst (list '== (list 'PTS c3e-sub) 'A)) (ass)))
                      (fact 'subspace-dist 's 'A x z)
                      (dk-have! (list '<= dsub dl)
                        (lambda () (subst (list '== dsub (c3e-ds x z))) (ass)))
                      (dk-apply! cl x z)
                      (fact 'fun-apply-type-c 'f 'A '(PTS t) z)
                      (fact 'metric-sym 't fz fx)
                      (subst (list '= (c3e-dt fz fx) (c3e-dt fx fz)))
                      (ass))
                    (ass)))))
           (ass))))))
(qed 'limit-along-at-point)
(topic! 'limit-along-at-point 'analysis)
(alias! 'limit-along-at-point "at a point of A, f's value is its limit along A")

;;; =====================================================================
;;; (3) A FUNCTION CONTINUOUS AT x THAT AGREES WITH f ON A HAS ITS VALUE AT x AS
;;; THE LIMIT OF f ALONG A.
;;; =====================================================================
(sp (make-wff '(FORALL s (FORALL t (FORALL h (FORALL x (IMPLIES (IS-CONTINUOUS-AT s t h x)
     (FORALL A (FORALL f (IMPLIES (SUBSET A (PTS s))
       (IMPLIES (FORALL z (IMPLIES (IN z A) (= (h z) (f z))))
         (IS-LIMIT-ALONG s t A f x (h x)))))))))))))
(dk-peel!)
(c3e-iff-rhs! (dk-cite! 'is-continuous-at 's 't 'h 'x))
(fact 'fun-apply-type-c 'h '(PTS s) '(PTS t) 'x)
(let ((uc (dk-pick (lambda (h) (and (eq? (c3e-head h) 'FORALL) (dk-contains? h 'POS-RR)))
                   "the continuity universal"))
      (agree (dk-pick (lambda (h) (and (eq? (c3e-head h) 'FORALL) (dk-contains? h '=)
                                       (not (dk-contains? h 'POS-RR))))
                      "the agreement on A")))
  (mac 'IS-LIMIT-ALONG)
  (dk-conj-close!
   (lambda ()
     (if (eq? (c3e-head (dk-goal)) 'FORALL)
         (let* ((pe (dk-peel!))
                (eps (c3e-landed-var pe 'POS-RR))
                (dl (dk-skolem! (dk-apply! uc eps)))
                (cl (dk-pick (lambda (h) (and (eq? (c3e-head h) 'FORALL) (dk-contains? h dl)))
                             "the delta clause")))
           (ew dl)
           (dk-conj-close!
            (lambda ()
              (if (eq? (c3e-head (dk-goal)) 'FORALL)
                  (let* ((pz (dk-peel!))
                         (z (cadr (find-first (lambda (f) (and (eq? (c3e-head f) 'IN) (eq? (caddr f) 'A))) pz)))
                         (hx '(h x)) (hz (list 'h z)) (fz (list 'f z)))
                    (fact 'subset-mem-fwd 'A '(PTS s) z)
                    (dk-apply! cl z)
                    (dk-apply! agree z)
                    (fact 'fun-apply-type-c 'h '(PTS s) '(PTS t) z)
                    (fact 'metric-sym 't hz hx)
                    (subst (list '= fz hz))
                    (subst (list '= (c3e-dt hz hx) (c3e-dt hx hz)))
                    (ass))
                  (ass)))))
         (ass)))))
(qed 'limit-along-of-continuous-at)
(topic! 'limit-along-of-continuous-at 'analysis)
(alias! 'limit-along-of-continuous-at
        "a function continuous at x agreeing with f on A has its value at x as the limit along A")

;;; =====================================================================
;;; (4) TWO LIMITS ALONG A DENSE SET AGREE.
;;; =====================================================================
(sp (make-wff '(FORALL s (FORALL t (FORALL A (FORALL f (FORALL x
     (IMPLIES (IS-DENSE s A) (IMPLIES (IN f (FUN A (PTS t))) (IMPLIES (IN x (PTS s))
       (FORALL y1 (FORALL y2 (IMPLIES (IS-LIMIT-ALONG s t A f x y1)
         (IMPLIES (IS-LIMIT-ALONG s t A f x y2) (= y1 y2)))))))))))))))
(dk-peel!)
(c3e-iff-rhs! (dk-cite! 'is-limit-along 's 't 'A 'f 'x 'y1))
(c3e-iff-rhs! (dk-cite! 'is-limit-along 's 't 'A 'f 'x 'y2))
(c3e-iff-rhs! (dk-cite! 'is-dense 's 'A))
(define c3e-d12 (c3e-dt 'y1 'y2))
(fact 'metric-dist-real 't 'y1 'y2)
(fact 'metric-pos 't 'y1 'y2)
(dk-have! (list 'FORALL 'c3ee_ (list 'IMPLIES '(POS-RR c3ee_) (list '<= c3e-d12 'c3ee_)))
  (lambda ()
    (let* ((pe (dk-peel!))
           (eps (c3e-landed-var pe 'POS-RR))
           (q (dk-halve! eps))
           (u1 (dk-pick (lambda (h) (and (eq? (c3e-head h) 'FORALL) (dk-contains? h 'POS-RR)
                                         (dk-contains? h 'y1)))
                        "the limit universal at y1"))
           (u2 (dk-pick (lambda (h) (and (eq? (c3e-head h) 'FORALL) (dk-contains? h 'POS-RR)
                                         (dk-contains? h 'y2) (not (dk-contains? h 'y1))))
                        "the limit universal at y2"))
           (d1 (dk-skolem! (dk-apply! u1 q)))
           (c1 (dk-pick (lambda (h) (and (eq? (c3e-head h) 'FORALL) (dk-contains? h d1))) "clause 1"))
           (d2 (dk-skolem! (dk-apply! u2 q)))
           (c2 (dk-pick (lambda (h) (and (eq? (c3e-head h) 'FORALL) (dk-contains? h d2))) "clause 2")))
      (dk-pos-parts! d1)
      (dk-pos-parts! d2)
      (let* ((w (dk-skolem! (dk-cite! 'rr-min-pos d1 d2)))
             (pw (fact 'rr-pos-rr-of-lt w))
             (pa (dk-skolem! (dk-cite! 'dense-meets-every-ball 's 'A 'x w)))
             (dxa (c3e-ds 'x pa))
             (fa (list 'f pa)))
        (fact 'subset-mem-fwd 'A '(PTS s) pa)
        (fact 'metric-dist-real 's 'x pa)
        (dk-have! (list '<= dxa d1)
          (lambda () (dk-ineq! (list '< dxa w) (list '<= w d1) (list 'IN dxa 'RR) (list 'IN w 'RR)
                               (list 'IN d1 'RR))))
        (dk-have! (list '<= dxa d2)
          (lambda () (dk-ineq! (list '< dxa w) (list '<= w d2) (list 'IN dxa 'RR) (list 'IN w 'RR)
                               (list 'IN d2 'RR))))
        (dk-apply! c1 pa)
        (dk-apply! c2 pa)
        (fact 'fun-apply-type-c 'f 'A '(PTS t) pa)
        (fact 'metric-triangle 't 'y1 fa 'y2)
        (fact 'metric-sym 't 'y1 fa)
        (fact 'metric-dist-real 't 'y1 fa)
        (fact 'metric-dist-real 't fa 'y1)
        (fact 'metric-dist-real 't fa 'y2)
        (fact 'rr-pos-rr-in-rr eps)
        (dk-ineq! (list '<= c3e-d12 (list '+ (c3e-dt 'y1 fa) (c3e-dt fa 'y2)))
                  (list '= (c3e-dt 'y1 fa) (c3e-dt fa 'y1))
                  (list '<= (c3e-dt fa 'y1) q) (list '<= (c3e-dt fa 'y2) q)
                  (list '= (list '+ q q) eps)
                  (list 'IN c3e-d12 'RR) (list 'IN (c3e-dt 'y1 fa) 'RR) (list 'IN (c3e-dt fa 'y1) 'RR)
                  (list 'IN (c3e-dt fa 'y2) 'RR) (list 'IN q 'RR) (list 'IN eps 'RR))))))
(fact 'rr-le-all-pos-nonpos c3e-d12)
(fact 'rr-zero-in)
(dk-have! (list 'AND (list 'IN c3e-d12 'RR) '(IN 0 RR))
  (lambda () (dk-conj-close! (lambda () (ass)))))
(dk-have! (list 'AND (list '<= c3e-d12 0) (list '<= 0 c3e-d12))
  (lambda () (dk-conj-close! (lambda () (ass)))))
(fact 'rr-leq-antisymmetric c3e-d12 0)
(fact 'metric-zero-eq 't 'y1 'y2)
(ass)
(qed 'limit-along-unique)
(topic! 'limit-along-unique 'analysis)
(alias! 'limit-along-unique "two limits of f along a dense set at the same point agree")

;;; =====================================================================
;;; (5) THE LIMIT ALONG A EXISTS (Y complete, f uniformly continuous on A).
;;; =====================================================================
;;; Countable choice through rmm-nn-choice, as in calc3-compact-closed.scm.
(define c3e-seq-family '())
(define (c3e-choose-seq! A Pf witness-of)
  (let* ((L   (list 'VNB-LAMBDA 'c3ek_ 'NN (list 'SEP 'c3ew_ A (Pf 'c3ek_ 'c3ew_))))
         (inh (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
                (list 'FORSOME 'w (list 'AND (list 'IN 'w A) (list 'IN 'w (list L 'k))))))))
    (dk-have! inh
      (lambda ()
        (let* ((k (dk-di-var!)))
          (dk-lam-b!)
          (let ((w (witness-of k)))
            (ew w)
            (dk-conj-close!
              (lambda ()
                (if (dk-head-is? (caddr (dk-goal)) 'SEP)
                    (dk-close-all! (lambda () (sep-mi)))
                    (ass))))))))
    (let ((g (dk-skolem! (dk-cite! 'rmm-nn-choice A L))))
      (set! c3e-seq-family (cons (cons g L) c3e-seq-family))
      g)))
(define (c3e-seq-at! g k)
  (let* ((L  (cdr (assq g c3e-seq-family)))
         (cl (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IN (list g 'k) (list L 'k))))))
         (h  (dk-apply! (or cl (error "c3e-seq-at!: the choice clause is not in context" g)) k)))
    (dk-lam-b-h! h)
    (let ((m (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list g k))
                                       (dk-head-is? (caddr f) 'SEP)))
                      "the chosen membership")))
      (dk-split-all! (dk-landed (lambda () (sep-me m)))))))

(sp (make-wff '(FORALL s (FORALL t (FORALL A (FORALL f
     (IMPLIES (IS-COMPLETE t) (IMPLIES (IS-DENSE s A)
       (IMPLIES (IS-UNIFORMLY-CONTINUOUS (SUBSPACE-MS s A) t f)
         (FORALL x (IMPLIES (IN x (PTS s))
           (FORSOME y (IS-LIMIT-ALONG s t A f x y)))))))))))))
(define c3e-x
  (let ((pl (dk-peel!)))
    (cadr (find-first (lambda (f) (and (eq? (c3e-head f) 'IN) (equal? (caddr f) '(PTS s)))) pl))))
(c3e-iff-rhs! (dk-cite! 'is-dense 's 'A))
(c3e-iff-rhs! (dk-cite! 'is-complete 't))
(c3e-iff-rhs! (dk-cite! 'is-uniformly-continuous c3e-sub 't 'f))
(dk-have! '(IN A SET) (lambda () (dk-sethood! 'A)))
(fact 'subspace-pts 's 'A)
(dk-have! '(IN f (FUN A (PTS t)))
  (lambda () (subst (list '== 'A (list 'PTS c3e-sub))) (ass)))
(define c3e-uc (dk-pick (lambda (h) (and (eq? (c3e-head h) 'FORALL) (dk-contains? h 'POS-RR)
                                         (dk-contains? h c3e-sub)))
                        "the uniform continuity universal"))
(define c3e-cplt (dk-pick (lambda (h) (and (eq? (c3e-head h) 'FORALL) (dk-contains? h 'IS-CAUCHY-SEQ)))
                          "the completeness universal"))
(define c3e-u
  (c3e-choose-seq! 'A
    (lambda (k w) (list '< (c3e-ds c3e-x w) (c3e-r k)))
    (lambda (k)
      (fact 'nn-recip-succ-pos k)
      (dk-skolem! (dk-cite! 'dense-meets-every-ball 's 'A c3e-x (c3e-r k))))))
(define c3e-F (list 'COMPOSE 'f c3e-u))
(fact 'nn-is-set)
(dk-have! (list 'AND (list 'IN c3e-u '(FUN NN A)) '(IN f (FUN A (PTS t))))
  (lambda () (dk-conj-close! (lambda () (ass)))))
(fact 'compose-type 'NN 'A '(PTS t) 'f c3e-u)
(fact 'compose-apply 'NN 'A '(PTS t) 'f c3e-u)
(define c3e-cap (dk-pick (lambda (h) (and (eq? (c3e-head h) 'FORALL) (dk-contains? h 'COMPOSE)
                                          (dk-contains? h '=)))
                         "the composition value universal"))
;;; at an index k: u(k) in A, in PTS(s) and in PTS(sub), d(x, u k) < r_k, F(k) = f(u k), f(u k) in PTS(t)
(define (c3e-at! k)
  (let ((uk (list c3e-u k)))
    (c3e-seq-at! c3e-u k)
    (fact 'subset-mem-fwd 'A '(PTS s) uk)
    (dk-have! (list 'IN uk (list 'PTS c3e-sub))
      (lambda () (subst (list '== (list 'PTS c3e-sub) 'A)) (ass)))
    (dk-apply! c3e-cap k)
    (fact 'fun-apply-type-c 'f 'A '(PTS t) uk)
    (fact 'nn-recip-succ-pos k)
    (fact 'rr-pos-rr-in-rr (c3e-r k))
    (fact 'metric-dist-real 's c3e-x uk)
    uk))
;;; F is Cauchy
(dk-have! (list 'IS-CAUCHY-SEQ 't c3e-F)
  (lambda ()
    (mac 'IS-CAUCHY-SEQ)
    (dk-conj-close!
     (lambda ()
       (if (eq? (c3e-head (dk-goal)) 'FORALL)
           (let* ((pe (dk-peel!))
                  (eps (c3e-landed-var pe 'POS-RR))
                  (dl (dk-skolem! (dk-apply! c3e-uc eps)))
                  (cl (dk-pick (lambda (h) (and (eq? (c3e-head h) 'FORALL) (dk-contains? h dl)))
                               "the delta clause"))
                  (hd (dk-halve! dl))
                  (n (dk-skolem! (dk-cite! 'nn-recip-succ-small hd))))
             (ew n)
             (dk-conj-close!
              (lambda ()
                (if (eq? (c3e-head (dk-goal)) 'FORALL)
                    (let* ((pm (dk-peel!))
                           (spl (dk-split-all!))
                           (g (dk-goal))
                           (m (cadr (cadr (cadr g))))
                           (m2 (cadr (caddr (cadr g))))
                           (um (c3e-at! m))
                           (um2 (c3e-at! m2))
                           (dsub (list (list 'DIST c3e-sub) um um2))
                           (dmm (c3e-ds um um2)))
                      (subst (list '= (list c3e-F m) (list 'f um)))
                      (subst (list '= (list c3e-F m2) (list 'f um2)))
                      (fact 'nn-recip-succ-antitone n m)
                      (fact 'nn-recip-succ-antitone n m2)
                      (fact 'metric-triangle 's um c3e-x um2)
                      (fact 'metric-sym 's um c3e-x)
                      (fact 'metric-dist-real 's um c3e-x)
                      (fact 'metric-dist-real 's um um2)
                      (fact 'nn-recip-succ-pos n)
                      (fact 'rr-pos-rr-in-rr (c3e-r n))
                      (fact 'rr-pos-rr-in-rr dl)
                      (fact 'subspace-dist 's 'A um um2)
                      (dk-have! (list '<= dsub dl)
                        (lambda ()
                          (subst (list '== dsub dmm))
                          (dk-ineq! (list '<= dmm (list '+ (c3e-ds um c3e-x) (c3e-ds c3e-x um2)))
                                    (list '= (c3e-ds um c3e-x) (c3e-ds c3e-x um))
                                    (list '< (c3e-ds c3e-x um) (c3e-r m))
                                    (list '< (c3e-ds c3e-x um2) (c3e-r m2))
                                    (list '<= (c3e-r m) (c3e-r n)) (list '<= (c3e-r m2) (c3e-r n))
                                    (list '< (c3e-r n) hd) (list '= (list '+ hd hd) dl)
                                    (list 'IN dmm 'RR) (list 'IN (c3e-ds um c3e-x) 'RR)
                                    (list 'IN (c3e-ds c3e-x um) 'RR) (list 'IN (c3e-ds c3e-x um2) 'RR)
                                    (list 'IN (c3e-r m) 'RR) (list 'IN (c3e-r m2) 'RR)
                                    (list 'IN (c3e-r n) 'RR) (list 'IN hd 'RR) (list 'IN dl 'RR))))
                      (dk-apply! cl um um2)
                      (ass))
                    (ass)))))
           (ass))))))
(dk-apply! c3e-cplt c3e-F)
(c3e-iff-rhs! (dk-cite! 'converges 't c3e-F))
(define c3e-y (dk-skolem! (dk-pick (lambda (h) (and (eq? (c3e-head h) 'FORSOME) (dk-contains? h 'CONVERGES-TO)))
                                   "the limit")))
(c3e-iff-rhs! (dk-cite! 'converges-to 't c3e-F c3e-y))
(define c3e-cu (dk-pick (lambda (h) (and (eq? (c3e-head h) 'FORALL) (dk-contains? h 'POS-RR)
                                         (dk-contains? h c3e-y)))
                        "the convergence universal"))
(ew c3e-y)
(mac 'IS-LIMIT-ALONG)
(dk-conj-close!
 (lambda ()
   (if (eq? (c3e-head (dk-goal)) 'FORALL)
       (let* ((pe (dk-peel!))
              (eps (c3e-landed-var pe 'POS-RR))
              (h (dk-halve! eps))
              (dl (dk-skolem! (dk-apply! c3e-uc h)))
              (cl (dk-pick (lambda (f) (and (eq? (c3e-head f) 'FORALL) (dk-contains? f dl)))
                           "the delta clause"))
              (hd (dk-halve! dl)))
         (ew hd)
         (dk-conj-close!
          (lambda ()
            (if (eq? (c3e-head (dk-goal)) 'FORALL)
                (let* ((pz (dk-peel!))
                       (z (cadr (find-first (lambda (f) (and (eq? (c3e-head f) 'IN) (eq? (caddr f) 'A))) pz)))
                       (n1 (dk-skolem! (dk-apply! c3e-cu h)))
                       (tc (dk-pick (lambda (f) (and (eq? (c3e-head f) 'FORALL) (dk-contains? f n1)))
                                    "the tail clause"))
                       (n2 (dk-skolem! (dk-cite! 'nn-recip-succ-small hd)))
                       (k (list '+ n1 n2)))
                  (dk-have! (list 'AND (list 'IN n1 'NN) (list 'IN n2 'NN))
                    (lambda () (dk-conj-close! (lambda () (ass)))))
                  (fact 'nn-add-closed n1 n2)
                  (fact 'nn-le-add-right n2 n1)
                  (fact 'nn-le-add-left n1 n2)
                  (dk-apply! tc k)
                  (let* ((uk (c3e-at! k))
                         (fz (list 'f z)) (fuk (list 'f uk))
                         (dsub (list (list 'DIST c3e-sub) z uk))
                         (dzk (c3e-ds z uk)))
                    (dk-rewrite-h! (list '<= (c3e-dt (list c3e-F k) c3e-y) h) (list c3e-F k) fuk)
                    (fact 'nn-recip-succ-antitone n2 k)
                    (fact 'nn-recip-succ-pos n2)
                    (fact 'rr-pos-rr-in-rr (c3e-r n2))
                    (fact 'subset-mem-fwd 'A '(PTS s) z)
                    (dk-have! (list 'IN z (list 'PTS c3e-sub))
                      (lambda () (subst (list '== (list 'PTS c3e-sub) 'A)) (ass)))
                    (fact 'metric-triangle 's z c3e-x uk)
                    (fact 'metric-sym 's z c3e-x)
                    (fact 'metric-dist-real 's z c3e-x)
                    (fact 'metric-dist-real 's c3e-x z)
                    (fact 'metric-dist-real 's z uk)
                    (fact 'rr-pos-rr-in-rr dl)
                    (fact 'rr-pos-rr-in-rr h)
                    (fact 'rr-pos-rr-in-rr eps)
                    (fact 'subspace-dist 's 'A z uk)
                    (dk-have! (list '<= dsub dl)
                      (lambda ()
                        (subst (list '== dsub dzk))
                        (dk-ineq! (list '<= dzk (list '+ (c3e-ds z c3e-x) (c3e-ds c3e-x uk)))
                                  (list '= (c3e-ds z c3e-x) (c3e-ds c3e-x z))
                                  (list '<= (c3e-ds c3e-x z) hd)
                                  (list '< (c3e-ds c3e-x uk) (c3e-r k))
                                  (list '<= (c3e-r k) (c3e-r n2)) (list '< (c3e-r n2) hd)
                                  (list '= (list '+ hd hd) dl)
                                  (list 'IN dzk 'RR) (list 'IN (c3e-ds z c3e-x) 'RR)
                                  (list 'IN (c3e-ds c3e-x z) 'RR) (list 'IN (c3e-ds c3e-x uk) 'RR)
                                  (list 'IN (c3e-r k) 'RR) (list 'IN (c3e-r n2) 'RR)
                                  (list 'IN hd 'RR) (list 'IN dl 'RR))))
                    (dk-apply! cl z uk)
                    (fact 'fun-apply-type-c 'f 'A '(PTS t) z)
                    (fact 'metric-triangle 't fz fuk c3e-y)
                    (fact 'metric-dist-real 't fz fuk)
                    (fact 'metric-dist-real 't fuk c3e-y)
                    (fact 'metric-dist-real 't fz c3e-y)
                    (dk-ineq! (list '<= (c3e-dt fz c3e-y) (list '+ (c3e-dt fz fuk) (c3e-dt fuk c3e-y)))
                              (list '<= (c3e-dt fz fuk) h) (list '<= (c3e-dt fuk c3e-y) h)
                              (list '= (list '+ h h) eps)
                              (list 'IN (c3e-dt fz c3e-y) 'RR) (list 'IN (c3e-dt fz fuk) 'RR)
                              (list 'IN (c3e-dt fuk c3e-y) 'RR) (list 'IN h 'RR) (list 'IN eps 'RR))))
                (ass)))))
       (ass))))
(qed 'limit-along-exists)
(topic! 'limit-along-exists 'analysis)
(alias! 'limit-along-exists
        "a uniformly continuous function on a dense set, with complete target, has a limit along it at every point")

;;; =====================================================================
;;; (6) PROP 3.26.
;;; =====================================================================
(sp (make-wff '(FORALL s (FORALL t (FORALL A (FORALL f
     (IMPLIES (IS-COMPLETE t) (IMPLIES (IS-DENSE s A)
       (IMPLIES (IS-UNIFORMLY-CONTINUOUS (SUBSPACE-MS s A) t f)
         (FORSOME g (AND (IS-UNIFORMLY-CONTINUOUS s t g)
           (AND (EXTENDS-ON A g f)
                (FORALL h (IMPLIES (IS-UNIFORMLY-CONTINUOUS s t h)
                  (IMPLIES (EXTENDS-ON A h f) (= h g))))))))))))))))
(dk-peel!)
(c3e-iff-rhs! (dk-cite! 'is-dense 's 'A))
(c3e-iff-rhs! (dk-cite! 'is-complete 't))
(c3e-iff-rhs! (dk-cite! 'is-uniformly-continuous c3e-sub 't 'f))
(dk-have! '(IN A SET) (lambda () (dk-sethood! 'A)))
(fact 'subspace-pts 's 'A)
(dk-have! '(IN f (FUN A (PTS t)))
  (lambda () (subst (list '== 'A (list 'PTS c3e-sub))) (ass)))
(define c3e-uc2 (dk-pick (lambda (h) (and (eq? (c3e-head h) 'FORALL) (dk-contains? h 'POS-RR)
                                          (dk-contains? h c3e-sub)))
                         "the uniform continuity universal"))
(define (c3e-yset x) (list 'SEP 'c3ey_ '(PTS t) (list 'IS-LIMIT-ALONG 's 't 'A 'f x 'c3ey_)))
;;; the value at x (IN x (PTS s) in context): lands (IN c (PTS t)) and
;;; IS-LIMIT-ALONG(s, t, A, f, x, c) for c = CHOICE(Y(x)); returns c
(define (c3e-val! x)
  (let* ((y0 (dk-skolem! (dk-cite! 'limit-along-exists 's 't 'A 'f x)))
         (yy (c3e-yset x))
         (c (list 'CHOICE yy)))
    (c3e-iff-rhs! (dk-cite! 'is-limit-along 's 't 'A 'f x y0))
    (dk-have! (list 'FORSOME 'c3ew_ (list 'IN 'c3ew_ yy))
      (lambda ()
        (ew y0)
        (for-each (lambda (leaf)
                    (if (not (sequent-node-grounded? leaf)) (begin (dk-focus! leaf) (ass))))
                  (dk-opened (lambda () (sep-mi))))))
    (fact 'choice-axiom yy)
    (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN c yy)))))
    c))
(fact 'ms-pts-is-set 's)
(fact 'ms-pts-is-set 't)
(define c3e-GV
  (dk-abstract! '(PTS s) '(PTS t)
    (lambda (k) (list 'CHOICE (c3e-yset k)))
    (lambda (k) (c3e-val! k) (ass))))
(define c3e-G (car c3e-GV))
(define c3e-ve (cdr c3e-GV))
;;; G(x) == c at a point x of PTS(s), with c's facts landed; returns c
(define (c3e-gx! x)
  (let ((c (c3e-val! x)))
    (dk-apply! c3e-ve x)
    c))
(ew c3e-G)
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
      ;; ---- G is uniformly continuous
      ((eq? (c3e-head g) 'IS-UNIFORMLY-CONTINUOUS)
       (mac 'IS-UNIFORMLY-CONTINUOUS)
       (dk-conj-close!
        (lambda ()
          (if (eq? (c3e-head (dk-goal)) 'FORALL)
              (let* ((pe (dk-peel!))
                     (eps (c3e-landed-var pe 'POS-RR))
                     (h (dk-halve! eps))
                     (q (dk-halve! h))
                     (dl (dk-skolem! (dk-apply! c3e-uc2 h)))
                     (cl (dk-pick (lambda (f) (and (eq? (c3e-head f) 'FORALL) (dk-contains? f dl)))
                                  "the delta clause"))
                     (hd (dk-halve! dl))
                     (qd (dk-halve! hd)))
                (ew hd)
                (dk-conj-close!
                 (lambda ()
                   (if (eq? (c3e-head (dk-goal)) 'FORALL)
                       (let* ((pl (dk-peel!))
                              (le (find-first (lambda (f) (eq? (c3e-head f) '<=)) pl))
                              (x1 (cadr (cadr le)))
                              (x2 (caddr (cadr le)))
                              (c1 (c3e-gx! x1))
                              (c2 (c3e-gx! x2)))
                         (subst (list '== (list c3e-G x1) c1))
                         (subst (list '== (list c3e-G x2) c2))
                         (let* ((pick-near
                                 (lambda (x c)
                                   (c3e-iff-rhs! (dk-cite! 'is-limit-along 's 't 'A 'f x c))
                                   (let* ((u (dk-pick (lambda (f) (and (eq? (c3e-head f) 'FORALL)
                                                                       (dk-contains? f 'POS-RR)
                                                                       (dk-contains? f c)))
                                                      "the limit universal"))
                                          (d (dk-skolem! (dk-apply! u q)))
                                          (cc (dk-pick (lambda (f) (and (eq? (c3e-head f) 'FORALL)
                                                                        (dk-contains? f d)))
                                                       "the limit clause")))
                                     (dk-pos-parts! d)
                                     (dk-pos-parts! qd)
                                     (let* ((w (dk-skolem! (dk-cite! 'rr-min-pos d qd)))
                                            (pw (fact 'rr-pos-rr-of-lt w))
                                            (pa (dk-skolem! (dk-cite! 'dense-meets-every-ball 's 'A x w)))
                                            (dxa (c3e-ds x pa)))
                                       (fact 'subset-mem-fwd 'A '(PTS s) pa)
                                       (fact 'metric-dist-real 's x pa)
                                       (fact 'fun-apply-type-c 'f 'A '(PTS t) pa)
                                       (dk-have! (list '<= dxa d)
                                         (lambda () (dk-ineq! (list '< dxa w) (list '<= w d)
                                                              (list 'IN dxa 'RR) (list 'IN w 'RR)
                                                              (list 'IN d 'RR))))
                                       (dk-have! (list '< dxa qd)
                                         (lambda () (dk-ineq! (list '< dxa w) (list '<= w qd)
                                                              (list 'IN dxa 'RR) (list 'IN w 'RR)
                                                              (list 'IN qd 'RR))))
                                       (dk-apply! cc pa)
                                       pa))))
                                (p1 (pick-near x1 c1))
                                (p2 (pick-near x2 c2))
                                (f1 (list 'f p1)) (f2 (list 'f p2))
                                (dsub (list (list 'DIST c3e-sub) p1 p2))
                                (d12 (c3e-ds p1 p2)))
                           (fact 'metric-triangle 's p1 x2 p2)
                           (fact 'metric-triangle 's p1 x1 x2)
                           (fact 'metric-sym 's p1 x1)
                           (fact 'metric-sym 's x2 p2)
                           (for-each (lambda (pr) (fact 'metric-dist-real 's (car pr) (cdr pr)))
                                     (list (cons p1 p2) (cons p1 x2) (cons x2 p2) (cons p1 x1)
                                           (cons x1 p1) (cons x1 x2) (cons p2 x2)))
                           (fact 'rr-pos-rr-in-rr dl)
                           (fact 'rr-pos-rr-in-rr hd)
                           (fact 'rr-pos-rr-in-rr h)
                           (fact 'rr-pos-rr-in-rr eps)
                           (dk-have! (list 'IN p1 (list 'PTS c3e-sub))
                             (lambda () (subst (list '== (list 'PTS c3e-sub) 'A)) (ass)))
                           (dk-have! (list 'IN p2 (list 'PTS c3e-sub))
                             (lambda () (subst (list '== (list 'PTS c3e-sub) 'A)) (ass)))
                           (fact 'subspace-dist 's 'A p1 p2)
                           (dk-have! (list '<= dsub dl)
                             (lambda ()
                               (subst (list '== dsub d12))
                               (dk-ineq! (list '<= d12 (list '+ (c3e-ds p1 x2) (c3e-ds x2 p2)))
                                         (list '<= (c3e-ds p1 x2) (list '+ (c3e-ds p1 x1) (c3e-ds x1 x2)))
                                         (list '= (c3e-ds p1 x1) (c3e-ds x1 p1))
                                         (list '= (c3e-ds x2 p2) (c3e-ds p2 x2))
                                         (list '< (c3e-ds x1 p1) qd) (list '< (c3e-ds x2 p2) qd)
                                         (list '<= (c3e-ds x1 x2) hd)
                                         (list '= (list '+ qd qd) hd) (list '= (list '+ hd hd) dl)
                                         (list 'IN d12 'RR) (list 'IN (c3e-ds p1 x2) 'RR)
                                         (list 'IN (c3e-ds x2 p2) 'RR) (list 'IN (c3e-ds p1 x1) 'RR)
                                         (list 'IN (c3e-ds x1 p1) 'RR) (list 'IN (c3e-ds x1 x2) 'RR)
                                         (list 'IN (c3e-ds p2 x2) 'RR)
                                         (list 'IN qd 'RR) (list 'IN hd 'RR) (list 'IN dl 'RR))))
                           (dk-apply! cl p1 p2)
                           (fact 'metric-triangle 't c1 f1 c2)
                           (fact 'metric-triangle 't f1 f2 c2)
                           (fact 'metric-sym 't c1 f1)
                           (for-each (lambda (pr) (fact 'metric-dist-real 't (car pr) (cdr pr)))
                                     (list (cons c1 c2) (cons c1 f1) (cons f1 c1) (cons f1 c2)
                                           (cons f1 f2) (cons f2 c2)))
                           (fact 'rr-pos-rr-in-rr q)
                           (dk-ineq! (list '<= (c3e-dt c1 c2) (list '+ (c3e-dt c1 f1) (c3e-dt f1 c2)))
                                     (list '<= (c3e-dt f1 c2) (list '+ (c3e-dt f1 f2) (c3e-dt f2 c2)))
                                     (list '= (c3e-dt c1 f1) (c3e-dt f1 c1))
                                     (list '<= (c3e-dt f1 c1) q) (list '<= (c3e-dt f2 c2) q)
                                     (list '<= (c3e-dt f1 f2) h)
                                     (list '= (list '+ q q) h) (list '= (list '+ h h) eps)
                                     (list 'IN (c3e-dt c1 c2) 'RR) (list 'IN (c3e-dt c1 f1) 'RR)
                                     (list 'IN (c3e-dt f1 c1) 'RR) (list 'IN (c3e-dt f1 c2) 'RR)
                                     (list 'IN (c3e-dt f1 f2) 'RR) (list 'IN (c3e-dt f2 c2) 'RR)
                                     (list 'IN q 'RR) (list 'IN h 'RR) (list 'IN eps 'RR))))
                       (ass)))))
              (ass)))))
      ;; ---- G extends f
      ((eq? (c3e-head g) 'EXTENDS-ON)
       (mac 'EXTENDS-ON)
       (let* ((x (dk-di-var!))
              (pt (fact 'subset-mem-fwd 'A '(PTS s) x))
              (c (c3e-gx! x)))
         (subst (list '== (list c3e-G x) c))
         (fact 'limit-along-at-point 's 't 'A 'f x)
         (fact 'limit-along-unique 's 't 'A 'f x c (list 'f x))
         (ass)))
      ;; ---- uniqueness
      (#t
       (let* ((pl (dk-peel!))
              (hh (caddr (find-first (lambda (f) (eq? (c3e-head f) 'EXTENDS-ON)) pl))))
         (fact 'uniformly-continuous-is-continuous 's 't hh)
         (c3e-iff-rhs! (dk-cite! 'is-continuous 's 't hh))
         (c3e-iff-rhs! (dk-cite! 'extends-on 'A hh 'f))
         (let ((ucont (dk-pick (lambda (f) (and (eq? (c3e-head f) 'FORALL)
                                                (dk-contains? f 'IS-CONTINUOUS-AT)))
                               "the pointwise continuity of h")))
           (dk-fun-ext! hh c3e-G '(PTS s) '(PTS t) #f #f
             (lambda (v)
               (let ((c (c3e-gx! v)))
                 (subst (list '== (list c3e-G v) c))
                 (dk-apply! ucont v)
                 (fact 'limit-along-of-continuous-at 's 't hh v 'A 'f)
                 (fact 'fun-apply-type-c hh '(PTS s) '(PTS t) v)
                 (fact 'limit-along-unique 's 't 'A 'f v (list hh v) c)
                 (ass)))))))))))
