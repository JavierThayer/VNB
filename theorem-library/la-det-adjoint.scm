;;; =====================================================================
;;; (3) Prop 3.25: adj(A) A = det(A) I = A adj(A), over a commutative ring.
;;; The (i, k) entry of A adj(A) is sum_j a_ij (-1)^(j+k) det A[k, j]: the expansion
;;; along row k of A with its row k replaced by row i -- det A when i = k, and 0
;;; otherwise because that matrix has two equal rows (det-alternating-rows).  The
;;; (i, k) entry of adj(A) A is the expansion along column i of A with column i
;;; replaced by column k (det-equal-cols-zero).  The notes: "an immediate
;;; consequence of the expansion by minors formula".
;;; =====================================================================
(define ladet-I1 '(INTERVAL 1 (succ n)))

;; the re-index of a minor never hits the deleted index
(sp (make-wff
  (forall-guarded '(lsw_ lsc_) '((IN lsw_ NN) (IN lsc_ NN))
    '(NOT (= (IF (< lsw_ lsc_) lsw_ (succ lsw_)) lsc_)))))
(dk-peel!)
(dk-case-if! '(IF (< lsw_ lsc_) lsw_ (succ lsw_))
  (lambda (b v)
    (if b
        (dk-nn! '(< lsw_ lsc_))
        (begin (fact 'nn-not-lt-le 'lsw_ 'lsc_) (dk-nn! '(<= lsc_ lsw_))))))
(ladet-done! 'ladet-skip-ne)
(topic! 'ladet-skip-ne 'plumbing)

;; two (n+1)-square matrices that agree off row p have the same minors at (p, q);
;; two that agree off column q have the same minors at (p, q)
(define (ladet-rowagree X Y p N)
  (list 'FORALL 'dri_ (list 'IMPLIES (list 'IN 'dri_ (ladet-iv N))
    (list 'IMPLIES (list 'NOT (list '= 'dri_ p))
      (list 'FORALL 'drk_ (list 'IMPLIES (list 'IN 'drk_ (ladet-iv N))
        (list '= (list 'ENTRY X 'dri_ 'drk_) (list 'ENTRY Y 'dri_ 'drk_))))))))
(define (ladet-colagree X Y q N)
  (list 'FORALL 'dcj_ (list 'IMPLIES (list 'IN 'dcj_ (ladet-iv N))
    (list 'IMPLIES (list 'NOT (list '= 'dcj_ q))
      (list 'FORALL 'dci_ (list 'IMPLIES (list 'IN 'dci_ (ladet-iv N))
        (list '= (list 'ENTRY X 'dci_ 'dcj_) (list 'ENTRY Y 'dci_ 'dcj_))))))))
(define (ladet-skip w v) (list 'IF (list '< w v) w (list 'succ w)))

(define (ladet-minor-congr! row?)
  (sp (make-wff
    (forall-guarded '(R n X Y p q)
      (list '(IS-RING R) '(IN n NN) '(IN X (MAT (succ n) (succ n) (CARR R)))
            '(IN Y (MAT (succ n) (succ n) (CARR R))) '(IN p NN) '(IN q NN)
            (if row? (ladet-rowagree 'X 'Y 'p '(succ n)) (ladet-colagree 'X 'Y 'q '(succ n))))
      '(= (MINOR X p q n) (MINOR Y p q n)))))
  (let* ((hyps (dk-peel!))
         (agree (find-first (dk-head? 'FORALL) hyps))
         (M1 '(MINOR X p q n)) (M2 '(MINOR Y p q n)))
    (fact 'minor-type 'R 'X 'p 'q 'n)
    (fact 'minor-type 'R 'Y 'p 'q 'n)
    (detach-with! (dk-fact! 'matrix-entry-extensionality 'n 'n '(CARR R) M1 M2)
      (lambda ()
        (dk-peel!)
        (let* ((g (dk-goal)) (u (caddr (cadr g))) (w (cadddr (cadr g)))
               (ru (ladet-skip u 'p)) (cw (ladet-skip w 'q)))
          (ladet-iv! u 1 'n)
          (ladet-iv! w 1 'n)
          (subst (dk-fact! 'minor-entry 'R 'X 'p 'q 'n u w))
          (subst (dk-fact! 'minor-entry 'R 'Y 'p 'q 'n u w))
          (fact 'dtr-skip-in 'n 'p u)
          (fact 'dtr-skip-in 'n 'q w)
          (if row?
              (begin (fact 'ladet-skip-ne u 'p) (dk-apply! agree ru cw))
              (begin (fact 'ladet-skip-ne w 'q) (dk-apply! agree cw ru)))
          (ass))))
    (ass)))
(ladet-minor-congr! #t)
(ladet-done! 'ladet-minor-rowcongr)
(topic! 'ladet-minor-rowcongr 'algebra)
(ladet-minor-congr! #f)
(ladet-done! 'ladet-minor-colcongr)
(topic! 'ladet-minor-colcongr 'algebra)

;; two ring rearrangements, by crs
(define (ladet-carr-guards vs) (map (lambda (v) (list 'IN v '(CARR R))) vs))
(sp (make-wff
  (list 'FORALL 'R (list 'IMPLIES '(IS-COMMUTATIVE-RING R)
    (forall-guarded '(lrs_ lrx_ lrd_) (ladet-carr-guards '(lrs_ lrx_ lrd_))
      '(= ((MUL R) lrs_ ((MUL R) lrx_ lrd_)) ((MUL R) lrx_ ((MUL R) lrs_ lrd_))))))))
(dk-peel!)
(crs)
(ladet-done! 'ladet-ring-r1)
(topic! 'ladet-ring-r1 'plumbing)
(sp (make-wff
  (list 'FORALL 'R (list 'IMPLIES '(IS-COMMUTATIVE-RING R)
    (forall-guarded '(lrs_ lrx_ lrd_) (ladet-carr-guards '(lrs_ lrx_ lrd_))
      '(= ((MUL R) lrs_ ((MUL R) lrx_ lrd_)) ((MUL R) ((MUL R) lrs_ lrd_) lrx_)))))))
(dk-peel!)
(crs)
(ladet-done! 'ladet-ring-c1)
(topic! 'ladet-ring-c1 'plumbing)

;; ---- the auxiliary matrices: A with row k := row i, A with column i := column k
(define (ladet-mk body)
  (list 'MATOF '(succ n) '(succ n)
    (list 'VNB-LAMBDA '(LIST lbv_ lbw_) (list 'CARTESIAN ladet-I1 ladet-I1) body)))
(define (ladet-mk-row i k) (ladet-mk (list 'IF (list '= 'lbv_ k) (list 'ENTRY 'A i 'lbw_) '(ENTRY A lbv_ lbw_))))
(define (ladet-mk-col i k) (ladet-mk (list 'IF (list '= 'lbw_ i) (list 'ENTRY 'A 'lbv_ k) '(ENTRY A lbv_ lbw_))))
(define (ladet-tsubst e alist)
  (cond ((assq e alist) => cdr)
        ((pair? e) (map (lambda (x) (ladet-tsubst x alist)) e))
        (#t e)))

;; goal (IN T C) with T an IF tower over typable leaves
(define (ladet-if-type!)
  (let* ((g (dk-goal)) (t (cadr g)))
    (if (and (pair? t) (eq? (car t) 'IF))
        (dk-case-if! t (lambda (b v) (ladet-if-type!)))
        (ladet-close-carr!))))

(define (ladet-mk-type! M)
  (dk-have! (list 'IN M '(MAT (succ n) (succ n) (CARR R))) (lambda ()
      (detach-with! (dk-fact! 'matof-in-mat '(succ n) '(succ n) '(CARR R) (cadddr M))
        (lambda () (dk-peel!) (ladet-beta!) (ladet-if-type!)))
      (ass))))

;; land (= (ENTRY M a b) body[a, b]) and return it
(define (ladet-mk-entry! M a b)
  (let* ((G (cadddr M))
         (vs   (cdr (cadr G)))                    ; the binders of the tabulating lambda
         (body (ladet-tsubst (cadddr G) (list (cons (car vs) a) (cons (cadr vs) b))))
         (tgt (list '= (list 'ENTRY M a b) body)))
    (if (not (dk-asm? tgt))
        (let ((r (dk-fact! 'entry-of-matof '(succ n) '(succ n) G a b)))
          (if (and (pair? r) (eq? (car r) 'IMPLIES) (not (dk-asm? (cadr r))))
              (set! r (detach-with! r (lambda () (dk-peel!) (ladet-beta!) (ladet-if-type!)))))
          (let loop ()
            (if (and (pair? r) (eq? (car r) 'IMPLIES) (dk-asm? (cadr r)))
                (begin (set! r (dk-landed-1 (lambda () (detach! r)))) (loop))))
          (if (and (not (dk-asm? tgt)) (dk--redex? r)) (lam-b-h r))
          (if (not (dk-asm? tgt))
              (error "ladet-mk-entry!: read-off did not land" (expression->string tgt) (expression->string r)))))
    tgt))

;; rewrite every ENTRY of a constructed matrix in the goal, then resolve the IFs
(define (ladet-find-mk-entry e)
  (cond ((not (pair? e)) #f)
        ((and (eq? (car e) 'ENTRY) (pair? (cadr e)) (eq? (car (cadr e)) 'MATOF)) e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((ladet-find-mk-entry (car l)))
                    (#t (loop (cdr l))))))))
(define (ladet-mk-rewrite!)
  (let loop ()
    (let ((e (ladet-find-mk-entry (dk-goal))))
      (if e (begin (subst (ladet-mk-entry! (cadr e) (caddr e) (cadddr e))) (loop)))))
  (ladet-if-auto!))

;; the sums of the two products, after the adjoint's entries are read off
(define (ladet-rowsum i k)
  (list 'FINSUM ladet-ag
    (list 'VNB-LAMBDA 'dgj_ ladet-I1
      (list '(MUL R) (list 'ENTRY 'A i 'dgj_)
            (list '(MUL R) (ladet-sign (list '+ 'dgj_ k)) (list 'DET 'R 'n (list 'MINOR 'A k 'dgj_ 'n)))))
    ladet-I1))
(define (ladet-colsum i k)
  (list 'FINSUM ladet-ag
    (list 'VNB-LAMBDA 'dgj_ ladet-I1
      (list '(MUL R) (list '(MUL R) (ladet-sign (list '+ i 'dgj_)) (list 'DET 'R 'n (list 'MINOR 'A 'dgj_ i 'n)))
            (list 'ENTRY 'A 'dgj_ k)))
    ladet-I1))

;; FINSUM(ag, L1, I1) == FINSUM(ag, L2, I1) from the pointwise equation, proved by
;; THUNK on the beta-reduced goal at the point v (passed); returns the instance
(define (ladet-cong! L1 L2 thunk)
  (fact 'ring-additive-ag-is-abelian-group 'R)
  (fact 'interval-in-set 1 '(succ n))
  (fact 'interval-card-in-nn 1 '(succ n))
  (dk-have! (list 'FORALL 'dgz_ (list 'IMPLIES (list 'IN 'dgz_ ladet-I1)
              (list '= (list L1 'dgz_) (list L2 'dgz_))))
    (lambda ()
      (dk-peel!)
      (let ((v (cadr (cadr (dk-goal)))))
        (ladet-iv! v 1 '(succ n))
        (ladet-beta!)
        (thunk v))))
  (dk-fact! 'finsum-congruence-q ladet-ag ladet-I1 L1 L2))

(define (ladet-core-stmt sum off?)
  (forall-guarded (if off? '(R n A i k) '(R n A k))
    (append (list '(IS-COMMUTATIVE-RING R) '(IN n NN) '(IN A (MAT (succ n) (succ n) (CARR R))))
            (if off? (list (list 'IN 'i ladet-I1)) '())
            (list (list 'IN 'k ladet-I1))
            (if off? (list '(NOT (= i k))) '()))
    (list '= sum (if off? '(ZERO R) '(DET R (succ n) A)))))

(define (ladet-core-head!)
  (dk-peel!)
  (fact 'commutative-ring-is-ring 'R)
  (fact 'nn-succ-closed 'n)
  (fact 'nn-one-in))

;; the pointwise closer: the goal is  s (x d) = x (s d)  [row] or  s (x d) = (s d) x
;; [col] up to the order of the two indices in the sign
(define (ladet-pt-close! ring-lemma sumL sumR)
  (let* ((g (dk-goal)) (lhs (cadr g)))
    ;; the sign on the left is (-1)^(sumL), on the right (-1)^(sumR): make them one
    (if (not (equal? sumL sumR))
        (begin
          (dk-have! (list '= sumL sumR) (lambda () (dk-nn!)))
          (subst (list '= sumL sumR))))
    (let* ((g (dk-goal)) (lhs (cadr g))
           (s (cadr lhs)) (x (cadr (caddr lhs))) (d (caddr (caddr lhs))))
      (ladet-carr! s) (ladet-carr! x) (ladet-carr! d)
      (fact ring-lemma 'R s x d)
      (ass))))

;; ---- row, i = k: the expansion along row k
(sp (make-wff (ladet-core-stmt (ladet-rowsum 'k 'k) #f)))
(ladet-core-head!)
(let* ((E (dk-fact! 'det-expand-row 'R 'n 'A 'k)) (LE (caddr (caddr E)))
       (LS (caddr (ladet-rowsum 'k 'k))))
  (subst E)
  (subst (ladet-cong! LE LS (lambda (v)
           (ladet-iv! 'k 1 '(succ n))
           (ladet-pt-close! 'ladet-ring-r1 (list '+ 'k v) (list '+ v 'k)))))
  (ladet-fun-type! LS)
  (fact 'finsum-type-ring-additive-ag 'R ladet-I1 LS)
  (rfl))
(ladet-done! 'ladet-row-diag)
(topic! 'ladet-row-diag 'algebra)

;; ---- column, i = k: the expansion along column k
(sp (make-wff (ladet-core-stmt (ladet-colsum 'k 'k) #f)))
(ladet-core-head!)
(let* ((E (dk-fact! 'det-expand-col 'R 'n 'A 'k)) (LE (caddr (caddr E)))
       (LS (caddr (ladet-colsum 'k 'k))))
  (subst E)
  (subst (ladet-cong! LE LS (lambda (v)
           (ladet-iv! 'k 1 '(succ n))
           (ladet-pt-close! 'ladet-ring-c1 (list '+ v 'k) (list '+ 'k v)))))
  (ladet-fun-type! LS)
  (fact 'finsum-type-ring-additive-ag 'R ladet-I1 LS)
  (rfl))
(ladet-done! 'ladet-col-diag)
(topic! 'ladet-col-diag 'algebra)

;; ---- row, i /= k: A with row k := row i has two equal rows
(sp (make-wff (ladet-core-stmt (ladet-rowsum 'i 'k) #t)))
(ladet-core-head!)
(ladet-iv! 'i 1 '(succ n))
(ladet-iv! 'k 1 '(succ n))
(dk-have! '(= k k) (lambda () (rfl)))
(let* ((B (ladet-mk-row 'i 'k))
       (FB (lambda (L) (list 'FINSUM ladet-ag L ladet-I1))))
  (ladet-mk-type! B)
  (dk-have! (ladet-rowagree B 'A 'k '(succ n))
    (lambda () (dk-peel!) (ladet-mk-rewrite!) (ladet-close-carr!)))
  (dk-have! (list 'FORALL 'dgq_ (list 'IMPLIES (list 'IN 'dgq_ ladet-I1)
              (list '= (list 'ENTRY B 'i 'dgq_) (list 'ENTRY B 'k 'dgq_))))
    (lambda () (dk-peel!) (ladet-mk-rewrite!) (ladet-close-carr!)))
  (fact 'det-alternating-rows 'R '(succ n) B 'i 'k)
  (let* ((E (dk-fact! 'det-expand-row 'R 'n B 'k)) (LE (caddr (caddr E)))
         (LS (caddr (ladet-rowsum 'i 'k))))
    (ladet-cong! LE LS (lambda (v)
      (ladet-mk-rewrite!)
      (ladet-nn! v)
      (subst (dk-fact! 'ladet-minor-rowcongr 'R 'n B 'A 'k v))
      (ladet-pt-close! 'ladet-ring-r1 (list '+ 'k v) (list '+ v 'k))))
    (subst (list '= (FB LS) (FB LE)))
    (subst (list '= (FB LE) (list 'DET 'R '(succ n) B)))
    (ass)))
(ladet-done! 'ladet-row-off)
(topic! 'ladet-row-off 'algebra)

;; ---- column, i /= k: A with column i := column k has two equal columns
(sp (make-wff (ladet-core-stmt (ladet-colsum 'i 'k) #t)))
(ladet-core-head!)
(ladet-iv! 'i 1 '(succ n))
(ladet-iv! 'k 1 '(succ n))
(dk-have! '(= i i) (lambda () (rfl)))
(fact 'neq-sym 'i 'k)
(let* ((B (ladet-mk-col 'i 'k))
       (FB (lambda (L) (list 'FINSUM ladet-ag L ladet-I1))))
  (ladet-mk-type! B)
  (dk-have! (ladet-colagree B 'A 'i '(succ n))
    (lambda () (dk-peel!) (ladet-mk-rewrite!) (ladet-close-carr!)))
  (dk-have! (list 'FORALL 'dgq_ (list 'IMPLIES (list 'IN 'dgq_ ladet-I1)
              (list '= (list 'ENTRY B 'dgq_ 'i) (list 'ENTRY B 'dgq_ 'k))))
    (lambda () (dk-peel!) (ladet-mk-rewrite!) (ladet-close-carr!)))
  (fact 'det-equal-cols-zero 'R '(succ n) B 'i 'k)
  (let* ((E (dk-fact! 'det-expand-col 'R 'n B 'i)) (LE (caddr (caddr E)))
         (LS (caddr (ladet-colsum 'i 'k))))
    (ladet-cong! LE LS (lambda (v)
      (ladet-mk-rewrite!)
      (ladet-nn! v)
      (subst (dk-fact! 'ladet-minor-colcongr 'R 'n B 'A v 'i))
      (ladet-pt-close! 'ladet-ring-c1 (list '+ v 'i) (list '+ 'i v))))
    (subst (list '= (FB LS) (FB LE)))
    (subst (list '= (FB LE) (list 'DET 'R '(succ n) B)))
    (ass)))
(ladet-done! 'ladet-col-off)
(topic! 'ladet-col-off 'algebra)

;; ---- the adjoint: typing and entries
(sp (make-wff
  (forall-guarded '(R n A) '((IS-RING R) (IN n NN) (IN A (MAT (succ n) (succ n) (CARR R))))
    '(IN (ADJ R n A) (MAT (succ n) (succ n) (CARR R))))))
(dk-peel!)
(fact 'nn-succ-closed 'n)
(mac 'ADJ)
(dk-matof!)
(dk-peel!)
(ladet-beta!)
(ladet-close-carr!)
(ladet-done! 'adj-type)
(topic! 'adj-type 'algebra)
(gloss! 'adj-type "The formal adjoint of an (n+1)-square matrix over a ring is an (n+1)-square matrix over it.")

(sp (make-wff
  (forall-guarded '(R n A i j)
    (list '(IS-RING R) '(IN n NN) '(IN A (MAT (succ n) (succ n) (CARR R))) (list 'IN 'i ladet-I1) (list 'IN 'j ladet-I1))
    (list '= '(ENTRY (ADJ R n A) i j)
          (list '(MUL R) (ladet-sign '(+ i j)) '(DET R n (MINOR A j i n)))))))
(dk-peel!)
(fact 'nn-succ-closed 'n)
(mac 'ADJ)
(let ((e (cadr (dk-goal))))
  (ladet-mk-entry! (cadr e) 'i 'j))
(if (not (proof-done? *ps*)) (ass))
(ladet-done! 'adj-entry)
(topic! 'adj-entry 'algebra)
(gloss! 'adj-entry "The (i, j) entry of the formal adjoint is (-1)^(i+j) det A[j, i] (the notes' definition).")

;; ---- Prop 3.25.  LEFT? #t: adj(A) A = det(A) I; #f: A adj(A) = det(A) I.
(define (ladet-adj-main! left?)
  (let* ((s1 '(succ n)) (Adj '(ADJ R n A)) (d '(DET R (succ n) A)) (Id '(IDENTMAT R (succ n)))
         (LHS (if left? (list 'MATMUL 'R Adj 'A) (list 'MATMUL 'R 'A Adj)))
         (RHS (list 'MATSCALE 'R d Id)))
    (sp (make-wff
      (forall-guarded '(R n A) '((IS-COMMUTATIVE-RING R) (IN n NN) (IN A (MAT (succ n) (succ n) (CARR R))))
        (list '= LHS RHS))))
    (dk-peel!)
    (fact 'commutative-ring-is-ring 'R)
    (fact 'nn-succ-closed 'n)
    (fact 'nn-one-in)
    (fact 'adj-type 'R 'n 'A)
    (fact 'identmat-type 'R s1)
    (fact 'det-in-carrier 'R s1 'A)
    (fact 'matscale-type 'R s1 s1 d Id)
    (dk-have! (list 'IMPLIES (list '= s1 0) (list 'OR (list '= s1 0) (list '= s1 0))) (lambda () (prop)))
    (if left? (fact 'matmul-type 'R s1 s1 s1 Adj 'A) (fact 'matmul-type 'R s1 s1 s1 'A Adj))
    (dk-have! (list '<= 1 s1) (lambda () (dk-nn!)))
    (detach-with! (dk-fact! 'matrix-entry-extensionality s1 s1 '(CARR R) LHS RHS)
      (lambda ()
        (dk-peel!)
        (let* ((g (dk-goal)) (i (caddr (cadr g))) (k (cadddr (cadr g))))
          (ladet-iv! i 1 s1)
          (ladet-iv! k 1 s1)
          (let* ((me (if left? (dk-fact! 'matmul-entry 'R s1 s1 s1 Adj 'A i k)
                               (dk-fact! 'matmul-entry 'R s1 s1 s1 'A Adj i k)))
                 (Lj (caddr (caddr me)))
                 (LS (caddr (if left? (ladet-colsum i k) (ladet-rowsum i k)))))
            (subst me)
            (subst (dk-fact! 'matscale-entry 'R s1 s1 d Id i k))
            (subst (ladet-cong! Lj LS (lambda (v)
                     (if left?
                         (subst (dk-fact! 'adj-entry 'R 'n 'A i v))
                         (subst (dk-fact! 'adj-entry 'R 'n 'A v k)))
                     (ladet-close-carr!))))
            (use-em (list '= i k)
              (lambda ()
                (subst (list '= k i))
                (subst (dk-fact! 'identmat-entry-diag 'R s1 i))
                (subst (dk-fact! 'ring-mul-right-id 'R d))
                (fact (if left? 'ladet-col-diag 'ladet-row-diag) 'R 'n 'A i)
                (ass))
              (lambda ()
                (subst (dk-fact! 'identmat-entry-off 'R s1 i k))
                (subst (dk-fact! 'ring-mul-zero-right 'R d))
                (fact (if left? 'ladet-col-off 'ladet-row-off) 'R 'n 'A i k)
                (ass)))))))
    (ass)))

(ladet-adj-main! #t)
