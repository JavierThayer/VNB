;;; la-det-adjoint.scm -- the triangular determinant (linear-algebra 3.23), the formal
;;; adjoint (3.25: adj(A) A = det(A) I = A adj(A)) and invertibility over a field (3.26:
;;; A invertible iff det A /= 0).  LA-DET, 2026-10-18.  The pedestrian route of the
;;; notes: cofactor expansion only (det-expand-row / det-expand-col, det-rows.scm and
;;; det-transpose.scm), no permutations.  Over a COMMUTATIVE ring until 3.26, which is
;;; over a field (IS-FIELD-RING: a commutative ring with one /= zero in which every
;;; nonzero element has a multiplicative inverse -- both facts are conjuncts of its
;;; definition, structure-library/field.scm).
;;;
;;; Vocabulary: structure-library/la-det-vocab.scm (IS-LOWER-TRIANGULAR,
;;; IS-UPPER-TRIANGULAR, ADJ).
;;;
;;; HEADLINES
;;;   det-lower-triangular / det-upper-triangular   (3.23)  det D = prod_{k=1..n} D_kk
;;;   adj-mul / mul-adj                             (3.25)  adj(A) A = det(A) I = A adj(A)
;;;   cramer-inverse            det(A) b = 1  =>  b adj(A) is a two-sided inverse of A
;;;   invertible-iff-det-nonzero                    (3.26)  over a field
;;; and the scalar laws matscale-one, matscale-matscale, matmul-matscale-right/-left.
;;;
;;; LOAD WINDOW [after "theorem-library/inverse-invertible-proof" (load.scm:2157), -).
;;; The latest citations: inverse-is-invertible (inverse-invertible-proof, 2157),
;;; det-expand-col and det-equal-cols-zero (det-transpose, 2103), det-multiplicative
;;; (2099), interval-widen (2078), identmat-invertible (mat-equiv-proof, 2051),
;;; det-expand-row / det-alternating-rows / dtr-sign-succ / dtr-sign-type / dtr-skip-in
;;; (det-rows, 2029), matscale-entry and identmat-entry-diag/-off (elem-entry-readoffs,
;;; 2001), prod-ring-insert-ptwise / -congruence-q / -type-ptwise (rake-prod-of-sums,
;;; 1730).  finsum-single-support-ring-additive-ag is the view companion built by the
;;; unrestricted specializer in theorem-library/cancellation (1125).  Nothing in the
;;; tree cites this file.  Library: linear-algebra.  No axiom, support or stamp.
;;;
;;; Helper prefix: ladet-.  Binders the driver builds or states: dga_ (the sign lemma),
;;; dgk_ dgj_ (the diagonal product, the pointwise lanes), lmu_ lmv_ (minor entries),
;;; lla_ llb_ (the NN lemma).

;;; =====================================================================
;;; The file's kit.
;;; =====================================================================
(define (ladet-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-det-adjoint: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name))

(define ladet-ag   '(RING-ADDITIVE-AG R))
(define ladet-mm   '(RING-MULTIPLICATIVE-MONOID R))
(define ladet-neg1 '((NEG R) (ONE R)))
(define (ladet-sign e) (list 'MPOW ladet-mm ladet-neg1 e))
(define (ladet-iv n) (list 'INTERVAL 1 n))

(define (ladet-iv! i a b)
  (fact 'interval-elt-in-nn a b i)
  (fact 'interval-lo a b i)
  (fact 'interval-hi a b i))

(define (ladet-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))

;; (IN X (INTERVAL A B)) for an NN term X already typed in NN
(define (ladet-in-iv! x a b prems)
  (dk-have! (list 'IN x (list 'INTERVAL a b)) (lambda ()
      (dk-have! (list '<= a x) (lambda () (apply dk-nn! prems)))
      (dk-have! (list '<= x b) (lambda () (apply dk-nn! prems)))
      (fact 'interval-mem-intro a b x)
      (ass))))

;; from (IN u (INTERVAL 1 n)) land (IN u (INTERVAL 1 (succ n)))
(define (ladet-widen! u n)
  (let ((t (list 'IN u (ladet-iv (list 'succ n)))))
    (if (not (dk-asm? t))
        (begin
          (fact 'nn-succ-closed n)
          (dk-have! (list '<= n (list 'succ n)) (lambda () (dk-nn!)))
          (fact 'interval-widen n (list 'succ n) 1 u)))
    (if (not (dk-asm? t)) (error "ladet-widen!: did not land" (expression->string t)))))

;; IF resolution from the context (det-rows.scm's dtr-if-auto!, the file's copy)
(define (ladet-find-decided-if e)
  (cond ((not (pair? e)) #f)
        ((and (eq? (car e) 'IF) (= (length e) 4)
              (or (dk-asm? (cadr e)) (dk-asm? (list 'NOT (cadr e)))))
         (cons (dk-asm? (cadr e)) e))
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((ladet-find-decided-if (car l)))
                    (#t (loop (cdr l))))))))
(define (ladet-if-auto!)
  (let loop ()
    (let ((hit (ladet-find-decided-if (dk-goal))))
      (if hit (begin (dk-if-branch! (if (car hit) #t #f) (cdr hit) #f (lambda () #t)) (loop))))))

;; close ANY goal from contradictory NN facts PREMS
(define (ladet-absurd! prems)
  (dk-have! '(<= 1 0) (lambda () (apply dk-nn! prems)))
  (dk-focus-having! '(<= 1 0))
  (have! '(NOT (<= 1 0)) (lambda () (arith)))
  (dk-focus-having! '(NOT (<= 1 0)))
  (pbc)
  (ai '(NOT (<= 1 0))))

;; the sizes of a matrix X typed (IN X (MAT m k (CARR R))) in context
(define (ladet-mat-of X)
  (let ((f (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN) (equal? (cadr f) X)
                                        (pair? (caddr f)) (eq? (car (caddr f)) 'MAT)
                                        (equal? (cadddr (caddr f)) '(CARR R))))
                       (dk-asms))))
    (if (not f) (error "ladet-mat-of: matrix not typed" (expression->string X)))
    (caddr f)))

;; land (IN E NN) for E built of succ, +, variables typed in NN or in an interval
(define (ladet-nn! e)
  (cond ((dk-asm? (list 'IN e 'NN)) #t)
        ((and (pair? e) (eq? (car e) 'succ)) (ladet-nn! (cadr e)) (fact 'nn-succ-closed (cadr e)))
        ((and (pair? e) (eq? (car e) '+))
         (ladet-nn! (cadr e)) (ladet-nn! (caddr e))
         (dk-have! (list 'AND (list 'IN (cadr e) 'NN) (list 'IN (caddr e) 'NN))
           (lambda () (dk-conj-close! (lambda () (ass)))))
         (fact 'nn-add-closed (cadr e) (caddr e)))
        ((number? e) (dk-have! (list 'IN e 'NN) (lambda () (arith))))
        ((symbol? e)
         (let ((f (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN) (eq? (cadr f) e)
                                               (pair? (caddr f)) (eq? (car (caddr f)) 'INTERVAL)))
                              (dk-asms))))
           (if (not f) (error "ladet-nn!: untyped" e))
           (fact 'interval-elt-in-nn (cadr (caddr f)) (caddr (caddr f)) e)))
        (#t (error "ladet-nn!: cannot type" (expression->string e))))
  (if (not (dk-asm? (list 'IN e 'NN))) (error "ladet-nn!: did not land" (expression->string e))))

;; land (IN T (CARR R)) for T built of ENTRY, DET, the sign, ADD, MUL, NEG, ONE, ZERO
(define (ladet-carr! t)
  (cond ((dk-asm? (list 'IN t '(CARR R))) #t)
        ((and (pair? t) (eq? (car t) 'ENTRY))
         (let ((M (ladet-mat-of (cadr t))))
           (fact 'entry-in-carrier (cadr M) (caddr M) '(CARR R) (cadr t) (caddr t) (cadddr t))))
        ((equal? t '(ONE R)) (fact 'ring-one-in 'R))
        ((equal? t '(ZERO R)) (fact 'ring-zero-in 'R))
        ((and (pair? t) (equal? (car t) '(NEG R)))
         (ladet-carr! (cadr t)) (fact 'ring-neg-in-carr 'R (cadr t)))
        ((and (pair? t) (eq? (car t) 'MPOW) (equal? (cadr t) ladet-mm) (equal? (caddr t) ladet-neg1))
         (ladet-nn! (cadddr t)) (fact 'dtr-sign-type 'R (cadddr t)))
        ((and (pair? t) (eq? (car t) 'DET))
         (let ((sz (caddr t)) (mx (cadddr t)))
           (if (and (pair? mx) (eq? (car mx) 'MINOR))
               (begin (ladet-nn! (caddr mx)) (ladet-nn! (cadddr mx)) (ladet-nn! sz)
                      (fact 'minor-type 'R (cadr mx) (caddr mx) (cadddr mx) sz)))
           (fact 'det-in-carrier 'R sz mx)))
        ((and (pair? t) (equal? (car t) '(ADD R)))
         (ladet-carr! (cadr t)) (ladet-carr! (caddr t))
         (fact 'ring-add-closed 'R (cadr t) (caddr t)))
        ((and (pair? t) (equal? (car t) '(MUL R)))
         (ladet-carr! (cadr t)) (ladet-carr! (caddr t))
         (fact 'ring-carrier-closed-mul 'R (cadr t) (caddr t)))
        (#t (error "ladet-carr!: cannot type" (expression->string t))))
  (if (not (dk-asm? (list 'IN t '(CARR R)))) (error "ladet-carr!: did not land" (expression->string t))))

;; close a goal (IN T (CARR R)) / (IN T SET) / (= T T) with T typable
(define (ladet-close-carr!)
  (let ((g (dk-goal)))
    (cond ((and (eq? (car g) 'IN) (equal? (caddr g) '(CARR R))) (ladet-carr! (cadr g)) (ass))
          ((and (eq? (car g) 'IN) (eq? (caddr g) 'SET))
           (ladet-carr! (cadr g)) (fact 'membership-implies-sethood (cadr g) '(CARR R)) (ass))
          ((eq? (car g) '=) (ladet-carr! (cadr g)) (rfl))
          (#t (error "ladet-close-carr!: unexpected goal" (expression->string g))))))

;; (IN LAM (FUN DOM (CARR R))) for a one-variable lambda whose body is typable
(define (ladet-fun-type! lam)
  (let ((dom (caddr lam)))
    (dk-have! (list 'IN lam (list 'FUN dom '(CARR R)))
      (lambda ()
        (dk-lam-type! (lambda () (dk-peel!) (ladet-beta!) (ladet-close-carr!))
                      (lambda () (fact 'interval-in-set (cadr dom) (caddr dom)) (ass)))))))

;;; =====================================================================
;;; (1) NN and sign plumbing.
;;; =====================================================================
;; a <= b, a /= b  =>  a < b   in NN
(sp (make-wff
  (forall-guarded '(lla_ llb_) '((IN lla_ NN) (IN llb_ NN) (<= lla_ llb_) (NOT (= lla_ llb_)))
    '(< lla_ llb_))))
(dk-peel!)
(use-em '(< lla_ llb_)
  (lambda () (ass))
  (lambda ()
    (fact 'nn-not-lt-le 'lla_ 'llb_)
    (dk-have! '(= lla_ llb_) (lambda () (dk-nn! '(<= lla_ llb_) '(<= llb_ lla_))))
    (pbc)
    (ai '(NOT (= lla_ llb_)))))
(ladet-done! 'ladet-nn-lt-of-le-ne)
(topic! 'ladet-nn-lt-of-le-ne 'plumbing)

;; (-1)^(a + a) = 1
(sp (make-wff
  (list 'FORALL 'dga_ (list 'IMPLIES '(IN dga_ NN)
    (list 'FORALL 'R (list 'IMPLIES '(IS-COMMUTATIVE-RING R)
      (list '= (ladet-sign '(+ dga_ dga_)) '(ONE R))))))))
(define ladet-se-ind (use-induction))
(dk-focus! (cdr (assq 'base ladet-se-ind)))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(dk-have! '(= (+ 0 0) 0) (lambda () (arith)))
(subst '(= (+ 0 0) 0))
(fact 'ring-one-in 'R)
(fact 'ring-neg-in-carr 'R '(ONE R))
(mac 'mpow-zero)
(fact 'rmm-iden 'R)
(subst (list '= (list 'IDEN ladet-mm) '(ONE R)))
(rfl)
(dk-focus! (cdr (assq 'step ladet-se-ind)))
(define ladet-se-ih (cdr (assq 'ih ladet-se-ind)))
(define ladet-se-v (cdr (assq 'var ladet-se-ind)))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(let* ((v ladet-se-v) (vv (list '+ v v)) (sv (list 'succ v)))
  (ladet-nn! vv)
  (ladet-nn! (list 'succ vv))
  (dk-have! (list '= (list '+ sv sv) (list 'succ (list 'succ vv))) (lambda () (dk-nn!)))
  (subst (list '= (list '+ sv sv) (list 'succ (list 'succ vv))))
  (fact 'dtr-sign-succ 'R (list 'succ vv))
  (subst (list '= (ladet-sign (list 'succ (list 'succ vv)))
               (list '(MUL R) ladet-neg1 (ladet-sign (list 'succ vv)))))
  (fact 'dtr-sign-succ 'R vv)
  (subst (list '= (ladet-sign (list 'succ vv)) (list '(MUL R) ladet-neg1 (ladet-sign vv))))
  (dk-apply! ladet-se-ih 'R)
  (subst (list '= (ladet-sign vv) '(ONE R)))
  (crs))
(ladet-done! 'ladet-sign-even)
(topic! 'ladet-sign-even 'plumbing)

;;; =====================================================================
;;; (2) Prop 3.23: the determinant of a triangular matrix is the product of its
;;; diagonal entries.  The notes induct through a_11 and the first row; the library's
;;; expansion along ANY row or column lets the induction run through the LAST one,
;;; where the minor at (n+1, n+1) keeps the indices of A (no re-indexing of the
;;; product): for A lower triangular the last COLUMN is zero above a_{n+1,n+1}
;;; (det-expand-col), for A upper triangular the last ROW is zero left of it
;;; (det-expand-row).  No transpose is needed.
;;; =====================================================================
(define (ladet-diag X n)
  (list 'PROD-RING 'R (list 'VNB-LAMBDA 'dgk_ (ladet-iv n) (list 'ENTRY X 'dgk_ 'dgk_)) (ladet-iv n)))

;; the read-offs of the two predicates
(sp (make-wff '(FORALL A (FORALL n (FORALL D
     (IMPLIES (IS-LOWER-TRIANGULAR A n D)
     (FORALL i (IMPLIES (IN i (INTERVAL 1 n))
     (FORALL j (IMPLIES (IN j (INTERVAL 1 n))
     (IMPLIES (< i j) (= (ENTRY D i j) (ZERO A)))))))))))))
(dk-peel!)
(let* ((e (cadr (dk-goal))) (i (caddr e)) (j (cadddr e)))
  (mac-h 'IS-LOWER-TRIANGULAR (dk-pick (dk-head? 'IS-LOWER-TRIANGULAR) "the hypothesis"))
  (dk-apply! (dk-pick (dk-head? 'FORALL) "the unfolded universal") i j))
(ass)
(ladet-done! 'lower-triangular-entry)
(topic! 'lower-triangular-entry 'algebra)

(sp (make-wff '(FORALL A (FORALL n (FORALL D
     (IMPLIES (IS-UPPER-TRIANGULAR A n D)
     (FORALL i (IMPLIES (IN i (INTERVAL 1 n))
     (FORALL j (IMPLIES (IN j (INTERVAL 1 n))
     (IMPLIES (< j i) (= (ENTRY D i j) (ZERO A)))))))))))))
(dk-peel!)
(let* ((e (cadr (dk-goal))) (i (caddr e)) (j (cadddr e)))
  (mac-h 'IS-UPPER-TRIANGULAR (dk-pick (dk-head? 'IS-UPPER-TRIANGULAR) "the hypothesis"))
  (dk-apply! (dk-pick (dk-head? 'FORALL) "the unfolded universal") i j))
(ass)
(ladet-done! 'upper-triangular-entry)
(topic! 'upper-triangular-entry 'algebra)

;; the minor at (n+1, n+1) keeps the indices: its (u, v) entry is a_uv
(sp (make-wff
  (forall-guarded '(R n S lmu_ lmv_)
    '((IS-RING R) (IN n NN) (IN S (MAT (succ n) (succ n) (CARR R)))
      (IN lmu_ (INTERVAL 1 n)) (IN lmv_ (INTERVAL 1 n)))
    '(= (ENTRY (MINOR S (succ n) (succ n) n) lmu_ lmv_) (ENTRY S lmu_ lmv_)))))
(dk-peel!)
(ladet-iv! 'lmu_ 1 'n)
(ladet-iv! 'lmv_ 1 'n)
(fact 'nn-succ-closed 'n)
(subst (dk-fact! 'minor-entry 'R 'S '(succ n) '(succ n) 'n 'lmu_ 'lmv_))
(dk-have! '(< lmu_ (succ n)) (lambda () (dk-nn! '(<= lmu_ n))))
(dk-have! '(< lmv_ (succ n)) (lambda () (dk-nn! '(<= lmv_ n))))
(ladet-if-auto!)
(ladet-widen! 'lmu_ 'n)
(ladet-widen! 'lmv_ 'n)
(ladet-close-carr!)
(ladet-done! 'ladet-minor-last-entry)
(topic! 'ladet-minor-last-entry 'algebra)

;; the minor at (n+1, n+1) of a triangular matrix is triangular
(define (ladet-minor-tri-stmt pred)
  (forall-guarded '(R n S)
    (list '(IS-RING R) '(IN n NN) '(IN S (MAT (succ n) (succ n) (CARR R))) (list pred 'R '(succ n) 'S))
    (list pred 'R 'n '(MINOR S (succ n) (succ n) n))))
(define (ladet-minor-tri! pred readoff)
  (sp (make-wff (ladet-minor-tri-stmt pred)))
  (dk-peel!)
  (fact 'nn-succ-closed 'n)
  (fact 'minor-type 'R 'S '(succ n) '(succ n) 'n)       ; type the minor BEFORE the macete
  (mac pred)
  (dk-peel!)
  (let* ((e (cadr (dk-goal))) (u (caddr e)) (v (cadddr e)))
    (subst (dk-fact! 'ladet-minor-last-entry 'R 'n 'S u v))
    (ladet-widen! u 'n)
    (ladet-widen! v 'n)
    (fact readoff 'R '(succ n) 'S u v)
    (ass)))
(ladet-minor-tri! 'IS-LOWER-TRIANGULAR 'lower-triangular-entry)
(ladet-done! 'ladet-minor-lower)
(topic! 'ladet-minor-lower 'algebra)
(ladet-minor-tri! 'IS-UPPER-TRIANGULAR 'upper-triangular-entry)
(ladet-done! 'ladet-minor-upper)
(topic! 'ladet-minor-upper 'algebra)

;; the induction.  KIND is 'lower (expand along the last column) or 'upper (the last row).
(define (ladet-tri-pred kind) (if (eq? kind 'lower) 'IS-LOWER-TRIANGULAR 'IS-UPPER-TRIANGULAR))
(define (ladet-tri-body kind n)
  (forall-guarded '(R D)
    (list '(IS-COMMUTATIVE-RING R) (list 'IN 'D (list 'MAT n n '(CARR R))) (list (ladet-tri-pred kind) 'R n 'D))
    (list '= (list 'DET 'R n 'D) (ladet-diag 'D n))))

(define (ladet-tri-ind! kind)
  (sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (ladet-tri-body kind 'n)))))
  (let ((ind (use-induction)))
    ;; ---- base: DET(R, 0, D) = 1 = the empty product
    (dk-focus! (cdr (assq 'base ind)))
    (dk-peel!)
    (fact 'commutative-ring-is-ring 'R)
    (fact 'ring-one-in 'R)
    (subst (dk-fact! 'det-zero 'R 'D))
    (fact 'interval-1-0-empty)
    (subst '(= (INTERVAL 1 0) EMPTY-SET))
    (subst (dk-fact! 'prod-ring-empty 'R '(VNB-LAMBDA dgk_ EMPTY-SET (ENTRY D dgk_ dgk_))))
    (rfl)
    ;; ---- step
    (dk-focus! (cdr (assq 'step ind)))
    (let ((ih (cdr (assq 'ih ind))))
      (dk-peel!)
      (let* ((s1 '(succ n)) (I1 (ladet-iv s1)) (I0 (ladet-iv 'n))
             (Mn (list 'MINOR 'D s1 s1 'n)))
        (fact 'commutative-ring-is-ring 'R)
        (fact 'nn-succ-closed 'n)
        (fact 'nn-one-in)
        (ladet-in-iv! s1 1 s1 '())
        (let* ((E (if (eq? kind 'lower)
                      (dk-fact! 'det-expand-col 'R 'n 'D s1)
                      (dk-fact! 'det-expand-row 'R 'n 'D s1)))
               (L (caddr (caddr E))))
          (subst E)
          (ladet-fun-type! L)
          ;; the summands off the last index vanish
          (let ((Z (list 'FORALL 'dgj_ (list 'IMPLIES (list 'IN 'dgj_ I1)
                     (list 'IMPLIES (list 'NOT (list '= 'dgj_ s1)) (list '= (list L 'dgj_) '(ZERO R)))))))
            (dk-have! Z
              (lambda ()
                (dk-peel!)
                (let ((v (cadr (cadr (dk-goal)))))
                  (ladet-iv! v 1 s1)
                  (fact 'ladet-nn-lt-of-le-ne v s1)
                  (ladet-beta!)
                  (if (eq? kind 'lower)
                      (subst (dk-fact! 'lower-triangular-entry 'R s1 'D v s1))
                      (subst (dk-fact! 'upper-triangular-entry 'R s1 'D s1 v)))
                  (let* ((g (dk-goal)) (sg (cadr (cadr g))) (dt (caddr (caddr (cadr g)))))
                    (ladet-carr! dt)
                    (ladet-carr! sg)
                    (subst (dk-fact! 'ring-mul-zero-left 'R dt))
                    (subst (dk-fact! 'ring-mul-zero-right 'R sg))
                    (ladet-close-carr!))))))
          (fact 'interval-in-set 1 s1)
          (fact 'interval-card-in-nn 1 s1)
          (subst (dk-fact! 'finsum-single-support-ring-additive-ag 'R I1 L s1))
          (ladet-beta!)
          ;; the surviving term: (+1) a_{n+1,n+1} det(minor)
          (subst (dk-fact! 'ladet-sign-even s1 'R))
          (let ((x (list '(MUL R) (list 'ENTRY 'D s1 s1) (list 'DET 'R 'n Mn))))
            (ladet-carr! x)
            (subst (dk-fact! 'ring-mul-left-id 'R x)))
          ;; the induction hypothesis at the minor
          (fact (if (eq? kind 'lower) 'ladet-minor-lower 'ladet-minor-upper) 'R 'n 'D)
          (subst (dk-apply! ih 'R Mn))
          ;; the product over [1, n+1] peels its last factor
          (let* ((lamD (list 'VNB-LAMBDA 'dgk_ I1 '(ENTRY D dgk_ dgk_)))
                 (lamM (list 'VNB-LAMBDA 'dgk_ I0 (list 'ENTRY Mn 'dgk_ 'dgk_)))
                 (U    (list 'UNION I0 (list 'PAIR s1 s1)))
                 (ins  (fact 'interval-succ-insert 'n)))
            (fact 'interval-in-set 1 'n)
            (fact 'interval-card-in-nn 1 'n)
            (fact 'membership-implies-sethood s1 'NN)
            (dk-have! (list 'NOT (list 'IN s1 I0))
              (lambda ()
                (di)
                (fact 'interval-hi 1 'n s1)
                (ladet-absurd! (list (list '<= s1 'n)))))
            (dk-have! (list 'FORALL 'dgj_ (list 'IMPLIES (list 'IN 'dgj_ U)
                        (list 'IN (list lamD 'dgj_) '(CARR R))))
              (lambda ()
                (dk-peel!)
                (let* ((v (cadr (cadr (dk-goal)))))
                  (dk-rewrite-h! (list 'IN v U) U I1)
                  (ladet-beta!)
                  (ladet-close-carr!))))
            (let* ((pins (dk-fact! 'prod-ring-insert-ptwise 'R I0 s1 lamD))
                   (pins1 (dk-rewrite-h! pins U I1)))
              (subst pins1))
            (ladet-beta!)
            ;; prod over [1, n] of the minor's diagonal = that of D's
            (dk-have! (list 'FORALL 'dgj_ (list 'IMPLIES (list 'IN 'dgj_ I0)
                        (list '= (list lamM 'dgj_) (list lamD 'dgj_))))
              (lambda ()
                (dk-peel!)
                (let* ((v (cadr (cadr (dk-goal)))))
                  (ladet-widen! v 'n)
                  (ladet-beta!)
                  (fact 'ladet-minor-last-entry 'R 'n 'D v v)
                  (ass))))
            (subst (dk-fact! 'prod-ring-congruence-q 'R I0 lamM lamD))
            (dk-have! (list 'FORALL 'dgj_ (list 'IMPLIES (list 'IN 'dgj_ I0)
                        (list 'IN (list lamD 'dgj_) '(CARR R))))
              (lambda ()
                (dk-peel!)
                (let* ((v (cadr (cadr (dk-goal)))))
                  (ladet-widen! v 'n)
                  (ladet-beta!)
                  (ladet-close-carr!))))
            (let ((P (list 'PROD-RING 'R lamD I0)) (dd (list 'ENTRY 'D s1 s1)))
              (fact 'prod-ring-type-ptwise 'R I0 lamD)
              (ladet-carr! dd)
              (fact 'commutative-ring-mul-comm 'R dd P)
              (ass))))))))

