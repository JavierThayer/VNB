;;; =====================================================================
;;; (4) Prop 3.26: over a field, A is invertible iff det A /= 0.  "Only if" by
;;; multiplicativity and det I = 1 (and one /= zero); "if" by 3.25:
;;; A^-1 = det(A)^-1 adj(A) (Cramer's rule, the notes' formula).  The scalar
;;; laws of MATSCALE it needs are proved first.
;;; =====================================================================
;; entrywise proof of P = Q in MAT(ROWS, COLS, CARR R): THUNK gets the indices, focus on
;; (= (ENTRY P i k) (ENTRY Q i k))
(define (ladet-ext! P Q rows cols thunk)
  (detach-with! (dk-fact! 'matrix-entry-extensionality rows cols '(CARR R) P Q)
    (lambda ()
      (dk-peel!)
      (let* ((g (dk-goal)) (ei (caddr (cadr g))) (ek (cadddr (cadr g))))
        (ladet-iv! ei 1 rows)
        (ladet-iv! ek 1 cols)
        (thunk ei ek))))
  (ass))

;; 1 X = X
(sp (make-wff
  (forall-guarded '(R m k X) '((IS-RING R) (IN X (MAT m k (CARR R))))
    '(= (MATSCALE R (ONE R) X) X))))
(dk-peel!)
(fact 'ring-one-in 'R)
(fact 'matscale-type 'R 'm 'k '(ONE R) 'X)
(ladet-ext! '(MATSCALE R (ONE R) X) 'X 'm 'k (lambda (i j)
  (subst (dk-fact! 'matscale-entry 'R 'm 'k '(ONE R) 'X i j))
  (let ((x (list 'ENTRY 'X i j)))
    (ladet-carr! x)
    (subst (dk-fact! 'ring-mul-left-id 'R x))
    (ladet-close-carr!))))
(ladet-done! 'matscale-one)
(topic! 'matscale-one 'algebra)

;; b (d X) = (b d) X
(sp (make-wff
  (forall-guarded '(R m k X b d) '((IS-RING R) (IN X (MAT m k (CARR R))) (IN b (CARR R)) (IN d (CARR R)))
    '(= (MATSCALE R b (MATSCALE R d X)) (MATSCALE R ((MUL R) b d) X)))))
(dk-peel!)
(fact 'ring-carrier-closed-mul 'R 'b 'd)
(fact 'matscale-type 'R 'm 'k 'd 'X)
(fact 'matscale-type 'R 'm 'k 'b '(MATSCALE R d X))
(fact 'matscale-type 'R 'm 'k '((MUL R) b d) 'X)
(ladet-ext! '(MATSCALE R b (MATSCALE R d X)) '(MATSCALE R ((MUL R) b d) X) 'm 'k (lambda (i j)
  (subst (dk-fact! 'matscale-entry 'R 'm 'k 'b '(MATSCALE R d X) i j))
  (subst (dk-fact! 'matscale-entry 'R 'm 'k 'd 'X i j))
  (subst (dk-fact! 'matscale-entry 'R 'm 'k '((MUL R) b d) 'X i j))
  (let ((x (list 'ENTRY 'X i j)))
    (ladet-carr! x)
    (subst (dk-fact! 'ring-mul-assoc 'R 'b 'd x))
    (ladet-close-carr!))))
(ladet-done! 'matscale-matscale)
(topic! 'matscale-matscale 'algebra)

;; P (c Q) = c (P Q)  and  (c P) Q = c (P Q), square, over a commutative ring
(define (ladet-scale-mul! right?)
  (let* ((s1 '(succ n)) (I1 ladet-I1)
         (cQ (if right? '(MATSCALE R c Q) '(MATSCALE R c P)))
         (LHS (if right? (list 'MATMUL 'R 'P cQ) (list 'MATMUL 'R cQ 'Q)))
         (PQ '(MATMUL R P Q))
         (RHS (list 'MATSCALE 'R 'c PQ)))
    (sp (make-wff
      (forall-guarded '(R n P Q c)
        '((IS-COMMUTATIVE-RING R) (IN n NN) (IN P (MAT (succ n) (succ n) (CARR R)))
          (IN Q (MAT (succ n) (succ n) (CARR R))) (IN c (CARR R)))
        (list '= LHS RHS))))
    (dk-peel!)
    (fact 'commutative-ring-is-ring 'R)
    (fact 'nn-succ-closed 'n)
    (fact 'nn-one-in)
    (fact 'matscale-type 'R s1 s1 'c (if right? 'Q 'P))
    (dk-have! (list 'IMPLIES (list '= s1 0) (list 'OR (list '= s1 0) (list '= s1 0))) (lambda () (prop)))
    (if right? (fact 'matmul-type 'R s1 s1 s1 'P cQ) (fact 'matmul-type 'R s1 s1 s1 cQ 'Q))
    (fact 'matmul-type 'R s1 s1 s1 'P 'Q)
    (fact 'matscale-type 'R s1 s1 'c PQ)
    (dk-have! (list '<= 1 s1) (lambda () (dk-nn!)))
    (fact 'interval-in-set 1 s1)
    (fact 'interval-card-in-nn 1 s1)
    (ladet-ext! LHS RHS s1 s1 (lambda (i k)
      (let* ((me1 (if right? (dk-fact! 'matmul-entry 'R s1 s1 s1 'P cQ i k)
                             (dk-fact! 'matmul-entry 'R s1 s1 s1 cQ 'Q i k)))
             (L1 (caddr (caddr me1))))
        (subst me1)
        (subst (dk-fact! 'matscale-entry 'R s1 s1 'c PQ i k))
        (let* ((me2 (dk-fact! 'matmul-entry 'R s1 s1 s1 'P 'Q i k))
               (L2 (caddr (caddr me2))))
          (subst me2)
          (ladet-fun-type! L2)
          (let* ((ds (dk-fact! 'finsum-ring-distrib-left-gen 'R 'c I1 L2))
                 (L3 (caddr (caddr ds))))
            (subst ds)
            (subst (ladet-cong! L1 L3 (lambda (v)
              (if right?
                  (subst (dk-fact! 'matscale-entry 'R s1 s1 'c 'Q v k))
                  (subst (dk-fact! 'matscale-entry 'R s1 s1 'c 'P i v)))
              (let* ((p (list 'ENTRY 'P i v)) (q (list 'ENTRY 'Q v k)))
                (ladet-carr! p) (ladet-carr! q)
                (if right?
                    (subst (dk-fact! 'ladet-ring-r1 'R 'c p q))
                    (subst (dk-fact! 'ring-mul-assoc 'R 'c p q)))
                (ladet-close-carr!)))))
            (ladet-fun-type! L3)
            (fact 'finsum-type-ring-additive-ag 'R I1 L3)
            (rfl))))))))
(ladet-scale-mul! #t)
(ladet-done! 'matmul-matscale-right)
(topic! 'matmul-matscale-right 'algebra)
(ladet-scale-mul! #f)
(ladet-done! 'matmul-matscale-left)
(topic! 'matmul-matscale-left 'algebra)

;; what IS-FIELD-RING gives: one /= zero, and right inverses of nonzero elements
(sp (make-wff '(FORALL R (IMPLIES (IS-FIELD-RING R) (NOT (= (ONE R) (ZERO R)))))))
(dk-peel!)
(dk-project! '(NOT (= (ONE R) (ZERO R))) 'is-field-ring-def '(IS-FIELD-RING R))
(ass)
(ladet-done! 'ladet-field-one-ne)
(topic! 'ladet-field-one-ne 'plumbing)

(sp (make-wff
  (list 'FORALL 'R (list 'IMPLIES '(IS-FIELD-RING R)
    (forall-guarded '(lfx_) '((IN lfx_ (CARR R)) (NOT (= lfx_ (ZERO R))))
      (forsome-guarded '(lfb_) '((IN lfb_ (CARR R))) '(= ((MUL R) lfx_ lfb_) (ONE R))))))))
(dk-peel!)
(let ((u (dk-landed-1 (lambda () (mac-h 'is-field-ring-def '(IS-FIELD-RING R))))))
  (dk-split! u))
(dk-apply! (dk-pick (dk-head? 'FORALL) "the inverse clause") 'lfx_)
(ass)
(ladet-done! 'ladet-field-inverse)
(topic! 'ladet-field-inverse 'plumbing)

;; b (d I) = (b d) I = (d b) I = 1 I = I, with det(A) b = 1 in context
(define (ladet-cr-tail! s1 Id d)
  (subst (dk-fact! 'matscale-matscale 'R s1 s1 Id 'b d))
  (subst (list '= (list '(MUL R) 'b d) (list '(MUL R) d 'b)))
  (subst (list '= (list '(MUL R) d 'b) '(ONE R)))
  (subst (dk-fact! 'matscale-one 'R s1 s1 Id))
  (rfl))

;; ---- Cramer's rule (the notes' formula A^-1 = det(A)^-1 adj(A)), over a commutative
;; ring, for any b with det(A) b = 1
(sp (make-wff
  (forall-guarded '(R n A b)
    '((IS-COMMUTATIVE-RING R) (IN n NN) (IN A (MAT (succ n) (succ n) (CARR R))) (IN b (CARR R))
      (= ((MUL R) (DET R (succ n) A) b) (ONE R)))
    '(AND (= (MATMUL R A (MATSCALE R b (ADJ R n A))) (IDENTMAT R (succ n)))
          (= (MATMUL R (MATSCALE R b (ADJ R n A)) A) (IDENTMAT R (succ n)))))))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(fact 'nn-succ-closed 'n)
(let* ((s1 '(succ n)) (d '(DET R (succ n) A)) (Adj '(ADJ R n A)) (Id '(IDENTMAT R (succ n)))
       (V (list 'MATSCALE 'R 'b Adj)))
  (fact 'det-in-carrier 'R s1 'A)
  (fact 'adj-type 'R 'n 'A)
  (fact 'identmat-type 'R s1)
  (fact 'commutative-ring-mul-comm 'R 'b d)
  (dk-have! (list '= (list 'MATMUL 'R 'A V) Id) (lambda ()
    (subst (dk-fact! 'matmul-matscale-right 'R 'n 'A Adj 'b))
    (subst (dk-fact! 'mul-adj 'R 'n 'A))
    (ladet-cr-tail! s1 Id d)))
  (dk-have! (list '= (list 'MATMUL 'R V 'A) Id) (lambda ()
    (subst (dk-fact! 'matmul-matscale-left 'R 'n Adj 'A 'b))
    (subst (dk-fact! 'adj-mul 'R 'n 'A))
    (ladet-cr-tail! s1 Id d)))
  (dk-conj-close! (lambda () (ass))))
(ladet-done! 'cramer-inverse)
(topic! 'cramer-inverse 'algebra)
(gloss! 'cramer-inverse
  "Cramer's rule: if det(A) b = 1 then b adj(A) is a two-sided inverse of A (A over a commutative
   ring, (n+1)-square).  The notes' formula A^-1 = det(A)^-1 adj(A).")

;; ---- Prop 3.26
(sp (make-wff
  (forall-guarded '(R n A) '((IS-FIELD-RING R) (IN n NN) (IN A (MAT n n (CARR R))))
    '(IFF (IS-INVERTIBLE-MAT R n A) (NOT (= (DET R n A) (ZERO R)))))))
(dk-peel!)
(dk-project! '(IS-COMMUTATIVE-RING R) 'is-field-ring-def '(IS-FIELD-RING R))
(fact 'ladet-field-one-ne 'R)
(fact 'commutative-ring-is-ring 'R)
(fact 'det-in-carrier 'R 'n 'A)
(dk-iff! (dk-head? 'NOT)
  ;; invertible => det A /= 0: det A det V = det I = 1 /= 0
  (lambda ()
    (let* ((u (dk-landed-1 (lambda () (mac-h 'IS-INVERTIBLE-MAT '(IS-INVERTIBLE-MAT R n A)))))
           (V (dk-skolem! u)))
      (di)
      (let* ((dV (list 'DET 'R 'n V))
             (e1 (dk-fact! 'det-multiplicative 'R 'n 'A V)))
        (fact 'det-identity-ind 'R 'n)
        (fact 'det-in-carrier 'R 'n V)
        (fact 'ring-mul-zero-left 'R dV)
        (let* ((e2 (dk-rewrite-h! e1 (list 'MATMUL 'R 'A V) '(IDENTMAT R n)))
               (e3 (dk-rewrite-h! e2 '(DET R n (IDENTMAT R n)) '(ONE R)))
               (e4 (dk-rewrite-h! e3 '(DET R n A) '(ZERO R)))
               (e5 (dk-rewrite-h! e4 (list '(MUL R) '(ZERO R) dV) '(ZERO R))))
          (ai '(NOT (= (ONE R) (ZERO R))))))))
  ;; det A /= 0 => invertible: Cramer, with the inverse of det A in the field
  (lambda ()
    (use-em '(= n 0)
      (lambda ()
        (dk-rewrite-h! '(IN A (MAT n n (CARR R))) 'n 0)
        (subst '(= n 0))
        (ladet-nn! 0)
        (fact 'identmat-type 'R 0)
        (dk-have! '(= A (IDENTMAT R 0))
          (lambda ()
            (ladet-ext! 'A '(IDENTMAT R 0) 0 0 (lambda (i k)
              (ladet-absurd! (list (list '<= 1 i) (list '<= i 0)))))))
        (fact 'identmat-invertible 'R 0)
        (subst '(= A (IDENTMAT R 0)))
        (ass))
      (lambda ()
        (let* ((m (dk-skolem! (dk-fact! 'nn-nonzero-is-succ 'n)))
               (sm (list 'succ m)))
          (dk-rewrite-h! '(IN A (MAT n n (CARR R))) 'n sm)
          (dk-rewrite-h! '(NOT (= (DET R n A) (ZERO R))) 'n sm)
          (subst (list '= 'n sm))
          (fact 'nn-succ-closed m)
          (fact 'det-in-carrier 'R sm 'A)
          (let* ((dd (list 'DET 'R sm 'A))
                 (b (dk-skolem! (dk-fact! 'ladet-field-inverse 'R dd)))
                 (both (dk-fact! 'cramer-inverse 'R m 'A b)))
            (dk-split! both)
            (fact 'adj-type 'R m 'A)
            (fact 'matscale-type 'R sm sm b (list 'ADJ 'R m 'A))
            (fact 'inverse-is-invertible 'R sm (list 'MATSCALE 'R b (list 'ADJ 'R m 'A)) 'A)
            (ass)))))))
(ladet-done! 'invertible-iff-det-nonzero)
(topic! 'invertible-iff-det-nonzero 'algebra)
(gloss! 'invertible-iff-det-nonzero
  "Over a field, an n-by-n matrix is invertible iff its determinant is nonzero (linear-algebra 3.26).")
