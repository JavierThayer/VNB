;;; the notes' Corollary (3.23), in the notes' order of quantifiers
(define (ladet-tri-headline! kind ind)
  (sp (make-wff
    (forall-guarded '(R n D)
      (list '(IS-COMMUTATIVE-RING R) '(IN n NN) '(IN D (MAT n n (CARR R))) (list (ladet-tri-pred kind) 'R 'n 'D))
      (list '= '(DET R n D) (ladet-diag 'D 'n)))))
  (dk-peel!)
  (fact ind 'n 'R 'D)
  (ass))
(ladet-tri-headline! 'lower 'ladet-det-lower-ind)
(ladet-done! 'det-lower-triangular)
(topic! 'det-lower-triangular 'algebra)
(gloss! 'det-lower-triangular
  "The determinant of a lower triangular n-by-n matrix over a commutative ring is the
   product of its diagonal entries (linear-algebra 3.23).")
(ladet-tri-headline! 'upper 'ladet-det-upper-ind)
