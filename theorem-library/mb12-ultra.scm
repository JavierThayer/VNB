;;; =====================================================================
;;; Proposition A.16: convergence in (X^N, d_a) is eventual coordinatewise equality
;;; =====================================================================
(define mul-ev '(FORALL ck_ (IMPLIES (IN ck_ NN) (FORSOME cn_ (AND (IN cn_ NN)
                  (FORALL ci_ (IMPLIES (IN ci_ NN) (IMPLIES (<= cn_ ci_) (= ((zs ci_) ck_) (u ck_))))))))))
(define (mul-pre-agree n)
  (list 'FORSOME 'pN_ (list 'AND '(IN pN_ NN)
    (list 'FORALL 'pi_ (list 'IMPLIES '(IN pi_ NN) (list 'IMPLIES '(<= pN_ pi_)
      (list 'FORALL 'pj_ (list 'IMPLIES '(IN pj_ NN) (list 'IMPLIES (list '< 'pj_ n) '(= ((zs pi_) pj_) (u pj_)))))))))))
(define (mul-zs-hyps body)
  (list 'FORALL 'sx_ (list 'FORALL 'zs (list 'FORALL 'u
    (list 'IMPLIES '(IN zs (FUN NN (FUN NN sx_))) (list 'IMPLIES '(IN u (FUN NN sx_)) body))))))

;;; a finite prefix is eventually common (induction on its length)
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
   (mul-zs-hyps (list 'IMPLIES mul-ev (mul-pre-agree 'n)))))))
(define mul-br3 (dk-use-induction-fixed! '(sx_ zs u)))   ; W1C: the sequences and the coordinate hypothesis fixed
(dk-focus! (cdr (assq 'base mul-br3)))
(dk-peel!)
(dk-have! '(IN 0 NN) (lambda () (from-context!)))
(ew 0)
(dk-conj-close!
 (lambda ()
   (if (dk-head-is? (dk-goal) 'FORALL)
       (let* ((pl (dk-peel!))
              (j (cadr (car (filter (lambda (q) (and (dk-head-is? q '<) (equal? (caddr q) 0))) pl)))))
         (dk-have! '(< 0 0) (lambda () (dk-nn! (list '< j 0))))
         (ai (dk-cite! 'rr-lt-irrefl 0)))
       (ass))))
(dk-focus! (cdr (assq 'step mul-br3)))
(let* ((k (cdr (assq 'var mul-br3)))
       (ih (cdr (assq 'ih mul-br3)))
       (sk (list 'succ k)))
  (dk-peel!)
  (let* ((evh (dk-pick (lambda (h) (alpha-equiv? h mul-ev)) "the coordinate hypothesis"))
         (n1 (dk-skolem! ih))                   ; W1C: the IH is at the fixed sx_ zs u
         (c1 (dk-pick (lambda (h) (and (eq? (mul-head h) 'FORALL) (dk-contains? h n1))) "prefix clause"))
         (n2 (dk-skolem! (dk-apply! evh k)))
         (c2 (dk-pick (lambda (h) (and (eq? (mul-head h) 'FORALL) (dk-contains? h n2))) "coordinate clause"))
         (nn (list '+ n1 n2)))
    (mul-and! (list 'IN n1 'NN) (list 'IN n2 'NN))
    (fact 'nn-add-closed n1 n2)
    (ew nn)
    (dk-conj-close!
     (lambda ()
       (if (dk-head-is? (dk-goal) 'FORALL)
           (let* ((pl (dk-peel!))
                  (pl (if (any-pred (lambda (q) (dk-head-is? q '<)) pl) pl (append pl (dk-peel!))))
                  (i (caddr (car (filter (lambda (q) (dk-head-is? q '<=)) pl))))
                  (j (cadr (car (filter (lambda (q) (dk-head-is? q '<)) pl)))))
             (dk-have! (list '<= n1 i) (lambda () (dk-nn! (list '<= nn i))))
             (dk-have! (list '<= n2 i) (lambda () (dk-nn! (list '<= nn i))))
             (dk-cite! 'fun-apply-type-c 'zs 'NN '(FUN NN sx_) i)
             (dk-cite! 'fun-apply-type-c (list 'zs i) 'NN 'sx_ j)
             (dk-cite! 'fun-apply-type-c 'u 'NN 'sx_ j)
             (dk-cite! 'fun-apply-type-c (list 'zs i) 'NN 'sx_ k)
             (dk-cite! 'fun-apply-type-c 'u 'NN 'sx_ k)
             (use-em (list '= j k)
               (lambda ()
                 (dk-apply! c2 i)
                 (subst (list '= j k))
                 (ass))
               (lambda ()
                 (dk-have! (list '<= j k)
                   (lambda ()
                     (use-em (list '<= j k)
                       (lambda () (ass))
                       (lambda ()
                         (dk-cite! 'nn-not-le-succ-le j k)
                         (dk-have! '(< 0 0) (lambda () (dk-nn! (list '< j sk) (list '<= sk j))))
                         (ai (dk-cite! 'rr-lt-irrefl 0))))))
                 (mul-ne-flip! j k)
                 (dk-cite! 'nn-le-ne-succ j k)
                 (dk-have! (list '< j k) (lambda () (dk-nn! (list '<= (list 'succ j) k))))
                 (dk-apply! (dk-apply! c1 i) j)
                 (ass))))
           (ass))))))
(qed 'prefix-eventually-agrees)
(topic! 'prefix-eventually-agrees 'plumbing)

;; recip P(x, k) is a positive real (k in NN in context)
(define (mul-recip-facts! x k)
  (let ((P (mul-PP x k)))
    (mul-P-facts! x k)
    (dk-have! (list '< 0 P) (lambda () (dk-ineq! (list '<= 1 P) (list 'IN P 'RR))))
    (dk-have! (list 'NOT (list '= P 0))
      (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= P 0) (list '<= 1 P) (list 'IN P 'RR))))
                 (ai (dk-cite! 'rr-lt-irrefl 0))))
    (mul-and! (list 'IN P 'RR) (list 'NOT (list '= P 0)))
    (fact 'rr-recip-closed P)
    (dk-cite! 'rr-recip-pos P)
    (list 'recip P)))

;;; agreement below n puts y within 1 / P(a, y, n) of x
(sp (make-wff (mul-hyps-xy (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
   (list 'IMPLIES (mul-agree 'n) (list '<= (mul-D 'xs 'ys) (list 'recip (mul-PP 'ys 'n)))))))))
(dk-peel!)
(let* ((n (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) (dk-asms)))))
       (Rn (mul-recip-facts! 'ys n)))
  (mul-nonneg! 'xs 'ys)
  (use-em '(= xs ys)
    (lambda ()
      (dk-have! (list '= (mul-D 'xs 'ys) 0) (lambda () (subst '(= xs ys)) (dk-cite! 'prefix-dist-self 'a 'ys) (ass)))
      (dk-ineq! (list '= (mul-D 'xs 'ys) 0) (list '< 0 Rn) (list 'IN Rn 'RR) (list 'IN (mul-D 'xs 'ys) 'RR)))
    (lambda ()
      (let* ((m (mul-al-facts! 'xs 'ys))
             (agr (dk-pick (lambda (h) (alpha-equiv? h (mul-agree n))) "the agreement"))
             (Rm (mul-dval! 'xs 'ys)))
        (use-em (list '< m n)
          (lambda ()
            (mul-typed! 'xs m) (mul-typed! 'ys m)
            (dk-apply! agr m)
            (ai (list 'NOT (list '= (list 'xs m) (list 'ys m)))))
          (lambda ()
            (dk-cite! 'nn-not-lt-le m n)
            (mul-recip-le! 'xs n m)
            (dk-cite! 'prefix-prod-agree-ind n 'sx_ 'a 'xs 'ys)
            (dk-have! (list '<= Rm Rn) (lambda () (subst (list '= (mul-PP 'ys n) (mul-PP 'xs n))) (ass)))
            (dk-ineq! (list '= (mul-D 'xs 'ys) Rm) (list '<= Rm Rn) (list 'IN Rm 'RR) (list 'IN Rn 'RR)
                      (list 'IN (mul-D 'xs 'ys) 'RR))))))))
(qed 'prefix-dist-small)
(topic! 'prefix-dist-small 'analysis)

;;; a difference at index k keeps y at least 1 / P(a, y, k) away from x
(sp (make-wff (mul-hyps-xy (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
   (list 'IMPLIES '(NOT (= (xs k) (ys k))) (list '<= (list 'recip (mul-PP 'ys 'k)) (mul-D 'xs 'ys))))))))
(dk-peel!)
(let* ((k (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) (dk-asms)))))
       (Rk (mul-recip-facts! 'ys k)))
  (mul-typed! 'xs k) (mul-typed! 'ys k)
  (dk-have! '(NOT (= xs ys))
    (lambda () (di)
               (dk-have! (list '= (list 'xs k) (list 'ys k)) (lambda () (subst '(= xs ys)) (rfl)))
               (ai (list 'NOT (list '= (list 'xs k) (list 'ys k))))))
  (let* ((m (mul-al-facts! 'xs 'ys))
         (cm (mul-clause m))
         (Rm (mul-dval! 'xs 'ys)))
    (use-em (list '< k m)
      (lambda () (dk-apply! cm k) (ai (list 'NOT (list '= (list 'xs k) (list 'ys k)))))
      (lambda ()
        (dk-cite! 'nn-not-lt-le k m)
        (dk-cite! 'prefix-prod-agree-ind m 'sx_ 'a 'xs 'ys)
        (mul-recip-le! 'ys m k)
        (dk-have! (list '<= Rk Rm) (lambda () (subst (list '= (mul-PP 'xs m) (mul-PP 'ys m))) (ass)))
        (mul-nonneg! 'xs 'ys)
        (dk-ineq! (list '= (mul-D 'xs 'ys) Rm) (list '<= Rk Rm) (list 'IN Rm 'RR) (list 'IN Rk 'RR)
                  (list 'IN (mul-D 'xs 'ys) 'RR))))))
