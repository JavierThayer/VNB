 (lambda ()
   (let ((g (dk-goal)))
     (cond
      ((and (eq? (mul-head g) '=) (dk-head-is? (cadr g) 'LENGTH))
       (mac 'ULTRA-SEQ-MS) (len-r) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (vnb-guard (lambda () (arith)))))
      ((eq? (mul-head g) 'IS-METRIC)
       (mac 'is-metric)
       (let loop ((fuel 80))
         (let ((n (find-first (lambda (n) (let ((gg (dk-goal-of n))) (and (pair? gg) (memq (car gg) '(FORALL IMPLIES AND)))))
                              (dk-open-leaves))))
           (if (and n (> fuel 0)) (begin (dk-focus! n) (di) (loop (- fuel 1))))))
       (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (mul-law!)))) (dk-open-leaves)))
      (#t (ass))))))
(qed 'ultra-seq-is-metric-space)
