(define (mul-nonneg! u v)
  (if (not (dk-asm? (list 'IN (mul-D u v) 'RR)))
      (dk-split-all! (list (dk-cite! 'prefix-dist-nonneg 'sx_ 'a u v)))))
(define (mul-law!)
  (if (dk--redex? (dk-goal)) (dk-lam-b!))
  (let ((g (dk-goal)))
    (cond
     ((and (eq? (car g) '=) (equal? (caddr g) 0))
      (dk-cite! 'prefix-dist-self 'a (caddr (cadr g))) (ass))
     ((and (eq? (car g) '<=) (equal? (cadr g) 0))
      (let ((d (caddr g))) (mul-nonneg! (caddr d) (cadddr d)) (ass)))
     ((and (eq? (car g) '=) (symbol? (cadr g)) (symbol? (caddr g)))
      (let* ((u (cadr g)) (v (caddr g)))
        (mul-nonneg! u v)
        (if (not (dk-asm? (list '= (mul-D u v) 0)))
            (lam-b-h (car (filter (lambda (h) (and (eq? (mul-head h) '=) (equal? (caddr h) 0) (dk--redex? h))) (dk-asms)))))
        (use-em (list '= u v)
          (lambda () (ass))
          (lambda ()
            (let ((R (mul-dval! u v)))
              (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= (mul-D u v) 0) (list '= (mul-D u v) R) (list '< 0 R)
                                                      (list 'IN R 'RR) (list 'IN (mul-D u v) 'RR))))
              (ai (dk-cite! 'rr-lt-irrefl 0)))))))
     ((eq? (car g) '=)
      (let ((d (cadr g))) (dk-cite! 'prefix-dist-sym 'sx_ 'a (caddr d) (cadddr d)) (ass)))
     ((eq? (car g) '<=)
      (let* ((d1 (cadr g)) (u (caddr d1)) (w (cadddr d1)) (v (cadddr (cadr (caddr g))))
             (duv (mul-D u v)) (dvw (mul-D v w)) (s (list '+ duv dvw)))
        (mul-nonneg! u w) (mul-nonneg! u v) (mul-nonneg! v w)
        (dk-cite! 'prefix-dist-ultra 'sx_ 'a u w v)
        (dk-have! (list '<= duv s) (lambda () (dk-ineq! (list '<= 0 dvw) (list 'IN duv 'RR) (list 'IN dvw 'RR))))
        (dk-have! (list '<= dvw s) (lambda () (dk-ineq! (list '<= 0 duv) (list 'IN duv 'RR) (list 'IN dvw 'RR))))
        (dk-cite! 'rr-add-in-rr duv dvw)
        (dk-cite! 'rr-max-le duv dvw s)
        (dk-cite! 'rr-max-closed duv dvw)
        (dk-ineq! (list '<= d1 (list 'MAX duv dvw)) (list '<= (list 'MAX duv dvw) s)
                  (list 'IN d1 'RR) (list 'IN duv 'RR) (list 'IN dvw 'RR) (list 'IN (list 'MAX duv dvw) 'RR))))
     (#t (error "mul-law!: unexpected leaf" g)))))

(sp (make-wff (mul-space-hyps (list 'IS-METRIC-SPACE mul-S))))
(dk-peel!)
(mul-fset!)
(dk-cite! 'ultra-seq-lam-type 'sx_ 'a)
(dk-cite! 'ultra-seq-pts 'sx_ 'a)
(dk-cite! 'ultra-seq-dist-fun 'sx_ 'a)
(mac 'IS-METRIC-SPACE)
(dk-isx-set!)   ; W1J-C: the conjunct t in SET, from the typings
(subst (list '== (list 'PTS mul-S) mul-FS))
(subst (list '== (list 'DIST mul-S) mul-lam))
