;;; ---- Proposition A.16 ----
(define mul-div '(FORALL dvz_ (IMPLIES (IN dvz_ (FUN NN sx_)) (FORALL dvm_ (IMPLIES (IN dvm_ RR)
                   (FORSOME dvn_ (AND (IN dvn_ NN) (< dvm_ (PREFIX-PROD a dvz_ dvn_)))))))))
(define (mul-dist-eq! zi)                ; land dist_S(zi, u) = D(zi, u) and the typings; return the applied distance
  (let ((dd (list (list 'DIST mul-S) zi 'u)))
    (mul-nonneg! zi 'u)
    (dk-cite! 'ultra-seq-dist-apply 'sx_ 'a zi 'u)
    (dk-have! (list 'IN dd 'RR) (lambda () (subst (list '= dd (mul-D zi 'u))) (ass)))
    dd))

(sp (make-wff (list 'FORALL 'sx_ (list 'FORALL 'a
   (list 'IMPLIES '(IN sx_ SET) (list 'IMPLIES '(IN a (FUN sx_ RR)) (list 'IMPLIES mul-wt (list 'IMPLIES mul-div
     (list 'FORALL 'zs (list 'IMPLIES (list 'IN 'zs (list 'FUN 'NN mul-FS))
       (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u mul-FS)
         (list 'IFF (list 'CONVERGES-TO mul-S 'zs 'u) mul-ev)))))))))))))
(dk-peel!)
(dk-cite! 'ultra-seq-is-metric-space 'sx_ 'a)
(dk-cite! 'ultra-seq-pts 'sx_ 'a)
(define (mul-zi! i)
  (dk-cite! 'fun-apply-type-c 'zs 'NN mul-FS i)
  (list 'zs i))
(dk-iff! (dk-head? 'FORALL)
  ;; convergence => eventual coordinatewise equality
  (lambda ()
    (dk-split-all! (dk-landed (lambda () (mac-h 'converges-to (list 'CONVERGES-TO mul-S 'zs 'u)))))
    (let* ((cl (dk-pick (lambda (h) (and (eq? (mul-head h) 'FORALL) (dk-contains? h 'POS-RR))) "the eps clause"))
           (k (mul-nn-var (dk-peel!)))
           (R (mul-recip-facts! 'u k))
           (eps (list '* 1/2 R)))
      (dk-have! '(IN 1/2 RR) (lambda () (arith)))
      (dk-cite! 'rr-mul-in-rr 1/2 R)
      (dk-have! (list '< 0 eps) (lambda () (dk-ineq! (list '< 0 R) (list 'IN R 'RR))))
      (fact 'rr-pos-rr-of-lt eps)
      (let* ((n (dk-skolem! (dk-apply! cl eps)))
             (ncl (dk-pick (lambda (h) (and (eq? (mul-head h) 'FORALL) (dk-contains? h n))) "the threshold clause")))
        (ew n)
        (dk-conj-close!
         (lambda ()
           (if (not (dk-head-is? (dk-goal) 'FORALL))
               (ass)
               (let* ((i (mul-nn-var (dk-peel!)))
                      (zi (mul-zi! i))
                      (dd (mul-dist-eq! zi)))
                 (dk-apply! ncl i)
                 (mul-typed! zi k) (mul-typed! 'u k)
                 (use-em (list '= (list zi k) (list 'u k))
                   (lambda () (ass))
                   (lambda ()
                     (dk-cite! 'prefix-dist-large 'sx_ 'a zi 'u k)
                     (dk-have! '(< 0 0)
                       (lambda () (dk-ineq! (list '<= dd eps) (list '= dd (mul-D zi 'u)) (list '<= R (mul-D zi 'u)) (list '< 0 R)
                                            (list 'IN R 'RR) (list 'IN dd 'RR) (list 'IN (mul-D zi 'u) 'RR))))
                     (ai (dk-cite! 'rr-lt-irrefl 0)))))))))))
  ;; eventual coordinatewise equality => convergence
  (lambda ()
    (mac 'converges-to)
    (subst (list '== (list 'PTS mul-S) mul-FS))
    (dk-conj-close!
     (lambda ()
       (if (not (dk-head-is? (dk-goal) 'FORALL))
           (ass)
           (let* ((pe (dk-peel!))
                  (e (cadr (car (filter (lambda (q) (eq? (mul-head q) 'POS-RR)) pe)))))
             (fact 'rr-pos-rr-in-rr e)
             (fact 'rr-lt-of-pos-rr e)
             (dk-have! (list 'NOT (list '= e 0))
               (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= e 0) (list '< 0 e) (list 'IN e 'RR))))
                          (ai (dk-cite! 'rr-lt-irrefl 0))))
             (mul-and! (list 'IN e 'RR) (list 'NOT (list '= e 0)))
             (fact 'rr-recip-closed e)
             (let* ((re (list 'recip e))
                    (divh (dk-pick (lambda (h) (alpha-equiv? h mul-div)) "the divergence hypothesis"))
                    (n (dk-skolem! (dk-apply! (dk-apply! divh 'u) re)))
                    (Pn (mul-PP 'u n))
                    (Rn (mul-recip-facts! 'u n))
                    (nN (dk-skolem! (dk-cite! 'prefix-eventually-agrees n 'sx_ 'zs 'u)))
                    (ncl (dk-pick (lambda (h) (and (eq? (mul-head h) 'FORALL) (dk-contains? h nN))) "the prefix threshold")))
               (dk-cite! 'rr-recip-pos e)
               (dk-have! (list '<= re Pn) (lambda () (dk-ineq! (list '< re Pn) (list 'IN re 'RR) (list 'IN Pn 'RR))))
               (dk-cite! 'rr-recip-antitone re Pn)
               (dk-cite! 'rr-recip-recip-pos e)
               (dk-have! (list 'IN (list 'recip re) 'RR) (lambda () (subst (list '= (list 'recip re) e)) (ass)))
               (ew nN)
               (dk-conj-close!
                (lambda ()
                  (if (not (dk-head-is? (dk-goal) 'FORALL))
                      (ass)
                      (let* ((i (mul-nn-var (dk-peel!)))
                             (zi (mul-zi! i))
                             (dd (mul-dist-eq! zi)))
                        (dk-apply! ncl i)
                        (dk-cite! 'prefix-dist-small 'sx_ 'a zi 'u n)
                        (dk-ineq! (list '= dd (mul-D zi 'u)) (list '<= (mul-D zi 'u) Rn) (list '<= Rn (list 'recip re))
                                  (list '= (list 'recip re) e)
                                  (list 'IN dd 'RR) (list 'IN (mul-D zi 'u) 'RR) (list 'IN Rn 'RR) (list 'IN e 'RR)
                                  (list 'IN (list 'recip re) 'RR)))))))))))))
(qed 'ultra-seq-converges-iff)
