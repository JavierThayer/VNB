;;; the distance of the space, applied
(sp (make-wff (mul-space-hyps (list 'FORALL 'xs (list 'IMPLIES (list 'IN 'xs mul-FS) (list 'FORALL 'ys (list 'IMPLIES (list 'IN 'ys mul-FS)
   (list '= (list (list 'DIST mul-S) 'xs 'ys) (mul-D 'xs 'ys)))))))))
