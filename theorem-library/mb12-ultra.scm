  (dk-have! (list 'IN (list 'CARTESIAN mul-FS mul-FS) 'SET)
    (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))))

(sp (make-wff (mul-space-hyps (list 'IN mul-lam (list 'FUN (list 'CARTESIAN mul-FS mul-FS) 'RR)))))
(dk-peel!)
(mul-fset!)
(for-each
 (lambda (kn)
   (if (not (sequent-node-grounded? kn))
