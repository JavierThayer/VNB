;;; mb12-ultra.scm -- the weighted prefix ultrametric on X^N (construction-of-measures,
;;; Appendix A.3: (419), Propositions A.15 and A.16).  Helper prefix: mul-.
;;; Agent ISOM (brief M-B1B2), 2026-10-26.
;;;
;;;   ultra-seq-is-metric-space, ultra-seq-is-ultrametric        (A.15)
;;;   ultra-seq-converges-iff                                     (A.16)
;;;   and the bricks: prefix-prod-ge-one(-ind), prefix-prod-mono, prefix-prod-agree-ind,
;;;   seqs-differ-somewhere, agree-length-prop, agree-length-sym, prefix-dist-self / -value /
;;;   -nonneg / -sym / -ultra / -small / -large, prefix-eventually-agrees, ultra-seq-*.
;;;
;;; A.15 needs only a_w > 1 (the divergence hypothesis (418) is not used); A.16 carries (418)
;;; as the hypothesis "for every sequence z and real M some prefix product exceeds M".
;;;
;;; WINDOW.  Citations: nn-least-element, nn-monotone-step-implies-le
;;; (monotone-convergence-proof), rr-recip-antitone (sequential-continuity), rr-max-*,
;;; rr-recip-recip-pos (r-exp, load.scm 3347, the latest).  lo = after r-exp.scm
;;; and mb12-vocab.scm; hi = none.  Library: analysis.  Vocabulary: mb12-vocab.scm
;;; (PREFIX-PROD, AGREE-LENGTH, PREFIX-DIST, ULTRA-SEQ-MS, IS-ULTRAMETRIC).

(define (mul-head g) (and (pair? g) (car g)))
(define (mul-nn-var pl)
  (cadr (car (filter (lambda (q) (and (eq? (mul-head q) 'IN) (eq? (caddr q) 'NN))) pl))))
(define (mul-and! a b)
  (dk-have! (list 'AND a b)))
;; the weight hypotheses, as the statements carry them
(define mul-wt '(FORALL w (IMPLIES (IN w sx_) (< 1 (a w)))))
(define (mul-P k) (list 'PREFIX-PROD 'a 'xs k))
(define (mul-hyps body)
  (list 'FORALL 'sx_ (list 'FORALL 'a (list 'FORALL 'xs
    (list 'IMPLIES '(IN a (FUN sx_ RR)) (list 'IMPLIES mul-wt (list 'IMPLIES '(IN xs (FUN NN sx_)) body)))))))
;; q = a(xs(k)) is real and > 1, for k in NN in context
(define (mul-weight! k)
  (let* ((xk (list 'xs k)) (q (list 'a xk)))
    (dk-cite! 'fun-apply-type-c 'xs 'NN 'sx_ k)
    (dk-cite! 'fun-apply-type-c 'a 'sx_ 'RR xk)
    (dk-apply! (dk-pick (lambda (h) (and (eq? (mul-head h) 'FORALL) (alpha-equiv? h mul-wt))) "the weight bound") xk)
    q))

;;; ---- 1 <= PREFIX-PROD(a, x, n), by induction on n ----
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
   (mul-hyps (list 'AND (list 'IN (mul-P 'n) 'RR) (list '<= 1 (mul-P 'n))))))))
(define mul-br (dk-use-induction-fixed! '(sx_ a xs)))   ; W1C: the weight and the sequence fixed
(dk-focus! (cdr (assq 'base mul-br)))
(dk-peel!)
(mac 'prefix-prod-zero)
(dk-conj-close! (lambda () (arith)))
(dk-focus! (cdr (assq 'step mul-br)))
(let* ((k (cdr (assq 'var mul-br)))
       (ih (cdr (assq 'ih mul-br))))
  (dk-peel!)
  (dk-split-all! (list ih))                ; W1C: the IH is at the fixed sx_ a xs
  (let* ((q (mul-weight! k))
         (P (mul-P k)))
    (fact 'prefix-prod-succ 'a 'xs k)
    (subst (list '== (mul-P (list 'succ k)) (list '* P q)))
    (dk-have! (list 'IN q 'RR))
    (mul-and! (list 'IN P 'RR) (list 'IN q 'RR))
    (fact 'rr-mul-closed P q)
    (dk-have! (list '<= 0 q) (lambda () (dk-ineq! (list '< 1 q) (list 'IN q 'RR))))
    (dk-have! (list '<= 1 P))
    (dk-cite! 'rr-mul-le-right 1 P q)
    (dk-conj-close!
     (lambda ()
       (if (dk-head-is? (dk-goal) 'IN)
           (ass)
           (dk-ineq! (list '<= (list '* 1 q) (list '* P q)) (list '< 1 q)
                     (list 'IN q 'RR) (list 'IN P 'RR) (list 'IN (list '* P q) 'RR)))))))
(qed 'prefix-prod-ge-one-ind)
(topic! 'prefix-prod-ge-one-ind 'plumbing)

(sp (make-wff (mul-hyps (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'AND (list 'IN (mul-P 'n) 'RR) (list '<= 1 (mul-P 'n))))))))
(dk-peel!)
(begin
  (dk-split-all! (list (dk-cite! 'prefix-prod-ge-one-ind (mul-nn-var (dk-asms)) 'sx_ 'a 'xs)))
  (dk-conj-close! (lambda () (ass))))
(qed 'prefix-prod-ge-one)
(topic! 'prefix-prod-ge-one 'analysis)

;; P(a, xs, k) in RR and 1 <= it, for k in NN in context
(define (mul-P-facts! xs k)
  (if (not (and (dk-asm? (list 'IN (list 'PREFIX-PROD 'a xs k) 'RR)) (dk-asm? (list '<= 1 (list 'PREFIX-PROD 'a xs k)))))
      (let ((u (dk-cite! 'prefix-prod-ge-one 'sx_ 'a xs)))
        (dk-split-all! (list (dk-apply! u k))))))

;;; ---- the prefix product is monotone in n ----
(define mul-f '(VNB-LAMBDA mpk_ NN (PREFIX-PROD a xs mpk_)))
(sp (make-wff (mul-hyps (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
   (list 'IMPLIES '(<= m n) (list '<= (mul-P 'm) (mul-P 'n))))))))))
(dk-peel!)
(dk-have! (list 'IN mul-f '(FUN NN RR))
  (lambda ()
    (dk-lam-type!
     (lambda ()
       (let ((v (mul-nn-var (dk-peel!))))
         (mul-P-facts! 'xs v)
         (ass))))))
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list mul-f 'k) (list mul-f '(succ k)))))
  (lambda ()
    (let* ((k (mul-nn-var (dk-peel!)))
           (P (mul-P k)))
      (dk-cite! 'nn-succ-closed k)
      (dk-lam-b!)
      (mul-P-facts! 'xs k)
      (let ((q (mul-weight! k)))
        (fact 'prefix-prod-succ 'a 'xs k)
        (subst (list '== (mul-P (list 'succ k)) (list '* P q)))
        (dk-have! (list '<= 0 P) (lambda () (dk-ineq! (list '<= 1 P) (list 'IN P 'RR))))
        (dk-have! (list '<= 1 q) (lambda () (dk-ineq! (list '< 1 q) (list 'IN q 'RR))))
        (dk-cite! 'rr-mul-le-right 1 q P)
        (mul-and! (list 'IN q 'RR) (list 'IN P 'RR))
        (fact 'rr-mul-comm q P)
        (fact 'rr-mul-closed q P)
        (mul-and! (list 'IN P 'RR) (list 'IN q 'RR))
        (fact 'rr-mul-closed P q)
        (dk-ineq! (list '<= (list '* 1 P) (list '* q P)) (list '= (list '* q P) (list '* P q))
                  (list 'IN q 'RR) (list 'IN P 'RR) (list 'IN (list '* q P) 'RR) (list 'IN (list '* P q) 'RR))))))
(let* ((asms (dk-asms))
       (le (car (filter (lambda (h) (and (eq? (mul-head h) '<=) (symbol? (cadr h)) (symbol? (caddr h)))) asms)))
       (m (cadr le)) (n (caddr le))
       (mono (dk-cite! 'nn-monotone-step-implies-le mul-f))
       (r (dk-apply! mono n m)))
  (dk-lam-b-h! r)
  (ass))
(qed 'prefix-prod-mono)
(topic! 'prefix-prod-mono 'analysis)

;;; ---- the prefix product sees only the prefix ----
(define (mul-agree-s n j u v) (list 'FORALL j (list 'IMPLIES (list 'IN j 'NN) (list 'IMPLIES (list '< j n) (list '= (list u j) (list v j))))))
(define (mul-agree-b n j) (mul-agree-s n j 'xs 'ys))
(define (mul-agree n) (mul-agree-b n 'j))
(define (mul-hyps2 body)
  (list 'FORALL 'sx_ (list 'FORALL 'a (list 'FORALL 'xs (list 'FORALL 'ys
    (list 'IMPLIES '(IN a (FUN sx_ RR)) (list 'IMPLIES mul-wt (list 'IMPLIES '(IN xs (FUN NN sx_))
      (list 'IMPLIES '(IN ys (FUN NN sx_)) body)))))))))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
   (mul-hyps2 (list 'IMPLIES (mul-agree 'n) (list '= (mul-P 'n) '(PREFIX-PROD a ys n))))))))
(define mul-br2 (dk-use-induction-fixed! '(sx_ a xs ys)))   ; W1C: the weight and both sequences fixed
(dk-focus! (cdr (assq 'base mul-br2)))
(dk-peel!)
(mac 'prefix-prod-zero)
(arith)
(dk-focus! (cdr (assq 'step mul-br2)))
(let* ((k (cdr (assq 'var mul-br2)))
       (ih (cdr (assq 'ih mul-br2)))
       (sk (list 'succ k)))
  (dk-peel!)
  (dk-cite! 'nn-succ-closed k)
  (let ((agr (dk-pick (lambda (h) (and (eq? (mul-head h) 'FORALL) (dk-contains? h sk) (dk-contains? h 'ys))) "agreement below succ k")))
    (dk-have! (mul-agree-b k 'agi_)
      (lambda ()
        (let* ((pl (dk-peel!))
               (j (mul-nn-var pl)))
          (dk-have! (list '< j sk) (lambda () (dk-nn! (list '< j k))))
          (dk-apply! agr j)
          (ass))))
    (dk-have! (list '< k sk) (lambda () (dk-nn!)))
    (dk-apply! agr k)
    (detach! ih)                              ; W1C: was (dk-apply! ih 'sx_ 'a 'xs 'ys)
    (mul-P-facts! 'xs k)
    (mul-P-facts! 'ys k)
    (let ((qx (mul-weight! k)))
      (fact 'prefix-prod-succ 'a 'xs k)
      (fact 'prefix-prod-succ 'a 'ys k)
      (subst (list '== (mul-P sk) (list '* (mul-P k) qx)))
      (subst (list '== (list 'PREFIX-PROD 'a 'ys sk) (list '* (list 'PREFIX-PROD 'a 'ys k) (list 'a (list 'ys k)))))
      (subst (list '= (mul-P k) (list 'PREFIX-PROD 'a 'ys k)))
      (subst (list '= (list 'xs k) (list 'ys k)))
      (dk-cite! 'fun-apply-type-c 'ys 'NN 'sx_ k)
      (dk-cite! 'fun-apply-type-c 'a 'sx_ 'RR (list 'ys k))
      (mul-and! (list 'IN (list 'PREFIX-PROD 'a 'ys k) 'RR) (list 'IN (list 'a (list 'ys k)) 'RR))
      (fact 'rr-mul-closed (list 'PREFIX-PROD 'a 'ys k) (list 'a (list 'ys k)))
      (rfl))))
(qed 'prefix-prod-agree-ind)
(topic! 'prefix-prod-agree-ind 'plumbing)

;;; ---- two different sequences differ at some index ----
(define mul-seqs-hyp (lambda (body)
  (list 'FORALL 'sx_ (list 'FORALL 'xs (list 'FORALL 'ys
    (list 'IMPLIES '(IN xs (FUN NN sx_)) (list 'IMPLIES '(IN ys (FUN NN sx_)) body)))))))
(define mul-ex-diff '(FORSOME dk_ (AND (IN dk_ NN) (NOT (= (xs dk_) (ys dk_))))))
(sp (make-wff (mul-seqs-hyp (list 'IMPLIES '(NOT (= xs ys)) mul-ex-diff))))
(dk-peel!)
(use-em mul-ex-diff
  (lambda () (ass))
  (lambda ()
    (dk-have! '(= xs ys)
      (lambda ()
        (dk-fun-ext! 'xs 'ys 'NN 'sx_ #f #f
          (lambda (v)
            (dk-cite! 'fun-apply-type-c 'xs 'NN 'sx_ v)
            (dk-cite! 'fun-apply-type-c 'ys 'NN 'sx_ v)
            (use-em (list '= (list 'xs v) (list 'ys v))
              (lambda () (ass))
              (lambda ()
                (dk-have! mul-ex-diff (lambda () (ew v) (dk-conj-close! (lambda () (ass)))))
                (ai (list 'NOT mul-ex-diff))))))))
    (ai '(NOT (= xs ys)))))
(qed 'seqs-differ-somewhere)
(topic! 'seqs-differ-somewhere 'plumbing)

;;; ---- AGREE-LENGTH: the least index of difference ----
(define (mul-P-al k) (list 'AND (list 'IN k 'NN)
                       (list 'AND (list 'NOT (list '= (list 'xs k) (list 'ys k)))
                             (list 'FORALL 'alj_ (list 'IMPLIES '(IN alj_ NN) (list 'IMPLIES (list '< 'alj_ k) '(= (xs alj_) (ys alj_))))))))
(define mul-T '(SEP tdk_ NN (NOT (= (xs tdk_) (ys tdk_)))))
;; uniqueness: y with the property equals the least index of difference m
;; (m in NN, NOT xs m = ys m, and minimality MC over mul-T are in context)
(define (mul-al-unique! y m mc)
  (let ((py (dk-ctx-form (mul-P-al y))))
    (if py (dk-split-all! (list py)))
    (let ((cy (dk-pick (lambda (h) (and (eq? (mul-head h) 'FORALL) (dk-contains? h y) (dk-contains? h 'xs))) "clause of y")))
      (use-em (list '< y m)
        (lambda ()
          (dk-have! (list 'IN y mul-T) (lambda () (in-sep! (lambda () (ass)))))
          (dk-apply! mc y)
          (dk-have! '(< 0 0) (lambda () (dk-nn! (list '< y m) (list '<= m y))))
          (ai (dk-cite! 'rr-lt-irrefl 0)))
        (lambda ()
          (dk-cite! 'nn-not-lt-le y m)
          (use-em (list '< m y)
            (lambda () (dk-apply! cy m) (ai (list 'NOT (list '= (list 'xs m) (list 'ys m)))))
            (lambda ()
              (dk-cite! 'nn-not-lt-le m y)
              (if (alpha-equiv? (dk-goal) (list '= y m))
                  (dk-cite! 'nn-le-antisym y m)
                  (dk-cite! 'nn-le-antisym m y))
              (ass))))))))

(sp (make-wff (mul-seqs-hyp (list 'IMPLIES '(NOT (= xs ys)) (mul-P-al '(AGREE-LENGTH xs ys))))))
(dk-peel!)
(mac 'AGREE-LENGTH)
(define mul-io (cadr (cadr (dk-goal))))
(for-each
 (lambda (l)
   (dk-focus! l)
   (if (dk-head-is? (dk-goal) 'FORSOME)
       (begin
         ;; the least index of difference
         (dk-cite! 'seqs-differ-somewhere 'sx_ 'xs 'ys)
         (let ((k0 (dk-skolem! (dk-pick (lambda (h) (alpha-equiv? h mul-ex-diff)) "a difference"))))
           (dk-have! (list 'SUBSET mul-T 'NN)
             (lambda () (mac 'subset-def)
                        (let ((v (cadr (car (filter (lambda (q) (eq? (mul-head q) 'IN)) (dk-peel!))))))
                          (sep-me (list 'IN v mul-T)) (ass))))
           (dk-have! (list 'IN k0 mul-T) (lambda () (in-sep! (lambda () (ass)))))
           (dk-have! (list 'FORSOME 'tn_ (list 'IN 'tn_ mul-T)) (lambda () (ew k0) (ass)))
           (mul-and! (list 'SUBSET mul-T 'NN) (list 'FORSOME 'tn_ (list 'IN 'tn_ mul-T)))
           (let* ((ex (dk-cite! 'nn-least-element mul-T))
                  (m (dk-skolem! ex))
                  (mc (dk-pick (lambda (h) (and (eq? (mul-head h) 'FORALL) (dk-contains? h m) (dk-contains? h 'tdk_))) "minimality")))
             (dk-have! (list 'IN m 'NN) (lambda () (sep-me (list 'IN m mul-T)) (ass)))
             (dk-have! (list 'NOT (list '= (list 'xs m) (list 'ys m)))
               (lambda () (sep-me (list 'IN m mul-T)) (ass)))
             (ew m)
             (dk-conj-close!
              (lambda ()
                (cond
                 ((dk-head-is? (dk-goal) 'FORALL)
                  (let* ((uniq? (dk-contains? (dk-goal) 'AND))
                         (yv (cadr (dk-goal)))
                         (pl (dk-peel!)))
                    (if (not uniq?)
                        ;; j < m  =>  xs j = ys j
                        (let ((j (mul-nn-var pl)))
                          (use-em (list '= (list 'xs j) (list 'ys j))
                            (lambda () (ass))
                            (lambda ()
                              (dk-have! (list 'IN j mul-T) (lambda () (in-sep! (lambda () (ass)))))
                              (dk-apply! mc j)
                              (dk-have! '(< 0 0) (lambda () (dk-nn! (list '< j m) (list '<= m j))))
                              (ai (dk-cite! 'rr-lt-irrefl 0)))))
                        ;; uniqueness
                        (let ((y (if (memq yv (free-vars (dk-goal))) yv (cadr (dk-goal)))))
                          (mul-al-unique! y m mc)))))
                 (#t (ass))))))))
       (ass)))
 (dk-opened (lambda () (iota-d mul-io))))
(qed 'agree-length-prop)
(topic! 'agree-length-prop 'analysis)

;;; =====================================================================
;;; The distance (419)
;;; =====================================================================
(define (mul-D x y) (list 'PREFIX-DIST 'a x y))
(define (mul-AL x y) (list 'AGREE-LENGTH x y))
(define (mul-PP x k) (list 'PREFIX-PROD 'a x k))
(define (mul-hyps-xy body) (mul-hyps2 body))
;; facts at x /= y (NOT (= x y) in context, x y typed): returns the agree length term
(define (mul-al-facts! x y)
  (dk-split-all! (list (dk-cite! 'agree-length-prop 'sx_ x y)))
  (mul-AL x y))

;;; D(x, x) = 0
(sp (make-wff (list 'FORALL 'a (list 'FORALL 'xs (list '= (mul-D 'xs 'xs) 0)))))
(dk-peel!)
(mac 'PREFIX-DIST)
(dk-if-branch! #t (cadr (dk-goal)) (lambda () (rfl)) (lambda () (arith)))
(qed 'prefix-dist-self)
(topic! 'prefix-dist-self 'plumbing)

;;; x /= y: D(x, y) = 1 / P(a, x, m(x, y)), a positive real
(define mul-alxy '(AGREE-LENGTH xs ys))
(define mul-R (list 'recip (mul-PP 'xs mul-alxy)))
(sp (make-wff (mul-hyps-xy (list 'IMPLIES '(NOT (= xs ys))
   (list 'AND (list '= (mul-D 'xs 'ys) mul-R) (list 'AND (list 'IN mul-R 'RR) (list '< 0 mul-R)))))))
(dk-peel!)
(mul-al-facts! 'xs 'ys)
(let* ((P (mul-PP 'xs mul-alxy)))
  (mul-P-facts! 'xs mul-alxy)
  (dk-have! (list '< 0 P) (lambda () (dk-ineq! (list '<= 1 P) (list 'IN P 'RR))))
  (dk-have! (list 'NOT (list '= P 0))
    (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= P 0) (list '<= 1 P) (list 'IN P 'RR))))
               (ai (dk-cite! 'rr-lt-irrefl 0))))
  (mul-and! (list 'IN P 'RR) (list 'NOT (list '= P 0)))
  (fact 'rr-recip-closed P)
  (dk-cite! 'rr-recip-pos P)
  (dk-conj-close!
   (lambda ()
     (if (dk-head-is? (dk-goal) '=)
         (begin
           (mac 'PREFIX-DIST)
           (dk-if-branch! #f (cadr (dk-goal)) #f (lambda () (rfl))))
         (ass)))))
(qed 'prefix-dist-value)
(topic! 'prefix-dist-value 'analysis)

;;; D(x, y) is a real >= 0
(sp (make-wff (mul-hyps-xy (list 'AND (list 'IN (mul-D 'xs 'ys) 'RR) (list '<= 0 (mul-D 'xs 'ys))))))
(dk-peel!)
(use-em '(= xs ys)
  (lambda ()
    (subst '(= xs ys))
    (dk-cite! 'prefix-dist-self 'a 'ys)
    (subst (list '= (mul-D 'ys 'ys) 0))
    (dk-conj-close! (lambda () (arith))))
  (lambda ()
    (dk-split-all! (list (dk-cite! 'prefix-dist-value 'sx_ 'a 'xs 'ys)))
    (subst (list '= (mul-D 'xs 'ys) mul-R))
    (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass) (dk-ineq! (list '< 0 mul-R) (list 'IN mul-R 'RR)))))))
(qed 'prefix-dist-nonneg)
(topic! 'prefix-dist-nonneg 'plumbing)

;;; ---- symmetry ----
(define (mul-flip! u v)                 ; (= u v) in context, u v typed: land (= v u)
  (dk-have! (list '= v u) (lambda () (subst (list '= u v)) (rfl))))
(define (mul-typed! s j) (dk-cite! 'fun-apply-type-c s 'NN 'sx_ j))
(define (mul-ne-flip! x y)              ; (NOT (= x y)) in context: land (NOT (= y x))
  (dk-have! (list 'NOT (list '= y x))
    (lambda () (di) (dk-have! (list '= x y) (lambda () (subst (list '= y x)) (rfl)))
               (ai (list 'NOT (list '= x y))))))

(sp (make-wff (mul-seqs-hyp (list 'IMPLIES '(NOT (= xs ys)) (list '= (mul-AL 'xs 'ys) (mul-AL 'ys 'xs))))))
(dk-peel!)
(mul-ne-flip! 'xs 'ys)
(let* ((m (mul-al-facts! 'xs 'ys))
       (m2 (mul-al-facts! 'ys 'xs))
       (c1 (dk-pick (lambda (h) (and (eq? (mul-head h) 'FORALL) (dk-contains? h m))) "clause xs ys"))
       (c2 (dk-pick (lambda (h) (and (eq? (mul-head h) 'FORALL) (dk-contains? h m2))) "clause ys xs")))
  (use-em (list '< m m2)
    (lambda ()
      (mul-typed! 'xs m) (mul-typed! 'ys m)
      (dk-apply! c2 m)
      (mul-flip! (list 'ys m) (list 'xs m))
      (ai (list 'NOT (list '= (list 'xs m) (list 'ys m)))))
    (lambda ()
      (dk-cite! 'nn-not-lt-le m m2)
      (use-em (list '< m2 m)
        (lambda ()
          (mul-typed! 'xs m2) (mul-typed! 'ys m2)
          (dk-apply! c1 m2)
          (mul-flip! (list 'xs m2) (list 'ys m2))
          (ai (list 'NOT (list '= (list 'ys m2) (list 'xs m2)))))
        (lambda ()
          (dk-cite! 'nn-not-lt-le m2 m)
          (dk-cite! 'nn-le-antisym m m2)
          (ass))))))
(qed 'agree-length-sym)
(topic! 'agree-length-sym 'plumbing)

(sp (make-wff (mul-hyps-xy (list '= (mul-D 'xs 'ys) (mul-D 'ys 'xs)))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'prefix-dist-nonneg 'sx_ 'a 'ys 'ys)))
(use-em '(= xs ys)
  (lambda () (subst '(= xs ys)) (rfl))
  (lambda ()
    (mul-ne-flip! 'xs 'ys)
    (let ((m (mul-al-facts! 'xs 'ys)))
      (dk-split-all! (list (dk-cite! 'prefix-dist-value 'sx_ 'a 'xs 'ys)))
      (dk-split-all! (list (dk-cite! 'prefix-dist-value 'sx_ 'a 'ys 'xs)))
      (dk-cite! 'agree-length-sym 'sx_ 'xs 'ys)
      (dk-cite! 'prefix-prod-agree-ind m 'sx_ 'a 'xs 'ys)
      (subst (list '= (mul-D 'xs 'ys) (list 'recip (mul-PP 'xs m))))
      (subst (list '= (mul-D 'ys 'xs) (list 'recip (mul-PP 'ys (mul-AL 'ys 'xs)))))
      (subst (list '= (mul-AL 'ys 'xs) m))
      (subst (list '= (mul-PP 'ys m) (mul-PP 'xs m)))
      (rfl))))
(qed 'prefix-dist-sym)
(topic! 'prefix-dist-sym 'analysis)

;;; ---- the ultrametric inequality ----
(define (mul-hyps3 body)
  (list 'FORALL 'sx_ (list 'FORALL 'a (list 'FORALL 'xs (list 'FORALL 'ys (list 'FORALL 'zs
    (list 'IMPLIES '(IN a (FUN sx_ RR)) (list 'IMPLIES mul-wt (list 'IMPLIES '(IN xs (FUN NN sx_))
      (list 'IMPLIES '(IN ys (FUN NN sx_)) (list 'IMPLIES '(IN zs (FUN NN sx_)) body)))))))))))
(define (mul-clause m)
  (dk-pick (lambda (h) (and (eq? (mul-head h) 'FORALL) (eq? (cadr h) 'alj_) (dk-contains? h m))) "the agreement clause"))
(define (mul-dval! x y)                ; x /= y: land D(x,y) = recip P(x, m(x,y)) and its facts; return the recip term
  (dk-split-all! (list (dk-cite! 'prefix-dist-value 'sx_ 'a x y)))
  (list 'recip (mul-PP x (mul-AL x y))))
(define (mul-recip-le! x k1 k2)        ; k1 <= k2 in context: land recip P(x,k2) <= recip P(x,k1)
  (mul-P-facts! x k1) (mul-P-facts! x k2)
  (dk-apply! (dk-cite! 'prefix-prod-mono 'sx_ 'a x) k1 k2)
  (dk-have! (list '< 0 (mul-PP x k1)) (lambda () (dk-ineq! (list '<= 1 (mul-PP x k1)) (list 'IN (mul-PP x k1) 'RR))))
  (dk-cite! 'rr-recip-antitone (mul-PP x k1) (mul-PP x k2)))
(define mul-Dxy (mul-D 'xs 'ys))
(define mul-Dxz (mul-D 'xs 'zs))
(define mul-Dzy (mul-D 'zs 'ys))
(define mul-MAX (list 'MAX mul-Dxz mul-Dzy))

(sp (make-wff (mul-hyps3 (list '<= mul-Dxy mul-MAX))))
(dk-peel!)
(for-each (lambda (pr) (dk-split-all! (list (dk-cite! 'prefix-dist-nonneg 'sx_ 'a (car pr) (cadr pr)))))
          '((xs ys) (xs zs) (zs ys)))
(dk-cite! 'rr-max-closed mul-Dxz mul-Dzy)
(dk-cite! 'rr-le-max-left mul-Dxz mul-Dzy)
(dk-cite! 'rr-le-max-right mul-Dxz mul-Dzy)
(define (mul-fin! . prems)
  (apply dk-ineq! (append prems (list (list 'IN mul-Dxy 'RR) (list 'IN mul-Dxz 'RR) (list 'IN mul-Dzy 'RR)
                                      (list 'IN mul-MAX 'RR)))))
(use-em '(= xs ys)
  (lambda ()
    (dk-have! (list '= mul-Dxy 0) (lambda () (subst '(= xs ys)) (dk-cite! 'prefix-dist-self 'a 'ys) (ass)))
    (mul-fin! (list '= mul-Dxy 0) (list '<= 0 mul-Dxz) (list '<= mul-Dxz mul-MAX)))
  (lambda ()
    (use-em '(= zs xs)
      (lambda ()
        (dk-have! (list '= mul-Dzy mul-Dxy) (lambda () (subst '(= zs xs)) (rfl)))
        (mul-fin! (list '= mul-Dzy mul-Dxy) (list '<= mul-Dzy mul-MAX)))
      (lambda ()
        (use-em '(= zs ys)
          (lambda ()
            (dk-have! (list '= mul-Dxz mul-Dxy) (lambda () (subst '(= zs ys)) (rfl)))
            (mul-fin! (list '= mul-Dxz mul-Dxy) (list '<= mul-Dxz mul-MAX)))
          (lambda ()
            (mul-ne-flip! 'zs 'xs)
            (let* ((m (mul-al-facts! 'xs 'ys))
                   (n (mul-al-facts! 'xs 'zs))
                   (p (mul-al-facts! 'zs 'ys))
                   (cm (mul-clause m)) (cn (mul-clause n)) (cp (mul-clause p))
                   (Rm (mul-dval! 'xs 'ys))
                   (Rn (mul-dval! 'xs 'zs))
                   (Rp (mul-dval! 'zs 'ys)))
              (use-em (list '<= n m)
                (lambda ()
                  (mul-recip-le! 'xs n m)
                  (mul-fin! (list '= mul-Dxy Rm) (list '= mul-Dxz Rn) (list '<= Rm Rn) (list '<= mul-Dxz mul-MAX)
                            (list 'IN Rm 'RR) (list 'IN Rn 'RR)))
                (lambda ()
                  (dk-cite! 'nn-not-le-succ-le n m)
                  (dk-have! (list '< m n) (lambda () (dk-nn! (list '<= (list 'succ m) n))))
                  (mul-typed! 'xs m) (mul-typed! 'ys m) (mul-typed! 'zs m)
                  (dk-apply! cn m)
                  (use-em (list '<= p m)
                    (lambda ()
                      (dk-have! (mul-agree-s p 'agi_ 'xs 'zs)
                        (lambda ()
                          (let* ((pl (dk-peel!))
                                 (j (mul-nn-var pl)))
                            (mul-typed! 'xs j) (mul-typed! 'ys j) (mul-typed! 'zs j)
                            (dk-have! (list '< j m) (lambda () (dk-nn! (list '< j p) (list '<= p m))))
                            (dk-apply! cm j)
                            (dk-apply! cp j)
                            (subst (list '= (list 'xs j) (list 'ys j)))
                            (subst (list '= (list 'zs j) (list 'ys j)))
                            (rfl))))
                      (dk-split-all! (list (dk-cite! 'prefix-prod-ge-one 'sx_ 'a 'zs)))
                      (dk-cite! 'prefix-prod-agree-ind p 'sx_ 'a 'xs 'zs)
                      (mul-recip-le! 'xs p m)
                      (dk-have! (list '<= Rm Rp)
                        (lambda () (subst (list '= (mul-PP 'zs p) (mul-PP 'xs p))) (ass)))
                      (mul-fin! (list '= mul-Dxy Rm) (list '= mul-Dzy Rp) (list '<= Rm Rp) (list '<= mul-Dzy mul-MAX)
                                (list 'IN Rm 'RR) (list 'IN Rp 'RR)))
                    (lambda ()
                      (dk-cite! 'nn-not-le-succ-le p m)
                      (dk-have! (list '< m p) (lambda () (dk-nn! (list '<= (list 'succ m) p))))
                      (dk-apply! cp m)
                      (dk-have! (list '= (list 'xs m) (list 'ys m))
                        (lambda () (subst (list '= (list 'xs m) (list 'zs m))) (ass)))
                      (ai (list 'NOT (list '= (list 'xs m) (list 'ys m)))))))))))))))
(qed 'prefix-dist-ultra)
(topic! 'prefix-dist-ultra 'analysis)

