(define (gox-under-CE body)
  (list 'FORALL 'u (list 'FORALL 'f (list 'FORALL 'goxx_ (list 'IMPLIES '(IS-CONVEX u) (gox-imps gox-E body))))))

;;; COROLLARY 3.7
(sp (make-wff (gox-under-CE (gox-all-in '(goxa_ goxb_ goxc_) 'u
  '(= (SEG-INT f goxa_ goxc_) (+ (SEG-INT f goxa_ goxb_) (SEG-INT f goxb_ goxc_)))))))
(dk-peel!)
(gox-E-setup!)
(for-each (lambda (v) (fact 'subset-mem-fwd 'u 'CC v)) '(goxa_ goxb_ goxc_))
(dk-cite! 'conv3-in-convex 'u 'goxa_ 'goxb_ 'goxc_)
(dk-cite! 'goursat-triangle-except 'u 'f 'goxx_ 'goxa_ 'goxb_ 'goxc_)
(for-each (lambda (pq) (dk-cite! 'seg-trace-in-convex 'u (car pq) (cadr pq)) (dk-cite! 'seg-int-in-cc 'u 'f (car pq) (cadr pq)))
          '((goxa_ goxb_) (goxb_ goxc_) (goxc_ goxa_) (goxa_ goxc_)))
(let* ((sab '(SEG-INT f goxa_ goxb_)) (sbc '(SEG-INT f goxb_ goxc_)) (sca '(SEG-INT f goxc_ goxa_))
       (s3 (list '+ (list '+ sab sbc) sca))
       (rv (dk-cite! 'seg-int-reverse-at 'u 'f 'goxa_ 'goxc_)))
  (dk-cite! 'tri-int-unfold 'f 'goxa_ 'goxb_ 'goxc_)
  (gox-cc! s3)
  (dk-have! (list '= s3 0) (lambda () (subst (list '= s3 '(TRI-INT f goxa_ goxb_ goxc_))) (ass)))
  (dk-have! (list '= (list '+ sab sbc) (list '- s3 sca)) (lambda () (crs)))
  (subst (list '= (list '+ sab sbc) (list '- s3 sca)))
  (subst (list '= s3 0))
  (subst rv)
  (crs))
(qed 'cauchy-convex-segments-except)

;;; PROPOSITION 3.8, for a given base point o in u: g(b) = int_<o, b> f is a primitive.
;;; The derivative at z uses only the CONTINUITY of f at z (the notes' proof):
;;; |g(y) - g(z) - (y - z) f(z)| = |int_<z,y> (f - f(z))| <= |y - z| sup_<z,y> |f - f(z)|.
;;; In context: H(u, f), z in u, POS-RR(e).  Returns (del . claim), claim =
;;; forall w in u, |w - z| <= del => |f(w) - f(z)| <= e.
(define (gox-cont-mag! z e)
  (let* ((S (list 'SUBSPACE-MS gox-nfm 'u))
         (mg (lambda (p) (list 'magnitude p)))
         (fz (list 'f z))
         (cz (dk-apply! (dk-ctx-form (gox-cont 'u 'f)) z))
         (iff (dk-cite! 'is-continuous-at S gox-nfm 'f z))
         (edf (let loop ((r (caddr iff))) (if (eq? (car r) 'AND) (loop (caddr r)) r))))
    (dk-have! edf (lambda () (if (dk-only! iff cz) (prop))))
    (let* ((del (dk-skolem! (dk-apply! edf e)))
           (ub (dk-pick (lambda (fm) (and (gox-op? fm 'FORALL 3) (dk-contains? fm del))) "the continuity bound"))
           (claim (list 'FORALL 'goxcw_ (list 'IMPLIES '(IN goxcw_ u)
                    (list 'IMPLIES (list '<= (list 'magnitude (list '- 'goxcw_ z)) del)
                                   (list '<= (list 'magnitude (list '- '(f goxcw_) fz)) e))))))
      (fact 'rr-pos-rr-in-rr del)
      (fact 'rr-lt-of-pos-rr del)
      (fact 'subspace-pts gox-nfm 'u)
      (fact 'cc-is-metric-space)
      (gox-pts-cc!)
      (dk-have! claim
        (lambda ()
          (let* ((w (dk-di-var!)) (fw (list 'f w)))
            (di)
            (fact 'subset-mem-fwd 'u 'CC w)
            (fact 'fun-apply-type-c 'f 'u 'CC w)
            (fact 'fun-apply-type-c 'f 'u 'CC z)
            (dk-have! (list 'IN w (list 'PTS S)) (lambda () (subst (list '== (list 'PTS S) 'u)) (ass)))
            (for-each (lambda (pp) (dk-have! (list 'IN pp '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass))))
                      (list z w fz fw))
            (fact 'subspace-dist gox-nfm 'u z w)
            (fact 'nf-cc-agree-dist z w)
            (fact 'cc-ms-dist z w)
            (gox-cc! (list '- z w)) (gox-rr! (mg (list '- z w)))
            (gox-cc! (list '- w z)) (gox-rr! (mg (list '- w z)))
            (dk-cite! 'cc-magnitude-sub-sym z w)
            (dk-have! (list '<= (list (list 'DIST S) z w) del)
              (lambda ()
                (subst (list '== (list (list 'DIST S) z w) (list (list 'DIST gox-nfm) z w)))
                (subst (list '== (list (list 'DIST gox-nfm) z w) (list '(DIST CC-MS) z w)))
                (subst (list '== (list '(DIST CC-MS) z w) (mg (list '- z w))))
                (subst (list '= (mg (list '- z w)) (mg (list '- w z))))
                (ass)))
            (dk-apply! ub w)
            (fact 'nf-cc-agree-dist fz fw)
            (fact 'cc-ms-dist fz fw)
            (gox-cc! (list '- fz fw)) (gox-rr! (mg (list '- fz fw)))
            (gox-cc! (list '- fw fz)) (gox-rr! (mg (list '- fw fz)))
            (dk-cite! 'cc-magnitude-sub-sym fw fz)
            (subst (list '= (mg (list '- fw fz)) (mg (list '- fz fw))))
            (subst (list '== (mg (list '- fz fw)) (list '(DIST CC-MS) fz fw)))
            (subst (list '== (list '(DIST CC-MS) fz fw) (list (list 'DIST gox-nfm) fz fw)))
            (ass))))
      (cons del claim))))

(sp (make-wff (gox-under-CE
  '(FORALL goxo_ (IMPLIES (IN goxo_ u)
     (FORSOME goxg_ (AND (IN goxg_ (FUN u CC)) (AND (HOLOMORPHIC-ON u goxg_)
       (FORALL goxz_ (IMPLIES (IN goxz_ u) (IS-DIFF-ON CC-NORMED-FIELD u goxg_ goxz_ (f goxz_))))))))))))
(dk-peel!)
(gox-E-setup!)
(fact 'cc-is-normed-field)
(fact 'nf-open-is-set 'CC-NORMED-FIELD 'u)
(fact 'subset-mem-fwd 'u 'CC 'goxo_)
(define gox-pr-G (list 'VNB-LAMBDA 'goxpb_ 'u '(SEG-INT f goxo_ goxpb_)))
(define (gox-pr-seg! b)   ;; b in u: b in CC, the segment from o to b in u, its integral in CC
  (fact 'subset-mem-fwd 'u 'CC b)
  (dk-cite! 'seg-trace-in-convex 'u 'goxo_ b)
  (dk-cite! 'seg-int-in-cc 'u 'f 'goxo_ b))
(dk-have! (list 'IN gox-pr-G '(FUN u CC))
  (lambda () (dk-lam-type! (lambda () (let ((b (dk-di-var!))) (gox-pr-seg! b) (ass))))))
(define gox-pr-val
  (list 'FORALL 'goxz_ (list 'IMPLIES '(IN goxz_ u) (list '== (list gox-pr-G 'goxz_) '(SEG-INT f goxo_ goxz_)))))
(dk-have! gox-pr-val
  (lambda () (let ((b (dk-di-var!))) (gox-pr-seg! b) (if (not (dk-lam-b!)) (qrfl)))))
;; the derivative at every point
(define gox-pr-d
  (list 'FORALL 'goxpz_ (list 'IMPLIES '(IN goxpz_ u) (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'u gox-pr-G 'goxpz_ '(f goxpz_)))))
(dk-have! gox-pr-d
  (lambda ()
    (let* ((z (dk-di-var!))
           (fz (list 'f z))
           (k  (list 'VNB-LAMBDA 'goxpv_ 'u (list '+ fz (list '* 0 (list '- 'goxpv_ z)))))
           (h  (list 'VNB-LAMBDA 'goxpv_ 'u (list '+ '(f goxpv_) (list '- fz))))
           (mg (lambda (p) (list 'magnitude p))))
      (gox-pr-seg! z)
      (fact 'fun-apply-type-c 'f 'u 'CC z)
      (gox-cc! (list '- fz))
      (gox-cc! 0)
      ;; k, h = f - f(z) as functions on u; k holomorphic, h continuous
      (for-each
       (lambda (lam)
         (dk-have! (list 'IN lam '(FUN u CC))
           (lambda ()
             (dk-lam-type!
               (lambda ()
                 (let ((y (dk-di-var!)))
                   (fact 'subset-mem-fwd 'u 'CC y)
                   (fact 'fun-apply-type-c 'f 'u 'CC y)
                   (gox-cc! (subst-free 'goxpv_ y (list-ref lam 3)))
                   (ass)))))))
       (list k h))
      (for-each
       (lambda (lam)
         (dk-have! (list 'FORALL 'goxz_ (list 'IMPLIES '(IN goxz_ u) (list '== (list lam 'goxz_) (subst-free 'goxpv_ 'goxz_ (list-ref lam 3)))))
           (lambda ()
             (let ((y (dk-di-var!)))
               (fact 'subset-mem-fwd 'u 'CC y)
               (fact 'fun-apply-type-c 'f 'u 'CC y)
               (gox-cc! (subst-free 'goxpv_ y (list-ref lam 3)))
               (if (not (dk-lam-b!)) (qrfl))))))
       (list k h))
      (dk-cite! 'affine-holomorphic 'u fz 0 z k)
      (dk-cite! 'holomorphic-on-continuous 'u k)
      (dk-cite! 'cc-continuous-at-add-const 'u 'f h (list '- fz))
      (dk-have! (list 'FORALL 'goxz_ (list 'IMPLIES '(IN goxz_ u) (list '== '(f goxz_) (list '+ (list h 'goxz_) (list k 'goxz_)))))
        (lambda ()
          (let* ((y (dk-di-var!)) (fy (list 'f y)))
            (fact 'subset-mem-fwd 'u 'CC y)
            (fact 'fun-apply-type-c 'f 'u 'CC y)
            (gox-cc! (subst-free 'goxpv_ y (list-ref k 3)))
            (gox-cc! (subst-free 'goxpv_ y (list-ref h 3)))
            (dk-lam-b!)
            (let ((rhs (caddr (dk-goal))))
              (dk-have! (list '= rhs fy) (lambda () (crs)))
              (subst (list '= rhs fy))
              (qrfl)))))
      ;; the little-o bound at z, from the continuity of f at z
      (dk-have! (list 'FORALL 'goxe_ (list 'IMPLIES '(POS-RR goxe_)
                  (list 'FORSOME 'goxd_ (list 'AND '(POS-RR goxd_)
                    (list 'FORALL 'goxy_ (list 'IMPLIES '(IN goxy_ u)
                      (list 'IMPLIES (list '< (list 'magnitude (list '- 'goxy_ z)) 'goxd_)
                        (list '<= (list 'magnitude (list '- (list '- (list gox-pr-G 'goxy_) (list gox-pr-G z)) (list '* (list '- 'goxy_ z) fz)))
                                  (list '* 'goxe_ (list 'magnitude (list '- 'goxy_ z)))))))))))
        (lambda ()
          (let* ((e (cadr (car (filter (dk-head? 'POS-RR) (dk-peel!)))))
                 (dc (begin (fact 'rr-pos-rr-in-rr e) (fact 'rr-lt-of-pos-rr e) (gox-cont-mag! z e)))
                 (del (car dc)) (cb (cdr dc)))
            (ew del)
            (dk-conj-close!
              (lambda ()
                (if (not (eq? (gox-hd (dk-goal)) 'FORALL))
                    (ass)
                    (let* ((ls (dk-peel!))
                           (x (cadr (find-first (lambda (fm) (and (gox-op? fm 'IN 3) (eq? (caddr fm) 'u))) ls)))
                           (dx (mg (list '- x z)))
                           (hb (list 'FORALL 'goxcy_ (list 'IMPLIES (list 'IN 'goxcy_ (gox-segtr z x))
                                 (list '<= (list 'magnitude (list h 'goxcy_)) e)))))
                      (gox-pr-seg! x)
                      (dk-cite! 'seg-trace-in-convex 'u z x)
                      (dk-cite! 'seg-int-in-cc 'u 'f z x)
                      (subst (dk-apply! (dk-ctx-form gox-pr-val) x))
                      (subst (dk-apply! (dk-ctx-form gox-pr-val) z))
                      (subst (dk-cite! 'cauchy-convex-segments-except 'u 'f 'goxx_ 'goxo_ z x))
                      (subst (dk-cite! 'seg-int-sum 'u h k 'f z x))
                      (subst (dk-cite! 'seg-int-const 'u fz z k z x))
                      (dk-cite! 'seg-int-in-cc 'u h z x)
                      (dk-cite! 'seg-int-in-cc 'u k z x)
                      (let* ((shx (list 'SEG-INT h z x))
                             (lhs (cadr (cadr (dk-goal)))))
                        (gox-cc! lhs)
                        (dk-have! (list '= lhs shx) (lambda () (crs)))
                        (subst (list '= lhs shx))
                        (gox-cc! (list '- x z)) (gox-rr! dx)
                        (fact 'cc-magnitude-nonneg (list '- x z))
                        ;; |h| <= e on the segment from z to x
                        (dk-have! hb
                          (lambda ()
                            (let* ((y (dk-di-var!))
                                   (tt (dk-skolem! (dk-cite! 'seg-trace-elim z x y)))
                                   (dy (list '- y z)) (mdy (mg dy)))
                              (gox-unit! tt)
                              (fact 'subset-mem-fwd (gox-segtr z x) 'u y)
                              (fact 'subset-mem-fwd 'u 'CC y)
                              (fact 'fun-apply-type-c 'f 'u 'CC y)
                              (gox-cc! dy) (gox-rr! mdy)
                              (dk-have! (list '= dy (list '* tt (list '- x z)))
                                (lambda () (subst (list '= y (list '+ z (list '* tt (list '- x z))))) (crs)))
                              (gox-scaled-mag! tt dy (list '- x z))
                              (gox-and! (list '<= tt 1) (list '<= 0 dx))
                              (fact 'rr-mul-le-right tt 1 dx)
                              (gox-rr! (list '* 1 dx))
                              (dk-have! (list '<= mdy del)
                                (lambda () (dk-ineq! (list 'IN mdy 'RR) (list 'IN (list '* tt dx) 'RR) (list 'IN dx 'RR)
                                                     (list 'IN del 'RR)
                                                     (list '= mdy (list '* tt dx)) (list '<= (list '* tt dx) (list '* 1 dx))
                                                     (list '< dx del))))
                              (dk-apply! cb y)
                              (dk-lam-b!)
                              (let ((fy (list 'f y)))
                                (gox-cc! (list '+ fy (list '- fz))) (gox-cc! (list '- fy fz))
                                (dk-have! (list '= (list '+ fy (list '- fz)) (list '- fy fz)) (lambda () (crs)))
                                (subst (list '= (list '+ fy (list '- fz)) (list '- fy fz)))
                                (ass)))))
                        (dk-apply! (dk-cite! 'seg-int-abs-bound 'u h z x) e)
                        (gox-rr! (list '* dx e))
                        (gox-rr! (list '* e dx))
                        (gox-rr! (mg shx))
                        (dk-have! (list '= (list '* dx e) (list '* e dx)) (lambda () (crs)))
                        (dk-ineq! (list 'IN (mg shx) 'RR) (list 'IN (list '* dx e) 'RR) (list 'IN (list '* e dx) 'RR)
                                  (list '<= (mg shx) (list '* dx e)) (list '= (list '* dx e) (list '* e dx)))))))))))
      (dk-cite! 'cc-diff-on-of-eps-bound 'u gox-pr-G z fz)
      (ass))))
(ew gox-pr-G)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (ass))
            ((dk-head-is? g 'HOLOMORPHIC-ON)
             (mac 'HOLOMORPHIC-ON)
             (dk-conj-close!
               (lambda ()
                 (if (not (dk-head-is? (dk-goal) 'FORALL))
                     (ass)
                     (let ((a (dk-di-var!)))
                       (dk-apply! (dk-ctx-form gox-pr-d) a)
                       (ew (list 'f a))
                       (ass))))))
            (#t (error "cauchy-convex-primitive-except: unexpected leaf" (expression->string g)))))))
(qed 'cauchy-convex-primitive-except)

