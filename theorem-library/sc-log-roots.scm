;;; ch3d-log.scm -- CH3-D: Proposition 3.22 and Corollary 3.25 on a SIMPLY CONNECTED open set.
;;; The proofs are those of the convex forms (scratchpad/ch3b/ch3b-log.scm, agent ISOM), with the
;;; primitive of f'/f taken from 3.21 (sc-primitive) instead of cauchy-convex-primitive, and the
;;; connectedness of u read off SIMPLY-CONNECTED instead of cc-convex-connected.
;;; Needs: ch3d-sc (sc-primitive), ch3b-const / ch3b-log (exp-equal-diff-2-pi-i, zero-deriv-connected-constant,
;;; exp-power-nn).  Library: complex-analysis.  Helper prefix: sl-.

(define (sl-head g) (and (pair? g) (car g)))
(define sl-NF '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (sl-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass))))))
    f))
(define (sl-cc! t)
  (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))))

(define sl-hyp-nz '(FORALL z (IMPLIES (IN z u) (NOT (= (f z) 0)))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(SIMPLY-CONNECTED u)
     (list 'IMPLIES '(HOLOMORPHIC-ON u f)
       (list 'IMPLIES sl-hyp-nz
         '(FORSOME g (AND (HOLOMORPHIC-ON u g)
             (FORALL z (IMPLIES (IN z u) (= (CC-EXP (g z)) (f z)))))))))))))
(dk-peel!)
(define sl-nz (dk-pick (lambda (h) (and (eq? (sl-head h) 'FORALL) (dk-contains? h 'NOT))) "f nonvanishing"))
(fact 'holomorphic-on-in-fun 'u 'f)
(let ((sl-rhs (caddr (dk-cite! 'simply-connected 'u)))) (dk-project! sl-rhs 'simply-connected '(SIMPLY-CONNECTED u)) (dk-split-all! (list sl-rhs)))
(fact 'holomorphic-on-open 'u 'f)
(fact 'cc-open-subset-cc 'u)
(fact 'cc-nf-small-elements)
(fact 'cc-is-normed-field)
(define (sl-fz! z)                   ; z in u: z in CC, f z in CC, f z /= 0, recip(f z) in CC
  (fact 'subset-mem-fwd 'u 'CC z)
  (fact 'fun-apply-type-c 'f 'u 'CC z)
  (dk-apply! sl-nz z)
  (sl-and! (list 'IN (list 'f z) 'CC) (list 'NOT (list '= (list 'f z) 0)))
  (fact 'cc-recip-closed (list 'f z)))
(use-em '(FORSOME c3lw_ (IN c3lw_ u))
 (lambda ()
   (let* ((z0 (dk-skolem! (dk-pick (lambda (h) (and (eq? (sl-head h) 'FORSOME) (dk-contains? h 'c3lw_))) "a point")))
          (FD '(VNB-LAMBDA cifdw_ u (DERIV-ON CC-NORMED-FIELD u f cifdw_))))
     (fact 'holomorphic-deriv-holomorphic 'u 'f)
     (fact 'holomorphic-on-in-fun 'u FD)
     (let* ((fdv (dk-name! FD '(FUN u CC)))
            (Q (list 'VNB-LAMBDA 'c3lz_ 'u (list '* (list fdv 'c3lz_) (list 'recip '(f c3lz_))))))
       (dk-have! (list 'HOLOMORPHIC-ON 'u fdv) (lambda () (subst (list '= fdv FD)) (ass)))
       (dk-have! (list 'HOLOMORPHIC-ON 'u Q) (lambda () (dk-holomorphic! 'u Q)))
       (let* ((Gp (dk-skolem! (dk-apply! (dk-cite! 'sc-primitive 'u Q) z0)))
              (Gcl (dk-pick (lambda (h) (and (eq? (sl-head h) 'FORALL) (dk-contains? h Gp) (dk-contains? h 'IS-DIFF-ON)))
                            "the primitive clause"))
              (Kf (list 'VNB-LAMBDA 'c3lz_ 'u (list '* (list 'CC-EXP (list '- (list Gp 'c3lz_))) '(f c3lz_)))))
         (fact 'holomorphic-on-in-fun 'u Gp)
         ;; Kf has derivative 0 at every point
         (dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'u Kf 'z 0)))
           (lambda ()
             (let* ((z (dk-di-var!)))
               (sl-fz! z)
               (fact 'fun-apply-type-c Gp 'u 'CC z)
               (fact 'fun-apply-type-c fdv 'u 'CC z)
               (dk-lam-b-h! (dk-apply! Gcl z))
               (let* ((lf (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff 'u 'f) z)))
                      (dv (dk-cite! 'deriv-on-of-is-diff-on 'CC-NORMED-FIELD)))
                 (dk-apply! dv 'u 'f z lf)
                 (dk-have! (list '= (list fdv z) lf)
                   (lambda ()
                     (subst (list '= fdv FD))
                     (dk-lam-b!)
                     (ass)))
                 (let* ((res (dk-diff! 'u Kf z))
                        (Lstar (list-ref res 5)))
                   (dk-have! (list '= Lstar 0)
                     (lambda ()
                       (let* ((Gz (list Gp z)) (fz (list 'f z)) (E (list 'CC-EXP (list '- Gz))))
                         (subst (list '= (list fdv z) lf))
                         ;; exp(c * Gp z) for the constant c the laws wrote: the same as exp(-G z)
                         (let walk ((t (dk-goal)))
                           (if (pair? t)
                               (if (and (eq? (car t) 'CC-EXP) (pair? (cdr t)) (not (equal? (cadr t) (list '- Gz))))
                                   (let ((x (cadr t)))
                                     (sl-cc! x)
                                     (dk-have! (list '= x (list '- Gz)) (lambda () (crs)))
                                     (subst (list '= x (list '- Gz))))
                                   (for-each walk t))))
                         (fact 'cc-recip-inverse fz)
                         (let ((r (dk-name! (list 'recip fz) 'CC)))
                           (subst (list '= (list 'recip fz) r))
                           (dk-have! (list '= (list '* fz r) 1)
                             (lambda () (subst (list '= r (list 'recip fz))) (ass)))
                           (sl-cc! (list '- Gz))
                           (fact 'cc-exp-converges (list '- Gz))
                           (dk-split-all!)
                           (fact 'diff-on-deriv-in-carr 'CC-NORMED-FIELD 'u 'f z lf)
                           (dk-have! (list 'IN lf 'CC) (lambda () (subst (list '== 'CC '(CARR CC-NORMED-FIELD))) (ass)))
                           (let ((g (dk-goal)))
                             (dk-have! (list '= (cadr g) (list '* (list '* E lf) (list '- 1 (list '* fz r)))) (lambda () (crs)))
                             (subst (list '= (cadr g) (list '* (list '* E lf) (list '- 1 (list '* fz r)))))
                             (subst (list '= (list '* fz r) 1))
                             (crs))))))
                   (dk-rewrite-h! res Lstar 0)
                   (ass))))))
         ;; Kf is constant: Kf(z) = Kf(z0) = c, and c /= 0
         (let* ((Dcl (dk-pick (lambda (h) (and (eq? (sl-head h) 'FORALL) (dk-contains? h Kf) (dk-contains? h 'IS-DIFF-ON)))
                              "Kf' = 0"))
                (_0 (sl-fz! z0))
                (_1 (fact 'fun-apply-type-c Gp 'u 'CC z0))
                (d0 (dk-apply! Dcl z0)))
           (fact 'diff-on-in-fun 'CC-NORMED-FIELD 'u Kf z0 0)
           (fact 'cc-nf-carr)
           (dk-have! (list 'IN Kf '(FUN u CC)) (lambda () (subst (list '== 'CC '(CARR CC-NORMED-FIELD))) (ass)))
           (let* ((const (dk-apply! (dk-cite! 'zero-deriv-connected-constant 'u Kf)))
                  (Gz0 (list Gp z0)) (fz0 (list 'f z0))
                  (c (list '* (list 'CC-EXP (list '- Gz0)) fz0)))
             (sl-cc! (list '- Gz0))
             (fact 'cc-exp-converges (list '- Gz0))
             (dk-split-all!)
             (fact 'cc-exp-nonzero (list '- Gz0))
             (sl-cc! c)
             (dk-have! (list 'NOT (list '= c 0))
               (lambda ()
                 (di)
                 ;; cc-mul-nonzero (cc-reciprocal), not cc-mul-zero-left: the latter is proven in
                 ;; ca-lft-compose, which loads AFTER this file
                 (fact 'cc-mul-nonzero (list 'CC-EXP (list '- Gz0)) fz0)
                 (dk-only! (list '= c 0) (list 'NOT (list '= c 0)))
                 (prop)))
             (let* ((w (dk-skolem! (dk-apply! (dk-cite! 'cc-exp-surjective-strip) c)))
                    (glog (list 'VNB-LAMBDA 'c3lz_ 'u (list '+ (list Gp 'c3lz_) w))))
               (ew glog)
               (dk-conj-close!
                (lambda ()
                  (if (eq? (sl-head (dk-goal)) 'HOLOMORPHIC-ON)
                      (dk-holomorphic! 'u glog)
                      (let ((z (dk-di-var!)))
                        (sl-fz! z)
                        (fact 'fun-apply-type-c Gp 'u 'CC z)
                        (dk-lam-b!)
                        (let* ((Gz (list Gp z)) (fz (list 'f z))
                               (A (list 'CC-EXP Gz)) (B (list 'CC-EXP (list '- Gz)))
                               (ew (list 'CC-EXP w)))
                          (sl-cc! (list '- Gz))
                          (for-each (lambda (t) (fact 'cc-exp-converges t)) (list Gz (list '- Gz) w))
                          (dk-split-all!)
                          (dk-lam-b-h! (dk-apply! const z z0))
                          (fact 'cc-exp-add Gz w)
                          (fact 'cc-exp-add Gz (list '- Gz))
                          (fact 'cc-exp-zero)
                          (dk-have! (list '= (list '* A B) 1)
                            (lambda ()
                              (subst (list '= (list '* A B) (list 'CC-EXP (list '+ Gz (list '- Gz)))))
                              (dk-have! (list '= (list '+ Gz (list '- Gz)) 0) (lambda () (crs)))
                              (subst (list '= (list '+ Gz (list '- Gz)) 0))
                              (ass)))
                          (subst (list '= (list 'CC-EXP (list '+ Gz w)) (list '* A ew)))
                          (subst (list '= ew c))
                          (subst (list '= c (list '* B fz)))
                          (dk-have! (list '= (list '* A (list '* B fz)) (list '* (list '* A B) fz)) (lambda () (crs)))
                          (subst (list '= (list '* A (list '* B fz)) (list '* (list '* A B) fz)))
                          (subst (list '= (list '* A B) 1))
                          (crs)))))))))))))
 (lambda ()
   (ew 'f)
   (dk-conj-close!
    (lambda ()
      (if (not (eq? (sl-head (dk-goal)) 'FORALL))
          (ass)
          (let ((z (dk-di-var!)))
            (dk-have! '(FORSOME c3lw_ (IN c3lw_ u)) (lambda () (ew z) (ass)))
            (dk-only! '(FORSOME c3lw_ (IN c3lw_ u)) '(NOT (FORSOME c3lw_ (IN c3lw_ u))))
            (prop)))))))
(qed 'holomorphic-log-sc-exists)

(define sl-2pii '(* (* 2 PI) +i))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(SIMPLY-CONNECTED u)
     (list 'IMPLIES '(HOLOMORPHIC-ON u f)
       (list 'IMPLIES sl-hyp-nz
         (list 'AND
           '(FORSOME g (AND (HOLOMORPHIC-ON u g) (FORALL z (IMPLIES (IN z u) (= (CC-EXP (g z)) (f z))))))
           (list 'FORALL 'g (list 'FORALL 'h (list 'IMPLIES '(HOLOMORPHIC-ON u g) (list 'IMPLIES '(HOLOMORPHIC-ON u h)
             (list 'IMPLIES '(FORALL z (IMPLIES (IN z u) (= (CC-EXP (g z)) (f z))))
               (list 'IMPLIES '(FORALL z (IMPLIES (IN z u) (= (CC-EXP (h z)) (f z))))
                 (list 'FORALL 'z0 (list 'IMPLIES '(IN z0 u)
                   (list 'FORSOME 'n (list 'AND '(IN n ZZ)
                     (list 'FORALL 'z (list 'IMPLIES '(IN z u)
                       (list '= '(g z) (list '+ '(h z) (list '* 'n sl-2pii)))))))))))))))))))))))
(dk-peel!)
(fact 'holomorphic-log-sc-exists 'u 'f)
(let ((sl-rhs (caddr (dk-cite! 'simply-connected 'u)))) (dk-project! sl-rhs 'simply-connected '(SIMPLY-CONNECTED u)) (dk-split-all! (list sl-rhs)))
(fact 'holomorphic-on-open 'u 'f)
(fact 'cc-open-subset-cc 'u)
(dk-conj-close!
 (lambda ()
   (if (dk-asm? (dk-goal))
       (ass)
       (let* ((pl (dk-peel!))
              (eqs (filter (lambda (q) (and (eq? (sl-head q) 'FORALL) (dk-contains? q 'CC-EXP) (dk-contains? q '(f z)))) (dk-asms)))
              (eg (find-first (lambda (q) (dk-contains? q '(g z))) eqs))
              (eh (find-first (lambda (q) (dk-contains? q '(h z))) eqs))
              (z0 (cadr (car (filter (lambda (q) (and (eq? (sl-head q) 'IN) (eq? (caddr q) 'u))) pl)))))
         (dk-have! '(FORALL z (IMPLIES (IN z u) (= (CC-EXP (g z)) (CC-EXP (h z)))))
           (lambda ()
             (let ((z (dk-di-var!)))
               (dk-apply! eg z) (dk-apply! eh z)
               (subst (list '= (list 'CC-EXP (list 'g z)) (list 'f z)))
               (subst (list '= (list 'CC-EXP (list 'h z)) (list 'f z)))
               (fact 'holomorphic-on-in-fun 'u 'f)
               (fact 'holomorphic-on-open 'u 'f) (fact 'cc-open-subset-cc 'u)
               (fact 'fun-apply-type-c 'f 'u 'CC z)
               (rfl))))
         (dk-close-if! (lambda () (inst*! (dk-cite! 'exp-equal-diff-2-pi-i 'u 'g 'h) z0)) ass)))))
(qed 'holomorphic-log-sc)

(define (sl-n-facts!)                 ; n in NN, 1 <= n in context: n in CC, n /= 0, r := recip n named
  (fact 'nn-in-rr 'n)
  (fact 'rr-subset-cc 'n)
  (dk-have! '(NOT (= n 0)) (lambda () (di) (dk-absurd! '(= n 0) '(<= 1 n) '(IN n RR))))
  (sl-and! '(IN n CC) '(NOT (= n 0)))
  (fact 'cc-recip-closed 'n)
  (fact 'cc-recip-inverse 'n))
(define (sl-recip-name!)              ; name recip(n), with n * r = 1
  (let ((r (dk-name! '(recip n) 'CC)))
    (dk-have! (list '= (list '* 'n r) 1) (lambda () (subst (list '= r '(recip n))) (ass)))
    r))
(define sl-root-hyps (list '(SIMPLY-CONNECTED u) '(HOLOMORPHIC-ON u f) sl-hyp-nz '(IN n NN) '(<= 1 n)))
(define (sl-imps hs body) (if (null? hs) body (list 'IMPLIES (car hs) (sl-imps (cdr hs) body))))

(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'FORALL 'n (sl-imps sl-root-hyps
     '(FORSOME g (AND (HOLOMORPHIC-ON u g)
        (FORALL z (IMPLIES (IN z u) (= (power (g z) n) (f z))))))))))))
(dk-peel!)
(fact 'holomorphic-on-open 'u 'f) (fact 'cc-open-subset-cc 'u)
(fact 'holomorphic-on-in-fun 'u 'f)
(sl-n-facts!)
(define sl-L (dk-skolem! (dk-cite! 'holomorphic-log-sc-exists 'u 'f)))
(define sl-Lcl (dk-pick (lambda (q) (and (eq? (sl-head q) 'FORALL) (dk-contains? q sl-L))) "exp L = f"))
(fact 'holomorphic-on-in-fun 'u sl-L)
(define sl-groot (list 'VNB-LAMBDA 'c3lz_ 'u (list 'CC-EXP (list '* '(recip n) (list sl-L 'c3lz_)))))
(ew sl-groot)
(dk-conj-close!
 (lambda ()
   (if (eq? (sl-head (dk-goal)) 'HOLOMORPHIC-ON)
       (dk-holomorphic! 'u sl-groot)
       (let* ((z (dk-di-var!)) (Lz (list sl-L z)))
         (fact 'subset-mem-fwd 'u 'CC z)
         (fact 'fun-apply-type-c sl-L 'u 'CC z)
         (fact 'fun-apply-type-c 'f 'u 'CC z)
         (sl-cc! (list '* '(recip n) Lz))
         (fact 'cc-exp-converges (list '* '(recip n) Lz)) (dk-split-all!)
         (dk-lam-b!)
         (dk-apply! (dk-cite! 'exp-power-nn 'n) (list '* '(recip n) Lz))
         (subst (list '= (list 'power (list 'CC-EXP (list '* '(recip n) Lz)) 'n) (list 'CC-EXP (list '* 'n (list '* '(recip n) Lz)))))
         (let ((r (sl-recip-name!)))
           (subst (list '= '(recip n) r))
           (dk-have! (list '= (list '* 'n (list '* r Lz)) (list '* (list '* 'n r) Lz)) (lambda () (crs)))
           (subst (list '= (list '* 'n (list '* r Lz)) (list '* (list '* 'n r) Lz)))
           (subst (list '= (list '* 'n r) 1))
           (dk-have! (list '= (list '* 1 Lz) Lz) (lambda () (crs)))
           (subst (list '= (list '* 1 Lz) Lz))
           (dk-apply! sl-Lcl z)
           (ass))))))
(qed 'holomorphic-root-sc-exists)
(topic! 'holomorphic-root-sc-exists 'analysis)
(alias! 'holomorphic-root-sc-exists
        "a nonvanishing holomorphic function on a simply connected open set has a holomorphic n-th root")

(define sl-pow-g '(FORALL z (IMPLIES (IN z u) (= (power (g z) n) (f z)))))
(define sl-pow-h '(FORALL z (IMPLIES (IN z u) (= (power (h z) n) (f z)))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'FORALL 'n (sl-imps sl-root-hyps
     (list 'FORALL 'g (list 'FORALL 'h (sl-imps (list '(HOLOMORPHIC-ON u g) '(HOLOMORPHIC-ON u h) sl-pow-g sl-pow-h)
       '(FORALL z0 (IMPLIES (IN z0 u)
          (FORSOME a (AND (IN a CC) (AND (= (power a n) 1)
            (FORALL z (IMPLIES (IN z u) (= (h z) (* a (g z)))))))))))))))))))
(dk-peel!)
(let ((sl-rhs (caddr (dk-cite! 'simply-connected 'u)))) (dk-project! sl-rhs 'simply-connected '(SIMPLY-CONNECTED u)) (dk-split-all! (list sl-rhs)))
(fact 'holomorphic-on-open 'u 'f) (fact 'cc-open-subset-cc 'u)
(fact 'holomorphic-on-in-fun 'u 'f)
(fact 'holomorphic-on-in-fun 'u 'g)
(fact 'holomorphic-on-in-fun 'u 'h)

(sl-n-facts!)
(define sl-q (dk-skolem! (dk-cite! 'nn-pos-is-succ 'n)))
(fact 'power-zero-base sl-q)
;;; fn^n = f with f nonvanishing: fn nonvanishing
(define (sl-nonvan! fn pw)
  (dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list 'NOT (list '= (list fn 'z) 0))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (di)
        (dk-apply! pw z)
        (dk-apply! sl-nz z)
        (dk-have! (list '= (list 'f z) 0)
          (lambda ()
            (subst (list '= (list 'f z) (list 'power (list fn z) 'n)))
            (subst (list '= (list fn z) 0))
            (subst (list '= 'n (list 'succ sl-q)))
            (ass)))
        (dk-close-if! (lambda () (dk-only! (list '= (list 'f z) 0) (list 'NOT (list '= (list 'f z) 0)))) prop)))))
(define sl-pg (dk-pick (lambda (q) (and (eq? (sl-head q) 'FORALL) (dk-contains? q '(g z)) (dk-contains? q 'power))) "g^n = f"))
(define sl-ph (dk-pick (lambda (q) (and (eq? (sl-head q) 'FORALL) (dk-contains? q '(h z)) (dk-contains? q 'power))) "h^n = f"))
(sl-nonvan! 'g sl-pg)
(sl-nonvan! 'h sl-ph)
(define sl-N (dk-skolem! (dk-cite! 'holomorphic-log-sc-exists 'u 'g)))
(define sl-Ncl (dk-pick (lambda (q) (and (eq? (sl-head q) 'FORALL) (dk-contains? q sl-N))) "exp N = g"))
(define sl-M (dk-skolem! (dk-cite! 'holomorphic-log-sc-exists 'u 'h)))
(define sl-Mcl (dk-pick (lambda (q) (and (eq? (sl-head q) 'FORALL) (dk-contains? q sl-M))) "exp M = h"))
(fact 'holomorphic-on-in-fun 'u sl-N)
(fact 'holomorphic-on-in-fun 'u sl-M)
(define sl-nM (list 'VNB-LAMBDA 'c3lz_ 'u (list '* 'n (list sl-M 'c3lz_))))
(define sl-nN (list 'VNB-LAMBDA 'c3lz_ 'u (list '* 'n (list sl-N 'c3lz_))))
(dk-have! (list 'HOLOMORPHIC-ON 'u sl-nM) (lambda () (dk-holomorphic! 'u sl-nM)))
(dk-have! (list 'HOLOMORPHIC-ON 'u sl-nN) (lambda () (dk-holomorphic! 'u sl-nN)))
;;; exp(n M z) = h(z)^n = f(z), and likewise for N
(define (sl-expn! L Lcl fn pw z)      ; lands exp(n L z) = f z
  (let ((Lz (list L z)))
    (fact 'fun-apply-type-c L 'u 'CC z)
    (fact 'fun-apply-type-c fn 'u 'CC z)
    (dk-have! (list '= (list 'CC-EXP (list '* 'n Lz)) (list 'f z))
      (lambda ()
        (dk-apply! (dk-cite! 'exp-power-nn 'n) Lz)
        (subst (list '= (list 'CC-EXP (list '* 'n Lz)) (list 'power (list 'CC-EXP Lz) 'n)))
        (dk-apply! Lcl z)
        (subst (list '= (list 'CC-EXP Lz) (list fn z)))
        (dk-apply! pw z)
        (ass)))))
(dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list '= (list 'CC-EXP (list sl-nM 'z)) (list 'CC-EXP (list sl-nN 'z)))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (fact 'subset-mem-fwd 'u 'CC z)
      (fact 'fun-apply-type-c sl-M 'u 'CC z)
      (fact 'fun-apply-type-c sl-N 'u 'CC z)
      (dk-lam-b!)
      (sl-expn! sl-M sl-Mcl 'h sl-ph z)
      (sl-expn! sl-N sl-Ncl 'g sl-pg z)
      (subst (list '= (list 'CC-EXP (list '* 'n (list sl-M z))) (list 'f z)))
      (subst (list '= (list 'CC-EXP (list '* 'n (list sl-N z))) (list 'f z)))
      (fact 'fun-apply-type-c 'f 'u 'CC z)
      (rfl))))
(define sl-z0 (cadr (car (filter (lambda (q) (and (eq? (sl-head q) 'IN) (eq? (caddr q) 'u) (not (memq (cadr q) '(z))))) (dk-asms)))))
(define sl-kint (dk-skolem! (dk-apply! (dk-cite! 'exp-equal-diff-2-pi-i 'u sl-nM sl-nN) 'z0)))
(define sl-kcl (dk-pick (lambda (q) (and (eq? (sl-head q) 'FORALL) (dk-contains? q sl-kint))) "n M = n N + m 2 pi i"))
(define sl-r (sl-recip-name!))
(define sl-c (list '* sl-r (list '* sl-kint sl-2pii)))
(define sl-a (list 'CC-EXP sl-c))
(if (not (dk-asm? '(IN PI RR))) (begin (fact 'pi-pos) (dk-split-all!)))
(fact 'rr-subset-cc 'PI)
(sl-cc! sl-kint)
(fact 'cc-i-in)
(sl-cc! sl-2pii)
(sl-cc! sl-c)
(fact 'cc-exp-converges sl-c) (dk-split-all!)
(ew sl-a)
(dk-conj-close!
 (lambda ()
   (let ((gl (dk-goal)))
     (cond
      ((eq? (sl-head gl) '=)
       ;; a^n = exp(n c) = exp(m 2 pi i) = 1
       (dk-apply! (dk-cite! 'exp-power-nn 'n) sl-c)
       (subst (list '= (list 'power sl-a 'n) (list 'CC-EXP (list '* 'n sl-c))))
       (dk-have! (list '= (list '* 'n sl-c) (list '* (list '* 'n sl-r) (list '* sl-kint sl-2pii))) (lambda () (crs)))
       (subst (list '= (list '* 'n sl-c) (list '* (list '* 'n sl-r) (list '* sl-kint sl-2pii))))
       (subst (list '= (list '* 'n sl-r) 1))
       (dk-have! (list '= (list '* 1 (list '* sl-kint sl-2pii)) (list '* sl-kint sl-2pii)) (lambda () (crs)))
       (subst (list '= (list '* 1 (list '* sl-kint sl-2pii)) (list '* sl-kint sl-2pii)))
       (fact 'cc-exp-two-pi-i)
       (dk-close-if! (lambda () (inst*! (dk-cite! 'cc-exp-kernel-zz-multiple sl-2pii) sl-kint)) ass))
      ((eq? (sl-head gl) 'FORALL)
       (let* ((z (dk-di-var!)) (Mz (list sl-M z)) (Nz (list sl-N z)))
         (fact 'subset-mem-fwd 'u 'CC z)
         (fact 'fun-apply-type-c sl-M 'u 'CC z)
         (fact 'fun-apply-type-c sl-N 'u 'CC z)
         (fact 'fun-apply-type-c 'g 'u 'CC z)
         (dk-lam-b-h! (dk-apply! sl-kcl z))
         ;; M z = N z + c
         (dk-have! (list '= Mz (list '+ Nz sl-c))
           (lambda ()
             (dk-have! (list '= Mz (list '* sl-r (list '* 'n Mz)))
               (lambda ()
                 (dk-have! (list '= (list '* sl-r (list '* 'n Mz)) (list '* (list '* 'n sl-r) Mz)) (lambda () (crs)))
                 (subst (list '= (list '* sl-r (list '* 'n Mz)) (list '* (list '* 'n sl-r) Mz)))
                 (subst (list '= (list '* 'n sl-r) 1))
                 (crs)))
             (subst (list '= Mz (list '* sl-r (list '* 'n Mz))))
             (subst (list '= (list '* 'n Mz) (list '+ (list '* 'n Nz) (list '* sl-kint sl-2pii))))
             (dk-have! (list '= (list '* sl-r (list '+ (list '* 'n Nz) (list '* sl-kint sl-2pii)))
                             (list '+ (list '* (list '* 'n sl-r) Nz) sl-c))
               (lambda () (crs)))
             (subst (list '= (list '* sl-r (list '+ (list '* 'n Nz) (list '* sl-kint sl-2pii)))
                          (list '+ (list '* (list '* 'n sl-r) Nz) sl-c)))
             (subst (list '= (list '* 'n sl-r) 1))
             (crs)))
         (dk-apply! sl-Mcl z)
         (dk-apply! sl-Ncl z)
         (fact 'cc-exp-add Nz sl-c)
         (subst (list '= (list 'h z) (list 'CC-EXP Mz)))
         (subst (list '= Mz (list '+ Nz sl-c)))
         (subst (list '= (list 'CC-EXP (list '+ Nz sl-c)) (list '* (list 'CC-EXP Nz) sl-a)))
         (subst (list '= (list 'CC-EXP Nz) (list 'g z)))
         (crs)))
      (#t (ass))))))
(qed 'holomorphic-root-sc-unique)

