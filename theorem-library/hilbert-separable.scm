;;; bo2-sep.scm -- ORTHONORMAL FAMILIES AND SEPARABILITY.  Agent BA-ONB2, 2026-11-09
;;; (scratchpad/triage/BA-ONB2.md, target 4).  Helper prefix: bo2s-.
;;;
;;;   bo2-onf-dist-gt-one           two distinct members of an orthonormal family are more
;;;                                 than 1 apart (the distance is sqrt 2)
;;;   orthonormal-family-countable-of-separable
;;;                                 in a separable inner product space every orthonormal
;;;                                 family is indexed by a countable set
;;;   separable-hilbert-countable-basis
;;;                                 a separable inner product space has a countable
;;;                                 orthonormal basis
;;;
;;; The proof of countability needs no Gram-Schmidt: the balls of radius 1/2 about the e_i
;;; are pairwise disjoint (bo2-onf-dist-gt-one), each contains a term of the dense sequence,
;;; so i |-> "the i whose ball holds dseq(n)" is a map from a subset of NN ONTO ix.
;;;
;;; LOAD WINDOW [hilbert-onb + 1, end): onb-exists (hilbert-onb); ip-metric-space-dist,
;;; cips-pythagoras, cips-parallelogram-ip (hilbert-projection); countable-image,
;;; countable-subset, countable-of-enum (regulated-primitive-laws).  Library: analysis.

(define (bo2s-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; bo2s: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l) (display ";;   ") (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))
        (error "bo2s: proof not complete" name)))
  (qed name)
  (topic! name 'analysis))

(define (bo2s-has-lam? g)
  (and (pair? g)
       (or (and (pair? (car g)) (eq? (caar g) 'VNB-LAMBDA))
           (let loop ((l g)) (and (pair? l) (or (bo2s-has-lam? (car l)) (loop (cdr l))))))))
(define (bo2s-beta!) (if (bo2s-has-lam? (dk-goal)) (dk-lam-b!) #f))
(define bo2s-V '(VEC v))
(define (bo2s-ip a b) (list '(IP v) a b))
(define (bo2s-sub a b) (list '(VADD v) a (list '(VNEG v) b)))
(define bo2s-M '(IP-METRIC-SPACE v))
(define (bo2s-d a b) (list '(DIST (IP-METRIC-SPACE v)) a b))
(define (bo2s-onf ix e) (list 'IS-ORTHONORMAL-FAMILY 'v ix e))
(define (bo2s-onf-typ! ix e)
  (dk-project! (list 'IN e (list 'FUN ix bo2s-V)) 'is-orthonormal-family (bo2s-onf ix e)))
(define (bo2s-onf-unit! ix e)
  (dk-project! (list 'FORALL 'oni_ (list 'IMPLIES (list 'IN 'oni_ ix) (list '= (bo2s-ip (list e 'oni_) (list e 'oni_)) 1)))
               'is-orthonormal-family (bo2s-onf ix e)))
(define (bo2s-onf-orth! ix e)
  (dk-project! (list 'FORALL 'oni_ (list 'IMPLIES (list 'IN 'oni_ ix)
                 (list 'FORALL 'onj_ (list 'IMPLIES (list 'IN 'onj_ ix)
                   (list 'IMPLIES (list 'NOT (list '= 'oni_ 'onj_)) (list '= (bo2s-ip (list e 'oni_) (list e 'onj_)) 0))))))
               'is-orthonormal-family (bo2s-onf ix e)))

;;; ---------------------------------------------------------------------------
;;; 1 < d(e_i, e_j) for i /= j
(sp (make-wff
  '(FORALL v (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v)
     (FORALL ix (FORALL e (IMPLIES (IS-ORTHONORMAL-FAMILY v ix e)
       (FORALL bsi_ (IMPLIES (IN bsi_ ix) (FORALL bsj_ (IMPLIES (IN bsj_ ix)
         (IMPLIES (NOT (= bsi_ bsj_))
           (< 1 ((DIST (IP-METRIC-SPACE v)) (e bsi_) (e bsj_)))))))))))))))
(dk-peel!)
(let* ((gl (dk-goal))
       (x (cadr (caddr gl))) (y (caddr (caddr gl)))
       (i (cadr x)) (j (cadr y))
       (typ (bo2s-onf-typ! 'ix 'e))
       (unit (bo2s-onf-unit! 'ix 'e))
       (orth (bo2s-onf-orth! 'ix 'e))
       (xy (list '(VADD v) x y))
       (xmy (bo2s-sub x y))
       (p (bo2s-ip xy xy))
       (q (bo2s-ip xmy xmy)))
  (fact 'fun-apply-type-c 'e 'ix bo2s-V i)
  (fact 'fun-apply-type-c 'e 'ix bo2s-V j)
  (dk-apply! unit i)
  (dk-apply! unit j)
  (dk-apply! orth i j)
  (fact 'ip-metric-space-dist 'v x y)
  (fact 'cips-vneg-type 'v y)
  (fact 'cips-vadd-type 'v x (list '(VNEG v) y))
  (fact 'cips-ip-self-real 'v xmy)
  (let* ((yn (list '(VNEG v) y)))
    (dk-have! (list 'NOT (list '= j i))
      (lambda () (di) (dk-have! (list '= i j) (lambda () (subst (list '= i j)) (rfl))) (ai (list 'NOT (list '= i j)))))
    (dk-apply! orth j i)
    (fact 'cips-ip-add-left 'v x yn xmy)
    (fact 'cips-ip-add-right 'v x x yn)
    (fact 'cips-ip-add-right 'v yn x yn)
    (fact 'cips-ip-neg-right 'v x y)
    (fact 'cips-ip-neg-left 'v y x)
    (fact 'cips-ip-neg-self 'v y)
    (dk-have! (list '= q 2)
      (lambda ()
        (subst (list '= q (list '+ (bo2s-ip x xmy) (bo2s-ip yn xmy))))
        (subst (list '= (bo2s-ip x xmy) (list '+ (bo2s-ip x x) (bo2s-ip x yn))))
        (subst (list '= (bo2s-ip yn xmy) (list '+ (bo2s-ip yn x) (bo2s-ip yn yn))))
        (subst (list '= (bo2s-ip x yn) (list '- (bo2s-ip x y))))
        (subst (list '= (bo2s-ip yn x) (list '- (bo2s-ip y x))))
        (subst (list '= (bo2s-ip yn yn) (bo2s-ip y y)))
        (subst (list '= (bo2s-ip x x) 1))
        (subst (list '= (bo2s-ip y y) 1))
        (subst (list '= (bo2s-ip x y) 0))
        (subst (list '= (bo2s-ip y x) 0))
        (arith))))
  (subst (list '= (bo2s-d x y) (list 'SQRT q)))
  (subst (list '= q 2))
  (fact 'rr-one-in)
  (dk-have! '(IN 2 RR) (lambda () (arith)))
  (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
  (dk-have! '(<= 0 2) (lambda () (dk-ineq!)))
  (let ((iff (dk-cite! 'sqrt-gt-iff 1 2)))
    (dk-have! '(< (* 1 1) 2) (lambda () (arith)))
    (dk-only! iff '(< (* 1 1) 2))
    (prop)))
(bo2s-done! 'bo2-onf-dist-gt-one)

;;; ---------------------------------------------------------------------------
;;; NN is countable
(sp (make-wff '(IS-COUNTABLE NN)))
(let ((idf '(VNB-LAMBDA nvc_ NN nvc_)))
  (fact 'nn-is-set)
  (dk-have! (list 'IN idf '(FUN NN NN))
    (lambda () (dk-lam-type! (lambda () (let ((ld (dk-peel!))) (if (not (bo2s-beta!)) (ass)))))))
  (dk-have! (list 'FORALL 'rqy_ (list 'IMPLIES '(IN rqy_ NN)
                (list 'FORSOME 'rqn_ (list 'AND '(IN rqn_ NN) (list '= 'rqy_ (list idf 'rqn_))))))
    (lambda ()
      (let* ((ld (dk-peel!)) (y (cadr (car ld))))
        (ew y)
        (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass) (if (not (bo2s-beta!)) (rfl))))))))
  (fact 'countable-of-enum 'NN idf)
  (if (not (proof-done? *ps*)) (ass)))
(bo2s-done! 'bo2-nn-countable)

;;; ---------------------------------------------------------------------------
;;; in a separable inner product space every orthonormal family has a countable index set
(sp (make-wff
  '(FORALL v (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v)
     (IMPLIES (IS-SEPARABLE (IP-METRIC-SPACE v))
       (FORALL ix (FORALL e (IMPLIES (IS-ORTHONORMAL-FAMILY v ix e)
         (IS-COUNTABLE ix)))))))))
(dk-peel!)
(let* ((typ (bo2s-onf-typ! 'ix 'e))
       (M bo2s-M)
       (PM (list 'PTS M))
       (sh (dk-pick (dk-head? 'IS-SEPARABLE) "separability"))
       (parts (dk-split! (dk-landed-1 (lambda () (mac-h 'is-separable sh)))))
       (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts))
       (dseq (dk-skolem! ex))
       (dens (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a dseq) (dk-contains? a 'FORSOME)))
                      "the density of dseq")))
  (fact 'ip-metric-space-is-metric-space 'v)
  (fact 'ip-metric-space-pts 'v)
  (fact 'fun-domain-in-set 'ix bo2s-V 'e)
  (dk-have! '(POS-RR 1) (lambda () (mac 'pos-rr) (dk-conj-close! (lambda () (arith)))))
  (let* ((h (dk-halve! 1))
         (body (lambda (i n) (list '< (list (list 'DIST M) (list 'e i) (list dseq n)) h)))
         (Cn (lambda (n) (list 'SEP 'iv_ 'ix (body 'iv_ n))))
         (S (list 'SEP 'nv_ 'NN (list 'FORSOME 'iv_ (list 'AND '(IN iv_ ix) (body 'iv_ 'nv_)))))
         (hf (list 'VNB-LAMBDA 'nv_ S (list 'CHOICE (Cn 'nv_))))
         (im (list 'IMAGE hf S))
         ;; n in S in context: land C(n) nonempty, CHOICE C(n) in ix and its ball condition
         (choose! (lambda (n)
                    (let* ((cs (Cn n)) (j (list 'CHOICE cs)))
                      (if (not (dk-asm? (list 'IN j 'ix)))
                          (begin
                            (dk-have! (list 'FORSOME 'cv_ (list 'IN 'cv_ cs))
                              (lambda ()
                                (let* ((ms (dk-split-all! (dk-landed* (lambda () (sep-me (list 'IN n S))))))
                                       (i0 (dk-skolem! (dk-pick (lambda (a) (and (dk-head-is? a 'FORSOME) (dk-contains? a (list dseq n)))) "n in S, opened"))))
                                  (ew i0)
                                  (in-sep! (lambda () (dk-conj-close! (lambda () (ass))))))))
                            (let ((mem (dk-fact! 'choice-axiom cs)))
                              (dk-split-all! (dk-landed* (lambda () (sep-me mem)))))))
                      j))))
    (fact 'rr-pos-rr-in-rr h)
    ;; S is a subset of NN, a set, countable
    (dk-have! (list 'SUBSET S 'NN)
      (lambda ()
        (mac 'subset-def)
        (let ((z (dk-di-var!)))
          (dk-split-all! (dk-landed* (lambda () (sep-me (list 'IN z S)))))
          (ass))))
    (dk-have! (list 'IN S 'SET) (lambda () (sep-set) (fact 'nn-is-set) (ass)))
    (fact 'bo2-nn-countable)
    (fact 'countable-subset S 'NN)
    ;; hf : S -> ix
    (dk-have! (list 'IN hf (list 'FUN S 'ix))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let* ((ld (dk-peel!)) (n (cadr (car ld))))
              (if (not (bo2s-beta!)) #t)
              (choose! n)
              (ass)))
          (lambda () (ass)))))
    (fact 'subset-refl S)
    (fact 'countable-image S hf S 'ix)
    ;; ix is contained in the image
    (dk-have! (list 'SUBSET 'ix im)
      (lambda ()
        (mac 'subset-def)
        (let* ((i (dk-di-var!))
               (x (list 'e i)))
          (fact 'fun-apply-type-c 'e 'ix bo2s-V i)
          (dk-have! (list 'IN x PM) (lambda () (subst (list '== PM bo2s-V)) (ass)))
          (let* ((nx (dk-apply! dens x h))
                 (n (dk-skolem! nx)))
            (dk-have! (list 'IN n S)
              (lambda () (in-sep! (lambda () (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'FORSOME) (begin (ew i) (dk-conj-close! (lambda () (ass)))) (ass))))))))
            (let* ((j (choose! n)))
              (fact 'fun-apply-type-c 'e 'ix bo2s-V j)
              (fact 'fun-apply-type-c dseq 'NN PM n)
              (dk-have! (list 'IN (list 'e j) PM) (lambda () (subst (list '== PM bo2s-V)) (ass)))
              (dk-have! (list '= j i)
                (lambda ()
                  (use-em (list '= j i)
                    (lambda () (ass))
                    (lambda ()
                      (let* ((dji (list (list 'DIST M) (list 'e j) (list 'e i)))
                             (a1 (list (list 'DIST M) (list 'e j) (list dseq n)))
                             (a2 (list (list 'DIST M) (list dseq n) (list 'e i)))
                             (a3 (list (list 'DIST M) x (list dseq n))))
                        (dk-apply! (dk-cite! 'bo2-onf-dist-gt-one 'v 'ix 'e) j i)
                        (fact 'metric-triangle M (list 'e j) (list dseq n) x)
                        (fact 'metric-sym M (list dseq n) x)
                        (for-each (lambda (pq) (fact 'metric-dist-real M (car pq) (cdr pq)))
                                  (list (cons (list 'e j) x) (cons (list 'e j) (list dseq n))
                                        (cons (list dseq n) x) (cons x (list dseq n))))
                        (dk-absurd! (list '< 1 dji) (list '<= dji (list '+ a1 a2))
                                    (list '= a2 a3) (list '< a1 h) (list '< a3 h) (list '= (list '+ h h) 1)
                                    (list 'IN dji 'RR) (list 'IN a1 'RR) (list 'IN a2 'RR) (list 'IN a3 'RR)
                                    (list 'IN h 'RR)))))))
              (mac 'image-membership-iff)
              (dk-conj-close!
                (lambda ()
                  (cond ((equal? (dk-goal) (list 'IN i 'SET)) (fact 'membership-implies-sethood i 'ix) (ass))
                        ((dk-head-is? (dk-goal) 'FORSOME)
                         (ew n)
                         (dk-conj-close!
                           (lambda ()
                             (if (dk-head-is? (dk-goal) 'IN) (ass)
                                 (dk-close-if! (lambda () (bo2s-beta!)) (lambda () (subst (list '= j i)) (rfl)))))))
                        (#t (ass))))))))))
    (fact 'countable-subset 'ix im)
    (if (not (proof-done? *ps*)) (ass))))
(bo2s-done! 'orthonormal-family-countable-of-separable)

;;; ---------------------------------------------------------------------------
;;; a separable inner product space has a countable orthonormal basis
(sp (make-wff
  '(FORALL v (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v)
     (IMPLIES (IS-SEPARABLE (IP-METRIC-SPACE v))
       (FORSOME ix (FORSOME e (AND (IS-ORTHONORMAL-BASIS v ix e) (IS-COUNTABLE ix)))))))))
(dk-peel!)
(let* ((ex (dk-fact! 'onb-exists 'v))
       (ix (dk-skolem! ex))
       (ex2 (dk-pick (dk-head? 'FORSOME) "the basis"))
       (e (dk-skolem! ex2))
       (bh (dk-pick (dk-head? 'IS-ORTHONORMAL-BASIS) "the basis")))
  (dk-project! (list 'IS-ORTHONORMAL-FAMILY 'v ix e) 'is-orthonormal-basis bh)
  (dk-apply! (dk-cite! 'orthonormal-family-countable-of-separable 'v) ix e)
  (ew ix)
  (ew e)
  (dk-conj-close! (lambda () (ass))))
(bo2s-done! 'separable-hilbert-countable-basis)
