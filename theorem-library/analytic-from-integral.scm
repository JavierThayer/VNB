;;; HELPERS AND (A)-(J): CONTINUITY ON A SUBSET u OF CC
;;; ===========================================================================
(define aif-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (aif-sub u) (list 'SUBSPACE-MS aif-nfm u))
(define (aif-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u)
    (list 'IS-CONTINUOUS-AT (aif-sub u) aif-nfm f 'rgy_))))
(define (aif-imps hs concl)
  (if (null? hs) concl (list 'IMPLIES (car hs) (aif-imps (cdr hs) concl))))
(define (aif-alls vs body)
  (if (null? vs) body (list 'FORALL (car vs) (aif-alls (cdr vs) body))))
(define (aif-ptw u h rhs-of)
  (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ u) (list '== (list h 'aix_) (rhs-of 'aix_)))))

(define (aif-cc! t) (dk-type! t 'CC))
(define (aif-real! t) (dk-type! t 'RR))

;;; the metric facts every continuity step needs, landed once per proof:
;;; is-metric-space(NFM), pts(NFM) == CC, u subset pts(NFM),
;;; is-metric-space(subspace-ms(NFM, u)) (which certifies the subspace term
;;; DEFINED before any instantiation at it), pts(subspace-ms(NFM, u)) == u.
(define (aif-ms! u)
  (fact 'nf-cc-is-metric-space)
  (fact 'nf-metric-carrier 'CC-NORMED-FIELD)
  (fact 'cc-nf-carr)
  (dk-have! (list '== (list 'PTS aif-nfm) 'CC)
    (lambda () (subst (list '== (list 'PTS aif-nfm) '(CARR CC-NORMED-FIELD))) (ass)))
  (dk-have! (list 'SUBSET u (list 'PTS aif-nfm))
    (lambda () (subst (list '== (list 'PTS aif-nfm) 'CC)) (ass)))
  (dk-have! (list 'IN u 'SET)
    (lambda () (fact 'cc-is-set) (fact 'subclass-of-set-is-set u 'CC) (ass)))
  (fact 'subspace-is-metric-space aif-nfm u)
  (fact 'subspace-pts aif-nfm u))



;;; the continuity hypothesis CONT(u, f) as the context holds it, at y
(define (aif-cont-at! u f y) (dk-apply! (dk-ctx-form (aif-cont u f)) y))

;;; (aif-transfer! u h lam y rhs-of) -- the focus goal is CONT(u, h) at y, i.e.
;;; is-continuous-at(subspace-ms(NFM, u), NFM, h, y), and is-continuous-at of LAM
;;; at y is in context.  LAM's domain is u or pts(subspace-ms(NFM, u)).  The
;;; pointwise h(x) == RHS-OF(x) is in context; LAM(x) beta-reduces to RHS-OF(x).
(define (aif-transfer! u h lam y rhs-of)
  (let ((ptw (dk-ctx-form (aif-ptw u h rhs-of))))
    (dk-have! (list 'FORALL 'aiy_ (list 'IMPLIES (list 'IN 'aiy_ u)
                (list '= (list h 'aiy_) (list lam 'aiy_))))
      (lambda ()
        (let* ((v (dk-di-var!)) (hv (list h v)) (rv (rhs-of v)))
          (dk-have! (list 'IN v (list 'PTS (aif-sub u)))
            (lambda () (subst (list '== (list 'PTS (aif-sub u)) u)) (ass)))
          (fact 'fun-apply-type-c h u 'CC v)
          (dk-apply! ptw v)
          (dk-lam-b!)
          (subst (list '= rv hv))
          (rfl))))
    (fact 'ms-cont-transfer-on (aif-sub u) aif-nfm u 'CC lam h y)
    (ass)))

;;; K1 / K2: the product and the sum of two maps continuous on u.
(define (aif-binop-thm! name op nf-law nf-apply)
  (sp (make-wff
    (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC)
      (aif-alls '(f g h)
        (aif-imps (list '(IN f (FUN u CC)) (aif-cont 'u 'f) '(IN g (FUN u CC)) (aif-cont 'u 'g)
                        '(IN h (FUN u CC))
                        (aif-ptw 'u 'h (lambda (x) (list op (list 'f x) (list 'g x)))))
          (aif-cont 'u 'h)))))))
  (dk-peel!)
  (aif-ms! 'u)
  (let* ((y (list-ref (dk-goal) 4))
         (ptw (dk-ctx-form (aif-ptw 'u 'h (lambda (x) (list op (list 'f x) (list 'g x)))))))
    (aif-cont-at! 'u 'f y)
    (aif-cont-at! 'u 'g y)
    (fact 'cc-is-normed-field)
    (let* ((c (dk-fact! nf-law 'CC-NORMED-FIELD (aif-sub 'u) 'u 'f 'g y))
           (lam (list-ref c 3)))
      (dk-have! (list 'FORALL 'aiy_ (list 'IMPLIES '(IN aiy_ u) (list '= '(h aiy_) (list lam 'aiy_))))
        (lambda ()
          (let* ((v (dk-di-var!)) (fv (list 'f v)) (gv (list 'g v)))
            (fact 'fun-apply-type-c 'f 'u 'CC v)
            (fact 'fun-apply-type-c 'g 'u 'CC v)
            (fact 'fun-apply-type-c 'h 'u 'CC v)
            (dk-apply! ptw v)
            (dk-lam-b!)
            (subst (dk-fact! nf-apply fv gv))
            (subst (list '= (list op fv gv) (list 'h v)))
            (rfl))))
      (fact 'ms-cont-transfer-on (aif-sub 'u) aif-nfm 'u 'CC lam 'h y)
      (ass)))
  (qed name))

(aif-binop-thm! 'aif-cont-product '* 'nf-product-continuous-on 'cc-nf-mul-apply)
(aif-binop-thm! 'aif-cont-sum '+ 'nf-sum-continuous-on 'cc-nf-add-apply)

