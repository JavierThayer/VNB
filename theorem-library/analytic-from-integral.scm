;;; =====================================================================
;;; DELIVERABLE 4.  THE CAUCHY ESTIMATE of the coefficients (the length-times-sup
;;; bound): with |phi| <= M on the trace,
;;;   | int_gamma phi(w) (1/(w-c))^(k+1) dw | <= len(gamma) M (1/r)^(k+1),
;;; and the same times |kap| for the coefficients kap a_k of deliverable 3.
;;; =====================================================================
(define aif-bnd-h '(FORALL aiy_ (IMPLIES (IN aiy_ (TRACE pgam a b)) (<= (magnitude (phi aiy_)) aim_))))
(define (aif-bnd k) (list '* 'aim_ (list 'power '(recip r) (list 'succ k))))
(define (aif-est-thm! name with-kap?)
  (sp (make-wff
    (aif-alls '(u c r phi pgam dgam a b)
      (aif-imps (remove (lambda (h) (equal? h '(IN z CC))) aif-set-h)
        (list 'FORALL 'aim_ (aif-imps (list '(IN aim_ RR) aif-bnd-h)
          (let ((body (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
                         (if with-kap?
                             (list '<= (list 'magnitude (list '* 'kap (aif-LI (aif-H 'k))))
                                   (list '* '(magnitude kap) (list '* '(ROAD-LENGTH dgam a b) (aif-bnd 'k))))
                             (list '<= (list 'magnitude (aif-LI (aif-H 'k)))
                                   (list '* '(ROAD-LENGTH dgam a b) (aif-bnd 'k))))))))
            (if with-kap? (list 'FORALL 'kap (list 'IMPLIES '(IN kap CC) body)) body))))))))
  (dk-peel!)
  (aif-ms! 'u)
  (aif-R!)
  (let* ((k (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'NN))) "k")))
         (Hk (aif-H k)) (bnd (aif-bnd k)) (k1 (list 'succ k)))
    (aif-H! k)
    (fact 'nn-succ-closed k)
    (dk-have! '(NOT (= r 0)) (lambda () (di) (dk-absurd! '(IN r RR) '(< 0 r) '(= r 0))))
    (dk-have! '(AND (IN r RR) (NOT (= r 0))))
    (fact 'rr-recip-closed 'r)
    (fact 'rr-recip-pos 'r)
    (fact 'power-real-closed '(recip r) k1)
    (aif-real! bnd)
    (dk-have! (list 'FORALL 'bny_ (list 'IMPLIES '(IN bny_ (TRACE pgam a b)) (list '<= (list 'magnitude (list Hk 'bny_)) bnd)))
      (lambda ()
        (let* ((y (dk-di-var!))
               (s (list 'recip (list '- y 'c)))
               (pw (list 'power s k1)))
          (fact 'subset-mem-fwd '(TRACE pgam a b) 'u y)
          (aif-pt! y)
          (dk-apply! (dk-ctx-form aif-bnd-h) y)
          (dk-lam-b!)
          (aif-cc! pw)
          (dk-have! (list 'AND (list 'IN (list 'phi y) 'CC) (list 'IN pw 'CC)))
          (subst (dk-fact! 'cc-magnitude-mul (list 'phi y) pw))
          (subst (dk-fact! 'cc-magnitude-power k1 s))
          (fact 'cc-magnitude-closed (list 'phi y))
          (fact 'cc-magnitude-nonneg (list 'phi y))
          (fact 'cc-magnitude-closed s)
          (fact 'cc-magnitude-nonneg s)
          (fact 'cc-magnitude-closed (list '- y 'c))
          (fact 'aif-magnitude-recip (list '- y 'c))
          (fact 'rr-recip-antitone 'r (list 'magnitude (list '- y 'c)))
          (dk-have! (list '<= (list 'magnitude s) '(recip r))
            (lambda () (subst (list '= (list 'magnitude s) (list 'recip (list 'magnitude (list '- y 'c))))) (aif-close!)))
          (fact 'rr-power-mono-base k1 (list 'magnitude s) '(recip r))
          (fact 'rr-power-nonneg k1 (list 'magnitude s))
          (fact 'power-real-closed (list 'magnitude s) k1)
          (aif-prod-le! (list 'magnitude (list 'phi y)) 'aim_ (list 'power (list 'magnitude s) k1) (list 'power '(recip r) k1))
          (aif-close!))))
    (let ((lbd (dk-fact! 'line-int-length-bound 'u Hk 'pgam 'dgam 'a 'b bnd)))
      (if with-kap?
          (let* ((li (aif-LI Hk)) (L '(ROAD-LENGTH dgam a b)) (lbnd (list '* L bnd)))
            (dk-have! (list 'AND '(IN kap CC) (list 'IN li 'CC)))
            (subst (dk-fact! 'cc-magnitude-mul 'kap li))
            (fact 'cc-magnitude-closed 'kap)
            (fact 'cc-magnitude-nonneg 'kap)
            (fact 'cc-magnitude-closed li)
            (fact 'road-length-in-rr 'pgam 'dgam 'a 'b)
            (aif-real! lbnd)
            (dk-have! (list 'AND '(<= 0 (magnitude kap)) (list '<= (list 'magnitude li) lbnd)))
            (fact 'rr-le-scale-nonneg '(magnitude kap) (list 'magnitude li) lbnd)
            (aif-close!))
          (aif-close!))))
  (qed name))
(aif-est-thm! 'aif-coefficient-bound #f)
