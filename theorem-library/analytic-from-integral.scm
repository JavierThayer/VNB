(fact 'series-scale-converges aif-ab-g aif-ab-C aif-ab-h)
(define aif-ab-id
  '(FORALL aiu1_ (IMPLIES (IN aiu1_ RR) (FORALL aiu2_ (IMPLIES (IN aiu2_ RR) (FORALL aiu3_ (IMPLIES (IN aiu3_ RR)
     (FORALL aiu4_ (IMPLIES (IN aiu4_ RR) (FORALL aiu5_ (IMPLIES (IN aiu5_ RR)
       (= (* (* aiu1_ (* aiu2_ (* aiu3_ aiu4_))) aiu5_) (* (* (* aiu1_ aiu2_) aiu3_) (* aiu5_ aiu4_))))))))))))))
(dk-have! aif-ab-id (lambda () (dk-peel!) (crs)))
(fact 'rr-subset-cc '(recip r))
(dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
            (list 'AND (list '<= 0 (list aif-absf 'n)) (list '<= (list aif-absf 'n) (list aif-ab-h 'n)))))
  (lambda ()
    (let* ((j (dk-di-var!))
           (li (aif-LI (aif-H j))) (qj (list 'power '(- z c) j))
           (rhoj (list 'power aif-rho j)) (irj (list 'power '(recip r) j))
           (B (list '* aif-ab-L (list '* aif-ab-M (list 'power '(recip r) (list 'succ j))))))
      (aif-H! j)
      (aif-cc! qj)
      (aif-cc! (list '* li qj))
      (fact 'cc-magnitude-closed (list '* li qj))
      (fact 'cc-magnitude-nonneg (list '* li qj))
      (fact 'cc-magnitude-closed li)
      (fact 'power-real-closed aif-rho j)
      (fact 'rr-power-nonneg j aif-rho)
      (fact 'power-real-closed '(recip r) j)
      (fact 'power-real-closed aif-ab-x j)
      (fact 'nn-succ-closed j)
      (fact 'power-real-closed '(recip r) (list 'succ j))
      (aif-real! B)
      (aif-real! (list '* aif-ab-C (list 'power aif-ab-x j)))
      (let ((cb (dk-fact! 'aif-coefficient-bound 'u 'c 'r 'phi 'pgam 'dgam 'a 'b aif-ab-M j)))
        (fact 'rr-mul-le-right (list 'magnitude li) B rhoj)
        (aif-real! (list '* (list 'magnitude li) rhoj))
        (aif-real! (list '* B rhoj))
        (dk-have! (list '= (list '* B rhoj) (list '* aif-ab-C (list 'power aif-ab-x j)))
          (lambda ()
            (dk-have! (list 'AND '(IN (recip r) CC) (list 'IN j 'NN)))
            (subst (dk-fact! 'power-succ '(recip r) j))
            (subst (dk-fact! 'rr-power-mul-base j aif-rho '(recip r)))
            (dk-apply! (dk-ctx-form aif-ab-id) aif-ab-L aif-ab-M '(recip r) irj rhoj)
            (aif-close!)))
        (dk-lam-b!)
        (dk-conj-close!
          (lambda ()
            (if (equal? (cadr (dk-goal)) 0) (aif-close!)
                (begin
                  (dk-have! (list 'AND (list 'IN li 'CC) (list 'IN qj 'CC)))
                  (subst (dk-fact! 'cc-magnitude-mul li qj))
                  (subst (dk-fact! 'cc-magnitude-power j '(- z c)))
                  (dk-ineq! (list 'IN (list '* (list 'magnitude li) rhoj) 'RR) (list 'IN (list '* B rhoj) 'RR)
                            (list 'IN (list '* aif-ab-C (list 'power aif-ab-x j)) 'RR)
                            (list '<= (list '* (list 'magnitude li) rhoj) (list '* B rhoj))
                            (list '= (list '* B rhoj) (list '* aif-ab-C (list 'power aif-ab-x j))))))))))))
(dk-have! (list 'IN aif-absf '(FUN NN RR))
  (lambda () (dk-lam-type! (lambda () (let* ((j (dk-di-var!)) (li (aif-LI (aif-H j))) (qj (list 'power '(- z c) j)))
                                        (aif-H! j) (aif-cc! qj) (aif-cc! (list '* li qj))
                                        (fact 'cc-magnitude-closed (list '* li qj)) (aif-close!))))))
(dk-have! (list 'AND (dk-ctx-form (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
            (list 'AND (list '<= 0 (list aif-absf 'n)) (list '<= (list aif-absf 'n) (list aif-ab-h 'n))))))
                 (list 'SERIES-CONVERGES aif-ab-h)))
(fact 'comparison-test aif-absf aif-ab-h)
(aif-close!)
(qed 'cauchy-kernel-series-absolute)

;;; =====================================================================
;;; THE TREE'S OWN PREDICATE: IS-ANALYTIC-AT (Def 2.11, analytic-log.scm).
;;; Deliverable 3 with an open U holding the disc: f is analytic at c on U.
;;; The radius: absolute convergence at |z - c| = 3r/4 puts 3r/4 in the
;;; CPS-RADIUS set (the route of cps-log-radius), so r/2 < CPS-RADIUS.
;;; =====================================================================
(define (aif-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! dk-ass!))))))))
(define aif-an-r2 '(* 1/2 r))
(define aif-an-t '(* 3/4 r))
(sp (make-wff
  (aif-alls '(u c r phi pgam dgam a b)
    (aif-imps aif-set-h
      (list 'FORALL 'kap (list 'IMPLIES '(IN kap CC)
        (list 'FORALL 'aiou_ (aif-imps '((IS-OPEN CC-MS aiou_) (SUBSET (BALL CC-MS c r) aiou_))
          (list 'FORALL 'f (aif-imps (list '(IN f (FUN aiou_ CC)) aif-formula)
            '(IS-ANALYTIC-AT f aiou_ c)))))))))))
(dk-peel!)
(aif-setting!)
(fact 'cc-is-metric-space)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(define aif-an-pair
  (dk-abstract! 'NN 'CC (lambda (k) (list '* 'kap (aif-LI (aif-H k))))
                (lambda (k) (aif-H! k) (aif-cc! (list '* 'kap (aif-LI (aif-H k)))) (aif-close!))))
(define aif-an-g (car aif-an-pair))
(define aif-an-ve (cdr aif-an-pair))
(for-each aif-real! (list aif-an-r2 aif-an-t))
(dk-have! (list '< 0 aif-an-r2) (lambda () (dk-ineq! '(IN r RR) '(< 0 r))))
(dk-have! (list '<= 0 aif-an-t) (lambda () (dk-ineq! '(IN r RR) '(< 0 r))))
(dk-have! (list '< aif-an-r2 aif-an-t) (lambda () (dk-ineq! '(IN r RR) '(< 0 r))))
(dk-have! (list '< aif-an-t 'r) (lambda () (dk-ineq! '(IN r RR) '(< 0 r))))
(dk-have! (list '< aif-an-r2 'r) (lambda () (dk-ineq! '(IN r RR) '(< 0 r))))
(define aif-an-D (lambda (z) (list (list 'DIST 'CC-MS) 'c z)))
(define (aif-an-in-disc! z rho)
  ;; z in BALL(CC-MS, c, rho) in context, rho < r in context: lands z in CC,
  ;; |z - c| < r and z in aiou_
  (let ((mem (list 'IN z (list 'BALL 'CC-MS 'c rho)))
        (d (aif-an-D z)))
    (dk-project! (list 'IN z '(PTS CC-MS)) 'ball-membership mem)
    (dk-project! (list '<= d rho) 'ball-membership mem)
    (dk-have! (list 'IN z 'CC) (lambda () (subst '(== CC (PTS CC-MS))) (ass)))
    (aif-cc! (list '- 'c z)) (aif-cc! (list '- z 'c))
    (fact 'cc-magnitude-closed (list '- 'c z))
    (fact 'cc-magnitude-closed (list '- z 'c))
    (dk-have! (list '= d (list 'magnitude (list '- 'c z)))
      (lambda () (subst (dk-fact! 'cc-ms-dist 'c z)) (rfl)))
    (dk-have! (list 'IN d 'RR) (lambda () (subst (list '= d (list 'magnitude (list '- 'c z)))) (ass)))
    (fact 'cc-magnitude-sub-sym 'c z)
    (dk-have! (list '< (list 'magnitude (list '- z 'c)) 'r)
      (lambda () (dk-ineq! (list 'IN d 'RR) (list 'IN (list 'magnitude (list '- 'c z)) 'RR)
                           (list 'IN (list 'magnitude (list '- z 'c)) 'RR) '(IN r RR) (list 'IN rho 'RR)
                           (list '= d (list 'magnitude (list '- 'c z)))
                           (list '= (list 'magnitude (list '- 'c z)) (list 'magnitude (list '- z 'c)))
                           (list '<= d rho) (list '< rho 'r))))
    (dk-have! (list '<= d d) (lambda () (dk-ineq! (list 'IN d 'RR))))
    (dk-have! (list '< d 'r) (lambda () (dk-ineq! (list 'IN d 'RR) '(IN r RR) (list 'IN rho 'RR) (list '<= d rho) (list '< rho 'r))))
    (dk-have! '(IN c (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
    (dk-have! (list 'AND (list 'IN z '(PTS CC-MS)) (list 'AND (list 'IN d 'RR) (list 'AND '(IN r RR)
                (list 'AND (list '<= d d) (list '< d 'r))))))
    (fact 'ball-mem-from-le 'CC-MS 'c z d 'r)
    (fact 'subset-mem-fwd '(BALL CC-MS c r) 'aiou_ z)))
;; 2. the small ball lies in U
(dk-have! (list 'SUBSET (list 'BALL 'CC-MS 'c aif-an-r2) 'aiou_)
  (lambda () (mac 'subset-def) (let ((x (dk-di-var!))) (aif-an-in-disc! x aif-an-r2) (aif-close!))))

;; 3. the values: f(z) is the sum of the series with coefficients G(k)
(define (aif-an-S z) (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list aif-an-g 'cpsk_) (list 'power (list '- z 'c) 'cpsk_))))
(define (aif-an-H3 z) (aif-repl aif-H3 'z z))
(define (aif-an-H3-typ! z)
  (dk-have! (list 'IN (aif-an-H3 z) '(FUN NN CC))
    (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                                          (aif-H! j)
                                          (aif-cc! (list '* (list '* 'kap (aif-LI (aif-H j))) (list 'power (list '- z 'c) j)))
                                          (aif-close!)))))))
(dk-have! (list 'FORALL 'algz_ (list 'IMPLIES (list 'IN 'algz_ (list 'BALL 'CC-MS 'c aif-an-r2))
            (list '= '(f algz_) (list 'CC-SERIES-LIMIT (aif-an-S 'algz_)))))
  (lambda ()
    (let* ((z (dk-di-var!)) (S (aif-an-S z)) (H3 (aif-an-H3 z)) (fz (list 'f z)))
      (aif-an-in-disc! z aif-an-r2)
      (fact 'fun-apply-type-c 'f 'aiou_ 'CC z)
      (let ((ct (dk-fact! 'analytic-from-integral-formula 'u 'c 'r 'phi 'pgam 'dgam 'a 'b 'kap 'f z)))
        (aif-an-H3-typ! z)
        (dk-have! (list 'CC-SERIES-CONVERGES H3)
          (lambda () (mac 'cc-series-converges) (mac 'converges) (ew fz)
                      (mac-h 'cc-series-converges-to (dk-ctx-form ct)) (aif-close!)))
        (fact 'cc-series-limit-converges-to H3)
        (fact 'cc-series-limit-in-cc H3)
        (let ((lim (list 'CC-SERIES-LIMIT H3))
              (ps (list 'VNB-LAMBDA 'k 'NN (list 'CC-SERIES-PARTIAL-SUM H3 'k))))
          (dk-have! (list '= lim fz)
            (lambda ()
              (dk-project! (list 'CONVERGES-TO 'CC-MS ps lim) 'cc-series-converges-to (list 'CC-SERIES-CONVERGES-TO H3 lim))
              (dk-project! (list 'CONVERGES-TO 'CC-MS ps fz) 'cc-series-converges-to (list 'CC-SERIES-CONVERGES-TO H3 fz))
              (fact 'metric-limit-unique 'CC-MS ps lim fz)
              (aif-close!)
              (aif-owed!)))
          (dk-fun-ext! S H3 'NN 'CC
            (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                                                  (fact 'fun-apply-type-c aif-an-g 'NN 'CC j)
                                                  (aif-cc! (list '* (list aif-an-g j) (list 'power (list '- z 'c) j)))
                                                  (aif-close!)))))
            #f
            (lambda (v)
              (aif-H! v)
              (aif-cc! (list '* (list '* 'kap (aif-LI (aif-H v))) (list 'power (list '- z 'c) v)))
              (dk-lam-b!)
              (subst (dk-apply! aif-an-ve v))
              (rfl)))
          (subst (list '= S H3))
          (subst (list '= lim fz))
          (rfl))))))

;; 1. the radius: 3r/4 lies in the CPS-RADIUS set, so r/2 < CPS-RADIUS(G)
(define aif-an-zt (list '+ 'c aif-an-t))
(define aif-an-E
  (list 'SEP 'cpsr_ 'RR (list 'AND '(<= 0 cpsr_)
    (list 'SERIES-CONVERGES (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list 'magnitude (list aif-an-g 'cpsk_)) '(power cpsr_ cpsk_)))))))
(define aif-an-tgt (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list 'magnitude (list aif-an-g 'cpsk_)) (list 'power aif-an-t 'cpsk_))))
(define aif-an-absf (aif-repl aif-absf 'z aif-an-zt))
(fact 'rr-subset-cc aif-an-t)
(aif-cc! aif-an-zt)
(dk-have! (list '= (list '- aif-an-zt 'c) aif-an-t) (lambda () (crs)))
(fact 'rr-magnitude-is-abs aif-an-t)
(fact 'rr-abs-of-nonneg aif-an-t)
(dk-have! (list '= (list 'magnitude aif-an-t) aif-an-t)
  (lambda () (subst (list '= (list 'magnitude aif-an-t) (list 'abs aif-an-t))) (aif-close!)))
(dk-have! (list '< (list 'magnitude (list '- aif-an-zt 'c)) 'r)
  (lambda () (subst (list '= (list '- aif-an-zt 'c) aif-an-t))
              (subst (list '= (list 'magnitude aif-an-t) aif-an-t)) (aif-close!)))
(fact 'cauchy-kernel-series-absolute 'u 'c 'r 'phi 'pgam 'dgam 'a 'b aif-an-zt)
(fact 'cc-magnitude-closed 'kap)
(fact 'cc-magnitude-nonneg 'kap)
(define aif-an-assoc
  '(FORALL aiu1_ (IMPLIES (IN aiu1_ RR) (FORALL aiu2_ (IMPLIES (IN aiu2_ RR) (FORALL aiu3_ (IMPLIES (IN aiu3_ RR)
     (= (* (* aiu1_ aiu2_) aiu3_) (* aiu1_ (* aiu2_ aiu3_))))))))))
(dk-have! aif-an-assoc (lambda () (dk-peel!) (crs)))
(define (aif-an-q j) (list 'power (list '- aif-an-zt 'c) j))
(dk-have! (list 'IN aif-an-absf '(FUN NN RR))
  (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                                        (aif-H! j) (aif-cc! (aif-an-q j))
                                        (aif-cc! (list '* (aif-LI (aif-H j)) (aif-an-q j)))
                                        (fact 'cc-magnitude-closed (list '* (aif-LI (aif-H j)) (aif-an-q j)))
                                        (aif-close!))))))
(dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN) (list '<= 0 (list aif-an-absf 'cpsk_))))
  (lambda () (let ((j (dk-di-var!)))
               (aif-H! j) (aif-cc! (aif-an-q j))
               (aif-cc! (list '* (aif-LI (aif-H j)) (aif-an-q j)))
               (fact 'cc-magnitude-nonneg (list '* (aif-LI (aif-H j)) (aif-an-q j)))
               (if (not (dk-lam-b!)) (ass)))))
(dk-have! (list 'IN aif-an-tgt '(FUN NN RR))
  (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                                        (fact 'fun-apply-type-c aif-an-g 'NN 'CC j)
                                        (fact 'cc-magnitude-closed (list aif-an-g j))
                                        (fact 'power-real-closed aif-an-t j)
                                        (aif-real! (list '* (list 'magnitude (list aif-an-g j)) (list 'power aif-an-t j)))
                                        (aif-close!))))))
(dk-have! (list 'FORALL 'cpsk_ (list 'IMPLIES '(IN cpsk_ NN)
            (list '= (list aif-an-tgt 'cpsk_) (list '* '(magnitude kap) (list aif-an-absf 'cpsk_)))))
  (lambda ()
    (let* ((j (dk-di-var!)) (A (aif-LI (aif-H j))) (q (list '- aif-an-zt 'c)) (tj (list 'power aif-an-t j)))
      (aif-H! j) (aif-cc! (aif-an-q j))
      (fact 'power-real-closed aif-an-t j)
      (fact 'cc-magnitude-closed A)
      (dk-lam-b!)
      (subst (dk-apply! aif-an-ve j))
      (dk-have! (list 'AND '(IN kap CC) (list 'IN A 'CC)))
      (subst (dk-fact! 'cc-magnitude-mul 'kap A))
      (dk-have! (list 'AND (list 'IN A 'CC) (list 'IN (aif-an-q j) 'CC)))
      (subst (dk-fact! 'cc-magnitude-mul A (aif-an-q j)))
      (subst (dk-fact! 'cc-magnitude-power j q))
      (subst (list '= q aif-an-t))
      (subst (list '= (list 'magnitude aif-an-t) aif-an-t))
      (dk-apply! (dk-ctx-form aif-an-assoc) '(magnitude kap) (list 'magnitude A) tj)
      (aif-close!))))
(fact 'series-scale-converges aif-an-absf '(magnitude kap) aif-an-tgt)
(dk-have! (list 'IN aif-an-t aif-an-E)
  (lambda () (in-sep! (lambda () (dk-conj-close! dk-ass!)))))
(dk-have! (list 'SUBSET aif-an-E 'RR-POS-STAR)
  (lambda ()
    (mac 'subset-def)
    (let ((x (dk-di-var!)))
      (sep-me (list 'IN x aif-an-E))
      (dk-split-all!)
      (mac 'rr-pos-star-membership)
      (oi-l)
      (dk-conj-close! dk-ass!))))
(define aif-an-sup (list 'ESUP aif-an-E))
(dk-apply! (dk-cite! 'esup-upper aif-an-E) aif-an-t)
(fact 'esup-in aif-an-E)
(dk-have! (list '< aif-an-r2 (list 'CPS-RADIUS aif-an-g))
  (lambda ()
    (subst (dk-fact! 'cps-radius-unfold aif-an-g))
    (mac-h 'rr-pos-star-membership (list 'IN aif-an-sup 'RR-POS-STAR))
    (use-cases (dk-pick (dk-head? 'OR) "the two kinds of extended real")
      (lambda ()
        (dk-split-all!)
        (dk-ineq! (list '< aif-an-r2 aif-an-t) (list '<= aif-an-t aif-an-sup)))
      (lambda ()
        (subst (list '= aif-an-sup 'POS-INF))
        (mac '<)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) '<=)
                (begin
                  (dk-have! (list 'IN aif-an-r2 'RR-POS-STAR)
                    (lambda () (mac 'rr-pos-star-membership) (oi-l)
                                (dk-have! (list '<= 0 aif-an-r2) (lambda () (dk-ineq! '(IN r RR) '(< 0 r))))
                                (dk-conj-close! dk-ass!)))
                  (fact 'rr-pos-star-below-pos-inf aif-an-r2)
                  (ass))
                (begin
                  (di)
                  (fact 'pos-inf-not-in-rr)
                  (dk-have! '(IN POS-INF RR) (lambda () (subst (list '= 'POS-INF aif-an-r2)) (ass)))
                  (ai '(NOT (IN POS-INF RR)))))))))))
(fact 'analytic-at-intro 'f 'aiou_ aif-an-g 'c aif-an-r2)
(aif-close!)
(qed 'analytic-at-from-integral-formula)
