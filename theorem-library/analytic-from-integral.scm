(define aif-rlam (list 'VNB-LAMBDA 'crz_ aif-nz '(recip crz_)))
(sp (make-wff
  (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC)
    (list 'FORALL 'c (aif-imps (list '(IN c CC) '(FORALL aix_ (IMPLIES (IN aix_ u) (NOT (= aix_ c)))))
      (list 'FORALL 'h (aif-imps (list '(IN h (FUN u CC)) (aif-ptw 'u 'h (lambda (x) (list 'recip (list '- x 'c)))))
                         (aif-cont 'u 'h)))))))))
(dk-peel!)
(aif-ms! 'u)
(define aif-d-y (list-ref (dk-goal) 4))
(define aif-d-lam '(VNB-LAMBDA aiz_ u (- aiz_ c)))
(dk-have! (list 'IN aif-d-lam '(FUN u CC))
  (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!)))
                                        (fact 'subset-mem-fwd 'u 'CC v)
                                        (aif-cc! (list '- v 'c)))))))
(dk-have! (aif-ptw 'u aif-d-lam (lambda (x) (list '- x 'c)))
  (lambda () (dk-di-var!) (if (not (dk-lam-b!)) (qrfl))))
(fact 'aif-cont-shift 'u 'c aif-d-lam)
;; the values avoid 0
(define (aif-nz! v)
  ;; v in u in context; lands (IN (- v c) aif-nz)
  (fact 'subset-mem-fwd 'u 'CC v)
  (aif-cc! (list '- v 'c))
  (dk-apply! (dk-ctx-form '(FORALL aix_ (IMPLIES (IN aix_ u) (NOT (= aix_ c))))) v)
  (dk-have! (list 'NOT (list '= (list '- v 'c) 0))
    (lambda ()
      (di)
      (fact 'cc-sub-zero-eq v 'c)
      (ai (dk-ctx-form (list 'NOT (list '= v 'c))))))
  (dk-have! (list 'IN (list '- v 'c) aif-nz)
    (lambda () (mac 'cc-nonzero-membership) (dk-conj-close! dk-ass!))))
(dk-have! (list 'FORALL 'aix_ (list 'IMPLIES '(IN aix_ u) (list 'IN (list aif-d-lam 'aix_) aif-nz)))
  (lambda ()
    (let ((v (dk-di-var!)))
      (aif-nz! v)
      (dk-lam-b!)
      (if (dk-open-leaves) (ass)))))
(fact 'cc-nonzero-subset)
(fact 'cc-recip-continuous-at)
(dk-have! (aif-ptw 'u 'h (lambda (x) (list aif-rlam (list aif-d-lam x))))
  (lambda ()
    (let ((v (dk-di-var!)))
      (aif-nz! v)
      (dk-apply! (dk-ctx-form (aif-ptw 'u 'h (lambda (x) (list 'recip (list '- x 'c))))) v)
      (dk-lam-b!)
      (if (dk-open-leaves) (ass)))))
(dk-apply! (dk-fact! 'aif-cont-compose 'u aif-d-lam aif-nz aif-rlam 'h) aif-d-y)
(ass)
(qed 'aif-cont-recip-shift)

(define (aif-owed!)
  ;; close the owed definedness leaves (= t t) left open by an instantiation
  (let ((home (proof-state-focus *ps*)))
    (for-each (lambda (n)
                (let ((g (dk-goal-of n)))
                  (if (and (dk-head-is? g '=) (equal? (cadr g) (caddr g)))
                      (begin (dk-focus! n) (rfl)))))
              (dk-open-leaves))
    (if (not (sequent-node-grounded? home)) (dk-focus! home))))
(define (aif-close!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (aif-dump tag)
  (display "\n;; DUMP ") (display tag)
  (for-each (lambda (n) (display "\n;;   LEAF ") (display (expression->string (dk-goal-of n)))) (dk-open-leaves))
  (if (pair? (dk-open-leaves))
      (begin (display "\n;;   FOCUS ") (display (expression->string (dk-goal)))
             (for-each (lambda (f) (display "\n;;     ctx ") (display (expression->string f))) (list-head (dk-asms) (min 12 (length (dk-asms))))))))

;;; (E) x |-> g(x)^n, g continuous on u.
(define aif-plam '(VNB-LAMBDA aiz_ CC (power aiz_ n)))
(sp (make-wff
  (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC)
    (list 'FORALL 'g (aif-imps (list '(IN g (FUN u CC)) (aif-cont 'u 'g))
      (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
        (list 'FORALL 'h (aif-imps (list '(IN h (FUN u CC)) (aif-ptw 'u 'h (lambda (x) (list 'power (list 'g x) 'n))))
                           (aif-cont 'u 'h)))))))))))
(dk-peel!)
(aif-ms! 'u)
(define aif-e-y (list-ref (dk-goal) 4))
(fact 'subset-refl 'CC)
(aif-ms! 'CC)
(aif-cc-open!)
(dk-have! (list 'IN aif-plam '(FUN CC CC))
  (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (aif-cc! (list 'power v 'n)))))))
(dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES '(IN hbz_ CC) (list '== (list aif-plam 'hbz_) '(power hbz_ n))))
  (lambda () (dk-di-var!) (if (not (dk-lam-b!)) (qrfl))))
(fact 'holomorphic-power 'n 'CC aif-plam)
(fact 'holomorphic-on-continuous 'CC aif-plam)
(dk-have! '(FORALL aix_ (IMPLIES (IN aix_ u) (IN (g aix_) CC)))
  (lambda () (let ((v (dk-di-var!))) (fact 'fun-apply-type-c 'g 'u 'CC v) (aif-close!))))
(dk-have! (aif-ptw 'u 'h (lambda (x) (list aif-plam (list 'g x))))
  (lambda ()
    (let ((v (dk-di-var!)))
      (fact 'fun-apply-type-c 'g 'u 'CC v)
      (dk-apply! (dk-ctx-form (aif-ptw 'u 'h (lambda (x) (list 'power (list 'g x) 'n)))) v)
      (dk-lam-b!)
      (aif-close!))))
(dk-apply! (dk-fact! 'aif-cont-compose 'u 'g 'CC aif-plam 'h) aif-e-y)
(aif-close!)
(qed 'aif-cont-power-of)

;;; (F) |1/d| = 1/|d|
(sp (make-wff '(FORALL d (IMPLIES (IN d CC) (IMPLIES (NOT (= d 0))
   (= (magnitude (recip d)) (recip (magnitude d))))))))
(dk-peel!)
(dk-have! '(AND (IN d CC) (NOT (= d 0))))
(fact 'cc-recip-closed 'd)
(fact 'cc-recip-inverse 'd)
(dk-have! '(AND (IN d CC) (IN (recip d) CC)))
(fact 'cc-magnitude-mul 'd '(recip d))
(fact 'cc-magnitude-closed 'd)
(fact 'cc-magnitude-closed '(recip d))
(fact 'rr-magnitude-is-abs 1)
(fact 'rr-abs-of-nonneg 1)
(dk-have! '(= (* (magnitude d) (magnitude (recip d))) 1)
  (lambda ()
    (subst '(= (* (magnitude d) (magnitude (recip d))) (magnitude (* d (recip d)))))
    (subst '(= (* d (recip d)) 1))
    (subst '(= (magnitude 1) (abs 1)))
    (aif-close!)))
(fact 'cc-magnitude-zero-iff 'd)
(dk-have! '(NOT (= (magnitude d) 0))
  (lambda () (di) (dk-have! '(= d 0) (lambda () (prop))) (ai '(NOT (= d 0)))))
(fact 'rr-recip-solve '(magnitude d) 1 '(magnitude (recip d)))
(dk-have! '(= 1 (* (magnitude d) (magnitude (recip d))))
  (lambda () (subst '(= (* (magnitude d) (magnitude (recip d))) 1)) (rfl)))
(define aif-f-sol (dk-fact! 'rr-recip-solve '(magnitude d) 1 '(magnitude (recip d))))
(dk-have! '(AND (IN (magnitude d) RR) (NOT (= (magnitude d) 0))))
(fact 'rr-recip-closed '(magnitude d))
(subst aif-f-sol)
(dk-crs-opaque!)
(qed 'aif-magnitude-recip)

;;; (G) THE FINITE GEOMETRIC IDENTITY behind (76): with e (1 - q s) = s,
;;;   sum_{k<N} p s^(k+1) q^k = p e - p (q s)^N e.
(define (aif-gterm k) (list '* (list '* 'aip_ (list 'power 'aisv_ (list 'succ k))) (list 'power 'aiqv_ k)))
(define aif-gfam (list 'VNB-LAMBDA 'aij_ 'NN (aif-gterm 'aij_)))
(define (aif-grhs n) (list '- '(* aip_ aie_) (list '* (list '* 'aip_ (list 'power '(* aiqv_ aisv_) n)) 'aie_)))
(define aif-ghyp '(= (* aie_ (- 1 (* aiqv_ aisv_))) aisv_))
(sp (make-wff
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
    (aif-alls '(aip_ aisv_ aiqv_ aie_)
      (aif-imps (list '(IN aip_ CC) '(IN aisv_ CC) '(IN aiqv_ CC) '(IN aie_ CC) aif-ghyp)
        (list '= (list 'CC-SERIES-PARTIAL-SUM aif-gfam 'n) (aif-grhs 'n))))))))
(define aif-g-br (use-induction))
(define (aif-g-common!)
  (dk-peel!)
  (aif-cc! '(* aiqv_ aisv_))
  (dk-have! (list 'IN aif-gfam '(FUN NN CC))
    (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!)))
                                         (fact 'nn-succ-closed v)
                                         (aif-cc! (aif-gterm v))))))))
(dk-focus! (cdr (assq 'base aif-g-br)))
(aif-g-common!)
(subst (dk-fact! 'cc-series-partial-sum-zero aif-gfam))
(subst (dk-fact! 'power-zero '(* aiqv_ aisv_)))
(crs)
(dk-focus! (cdr (assq 'step aif-g-br)))
(define aif-g-n (cdr (assq 'var aif-g-br)))
(define aif-g-ih (cdr (assq 'ih aif-g-br)))
(aif-g-common!)
(fact 'cc-series-partial-sum-in-cc aif-g-n aif-gfam)
(fact 'nn-succ-closed aif-g-n)
(aif-cc! (aif-gterm aif-g-n))
(dk-have! (list 'IN (list aif-gfam aif-g-n) 'CC)
  (lambda () (if (not (dk-lam-b!)) (ass))))
(subst (dk-fact! 'cc-series-partial-sum-succ aif-gfam aif-g-n))
(dk-lam-b!)
(subst (dk-apply! aif-g-ih 'aip_ 'aisv_ 'aiqv_ 'aie_))
(define (aif-g-and! a b) (dk-have! (list 'AND a b)))
(aif-g-and! '(IN (* aiqv_ aisv_) CC) (list 'IN aif-g-n 'NN))
(subst (dk-fact! 'power-succ '(* aiqv_ aisv_) aif-g-n))
(aif-g-and! '(IN aisv_ CC) (list 'IN aif-g-n 'NN))
(subst (dk-fact! 'power-succ 'aisv_ aif-g-n))
(subst (dk-fact! 'cc-power-mul-base aif-g-n 'aiqv_ 'aisv_))
(define aif-g-sn (list '* 'aisv_ (list 'power 'aisv_ aif-g-n)))
(define aif-g-en (list '* '(* aie_ (- 1 (* aiqv_ aisv_))) (list 'power 'aisv_ aif-g-n)))
(dk-have! (list '= aif-g-sn aif-g-en)
  (lambda () (subst (list '= '(* aie_ (- 1 (* aiqv_ aisv_))) 'aisv_)) (aif-cc! aif-g-sn) (rfl)))
(subst (list '= aif-g-sn aif-g-en))
(aif-cc! (list 'power 'aisv_ aif-g-n))
(aif-cc! (list 'power 'aiqv_ aif-g-n))
(crs)
(qed 'aif-geometric-partial)

;;; (H) a map continuous on u is BOUNDED on the trace of a path inside u.
(define aif-h-re '(VNB-LAMBDA pat_ (CCINT a b) (real-part (phi (pgam pat_)))))
(define aif-h-im '(VNB-LAMBDA pat_ (CCINT a b) (imag-part (phi (pgam pat_)))))
(sp (make-wff
  (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC)
    (list 'FORALL 'phi (aif-imps (list '(IN phi (FUN u CC)) (aif-cont 'u 'phi))
      (aif-alls '(pgam a b)
        (aif-imps (list '(IS-PATH pgam a b) '(SUBSET (TRACE pgam a b) u))
          '(FORSOME aim_ (AND (IN aim_ RR) (AND (<= 0 aim_)
             (FORALL aiy_ (IMPLIES (IN aiy_ (TRACE pgam a b)) (<= (magnitude (phi aiy_)) aim_))))))))))))))
(dk-peel!)
(dk-split! (dk-fact! 'continuous-on-compose-path 'u 'phi 'pgam 'a 'b))
(dk-project! '(IN a RR) 'is-path '(IS-PATH pgam a b))
(dk-project! '(IN b RR) 'is-path '(IS-PATH pgam a b))
(dk-project! '(< a b) 'is-path '(IS-PATH pgam a b))
(dk-project! '(IN pgam (FUN (CCINT a b) CC)) 'is-path '(IS-PATH pgam a b))
(dk-have! '(<= a b) (lambda () (dk-ineq! '(IN a RR) '(IN b RR) '(< a b))))
;; the bound on one coordinate: returns the skolem constant m
(define (aif-h-bound! lam)
  (dk-project! (list 'IN lam '(FUN (CCINT a b) RR)) 'is-continuous-on (list 'IS-CONTINUOUS-ON lam '(CCINT a b)))
  (let* ((ext (list 'EXTEND-CONST lam 'a 'b))
         (ec (dk-fact! 'extend-const-continuous-at 'a 'b lam)))
    (fact 'extend-const-in-fun 'a 'b lam)
    (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES '(IN aix_ (CCINT a b))
                (list 'IS-CONTINUOUS-AT 'RR-MS 'RR-MS ext 'aix_)))
      (lambda () (let ((x (dk-di-var!)))
                   (fact 'ccint-elt-in-rr 'a 'b x)
                   (dk-apply! ec x)
                   (aif-close!))))
    (let ((ex (dk-fact! 'continuous-abs-bounded-on-ccint ext 'a 'b)))
      (let ((m (dk-skolem! ex)))
        (dk-split-all!)
        m))))
(define aif-h-m1 (aif-h-bound! aif-h-re))
(define aif-h-m2 (aif-h-bound! aif-h-im))
(define aif-h-sum (list '+ aif-h-m1 aif-h-m2))
(aif-cc! 'a)
(ew aif-h-sum)
(define aif-h-trcc (dk-fact! 'trace-subset-cc 'pgam 'a 'b))
;; one coordinate at a point y = pgam(x) of the trace: |coord(phi(y))| <= m
(define (aif-h-coord! lam part m x y)
  (let* ((pt (list part (list 'phi y)))
         (ext (list 'EXTEND-CONST lam 'a 'b)))
    (dk-have! (list '<= (list 'abs pt) m)
      (lambda ()
        (subst (list '= y (list 'pgam x)))
        (let ((ptx (list part (list 'phi (list 'pgam x)))))
          (dk-have! (list '= (list lam x) ptx)
            (lambda () (if (not (dk-lam-b!)) (rfl))))
          (subst (list '= ptx (list lam x)))
          (dk-fact! 'extend-const-ccint-fixes 'a 'b x lam)
          (subst (list '== (list lam x) (list ext x)))
          (dk-apply! (dk-ctx-form (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ (CCINT a b))
                                    (list '<= (list 'abs (list ext 'z_)) m))))
                     x)
          (aif-close!))))))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-head-is? g 'IN) (aif-real! aif-h-sum))
        ((dk-head-is? g '<=) (dk-ineq! (list 'IN aif-h-m1 'RR) (list 'IN aif-h-m2 'RR)
                                       (list '<= 0 aif-h-m1) (list '<= 0 aif-h-m2)))
        (#t
         (let* ((y (dk-di-var!))
                (img (list 'IN y '(IMAGE pgam (CCINT a b)))))
           (fact 'trace-unfold 'pgam 'a 'b)
           (dk-have! img
             (lambda () (subst '(== (IMAGE pgam (CCINT a b)) (TRACE pgam a b))) (ass)))
           (fact 'subset-mem-fwd '(TRACE pgam a b) 'u y)
           (fact 'subset-mem-fwd 'u 'CC y)
           (fact 'fun-apply-type-c 'phi 'u 'CC y)
           (fact 'cc-magnitude-le-re-im (list 'phi y))
           (fact 'cc-magnitude-closed (list 'phi y))
           (fact 'real-part-in-rr (list 'phi y))
           (fact 'imag-part-in-rr (list 'phi y))
           (let* ((ex (car (dk-landed (lambda () (mac-h 'image-membership-iff (dk-ctx-form img))))))
                  (ex2 (if (dk-head-is? ex 'AND) (begin (dk-split! ex) (dk-pick (dk-head? 'FORSOME) "image witness")) ex))
                  (x (dk-skolem! ex2)))
             (dk-split-all!)
             (fact 'ccint-elt-in-rr 'a 'b x)
             (fact 'trace-value-in 'pgam 'a 'b x)
             (fact 'subset-mem-fwd '(TRACE pgam a b) 'u (list 'pgam x))
             (fact 'fun-apply-type-c 'phi 'u 'CC (list 'pgam x))
             (fact 'real-part-in-rr (list 'phi (list 'pgam x)))
             (fact 'imag-part-in-rr (list 'phi (list 'pgam x)))
             (aif-h-coord! aif-h-re 'real-part aif-h-m1 x y)
             (aif-h-coord! aif-h-im 'imag-part aif-h-m2 x y)
             (fact 'rr-abs-closed (list 'real-part (list 'phi y)))
             (fact 'rr-abs-closed (list 'imag-part (list 'phi y)))
             (dk-ineq! (list 'IN (list 'magnitude (list 'phi y)) 'RR)
                       (list 'IN (list 'abs (list 'real-part (list 'phi y))) 'RR)
                       (list 'IN (list 'abs (list 'imag-part (list 'phi y))) 'RR)
                       (list 'IN aif-h-m1 'RR) (list 'IN aif-h-m2 'RR)
                       (list '<= (list 'magnitude (list 'phi y))
                             (list '+ (list 'abs (list 'real-part (list 'phi y)))
                                      (list 'abs (list 'imag-part (list 'phi y)))))
                       (list '<= (list 'abs (list 'real-part (list 'phi y))) aif-h-m1)
                       (list '<= (list 'abs (list 'imag-part (list 'phi y))) aif-h-m2)))))))))
(qed 'aif-trace-bounded)

;;; (I) eps / (L + 1) is positive and L times it is at most eps (L >= 0).
(sp (make-wff '(FORALL ail_ (IMPLIES (IN ail_ RR) (IMPLIES (<= 0 ail_)
  (FORALL eps (IMPLIES (POS-RR eps)
    (AND (POS-RR (* eps (recip (+ ail_ 1))))
         (<= (* ail_ (* eps (recip (+ ail_ 1)))) eps)))))))))
(dk-peel!)
(fact 'rr-pos-rr-in-rr 'eps)
(fact 'rr-lt-of-pos-rr 'eps)
(aif-real! '(+ ail_ 1))
(dk-have! '(< 0 (+ ail_ 1)) (lambda () (dk-ineq! '(IN ail_ RR) '(<= 0 ail_))))
(dk-have! '(NOT (= (+ ail_ 1) 0))
  (lambda () (di) (dk-absurd! '(IN ail_ RR) '(<= 0 ail_) '(= (+ ail_ 1) 0))))
(dk-have! '(AND (IN (+ ail_ 1) RR) (NOT (= (+ ail_ 1) 0))))
(fact 'rr-recip-closed '(+ ail_ 1))
(fact 'rr-recip-inverse '(+ ail_ 1))
(fact 'rr-recip-pos '(+ ail_ 1))
(define aif-i-v (dk-name! '(recip (+ ail_ 1))))
(subst (list '= '(recip (+ ail_ 1)) aif-i-v))
(dk-have! (list '< 0 aif-i-v) (lambda () (subst (list '= aif-i-v '(recip (+ ail_ 1)))) (ass)))
(define aif-i-ev (list '* 'eps aif-i-v))
(aif-real! aif-i-ev)
(fact 'rr-mul-pos 'eps aif-i-v)
(dk-have! (list '= (list '* '(+ ail_ 1) aif-i-v) 1)
  (lambda () (subst (list '= aif-i-v '(recip (+ ail_ 1)))) (ass)))
(define aif-i-p (begin (aif-real! (list '* 'ail_ aif-i-v)) (dk-name! (list '* 'ail_ aif-i-v))))
(dk-have! (list '= (list '+ aif-i-p aif-i-v) 1)
  (lambda ()
    (subst (list '= aif-i-p (list '* 'ail_ aif-i-v)))
    (dk-have! (list '= (list '+ (list '* 'ail_ aif-i-v) aif-i-v) (list '* '(+ ail_ 1) aif-i-v)) (lambda () (crs)))
    (subst (list '= (list '+ (list '* 'ail_ aif-i-v) aif-i-v) (list '* '(+ ail_ 1) aif-i-v)))
    (aif-close!)))
(dk-have! (list '<= aif-i-p 1)
  (lambda () (dk-ineq! (list 'IN aif-i-p 'RR) (list 'IN aif-i-v 'RR) (list '< 0 aif-i-v)
                       (list '= (list '+ aif-i-p aif-i-v) 1))))
(fact 'rr-one-in)
(dk-have! '(<= 0 eps) (lambda () (dk-ineq! '(IN eps RR) '(< 0 eps))))
(fact 'rr-mul-le-right aif-i-p 1 'eps)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'POS-RR)
        (begin (fact 'rr-pos-rr-of-lt aif-i-ev) (aif-close!))
        (begin
          (dk-have! (list '= (list '* 'ail_ aif-i-ev) (list '* aif-i-p 'eps))
            (lambda () (subst (list '= aif-i-p (list '* 'ail_ aif-i-v))) (crs)))
          (subst (list '= (list '* 'ail_ aif-i-ev) (list '* aif-i-p 'eps)))
          (aif-real! (list '* aif-i-p 'eps))
          (dk-ineq! '(IN eps RR) (list 'IN (list '* aif-i-p 'eps) 'RR)
                    (list '<= (list '* aif-i-p 'eps) '(* 1 eps)))))))
(qed 'aif-scale-small)

;;; (J) a constant multiple of a continuous map is continuous.
(sp (make-wff
  (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC)
    (list 'FORALL 'aik_ (list 'IMPLIES '(IN aik_ CC)
      (list 'FORALL 'g (aif-imps (list '(IN g (FUN u CC)) (aif-cont 'u 'g))
        (list 'FORALL 'h (aif-imps (list '(IN h (FUN u CC)) (aif-ptw 'u 'h (lambda (x) (list '* 'aik_ (list 'g x)))))
                           (aif-cont 'u 'h)))))))))))
(dk-peel!)
(aif-ms! 'u)
(define aif-j-y (list-ref (dk-goal) 4))
(define aif-j-c '(VNB-LAMBDA aiz_ u aik_))
(dk-have! (list 'IN aif-j-c '(FUN u CC))
  (lambda () (dk-lam-type! (lambda () (dk-di-var!) (aif-close!)))))
(dk-have! (aif-ptw 'u aif-j-c (lambda (x) 'aik_))
  (lambda () (dk-di-var!) (if (not (dk-lam-b!)) (qrfl))))
(fact 'aif-cont-const 'u 'aik_ aif-j-c)
(dk-have! (aif-ptw 'u 'h (lambda (x) (list '* (list aif-j-c x) (list 'g x))))
  (lambda ()
    (let ((v (dk-di-var!)))
      (dk-apply! (dk-ctx-form (aif-ptw 'u 'h (lambda (x) (list '* 'aik_ (list 'g x))))) v)
      (dk-lam-b!)
      (aif-close!))))
(dk-apply! (dk-fact! 'aif-cont-product 'u aif-j-c 'g 'h) aif-j-y)
(aif-close!)
(qed 'aif-cont-scale)

;;; =====================================================================
;;; DELIVERABLE 2.  The line integral is continuous for uniform convergence
;;; on the trace.
;;; =====================================================================
(define aif-unif
  '(FORALL eps (IMPLIES (POS-RR eps)
     (FORSOME aicap_ (AND (IN aicap_ NN)
       (FORALL k (IMPLIES (IN k NN) (IMPLIES (<= aicap_ k)
         (FORALL aiy_ (IMPLIES (IN aiy_ (TRACE pgam a b))
           (<= (magnitude (- ((fam k) aiy_) (g aiy_))) eps)))))))))))
(define aif-road-h '((SUBSET u CC) (IS-ROAD pgam dgam a b) (SUBSET (TRACE pgam a b) u)))
(define aif-fam-typ '(FORALL k (IMPLIES (IN k NN) (IN (fam k) (FUN u CC)))))
(define aif-fam-cont (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (aif-cont 'u '(fam k)))))
(sp (make-wff
  (aif-alls '(u pgam dgam a b)
    (aif-imps aif-road-h
      (list 'FORALL 'g (aif-imps (list '(IN g (FUN u CC)) (aif-cont 'u 'g))
        (list 'FORALL 'fam (aif-imps (list aif-fam-typ aif-fam-cont aif-unif)
          '(CONVERGES-TO CC-MS (VNB-LAMBDA k NN (LINE-INT (fam k) pgam dgam a b))
                               (LINE-INT g pgam dgam a b))))))))))
(dk-peel!)
(aif-ms! 'u)
(fact 'cc-is-metric-space)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(fact 'line-int-in-cc 'u 'g 'pgam 'dgam 'a 'b)
(fact 'road-length-in-rr 'pgam 'dgam 'a 'b)
(fact 'road-length-nonneg 'pgam 'dgam 'a 'b)
(define aif-2-L '(ROAD-LENGTH dgam a b))
;; fam(k) typed, continuous, and its integral complex, at an index k in NN
(define (aif-2-at! k)
  (dk-apply! (dk-ctx-form aif-fam-typ) k)
  (dk-apply! (dk-ctx-form aif-fam-cont) k)
  (fact 'line-int-in-cc 'u (list 'fam k) 'pgam 'dgam 'a 'b))
(define (aif-2-eps!)
  (dk-peel!)
  (let* ((eps (cadr (dk-pick (dk-head? 'POS-RR) "eps")))
         (L aif-2-L)
         (epsp (list '* eps (list 'recip (list '+ L 1))))
         (sc (dk-fact! 'aif-scale-small L eps)))
    (dk-split! sc)
    (fact 'rr-pos-rr-in-rr epsp)
    (fact 'rr-pos-rr-in-rr eps)
    (let* ((ex (dk-apply! (dk-ctx-form aif-unif) epsp))
           (cap (dk-skolem! ex)))
      (dk-split-all!)
      (ew cap)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'IN) (ass)
              (aif-2-tail! eps epsp cap)))))))

(define (aif-2-tail! eps epsp cap)
  (dk-peel!)
  (let* ((n (caddr (dk-pick (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) cap))) "the index")))
         (fn (list 'fam n))
         (lin (list 'LINE-INT fn 'pgam 'dgam 'a 'b))
         (lig '(LINE-INT g pgam dgam a b))
         (gp '(VNB-LAMBDA aiz_ u (* -1 (g aiz_))))
         (dl (list 'VNB-LAMBDA 'aiz_ 'u (list '- (list fn 'aiz_) '(g aiz_))))
         (lid (list 'LINE-INT dl 'pgam 'dgam 'a 'b))
         (ligp (list 'LINE-INT gp 'pgam 'dgam 'a 'b)))
    (aif-2-at! n)
    (dk-lam-b!)
    (subst (dk-fact! 'cc-ms-dist lin lig))
    (fact 'cc-zero-in) (fact 'cc-one-in)
    (aif-cc! -1)
    (dk-have! (list 'IN gp '(FUN u CC))
      (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!)))
                                            (fact 'fun-apply-type-c 'g 'u 'CC v)
                                            (aif-cc! (list '* -1 (list 'g v))))))))
    (dk-have! (list 'IN dl '(FUN u CC))
      (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!)))
                                            (fact 'fun-apply-type-c 'g 'u 'CC v)
                                            (fact 'fun-apply-type-c fn 'u 'CC v)
                                            (aif-cc! (list '- (list fn v) (list 'g v))))))))
    (dk-have! (aif-ptw 'u gp (lambda (x) (list '* -1 (list 'g x))))
      (lambda () (dk-di-var!) (if (not (dk-lam-b!)) (qrfl))))
    (fact 'aif-cont-scale 'u -1 'g gp)
    (dk-have! (aif-ptw 'u dl (lambda (x) (list '+ (list fn x) (list gp x))))
      (lambda ()
        (let* ((v (dk-di-var!)) (fv (list fn v)) (gv (list 'g v)))
          (fact 'fun-apply-type-c 'g 'u 'CC v)
          (fact 'fun-apply-type-c fn 'u 'CC v)
          (dk-lam-b!)
          (dk-have! (list '= (list '- fv gv) (list '+ fv (list '* -1 gv))) (lambda () (crs)))
          (subst (list '= (list '- fv gv) (list '+ fv (list '* -1 gv))))
          (qrfl))))
    (fact 'aif-cont-sum 'u fn gp dl)
    (fact 'line-int-in-cc 'u gp 'pgam 'dgam 'a 'b)
    (fact 'line-int-in-cc 'u dl 'pgam 'dgam 'a 'b)
    (let ((e-sc (dk-apply! (dk-cite! 'line-int-scalar 'u 'g 'pgam 'dgam 'a 'b) -1 gp))
          (e-sum (dk-apply! (dk-cite! 'line-int-sum 'u fn gp 'pgam 'dgam 'a 'b) dl)))
      (dk-have! (list '= (list '- lin lig) lid)
        (lambda () (subst e-sum) (subst e-sc) (crs)))
      (subst (list '= (list '- lin lig) lid))
      (dk-have! (list 'FORALL 'bny_ (list 'IMPLIES '(IN bny_ (TRACE pgam a b))
                  (list '<= (list 'magnitude (list dl 'bny_)) epsp)))
        (lambda ()
          (let ((y (dk-di-var!)))
            (fact 'subset-mem-fwd '(TRACE pgam a b) 'u y)
            (dk-lam-b!)
            (let ((inst (dk-apply! (dk-ctx-form
                          (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES (list '<= cap 'k)
                            (list 'FORALL 'aiy_ (list 'IMPLIES '(IN aiy_ (TRACE pgam a b))
                              (list '<= '(magnitude (- ((fam k) aiy_) (g aiy_))) epsp)))))))
                          n)))
              (dk-apply! inst y)
              (aif-close!)))))
      (let ((bd (dk-fact! 'line-int-length-bound 'u dl 'pgam 'dgam 'a 'b epsp)))
        (fact 'cc-magnitude-closed lid)
        (aif-real! (list '* aif-2-L epsp))
        (dk-ineq! (list 'IN (list 'magnitude lid) 'RR) (list 'IN (list '* aif-2-L epsp) 'RR)
                  (list 'IN eps 'RR)
                  bd (list '<= (list '* aif-2-L epsp) eps))))))

(mac 'converges-to)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-head-is? g 'IS-METRIC-SPACE) (ass))
        ((and (dk-head-is? g 'IN) (dk-head-is? (cadr g) 'VNB-LAMBDA))
         (subst '(== (PTS CC-MS) CC))
         (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (aif-2-at! k) (aif-close!)))))
        ((dk-head-is? g 'IN) (subst '(== (PTS CC-MS) CC)) (ass))
        (#t (aif-2-eps!))))))
(qed 'line-int-of-uniform-limit)

;;; (K) the relation the geometric identity needs: with s = 1/(w-c), e = 1/(w-z),
;;; q = z - c:  e (1 - q s) = s.
(sp (make-wff '(FORALL w (IMPLIES (IN w CC) (FORALL c (IMPLIES (IN c CC) (FORALL z (IMPLIES (IN z CC)
  (IMPLIES (NOT (= w c)) (IMPLIES (NOT (= w z))
    (= (* (recip (- w z)) (- 1 (* (- z c) (recip (- w c))))) (recip (- w c)))))))))))))
(dk-peel!)
(define (aif-ne-sub! x y)
  ;; NOT(x = y) in context: land (IN (- x y) CC) and NOT((- x y) = 0)
  (aif-cc! (list '- x y))
  (dk-have! (list 'NOT (list '= (list '- x y) 0))
    (lambda () (di) (fact 'cc-sub-zero-eq x y) (ai (dk-ctx-form (list 'NOT (list '= x y))))))
  (dk-have! (list 'AND (list 'IN (list '- x y) 'CC) (list 'NOT (list '= (list '- x y) 0)))))
(aif-ne-sub! 'w 'c)
(aif-ne-sub! 'w 'z)
(fact 'cc-recip-closed '(- w c))
(fact 'cc-recip-closed '(- w z))
(fact 'cc-recip-inverse '(- w c))
(fact 'cc-recip-inverse '(- w z))
(define aif-k-s (dk-name! '(recip (- w c)) 'CC))
(define aif-k-e (dk-name! '(recip (- w z)) 'CC))
(subst (list '= '(recip (- w c)) aif-k-s))
(subst (list '= '(recip (- w z)) aif-k-e))
(dk-have! (list '= (list '* '(- w c) aif-k-s) 1)
  (lambda () (subst (list '= aif-k-s '(recip (- w c)))) (ass)))
(dk-have! (list '= (list '* '(- w z) aif-k-e) 1)
  (lambda () (subst (list '= aif-k-e '(recip (- w z)))) (ass)))
(subst (list '= 1 (list '* '(- w c) aif-k-s)))
(define aif-k-mid (list '* (list '* aif-k-e '(- w z)) aif-k-s))
(dk-have! (list '= (list '* aif-k-e (list '- (list '* '(- w c) aif-k-s) (list '* '(- z c) aif-k-s))) aif-k-mid)
  (lambda () (crs)))
(subst (list '= (list '* aif-k-e (list '- (list '* '(- w c) aif-k-s) (list '* '(- z c) aif-k-s))) aif-k-mid))
(dk-have! (list '= (list '* aif-k-e '(- w z)) 1)
  (lambda ()
    (dk-have! (list '= (list '* aif-k-e '(- w z)) (list '* '(- w z) aif-k-e)) (lambda () (crs)))
    (subst (list '= (list '* aif-k-e '(- w z)) (list '* '(- w z) aif-k-e)))
    (aif-close!)))
(subst (list '= (list '* aif-k-e '(- w z)) 1))
(crs)
(qed 'aif-geometric-relation)

;;; (L) THE REMAINDER OF THE GEOMETRIC EXPANSION, pointwise:
;;;   | sum_{j<k} p s^(j+1) q^j - p/(w-z) | <= M (|q|/r)^k / (r - |q|)
;;; for |w - c| >= r > |q| = |z - c| and |p| <= M.
(define aif-lam-s '(VNB-LAMBDA aij_ NN (* (* aip_ (power (recip (- w c)) (succ aij_))) (power (- z c) aij_))))
(define aif-rho '(magnitude (- z c)))
(define aif-rem-lhs (list 'magnitude (list '- (list 'CC-SERIES-PARTIAL-SUM aif-lam-s 'k) '(* aip_ (recip (- w z))))))
(sp (make-wff
  (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'r (aif-imps '((IN r RR) (< 0 r))
   (list 'FORALL 'w (aif-imps '((IN w CC) (<= r (magnitude (- w c))))
   (list 'FORALL 'z (aif-imps (list '(IN z CC) (list '< aif-rho 'r))
   (list 'FORALL 'aip_ (list 'IMPLIES '(IN aip_ CC) (list 'FORALL 'aim_ (aif-imps '((IN aim_ RR) (<= (magnitude aip_) aim_))
   (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
     (list 'AND (list 'IN aif-rem-lhs 'RR)
     (list '<= aif-rem-lhs
               (list '* (list '* 'aim_ (list 'power (list '* aif-rho '(recip r)) 'k))
                        (list 'recip (list '- 'r aif-rho)))))))))))))))))))))
(dk-peel!)
(aif-cc! '(- z c))
(aif-cc! '(- w c))
(aif-cc! '(- w z))
(fact 'cc-magnitude-closed '(- z c))
(fact 'cc-magnitude-nonneg '(- z c))
(fact 'cc-magnitude-closed '(- w c))
(fact 'cc-magnitude-closed '(- w z))
(fact 'cc-magnitude-closed 'aip_)
(fact 'cc-magnitude-nonneg 'aip_)
(fact 'cc-magnitude-zero)
(dk-have! '(NOT (= w c))
  (lambda ()
    (di)
    (dk-have! '(= (magnitude (- w c)) 0)
      (lambda () (subst '(= w c)) (dk-have! '(= (- c c) 0) (lambda () (crs))) (subst '(= (- c c) 0)) (aif-close!)))
    (dk-absurd! '(IN r RR) '(< 0 r) '(<= r (magnitude (- w c))) '(= (magnitude (- w c)) 0) '(IN (magnitude (- w c)) RR))))
(dk-have! (list '<= '(magnitude (- w c)) (list '+ '(magnitude (- w z)) aif-rho))
  (lambda ()
    (fact 'cc-magnitude-le-add '(- w c) '(- z c))
    (dk-have! '(= (- w z) (- (- w c) (- z c))) (lambda () (crs)))
    (subst '(= (- w z) (- (- w c) (- z c))))
    (aif-close!)))
(dk-have! (list '<= (list '- 'r aif-rho) '(magnitude (- w z)))
  (lambda () (dk-ineq! '(IN r RR) (list 'IN aif-rho 'RR) '(IN (magnitude (- w c)) RR) '(IN (magnitude (- w z)) RR)
                       '(<= r (magnitude (- w c))) (list '<= '(magnitude (- w c)) (list '+ '(magnitude (- w z)) aif-rho)))))
(dk-have! (list '< 0 (list '- 'r aif-rho))
  (lambda () (dk-ineq! '(IN r RR) (list 'IN aif-rho 'RR) (list '< aif-rho 'r))))
(dk-have! '(NOT (= w z))
  (lambda ()
    (di)
    (dk-have! '(= (magnitude (- w z)) 0)
      (lambda () (subst '(= w z)) (dk-have! '(= (- z z) 0) (lambda () (crs))) (subst '(= (- z z) 0)) (aif-close!)))
    (dk-absurd! '(IN r RR) (list 'IN aif-rho 'RR) (list '< aif-rho 'r)
                (list '<= (list '- 'r aif-rho) '(magnitude (- w z))) '(= (magnitude (- w z)) 0)
                '(IN (magnitude (- w z)) RR))))
(fact 'aif-geometric-relation 'w 'c 'z)
(aif-ne-sub! 'w 'c)
(aif-ne-sub! 'w 'z)
(fact 'cc-recip-closed '(- w c))
(fact 'cc-recip-closed '(- w z))
(define aif-l-leaves (dk-opened (lambda () (di))))
(define aif-l-typ (find-first (lambda (n) (dk-head-is? (dk-goal-of n) 'IN)) aif-l-leaves))
(define aif-l-bnd (find-first (lambda (n) (dk-head-is? (dk-goal-of n) '<=)) aif-l-leaves))
(dk-focus! aif-l-typ)
(dk-have! (list 'IN aif-lam-s '(FUN NN CC))
  (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                                        (fact 'nn-succ-closed j)
                                        (aif-cc! (list '* (list '* 'aip_ (list 'power '(recip (- w c)) (list 'succ j)))
                                                           (list 'power '(- z c) j))))))))
(fact 'cc-series-partial-sum-in-cc 'k aif-lam-s)
(aif-cc! (cadr aif-rem-lhs))
(fact 'cc-magnitude-closed (cadr aif-rem-lhs))
(aif-close!)
(dk-focus! aif-l-bnd)
(define aif-l-s (dk-name! '(recip (- w c)) 'CC))
(define aif-l-e (dk-name! '(recip (- w z)) 'CC))
(subst (list '= '(recip (- w c)) aif-l-s))
(subst (list '= '(recip (- w z)) aif-l-e))
(dk-have! (list '= (list '* aif-l-e (list '- 1 (list '* '(- z c) aif-l-s))) aif-l-s)
  (lambda ()
    (subst (list '= aif-l-s '(recip (- w c))))
    (subst (list '= aif-l-e '(recip (- w z))))
    (aif-close!)))
(subst (dk-fact! 'aif-geometric-partial 'k 'aip_ aif-l-s '(- z c) aif-l-e))
(define aif-l-q '(- z c))
(define aif-l-qs (list '* aif-l-q aif-l-s))
(aif-cc! aif-l-qs)
(define aif-l-P (list 'power aif-l-qs 'k))
(aif-cc! aif-l-P)
(define aif-l-pP (list '* 'aip_ aif-l-P))
(aif-cc! aif-l-pP)
(define aif-l-X (list '* aif-l-pP aif-l-e))
(aif-cc! aif-l-X)
(define (aif-mag t) (list 'magnitude t))
(define aif-l-pe (list '* 'aip_ aif-l-e))
(dk-have! (list '= (list '- (list '- aif-l-pe aif-l-X) aif-l-pe) (list '- aif-l-X)) (lambda () (crs)))
(subst (list '= (list '- (list '- aif-l-pe aif-l-X) aif-l-pe) (list '- aif-l-X)))
(subst (dk-fact! 'cc-magnitude-neg aif-l-X))
(define (aif-and! a b) (dk-have! (list 'AND a b)))
(aif-and! (list 'IN aif-l-pP 'CC) (list 'IN aif-l-e 'CC))
(subst (dk-fact! 'cc-magnitude-mul aif-l-pP aif-l-e))
(aif-and! '(IN aip_ CC) (list 'IN aif-l-P 'CC))
(subst (dk-fact! 'cc-magnitude-mul 'aip_ aif-l-P))
(subst (dk-fact! 'cc-magnitude-power 'k aif-l-qs))
(aif-and! (list 'IN aif-l-q 'CC) (list 'IN aif-l-s 'CC))
(subst (dk-fact! 'cc-magnitude-mul aif-l-q aif-l-s))
;; the three factor bounds
(for-each (lambda (t) (fact 'cc-magnitude-closed t) (fact 'cc-magnitude-nonneg t)) (list aif-l-s aif-l-e))
(fact 'aif-magnitude-recip '(- w c))
(fact 'aif-magnitude-recip '(- w z))
(fact 'rr-recip-antitone 'r '(magnitude (- w c)))
(aif-real! (list '- 'r aif-rho))
(fact 'rr-recip-antitone (list '- 'r aif-rho) '(magnitude (- w z)))
(dk-have! (list '<= (aif-mag aif-l-s) '(recip r))
  (lambda () (subst (list '= aif-l-s '(recip (- w c))))
              (subst '(= (magnitude (recip (- w c))) (recip (magnitude (- w c)))))
              (aif-close!)))
(dk-have! (list '<= (aif-mag aif-l-e) (list 'recip (list '- 'r aif-rho)))
  (lambda () (subst (list '= aif-l-e '(recip (- w z))))
              (subst '(= (magnitude (recip (- w z))) (recip (magnitude (- w z)))))
              (aif-close!)))
(dk-have! '(NOT (= r 0)) (lambda () (di) (dk-absurd! '(IN r RR) '(< 0 r) '(= r 0))))
(aif-and! '(IN r RR) '(NOT (= r 0)))
(fact 'rr-recip-closed 'r)
(aif-real! (list '- 'r aif-rho))
(dk-have! (list 'NOT (list '= (list '- 'r aif-rho) 0))
  (lambda () (di) (dk-absurd! '(IN r RR) (list 'IN aif-rho 'RR) (list '< aif-rho 'r) (list '= (list '- 'r aif-rho) 0))))
(aif-and! (list 'IN (list '- 'r aif-rho) 'RR) (list 'NOT (list '= (list '- 'r aif-rho) 0)))
(fact 'rr-recip-closed (list '- 'r aif-rho))
(define (aif-prod-le! a b u v)
  (dk-have! (list 'AND (list 'AND (list '<= 0 a) (list '<= a b)) (list 'AND (list '<= 0 u) (list '<= u v))))
  (fact 'rr-prod-le-prod a b u v))
(define (aif-nonneg-mul! a b)
  (aif-and! (list 'IN a 'RR) (list 'IN b 'RR))
  (aif-and! (list '<= 0 a) (list '<= 0 b))
  (fact 'rr-leq-mul-nonneg a b)
  (aif-real! (list '* a b)))
(define aif-l-mq (aif-mag aif-l-q))
(define aif-l-ms (aif-mag aif-l-s))
(dk-have! (list '<= aif-l-mq aif-l-mq) (lambda () (dk-ineq! (list 'IN aif-l-mq 'RR))))
(aif-prod-le! aif-l-mq aif-l-mq aif-l-ms '(recip r))
(aif-nonneg-mul! aif-l-mq aif-l-ms)
(define aif-l-x1 (list '* aif-l-mq aif-l-ms))
(define aif-l-y1 (list '* aif-l-mq '(recip r)))
(aif-real! aif-l-y1)
(fact 'rr-power-mono-base 'k aif-l-x1 aif-l-y1)
(fact 'rr-power-nonneg 'k aif-l-x1)
(aif-real! (list 'power aif-l-x1 'k))
(aif-real! (list 'power aif-l-y1 'k))
(define aif-l-mp '(magnitude aip_))
(aif-prod-le! aif-l-mp 'aim_ (list 'power aif-l-x1 'k) (list 'power aif-l-y1 'k))
(aif-nonneg-mul! aif-l-mp (list 'power aif-l-x1 'k))
(aif-real! (list '* 'aim_ (list 'power aif-l-y1 'k)))
(aif-prod-le! (list '* aif-l-mp (list 'power aif-l-x1 'k)) (list '* 'aim_ (list 'power aif-l-y1 'k))
              (aif-mag aif-l-e) (list 'recip (list '- 'r aif-rho)))
(aif-close!)
(qed 'aif-geometric-remainder)

;;; =====================================================================
;;; DELIVERABLE 1.  THE GEOMETRIC EXPANSION, UNIFORMLY on a set u at distance
;;; at least r from c (the trace of the notes' circle is the instance), with a
;;; bounded weight phi (phi = 1 is the bare expansion of 1/(w - z)).
;;; =====================================================================
(define (aif-S k y)
  (list 'CC-SERIES-PARTIAL-SUM
        (list 'VNB-LAMBDA 'aij_ 'NN (list '* (list '* (list 'phi y) (list 'power (list 'recip (list '- y 'c)) '(succ aij_)))
                                             '(power (- z c) aij_)))
        k))
(define (aif-gz y) (list '* (list 'phi y) (list 'recip (list '- y 'z))))
(define aif-unif1
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'aicap_ (list 'AND '(IN aicap_ NN)
      (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES '(<= aicap_ k)
        (list 'FORALL 'aiy_ (list 'IMPLIES '(IN aiy_ u)
          (list '<= (list 'magnitude (list '- (aif-S 'k 'aiy_) (aif-gz 'aiy_))) 'eps)))))))))))
(define aif-disc-h
  (list '(SUBSET u CC) '(IN c CC) '(IN r RR) '(< 0 r)
        '(FORALL aix_ (IMPLIES (IN aix_ u) (<= r (magnitude (- aix_ c)))))))
(sp (make-wff
  (aif-alls '(u c r)
    (aif-imps aif-disc-h
      (list 'FORALL 'z (aif-imps (list '(IN z CC) (list '< aif-rho 'r))
        (list 'FORALL 'phi (list 'IMPLIES '(FORALL aix_ (IMPLIES (IN aix_ u) (IN (phi aix_) CC)))
          (list 'FORALL 'aim_ (aif-imps '((IN aim_ RR) (<= 0 aim_)
                                          (FORALL aix_ (IMPLIES (IN aix_ u) (<= (magnitude (phi aix_)) aim_))))
            aif-unif1))))))))))
(dk-peel!)
(define aif-1-eps (cadr (dk-pick (dk-head? 'POS-RR) "eps")))
(fact 'rr-pos-rr-in-rr aif-1-eps)
(aif-cc! '(- z c))
(fact 'cc-magnitude-closed '(- z c))
(fact 'cc-magnitude-nonneg '(- z c))
(dk-have! '(NOT (= r 0)) (lambda () (di) (dk-absurd! '(IN r RR) '(< 0 r) '(= r 0))))
(dk-have! '(AND (IN r RR) (NOT (= r 0))))
(fact 'rr-recip-closed 'r)
(fact 'rr-recip-pos 'r)
(fact 'rr-recip-inverse 'r)
(define aif-1-x (list '* aif-rho '(recip r)))
(aif-real! aif-1-x)
(dk-have! (list '<= 0 aif-1-x)
  (lambda ()
    (dk-have! '(<= 0 (recip r)) (lambda () (dk-ineq! '(IN (recip r) RR) '(< 0 (recip r)))))
    (dk-have! (list 'AND (list 'IN aif-rho 'RR) '(IN (recip r) RR)))
    (dk-have! (list 'AND (list '<= 0 aif-rho) '(<= 0 (recip r))))
    (fact 'rr-leq-mul-nonneg aif-rho '(recip r))
    (aif-close!)))
(dk-have! (list '< aif-1-x 1)
  (lambda ()
    (fact 'rr-one-in)
    (dk-have! (list 'NOT (list '<= 1 aif-1-x))
      (lambda ()
        (di)
        (dk-have! '(<= 0 r) (lambda () (dk-ineq! '(IN r RR) '(< 0 r))))
        (fact 'rr-mul-le-right 1 aif-1-x 'r)
        (aif-real! (list '* aif-1-x 'r))
        (dk-have! (list '= (list '* aif-1-x 'r) aif-rho)
          (lambda ()
            (dk-have! (list '= (list '* aif-1-x 'r) (list '* aif-rho '(* r (recip r)))) (lambda () (dk-crs-opaque!)))
            (subst (list '= (list '* aif-1-x 'r) (list '* aif-rho '(* r (recip r)))))
            (subst '(= (* r (recip r)) 1))
            (crs)))
        (dk-absurd! '(IN r RR) (list 'IN aif-rho 'RR) (list 'IN (list '* aif-1-x 'r) 'RR)
                    (list '<= '(* 1 r) (list '* aif-1-x 'r)) (list '= (list '* aif-1-x 'r) aif-rho)
                    (list '< aif-rho 'r))))
    (fact 'rr-not-le-lt 1 aif-1-x)
    (aif-close!)))
(define aif-1-rr (list '- 'r aif-rho))
(aif-real! aif-1-rr)
(dk-have! (list '< 0 aif-1-rr) (lambda () (dk-ineq! '(IN r RR) (list 'IN aif-rho 'RR) (list '< aif-rho 'r))))
(dk-have! (list 'NOT (list '= aif-1-rr 0))
  (lambda () (di) (dk-absurd! '(IN r RR) (list 'IN aif-rho 'RR) (list '< aif-rho 'r) (list '= aif-1-rr 0))))
(dk-have! (list 'AND (list 'IN aif-1-rr 'RR) (list 'NOT (list '= aif-1-rr 0))))
(fact 'rr-recip-closed aif-1-rr)
(fact 'rr-recip-pos aif-1-rr)
(define aif-1-B (list '* 'aim_ (list 'recip aif-1-rr)))
(aif-real! aif-1-B)
(dk-have! (list '<= 0 aif-1-B)
  (lambda ()
    (dk-have! (list '<= 0 (list 'recip aif-1-rr)) (lambda () (dk-ineq! (list 'IN (list 'recip aif-1-rr) 'RR) (list '< 0 (list 'recip aif-1-rr)))))
    (dk-have! (list 'AND '(IN aim_ RR) (list 'IN (list 'recip aif-1-rr) 'RR)))
    (dk-have! (list 'AND '(<= 0 aim_) (list '<= 0 (list 'recip aif-1-rr))))
    (fact 'rr-leq-mul-nonneg 'aim_ (list 'recip aif-1-rr))
    (aif-close!)))
(define aif-1-sc (dk-fact! 'aif-scale-small aif-1-B aif-1-eps))
(dk-split! aif-1-sc)
(define aif-1-epsp (list '* aif-1-eps (list 'recip (list '+ aif-1-B 1))))
(fact 'rr-pos-rr-in-rr aif-1-epsp)
(dk-have! (list 'AND (list '<= 0 aif-1-x) (list '< aif-1-x 1)))
(define aif-1-th (dk-apply! (dk-fact! 'power-small-threshold aif-1-x) aif-1-epsp))
(define aif-1-cap (dk-skolem! aif-1-th))
(dk-split-all!)
(ew aif-1-cap)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IN) (ass)
        (begin
          (dk-peel!)
          (let* ((k (caddr (dk-pick (lambda (f) (and (dk-head-is? f '<=) (equal? (cadr f) aif-1-cap))) "k")))
                 (y (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'u))) "y")))
                 (xk (list 'power aif-1-x k))
                 (t1 (list '* (list '* 'aim_ xk) (list 'recip aif-1-rr)))
                 (t2 (list '* aif-1-B xk))
                 (t3 (list '* aif-1-B aif-1-epsp)))
            (fact 'subset-mem-fwd 'u 'CC y)
            (dk-apply! (dk-ctx-form '(FORALL aix_ (IMPLIES (IN aix_ u) (IN (phi aix_) CC)))) y)
            (dk-apply! (dk-ctx-form '(FORALL aix_ (IMPLIES (IN aix_ u) (<= r (magnitude (- aix_ c)))))) y)
            (dk-apply! (dk-ctx-form '(FORALL aix_ (IMPLIES (IN aix_ u) (<= (magnitude (phi aix_)) aim_)))) y)
            (let ((rem (let ((cj (dk-fact! 'aif-geometric-remainder 'c 'r y 'z (list 'phi y) 'aim_ k)))
                         (dk-split! cj)
                         (caddr cj))))
              (dk-apply! (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES (list '<= aif-1-cap 'k)
                                        (list '<= (list 'power aif-1-x 'k) aif-1-epsp)))))
                         k)
              (fact 'power-real-closed aif-1-x k)
              (aif-real! t1) (aif-real! t2) (aif-real! t3)
              (let ((comm '(FORALL aiu1_ (IMPLIES (IN aiu1_ RR) (FORALL aiu2_ (IMPLIES (IN aiu2_ RR)
                             (FORALL aiu3_ (IMPLIES (IN aiu3_ RR)
                               (= (* (* aiu1_ aiu2_) aiu3_) (* (* aiu1_ aiu3_) aiu2_))))))))))
                (dk-have! comm (lambda () (dk-peel!) (crs)))
                (dk-apply! (dk-ctx-form comm) 'aim_ xk (list 'recip aif-1-rr)))
              (dk-have! (list 'AND (list '<= 0 aif-1-B) (list '<= xk aif-1-epsp)))
              (fact 'rr-le-scale-nonneg aif-1-B xk aif-1-epsp)
              (let ((lhs (cadr rem)))
                (dk-ineq! (list 'IN lhs 'RR) (list 'IN t1 'RR) (list 'IN t2 'RR) (list 'IN t3 'RR)
                          (list 'IN aif-1-eps 'RR)
                          rem (list '= t1 t2) (list '<= t2 t3) (list '<= t3 aif-1-eps)))))))))
(qed 'geometric-expansion-uniform)

;;; (M) a point at distance >= r from c is neither c nor a point z with |z - c| < r.
(sp (make-wff
  (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'r (aif-imps '((IN r RR) (< 0 r))
   (list 'FORALL 'w (aif-imps '((IN w CC) (<= r (magnitude (- w c))))
   (list 'FORALL 'z (aif-imps (list '(IN z CC) (list '< aif-rho 'r))
     '(AND (NOT (= w c)) (NOT (= w z)))))))))))))
(dk-peel!)
(aif-cc! '(- z c))
(aif-cc! '(- w c))
(aif-cc! '(- w z))
(fact 'cc-magnitude-closed '(- z c))
(fact 'cc-magnitude-nonneg '(- z c))
(fact 'cc-magnitude-closed '(- w c))
(fact 'cc-magnitude-closed '(- w z))
(fact 'cc-magnitude-zero)
(dk-have! (list '<= '(magnitude (- w c)) (list '+ '(magnitude (- w z)) aif-rho))
  (lambda ()
    (fact 'cc-magnitude-le-add '(- w c) '(- z c))
    (dk-have! '(= (- w z) (- (- w c) (- z c))) (lambda () (crs)))
    (subst '(= (- w z) (- (- w c) (- z c))))
    (aif-close!)))
(dk-conj-close!
  (lambda ()
    (let ((v (caddr (cadr (dk-goal)))))
      (di)
      (dk-have! (list '= (list 'magnitude (list '- 'w v)) 0)
        (lambda () (subst (list '= 'w v))
                    (dk-have! (list '= (list '- v v) 0) (lambda () (crs)))
                    (subst (list '= (list '- v v) 0)) (aif-close!)))
      (dk-absurd! '(IN r RR) '(< 0 r) (list 'IN aif-rho 'RR) (list '< aif-rho 'r) '(<= r (magnitude (- w c)))
                  '(IN (magnitude (- w c)) RR) '(IN (magnitude (- w z)) RR)
                  (list '<= '(magnitude (- w c)) (list '+ '(magnitude (- w z)) aif-rho))
                  (list '= (list 'magnitude (list '- 'w v)) 0)))))
(qed 'aif-off-center)

;;; =====================================================================
;;; THE INTEGRATED PARTIAL SUMS.  In the setting of Lemma 3.33 (u at distance
;;; >= r from c, phi continuous on u, a road whose trace lies in u, |z - c| < r):
;;;   S_k(w) = sum_{j<k} phi(w) (1/(w-c))^(j+1) (z-c)^j      (a map on u)
;;; is continuous on u and its line integral is the k-th partial sum of the
;;; series  sum_j  [ int_gamma phi(w) (1/(w-c))^(j+1) dw ] (z-c)^j.
;;; =====================================================================
(define (aif-term w k) (list '* (list '* (list 'phi w) (list 'power (list 'recip (list '- w 'c)) (list 'succ k)))
                              (list 'power '(- z c) k)))
(define (aif-inner w) (list 'VNB-LAMBDA 'aij_ 'NN (aif-term w 'aij_)))
(define (aif-SL k) (list 'VNB-LAMBDA 'aiw_ 'u (list 'CC-SERIES-PARTIAL-SUM (aif-inner 'aiw_) k)))
(define (aif-TL k) (list 'VNB-LAMBDA 'aiw_ 'u (aif-term 'aiw_ k)))
(define (aif-H k) (list 'VNB-LAMBDA 'aiw_ 'u (list '* '(phi aiw_) (list 'power '(recip (- aiw_ c)) (list 'succ k)))))
(define (aif-P k) (list 'VNB-LAMBDA 'aiw_ 'u (list 'power '(recip (- aiw_ c)) (list 'succ k))))
(define aif-R '(VNB-LAMBDA aiw_ u (recip (- aiw_ c))))
(define (aif-LI f) (list 'LINE-INT f 'pgam 'dgam 'a 'b))
(define aif-T (list 'VNB-LAMBDA 'aitk_ 'NN (list '* (aif-LI (aif-H 'aitk_)) '(power (- z c) aitk_))))
(define aif-gzl '(VNB-LAMBDA aiw_ u (* (phi aiw_) (recip (- aiw_ z)))))
(define aif-set-h
  (append aif-disc-h
          (list '(IN phi (FUN u CC)) (aif-cont 'u 'phi) '(IS-ROAD pgam dgam a b) '(SUBSET (TRACE pgam a b) u))))
(define aif-z-h (list '(IN z CC) (list '< aif-rho 'r)))

;;; --- helpers in that setting (all the hypotheses in context) ---
(define (aif-pt! x)
  ;; x in u in context: x in CC, phi(x) in CC, x - c and x - z nonzero, recip(x - c), recip(x - z) in CC
  (fact 'subset-mem-fwd 'u 'CC x)
  (fact 'fun-apply-type-c 'phi 'u 'CC x)
  (dk-apply! (dk-ctx-form '(FORALL aix_ (IMPLIES (IN aix_ u) (<= r (magnitude (- aix_ c)))))) x)
  (if (dk-asm? '(IN z CC))
      (begin
        (dk-split! (dk-fact! 'aif-off-center 'c 'r x 'z))
        (aif-ne-sub! x 'z)
        (fact 'cc-recip-closed (list '- x 'z)))
      (aif-not-c! x))
  (aif-ne-sub! x 'c)
  (fact 'cc-recip-closed (list '- x 'c)))
(define (aif-repl e from to)
  (cond ((eq? e from) to)
        ((pair? e) (cons (aif-repl (car e) from to) (aif-repl (cdr e) from to)))
        (#t e)))
(define (aif-not-c! x)
  ;; x in u, x in CC and r <= |x - c| in context: lands NOT(x = c) (proves it in place
  ;; when it is the focus goal)
  (aif-cc! (list '- x 'c))
  (fact 'cc-magnitude-closed (list '- x 'c))
  (fact 'cc-magnitude-zero)
  (dk-have! (list 'NOT (list '= x 'c))
    (lambda ()
      (di)
      (dk-have! (list '= (list 'magnitude (list '- x 'c)) 0)
        (lambda () (subst (list '= x 'c)) (dk-have! '(= (- c c) 0) (lambda () (crs)))
                    (subst '(= (- c c) 0)) (aif-close!)))
      (dk-absurd! '(IN r RR) '(< 0 r) (list '<= 'r (list 'magnitude (list '- x 'c)))
                  (list '= (list 'magnitude (list '- x 'c)) 0) (list 'IN (list 'magnitude (list '- x 'c)) 'RR)))))
(define (aif-lam-typ! lam)
  ;; lam a VNB-LAMBDA over u; its value typed in CC by dk-type! after aif-pt!
  (dk-have! (list 'IN lam '(FUN u CC))
    (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (aif-pt! v) (aif-cc! (aif-repl (list-ref lam 3) (cadr lam) v)) (aif-close!)
                                          ))))))
(define (aif-avoid-c!)
  (dk-have! '(FORALL aix_ (IMPLIES (IN aix_ u) (NOT (= aix_ c))))
    (lambda () (let ((v (dk-di-var!)))
                 (fact 'subset-mem-fwd 'u 'CC v)
                 (dk-apply! (dk-ctx-form '(FORALL aix_ (IMPLIES (IN aix_ u) (<= r (magnitude (- aix_ c)))))) v)
                 (aif-not-c! v)))))
(define (aif-R!)
  (aif-avoid-c!)
  (dk-have! (list 'IN aif-R '(FUN u CC))
    (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (aif-pt! v) (aif-close!))))))
  (dk-have! (aif-ptw 'u aif-R (lambda (x) (list 'recip (list '- x 'c))))
    (lambda () (dk-di-var!) (if (not (dk-lam-b!)) (qrfl))))
  (fact 'aif-cont-recip-shift 'u 'c aif-R))
(define (aif-H! k)
  ;; (IN k NN) in context: H_k typed and continuous on u
  (fact 'nn-succ-closed k)
  (let ((P (aif-P k)) (H (aif-H k)))
    (dk-have! (list 'IN P '(FUN u CC))
      (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (aif-pt! v)
                                              (aif-cc! (list 'power (list 'recip (list '- v 'c)) (list 'succ k))))))))
    (dk-have! (aif-ptw 'u P (lambda (x) (list 'power (list aif-R x) (list 'succ k))))
      (lambda () (let ((v (dk-di-var!))) (aif-pt! v) (if (not (dk-lam-b!)) (qrfl)))))
    (fact 'aif-cont-power-of 'u aif-R (list 'succ k) P)
    (dk-have! (list 'IN H '(FUN u CC))
      (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (aif-pt! v)
                                              (aif-cc! (list '* (list 'phi v) (list 'power (list 'recip (list '- v 'c)) (list 'succ k)))))))))
    (dk-have! (aif-ptw 'u H (lambda (x) (list '* (list 'phi x) (list P x))))
      (lambda () (let ((v (dk-di-var!))) (aif-pt! v) (if (not (dk-lam-b!)) (qrfl)))))
    (fact 'aif-cont-product 'u 'phi P H)
    (fact 'line-int-in-cc 'u H 'pgam 'dgam 'a 'b)))
(define (aif-setting!)
  (aif-ms! 'u)
  (if (dk-asm? '(IN z CC)) (aif-cc! '(- z c)))
  (aif-R!))
(define (aif-T-typ!)
  (dk-have! (list 'IN aif-T '(FUN NN CC))
    (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                                          (aif-H! j)
                                          (aif-cc! (list '* (aif-LI (aif-H j)) (list 'power '(- z c) j)))))))))
(define (aif-SL-typ! k)
  (dk-have! (list 'IN (aif-SL k) '(FUN u CC))
    (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!)))
                                          (aif-pt! v)
                                          (dk-have! (list 'IN (aif-inner v) '(FUN NN CC))
                                            (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                                                                                   (fact 'nn-succ-closed j)
                                                                                   (aif-cc! (aif-term v j)))))))
                                          (fact 'cc-series-partial-sum-in-cc k (aif-inner v))
                                          (aif-close!)))))))

(sp (make-wff
  (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
    (aif-alls '(u c r phi pgam dgam a b z)
      (aif-imps (append aif-set-h aif-z-h)
        (list 'AND (list 'IN (aif-SL 'k) '(FUN u CC))
          (list 'AND (aif-cont 'u (aif-SL 'k))
                     (list '= (aif-LI (aif-SL 'k)) (list 'CC-SERIES-PARTIAL-SUM aif-T 'k))))))))))
(define aif-pi-br (use-induction))
(dk-focus! (cdr (assq 'base aif-pi-br)))
(dk-peel!)
(aif-setting!)
(define (aif-pi-zero-ptw! lam)
  ;; for x in u: (lam x) == 0, lam = SL_0
  (dk-have! (aif-ptw 'u lam (lambda (x) 0))
    (lambda ()
      (let ((v (dk-di-var!)))
        (dk-lam-b!)
        (subst (dk-fact! 'cc-series-partial-sum-zero (aif-inner v)))
        (qrfl)))))
(aif-SL-typ! 0)
(fact 'cc-zero-in)
(aif-pi-zero-ptw! (aif-SL 0))
(fact 'aif-cont-const 'u 0 (aif-SL 0))
(fact 'line-int-in-cc 'u (aif-SL 0) 'pgam 'dgam 'a 'b)
(dk-have! (aif-ptw 'u (aif-SL 0) (lambda (x) (list '* 0 (list (aif-SL 0) x))))
  (lambda ()
    (let ((v (dk-di-var!)))
      (dk-lam-b!)
      (subst (dk-fact! 'cc-series-partial-sum-zero (aif-inner v)))
      (dk-have! '(= (* 0 0) 0) (lambda () (crs)))
      (subst '(= (* 0 0) 0))
      (qrfl))))
(define aif-pi-e0 (dk-apply! (dk-cite! 'line-int-scalar 'u (aif-SL 0) 'pgam 'dgam 'a 'b) 0 (aif-SL 0)))
(define aif-pi-v (dk-name! (aif-LI (aif-SL 0)) 'CC))
(dk-have! (list '= aif-pi-v (list '* 0 aif-pi-v))
  (lambda () (subst (list '= aif-pi-v (aif-LI (aif-SL 0)))) (aif-close!)))
(dk-have! (list '= (list '* 0 aif-pi-v) 0) (lambda () (crs)))
(dk-have! (list '= aif-pi-v 0)
  (lambda () (subst (list '= aif-pi-v (list '* 0 aif-pi-v))) (aif-close!)))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-head-is? g '=)
             (subst (dk-fact! 'cc-series-partial-sum-zero aif-T))
             (subst (list '= (aif-LI (aif-SL 0)) aif-pi-v))
             (aif-close!))
            (#t (aif-close!))))))
(dk-focus! (cdr (assq 'step aif-pi-br)))
(define aif-pi-n (cdr (assq 'var aif-pi-br)))
(define aif-pi-ih (cdr (assq 'ih aif-pi-br)))
(dk-peel!)
(aif-setting!)
(define (aif-inner-typ! v)
  (dk-have! (list 'IN (aif-inner v) '(FUN NN CC))
    (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                                          (fact 'nn-succ-closed j)
                                          (aif-cc! (aif-term v j))))))))
(define (aif-cc-and! a b) (dk-have! (list 'AND (list 'IN a 'CC) (list 'IN b 'CC))))
(let* ((k aif-pi-n) (k1 (list 'succ k))
       (q '(- z c)) (qk (list 'power q k))
       (qlam (list 'VNB-LAMBDA 'aiw_ 'u qk))
       (SLk (aif-SL k)) (SLk1 (aif-SL k1)) (TLk (aif-TL k)) (Hk (aif-H k)))
  (fact 'nn-succ-closed k)
  (dk-split-all! (list (dk-apply! aif-pi-ih 'u 'c 'r 'phi 'pgam 'dgam 'a 'b 'z)))
  (aif-H! k)
  (aif-cc! qk)
  (aif-lam-typ! TLk)
  (aif-lam-typ! qlam)
  (dk-have! (aif-ptw 'u qlam (lambda (x) qk)) (lambda () (dk-di-var!) (if (not (dk-lam-b!)) (qrfl))))
  (fact 'aif-cont-const 'u qk qlam)
  (dk-have! (aif-ptw 'u TLk (lambda (x) (list '* (list Hk x) (list qlam x))))
    (lambda () (let ((v (dk-di-var!))) (aif-pt! v) (if (not (dk-lam-b!)) (qrfl)))))
  (fact 'aif-cont-product 'u Hk qlam TLk)
  (aif-SL-typ! k1)
  (dk-have! (aif-ptw 'u SLk1 (lambda (x) (list '+ (list SLk x) (list TLk x))))
    (lambda ()
      (let ((v (dk-di-var!)))
        (aif-pt! v)
        (aif-inner-typ! v)
        (fact 'cc-series-partial-sum-in-cc k (aif-inner v))
        (fact 'nn-succ-closed k)
        (aif-cc! (aif-term v k))
        (dk-have! (list 'IN (list (aif-inner v) k) 'CC) (lambda () (if (not (dk-lam-b!)) (ass))))
        (dk-lam-b!)
        (subst (dk-fact! 'cc-series-partial-sum-succ (aif-inner v) k))
        (if (not (dk-lam-b!)) (qrfl)))))
  (fact 'aif-cont-sum 'u SLk TLk SLk1)
  (fact 'line-int-in-cc 'u TLk 'pgam 'dgam 'a 'b)
  (let ((e1 (dk-apply! (dk-cite! 'line-int-sum 'u SLk TLk 'pgam 'dgam 'a 'b) SLk1)))
    (dk-have! (aif-ptw 'u TLk (lambda (x) (list '* qk (list Hk x))))
      (lambda ()
        (let* ((v (dk-di-var!))
               (ab (list '* (list 'phi v) (list 'power (list 'recip (list '- v 'c)) k1))))
          (aif-pt! v)
          (aif-cc! ab)
          (dk-lam-b!)
          (aif-cc-and! ab qk)
          (subst (dk-fact! 'cc-mul-comm ab qk))
          (qrfl))))
    (let ((e2 (dk-apply! (dk-cite! 'line-int-scalar 'u Hk 'pgam 'dgam 'a 'b) qk TLk)))
      (aif-T-typ!)
      (fact 'cc-series-partial-sum-in-cc k aif-T)
      (aif-cc! (list '* (aif-LI Hk) qk))
      (dk-have! (list 'IN (list aif-T k) 'CC) (lambda () (if (not (dk-lam-b!)) (ass))))
      (let ((e3 (dk-fact! 'cc-series-partial-sum-succ aif-T k)))
        (dk-conj-close!
