;;; ba-ideal-closure.scm -- BANACH ALGEBRAS: the closure of a left ideal is a left ideal, and a
;;; proper maximal left ideal is closed (Corollary 1.5).  F. J. Thayer, "Banach Algebras and
;;; Applications", ch. 1 introduction.
;;; Agent BA-1B, wave 2026-11-09.  Destination: theorem-library/ba-ideal-closure.scm.
;;; Library: operator-algebras.  All proofs modulo 0.
;;;
;;; THE ROUTE.  Each algebra operation with one argument fixed is a Lipschitz self-map of the
;;; algebra's metric space: w |-> w + q (constant 1), w |-> z w (constant |z|), w |-> y w (constant
;;; ||y||).  lipschitz-closure-image (ba-metric-lemmas) carries closures into closures, so the
;;; closure J of a left ideal I is closed under each; addition of two points of J is two steps
;;; (first x + q for q in I, then x + y).  Corollary 1.5: J is a left ideal containing I; J is
;;; proper, since 1 in J would put a point of I in the unit ball about 1 and so 1 in I
;;; (left-ideal-near-one); maximality gives J = I, and closure-subset-closed closes.
;;;
;;; LOAD WINDOW: after theorem-library/ba-metric-lemmas (lipschitz-closure-image), ba-neumann
;;; (ban-ms, ban-pts, ban-dist, ban-mul-sub-left), ba-spectrum (left-ideal-near-one), and the
;;; metric closure laws (closure-contains, closure-in-carrier, closure-subset-closed,
;;; fom-closure-near: frechet-open-mapping-proof).  Helper prefix: bic-.

(define (bic-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (if (and (not (sequent-node-grounded? l))
                           (let ((g (dk-goal-of l))) (and (pair? g) (eq? (car g) '=) (equal? (cadr g) (caddr g)))))
                      (begin (dk-focus! l) (rfl))))
                (dk-open-leaves)))
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba-ideal-closure: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba-ideal-closure: unfinished" name))))

(define (bic-st body) (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a) body))))
(define (bic-m x y) (list '(VMUL a) x y))
(define (bic-ad x y) (list '(VADD a) x y))
(define (bic-ng x) (list '(VNEG a) x))
(define (bic-sb x y) (bic-ad x (bic-ng y)))
(define (bic-nr x) (list '(VNRM a) x))
(define (bic-ac z x) (list '(ACT a) z x))
(define bic-one '(VONE a))
(define bic-zero '(VZERO a))
(define bic-bam '(BA-METRIC-SPACE a))
(define bic-jj '(CLOSURE (BA-METRIC-SPACE a) ii))
(define (bic-dist u v) (list '(DIST (BA-METRIC-SPACE a)) u v))
(define (bic-rw! from to) (subst (list '= from to)))

(define (bic-vt x)
  (let ((want (list 'IN x '(VEC a))))
    (cond ((dk-asm? want) x)
          ((equal? x bic-one) (dk-cite! 'ring-one-in-uba-as-ring 'a) x)
          ((equal? x bic-zero) (dk-cite! 'ring-zero-in-uba-as-ring 'a) x)
          ((and (pair? x) (equal? (car x) '(VADD a)))
           (bic-vt (cadr x)) (bic-vt (caddr x))
           (dk-cite! 'ring-add-closed-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VMUL a)))
           (bic-vt (cadr x)) (bic-vt (caddr x))
           (dk-cite! 'ring-carrier-closed-mul-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG a)))
           (bic-vt (cadr x))
           (dk-cite! 'ring-neg-in-carr-uba-as-ring 'a (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT a)))
           (bic-vt (caddr x)) (dk-cite! 'bae-act-type 'a (cadr x) (caddr x)) x)
          (#t (error "bic-vt: cannot type" (expression->string x))))))
(define (bic-rr! t)
  (cond ((dk-asm? (list 'IN t 'RR)) t)
        ((and (pair? t) (equal? (car t) '(VNRM a)))
         (bic-vt (cadr t)) (dk-cite! 'bae-vnrm-type 'a (cadr t)) t)
        (#t (dk-real! t) t)))

;;; open a left ideal ii: land (SUBSET ii VEC), 0 in ii, and return
;;; (add-closure scal-closure left-mul-closure), each as the context holds it
(define (bic-ideal-open! ii)
  (let* ((lf (list 'IS-LEFT-IDEAL 'a ii))
         (body (caddr (dk-cite! 'IS-LEFT-IDEAL 'a ii)))
         (sub (dk-project! (cadr body) 'IS-LEFT-IDEAL lf))
         (mul (dk-project! (caddr body) 'IS-LEFT-IDEAL lf))
         (sbody (caddr (dk-cite! 'IS-ALG-SUBSPACE 'a ii)))
         (ss (dk-project! (cadr sbody) 'IS-ALG-SUBSPACE sub))
         (z (dk-project! (cadr (caddr sbody)) 'IS-ALG-SUBSPACE sub))
         (ad (dk-project! (cadr (caddr (caddr sbody))) 'IS-ALG-SUBSPACE sub))
         (sc (dk-project! (caddr (caddr (caddr sbody))) 'IS-ALG-SUBSPACE sub)))
    (list ad sc mul)))

;;; the metric space facts: M metric, PTS M == VEC, ii subset PTS M
(define (bic-space! ii)
  (dk-cite! 'ban-ms 'a)
  (dk-cite! 'ban-pts 'a)
  (let ((f (list 'SUBSET ii (list 'PTS bic-bam))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (subst (list '== (list 'PTS bic-bam) '(VEC a))) (dk-ass!))))))
(define (bic-in-vec! y set)      ; (IN y set) and (SUBSET set VEC|PTS M) in context: land (IN y VEC)
  (let ((g (list 'IN y '(VEC a))))
    (if (not (dk-asm? g))
        (cond ((dk-asm? (list 'SUBSET set '(VEC a)))
               (dk-cite! 'subset-mem-fwd set '(VEC a) y))
              (#t
               (dk-cite! 'subset-mem-fwd set (list 'PTS bic-bam) y)
               (dk-have! g (lambda () (subst (list '== '(VEC a) (list 'PTS bic-bam))) (dk-ass!))))))
    g))
(define (bic-jj-sub!)           ; (SUBSET J (PTS M)) and (SUBSET J VEC)
  (dk-cite! 'closure-in-carrier bic-bam 'ii)
  (let ((f (list 'SUBSET bic-jj '(VEC a))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (subst (list '== '(VEC a) (list 'PTS bic-bam))) (dk-ass!))))))

;;; (bic-lip! LAM LC LIP! IMG! SRC TGT) -- LAM = (VNB-LAMBDA bcw_ (VEC a) body), LC its constant
;;; (typed RR, 0 <= LC in context).  LIP! proves, with v1, v2 typed in VEC and the goal
;;; (<= ||body(v1) - body(v2)|| (* LC ||v1 - v2||)), the estimate (it receives v1 v2).  IMG! proves,
;;; with p in SRC typed, the goal (IN body(p) (CLOSURE M TGT)) (it receives p).  Returns the
;;; consequent (FORALL x (IMPLIES (IN x (CLOSURE M SRC)) (IN (LAM x) (CLOSURE M TGT)))).
(define (bic-lip! lam lc lip! img! src tgt)
  (let* ((ft (list 'IN lam '(FUN (VEC a) (VEC a))))
         (pm (list 'PTS bic-bam))
         (fp (list 'IN lam (list 'FUN pm pm)))
         (to-vec (lambda (v)
                   (if (not (dk-asm? (list 'IN v '(VEC a))))
                       (dk-have! (list 'IN v '(VEC a))
                         (lambda () (subst (list '== '(VEC a) pm)) (dk-ass!))))))
         (lipf (list 'FORALL 'bcx_ (list 'IMPLIES (list 'IN 'bcx_ pm) (list 'FORALL 'bcp_ (list 'IMPLIES (list 'IN 'bcp_ pm)
                 (list '<= (bic-dist (list lam 'bcx_) (list lam 'bcp_)) (list '* lc (bic-dist 'bcx_ 'bcp_))))))))
         (imgf (list 'FORALL 'bcp_ (list 'IMPLIES (list 'IN 'bcp_ src) (list 'IN (list lam 'bcp_) (list 'CLOSURE bic-bam tgt))))))
    (dk-have! ft (lambda ()
                   (dk-lam-type! (lambda ()
                                   (dk-di-var!)
                                   (bic-vt (cadr (dk-goal)))
                                   (dk-ass!))
                                 (lambda () (dk-cite! 'ring-carr-in-set-uba-as-ring 'a) (dk-ass!)))))
    (dk-have! fp (lambda () (subst (list '== pm '(VEC a))) (dk-ass!)))
    (dk-have! lipf
      (lambda ()
        (let* ((landed (dk-peel!))
               (vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed)))
               (v1 (car vs)) (v2 (cadr vs)))
          (for-each to-vec vs)
          (dk-lam-b!)
          (let* ((g (dk-goal)) (b1 (cadr (cadr g))) (b2 (caddr (cadr g))))
            (bic-vt b1) (bic-vt b2)
            (dk-cite! 'ban-dist 'a b1 b2)
            (dk-cite! 'ban-dist 'a v1 v2)
            (bic-rw! (bic-dist b1 b2) (bic-nr (bic-sb b1 b2)))
            (bic-rw! (bic-dist v1 v2) (bic-nr (bic-sb v1 v2)))
            (lip! v1 v2)))))
    (dk-have! imgf
      (lambda ()
        (let* ((landed (dk-peel!))
               (p (cadr (car (filter (lambda (f) (dk-head-is? f 'IN)) landed)))))
          (bic-in-vec! p src)
          (dk-lam-b!)
          (img! p))))
    (dk-cite! 'lipschitz-closure-image bic-bam lam lc src tgt)))

;;; ---- (1) x in J, q in I  =>  x + q in J ----------------------------------------------------------
(sp (bic-st '(FORALL ii (IMPLIES (IS-LEFT-IDEAL a ii) (FORALL q (IMPLIES (IN q ii)
  (FORALL x (IMPLIES (IN x (CLOSURE (BA-METRIC-SPACE a) ii)) (IN ((VADD a) x q) (CLOSURE (BA-METRIC-SPACE a) ii))))))))))
(dk-peel!)
(let* ((ops (bic-ideal-open! 'ii))
       (x (cadr (cadr (dk-goal))))
       (lam (list 'VNB-LAMBDA 'bcw_ '(VEC a) (bic-ad 'bcw_ 'q))))
  (bic-space! 'ii)
  (bic-in-vec! 'q 'ii)
  (dk-real! 1) (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
  (dk-cite! 'closure-contains bic-bam 'ii)
  (let ((res (bic-lip! lam 1
               (lambda (v1 v2)
                 (dk-cite! 'frm-v-sub-shift-uba-as-module 'a v1 v2 'q)
                 (bic-rw! (bic-sb (bic-ad v1 'q) (bic-ad v2 'q)) (bic-sb v1 v2))
                 (bic-rr! (bic-nr (bic-sb v1 v2)))
                 (dk-ineq!))
               (lambda (p)
                 (dk-apply! (car ops) p 'q)
                 (dk-cite! 'subset-mem-fwd 'ii bic-jj (bic-ad p 'q))
                 (dk-ass!))
               'ii 'ii)))
    (bic-jj-sub!)
    (bic-in-vec! x bic-jj)
    (let ((m (dk-apply! res x)))
      (if (not (dk-lam-b-h! m)) (dk-ass!)))))
(bic-qed! 'bic-closure-add-one)

;;; ---- (2) x, y in J  =>  x + y in J ----------------------------------------------------------------
(sp (bic-st '(FORALL ii (IMPLIES (IS-LEFT-IDEAL a ii) (FORALL x (IMPLIES (IN x (CLOSURE (BA-METRIC-SPACE a) ii))
  (FORALL y (IMPLIES (IN y (CLOSURE (BA-METRIC-SPACE a) ii)) (IN ((VADD a) x y) (CLOSURE (BA-METRIC-SPACE a) ii))))))))))
(dk-peel!)
(let* ((ops (bic-ideal-open! 'ii))
       (lam (list 'VNB-LAMBDA 'bcw_ '(VEC a) (bic-ad 'x 'bcw_))))
  (bic-space! 'ii)
  (bic-jj-sub!)
  (bic-in-vec! 'x bic-jj)
  (bic-in-vec! 'y bic-jj)
  (dk-real! 1) (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
  (let ((res (bic-lip! lam 1
               (lambda (v1 v2)
                 (dk-cite! 'ring-add-comm-uba-as-ring 'a 'x v1)
                 (dk-cite! 'ring-add-comm-uba-as-ring 'a 'x v2)
                 (bic-rw! (bic-ad 'x v1) (bic-ad v1 'x))
                 (bic-rw! (bic-ad 'x v2) (bic-ad v2 'x))
                 (dk-cite! 'frm-v-sub-shift-uba-as-module 'a v1 v2 'x)
                 (bic-rw! (bic-sb (bic-ad v1 'x) (bic-ad v2 'x)) (bic-sb v1 v2))
                 (bic-rr! (bic-nr (bic-sb v1 v2)))
                 (dk-ineq!))
               (lambda (p)
                 (dk-cite! 'bic-closure-add-one 'a 'ii p 'x)
                 (dk-ass!))
               'ii 'ii)))
    (let ((m (dk-apply! res 'y)))
      (if (not (dk-lam-b-h! m)) (dk-ass!)))))
(bic-qed! 'bic-closure-add)

;;; ---- (3) z in CC, x in J  =>  z x in J -------------------------------------------------------------
(sp (bic-st '(FORALL ii (IMPLIES (IS-LEFT-IDEAL a ii) (FORALL z (IMPLIES (IN z CC)
  (FORALL x (IMPLIES (IN x (CLOSURE (BA-METRIC-SPACE a) ii)) (IN ((ACT a) z x) (CLOSURE (BA-METRIC-SPACE a) ii))))))))))
