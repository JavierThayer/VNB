               (lambda (p)
                 (dk-apply! (cadr ops) 'z p)
                 (dk-cite! 'subset-mem-fwd 'ii bic-jj (bic-ac 'z p))
                 (dk-ass!))
               'ii 'ii)))
    (bic-jj-sub!)
