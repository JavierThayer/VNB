;;; ---- (4) y in VEC, x in J  =>  y x in J ------------------------------------------------------------
(sp (bic-st '(FORALL ii (IMPLIES (IS-LEFT-IDEAL a ii) (FORALL y (IMPLIES (IN y (VEC a))
  (FORALL x (IMPLIES (IN x (CLOSURE (BA-METRIC-SPACE a) ii)) (IN ((VMUL a) y x) (CLOSURE (BA-METRIC-SPACE a) ii))))))))))
(dk-peel!)
(let* ((ops (bic-ideal-open! 'ii))
       (x (caddr (cadr (dk-goal))))
       (lam (list 'VNB-LAMBDA 'bcw_ '(VEC a) (bic-m 'y 'bcw_)))
       (ny (bic-nr 'y)))
  (bic-space! 'ii)
  (bic-rr! ny)
  (dk-cite! 'bal-uba-vnrm-nonneg 'a 'y)
  (dk-cite! 'closure-contains bic-bam 'ii)
  (let ((res (bic-lip! lam ny
               (lambda (v1 v2)
                 (dk-cite! 'ban-mul-sub-left 'a 'y v1 v2)
                 (bic-rw! (bic-sb (bic-m 'y v1) (bic-m 'y v2)) (bic-m 'y (bic-sb v1 v2)))
                 (bic-vt (bic-sb v1 v2))
                 (dk-cite! 'bal-uba-vnrm-submult 'a 'y (bic-sb v1 v2))
                 (dk-ass!))
               (lambda (p)
                 (dk-apply! (caddr ops) 'y p)
                 (dk-cite! 'subset-mem-fwd 'ii bic-jj (bic-m 'y p))
                 (dk-ass!))
               'ii 'ii)))
    (bic-jj-sub!)
    (bic-in-vec! x bic-jj)
    (let ((m (dk-apply! res x)))
      (if (not (dk-lam-b-h! m)) (dk-ass!)))))
(bic-qed! 'bic-closure-mul)

;;; ---- the closure of a left ideal is a left ideal (F7) ---------------------------------------------
(sp (bic-st '(FORALL ii (IMPLIES (IS-LEFT-IDEAL a ii) (IS-LEFT-IDEAL a (CLOSURE (BA-METRIC-SPACE a) ii))))))
(dk-peel!)
(bic-ideal-open! 'ii)
(bic-space! 'ii)
(bic-jj-sub!)
(dk-cite! 'closure-contains bic-bam 'ii)
(dk-cite! 'subset-mem-fwd 'ii bic-jj bic-zero)
(mac 'IS-LEFT-IDEAL)
(define (bic-close-part!)
  (let ((g (dk-goal)))
    (cond ((dk-head-is? g 'AND) (dk-conj-close! bic-close-part!))
          ((dk-head-is? g 'IS-ALG-SUBSPACE) (mac 'IS-ALG-SUBSPACE) (bic-close-part!))
          ((dk-head-is? g 'FORALL)
           (dk-peel!)
           (let* ((t (cadr (dk-goal))) (op (car t)) (u (cadr t)) (v (caddr t)))
             (dk-cite! (cond ((equal? op '(VADD a)) 'bic-closure-add)
                             ((equal? op '(ACT a)) 'bic-closure-act)
                             ((equal? op '(VMUL a)) 'bic-closure-mul)
                             (#t (error "bic-close-part!: unexpected" (expression->string t))))
                       'a 'ii u v)
             (dk-ass!)))
          (#t (dk-ass!)))))
(bic-close-part!)
(bic-qed! 'left-ideal-closure)

;;; ---- a left ideal containing 1 is the whole algebra ------------------------------------------------
(sp (bic-st '(FORALL jj (IMPLIES (IS-LEFT-IDEAL a jj) (IMPLIES (IN (VONE a) jj) (= jj (VEC a)))))))
(dk-peel!)
(let* ((ops (bic-ideal-open! 'jj))
       (univ (list 'FORALL 'bcu_ (list 'IFF (list 'IN 'bcu_ 'jj) (list 'IN 'bcu_ '(VEC a))))))
  (dk-have! univ
    (lambda ()
      (dk-peel!)
      (dk-iff! (lambda (g) (equal? (caddr g) '(VEC a)))
        (lambda () (bic-in-vec! (cadr (dk-goal)) 'jj) (dk-ass!))
        (lambda ()
          (let* ((u (cadr (dk-goal)))
                 (f (dk-apply! (caddr ops) u bic-one)))
            (dk-cite! 'ring-mul-right-id-uba-as-ring 'a u)
            (dk-rewrite-h! f (bic-m u bic-one) u)
            (dk-ass!))))))
  (dk-cite! 'class-extensionality 'jj '(VEC a))
  (dk-ass!))
(bic-qed! 'left-ideal-one-all)

;;; ---- Corollary 1.5: a maximal left ideal is closed --------------------------------------------------
(define (bic-pos-rr! t)          ; with (< 0 t) and (IN t RR) in context, prove the goal (POS-RR t)
  (mac 'pos-rr)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-ass!) #t)
            ((dk-head-is? (dk-goal) 'NOT)
             (di) (dk-absurd! (dk-rewrite-h! (list '< 0 t) t 0)))
            (#t (dk-ineq! (list '< 0 t)))))))

(sp (bic-st '(FORALL ii (IMPLIES (IS-MAXIMAL-LEFT-IDEAL a ii) (IS-CLOSED (BA-METRIC-SPACE a) ii)))))
(dk-peel!)
(let* ((mf '(IS-MAXIMAL-LEFT-IDEAL a ii))
       (body (caddr (dk-cite! 'IS-MAXIMAL-LEFT-IDEAL 'a 'ii)))
       (lf (dk-project! (cadr body) 'IS-MAXIMAL-LEFT-IDEAL mf))
       (prop (dk-project! (cadr (caddr body)) 'IS-MAXIMAL-LEFT-IDEAL mf))
       (mx (dk-project! (caddr (caddr body)) 'IS-MAXIMAL-LEFT-IDEAL mf)))
  (bic-ideal-open! 'ii)
  (bic-space! 'ii)
  (bic-jj-sub!)
  (dk-cite! 'closure-contains bic-bam 'ii)
  (dk-cite! 'left-ideal-closure 'a 'ii)
  (dk-real! 1)
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (dk-have! '(POS-RR 1) (lambda () (bic-pos-rr! 1)))
  (bic-vt bic-one)
  (dk-have! (list 'NOT (list '= bic-jj '(VEC a)))
    (lambda ()
      (di)
      (dk-have! (list 'IN bic-one bic-jj) (lambda () (subst (list '= bic-jj '(VEC a))) (dk-ass!)))
      (let* ((pt (dk-skolem! (dk-cite! 'fom-closure-near bic-bam 'ii bic-one 1)))
             (pv (bic-in-vec! pt 'ii)))
        (dk-cite! 'ban-dist 'a bic-one pt)
        (dk-rewrite-h! (list '< (bic-dist bic-one pt) 1) (bic-dist bic-one pt) (bic-nr (bic-sb bic-one pt)))
        (dk-cite! 'left-ideal-near-one 'a 'ii pt)
        (dk-cite! 'left-ideal-one-all 'a 'ii)
        (ai prop))))
  (let ((eq (dk-apply! mx bic-jj)))
    (dk-have! (list 'SUBSET bic-jj 'ii)
      (lambda () (subst eq) (dk-cite! 'subset-refl 'ii) (dk-ass!)))
    (dk-cite! 'closure-subset-closed bic-bam 'ii)
    (dk-ass!)))
(bic-qed! 'maximal-left-ideal-closed)

