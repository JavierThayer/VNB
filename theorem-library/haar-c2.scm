(define (hq-cart-set!)
  (let ((g (dk-goal)))
    (if (dk-head-is? (cadr g) 'CARTESIAN)
        (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))
        (ass))))
(define (hq-slot-type! acc typer)
  (dk-peel!)
  (if (dk-asm? hq-cpt) (dk-cite! 'ck-compact-is-ms 's))
  (hq-certify!)
  (mac 'CK-NVS)
  (slot acc)
  (nth-r)
  (dk-lam-type! (lambda () (dk-peel!) (typer (cadr (dk-goal)))) hq-cart-set!))

(sp (make-wff (hq-st '() '() (list 'IN '(VADD (CK-NVS s)) (list 'FUN (list 'CARTESIAN hq-C hq-C) hq-C)))))
(hq-slot-type! 'VADD
  (lambda (lam) (let ((body (cadddr lam)))
                  (dk-cite! 'rmc-cont-fns-add 's (car (cadr body)) (car (caddr body))) (ass))))
(hq-qed! 'ck-vadd-typing)

(sp (make-wff (hq-st '() '() (list 'IN '(ACT (CK-NVS s)) (list 'FUN (list 'CARTESIAN 'RR hq-C) hq-C)))))
(hq-slot-type! 'ACT
  (lambda (lam) (let ((body (cadddr lam)))
                  (dk-cite! 'rmc-cont-fns-scale 's (cadr body) (car (caddr body))) (ass))))
