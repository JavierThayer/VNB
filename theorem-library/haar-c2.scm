                                        (lambda () (dk-ineq! (list '<= (hq-gd z2 w2) mx) (list '<= mx d) r2 (list 'IN mx 'RR) (list 'IN d 'RR))))
                                      (hq-gmul! w1 w2)
                                      (hq-gapp! 'f q)
                                      (dk-apply! dcl w1 w2)
                                      (dk-apply! ecl q)
                                      (if (not (dk-lam-b!)) (ass))))))))))))))))))
(hq-qed! 'mg-orbit-joint-cont)

;;; ---- the orbit map is uniformly continuous ----
(sp (make-wff (hq-gcst '(f) (list (hq-inCg 'f))
   (list 'FORALL 'e (list 'IMPLIES '(POS-RR e)
     (list 'FORSOME 'd (list 'AND '(POS-RR d)
       (list 'FORALL 'a (list 'IMPLIES (hq-inPg 'a) (list 'FORALL 'b (list 'IMPLIES (hq-inPg 'b)
         (list 'IMPLIES (list '<= (hq-gd 'a 'b) 'd) (list '<= (hq-gdst (hq-L 'a 'f) (hq-L 'b 'f)) 'e)))))))))))))
(dk-peel!)
(hq-pr-setup!)
(define hq-e (cadr (dk-pick (lambda (x) (dk-head-is? x 'POS-RR)) "eps")))
(hq-pos! hq-e)
(dk-cite! 'product2-compact hq-Mg hq-Mg)
(dk-cite! 'mg-orbit-joint-cont 'G 'f)
(dk-cite! 'compact-continuous-uniformly-continuous hq-PR 'RR-MS (hq-H 'f))
(define hq-uc
  (let* ((cc (dk-cite! 'is-uniformly-continuous hq-PR 'RR-MS (hq-H 'f)))
         (cl (caddr (caddr (caddr (caddr cc))))))
    (dk-have! cl (lambda () (hq-prop! cc (list 'IS-UNIFORMLY-CONTINUOUS hq-PR 'RR-MS (hq-H 'f)))))
    cl))
(define hq-dlt (dk-skolem! (dk-apply! hq-uc hq-e)))
(define hq-dcl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f hq-dlt) (not (dk-contains? f 'POS-RR)))) "the uniform delta"))
(hq-pos! hq-dlt)
(ew hq-dlt)
(dk-conj-close!
  (lambda ()
    (if (not (dk-head-is? (dk-goal) 'FORALL))
        (ass)
        (let* ((ld (dk-peel!))
               (ins (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) hq-Pg))) ld))
               (a (cadr (car ins))) (b (cadr (cadr ins))))
          (dk-cite! 'mg-ltrans-cont 'G a 'f)
          (dk-cite! 'mg-ltrans-cont 'G b 'f)
          (dk-have! (list '<= 0 hq-e) (lambda () (dk-ineq! (list '< 0 hq-e) (list 'IN hq-e 'RR))))
          (dk-have! (list 'FORALL 'x (list 'IMPLIES (hq-inPg 'x)
                      (list '<= (list 'abs (list '- (list (hq-L a 'f) 'x) (list (hq-L b 'f) 'x))) hq-e)))
            (lambda ()
              (let* ((x (dk-di-var!))
                     (ax (hq-mul a x)) (bx (hq-mul b x))
                     (pa (list 'LIST a x)) (pb (list 'LIST b x)))
                (hq-gmul! a x) (hq-gmul! b x)
                (hq-gapp! 'f ax) (hq-gapp! 'f bx)
                (dk-cite! 'pair-in-cartesian hq-Pg hq-Pg a x)
                (dk-cite! 'pair-in-cartesian hq-Pg hq-Pg b x)
                (dk-rewrite-h! (list 'IN pa hq-Cart) hq-Cart hq-PPR)
                (dk-rewrite-h! (list 'IN pb hq-Cart) hq-Cart hq-PPR)
                (let* ((dab (hq-dist-real! a b)) (dxx (hq-dist-real! x x))
                       (z0 (dk-cite! 'metric-self-zero hq-Mg x))
                       (mx (list 'max (hq-gd a b) (hq-gd x x)))
                       (pdp (dk-cite! 'product2-dist-pair hq-Mg hq-Mg a b x x)))
                  (dk-have! (list '<= (hq-gd x x) hq-dlt) (lambda () (subst z0) (dk-ineq! (list '< 0 hq-dlt) (list 'IN hq-dlt 'RR))))
                  (dk-cite! 'rr-max-le (hq-gd a b) (hq-gd x x) hq-dlt)
                  (dk-rewrite-h! (list '<= mx hq-dlt) mx (list (list 'DIST hq-PR) pa pb))
                  (dk-apply! hq-dcl pa pb)
                  (let* ((hv (lambda (pp u v w)
                               (let ((eq (list '= (list (hq-H 'f) pp) (list 'f w))))
                                 (dk-have! eq (lambda ()
                                   (let ((leaf (proof-state-focus *ps*)))
                                     (dk-lam-b!)
                                     (if (and (not (sequent-node-grounded? leaf)) (dk-contains? (dk-goal) 'NTH)) (nth-r))
                                     (if (not (sequent-node-grounded? leaf)) (rfl)))))
                                 eq)))
                         (ea (hv pa a x ax))
                         (eb (hv pb b x bx))
                         (uc (dk-ctx-form (list '<= (list '(DIST RR-MS) (list (hq-H 'f) pa) (list (hq-H 'f) pb)) hq-e)))
                         (u2 (dk-rewrite-h! uc (list (hq-H 'f) pa) (list 'f ax)))
                         (u3 (dk-rewrite-h! (dk-ctx-form (list '<= (list '(DIST RR-MS) (list 'f ax) (list (hq-H 'f) pb)) hq-e)) (list (hq-H 'f) pb) (list 'f bx)))
                         (rd (dk-cite! 'rr-ms-dist (list 'f ax) (list 'f bx))))
                    (dk-rewrite-h! (dk-ctx-form (list '<= (list '(DIST RR-MS) (list 'f ax) (list 'f bx)) hq-e))
                                   (list '(DIST RR-MS) (list 'f ax) (list 'f bx)) (list 'abs (list '- (list 'f ax) (list 'f bx))))
                    (if (not (dk-lam-b!)) (ass)))))))
          (dk-cite! 'ck-dist-le hq-Mg (hq-L a 'f) (hq-L b 'f) hq-e)
          (ass)))))
