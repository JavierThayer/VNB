(sp (make-wff (hq-gcst '(f) (list (hq-inCg 'f)) (list 'IS-TOTALLY-BOUNDED-IN hq-gM (hq-orb 'f)))))
(dk-peel!)
(hq-gnsetup!)
(dk-cite! 'mg-orbit-compact 'G 'f)
(dk-cite! 'mg-orbit-sub-vec 'G 'f)
(dk-cite! 'mg-orbit-map-fun 'G 'f)
