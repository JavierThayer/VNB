(hq-qed! 'ck-vnrm-typing)

;;; =====================================================================
;;; the vector-space equations, pointwise
;;; =====================================================================
(define (hq-term? t) (or (equal? t hq-vz) (hq-op? t 'VADD) (hq-op? t 'ACT) (hq-op? t 'VNEG)))
(define (hq-eval! v)
  (let loop ((k 0))
    (let ((hit (hq-find (lambda (e) (and (pair? e) (= (length e) 2) (equal? (cadr e) v) (hq-term? (car e))))
                        (dk-goal))))
      (if (and hit (< k 40))
          (let* ((f (car hit))
                 (eqn (cond ((equal? f hq-vz) (dk-cite! 'ck-vzero-apply 's v))
                            ((hq-op? f 'VADD) (hq-cv! (cadr f)) (hq-cv! (caddr f))
                             (dk-cite! 'ck-vadd-apply 's (cadr f) (caddr f) v))
                            ((hq-op? f 'ACT) (hq-real! (cadr f)) (hq-cv! (caddr f))
                             (dk-cite! 'ck-act-apply 's (cadr f) (caddr f) v))
                            (#t (hq-cv! (cadr f)) (dk-cite! 'ck-vneg-apply 's (cadr f) v)))))
            (subst eqn)
            (loop (+ k 1)))))))
(define (hq-close-eq!)
  (let ((g (dk-goal))) (if (equal? (cadr g) (caddr g)) (rfl) (crs))))
(define (hq-ext!)
  (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
    (hq-cv! l) (hq-cv! r)
    (if (not (dk-asm? (list 'IN l hq-F))) (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's l))))
    (if (not (dk-asm? (list 'IN r hq-F))) (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's r))))
    (dk-fun-ext! l r '(PTS s) 'RR #f #f
      (lambda (v) (hq-eval! v) (hq-type-atoms!) (hq-close-eq!)))))

;;; =====================================================================
;;; CK-NVS(s) IS A NORMED VECTOR SPACE
;;; =====================================================================
(define hq-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define (hq-close-leaf!)
  (let ((g (dk-goal)))
    (cond
      ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH)) (mac 'CK-NVS) (len-r) (arith))
      ((dk-head-is? g 'IS-RING) (dk-cite! 'commutative-ring-is-ring (cadr g)) (ass))
      ((and (dk-head-is? g 'IN) (dk-asm? g)) (ass))
      ((and (dk-head-is? g 'IN) (equal? (cadr g) hq-vz)) (dk-cite! 'ck-vzero-in 's) (ass))
      ((and (dk-head-is? g 'IN) (pair? (cadr g)) (memq (car (cadr g)) '(VADD VNEG ACT VNRM)))
       (dk-cite! (cdr (assq (car (cadr g)) '((VADD . ck-vadd-typing) (VNEG . ck-vneg-typing)
                                            (ACT . ck-act-typing) (VNRM . ck-vnrm-typing))))
                 's)
       (ass))
      ((memq (dk-head g) '(is-associative is-commutative is-identity has-inverses))
       (mac (dk-head g)) (hq-close-leaf!))
      ((dk-head-is? g 'FORALL)
       (dk-peel!)
       (if (hq-has-redex? (dk-goal)) (dk-lam-b!))
       (hq-close-leaf!))
      ((dk-head-is? g 'AND)
       (for-each (lambda (l) (dk-focus! l) (hq-close-leaf!)) (dk-opened (lambda () (di)))))
      ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))
      ((and (dk-head-is? g '=) (pair? (cadr g)) (equal? (car (cadr g)) '(VNRM (CK-NVS s))))
       (let ((arg (cadr (cadr g))))
         (dk-cite! 'ck-vnrm-homogeneous 's (cadr arg) (caddr arg)) (ass)))
      ((dk-head-is? g '=) (hq-ext!))
      ((dk-head-is? g 'IFF)
       (dk-cite! 'ck-vnrm-definite 's (cadr (cadr (cadr g)))) (ass))
      ((and (dk-head-is? g '<=) (eqv? (cadr g) 0))
       (dk-cite! 'ck-vnrm-nonneg 's (cadr (caddr g))) (ass))
      ((dk-head-is? g '<=)
       (let ((arg (cadr (cadr g))))
         (dk-cite! 'ck-vnrm-triangle 's (cadr arg) (caddr arg)) (ass)))
      (#t (error "hq-close-leaf!: unexpected leaf" g)))))

(sp (make-wff '(FORALL s (IMPLIES (IS-COMPACT s) (IS-NORMED-VECTOR-SPACE (CK-NVS s))))))
(dk-peel!)
(dk-cite! 'ck-compact-is-ms 's)
(hq-certify!)
(dk-cite! 'ck-nvs-vec 's)
(dk-cite! 'ck-nvs-scal 's)
(mac 'IS-NORMED-VECTOR-SPACE)
(dk-isx-set!)
(subst (list '= '(VEC (CK-NVS s)) hq-C))
(subst (list '= '(SCAL (CK-NVS s)) hq-ring))
(for-each (lambda (mc) (vnb-guard (lambda () (mac mc))))
          '(rr-scalar-ring-carr rr-scalar-ring-add rr-scalar-ring-mul rr-scalar-ring-one))
(let loop ((k 0))
  (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (dk-open-leaves))))
    (if (and l (< k 60)) (begin (dk-focus! l) (di) (loop (+ k 1))))))
(for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (hq-close-leaf!))))
          (dk-open-leaves))
(for-each (lambda (l)
            (if (not (sequent-node-grounded? l))
                (let ((g (dk-goal-of l)))
                  (dk-focus! l)
                  (if (and (dk-head-is? g '=) (equal? (cadr g) (caddr g)) (pair? (cadr g))
                           (equal? (cdr (cadr g)) (list hq-D)))
                      (begin (mac 'CK-NVS) (slot (car (cadr g))) (nth-r) (rfl))
                      (hq-close-leaf!)))))
          (dk-open-leaves))
(hq-qed! 'ck-nvs-is-normed-vector-space)

;;; =====================================================================
;;; hq-p5.scm -- HAAR-C2 part 5: the distance of C(s) is the supremum distance; C(s) is complete.

(define hq-M '(NVS-METRIC-SPACE (CK-NVS s)))
(define (hq-dst u v) (list (list 'DIST hq-M) u v))
(define (hq-msetup!)
  (if (not (dk-asm? '(IS-METRIC-SPACE s))) (dk-cite! 'ck-compact-is-ms 's))
  (dk-cite! 'ck-nvs-is-normed-vector-space 's)
  (dk-cite! 'nvs-metric-is-ms hq-D)
  (dk-cite! 'nvs-ms-pts hq-D)
  (dk-cite! 'ck-nvs-vec 's))
;;; (IN v (VEC (CK-NVS s))) and (IN v (PTS M)) from (IN v (CONT-FNS s))
(define (hq-vec! v)
  (if (not (dk-asm? (list 'IN v '(VEC (CK-NVS s)))))
      (dk-rewrite-h! (hq-inC v) hq-C '(VEC (CK-NVS s)))))
(define (hq-pts! v)
  (hq-vec! v)
  (if (not (dk-asm? (list 'IN v (list 'PTS hq-M))))
      (dk-rewrite-h! (list 'IN v '(VEC (CK-NVS s))) '(VEC (CK-NVS s)) (list 'PTS hq-M))))
(define (hq-w f g) (list '(VADD (CK-NVS s)) f (list '(VNEG (CK-NVS s)) g)))
;;; rewrite the distance d(f, g) in the goal to CK-NORM(s, f + (-g)); return the difference term
(define (hq-dist-open! f g)
  (hq-vec! f) (hq-vec! g)
  (subst (dk-cite! 'nvs-metric-distance hq-D f g))
  (let ((w (hq-w f g)))
    (hq-norm-value! w)
    (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's w)))
    w))
;;; (= (W x) (- (f x) (g x))) for the difference term W, landed
(define (hq-w-value! f g x)
  (let ((e (list '= (list (hq-w f g) x) (list '- (list f x) (list g x)))))
    (if (not (dk-asm? e))
        (dk-have! e (lambda () (hq-eval! x) (hq-type-atoms!) (crs))))
    e))

(sp (make-wff (hq-cst '(f g x) (list (hq-inC 'f) (hq-inC 'g) '(IN x (PTS s)))
                      (list '<= '(abs (- (f x) (g x))) (hq-dst 'f 'g)))))
(dk-peel!)
(hq-msetup!)
(let* ((w (hq-dist-open! 'f 'g))
       (up (dk-apply! (dk-cite! 'ck-norm-upper 's w) 'x))
       (ev (hq-w-value! 'f 'g 'x)))
  (dk-rewrite-h! up (list w 'x) '(- (f x) (g x)))
  (ass))
(hq-qed! 'ck-dist-upper)

(sp (make-wff (hq-cst '(f g b) (list (hq-inC 'f) (hq-inC 'g) '(IN b RR) '(<= 0 b)
                                     '(FORALL x (IMPLIES (IN x (PTS s)) (<= (abs (- (f x) (g x))) b))))
                      (list '<= (hq-dst 'f 'g) 'b))))
(dk-peel!)
(hq-msetup!)
(define hq-bnd (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'b))) "the bound"))
(let ((w (hq-dist-open! 'f 'g)))
  (hq-norm-le! w 'b
    (lambda (x)
      (subst (hq-w-value! 'f 'g x))
      (dk-apply! hq-bnd x)
      (ass)))
  (ass))
(hq-qed! 'ck-dist-le)

;;; CONT-FNS(s) is a subset of FUN(PTS s, RR)
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'SUBSET hq-C hq-F)))))
(dk-peel!)
(dk-cite! 'ms-pts-is-set 's)
(fact 'rr-is-set)
(dk-have! (list 'IN hq-F 'SET) (lambda () (mac 'fun-set-iff) (dk-conj-close! (lambda () (ass)))))
(dk-cite! 'ck-cont-fns-is-set 's)
(mac 'subset-def)
(let ((h (dk-di-var!)))
  (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's h)))
  (ass))
(hq-qed! 'ck-cont-fns-subset-fun)

;;; =====================================================================
;;; C(s) is complete
;;; =====================================================================
(sp (make-wff (hq-cst '() '() (list 'IS-COMPLETE hq-M))))
(dk-peel!)
(hq-msetup!)
(mac 'is-complete)
(dk-conj-close!
  (lambda ()
    (if (not (dk-head-is? (dk-goal) 'FORALL))
        (ass)
        (begin
          (dk-peel!)
          (let* ((phi (caddr (dk-pick (lambda (x) (dk-head-is? x 'IS-CAUCHY-SEQ)) "the Cauchy hypothesis")))
                 (cy (dk-cite! 'is-cauchy-seq hq-M phi)))
            (dk-have! (caddr cy) (lambda () (hq-prop! cy (list 'IS-CAUCHY-SEQ hq-M phi))))
            (dk-split-all! (list (caddr cy)))
            (let* ((cauchy (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'POS-RR))) "the Cauchy clause"))
                   (phiC (dk-rewrite-h! (list 'IN phi (list 'FUN 'NN (list 'PTS hq-M))) (list 'PTS hq-M) '(VEC (CK-NVS s))))
                   (phiC2 (dk-rewrite-h! phiC '(VEC (CK-NVS s)) hq-C)))
              (dk-cite! 'ck-cont-fns-subset-fun 's)
              (dk-cite! 'fun-codomain-superset phi 'NN hq-C hq-F)
              ;; every member of the sequence is continuous
              (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IS-CONTINUOUS 's 'RR-MS (list phi 'k))))
                (lambda ()
                  (let ((k (dk-di-var!)))
                    (dk-cite! 'fun-apply-type-c phi 'NN hq-C k)
                    (let ((c (dk-cite! 'rmc-cont-fns-mem 's (list phi k))))
                      (hq-prop! c (hq-inC (list phi k)))))))
              ;; the sequence is uniformly Cauchy
              (let ((uc (dk-cite! 'is-unif-cauchy 's phi)))
                (dk-have! (caddr uc)
                  (lambda ()
                    (dk-conj-close!
                      (lambda ()
                        (if (not (dk-head-is? (dk-goal) 'FORALL))
                            (ass)
                            (let* ((e (dk-di-var! (lambda (g) (cadr (cadr g))))))
                              (di)
                              (hq-pos! e)
                              (let* ((d (dk-halve! e))
                                     (n (dk-skolem! (dk-apply! cauchy d)))
                                     (cl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x n) (dk-contains? x 'DIST) (not (dk-contains? x 'POS-RR)))) "the n clause")))
                                (ew n)
                                (dk-conj-close!
                                  (lambda ()
                                    (if (not (dk-head-is? (dk-goal) 'FORALL))
                                        (ass)
                                        (let* ((k (dk-di-var! (lambda (g) (cadr (cadr (cadr g)))))))
                                          (dk-split-all! (dk-landed (lambda () (di))))
                                          (let ((l (dk-di-var! (lambda (g) (cadr (cadr (cadr g)))))))
                                            (dk-split-all! (dk-landed (lambda () (di))))
                                            (let ((x (dk-di-var!)))
                                              (hq-and! (list '<= n k) (list '<= n l))
                                              (let* ((dkl (dk-apply! cl k l))
                                                     (fk (list phi k)) (fl (list phi l)))
                                                (dk-cite! 'fun-apply-type-c phi 'NN hq-C k)
                                                (dk-cite! 'fun-apply-type-c phi 'NN hq-C l)
                                                (hq-app! fk x) (hq-app! fl x)
                                                (hq-pts! fk) (hq-pts! fl)
                                                (dk-cite! 'metric-dist-real hq-M fk fl)
                                                (let ((up (dk-cite! 'ck-dist-upper 's fk fl x))
                                                      (ab (list 'abs (list '- (list fk x) (list fl x)))))
                                                  (begin (dk-real! (cadr ab)) (if (not (dk-asm? (list (quote IN) ab (quote RR)))) (dk-cite! (quote rr-abs-closed) (cadr ab))))
                                                  (dk-ineq! up dkl (list '= (list '+ d d) e) (list '< 0 d)
                                                            (list 'IN ab 'RR) (list 'IN (hq-dst fk fl) 'RR) (list 'IN d 'RR) (list 'IN e 'RR)))))))))))))))))
                (dk-have! (list 'IS-UNIF-CAUCHY 's phi) (lambda () (hq-prop! uc (caddr uc)))))
              ;; the uniform limit
              (let* ((lim (dk-cite! 'unif-cauchy-cont-implies-uniform-limit 's phi))
                     (g (dk-skolem! lim))
                     (gF (list 'IN g hq-F)))
                (let ((c (dk-cite! 'rmc-cont-fns-mem 's g)))
                  (dk-have! (hq-inC g) (lambda () (hq-prop! c gF (list 'IS-CONTINUOUS 's 'RR-MS g)))))
                (let* ((cu (dk-cite! 'converges-uniformly 's phi g))
                       (_1 (dk-have! (caddr cu) (lambda () (hq-prop! cu (list 'CONVERGES-UNIFORMLY 's phi g)))))
                       (_2 (dk-split-all! (list (caddr cu))))
                       (ucl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'POS-RR) (dk-contains? x g))) "the uniform clause")))
                  (hq-pts! g)
                  (mac 'converges)
                  (ew g)
                  (mac 'converges-to)
                  (dk-conj-close!
                    (lambda ()
                      (if (not (dk-head-is? (dk-goal) 'FORALL))
                          (ass)
                          (let ((e (dk-di-var! (lambda (gl) (cadr (cadr gl))))))
                            (di)
                            (hq-pos! e)
                            (let* ((n (dk-skolem! (dk-apply! ucl e)))
                                   (cl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x n) (dk-contains? x 'abs) (not (dk-contains? x 'POS-RR)))) "the cap clause")))
                              (ew n)
                              (dk-conj-close!
                                (lambda ()
                                  (if (not (dk-head-is? (dk-goal) 'FORALL))
                                      (ass)
                                      (let ((k (dk-di-var!)))
                                        (di)
                                        (begin
                                          (hq-and! (list 'IN k 'NN) (list '<= n k))
                                          (let* ((fk (list phi k)) (cl2 (dk-apply! cl k)))
                                            (dk-cite! 'fun-apply-type-c phi 'NN hq-C k)
                                            (dk-have! (list '<= 0 e) (lambda () (dk-ineq! (list '< 0 e) (list 'IN e 'RR))))
                                            (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS s)) (list '<= (list 'abs (list '- (list fk 'x) (list g 'x))) e)))
                                              (lambda ()
                                                (let ((x (dk-di-var!)))
                                                  (hq-app! fk x) (hq-app! g x)
                                                  (let ((ab (list 'abs (list '- (list fk x) (list g x)))))
                                                    (begin (dk-real! (cadr ab)) (if (not (dk-asm? (list (quote IN) ab (quote RR)))) (dk-cite! (quote rr-abs-closed) (cadr ab))))
                                                    (dk-ineq! (dk-apply! cl2 x) (list 'IN ab 'RR) (list 'IN e 'RR))))))
                                            (dk-cite! 'ck-dist-le 's fk g e)
                                            (ass))))))))))))))))))))
(hq-qed! 'ck-nvs-complete)

;;; =====================================================================
;;; hq-p6.scm -- HAAR-C2 part 6: the metric group G read off (points, distance, the group view), and the
;;; group laws used for translations, stated with the accessors of G on the points of its metric space.

(define hq-Mg '(METRIC-GROUP-MS G))
(define hq-Pg '(PTS (METRIC-GROUP-MS G)))
(define hq-GG '(METRIC-GROUP-GROUP G))
(define (hq-gst vars guards body) (forall-guarded (cons 'G vars) (cons '(IS-METRIC-GROUP G) guards) body))
(define (hq-inPg v) (list 'IN v hq-Pg))
(define (hq-mul a b) (list '(OPR G) a b))
(define (hq-inv a) (list '(INV G) a))

;;; ---- read-offs ----
(sp (make-wff (hq-gst '() '() (list '== hq-Pg '(CARR G)))))
(dk-peel!)
(slot 'PTS)
(qrfl)
(hq-qed! 'mg-ms-pts)

(sp (make-wff (hq-gst '() '() (list '== '(DIST (METRIC-GROUP-MS G)) '(GDIST G)))))
(dk-peel!)
(slot 'DIST)
(qrfl)
(hq-qed! 'mg-ms-dist)

(sp (make-wff (hq-gst '() '() (list '== '(CARR (METRIC-GROUP-GROUP G)) '(CARR G)))))
(dk-peel!)
(slot 'CARR)
(qrfl)
(hq-qed! 'mg-group-carr)

(sp (make-wff (hq-gst '() '() (list '== '(OPR (METRIC-GROUP-GROUP G)) '(OPR G)))))
(dk-peel!)
(slot 'OPR)
(qrfl)
(hq-qed! 'mg-group-opr)

(sp (make-wff (hq-gst '() '() (list '== '(INV (METRIC-GROUP-GROUP G)) '(INV G)))))
(dk-peel!)
(slot 'INV)
(qrfl)
(hq-qed! 'mg-group-inv)

(sp (make-wff (hq-gst '() '() (list '== '(IDEN (METRIC-GROUP-GROUP G)) '(IDEN G)))))
(dk-peel!)
(slot 'IDEN)
(qrfl)
(hq-qed! 'mg-group-iden)

;;; ---- the setup for a group law: the group view, the read-offs, the typings carried to CARR(GG) ----
(define (hq-gsetup! vs)
  (dk-cite! 'metric-group-ms-is-metric-space 'G)
  (dk-cite! 'metric-group-group-is-group 'G)
  (for-each (lambda (n) (dk-cite! n 'G)) '(mg-ms-pts mg-group-carr mg-group-opr mg-group-inv mg-group-iden))
  (for-each (lambda (v)
              (let ((t1 (list 'IN v '(CARR G))) (t2 (list 'IN v '(CARR (METRIC-GROUP-GROUP G)))))
                (if (not (dk-asm? t1)) (dk-rewrite-h! (hq-inPg v) hq-Pg '(CARR G)))
                (if (not (dk-asm? t2)) (dk-rewrite-h! t1 '(CARR G) '(CARR (METRIC-GROUP-GROUP G))))))
            vs))
;;; the goal's accessors of G moved to the group view
(define (hq-to-GG!)
  (for-each (lambda (pr) (if (dk-contains? (dk-goal) (car pr)) (subst (list '= (car pr) (cadr pr)))))
            (list (list '(OPR G) '(OPR (METRIC-GROUP-GROUP G)))
                  (list '(INV G) '(INV (METRIC-GROUP-GROUP G)))
                  (list '(IDEN G) '(IDEN (METRIC-GROUP-GROUP G)))
                  (list hq-Pg '(CARR G))
                  (list '(CARR G) '(CARR (METRIC-GROUP-GROUP G))))))

(sp (make-wff (hq-gst '(a b) (list (hq-inPg 'a) (hq-inPg 'b)) (hq-inPg (hq-mul 'a 'b)))))
(dk-peel!)
(hq-gsetup! '(a b))
(hq-to-GG!)
(dk-cite! 'group-carrier-closed-opr hq-GG 'a 'b)
(ass)
(hq-qed! 'mg-opr-in)

(sp (make-wff (hq-gst '(a) (list (hq-inPg 'a)) (hq-inPg (hq-inv 'a)))))
(dk-peel!)
(hq-gsetup! '(a))
(hq-to-GG!)
(dk-cite! 'group-inv-in hq-GG 'a)
(ass)
(hq-qed! 'mg-inv-in)

(sp (make-wff (hq-gst '() '() (hq-inPg '(IDEN G)))))
(dk-peel!)
(hq-gsetup! '())
(hq-to-GG!)
(dk-cite! 'group-identity-in hq-GG)
(ass)
(hq-qed! 'mg-iden-in)

(sp (make-wff (hq-gst '(a y) (list (hq-inPg 'a) (hq-inPg 'y)) (list '= (hq-mul 'a (hq-mul (hq-inv 'a) 'y)) 'y))))
(dk-peel!)
(hq-gsetup! '(a y))
(hq-to-GG!)
(dk-split-all! (list (dk-cite! 'group-inv-cancel hq-GG 'a 'y)))
(ass)
(hq-qed! 'mg-mul-inv-cancel)

(sp (make-wff (hq-gst '(a y) (list (hq-inPg 'a) (hq-inPg 'y)) (list '= (hq-mul (hq-inv 'a) (hq-mul 'a 'y)) 'y))))
(dk-peel!)
(hq-gsetup! '(a y))
(hq-to-GG!)
(dk-split-all! (list (dk-cite! 'group-inv-cancel hq-GG 'a 'y)))
(ass)
(hq-qed! 'mg-inv-mul-cancel)

(sp (make-wff (hq-gst '(a b y) (list (hq-inPg 'a) (hq-inPg 'b) (hq-inPg 'y))
                      (list '= (hq-mul (hq-mul 'a 'b) 'y) (hq-mul 'a (hq-mul 'b 'y))))))
(dk-peel!)
(hq-gsetup! '(a b y))
(hq-to-GG!)
(dk-cite! 'group-assoc hq-GG 'a 'b 'y)
(ass)
(hq-qed! 'mg-assoc)

(sp (make-wff (hq-gst '(y) (list (hq-inPg 'y)) (list '= (hq-mul '(IDEN G) 'y) 'y))))
(dk-peel!)
(hq-gsetup! '(y))
(hq-to-GG!)
(dk-cite! 'group-left-id hq-GG 'y)
(ass)
(hq-qed! 'mg-left-id)

(sp (make-wff (hq-gst '(y) (list (hq-inPg 'y)) (list '= (hq-mul 'y '(IDEN G)) 'y))))
(dk-peel!)
(hq-gsetup! '(y))
(hq-to-GG!)
(dk-cite! 'group-op-right-id hq-GG 'y)
(ass)
(hq-qed! 'mg-right-id)

;;; =====================================================================
;;; hq-p7.scm -- HAAR-C2 part 7: continuity of the product of G at a point, read on its metric space; a left
;;; translate x |-> h(a x) of a continuous function is continuous.

(define hq-Cg (list 'CONT-FNS hq-Mg))
(define (hq-inCg v) (list 'IN v hq-Cg))
(define hq-Dg '(DIST (METRIC-GROUP-MS G)))
(define (hq-gd u v) (list hq-Dg u v))
;;; the left translate x |-> h(a x)
(define (hq-L a h) (list 'VNB-LAMBDA 'hix_ hq-Pg (list h (hq-mul a 'hix_))))

;;; ---- the product of G is continuous at each pair of points ----
(sp (make-wff (hq-gst '(u v) (list (hq-inPg 'u) (hq-inPg 'v))
   (list 'FORALL 'e (list 'IMPLIES '(POS-RR e)
     (list 'FORSOME 'd (list 'AND '(POS-RR d)
       (list 'FORALL 'p (list 'IMPLIES (hq-inPg 'p) (list 'FORALL 'q (list 'IMPLIES (hq-inPg 'q)
         (list 'IMPLIES (list '<= (hq-gd 'u 'p) 'd) (list 'IMPLIES (list '<= (hq-gd 'v 'q) 'd)
           (list '<= (hq-gd (hq-mul 'u 'v) (hq-mul 'p 'q)) 'e))))))))))))))
(dk-peel!)
(hq-gsetup! '(u v))
(dk-cite! 'mg-ms-dist 'G)
(dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-metric-group 'G))))
(define hq-mlaw (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'mgq_) (dk-contains? x 'mgu_))) "the product law"))
(let ((e (cadr (dk-pick (lambda (x) (dk-head-is? x 'POS-RR)) "eps"))))
  (subst (list '= hq-Pg '(CARR G)))
  (subst (list '= hq-Dg '(GDIST G)))
  (dk-apply! hq-mlaw 'u 'v e)
  (ass))
(hq-qed! 'mg-mul-cont)

;;; ---- a left translate of a continuous function is continuous ----
(define (hq-gapp! h x)                 ; (h x) in RR for h in C(G), x in pts
  (let ((ty (list 'IN (list h x) 'RR)))
    (if (not (dk-asm? ty))
        (begin
          (if (not (dk-asm? (list 'IN h (list 'FUN hq-Pg 'RR))))
              (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts hq-Mg h))))
          (dk-cite! 'fun-apply-type-c h hq-Pg 'RR x)))
    ty))
(define (hq-gmul! a x)
  (let ((ty (hq-inPg (hq-mul a x))))
    (if (not (dk-asm? ty)) (dk-cite! 'mg-opr-in 'G a x))
    ty))

(sp (make-wff (hq-gst '(a h) (list (hq-inPg 'a) (hq-inCg 'h)) (hq-inCg (hq-L 'a 'h)))))
(dk-peel!)
(dk-cite! 'metric-group-ms-is-metric-space 'G)
(fact 'rr-is-metric-space)
(hq-ptsrr!)
(dk-cite! 'mg-ms-pts 'G)
(dk-cite! 'mg-ms-dist 'G)
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts hq-Mg 'h)))
(define hq-hc (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'IS-CONTINUOUS-AT))) "h continuous"))
(dk-cite! 'ms-pts-is-set hq-Mg)
(dk-have! (list 'IN (hq-L 'a 'h) (list 'FUN hq-Pg 'RR))
  (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (hq-gmul! 'a x) (hq-gapp! 'h (hq-mul 'a x)) (ass))))))
(dk-have! (list 'IN (hq-L 'a 'h) (list 'FUN hq-Pg '(PTS RR-MS)))
  (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
(dk-have! (list 'IN 'h (list 'FUN hq-Pg '(PTS RR-MS)))
  (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
(dk-have! (list 'FORALL 'x (list 'IMPLIES (hq-inPg 'x) (list 'IS-CONTINUOUS-AT hq-Mg 'RR-MS (hq-L 'a 'h) 'x)))
 (lambda ()
(let ((x (dk-di-var!)))
  (hq-gmul! 'a x)
  (hq-gapp! 'h (hq-mul 'a x))
  (let* ((ax (hq-mul 'a x))
         (hca (dk-apply! hq-hc ax))
         (cc (dk-cite! 'is-continuous-at hq-Mg 'RR-MS 'h ax))
         (cl (caddr (caddr (caddr (caddr (caddr cc)))))))
    (dk-have! cl (lambda () (hq-prop! cc (list 'IS-CONTINUOUS-AT hq-Mg 'RR-MS 'h ax))))
    (mac 'is-continuous-at)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-head-is? (dk-goal) 'FORALL))
            (ass)
            (let ((e (dk-di-var! (lambda (g) (cadr (cadr g))))))
              (di)
              (let* ((eta (dk-skolem! (dk-apply! cl e)))
                     (ecl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f eta) (not (dk-contains? f 'POS-RR)))) "h's delta clause"))
                     (ml (dk-cite! 'mg-mul-cont 'G 'a x))
                     (d (dk-skolem! (dk-apply! ml eta)))
                     (dcl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d) (not (dk-contains? f 'POS-RR)))) "the product's delta")))
                (hq-pos! d)
                (ew d)
                (dk-conj-close!
                  (lambda ()
                    (if (not (dk-head-is? (dk-goal) 'FORALL))
                        (ass)
                        (let ((y (dk-di-var!)))
                          (di)
                          (hq-gmul! 'a y)
                          (hq-gapp! 'h (hq-mul 'a y))
                          (let* ((z (dk-cite! 'metric-self-zero hq-Mg 'a)))
                            (dk-have! (list '<= (hq-gd 'a 'a) d) (lambda () (subst z) (dk-ineq! (list '< 0 d) (list 'IN d 'RR))))
                            (dk-apply! dcl 'a y)
                            (dk-apply! ecl (hq-mul 'a y))
                            (if (not (dk-lam-b!)) (ass))))))))))))))))
(dk-cite! 'rmc-cont-fns-intro hq-Mg (hq-L 'a 'h))
(ass)
(hq-qed! 'mg-ltrans-cont)

;;; =====================================================================
;;; hq-p8.scm -- HAAR-C2 part 8: precomposition h |-> h o phi with a map phi of a compact space s into itself.
;;; It preserves convex combinations in CK-NVS(s), it does not increase the supremum distance, and it keeps it
;;; when phi is onto.  The translations of a metric group are the instance (part 9).

(define hq-phiF '(IN phi (FUN (PTS s) (PTS s))))
(define (hq-P h) (list 'VNB-LAMBDA 'hix_ '(PTS s) (list h (list 'phi 'hix_))))
(define hq-onto '(FORALL y (IMPLIES (IN y (PTS s)) (FORSOME x (AND (IN x (PTS s)) (= (phi x) y))))))
(define (hq-phix! x)
  (let ((ty (list 'IN (list 'phi x) '(PTS s))))
    (if (not (dk-asm? ty)) (dk-cite! 'fun-apply-type-c 'phi '(PTS s) '(PTS s) x))
    ty))
;;; the precomposite is a real function on pts(s)
(define (hq-P-fun! h)
  (let ((ty (list 'IN (hq-P h) hq-F)))
    (if (not (dk-asm? ty))
        (begin
          (if (not (dk-asm? '(IN (PTS s) SET))) (dk-cite! 'ms-pts-is-set 's))
          (dk-have! ty (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (hq-phix! x) (hq-app! h (list 'phi x)) (ass))))))))
    ty))
;;; ((P h) x) reduced to h(phi x) in the goal, with its typing
(define (hq-P-at! h x)
  (hq-phix! x)
  (hq-app! h (list 'phi x)))

(sp (make-wff (hq-cst '(phi f) (list hq-phiF (hq-inC 'f)) (list 'IN (hq-P 'f) hq-F))))
(dk-peel!)
(dk-cite! 'ck-compact-is-ms 's)
(hq-P-fun! 'f)
(ass)
(hq-qed! 'ck-precomp-fun)

;;; ---- convex combinations ----
(sp (make-wff (hq-cst '(phi u v t) (list hq-phiF (hq-inC 'u) (hq-inC 'v) (hq-inC (hq-P 'u)) (hq-inC (hq-P 'v)) '(IN t RR))
   (list '= (hq-P (list '(VADD (CK-NVS s)) (list '(ACT (CK-NVS s)) '(- 1 t) 'u) (list '(ACT (CK-NVS s)) 't 'v)))
            (list '(VADD (CK-NVS s)) (list '(ACT (CK-NVS s)) '(- 1 t) (hq-P 'u)) (list '(ACT (CK-NVS s)) 't (hq-P 'v)))))))
(dk-peel!)
(dk-cite! 'ck-compact-is-ms 's)
(dk-real! '(- 1 t))
(let* ((w (list '(VADD (CK-NVS s)) (list '(ACT (CK-NVS s)) '(- 1 t) 'u) (list '(ACT (CK-NVS s)) 't 'v)))
       (r (list '(VADD (CK-NVS s)) (list '(ACT (CK-NVS s)) '(- 1 t) (hq-P 'u)) (list '(ACT (CK-NVS s)) 't (hq-P 'v)))))
  (hq-cv! w)
  (hq-cv! r)
  (hq-P-fun! w)
  (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's r)))
  (dk-fun-ext! (hq-P w) r '(PTS s) 'RR #f #f
    (lambda (x)
      (hq-P-at! w x)
      (hq-P-at! 'u x)
      (hq-P-at! 'v x)
      (hq-eval! x)
      (if (hq-has-redex? (dk-goal)) (dk-lam-b!))
      (hq-eval! (list 'phi x))
      (hq-type-atoms!)
      (hq-close-eq!))))
(hq-qed! 'ck-precomp-affine)

;;; ---- the supremum distance ----
(define (hq-P-dist-setup! f g)
  (hq-msetup!)
  (hq-P-fun! f) (hq-P-fun! g)
  (hq-pts! f) (hq-pts! g) (hq-pts! (hq-P f)) (hq-pts! (hq-P g)))

(sp (make-wff (hq-cst '(phi f g) (list hq-phiF (hq-inC 'f) (hq-inC 'g) (hq-inC (hq-P 'f)) (hq-inC (hq-P 'g)))
   (list '<= (hq-dst (hq-P 'f) (hq-P 'g)) (hq-dst 'f 'g)))))
(dk-peel!)
(hq-P-dist-setup! 'f 'g)
(dk-cite! 'metric-dist-real hq-M 'f 'g)
(dk-cite! 'metric-pos hq-M 'f 'g)
(dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS s))
            (list '<= (list 'abs (list '- (list (hq-P 'f) 'x) (list (hq-P 'g) 'x))) (hq-dst 'f 'g))))
  (lambda ()
    (let ((x (dk-di-var!)))
      (hq-P-at! 'f x) (hq-P-at! 'g x)
      (dk-lam-b!)
      (dk-cite! 'ck-dist-upper 's 'f 'g (list 'phi x))
      (ass))))
(dk-cite! 'ck-dist-le 's (hq-P 'f) (hq-P 'g) (hq-dst 'f 'g))
(ass)
(hq-qed! 'ck-precomp-dist-le)

(sp (make-wff (hq-cst '(phi f g) (list hq-phiF hq-onto (hq-inC 'f) (hq-inC 'g) (hq-inC (hq-P 'f)) (hq-inC (hq-P 'g)))
   (list '= (hq-dst (hq-P 'f) (hq-P 'g)) (hq-dst 'f 'g)))))
(dk-peel!)
(hq-P-dist-setup! 'f 'g)
(define hq-ontoh (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'phi) (dk-contains? x 'FORSOME))) "onto"))
(let ((dPP (hq-dst (hq-P 'f) (hq-P 'g))) (dff (hq-dst 'f 'g)))
  (dk-cite! 'metric-dist-real hq-M 'f 'g)
  (dk-cite! 'metric-dist-real hq-M (hq-P 'f) (hq-P 'g))
  (dk-cite! 'metric-pos hq-M (hq-P 'f) (hq-P 'g))
  (dk-cite! 'ck-precomp-dist-le 's 'phi 'f 'g)
  (dk-have! (list 'FORALL 'y (list 'IMPLIES '(IN y (PTS s))
              (list '<= (list 'abs (list '- '(f y) '(g y))) dPP)))
    (lambda ()
      (let* ((y (dk-di-var!))
             (x (dk-skolem! (dk-apply! hq-ontoh y)))
             (up (dk-cite! 'ck-dist-upper 's (hq-P 'f) (hq-P 'g) x)))
        (hq-P-at! 'f x) (hq-P-at! 'g x)
        (let* ((up2 (dk-lam-b-h! up))
               (up3 (dk-ctx-form (list '<= (list 'abs (list '- (list 'f (list 'phi x)) (list 'g (list 'phi x)))) dPP))))
          (dk-rewrite-h! up3 (list 'phi x) y)
          (ass)))))
  (dk-cite! 'ck-dist-le 's 'f 'g dPP)
  (hq-and! (list 'IN dPP 'RR) (list 'IN dff 'RR))
  (hq-and! (list '<= dPP dff) (list '<= dff dPP))
  (dk-cite! 'rr-leq-antisymmetric dPP dff)
  (ass))
(hq-qed! 'ck-precomp-dist-eq)

;;; =====================================================================
;;; hq-p9.scm -- HAAR-C2 part 9: the left translations of a compact metric group G act on C(G) as affine
;;; isometries of the supremum distance (compact-groups notes, proof of Theorem 1.9).

(define (hq-phia a) (list 'VNB-LAMBDA 'hqx_ hq-Pg (hq-mul a 'hqx_)))
(define (hq-Pa a h) (list 'VNB-LAMBDA 'hix_ hq-Pg (list h (list (hq-phia a) 'hix_))))
(define hq-gcpt (list 'IS-COMPACT hq-Mg))
(define (hq-gcst vars guards body) (hq-gst vars (cons hq-gcpt guards) body))
(define hq-gnvs '(CK-NVS (METRIC-GROUP-MS G)))
(define hq-gM '(NVS-METRIC-SPACE (CK-NVS (METRIC-GROUP-MS G))))
(define (hq-gdst u v) (list (list 'DIST hq-gM) u v))
(define (hq-gset!) (if (not (dk-asm? (list 'IN hq-Pg 'SET))) (dk-cite! 'ms-pts-is-set hq-Mg)))

(sp (make-wff (hq-gst '(a) (list (hq-inPg 'a)) (list 'IN (hq-phia 'a) (list 'FUN hq-Pg hq-Pg)))))
(dk-peel!)
(dk-cite! 'metric-group-ms-is-metric-space 'G)
(hq-gset!)
(dk-lam-type! (lambda () (let ((x (dk-di-var!))) (hq-gmul! 'a x) (ass))))
(hq-qed! 'mg-lmul-fun)

(sp (make-wff (hq-gst '(a) (list (hq-inPg 'a))
   (list 'FORALL 'y (list 'IMPLIES (hq-inPg 'y)
     (list 'FORSOME 'x (list 'AND (hq-inPg 'x) (list '= (list (hq-phia 'a) 'x) 'y))))))))
(dk-peel!)
(dk-cite! 'metric-group-ms-is-metric-space 'G)
(dk-cite! 'mg-inv-in 'G 'a)
(let ((w (hq-mul (hq-inv 'a) 'y)))
  (dk-cite! 'mg-opr-in 'G (hq-inv 'a) 'y)
  (ew w)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (begin
            (hq-gmul! 'a w)
            (dk-lam-b!)
            (dk-cite! 'mg-mul-inv-cancel 'G 'a 'y)
            (ass))))))
(hq-qed! 'mg-lmul-onto)

;;; the precomposite with x |-> a x is the left translate
(sp (make-wff (hq-gst '(a h) (list (hq-inPg 'a) (list 'IN 'h (list 'FUN hq-Pg 'RR)))
   (list '= (hq-Pa 'a 'h) (hq-L 'a 'h)))))
(dk-peel!)
(dk-cite! 'metric-group-ms-is-metric-space 'G)
(hq-gset!)
(dk-cite! 'mg-lmul-fun 'G 'a)
(dk-fun-ext! (hq-Pa 'a 'h) (hq-L 'a 'h) hq-Pg 'RR
  (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!)))
                                        (dk-cite! 'fun-apply-type-c (hq-phia 'a) hq-Pg hq-Pg x)
                                        (dk-cite! 'fun-apply-type-c 'h hq-Pg 'RR (list (hq-phia 'a) x))
                                        (ass)))))
  (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!)))
                                        (hq-gmul! 'a x)
                                        (dk-cite! 'fun-apply-type-c 'h hq-Pg 'RR (hq-mul 'a x))
                                        (ass)))))
  (lambda (x)
    (hq-gmul! 'a x)
    (dk-cite! 'fun-apply-type-c (hq-phia 'a) hq-Pg hq-Pg x)
    (dk-cite! 'fun-apply-type-c 'h hq-Pg 'RR (hq-mul 'a x))
    (if (not (dk-lam-b!)) (rfl))))
(hq-qed! 'mg-ltrans-precomp)

;;; ---- the translations are isometries and preserve convex combinations ----
(define (hq-bridge! a h)               ; land (= (Pa a h) (L a h)) and (IN (Pa a h) C(G))
  (if (not (dk-asm? (list 'IN h (list 'FUN hq-Pg 'RR))))
      (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts hq-Mg h))))
  (let ((e (dk-cite! 'mg-ltrans-precomp 'G a h)))
    (dk-cite! 'mg-ltrans-cont 'G a h)
    (if (not (dk-asm? (hq-inCg (hq-Pa a h))))
        (dk-rewrite-h! (hq-inCg (hq-L a h)) (hq-L a h) (hq-Pa a h)))
    e))
(define (hq-gsetup2!)
  (dk-cite! 'metric-group-ms-is-metric-space 'G)
  (hq-gset!)
  (dk-cite! 'mg-lmul-fun 'G 'a)
  (dk-cite! 'mg-lmul-onto 'G 'a))

(sp (make-wff (hq-gcst '(a f f2) (list (hq-inPg 'a) (hq-inCg 'f) (hq-inCg 'f2))
   (list '= (hq-gdst (hq-L 'a 'f) (hq-L 'a 'f2)) (hq-gdst 'f 'f2)))))
(dk-peel!)
(hq-gsetup2!)
(hq-bridge! 'a 'f)
(hq-bridge! 'a 'f2)
(let ((e (dk-cite! 'ck-precomp-dist-eq hq-Mg (hq-phia 'a) 'f 'f2)))
  (subst (list '= (hq-L 'a 'f) (hq-Pa 'a 'f)))
  (subst (list '= (hq-L 'a 'f2) (hq-Pa 'a 'f2)))
  (ass))
(hq-qed! 'mg-ltrans-dist)

(define (hq-gcomb t u v)
  (list (list 'VADD hq-gnvs) (list (list 'ACT hq-gnvs) (list '- 1 t) u) (list (list 'ACT hq-gnvs) t v)))
(sp (make-wff (hq-gcst '(a u v t) (list (hq-inPg 'a) (hq-inCg 'u) (hq-inCg 'v) '(IN t RR))
   (list '= (hq-L 'a (hq-gcomb 't 'u 'v)) (hq-gcomb 't (hq-L 'a 'u) (hq-L 'a 'v))))))
(dk-peel!)
(hq-gsetup2!)
(dk-real! '(- 1 t))
(dk-cite! 'ck-act-in hq-Mg '(- 1 t) 'u)
(dk-cite! 'ck-act-in hq-Mg 't 'v)
(dk-cite! 'ck-vadd-in hq-Mg (list (list 'ACT hq-gnvs) '(- 1 t) 'u) (list (list 'ACT hq-gnvs) 't 'v))
(hq-bridge! 'a 'u)
(hq-bridge! 'a 'v)
(hq-bridge! 'a (hq-gcomb 't 'u 'v))
(dk-cite! 'ck-precomp-affine hq-Mg (hq-phia 'a) 'u 'v 't)
(subst (list '= (hq-L 'a 'u) (hq-Pa 'a 'u)))
(subst (list '= (hq-L 'a 'v) (hq-Pa 'a 'v)))
(subst (list '= (hq-L 'a (hq-gcomb 't 'u 'v)) (hq-Pa 'a (hq-gcomb 't 'u 'v))))
(ass)
(hq-qed! 'mg-ltrans-affine)

;;; =====================================================================
;;; hq-p10.scm -- HAAR-C2 part 10: for f in C(G), (b, x) |-> f(b x) is continuous on G x G; on a compact G the
;;; orbit map a |-> (x |-> f(a x)) is uniformly continuous into C(G) for the supremum distance.

(define hq-PR '(PRODUCT2-MS (METRIC-GROUP-MS G) (METRIC-GROUP-MS G)))
(define hq-PPR (list 'PTS hq-PR))
(define hq-Cart (list 'CARTESIAN hq-Pg hq-Pg))
(define (hq-H f) (list 'VNB-LAMBDA 'hqz_ hq-Cart (list f (list '(OPR G) '(NTH 1 hqz_) '(NTH 2 hqz_)))))
(define (hq-n1 z) (list 'NTH 1 z))
(define (hq-n2 z) (list 'NTH 2 z))
(define (hq-pr-setup!)
  (dk-cite! 'metric-group-ms-is-metric-space 'G)
  (if (not (dk-asm? '(IS-METRIC-SPACE RR-MS))) (fact 'rr-is-metric-space))
  (hq-ptsrr!)
  (hq-gset!)
  (dk-cite! 'product2-is-metric-space hq-Mg hq-Mg)
  (dk-cite! 'product2-pts hq-Mg hq-Mg))
;;; z in pts(G x G): land z in the cartesian product and its two coordinates in pts
(define (hq-pr-point! z)
  (if (not (dk-asm? (list 'IN z hq-Cart))) (dk-rewrite-h! (list 'IN z hq-PPR) hq-PPR hq-Cart))
  (dk-split-all! (list (dk-cite! 'cartesian-nth z hq-Pg hq-Pg))))
(define (hq-dist-real! u v) (let ((ty (list 'IN (hq-gd u v) 'RR))) (if (not (dk-asm? ty)) (dk-cite! 'metric-dist-real hq-Mg u v)) ty))

(sp (make-wff (hq-gst '(f) (list (hq-inCg 'f)) (list 'IS-CONTINUOUS hq-PR 'RR-MS (hq-H 'f)))))
(dk-peel!)
(hq-pr-setup!)
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts hq-Mg 'f)))
(define hq-fc (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'IS-CONTINUOUS-AT))) "f continuous"))
(dk-set-if! 'cartesian-set-iff hq-Pg hq-Pg)
(dk-have! (list 'IN (hq-H 'f) (list 'FUN hq-Cart 'RR))
  (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!)))
                                        (hq-pr-point! z)
                                        (hq-gmul! (hq-n1 z) (hq-n2 z))
                                        (hq-gapp! 'f (hq-mul (hq-n1 z) (hq-n2 z)))
                                        (ass))))))
(dk-have! (list 'IN (hq-H 'f) (list 'FUN hq-PPR '(PTS RR-MS)))
  (lambda () (subst (list '= hq-PPR hq-Cart)) (subst '(== (PTS RR-MS) RR)) (ass)))
(mac 'is-continuous)
(dk-conj-close!
  (lambda ()
    (if (not (dk-head-is? (dk-goal) 'FORALL))
        (ass)
        (let ((z (dk-di-var!)))
          (hq-pr-point! z)
          (let* ((z1 (hq-n1 z)) (z2 (hq-n2 z)) (p (hq-mul z1 z2)))
            (hq-gmul! z1 z2)
            (hq-gapp! 'f p)
            (dk-apply! hq-fc p)
            (let* ((cc (dk-cite! 'is-continuous-at hq-Mg 'RR-MS 'f p))
                   (cl (caddr (caddr (caddr (caddr (caddr cc)))))))
              (dk-have! cl (lambda () (hq-prop! cc (list 'IS-CONTINUOUS-AT hq-Mg 'RR-MS 'f p))))
              (mac 'is-continuous-at)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-head-is? (dk-goal) 'FORALL))
                      (ass)
                      (let ((e (dk-di-var! (lambda (g) (cadr (cadr g))))))
                        (di)
                        (let* ((eta (dk-skolem! (dk-apply! cl e)))
                               (ecl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f eta) (not (dk-contains? f 'POS-RR)))) "f's delta"))
                               (ml (dk-cite! 'mg-mul-cont 'G z1 z2))
                               (d (dk-skolem! (dk-apply! ml eta)))
                               (dcl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d) (not (dk-contains? f 'POS-RR)))) "the product's delta")))
                          (hq-pos! d)
                          (ew d)
                          (dk-conj-close!
                            (lambda ()
                              (if (not (dk-head-is? (dk-goal) 'FORALL))
                                  (ass)
                                  (let ((w (dk-di-var!)))
                                    (di)
                                    (hq-pr-point! w)
                                    (let* ((w1 (hq-n1 w)) (w2 (hq-n2 w)) (q (hq-mul w1 w2))
                                           (r1 (hq-dist-real! z1 w1)) (r2 (hq-dist-real! z2 w2))
                                           (mx (list 'max (hq-gd z1 w1) (hq-gd z2 w2)))
                                           (pd (dk-cite! 'product2-dist hq-Mg hq-Mg z w))
                                           (hz (dk-ctx-form (list '<= (list (list 'DIST hq-PR) z w) d))))
                                      (dk-rewrite-h! hz (list (list 'DIST hq-PR) z w) mx)
                                      (dk-cite! 'rr-max-closed (hq-gd z1 w1) (hq-gd z2 w2))
                                      (dk-cite! 'rr-le-max-left (hq-gd z1 w1) (hq-gd z2 w2))
                                      (dk-cite! 'rr-le-max-right (hq-gd z1 w1) (hq-gd z2 w2))
                                      (dk-have! (list '<= (hq-gd z1 w1) d)
                                        (lambda () (dk-ineq! (list '<= (hq-gd z1 w1) mx) (list '<= mx d) r1 (list 'IN mx 'RR) (list 'IN d 'RR))))
