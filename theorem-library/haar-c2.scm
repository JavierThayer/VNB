;;; =====================================================================
;;; hq-p12.scm -- HAAR-C2 part 12: a subset kk of a metric space s that is totally bounded in s (finite nets of
;;; points of s) is totally bounded as a space (nets of its own points); closed in a complete s, it is compact.

(define (hq-ms-d u v) (list '(DIST s) u v))
(define hq-sub '(SUBSPACE-MS s kk))

(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (FORALL kk (IMPLIES (SUBSET kk (PTS s))
                 (IMPLIES (IS-TOTALLY-BOUNDED-IN s kk) (TOTALLY-BOUNDED (SUBSPACE-MS s kk)))))))))
(dk-peel!)
(dk-cite! 'ms-pts-is-set 's)
(dk-cite! 'subclass-of-set-is-set 'kk '(PTS s))
(dk-cite! 'subspace-is-metric-space 's 'kk)
(dk-cite! 'subspace-pts 's 'kk)
(define hq-tbc (let ((iff (dk-cite! 'is-totally-bounded-in 's 'kk))) (dk-meta-iff-r! iff) (caddr iff)))
(mac 'totally-bounded)
(dk-conj-close!
  (lambda ()
    (if (not (dk-head-is? (dk-goal) 'FORALL))
        (ass)
        (let* ((ld (dk-peel!))
               (cj (find-first (lambda (h) (dk-head-is? h 'AND)) ld))
               (_0 (dk-split-all! (list cj)))
               (r (cadr (cadr cj))))
          (dk-have! (list 'POS-RR r) (lambda () (mac 'pos-rr) (dk-conj-close! (lambda () (ass)))))
          (let* ((h0 (dk-halve! r))
                 (_1 (dk-cite! 'rr-pos-rr-of-lt h0))
                 (F0 (dk-skolem! (dk-apply! hq-tbc h0)))
                 (nc (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x F0) (dk-contains? x 'FORSOME))) "the net clause"))
                 (S (lambda (c) (list 'SEP 'hqp_ 'kk (list '< (hq-ms-d c 'hqp_) h0))))
                 (f (list 'SEP 'hqq_ 'kk (list 'FORSOME 'hqc_ (list 'AND (list 'IN 'hqc_ F0) (list '= 'hqq_ (list 'CHOICE (S 'hqc_)))))))
                 (g (list 'VNB-LAMBDA 'hqc_ F0 (list 'CHOICE (S 'hqc_))))
                 (Xim (list 'IMAGE g F0)))
            (dk-cite! 'subclass-of-set-is-set F0 '(PTS s))
            ;; f is a subset of kk, hence a set
            (dk-have! (list 'SUBSET f 'kk)
              (lambda ()
                (mac 'subset-def)
                (let ((z (dk-di-var!)))
                  (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN z f)))))
                  (ass))))
            (dk-cite! 'subclass-of-set-is-set f 'kk)
            ;; f is finite: it lies in the image of the finite net
            (dk-cite! 'image-set g F0)
            (dk-cite! 'card-image-finite g F0)
            (hq-and! (list 'IN Xim 'SET) (list 'IN (list 'CARD Xim) 'NN))
            (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z f) (list 'IN 'z Xim)))
              (lambda ()
                (let ((z (dk-di-var!)))
                  (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN z f)))))
                  (let* ((c (dk-skolem! (dk-pick (lambda (x) (and (dk-head-is? x 'FORSOME) (dk-contains? x z))) "the index")))
                         (iff (dk-cite! 'image-membership-iff g F0 z))
                         (rhs (caddr iff)))
                    (dk-cite! 'membership-implies-sethood z 'kk)
                    (dk-have! rhs
                      (lambda ()
                        (dk-conj-close!
                          (lambda ()
                            (if (dk-asm? (dk-goal))
                                (ass)
                                (begin
                                  (ew c)
                                  (dk-conj-close!
                                    (lambda ()
                                      (if (dk-asm? (dk-goal))
                                          (ass)
                                          (begin
                                            (dk-lam-b!)
                                            (subst (list '= (list 'CHOICE (S c)) z))
                                            (rfl)))))))))))
                    (hq-prop! iff rhs)))))
            (hq-and! (list 'IN f 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z f) (list 'IN 'z Xim))))
            (dk-cite! 'card-subset-nn Xim f)
            (ew f)
            (dk-conj-close!
              (lambda ()
                (cond
                  ((dk-asm? (dk-goal)) (ass))
                  ((dk-head-is? (dk-goal) 'IS-R-NET)
                   (mac 'is-r-net)
                   (dk-conj-close!
                     (lambda ()
                       (if (not (dk-head-is? (dk-goal) 'FORALL))
                           (begin (subst (list '= (list 'PTS hq-sub) 'kk)) (ass))
                           (let ((p (dk-di-var!)))
                             (dk-rewrite-h! (list 'IN p (list 'PTS hq-sub)) (list 'PTS hq-sub) 'kk)
                             (let* ((c (dk-skolem! (dk-apply! nc p)))
                                    (q (list 'CHOICE (S c))))
                               (dk-have! (list 'FORSOME 'hqw_ (list 'IN 'hqw_ (S c)))
                                 (lambda () (ew p) (in-sep! (lambda () (ass)) (lambda () (ass)))))
                               (dk-cite! 'choice-axiom (S c))
                               (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN q (S c))))))
                               (dk-cite! 'subset-mem-fwd F0 '(PTS s) c)
                               (dk-cite! 'subset-mem-fwd 'kk '(PTS s) q)
                               (dk-cite! 'subset-mem-fwd 'kk '(PTS s) p)
                               (dk-cite! 'subspace-dist 's 'kk q p)
                               (dk-cite! 'metric-triangle 's q c p)
                               (dk-cite! 'metric-sym 's q c)
                               (for-each (lambda (pr) (dk-cite! 'metric-dist-real 's (car pr) (cadr pr)))
                                         (list (list q p) (list q c) (list c q) (list c p)))
                               (let ((dqp (hq-ms-d q p)))
                                 (dk-have! (list '< dqp r)
                                   (lambda () (dk-ineq! (list '<= dqp (list '+ (hq-ms-d q c) (hq-ms-d c p)))
                                                        (list '= (hq-ms-d q c) (hq-ms-d c q))
                                                        (list '< (hq-ms-d c q) h0) (list '< (hq-ms-d c p) h0)
                                                        (list '= (list '+ h0 h0) r)
                                                        (list 'IN dqp 'RR) (list 'IN (hq-ms-d q c) 'RR) (list 'IN (hq-ms-d c q) 'RR)
                                                        (list 'IN (hq-ms-d c p) 'RR) (list 'IN h0 'RR) (list 'IN r 'RR))))
                                 (ew q)
                                 (subst (list '= (list (list 'DIST hq-sub) q p) dqp))
                                 (dk-conj-close!
                                   (lambda ()
                                     (cond
                                       ((dk-asm? (dk-goal)) (ass))
                                       ((dk-head-is? (dk-goal) 'IN)
                                        (in-sep! (lambda () (ass))
                                                 (lambda () (ew c) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))))))
                                       ((dk-head-is? (dk-goal) 'NOT)
                                        (di)
                                        (dk-absurd! (list '< dqp r) (list '= dqp r) (list 'IN dqp 'RR) (list 'IN r 'RR)))
                                       (#t (dk-ineq! (list '< dqp r) (list 'IN dqp 'RR) (list 'IN r 'RR)))))))))))))
                  (#t (ass))))))))))
(hq-qed! 'ms-tb-in-subspace-tb)

(sp (make-wff '(FORALL s (IMPLIES (IS-COMPLETE s) (FORALL kk (IMPLIES (SUBSET kk (PTS s)) (IMPLIES (IS-CLOSED s kk)
                 (IMPLIES (IS-TOTALLY-BOUNDED-IN s kk) (IS-COMPACT (SUBSPACE-MS s kk))))))))))
(dk-peel!)
(dk-have! '(IS-METRIC-SPACE s) (lambda () (hq-prop! (dk-cite! 'is-complete 's) '(IS-COMPLETE s))))
(dk-cite! 'ms-tb-in-subspace-tb 's 'kk)
(dk-cite! 'subspace-complete 's 'kk)
(dk-cite! 'subspace-is-metric-space 's 'kk)
(let ((iff (dk-cite! 'compact-iff-tb-complete '(SUBSPACE-MS s kk))))
  (hq-prop! iff '(TOTALLY-BOUNDED (SUBSPACE-MS s kk)) '(IS-COMPLETE (SUBSPACE-MS s kk))))
(hq-qed! 'ms-closed-tb-in-compact)

;;; =====================================================================
;;; hq-p13.scm -- HAAR-C2 part 13: the metric closure by distances (a point of the closure has points of the set
;;; at every distance r > 0, and conversely); in a normed space the closure of a convex set is convex and the
;;; closure of a totally bounded set is totally bounded.

(define (hq-sd u v) (list '(DIST s) u v))
(define (hq-iff-rhs! iff) (dk-meta-iff-r! iff) (caddr iff))

(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (FORALL a (FORALL x (IMPLIES (IN x (CLOSURE s a))
   (FORALL r (IMPLIES (POS-RR r) (FORSOME y (AND (IN y a) (<= ((DIST s) x y) r))))))))))))
(dk-peel!)
(define hq-x (cadr (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (dk-contains? h 'CLOSURE))) "x")))
(define hq-r (cadr (dk-pick (lambda (h) (dk-head-is? h 'POS-RR)) "r")))
(let* ((rhs (hq-iff-rhs! (dk-cite! 'closure-membership 's 'a hq-x)))
       (_ (dk-split-all! (list rhs)))
       (cl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'IS-OPEN))) "the closure clause"))
       (_2 (hq-iff-rhs! (dk-cite! 'pos-rr hq-r)))
       (B (list 'BALL 's hq-x hq-r)))
  (dk-cite! 'ball-is-open 's hq-x hq-r)
  (dk-cite! 'ball-center-in 's hq-x hq-r)
  (hq-and! (list 'IS-OPEN 's B) (list 'IN hq-x B))
  (let* ((y (dk-skolem! (dk-apply! cl B))))
    (dk-split-all! (list (hq-iff-rhs! (dk-cite! 'ball-membership 's hq-x hq-r y))))
    (ew y)
    (dk-conj-close! (lambda () (ass)))))
(hq-qed! 'ms-closure-near)

(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (FORALL a (IMPLIES (SUBSET a (PTS s)) (FORALL x (IMPLIES (IN x (PTS s))
   (IMPLIES (FORALL r (IMPLIES (POS-RR r) (FORSOME y (AND (IN y a) (<= ((DIST s) x y) r)))))
     (IN x (CLOSURE s a)))))))))))
(dk-peel!)
(define hq-near (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'POS-RR))) "the near clause"))
(let* ((iff (dk-cite! 'closure-membership 's 'a 'x)) (rhs (caddr iff)))
  (dk-have! rhs
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (not (dk-head-is? (dk-goal) 'FORALL))
              (ass)
              (let* ((ld (dk-peel!))
                     (cj (find-first (lambda (h) (dk-head-is? h 'AND)) ld))
                     (_ (dk-split-all! (list cj)))
                     (u (caddr (cadr cj)))
                     (orhs (hq-iff-rhs! (dk-cite! 'is-open 's u)))
                     (_1 (dk-split-all! (list orhs)))
                     (ocl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'BALL))) "the open clause"))
                     (r (dk-skolem! (dk-apply! ocl 'x)))
                     (h0 (dk-halve! r))
                     (_2 (dk-cite! 'rr-pos-rr-of-lt h0))
                     (y (dk-skolem! (dk-apply! hq-near h0))))
                (dk-cite! 'subset-mem-fwd 'a '(PTS s) y)
                (dk-cite! 'metric-dist-real 's 'x y)
                (hq-pos! r)
                (let* ((B (list 'BALL 's 'x r))
                       (biff (dk-cite! 'ball-membership 's 'x r y))
                       (brhs (caddr biff))
                       (dxy (hq-sd 'x y)))
                  (dk-have! brhs
                    (lambda ()
                      (dk-conj-close!
                        (lambda ()
                          (cond ((dk-asm? (dk-goal)) (ass))
                                ((dk-head-is? (dk-goal) 'NOT)
                                 (di)
                                 (dk-absurd! (list '<= dxy h0) (list '= dxy r) (list '= (list '+ h0 h0) r) (list '< 0 h0)
                                             (list 'IN dxy 'RR) (list 'IN h0 'RR) (list 'IN r 'RR)))
                                (#t (dk-ineq! (list '<= dxy h0) (list '= (list '+ h0 h0) r) (list '< 0 h0)
                                              (list 'IN dxy 'RR) (list 'IN h0 'RR) (list 'IN r 'RR))))))))
                  (dk-have! (list 'IN y B) (lambda () (hq-prop! biff brhs)))
                  (dk-cite! 'subset-mem-fwd B u y)
                  (ew y)
                  (dk-conj-close! (lambda () (ass))))))))))
  (hq-prop! iff rhs))
(hq-qed! 'ms-closure-intro)

;;; ---- the closure of a convex set is convex ----
(define hq-nm '(NVS-METRIC-SPACE m))
(define (hq-nd u v) (list (list 'DIST hq-nm) u v))
(define (hq-comb t u v) (list '(VADD m) (list '(ACT m) (list '- 1 t) u) (list '(ACT m) t v)))
(define (hq-nvs-setup!)
  (dk-cite! 'nvs-metric-is-ms 'm)
  (dk-cite! 'nvs-ms-pts 'm))
(define (hq-mvec! v)            ; v in VEC(m) from v in PTS(M), or the converse
  (let ((t1 (list 'IN v '(VEC m))) (t2 (list 'IN v (list 'PTS hq-nm))))
    (cond ((and (dk-asm? t1) (not (dk-asm? t2))) (dk-rewrite-h! t1 '(VEC m) (list 'PTS hq-nm)))
          ((and (dk-asm? t2) (not (dk-asm? t1))) (dk-rewrite-h! t2 (list 'PTS hq-nm) '(VEC m))))))
(define (hq-comb-vec! t u v)
  (dk-real! (list '- 1 t))
  (dk-cite! 'nvs-act-in-vec 'm (list '- 1 t) u)
  (dk-cite! 'nvs-act-in-vec 'm t v)
  (dk-cite! 'nvs-vadd-in-vec 'm (list '(ACT m) (list '- 1 t) u) (list '(ACT m) t v))
  (hq-mvec! (hq-comb t u v)))
;;; c * d <= d for 0 <= c <= 1 and 0 <= d
(define (hq-scale-le! c d)
  (let ((goal (list '<= (list '* c d) d)))
    (dk-have! goal
      (lambda ()
        (dk-cite! 'rr-one-in)
        (dk-cite! 'rr-mul-le-right c 1 d)
        (dk-have! (list '= (list '* 1 d) d) (lambda () (crs)))
        (dk-rewrite-h! (list '<= (list '* c d) (list '* 1 d)) (list '* 1 d) d)
        (ass)))
    goal))

(sp (make-wff '(FORALL m (IMPLIES (IS-NORMED-VECTOR-SPACE m) (FORALL cs (IMPLIES (SUBSET cs (VEC m)) (IMPLIES (IS-CONVEX-SUBSET m cs)
   (IS-CONVEX-SUBSET m (CLOSURE (NVS-METRIC-SPACE m) cs)))))))))
(dk-peel!)
(hq-nvs-setup!)
(define hq-cvx (let ((rhs (hq-iff-rhs! (dk-cite! 'is-convex-subset 'm 'cs)))) (dk-split-all! (list rhs))
                 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'ACT))) "convexity of cs")))
(dk-have! (list 'SUBSET 'cs (list 'PTS hq-nm)) (lambda () (subst (list '= (list 'PTS hq-nm) '(VEC m))) (ass)))
(define hq-CL (list 'CLOSURE hq-nm 'cs))
(dk-cite! 'closure-in-carrier hq-nm 'cs)
(mac 'is-convex-subset)
(dk-conj-close!
  (lambda ()
    (if (not (dk-head-is? (dk-goal) 'FORALL))
        (begin (subst (list '= '(VEC m) (list 'PTS hq-nm))) (ass))
        (let* ((ld (dk-peel!))
               (ins (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) hq-CL))) ld))
               (u (cadr (car ins))) (v (cadr (cadr ins)))
               (t (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld)))
               (z (hq-comb t u v)))
          (dk-cite! 'subset-mem-fwd hq-CL (list 'PTS hq-nm) u)
          (dk-cite! 'subset-mem-fwd hq-CL (list 'PTS hq-nm) v)
          (hq-mvec! u) (hq-mvec! v)
          (hq-comb-vec! t u v)
          (dk-have! (list 'FORALL 'r (list 'IMPLIES '(POS-RR r) (list 'FORSOME 'y (list 'AND '(IN y cs) (list '<= (list (list 'DIST hq-nm) z 'y) 'r)))))
            (lambda ()
              (let* ((r (dk-di-var! (lambda (g) (cadr (cadr g)))))
                     (_ (di))
                     (_p (hq-pos! r))
                     (h0 (dk-halve! r))
                     (_1 (dk-cite! 'rr-pos-rr-of-lt h0))
                     (u1 (dk-skolem! (dk-apply! (dk-cite! 'ms-closure-near hq-nm 'cs u) h0)))
                     (v1 (dk-skolem! (dk-apply! (dk-cite! 'ms-closure-near hq-nm 'cs v) h0))))
                (dk-cite! 'subset-mem-fwd 'cs '(VEC m) u1)
                (dk-cite! 'subset-mem-fwd 'cs '(VEC m) v1)
                (hq-mvec! u1) (hq-mvec! v1)
                (let* ((w (hq-comb t u1 v))
                       (z1 (hq-comb t u1 v1))
                       (_c (dk-apply! hq-cvx u1 v1 t))
                       (_w (hq-comb-vec! t u1 v))
                       (_z (hq-comb-vec! t u1 v1))
                       (e1 (dk-cite! 'convex-combination-dist-point 'm u u1 v t))
                       (e2 (dk-cite! 'convex-combination-dist-second-point 'm u1 v v1 t))
                       (tri (dk-cite! 'metric-triangle hq-nm z w z1))
                       (d1 (hq-nd u1 u)) (d2 (hq-nd v1 v))
                       (a1 (list 'abs (list '- 1 t))) (a2 (list 'abs t)))
                  (for-each (lambda (pr) (dk-cite! 'metric-dist-real hq-nm (car pr) (cadr pr)))
                            (list (list z w) (list w z1) (list z z1) (list u1 u) (list v1 v) (list u u1) (list v v1)))
                  (dk-cite! 'metric-pos hq-nm u1 u)
                  (dk-cite! 'metric-pos hq-nm v1 v)
                  (dk-cite! 'metric-sym hq-nm u1 u)
                  (dk-cite! 'metric-sym hq-nm v1 v)
                  (dk-have! (list '<= 0 (list '- 1 t)) (lambda () (dk-ineq! (list '<= t 1) (list 'IN t 'RR))))
                  (dk-cite! 'rr-abs-of-nonneg (list '- 1 t))
                  (dk-cite! 'rr-abs-of-nonneg t)
                  (dk-cite! 'rr-abs-closed (list '- 1 t))
                  (dk-cite! 'rr-abs-closed t)
                  (dk-have! (list '<= a1 1) (lambda () (subst (list '= a1 (list '- 1 t))) (dk-ineq! (list '<= 0 t) (list 'IN t 'RR))))
                  (dk-have! (list '<= a2 1) (lambda () (subst (list '= a2 t)) (dk-ineq! (list '<= t 1) (list 'IN t 'RR))))
                  (dk-have! (list '<= 0 a1) (lambda () (subst (list '= a1 (list '- 1 t))) (ass)))
                  (dk-have! (list '<= 0 a2) (lambda () (subst (list '= a2 t)) (ass)))
                  (hq-scale-le! a1 d1)
                  (hq-scale-le! a2 d2)
                  (hq-and! (list 'IN a1 'RR) (list 'IN d1 'RR))
                  (dk-cite! 'rr-mul-closed a1 d1)
                  (hq-and! (list 'IN a2 'RR) (list 'IN d2 'RR))
                  (dk-cite! 'rr-mul-closed a2 d2)
                  (ew z1)
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-asm? (dk-goal))
                          (ass)
                          (dk-ineq! tri e1 e2 (list '<= (list '* a1 d1) d1) (list '<= (list '* a2 d2) d2)
                                    (list '= d1 (hq-nd u u1)) (list '= d2 (hq-nd v v1))
                                    (list '<= (hq-nd u u1) h0) (list '<= (hq-nd v v1) h0) (list '= (list '+ h0 h0) r)
                                    (list 'IN (hq-nd z w) 'RR) (list 'IN (hq-nd w z1) 'RR) (list 'IN (hq-nd z z1) 'RR)
                                    (list 'IN d1 'RR) (list 'IN d2 'RR) (list 'IN (hq-nd u u1) 'RR) (list 'IN (hq-nd v v1) 'RR)
                                    (list 'IN (list '* a1 d1) 'RR) (list 'IN (list '* a2 d2) 'RR)
                                    (list 'IN h0 'RR) (list 'IN r 'RR)))))))))
          (dk-cite! 'ms-closure-intro hq-nm 'cs z)
          (ass)))))
(hq-qed! 'nvs-closure-convex)

;;; ---- the closure of a totally bounded set is totally bounded ----
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (FORALL a (IMPLIES (SUBSET a (PTS s)) (IMPLIES (IS-TOTALLY-BOUNDED-IN s a)
   (IS-TOTALLY-BOUNDED-IN s (CLOSURE s a)))))))))
(dk-peel!)
(define hq-tba (hq-iff-rhs! (dk-cite! 'is-totally-bounded-in 's 'a)))
(dk-cite! 'closure-in-carrier 's 'a)
(mac 'is-totally-bounded-in)
(let* ((r (dk-di-var! (lambda (g) (cadr (cadr g)))))
       (_ (di))
       (_p (hq-pos! r))
       (h0 (dk-halve! r))
       (_1 (dk-cite! 'rr-pos-rr-of-lt h0))
       (F0 (dk-skolem! (dk-apply! hq-tba h0)))
       (nc (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x F0) (dk-contains? x 'FORSOME))) "the net clause")))
  (ew F0)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-head-is? (dk-goal) 'FORALL))
          (ass)
          (let* ((p (dk-di-var!))
                 (y (dk-skolem! (dk-apply! (dk-cite! 'ms-closure-near 's 'a p) h0)))
                 (c (dk-skolem! (dk-apply! nc y))))
            (dk-cite! 'subset-mem-fwd F0 '(PTS s) c)
            (dk-cite! 'subset-mem-fwd 'a '(PTS s) y)
            (dk-cite! 'subset-mem-fwd (list 'CLOSURE 's 'a) '(PTS s) p)
            (dk-cite! 'metric-triangle 's c y p)
            (dk-cite! 'metric-sym 's p y)
            (for-each (lambda (pr) (dk-cite! 'metric-dist-real 's (car pr) (cadr pr)))
                      (list (list c p) (list c y) (list y p) (list p y)))
            (ew c)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal))
                    (ass)
                    (dk-ineq! (list '<= (hq-sd c p) (list '+ (hq-sd c y) (hq-sd y p)))
                              (list '= (hq-sd p y) (hq-sd y p))
                              (list '< (hq-sd c y) h0) (list '<= (hq-sd p y) h0) (list '= (list '+ h0 h0) r) (list '< 0 h0)
                              (list 'IN (hq-sd c p) 'RR) (list 'IN (hq-sd c y) 'RR) (list 'IN (hq-sd y p) 'RR)
                              (list 'IN (hq-sd p y) 'RR) (list 'IN h0 'RR) (list 'IN r 'RR))))))))))
(hq-qed! 'ms-closure-tb)

;;; =====================================================================
;;; hq-p14.scm -- HAAR-C2 part 14: the closed convex hull K(f) of the orbit of f in C(G) -- the closure, for the
;;; supremum distance, of the convex hull of {x |-> f(a x) : a in G} -- is a nonempty compact convex set of
;;; vectors of C(G) (compact-groups notes, proof of Theorem 1.9, with Theorem 1.12).

(define (hq-hull f) (list 'CONV-HULL hq-gnvs (hq-orb f)))
(define (hq-K f) (list 'CLOSURE hq-gM (hq-hull f)))
(define hq-gV (list 'VEC hq-gnvs))
(define (hq-hull-setup! f)
  (hq-gnsetup!)
  (dk-cite! 'mg-orbit-sub-vec 'G f)
  (dk-cite! 'conv-hull-sub-vec hq-gnvs (hq-orb f))
  (dk-have! (list 'SUBSET (hq-hull f) hq-gPM) (lambda () (subst (list '= hq-gPM hq-gV)) (ass)))
  (dk-cite! 'closure-in-carrier hq-gM (hq-hull f)))

(sp (make-wff (hq-gcst '(f) (list (hq-inCg 'f)) (list 'SUBSET (hq-K 'f) hq-gV))))
(dk-peel!)
(hq-hull-setup! 'f)
(subst (list '= hq-gV hq-gPM))
(ass)
(hq-qed! 'mg-hull-sub-vec)

(sp (make-wff (hq-gcst '(f) (list (hq-inCg 'f)) (list 'IS-CONVEX-SUBSET hq-gnvs (hq-K 'f)))))
(dk-peel!)
(hq-hull-setup! 'f)
(dk-cite! 'conv-hull-convex hq-gnvs (hq-orb 'f))
(dk-cite! 'nvs-closure-convex hq-gnvs (hq-hull 'f))
(ass)
(hq-qed! 'mg-hull-convex)

(sp (make-wff (hq-gcst '(f) (list (hq-inCg 'f)) (list 'IS-COMPACT (list 'SUBSPACE-MS hq-gM (hq-K 'f))))))
(dk-peel!)
(hq-hull-setup! 'f)
(dk-cite! 'ck-nvs-complete hq-Mg)
(dk-cite! 'mg-orbit-tb 'G 'f)
(dk-cite! 'conv-hull-totally-bounded hq-gnvs (hq-orb 'f))
(dk-cite! 'ms-closure-tb hq-gM (hq-hull 'f))
(dk-cite! 'closure-is-closed hq-gM (hq-hull 'f))
(dk-cite! 'ms-closed-tb-in-compact hq-gM (hq-K 'f))
(ass)
(hq-qed! 'mg-hull-compact)

;;; every translate of f lies in K(f)
(sp (make-wff (hq-gcst '(f a) (list (hq-inCg 'f) (hq-inPg 'a)) (list 'IN (hq-L 'a 'f) (hq-K 'f)))))
(dk-peel!)
(hq-hull-setup! 'f)
(dk-cite! 'mg-orbit-map-fun 'G 'f)
(dk-cite! 'mg-ltrans-cont 'G 'a 'f)
(hq-gvec! (hq-L 'a 'f))
(let* ((O (hq-orb 'f)) (w (hq-L 'a 'f))
       (iff (dk-cite! 'image-membership-iff (hq-Phi 'f) hq-Pg w))
       (rhs (caddr iff)))
  (dk-cite! 'membership-implies-sethood w hq-gPM)
  (dk-have! rhs
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (begin
                (ew 'a)
                (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (if (not (dk-lam-b!)) (rfl)))))))))))
  (dk-have! (list 'IN w O) (lambda () (hq-prop! iff rhs)))
  (dk-cite! 'conv-hull-contains hq-gnvs O)
  (dk-cite! 'subset-mem-fwd O (hq-hull 'f) w)
  (dk-cite! 'closure-contains hq-gM (hq-hull 'f))
  (dk-cite! 'subset-mem-fwd (hq-hull 'f) (hq-K 'f) w)
  (ass))
(hq-qed! 'mg-hull-has-translates)

(sp (make-wff (hq-gcst '(f) (list (hq-inCg 'f)) (list 'FORSOME 'hqk_ (list 'IN 'hqk_ (hq-K 'f))))))
(dk-peel!)
(dk-cite! 'mg-iden-in 'G)
(dk-cite! 'mg-hull-has-translates 'G 'f '(IDEN G))
(ew (hq-L '(IDEN G) 'f))
(ass)
(hq-qed! 'mg-hull-nonempty)

;;; =====================================================================
;;; hq-p15.scm -- HAAR-C2 part 15: the left translations map the orbit of f, its convex hull, and the closed
;;; convex hull K(f) into themselves (compact-groups notes, proof of Theorem 1.9).

(define (hq-Lfun! a h)                 ; (IN (L a h) (FUN Pg RR)) from (IN h (FUN Pg RR)), a in Pg
  (let ((ty (list 'IN (hq-L a h) (list 'FUN hq-Pg 'RR))))
    (if (not (dk-asm? ty))
        (begin
          (hq-gset!)
          (dk-have! ty (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!)))
                                                              (hq-gmul! a x)
                                                              (dk-cite! 'fun-apply-type-c h hq-Pg 'RR (hq-mul a x))
                                                              (ass))))))))
    ty))
(define (hq-toC! v)                    ; (IN v C(G)) from (IN v VEC)
  (if (not (dk-asm? (hq-inCg v))) (dk-rewrite-h! (list 'IN v hq-gV) hq-gV hq-Cg)))

;;; L_a o L_b = L_(b a)
(sp (make-wff (hq-gst '(a b h) (list (hq-inPg 'a) (hq-inPg 'b) (list 'IN 'h (list 'FUN hq-Pg 'RR)))
   (list '= (hq-L 'a (hq-L 'b 'h)) (hq-L (hq-mul 'b 'a) 'h)))))
(dk-peel!)
(dk-cite! 'metric-group-ms-is-metric-space 'G)
(hq-gset!)
(hq-gmul! 'b 'a)
(hq-Lfun! 'b 'h)
(hq-Lfun! (hq-mul 'b 'a) 'h)
(hq-Lfun! 'a (hq-L 'b 'h))
(dk-fun-ext! (hq-L 'a (hq-L 'b 'h)) (hq-L (hq-mul 'b 'a) 'h) hq-Pg 'RR #f #f
  (lambda (x)
    (hq-gmul! 'a x)
    (hq-gmul! 'b (hq-mul 'a x))
    (hq-gmul! (hq-mul 'b 'a) x)
    (dk-cite! 'fun-apply-type-c 'h hq-Pg 'RR (hq-mul 'b (hq-mul 'a x)))
    (dk-cite! 'fun-apply-type-c 'h hq-Pg 'RR (hq-mul (hq-mul 'b 'a) x))
    (dk-cite! 'fun-apply-type-c (hq-L 'b 'h) hq-Pg 'RR (hq-mul 'a x))
    (dk-cite! 'mg-assoc 'G 'b 'a x)
    (let ((leaf (proof-state-focus *ps*)))
      (dk-lam-b!)
      (if (not (sequent-node-grounded? leaf))
          (begin (subst (list '= (hq-mul (hq-mul 'b 'a) x) (hq-mul 'b (hq-mul 'a x)))) (rfl))))))
(hq-qed! 'mg-ltrans-comp)

;;; every translate of f is in its orbit
(sp (make-wff (hq-gcst '(f a) (list (hq-inCg 'f) (hq-inPg 'a)) (list 'IN (hq-L 'a 'f) (hq-orb 'f)))))
(dk-peel!)
(hq-gnsetup!)
(dk-cite! 'mg-orbit-map-fun 'G 'f)
(dk-cite! 'mg-ltrans-cont 'G 'a 'f)
(hq-gvec! (hq-L 'a 'f))
(let* ((w (hq-L 'a 'f))
       (iff (dk-cite! 'image-membership-iff (hq-Phi 'f) hq-Pg w))
       (rhs (caddr iff)))
  (dk-cite! 'membership-implies-sethood w hq-gPM)
  (dk-have! rhs
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (begin
                (ew 'a)
                (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (if (not (dk-lam-b!)) (rfl)))))))))))
  (hq-prop! iff rhs))
(hq-qed! 'mg-orbit-mem)

;;; the orbit is invariant
(sp (make-wff (hq-gcst '(f a w) (list (hq-inCg 'f) (hq-inPg 'a) (list 'IN 'w (hq-orb 'f))) (list 'IN (hq-L 'a 'w) (hq-orb 'f)))))
(dk-peel!)
(hq-gnsetup!)
(dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'image-membership-iff (hq-Phi 'f) hq-Pg 'w))))
(let* ((b (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'hqa_))) "the index")))
       (eq0 (dk-ctx-form (list '= (list (hq-Phi 'f) b) 'w))))
  (dk-lam-b-h! eq0)
  (subst (list '= 'w (hq-L b 'f)))
  (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts hq-Mg 'f)))
  (dk-cite! 'mg-ltrans-comp 'G 'a b 'f)
  (subst (list '= (hq-L 'a (hq-L b 'f)) (hq-L (hq-mul b 'a) 'f)))
  (hq-gmul! b 'a)
  (dk-cite! 'mg-orbit-mem 'G 'f (hq-mul b 'a))
  (ass))
(hq-qed! 'mg-ltrans-orbit)

;;; the convex hull of the orbit is invariant
(define (hq-gcomb-vec! t u v)
  (dk-real! (list '- 1 t))
  (dk-cite! 'nvs-act-in-vec hq-gnvs (list '- 1 t) u)
  (dk-cite! 'nvs-act-in-vec hq-gnvs t v)
  (dk-cite! 'nvs-vadd-in-vec hq-gnvs (list (list 'ACT hq-gnvs) (list '- 1 t) u) (list (list 'ACT hq-gnvs) t v)))
(sp (make-wff (hq-gcst '(f a w) (list (hq-inCg 'f) (hq-inPg 'a) (list 'IN 'w (hq-hull 'f))) (list 'IN (hq-L 'a 'w) (hq-hull 'f)))))
(dk-peel!)
(hq-hull-setup! 'f)
(dk-cite! 'vec-is-set hq-gnvs)
(define hq-cvh
  (begin
    (dk-cite! 'conv-hull-convex hq-gnvs (hq-orb 'f))
    (let* ((iff (dk-cite! 'is-convex-subset hq-gnvs (hq-hull 'f)))
           (rhs (caddr iff)))
      (dk-meta-iff-r! iff)
      (dk-split-all! (list rhs))
      (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'ACT) (dk-contains? h 'CONV-HULL))) "hull convexity"))))
(define hq-Pre (list 'SEP 'hqv_ hq-gV (list 'IN (hq-L 'a 'hqv_) (hq-hull 'f))))
;; the orbit lies in the preimage
(dk-have! (list 'SUBSET (hq-orb 'f) hq-Pre)
  (lambda ()
    (mac 'subset-def)
    (let ((z (dk-di-var!)))
      (dk-cite! 'subset-mem-fwd (hq-orb 'f) hq-gV z)
      (dk-cite! 'mg-ltrans-orbit 'G 'f 'a z)
      (dk-cite! 'conv-hull-contains hq-gnvs (hq-orb 'f))
      (dk-cite! 'subset-mem-fwd (hq-orb 'f) (hq-hull 'f) (hq-L 'a z))
      (in-sep! (lambda () (ass)) (lambda () (ass))))))
;; the preimage is convex
(dk-have! (list 'IS-CONVEX-SUBSET hq-gnvs hq-Pre)
  (lambda ()
    (mac 'is-convex-subset)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-head-is? (dk-goal) 'FORALL))
            (begin (mac 'subset-def)
                   (let ((z (dk-di-var!)))
                     (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN z hq-Pre)))))
                     (ass)))
            (let* ((ld (dk-peel!))
                   (ins (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) hq-Pre))) ld))
                   (u (cadr (car ins))) (v (cadr (cadr ins)))
                   (t (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld))))
              (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN u hq-Pre)))))
              (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN v hq-Pre)))))
              (hq-gcomb-vec! t u v)
              (hq-toC! u) (hq-toC! v)
              (in-sep! (lambda () (ass))
                       (lambda ()
                         (dk-cite! 'mg-ltrans-affine 'G 'a u v t)
                         (subst (list '= (hq-L 'a (hq-gcomb t u v)) (hq-gcomb t (hq-L 'a u) (hq-L 'a v))))
                         (dk-apply! hq-cvh (hq-L 'a u) (hq-L 'a v) t)
                         (ass)))))))))
(dk-have! (list 'SUBSET hq-Pre hq-gV)
  (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN z hq-Pre))))) (ass))))
(dk-cite! 'conv-hull-least hq-gnvs (hq-orb 'f) hq-Pre)
(dk-cite! 'subset-mem-fwd (hq-hull 'f) hq-Pre 'w)
(dk-split-all! (dk-landed (lambda () (sep-me (list 'IN 'w hq-Pre)))))
(ass)
(hq-qed! 'mg-ltrans-hull)

;;; the closed convex hull is invariant
(sp (make-wff (hq-gcst '(f a h) (list (hq-inCg 'f) (hq-inPg 'a) (list 'IN 'h (hq-K 'f))) (list 'IN (hq-L 'a 'h) (hq-K 'f)))))
(dk-peel!)
(hq-hull-setup! 'f)
(dk-cite! 'mg-hull-sub-vec 'G 'f)
(dk-cite! 'subset-mem-fwd (hq-K 'f) hq-gV 'h)
(hq-toC! 'h)
(dk-cite! 'mg-ltrans-cont 'G 'a 'h)
(hq-gvec! (hq-L 'a 'h))
(dk-have! (list 'FORALL 'r (list 'IMPLIES '(POS-RR r) (list 'FORSOME 'y (list 'AND (list 'IN 'y (hq-hull 'f))
            (list '<= (hq-gdst (hq-L 'a 'h) 'y) 'r)))))
  (lambda ()
    (let* ((r (dk-di-var! (lambda (g) (cadr (cadr g)))))
           (_ (di))
           (y0 (dk-skolem! (dk-apply! (dk-cite! 'ms-closure-near hq-gM (hq-hull 'f) 'h) r))))
      (dk-cite! 'subset-mem-fwd (hq-hull 'f) hq-gV y0)
      (hq-toC! y0)
      (dk-cite! 'mg-ltrans-hull 'G 'f 'a y0)
      (dk-cite! 'mg-ltrans-dist 'G 'a 'h y0)
      (ew (hq-L 'a y0))
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (begin (subst (list '= (hq-gdst (hq-L 'a 'h) (hq-L 'a y0)) (hq-gdst 'h y0))) (ass))))))))
(dk-cite! 'ms-closure-intro hq-gM (hq-hull 'f) (hq-L 'a 'h))
(ass)
(hq-qed! 'mg-ltrans-K)

;;; =====================================================================
;;; hq-p16.scm -- HAAR-C2 part 16: the left translations restricted to K(f) form a group of affine isometries of
;;; K(f); by Theorem 1.11 (affine-isometry-fixed-point) they have a common fixed point, which is a constant
;;; function: K(f) contains a constant (compact-groups notes, proof of Theorem 1.9, existence step).

(define (hq-T a f) (list 'VNB-LAMBDA 'hqh_ (hq-K f) (hq-L a 'hqh_)))
(define (hq-Psi f) (list 'VNB-LAMBDA 'hqg_ hq-Pg (hq-T 'hqg_ f)))
(define (hq-gs f) (list 'IMAGE (hq-Psi f) hq-Pg))
(define (hq-const c) (list 'VNB-LAMBDA 'hix_ hq-Pg c))

(sp (make-wff (hq-gst '(a) (list (hq-inPg 'a)) (list '= (hq-mul (hq-inv 'a) 'a) '(IDEN G)))))
(dk-peel!)
(hq-gsetup! '(a))
(hq-to-GG!)
(dk-cite! 'group-left-inv hq-GG 'a)
(ass)
(hq-qed! 'mg-left-inv)

(sp (make-wff (hq-gst '(h) (list (list 'IN 'h (list 'FUN hq-Pg 'RR))) (list '= (hq-L '(IDEN G) 'h) 'h))))
(dk-peel!)
(dk-cite! 'metric-group-ms-is-metric-space 'G)
(hq-gset!)
(dk-cite! 'mg-iden-in 'G)
(hq-Lfun! '(IDEN G) 'h)
(dk-fun-ext! (hq-L '(IDEN G) 'h) 'h hq-Pg 'RR #f #f
  (lambda (x)
    (hq-gmul! '(IDEN G) x)
    (dk-cite! 'fun-apply-type-c 'h hq-Pg 'RR (hq-mul '(IDEN G) x))
    (dk-cite! 'fun-apply-type-c 'h hq-Pg 'RR x)
    (dk-cite! 'mg-left-id 'G x)
    (let ((leaf (proof-state-focus *ps*)))
      (dk-lam-b!)
      (if (not (sequent-node-grounded? leaf))
          (begin (subst (list '= (hq-mul '(IDEN G) x) x)) (rfl))))))
(hq-qed! 'mg-ltrans-iden)

;;; ---- the restricted translations ----
(define (hq-Kset! f)
  (if (not (dk-asm? (list 'IN (hq-K f) 'SET))) (dk-cite! 'closure-is-set hq-gM (hq-hull f))))
(sp (make-wff (hq-gcst '(f a) (list (hq-inCg 'f) (hq-inPg 'a)) (list 'IN (hq-T 'a 'f) (list 'FUN (hq-K 'f) (hq-K 'f))))))
(dk-peel!)
(hq-gnsetup!)
(hq-Kset! 'f)
(dk-lam-type! (lambda () (let ((h (dk-di-var!))) (dk-cite! 'mg-ltrans-K 'G 'f 'a h) (ass))) (lambda () (ass)))
(hq-qed! 'mg-T-fun)

(sp (make-wff (hq-gcst '(f a h) (list (hq-inCg 'f) (hq-inPg 'a) (list 'IN 'h (hq-K 'f))) (list '= (list (hq-T 'a 'f) 'h) (hq-L 'a 'h)))))
(dk-peel!)
(hq-gnsetup!)
(if (not (dk-lam-b!)) (rfl))
(hq-qed! 'mg-T-apply)

(sp (make-wff (hq-gcst '(f a) (list (hq-inCg 'f) (hq-inPg 'a)) (list 'IN (hq-T 'a 'f) (hq-gs 'f)))))
(dk-peel!)
(hq-gnsetup!)
(dk-cite! 'mg-T-fun 'G 'f 'a)
(let* ((w (hq-T 'a 'f))
       (iff (dk-cite! 'image-membership-iff (hq-Psi 'f) hq-Pg w))
       (rhs (caddr iff)))
  (dk-cite! 'membership-implies-sethood w (list 'FUN (hq-K 'f) (hq-K 'f)))
  (dk-have! rhs
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (begin
                (ew 'a)
                (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (if (not (dk-lam-b!)) (rfl)))))))))))
  (hq-prop! iff rhs))
(hq-qed! 'mg-T-in-gs)

(sp (make-wff (hq-gcst '(f k2) (list (hq-inCg 'f) (list 'IN 'k2 (hq-gs 'f)))
   (list 'FORSOME 'hqb_ (list 'AND (hq-inPg 'hqb_) (list '= 'k2 (hq-T 'hqb_ 'f)))))))
(dk-peel!)
(hq-gnsetup!)
(dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'image-membership-iff (hq-Psi 'f) hq-Pg 'k2))))
(let* ((b (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'hqg_))) "the index")))
       (eq0 (dk-ctx-form (list '= (list (hq-Psi 'f) b) 'k2))))
  (dk-lam-b-h! eq0)
  (ew b)
  (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (subst (list '= 'k2 (hq-T b 'f))) (rfl))))))
(hq-qed! 'mg-gs-mem)

;;; ---- the group of affine isometries ----
(define (hq-open-gs! f k)               ; k in gs(f): return b with k = T_b landed
  (let* ((ex (dk-cite! 'mg-gs-mem 'G f k)))
    (dk-skolem! ex)))
(sp (make-wff (hq-gcst '(f) (list (hq-inCg 'f)) (list 'IS-AFFINE-ISOMETRY-GROUP hq-gnvs (hq-K 'f) (hq-gs 'f)))))
(dk-peel!)
(hq-gnsetup!)
(hq-hull-setup! 'f)
(hq-Kset! 'f)
(dk-cite! 'mg-hull-sub-vec 'G 'f)
(define hq-cvK
  (begin
    (dk-cite! 'mg-hull-convex 'G 'f)
    (let* ((iff (dk-cite! 'is-convex-subset hq-gnvs (hq-K 'f))) (rhs (caddr iff)))
      (dk-meta-iff-r! iff)
      (dk-split-all! (list rhs))
      (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'ACT) (dk-contains? h 'CLOSURE))) "K convexity"))))
(define (hq-KtoC! v)
  (dk-cite! 'subset-mem-fwd (hq-K 'f) hq-gV v)
  (hq-toC! v))
(mac 'IS-AFFINE-ISOMETRY-GROUP)
(dk-conj-close!
  (lambda ()
    (let ((g0 (dk-goal)))
      (cond
        ((dk-head-is? g0 'SUBSET)
         (mac 'subset-def)
         (let* ((k (dk-di-var!)) (b (hq-open-gs! 'f k)))
           (subst (list '= k (hq-T b 'f)))
           (dk-cite! 'mg-T-fun 'G 'f b)
           (ass)))
        ((and (dk-head-is? g0 'FORALL) (dk-contains? g0 'FORSOME))
         ;; inverses
         (let* ((k (dk-di-var!)) (b (hq-open-gs! 'f k)) (bi (hq-inv b)))
           (dk-cite! 'mg-inv-in 'G b)
           (dk-cite! 'mg-T-in-gs 'G 'f bi)
           (ew (hq-T bi 'f))
           (dk-conj-close!
             (lambda ()
               (if (dk-asm? (dk-goal))
                   (ass)
                   (let ((x (dk-di-var!)))
                     (subst (list '= k (hq-T b 'f)))
                     (dk-cite! 'mg-T-apply 'G 'f bi x)
                     (subst (list '= (list (hq-T bi 'f) x) (hq-L bi x)))
                     (dk-cite! 'mg-ltrans-K 'G 'f bi x)
                     (dk-cite! 'mg-T-apply 'G 'f b (hq-L bi x))
                     (subst (list '= (list (hq-T b 'f) (hq-L bi x)) (hq-L b (hq-L bi x))))
                     (hq-KtoC! x)
                     (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts hq-Mg x)))
                     (dk-cite! 'mg-ltrans-comp 'G b bi x)
                     (subst (list '= (hq-L b (hq-L bi x)) (hq-L (hq-mul bi b) x)))
                     (dk-cite! 'mg-left-inv 'G b)
                     (subst (list '= (hq-mul bi b) '(IDEN G)))
                     (dk-cite! 'mg-ltrans-iden 'G x)
                     (subst (list '= (hq-L '(IDEN G) x) x))
                     (rfl)))))))
        ((dk-contains? g0 'DIST)
         ;; isometries
         (let* ((ld (dk-peel!))
                (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (hq-gs 'f)))) ld)))
                (us (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (hq-K 'f)))) ld))
                (u (cadr (car us))) (v (cadr (cadr us)))
                (b (hq-open-gs! 'f k)))
           (subst (list '= k (hq-T b 'f)))
           (dk-cite! 'mg-T-apply 'G 'f b u)
           (dk-cite! 'mg-T-apply 'G 'f b v)
           (subst (list '= (list (hq-T b 'f) u) (hq-L b u)))
           (subst (list '= (list (hq-T b 'f) v) (hq-L b v)))
           (hq-KtoC! u) (hq-KtoC! v)
           (dk-cite! 'mg-ltrans-dist 'G b u v)
           (ass)))
        (#t
         ;; convex combinations
         (let* ((ld (dk-peel!))
                (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (hq-gs 'f)))) ld)))
                (us (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (hq-K 'f)))) ld))
                (u (cadr (car us))) (v (cadr (cadr us)))
                (t (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld)))
                (b (hq-open-gs! 'f k))
                (cm (hq-gcomb t u v)))
           (dk-apply! hq-cvK u v t)
           (subst (list '= k (hq-T b 'f)))
           (dk-cite! 'mg-T-apply 'G 'f b u)
           (dk-cite! 'mg-T-apply 'G 'f b v)
           (dk-cite! 'mg-T-apply 'G 'f b cm)
           (subst (list '= (list (hq-T b 'f) cm) (hq-L b cm)))
           (subst (list '= (list (hq-T b 'f) u) (hq-L b u)))
           (subst (list '= (list (hq-T b 'f) v) (hq-L b v)))
           (hq-KtoC! u) (hq-KtoC! v)
           (dk-cite! 'mg-ltrans-affine 'G b u v t)
           (ass)))))))
(hq-qed! 'mg-translation-group)

;;; ---- a common fixed point, and it is a constant ----
(sp (make-wff (hq-gcst '(f) (list (hq-inCg 'f))
   (list 'FORSOME 'hqw_ (list 'AND (list 'IN 'hqw_ (hq-K 'f))
     (list 'FORALL 'a (list 'IMPLIES (hq-inPg 'a) (list '= (hq-L 'a 'hqw_) 'hqw_))))))))
(dk-peel!)
(hq-gnsetup!)
(dk-cite! 'mg-hull-sub-vec 'G 'f)
(dk-cite! 'mg-hull-convex 'G 'f)
(dk-cite! 'mg-hull-compact 'G 'f)
(dk-cite! 'mg-hull-nonempty 'G 'f)
(dk-cite! 'mg-translation-group 'G 'f)
(let* ((fx (dk-cite! 'affine-isometry-fixed-point hq-gnvs (hq-K 'f) (hq-gs 'f)))
       (w (dk-skolem! fx))
       (fcl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h w) (dk-contains? h 'IMAGE))) "the fixed clause")))
  (ew w)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (let ((a (dk-di-var!)))
            (dk-cite! 'mg-T-in-gs 'G 'f a)
            (dk-apply! fcl (hq-T a 'f))
            (dk-cite! 'mg-T-apply 'G 'f a w)
            (subst (list '= (hq-L a w) (list (hq-T a 'f) w)))
            (ass))))))
(hq-qed! 'mg-hull-fixed-point)

(sp (make-wff (hq-gcst '(f) (list (hq-inCg 'f))
   (list 'FORSOME 'hqc_ (list 'AND '(IN hqc_ RR) (list 'IN (hq-const 'hqc_) (hq-K 'f)))))))
(dk-peel!)
(hq-gnsetup!)
(dk-cite! 'mg-hull-sub-vec 'G 'f)
(dk-cite! 'mg-iden-in 'G)
(let* ((w (dk-skolem! (dk-cite! 'mg-hull-fixed-point 'G 'f)))
       (fcl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h w) (dk-contains? h 'OPR))) "the fixed translates"))
       (e '(IDEN G))
       (c (list w e)))
  (dk-cite! 'subset-mem-fwd (hq-K 'f) hq-gV w)
  (hq-toC! w)
  (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts hq-Mg w)))
  (dk-cite! 'fun-apply-type-c w hq-Pg 'RR e)
  (hq-gset!)
  (dk-have! (list 'IN (hq-const c) (list 'FUN hq-Pg 'RR))
    (lambda () (dk-lam-type! (lambda () (dk-di-var!) (ass)))))
  (dk-fun-ext! w (hq-const c) hq-Pg 'RR #f #f
    (lambda (x)
      (dk-cite! 'fun-apply-type-c w hq-Pg 'RR x)
      (let* ((fx (dk-apply! fcl x))
             (claim (list '= (list (hq-L x w) e) c)))
        (hq-gmul! x e)
        (dk-cite! 'mg-right-id 'G x)
        (dk-have! claim (lambda () (subst (list '= (hq-L x w) w)) (rfl)))
        (dk-lam-b-h! claim)
        (dk-rewrite-h! (dk-ctx-form (list '= (list w (hq-mul x e)) c)) (hq-mul x e) x)
        (let ((leaf (proof-state-focus *ps*)))
          (dk-lam-b!)
          (if (not (sequent-node-grounded? leaf)) (ass))))))
  (ew c)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (begin (subst (list '= (hq-const c) w)) (ass))))))
(hq-qed! 'mg-hull-has-constant)

