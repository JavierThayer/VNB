;;; hq-p4.scm -- HAAR-C2 part 4: the norm slot; the slot typings; the vector-space equations; CK-NVS(s) is a
;;; real normed vector space for s compact.

(define (hq-vn t) (list '(VNRM (CK-NVS s)) t))
(define (hq-op? t h) (and (pair? t) (equal? (car t) (list h hq-D))))
(define hq-vz '(VZERO (CK-NVS s)))
(define (hq-cv! t)          ; (IN t (CONT-FNS s)) for a term built by the slots
  (let ((ty (hq-inC t)))
    (cond ((dk-asm? ty) ty)
          ((equal? t hq-vz) (dk-cite! 'ck-vzero-in 's) ty)
          ((hq-op? t 'VADD) (hq-cv! (cadr t)) (hq-cv! (caddr t)) (dk-cite! 'ck-vadd-in 's (cadr t) (caddr t)) ty)
          ((hq-op? t 'ACT) (hq-real! (cadr t)) (hq-cv! (caddr t)) (dk-cite! 'ck-act-in 's (cadr t) (caddr t)) ty)
          ((hq-op? t 'VNEG) (hq-cv! (cadr t)) (dk-cite! 'ck-vneg-in 's (cadr t)) ty)
          (#t (error "hq-cv!: no typing for" t)))))
(define (hq-norm-value! t)   ; rewrite ((VNRM (CK-NVS s)) t) to CK-NORM(s, t) in the goal
  (hq-cv! t)
  (subst (hq-eqn (dk-cite! 'ck-vnrm-readoff 's t))))

(sp (make-wff (hq-cst '(f) (list (hq-inC 'f)) (list '<= 0 (hq-vn 'f)))))
(dk-peel!)
(dk-cite! 'ck-compact-is-ms 's)
(hq-norm-value! 'f)
(hq-norm-parts! 'f)
(ass)
(hq-qed! 'ck-vnrm-nonneg)

(sp (make-wff (hq-cst '(f g) (list (hq-inC 'f) (hq-inC 'g))
                      (list '<= (hq-vn '((VADD (CK-NVS s)) f g)) (list '+ (hq-vn 'f) (hq-vn 'g))))))
(dk-peel!)
(dk-cite! 'ck-compact-is-ms 's)
(hq-norm-value! '((VADD (CK-NVS s)) f g))
(hq-norm-value! 'f)
(hq-norm-value! 'g)
(subst (hq-eqn (dk-cite! 'ck-vadd-readoff 's 'f 'g)))
(dk-cite! 'ck-norm-add-le 's 'f 'g)
(ass)
(hq-qed! 'ck-vnrm-triangle)

(sp (make-wff (hq-cst '(r f) (list '(IN r RR) (hq-inC 'f))
                      (list '= (hq-vn '((ACT (CK-NVS s)) r f)) (list '* '(abs r) (hq-vn 'f))))))
(dk-peel!)
(dk-cite! 'ck-compact-is-ms 's)
(hq-norm-value! '((ACT (CK-NVS s)) r f))
(hq-norm-value! 'f)
(subst (hq-eqn (dk-cite! 'ck-act-readoff 's 'r 'f)))
(dk-cite! 'rmc-cont-fns-scale 's 'r 'f)
(let ((k (hq-N (hq-lam-act 'r 'f))) (c (hq-absr-n-nonneg! 'f)))
  (hq-norm-parts! (hq-lam-act 'r 'f))
  (dk-cite! 'ck-norm-act-le 's 'r 'f)
  (dk-cite! 'ck-norm-act-ge 's 'r 'f)
  (hq-and! (list 'IN k 'RR) (list 'IN c 'RR))
  (hq-and! (list '<= k c) (list '<= c k))
  (dk-cite! 'rr-leq-antisymmetric k c)
  (ass))
(hq-qed! 'ck-vnrm-homogeneous)

(sp (make-wff (hq-cst '(f) (list (hq-inC 'f)) (list 'IFF (list '= (hq-vn 'f) 0) (list '= 'f hq-vz)))))
(dk-peel!)
(dk-cite! 'ck-compact-is-ms 's)
(hq-norm-value! 'f)
(subst (hq-eqn (dk-cite! 'ck-vzero-readoff 's)))
(dk-cite! 'ck-norm-zero-intro 's)
(let ((a (dk-cite! 'ck-norm-zero-elim 's 'f)))
  (dk-have! (list 'IMPLIES (list '= 'f hq-zero) (list '= (hq-N 'f) 0))
    (lambda () (di) (subst (list '= 'f hq-zero)) (ass)))
  (hq-prop! a (list 'IMPLIES (list '= 'f hq-zero) (list '= (hq-N 'f) 0))))
(hq-qed! 'ck-vnrm-definite)

