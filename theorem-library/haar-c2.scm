;;; haar-c2.scm -- the space C(s) of a compact metric space with the supremum norm, and the Haar integral of a
;;; compact metric group G up to the existence step: the left translations act on C(G) as affine isometries,
;;; the orbit of f in C(G) is compact, its closed convex hull K(f) is compact, convex and invariant, and K(f)
;;; contains a constant function (compact-groups notes, proof of Theorem 1.9; th-main Prop 3.78 / Cor 3.82).
;;; Agent HAAR-C2, 2026-11-09.  Helper prefix: hq-.  Library: analysis.  DESTINATION:
;;; theorem-library/haar-c2.scm (vocabulary: structure-library/hc2-vocab.scm).
;;; WINDOW: see HAAR-C2-REPORT.md (after theorem-library/haar-fixed-point, which cites krein-milman).
;;; No support, warrant!, stamp or add-axiom!.  Parts 1-16 are the probe parts concatenated, in order.

;;; =====================================================================
;;; hq-p1.scm -- HAAR-C2 part 1: helpers; CONT-FNS(s) is a set; the zero and negative functions; the
;;; supremum norm CK-NORM (an upper bound, the least one, a real number on a compact space).

(define (hq-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; HQ OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (hq-dump tag)
  (display ";; HQ ") (display tag) (display " goal: ") (display (expression->string (dk-goal))) (newline)
  (for-each (lambda (l) (display ";; HQ   open: ") (display (expression->string (dk-goal-of l))) (newline))
            (dk-open-leaves)))
(define (hq-prop! . keepers) (apply dk-only! keepers) (prop))
(define (hq-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    c))
(define (hq-pos! e) (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))
(define (hq-ptsrr!)
  (if (not (dk-asm? '(== (PTS RR-MS) RR)))
      (dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl)))))
(define (hq-find pred e)
  (cond ((pred e) e)
        ((pair? e) (let loop ((l e)) (cond ((null? l) #f) ((hq-find pred (car l))) (#t (loop (cdr l))))))
        (#t #f)))

(define hq-C '(CONT-FNS s))
(define (hq-inC v) (list 'IN v hq-C))
(define hq-F '(FUN (PTS s) RR))
(define hq-zero '(VNB-LAMBDA sx_ (PTS s) 0))
(define (hq-lam-neg f) (list 'VNB-LAMBDA 'sx_ '(PTS s) (list '- (list f 'sx_))))
(define (hq-lam-add f g) (list 'VNB-LAMBDA 'sx_ '(PTS s) (list '+ (list f 'sx_) (list g 'sx_))))
(define (hq-lam-act r f) (list 'VNB-LAMBDA 'sx_ '(PTS s) (list '* r (list f 'sx_))))
(define (hq-N f) (list 'CK-NORM 's f))

;;; (IN (f x) RR) for f in CONT-FNS(s) or in FUN(PTS s, RR)
(define (hq-app! f x)
  (let ((ty (list 'IN (list f x) 'RR)))
    (if (not (dk-asm? ty))
        (begin
          (if (not (dk-asm? (list 'IN f hq-F)))
              (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's f))))
          (dk-cite! 'fun-apply-type-c f '(PTS s) 'RR x)))
    ty))

;;; =====================================================================
;;; CONT-FNS(s) is a set
;;; =====================================================================
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (IN (CONT-FNS s) SET)))))
(dk-peel!)
(dk-cite! 'ms-pts-is-set 's)
(fact 'rr-is-set)
(dk-have! (list 'IN hq-F 'SET) (lambda () (mac 'fun-set-iff) (dk-conj-close! (lambda () (ass)))))
(mac 'CONT-FNS)
(sep-set)
(for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (ass)))) (dk-open-leaves))
(hq-qed! 'ck-cont-fns-is-set)

;;; the zero function is continuous
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (hq-inC hq-zero)))))
(dk-peel!)
(dk-cite! 'ms-pts-is-set 's)
(dk-have! (list 'IN hq-zero hq-F)
  (lambda () (dk-lam-type! (lambda () (dk-di-var!) (dk-cite! 'rr-zero-in) (ass)) (lambda () (ass)))))
(dk-cite! 'carrier-is-open 's)
(dk-have! (list 'FORALL 'a (list 'IMPLIES '(IN a (PTS s)) (list 'IS-CONTINUOUS-AT 's 'RR-MS hq-zero 'a)))
  (lambda ()
    (let ((a (dk-di-var!)))
      (dk-have! (list 'FORALL 'y (list 'IMPLIES '(IN y (PTS s)) (list '= (list hq-zero 'y) (list hq-zero a))))
        (lambda ()
          (dk-di-var!)
          (if (not (dk-lam-b!)) (rfl))))
      (dk-cite! 'rmc-cont-at-locally-const 's hq-zero a '(PTS s))
      (ass))))
(dk-cite! 'rmc-cont-fns-intro 's hq-zero)
(ass)
(hq-qed! 'ck-zero-cont)

;;; the negative of a continuous function is continuous
(sp (make-wff (list 'FORALL 's (list 'FORALL 'f (list 'IMPLIES (hq-inC 'f) (hq-inC (hq-lam-neg 'f)))))))
(dk-peel!)
(let ((c (dk-cite! 'rmc-cont-fns-mem 's 'f)))
  (dk-have! '(IS-CONTINUOUS s RR-MS f) (lambda () (hq-prop! c (hq-inC 'f)))))
(dk-cite! 'neg-continuous-real 's 'f)
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's 'f)))
(dk-cite! 'ms-pts-is-set 's)
(dk-have! (list 'IN (hq-lam-neg 'f) hq-F)
  (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (hq-app! 'f x) (dk-cite! 'rr-neg-closed (list 'f x)) (ass)))
                           (lambda () (ass)))))
(let ((c (dk-cite! 'rmc-cont-fns-mem 's (hq-lam-neg 'f))))
  (dk-have! (caddr c) (lambda () (dk-conj-close! (lambda () (ass)))))
  (hq-prop! c (caddr c)))
(hq-qed! 'ck-neg-cont)

;;; =====================================================================
;;; the supremum norm
;;; =====================================================================
(define hq-im '(IMAGE (VNB-LAMBDA ckp_ (PTS s) (abs (h ckp_))) (PTS s)))
(define hq-nh '(CK-NORM s h))
(define (hq-elim! w)
  (let* ((mem (dk-pick (lambda (x) (and (dk-head-is? x 'IN) (eq? (cadr x) w) (dk-head-is? (caddr x) 'IMAGE)))
                       "the image membership"))
         (_1 (dk-split-all! (dk-landed (lambda () (mac-h 'image-membership-iff mem)))))
         (x (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h w))) "the preimage"))))
    (dk-lam-b-h! (dk-pick (lambda (h) (and (dk-head-is? h '=) (eq? (caddr h) w))) "the value equation"))
    (dk-cite! 'fun-apply-type-c 'h '(PTS s) 'RR x)
    (dk-cite! 'rr-abs-closed (list 'h x))
    (dk-cite! 'rr-abs-nonneg (list 'h x))
    (subst (list '= w (list 'abs (list 'h x))))
    x))
(define (hq-pos-star!) (mac 'rr-pos-star-membership) (oi-l) (dk-conj-close! (lambda () (ass))))
(define (hq-im-subset!)
  (if (not (dk-asm? (list 'SUBSET hq-im 'RR-POS-STAR)))
      (dk-have! (list 'SUBSET hq-im 'RR-POS-STAR)
        (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (hq-elim! w) (hq-pos-star!))))))

(sp (make-wff '(FORALL s (FORALL h (IMPLIES (IN h (FUN (PTS s) RR))
   (FORALL x (IMPLIES (IN x (PTS s)) (<= (abs (h x)) (CK-NORM s h)))))))))
(dk-peel!)
(mac 'CK-NORM)
(hq-im-subset!)
(define hq-up (dk-fact! 'esup-upper hq-im))
(dk-cite! 'fun-apply-type-c 'h '(PTS s) 'RR 'x)
(dk-cite! 'rr-abs-closed '(h x))
(dk-cite! 'membership-implies-sethood '(abs (h x)) 'RR)
(dk-have! (list 'IN '(abs (h x)) hq-im)
  (lambda ()
    (mac 'image-membership-iff)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'FORSOME)
            (begin (ew 'x)
                   (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (dk-lam-b!) (rfl))))))
            (ass))))))
(dk-apply! hq-up '(abs (h x)))
(ass)
(hq-qed! 'ck-norm-upper)

(sp (make-wff '(FORALL s (FORALL h (FORALL b (IMPLIES (IN h (FUN (PTS s) RR)) (IMPLIES (IN b RR) (IMPLIES (<= 0 b)
   (IMPLIES (FORALL x (IMPLIES (IN x (PTS s)) (<= (abs (h x)) b)))
     (AND (IN (CK-NORM s h) RR) (AND (<= 0 (CK-NORM s h)) (<= (CK-NORM s h) b))))))))))))
(dk-peel!)
(define hq-bd (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'b))) "the bound"))
(dk-have! (list 'IN hq-nh 'RR-POS-STAR)
  (lambda () (mac 'CK-NORM) (hq-im-subset!) (fact 'esup-in hq-im) (ass)))
(dk-have! (list '<= hq-nh 'b)
  (lambda ()
    (mac 'CK-NORM)
    (hq-im-subset!)
    (dk-have! (list 'AND '(IN b RR-POS-STAR) (list 'FORALL 'hqw_ (list 'IMPLIES (list 'IN 'hqw_ hq-im) '(<= hqw_ b))))
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'FORALL)
                (let* ((w (dk-di-var!)) (x (hq-elim! w)))
                  (dk-apply! hq-bd x)
                  (ass))
                (hq-pos-star!))))))
    (fact 'esup-least hq-im 'b)
    (ass)))
(hq-and! (list 'IN hq-nh 'RR-POS-STAR) '(IN b RR))
(fact 'rr-pos-star-le-real-in-rr hq-nh 'b)
(fact 'rr-pos-star-nonneg hq-nh)
(dk-conj-close! (lambda () (ass)))
(hq-qed! 'ck-norm-bound)

;;; a continuous real function on a compact space is bounded
(sp (make-wff '(FORALL s (FORALL h (IMPLIES (IS-COMPACT s) (IMPLIES (IN h (CONT-FNS s))
   (FORSOME bm_ (AND (IN bm_ RR) (AND (<= 0 bm_) (FORALL bz_ (IMPLIES (IN bz_ (PTS s)) (<= (abs (h bz_)) bm_))))))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's 'h)))
(let ((c (dk-cite! 'rmc-cont-fns-mem 's 'h)))
  (dk-have! '(IS-CONTINUOUS s RR-MS h) (lambda () (hq-prop! c '(IN h (CONT-FNS s))))))
(use-em '(FORSOME hqp_ (IN hqp_ (PTS s)))
  (lambda ()
    (let* ((p0 (dk-skolem! '(FORSOME hqp_ (IN hqp_ (PTS s)))))
           (mx (dk-cite! 'compact-continuous-max 's 'h))
           (mn (dk-cite! 'compact-continuous-min 's 'h))
           (p (dk-skolem! (dk-apply! mx p0)))
           (cp (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-head-is? (caddr x) 'IMPLIES) (dk-head-is? (caddr (caddr x)) '<=) (dk-contains? x (list 'h p)))) "the max clause"))
           (q (dk-skolem! (dk-apply! mn p0)))
           (cq (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-head-is? (caddr x) 'IMPLIES) (dk-head-is? (caddr (caddr x)) '<=) (dk-contains? x (list 'h q)))) "the min clause"))
           (hp (list 'h p)) (hq (list 'h q))
           (b (list '+ (list 'abs hp) (list 'abs hq))))
      (hq-app! 'h p) (hq-app! 'h q)
      (dk-cite! 'rr-abs-closed hp) (dk-cite! 'rr-abs-closed hq)
      (dk-cite! 'rr-abs-nonneg hp) (dk-cite! 'rr-abs-nonneg hq)
      (dk-have! (list '<= (list 'abs hp) (list 'abs hp)) (lambda () (dk-ineq! (list 'IN (list 'abs hp) 'RR))))
      (dk-have! (list '<= (list 'abs hq) (list 'abs hq)) (lambda () (dk-ineq! (list 'IN (list 'abs hq) 'RR))))
      (let* ((lp (dk-cite! 'rr-abs-le-parts hp (list 'abs hp)))
             (lq (dk-cite! 'rr-abs-le-parts hq (list 'abs hq))))
        (dk-split! lp) (dk-split! lq)
        (ew b)
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond
                ((dk-head-is? g 'FORALL)
                 (let* ((z (dk-di-var!)) (hz (list 'h z)))
                   (hq-app! 'h z)
                   (let* ((u (dk-apply! cp z)) (v (dk-apply! cq z)))
                     (dk-real! b)
                     (dk-have! (list '<= (list '- b) hz)
                       (lambda () (dk-ineq! v (list '<= (list '- (list 'abs hq)) hq) (list '<= 0 (list 'abs hp))
                                            (list 'IN hz 'RR) (list 'IN hq 'RR) (list 'IN (list 'abs hp) 'RR) (list 'IN (list 'abs hq) 'RR))))
                     (dk-have! (list '<= hz b)
                       (lambda () (dk-ineq! u (list '<= hp (list 'abs hp)) (list '<= 0 (list 'abs hq))
                                            (list 'IN hz 'RR) (list 'IN hp 'RR) (list 'IN (list 'abs hp) 'RR) (list 'IN (list 'abs hq) 'RR))))
                     (dk-cite! 'rr-abs-le-of-parts hz b)
                     (ass))))
                ((dk-head-is? g 'IN) (dk-close-if! (lambda () (dk-real! b)) ass))
                (#t (dk-ineq! (list '<= 0 (list 'abs hp)) (list '<= 0 (list 'abs hq))
                              (list 'IN (list 'abs hp) 'RR) (list 'IN (list 'abs hq) 'RR))))))))))
  (lambda ()
    (ew 0)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((dk-head-is? g 'FORALL)
             (let ((z (dk-di-var!)))
               (dk-have! '(FORSOME hqp_ (IN hqp_ (PTS s))) (lambda () (ew z) (ass)))
               (hq-prop! '(FORSOME hqp_ (IN hqp_ (PTS s))) '(NOT (FORSOME hqp_ (IN hqp_ (PTS s)))))))
            ((dk-head-is? g 'IN) (dk-cite! 'rr-zero-in) (ass))
            (#t (dk-ineq!))))))))
(hq-qed! 'ck-cont-bounded)

;;; the norm of a continuous function on a compact space is a nonnegative real
(sp (make-wff '(FORALL s (FORALL h (IMPLIES (IS-COMPACT s) (IMPLIES (IN h (CONT-FNS s))
   (AND (IN (CK-NORM s h) RR) (<= 0 (CK-NORM s h)))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's 'h)))
(let* ((m (dk-skolem! (dk-cite! 'ck-cont-bounded 's 'h)))
       (b (dk-cite! 'ck-norm-bound 's 'h m)))
  (dk-split-all! (list b))
  (hq-and! '(IN (CK-NORM s h) RR) '(<= 0 (CK-NORM s h))))
(hq-qed! 'ck-norm-real)

;;; =====================================================================
;;; hq-p2.scm -- HAAR-C2 part 2: the slots of CK-NVS(s) read off; closure of CONT-FNS(s) under them; their
;;; pointwise values.

(define hq-D '(CK-NVS s))
(define hq-ms '(IS-METRIC-SPACE s))
(define (hq-st vars guards body) (forall-guarded (cons 's vars) (cons hq-ms guards) body))
(define (hq-eqn e) (list '= (cadr e) (caddr e)))

(define (hq-certify!)
  (dk-cite! 'rr-is-normed-field)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'RR-NORMED-FIELD)
  (if (not (dk-asm? '(IN RR SET))) (fact 'rr-is-set))
  (dk-cite! 'ms-pts-is-set 's)
  (dk-cite! 'ck-cont-fns-is-set 's))
(define (hq-readoff! acc)
  (dk-peel!)
  (hq-certify!)
  (mac 'CK-NVS)
  (slot acc)
  (nth-r))

(sp (make-wff (hq-st '() '() (list '== '(VEC (CK-NVS s)) hq-C))))
(hq-readoff! 'VEC)
(qrfl)
(hq-qed! 'ck-nvs-vec)

(sp (make-wff (hq-st '() '() (list '== '(SCAL (CK-NVS s)) '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD)))))
(hq-readoff! 'SCAL)
(qrfl)
(hq-qed! 'ck-nvs-scal)

(sp (make-wff (hq-st '(f g) (list (hq-inC 'f) (hq-inC 'g))
                     (list '== '((VADD (CK-NVS s)) f g) (hq-lam-add 'f 'g)))))
(hq-readoff! 'VADD)
(dk-lam-b!)
(qrfl)
(hq-qed! 'ck-vadd-readoff)

(sp (make-wff (hq-st '(r f) (list '(IN r RR) (hq-inC 'f))
                     (list '== '((ACT (CK-NVS s)) r f) (hq-lam-act 'r 'f)))))
(hq-readoff! 'ACT)
(dk-lam-b!)
(qrfl)
(hq-qed! 'ck-act-readoff)

(sp (make-wff (hq-st '(f) (list (hq-inC 'f)) (list '== '((VNEG (CK-NVS s)) f) (hq-lam-neg 'f)))))
(hq-readoff! 'VNEG)
(dk-lam-b!)
(qrfl)
(hq-qed! 'ck-vneg-readoff)

(sp (make-wff (hq-st '() '() (list '== '(VZERO (CK-NVS s)) hq-zero))))
(hq-readoff! 'VZERO)
(qrfl)
(hq-qed! 'ck-vzero-readoff)

(sp (make-wff (hq-st '(f) (list (hq-inC 'f)) (list '== '((VNRM (CK-NVS s)) f) (hq-N 'f)))))
(hq-readoff! 'VNRM)
(dk-lam-b!)
(qrfl)
(hq-qed! 'ck-vnrm-readoff)

;;; =====================================================================
;;; closure of CONT-FNS(s) under the slots
;;; =====================================================================
(sp (make-wff (hq-st '(f g) (list (hq-inC 'f) (hq-inC 'g)) (hq-inC '((VADD (CK-NVS s)) f g)))))
(dk-peel!)
(subst (hq-eqn (dk-cite! 'ck-vadd-readoff 's 'f 'g)))
(dk-cite! 'rmc-cont-fns-add 's 'f 'g)
(ass)
(hq-qed! 'ck-vadd-in)

(sp (make-wff (hq-st '(r f) (list '(IN r RR) (hq-inC 'f)) (hq-inC '((ACT (CK-NVS s)) r f)))))
(dk-peel!)
(subst (hq-eqn (dk-cite! 'ck-act-readoff 's 'r 'f)))
(dk-cite! 'rmc-cont-fns-scale 's 'r 'f)
(ass)
(hq-qed! 'ck-act-in)

(sp (make-wff (hq-st '(f) (list (hq-inC 'f)) (hq-inC '((VNEG (CK-NVS s)) f)))))
(dk-peel!)
(subst (hq-eqn (dk-cite! 'ck-vneg-readoff 's 'f)))
(dk-cite! 'ck-neg-cont 's 'f)
(ass)
(hq-qed! 'ck-vneg-in)

(sp (make-wff (hq-st '() '() (hq-inC '(VZERO (CK-NVS s))))))
(dk-peel!)
(subst (hq-eqn (dk-cite! 'ck-vzero-readoff 's)))
(dk-cite! 'ck-zero-cont 's)
(ass)
(hq-qed! 'ck-vzero-in)

;;; =====================================================================
;;; pointwise values
;;; =====================================================================
(define (hq-type-atoms!)
  (let walk ((e (dk-goal)))
    (cond ((and (pair? e) (= (length e) 2) (symbol? (car e))
                (or (dk-asm? (hq-inC (car e))) (dk-asm? (list 'IN (car e) hq-F)))
                (dk-asm? (list 'IN (cadr e) '(PTS s))))
           (hq-app! (car e) (cadr e)))
          ((pair? e) (for-each walk e)))))

(sp (make-wff (hq-st '(f g x) (list (hq-inC 'f) (hq-inC 'g) '(IN x (PTS s)))
                     '(= (((VADD (CK-NVS s)) f g) x) (+ (f x) (g x))))))
(dk-peel!)
(subst (hq-eqn (dk-cite! 'ck-vadd-readoff 's 'f 'g)))
(hq-type-atoms!)
(if (not (dk-lam-b!)) (rfl))
(hq-qed! 'ck-vadd-apply)

(sp (make-wff (hq-st '(r f x) (list '(IN r RR) (hq-inC 'f) '(IN x (PTS s)))
                     '(= (((ACT (CK-NVS s)) r f) x) (* r (f x))))))
(dk-peel!)
(subst (hq-eqn (dk-cite! 'ck-act-readoff 's 'r 'f)))
(hq-type-atoms!)
(if (not (dk-lam-b!)) (rfl))
(hq-qed! 'ck-act-apply)

(sp (make-wff (hq-st '(f x) (list (hq-inC 'f) '(IN x (PTS s)))
                     '(= (((VNEG (CK-NVS s)) f) x) (- (f x))))))
(dk-peel!)
(subst (hq-eqn (dk-cite! 'ck-vneg-readoff 's 'f)))
(hq-type-atoms!)
(if (not (dk-lam-b!)) (rfl))
(hq-qed! 'ck-vneg-apply)

(sp (make-wff (hq-st '(x) (list '(IN x (PTS s))) '(= ((VZERO (CK-NVS s)) x) 0))))
(dk-peel!)
(subst (hq-eqn (dk-cite! 'ck-vzero-readoff 's)))
(if (not (dk-lam-b!)) (rfl))
(hq-qed! 'ck-vzero-apply)

;;; =====================================================================
;;; hq-p3.scm -- HAAR-C2 part 3: the supremum norm is a norm on CONT-FNS(s), s compact.

(sp (make-wff '(FORALL s (IMPLIES (IS-COMPACT s) (IS-METRIC-SPACE s)))))
(dk-peel!)
(let ((c (dk-cite! 'is-compact 's))) (hq-prop! c '(IS-COMPACT s)))
(hq-qed! 'ck-compact-is-ms)

(define hq-cpt '(IS-COMPACT s))
(define (hq-cst vars guards body) (forall-guarded (cons 's vars) (cons hq-cpt guards) body))
(define (hq-eq! a b)
  (let ((e (list '= a b)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (crs))))
    e))
;;; (IN t RR) for the real terms of these proofs
(define (hq-real! t)
  (let ((ty (list 'IN t 'RR)))
    (cond ((dk-asm? ty) ty)
          ((eqv? t 0) (dk-cite! 'rr-zero-in) ty)
          ((dk-head-is? t 'abs) (hq-real! (cadr t)) (dk-cite! 'rr-abs-closed (cadr t)) ty)
          ((and (pair? t) (= (length t) 2) (symbol? (car t))
                (or (dk-asm? (hq-inC (car t))) (dk-asm? (list 'IN (car t) hq-F))))
           (hq-app! (car t) (cadr t)))
          ((dk-head-is? t 'CK-NORM)
           (if (not (dk-asm? (hq-inC (caddr t)))) (error "hq-real!: untyped norm argument" t))
           (dk-split-all! (list (dk-cite! 'ck-norm-real 's (caddr t)))) ty)
          ((dk-head-is? t 'abs) (hq-real! (cadr t)) (dk-cite! 'rr-abs-closed (cadr t)) ty)
          (#t (dk-real! t)))))
(define (hq-norm-parts! f) (hq-real! (hq-N f)))
;;; a beta redex anywhere in E
(define (hq-has-redex? e)
  (cond ((and (pair? e) (pair? (car e)) (eq? (caar e) 'VNB-LAMBDA)) #t)
        ((pair? e) (let loop ((l e)) (and (pair? l) (or (hq-has-redex? (car l)) (loop (cdr l))))))
        (#t #f)))
;;; the bound clause of ck-norm-bound for the function LAM: (FORALL x (IMPLIES (IN x (PTS s)) (<= (abs (LAM x)) B)))
(define (hq-bound-clause lam b) (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS s)) (list '<= (list 'abs (list lam 'x)) b))))
;;; N(LAM) <= B from the bound clause (proved by PTWISE on the eigenvariable, the goal beta-reduced)
(define (hq-norm-le! lam b ptwise)
  (if (not (dk-asm? (list 'IN lam hq-F)))
      (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's lam))))
  (hq-real! b)
  (dk-have! (hq-bound-clause lam b)
    (lambda () (let ((x (dk-di-var!)))
                 (if (hq-has-redex? (dk-goal)) (if (not (dk-lam-b!)) (ptwise x)) (ptwise x)))))
  (dk-split-all! (list (dk-cite! 'ck-norm-bound 's lam b)))
  (list '<= (hq-N lam) b))

(sp (make-wff (hq-cst '(f g) (list (hq-inC 'f) (hq-inC 'g))
                      (list '<= (hq-N (hq-lam-add 'f 'g)) (list '+ (hq-N 'f) (hq-N 'g))))))
(dk-peel!)
(dk-cite! 'ck-compact-is-ms 's)
(dk-cite! 'rmc-cont-fns-add 's 'f 'g)
(hq-norm-parts! 'f) (hq-norm-parts! 'g)
(dk-have! (list '<= 0 (list '+ (hq-N 'f) (hq-N 'g)))
  (lambda () (dk-ineq! (list '<= 0 (hq-N 'f)) (list '<= 0 (hq-N 'g)) (list 'IN (hq-N 'f) 'RR) (list 'IN (hq-N 'g) 'RR))))
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's 'f)))
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's 'g)))
(hq-norm-le! (hq-lam-add 'f 'g) (list '+ (hq-N 'f) (hq-N 'g))
  (lambda (x)
    (let* ((fx (list 'f x)) (gx (list 'g x)))
      (hq-real! fx) (hq-real! gx) (hq-real! (list 'abs fx)) (hq-real! (list 'abs gx)) (hq-real! (list 'abs (list '+ fx gx)))
      (let* ((uf (dk-apply! (dk-cite! 'ck-norm-upper 's 'f) x))
             (ug (dk-apply! (dk-cite! 'ck-norm-upper 's 'g) x))
             (tri (dk-cite! 'rr-abs-triangle-c fx gx)))
        (dk-ineq! uf ug tri (list 'IN (list 'abs fx) 'RR) (list 'IN (list 'abs gx) 'RR) (list 'IN (list 'abs (list '+ fx gx)) 'RR)
                  (list 'IN (hq-N 'f) 'RR) (list 'IN (hq-N 'g) 'RR))))))
(ass)
(hq-qed! 'ck-norm-add-le)

;;; 0 <= |r| N(f)
(define (hq-absr-n-nonneg! f)
  (let ((c (list '* '(abs r) (hq-N f))))
    (hq-real! '(abs r)) (hq-norm-parts! f) (hq-real! c)
    (dk-cite! 'rr-abs-nonneg 'r)
    (let ((h (dk-cite! 'rr-mul-le-right 0 (hq-N f) '(abs r))))
      (if (not (dk-asm? (list '<= 0 c)))
          (dk-have! (list '<= 0 c)
            (lambda ()
              (subst (hq-eq! c (list '* (hq-N f) '(abs r))))
              (hq-eq! '(* 0 (abs r)) 0)
              (dk-rewrite-h! h '(* 0 (abs r)) 0)
              (ass)))))
    c))

(sp (make-wff (hq-cst '(r f) (list '(IN r RR) (hq-inC 'f))
                      (list '<= (hq-N (hq-lam-act 'r 'f)) (list '* '(abs r) (hq-N 'f))))))
(dk-peel!)
(dk-cite! 'ck-compact-is-ms 's)
(dk-cite! 'rmc-cont-fns-scale 's 'r 'f)
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's 'f)))
(let ((c (hq-absr-n-nonneg! 'f)))
  (hq-norm-le! (hq-lam-act 'r 'f) c
    (lambda (x)
      (let* ((fx (list 'f x)) (afx (list 'abs fx)))
        (hq-real! fx) (hq-real! afx)
        (hq-and! '(IN r RR) (list 'IN fx 'RR))
        (subst (dk-cite! 'rr-abs-mult 'r fx))
        (let ((uf (dk-apply! (dk-cite! 'ck-norm-upper 's 'f) x)))
          (dk-cite! 'rr-abs-nonneg 'r)
          (dk-cite! 'rr-mul-le-right afx (hq-N 'f) '(abs r))
          (subst (hq-eq! (list '* '(abs r) afx) (list '* afx '(abs r))))
          (subst (hq-eq! (list '* '(abs r) (hq-N 'f)) (list '* (hq-N 'f) '(abs r))))
          (ass)))))
  (ass))
(hq-qed! 'ck-norm-act-le)

(sp (make-wff (hq-cst '(r f) (list '(IN r RR) (hq-inC 'f))
                      (list '<= (list '* '(abs r) (hq-N 'f)) (hq-N (hq-lam-act 'r 'f))))))
(dk-peel!)
(dk-cite! 'ck-compact-is-ms 's)
(define hq-L (hq-lam-act 'r 'f))
(dk-cite! 'rmc-cont-fns-scale 's 'r 'f)
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's 'f)))
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's hq-L)))
(hq-norm-parts! 'f) (hq-norm-parts! hq-L)
(hq-real! '(abs r))
(dk-cite! 'rr-abs-nonneg 'r)
(use-em '(= r 0)
  (lambda ()
    (dk-have! '(= (abs r) 0) (lambda () (subst '(= r 0)) (fact 'rr-abs-zero-value) (ass)))
    (subst '(= (abs r) 0))
    (dk-ineq! (list '<= 0 (hq-N hq-L)) (list 'IN (hq-N hq-L) 'RR) (list 'IN (hq-N 'f) 'RR)))
  (lambda ()
    (let* ((a '(abs r)) (k (hq-N hq-L)) (n (hq-N 'f))
           (iff (dk-cite! 'rr-abs-zero 'r)))
      (dk-have! (list 'NOT (list '= a 0)) (lambda () (hq-prop! iff '(NOT (= r 0)))))
      (dk-cite! 'dual-rr-pos-of-nonneg-nonzero a)
      (hq-and! (list 'IN a 'RR) (list 'NOT (list '= a 0)))
      (dk-cite! 'rr-recip-closed a)
      (let* ((inv (dk-cite! 'rr-recip-inverse a))
             (v (dk-name! (list 'recip a)))
             (av (list '* a v)))
        (dk-have! (list '= av 1) (lambda () (subst (list '= v (list 'recip a))) (ass)))
        (dk-cite! 'rr-recip-pos a)
        (dk-have! (list '<= 0 v) (lambda () (subst (list '= v (list 'recip a)))
                                            (dk-ineq! (list '< 0 (list 'recip a)) (list 'IN (list 'recip a) 'RR))))
        (let ((kv (list '* k v)))
          (dk-real! kv)
          (let ((h (dk-cite! 'rr-mul-le-right 0 k v)))
            (dk-have! (list '<= 0 kv)
              (lambda () (hq-eq! (list '* 0 v) 0) (dk-rewrite-h! h (list '* 0 v) 0) (ass))))
          (hq-norm-le! 'f kv
            (lambda (x)
              (let* ((fx (list 'f x)) (afx (list 'abs fx)))
                (hq-real! fx) (hq-real! afx)
                (let* ((b0 (dk-apply! (dk-cite! 'ck-norm-upper 's hq-L) x))
                       (ap (dk-have! (list '= (list hq-L x) (list '* 'r fx)) (lambda () (if (not (dk-lam-b!)) (rfl)))))
                       (b1 (dk-rewrite-h! b0 (list hq-L x) (list '* 'r fx))))
                  (hq-and! '(IN r RR) (list 'IN fx 'RR))
                  (dk-cite! 'rr-abs-mult 'r fx)
                  (let* ((b2 (dk-rewrite-h! b1 (list 'abs (list '* 'r fx)) (list '* a afx)))
                         (rhs (list '* kv a)))
                    (dk-real! rhs)
                    (dk-have! (list '<= (list '* afx a) rhs)
                      (lambda ()
                        (subst (hq-eq! (list '* afx a) (list '* a afx)))
                        (subst (hq-eq! rhs (list '* k av)))
                        (subst (list '= av 1))
                        (subst (hq-eq! (list '* k 1) k))
                        (ass)))
                    (dk-cite! 'rr-mul-le-cancel-pos afx a kv)
                    (ass))))))
          (let* ((h1 (dk-cite! 'rr-mul-le-right n kv a))
                 (e1 (hq-eq! (list '* kv a) (list '* k av)))
                 (h2 (dk-rewrite-h! h1 (list '* kv a) (list '* k av)))
                 (h3 (dk-rewrite-h! h2 av 1))
                 (e2 (hq-eq! (list '* k 1) k))
                 (h4 (dk-rewrite-h! h3 (list '* k 1) k)))
            (subst (hq-eq! (list '* a n) (list '* n a)))
            (ass)))))))
(hq-qed! 'ck-norm-act-ge)

(sp (make-wff (hq-st '(f) (list (hq-inC 'f) (list '= (hq-N 'f) 0)) (list '= 'f hq-zero))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's 'f)))
(dk-cite! 'ck-zero-cont 's)
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's hq-zero)))
(dk-fun-ext! 'f hq-zero '(PTS s) 'RR #f #f
  (lambda (v)
    (if (not (dk-lam-b!))
        (let* ((fv (list 'f v)) (afv (list 'abs fv)))
          (hq-app! 'f v) (dk-cite! 'rr-abs-closed fv)
          (let* ((b0 (dk-apply! (dk-cite! 'ck-norm-upper 's 'f) v))
                 (b1 (dk-rewrite-h! b0 (hq-N 'f) 0)))
            (dk-cite! 'rr-abs-nonneg fv)
            (dk-cite! 'rr-zero-in)
            (hq-and! (list 'IN afv 'RR) '(IN 0 RR))
            (hq-and! (list '<= afv 0) (list '<= 0 afv))
            (let* ((e (dk-cite! 'rr-leq-antisymmetric afv 0))
                   (iff (dk-cite! 'rr-abs-zero fv)))
              (hq-prop! e iff)))))))
(hq-qed! 'ck-norm-zero-elim)

(sp (make-wff (hq-st '() '() (list '= (hq-N hq-zero) 0))))
(dk-peel!)
(dk-cite! 'ck-zero-cont 's)
(dk-cite! 'rr-zero-in)
(dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
(hq-norm-le! hq-zero 0
  (lambda (x) (fact 'rr-abs-zero-value) (subst '(= (abs 0) 0)) (dk-ineq!)))
(let ((k (hq-N hq-zero)))
  (hq-and! (list 'IN k 'RR) '(IN 0 RR))
  (hq-and! (list '<= k 0) (list '<= 0 k))
  (dk-cite! 'rr-leq-antisymmetric k 0)
  (ass))
(hq-qed! 'ck-norm-zero-intro)

