;;; cg4-rep.scm -- the extension psi of a group segment phi (Prop. 5.36): every real t has exactly
;;; one representation t = n al + r (n in NN, 0 <= r < al) on its side of 0, so OPG-REP(t, y)
;;; holds for exactly one y, and OPG-VAL(t) is that y.
;;; Agent ISOM, 2026-10-26.  Helper prefix: rp4-.  Library: analysis.

(define (rp4-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (rp4-ass-rfl!) (if (dk-asm? (dk-goal)) (ass) (rfl)))
(define (rp4-split-if! pred)
  (let ((hs (filter (lambda (h) (and (dk-head-is? h 'AND) (pred h))) (dk-asms))))
    (if (pair? hs) (dk-split-all! hs))))
(define (rp4-op x y) (list '(OPR g) x y))
(define (rp4-inv x) (list '(INV g) x))
(define rp4-c '(phi al))
(define (rp4-pow n) (list 'GPOW 'g rp4-c n))
(define (rp4-forall vs body) (if (null? vs) body (list 'FORALL (car vs) (rp4-forall (cdr vs) body))))
(define (rp4-implies hs concl) (if (null? hs) concl (list 'IMPLIES (car hs) (rp4-implies (cdr hs) concl))))
(define rp4-law '(FORALL gsr_ (IMPLIES (IN gsr_ (CCINT 0 al)) (FORALL gsu_ (IMPLIES (IN gsu_ (CCINT 0 al))
                   (IMPLIES (<= (+ gsr_ gsu_) al) (= (phi (+ gsr_ gsu_)) ((OPR g) (phi gsr_) (phi gsu_)))))))))
(define rp4-hyps (list '(IS-GROUP g) '(IN al RR) '(< 0 al) '(IN phi (FUN (CCINT 0 al) (CARR g))) rp4-law))
(define (rp4-cc! t)
  (let ((iff (dk-cite! 'ccint-membership 0 'al t)))
    (if (not (dk-asm? (cadr iff)))
        (begin (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (rp4-ass!)))))
               (dk-meta-iff-l! iff)))
    (dk-cite! 'fun-apply-type-c 'phi '(CCINT 0 al) '(CARR g) t)))
(define (rp4-false-by! . prems)          ; contradictory linear premises: close the goal
  (dk-have! '(< 1 1) (lambda () (apply dk-ineq! prems)))
  (fact 'rr-one-in)
  (ai (dk-cite! 'rr-lt-irrefl 1)))

;;; ---- the index of the representation is unique ----
(define (rp4-below! a b)                 ; NN a < b: (+ (* a al) al) <= (* b al), with the products real
  (dk-cite! 'nn-lt-succ-le a b)
  (dk-cite! 'nn-succ-plus-one a)
  (dk-rewrite-h! (list '<= (list 'succ a) b) (list 'succ a) (list '+ a 1))
  (dk-real! (list '+ a 1))
  (dk-real! (list '* (list '+ a 1) 'al)) (dk-real! (list '* b 'al)) (dk-real! (list '* a 'al))
  (dk-cite! 'rr-mul-le-right (list '+ a 1) b 'al)
  (dk-have! (list '= (list '* (list '+ a 1) 'al) (list '+ (list '* a 'al) 'al)) (lambda () (crs)))
  (dk-real! (list '+ (list '* a 'al) 'al))
  (dk-rewrite-h! (list '<= (list '* (list '+ a 1) 'al) (list '* b 'al)) (list '* (list '+ a 1) 'al) (list '+ (list '* a 'al) 'al)))
(sp (make-wff (rp4-forall '(al n1 r1 n2 r2)
   (rp4-implies (list '(IN al RR) '(< 0 al) '(IN n1 NN) '(IN n2 NN) '(IN r1 RR) '(<= 0 r1) '(< r1 al) '(IN r2 RR) '(<= 0 r2) '(< r2 al)
                      '(= (+ (* n1 al) r1) (+ (* n2 al) r2)))
     '(AND (= n1 n2) (= r1 r2))))))
(dk-peel!)
(dk-cite! 'nn-in-rr 'n1) (dk-cite! 'nn-in-rr 'n2)
(dk-real! '(* n1 al)) (dk-real! '(* n2 al))
(dk-have! '(<= 0 al) (lambda () (dk-ineq! '(< 0 al))))
(dk-have! '(= n1 n2)
  (lambda ()
    (use-em '(< n1 n2)
      (lambda () (rp4-below! 'n1 'n2)
                 (rp4-false-by! '(<= (+ (* n1 al) al) (* n2 al)) '(= (+ (* n1 al) r1) (+ (* n2 al) r2)) '(< r1 al) '(<= 0 r2)))
      (lambda ()
        (use-em '(< n2 n1)
          (lambda () (rp4-below! 'n2 'n1)
                     (rp4-false-by! '(<= (+ (* n2 al) al) (* n1 al)) '(= (+ (* n1 al) r1) (+ (* n2 al) r2)) '(< r2 al) '(<= 0 r1)))
          (lambda ()
            (dk-cite! 'rr-lt-trichotomy 'n1 'n2)
            (if (dk-only! '(OR (< n1 n2) (OR (= n1 n2) (< n2 n1))) '(NOT (< n1 n2)) '(NOT (< n2 n1))) (prop))))))))
(dk-have! '(= r1 r2)
  (lambda () (dk-rewrite-h! '(= (+ (* n1 al) r1) (+ (* n2 al) r2)) 'n1 'n2)
             (dk-ineq! '(= (+ (* n2 al) r1) (+ (* n2 al) r2)))))
(dk-conj-close! (lambda () (rp4-ass!)))
(qed 'representation-index-unique)
(topic! 'representation-index-unique 'analysis)

;;; ---- every t has a representation ----
(define rp4-rep-law-free '())
(define (rp4-floor! u)                   ; u real, 0 <= u: returns (n r) with n in NN, r = u - n al in [0, al)
  (let* ((n (dk-skolem! (dk-cite! 'rr-nn-floor-mul u 'al))))
    (rp4-split-if! (lambda (h) (dk-contains? h n)))
    (rp4-split-if! (lambda (h) (dk-contains? h n)))
    (dk-cite! 'nn-in-rr n)
    (let ((r (list '- u (list '* n 'al))))
      (dk-real! (list '* n 'al)) (dk-real! r)
      (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '<= (list '* n 'al) u))))
      (dk-have! (list '< r 'al) (lambda () (dk-ineq! (list '< u (list '+ (list '* n 'al) 'al)))))
      (dk-have! (list '<= r 'al) (lambda () (dk-ineq! (list '< r 'al))))
      (list n r))))
(define (rp4-witness! n r neg?)          ; the value y for (n, r): typed; returns y
  (rp4-cc! r)
  (dk-cite! 'gpow-type n 'g rp4-c)
  (dk-cite! 'group-carrier-closed-opr 'g (rp4-pow n) (list 'phi r))
  (let ((v (rp4-op (rp4-pow n) (list 'phi r))))
    (if neg? (begin (dk-cite! 'group-inv-in 'g v) (rp4-inv v)) v)))
(define (rp4-rep-intro! t y n r neg? eqn)  ; land (OPG-REP g al phi t y); EQN: the equation for t (or -t)
  (let ((iff (dk-cite! 'opg-rep 'g 'al 'phi t y)))
    (dk-have! (caddr iff)
      (lambda ()
        (if neg? (oi-r) (oi-l))
        (dk-conj-close!
         (lambda ()
           (cond ((dk-head-is? (dk-goal) 'FORSOME)
                  (if (eq? (cadr (dk-goal)) 'rpn_) (ew n) (ew r))
                  (dk-conj-close!
                   (lambda ()
                     (cond ((dk-head-is? (dk-goal) 'FORSOME)
                            (ew r)
                            (dk-conj-close! (lambda () (cond ((dk-asm? (dk-goal)) (ass))
                                                             ((equal? (dk-goal) eqn) (crs))
                                                             (#t (rp4-ass-rfl!))))))
                           ((dk-asm? (dk-goal)) (ass))
                           (#t (rp4-ass-rfl!))))))
                 ((dk-asm? (dk-goal)) (ass))
                 (#t (rp4-ass-rfl!)))))))
    (dk-meta-iff-l! iff)))
(define (rp4-setup!)
  (fact 'rr-zero-in)
  (dk-have! '(<= 0 al) (lambda () (dk-ineq! '(< 0 al))))
  (dk-have! '(<= al al) (lambda () (dk-ineq!)))
  (rp4-cc! 'al)
  (dk-cite! 'rr-pos-rr-of-lt 'al))
(sp (make-wff (rp4-forall '(g al phi t) (rp4-implies (append rp4-hyps (list '(IN t RR)))
   '(FORSOME y (AND (IN y (CARR g)) (OPG-REP g al phi t y)))))))
(dk-peel!)
(rp4-setup!)
(use-em '(< t 0)
  (lambda ()
    (let ((u '(- 0 t)))
      (dk-real! u)
      (dk-have! (list '<= 0 u) (lambda () (dk-ineq! '(< t 0))))
      (let* ((nr (rp4-floor! u)) (n (car nr)) (r (cadr nr)) (y (rp4-witness! n r #t)))
        (rp4-rep-intro! 't y n r #t (list '= u (list '+ (list '* n 'al) r)))
        (ew y)
        (dk-conj-close! (lambda () (rp4-ass!))))))
  (lambda ()
    (dk-cite! 'rr-lt-trichotomy 't 0)
    (dk-have! '(<= 0 t)
      (lambda () (use-em '(= t 0)
                   (lambda () (dk-ineq! '(= t 0)))
                   (lambda () (dk-have! '(< 0 t) (lambda () (if (dk-only! '(OR (< t 0) (OR (= t 0) (< 0 t))) '(NOT (< t 0)) '(NOT (= t 0))) (prop))))
                              (dk-ineq! '(< 0 t))))))
    (let* ((nr (rp4-floor! 't)) (n (car nr)) (r (cadr nr)) (y (rp4-witness! n r #f)))
      (rp4-rep-intro! 't y n r #f (list '= 't (list '+ (list '* n 'al) r)))
      (ew y)
      (dk-conj-close! (lambda () (rp4-ass!))))))
(qed 'opg-rep-exists)
(topic! 'opg-rep-exists 'analysis)

;;; ---- ... and only one value ----
(define (rp4-open-rep! t y neg?)         ; OPG-REP(t, y) and the side: returns (n r) with the parts landed
  (let* ((iff (dk-cite! 'opg-rep 'g 'al 'phi t y))
         (ors (dk-meta-iff-r! iff))
         (d1 (cadr ors)) (d2 (caddr ors))
         (dd (if neg? d2 d1)) (other (if neg? d1 d2)))
    (dk-have! dd (lambda () (if (dk-only! ors (list 'NOT (cadr other))) (prop))))
    (dk-split-all! (list dd))
    (let* ((n (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'rpn_) (dk-contains? h y))) "the index")))
           (_ (rp4-split-if! (lambda (h) (and (dk-contains? h n) (dk-contains? h y)))))
           (r (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'rpr_) (dk-contains? h n))) "the remainder"))))
      (rp4-split-if! (lambda (h) (dk-contains? h r)))
      (rp4-split-if! (lambda (h) (dk-contains? h r)))
      (rp4-split-if! (lambda (h) (dk-contains? h r)))
      (rp4-split-if! (lambda (h) (dk-contains? h r)))
      (list n r))))
(sp (make-wff (rp4-forall '(g al phi t y1 y2) (rp4-implies (append rp4-hyps (list '(IN t RR) '(OPG-REP g al phi t y1) '(OPG-REP g al phi t y2)))
   '(= y1 y2)))))
(dk-peel!)
(rp4-setup!)
(define (rp4-uniq! neg?)
  (if neg?
      (dk-cite! 'rr-lt-not-le 't 0)
      (begin (dk-cite! 'rr-lt-not-le 't 0) (dk-have! '(NOT (< t 0)) (lambda () (if (dk-only! '(IMPLIES (< t 0) (NOT (<= 0 t))) '(<= 0 t)) (prop))))))
  (let* ((nr1 (rp4-open-rep! 't 'y1 neg?)) (n1 (car nr1)) (r1 (cadr nr1))
         (nr2 (rp4-open-rep! 't 'y2 neg?)) (n2 (car nr2)) (r2 (cadr nr2))
         (lhs (if neg? '(- 0 t) 't)))
    (dk-cite! 'nn-in-rr n1) (dk-cite! 'nn-in-rr n2)
    (dk-real! (list '* n1 'al)) (dk-real! (list '* n2 'al)) (dk-real! lhs)
    (dk-have! (list '= (list '+ (list '* n1 'al) r1) (list '+ (list '* n2 'al) r2))
      (lambda () (dk-ineq! (list '= lhs (list '+ (list '* n1 'al) r1)) (list '= lhs (list '+ (list '* n2 'al) r2)))))
    (dk-split-all! (list (dk-cite! 'representation-index-unique 'al n1 r1 n2 r2)))
    (subst (list '= 'y1 (if neg? (rp4-inv (rp4-op (rp4-pow n1) (list 'phi r1))) (rp4-op (rp4-pow n1) (list 'phi r1)))))
    (subst (list '= 'y2 (if neg? (rp4-inv (rp4-op (rp4-pow n2) (list 'phi r2))) (rp4-op (rp4-pow n2) (list 'phi r2)))))
    (subst (list '= n1 n2))
    (subst (list '= r1 r2))
    (dk-have! (list '<= r2 'al) (lambda () (dk-ineq! (list '< r2 'al))))
    (rp4-cc! r2)
    (dk-cite! 'gpow-type n2 'g rp4-c)
    (dk-cite! 'group-carrier-closed-opr 'g (rp4-pow n2) (list 'phi r2))
    (if neg? (dk-cite! 'group-inv-in 'g (rp4-op (rp4-pow n2) (list 'phi r2))))
    (rp4-ass-rfl!)))
(use-em '(< t 0)
  (lambda () (rp4-uniq! #t))
  (lambda ()
    (dk-cite! 'rr-lt-trichotomy 't 0)
    (dk-have! '(<= 0 t)
      (lambda () (use-em '(= t 0)
                   (lambda () (dk-ineq! '(= t 0)))
                   (lambda () (dk-have! '(< 0 t) (lambda () (if (dk-only! '(OR (< t 0) (OR (= t 0) (< 0 t))) '(NOT (< t 0)) '(NOT (= t 0))) (prop))))
                              (dk-ineq! '(< 0 t))))))
    (rp4-uniq! #f)))
(qed 'opg-rep-unique)
(topic! 'opg-rep-unique 'analysis)

;;; ---- OPG-VAL is that value ----
(define rp4-io '(IOTA rvy_ (AND (IN rvy_ (CARR g)) (OPG-REP g al phi t rvy_))))
(sp (make-wff (rp4-forall '(g al phi t y) (rp4-implies (append rp4-hyps (list '(IN t RR) '(IN y (CARR g)) '(OPG-REP g al phi t y)))
   '(= (OPG-VAL g al phi t) y)))))
(dk-peel!)
(mac 'OPG-VAL)
(dk-each-leaf! (lambda () (iota-d rp4-io))
  (lambda ()
    (if (dk-head-is? (dk-goal) 'FORSOME)
        (begin
          (ew 'y)
          (dk-conj-close!
           (lambda ()
             (cond ((dk-head-is? (dk-goal) 'FORALL)
                    (let ((pl (dk-peel!)))
                      (dk-split-all! (filter (lambda (q) (dk-head-is? q 'AND)) pl))
                      (let ((y2 (caddr (dk-goal))))
                        (dk-cite! 'opg-rep-unique 'g 'al 'phi 't 'y y2)
                        (rp4-ass!))))
                   ((dk-head-is? (dk-goal) 'AND) (dk-conj-close! (lambda () (rp4-ass!))))
                   (#t (rp4-ass!))))))
        (begin
          (dk-split-all! (list (dk-pick (lambda (h) (and (dk-head-is? h 'AND) (dk-contains? h 'IOTA))) "the defining property")))
          (dk-cite! 'opg-rep-unique 'g 'al 'phi 't rp4-io 'y)
          (rp4-ass!)))))
(qed 'opg-val-value)
(topic! 'opg-val-value 'analysis)

(sp (make-wff (rp4-forall '(g al phi t) (rp4-implies (append rp4-hyps (list '(IN t RR)))
   '(AND (IN (OPG-VAL g al phi t) (CARR g)) (OPG-REP g al phi t (OPG-VAL g al phi t)))))))
(dk-peel!)
(let ((y (dk-skolem! (dk-cite! 'opg-rep-exists 'g 'al 'phi 't))))
  (rp4-split-if! (lambda (h) (dk-contains? h y)))
  (dk-cite! 'opg-val-value 'g 'al 'phi 't y)
  (subst (list '= '(OPG-VAL g al phi t) y))
  (dk-conj-close! (lambda () (rp4-ass!))))
(qed 'opg-val-rep)
(topic! 'opg-val-rep 'analysis)
