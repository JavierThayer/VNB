;;; ---- conjugation preserves the cone: z* x z >= 0 for x >= 0 ----
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
  (FORALL z (IMPLIES (IN z (VEC a)) (FORALL x (IMPLIES (IN x (POS-CONE a))
    (IN ((VMUL a) ((VMUL a) ((VSTAR a) z) x) z) (POS-CONE a))))))))))
(dk-peel!)
(gnr-vec-set!)
(let* ((cj (lambda (u) (gnr-mul (gnr-mul (gnr-st 'z) u) 'z)))
       (C (list 'SEP 'gnrw_ '(VEC a) (list 'IN (cj 'gnrw_) gnr-PC)))
       (open! (lambda (u) (let ((m (list 'IN u C))) (sep-me m) (dk-split-all!))))
       (_ (dk-have! (list 'SUBSET C '(VEC a)) (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (open! w) (gnr-ass!)))))
       (ind (dk-cite! 'pos-cone-induct 'a C))
       (i2 (detach-with! ind
             (lambda ()
               (let ((y (dk-di-var!)))
                 (gnr-uvt (gnr-sq y))
                 (in-sep! (lambda () (gnr-ass!))
                   (lambda ()
                     (let ((yz (gnr-mul y 'z)))
                       (gnr-uvt yz) (gnr-uvt (gnr-st 'z)) (gnr-uvt (gnr-st y))
                       (dk-cite! 'pos-cone-star-square 'a yz)
                       (dk-have! (list '= (cj (gnr-sq y)) (gnr-sq yz))
                         (lambda ()
                           (subst (dk-cite! 'kal-uiba-star-mul 'a y 'z))
                           (gnr-uvt (gnr-mul (gnr-st 'z) (gnr-st y)))
                           (subst (dk-cite! 'kal-uiba-mul-assoc 'a (gnr-st 'z) (gnr-st y) yz))
                           (subst (dk-cite! 'kal-uiba-mul-assoc 'a (gnr-st 'z) (gnr-mul (gnr-st y) y) 'z))
                           (subst (dk-cite! 'kal-uiba-mul-assoc 'a (gnr-st y) y 'z))
                           (gnr-uvt (gnr-mul (gnr-st y) yz))
                           (if (gnr-open?) (rfl))))
                       (subst (list '= (cj (gnr-sq y)) (gnr-sq yz)))
                       (gnr-ass!))))))))
       (i3 (detach-with! i2
             (lambda ()
               (let* ((ls (dk-peel!)) (g (dk-goal)) (u (cadr (cadr g))) (v (caddr (cadr g))))
                 (open! u) (open! v)
                 (gnr-uvt (gnr-add u v))
                 (in-sep! (lambda () (gnr-ass!))
                   (lambda ()
                     (gnr-uvt (cj u)) (gnr-uvt (cj v)) (gnr-uvt (gnr-mul (gnr-st 'z) u)) (gnr-uvt (gnr-mul (gnr-st 'z) v))
                     (subst (dk-cite! 'kal-uiba-mul-dist-l 'a (gnr-st 'z) u v))
                     (subst (dk-cite! 'kal-uiba-mul-dist-r 'a (gnr-mul (gnr-st 'z) u) (gnr-mul (gnr-st 'z) v) 'z))
                     (dk-cite! 'pos-cone-add-closed 'a (cj u) (cj v))
                     (gnr-ass!))))))))
  (gnr-cone-open! 'x)
  (dk-apply! i3 'x)
  (open! 'x)
  (gnr-ass!))
(gnr-qed! 'pos-cone-conjugate)
