(dk-have! (list '< (list '(VNRM a) gnr-yl) 1)
  (lambda ()
    (dk-have! (list 'IN gnr-rl '(CARR (SCAL a))) (lambda () (subst (list '= '(CARR (SCAL a)) 'CC)) (gnr-ass!)))
    (subst (dk-cite! 'bcp-u-bal-uba-vnrm-homog 'a gnr-rl 'x))
    (subst (dk-cite! 'rr-magnitude-is-abs gnr-rl))
    (dk-have! (list '<= 0 gnr-rl) (lambda () (dk-ineq! (list '< 0 gnr-rl))))
