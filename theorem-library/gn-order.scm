      (gnr-uvt (gnr-act 'l '(VONE a)))
      (dk-rewrite-h! (dk-rewrite-h! h (gnr-sq c) T) (list '* gnr-s gnr-s) 'l))
    (gnr-ass!)
    (if (gnr-open?) (begin (gnr-cc! 'l) (gnr-uvt (gnr-act 'l '(VONE a))) (rfl)))))
