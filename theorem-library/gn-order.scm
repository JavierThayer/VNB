(gnr-uvt gnr-yl)
(dk-have! (list '= (gnr-st gnr-yl) gnr-yl)
  (lambda ()
    (subst (dk-cite! 'kal-uiba-star-act 'a gnr-rl 'x))
    (subst (dk-cite! 'cc-conjugate-fixes-rr gnr-rl))
    (subst (list '= (gnr-st 'x) 'x))
