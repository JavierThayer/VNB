;;; gn-order.scm -- the positive cone and the order unit (Def. 1.34, Prop. 1.36) of F. J. Thayer, "Banach
;;; Algebras and Applications", ch. 1 s. 4.  Agent BA-1117-GN, wave 2026-11-17.  All proofs modulo 0.
;;; Destination: theorem-library/gn-order.scm, after structure-library/gn-vocab.  Library: operator-algebras.
;;; Helper prefix gnr-.  Binders gnr*_ (gnrz_), used by no other file.
;;;
;;; The cone A+ = POS-CONE(a) is the least subset of VEC(a) containing every y* y and closed under +.
;;; pos-cone-induct is that leastness as a citable principle; the rest follow from it.  1.36: 1 = 1* 1 is
;;; positive, and for x self-adjoint, with m = ||x|| + 1, the element y = m^(-2) x is self-adjoint of norm
;;; < 1, so 1 - y = b^2 with b self-adjoint (uiba-one-minus-sa-square, the tree's square root for norm < 1);
;;; then (m b)* (m b) = m^2 (1 - y) = m^2 1 - x, i.e. x <= m^2 1.  The notes take lambda = ||x|| through
;;; the norm <= 1 square root (1.33, absent); any lambda serves for "order unit".

(define (gnr-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** gn-order: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (if (< (string-length (expression->string a)) 400)
                                              (begin (display "      asm: ") (display (expression->string a)) (newline))))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "gn-order: unfinished" name))))
(define (gnr-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (gnr-ass!) (if (and (gnr-open?) (dk-asm? (dk-goal))) (ass)))
(define (gnr-cite2! . args)
  (let loop ((ch (apply dk-cite! args)))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
(define (gnr-detach-all! f)
  (let loop ((ch f))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
;;; typing in VEC a for a unital involutive a, bottom-up
(define (gnr-uvt x)
  (let ((want (list 'IN x '(VEC a))))
    (cond ((dk-asm? want) x)
          ((equal? x '(VONE a)) (dk-cite! 'ring-one-in-uba-as-ring-uiba-as-uba 'a) x)
          ((equal? x '(VZERO a)) (dk-cite! 'ring-zero-in-uba-as-ring-uiba-as-uba 'a) x)
          ((and (pair? x) (equal? (car x) '(VNEG a)))
           (gnr-uvt (cadr x)) (dk-cite! 'ring-neg-in-carr-uba-as-ring-uiba-as-uba 'a (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(VADD a)))
           (gnr-uvt (cadr x)) (gnr-uvt (caddr x)) (dk-cite! 'ring-add-closed-uba-as-ring-uiba-as-uba 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VMUL a)))
           (gnr-uvt (cadr x)) (gnr-uvt (caddr x)) (dk-cite! 'ring-carrier-closed-mul-uba-as-ring-uiba-as-uba 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT a)))
           (gnr-uvt (caddr x)) (dk-cite! 'bcp-u-bae-act-type 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VSTAR a)))
           (gnr-uvt (cadr x)) (dk-cite! 'bcp-star-fun 'a) (dk-cite! 'fun-apply-type-c '(VSTAR a) '(VEC a) '(VEC a) (cadr x)) x)
          (#t (error "gnr-uvt: cannot type" (expression->string x))))))
(define gnr-B '(UIBA-AS-UBA a))
(define gnr-PC '(POS-CONE a))
(define (gnr-st x) (list '(VSTAR a) x))
(define (gnr-mul x y) (list '(VMUL a) x y))
(define (gnr-add x y) (list '(VADD a) x y))
(define (gnr-act c x) (list '(ACT a) c x))
(define (gnr-sq y) (gnr-mul (gnr-st y) y))

(define (gnr-vec-set!)
  (if (not (dk-asm? '(IN (VEC a) SET)))
      (begin (dk-cite! 'bcs-uiba-is-uba 'a) (dk-cite! 'bcp-ro-vec 'a)
             (dk-rewrite-h! (dk-cite! 'bal-uba-vec-set gnr-B) (list 'VEC gnr-B) '(VEC a)))))
;;; x in POS-CONE(a) in context: land x in VEC a and return the cone clause (FORALL pcc_ ...) at x
(define (gnr-cone-open! x)
  (let* ((un (dk-cite! 'pos-cone-unfold 'a))
         (m (dk-rewrite-h! (list 'IN x gnr-PC) gnr-PC (caddr un)))
         (body (cadddr (caddr un)))
         (cl (subst-free 'pcx_ x body)))
    (dk-project! (list 'IN x '(VEC a)) (lambda () (sep-me m)))
    (dk-project! cl (lambda () (sep-me m)))
    cl))
;;; goal (IN e POS-CONE(a)) with e typed: unfold and leave the clause goal to THUNK
(define (gnr-cone-in! e thunk)
  (gnr-uvt e)
  (subst (dk-cite! 'pos-cone-unfold 'a))
  (in-sep! (lambda () (gnr-ass!)) thunk))

;;; ---- POS-CONE(a) lies in VEC(a) ----
(sp (make-wff '(FORALL a (FORALL x (IMPLIES (IN x (POS-CONE a)) (IN x (VEC a)))))))
(dk-peel!)
(gnr-cone-open! 'x)
(gnr-ass!)
(gnr-qed! 'pos-cone-in-vec)

;;; ---- the generators: y* y is positive ----
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
  (FORALL y (IMPLIES (IN y (VEC a)) (IN ((VMUL a) ((VSTAR a) y) y) (POS-CONE a))))))))
(dk-peel!)
(gnr-cone-in! (gnr-sq 'y)
  (lambda ()
    (dk-peel!)
    (let ((h1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'pcy_))) "the generator clause")))
      (dk-apply! h1 'y)
      (gnr-ass!))))
(gnr-qed! 'pos-cone-star-square)

;;; ---- closed under + ----
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
  (FORALL x (IMPLIES (IN x (POS-CONE a)) (FORALL y (IMPLIES (IN y (POS-CONE a)) (IN ((VADD a) x y) (POS-CONE a))))))))))
(dk-peel!)
(let* ((cx (gnr-cone-open! 'x)) (cy (gnr-cone-open! 'y)))
  (gnr-cone-in! (gnr-add 'x 'y)
    (lambda ()
      (let* ((ls (dk-peel!))
             (c (cadr (car (filter (lambda (h) (and (dk-head-is? h 'IN) (dk-head-is? (caddr h) 'POWER))) ls))))
             (h2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'pcu_))) "the sum clause")))
        (gnr-detach-all! (dk-apply! cx c))
        (gnr-detach-all! (dk-apply! cy c))
        (dk-apply! h2 'x 'y)
        (gnr-ass!)))))
(gnr-qed! 'pos-cone-add-closed)

;;; ---- the leastness of the cone, as an induction principle ----
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
  (FORALL ss (IMPLIES (SUBSET ss (VEC a))
    (IMPLIES (FORALL gnrz_ (IMPLIES (IN gnrz_ (VEC a)) (IN ((VMUL a) ((VSTAR a) gnrz_) gnrz_) ss)))
      (IMPLIES (FORALL gnru_ (IMPLIES (IN gnru_ ss) (FORALL gnrv_ (IMPLIES (IN gnrv_ ss) (IN ((VADD a) gnru_ gnrv_) ss)))))
        (FORALL x (IMPLIES (IN x (POS-CONE a)) (IN x ss)))))))))))
(dk-peel!)
(let ((cl (gnr-cone-open! 'x)))
  (gnr-vec-set!)
  (dk-cite! 'subclass-of-set-is-set 'ss '(VEC a))
  (let ((imp (dk-cite! 'power-mem-intro '(VEC a) 'ss)))
    (dk-have! (cadr imp) (lambda () (let ((z (dk-di-var!))) (dk-cite! 'subset-mem-fwd 'ss '(VEC a) z) (gnr-ass!))))
    (detach! imp))
  (gnr-detach-all! (dk-apply! cl 'ss))
  (gnr-ass!))
(gnr-qed! 'pos-cone-induct)

;;; ---- the unfoldings of SA-PART and SA-SQUARES, as theorems ----
(sp (make-wff '(FORALL a (== (SA-PART a) (SEP bav_ (VEC a) (= ((VSTAR a) bav_) bav_))))))
(di) (mac 'SA-PART) (qrfl)
(gnr-qed! 'sa-part-unfold)
(sp (make-wff '(FORALL a (== (SA-SQUARES a)
  (SEP bav_ (VEC a) (FORSOME baw_ (AND (IN baw_ (SA-PART a)) (= bav_ ((VMUL a) baw_ baw_)))))))))
(di) (mac 'SA-SQUARES) (qrfl)
(gnr-qed! 'sa-squares-unfold)

;;; ---- A+ is contained in A_sa ----
(define gnr-SA '(SA-PART a))
(define gnr-SAS '(SEP bav_ (VEC a) (= ((VSTAR a) bav_) bav_)))
(define (gnr-sa-in! e eq!)               ; goal (IN e SA-PART(a)): EQ! proves e* = e
  (gnr-uvt e)
  (dk-cite! 'sa-part-unfold 'a)
  (subst (list '== gnr-SA gnr-SAS))
  (in-sep! (lambda () (gnr-ass!)) eq!))
(define (gnr-sa-open! x)                 ; (IN x SA-PART(a)) in context: land x in VEC a and x* = x
  (dk-cite! 'sa-part-unfold 'a)
  (let ((m (dk-rewrite-h! (list 'IN x gnr-SA) gnr-SA gnr-SAS)))
    (if (not (and (dk-asm? (list 'IN x '(VEC a))) (dk-asm? (list '= (gnr-st x) x))))
        (begin (sep-me m) (dk-split-all!)))))
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
  (FORALL x (IMPLIES (IN x (POS-CONE a)) (IN x (SA-PART a))))))))
(dk-peel!)
(gnr-cone-open! 'x)
(dk-have! (list 'SUBSET gnr-SA '(VEC a))
  (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (gnr-sa-open! z) (gnr-ass!))))
(let* ((ind (dk-cite! 'pos-cone-induct 'a gnr-SA))
       (i2 (detach-with! ind
             (lambda ()
               (let ((z (dk-di-var!)))
                 (gnr-sa-in! (gnr-sq z)
                   (lambda ()
                     (gnr-uvt (gnr-st z))
                     (subst (dk-cite! 'bcs-uiba-star-mul 'a (gnr-st z) z))
                     (subst (dk-cite! 'bcs-uiba-star-invol 'a z))
                     (if (gnr-open?) (rfl))))))))
       (i3 (detach-with! i2
             (lambda ()
               (let* ((ls (dk-peel!)) (g (dk-goal)) (u (cadr (cadr g))) (v (caddr (cadr g))))
                 (gnr-sa-open! u) (gnr-sa-open! v)
                 (gnr-sa-in! (gnr-add u v)
                   (lambda ()
                     (subst (dk-cite! 'bcs-uiba-star-add 'a u v))
                     (subst (list '= (gnr-st u) u)) (subst (list '= (gnr-st v) v))
                     (if (gnr-open?) (rfl)))))))))
  (dk-apply! i3 'x)
  (gnr-ass!))
(gnr-qed! 'pos-cone-self-adjoint)

;;; ==== PROPOSITION 1.36: 1 is an order unit of A_sa ====================================================
(define (gnr-rsubst! e)                  ; e = (= L R) in context: rewrite R to L in the goal
  (let ((L (cadr e)) (R (caddr e)))
    (dk-have! (list '= R L) (lambda () (subst e) (if (gnr-open?) (rfl))))
    (subst (list '= R L))))
(define (gnr-cc! z)                      ; z in RR in context: land z in CC
  (if (not (dk-asm? (list 'IN z 'CC))) (dk-cite! 'rr-subset-cc z)))

(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (IN (VONE a) (POS-CONE a))))))
(dk-peel!)
(gnr-uvt '(VONE a))
(dk-cite! 'pos-cone-star-square 'a '(VONE a))
(dk-cite! 'kal-uiba-star-one 'a)
(dk-cite! 'kal-uiba-mul-one-l 'a '(VONE a))
(let ((h (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (dk-contains? h 'POS-CONE))) "1* 1 positive")))
  (dk-rewrite-h! (dk-rewrite-h! h (gnr-st '(VONE a)) '(VONE a)) (gnr-mul '(VONE a) '(VONE a)) '(VONE a)))
(gnr-ass!)
(gnr-qed! 'pos-cone-one)

;;; x <= (||x|| + 1)^2 1 for every self-adjoint x
(define gnr-n '((VNRM a) x))
(define gnr-m (list '+ gnr-n 1))
(define gnr-lam (list '* gnr-m gnr-m))
(define gnr-r (list 'recip gnr-lam))
(define gnr-y (gnr-act gnr-r 'x))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
  (list 'FORALL 'x (list 'IMPLIES '(IN x (SA-PART a)) (list 'ALE 'a 'x (gnr-act gnr-lam '(VONE a)))))))))
(dk-peel!)
(gnr-sa-open! 'x)
(dk-cite! 'bcp-u-bae-vnrm-type 'a 'x)
(dk-cite! 'bcp-u-bal-uba-vnrm-nonneg 'a 'x)
(dk-cite! 'bcs-uiba-scal-carr 'a)
(dk-real! gnr-m) (dk-real! gnr-lam)
(dk-have! (list '< 0 gnr-m) (lambda () (dk-ineq! (list '<= 0 gnr-n))))
(dk-have! (list '< 0 gnr-lam) (lambda () (gnr-cite2! 'rr-mul-pos gnr-m gnr-m) (gnr-ass!)))
(gnr-cite2! 'rr-pos-ne-zero gnr-lam)
(gnr-cite2! 'rr-recip-closed gnr-lam)
(gnr-cite2! 'rr-recip-inverse gnr-lam)
(gnr-cite2! 'rr-recip-pos gnr-lam)
(for-each gnr-cc! (list gnr-m gnr-lam gnr-r))
(gnr-uvt gnr-y)
;; y is self-adjoint of norm < 1
(dk-have! (list '= (gnr-st gnr-y) gnr-y)
  (lambda ()
    (subst (dk-cite! 'kal-uiba-star-act 'a gnr-r 'x))
    (subst (dk-cite! 'cc-conjugate-fixes-rr gnr-r))
    (subst (list '= (gnr-st 'x) 'x))
    (if (gnr-open?) (rfl))))
(dk-have! (list '< (list '(VNRM a) gnr-y) 1)
  (lambda ()
    (dk-have! (list 'IN gnr-r '(CARR (SCAL a))) (lambda () (subst (list '= '(CARR (SCAL a)) 'CC)) (gnr-ass!)))
    (subst (dk-cite! 'bcp-u-bal-uba-vnrm-homog 'a gnr-r 'x))
    (subst (dk-cite! 'rr-magnitude-is-abs gnr-r))
    (dk-have! (list '<= 0 gnr-r) (lambda () (dk-ineq! (list '< 0 gnr-r))))
    (subst (dk-cite! 'rr-abs-of-nonneg gnr-r))
    (dk-real! (list '+ (list '* gnr-n gnr-n) (list '+ gnr-n 1)))
    (dk-have! (list '< 0 (list '+ (list '* gnr-n gnr-n) (list '+ gnr-n 1))) (lambda () (dk-cite! 'rr-sq-nonneg gnr-n) (dk-real! (list '* gnr-n gnr-n)) (dk-ineq! (list '<= 0 gnr-n) (list '<= 0 (list '* gnr-n gnr-n)) (list 'IN (list '* gnr-n gnr-n) 'RR))))
    (gnr-cite2! 'rr-mul-pos gnr-r (list '+ (list '* gnr-n gnr-n) (list '+ gnr-n 1)))
    (let* ((r gnr-r) (n gnr-n) (rnn (list '* r (list '* n n))) (rn (list '* r n))
           (ea (list '= (list '* gnr-lam r) (list '+ rnn (list '+ (list '* 2 rn) r))))
           (eb (list '= (list '* r (list '+ (list '* n n) (list '+ n 1))) (list '+ rnn (list '+ rn r))))
           (ec (list '= (list '* r n) rn)))
      (dk-real! rnn) (dk-real! rn)
      (dk-have! ea (lambda () (crs)))
      (dk-have! eb (lambda () (crs)))
      (let* ((h1 (dk-rewrite-h! (list '= (list '* gnr-lam r) 1) (list '* gnr-lam r) (caddr ea)))
             (h2 (dk-rewrite-h! (list '< 0 (cadr eb)) (cadr eb) (caddr eb))))
        (dk-ineq! h1 h2 (list 'IN rnn 'RR) (list 'IN rn 'RR) (list 'IN r 'RR))))))
;; 1 - y = b^2, b self-adjoint
(let* ((ex (gnr-cite2! 'uiba-one-minus-sa-square 'a gnr-y))
       (b (dk-skolem! ex))
       (_ (dk-split-all!))
       (c (gnr-act gnr-m b))
       (T (gnr-add (gnr-act gnr-lam '(VONE a)) (list '(VNEG a) 'x))))
  (gnr-uvt c) (gnr-uvt (gnr-mul b b)) (gnr-uvt '(VONE a)) (gnr-uvt (list '(VNEG a) gnr-y))
  (dk-cite! 'pos-cone-star-square 'a c)
  (dk-have! (list '= (gnr-sq c) T)
    (lambda ()
      (subst (dk-cite! 'kal-uiba-star-act 'a gnr-m b))
      (subst (dk-cite! 'cc-conjugate-fixes-rr gnr-m))
      (subst (list '= (gnr-st b) b))
      (subst (dk-cite! 'kal-uiba-mul-act-l 'a gnr-m b c))
      (subst (dk-cite! 'kal-uiba-mul-act-r 'a gnr-m b b))
      (gnr-rsubst! (dk-cite! 'kal-uiba-act-mul 'a gnr-m gnr-m (gnr-mul b b)))
      (subst (dk-pick (lambda (h) (and (dk-head-is? h '=) (equal? (cadr h) (gnr-mul b b)))) "b b = 1 - y"))
      (subst (dk-cite! 'kal-uiba-act-vadd 'a gnr-lam '(VONE a) (list '(VNEG a) gnr-y)))
      (let* ((ey (dk-cite! 'kal-uiba-vneg-act 'a gnr-y))
             (m1 (cadr (caddr ey))))
        (subst ey)
        (subst (dk-cite! 'kal-uiba-vneg-act 'a 'x))
        (dk-have! (list 'IN m1 'CC) (lambda () (arith)))
        (dk-real! (list '* gnr-lam m1)) (gnr-cc! (list '* gnr-lam m1))
        (gnr-rsubst! (dk-cite! 'kal-uiba-act-mul 'a gnr-lam m1 gnr-y))
        (gnr-rsubst! (dk-cite! 'kal-uiba-act-mul 'a (list '* gnr-lam m1) gnr-r 'x))
        (dk-have! (list '= (list '* (list '* gnr-lam m1) gnr-r) m1)
          (lambda ()
            (let ((lhs (list '* (list '* gnr-lam m1) gnr-r)) (k (list '* m1 (list '* gnr-lam gnr-r))))
              (dk-have! (list '= lhs k) (lambda () (crs)))
              (subst (list '= lhs k))
              (subst (list '= (list '* gnr-lam gnr-r) 1))
              (if (gnr-open?) (crs)))))
        (subst (list '= (list '* (list '* gnr-lam m1) gnr-r) m1))
        (gnr-uvt (gnr-add (gnr-act gnr-lam '(VONE a)) (gnr-act m1 'x)))
        (if (gnr-open?) (rfl)))))
  (mac 'ALE)
  (let ((h (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (dk-contains? h 'POS-CONE) (dk-contains? h b))) "c* c positive")))
    (dk-rewrite-h! h (gnr-sq c) T))
  (gnr-ass!))
(gnr-qed! 'order-unit)

;;; the existential form of 1.36
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
  (FORALL x (IMPLIES (IN x (SA-PART a)) (FORSOME gnrl_ (AND (IN gnrl_ RR) (ALE a x ((ACT a) gnrl_ (VONE a)))))))))))
(dk-peel!)
(gnr-sa-open! 'x)
(dk-cite! 'bcp-u-bae-vnrm-type 'a 'x)
(dk-real! gnr-m) (dk-real! gnr-lam)
(dk-cite! 'order-unit 'a 'x)
(ew gnr-lam)
(dk-conj-close! (lambda () (gnr-ass!)))
(gnr-qed! 'order-unit-exists)

;;; x <= l 1 for every self-adjoint x and every real l > ||x||  (the form the notes' proofs use: with
;;; l = ||x|| + e for every e > 0 it gives the notes' x <= ||x|| 1 in every inequality closed under limits)
(define gnr-l 'l)
(define gnr-s '(sqrt l))
(define gnr-rl '(recip l))
(define gnr-yl (gnr-act gnr-rl 'x))
;;; the chain: with b b = 1 + (-y), y = r x, b* = b, s real, (s s) r = 1: (s b)* (s b) = (s s) 1 + (-x)
(define (gnr-chain! s r y b)
  (let* ((lam (list '* s s)) (c (gnr-act s b)) (T (gnr-add (gnr-act lam '(VONE a)) (list '(VNEG a) 'x))))
    (dk-real! lam) (gnr-cc! lam) (gnr-uvt (gnr-act lam '(VONE a)))
    (dk-have! (list '= (gnr-sq c) T)
      (lambda ()
        (subst (dk-cite! 'kal-uiba-star-act 'a s b))
        (subst (dk-cite! 'cc-conjugate-fixes-rr s))
        (subst (list '= (gnr-st b) b))
        (subst (dk-cite! 'kal-uiba-mul-act-l 'a s b c))
        (subst (dk-cite! 'kal-uiba-mul-act-r 'a s b b))
        (gnr-rsubst! (dk-cite! 'kal-uiba-act-mul 'a s s (gnr-mul b b)))
        (subst (dk-pick (lambda (h) (and (dk-head-is? h '=) (equal? (cadr h) (gnr-mul b b)))) "b b = 1 - y"))
        (subst (dk-cite! 'kal-uiba-act-vadd 'a lam '(VONE a) (list '(VNEG a) y)))
        (let* ((ey (dk-cite! 'kal-uiba-vneg-act 'a y))
               (m1 (cadr (caddr ey))))
          (subst ey)
          (subst (dk-cite! 'kal-uiba-vneg-act 'a 'x))
          (dk-have! (list 'IN m1 'CC) (lambda () (arith)))
          (dk-real! (list '* lam m1)) (gnr-cc! (list '* lam m1))
          (gnr-rsubst! (dk-cite! 'kal-uiba-act-mul 'a lam m1 y))
          (gnr-rsubst! (dk-cite! 'kal-uiba-act-mul 'a (list '* lam m1) r 'x))
          (dk-have! (list '= (list '* (list '* lam m1) r) m1)
            (lambda ()
              (let ((lhs (list '* (list '* lam m1) r)) (k (list '* m1 (list '* lam r))))
                (dk-have! (list '= lhs k) (lambda () (crs)))
                (subst (list '= lhs k))
                (subst (list '= (list '* lam r) 1))
                (if (gnr-open?) (crs)))))
          (subst (list '= (list '* (list '* lam m1) r) m1))
          (gnr-uvt (gnr-add (gnr-act lam '(VONE a)) (gnr-act m1 'x)))
          (if (gnr-open?) (rfl)))))
    T))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
  (list 'FORALL 'x (list 'IMPLIES '(IN x (SA-PART a))
    (list 'FORALL 'l (list 'IMPLIES '(IN l RR) (list 'IMPLIES (list '< gnr-n 'l) (list 'ALE 'a 'x (gnr-act 'l '(VONE a))))))))))))
(dk-peel!)
