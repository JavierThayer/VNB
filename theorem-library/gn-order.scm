    (let* ((d (list '- 'l gnr-n)) (rn (list '* gnr-rl gnr-n))
           (e (list '= (list '* gnr-rl d) (list '- (list '* 'l gnr-rl) rn))))
      (dk-real! d) (dk-real! rn)
      (dk-have! (list '< 0 d) (lambda () (dk-ineq! (list '< gnr-n 'l))))
