(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC)
  (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'a (list 'IMPLIES (ca5-cfn 'a)
    (ca5-cfn (ca5-fscale 'c 'a))))))))))
(dk-peel!)
(ca5-u-set! 'u)
(ca5-cfn-parts! 'u 'a)
(let ((h (ca5-fscale 'c 'a)))
  (ca5-lam-fun! 'u h
    (lambda (z)
      (fact 'fun-apply-type-c 'a 'u 'CC z)
      (ca5-and! '(IN c CC) (list 'IN (list 'a z) 'CC))
      (fact 'cc-mul-closed 'c (list 'a z))))
  (ca5-lam-val! 'u h (lambda (x) (list '* 'c (list 'a x))))
  (dk-cite! 'aif-cont-scale 'u 'c 'a h)
  (ca5-cfn-in! 'u h)
  (ass))
(qed 'cc-cont-fns-scale)
