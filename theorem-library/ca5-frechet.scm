;; (IN a (CC-CONT-FNS u)) in context: land (IN a (FUN u CC)) and its continuity clause
(define (ca5-cfn-parts! uu a)
  (let* ((iff (dk-cite! 'cc-cont-fns-membership uu a))
         (rhs (caddr iff)))
    (if (not (dk-asm? rhs)) (dk-have! rhs (lambda () (prop))))
    (dk-split-all! (list rhs))))
;; land (IN h (CC-CONT-FNS u)) from its two parts in context (up to alpha)
(define (ca5-cfn-in! uu h)
  (let* ((iff (dk-cite! 'cc-cont-fns-membership uu h))
         (rhs (caddr iff)))
    (dk-have! rhs (lambda () (dk-conj-close! (lambda () (ass)))))
    (dk-have! (list 'IN h (list 'CC-CONT-FNS uu)) (lambda () (prop)))))
(define (ca5-u-set! uu)
  (if (not (dk-asm? (list 'IN uu 'SET)))
      (dk-have! (list 'IN uu 'SET)
        (lambda () (fact 'cc-is-set) (fact 'subclass-of-set-is-set uu 'CC) (ass)))))
;; h = (VNB-LAMBDA cfz_ u BODY): type it in FUN(u, CC); TYPER is run with the point z in context
(define (ca5-lam-fun! uu h typer)
  (dk-have! (list 'IN h (list 'FUN uu 'CC))
    (lambda ()
      (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (typer z) (ass)))))))
;; forall aix_ in u. h(aix_) == RHS(aix_), by beta
(define (ca5-lam-val! uu h rhs)
  (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ uu) (list '== (list h 'aix_) (rhs 'aix_))))
    (lambda ()
      (let ((x (dk-di-var!)))
        (if (not (dk-lam-b!)) (qrfl))))))

(define ca5-fz '(VNB-LAMBDA cfz_ u 0))
(define (ca5-fsum a b) (list 'VNB-LAMBDA 'cfz_ 'u (list '+ (list a 'cfz_) (list b 'cfz_))))
(define (ca5-fneg a) (list 'VNB-LAMBDA 'cfz_ 'u (list '- (list a 'cfz_))))
(define (ca5-fscale c a) (list 'VNB-LAMBDA 'cfz_ 'u (list '* c (list a 'cfz_))))
(define (ca5-cfn x) (list 'IN x '(CC-CONT-FNS u)))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC)
  (list 'FORALL 'a (list 'IMPLIES (ca5-cfn 'a) '(IN a (FUN u CC))))))))
(dk-peel!)
(let ((rhs (caddr (dk-cite! 'cc-cont-fns-membership 'u 'a))))
