                                (dk-have! (list 'FORALL 'ky_ (list 'IMPLIES (list 'IN 'ky_ kk) (list '<= (list 'magnitude (list d 'ky_)) he)))
                                  (lambda ()
                                    (let ((y (dk-di-var!)))
                                      (fact 'subset-mem-fwd kk 'u y)
                                      (fact 'fun-apply-type-c si 'u 'CC y) (fact 'fun-apply-type-c lim 'u 'CC y)
                                      (dk-lam-b!)
                                      (ca5-unchoice! sq lim y)
                                      (dk-apply! tl i y)
