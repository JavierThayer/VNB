;;; a function on u that is a uniform limit of members of C(u) on a ball about z0 is continuous at z0
(define ca5-ball '(BALL CC-MS z0 rho))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC)
  (list 'FORALL 's (list 'IMPLIES ca5-seqV
  (list 'FORALL 'g (list 'IMPLIES '(IN g (FUN u CC))
  (list 'FORALL 'z0 (list 'IMPLIES '(IN z0 u)
  (list 'FORALL 'rho (list 'IMPLIES '(IN rho RR) (list 'IMPLIES '(< 0 rho) (list 'IMPLIES (list 'SUBSET ca5-ball 'u)
    (list 'IMPLIES (ca5-unif-to 'g ca5-ball)
      (list 'IS-CONTINUOUS-AT (ca5-sub 'u) ca5-nfm 'g 'z0))))))))))))))))
(dk-peel!)
(ca5-u-set! 'u)
(ca5-nfm! 'u)
(fact 'cc-is-metric-space)
