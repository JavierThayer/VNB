    (ew cap)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal))
            (ass)
            (let* ((lk (dk-peel!))
                   (nns (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk)))
                   (gdiff (cadr (cadr (dk-goal))))
                   (i (cadr (car (cadr gdiff)))) (j (cadr (car (caddr gdiff))))
                   (z (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'CC-EXHAUST))) lk))))
                   (si (list 's i)) (sj (list 's j))
                   (tl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f cap) (dk-contains? f epsv))) "the tail")))
              (fact 'fun-apply-type-c 's 'NN ca5-V i)
              (fact 'fun-apply-type-c 's 'NN ca5-V j)
              (ca5-and! (list 'IN i 'NN) (list '<= cap i))
              (ca5-and! (list 'IN j 'NN) (list '<= cap j))
              (let* ((h (dk-apply! tl i j)))
                (dk-cite! 'cc-fn-module-seminorm-of-difference 'u si sj kv)
                (dk-rewrite-h! h (ca5-famdiff kv si sj) (list 'CC-SUP-NORM (ca5-fdiff si sj) (list 'CC-EXHAUST 'u kv)))
                (dk-cite! 'cc-exhaust-subset 'u kv)
                (dk-cite! 'cc-cont-fns-fun 'u si)
                (dk-cite! 'cc-cont-fns-fun 'u sj)
                (let ((d (ca5-fdiff si sj)) (kk (list 'CC-EXHAUST 'u kv)))
                  (dk-have! (list 'FORALL 'ky_ (list 'IMPLIES (list 'IN 'ky_ kk) (list 'IN (list d 'ky_) 'CC)))
                    (lambda ()
                      (let ((y (dk-di-var!)))
                        (fact 'subset-mem-fwd kk 'u y)
                        (fact 'fun-apply-type-c si 'u 'CC y) (fact 'fun-apply-type-c sj 'u 'CC y)
                        (dk-lam-b!)
                        (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                            (begin (ca5-cc! (cadr (dk-goal))) (ass))))))
                  (dk-cite! 'cc-sup-norm-upper d kk z)
                  (fact 'subset-mem-fwd kk 'u z)
                  (fact 'fun-apply-type-c si 'u 'CC z) (fact 'fun-apply-type-c sj 'u 'CC z)
                  (dk-have! (list '= (list d z) (list '- (list si z) (list sj z))) (lambda () (if (not (dk-lam-b!)) (rfl))))
                  (dk-rewrite-h! (list '<= (list 'magnitude (list d z)) (list 'CC-SUP-NORM d kk)) (list d z) (list '- (list si z) (list sj z)))
                  (ca5-mag! (list '- (list si z) (list sj z)))
                  (fact 'rr-pos-rr-in-rr epsv)
                  (dk-cite! 'cc-cont-fns-diff 'u si sj)
                  (ca5-cfn-parts! 'u d)
                  (dk-split-all! (list (dk-cite! 'cc-exhaust-seminorm-real 'u d kv)))
                  (dk-ineq! (list '<= (list 'magnitude (list '- (list si z) (list sj z))) (list 'CC-SUP-NORM d kk))
                            (list '< (list 'CC-SUP-NORM d kk) epsv))))))))))
