                         (epsv (cadr (car (filter (dk-head? 'POS-RR) lk2))))
                         (he (list '* 1/2 epsv)))
                    (fact 'rr-pos-rr-in-rr epsv) (fact 'rr-lt-of-pos-rr epsv)
                    (ca5-rr! he)
                    (dk-have! (list '< 0 he) (lambda () (dk-ineq! (list '< 0 epsv))))
                    (dk-cite! 'rr-pos-rr-of-lt he)
                    (let* ((on (dk-apply! unifk kv))
                           (cap (dk-skolem! (dk-apply! on he))))
                      (dk-split-all!)
                      (ew cap)
                      (dk-conj-close!
                        (lambda ()
                          (if (dk-asm? (dk-goal))
                              (ass)
                              (let* ((lk3 (begin (dk-peel!) (dk-split-all!)))
                                     (gd (dk-goal))
                                     (i (cadr (cadr (cadr (cadr gd)))))      ; ((FAM k) ((VADD M) (sq i) ...))
                                     (si (list sq i))
                                     (kk (list 'CC-EXHAUST 'u kv))
