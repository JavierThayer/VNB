   (SEP ccf_ (FUN u CC)
     (FORALL ccy_ (IMPLIES (IN ccy_ u)
       (IS-CONTINUOUS-AT (SUBSPACE-MS (NF-METRIC-SPACE CC-NORMED-FIELD) u)
                         (NF-METRIC-SPACE CC-NORMED-FIELD) ccf_ ccy_))))))))
