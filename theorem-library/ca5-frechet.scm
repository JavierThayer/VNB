            (dk-have! (list 'FORALL 'cekn_ (list 'IMPLIES '(IN cekn_ NN) (list 'IMPLIES (list '<= cap 'cekn_)
                         (list '<= (list 'magnitude (list '- (list t 'cekn_) siz)) epsv))))
              (lambda ()
