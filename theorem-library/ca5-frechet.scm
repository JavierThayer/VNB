(define ca5-ut (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'BALL) (dk-contains? f 'magnitude))) "uniform on the ball"))
(let* ((ciff (dk-cite! 'is-continuous-at (ca5-sub 'u) ca5-nfm 'g 'z0))
       (rhs (caddr ciff)))
  (dk-have! rhs
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-asm? g) (ass))
              ((and (dk-head-is? g 'IN) (dk-head-is? (caddr g) 'FUN))
               (subst (list '== (list 'PTS (ca5-sub 'u)) 'u))
               (subst (list '== (list 'PTS ca5-nfm) 'CC))
               (ass))
              ((dk-head-is? g 'IN) (subst (list '== (list 'PTS (ca5-sub 'u)) 'u)) (ass))
              (#t
               (let* ((lk (dk-peel!))
                      (epsv (cadr (car (filter (dk-head? 'POS-RR) lk))))
                      (e3 (list '* 1/3 epsv)))
                 (fact 'rr-pos-rr-in-rr epsv) (fact 'rr-lt-of-pos-rr epsv)
                 (ca5-rr! e3)
                 (dk-have! (list '< 0 e3) (lambda () (dk-ineq! (list '< 0 epsv))))
                 (dk-cite! 'rr-pos-rr-of-lt e3)
                 (let* ((nb (dk-skolem! (dk-apply! ca5-ut e3))))
                   (dk-split-all!)
                   (let* ((tl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nb) (dk-contains? f e3))) "the tail"))
                          (sn (list 's nb)))
                     (fact 'fun-apply-type-c 's 'NN ca5-V nb)
                     (ca5-cfn-parts! 'u sn)
                     (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f sn) (dk-contains? f 'IS-CONTINUOUS-AT))) "s_N continuous") 'z0)
                     (let* ((c2 (dk-cite! 'is-continuous-at (ca5-sub 'u) ca5-nfm sn 'z0))
                            (cev (let loop ((x (caddr c2))) (if (eq? (car x) 'AND) (loop (caddr x)) x))))
                       (dk-have! cev (lambda () (dk-only! c2 (list 'IS-CONTINUOUS-AT (ca5-sub 'u) ca5-nfm sn 'z0)) (prop)))
                       (let* ((d1 (dk-skolem! (dk-apply! cev e3))))
                         (dk-split-all!)
                         (fact 'rr-pos-rr-in-rr d1) (fact 'rr-lt-of-pos-rr d1)
                         (let* ((cb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d1))) "the delta clause"))
                                (hr (list '* 1/2 'rho)))
                           (ca5-rr! hr)
                           (dk-have! (list '< 0 hr) (lambda () (dk-ineq! '(< 0 rho))))
                           (let* ((w (dk-skolem! (dk-cite! 'rr-min-pos d1 hr))))
                             (dk-split-all!)
                             (dk-cite! 'rr-pos-rr-of-lt w)
                             (ew w)
                             (dk-conj-close!
                               (lambda ()
                                 (if (dk-asm? (dk-goal))
                                     (ass)
                                     (let* ((lb (dk-peel!))
                                            (b (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (eq? (car (caddr f)) 'PTS))) lb))))
                                            (gz (list 'g 'z0)) (gb (list 'g b)) (sz (list sn 'z0)) (sb (list sn b)))
                                       (dk-have! (list 'IN b 'u) (lambda () (subst (list '== 'u (list 'PTS (ca5-sub 'u)))) (ass)))
                                       (fact 'subset-mem-fwd 'u 'CC b)
                                       (fact 'subspace-dist ca5-nfm 'u 'z0 b)
                                       (ca5-nfm-dist! 'z0 b)
                                       (ca5-mag! (list '- 'z0 b)) (ca5-mag! (list '- b 'z0))
                                       (dk-rewrite-h! (list '<= (list (list 'DIST (ca5-sub 'u)) 'z0 b) w)
                                                      (list (list 'DIST (ca5-sub 'u)) 'z0 b) (list (list 'DIST ca5-nfm) 'z0 b))
                                       (dk-rewrite-h! (list '<= (list (list 'DIST ca5-nfm) 'z0 b) w)
                                                      (list (list 'DIST ca5-nfm) 'z0 b) (list 'magnitude (list '- 'z0 b)))
                                       ;; b is in the ball, and close to z0 for s_N
                                       (dk-cite! 'cc-magnitude-sub-sym b 'z0)
                                       (dk-have! (list '< (list 'magnitude (list '- b 'z0)) 'rho)
                                         (lambda () (dk-ineq! (list '<= (list 'magnitude (list '- 'z0 b)) w) (list '<= w hr)
                                                              (list '= (list 'magnitude (list '- b 'z0)) (list 'magnitude (list '- 'z0 b))) '(< 0 rho))))
                                       (ca5-in-ball! b 'z0 'rho)
                                       (dk-cite! 'cc-ms-ball-centre 'z0 'rho)
                                       (dk-have! (list '<= (list (list 'DIST (ca5-sub 'u)) 'z0 b) d1)
                                         (lambda ()
                                           (subst (list '== (list (list 'DIST (ca5-sub 'u)) 'z0 b) (list (list 'DIST ca5-nfm) 'z0 b)))
                                           (subst (list '= (list (list 'DIST ca5-nfm) 'z0 b) (list 'magnitude (list '- 'z0 b))))
                                           (dk-ineq! (list '<= (list 'magnitude (list '- 'z0 b)) w) (list '<= w d1))))
                                       (dk-apply! cb b)
                                       (fact 'fun-apply-type-c (list 's nb) 'u 'CC 'z0) (fact 'fun-apply-type-c (list 's nb) 'u 'CC b)
                                       (fact 'fun-apply-type-c 'g 'u 'CC 'z0) (fact 'fun-apply-type-c 'g 'u 'CC b)
                                       (ca5-nfm-dist! sz sb)
                                       (dk-rewrite-h! (list '<= (list (list 'DIST ca5-nfm) sz sb) e3)
                                                      (list (list 'DIST ca5-nfm) sz sb) (list 'magnitude (list '- sz sb)))
                                       ;; the uniform estimate at z0 and at b
                                       (fact 'nn-le-refl nb)
                                       (let ((tz (dk-apply! tl nb)))
                                         (dk-apply! tz 'z0)
                                         (dk-apply! tz b))
                                       (ca5-nfm-dist! gz gb)
                                       (subst (list '= (list (list 'DIST ca5-nfm) gz gb) (list 'magnitude (list '- gz gb))))
                                       (dk-cite! 'cc-magnitude-sub-chain gz sz gb)
                                       (dk-cite! 'cc-magnitude-sub-chain sz sb gb)
                                       (dk-cite! 'cc-magnitude-sub-sym gz sz)
                                       (for-each ca5-mag! (list (list '- gz sz) (list '- sz gz) (list '- sz gb) (list '- sb gb) (list '- sz sb)))
                                       (dk-ineq! (list '<= (list 'magnitude (list '- gz gb)) (list '+ (list 'magnitude (list '- gz sz)) (list 'magnitude (list '- sz gb))))
                                                 (list '<= (list 'magnitude (list '- sz gb)) (list '+ (list 'magnitude (list '- sz sb)) (list 'magnitude (list '- sb gb))))
                                                 (list '= (list 'magnitude (list '- gz sz)) (list 'magnitude (list '- sz gz)))
                                                 (list '<= (list 'magnitude (list '- sz gz)) e3)
                                                 (list '<= (list 'magnitude (list '- sb gb)) e3)
                                                 (list '<= (list 'magnitude (list '- sz sb)) e3))))))))))))))))))))
  (dk-only! ciff rhs)
  (prop))
