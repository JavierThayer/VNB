                                     (tl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f cap) (dk-contains? f he))) "the tail")))
                                (fact 'fun-apply-type-c sq 'NN ca5-V i)
                                (dk-cite! 'cc-fn-module-seminorm-of-difference 'u si lim kv)
                                (subst (list '== (ca5-famdiff kv si lim) (list 'CC-SUP-NORM d kk)))
                                (dk-cite! 'cc-exhaust-subset 'u kv)
                                (dk-cite! 'cc-cont-fns-fun 'u si)
                                (dk-cite! 'cc-cont-fns-fun 'u lim)
                                (dk-have! (list 'FORALL 'ky_ (list 'IMPLIES (list 'IN 'ky_ kk) (list 'IN (list d 'ky_) 'CC)))
                                  (lambda ()
