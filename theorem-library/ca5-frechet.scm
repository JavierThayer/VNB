;;; (15) the module laws of CC-FN-MODULE(u, C(u)), in applied form
;;; ======================================================================
(define ca5-V '(CC-CONT-FNS u))
(define ca5-opadd (list 'VNB-LAMBDA '(LIST cfa_ cfb_) (list 'CARTESIAN ca5-V ca5-V)
                     '(VNB-LAMBDA cfz_ u (+ (cfa_ cfz_) (cfb_ cfz_)))))
(define ca5-opzero '(VNB-LAMBDA cfz_ u 0))
(define ca5-opneg (list 'VNB-LAMBDA 'cfa_ ca5-V '(VNB-LAMBDA cfz_ u (- (cfa_ cfz_)))))
(define ca5-opact (list 'VNB-LAMBDA '(LIST cfc_ cfa_) (list 'CARTESIAN 'CC ca5-V)
                     '(VNB-LAMBDA cfz_ u (* cfc_ (cfa_ cfz_)))))
(define ca5-SADD '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (+ x_ y_)))
(define ca5-SMUL '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (* x_ y_)))
(define (ca5-va a b) (list ca5-opadd a b))
(define (ca5-vt r a) (list ca5-opact r a))
(define (ca5-vn a) (list ca5-opneg a))

(define (ca5-redex? t)
  (and (pair? t)
       (or (and (pair? (car t)) (eq? (caar t) 'VNB-LAMBDA))
           (let loop ((xs t)) (and (pair? xs) (or (ca5-redex? (car xs)) (loop (cdr xs))))))))
(define (ca5-beta!)
  (let ((leaf (proof-state-focus *ps*)))
    (if (ca5-redex? (dk-goal)) (dk-lam-b!))
    (sequent-node-grounded? leaf)))
;; type a body built from the base functions at the point z (their values landed first)
(define (ca5-base-at! vecs z)
  (for-each (lambda (a) (fact 'fun-apply-type-c a 'u 'CC z)) vecs))
;; L a VNB-LAMBDA over u: its FUN(u, CC) typing by lam-t, beta and the planner
(define (ca5-lam-typer vecs)
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((z (dk-di-var!)))
          (ca5-base-at! vecs z)
          (ca5-beta!)
          (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
              (begin (ca5-cc! (cadr (dk-goal))) (ass))))))))

(define (ca5-law! name vecs scals closures lhs rhs)
  (sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC)
    (let loop ((vs vecs))
      (if (null? vs)
          (let loop2 ((ss scals))
            (if (null? ss) (list '= lhs rhs)
                (list 'FORALL (car ss) (list 'IMPLIES (list 'IN (car ss) 'CC) (loop2 (cdr ss))))))
          (list 'FORALL (car vs) (list 'IMPLIES (list 'IN (car vs) ca5-V) (loop (cdr vs))))))))))
  (dk-peel!)
  (ca5-u-set! 'u)
  (for-each (lambda (a) (dk-cite! 'cc-cont-fns-fun 'u a)) vecs)
  (for-each (lambda (th) (th)) closures)
  (ca5-beta!)
  (if (not (proof-done? *ps*))
      (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
        (dk-fun-ext! l r 'u 'CC
          (if (symbol? l) #f (ca5-lam-typer vecs))
          (if (symbol? r) #f (ca5-lam-typer vecs))
          (lambda (w)
            (ca5-base-at! vecs w)
            (if (not (ca5-beta!))
                (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (crs)))))))
  (if (not (proof-done? *ps*)) (error "ca5-law!: did not close" name (dk-goal)))
  (qed name)
  (topic! name 'analysis))

(define (ca5-sum-in! a b) (lambda () (dk-cite! 'cc-cont-fns-add 'u a b)))
(define (ca5-scale-in! c a) (lambda () (dk-cite! 'cc-cont-fns-scale 'u c a)))
(define (ca5-neg-in! a) (lambda () (dk-cite! 'cc-cont-fns-neg 'u a)))
(define (ca5-zero-in!) (lambda () (dk-cite! 'cc-cont-fns-zero 'u)))
(define (ca5-ccop! op r s) (lambda () (ca5-and! (list 'IN r 'CC) (list 'IN s 'CC))
                                     (fact (if (eq? op '+) 'cc-add-closed 'cc-mul-closed) r s)))

(ca5-law! 'cc-fn-vadd-assoc '(a b c) '() (list (ca5-sum-in! 'a 'b) (ca5-sum-in! 'b 'c))
  (ca5-va (ca5-va 'a 'b) 'c) (ca5-va 'a (ca5-va 'b 'c)))
(ca5-law! 'cc-fn-vadd-comm '(a b) '() '()
  (ca5-va 'a 'b) (ca5-va 'b 'a))
(ca5-law! 'cc-fn-vadd-zero-left '(a) '() (list (ca5-zero-in!))
  (ca5-va ca5-opzero 'a) 'a)
(ca5-law! 'cc-fn-vadd-zero-right '(a) '() (list (ca5-zero-in!))
  (ca5-va 'a ca5-opzero) 'a)
(ca5-law! 'cc-fn-vadd-neg-left '(a) '() (list (ca5-neg-in! 'a))
  (ca5-va (ca5-vn 'a) 'a) ca5-opzero)
(ca5-law! 'cc-fn-vadd-neg-right '(a) '() (list (ca5-neg-in! 'a))
  (ca5-va 'a (ca5-vn 'a)) ca5-opzero)
(ca5-law! 'cc-fn-act-distrib-vec '(a b) '(r) (list (ca5-sum-in! 'a 'b) (ca5-scale-in! 'r 'a) (ca5-scale-in! 'r 'b))
  (ca5-vt 'r (ca5-va 'a 'b)) (ca5-va (ca5-vt 'r 'a) (ca5-vt 'r 'b)))
(ca5-law! 'cc-fn-act-distrib-scalar '(a) '(r s) (list (ca5-ccop! '+ 'r 's) (ca5-scale-in! 'r 'a) (ca5-scale-in! 's 'a))
  (ca5-vt (list ca5-SADD 'r 's) 'a) (ca5-va (ca5-vt 'r 'a) (ca5-vt 's 'a)))
(ca5-law! 'cc-fn-act-mul-compat '(a) '(r s) (list (ca5-ccop! '* 'r 's) (ca5-scale-in! 's 'a))
  (ca5-vt (list ca5-SMUL 'r 's) 'a) (ca5-vt 'r (ca5-vt 's 'a)))
(ca5-law! 'cc-fn-act-unital '(a) '() (list (lambda () (fact 'cc-one-in)))
  (ca5-vt 1 'a) 'a)
;;; ======================================================================
;;; (16) IS-MODULE(CC-FN-MODULE(u, C(u))) for u a subset of CC
;;; ======================================================================
(define ca5-MV (list 'CC-FN-MODULE 'u ca5-V))
(define ca5-laws
  ;; lemma, number of vector arguments, number of scalar arguments
  '((cc-fn-vadd-assoc 3 0) (cc-fn-vadd-comm 2 0) (cc-fn-vadd-zero-left 1 0) (cc-fn-vadd-zero-right 1 0)
    (cc-fn-vadd-neg-left 1 0) (cc-fn-vadd-neg-right 1 0) (cc-fn-act-distrib-vec 2 1)
    (cc-fn-act-distrib-scalar 1 2) (cc-fn-act-mul-compat 1 2) (cc-fn-act-unital 1 0)))
(define (ca5-take l n) (if (= n 0) '() (cons (car l) (ca5-take (cdr l) (- n 1)))))
;; the goal is an instance of a law at the eigenvariables landed (vectors in VS, scalars in SS)
(define (ca5-law-close! vs ss)
  (let loop ((ls ca5-laws))
    (cond ((sequent-node-grounded? (proof-state-focus *ps*)) #t)
          ((dk-asm? (dk-goal)) (ass))
          ((null? ls) (error "ca5-law-close!: no law matches" (expression->string (dk-goal))))
          (#t
           (let* ((lw (car ls)) (nv (cadr lw)) (ns (caddr lw)))
             (if (and (<= nv (length vs)) (<= ns (length ss)))
                 (vnb-guard (lambda () (apply dk-cite! (car lw) 'u (append (ca5-take vs nv) (ca5-take ss ns))))))
             (loop (cdr ls)))))))
(define (ca5-peel-vars!)
  (let* ((lk (dk-peel!))
         (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) ca5-V))) lk)))
         (ss (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC))) lk))))
    (cons vs ss)))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC) (list 'IS-MODULE ca5-MV)))))
(dk-peel!)
(ca5-u-set! 'u)
(dk-cite! 'cc-cont-fns-is-set 'u)
(fact 'cc-is-normed-field)
(fact 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
(fact 'commutative-ring-is-ring ca5-ccr)
(dk-cite! 'cc-cont-fns-zero 'u)
(for-each (lambda (nm) (dk-cite! nm 'u ca5-V))
          '(cc-fn-module-scal cc-fn-module-vec cc-fn-module-vadd cc-fn-module-vzero cc-fn-module-vneg cc-fn-module-act))
(let* ((iff (dk-cite! 'is-module ca5-MV))
       (rhs (caddr iff)))
  (dk-have! rhs
    (lambda ()
      (for-each (lambda (acc val) (subst (list '== (list acc ca5-MV) val)))
                '(SCAL VEC VADD VZERO VNEG ACT)
                (list ca5-ccr ca5-V ca5-opadd ca5-opzero ca5-opneg ca5-opact))
      (for-each (lambda (m) (vnb-guard (lambda () (mac m))))
                '(cc-scalar-ring-carr cc-scalar-ring-add cc-scalar-ring-mul cc-scalar-ring-one))
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-asm? g) (ass))
              ((and (dk-head-is? g '=) (pair? (cadr g)) (eq? (car (cadr g)) 'LENGTH))
               (mac 'CC-FN-MODULE) (len-r) (if (not (proof-done? *ps*)) (vnb-guard (lambda () (arith)))))
              ((and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'FUN))
               (dk-lam-type!
                 (lambda ()
                   (let* ((vss (ca5-peel-vars!)) (vs (car vss)) (ss (cdr vss))
                          (body (cadddr (cadr (dk-goal)))))
                     (case (car body)
                       ((+) (dk-cite! 'cc-cont-fns-add 'u (car vs) (cadr vs)))
                       ((*) (dk-cite! 'cc-cont-fns-scale 'u (car ss) (car vs)))
                       ((-) (dk-cite! 'cc-cont-fns-neg 'u (car vs)))
                       (else (error "ca5: unexpected op body" body)))
                     (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))))
              ((memq (car g) '(is-associative is-commutative is-identity has-inverses IS-ASSOCIATIVE IS-COMMUTATIVE IS-IDENTITY HAS-INVERSES))
               (mac (car g))
               (let ((vss (ca5-peel-vars!)))
                 (dk-conj-close! (lambda () (ca5-law-close! (car vss) (cdr vss))))))
              ((dk-head-is? g 'FORALL)
               (let ((vss (ca5-peel-vars!)))
                 (ca5-law-close! (car vss) (cdr vss))))
              (#t (error "ca5: unexpected conjunct" (expression->string g)))))))))
  (mac 'IS-MODULE)
  (ass))
(qed 'cc-fn-module-is-module)
(topic! 'cc-fn-module-is-module 'analysis)
;;; ======================================================================
;;; (17) the sup seminorms are seminorms on C(u)
;;; ======================================================================
(define ca5-K '(CC-EXHAUST u n))
(define (ca5-sn a) (list 'CC-SUP-NORM a ca5-K))
;; a in C(u) (parts in context), u open: land p(a) in RR, 0 <= p(a)
(define (ca5-sn-real! a)
  (dk-split-all! (list (dk-cite! 'cc-exhaust-seminorm-real 'u a 'n))))
;; the pointwise typing of g on K_n (g a member of FUN(u, CC), or a lambda over u)
(define (ca5-ktyp! g)
  (let ((cl (list 'FORALL 'ky_ (list 'IMPLIES (list 'IN 'ky_ ca5-K) (list 'IN (list g 'ky_) 'CC)))))
    (if (not (dk-asm? cl))
        (dk-have! cl
          (lambda ()
            (let ((y (dk-di-var!)))
              (fact 'subset-mem-fwd ca5-K 'u y)
              (if (symbol? g)
                  (begin (fact 'fun-apply-type-c g 'u 'CC y) (ass))
                  (begin
                    (dk-lam-b!)
                    (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                        (begin (ca5-cc! (cadr (dk-goal))) (ass)))))))))
    cl))
;; |g(y)| <= p(g) at a point y of K_n
(define (ca5-upper! g y)
  (ca5-ktyp! g)
  (dk-cite! 'cc-sup-norm-upper g ca5-K y))
(define (ca5-sn-setup!)
  (fact 'cc-open-subset-cc 'u)
  (ca5-u-set! 'u)
  (dk-cite! 'cc-exhaust-subset 'u 'n))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ca5-nfm 'u)
  (list 'FORALL 'a (list 'IMPLIES (ca5-cfn 'a) (list 'FORALL 'b (list 'IMPLIES (ca5-cfn 'b)
    (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
      (list '<= (ca5-sn (ca5-fsum 'a 'b)) (list '+ (ca5-sn 'a) (ca5-sn 'b)))))))))))))
(dk-peel!)
(ca5-sn-setup!)
(ca5-cfn-parts! 'u 'a)
(ca5-cfn-parts! 'u 'b)
(ca5-sn-real! 'a)
(ca5-sn-real! 'b)
(let* ((h (ca5-fsum 'a 'b))
       (bm (list '+ (ca5-sn 'a) (ca5-sn 'b))))
  (fact 'rr-add-in-rr (ca5-sn 'a) (ca5-sn 'b))
  (dk-have! (list '<= 0 bm) (lambda () (dk-ineq! (list '<= 0 (ca5-sn 'a)) (list '<= 0 (ca5-sn 'b)))))
  (ca5-ktyp! h)
  (dk-have! (list 'FORALL 'ky_ (list 'IMPLIES (list 'IN 'ky_ ca5-K) (list '<= (list 'magnitude (list h 'ky_)) bm)))
    (lambda ()
      (let* ((y (dk-di-var!)) (ay (list 'a y)) (by (list 'b y)))
        (fact 'subset-mem-fwd ca5-K 'u y)
        (dk-lam-b!)
        (fact 'fun-apply-type-c 'a 'u 'CC y) (fact 'fun-apply-type-c 'b 'u 'CC y)
        (ca5-and! (list 'IN ay 'CC) (list 'IN by 'CC))
        (fact 'cc-add-closed ay by)
        (fact 'cc-magnitude-triangle ay by)
        (ca5-mag! ay) (ca5-mag! by) (ca5-mag! (list '+ ay by))
        (ca5-upper! 'a y) (ca5-upper! 'b y)
        (dk-ineq! (list '<= (list 'magnitude (list '+ ay by)) (list '+ (list 'magnitude ay) (list 'magnitude by)))
                  (list '<= (list 'magnitude ay) (ca5-sn 'a))
                  (list '<= (list 'magnitude by) (ca5-sn 'b))))))
  (dk-split-all! (list (dk-cite! 'cc-sup-norm-bound h ca5-K bm)))
  (ass))
(qed 'cc-exhaust-seminorm-subadditive)
(topic! 'cc-exhaust-seminorm-subadditive 'analysis)

;;; homogeneity: p(c a) = |c| p(a)
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ca5-nfm 'u)
  (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'a (list 'IMPLIES (ca5-cfn 'a)
    (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
      (list '= (ca5-sn (ca5-fscale 'c 'a)) (list '* '(magnitude c) (ca5-sn 'a)))))))))))))
(dk-peel!)
(ca5-sn-setup!)
(ca5-cfn-parts! 'u 'a)
(dk-cite! 'cc-cont-fns-scale 'u 'c 'a)
(let* ((h (ca5-fscale 'c 'a)) (pa (ca5-sn 'a)) (ph (ca5-sn h)) (mc '(magnitude c)))
  (ca5-cfn-parts! 'u h)
  (ca5-sn-real! 'a)
  (ca5-sn-real! h)
  (fact 'cc-magnitude-closed 'c) (fact 'cc-magnitude-nonneg 'c)
  (fact 'rr-mul-in-rr mc pa)
  ;; p(c a) <= |c| p(a)
  (dk-have! (list '<= ph (list '* mc pa))
    (lambda ()
      (ca5-ktyp! h)
      (dk-have! (list '<= 0 (list '* mc pa))
        (lambda () (ca5-and! (list 'IN mc 'RR) (list 'IN pa 'RR))
                   (ca5-and! (list '<= 0 mc) (list '<= 0 pa))
                   (fact 'rr-leq-mul-nonneg mc pa) (ass)))
      (dk-have! (list 'FORALL 'ky_ (list 'IMPLIES (list 'IN 'ky_ ca5-K) (list '<= (list 'magnitude (list h 'ky_)) (list '* mc pa))))
        (lambda ()
          (let* ((y (dk-di-var!)) (ay (list 'a y)))
            (fact 'subset-mem-fwd ca5-K 'u y)
            (dk-lam-b!)
            (fact 'fun-apply-type-c 'a 'u 'CC y)
            (ca5-and! '(IN c CC) (list 'IN ay 'CC))
            (fact 'cc-magnitude-mul 'c ay)
            (subst (list '= (list 'magnitude (list '* 'c ay)) (list '* mc (list 'magnitude ay))))
            (ca5-mag! ay)
            (ca5-upper! 'a y)
            (ca5-and! (list '<= 0 mc) (list '<= (list 'magnitude ay) pa))
            (fact 'rr-le-scale-nonneg mc (list 'magnitude ay) pa)
            (ass))))
      (dk-split-all! (list (dk-cite! 'cc-sup-norm-bound h ca5-K (list '* mc pa))))
      (ass)))
  ;; |c| p(a) <= p(c a)
  (dk-have! (list '<= (list '* mc pa) ph)
    (lambda ()
      (use-em '(= c 0)
        (lambda ()
          (fact 'cc-magnitude-zero)
          (dk-have! (list '= mc 0) (lambda () (subst '(= c 0)) (ass)))
          (subst (list '= mc 0))
          (dk-ineq! (list '<= 0 ph)))
        (lambda ()
          ;; |c| > 0, and v = 1/|c|
          (let ((zi (dk-cite! 'cc-magnitude-zero-iff 'c)))
            (dk-have! (list 'NOT (list '= mc 0))
              (lambda () (di) (dk-only! zi (list '= mc 0) '(NOT (= c 0))) (prop))))
          (ca5-and! (list 'IN mc 'RR) (list 'NOT (list '= mc 0)))
          (fact 'rr-recip-closed mc)
          (fact 'rr-recip-inverse mc)
          (let* ((v (dk-name! (list 'recip mc))))
            (dk-rewrite-h! (list '= (list '* mc (list 'recip mc)) 1) (list 'recip mc) v)
            (dk-have! (list 'NOT (list '= 0 mc))
              (lambda () (di)
                (dk-have! (list '= mc 0) (lambda () (subst (list '= mc 0)) (rfl)))
                (dk-only! (list '= mc 0) (list 'NOT (list '= mc 0))) (prop)))
            (ca5-and! (list '<= 0 mc) (list 'NOT (list '= 0 mc)))
            (fact 'rr-zero-in)
            (fact 'rr-le-ne-lt 0 mc)
            (dk-have! (list '<= 0 v)
              (lambda () (fact 'rr-recip-pos mc) (subst (list '= v (list 'recip mc))) (dk-ineq! (list '< 0 (list 'recip mc)))))
            (fact 'rr-mul-in-rr ph v)
            (dk-have! (list '<= 0 (list '* ph v))
              (lambda () (ca5-and! (list 'IN ph 'RR) (list 'IN v 'RR))
                         (ca5-and! (list '<= 0 ph) (list '<= 0 v))
                         (fact 'rr-leq-mul-nonneg ph v) (ass)))
            ;; p(a) <= p(c a) / |c|
            (ca5-ktyp! 'a)
            (dk-have! (list 'FORALL 'ky_ (list 'IMPLIES (list 'IN 'ky_ ca5-K) (list '<= (list 'magnitude (list 'a 'ky_)) (list '* ph v))))
              (lambda ()
                (let* ((y (dk-di-var!)) (ay (list 'a y)) (may (list 'magnitude ay)))
                  (fact 'subset-mem-fwd ca5-K 'u y)
                  (fact 'fun-apply-type-c 'a 'u 'CC y)
                  (ca5-mag! ay)
                  (ca5-upper! h y)
                  (dk-have! (list '= (list h y) (list '* 'c ay)) (lambda () (if (not (dk-lam-b!)) (rfl))))
                  (dk-rewrite-h! (list '<= (list 'magnitude (list h y)) ph) (list h y) (list '* 'c ay))
                  (ca5-and! '(IN c CC) (list 'IN ay 'CC))
                  (fact 'cc-magnitude-mul 'c ay)
                  (dk-rewrite-h! (list '<= (list 'magnitude (list '* 'c ay)) ph) (list 'magnitude (list '* 'c ay)) (list '* mc may))
                  (fact 'rr-mul-in-rr mc may)
                  (ca5-and! (list '<= 0 v) (list '<= (list '* mc may) ph))
                  (fact 'rr-le-scale-nonneg v (list '* mc may) ph)
                  (dk-have! (list '= (list '* v (list '* mc may)) (list '* (list '* mc v) may)) (lambda () (crs)))
                  (dk-have! (list '= (list '* (list '* mc v) may) may)
                    (lambda () (subst (list '= (list '* mc v) 1)) (crs)))
                  (dk-have! (list '= (list '* v ph) (list '* ph v)) (lambda () (crs)))
                  (let* ((h1 (list '<= (list '* v (list '* mc may)) (list '* v ph)))
                         (h2 (list '<= (list '* (list '* mc v) may) (list '* v ph)))
                         (h3 (list '<= may (list '* v ph))))
                    (dk-rewrite-h! h1 (list '* v (list '* mc may)) (list '* (list '* mc v) may))
                    (dk-rewrite-h! h2 (list '* (list '* mc v) may) may)
                    (dk-rewrite-h! h3 (list '* v ph) (list '* ph v))
                    (ass)))))
            (dk-split-all! (list (dk-cite! 'cc-sup-norm-bound 'a ca5-K (list '* ph v))))
            ;; |c| p(a) <= |c| (p(ca) v) = p(ca)
            (ca5-and! (list '<= 0 mc) (list '<= pa (list '* ph v)))
            (fact 'rr-le-scale-nonneg mc pa (list '* ph v))
            (dk-have! (list '= (list '* mc (list '* ph v)) ph)
              (lambda ()
                (dk-have! (list '= (list '* mc (list '* ph v)) (list '* (list '* mc v) ph)) (lambda () (crs)))
                (subst (list '= (list '* mc (list '* ph v)) (list '* (list '* mc v) ph)))
                (subst (list '= (list '* mc v) 1))
                (crs)))
            (dk-rewrite-h! (list '<= (list '* mc pa) (list '* mc (list '* ph v))) (list '* mc (list '* ph v)) ph)
            (ass))))))
  (ca5-and! (list 'IN ph 'RR) (list 'IN (list '* mc pa) 'RR))
  (ca5-and! (list '<= ph (list '* mc pa)) (list '<= (list '* mc pa) ph))
  (fact 'rr-leq-antisymmetric ph (list '* mc pa))
  (ass))
(qed 'cc-exhaust-seminorm-homogeneous)
(topic! 'cc-exhaust-seminorm-homogeneous 'analysis)
;;; ======================================================================
;;; (18) separation, and IS-SEMINORM-FAMILY of the exhaustion seminorms on C(u)
;;; ======================================================================
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN ca5-nfm 'u)
  (list 'FORALL 'a (list 'IMPLIES (ca5-cfn 'a) (list 'IMPLIES (list 'NOT (list '= 'a ca5-fz))
    '(FORSOME k (AND (IN k NN) (NOT (= (CC-SUP-NORM a (CC-EXHAUST u k)) 0)))))))))))
(dk-peel!)
(fact 'cc-open-subset-cc 'u)
(ca5-u-set! 'u)
(ca5-cfn-parts! 'u 'a)
(let ((ex '(FORSOME zs_ (AND (IN zs_ u) (NOT (= (a zs_) 0))))))
  (dk-have! ex
    (lambda ()
      (use-em ex
        (lambda () (ass))
        (lambda ()
          (dk-have! '(FORALL zs_ (IMPLIES (IN zs_ u) (= (a zs_) 0)))
            (lambda ()
              (let ((z (dk-di-var!)))
                (fact 'fun-apply-type-c 'a 'u 'CC z)
                (use-em (list '= (list 'a z) 0)
                  (lambda () (ass))
                  (lambda ()
                    (dk-have! ex (lambda () (ew z) (dk-conj-close! (lambda () (ass)))))
                    (dk-only! ex (list 'NOT ex)) (prop))))))
          (fact 'cc-zero-in)
          (dk-fun-ext! 'a ca5-fz 'u 'CC #f
            (lambda () (dk-lam-type! (lambda () (dk-di-var!) (ass))))
            (lambda (w)
              (dk-apply! (dk-ctx-form '(FORALL zs_ (IMPLIES (IN zs_ u) (= (a zs_) 0)))) w)
              (if (not (dk-lam-b!)) (ass))))
          (dk-only! (list '= 'a ca5-fz) (list 'NOT (list '= 'a ca5-fz))) (prop)))))
  (let ((z (dk-skolem! ex)))
    (dk-split-all!)
    (dk-split-all! (list (dk-cite! 'cc-ms-open-iff 'u)))
    (dk-have! '(IS-OPEN CC-MS u) (lambda () (prop)))
    (let ((k (dk-skolem! (dk-cite! 'cc-exhaust-covers 'u z))))
      (dk-split-all!)
      (dk-cite! 'cc-exhaust-subset 'u k)
      (dk-split-all! (list (dk-cite! 'cc-exhaust-seminorm-real 'u 'a k)))
      (let* ((kk (list 'CC-EXHAUST 'u k)) (pk (list 'CC-SUP-NORM 'a kk)) (az (list 'a z)))
        (dk-have! (list 'FORALL 'ky_ (list 'IMPLIES (list 'IN 'ky_ kk) (list 'IN (list 'a 'ky_) 'CC)))
          (lambda () (let ((y (dk-di-var!))) (fact 'subset-mem-fwd kk 'u y) (fact 'fun-apply-type-c 'a 'u 'CC y) (ass))))
        (dk-cite! 'cc-sup-norm-upper 'a kk z)
        (fact 'fun-apply-type-c 'a 'u 'CC z)
        (ca5-mag! az)
        (fact 'cc-magnitude-nonneg az)
        (let ((zi (dk-cite! 'cc-magnitude-zero-iff az)))
          (dk-have! (list 'NOT (list '= (list 'magnitude az) 0))
            (lambda () (di) (dk-only! zi (list '= (list 'magnitude az) 0) (list 'NOT (list '= az 0))) (prop))))
        (ew k)
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (begin
                  (di)
                  (dk-have! (list '= (list 'magnitude az) 0)
                    (lambda () (dk-ineq! (list '<= (list 'magnitude az) pk) (list '= pk 0) (list '<= 0 (list 'magnitude az)))))
                  (dk-only! (list '= (list 'magnitude az) 0) (list 'NOT (list '= (list 'magnitude az) 0)))
                  (prop)))))))))
(qed 'cc-exhaust-seminorms-separate)
(topic! 'cc-exhaust-seminorms-separate 'analysis)

;;; the family
(define ca5-FAM (list 'CC-EXHAUST-SEMINORMS 'u ca5-V))
(define (ca5-pk k) (list 'VNB-LAMBDA 'cfa_ ca5-V (list 'CC-SUP-NORM 'cfa_ (list 'CC-EXHAUST 'u k))))
(define (ca5-slots! )
  (for-each (lambda (acc val) (if (dk-contains? (dk-goal) (list acc ca5-MV)) (subst (list '== (list acc ca5-MV) val))))
            '(SCAL VEC VADD VZERO VNEG ACT)
            (list ca5-ccr ca5-V ca5-opadd ca5-opzero ca5-opneg ca5-opact)))
(define (ca5-seminorm-k! k)          ; goal IS-SEMINORM(CCNF, M, ca5-pk(k)), k in NN in context
  (mac 'IS-SEMINORM)
  (ca5-slots!)
  (vnb-guard (lambda () (mac 'cc-scalar-ring-carr)))
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (ass))
          ((dk-head-is? g '=) (rfl))
          ((and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'FUN))
           (dk-lam-type!
             (lambda ()
               (let ((a (dk-di-var!)))
                 (ca5-cfn-parts! 'u a)
                 (dk-split-all! (list (dk-cite! 'cc-exhaust-seminorm-real 'u a k)))
                 (ass)))))
          ((dk-head-is? g 'FORALL)
           (let* ((vss (ca5-peel-vars!)) (vs (car vss)) (ss (cdr vss)))
             (for-each (lambda (a) (ca5-cfn-parts! 'u a)) vs)
             (cond
               ((and (= (length vs) 1) (null? ss))
                (dk-lam-b!)
                (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                    (begin (dk-split-all! (list (dk-cite! 'cc-exhaust-seminorm-real 'u (car vs) k))) (ass))))
               ((= (length vs) 2)
                (dk-cite! 'cc-cont-fns-add 'u (car vs) (cadr vs))
                (dk-lam-b!)
                (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
