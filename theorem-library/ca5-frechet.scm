          (let ((unifk (dk-cite! 'cc-fn-module-limit-uniform 'u sq)))
            ;; the limit is continuous on u
            (let* ((miff (dk-cite! 'cc-cont-fns-membership 'u lim))
                   (mrhs (caddr miff)))
              (dk-have! mrhs
                (lambda ()
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-asm? (dk-goal))
                          (ass)
                          ((lambda ()
                    (let* ((z0 (dk-di-var!))
                           (m (dk-skolem! (dk-cite! 'cc-exhaust-covers 'u z0))))
                      (dk-split-all!)
