(define (ca5-ass-if! goal)
  (if (and (not (proof-done? *ps*)) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) goal))))) (ass)))
(define (ca5-choice-at sq y) (list 'CHOICE (list 'SEP 'cfl_ 'CC
                       (list 'CONVERGES-TO 'CC-MS (list 'VNB-LAMBDA 'cfi_ 'NN (list (list sq 'cfi_) y)) 'cfl_))))
;; the goal holds CHOICE(...) at y, the value of the limit function: put (lim y) back
(define (ca5-unchoice! sq lim y)
  (let ((c (ca5-choice-at sq y)))
    (if (dk-contains? (dk-goal) c)
        (begin
          (dk-have! (list '== (list lim y) c) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (qrfl))))
          (subst (list '== c (list lim y)))))))
(define (ca5-Fof sq) (list 'VNB-LAMBDA 'cfz_ 'u (list 'CHOICE (list 'SEP 'cfl_ 'CC
                       (list 'CONVERGES-TO 'CC-MS (list 'VNB-LAMBDA 'cfi_ 'NN (list (list sq 'cfi_) 'cfz_)) 'cfl_)))))
(define (ca5-unif-seq sq lim set)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'cap (list 'AND '(IN cap NN)
      (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list 'IMPLIES '(<= cap i)
        (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z set)
          (list '<= (list 'magnitude (list '- (list (list sq 'i) 'z) (list lim 'z))) 'eps)))))))))))

