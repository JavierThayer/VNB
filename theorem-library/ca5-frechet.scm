(define ca5-ccr '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define (ca5-ring-view! name acc val)
  (sp (make-wff (list '== (list acc ca5-ccr) val)))
  (fact 'cc-is-normed-field)
  (slot acc)
  (mac 'NORMED-FIELD-AS-COMMUTATIVE-RING)
  (nth-r)
  (slot acc)
  (qrfl)
  (if (not (proof-done? *ps*)) (error "ca5-ring-view!: did not close" name (dk-goal)))
  (qed name)
  (topic! name 'algebra))
(ca5-ring-view! 'cc-scalar-ring-carr 'CARR 'CC)
