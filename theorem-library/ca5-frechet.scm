(let ((h (ca5-fneg 'a)))
  (ca5-lam-fun! 'u h
    (lambda (z)
      (fact 'fun-apply-type-c 'a 'u 'CC z)
      (fact 'cc-neg-closed (list 'a z))))
  (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES '(IN aix_ u) (list '== (list h 'aix_) (list '* -1 '(a aix_)))))
    (lambda ()
      (let ((x (dk-di-var!)))
        (dk-lam-b!)
        (fact 'fun-apply-type-c 'a 'u 'CC x)
        (dk-have! (list '= (list '- (list 'a x)) (list '* -1 (list 'a x))) (lambda () (crs)))
        (subst (list '= (list '- (list 'a x)) (list '* -1 (list 'a x))))
        (qrfl))))
  (dk-have! '(IN -1 CC) (lambda () (ca5-cc! -1) (ass)))
  (dk-cite! 'aif-cont-scale 'u -1 'a h)
  (ca5-cfn-in! 'u h)
  (ass))
(qed 'cc-cont-fns-neg)
(topic! 'cc-cont-fns-neg 'analysis)

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(SUBSET u CC) '(IN (CC-CONT-FNS u) SET)))))
(dk-peel!)
(ca5-u-set! 'u)
(fact 'cc-is-set)
(dk-have! '(SUBSET (CC-CONT-FNS u) (FUN u CC))
  (lambda ()
    (let ((h (subset-by-element!)))
      (dk-cite! 'cc-cont-fns-fun 'u h)
