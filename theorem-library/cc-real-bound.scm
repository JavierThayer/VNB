;;; cc-real-bound.scm -- a complex number z with |z + i t|^2 <= c + t^2 for every real t is real.
;;; The real-variable step of BA ch. 1 s. 2 (Proposition 1.22's argument, used here for the
;;; spectrum of a self-adjoint element).  Agent BA-2, wave 2026-11-09.
;;; Destination: theorem-library/cc-real-bound.scm.  Library: analysis.  All proofs modulo 0.
;;; Helper prefix crb-.
;;;
;;; THE ROUTE.  With x = Re z, y = Im z: |z + i t|^2 = x^2 + (y + t)^2, so the hypothesis reads
;;; x^2 + y^2 + 2 y t <= c for every real t.  If y /= 0, t = (c + 1) / (2 y) gives
;;; x^2 + y^2 + c + 1 <= c, absurd.  So Im z = 0 and z is real (cc-real-of-im-zero).
;;;
;;; LOAD WINDOW: the citations are cc-magnitude-sq, cc-re-add, cc-im-add, cc-re-i-mul, cc-im-i-mul,
;;; rr-imag-part-zero, cc-re-of-real, real-part-in-rr, imag-part-in-rr, cc-real-of-im-zero,
;;; rr-recip-inverse, rr-recip-closed, rr-sq-nonneg, cc-i-in, rr-subset-cc (all early).

(define (crb-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (if (and (not (sequent-node-grounded? l))
                           (let ((g (dk-goal-of l))) (and (pair? g) (eq? (car g) '=) (equal? (cadr g) (caddr g)))))
                      (begin (dk-focus! l) (rfl))))
                (dk-open-leaves)))
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** cc-real-bound: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (write (dk-goal-of l)) (newline)
                    (for-each (lambda (a) (display "      asm: ") (write a) (newline)) (dk-asms-of l)))
                  (dk-open-leaves))
        (error "cc-real-bound: unfinished" name))))
(define (crb-cite2! . args)
  (let loop ((ch (apply dk-cite! args)))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))

;;; Land (IN T RR) for a sum / product / negation of terms already typed (or numerals).
(define (crb-rr! t)
  (cond ((dk-asm? (list 'IN t 'RR)) t)
        ((number? t) (dk-real! t) t)
        ((and (pair? t) (memq (car t) '(* + -)))
         (for-each crb-rr! (cdr t)) (dk-real! t) t)
        (#t (error "crb-rr!: untyped atom" (expression->string t)))))

;;; ---- the linear step: forall t in RR, 2 (y t) <= d  forces  y = 0 -------------------------------
;;; y /= 0: with r = recip y and s = (d + 1) r, the instance at s reads 2 (d + 1) <= d and the
;;; instance at 0 reads 0 <= d; together absurd.
(sp (make-wff '(FORALL y (IMPLIES (IN y RR) (FORALL d (IMPLIES (IN d RR)
  (IMPLIES (FORALL t (IMPLIES (IN t RR) (<= (* 2 (* y t)) d))) (= y 0))))))))
(dk-peel!)
(let ((hyp '(FORALL t (IMPLIES (IN t RR) (<= (* 2 (* y t)) d)))))
  (if (not (dk-asm? hyp)) (di))
  (use-em '(= y 0)
    (lambda () (dk-ass!))
    (lambda ()
      (crb-cite2! 'rr-recip-closed 'y)
      (let* ((ri0 (crb-cite2! 'rr-recip-inverse 'y))
             (r   (dk-name! '(recip y)))
             (ri  (dk-rewrite-h! ri0 '(recip y) r))
             (s0  (list '* '(+ d 1) r)))
        (crb-rr! s0)
        (let* ((s     (dk-name! s0))
               (i1    (inst*! hyp s))
               (ignore (crb-rr! 0))
               (i0    (inst*! hyp 0))
               (eq    (list '= (list '* 'y s) '(+ d 1))))
          (dk-have! eq
            (lambda ()
              (subst (list '= s s0))
              (let ((e1 (list '= (list '* 'y s0) (list '* '(+ d 1) (list '* 'y r)))))
                (dk-have! e1 (lambda () (crs)))
                (subst e1)
                (subst (list '= (list '* 'y r) 1))
                (crs))))
          (dk-have! '(= (* y 0) 0) (lambda () (crs)))
          (crb-rr! (list '* 'y s))
          (let* ((i0b (dk-rewrite-h! i0 '(* y 0) 0))
                 (p   (dk-name! (list '* 'y s)))
                 (i1b (dk-rewrite-h! i1 (list '* 'y s) p))
                 (eqb (dk-rewrite-h! eq (list '* 'y s) p)))
            (dk-absurd! i1b i0b eqb)))))))
(crb-qed! 'crb-linear-bound-zero)

;;; ---- the lemma: |z + i t|^2 <= c + t^2 for every real t  forces  z real --------------------------
(sp (make-wff '(FORALL z (IMPLIES (IN z CC) (FORALL c (IMPLIES (IN c RR)
  (IMPLIES (FORALL t (IMPLIES (IN t RR)
             (<= (* (magnitude (+ z (* +i t))) (magnitude (+ z (* +i t)))) (+ c (* t t)))))
           (IN z RR))))))))
(dk-peel!)
(let* ((hyp '(FORALL t (IMPLIES (IN t RR)
              (<= (* (magnitude (+ z (* +i t))) (magnitude (+ z (* +i t)))) (+ c (* t t))))))
       (X '(real-part z)) (Y '(imag-part z))
       (lin (list 'FORALL 't (list 'IMPLIES '(IN t RR) (list '<= (list '* 2 (list '* Y 't)) 'c)))))
  (if (not (dk-asm? hyp)) (di))
  (crb-cite2! 'real-part-in-rr 'z)
  (crb-cite2! 'imag-part-in-rr 'z)
  (dk-have! lin
    (lambda ()
      (di)
      (let* ((itt (list '* '+i 't)) (w (list '+ 'z itt)))
        (if (not (dk-asm? '(IN +i CC))) (fact 'cc-i-in))
        (crb-cite2! 'rr-subset-cc 't)
        (crb-cite2! 'cc-mul-closed '+i 't)
        (crb-cite2! 'cc-add-closed 'z itt)
        (let* ((h0 (inst*! hyp 't))
               (msq (crb-cite2! 'cc-magnitude-sq w))
               (h1 (dk-rewrite-h! h0 (cadr msq) (caddr msq)))
               (ra (crb-cite2! 'cc-re-add 'z itt))
               (h2 (dk-rewrite-h! h1 (cadr ra) (caddr ra)))
               (ia (crb-cite2! 'cc-im-add 'z itt))
               (h3 (dk-rewrite-h! h2 (cadr ia) (caddr ia)))
               (rim (crb-cite2! 'cc-re-i-mul 't))
               (h4 (dk-rewrite-h! h3 (cadr rim) (caddr rim)))
               (iim (crb-cite2! 'cc-im-i-mul 't))
               (h5 (dk-rewrite-h! h4 (cadr iim) (caddr iim)))
               (it0 (crb-cite2! 'rr-imag-part-zero 't))
               (h6 (dk-rewrite-h! h5 (cadr it0) (caddr it0)))
               (rt (crb-cite2! 'cc-re-of-real 't))
               (h7 (dk-rewrite-h! h6 (cadr rt) (caddr rt)))
               (xa (list '+ X '(- 0)))
               (ya (list '+ Y 't)))
          (crb-rr! xa) (crb-rr! ya) (crb-rr! '(* t t))
          (let* ((pa (dk-cite! 'rr-sq-nonneg xa))
                 (py (dk-cite! 'rr-sq-nonneg Y))
                 (qe (list '= (list '* ya ya) (list '+ (list '* Y Y) (list '+ (list '* 2 (list '* Y 't)) '(* t t))))))
            (dk-have! qe (lambda () (crs)))
            (crb-rr! (list '* xa xa)) (crb-rr! (list '* ya ya))
            (let* ((A (dk-name! (list '* xa xa)))
                   (Q (dk-name! (list '* ya ya)))
                   (h8 (dk-rewrite-h! h7 (list '* xa xa) A))
                   (h9 (dk-rewrite-h! h8 (list '* ya ya) Q))
                   (pa2 (dk-rewrite-h! pa (list '* xa xa) A))
                   (qe2 (dk-rewrite-h! qe (list '* ya ya) Q)))
              (crb-rr! (list '* Y Y)) (crb-rr! (list '* Y 't))
              (let* ((yy (dk-name! (list '* Y Y)))
                     (yt (dk-name! (list '* Y 't)))
                     (tt (dk-name! '(* t t)))
                     (h10 (dk-rewrite-h! h9 '(* t t) tt))
                     (py2 (dk-rewrite-h! py (list '* Y Y) yy))
                     (qe3 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! qe2 (list '* Y Y) yy)
                                                        (list '* Y 't) yt)
                                         '(* t t) tt)))
                (subst (list '= (list '* Y 't) yt))
                (dk-ineq! h10 pa2 py2 qe3))))))))
  (let ((ch (crb-cite2! 'crb-linear-bound-zero Y 'c)))
    (crb-cite2! 'cc-real-of-im-zero 'z)
    (if (not (proof-done? *ps*)) (dk-ass!))))
(crb-qed! 'cc-real-of-quadratic-bound)
