;;; ba-vn.scm -- Thayer, Banach Algebras and Applications, chapter 6: commutants and bicommutants, the
;;; strong closedness of a commutant (Thm 6.1, first half), the one-vector core of the bicommutant theorem
;;; (T xi in the closure of A xi for T in A''), the commutant of a self-adjoint set as a von Neumann algebra,
;;; Prop 6.8 (both halves) and Cor 6.9 (the second equivalence outright; the first given A'' = A).
;;; Agent BA-1111-C, 2026-11-11.  DESTINATION: theorem-library/ba-vn.scm, after ba-optop-adjoint.scm
;;; (sot-unfold) and ba-optop.scm.  Vocabulary: structure-library/ba-vn-vocab.scm.  Library:
;;; operator-algebras.  Helper prefix: vn-.  cc-conjugate-zero is a general CC fact (analysis) proven here
;;; because cc-conjugate-fixes-rr is asserted; it may move to a complex-number file.

(define (vn-done?) (sequent-node-grounded? (proof-state-focus *ps*)))
(define (vn-qed! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** ba-vn: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'analysis))
(define vn-BO '(BOUNDED-OPS v v))
(define vn-CV '((IS-COMPLEX-INNER-PRODUCT-SPACE v)))
(define (vn-comm-sep s)
  (list 'SEP 'vnt_ vn-BO
        (list 'FORALL 'vna_ (list 'IMPLIES (list 'IN 'vna_ s) '(= (BOP-COMP v vnt_ vna_) (BOP-COMP v vna_ vnt_))))))

;;; ---------------------------------------------------------------------------------------------
;;; the unfold of COMMUTANT (a def-functoid: mac-h cannot name it in a hypothesis)
(sp (make-wff (list 'FORALL 'v (list 'FORALL 's (list '== '(COMMUTANT v s) (vn-comm-sep 's))))))
(dk-peel!) (mac 'COMMUTANT) (qrfl)
(vn-qed! 'commutant-unfold)
(sp (make-wff '(FORALL v (FORALL s (== (BICOMMUTANT v s) (COMMUTANT v (COMMUTANT v s)))))))
(dk-peel!) (mac 'BICOMMUTANT) (qrfl)
(vn-qed! 'bicommutant-unfold)

;;; membership in a commutant, both ways
(define vn-comm-iff
  (forall-guarded '(v s t_) vn-CV
    (list 'IFF '(IN t_ (COMMUTANT v s))
          (list 'AND (list 'IN 't_ vn-BO)
                (list 'FORALL 'vna_ (list 'IMPLIES '(IN vna_ s) '(= (BOP-COMP v t_ vna_) (BOP-COMP v vna_ t_))))))))
(sp (make-wff vn-comm-iff))
(dk-peel!)
(dk-cite! 'bounded-ops-is-set 'v 'v)
(subst (dk-cite! 'commutant-unfold 'v 's))
(dk-iff! (lambda (g) (dk-head-is? (cadr g) 'IN))
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
    (sep-me (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (cadr f) 't_) (dk-head-is? (caddr f) 'SEP))) "membership"))
    (dk-split-all!)
    (dk-conj-close! (lambda () (dk-ass!))))
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
    (dk-split-all!)
    (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
(vn-qed! 'commutant-membership)

;;; S is contained in S'' (for S a set of operators)
(sp (make-wff (forall-guarded '(v s) (append vn-CV (list (list 'SUBSET 's vn-BO))) '(SUBSET s (BICOMMUTANT v s)))))
(dk-peel!)
(subst (dk-cite! 'bicommutant-unfold 'v 's))
(mac 'subset-def)
(let* ((a (dk-di-var!)))
  (dk-cite! 'subset-mem-fwd 's vn-BO a)
  (let ((iff (dk-cite! 'commutant-membership 'v '(COMMUTANT v s) a)))
    (dk-have! (caddr iff)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (let* ((b (dk-di-var!))
                       (bi (dk-cite! 'commutant-membership 'v 's b)))
                  (dk-have! (caddr bi) (lambda () (if (dk-only! bi (list 'IN b '(COMMUTANT v s))) (prop))))
                  (dk-split! (caddr bi))
                  (let ((ba (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f b) (dk-contains? f 'BOP-COMP))) "b commutes") a)))
                    (subst (list '= (list 'BOP-COMP 'v a b) (list 'BOP-COMP 'v b a)))
                    (if (not (vn-done?)) (rfl)))))))))
    (if (dk-only! iff (caddr iff)) (prop))))
(vn-qed! 'subset-bicommutant)

