;;; Prop 6.8, first half: xi cyclic for S' => xi separating for S
(define vn-cyc '(IS-CYCLIC-FOR v (COMMUTANT v s) xi))
(define vn-dense
  '(FORALL vny_ (IMPLIES (IN vny_ (VEC v))
     (FORALL vne_ (IMPLIES (POS-RR vne_)
       (FORSOME vna_ (AND (IN vna_ (COMMUTANT v s))
         (< (IP-NORM v ((VADD v) vny_ ((VNEG v) (vna_ xi)))) vne_))))))))
(sp (make-wff (forall-guarded '(v s xi) (append vn-CV (list (list 'SUBSET 's vn-BO) vn-cyc))
                '(IS-SEPARATING-FOR v s xi))))
(dk-peel!)
(dk-have! '(IN xi (VEC v)) (lambda () (mac-h 'is-cyclic-for (dk-ctx-form vn-cyc)) (dk-split-all!) (dk-ass!)))
(dk-have! vn-dense (lambda () (mac-h 'is-cyclic-for (dk-ctx-form vn-cyc)) (dk-split-all!) (dk-ass!)))
(dk-cite! 'cips-vzero-in 'v)
(mac 'is-separating-for)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (let* ((pl (dk-peel!))
               (a (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 's))) pl))))
               (hz (car (filter (lambda (f) (dk-head-is? f '=)) pl))))
          (dk-cite! 'subset-mem-fwd 's vn-BO a)
          (dk-cite! 'bop-fun 'v 'v a)
          (dk-cite! 'bop-zero-bounded 'v 'v)
          (dk-cite! 'bop-fun 'v 'v '(BOP-ZERO v v))
          (dk-cite! 'opnorm-in-rr 'v 'v a)
          (dk-cite! 'opnorm-nonneg 'v 'v a)
          (dk-fun-ext! a '(BOP-ZERO v v) '(VEC v) '(VEC v) #f #f
            (lambda (z)
              (let* ((az (list a z)) (naz (list 'IP-NORM 'v az)) (c (list 'OPNORM 'v 'v a)))
                (subst (dk-cite! 'bop-zero-apply 'v 'v z))
                (dk-cite! 'fun-apply-type-c a '(VEC v) '(VEC v) z)
                (dk-cite! 'ip-norm-in-rr 'v az)
                (dk-cite! 'ip-norm-nonneg 'v az)
                (let* ((nb (dk-cite! 'rr-nonneg-below-all-zero naz))
                       (imp (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-head-is? (cadr f) 'FORALL)
                                                      (equal? (caddr f) (list '= naz 0))))
                                     "the below-all implication")))
                  (dk-have! (cadr imp)
                    (lambda ()
                      (dk-peel!)
                      (let* ((g (dk-goal)) (eps (caddr g)))
                        (dk-cite! 'rr-pos-rr-in-rr eps)
                        (let* ((d (dk-skolem! (dk-cite! 'rr-scale-eps c eps) #t))
                               (sc (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d))) "scale"))
                               (_d (dk-cite! 'rr-pos-rr-in-rr d))
                               (b (dk-skolem! (dk-apply! (dk-ctx-form vn-dense) z d) #t))
                               (bx (list b 'xi))
                               (w (list '(VADD v) z (list '(VNEG v) bx)))
                               (nw (list 'IP-NORM 'v w))
                               (bi (dk-cite! 'commutant-membership 'v 's b)))
                          (dk-have! (caddr bi) (lambda () (if (dk-only! bi (list 'IN b '(COMMUTANT v s))) (prop))))
                          (dk-split! (caddr bi))
                          (dk-cite! 'bop-fun 'v 'v b)
                          (dk-cite! 'fun-apply-type-c b '(VEC v) '(VEC v) 'xi)
                          (dk-cite! 'fun-apply-type-c a '(VEC v) '(VEC v) bx)
                          (dk-cite! 'cips-vneg-type 'v bx)
                          (dk-cite! 'cips-vadd-type 'v z (list '(VNEG v) bx))
                          ;; a (b xi) = b (a xi) = b 0 = 0
                          (let ((ba (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f b) (dk-contains? f 'BOP-COMP))) "b commutes") a)))
                            (dk-have! (list '= (list a bx) '(VZERO v))
                              (lambda ()
                                (let ((e1 (dk-cite! 'bop-comp-apply 'v a b 'xi)))
                                  (subst (list '= (caddr e1) (cadr e1))))
                                (subst (list '= (list 'BOP-COMP 'v a b) (list 'BOP-COMP 'v b a)))
                                (subst (dk-cite! 'bop-comp-apply 'v b a 'xi))
                                (subst hz)
                                (subst (dk-cite! 'bop-zero-value 'v 'v b))
                                (if (not (vn-done?)) (rfl)))))
                          ;; a w = a z
                          (dk-have! (list '= (list a w) az)
                            (lambda ()
                              (subst (dk-cite! 'bop-add 'v 'v a z (list '(VNEG v) bx)))
                              (subst (dk-cite! 'bop-vneg 'v 'v a bx))
                              (subst (list '= (list a bx) '(VZERO v)))
                              (subst (dk-cite! 'cips-vneg-vzero 'v))
                              (subst (dk-cite! 'cips-vadd-vzero-right 'v az))
                              (if (not (vn-done?)) (rfl))))
                          (dk-cite! 'ip-norm-in-rr 'v w)
                          (dk-cite! 'ip-norm-nonneg 'v w)
                          (let* ((ob (dk-apply! (dk-cite! 'opnorm-bound 'v 'v a) w))
                                 (ob2 (dk-rewrite-h! ob (list a w) az))
                                 (lt (dk-pick (lambda (f) (and (dk-head-is? f '<) (equal? (cadr f) nw))) "the density estimate")))
                            (dk-have! (list '<= nw d) (lambda () (dk-ineq! lt (list 'IN nw 'RR) (list 'IN d 'RR))))
                            (dk-apply! sc nw)
                            (dk-real! (list '* c nw))
                            (let* ((n1 (dk-name! (list '* c nw)))
                                   (r1 (dk-rewrite-h! ob2 (list '* c nw) n1))
                                   (r2 (dk-rewrite-h! (dk-pick (lambda (f) (and (dk-head-is? f '<=) (equal? (caddr f) eps) (dk-contains? f c))) "c ||w|| <= eps")
                                                      (list '* c nw) n1)))
                              (dk-ineq! r1 r2 (list 'IN n1 'RR) (list 'IN naz 'RR) (list 'IN eps 'RR))))))))
                  (detach! imp)
                  (dk-cite! 'ip-norm-zero-vector 'v az)
                  (if (not (vn-done?)) (dk-ass!))))))
          (if (not (vn-done?)) (dk-ass!))))))
(vn-qed! 'cyclic-commutant-separating)

