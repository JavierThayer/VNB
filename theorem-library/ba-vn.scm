;;; Prop 6.8, second half: for an involutive algebra s of operators containing I_H, a vector separating
;;; for s' is cyclic for s.  The notes' proof: M = {B xi : B in s}; K = M^perp is invariant under s (and,
;;; s being involutive, so is K^perp), hence E_K in s'; xi = I xi in M, so E_K xi = 0, so E_K = 0, so
;;; K = 0, so M is dense (hilbert-dense-iff-perp-trivial).

;;; conjugate(0) = 0, through |conj z| = |z| (cc-conjugate-fixes-rr is asserted, so not cited)
(sp (make-wff '(= (conjugate 0) 0)))
(dk-cite! 'cc-zero-in)
(dk-cite! 'cc-conjugate-closed 0)
(dk-cite! 'cc-magnitude-conjugate 0)
(dk-cite! 'cc-magnitude-zero)
(let ((iff (dk-cite! 'cc-magnitude-zero-iff '(conjugate 0))))
  (dk-have! '(= (magnitude (conjugate 0)) 0)
    (lambda () (subst '(= (magnitude (conjugate 0)) (magnitude 0))) (dk-ass!)))
  (if (dk-only! iff '(= (magnitude (conjugate 0)) 0)) (prop)))
(vn-qed! 'cc-conjugate-zero)

(define (vn-tree-sub e al)
  (cond ((symbol? e) (let ((p (assq e al))) (if p (cdr p) e)))
        ((pair? e) (cons (vn-tree-sub (car e) al) (vn-tree-sub (cdr e) al)))
        (#t e)))
(define vn-MM '(SEP vqm_ (VEC v) (FORSOME vqb_ (AND (IN vqb_ s) (= vqm_ (vqb_ xi))))))
(define vn-KK (list 'PERP 'v vn-MM))
(define vn-KP (list 'PERP 'v vn-KK))
(define vn-PP (list 'PROJ-OP 'v vn-KK))
(define vn-star '(IS-STAR-OP-ALGEBRA v s))
(define vn-seph '(IS-SEPARATING-FOR v (COMMUTANT v s) xi))
(define (vn-star-conj k)           ; the k-th conjunct (0-based) of IS-STAR-OP-ALGEBRA(v, s)
  (vn-tree-sub
    (list-ref
      (list '(SUBSET vns_ (BOUNDED-OPS vnv_ vnv_))
            '(IN (BOP-ID vnv_) vns_)
            '(FORALL vna_ (IMPLIES (IN vna_ vns_) (FORALL vnb_ (IMPLIES (IN vnb_ vns_) (IN (BOP-SUM vnv_ vnv_ vna_ vnb_) vns_)))))
            '(FORALL vnc_ (IMPLIES (IN vnc_ CC) (FORALL vna_ (IMPLIES (IN vna_ vns_) (IN (BOP-SCALE vnv_ vnv_ vnc_ vna_) vns_)))))
            '(FORALL vna_ (IMPLIES (IN vna_ vns_) (FORALL vnb_ (IMPLIES (IN vnb_ vns_) (IN (BOP-COMP vnv_ vna_ vnb_) vns_)))))
            '(FORALL vna_ (IMPLIES (IN vna_ vns_) (IN (OP-ADJOINT vnv_ vnv_ vna_) vns_))))
      k)
    '((vnv_ . v) (vns_ . s))))
(define (vn-lane-proj! hyp name concl)
  (if (not (dk-asm? concl))
      (dk-have! concl (dk-lane (lambda () (mac-h name (dk-ctx-form hyp)) (dk-split-all!) (dk-lane-if! dk-ass!))))))
;;; m in MM in context: land (IN b s) and (= m (b xi)), return b
(define (vn-mm-witness! m)
  (let ((ex (list 'FORSOME 'vqb_ (list 'AND '(IN vqb_ s) (list '= m '(vqb_ xi))))))
    (dk-have! ex (dk-lane (lambda () (sep-me (dk-ctx-form (list 'IN m vn-MM))) (dk-split-all!) (dk-lane-if! dk-ass!))))
    (dk-skolem! (dk-ctx-form ex) #t)))
;;; goal (IN (b xi) MM) [or (IN y MM) with y = b xi]: b in s in context
(define (vn-in-mm! b)
  (in-sep! (lambda () (if (not (dk-ass!)) (begin (dk-cite! 'bop-fun 'v 'v b) (dk-cite! 'fun-apply-type-c b '(VEC v) '(VEC v) 'xi) (dk-ass!))))
           (lambda () (ew b) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl)))))))
;;; goal (IN t (PERP v SET)): prove the right side of perp-membership with THUNK, then close
(define (vn-perp-in! set t thunk)
  (let* ((iff (dk-cite! 'perp-membership 'v set t)) (rhs (caddr iff)))
    (dk-have! rhs thunk)
    (if (not (vn-done?)) (if (dk-only! iff rhs) (prop)))))
(define (vn-typ! b x)               ; b in BO, x in VEC: land b in FUN, (b x) in VEC
  (dk-cite! 'bop-fun 'v 'v b)
  (dk-cite! 'fun-apply-type-c b '(VEC v) '(VEC v) x))

(define vn-inv1 (list 'FORALL 'vqa_ (list 'IMPLIES '(IN vqa_ s) (list 'FORALL 'vqk_ (list 'IMPLIES (list 'IN 'vqk_ vn-KK) (list 'IN '(vqa_ vqk_) vn-KK))))))
(define vn-inv2 (list 'FORALL 'vqa_ (list 'IMPLIES '(IN vqa_ s) (list 'FORALL 'vqz_ (list 'IMPLIES (list 'IN 'vqz_ vn-KP) (list 'IN '(vqa_ vqz_) vn-KP))))))

(sp (make-wff (forall-guarded '(v s xi) (list '(IS-HILBERT-SPACE v) vn-star vn-seph) '(IS-CYCLIC-FOR v s xi))))
