;; M is a submodule
(dk-have! (list 'IS-SUBMODULE 'v vn-MM)
  (lambda ()
    (mac 'is-submodule)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((vn-done?) #t)
            ((dk-ass!) #t)
            ((dk-head-is? g 'SUBSET)
             (mac 'subset-def)
             (let ((w (dk-di-var!)))
               (dk-have! (list 'IN w '(VEC v)) (lambda () (sep-me (dk-ctx-form (list 'IN w vn-MM))) (dk-split-all!) (dk-ass!)))))
            ((dk-head-is? g 'IN)                ; the zero vector: 0 = (0 . I) xi
             (let ((b '(BOP-SCALE v v 0 (BOP-ID v))))
               (dk-cite! 'cc-zero-in)
               (dk-apply! (dk-ctx-form (vn-star-conj 3)) 0 '(BOP-ID v))
               (in-sep! (lambda () (dk-ass!))
                        (lambda ()
                          (ew b)
                          (dk-conj-close!
                            (lambda ()
                              (if (not (dk-ass!))
                                  (begin
                                    (dk-cite! 'bop-fun 'v 'v '(BOP-ID v))
                                    (subst (dk-cite! 'bop-scale-apply 'v 'v 0 '(BOP-ID v) 'xi))
                                    (subst (dk-cite! 'bop-id-apply 'v 'xi))
                                    (subst (dk-cite! 'cips-act-zero-scalar 'v 'xi))
                                    (if (not (vn-done?)) (rfl))))))))))
            ((dk-contains? g 'VADD)
             (let* ((pl (dk-peel!)) (x (cadr (car pl))) (y (cadr (cadr pl)))
                    (b1 (vn-mm-witness! x)) (b2 (vn-mm-witness! y))
                    (bb (list 'BOP-SUM 'v 'v b1 b2)))
               (dk-cite! 'subset-mem-fwd 's '(BOUNDED-OPS v v) b1)
               (dk-cite! 'subset-mem-fwd 's '(BOUNDED-OPS v v) b2)
               (vn-typ! b1 'xi) (vn-typ! b2 'xi)
               (dk-apply! (dk-ctx-form (vn-star-conj 2)) b1 b2)
               (subst (list '= x (list b1 'xi)))
               (subst (list '= y (list b2 'xi)))
               (dk-cite! 'cips-vadd-type 'v (list b1 'xi) (list b2 'xi))
               (in-sep! (lambda () (dk-ass!))
                        (lambda ()
                          (ew bb)
                          (dk-conj-close!
                            (lambda ()
                              (if (not (dk-ass!))
                                  (begin
                                    (subst (dk-cite! 'bop-sum-apply 'v 'v b1 b2 'xi))
                                    (if (not (vn-done?)) (rfl))))))))))
            ((dk-contains? g 'VNEG)
             (let* ((pl (dk-peel!)) (x (cadr (car pl)))
                    (b1 (vn-mm-witness! x)))
               (dk-cite! 'subset-mem-fwd 's '(BOUNDED-OPS v v) b1)
               (vn-typ! b1 'xi)
               (subst (list '= x (list b1 'xi)))
               (let* ((e (dk-cite! 'cips-act-neg-one 'v (list b1 'xi)))
                      (m1 (cadr (cadr e)))
                      (bb (list 'BOP-SCALE 'v 'v m1 b1)))
                 (dk-have! (list 'IN m1 'CC) (lambda () (type-term)))
                 (dk-apply! (dk-ctx-form (vn-star-conj 3)) m1 b1)
                 (dk-cite! 'cips-vneg-type 'v (list b1 'xi))
                 (in-sep! (lambda () (dk-ass!))
                          (lambda ()
                            (ew bb)
                            (dk-conj-close!
                              (lambda ()
                                (if (not (dk-ass!))
                                    (begin
                                      (subst (dk-cite! 'bop-scale-apply 'v 'v m1 b1 'xi))
                                      (subst e)
                                      (if (not (vn-done?)) (rfl)))))))))))
            (#t                                  ; the scalar multiples
             (let* ((pl (dk-peel!)) (r (cadr (car pl))) (x (cadr (cadr pl)))
                    (b1 (vn-mm-witness! x))
                    (bb (list 'BOP-SCALE 'v 'v r b1)))
               (dk-cite! 'cips-scal-carrier 'v)
               (dk-rewrite-h! (list 'IN r '(CARR (SCAL v))) '(CARR (SCAL v)) 'CC)
               (dk-cite! 'subset-mem-fwd 's '(BOUNDED-OPS v v) b1)
               (vn-typ! b1 'xi)
               (dk-apply! (dk-ctx-form (vn-star-conj 3)) r b1)
               (subst (list '= x (list b1 'xi)))
               (dk-cite! 'cips-act-type 'v r (list b1 'xi))
               (in-sep! (lambda () (dk-ass!))
                        (lambda ()
                          (ew bb)
                          (dk-conj-close!
                            (lambda ()
                              (if (not (dk-ass!))
                                  (begin
                                    (subst (dk-cite! 'bop-scale-apply 'v 'v r b1 'xi))
                                    (if (not (vn-done?)) (rfl))))))))))))))))
