;;; ccr-4-2-local -- Proposition 4.2 for a local NV field K, no further hypothesis
(define cg5-fam `(SEP cgz_ (MAT n n (CARR K)) (FORSOME cgw_ (AND (IN cgw_ (CARR F)) (= cgz_ ,(cg5-mm 'cgw_))))))
(define cg5-fm-typed `(FORALL cfy_ (IMPLIES (IN cfy_ ,cg5-fam) (IN cfy_ (MAT n n (CARR K))))))
(define (cg5-comm a) `(FORALL cfy_ (IMPLIES (IN cfy_ ,cg5-fam) (= ,(cg5-x a 'cfy_) ,(cg5-x 'cfy_ a)))))
(define cg5-rigid
  `(FORALL cfb_ (IMPLIES (IN cfb_ (MAT n n (CARR K)))
     (IMPLIES ,(cg5-comm 'cfb_) (IMPLIES (= (DET ,cg5-v n cfb_) (ZERO K)) (= cfb_ ,cg5-znn))))))
(define cg5-h36
  `(FORALL x4s (IMPLIES (IN x4s (CARR F)) (FORALL x4t (IMPLIES (IN x4t (CARR F))
     (<= ((FNRM K) (DET ,cg5-v n (MATADD ,cg5-v ,(cg5-mm 'x4s) ,(cg5-mm 'x4t))))
         (MAX ((FNRM K) (DET ,cg5-v n ,(cg5-mm 'x4s))) ((FNRM K) (DET ,cg5-v n ,(cg5-mm 'x4t))))))))))
;; goal (FORALL cfy_ (IMPLIES (IN cfy_ fam) ...)): peel; land the member's xi with y = M(xi); return (y . xi)
(define (cg5-member!)
  (let* ((landed (dk-peel!))
         (m (let loop ((ls landed))
              (cond ((null? ls) (error "cg5-member!: no member"))
                    ((and (dk-head-is? (car ls) 'IN) (dk-contains? (car ls) 'SEP)) (car ls))
                    (#t (loop (cdr ls))))))
         (y (cadr m))
         (cnd `(FORSOME cgw_ (AND (IN cgw_ (CARR F)) (= ,y ,(cg5-mm 'cgw_)))))
         (ig (dk-project! cnd (lambda () (sep-me m))))
         (xi (dk-skolem! (dk-ctx-form cnd) #t)))
    (dk-split-all!)
    (cons y xi)))

(sp (make-wff (cg5-ext `(IMPLIES (IS-LOCAL-NV-FIELD K)
  (AND (IS-NV-VALUATION F (VNB-LAMBDA x4v (CARR F) ,(cg5-ea 'x4v)))
       (FORALL x4l (IMPLIES (IN x4l (CARR K)) (= ,(cg5-ea '((ACT md) x4l (ONE F))) (power ((FNRM K) x4l) n)))))))))
(dk-peel!)
(cg5-open!)
(dk-have! cg5-fm-typed
  (lambda ()
    (let* ((landed (dk-peel!))
           (m (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-contains? f 'SEP))) landed)))
      (dk-project! `(IN ,(cadr m) (MAT n n (CARR K))) (lambda () (sep-me m))))))
(dk-have! cg5-rigid
  (lambda ()
    (let* ((landed (dk-peel!))
           (bv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-contains? f 'MAT))) landed)))
           (cm (dk-ctx-form (cg5-comm bv))))
      (dk-have! `(FORALL cgx_ (IMPLIES (IN cgx_ (CARR F)) (= ,(cg5-x bv (cg5-mm 'cgx_)) ,(cg5-x (cg5-mm 'cgx_) bv))))
        (lambda ()
          (let* ((l2 (dk-peel!)) (xi (cadr (car l2))) (mx (cg5-mm xi)))
            (cg5-mm! xi)
            (dk-have! `(IN ,mx ,cg5-fam)
              (lambda ()
                (in-sep! (lambda ()
                  (ew xi)
                  (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!) (rfl))))))))
            (cg5-chain! (dk-apply! cm mx))
            (dk-ass!))))
      (cg5-c! 'ext-mult-mat-rigid 'K 'F 'md 'n 'u bv)
      (dk-ass!))))
(dk-have! cg5-h36
  (lambda ()
    (let* ((landed (dk-peel!))
           (xs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(CARR F)))) landed)))
           (sv (car xs)) (tv (cadr xs)))
      (cg5-mm! sv) (cg5-mm! tv)
      (for-each
        (lambda (a)
          (dk-have! (cg5-comm (cg5-mm a))
            (lambda ()
              (let* ((yx (cg5-member!)) (y (car yx)) (xi (cdr yx)))
                (cg5-mm! xi)
                (cg5-commute! a xi)
                (subst `(= ,y ,(cg5-mm xi)))
                (dk-ass!)))))
        (list sv tv))
      (cg5-c! 'ccr-3-6-fam 'K 'n cg5-fam (cg5-mm sv) (cg5-mm tv))
      (dk-ass!))))
(cg5-c! 'ccr-4-2 'K 'F 'md 'n 'u)
(dk-ass!)
(cg5-done! 'ccr-4-2-local)
(topic! 'ccr-4-2-local 'analysis)
(gloss! 'ccr-4-2-local
  "CCR Prop. 4.2: for K a local NV field and F a finite extension with basis u, |xi|_F = |det M(xi)| is an
   NV valuation of F with |l 1|_F = |l|^n on K.")
