;;; ccr-ch3d-ext.scm -- wave of 2026-11-09/10 (agent CCR-1109-B4), wired 2026-11-10 from scratchpad/ccr1109b4/ccr-ch3d-ext.scm.
;;; Library: analysis.

;;; ccr-ch3d-ext.scm -- CCR.pdf Proposition 4.2 with NO hypothesis beyond K local: the multiplication
;;; matrices {M(xi) : xi in F} of a finite extension are RIGID (a matrix commuting with every M(xi) and of
;;; determinant 0 is 0), so Proposition 3.6 holds on them (ccr-3-6-fam), and ccr-4-2 (CCR-1109-C2) applies.
;;; Agent CCR-1109-B4, wave 2026-11-09.  Destination: theorem-library/ccr-ch3d-ext.scm.  Library: analysis.
;;; Helper prefix cg5- (cg5-open!, cg5-chain!, cg5-side!, cg5-mm!, cg5-commute! are copies of the x4- / cd9-
;;; helpers of ccr4x-ext.scm and ccr-ch3c-ext.scm).
;;;
;;;   cg5-row-nonzero    e a non-zero column of K^n  =>  phi(e^T) /= 0, where phi(c) = (c u)_11 = sum_i c_i u_i
;;;                      (REL-FREE of the basis u)
;;;   cg5-row-span       c a row with phi(c) /= 0, d any row  =>  d = c M(w) for some w in F
;;;                      (w = phi(d) phi(c)^-1; phi(c M(w)) = w phi(c), by matact-assoc, ext-mult-mat-spec and
;;;                      hom-matact; then rel-free-matact-cancel)
;;;   ext-mult-mat-rigid B n-by-n, B M(xi) = M(xi) B for every xi in F, det B = 0  =>  B = 0
;;;   ccr-4-2-local      K a local NV field, F a finite extension of K with basis u  =>  |.|_F = |det M(.)| is an
;;;                      NV valuation of F, and |l 1|_F = |l|^n for l in K
;;;
;;; ROUTE OF THE RIGIDITY (no primitive element, no dimension count).  det B = det B^T = 0 gives a column
;;; e /= 0 with B^T e = 0 (ccr-det-zero-kernel), so the row c = e^T has c B = (B^T e)^T = 0 (transpose-matmul,
;;; transpose-transpose) and phi(c) /= 0.  Every row d is c M(w) for some w, so d B = c M(w) B = c B M(w) = 0;
;;; at d = UNITROW(i), (d B)_1j = B_ij (unitrow-matmul-entry).
;;;
;;; LOAD WINDOW: after theorem-library/ccr-ch3d-fam (this wave: ccr-3-6-fam), the latest citation; ccr4x-ext
;;; (CCR-1109-C2: ccr-4-2, ext-mult-mat-spec, ext-mult-mat-mul, ext-mult-op-hom, mult-op-type, mult-op-value),
;;; ccr-ch3b-alg (CCR-1109-B2: ccr-det-zero-kernel, cq4-zero-mul-gen-left), det-transpose, la-z2-action
;;; (matact-assoc, hom-matact), la-z4 (rel-free-matact-cancel) and the unitrow / transpose laws load earlier.
;;; No axiom, support or stamp.

(define cg5-v '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define (cg5-mm xi) `(MULT-MAT md n u F ,xi))
(define (cg5-ea xi) `(EXT-ABS K F md n u ,xi))
(define (cg5-fm a b) `((MUL F) ,a ,b))
(define (cg5-x a b) `(MATMUL ,cg5-v ,a ,b))
(define (cg5-mo xi) `(MULT-OP F ,xi))
(define (cg5-phi c) `(ENTRY (MATACT md ,c u) 1 1))
(define cg5-z1n `(ZEROMAT ,cg5-v 1 n))
(define cg5-zn1 `(ZEROMAT ,cg5-v n 1))
(define cg5-znn `(ZEROMAT ,cg5-v n n))
(define (cg5-ext body) `(FORALL K (FORALL F (FORALL md (FORALL n (FORALL u (IMPLIES (IS-FIN-EXT K F md n u) ,body)))))))

(define (cg5-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; cg5: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l)
                    (display ";;   GOAL ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (f) (display ";;      | ") (display (expression->string f)) (newline))
                              (let ((a (dk-asms-of l))) (list-head a (min 14 (length a))))))
                  (dk-open-leaves))))
  (qed name))
(define (cg5-dump! tag)
  (display ";; cg5 DUMP ") (display tag) (newline)
  (display ";;   GOAL ") (display (expression->string (dk-goal))) (newline)
  (for-each (lambda (f) (display ";;      | ") (display (expression->string f)) (newline))
            (let ((a (dk-asms))) (list-head a (min 40 (length a))))))

(define (cg5-side!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (ass))
          ((and (dk-head-is? g 'IMPLIES) (dk-head-is? (cadr g) '=) (equal? (caddr (cadr g)) 0))
           (let ((x (cadr (cadr g))))
             (di)
             (if (equal? x 1) (dk-nn-absurd! '(= 1 0)) (dk-nn-absurd! `(<= 1 ,x) `(= ,x 0)))))
          (#t (error "cg5-side!: cannot close" (expression->string g))))))
(define (cg5-chain! c . opt)
  (let ((pf (if (pair? opt) (car opt) #f)))
    (let loop ((c c))
      (if (not (dk-head-is? c 'IMPLIES)) c
          (begin
            (if (not (dk-asm? (cadr c)))
                (dk-have! (cadr c) (if (and pf (dk-head-is? (cadr c) 'FORALL)) pf cg5-side!)))
            (let ((new (dk-landed* (lambda () (detach! c)))))
              (loop (if (pair? new) (car new) (caddr c)))))))))
(define (cg5-c! . args) (cg5-chain! (apply dk-cite! args)))
(define (cg5-close-by! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (and (not (sequent-node-grounded? leaf)) (dk-asm? (dk-goal))) (ass))))
(define (cg5-one-11!)
  (if (not (dk-asm? '(IN 1 (INTERVAL 1 1))))
      (begin (fact 'nn-one-in) (dk-have! '(<= 1 1) (lambda () (dk-nn!))) (cg5-c! 'interval-mem-intro 1 1 1))))
(define (cg5-open!)
  (if (not (dk-asm? '(IS-MODULE md)))
      (begin
        (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! 'is-fin-ext 'K 'F 'md 'n 'u))))
        (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! 'is-field-ring-def 'F))))
        (cg5-c! 'commutative-ring-is-ring 'F)
        (cg5-c! 'module-scalar-ring 'md)
        (cg5-c! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
        (cg5-c! 'commutative-ring-is-ring cg5-v)
        (for-each (lambda (r) (dk-cite! r 'K))
                  '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
                    normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one))
        (dk-rewrite-h! '(IN u (MAT n 1 (CARR F))) '(CARR F) '(VEC md))
        (cg5-c! 'ring-one-in 'F) (cg5-c! 'ring-zero-in 'F)
        (fact 'nn-one-in)
        (cg5-one-11!)
        (dk-have! `(= (CARR (SCAL md)) (CARR ,cg5-v)) (lambda () (subst `(= (SCAL md) ,cg5-v)) (rfl))))))
;; a matrix typed over one of CARR K, CARR V, CARR (SCAL md): land the three
(define (cg5-ty! a m cols)
  (let ((ck `(IN ,a (MAT ,m ,cols (CARR K)))) (cv `(IN ,a (MAT ,m ,cols (CARR ,cg5-v))))
        (cs `(IN ,a (MAT ,m ,cols (CARR (SCAL md))))))
    (cond ((dk-asm? ck) #t)
          ((dk-asm? cv) (dk-rewrite-h! cv `(CARR ,cg5-v) '(CARR K)))
          ((dk-asm? cs) (dk-rewrite-h! cs '(CARR (SCAL md)) `(CARR ,cg5-v)) (dk-rewrite-h! cv `(CARR ,cg5-v) '(CARR K)))
          (#t (error "cg5-ty!: untyped" (expression->string a))))
    (if (not (dk-asm? cv)) (dk-rewrite-h! ck '(CARR K) `(CARR ,cg5-v)))
    (if (not (dk-asm? cs)) (dk-rewrite-h! cv `(CARR ,cg5-v) '(CARR (SCAL md))))))
(define (cg5-inf! x)                     ; x in VEC md  ->  x in CARR F
  (if (not (dk-asm? `(IN ,x (CARR F)))) (dk-rewrite-h! `(IN ,x (VEC md)) '(VEC md) '(CARR F))))
(define (cg5-mo-t! xi)
  (if (not (dk-asm? `(IN ,(cg5-mo xi) (FUN (VEC md) (VEC md)))))
      (begin
        (cg5-c! 'mult-op-type 'F xi)
        (dk-rewrite-h! `(IN ,(cg5-mo xi) (FUN (CARR F) (CARR F))) '(CARR F) '(VEC md)))))
(define (cg5-mm! xi)
  (if (not (dk-asm? `(IN ,(cg5-mm xi) (MAT n n (CARR K)))))
      (dk-split-all! (list (cg5-c! 'ext-mult-mat-spec 'K 'F 'md 'n 'u xi))))
  (cg5-ty! (cg5-mm xi) 'n 'n))
;; i in INTERVAL(1, 1)  =>  i = 1
(define (cg5-is-one! i)
  (if (not (dk-asm? `(= ,i 1)))
      (begin
        (fact 'interval-lo 1 1 i) (fact 'interval-hi 1 1 i) (fact 'interval-elt-in-nn 1 1 i)
        (cg5-c! 'nn-le-antisym i 1))))
;; the peeled pair of a matrix-entry-extensionality antecedent: return (i j) read off the goal
(define (cg5-ij)
  (let ((l (cadr (dk-goal)))) (list (caddr l) (cadddr l))))
;; M(a) M(th) = M(th) M(a)
(define (cg5-commute! a th)
  (let ((g `(= ,(cg5-x (cg5-mm a) (cg5-mm th)) ,(cg5-x (cg5-mm th) (cg5-mm a)))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (cg5-c! 'ring-carrier-closed-mul 'F a th) (cg5-c! 'ring-carrier-closed-mul 'F th a)
            (cg5-c! 'ext-mult-mat-mul 'K 'F 'md 'n 'u th a)
            (cg5-c! 'ext-mult-mat-mul 'K 'F 'md 'n 'u a th)
            (cg5-c! 'commutative-ring-mul-comm 'F a th)
            (subst `(= ,(cg5-x (cg5-mm a) (cg5-mm th)) ,(cg5-mm (cg5-fm th a))))
            (subst `(= ,(cg5-fm th a) ,(cg5-fm a th)))
            (dk-ass!))))
    g))

;;; =====================================================================
;;; cg5-row-nonzero
(sp (make-wff (cg5-ext `(FORALL cge (IMPLIES (IN cge (MAT n 1 (CARR K))) (IMPLIES (NOT (= cge ,cg5-zn1))
  (NOT (= ,(cg5-phi '(TRANSPOSE cge n 1)) (ZERO F)))))))))
(dk-peel!)
(cg5-open!)
(let* ((c '(TRANSPOSE cge n 1)))
  (cg5-c! 'transpose-in-mat 'cge 'n 1 '(CARR K))
  (cg5-ty! c 1 'n)
  (cg5-ty! 'cge 'n 1)
  (di)
  (let* ((me (cg5-c! 'matact-entry 'md 1 'n 1 c 'u))
         (e11 (cg5-chain! (dk-apply! me 1 1)))
         (z0 (dk-rewrite-h! `(= ,(cg5-phi c) (ZERO F)) (cg5-phi c) (caddr e11))))
    (dk-have! `(= (LINCOMB md n ,c u) (VZERO md))
      (lambda ()
        (mac 'LINCOMB)
        (subst '(= (VZERO md) (ZERO F)))
        (dk-ass!)))
    (let* ((rf (dk-meta-iff-r! (dk-meta-iff! 'rel-free 'md 'n 'u)))
           (allz (cg5-chain! (dk-apply! rf c))))
      (cg5-c! 'zeromat-type cg5-v 'n 1)
      (dk-have! `(= cge ,cg5-zn1)
        (lambda ()
          (cg5-chain! (dk-cite! 'matrix-entry-extensionality 'n 1 `(CARR ,cg5-v) 'cge cg5-zn1)
            (lambda ()
              (dk-peel!)
              (let* ((ij (cg5-ij)) (i (car ij)) (j (cadr ij)))
                (cg5-is-one! j)
                (subst `(= ,j 1))
                (cg5-c! 'transpose-entry 'cge 'n 1 '(CARR K) 1 i)
                (cg5-chain! (dk-apply! allz i))
                (cg5-c! 'entry-of-zeromat cg5-v 'n 1 i 1)
                (subst `(= (ENTRY cge ,i 1) (ENTRY ,c 1 ,i)))
                (subst `(= (ENTRY ,c 1 ,i) (ZERO (SCAL md))))
                (subst `(= (ENTRY ,cg5-zn1 ,i 1) (ZERO ,cg5-v)))
                (subst `(= (SCAL md) ,cg5-v))
                (cg5-c! 'ring-zero-in cg5-v)
                (rfl))))
          (dk-ass!)))
      (ai (dk-ctx-form `(NOT (= cge ,cg5-zn1)))))))
(cg5-done! 'cg5-row-nonzero)
(topic! 'cg5-row-nonzero 'plumbing)

;;; =====================================================================
;;; cg5-row-span
(sp (make-wff (cg5-ext `(FORALL cgc (IMPLIES (IN cgc (MAT 1 n (CARR K))) (IMPLIES (NOT (= ,(cg5-phi 'cgc) (ZERO F)))
  (FORALL cgd (IMPLIES (IN cgd (MAT 1 n (CARR K)))
    (FORSOME cgw_ (AND (IN cgw_ (CARR F)) (= cgd ,(cg5-x 'cgc (cg5-mm 'cgw_)))))))))))))
(dk-peel!)
(cg5-open!)
(cg5-ty! 'cgc 1 'n)
(cg5-ty! 'cgd 1 'n)
(let* ((y (cg5-phi 'cgc)) (z (cg5-phi 'cgd))
       (yc '(MATACT md cgc u)) (zd '(MATACT md cgd u)))
  (cg5-c! 'matact-type 'md 1 'n 1 'cgc 'u)
  (cg5-c! 'matact-type 'md 1 'n 1 'cgd 'u)
  (cg5-c! 'entry-in-carrier 1 1 '(VEC md) yc 1 1)
  (cg5-c! 'entry-in-carrier 1 1 '(VEC md) zd 1 1)
  (cg5-inf! y) (cg5-inf! z)
  (let* ((inv (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'FORSOME) (dk-contains? h '(ONE F)))) "the inverse law"))
         (b (dk-skolem! (cg5-chain! (dk-apply! inv y))))
         (ig (dk-split-all!))
         (w (cg5-fm z b))
         (mw (cg5-mm w))
         (g (cg5-mo w))
         (cmw (cg5-x 'cgc mw)))
    (cg5-c! 'ring-carrier-closed-mul 'F z b)
    (cg5-mm! w)
    (cg5-mo-t! w)
    (cg5-c! 'matmul-type cg5-v 1 'n 'n 'cgc mw)
    (cg5-ty! cmw 1 'n)
    (ew w)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (dk-ass!)
            (begin
              ;; phi-level: MATACT(d) = MATACT(c M(w))
              (dk-have! `(= (MATACT md cgd u) (MATACT md ,cmw u))
                (lambda ()
                  (let* ((as0 (cg5-c! 'matact-assoc 'md 1 'n 'n 1 'cgc mw 'u))
                         (as1 (dk-rewrite-h! as0 '(SCAL md) cg5-v)))
                    (subst as1)
                    (subst `(= (MATACT md ,mw u) (MAP-SEQ ,g n u)))
                    (cg5-c! 'ext-mult-op-hom 'K 'F 'md 'n 'u w)
                    (subst (cg5-c! 'hom-matact 'md g 1 'n 'cgc 'u))
                    (cg5-c! 'map-seq-type g '(VEC md) '(VEC md) 1 yc)
                    (cg5-chain! (dk-cite! 'matrix-entry-extensionality 1 1 '(VEC md) zd `(MAP-SEQ ,g 1 ,yc))
                      (lambda ()
                        (dk-peel!)
                        (let* ((ij (cg5-ij)) (i (car ij)) (j (cadr ij)))
                          (cg5-is-one! i) (cg5-is-one! j)
                          (subst `(= ,i 1)) (subst `(= ,j 1))
                          (subst (cg5-c! 'map-seq-entry g '(VEC md) '(VEC md) 1 yc 1))
                          (subst (cg5-c! 'mult-op-value 'F w y))
                          (dk-have! `(= ,(cg5-fm w y) ,(cg5-fm z (cg5-fm y b))) (lambda () (crs)))
                          (subst `(= ,(cg5-fm w y) ,(cg5-fm z (cg5-fm y b))))
                          (subst `(= ,(cg5-fm y b) (ONE F)))
                          (dk-have! `(= ,(cg5-fm z '(ONE F)) ,z) (lambda () (crs)))
                          (subst `(= ,(cg5-fm z '(ONE F)) ,z))
                          (rfl))))
                    (dk-ass!))))
              (cg5-close-by! (lambda () (cg5-c! 'rel-free-matact-cancel 'md 1 'n 'u 'cgd cmw)))))))))
(cg5-done! 'cg5-row-span)
(topic! 'cg5-row-span 'plumbing)

;;; =====================================================================
;;; ext-mult-mat-rigid
(sp (make-wff (cg5-ext `(FORALL B (IMPLIES (IN B (MAT n n (CARR K)))
  (IMPLIES (FORALL cgx_ (IMPLIES (IN cgx_ (CARR F)) (= ,(cg5-x 'B (cg5-mm 'cgx_)) ,(cg5-x (cg5-mm 'cgx_) 'B))))
  (IMPLIES (= (DET ,cg5-v n B) (ZERO K)) (= B ,cg5-znn))))))))
(dk-peel!)
(cg5-open!)
(cg5-ty! 'B 'n 'n)
(let* ((bt '(TRANSPOSE B n n))
       (comm (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'MULT-MAT) (dk-contains? h 'B))) "the commutation")))
  (cg5-c! 'transpose-in-mat 'B 'n 'n '(CARR K))
  (cg5-ty! bt 'n 'n)
  (cg5-c! 'det-transpose cg5-v 'n 'B)
  (dk-have! `(= (DET ,cg5-v n ,bt) (ZERO K))
    (lambda () (subst `(= (DET ,cg5-v n ,bt) (DET ,cg5-v n B))) (dk-ass!)))
  (let* ((ev (dk-skolem! (cg5-c! 'ccr-det-zero-kernel 'K 'n bt) #t))
         (ig (dk-split-all!))
         (c `(TRANSPOSE ,ev n 1)))
    (cg5-ty! ev 'n 1)
    (cg5-c! 'transpose-in-mat ev 'n 1 '(CARR K))
    (cg5-ty! c 1 'n)
    (cg5-c! 'cg5-row-nonzero 'K 'F 'md 'n 'u ev)
    ;; c B = 0
    (cg5-c! 'zeromat-type cg5-v 'n 1)
    (cg5-c! 'zeromat-type cg5-v 1 'n)
    (cg5-c! 'transpose-in-mat cg5-zn1 'n 1 `(CARR ,cg5-v))
    (dk-have! `(= (TRANSPOSE ,cg5-zn1 n 1) ,cg5-z1n)
      (lambda ()
        (cg5-chain! (dk-cite! 'matrix-entry-extensionality 1 'n `(CARR ,cg5-v) `(TRANSPOSE ,cg5-zn1 n 1) cg5-z1n)
          (lambda ()
            (dk-peel!)
            (let* ((ij (cg5-ij)) (i (car ij)) (j (cadr ij)))
              (subst (cg5-c! 'transpose-entry cg5-zn1 'n 1 `(CARR ,cg5-v) i j))
              (subst (cg5-c! 'entry-of-zeromat cg5-v 'n 1 j i))
              (subst (cg5-c! 'entry-of-zeromat cg5-v 1 'n i j))
              (cg5-c! 'ring-zero-in cg5-v)
              (rfl))))
        (dk-ass!)))
    (let* ((t0 (cg5-c! 'transpose-matmul cg5-v 'n 'n 1 bt ev)))
      (cg5-c! 'transpose-transpose 'B 'n 'n '(CARR K))
      (let* ((t1 (dk-rewrite-h! t0 `(TRANSPOSE ,bt n n) 'B))
             (t2 (dk-rewrite-h! t1 (cg5-x bt ev) cg5-zn1))
             (t3 (dk-rewrite-h! t2 `(TRANSPOSE ,cg5-zn1 n 1) cg5-z1n)))
        ;; every row d has d B = 0
        (let ((rows `(FORALL cgd (IMPLIES (IN cgd (MAT 1 n (CARR K))) (= ,(cg5-x 'cgd 'B) ,cg5-z1n)))))
          (dk-have! rows
            (lambda ()
              (let* ((landed (dk-peel!)) (d (cadr (car landed)))
                     (sp0 (cg5-c! 'cg5-row-span 'K 'F 'md 'n 'u c))
                     (wv (dk-skolem! (cg5-chain! (dk-apply! sp0 d)) #t))
                     (ig2 (dk-split-all!))
                     (mw (cg5-mm wv)))
                (cg5-ty! d 1 'n)
                (cg5-mm! wv)
                (cg5-chain! (dk-apply! comm wv))
                (subst `(= ,d ,(cg5-x c mw)))
                (subst (cg5-c! 'matmul-assoc cg5-v 1 'n 'n 'n c mw 'B))
                (subst `(= ,(cg5-x mw 'B) ,(cg5-x 'B mw)))
                (cg5-c! 'matmul-assoc cg5-v 1 'n 'n 'n c 'B mw)
                (subst `(= ,(cg5-x c (cg5-x 'B mw)) ,(cg5-x (cg5-x c 'B) mw)))
                (subst `(= ,(cg5-x c 'B) ,cg5-z1n))
                (cg5-c! 'cq4-zero-mul-gen-left cg5-v 1 'n 'n mw)
                (dk-ass!))))
          ;; B = 0, entry by entry, through the unit rows
          (cg5-c! 'zeromat-type cg5-v 'n 'n)
          (cg5-chain! (dk-cite! 'matrix-entry-extensionality 'n 'n `(CARR ,cg5-v) 'B cg5-znn)
            (lambda ()
              (dk-peel!)
              (let* ((ij (cg5-ij)) (i (car ij)) (j (cadr ij))
                     (d `(UNITROW ,cg5-v n ,i)))
                (cg5-c! 'unitrow-type cg5-v 'n i)
                (cg5-ty! d 1 'n)
                (cg5-chain! (dk-apply! (dk-ctx-form rows) d))
                (cg5-c! 'unitrow-matmul-entry cg5-v 'n 'n 'B i j)
                (subst `(= (ENTRY B ,i ,j) (ENTRY ,(cg5-x d 'B) 1 ,j)))
                (subst `(= ,(cg5-x d 'B) ,cg5-z1n))
                (cg5-c! 'interval-mem-intro 1 1 1)
                (subst (cg5-c! 'entry-of-zeromat cg5-v 1 'n 1 j))
                (subst (cg5-c! 'entry-of-zeromat cg5-v 'n 'n i j))
                (cg5-c! 'ring-zero-in cg5-v)
                (rfl))))
          (dk-ass!))))))
(cg5-done! 'ext-mult-mat-rigid)
(topic! 'ext-mult-mat-rigid 'analysis)
(gloss! 'ext-mult-mat-rigid
  "A matrix commuting with every multiplication matrix M(xi) of a finite extension, and of determinant 0, is 0.")

