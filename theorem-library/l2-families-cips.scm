;;; l2p-2.scm -- slice 2: l2(I) is a complex inner product space.

(define l2p-RING '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define l2p-S '(L2-CIPS ix))

;;; l2(I) is a set
(sp (make-wff (list 'FORALL 'ix (list 'IMPLIES '(IN ix SET) (list 'IN l2p-LF 'SET)))))
(dk-peel!)
(fact 'cc-is-set)
(dk-have! (list 'SUBSET l2p-LF '(FUN ix CC))
  (lambda ()
    (mac 'subset-def)
    (let ((z (dk-di-var!)))
      (l2p-elim! z)
      (dk-ass!))))
(let ((iff (dk-cite! 'fun-set-iff 'ix 'CC)))
  (dk-have! '(IN (FUN ix CC) SET) (lambda () (if (dk-only! iff '(IN ix SET) '(IN CC SET)) (prop)))))
(fact 'subclass-of-set-is-set l2p-LF '(FUN ix CC))
(l2p-close!)
(l2p-done! 'l2-families-is-set)

;;; ---------------------------------------------------------------------------
;;; the drive of a conjunct
(define (l2p-op? f h) (and (pair? f) (equal? (car f) h)))
;; type an l2 expression x
(define (l2p-ty! x)
  (let ((want (l2p-in x)))
    (cond ((dk-asm? want) #t)
          ((equal? x l2p-VZ) (fact 'l2-vzero-in 'ix))
          ((l2p-op? x l2p-VA) (l2p-ty! (cadr x)) (l2p-ty! (caddr x)) (fact 'l2-vadd-type 'ix (cadr x) (caddr x)))
          ((l2p-op? x l2p-AC) (l2p-sc! (cadr x)) (l2p-ty! (caddr x)) (fact 'l2-act-type 'ix (cadr x) (caddr x)))
          ((l2p-op? x l2p-VN) (l2p-ty! (cadr x)) (fact 'l2-vneg-type 'ix (cadr x)))
          (#t (error "l2p-ty!: cannot type" (expression->string x))))
    (if (not (dk-asm? want)) (error "l2p-ty!: the typing did not land" (expression->string x)))))
;; type a scalar expression in CC
(define (l2p-sc! z)
  (let ((want (list 'IN z 'CC)))
    (cond ((dk-asm? want) #t)
          ((number? z) (dk-have! want (lambda () (arith))))
          ((dk-head-is? z '+) (l2p-sc! (cadr z)) (l2p-sc! (caddr z)) (l2p-and! (list 'IN (cadr z) 'CC) (list 'IN (caddr z) 'CC)) (fact 'cc-add-closed (cadr z) (caddr z)))
          ((dk-head-is? z '*) (l2p-sc! (cadr z)) (l2p-sc! (caddr z)) (l2p-and! (list 'IN (cadr z) 'CC) (list 'IN (caddr z) 'CC)) (fact 'cc-mul-closed (cadr z) (caddr z)))
          ((dk-head-is? z '-) (l2p-sc! (cadr z)) (fact 'cc-neg-closed (cadr z)))
          (#t (error "l2p-sc!: cannot type" (expression->string z))))))
;; the first redex (X k) of the l2 operations in e
(define (l2p-redex e k)
  (cond ((not (pair? e)) #f)
        ((and (list? e) (= (length e) 2) (equal? (cadr e) k)
              (or (equal? (car e) l2p-VZ) (l2p-op? (car e) l2p-VA) (l2p-op? (car e) l2p-AC) (l2p-op? (car e) l2p-VN)))
         e)
        (#t (let loop ((xs e)) (cond ((null? xs) #f) ((not (pair? xs)) #f) ((l2p-redex (car xs) k)) (#t (loop (cdr xs))))))))
;; rewrite the pointwise goal at k to scalars
(define (l2p-pt-norm! k)
  (let loop ((fuel 30))
    (let ((rx (l2p-redex (dk-goal) k)))
      (if (and rx (> fuel 0))
          (let* ((x (car rx))
                 (eqn (cond ((equal? x l2p-VZ) (dk-cite! 'l2-vzero-apply 'ix k))
                            ((l2p-op? x l2p-VA) (dk-cite! 'l2-vadd-apply 'ix (cadr x) (caddr x) k))
                            ((l2p-op? x l2p-AC) (dk-cite! 'l2-act-apply 'ix (cadr x) (caddr x) k))
                            (#t (dk-cite! 'l2-vneg-apply 'ix (cadr x) k)))))
            (subst eqn)
            (loop (- fuel 1)))))))
;; the variables of an l2 expression (symbols typed in L2 in context)
(define (l2p-vars x)
  (cond ((and (symbol? x) (dk-asm? (l2p-in x))) (list x))
        ((pair? x) (append-map l2p-vars x))
        (#t '())))
;; close (= L R) between l2 expressions by extensionality
(define (l2p-eq!)
  (let* ((g (dk-goal)) (L (cadr g)) (R (caddr g)))
    (l2p-ty! L) (l2p-ty! R)
    (let ((vs (delete-duplicates (append (l2p-vars L) (l2p-vars R)))))
      (let ((pw (list 'FORALL 'l2e_ (list 'IMPLIES '(IN l2e_ ix) (list '= (list L 'l2e_) (list R 'l2e_))))))
        (dk-have! pw
          (lambda ()
            (let ((k (cadr (car (dk-peel!)))))
              (for-each (lambda (a) (l2p-pt! a k)) vs)
              (l2p-pt-norm! k)
              (if (l2p-open?) (crs)))))
        (fact 'l2-families-ext 'ix L R)
        (l2p-close!)))))
;; rewrite (ADD RING) / (MUL RING) redexes in the goal to + and *
(define (l2p-ring-norm!)
  (let loop ((fuel 8))
    (let ((rx (let find ((e (dk-goal)))
                (and (pair? e) (list? e)
                     (or (let inner ((xs e)) (cond ((null? xs) #f) ((find (car xs))) (#t (inner (cdr xs)))))
                         (and (or (equal? (car e) (list 'ADD l2p-RING)) (equal? (car e) (list 'MUL l2p-RING))) (= (length e) 3) e))))))
      (if (and rx (> fuel 0))
          (begin (subst (dk-cite! (if (equal? (car rx) (list 'ADD l2p-RING)) 'sip-cc-ring-add-value 'sip-cc-ring-mul-value)
                                  (cadr rx) (caddr rx)))
                 (loop (- fuel 1)))))))
(define (l2p-peel-vars!)
  (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))
;; the FUN typing of an operation: (IN OP (FUN DOM COD)); OP unfolded by NAME
(define (l2p-fun-type! name)
  (mac name)
  (dk-lam-type!
    (lambda ()
      (let* ((vs (l2p-peel-vars!)) (g (dk-goal)) (x (cadr g)))
        (cond
          ((dk-asm? g) (ass))
          ((equal? (caddr g) 'CC)
           (dk-split-all! (list (dk-cite! 'l2-ip-family-sums 'ix (car vs) (cadr vs)))) (dk-ass!))
          ((eq? name 'L2F-VADD) (fact 'l2-families-add-closed 'ix (car vs) (cadr vs)) (dk-ass!))
          ((eq? name 'L2F-ACT) (fact 'l2-families-act-closed 'ix (car vs) (cadr vs)) (dk-ass!))
          ((eq? name 'L2F-VNEG) (fact 'l2-families-neg-closed 'ix (car vs)) (dk-ass!))
          (#t (error "l2p-fun-type!" (expression->string g))))))
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (ass))
              ((dk-head-is? (cadr g) 'CARTESIAN)
               (let ((iff (dk-cite! 'cartesian-set-iff (cadr (cadr g)) (caddr (cadr g)))))
                 (if (dk-only! iff (list 'IN (cadr (cadr g)) 'SET) (list 'IN (caddr (cadr g)) 'SET)) (prop))))
              (#t (error "l2p-fun-type! domain" (expression->string g))))))))

;;; the FUN typings of the operations
(define (l2p-fun-thm! name op dom cod)
  (sp (make-wff (list 'FORALL 'ix (list 'IMPLIES '(IN ix SET) (list 'IN op (list 'FUN dom cod))))))
  (dk-peel!)
  (fact 'cc-is-set)
  (fact 'l2-families-is-set 'ix)
  (l2p-fun-type! (car op))
  (l2p-done! name))
(l2p-fun-thm! 'l2-vadd-fun l2p-VA (list 'CARTESIAN l2p-LF l2p-LF) l2p-LF)
(l2p-fun-thm! 'l2-act-fun l2p-AC (list 'CARTESIAN 'CC l2p-LF) l2p-LF)
(l2p-fun-thm! 'l2-vneg-fun l2p-VN l2p-LF l2p-LF)
(l2p-fun-thm! 'l2-ip-fun l2p-IPL (list 'CARTESIAN l2p-LF l2p-LF) 'CC)
;; ix in SET in context: every component of the tuple typed, and in SET
(define (l2p-comp-sets!)
  (fact 'cc-is-set)
  (fact 'cc-is-normed-field)
  (fact 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
  (fact 'is-commutative-ring-is-set l2p-RING)
  (fact 'l2-families-is-set 'ix)
  (fact 'l2-vzero-in 'ix)
  (fact 'membership-implies-sethood l2p-VZ l2p-LF)
  (for-each (lambda (n op cls)
              (fact n 'ix)
              (fact 'membership-implies-sethood op cls))
            '(l2-vadd-fun l2-act-fun l2-vneg-fun l2-ip-fun)
            (list l2p-VA l2p-AC l2p-VN l2p-IPL)
            (list (list 'FUN (list 'CARTESIAN l2p-LF l2p-LF) l2p-LF) (list 'FUN (list 'CARTESIAN 'CC l2p-LF) l2p-LF)
                  (list 'FUN l2p-LF l2p-LF) (list 'FUN (list 'CARTESIAN l2p-LF l2p-LF) 'CC))))
(define l2p-LIST (list 'LIST l2p-RING l2p-LF l2p-VA l2p-VZ l2p-VN l2p-AC l2p-IPL))
;;; the read-offs of the seven-tuple
(define (l2p-read-off! name acc val)
  (sp (make-wff (list 'FORALL 'ix (list 'IMPLIES '(IN ix SET) (list '== (list acc l2p-S) val)))))
  (dk-peel!)
  (l2p-comp-sets!)
  (dk-have! (list 'IN l2p-LIST 'SET) (lambda () (dk-list-in-set!)))
  (slot acc)
  (mac 'L2-CIPS)
  (nth-r)
  (if (l2p-open?) (qrfl))
  (for-each (lambda (l) (dk-focus! l) (if (dk-asm? (dk-goal)) (ass) (rfl))) (dk-open-leaves))
  (l2p-done! name))
(l2p-read-off! 'l2-cips-scal 'SCAL l2p-RING)
(l2p-read-off! 'l2-cips-vec 'VEC l2p-LF)
(l2p-read-off! 'l2-cips-vadd 'VADD l2p-VA)
(l2p-read-off! 'l2-cips-vzero 'VZERO l2p-VZ)
(l2p-read-off! 'l2-cips-vneg 'VNEG l2p-VN)
(l2p-read-off! 'l2-cips-act 'ACT l2p-AC)
(l2p-read-off! 'l2-cips-ip 'IP l2p-IPL)

;;; ---------------------------------------------------------------------------
;;; THE PACKAGED STATEMENT: l2(I) with the pointwise operations and <a,b> = sum a_i conj(b_i) is a
;;; complex inner product space (the vocabulary's L2-CIPS(ix)), for every index SET ix.
(sp (make-wff (list 'FORALL 'ix (list 'IMPLIES '(IN ix SET) (list 'IS-COMPLEX-INNER-PRODUCT-SPACE l2p-S)))))
(dk-peel!)
(fact 'cc-is-set)
(fact 'cc-is-normed-field)
(fact 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
(fact 'commutative-ring-is-ring l2p-RING)
(l2p-comp-sets!)
(mac 'IS-COMPLEX-INNER-PRODUCT-SPACE)
(dk-isx-set! 'L2-CIPS)
(for-each (lambda (n) (subst (dk-cite! n 'ix)))
  '(l2-cips-scal l2-cips-vec l2-cips-vadd l2-cips-vzero l2-cips-vneg l2-cips-act l2-cips-ip))
(fact 'sip-cc-ring-carr)
(fact 'sip-cc-ring-one)
(subst (list '= (list 'CARR l2p-RING) 'CC))
(subst (list '= (list 'ONE l2p-RING) 1))
(define (l2p-conj!)
  (let ((g (dk-goal)))
    (cond
      ((dk-asm? g) (ass))
      ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))
      ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH))
       (mac 'L2-CIPS) (len-r) (if (l2p-open?) (arith)))
      ((and (dk-head-is? g 'IN) (equal? (cadr g) l2p-VA)) (l2p-fun-type! 'L2F-VADD))
      ((and (dk-head-is? g 'IN) (equal? (cadr g) l2p-AC)) (l2p-fun-type! 'L2F-ACT))
      ((and (dk-head-is? g 'IN) (equal? (cadr g) l2p-VN)) (l2p-fun-type! 'L2F-VNEG))
      ((and (dk-head-is? g 'IN) (equal? (cadr g) l2p-IPL)) (l2p-fun-type! 'L2-IP))
      ((memq (car g) '(is-associative is-commutative is-identity has-inverses))
       (mac (car g))
       (l2p-peel-vars!)
       (if (dk-head-is? (dk-goal) 'AND) (dk-conj-close! l2p-eq!) (l2p-eq!)))
      ((dk-head-is? g 'FORALL)
       (let* ((vs (l2p-peel-vars!)) (g2 (dk-goal)))
         (cond
           ((dk-asm? g2) (ass))
           ((and (dk-head-is? g2 '=) (dk-contains? g2 l2p-IPL))
            (cond
              ((dk-contains? (cadr g2) l2p-VA) (fact 'l2-ip-add-left 'ix (car vs) (cadr vs) (caddr vs)) (l2p-close!))
              ((dk-contains? (cadr g2) l2p-AC) (fact 'l2-ip-act-left 'ix (car vs) (cadr vs) (caddr vs)) (l2p-close!))
              (#t (fact 'l2-ip-conj-sym 'ix (car vs) (cadr vs)) (l2p-close!))))
           ((dk-head-is? g2 'IFF) (fact 'l2-ip-self-zero 'ix (car vs)) (l2p-close!))
           ((dk-contains? g2 l2p-IPL)
            (dk-split-all! (list (dk-cite! 'l2-ip-self 'ix (car vs)))) (l2p-close!))
           (#t (l2p-ring-norm!) (l2p-eq!)))))
      (#t (error "l2p: unexpected conjunct" (expression->string g))))))
(dk-conj-close! l2p-conj!)
(l2p-done! 'l2-cips-is-cips)
