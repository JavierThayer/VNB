;; the negative is the action of -1, pointwise
(sp (make-wff '(FORALL ix (FORALL a (IMPLIES (IN a (L2-FAMILIES ix))
   (IN (VNB-LAMBDA l2k_ ix (- (a l2k_))) (L2-FAMILIES ix)))))))
(dk-peel!)
(l2p-elim! 'a)
(dk-have! '(IN 1 CC) (lambda () (arith)))
(fact 'cc-neg-closed 1)
(let* ((m1 '(- 1))
       (S1 (list 'VNB-LAMBDA 'b3a_ 'ix (list '* m1 '(a b3a_))))
       (N1 '(VNB-LAMBDA l2k_ ix (- (a l2k_)))))
  (fact 'l2-families-act-closed 'ix m1 'a)
  (fact 'l2-families-elim 'ix S1)
  (dk-fun-ext! N1 S1 'ix 'CC
    (lambda ()
      (dk-lam-type!
        (lambda () (let ((k (dk-di-var!))) (l2p-pt! 'a k) (fact 'cc-neg-closed (list 'a k)) (dk-ass!)))
        (lambda () (fact 'fun-domain-in-set 'ix 'CC 'a) (ass))))
    (lambda () (dk-split-all! (list (dk-cite! 'l2-families-elim 'ix S1))) (ass))
    (lambda (k)
      (l2p-pt! 'a k)
      (dk-lam-b!)
      (if (l2p-open?) (crs))))
  (subst (list '= N1 S1))
  (l2p-close!))
(l2p-done! 'l2-families-neg-closed)

(sp (make-wff '(FORALL ix (FORALL a (IMPLIES (IN a (L2-FAMILIES ix))
   (IN ((L2F-VNEG ix) a) (L2-FAMILIES ix)))))))
(dk-peel!)
(fact 'l2-families-neg-closed 'ix 'a)
(fact 'membership-implies-sethood '(VNB-LAMBDA l2k_ ix (- (a l2k_))) '(L2-FAMILIES ix))
(mac 'L2F-VNEG)
(dk-lam-b!)
(l2p-close!)
(l2p-done! 'l2-vneg-type)

;; the zero family is square-summable: every finite partial sum of its squares is 0
(sp (make-wff '(FORALL ix (IMPLIES (IN ix SET) (IN (L2F-VZERO ix) (L2-FAMILIES ix))))))
(dk-peel!)
(let* ((zf '(VNB-LAMBDA l2k_ ix 0))
       (g '(VNB-LAMBDA l2z_ ix 0))
       (dg (list 'DOM g)))
  (mac 'L2F-VZERO)
  (fact 'rr-zero-in)
  (fact 'rr-subset-cc 0)
  (dk-have! (list 'IN zf '(FUN ix CC))
    (lambda () (dk-lam-type! (lambda () (dk-peel!) (dk-ass!)) (lambda () (ass)))))
  ;; g in FUN(ix, RPS), DOM g = ix
  (dk-have! '(IN 0 RR-POS-STAR)
    (lambda () (let ((iff (dk-cite! 'rr-pos-star-membership 0)))
                 (dk-have! '(<= 0 0) (lambda () (dk-ineq! '(IN 0 RR))))
                 (if (dk-only! iff '(IN 0 RR) '(<= 0 0)) (prop)))))
  (dk-have! (list 'IN g '(FUN ix RR-POS-STAR))
    (lambda () (dk-lam-type! (lambda () (dk-peel!) (dk-ass!)) (lambda () (ass)))))
  (dk-project! (list 'IN g '(FUN ix)) 'fun-codomain-iff (list 'IN g '(FUN ix RR-POS-STAR)))
  (l2p-and! (list 'IN g '(FUN ix)) '(IN ix SET))
  (fact 'dom-of-fun 'ix g)
  (let ((dd2 (dk-ctx-form (list 'AND (list 'IN dg 'SET) (list '= dg 'ix)))))
    (if dd2 (dk-split-all! (list dd2))))
  (dk-have! (list 'IN g (list 'FUN dg 'RR-POS-STAR))
    (lambda () (subst (list '= dg 'ix)) (dk-ass!)))
  (fact 'rr-pos-star-is-comm-monoid)
  (dk-have! '(== (IDEN RR-POS-STAR-ADD-MONOID) 0)
    (lambda () (quietly (lambda () (surface-goal! 'RR-POS-STAR-ADD-MONOID))) (qrfl)))
  ;; ESUM g in RR
  (let ((bd (list 'FORSOME 'm (list 'AND '(IN m RR)
              (list 'FORALL 's (list 'IMPLIES (list 'AND '(IN s SET) (list 'AND '(IN (CARD s) NN) (list 'SUBSET 's dg)))
                (list '<= (list 'FINSUM 'RR-POS-STAR-ADD-MONOID g 's) 'm)))))))
    (dk-have! bd
      (lambda ()
        (ew 0)
        (dk-conj-close!
          (lambda ()
            (cond
              ((dk-ass!) #t)
              (#t
               (let* ((ld (dk-peel!))
                      (sp0 (dk-split-all!))
                      (s (cadddr (cadr (dk-goal)))))
                 (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ s) (list '= (list g 'z_) '(IDEN RR-POS-STAR-ADD-MONOID))))
                   (lambda ()
                     (let ((z (cadr (car (dk-peel!)))))
                       (fact 'subset-mem-fwd s dg z)
                       (dk-rewrite-h! (list 'IN z dg) dg 'ix)
                       (subst '(== (IDEN RR-POS-STAR-ADD-MONOID) 0))
                       (dk-lam-b!)
                       (l2p-close!))))
                 (fact 'finsum-cm-all-iden-ptwise 'RR-POS-STAR-ADD-MONOID s g)
                 (subst (list '= (list 'FINSUM 'RR-POS-STAR-ADD-MONOID g 's) '(IDEN RR-POS-STAR-ADD-MONOID)))
                 (subst '(== (IDEN RR-POS-STAR-ADD-MONOID) 0))
                 (dk-ineq! '(IN 0 RR)))))))))
    (fact 'esum-bounded-implies-finite g))
  ;; the square family of zf is g
  (let ((qz (list 'VNB-LAMBDA 'l2k_ 'ix (list '* (list 'MAGNITUDE (list zf 'l2k_)) (list 'MAGNITUDE (list zf 'l2k_))))))
    (fact 'cc-magnitude-zero)
    (dk-have! '(= (* 0 0) 0) (lambda () (crs)))
    (dk-fun-ext! qz g 'ix 'RR-POS-STAR
      (lambda ()
        (dk-lam-type!
          (lambda () (let ((k (dk-di-var!)))
                       (dk-lam-b!)
                       (subst '(= (MAGNITUDE 0) 0))
                       (subst '(= (* 0 0) 0))
                       (dk-ass!)))
          (lambda () (ass))))
      (lambda () (ass))
      (lambda (k)
        (dk-lam-b!)
        (if (l2p-open?) (begin (subst '(= (MAGNITUDE 0) 0)) (subst '(= (* 0 0) 0)) (l2p-close!)))))
    (dk-have! (list 'IN (list 'ESUM qz) 'RR)
      (lambda () (subst (list '= qz g)) (dk-ass!)))
    (fact 'l2-families-intro 'ix zf)
    (l2p-close!)))
(l2p-done! 'l2-vzero-in)

;;; extensionality in l2(I)
(sp (make-wff '(FORALL ix (FORALL a (FORALL b (IMPLIES (IN a (L2-FAMILIES ix)) (IMPLIES (IN b (L2-FAMILIES ix))
   (IMPLIES (FORALL l2e_ (IMPLIES (IN l2e_ ix) (= (a l2e_) (b l2e_)))) (= a b)))))))))
(dk-peel!)
(l2p-elim! 'a) (l2p-elim! 'b)
(dk-project! '(IN a (FUN ix)) 'fun-codomain-iff '(IN a (FUN ix CC)))
(dk-project! '(IN b (FUN ix)) 'fun-codomain-iff '(IN b (FUN ix CC)))
(fact 'fun-domain-extensionality 'ix 'a 'b)
(l2p-close!)
(l2p-done! 'l2-families-ext)

