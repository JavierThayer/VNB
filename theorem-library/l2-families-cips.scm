   (FORALL k (IMPLIES (IN k ix) (= (((L2F-VADD ix) a b) k) (+ (a k) (b k))))))))))))
(dk-peel!)
(l2p-pt! 'a 'k) (l2p-pt! 'b 'k)
(fact 'l2-families-add-closed 'ix 'a 'b)
(fact 'membership-implies-sethood '(VNB-LAMBDA b3a_ ix (+ (a b3a_) (b b3a_))) '(L2-FAMILIES ix))
(mac 'L2F-VADD)
(dk-lam-b!)
(l2p-close!)
(l2p-done! 'l2-vadd-apply)

(sp (make-wff '(FORALL ix (FORALL z (FORALL a (IMPLIES (IN z CC) (IMPLIES (IN a (L2-FAMILIES ix))
   (FORALL k (IMPLIES (IN k ix) (= (((L2F-ACT ix) z a) k) (* z (a k))))))))))))
(dk-peel!)
(l2p-pt! 'a 'k)
(fact 'l2-families-act-closed 'ix 'z 'a)
(fact 'membership-implies-sethood '(VNB-LAMBDA b3a_ ix (* z (a b3a_))) '(L2-FAMILIES ix))
(mac 'L2F-ACT)
(dk-lam-b!)
(l2p-close!)
(l2p-done! 'l2-act-apply)

(sp (make-wff '(FORALL ix (FORALL a (IMPLIES (IN a (L2-FAMILIES ix))
   (FORALL k (IMPLIES (IN k ix) (= (((L2F-VNEG ix) a) k) (- (a k))))))))))
(dk-peel!)
(l2p-pt! 'a 'k)
(dk-have! '(IN (VNB-LAMBDA l2k_ ix (- (a l2k_))) (FUN ix CC))
  (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (l2p-pt! 'a j) (fact 'cc-neg-closed (list 'a j)) (dk-ass!)))
                           (lambda () (fact 'fun-domain-in-set 'ix 'CC 'a) (ass)))))
(fact 'membership-implies-sethood '(VNB-LAMBDA l2k_ ix (- (a l2k_))) '(FUN ix CC))
(mac 'L2F-VNEG)
(dk-lam-b!)
(l2p-close!)
(l2p-done! 'l2-vneg-apply)

(sp (make-wff '(FORALL ix (FORALL k (IMPLIES (IN k ix) (= ((L2F-VZERO ix) k) 0))))))
(dk-peel!)
(mac 'L2F-VZERO)
(dk-lam-b!)
(l2p-close!)
(l2p-done! 'l2-vzero-apply)

;;; ---------------------------------------------------------------------------
;;; the typings
(sp (make-wff '(FORALL ix (FORALL a (FORALL b (IMPLIES (IN a (L2-FAMILIES ix)) (IMPLIES (IN b (L2-FAMILIES ix))
   (IN ((L2F-VADD ix) a b) (L2-FAMILIES ix)))))))))
(dk-peel!)
(fact 'l2-families-add-closed 'ix 'a 'b)
(fact 'membership-implies-sethood '(VNB-LAMBDA b3a_ ix (+ (a b3a_) (b b3a_))) '(L2-FAMILIES ix))
(mac 'L2F-VADD)
