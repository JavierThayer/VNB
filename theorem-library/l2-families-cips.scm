;;; l2p-1.scm -- slice 1 of l2(I) as a complex inner product space: the pointwise operations,
;;; their values and typings.  Agent BA-ONB4, 2026-11-09.  Prefix l2p-.

(define (l2p-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; l2p: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l)
                    (display ";;   ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;     | ") (display (expression->string a)) (newline))
                              (list-head (dk-asms-of l) (min 6 (length (dk-asms-of l))))))
                  (dk-open-leaves))
        (error "l2p: proof not complete" name)))
  (qed name)
  (topic! name 'analysis))
(define (l2p-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (l2p-close!)
  (cond ((not (l2p-open?)) #t) ((dk-asm? (dk-goal)) (ass)) ((dk-head-is? (dk-goal) '==) (qrfl)) (#t (rfl))))
(define (l2p-and! . fs)
  (let ((c (let loop ((fs fs)) (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (loop (cdr fs)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define l2p-LF '(L2-FAMILIES ix))
(define l2p-VA '(L2F-VADD ix))
(define l2p-VZ '(L2F-VZERO ix))
(define l2p-VN '(L2F-VNEG ix))
(define l2p-AC '(L2F-ACT ix))
(define l2p-IPL '(L2-IP ix))
(define (l2p-in a) (list 'IN a l2p-LF))
;; a in L2 in context: a in FUN(ix, CC)
(define (l2p-elim! a)
  (if (not (dk-asm? (list 'IN a '(FUN ix CC))))
      (dk-split-all! (list (dk-cite! 'l2-families-elim 'ix a)))))
;; a in L2, k in ix in context: (a k) in CC
(define (l2p-pt! a k)
  (l2p-elim! a)
  (if (not (dk-asm? (list 'IN (list a k) 'CC))) (fact 'fun-apply-type-c a 'ix 'CC k)))

;;; ---------------------------------------------------------------------------
;;; the values at a point
