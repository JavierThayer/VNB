;;; la-z5-zzmod.scm -- counting: Z/(b) has b elements for b >= 1 (LA-Z5, 2026-10-25).
;;; Prefix lz5z-.
;;;
;;; THE THEOREMS.
;;;   zz-ring-add-neg: (ADD ZZ-RING)(x, (NEG ZZ-RING)(y)) = x + (-y) on ZZ.
;;;   zz-principal-ideal-out / -in: x in (b) iff x = t b for some integer t (the two halves,
;;;       in the arithmetic of ZZ rather than of the ring ZZ-RING).
;;;   zz-mod-card: for an integer b >= 1, CARD(VEC(ZZ-MOD(b))) = b.
;;; PLAN.  k |-> [k] is a bijection of the segment {0, ..., b-1} = ORD-SEGMENT(b) onto
;;; Z/(b): injective, since 0 <= k, k' < b and b | k - k' force k = k' (k - k' = t b with
;;; t >= 1 gives k - k' >= b, t <= -1 gives k - k' <= -b); onto, since every class is
;;; [c] for an integer c (class-of-member) and c = q b + r with 0 <= r < b (zz-division,
;;; with r + b in place of a negative remainder).  Then card-bijection-eq and card-segment.
;;;
;;; Destination theorem-library/.  Library: linear-algebra (ZZ-MOD).  LOAD WINDOW: after
;;; theorem-library/la-z3-quotient (zz-mod-class-in, zz-mod-class-eq-iff, zz-mod-vec,
;;; class-of-member, quotient-member-choice, qmod-setoid-is-setoid, qmod-setoid-pts,
;;; ram-ro-vec, ring-as-module-is-module, principal-ideal-is-submodule; load.scm 2683).
;;; Nothing in the tree cites the file.

(define (lz5z-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z5-zzmod: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'algebra))
(define (lz5z-detach-all! inst)
  (let loop ((f inst))
    (if (and (pair? f) (eq? (car f) 'IMPLIES))
        (let ((a (cadr f)))
          (if (not (dk-asm? a)) (dk-have! a (dk-lane (lambda () (dk-lane-if! prop)))))
          (loop (if (dk-asm? (caddr f)) (dk-ctx-form (caddr f))
                    (dk-landed-1 (lambda () (detach! f))))))
        f)))
(define (lz5z-cite! thm . args) (lz5z-detach-all! (apply dk-cite! thm args)))
(define (lz5z-absurd! notf)
  (if (not (eq? (dk-goal) 'FALSITY)) (pbc))
  (ai notf))
(define (lz5z-iff-l! iff)               ; IFF in context with its lhs in context: land the rhs
  (let ((rhs (caddr iff)))
    (dk-have! rhs (dk-lane (lambda () (dk-only! iff (cadr iff)) (dk-lane-if! prop))))
    rhs))
(define (lz5z-iff-r! iff)               ; IFF in context with its rhs in context: land the lhs
  (let ((lhs (cadr iff)))
    (dk-have! lhs (dk-lane (lambda () (dk-only! iff (caddr iff)) (dk-lane-if! prop))))
    lhs))
(define (lz5z-ass-ctx!) (if (and (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-asm? (dk-goal))) (ass)))
(define (lz5z-ass-if! g)
  (if (and (not (sequent-node-grounded? (proof-state-focus *ps*))) (equal? (dk-goal) g)) (ass)))
(define (lz5z-zsetup!)
  (fact 'zz-is-commutative-ring)
  (fact 'zz-is-ring)
  (dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl))))

;;; ---- ring operations of ZZ-RING in the arithmetic of ZZ ----
;;; MOVED 2026-10-27 (integration): the proof of `zz-ring-add-neg' is now in theorem-library/zz-ring-arith.scm
;;; (library algebra), loaded just before this file.

;;; MOVED 2026-10-27 (integration): the proof of `zz-ring-mul-is-mul' is now in theorem-library/zz-ring-arith.scm
;;; (library algebra), loaded just before this file.

(sp (make-wff (forall-guarded '(b x) '((IN b ZZ) (IN x (PRINCIPAL-IDEAL ZZ-RING b)))
  '(AND (IN x ZZ) (FORSOME t (AND (IN t ZZ) (= x (* t b))))))))
(dk-peel!)
(lz5z-zsetup!)
(let* ((iff (dk-cite! 'principal-ideal-membership 'ZZ-RING 'b 'x))
       (rhs (lz5z-iff-l! iff))
       (parts (dk-split! (dk-ctx-form rhs)))
       (ex (find-first (dk-head? 'FORSOME) parts))
       (t (dk-skolem! ex)))
  (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f t))) (dk-asms))))
    (if cj (dk-split! cj)))
  (dk-rewrite-h! '(IN x (CARR ZZ-RING)) '(CARR ZZ-RING) 'ZZ)
  (dk-rewrite-h! (list 'IN t '(CARR ZZ-RING)) '(CARR ZZ-RING) 'ZZ)
  (let ((e (lz5z-cite! 'zz-ring-mul-is-mul t 'b)))
    (dk-rewrite-h! (list '= 'x (list '(MUL ZZ-RING) t 'b)) (list '(MUL ZZ-RING) t 'b) (list '* t 'b)))
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (ass)
          (begin (ew t) (dk-conj-close! (lambda () (ass))))))))
(lz5z-done! 'zz-principal-ideal-out)

(sp (make-wff (forall-guarded '(b x t) '((IN b ZZ) (IN x ZZ) (IN t ZZ) (= x (* t b)))
  '(IN x (PRINCIPAL-IDEAL ZZ-RING b)))))
(dk-peel!)
(lz5z-zsetup!)
(lz5z-cite! 'zz-ring-mul-is-mul 't 'b)
(let* ((iff (dk-cite! 'principal-ideal-membership 'ZZ-RING 'b 'x)))
  (dk-have! (caddr iff)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORSOME)
              (begin (ew 't)
                     (dk-conj-close!
                       (lambda ()
                         (if (dk-head-is? (dk-goal) 'IN)
                             (begin (subst '(== (CARR ZZ-RING) ZZ)) (ass))
                             (begin (subst (list '= '((MUL ZZ-RING) t b) '(* t b))) (ass))))))
              (begin (subst '(== (CARR ZZ-RING) ZZ)) (ass)))))))
  (lz5z-iff-r! iff))
(lz5z-done! 'zz-principal-ideal-in)

;;; ---- Z/(b) has b elements ----
(define LZ5Z-S '(QMOD-SETOID (RING-AS-MODULE ZZ-RING) (PRINCIPAL-IDEAL ZZ-RING b)))
(define LZ5Z-V '(VEC (ZZ-MOD b)))
(define LZ5Z-SEG '(ORD-SEGMENT b))
(define LZ5Z-PHI (list 'VNB-LAMBDA 'zmk_ LZ5Z-SEG (list 'CLASS LZ5Z-S 'zmk_)))
(define (lz5z-cls x) (list 'CLASS LZ5Z-S x))
(define (lz5z-seg-facts! k)             ; k in ORD-SEGMENT(b): k in NN, ZZ, CARR ZZ-RING, 0 <= k < b
  (lz5z-cite! 'ord-segment-nn-subset 'b k)
  (lz5z-cite! 'nn-subset-zz k)
  (lz5z-cite! 'nn-in-rr k)
  (let ((iff (dk-cite! 'seg-mem-lt 'b k)))
    (lz5z-iff-l! iff))
  (lz5z-cite! 'nn-zero-le k)
  (dk-have! (list 'IN k '(CARR ZZ-RING)) (lambda () (subst '(== (CARR ZZ-RING) ZZ)) (ass))))
;; e an integer term with 0 <= e (from PREM, e = s - 1 with 1 <= s), b in NN: name
;; qv = e * b and land 0 <= qv (a product of naturals is a natural: no order lemma on RR)
(define (lz5z-excess! e prem)
  (dk-have! (list 'IN e 'ZZ) (lambda () (type-term)))
  (fact 'zz-in-rr e)
  (dk-have! (list '<= 0 e) (lambda () (dk-ineq! prem)))
  (lz5z-cite! 'zz-nonneg-in-nn e)
  (dk-have! (list 'AND (list 'IN e 'NN) '(IN b NN)) (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'nn-mul-closed e 'b)
  (lz5z-cite! 'nn-in-rr (list '* e 'b))
  (lz5z-cite! 'nn-zero-le (list '* e 'b))
  (let ((qv (dk-name! (list '* e 'b))))
    (dk-have! (list '<= 0 qv) (lambda () (subst (list '= qv (list '* e 'b))) (ass)))
    qv))
;; class(x) = class(y) with x, y in ZZ: land x + (-y) = t b, t in ZZ; return t
(define (lz5z-class-eq-out! x y ceq)
  (dk-have! (list 'IN x '(CARR ZZ-RING)) (lambda () (subst '(== (CARR ZZ-RING) ZZ)) (ass)))
  (dk-have! (list 'IN y '(CARR ZZ-RING)) (lambda () (subst '(== (CARR ZZ-RING) ZZ)) (ass)))
  (let* ((iff (dk-cite! 'zz-mod-class-eq-iff 'b x y))
         (m (lz5z-iff-l! iff)))
    (lz5z-cite! 'zz-ring-add-neg x y)
    (let* ((m2 (dk-rewrite-h! m (list '(ADD ZZ-RING) x (list '(NEG ZZ-RING) y)) (list '+ x (list '- y))))
           (r (lz5z-cite! 'zz-principal-ideal-out 'b (list '+ x (list '- y))))
           (ex (find-first (dk-head? 'FORSOME) (if (dk-head-is? r 'AND) (dk-split! r) (list r))))
           (t (dk-skolem! ex)))
      (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f t))) (dk-asms))))
        (if cj (dk-split! cj)))
      t)))
;; x, y in ZZ, x + (-y) = t b, t in ZZ: land class(x) = class(y)
(define (lz5z-class-eq-in! x y t)
  (dk-have! (list 'IN x '(CARR ZZ-RING)) (lambda () (subst '(== (CARR ZZ-RING) ZZ)) (ass)))
  (dk-have! (list 'IN y '(CARR ZZ-RING)) (lambda () (subst '(== (CARR ZZ-RING) ZZ)) (ass)))
  (fact 'zz-neg-closed y)
  (dk-have! (list 'AND (list 'IN x 'ZZ) (list 'IN (list '- y) 'ZZ)) (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'zz-add-closed x (list '- y))
  (lz5z-cite! 'zz-principal-ideal-in 'b (list '+ x (list '- y)) t)
  (lz5z-cite! 'zz-ring-add-neg x y)
  (dk-have! (list 'IN (list '(ADD ZZ-RING) x (list '(NEG ZZ-RING) y)) '(PRINCIPAL-IDEAL ZZ-RING b))
    (lambda () (subst (list '= (list '(ADD ZZ-RING) x (list '(NEG ZZ-RING) y)) (list '+ x (list '- y)))) (ass)))
  (let ((iff (dk-cite! 'zz-mod-class-eq-iff 'b x y)))
    (lz5z-iff-r! iff)))

(sp (make-wff (forall-guarded '(b) '((IN b ZZ) (<= 1 b))
  (list '= (list 'CARD LZ5Z-V) 'b))))
(dk-peel!)
(lz5z-zsetup!)
(fact 'zz-in-rr 'b)
(dk-have! '(<= 0 b) (lambda () (dk-ineq! '(<= 1 b))))
(lz5z-cite! 'zz-nonneg-in-nn 'b)
(lz5z-cite! 'nn-subset-ord 'b)
(lz5z-cite! 'ord-segment-is-set 'b)
(lz5z-cite! 'card-segment 'b)
(dk-have! '(IN b (CARR ZZ-RING)) (lambda () (subst '(== (CARR ZZ-RING) ZZ)) (ass)))
(define LZ5Z-BIJ (list 'IN LZ5Z-PHI (list 'BIJECTION LZ5Z-SEG LZ5Z-V)))
(fact 'ring-as-module-is-module 'ZZ-RING)
(lz5z-cite! 'principal-ideal-is-submodule 'ZZ-RING 'b)
(lz5z-cite! 'qmod-vec-set '(RING-AS-MODULE ZZ-RING) '(PRINCIPAL-IDEAL ZZ-RING b))
(fact 'zz-mod-unfold 'b)
(dk-rewrite-h! '(IN (VEC (QUOTIENT-MODULE (RING-AS-MODULE ZZ-RING) (PRINCIPAL-IDEAL ZZ-RING b))) SET)
               '(QUOTIENT-MODULE (RING-AS-MODULE ZZ-RING) (PRINCIPAL-IDEAL ZZ-RING b)) '(ZZ-MOD b))
(define LZ5Z-IFF (dk-cite! 'bijection-membership-iff LZ5Z-SEG LZ5Z-V LZ5Z-PHI))
(define LZ5Z-PARTS (let ((r (caddr LZ5Z-IFF))) (list (cadr r) (cadr (caddr r)) (caddr (caddr r)))))
(define (lz5z-fun!)
  (dk-lam-type!
    (lambda ()
      (let ((k (dk-di-var!)))
        (lz5z-seg-facts! k)
        (if (dk--redex? (dk-goal)) (dk-lam-b!))
        (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
            (let ((g0 (dk-goal))) (lz5z-cite! 'zz-mod-class-in 'b k) (lz5z-ass-if! g0)))))
    (lambda () (ass))))
(define (lz5z-inj!)
  (let* ((ld (dk-peel!))
         (ins (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) LZ5Z-SEG))) ld))
         (k1 (cadr (car ins))) (k2 (cadr (cadr ins)))
         (pe (find-first (dk-head? '=) ld)))
    (lz5z-seg-facts! k1)
    (lz5z-seg-facts! k2)
    (dk-lam-b-h! pe)
    (let* ((ceq (find-first (lambda (f) (and (dk-head-is? f '=) (dk-head-is? (cadr f) 'CLASS))) (dk-asms)))
           (t (lz5z-class-eq-out! k1 k2 ceq))
           (eq (list '= (list '+ k1 (list '- k2)) (list '* t 'b))))
      (fact 'zz-in-rr t)
      (dk-have! (list 'IN (list '* t 'b) 'RR) (lambda () (type-term)))
      (let ((pv (dk-name! (list '* t 'b))))
        (fact 'zz-in-rr 'b)
        (use-em (list '<= t 0)
          (lambda ()
            (use-em (list '<= 0 t)
              (lambda ()
                (dk-have! (list 'AND (list '<= t 0) (list '<= 0 t)) (lambda () (dk-conj-close! (lambda () (ass)))))
                (dk-have! '(IN 0 RR) (lambda () (type-term)))
                (dk-have! (list 'AND (list 'IN t 'RR) '(IN 0 RR)) (lambda () (dk-conj-close! (lambda () (ass)))))
                (lz5z-cite! 'rr-leq-antisymmetric t 0)
                (dk-have! (list '= (list '* t 'b) 0) (lambda () (subst (list '= t 0)) (crs)))
                (dk-ineq! eq (list '= (list '* t 'b) 0)))
              (lambda ()
                (lz5z-cite! 'rr-not-le-lt 0 t)
                (fact 'zz-neg-closed t)
                (fact 'zz-in-rr (list '- t))
                (dk-have! (list '< 0 (list '- t)) (lambda () (dk-ineq! (list '< t 0))))
                (lz5z-cite! 'zz-discrete (list '- t))
                (let ((qv (lz5z-excess! (list '+ (list '- t) -1) (list '<= 1 (list '- t)))))
                  (dk-have! (list '= qv (list '+ (list '- pv) (list '- 'b)))
                    (lambda () (subst (list '= qv (list '* (list '+ (list '- t) -1) 'b))) (subst (list '= pv (list '* t 'b))) (crs)))
                  (dk-absurd! (list '<= 0 qv) (list '= qv (list '+ (list '- pv) (list '- 'b)))
                              (list '= pv (list '* t 'b)) eq (list '< k2 'b) (list '<= 0 k1))))))
          (lambda ()
            (lz5z-cite! 'rr-not-le-lt t 0)
            (lz5z-cite! 'zz-discrete t)
            (let ((qv (lz5z-excess! (list '+ t -1) (list '<= 1 t))))
              (dk-have! (list '= qv (list '+ pv (list '- 'b)))
                (lambda () (subst (list '= qv (list '* (list '+ t -1) 'b))) (subst (list '= pv (list '* t 'b))) (crs)))
              (dk-absurd! (list '<= 0 qv) (list '= qv (list '+ pv (list '- 'b))) (list '= pv (list '* t 'b)) eq
                          (list '< k1 'b) (list '<= 0 k2)))))))))
(define (lz5z-zz! t) (if (not (dk-asm? (list 'IN t 'ZZ))) (dk-have! (list 'IN t 'ZZ) (lambda () (type-term)))))
;; the residue rv in [0, b) with class(rv) = class(cv), and the class of rv is w
(define (lz5z-finish! w cv rv tv)
  (lz5z-zz! rv)
  (fact 'zz-in-rr rv)
  (lz5z-cite! 'zz-nonneg-in-nn rv)
  (dk-have! (list 'IN rv LZ5Z-SEG)
    (lambda () (let ((iff (dk-cite! 'seg-mem-lt 'b rv))) (lz5z-iff-r! iff))))
  (lz5z-class-eq-in! rv cv tv)
  (ew rv)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (ass)
          (begin
            (if (dk--redex? (dk-goal)) (dk-lam-b!))
            (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                (begin
                  (subst (list '= (lz5z-cls rv) (lz5z-cls cv)))
                  (ass))))))))
(define (lz5z-onto!)
  (let* ((w (dk-di-var!)))
    (lz5z-cite! 'qmod-setoid-is-setoid '(RING-AS-MODULE ZZ-RING) '(PRINCIPAL-IDEAL ZZ-RING b))
    (lz5z-cite! 'zz-mod-vec 'b)
    (let* ((wq (dk-rewrite-h! (list 'IN w LZ5Z-V) LZ5Z-V (list 'QUOTIENT LZ5Z-S)))
           (c (list 'CHOICE w)))
      (lz5z-cite! 'quotient-member-choice LZ5Z-S w)
      (let ((r (lz5z-cite! 'class-of-member LZ5Z-S w c)))
        (if (dk-head-is? r 'AND) (dk-split! r)))
      (lz5z-cite! 'qmod-setoid-pts '(RING-AS-MODULE ZZ-RING) '(PRINCIPAL-IDEAL ZZ-RING b))
      (lz5z-cite! 'ram-ro-vec 'ZZ-RING)
      (let* ((f1 (dk-rewrite-h! (list 'IN c (list 'PTS LZ5Z-S)) (list 'PTS LZ5Z-S) '(VEC (RING-AS-MODULE ZZ-RING))))
             (f2 (dk-rewrite-h! f1 '(VEC (RING-AS-MODULE ZZ-RING)) '(CARR ZZ-RING)))
             (f3 (dk-rewrite-h! f2 '(CARR ZZ-RING) 'ZZ))
             (cv (dk-name! c 'ZZ))
             (ceq (dk-rewrite-h! (list '= (lz5z-cls c) w) c cv)))
        (fact 'zz-in-rr cv)
        (dk-have! '(NOT (= b 0)) (lambda () (di) (dk-absurd! '(<= 1 b) '(= b 0))))
        (let* ((ex (lz5z-cite! 'zz-division cv 'b))
               (q (dk-skolem! ex))
               (ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f q))) (dk-asms)))
               (r (dk-skolem! ex2)))
          (let loop ()
            (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f r))) (dk-asms))))
              (if cj (begin (dk-split! cj) (loop)))))
          (fact 'zz-in-rr q) (fact 'zz-in-rr r)
          (let ((dv (list '= cv (list '+ (list '* q 'b) r)))
                (cases (find-first (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f r))) (dk-asms))))
            ;; -b < r < b
            (lz5z-cite! 'rr-abs-of-nonneg 'b)
            (lz5z-cite! 'zz-abs-in-nn r)
            (lz5z-cite! 'nn-in-rr (list 'abs r))
            (lz5z-cite! 'nn-zero-le (list 'abs r))
            (dk-have! (list 'AND (list '< (list '- 'b) r) (list '< r 'b))
              (lambda ()
                (use-cases cases
                  (lambda () (dk-conj-close! (lambda () (dk-ineq! (list '= r 0) '(<= 1 b)))))
                  (lambda ()
                    (lz5z-cite! 'nn-succ-plus-one (list 'abs r))
                    (let* ((h1 (dk-rewrite-h! (list '<= (list 'succ (list 'abs r)) (list 'abs 'b)) (list 'succ (list 'abs r)) (list '+ (list 'abs r) 1)))
                           (h2 (dk-rewrite-h! h1 (list 'abs 'b) 'b)))
                      h2)
                    (let ((ac (lz5z-cite! 'zz-abs-cases r)))
                      (use-cases ac
                        (lambda () (dk-conj-close! (lambda () (dk-ineq! (list '= r (list 'abs r)) (list '<= (list '+ (list 'abs r) 1) 'b) (list '<= 0 (list 'abs r))))))
                        (lambda () (dk-conj-close! (lambda () (dk-ineq! (list '= r (list '- (list 'abs r))) (list '<= (list '+ (list 'abs r) 1) 'b) (list '<= 0 (list 'abs r))))))))))))
            (dk-split! (list 'AND (list '< (list '- 'b) r) (list '< r 'b)))
            (dk-have! (list 'AND (list 'IN q 'ZZ) '(IN b ZZ)) (lambda () (dk-conj-close! (lambda () (ass)))))
            (fact 'zz-mul-closed q 'b)
            (fact 'zz-in-rr (list '* q 'b))
            (let ((qb (dk-name! (list '* q 'b))))
              (use-em (list '<= 0 r)
                (lambda ()
                  (let ((tv (list '- q)))
                    (lz5z-zz! tv)
                    (dk-have! (list '= (list '+ r (list '- cv)) (list '* tv 'b))
                      (lambda () (subst dv) (crs)))
                    (lz5z-finish! w cv r tv)))
                (lambda ()
                  (let ((rv (list '+ r 'b)) (tv (list '+ (list '- q) 1)))
                    (lz5z-zz! rv) (lz5z-zz! tv)
                    (dk-have! (list '<= 0 rv) (lambda () (dk-ineq! (list '< (list '- 'b) r))))
                    (lz5z-cite! 'rr-not-le-lt 0 r)
                    (dk-have! (list '< rv 'b) (lambda () (dk-ineq! (list '< r 0))))
                    (dk-have! (list '= (list '+ rv (list '- cv)) (list '* tv 'b))
                      (lambda () (subst dv) (crs)))
                    (lz5z-finish! w cv rv tv)))))))))))
(dk-have! (car LZ5Z-PARTS) lz5z-fun!)
(dk-have! (cadr LZ5Z-PARTS) lz5z-inj!)
(dk-have! (caddr LZ5Z-PARTS) lz5z-onto!)
(dk-have! (caddr LZ5Z-IFF) (lambda () (dk-conj-close! (lambda () (ass)))))
(lz5z-iff-r! LZ5Z-IFF)
(fact 'nn-in-rr 'b)
(dk-have! (list 'IN (list 'CARD LZ5Z-SEG) 'NN) (lambda () (subst (list '= (list 'CARD LZ5Z-SEG) 'b)) (ass)))
(lz5z-cite! 'card-bijection-eq LZ5Z-SEG LZ5Z-V LZ5Z-PHI)
(subst (list '= (list 'CARD LZ5Z-V) (list 'CARD LZ5Z-SEG)))
(subst (list '= (list 'CARD LZ5Z-SEG) 'b))
(if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))
(lz5z-done! 'zz-mod-card)
(gloss! 'zz-mod-card "For an integer b >= 1 the group Z/(b) has exactly b elements: k |-> [k] is a bijection of {0, ..., b-1} onto it.")

