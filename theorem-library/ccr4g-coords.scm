(qrfl)
(cg1-qed! 'nf-ring-additive-ag-view)

;;; ---------------------------------------------------------------------------
;;; nf-series-lincomb-swap: THE REARRANGEMENT BY COORDINATES.  K over a subfield S; e(k) a row of n
;;; coefficients in S for each k in NN; b a column of n elements of K.  If for each coordinate j the series
;;; sum_k e(k)_j converges to Lr_j, then the series sum_k LINCOMB(e(k), b) converges to LINCOMB(Lr, b).
;;; Proof: nf-series-finsum-swap at the terms t(k, i) = e(k)_(i+1) b_(i+1), i < n, with the row sums read as
;;; LINCOMBs by nf-lincomb-sum-ag and each column limit Lr_(i+1) b_(i+1) by sum-ag-ring-right-ind and
;;; nf-converges-scale.

(define cg1-ms '(NF-METRIC-SPACE K))
(define (cg1-t kv i) `((MUL K) (ENTRY (e ,kv) 1 (succ ,i)) (ENTRY b (succ ,i) 1)))
(define cg1-ta `(VNB-LAMBDA cgk_ NN (VNB-LAMBDA cgi_ (ORD-SEGMENT n) ,(cg1-t 'cgk_ 'cgi_))))
(define cg1-cc `(VNB-LAMBDA cgi_ (ORD-SEGMENT n) (VNB-LAMBDA cgk_ NN ,(cg1-t 'cgk_ 'cgi_))))
(define cg1-rr `(VNB-LAMBDA cgk_ NN (LINCOMB ,cg1-md n (e cgk_) b)))
(define (cg1-col i) `(VNB-LAMBDA cgk_ NN ,(cg1-t 'cgk_ i)))
(define cg1-ff `(VNB-LAMBDA cgi_ (ORD-SEGMENT n) (VNB-LAMBDA cgm_ NN (SUM-AG ,cg1-ag ,(cg1-col 'cgi_) cgm_))))
(define cg1-tt `(VNB-LAMBDA cgm_ NN (VNB-LAMBDA cgi_ (ORD-SEGMENT n) (SUM-AG ,cg1-ag ,(cg1-col 'cgi_) cgm_))))
(define cg1-ll `(VNB-LAMBDA cgi_ (ORD-SEGMENT n) ((MUL K) (ENTRY Lr 1 (succ cgi_)) (ENTRY b (succ cgi_) 1))))
(define cg1-rowseq `(VNB-LAMBDA cvm_ NN (SUM-AG ,cg1-ag ,cg1-rr cvm_)))
(define (cg1-sw-hyps ta C R F T L)
  (list `(FORALL kx (IMPLIES (IN kx NN) (IN (,ta kx) (FUN (ORD-SEGMENT n) (CARR K)))))
        `(FORALL i (IMPLIES (IN i (ORD-SEGMENT n)) (IN (,C i) (FUN NN (CARR K)))))
        `(FORALL kx (IMPLIES (IN kx NN) (FORALL i (IMPLIES (IN i (ORD-SEGMENT n)) (== ((,C i) kx) ((,ta kx) i))))))
        `(FORALL kx (IMPLIES (IN kx NN) (== (,R kx) (SUM-AG ,cg1-ag (,ta kx) n))))
        `(FORALL i (IMPLIES (IN i (ORD-SEGMENT n)) (IN (,F i) (FUN NN (CARR K)))))
        `(FORALL i (IMPLIES (IN i (ORD-SEGMENT n)) (FORALL m (IMPLIES (IN m NN) (== ((,F i) m) (SUM-AG ,cg1-ag (,C i) m))))))
        `(FORALL m (IMPLIES (IN m NN) (IN (,T m) (FUN (ORD-SEGMENT n) (CARR K)))))
        `(FORALL m (IMPLIES (IN m NN) (FORALL i (IMPLIES (IN i (ORD-SEGMENT n)) (== ((,T m) i) (SUM-AG ,cg1-ag (,C i) m))))))
        `(FORALL i (IMPLIES (IN i (ORD-SEGMENT n)) (IN (,L i) (CARR K))))
        `(FORALL i (IMPLIES (IN i (ORD-SEGMENT n)) (CONVERGES-TO ,cg1-ms (,F i) (,L i))))))
(define (cg1-one!)
  (if (not (dk-asm? '(IN 1 (INTERVAL 1 1))))
      (begin (fact 'nn-one-in)
             (dk-have! '(IN 1 (INTERVAL 1 1)) (lambda () (dk-have! '(<= 1 1) (lambda () (dk-nn!))) (dk-cite! 'interval-mem-intro 1 1 1) (ass))))))
(define cg1-sub2 #f)
(define cg1-colhyp #f)
(define (cg1-nat! landed)
  (cadr (find-first (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'NN))) landed)))
(define (cg1-segv! landed)
  (cadr (find-first (lambda (q) (and (dk-head-is? q 'IN) (dk-head-is? (caddr q) 'ORD-SEGMENT))) landed)))
;; e(k)_(i+1) in S and in CARR K, b_(i+1) in CARR K, t(k, i) in CARR K   (k in NN, i in ORD-SEGMENT n)
(define (cg1-t-type! kv i)
  (cg1-seg! i 'n)
  (cg1-one!)
  (if (not (dk-asm? `(IN (e ,kv) (MAT 1 n S)))) (dk-cite! 'fun-apply-type-c 'e 'NN '(MAT 1 n S) kv))
  (if (not (dk-asm? `(IN (ENTRY (e ,kv) 1 (succ ,i)) S))) (dk-cite! 'entry-in-carrier 1 'n 'S `(e ,kv) 1 `(succ ,i)))
  (if (not (dk-asm? `(IN (ENTRY (e ,kv) 1 (succ ,i)) (CARR K)))) (dk-apply! cg1-sub2 `(ENTRY (e ,kv) 1 (succ ,i))))
  (if (not (dk-asm? `(IN (ENTRY b (succ ,i) 1) (CARR K)))) (dk-cite! 'entry-in-carrier 'n 1 '(CARR K) 'b `(succ ,i) 1))
  (if (not (dk-asm? `(IN ,(cg1-t kv i) (CARR K))))
      (dk-cite! 'nf-mul-in-carr 'K `(ENTRY (e ,kv) 1 (succ ,i)) `(ENTRY b (succ ,i) 1))))
;; SUM-AG(ag, col(i), m) in CARR K
(define (cg1-colsum-type! i m)
  (let ((s `(SUM-AG ,cg1-ag ,(cg1-col i) ,m)))
    (if (not (dk-asm? `(IN ,s (CARR K))))
        (begin
          (dk-have! `(FORALL cgz_ (IMPLIES (IN cgz_ (ORD-SEGMENT ,m)) (IN (,(cg1-col i) cgz_) (CARR ,cg1-ag))))
            (lambda ()
              (let ((z (cg1-segv! (dk-landed (lambda () (dk-peel!))))))
                (dk-cite! 'ord-segment-nn-subset m z)
                (cg1-t-type! z i)
                (subst `(== (CARR ,cg1-ag) (CARR K)))
                (dk-close-if! (lambda () (dk-lam-b!)) cg1-rfl-or-ass!))))
          (dk-cite! 'sum-ag-type-ptwise m cg1-ag (cg1-col i))
          (dk-have! `(IN ,s (CARR K)) (lambda () (subst `(== (CARR K) (CARR ,cg1-ag))) (dk-ass!)))))))
(define (cg1-ag!)
  (dk-cite! 'normed-field-additive-ag-is-abelian-group 'K)
  (for-each (lambda (sl)
              (let ((eq `(== (,(car sl) ,cg1-ag) ,(cadr sl))))
                (if (not (dk-asm? eq))
                    (dk-have! eq (lambda () (mac 'normed-field-additive-ag) (slot (car sl)) (nth-r)
                                            (if (eq? (car sl) 'CARR) (slot 'CARR)) (qrfl))))))
            '((OPR (ADD K)) (IDEN (ZERO K)) (CARR (CARR K)))))
(define cg1-view '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define (cg1-crs!)
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,cg1-view))))) '(ADD MUL NEG))
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,cg1-view))))) '(ZERO ONE))
  (crs))
(define (cg1-in-view! x)
  (if (not (dk-asm? `(IN ,x (CARR ,cg1-view))))
      (dk-have! `(IN ,x (CARR ,cg1-view)) (lambda () (subst `(= (CARR ,cg1-view) (CARR K))) (dk-ass!)))))

(sp (make-wff (cg1-thm `(FORALL n (IMPLIES (IN n NN)
  (FORALL b (IMPLIES (IN b (MAT n 1 (CARR K)))
  (FORALL e (IMPLIES (IN e (FUN NN (MAT 1 n S)))
  (FORALL Lr (IMPLIES (IN Lr (MAT 1 n S))
  (IMPLIES (FORALL j (IMPLIES (IN j (INTERVAL 1 n))
             (CONVERGES-TO ,cg1-ms (VNB-LAMBDA cvm_ NN (SUM-AG ,cg1-ag (VNB-LAMBDA cgk_ NN (ENTRY (e cgk_) 1 j)) cvm_))
                           (ENTRY Lr 1 j))))
    (CONVERGES-TO ,cg1-ms ,cg1-rowseq (LINCOMB ,cg1-md n Lr b))))))))))))))
(dk-peel!)
(set! cg1-colhyp (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q 'CONVERGES-TO))) "the column hypothesis"))
(set! cg1-sub2 (dk-project! '(FORALL bzx_ (IMPLIES (IN bzx_ S) (IN bzx_ (CARR K)))) 'is-nf-subfield '(IS-NF-SUBFIELD K S)))
(cg1-ag!)
(dk-cite! 'nf-metric-space-is-metric-space 'K)
(dk-cite! 'nf-metric-carrier 'K)
(dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
(dk-cite! 'commutative-ring-is-ring cg1-view)
(for-each (lambda (r) (dk-cite! r 'K))
          '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
            normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one))
(dk-cite! 'nf-ring-additive-ag-view 'K)
(define cg1-H (cg1-sw-hyps cg1-ta cg1-cc cg1-rr cg1-ff cg1-tt cg1-ll))
(dk-cite! 'nn-subset-ord 'n)
(dk-cite! 'ord-segment-is-set 'n)
(dk-cite! 'nn-is-set)
;; 0: (ta kx) in FUN(seg n, CARR K)
(dk-have! (list-ref cg1-H 0)
  (lambda ()
    (let ((kv (cg1-nat! (dk-landed (lambda () (dk-peel!))))))
      (dk-lam-b!)
      (dk-lam-type! (lambda () (let ((i (cg1-segv! (dk-landed (lambda () (dk-peel!))))))
                                 (cg1-t-type! kv i) (dk-close-if-asm!)))))))
;; 1: (C i) in FUN(NN, CARR K)
(dk-have! (list-ref cg1-H 1)
  (lambda ()
    (let ((i (cg1-segv! (dk-landed (lambda () (dk-peel!))))))
      (cg1-seg! i 'n)
      (dk-lam-b!)
      (dk-lam-type! (lambda () (let ((kv (cg1-nat! (dk-landed (lambda () (dk-peel!))))))
                                 (cg1-t-type! kv i) (dk-close-if-asm!)))))))
;; 2: ((C i) kx) == ((ta kx) i)
(dk-have! (list-ref cg1-H 2)
  (lambda ()
    (let* ((ls (dk-landed (lambda () (dk-peel!)))) (kv (cg1-nat! ls)) (i (cg1-segv! ls)))
      (cg1-seg! i 'n)
      (dk-close-if! (lambda () (dk-lam-b!)) cg1-rfl-or-ass!))))
;; 3: (R kx) == SUM-AG(ag, (ta kx), n)
(dk-have! (list-ref cg1-H 3)
  (lambda ()
    (let ((kv (cg1-nat! (dk-landed (lambda () (dk-peel!))))))
      (dk-cite! 'fun-apply-type-c 'e 'NN '(MAT 1 n S) kv)
      (dk-lam-b!)
      (let* ((g (dk-goal)) (fam (caddr (caddr g))))
        (dk-have! `(FORALL i (IMPLIES (IN i (ORD-SEGMENT n)) (== (,fam i) ,(cg1-t kv 'i))))
          (lambda () (let ((i (cg1-segv! (dk-landed (lambda () (dk-peel!))))))
                       (cg1-seg! i 'n)
                       (dk-close-if! (lambda () (dk-lam-b!)) cg1-rfl-or-ass!))))
        (subst (dk-cite! 'nf-lincomb-sum-ag 'K 'S 'n `(e ,kv) 'b fam))
        (cg1-rfl-or-ass!)))))
;; 4: (F i) in FUN(NN, CARR K)
(dk-have! (list-ref cg1-H 4)
  (lambda ()
    (let ((i (cg1-segv! (dk-landed (lambda () (dk-peel!))))))
      (cg1-seg! i 'n)
      (dk-lam-b!)
      (dk-lam-type! (lambda () (let ((m (cg1-nat! (dk-landed (lambda () (dk-peel!))))))
                                 (cg1-colsum-type! i m) (dk-close-if-asm!)))))))
;; 5: ((F i) m) == SUM-AG(ag, (C i), m)
(dk-have! (list-ref cg1-H 5)
  (lambda ()
    (let* ((ls (dk-landed (lambda () (dk-peel!)))) (i (cg1-segv! ls)) (m (cg1-nat! ls)))
      (cg1-seg! i 'n)
      (dk-close-if! (lambda () (dk-lam-b!)) cg1-rfl-or-ass!))))
;; 6: (T m) in FUN(seg n, CARR K)
(dk-have! (list-ref cg1-H 6)
  (lambda ()
    (let ((m (cg1-nat! (dk-landed (lambda () (dk-peel!))))))
      (dk-lam-b!)
      (dk-lam-type! (lambda () (let ((i (cg1-segv! (dk-landed (lambda () (dk-peel!))))))
                                 (cg1-seg! i 'n)
                                 (cg1-colsum-type! i m) (dk-close-if-asm!)))))))
;; 7: ((T m) i) == SUM-AG(ag, (C i), m)
(dk-have! (list-ref cg1-H 7)
  (lambda ()
    (let* ((ls (dk-landed (lambda () (dk-peel!)))) (m (cg1-nat! ls)) (i (cg1-segv! ls)))
      (cg1-seg! i 'n)
      (dk-close-if! (lambda () (dk-lam-b!)) cg1-rfl-or-ass!))))
;; 8: (L i) in CARR K
(define (cg1-lr-type! i)
  (cg1-seg! i 'n)
  (cg1-one!)
  (if (not (dk-asm? `(IN (ENTRY Lr 1 (succ ,i)) S))) (dk-cite! 'entry-in-carrier 1 'n 'S 'Lr 1 `(succ ,i)))
  (if (not (dk-asm? `(IN (ENTRY Lr 1 (succ ,i)) (CARR K)))) (dk-apply! cg1-sub2 `(ENTRY Lr 1 (succ ,i))))
  (if (not (dk-asm? `(IN (ENTRY b (succ ,i) 1) (CARR K)))) (dk-cite! 'entry-in-carrier 'n 1 '(CARR K) 'b `(succ ,i) 1))
  (dk-cite! 'nf-mul-in-carr 'K `(ENTRY Lr 1 (succ ,i)) `(ENTRY b (succ ,i) 1)))
(dk-have! (list-ref cg1-H 8)
  (lambda ()
    (let ((i (cg1-segv! (dk-landed (lambda () (dk-peel!))))))
      (cg1-lr-type! i)
      (dk-close-if! (lambda () (dk-lam-b!)) cg1-rfl-or-ass!))))
;; 9: (F i) -> (L i)
(dk-have! (list-ref cg1-H 9)
  (lambda ()
    (let* ((i (cg1-segv! (dk-landed (lambda () (dk-peel!)))))
           (j `(succ ,i))
           (bj `(ENTRY b ,j 1)) (lj `(ENTRY Lr 1 ,j))
           (fcol `(VNB-LAMBDA cgk_ NN (ENTRY (e cgk_) 1 ,j)))
           (fseq `(VNB-LAMBDA cvm_ NN (SUM-AG ,cg1-ag ,fcol cvm_)))
           (hseq `(VNB-LAMBDA cgm_ NN (SUM-AG ,cg1-ag ,(cg1-col i) cgm_))))
      (cg1-lr-type! i)
      (dk-lam-b!)
      (dk-apply! cg1-colhyp j)
      ;; f, h typed
      (dk-have! `(IN ,fseq (FUN NN (CARR K)))
        (lambda () (dk-lam-type! (lambda () (let ((m (cg1-nat! (dk-landed (lambda () (dk-peel!))))))
          (dk-have! `(FORALL cgz_ (IMPLIES (IN cgz_ (ORD-SEGMENT ,m)) (IN (,fcol cgz_) (CARR ,cg1-ag))))
            (lambda () (let ((z (cg1-segv! (dk-landed (lambda () (dk-peel!))))))
                         (dk-cite! 'ord-segment-nn-subset m z)
                         (cg1-t-type! z i)
                         (subst `(== (CARR ,cg1-ag) (CARR K)))
                         (dk-close-if! (lambda () (dk-lam-b!)) cg1-rfl-or-ass!))))
          (dk-cite! 'sum-ag-type-ptwise m cg1-ag fcol)
          (subst `(== (CARR K) (CARR ,cg1-ag)))
          (dk-close-if-asm!))))))
      (dk-have! `(IN ,hseq (FUN NN (CARR K)))
        (lambda () (dk-lam-type! (lambda () (let ((m (cg1-nat! (dk-landed (lambda () (dk-peel!))))))
                                              (cg1-colsum-type! i m) (dk-close-if-asm!))))))
      ;; the pointwise law h(m) = b_j f(m)
      (dk-have! `(FORALL cgn_ (IMPLIES (IN cgn_ NN) (= (,hseq cgn_) ((MUL K) ,bj (,fseq cgn_)))))
        (lambda ()
          (let ((m (cg1-nat! (dk-landed (lambda () (dk-peel!))))))
            (dk-lam-b!)
            (let ((ga fcol) (gb (cg1-col i)))
              (dk-have! `(FORALL cgz_ (IMPLIES (IN cgz_ (ORD-SEGMENT ,m)) (IN (,ga cgz_) (CARR ,cg1-view))))
                (lambda () (let ((z (cg1-segv! (dk-landed (lambda () (dk-peel!))))))
                             (dk-cite! 'ord-segment-nn-subset m z)
                             (cg1-t-type! z i)
                             (subst `(= (CARR ,cg1-view) (CARR K)))
                             (dk-close-if! (lambda () (dk-lam-b!)) cg1-rfl-or-ass!))))
              (dk-have! `(FORALL cgz_ (IMPLIES (IN cgz_ (ORD-SEGMENT ,m)) (== (,gb cgz_) ((MUL ,cg1-view) (,ga cgz_) ,bj))))
                (lambda () (let ((z (cg1-segv! (dk-landed (lambda () (dk-peel!))))))
                             (dk-cite! 'ord-segment-nn-subset m z)
                             (cg1-t-type! z i)
                             (dk-lam-b!)
                             (subst `(= (MUL ,cg1-view) (MUL K)))
                             (cg1-rfl-or-ass!))))
              (cg1-in-view! bj)
              (let ((eq (dk-cite! 'sum-ag-ring-right-ind m cg1-view bj ga gb)))
                (cg1-colsum-type! i m)
                (subst `(== ,cg1-ag (RING-ADDITIVE-AG ,cg1-view)))
                (subst eq)
                (let ((fs `(SUM-AG (RING-ADDITIVE-AG ,cg1-view) ,ga ,m)))
                  (dk-have! `(IN ,fs (CARR ,cg1-view))
                    (lambda () (dk-cite! 'ring-additive-ag-is-abelian-group cg1-view)
                               (dk-have! `(FORALL cgz_ (IMPLIES (IN cgz_ (ORD-SEGMENT ,m)) (IN (,ga cgz_) (CARR (RING-ADDITIVE-AG ,cg1-view)))))
                                 (lambda () (let ((z (cg1-segv! (dk-landed (lambda () (dk-peel!))))))
                                              (dk-cite! 'ord-segment-nn-subset m z)
                                              (cg1-t-type! z i)
                                              (subst `(== (RING-ADDITIVE-AG ,cg1-view) ,cg1-ag))
                                              (subst `(== (CARR ,cg1-ag) (CARR K)))
                                              (dk-close-if! (lambda () (dk-lam-b!)) cg1-rfl-or-ass!))))
                               (dk-cite! 'sum-ag-type-ptwise m `(RING-ADDITIVE-AG ,cg1-view) ga)
                               (subst `(= (CARR ,cg1-view) (CARR K)))
                               (subst `(== (CARR K) (CARR ,cg1-ag)))
                               (subst `(== ,cg1-ag (RING-ADDITIVE-AG ,cg1-view)))
                               (dk-close-if-asm!)))
                  (cg1-crs!)))))))
      (dk-cite! 'entry-in-carrier 1 'n '(CARR K) 'Lr 1 j)
      (dk-cite! 'nf-converges-scale 'K bj fseq lj hseq)
      (dk-have! `(= ((MUL K) ,lj ,bj) ((MUL K) ,bj ,lj))
        (lambda () (cg1-in-view! lj) (cg1-in-view! bj) (cg1-crs!)))
      (subst `(= ((MUL K) ,lj ,bj) ((MUL K) ,bj ,lj)))
      (dk-close-if-asm!))))
(dk-cite! 'nf-series-finsum-swap 'n 'K cg1-ta cg1-cc cg1-rr cg1-ff cg1-tt cg1-ll)
(dk-have! `(FORALL i (IMPLIES (IN i (ORD-SEGMENT n)) (== (,cg1-ll i) ((MUL K) (ENTRY Lr 1 (succ i)) (ENTRY b (succ i) 1)))))
