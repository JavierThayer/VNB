;;; nf-subfield-module-vector-ag: the two views read the same four slots

(define cg1-fv '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define cg1-md '(NF-SUBFIELD-MODULE K S))
(define cg1-ag '(NORMED-FIELD-ADDITIVE-AG K))
(define (cg1-thm body) `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL S (IMPLIES (IS-NF-SUBFIELD K S) ,body)))))
