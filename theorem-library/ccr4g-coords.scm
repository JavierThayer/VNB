;;; ---------------------------------------------------------------------------
;;; nf-lincomb-sum-ag: K over a subfield S, in K's own operations

(sp (make-wff (cg1-thm `(FORALL n (IMPLIES (IN n NN)
  (FORALL c (IMPLIES (IN c (MAT 1 n S)) (FORALL u (IMPLIES (IN u (MAT n 1 (CARR K)))
  (FORALL g (IMPLIES (FORALL i (IMPLIES (IN i (ORD-SEGMENT n))
                                 (== (g i) ((MUL K) (ENTRY c 1 (succ i)) (ENTRY u (succ i) 1)))))
    (= (LINCOMB ,cg1-md n c u) (SUM-AG ,cg1-ag g n)))))))))))))
(dk-peel!)
(define cg1-gh2 (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q '(g i)))) "the pointwise law"))
(dk-cite! 'nf-subfield-module-is-module 'K 'S)
(define cg1-scal (dk-cite! 'nf-subfield-module-scal 'K 'S))
(dk-cite! 'sub-nf-is-normed-field 'K 'S)
(dk-cite! 'normed-field-ring-view-carr '(SUB-NF K S))
(dk-cite! 'sub-nf-carr 'K 'S)
(define cg1-vec (dk-cite! 'nf-subfield-module-vec 'K 'S))
(dk-cite! 'normed-field-ring-view-carr 'K)
(define cg1-act (dk-cite! 'nf-subfield-module-act 'K 'S))
(dk-cite! 'normed-field-ring-view-mul 'K)
(dk-have! `(IN c (MAT 1 n (CARR (SCAL ,cg1-md))))
  (lambda () (subst cg1-scal) (subst `(== (CARR (NORMED-FIELD-AS-COMMUTATIVE-RING (SUB-NF K S))) (CARR (SUB-NF K S))))
             (subst `(== (CARR (SUB-NF K S)) S)) (ass)))
(dk-have! `(IN u (MAT n 1 (VEC ,cg1-md)))
  (lambda () (subst cg1-vec) (subst `(== (CARR ,cg1-fv) (CARR K))) (ass)))
(define cg1-sub (dk-project! '(FORALL bzx_ (IMPLIES (IN bzx_ S) (IN bzx_ (CARR K)))) 'is-nf-subfield '(IS-NF-SUBFIELD K S)))
(dk-have! `(FORALL i (IMPLIES (IN i (ORD-SEGMENT n))
             (== (g i) ((ACT ,cg1-md) (ENTRY c 1 (succ i)) (ENTRY u (succ i) 1)))))
  (lambda ()
    (dk-peel!)
    (cg1-seg! 'i 'n)
    (if (not (dk-asm? '(IN 1 (INTERVAL 1 1))))
        (begin (fact 'nn-one-in)
               (dk-have! '(IN 1 (INTERVAL 1 1)) (lambda () (dk-have! '(<= 1 1) (lambda () (dk-nn!))) (dk-cite! 'interval-mem-intro 1 1 1) (ass)))))
    (dk-cite! 'entry-in-carrier 1 'n 'S 'c 1 '(succ i))
    (dk-cite! 'entry-in-carrier 'n 1 '(CARR K) 'u '(succ i) 1)
    (dk-apply! cg1-sub '(ENTRY c 1 (succ i)))
    (dk-have! `(IN (ENTRY u (succ i) 1) (CARR ,cg1-fv)) (lambda () (subst `(== (CARR ,cg1-fv) (CARR K))) (ass)))
    (subst cg1-act)
    (dk-lam-b!)
    (subst `(== (MUL ,cg1-fv) (MUL K)))
    (subst (dk-apply! cg1-gh2 'i))
    (cg1-rfl-or-ass!)))
(dk-cite! 'lincomb-sum-ag-ptwise cg1-md 'n 'c 'u 'g)
(dk-cite! 'nf-subfield-module-vector-ag 'K 'S)
(subst `(== ,cg1-ag (MODULE-VECTOR-AG ,cg1-md)))
(cg1-rfl-or-ass!)
(cg1-qed! 'nf-lincomb-sum-ag)

;;; ---------------------------------------------------------------------------
;;; nf-ring-additive-ag-view: the additive group of the ring view of K is NORMED-FIELD-ADDITIVE-AG(K) (==)

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (== (RING-ADDITIVE-AG ,cg1-fv) ,cg1-ag)))))
(dk-peel!)
(mac 'ring-additive-ag)
(mac 'normed-field-additive-ag)
(for-each (lambda (n) (subst (dk-cite! n 'K)))
