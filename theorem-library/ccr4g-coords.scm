;;; ccr4g-coords.scm -- LINCOMB AS A SUM-AG, and the REARRANGEMENT of a series of linear combinations by
;;; coordinates (CCR 4.24, GENERATES half; brief CCR-1111C target 1).  Agent CCR-1111C, 2026-11-11.
;;; Destination: theorem-library/ccr4g-coords.scm.  Library: analysis.  Helper prefix cg1-.
;;;
;;;   lincomb-sum-ag-ptwise        IS-MODULE md, c a 1 x n row of scalars, u an n x 1 column of vectors, g with
;;;                                g(i) == c_(i+1) u_(i+1) for i < n  =>  LINCOMB(md, n, c, u) = SUM-AG(MVAG md, g, n).
;;;                                A general linear-algebra lemma: the FINSUM over INTERVAL(1, n) read as the
;;;                                partial sum over ORD-SEGMENT(n) of any family agreeing with it there.
;;;   nf-subfield-module-vector-ag the vector group of NF-SUBFIELD-MODULE(K, S) is NORMED-FIELD-ADDITIVE-AG(K) (==).
;;;   nf-lincomb-sum-ag            the same law in K's own operations, for K as a module over a subfield S.
;;;
;;; Load window: after gal-op (finsum-interval-as-sum-ag, seg-mem-lt), theorem-library/ccr4d-ext
;;; (nf-subfield-module-*), views; [after ccr4d-ext, end).

(define (cg1-rfl-or-ass!) (cond ((dk-asm? (dk-goal)) (ass)) ((dk-head-is? (dk-goal) '==) (qrfl)) (#t (rfl))))
(define (cg1-qed! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; cg1: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l)
                    (display ";;   GOAL ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (f) (display ";;      | ") (display (expression->string f)) (newline))
                              (let ((a (dk-asms-of l))) (list-head a (min 8 (length a))))))
                  (dk-open-leaves))))
  (qed name))
;; i in ORD-SEGMENT(n), n in NN: land i in NN, i < n, succ i in INTERVAL(1, n)
(define (cg1-seg! i n)
  (if (not (dk-asm? `(IN ,i NN))) (dk-cite! 'ord-segment-nn-subset n i))
  (if (not (dk-asm? `(< ,i ,n)))
      (let ((iff (dk-cite! 'seg-mem-lt n i)))
        (dk-have! `(< ,i ,n) (lambda () (dk-close-if! (lambda () (dk-only! iff `(IN ,i (ORD-SEGMENT ,n)))) prop)))))
  (if (not (dk-asm? `(IN (succ ,i) (INTERVAL 1 ,n))))
      (begin
        (dk-cite! 'nn-succ-closed i)
        (dk-cite! 'nn-one-le-succ i)
        (dk-cite! 'nn-lt-succ-le i n)
        (dk-cite! 'interval-mem-intro 1 n `(succ ,i)))))

;;; ---------------------------------------------------------------------------
;;; lincomb-sum-ag-ptwise

(define cg1-mv '(MODULE-VECTOR-AG md))
(sp (make-wff `(FORALL md (IMPLIES (IS-MODULE md) (FORALL n (IMPLIES (IN n NN)
  (FORALL c (IMPLIES (IN c (MAT 1 n (CARR (SCAL md)))) (FORALL u (IMPLIES (IN u (MAT n 1 (VEC md)))
  (FORALL g (IMPLIES (FORALL i (IMPLIES (IN i (ORD-SEGMENT n))
                                 (== (g i) ((ACT md) (ENTRY c 1 (succ i)) (ENTRY u (succ i) 1)))))
    (= (LINCOMB md n c u) (SUM-AG ,cg1-mv g n))))))))))))))
(dk-peel!)
(dk-cite! 'module-vector-ag-is-abelian-group 'md)
(dk-cite! 'mvag-carr 'md)
(define cg1-gh (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q '(g i)))) "the pointwise law"))
(define cg1-L (caddr (dk-cite! 'lincomb-unfold 'md 'n 'c 'u)))
(define cg1-La (caddr cg1-L))
(subst `(= (LINCOMB md n c u) ,cg1-L))
(define (cg1-pt! j)                     ; j in 1..n: La(j) = c_j u_j, a vector
  (let ((val `((ACT md) (ENTRY c 1 ,j) (ENTRY u ,j 1))))
    (if (not (dk-asm? `(IN (ENTRY c 1 ,j) (CARR (SCAL md)))))
        (begin
          (if (not (dk-asm? '(IN 1 (INTERVAL 1 1))))
              (begin (fact 'nn-one-in)
                     (dk-have! '(IN 1 (INTERVAL 1 1)) (lambda () (dk-have! '(<= 1 1) (lambda () (dk-nn!))) (dk-cite! 'interval-mem-intro 1 1 1) (ass)))))
          (dk-cite! 'entry-in-carrier 1 'n '(CARR (SCAL md)) 'c 1 j)
          (dk-cite! 'entry-in-carrier 'n 1 '(VEC md) 'u j 1)
          (dk-cite! 'module-act-type 'md `(ENTRY c 1 ,j) `(ENTRY u ,j 1))))
    (if (not (dk-asm? `(= (,cg1-La ,j) ,val)))
        (dk-have! `(= (,cg1-La ,j) ,val) (lambda () (dk-lam-b!) (cg1-rfl-or-ass!))))
    val))
(dk-have! `(IN ,cg1-La (FUN (INTERVAL 1 n) (CARR ,cg1-mv)))
  (lambda ()
    (dk-lam-type!
      (lambda () (let* ((j (dk-di-var!)))
                   (cg1-pt! j)
                   (subst `(= (CARR ,cg1-mv) (VEC md)))
                   (ass)))
      (lambda () (dk-cite! 'interval-in-set 1 'n) (ass)))))
(subst (dk-cite! 'finsum-interval-as-sum-ag 'n cg1-mv cg1-La))
(define cg1-sh `(VNB-LAMBDA gbk_ NN (,cg1-La (succ gbk_))))
(dk-have! `(FORALL gbi_ (IMPLIES (IN gbi_ (ORD-SEGMENT n)) (== (,cg1-sh gbi_) (g gbi_))))
  (lambda ()
    (dk-peel!)
    (cg1-seg! 'gbi_ 'n)
    (cg1-pt! '(succ gbi_))
    (dk-lam-b!)
    (subst (dk-apply! cg1-gh 'gbi_))
    (cg1-rfl-or-ass!)))
(subst (dk-cite! 'sum-ag-segment-congruence 'n cg1-mv cg1-sh 'g))
(dk-have! `(FORALL gbi_ (IMPLIES (IN gbi_ (ORD-SEGMENT n)) (IN (g gbi_) (CARR ,cg1-mv))))
  (lambda ()
    (dk-peel!)
    (cg1-seg! 'gbi_ 'n)
    (cg1-pt! '(succ gbi_))
    (subst (dk-apply! cg1-gh 'gbi_))
    (subst `(= (CARR ,cg1-mv) (VEC md)))
    (ass)))
(dk-cite! 'sum-ag-type-ptwise 'n cg1-mv 'g)
(cg1-rfl-or-ass!)
(cg1-qed! 'lincomb-sum-ag-ptwise)

