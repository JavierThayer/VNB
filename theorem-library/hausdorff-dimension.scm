;;; mh-dim.scm -- Hausdorff dimension (construction-of-measures.pdf, 4.3): Prop 4.53 and
;;; its corollary (uniqueness of the dimension), Prop 4.54.  Prefix mhd-.  Library: measure.
;;; Loads after mh-vocab.scm, mh-method2.scm, mh-hausdorff.scm.

;;; t in RR-POS-STAR, t <= b real  ==>  t in RR, 0 <= t
;;; ---- helper defines COPIED 2026-10-27 (integration) from hausdorff-measure, method-ii: this file loads in its own environment
(define (mh2-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "mh2-pick: nothing matching" what) (car l))))
(define (mh2-split-goal!)
  (let loop ((todo (list (proof-state-focus *ps*))) (acc '()))
    (if (null? todo) (reverse acc)
        (begin (dk-focus! (car todo))
               (if (dk-head-is? (dk-goal) 'AND)
                   (loop (append (dk-opened (lambda () (di))) (cdr todo)) acc)
                   (loop (cdr todo) (cons (car todo) acc)))))))
(define (mh2-sep-sub! s)
  (dk-have! (list 'SUBSET s (caddr s))
    (lambda () (mac 'subset-def) (di)
               (sep-me (mh2-pick 'member (lambda (z) (and (dk-head-is? z 'IN) (equal? (caddr z) s)))))
               (ass))))
(define (mh2-esum-type! fv)
  (fact 'nn-is-set)
  (dk-project! (list 'IN fv '(FUN NN)) 'fun-codomain-iff (list 'IN fv '(FUN NN RR-POS-STAR)))
  (dk-have! (list 'AND (list 'IN fv '(FUN NN)) '(IN NN SET)))
  (fact 'dom-of-fun 'NN fv)
  (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN (list 'DOM fv) 'SET) (list '= (list 'DOM fv) 'NN)))))
  (dk-have! (list 'IN fv (list 'FUN (list 'DOM fv) 'RR-POS-STAR))
            (lambda () (subst (list '= (list 'DOM fv) 'NN)) (ass)))
  (fact 'esum-in fv))
(define (mhh-rps! t)                       ; (IN t RR-POS-STAR) from (IN t RR), (<= 0 t)
  (if (not (dk-asm? (list 'IN t 'RR-POS-STAR)))
      (dk-have! (list 'IN t 'RR-POS-STAR)
        (lambda () (mac 'rr-pos-star-membership) (oi-l) (dk-conj-close! (lambda () (ass)))))))
(define (mhh-and! . fs)
  (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l))))))
(define (mhh-have-and! . fs) (dk-have! (apply mhh-and! fs)))
(define (mhh-le-trans! x y z)
  (mhh-have-and! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR) (list 'IN z 'RR-POS-STAR))
  (mhh-have-and! (list '<= x y) (list '<= y z))
  (fact 'rr-pos-star-le-trans x y z))
(define (mh2-cd m cls dl) (list 'SEP 'mha_ cls (list '<= (list 'DIAM m 'mha_) dl)))
(define (mh2-rcd m cls pm dl) (list 'RESTRICT pm (mh2-cd m cls dl)))
(define (mh2-cd-parts! x cd)
  (dk-project! (list 'IN x (caddr cd)) (lambda () (sep-me (list 'IN x cd))))
  (dk-project! (list '<= (list 'DIAM 'm x) (caddr (cadddr cd))) (lambda () (sep-me (list 'IN x cd)))))
(define (mh2-cs m cls pm dl es) (list 'COVER-SUMS (list 'PTS m) (mh2-cd m cls dl) (mh2-rcd m cls pm dl) es))
;;; ---- end of copied helpers ----

(define (mhd-real-below! t b)
  (dk-have! (list 'NOT (list '= t 'POS-INF))
    (lambda () (di)
      (dk-rewrite-h! (list '<= t b) t 'POS-INF)
      (fact 'pos-inf-above-reals b)
      (if (dk-only! (list '<= 'POS-INF b) (list 'NOT (list '<= 'POS-INF b))) (prop))))
  (let ((iff (dk-cite! 'rr-pos-star-membership t)))
    (dk-have! (list 'IN t 'RR)
      (lambda () (if (dk-only! iff (list 'IN t 'RR-POS-STAR) (list 'NOT (list '= t 'POS-INF))) (prop))))
    (fact 'rr-pos-star-nonneg t)))
(define (mhd-mul! a b)                         ; (IN (* a b) RR)
  (if (not (dk-asm? (list 'IN (list '* a b) 'RR)))
      (begin (dk-have! (list 'AND (list 'IN a 'RR) (list 'IN b 'RR))) (fact 'rr-mul-closed a b))))
(define (mhd-sub! a b)                         ; (IN (- a b) RR)
  (if (not (dk-asm? (list 'IN (list '- a b) 'RR))) (fact 'rr-sub-in-rr a b)))

;;; THE KEY ESTIMATE: 0 < t <= dl, rho < lam  ==>  dl^(rho-lam) t^lam <= t^rho
(sp (make-wff (forall-guarded '(t dl rho lam)
  '((IN t RR) (< 0 t) (IN dl RR) (<= t dl) (IN rho RR) (IN lam RR) (< rho lam))
  '(<= (* (RPOW-STAR dl (- rho lam)) (RPOW-STAR t lam)) (RPOW-STAR t rho)))))
(dk-peel!)
(let* ((gap '(- lam rho)) (e '(- rho lam))
       (kk (list 'RPOW-STAR 'dl e)) (pwl '(RPOW-STAR t lam)) (pwr '(RPOW-STAR t rho))
       (pb (list 'RPOW-STAR 't gap)) (pd (list 'RPOW-STAR 'dl gap)))
  (mhd-sub! 'lam 'rho) (mhd-sub! 'rho 'lam)
  (dk-have! '(< 0 dl) (lambda () (dk-ineq! '(< 0 t) '(<= t dl))))
  (dk-have! (list '< 0 gap) (lambda () (dk-ineq! '(< rho lam))))
  ;; A: t^lam = t^rho t^gap
  (fact 'rpow-star-add 't 'rho gap)
  (dk-have! (list '= (list '+ 'rho gap) 'lam) (lambda () (dk-ineq!)))
  (dk-rewrite-h! (list '= (list 'RPOW-STAR 't (list '+ 'rho gap)) (list '* pwr pb)) (list '+ 'rho gap) 'lam)
  ;; C: dl^e dl^gap = 1
  (fact 'rpow-star-add 'dl e gap)
  (dk-have! (list '= (list '+ e gap) 0) (lambda () (dk-ineq!)))
  (dk-rewrite-h! (list '= (list 'RPOW-STAR 'dl (list '+ e gap)) (list '* kk pd)) (list '+ e gap) 0)
  (fact 'rpow-star-zero 'dl)
  (dk-rewrite-h! (list '= '(RPOW-STAR dl 0) (list '* kk pd)) '(RPOW-STAR dl 0) 1)
  ;; typings
  (for-each (lambda (pr) (fact 'rpow-star-in-rr (car pr) (cadr pr)) (fact 'rpow-star-pos (car pr) (cadr pr)))
            (list (list 'dl e) (list 't 'lam) (list 't 'rho) (list 't gap) (list 'dl gap)))
  ;; B: t^gap <= dl^gap
  (dk-have! (list '<= pb pd)
    (lambda ()
      (use-em '(= t dl)
        (lambda () (subst '(= t dl)) (fact 'rr-leq-reflexive pd) (ass))
        (lambda ()
          (dk-have! '(AND (<= t dl) (NOT (= t dl))))
          (fact 'rr-le-ne-lt 't 'dl)
          (fact 'rpow-star-mono-base 't 'dl gap)
          (dk-ineq! (list '< pb pd))))))
  (subst (list '= pwl (list '* pwr pb)))
  (mhd-mul! kk pwr) (mhd-mul! pwr pb) (mhd-mul! kk (list '* pwr pb)) (mhd-mul! (list '* kk pwr) pb) (mhd-mul! (list '* kk pwr) pd)
  (mhd-mul! kk pd) (mhd-mul! pwr (list '* kk pd))
  (fact 'rr-mul-pos kk pwr)
  (dk-have! (list '<= 0 (list '* kk pwr)) (lambda () (dk-ineq! (list '< 0 (list '* kk pwr)))))
  (dk-have! (list 'AND (list '<= 0 (list '* kk pwr)) (list '<= pb pd)))
  (fact 'rr-le-scale-nonneg (list '* kk pwr) pb pd)
  (dk-have! (list '= (list '* kk (list '* pwr pb)) (list '* (list '* kk pwr) pb)) (lambda () (crs)))
  (dk-have! (list '= (list '* (list '* kk pwr) pd) (list '* pwr (list '* kk pd))) (lambda () (crs)))
  (dk-rewrite-h! (list '= (list '* (list '* kk pwr) pd) (list '* pwr (list '* kk pd))) (list '* kk pd) 1)
  (dk-ineq! (list '= (list '* kk (list '* pwr pb)) (list '* (list '* kk pwr) pb))
            (list '<= (list '* (list '* kk pwr) pb) (list '* (list '* kk pwr) pd))
            (list '= (list '* (list '* kk pwr) pd) (list '* pwr 1))))
(qed 'mhd-rpow-key)

;;; the same in EPOW / etimes form, t in [0, dl]
(sp (make-wff (forall-guarded '(t dl rho lam)
  '((IN t RR-POS-STAR) (IN dl RR) (< 0 dl) (<= t dl) (IN rho RR) (< 0 rho) (IN lam RR) (< rho lam))
  '(<= (etimes (RPOW-STAR dl (- rho lam)) (EPOW t lam)) (EPOW t rho)))))
(dk-peel!)
(let* ((e '(- rho lam)) (kk (list 'RPOW-STAR 'dl e)))
  (mhd-real-below! 't 'dl)
  (mhd-sub! 'rho 'lam)
  (fact 'rpow-star-in-rr 'dl e) (fact 'rpow-star-pos 'dl e)
  (dk-have! (list '<= 0 kk) (lambda () (dk-ineq! (list '< 0 kk))))
  (dk-have! '(< 0 lam) (lambda () (dk-ineq! '(< 0 rho) '(< rho lam))))
  (use-em '(= 0 t)
    (lambda ()
      (subst '(= t 0))
      (subst (dk-cite! 'epow-zero 'lam))
      (subst (dk-cite! 'epow-zero 'rho))
      (dk-have! '(IN 0 RR))
      (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
      (fact 'etimes-real-defined kk 0)
      (subst (list '= (list 'etimes kk 0) (list 'bintimes kk 0)))
      (dk-have! (list '= (list 'bintimes kk 0) 0) (lambda () (crs)))
      (subst (list '= (list 'bintimes kk 0) 0))
      (dk-ineq!))
    (lambda ()
      (dk-have! '(AND (<= 0 t) (NOT (= 0 t))))
      (fact 'rr-le-ne-lt 0 't)
      (subst (dk-cite! 'epow-real 't 'lam))
      (subst (dk-cite! 'epow-real 't 'rho))
      (fact 'rpow-star-in-rr 't 'lam) (fact 'rpow-star-pos 't 'lam)
      (dk-have! '(<= 0 (RPOW-STAR t lam)) (lambda () (dk-ineq! '(< 0 (RPOW-STAR t lam)))))
      (fact 'etimes-real-defined kk '(RPOW-STAR t lam))
      (subst (list '= (list 'etimes kk '(RPOW-STAR t lam)) (list 'bintimes kk '(RPOW-STAR t lam))))
      (dk-have! (list '= (list 'bintimes kk '(RPOW-STAR t lam)) (list '* kk '(RPOW-STAR t lam))) (lambda () (crs)))
      (subst (list '= (list 'bintimes kk '(RPOW-STAR t lam)) (list '* kk '(RPOW-STAR t lam))))
      (fact 'mhd-rpow-key 't 'dl 'rho 'lam)
      (ass))))
(qed 'mhd-epow-key)

;;; LEMMA (same metric, same class): K p1 <= p on C_d  ==>  K mu1*_d(E) <= mu*_d(E)
(sp (make-wff (forall-guarded '(m cls p p1 d kk es)
  '((IS-PREMEASURE (PTS m) cls p) (IS-PREMEASURE (PTS m) cls p1) (IN d RR) (<= 0 d) (IN kk RR) (< 0 kk)
    (FORALL a (IMPLIES (IN a cls) (IMPLIES (<= (DIAM m a) d) (<= (etimes kk (p1 a)) (p a)))))
    (IN es (POWER (PTS m))))
  '(<= (etimes kk ((METHOD-II-DELTA m cls p1 d) es)) ((METHOD-II-DELTA m cls p d) es)))))
(dk-peel!)
(define mhd3-hp (mh2-pick 'hp (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'kk)))))
(let* ((cd (mh2-cd 'm 'cls 'd)) (r (mh2-rcd 'm 'cls 'p 'd)) (r1 (mh2-rcd 'm 'cls 'p1 'd))
       (cs (mh2-cs 'm 'cls 'p 'd 'es)) (cs1 (mh2-cs 'm 'cls 'p1 'd 'es))
       (y (list 'EINF cs1)) (bb (list 'etimes 'kk y)))
  (subst (dk-cite! 'method-ii-delta-value 'm 'cls 'p 'd 'es))
  (subst (dk-cite! 'method-ii-delta-value 'm 'cls 'p1 'd 'es))
  (fact 'rr-lt-implies-le 0 'kk) (mhh-rps! 'kk)
  (fact 'method-ii-delta-premeasure 'm 'cls 'p 'd)
  (fact 'method-ii-delta-premeasure 'm 'cls 'p1 'd)
  (for-each (lambda (rr) (dk-project! (list 'IN rr (list 'FUN cd 'RR-POS-STAR)) 'is-premeasure (list 'IS-PREMEASURE '(PTS m) cd rr)))
            (list r r1))
  (mh2-sep-sub! cd)
  (dk-project! '(SUBSET cls (POWER (PTS m))) 'is-premeasure '(IS-PREMEASURE (PTS m) cls p))
  (fact 'cover-sums-subset '(PTS m) cd r 'es)
  (fact 'cover-sums-subset '(PTS m) cd r1 'es)
  (fact 'einf-in cs) (fact 'einf-in cs1)
  (fact 'einf-lower cs1)
  (fact 'nn-is-set)
  (dk-have! (list 'AND '(IN kk RR-POS-STAR) (list 'IN y 'RR-POS-STAR))) (fact 'etimes-closed 'kk y)
  (dk-have! (list 'FORALL 'v (list 'IMPLIES (list 'IN 'v cs) (list '<= bb 'v)))
    (lambda ()
      (let* ((pl (dk-peel!)) (v (cadr (car pl)))
             (ex (dk-cite! 'cover-sums-elim '(PTS m) cd r 'es v))
             (sq (dk-skolem! ex #t))
             (l0 (list 'VNB-LAMBDA 'cvk_ 'NN (list r (list sq 'cvk_))))
             (l1 (list 'VNB-LAMBDA 'cvk_ 'NN (list r1 (list sq 'cvk_))))
             (lh (list 'VNB-LAMBDA 'cvk_ 'NN (list 'etimes 'kk (list r1 (list sq 'cvk_))))))
        (define (lam-typed! lam body!)
          (dk-have! (list 'IN lam '(FUN NN RR-POS-STAR))
            (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (body! j) (ass))) (lambda () (ass))))))
        (define (sq-typed! j) (fact 'fun-apply-type-c sq 'NN cd j))
        (define (r0-typed! j) (sq-typed! j) (fact 'fun-apply-type-c r cd 'RR-POS-STAR (list sq j)))
        (define (r1-typed! j) (sq-typed! j) (fact 'fun-apply-type-c r1 cd 'RR-POS-STAR (list sq j)))
        (define (rh-typed! j) (r1-typed! j)
          (dk-have! (list 'AND '(IN kk RR-POS-STAR) (list 'IN (list r1 (list sq j)) 'RR-POS-STAR)))
          (fact 'etimes-closed 'kk (list r1 (list sq j))))
        (lam-typed! l0 r0-typed!)
        (lam-typed! l1 r1-typed!)
        (lam-typed! lh rh-typed!)
        (dk-have! (list 'SUBSET 'es (list 'BIG-UNION 'cvn_ 'NN (list sq 'cvn_))) (lambda () (ass)))
        (fact 'cover-sums-intro '(PTS m) cd r1 'es sq)
        (inst+ (mh2-pick 'low (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z cs1) (dk-contains? z 'EINF)))) (list 'ESUM l1))
        ;; termwise kk.R1(s j) <= R(s j)
        (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list '<= (list lh 'j) (list l0 'j))))
          (lambda ()
            (let ((j (dk-di-var!)))
              (rh-typed! j) (r0-typed! j)
              (dk-lam-b!)
              (subst (dk-cite! 'restrict-apply 'p cd (list sq j)))
              (subst (dk-cite! 'restrict-apply 'p1 cd (list sq j)))
              (mh2-cd-parts! (list sq j) cd)
              (inst*! mhd3-hp (list sq j))
              (ass))))
        (fact 'esum-nn-le-termwise lh l0)
        (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ NN) (list '= (list lh 'z_) (list 'etimes 'kk (list l1 'z_)))))
          (lambda () (let ((j (dk-di-var!))) (rh-typed! j) (dk-lam-b!) (rfl))))
        (fact 'esum-scale-ptwise 'kk 'NN l1 lh)
        (mh2-esum-type! l0) (mh2-esum-type! lh) (mh2-esum-type! l1)
        (fact 'rr-pos-star-le-refl 'kk)
        (fact 'etimes-mono-star 'kk 'kk y (list 'ESUM l1))
        (dk-have! (list 'AND '(IN kk RR-POS-STAR) (list 'IN (list 'ESUM l1) 'RR-POS-STAR)))
        (fact 'etimes-closed 'kk (list 'ESUM l1))
        (dk-rewrite-h! (list '<= bb (list 'etimes 'kk (list 'ESUM l1))) (list 'etimes 'kk (list 'ESUM l1)) (list 'ESUM lh))
        (subst (list '= v (list 'ESUM l0)))
        (mhh-le-trans! bb (list 'ESUM lh) (list 'ESUM l0))
        (ass))))
  (fact 'einf-greatest cs)
  (inst+ (mh2-pick 'gr (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z 'cpsb_) (not (dk-contains? z 'cpss_))))) bb)
  (ass))
(qed 'method-ii-delta-scale-below)

;;; the unfold of HAUSDORFF, as a theorem (mac-h cannot unfold a functoid by its own name)
(sp (make-wff '(FORALL m (FORALL lam (== (HAUSDORFF m lam) (METHOD-II m (POWER (PTS m)) (HAUSDORFF-PM m lam)))))))
(dk-peel!)
(mac 'HAUSDORFF)
(if (not (proof-done? *ps*)) (qrfl))
(qed 'hausdorff-unfold)

;;; at scale d: d^(rho-lam) H^lam_d(E) <= H^rho_d(E)
(sp (make-wff (forall-guarded '(m d rho lam es)
  '((IS-METRIC-SPACE m) (POS-RR d) (IN rho RR) (< 0 rho) (IN lam RR) (< rho lam) (IN es (POWER (PTS m))))
  '(<= (etimes (RPOW-STAR d (- rho lam)) ((METHOD-II-DELTA m (POWER (PTS m)) (HAUSDORFF-PM m lam) d) es))
       ((METHOD-II-DELTA m (POWER (PTS m)) (HAUSDORFF-PM m rho) d) es)))))
(dk-peel!)
(let* ((e '(- rho lam)) (kk (list 'RPOW-STAR 'd e)))
  (dk-pos-parts! 'd)
  (mhd-sub! 'rho 'lam)
  (fact 'rpow-star-in-rr 'd e) (fact 'rpow-star-pos 'd e)
  (dk-have! '(< 0 lam) (lambda () (dk-ineq! '(< 0 rho) '(< rho lam))))
  (fact 'hausdorff-pm-premeasure 'm 'lam)
  (fact 'hausdorff-pm-premeasure 'm 'rho)
  (dk-have! (list 'FORALL 'a (list 'IMPLIES '(IN a (POWER (PTS m))) (list 'IMPLIES '(<= (DIAM m a) d)
              (list '<= (list 'etimes kk '((HAUSDORFF-PM m lam) a)) '((HAUSDORFF-PM m rho) a)))))
    (lambda ()
      (let* ((pl (dk-peel!)) (a (cadr (car (filter (lambda (z) (dk-head-is? z 'IN)) pl)))))
        (subst (dk-cite! 'hausdorff-pm-value 'm 'lam a))
        (subst (dk-cite! 'hausdorff-pm-value 'm 'rho a))
        (fact 'diam-in 'm a)
        (fact 'mhd-epow-key (list 'DIAM 'm a) 'd 'rho 'lam)
        (ass))))
  (fact 'method-ii-delta-scale-below 'm '(POWER (PTS m)) '(HAUSDORFF-PM m rho) '(HAUSDORFF-PM m lam) 'd kk 'es)
  (ass))
(qed 'hausdorff-delta-below)

;;; d^gap can be made <= q with d <= d0
(sp (make-wff (forall-guarded '(gap q d0)
  '((IN gap RR) (< 0 gap) (IN q RR) (< 0 q) (IN d0 RR) (< 0 d0))
  '(FORSOME mhd_ (AND (POS-RR mhd_) (AND (<= mhd_ d0) (<= (RPOW-STAR mhd_ gap) q)))))))
(dk-peel!)
(let* ((ig '(recip gap)) (d1 (list 'RPOW-STAR 'q ig)))
  (fact 'rr-pos-ne-zero 'gap)
  (dk-have! '(AND (IN gap RR) (NOT (= gap 0))))
  (fact 'rr-recip-closed 'gap) (fact 'rr-recip-pos 'gap) (fact 'rr-recip-inverse 'gap)
  (fact 'rpow-star-in-rr 'q ig) (fact 'rpow-star-pos 'q ig)
  (fact 'rpow-star-pow 'q ig 'gap)
  (dk-have! '(= (* (recip gap) gap) 1)
    (lambda () (dk-have! '(= (* (recip gap) gap) (* gap (recip gap))) (lambda () (dk-crs-opaque!)))
               (subst '(= (* (recip gap) gap) (* gap (recip gap)))) (ass)))
  (dk-rewrite-h! (list '= (list 'RPOW-STAR d1 'gap) (list 'RPOW-STAR 'q '(* (recip gap) gap))) '(* (recip gap) gap) 1)
  (fact 'rpow-star-one 'q)
  (dk-rewrite-h! (list '= (list 'RPOW-STAR d1 'gap) '(RPOW-STAR q 1)) '(RPOW-STAR q 1) 'q)
  (fact 'rpow-star-in-rr d1 'gap)
  (use-em (list '<= d1 'd0)
    (lambda ()
      (fact 'rr-pos-rr-of-lt d1)
      (witness! d1 (lambda ()
        (for-each (lambda (leaf) (dk-focus! leaf)
                    (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '= (list 'RPOW-STAR d1 'gap) 'q))))
                  (mh2-split-goal!)))))
    (lambda ()
      (fact 'rr-not-le-lt d1 'd0)
      (fact 'rr-pos-rr-of-lt 'd0)
      (fact 'rpow-star-mono-base 'd0 d1 'gap)
      (fact 'rpow-star-in-rr 'd0 'gap)
      (witness! 'd0 (lambda ()
        (for-each (lambda (leaf) (dk-focus! leaf)
                    (cond ((dk-asm? (dk-goal)) (ass))
                          ((equal? (dk-goal) '(<= d0 d0)) (fact 'rr-leq-reflexive 'd0) (ass))
                          (#t (dk-ineq! (list '= (list 'RPOW-STAR d1 'gap) 'q) (list '< '(RPOW-STAR d0 gap) (list 'RPOW-STAR d1 'gap))))))
                  (mh2-split-goal!)))))))
(qed 'mhd-small-power)

;;; helpers for 4.53
(define mhd-P '(POWER (PTS m)))
(define (mhd-mi p d) (list (list 'METHOD-II-DELTA 'm mhd-P p d) 'es))
(define (mhd-mi-in! p d)                       ; (IN mu*_d(es) RR-POS-STAR); needs IN d RR, 0 <= d
  (fact 'method-ii-delta-outer 'm mhd-P p d)
  (dk-project! (list 'IN (list 'METHOD-II-DELTA 'm mhd-P p d) (list 'FUN mhd-P 'RR-POS-STAR)) 'is-outer-measure
               (list 'IS-OUTER-MEASURE '(PTS m) (list 'METHOD-II-DELTA 'm mhd-P p d)))
  (fact 'fun-apply-type-c (list 'METHOD-II-DELTA 'm mhd-P p d) mhd-P 'RR-POS-STAR 'es))
(define (mhd-clash! f)                         ; f and (NOT f) in context: close the goal
  (if (dk-only! f (list 'NOT f)) (prop)))
(define (mhd-star-real! t)                     ; t in RR-POS-STAR, NOT t = POS-INF  ==>  t in RR, 0 <= t
  (let ((iff (dk-cite! 'rr-pos-star-membership t)))
    (dk-have! (list 'IN t 'RR)
      (lambda () (if (dk-only! iff (list 'IN t 'RR-POS-STAR) (list 'NOT (list '= t 'POS-INF))) (prop))))
    (fact 'rr-pos-star-nonneg t)))

;;; H^lam(E) > 0  ==>  H^lam_d0(E) /= 0 for some d0 > 0
(sp (make-wff (forall-guarded '(m lam es)
  '((IS-METRIC-SPACE m) (IN lam RR) (< 0 lam) (IN es (POWER (PTS m))) (< 0 ((HAUSDORFF m lam) es)))
  '(FORSOME mhd_ (AND (POS-RR mhd_) (NOT (= ((METHOD-II-DELTA m (POWER (PTS m)) (HAUSDORFF-PM m lam) mhd_) es) 0)))))))
(dk-peel!)
(let* ((pl '(HAUSDORFF-PM m lam)) (F (dk-goal)) (hm (list (list 'METHOD-II 'm mhd-P pl) 'es)))
  (fact 'hausdorff-pm-premeasure 'm 'lam)
  (use-em F
    (lambda () (ass))
    (lambda ()
      (dk-have! '(IN 0 RR)) (dk-have! '(<= 0 0) (lambda () (dk-ineq!))) (mhh-rps! 0)
      (dk-have! (list 'FORALL 'dl (list 'IMPLIES '(POS-RR dl) (list '<= (mhd-mi pl 'dl) 0)))
        (lambda ()
          (let* ((pl2 (dk-peel!)) (dl (cadr (car pl2))))
            (use-em (list '= (mhd-mi pl dl) 0)
              (lambda () (subst (list '= (mhd-mi pl dl) 0)) (ass))
              (lambda ()
                (dk-have! F (lambda () (witness! dl (lambda () (dk-close-all! (lambda () (mh2-split-goal!)))))))
                (mhd-clash! F))))))
      (fact 'method-ii-least 'm mhd-P pl 'es 0)
      (fact 'method-ii-in 'm mhd-P pl 'es)
      (fact 'rr-pos-star-nonneg hm)
      (fact 'hausdorff-unfold 'm 'lam)
      (dk-rewrite-h! '(< 0 ((HAUSDORFF m lam) es)) '(HAUSDORFF m lam) (list 'METHOD-II 'm mhd-P pl))
      (dk-have! (list 'AND (list 'IN hm 'RR-POS-STAR) '(IN 0 RR-POS-STAR)))
      (dk-have! (list 'AND (list '<= hm 0) (list '<= 0 hm)))
      (fact 'rr-pos-star-le-antisymm hm 0)
      (dk-rewrite-h! (list '< 0 hm) hm 0)
      (fact 'rr-lt-irrefl 0)
      (mhd-clash! '(< 0 0)))))
(qed 'hausdorff-scale-pos)

;;; PROPOSITION 4.53: H^lam(E) > 0, 0 < rho < lam  ==>  H^rho(E) = +inf
(sp (make-wff (forall-guarded '(m lam rho es)
  '((IS-METRIC-SPACE m) (IN lam RR) (IN rho RR) (< 0 rho) (< rho lam) (IN es (POWER (PTS m)))
    (< 0 ((HAUSDORFF m lam) es)))
  '(= ((HAUSDORFF m rho) es) POS-INF))))
(dk-peel!)
(let* ((pl '(HAUSDORFF-PM m lam)) (pr '(HAUSDORFF-PM m rho))
       (hm (list (list 'METHOD-II 'm mhd-P pr) 'es)) (e '(- rho lam)) (gap '(- lam rho)))
  (dk-have! '(< 0 lam) (lambda () (dk-ineq! '(< 0 rho) '(< rho lam))))
  (mhd-sub! 'rho 'lam) (mhd-sub! 'lam 'rho)
  (dk-have! (list '< 0 gap) (lambda () (dk-ineq! '(< rho lam))))
  (fact 'hausdorff-pm-premeasure 'm 'lam)
  (fact 'hausdorff-pm-premeasure 'm 'rho)
  (fact 'hausdorff-scale-pos 'm 'lam 'es)
  (let* ((d0 (dk-skolem! (mh2-pick 'ex (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z 'mhd_)))) #t))
         (h0 (mhd-mi pl d0)) (k0 (list 'RPOW-STAR d0 e)))
    (dk-pos-parts! d0)
    (mhd-mi-in! pl d0)
    (subst (dk-cite! 'hausdorff-unfold 'm 'rho))
    (fact 'method-ii-in 'm mhd-P pr 'es)
    (use-em (list '= hm 'POS-INF)
      (lambda () (ass))
      (lambda ()
        (mhd-star-real! hm)
        (fact 'pos-inf-in-rr-pos-star)
        (use-em (list '= h0 'POS-INF)
          ;; h0 = +inf: +inf <= mu*_rho,d0(E) <= H^rho(E), a real
          (lambda ()
            (fact 'rpow-star-in-rr d0 e) (fact 'rpow-star-pos d0 e)
            (dk-have! (list '<= 0 k0) (lambda () (dk-ineq! (list '< 0 k0)))) (mhh-rps! k0)
            (fact 'rr-pos-ne-zero k0)
            (fact 'hausdorff-delta-below 'm d0 'rho 'lam 'es)
            (dk-rewrite-h! (list '<= (list 'etimes k0 h0) (mhd-mi pr d0)) h0 'POS-INF)
            (fact 'etimes-pos-inf-right k0)
            (dk-rewrite-h! (list '<= (list 'etimes k0 'POS-INF) (mhd-mi pr d0)) (list 'etimes k0 'POS-INF) 'POS-INF)
            (mhd-mi-in! pr d0)
            (fact 'method-ii-delta-le 'm mhd-P pr 'es d0)
            (mhh-le-trans! 'POS-INF (mhd-mi pr d0) hm)
            (fact 'pos-inf-above-reals hm)
            (mhd-clash! (list '<= 'POS-INF hm)))
          ;; h0 a positive real
          (lambda ()
            (mhd-star-real! h0)
            (dk-have! (list 'NOT (list '= 0 h0))
              (lambda () (di) (dk-have! (list '= h0 0) (lambda () (dk-ineq! (list '= 0 h0)))) (mhd-clash! (list '= h0 0))))
            (dk-have! (list 'AND (list '<= 0 h0) (list 'NOT (list '= 0 h0))))
            (fact 'rr-le-ne-lt 0 h0)
            (let* ((m1 (list '+ hm 1)) (q (list '* h0 (list 'recip m1))))
              (dk-have! '(IN 1 RR))
              (dk-have! (list 'AND (list 'IN hm 'RR) '(IN 1 RR))) (fact 'rr-add-closed hm 1)
              (dk-have! (list '< 0 m1) (lambda () (dk-ineq! (list '<= 0 hm))))
              (fact 'rr-pos-ne-zero m1)
              (dk-have! (list 'AND (list 'IN m1 'RR) (list 'NOT (list '= m1 0))))
              (fact 'rr-recip-closed m1) (fact 'rr-recip-pos m1)
              (mhd-mul! h0 (list 'recip m1))
              (fact 'rr-mul-pos h0 (list 'recip m1))
              (fact 'mhd-small-power gap q d0)
              (let* ((dl (dk-skolem! (mh2-pick 'ex2 (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z 'mhd_) (dk-contains? z gap)))) #t))
                     (hd (mhd-mi pl dl)) (kk (list 'RPOW-STAR dl e)) (pg (list 'RPOW-STAR dl gap)))
                (if (dk-asm? (list 'AND (list '<= dl d0) (list '<= pg q))) (dk-split! (list 'AND (list '<= dl d0) (list '<= pg q))))
                (dk-pos-parts! dl)
                (fact 'rpow-star-in-rr dl e) (fact 'rpow-star-pos dl e)
                (fact 'rpow-star-in-rr dl gap)
                (dk-have! (list '<= 0 kk) (lambda () (dk-ineq! (list '< 0 kk)))) (mhh-rps! kk)
                (mhd-mi-in! pl dl) (mhd-mi-in! pr dl)
                (fact 'method-ii-delta-antitone 'm mhd-P pl dl d0 'es)
                (fact 'hausdorff-delta-below 'm dl 'rho 'lam 'es)
                (fact 'method-ii-delta-le 'm mhd-P pr 'es dl)
                (fact 'rr-pos-star-le-refl kk)
                (fact 'etimes-mono-star kk kk h0 hd)
                (dk-have! (list 'AND (list 'IN kk 'RR-POS-STAR) (list 'IN hd 'RR-POS-STAR))) (fact 'etimes-closed kk hd)
                (dk-have! (list 'AND (list 'IN kk 'RR-POS-STAR) (list 'IN h0 'RR-POS-STAR))) (fact 'etimes-closed kk h0)
                (mhh-le-trans! (list 'etimes kk h0) (list 'etimes kk hd) (mhd-mi pr dl))
                (mhh-le-trans! (list 'etimes kk h0) (mhd-mi pr dl) hm)
                (fact 'etimes-real-defined kk h0)
                (dk-rewrite-h! (list '<= (list 'etimes kk h0) hm) (list 'etimes kk h0) (list 'bintimes kk h0))
                (dk-have! (list '= (list 'bintimes kk h0) (list '* kk h0)) (lambda () (crs)))
                (dk-rewrite-h! (list '<= (list 'bintimes kk h0) hm) (list 'bintimes kk h0) (list '* kk h0))
                ;; kk . dl^gap = 1
                (fact 'rpow-star-add dl e gap)
                (dk-have! (list '= (list '+ e gap) 0) (lambda () (dk-ineq!)))
                (dk-rewrite-h! (list '= (list 'RPOW-STAR dl (list '+ e gap)) (list '* kk pg)) (list '+ e gap) 0)
                (fact 'rpow-star-zero dl)
                (dk-rewrite-h! (list '= (list 'RPOW-STAR dl 0) (list '* kk pg)) (list 'RPOW-STAR dl 0) 1)
                ;; q . m1 = h0
                (fact 'rr-recip-cancel-right h0 m1)
                (mhd-mul! q m1) (mhd-mul! m1 q) (mhd-mul! m1 pg) (mhd-mul! kk h0) (mhd-mul! kk pg)
                (mhd-mul! kk (list '* m1 pg)) (mhd-mul! m1 (list '* kk pg))
                (dk-have! (list '= (list '* m1 q) (list '* q m1)) (lambda () (crs)))
                (dk-have! (list '<= 0 m1) (lambda () (dk-ineq! (list '< 0 m1))))
                (dk-have! (list 'AND (list '<= 0 m1) (list '<= pg q)))
                (fact 'rr-le-scale-nonneg m1 pg q)
                (dk-have! (list '<= (list '* m1 pg) h0)
                  (lambda () (dk-ineq! (list '<= (list '* m1 pg) (list '* m1 q)) (list '= (list '* m1 q) (list '* q m1))
                                       (list '= h0 (list '* q m1)))))
                (dk-have! (list 'AND (list '<= 0 kk) (list '<= (list '* m1 pg) h0)))
                (fact 'rr-le-scale-nonneg kk (list '* m1 pg) h0)
                (dk-have! (list '= (list '* kk (list '* m1 pg)) (list '* m1 (list '* kk pg))) (lambda () (crs)))
                (dk-rewrite-h! (list '= (list '* kk (list '* m1 pg)) (list '* m1 (list '* kk pg))) (list '* kk pg) 1)
                (dk-have! '(< 0 0)
                  (lambda () (dk-ineq! (list '<= (list '* kk (list '* m1 pg)) (list '* kk h0))
                                       (list '= (list '* kk (list '* m1 pg)) (list '* m1 1))
                                       (list '<= (list '* kk h0) hm))))
                (fact 'rr-lt-irrefl 0)
                (mhd-clash! '(< 0 0))))))))))
(qed 'hausdorff-positive-infinite)

;;; 4.53, "in particular": at most one Hausdorff dimension
(define (mhd-dim-parts! l)
  (let ((h (list 'IS-HAUSDORFF-DIM 'm 'es l)))
    (dk-project! (list 'IN l 'RR) 'is-hausdorff-dim h)
    (dk-project! (list '<= 0 l) 'is-hausdorff-dim h)
    (dk-project! (list 'FORALL 'mhr_ (list 'IMPLIES '(IN mhr_ RR) (list 'IMPLIES (list '< l 'mhr_) '(= ((HAUSDORFF m mhr_) es) 0))))
                 'is-hausdorff-dim h)
    (dk-project! (list 'FORALL 'mhr_ (list 'IMPLIES '(IN mhr_ RR) (list 'IMPLIES '(< 0 mhr_) (list 'IMPLIES (list '< 'mhr_ l)
                   '(= ((HAUSDORFF m mhr_) es) POS-INF)))))
                 'is-hausdorff-dim h)))
(sp (make-wff (forall-guarded '(m es l1 l2) '((IS-HAUSDORFF-DIM m es l1) (IS-HAUSDORFF-DIM m es l2))
  '(NOT (< l1 l2)))))
(dk-peel!)
(di)
(mhd-dim-parts! 'l1) (mhd-dim-parts! 'l2)
(mhd-sub! 'l2 'l1)
(dk-have! '(< 0 (- l2 l1)) (lambda () (dk-ineq! '(< l1 l2))))
(fact 'rr-pos-rr-of-lt '(- l2 l1))
(let* ((h (dk-halve! '(- l2 l1)))
       (heq (mh2-pick 'heq (lambda (f) (and (dk-head-is? f '=) (dk-contains? f h)))))
       (r (list '+ 'l1 h)) (hr (list (list 'HAUSDORFF 'm r) 'es)))
  (dk-have! (list 'AND '(IN l1 RR) (list 'IN h 'RR))) (fact 'rr-add-closed 'l1 h)
  (dk-have! (list '< 'l1 r) (lambda () (dk-ineq! (list '< 0 h))))
  (dk-have! (list '< 0 r) (lambda () (dk-ineq! (list '< 0 h) '(<= 0 l1))))
  (dk-have! (list '< r 'l2) (lambda () (dk-ineq! (list '< 0 h) heq)))
  (inst+ (mh2-pick 'z (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'l1) (dk-contains? f 'HAUSDORFF) (not (dk-contains? f 'POS-INF))))) r)
  (inst+ (mh2-pick 'i (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'l2) (dk-contains? f 'POS-INF)))) r)
  (dk-have! '(IN 0 RR))
  (dk-have! '(IN POS-INF RR) (lambda () (subst (list '= 'POS-INF hr)) (subst (list '= hr 0)) (ass)))
  (fact 'pos-inf-not-in-rr)
  (mhd-clash! '(IN POS-INF RR)))
(qed 'hausdorff-dim-not-lt)

(sp (make-wff (forall-guarded '(m es l1 l2) '((IS-HAUSDORFF-DIM m es l1) (IS-HAUSDORFF-DIM m es l2))
  '(= l1 l2))))
(dk-peel!)
(mhd-dim-parts! 'l1) (mhd-dim-parts! 'l2)
(fact 'hausdorff-dim-not-lt 'm 'es 'l1 'l2)
(fact 'hausdorff-dim-not-lt 'm 'es 'l2 'l1)
(fact 'rr-lt-trichotomy 'l1 'l2)
(if (dk-only! '(OR (< l1 l2) (OR (= l1 l2) (< l2 l1))) '(NOT (< l1 l2)) '(NOT (< l2 l1))) (prop))
(qed 'hausdorff-dim-unique)

;;; PROPOSITION 4.54: X separable, every ball B(x, r) lambda-dimensional  ==>  X lambda-dimensional
(define (mhd-dimS-parts! S l)                  ; the four parts of IS-HAUSDORFF-DIM(m, S, l)
  (let ((h (list 'IS-HAUSDORFF-DIM 'm S l)))
    (dk-project! (list 'IN l 'RR) 'is-hausdorff-dim h)
    (dk-project! (list '<= 0 l) 'is-hausdorff-dim h)
    (dk-project! (list 'FORALL 'mhr_ (list 'IMPLIES '(IN mhr_ RR) (list 'IMPLIES (list '< l 'mhr_) (list '= (list '(HAUSDORFF m mhr_) S) 0))))
                 'is-hausdorff-dim h)
    (dk-project! (list 'FORALL 'mhr_ (list 'IMPLIES '(IN mhr_ RR) (list 'IMPLIES '(< 0 mhr_) (list 'IMPLIES (list '< 'mhr_ l)
                   (list '= (list '(HAUSDORFF m mhr_) S) 'POS-INF)))))
                 'is-hausdorff-dim h)))
(define (mhd-pow-close! S member!)             ; goal (IN S (POWER (PTS m))); member! closes z in PTS from z in S
  (mac 'power-set-membership)
  (for-each (lambda (leaf) (dk-focus! leaf)
              (if (dk-asm? (dk-goal)) (ass)
                  (let* ((pl (dk-peel!)) (z (cadr (car pl)))) (member! z))))
            (mh2-split-goal!)))
(define (mhd-ball-pow! c)
  (let ((B (list 'BALL 'm c 'r)))
    (if (not (dk-asm? (list 'IN B '(POWER (PTS m)))))
        (dk-have! (list 'IN B '(POWER (PTS m)))
          (lambda () (fact 'ball-is-set 'm c 'r)
                     (mhd-pow-close! B (lambda (z) (let ((iff (dk-cite! 'ball-membership 'm c 'r z)))
                                                     (if (dk-only! iff (list 'IN z B)) (prop))))))))))
(define (mhd-om-parts! rho)                    ; H^rho outer measure: returns (typing mono subadd)
  (let* ((hrho (list 'HAUSDORFF 'm rho)) (h (list 'IS-OUTER-MEASURE '(PTS m) hrho)))
    (fact 'hausdorff-metric-outer-measure 'm rho)
    (dk-project! h 'is-metric-outer-measure (list 'IS-METRIC-OUTER-MEASURE 'm hrho))
    (let* ((rhs (caddr (dk-cite! 'is-outer-measure '(PTS m) hrho)))
           (ty (cadr (caddr rhs))) (mono (cadr (caddr (caddr (caddr rhs))))) (sub (caddr (caddr (caddr (caddr rhs))))))
      (for-each (lambda (f) (dk-project! f 'is-outer-measure h)) (list ty mono sub))
      (list ty mono sub))))

(sp (make-wff (forall-guarded '(m r lam)
  '((IS-SEPARABLE m) (POS-RR r) (FORSOME mhx_ (IN mhx_ (PTS m)))
    (FORALL x (IMPLIES (IN x (PTS m)) (IS-HAUSDORFF-DIM m (BALL m x r) lam))))
  '(IS-HAUSDORFF-DIM m (PTS m) lam))))
(dk-peel!)
(let* ((rhs (caddr (dk-cite! 'is-separable 'm))))
  (dk-project! (cadr rhs) 'is-separable '(IS-SEPARABLE m))
  (dk-project! (caddr rhs) 'is-separable '(IS-SEPARABLE m))
  (let* ((dseq (dk-skolem! (caddr rhs) #t))
         (dense (mh2-pick 'dense (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f dseq) (dk-contains? f 'DIST)))))
         (x0 (dk-skolem! '(FORSOME mhx_ (IN mhx_ (PTS m))) #t))
         (hb (mh2-pick 'hb (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'BALL) (dk-contains? f 'IS-HAUSDORFF-DIM)))))
         (B0 (list 'BALL 'm x0 'r)))
    (inst+ hb x0)
    (mhd-dimS-parts! B0 'lam)
    (dk-pos-parts! 'r)
    (fact 'ms-pts-is-set 'm)
    (fact 'nn-is-set)
    (dk-have! '(IN (PTS m) (POWER (PTS m))) (lambda () (mhd-pow-close! '(PTS m) (lambda (z) (ass)))))
    (mhd-ball-pow! x0)
    (mac 'is-hausdorff-dim)
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (cond
        ((dk-asm? (dk-goal)) (ass))
        ((dk-contains? (dk-goal) 'POS-INF)
         ;; 0 < rho < lam: +inf = H(B(x0, r)) <= H(X)
         (let* ((pl (dk-peel!)) (rho (cadr (car (filter (lambda (z) (dk-head-is? z 'IN)) pl))))
                (hrho (list 'HAUSDORFF 'm rho)) (HX (list hrho '(PTS m))) (hball (list hrho B0)))
           (let* ((parts (mhd-om-parts! rho)))
             (inst+ (mh2-pick 'inf0 (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f B0) (dk-contains? f 'POS-INF)))) rho)
             (dk-have! (list 'SUBSET B0 '(PTS m))
               (lambda () (mac 'subset-def)
                 (let* ((pl2 (dk-peel!)) (z (cadr (car pl2))) (iff (dk-cite! 'ball-membership 'm x0 'r z)))
                   (if (dk-only! iff (list 'IN z B0)) (prop)))))
             (inst*! (cadr parts) B0 '(PTS m))
             (dk-rewrite-h! (list '<= hball HX) hball 'POS-INF)
             (fact 'fun-apply-type-c hrho '(POWER (PTS m)) 'RR-POS-STAR '(PTS m))
             (fact 'rr-pos-star-below-pos-inf HX)
             (fact 'pos-inf-in-rr-pos-star)
             (dk-have! (list 'AND (list 'IN HX 'RR-POS-STAR) '(IN POS-INF RR-POS-STAR)))
             (dk-have! (list 'AND (list '<= HX 'POS-INF) (list '<= 'POS-INF HX)))
             (fact 'rr-pos-star-le-antisymm HX 'POS-INF)
             (ass))))
        (#t
         ;; lam < rho: X is the union of the balls B(dseq n, r), each H^rho-null
         (let* ((pl (dk-peel!)) (rho (cadr (car (filter (lambda (z) (dk-head-is? z 'IN)) pl))))
                (hrho (list 'HAUSDORFF 'm rho)) (HX (list hrho '(PTS m)))
                (f (list 'VNB-LAMBDA 'mhn_ 'NN (list 'BALL 'm (list dseq 'mhn_) 'r))))
           (dk-have! (list '< 0 rho) (lambda () (dk-ineq! '(<= 0 lam) (list '< 'lam rho))))
           (let* ((parts (mhd-om-parts! rho)))
             (dk-have! (list 'IN f '(FUN NN (POWER (PTS m))))
               (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                                                     (fact 'fun-apply-type-c dseq 'NN '(PTS m) j)
                                                     (let ((lf (proof-state-focus *ps*)))
                                                       (mhd-ball-pow! (list dseq j))
                                                       (if (eq? lf (proof-state-focus *ps*)) (ass)))))
                                        (lambda () (ass)))))
             (inst+ (caddr parts) f)
             (let* ((sub (mh2-pick 'sub (lambda (z) (and (dk-head-is? z '<=) (dk-contains? z 'ESUM) (dk-contains? z dseq)))))
                    (bu (cadr (cadr sub))) (g (cadr (caddr sub))))
               (fact 'power-fun-union-closed '(PTS m) f)
               ;; X subset the union
               (dk-have! (list 'SUBSET '(PTS m) bu)
                 (lambda ()
                   (mac 'subset-def)
                   (let* ((pl2 (dk-peel!)) (x (cadr (car pl2))))
                     (inst*! dense x 'r)
                     (let* ((n (dk-skolem! (mh2-pick 'exn (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z x) (dk-contains? z dseq)))) #t))
                            (c (list dseq n)) (dxc (list '(DIST m) x c)) (dcx (list '(DIST m) c x)))
                       (fact 'fun-apply-type-c dseq 'NN '(PTS m) n)
                       (fact 'metric-sym 'm x c)
                       (fact 'metric-dist-real 'm c x)
                       (fact 'metric-dist-real 'm x c)
                       (fact 'rr-leq-reflexive dcx)
                       (dk-have! (list '< dcx 'r) (lambda () (dk-ineq! (list '< dxc 'r) (list '= dxc dcx))))
                       (dk-have! (mhh-and! (list 'IN x '(PTS m)) (list 'IN dcx 'RR) '(IN r RR) (list '<= dcx dcx) (list '< dcx 'r)))
                       (fact 'ball-mem-from-le 'm c x dcx 'r)
                       (for-each (lambda (leaf2) (dk-focus! leaf2)
                                   (if (dk-asm? (dk-goal)) (ass)
                                       (begin (dk-lam-b!) (if (not (sequent-node-grounded? leaf2)) (begin (dk-focus! leaf2) (ass))))))
                                 (dk-opened (lambda () (bu-mi n))))))))
               (inst*! (cadr parts) '(PTS m) bu)
               ;; every term of the sum is 0
               (dk-have! (list 'IN g '(FUN NN RR-POS-STAR))
                 (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!)))
                                                       (fact 'fun-apply-type-c f 'NN '(POWER (PTS m)) j)
                                                       (fact 'fun-apply-type-c hrho '(POWER (PTS m)) 'RR-POS-STAR (list f j))
                                                       (ass)))
                                          (lambda () (ass)))))
               (dk-have! (list 'FORALL 'ozn (list 'IMPLIES '(IN ozn NN) (list '= (list g 'ozn) 0)))
                 (lambda ()
                   (let* ((j (dk-di-var!)) (Bj (list 'BALL 'm (list dseq j) 'r)))
                     (fact 'fun-apply-type-c dseq 'NN '(PTS m) j)
                     (dk-lam-b!)
                     (inst+ hb (list dseq j))
                     (mhd-dimS-parts! Bj 'lam)
                     (inst+ (mh2-pick 'zj (lambda (z) (and (dk-head-is? z 'FORALL) (dk-contains? z Bj) (not (dk-contains? z 'POS-INF))))) rho)
                     (ass))))
               (fact 'esum-nn-zero g)
               (dk-rewrite-h! sub (list 'ESUM g) 0)
               (fact 'fun-apply-type-c hrho '(POWER (PTS m)) 'RR-POS-STAR '(PTS m))
               (fact 'fun-apply-type-c hrho '(POWER (PTS m)) 'RR-POS-STAR bu)
               (dk-have! '(IN 0 RR)) (dk-have! '(<= 0 0) (lambda () (dk-ineq!))) (mhh-rps! 0)
               (mhh-le-trans! HX (list hrho bu) 0)
               (fact 'rr-pos-star-nonneg HX)
               (dk-have! (list 'AND (list 'IN HX 'RR-POS-STAR) '(IN 0 RR-POS-STAR)))
               (dk-have! (list 'AND (list '<= HX 0) (list '<= 0 HX)))
               (fact 'rr-pos-star-le-antisymm HX 0)
               (ass)))))))
     (mh2-split-goal!))))
