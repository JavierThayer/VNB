;;; ba-inverse.scm -- BANACH ALGEBRAS: the bound (2) of Proposition 1.3 and the continuity of
;;; inversion.  F. J. Thayer, "Banach Algebras and Applications", ch. 1 introduction.
;;; Agent BA-1B, wave 2026-11-09.  Destination: theorem-library/ba-inverse.scm.
;;; Library: operator-algebras.  All proofs modulo 0.
;;;
;;; THE ROUTE TO (2) IS ALGEBRAIC, not a passage to the limit: u = (1 - x)^(-1) satisfies
;;; u = 1 + x u, hence ||u|| <= 1 + ||x|| ||u||, i.e. ||u|| <= 1 / (1 - ||x||); and
;;; u = 1 + x + x (x u), so ||u - (1 + x)|| <= ||x||^2 ||u|| <= ||x||^2 / (1 - ||x||).
;;; (The general lemma BA-1 asked for, metric-limit-dist-le, is in ba-metric-lemmas.scm.)
;;;
;;; LOAD WINDOW: after theorem-library/ba-neumann (neumann-series, ban-one-minus-left,
;;; ban-sub-sub, ban-dist-sym, ban-neg-norm, ban-inverse-norm-pos, invertible-near-invertible)
;;; and ba-spectrum (no citation).  Real arithmetic: rr-mul-le-right, rr-mul-le-cancel-pos,
;;; rr-recip-inverse, rr-recip-closed, rr-sq-nonneg, rr-min-*, all early.
;;; Helper prefix: bbi-.

(define (bbi-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (if (and (not (sequent-node-grounded? l))
                           (let ((g (dk-goal-of l))) (and (pair? g) (eq? (car g) '=) (equal? (cadr g) (caddr g)))))
                      (begin (dk-focus! l) (rfl))))
                (dk-open-leaves)))
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba-inverse: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba-inverse: unfinished" name))))

(define (bbi-st body) (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a) body))))
(define (bbi-m x y) (list '(VMUL a) x y))
(define (bbi-ad x y) (list '(VADD a) x y))
(define (bbi-ng x) (list '(VNEG a) x))
(define (bbi-sb x y) (bbi-ad x (bbi-ng y)))
(define (bbi-nr x) (list '(VNRM a) x))
(define bbi-one '(VONE a))
(define bbi-zero '(VZERO a))
(define bbi-om (bbi-sb bbi-one 'x))             ; 1 - x
(define bbi-u (list 'INVERSE-EL 'a bbi-om))     ; (1 - x)^-1
(define (bbi-rw! from to) (subst (list '= from to)))
(define (bbi-dump! tag)
  (display "\n;; BBI DUMP ") (display tag) (newline)
  (for-each (lambda (l) (display ";;   LEAF: ") (display (expression->string (dk-goal-of l))) (newline)
              (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline))
                        (dk-asms-of l)))
            (dk-open-leaves)))
(define (bbi-cite2! . args)
  (let ((r (apply dk-cite! args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (detach-with! r (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
        r)))

;;; type an algebra expression in (VEC a), bottom-up, by citation
(define (bbi-vt x)
  (let ((want (list 'IN x '(VEC a))))
    (cond ((dk-asm? want) x)
          ((equal? x bbi-one) (dk-cite! 'ring-one-in-uba-as-ring 'a) x)
          ((equal? x bbi-zero) (dk-cite! 'ring-zero-in-uba-as-ring 'a) x)
          ((and (pair? x) (equal? (car x) '(VADD a)))
           (bbi-vt (cadr x)) (bbi-vt (caddr x))
           (dk-cite! 'ring-add-closed-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VMUL a)))
           (bbi-vt (cadr x)) (bbi-vt (caddr x))
           (dk-cite! 'ring-carrier-closed-mul-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG a)))
           (bbi-vt (cadr x))
           (dk-cite! 'ring-neg-in-carr-uba-as-ring 'a (cadr x)) x)
          ((and (pair? x) (eq? (car x) 'INVERSE-EL))
           (dk-cite! 'bae-inverse-in 'a (caddr x)) x)
          (#t (error "bbi-vt: cannot type" (expression->string x))))))

;;; type a real term built from norms, products, sums, negation
(define (bbi-rr! t)
  (cond ((dk-asm? (list 'IN t 'RR)) t)
        ((number? t) (dk-real! t) t)
        ((and (pair? t) (memq (car t) '(* +)) (= (length t) 3))
         (bbi-rr! (cadr t)) (bbi-rr! (caddr t))
         (dk-real! t) t)
        ((and (pair? t) (eq? (car t) '-))
         (for-each bbi-rr! (cdr t)) (dk-real! t) t)
        ((and (pair? t) (equal? (car t) '(VNRM a)))
         (bbi-vt (cadr t)) (dk-cite! 'bae-vnrm-type 'a (cadr t)) t)
        (#t (error "bbi-rr!: cannot type" (expression->string t)))))

;;; a goal (= t t) closes by rfl; otherwise ass
(define (bbi-close!)
  (let ((g (dk-goal)))
    (if (and (pair? g) (memq (car g) '(= ==)) (equal? (cadr g) (caddr g)))
        (rfl)
        (dk-ass!))))

;;; ---- u = (1 - x)^(-1) satisfies u = 1 + x u ---------------------------------------------------
(sp (bbi-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'IMPLIES (list 'IS-INVERTIBLE-EL 'a bbi-om)
  (list '= bbi-u (bbi-ad bbi-one (bbi-m 'x bbi-u))))))))
(dk-peel!)
(bbi-vt bbi-om)
(bbi-vt bbi-u)
(let* ((v (dk-name! bbi-u '(VEC a)))
       (xv (bbi-m 'x v)))
  (dk-cite! 'bae-inverse-right 'a bbi-om)
  (let* ((e1 (dk-rewrite-h! (list '= (bbi-m bbi-om bbi-u) bbi-one) bbi-u v)))
    (bbi-vt xv)
    (dk-cite! 'ban-one-minus-left 'a 'x v)
    (dk-rewrite-h! e1 (bbi-m bbi-om v) (bbi-sb v xv))
    (bbi-rw! bbi-u v)
    (bbi-rw! bbi-one (bbi-sb v xv))
    (bbi-vt (bbi-ng xv))
    (dk-cite! 'ring-add-assoc-uba-as-ring 'a v (bbi-ng xv) xv)
    (bbi-rw! (bbi-ad (bbi-sb v xv) xv) (bbi-ad v (bbi-ad (bbi-ng xv) xv)))
    (dk-cite! 'ring-add-left-inv-uba-as-ring 'a xv)
    (bbi-rw! (bbi-ad (bbi-ng xv) xv) bbi-zero)
    (dk-cite! 'ring-add-right-id-uba-as-ring 'a v)
    (bbi-rw! (bbi-ad v bbi-zero) v)
    (bbi-close!)))
(bbi-qed! 'bbi-inverse-fix)

;;; ---- v = 1 + x v implies v - (1 + x) = x (x v) ----------------------------------------------
(sp (bbi-st '(FORALL x (IMPLIES (IN x (VEC a)) (FORALL v (IMPLIES (IN v (VEC a))
  (IMPLIES (= v ((VADD a) (VONE a) ((VMUL a) x v)))
    (= ((VADD a) v ((VNEG a) ((VADD a) (VONE a) x))) ((VMUL a) x ((VMUL a) x v))))))))))
(dk-peel!)
(let* ((xv (bbi-vt (bbi-m 'x 'v)))
       (p (dk-name! xv '(VEC a)))
       (xp (bbi-vt (bbi-m 'x p)))
       (fix0 (list '= 'v (bbi-ad bbi-one xv)))
       (fix (dk-rewrite-h! fix0 xv p))                              ; v = 1 + p
       (pe0 (dk-rewrite-h! (list '= p xv) 'v (bbi-ad bbi-one p))))  ; p = x (1 + p)
  (bbi-vt bbi-one)
  (dk-cite! 'ring-left-dist-uba-as-ring 'a 'x bbi-one p)
  (dk-cite! 'ring-mul-right-id-uba-as-ring 'a 'x)
  (let* ((pe1 (dk-rewrite-h! pe0 (bbi-m 'x (bbi-ad bbi-one p)) (bbi-ad (bbi-m 'x bbi-one) xp)))
         (pe2 (dk-rewrite-h! pe1 (bbi-m 'x bbi-one) 'x))            ; p = x + x p
         (ce (dk-congr! pe2 (lambda (t) (bbi-ad bbi-one t))))       ; 1 + p = 1 + (x + x p)
         (opx (bbi-vt (bbi-ad bbi-one 'x))))
    (bbi-vt (bbi-ad 'x xp))
    (dk-cite! 'ring-add-assoc-uba-as-ring 'a bbi-one 'x xp)
    (bbi-rw! xv p)
    (bbi-rw! 'v (bbi-ad bbi-one p))
    (bbi-rw! (bbi-ad bbi-one p) (bbi-ad bbi-one (bbi-ad 'x xp)))
    (bbi-rw! (bbi-ad bbi-one (bbi-ad 'x xp)) (bbi-ad opx xp))
    (dk-cite! 'ring-add-comm-uba-as-ring 'a opx xp)
    (bbi-rw! (bbi-ad opx xp) (bbi-ad xp opx))
    (dk-cite! 'fom-v-shift-back-uba-as-module 'a xp opx)
    (bbi-close!)))
(bbi-qed! 'bbi-fix-expand)

;;; ---- the norm of (1 - x)^(-1):  ||(1 - x)^(-1)|| <= 1 / (1 - ||x||) ----------------------------
;;; (bbi-norm-setup!) -- context: x in VEC a, ||x|| < 1.  Lands the invertibility of 1 - x, names
;;; v = (1 - x)^(-1), and lands v = 1 + x v.  Returns v.
(define (bbi-norm-setup!)
  (bbi-vt bbi-om)
  (dk-project! (list 'IS-INVERTIBLE-EL 'a bbi-om) (lambda () (dk-cite! 'neumann-series 'a 'x)))
  (bbi-vt bbi-u)
  (dk-cite! 'bbi-inverse-fix 'a 'x)
  (let ((v (dk-name! bbi-u '(VEC a))))
    (dk-rewrite-h! (list '= bbi-u (bbi-ad bbi-one (bbi-m 'x bbi-u))) bbi-u v)
    v))

;;; (bbi-k-w! r) -- r = ||x|| < 1 typed: name k = 1 - r and w = recip(k); land k = 1 + -r, 0 < k,
;;; k /= 0, k w = 1.  Returns (k w).
(define (bbi-k-w! r)
  (bbi-rr! (list '- 1 r))
  (let* ((k (dk-name! (list '- 1 r)))
         (kr (list '+ 1 (list '- r))))
    (dk-have! (list '= k kr)
      (lambda () (bbi-rw! k (list '- 1 r)) (mac 'binary-minus-def) (bbi-close!)))
    (dk-have! (list '< 0 k) (lambda () (dk-ineq! (list '= k kr) (list '< r 1))))
    (dk-have! (list 'NOT (list '= k 0)) (lambda () (di) (dk-absurd! (dk-rewrite-h! (list '< 0 k) k 0))))
    (bbi-cite2! 'rr-recip-closed k)
    (let ((w (dk-name! (list 'recip k))))
      (let ((ri (bbi-cite2! 'rr-recip-inverse k)))
        (dk-rewrite-h! ri (list 'recip k) w))
      (list k w))))

(sp (bbi-st '(FORALL x (IMPLIES (IN x (VEC a)) (IMPLIES (< ((VNRM a) x) 1)
  (<= ((VNRM a) (INVERSE-EL a ((VADD a) (VONE a) ((VNEG a) x)))) (recip (- 1 ((VNRM a) x)))))))))
(dk-peel!)
(let* ((v (bbi-norm-setup!))
       (r (bbi-rr! (bbi-nr 'x)))
       (uu (bbi-rr! (bbi-nr v)))
       (xv (bbi-vt (bbi-m 'x v)))
       (q (bbi-rr! (bbi-nr xv)))
       (ru (bbi-rr! (list '* r uu))))
  (bbi-rr! (bbi-nr bbi-one))
  (dk-cite! 'bal-uba-vnrm-nonneg 'a 'x)
  (dk-cite! 'bal-uba-vnrm-nonneg 'a v)
  (let ((tri (dk-cite! 'bal-uba-vnrm-triangle 'a bbi-one xv)))
    (dk-rewrite-h! tri (bbi-ad bbi-one xv) v))
  (dk-cite! 'bal-uba-vone-norm 'a)
  (dk-cite! 'bal-uba-vnrm-submult 'a 'x v)
  (let* ((le1 (list '<= uu (list '+ 1 ru))))
    (dk-have! le1 (lambda () (dk-ineq! (list '<= uu (list '+ (bbi-nr bbi-one) q)) (list '= (bbi-nr bbi-one) 1)
                                       (list '<= q ru))))
    (let* ((kw (bbi-k-w! r)) (k (car kw)) (kr (list '+ 1 (list '- r))))
      (let* ((w (cadr kw))
             (uk (bbi-rr! (list '* uu k)))
             (wk (bbi-rr! (list '* w k))))
        (dk-have! (list '= wk 1)
          (lambda () (dk-have! (list '= wk (list '* k w)) (lambda () (crs)))
                     (bbi-rw! wk (list '* k w)) (dk-ass!)))
        (dk-have! (list '= uk (list '+ uu (list '- ru)))
          (lambda () (bbi-rw! k kr) (crs)))
        (dk-have! (list '<= uk wk)
          (lambda () (dk-ineq! (list '= uk (list '+ uu (list '- ru))) le1 (list '= wk 1))))
        (dk-cite! 'rr-mul-le-cancel-pos uu k w)
        (bbi-rw! bbi-u v)
        (bbi-rw! (list '- 1 r) k)
        (bbi-rw! (list 'recip k) w)
        (dk-ass!)))))
(bbi-qed! 'neumann-inverse-norm-bound)

;;; ---- Proposition 1.3 (2):  ||(1 - x)^(-1) - (1 + x)|| <= ||x||^2 / (1 - ||x||) -----------------
(sp (bbi-st '(FORALL x (IMPLIES (IN x (VEC a)) (IMPLIES (< ((VNRM a) x) 1)
  (<= ((VNRM a) ((VADD a) (INVERSE-EL a ((VADD a) (VONE a) ((VNEG a) x))) ((VNEG a) ((VADD a) (VONE a) x))))
      (* (* ((VNRM a) x) ((VNRM a) x)) (recip (- 1 ((VNRM a) x))))))))))
(dk-peel!)
(let* ((r (bbi-rr! (bbi-nr 'x)))
       (bnd (dk-cite! 'neumann-inverse-norm-bound 'a 'x))
       (v (bbi-norm-setup!))
       (uu (bbi-rr! (bbi-nr v)))
       (xv (bbi-vt (bbi-m 'x v)))
       (xxv (bbi-vt (bbi-m 'x xv)))
       (q (bbi-rr! (bbi-nr xv)))
       (nn0 (bbi-rr! (bbi-nr xxv)))
       (rr2 (bbi-rr! (list '* r r))))
  (let* ((kw (bbi-k-w! r)) (k (car kw)))
    (let* ((w (cadr kw))
           (b1 (dk-rewrite-h! bnd bbi-u v))
           (b2 (dk-rewrite-h! b1 (list '- 1 r) k))
           (b3 (dk-rewrite-h! b2 (list 'recip k) w)))          ; ||v|| <= w
      (dk-cite! 'bal-uba-vnrm-nonneg 'a 'x)
      (dk-cite! 'bbi-fix-expand 'a 'x v)
      (bbi-rw! bbi-u v)
      (bbi-rw! (bbi-sb v (bbi-ad bbi-one 'x)) xxv)
      (bbi-rw! (list '- 1 r) k)
      (bbi-rw! (list 'recip k) w)
      (dk-cite! 'bal-uba-vnrm-submult 'a 'x xv)                ; ||x(xv)|| <= r q
      (dk-cite! 'bal-uba-vnrm-submult 'a 'x v)                 ; q <= r ||v||
      (let* ((ru (bbi-rr! (list '* r uu)))
             (rq (bbi-rr! (list '* r q)))
             (qr (bbi-rr! (list '* q r)))
             (rur (bbi-rr! (list '* ru r)))
             (urr (bbi-rr! (list '* uu rr2)))
             (wrr (bbi-rr! (list '* w rr2)))
             (rrw (bbi-rr! (list '* rr2 w))))
        (dk-have! (list '= rq qr) (lambda () (crs)))
        (dk-cite! 'rr-mul-le-right q ru r)
        (dk-have! (list '= rur urr) (lambda () (crs)))
        (dk-cite! 'rr-sq-nonneg r)
        (dk-cite! 'rr-mul-le-right uu w rr2)
        (dk-have! (list '= wrr rrw) (lambda () (crs)))
        (dk-le-chain! nn0 rq qr rur urr wrr rrw)))))
(bbi-qed! 'neumann-series-bound)

;;; ==== CONTINUITY OF INVERSION ==================================================================
(define bbi-bi '(INVERSE-EL a b))
(define bbi-vi '(INVERSE-EL a v))
(define (bbi-pos-rr! t)            ; with (< 0 t) and (IN t RR) in context, prove the goal (POS-RR t)
  (mac 'pos-rr)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-ass!) #t)
            ((dk-head-is? (dk-goal) 'NOT)
             (di) (dk-absurd! (dk-rewrite-h! (list '< 0 t) t 0)))
            (#t (dk-ineq! (list '< 0 t)))))))

;;; b^-1 - v^-1 = v^-1 ((v - b) b^-1)
(sp (bbi-st '(FORALL b (IMPLIES (IS-INVERTIBLE-EL a b) (FORALL v (IMPLIES (IS-INVERTIBLE-EL a v)
  (= ((VADD a) (INVERSE-EL a b) ((VNEG a) (INVERSE-EL a v)))
     ((VMUL a) (INVERSE-EL a v) ((VMUL a) ((VADD a) v ((VNEG a) b)) (INVERSE-EL a b))))))))))
(dk-peel!)
(dk-project! '(IN b (VEC a)) 'IS-INVERTIBLE-EL '(IS-INVERTIBLE-EL a b))
(dk-project! '(IN v (VEC a)) 'IS-INVERTIBLE-EL '(IS-INVERTIBLE-EL a v))
(let* ((bi (bbi-vt bbi-bi)) (vi (bbi-vt bbi-vi))
       (vbi (bbi-vt (bbi-m 'v bi))))
  (bbi-vt bbi-one)
  (dk-cite! 'ban-mul-sub-right 'a bi 'v 'b)
  (bbi-rw! (bbi-m (bbi-sb 'v 'b) bi) (bbi-sb vbi (bbi-m 'b bi)))
  (dk-cite! 'bae-inverse-right 'a 'b)
  (bbi-rw! (bbi-m 'b bi) bbi-one)
  (dk-cite! 'ban-mul-sub-left 'a vi vbi bbi-one)
  (bbi-rw! (bbi-m vi (bbi-sb vbi bbi-one)) (bbi-sb (bbi-m vi vbi) (bbi-m vi bbi-one)))
  (dk-cite! 'ring-mul-right-id-uba-as-ring 'a vi)
  (bbi-rw! (bbi-m vi bbi-one) vi)
  (dk-cite! 'ring-mul-assoc-uba-as-ring 'a vi 'v bi)
  (bbi-rw! (bbi-m vi vbi) (bbi-m (bbi-m vi 'v) bi))
  (dk-cite! 'bae-inverse-left 'a 'v)
  (bbi-rw! (bbi-m vi 'v) bbi-one)
  (dk-cite! 'ring-mul-left-id-uba-as-ring 'a bi)
  (bbi-rw! (bbi-m bbi-one bi) bi)
  (bbi-vt (bbi-sb bi vi))
  (bbi-close!))
(bbi-qed! 'bbi-inverse-diff)

;;; ||b^-1 - v^-1|| <= (||b - v|| ||b^-1||) ||v^-1||
(sp (bbi-st '(FORALL b (IMPLIES (IS-INVERTIBLE-EL a b) (FORALL v (IMPLIES (IS-INVERTIBLE-EL a v)
  (<= ((VNRM a) ((VADD a) (INVERSE-EL a b) ((VNEG a) (INVERSE-EL a v))))
      (* (* ((VNRM a) ((VADD a) b ((VNEG a) v))) ((VNRM a) (INVERSE-EL a b))) ((VNRM a) (INVERSE-EL a v))))))))))
(dk-peel!)
(dk-project! '(IN b (VEC a)) 'IS-INVERTIBLE-EL '(IS-INVERTIBLE-EL a b))
(dk-project! '(IN v (VEC a)) 'IS-INVERTIBLE-EL '(IS-INVERTIBLE-EL a v))
(let* ((bi (bbi-vt bbi-bi)) (vi (bbi-vt bbi-vi))
       (vb (bbi-vt (bbi-sb 'v 'b)))
       (y (bbi-vt (bbi-m vb bi)))
       (c (bbi-rr! (bbi-nr bi))) (ww (bbi-rr! (bbi-nr vi)))
       (d (bbi-rr! (bbi-nr (bbi-sb 'b 'v))))
       (ny (bbi-rr! (bbi-nr y)))
       (nn0 (bbi-rr! (bbi-nr (bbi-m vi y))))
       (dc (bbi-rr! (list '* d c))))
  (bbi-rr! (bbi-nr vb))
  (dk-cite! 'bbi-inverse-diff 'a 'b 'v)
  (bbi-rw! (bbi-sb bi vi) (bbi-m vi y))
  (dk-cite! 'bal-uba-vnrm-submult 'a vi y)
  (let ((sm (dk-cite! 'bal-uba-vnrm-submult 'a vb bi)))
    (dk-cite! 'ban-dist-sym 'a 'v 'b)
    (dk-rewrite-h! sm (bbi-nr vb) d))
  (dk-cite! 'bal-uba-vnrm-nonneg 'a vi)
  (dk-cite! 'rr-mul-le-right ny dc ww)
  (let* ((wny (bbi-rr! (list '* ww ny))) (nyw (bbi-rr! (list '* ny ww))) (dcw (bbi-rr! (list '* dc ww))))
    (dk-have! (list '= wny nyw) (lambda () (crs)))
    (dk-le-chain! nn0 wny nyw dcw)))
(bbi-qed! 'inverse-diff-norm)

;;; ||b - v|| ||b^-1|| <= 1/2 implies v invertible and ||v^-1|| <= 2 ||b^-1||
(sp (bbi-st '(FORALL b (IMPLIES (IS-INVERTIBLE-EL a b) (FORALL v (IMPLIES (IN v (VEC a))
  (IMPLIES (<= (* ((VNRM a) ((VADD a) b ((VNEG a) v))) ((VNRM a) (INVERSE-EL a b))) 1/2)
    (AND (IS-INVERTIBLE-EL a v) (<= ((VNRM a) (INVERSE-EL a v)) (* 2 ((VNRM a) (INVERSE-EL a b))))))))))))
(dk-peel!)
(dk-project! '(IN b (VEC a)) 'IS-INVERTIBLE-EL '(IS-INVERTIBLE-EL a b))
(let* ((bi (bbi-vt bbi-bi))
       (c (bbi-rr! (bbi-nr bi)))
       (bv (bbi-vt (bbi-sb 'b 'v)))
       (d (bbi-rr! (bbi-nr bv)))
       (dc (bbi-rr! (list '* d c))))
  (dk-cite! 'ban-inverse-norm-pos 'a 'b)
  (dk-have! (list 'NOT (list '= c 0)) (lambda () (di) (dk-absurd! (dk-rewrite-h! (list '< 0 c) c 0))))
  (bbi-cite2! 'rr-recip-closed c)
  (dk-cite! 'rr-recip-pos c)
  (let* ((ci (dk-name! (list 'recip c)))
         (ri (bbi-cite2! 'rr-recip-inverse c))
         (cc1 (dk-rewrite-h! ri (list 'recip c) ci))                 ; c ci = 1
         (pci (dk-rewrite-h! (list '< 0 (list 'recip c)) (list 'recip c) ci)))
    (dk-have! (list '< dc 1) (lambda () (dk-ineq! (list '<= dc 1/2))))
    (bbi-rr! (list '* ci dc)) (bbi-rr! (list '* ci 1))
    (dk-have! (list 'AND (list '< 0 ci) (list '< dc 1)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (let ((sc (dk-cite! 'rr-lt-scale-pos ci dc 1)))
      (dk-have! (list '= (list '* ci dc) d)
        (lambda ()
          (dk-have! (list '= (list '* ci dc) (list '* d (list '* c ci))) (lambda () (crs)))
          (bbi-rw! (list '* ci dc) (list '* d (list '* c ci)))
          (bbi-rw! (list '* c ci) 1)
          (crs)))
      (dk-have! (list '= (list '* ci 1) ci) (lambda () (crs)))
      (let* ((s1 (dk-rewrite-h! sc (list '* ci dc) d))
             (s2 (dk-rewrite-h! s1 (list '* ci 1) ci))
             (s3 (dk-rewrite-h! s2 ci (list 'recip c))))
        (dk-cite! 'invertible-near-invertible 'a 'b 'v)
        (let* ((vi (bbi-vt bbi-vi))
               (ww (bbi-rr! (bbi-nr vi)))
               (e (bbi-rr! (bbi-nr (bbi-sb bi vi))))
               (l2 (dk-cite! 'inverse-diff-norm 'a 'b 'v))
               (k (dk-name! dc))
               (l2k (dk-rewrite-h! l2 dc k))
               (kh (dk-rewrite-h! (list '<= dc 1/2) dc k)))
          (dk-cite! 'bal-uba-vnrm-nonneg 'a vi)
          (bbi-rr! (list '* k ww)) (bbi-rr! (list '* 1/2 ww))
          (dk-cite! 'rr-mul-le-right k 1/2 ww)
          (dk-cite! 'ban-sub-sub 'a bi vi)
          (bbi-vt (bbi-ng (bbi-sb bi vi)))
          (let ((tri (dk-cite! 'bal-uba-vnrm-triangle 'a bi (bbi-ng (bbi-sb bi vi)))))
            (dk-rewrite-h! tri (bbi-sb bi (bbi-sb bi vi)) vi))
          (dk-cite! 'ban-neg-norm 'a (bbi-sb bi vi))
          (bbi-rr! (bbi-nr (bbi-ng (bbi-sb bi vi))))
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (dk-ineq! (list '<= ww (list '+ c (bbi-nr (bbi-ng (bbi-sb bi vi)))))
                            (list '= (bbi-nr (bbi-ng (bbi-sb bi vi))) e)
                            l2k
                            (list '<= (list '* k ww) (list '* 1/2 ww)))))))))))
(bbi-qed! 'inverse-near-bound)

;;; ||b - v|| ||b^-1|| <= 1/2 implies ||b^-1 - v^-1|| <= ||b - v|| (2 ||b^-1||^2)
(sp (bbi-st '(FORALL b (IMPLIES (IS-INVERTIBLE-EL a b) (FORALL v (IMPLIES (IN v (VEC a))
  (IMPLIES (<= (* ((VNRM a) ((VADD a) b ((VNEG a) v))) ((VNRM a) (INVERSE-EL a b))) 1/2)
    (<= ((VNRM a) ((VADD a) (INVERSE-EL a b) ((VNEG a) (INVERSE-EL a v))))
        (* ((VNRM a) ((VADD a) b ((VNEG a) v))) (* 2 (* ((VNRM a) (INVERSE-EL a b)) ((VNRM a) (INVERSE-EL a b)))))))))))))
(dk-peel!)
(dk-project! '(IN b (VEC a)) 'IS-INVERTIBLE-EL '(IS-INVERTIBLE-EL a b))
(let* ((bi (bbi-vt bbi-bi))
       (c (bbi-rr! (bbi-nr bi)))
       (bv (bbi-vt (bbi-sb 'b 'v)))
       (d (bbi-rr! (bbi-nr bv)))
       (dc (bbi-rr! (list '* d c))))
  (let ((nb (dk-cite! 'inverse-near-bound 'a 'b 'v)))
    (dk-split-all! (list nb)))
  (let* ((vi (bbi-vt bbi-vi))
         (ww (bbi-rr! (bbi-nr vi)))
         (e (bbi-rr! (bbi-nr (bbi-sb bi vi))))
         (c2 (bbi-rr! (list '* 2 c)))
         (dcw (bbi-rr! (list '* dc ww)))
         (wdc (bbi-rr! (list '* ww dc)))
         (cdc (bbi-rr! (list '* c2 dc)))
         (fin (bbi-rr! (list '* d (list '* 2 (list '* c c))))))
    (dk-cite! 'inverse-diff-norm 'a 'b 'v)
    (dk-cite! 'bal-uba-vnrm-nonneg 'a bv)
    (dk-cite! 'bal-uba-vnrm-nonneg 'a bi)
    (dk-cite! 'cvx-mul-nonneg d c)
    (dk-cite! 'rr-mul-le-right ww c2 dc)
    (dk-have! (list '= dcw wdc) (lambda () (crs)))
    (dk-have! (list '= cdc fin) (lambda () (crs)))
    (dk-le-chain! e dcw wdc cdc fin)))
(bbi-qed! 'inverse-lipschitz)

;;; INVERSION IS CONTINUOUS: for b invertible and eps > 0 there is del > 0 such that every v with
;;; ||b - v|| <= del is invertible and ||b^-1 - v^-1|| <= eps
(sp (bbi-st '(FORALL b (IMPLIES (IS-INVERTIBLE-EL a b) (FORALL eps (IMPLIES (POS-RR eps)
  (FORSOME del (AND (POS-RR del) (FORALL v (IMPLIES (IN v (VEC a))
    (IMPLIES (<= ((VNRM a) ((VADD a) b ((VNEG a) v))) del)
      (AND (IS-INVERTIBLE-EL a v)
           (<= ((VNRM a) ((VADD a) (INVERSE-EL a b) ((VNEG a) (INVERSE-EL a v)))) eps)))))))))))))
(dk-peel!)
(dk-project! '(IN b (VEC a)) 'IS-INVERTIBLE-EL '(IS-INVERTIBLE-EL a b))
(dk-cite! 'rr-pos-rr-in-rr 'eps)
(dk-cite! 'rr-lt-of-pos-rr 'eps)
(let* ((bi (bbi-vt bbi-bi))
       (c (bbi-rr! (bbi-nr bi)))
       (hh (bbi-rr! (list '* 2 c)))
       (kk (bbi-rr! (list '* 2 (list '* c c)))))
  (dk-cite! 'ban-inverse-norm-pos 'a 'b)
  (dk-have! (list '< 0 hh) (lambda () (dk-ineq! (list '< 0 c))))
  (bbi-rr! (list '* c c))
  (dk-real! 0)
  (dk-have! (list '< 0 (list '* c c))
    (lambda () (bbi-cite2! 'rr-lt-scale-pos c 0 c)
               (dk-have! (list '= (list '* c 0) 0) (lambda () (crs)))
               (dk-ineq! (list '< (list '* c 0) (list '* c c)) (list '= (list '* c 0) 0))))
  (dk-have! (list '< 0 kk) (lambda () (dk-ineq! (list '< 0 (list '* c c)))))
  (dk-have! (list 'NOT (list '= hh 0)) (lambda () (di) (dk-absurd! (dk-rewrite-h! (list '< 0 hh) hh 0))))
  (dk-have! (list 'NOT (list '= kk 0)) (lambda () (di) (dk-absurd! (dk-rewrite-h! (list '< 0 kk) kk 0))))
  (bbi-cite2! 'rr-recip-closed hh) (bbi-cite2! 'rr-recip-closed kk)
  (dk-cite! 'rr-recip-pos hh) (dk-cite! 'rr-recip-pos kk)
  (let* ((h (dk-name! (list 'recip hh)))
         (rih (dk-rewrite-h! (bbi-cite2! 'rr-recip-inverse hh) (list 'recip hh) h))     ; hh h = 1
         (ph (dk-rewrite-h! (list '< 0 (list 'recip hh)) (list 'recip hh) h))
         (ek (bbi-rr! (list '* 'eps (list 'recip kk))))
         (e (dk-name! ek))
         (cr (dk-cite! 'rr-recip-cancel-right 'eps kk))                                  ; eps = (eps recip kk) kk
         (cre (dk-rewrite-h! cr ek e)))
    (bbi-cite2! 'rr-lt-scale-pos 'eps 0 (list 'recip kk))
    (dk-have! (list '< 0 e)
      (lambda () (dk-have! (list '= (list '* 'eps 0) 0) (lambda () (crs)))
                 (dk-ineq! (list '< (list '* 'eps 0) ek) (list '= (list '* 'eps 0) 0) (list '= e ek))))
    (dk-cite! 'rr-min-closed h e)
    (let* ((dl (list 'min h e)))
      (dk-cite! 'rr-lt-min 0 h e)
      (dk-cite! 'rr-min-le-left h e)
      (dk-cite! 'rr-min-le-right h e)
      (ew dl)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-head-is? g 'POS-RR) (bbi-pos-rr! dl))
                  (#t
                   (let* ((v (dk-di-var!))
                          (bv (bbi-vt (bbi-sb 'b v)))
                          (d (bbi-rr! (bbi-nr bv)))
                          (le (car (dk-peel!)))
                          (dh (list '* d hh)) (hh1 (list '* h hh))
                          (dc (bbi-rr! (list '* d c))))
                     (dk-cite! 'bal-uba-vnrm-nonneg 'a bv)
                     (dk-cite! 'bal-uba-vnrm-nonneg 'a bi)
                     (bbi-rr! dh) (bbi-rr! hh1)
                     (dk-have! (list '<= d h) (lambda () (dk-ineq! le (list '<= dl h))))
                     (dk-have! (list '<= d e) (lambda () (dk-ineq! le (list '<= dl e))))
                     (dk-have! (list '<= 0 hh) (lambda () (dk-ineq! (list '< 0 hh))))
                     (dk-have! (list '<= 0 kk) (lambda () (dk-ineq! (list '< 0 kk))))
                     (dk-cite! 'rr-mul-le-right d h hh)
                     (dk-have! (list '= hh1 1) (lambda () (dk-have! (list '= hh1 (list '* hh h)) (lambda () (crs)))
                                                          (bbi-rw! hh1 (list '* hh h)) (dk-ass!)))
                     (dk-have! (list '= dh (list '* 2 dc)) (lambda () (crs)))
                     (dk-have! (list '<= dc 1/2)
                       (lambda () (dk-ineq! (list '<= dh hh1) (list '= hh1 1) (list '= dh (list '* 2 dc)))))
                     (let ((nb (dk-cite! 'inverse-near-bound 'a 'b v)))
                       (dk-split-all! (list nb)))
                     (dk-cite! 'inverse-lipschitz 'a 'b v)
                     (bbi-rr! (list '* d kk)) (bbi-rr! (list '* e kk))
                     (dk-cite! 'rr-mul-le-right d e kk)
                     (dk-conj-close!
                       (lambda ()
                         (if (not (dk-ass!))
                             (let ((vi (bbi-vt (list 'INVERSE-EL 'a v))))
                               (bbi-rr! (bbi-nr (bbi-sb bi vi)))
                               (dk-le-chain! (bbi-nr (bbi-sb bi vi)) (list '* d kk) (list '* e kk) 'eps))))))))))))))
