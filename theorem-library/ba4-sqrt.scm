;;; g4s-contract: ||T u - T w|| <= ((||u|| + ||w||)/2) ||u - w||
(sp (g4s-st (list 'FORALL 'y (list 'IMPLIES '(IN y (VEC a)) (list 'FORALL 'u (list 'IMPLIES '(IN u (VEC a))
  (list 'FORALL 'w (list 'IMPLIES '(IN w (VEC a))
    (list '<= (g4s-nr (g4s-sb (g4s-T 'u) (g4s-T 'w)))
              (list '* (list '* 1/2 (list '+ (g4s-nr 'u) (g4s-nr 'w))) (g4s-nr (g4s-sb 'u 'w))))))))))))
(dk-peel!)
(let* ((d (g4s-sb 'u 'w)) (ud (g4s-mu 'u d)) (dw (g4s-mu d 'w)) (x (g4s-ad ud dw))
       (lhs (g4s-sb (g4s-T 'u) (g4s-T 'w))))
  (for-each g4s-vt! (list d ud dw x lhs))
  (for-each g4s-nt! (list 'u 'w d ud dw x))
  (g4s-alg! (list '= lhs (g4s-ac 1/2 x)))
  (g4s-rw! lhs (g4s-ac 1/2 x))
  (g4s-half-norm! x)
  (g4s-rw! (g4s-nr (g4s-ac 1/2 x)) (list '* 1/2 (g4s-nr x)))
  (dk-cite! 'bal-uba-vnrm-triangle 'a ud dw)
  (dk-cite! 'bal-uba-vnrm-submult 'a 'u d)
  (dk-cite! 'bal-uba-vnrm-submult 'a d 'w)
  (let* ((nu (g4s-nr 'u)) (nw (g4s-nr 'w)) (nd (g4s-nr d))
         (p1 (list '* nu nd)) (p2 (list '* nd nw))
         (rhs (list '* (list '* 1/2 (list '+ nu nw)) nd))
         (rhs2 (list '* 1/2 (list '+ p1 p2))))
    (dk-have! (list '= rhs rhs2) (lambda () (crs)))
    (g4s-rw! rhs rhs2)
    (dk-have! (list 'IN p1 'RR) (lambda () (in-rr)))
    (dk-have! (list 'IN p2 'RR) (lambda () (in-rr)))
    (dk-ineq! (list '<= (g4s-nr x) (list '+ (g4s-nr ud) (g4s-nr dw)))
              (list '<= (g4s-nr ud) p1) (list '<= (g4s-nr dw) p2)
              (list 'IN (g4s-nr x) 'RR) (list 'IN (g4s-nr ud) 'RR) (list 'IN (g4s-nr dw) 'RR)
              (list 'IN p1 'RR) (list 'IN p2 'RR))))
(g4s-qed! 'g4s-contract)

