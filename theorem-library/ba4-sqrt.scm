;;; ba4-sqrt.scm -- 1 - y IS A SQUARE for ||y|| < 1, by iteration (the square root behind Prop 4.7).
;;; Agent BA-1111-B, 2026-11-11.  Destination: theorem-library/ba4-sqrt.scm.  Library: operator-algebras.
;;; Load window: after structure-library/ba-rep-vocab (HALF-SQ-ITER), theorem-library/kal-laws, ba-laws,
;;; ba-elem (bae-vnrm-type), ba-neumann (ban-dist, ban-pts, ban-ms, ban-neg-norm), ba-cstar-laws (bcs-uu-*,
;;; bcs-uiba-*), metric-completeness / series files (summable-bound-converges, ms-limit-dist-le,
;;; converges-dist-null-fwd, rr-null-sum, rr-null-scale, rr-limit-le, rr-const-converges-to,
;;; power-tends-to-zero, geometric-series-converges).
;;;
;;; WHY NOT Proposition 1.33.  The notes take b = sqrt(1 - x* x) from the binomial series (1.32, 1.33), which
;;; needs the Cauchy product of absolutely convergent series in a Banach algebra and the coefficient
;;; identity of the binomial series at 1/2; neither is in the tree.  The iteration
;;;     z_0 = 0,  z_(n+1) = T(z_n),  T(w) = (y + w w) / 2
;;; needs only norm estimates.  With r = ||y|| < 1 and s = (1 + r)/2 < 1:
;;;   * ||z_n|| <= s, since ||T w|| <= (r + ||w||^2)/2 <= (r + 1)/2 for ||w|| <= 1;
;;;   * ||T u - T w|| <= (||u|| + ||w||)/2 ||u - w||, from T u - T w = (u (u - w) + (u - w) w)/2 (no
;;;     commutativity is used);
;;;   * so ||z_n - z_(n+1)|| <= s^n, the sequence converges (completeness), its limit z has ||z|| <= s and
;;;     T z = z; and (1 - z)^2 = 1 - 2 z + z^2 = 1 - y.
;;; In an involutive algebra with y* = y, z* is a fixed point of T of the same norm, and fixed points of T
;;; in the open unit ball are unique, so z* = z: 1 - y = b b = b* b with b = 1 - z self-adjoint.
;;;
;;;   g4s-iter-type          z_n in A
;;;   g4s-contract           ||T u - T w|| <= ((||u|| + ||w||)/2) ||u - w||
;;;   g4s-iter-bound         ||z_n|| <= s
;;;   g4s-iter-incr          ||z_n - z_(n+1)|| <= s^n
;;;   half-sq-fixed-point    (UBA) ||y|| < 1 => some z in A, ||z|| < 1, z = (y + z z)/2
;;;   half-sq-fixed-unique   (UBA) two fixed points of T in the open unit ball are equal
;;;   one-minus-square       (UBA) ||y|| < 1 => some b in A with b b = 1 - y
;;;   uiba-one-minus-sa-square (UIBA) y* = y, ||y|| < 1 => some b, b* = b, b b = 1 - y

(define (g4s-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (if (and (not (sequent-node-grounded? l))
                           (let ((g (dk-goal-of l))) (and (pair? g) (eq? (car g) '=) (equal? (cadr g) (caddr g)))))
                      (begin (dk-focus! l) (rfl))))
                (dk-open-leaves)))
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba4-sqrt: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba4-sqrt: unfinished" name))))

(define (g4s-st body) (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a) body))))
(define (g4s-ad x y) (list '(VADD a) x y))
(define (g4s-ng x) (list '(VNEG a) x))
(define (g4s-sb x y) (g4s-ad x (g4s-ng y)))
(define (g4s-mu x y) (list '(VMUL a) x y))
(define (g4s-ac c x) (list '(ACT a) c x))
(define (g4s-nr x) (list '(VNRM a) x))
(define (g4s-T u) (g4s-ac 1/2 (g4s-ad 'y (g4s-mu u u))))
(define (g4s-z n) (list 'HALF-SQ-ITER 'a 'y n))
(define g4s-zero '(VZERO a))
(define g4s-one '(VONE a))
(define g4s-ms '(BA-METRIC-SPACE a))
(define g4s-s '(* 1/2 (+ 1 ((VNRM a) y))))

(define (g4s-vt! t) (dk-alg-type! 'kal-uba 'a t) t)
(define (g4s-alg! claim) (dk-alg-have! 'kal-uba 'a claim))
;;; ||t|| in RR and 0 <= ||t||
(define (g4s-nt! t)
  (g4s-vt! t)
  (dk-cite! 'bae-vnrm-type 'a t)
  (dk-cite! 'bal-uba-vnrm-nonneg 'a t)
  (g4s-nr t))
(define (g4s-rw! from to) (subst (list '= from to)))
(define (g4s-close-eq!) (if (not (proof-done? *ps*)) (let ((g (dk-goal))) (if (and (eq? (car g) '=) (equal? (cadr g) (caddr g))) (rfl)))))

;;; (= (magnitude 1/2) 1/2)
(define (g4s-mag-half!)
  (let ((cl '(= (MAGNITUDE 1/2) 1/2)))
    (if (not (dk-asm? cl))
        (begin
          (dk-have! '(IN 1/2 RR) (lambda () (arith)))
          (dk-have! '(<= 0 1/2) (lambda () (arith)))
          (dk-cite! 'rr-magnitude-is-abs 1/2)
          (dk-cite! 'rr-abs-of-nonneg 1/2)
          (dk-have! cl (lambda () (subst '(= (MAGNITUDE 1/2) (ABS 1/2))) (subst '(= (ABS 1/2) 1/2)) (g4s-close-eq!)))))
    cl))
;;; (IN c (CARR (SCAL a))) from (IN c CC)
(define (g4s-scal! c)
  (dk-cc-type! c)
  (dk-cite! 'bal-uba-scal-carr 'a)
  (let ((f (list 'IN c '(CARR (SCAL a)))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (subst '(= (CARR (SCAL a)) CC)) (dk-ass!))))
    f))
;;; lands (= ||(1/2) x|| (* 1/2 ||x||)); returns it
(define (g4s-half-norm! x)
  (g4s-vt! x) (g4s-nt! x)
  (g4s-scal! 1/2)
  (g4s-mag-half!)
  (let* ((h (dk-cite! 'bal-uba-vnrm-homog 'a 1/2 x))
         (cl (list '= (g4s-nr (g4s-ac 1/2 x)) (list '* 1/2 (g4s-nr x)))))
    (dk-have! cl (lambda () (subst (list '= (g4s-nr (g4s-ac 1/2 x)) (caddr h)))
                            (subst '(= (MAGNITUDE 1/2) 1/2)) (g4s-close-eq!)))
    cl))

