;;; g4s-iter-incr: ||z_n - z_(n+1)|| <= s^n
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
  (g4s-hyps (list '<= (g4s-nr (g4s-sb (g4s-z 'n) (g4s-z '(succ n)))) '(POWER s n)))))))
(let* ((br (g4s-ind!)) (base (car br)) (step (cadr br)) (ih (caddr br)) (v (cadddr br)))
  (dk-focus! base)
  (dk-peel!)
  (fact 'HALF-SQ-ITER-succ 'a 'y 0)
  (subst (list '== (g4s-z '(succ 0)) (g4s-T (g4s-z 0))))
  (g4s-z0!)
  (let* ((t0 (g4s-T g4s-zero)) (lhs (g4s-sb g4s-zero t0)) (ny (g4s-nr 'y)) (my (g4s-ng 'y)))
    (for-each g4s-vt! (list t0 lhs my))
    (g4s-nt! 'y) (g4s-nt! my)
    (g4s-alg! (list '= lhs (g4s-ac 1/2 my)))
    (g4s-rw! lhs (g4s-ac 1/2 my))
    (g4s-half-norm! my)
    (g4s-rw! (g4s-nr (g4s-ac 1/2 my)) (list '* 1/2 (g4s-nr my)))
    (dk-cite! 'ban-neg-norm 'a 'y)
    (g4s-rw! (g4s-nr my) ny)
    (dk-cite! 'rr-subset-cc 's)
    (dk-cite! 'power-zero 's)
    (g4s-rw! '(POWER s 0) 1)
    (dk-ineq! (list '< ny 1) (list '<= 0 ny) (list 'IN ny 'RR)))
  (dk-focus! step)
  (dk-peel!)
  (let* ((sv (list 'succ v)) (z (g4s-z v)) (w1 (g4s-z sv)) (pv (list 'POWER 's v)))
    (dk-cite! 'nn-succ-closed v)
    (fact 'HALF-SQ-ITER-succ 'a 'y sv)
    (subst (list '== (g4s-z (list 'succ sv)) (g4s-T w1)))
    (dk-cite! 'g4s-iter-type v 'a 'y)
    (dk-cite! 'g4s-iter-type sv 'a 'y)
    (dk-apply! ih 'y 's)
    (dk-cite! 'g4s-iter-bound v 'a 'y 's)
    (dk-cite! 'g4s-iter-bound sv 'a 'y 's)
    (let* ((eq1 (dk-cite! 'HALF-SQ-ITER-succ 'a 'y v))
           (c0 (dk-cite! 'g4s-contract 'a 'y z w1))
           (c1 (dk-rewrite-h! c0 (g4s-T z) w1))
           (d (g4s-nr (g4s-sb z w1)))
           (t1 (g4s-nr z)) (t2 (g4s-nr w1))
           (k (list '* 1/2 (list '+ t1 t2)))
           (kk (list '* k d)))
      (for-each g4s-nt! (list 'y z w1 (g4s-sb z w1) (g4s-sb w1 (g4s-T w1))))
      (dk-real! k)
      (dk-cite! 'rr-subset-cc 's)
      (dk-cite! 'power-real-closed 's v)
      (dk-have! (list 'AND '(IN s CC) (list 'IN v 'NN)) (lambda () (dk-conj-close!)))
      (dk-cite! 'power-succ 's v)
      (dk-have! '(<= 0 s) (lambda () (dk-ineq! (list '= 's g4s-s) (list '<= 0 (g4s-nr 'y)) (list 'IN (g4s-nr 'y) 'RR) '(IN s RR))))
      (dk-have! (list '<= k 's) (lambda () (dk-ineq! (list '<= t1 's) (list '<= t2 's) (list 'IN t1 'RR) (list 'IN t2 'RR) '(IN s RR))))
      (dk-cite! 'rr-mul-le-right k 's d)
      (dk-cite! 'rr-mul-le-right d pv 's)
      (dk-have! (list '= (list '* 's d) (list '* d 's)) (lambda () (crs)))
      (dk-have! (list '= (list '* pv 's) (list '* 's pv)) (lambda () (crs)))
      (dk-le-chain! (g4s-nr (g4s-sb w1 (g4s-T w1))) kk (list '* 's d) (list '* d 's) (list '* pv 's)
                    (list '* 's pv) (list 'POWER 's sv)))))
(g4s-qed! 'g4s-iter-incr)

