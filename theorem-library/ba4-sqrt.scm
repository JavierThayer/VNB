;;; half-sq-fixed-point: ||y|| < 1 => some z, ||z|| < 1, z = T z
(define g4s-F '(VNB-LAMBDA g4j_ NN (HALF-SQ-ITER a y g4j_)))
(define (g4s-dist u v) (list (list 'DIST g4s-ms) u v))
(define (g4s-hsi-type! t)
  (let walk ((e t))
    (if (pair? e)
        (begin
          (for-each walk e)
          (if (and (eq? (car e) 'HALF-SQ-ITER) (= (length e) 4) (eq? (cadr e) 'a) (eq? (caddr e) 'y)
                   (not (dk-asm? (list 'IN e '(VEC a)))))
              (let ((x (cadddr e)))
                (if (and (pair? x) (eq? (car x) 'succ)) (dk-cite! 'nn-succ-closed (cadr x)))
                (dk-cite! 'g4s-iter-type x 'a 'y)))))))
(define (g4s-rr! t)
  (cond ((dk-asm? (list 'IN t 'RR)) t)
        ((number? t) (dk-have! (list 'IN t 'RR) (lambda () (arith))) t)
        ((and (pair? t) (memq (car t) '(* +)))
         (g4s-rr! (cadr t)) (g4s-rr! (caddr t))
         (dk-cite! (if (eq? (car t) '*) 'rr-mul-in-rr 'rr-add-in-rr) (cadr t) (caddr t)) t)
        ((and (pair? t) (eq? (car t) 'POWER))
         (g4s-rr! (cadr t)) (dk-cite! 'power-real-closed (cadr t) (caddr t)) t)
        ((and (pair? t) (equal? (car t) '(VNRM a)))
         (g4s-hsi-type! t) (g4s-nt! (cadr t)) t)
        ((and (pair? t) (equal? (car t) (list 'DIST g4s-ms)))
         (g4s-hsi-type! t)
         (let ((u (cadr t)) (v (caddr t)))
           (g4s-vt! u) (g4s-vt! v)
           (dk-cite! 'ban-dist 'a u v)
           (g4s-nt! (g4s-sb u v))
           (if (not (dk-asm? (list 'IN t 'RR)))
               (dk-have! (list 'IN t 'RR) (lambda () (g4s-rw! t (g4s-nr (g4s-sb u v))) (dk-ass!))))
           t))
        (#t (error "g4s-rr!: cannot type" (expression->string t)))))
(define (g4s-lam-rr! lam)
  (let ((f (list 'IN lam '(FUN NN RR))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda ()
          (dk-lam-type! (lambda ()
            (let ((g0 (dk-goal)))
              (if (and (dk-head-is? g0 'FORALL) (dk-asm? (caddr (caddr g0))))
                  (dk-close-if! (lambda () (di)) (lambda () (dk-ass!)))
                  (begin
                    (if (dk-head-is? g0 'FORALL) (dk-di-var!))
                    (if (dk--redex? (dk-goal)) (dk-lam-b!))
                    (let ((claim (dk-goal)))
                      (g4s-rr! (cadr claim))
                      (if (equal? (dk-goal) claim) (dk-ass!)))))))))))
    f))
(define (g4s-lam-vec! lam)
  (let ((f (list 'IN lam '(FUN NN (VEC a)))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda ()
          (dk-lam-type! (lambda ()
            (dk-di-var!)
            (let ((claim (dk-goal)))
              (g4s-hsi-type! claim)
              (if (equal? (dk-goal) claim) (dk-ass!))))))))
    f))
(define (g4s-pts! t)
  (dk-cite! 'ban-pts 'a)
  (let ((f (list 'IN t (list 'PTS g4s-ms))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (subst (list '== (list 'PTS g4s-ms) '(VEC a))) (dk-ass!))))
    f))
(define (g4s-fun-pts! h)
  (dk-cite! 'ban-pts 'a)
  (let ((f (list 'IN h (list 'FUN 'NN (list 'PTS g4s-ms)))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (subst (list '== (list 'PTS g4s-ms) '(VEC a))) (dk-ass!))))
    f))
;;; cite, then detach every remaining antecedent, proving each by conj-close / ass
(define (g4s-cite*! . args)
  (let loop ((r (apply dk-cite! args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (loop (if (dk-asm? (cadr r))
                  (dk-landed-1 (lambda () (detach! r)))
                  (detach-with! r (lambda () (dk-conj-close! (lambda () (dk-ass!)))))))
        r)))
;;; prove a pointwise universal (forall j in NN, ...) by beta and THUNK
(define (g4s-ptwise! thunk)
  (lambda ()
    (let ((j (dk-di-var!)))
      (dk-lam-b!)
      (thunk j))))

;;; the pointwise estimate at j: c <= (1 + s) dist(z_j, lm) + s^j, the goal after beta
(define (g4s-estimate! j lm sv c cn)
  (let* ((zj (list 'HALF-SQ-ITER 'a 'y j)) (w1 (list 'HALF-SQ-ITER 'a 'y (list 'succ j)))
         (u (g4s-T zj)) (Tl (g4s-T lm)) (D (g4s-sb lm Tl))
         (e (g4s-nr (g4s-sb zj lm))))
    (g4s-hsi-type! zj) (g4s-hsi-type! w1)
    (g4s-vt! u)
    (for-each g4s-nt! (list zj lm u Tl D (g4s-sb zj lm) (g4s-sb lm zj) (g4s-sb lm u) (g4s-sb u Tl) (g4s-sb zj u)
                            (g4s-sb zj w1)))
    (dk-cite! 'HALF-SQ-ITER-succ 'a 'y j)
    (let* ((inc (dk-cite! 'g4s-iter-incr j 'a 'y sv))
           (inc2 (dk-rewrite-h! inc w1 u))
           (bnd (dk-cite! 'g4s-iter-bound j 'a 'y sv))
           (ctr (dk-cite! 'g4s-contract 'a 'y zj lm))
           (k (list '* 1/2 (list '+ (g4s-nr zj) (g4s-nr lm))))
           (pj (list 'POWER sv j)))
      (g4s-rr! k) (g4s-rr! (list '* k e)) (g4s-rr! (list '* sv e)) (g4s-rr! pj)
      (dk-have! (list '<= k sv) (lambda () (dk-ineq! (list '<= (g4s-nr zj) sv) (list '<= (g4s-nr lm) sv)
                                                    (list 'IN (g4s-nr zj) 'RR) (list 'IN (g4s-nr lm) 'RR) (list 'IN sv 'RR))))
      (dk-cite! 'rr-mul-le-right k sv e)
      (dk-have! (list '<= (g4s-nr (g4s-sb u Tl)) (list '* sv e))
        (lambda () (dk-le-chain! (g4s-nr (g4s-sb u Tl)) (list '* k e) (list '* sv e))))
      (let* ((s1 (g4s-ad (g4s-sb lm u) (g4s-sb u Tl)))
             (s2 (g4s-ad (g4s-sb lm zj) (g4s-sb zj u))))
        (g4s-vt! s1) (g4s-vt! s2)
        (g4s-alg! (list '= D s1))
        (g4s-alg! (list '= (g4s-sb lm u) s2))
        (let* ((t1 (dk-rewrite-h! (dk-cite! 'bal-uba-vnrm-triangle 'a (g4s-sb lm u) (g4s-sb u Tl)) s1 D))
               (t2 (dk-rewrite-h! (dk-cite! 'bal-uba-vnrm-triangle 'a (g4s-sb lm zj) (g4s-sb zj u)) s2 (g4s-sb lm u)))
               (sym (dk-cite! 'ban-dist-sym 'a lm zj))
               (de (g4s-dist zj lm)))
          (g4s-rr! de)
          (g4s-rw! de e)
          (let ((lhs (list '* (list '+ 1 sv) e)) (rhs (list '+ e (list '* sv e))))
            (dk-have! (list '= lhs rhs) (lambda () (crs)))
            (g4s-rw! lhs rhs))
          (dk-ineq! t1 t2 sym inc2 (list '= cn c) (list 'IN cn 'RR) (list '<= (g4s-nr (g4s-sb u Tl)) (list '* sv e))
                    (list 'IN c 'RR) (list 'IN (g4s-nr (g4s-sb lm u)) 'RR) (list 'IN (g4s-nr (g4s-sb u Tl)) 'RR)
                    (list 'IN (g4s-nr (g4s-sb lm zj)) 'RR) (list 'IN (g4s-nr (g4s-sb zj u)) 'RR)
                    (list 'IN e 'RR) (list 'IN (list '* sv e) 'RR) (list 'IN pj 'RR)))))))

(sp (g4s-st (list 'FORALL 'y (list 'IMPLIES '(IN y (VEC a)) (list 'IMPLIES '(< ((VNRM a) y) 1)
  (list 'FORSOME 'z (list 'AND '(IN z (VEC a)) (list 'AND (list '< (g4s-nr 'z) 1) (list '= 'z (g4s-T 'z))))))))))
(dk-peel!)
(let* ((ny (g4s-nr 'y)))
  (g4s-nt! 'y)
  (g4s-rr! g4s-s)
  (let* ((sv (dk-name! g4s-s))
         (sdef (list '= sv g4s-s))
         (F g4s-F))
    (dk-have! (list '<= 0 sv) (lambda () (dk-ineq! sdef (list '<= 0 ny) (list 'IN ny 'RR) (list 'IN sv 'RR))))
    (dk-have! (list '< sv 1) (lambda () (dk-ineq! sdef (list '< ny 1) (list 'IN ny 'RR) (list 'IN sv 'RR))))
    (dk-cite! 'ban-ms 'a)
    (g4s-lam-vec! F) (g4s-fun-pts! F)
    ;; the sequence converges
    (let* ((gs (dk-cite! 'geometric-series-converges sv))
           (rad (cadr gs))
           (ch (dk-cite! 'summable-bound-converges g4s-ms F rad)))
      (detach-with! ch
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond ((dk-head-is? g 'IS-COMPLETE) (dk-cite! 'bal-uba-complete 'a) (dk-ass!))
                      ((dk-head-is? g 'SERIES-CONVERGES) (dk-ass!))
                      ((and (dk-head-is? g 'IN) (equal? (caddr g) '(FUN NN RR)))
                       (g4s-lam-rr! rad) (if (equal? (dk-goal) g) (dk-ass!)))
                      ((dk-head-is? g 'IN) (dk-ass!))
                      (#t
                       (let ((k (dk-di-var!)))
                         (dk-cite! 'nn-succ-closed k)
                         (dk-lam-b!)
                         (let ((d (cadr (dk-goal))))
                           (g4s-rr! d)
                           (g4s-rw! d (g4s-nr (g4s-sb (cadr d) (caddr d))))
                           (dk-cite! 'g4s-iter-incr k 'a 'y sv)
                           (dk-ass!))))))))))
      #t)
    (let* ((cv (dk-ctx-form (list 'CONVERGES g4s-ms F)))
           (ex (dk-landed-1 (lambda () (mac-h 'converges cv))))
           (lm (dk-skolem! ex))
           (ct (list 'CONVERGES-TO g4s-ms F lm)))
      (dk-project! (list 'IN lm (list 'PTS g4s-ms)) 'converges-to ct)
      (dk-have! (list 'IN lm '(VEC a)) (lambda () (subst (list '== '(VEC a) (list 'PTS g4s-ms))) (dk-ass!)))
      (g4s-nt! lm)
      ;; ||lm|| <= s
      (g4s-vt! g4s-zero) (g4s-pts! g4s-zero)
      (dk-cite! 'nn-zero-in)
      (let ((ml (dk-cite! 'ms-limit-dist-le g4s-ms F lm g4s-zero sv 0)))
        (detach-with! ml
          (lambda ()
            (dk-peel!)
            (let* ((g (dk-goal)) (n (cadr (cadr (cadr g)))))
              (dk-lam-b!)
              (let* ((d (cadr (dk-goal))) (zn (cadr d)))
                (g4s-rr! d)
                (g4s-rw! d (g4s-nr (g4s-sb zn g4s-zero)))
                (g4s-alg! (list '= (g4s-sb zn g4s-zero) zn))
                (g4s-rw! (g4s-sb zn g4s-zero) zn)
                (dk-cite! 'g4s-iter-bound n 'a 'y sv)
                (dk-ass!)))))
        #t)
      (g4s-rr! (g4s-dist lm g4s-zero))
      (g4s-alg! (list '= (g4s-sb lm g4s-zero) lm))
      (let* ((h1 (dk-rewrite-h! (list '<= (g4s-dist lm g4s-zero) sv) (g4s-dist lm g4s-zero) (g4s-nr (g4s-sb lm g4s-zero))))
             (h2 (dk-rewrite-h! h1 (g4s-sb lm g4s-zero) lm)))
        #t)
      (dk-have! (list '< (g4s-nr lm) 1)
        (lambda () (dk-ineq! (list '<= (g4s-nr lm) sv) (list '< sv 1) (list 'IN (g4s-nr lm) 'RR) (list 'IN sv 'RR))))
      ;; T lm = lm
      (let* ((Tl (g4s-T lm)) (D (g4s-sb lm Tl)) (c (g4s-nr D)) (s1 (list '+ 1 sv))
             (Hs (list 'VNB-LAMBDA 'g4j_ 'NN (list '* s1 (g4s-dist '(HALF-SQ-ITER a y g4j_) lm))))
             (H (list 'VNB-LAMBDA 'g4j_ 'NN (list '+ (list '* s1 (g4s-dist '(HALF-SQ-ITER a y g4j_) lm)) (list 'POWER sv 'g4j_)))))
        (g4s-vt! Tl) (g4s-nt! D)
        (g4s-rr! s1)
        (dk-have! (list '<= 0 s1) (lambda () (dk-ineq! (list '<= 0 sv) (list 'IN sv 'RR))))
        (let* ((nf (dk-cite! 'converges-dist-null-fwd g4s-ms F lm))
               (E (caddr nf))
               (_a (dk-cite! 'rr-abs-of-nonneg sv))
               (_b (dk-have! (list '< (list 'ABS sv) 1) (lambda () (g4s-rw! (list 'ABS sv) sv) (dk-ass!))))
               (pz (g4s-cite*! 'power-tends-to-zero sv))
               (P (caddr pz))
               (cn (dk-name! c))
               (cc0 (dk-cite! 'rr-const-converges-to cn))
               (Cq (caddr cc0)))
          (for-each g4s-lam-rr! (list E P Hs H Cq))
          (let ((ns (dk-cite! 'rr-null-scale s1 E Hs)))
            (detach-with! ns (g4s-ptwise! (lambda (j) (g4s-rr! (cadr (dk-goal))) (if (not (proof-done? *ps*)) (g4s-close-eq!))))))
          (let ((nsum (dk-cite! 'rr-null-sum Hs P H)))
            (detach-with! nsum (g4s-ptwise! (lambda (j) (g4s-rr! (cadr (dk-goal))) (g4s-close-eq!)))))
          (dk-have! '(IN 0 RR) (lambda () (arith)))
          (let ((le (dk-cite! 'rr-limit-le Cq H cn 0)))
            (let loop ((r le) (first #t))
              (if (and (pair? r) (eq? (car r) 'IMPLIES))
                  (loop (if (dk-asm? (cadr r))
                            (dk-landed-1 (lambda () (detach! r)))
                            (detach-with! r (g4s-ptwise! (lambda (j) (g4s-estimate! j lm sv c cn)))))
                        #f))))
          ;; c = 0
          (dk-rewrite-h! (list '<= cn 0) cn c)
          (dk-have! (list 'AND (list 'IN c 'RR) '(IN 0 RR)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
          (dk-have! (list 'AND (list '<= c 0) (list '<= 0 c)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
          (g4s-cite*! 'rr-leq-antisymmetric c 0)
          (let ((iff (dk-cite! 'bal-uba-vnrm-definite 'a D)))
            (dk-have! (list '= D g4s-zero) (lambda () (dk-only! iff (list '= c 0)) (prop))))
          (g4s-alg! (list '= lm (g4s-ad D Tl)))
          (g4s-alg! (list '= (g4s-ad g4s-zero Tl) Tl))
          (let* ((e1 (dk-rewrite-h! (list '= lm (g4s-ad D Tl)) D g4s-zero))
                 (e2 (dk-rewrite-h! e1 (g4s-ad g4s-zero Tl) Tl)))
            (ew lm)
            (dk-conj-close! (lambda () (dk-ass!)))))))))
(g4s-qed! 'half-sq-fixed-point)

;;; =============================================================================================
;;; half-sq-fixed-unique: two fixed points of T in the open unit ball are equal
(sp (g4s-st (list 'FORALL 'y (list 'IMPLIES '(IN y (VEC a))
  (list 'FORALL 'u (list 'IMPLIES '(IN u (VEC a)) (list 'IMPLIES (list '< (g4s-nr 'u) 1) (list 'IMPLIES (list '= 'u (g4s-T 'u))
  (list 'FORALL 'w (list 'IMPLIES '(IN w (VEC a)) (list 'IMPLIES (list '< (g4s-nr 'w) 1) (list 'IMPLIES (list '= 'w (g4s-T 'w))
    '(= u w)))))))))))))
(dk-peel!)
(let* ((uw (g4s-sb 'u 'w)) (d (g4s-nr uw)) (k (list '* 1/2 (list '+ (g4s-nr 'u) (g4s-nr 'w))))
       (kd (list '* k d)) (Tu (g4s-T 'u)) (Tw (g4s-T 'w)))
  (for-each g4s-nt! (list 'u 'w uw (g4s-sb Tu Tw)))
  (g4s-rr! k) (g4s-rr! kd)
  (let* ((c0 (dk-cite! 'g4s-contract 'a 'y 'u 'w))
         (c1 (dk-rewrite-h! c0 Tu 'u))
         (c2 (dk-rewrite-h! c1 Tw 'w)))
    (dk-have! (list '< k 1) (lambda () (dk-ineq! (list '< (g4s-nr 'u) 1) (list '< (g4s-nr 'w) 1)
                                                (list 'IN (g4s-nr 'u) 'RR) (list 'IN (g4s-nr 'w) 'RR))))
    (dk-have! '(IN 1 RR) (lambda () (arith)))
    (dk-have! (list 'NOT (list '< 0 d))
      (lambda ()
        (di)
        (let ((iff (dk-cite! 'rr-mul-lt-cancel-iff k 1 d)))
          (dk-have! (list '< kd (list '* 1 d)) (lambda () (dk-only! iff (list '< k 1)) (prop)))
          (dk-have! (list '= (list '* 1 d) d) (lambda () (crs)))
          (dk-absurd! c2 (list '< kd (list '* 1 d)) (list '= (list '* 1 d) d) (list 'IN kd 'RR) (list 'IN d 'RR)))))
    (dk-have! '(IN 0 RR) (lambda () (arith)))
    (dk-cite! 'rr-not-lt-ge 0 d)
    (dk-have! (list 'AND (list 'IN d 'RR) '(IN 0 RR)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (dk-have! (list 'AND (list '<= d 0) (list '<= 0 d)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (g4s-cite*! 'rr-leq-antisymmetric d 0)
    (let ((iff (dk-cite! 'bal-uba-vnrm-definite 'a uw)))
      (dk-have! (list '= uw g4s-zero) (lambda () (dk-only! iff (list '= d 0)) (prop))))
    (g4s-alg! (list '= 'u (g4s-ad uw 'w)))
    (g4s-alg! (list '= (g4s-ad g4s-zero 'w) 'w))
    (let* ((e1 (dk-rewrite-h! (list '= 'u (g4s-ad uw 'w)) uw g4s-zero))
           (e2 (dk-rewrite-h! e1 (g4s-ad g4s-zero 'w) 'w)))
      (dk-ass!))))
(g4s-qed! 'half-sq-fixed-unique)

;;; =============================================================================================
;;; (1 - z)(1 - z) = 1 - y from z = T z; PREFIX the law set, works in a UBA (kal-uba) or a UIBA (kal-uiba)
(define (g4s-square! prefix z)
  (let* ((b (g4s-sb g4s-one z)) (Tz (g4s-T z)) (D (g4s-sb z Tz)) (oy (g4s-sb g4s-one 'y))
         (rhs (g4s-ad oy (g4s-ac -2 D))) (rhs0 (g4s-ad oy (g4s-ac -2 g4s-zero))))
    (for-each (lambda (t) (dk-alg-type! prefix 'a t)) (list b Tz D oy rhs rhs0))
    (dk-alg-have! prefix 'a (list '= (g4s-mu b b) rhs))
    (dk-have! (list '= D g4s-zero)
      (lambda () (subst (list '= Tz z)) (dk-alg-norm! prefix 'a)))
    (dk-alg-have! prefix 'a (list '= rhs0 oy))
    (let* ((e1 (dk-rewrite-h! (list '= (g4s-mu b b) rhs) D g4s-zero))
           (e2 (dk-rewrite-h! e1 rhs0 oy)))
      e2)))

(sp (g4s-st (list 'FORALL 'y (list 'IMPLIES '(IN y (VEC a)) (list 'IMPLIES '(< ((VNRM a) y) 1)
  (list 'FORSOME 'b (list 'AND '(IN b (VEC a)) (list '= (g4s-mu 'b 'b) (g4s-sb g4s-one 'y)))))))))
(dk-peel!)
(let* ((ex (dk-cite! 'half-sq-fixed-point 'a 'y))
       (z (dk-skolem! ex #t)))
  (g4s-square! 'kal-uba z)
  (let ((b (g4s-sb g4s-one z)))
    (g4s-vt! b)
    (ew b)
    (dk-conj-close! (lambda () (dk-ass!)))))
(g4s-qed! 'one-minus-square)

;;; =============================================================================================
;;; the involutive case: y* = y, ||y|| < 1 => 1 - y = b b with b* = b
(define g4s-V '(UIBA-AS-UBA a))
(define g4s-accs '(SCAL VEC VADD VZERO VNEG ACT VNRM VMUL VONE))
(define (g4s-uu acc) (string->symbol (string-append "bcs-uu-" (string-downcase (symbol->string acc)))))
(define (g4s-occurs? x t) (or (equal? x t) (and (pair? t) (or (g4s-occurs? x (car t)) (g4s-occurs? x (cdr t))))))
;;; a hypothesis about the view, rewritten onto a
(define (g4s-readback! f)
  (let loop ((accs g4s-accs) (g f))
    (if (null? accs) g
        (let ((t (list (car accs) g4s-V)))
          (if (g4s-occurs? t g)
              (begin (dk-cite! (g4s-uu (car accs)) 'a)
                     (loop (cdr accs) (dk-rewrite-h! g t (list (car accs) 'a))))
              (loop (cdr accs) g))))))
;;; the goal, about the view, rewritten onto a
(define (g4s-goal-onto-a!)
  (for-each (lambda (acc)
              (let ((t (list acc g4s-V)))
                (if (g4s-occurs? t (dk-goal))
                    (begin (dk-cite! (g4s-uu acc) 'a) (subst (list '= t (list acc 'a)))))))
            g4s-accs))
(define (g4s-via-a! claim) (dk-have! claim (lambda () (g4s-goal-onto-a!) (dk-ass!))) claim)
(define (g4s-onV f)       ; replace the accessors of a by those of the view, in a formula
  (let walk ((e f))
    (cond ((and (pair? e) (memq (car e) g4s-accs) (= (length e) 2) (eq? (cadr e) 'a)) (list (car e) g4s-V))
          ((pair? e) (map walk e))
          (#t e))))

(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
  (list 'FORALL 'y (list 'IMPLIES '(IN y (VEC a)) (list 'IMPLIES '(= ((VSTAR a) y) y) (list 'IMPLIES '(< ((VNRM a) y) 1)
    (list 'FORSOME 'b (list 'AND '(IN b (VEC a))
      (list 'AND '(= ((VSTAR a) b) b) (list '= (g4s-mu 'b 'b) (g4s-sb g4s-one 'y)))))))))))))
(dk-peel!)
(dk-cite! 'bcs-uiba-is-uba 'a)
(g4s-via-a! (g4s-onV '(IN y (VEC a))))
(g4s-via-a! (g4s-onV '(< ((VNRM a) y) 1)))
(let* ((ex (dk-cite! 'half-sq-fixed-point g4s-V 'y))
       (z (dk-skolem! ex #t))
       (zs (list '(VSTAR a) z))
       (Tz (g4s-T z)) (Tzs (g4s-T zs)))
  (for-each (lambda (f) (g4s-readback! (g4s-onV f)))
            (list (list 'IN z '(VEC a)) (list '< (g4s-nr z) 1) (list '= z Tz)))
  (dk-alg-type! 'kal-uiba 'a zs)
  (dk-alg-type! 'kal-uiba 'a Tz) (dk-alg-type! 'kal-uiba 'a Tzs)
  (dk-cite! 'bcs-uiba-star-norm 'a z)
  (dk-have! (list '< (g4s-nr zs) 1) (lambda () (subst (list '= (g4s-nr zs) (g4s-nr z))) (dk-ass!)))
  ;; z* is a fixed point
  (let* ((sT (list '(VSTAR a) Tz))
         (mid (g4s-ac 1/2 (g4s-ad '((VSTAR a) y) (g4s-mu zs zs)))))
    (dk-alg-type! 'kal-uiba 'a sT) (dk-alg-type! 'kal-uiba 'a mid)
    (dk-alg-have! 'kal-uiba 'a (list '= sT mid))
    (dk-have! (list '= zs Tzs)
      (lambda ()
        (subst '(= y ((VSTAR a) y)))
        (subst (list '= mid sT))
        (subst (list '= Tz z))
        (g4s-close-eq!))))
  ;; uniqueness, on the view
  (for-each g4s-via-a! (map g4s-onV (list (list 'IN z '(VEC a)) (list 'IN zs '(VEC a)) (list '< (g4s-nr z) 1)
                                          (list '< (g4s-nr zs) 1) (list '= z Tz) (list '= zs Tzs))))
  (dk-cite! 'half-sq-fixed-unique g4s-V 'y z zs)
  (let ((b (g4s-sb g4s-one z)))
    (g4s-square! 'kal-uiba z)
    (dk-alg-type! 'kal-uiba 'a b)
    (dk-alg-have! 'kal-uiba 'a (list '= (list '(VSTAR a) b) (g4s-sb g4s-one zs)))
    (dk-have! (list '= (list '(VSTAR a) b) b)
      (lambda () (subst (list '= (list '(VSTAR a) b) (g4s-sb g4s-one zs))) (subst (list '= zs z)) (g4s-close-eq!)))
    (ew b)
    (dk-conj-close! (lambda () (dk-ass!)))))
(g4s-qed! 'uiba-one-minus-sa-square)
