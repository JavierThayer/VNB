;;; g4s-iter-bound: ||z_n|| <= s
(define (g4s-hyps body)
  (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a)
    (list 'FORALL 'y (list 'IMPLIES '(IN y (VEC a))
      (list 'FORALL 's (list 'IMPLIES '(IN s RR)
        (list 'IMPLIES '(< ((VNRM a) y) 1)
          (list 'IMPLIES (list '= 's g4s-s) body)))))))))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
  (g4s-hyps (list '<= (g4s-nr (g4s-z 'n)) 's))))))
(let* ((br (g4s-ind!)) (base (car br)) (step (cadr br)) (ih (caddr br)) (v (cadddr br)))
  (dk-focus! base)
  (dk-peel!)
  (g4s-z0!)
  (g4s-nt! 'y) (g4s-vt! g4s-zero)
  (let ((iff (dk-cite! 'bal-uba-vnrm-definite 'a g4s-zero)))
    (dk-have! (list '= g4s-zero g4s-zero) (lambda () (rfl)))
    (dk-have! (list '= (g4s-nr g4s-zero) 0) (lambda () (dk-only! iff (list '= g4s-zero g4s-zero)) (prop))))
  (g4s-nt! g4s-zero)
  (dk-ineq! (list '= (g4s-nr g4s-zero) 0) (list '= 's g4s-s) (list '<= 0 (g4s-nr 'y))
            (list 'IN (g4s-nr 'y) 'RR) (list 'IN (g4s-nr g4s-zero) 'RR) '(IN s RR))
  (dk-focus! step)
  (dk-peel!)
  (let* ((z (g4s-z v)) (zz (g4s-mu z z)) (e (g4s-ad 'y zz)) (tt (g4s-nr z)) (pp (list '* tt tt)))
    (g4s-zs! v)
    (dk-cite! 'g4s-iter-type v 'a 'y)
    (dk-apply! ih 'y 's)
    (for-each g4s-nt! (list 'y z zz e))
    (g4s-half-norm! e)
    (g4s-rw! (g4s-nr (g4s-ac 1/2 e)) (list '* 1/2 (g4s-nr e)))
    (dk-cite! 'bal-uba-vnrm-triangle 'a 'y zz)
    (dk-cite! 'bal-uba-vnrm-submult 'a z z)
    (dk-have! (list '<= tt 1) (lambda () (dk-ineq! (list '<= tt 's) (list '= 's g4s-s) (list '< (g4s-nr 'y) 1)
                                                   (list 'IN tt 'RR) (list 'IN (g4s-nr 'y) 'RR) '(IN s RR))))
    (dk-have! '(IN 1 RR) (lambda () (arith)))
    (dk-cite! 'rr-mul-le-right tt 1 tt)
    (dk-have! (list '= (list '* 1 tt) tt) (lambda () (crs)))
    (dk-have! (list 'IN pp 'RR) (lambda () (in-rr)))
    (dk-have! (list '<= (g4s-nr zz) tt) (lambda () (dk-le-chain! (g4s-nr zz) pp (list '* 1 tt) tt)))
    (dk-ineq! (list '<= (g4s-nr e) (list '+ (g4s-nr 'y) (g4s-nr zz))) (list '<= (g4s-nr zz) tt)
              (list '<= tt 's) (list '< (g4s-nr 'y) 1)
              (list '= 's g4s-s) (list 'IN (g4s-nr e) 'RR) (list 'IN (g4s-nr zz) 'RR)
              (list 'IN tt 'RR) (list 'IN (g4s-nr 'y) 'RR) '(IN s RR))))
(g4s-qed! 'g4s-iter-bound)

