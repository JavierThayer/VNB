;; THE BINARY INSTANCES (the catalog's union-membership and intersection-membership, library.scm 753, 763): the pair
;; [0, x in a CONN x in b] is a right fold over [a, b] (the base at j = 1, one step), so der-union-decompose /
;; der-intersection-decompose gives each instance over the core.  The two theorems also show RF-SET is not empty.
(define (md14-binary! enc-op conn h conn-intro clt-law enc-unfold dec name)
  (sp (make-wff `(FORALL tt (FORALL g (FORALL x (FORALL a (FORALL b (IMPLIES (IN g CTX-SET) (IMPLIES (IN x CLT)
     (IMPLIES (IN a CLT) (IMPLIES (IN b CLT)
       (IN (LIST g (ENC-IFF (ENC-IN x (,enc-op (LIST a b))) (,conn (ENC-IN x a) (ENC-IN x b)))) (DERIVABLE tt)))))))))))))
  (dk-peel!)
  (let* ((l '(LIST a b)) (n1 `(NTH (succ 0) ,l)) (n2 `(NTH (succ (succ 0)) ,l))
         (e1 `(ENC-IN x ,n1)) (e2 `(ENC-IN x ,n2)) (f `(EAPP ,h (LIST ,e1 ,e2)))
         (xa '(ENC-IN x a)) (xb '(ENC-IN x b)) (cf `(,conn ,xa ,xb)) (uu `(ENC-IN x (,enc-op ,l))))
    (for-each (lambda (v) (md-expr-of! v 'CLT)) '(x a b))
    (dk-have! '(IN 0 NN) (lambda () (arith)))
    (dk-cite! 'clf-in-intro 'x 'a)
    (dk-cite! 'clf-in-intro 'x 'b)
    (dk-cite! conn-intro xa xb)
    (md-expr-of! cf 'CLF)
    ;; the fold, read: NTH (succ 0) [a, b] = a, NTH (succ (succ 0)) [a, b] = b, h(p, q) = CONN(p, q)
    (dk-have! '(= (succ 0) 1) (lambda () (arith)))
    (dk-have! '(= (succ (succ 0)) 2) (lambda () (arith)))
    (dk-have! `(= ,n1 a) (lambda () (subst '(= (succ 0) 1)) (nth-r) (rfl)))
    (dk-have! `(= ,n2 b) (lambda () (subst '(= (succ (succ 0)) 2)) (nth-r) (rfl)))
    (let ((un (dk-cite! (if (eq? conn 'ENC-OR) 'enc-or-unfold 'enc-and-unfold) xa xb)))
      (dk-have! `(= ,f ,cf) (lambda () (subst `(= ,n1 a)) (subst `(= ,n2 b)) (subst `(= ,cf ,(caddr un))) (rfl))))
    (dk-have! `(IN ,f EXPR-SET) (lambda () (subst `(= ,f ,cf)) (ass)))
    ;; the list's union / intersection is a closed term
    (dk-have! `(IN ,l (TUPLES EXPR-SET)) (lambda () (dk-close-all! (lambda () (ti)))))
    (dk-have! `(FORALL mczu_ (IMPLIES (IN mczu_ (MAKE-SET ,l)) (IN mczu_ CLT)))
      (lambda ()
        (let* ((landed (dk-peel!))
               (w (cadr (find-first (lambda (q) (and (dk-head-is? q 'IN) (dk-head-is? (caddr q) 'MAKE-SET))) landed))))
          (dk-meta-or-each! (dk-cite! 'ms2-cases 'a 'b w) (lambda (d) (subst d) (ass))))))
    (dk-cite! enc-unfold l)
    (let ((ce (dk-meta-iff-l! (dk-meta-iff! clt-law l))))
      (dk-rewrite-h! ce (cadr ce) `(,enc-op ,l)))
    (dk-cite! 'clf-in-intro 'x `(,enc-op ,l))
    ;; [0, f] is a right fold over [a, b]
    (dk-have! `(IN (LIST 0 ,f) (RF-SET ,h x ,l))
      (lambda ()
        (subst (dk-cite! 'rf-set-unfold h 'x l))
        (in-sep! (lambda () (dk-meta-close-in!))
          (lambda ()
            (let* ((landed (dk-peel!))
                   (cl (find-first (lambda (q) (dk-head-is? q 'RF-CLOSED)) landed))
                   (parts (dk-split! (dk-landed-1 (lambda () (mac-h 'rf-closed cl)))))
                   (u1 (find-first (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q '=))) parts))
                   (u2 (find-first (lambda (q) (and (dk-head-is? q 'FORALL) (not (dk-contains? q '=)))) parts)))
              (fact 'nn-succ-closed 0)
              (dk-have! `(= (succ (succ 0)) (LENGTH ,l)) (lambda () (len-r) (arith)))
              (dk-apply! u1 '(succ 0))
              (dk-apply! u2 0 e2)
              (ass))))))
    (dk-cite! dec 'tt 'g 'x l f)
    (dk-rewrite-h! `(IN (LIST g (ENC-IFF ,uu ,f)) (DERIVABLE tt)) f cf)
    (md-close!))
  (qed name))
(md14-binary! 'ENC-UNION 'ENC-OR 4 'clf-or-intro 'clt-union 'enc-union-unfold 'der-union-decompose 'der-union-binary)
(md14-binary! 'ENC-INTER 'ENC-AND 3 'clf-and-intro 'clt-inter 'enc-inter-unfold 'der-intersection-decompose 'der-intersection-binary)
