    (dk-meta-derive! 'tt `(def-strict-in-l (,g ==> (ENC-EQ ,e ,e)) (given (,g ==> (ENC-IN ,e ENC-SETC))))))
  ;; (4) [g, NTH(k, [l]) == l_k]
  (dk-cite! 'clf-qeq-intro nn e)
  (dk-meta-derive! 'tt `(nth-eq (,g ==> ,q) (given (,g ==> (ENC-EQ ,lst ,lst)))))
