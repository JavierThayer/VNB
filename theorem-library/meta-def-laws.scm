;;; -----------------------------------------------------------------------
;;; 10. THE CATALOG'S N-ARY DECOMPOSITIONS ARE DERIVABLE OVER THE CORE (agent K2-END, 2026-10-22;
;;; structure-library/meta-def.scm, section 10).  The derived propositional rules (reflexivity and transitivity of
;;; iff, associativity of OR and AND, the units FALSITY and TRUTH); the right fold against the core's left fold, by
;;; induction over the least set RF-SET (rf-orl, rf-andl); every instance of union-decompose and of
;;; intersection-decompose derivable with no member of T; their local redexes inside EQV(T); the one-position
;;; admissibility of the kernel's rewrite by either schema.

;; (the unfoldings enc-or-unfold, enc-and-unfold of ENC-OR, ENC-AND are meta-core-laws.scm's)

(define (md14-iff g a b) `(IN (LIST ,g (ENC-IFF ,a ,b)) (DERIVABLE tt)))

;; a iff a
(sp (make-wff '(FORALL tt (FORALL g (FORALL a (IMPLIES (IN g CTX-SET) (IMPLIES (IN a CLF) (IN (LIST g (ENC-IFF a a)) (DERIVABLE tt)))))))))
(dk-peel!)
(dk-meta-derive! 'tt '(iff-intro (g ==> (ENC-IFF a a)) (assumption ((CTX-ADD g a) ==> a)) (assumption ((CTX-ADD g a) ==> a))))
(md-close!)
(qed 'der-iff-refl)

;; a iff b, b iff c  =>  a iff c
(sp (make-wff '(FORALL tt (FORALL g (FORALL a (FORALL b (FORALL c (IMPLIES (IN (LIST g (ENC-IFF a b)) (DERIVABLE tt))
   (IMPLIES (IN (LIST g (ENC-IFF b c)) (DERIVABLE tt)) (IN (LIST g (ENC-IFF a c)) (DERIVABLE tt)))))))))))
(dk-peel!)
(let ((ab '(ENC-IFF a b)) (bc '(ENC-IFF b c)) (ga '(CTX-ADD g a)) (gc '(CTX-ADD g c)))
  (md12-seq-of! 'g ab)
  (md12-seq-of! 'g bc)
  (dk-split! (dk-cite! 'clf-iff-elim 'a 'b))
  (dk-split! (dk-cite! 'clf-iff-elim 'b 'c))
  (dk-cite! 'clf-iff-intro 'a 'c)
  (dk-meta-derive! 'tt
    `(iff-intro (g ==> (ENC-IFF a c))
       (lemma (,ga ==> c) der-iff-r (,ga b c) (weakening (,ga ==> ,bc) (given (g ==> ,bc)))
         (lemma (,ga ==> b) der-iff-r (,ga a b) (weakening (,ga ==> ,ab) (given (g ==> ,ab))) (assumption (,ga ==> a))))
       (lemma (,gc ==> a) der-iff-l (,gc a b) (weakening (,gc ==> ,ab) (given (g ==> ,ab)))
         (lemma (,gc ==> b) der-iff-l (,gc b c) (weakening (,gc ==> ,bc) (given (g ==> ,bc))) (assumption (,gc ==> c))))))
  (md-close!))
(qed 'der-iff-trans)

;; (a or b) or c  iff  a or (b or c)
(sp (make-wff '(FORALL tt (FORALL g (FORALL a (FORALL b (FORALL c (IMPLIES (IN g CTX-SET) (IMPLIES (IN a CLF) (IMPLIES (IN b CLF)
   (IMPLIES (IN c CLF) (IN (LIST g (ENC-IFF (ENC-OR (ENC-OR a b) c) (ENC-OR a (ENC-OR b c)))) (DERIVABLE tt)))))))))))))
(dk-peel!)
(let* ((ab '(ENC-OR a b)) (bc '(ENC-OR b c)) (lf `(ENC-OR ,ab c)) (rt `(ENC-OR a ,bc))
       (gl (md+ 'g lf)) (gr (md+ 'g rt)))
  (dk-meta-derive! 'tt
    `(iff-intro (g ==> (ENC-IFF ,lf ,rt))
       (or-elim (,gl ==> ,rt)
         (or-elim (,(md+ gl ab) ==> ,rt)
           (or-intro-left (,(md+ gl ab 'a) ==> ,rt) (assumption (,(md+ gl ab 'a) ==> a)))
           (or-intro-right (,(md+ gl ab 'b) ==> ,rt) (or-intro-left (,(md+ gl ab 'b) ==> ,bc) (assumption (,(md+ gl ab 'b) ==> b)))))
         (or-intro-right (,(md+ gl 'c) ==> ,rt) (or-intro-right (,(md+ gl 'c) ==> ,bc) (assumption (,(md+ gl 'c) ==> c)))))
       (or-elim (,gr ==> ,lf)
         (or-intro-left (,(md+ gr 'a) ==> ,lf) (or-intro-left (,(md+ gr 'a) ==> ,ab) (assumption (,(md+ gr 'a) ==> a))))
         (or-elim (,(md+ gr bc) ==> ,lf)
           (or-intro-left (,(md+ gr bc 'b) ==> ,lf) (or-intro-right (,(md+ gr bc 'b) ==> ,ab) (assumption (,(md+ gr bc 'b) ==> b))))
           (or-intro-right (,(md+ gr bc 'c) ==> ,lf) (assumption (,(md+ gr bc 'c) ==> c)))))))
  (md-close!))
(qed 'der-or-assoc)

;; (a and b) and c  iff  a and (b and c)
(sp (make-wff '(FORALL tt (FORALL g (FORALL a (FORALL b (FORALL c (IMPLIES (IN g CTX-SET) (IMPLIES (IN a CLF) (IMPLIES (IN b CLF)
   (IMPLIES (IN c CLF) (IN (LIST g (ENC-IFF (ENC-AND (ENC-AND a b) c) (ENC-AND a (ENC-AND b c)))) (DERIVABLE tt)))))))))))))
(dk-peel!)
(let* ((ab '(ENC-AND a b)) (bc '(ENC-AND b c)) (lf `(ENC-AND ,ab c)) (rt `(ENC-AND a ,bc))
       (gl (md+ 'g lf)) (gr (md+ 'g rt)) (gl2 (md+ gl ab 'c 'a 'b)) (gr2 (md+ gr 'a bc 'b 'c)))
  (dk-meta-derive! 'tt
    `(iff-intro (g ==> (ENC-IFF ,lf ,rt))
       (and-elim (,gl ==> ,rt)
         (and-elim (,(md+ gl ab 'c) ==> ,rt)
           (and-intro (,gl2 ==> ,rt) (assumption (,gl2 ==> a))
             (and-intro (,gl2 ==> ,bc) (assumption (,gl2 ==> b)) (assumption (,gl2 ==> c))))))
       (and-elim (,gr ==> ,lf)
         (and-elim (,(md+ gr 'a bc) ==> ,lf)
           (and-intro (,gr2 ==> ,lf)
             (and-intro (,gr2 ==> ,ab) (assumption (,gr2 ==> a)) (assumption (,gr2 ==> b)))
             (assumption (,gr2 ==> c)))))))
  (md-close!))
(qed 'der-and-assoc)

;; FALSITY or f  iff  f;  TRUTH and f  iff  f
(sp (make-wff '(FORALL tt (FORALL g (FORALL f (IMPLIES (IN g CTX-SET) (IMPLIES (IN f CLF)
   (IN (LIST g (ENC-IFF (ENC-OR ENC-FALSITY f) f)) (DERIVABLE tt)))))))))
(dk-peel!)
(let* ((lf '(ENC-OR ENC-FALSITY f)) (gl (md+ 'g lf)) (g0 (md+ gl 'ENC-FALSITY)))
  (dk-meta-derive! 'tt
    `(iff-intro (g ==> (ENC-IFF ,lf f))
       (or-elim (,gl ==> f)
         (contradiction (,g0 ==> f) (assumption (,(md+ g0 '(ENC-NOT f)) ==> ENC-FALSITY)))
         (assumption (,(md+ gl 'f) ==> f)))
       (or-intro-right (,(md+ 'g 'f) ==> ,lf) (assumption (,(md+ 'g 'f) ==> f)))))
  (md-close!))
(qed 'der-or-falsity)
(sp (make-wff '(FORALL tt (FORALL g (FORALL f (IMPLIES (IN g CTX-SET) (IMPLIES (IN f CLF)
   (IN (LIST g (ENC-IFF (ENC-AND ENC-TRUTH f) f)) (DERIVABLE tt)))))))))
(dk-peel!)
(let* ((lf '(ENC-AND ENC-TRUTH f)) (gl (md+ 'g lf)) (gf (md+ 'g 'f)))
  (fact 'clf-truth)
  (dk-meta-set-of! 'ENC-TRUTH 'CLF)
  (dk-meta-derive! 'tt
    `(iff-intro (g ==> (ENC-IFF ,lf f))
       (and-elim (,gl ==> f) (assumption (,(md+ gl 'ENC-TRUTH 'f) ==> f)))
       (and-intro (,gf ==> ,lf) (truth-intro (,gf ==> ENC-TRUTH)) (assumption (,gf ==> f)))))
  (md-close!))
(qed 'der-and-truth)

;; the least set of right folds
(sp (make-wff '(FORALL md14h_ (FORALL md14x_ (FORALL md14l_ (== (RF-SET md14h_ md14x_ md14l_)
   (SEP md14p_ (CARTESIAN NN EXPR-SET) (FORALL md14w_ (IMPLIES (IN md14w_ (POWER (CARTESIAN NN EXPR-SET)))
      (IMPLIES (RF-CLOSED md14h_ md14x_ md14l_ md14w_) (IN md14p_ md14w_)))))))))))
(dk-peel!) (mac 'RF-SET) (qrfl)
(qed 'rf-set-unfold)
(sp (make-wff '(FORALL h (FORALL x (FORALL l (FORALL md14xs_ (IMPLIES (IN md14xs_ (POWER (CARTESIAN NN EXPR-SET)))
   (IMPLIES (RF-CLOSED h x l md14xs_) (FORALL z (IMPLIES (IN z (RF-SET h x l)) (IN z md14xs_)))))))))))
(dk-peel!)
(let* ((m (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'RF-SET))) (dk-asms)))
       (landed (dk-landed (lambda () (sep-me (dk-rewrite-h! m '(RF-SET h x l) (caddr (dk-cite! 'rf-set-unfold 'h 'x 'l)))))))
       (u (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
  (dk-apply! u 'md14xs_)
  (ass))
(qed 'rf-set-least)

;; XS = (SEP v (CARTESIAN NN EXPR-SET) cond): land (IN XS (POWER (CARTESIAN NN EXPR-SET)))
(define (md14-sep-power-cart! xs)
  (let ((cc '(CARTESIAN NN EXPR-SET)))
    (if (not (dk-asm? `(IN ,cc SET)))
        (begin
          (fact 'expr-set-is-set) (fact 'nn-is-set)
          (let ((iff (dk-meta-iff! 'cartesian-set-iff 'NN 'EXPR-SET)))
            (dk-meta-and! '(IN NN SET) '(IN EXPR-SET SET))
            (dk-meta-iff-l! iff))))
    (dk-have! `(IN ,xs SET) (lambda () (sep-set) (ass)))
    (let* ((iff (dk-meta-iff! 'power-set-membership cc xs))
           (inc `(FORALL md14vz_ (IMPLIES (IN md14vz_ ,xs) (IN md14vz_ ,cc)))))
      (dk-have! inc
        (lambda ()
          (dk-peel!)
          (sep-me (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) xs))) (dk-asms)))
          (ass)))
      (dk-meta-and! `(IN ,xs SET) inc)
      (dk-meta-iff-l! iff)
      `(IN ,xs (POWER ,cc)))))

(define md14-msu '(FORALL mczu_ (IMPLIES (IN mczu_ (MAKE-SET l)) (IN mczu_ CLT))))
;; THE RIGHT FOLD AGAINST THE LEFT FOLD.  [j, f] a right fold: j + 1 <= |l| and REC(|l|) iff CONN(REC(j), f), REC the
;; core's left fold (ENC-ORL / ENC-ANDL) and CONN its connective.  The set of the pairs with that property is closed
;; under the base (both sides are REC(j + 1)) and the step (associativity, transitivity).
(define (md14-rf! h rec conn conn-intro conn-elim assoc succ-law clf-law unfold name)
  (sp (make-wff `(FORALL tt (FORALL g (FORALL x (FORALL l (FORALL j (FORALL f
     (IMPLIES (IN g CTX-SET) (IMPLIES (IN x CLT) (IMPLIES (IN l (TUPLES EXPR-SET)) (IMPLIES ,md14-msu
     (IMPLIES (IN (LIST j f) (RF-SET ,h x l))
       (AND (<= (succ j) (LENGTH l))
            (IN (LIST g (ENC-IFF (,rec x l (LENGTH l)) (,conn (,rec x l j) f))) (DERIVABLE tt))))))))))))))))
  (dk-peel!)
  (let* ((top `(,rec x l (LENGTH l)))
         (claim (lambda (jj ff) `(AND (<= (succ ,jj) (LENGTH l)) (IN (LIST g (ENC-IFF ,top (,conn (,rec x l ,jj) ,ff))) (DERIVABLE tt)))))
         (xs `(SEP md14vp_ (CARTESIAN NN EXPR-SET) ,(claim '(NTH 1 md14vp_) '(NTH 2 md14vp_))))
         (u (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'MAKE-SET))) (dk-asms)))
         ;; the entry l_(succ k) in CLT and the atom x in it in CLF, k in NN and succ k <= |l| in context
         (atom! (lambda (k)
                  (let ((e `(NTH (succ ,k) l)))
                    (fact 'nn-succ-closed k)
                    (dk-have! `(<= 1 (succ ,k)) (lambda () (dk-nn!)))
                    (dk-have! `(IN ,e (MAKE-SET l)) (lambda () (dk-meta-in-makeset! `(succ ,k) 'l 'EXPR-SET)))
                    (dk-apply! u e)
                    (dk-cite! 'clf-in-intro 'x e)
                    `(ENC-IN x ,e))))
         (fold! (lambda (k) (dk-apply! (dk-cite! clf-law k) 'x 'l) `(,rec x l ,k))))
    (fact 'length-in-nn 'EXPR-SET 'l)
    (md14-sep-power-cart! xs)
    (dk-have! `(RF-CLOSED ,h x l ,xs)
      (lambda ()
        (mac 'RF-CLOSED)
        (dk-conj-close!
          (lambda ()
            (if (dk-contains? (dk-goal) '=)
                ;; the base: [j, x in l_(j+1)] with j + 1 = |l|
                (let* ((landed (dk-peel!))
                       (jv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed)))
                       (eq1 `(= (succ ,jv) (LENGTH l))))
                  (dk-have! `(<= (succ ,jv) (LENGTH l)) (lambda () (dk-nn! eq1)))
                  (dk-have! `(<= ,jv (LENGTH l)) (lambda () (dk-nn! eq1)))
                  (let* ((a (atom! jv)) (rj (fold! jv)) (oa `(,conn ,rj ,a)))
                    (md-expr-of! a 'CLF)
                    (dk-cite! conn-intro rj a)
                    (dk-cite! 'der-iff-refl 'tt 'g oa)
                    (in-sep! (lambda () (dk-meta-close-in!))
                             (lambda ()
                               (nth-r)
                               (dk-conj-close!
                                 (lambda ()
                                   (if (dk-head-is? (dk-goal) '<=) (ass)
                                       (begin (subst `(= (LENGTH l) (succ ,jv)))
                                              (subst (dk-cite! succ-law 'x 'l jv))
                                              (ass)))))))))
                ;; the step: from [k + 1, f] to [k, conn(x in l_(k+1), f)]
                (let* ((landed (dk-peel!))
                       (kv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed)))
                       (mem (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) xs))) landed))
                       (fv (caddr (cadr mem)))
                       (cl (dk-nth-h! (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f `(NTH 1 ,(cadr mem)))))
                                                  (dk-landed (lambda () (sep-me mem)))))))
                  (dk-split! cl)
                  (dk-have! `(<= (succ ,kv) (LENGTH l)) (lambda () (dk-nn! `(<= (succ (succ ,kv)) (LENGTH l)))))
                  (dk-have! `(<= ,kv (LENGTH l)) (lambda () (dk-nn! `(<= (succ (succ ,kv)) (LENGTH l)))))
                  (let* ((a (atom! kv)) (rk (fold! kv)) (rsk `(,rec x l (succ ,kv)))
                         (d0 (md14-iff 'g top `(,conn ,rsk ,fv)))
                         (cf `(EAPP ,h (LIST ,a ,fv))) (af `(,conn ,a ,fv)))
                    (md12-seq-of! 'g `(ENC-IFF ,top (,conn ,rsk ,fv)))
                    (dk-split! (dk-cite! 'clf-iff-elim top `(,conn ,rsk ,fv)))
                    (dk-split! (dk-cite! conn-elim rsk fv))
                    (let* ((d1 (dk-rewrite-h! d0 rsk (caddr (dk-cite! succ-law 'x 'l kv)))))
                      (dk-cite! assoc 'tt 'g rk a fv)
                      (dk-cite! 'der-iff-trans 'tt 'g top `(,conn (,conn ,rk ,a) ,fv) `(,conn ,rk ,af))
                      (dk-cite! conn-intro a fv)
                      (let* ((un (dk-cite! unfold a fv)))
                        (dk-rewrite-h! (md14-iff 'g top `(,conn ,rk ,af)) af cf)
                        (dk-rewrite-h! `(IN ,af CLF) af cf)
                        (md-expr-of! cf 'CLF)
                        (in-sep! (lambda () (dk-meta-close-in!))
                                 (lambda ()
                                   (nth-r)
                                   (dk-conj-close! (lambda () (ass))))))))))))))
    (dk-apply! (dk-cite! 'rf-set-least h 'x 'l xs) '(LIST j f))
    (let ((cl (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f '(NTH 1 (LIST j f)))))
                          (dk-landed (lambda () (sep-me `(IN (LIST j f) ,xs)))))))
      (dk-nth-h! cl)
      (ass)))
  (qed name))
(md14-rf! 4 'ENC-ORL 'ENC-OR 'clf-or-intro 'clf-or-elim 'der-or-assoc 'enc-orl-succ 'orl-clf 'enc-or-unfold 'rf-orl)
(md14-rf! 3 'ENC-ANDL 'ENC-AND 'clf-and-intro 'clf-and-elim 'der-and-assoc 'enc-andl-succ 'enc-andl-clf 'enc-and-unfold 'rf-andl)

;; EVERY INSTANCE OF THE TWO SCHEMAS IS DERIVABLE OVER THE CORE: the core's membership schema, the right fold
;; against the left fold at j = 0, the unit of the connective.
(define (md14-dec! enc-op elim-law mem-rule rec conn unit unit-law zero-law fold-law clf-law h name)
  (sp (make-wff `(FORALL tt (FORALL g (FORALL x (FORALL l (FORALL f (IMPLIES (IN g CTX-SET)
     (IMPLIES (IN (ENC-IN x (,enc-op l)) CLF) (IMPLIES (IN (LIST 0 f) (RF-SET ,h x l))
       (IN (LIST g (ENC-IFF (ENC-IN x (,enc-op l)) f)) (DERIVABLE tt))))))))))))
  (dk-peel!)
  (let* ((uu `(ENC-IN x (,enc-op l))) (top `(,rec x l (LENGTH l))) (ff `(ENC-IFF ,uu ,top))
         (r0 `(,conn (,rec x l 0) f)) (u0 `(,conn ,unit f)))
    (dk-split! (dk-cite! 'clf-in-elim 'x `(,enc-op l)))
    (dk-split! (dk-cite! elim-law 'l))
    (fact 'length-in-nn 'EXPR-SET 'l)
    (dk-have! '(<= (LENGTH l) (LENGTH l)) (lambda () (dk-nn!)))
    (dk-apply! (dk-cite! clf-law '(LENGTH l)) 'x 'l)
    (dk-cite! 'clf-iff-intro uu top)
    (dk-split! (dk-cite! fold-law 'tt 'g 'x 'l 0 'f))
    (dk-have! '(<= 1 (LENGTH l)) (lambda () (dk-nn! '(<= (succ 0) (LENGTH l)))))
    (dk-meta-derive! 'tt `(,mem-rule (g ==> ,ff)))
    (let ((d (dk-rewrite-h! (md14-iff 'g top r0) `(,rec x l 0) (caddr (dk-cite! zero-law 'x 'l)))))
      (md12-seq-of! 'g `(ENC-IFF ,top ,u0))
      (dk-split! (dk-cite! 'clf-iff-elim top u0))
      (dk-split! (dk-cite! (if (eq? conn 'ENC-OR) 'clf-or-elim 'clf-and-elim) unit 'f))
      (dk-cite! unit-law 'tt 'g 'f)
      (dk-cite! 'der-iff-trans 'tt 'g top u0 'f)
      (dk-cite! 'der-iff-trans 'tt 'g uu top 'f)
      (md-close!)))
  (qed name))
(md14-dec! 'ENC-UNION 'clt-union-elim 'union-mem 'ENC-ORL 'ENC-OR 'ENC-FALSITY 'der-or-falsity 'enc-orl-zero 'rf-orl 'orl-clf 4
           'der-union-decompose)
(md14-dec! 'ENC-INTER 'clt-inter-elim 'intersection-mem 'ENC-ANDL 'ENC-AND 'ENC-TRUTH 'der-and-truth 'enc-andl-zero 'rf-andl 'enc-andl-clf 3
           'der-intersection-decompose)

;; THE LOCAL REDEXES of the two schemas are inside EQV(T), for every T
(define (md14-jsub! jname enc-op dec name)
  (sp (make-wff `(FORALL tt (SUBSET (,jname tt) (EQV tt)))))
  (di)
  (mac jname)
  (mac 'subset-def)
  (dk-peel!)
  (let* ((mm (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) (dk-asms)))
         (y (cadr mm))
         (landed (dk-landed (lambda () (sep-me mm))))
         (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) landed))
         (vs (dk-meta-unpack! ex))
         (g (car vs)) (x (cadr vs)) (l (caddr vs)) (f (cadddr vs))
         (uu `(ENC-IN ,x (,enc-op ,l))) (lit `(LIST 2 ,g ,uu ,f)))
    (dk-split-all!)
    (if (not (dk-asm? `(= ,y ,lit))) (error "md14-jsub!: the redex tuple is not" (expression->string lit)))
    (dk-rewrite-h! `(IN ,y RW-UNIV) y lit)
    (dk-cite! 'rw-univ-ctx 2 g uu f)
    (dk-cite! dec 'tt g x l f)
    (subst `(= ,y ,lit))
    (dk-cite! 'eqv-f-intro 'tt g uu f)
    (ass))
  (qed name))
(md14-jsub! 'J-UDEC 'ENC-UNION 'der-union-decompose 'j-udec-sub)
(md14-jsub! 'J-IDEC 'ENC-INTER 'der-intersection-decompose 'j-idec-sub)

(define (md14-adm! rel j jsub generic t-hyps?)
  (sp (make-wff `(FORALL tt (FORALL hs (FORALL c
       ,(let ((core `(IMPLIES (,rel tt hs c) (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt))))))
          (if t-hyps? `(IMPLIES (SUBSET tt CLF) (IMPLIES (IN AX-CLASS-EXT tt) ,core)) core)))))))
  (dk-peel!)
  (mac-h rel `(,rel tt hs c))
  (dk-cite! jsub 'tt)
  (dk-cite! generic 'tt `(,j tt) 'hs 'c)
  (ass))
(md14-adm! 'REL-UNION-DECOMPOSE-1 'J-UDEC 'j-udec-sub 'adm-rewrite-1 #f)
(qed 'adm-union-decompose-1)
