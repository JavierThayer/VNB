;;; 5.1 Inversion: the parts of a closed term that the walk reaches are closed terms.

;; an argument of an application that is a closed term is a closed term (a term head is >= 11, and its
;; arguments are terms: HD-ARGK; a head <= 6 makes a formula, HD-RES, which is no term)
(sp (make-wff '(FORALL h (FORALL l (FORALL i (IMPLIES (IN (EAPP h l) CLT) (IMPLIES (IN i NN) (IMPLIES (<= 1 i)
   (IMPLIES (<= i (LENGTH l)) (IN (NTH i l) CLT))))))))))
(dk-peel!)
(dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! 'clt-iff '(EAPP h l)))))
(dk-split! (dk-cite! 'eapp-expr-inv 'h 'l))
(dk-meta-iff-r! (dk-meta-iff! 'wf-term '(EAPP h l)))
(dk-have! '(IN 1 NN) (lambda () (arith)))
(let* ((kparts (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! 'wks-eapp-iff 'h 'l 1)))))
       (u1 (find-first (lambda (f) (dk-head-is? f 'FORALL)) kparts))
       (u2 (dk-meta-iff-r! (dk-meta-iff! 'lc-eapp-iff 'h 'l)))
       (w '(NTH i l)))
  (dk-meta-nth-in! 'EXPR-SET 'i 'l)
  (dk-have! `(IN ,w (MAKE-SET l)) (lambda () (dk-meta-in-makeset! 'i 'l 'EXPR-SET)))
  (dk-apply! u1 w)
  (dk-apply! u2 w)
  (use-em '(<= h 6)
    (lambda ()
      (dk-have! '(= (HD-RES h) 2)
        (lambda () (mac 'HD-RES) (dk-if-branch! #t (cadr (dk-goal)) (lambda () (dk-nn! '(<= h 6))) (lambda () (rfl)))))
      (dk-have! '(= 1 2) (lambda () (subst '(= 2 (HD-RES h))) (ass)))
      (dk-have! '(NOT (= 1 2)) (lambda () (arith)))
      (ai '(NOT (= 1 2))))
    (lambda ()
      (dk-have! '(= (HD-ARGK h) 1)
        (lambda () (mac 'HD-ARGK) (dk-if-branch! #f (cadr (dk-goal)) (lambda () (ass)) (lambda () (rfl)))))
      (dk-rewrite-h! `(IN (HD-ARGK h) (EXPR-WKS ,w)) '(HD-ARGK h) 1)
      (dk-meta-iff-l! (dk-meta-iff! 'wf-term w))
      (let ((iff (dk-meta-iff! 'clt-iff w)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (ass)))))
        (dk-meta-iff-l! iff)
        (ass)))))
(qed 'clt-eapp-arg)

;; the outside argument of a one-argument binder node that is a closed term is a closed term
;; (wks-ebind: the outside arguments have kind 1; lcd-ebind: they are closed at the binder's depth)
(define (md-ebind-parts! e)              ; e = (EBIND h nb oa b) in CLT in context: its WKS and LCD conjuncts
  (let ((h (cadr e)) (nb (caddr e)) (oa (cadddr e)) (b (car (cddddr e))))
    (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! 'clt-iff e))))
    (dk-cite! 'ebind-body-expr h nb oa b)
    (dk-cite! 'ebind-args-expr h nb oa b)
    (dk-meta-iff-r! (dk-meta-iff! 'wf-term e))
    (dk-meta-iff-r! (dk-meta-iff! 'expr-lc e))
    (sep-me (dk-rewrite-h! `(IN 1 (EXPR-WKS ,e)) `(EXPR-WKS ,e) (caddr (dk-cite! 'wks-ebind h nb oa b))))
    (sep-me (dk-rewrite-h! `(IN 0 (EXPR-LCD ,e)) `(EXPR-LCD ,e) (caddr (dk-cite! 'lcd-ebind h nb oa b))))
    (dk-split-all!)))
(sp (make-wff '(FORALL h (FORALL a (FORALL b (IMPLIES (IN h NN) (IMPLIES (IN (EBIND h 1 (LIST a) b) CLT) (IN a CLT))))))))
(dk-peel!)
(dk-have! '(IN 1 NN) (lambda () (arith)))
(fact 'nn-zero-in)
(md-ebind-parts! '(EBIND h 1 (LIST a) b))
(dk-have! '(<= 1 1) (lambda () (arith)))
(dk-have! '(<= 1 (LENGTH (LIST a))) (lambda () (len-r) (arith)))
(dk-have! '(IN (NTH 1 (LIST a)) (MAKE-SET (LIST a))) (lambda () (dk-meta-in-makeset! 1 '(LIST a) 'EXPR-SET)))
(dk-nth-h! '(IN (NTH 1 (LIST a)) (MAKE-SET (LIST a))))
(for-each (lambda (u) (dk-apply! u 'a))
          (filter (lambda (f) (and (dk-head-is? f 'FORALL) (dk-head-is? (caddr f) 'IMPLIES)
                                   (equal? (cadr (caddr f)) `(IN ,(cadr f) (MAKE-SET (LIST a))))))
                  (dk-asms)))
(dk-meta-nth-in! 'EXPR-SET 1 '(LIST a))
(dk-nth-h! '(IN (NTH 1 (LIST a)) EXPR-SET))
(dk-meta-iff-l! (dk-meta-iff! 'wf-term 'a))
(dk-meta-iff-l! (dk-meta-iff! 'expr-lc 'a))
(let ((iff (dk-meta-iff! 'clt-iff 'a)))
  (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (ass)))))
  (dk-meta-iff-l! iff)
  (ass))
(qed 'clt-ebind-dom)

;; the condition of a SEP read at a closed term is a sentence when the membership is one
(sp (make-wff '(FORALL y (FORALL d (FORALL p (IMPLIES (IN (ENC-IN y (ENC-SEP d p)) CLF) (IN (EXPR-OPEN p 0 y) CLF)))))))
(dk-peel!)
(dk-split! (dk-cite! 'clf-in-elim 'y '(ENC-SEP d p)))
(let* ((eb '(EBIND 22 1 (LIST d) p)) (op '(EXPR-OPEN p 0 y)))
  (dk-rewrite-h! '(IN (ENC-SEP d p) CLT) '(ENC-SEP d p) (caddr (dk-cite! 'enc-sep-unfold 'd 'p)))
  (dk-have! '(IN 22 NN) (lambda () (arith)))
  (dk-have! '(IN 1 NN) (lambda () (arith)))
  (fact 'nn-zero-in)
  (md-ebind-parts! eb)
  (dk-have! '(= (HD-BODY 22) 2)
    (lambda () (mac 'HD-BODY) (dk-if-branch! #f (cadr (dk-goal)) (lambda () (arith)) (lambda () (rfl)))))
  (dk-rewrite-h! '(IN (HD-BODY 22) (EXPR-WKS p)) '(HD-BODY 22) 2)
  (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! 'clt-iff 'y))))
  (dk-meta-iff-r! (dk-meta-iff! 'wf-term 'y))
  (dk-meta-iff-r! (dk-meta-iff! 'expr-lc 'y))
  (dk-cite! 'wks-single 'y)
  (let ((weq (dk-cite! 'wks-open 'y 'p 0)))
    (fact 'open-in-expr 'y 0 'p)
    (dk-have! `(IN 2 (EXPR-WKS ,op)) (lambda () (subst weq) (ass))))
  (dk-cite! 'lcd-open-closes 'y 'p 0)
  (dk-meta-iff-l! (dk-meta-iff! 'wf-fml op))
  (dk-meta-iff-l! (dk-meta-iff! 'expr-lc op))
  (let ((iff (dk-meta-iff! 'clf-iff op)))
    (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (ass)))))
    (dk-meta-iff-l! iff)
    (ass)))
(qed 'clf-sep-open)

;;; 5.2 The walk below an atom: the least sets, and their closure under the derivable definedness.

(sp (make-wff '(FORALL md7e_ (== (STRICT-REACH md7e_) (SEP md7z_ EXPR-SET (FORALL md7w_ (IMPLIES (IN md7w_ (POWER EXPR-SET))
   (IMPLIES (IN md7e_ md7w_) (IMPLIES (STRICT-CLOSED md7w_) (IN md7z_ md7w_))))))))))
(di) (mac 'STRICT-REACH) (qrfl)
(qed 'strict-reach-unfold)
(sp (make-wff '(FORALL md7j_ (== (TRUE-REACH md7j_) (SEP md7zz_ EXPR-SET (FORALL md7ww_ (IMPLIES (IN md7ww_ (POWER EXPR-SET))
   (IMPLIES (IN md7j_ md7ww_) (IMPLIES (TRUE-CLOSED md7ww_) (IN md7zz_ md7ww_))))))))))
(di) (mac 'TRUE-REACH) (qrfl)
(qed 'true-reach-unfold)

;; the reach is below every closed subset of EXPR-SET holding the start
(define (md-least! reach closed unfold name)
  (sp (make-wff `(FORALL e (FORALL md7xs_ (IMPLIES (IN md7xs_ (POWER EXPR-SET)) (IMPLIES (IN e md7xs_)
     (IMPLIES (,closed md7xs_) (FORALL x (IMPLIES (IN x (,reach e)) (IN x md7xs_))))))))))
  (dk-peel!)
  (let* ((m (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) reach))) (dk-asms)))
         (landed (dk-landed (lambda () (sep-me (dk-rewrite-h! m `(,reach e) (caddr (dk-cite! unfold 'e)))))))
         (u (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
    (dk-apply! u 'md7xs_)
    (ass))
  (qed name))
(md-least! 'STRICT-REACH 'STRICT-CLOSED 'strict-reach-unfold 'strict-reach-least)
(md-least! 'TRUE-REACH 'TRUE-CLOSED 'true-reach-unfold 'true-reach-least)

;; XS = (SEP v EXPR-SET cond) in context-free form: land (IN XS (POWER EXPR-SET))
(define (md-sep-power! xs)
  (fact 'expr-set-is-set)
  (dk-have! `(IN ,xs SET) (lambda () (sep-set) (ass)))
  (let* ((iff (dk-meta-iff! 'power-set-membership 'EXPR-SET xs))
         (inc `(FORALL md7vz_ (IMPLIES (IN md7vz_ ,xs) (IN md7vz_ EXPR-SET)))))
    (dk-have! inc
      (lambda ()
        (dk-peel!)
        (sep-me (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) xs))) (dk-asms)))
        (ass)))
    (dk-meta-and! `(IN ,xs SET) inc)
    (dk-meta-iff-l! iff)
    `(IN ,xs (POWER EXPR-SET))))

;; e in CLT (or CLF) in context: land e in EXPR-SET
(define (md-expr-of! e cls)
  (if (not (dk-asm? `(IN ,e EXPR-SET)))
      (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! (if (eq? cls 'CLF) 'clf-iff 'clt-iff) e))))))

;; THE STRICT WALK.  [g, s = s] derivable and t reached from s by strict steps: [g, t = t] derivable.
;; The set of the expressions u with [g, u = u] derivable is closed under a strict step: at an argument by
;; CR-DEF-STRICT-ARG, at a binder's domain by CR-DEF-STRICT-DOM (the argument, the domain, is a closed term
;; by clt-eapp-arg / clt-ebind-dom, so the conclusion is a sequent).
(sp (make-wff '(FORALL tt (FORALL g (FORALL s (FORALL x (IMPLIES (IN (LIST g (ENC-EQ s s)) (DERIVABLE tt))
   (IMPLIES (IN x (STRICT-REACH s)) (IN (LIST g (ENC-EQ x x)) (DERIVABLE tt))))))))))
(dk-peel!)
(let ((xs '(SEP md7vu_ EXPR-SET (IN (LIST g (ENC-EQ md7vu_ md7vu_)) (DERIVABLE tt)))))
  (md-sep-power! xs)
  (dk-cite! 'der-in-seq 'tt '(LIST g (ENC-EQ s s)))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'g '(ENC-EQ s s))))
  (dk-split! (dk-cite! 'clf-eq-elim 's 's))
  (md-expr-of! 's 'CLT)
  (dk-have! `(IN s ,xs) (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))
  (dk-have! `(STRICT-CLOSED ,xs)
    (lambda ()
      (mac 'STRICT-CLOSED)
      (let* ((landed (dk-peel!))
             (st (find-first (lambda (f) (dk-head-is? f 'STRICT-STEP)) landed))
             (p (cadr st)) (q (caddr st)) (dp `(LIST g (ENC-EQ ,p ,p))))
        (sep-me `(IN ,p ,xs))
        (dk-cite! 'der-in-seq 'tt dp)
        (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'g `(ENC-EQ ,p ,p))))
        (dk-split! (dk-cite! 'clf-eq-elim p p))
        (dk-meta-or-each! (dk-landed-1 (lambda () (mac-h 'strict-step st)))
          (lambda (d)
            (let ((vs (dk-meta-unpack! d)))
              (if (dk-contains? d 'EAPP)
                  ;; down a strict constructor
                  (let* ((h (car vs)) (l (cadr vs)) (i (caddr vs)) (e `(EAPP ,h ,l)) (nt `(NTH ,i ,l)))
                    (subst `(= ,q ,nt))
                    (dk-rewrite-h! `(IN ,p CLT) p e)
                    (dk-rewrite-h! `(IN ,dp (DERIVABLE tt)) p e)
                    (dk-cite! 'clt-eapp-arg h l i)
                    (dk-cite! 'clf-eq-intro nt nt)
                    (dk-meta-derive! 'tt `(def-strict-arg (g ==> (ENC-EQ ,nt ,nt)) (given (g ==> (ENC-EQ ,e ,e)))))
                    (md-expr-of! nt 'CLT)
                    (in-sep! (lambda () (ass)) (lambda () (ass))))
                  ;; into a binder's domain
                  (let* ((k (car vs)) (a (cadr vs)) (b (caddr vs)) (e `(EBIND ,k 1 (LIST ,a) ,b))
                         (o (find-first (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f k))) (dk-asms))))
                    (subst `(= ,q ,a))
                    (dk-have! `(IN ,k NN) (lambda () (dk-meta-or-each! o (lambda (dj) (subst dj) (arith)))))
                    (dk-rewrite-h! `(IN ,p CLT) p e)
                    (dk-rewrite-h! `(IN ,dp (DERIVABLE tt)) p e)
                    (dk-cite! 'clt-ebind-dom k a b)
                    (dk-cite! 'clf-eq-intro a a)
                    (dk-meta-derive! 'tt `(def-strict-dom (g ==> (ENC-EQ ,a ,a)) (given (g ==> (ENC-EQ ,e ,e)))))
                    (md-expr-of! a 'CLT)
                    (in-sep! (lambda () (ass)) (lambda () (ass)))))))))))
  (dk-apply! (dk-cite! 'strict-reach-least 's xs) 'x)
  (sep-me `(IN x ,xs))
  (ass))
(qed 'adm-strict-walk)

;; THE SENTENCES MADE TRUE.  [g, f] derivable and f2 reached from f by steps of truth: [g, f2] derivable.
;; A conjunct by cut and and-elim; P[x := y] from y in SEP x D. P by sep-mem, iff-elim (der-iff-r) and
;; and-elim (the condition is a sentence by clf-sep-open, the domain a closed term by clt-ebind-dom).
(sp (make-wff '(FORALL tt (FORALL g (FORALL f (FORALL x (IMPLIES (IN (LIST g f) (DERIVABLE tt))
   (IMPLIES (IN x (TRUE-REACH f)) (IN (LIST g x) (DERIVABLE tt))))))))))
(dk-peel!)
(let ((xs '(SEP md7vf_ EXPR-SET (IN (LIST g md7vf_) (DERIVABLE tt)))))
  (md-sep-power! xs)
  (dk-cite! 'der-in-seq 'tt '(LIST g f))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'g 'f)))
  (md-expr-of! 'f 'CLF)
  (dk-have! `(IN f ,xs) (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))
  (dk-have! `(TRUE-CLOSED ,xs)
    (lambda ()
      (mac 'TRUE-CLOSED)
      (let* ((landed (dk-peel!))
             (st (find-first (lambda (f) (dk-head-is? f 'TRUE-STEP)) landed))
             (m (cadr st)) (n (caddr st)) (dm `(LIST g ,m)))
        (sep-me `(IN ,m ,xs))
        (dk-cite! 'der-in-seq 'tt dm)
        (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'g m)))
        (dk-meta-or-each! (dk-landed-1 (lambda () (mac-h 'true-step st)))
          (lambda (d)
            (let ((vs (dk-meta-unpack! d)))
              (if (dk-contains? d 'ENC-AND)
                  ;; a conjunct
                  (let* ((c (car vs)) (e (cadr vs)) (ce `(ENC-AND ,c ,e)) (g1 (md+ 'g ce))
                         (o (find-first (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f n))) (dk-asms))))
                    (dk-rewrite-h! `(IN ,m CLF) m ce)
                    (dk-rewrite-h! `(IN ,dm (DERIVABLE tt)) m ce)
                    (dk-split! (dk-cite! 'clf-and-elim c e))
                    (for-each
                      (lambda (part)
                        (dk-meta-derive! 'tt `(cut (g ==> ,part) (given (g ==> ,ce))
                                               (and-elim (,g1 ==> ,part) (assumption (,(md+ g1 c e) ==> ,part)))))
                        (md-expr-of! part 'CLF))
                      (list c e))
                    (dk-meta-or-each! o
                      (lambda (dj) (subst dj) (in-sep! (lambda () (ass)) (lambda () (ass))))))
                  ;; a SEP condition read at the member
                  (let* ((y (car vs)) (dd (cadr vs)) (r (caddr vs)) (sp1 `(ENC-SEP ,dd ,r))
                         (uu `(ENC-IN ,y ,sp1)) (ia `(ENC-IN ,y ,dd)) (op `(EXPR-OPEN ,r 0 ,y))
                         (rr `(ENC-AND ,ia ,op)) (ff `(ENC-IFF ,uu ,rr)) (g1 (md+ 'g rr)))
                    (subst `(= ,n ,op))
                    (dk-rewrite-h! `(IN ,m CLF) m uu)
                    (dk-rewrite-h! `(IN ,dm (DERIVABLE tt)) m uu)
                    (dk-cite! 'clf-sep-open y dd r)
                    (dk-split! (dk-cite! 'clf-in-elim y sp1))
                    (dk-have! '(IN 22 NN) (lambda () (arith)))
                    (dk-rewrite-h! `(IN ,sp1 CLT) sp1 (caddr (dk-cite! 'enc-sep-unfold dd r)))
                    (dk-cite! 'clt-ebind-dom 22 dd r)
                    (dk-cite! 'clf-in-intro y dd)
                    (dk-cite! 'clf-and-intro ia op)
                    (dk-cite! 'clf-iff-intro uu rr)
                    (dk-meta-derive! 'tt
                      `(cut (g ==> ,op)
                         (lemma (g ==> ,rr) der-iff-r (g ,uu ,rr)
                           (sep-mem (g ==> ,ff))
                           (given (g ==> ,uu)))
                         (and-elim (,g1 ==> ,op) (assumption (,(md+ g1 ia op) ==> ,op)))))
                    (md-expr-of! op 'CLF)
                    (in-sep! (lambda () (ass)) (lambda () (ass)))))))))))
  (dk-apply! (dk-cite! 'true-reach-least 'f xs) 'x)
  (sep-me `(IN x ,xs))
  (ass))
(qed 'adm-true-walk)

;;; 5.3 The atom: both sides of a derivable IN or = denote (CR-DEF-STRICT-IN-L/R; adm-def-strict-eq-l/r),
;;; and so does every term below a side (adm-strict-walk).

;; DEF-X(tt, [[g, atom]], c) closed and its derived admissibility LAW cited: c derivable
(define (md-def-one! rel law c atom ws)
  (let ((hs `(LIST (LIST g ,atom))))
    (dk-meta-seq! 'g (caddr c))
    (md-rel-close! rel hs c ws)
    (dk-have! `(HYPS-IN ,hs (DERIVABLE tt)) (lambda () (fact 'hyps-in-1 `(LIST g ,atom) '(DERIVABLE tt)) (ass)))
    (dk-cite! law 'tt hs c)))
(sp (make-wff '(FORALL tt (FORALL g (FORALL f (FORALL w (IMPLIES (IN (LIST g f) (DERIVABLE tt))
   (IMPLIES (STRICT-ATOM f w) (IN (LIST g (ENC-EQ w w)) (DERIVABLE tt))))))))))
(dk-peel!)
(let* ((vs (dk-meta-unpack! (dk-landed-1 (lambda () (mac-h 'strict-atom '(STRICT-ATOM f w))))))
       (x (car vs)) (a (cadr vs))
       (o1 (find-first (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f 'ENC-IN))) (dk-asms)))
       (o2 (find-first (lambda (f) (and (dk-head-is? f 'OR) (dk-contains? f 'STRICT-REACH))) (dk-asms))))
  (dk-cite! 'der-in-seq 'tt '(LIST g f))
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff 'g 'f)))
  (dk-meta-or-each! o1
    (lambda (dj)
      (let ((atom (caddr dj)) (xx `(LIST g (ENC-EQ ,x ,x))) (aa `(LIST g (ENC-EQ ,a ,a))))
        (dk-rewrite-h! '(IN f CLF) 'f atom)
        (dk-rewrite-h! '(IN (LIST g f) (DERIVABLE tt)) 'f atom)
        (dk-split! (dk-cite! (if (dk-head-is? atom 'ENC-IN) 'clf-in-elim 'clf-eq-elim) x a))
        (dk-cite! 'clf-eq-intro x x)
        (dk-cite! 'clf-eq-intro a a)
        (if (dk-head-is? atom 'ENC-IN)
            (begin
              (dk-meta-derive! 'tt `(def-strict-in-l (g ==> (ENC-EQ ,x ,x)) (given (g ==> ,atom))))
              (dk-meta-derive! 'tt `(def-strict-in-r (g ==> (ENC-EQ ,a ,a)) (given (g ==> ,atom)))))
            (begin
              (md-def-one! 'DEF-STRICT-EQ-L 'adm-def-strict-eq-l xx atom (list 'g x a))
              (md-def-one! 'DEF-STRICT-EQ-R 'adm-def-strict-eq-r aa atom (list 'g x a))))
        (dk-meta-or-each! o2
          (lambda (dk)
            (dk-cite! 'adm-strict-walk 'tt 'g (cadr (caddr dk)) 'w)
            (ass)))))))
(qed 'adm-strict-atom)

;;; 5.4 THE R4 STRICT-HYPOTHESIS CLAUSE (DEF-STRICT-HYP, meta-def.scm section 5) is admissible over the core.
(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (DEF-STRICT-HYP tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
(dk-peel!)
(let* ((vs (md-rel-open! 'def-strict-hyp 1)) (g (car vs)) (f (cadr vs)) (f2 (caddr vs)) (w (cadddr vs)))
  (dk-cite! 'adm-true-walk 'tt g f f2)
  (dk-cite! 'adm-strict-atom 'tt g f2 w)
  (md-close!))
(qed 'def-strict-hyp-derived)
(md-adm-holds! 'ADM-DEF-STRICT-HYP 'def-strict-hyp-derived 'adm-def-strict-hyp-holds)

;;; 5.5 THE R4 NTH CLAUSE (DEF-NTH-LIST) is DERIVED: the list denotes (CR-DEF-LIST, with the same
;;; premises), so NTH(k, [l]) == l_k (CR-NTH-EQ); l_k denotes (its premise, CR-DEF-STRICT-IN-L); and
;;; eq-subst carries l_k = l_k to NTH(k, [l]) = NTH(k, [l]) along the quasi-equation (P = (z = z), z := 0).
(sp (make-wff '(FORALL mdp7_ (FORALL mdq7_ (== (ENC-NTH mdp7_ mdq7_) (EAPP 15 (LIST mdp7_ mdq7_)))))))
(dk-peel!) (mac 'ENC-NTH) (qrfl)
(qed 'enc-nth-unfold)
(sp (make-wff '(FORALL tt (FORALL hs (FORALL c (IMPLIES (DEF-NTH-LIST tt hs c)
   (IMPLIES (HYPS-IN hs (DERIVABLE tt)) (IN c (DERIVABLE tt)))))))))
(dk-peel!)
(let* ((r (dk-meta-iff-r! (dk-meta-iff! 'def-nth-list 'tt 'hs 'c)))
       (parts (dk-split! r))
       (vs (dk-meta-unpack! (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts)))
       (ceq (dk-meta-eq-of 'c))
       (g (car vs)) (l (cadr vs)) (k (caddr vs))
       (lst `(ENC-LIST ,l)) (num `(ENC-NUM ,k)) (nn `(ENC-NTH ,num ,lst)) (e `(NTH ,k ,l))
       (q `(ENC-QEQ ,nn ,e)) (g1 (md+ g q))
       (pp '(EAPP 8 (LIST (EFVAR 0) (EFVAR 0)))) (ps `(EXPR-SUBST ,pp 0 ,nn)) (pe `(EXPR-SUBST ,pp 0 ,e)))
  (subst ceq)
  (dk-rewrite-h! '(IN c SEQ-SET) 'c (caddr ceq))
  ;; the list is a closed term: the conclusion is a sequent, NTH(k, [l]) a closed term, [l] its argument
  (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g `(ENC-EQ ,nn ,nn))))
  (dk-split! (dk-cite! 'clf-eq-elim nn nn))
  (let ((eapp `(EAPP 15 (LIST ,num ,lst))))
    (dk-rewrite-h! `(IN ,nn CLT) nn (caddr (dk-cite! 'enc-nth-unfold num lst)))
    (dk-have! '(IN 2 NN) (lambda () (arith)))
    (dk-have! '(<= 1 2) (lambda () (arith)))
    (dk-have! `(<= 2 (LENGTH (LIST ,num ,lst))) (lambda () (len-r) (arith)))
    (dk-cite! 'clt-eapp-arg 15 `(LIST ,num ,lst) 2)
    (dk-nth-h! `(IN (NTH 2 (LIST ,num ,lst)) CLT)))
  ;; (1) [g, [l] = [l]] by CR-DEF-LIST, whose premises are DEF-NTH-LIST's
  (let ((cl `(LIST ,g (ENC-EQ ,lst ,lst))))
    (dk-cite! 'clf-eq-intro lst lst)
    (dk-meta-seq! g `(ENC-EQ ,lst ,lst))
    (md-rel-close! 'DEF-LIST 'hs cl (list g l))
    (dk-cite! 'def-list-admitted 'tt 'hs cl))
  ;; (2) [g, l_k in SET], the k-th premise
  (let* ((u (dk-meta-iff-r! (dk-meta-iff! 'hyps-in 'hs '(DERIVABLE tt))))
         (ents (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'ENC-SETC))) (dk-asms)))
         (prem `(LIST ,g (ENC-IN ,e ENC-SETC))))
    (dk-have! `(<= ,k (LENGTH hs)) (lambda () (subst `(= (LENGTH hs) (LENGTH ,l))) (ass)))
    (dk-apply! u k)
    (dk-apply! ents k)
    (dk-rewrite-h! `(IN (NTH ,k hs) (DERIVABLE tt)) `(NTH ,k hs) prem)
    ;; (3) [g, l_k = l_k]
    (dk-cite! 'der-in-seq 'tt prem)
    (dk-split! (dk-meta-iff-r! (dk-meta-iff! 'seq-iff g `(ENC-IN ,e ENC-SETC))))
    (dk-split! (dk-cite! 'clf-in-elim e 'ENC-SETC))
