  (md-expr-of! nn 'CLT)
  (md-expr-of! e 'CLT)
  (dk-have! '(IN 0 NN) (lambda () (arith)))
  (dk-have! '(IN 8 NN) (lambda () (arith)))
  (fact 'efvar-in-expr 0)
