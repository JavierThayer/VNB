(define (m35-choose! wbody cls ne)   ; global choice along NN (the pattern of mlv-choose!, mb67-lusin2): returns Fz in FUN(NN, cls)
  (let* ((W (lambda (k) (subst-free 'mlk_ k wbody)))
         (L (list 'VNB-LAMBDA 'mlk_ 'NN (list 'CHOICE wbody)))
         (pick! (lambda (k)
                  (dk-apply! ne k)
                  (mr-chain! (dk-cite! 'choice-axiom (W k)))
                  (mr-sep-parts! (list 'IN (list 'CHOICE (W k)) (W k))))))
    (dk-have! (list 'IN L (list 'FUN 'NN cls))
      (lambda ()
        (for-each (lambda (kn)
                    (if (not (sequent-node-grounded? kn))
                        (begin (dk-focus! kn)
                               (if (dk-asm? (dk-goal)) (ass)
                                   (let ((k (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!))))))
                                     (pick! k)
                                     (mr-close-open!))))))
                  (dk-opened (lambda () (lam-t))))))
    (let ((ex (list 'FORSOME 'mlf_ (list 'AND (list 'IN 'mlf_ (list 'FUN 'NN cls))
                (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IN '(mlf_ k) (W 'k))))))))
      (dk-have! ex
        (lambda ()
          (ew L)
          (mr-and-close!
            (lambda ()
              (if (dk-asm? (dk-goal)) (ass)
                  (let ((k (dk-di-var!)))
                    (pick! k)
                    (dk-lam-b!)
                    (mr-close-open!)))))))
      (let ((Fz (dk-skolem! ex)))
        (dk-split-all!)
        Fz))))
