                        (mr-ext2! sec Fp
                          (lambda (y)
                            (dk-split-all! (list (mr-sep-parts! (list 'IN y sec))))
                            (dk-split-all! (list (mr-sep-parts! (list 'IN (list 'LIST k y) Pre))))
                            (m35-gkv! k y)
                            (let ((fy (list fk y)))
                              (m35-iv! k fy)
                              (dk-have! (list 'IN fy Ik)
                                (lambda () (in-sep! (lambda () (subst (list '= (list io fy) (list 'LIST k fy))) (subst (list '= (list 'LIST k fy) (list m35-G (list 'LIST k y)))) (mr-close-open!)))))
                              (in-sep! (lambda () (mr-close-open!)))))
                          (lambda (y)
                            (dk-split-all! (list (mr-sep-parts! (list 'IN y Fp))))
                            (let ((fy (list fk y)))
                              (dk-split-all! (list (mr-sep-parts! (list 'IN fy Ik))))
                              (m35-gkv! k y)
                              (m35-iv! k fy)
                              (dk-have! (list 'IN (list 'LIST k y) Pre)
                                (lambda () (in-sep! (lambda () (subst (list '= (list m35-G (list 'LIST k y)) (list 'LIST k fy))) (subst (list '= (list 'LIST k fy) (list io fy))) (mr-close-open!)))))
                              (in-sep! (lambda () (mr-close-open!))))))
                        (subst (list '= sec Fp))
                        (mr-close-open!))))))))))
      (mr-iff-back! iff)
      (mr-close-open!)))
(define (m35-images!)                ; goal: the images of the members of SG are Borel in SUM-MS T
  (dk-cite! 'sum-sigma-unfold 'xss 'cas)
  (let* ((A (dk-di-var!))
         (secall (begin (dk-rewrite-h! (list 'IN A m35-SG) m35-SG m35-SGb) (m35-sg-parts! A)))
         (lam (list 'VNB-LAMBDA 'm35q_ 'NN (list 'IMAGE (m35-iota 'm35q_) (list 'IMAGE (list m35-F 'm35q_) (m35-sec A 'm35q_)))))
         (bu (list 'BIG-UNION 'n_ 'NN (list lam 'n_)))
         (GA (list 'IMAGE m35-G A))
         (piece! (lambda (k)          ; the k-th piece is Borel
                   (let* ((tk (m35-T! k)) (io (m35-iota-cont! k)) (fk (list m35-F k)) (sk (m35-sec A k))
                          (_0 (m35-F! k))
                          (fimg (mr-find 'fimg (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'sba_) (dk-contains? f fk))) (dk-asms))))
                     (dk-apply! secall k)
                     (dk-apply! fimg sk)
                     (dk-cite! 'borel-injection-image tk m35-SM io (list 'IMAGE fk sk))))))
    (m35-pow-sub! A)
    (dk-have! (list 'IN lam (list 'FUN 'NN m35-BSM))
      (lambda ()
        (for-each (lambda (kn)
                    (if (not (sequent-node-grounded? kn))
                        (begin (dk-focus! kn)
                               (if (dk-asm? (dk-goal)) (ass)
                                   (let ((k (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                                     (piece! k)
                                     (mr-close-open!))))))
                  (dk-opened (lambda () (lam-t))))))
    (dk-cite! 'sigma-algebra-union-closed m35-PSM m35-BSM lam)
    (mr-ext2! GA bu
      (lambda (w)
        (let* ((p (m35-img-open! m35-G A w)))
          (dk-cite! 'subset-mem-fwd A m35-SS p)
          (let* ((kx (m35-gv! p)) (k (car kx)) (x (cdr kx)) (fk (list m35-F k)) (fx (list fk x)) (sk (m35-sec A k)) (io (m35-iota k)))
            (m35-iota-cont! k)
            (dk-have! (list 'IN x sk) (lambda () (in-sep! (lambda () (subst (list '= (list 'LIST k x) p)) (mr-close-open!)))))
            (m35-img-in! fk sk x fx (list 'PTS (list m35-T k)))
            (m35-iv! k fx)
            (dk-have! (list '= (list io fx) w)
              (lambda () (subst (list '= (list io fx) (list 'LIST k fx))) (subst (list '= (list 'LIST k fx) (list m35-G p))) (mr-close-open!)))
            (m35-img-in! io (list 'IMAGE fk sk) fx w m35-PSM)
            (for-each (lambda (l0) (if (not (sequent-node-grounded? l0))
                                       (begin (dk-focus! l0) (if (dk-asm? (dk-goal)) (ass) (begin (dk-lam-b!) (mr-close-open!))))))
                      (dk-opened (lambda () (bu-mi k))))
            (mr-close-open!))))
      (lambda (w)
        (let* ((kb (mr-bu-open! w bu)) (k (car kb)))
          (dk-lam-b-h! (cdr kb))
          (let* ((io (m35-iota k)) (fk (list m35-F k)) (sk (m35-sec A k))
                 (y (m35-img-open! io (list 'IMAGE fk sk) w))
                 (x (m35-img-open! fk sk y)))
            (m35-iota-cont! k)
            (dk-split-all! (list (mr-sep-parts! (list 'IN x sk))))
            (m35-gkv! k x)
            (dk-have! (list 'IN y (list 'PTS (list m35-T k))) (lambda () (subst (list '= y (list fk x))) (mr-close-open!)))
            (m35-iv! k y)
            (dk-have! (list '= (list m35-G (list 'LIST k x)) w)
              (lambda () (subst (list '= (list m35-G (list 'LIST k x)) (list 'LIST k (list fk x)))) (subst (list '= (list fk x) y))
                         (subst (list '= (list 'LIST k y) (list io y))) (mr-close-open!)))
            (m35-img-in! m35-G A (list 'LIST k x) w m35-PSM)
            (mr-close-open!)))))
    (subst (list '= GA bu))
    (mr-close-open!)))
(let ((iff (dk-cite! 'is-standard-borel m35-SS m35-SG)))
  (dk-have! (caddr iff)
    (lambda ()
      (ew m35-SM)
      (mr-and-close!
        (lambda ()
          (if (dk-ctx-form (dk-goal)) (ass)
              (begin
                (ew m35-G)
                (mr-and-close!
                  (lambda ()
                    (let ((g (dk-goal)))
                      (cond
                        ((dk-ctx-form g) (ass))
                        ((dk-contains? g 'BIJECTION) (m35-bij!))
                        ((dk-head-is? g 'IS-MEASURABLE-MAP) (m35-meas!))
                        (#t (m35-images!))))))))))))
  (mr-iff-back! iff))
(mr-close-open!)
