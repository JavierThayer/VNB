  (let ((fin! (lambda ()
                (subst `(= ,(a5p-lm one m) ,m))
                (subst `(= (,m 0) ,c))
                (dk-close-if-asm!))))
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((dk-asm? g) (dk-ass!))
            ((dk-head-is? g 'IS-NONTRIVIAL-CHARACTER)
             (mac 'IS-NONTRIVIAL-CHARACTER)
             (dk-conj-close!
               (lambda ()
                 (if (dk-asm? (dk-goal)) (dk-ass!)
                     (begin
                       (ew m)
                       (dk-conj-close!
                         (lambda ()
                           (if (dk-asm? (dk-goal)) (dk-ass!)
                               (begin (dk-lam-b!) (fin!))))))))))
            (#t
             (ew m)
             (dk-conj-close!
               (lambda ()
                 (if (dk-asm? (dk-goal)) (dk-ass!)
                     (begin
                       (ew one)
                       (dk-conj-close!
                         (lambda ()
                           (if (dk-asm? (dk-goal)) (dk-ass!)
                               (begin (a5p-value! m one) (fin!))))))))))))))))
(qed 'lp-nontrivial)

;;; PROPOSITION 6.10.  K = F_q a finite field with its (only, trivial) absolute value, chi a non-trivial
;;; character of F_q, 0 < r < 1.  On F_q((x)) with |f| = r^(ord f), omega(g, f) = chi(a_0(f g)) is a symmetric,
