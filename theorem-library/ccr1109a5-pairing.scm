;; the section at 1 is a non-trivial character of F_q((x)), and W is non-trivial
(define a5p-one '(LAURENT-ONE kq_))
(sp (make-wff (a5p-lh (a5p-ch `(IMPLIES (FORSOME chx_ (AND (IN chx_ (CARR kq_)) (NOT (= (a5c chx_) 1))))
  (AND (IS-NONTRIVIAL-CHARACTER ,a5p-lnf ,(a5p-phi a5p-one))
       (FORSOME c5x (AND (IN c5x (CARR ,a5p-lnf)) (FORSOME c5y (AND (IN c5y (CARR ,a5p-lnf)) (NOT (= (,a5p-w c5x c5y) 1))))))))))))
(dk-peel!)
