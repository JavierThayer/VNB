;; the value of the pairing: W(u, v) = chi(a_0(v u))
(sp (make-wff '(FORALL kq_ (FORALL a5c (FORALL uq_ (IMPLIES (IN uq_ (LAURENT-SET kq_)) (FORALL vq_ (IMPLIES (IN vq_ (LAURENT-SET kq_))
