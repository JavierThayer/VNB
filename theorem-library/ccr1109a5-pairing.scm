                        (mac 'cartesian-set-iff)
                        (dk-ass!))))
                (dk-opened (lambda () (lam-t))))))
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'IS-BILINEAR-BICHARACTER)
           (mac 'IS-BILINEAR-BICHARACTER)
           (dk-conj-close!
             (lambda ()
               (let ((g2 (dk-goal)))
                 (cond
                   ((dk-asm? g2) (dk-ass!))
                   ((dk-head-is? g2 'IS-BICHARACTER)
                    (mac 'IS-BICHARACTER)
                    (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!) (section!)))))
                   (#t
                    (let* ((landed (dk-landed (lambda () (dk-peel!))))
                           (ins (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed)))
                           (c (car ins)) (x (cadr ins)) (y (caddr ins)))
                      (a5p-ls! c) (a5p-ls! x) (a5p-ls! y)
                      (subst (dk-cite! 'lp-nf-mul-apply 'kq_ 'rq_ c x))
                      (subst (dk-cite! 'lp-nf-mul-apply 'kq_ 'rq_ c y))
                      (dk-cite! 'laurent-mul-in 'kq_ c x) (dk-cite! 'laurent-mul-in 'kq_ c y)
                      (a5p-value! (a5p-lm c x) y)
                      (a5p-value! x (a5p-lm c y))
                      (comm! c y)
                      (subst (dk-cite! 'laurent-mul-assoc 'kq_ y c x))
                      (rfl))))))))
          (#t
           (let* ((landed (dk-landed (lambda () (dk-peel!))))
                  (ins (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed)))
                  (x (car ins)) (y (cadr ins)))
             (a5p-ls! x) (a5p-ls! y)
             (a5p-value! x y) (a5p-value! y x)
             (comm! y x)
             (rfl))))))))
(qed 'lp-bilinear-symmetric)

;; a character of TRIV-NF(K) is an additive homomorphism of K into the circle (and non-trivial)
(sp (make-wff '(FORALL kq_ (IMPLIES (IS-RING kq_) (FORALL a5c (IMPLIES (IS-NONTRIVIAL-CHARACTER (TRIV-NF kq_) a5c)
  (AND (IN a5c (FUN (CARR kq_) UNIT-CIRCLE))
   (AND (FORALL chx_ (IMPLIES (IN chx_ (CARR kq_)) (FORALL chy_ (IMPLIES (IN chy_ (CARR kq_))
          (= (a5c ((ADD kq_) chx_ chy_)) (* (a5c chx_) (a5c chy_)))))))
        (FORSOME chx_ (AND (IN chx_ (CARR kq_)) (NOT (= (a5c chx_) 1))))))))))))
(dk-peel!)
(dk-cite! 'triv-nf-carr 'kq_) (dk-cite! 'triv-nf-add 'kq_)
(dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'IS-NONTRIVIAL-CHARACTER '(IS-NONTRIVIAL-CHARACTER (TRIV-NF kq_) a5c))))))
(dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'IS-ADD-CHARACTER '(IS-ADD-CHARACTER (TRIV-NF kq_) a5c))))))
(subst '(== (CARR kq_) (CARR (TRIV-NF kq_))))
(subst '(== (ADD kq_) (ADD (TRIV-NF kq_))))
(dk-conj-close! (lambda () (dk-ass!)))
