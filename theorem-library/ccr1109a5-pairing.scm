;; ... and is a character of F_q((x)): additive by distributivity, continuous because a_0(y z) depends only on
;; finitely many coefficients of z (laurent-mul-local)
(sp (make-wff (a5p-lh (a5p-ch (a5p-all 'yq_ a5p-ls `(IS-ADD-CHARACTER ,a5p-lnf ,(a5p-phi 'yq_)))))))
(dk-peel!)
(a5p-lk!)
(fact 'zz-zero-in) (fact 'zz-one-in)
(let* ((lnf a5p-lnf) (ms a5p-ms) (phi (a5p-phi 'yq_))
       (hom (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'a5c) (dk-contains? h 'ADD))) "the hom law"))
       (loc `(FORALL a5a (IMPLIES (IN a5a (PTS ,ms)) (FORSOME a5d (AND (POS-RR a5d)
               (FORALL a5b (IMPLIES (IN a5b (PTS ,ms)) (IMPLIES (<= ((DIST ,ms) a5a a5b) a5d) (= (,phi a5b) (,phi a5a)))))))))))
  (dk-chain-ass! (dk-cite! 'lp-section-type 'kq_ 'rq_ 'a5c 'yq_))
  (fact 'cc-is-metric-space)
  (dk-have! '(SUBSET UNIT-CIRCLE CC)
    (lambda ()
      (let ((u (subset-by-element!)))
        (dk-iff-fwd! (dk-cite! 'unit-circle-membership u))
        (dk-close-if-asm!))))
  (dk-chain-ass! (dk-cite! 'fun-codomain-superset phi `(CARR ,lnf) 'UNIT-CIRCLE 'CC))
  (fact 'cc-ms@pts)
  (dk-cite! 'nf-metric-carrier lnf)
  (dk-cite! 'nf-metric-space-is-metric-space lnf)
  (dk-have! `(IN ,phi (FUN (PTS ,ms) (PTS CC-MS)))
    (lambda () (subst `(== (PTS ,ms) (CARR ,lnf))) (subst '(== (PTS CC-MS) CC)) (dk-ass!)))
  (dk-cite! 'laurent-set-out 'kq_ 'yq_) (dk-split-all!)
  (dk-have! loc
    (lambda ()
      (let* ((landed (dk-landed (lambda () (dk-peel!))))
             (a (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) landed))))
        (dk-rewrite-h! `(IN ,a (PTS ,ms)) `(PTS ,ms) `(CARR ,lnf))
        (a5p-ls! a)
        (dk-cite! 'laurent-set-out 'kq_ a) (dk-split-all!)
        (let* ((by (dk-skolem! (dk-chain-ass! (dk-cite! 'laurent-bound-le 'kq_ 'yq_ 0)))))
          (dk-split-all!)
          (let* ((ba (dk-skolem! (dk-chain-ass! (dk-cite! 'laurent-bound-le 'kq_ a by)))))
            (dk-split-all!)
            (let* ((van (lambda (f) `(FORALL lzj (IMPLIES (IN lzj ZZ) (IMPLIES (< lzj ,ba) (= (,f lzj) (ZERO kq_)))))))
                   (tq `(- ,ba)) (nn `(+ ,tq 1)) (dl `(RPOW-STAR rq_ ,nn)))
              (dk-chain-ass! (dk-cite! 'laurent-below-mono 'kq_ 'yq_ by ba))
              (if (not (dk-asm? (van 'yq_))) (error "a5p: y does not vanish below ba"))
              (if (not (dk-asm? (van a))) (error "a5p: a does not vanish below ba"))
              (dk-cite! 'zz-neg-closed ba)
              (a5p-and! `(IN ,tq ZZ) '(IN 1 ZZ))
              (dk-cite! 'zz-add-closed tq 1)
              (dk-cite! 'zz-in-rr ba) (dk-cite! 'zz-in-rr by) (dk-cite! 'zz-in-rr nn)
              (dk-cite! 'rpow-star-in-rr 'rq_ nn)
              (dk-chain-ass! (dk-cite! 'rpow-star-pos 'rq_ nn))
              (dk-cite! 'rr-pos-rr-of-lt dl)
              (ew dl)
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal)) (dk-ass!)
                      (let* ((landed2 (dk-landed (lambda () (dk-peel!))))
                             (b (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) landed2))))
                        (dk-rewrite-h! `(IN ,b (PTS ,ms)) `(PTS ,ms) `(CARR ,lnf))
                        (a5p-ls! b)
                        (dk-cite! 'laurent-set-out 'kq_ b) (dk-split-all!)
                        (dk-iff-fwd! (dk-cite! 'laurent-dist-le-iff 'kq_ 'rq_ a b nn))
                        (let ((agr `(FORALL lzj (IMPLIES (IN lzj ZZ) (IMPLIES (< lzj ,nn) (= (,a lzj) (,b lzj)))))))
                          (if (not (dk-asm? agr)) (error "a5p: the agreement did not land"))
                          (dk-have! (van b)
                            (lambda ()
                              (let* ((l3 (dk-landed (lambda () (dk-peel!))))
                                     (j (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) l3))))
                                (dk-cite! 'zz-in-rr j)
                                (dk-have! `(< ,j ,nn) (lambda () (dk-ineq! `(< ,j ,ba) `(<= ,ba ,by) `(<= ,by 0))))
                                (dk-apply! agr j)
                                (dk-apply! (van a) j)
                                (subst `(= (,b ,j) (,a ,j)))
                                (dk-close-if-asm!))))
                          (dk-have! `(FORALL lzj (IMPLIES (IN lzj ZZ) (IMPLIES (<= lzj ,tq) (= (yq_ lzj) (yq_ lzj)))))
                            (lambda () (dk-peel!) (rfl)))
                          (dk-have! `(FORALL lzj (IMPLIES (IN lzj ZZ) (IMPLIES (<= lzj ,tq) (= (,a lzj) (,b lzj)))))
                            (lambda ()
                              (let* ((l3 (dk-landed (lambda () (dk-peel!))))
                                     (j (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) l3))))
                                (dk-cite! 'zz-in-rr j)
                                (dk-have! `(< ,j ,nn) (lambda () (dk-ineq! `(<= ,j ,tq))))
                                (dk-apply! agr j)
                                (dk-close-if-asm!))))
                          (dk-have! `(<= 0 (+ ,tq ,ba)) (lambda () (dk-ineq!)))
                          (let* ((eqm (dk-chain-ass! (dk-cite! 'laurent-mul-local 'kq_ 'yq_ 'yq_ a b ba tq 0)))
                                 (ma `(MONALG-MUL kq_ ZZ-ADD-MONOID yq_ ,a)) (mb `(MONALG-MUL kq_ ZZ-ADD-MONOID yq_ ,b)))
                            (dk-cite! 'laurent-mul-unfold 'kq_ 'yq_ a)
                            (dk-cite! 'laurent-mul-unfold 'kq_ 'yq_ b)
                            (let* ((e1 (dk-rewrite-h! eqm ma (a5p-lm 'yq_ a)))
                                   (e2 (dk-rewrite-h! e1 mb (a5p-lm 'yq_ b))))
                              (a5p-coeff! 'yq_ a)
                              (dk-lam-b!)
                              (subst `(= (,(a5p-lm 'yq_ b) 0) (,(a5p-lm 'yq_ a) 0)))
                              (rfl))))))))))))))
  (dk-chain-ass! (dk-cite! 'ms-locally-constant-continuous ms 'CC-MS phi))
  (mac 'IS-ADD-CHARACTER)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (dk-ass!)
          (let* ((landed (dk-landed (lambda () (dk-peel!))))
                 (ins (map cadr (filter (lambda (h) (dk-head-is? h 'IN)) landed)))
                 (x (car ins)) (x2 (cadr ins)))
            (a5p-ls! x) (a5p-ls! x2)
            (dk-cite! 'nf-add-in-carr lnf x x2)
            (dk-lam-b!)
            (subst (dk-cite! 'lp-nf-add-apply 'kq_ 'rq_ x x2))
            (subst (dk-cite! 'laurent-mul-distrib-left 'kq_ 'yq_ x x2))
            (let ((m1 (a5p-lm 'yq_ x)) (m2 (a5p-lm 'yq_ x2)))
              (a5p-coeff! 'yq_ x) (a5p-coeff! 'yq_ x2)
              (subst (dk-cite! 'laurent-add-apply 'kq_ m1 m2 0))
              (dk-apply! hom `(,m1 0) `(,m2 0))
              (dk-close-if-asm!)))))))
(qed 'lp-section-character)

;;; ===========================================================================
;;; 4. W IS A SYMMETRIC BILINEAR BICHARACTER; IT IS NON-TRIVIAL; PROPOSITION 6.10.
;;; ===========================================================================

(sp (make-wff (a5p-lh (a5p-ch
  `(AND (IS-BILINEAR-BICHARACTER ,a5p-lnf ,a5p-w)
        (FORALL chx_ (IMPLIES (IN chx_ (CARR ,a5p-lnf)) (FORALL chy_ (IMPLIES (IN chy_ (CARR ,a5p-lnf))
          (= (,a5p-w chx_ chy_) (,a5p-w chy_ chx_)))))))))))
(dk-peel!)
(a5p-lk!)
(fact 'zz-zero-in)
(a5p-sets!)
(let* ((lnf a5p-lnf) (w a5p-w) (cl `(CARR ,lnf))
       (wty `(IN ,w (FUN (CARTESIAN ,cl ,cl) UNIT-CIRCLE)))
       (comm! (lambda (f g) (subst (dk-cite! 'laurent-mul-comm 'kq_ f g))))
       (section!
         (lambda ()
           (let* ((landed (dk-landed (lambda () (dk-peel!))))
                  (y (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed)))
                  (s (caddr (dk-goal)))
                  (pm (a5p-phi y)))
             (a5p-ls! y)
             (dk-chain-ass! (dk-cite! 'lp-section-character 'kq_ 'rq_ 'a5c y))
             (dk-chain-ass! (dk-cite! 'lp-section-type 'kq_ 'rq_ 'a5c y))
             (dk-fun-ext! s pm cl 'UNIT-CIRCLE
               (lambda ()
                 (for-each (lambda (l)
                             (dk-focus! l)
                             (if (dk-head-is? (dk-goal) 'FORALL)
                                 (let* ((v (dk-di-var!)) (app (cadr (dk-goal))))
                                   (a5p-ls! v)
                                   (a5p-value! (cadr app) (caddr app))
                                   (dk-close-if-asm!))
                                 (dk-close-if-asm!)))
                           (dk-opened (lambda () (lam-t)))))
               #f
               (lambda (v)
                 (a5p-ls! v)
                 (dk-lam-b!)
                 (let ((app (cadr (dk-goal))))
                   (a5p-value! (cadr app) (caddr app))
                   (a5p-coeff! y v)
                   (if (not (equal? (caddr app) y)) (comm! v y))
                   (rfl))))
             (subst `(= ,s ,pm))
             (dk-ass!)))))
  (dk-have! wty
    (lambda ()
      (subst `(== ,cl (CARR ,a5p-lr))) (subst `(== (CARR ,a5p-lr) ,a5p-ls))
      (mac 'LAURENT-PAIRING)
      (for-each (lambda (l)
                  (dk-focus! l)
                  (if (dk-head-is? (dk-goal) 'FORALL)
                      (begin
                        (di)
                        (let* ((prod (car (cadr (cadr (dk-goal))))) (v (caddr prod)) (u (cadddr prod)))
                          (a5p-coeff! v u)
                          (dk-close-if-asm!)))
