(sp (make-wff `(FORALL kq_ (IMPLIES (IS-FIELD-RING kq_) (IMPLIES (IN (CARD (CARR kq_)) NN)
  (FORALL rq_ (IMPLIES (IN rq_ RR) (IMPLIES (< 0 rq_) (IMPLIES (< rq_ 1)
  (FORALL a5c (IMPLIES (IS-NONTRIVIAL-CHARACTER (TRIV-NF kq_) a5c)
    (AND (IS-BILINEAR-BICHARACTER ,a5p-lnf ,a5p-w)
     (AND (FORALL chx_ (IMPLIES (IN chx_ (CARR ,a5p-lnf)) (FORALL chy_ (IMPLIES (IN chy_ (CARR ,a5p-lnf))
            (= (,a5p-w chx_ chy_) (,a5p-w chy_ chx_))))))
          (IS-FAITHFUL-BICHARACTER ,a5p-lnf ,a5p-w))))))))))))))
(dk-peel!)
(a5p-lk!)
(dk-chain-ass! (dk-cite! 'lp-triv-char-parts 'kq_ 'a5c)) (dk-split-all!)
(dk-chain-ass! (dk-cite! 'lp-bilinear-symmetric 'kq_ 'rq_ 'a5c)) (dk-split-all!)
(dk-chain-ass! (dk-cite! 'lp-nontrivial 'kq_ 'rq_ 'a5c)) (dk-split-all!)
(dk-chain-ass! (dk-cite! 'laurent-local-uniformizer 'kq_ 'rq_))
(dk-chain-ass! (dk-cite! 'ccr-6-6-local a5p-lnf a5p-x1 (a5p-phi a5p-one) a5p-w))
(dk-conj-close! (lambda () (dk-ass!)))
(qed 'ccr-6-10)
