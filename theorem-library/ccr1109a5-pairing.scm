(subst `(== (MUL ,a5p-lnf) (MUL ,a5p-lr)))
(subst `(== (MUL ,a5p-lr) (VNB-LAMBDA (LIST lrf_ lrg_) (CARTESIAN ,a5p-ls ,a5p-ls) (LAURENT-MUL kq_ lrf_ lrg_))))
(dk-close-if! (lambda () (dk-lam-b!)) (lambda () (rfl)))
