;;; ccr1109a5-pairing.scm -- CCR.pdf Proposition 6.10: THE RESIDUE PAIRING OF F_q((x)).  Agent CCR-1109-A5,
;;; 2026-11-09.  Destination: theorem-library/ccr1109a5-pairing.scm.  Library: complex-analysis (it cites
;;; ccr5-selfdual's ccr-6-6-local, which is complex-analysis; the pairing itself is analysis).  Helper prefix a5p-.
;;;
;;; For a finite field K = F_q (IS-FIELD-RING K, CARD(CARR K) in NN) with a non-trivial character chi of
;;; TRIV-NF(K) (its only absolute value, ccr1109a5-finite-field), and 0 < r < 1, the map
;;;     w(g, f) = chi(a_0(f g)) = prod_k chi(a_k(f) a_(-k)(g))                       ((58), (59), (61))
;;; (LAURENT-PAIRING(K, chi), structure-library/ccr1109a5-vocab) is a symmetric, faithful, bilinear
;;; bicharacter of K((x)) = LAURENT-NF(K, r).  The route:
;;;   * the section x |-> chi(a_0(x y)) is a character of K((x)) (lp-section-character): additive by
;;;     distributivity and the coefficientwise sum; CONTINUOUS because it is locally constant -- a_0(x y)
;;;     depends only on the coefficients of x below 1 - b, b a common lower bound (laurent-mul-local of
;;;     ccr1109a3-laurent-ring), and d(x, x') <= r^N iff x, x' agree below N (laurent-dist-le-iff of
;;;     ccr1109a4-laurent-complete);
;;;   * symmetric and bilinear by commutativity and associativity of the product;
;;;   * FAITHFUL by Corollary 6.6 for a local field (ccr-6-6-local of ccr5-selfdual, which rests on 5.13):
;;;     x is a uniformizer of K((x)) (laurent-local-uniformizer: the integers K[[x]] are compact, and
;;;     |f| < 1 forces |f| <= r = |x|, so M(K[[x]]) = (x) by the generic nv-maximal-principal-of-gap), the
;;;     section at 1, f |-> chi(a_0(f)), is a non-trivial character, and w(c, 1) = chi(c) /= 1 for a c with
;;;     chi(c) /= 1.
;;;
;;; Load window: after ccr1109a5-finite-field and ccr1109a5-vocab; ccr1109a4-laurent-complete
;;; (laurent-dist-le-iff, laurent-integers-compact, laurent-nf-fnrm-apply, laurent-x-power-abs);
;;; ccr1109a3-laurent-{ring,val,field}; ccr1109d's ccr5-dual and ccr1109d2's ccr5-selfdual (ccr-6-6-local:
;;; this sets lo); ccr2-nv / qp-laws (nv-integers-domain, nv-maximal-unfold, nv-principal-unfold, nv-domain-sub).

(define (a5p-and! . fs) (apply dk-have-and! fs))
(define (a5p-all v c body) `(FORALL ,v (IMPLIES (IN ,v ,c) ,body)))
(define (a5p-n kf x) `((FNRM ,kf) ,x))
(define (a5p-view kf) `(NORMED-FIELD-AS-COMMUTATIVE-RING ,kf))
(define (a5p-view! kf)
  (let ((v (a5p-view kf)))
    (if (not (dk-asm? `(IS-COMMUTATIVE-RING ,v)))
        (begin
          (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring kf)
          (for-each (lambda (n) (dk-cite! n kf))
                    '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
                      normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one))))))
(define (a5p-crs! kf elems)
  (a5p-view! kf)
  (let ((v (a5p-view kf)))
    (for-each (lambda (u)
                (if (not (dk-asm? `(IN ,u (CARR ,v))))
                    (dk-have! `(IN ,u (CARR ,v)) (lambda () (subst `(== (CARR ,v) (CARR ,kf))) (dk-ass!)))))
              elems)
    (for-each (lambda (acc)
                (if (dk-contains? (dk-goal) `(,acc ,kf))
                    (subst `(== (,acc ,kf) (,acc ,v)))))
              '(ADD MUL NEG ZERO ONE))
    (crs)))

;;; ===========================================================================
;;; 1. A GENERIC CRITERION FOR A UNIFORMIZER.  In an NV field, if uw has 0 < |uw| < 1 and no element has a norm
;;; strictly between |uw| and 1, then the maximal ideal of the integers is (uw); with compact integers, uw is a
;;; local uniformizer.
;;; ===========================================================================
(define (a5p-gap kf uw)
  `(FORALL a5h (IMPLIES (IN a5h (CARR ,kf)) (IMPLIES (< ,(a5p-n kf 'a5h) 1) (<= ,(a5p-n kf 'a5h) ,(a5p-n kf uw))))))

(sp (make-wff `(FORALL kf (IMPLIES (IS-NV-FIELD kf) (FORALL uw (IMPLIES (IN uw (CARR kf))
  (IMPLIES (< 0 ,(a5p-n 'kf 'uw)) (IMPLIES (< ,(a5p-n 'kf 'uw) 1) (IMPLIES ,(a5p-gap 'kf 'uw)
    (= (NV-MAXIMAL kf (NV-INTEGERS kf)) (NV-PRINCIPAL kf (NV-INTEGERS kf) uw)))))))))))
(dk-peel!)
(let* ((kf 'kf) (z `(NV-INTEGERS ,kf)) (m `(NV-MAXIMAL ,kf ,z)) (pr `(NV-PRINCIPAL ,kf ,z uw))
       (zs `(SEP cwx_ (CARR ,kf) (<= ((FNRM ,kf) cwx_) 1)))
       (ms `(SEP cwx_ ,z (< ((FNRM ,kf) cwx_) 1)))
       (ps `(SEP cwx_ ,z (FORSOME cwm_ (AND (IN cwm_ ,z) (= cwx_ ((MUL ,kf) cwm_ uw))))))
       (gap (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'a5h))) "the gap"))
       (nuw (a5p-n kf 'uw)))
  (dk-cite! 'nv-field-normed kf)
  (dk-cite! 'nv-integers-domain kf)
  (dk-cite! 'nv-integers-unfold kf)
  (dk-cite! 'nv-maximal-unfold kf z)
  (dk-cite! 'nv-principal-unfold kf z 'uw)
  (dk-cite! 'nf-norm-in-rr kf 'uw)
  (fact 'rr-one-in) (fact 'rr-zero-in)
  (dk-have! `(NOT (= uw (ZERO ,kf)))
    (lambda () (di)
      (let* ((z0 (dk-cite! 'nf-norm-of-zero kf)) (z1 (dk-rewrite-h! z0 `(ZERO ,kf) 'uw)))
        (dk-absurd! z1 `(< 0 ,nuw)))))
  (let* ((b (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-inverse kf 'uw)))))
    (dk-split-all!)
    (dk-cite! 'nf-norm-in-rr kf b) (dk-cite! 'nf-norm-nonneg kf b)
    (dk-cite! 'nf-norm-one kf)
    (let* ((n0 (dk-cite! 'nf-norm-mult kf 'uw b))
           (n1 (dk-rewrite-h! n0 `((MUL ,kf) uw ,b) `(ONE ,kf)))
           (n2 (dk-rewrite-h! n1 (a5p-n kf `(ONE ,kf)) 1))
           (nb (a5p-n kf b))
           (incarr! (lambda (y) (if (not (dk-asm? `(IN ,y (CARR ,kf)))) (dk-chain-ass! (dk-cite! 'nv-domain-sub kf z y)))))
           (int-parts! (lambda (y)        ; (IN y z) in context: land y in CARR and |y| <= 1
                         (dk-sep-parts! (dk-rewrite-h! `(IN ,y ,z) z zs)))))
      (a5p-and! `(IN ,nuw RR) `(IN ,nb RR)) (dk-cite! 'rr-mul-closed nuw nb)
      (let ((ch (dk-cite! 'class-extensionality m pr)))
        (dk-have! (cadr ch)
          (lambda ()
            (dk-peel!)
            (let ((x (cadr (cadr (dk-goal)))))
              (dk-iff! (lambda (g) (dk-contains? g 'NV-PRINCIPAL))
                (lambda ()
                  ;; |x| < 1: x = (x b) uw with |x b| = |x| |b| <= |uw| |b| = 1
                  (dk-sep-parts! (dk-rewrite-h! `(IN ,x ,m) m ms))
                  (incarr! x)
                  (let* ((nx (a5p-n kf x)) (xb `((MUL ,kf) ,x ,b)))
                    (dk-cite! 'nf-norm-in-rr kf x)
                    (dk-apply! gap x)
                    (dk-cite! 'nf-mul-in-carr kf x b)
                    (let* ((k0 (dk-cite! 'nf-norm-mult kf x b))
                           (le (dk-chain-ass! (dk-cite! 'rr-mul-le-right nx nuw nb))))
                      (a5p-and! `(IN ,nx RR) `(IN ,nb RR)) (dk-cite! 'rr-mul-closed nx nb)
                      (dk-cite! 'nf-norm-in-rr kf xb)
                      (dk-have! `(<= ,(a5p-n kf xb) 1) (lambda () (dk-ineq! k0 le n2)))
                      (dk-have! `(IN ,xb ,z) (lambda () (subst `(== ,z ,zs)) (in-sep! (lambda () (dk-ass!)))))
                      (subst `(== ,pr ,ps))
                      (in-sep! (lambda () (dk-close-if-asm!))
                        (lambda ()
                          (ew xb)
                          (dk-conj-close!
                            (lambda ()
                              (if (not (dk-ass!))
                                  (begin
                                    (dk-have! `(= ((MUL ,kf) ,xb uw) ((MUL ,kf) ,x ((MUL ,kf) uw ,b)))
                                      (lambda () (a5p-crs! kf (list x b 'uw))))
                                    (subst `(= ((MUL ,kf) ,xb uw) ((MUL ,kf) ,x ((MUL ,kf) uw ,b))))
                                    (subst `(= ((MUL ,kf) uw ,b) (ONE ,kf)))
                                    (dk-cite! 'nf-one-in-carr kf)
                                    (dk-have! `(= ((MUL ,kf) ,x (ONE ,kf)) ,x) (lambda () (a5p-crs! kf (list x))))
                                    (subst `(= ((MUL ,kf) ,x (ONE ,kf)) ,x))
                                    (rfl))))))))))
                (lambda ()
                  ;; x = m0 uw, |m0| <= 1: |x| = |m0| |uw| <= |uw| < 1
                  (dk-sep-parts! (dk-rewrite-h! `(IN ,x ,pr) pr ps))
                  (let* ((m0 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h x))) "the multiplier"))))
                    (dk-split-all!)
                    (incarr! m0) (incarr! x)
                    (int-parts! m0)
                    (let* ((nm0 (a5p-n kf m0))
                           (k0 (dk-cite! 'nf-norm-mult kf m0 'uw))
                           (k1 (dk-rewrite-h! k0 `((MUL ,kf) ,m0 uw) x)))
                      (dk-cite! 'nf-norm-in-rr kf m0) (dk-cite! 'nf-norm-in-rr kf x)
                      (dk-cite! 'nf-norm-nonneg kf 'uw)
                      (let ((le (dk-chain-ass! (dk-cite! 'rr-mul-le-right nm0 1 nuw))))
                        (a5p-and! `(IN ,nm0 RR) `(IN ,nuw RR)) (dk-cite! 'rr-mul-closed nm0 nuw)
                        (subst `(== ,m ,ms))
                        (in-sep! (lambda () (dk-close-if-asm!))
                          (lambda () (dk-ineq! k1 le `(< ,nuw 1))))))))))))
        (detach! ch)
        (dk-close-if-asm!)))))
(qed 'nv-maximal-principal-of-gap)

;; ... and with compact integers, uw is a local uniformizer
(sp (make-wff `(FORALL kf (IMPLIES (IS-NV-FIELD kf) (IMPLIES (IS-COMPACT (SUBSPACE-MS (NF-METRIC-SPACE kf) (NV-INTEGERS kf)))
  (FORALL uw (IMPLIES (IN uw (CARR kf))
    (IMPLIES (< 0 ,(a5p-n 'kf 'uw)) (IMPLIES (< ,(a5p-n 'kf 'uw) 1) (IMPLIES ,(a5p-gap 'kf 'uw)
      (IS-LOCAL-UNIFORMIZER kf uw)))))))))))
(dk-peel!)
(let* ((kf 'kf) (z `(NV-INTEGERS ,kf)) (nuw (a5p-n kf 'uw))
       (zs `(SEP cwx_ (CARR ,kf) (<= ((FNRM ,kf) cwx_) 1))))
  (dk-cite! 'nv-field-normed kf)
  (dk-cite! 'nv-integers-domain kf)
  (dk-cite! 'nv-integers-unfold kf)
  (dk-cite! 'nf-norm-in-rr kf 'uw)
  (fact 'rr-zero-in)
  (dk-chain-ass! (dk-cite! 'nv-maximal-principal-of-gap kf 'uw))
  (mac 'IS-LOCAL-UNIFORMIZER)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'IS-COMPACT-NV-DOMAIN) (mac 'IS-COMPACT-NV-DOMAIN) (dk-conj-close! (lambda () (dk-ass!))))
          ((dk-head-is? g 'IN) (subst `(== ,z ,zs)) (in-sep! (lambda () (dk-ineq! `(< ,nuw 1)))))
          ((dk-head-is? g 'NOT)
           (di)
           (let* ((z0 (dk-cite! 'nf-norm-of-zero kf)) (z1 (dk-rewrite-h! z0 `(ZERO ,kf) 'uw)))
             (dk-absurd! z1 `(< 0 ,nuw))))
          (#t (error "a5p: unexpected conjunct" (expression->string g))))))))
(qed 'nv-local-uniformizer-of-gap)

;;; ===========================================================================
;;; 2. x IS A UNIFORMIZER OF K((x)) FOR A FINITE FIELD K.
;;; ===========================================================================
(define a5p-lnf '(LAURENT-NF kq_ rq_))
(define a5p-lr '(LAURENT-RING kq_))
(define a5p-ls '(LAURENT-SET kq_))
(define (a5p-lh body)
  `(FORALL kq_ (IMPLIES (IS-FIELD-RING kq_) (FORALL rq_ (IMPLIES (IN rq_ RR) (IMPLIES (< 0 rq_) (IMPLIES (< rq_ 1) ,body)))))))
(define (a5p-lk!)
  (dk-chain-ass! (dk-cite! 'field-ring-is-integral-domain 'kq_))
  (dk-chain-ass! (dk-cite! 'integral-domain-is-commutative-ring 'kq_))
  (dk-chain-ass! (dk-cite! 'commutative-ring-is-ring 'kq_))
  (dk-chain-ass! (dk-cite! 'laurent-nf-is-normed-field 'kq_ 'rq_))
  (dk-chain-ass! (dk-cite! 'laurent-ring-is-commutative-ring 'kq_))
  (dk-chain-ass! (dk-cite! 'laurent-ring-is-ring 'kq_))
  (dk-cite! 'laurent-nf-carr 'kq_ 'rq_) (dk-cite! 'laurent-ring-carr 'kq_))
;; (IN x (CARR LNF)) in context: land (IN x LS); and the converse
(define (a5p-ls! x)
  (if (not (dk-asm? `(IN ,x ,a5p-ls)))
      (let ((h (dk-rewrite-h! `(IN ,x (CARR ,a5p-lnf)) `(CARR ,a5p-lnf) `(CARR ,a5p-lr))))
        (dk-rewrite-h! h `(CARR ,a5p-lr) a5p-ls))))
(define (a5p-nf! x)
  (if (not (dk-asm? `(IN ,x (CARR ,a5p-lnf))))
      (let ((h (dk-rewrite-h! `(IN ,x ,a5p-ls) a5p-ls `(CARR ,a5p-lr))))
        (dk-rewrite-h! h `(CARR ,a5p-lr) `(CARR ,a5p-lnf)))))
(define (a5p-abs f) `(LAURENT-ABS kq_ rq_ ,f))

;; |f| < 1 forces |f| <= r: the order is then at least 1
(sp (make-wff (a5p-lh (a5p-all 'fq_ a5p-ls `(IMPLIES (< ,(a5p-abs 'fq_) 1) (<= ,(a5p-abs 'fq_) rq_))))))
(dk-peel!)
(a5p-lk!)
(let ((af (a5p-abs 'fq_)))
  (fact 'rr-one-in) (fact 'rr-zero-in)
  (dk-cite! 'laurent-abs-in-rr 'kq_ 'rq_ 'fq_) (dk-split-all!)
  (use-em '(= fq_ (LAURENT-ZERO kq_))
    (lambda ()
      (dk-cite! 'laurent-abs-zero 'kq_ 'rq_)
      (subst '(= fq_ (LAURENT-ZERO kq_)))
      (subst `(= ,(a5p-abs '(LAURENT-ZERO kq_)) 0))
      (dk-ineq! '(< 0 rq_)))
    (lambda ()
      (let* ((o (dk-skolem! (dk-chain-ass! (dk-cite! 'laurent-nonzero-ord 'kq_ 'fq_)))))
        (dk-split-all!)
        (let* ((nz (dk-pick (lambda (h) (and (dk-head-is? h 'NOT) (dk-contains? h o))) "f(o) /= 0"))
               (bl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h o) (dk-contains? h 'fq_))) "below o")))
          (a5p-and! `(IN ,o ZZ) nz bl)
          (dk-chain-ass! (dk-cite! 'laurent-ord-eq 'kq_ 'fq_ o))
          (dk-cite! 'laurent-abs-nonzero 'kq_ 'rq_ 'fq_) (dk-split-all!)
          (let* ((e0 (dk-pick (lambda (h) (and (dk-head-is? h '=) (equal? (cadr h) af))) "|f| = r^ord f"))
                 (e1 (dk-rewrite-h! e0 '(LAURENT-ORD kq_ fq_) o)))
            (dk-cite! 'zz-in-rr o)
            (dk-cite! 'rpow-star-in-rr 'rq_ o)
            (use-em `(<= ,o 0)
              (lambda ()
                (let ((an (dk-chain-ass! (dk-cite! 'rpow-star-anti-exp 'rq_ o 0))))
                  (dk-cite! 'rpow-star-zero 'rq_)
                  (dk-cite! 'rpow-star-in-rr 'rq_ 0)
                  (dk-absurd! e1 an `(= (RPOW-STAR rq_ 0) 1) `(< ,af 1))))
              (lambda ()
                (dk-cite! 'rr-not-le-lt o 0)
                (fact 'zz-zero-in)
                (dk-chain-ass! (dk-cite! 'zz-lt-succ-le 0 o))
                (dk-have! `(<= 1 ,o) (lambda () (dk-ineq! `(<= (+ 0 1) ,o))))
                (let ((an (dk-chain-ass! (dk-cite! 'rpow-star-anti-exp 'rq_ 1 o))))
                  (dk-cite! 'rpow-star-one 'rq_)
                  (dk-cite! 'rpow-star-in-rr 'rq_ 1)
                  (dk-ineq! e1 an '(= (RPOW-STAR rq_ 1) rq_)))))))))))
(qed 'laurent-abs-lt-one)

;; x = LAURENT-MONO(K, 1, 1) is a local uniformizer of F_q((x))
(define a5p-x1 '(LAURENT-MONO kq_ (ONE kq_) 1))
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-FIELD-RING kq_) (IMPLIES (IN (CARD (CARR kq_)) NN)
  (FORALL rq_ (IMPLIES (IN rq_ RR) (IMPLIES (< 0 rq_) (IMPLIES (< rq_ 1) (IS-LOCAL-UNIFORMIZER ,a5p-lnf ,a5p-x1))))))))))
(dk-peel!)
(a5p-lk!)
(let* ((lnf a5p-lnf) (x1 a5p-x1) (nx1 (a5p-n lnf x1)))
  (dk-chain-ass! (dk-cite! 'laurent-nf-is-nv-field 'kq_ 'rq_))
  (dk-chain-ass! (dk-cite! 'laurent-integers-compact 'kq_ 'rq_))
  (fact 'zz-one-in) (fact 'rr-one-in) (fact 'rr-zero-in)
  (dk-cite! 'laurent-x-power-abs 'kq_ 'rq_ 1) (dk-split-all!)
  (dk-cite! 'rpow-star-one 'rq_)
  (a5p-nf! x1)
  (dk-cite! 'laurent-nf-fnrm-apply 'kq_ 'rq_ x1)
  (dk-cite! 'nf-norm-in-rr lnf x1)
  (dk-cite! 'rpow-star-in-rr 'rq_ 1)
  (dk-cite! 'laurent-abs-in-rr 'kq_ 'rq_ x1) (dk-split-all!)
  (let ((eqs (list `(= ,nx1 ,(a5p-abs x1)) `(= ,(a5p-abs x1) (RPOW-STAR rq_ 1)) '(= (RPOW-STAR rq_ 1) rq_))))
    (dk-have! `(< 0 ,nx1) (lambda () (apply dk-ineq! '(< 0 rq_) eqs)))
    (dk-have! `(< ,nx1 1) (lambda () (apply dk-ineq! '(< rq_ 1) eqs)))
    (dk-have! (a5p-gap lnf x1)
      (lambda ()
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (h (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed)))
               (lt (find-first (lambda (f) (dk-head-is? f '<)) landed)))
          (a5p-ls! h)
          (dk-cite! 'laurent-nf-fnrm-apply 'kq_ 'rq_ h)
          (dk-cite! 'laurent-abs-in-rr 'kq_ 'rq_ h) (dk-split-all!)
          (dk-cite! 'nf-norm-in-rr lnf h)
          (let ((lt2 (dk-rewrite-h! lt (a5p-n lnf h) (a5p-abs h))))
            (dk-chain-ass! (dk-cite! 'laurent-abs-lt-one 'kq_ 'rq_ h))
            (apply dk-ineq! `(<= ,(a5p-abs h) rq_) `(= ,(a5p-n lnf h) ,(a5p-abs h)) eqs)))))
    (dk-chain-ass! (dk-cite! 'nv-local-uniformizer-of-gap lnf x1))
    (dk-close-if-asm!)))
(qed 'laurent-local-uniformizer)

;;; ===========================================================================
;;; 3. THE PAIRING W(g, f) = chi(a_0(f g)) AND ITS SECTIONS z |-> chi(a_0(y z)).
;;; ===========================================================================
(define a5p-ms `(NF-METRIC-SPACE ,a5p-lnf))
(define a5p-w '(LAURENT-PAIRING kq_ a5c))
(define (a5p-phi y) `(VNB-LAMBDA a5z_ (CARR ,a5p-lnf) (a5c ((LAURENT-MUL kq_ ,y a5z_) 0))))
(define a5p-hom
  '(FORALL chx_ (IMPLIES (IN chx_ (CARR kq_)) (FORALL chy_ (IMPLIES (IN chy_ (CARR kq_))
     (= (a5c ((ADD kq_) chx_ chy_)) (* (a5c chx_) (a5c chy_))))))))
(define a5p-chity '(IN a5c (FUN (CARR kq_) UNIT-CIRCLE)))
(define (a5p-ch body) `(FORALL a5c (IMPLIES ,a5p-chity (IMPLIES ,a5p-hom ,body))))
(define (a5p-lm f g) `(LAURENT-MUL kq_ ,f ,g))
;; (IN (CARR LNF) SET) and (IN LS SET)
(define (a5p-sets!)
  (dk-cite! 'ring-carr-in-set a5p-lr)
  (dk-rewrite-h! `(IN (CARR ,a5p-lr) SET) `(CARR ,a5p-lr) a5p-ls)
  (dk-rewrite-h! `(IN (CARR ,a5p-lr) SET) `(CARR ,a5p-lr) `(CARR ,a5p-lnf)))
;; coefficient typing: (IN ((L-MUL v u) 0) (CARR K)) and (IN (chi ..) UNIT-CIRCLE)
(define (a5p-coeff! v u)
  (let ((c `(,(a5p-lm v u) 0)))
    (dk-cite! 'laurent-mul-in 'kq_ v u)
    (dk-cite! 'lp-coeff-in 'kq_ (a5p-lm v u) 0)
    (a5p-and! a5p-chity `(IN ,c (CARR kq_)))
    (dk-cite! 'fun-apply-type 'a5c '(CARR kq_) 'UNIT-CIRCLE c)
    c))
;; rewrite W(u, v) in the goal to chi(a_0(v u))
(define (a5p-value! u v)
  (a5p-coeff! v u)
  (subst (dk-cite! 'lp-value 'kq_ 'a5c u v)))

;; a coefficient of a Laurent series lies in K
