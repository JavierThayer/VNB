;;; theorem-library/push-forward.scm -- Borel preimages under a continuous map,
;;; the push-forward of a measure, and the change of variables formula (RM-3B,
;;; 2026-10-10).  Vocabulary: structure-library/push-forward.scm (PUSH-FORWARD).
;;; Source: Thayer, Construction of Measures, Prop. 1.19 and Ch. 2 s. 7,
;;; Prop. 2.32.  Helper prefix: pfw-.
;;;
;;; THE HEADLINES.
;;;   pfw-preimage-sigma-algebra  for h : omega -> omega2 and a sigma-algebra cA on
;;;                               omega, the sets of omega2 whose preimage is in cA
;;;                               form a sigma-algebra on omega2.
;;;   pfw-borel-preimage          (item 1) h continuous from s to t: the preimage of a
;;;                               Borel set of t is a Borel set of s;
;;;   pfw-continuous-borel-measurable  the same as IS-MEASURABLE-MAP of the Borel sets.
;;;   pfw-push-forward-measure    (item 2) the push-forward of a measure along a
;;;                               measurable map is a measure.
;;;   pfw-change-of-variables     (item 3) f >= 0 measurable on omega2: f o h is
;;;                               measurable and INTEGRAL(f, h_* mu) = INTEGRAL(f o h, mu).
;;;   pfw-change-of-variables-real  f real measurable on omega2: f integrable for h_* mu
;;;                               iff f o h integrable for mu, and then the RINTEGRALs agree.
;;;
;;; The composite f o h is the lambda (VNB-LAMBDA pwz_ omega (f (h pwz_))).
;;;
;;; No top-level macro: the file may be compiled.

;;; =====================================================================
;;; (0) the pfw- kit (file-local; several from product-measure.scm's pms- kit)
;;; =====================================================================

(define (pfw-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; dk-project!, except that a claim equal to the focus goal is proved in place
(define (pfw-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
;;; sequential map (MIT evaluates arguments right to left)
(define (pfw-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
;;; the right-hand conjuncts of an IFF in context whose left side is in context, landed
(define (pfw-iff-parts! iff)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (pfw-map (lambda (c) (pfw-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))) cs)))
;;; (IN w (SEP v A P)) in context: land (IN w A) and P[w], the membership kept; return P[w].
;;; Proved as ONE conjunction on a lane (never in place: either part may be the focus goal).
(define (pfw-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s (caddr m)) (v (cadr s)) (dom (caddr s))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "pfw-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (ai (dk-ctx-form conj))))
    p))
;;; class extensionality, each direction driven: FWD / BWD procedures of the element
(define (pfw-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))
;;; w in BIG-UNION(n_, NN, g(n_)) gives the index and w in g(index): returns (k . formula)
(define (pfw-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
;;; prove the focus goal (IN w bu) at the index k (w in the k-th term in context)
(define (pfw-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
;;; f in FUN(NN, A) and every f(k) in B: f in FUN(NN, B)
(define (pfw-retype! fv a b in-b!)
  (dk-have! (list 'IN fv (list 'FUN 'NN b))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c fv 'NN a kv)
                (pfw-then-ass! (lambda () (in-b! (list fv kv)))))
              (begin
                (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN fv (list 'FUN 'NN a))))))
                (ass))))))))
;;; a function symbol G in FUN(DOM, COD) with G(k) == BODY(k): returns (G . VALUE-EQUATION)
(define (pfw-abstract! dom cod body-of typer pre)
  (let* ((body  (body-of 'pwak_))
         (lam   (list 'VNB-LAMBDA 'pwak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'pwak_ (list 'IMPLIES (list 'IN 'pwak_ dom)
                                                    (list '== (list g 'pwak_) body)))))
         (claim (list 'FORSOME 'pwag_ (list 'AND (list 'IN 'pwag_ (list 'FUN dom cod))
                                            (vals 'pwag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!))))
                (let ((kv (dk-di-var!)))
                  (pre kv)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "pfw-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "pfw-abstract!: the value equation did not land"))))
      (cons g ve))))

;;; the preimage {x in om : h(x) in c}
(define (pfw-pre om h c) (list 'SEP 'pwx_ om (list 'IN (list h 'pwx_) c)))

;;; =====================================================================
;;; (1) the vocabulary: unfold and value
;;; =====================================================================

(sp (make-wff '(FORALL omega (FORALL cB (FORALL mu (FORALL h
  (== (PUSH-FORWARD omega cB mu h) (VNB-LAMBDA pwb_ cB (mu (SEP pwx_ omega (IN (h pwx_) pwb_)))))))))))
(dk-peel!)
(mac 'PUSH-FORWARD)
(qrfl)
(qed 'pfw-push-forward-unfold)

(sp (make-wff '(FORALL omega (FORALL cB (FORALL mu (FORALL h (FORALL b
  (IMPLIES (IN b cB)
    (== ((PUSH-FORWARD omega cB mu h) b) (mu (SEP pwx_ omega (IN (h pwx_) b))))))))))))
(dk-peel!)
(subst (dk-cite! 'pfw-push-forward-unfold 'omega 'cB 'mu 'h))
(if (not (dk-lam-b!)) (qrfl))
(qed 'pfw-push-forward-value)

;;; =====================================================================
;;; (2) the preimage sigma-algebra
;;; =====================================================================

(define pfw-cls '(SEP pwe_ (POWER omega2) (IN (SEP pwx_ omega (IN (h pwx_) pwe_)) cA)))
(define (pfw-sec c) (pfw-pre 'omega 'h c))

(sp (make-wff (forall-guarded '(omega cA omega2 h)
                '((IS-SIGMA-ALGEBRA omega cA) (IN omega2 SET) (IN h (FUN omega omega2)))
   (list 'IS-SIGMA-ALGEBRA 'omega2 pfw-cls))))
(dk-peel!)
(fact 'power-set 'omega2)
(let* ((sc pfw-cls)
       (sc-parts! (lambda (c) (pfw-sep-parts! (list 'IN c sc))))
       (hw! (lambda (w) (fact 'fun-apply-type-c 'h 'omega 'omega2 w))))
  (mac 'IS-SIGMA-ALGEBRA)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-ass!) #t)
              ((dk-head-is? g 'SUBSET)
               (mac 'subset-def)
               (let ((zv (dk-di-var!)))
                 (sc-parts! zv)
                 (ass)))
              ((dk-head-is? g 'IN)
               ;; omega2 itself: its preimage is omega
               (fact 'power-whole-in 'omega2)
               (fact 'sigma-algebra-whole-in 'omega 'cA)
               (pfw-ext2! (pfw-sec 'omega2) 'omega
                 (lambda (w) (pfw-sep-parts! (list 'IN w (pfw-sec 'omega2))) (ass))
                 (lambda (w) (hw! w) (in-sep! dk-ass! dk-ass!)))
               (in-sep! dk-ass! (lambda () (pfw-then-ass! (lambda () (subst (list '= (pfw-sec 'omega2) 'omega)))))))
              ((dk-contains? g 'COMPLEMENT-IN)
               (dk-peel!)
               (let* ((tgt (cadr (dk-goal))) (av (caddr tgt))
                      (rhs (list 'COMPLEMENT-IN 'omega (pfw-sec av))))
                 (sc-parts! av)
                 (fact 'power-complement-closed 'omega2 av)
                 (fact 'sigma-algebra-complement-closed 'omega 'cA (pfw-sec av))
                 (pfw-ext2! (pfw-sec tgt) rhs
                   (lambda (w)
                     (pfw-sep-parts! (list 'IN w (pfw-sec tgt)))
                     (pfw-iff-parts! (dk-cite! 'complement-in-membership 'omega2 av (list 'h w)))
                     (mac 'complement-in-membership)
                     (dk-conj-close!
                       (lambda ()
                         (if (not (dk-ass!))
                             (begin
                               (di)
                               (pfw-sep-parts! (list 'IN w (pfw-sec av)))
                               (ai (list 'NOT (list 'IN (list 'h w) av))))))))
                   (lambda (w)
                     (pfw-iff-parts! (dk-cite! 'complement-in-membership 'omega (pfw-sec av) w))
                     (hw! w)
                     (in-sep! dk-ass!
                       (lambda ()
                         (mac 'complement-in-membership)
                         (dk-conj-close!
                           (lambda ()
                             (if (not (dk-ass!))
                                 (begin
                                   (di)
                                   (dk-have! (list 'IN w (pfw-sec av)) (lambda () (in-sep! dk-ass! dk-ass!)))
                                   (ai (list 'NOT (list 'IN w (pfw-sec av))))))))))))
                 (in-sep! dk-ass! (lambda () (pfw-then-ass! (lambda () (subst (list '= (pfw-sec tgt) rhs))))))))
              (#t
               (let* ((landed (dk-peel!))
                      (fv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (dk-head-is? (caddr f) 'FUN))) landed)))
                      (tgt (cadr (dk-goal)))
                      (fk! (lambda (kv) (fact 'fun-apply-type-c fv 'NN sc kv) (sc-parts! (list fv kv))))
                      (gr (pfw-abstract! 'NN 'cA (lambda (k) (pfw-sec (list fv k)))
                            (lambda (kv) (pfw-then-ass! (lambda () (fk! kv))))
                            (lambda (kv) (fk! kv) (fact 'membership-implies-sethood (pfw-sec (list fv kv)) 'cA))))
                      (gv (car gr)) (ge (cdr gr))
                      (gk! (lambda (kv) (fk! kv) (dk-apply! ge kv)))
                      (bug (list 'BIG-UNION 'n_ 'NN (list gv 'n_)))
                      (lhs (pfw-sec tgt)))
                 (pfw-retype! fv sc '(POWER omega2)
                   (lambda (x) (pfw-project! (list 'IN x '(POWER omega2))
                                 (lambda () (sep-me (dk-ctx-form (list 'IN x sc))) (dk-split-all!)))))
                 (fact 'power-fun-union-closed 'omega2 fv)
                 (fact 'sigma-algebra-union-closed 'omega 'cA gv)
                 (pfw-ext2! lhs bug
                   (lambda (w)
                     (pfw-sep-parts! (list 'IN w lhs))
                     (let* ((r (pfw-bu-open! (list 'h w) tgt)) (kv (car r)))
                       (gk! kv)
                       (dk-have! (list 'IN w (list gv kv))
                         (lambda () (subst (list '= (list gv kv) (pfw-sec (list fv kv))))
                                    (in-sep! dk-ass! dk-ass!)))
                       (pfw-bu-close! kv)))
                   (lambda (w)
                     (let* ((r (pfw-bu-open! w bug)) (kv (car r)))
                       (gk! kv)
                       (let ((hh (dk-rewrite-h! (cdr r) (list gv kv) (pfw-sec (list fv kv)))))
                         (pfw-sep-parts! hh)
                         (in-sep! dk-ass! (lambda () (pfw-bu-close! kv)))))))
                 (in-sep! dk-ass! (lambda () (pfw-then-ass! (lambda () (subst (list '= lhs bug)))))))))))))
(qed 'pfw-preimage-sigma-algebra)

;;; =====================================================================
;;; (3) Borel sets: a sigma-algebra containing the open sets; preimages
;;; =====================================================================

(define (pfw-gens s) (list 'SEP 'mou_ (list 'POWER (list 'PTS s)) (list 'IS-OPEN s 'mou_)))
;;; (SUBSET gens(s) (POWER (PTS s))), landed
(define (pfw-gens-sub! s)
  (dk-have! (list 'SUBSET (pfw-gens s) (list 'POWER (list 'PTS s)))
    (lambda () (mac 'subset-def)
      (let ((uv (dk-di-var!)))
        (pfw-sep-parts! (list 'IN uv (pfw-gens s)))
        (ass)))))

(sp (make-wff (forall-guarded '(s) '((IS-METRIC-SPACE s)) '(IS-SIGMA-ALGEBRA (PTS s) (BOREL-SETS s)))))
(dk-peel!)
(fact 'ms-pts-is-set 's)
(pfw-gens-sub! 's)
(fact 'sigma-generated-is-sigma-algebra '(PTS s) (pfw-gens 's))
(subst (dk-cite! 'borel-sets-unfold 's))
(ass)
(qed 'pfw-borel-sigma-algebra)

(sp (make-wff (forall-guarded '(s u) '((IS-OPEN s u)) '(IN u (BOREL-SETS s)))))
(dk-peel!)
(let* ((pts '(PTS s)) (gens (pfw-gens 's)) (sg (list 'SIGMA-GENERATED pts gens)))
  (dk-project! '(IS-METRIC-SPACE s) 'is-open '(IS-OPEN s u))
  (dk-project! (list 'SUBSET 'u pts) 'is-open '(IS-OPEN s u))
  (fact 'ms-pts-is-set 's)
  (fact 'subclass-of-set-is-set 'u pts)
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ u) (list 'IN 'z_ pts)))
    (lambda () (let ((zv (dk-di-var!))) (fact 'subset-mem-fwd 'u pts zv) (ass))))
  (fact 'power-mem-intro pts 'u)
  (dk-have! (list 'IN 'u gens) (lambda () (in-sep! dk-ass! dk-ass!)))
  (dk-have! (list 'FORALL 'cb_ (list 'IMPLIES (list 'AND (list 'IS-SIGMA-ALGEBRA pts 'cb_) (list 'SUBSET gens 'cb_))
                                     (list 'IN 'u 'cb_)))
    (lambda ()
      (dk-peel!)
      (dk-split-all!)
      (let ((cbv (caddr (dk-goal))))
        (fact 'subset-mem-fwd gens cbv 'u)
        (ass))))
  (fact 'sigma-generated-intro pts gens 'u)
  (subst (dk-cite! 'borel-sets-unfold 's))
  (ass))
(qed 'pfw-open-borel)

;;; ITEM 1: the preimage of a Borel set under a continuous map is a Borel set.
(sp (make-wff (forall-guarded '(s t h eb) '((IS-CONTINUOUS s t h) (IN eb (BOREL-SETS t)))
   (list 'IN (pfw-pre '(PTS s) 'h 'eb) '(BOREL-SETS s)))))
(dk-peel!)
(let* ((ps '(PTS s)) (pt '(PTS t))
       (pre (lambda (c) (pfw-pre ps 'h c)))
       (cls (list 'SEP 'pwe_ (list 'POWER pt) (list 'IN (pre 'pwe_) '(BOREL-SETS s))))
       (gt (pfw-gens 't)))
  (dk-project! '(IS-METRIC-SPACE s) 'is-continuous '(IS-CONTINUOUS s t h))
  (dk-project! '(IS-METRIC-SPACE t) 'is-continuous '(IS-CONTINUOUS s t h))
  (dk-project! (list 'IN 'h (list 'FUN ps pt)) 'is-continuous '(IS-CONTINUOUS s t h))
  (fact 'ms-pts-is-set 't)
  (dk-cite! 'pfw-borel-sigma-algebra 's)
  (dk-cite! 'pfw-preimage-sigma-algebra ps '(BOREL-SETS s) pt 'h)
  (let ((opp (dk-cite! 'continuous-implies-open-preimage 's 't 'h)))
    (dk-have! (list 'SUBSET gt cls)
      (lambda ()
        (mac 'subset-def)
        (let ((v (dk-di-var!)))
          (pfw-sep-parts! (list 'IN v gt))
          (dk-apply! opp v)
          (let ((pv (list 'PREIMAGE 's 'h v)))
            (pfw-ext2! (pre v) pv
              (lambda (w)
                (pfw-sep-parts! (list 'IN w (pre v)))
                (mac 'preimage-membership)
                (dk-conj-close! dk-ass!))
              (lambda (w)
                (pfw-iff-parts! (dk-cite! 'preimage-membership 's 'h v w))
                (in-sep! dk-ass! dk-ass!)))
            (dk-rewrite-h! (list 'IS-OPEN 's pv) pv (pre v))
            (dk-cite! 'pfw-open-borel 's (pre v))
            (in-sep! dk-ass! dk-ass!)))))
    (dk-cite! 'borel-sets-unfold 't)
    (dk-rewrite-h! '(IN eb (BOREL-SETS t)) '(BOREL-SETS t) (list 'SIGMA-GENERATED pt gt))
    (dk-cite! 'sigma-generated-in-every pt gt 'eb cls)
    (pfw-sep-parts! (list 'IN 'eb cls))
    (ass)))
(qed 'pfw-borel-preimage)

;;; ... in the form IS-MEASURABLE-MAP of the Borel sigma-algebras.
(sp (make-wff (forall-guarded '(s t h) '((IS-CONTINUOUS s t h))
   '(IS-MEASURABLE-MAP (PTS s) (BOREL-SETS s) (PTS t) (BOREL-SETS t) h))))
(dk-peel!)
(dk-project! '(IS-METRIC-SPACE s) 'is-continuous '(IS-CONTINUOUS s t h))
(dk-project! '(IS-METRIC-SPACE t) 'is-continuous '(IS-CONTINUOUS s t h))
(dk-project! '(IN h (FUN (PTS s) (PTS t))) 'is-continuous '(IS-CONTINUOUS s t h))
(dk-cite! 'pfw-borel-sigma-algebra 's)
(dk-cite! 'pfw-borel-sigma-algebra 't)
(dk-have! '(FORALL b_ (IMPLIES (IN b_ (BOREL-SETS t)) (IN (SEP x_ (PTS s) (IN (h x_) b_)) (BOREL-SETS s))))
  (lambda () (let ((bv (dk-di-var!))) (dk-cite! 'pfw-borel-preimage 's 't 'h bv) (ass))))
(dk-cite! 'measurable-map-intro '(PTS s) '(BOREL-SETS s) '(PTS t) '(BOREL-SETS t) 'h)
(ass)
(qed 'pfw-continuous-borel-measurable)

;;; a measurable map stays measurable for a larger sigma-algebra on its source
(sp (make-wff (forall-guarded '(omega cA omega2 cB h cA2)
                '((IS-MEASURABLE-MAP omega cA omega2 cB h) (IS-SIGMA-ALGEBRA omega cA2) (SUBSET cA cA2))
   '(IS-MEASURABLE-MAP omega cA2 omega2 cB h))))
(dk-peel!)
(fact 'measurable-map-target-algebra 'omega 'cA 'omega2 'cB 'h)
(fact 'measurable-map-in-fun 'omega 'cA 'omega2 'cB 'h)
(dk-have! '(FORALL b_ (IMPLIES (IN b_ cB) (IN (SEP x_ omega (IN (h x_) b_)) cA2)))
  (lambda ()
    (let ((bv (dk-di-var!)))
      (dk-cite! 'measurable-map-preimage 'omega 'cA 'omega2 'cB 'h bv)
      (dk-cite! 'subset-mem-fwd 'cA 'cA2 (pfw-pre 'omega 'h bv))
      (ass))))
(dk-cite! 'measurable-map-intro 'omega 'cA2 'omega2 'cB 'h)
(ass)
(qed 'pfw-measurable-map-enlarge)

;;; =====================================================================
;;; (4) ITEM 2: the push-forward of a measure is a measure
;;; =====================================================================

(sp (make-wff (forall-guarded '(omega cA mu omega2 cB h)
                '((IS-MEASURE omega cA mu) (IS-MEASURABLE-MAP omega cA omega2 cB h))
   '(IS-MEASURE omega2 cB (PUSH-FORWARD omega cB mu h)))))
(dk-peel!)
(dk-cite! 'measure-pushforward 'omega 'cA 'mu 'omega2 'cB 'h)
(subst (dk-cite! 'pfw-push-forward-unfold 'omega 'cB 'mu 'h))
(ass)
(qed 'pfw-push-forward-measure)

;;; =====================================================================
;;; (5) the composite f o h: value, typing, measurability, level sets
;;; =====================================================================

(define (pfw-comp om f h) (list 'VNB-LAMBDA 'pwz_ om (list f (list h 'pwz_))))
(define (pfw-ptw dom body-of) (list 'FORALL 'pwv_ (list 'IMPLIES (list 'IN 'pwv_ dom) (body-of 'pwv_))))
;;; the conjuncts of a predicate's defining iff, landed (hypothesis kept)
(define (pfw-parts! pred args)
  (let* ((iff (apply dk-cite! (cons pred args)))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (pfw-map (lambda (c) (dk-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))) cs)))
;;; close the focus goal, a conjunct of the predicate's defining iff
(define (pfw-close-by-parts! pred args)
  (let ((iff (apply dk-cite! (cons pred args))))
    (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!) (ass)))
;;; dk-apply! of a one-binder guarded universal, tolerant of an instance already in context
(define (pfw-apply1! f t)
  (let ((c (subst-free (quantifier-var f) t (caddr (quantifier-body f)))))
    (if (dk-asm? c) (dk-ctx-form c) (dk-apply! f t))))

(sp (make-wff (forall-guarded '(omega f h x) '((IN x omega))
   (list '== (list (pfw-comp 'omega 'f 'h) 'x) '(f (h x))))))
(dk-peel!)
(if (not (dk-lam-b!)) (qrfl))
(qed 'pfw-comp-apply)

(sp (make-wff (forall-guarded '(omega omega2 cod f h) '((IN omega SET) (IN h (FUN omega omega2)) (IN f (FUN omega2 cod)))
   (list 'IN (pfw-comp 'omega 'f 'h) '(FUN omega cod)))))
(dk-peel!)
(dk-lam-type!
  (lambda ()
    (let ((zv (dk-di-var!)))
      (fact 'fun-apply-type-c 'h 'omega 'omega2 zv)
      (fact 'fun-apply-type-c 'f 'omega2 'cod (list 'h zv))
      (ass)))
  (lambda () (ass)))
(qed 'pfw-comp-fun)

;;; {lb in om : P((f o h)(lb))} = h^-1({lb2 in om2 : P(f(lb2))}); landed, returned.
;;; PR builds the formula P(t) from the term t.  (IN h (FUN om om2)) must be in context.
(define (pfw-comp-level-eq! om om2 f h pr lb lb2)
  (let* ((k (pfw-comp om f h))
         (lhs (list 'SEP lb om (pr (list k lb))))
         (lev (list 'SEP lb2 om2 (pr (list f lb2))))
         (rhs (pfw-pre om h lev)))
    (pfw-ext2! lhs rhs
      (lambda (w)
        (pfw-sep-parts! (list 'IN w lhs))
        (dk-cite! 'pfw-comp-apply om f h w)
        (dk-rewrite-h! (pr (list k w)) (list k w) (list f (list h w)))
        (fact 'fun-apply-type-c h om om2 w)
        (in-sep! dk-ass! (lambda () (in-sep! dk-ass! dk-ass!))))
      (lambda (w)
        (pfw-sep-parts! (list 'IN w rhs))
        (pfw-sep-parts! (list 'IN (list h w) lev))
        (dk-cite! 'pfw-comp-apply om f h w)
        (in-sep! dk-ass! (lambda () (pfw-then-ass! (lambda () (subst (list '== (list k w) (list f (list h w))))))))))
    (list '= lhs rhs)))

;;; the measurable-map hypotheses, opened
(define (pfw-map-parts!)
  (fact 'measurable-map-source-algebra 'omega 'cA 'omega2 'cB 'h)
  (fact 'measurable-map-target-algebra 'omega 'cA 'omega2 'cB 'h)
  (fact 'measurable-map-in-fun 'omega 'cA 'omega2 'cB 'h)
  (fact 'sigma-algebra-ambient-set 'omega 'cA)
  (fact 'sigma-algebra-ambient-set 'omega2 'cB))

;;; f o h is measurable when f is ([0, +inf]-valued)
(sp (make-wff (forall-guarded '(omega cA omega2 cB h f)
                '((IS-MEASURABLE-MAP omega cA omega2 cB h) (IS-MEASURABLE-FN omega2 cB f))
   (list 'IS-MEASURABLE-FN 'omega 'cA (pfw-comp 'omega 'f 'h)))))
(dk-peel!)
(pfw-map-parts!)
(let* ((mp (pfw-parts! 'is-measurable-fn '(omega2 cB f)))
       (tails (caddr mp)))
  (dk-cite! 'pfw-comp-fun 'omega 'omega2 'RR-POS-STAR 'f 'h)
  (mac 'IS-MEASURABLE-FN)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((av (dk-di-var!))
                 (eqn (pfw-comp-level-eq! 'omega 'omega2 'f 'h (lambda (t) (list '< av t)) 'x_ 'x_)))
            (dk-apply! tails av)
            (dk-cite! 'measurable-map-preimage 'omega 'cA 'omega2 'cB 'h (caddr (cadddr (caddr eqn))))
            (subst eqn)
            (ass))))))
(qed 'pfw-comp-measurable-fn)

;;; =====================================================================
;;; (6) ITEM 3, simple functions: s o h is simple and has the same integral
;;; =====================================================================

(define pfw-nu '(PUSH-FORWARD omega cB mu h))
(define pfw-v '(IMAGE s omega2))
(define (pfw-lev z) (list 'SEP 'six_ 'omega2 (list '= '(s six_) z)))
(define pfw-k (pfw-comp 'omega 's 'h))
(define (pfw-kl z) (list 'SEP 'fx_ 'omega (list '= (list pfw-k 'fx_) z)))
(define pfw-hh (list 'VNB-LAMBDA 'hv_ pfw-v 'hv_))
(define pfw-gg (list 'VNB-LAMBDA 'siy_ pfw-v (list 'etimes 'siy_ (list pfw-nu (pfw-lev 'siy_)))))

;;; v in the image of the simple s: (IN v RR), (<= 0 v), (IN v RR-POS-STAR)
(define (pfw-img-val! v)
  (let ((ex (dk-project! (list 'FORSOME 'x (list 'AND (list 'IN 'x 'omega2) (list '= '(s x) v)))
              (lambda () (let ((iff (dk-cite! 'image-membership-iff 's 'omega2 v)))
                           (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!))))))
    (if (not (dk-asm? (list 'IN v 'RR)))
        (dk-have! (list 'IN v 'RR)
          (lambda ()
            (let ((pv (dk-skolem! ex)))
              (dk-apply! (dk-ctx-form (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ 'omega2) '(IN (s x_) RR)))) pv)
              (subst (list '= v (list 's pv)))
              (ass)))))
    (if (not (dk-asm? (list '<= 0 v)))
        (dk-have! (list '<= 0 v)
          (lambda ()
            (let ((pv (dk-skolem! ex)))
              (fact 'fun-apply-type-c 's 'omega2 'RR-POS-STAR pv)
              (fact 'rr-pos-star-nonneg (list 's pv))
              (subst (list '= v (list 's pv)))
              (ass)))))
    (if (not (dk-asm? (list 'IN v 'RR-POS-STAR)))
        (fact 'image-subset-codomain 'omega2 'RR-POS-STAR 's v))))
;;; (IN (s p) V) for p in omega2
(define (pfw-img-in! p)
  (if (not (dk-asm? (list 'IN (list 's p) pfw-v)))
      (dk-have! (list 'IN (list 's p) pfw-v)
        (lambda ()
          (fact 'fun-apply-type-c 's 'omega2 'RR-POS-STAR p)
          (fact 'membership-implies-sethood (list 's p) 'RR-POS-STAR)
          (mac 'image-membership-iff)
          (dk-conj-close!
            (lambda ()
              (cond ((dk-ass!) #t)
                    ((dk-head-is? (dk-goal) 'FORSOME) (ew p) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl)))))
                    (#t (error "pfw-img-in!" (dk-goal))))))))))

(sp (make-wff (forall-guarded '(omega cA mu omega2 cB h s)
                '((IS-MEASURE omega cA mu) (IS-MEASURABLE-MAP omega cA omega2 cB h) (IS-SIMPLE-FN omega2 cB s))
   (list 'AND (list 'IS-SIMPLE-FN 'omega 'cA pfw-k)
              (list '= (list 'INTEGRAL 'omega2 'cB pfw-nu 's) (list 'INTEGRAL 'omega 'cA 'mu pfw-k))))))
(dk-peel!)
(pfw-map-parts!)
(dk-cite! 'pfw-push-forward-measure 'omega 'cA 'mu 'omega2 'cB 'h)
(pfw-parts! 'is-measure '(omega cA mu))
(pfw-parts! 'is-measure (list 'omega2 'cB pfw-nu))
(pfw-parts! 'is-simple-fn '(omega2 cB s))
(pfw-parts! 'is-measurable-fn '(omega2 cB s))
(fact 'image-set 's 'omega2)
(dk-cite! 'pfw-comp-fun 'omega 'omega2 'RR-POS-STAR 's 'h)
(let* ((v pfw-v) (k pfw-k) (hh pfw-hh) (gg pfw-gg) (nu pfw-nu)
       (pre (lambda (c) (pfw-pre 'omega 'h c)))
       (a-of (lambda (z) (list '= (pfw-kl z) (pre (pfw-lev z)))))
       (fa (pfw-ptw v a-of)))
  ;; (A) the level sets of s o h are the preimages of those of s
  (dk-have! fa
    (lambda ()
      (let ((zv (dk-di-var!)))
        (pfw-img-val! zv)
        (pfw-comp-level-eq! 'omega 'omega2 's 'h (lambda (t) (list '= t zv)) 'fx_ 'six_)
        (ass))))
  ;; (B) the level sets of s are in cB; (C) those of s o h in cA
  (dk-have! (pfw-ptw v (lambda (z) (list 'IN (pfw-lev z) 'cB)))
    (lambda ()
      (let ((zv (dk-di-var!)))
        (pfw-img-val! zv)
        (dk-apply! (dk-fact! 'measurable-fn-level-set 'omega2 'cB 's) zv)
        (ass))))
  (dk-have! (pfw-ptw v (lambda (z) (list 'IN (pfw-kl z) 'cA)))
    (lambda ()
      (let ((zv (dk-di-var!)))
        (pfw-apply1! (dk-ctx-form (pfw-ptw v (lambda (z) (list 'IN (pfw-lev z) 'cB)))) zv)
        (pfw-apply1! (dk-ctx-form fa) zv)
        (dk-cite! 'measurable-map-preimage 'omega 'cA 'omega2 'cB 'h (pfw-lev zv))
        (subst (a-of zv))
        (ass))))
  ;; (D) s o h takes its values in V
  (dk-have! (pfw-ptw 'omega (lambda (z) (list 'IN (list k z) v)))
    (lambda ()
      (let ((zv (dk-di-var!)))
        (dk-cite! 'pfw-comp-apply 'omega 's 'h zv)
        (fact 'fun-apply-type-c 'h 'omega 'omega2 zv)
        (pfw-img-in! (list 'h zv))
        (subst (list '== (list k zv) (list 's (list 'h zv))))
        (ass))))
  ;; (E) the identity on V is real and non-negative
  (dk-have! (pfw-ptw v (lambda (z) (list 'IN (list hh z) 'RR)))
    (lambda () (let ((zv (dk-di-var!))) (pfw-img-val! zv) (if (not (dk-lam-b!)) (ass)))))
  (dk-have! (pfw-ptw v (lambda (z) (list '<= 0 (list hh z))))
    (lambda () (let ((zv (dk-di-var!))) (pfw-img-val! zv) (if (not (dk-lam-b!)) (ass)))))
  ;; (F) s o h = hh o (s o h)
  (dk-have! (pfw-ptw 'omega (lambda (z) (list '= (list k z) (list hh (list k z)))))
    (lambda ()
      (let ((zv (dk-di-var!)))
        (pfw-apply1! (dk-ctx-form (pfw-ptw 'omega (lambda (z) (list 'IN (list k z) v)))) zv)
        (fact 'fun-apply-type-c k 'omega 'RR-POS-STAR zv)
        (fact 'fun-apply-type-c 'h 'omega 'omega2 zv)
        (pfw-img-in! (list 'h zv))
        (if (not (dk-lam-b!)) (rfl)))))
  (fact 'simple-fn-of-partition 'omega 'cA v k hh k)
  (fact 'integral-simple 'omega 'cA 'mu k)
  ;; (I) the summand
  (dk-have! (pfw-ptw v (lambda (z) (list '= (list gg z) (list 'etimes (list hh z) (list 'mu (pfw-kl z))))))
    (lambda ()
      (let ((zv (dk-di-var!)))
        (pfw-img-val! zv)
        (pfw-apply1! (dk-ctx-form (pfw-ptw v (lambda (z) (list 'IN (pfw-lev z) 'cB)))) zv)
        (pfw-apply1! (dk-ctx-form (pfw-ptw v (lambda (z) (list 'IN (pfw-kl z) 'cA)))) zv)
        (pfw-apply1! (dk-ctx-form fa) zv)
        (dk-cite! 'pfw-push-forward-value 'omega 'cB 'mu 'h (pfw-lev zv))
        (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (pfw-kl zv))
        (fact 'fun-apply-type-c nu 'cB 'RR-POS-STAR (pfw-lev zv))
        (dk-cite! 'measurable-map-preimage 'omega 'cA 'omega2 'cB 'h (pfw-lev zv))
        (dk-have! (list 'IN (pre (pfw-lev zv)) 'cA) (lambda () (ass)))
        (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (pre (pfw-lev zv)))
        (dk-have! (list 'AND (list 'IN zv 'RR-POS-STAR) (list 'IN (list 'mu (pre (pfw-lev zv))) 'RR-POS-STAR))
          (lambda () (dk-conj-close! dk-ass!)))
        (fact 'etimes-closed zv (list 'mu (pre (pfw-lev zv))))
        (subst (list '= (pfw-kl zv) (pre (pfw-lev zv))))
        (dk-lam-b!)
        (subst (list '== (list nu (pfw-lev zv)) (list 'mu (pre (pfw-lev zv)))))
        (if (not (proof-done? *ps*)) (rfl)))))
  (fact 'simple-integral-partition 'omega 'cA 'mu k v k hh gg)
  (fact 'integral-simple 'omega2 'cB nu 's)
  (dk-cite! 'simple-integral-unfold 'omega2 nu 's)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (subst (list '= (list 'INTEGRAL 'omega 'cA 'mu k) (list 'SIMPLE-INTEGRAL 'omega 'mu k)))
            (subst (list '= (list 'SIMPLE-INTEGRAL 'omega 'mu k) (list 'FINSUM 'RR-POS-STAR-ADD-MONOID gg v)))
            (subst (list '= (list 'INTEGRAL 'omega2 'cB nu 's) (list 'SIMPLE-INTEGRAL 'omega2 nu 's)))
            (subst (list '== (list 'SIMPLE-INTEGRAL 'omega2 nu 's) (list 'FINSUM 'RR-POS-STAR-ADD-MONOID gg v)))
            (if (not (proof-done? *ps*)) (rfl)))))))
(qed 'pfw-simple-change-of-variables)

;;; =====================================================================
;;; (7) ITEM 3, f >= 0 measurable: monotone convergence on both sides
;;; =====================================================================

(define (pfw-lt! typer)
  (dk-lam-type! (lambda () (typer (dk-di-var!)))
                (lambda () (if (not (dk-ass!)) (pfw-then-ass! (lambda () (fact 'nn-is-set)))))))
;;; IS-MEASURABLE-FN of a simple function, landed -- or closed, when it is the focus goal
(define (pfw-simple-meas! om ca g)
  (let ((claim (list 'IS-MEASURABLE-FN om ca g)))
    (cond ((dk-asm? claim) #t)
          ((equal? claim (dk-goal)) (pfw-close-by-parts! 'is-simple-fn (list om ca g)))
          (#t (car (pfw-parts! 'is-simple-fn (list om ca g)))))))
(define (pfw-lb!) (if (dk--redex? (dk-goal)) (dk-lam-b!) #f))

(sp (make-wff (forall-guarded '(omega cA mu omega2 cB h f)
                '((IS-MEASURE omega cA mu) (IS-MEASURABLE-MAP omega cA omega2 cB h) (IS-MEASURABLE-FN omega2 cB f))
   (list 'AND (list 'IS-MEASURABLE-FN 'omega 'cA (pfw-comp 'omega 'f 'h))
              (list '= (list 'INTEGRAL 'omega2 'cB pfw-nu 'f) (list 'INTEGRAL 'omega 'cA 'mu (pfw-comp 'omega 'f 'h)))))))
(dk-peel!)
(pfw-map-parts!)
(dk-cite! 'pfw-push-forward-measure 'omega 'cA 'mu 'omega2 'cB 'h)
(dk-cite! 'pfw-comp-measurable-fn 'omega 'cA 'omega2 'cB 'h 'f)
(pfw-parts! 'is-measurable-fn '(omega2 cB f))
(dk-cite! 'pfw-comp-fun 'omega 'omega2 'RR-POS-STAR 'f 'h)
(let* ((nu pfw-nu)
       (kf (pfw-comp 'omega 'f 'h))
       (kc (lambda (k) (pfw-comp 'omega (list 'cf k) 'h)))
       (cfv (dk-skolem! (dk-fact! 'integral-simple-approx 'omega2 'cB 'f)))
       (simp (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'IS-SIMPLE-FN) (dk-contains? x cfv))) "the simple approximants"))
       (cfle (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'PTWISE-LE) (dk-contains? x cfv))) "monotonicity"))
       (cfsup (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'PTWISE-SUP) (dk-contains? x cfv))) "the supremum"))
       (kc (lambda (k) (pfw-comp 'omega (list cfv k) 'h)))
       (cft! (lambda (k) (fact 'fun-apply-type-c cfv 'NN '(FUN omega2 RR-POS-STAR) k)))
       ;; the simple case at cf k: (IS-SIMPLE-FN omega cA (kc k)), the integral equation, measurability
       (cfk! (lambda (k)
               (cft! k)
               (pfw-apply1! simp k)
               (dk-cite! 'pfw-comp-fun 'omega 'omega2 'RR-POS-STAR (list cfv k) 'h)
               (if (not (dk-asm? (list 'IS-SIMPLE-FN 'omega 'cA (kc k))))
                   (dk-split-all! (list (dk-cite! 'pfw-simple-change-of-variables 'omega 'cA 'mu 'omega2 'cB 'h (list cfv k)))))
               (pfw-simple-meas! 'omega 'cA (kc k))
               (pfw-simple-meas! 'omega2 'cB (list cfv k))))
       (tr (pfw-abstract! 'NN '(FUN omega RR-POS-STAR) kc
             (lambda (kv) (pfw-then-ass! (lambda () (cfk! kv))))
             (lambda (kv) (cfk! kv) (fact 'membership-implies-sethood (kc kv) '(FUN omega RR-POS-STAR)))))
       (tq (car tr)) (te (cdr tr))
       (tqk! (lambda (k) (cfk! k) (pfw-apply1! te k)))
       (psup (list 'PTWISE-SUP 'omega tq))
       (psup2 (list 'PTWISE-SUP 'omega2 cfv)))
  ;; the hypotheses of monotone convergence, both sides
  (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN 'omega2 'cB (list cfv 'n_))))
    (lambda () (let ((nv (dk-di-var!))) (pfw-then-ass! (lambda () (cfk! nv))))))
  (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN 'omega 'cA (list tq 'n_))))
    (lambda ()
      (let ((nv (dk-di-var!)))
        (tqk! nv)
        (pfw-then-ass! (lambda () (subst (list '== (list tq nv) (kc nv))))))))
  (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'PTWISE-LE 'omega (list tq 'n_) (list tq '(succ n_)))))
    (lambda ()
      (let* ((nv (dk-di-var!)) (sn (list 'succ nv)))
        (fact 'nn-succ-closed nv)
        (tqk! nv) (tqk! sn)
        (subst (list '== (list tq nv) (kc nv)))
        (subst (list '== (list tq sn) (kc sn)))
        (mac 'PTWISE-LE)
        (let* ((xv (dk-di-var!)) (hx (list 'h xv)))
          (fact 'fun-apply-type-c 'h 'omega 'omega2 xv)
          (dk-cite! 'pfw-comp-apply 'omega (list cfv nv) 'h xv)
          (dk-cite! 'pfw-comp-apply 'omega (list cfv sn) 'h xv)
          (pfw-apply1! cfle nv)
          (dk-apply! (car (pfw-parts! 'ptwise-le (list 'omega2 (list cfv nv) (list cfv sn)))) hx)
          (subst (list '== (list (kc nv) xv) (list (list cfv nv) hx)))
          (subst (list '== (list (kc sn) xv) (list (list cfv sn) hx)))
          (ass)))))
  (let* ((mct (dk-split! (dk-fact! 'monotone-convergence 'omega 'cA 'mu tq)))
         (mct-eq (find-first (lambda (x) (dk-head-is? x '=)) mct))
         (m1 (cadr (cadr (caddr mct-eq))))
         (mct2 (dk-split! (dk-fact! 'monotone-convergence 'omega2 'cB nu cfv)))
         (mct2-eq (find-first (lambda (x) (dk-head-is? x '=)) mct2))
         (m2 (cadr (cadr (caddr mct2-eq)))))
    (cadr (pfw-parts! 'is-measurable-fn (list 'omega 'cA psup)))
    (cadr (pfw-parts! 'is-measurable-fn (list 'omega2 'cB psup2)))
    ;; nu side: f is the pointwise sup of the cf n
    (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES '(IN icx_ omega2) (list '= '(f icx_) (list psup2 'icx_))))
      (lambda ()
        (let ((xv (dk-di-var!)))
          (pfw-apply1! cfsup xv)
          (fact 'fun-apply-type-c 'f 'omega2 'RR-POS-STAR xv)
          (subst (list '= (list 'f xv) (list psup2 xv)))
          (rfl))))
    (fact 'integral-congruence-ptwise 'omega2 'cB nu 'f psup2)
    ;; mu side: f o h is the pointwise sup of the (cf n) o h
    (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES '(IN icx_ omega) (list '= (list kf 'icx_) (list psup 'icx_))))
      (lambda ()
        (let* ((xv (dk-di-var!)) (hx (list 'h xv))
               (l1 (list 'VNB-LAMBDA 'n_ 'NN (list (list cfv 'n_) hx)))
               (l2 (list 'VNB-LAMBDA 'n_ 'NN (list (list tq 'n_) xv))))
          (fact 'fun-apply-type-c 'h 'omega 'omega2 xv)
          (dk-cite! 'pfw-comp-apply 'omega 'f 'h xv)
          (pfw-apply1! cfsup hx)
          (dk-cite! 'ptwise-sup-apply 'omega2 cfv hx)
          (dk-cite! 'ptwise-sup-apply 'omega tq xv)
          (fact 'fun-apply-type-c psup 'omega 'RR-POS-STAR xv)
          (dk-fun-ext! l1 l2 'NN 'RR-POS-STAR
            (lambda () (pfw-lt! (lambda (kv) (cft! kv)
                                  (pfw-then-ass! (lambda () (fact 'fun-apply-type-c (list cfv kv) 'omega2 'RR-POS-STAR hx))))))
            (lambda () (pfw-lt! (lambda (kv) (tqk! kv)
                                  (fact 'fun-apply-type-c tq 'NN '(FUN omega RR-POS-STAR) kv)
                                  (pfw-then-ass! (lambda () (fact 'fun-apply-type-c (list tq kv) 'omega 'RR-POS-STAR xv))))))
            (lambda (kv)
              (tqk! kv)
              (dk-cite! 'pfw-comp-apply 'omega (list cfv kv) 'h xv)
              (fact 'fun-apply-type-c (list cfv kv) 'omega2 'RR-POS-STAR hx)
              (pfw-lb!)
              (if (not (proof-done? *ps*))
                  (begin
                    (subst (list '== (list tq kv) (kc kv)))
                    (subst (list '== (list (kc kv) xv) (list (list cfv kv) hx)))
                    (if (not (proof-done? *ps*)) (rfl))))))
          (subst (list '== (list kf xv) (list 'f hx)))
          (subst (list '= (list 'f hx) (list psup2 hx)))
          (subst (list '== (list psup2 hx) (list 'ESUP (list 'IMAGE l1 'NN))))
          (subst (list '= l1 l2))
          (subst (list '== (list 'ESUP (list 'IMAGE l2 'NN)) (list psup xv)))
          (if (not (proof-done? *ps*)) (rfl)))))
    (fact 'integral-congruence-ptwise 'omega 'cA 'mu kf psup)
    ;; the two sequences of integrals agree, by the simple case
    (dk-fun-ext! m2 m1 'NN 'RR-POS-STAR
      (lambda () (pfw-lt! (lambda (kv) (cfk! kv)
                            (pfw-then-ass! (lambda () (fact 'integral-in 'omega2 'cB nu (list cfv kv)))))))
      (lambda () (pfw-lt! (lambda (kv)
                            (pfw-apply1! (dk-ctx-form (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IS-MEASURABLE-FN 'omega 'cA (list tq 'n_))))) kv)
                            (pfw-then-ass! (lambda () (fact 'integral-in 'omega 'cA 'mu (list tq kv)))))))
      (lambda (kv)
        (tqk! kv)
        (fact 'integral-in 'omega2 'cB nu (list cfv kv))
        (fact 'integral-in 'omega 'cA 'mu (kc kv))
        (pfw-lb!)
        (if (not (proof-done? *ps*))
            (begin
              (subst (list '== (list tq kv) (kc kv)))
              (if (not (proof-done? *ps*)) (ass))))))
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (subst (list '== (list 'INTEGRAL 'omega2 'cB nu 'f) (list 'INTEGRAL 'omega2 'cB nu psup2)))
              (subst mct2-eq)
              (subst (list '= m2 m1))
              (subst (list '== (list 'INTEGRAL 'omega 'cA 'mu kf) (list 'INTEGRAL 'omega 'cA 'mu psup)))
              (subst mct-eq)
              (if (not (proof-done? *ps*)) (rfl))))))))
(qed 'pfw-change-of-variables)

;;; =====================================================================
;;; (8) ITEM 3 for real f: positive and negative parts
;;; =====================================================================

;;; the positive (negative) part of f o h is (the positive (negative) part of f) o h
(define (pfw-part-comp! head valthm funthm)
  (dk-peel!)
  (let* ((kf (pfw-comp 'omega 'f 'h))
         (pp (list head 'omega2 'f))
         (kp (pfw-comp 'omega pp 'h))
         (xv (cadr (cadr (dk-goal))))
         (hx (list 'h xv)))
    (fact 'fun-apply-type-c 'h 'omega 'omega2 xv)
    (fact 'fun-apply-type-c 'f 'omega2 'RR hx)
    (dk-cite! funthm 'omega2 'f)
    (fact 'fun-apply-type-c pp 'omega2 'RR-POS-STAR hx)
    (dk-cite! 'pfw-comp-apply 'omega 'f 'h xv)
    (dk-cite! 'pfw-comp-apply 'omega pp 'h xv)
    (let ((pv (dk-cite! valthm 'omega2 'f hx))
          (kv (dk-cite! valthm 'omega kf xv)))
      (subst (list '== (list kp xv) (list pp hx)))
      (subst (list '== (list (list head 'omega kf) xv) (caddr kv)))
      (subst (list '== (list kf xv) (list 'f hx)))
      (subst (list '= (caddr pv) (list pp hx)))
      (if (not (proof-done? *ps*)) (rfl)))))

(sp (make-wff (forall-guarded '(omega omega2 f h) '((IN h (FUN omega omega2)) (IN f (FUN omega2 RR)))
   (pfw-ptw 'omega (lambda (x) (list '= (list (list 'POS-PART 'omega (pfw-comp 'omega 'f 'h)) x)
                                       (list (pfw-comp 'omega '(POS-PART omega2 f) 'h) x)))))))
(pfw-part-comp! 'POS-PART 'pos-part-value 'pos-part-fun)
(qed 'pfw-pos-part-comp)

(sp (make-wff (forall-guarded '(omega omega2 f h) '((IN h (FUN omega omega2)) (IN f (FUN omega2 RR)))
   (pfw-ptw 'omega (lambda (x) (list '= (list (list 'NEG-PART 'omega (pfw-comp 'omega 'f 'h)) x)
                                       (list (pfw-comp 'omega '(NEG-PART omega2 f) 'h) x)))))))
(pfw-part-comp! 'NEG-PART 'neg-part-value 'neg-part-fun)
(qed 'pfw-neg-part-comp)

;;; f o h is real measurable when f is
(sp (make-wff (forall-guarded '(omega cA omega2 cB h f)
                '((IS-MEASURABLE-MAP omega cA omega2 cB h) (IS-REAL-MEASURABLE-FN omega2 cB f))
   (list 'IS-REAL-MEASURABLE-FN 'omega 'cA (pfw-comp 'omega 'f 'h)))))
(dk-peel!)
(pfw-map-parts!)
(pfw-parts! 'is-real-measurable-fn '(omega2 cB f))
(dk-cite! 'pfw-comp-fun 'omega 'omega2 'RR 'f 'h)
(let ((tails (dk-cite! 'real-measurable-fn-tails 'omega2 'cB 'f)))
  (dk-have! (list 'FORALL 'al (list 'IMPLIES '(IN al RR)
              (list 'IN (list 'SEP 'x_ 'omega (list '< 'al (list (pfw-comp 'omega 'f 'h) 'x_))) 'cA)))
    (lambda ()
      (let* ((av (dk-di-var!))
             (eqn (pfw-comp-level-eq! 'omega 'omega2 'f 'h (lambda (t) (list '< av t)) 'x_ 'x_)))
        (dk-apply! tails av)
        (dk-cite! 'measurable-map-preimage 'omega 'cA 'omega2 'cB 'h (caddr (cadddr (caddr eqn))))
        (subst eqn)
        (ass))))
  (dk-cite! 'real-measurable-of-tails 'omega 'cA (pfw-comp 'omega 'f 'h))
  (ass))
(qed 'pfw-comp-real-measurable)

;;; the setting of the real case: lands the measurability of f o h, the two
;;; non-negative changes of variables, and the integral equations of the parts:
;;;   INTEGRAL(nu, PART(f)) = INTEGRAL(mu, PART(f) o h) == INTEGRAL(mu, PART(f o h)).
(define (pfw-real-setup!)
  (dk-peel!)
  (pfw-map-parts!)
  (dk-cite! 'pfw-push-forward-measure 'omega 'cA 'mu 'omega2 'cB 'h)
  (pfw-parts! 'is-real-measurable-fn '(omega2 cB f))
  (dk-cite! 'pfw-comp-fun 'omega 'omega2 'RR 'f 'h)
  (dk-cite! 'pfw-comp-real-measurable 'omega 'cA 'omega2 'cB 'h 'f)
  (let ((kf (pfw-comp 'omega 'f 'h)))
    (pfw-map
      (lambda (spec)
        (let* ((head (car spec)) (funthm (cadr spec)) (compthm (caddr spec))
               (pp (list head 'omega2 'f))
               (kp (pfw-comp 'omega pp 'h))
               (pk (list head 'omega kf)))
          (dk-cite! funthm 'omega2 'f)
          (dk-cite! funthm 'omega kf)
          (dk-cite! 'pfw-comp-fun 'omega 'omega2 'RR-POS-STAR pp 'h)
          (dk-split-all! (list (dk-cite! 'pfw-change-of-variables 'omega 'cA 'mu 'omega2 'cB 'h pp)))
          (dk-cite! compthm 'omega 'omega2 'f 'h)
          (dk-cite! 'integral-congruence-ptwise 'omega 'cA 'mu pk kp)
          (list (list 'INTEGRAL 'omega2 'cB pfw-nu pp) (list 'INTEGRAL 'omega 'cA 'mu kp)
                (list 'INTEGRAL 'omega 'cA 'mu pk))))
      '((POS-PART pos-part-fun pfw-pos-part-comp) (NEG-PART neg-part-fun pfw-neg-part-comp)))))

;;; integrability transfers both ways
(sp (make-wff (forall-guarded '(omega cA mu omega2 cB h f)
                '((IS-MEASURE omega cA mu) (IS-MEASURABLE-MAP omega cA omega2 cB h) (IS-REAL-MEASURABLE-FN omega2 cB f))
   (list 'IFF (list 'IS-INTEGRABLE 'omega2 'cB pfw-nu 'f) (list 'IS-INTEGRABLE 'omega 'cA 'mu (pfw-comp 'omega 'f 'h))))))
(let* ((ts (pfw-real-setup!))
       (kf (pfw-comp 'omega 'f 'h))
       (i1 (dk-cite! 'is-integrable 'omega2 'cB pfw-nu 'f))
       (i2 (dk-cite! 'is-integrable 'omega 'cA 'mu kf))
       (i1b (dk-rewrite-h! (dk-rewrite-h! i1 (car (car ts)) (cadr (car ts))) (car (cadr ts)) (cadr (cadr ts))))
       (i2b (dk-rewrite-h! (dk-rewrite-h! i2 (caddr (car ts)) (cadr (car ts))) (caddr (cadr ts)) (cadr (cadr ts)))))
  (dk-only! i1b i2b (list 'IS-REAL-MEASURABLE-FN 'omega2 'cB 'f) (list 'IS-REAL-MEASURABLE-FN 'omega 'cA kf))
  (prop))
(qed 'pfw-integrable-iff)

;;; ITEM 3, real f: the change of variables formula
(sp (make-wff (forall-guarded '(omega cA mu omega2 cB h f)
                '((IS-MEASURE omega cA mu) (IS-MEASURABLE-MAP omega cA omega2 cB h) (IS-REAL-MEASURABLE-FN omega2 cB f)
                  (IS-INTEGRABLE omega2 cB (PUSH-FORWARD omega cB mu h) f))
   (list 'AND (list 'IS-INTEGRABLE 'omega 'cA 'mu (pfw-comp 'omega 'f 'h))
              (list '= (list 'RINTEGRAL 'omega2 'cB pfw-nu 'f) (list 'RINTEGRAL 'omega 'cA 'mu (pfw-comp 'omega 'f 'h)))))))
(let* ((ts (pfw-real-setup!))
       (kf (pfw-comp 'omega 'f 'h))
       (pos (car ts)) (neg (cadr ts)))
  (dk-cite! 'pfw-integrable-iff 'omega 'cA 'mu 'omega2 'cB 'h 'f)
  (let ((ip (dk-cite! 'is-integrable 'omega2 'cB pfw-nu 'f)))
    (pfw-iff-parts! ip))
  (dk-rewrite-h! (list 'IN (car pos) 'RR) (car pos) (cadr pos))
  (dk-rewrite-h! (list 'IN (car neg) 'RR) (car neg) (cadr neg))
  (dk-cite! 'rintegral-unfold 'omega2 'cB pfw-nu 'f)
  (dk-cite! 'rintegral-unfold 'omega 'cA 'mu kf)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (if (dk-head-is? (dk-goal) 'IS-INTEGRABLE)
              (pfw-then-ass! (lambda () (dk-only! (list 'IFF (list 'IS-INTEGRABLE 'omega2 'cB pfw-nu 'f) (list 'IS-INTEGRABLE 'omega 'cA 'mu kf))
                                                  (list 'IS-INTEGRABLE 'omega2 'cB pfw-nu 'f))
                                        (prop)))
              (begin
                (subst (list '== (list 'RINTEGRAL 'omega2 'cB pfw-nu 'f) (list '- (car pos) (car neg))))
                (subst (list '== (list 'RINTEGRAL 'omega 'cA 'mu kf) (list '- (caddr pos) (caddr neg))))
                (subst (list '= (car pos) (cadr pos)))
                (subst (list '= (car neg) (cadr neg)))
                (subst (list '== (caddr pos) (cadr pos)))
                (subst (list '== (caddr neg) (cadr neg)))
                (if (not (proof-done? *ps*)) (rfl))))))))
(qed 'pfw-change-of-variables-real)
