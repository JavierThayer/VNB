;;; cc-separation.scm -- agent BA-1117-TRACE (round 3), 2026-11-17.
;;; The complex geometric Hahn-Banach theorem for a topology defined by a separating family of
;;; seminorms over CC: a point of an open set u is separated from a nonempty convex set missing u
;;; by the real part of a continuous CC-linear functional.  The real-part device: the realification
;;; mr of m (rb3-mr-exists) carries the same seminorms (a separating family over RR) and the same
;;; topology; locally-convex-separation (krein-milman.scm) gives a real functional f; the complex
;;; functional F(y) = f(y) - i f(i y) (rb3-cf-*, rake-asm-b3.scm) is CC-linear with Re F = f, and
;;; |F(y)| <= |f(y)| + |f(i y)| makes it continuous.
;;; DESTINATION: theorem-library/cc-separation.scm, after theorem-library/amp-sum.scm (the last
;;; section, Proposition 5.8, cites strong-dual-subset-weak-dual).  Library: operator-algebras.
;;; Helper prefix ccs-.  Nothing asserted.
(define (ccs-done?) (sequent-node-grounded? (proof-state-focus *ps*)))
(define (ccs-qed! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** cc-separation: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'analysis))
(define (ccs-ctx f) (or (dk-ctx-form f) (error "ccs-ctx: not in context" (expression->string f))))
(define (ccs-ass!) (if (not (ccs-done?)) (dk-ass!)))
(define (ccs-det! r) (if (dk-head-is? r 'IMPLIES) (detach! r)))
(define (ccs-have! f k) (if (not (dk-asm? f)) (dk-have! f k)) f)
(define (ccs-ap! f a b x) (if (not (dk-asm? (list 'IN (list f x) b))) (dk-cite! 'fun-apply-type-c f a b x)))
(define (ccs-chain! ch)                   ; detach every antecedent in context; returns the rest
  (let loop ((r ch))
    (if (and (pair? r) (eq? (car r) 'IMPLIES) (dk-asm? (cadr r)))
        (loop (let ((new (dk-landed* (lambda () (detach! (or (dk-ctx-form r) r))))))
                (if (pair? new) (dk--deepest-of new) (ccs-ctx (caddr r)))))
        r)))
(define (ccs-replace e old new)
  (cond ((equal? e old) new) ((pair? e) (map (lambda (x) (ccs-replace x old new)) e)) (#t e)))
(define (ccs-fa v dom body) (list 'FORALL v (list 'IMPLIES (list 'IN v dom) body)))
(define (ccs-imps hyps body) (if (null? hyps) body (list 'IMPLIES (car hyps) (ccs-imps (cdr hyps) body))))
(define ccs-R '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define ccs-C '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define ccs-RV '(NORMED-VECTOR-SPACE-AS-MODULE RR-NVS))
(define ccs-RT '(SEMINORM-TOP (NORMED-VECTOR-SPACE-AS-MODULE RR-NVS) (PAIR 0 0) (VNB-LAMBDA nvk_ (PAIR 0 0) (VNRM RR-NVS))))
(define ccs-cpin (list '= '(SCAL m) ccs-C))
(define (ccs-cmod body) (list 'FORALL 'm (list 'IMPLIES '(IS-MODULE m) (list 'IMPLIES ccs-cpin body))))
;; the realification, abstractly (the facts rb3-mr-exists gives)
(define (ccs-mr-eqs mr)
  (list (list '= (list 'SCAL mr) ccs-R)
        (list '= (list 'VEC mr) '(VEC m))
        (list '= (list 'VADD mr) '(VADD m))
        (list '= (list 'VZERO mr) '(VZERO m))
        (list '= (list 'VNEG mr) '(VNEG m))
        (ccs-fa 'r_ 'RR (ccs-fa 'x_ '(VEC m) (list '= (list (list 'ACT mr) 'r_ 'x_) '((ACT m) r_ x_))))))
(define (ccs-mrhyp body)
  (ccs-cmod (list 'FORALL 'mr (list 'IMPLIES '(IS-MODULE mr) (ccs-imps (ccs-mr-eqs 'mr) body)))))
;; rewrite mr's slots to m's in the goal
(define (ccs-mr-subst! mr)
  (for-each (lambda (acc val) (if (dk-contains? (dk-goal) (list acc mr)) (subst (list '= (list acc mr) val))))
            '(SCAL VEC VADD VZERO VNEG)
            (list ccs-R '(VEC m) '(VADD m) '(VZERO m) '(VNEG m)))
  (if (dk-contains? (dk-goal) (list 'CARR ccs-R)) (subst (dk-cite! 'rr-scalar-ring-carr))))
(define (ccs-mr-act! mr r x)              ; ((ACT mr) r x) -> ((ACT m) r x)
  (subst (dk-apply! (ccs-ctx (list-ref (ccs-mr-eqs mr) 5)) r x)))
(define (ccs-ineq! prods hyps typs)       ; dk-ineq! with each product named
  (for-each dk-real! prods)
  (let loop ((ps prods) (hs hyps) (names '()))
    (if (null? ps)
        (apply dk-ineq! (append hs (map (lambda (n) (list 'IN n 'RR)) names) typs))
        (let* ((p (car ps)) (n (dk-name! p)))
          (if (dk-contains? (dk-goal) p) (subst (list '= p n)))
          (loop (cdr ps) (map (lambda (h) (if (dk-contains? h p) (dk-rewrite-h! h p n) h)) hs) (cons n names))))))

;;; ---------------------------------------------------------------------------------------------
;;; (1) THE REALIFICATION carries the same topology, the same seminorms and the same convex sets
(sp (make-wff (ccs-mrhyp '(FORALL ix (FORALL pf (== (SEMINORM-TOP mr ix pf) (SEMINORM-TOP m ix pf)))))))
(dk-peel!)
(mac 'SEMINORM-TOP)
(mac 'IS-SN-OPEN)
(mac 'SN-BALL)
(ccs-mr-subst! 'mr)
(if (not (ccs-done?)) (qrfl))
(ccs-qed! 'realification-seminorm-top)

(sp (make-wff (ccs-mrhyp '(FORALL ix (FORALL pf (IMPLIES (IS-SEMINORM-FAMILY-ON CC-NORMED-FIELD m ix pf)
                                                  (IS-SEMINORM-FAMILY-ON RR-NORMED-FIELD mr ix pf)))))))
(dk-peel!)
(mac-h 'is-seminorm-family-on (ccs-ctx '(IS-SEMINORM-FAMILY-ON CC-NORMED-FIELD m ix pf)))
(dk-split-all!)
(dk-cite! 'rr-is-normed-field)
(define ccs-semis (ccs-ctx '(FORALL sni_ (IMPLIES (IN sni_ ix) (IS-SEMINORM CC-NORMED-FIELD m (pf sni_))))))
(mac 'is-seminorm-family-on)
(dk-conj-close!
  (lambda ()
    (ccs-mr-subst! 'mr)
    (cond
      ((ccs-done?) #t)
      ((dk-ass!) #t)
      ((dk-head-is? (dk-goal) '=) (rfl))
      (#t                                    ; each pf(i) is a seminorm over RR on mr
       (let* ((i (dk-di-var!)) (p (list 'pf i)) (h (dk-apply! ccs-semis i)))
         (mac-h 'is-seminorm h)
         (dk-split-all!)
         (let ((hom (ccs-ctx (list 'FORALL 'lam (list 'IMPLIES '(IN lam (CARR (SCAL m)))
                      (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC m))
                        (list '= (list p '((ACT m) lam x)) (list '* '((FNRM CC-NORMED-FIELD) lam) (list p 'x))))))))))
           (mac 'is-seminorm)
           (dk-conj-close!
             (lambda ()
               (ccs-mr-subst! 'mr)
               (cond
                 ((ccs-done?) #t)
                 ((dk-ass!) #t)
                 ((dk-head-is? (dk-goal) '=) (rfl))
                 (#t
                  (let* ((ld (dk-peel!))
                         (lam (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) ld)))
                         (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC m)))) ld))))
                    (ccs-mr-act! 'mr lam x)
                    (subst (dk-cite! 'rr-nf-fnrm-apply lam))
                    (dk-cite! 'rr-subset-cc lam)
                    (dk-cite! 'rb3-c-in-carr 'm lam)
                    (dk-cite! 'cc-nf-fnrm-apply lam)
                    (dk-cite! 'rr-magnitude-is-abs lam)
                    (let* ((e (dk-apply! hom lam x))
                           (e1 (dk-rewrite-h! e (list '(FNRM CC-NORMED-FIELD) lam) (list 'magnitude lam)))
                           (e2 (dk-rewrite-h! e1 (list 'magnitude lam) (list 'abs lam))))
                      (ccs-ass!)))))))))))))
(ccs-qed! 'realification-seminorm-family)

(sp (make-wff (ccs-mrhyp '(FORALL c (IMPLIES (IS-CONVEX-SUBSET m c) (IS-CONVEX-SUBSET mr c))))))
(dk-peel!)
(mac-h 'is-convex-subset (ccs-ctx '(IS-CONVEX-SUBSET m c)))
(dk-split-all!)
(define ccs-cvx (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'c) (dk-contains? f '(VADD m)))) "convexity"))
(mac 'is-convex-subset)
(dk-conj-close!
  (lambda ()
    (ccs-mr-subst! 'mr)
    (cond
      ((ccs-done?) #t)
      ((dk-ass!) #t)
      (#t
       (let* ((ld (dk-peel!))
              (ab (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'c))) ld)))
              (tt (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) ld)))
              (a (car ab)) (b (cadr ab)) (s (list '- 1 tt)))
         (dk-cite! 'subset-mem-fwd 'c '(VEC m) a)
         (dk-cite! 'subset-mem-fwd 'c '(VEC m) b)
         (dk-real! s)
         (ccs-mr-act! 'mr s a)
         (ccs-mr-act! 'mr tt b)
         (dk-apply! ccs-cvx a b tt)
         (ccs-ass!))))))
(ccs-qed! 'realification-convex)

;;; ---------------------------------------------------------------------------------------------
;;; (2) LINEAR FUNCTIONALS AS LINEAR MAPS: a real one into R (the topology of |.|), a CC-linear one into C
(sp (make-wff '(FORALL v (IMPLIES (IN v RR) (FORALL w (IMPLIES (IN w RR) (= ((ACT RR-NVS) v w) (* v w))))))))
(dk-peel!)
(slot 'ACT)
(dk-lam-b!)
(dk-real! '(* v w))
(if (not (ccs-done?)) (rfl))
(ccs-qed! 'rr-nvs-act-apply)

(sp (make-wff '(== (SCAL RR-NVS) (NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))))
(slot 'SCAL)
(if (not (ccs-done?)) (qrfl))
(ccs-qed! 'rr-nvs-scal)

(sp (make-wff '(FORALL mr (IMPLIES (IS-MODULE mr) (IMPLIES (= (SCAL mr) (NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
   (FORALL f (IMPLIES (IS-LINEAR-FUNCTIONAL mr f) (IS-LINEAR-MAP mr (NORMED-VECTOR-SPACE-AS-MODULE RR-NVS) f))))))))
(dk-peel!)
(mac-h 'is-linear-functional (ccs-ctx '(IS-LINEAR-FUNCTIONAL mr f)))
(dk-split-all!)
(dk-cite! 'rr-nvs-is-normed-vector-space)
(dk-cite! 'normed-vector-space-as-module-is-module 'RR-NVS)
(for-each (lambda (n) (dk-cite! n 'RR-NVS)) '(nvs-module-view-vec nvs-module-view-vadd nvs-module-view-act nvs-module-view-scal))
(dk-cite! 'rr-nvs-vec) (dk-cite! 'rr-nvs-scal) (dk-cite! 'rr-scalar-ring-carr)
(define ccs-lfa (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(VADD mr)))) "additive"))
(define ccs-lfh (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(ACT mr)))) "homogeneous"))
(define (ccs-rv-subst!)
  (for-each (lambda (acc) (if (dk-contains? (dk-goal) (list acc ccs-RV))
                              (begin (subst (list '== (list acc ccs-RV) (list acc 'RR-NVS))))))
            '(VEC VADD ACT SCAL))
  (if (dk-contains? (dk-goal) '(VEC RR-NVS)) (subst '(== (VEC RR-NVS) RR)))
  (if (dk-contains? (dk-goal) '(SCAL RR-NVS)) (subst (list '== '(SCAL RR-NVS) ccs-R)))
  (if (dk-contains? (dk-goal) '(SCAL mr)) (subst (list '= '(SCAL mr) ccs-R))))
(mac 'is-linear-map)
(dk-conj-close!
  (lambda ()
    (ccs-rv-subst!)
    (cond
      ((ccs-done?) #t)
      ((dk-ass!) #t)
      ((dk-head-is? (dk-goal) '=) (rfl))
      (#t
       (let* ((ld (dk-peel!))
              (xs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC mr)))) ld)))
              (ks (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (not (equal? (caddr f) '(VEC mr))))) ld))))
         (for-each (lambda (x) (ccs-ap! 'f '(VEC mr) 'RR x)) xs)
         (if (null? ks)
             (begin
               (subst (dk-cite! 'rr-nvs-vadd-apply (list 'f (car xs)) (list 'f (cadr xs))))
               (dk-apply! ccs-lfa (car xs) (cadr xs))
               (ccs-ass!))
             (let* ((k (car ks)) (x (car xs)) (hk (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (cadr f) k))) ld)))
               (if (not (dk-asm? (list 'IN k 'RR)))
                   (let* ((h1 (if (dk-contains? hk '(SCAL mr)) (dk-rewrite-h! hk '(SCAL mr) ccs-R) hk)))
                     (dk-rewrite-h! h1 (list 'CARR ccs-R) 'RR)))
               (subst (dk-cite! 'rr-nvs-act-apply k (list 'f x)))
               (dk-apply! ccs-lfh k x)
               (ccs-ass!))))))))
(ccs-qed! 'linear-functional-linear-map)

(sp (make-wff (ccs-cmod '(FORALL f (IMPLIES (IS-K-LINEAR m f) (IS-LINEAR-MAP m CC-SN-MODULE f))))))
(dk-peel!)
(mac-h 'is-k-linear (ccs-ctx '(IS-K-LINEAR m f)))
(dk-split-all!)
(for-each (lambda (h) (if (dk-contains? h '(SCAL m)) (dk-rewrite-h! h '(SCAL m) ccs-C)))
          (filter (lambda (h) (and (dk-contains? h 'f) (dk-contains? h '(SCAL m)))) (dk-asms)))
(dk-cite! 'cc-sn-module-is-module)
(mac 'is-linear-map)
(for-each (lambda (n) (subst (dk-cite! n))) '(cc-sn-module-vec cc-sn-module-vadd cc-sn-module-act cc-sn-module-scal))
(subst ccs-cpin)
(dk-conj-close! (lambda () (cond ((ccs-done?) #t) ((dk-ass!) #t) (#t (rfl)))))
(ccs-qed! 'k-linear-functional-linear-map)

;;; ---------------------------------------------------------------------------------------------
;;; (3) F(y) = f(y) - i f(i y) is continuous when f is: |F(y)| <= |f(y)| + |f(i y)| and p(i y) = p(y)
(define ccs-rf-add (ccs-fa 'rax_ '(VEC m) (ccs-fa 'ray_ '(VEC m) '(= (rfn ((VADD m) rax_ ray_)) (+ (rfn rax_) (rfn ray_))))))
(define ccs-rf-hom (ccs-fa 'rhr_ 'RR (ccs-fa 'rhx_ '(VEC m) '(= (rfn ((ACT m) rhr_ rhx_)) (* rhr_ (rfn rhx_))))))
(define (ccs-cf-of y) (list '+ (list 'rfn y) (list '* (list '- (list 'rfn (list '(ACT m) '+i y))) '+i)))
(define ccs-cf-val (ccs-fa 'cvy_ '(VEC m) (list '== '(cfn cvy_) (ccs-cf-of 'cvy_))))
(define (ccs-bound vm f)                  ; the bound of functional-cont-iff-bound, for f on the vectors vm
  (list 'FORSOME 'sbf_ (list 'AND '(IN sbf_ SET) (list 'AND '(IN (CARD sbf_) NN) (list 'AND '(SUBSET sbf_ ix)
    (list 'FORSOME 'sbc_ (list 'AND '(IN sbc_ RR) (list 'AND '(POS-RR sbc_)
      (list 'FORALL 'sbx_ (list 'IMPLIES (list 'IN 'sbx_ vm)
        (list 'FORALL 'sbt_ (list 'IMPLIES '(IN sbt_ RR) (list 'IMPLIES '(<= 0 sbt_)
          (list 'IMPLIES '(FORALL sbi_ (IMPLIES (IN sbi_ sbf_) (<= ((pf sbi_) sbx_) sbt_)))
            (list '<= (list 'abs (list f 'sbx_)) '(* sbc_ sbt_))))))))))))))))
(define ccs-fam '(IS-SEMINORM-FAMILY-ON CC-NORMED-FIELD m ix pf))
(sp (make-wff (list 'FORALL 'm (list 'FORALL 'ix (list 'FORALL 'pf (list 'IMPLIES ccs-fam
  (list 'FORALL 'rfn (ccs-imps (list '(IN rfn (FUN (VEC m) RR)) ccs-rf-add ccs-rf-hom)
    (list 'FORALL 'cfn (ccs-imps (list '(IN cfn (FUN (VEC m) CC)) ccs-cf-val (ccs-bound '(VEC m) 'rfn))
      '(IS-HOM-TOP-SPACE (SEMINORM-TOP m ix pf) CC-SN-TOP cfn)))))))))))
(dk-peel!)
(define (ccs-fam-part! claim)             ; a conjunct of the family hypothesis, which survives
  (ccs-have! claim (lambda () (mac-h 'is-seminorm-family-on (ccs-ctx ccs-fam)) (dk-split-all!) (dk-ass!))))
(define ccs-semis (ccs-fam-part! '(FORALL sni_ (IMPLIES (IN sni_ ix) (IS-SEMINORM CC-NORMED-FIELD m (pf sni_))))))
(ccs-fam-part! '(IS-MODULE m))
(ccs-fam-part! ccs-cpin)
(ccs-fam-part! '(IN pf (FUN ix (FUN (VEC m) RR))))
(dk-cite! 'cc-i-in)
(dk-cite! 'rb3-c-in-carr 'm '+i)
(dk-cite! 'cc-nf-fnrm-apply '+i)
(dk-cite! 'cc-magnitude-i)
(dk-cite! 'rb3-cf-klinear 'm 'rfn 'cfn)
(dk-cite! 'k-linear-functional-linear-map 'm 'cfn)
(dk-cite! 'cc-sn-family)
(dk-cite! 'cc-sn-pf-def)
(define ccs-ccpf '(VNB-LAMBDA otk_ (PAIR 0 0) (VNB-LAMBDA otz_ CC (magnitude otz_))))
(subst (dk-cite! 'cc-sn-top-def))
(subst (list '== 'CC-SN-PF ccs-ccpf))
(dk-rewrite-h! (ccs-ctx '(IS-SEMINORM-FAMILY-ON CC-NORMED-FIELD CC-SN-MODULE (PAIR 0 0) CC-SN-PF)) 'CC-SN-PF ccs-ccpf)
(define ccs-iff (ccs-chain! (dk-cite! 'sn-cont-iff-bound-cc 'm 'ix 'pf 'CC-SN-MODULE '(PAIR 0 0) ccs-ccpf 'cfn)))
(define ccs-ff (dk-skolem! (ccs-ctx (ccs-bound '(VEC m) 'rfn)) #t))
(dk-split-all!)
(define ccs-cb (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h ccs-ff))) "constant") #t))
(dk-split-all!)
(define ccs-body (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h ccs-cb) (dk-contains? h 'rfn))) "the bound"))
(mac-h 'pos-rr (ccs-ctx (list 'POS-RR ccs-cb)))
(dk-split-all!)
(define ccs-K (list '+ (list '+ ccs-cb ccs-cb) 1))
(dk-real! ccs-K)
(dk-have! (list '< 0 ccs-K) (lambda () (dk-ineq! (list 'IN ccs-cb 'RR) (list '<= 0 ccs-cb))))
(dk-cite! 'rr-pos-rr-of-lt ccs-K)
(define (ccs-p-at! i x)                   ; (pf i) x in RR, i in ix
  (ccs-ap! 'pf 'ix '(FUN (VEC m) RR) i)
  (ccs-ap! (list 'pf i) '(VEC m) 'RR x))
(dk-have! (caddr ccs-iff)
  (lambda ()
    (let ((j (dk-di-var!)))
      (ew ccs-ff)
      (letrec ((cl (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((ccs-done?) #t)
            ((dk-ass!) #t)
            ((dk-head-is? g 'FORSOME) (ew ccs-K) (dk-conj-close! cl))
            (#t
             (let* ((ld (dk-peel!))
                    (x (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(VEC m)))) ld)))
                    (tt (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld)))
                    (ix (list '(ACT m) '+i x)) (a (list 'rfn x)) (b (list 'rfn ix)) (nb (list '- b))
                    (nbi (list '* nb '+i)) (ct (list '* ccs-cb tt)))
               (ccs-ap! 'cfn '(VEC m) 'CC x)
               (dk-lam-b!) (if (dk-contains? (dk-goal) 'VNB-LAMBDA) (dk-lam-b!))
               (subst (dk-apply! (ccs-ctx ccs-cf-val) x))
               (dk-cite! 'rb3-c-act-in 'm '+i x)
               (ccs-ap! 'rfn '(VEC m) 'RR x) (ccs-ap! 'rfn '(VEC m) 'RR ix)
               (dk-real! nb)
               (dk-cite! 'rr-subset-cc a) (dk-cite! 'rr-subset-cc nb)
               (dk-have! (list 'AND (list 'IN nb 'CC) '(IN +i CC)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
               (dk-cite! 'cc-mul-closed nb '+i)
               (dk-have! (list 'AND (list 'IN a 'CC) (list 'IN nbi 'CC)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
               (let* ((tri (dk-cite! 'cc-magnitude-triangle a nbi))
                      (me (dk-cite! 'cc-magnitude-mul nb '+i))
                      (t1 (dk-rewrite-h! tri (list 'magnitude nbi) (caddr me)))
                      (t2 (dk-rewrite-h! t1 '(magnitude +i) 1)))
                 (dk-cite! 'cc-magnitude-closed nb)
                 (dk-have! (list '= (list '* (list 'magnitude nb) 1) (list 'magnitude nb)) (lambda () (crs)))
                 (dk-cite! 'rr-magnitude-is-abs a) (dk-cite! 'rr-magnitude-is-abs nb) (dk-cite! 'rr-abs-neg b)
                 (let* ((t3 (dk-rewrite-h! t2 (list '* (list 'magnitude nb) 1) (list 'magnitude nb)))
                        (t4 (dk-rewrite-h! t3 (list 'magnitude nb) (list 'abs nb)))
                        (t5 (dk-rewrite-h! t4 (list 'abs nb) (list 'abs b)))
                        (t6 (dk-rewrite-h! t5 (list 'magnitude a) (list 'abs a))))
                   ;; the seminorms do not see i
                   (dk-have! (list 'FORALL 'sbi_ (list 'IMPLIES (list 'IN 'sbi_ ccs-ff) (list '<= (list '(pf sbi_) ix) tt)))
                     (lambda ()
                       (let* ((i (dk-di-var!))
                              (hall (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h tt) (dk-contains? h x) (not (dk-contains? h ix)))) (dk-asms))))
                         (dk-cite! 'subset-mem-fwd ccs-ff 'ix i)
                         (mac-h 'is-seminorm (dk-apply! ccs-semis i))
                         (dk-split-all!)
                         (ccs-p-at! i x) (ccs-p-at! i ix)
                         (let* ((hom (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'FNRM) (dk-contains? h (list 'pf i)))) "homogeneity"))
                                (e (dk-apply! hom '+i x))
                                (e1 (dk-rewrite-h! e '((FNRM CC-NORMED-FIELD) +i) '(magnitude +i)))
                                (e2 (dk-rewrite-h! e1 '(magnitude +i) 1))
                                (hx (dk-apply! hall i)))
                           (dk-ineq! e2 hx (list 'IN (list (list 'pf i) x) 'RR) (list 'IN (list (list 'pf i) ix) 'RR))))))
                   (let* ((ba (ccs-det! (dk-apply! ccs-body x tt)))
                          (bb (ccs-det! (dk-apply! ccs-body ix tt))))
                     (dk-have! (list '= (list '* ccs-K tt) (list '+ (list '+ ct ct) tt)) (lambda () (crs)))
                     (subst (list '= (list '* ccs-K tt) (list '+ (list '+ ct ct) tt)))
                     (dk-cite! 'rr-abs-closed a) (dk-cite! 'rr-abs-closed b)
                     (dk-cite! 'cc-add-closed a nbi)
                     (dk-cite! 'cc-magnitude-closed (cadr (cadr (dk-goal))))
                     (ccs-ineq! (list ct) (list t6 (ccs-ctx (list '<= (list 'abs a) ct)) (ccs-ctx (list '<= (list 'abs b) ct)))
                                (list (list 'IN (list 'abs a) 'RR) (list 'IN (list 'abs b) 'RR) (list '<= 0 tt)
                                      (list 'IN (cadr (dk-goal)) 'RR)))))))))))))
        (dk-conj-close! cl)))))
(dk-have! (cadr ccs-iff) (lambda () (if (dk-only! ccs-iff (caddr ccs-iff)) (prop))))
(ccs-ass!)
(ccs-qed! 'complexified-functional-continuous)

;;; ---------------------------------------------------------------------------------------------
;;; (4) THE COMPLEX GEOMETRIC HAHN-BANACH THEOREM (separation of a point of an open set from a
;;;     nonempty convex set missing it, by the real part of a continuous CC-linear functional)
(define ccs-top '(SEMINORM-TOP m ix pf))
(define ccs-sep-stmt
  (forall-guarded '(m ix pf u x0 c)
    (list ccs-fam (list 'IN 'u (list 'OPENS ccs-top)) '(IN x0 u) '(IS-CONVEX-SUBSET m c)
          '(FORSOME kc0_ (IN kc0_ c)) '(FORALL kdz_ (IMPLIES (IN kdz_ c) (NOT (IN kdz_ u)))))
    (list 'FORSOME 'ccf_ (list 'AND '(IS-K-LINEAR m ccf_)
      (list 'AND (list 'IS-HOM-TOP-SPACE ccs-top 'CC-SN-TOP 'ccf_)
        '(FORALL ccz_ (IMPLIES (IN ccz_ c) (< (real-part (ccf_ ccz_)) (real-part (ccf_ x0))))))))))
(define (ccs-cf-type! f k)                ; f(k) - i f(i k) in CC
  (let* ((a (list f k)) (ik (list '(ACT m) '+i k)) (b (list f ik)) (nb (list '- b)) (nbi (list '* nb '+i)))
    (dk-cite! 'rb3-c-act-in 'm '+i k)
    (ccs-ap! f '(VEC m) 'RR k) (ccs-ap! f '(VEC m) 'RR ik)
    (dk-real! nb)
    (dk-cite! 'rr-subset-cc a) (dk-cite! 'rr-subset-cc nb)
    (ccs-have! (list 'AND (list 'IN nb 'CC) '(IN +i CC)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (dk-cite! 'cc-mul-closed nb '+i)
    (ccs-have! (list 'AND (list 'IN a 'CC) (list 'IN nbi 'CC)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (dk-cite! 'cc-add-closed a nbi)
    (ccs-ass!)))
(sp (make-wff ccs-sep-stmt))
(dk-peel!)
(define (ccs-fam-part! claim)
  (ccs-have! claim (lambda () (mac-h 'is-seminorm-family-on (ccs-ctx ccs-fam)) (dk-split-all!) (dk-ass!))))
(ccs-fam-part! '(IS-MODULE m))
(ccs-fam-part! ccs-cpin)
(dk-cite! 'cc-i-in)
(ccs-have! '(IN (VEC m) SET) (lambda () (mac-h 'is-module (ccs-ctx '(IS-MODULE m))) (dk-split-all!) (dk-ass!)))
(define ccs-mr (dk-skolem! (dk-cite! 'rb3-mr-exists 'm) #t))
(dk-split-all!)
(dk-cite! 'realification-seminorm-family 'm ccs-mr 'ix 'pf)
(define ccs-toq (dk-cite! 'realification-seminorm-top 'm ccs-mr 'ix 'pf))
(define ccs-topr (list 'SEMINORM-TOP ccs-mr 'ix 'pf))
(dk-cite! 'seminorm-top-locally-convex ccs-mr 'ix 'pf)
(dk-have! (list 'IN 'u (list 'OPENS ccs-topr))
  (lambda () (subst ccs-toq) (dk-ass!)))
(dk-cite! 'realification-convex 'm ccs-mr 'c)
(define ccs-f (dk-skolem! (ccs-chain! (dk-cite! 'locally-convex-separation ccs-mr ccs-topr 'u 'x0 'c)) #t))
(dk-split-all!)
(dk-cite! 'linear-functional-linear-map ccs-mr ccs-f)
(define ccs-biff (ccs-chain! (dk-cite! 'functional-cont-iff-bound ccs-mr 'ix 'pf ccs-f)))
(define ccs-bnd (ccs-have! (caddr ccs-biff) (lambda () (if (dk-only! ccs-biff (cadr ccs-biff)) (prop)))))
(dk-rewrite-h! ccs-bnd (list 'VEC ccs-mr) '(VEC m))
;; f, read on m
(define (ccs-lf-part! claim)
  (ccs-have! claim (lambda () (mac-h 'is-linear-functional (ccs-ctx (list 'IS-LINEAR-FUNCTIONAL ccs-mr ccs-f))) (dk-split-all!) (dk-ass!))))
(define ccs-lf-fun (ccs-lf-part! (list 'IN ccs-f (list 'FUN (list 'VEC ccs-mr) 'RR))))
(define ccs-lf-add (ccs-lf-part! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ (list 'VEC ccs-mr)) (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ (list 'VEC ccs-mr))
                     (list '= (list ccs-f (list (list 'VADD ccs-mr) 'x_ 'y_)) (list '+ (list ccs-f 'x_) (list ccs-f 'y_)))))))))
(define ccs-lf-hom (ccs-lf-part! (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ RR) (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ (list 'VEC ccs-mr))
                     (list '= (list ccs-f (list (list 'ACT ccs-mr) 'r_ 'x_)) (list '* 'r_ (list ccs-f 'x_)))))))))
(dk-have! (list 'IN ccs-f '(FUN (VEC m) RR))
  (lambda () (subst (list '= '(VEC m) (list 'VEC ccs-mr))) (dk-ass!)))
(define (ccs-in-vmr! x) (ccs-have! (list 'IN x (list 'VEC ccs-mr)) (lambda () (subst (list '= (list 'VEC ccs-mr) '(VEC m))) (dk-ass!))))
(dk-have! (ccs-replace ccs-rf-add 'rfn ccs-f)
  (lambda ()
    (let* ((ld (dk-peel!)) (xs (map cadr ld)))
      (for-each ccs-in-vmr! xs)
      (subst (list '= '(VADD m) (list 'VADD ccs-mr)))
      (dk-apply! ccs-lf-add (car xs) (cadr xs))
      (ccs-ass!))))
(dk-have! (ccs-replace ccs-rf-hom 'rfn ccs-f)
  (lambda ()
    (let* ((ld (dk-peel!)) (r (cadr (car ld))) (x (cadr (cadr ld))))
      (ccs-in-vmr! x)
      (let ((e (dk-apply! (ccs-ctx (list-ref (ccs-mr-eqs ccs-mr) 5)) r x)))
        (dk-have! (list '= (caddr e) (cadr e)) (lambda () (subst e) (rfl)))
        (subst (list '= (caddr e) (cadr e))))
      (dk-apply! ccs-lf-hom r x)
      (ccs-ass!))))
;; F(y) = f(y) - i f(i y)
(define ccs-cfp (dk-abstract! '(VEC m) 'CC (lambda (k) (ccs-replace (ccs-cf-of k) 'rfn ccs-f))
                              (lambda (k) (ccs-cf-type! ccs-f k))))
(define ccs-cfn (car ccs-cfp))
(dk-cite! 'complexified-functional-continuous 'm 'ix 'pf ccs-f ccs-cfn)
(dk-cite! 'rb3-cf-klinear 'm ccs-f ccs-cfn)
(define ccs-re (dk-cite! 'rb3-cf-re 'm ccs-f ccs-cfn))
(define ccs-lt (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '<) (dk-contains? h ccs-f) (dk-contains? h 'x0))) "the separation"))
(ccs-have! '(SUBSET c (VEC m)) (lambda () (mac-h 'is-convex-subset (ccs-ctx '(IS-CONVEX-SUBSET m c))) (dk-split-all!) (dk-ass!)))
(ccs-have! '(IN x0 (VEC m))
  (lambda ()
    (dk-cite! 'sntop-is-top-space 'CC-NORMED-FIELD 'm 'ix 'pf)
    (dk-cite! 'sntop-pts 'm 'ix 'pf)
    (dk-cite! 'top-open-subset ccs-top 'u)
    (let ((h (dk-cite! 'subset-mem-fwd 'u (list 'PTS ccs-top) 'x0)))
      (dk-rewrite-h! (ccs-ctx (list 'IN 'x0 (list 'PTS ccs-top))) (list 'PTS ccs-top) '(VEC m))
      (ccs-ass!))))
(ew ccs-cfn)
(dk-conj-close!
  (lambda ()
    (cond
      ((ccs-done?) #t)
      ((dk-ass!) #t)
      (#t
       (let ((z (dk-di-var!)))
         (dk-cite! 'subset-mem-fwd 'c '(VEC m) z)
         (subst (dk-apply! ccs-re z))
         (subst (dk-apply! ccs-re 'x0))
         (dk-apply! ccs-lt z)
         (ccs-ass!))))))
(ccs-qed! 'cc-locally-convex-separation)
