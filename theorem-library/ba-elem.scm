;;; ba-elem.scm -- BANACH ALGEBRAS: elementary algebra of a unital Banach algebra -- typings,
;;; invertible elements and the inverse (the notes, before Proposition 1.3: "if a has both a
;;; right inverse u and a left inverse v then v = u"), powers.
;;; Agent BA-1, wave 2026-11-09.  Destination: theorem-library/ba-elem.scm.
;;; Library: operator-algebras.  All proofs modulo 0.
;;; Cites the view companions installed by ba-vocab's def-functors (ring-*-uba-as-ring,
;;; module-*-uba-as-module, rb3-c-*-uba-as-module, normed-ag-*-uba-as-normed-ag) and ba-laws.
;;; LOAD WINDOW: after theorem-library/ba-laws.  (rb3-c-* come from theorem-library/rake-asm-b3,
;;; load.scm 3753, so ba-vocab must load after it for those companions to exist.)
;;; Helper prefix: bae-.

(define (bae-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (if (and (not (sequent-node-grounded? l))
                           (let ((g (dk-goal-of l))) (and (pair? g) (eq? (car g) '=) (equal? (cadr g) (caddr g)))))
                      (begin (dk-focus! l) (rfl))))
                (dk-open-leaves)))
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba-elem: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (proof-leaves))
        (error "ba-elem: unfinished" name))))

(define (bae-st body) (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a) body))))
(define (bae-m x y) (list '(VMUL a) x y))
(define (bae-ad x y) (list '(VADD a) x y))
(define (bae-ng x) (list '(VNEG a) x))
(define (bae-ac z x) (list '(ACT a) z x))
(define (bae-nr x) (list '(VNRM a) x))
(define bae-one '(VONE a))
(define bae-zero '(VZERO a))
(define (bae-rw! from to) (subst (list '= from to)))

;;; (bae-vt X) -- type the algebra expression X (variables typed in context, VONE, VZERO,
;;; VADD, VMUL, VNEG, ACT at a CC scalar typed in context, INVERSE-EL of an invertible element
;;; in context) in (VEC a), bottom-up, by citation.  Returns X.
(define (bae-vt x)
  (let ((want (list 'IN x '(VEC a))))
    (cond ((dk-asm? want) x)
          ((equal? x bae-one) (dk-cite! 'ring-one-in-uba-as-ring 'a) x)
          ((equal? x bae-zero) (dk-cite! 'ring-zero-in-uba-as-ring 'a) x)
          ((and (pair? x) (equal? (car x) '(VADD a)))
           (bae-vt (cadr x)) (bae-vt (caddr x))
           (dk-cite! 'ring-add-closed-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VMUL a)))
           (bae-vt (cadr x)) (bae-vt (caddr x))
           (dk-cite! 'ring-carrier-closed-mul-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG a)))
           (bae-vt (cadr x))
           (dk-cite! 'ring-neg-in-carr-uba-as-ring 'a (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT a)))
           (bae-vt (caddr x))
           (dk-cite! 'bal-uba-scal-pin 'a)
           (dk-cite! 'rb3-c-act-in-uba-as-module 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (eq? (car x) 'INVERSE-EL))
           (dk-cite! 'bae-inverse-in 'a (caddr x)) x)
          ((and (pair? x) (eq? (car x) 'EL-POW))
           (bae-vt (caddr x))
           (dk-cite! 'bae-el-pow-type (cadddr x) 'a (caddr x)) x)
          (#t (error "bae-vt: cannot type" (expression->string x))))))

;;; ---- typings -------------------------------------------------------------------------
(sp (bae-st '(FORALL z (IMPLIES (IN z CC) (FORALL x (IMPLIES (IN x (VEC a)) (IN ((ACT a) z x) (VEC a))))))))
(dk-peel!)
(bae-vt '((ACT a) z x))
(dk-ass!)
(bae-qed! 'bae-act-type)

(sp (bae-st '(FORALL x (IMPLIES (IN x (VEC a)) (IN ((VNRM a) x) RR)))))
(dk-peel!)
(fact 'normed-ag-nrm-type-uba-as-normed-ag 'a)
(fact 'fun-apply-type-c '(VNRM a) '(VEC a) 'RR 'x)
(dk-ass!)
(bae-qed! 'bae-vnrm-type)

;;; ---- inverses ------------------------------------------------------------------------
;;; a left inverse and a right inverse coincide: u = u(xw) = (ux)w = w
(sp (bae-st '(FORALL x (IMPLIES (IN x (VEC a)) (FORALL u (IMPLIES (IN u (VEC a)) (FORALL w (IMPLIES (IN w (VEC a))
  (IMPLIES (= ((VMUL a) u x) (VONE a)) (IMPLIES (= ((VMUL a) x w) (VONE a)) (= u w)))))))))))
(dk-peel!)
(fact 'ring-mul-right-id-uba-as-ring 'a 'u)
(fact 'ring-mul-left-id-uba-as-ring 'a 'w)
(fact 'ring-mul-assoc-uba-as-ring 'a 'u 'x 'w)
(bae-rw! 'w (bae-m bae-one 'w))
(bae-rw! bae-one (bae-m 'u 'x))
(bae-rw! (bae-m (bae-m 'u 'x) 'w) (bae-m 'u (bae-m 'x 'w)))
(bae-rw! (bae-m 'x 'w) bae-one)
(bae-rw! (bae-m 'u bae-one) 'u)
(rfl)
(bae-qed! 'bae-inv-unique)

;;; the inverse satisfies its definition
(sp (bae-st '(FORALL x (IMPLIES (IS-INVERTIBLE-EL a x)
  (AND (IN (INVERSE-EL a x) (VEC a))
       (AND (= ((VMUL a) (INVERSE-EL a x) x) (VONE a)) (= ((VMUL a) x (INVERSE-EL a x)) (VONE a))))))))
(dk-peel!)
(let ((u (dk-project! '(IN x (VEC a)) 'IS-INVERTIBLE-EL '(IS-INVERTIBLE-EL a x))))
  u)
(mac 'INVERSE-EL)
(let* ((g (dk-goal))
       (io (cadr (cadr g))))       ; (AND (IN io (VEC a)) ...)
  (display "\n;; BAE iota: ") (display (expression->string io)) (newline)
  (let ((ls (dk-opened (lambda () (iota-d io)))))
    (for-each
      (lambda (l)
        (if (not (sequent-node-grounded? l))
            (begin
              (dk-focus! l)
              (display "\n;; BAE iota leaf: ") (display (expression->string (dk-goal))) (newline)
              (cond ((dk-head-is? (dk-goal) 'FORSOME)
                     (let* ((ex '(FORSOME bau_ (AND (IN bau_ (VEC a)) (AND (= ((VMUL a) bau_ x) (VONE a))
                                                                          (= ((VMUL a) x bau_) (VONE a))))))
                            (h (dk-project! ex 'IS-INVERTIBLE-EL '(IS-INVERTIBLE-EL a x)))
                            (u (dk-skolem! h)))
                       (ew u)
                       (dk-conj-close!
                         (lambda ()
                           (if (not (dk-ass!))
                               (begin
                                 (dk-peel!)
                                 (dk-split-all!)
                                 (let ((g2 (dk-goal)))
                                   (dk-cite! 'bae-inv-unique 'a 'x (cadr g2) (caddr g2))
                                   (dk-ass!))))))))
                    (#t
                     (dk-split-all!)
                     (dk-conj-close! (lambda () (dk-ass!))))))))
      ls)))
(bae-qed! 'bae-inverse-prop)

(define (bae-inverse-proj! name conj)
  (sp (bae-st (list 'FORALL 'x (list 'IMPLIES '(IS-INVERTIBLE-EL a x) conj))))
  (dk-peel!)
  (dk-cite! 'bae-inverse-prop 'a 'x)
  (dk-split-all!)
  (dk-ass!)
  (bae-qed! name))
(bae-inverse-proj! 'bae-inverse-in '(IN (INVERSE-EL a x) (VEC a)))
(bae-inverse-proj! 'bae-inverse-left '(= ((VMUL a) (INVERSE-EL a x) x) (VONE a)))
(bae-inverse-proj! 'bae-inverse-right '(= ((VMUL a) x (INVERSE-EL a x)) (VONE a)))

;;; a two-sided inverse makes x invertible, and is THE inverse
(sp (bae-st '(FORALL x (IMPLIES (IN x (VEC a)) (FORALL u (IMPLIES (IN u (VEC a))
  (IMPLIES (= ((VMUL a) u x) (VONE a)) (IMPLIES (= ((VMUL a) x u) (VONE a)) (IS-INVERTIBLE-EL a x)))))))))
(dk-peel!)
(mac 'IS-INVERTIBLE-EL)
(dk-conj-close! (lambda ()
  (if (not (dk-ass!))
      (begin (ew 'u) (dk-conj-close! (lambda () (dk-ass!)))))))
(bae-qed! 'bae-invertible-intro)

(sp (bae-st '(FORALL x (IMPLIES (IN x (VEC a)) (FORALL u (IMPLIES (IN u (VEC a))
  (IMPLIES (= ((VMUL a) u x) (VONE a)) (IMPLIES (= ((VMUL a) x u) (VONE a)) (= (INVERSE-EL a x) u)))))))))
(dk-peel!)
(dk-cite! 'bae-invertible-intro 'a 'x 'u)
(dk-cite! 'bae-inverse-in 'a 'x)
(dk-cite! 'bae-inverse-left 'a 'x)
(dk-cite! 'bae-inv-unique 'a 'x '(INVERSE-EL a x) 'u)
(dk-ass!)
(bae-qed! 'bae-inverse-eq)

;;; 1 is invertible, with inverse 1
(sp (bae-st '(IS-INVERTIBLE-EL a (VONE a))))
(di) (di)
(dk-cite! 'ring-one-in-uba-as-ring 'a)
(dk-cite! 'ring-mul-left-id-uba-as-ring 'a bae-one)
(dk-cite! 'bae-invertible-intro 'a bae-one bae-one)
(dk-ass!)
(bae-qed! 'bae-one-invertible)

;;; the product of invertible elements is invertible: (xy)^(-1) = y^(-1) x^(-1)
(sp (bae-st '(FORALL x (IMPLIES (IS-INVERTIBLE-EL a x) (FORALL y (IMPLIES (IS-INVERTIBLE-EL a y)
  (IS-INVERTIBLE-EL a ((VMUL a) x y))))))))
(dk-peel!)
(dk-project! '(IN x (VEC a)) 'IS-INVERTIBLE-EL '(IS-INVERTIBLE-EL a x))
(dk-project! '(IN y (VEC a)) 'IS-INVERTIBLE-EL '(IS-INVERTIBLE-EL a y))
(let* ((xi '(INVERSE-EL a x)) (yi '(INVERSE-EL a y))
       (p (bae-m 'x 'y)) (q (bae-m yi xi)))
  (bae-vt p) (bae-vt q)
  (dk-cite! 'bae-inverse-left 'a 'x) (dk-cite! 'bae-inverse-right 'a 'x)
  (dk-cite! 'bae-inverse-left 'a 'y) (dk-cite! 'bae-inverse-right 'a 'y)
  ;; q p = y^-1 (x^-1 (x y)) = y^-1 ((x^-1 x) y) = y^-1 y = 1
  (dk-have! (list '= (bae-m q p) bae-one)
    (lambda ()
      (dk-cite! 'ring-mul-assoc-uba-as-ring 'a yi xi p)
      (dk-cite! 'ring-mul-assoc-uba-as-ring 'a xi 'x 'y)
      (dk-cite! 'ring-mul-left-id-uba-as-ring 'a 'y)
      (bae-rw! (bae-m q p) (bae-m yi (bae-m xi p)))
      (bae-rw! (bae-m xi p) (bae-m (bae-m xi 'x) 'y))
      (bae-rw! (bae-m xi 'x) bae-one)
      (bae-rw! (bae-m bae-one 'y) 'y)
      (dk-ass!)))
  (dk-have! (list '= (bae-m p q) bae-one)
    (lambda ()
      (dk-cite! 'ring-mul-assoc-uba-as-ring 'a 'x 'y q)
      (dk-cite! 'ring-mul-assoc-uba-as-ring 'a 'y yi xi)
      (dk-cite! 'ring-mul-left-id-uba-as-ring 'a xi)
      (bae-rw! (bae-m p q) (bae-m 'x (bae-m 'y q)))
      (bae-rw! (bae-m 'y q) (bae-m (bae-m 'y yi) xi))
      (bae-rw! (bae-m 'y yi) bae-one)
      (bae-rw! (bae-m bae-one xi) xi)
      (dk-ass!)))
  (dk-cite! 'bae-invertible-intro 'a p q)
  (dk-ass!))
(bae-qed! 'bae-invertible-mul)

;;; ---- powers ----------------------------------------------------------------------------
;;; EL-POW(a, x, 0) == 1, EL-POW(a, x, succ n) == x x^n (ba-vocab, def-by-nn-recursion).
(define (bae-p x n) (list 'EL-POW 'a x n))
;;; cite a theorem whose instance stops at a CONJUNCTIVE antecedent held in context, piecewise
(define (bae-cite2! . args)
  (detach-with! (apply dk-cite! args) (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
(define (bae-ind!) (let ((br (dk-use-induction-fixed!)))
  (list (cdr (assq 'base br)) (cdr (assq 'step br)) (cdr (assq 'ih br)) (cdr (assq 'var br)))))
(define (bae-pow0! x) (fact 'EL-POW-zero 'a x) (subst (list '== (bae-p x 0) bae-one)))
(define (bae-pows! x v) (fact 'EL-POW-succ 'a x v)
  (subst (list '== (bae-p x (list 'succ v)) (bae-m x (bae-p x v)))))

(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a)
  (FORALL x (IMPLIES (IN x (VEC a)) (IN (EL-POW a x n) (VEC a))))))))))
(let* ((br (bae-ind!)) (base (car br)) (step (cadr br)) (ih (caddr br)) (v (cadddr br)))
  (dk-focus! base)
  (dk-peel!)
  (bae-pow0! 'x)
  (bae-vt bae-one) (dk-ass!)
  (dk-focus! step)
  (dk-peel!)
  (bae-pows! 'x v)
  (dk-apply! ih 'x)
  (dk-cite! 'ring-carrier-closed-mul-uba-as-ring 'a 'x (bae-p 'x v))
  (dk-ass!))
(bae-qed! 'bae-el-pow-type)

(sp (bae-st '(FORALL x (IMPLIES (IN x (VEC a)) (= (EL-POW a x 1) x)))))
(dk-peel!)
(dk-have! '(= 1 (succ 0)) (lambda () (arith)))
(subst '(= 1 (succ 0)))
(fact 'nn-zero-in)
(bae-pows! 'x 0)
(bae-pow0! 'x)
(dk-cite! 'ring-mul-right-id-uba-as-ring 'a 'x)
(dk-ass!)
(bae-qed! 'bae-el-pow-one)

;;; x x^n = x^n x
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a)
  (FORALL x (IMPLIES (IN x (VEC a)) (= ((VMUL a) x (EL-POW a x n)) ((VMUL a) (EL-POW a x n) x))))))))))
(let* ((br (bae-ind!)) (base (car br)) (step (cadr br)) (ih (caddr br)) (v (cadddr br)))
  (dk-focus! base)
  (dk-peel!)
  (bae-pow0! 'x)
  (dk-cite! 'ring-mul-right-id-uba-as-ring 'a 'x)
  (dk-cite! 'ring-mul-left-id-uba-as-ring 'a 'x)
  (bae-rw! (bae-m 'x bae-one) 'x)
  (bae-rw! (bae-m bae-one 'x) 'x)
  (rfl)
  (dk-focus! step)
  (dk-peel!)
  (let ((pv (bae-p 'x v)))
    (dk-apply! ih 'x)
    (dk-cite! 'bae-el-pow-type v 'a 'x)
    (bae-pows! 'x v)
    (dk-cite! 'ring-mul-assoc-uba-as-ring 'a 'x pv 'x)
    (bae-rw! (bae-m (bae-m 'x pv) 'x) (bae-m 'x (bae-m pv 'x)))
    (bae-rw! (bae-m pv 'x) (bae-m 'x pv))
    (bae-vt (bae-m 'x (bae-m 'x pv)))
    (rfl)))
(bae-qed! 'bae-el-pow-comm)

(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a)
  (FORALL x (IMPLIES (IN x (VEC a)) (= (EL-POW a x (succ n)) ((VMUL a) (EL-POW a x n) x))))))))))
(dk-peel!)
(bae-pows! 'x 'n)
(dk-cite! 'bae-el-pow-comm 'n 'a 'x)
(dk-ass!)
(bae-qed! 'bae-el-pow-succ-right)

;;; ||x^n|| <= ||x||^n
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a)
  (FORALL x (IMPLIES (IN x (VEC a)) (<= ((VNRM a) (EL-POW a x n)) (POWER ((VNRM a) x) n))))))))))
(let* ((br (bae-ind!)) (base (car br)) (step (cadr br)) (ih (caddr br)) (v (cadddr br))
       (nx (bae-nr 'x)))
  (dk-focus! base)
  (dk-peel!)
  (bae-pow0! 'x)
  (dk-cite! 'bal-uba-vone-norm 'a)
  (bae-rw! (bae-nr bae-one) 1)
  (dk-cite! 'bae-vnrm-type 'a 'x)
  (dk-cite! 'rr-subset-cc nx)
  (dk-cite! 'power-zero nx)
  (bae-rw! (list 'POWER nx 0) 1)
  (ineq)
  (dk-focus! step)
  (dk-peel!)
  (let* ((pv (bae-p 'x v)) (npv (bae-nr pv)) (rv (list 'POWER nx v)))
    (dk-apply! ih 'x)
    (dk-cite! 'bae-el-pow-type v 'a 'x)
    (dk-cite! 'bae-vnrm-type 'a 'x)
    (dk-cite! 'bae-vnrm-type 'a pv)
    (dk-cite! 'rr-subset-cc nx)
    (dk-cite! 'power-real-closed nx v)
    (bae-cite2! 'power-succ nx v)
    (bae-rw! (list 'POWER nx (list 'succ v)) (list '* nx rv))
    (bae-pows! 'x v)
    (bae-vt (bae-m 'x pv))
    (dk-cite! 'bae-vnrm-type 'a (bae-m 'x pv))
    (dk-cite! 'bal-uba-vnrm-submult 'a 'x pv)
    (dk-cite! 'bal-uba-vnrm-nonneg 'a 'x)
    (dk-cite! 'rr-mul-le-right npv rv nx)
    (dk-have! (list '= (list '* nx npv) (list '* npv nx)) (lambda () (crs)))
    (dk-have! (list '= (list '* rv nx) (list '* nx rv)) (lambda () (crs)))
    (dk-le-chain! (bae-nr (bae-m 'x pv)) (list '* nx npv) (list '* npv nx) (list '* rv nx) (list '* nx rv))))
(bae-qed! 'bae-el-pow-norm)

