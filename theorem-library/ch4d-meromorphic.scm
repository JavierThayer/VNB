(dk-cite! 'holomorphic-on-continuous 'u c4c-gd)
(dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES '(IN hbz_ u) (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'u 'f 'hbz_ (list c4c-gd 'hbz_))))
  (lambda () (let* ((z (dk-di-var!)) (fin (c4-close! ass))) (c4-dz! 'u 'f z) (c4-lam-b!) (fin))))
