                   (list '* (list 'recip '(* (* 2 PI) +i)) (list 'LINE-INT c4c-LDw 'mdp_ 'mdq_ 'mds_ 'mdt_)))))))))))))))))
(dk-peel!)
(c4c-setup!)
(define (c4c-ptw! v)                   ; v in CCINT(s, t): also f(p v) /= w, typed off w
  (let* ((pv (c4c-pt! v)) (fv (list 'f pv)))
    (fact 'subset-mem-fwd c4c-TR 'c4cv_ pv)
