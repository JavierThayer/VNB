;;; ===============================================================================================================
;;; (2) d/dz (z - c)^(j+1) = (j+1) (z - c)^j on CC, j symbolic.  Induction on j, the product rule with z - c.
;;; ===============================================================================================================
(define (c4g-P c n) (list 'VNB-LAMBDA 'c4v_ 'CC (list 'power (list '- 'c4v_ c) n)))
(define (c4g-L0 c) (list 'VNB-LAMBDA 'c4v_ 'CC (list '- 'c4v_ c)))
(define (c4g-pd-goal j)
  (list 'FORALL 'c4c_ (list 'IMPLIES '(IN c4c_ CC)
    (list 'FORALL 'c4w_ (list 'IMPLIES '(IN c4w_ CC)
      (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'CC (c4g-P 'c4c_ (list 'succ j)) 'c4w_
            (list '* (list 'succ j) (list 'power '(- c4w_ c4c_) j))))))))



(sp (make-wff (list 'FORALL 'c4j_ (list 'IMPLIES '(IN c4j_ NN) (c4g-pd-goal 'c4j_)))))
(define c4g-pd-br (use-induction))
(dk-focus! (cdr (assq 'base c4g-pd-br)))
(dk-peel!)
(let* ((c 'c4c_) (w 'c4w_) (L0 (c4g-L0 c)) (P (c4g-P c '(succ 0))))
  (c4g-cc-setup!)
  (fact 'nn-succ-closed 0)
  (c4-lam-typ! P 'CC (lambda (v) #t))
  (c4g-carr-typ! P 'CC)
  (dk-diff! 'CC L0 w 1)
  (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ 'CC) (list '== (list P 'hbx_) (list L0 'hbx_))))
    (lambda ()
      (let* ((x (dk-di-var!)) (ax (list '- x c)))
        (c4-cc! ax)
        (dk-lam-b!)
        (subst (c4g-pow-succ! ax 0))
        (subst (dk-cite! 'power-zero ax))
        (dk-have! (list '= (list '* ax 1) ax) (lambda () (crs)))
        (subst (list '= (list '* ax 1) ax))
        (qrfl))))
  (dk-cite! 'diff-on-transfer-ptwise-eq 'CC-NORMED-FIELD 'CC P L0 w 1)
  (let* ((gv (list-ref (dk-goal) 5)) (a (list '- w c)))
    (c4-cc! a)
    (dk-have! (list '= gv 1)
      (lambda ()
        (subst (dk-cite! 'power-zero a))
        (subst (dk-cite! 'nn-succ-plus-one 0))
        (crs)))
    (subst (list '= gv 1))
    (ass)))
(dk-focus! (cdr (assq 'step c4g-pd-br)))
(define c4g-pd-n (cdr (assq 'var c4g-pd-br)))
(define c4g-pd-ih (cdr (assq 'ih c4g-pd-br)))
(dk-peel!)
(let* ((n c4g-pd-n) (sn (list 'succ n)) (ssn (list 'succ sn))
       (c (cadr (dk-pick (lambda (f) (and (c4-op? f 'IN 3) (eq? (caddr f) 'CC) (symbol? (cadr f)) (string-prefix? "c4c_" (symbol->string (cadr f))))) "c")))
       (w (cadr (dk-pick (lambda (f) (and (c4-op? f 'IN 3) (eq? (caddr f) 'CC) (symbol? (cadr f)) (string-prefix? "c4w_" (symbol->string (cadr f))))) "w")))
       (L0 (c4g-L0 c)) (Pn (c4g-P c sn)) (P (c4g-P c ssn))
       (a (list '- w c)))
  (c4g-cc-setup!)
  (fact 'nn-succ-closed n)
  (fact 'nn-succ-closed sn)
  (c4-lam-typ! P 'CC (lambda (v) #t))
  (c4-lam-typ! Pn 'CC (lambda (v) #t))
  (c4-lam-typ! L0 'CC (lambda (v) #t))
  (c4g-carr-typ! P 'CC)
  (let* ((dr (dk-diff! 'CC L0 w 1))
         (dp (dk-apply! c4g-pd-ih c w))
         (l (list-ref dr 5)) (m (list-ref dp 5))
         (pr (dk-cite! 'diff-on-product 'CC-NORMED-FIELD 'CC L0 Pn w l m))
         (plam (list-ref pr 3)) (pval (list-ref pr 5)))
    (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ 'CC) (list '== (list P 'hbx_) (list plam 'hbx_))))
      (lambda ()
        (let* ((x (dk-di-var!)) (ax (list '- x c)) (q (list 'power ax sn)))
          (c4-cc! ax)
          (dk-lam-b!)
          (c4-cc! q)
          (subst (dk-cite! 'cc-nf-mul-apply ax q))
          (subst (c4g-pow-succ! ax sn))
          (qrfl))))
    (dk-cite! 'diff-on-transfer-ptwise-eq 'CC-NORMED-FIELD 'CC P plam w pval)
    (let* ((gv (list-ref (dk-goal) 5))
           (q (list 'power a sn)) (q0 (list 'power a n)))
      (c4-cc! a) (c4-cc! q) (c4-cc! q0) (c4-cc! m)
      (dk-have! (list '= gv pval)
        (lambda ()
          (dk-lam-b!)
          (c4-cc! (list '* 1 q)) (c4-cc! (list '* m a))
          (subst (dk-cite! 'cc-nf-mul-apply 1 q))
          (subst (dk-cite! 'cc-nf-mul-apply m a))
          (subst (dk-cite! 'cc-nf-add-apply (list '* 1 q) (list '* m a)))
          (subst (c4g-pow-succ! a n))
          (subst (dk-cite! 'nn-succ-plus-one sn))
          (subst (dk-cite! 'nn-succ-plus-one n))
          (let* ((qv (c4-cc-name! q0)) (nv (c4-cc-name! n)) (av (c4-cc-name! a)))
            (subst (list '= q0 qv))
            (subst (list '= n nv))
            (subst (list '= a av))
            (crs))))
      (subst (list '= gv pval))
      (ass))))
(c4-dump-open!)
(qed 'cc-power-sub-diff)

;;; ===============================================================================================================
;;; (3) PROPOSITION 4.17, THE POLE CASE: f holomorphic on an open u, with a pole of order N at c.  Then on a
;;;     punctured ball about c (inside u), f /= 0 and f'/f = h - N/(z - c), h holomorphic on the ball.
;;;     f = (1/(z - c))^N g with g(c) /= 0; on a ball where g /= 0, h = g'/g, and the product rule with
;;;     cif-recip-power-diff ((1/(z - c))^(j+1))' = -(j+1) (1/(z - c))^(j+2), carried to f by cc-diff-on-local.
;;; ===============================================================================================================

(define c4g-ldp-stmt
  (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN c4g-nfm 'u)
   (list 'FORALL 'f (list 'IMPLIES '(HOLOMORPHIC-ON u f)
    (list 'FORALL 'c (list 'FORALL 'c4pn_ (list 'IMPLIES '(IS-POLE f c c4pn_)
     (list 'FORSOME 'c4pr_ (list 'AND '(IN c4pr_ RR) (list 'AND '(< 0 c4pr_)
      (list 'AND '(SUBSET (DIFFERENCE (BALL CC-MS c c4pr_) (SINGLETON c)) u)
       (list 'FORSOME 'c4ph_ (list 'AND '(HOLOMORPHIC-ON (BALL CC-MS c c4pr_) c4ph_)
        (list 'FORALL 'c4pz_ (list 'IMPLIES '(IN c4pz_ (DIFFERENCE (BALL CC-MS c c4pr_) (SINGLETON c)))
          (list 'AND '(NOT (= (f c4pz_) 0))
                '(= (* (DERIV-ON CC-NORMED-FIELD u f c4pz_) (recip (f c4pz_)))
                    (+ (c4ph_ c4pz_) (* (- c4pn_) (recip (- c4pz_ c))))))))))))))))))))))
(sp (make-wff c4g-ldp-stmt))
(dk-peel!)
(define c4g-pole-n (cadddr (dk-pick (lambda (fm) (dk-head-is? fm 'IS-POLE)) "the pole hypothesis")))
(c4-unfold! 'is-pole (list 'f 'c c4g-pole-n) (list 'IS-POLE 'f 'c c4g-pole-n))
(define c4g-r1 (c4-sk! 'mrr))
(dk-split-all!)
(define c4g-g (c4-sk! 'mrg c4g-r1))
(dk-split-all!)
(define c4g-B1 (c4-B 'c c4g-r1))
(define c4g-law (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm c4g-g) (dk-contains? fm 'power))) "f = (1/(z - c))^N g"))
(dk-cite! 'cc-open-subset-cc 'u)
(dk-cite! 'holomorphic-on-in-fun 'u 'f)
(fact 'cc-is-set) (fact 'cc-is-normed-field) (fact 'nf-cc-is-metric-space)
(fact 'rr-zero-in) (fact 'cc-zero-in) (fact 'rr-one-in) (fact 'cc-one-in)
(c4-ball-setup! 'c c4g-r1)
(c4-center-in-ball! 'c c4g-r1)
(dk-cite! 'holomorphic-on-in-fun c4g-B1 c4g-g)
(define c4g-j (dk-skolem! (dk-cite! 'nn-pos-is-succ c4g-pole-n)))
(dk-split-all!)
(define c4g-sj (list 'succ c4g-j))
(fact 'nn-succ-closed c4g-j)
(c4-nonzero-ball! c4g-B1 'c c4g-g
  (lambda (r0 B)
    (let* ((g c4g-g) (B1 c4g-B1) (N c4g-pole-n) (j c4g-j) (sj c4g-sj)
           (W (list 'DIFFERENCE B (list 'SINGLETON 'c)))
           (gnz (list 'FORALL 'c4y_ (list 'IMPLIES (list 'IN 'c4y_ B) (list 'NOT (list '= (list g 'c4y_) 0)))))
           (gd (list 'VNB-LAMBDA 'cifdw_ B1 (list 'DERIV-ON 'CC-NORMED-FIELD B1 g 'cifdw_)))
           (Rg (list 'RESTRICT g B)) (Rgd (list 'RESTRICT gd B)))
      ;; W open, W inside B, B1 and CC \ {c}
      (c4-inst! (dk-cite! 'cif-open-minus-point B) 'c)
      (dk-have! (list 'SUBSET W B1)
        (lambda () (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
                     (c4-pb-open! 'c r0 y) (fact 'subset-mem-fwd B B1 y) (if (not (sequent-node-grounded? leaf)) (ass)))))
      (dk-have! (list 'SUBSET W (c4-pz 'c))
        (lambda () (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
                     (c4-pb-open! 'c r0 y) (if (not (sequent-node-grounded? leaf)) (ass)))))
      ;; the law at a point of W
      (define (law-at! y)              ; y in W: y in B1 \ {c}, f y = (1/(y - c))^N g y, everything typed
        (c4-pb-open! 'c r0 y)
        (fact 'subset-mem-fwd B B1 y)
        (c4-pb-in! 'c c4g-r1 y)
        (fact 'fun-apply-type-c g B1 'CC y)
        (c4-cc! (list 'recip (list '- y 'c)))
        (c4-cc! (list 'power (list 'recip (list '- y 'c)) N))
        (c4-inst! c4g-law y))
      ;; W inside u: f y = t carries y in dom f
      (dk-have! (list 'SUBSET W 'u)
        (lambda () (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
                     (let* ((e (law-at! y)))
                       (dk-cite! 'fun-value-in-domain 'u 'CC 'f y (caddr e))
                       (if (not (sequent-node-grounded? leaf)) (ass))))))
      ;; h = g'/g on B
      (dk-cite! 'holomorphic-deriv-holomorphic B1 g)
      (dk-cite! 'holomorphic-on-in-fun B1 gd)
      (dk-cite! 'holomorphic-on-restrict B1 gd B)
      (dk-cite! 'holomorphic-on-restrict B1 g B)
      (dk-cite! 'holomorphic-on-in-fun B Rg)
      (dk-cite! 'holomorphic-on-in-fun B Rgd)
      (let* ((gB (dk-name! Rg (list 'FUN B 'CC)))
             (gdB (dk-name! Rgd (list 'FUN B 'CC))))
        (dk-rewrite-h! (list 'HOLOMORPHIC-ON B Rg) Rg gB)
        (dk-rewrite-h! (list 'HOLOMORPHIC-ON B Rgd) Rgd gdB)
        (define (gB-at! y)                ; y in B: gB y = g y, gdB y = g'(y)
          (fact 'subset-mem-fwd B B1 y)
          (fact 'fun-apply-type-c g B1 'CC y)
          (fact 'fun-apply-type-c gd B1 'CC y)
          (if (not (dk-asm? (list '= (list gB y) (list g y))))
              (dk-have! (list '= (list gB y) (list g y))
                (lambda () (subst (list '= gB Rg)) (fact 'restrict-apply g B y) (subst (list '== (list Rg y) (list g y))) (rfl))))
          (let ((Dy (list 'DERIV-ON 'CC-NORMED-FIELD B1 g y)))
            (if (not (dk-asm? (list 'IN Dy 'CC))) (dk-lam-b-h! (list 'IN (list gd y) 'CC)))
            (if (not (dk-asm? (list '= (list gdB y) Dy)))
                (dk-have! (list '= (list gdB y) Dy)
                  (lambda () (subst (list '= gdB Rgd)) (fact 'restrict-apply gd B y) (subst (list '== (list Rgd y) (list gd y)))
                             (if (not (c4-lam-b!)) (rfl)))))))
        (dk-have! (list 'FORALL 'c4y_ (list 'IMPLIES (list 'IN 'c4y_ B) (list 'NOT (list '= (list gB 'c4y_) 0))))
          (lambda () (let* ((y (dk-di-var!)))
                       (gB-at! y)
                       (subst (list '= (list gB y) (list g y)))
                       (c4-inst! (dk-ctx-form gnz) y)
                       (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))
        (let* ((h (list 'VNB-LAMBDA 'c4hw_ B (list '* (list gdB 'c4hw_) (list 'recip (list gB 'c4hw_))))))
          (dk-have! (list 'HOLOMORPHIC-ON B h) (lambda () (dk-holomorphic! B h)))
          (ew r0)
          (dk-conj-close!
            (lambda ()
              (cond ((dk-asm? (dk-goal)) (ass))
                    ((dk-head-is? (dk-goal) 'FORSOME)
                     (ew h)
                     (dk-conj-close!
                       (lambda ()
                         (if (dk-asm? (dk-goal)) (ass)
                             (let* ((z (dk-di-var!)) (A (list '- z 'c)) (R (list 'recip A)) (RN (list 'power R N))
                                    (gz (list g z)) (Dg (list 'DERIV-ON 'CC-NORMED-FIELD B1 g z))
                                    (e (law-at! z)))
                               (gB-at! z)
                               (c4-inst! (dk-ctx-form gnz) z)
                               ;; f z /= 0
                               (c4-recip-nz! A)
                               (c4-cc! RN)
                               (dk-cite! 'cc-power-nonzero N R)
                               (c4-cc! gz)
                               (dk-cite! 'cc-mul-nonzero RN gz)
                               (dk-rewrite-h! (list 'NOT (list '= (list '* RN gz) 0)) (list '* RN gz) (list 'f z))
                               ;; the derivative of f at z
                               (c4-pz-in! 'c z)
                               (let* ((dq (dk-cite! 'cif-recip-power-diff j 'c z))
                                      (Q (list-ref dq 3)) (L1 (list-ref dq 5))
                                      (sq (c4-inst! (dk-cite! 'diff-on-shrink 'CC-NORMED-FIELD (c4-pz 'c) Q z L1) W))
                                      (dgz (c4-dz! B1 g z))
                                      (sg (c4-inst! (dk-cite! 'diff-on-shrink 'CC-NORMED-FIELD B1 g z Dg) W))
                                      (RqW (list 'RESTRICT Q W)) (RgW (list 'RESTRICT g W)))
                                 (if (not (dk-asm? '(== (CARR CC-NORMED-FIELD) CC))) (fact 'cc-nf-carr))
                                 (dk-cite! 'diff-on-in-fun 'CC-NORMED-FIELD W RqW z L1)
                                 (dk-cite! 'diff-on-in-fun 'CC-NORMED-FIELD W RgW z Dg)
                                 (dk-rewrite-h! (list 'IN RqW (list 'FUN W '(CARR CC-NORMED-FIELD))) '(CARR CC-NORMED-FIELD) 'CC)
                                 (dk-rewrite-h! (list 'IN RgW (list 'FUN W '(CARR CC-NORMED-FIELD))) '(CARR CC-NORMED-FIELD) 'CC)
                                 (let* ((qW (dk-name! RqW (list 'FUN W 'CC)))
                                        (gW (dk-name! RgW (list 'FUN W 'CC))))
                                   (dk-rewrite-h! (list 'IS-DIFF-ON 'CC-NORMED-FIELD W RqW z L1) RqW qW)
                                   (dk-rewrite-h! (list 'IS-DIFF-ON 'CC-NORMED-FIELD W RgW z Dg) RgW gW)
                                   (define (vals! y)   ; y in W: qW y = (1/(y - c))^N, gW y = g y
                                     (law-at! y)
                                     (c4-pz-in! 'c y)
                                     (let ((e1 (list '= (list qW y) (list 'power (list 'recip (list '- y 'c)) N)))
                                           (e2 (list '= (list gW y) (list g y))))
                                       (if (not (dk-asm? e1))
                                           (dk-have! e1 (lambda () (subst (list '= qW RqW)) (fact 'restrict-apply Q W y)
                                                                   (subst (list '== (list RqW y) (list Q y)))
                                                                   (c4-lam-b!)
                                                                   (subst (list '= N sj))
                                                                   (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
                                       (if (not (dk-asm? e2))
                                           (dk-have! e2 (lambda () (subst (list '= gW RgW)) (fact 'restrict-apply g W y)
                                                                   (subst (list '== (list RgW y) (list g y)))
                                                                   (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))))
                                   (vals! z)
                                   (let* ((pr (dk-cite! 'diff-on-product 'CC-NORMED-FIELD W qW gW z L1 Dg))
                                          (P (list-ref pr 3)) (D (list-ref pr 5))
                                          (qz (list qW z)) (gwz (list gW z)))
                                     (c4-cc! L1) (c4-cc! Dg)
                                     (fact 'fun-apply-type-c qW W 'CC z) (fact 'fun-apply-type-c gW W 'CC z)
                                     (dk-have! (list 'FORALL 'c4x_ (list 'IMPLIES (list 'IN 'c4x_ W) (list '= (list 'f 'c4x_) (list P 'c4x_))))
                                       (lambda () (let* ((x (dk-di-var!)) (fin (c4-close! ass)))
                                                    (vals! x)
                                                    (fact 'fun-apply-type-c qW W 'CC x) (fact 'fun-apply-type-c gW W 'CC x)
                                                    (c4-lam-b!)
                                                    (subst (dk-cite! 'cc-nf-mul-apply (list qW x) (list gW x)))
                                                    (subst (list '= (list qW x) (list 'power (list 'recip (list '- x 'c)) N)))
                                                    (subst (list '= (list gW x) (list g x)))
                                                    (fin))))
                                     (c4-inst! (c4-inst! (dk-cite! 'cc-diff-on-local 'u) 'f W) P z D)
                                     (dk-cite! 'cc-deriv-on-of-is-diff-on 'u 'f z D)
                                     (dk-conj-close!
                                       (lambda ()
                                         (if (dk-head-is? (dk-goal) 'NOT)
                                             (ass)
                                             (let* ((leaf (proof-state-focus *ps*)))
                                               (subst (list '= (list 'DERIV-ON 'CC-NORMED-FIELD 'u 'f z) D))
                                               (subst (dk-cite! 'cc-nf-mul-apply L1 gwz))
                                               (subst (dk-cite! 'cc-nf-mul-apply Dg qz))
                                               (c4-cc! (list '* L1 gwz)) (c4-cc! (list '* Dg qz))
                                               (subst (dk-cite! 'cc-nf-add-apply (list '* L1 gwz) (list '* Dg qz)))
                                               (subst (list '= (list 'f z) (list '* RN gz)))
                                               (c4-lam-b!)
                                               (subst (list '= (list gdB z) Dg))
                                               (subst (list '= (list gB z) gz))
                                               (subst (list '= (list gW z) gz))
                                               (subst (list '= (list qW z) RN))
                                               (subst (list '= N sj))
                                               (subst (c4g-pow-succ! R sj))
                                               (let* ((Rv (c4-cc-name! R))
                                                      (_ (subst (list '= R Rv)))
                                                      (PwR (list 'power Rv sj))
                                                      (_ (c4-cc! PwR))
                                                      (Pv (c4-cc-name! PwR))
                                                      (_ (subst (list '= PwR Pv)))
                                                      (Gv (c4-cc-name! gz))
                                                      (_ (subst (list '= gz Gv)))
                                                      (Dv (c4-cc-name! Dg))
                                                      (_ (subst (list '= Dg Dv)))
                                                      (_ (c4-cc! sj))
                                                      (sv (c4-cc-name! sj))
                                                      (_ (subst (list '= sj sv)))
                                                      (n1 (dk-rewrite-h! (list 'NOT (list '= RN 0)) N sj))
                                                      (n2 (dk-rewrite-h! n1 R Rv))
                                                      (n3 (dk-rewrite-h! n2 PwR Pv))
                                                      (n4 (dk-rewrite-h! (list 'NOT (list '= gz 0)) gz Gv)))
                                                 (c4-and! (list 'IN Pv 'CC) (list 'IN Gv 'CC))
                                                 (dk-cite! 'cc-mul-nonzero Pv Gv)
                                                 (dk-field-eq! 'CC)
                                                 (if (not (sequent-node-grounded? leaf)) (c4-dump-open!)))))))))))))))
                    (#t (error "c4g-ldp: open conjunct" (dk-goal)))))))))))
(c4-dump-open!)
(qed 'log-derivative-at-pole)

;;; ===============================================================================================================
;;; (4) A SIMPLE POLE FROM A DECOMPOSITION: fn = h + d/(z - c) on a punctured ball, h holomorphic on the ball, d /= 0.
;;;     Then fn has a pole of order 1 at c (g = (z - c) h + d, g(c) = d) and RESIDUE(fn, c) = d
;;;     (residue-of-decomposition with the zero exact part).
;;; ===============================================================================================================
(define c4l-B '(BALL CC-MS c c4lr_))
(define c4l-W '(DIFFERENCE (BALL CC-MS c c4lr_) (SINGLETON c)))
(define c4l-law '(FORALL c4lz_ (IMPLIES (IN c4lz_ (DIFFERENCE (BALL CC-MS c c4lr_) (SINGLETON c)))
                    (= (f c4lz_) (+ (c4lh_ c4lz_) (* c4ld_ (recip (- c4lz_ c))))))))
(sp (make-wff (list 'FORALL 'f (list 'FORALL 'c (list 'FORALL 'c4lr_ (list 'FORALL 'c4ld_ (list 'FORALL 'c4lh_
  (c4-imps (list '(IN c CC) '(IN c4lr_ RR) '(< 0 c4lr_) '(IN c4ld_ CC) '(NOT (= c4ld_ 0)) (list 'HOLOMORPHIC-ON c4l-B 'c4lh_) c4l-law)
    '(AND (IS-POLE f c 1) (= (RESIDUE f c) c4ld_))))))))))
(dk-peel!)
(fact 'cc-is-set) (fact 'cc-is-normed-field) (fact 'nf-cc-is-metric-space)
(fact 'rr-zero-in) (fact 'cc-zero-in) (fact 'rr-one-in) (fact 'cc-one-in) (fact 'nn-zero-in)
(c4-ball-setup! 'c 'c4lr_)
(c4-center-in-ball! 'c 'c4lr_)
(dk-cite! 'holomorphic-on-in-fun c4l-B 'c4lh_)
(define (c4l-pt! z)                    ; z in B \ {c}: typed, and the law at z
  (c4-pb-open! 'c 'c4lr_ z)
  (fact 'fun-apply-type-c 'c4lh_ c4l-B 'CC z)
  (c4-cc! (list 'recip (list '- z 'c)))
  (c4-inst! (dk-ctx-form c4l-law) z))
;; the residue
(define c4l-Z0 '(VNB-LAMBDA mdv_ (DIFFERENCE CC (SINGLETON c)) 0))
(dk-cite! 'md-zero-exact 'c)
(dk-have! (list 'FORALL 'mdz_ (list 'IMPLIES (list 'IN 'mdz_ c4l-W)
            (list '= '(f mdz_) (list '+ '(c4lh_ mdz_) (list '+ '(* c4ld_ (recip (- mdz_ c))) (list c4l-Z0 'mdz_))))))
  (lambda ()
    (let* ((z (dk-di-var!)) (e (c4l-pt! z)) (R (list 'recip (list '- z 'c))) (hz (list 'c4lh_ z)))
      (c4-lam-b!)
      (subst e)
      (let* ((Rv (c4-cc-name! R)) (Hv (c4-cc-name! hz)))
        (subst (list '= R Rv)) (subst (list '= hz Hv))
        (crs)))))
(dk-cite! 'residue-of-decomposition 'c 'c4lr_ 'c4ld_ 'c4lh_ c4l-Z0 'f)
;; the pole of order 1
(define c4l-G (list 'VNB-LAMBDA 'c4lg_ c4l-B '(+ (* (- c4lg_ c) (c4lh_ c4lg_)) c4ld_)))
(dk-have! (list 'HOLOMORPHIC-ON c4l-B c4l-G) (lambda () (dk-holomorphic! c4l-B c4l-G)))
(fact 'fun-apply-type-c 'c4lh_ c4l-B 'CC 'c)
(dk-have! (list '= (list c4l-G 'c) 'c4ld_)
  (lambda () (c4-lam-b!)
             (let* ((Hv (c4-cc-name! '(c4lh_ c)))) (subst (list '= '(c4lh_ c) Hv)) (crs))))
(dk-have! (list 'NOT (list '= (list c4l-G 'c) 0))
  (lambda () (subst (list '= (list c4l-G 'c) 'c4ld_)) (ass)))
(fact 'nn-one-in)
(dk-conj-close!
  (lambda ()
    (cond ((dk-asm? (dk-goal)) (ass))
          ((dk-head-is? (dk-goal) 'IS-POLE)
           (mac 'IS-POLE)
           (dk-conj-close!
             (lambda ()
               (cond ((dk-asm? (dk-goal)) (ass))
                     ((dk-head-is? (dk-goal) '<=) (dk-ineq! '(IN 1 RR)))
                     ((dk-head-is? (dk-goal) 'FORSOME)
                      (ew 'c4lr_)
                      (dk-conj-close!
                        (lambda ()
                          (cond ((dk-asm? (dk-goal)) (ass))
                                ((dk-head-is? (dk-goal) 'FORSOME)
                                 (ew c4l-G)
                                 (dk-conj-close!
                                   (lambda ()
                                     (if (dk-asm? (dk-goal)) (ass)
                                         (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*))
                                                (e (c4l-pt! z)) (A (list '- z 'c)) (R (list 'recip A)) (hz (list 'c4lh_ z)))
                                           (dk-have! (list '= (list 'power R 1) R)
                                             (lambda ()
                                               (let* ((Rv (c4-cc-name! R)))
                                                 (subst (list '= R Rv))
                                                 (fact 'nn-one-is-succ-zero)
                                                 (subst '(= 1 (succ 0)))
                                                 (subst (c4g-pow-succ! Rv 0))
                                                 (subst (dk-cite! 'power-zero Rv))
                                                 (crs))))
                                           (c4-lam-b!)
                                           (subst (list '= (list 'power R 1) R))
                                           (subst e)
                                           (let* ((Hv (c4-cc-name! hz)))
                                             (subst (list '= hz Hv))
                                             (dk-field-eq! 'CC)
                                             (if (not (sequent-node-grounded? leaf)) (c4-dump-open!))))))))
                                (#t (error "c4l: open conjunct (2)" (dk-goal)))))))
                     (#t (error "c4l: open conjunct (1)" (dk-goal)))))))
          (#t (error "c4l: open conjunct (0)" (dk-goal))))))
(c4-dump-open!)
(qed 'simple-pole-of-decomposition)

;;; ===============================================================================================================
;;; (5) PROPOSITION 4.17: if f has a pole of order N (a zero of order m >= 1) at c, then f'/f has a pole of order 1
;;;     at c with residue -N (m).  f'/f is read on the open set where f is holomorphic.
;;; ===============================================================================================================
(define c4l-LD '(VNB-LAMBDA c4lw_ u (* (DERIV-ON CC-NORMED-FIELD u f c4lw_) (recip (f c4lw_)))))
(define (c4l-ld-law! W h d C)          ; C: forall z in W. (AND f z /= 0  f'/f = h z + d/(z - c)), W inside u: the law for LD
  (dk-have! (list 'FORALL 'c4lz_ (list 'IMPLIES (list 'IN 'c4lz_ W)
              (list '= (list c4l-LD 'c4lz_) (list '+ (list h 'c4lz_) (list '* d '(recip (- c4lz_ c)))))))
    (lambda ()
      (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*)))
        (dk-split! (c4-inst! C z))
        (fact 'subset-mem-fwd W 'u z)
        (c4-lam-b!)
        (if (not (sequent-node-grounded? leaf)) (ass))))))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN c4g-nfm 'u)
  (list 'FORALL 'f (list 'IMPLIES '(HOLOMORPHIC-ON u f)
    (list 'FORALL 'c (list 'FORALL 'c4ln_ (list 'IMPLIES '(IS-POLE f c c4ln_)
      (list 'AND (list 'IS-POLE c4l-LD 'c 1) (list '= (list 'RESIDUE c4l-LD 'c) '(- c4ln_))))))))))))
(dk-peel!)
(let* ((N (cadddr (dk-pick (lambda (fm) (dk-head-is? fm 'IS-POLE)) "the pole"))))
  (c4-unfold! 'is-pole (list 'f 'c N) (list 'IS-POLE 'f 'c N))
  (let* ((r (dk-skolem! (c4-inst! (dk-cite! 'log-derivative-at-pole 'u) 'f 'c N)))
         (_ (dk-split-all!))
         (h (c4-sk! 'c4ph))
         (_ (dk-split-all!))
         (W (list 'DIFFERENCE (c4-B 'c r) '(SINGLETON c)))
         (C (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm h) (dk-contains? fm 'DERIV-ON))) "the log-derivative clause")))
    (c4l-ld-law! W h (list '- N) C)
    (c4-cc! (list '- N))
    (c4-rr! N)
    (dk-have! (list 'NOT (list '= (list '- N) 0)) (lambda () (di) (dk-absurd! (list '= (list '- N) 0) (list '<= 1 N) (list 'IN N 'RR))))
    (dk-cite! 'simple-pole-of-decomposition c4l-LD 'c r (list '- N) h)
    (c4-ass-focus!)))
(c4-dump-open!)
(qed 'log-derivative-residue-at-pole)

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN c4g-nfm 'u)
  (list 'FORALL 'c (list 'IMPLIES '(IN c u)
    (list 'FORALL 'f (list 'FORALL 'c4lm_ (c4-imps (list '(HAS-ZERO-OF-ORDER u f c c4lm_) '(<= 1 c4lm_))
      (list 'AND (list 'IS-POLE c4l-LD 'c 1) (list '= (list 'RESIDUE c4l-LD 'c) 'c4lm_)))))))))))
(dk-peel!)
(let* ((hzo (dk-pick (lambda (fm) (dk-head-is? fm 'HAS-ZERO-OF-ORDER)) "the zero"))
       (m (list-ref hzo 4)))
  (dk-project! (list 'IN m 'NN) 'has-zero-of-order hzo)
  (dk-cite! 'cc-open-subset-cc 'u)
  (fact 'subset-mem-fwd 'u 'CC 'c)
  ;; W1K: log-derivative-at-zero wants (IN f (FUN u CC)): from the zero's HOLOMORPHIC-ON conjunct.
  (if (not (dk-asm? '(HOLOMORPHIC-ON u f))) (dk-project! '(HOLOMORPHIC-ON u f) 'has-zero-of-order hzo))
  (dk-cite! 'holomorphic-on-in-fun 'u 'f)
  (let* ((r (dk-skolem! (c4-inst! (dk-cite! 'log-derivative-at-zero m) 'u 'c 'f)))
         (_ (dk-split-all!))
         (h (c4-sk! 'ivh15))
         (_ (dk-split-all!))
         (B (c4-B 'c r))
         (W (list 'DIFFERENCE B '(SINGLETON c)))
         (C (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm h) (dk-contains? fm 'DERIV-ON))) "the log-derivative clause")))
    (dk-have! (list 'SUBSET W 'u)
      (lambda () (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
                   (c4-pb-open! 'c r y) (fact 'subset-mem-fwd B 'u y) (if (not (sequent-node-grounded? leaf)) (ass)))))
    (c4l-ld-law! W h m C)
    (c4-cc! m)
    (c4-rr! m)
    (dk-have! (list 'NOT (list '= m 0)) (lambda () (di) (dk-absurd! (list '= m 0) (list '<= 1 m) (list 'IN m 'RR))))
    (dk-cite! 'simple-pole-of-decomposition c4l-LD 'c r m h)
    (c4-ass-focus!)))
(c4-dump-open!)
(qed 'log-derivative-residue-at-zero)

;;; ===============================================================================================================
;;; (6) THE ORDER OF A POLE IS UNIQUE.  f = (1/(z - a))^N g1 = (1/(z - a))^M g2 near a.  F = (z - a)^M g1 on a ball
;;;     has a zero of order M (factor g1) and equals (z - a)^N g2 (both vanish at a; off a multiply through by
;;;     (z - a)^(N+M), mr-power-cancel), a zero of order N: zero-order-unique.
;;; ===============================================================================================================
(define (c4o-steps!) (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
(define (c4o-pole-data! N)             ; IS-POLE(f, a, N) in context: (r g law), the ball set up
  (c4-unfold! 'is-pole (list 'f 'a N) (list 'IS-POLE 'f 'a N))
  (let* ((r (c4-sk! 'mrr)) (_ (dk-split-all!)) (g (c4-sk! 'mrg r)) (_ (dk-split-all!))
         (law (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm g) (dk-contains? fm 'power))) "the pole law")))
    (c4-ball-setup! 'a r)
    (dk-cite! 'holomorphic-on-in-fun (c4-B 'a r) g)
    (list r g law)))
(define (c4o-zero-pow! M)              ; M in NN, 1 <= M: 0^M = 0
  (let ((goal (list '= (list 'power 0 M) 0)))
    (if (not (dk-asm? goal))
        (let* ((k (dk-skolem! (dk-cite! 'nn-pos-is-succ M))))
          (dk-split-all!)
          (dk-have! goal (lambda () (let ((fin (c4-close! ass))) (subst (list '= M (list 'succ k))) (dk-cite! 'power-zero-base k) (fin))))))
    goal))
(sp (make-wff '(FORALL f (FORALL a (FORALL c4on_ (FORALL c4om_ (IMPLIES (IS-POLE f a c4on_) (IMPLIES (IS-POLE f a c4om_) (= c4on_ c4om_)))))))))
(dk-peel!)
(let* ((poles (filter (lambda (fm) (dk-head-is? fm 'IS-POLE)) (dkd-asms)))
       (N (cadddr (find-first (lambda (fm) (eq? (cadddr fm) 'c4on_)) poles)))
       (M (cadddr (find-first (lambda (fm) (eq? (cadddr fm) 'c4om_)) poles)))
       (d1 (c4o-pole-data! N)) (r1 (car d1)) (g1 (cadr d1)) (law1 (caddr d1))
       (d2 (c4o-pole-data! M)) (r2 (car d2)) (g2 (cadr d2)) (law2 (caddr d2))
       (B1 (c4-B 'a r1)) (B2 (c4-B 'a r2)))
  (fact 'cc-is-set) (fact 'cc-is-normed-field) (fact 'nf-cc-is-metric-space)
  (fact 'rr-zero-in) (fact 'cc-zero-in) (fact 'rr-one-in) (fact 'cc-one-in) (fact 'nn-zero-in)
  (c4o-zero-pow! N) (c4o-zero-pow! M)
  (c4-min! r1 r2
    (lambda (r0)
      (let* ((B (c4-B 'a r0)))
        (c4-ball-setup! 'a r0)
        (c4-center-in-ball! 'a r0)
        (dk-cite! 'cc-ms-ball-mono 'a r0 r1)
        (dk-cite! 'cc-ms-ball-mono 'a r0 r2)
        (dk-cite! 'holomorphic-on-restrict B1 g1 B)
        (dk-cite! 'holomorphic-on-restrict B2 g2 B)
        (dk-cite! 'pow-sub-holomorphic M B 'a)
        (let* ((pw (list 'VNB-LAMBDA 'zlx_ B (list 'power '(- zlx_ a) M)))
               (RG1 (list 'RESTRICT g1 B)) (RG2 (list 'RESTRICT g2 B)))
          (dk-cite! 'holomorphic-on-in-fun B RG1)
          (dk-cite! 'holomorphic-on-in-fun B RG2)
          (dk-cite! 'holomorphic-on-in-fun B pw)
          (let* ((g1B (dk-name! RG1 (list 'FUN B 'CC)))
                 (g2B (dk-name! RG2 (list 'FUN B 'CC)))
                 (pwn (dk-name! pw (list 'FUN B 'CC)))
                 (F (list 'VNB-LAMBDA 'c4ox_ B (list '* (list pwn 'c4ox_) (list g1B 'c4ox_)))))
            (dk-rewrite-h! (list 'HOLOMORPHIC-ON B RG1) RG1 g1B)
            (dk-rewrite-h! (list 'HOLOMORPHIC-ON B RG2) RG2 g2B)
            (dk-rewrite-h! (list 'HOLOMORPHIC-ON B pw) pw pwn)
            (dk-have! (list 'HOLOMORPHIC-ON B F) (lambda () (dk-holomorphic! B F)))
            (define (vals! x)          ; x in B: typed; g1B x = g1 x, g2B x = g2 x, F x = (x - a)^M g1B x
              (c4-ball-pt! 'a r0 x)
              (fact 'subset-mem-fwd B B1 x) (fact 'subset-mem-fwd B B2 x)
              (fact 'fun-apply-type-c g1 B1 'CC x) (fact 'fun-apply-type-c g2 B2 'CC x)
              (fact 'fun-apply-type-c g1B B 'CC x) (fact 'fun-apply-type-c g2B B 'CC x)
              (c4-cc! (list '- x 'a))
              (c4-cc! (list 'power (list '- x 'a) M)) (c4-cc! (list 'power (list '- x 'a) N))
              (let ((e1 (list '= (list g1B x) (list g1 x))) (e2 (list '= (list g2B x) (list g2 x)))
                    (e3 (list '= (list F x) (list '* (list 'power (list '- x 'a) M) (list g1B x)))))
                (if (not (dk-asm? e1))
                    (dk-have! e1 (lambda () (let ((fin (c4-close! rfl))) (subst (list '= g1B RG1)) (fact 'restrict-apply g1 B x) (subst (list '== (list RG1 x) (list g1 x)))
                                            (fin)))))
                (if (not (dk-asm? e2))
                    (dk-have! e2 (lambda () (let ((fin (c4-close! rfl))) (subst (list '= g2B RG2)) (fact 'restrict-apply g2 B x) (subst (list '== (list RG2 x) (list g2 x)))
                                            (fin)))))
                (if (not (dk-asm? e3))
                    (dk-have! e3 (lambda () (let ((leaf (proof-state-focus *ps*)))
                                              (c4-lam-b!) (subst (list '= pwn pw)) (c4-lam-b!)
                                              (if (not (sequent-node-grounded? leaf)) (rfl))))))))
            (vals! 'a)
            (define (hzo! k gB g)      ; HAS-ZERO-OF-ORDER(B, F, a, k) with factor gB; EQ! proves F x = (x - a)^k gB x
              (lambda (eq!)
                (dk-have! (list 'HAS-ZERO-OF-ORDER B F 'a k)
                  (lambda ()
                    (mac 'HAS-ZERO-OF-ORDER)
                    (dk-conj-close!
                      (lambda ()
                        (cond ((dk-asm? (dk-goal)) (ass))
                              ((dk-head-is? (dk-goal) 'FORSOME)
                               (ew gB)
                               (dk-conj-close!
                                 (lambda ()
                                   (cond ((dk-asm? (dk-goal)) (ass))
                                         ((dk-head-is? (dk-goal) 'NOT) (let ((fin (c4-close! ass))) (subst (list '= (list gB 'a) (list g 'a))) (fin)))
                                         ((dk-head-is? (dk-goal) 'FORALL) (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*))) (vals! x) (if (not (sequent-node-grounded? leaf)) (eq! x))))
                                         (#t (error "c4o: open HZO conjunct (2)" (dk-goal)))))))
                              (#t (error "c4o: open HZO conjunct (1)" (dk-goal))))))))))
            ((hzo! M g1B g1) (lambda (x) ((c4-close! ass))))
            ((hzo! N g2B g2)
             (lambda (x)
               (let* ((leaf (proof-state-focus *ps*)) (A (list '- x 'a))
                      (P1 (list 'power A M)) (P2 (list 'power A N)) (Gx1 (list g1 x)) (Gx2 (list g2 x)))
                 (subst (list '= (list F x) (list '* P1 (list g1B x))))
                 (subst (list '= (list g1B x) Gx1))
                 (subst (list '= (list g2B x) Gx2))
                 (use-em (list '= x 'a)
                   (lambda ()
                     (dk-have! (list '= A 0) (lambda () (subst (list '= x 'a)) (crs)))
                     (subst (list '= A 0))
                     (subst (list '= (list 'power 0 M) 0))
                     (subst (list '= (list 'power 0 N) 0))
                     (let* ((Gx1v (c4-cc-name! Gx1)) (Gx2v (c4-cc-name! Gx2)))
                       (subst (list '= Gx1 Gx1v)) (subst (list '= Gx2 Gx2v))
                       (crs)))
                   (lambda ()
                     (let* ((R (list 'recip A)) (Q1 (list 'power R M)) (Q2 (list 'power R N)))
                       (c4-sub-nz! x 'a)
                       (c4-pb-in! 'a r1 x) (c4-pb-in! 'a r2 x)
                       (c4-cc! R) (c4-cc! Q1) (c4-cc! Q2)
                       (let* ((l1 (c4-inst! law1 x)) (l2 (c4-inst! law2 x))
                              (c1 (c4-inst! (dk-cite! 'lc-power-cancel A) M))
                              (c2 (c4-inst! (dk-cite! 'lc-power-cancel A) N))
                              (E (list '= (list '* Q2 Gx1) (list '* Q1 Gx2))))
                         (dk-have! E (lambda () (let ((fin (c4-close! ass))) (subst (list '= (list '* Q2 Gx1) (list 'f x))) (fin))))
                         (let* ((P1v (c4-cc-name! P1)) (P2v (c4-cc-name! P2)) (Q1v (c4-cc-name! Q1)) (Q2v (c4-cc-name! Q2))
                                (Gx1v (c4-cc-name! Gx1)) (Gx2v (c4-cc-name! Gx2))
                                (ren (lambda (f0) (let* ((f1 (c4-rw-if! f0 P1 P1v)) (f2 (c4-rw-if! f1 P2 P2v))
                                                         (f3 (c4-rw-if! f2 Q1 Q1v)) (f4 (c4-rw-if! f3 Q2 Q2v)))
                                                    f4)))
                                (c1v (ren c1)) (c2v (ren c2))
                                (Ev (let* ((f1 (dk-rewrite-h! E Q1 Q1v)) (f2 (dk-rewrite-h! f1 Q2 Q2v))
                                           (f3 (dk-rewrite-h! f2 Gx1 Gx1v)) (f4 (dk-rewrite-h! f3 Gx2 Gx2v)))
                                      f4))
                                (X1 (list '* (list '* P1v P2v) (list '* Q2v Gx1v)))
                                (X2 (list '* (list '* P1v P2v) (list '* Q1v Gx2v))))
                           (subst (list '= P1 P1v)) (subst (list '= P2 P2v))
                           (subst (list '= Gx1 Gx1v)) (subst (list '= Gx2 Gx2v))
                           (dk-have! (list '= (list '* P1v Gx1v) X1)
                             (lambda ()
                               (dk-have! (list '= X1 (list '* (list '* P1v Gx1v) (list '* P2v Q2v))) (lambda () (crs)))
                               (subst (list '= X1 (list '* (list '* P1v Gx1v) (list '* P2v Q2v))))
                               (subst (list '= (list '* P2v Q2v) 1))
                               (crs)))
                           (dk-have! (list '= (list '* P2v Gx2v) X2)
                             (lambda ()
                               (dk-have! (list '= X2 (list '* (list '* P2v Gx2v) (list '* P1v Q1v))) (lambda () (crs)))
                               (subst (list '= X2 (list '* (list '* P2v Gx2v) (list '* P1v Q1v))))
                               (subst (list '= (list '* P1v Q1v) 1))
                               (crs)))
                           (subst (list '= (list '* P1v Gx1v) X1))
                           (subst (list '= (list '* Q2v Gx1v) (list '* Q1v Gx2v)))
                           (subst (list '= (list '* P2v Gx2v) X2))
                           (if (not (sequent-node-grounded? leaf)) (rfl))))))))))
            (dk-cite! 'zero-order-unique B F 'a N M)
            (c4-ass-focus!)))))))
(c4-dump-open!)
(qed 'pole-order-unique)

(sp (make-wff '(FORALL f (FORALL a (FORALL c4on_ (IMPLIES (IS-POLE f a c4on_) (= (POLE-ORDER f a) c4on_)))))))
(let* ((new (c4o-steps!)) (hm (find-first (lambda (q) (dk-head-is? q 'IS-POLE)) new))
       (f (cadr hm)) (a (caddr hm)) (n (cadddr hm))
       (io (list 'IOTA 'pon_ (list 'IS-POLE f a 'pon_))))
  (mac 'POLE-ORDER)
  (for-each
    (lambda (l)
      (dk-focus! l)
      (cond
        ((dk-head-is? (dk-goal) 'FORSOME)
         (ew n)
         (dk-conj-close!
           (lambda ()
             (if (dk-asm? (dk-goal)) (dk-ass!)
               (let* ((ny (c4o-steps!)) (y (cadddr (find-first (lambda (q) (dk-head-is? q 'IS-POLE)) ny))))
                 (dk-close-if! (lambda () (dk-cite! 'pole-order-unique f a n y)) (lambda () (dk-ass!))))))))
        (#t (dk-close-if! (lambda () (dk-cite! 'pole-order-unique f a io n)) (lambda () (dk-ass!))))))
    (dk-opened (lambda () (iota-d io)))))
(c4-dump-open!)
(qed 'pole-order-value)

;;; ===============================================================================================================
;;; (7) PROPOSITION 4.19, THE ARGUMENT PRINCIPLE FOR A MEROMORPHIC f.  P (the poles) and Z (the zeros) finite;
;;;     f holomorphic on u \ P with a pole at each point of P; the zeros of f on u \ P are exactly Z, each of finite
;;;     order.  For a closed road in u \ (Z u P), null-homotopic in u:
;;;       (1 / 2 pi i) int f'/f = sum_{a in Z} ZERO-ORDER(u \ P, f, a) WINDING(a) + sum_{a in P} (-POLE-ORDER(f, a)) WINDING(a)
;;;     i.e. the sum over the exceptional points of deg(f, a) WINDING(a) (Def 4.16).  The residue theorem in its
;;;     decomposition form (residue-theorem-induction) over E = Z u P, the decompositions of f'/f being
;;;     log-derivative-at-zero and log-derivative-at-pole; the sum splits over Z and P (finsum-union-disjoint).
;;; ===============================================================================================================
(define c4a-U '(DIFFERENCE u mps_))
(define c4a-E '(UNION mzs_ mps_))
