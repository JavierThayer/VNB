(define c4n-E0 (list 'SEP 'acnz_ c4n-CB (list '= (list c4n-gu 'acnz_) 0)))
(define c4n-E (list 'SEP 'c4ne_ c4n-Bp (list '= (list c4n-Rg 'c4ne_) 0)))
