    (list 'FORALL 'b (c4-imps (list '(IN b u) '(= (f b) 0) '(NOT (= (DERIV-ON CC-NORMED-FIELD u f b) 0)))
      '(HAS-ZERO-OF-ORDER u f b 1)))))))))
