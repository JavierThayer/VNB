(define (c4a-B e r) (list 'BALL 'CC-MS e r))
(define (c4a-law fn e d h F r)
  (list 'FORALL 'mqz_ (list 'IMPLIES (list 'IN 'mqz_ (list 'DIFFERENCE (c4a-B e r) (list 'SINGLETON e)))
    (list '= (list fn 'mqz_) (list '+ (list h 'mqz_) (list '+ (list '* d (list 'recip (list '- 'mqz_ e))) (list F 'mqz_)))))))
(define (c4a-road-zero e F)
  (list 'FORALL 'mdp_ (list 'FORALL 'mdq_ (list 'FORALL 'mds_ (list 'FORALL 'mdt_
    (list 'IMPLIES '(IS-ROAD mdp_ mdq_ mds_ mdt_) (list 'IMPLIES (list 'SUBSET '(TRACE mdp_ mds_ mdt_) (c4-pz e))
      (list 'IMPLIES '(= (mdp_ mdt_) (mdp_ mds_)) (list '= (list 'LINE-INT F 'mdp_ 'mdq_ 'mds_ 'mdt_) 0)))))))))
(define (c4a-dec fn e)
  (list 'FORSOME 'mqr_ (list 'AND '(IN mqr_ RR) (list 'AND '(< 0 mqr_)
    (list 'FORSOME 'mqd_ (list 'AND '(IN mqd_ CC)
      (list 'FORSOME 'mqh_ (list 'AND (list 'HOLOMORPHIC-ON (c4a-B e 'mqr_) 'mqh_)
        (list 'FORSOME 'mqf_ (list 'AND (list 'AND (list 'HOLOMORPHIC-ON (c4-pz e) 'mqf_) (c4a-road-zero e 'mqf_))
                                        (c4a-law fn e 'mqd_ 'mqh_ 'mqf_ 'mqr_)))))))))))
(define (c4a-iffs z)                   ; the membership IFFs at z
  (list (dk-cite! 'difference-membership 'u c4a-E z)
        (dk-cite! 'union-membership 'mzs_ 'mps_ z)
        (dk-cite! 'difference-membership 'u 'mps_ z)))
(define (c4a-from-D! z)                ; z in D: z in U', z in u, z not in Z, P; f z typed and /= 0
  (let ((is (c4a-iffs z)))
    (if (not (dk-asm? (list 'IN z c4a-U))) (dk-have! (list 'IN z c4a-U) (lambda () (apply c4-only-prop! (append is (list (list 'IN z c4a-D)))))))
    (if (not (dk-asm? (list 'NOT (list 'IN z 'mzs_)))) (dk-have! (list 'NOT (list 'IN z 'mzs_)) (lambda () (apply c4-only-prop! (append is (list (list 'IN z c4a-D)))))))
    (fact 'subset-mem-fwd c4a-U 'u z)
    (fact 'subset-mem-fwd 'u 'CC z)
    (fact 'fun-apply-type-c 'f c4a-U 'CC z)
    (if (not (dk-asm? (list 'NOT (list '= (list 'f z) 0))))
        (dk-have! (list 'NOT (list '= (list 'f z) 0))
          (lambda () (di) (c4-inst! (dk-ctx-form c4a-H4) z) (ai (list 'NOT (list 'IN z 'mzs_))))))))
(define (c4a-to-D! z)                  ; z in U', f z /= 0: z in D
  (let ((is (c4a-iffs z)))
    (if (not (dk-asm? (list 'NOT (list 'IN z 'mzs_))))
        (dk-have! (list 'NOT (list 'IN z 'mzs_))
          (lambda () (di) (c4-inst! (dk-ctx-form c4a-H4b) z) (ai (list 'NOT (list '= (list 'f z) 0))))))
    (if (not (dk-asm? (list 'IN z c4a-D)))
        (dk-have! (list 'IN z c4a-D) (lambda () (apply c4-only-prop! (append is (list (list 'IN z c4a-U) (list 'NOT (list 'IN z 'mzs_))))))))))
(define (c4a-law! e r d h Z0 C W)      ; C: forall z in W. (AND f z /= 0  f'/f = h z + d/(z - e)), W inside U': the law of LD at e
  (dk-have! (c4a-law c4a-LD e d h Z0 r)
    (lambda ()
      (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*)) (B (c4a-B e r)) (Rr (list 'recip (list '- z e))) (hz (list h z)))
        (c4-pb-open! e r z)
        (if (not (dk-asm? (list 'IN z c4a-U))) (fact 'subset-mem-fwd W c4a-U z))
        (dk-split! (c4-inst! C z))
        (c4a-to-D! z)
        (c4a-from-D! z)
        (fact 'fun-apply-type-c h B 'CC z)
        (c4-cc! Rr)
        (c4-lam-b!)
        (subst (list '= (list '* (list 'DERIV-ON 'CC-NORMED-FIELD c4a-U 'f z) (list 'recip (list 'f z))) (list '+ hz (list '* d Rr))))
        (let* ((Rv (c4-cc-name! Rr)) (hv (c4-cc-name! hz)) (dv (c4-cc-name! d)))
          (subst (list '= Rr Rv)) (subst (list '= hz hv)) (subst (list '= d dv))
          (crs))))))
(define (c4a-zexact! e)                ; the zero exact part at e
  (let* ((Z0 (list 'VNB-LAMBDA 'mdv_ (c4-pz e) 0))
         (ze (dk-cite! 'md-zero-exact e)))
    (dk-split-all! (list ze))
    (c4-and! (list 'HOLOMORPHIC-ON (c4-pz e) Z0) (c4a-road-zero e Z0))
    Z0))
(define (c4a-dec-zero! e)              ; e in Z: (r m h Z0), the law of LD at e landed
  (let* ((m (dk-skolem! (c4-inst! (dk-ctx-form c4a-H5) e)))
         (hzo (list 'HAS-ZERO-OF-ORDER c4a-U 'f e m)))
    (dk-project! (list 'IN m 'NN) 'has-zero-of-order hzo)
    (fact 'subset-mem-fwd 'mzs_ c4a-U e) (fact 'subset-mem-fwd c4a-U 'CC e)
    ;; W1K: log-derivative-at-zero wants (IN f (FUN c4a-U CC)): from the zero's HOLOMORPHIC-ON conjunct.
    (if (not (dk-asm? (list 'HOLOMORPHIC-ON c4a-U 'f)))
        (dk-project! (list 'HOLOMORPHIC-ON c4a-U 'f) 'has-zero-of-order hzo))
    (dk-cite! 'holomorphic-on-in-fun c4a-U 'f)
    (let* ((r (dk-skolem! (c4-inst! (dk-cite! 'log-derivative-at-zero m) c4a-U e 'f)))
           (_ (dk-split-all!))
           (h (c4-sk! 'ivh15 r))
           (_ (dk-split-all!))
           (B (c4a-B e r))
           (C (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm h) (dk-contains? fm 'DERIV-ON))) "the log-derivative clause (zero)"))
           (Z0 (c4a-zexact! e)))
      (fact 'nn-in-rr m) (c4-cc! m)
      (dk-cite! 'holomorphic-on-in-fun B h)
      (c4a-law! e r m h Z0 C B)
      (list r m h Z0))))
(define (c4a-dec-pole! e)              ; e in P: (r (- N) h Z0 N), the law of LD at e landed
  (let* ((N (dk-skolem! (c4-inst! (dk-ctx-form c4a-HP) e))))
    (c4-unfold! 'is-pole (list 'f e N) (list 'IS-POLE 'f e N))
    (let* ((r (dk-skolem! (c4-inst! (dk-cite! 'log-derivative-at-pole c4a-U) 'f e N)))
           (_ (dk-split-all!))
           (h (c4-sk! 'c4ph r))
           (_ (dk-split-all!))
           (B (c4a-B e r))
           (W (list 'DIFFERENCE B (list 'SINGLETON e)))
           (C (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm h) (dk-contains? fm 'DERIV-ON))) "the log-derivative clause (pole)"))
           (Z0 (c4a-zexact! e))
           (d (list '- N)))
      (c4-cc! d)
      (dk-cite! 'holomorphic-on-in-fun B h)
      (c4a-law! e r d h Z0 C W)
      (list r d h Z0 N))))
