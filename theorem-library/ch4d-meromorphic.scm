(define c4n-Pf (list 'VNB-LAMBDA 'c4ct_ (list 'CCINT 0 c4n-tp) (list 'f (list c4n-C 'c4ct_))))
(define c4n-Qf (list 'VNB-LAMBDA 'c4ct_ (list 'CCINT 0 c4n-tp) (list '* (list 'DERIV-ON 'CC-NORMED-FIELD 'u 'f (list c4n-C 'c4ct_)) (list c4n-Cd 'c4ct_))))
(define c4n-Hc '(FORALL c4ny_ (IMPLIES (IN c4ny_ CC) (IMPLIES (= (magnitude (- c4ny_ c)) r) (NOT (= (f c4ny_) c4nw_))))))
(define c4n-Ht (list 'FORALL 'c4ny_ (list 'IMPLIES (list 'IN 'c4ny_ c4n-TR) '(NOT (= (f c4ny_) c4nw_)))))
(define c4n-G '(VNB-LAMBDA mqx_ CC (ZERO-ORDER u (VNB-LAMBDA c4nx_ u (- (f c4nx_) c4nw_)) mqx_)))
(sp (make-wff (list 'FORALL 'u (c4-imps (list (list 'IS-OPEN c4g-nfm 'u) '(IS-CONNECTED CC-MS u))
  (list 'FORALL 'f (list 'IMPLIES '(HOLOMORPHIC-ON u f)
    (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'r (list 'IMPLIES '(IN r RR) (list 'IMPLIES '(< 0 r)
      (list 'FORALL 'c4nq_ (c4-imps (list '(IN c4nq_ RR) '(< r c4nq_) (list 'SUBSET c4n-BigB 'u))
        (list 'FORALL 'c4nw_ (c4-imps (list '(IN c4nw_ CC) c4n-Ht)
          (list 'AND (list 'IN c4n-Zw 'SET) (list 'AND (list 'IN (list 'CARD c4n-Zw) 'NN)
            (list '= (list 'FINSUM c4n-ag c4n-G c4n-Zw) (list 'WINDING c4n-Pf c4n-Qf 0 c4n-tp 'c4nw_)))))))))))))))))))
(dk-peel!)
(c4g-cc-setup!)
(c4-circle-basics!)
(dk-have! c4n-Hc
  (lambda () (let* ((y (dk-di-var!)))
               (di)
               (c4-inst! (dk-cite! 'circle-trace-of-magnitude 'c 'r) y)
               (c4-inst! (dk-ctx-form c4n-Ht) y)
               ((c4-close! ass)))))
(dk-cite! 'cc-open-subset-cc 'u)
(fact 'subclass-of-set-is-set 'u 'CC)
(dk-cite! 'holomorphic-on-in-fun 'u 'f)
(c4-rr! c4n-rho)
(dk-have! (list '< 'r c4n-rho) (lambda () (dk-ineq! '(< r c4nq_) (list 'IN c4n-rho 'RR) '(IN r RR) '(IN c4nq_ RR))))
(dk-have! (list '< c4n-rho 'c4nq_) (lambda () (dk-ineq! '(< r c4nq_) (list 'IN c4n-rho 'RR) '(IN r RR) '(IN c4nq_ RR))))
(dk-have! (list '< 0 c4n-rho) (lambda () (dk-ineq! '(< 0 r) (list '< 'r c4n-rho) (list 'IN c4n-rho 'RR) '(IN r RR))))
(dk-have! (list '<= c4n-rho 'c4nq_) (lambda () (dk-ineq! (list '< c4n-rho 'c4nq_) (list 'IN c4n-rho 'RR) '(IN c4nq_ RR))))
(dk-have! (list '<= 'r c4n-rho) (lambda () (dk-ineq! (list '< 'r c4n-rho) (list 'IN c4n-rho 'RR) '(IN r RR))))
(c4-ball-setup! 'c c4n-rho)
(c4-ball-setup! 'c 'r)
(dk-have! '(< 0 c4nq_) (lambda () (dk-ineq! '(< 0 r) '(< r c4nq_) '(IN r RR) '(IN c4nq_ RR))))
(c4-ball-setup! 'c 'c4nq_)
(dk-cite! 'cc-ms-ball-mono 'c c4n-rho 'c4nq_)
(dk-cite! 'cc-ms-ball-mono 'c 'r c4n-rho)
(fact 'subset-trans c4n-Bp c4n-BigB 'u)
(fact 'subset-trans c4n-Br c4n-Bp 'u)
;; the trace: on the circle, inside B(c, rho), f /= w there
(define (c4n-tr0! y)                   ; y on the trace: y in CC, |y - c| = r, |y - c| < rho
  (let ((m (list 'magnitude (list '- y 'c))))
    (fact 'subset-mem-fwd c4n-TR 'CC y)
