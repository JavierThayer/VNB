(define c4c-Hw '(FORALL c4cy_ (IMPLIES (IN c4cy_ c4cv_) (NOT (= (f c4cy_) c4cw_)))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(HOLOMORPHIC-ON u f)
  (list 'FORALL 'mdp_ (list 'FORALL 'mdq_ (list 'FORALL 'mds_ (list 'FORALL 'mdt_
    (c4-imps (list '(IS-ROAD mdp_ mdq_ mds_ mdt_) (list 'SUBSET c4c-TR 'u))
      (list 'FORALL 'c4cw_ (list 'IMPLIES '(IN c4cw_ CC)
        (list 'FORALL 'c4cv_ (c4-imps (list (list 'SUBSET c4c-TR 'c4cv_) '(SUBSET c4cv_ u) c4c-Hw)
