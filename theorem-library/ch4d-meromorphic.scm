(define c4r-APg (c4-inst! (dk-cite! 'argument-principle 'u) 'mpg_ 'g 'mzg_ 'mdp_ 'mdq_ 'mds_ 'mdt_))
;; points of V
(define (c4r-V! z)                     ; z in V: in Uf, Ug, not a zero; f z, g z typed and /= 0
  (let ((all (c4r-iffs z)))
    (fact 'subset-mem-fwd c4r-V c4r-Uf z)
    (fact 'subset-mem-fwd c4r-V c4r-Ug z)
    (for-each (lambda (cl idx) (if (not (dk-asm? cl)) (dk-have! cl (lambda () (apply c4-only-prop! (append (map (lambda (i) (list-ref all i)) idx) (list (list 'IN z c4r-V))))))))
              (list (list 'NOT (list 'IN z 'mzf_)) (list 'NOT (list 'IN z 'mzg_)) (list 'IN z 'u))
              (list '(4 2 5) '(4 6) '(4 2)))
    (fact 'subset-mem-fwd 'u 'CC z)
    (fact 'fun-apply-type-c 'f c4r-Uf 'CC z)
    (fact 'fun-apply-type-c 'g c4r-Ug 'CC z)
    (if (not (dk-asm? (list 'NOT (list '= (list 'f z) 0))))
        (dk-have! (list 'NOT (list '= (list 'f z) 0))
          (lambda () (di) (c4-inst! (dk-ctx-form (c4r-H4 'f 'mzf_ 'mpf_)) z) (ai (list 'NOT (list 'IN z 'mzf_))))))
    (if (not (dk-asm? (list 'NOT (list '= (list 'g z) 0))))
        (dk-have! (list 'NOT (list '= (list 'g z) 0))
          (lambda () (di) (c4-inst! (dk-ctx-form (c4r-H4 'g 'mzg_ 'mpg_)) z) (ai (list 'NOT (list 'IN z 'mzg_))))))
    (c4-cc! (list 'recip (list 'f z)))
    (c4-cc! (list 'recip (list 'g z)))))
;; f, g, f', g' restricted to V
(define c4r-gdf (list 'VNB-LAMBDA 'cifdw_ c4r-Uf (list 'DERIV-ON 'CC-NORMED-FIELD c4r-Uf 'f 'cifdw_)))
(define c4r-gdg (list 'VNB-LAMBDA 'cifdw_ c4r-Ug (list 'DERIV-ON 'CC-NORMED-FIELD c4r-Ug 'g 'cifdw_)))
(dk-cite! 'holomorphic-deriv-holomorphic c4r-Uf 'f)
(dk-cite! 'holomorphic-deriv-holomorphic c4r-Ug 'g)
(dk-cite! 'holomorphic-on-in-fun c4r-Uf c4r-gdf)
(dk-cite! 'holomorphic-on-in-fun c4r-Ug c4r-gdg)
(define (c4r-restrict! U fn)           ; HOLOMORPHIC-ON(U, fn), V inside U: a name for RESTRICT(fn, V), holomorphic on V
  (let* ((R (list 'RESTRICT fn c4r-V)))
    (dk-cite! 'holomorphic-on-restrict U fn c4r-V)
    (dk-cite! 'holomorphic-on-in-fun c4r-V R)
    (let ((n (dk-name! R (list 'FUN c4r-V 'CC))))
      (dk-rewrite-h! (list 'HOLOMORPHIC-ON c4r-V R) R n)
      n)))
(define c4r-fV (c4r-restrict! c4r-Uf 'f))
(define c4r-gV (c4r-restrict! c4r-Ug 'g))
(define c4r-dfV (c4r-restrict! c4r-Uf c4r-gdf))
(define c4r-dgV (c4r-restrict! c4r-Ug c4r-gdg))
(define (c4r-rval! n fn U z)           ; z in V: n z = fn z (n names RESTRICT(fn, V)); a lambda FN is reduced
  (let ((goal (list '= (list n z) (if (and (pair? fn) (eq? (car fn) 'VNB-LAMBDA)) (list 'DERIV-ON 'CC-NORMED-FIELD U (list-ref (cadddr fn) 3) z) (list fn z)))))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda () (let ((fin (c4-close! rfl)))
                       (subst (list '= n (list 'RESTRICT fn c4r-V)))
                       (fact 'restrict-apply fn c4r-V z)
                       (subst (list '== (list (list 'RESTRICT fn c4r-V) z) (list fn z)))
                       (c4-lam-b!)
                       (fin)))))
    goal))
(define (c4r-vals! z)                  ; z in V: everything about z
  (c4r-V! z)
  (c4-dz! c4r-Uf 'f z) (c4-dz! c4r-Ug 'g z)
  (fact 'fun-apply-type-c c4r-gdf c4r-Uf 'CC z) (fact 'fun-apply-type-c c4r-gdg c4r-Ug 'CC z)
  (c4r-rval! c4r-fV 'f c4r-Uf z) (c4r-rval! c4r-gV 'g c4r-Ug z)
  (c4r-rval! c4r-dfV c4r-gdf c4r-Uf z) (c4r-rval! c4r-dgV c4r-gdg c4r-Ug z))
(dk-have! (list 'FORALL 'c4ry_ (list 'IMPLIES (list 'IN 'c4ry_ c4r-V) (list 'NOT (list '= (list c4r-gV 'c4ry_) 0))))
  (lambda () (let* ((y (dk-di-var!)) (fin (c4-close! ass))) (c4r-vals! y) (subst (list '= (list c4r-gV y) (list 'g y))) (fin))))
(dk-have! (list 'FORALL 'c4ry_ (list 'IMPLIES (list 'IN 'c4ry_ c4r-V) (list 'NOT (list '= (list c4r-fV 'c4ry_) 0))))
  (lambda () (let* ((y (dk-di-var!)) (fin (c4-close! ass))) (c4r-vals! y) (subst (list '= (list c4r-fV y) (list 'f y))) (fin))))
;; h = f / g on V
(define c4r-h (list 'VNB-LAMBDA 'c4rhw_ c4r-V (list '* (list c4r-fV 'c4rhw_) (list 'recip (list c4r-gV 'c4rhw_)))))
(dk-have! (list 'HOLOMORPHIC-ON c4r-V c4r-h) (lambda () (dk-holomorphic! c4r-V c4r-h)))
(dk-cite! 'holomorphic-on-in-fun c4r-V c4r-h)
(define c4r-hn (dk-name! c4r-h (list 'FUN c4r-V 'CC)))
(dk-rewrite-h! (list 'HOLOMORPHIC-ON c4r-V c4r-h) c4r-h c4r-hn)
(define (c4r-hval! z)                  ; z in V: hn z = f z * recip(g z), /= 0, typed
  (c4r-vals! z)
  (let ((goal (list '= (list c4r-hn z) (list '* (list 'f z) (list 'recip (list 'g z))))))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda () (let ((fin (c4-close! rfl)))
                       (subst (list '= c4r-hn c4r-h)) (c4-lam-b!)
                       (subst (list '= (list c4r-fV z) (list 'f z))) (subst (list '= (list c4r-gV z) (list 'g z)))
                       (fin)))))
    (fact 'fun-apply-type-c c4r-hn c4r-V 'CC z)
    (c4-recip-nz! (list 'g z))
    (dk-cite! 'cc-mul-nonzero (list 'f z) (list 'recip (list 'g z)))
    (if (not (dk-asm? (list 'NOT (list '= (list c4r-hn z) 0))))
        (dk-rewrite-h! (list 'NOT (list '= (list '* (list 'f z) (list 'recip (list 'g z))) 0)) (list '* (list 'f z) (list 'recip (list 'g z))) (list c4r-hn z)))
    goal))
(dk-have! (list 'FORALL 'c4cy_ (list 'IMPLIES (list 'IN 'c4cy_ c4r-V) (list 'NOT (list '= (list c4r-hn 'c4cy_) 0))))
  (lambda () (let* ((y (dk-di-var!)) (fin (c4-close! ass))) (c4r-hval! y) (fin))))
