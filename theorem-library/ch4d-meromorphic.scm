                    (dk-split-all! (list (c4-inst! loc b)))
                    (c4-dz! 'u 'f b)
                    (fact 'fun-apply-type-c gy 'u 'CC b)
                    (dk-have! (list '= (list gy b) 0)
                      (lambda () (let ((fin2 (c4-close! rfl))) (c4-lam-b!) (subst (list '= (list 'f b) y)) (let ((v (c4-cc-name! y))) (subst (list '= y v)) (crs)) (fin2))))
                    (dk-diff! 'u gy b Df)
                    (dk-cite! 'cc-deriv-on-of-is-diff-on 'u gy b Df)
                    (dk-rewrite-h! (list 'NOT (list '= Df 0)) Df (list 'DERIV-ON 'CC-NORMED-FIELD 'u gy b))
                    (c4-inst! (dk-cite! 'simple-zero-order-one 'u) gy b)
                    (dk-cite! 'zero-order-value 'u gy b 1)
                    (c4-lam-b!)
                    (subst (list '= (list 'ZERO-ORDER 'u gy b) 1))
                    (fin))))
              (dk-have! (list 'FORALL 'c4ay_ (list 'IMPLIES (list 'IN 'c4ay_ Zy) (list 'IN (list Gord 'c4ay_) (list 'CARR ag))))
                (lambda () (let* ((b (dk-di-var!)) (fin (c4-close! ass)))
                             (c4-inst! (dk-ctx-form (list 'FORALL 'c4ay_ (list 'IMPLIES (list 'IN 'c4ay_ Zy) (list '= (list Gord 'c4ay_) (list one 'c4ay_))))) b)
                             (dk-sep-parts! (list 'IN b Zy)) (c4-ball-pt! 'a r b)
                             (subst (list '== (list 'CARR ag) 'CC))
                             (subst (list '= (list Gord b) (list one b)))
                             (c4-lam-b!)
                             (fin))))
              (dk-cite! 'finsum-congruence ag Zy Gord one)
              (dk-have! (list 'SUBSET Zy 'CC) (lambda () (let* ((b (subset-by-element!)) (fin (c4-close! ass))) (dk-sep-parts! (list 'IN b Zy)) (c4-ball-pt! 'a r b) (fin))))
              (dk-have! (list '= (list 'CARD Zy) (list 'CARD Zy)) (lambda () (rfl)))
              (c4-inst! (dk-cite! 'finsum-one-card-induction (list 'CARD Zy)) Zy)
              (dk-have! (list '= (list 'CARD Zy) 'c4tn_)
                (lambda () (let ((fin (c4-close! rfl)))
                             (subst (list '= (list 'CARD Zy) (list 'FINSUM ag one Zy)))
                             (subst (list '= (list 'FINSUM ag one Zy) (list 'FINSUM ag Gord Zy)))
                             (subst (list '= (list 'FINSUM ag Gord Zy) (Wt y)))
                             (subst (list '= (Wt y) (Wt w0)))
                             (subst (list '= (Wt w0) 'c4tn_))
                             (fin))))
              Zy))
          ;; V = the points of B(a, r) sent into W
          (let* ((Vset (list 'SEP 'iv5z_ Br (list 'IN '(f iv5z_) WW))))
            (dk-cite! 'cc-open-preimage-in-open 'u 'f Br WW)
            (let ((iff (dk-cite! 'cc-ms-open-iff Vset))) (dk-have! (list 'IS-OPEN c4g-nfm Vset) (lambda () (c4-only-prop! iff (list 'IS-OPEN 'CC-MS Vset)))))
            (dk-have! (list 'SUBSET Vset 'u) (lambda () (let* ((z (subset-by-element!)) (fin (c4-close! ass))) (dk-sep-parts! (list 'IN z Vset)) (fact 'subset-mem-fwd Br 'u z) (fin))))
            (dk-have! (list 'IN 'a Vset) (lambda () (in-sep! (lambda () ((c4-close! ass))))))
            (ew Vset)
            (ew WW)
            (dk-conj-close!
              (lambda ()
                (let ((g (dk-goal)))
                  (cond ((dk-asm? g) (ass))
                        ((and (dk-head-is? g 'FORALL) (dk-contains? g 'CARD))
                         (let* ((y (dk-di-var!)) (fin (c4-close! ass)))
                           (di)
                           (let* ((Zy (card! y)) (Sy (list 'SEP 'c4ub_ Vset (list '= '(f c4ub_) y))))
                             (dk-have! (list '= Sy Zy)
                               (lambda ()
                                 (let ((ce (dk-cite! 'class-extensionality Sy Zy)))
                                   (dk-have! (cadr ce)
                                     (lambda ()
                                       (let* ((z (begin (di) (cadr (cadr (dk-goal))))))
                                         (dk-iff! (lambda (g) (and (dk-head-is? g 'IN) (equal? (caddr g) Zy)))
                                                  (lambda () (dk-sep-parts! (list 'IN z Sy)) (dk-sep-parts! (list 'IN z Vset))
                                                            (in-sep! (lambda () ((c4-close! ass)))))
                                                  (lambda () (dk-sep-parts! (list 'IN z Zy))
                                                            (dk-have! (list 'IN z Vset) (lambda () (in-sep! (lambda () (let ((fin2 (c4-close! ass))) (subst (list '= (list 'f z) y)) (fin2))))))
                                                            (in-sep! (lambda () ((c4-close! ass)))))))))
                                   (let ((fin2 (c4-close! ass))) (dk-landed-1 (lambda () (detach! ce))) (fin2)))))
                             (subst (list '= Sy Zy))
                             (fin))))
                        ((and (dk-head-is? g 'FORALL) (not (dk-contains? g 'FORSOME)))
                         (let* ((z (dk-di-var!)) (fin (c4-close! ass))) (dk-sep-parts! (list 'IN z Vset)) (fin)))
                        ((dk-head-is? g 'FORALL)
                         (let* ((y (dk-di-var!)) (fin (c4-close! ass)))
                           (use-em (list '= y w0)
                             (lambda () (ew 'a) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (let ((fin2 (c4-close! rfl))) (subst (list '= y w0)) (fin2))))))
                             (lambda ()
                               (let* ((Zy (card! y)))
                                 ;; Z_y is not empty (CARD = n >= 1): one of its points is in V
                                 (dk-have! (list 'FORSOME 'c4ub_ (list 'IN 'c4ub_ Zy))
                                   (lambda ()
                                     (use-em (list 'FORSOME 'c4ub_ (list 'IN 'c4ub_ Zy))
                                       (lambda () (ass))
                                       (lambda ()
                                         (let ((ce (dk-cite! 'class-extensionality Zy 'EMPTY-SET)))
                                           (dk-have! (cadr ce) (lambda () (let ((z (begin (di) (cadr (cadr (dk-goal))))))
                                                                            (fact 'empty-set-has-no-members z)
                                                                            (dk-have! (list 'NOT (list 'IN z Zy)) (lambda () (di) (dk-have! (list 'FORSOME 'c4ub_ (list 'IN 'c4ub_ Zy)) (lambda () (ew z) (ass))) (ai (list 'NOT (list 'FORSOME 'c4ub_ (list 'IN 'c4ub_ Zy))))))
                                                                            (prop))))
                                           (dk-landed-1 (lambda () (detach! ce)))
                                           (fact 'card-empty)
                                           (dk-have! (list '= 'c4tn_ 0) (lambda () (let ((fin2 (c4-close! ass))) (subst (list '= 'c4tn_ (list 'CARD Zy))) (subst (list '= Zy 'EMPTY-SET)) (fin2))))
                                           (dk-absurd! (list '= 'c4tn_ 0) '(<= 1 c4tn_) '(IN c4tn_ RR)))))))
                                 (let* ((b (dk-skolem! (dk-ctx-form (list 'FORSOME 'c4ub_ (list 'IN 'c4ub_ Zy))))))
                                   (dk-sep-parts! (list 'IN b Zy))
                                   (dk-have! (list 'IN b Vset) (lambda () (in-sep! (lambda () (let ((fin2 (c4-close! ass))) (subst (list '= (list 'f b) y)) (fin2))))))
                                   (ew b)
                                   (dk-conj-close! (lambda () (ass)))))))
                           (fin)))
                        (#t (error "c4u: open conjunct" g))))))))))))
