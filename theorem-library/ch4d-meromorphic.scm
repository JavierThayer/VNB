;; the exceptional sets, the open sets Df, V; the trace inside Df, Dg, V
(dk-split-all! (list (c4-inst! (dk-cite! 'zeros-poles-finite 'u) 'mpf_ 'f 'mzf_)))
(dk-split-all! (list (c4-inst! (dk-cite! 'zeros-poles-finite 'u) 'mpg_ 'g 'mzg_)))
(fact 'subset-trans c4r-Ef 'u 'CC)
(fact 'subset-trans c4r-Eg 'u 'CC)
(c4-inst! (dk-cite! 'cc-open-minus-finite 'u) c4r-Ef)
(c4-inst! (dk-cite! 'cc-open-minus-finite c4r-Df) c4r-Eg)
(define (c4r-iffs z)
  (list (dk-cite! 'difference-membership 'u (list 'UNION c4r-Ef c4r-Eg) z)
        (dk-cite! 'union-membership c4r-Ef c4r-Eg z)
        (dk-cite! 'difference-membership 'u c4r-Ef z)
        (dk-cite! 'difference-membership 'u c4r-Eg z)
        (dk-cite! 'difference-membership c4r-Df c4r-Eg z)
        (dk-cite! 'union-membership 'mzf_ 'mpf_ z)
        (dk-cite! 'union-membership 'mzg_ 'mpg_ z)
        (dk-cite! 'difference-membership 'u 'mpf_ z)
        (dk-cite! 'difference-membership 'u 'mpg_ z)))
(define (c4r-sub! A B idx . extra)     ; A subset B by membership chase over the IFFs numbered IDX (prop's atom cap), EXTRA formulas for prop
  (dk-have! (list 'SUBSET A B)
    (lambda () (let* ((x (subset-by-element!)) (all (c4r-iffs x)) (is (map (lambda (i) (list-ref all i)) idx))
                      (tr (if (equal? A c4r-TR)
                              (let ((m (list 'IN x (list 'DIFFERENCE 'u (list 'UNION c4r-Ef c4r-Eg)))))
                                (fact 'subset-mem-fwd c4r-TR (list 'DIFFERENCE 'u (list 'UNION c4r-Ef c4r-Eg)) x)
                                (if (not (dk-asm? m))
                                    (error "c4r-sub!: the trace membership did not land; hypothesis present?"
                                           (dk-asm? (list 'SUBSET c4r-TR (list 'DIFFERENCE 'u (list 'UNION c4r-Ef c4r-Eg)))) (dk-asm? (list 'IN x c4r-TR))))
                                (list m))
                              '())))
                 (apply c4-only-prop! (append is extra tr (list (list 'IN x A))))))))
(c4r-sub! c4r-TR c4r-V '(0 1 2 4))
