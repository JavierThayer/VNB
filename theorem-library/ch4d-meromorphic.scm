(define (c4a-vals! y)                  ; y in D: fD y = f y, dD y = f'(y), both typed, f y /= 0
  (c4a-from-D! y)
  (let ((Dy (list 'DERIV-ON 'CC-NORMED-FIELD c4a-U 'f y)))
    (c4-dz! c4a-U 'f y)
    (fact 'fun-apply-type-c c4a-gd c4a-U 'CC y)
    (if (not (dk-asm? (list 'IN Dy 'CC))) (dk-lam-b-h! (list 'IN (list c4a-gd y) 'CC)))
    (if (not (dk-asm? (list '= (list c4a-fD y) (list 'f y))))
        (dk-have! (list '= (list c4a-fD y) (list 'f y))
          (lambda () (let ((fin (c4-close! rfl)))
                       (subst (list '= c4a-fD c4a-rstf)) (fact 'restrict-apply 'f c4a-D y) (subst (list '== (list c4a-rstf y) (list 'f y))) (fin)))))
    (if (not (dk-asm? (list '= (list c4a-dD y) Dy)))
        (dk-have! (list '= (list c4a-dD y) Dy)
          (lambda () (let ((fin (c4-close! rfl)))
                       (subst (list '= c4a-dD c4a-rstg)) (fact 'restrict-apply c4a-gd c4a-D y) (subst (list '== (list c4a-rstg y) (list c4a-gd y)))
                       (c4-lam-b!) (fin)))))
    (c4-cc! (list 'recip (list 'f y)))))
