(define (c4c-road-setup!)              ; the road (mdp_ mdq_ mds_ mdt_) in context: its typings and its ends
  (c4g-cc-setup!)
  (fact 'rr-is-set) (fact 'ccint-subset-rr 'mds_ 'mdt_) (fact 'subclass-of-set-is-set c4c-I 'RR)
  (fact 'is-road-is-path 'mdp_ 'mdq_ 'mds_ 'mdt_) (fact 'is-path-in-fun 'mdp_ 'mds_ 'mdt_)
  (dk-project! (list 'IN 'mdq_ (list 'FUN c4c-I 'CC)) 'is-road '(IS-ROAD mdp_ mdq_ mds_ mdt_))
  (for-each (lambda (cl) (if (not (dk-asm? cl)) (dk-project! cl 'is-path '(IS-PATH mdp_ mds_ mdt_))))
            (list '(IN mds_ RR) '(IN mdt_ RR) '(< mds_ mdt_)))
  (dk-cite! 'trace-subset-cc 'mdp_ 'mds_ 'mdt_))
