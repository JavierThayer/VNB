(define c4r-Qh (list-ref c4r-hroad 2))
(define (c4r-near! z)                  ; z on the trace: |h z - 1| < 1
  (let* ((goal (list '< (list 'magnitude (list '- (list c4r-hn z) 1)) 1)))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (fact 'subset-mem-fwd c4r-TR c4r-V z)
            (c4r-hval! z)
            (let* ((A (list 'f z)) (B (list 'g z)) (RB (list 'recip B)) (AB (list '- A B))
                   (M (list 'magnitude AB)) (K (list 'magnitude B)) (J (list 'magnitude RB)))
              (c4-inst! (dk-ctx-form c4r-Hr) z)
              (c4-cc! AB) (c4-mag! AB) (c4-mag! B) (c4-mag! RB)
              (dk-have! (list '= (list '- (list '* A RB) 1) (list '* AB RB)) (lambda () (dk-field-eq! 'CC)))
              (c4-and! (list 'IN AB 'CC) (list 'IN RB 'CC))
              (fact 'cc-magnitude-mul AB RB)
              (c4-and! (list 'IN B 'CC) (list 'IN RB 'CC))
              (fact 'cc-magnitude-mul B RB)
              (c4-and! (list 'IN B 'CC) (list 'NOT (list '= B 0)))
              (fact 'cc-recip-inverse B)
              (fact 'cc-magnitude-one)
              (dk-have! (list '= (list '* K J) 1)
                (lambda () (let ((fin (c4-close! ass)))
                             (subst (list '= (list '* K J) (list 'magnitude (list '* B RB))))
                             (subst (list '= (list '* B RB) 1))
                             (fin))))
              (c4-mag-pos! RB)
              (c4-and! (list '< 0 J) (list '< M K))
              (dk-cite! 'rr-lt-scale-pos J M K)
              (subst (list '= (list c4r-hn z) (list '* A RB)))
              (subst (list '= (list '- (list '* A RB) 1) (list '* AB RB)))
              (subst (list '= (list 'magnitude (list '* AB RB)) (list '* M J)))
              (let* ((Mv (dk-name! M 'RR)) (Jv (dk-name! J 'RR)) (Kv (dk-name! K 'RR)))
                (subst (list '= M Mv)) (subst (list '= J Jv))
                (let* ((h1 (dk-rewrite-h! (list '< (list '* J M) (list '* J K)) M Mv))
                       (h2 (dk-rewrite-h! h1 J Jv))
                       (h3 (dk-rewrite-h! h2 K Kv))
                       (k1 (dk-rewrite-h! (list '= (list '* K J) 1) K Kv))
                       (k2 (dk-rewrite-h! k1 J Jv)))
                  (dk-have! (list '= (list '* Mv Jv) (list '* Jv Mv)) (lambda () (crs)))
                  (subst (list '= (list '* Mv Jv) (list '* Jv Mv)))
                  (dk-have! (list '= (list '* Jv Kv) (list '* Kv Jv)) (lambda () (crs)))
                  (dk-have! (list '= 1 (list '* Jv Kv))
                    (lambda () (let ((fin (c4-close! rfl))) (subst (list '= (list '* Jv Kv) (list '* Kv Jv))) (subst (list '= (list '* Kv Jv) 1)) (fin))))
                  (subst (list '= 1 (list '* Jv Kv)))
                  ((c4-close! ass))))))))
    goal))
