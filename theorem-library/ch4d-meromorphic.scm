;;; ===============================================================================================================
;;; (18) THE CIRCLE IS THE TRACE OF ITS PATH: |y - c| = r > 0 puts y on TRACE(CIRCLE-PATH(c, r), 0, 2 pi).
;;;      u = (y - c)/r has |u| = 1, u = cos t + i sin t (cc-circle-arg) with t in [-pi, pi); shift t by 2 pi if
;;;      negative (cc-exp-two-pi-i).
;;; ===============================================================================================================
(sp (make-wff '(FORALL c (IMPLIES (IN c CC) (FORALL r (IMPLIES (IN r RR) (IMPLIES (< 0 r)
  (FORALL c4oy_ (IMPLIES (IN c4oy_ CC) (IMPLIES (= (magnitude (- c4oy_ c)) r)
    (IN c4oy_ (TRACE (CIRCLE-PATH c r) 0 (* 2 PI)))))))))))))
(dk-peel!)
(c4g-cc-setup!)
(c4-circle-basics!)
(let* ((y 'c4oy_) (Ay (list '- y 'c)) (ri (list 'recip 'r)) (U (list '* Ay ri))
       (ra (list 'real-part U)) (ib (list 'imag-part U)))
  (c4-rr! 'r)
  (fact 'rr-pos-ne-zero 'r)
  (c4-rr! ri) (c4-cc! ri) (c4-cc! Ay) (c4-cc! U)
  (c4-mag! Ay) (c4-mag! U)
  (c4-rr! ra) (c4-rr! ib)
  ;; |U| = 1
  (c4-and! (list 'IN Ay 'CC) (list 'IN ri 'CC))
  (fact 'cc-magnitude-mul Ay ri)
  (dk-have! (list '<= 0 'r) (lambda () (dk-ineq! '(< 0 r))))
  (dk-cite! 'rr-recip-pos 'r)
  (dk-cite! 'rr-magnitude-is-abs ri)
  (dk-have! (list '<= 0 ri) (lambda () (dk-ineq! (list '< 0 ri) (list 'IN ri 'RR))))
  (dk-cite! 'rr-abs-of-nonneg ri)
  (c4-and! (list 'IN 'r 'RR) (list 'NOT (list '= 'r 0)))
  (fact 'rr-recip-inverse 'r)
  (dk-have! (list '= (list 'magnitude U) 1)
    (lambda () (let ((fin (c4-close! ass)))
                 (subst (list '= (list 'magnitude U) (list '* (list 'magnitude Ay) (list 'magnitude ri))))
                 (subst (list '= (list 'magnitude Ay) 'r))
                 (subst (list '= (list 'magnitude ri) (list 'abs ri)))
                 (subst (list '= (list 'abs ri) ri))
                 (fin))))
  ;; a^2 + b^2 = 1
  (dk-cite! 'cc-magnitude-sq U)
  (dk-have! (list '= (list '+ (list 'power ra 2) (list 'power ib 2)) 1)
    (lambda () (let ((fin (c4-close! rfl)))
                 (dk-have! (list '= (list '+ (list 'power ra 2) (list 'power ib 2)) (list '* (list 'magnitude U) (list 'magnitude U)))
                   (lambda () (let ((fin2 (c4-close! rfl)))
                                (subst (list '= (list '* (list 'magnitude U) (list 'magnitude U)) (list '+ (list '* ra ra) (list '* ib ib))))
                                (let* ((av (dk-name! ra 'RR)) (bv (dk-name! ib 'RR))) (subst (list '= ra av)) (subst (list '= ib bv)) (crs))
                                (fin2))))
                 (subst (list '= (list '+ (list 'power ra 2) (list 'power ib 2)) (list '* (list 'magnitude U) (list 'magnitude U))))
                 (subst (list '= (list 'magnitude U) 1))
                 (crs)
                 (fin))))
  (let* ((th (dk-skolem! (c4-inst! (dk-cite! 'cc-circle-arg ra ib)))) (_ (dk-split-all!))
         (E (list 'CC-EXP (list '* +i th))))
    (c4-cc! th)
    (dk-cite! 'cc-exp-i th)
    (dk-cite! 'cc-re-im-decompose U)
    (dk-have! (list '= E U)
      (lambda () (let ((fin (c4-close! rfl)))
                   (subst (list '= E (list '+ (list 'CC-COS th) (list '* +i (list 'CC-SIN th)))))
                   (subst (list '= (list 'CC-COS th) ra)) (subst (list '= (list 'CC-SIN th) ib))
                   (subst (list '= (list '+ ra (list '* +i ib)) U))
                   (fin))))
    (define (close-at! t)              ; t in [0, 2 pi] with exp(i t) = U: y = C(t) on the trace
      (let* ((I (list 'CCINT 0 c4-tp)) (C c4-C))
        (dk-have! (list 'IN t I)
          (lambda () (mac 'ccint-membership)
                     (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                    (apply dk-ineq! (filter dk-asm? (list '(< 0 PI) '(IN PI RR) (list '<= (list '- 'PI) th) (list '< th 'PI) (list 'IN th 'RR)
                                                                                          (list '<= 0 th) (list '< th 0) (list 'IN t 'RR)))))))))
        (dk-have! (list '= (list C t) y)
          (lambda () (let ((fin (c4-close! rfl)))
                       (mac 'CIRCLE-PATH)
                       (c4-lam-b!)
                       (subst (list '= (list 'CC-EXP (list '* +i t)) U))
                       (let* ((Ayv (c4-cc-name! Ay)) (riv (c4-cc-name! ri)))
                         (subst (list '= Ay Ayv))
                         (subst (list '= ri riv))
                         (let ((k (dk-rewrite-h! (list '= (list '* 'r ri) 1) ri riv)))
                           (dk-have! (list '= Ayv (list '- y 'c)) (lambda () ((c4-close! ass))))
                           (dk-have! (list '= (list '+ 'c (list '* 'r (list '* Ayv riv))) (list '+ 'c (list '* Ayv (list '* 'r riv)))) (lambda () (crs)))
                           (subst (list '= (list '+ 'c (list '* 'r (list '* Ayv riv))) (list '+ 'c (list '* Ayv (list '* 'r riv)))))
                           (subst (list '= (list '* 'r riv) 1))
                           (subst (list '= Ayv (list '- y 'c)))
                           (crs)))
                       (fin))))
        (c4c-tr-pt! C 0 c4-tp t)
        (let ((fin (c4-close! ass))) (subst (list '= y (list C t))) (fin))))
    (use-em (list '<= 0 th)
      (lambda () (close-at! th))
      (lambda ()
        (let* ((t (list '+ th c4-tp)))
          (fact 'rr-not-le-lt 0 th)
          (c4-rr! t) (c4-cc! t)
          (c4-cc! (list '* +i th)) (c4-cc! (list '* c4-tp +i))
          (c4-and! (list 'IN (list '* +i th) 'CC) (list 'IN (list '* c4-tp +i) 'CC))
          (dk-cite! 'cc-exp-add (list '* +i th) (list '* c4-tp +i))
          (fact 'cc-exp-two-pi-i)
          (dk-have! (list '= (list 'CC-EXP (list '* +i t)) U)
            (lambda () (let ((fin (c4-close! rfl)))
                         (dk-have! (list '= (list '* +i t) (list '+ (list '* +i th) (list '* c4-tp +i))) (lambda () (crs)))
                         (subst (list '= (list '* +i t) (list '+ (list '* +i th) (list '* c4-tp +i))))
                         (subst (list '= (list 'CC-EXP (list '+ (list '* +i th) (list '* c4-tp +i))) (list '* E (list 'CC-EXP (list '* c4-tp +i)))))
                         (subst (list '= (list 'CC-EXP (list '* c4-tp +i)) 1))
                         (subst (list '= E U))
                         (let ((uv (c4-cc-name! U))) (subst (list '= U uv)) (crs))
                         (fin))))
          (close-at! t))))))
(c4-dump-open!)
(qed 'circle-trace-of-magnitude)

;;; ===============================================================================================================
;;; (12) A CLOSED PATH IN A CONVEX OPEN SET IS NULL-HOMOTOPIC there: the constant path at its start is a good
;;;      approximation to it with one convex piece (the set itself), so good-approx-homotopic applies.
;;; ===============================================================================================================
(define c4h-I '(CCINT c4ha_ c4hb_))
(define c4h-K '(VNB-LAMBDA hmx_ (CCINT c4ha_ c4hb_) (c4hp_ c4ha_)))
(define c4h-T '(VNB-LAMBDA c4hk_ NN (+ c4ha_ (* c4hk_ (- c4hb_ c4ha_)))))
(define c4h-D '(VNB-LAMBDA c4hj_ NN u))
(sp (make-wff (list 'FORALL 'u (c4-imps (list (list 'IS-OPEN c4g-nfm 'u) '(IS-CONVEX-CC u))
  (list 'FORALL 'c4hp_ (list 'FORALL 'c4ha_ (list 'FORALL 'c4hb_
    (c4-imps (list '(IS-PATH c4hp_ c4ha_ c4hb_) '(SUBSET (TRACE c4hp_ c4ha_ c4hb_) u) '(= (c4hp_ c4hb_) (c4hp_ c4ha_)))
      '(NULL-HOMOTOPIC u c4hp_ c4ha_ c4hb_)))))))))
(dk-peel!)
