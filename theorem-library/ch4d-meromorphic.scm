;;; ===============================================================================================================
;;; (14) PROPOSITION 4.24: the solutions of f(z) = w in a disc, counted with multiplicity, number the winding
;;;      number of f o gamma about w, gamma the circle bounding the disc.  u open and connected, f holomorphic on u,
;;;      the disc B(c, R) inside u, 0 < r < R, f /= w on the circle |z - c| = r.  Then the solutions in B(c, r) form
;;;      a finite set Z and  sum_{z in Z} ZERO-ORDER(u, f - w, z) = ind(f o gamma, w).
;;;      The argument principle (argument-principle-holomorphic) on the convex ball B(c, rho), rho = (r + R)/2
;;;      (the circle is null-homotopic there: convex-closed-path-null-homotopic), the zeros there being finite
;;;      (analytic-zeros-finite-in-ball); the winding number about a zero is 1 inside the circle, 0 outside.
;;; ===============================================================================================================
(define c4n-tp '(* 2 PI))
(define c4n-C '(CIRCLE-PATH c r))
(define c4n-Cd '(CIRCLE-DERIV c r))
(define c4n-TR (list 'TRACE c4n-C 0 c4n-tp))
(define c4n-rho '(* 1/2 (+ r c4nq_)))
(define c4n-BigB '(BALL CC-MS c c4nq_))
(define c4n-Bp (list 'BALL 'CC-MS 'c c4n-rho))
(define c4n-Br '(BALL CC-MS c r))
(define c4n-CB (list 'CLOSED-BALL 'CC-MS 'c c4n-rho))
(define c4n-gu '(VNB-LAMBDA c4nx_ u (- (f c4nx_) c4nw_)))
(define c4n-Zw '(SEP c4nz_ (BALL CC-MS c r) (= (f c4nz_) c4nw_)))
