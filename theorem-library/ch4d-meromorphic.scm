(dk-cite! 'cc-open-subset-cc 'u)
(dk-cite! 'holomorphic-on-in-fun 'u 'f)
(fact 'subset-mem-fwd 'u 'CC 'a)
(define c4q-r (c4-open-ball! 'u 'a))
(define c4q-B (c4-B 'a c4q-r))
(c4-ball-setup! 'a c4q-r)
(dk-cite! 'holomorphic-on-restrict 'u 'f c4q-B)
(fact 'nn-zero-in)
(mac 'IS-MEROMORPHIC-AT)
(dk-conj-close!
  (lambda ()
    (cond ((dk-asm? (dk-goal)) (ass))
          ((dk-head-is? (dk-goal) 'FORSOME)
           (c4-ew-chain-k! (list 0 c4q-r (list 'RESTRICT 'f c4q-B))
             (lambda ()
               (let* ((z (dk-di-var!)) (fin (c4-close! rfl)) (R (list 'recip (list '- z 'a))))
                 (c4-pb-open! 'a c4q-r z)
                 (fact 'subset-mem-fwd c4q-B 'u z)
                 (fact 'fun-apply-type-c 'f 'u 'CC z)
                 (c4-cc! R)
                 (subst (dk-cite! 'power-zero R))
                 (fact 'restrict-apply 'f c4q-B z)
                 (subst (list '== (list (list 'RESTRICT 'f c4q-B) z) (list 'f z)))
                 (let ((fv (c4-cc-name! (list 'f z)))) (subst (list '= (list 'f z) fv)) (crs))
                 (fin)))))
          (#t (error "c4q: open conjunct" (dk-goal))))))
(c4-dump-open!)
(qed 'holomorphic-is-meromorphic-at)

(define (c4q-sing fn S) (list 'FORALL 'c4gx_ (list 'IMPLIES (list 'IN 'c4gx_ S)
                          (list 'OR (list 'IS-REMOVABLE-SINGULARITY fn 'c4gx_) (list 'FORSOME 'mrn_ (list 'IS-POLE fn 'c4gx_ 'mrn_))))))
(define c4q-DA '(DIFFERENCE u c4ga_))
(define c4q-DB '(DIFFERENCE u c4gb_))
(define c4q-D '(DIFFERENCE u (UNION c4ga_ c4gb_)))
(define (c4q-S op) (list 'VNB-LAMBDA 'c4gz_ c4q-D (list op '(f c4gz_) '(g c4gz_))))
(define (c4q-stmt op)
  (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN c4g-nfm 'u)
    (list 'FORALL 'c4ga_ (list 'FORALL 'f (c4-imps (list '(SUBSET c4ga_ u) (list 'HOLOMORPHIC-ON c4q-DA 'f) (c4q-sing 'f 'c4ga_))
      (list 'FORALL 'c4gb_ (list 'FORALL 'g (c4-imps (list '(SUBSET c4gb_ u) (list 'HOLOMORPHIC-ON c4q-DB 'g) (c4q-sing 'g 'c4gb_))
        (list 'MEROMORPHIC-ON 'u (c4q-S op)))))))))))
(define (c4q-mer-at! fn A DA x)        ; x in A u B: IS-MEROMORPHIC-AT(fn, x)
  (let ((goal (list 'IS-MEROMORPHIC-AT fn x)))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (use-em (list 'IN x A)
              (lambda ()
                (let ((o (c4-inst! (dk-ctx-form (c4q-sing fn A)) x)))
                  (dk-or-each! o
                    (lambda (c4q-dsj)
                      (let ((fin (c4-close! ass)))
                        (if (dk-asm? (list 'IS-REMOVABLE-SINGULARITY fn x))
                            (dk-cite! 'removable-is-meromorphic-at fn x)
                            (let ((N (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm 'IS-POLE) (dk-contains? fm x))) "the pole"))))
                              (dk-cite! 'pole-is-meromorphic-at fn x N)))
                        (fin))))))
              (lambda ()
                (let* ((fin (c4-close! ass)) (iff (dk-cite! 'difference-membership 'u A x)))
                  (dk-have! (list 'IN x DA) (lambda () (c4-only-prop! iff (list 'IN x 'u) (list 'NOT (list 'IN x A)))))
                  (c4-inst! (dk-cite! 'holomorphic-is-meromorphic-at DA fn) x)
                  (fin)))))))
    goal))
(define (c4q-data! fn x)               ; IS-MEROMORPHIC-AT(fn, x): (r law) of a fresh unfolding (lane-safe: the predicate is kept)
  (let* ((iff (dk-cite! 'is-meromorphic-at fn x)) (rhs (caddr iff)))
    (dk-have! rhs (lambda () (c4-only-prop! iff (list 'IS-MEROMORPHIC-AT fn x))))
    (dk-split-all! (list (dk-ctx-form rhs)))
    (let* ((N (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (eq? (cadr fm) 'mrn_) (dk-contains? fm fn) (dk-contains? fm x))) "N")))
           (_ (dk-split-all!))
           (r (c4-sk! 'mrr N)) (_ (dk-split-all!))
           (g (c4-sk! 'mrg r)) (_ (dk-split-all!))
           (law (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm g) (dk-contains? fm fn))) "the law")))
      (dk-cite! 'holomorphic-on-in-fun (c4-B x r) g)
      (list r law N g))))
(define (c4q-op! op)
  (dk-peel!)
  (c4g-cc-setup!)
  (dk-cite! 'cc-open-subset-cc 'u)
  (dk-cite! 'holomorphic-on-open c4q-DA 'f) (dk-cite! 'holomorphic-on-open c4q-DB 'g)
  (dk-cite! 'holomorphic-on-in-fun c4q-DA 'f) (dk-cite! 'holomorphic-on-in-fun c4q-DB 'g)
  (define (iffs z) (list (dk-cite! 'difference-membership 'u '(UNION c4ga_ c4gb_) z) (dk-cite! 'union-membership 'c4ga_ 'c4gb_ z)
                         (dk-cite! 'difference-membership 'u 'c4ga_ z) (dk-cite! 'difference-membership 'u 'c4gb_ z)
                         (dk-cite! 'intersection-membership c4q-DA c4q-DB z)))
  (define (sub! A B) (dk-have! (list 'SUBSET A B) (lambda () (let* ((x (subset-by-element!))) (apply c4-only-prop! (append (iffs x) (list (list 'IN x A))))))))
  (sub! c4q-D c4q-DA) (sub! c4q-D c4q-DB)
  (c4-union-sub! 'c4ga_ 'c4gb_ 'u)
  ;; D = (u \ A) n (u \ B) is open
  (dk-have! (list '= c4q-D (list 'INTERSECTION c4q-DA c4q-DB))
    (lambda ()
      (let ((ce (dk-cite! 'class-extensionality c4q-D (list 'INTERSECTION c4q-DA c4q-DB))))
        (dk-have! (cadr ce) (lambda () (let* ((z (begin (di) (cadr (cadr (dk-goal)))))) (apply c4-only-prop! (iffs z)))))
        (let ((fin (c4-close! ass))) (dk-landed-1 (lambda () (detach! ce))) (fin)))))
  (c4-and! (list 'IS-OPEN c4g-nfm c4q-DA) (list 'IS-OPEN c4g-nfm c4q-DB))
  (fact 'nf-cc-is-metric-space)
  (dk-cite! 'inter-of-opens-open c4g-nfm c4q-DA c4q-DB)
  (dk-rewrite-h! (list 'IS-OPEN c4g-nfm (list 'INTERSECTION c4q-DA c4q-DB)) (list 'INTERSECTION c4q-DA c4q-DB) c4q-D)
  (dk-cite! 'cc-open-subset-cc c4q-DA)
  (fact 'subset-trans c4q-D c4q-DA 'CC)
  (fact 'subclass-of-set-is-set c4q-D 'CC)
  ;; the sum (product) is holomorphic on D
  (let* ((fD (c4m-restrict! c4q-DA 'f c4q-D)) (gD (c4m-restrict! c4q-DB 'g c4q-D))
         (S (c4q-S op)) (S2 (list 'VNB-LAMBDA 'c4gw_ c4q-D (list op (list fD 'c4gw_) (list gD 'c4gw_)))))
    (define (vals! z)
      (fact 'subset-mem-fwd c4q-D c4q-DA z) (fact 'subset-mem-fwd c4q-D c4q-DB z)
      (fact 'fun-apply-type-c 'f c4q-DA 'CC z) (fact 'fun-apply-type-c 'g c4q-DB 'CC z)
      (c4m-rval! fD 'f c4q-D z) (c4m-rval! gD 'g c4q-D z))
    (dk-have! (list 'HOLOMORPHIC-ON c4q-D S2) (lambda () (dk-holomorphic! c4q-D S2)))
    (c4-lam-typ! S c4q-D (lambda (v) (vals! v)))
    (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ c4q-D) (list '== (list S 'hbx_) (list S2 'hbx_))))
      (lambda () (let* ((x (dk-di-var!)) (fin (c4-close! qrfl)))
                   (vals! x) (c4-lam-b!)
                   (subst (list '= (list fD x) (list 'f x))) (subst (list '= (list gD x) (list 'g x)))
                   (fin))))
    (dk-cite! 'holomorphic-transfer-ptwise-eq c4q-D S S2)
    (mac 'MEROMORPHIC-ON)
    (dk-conj-close!
      (lambda ()
        (cond ((dk-asm? (dk-goal)) (ass))
              ((dk-head-is? (dk-goal) 'FORSOME)
               (ew '(UNION c4ga_ c4gb_))
               (dk-conj-close!
                 (lambda ()
                   (cond ((dk-asm? (dk-goal)) (ass))
                         ((dk-head-is? (dk-goal) 'FORALL)
                          (let* ((x (dk-di-var!)))
                            (fact 'subset-mem-fwd '(UNION c4ga_ c4gb_) 'u x)
                            (fact 'subset-mem-fwd 'u 'CC x)
                            (c4q-mer-at! 'f 'c4ga_ c4q-DA x)
                            (c4q-mer-at! 'g 'c4gb_ c4q-DB x)
                            ;; S agrees with f op g on a punctured ball about x: both laws hold there, so z is in D
                            (let* ((df (c4q-data! 'f x)) (dg (c4q-data! 'g x)) (r1 (car df)) (r2 (car dg)))
                              (c4-ball-setup! x r1) (c4-ball-setup! x r2)
                              (c4-min! r1 r2
                                (lambda (r0)
                                  (define fin (c4-close! ass))
                                  (c4-ball-setup! x r0)
                                  (dk-cite! 'cc-ms-ball-mono x r0 r1) (dk-cite! 'cc-ms-ball-mono x r0 r2)
                                  (dk-have! (list 'FORSOME 'c4mr_ (list 'AND '(IN c4mr_ RR) (list 'AND '(< 0 c4mr_)
                                              (list 'FORALL 'c4mz_ (list 'IMPLIES (list 'IN 'c4mz_ (c4m-PB x 'c4mr_)) (list '= (list S 'c4mz_) (list op '(f c4mz_) '(g c4mz_))))))))
                                    (lambda ()
                                      (ew r0)
                                      (dk-conj-close!
                                        (lambda ()
                                          (if (dk-asm? (dk-goal)) (ass)
                                              (let* ((z (dk-di-var!)) (fin2 (c4-close! rfl)))
                                                (c4-pb-open! x r0 z)
                                                (fact 'subset-mem-fwd (c4-B x r0) (c4-B x r1) z) (fact 'subset-mem-fwd (c4-B x r0) (c4-B x r2) z)
                                                (c4-pb-in! x r1 z) (c4-pb-in! x r2 z)
                                                (let ((e1 (c4-inst! (cadr df) z)) (e2 (c4-inst! (cadr dg) z)))
                                                  (dk-cite! 'fun-value-in-domain c4q-DA 'CC 'f z (caddr e1))
                                                  (dk-cite! 'fun-value-in-domain c4q-DB 'CC 'g z (caddr e2)))
                                                (let ((is (iffs z)))
                                                  (dk-have! (list 'IN z c4q-D) (lambda () (apply c4-only-prop! (append is (list (list 'IN z c4q-DA) (list 'IN z c4q-DB)))))))
                                                (vals! z)
                                                (c4-lam-b!)
                                                (fin2)))))))
                                  (dk-cite! (if (eq? op '+) 'meromorphic-at-sum 'meromorphic-at-product) 'f 'g S x)
                                  (dk-cite! 'meromorphic-point-cases S x)
                                  (fin))))))
                         (#t (error "c4q: open conjunct (2)" (dk-goal)))))))
              (#t (error "c4q: open conjunct (1)" (dk-goal))))))))
(sp (make-wff (c4q-stmt '+)))
(c4q-op! '+)
(c4-dump-open!)
(qed 'meromorphic-on-sum)
(sp (make-wff (c4q-stmt '*)))
(c4q-op! '*)
(c4-dump-open!)
