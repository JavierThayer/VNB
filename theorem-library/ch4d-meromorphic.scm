        (list 'AND '(FORALL c4uy_ (IMPLIES (IN c4uy_ ww) (FORSOME c4ub_ (AND (IN c4ub_ vv) (= (f c4ub_) c4uy_)))))
          (list 'FORALL 'c4uy_ (list 'IMPLIES '(IN c4uy_ ww) (list 'IMPLIES '(NOT (= c4uy_ (f a)))
            (list '= '(CARD (SEP c4ub_ vv (= (f c4ub_) c4uy_))) n)))))))))))))
