            (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES '(IN hbx_ u) (list '== '(f hbx_) (list Q 'hbx_))))
              (lambda () (let* ((x (dk-di-var!)) (fin (c4-close! qrfl)))
