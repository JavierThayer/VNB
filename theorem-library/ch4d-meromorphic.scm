;;; ===============================================================================================================
;;; (10) PROPOSITION 4.20, ROUCHE'S THEOREM.  f, g meromorphic on u (poles Pf, Pg; zeros Zf, Zg; all finite), a
;;;      closed road in u \ (Ef u Eg), null-homotopic in u, with |f - g| < |g| on its trace.  Then
;;;        sum_{Ef} deg(f, a) ind(gamma, a) = sum_{Eg} deg(g, a) ind(gamma, a).
;;;      h = f/g on V = u \ Ef \ Eg: h'/h = f'/f - g'/g, h o gamma stays in B(1, 1), so ind(h o gamma, 0) = 0
;;;      (winding-zero-outside-disc), i.e. int f'/f = int g'/g (winding-of-composite, line-int-sum / -scalar /
;;;      -domain-congruence); then the argument principle for f and for g.
;;; ===============================================================================================================
(define c4r-ag '(NORMED-FIELD-ADDITIVE-AG CC-NORMED-FIELD))
(define c4r-tpi '(* (* 2 PI) +i))
(define c4r-rt (list 'recip c4r-tpi))
(define c4r-TR '(TRACE mdp_ mds_ mdt_))
(define c4r-road '(mdp_ mdq_ mds_ mdt_))
(define (c4r-U P) (list 'DIFFERENCE 'u P))
(define (c4r-E Z P) (list 'UNION Z P))
(define (c4r-D Z P) (list 'DIFFERENCE 'u (list 'UNION Z P)))
(define (c4r-LD fn Z P) (list 'VNB-LAMBDA 'c4az_ (c4r-D Z P) (list '* (list 'DERIV-ON 'CC-NORMED-FIELD (c4r-U P) fn 'c4az_) (list 'recip (list fn 'c4az_)))))
(define c4r-W '(WINDING mdp_ mdq_ mds_ mdt_ mqx_))
(define (c4r-S fn Z P)
  (list '+ (list 'FINSUM c4r-ag (list 'VNB-LAMBDA 'mqx_ 'CC (list '* (list 'ZERO-ORDER (c4r-U P) fn 'mqx_) c4r-W)) Z)
           (list 'FINSUM c4r-ag (list 'VNB-LAMBDA 'mqx_ 'CC (list '* (list '- (list 'POLE-ORDER fn 'mqx_)) c4r-W)) P)))
(define (c4r-HP fn P) (list 'FORALL 'c4ax_ (list 'IMPLIES (list 'IN 'c4ax_ P) (list 'FORSOME 'c4an_ (list 'IS-POLE fn 'c4ax_ 'c4an_)))))
(define (c4r-H4 fn Z P) (list 'FORALL 'c4ax_ (list 'IMPLIES (list 'IN 'c4ax_ (c4r-U P)) (list 'IMPLIES (list '= (list fn 'c4ax_) 0) (list 'IN 'c4ax_ Z)))))
(define (c4r-H4b fn Z) (list 'FORALL 'c4ax_ (list 'IMPLIES (list 'IN 'c4ax_ Z) (list '= (list fn 'c4ax_) 0))))
(define (c4r-H5 fn Z P) (list 'FORALL 'c4ax_ (list 'IMPLIES (list 'IN 'c4ax_ Z) (list 'FORSOME 'c4am_ (list 'HAS-ZERO-OF-ORDER (c4r-U P) fn 'c4ax_ 'c4am_)))))
(define (c4r-hyps fn P Z body)         ; the meromorphic data of FN, then BODY
  (list 'FORALL P (c4-imps (list (list 'IN P 'SET) (list 'IN (list 'CARD P) 'NN) (list 'SUBSET P 'u))
    (list 'FORALL fn (c4-imps (list (list 'HOLOMORPHIC-ON (c4r-U P) fn) (c4r-HP fn P))
      (list 'FORALL Z (c4-imps (list (list 'IN Z 'SET) (list 'IN (list 'CARD Z) 'NN) (c4r-H4 fn Z P) (c4r-H4b fn Z) (c4r-H5 fn Z P))
        body)))))))
(define c4r-Ef '(UNION mzf_ mpf_))
(define c4r-Eg '(UNION mzg_ mpg_))
(define c4r-Df (c4r-D 'mzf_ 'mpf_))
(define c4r-Dg (c4r-D 'mzg_ 'mpg_))
(define c4r-Uf (c4r-U 'mpf_))
(define c4r-Ug (c4r-U 'mpg_))
(define c4r-V (list 'DIFFERENCE c4r-Df c4r-Eg))
(define c4r-Hr '(FORALL c4ry_ (IMPLIES (IN c4ry_ (TRACE mdp_ mds_ mdt_)) (< (magnitude (- (f c4ry_) (g c4ry_))) (magnitude (g c4ry_))))))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN c4g-nfm 'u)
  (c4r-hyps 'f 'mpf_ 'mzf_
    (c4r-hyps 'g 'mpg_ 'mzg_
      (list 'FORALL 'mdp_ (list 'FORALL 'mdq_ (list 'FORALL 'mds_ (list 'FORALL 'mdt_
        (c4-imps (list '(IS-ROAD mdp_ mdq_ mds_ mdt_) (list 'SUBSET c4r-TR (list 'DIFFERENCE 'u (list 'UNION c4r-Ef c4r-Eg)))
                       '(= (mdp_ mdt_) (mdp_ mds_)) '(NULL-HOMOTOPIC u mdp_ mds_ mdt_) c4r-Hr)
          (list '= (c4r-S 'f 'mzf_ 'mpf_) (c4r-S 'g 'mzg_ 'mpg_)))))))))))))
