  (for-each (lambda (v)
              (if (not (dk-asm? (list 'IN v c4c-I)))
                  (dk-have! (list 'IN v c4c-I)
                    (lambda () (mac 'ccint-membership)
                               (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! '(< mds_ mdt_) '(IN mds_ RR) '(IN mdt_ RR)))))))))
            '(mds_ mdt_)))
