(define c4a-H4 (list 'FORALL 'c4ax_ (list 'IMPLIES (list 'IN 'c4ax_ c4a-U) '(IMPLIES (= (f c4ax_) 0) (IN c4ax_ mzs_)))))
(define c4a-H4b '(FORALL c4ax_ (IMPLIES (IN c4ax_ mzs_) (= (f c4ax_) 0))))
(define c4a-H5 (list 'FORALL 'c4ax_ (list 'IMPLIES '(IN c4ax_ mzs_) (list 'FORSOME 'c4am_ (list 'HAS-ZERO-OF-ORDER c4a-U 'f 'c4ax_ 'c4am_)))))
(define c4a-disj '(FORALL c4ax_ (IMPLIES (IN c4ax_ mps_) (NOT (IN c4ax_ mzs_)))))
