(dk-cite! 'road-holomorphic-composite 'u 'f 'mdp_ 'mdq_ 'mds_ 'mdt_)
(fact 'is-road-is-path c4c-Pf c4c-Qf 'mds_ 'mdt_)
(fact 'is-path-in-fun c4c-Pf 'mds_ 'mdt_)
(define c4c-TRf (list 'TRACE c4c-Pf 'mds_ 'mdt_))
(dk-have! (list 'NOT (list 'IN 'c4cw_ c4c-TRf))
  (lambda ()
    (di)
    (fact 'trace-unfold c4c-Pf 'mds_ 'mdt_)
    (let* ((m1 (dk-rewrite-h! (list 'IN 'c4cw_ c4c-TRf) c4c-TRf (list 'IMAGE c4c-Pf c4c-I)))
           (iff (dk-cite! 'image-membership-iff c4c-Pf c4c-I 'c4cw_)))
      (dk-have! (caddr iff) (lambda () (c4-only-prop! iff m1)))
      (dk-split! (caddr iff))
      (let* ((v (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm 'c4cw_))) "the preimage") #t))
             (pv (c4c-ptw! v))
             (e (dk-pick (lambda (fm) (and (dk-head-is? fm '=) (equal? (cadr fm) (list c4c-Pf v)))) "Pf v = w")))
        (let ((e2 (dk-lam-b-h! e)))
          (ai (list 'NOT (list '= (list 'f pv) 'c4cw_))))))))
(dk-cite! 'winding-in-cc c4c-Pf c4c-Qf 'mds_ 'mdt_ 'c4cw_)
(define c4c-Kw '(VNB-LAMBDA wnw_ (DIFFERENCE CC (SINGLETON c4cw_)) (recip (- wnw_ c4cw_))))
(define c4c-wu (dk-cite! 'winding-unfold-eq c4c-Pf c4c-Qf 'mds_ 'mdt_ 'c4cw_))
(define c4c-u1 (dk-cite! 'line-int-unfold c4c-Kw c4c-Pf c4c-Qf 'mds_ 'mdt_))
(define c4c-u2 (dk-cite! 'line-int-unfold c4c-LDw 'mdp_ 'mdq_ 'mds_ 'mdt_))
(define c4c-K1 (cadr (caddr c4c-u1)))
(define c4c-K2 (cadr (caddr c4c-u2)))
(dk-fun-ext! c4c-K1 c4c-K2 c4c-I 'CC
  (lambda () (c4-lam-typ! c4c-K1 c4c-I (lambda (v) (c4c-ptw! v))))
  (lambda () (c4-lam-typ! c4c-K2 c4c-I (lambda (v) (c4c-ptw! v))))
  (lambda (v)
    (let* ((fin (c4-close! rfl)) (pv (c4c-ptw! v))
           (A (list 'recip (list '- (list 'f pv) 'c4cw_))) (D (list 'DERIV-ON 'CC-NORMED-FIELD 'u 'f pv)) (Q (list 'mdq_ v)))
      (c4-lam-b!)
      (let* ((Av (c4-cc-name! A)) (Dv (c4-cc-name! D)) (Qv (c4-cc-name! Q)))
        (subst (list '= A Av)) (subst (list '= D Dv)) (subst (list '= Q Qv))
        (crs))
      (fin))))
(let* ((X (caddr c4c-wu)) (W (cadr c4c-wu)) (fin (c4-close! rfl)))
  (subst (list '= (list 'LINE-INT c4c-LDw 'mdp_ 'mdq_ 'mds_ 'mdt_) (caddr c4c-u2)))
  (subst (list '= c4c-K2 c4c-K1))
  (subst (list '= (caddr c4c-u1) (cadr c4c-u1)))
  (subst (list '= X W))
  (fin))
