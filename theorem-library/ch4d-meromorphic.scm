(define c4-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (c4-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (c4-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u)
    (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS c4-nfm u) c4-nfm f 'rgy_))))
(define (c4-imps hyps body)
  (if (null? hyps) body (list 'IMPLIES (car hyps) (c4-imps (cdr hyps) body))))
(define (c4-all vars body)
  (if (null? vars) body (list 'FORALL (car vars) (c4-all (cdr vars) body))))
(define (c4-and! a b)
  (let* ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (c4-pz z) (list 'DIFFERENCE 'CC (list 'SINGLETON z)))
(define (c4-rr! t)
  (let* ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((eq? t 'PI) (dk-split-all! (list (dk-cite! 'pi-pos))) typ)
          ((number? t) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((c4-op? t 'succ 2) (c4-nn! t) (fact 'nn-in-rr t) typ)
          ((c4-op? t '* 3) (c4-rr! (cadr t)) (c4-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((c4-op? t '+ 3) (c4-rr! (cadr t)) (c4-rr! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((c4-op? t '- 3) (c4-rr! (cadr t)) (c4-rr! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((c4-op? t '- 2) (c4-rr! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((c4-op? t 'magnitude 2) (c4-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((c4-op? t 'real-part 2) (c4-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((c4-op? t 'imag-part 2) (c4-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((c4-op? t 'abs 2) (c4-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((c4-op? t 'recip 2)
           (c4-rr! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (if (dk-asm? (list '< 0 (cadr t)))
                   (fact 'rr-pos-ne-zero (cadr t))
                   (error "iv-rr!: land the non-vanishing first" (expression->string (cadr t)))))
           (c4-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t))
           typ)
          (#t (dk-real! t) typ))))
(define (c4-nn! t)
  (let* ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((c4-op? t 'succ 2) (c4-nn! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          (#t (dk-type! t 'NN)))))
(define (c4-cc! t)
  (let* ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((or (and (number? t) (real? t)) (eq? t 'PI) (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
               (c4-op? t 'succ 2)
               (c4-op? t 'magnitude 2) (c4-op? t 'real-part 2) (c4-op? t 'imag-part 2))
           (c4-rr! t) (fact 'rr-subset-cc t) typ)
          ((c4-op? t '- 3) (c4-cc! (cadr t)) (c4-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((c4-op? t '- 2) (c4-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((c4-op? t '+ 3) (c4-cc! (cadr t)) (c4-cc! (caddr t))
           (c4-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((c4-op? t '* 3) (c4-cc! (cadr t)) (c4-cc! (caddr t))
           (c4-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((c4-op? t 'power 3) (c4-cc! (cadr t)) (c4-nn! (caddr t))
           (c4-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((c4-op? t 'CC-EXP 2) (c4-cc! (cadr t))
           (dk-split-all! (list (dk-cite! 'cc-exp-converges (cadr t)))) typ)
          ((c4-op? t 'recip 2) (c4-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "iv-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (c4-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (dk-type! t 'CC)))))
(define (c4-sub-nz! y z)
  (let* ((nz (list 'NOT (list '= (list '- y z) 0))))
    (dk-have! nz
      (lambda ()
        (di)
        (dk-cite! 'cc-sub-zero-eq y z)
        (ai (dk-ctx-form (list 'NOT (list '= y z))))))
    nz))
(define (c4-steps . thunks)
  ;; run THUNKS in order while the leaf focused at the start stays open
  (let* ((leaf (proof-state-focus *ps*)))
    (let loop ((ts thunks))
      (if (and (pair? ts) (not (sequent-node-grounded? leaf)))
          (begin ((car ts)) (loop (cdr ts)))))))
(define (c4-pz-open! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (c4-steps
      (lambda () (dk-have! (list 'IN y 'CC) (lambda () (c4-only-prop! iff (list 'IN y (c4-pz z))))))
      (lambda () (dk-have! (list 'NOT (list '= y z)) (lambda () (c4-only-prop! iff (list 'IN y (c4-pz z))))))
      (lambda () (c4-sub-nz! y z)))))
(define (c4-pz-in! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (dk-have! (list 'IN y (c4-pz z))
      (lambda () (c4-only-prop! iff (list 'IN y 'CC) (list 'NOT (list '= y z)))))))
(define (c4-pz-setup! z)
  (let* ((d (c4-pz z)))
    (fact 'nf-cc-is-metric-space)
    (dk-cite! 'cc-punctured-open z)
    (let* ((iff (dk-cite! 'cc-ms-open-iff d)))
      (dk-have! (list 'IS-OPEN c4-nfm d) (lambda () (c4-only-prop! iff (list 'IS-OPEN 'CC-MS d)))))
    (fact 'cc-is-set)
    (dk-cite! 'difference-set 'CC (list 'SINGLETON z))
    (dk-cite! 'cc-open-subset-cc d)))
(define (c4-lam-typ! lam dom pre)
  (dk-have! (list 'IN lam (list 'FUN dom 'CC))
    (lambda ()
      (dk-lam-type! (lambda ()
                      (let* ((v (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                        (c4-steps
                          (lambda () (pre v))
                          (lambda () (if (dk--redex? (dk-goal)) (dk-lam-b!)))
                          (lambda () (if (not (dk-asm? (dk-goal))) (c4-cc! (cadr (dk-goal)))))
                          (lambda () (ass)))))))))
(define (c4-detach! imp thunk)
  (if (and (pair? imp) (eq? (car imp) 'IMPLIES))
      (begin (dk-have! (cadr imp) thunk)
             (dk-landed-1 (lambda () (detach! imp))))
      imp))
(define (c4-only-prop! . fs) (if (apply dk-only! fs) (prop)))
(define (c4-lam-b-if!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
(define (c4-subst-ass! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (ass))))
(define c4-tpi '(* (* 2 PI) +i))
(define (c4-tpi!)
  (c4-rr! '(* 2 PI))
  (dk-have! '(< 0 (* 2 PI)) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'rr-pos-ne-zero '(* 2 PI))
  (c4-cc! '(* 2 PI))
  (fact 'cc-i-in)
  (dk-have! '(NOT (= +i 0))
    (lambda ()
      (di)
      (fact 'cc-i-squared)
      (dk-have! '(= (* 0 0) -1) (lambda () (subst '(= 0 +i)) (ass)))
      (dk-have! '(NOT (= (* 0 0) -1)) (lambda () (arith)))
      (ai '(NOT (= (* 0 0) -1)))))
  (dk-cite! 'cc-mul-nonzero '(* 2 PI) +i)
  (c4-cc! c4-tpi)
  (c4-cc! (list 'recip c4-tpi))
  (c4-and! (list 'IN c4-tpi 'CC) (list 'NOT (list '= c4-tpi 0)))
  (dk-cite! 'cc-recip-inverse c4-tpi))
(define (c4-in-ball! x c s)
  (let* ((m (list 'magnitude (list '- x c))))
    (fact 'cc-is-metric-space)
    (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
    (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (dk-have! (list 'IN c '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (c4-rr! m)
    (dk-cite! 'cc-ms-dist c x)
    (dk-cite! 'cc-magnitude-sub-sym c x)
    (dk-have! (list '<= (list '(DIST CC-MS) c x) m)
      (lambda ()
        (subst (list '= (list '(DIST CC-MS) c x) (list 'magnitude (list '- c x))))
        (if (not (equal? c x)) (subst (list '= (list 'magnitude (list '- c x)) m)))
        (dk-ineq!)))
    (let* ((cj (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list 'IN m 'RR) (list 'AND (list 'IN s 'RR)
                (list 'AND (list '<= (list '(DIST CC-MS) c x) m) (list '< m s)))))))
      (dk-have! cj (lambda () (dk-conj-close! dk-ass!)))
      (dk-cite! 'ball-mem-from-le 'CC-MS c x m s))))
(define (c4-subst-qrfl! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (qrfl))))
(define (c4-ball-open! c r x)
  ;; x in BALL(CC-MS, c, r) in context: land x in CC and |x - c| < r (stops early when a
  ;; landing closes the focus leaf, the claim being the goal)
  (let* ((dcx (list '(DIST CC-MS) c x))
         (mag (list 'magnitude (list '- c x)))
         (mag2 (list 'magnitude (list '- x c)))
         (cj  (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list '<= dcx r) (list 'NOT (list '= dcx r))))))
    (c4-steps
      (lambda () (fact 'cc-is-metric-space))
      (lambda () (let* ((iff (dk-cite! 'ball-membership 'CC-MS c r x)))
                   (dk-have! cj (lambda () (c4-only-prop! iff (list 'IN x (list 'BALL 'CC-MS c r)))))))
      (lambda () (dk-split-all! (list (dk-ctx-form cj))))
      (lambda () (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl))))
      (lambda () (dk-have! (list 'IN x 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass))))
      (lambda () (dk-cite! 'cc-ms-dist c x))
      (lambda () (c4-rr! mag))
      (lambda () (c4-rr! mag2))
      (lambda () (dk-cite! 'cc-magnitude-sub-sym c x))
      (lambda () (dk-have! (list 'AND (list '<= mag r) (list 'NOT (list '= mag r)))
                   (lambda () (subst (list '= mag dcx)) (dk-conj-close! dk-ass!))))
      (lambda () (dk-cite! 'rr-le-ne-lt mag r))
      (lambda () (dk-have! (list '< mag2 r) (lambda () (dk-ineq! (list '< mag r) (list '= mag mag2))))))))
(define (c4-subst-sym e from to)
  (cond ((eq? e from) to)
        ((pair? e) (cons (c4-subst-sym (car e) from to) (c4-subst-sym (cdr e) from to)))
        (#t e)))
(define (c4-tpt! x . zs)
  (c4-steps
    (lambda () (fact 'subset-mem-fwd c4-T (c4-pz 'c) x))
    (lambda () (c4-pz-open! 'c x))
    (lambda () (for-each (lambda (z) (fact 'subset-mem-fwd c4-T (c4-pz z) x) (c4-pz-open! z x)) zs))))
(define (c4-dump-open!)
  (for-each (lambda (l) (display "\n;; OPEN: ") (display (expression->string (dk-goal-of l)))) (dk-open-leaves)))
(define (c4-center-in-ball! a r)
  ;; a in CC, r in RR, 0 < r: land a in BALL(CC-MS, a, r) (which also certifies the ball DEFINED)
  (let* ((d (list '- a a)) (m (list 'magnitude d)))
    (c4-rr! m)
    (c4-cc! d)
    (dk-have! (list '= d 0) (lambda () (crs)))
    (let ((iff (dk-cite! 'cc-magnitude-zero-iff d)))
      (dk-have! (list '= m 0) (lambda () (c4-only-prop! iff (list '= d 0)))))
    (dk-have! (list '< m r) (lambda () (dk-ineq! (list '= m 0) (list '< 0 r))))
    (c4-in-ball! a a r)))
(define c4-tp '(* 2 PI))
(define c4-I (list 'CCINT 0 c4-tp))
(define c4-C '(CIRCLE-PATH c r))
(define c4-Cd '(CIRCLE-DERIV c r))
(define c4-T (list 'TRACE c4-C 0 c4-tp))
(define (c4-kern z) (list 'VNB-LAMBDA 'wnw_ (c4-pz z) (list 'recip (list '- 'wnw_ z))))
(define (c4-in-I! v)
  (dk-have! (list 'IN v c4-I)
    (lambda () (mac 'ccint-membership)
               (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 0 c4-tp) '(< 0 PI))))))))
(define (c4-circle-basics!)
  (fact 'rr-zero-in)
  (c4-rr! c4-tp)
  (dk-have! (list '< 0 c4-tp) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'circle-is-road 'c 'r)
  (fact 'is-road-is-path c4-C c4-Cd 0 c4-tp)
  (fact 'is-path-in-fun c4-C 0 c4-tp)
  (dk-cite! 'trace-subset-cc c4-C 0 c4-tp))
(define (c4-circ-pt! y)
  ;; y in the trace of the circle (c, r in context, 0 < r): y in CC, |y - c| = r,
  ;; r <= |y - c|, y /= c, y - c /= 0, y in CC \ {c}
  (let* ((m (list 'magnitude (list '- y 'c))))
    (c4-steps
      (lambda () (fact 'subset-mem-fwd c4-T 'CC y))
      (lambda () (dk-cite! 'circle-trace-magnitude 'c 'r y))
      (lambda () (c4-rr! m))
      (lambda () (dk-have! (list '<= 'r m) (lambda () (dk-ineq! (list '= m 'r)))))
      (lambda ()
        (dk-have! (list 'NOT (list '= y 'c))
          (lambda ()
            (di)
            (dk-have! (list '= m 0)
              (lambda () (subst (list '= y 'c))
                         (dk-have! '(= (- c c) 0) (lambda () (crs)))
                         (subst '(= (- c c) 0))
                         (fact 'cc-magnitude-zero)
                         (ass)))
            (dk-absurd! (list 'IN m 'RR) '(IN r RR) (list '= m 0) (list '= m 'r) '(< 0 r)))))
      (lambda () (c4-sub-nz! y 'c))
      (lambda () (c4-pz-in! 'c y)))))
(define (c4-LI f) (list 'LINE-INT f c4-C c4-Cd 0 c4-tp))
(define (c4-trace-in-pz! p)
  (dk-have! (list 'SUBSET c4-T (c4-pz p))
    (lambda ()
      (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
        (c4-circ-pt! y)
        (if (not (sequent-node-grounded? leaf)) (ass))))))
(define (c4-kern-setup! p)
  (let* ((dd (c4-pz p)) (k (c4-kern p)))
    (dk-cite! 'winding-integrand-holomorphic p)
    (dk-cite! 'holomorphic-on-in-fun dd k)
    (dk-cite! 'holomorphic-on-continuous dd k)
    (dk-cite! 'holomorphic-on-open dd k)
    (dk-cite! 'cc-open-subset-cc dd)))
(define (c4-lam-b!) (if (dk--redex? (dk-goal)) (dk-lam-b!) #f))
(define (c4-B e r) (list 'BALL 'CC-MS e r))
(define (c4-PB e r) (list 'DIFFERENCE (c4-B e r) (list 'SINGLETON e)))
(define (c4-pb-in! e r y)              ; y in B(e, r), y /= e (in context): y in B(e, r) \ {e}
  (let* ((iff (dk-cite! 'difference-membership (c4-B e r) (list 'SINGLETON e) y))
        (sf (begin (fact 'membership-implies-sethood y (c4-B e r)) (dk-cite! 'singleton-membership e y))))
    (dk-have! (list 'NOT (list 'IN y (list 'SINGLETON e))) (lambda () (c4-only-prop! sf (list 'NOT (list '= y e)))))
    (dk-have! (list 'IN y (c4-PB e r)) (lambda () (c4-only-prop! iff (list 'IN y (c4-B e r)) (list 'NOT (list 'IN y (list 'SINGLETON e))))))))
(define (c4-pb-open! e r y)            ; y in B(e, r) \ {e}: y in B, y in CC, y /= e, y - e /= 0, y in CC \ {e}
  (c4-steps
    (lambda () (let ((iff (dk-cite! 'difference-membership (c4-B e r) (list 'SINGLETON e) y)))
                 (if (not (and (dk-asm? (list 'IN y (c4-B e r))) (dk-asm? (list 'NOT (list 'IN y (list 'SINGLETON e))))))
                     (begin
                       (dk-have! (list 'AND (list 'IN y (c4-B e r)) (list 'NOT (list 'IN y (list 'SINGLETON e))))
                         (lambda () (c4-only-prop! iff (list 'IN y (c4-PB e r)))))
                       (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN y (c4-B e r)) (list 'NOT (list 'IN y (list 'SINGLETON e)))))))))))
    (lambda () (c4-ball-pt! e r y))
    (lambda () (fact 'membership-implies-sethood y 'CC))
    (lambda () (let ((iff (dk-cite! 'singleton-membership e y)))
                 (dk-have! (list 'NOT (list '= y e))
                   (lambda () (c4-only-prop! iff (list 'NOT (list 'IN y (list 'SINGLETON e))) (list 'IN y 'SET))))))
    (lambda () (c4-sub-nz! y e))
    (lambda () (c4-pz-in! e y))))
(define (c4-ball-pt! e r y)            ; y in B(e, r): y in CC, |y - e| < r
  (if (not (and (dk-asm? (list 'IN y 'CC)) (dk-asm? (list '< (list 'magnitude (list '- y e)) r))))
  (let ((iff (dk-cite! 'cc-ms-ball-membership e r y)))
    (dk-have! (list 'AND (list 'IN y 'CC) (list '< (list 'magnitude (list '- y e)) r))
      (lambda () (c4-only-prop! iff (list 'IN y (c4-B e r)))))
    (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN y 'CC) (list '< (list 'magnitude (list '- y e)) r))))))))
(define c4-nf '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (c4-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (c4-mag! t) (c4-cc! t) (if (not (dk-asm? (list 'IN (list 'magnitude t) 'RR))) (fact 'cc-magnitude-closed t)))
(define (c4-in01! v)                   ; v = 0 or 1: (IN v (CCINT 0 1))
  (fact 'rr-zero-in) (fact 'rr-one-in)
  (dk-have! (list 'IN v '(CCINT 0 1))
    (lambda () (mac 'ccint-membership)
      (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq!)))))))

(define (c4-open-ball! u c)            ; IS-OPEN(nf, u), c in u: a radius with B(c, r) inside u; returns r (POS-RR r, 0 < r, r in RR)
  (fact 'cc-is-metric-space) (c4-pts-cc!)
  (let ((iff0 (dk-cite! 'cc-ms-open-iff u)))
    (if (not (dk-asm? (list 'IS-OPEN 'CC-MS u))) (dk-have! (list 'IS-OPEN 'CC-MS u) (lambda () (c4-only-prop! iff0 (list 'IS-OPEN c4-nf u))))))
  (let* ((oiff (dk-cite! 'is-open 'CC-MS u))
         (oball (let loop ((r (caddr oiff))) (if (eq? (car r) 'AND) (loop (caddr r)) r))))
    (if (not (dk-asm? oball)) (dk-have! oball (lambda () (c4-only-prop! oiff (list 'IS-OPEN 'CC-MS u)))))
    (let ((rho (dk-skolem! (dk-apply! (dk-ctx-form oball) c))))
      (fact 'rr-pos-rr-in-rr rho) (fact 'rr-lt-of-pos-rr rho)
      rho)))
(define (c4-min! r1 r2 K)              ; 0 < r1, r2 in RR: K applied to a radius r0 with 0 < r0 <= r1, r0 <= r2
  (use-em (list '<= r1 r2)
    (lambda () (dk-have! (list '<= r1 r1) (lambda () (dk-ineq! (list 'IN r1 'RR)))) (K r1))
    (lambda () (fact 'rr-not-le-lt r1 r2) (dk-have! (list '<= r2 r2) (lambda () (dk-ineq! (list 'IN r2 'RR))))
               (dk-have! (list '<= r2 r1) (lambda () (dk-ineq! (list '< r2 r1)))) (K r2))))
(define (c4-ball-setup! e r)           ; 0 < r: B(e, r) open (both spellings), inside CC, a set
  (let ((B (c4-B e r)))
    (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
    (dk-have! (list 'NOT (list '= 0 r)) (lambda () (di) (dk-absurd! (list 'IN r 'RR) (list '< 0 r) (list '= 0 r))))
    (c4-and! (list 'IN r 'RR) (c4-and! (list '<= 0 r) (list 'NOT (list '= 0 r))))
    (fact 'cc-is-metric-space) (fact 'nf-cc-is-metric-space)
    (c4-pts-cc!)
    (dk-have! (list 'IN e '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (dk-cite! 'ball-is-open 'CC-MS e r)
    (let ((iff (dk-cite! 'cc-ms-open-iff B)))
      (dk-have! (list 'IS-OPEN c4-nf B) (lambda () (c4-only-prop! iff (list 'IS-OPEN 'CC-MS B)))))
    (dk-cite! 'cc-open-subset-cc B)
    (fact 'cc-is-set)
    (fact 'subclass-of-set-is-set B 'CC)))
(define (c4-unfold! name args pred)    ; PRED in context: land its defining right-hand side, split
  (let* ((iff (apply dk-cite! name args)) (rhs (caddr iff)))
    (dk-have! rhs (lambda () (c4-only-prop! iff pred)))
    (dk-split-all! (list (dk-ctx-form rhs)))
    rhs))
(define (c4-sk! binder . extra)        ; skolemise the FORSOME on BINDER (containing every EXTRA term)
  (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (symbol? (cadr fm)) (string-prefix? (symbol->string binder) (symbol->string (cadr fm)))
                                         (let loop ((es extra)) (or (null? es) (and (dk-contains? fm (car es)) (loop (cdr es)))))))
                       (symbol->string binder))))
(define (c4-ew-chain! ws)
  (if (pair? ws)
      (begin
        (ew (car ws))
        (dk-conj-close!
          (lambda ()
            (cond ((dk-asm? (dk-goal)) (ass))
                  ((dk-head-is? (dk-goal) 'FORSOME) (c4-ew-chain! (cdr ws)))
                  (#t (error "iv-ew-chain!: open conjunct" (dk-goal)))))))))
(define (c4-ew-chain-k! ws K)
  (if (pair? ws)
      (begin
        (ew (car ws))
        (dk-conj-close!
          (lambda ()
            (cond ((dk-asm? (dk-goal)) (ass))
                  ((dk-head-is? (dk-goal) 'FORSOME) (c4-ew-chain-k! (cdr ws) K))
                  (#t (K))))))))
(define (c4-inst! cl . args)          ; instantiate a context universal, detaching antecedents already in context
  (let loop ((r (apply dk-apply! cl args)))
    (if (and (dk-head-is? r 'IMPLIES) (dk-asm? (cadr r)))
        (if (dk-asm? (caddr r)) (loop (dk-ctx-form (caddr r))) (loop (dk-landed-1 (lambda () (detach! r)))))
        r)))
(define (c4-ball-in! c r x)           ; x in CC, c in CC, r in RR, |x - c| < r in context: x in BALL(CC-MS, c, r)
  (let ((iff (dk-cite! 'cc-ms-ball-membership c r x)))
    (dk-have! (list 'IN x (c4-B c r)) (lambda () (c4-only-prop! iff (list 'IN x 'CC) (list '< (list 'magnitude (list '- x c)) r))))))
(define (c4-mag-pos! t)               ; t in CC, NOT (t = 0) in context: lands 0 < |t|, |t| in RR
  (let* ((K (list 'magnitude t)))
    (c4-mag! t)
    (fact 'cc-magnitude-nonneg t)
    (if (not (dk-asm? (list '< 0 K)))
        (begin
          (let ((iff (dk-cite! 'cc-magnitude-zero-iff t)))
            (dk-have! (list 'NOT (list '= K 0)) (lambda () (c4-only-prop! iff (list 'NOT (list '= t 0))))))
          (dk-have! (list 'NOT (list '= 0 K)) (lambda () (di) (dk-have! (list '= K 0) (lambda () (subst (list '= K 0)) (rfl))) (ai (list 'NOT (list '= K 0)))))
          (fact 'rr-zero-in)
          (c4-and! (list '<= 0 K) (list 'NOT (list '= 0 K)))
          (dk-cite! 'rr-le-ne-lt 0 K)))
    K))
(define (c4-dz! u f z)                 ; HOLOMORPHIC-ON u f, z in u: IS-DIFF-ON(CC-NF, u, f, z, DERIV-ON(CC-NF, u, f, z))
  (let* ((D (list 'DERIV-ON 'CC-NORMED-FIELD u f z)) (goal (list 'IS-DIFF-ON 'CC-NORMED-FIELD u f z D)))
    (if (not (dk-asm? goal))
        (let* ((L (dk-skolem! (c4-inst! (dk-cite! 'holomorphic-on-diff u f) z))))
          (dk-cite! 'cc-deriv-on-of-is-diff-on u f z L)
          (dk-project! (list 'IN L '(CARR CC-NORMED-FIELD)) 'is-diff-on (list 'IS-DIFF-ON 'CC-NORMED-FIELD u f z L))
          (if (not (dk-asm? '(== (CARR CC-NORMED-FIELD) CC))) (fact 'cc-nf-carr))
          (let ((t1 (dk-rewrite-h! (list 'IN L '(CARR CC-NORMED-FIELD)) '(CARR CC-NORMED-FIELD) 'CC)))
            (dk-rewrite-h! t1 L D))
          (dk-rewrite-h! (list 'IS-DIFF-ON 'CC-NORMED-FIELD u f z L) L D)))
    goal))
(define (c4-cc-name! t)                ; t in CC typed: a fresh name v with v = t, v in CC
  (c4-cc! t) (dk-name! t 'CC))
(define (c4-nonzero-ball! u c g K)     ; HOLOMORPHIC-ON u g, IS-OPEN u, c in u, g c /= 0: K on (r0 B) with B = B(c, r0) inside u, g /= 0 on B
  (let* ((gc (list g c)))
    (fact 'fun-apply-type-c g u 'CC c)
    (let* ((Kc (c4-mag-pos! gc))
           (eps (list '* 1/2 Kc)))
      (c4-rr! eps)
      (dk-have! (list '< 0 eps) (lambda () (dk-ineq! (list '< 0 Kc) (list 'IN Kc 'RR) (list 'IN eps 'RR))))
      (fact 'rr-pos-rr-of-lt eps)
      (c4-inst! (dk-cite! 'holomorphic-on-continuous u g) c)
      (let* ((del (dk-skolem! (dk-cite! 'cc-continuous-at-modulus u g c eps)))
             (_ (dk-split-all!))
             (Cg (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm del))) "continuity of g at c")))
        (fact 'rr-pos-rr-in-rr del) (fact 'rr-lt-of-pos-rr del)
        (let* ((s (c4-open-ball! u c)))
          (c4-min! del s
            (lambda (r0)
              (let* ((B (c4-B c r0)))
                (c4-ball-setup! c r0)
                (dk-have! (list '<= r0 s) (lambda () (dk-ineq! (dk-ctx-form (list '<= r0 s)))))
                (dk-cite! 'cc-ms-ball-mono c r0 s)
                (fact 'subset-trans B (c4-B c s) u)
                (dk-have! (list 'FORALL 'c4y_ (list 'IMPLIES (list 'IN 'c4y_ B) (list 'NOT (list '= (list g 'c4y_) 0))))
                  (lambda ()
                    (let* ((y (dk-di-var!)) (gy (list g y)))
                      (c4-ball-pt! c r0 y)
                      (fact 'subset-mem-fwd B u y)
                      (fact 'fun-apply-type-c g u 'CC y)
                      (c4-mag! (list '- y c))
                      (dk-have! (list '< (list 'magnitude (list '- y c)) del)
                        (lambda () (dk-ineq! (list '< (list 'magnitude (list '- y c)) r0) (dk-ctx-form (list '<= r0 del)) (list 'IN r0 'RR) (list 'IN del 'RR)
                                             (list 'IN (list 'magnitude (list '- y c)) 'RR))))
                      (let ((h0 (c4-inst! Cg y)))
                        (di)
                        (let* ((h1 (dk-rewrite-h! h0 gy 0)))
                          (dk-cite! 'cc-magnitude-sub-sym 0 gc)
                          (c4-cc! (list '- gc 0))
                          (dk-have! (list '= (list '- gc 0) gc) (lambda () (crs)))
                          (let* ((h2 (dk-rewrite-h! h1 (list 'magnitude (list '- 0 gc)) (list 'magnitude (list '- gc 0))))
                                 (h3 (dk-rewrite-h! h2 (list '- gc 0) gc)))
                            (dk-absurd! h3 (list '< 0 Kc) (list 'IN Kc 'RR))))))))
                (K r0 B)))))))))


(define c4g-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (c4g-pow-succ! a n)            ; a in CC, n in NN: land a^succ(n) = a * a^n
  (c4-cc! a) (c4-nn! n)
  (c4-and! (list 'IN a 'CC) (list 'IN n 'NN))
  (dk-cite! 'power-succ a n))
(define (c4g-carr-typ! lam d)
  (if (not (dk-asm? '(== (CARR CC-NORMED-FIELD) CC))) (fact 'cc-nf-carr))
  (dk-have! (list 'IN lam (list 'FUN d '(CARR CC-NORMED-FIELD)))
    (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass))))
(define (c4g-cc-setup!)
  (fact 'cc-is-set) (fact 'cc-is-normed-field) (fact 'nf-cc-is-metric-space)
  (fact 'rr-zero-in) (fact 'cc-zero-in) (fact 'rr-one-in) (fact 'cc-one-in) (fact 'nn-zero-in))
(define (c4-recip-nz! a)               ; a in CC, a /= 0 in context: NOT (recip a = 0)
  (c4-cc! a)
  (let ((goal (list 'NOT (list '= (list 'recip a) 0))))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (di)
            (c4-and! (list 'IN a 'CC) (list 'NOT (list '= a 0)))
            (fact 'cc-recip-inverse a)
            (dk-have! (list '= (list '* a 0) 1) (lambda () (subst (list '= 0 (list 'recip a))) (ass)))
            (dk-have! (list '= 1 0) (lambda () (subst (list '= 1 (list '* a 0))) (crs)))
            (dk-absurd! (list '= 1 0)))))
    goal))
(define (c4-close! closer)             ; capture the focus NOW; the thunk runs CLOSER on the one open leaf below it, if any
  (let ((node (proof-state-focus *ps*)))
    (lambda () (dk-close-on! node closer))))
(define (c4-rw-if! f from to)          ; dk-rewrite-h! when F contains FROM, else F
  (if (dk-contains? f from) (dk-rewrite-h! f from to) f))
(define (c4-ass-focus!)                ; `ass' on the focus leaf when its goal is in context
  (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))

(define (c4g-x-elt! S n)               ; CARD S = succ n in context: an element of S, skolemised
  (dk-have! (list 'FORSOME 'c4gx_ (list 'IN 'c4gx_ S))
    (lambda ()
      (use-em (list 'FORSOME 'c4gx_ (list 'IN 'c4gx_ S))
        (lambda () (ass))
        (lambda ()
          (let ((ce (dk-cite! 'class-extensionality S 'EMPTY-SET)))
            (dk-have! (cadr ce) (lambda () (let ((y (begin (di) (cadr (cadr (dk-goal))))))
                                             (fact 'empty-set-has-no-members y)
                                             (dk-have! (list 'NOT (list 'IN y S)) (lambda () (di) (dk-have! (list 'FORSOME 'c4gx_ (list 'IN 'c4gx_ S)) (lambda () (ew y) (ass))) (ai (list 'NOT (list 'FORSOME 'c4gx_ (list 'IN 'c4gx_ S))))))
                                             (prop))))
            (dk-landed-1 (lambda () (detach! ce)))
            (fact 'card-empty)
            (dk-have! (list '= (list 'succ n) 0)
              (lambda () (subst (list '= (list 'succ n) (list 'CARD S))) (subst (list '= S 'EMPTY-SET)) (ass)))
            (c4-rr! (list 'succ n))
            (dk-have! (list '< 0 (list 'succ n)) (lambda () (dk-nn!)))
            (dk-absurd! (list '< 0 (list 'succ n)) (list '= (list 'succ n) 0) (list 'IN (list 'succ n) 'RR)))))))
  (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (eq? (cadr fm) 'c4gx_))) "an element")))

(define (c4m-PB a r) (list 'DIFFERENCE (list 'BALL 'CC-MS a r) (list 'SINGLETON a)))
(define (c4m-restrict! B1 g B)         ; HOLOMORPHIC-ON(B1, g), B open inside B1: a name for RESTRICT(g, B)
  (let* ((R (list 'RESTRICT g B)))
    (dk-cite! 'holomorphic-on-restrict B1 g B)
    (dk-cite! 'holomorphic-on-in-fun B R)
    (let ((n (dk-name! R (list 'FUN B 'CC))))
      (dk-rewrite-h! (list 'HOLOMORPHIC-ON B R) R n)
      n)))
(define (c4m-rval! n g B z)            ; z in B: n z = g z
  (let ((goal (list '= (list n z) (list g z))))
    (if (not (dk-asm? goal))
        (dk-have! goal (lambda () (let ((fin (c4-close! rfl)))
                                    (subst (list '= n (list 'RESTRICT g B))) (fact 'restrict-apply g B z)
                                    (subst (list '== (list (list 'RESTRICT g B) z) (list g z))) (fin)))))
    goal))
(define (c4m-names! ts)                ; name each typed term of TS in CC, rewrite it in the goal; return the names
  (map (lambda (t) (let ((v (c4-cc-name! t))) (if (dk-contains? (dk-goal) t) (subst (list '= t v))) v)) ts))

(define (c4c-tr-pt! p s t v)           ; p in FUN(CCINT(s, t), CC), v in CCINT(s, t): p v in TRACE(p, s, t)
  (let* ((I (list 'CCINT s t)) (pv (list p v)) (tr (list 'TRACE p s t)) (goal (list 'IN pv tr)))
    (if (not (dk-asm? goal))
        (begin
          (fact 'fun-apply-type-c p I 'CC v)
          (fact 'membership-implies-sethood pv 'CC)
          (let ((iff (dk-cite! 'image-membership-iff p I pv)))
            (dk-have! (list 'IN pv (list 'IMAGE p I))
              (lambda () (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew v) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))))))
                         (prop))))
          (fact 'trace-unfold p s t)
          (dk-have! goal (lambda () (let ((fin (c4-close! ass))) (subst (list '= tr (list 'IMAGE p I))) (fin))))))
    goal))
(define (c4c-ends-at! s t)             ; the ends s, t in CCINT(s, t) (s < t derivable by ineq from context)
  (for-each (lambda (v)
              (let ((goal (list 'IN v (list 'CCINT s t))))
                (if (not (dk-asm? goal))
                    (dk-have! goal
                      (lambda () (mac 'ccint-membership)
                                 (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass)
                                                               (apply dk-ineq! (filter dk-asm? (list (list '< s t) (list 'IN s 'RR) (list 'IN t 'RR) '(< 0 PI) '(IN PI RR))))))))))))
            (list s t)))
(define (c4-union-sub! A B U)          ; A, B inside U: their union inside U (by cases, no landed implication)
  (dk-have! (list 'SUBSET (list 'UNION A B) U)
    (lambda () (let* ((x (subset-by-element!)) (i1 (dk-cite! 'union-membership A B x)))
                 (use-em (list 'IN x A)
                   (lambda () (fact 'subset-mem-fwd A U x) ((c4-close! ass)))
                   (lambda () (dk-have! (list 'IN x B) (lambda () (c4-only-prop! i1 (list 'IN x (list 'UNION A B)) (list 'NOT (list 'IN x A)))))
                              (fact 'subset-mem-fwd B U x) ((c4-close! ass))))))))
(define (c4-sub-imp! A B z)            ; A inside B: land (IMPLIES (IN z A) (IN z B)) and return it
  (let ((f (list 'IMPLIES (list 'IN z A) (list 'IN z B))))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (di) (fact 'subset-mem-fwd A B z) ((c4-close! ass)))))
    f))
;;; ===============================================================================================================
;;; (1) AN OPEN SET MINUS A FINITE SET IS OPEN.  Induction on the cardinality: remove one point at a time
;;;     (cif-open-minus-point), u \ S = (u \ (S \ {x})) \ {x} by extensionality.
;;; ===============================================================================================================


(define (c4g-goal S) (list 'IS-OPEN c4g-nfm (list 'DIFFERENCE 'u S)))
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN c4g-nfm 'u)
  (list 'FORALL 'c4gn_ (list 'IMPLIES '(IN c4gn_ NN)
    (list 'FORALL 'c4gs_ (c4-imps (list '(IN c4gs_ SET) '(= (CARD c4gs_) c4gn_) '(SUBSET c4gs_ CC)) (c4g-goal 'c4gs_)))))))))
(di) (di)
(fact 'empty-set-is-set)
(define c4g-ind (use-induction))
(define c4g-n (cdr (assq 'var c4g-ind)))
(define c4g-ih (cdr (assq 'ih c4g-ind)))
;; step: CARD S = succ n
(let* ((S (cadr (dk-goal))))
  (di) (di) (di)
  (fact 'nn-succ-closed c4g-n)
  (let* ((x (c4g-x-elt! S c4g-n))
         (S1 (list 'DIFFERENCE S (list 'PAIR x x)))
         (D1 (list 'DIFFERENCE 'u S1)))
    (fact 'membership-implies-sethood x S)
    (c4-and! (list 'IN x 'SET) (list 'IN x 'SET))
    (fact 'pairing x x)
    (dk-cite! 'difference-set S (list 'PAIR x x))
    (dk-cite! 'remove-restore S x)
    (let ((dm (dk-cite! 'difference-membership S (list 'PAIR x x) x)) (pm (dk-cite! 'pairing-membership x x x)))
      (dk-have! (list '= x x) (lambda () (rfl)))
      (dk-have! (list 'NOT (list 'IN x S1)) (lambda () (prop))))
    (c4-and! (list 'IN x 'SET) (list 'NOT (list 'IN x S1)))
    (dk-have! (list '= (list 'CARD (list 'UNION S1 (list 'PAIR x x))) (list 'succ c4g-n))
      (lambda () (subst (list '= (list 'UNION S1 (list 'PAIR x x)) S)) (ass)))
    (dk-cite! 'card-insert-converse S1 x c4g-n)
    (dk-have! (list 'SUBSET S1 'CC)
      (lambda () (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
                   (let ((dm (dk-cite! 'difference-membership S (list 'PAIR x x) y))) (dk-have! (list 'IN y S) (lambda () (prop))))
                   (fact 'subset-mem-fwd S 'CC y) (if (not (sequent-node-grounded? leaf)) (ass)))))
    (dk-apply! c4g-ih S1)
    (fact 'subset-mem-fwd S 'CC x)
    (let* ((op1 (c4-inst! (dk-cite! 'cif-open-minus-point D1) x))
           (D2 (list 'DIFFERENCE D1 (list 'SINGLETON x)))
           (eqn (list '= (list 'DIFFERENCE 'u S) D2))
           (ce (dk-cite! 'class-extensionality (list 'DIFFERENCE 'u S) D2)))
      (dk-have! (cadr ce)
        (lambda ()
          (let* ((z (begin (di) (cadr (cadr (dk-goal))))))
            (let* ((i1 (dk-cite! 'difference-membership 'u S z))
                   (i2 (dk-cite! 'difference-membership D1 (list 'SINGLETON x) z))
                   (i3 (dk-cite! 'difference-membership 'u S1 z))
                   (i4 (dk-cite! 'difference-membership S (list 'PAIR x x) z))
                   (i5 (dk-cite! 'pairing-membership x x z))
                   (i6 (dk-cite! 'singleton-membership x z))
                   (i7 (dk-cite! 'membership-implies-sethood z S))
                   (i8 (begin (dk-have! (list 'IMPLIES (list '= z x) (list 'IN z S)) (lambda () (di) (subst (list '= z x)) (ass)))
                              (list 'IMPLIES (list '= z x) (list 'IN z S)))))
              (c4-only-prop! i1 i2 i3 i4 i5 i6 i7 i8 (list 'IN x S))))))
      (dk-landed-1 (lambda () (detach! ce)))
      (subst eqn)
      (c4-ass-focus!))))
;; base: CARD S = 0, S is empty
(dk-focus! (cdr (assq 'base c4g-ind)))
(let* ((S (cadr (dk-goal))))
  (di) (di) (di)
  (dk-cite! 'card-zero-is-empty S)
  (subst (list '= S 'EMPTY-SET))
  (let ((ce (dk-cite! 'class-extensionality '(DIFFERENCE u EMPTY-SET) 'u)))
    (dk-have! (cadr ce)
      (lambda ()
        (let* ((z (begin (di) (cadr (cadr (dk-goal))))))
          (let* ((i1 (dk-cite! 'difference-membership 'u 'EMPTY-SET z))
                 (i2 (begin (fact 'empty-set-has-no-members z) (list 'NOT (list 'IN z 'EMPTY-SET)))))
            (c4-only-prop! i1 i2)))))
    (dk-landed-1 (lambda () (detach! ce)))
    (subst '(= (DIFFERENCE u EMPTY-SET) u))
    (c4-ass-focus!)))
(c4-dump-open!)
(qed 'cc-open-minus-finite-induction)

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN c4g-nfm 'u)
  (list 'FORALL 'c4gs_ (c4-imps (list '(IN c4gs_ SET) '(IN (CARD c4gs_) NN) '(SUBSET c4gs_ CC)) (c4g-goal 'c4gs_)))))))
