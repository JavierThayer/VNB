(define c4r-LDh (list-ref (caddr (caddr c4r-comp)) 1))
(define c4r-LFV (list 'VNB-LAMBDA 'c4rfz_ c4r-V (list '* (list 'DERIV-ON 'CC-NORMED-FIELD c4r-Uf 'f 'c4rfz_) '(recip (f c4rfz_)))))
(define c4r-LGV (list 'VNB-LAMBDA 'c4rgz_ c4r-V (list '* (list 'DERIV-ON 'CC-NORMED-FIELD c4r-Ug 'g 'c4rgz_) '(recip (g c4rgz_)))))
(define c4r-NG (list 'VNB-LAMBDA 'c4rnz_ c4r-V (list '* -1 (list '* (list 'DERIV-ON 'CC-NORMED-FIELD c4r-Ug 'g 'c4rnz_) '(recip (g c4rnz_))))))
(define (c4r-holo! lam lam2)           ; HOLOMORPHIC-ON(V, lam) through the named form lam2
  (dk-have! (list 'HOLOMORPHIC-ON c4r-V lam2) (lambda () (dk-holomorphic! c4r-V lam2)))
  (c4-lam-typ! lam c4r-V (lambda (v) (c4r-vals! v)))
  (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ c4r-V) (list '== (list lam 'hbx_) (list lam2 'hbx_))))
    (lambda () (let* ((x (dk-di-var!)) (fin (c4-close! qrfl)))
                 (c4r-vals! x)
                 (c4-lam-b!)
                 (for-each (lambda (pr) (if (dk-contains? (dk-goal) (car pr)) (subst (list '= (car pr) (cadr pr)))))
                           (list (list (list c4r-dfV x) (list 'DERIV-ON 'CC-NORMED-FIELD c4r-Uf 'f x))
                                 (list (list c4r-dgV x) (list 'DERIV-ON 'CC-NORMED-FIELD c4r-Ug 'g x))
                                 (list (list c4r-fV x) (list 'f x))
                                 (list (list c4r-gV x) (list 'g x))))
                 (fin))))
  (dk-cite! 'holomorphic-transfer-ptwise-eq c4r-V lam lam2)
  (dk-cite! 'holomorphic-on-continuous c4r-V lam))
(c4r-holo! c4r-LFV (list 'VNB-LAMBDA 'c4rfw_ c4r-V (list '* (list c4r-dfV 'c4rfw_) (list 'recip (list c4r-fV 'c4rfw_)))))
(c4r-holo! c4r-LGV (list 'VNB-LAMBDA 'c4rgw_ c4r-V (list '* (list c4r-dgV 'c4rgw_) (list 'recip (list c4r-gV 'c4rgw_)))))
(c4r-holo! c4r-NG (list 'VNB-LAMBDA 'c4rnw_ c4r-V (list '* -1 (list '* (list c4r-dgV 'c4rnw_) (list 'recip (list c4r-gV 'c4rnw_))))))
(define (c4r-dh! z)                    ; z in V: DERIV-ON(V, hn, z) = L landed, L returned
  (c4r-hval! z)
  (let* ((sf (c4-inst! (dk-cite! 'diff-on-shrink 'CC-NORMED-FIELD c4r-Uf 'f z (list 'DERIV-ON 'CC-NORMED-FIELD c4r-Uf 'f z)) c4r-V))
         (sg (c4-inst! (dk-cite! 'diff-on-shrink 'CC-NORMED-FIELD c4r-Ug 'g z (list 'DERIV-ON 'CC-NORMED-FIELD c4r-Ug 'g z)) c4r-V)))
    (dk-rewrite-h! sf (list 'RESTRICT 'f c4r-V) c4r-fV)
    (dk-rewrite-h! sg (list 'RESTRICT 'g c4r-V) c4r-gV)
    (let* ((dh (dk-diff! c4r-V c4r-h z)) (L (list-ref dh 5)))
      (dk-rewrite-h! dh c4r-h c4r-hn)
      (dk-cite! 'cc-deriv-on-of-is-diff-on c4r-V c4r-hn z L)
      L)))
(c4-lam-typ! c4r-LDh c4r-V
  (lambda (v) (let ((L (c4r-dh! v)))
                (c4-cc! L)
                (dk-have! (list 'IN (list 'DERIV-ON 'CC-NORMED-FIELD c4r-V c4r-hn v) 'CC)
                  (lambda () (let ((fin (c4-close! ass))) (subst (list '= (list 'DERIV-ON 'CC-NORMED-FIELD c4r-V c4r-hn v) L)) (fin))))
                (dk-have! (list 'NOT (list '= (list '- (list c4r-hn v) 0) 0))
                  (lambda () (let ((fin (c4-close! ass))) (dk-have! (list '= (list '- (list c4r-hn v) 0) (list c4r-hn v)) (lambda () (crs)))
                               (subst (list '= (list '- (list c4r-hn v) 0) (list c4r-hn v))) (fin))))
                (c4-cc! (list 'recip (list '- (list c4r-hn v) 0))))))
(dk-have! (list 'FORALL 'liz_ (list 'IMPLIES (list 'IN 'liz_ c4r-V) (list '== (list c4r-LDh 'liz_) (list '+ (list c4r-LFV 'liz_) (list c4r-NG 'liz_)))))
  (lambda ()
    (let* ((z (dk-di-var!)) (fin (c4-close! qrfl)) (L (c4r-dh! z))
           (Fz (list 'f z)) (Gz (list 'g z))
           (Df (list 'DERIV-ON 'CC-NORMED-FIELD c4r-Uf 'f z)) (Dg (list 'DERIV-ON 'CC-NORMED-FIELD c4r-Ug 'g z)))
      (c4-lam-b!)
      (subst (list '= (list 'DERIV-ON 'CC-NORMED-FIELD c4r-V c4r-hn z) L))
      (subst (list '= (list c4r-hn z) (list '* Fz (list 'recip Gz))))
      (for-each (lambda (pr) (if (dk-contains? (dk-goal) (car pr)) (subst (list '= (car pr) (cadr pr)))))
                (list (list (list c4r-fV z) Fz) (list (list c4r-gV z) Gz)))
      (let* ((Fv (c4-cc-name! Fz)) (Gv (c4-cc-name! Gz)) (Dfv (c4-cc-name! Df)) (Dgv (c4-cc-name! Dg)))
        (subst (list '= Df Dfv)) (subst (list '= Dg Dgv)) (subst (list '= Fz Fv)) (subst (list '= Gz Gv))
        (let* ((n1 (dk-rewrite-h! (list 'NOT (list '= Fz 0)) Fz Fv))
               (n2 (dk-rewrite-h! (list 'NOT (list '= Gz 0)) Gz Gv)))
          (c4-and! (list 'IN Gv 'CC) (list 'IN Gv 'CC))
          (dk-cite! 'cc-mul-nonzero Gv Gv)
          (c4-recip-nz! Gv)
          (c4-cc! (list 'recip Gv))
          (dk-cite! 'cc-mul-nonzero Fv (list 'recip Gv))
          (c4-cc! (list '* Fv (list 'recip Gv)))
          (dk-have! (list 'NOT (list '= (list '- (list '* Fv (list 'recip Gv)) 0) 0))
            (lambda () (let ((fin2 (c4-close! ass)))
                         (dk-have! (list '= (list '- (list '* Fv (list 'recip Gv)) 0) (list '* Fv (list 'recip Gv))) (lambda () (dk-field-eq! 'CC)))
                         (subst (list '= (list '- (list '* Fv (list 'recip Gv)) 0) (list '* Fv (list 'recip Gv))))
                         (fin2))))
          (let ((lhs (cadr (dk-goal))) (rhs (caddr (dk-goal))))
            (dk-have! (list '= lhs rhs) (lambda () (dk-field-eq! 'CC)))
            (subst (list '= lhs rhs)))
          (fin))))))
;; the integrals
(define c4r-LIh (list 'LINE-INT c4r-LDh 'mdp_ 'mdq_ 'mds_ 'mdt_))
(define c4r-LIVf (list 'LINE-INT c4r-LFV 'mdp_ 'mdq_ 'mds_ 'mdt_))
(define c4r-LIVg (list 'LINE-INT c4r-LGV 'mdp_ 'mdq_ 'mds_ 'mdt_))
(define c4r-LIN (list 'LINE-INT c4r-NG 'mdp_ 'mdq_ 'mds_ 'mdt_))
(define c4r-LIDf (list 'LINE-INT (c4r-LD 'f 'mzf_ 'mpf_) 'mdp_ 'mdq_ 'mds_ 'mdt_))
(define c4r-LIDg (list 'LINE-INT (c4r-LD 'g 'mzg_ 'mpg_) 'mdp_ 'mdq_ 'mds_ 'mdt_))
(dk-cite! 'line-int-in-cc c4r-V c4r-LFV 'mdp_ 'mdq_ 'mds_ 'mdt_)
(dk-cite! 'line-int-in-cc c4r-V c4r-LGV 'mdp_ 'mdq_ 'mds_ 'mdt_)
(dk-cite! 'line-int-in-cc c4r-V c4r-NG 'mdp_ 'mdq_ 'mds_ 'mdt_)
(define c4r-sum (c4-inst! (dk-cite! 'line-int-sum c4r-V c4r-LFV c4r-NG 'mdp_ 'mdq_ 'mds_ 'mdt_) c4r-LDh))
(define c4r-scal
  (begin
    (c4-cc! -1)
    (dk-have! (list 'FORALL 'liz_ (list 'IMPLIES (list 'IN 'liz_ c4r-V) (list '== (list c4r-NG 'liz_) (list '* -1 (list c4r-LGV 'liz_)))))
      (lambda () (let* ((z (dk-di-var!)) (fin (c4-close! qrfl))) (c4r-vals! z) (c4-lam-b!) (fin))))
    (c4-inst! (dk-cite! 'line-int-scalar c4r-V c4r-LGV 'mdp_ 'mdq_ 'mds_ 'mdt_) -1 c4r-NG)))
(define (c4r-from-D! z D U Ps Zs fn)     ; z in D = u \ (Z u P): z in U = u \ P, fn z /= 0, f'(z) typed
  (let ((is (list (dk-cite! 'difference-membership 'u (list 'UNION Zs Ps) z)
                  (dk-cite! 'union-membership Zs Ps z)
                  (dk-cite! 'difference-membership 'u Ps z))))
    (for-each (lambda (cl) (if (not (dk-asm? cl)) (dk-have! cl (lambda () (apply c4-only-prop! (append is (list (list 'IN z D))))))))
              (list (list 'IN z U) (list 'NOT (list 'IN z Zs))))
    (fact 'subset-mem-fwd U 'CC z)
    (fact 'fun-apply-type-c fn U 'CC z)
    (if (not (dk-asm? (list 'NOT (list '= (list fn z) 0))))
        (dk-have! (list 'NOT (list '= (list fn z) 0))
          (lambda () (di) (c4-inst! (dk-ctx-form (c4r-H4 fn Zs Ps)) z) (ai (list 'NOT (list 'IN z Zs))))))
    (c4-dz! U fn z)
    (c4-cc! (list 'recip (list fn z)))))
(define (c4r-dcong! fn Zs Ps LV)         ; LINE-INT(LD_fn) = LINE-INT(LV), LV the same quotient on V
  (let* ((D (c4r-D Zs Ps)) (U (c4r-U Ps)) (LD (c4r-LD fn Zs Ps)))
    (c4-lam-typ! LD D (lambda (v) (c4r-from-D! v D U Ps Zs fn)))
    (dk-cite! 'cc-open-subset-cc U)
    (dk-have! (list 'FORALL 'wnx_ (list 'IMPLIES (list 'IN 'wnx_ c4r-TR) (list '== (list LD 'wnx_) (list LV 'wnx_))))
      (lambda () (let* ((z (dk-di-var!)) (fin (c4-close! qrfl)))
                   (fact 'subset-mem-fwd c4r-TR c4r-V z) (fact 'subset-mem-fwd c4r-TR D z)
                   (c4r-vals! z)
                   (c4-lam-b!)
                   (fin))))
    (c4-inst! (dk-cite! 'line-int-domain-congruence c4r-V LV) 'mdp_ 'mdq_ 'mds_ 'mdt_ D LD)))
(define c4r-cf (c4r-dcong! 'f 'mzf_ 'mpf_ c4r-LFV))
(define c4r-cg (c4r-dcong! 'g 'mzg_ 'mpg_ c4r-LGV))
;; 0 = ind(h o gamma, 0) = (1 / 2 pi i) (int_V f'/f - int_V g'/g)
(define c4r-WT (cadr c4r-W0))
(dk-have! (list '= (list '* c4r-rt c4r-LIh) 0)
  (lambda () (let ((fin (c4-close! ass))) (subst (list '= (list '* c4r-rt c4r-LIh) c4r-WT)) (fin))))
(let* ((a (c4-cc-name! c4r-LIVf)) (b (c4-cc-name! c4r-LIVg)) (r (c4-cc-name! c4r-rt))
       (e0 (dk-rewrite-h! (list '= (list '* c4r-rt c4r-LIh) 0) c4r-LIh (list '+ c4r-LIVf c4r-LIN)))
       (e1 (dk-rewrite-h! e0 c4r-LIN (list '* -1 c4r-LIVg)))
       (e2 (dk-rewrite-h! e1 c4r-LIVf a))
       (e3 (dk-rewrite-h! e2 c4r-LIVg b))
       (e4 (dk-rewrite-h! e3 c4r-rt r))
       (ab (list '- a b)))
  (c4-cc! ab)
  (dk-rewrite-h! (list 'NOT (list '= c4r-rt 0)) c4r-rt r)
  (dk-have! (list '= (list '* ab r) 0)
    (lambda () (let ((fin (c4-close! ass)))
                 (dk-have! (list '= (list '* ab r) (list '* r (list '+ a (list '* -1 b)))) (lambda () (crs)))
                 (subst (list '= (list '* ab r) (list '* r (list '+ a (list '* -1 b)))))
                 (fin))))
  (dk-cite! 'cc-mul-zero-left ab r)
  (dk-cite! 'cc-sub-zero-eq a b)
  (dk-have! (list '= c4r-LIVf c4r-LIVg)
    (lambda () (let ((fin (c4-close! ass))) (subst (list '= c4r-LIVf a)) (subst (list '= c4r-LIVg b)) (fin)))))
;; the argument principle on both sides
(let* ((Sf (c4r-S 'f 'mzf_ 'mpf_)) (Sg (c4r-S 'g 'mzg_ 'mpg_)) (fin (c4-close! rfl)))
  (subst (list '= Sf (list '* c4r-rt c4r-LIDf)))
  (subst (list '= c4r-LIDf c4r-LIVf))
  (subst (list '= c4r-LIVf c4r-LIVg))
  (subst (list '= c4r-LIVg c4r-LIDg))
  (subst (list '= (list '* c4r-rt c4r-LIDg) Sg))
  (fin))
(c4-dump-open!)
(qed 'rouche-theorem)

;;; ===============================================================================================================
;;; (11) PROPOSITION 4.12 (M(U) is a field), at a point: if f and g are meromorphic at a, so are f + g and f g
;;;      (any function agreeing with them on a punctured ball about a); if f is meromorphic at a and not
;;;      identically zero near a, then f has no zero on some punctured ball about a, and 1/f is meromorphic at a
;;;      (Example 4.8).  With f = (1/(z - a))^N g1, g = (1/(z - a))^M g2 near a:
;;;        f + g = (1/(z - a))^(N+M) ((z - a)^M g1 + (z - a)^N g2),     f g = (1/(z - a))^(N+M) g1 g2,
;;;        g1 = (z - a)^k h (zero-order-exists on the ball), h /= 0 near a,  1/f = (1/(z - a))^k ((z - a)^N / h).
;;; ===============================================================================================================

(define (c4m-mer-data! fn)             ; IS-MEROMORPHIC-AT(fn, a) in context: (N r g law), ball set up
  (c4-unfold! 'is-meromorphic-at (list fn 'a) (list 'IS-MEROMORPHIC-AT fn 'a))
  (let* ((N (c4-sk! 'mrn)) (_ (dk-split-all!))
         (r (c4-sk! 'mrr N)) (_ (dk-split-all!))
         (g (c4-sk! 'mrg r)) (_ (dk-split-all!))
         (law (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm g) (dk-contains? fm 'power) (dk-contains? fm fn))) "the meromorphic law")))
    (c4-ball-setup! 'a r)
    (dk-cite! 'holomorphic-on-in-fun (c4-B 'a r) g)
    (list N r g law)))
(define (c4m-min3! r1 r2 r3 K)         ; K on r0 with 0 < r0, r0 <= r1, r2, r3
  (c4-min! r1 r2
    (lambda (r12)
      (c4-min! r12 r3
        (lambda (r0)
          (for-each (lambda (r) (if (not (dk-asm? (list '<= r0 r)))
                                    (dk-have! (list '<= r0 r) (lambda () (dk-ineq! (dk-ctx-form (list '<= r0 r12)) (dk-ctx-form (list '<= r12 r))
                                                                                 (list 'IN r0 'RR) (list 'IN r12 'RR) (list 'IN r 'RR))))))
                    (list r1 r2))
          (K r0))))))


(define (c4m-pow! B k)                 ; (name . lambda) for z |-> (z - a)^k on B, holomorphic
  (let* ((pw (list 'VNB-LAMBDA 'zlx_ B (list 'power '(- zlx_ a) k))))
    (dk-cite! 'pow-sub-holomorphic k B 'a)
    (dk-cite! 'holomorphic-on-in-fun B pw)
    (let ((n (dk-name! pw (list 'FUN B 'CC))))
      (dk-rewrite-h! (list 'HOLOMORPHIC-ON B pw) pw n)
      (cons n pw))))
(define (c4m-pval! np k z)             ; z in B: n z = (z - a)^k
  (let ((goal (list '= (list (car np) z) (list 'power (list '- z 'a) k))))
    (if (not (dk-asm? goal))
        (dk-have! goal (lambda () (let ((fin (c4-close! rfl))) (subst (list '= (car np) (cdr np))) (c4-lam-b!) (fin)))))
    goal))

(define (c4m-agree s op)
  (list 'FORSOME 'c4mr_ (list 'AND '(IN c4mr_ RR) (list 'AND '(< 0 c4mr_)
    (list 'FORALL 'c4mz_ (list 'IMPLIES (list 'IN 'c4mz_ (c4m-PB 'a 'c4mr_)) (list '= (list s 'c4mz_) (list op '(f c4mz_) '(g c4mz_)))))))))
(define (c4m-binop! op)                ; the sum (op = +) or the product (op = *)
  (dk-peel!)
  (c4g-cc-setup!)
  (let* ((df (c4m-mer-data! 'f)) (dg (c4m-mer-data! 'g))
         (N (car df)) (r1 (cadr df)) (g1 (caddr df)) (law1 (cadddr df))
         (M (car dg)) (r2 (cadr dg)) (g2 (caddr dg)) (law2 (cadddr dg))
         (r3 (dk-skolem! (dk-ctx-form (c4m-agree 'c4ms_ op))))
         (_ (dk-split-all!))
         (law3 (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'c4ms_))) "the agreement law"))
         (B1 (c4-B 'a r1)) (B2 (c4-B 'a r2)) (NM (list '+ N M)))
    (c4-and! (list 'IN N 'NN) (list 'IN M 'NN))
    (fact 'nn-add-closed N M)
    (c4m-min3! r1 r2 r3
      (lambda (r0)
        (let* ((B (c4-B 'a r0)))
          (c4-ball-setup! 'a r0)
          (c4-center-in-ball! 'a r0)
          (dk-cite! 'cc-ms-ball-mono 'a r0 r1) (dk-cite! 'cc-ms-ball-mono 'a r0 r2) (dk-cite! 'cc-ms-ball-mono 'a r0 r3)
          (let* ((g1B (c4m-restrict! B1 g1 B)) (g2B (c4m-restrict! B2 g2 B))
                 (pM (c4m-pow! B M)) (pN (c4m-pow! B N))
                 (G (if (eq? op '+)
                        (list 'VNB-LAMBDA 'c4mw_ B (list '+ (list '* (list (car pM) 'c4mw_) (list g1B 'c4mw_)) (list '* (list (car pN) 'c4mw_) (list g2B 'c4mw_))))
                        (list 'VNB-LAMBDA 'c4mw_ B (list '* (list g1B 'c4mw_) (list g2B 'c4mw_))))))
            (dk-have! (list 'HOLOMORPHIC-ON B G) (lambda () (dk-holomorphic! B G)))
            (mac 'IS-MEROMORPHIC-AT)
            (dk-conj-close!
              (lambda ()
                (cond ((dk-asm? (dk-goal)) (ass))
                      ((dk-head-is? (dk-goal) 'FORSOME)
                       (c4-ew-chain-k! (list NM r0 G)
                         (lambda ()
                           (let* ((z (dk-di-var!)) (fin (c4-close! rfl))
                                  (A (list '- z 'a)) (R (list 'recip A)))
                             (c4-pb-open! 'a r0 z)
                             (fact 'subset-mem-fwd B B1 z) (fact 'subset-mem-fwd B B2 z) (fact 'subset-mem-fwd B (c4-B 'a r3) z)
                             (c4-pb-in! 'a r1 z) (c4-pb-in! 'a r2 z) (c4-pb-in! 'a r3 z)
                             (fact 'fun-apply-type-c g1 B1 'CC z) (fact 'fun-apply-type-c g2 B2 'CC z)
                             (c4-cc! R) (c4-cc! (list 'power R N)) (c4-cc! (list 'power R M)) (c4-cc! (list 'power A N)) (c4-cc! (list 'power A M))
                             (c4m-rval! g1B g1 B z) (c4m-rval! g2B g2 B z) (c4m-pval! pM M z) (c4m-pval! pN N z)
                             (let ((l1 (c4-inst! law1 z)) (l2 (c4-inst! law2 z)) (l3 (c4-inst! law3 z)))
                               (c4-lam-b!)
                               (for-each (lambda (e) (if (dk-contains? (dk-goal) (cadr e)) (subst e)))
                                         (list (list '= (list (car pM) z) (list 'power A M)) (list '= (list (car pN) z) (list 'power A N))
                                               (list '= (list g1B z) (list g1 z)) (list '= (list g2B z) (list g2 z))))
                               (subst l3) (subst l1) (subst l2)
                               (subst (dk-cite! 'cc-power-add M N R))
                               (if (eq? op '+)
                                   (let* ((c1 (c4-inst! (dk-cite! 'lc-power-cancel A) M))
                                          (c2 (c4-inst! (dk-cite! 'lc-power-cancel A) N))
                                          (ts (list (list 'power R N) (list 'power R M) (list 'power A N) (list 'power A M) (list g1 z) (list g2 z)))
                                          (vs (c4m-names! ts))
                                          (RN (list-ref vs 0)) (RM (list-ref vs 1)) (AN (list-ref vs 2)) (AM (list-ref vs 3)) (Gv1 (list-ref vs 4)) (Gv2 (list-ref vs 5))
                                          (ren (lambda (f0) (let loop ((f f0) (ps (map cons ts vs)))
                                                              (if (null? ps) f (loop (c4-rw-if! f (caar ps) (cdar ps)) (cdr ps))))))
                                          (c1v (ren c1)) (c2v (ren c2))
                                          (rhs (caddr (dk-goal)))
                                          (X (list '+ (list '* (list '* RN Gv1) (list '* AM RM)) (list '* (list '* RM Gv2) (list '* AN RN)))))
                                     (dk-have! (list '= rhs X) (lambda () (crs)))
                                     (subst (list '= rhs X))
                                     (subst (list '= (list '* AM RM) 1))
                                     (subst (list '= (list '* AN RN) 1))
                                     (crs))
                                   (begin
                                     (c4m-names! (list (list 'power R N) (list 'power R M) (list g1 z) (list g2 z)))
                                     (crs))))
                             (fin)))))
                      (#t (error "c4m: open conjunct" (dk-goal))))))))))))
(sp (make-wff (list 'FORALL 'f (list 'FORALL 'g (list 'FORALL 'c4ms_ (list 'FORALL 'a
  (c4-imps (list '(IS-MEROMORPHIC-AT f a) '(IS-MEROMORPHIC-AT g a) (c4m-agree 'c4ms_ '+)) '(IS-MEROMORPHIC-AT c4ms_ a))))))))
(c4m-binop! '+)
(c4-dump-open!)
(qed 'meromorphic-at-sum)
(sp (make-wff (list 'FORALL 'f (list 'FORALL 'g (list 'FORALL 'c4ms_ (list 'FORALL 'a
  (c4-imps (list '(IS-MEROMORPHIC-AT f a) '(IS-MEROMORPHIC-AT g a) (c4m-agree 'c4ms_ '*)) '(IS-MEROMORPHIC-AT c4ms_ a))))))))
(c4m-binop! '*)
(c4-dump-open!)
(qed 'meromorphic-at-product)

(define c4m-nz-near '(FORALL c4mr_ (IMPLIES (IN c4mr_ RR) (IMPLIES (< 0 c4mr_)
                       (FORSOME c4mz_ (AND (IN c4mz_ (DIFFERENCE (BALL CC-MS a c4mr_) (SINGLETON a))) (NOT (= (f c4mz_) 0))))))))
(define (c4m-recip-concl p)
  (list 'AND (list 'FORALL 'c4mz_ (list 'IMPLIES (list 'IN 'c4mz_ (c4m-PB 'a p)) '(NOT (= (f c4mz_) 0))))
    (list 'FORALL 'c4ms_ (list 'IMPLIES (list 'FORALL 'c4mz_ (list 'IMPLIES (list 'IN 'c4mz_ (c4m-PB 'a p)) '(= (c4ms_ c4mz_) (recip (f c4mz_)))))
                               '(IS-MEROMORPHIC-AT c4ms_ a)))))
(sp (make-wff (list 'FORALL 'f (list 'FORALL 'a (c4-imps (list '(IS-MEROMORPHIC-AT f a) c4m-nz-near)
  (list 'FORSOME 'c4mp_ (list 'AND '(IN c4mp_ RR) (list 'AND '(< 0 c4mp_) (c4m-recip-concl 'c4mp_)))))))))
(dk-peel!)
(c4g-cc-setup!)
(let* ((df (c4m-mer-data! 'f)) (N (car df)) (r1 (cadr df)) (g1 (caddr df)) (law1 (cadddr df)) (B1 (c4-B 'a r1)))
  (c4-center-in-ball! 'a r1)
  (dk-cite! 'cc-ball-connected 'a r1)
  ;; g1 is not identically zero on B1
  (let* ((z0 (dk-skolem! (c4-inst! (dk-ctx-form c4m-nz-near) r1)))
         (_ (dk-split-all!)))
    (c4-pb-open! 'a r1 z0)
    (fact 'fun-apply-type-c g1 B1 'CC z0)
    (c4-cc! (list 'power (list 'recip (list '- z0 'a)) N))
    (let ((l0 (c4-inst! law1 z0)))
      (dk-have! (list 'NOT (list '= (list g1 z0) 0))
        (lambda ()
          (di)
          (dk-have! (list '= (list 'f z0) 0)
            (lambda () (let ((fin (c4-close! ass)))
                         (subst l0) (subst (list '= (list g1 z0) 0))
                         (let ((v (c4-cc-name! (list 'power (list 'recip (list '- z0 'a)) N)))) (subst (list '= (list 'power (list 'recip (list '- z0 'a)) N) v)) (crs))
                         (fin))))
          (ai (list 'NOT (list '= (list 'f z0) 0))))))
    (dk-have! (list 'FORSOME 'zlw_ (list 'AND (list 'IN 'zlw_ B1) (list 'NOT (list '= (list g1 'zlw_) 0))))
      (lambda () (ew z0) (dk-conj-close! (lambda () (ass))))))
  ;; g1 = (z - a)^k h on B1, h(a) /= 0
  (let* ((k (dk-skolem! (c4-inst! (dk-cite! 'zero-order-exists B1 g1) 'a)))
         (_ (dk-split-all!))
         (_ (c4-unfold! 'has-zero-of-order (list B1 g1 'a k) (list 'HAS-ZERO-OF-ORDER B1 g1 'a k)))
         (h (c4-sk! 'zoh))
         (_ (dk-split-all!))
         (lawh (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm h) (dk-contains? fm g1))) "g1 = (z - a)^k h")))
    (dk-cite! 'holomorphic-on-in-fun B1 h)
    (c4-nonzero-ball! B1 'a h
      (lambda (r0 B)
        (let* ((hnz (list 'FORALL 'c4y_ (list 'IMPLIES (list 'IN 'c4y_ B) (list 'NOT (list '= (list h 'c4y_) 0))))))
          (define (pt! z)              ; z in B \ {a}: f z = RN (AK h z), all factors /= 0, f z /= 0
            (let* ((A (list '- z 'a)) (R (list 'recip A)) (RN (list 'power R N)) (AK (list 'power A k)) (hz (list h z))
                   (AKh (list '* AK hz)))
              (c4-pb-open! 'a r0 z)
              (fact 'subset-mem-fwd B B1 z)
              (c4-pb-in! 'a r1 z)
              (fact 'fun-apply-type-c g1 B1 'CC z) (fact 'fun-apply-type-c h B1 'CC z)
              (c4-inst! (dk-ctx-form hnz) z)
              (c4-recip-nz! A)
              (c4-cc! R) (c4-cc! RN) (c4-cc! AK) (c4-cc! AKh)
              (dk-cite! 'cc-power-nonzero N R) (dk-cite! 'cc-power-nonzero k A)
              (dk-cite! 'cc-mul-nonzero AK hz)
              (dk-cite! 'cc-mul-nonzero RN AKh)
              (let* ((l1 (c4-inst! law1 z)) (lh (c4-inst! lawh z))
                     (e (list '= (list 'f z) (list '* RN AKh))))
                (if (not (dk-asm? e)) (dk-have! e (lambda () (let ((fin (c4-close! rfl))) (subst l1) (subst lh) (fin)))))
                (if (not (dk-asm? (list 'NOT (list '= (list 'f z) 0))))
                    (dk-rewrite-h! (list 'NOT (list '= (list '* RN AKh) 0)) (list '* RN AKh) (list 'f z)))
                (list A R RN AK hz e))))
          (ew r0)
          (dk-conj-close!
            (lambda ()
              (cond ((dk-asm? (dk-goal)) (ass))
                    ((and (dk-head-is? (dk-goal) 'FORALL) (not (dk-contains? (dk-goal) 'c4ms_)))
                     (let* ((z (dk-di-var!)) (fin (c4-close! ass))) (pt! z) (fin)))
                    ((dk-head-is? (dk-goal) 'FORALL)
                     (let* ((s (dk-di-var! (lambda (gl) (cadr (caddr gl))))))
                       (di)
                       (let* ((hyp (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm s) (dk-contains? fm 'recip))) "s = 1/f"))
                              (hB (c4m-restrict! B1 h B))
                              (pN (c4m-pow! B N))
                              (G (list 'VNB-LAMBDA 'c4mw_ B (list '* (list (car pN) 'c4mw_) (list 'recip (list hB 'c4mw_))))))
                         (dk-have! (list 'FORALL 'c4y_ (list 'IMPLIES (list 'IN 'c4y_ B) (list 'NOT (list '= (list hB 'c4y_) 0))))
                           (lambda () (let* ((y (dk-di-var!)) (fin (c4-close! ass)))
                                        (fact 'subset-mem-fwd B B1 y)
                                        (c4m-rval! hB h B y)
                                        (subst (list '= (list hB y) (list h y)))
                                        (c4-inst! (dk-ctx-form hnz) y)
                                        (fin))))
                         (dk-have! (list 'HOLOMORPHIC-ON B G) (lambda () (dk-holomorphic! B G)))
                         (mac 'IS-MEROMORPHIC-AT)
                         (dk-conj-close!
                           (lambda ()
                             (cond ((dk-asm? (dk-goal)) (ass))
                                   ((dk-head-is? (dk-goal) 'FORSOME)
                                    (c4-ew-chain-k! (list k r0 G)
                                      (lambda ()
                                        (let* ((z (dk-di-var!)) (fin (c4-close! rfl))
                                               (dat (pt! z)) (A (list-ref dat 0)) (R (list-ref dat 1)) (RN (list-ref dat 2))
                                               (AK (list-ref dat 3)) (hz (list-ref dat 4)) (e (list-ref dat 5))
                                               (AN (list 'power A N)) (RK (list 'power R k)))
                                          (c4-cc! AN) (c4-cc! RK)
                                          (c4m-rval! hB h B z) (c4m-pval! pN N z)
                                          (c4-inst! hyp z)
                                          (c4-lam-b!)
                                          (subst (list '= (list (car pN) z) AN))
                                          (subst (list '= (list hB z) hz))
                                          (subst (list '= (list s z) (list 'recip (list 'f z))))
                                          (subst e)
                                          (let* ((c1 (c4-inst! (dk-cite! 'lc-power-cancel A) N))
                                                 (c2 (c4-inst! (dk-cite! 'lc-power-cancel A) k))
                                                 (D (list '* RN (list '* AK hz)))
                                                 (_ (c4-cc! D))
                                                 (_ (c4-cc! (list 'recip hz)))
                                                 (_ (c4-and! (list 'IN hz 'CC) (list 'NOT (list '= hz 0))))
                                                 (_ (fact 'cc-recip-inverse hz))
                                                 (_ (c4-and! (list 'IN D 'CC) (list 'NOT (list '= D 0))))
                                                 (_ (fact 'cc-recip-inverse D))
                                                 (_ (c4-cc! (list 'recip D)))
                                                 (ts (list (list 'recip D) D (list 'recip hz) RN AK hz AN RK))
                                                 (vs (c4m-names! ts))
                                                 (Di (list-ref vs 0)) (Dv (list-ref vs 1)) (Hi (list-ref vs 2)) (RNv (list-ref vs 3))
                                                 (AKv (list-ref vs 4)) (Hv (list-ref vs 5)) (ANv (list-ref vs 6)) (RKv (list-ref vs 7))
                                                 (ren (lambda (f0) (let loop ((f f0) (ps (map cons ts vs)))
                                                                     (if (null? ps) f (loop (c4-rw-if! f (caar ps) (cdar ps)) (cdr ps))))))
                                                 (c1v (ren c1)) (c2v (ren c2))
                                                 (i1 (ren (list '= (list '* hz (list 'recip hz)) 1)))
                                                 (i2 (ren (list '= (list '* D (list 'recip D)) 1)))
                                                 (X (list '* RKv (list '* ANv Hi))))
                                            ;; the goal is now (= Di X); Dv X = 1, so Di = Di (Dv X) = X
                                            (dk-have! (list '= Dv (list '* RNv (list '* AKv Hv)))
                                              (lambda () (let ((fin2 (c4-close! rfl))) (subst (list '= Dv D)) (subst (list '= RN RNv)) (subst (list '= AK AKv)) (subst (list '= hz Hv)) (fin2))))
                                            (dk-have! (list '= (list '* Dv X) 1)
                                              (lambda () (let ((fin2 (c4-close! rfl)))
                                                           (subst (list '= Dv (list '* RNv (list '* AKv Hv))))
                                                           (dk-have! (list '= (list '* (list '* RNv (list '* AKv Hv)) X) (list '* (list '* ANv RNv) (list '* (list '* AKv RKv) (list '* Hv Hi)))) (lambda () (crs)))
                                                           (subst (list '= (list '* (list '* RNv (list '* AKv Hv)) X) (list '* (list '* ANv RNv) (list '* (list '* AKv RKv) (list '* Hv Hi)))))
                                                           (subst (list '= (list '* ANv RNv) 1)) (subst (list '= (list '* AKv RKv) 1)) (subst (list '= (list '* Hv Hi) 1))
                                                           (crs)
                                                           (fin2))))
                                            (dk-have! (list '= (list '* (list '* Dv Di) X) X)
                                              (lambda () (let ((fin2 (c4-close! rfl))) (subst (list '= (list '* Dv Di) 1)) (crs) (fin2))))
                                            (dk-have! (list '= Di (list '* (list '* Dv Di) X))
                                              (lambda () (let ((fin2 (c4-close! rfl)))
                                                           (dk-have! (list '= (list '* (list '* Dv Di) X) (list '* Di (list '* Dv X))) (lambda () (crs)))
                                                           (subst (list '= (list '* (list '* Dv Di) X) (list '* Di (list '* Dv X))))
                                                           (subst (list '= (list '* Dv X) 1))
                                                           (crs)
                                                           (fin2))))
                                            (subst (list '= Di (list '* (list '* Dv Di) X)))
                                            (subst (list '= (list '* (list '* Dv Di) X) X)))
                                          (fin)))))
                                   (#t (error "c4m-recip: open conjunct (2)" (dk-goal)))))))))
                    (#t (error "c4m-recip: open conjunct" (dk-goal)))))))))))
(c4-dump-open!)
(qed 'meromorphic-at-recip)

;;; ===============================================================================================================
;;; (15) PROPOSITION 4.12 on U: M(U) is closed under the pointwise sum and product.  f holomorphic on u \ A with a
;;;      removable singularity or a pole at each point of A, g likewise with B: f + g and f g, defined on
;;;      u \ (A u B), are meromorphic on u (witness A u B; at each of its points both f and g are meromorphic --
;;;      a point of holomorphy is one -- and meromorphic-at-sum / -product, meromorphic-point-cases apply).
;;; ===============================================================================================================
(sp (make-wff '(FORALL u (FORALL f (IMPLIES (HOLOMORPHIC-ON u f) (FORALL a (IMPLIES (IN a u) (IS-MEROMORPHIC-AT f a))))))))
(dk-peel!)
