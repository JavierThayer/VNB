        (dk-project! (list 'IN inc (list 'FUN (list 'PTS sk) (list 'PTS b6-RRT))) 'is-hom-top-space-def (list 'IS-HOM-TOP-SPACE sk b6-RRT inc))
        (b6-and! (list 'IN pj (list 'FUN (list 'PTS b6-KI) (list 'PTS sk))) (list 'IN inc (list 'FUN (list 'PTS sk) (list 'PTS b6-RRT))))
        (let ((ca (dk-cite! 'compose-apply (list 'PTS b6-KI) (list 'PTS sk) (list 'PTS b6-RRT) inc pj)))
