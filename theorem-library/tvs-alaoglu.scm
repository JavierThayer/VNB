            (lambda () (let ((q (dk-di-var!))) (val! q) (subst (list '= (list cm q) (list q k))) (subst (list '= (list g q) (list q k))) (rfl))))
          (dk-cite! 'hom-top-space-ptwise-eq b6-KI b6-RRT g cm)
          (dk-ass!)))))
  (dk-have! (list 'IS-HOM-TOP-SPACE b6-KI b6-PR b6-JJ) (lambda () (if (dk-only! iff (caddr iff)) (prop)))))
(dk-have! (list 'SUBSET b6-KP (list 'PTS b6-PR)) (lambda () (subst (list '== (list 'PTS b6-PR) b6-PRP)) (dk-ass!)))
