;; a pointwise bounded set of points of the product of lines lies in the product of the intervals
(define b6-pwbd '(FORALL b6y_ (IMPLIES (IN b6y_ ff) (FORALL b6g_ (IMPLIES (IN b6g_ aa) (<= (ABS (b6g_ b6y_)) (rb b6y_)))))))
(define (b6-coord-close! x y)          ; goal (IN (x y) (PTS (IF y))) or a bu-mi leaf: close it from (x y) in iv
  (if (not (dk-ass!))
      (begin (if (dk-contains? (dk-goal) (list b6-IF y)) (subst (b6-ify! y)))
             (if (dk-contains? (dk-goal) (list 'PTS (b6-ify y))) (subst (list '== (list 'PTS (b6-ify y)) (b6-iv y))))
             (dk-ass!))))
(define (b6-into-kp! x coord!)        ; (IN x KP) from x in FUN(ff); COORD! y lands (IN (x y) iv(y))
  (let* ((bur (list 'BIG-UNION 'tpj_ 'ff (list 'PTS (list b6-IF 'tpj_))))
         (im (dk-cite! 'tprod-pts-mem 'ff b6-IF x))
         (fi (dk-cite! 'fun-codomain-iff 'ff bur x)))
    (dk-have! (caddr (caddr fi))
      (lambda () (let ((y (dk-di-var!)))
                   (b6-ify! y) (coord! y)
                   (for-each (lambda (l) (dk-focus! l) (b6-coord-close! x y))
                             (dk-opened (lambda () (bu-mi y)))))))
    (dk-have! (list 'IN x (list 'FUN 'ff bur)) (lambda () (if (dk-only! fi (list 'IN x (list 'FUN 'ff)) (caddr (caddr fi))) (prop))))
    (dk-have! (caddr (caddr im))
      (lambda () (let ((y (dk-di-var!))) (b6-ify! y) (coord! y) (b6-coord-close! x y))))
    (dk-have! (list 'IN x b6-KP) (lambda () (b6-and! (list 'IN x (list 'FUN 'ff bur)) (caddr (caddr im))) (if (dk-only! im (caddr im)) (prop))))))
(define (b6-bounded-coord! x y)        ; x in aa, aa bounded, x in PRP (clause landed): (IN (x y) iv(y))
  (let* ((xy (list x y)) (r (list 'rb y)) (iv (b6-iv y)))
    (if (not (dk-asm? (list 'IN xy iv)))
        (begin
          (dk-apply! (dk-ctx-form b6-pwbd) y x)
          (dk-apply! (b6-pts-out! b6-RF x) y)
          (b6-rfy! y)
          (let* ((h1 (dk-rewrite-h! (list 'IN xy (list 'PTS (list b6-RF y))) (list b6-RF y) b6-RRT)))
            (dk-rewrite-h! h1 (list 'PTS b6-RRT) 'RR))
          (dk-cite! 'fun-apply-type-c 'rb 'ff 'RR y)
          (dk-split! (dk-cite! 'rr-abs-le-parts xy r))
          (let ((cm (dk-cite! 'ccint-membership (list '- r) r xy)))
            (dk-have! (list 'IN xy iv) (lambda () (if (dk-only! cm (list 'IN xy 'RR) (list '<= (list '- r) xy) (list '<= xy r)) (prop)))))))))
(sp (make-wff (b6-alls '(ff rb aa) (b6-imps (append b6-hyp (list (list 'SUBSET 'aa b6-PRP) b6-pwbd)) (list 'SUBSET 'aa b6-KP)))))
(dk-peel!)
(b6-setup!)
(b6-fam-hyps!)
(b6-fam-facts!)
(mac 'subset-def)
(let ((x (dk-di-var!)))
  (dk-cite! 'subset-mem-fwd 'aa b6-PRP x)
  (b6-fun-ff! x b6-RF)
  (b6-into-kp! x (lambda (y) (b6-bounded-coord! x y)))
  (dk-ass!))
(b6-qed! 'pointwise-bounded-in-intervals)

;; each factor [-rb(y), rb(y)] of the interval product is compact (Heine-Borel)
(sp (make-wff (b6-alls '(ff rb) (b6-imps b6-hyp '(FORALL b6i_ (IMPLIES (IN b6i_ ff) (IS-COMPACT-T ((VNB-LAMBDA b6n_ ff (SUBSPACE-TOP (METRIC-TOP RR-MS) (CCINT (- (rb b6n_)) (rb b6n_)))) b6i_))))))))
(dk-peel!)
(let* ((y (cadr (cadr (dk-goal)))) (iv (b6-iv y)) (sm (list 'SUBSPACE-MS 'RR-MS iv)))
  (subst (b6-ify! y))
  (dk-cite! 'r7q-rr-pts)
  (dk-have! (list 'SUBSET iv '(PTS RR-MS)) (lambda () (subst '(= (PTS RR-MS) RR)) (dk-ass!)))
  (dk-cite! 'subspace-top-of-metric-top 'RR-MS iv)
  (subst (list '== (b6-ify y) (list 'METRIC-TOP sm)))
  (dk-apply! (dk-cite! 'subspace-is-metric-space 'RR-MS) iv)
  (dk-cite! 'heine-borel-ccint (list '- (list 'rb y)) (list 'rb y))
  (let ((iff (dk-cite! 'metric-top-compact sm)))
    (if (dk-only! iff (list 'IS-COMPACT sm)) (prop))))
(b6-qed! 'interval-factors-compact)

;; THE THEOREM (the compactness half of Rudin 3.15 / 3.27 in product form): a closed set of points of the product
;; of lines, bounded at each coordinate by rb, is compact in the product (pointwise) topology
(sp (make-wff (b6-alls '(ff rb aa) (b6-imps (append b6-hyp (list (list 'SUBSET 'aa b6-PRP) b6-pwbd (list 'IS-TOP-CLOSED b6-PR 'aa)))
                                           (list 'IS-COMPACT-T (b6-sub b6-PR 'aa))))))
(dk-peel!)
(b6-setup!)
(b6-fam-hyps!)
(b6-fam-facts!)
(let* ((sk (b6-sub b6-PR b6-KP)))
  (dk-cite! 'interval-product-in-lines 'ff 'rb)
  (dk-cite! 'interval-product-identity 'ff 'rb)
  (dk-cite! 'pointwise-bounded-in-intervals 'ff 'rb 'aa)
  (dk-cite! 'interval-factors-compact 'ff 'rb)
  (dk-cite! 'tychonoff 'ff b6-IF)
  (dk-have! (list 'SUBSET b6-KP (list 'PTS b6-PR)) (lambda () (subst (list '== (list 'PTS b6-PR) b6-PRP)) (dk-ass!)))
  (b6-sub-facts! b6-PR b6-KP)
  (dk-have! (list 'FORALL 'tpy_ (list 'IMPLIES (list 'IN 'tpy_ (list 'PTS sk)) (list 'FORSOME 'tpx_ (list 'AND (list 'IN 'tpx_ (list 'PTS b6-KI)) (list '= (list b6-JJ 'tpx_) 'tpy_)))))
    (lambda () (let ((q (dk-di-var!)))
                 (dk-rewrite-h! (list 'IN q (list 'PTS sk)) (list 'PTS sk) b6-KP)
                 (b6-jval! q)
                 (ew q)
                 (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst (list '== (list 'PTS b6-KI) b6-KP)) (dk-ass!))))))))
  (dk-cite! 'compact-t-continuous-onto b6-KI sk b6-JJ)
  (dk-cite! 'closed-in-subspace b6-PR b6-KP 'aa)
  (dk-cite! 'closed-subset-compact sk 'aa)
  (dk-cite! 'subspace-of-subspace b6-PR b6-KP 'aa)
  (subst (list '= (b6-sub b6-PR 'aa) (b6-sub sk 'aa)))
  (dk-ass!))
(b6-qed! 'pointwise-bounded-closed-compact)

;;; ===========================================================================
;;; (3) COORDINATE BALLS OF THE PRODUCT OF LINES R^ff
;;; ===========================================================================
(define (b6-rf-setup!)                 ; the product of lines alone (no rb): family, sets, PTS, top-space
  (b6-rrt!)
  (if (not (dk-asm? (list 'IS-TOP-FAMILY 'ff b6-RF)))
      (dk-have! (list 'IS-TOP-FAMILY 'ff b6-RF)
        (lambda () (mac 'is-top-family) (dk-conj-close! (lambda () (if (not (dk-ass!)) (let ((y (dk-di-var!))) (subst (b6-rfy! y)) (dk-ass!))))))))
  (dk-split! (dk-cite! 'tprod-sets 'ff b6-RF))
  (dk-cite! 'tprod-top-pts 'ff b6-RF)
  (dk-cite! 'tprod-top-is-top-space 'ff b6-RF))
(define (b6-pj x) (list 'TPROJ 'ff b6-RF x))
(define (b6-cb x c e) (list 'PREIMAGE b6-PR (b6-pj x) (list 'BALL 'RR-MS c e)))
(define (b6-line-coord! h x)           ; h in PRP, x in ff: (IN (h x) RR)
  (let ((g (list 'IN (list h x) 'RR)))
    (if (not (dk-asm? g))
        (let ((cl (b6-pts-out! b6-RF h)))
          (dk-apply! cl x)
          (b6-rfy! x)
          (let ((h1 (dk-rewrite-h! (list 'IN (list h x) (list 'PTS (list b6-RF x))) (list b6-RF x) b6-RRT)))
            (dk-rewrite-h! h1 (list 'PTS b6-RRT) 'RR))))
    g))

;; a coordinate ball { h : |c - h(x)| < e } is open in the product of lines
(sp (make-wff (b6-alls '(ff x c e) (b6-imps '((IN ff SET) (IN x ff) (IN c RR) (IN e RR) (< 0 e)) (list 'IN (b6-cb 'x 'c 'e) (list 'OPENS b6-PR))))))
(dk-peel!)
(b6-rf-setup!)
(let* ((pj (b6-pj 'x)) (bl '(BALL RR-MS c e)) (hom (list 'IS-HOM-TOP-SPACE b6-PR b6-RRT pj)))
  (dk-cite! 'tproj-continuous 'ff b6-RF 'x)
  (b6-rfy! 'x)
  (dk-rewrite-h! (list 'IS-HOM-TOP-SPACE b6-PR (list b6-RF 'x) pj) (list b6-RF 'x) b6-RRT)
  (let ((pre (dk-project! (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u (list 'OPENS b6-RRT)) (list 'IN (list 'PREIMAGE b6-PR pj 'u) (list 'OPENS b6-PR))))
                          'is-hom-top-space-def hom)))
    (dk-cite! 'r7q-rr-pts)
    (dk-have! '(IN c (PTS RR-MS)) (lambda () (subst '(= (PTS RR-MS) RR)) (dk-ass!)))
    (dk-pos-parts! 'e)
    (dk-apply! (dk-cite! 'ball-is-open 'RR-MS) 'c 'e)
    (let ((oi (dk-apply! (dk-cite! 'metric-top-opens-iff 'RR-MS) bl)))
      (dk-have! (list 'IN bl (list 'OPENS b6-RRT)) (lambda () (if (dk-only! oi '(IS-OPEN RR-MS (BALL RR-MS c e))) (prop)))))
    (dk-apply! pre bl)
    (dk-ass!)))
(b6-qed! 'line-product-coord-ball-open)

;; membership in a coordinate ball
(sp (make-wff (b6-alls '(ff x c e h) (b6-imps (list '(IN ff SET) '(IN x ff) '(IN c RR) (list 'IN 'h b6-PRP))
                                           (list 'IFF (list 'IN 'h (b6-cb 'x 'c 'e)) '(< (abs (- c (h x))) e))))))
(dk-peel!)
(b6-rf-setup!)
(b6-line-coord! 'h 'x)
(dk-cite! 'r7q-rr-pts)
(dk-cite! 'tproj-value 'ff b6-RF 'x 'h)
(dk-cite! 'rr-ms-dist 'c '(h x))
(let* ((pj (b6-pj 'x)) (bl '(BALL RR-MS c e)) (cb (b6-cb 'x 'c 'e))
       (pm (dk-cite! 'preimage-membership b6-PR pj bl 'h))
       (bm (dk-cite! 'ball-membership 'RR-MS 'c 'e '(h x)))
       (ds '((DIST RR-MS) c (h x))))
  (dk-iff! (lambda (g) (dk-head-is? g '<))
    (lambda ()
      (dk-have! (caddr pm) (lambda () (if (dk-only! pm (list 'IN 'h cb)) (prop))))
      (dk-split! (caddr pm))
      (dk-rewrite-h! (list 'IN (list pj 'h) bl) (list pj 'h) '(h x))
      (dk-have! (caddr bm) (lambda () (if (dk-only! bm '(IN (h x) (BALL RR-MS c e))) (prop))))
      (dk-split-all! (list (caddr bm)))
      (mac '<)
      (dk-conj-close! (lambda () (subst (list '= '(abs (- c (h x))) ds)) (dk-ass!))))
    (lambda ()
      (dk-project! (list 'AND '(<= (abs (- c (h x))) e) '(NOT (= (abs (- c (h x))) e))) (lambda () (mac-h '< (dk-ctx-form '(< (abs (- c (h x))) e)))))
      (dk-split-all! (list (list 'AND '(<= (abs (- c (h x))) e) '(NOT (= (abs (- c (h x))) e)))))
      (dk-have! '(IN (h x) (PTS RR-MS)) (lambda () (subst '(= (PTS RR-MS) RR)) (dk-ass!)))
      (dk-have! (list '<= ds 'e) (lambda () (subst (list '= ds '(abs (- c (h x))))) (dk-ass!)))
      (dk-have! (list 'NOT (list '= ds 'e)) (lambda () (subst (list '= ds '(abs (- c (h x))))) (dk-ass!)))
      (dk-have! '(IN (h x) (BALL RR-MS c e)) (lambda () (if (dk-only! bm '(IN (h x) (PTS RR-MS)) (list '<= ds 'e) (list 'NOT (list '= ds 'e))) (prop))))
      (dk-have! (list 'IN (list pj 'h) bl) (lambda () (subst (list '= (list pj 'h) '(h x))) (dk-ass!)))
      (dk-have! (list 'IN 'h (list 'PTS b6-PR)) (lambda () (subst (list '== (list 'PTS b6-PR) b6-PRP)) (dk-ass!)))
      (if (dk-only! pm (list 'IN 'h (list 'PTS b6-PR)) (list 'IN (list pj 'h) bl)) (prop)))))
(b6-qed! 'line-product-coord-ball-mem)

;;; ===========================================================================
;;; (4) THE NEIGHBOURHOODS THAT SEPARATE A NON-FUNCTIONAL POINT FROM THE POLAR
;;; ===========================================================================
(define (b6-real! t)                   ; (IN t RR) for a term built from typed atoms, coordinates (h x), - + * abs, numbers
  (let ((ty (list 'IN t 'RR)))
    (cond ((dk-asm? ty) ty)
          ((and (number? t) (exact? t)) (dk-have! ty (lambda () (arith))) ty)
          ((dk-head-is? t 'abs) (b6-real! (cadr t)) (dk-cite! 'rr-abs-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 2)) (b6-real! (cadr t)) (dk-cite! 'rr-neg-closed (cadr t)) ty)
          ((and (dk-head-is? t '-) (= (length t) 3))
           (b6-real! (cadr t)) (b6-real! (caddr t)) (dk-cite! 'rr-sub-in-rr (cadr t) (caddr t)) ty)
          ((and (pair? t) (memq (car t) '(+ *)) (= (length t) 3))
           (b6-real! (cadr t)) (b6-real! (caddr t))
           (b6-and! (list 'IN (cadr t) 'RR) (list 'IN (caddr t) 'RR))
           (dk-cite! (if (eq? (car t) '+) 'rr-add-closed 'rr-mul-closed) (cadr t) (caddr t))
           ty)
          ((and (pair? t) (= (length t) 2) (symbol? (car t))) (b6-line-coord! (car t) (cadr t)) ty)
          (#t (dk-type! t) ty))))
(define (b6-cb-open! x c e)            ; c, e typed, (< 0 e) in context: (IN CB (OPENS PR))
  (b6-real! c) (b6-real! e)
  (dk-cite! 'line-product-coord-ball-open 'ff x c e))
(define (b6-cb-iff! h x c e)
  (b6-real! c) (dk-cite! 'line-product-coord-ball-mem 'ff x c e h))
(define (b6-cb-in! h x c e)            ; h in PRP, (< |c - h x| e) in context: (IN h CB)
  (let ((iff (b6-cb-iff! h x c e)))
    (dk-have! (cadr iff) (lambda () (if (dk-only! iff (caddr iff)) (prop))))))
(define (b6-cb-out! h x c e)           ; (IN h CB) in context: (IN h PRP), (IN (h x) RR), (< |c - h x| e)
  (let* ((cb (b6-cb x c e)) (pm (dk-cite! 'preimage-membership b6-PR (b6-pj x) (list 'BALL 'RR-MS c e) h)))
    (dk-have! (caddr pm) (lambda () (if (dk-only! pm (list 'IN h cb)) (prop))))
    (dk-split! (caddr pm))
    (dk-rewrite-h! (list 'IN h (list 'PTS b6-PR)) (list 'PTS b6-PR) b6-PRP)
    (b6-line-coord! h x)
    (let ((iff (b6-cb-iff! h x c e)))
      (dk-have! (caddr iff) (lambda () (if (dk-only! iff (list 'IN h cb)) (prop)))))))
(define (b6-inter-out! h u v)          ; (IN h (INTERSECTION u v)) in context: (IN h u), (IN h v)
  (let ((im (dk-cite! 'intersection-membership u v h)))
    (dk-have! (caddr im) (lambda () (if (dk-only! im (list 'IN h (list 'INTERSECTION u v))) (prop))))
    (dk-split! (caddr im))))
(define (b6-inter-in! h u v)
  (let ((im (dk-cite! 'intersection-membership u v h)))
    (b6-and! (list 'IN h u) (list 'IN h v))
    (dk-have! (cadr im) (lambda () (if (dk-only! im (caddr im)) (prop))))))
(define (b6-pr-inter! u v)             ; u, v open in PR: their intersection is
  (let ((il (dk-project! (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u (list 'OPENS b6-PR)) (list 'FORALL 'v (list 'IMPLIES (list 'IN 'v (list 'OPENS b6-PR)) (list 'IN (list 'INTERSECTION 'u 'v) (list 'OPENS b6-PR))))))
                         'is-top-space (list 'IS-TOP-SPACE b6-PR))))
    (dk-apply! il u v)))
(define (b6-abs-pos! x y)              ; x, y in RR, (NOT (= x y)) in context: (< 0 (abs (- x y)))
  (let ((g (list '< 0 (list 'abs (list '- x y)))))
    (if (not (dk-asm? g))
        (begin
          (b6-real! (list '- x y))
          (dk-cite! 'rr-abs-nonneg (list '- x y))
          (let ((z (dk-cite! 'rr-abs-zero (list '- x y))))
            (dk-have! g
              (lambda ()
                (mac '<)
                (dk-conj-close!
                  (lambda ()
                    (if (not (dk-ass!))
                        (begin
                          (di)
                          (dk-have! (list '= (list 'abs (list '- x y)) 0) (lambda () (dk-ineq! (list '= 0 (list 'abs (list '- x y))))))
                          (dk-have! (list '= (list '- x y) 0) (lambda () (if (dk-only! z (list '= (list 'abs (list '- x y)) 0)) (prop))))
                          (dk-have! (list '= x y) (lambda () (dk-ineq! (list 'IN x 'RR) (list 'IN y 'RR) (list '= (list '- x y) 0))))
                          (ai (list 'NOT (list '= x y))))))))))))
    g))
(define (b6-ex-nbhd p-of) (list 'FORSOME 'b6w_ (list 'AND (list 'IN 'b6w_ (list 'OPENS b6-PR)) (list 'AND '(IN g b6w_)
                            (list 'FORALL 'b6h_ (list 'IMPLIES '(IN b6h_ b6w_) (list 'AND (list 'IN 'b6h_ b6-PRP) (p-of 'b6h_))))))))

(define (b6-abs-lt-in! u e prems)     ; (< (abs u) e) from -e < u < e, each by dk-ineq! over PREMS
  (let ((g (list '< (list 'abs u) e)))
    (if (not (dk-asm? g))
        (begin
          (b6-real! u) (b6-real! e)
          (dk-have! (list '< (list '- e) u) (lambda () (apply dk-ineq! prems)))
          (dk-have! (list '< u e) (lambda () (apply dk-ineq! prems)))
          (dk-cite! 'rr-abs-lt-of-parts u e)))
    g))
(define (b6-abs-lt-out! u e)          ; (< (abs u) e) in context: lands -e < u, u < e
  (b6-real! u) (b6-real! e)
  (dk-split! (dk-cite! 'rr-abs-lt-parts u e)))

;; a point g of R^ff with g(a) > 1 has a neighbourhood on which h(a) > 1
(sp (make-wff (b6-alls '(ff g a) (b6-imps (list '(IN ff SET) (list 'IN 'g b6-PRP) '(IN a ff) '(< 1 (g a)))
                                          (b6-ex-nbhd (lambda (h) (list '< 1 (list h 'a))))))))
(dk-peel!)
(b6-rf-setup!)
(let* ((ga '(g a)) (e (list '- ga 1)) (w (b6-cb 'a ga e)))
  (b6-real! e)
  (dk-have! (list '< 0 e) (lambda () (dk-ineq! (list 'IN ga 'RR) (list '< 1 ga))))
  (b6-cb-open! 'a ga e)
  (b6-abs-lt-in! (list '- ga ga) e (list (list 'IN ga 'RR) (list '< 0 e)))
  (b6-cb-in! 'g 'a ga e)
  (ew w)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let ((h (dk-di-var!)))
            (b6-cb-out! h 'a ga e)
            (b6-abs-lt-out! (list '- ga (list h 'a)) e)
            (dk-conj-close! (lambda () (if (not (dk-ass!))
                                           (dk-ineq! (list 'IN ga 'RR) (list 'IN (list h 'a) 'RR) (list '< 1 ga) (list '< (list '- ga (list h 'a)) e))))))))))
(b6-qed! 'line-product-gt-nbhd)

;; a point g of R^ff with g(c) /= g(a) + g(b) has a neighbourhood on which h(c) /= h(a) + h(b)
(sp (make-wff (b6-alls '(ff g a b c) (b6-imps (list '(IN ff SET) (list 'IN 'g b6-PRP) '(IN a ff) '(IN b ff) '(IN c ff) '(NOT (= (g c) (+ (g a) (g b)))))
                                          (b6-ex-nbhd (lambda (h) (list 'NOT (list '= (list h 'c) (list '+ (list h 'a) (list h 'b))))))))))
(dk-peel!)
(b6-rf-setup!)
(let* ((gs (list '+ '(g a) '(g b))) (u (list '- '(g c) gs)) (d (list 'abs u)) (e (list '* 1/3 d))
       (wc (b6-cb 'c '(g c) e)) (wa (b6-cb 'a '(g a) e)) (wb (b6-cb 'b '(g b) e))
       (w1 (list 'INTERSECTION wc wa)) (w (list 'INTERSECTION w1 wb)))
  (b6-real! gs) (b6-real! '(g c))
  (b6-abs-pos! '(g c) gs)
  (b6-real! e)
  (dk-have! (list '< 0 e) (lambda () (dk-ineq! (list 'IN d 'RR) (list '< 0 d))))
  (for-each (lambda (x) (b6-cb-open! x (list 'g x) e)) '(c a b))
  (b6-pr-inter! wc wa)
  (b6-pr-inter! w1 wb)
  (for-each (lambda (x)
              (b6-abs-lt-in! (list '- (list 'g x) (list 'g x)) e (list (list 'IN (list 'g x) 'RR) (list '< 0 e)))
              (b6-cb-in! 'g x (list 'g x) e))
            '(c a b))
  (b6-inter-in! 'g wc wa)
  (b6-inter-in! 'g w1 wb)
  (ew w)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let ((h (dk-di-var!)))
            (b6-inter-out! h w1 wb)
            (b6-inter-out! h wc wa)
            (for-each (lambda (x) (b6-cb-out! h x (list 'g x) e) (b6-abs-lt-out! (list '- (list 'g x) (list h x)) e)) '(c a b))
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (begin
                      (di)
                      (let ((prems (append (map (lambda (x) (list 'IN (list 'g x) 'RR)) '(a b c))
                                           (map (lambda (x) (list 'IN (list h x) 'RR)) '(a b c))
                                           (list (list 'IN d 'RR))
                                           (map (lambda (x) (list '< (list '- e) (list '- (list 'g x) (list h x)))) '(a b c))
                                           (map (lambda (x) (list '< (list '- (list 'g x) (list h x)) e)) '(a b c))
                                           (list (list '= (list h 'c) (list '+ (list h 'a) (list h 'b)))))))
                        (b6-abs-lt-in! u d prems)
                        (dk-absurd! (list 'IN d 'RR) (list '< d d))))))))))))
(b6-qed! 'line-product-additive-nbhd)

;; a point g of R^ff with g(c) /= r g(a) has a neighbourhood on which h(c) /= r h(a)
(define (b6-name! t)                   ; t typed in RR: a fresh v with (IN v RR), (= v t); returns v
  (b6-real! t) (dk-name! t))
(define (b6-eq-by-names! eq names thunk) ; prove EQ after rewriting each (v . t) name back to its term
  (dk-have! eq (lambda () (for-each (lambda (p) (if (dk-contains? (dk-goal) (car p)) (subst (list '= (car p) (cdr p))))) names) (thunk))))
(sp (make-wff (b6-alls '(ff g a c r) (b6-imps (list '(IN ff SET) (list 'IN 'g b6-PRP) '(IN a ff) '(IN c ff) '(IN r RR) '(NOT (= (g c) (* r (g a)))))
                                          (b6-ex-nbhd (lambda (h) (list 'NOT (list '= (list h 'c) (list '* 'r (list h 'a))))))))))
(dk-peel!)
(b6-rf-setup!)
(let* ((ga '(g a)) (gc '(g c)) (gs (list '* 'r ga)) (u (list '- gc gs)))
  (b6-real! gs) (b6-real! gc)
  (b6-abs-pos! gc gs)
  (let* ((dd (b6-name! (list 'abs u)))
         (ar (b6-name! '(abs r)))
         (k (list '+ 1 ar)))
    (dk-cite! 'rr-abs-nonneg 'r)
    (b6-real! k)
    (dk-have! (list '< 0 dd) (lambda () (dk-ineq! (list 'IN (list 'abs u) 'RR) (list '= dd (list 'abs u)) (list '< 0 (list 'abs u)))))
    (dk-have! (list '< 0 k) (lambda () (dk-ineq! '(IN (abs r) RR) (list 'IN ar 'RR) (list '= ar '(abs r)) '(<= 0 (abs r)))))
    (dk-have! (list 'NOT (list '= k 0)) (lambda () (di) (dk-absurd! (list 'IN ar 'RR) (list '= k 0) (list '< 0 k))))
    (b6-and! (list 'IN k 'RR) (list 'NOT (list '= k 0)))
    (dk-cite! 'rr-recip-closed k)
    (dk-cite! 'rr-recip-inverse k)
    (dk-cite! 'rr-recip-pos k)
    (let* ((q (dk-name! (list 'recip k)))
           (e (b6-name! (list '* 1/2 (list '* dd q))))
           (names (list (cons e (list '* 1/2 (list '* dd q))))))
      (dk-have! (list '= (list '* k q) 1) (lambda () (subst (list '= q (list 'recip k))) (dk-ass!)))
      (dk-have! (list '< 0 q) (lambda () (subst (list '= q (list 'recip k))) (dk-ass!)))
      (dk-have! (list '< 0 (list '* dd q)) (lambda () (b6-and! (list 'IN dd 'RR) (list 'IN q 'RR)) (dk-cite! 'rr-mul-pos dd q) (dk-ass!)))
      (dk-have! (list '< 0 e) (lambda () (dk-ineq! (list 'IN (list '* dd q) 'RR) (list '= e (list '* 1/2 (list '* dd q))) (list '< 0 (list '* dd q)))))
      (b6-eq-by-names! (list '= (list '* k e) (list '* 1/2 (list '* dd (list '* k q)))) names (lambda () (crs)))
      (dk-have! (list '= (list '+ e (list '* ar e)) (list '* 1/2 dd))
        (lambda () (dk-have! (list '= (list '+ e (list '* ar e)) (list '* k e)) (lambda () (crs)))
                   (subst (list '= (list '+ e (list '* ar e)) (list '* k e)))
                   (subst (list '= (list '* k e) (list '* 1/2 (list '* dd (list '* k q)))))
                   (subst (list '= (list '* k q) 1))
                   (crs)))
      (let* ((wc (b6-cb 'c gc e)) (wa (b6-cb 'a ga e)) (w (list 'INTERSECTION wc wa)))
        (for-each (lambda (x) (b6-cb-open! x (list 'g x) e)) '(c a))
        (b6-pr-inter! wc wa)
        (for-each (lambda (x)
                    (b6-abs-lt-in! (list '- (list 'g x) (list 'g x)) e (list (list 'IN (list 'g x) 'RR) (list '< 0 e)))
                    (b6-cb-in! 'g x (list 'g x) e))
                  '(c a))
        (b6-inter-in! 'g wc wa)
        (ew w)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (let ((h (dk-di-var!)))
                  (b6-inter-out! h wc wa)
                  (for-each (lambda (x) (b6-cb-out! h x (list 'g x) e) (b6-abs-lt-out! (list '- (list 'g x) (list h x)) e)) '(c a))
                  (let* ((ha (list h 'a)) (hc (list h 'c)) (wv (list '- ga ha)) (p (list '* 'r wv)))
                    (b6-real! p)
                    (let* ((aw (b6-name! (list 'abs wv))) (rw (b6-name! (list 'abs p))))
                      (b6-and! '(IN r RR) (list 'IN wv 'RR))
                      (dk-cite! 'rr-abs-mult 'r wv)
                      (dk-have! (list '= rw (list '* ar aw))
                        (lambda () (subst (list '= rw (list 'abs p))) (subst (list '= ar '(abs r))) (subst (list '= aw (list 'abs wv))) (dk-ass!)))
                      (dk-have! (list '<= aw e) (lambda () (dk-ineq! (list 'IN (list 'abs wv) 'RR) (list '= aw (list 'abs wv)) (list '< (list 'abs wv) e))))
                      (dk-have! (list '<= 0 ar) (lambda () (dk-ineq! '(IN (abs r) RR) (list '= ar '(abs r)) '(<= 0 (abs r)))))
                      (dk-cite! 'rr-mul-le-right aw e ar)
                      (dk-have! (list '= (list '* ar aw) (list '* aw ar)) (lambda () (crs)))
                      (dk-have! (list '= (list '* ar e) (list '* e ar)) (lambda () (crs)))
                      (dk-cite! 'rr-le-abs p)
                      (dk-cite! 'rr-neg-abs-le p)
                      (dk-have! (list '= p (list '- gs (list '* 'r ha))) (lambda () (crs)))
                      (b6-real! (list '* 'r ha))
                      (dk-conj-close!
                        (lambda ()
                          (if (not (dk-ass!))
                              (begin
                                (di)
                                (let ((prems (list (list 'IN gc 'RR) (list 'IN hc 'RR) (list 'IN gs 'RR) (list 'IN (list '* 'r ha) 'RR)
                                                   (list 'IN p 'RR) (list 'IN (list 'abs p) 'RR) (list 'IN rw 'RR) (list 'IN ar 'RR) (list 'IN aw 'RR) (list 'IN e 'RR)
                                                   (list 'IN dd 'RR)
                                                   (b6-real! (list '* ar aw)) (b6-real! (list '* aw ar)) (b6-real! (list '* ar e)) (b6-real! (list '* e ar))
                                                   (list '< (list '- e) (list '- gc hc)) (list '< (list '- gc hc) e)
                                                   (list '= hc (list '* 'r ha))
                                                   (list '= p (list '- gs (list '* 'r ha)))
                                                   (list '<= p (list 'abs p)) (list '<= (list '- (list 'abs p)) p)
                                                   (list '= rw (list 'abs p)) (list '= rw (list '* ar aw)) (list '= (list '* ar aw) (list '* aw ar))
                                                   (list '<= (list '* aw ar) (list '* e ar)) (list '= (list '* ar e) (list '* e ar))
                                                   (list '= (list '+ e (list '* ar e)) (list '* 1/2 dd)) (list '< 0 dd))))
                                  (b6-abs-lt-in! u dd prems)
                                  (dk-absurd! (list 'IN dd 'RR) (list '= dd (list 'abs u)) (list '< (list 'abs u) dd)))))))))))))))))
(b6-qed! 'line-product-homogeneous-nbhd)

;;; ===========================================================================
;;; (5) THE POLAR OF A NEIGHBOURHOOD OF 0 IN THE TOPOLOGICAL DUAL (Def 3.10, Cor 3.27)
;;; ===========================================================================
(define (b6-tree-sub x y t) (cond ((equal? t x) y) ((pair? t) (map (lambda (s) (b6-tree-sub x y s)) t)) (#t t)))
(define (b6-m t) (b6-tree-sub 'ff '(VEC m) t))
(define b6-PRm (b6-m b6-PR)) (define b6-PRPm (b6-m b6-PRP))
(define b6-RT '(SEMINORM-TOP (NORMED-VECTOR-SPACE-AS-MODULE RR-NVS) (PAIR 0 0) (VNB-LAMBDA nvk_ (PAIR 0 0) (VNRM RR-NVS))))
(define b6-tvs '(IS-TVS RR-NORMED-FIELD m t))
(define b6-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define b6-TD '(TOP-DUAL m t))
(define (b6-lf f) (list 'IS-LINEAR-FUNCTIONAL 'm f))
(define (b6-hom f) (list 'IS-HOM-TOP-SPACE 't b6-RT f))
(define (b6-le1 f a) (list 'FORALL 'plx_ (list 'IMPLIES (list 'IN 'plx_ a) (list '<= (list f 'plx_) 1))))
(define b6-TD-body (list 'SEP 'tdf_ '(FUN (VEC m) RR) (list 'AND (b6-lf 'tdf_) (b6-hom 'tdf_))))
(define b6-POL-body (list 'SEP 'plf_ b6-TD (b6-le1 'plf_ 'a)))
(sp (make-wff (b6-alls '(m t) (list '== b6-TD b6-TD-body))))
(dk-peel!) (mac 'TOP-DUAL) (qrfl)
(b6-qed! 'top-dual-unfold)
(sp (make-wff (b6-alls '(m t a) (list '== '(POLAR m t a) b6-POL-body))))
(dk-peel!) (mac 'POLAR) (qrfl)
(b6-qed! 'polar-unfold)
(sp (make-wff (b6-alls '(m t) (list '== '(WEAK-STAR-TOP m t) (list 'SUBSPACE-TOP b6-PRm b6-TD)))))
(dk-peel!) (mac 'WEAK-STAR-TOP) (qrfl)
(b6-qed! 'weak-star-top-unfold)
(define (b6-mem-thm! name args setf body dom cnd unf)
  (sp (make-wff (b6-alls (append args '(z)) (list 'IFF (list 'IN 'z setf) (list 'AND (list 'IN 'z dom) cnd)))))
  (dk-peel!)
  (apply dk-cite! unf args)
  (subst (list '== setf body))
  (dk-iff! (lambda (g) (dk-head-is? g 'AND))
    (lambda () (sep-me (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (eq? (cadr h) 'z) (dk-head-is? (caddr h) 'SEP))) "sep")) (dk-split-all!) (dk-conj-close! dk-ass!))
    (lambda () (dk-split-all!) (in-sep! (lambda () (ass)) (lambda () (ass)))))
  (b6-qed! name))
(b6-mem-thm! 'top-dual-mem '(m t) b6-TD b6-TD-body '(FUN (VEC m) RR) (list 'AND (b6-lf 'z) (b6-hom 'z)) 'top-dual-unfold)
(b6-mem-thm! 'polar-mem '(m t a) '(POLAR m t a) b6-POL-body b6-TD (b6-le1 'z 'a) 'polar-unfold)

;; a function ff -> RR is a point of the product of lines, and conversely
(sp (make-wff (b6-alls '(ff f) (b6-imps '((IN ff SET) (IN f (FUN ff RR))) (list 'IN 'f b6-PRP)))))
(dk-peel!)
(b6-rf-setup!)
(let ((fi (dk-cite! 'fun-codomain-iff 'ff 'RR 'f)))
  (dk-have! (caddr fi) (lambda () (if (dk-only! fi '(IN f (FUN ff RR))) (prop))))
  (dk-split! (caddr fi))
  (b6-into-prp! 'f (lambda (y) (dk-apply! (caddr (caddr fi)) y)))
  (dk-ass!))
(b6-qed! 'fun-in-line-product)
(sp (make-wff (b6-alls '(ff f) (b6-imps (list '(IN ff SET) (list 'IN 'f b6-PRP)) '(IN f (FUN ff RR))))))
(dk-peel!)
(b6-rf-setup!)
(b6-fun-ff! 'f b6-RF)
(let ((fi (dk-cite! 'fun-codomain-iff 'ff 'RR 'f)))
  (dk-have! (caddr (caddr fi)) (lambda () (let ((y (dk-di-var!))) (b6-line-coord! 'f y) (dk-ass!))))
  (b6-and! '(IN f (FUN ff)) (caddr (caddr fi)))
  (if (dk-only! fi (caddr fi)) (prop)))
(b6-qed! 'line-product-fun)

;; a linear functional bounded above by 1 on a neighbourhood of 0 is continuous
(define b6-nbhd-hyps (list b6-tvs '(SUBSET vv (VEC m)) '(IN ww (OPENS t)) '(IN (VZERO m) ww) '(SUBSET ww vv)))
(sp (make-wff (b6-alls '(m t vv ww f) (b6-imps (append b6-nbhd-hyps (list (b6-lf 'f) (b6-le1 'f 'vv))) (b6-hom 'f)))))
(dk-peel!)
(dk-have! '(FORALL osw_ (IMPLIES (IN osw_ ww) (<= (f osw_) 1)))
  (lambda () (let ((x (dk-di-var!))) (dk-cite! 'subset-mem-fwd 'ww 'vv x) (dk-apply! (dk-ctx-form (b6-le1 'f 'vv)) x) (dk-ass!))))
(dk-cite! 'tvs-local-bound-of-one-sided 'm 't 'f 'ww)
(dk-cite! 'tvs-continuous-of-local-bound 'm 't 'f)
(dk-ass!)
(b6-qed! 'polar-bound-continuous)

;; the polar is pointwise bounded: |f(x)| <= rbm(x), rbm(x) = c(x) + c(-x) with c(z) a CHOSEN element of the Minkowski set
;; { r > 0 : z in r.V } (nonempty because V contains an open neighbourhood of 0, which absorbs)
(define b6-rbm '(VNB-LAMBDA b6x_ (VEC m) (+ (CHOICE (MINK-SET m vv b6x_)) (CHOICE (MINK-SET m vv ((ACT m) (- 1) b6x_))))))
(define b6-absc '(FORALL abx_ (IMPLIES (IN abx_ (VEC m)) (FORSOME abr_ (AND (IN abr_ RR) (AND (< 0 abr_) (FORSOME aby_ (AND (IN aby_ ww) (= abx_ ((ACT m) abr_ aby_))))))))))
(define (b6-tvs-parts!)
  (if (not (dk-asm? '(IS-TOP-SPACE t)))
      (begin
        (dk-project! '(IS-MODULE m) 'is-tvs b6-tvs)
        (dk-project! (list '= '(SCAL m) b6-ring) 'is-tvs b6-tvs)
        (dk-project! '(== (PTS t) (VEC m)) 'is-tvs b6-tvs)
        (dk-project! '(IS-HAUSDORFF t) 'is-tvs b6-tvs)
        (dk-project! '(IS-TOP-SPACE t) 'is-hausdorff '(IS-HAUSDORFF t))
        (b6-top! 't)
        (dk-have! '(IN (VEC m) SET) (lambda () (subst '(= (VEC m) (PTS t))) (dk-ass!))))))
(define (b6-vtype! v)                  ; (IN v (VEC m)) for v built by (ACT m) from typed pieces
  (let ((ty (list 'IN v '(VEC m))))
    (cond ((dk-asm? ty) ty)
          ((and (pair? v) (equal? (car v) '(ACT m))) (b6-real! (cadr v)) (b6-vtype! (caddr v)) (dk-cite! 'rmod-act-type 'm (cadr v) (caddr v)) ty)
          ((and (pair? v) (equal? (car v) '(VADD m))) (b6-vtype! (cadr v)) (b6-vtype! (caddr v)) (dk-cite! 'module-vadd-type 'm (cadr v) (caddr v)) ty)
          (#t (error "b6-vtype!: no typing for" v)))))
(define (b6-mink! x)                   ; x in VEC m, absorbing clause in context: (c . y), c = CHOICE(MINK-SET m vv x) in RR, 0 < c,
  (let* ((ms (list 'MINK-SET 'm 'vv x)) (c (list 'CHOICE ms)))   ; y in vv, x = c.y landed
    (if (not (dk-asm? (list 'IN c ms)))
        (let* ((ex (dk-apply! (dk-ctx-form b6-absc) x))
               (r (dk-skolem! ex #t))
               (ex2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h r) (dk-contains? h 'ww))) "the absorbing witness"))
               (y0 (dk-skolem! ex2 #t)))
          (dk-cite! 'subset-mem-fwd 'ww 'vv y0)
          (choose-mem! ms r (lambda () (dk-cite! 'mink-set-intro 'm 'vv x r y0) (dk-ass!)))))
    (dk-split-all! (list (dk-cite! 'mink-set-elim 'm 'vv x c)))
    (let ((y (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h c) (dk-contains? h 'mky_))) "the Minkowski witness") #t)))
      (cons c y))))
(define (b6-fparts! f)                 ; f in POLAR(m, t, vv): its pieces landed; returns (le1 . fhom)
  (let* ((pm (dk-cite! 'polar-mem 'm 't 'vv f)))
    (dk-have! (caddr pm) (lambda () (if (dk-only! pm (list 'IN f '(POLAR m t vv))) (prop))))
    (dk-split! (caddr pm))
    (let ((tm (dk-cite! 'top-dual-mem 'm 't f)))
      (dk-have! (caddr tm) (lambda () (if (dk-only! tm (list 'IN f b6-TD)) (prop))))
      (dk-split-all! (list (caddr tm))))
    (dk-project! (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ RR) (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list '= (list f '((ACT m) r_ x_)) (list '* 'r_ (list f 'x_)))))))
                 'is-linear-functional (b6-lf f))
    (cons (b6-le1 f 'vv)
          (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ RR) (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list '= (list f '((ACT m) r_ x_)) (list '* 'r_ (list f 'x_))))))))))
(define (b6-fapp! f x) (b6-vtype! x) (dk-cite! 'fun-apply-type-c f '(VEC m) 'RR x) (list 'IN (list f x) 'RR))
(define (b6-upper! f x parts)          ; f in POLAR, x in VEC m: lands (<= (f x) cn), cn named for CHOICE(MINK-SET x), 0 < cn; returns cn
  (let* ((cy (b6-mink! x)) (c (car cy)) (y (cdr cy))
         (cn (b6-name! c))
         (e0 (list '= x (list '(ACT m) c y)))
         (e1 (dk-rewrite-h! e0 c cn)))
    (dk-have! (list '< 0 cn) (lambda () (dk-ineq! (list 'IN c 'RR) (list '= cn c) (list '< 0 c))))
    (dk-have! (list '<= 0 cn) (lambda () (dk-ineq! (list 'IN cn 'RR) (list '< 0 cn))))
    (dk-cite! 'subset-mem-fwd 'vv '(VEC m) y)
    (b6-fapp! f x) (b6-fapp! f y) (b6-fapp! f (list '(ACT m) cn y))
    (dk-congr! (list '= x (list '(ACT m) cn y)) (lambda (z) (list f z)))
    (dk-apply! (cdr parts) cn y)
    (dk-apply! (dk-ctx-form (car parts)) y)
    (dk-have! '(IN 1 RR) (lambda () (arith)))
    (dk-cite! 'rr-mul-le-right (list f y) 1 cn)
    (dk-have! (list '= (list '* cn (list f y)) (list '* (list f y) cn)) (lambda () (crs)))
    (dk-have! (list '= (list '* 1 cn) cn) (lambda () (crs)))
    (b6-real! (list '* cn (list f y))) (b6-real! (list '* (list f y) cn))
    (dk-have! (list '<= (list f x) cn)
      (lambda () (dk-ineq! (list 'IN (list f x) 'RR) (list 'IN (list f (list '(ACT m) cn y)) 'RR) (list 'IN cn 'RR)
                           (list 'IN (list '* cn (list f y)) 'RR) (list 'IN (list '* (list f y) cn) 'RR)
                           (list '= (list f x) (list f (list '(ACT m) cn y))) (list '= (list f (list '(ACT m) cn y)) (list '* cn (list f y)))
                           (list '= (list '* cn (list f y)) (list '* (list f y) cn)) (list '<= (list '* (list f y) cn) (list '* 1 cn))
                           (list '= (list '* 1 cn) cn))))
    cn))
(sp (make-wff (b6-alls '(m t vv ww) (b6-imps b6-nbhd-hyps
  (list 'AND (list 'IN b6-rbm '(FUN (VEC m) RR))
        (b6-tree-sub 'rb b6-rbm (b6-tree-sub 'aa '(POLAR m t vv) (b6-m b6-pwbd))))))))
(dk-peel!)
(b6-tvs-parts!)
(dk-cite! 'tvs-open-zero-absorbing 'm 't 'ww)
(dk-project! b6-absc 'is-absorbing-subset '(IS-ABSORBING-SUBSET m ww))
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IN)
        (dk-lam-type! (lambda () (let* ((x (dk-di-var!)) (xm (list '(ACT m) '(- 1) x)))
                                   (b6-real! '(- 1)) (b6-vtype! xm)
                                   (let ((c1 (car (b6-mink! x))) (c2 (car (b6-mink! xm))))
                                     (b6-real! (list '+ c1 c2)) (dk-ass!))))
                      (lambda () (dk-ass!)))
        (let* ((gl (begin (dk-peel!) (dk-goal))) (y (cadr (cadr (cadr gl)))) (g (car (cadr (cadr gl)))) (parts (b6-fparts! g)) (ym (list '(ACT m) '(- 1) y)))
          (b6-real! '(- 1)) (b6-vtype! ym)
          (let* ((c1 (b6-upper! g y parts)) (c2 (b6-upper! g ym parts)))
            (dk-apply! (cdr parts) '(- 1) y)
            (dk-have! (list '= (list '* '(- 1) (list g y)) (list '- (list g y))) (lambda () (crs)))
            (b6-real! (list '* '(- 1) (list g y)))
            (dk-have! (list '= (list b6-rbm y) (list '+ (list 'CHOICE (list 'MINK-SET 'm 'vv y)) (list 'CHOICE (list 'MINK-SET 'm 'vv ym))))
              (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
            (subst (list '= (list b6-rbm y) (list '+ (list 'CHOICE (list 'MINK-SET 'm 'vv y)) (list 'CHOICE (list 'MINK-SET 'm 'vv ym)))))
            (subst (list '= (list 'CHOICE (list 'MINK-SET 'm 'vv y)) c1))
            (subst (list '= (list 'CHOICE (list 'MINK-SET 'm 'vv ym)) c2))
            (let ((prems (list (list 'IN (list g y) 'RR) (list 'IN (list g ym) 'RR) (list 'IN c1 'RR) (list 'IN c2 'RR) (list 'IN (list '* '(- 1) (list g y)) 'RR)
                               (list '<= (list g y) c1) (list '<= (list g ym) c2) (list '< 0 c1) (list '< 0 c2)
                               (list '= (list g ym) (list '* '(- 1) (list g y))) (list '= (list '* '(- 1) (list g y)) (list '- (list g y))))))
              (b6-real! (list '+ c1 c2))
              (dk-have! (list '<= (list '- (list '+ c1 c2)) (list g y)) (lambda () (apply dk-ineq! prems)))
              (dk-have! (list '<= (list g y) (list '+ c1 c2)) (lambda () (apply dk-ineq! prems)))
              (dk-cite! 'rr-abs-le-of-parts (list g y) (list '+ c1 c2))
              (dk-ass!)))))))
(b6-qed! 'polar-pointwise-bounded)

;; the product of lines is a topological space with points PRP
(sp (make-wff (b6-alls '(ff) (b6-imps '((IN ff SET)) (list 'AND (list 'IS-TOP-SPACE b6-PR) (list 'AND (list '== (list 'PTS b6-PR) b6-PRP) (list 'IN b6-PRP 'SET)))))))
(dk-peel!)
(b6-rf-setup!)
(dk-conj-close! dk-ass!)
(b6-qed! 'line-product-facts)

;; THE POLAR IS CLOSED in R^E: off the polar, a point either fails the bound at some x in V, or additivity at some
;; pair, or homogeneity at some (r, x) -- and each failure persists on a neighbourhood (section 4); a point with
;; none of the three is linear and bounded by 1 on V, hence continuous (polar-bound-continuous), hence in the polar.
(define b6-P '(POLAR m t vv))
(define b6-A '(FORSOME b6a_ (AND (IN b6a_ vv) (< 1 (g b6a_)))))
(define b6-B '(FORSOME b6a_ (AND (IN b6a_ (VEC m)) (FORSOME b6b_ (AND (IN b6b_ (VEC m)) (NOT (= (g ((VADD m) b6a_ b6b_)) (+ (g b6a_) (g b6b_)))))))))
(define b6-C '(FORSOME b6r_ (AND (IN b6r_ RR) (FORSOME b6a_ (AND (IN b6a_ (VEC m)) (NOT (= (g ((ACT m) b6r_ b6a_)) (* b6r_ (g b6a_)))))))))
(define b6-comp-m (list 'COMPLEMENT-IN b6-PRPm b6-P))
(define (b6-in-P-parts! h)             ; h in POLAR: fparts plus additivity; returns (le1 fhom fadd)
  (let ((parts (b6-fparts! h))
        (fadd (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list 'FORALL 'y_ (list 'IMPLIES '(IN y_ (VEC m)) (list '= (list h '((VADD m) x_ y_)) (list '+ (list h 'x_) (list h 'y_)))))))))
    (dk-project! fadd 'is-linear-functional (b6-lf h))
    (list (car parts) (cdr parts) fadd)))
(define (b6-finish! ex q-false!)      ; ex: the neighbourhood existential of section 4, landed; goal: the local clause's FORSOME
  (let* ((w (dk-skolem! ex #t))
         (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f w) (dk-contains? f 'b6h_))) "the neighbourhood clause")))
    (ew w)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (mac 'subset-def)
              (let* ((h (dk-di-var!)) (r (dk-apply! cl h)))
                (dk-split! r)
                (let ((cm (dk-cite! 'complement-in-membership b6-PRPm b6-P h)))
                  (dk-have! (list 'NOT (list 'IN h b6-P)) (lambda () (di) (q-false! h)))
                  (b6-and! (list 'IN h b6-PRPm) (list 'NOT (list 'IN h b6-P)))
                  (if (dk-only! cm (caddr cm)) (prop))))))))))
(sp (make-wff (b6-alls '(m t vv ww g) (b6-imps (append b6-nbhd-hyps (list (list 'IN 'g b6-PRPm) (list 'NOT b6-A) (list 'NOT b6-B) (list 'NOT b6-C)))
                                                (list 'IN 'g b6-P)))))
(dk-peel!)
(b6-tvs-parts!)
(dk-cite! 'line-product-fun '(VEC m) 'g)
(define b6-fadd-g '(FORALL x_ (IMPLIES (IN x_ (VEC m)) (FORALL y_ (IMPLIES (IN y_ (VEC m)) (= (g ((VADD m) x_ y_)) (+ (g x_) (g y_))))))))
(define b6-fhom-g '(FORALL r_ (IMPLIES (IN r_ RR) (FORALL x_ (IMPLIES (IN x_ (VEC m)) (= (g ((ACT m) r_ x_)) (* r_ (g x_))))))))
(define (b6-ew2! ex u v)               ; prove (FORSOME _ (AND (IN _ A) (FORSOME _ (AND (IN _ B) P)))) at u, v; typings and P in context
  (dk-have! ex (lambda () (ew u) (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew v) (dk-conj-close! (lambda () (dk-ass!))))))))))
(dk-have! b6-fadd-g
  (lambda ()
    (di)
    (let* ((arg (cadr (cadr (dk-goal)))) (a (cadr arg)) (b (caddr arg)))
      (pbc)
      (b6-ew2! b6-B a b)
      (ai (list 'NOT b6-B)))))
(dk-have! b6-fhom-g
  (lambda ()
    (di)
    (let* ((arg (cadr (cadr (dk-goal)))) (r (cadr arg)) (a (caddr arg)))
      (pbc)
      (b6-ew2! b6-C r a)
      (ai (list 'NOT b6-C)))))
(dk-have! (b6-lf 'g) (lambda () (mac 'is-linear-functional) (dk-conj-close! (lambda () (dk-ass!)))))
(dk-have! (b6-le1 'g 'vv)
  (lambda ()
    (let ((x (dk-di-var!)))
      (pbc)
      (dk-cite! 'subset-mem-fwd 'vv '(VEC m) x)
      (dk-cite! 'fun-apply-type-c 'g '(VEC m) 'RR x)
      (dk-have! '(IN 1 RR) (lambda () (arith)))
      (dk-cite! 'rr-not-le-lt (list 'g x) 1)
      (dk-have! b6-A (lambda () (ew x) (dk-conj-close! dk-ass!)))
      (ai (list 'NOT b6-A)))))
(dk-cite! 'polar-bound-continuous 'm 't 'vv 'ww 'g)
(let ((tm (dk-cite! 'top-dual-mem 'm 't 'g)) (pm (dk-cite! 'polar-mem 'm 't 'vv 'g)))
  (b6-and! (b6-lf 'g) (b6-hom 'g))
  (b6-and! (list 'IN 'g '(FUN (VEC m) RR)) (list 'AND (b6-lf 'g) (b6-hom 'g)))
  (dk-have! (list 'IN 'g b6-TD) (lambda () (if (dk-only! tm (caddr tm)) (prop))))
  (b6-and! (list 'IN 'g b6-TD) (b6-le1 'g 'vv))
  (if (dk-only! pm (caddr pm)) (prop)))
(b6-qed! 'polar-of-no-failure)

(sp (make-wff (b6-alls '(m t vv ww) (b6-imps b6-nbhd-hyps (list 'IS-TOP-CLOSED b6-PRm b6-P)))))
(dk-peel!)
(b6-tvs-parts!)
(dk-split-all! (list (dk-cite! 'line-product-facts '(VEC m))))
(mac 'is-top-closed)
(subst (list '== (list 'PTS b6-PRm) b6-PRPm))
(dk-conj-close!
  (lambda ()
    (cond
      ((dk-ass!) #t)
      ((dk-head-is? (dk-goal) 'SUBSET)
       (mac 'subset-def)
       (let ((f (dk-di-var!)))
         (b6-fparts! f)
         (dk-cite! 'fun-in-line-product '(VEC m) f)
         (dk-ass!)))
      (#t
       (dk-have! (list 'SUBSET b6-comp-m (list 'PTS b6-PRm))
         (lambda () (subst (list '== (list 'PTS b6-PRm) b6-PRPm)) (mac 'subset-def)
                    (let* ((x (dk-di-var!)) (cm (dk-cite! 'complement-in-membership b6-PRPm b6-P x)))
                      (if (dk-only! cm (list 'IN x b6-comp-m)) (prop)))))
       (dk-have! (list 'FORALL 'tlx_ (list 'IMPLIES (list 'IN 'tlx_ b6-comp-m) (list 'FORSOME 'tlw_ (list 'AND (list 'IN 'tlw_ (list 'OPENS b6-PRm)) (list 'AND '(IN tlx_ tlw_) (list 'SUBSET 'tlw_ b6-comp-m))))))
         (lambda ()
           (let* ((g0 (dk-di-var!)) (cm (dk-cite! 'complement-in-membership b6-PRPm b6-P g0))
                  (sb (lambda (f) (b6-tree-sub 'g g0 f))))
             (dk-have! (caddr cm) (lambda () (if (dk-only! cm (list 'IN g0 b6-comp-m)) (prop))))
             (dk-split! (caddr cm))
             (dk-cite! 'line-product-fun '(VEC m) g0)
             (use-em (sb b6-A)
               (lambda ()
                 (let ((a (dk-skolem! (dk-ctx-form (sb b6-A)) #t)))
                   (dk-cite! 'subset-mem-fwd 'vv '(VEC m) a)
                   (b6-finish! (dk-cite! 'line-product-gt-nbhd '(VEC m) g0 a)
                     (lambda (h) (let ((ps (b6-in-P-parts! h)))
                                   (dk-apply! (dk-ctx-form (car ps)) a)
                                   (dk-cite! 'fun-apply-type-c h '(VEC m) 'RR a)
                                   (dk-absurd! (list 'IN (list h a) 'RR) (list '<= (list h a) 1) (list '< 1 (list h a))))))))
               (lambda ()
                 (use-em (sb b6-B)
                   (lambda ()
                     (let* ((a (dk-skolem! (dk-ctx-form (sb b6-B)) #t))
                            (b (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'b6b_) (dk-contains? f a))) "b") #t))
                            (c (list '(VADD m) a b)))
                       (b6-vtype! c)
                       (b6-finish! (dk-cite! 'line-product-additive-nbhd '(VEC m) g0 a b c)
                         (lambda (h) (let ((ps (b6-in-P-parts! h)))
                                       (dk-apply! (caddr ps) a b)
                                       (ai (list 'NOT (list '= (list h c) (list '+ (list h a) (list h b))))))))))
                   (lambda ()
                     (use-em (sb b6-C)
                       (lambda ()
                         (let* ((r (dk-skolem! (dk-ctx-form (sb b6-C)) #t))
                                (a (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'b6a_) (dk-contains? f r))) "a") #t))
                                (c (list '(ACT m) r a)))
                           (b6-vtype! c)
                           (b6-finish! (dk-cite! 'line-product-homogeneous-nbhd '(VEC m) g0 a c r)
                             (lambda (h) (let ((ps (b6-in-P-parts! h)))
                                           (dk-apply! (cadr ps) r a)
                                           (ai (list 'NOT (list '= (list h c) (list '* r (list h a))))))))))
                       (lambda ()
                         ;; none of the three failures: g0 is in the polar, against the hypothesis
                         (dk-cite! 'polar-of-no-failure 'm 't 'vv 'ww g0)
                         (ai (list 'NOT (list 'IN g0 b6-P))))))))))))
       (dk-cite! 'top-open-of-local b6-PRm b6-comp-m)
       (dk-ass!)))))
(b6-qed! 'polar-closed-in-line-product)

;;; ===========================================================================
;;; (6) BANACH-ALAOGLU (Cor 3.27): the polar of a neighbourhood of 0 is weak* compact
;;; ===========================================================================
(define b6-nbhd0 '(FORSOME b6v_ (AND (IN b6v_ (OPENS t)) (AND (IN (VZERO m) b6v_) (SUBSET b6v_ vv)))))
(sp (make-wff (b6-alls '(m t vv) (b6-imps (list b6-tvs '(SUBSET vv (VEC m)) b6-nbhd0)
                                         (list 'IS-COMPACT-T (list 'SUBSPACE-TOP '(WEAK-STAR-TOP m t) b6-P))))))
(dk-peel!)
(b6-tvs-parts!)
(let* ((w (dk-skolem! (dk-ctx-form b6-nbhd0) #t)))
  (dk-split-all! (list (dk-cite! 'line-product-facts '(VEC m))))
  (dk-split! (dk-cite! 'polar-pointwise-bounded 'm 't 'vv w))
  (dk-cite! 'polar-closed-in-line-product 'm 't 'vv w)
  (dk-project! (list 'SUBSET b6-P (list 'PTS b6-PRm)) 'is-top-closed (list 'IS-TOP-CLOSED b6-PRm b6-P))
  (dk-rewrite-h! (list 'SUBSET b6-P (list 'PTS b6-PRm)) (list 'PTS b6-PRm) b6-PRPm)
  (dk-cite! 'pointwise-bounded-closed-compact '(VEC m) b6-rbm b6-P)
  (dk-have! (list 'SUBSET b6-TD (list 'PTS b6-PRm))
    (lambda () (subst (list '== (list 'PTS b6-PRm) b6-PRPm)) (mac 'subset-def)
               (let* ((f (dk-di-var!)) (tm (dk-cite! 'top-dual-mem 'm 't f)))
                 (dk-have! (caddr tm) (lambda () (if (dk-only! tm (list 'IN f b6-TD)) (prop))))
                 (dk-split-all! (list (caddr tm)))
                 (dk-cite! 'fun-in-line-product '(VEC m) f)
                 (dk-ass!))))
  (dk-have! (list 'SUBSET b6-P b6-TD)
    (lambda () (mac 'subset-def)
               (let* ((f (dk-di-var!)) (pm (dk-cite! 'polar-mem 'm 't 'vv f)))
                 (dk-have! (caddr pm) (lambda () (if (dk-only! pm (list 'IN f b6-P)) (prop))))
                 (dk-split! (caddr pm))
                 (dk-ass!))))
  (dk-cite! 'subspace-of-subspace b6-PRm b6-TD b6-P)
  (dk-cite! 'weak-star-top-unfold 'm 't)
  (subst (list '== '(WEAK-STAR-TOP m t) (list 'SUBSPACE-TOP b6-PRm b6-TD)))
  (subst (list '== (list 'SUBSPACE-TOP (list 'SUBSPACE-TOP b6-PRm b6-TD) b6-P) (list 'SUBSPACE-TOP b6-PRm b6-P)))
  (dk-ass!))
(b6-qed! 'banach-alaoglu)

;;; ===========================================================================
;;; (7) Prop 3.29: THE UNIT BALL OF THE DUAL OF A NORMED SPACE IS WEAK* COMPACT
;;; ===========================================================================
;; a point g of R^ff with k < |g(a)| has a neighbourhood on which k < |h(a)|
(sp (make-wff (b6-alls '(ff g a k) (b6-imps (list '(IN ff SET) (list 'IN 'g b6-PRP) '(IN a ff) '(IN k RR) '(< k (abs (g a))))
                                            (b6-ex-nbhd (lambda (h) (list '< 'k (list 'abs (list h 'a)))))))))
(dk-peel!)
(b6-rf-setup!)
(let* ((ga '(g a)) (aga (list 'abs ga)) (e (list '- aga 'k)) (w (b6-cb 'a ga e)))
  (b6-real! e)
  (dk-have! (list '< 0 e) (lambda () (dk-ineq! (list 'IN aga 'RR) '(IN k RR) (list '< 'k aga))))
  (b6-cb-open! 'a ga e)
  (b6-abs-lt-in! (list '- ga ga) e (list (list 'IN ga 'RR) (list '< 0 e)))
  (b6-cb-in! 'g 'a ga e)
  (ew w)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((h (dk-di-var!)) (ha (list h 'a)) (aha (list 'abs ha)) (dif (list '- aga aha)))
            (b6-cb-out! h 'a ga e)
            (b6-real! aha) (b6-real! dif) (b6-real! (list 'abs dif)) (b6-real! (list 'abs (list '- ga ha)))
            (dk-cite! 'rr-abs-reverse-triangle ga ha)
            (dk-cite! 'rr-le-abs dif)
            (dk-conj-close! (lambda () (if (not (dk-ass!))
                                           (dk-ineq! (list 'IN aga 'RR) (list 'IN aha 'RR) '(IN k RR) (list 'IN (list 'abs dif) 'RR) (list 'IN (list 'abs (list '- ga ha)) 'RR)
                                                     (list '<= dif (list 'abs dif)) (list '<= (list 'abs dif) (list 'abs (list '- ga ha)))
                                                     (list '< (list 'abs (list '- ga ha)) e))))))))))
(b6-qed! 'line-product-abs-gt-nbhd)

(define b6-UB '(DUAL-UNIT-BALL m))
(define b6-UB-body '(SEP dbf_ (DUAL-VEC m) (<= (DUAL-NORM m dbf_) 1)))
(define b6-nvs '(IS-NORMED-VECTOR-SPACE m))
(define (b6-nbd f) (list 'FORALL 'dbx_ (list 'IMPLIES '(IN dbx_ (VEC m)) (list '<= (list 'abs (list f 'dbx_)) '((VNRM m) dbx_)))))
(sp (make-wff (b6-alls '(m) (list '== b6-UB b6-UB-body))))
(dk-peel!) (mac 'DUAL-UNIT-BALL) (qrfl)
(b6-qed! 'dual-unit-ball-unfold)
(sp (make-wff (b6-alls '(m) (list '== '(DUAL-WEAK-STAR-TOP m) (list 'SUBSPACE-TOP b6-PRm '(DUAL-VEC m))))))
(dk-peel!) (mac 'DUAL-WEAK-STAR-TOP) (qrfl)
(b6-qed! 'dual-weak-star-top-unfold)
(define (b6-nvs-parts!)
  (if (not (dk-asm? '(IN (VEC m) SET)))
      (begin
        (dk-project! '(IN (VEC m) SET) 'is-normed-vector-space b6-nvs)
        (dk-project! '(IN (VNRM m) (FUN (VEC m) RR)) 'is-normed-vector-space b6-nvs))))
;; the unit ball of the dual: the linear f with |f(x)| <= ||x||
(sp (make-wff (b6-alls '(m f) (b6-imps (list b6-nvs) (list 'IFF '(IN f (DUAL-UNIT-BALL m)) (list 'AND '(IN f (FUN (VEC m) RR)) (list 'AND (b6-lf 'f) (b6-nbd 'f))))))))
(dk-peel!)
(b6-nvs-parts!)
(dk-cite! 'dual-unit-ball-unfold 'm)
(subst (list '== b6-UB b6-UB-body))
(let ((dn '(DUAL-NORM m f)))
  (dk-iff! (lambda (g) (dk-head-is? g 'AND))
    (lambda ()
      (sep-me (dk-ctx-form (list 'IN 'f b6-UB-body)))
      (dk-split-all!)
      (dk-cite! 'dual-vec-fun 'm 'f)
      (dk-cite! 'dual-vec-blf 'm 'f)
      (dk-project! (b6-lf 'f) 'is-bounded-linear-functional '(IS-BOUNDED-LINEAR-FUNCTIONAL m f))
      (dk-split! (dk-cite! 'dual-norm-nonneg-nvs 'm 'f))
      (dk-have! (b6-nbd 'f)
        (lambda ()
          (let* ((x (dk-di-var!)) (fx (list 'f x)) (nx (list '(VNRM m) x)))
            (dk-cite! 'dual-norm-is-bound-nvs 'm 'f x)
            (dk-cite! 'vnrm-nonneg 'm x) (dk-cite! 'vnrm-real 'm x)
            (dk-cite! 'fun-apply-type-c 'f '(VEC m) 'RR x)
            (dk-have! '(IN 1 RR) (lambda () (arith)))
            (dk-cite! 'rr-mul-le-right dn 1 nx)
            (dk-have! (list '= (list '* 1 nx) nx) (lambda () (crs)))
            (b6-real! (list 'abs fx)) (b6-real! (list '* dn nx)) (b6-real! (list '* 1 nx))
            (dk-ineq! (list 'IN (list 'abs fx) 'RR) (list 'IN nx 'RR) (list 'IN (list '* dn nx) 'RR) (list 'IN (list '* 1 nx) 'RR)
                      (list '<= (list 'abs fx) (list '* dn nx)) (list '<= (list '* dn nx) (list '* 1 nx)) (list '= (list '* 1 nx) nx)))))
      (dk-conj-close! (lambda () (dk-ass!))))
    (lambda ()
      (dk-split-all!)
      (let ((b1 '(FORALL w_ (IMPLIES (IN w_ (VEC m)) (<= (abs (f w_)) (* 1 ((VNRM m) w_)))))))
        (dk-have! b1 (lambda () (let* ((x (dk-di-var!)) (nx (list '(VNRM m) x)))
                                  (dk-cite! 'vnrm-real 'm x)
                                  (dk-have! (list '= (list '* 1 nx) nx) (lambda () (crs)))
                                  (subst (list '= (list '* 1 nx) nx))
                                  (dk-apply! (dk-ctx-form (b6-nbd 'f)) x)
                                  (dk-ass!))))
        (dk-have! '(IN 1 RR) (lambda () (arith)))
        (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
        (dk-have! '(IS-BOUNDED-LINEAR-FUNCTIONAL m f)
          (lambda () (mac 'is-bounded-linear-functional)
                     (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew 1) (dk-conj-close! (lambda () (dk-ass!)))))))))
        (dk-cite! 'dual-vec-intro 'm 'f)
        (dk-cite! 'dual-norm-le-bound-nvs 'm 'f 1)
        (in-sep! (lambda () (ass)) (lambda () (ass)))))))
(b6-qed! 'dual-unit-ball-mem)

(define b6-A2 '(FORSOME b6a_ (AND (IN b6a_ (VEC m)) (< ((VNRM m) b6a_) (abs (g b6a_))))))
(define (b6-finish-P! P ex q-false!)  ; b6-finish! for the complement of P in PRPm
  (let* ((comp (list 'COMPLEMENT-IN b6-PRPm P))
         (w (dk-skolem! ex #t))
         (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f w) (dk-contains? f 'b6h_))) "the neighbourhood clause")))
    (ew w)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (mac 'subset-def)
              (let* ((h (dk-di-var!)) (r (dk-apply! cl h)))
                (dk-split! r)
                (let ((cm (dk-cite! 'complement-in-membership b6-PRPm P h)))
                  (dk-have! (list 'NOT (list 'IN h P)) (lambda () (di) (q-false! h)))
                  (b6-and! (list 'IN h b6-PRPm) (list 'NOT (list 'IN h P)))
                  (if (dk-only! cm (caddr cm)) (prop))))))))))
(define (b6-ub-parts! h)               ; h in the unit ball: (nbd fhom fadd) landed
  (let ((um (dk-cite! 'dual-unit-ball-mem 'm h)))
    (dk-have! (caddr um) (lambda () (if (dk-only! um (list 'IN h b6-UB)) (prop))))
    (dk-split-all! (list (caddr um)))
    (let ((fhom (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ RR) (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list '= (list h '((ACT m) r_ x_)) (list '* 'r_ (list h 'x_))))))))
          (fadd (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list 'FORALL 'y_ (list 'IMPLIES '(IN y_ (VEC m)) (list '= (list h '((VADD m) x_ y_)) (list '+ (list h 'x_) (list h 'y_)))))))))
      (dk-project! fhom 'is-linear-functional (b6-lf h))
      (dk-project! fadd 'is-linear-functional (b6-lf h))
      (list (b6-nbd h) fhom fadd))))

;; a point of R^E with none of the three failures is in the unit ball
(sp (make-wff (b6-alls '(m g) (b6-imps (list b6-nvs (list 'IN 'g b6-PRPm) (list 'NOT b6-A2) (list 'NOT b6-B) (list 'NOT b6-C)) (list 'IN 'g b6-UB)))))
(dk-peel!)
(b6-nvs-parts!)
(dk-cite! 'line-product-fun '(VEC m) 'g)
(dk-have! b6-fadd-g (lambda () (di) (let* ((arg (cadr (cadr (dk-goal)))) (a (cadr arg)) (b (caddr arg))) (pbc) (b6-ew2! b6-B a b) (ai (list 'NOT b6-B)))))
(dk-have! b6-fhom-g (lambda () (di) (let* ((arg (cadr (cadr (dk-goal)))) (r (cadr arg)) (a (caddr arg))) (pbc) (b6-ew2! b6-C r a) (ai (list 'NOT b6-C)))))
(dk-have! (b6-lf 'g) (lambda () (mac 'is-linear-functional) (dk-conj-close! (lambda () (dk-ass!)))))
(dk-have! (b6-nbd 'g)
  (lambda ()
    (let* ((x (dk-di-var!)) (gx (list 'g x)) (nx (list '(VNRM m) x)))
      (pbc)
      (dk-cite! 'fun-apply-type-c 'g '(VEC m) 'RR x)
      (dk-cite! 'vnrm-real 'm x)
      (b6-real! (list 'abs gx))
      (dk-cite! 'rr-not-le-lt (list 'abs gx) nx)
      (dk-have! b6-A2 (lambda () (ew x) (dk-conj-close! dk-ass!)))
      (ai (list 'NOT b6-A2)))))
(let ((um (dk-cite! 'dual-unit-ball-mem 'm 'g)))
  (b6-and! (b6-lf 'g) (b6-nbd 'g))
  (b6-and! '(IN g (FUN (VEC m) RR)) (list 'AND (b6-lf 'g) (b6-nbd 'g)))
  (if (dk-only! um (caddr um)) (prop)))
(b6-qed! 'dual-unit-ball-of-no-failure)

;; the unit ball is closed in R^E
(sp (make-wff (b6-alls '(m) (b6-imps (list b6-nvs) (list 'IS-TOP-CLOSED b6-PRm b6-UB)))))
(dk-peel!)
(b6-nvs-parts!)
(dk-split-all! (list (dk-cite! 'line-product-facts '(VEC m))))
(mac 'is-top-closed)
(subst (list '== (list 'PTS b6-PRm) b6-PRPm))
(let ((compu (list 'COMPLEMENT-IN b6-PRPm b6-UB)))
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? (dk-goal) 'SUBSET)
         (mac 'subset-def)
         (let ((f (dk-di-var!)))
           (b6-ub-parts! f)
           (dk-cite! 'fun-in-line-product '(VEC m) f)
           (dk-ass!)))
        (#t
         (dk-have! (list 'SUBSET compu (list 'PTS b6-PRm))
           (lambda () (subst (list '== (list 'PTS b6-PRm) b6-PRPm)) (mac 'subset-def)
                      (let* ((x (dk-di-var!)) (cm (dk-cite! 'complement-in-membership b6-PRPm b6-UB x)))
                        (if (dk-only! cm (list 'IN x compu)) (prop)))))
         (dk-have! (list 'FORALL 'tlx_ (list 'IMPLIES (list 'IN 'tlx_ compu) (list 'FORSOME 'tlw_ (list 'AND (list 'IN 'tlw_ (list 'OPENS b6-PRm)) (list 'AND '(IN tlx_ tlw_) (list 'SUBSET 'tlw_ compu))))))
           (lambda ()
