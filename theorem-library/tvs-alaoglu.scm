      (let* ((u (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'stu_) (dk-contains? h w))) "u") #t)))
        (b6-sub-open-in! 't 'a u)
        (uab! u)
