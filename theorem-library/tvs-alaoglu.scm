                                                           (begin (subst (list '= w (list 'INTERSECTION u 'bb))) (subst (list '= (b6-ii u 'a 'bb) (list 'INTERSECTION u 'bb))) (rfl))))))))))
  (subst e1) (subst e2)
  (subst (list '= o1 o2))
  (qrfl))
