;; the inclusion of a subspace is continuous
(define b6-incl (lambda (a) (list 'VNB-LAMBDA 'b6q_ a 'b6q_)))
(sp (make-wff (b6-alls '(t a) (b6-imps '((IS-TOP-SPACE t) (SUBSET a (PTS t))) (list 'IS-HOM-TOP-SPACE (b6-sub 't 'a) 't (b6-incl 'a))))))
(dk-peel!)
(b6-sub-facts! 't 'a)
(let ((st (b6-sub 't 'a)) (inc (b6-incl 'a)))
  (mac 'is-hom-top-space-def)
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? (dk-goal) 'IN)
         (subst (list '== (list 'PTS st) 'a))
         (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (dk-cite! 'subset-mem-fwd 'a '(PTS t) z) (dk-ass!))) (lambda () (dk-ass!))))
        (#t
         (let* ((u (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(OPENS t)))) (dk-peel!))))
                (pre (list 'PREIMAGE st inc u)) (w (list 'INTERSECTION u 'a)))
           (b6-sub-open-in! 't 'a u)
           (b6-set-eq! pre w
             (lambda (z)
               (let ((pm (dk-cite! 'preimage-membership st inc u z)))
                 (dk-have! (caddr pm) (lambda () (if (dk-only! pm (list 'IN z pre)) (prop))))
                 (dk-split! (caddr pm))
                 (dk-rewrite-h! (list 'IN z (list 'PTS st)) (list 'PTS st) 'a)
                 (dk-have! (list '= (list inc z) z) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
                 (dk-rewrite-h! (list 'IN (list inc z) u) (list inc z) z)
                 (let ((im (dk-cite! 'intersection-membership u 'a z))) (if (dk-only! im (list 'IN z u) (list 'IN z 'a)) (prop)))))
             (lambda (z)
               (let ((im (dk-cite! 'intersection-membership u 'a z)))
                 (dk-have! (list 'IN z u) (lambda () (if (dk-only! im (list 'IN z w)) (prop))))
                 (dk-have! (list 'IN z 'a) (lambda () (if (dk-only! im (list 'IN z w)) (prop)))))
               (dk-have! (list '= (list inc z) z) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
               (dk-have! (list 'IN z (list 'PTS st)) (lambda () (subst (list '== (list 'PTS st) 'a)) (dk-ass!)))
               (dk-have! (list 'IN (list inc z) u) (lambda () (subst (list '= (list inc z) z)) (dk-ass!)))
               (let ((pm (dk-cite! 'preimage-membership st inc u z))) (if (dk-only! pm (list 'IN z (list 'PTS st)) (list 'IN (list inc z) u)) (prop)))))
           (subst (list '= pre w))
           (dk-ass!)))))))
(b6-qed! 'subspace-inclusion-continuous)

;; a continuous map with values in a is continuous into the subspace a
(sp (make-wff (b6-alls '(s t a f)
  (b6-imps '((IS-HOM-TOP-SPACE s t f) (SUBSET a (PTS t)) (FORALL b6x_ (IMPLIES (IN b6x_ (PTS s)) (IN (f b6x_) a))))
    (list 'IS-HOM-TOP-SPACE 's (b6-sub 't 'a) 'f)))))
(dk-peel!)
(let ((hom '(IS-HOM-TOP-SPACE s t f)) (st (b6-sub 't 'a)) (vals (dk-ctx-form '(FORALL b6x_ (IMPLIES (IN b6x_ (PTS s)) (IN (f b6x_) a))))))
  (dk-project! '(IS-TOP-SPACE s) 'is-hom-top-space-def hom)
  (dk-project! '(IS-TOP-SPACE t) 'is-hom-top-space-def hom)
  (dk-project! '(IN f (FUN (PTS s) (PTS t))) 'is-hom-top-space-def hom)
  (b6-sub-facts! 't 'a)
  (b6-top! 's)
  (let ((pre (dk-project! '(FORALL u (IMPLIES (IN u (OPENS t)) (IN (PREIMAGE s f u) (OPENS s)))) 'is-hom-top-space-def hom)))
    (mac 'is-hom-top-space-def)
    (dk-conj-close!
      (lambda ()
        (cond
          ((dk-ass!) #t)
          ((dk-head-is? (dk-goal) 'IN)
           (subst (list '== (list 'PTS st) 'a))
           (let ((fi (dk-cite! 'fun-codomain-iff '(PTS s) '(PTS t) 'f)))
             (dk-have! '(IN f (FUN (PTS s))) (lambda () (if (dk-only! fi '(IN f (FUN (PTS s) (PTS t)))) (prop)))))
           (let ((fi2 (dk-cite! 'fun-codomain-iff '(PTS s) 'a 'f)))
             (dk-have! (caddr (caddr fi2)) (lambda () (let ((x (dk-di-var!))) (dk-apply! vals x) (dk-ass!))))
             (if (dk-only! fi2 '(IN f (FUN (PTS s))) (caddr (caddr fi2))) (prop))))
          (#t
           (let* ((w (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (list 'OPENS st)))) (dk-peel!))))
                  (u (b6-sub-open-out! 't 'a w))
                  (pw (list 'PREIMAGE 's 'f w)) (pu (list 'PREIMAGE 's 'f u)))
             (dk-apply! pre u)
             (b6-set-eq! pw pu
               (lambda (z)
                 (let ((pm (dk-cite! 'preimage-membership 's 'f w z)) (pm2 (dk-cite! 'preimage-membership 's 'f u z)))
                   (dk-have! (caddr pm) (lambda () (if (dk-only! pm (list 'IN z pw)) (prop))))
                   (dk-split! (caddr pm))
                   (dk-rewrite-h! (list 'IN (list 'f z) w) w (list 'INTERSECTION u 'a))
                   (let ((im (dk-cite! 'intersection-membership u 'a (list 'f z))))
                     (dk-have! (list 'IN (list 'f z) u) (lambda () (if (dk-only! im (list 'IN (list 'f z) (list 'INTERSECTION u 'a))) (prop)))))
                   (if (dk-only! pm2 (list 'IN z '(PTS s)) (list 'IN (list 'f z) u)) (prop))))
               (lambda (z)
                 (let ((pm (dk-cite! 'preimage-membership 's 'f w z)) (pm2 (dk-cite! 'preimage-membership 's 'f u z)))
                   (dk-have! (caddr pm2) (lambda () (if (dk-only! pm2 (list 'IN z pu)) (prop))))
                   (dk-split! (caddr pm2))
                   (dk-apply! vals z)
                   (let ((im (dk-cite! 'intersection-membership u 'a (list 'f z))))
                     (dk-have! (list 'IN (list 'f z) (list 'INTERSECTION u 'a)) (lambda () (if (dk-only! im (list 'IN (list 'f z) u) (list 'IN (list 'f z) 'a)) (prop)))))
                   (dk-have! (list 'IN (list 'f z) w) (lambda () (subst (list '= w (list 'INTERSECTION u 'a))) (dk-ass!)))
                   (if (dk-only! pm (list 'IN z '(PTS s)) (list 'IN (list 'f z) w)) (prop)))))
             (subst (list '= pw pu))
             (dk-ass!))))))))
(b6-qed! 'hom-into-subspace)

;; a closed set inside a subspace is closed in the subspace
(define (b6-comp a b) (list 'COMPLEMENT-IN a b))
(sp (make-wff (b6-alls '(t a bb) (b6-imps '((IS-TOP-SPACE t) (SUBSET a (PTS t)) (IS-TOP-CLOSED t bb) (SUBSET bb a)) (list 'IS-TOP-CLOSED (b6-sub 't 'a) 'bb)))))
(dk-peel!)
(b6-sub-facts! 't 'a)
(let* ((st (b6-sub 't 'a)) (co (b6-comp '(PTS t) 'bb)) (ca (b6-comp 'a 'bb)))
  (dk-project! (list 'IN co '(OPENS t)) 'is-top-closed '(IS-TOP-CLOSED t bb))
  (b6-sub-open-in! 't 'a co)
  (b6-set-eq! ca (list 'INTERSECTION co 'a)
    (lambda (z)
      (let ((m1 (dk-cite! 'complement-in-membership 'a 'bb z)) (m2 (dk-cite! 'complement-in-membership '(PTS t) 'bb z))
            (im (dk-cite! 'intersection-membership co 'a z)))
        (dk-have! (caddr m1) (lambda () (if (dk-only! m1 (list 'IN z ca)) (prop))))
        (dk-split! (caddr m1))
        (dk-cite! 'subset-mem-fwd 'a '(PTS t) z)
        (dk-only! m2 im (list 'IN z 'a) (list 'IN z '(PTS t)) (list 'NOT (list 'IN z 'bb)))
        (prop)))
    (lambda (z)
      (let ((m1 (dk-cite! 'complement-in-membership 'a 'bb z)) (m2 (dk-cite! 'complement-in-membership '(PTS t) 'bb z))
            (im (dk-cite! 'intersection-membership co 'a z)))
        (dk-only! m1 m2 im (list 'IN z (list 'INTERSECTION co 'a)))
        (prop))))
  (mac 'is-top-closed)
  (dk-conj-close!
    (lambda ()
      (subst (list '== (list 'PTS st) 'a))
      (if (dk-head-is? (dk-goal) 'SUBSET) (dk-ass!)
          (begin (subst (list '= ca (list 'INTERSECTION co 'a))) (dk-ass!))))))
(b6-qed! 'closed-in-subspace)

;; a closed subset of a compact space is compact
(define (b6-cpt-clause sp)
  (list 'FORALL 'c (list 'IMPLIES (list 'FORALL 'u (list 'IMPLIES '(IN u c) (list 'IN 'u (list 'OPENS sp))))
                     (list 'IMPLIES (list '== '(BIG-UNION u c u) (list 'PTS sp))
                       (list 'FORSOME 'f_ (list 'AND '(SUBSET f_ c) (list 'AND '(IN (CARD f_) NN)
                         (list '== '(BIG-UNION u f_ u) (list 'PTS sp)))))))))
(sp (make-wff (b6-alls '(s bb) (b6-imps '((IS-COMPACT-T s) (IS-TOP-CLOSED s bb)) (list 'IS-COMPACT-T (b6-sub 's 'bb))))))
(dk-peel!)
(dk-project! '(IS-TOP-SPACE s) 'is-compact-t '(IS-COMPACT-T s))
(dk-project! '(SUBSET bb (PTS s)) 'is-top-closed '(IS-TOP-CLOSED s bb))
(b6-sub-facts! 's 'bb)
(let* ((ss (b6-sub 's 'bb)) (co (b6-comp '(PTS s) 'bb))
       (ccl (dk-project! (b6-cpt-clause 's) 'is-compact-t '(IS-COMPACT-T s))))
  (dk-project! (list 'IN co '(OPENS s)) 'is-top-closed '(IS-TOP-CLOSED s bb))
  (mac 'is-compact-t)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((ld (dk-peel!))
                 (cov (find-first (lambda (h) (dk-head-is? h 'FORALL)) ld))
                 (eqc (find-first (lambda (h) (dk-head-is? h '==)) ld))
                 (cc (caddr (cadr (caddr cov))))
                 (buc (cadr eqc))
                 (dd (list 'SEP 'b6d_ '(OPENS s) (list 'OR (list 'IN '(INTERSECTION b6d_ bb) cc) (list '= 'b6d_ co))))
                 (bud (list 'BIG-UNION 'u dd 'u)))
            (dk-have! (list 'IN dd 'SET) (lambda () (sep-set) (ass)))
            (dk-have! (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u dd) '(IN u (OPENS s))))
              (lambda () (let ((e (dk-di-var!))) (sep-me (dk-ctx-form (list 'IN e dd))) (dk-split-all!) (dk-ass!))))
            (dk-have! (list 'IN co dd) (lambda () (in-sep! (lambda () (ass)) (lambda () (dk-have! (list '= co co) (lambda () (rfl))) (dk-only! (list '= co co)) (prop)))))
            (b6-set-eq! bud '(PTS s)
              (lambda (z)
                (let* ((ld2 (dk-landed (lambda () (bu-me (list 'IN z bud)))))
                       (v (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) dd))) ld2))))
                  (sep-me (list 'IN v dd)) (dk-split-all!)
                  (b6-open-pts! 's v z) (dk-ass!)))
              (lambda (z)
                (let ((cm (dk-cite! 'complement-in-membership '(PTS s) 'bb z)))
                  (dk-have! (list 'IMPLIES (list 'NOT (list 'IN z 'bb)) (list 'IN z bud))
                    (lambda () (di) (dk-have! (list 'IN z co) (lambda () (if (dk-only! cm (list 'IN z '(PTS s)) (list 'NOT (list 'IN z 'bb))) (prop))))
                               (for-each (lambda (l) (dk-focus! l) (dk-ass!)) (dk-opened (lambda () (bu-mi co)))))))
                (dk-have! (list 'IMPLIES (list 'IN z 'bb) (list 'IN z bud))
                  (lambda ()
                    (di)
                    (dk-have! (list 'IN z buc) (lambda () (subst eqc) (subst (list '== (list 'PTS ss) 'bb)) (dk-ass!)))
                    (let* ((ld3 (dk-landed (lambda () (bu-me (list 'IN z buc)))))
                           (w (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) cc))) ld3))))
                      (dk-apply! cov w)
                      (let ((u (b6-sub-open-out! 's 'bb w)))
                        (dk-have! (list 'IN u dd)
                          (lambda () (in-sep! (lambda () (ass))
                                              (lambda () (dk-have! (list 'IN (list 'INTERSECTION u 'bb) cc) (lambda () (subst (list '= (list 'INTERSECTION u 'bb) w)) (dk-ass!)))
                                                         (dk-only! (list 'IN (list 'INTERSECTION u 'bb) cc)) (prop)))))
                        (dk-rewrite-h! (list 'IN z w) w (list 'INTERSECTION u 'bb))
                        (let ((im (dk-cite! 'intersection-membership u 'bb z)))
                          (dk-have! (list 'IN z u) (lambda () (if (dk-only! im (list 'IN z (list 'INTERSECTION u 'bb))) (prop)))))
                        (for-each (lambda (l) (dk-focus! l) (dk-ass!)) (dk-opened (lambda () (bu-mi u))))))))
                (dk-only! (list 'IMPLIES (list 'NOT (list 'IN z 'bb)) (list 'IN z bud)) (list 'IMPLIES (list 'IN z 'bb) (list 'IN z bud)))
                (prop)))
            (dk-have! (list '== bud '(PTS s)) (lambda () (subst (list '= bud '(PTS s))) (qrfl)))
            (dk-apply! ccl dd)
            (let* ((ff (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'f_) (dk-contains? h dd))) "the finite subcover") #t))
                   (fs (list 'SEP 'b6v_ ff (list 'IN '(INTERSECTION b6v_ bb) cc)))
                   (phi (list 'VNB-LAMBDA 'b6u_ '(OPENS s) '(INTERSECTION b6u_ bb)))
                   (gg (list 'IMAGE phi fs))
                   (bgg (list 'BIG-UNION 'u gg 'u)))
              (define (phival! v)      ; v in OPENS s: (= (phi v) (INTERSECTION v bb))
                (dk-have! (list '= (list phi v) (list 'INTERSECTION v 'bb)) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
              (dk-cite! 'subclass-of-set-is-set ff dd)
              (dk-have! (list 'IN fs 'SET) (lambda () (sep-set) (ass)))
              (b6-and! (list 'IN ff 'SET) (list 'IN (list 'CARD ff) 'NN))
              (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ fs) (list 'IN 'z_ ff)))
                (lambda () (let ((e (dk-di-var!))) (sep-me (dk-ctx-form (list 'IN e fs))) (dk-split-all!) (dk-ass!))))
              (b6-and! (list 'IN fs 'SET) (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ fs) (list 'IN 'z_ ff))))
              (dk-cite! 'card-subset-nn ff fs)
              (dk-cite! 'card-image-finite phi fs)
              (dk-have! (list 'SUBSET gg cc)
                (lambda ()
                  (mac 'subset-def)
                  (let* ((w (dk-di-var!)) (imf (dk-cite! 'image-membership-iff phi fs w)))
                    (dk-have! (caddr imf) (lambda () (if (dk-only! imf (list 'IN w gg)) (prop))))
                    (dk-split! (caddr imf))
                    (let ((v (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h fs) (dk-contains? h w))) "preimage") #t)))
                      (sep-me (list 'IN v fs)) (dk-split-all!)
                      (dk-cite! 'subset-mem-fwd ff dd v)
                      (sep-me (list 'IN v dd)) (dk-split-all!)
                      (phival! v)
                      (dk-have! (list '= w (list 'INTERSECTION v 'bb)) (lambda () (subst (list '= w (list phi v))) (dk-ass!)))
                      (subst (list '= w (list 'INTERSECTION v 'bb)))
                      (dk-ass!)))))
              (b6-set-eq! bgg 'bb
                (lambda (z)
                  (let* ((ld3 (dk-landed (lambda () (bu-me (list 'IN z bgg)))))
                         (w (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) gg))) ld3)))
                         (imf (dk-cite! 'image-membership-iff phi fs w)))
                    (dk-have! (caddr imf) (lambda () (if (dk-only! imf (list 'IN w gg)) (prop))))
                    (dk-split! (caddr imf))
