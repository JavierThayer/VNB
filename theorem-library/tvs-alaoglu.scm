;;; pointwise-closed sets of real functions (the engine of Prop 3.25), Banach-Alaoglu (Cor 3.27) for the polar of a
;;; neighbourhood of 0 in a real TVS, and Prop 3.29 (the dual unit ball of a normed space).  The weak* topology is the
;;; topology of POINTWISE convergence, i.e. the subspace topology of the product TPRODUCT-TOP(E, x |-> R).
;;; Agent TB-6 (worker-08), 2026-10-26.  DESTINATION: theorem-library/tvs-alaoglu.scm.  Library: analysis.
;;; Helper prefix: b6-.
;;; Needs: top-product (tych.scm: TPRODUCT-TOP, tychonoff, compact-t-continuous-onto, tproj-continuous, tprod-hom-iff,
;;; hom-top-space-ptwise-eq), tvs-kernel-closed (IS-TOP-CLOSED, top-open-of-local), heine-borel-ccint,
;;; metric-top-compact, subspace-top-of-metric-top, subspace-top-*; tb6-vocab.scm (TOP-DUAL, POLAR, WEAK-STAR-TOP,
;;; DUAL-WEAK-STAR-TOP, DUAL-UNIT-BALL); tvs-geometric-hb (scratchpad/tb2a/geo.scm: tvs-open-zero-absorbing,
;;; tvs-local-bound-of-one-sided, tvs-continuous-of-local-bound); tvs-minkowski (mink-set-intro, mink-set-elim,
;;; rmod-act-type); dual-nvs (dual-vec-fun, dual-vec-blf, dual-vec-intro); the tree's dual-norm-*-nvs, vnrm-*, nvs-*.
;;; Load window: after geo.scm and tych.scm (probe chain scratchpad/tb6/n1.scm; page audit n2.scm).

(define (b6-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; B6 OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (b6-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    c))
(define (b6-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (b6-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define (b6-subset! x y memb!)
  (dk-have! (list 'SUBSET x y) (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (memb! w)))))
(define (b6-set-eq! a b fwd! bwd!)     ; (= a b) by extensionality: FWD! z proves z in b from z in a, BWD! the converse
  (dk-have! (list 'FORALL 'b6z_ (list 'IFF (list 'IN 'b6z_ a) (list 'IN 'b6z_ b)))
    (lambda () (let ((z (begin (di) (cadr (cadr (dk-goal))))))
                 (dk-iff! (lambda (g) (equal? g (list 'IN z b))) (lambda () (fwd! z)) (lambda () (bwd! z))))))
  (dk-cite! 'class-extensionality a b))
(define (b6-top! s)                    ; IS-TOP-SPACE s in context: PTS, OPENS sets; OPENS in POWER POWER PTS
  (if (not (dk-asm? (list 'IN (list 'PTS s) 'SET)))
      (begin
        (dk-project! (list 'IN (list 'PTS s) (list 'OPENS s)) 'is-top-space (list 'IS-TOP-SPACE s))
        (dk-project! (list 'IN (list 'OPENS s) (list 'POWER (list 'POWER (list 'PTS s)))) 'is-top-space (list 'IS-TOP-SPACE s))
        (dk-cite! 'membership-implies-sethood (list 'PTS s) (list 'OPENS s))
        (dk-cite! 'membership-implies-sethood (list 'OPENS s) (list 'POWER (list 'POWER (list 'PTS s)))))))
(define (b6-open-pts! s w x)           ; w in OPENS s, x in w: x in PTS s
  (dk-cite! 'power-mem-in (list 'POWER (list 'PTS s)) (list 'OPENS s) w)
  (dk-cite! 'power-mem-in (list 'PTS s) w x))
(define (b6-sub t a) (list 'SUBSPACE-TOP t a))
(define (b6-subopens t a) (list 'SEP 'stw_ (list 'POWER a) (list 'FORSOME 'stu_ (list 'AND (list 'IN 'stu_ (list 'OPENS t)) (list '= 'stw_ (list 'INTERSECTION 'stu_ a))))))
(define (b6-sub-facts! t a)            ; IS-TOP-SPACE t, a subset PTS t: the subspace's top-space fact and read-offs
  (b6-top! t)
  (dk-cite! 'subclass-of-set-is-set a (list 'PTS t))
  (dk-cite! 'subspace-top-is-top-space t a)
  (dk-cite! 'subspace-top-pts t a)
  (dk-cite! 'subspace-top-opens t a)
  (dk-cite! 'power-set a))
(define (b6-inter-sub! u a)            ; (SUBSET (INTERSECTION u a) a), and the intersection is a set
  (b6-subset! (list 'INTERSECTION u a) a
    (lambda (q) (let ((im (dk-cite! 'intersection-membership u a q))) (if (dk-only! im (list 'IN q (list 'INTERSECTION u a))) (prop)))))
  (dk-cite! 'subclass-of-set-is-set (list 'INTERSECTION u a) a))
(define (b6-sub-open-in! t a u)        ; u open in t: (INTERSECTION u a) open in the subspace
  (let ((w (list 'INTERSECTION u a)))
    (b6-inter-sub! u a)
    (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ w) (list 'IN 'z_ a)))
      (lambda () (let ((e (dk-di-var!))) (dk-cite! 'subset-mem-fwd w a e) (dk-ass!))))
    (dk-cite! 'power-mem-intro a w)
    (dk-have! (list 'IN w (list 'OPENS (b6-sub t a)))
      (lambda () (subst (list '== (list 'OPENS (b6-sub t a)) (b6-subopens t a)))
                 (in-sep! (lambda () (ass)) (lambda () (ew u) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))))
(define (b6-sub-open-out! t a w)       ; w open in the subspace: an open u of t with (= w (INTERSECTION u a)); returns u
  (let ((ex (list 'FORSOME 'stu_ (list 'AND (list 'IN 'stu_ (list 'OPENS t)) (list '= w (list 'INTERSECTION 'stu_ a))))))
    (dk-have! ex (lambda () (let ((h (dk-rewrite-h! (list 'IN w (list 'OPENS (b6-sub t a))) (list 'OPENS (b6-sub t a)) (b6-subopens t a))))
                              (sep-me h) (dk-split-all!) (dk-ass!))))
    (dk-skolem! (dk-ctx-form ex) #t)))

