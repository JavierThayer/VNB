    (b6-set-eq! (b6-ii u 'a 'bb) (list 'INTERSECTION u 'bb)
      (lambda (z) (let ((i1 (dk-cite! 'intersection-membership (list 'INTERSECTION u 'a) 'bb z)) (i2 (dk-cite! 'intersection-membership u 'a z))
                        (i3 (dk-cite! 'intersection-membership u 'bb z)))
                    (dk-only! i1 i2 i3 (list 'IN z (b6-ii u 'a 'bb))) (prop)))
      (lambda (z) (let ((i1 (dk-cite! 'intersection-membership (list 'INTERSECTION u 'a) 'bb z)) (i2 (dk-cite! 'intersection-membership u 'a z))
                        (i3 (dk-cite! 'intersection-membership u 'bb z)))
                    (dk-have! (list 'IN z 'bb) (lambda () (if (dk-only! i3 (list 'IN z (list 'INTERSECTION u 'bb))) (prop))))
                    (dk-cite! 'subset-mem-fwd 'bb 'a z)
                    (dk-only! i1 i2 i3 (list 'IN z (list 'INTERSECTION u 'bb)) (list 'IN z 'a)) (prop)))))
  (b6-set-eq! o1 o2
    (lambda (w)
      (sep-me (dk-ctx-form (list 'IN w o1))) (dk-split-all!)
      (let* ((v (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'stu_) (dk-contains? h w))) "v") #t))
             (u (b6-sub-open-out! 't 'a v)))
