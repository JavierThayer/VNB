(define (b6-iv-out! x y)               ; (IN (x y) (PTS (IF y))) in context: (x y) in the interval and in RR
  (b6-ify! y)
  (let* ((h1 (dk-rewrite-h! (list 'IN (list x y) (list 'PTS (list b6-IF y))) (list b6-IF y) (b6-ify y)))
         (h2 (dk-rewrite-h! h1 (list 'PTS (b6-ify y)) (b6-iv y)))
