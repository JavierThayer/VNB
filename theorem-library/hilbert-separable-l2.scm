;;; ======== slice b5-h
;;; b5-h.scm -- slice H: l2(I) is a Hilbert space.  A Cauchy sequence f of l2(I) has
;;; Cauchy coordinates (l2-coord-le), which converge in CC (cc-complete) to b(k), b chosen
;;; by CHOICE; the tail estimate (l2-cauchy-esum-tail) at e = 1 puts f(N1) - b in l2(I),
;;; so the limit is the l2 element f(N1) - (f(N1) - b), whose distance to f(n) is
;;; sqrt(ESUM |f(n)(k) - b(k)|^2) <= e for n large.  Agent BA-ONB5, 2026-11-09.

(define b5h-V '(L2-CIPS ix))
(define b5h-M '(IP-METRIC-SPACE (L2-CIPS ix)))
