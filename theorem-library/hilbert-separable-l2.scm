                      (list 'AND '(IN b5s_ SET) (list 'AND '(IN (CARD b5s_) NN) (list 'SUBSET 'b5s_ (list 'DOM gg))))
                      (list '<= (list 'FINSUM 'RR-POS-STAR-ADD-MONOID gg 'b5s_) ee)))))
            (dk-have! bu (lambda () (b5g-partial-bound! n)))
            (let ((iff (dk-cite! 'rr-pos-star-membership ee)))
