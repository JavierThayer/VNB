          (dk-split-all! (list (dk-cite! 'l2-dist-esum 'ix a c)))
          (b5-and! (list 'IN e 'RR) (list '<= 0 e))
          (dk-split-all! (list (dk-cite! 'sqrt-nonneg e)))
          (dk-have! (list 'IN (b5h-dist a c) 'RR) (lambda () (subst (list '= (b5h-dist a c) sq)) (dk-ass!)))))
    sq))

(sp (make-wff '(FORALL ix (IMPLIES (IN ix SET) (IS-HILBERT-SPACE (L2-CIPS ix))))))
