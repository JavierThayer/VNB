      (lambda () (subst de) (let ((z (cadr (car (dk-peel!))))) (b5f-gz! a c z) (dk-close-if! dk-lam-b! b5-close!))))))
    de))
;; MAGNITUDE(X - 0) <= B from X real, 0 <= X, X <= B (B real)
(define (b5g-mag-real! x b)
  (let ((x0 (list '- x 0)))
    (if (not (dk-asm? (list 'IN x 'CC))) (fact 'rr-subset-cc x))
    (dk-have! (list '= x0 x) (lambda () (mac 'binary-minus-def) (fact 'cc-zero-in) (crs)))
    (subst (list '= x0 x))
    (let* ((h1 (dk-cite! 'cc-magnitude-le-re-im x))
           (h2 (begin (fact 'cc-re-of-real x) (dk-rewrite-h! h1 (list 'REAL-PART x) x)))
           (h3 (begin (fact 'rr-imag-part-zero x) (dk-rewrite-h! h2 (list 'IMAG-PART x) 0))))
      (fact 'rr-abs-of-nonneg x)
      (dk-have! '(<= 0 0) (lambda () (dk-ineq! '(IN 0 RR))))
      (fact 'rr-abs-of-nonneg 0)
      (fact 'cc-magnitude-closed x)
      (dk-ineq! h3 (list '= (list 'ABS x) x) '(= (ABS 0) 0) (list '<= x b)
                (list 'IN x 'RR) (list 'IN b 'RR) (list 'IN (list 'MAGNITUDE x) 'RR)))))
;; the bridge for G(A, C) on a finite W <= ix: lands P(W) real, 0 <= P(W), P(W) = S(W); returns S(W)
(define (b5g-bridge! a c w)
  (let* ((g (b5f-G a c)) (dg (list 'DOM g)) (de (b5g-rps-family! a c)))
    (if (not (dk-asm? (list 'SUBSET w dg)))
        (dk-have! (list 'SUBSET w dg) (lambda () (subst de) (dk-ass!))))
    (dk-split-all! (list (dk-cite! 'rps-finsum-eq-cc-finsum g w)))
    (list 'FINSUM '(NORMED-AG-AS-ABELIAN-GROUP CC-NAG) g w)))

