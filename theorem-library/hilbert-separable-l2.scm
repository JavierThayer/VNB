;;; the coordinates of a Cauchy sequence are Cauchy in CC
(define (b5h-coord-cauchy! cy k)
  (let ((cl (list 'IS-CAUCHY-SEQ 'CC-MS (b5g-coord k))))
    (if (not (dk-asm? cl))
        (dk-have! cl
          (lambda ()
            (mac 'is-cauchy-seq)
            (dk-conj-close!
              (lambda ()
                (let ((g (dk-goal)))
                  (cond
                    ((dk-asm? g) (ass))
                    ((dk-head-is? g 'IN)
                     (subst '(== (PTS CC-MS) CC))
                     (dk-lam-type! (lambda () (let ((j (cadr (car (dk-peel!))))) (b5g-fj! j) (b5f-pt! (list 'f j) k) (dk-ass!)))))
                    (#t
                     (let* ((eps (cadr (find-first (dk-head? 'POS-RR) (dk-peel!))))
                            (nb (dk-skolem! (dk-apply! cy eps)))
                            (tl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nb) (dk-contains? f 'DIST))) "the tail")))
                       (fact 'rr-pos-rr-in-rr eps)
                       (ew nb)
                       (dk-conj-close!
                         (lambda ()
                           (if (dk-asm? (dk-goal))
                               (ass)
                               (let* ((ld (dk-peel!))
                                      (dg (cadr (dk-goal)))
                                      (m (cadr (cadr dg))) (n2 (cadr (caddr dg))))
                                 (b5g-fj! m) (b5g-fj! n2)
                                 (b5f-pt! (list 'f m) k) (b5f-pt! (list 'f n2) k)
                                 (dk-lam-b!)
                                 (let* ((u (list (list 'f m) k)) (v (list (list 'f n2) k))
                                        (mg (list 'MAGNITUDE (list '- u v))))
                                   (fact 'cc-ms-dist u v)
                                   (subst (list '== (list '(DIST CC-MS) u v) mg))
                                   (fact 'l2-coord-le 'ix (list 'f m) (list 'f n2) k)
                                   (b5-and! (list '<= nb m) (list '<= nb n2))
                                   (dk-apply! tl m n2)
                                   (b5h-dist-rr! (list 'f m) (list 'f n2))
                                   (fact 'cc-sub-in-cc u v)
                                   (fact 'cc-magnitude-closed (list '- u v))
                                   (dk-ineq! (list '<= mg (b5h-dist (list 'f m) (list 'f n2)))
                                             (list '<= (b5h-dist (list 'f m) (list 'f n2)) eps)
                                             (list 'IN mg 'RR) (list 'IN (b5h-dist (list 'f m) (list 'f n2)) 'RR)
                                             (list 'IN eps 'RR)))))))))))))))
    cl)))
;;; the chosen limit of coordinate k: (CHOICE S_k) in CC, and the coordinate converges to it
(define (b5h-choice! cy k)
  (let* ((sk (b5h-sep k)) (ch (list 'CHOICE sk)))
    (if (not (dk-asm? (list 'IN ch 'CC)))
        (begin
          (b5h-coord-cauchy! cy k)
          (let* ((cv (dk-apply! (dk-cite! 'complete-cauchy-converges 'CC-MS) (b5g-coord k)))
                 (y (dk-skolem! (dk-landed-1 (lambda () (mac-h 'converges cv)))))
                 (cvy (list 'CONVERGES-TO 'CC-MS (b5g-coord k) y)))
            (dk-project! (list 'IN y '(PTS CC-MS)) 'converges-to cvy)
            (dk-rewrite-h! (list 'IN y '(PTS CC-MS)) '(PTS CC-MS) 'CC)
            (dk-have! (list 'IN y sk) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
            (dk-have! (list 'FORSOME 'b5x_ (list 'IN 'b5x_ sk)) (lambda () (ew y) (dk-ass!)))
            (let ((m (dk-cite! 'choice-axiom sk)))
              (dk-landed (lambda () (sep-me m)))))))
    ch))

;;; the main argument, on the focus goal (CONVERGES M f) with the Cauchy hypothesis unfolded
(define (b5h-main! cy)
  (b5h-pos1!)
  ;; the limit family bb
  (let* ((ex (list 'FORSOME 'b5b_ (list 'AND '(IN b5b_ (FUN ix CC))
               (list 'FORALL 'b5k_ (list 'IMPLIES '(IN b5k_ ix) (list 'CONVERGES-TO 'CC-MS (b5g-coord 'b5k_) '(b5b_ b5k_))))))))
    (dk-have! ex
      (lambda ()
        (ew b5h-bdef)
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (if (dk-head-is? g 'IN)
                  (dk-lam-type! (lambda () (let ((k (cadr (car (dk-peel!))))) (b5h-choice! cy k) (dk-ass!))))
                  (let ((k (cadr (car (dk-peel!)))))
                    (b5h-choice! cy k)
                    (dk-lam-b!)
                    (b5-close!))))))))
    (let* ((bb (dk-skolem! ex))
           (kb (dk-cite! 'l2-cauchy-esum-tail 'ix 'f bb))
           (n1 (dk-skolem! (dk-apply! kb 1)))
           (t1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n1) (dk-contains? f 'ESUM))) "the e = 1 tail")))
      (fact 'nn-le-refl n1)
      (b5g-fj! n1)
      (dk-split-all! (list (dk-apply! t1 n1)))
      (let* ((fn1 (list 'f n1))
             (dd (list 'VNB-LAMBDA 'b5d_ 'ix (list '- (list fn1 'b5d_) (list bb 'b5d_))))
             (qd (list 'VNB-LAMBDA 'l2k_ 'ix (list '* (list 'MAGNITUDE (list dd 'l2k_)) (list 'MAGNITUDE (list dd 'l2k_)))))
             (g1 (b5f-G fn1 bb))
             (vn '(L2F-VNEG ix)) (va '(L2F-VADD ix))
             (lim (list va fn1 (list vn dd))))
        (dk-have! (list 'IN dd '(FUN ix CC))
          (lambda () (dk-lam-type! (lambda () (let ((z (cadr (car (dk-peel!)))))
                                                (b5f-pt! fn1 z) (b5f-pt! bb z) (fact 'cc-sub-in-cc (list fn1 z) (list bb z)) (dk-ass!))))))
        (dk-have! (list 'IN qd '(FUN ix RR))
          (lambda () (dk-lam-type! (lambda () (let ((z (cadr (car (dk-peel!)))))
                                                (b5f-gz! fn1 bb z) (dk-lam-b!) (dk-ass!))))))
        (b5f-g-typ! fn1 bb)
        (dk-fun-ext! qd g1 'ix 'RR #f #f
          (lambda (z) (b5f-gz! fn1 bb z) (b5g-lamb?!) (b5g-lamb?!) (b5-close!)))
        (dk-have! (list 'IN (list 'ESUM qd) 'RR) (lambda () (subst (list '= qd g1)) (dk-ass!)))
        (fact 'l2-families-intro 'ix dd)
        (fact 'l2-vneg-type 'ix dd)
        (fact 'l2-vadd-type 'ix fn1 (list vn dd))
        ;; lim z = bb z
        (let ((lz (list 'FORALL 'b5z_ (list 'IMPLIES '(IN b5z_ ix) (list '= (list lim 'b5z_) (list bb 'b5z_))))))
          (dk-have! lz
            (lambda ()
              (let ((z (cadr (car (dk-peel!)))))
                (b5f-pt! fn1 z) (b5f-pt! bb z)
                (dk-apply! (dk-cite! 'l2-vadd-apply 'ix fn1 (list vn dd)) z)
                (dk-apply! (dk-cite! 'l2-vneg-apply 'ix dd) z)
                (subst (list '= (list lim z) (list '+ (list fn1 z) (list (list vn dd) z))))
                (subst (list '= (list (list vn dd) z) (list '- (list dd z))))
                (dk-lam-b!)
                (mac 'binary-minus-def)
                (crs))))
          ;; the convergence
          (mac 'converges)
          (ew lim)
          (mac 'converges-to)
          (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond
                  ((dk-asm? g) (ass))
                  ((dk-head-is? g 'IN)
                   (subst (list '== (list 'PTS b5h-M) (list 'VEC b5h-V)))
                   (subst (list '== (list 'VEC b5h-V) b5h-LF))
                   (dk-ass!))
                  (#t
                   (let* ((eps (cadr (find-first (dk-head? 'POS-RR) (dk-peel!))))
                          (nb (dk-skolem! (dk-apply! kb eps)))
                          (tb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nb) (dk-contains? f 'ESUM))) "the tail")))
                     (fact 'rr-pos-rr-in-rr eps)
                     (fact 'rr-lt-of-pos-rr eps)
                     (ew nb)
                     (dk-conj-close!
                       (lambda ()
                         (if (dk-asm? (dk-goal))
                             (ass)
                             (let* ((ld (dk-peel!))
                                    (n (cadr (find-first (dk-head? 'IN) ld)))
                                    (fn (list 'f n))
                                    (gb (b5f-G fn bb)) (gl (b5f-G fn lim))
                                    (e (list 'ESUM gb)) (sq (list 'SQRT e)))
                               (b5g-fj! n)
                               (dk-split-all! (list (dk-apply! tb n)))
                               (dk-split-all! (list (dk-cite! 'l2-dist-esum 'ix fn lim)))
                               (b5f-g-typ! fn bb)
                               (b5f-g-typ! fn lim)
                               (dk-fun-ext! gl gb 'ix 'RR #f #f
                                 (lambda (z)
                                   (b5f-pt! fn z) (b5f-pt! bb z) (b5f-pt! lim z)
                                   (dk-apply! lz z)
                                   (dk-lam-b!)
                                   (subst (list '= (list lim z) (list bb z)))
                                   (b5f-gz! fn bb z)
                                   (b5-close!)))
                               (subst (list '= (b5h-dist fn lim) (list 'SQRT (list 'ESUM gl))))
                               (subst (list '= gl gb))
                               (dk-have! (list '<= 0 e) (lambda () (subst (list '= gb gl)) (dk-ass!)))
                               (b5-and! (list 'IN e 'RR) (list '<= 0 e))
                               (dk-split-all! (list (dk-cite! 'sqrt-nonneg e)))
                               (fact 'sqrt-sq e)
                               (dk-have! (list '<= 0 eps) (lambda () (dk-ineq! (list '< 0 eps) (list 'IN eps 'RR))))
                               (dk-le-chain! (list '* sq sq) e (list '* eps eps))
                               (fact 'rr-square-le-imp-le sq eps)
                               (b5-close!))))))))))))))))

(dk-have! (list 'IS-COMPLETE b5h-M)
  (lambda ()
    (mac 'is-complete)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal))
            (ass)
            (let* ((ld (dk-peel!))
                   (cy0 (find-first (dk-head? 'IS-CAUCHY-SEQ) ld)))
              (dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'is-cauchy-seq cy0)))))
              (let ((cy (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'DIST))) "the Cauchy condition")))
                (dk-have! (list 'IN 'f (list 'FUN 'NN b5h-LF))
                  (lambda () (subst (list '== b5h-LF (list 'VEC b5h-V)))
                             (subst (list '== (list 'VEC b5h-V) (list 'PTS b5h-M))) (dk-ass!)))
                (b5h-main! cy))))))))
(mac 'is-hilbert-space)
(dk-conj-close! (lambda () (dk-ass!)))
(b5-done! 'l2-is-hilbert-space)

