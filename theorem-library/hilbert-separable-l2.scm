;;; The iff (th-main s.2.1): a Hilbert space is separable iff it has a countable orthonormal basis.
(sp (make-wff '(FORALL v (IMPLIES (IS-HILBERT-SPACE v)
  (IFF (IS-SEPARABLE (IP-METRIC-SPACE v))
       (FORSOME ix (FORSOME e (AND (IS-ORTHONORMAL-BASIS v ix e) (IS-COUNTABLE ix)))))))))
(dk-peel!)
