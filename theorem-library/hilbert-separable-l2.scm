;; the pointwise convergence the finite-sum lemma wants, at n (first argument) and k in w
(define (b5g-hc-body! n U w)
  (let* ((k (cadr (car (dk-peel!)))))
    (fact 'subset-mem-fwd w 'ix k)
    (let* ((c (list (list 'f n) k))
           (bk (list 'bb k))
           (cd (b5g-coord k))
           (kk (list 'VNB-LAMBDA 'b5m_ 'NN c))
           (sq (list 'VNB-LAMBDA 'b5m_ 'NN (list '- c (list '(f b5m_) k))))
           (lim1 (list '- c bk))
           (lc (list '+ (list '* 1 c) (list '* '(- 1) bk))))
      (b5f-pt! (list 'f n) k)
      (fact 'fun-apply-type-c 'bb 'ix 'CC k)
      (dk-apply! b5g-hconv k)
      (for-each
       (lambda (lam typer!)
         (if (not (dk-asm? (list 'IN lam '(FUN NN CC))))
             (dk-have! (list 'IN lam '(FUN NN CC))
               (lambda () (dk-lam-type! (lambda () (let ((j (cadr (car (dk-peel!))))) (typer! j) (dk-ass!))))))))
       (list cd kk sq)
       (list (lambda (j) (b5g-fj! j) (b5f-pt! (list 'f j) k))
             (lambda (j) #t)
             (lambda (j) (b5g-fj! j) (b5f-pt! (list 'f j) k) (fact 'cc-sub-in-cc c (list (list 'f j) k)))))
      (fact 'cc-const-converges c)
      (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
                  (list '= (list sq 'cpdj_) (list '+ (list '* 1 (list kk 'cpdj_)) (list '* '(- 1) (list cd 'cpdj_))))))
        (lambda () (let ((j (cadr (car (dk-peel!)))))
                     (b5g-fj! j) (b5f-pt! (list 'f j) k)
                     (dk-lam-b!) (mac 'binary-minus-def) (crs))))
      (dk-cite! 'cc-limit-lincomb kk cd sq c bk 1 '(- 1))
      (fact 'cc-sub-in-cc c bk)
      (dk-have! (list '= lim1 lc) (lambda () (mac 'binary-minus-def) (crs)))
      (dk-have! (list 'CONVERGES-TO 'CC-MS sq lim1) (lambda () (subst (list '= lim1 lc)) (dk-ass!)))
      (dk-lam-b!)
      (let* ((g (dk-goal)) (hm (caddr g)))
        (if (not (dk-asm? (list 'IN hm '(FUN NN RR))))
            (dk-have! (list 'IN hm '(FUN NN RR))
              (lambda () (dk-lam-type! (lambda () (let ((j (cadr (car (dk-peel!)))))
                                                    (b5g-fj! j) (b5f-gz! (list 'f n) (list 'f j) k)
                                                    (dk-close-if! (lambda () (b5g-lamb?!)) dk-ass!)))))))
        (dk-have! (list 'FORALL 'b5j_ (list 'IMPLIES '(IN b5j_ NN)
                    (list '= (list hm 'b5j_) (b5e-m2 (list sq 'b5j_)))))
          (lambda () (let ((j (cadr (car (dk-peel!)))))
                       (b5g-fj! j) (b5f-gz! (list 'f n) (list 'f j) k)
                       (fact 'cc-sub-in-cc c (list (list 'f j) k))
                       (dk-close-if! (lambda () (b5g-lamb?!)) b5-close!))))
        (dk-cite! 'cc-limit-magnitude-sq sq lim1 hm)
        (b5-close!)))))

;; the partial-sum bound at n, on the finite w just peeled: S(w) <= e*e (goal P(w) <= e*e)
(define (b5g-partial-bound! n)
  (dk-split-all! (dk-peel!))
  (let* ((gg (b5f-G (list 'f n) 'bb))
         (w (cadddr (cadr (dk-goal))))
         (U (list 'VNB-LAMBDA 'b5p_ 'NN (b5f-G (list 'f n) '(f b5p_))))
         (dsub (dk-pick (lambda (f) (and (dk-head-is? f 'SUBSET) (equal? (cadr f) w))) "w <= DOM G")))
    (dk-rewrite-h! dsub (list 'DOM gg) 'ix)
    (let ((S (b5g-bridge! (list 'f n) 'bb w))
          (P (list 'FINSUM 'RR-POS-STAR-ADD-MONOID gg w)))
      (subst (list '= P S))
      (dk-have! (list 'IN U '(FUN NN (FUN ix CC)))
        (lambda () (dk-lam-type! (lambda () (let ((j (cadr (car (dk-peel!))))) (b5g-fj! j) (b5g-g-cc! (list 'f n) (list 'f j)) (dk-ass!))))))
      (b5g-g-cc! (list 'f n) 'bb)
      (let* ((ch (dk-cite! 'cc-limit-finsum 'ix w U gg))
             (hc (cadr ch)))
        (dk-have! hc (lambda () (b5g-hc-body! n U w)))
        (let* ((conc (dk-landed-1 (lambda () (detach! ch))))
               (sseq (caddr conc))
               (ee b5g-ee))
          (dk-have! (list 'IN S 'RR) (lambda () (subst (list '= S P)) (dk-ass!)))
          (fact 'rr-subset-cc S)
          (dk-have! (list 'IN sseq '(FUN NN CC))
            (lambda () (dk-lam-type!
              (lambda () (let ((j (cadr (car (dk-peel!)))))
                           (b5g-fj! j)
                           (dk-lam-b!)
                           (dk-split-all! (list (dk-cite! 'l2-partial-le 'ix (list 'f n) (list 'f j) w)))
                           (fact 'rr-subset-cc (list 'FINSUM '(NORMED-AG-AS-ABELIAN-GROUP CC-NAG) (b5f-G (list 'f n) (list 'f j)) w))
                           (dk-ass!))))))
          (dk-have! (list 'FORALL 'cekn_ (list 'IMPLIES '(IN cekn_ NN) (list 'IMPLIES (list '<= b5g-N 'cekn_)
                      (list '<= (list 'MAGNITUDE (list '- (list sseq 'cekn_) 0)) ee))))
            (lambda ()
              (let* ((ldj (dk-peel!)) (j (cadr (find-first (dk-head? 'IN) ldj))))
                (b5g-fj! j)
                (dk-lam-b!)
                (let* ((Sj (b5g-bridge! (list 'f n) (list 'f j) w))
                       (Pj (list 'FINSUM 'RR-POS-STAR-ADD-MONOID (b5f-G (list 'f n) (list 'f j)) w))
                       (E2 (list 'ESUM (b5f-G (list 'f n) (list 'f j))))
                       (sq (list 'SQRT E2)))
                  (dk-split-all! (list (dk-cite! 'l2-partial-le 'ix (list 'f n) (list 'f j) w)))
                  (dk-split-all! (list (dk-cite! 'l2-dist-esum 'ix (list 'f n) (list 'f j))))
                  (dk-have! (list '<= 0 Sj) (lambda () (subst (list '= Sj Pj)) (dk-ass!)))
                  (b5-and! (list '<= b5g-N n) (list '<= b5g-N j))
                  (let* ((d1 (dk-apply! b5g-tail n j))
                         (d2 (dk-rewrite-h! d1 (b5g-dist (list 'f n) (list 'f j)) sq)))
                    (b5-and! (list 'IN E2 'RR) (list '<= 0 E2))
                    (dk-split-all! (list (dk-cite! 'sqrt-nonneg E2)))
                    (fact 'sqrt-sq E2)
                    (fact 'rr-square-mono sq b5g-e)
                    (dk-have! (list '<= Sj ee)
                      (lambda () (dk-le-chain! Sj E2 (list '* sq sq) ee)))
                    (b5g-mag-real! Sj ee))))))
          (let* ((cek (dk-cite! 'cek-limit-tail-le sseq S 0 ee b5g-N))
                 (r1 (dk-cite! 'cc-re-dist-le S 0)))
            (fact 'cc-re-of-real S)
            (fact 'cc-re-of-real 0)
            (let* ((r2 (dk-rewrite-h! r1 (list 'REAL-PART S) S))
                   (r3 (dk-rewrite-h! r2 '(REAL-PART 0) 0)))
              (dk-have! (list '= (list '- S 0) S) (lambda () (mac 'binary-minus-def) (crs)))
              (let ((r4 (dk-rewrite-h! r3 (list '- S 0) S)))
                (dk-rewrite-h! cek (list '- S 0) S)
                (dk-have! (list '<= 0 S) (lambda () (subst (list '= S P)) (dk-ass!)))
                (fact 'rr-abs-of-nonneg S)
                (dk-rewrite-h! r4 (list 'ABS S) S)
                (fact 'cc-magnitude-closed S)
                (dk-le-chain! S (list 'MAGNITUDE S) ee)))))))))

(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal))
        (ass)
        (let* ((ldn (dk-peel!))
               (n (cadr (find-first (dk-head? 'IN) ldn)))
