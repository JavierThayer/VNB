(dk-iff!
  (lambda (g) (dk-head-is? g 'FORSOME))
  (lambda () (fact 'separable-hilbert-countable-basis 'v) (dk-ass!))
  (lambda ()
    (let* ((ex (dk-pick (dk-head? 'FORSOME) "the basis"))
           (ix1 (dk-skolem! ex))
