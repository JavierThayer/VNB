              (b5-prop! (list 'IN ee 'RR-POS-STAR) iff (list 'AND (list 'IN ee 'RR) (list '<= 0 ee))))
            (b5-and! (list 'IN ee 'RR-POS-STAR) bu)
            (fact 'esum-least gg ee)
            (dk-have! (list 'FORSOME 'm (list 'AND '(IN m RR)
                        (list 'FORALL 's (list 'IMPLIES (list 'AND '(IN s SET) (list 'AND '(IN (CARD s) NN) (list 'SUBSET 's (list 'DOM gg))))
                          (list '<= (list 'FINSUM 'RR-POS-STAR-ADD-MONOID gg 's) 'm)))))
              (lambda () (ew ee) (dk-conj-close! (lambda () (dk-ass!)))))
            (fact 'esum-bounded-implies-finite gg)
            (dk-conj-close! (lambda () (dk-ass!))))))))
