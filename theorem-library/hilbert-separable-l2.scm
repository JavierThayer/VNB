(define b5h-bdef (list 'VNB-LAMBDA 'b5k_ 'ix (list 'CHOICE (b5h-sep 'b5k_))))

(define (b5h-pos1!)
  (fact 'rr-one-in)
  (if (not (dk-asm? '(POS-RR 1)))
      (let ((pi (dk-cite! 'pos-rr 1)))
        (dk-have! (caddr pi)
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (let ((g (dk-goal)))
                  (cond ((dk-asm? g) (ass))
                        ((dk-head-is? g '<=) (dk-ineq!))
                        (#t (di) (dk-absurd! '(= 0 1)))))))))
        (dk-have! '(POS-RR 1) (lambda () (prop))))))
;; dist(a, c) in RR and >= 0 for a, c in l2, landed; returns (SQRT E)
(define (b5h-dist-rr! a c)
  (let* ((e (list 'ESUM (b5f-G a c))) (sq (list 'SQRT e)))
    (if (not (dk-asm? (list 'IN (b5h-dist a c) 'RR)))
