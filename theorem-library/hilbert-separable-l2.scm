      (dk-ass!))))
(b5-done! 'hilbert-separable-iff-countable-basis)


;;; ======== slice b5-d
;;; b5-d.scm -- slice D: the limit of finite sums over a fixed finite index set is the
;;; finite sum of the limits (in CC-MS, the sum taken in the additive group of CC-NAG).
;;; Induction on the finite index set (finite-set-induction, the class relativised to
;;; subsets of the given set), the step by cc-limit-lincomb at coefficients 1, 1; the
;;; base by cpd-cc-squeeze against the constant zero sequence.  Agent BA-ONB5, 2026-11-09.

(define b5d-AG '(NORMED-AG-AS-ABELIAN-GROUP CC-NAG))
(define (b5d-fs f w) (list 'FINSUM b5d-AG f w))
(define (b5d-coord k) (list 'VNB-LAMBDA 'b5m_ 'NN (list '(u b5m_) k)))
(define (b5d-hc w)
  (list 'FORALL 'b5k_ (list 'IMPLIES (list 'IN 'b5k_ w)
    (list 'CONVERGES-TO 'CC-MS (b5d-coord 'b5k_) '(lv b5k_)))))
(define (b5d-seq w) (list 'VNB-LAMBDA 'b5m_ 'NN (b5d-fs '(u b5m_) w)))
(define (b5d-conc w) (list 'CONVERGES-TO 'CC-MS (b5d-seq w) (b5d-fs 'lv w)))
(define b5d-stmt
  (list 'FORALL 'ix (list 'FORALL 'w (list 'IMPLIES '(IN w SET) (list 'IMPLIES '(IN (CARD w) NN)
    (list 'IMPLIES '(SUBSET w ix)
      (list 'FORALL 'u (list 'IMPLIES '(IN u (FUN NN (FUN ix CC)))
        (list 'FORALL 'lv (list 'IMPLIES '(IN lv (FUN ix CC))
          (list 'IMPLIES (b5d-hc 'w) (b5d-conc 'w))))))))))))

;; (IN X CC) from (IN X (CARR AG)) in context, landed and returned
(define (b5d-carr->cc! x)
  (let ((c (list 'IN x 'CC)))
    (if (not (dk-asm? c))
        (dk-have! c (lambda () (subst (list '== 'CC (list 'CARR b5d-AG))) (dk-ass!))))
    c))
;; forall z_ in S. (F z_) in CARR AG, given S <= W0 <= ix (or S <= ix) in context and F in FUN(ix, CC)
(define (b5d-ptw! f s)
  (let ((claim (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ s) (list 'IN (list f 'z_) (list 'CARR b5d-AG))))))
    (if (not (dk-asm? claim))
        (dk-have! claim
          (lambda ()
            (let ((z (cadr (car (dk-peel!)))))
              (if (not (equal? s 'w)) (fact 'subset-mem-fwd s 'w z))
              (fact 'subset-mem-fwd 'w 'ix z)
              (fact 'fun-apply-type-c f 'ix 'CC z)
              (subst (list '== (list 'CARR b5d-AG) 'CC))
              (dk-ass!)))))
    claim))
;; (FINSUM AG F S) in CC, landed
(define (b5d-fs-typ! f s)
  (let ((c (list 'IN (b5d-fs f s) 'CC)))
    (if (not (dk-asm? c))
        (begin
          (b5d-ptw! f s)
          (dk-cite! 'finsum-type-ptwise b5d-AG s f)
          (b5d-carr->cc! (b5d-fs f s))))
    c))
;; the insertion equation FINSUM(F, S u {A}) = FINSUM(F, S) + F(A), with both summands typed in CC
(define (b5d-insert! f s a)
  (let* ((t1 (list 'UNION s (list 'PAIR a a)))
         (x (b5d-fs f s)) (y (list f a))
         (eq (list '= (b5d-fs f t1) (list '+ x y))))
    (if (not (dk-asm? eq))
        (begin
          (b5d-ptw! f t1)
          (b5d-fs-typ! f s)
          (if (not (dk-asm? (list 'IN y 'CC))) (fact 'fun-apply-type-c f 'ix 'CC a))
          (let ((ins (dk-cite! 'finsum-insert-ptwise b5d-AG s a f)))
            (dk-cite! 'cc-nag-ag-opr x y)
            (dk-have! eq (lambda () (subst ins) (dk-ass!))))))
    eq))
;; (IN LAM (FUN NN CC)) for a sequence lambda over NN; TYPER! gets the eigenvariable
(define (b5d-seq-typ! lam typer!)
  (let ((c (list 'IN lam '(FUN NN CC))))
    (if (not (dk-asm? c))
        (dk-have! c (lambda () (dk-lam-type! (lambda () (let ((j (cadr (car (dk-peel!))))) (typer! j)))))))
    c))
(define (b5d-uj! j)                      ; (u j) in FUN(ix, CC)
  (let ((c (list 'IN (list 'u j) '(FUN ix CC))))
    (if (not (dk-asm? c)) (fact 'fun-apply-type-c 'u 'NN '(FUN ix CC) j))
    c))
(define (b5d-zero-minus!)                ; 0 - 0 = 0
  (if (not (dk-asm? '(= (- 0 0) 0)))
      (dk-have! '(= (- 0 0) 0)
        (lambda () (mac 'binary-minus-def) (if (b5-open?) (crs))))))

(sp (make-wff b5d-stmt))
(dk-peel!)
(fact 'cc-nag-ag-is-abelian-group)
(fact 'cc-nag-ag-carr)
(fact 'cc-nag-ag-iden)
(fact 'empty-set-is-set)
(fact 'nn-is-set)
(fact 'cc-one-in)
(fact 'cc-zero-in)
(fact 'rr-zero-in)
(define b5d-cls (list 'COMP 'b5w_ (list 'IMPLIES '(SUBSET b5w_ w) (b5d-conc 'b5w_))))

;;; base: the empty index set; the sums are 0 and the sequence is squeezed by the zero sequence
(define b5d-zs '(VNB-LAMBDA n NN 0))
(dk-have! (list 'IN 'EMPTY-SET b5d-cls)
  (lambda ()
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (if (equal? (dk-goal) '(IN EMPTY-SET SET))
           (ass)
           (let ((s0 (b5d-seq 'EMPTY-SET)))
             (di)
             (fact 'finsum-empty b5d-AG 'lv)
             (subst (list '== (b5d-fs 'lv 'EMPTY-SET) (list 'IDEN b5d-AG)))
             (subst (list '== (list 'IDEN b5d-AG) 0))
             (b5d-seq-typ! s0
               (lambda (j)
                 (b5d-uj! j)
                 (fact 'finsum-empty b5d-AG (list 'u j))
                 (subst (list '== (b5d-fs (list 'u j) 'EMPTY-SET) (list 'IDEN b5d-AG)))
                 (subst (list '== (list 'IDEN b5d-AG) 0))
                 (dk-ass!)))
             (dk-have! (list 'IN b5d-zs '(FUN NN RR))
               (lambda () (dk-lam-type! (lambda () (dk-peel!) (dk-ass!)))))
             (fact 'rr-const-converges-to 0)
             (b5d-zero-minus!)
             (fact 'cc-magnitude-zero)
             (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
                         (list '<= (list 'MAGNITUDE (list '- (list s0 'cpdj_) 0)) (list b5d-zs 'cpdj_))))
               (lambda ()
                 (let ((j (cadr (car (dk-peel!)))))
                   (b5d-uj! j)
                   (dk-lam-b!)
                   (fact 'finsum-empty b5d-AG (list 'u j))
                   (subst (list '== (b5d-fs (list 'u j) 'EMPTY-SET) (list 'IDEN b5d-AG)))
                   (subst (list '== (list 'IDEN b5d-AG) 0))
                   (subst '(= (- 0 0) 0))
                   (subst '(= (MAGNITUDE 0) 0))
                   (dk-ineq! '(IN 0 RR)))))
             (dk-cite! 'cpd-cc-squeeze s0 0 b5d-zs)
             (b5-close!))))
     (dk-opened (lambda () (comp-mi))))))

;;; step: add a point a to s
(define (b5d-step-body! s a ih)
  (let* ((pr (list 'PAIR a a))
         (t1 (list 'UNION s pr)))
    (di)
    (fact 'union-singleton-mem a s)
    (fact 'union-comm s pr)
    (fact 'union-right-subset pr s)
    (dk-have! (list 'IN a t1) (lambda () (subst (list '= t1 (list 'UNION pr s))) (dk-ass!)))
    (dk-have! (list 'SUBSET s t1) (lambda () (subst (list '= t1 (list 'UNION pr s))) (dk-ass!)))
    (fact 'subset-mem-fwd t1 'w a)
    (fact 'subset-mem-fwd 'w 'ix a)
    (fact 'subset-trans s t1 'w)
    (let* ((conc-s (dk-landed-1 (lambda () (detach! ih))))
           (conv-a (dk-apply! (b5d-hc 'w) a))
           (sqS (b5d-seq s)) (sqT (b5d-coord a)) (sqH (b5d-seq t1))
           (limS (b5d-fs 'lv s)) (limA (list 'lv a)))
      (b5d-seq-typ! sqS (lambda (j) (b5d-uj! j) (dk-close-if! (lambda () (b5d-fs-typ! (list 'u j) s)) dk-ass!)))
      (b5d-seq-typ! sqT (lambda (j) (b5d-uj! j) (fact 'fun-apply-type-c (list 'u j) 'ix 'CC a) (dk-ass!)))
      (b5d-seq-typ! sqH
        (lambda (j)
          (b5d-uj! j)
          (let ((e (b5d-insert! (list 'u j) s a)))
            (subst e)
            (b5-and! (list 'IN (b5d-fs (list 'u j) s) 'CC) (list 'IN (list (list 'u j) a) 'CC))
            (fact 'cc-add-closed (b5d-fs (list 'u j) s) (list (list 'u j) a))
            (dk-ass!))))
      (b5d-fs-typ! 'lv s)
      (fact 'fun-apply-type-c 'lv 'ix 'CC a)
      (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN)
                  (list '= (list sqH 'cpdj_) (list '+ (list '* 1 (list sqS 'cpdj_)) (list '* 1 (list sqT 'cpdj_))))))
        (lambda ()
          (let ((j (cadr (car (dk-peel!)))))
            (b5d-uj! j)
            (dk-lam-b!)
            (let ((e (b5d-insert! (list 'u j) s a)))
              (subst e)
              (crs)))))
      (dk-cite! 'cc-limit-lincomb sqS sqT sqH limS limA 1 1)
      (let ((e (b5d-insert! 'lv s a)))
        (dk-have! (list '= (b5d-fs 'lv t1) (list '+ (list '* 1 limS) (list '* 1 limA)))
          (lambda () (subst e) (crs))))
      (subst (list '= (b5d-fs 'lv t1) (list '+ (list '* 1 limS) (list '* 1 limA))))
      (dk-ass!))))

(define b5d-stp
  (list 'FORALL 'b5u_
    (list 'IMPLIES (list 'AND '(IN b5u_ SET) (list 'AND '(IN (CARD b5u_) NN) (list 'IN 'b5u_ b5d-cls)))
      (list 'FORALL 'b5x_
        (list 'IMPLIES '(AND (IN b5x_ SET) (NOT (IN b5x_ b5u_)))
              (list 'IN '(UNION b5u_ (PAIR b5x_ b5x_)) b5d-cls))))))
(dk-have! b5d-stp
  (lambda ()
    (dk-split-all! (dk-peel!))
    (let* ((gl (dk-goal))
           (t1 (cadr gl))
           (s  (cadr t1))
           (a  (cadr (caddr t1)))
           (pr (list 'PAIR a a))
           (ih (dk-landed-find (lambda () (comp-me (list 'IN s b5d-cls))) (dk-head? 'IMPLIES))))
      (b5-and! (list 'IN a 'SET) (list 'IN a 'SET))
      (fact 'pairing a a)
      (b5-and! (list 'IN s 'SET) (list 'IN pr 'SET))
      (fact 'union-set-closure s pr)
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (equal? (dk-goal) (list 'IN t1 'SET))
             (ass)
             (b5d-step-body! s a ih)))
       (dk-opened (lambda () (comp-mi)))))))
;; the induction
(dk-have! (list 'AND (list 'IN 'EMPTY-SET b5d-cls) b5d-stp)
          (lambda () (dk-conj-close! (lambda () (ass)))))
(let ((ind (dk-fact! 'finite-set-induction b5d-cls)))
  (b5-and! '(IN w SET) '(IN (CARD w) NN))
  (let* ((inw (dk-apply! ind 'w))
         (body (dk-landed-find (lambda () (comp-me inw)) (dk-head? 'IMPLIES))))
    (fact 'subset-refl 'w)
    (detach! body)
    (dk-ass!)))
(b5-done! 'cc-limit-finsum)


;;; ======== slice b5-e
;;; b5-e.scm -- slice E: the squared modulus passes to the limit.  If s -> l in CC-MS and
;;; h(j) = |s(j)|^2 (a real sequence) then h -> |l|^2 in CC-MS.  By the coordinates
;;; (cc-coords-of-converges), the continuity of the square on RR (sq-continuous-at,
;;; continuous-at-implies-sequential), rr-limit-add and |z|^2 = re^2 + im^2
;;; (cc-magnitude-sq); back to CC-MS by cc-converges-of-coords.  Agent BA-ONB5, 2026-11-09.

(define b5e-SQ '(VNB-LAMBDA z_ RR (* z_ z_)))
(define (b5e-m2 x) (list '* (list 'MAGNITUDE x) (list 'MAGNITUDE x)))
(define b5e-stmt
  (list 'FORALL 's_ (list 'IMPLIES '(IN s_ (FUN NN CC))
    (list 'FORALL 'lv (list 'IMPLIES '(IN lv CC)
      (list 'FORALL 'h (list 'IMPLIES '(IN h (FUN NN RR))
        (list 'IMPLIES (list 'FORALL 'b5j_ (list 'IMPLIES '(IN b5j_ NN) (list '= '(h b5j_) (b5e-m2 '(s_ b5j_)))))
          (list 'IMPLIES '(CONVERGES-TO CC-MS s_ lv)
            (list 'CONVERGES-TO 'CC-MS 'h (b5e-m2 'lv)))))))))))

;; (IN T RR) for T = (REAL-PART x) / (IMAG-PART x) / x * x / MAGNITUDE x, x typed
(define (b5e-rr! t)
  (let ((c (list 'IN t 'RR)))
    (if (not (dk-asm? c))
        (cond ((dk-head-is? t 'REAL-PART) (fact 'real-part-in-rr (cadr t)))
              ((dk-head-is? t 'IMAG-PART) (fact 'imag-part-in-rr (cadr t)))
              ((dk-head-is? t 'MAGNITUDE) (fact 'cc-magnitude-closed (cadr t)))
              ((dk-head-is? t '*) (b5e-rr! (cadr t)) (b5e-rr! (caddr t))
                                  (b5-and! (list 'IN (cadr t) 'RR) (list 'IN (caddr t) 'RR))
                                  (fact 'rr-mul-closed (cadr t) (caddr t)))
              ((dk-head-is? t '+) (b5e-rr! (cadr t)) (b5e-rr! (caddr t))
                                  (b5-and! (list 'IN (cadr t) 'RR) (list 'IN (caddr t) 'RR))
                                  (fact 'rr-add-closed (cadr t) (caddr t)))
              (#t (error "b5e-rr!: no route" (expression->string t)))))
    c))
(define (b5e-sj! j) (if (not (dk-asm? (list 'IN (list 's_ j) 'CC))) (fact 'fun-apply-type-c 's_ 'NN 'CC j)))
(define (b5e-lam-rr! lam typer!)        ; (IN LAM (FUN NN RR))
  (let ((c (list 'IN lam '(FUN NN RR))))
    (if (not (dk-asm? c))
        (dk-have! c (lambda () (dk-lam-type! (lambda () (let ((j (cadr (car (dk-peel!))))) (typer! j) (dk-ass!)))))))
    c))
(define (b5e-pts! x)                     ; (IN X (PTS RR-MS)) from (IN X RR)
  (let ((c (list 'IN x '(PTS RR-MS))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (subst '(== (PTS RR-MS) RR)) (dk-ass!))))
    c))

(sp (make-wff b5e-stmt))
(dk-peel!)
(define b5e-hp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'MAGNITUDE))) "h = |s|^2"))
(fact 'rr-is-metric-space)
(fact 'rr-ms@pts)
(fact 'nn-is-set)
(fact 'rr-is-set)
(fact 'rr-zero-in)
(define b5e-g '(VNB-LAMBDA b5r_ NN (REAL-PART (s_ b5r_))))
(define b5e-q '(VNB-LAMBDA b5r_ NN (IMAG-PART (s_ b5r_))))
(b5e-lam-rr! b5e-g (lambda (j) (b5e-sj! j) (b5e-rr! (list 'REAL-PART (list 's_ j)))))
(b5e-lam-rr! b5e-q (lambda (j) (b5e-sj! j) (b5e-rr! (list 'IMAG-PART (list 's_ j)))))
(for-each
 (lambda (part lam)
   (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '= (list part '(s_ n_)) (list lam 'n_))))
     (lambda ()
       (let ((j (cadr (car (dk-peel!)))))
         (b5e-sj! j)
         (b5e-rr! (list part (list 's_ j)))
         (dk-close-if! dk-lam-b! b5-close!)))))
 '(REAL-PART IMAG-PART) (list b5e-g b5e-q))
(dk-split-all! (list (dk-cite! 'cc-coords-of-converges 's_ b5e-g b5e-q 'lv)))

;;; the square is continuous on RR, so it carries the coordinate limits
(dk-have! (list 'IN b5e-SQ '(FUN RR RR))
  (lambda () (dk-lam-type! (lambda () (let ((z (cadr (car (dk-peel!))))) (b5e-rr! (list '* z z)) (dk-ass!))))))
(dk-have! (list 'IN b5e-SQ '(FUN (PTS RR-MS) (PTS RR-MS)))
  (lambda () (subst '(== (PTS RR-MS) RR)) (dk-ass!)))
(define (b5e-sq-limit! lam x)            ; converges-to(RR-MS, compose(SQ, lam), SQ(x)), landed
  (b5e-rr! x)
  (b5e-pts! x)
  (fact 'sq-continuous-at x)
  (let ((seq (dk-cite! 'continuous-at-implies-sequential 'RR-MS 'RR-MS b5e-SQ x)))
    (dk-have! (list 'IN lam '(FUN NN (PTS RR-MS))) (lambda () (subst '(== (PTS RR-MS) RR)) (dk-ass!)))
    (let ((iff (dk-cite! 'sqn-membership '(PTS RR-MS) lam)))
      (b5-prop! (list 'IN lam '(SQN (PTS RR-MS))) iff (list 'IN lam '(FUN NN (PTS RR-MS)))))
    (dk-apply! seq lam)))
(define b5e-re (list 'REAL-PART 'lv))
(define b5e-im (list 'IMAG-PART 'lv))
(define b5e-cg (b5e-sq-limit! b5e-g b5e-re))
(define b5e-cq (b5e-sq-limit! b5e-q b5e-im))
(define b5e-fg (list 'COMPOSE b5e-SQ b5e-g))
(define b5e-fq (list 'COMPOSE b5e-SQ b5e-q))
(for-each (lambda (f lam)
            (b5-and! (list 'IN lam '(FUN NN RR)) (list 'IN b5e-SQ '(FUN RR RR)))
            (fact 'compose-type 'NN 'RR 'RR b5e-SQ lam))
          (list b5e-fg b5e-fq) (list b5e-g b5e-q))
;; the limit: SQ(re l) + SQ(im l) = |l|^2
(b5e-rr! (b5e-m2 'lv))
(define b5e-L (b5e-m2 'lv))
(define b5e-LL (list '+ (list b5e-SQ b5e-re) (list b5e-SQ b5e-im)))
(dk-have! (list '= b5e-L b5e-LL)
  (lambda ()
    (dk-lam-b!)
    (fact 'cc-magnitude-sq 'lv)
    (b5-close!)))
;; h(j) = (SQ o g)(j) + (SQ o q)(j)
(dk-have! (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ NN) (list '= '(h j_) (list '+ (list b5e-fg 'j_) (list b5e-fq 'j_)))))
  (lambda ()
    (let ((j (cadr (car (dk-peel!)))))
      (b5e-sj! j)
      (for-each (lambda (lam)
                  (b5-and! (list 'IN lam '(FUN NN RR)) (list 'IN b5e-SQ '(FUN RR RR)))
                  (dk-apply! (dk-cite! 'compose-apply 'NN 'RR 'RR b5e-SQ lam) j))
                (list b5e-g b5e-q))
      (subst (list '= (list b5e-fg j) (list b5e-SQ (list b5e-g j))))
      (subst (list '= (list b5e-fq j) (list b5e-SQ (list b5e-q j))))
      (dk-apply! b5e-hp j)
      (subst (list '= (list 'h j) (b5e-m2 (list 's_ j))))
      (fact 'cc-magnitude-sq (list 's_ j))
      (b5e-rr! (list 'REAL-PART (list 's_ j)))
      (b5e-rr! (list 'IMAG-PART (list 's_ j)))
