;;; Library: operator-algebras.

;;; hilbert-separable-l2.scm -- a countable orthonormal basis makes a Hilbert space separable (and
;;; the iff with a countable basis); l2(I) is complete, hence a Hilbert space.
;;; Agent BA-ONB5, 2026-11-09/10.  Slices A-H concatenated; prefixes b5- (A-C), b5d- .. b5h- (D-H).

;;; ======== slice b5-a
;;; b5-a.scm -- slice A of the separability file: helpers, NN countable, two vector
;;; identities.  Agent BA-ONB5, 2026-11-09.  Prefix b5-.

(define (b5-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; b5: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l)
                    (display ";;   ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;     | ") (display (expression->string a)) (newline))
                              (list-head (dk-asms-of l) (min 8 (length (dk-asms-of l))))))
                  (dk-open-leaves))
        (error "b5: proof not complete" name)))
  (qed name)
  (topic! name 'analysis))
(define (b5-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (b5-close!)
  (cond ((not (b5-open?)) #t) ((dk-asm? (dk-goal)) (ass)) ((dk-head-is? (dk-goal) '==) (qrfl)) (#t (rfl))))
(define (b5-and! . fs)
  (let ((c (let loop ((fs fs)) (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (loop (cdr fs)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define (b5-dump! tag)
  (for-each (lambda (l)
              (display ";; B5OPEN ") (display tag) (display ": ") (display (expression->string (dk-goal-of l))) (newline)
              (for-each (lambda (a) (display ";;     | ") (display (expression->string a)) (newline))
                        (list-head (dk-asms-of l) (min 10 (length (dk-asms-of l))))))
            (dk-open-leaves)))
;; detach every antecedent of the implication chain CH, each proved by PROVER (a thunk run
;; with focus on the antecedent goal); returns the consequent as it landed
(define (b5-chain! ch prover)
  (let loop ((c ch))
    (if (and (pair? c) (eq? (car c) 'IMPLIES))
        (loop (if (dk-asm? (cadr c))
                  (let ((new (dk-landed* (lambda () (detach! c))))) (if (pair? new) (car (last-pair new)) (caddr c)))
                  (detach-with! c prover)))
        c)))

;;; the terms
(define b5-V '(VEC v))
(define b5-G '(IP-NORMED-AG v))
(define b5-VG '(NORMED-AG-AS-ABELIAN-GROUP (IP-NORMED-AG v)))
(define (b5-ip a b) (list '(IP v) a b))
(define (b5-add a b) (list '(VADD v) a b))
(define (b5-neg a) (list '(VNEG v) a))
(define (b5-sub a b) (b5-add a (b5-neg b)))
(define (b5-act c x) (list '(ACT v) c x))
(define (b5-n w) (list 'IP-NORM 'v w))

;;; view read-offs (rf-1.scm's rf-slot-close! / rf-readoff!)
(define (b5-slot-close! view acc)
  (mac view)
  (let loop ((n 0))
    (let ((g (dk-goal)))
      (if (and (< n 8) (not (equal? (cadr g) (caddr g))))
          (begin (quietly (lambda () (slot acc)))
                 (quietly (lambda () (nth-r)))
                 (if (not (equal? (dk-goal) g)) (loop (+ n 1)))))))
  (qrfl))
(define (b5-readoff! acc src view)
  (let* ((lhs (list acc (list view src))) (rhs (list acc src)))
    (if (not (dk-asm? (list '== lhs rhs))) (dk-have! (list '== lhs rhs) (lambda () (b5-slot-close! view acc))))
    (if (not (dk-asm? (list '== rhs lhs))) (dk-have! (list '== rhs lhs) (lambda () (b5-slot-close! view acc))))))
;; the abelian group VG of the vectors, with its slots read off as VEC, VADD, VZERO, VNEG
(define (b5-vg-setup!)
  (fact 'ip-normed-ag-is-normed-ag 'v)
  (fact 'normed-ag-as-abelian-group-is-abelian-group b5-G)
  (for-each (lambda (acc) (b5-readoff! acc b5-G 'NORMED-AG-AS-ABELIAN-GROUP)) '(CARR OPR IDEN INV))
  (fact 'ip-normed-ag-carrier 'v)
  (fact 'ip-normed-ag-opr 'v)
  (fact 'ip-normed-ag-inv 'v)
  (fact 'onb-ip-normed-ag-iden 'v)
  (for-each
    (lambda (acc val)
      (let ((eqn (list '== (list acc b5-VG) val)))
        (if (not (dk-asm? eqn))
            (dk-have! eqn
              (lambda () (subst (list '== (list acc b5-VG) (list acc b5-G))) (subst (list '== (list acc b5-G) val)) (qrfl))))))
    '(CARR OPR IDEN INV) (list b5-V '(VADD v) '(VZERO v) '(VNEG v)))
  (fact 'cips-vzero-in 'v)
  (fact 'cips-vec-set 'v))
;; t in VEC in context: (IN t (CARR VG))
(define (b5-in-vg! t)
  (let ((g (list 'IN t (list 'CARR b5-VG))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (subst (list '== (list 'CARR b5-VG) b5-V)) (dk-ass!))))
    g))
;; w in VEC: (IN (IP-NORM v w) RR), 0 <= it, (== (IP-NORM v w) (SQRT <w,w>))
(define (b5-norm-facts! w)
  (let* ((q (b5-ip w w)) (n (b5-n w)))
    (if (not (dk-asm? (list 'IN n 'RR)))
        (begin
          (fact 'cips-ip-self-real 'v w)
          (fact 'cips-ip-self-nonneg 'v w)
          (b5-and! (list 'IN q 'RR) (list '<= 0 q))
          (dk-split-all! (list (dk-cite! 'sqrt-prop q)))
          (dk-have! (list '== n (list 'SQRT q)) (lambda () (mac 'IP-NORM) (qrfl)))
          (dk-have! (list 'IN n 'RR) (lambda () (subst (list '== n (list 'SQRT q))) (dk-ass!)))
          (dk-have! (list '<= 0 n) (lambda () (subst (list '== n (list 'SQRT q))) (dk-ass!)))))
    n))

;;; NN is countable: BA-ONB2's bo2-nn-countable (cited in slice C).

;;; ---------------------------------------------------------------------------
;;; (a + b) - (c + d) = (a - c) + (b - d) in a complex inner product space.
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v)
  (FORALL b5a_ (IMPLIES (IN b5a_ (VEC v)) (FORALL b5b_ (IMPLIES (IN b5b_ (VEC v))
    (FORALL b5c_ (IMPLIES (IN b5c_ (VEC v)) (FORALL b5d_ (IMPLIES (IN b5d_ (VEC v))
      (= ((VADD v) ((VADD v) b5a_ b5b_) ((VNEG v) ((VADD v) b5c_ b5d_)))
         ((VADD v) ((VADD v) b5a_ ((VNEG v) b5c_)) ((VADD v) b5b_ ((VNEG v) b5d_))))))))))))))))
(dk-peel!)
(b5-vg-setup!)
(let* ((vg b5-VG) (op (list 'OPR vg)) (iv (list 'INV vg)))
  (for-each b5-in-vg! '(b5a_ b5b_ b5c_ b5d_))
  (subst (list '== '(VADD v) op))
  (subst (list '== '(VNEG v) iv))
  (dk-cite! 'abelian-group-inv-opr vg 'b5c_ 'b5d_)
  (for-each (lambda (z)
              (fact 'cips-vneg-type 'v z)
              (dk-have! (list 'IN (list iv z) (list 'CARR vg))
                (lambda () (subst (list '== iv '(VNEG v))) (subst (list '== (list 'CARR vg) b5-V)) (dk-ass!))))
            '(b5c_ b5d_))
  (subst (list '= (list iv (list op 'b5c_ 'b5d_)) (list op (list iv 'b5c_) (list iv 'b5d_))))
  (dk-cite! 'abelian-group-opr-interchange vg 'b5a_ 'b5b_ (list iv 'b5c_) (list iv 'b5d_))
  (b5-close!))
(b5-done! 'b5-vsub-interchange)

;;; ---------------------------------------------------------------------------
;;; || a y - b y || = |a - b| for a unit vector y.
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v)
  (FORALL b5y_ (IMPLIES (IN b5y_ (VEC v)) (IMPLIES (= ((IP v) b5y_ b5y_) 1)
    (FORALL b5a_ (IMPLIES (IN b5a_ CC) (FORALL b5b_ (IMPLIES (IN b5b_ CC)
      (= (IP-NORM v ((VADD v) ((ACT v) b5a_ b5y_) ((VNEG v) ((ACT v) b5b_ b5y_))))
         (MAGNITUDE (+ b5a_ (- b5b_)))))))))))))))
(dk-peel!)
(let* ((y 'b5y_) (a 'b5a_) (b 'b5b_)
       (ay (b5-act a y)) (by (b5-act b y)) (N (b5-neg by)) (w (b5-add ay N))
       (ip b5-ip)
       (ca (list 'conjugate a)) (cb (list 'conjugate b))
       (d (list '+ a (list '- b))) (cd (list 'conjugate d)))
  (fact 'cips-act-type 'v a y)
  (fact 'cips-act-type 'v b y)
  (fact 'cips-vneg-type 'v by)
  (fact 'cips-vadd-type 'v ay N)
  (fact 'cc-conjugate-closed a)
  (fact 'cc-conjugate-closed b)
  (fact 'cc-neg-closed b)
  (b5-and! (list 'IN a 'CC) (list 'IN (list '- b) 'CC))
  (fact 'cc-add-closed a (list '- b))
  (fact 'cc-conjugate-add a (list '- b))
  (fact 'cc-conjugate-neg b)
  (fact 'cc-magnitude-sqrt-self-conj d)
  ;; <w,w> = d conj(d)
  (dk-have! (list '= (ip w w) (list '* d cd))
    (lambda ()
      (fact 'cips-ip-add-left 'v ay N w)
      (fact 'cips-ip-add-right 'v ay ay N)
      (fact 'cips-ip-add-right 'v N ay N)
      (fact 'cips-ip-neg-right 'v ay by)
      (fact 'cips-ip-neg-left 'v by ay)
      (fact 'cips-ip-neg-self 'v by)
      (fact 'cips-ip-homog-left 'v a y ay)
      (fact 'cips-ip-homog-left 'v a y by)
      (fact 'cips-ip-homog-left 'v b y ay)
      (fact 'cips-ip-homog-left 'v b y by)
      (fact 'cips-ip-conj-homog-right 'v a y y)
      (fact 'cips-ip-conj-homog-right 'v b y y)
      (subst (list '= (ip w w) (list '+ (ip ay w) (ip N w))))
      (subst (list '= (ip ay w) (list '+ (ip ay ay) (ip ay N))))
      (subst (list '= (ip N w) (list '+ (ip N ay) (ip N N))))
      (subst (list '= (ip ay N) (list '- (ip ay by))))
      (subst (list '= (ip N ay) (list '- (ip by ay))))
      (subst (list '= (ip N N) (ip by by)))
      (subst (list '= (ip ay ay) (list '* a (ip y ay))))
      (subst (list '= (ip ay by) (list '* a (ip y by))))
      (subst (list '= (ip by ay) (list '* b (ip y ay))))
      (subst (list '= (ip by by) (list '* b (ip y by))))
      (subst (list '= (ip y ay) (list '* ca (ip y y))))
      (subst (list '= (ip y by) (list '* cb (ip y y))))
      (subst (list '= (ip y y) 1))
      (subst (list '= cd (list '+ ca (list 'conjugate (list '- b)))))
      (subst (list '= (list 'conjugate (list '- b)) (list '- cb)))
      (crs)))
  (mac 'IP-NORM)
  (subst (list '= (ip w w) (list '* d cd)))
  (subst (list '= (list 'MAGNITUDE d) (list 'SQRT (list '* d cd))))
  (b5-close!))
(b5-done! 'b5-act-sub-norm)


;;; ======== slice b5-b
;;; b5-b.scm -- slice B: a finite sum of vectors each approximable by multiples dq(j) e_k is
;;; approximable by a finite sum over a finite set of index pairs (k, j).  Induction on the
;;; finite index set (finite-set-induction, the class relativised to subsets of ix).

(define b5-Psi '(VNB-LAMBDA b5q_ (CARTESIAN ix NN) ((ACT v) (dq (NTH 2 b5q_)) (e (NTH 1 b5q_)))))
(define b5-CX '(CARTESIAN ix NN))
(define b5-dqv 'dq)
(define b5-FS '(FIN-SUBSETS (CARTESIAN ix NN)))
(define (b5-fsum f w) (list 'FINSUM b5-VG f w))
(define b5-hu1 '(FORALL b5k_ (IMPLIES (IN b5k_ ix) (IN (u b5k_) (VEC v)))))
(define b5-hu2
  '(FORALL b5k_ (IMPLIES (IN b5k_ ix) (FORALL b5e_ (IMPLIES (POS-RR b5e_)
     (FORSOME b5j_ (AND (IN b5j_ NN)
       (< (IP-NORM v ((VADD v) (u b5k_) ((VNEG v) ((ACT v) (dq b5j_) (e b5k_))))) b5e_))))))))
(define (b5-conc w)
  (list 'FORALL 'b5d_ (list 'IMPLIES '(POS-RR b5d_)
    (list 'FORSOME 'b5s_ (list 'AND (list 'IN 'b5s_ b5-FS)
      (list 'AND (list 'FORALL 'b5p_ (list 'IMPLIES '(IN b5p_ b5s_) (list 'IN '(NTH 1 b5p_) w)))
        (list '< (b5-n (b5-sub (b5-fsum 'u w) (b5-fsum b5-Psi 'b5s_))) 'b5d_)))))))
(define b5-fa-stmt
  (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-INNER-PRODUCT-SPACE v)
    (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES '(IN e (FUN ix (VEC v)))
      (list 'FORALL 'dq (list 'IMPLIES '(IN dq (FUN NN CC))
        (list 'FORALL 'u (list 'IMPLIES b5-hu1 (list 'IMPLIES b5-hu2
          (list 'FORALL 'b5f_ (list 'IMPLIES '(IN b5f_ SET) (list 'IMPLIES '(IN (CARD b5f_) NN)
            (list 'IMPLIES '(SUBSET b5f_ ix) (b5-conc 'b5f_))))))))))))))))

;; land CLAIM by prop from the formulas KEEP (all in context)
(define (b5-prop! claim . keep)
  (if (not (dk-asm? claim))
      (dk-have! claim (lambda () (let ((leaf (proof-state-focus *ps*)))
                                   (apply dk-only! keep)
                                   (if (not (sequent-node-grounded? leaf)) (prop))))))
  claim)
;; goal (FORALL z (IMPLIES (IN z EMPTY-SET) ...)): vacuous
(define (b5-vacuous!)
  (let* ((ld (dk-peel!))
         (m (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'EMPTY-SET))) ld))
         (ne (dk-cite! 'empty-set-has-no-members (cadr m))))
    (let ((leaf (proof-state-focus *ps*)))
      (dk-only! m ne)
      (if (not (sequent-node-grounded? leaf)) (prop)))))
;; (IN s FS) from its three parts proved by CLOSER (a thunk run on each conjunct)
(define (b5-fs-in! s closer)
  (let* ((iff (dk-cite! 'fin-subsets-membership b5-CX s))
         (rhs (caddr iff)))
    (dk-have! rhs (lambda () (dk-conj-close! closer)))
    (b5-prop! (list 'IN s b5-FS) iff rhs)))
;; S in FS in context: land its three parts
(define (b5-fs-parts! s)
  (let* ((iff (dk-cite! 'fin-subsets-membership b5-CX s))
         (r (b5-prop! (caddr iff) iff (list 'IN s b5-FS))))
    (dk-split-all! (list r))))
;; w <= ix in context: forall z in w. (u z) in CARR VG
(define (b5-ptw-u! w)
  (let ((claim (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ w) (list 'IN '(u z_) (list 'CARR b5-VG))))))
    (if (not (dk-asm? claim))
        (dk-have! claim
          (lambda ()
            (let ((z (cadr (car (dk-peel!)))))
              (if (not (eq? w 'ix)) (fact 'subset-mem-fwd w 'ix z))
              (dk-apply! b5-hu1 z)
              (subst (list '== (list 'CARR b5-VG) b5-V))
              (dk-ass!)))))
    claim))
;; z in CARTESIAN ix NN in context: (Psi z) = ACT(dq(NTH 2 z), e(NTH 1 z)) typed in VEC
(define (b5-psi-typ! z)
  (let* ((n1 (list 'NTH 1 z)) (n2 (list 'NTH 2 z))
         (t (b5-act (list b5-dqv n2) (list 'e n1))))
    (if (not (dk-asm? (list 'IN t b5-V)))
        (let ((cm (dk-cite! 'cartesian-membership-nth 'ix 'NN z)))
          (b5-prop! (caddr cm) cm (list 'IN z b5-CX))
          (dk-split-all! (list (caddr cm)))
          (fact 'fun-apply-type-c b5-dqv 'NN 'CC n2)
          (fact 'fun-apply-type-c 'e 'ix b5-V n1)
          (fact 'cips-act-type 'v (list b5-dqv n2) (list 'e n1))))
    (let ((eq (list '= (list b5-Psi z) t)))
      (if (not (dk-asm? eq)) (dk-have! eq (lambda () (dk-close-if! dk-lam-b! b5-close!))))
      eq)))
;; w <= CARTESIAN ix NN (pointwise, in context as PTW): forall z in w. (Psi z) in CARR VG
(define (b5-ptw-psi! w ptw)
  (let ((claim (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ w) (list 'IN (list b5-Psi 'z_) (list 'CARR b5-VG))))))
    (if (not (dk-asm? claim))
        (dk-have! claim
          (lambda ()
            (let ((z (cadr (car (dk-peel!)))))
              (dk-apply! ptw z)
              (let ((eq (b5-psi-typ! z)))
                (subst eq)
                (subst (list '== (list 'CARR b5-VG) b5-V))
                (dk-ass!))))))
    claim))
;; (IN (FINSUM VG f w) VEC) from the pointwise typing PTW over w (w in SET, CARD w in NN in context)
(define (b5-fsum-typ! f w ptw)
  (let ((t (b5-fsum f w)))
    (if (not (dk-asm? (list 'IN t b5-V)))
        (begin
          (dk-cite! 'finsum-type-ptwise b5-VG w f)
          (dk-have! (list 'IN t b5-V) (lambda () (subst (list '== b5-V (list 'CARR b5-VG))) (dk-ass!)))))
    t))
(define (b5-nth-close!)
  (let loop ((n 0))
    (if (and (b5-open?) (< n 6) (dk-contains? (dk-goal) 'NTH))
        (let ((g (dk-goal))) (quietly (lambda () (nth-r))) (if (not (equal? g (dk-goal))) (loop (+ n 1))))))
  (b5-close!))

(sp (make-wff b5-fa-stmt))
(define b5-landed0 (dk-peel!))
(define b5-w0 (cadr (find-first (lambda (f) (and (dk-head-is? f 'SUBSET) (eq? (caddr f) 'ix))) b5-landed0)))
(define b5-eps0 (cadr (find-first (dk-head? 'POS-RR) b5-landed0)))
(b5-vg-setup!)
(fact 'empty-set-is-set)
(fact 'nn-is-set)
(define b5-cls (list 'COMP 'b5w_ (list 'IMPLIES '(SUBSET b5w_ ix) (b5-conc 'b5w_))))

;;; base: S = EMPTY-SET
(dk-have! (list 'IN 'EMPTY-SET b5-cls)
  (lambda ()
    (for-each
     (lambda (leaf)
       (dk-focus! leaf)
       (if (equal? (dk-goal) '(IN EMPTY-SET SET))
           (ass)
           (let* ((ld (dk-peel!))
                  (eps (cadr (find-first (dk-head? 'POS-RR) ld))))
             (fact 'rr-lt-of-pos-rr eps)
             (fact 'rr-pos-rr-in-rr eps)
             (ew 'EMPTY-SET)
             (dk-conj-close!
               (lambda ()
                 (let ((g (dk-goal)))
                   (cond
                     ((dk-ass!) #t)
                     ((equal? g (list 'IN 'EMPTY-SET b5-FS))
                      (b5-fs-in! 'EMPTY-SET
                        (lambda ()
                          (let ((g2 (dk-goal)))
                            (cond ((dk-ass!) #t)
                                  ((dk-head-is? g2 'FORALL) (b5-vacuous!))
                                  (#t (fact 'card-empty) (fact 'nn-zero-in)
                                      (subst '(= (CARD EMPTY-SET) 0)) (dk-ass!)))))))
                     ((dk-head-is? g 'FORALL) (b5-vacuous!))
                     (#t
                      (fact 'finsum-empty b5-VG 'u)
                      (fact 'finsum-empty b5-VG b5-Psi)
                      (subst (list '== (b5-fsum 'u 'EMPTY-SET) (list 'IDEN b5-VG)))
                      (subst (list '== (b5-fsum b5-Psi 'EMPTY-SET) (list 'IDEN b5-VG)))
                      (subst (list '== (list 'IDEN b5-VG) '(VZERO v)))
                      (fact 'cips-vadd-vneg 'v '(VZERO v))
                      (subst (list '= (b5-sub '(VZERO v) '(VZERO v)) '(VZERO v)))
                      (fact 'cips-ip-zero-left 'v '(VZERO v))
                      (fact 'rr-zero-in)
                      (dk-have! '(<= 0 0) (lambda () (dk-ineq! '(IN 0 RR))))
                      (dk-have! '(= (* 0 0) 0) (lambda () (crs)))
                      (b5-and! '(IN 0 RR) '(<= 0 0))
                      (fact 'sqrt-char 0 0)
                      (dk-have! '(= (IP-NORM v (VZERO v)) 0)
                        (lambda () (mac 'IP-NORM) (subst '(= ((IP v) (VZERO v) (VZERO v)) 0)) (dk-ass!)))
                      (subst '(= (IP-NORM v (VZERO v)) 0))
                      (dk-ass!)))))))))
     (dk-opened (lambda () (comp-mi))))))

;;; step: add a point a to s
(define (b5-step-body! s a ih)
  (let* ((pr (list 'PAIR a a))
         (t1 (list 'UNION s pr)))
    (di)
    (fact 'union-singleton-mem a s)
    (fact 'union-comm s pr)
    (fact 'union-right-subset pr s)
    (dk-have! (list 'IN a t1) (lambda () (subst (list '= t1 (list 'UNION pr s))) (dk-ass!)))
    (dk-have! (list 'SUBSET s t1) (lambda () (subst (list '= t1 (list 'UNION pr s))) (dk-ass!)))
    (fact 'subset-mem-fwd t1 'ix a)
    (fact 'subset-trans s t1 'ix)
    (let* ((conc-s (dk-landed-1 (lambda () (detach! ih))))
           (ld (dk-peel!))
           (eps (cadr (find-first (dk-head? 'POS-RR) ld)))
           (d2 (dk-halve! eps))
           (exs (dk-apply! conc-s d2))
           (sS (dk-skolem! exs))
           (hS (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f sS) (dk-contains? f 'NTH))) "the NTH clause of S"))
           (ha (dk-apply! b5-hu2 a))
           (exj (dk-apply! ha d2))
           (j (dk-skolem! exj))
           (pj (list 'LIST a j))
           (pp (list 'PAIR pj pj))
           (sS1 (list 'UNION sS pp)))
      (dk-split-all!)
      (b5-fs-parts! sS)
      (let ((ptwS (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f sS) (dk-contains? f b5-CX))) "S inside the cartesian")))
        (fact 'pair-in-cartesian 'ix 'NN a j)
        (fact 'membership-implies-sethood pj b5-CX)
        (b5-and! (list 'IN pj 'SET) (list 'IN pj 'SET))
        (fact 'pairing pj pj)
        (b5-and! (list 'IN sS 'SET) (list 'IN pp 'SET))
        (fact 'union-set-closure sS pp)
        (fact 'card-singleton pj)
        (fact 'nn-zero-in)
        (fact 'nn-succ-closed 0)
        (dk-have! (list 'IN (list 'CARD pp) 'NN) (lambda () (subst (list '= (list 'CARD pp) '(succ 0))) (dk-ass!)))
        (fact 'card-union-nn sS pp)
        (dk-have! (list '= (list 'NTH 1 pj) a) (lambda () (b5-nth-close!)))
        ;; pj is not in S: its first entry a is not in s
        (dk-have! (list 'NOT (list 'IN pj sS))
          (lambda ()
            (di)
            (dk-apply! hS pj)
            (dk-have! (list 'IN a s) (lambda () (subst (list '= a (list 'NTH 1 pj))) (dk-ass!)))
            (ai (list 'NOT (list 'IN a s)))))
        ;; S1 inside the cartesian, pointwise
        (let ((ptwS1 (list 'FORALL 'b5z_ (list 'IMPLIES (list 'IN 'b5z_ sS1) (list 'IN 'b5z_ b5-CX)))))
        (dk-have! ptwS1
          (lambda ()
            (let* ((z (cadr (car (dk-peel!))))
                   (um (dk-cite! 'union-membership sS pp z)))
              (use-em (list 'IN z sS)
                (lambda () (dk-apply! ptwS z) (dk-ass!))
                (lambda ()
                  (dk-have! (list 'IN z pp) (lambda () (b5-prop! (list 'IN z pp) um (list 'IN z sS1) (list 'NOT (list 'IN z sS)))))
                  (let ((pm (dk-apply! (dk-cite! 'pairing-membership pj pj) z)))
                    (b5-prop! (list '= z pj) pm (list 'IN z pp))
                    (subst (list '= z pj))
                    (dk-ass!)))))))
        (ew sS1)
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond
                ((dk-ass!) #t)
                ((equal? g (list 'IN sS1 b5-FS))
                 (b5-fs-in! sS1 (lambda () (if (not (dk-ass!)) (dk-ass!)))))
                ((dk-head-is? g 'FORALL)
                 (let* ((z (cadr (car (dk-peel!))))
                        (um (dk-cite! 'union-membership sS pp z))
                        (zc (dk-apply! ptwS1 z))
                        (zt (b5-psi-typ! z))
                        (tm (dk-cite! 'union-membership s pr (list 'NTH 1 z))))
                   (use-em (list 'IN z sS)
                     (lambda ()
                       (dk-apply! hS z)
                       (b5-prop! (list 'IN (list 'NTH 1 z) t1) tm (list 'IN (list 'NTH 1 z) s)))
                     (lambda ()
                       (dk-have! (list 'IN z pp) (lambda () (b5-prop! (list 'IN z pp) um (list 'IN z sS1) (list 'NOT (list 'IN z sS)))))
                       (let ((pm (dk-apply! (dk-cite! 'pairing-membership pj pj) z)))
                         (b5-prop! (list '= z pj) pm (list 'IN z pp))
                         (subst (list '= z pj))
                         (subst (list '= (list 'NTH 1 pj) a))
                         (dk-ass!))))))
                (#t
                 ;; the norm
                 (let* ((fA (b5-fsum 'u s)) (fB (b5-fsum b5-Psi sS))
                        (ua (list 'u a))
                        (bq (b5-act (list 'dq j) (list 'e a))))
                   (b5-ptw-u! t1)
                   (b5-ptw-u! s)
                   (b5-ptw-psi! sS1 ptwS1)
                   (b5-ptw-psi! sS ptwS)
                   (b5-fsum-typ! 'u s (b5-ptw-u! s))
                   (b5-fsum-typ! b5-Psi sS (b5-ptw-psi! sS ptwS))
                   (dk-apply! b5-hu1 a)
                   (fact 'fun-apply-type-c 'dq 'NN 'CC j)
                   (fact 'fun-apply-type-c 'e 'ix b5-V a)
                   (fact 'cips-act-type 'v (list 'dq j) (list 'e a))
                   (fact 'membership-implies-sethood a 'ix)
                   (fact 'finsum-insert-ptwise b5-VG s a 'u)
                   (fact 'finsum-insert-ptwise b5-VG sS pj b5-Psi)
                   (dk-have! (list '= (list b5-Psi pj) bq)
                     (lambda () (dk-lam-b!) (b5-nth-close!)))
                   (subst (list '= (b5-fsum 'u t1) (list (list 'OPR b5-VG) fA ua)))
                   (subst (list '= (b5-fsum b5-Psi sS1) (list (list 'OPR b5-VG) fB (list b5-Psi pj))))
                   (subst (list '== (list 'OPR b5-VG) '(VADD v)))
                   (subst (list '= (list b5-Psi pj) bq))
                   (fact 'b5-vsub-interchange 'v fA ua fB bq)
                   (subst (list '= (b5-sub (b5-add fA ua) (b5-add fB bq)) (b5-add (b5-sub fA fB) (b5-sub ua bq))))
                   (fact 'cips-vneg-type 'v fB)
                   (fact 'cips-vneg-type 'v bq)
                   (fact 'cips-vadd-type 'v fA (b5-neg fB))
                   (fact 'cips-vadd-type 'v ua (b5-neg bq))
                   (let* ((x1 (b5-sub fA fB)) (x2 (b5-sub ua bq)) (x3 (b5-add x1 x2))
                          (n1 (b5-norm-facts! x1)) (n2 (b5-norm-facts! x2)))
                     (fact 'cips-vadd-type 'v x1 x2)
                     (b5-norm-facts! x3)
                     (let* ((mk (dk-cite! 'cips-minkowski 'v x1 x2)) (er (dk-cite! 'rr-pos-rr-in-rr eps)))
                       (dk-ineq! mk (list '< n1 d2) (list '< n2 d2) (list '= (list '+ d2 d2) eps)
                                 (list 'IN n1 'RR) (list 'IN n2 'RR) (list 'IN (b5-n x3) 'RR) (list 'IN d2 'RR) er))))))))))))))

(define b5-stp
  (list 'FORALL 'b5u_
    (list 'IMPLIES (list 'AND '(IN b5u_ SET) (list 'AND '(IN (CARD b5u_) NN) (list 'IN 'b5u_ b5-cls)))
      (list 'FORALL 'b5x_
        (list 'IMPLIES '(AND (IN b5x_ SET) (NOT (IN b5x_ b5u_)))
              (list 'IN '(UNION b5u_ (PAIR b5x_ b5x_)) b5-cls))))))
(dk-have! b5-stp
  (lambda ()
    (dk-split-all! (dk-peel!))
    (let* ((gl (dk-goal))
           (t1 (cadr gl))
           (s  (cadr t1))
           (a  (cadr (caddr t1)))
           (pr (list 'PAIR a a))
           (ih (dk-landed-find (lambda () (comp-me (list 'IN s b5-cls))) (dk-head? 'IMPLIES))))
      (b5-and! (list 'IN a 'SET) (list 'IN a 'SET))
      (fact 'pairing a a)
      (b5-and! (list 'IN s 'SET) (list 'IN pr 'SET))
      (fact 'union-set-closure s pr)
      (for-each
       (lambda (leaf)
         (dk-focus! leaf)
         (if (equal? (dk-goal) (list 'IN t1 'SET))
             (ass)
             (b5-step-body! s a ih)))
       (dk-opened (lambda () (comp-mi)))))))
;; the induction
(dk-have! (list 'AND (list 'IN 'EMPTY-SET b5-cls) b5-stp)
          (lambda () (dk-conj-close! (lambda () (ass)))))
(let ((ind (dk-fact! 'finite-set-induction b5-cls)))
  (b5-and! (list 'IN b5-w0 'SET) (list 'IN (list 'CARD b5-w0) 'NN))
  (let* ((inw (dk-apply! ind b5-w0))
         (body (dk-landed-find (lambda () (comp-me inw)) (dk-head? 'IMPLIES)))
         (cw (dk-landed-1 (lambda () (detach! body)))))
    (dk-apply! cw b5-eps0)
    (dk-ass!)))
(b5-done! 'b5-finite-approx)


;;; ======== slice b5-c
;;; b5-c.scm -- slice C: a Hilbert space with a countable orthonormal basis is separable, and
;;; the iff with BA-ONB2's separable-hilbert-countable-basis.
;;;
;;; The dense sequence enumerates D = { sum_{(k,j) in S} dq(j) e_k : S a finite subset of ix x NN },
;;; dq a dense sequence of CC (cc-ms-separable).  D is countable (countable-cartesian,
;;; countable-fin-subsets, countable-image) and holds 0.  For x and eps: a finite F with
;;; ||x - Y_F|| < eps/2 (onb-expansion), then b5-finite-approx at u = (k |-> <x,e_k> e_k) gives
;;; S with ||Y_F - sum_S|| < eps/2, each u_k being approximated by dq(j) e_k through
;;; b5-act-sub-norm.

(define b5-M '(IP-METRIC-SPACE v))
(define b5-Phi (list 'VNB-LAMBDA 'b5t_ b5-FS (list 'FINSUM b5-VG b5-Psi 'b5t_)))
(define b5-D (list 'IMAGE b5-Phi b5-FS))
(define b5-cf '(VNB-LAMBDA onk_ ix ((ACT v) ((IP v) x (e onk_)) (e onk_))))
;; w <= ix in context: forall z in w. (f z) in CARR VG for f = (k |-> <x,e_k> e_k)
(define (b5-ptw-u-gen! f w)
  (let ((claim (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ w) (list 'IN (list f 'z_) (list 'CARR b5-VG))))))
    (if (not (dk-asm? claim))
        (dk-have! claim
          (lambda ()
            (let ((z (cadr (car (dk-peel!)))))
              (fact 'subset-mem-fwd w 'ix z)
              (fact 'fun-apply-type-c f 'ix b5-V z)
              (subst (list '== (list 'CARR b5-VG) b5-V))
              (dk-ass!)))))
    claim))
(define (b5-replace t from to)
  (cond ((eq? t from) to) ((pair? t) (cons (b5-replace (car t) from to) (b5-replace (cdr t) from to))) (#t t)))
;; t in FS in context: (FINSUM VG Psi t) in VEC
(define (b5-fs-sum-typ! t)
  (if (not (dk-asm? (list 'IN (b5-fsum b5-Psi t) b5-V)))
      (b5-fs-sum-typ-1! t)))
(define (b5-fs-sum-typ-1! t)
  (b5-fs-parts! t)
  (let ((ptw (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f t) (dk-contains? f b5-CX))) "t inside the cartesian")))
    (b5-fsum-typ! b5-Psi t (b5-ptw-psi! t ptw))))
;; (IN y D) for y = Phi(t), t in FS in context
(define (b5-in-D! t)
  (b5-fs-sum-typ! t)
  (let* ((y (b5-fsum b5-Psi t))
         (iff (dk-cite! 'image-membership-iff b5-Phi b5-FS y))
         (rhs (caddr iff)))
    (fact 'membership-implies-sethood y b5-V)
    (dk-have! rhs
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (cond ((dk-ass!) #t)
                  (#t (ew t)
                      (dk-conj-close! (lambda () (if (not (dk-ass!)) (dk-close-if! dk-lam-b! b5-close!))))))))))
    (b5-prop! (list 'IN y b5-D) iff rhs)))

(sp (make-wff '(FORALL v (IMPLIES (IS-HILBERT-SPACE v)
  (FORALL ix (FORALL e (IMPLIES (IS-ORTHONORMAL-BASIS v ix e)
    (IMPLIES (IS-COUNTABLE ix) (IS-SEPARABLE (IP-METRIC-SPACE v))))))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(dk-project! '(IS-ORTHONORMAL-FAMILY v ix e) 'is-orthonormal-basis '(IS-ORTHONORMAL-BASIS v ix e))
(dk-project! '(IN e (FUN ix (VEC v))) 'is-orthonormal-family '(IS-ORTHONORMAL-FAMILY v ix e))
(define b5-unit
  (dk-project! '(FORALL oni_ (IMPLIES (IN oni_ ix) (= ((IP v) (e oni_) (e oni_)) 1)))
               'is-orthonormal-family '(IS-ORTHONORMAL-FAMILY v ix e)))
(b5-vg-setup!)
(fact 'fun-domain-in-set 'ix b5-V 'e)
(fact 'nn-is-set)
(fact 'empty-set-is-set)
;; the dense sequence dq of CC
(fact 'cc-ms-separable)
(define b5-dq
  (let* ((iff (dk-cite! 'is-separable 'CC-MS))
         (r (b5-prop! (caddr iff) iff '(IS-SEPARABLE CC-MS))))
    (dk-split-all! (list r))
    (let ((ex (dk-pick (dk-head? 'FORSOME) "the dense sequence of CC")))
      (dk-skolem! ex))))
(dk-split-all!)
(fact 'cc-ms@pts)
(define b5-dqd
  (dk-rewrite-h! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f b5-dq))) "the density of dq")
                 '(PTS CC-MS) 'CC))
(dk-rewrite-h! (list 'IN b5-dq '(FUN NN (PTS CC-MS))) '(PTS CC-MS) 'CC)
;; rename dq to the fixed name used by b5-Psi: work with the term b5-dq throughout
(set! b5-Psi (b5-replace b5-Psi 'dq b5-dq))
(set! b5-dqv b5-dq)
(set! b5-Phi (list 'VNB-LAMBDA 'b5t_ b5-FS (list 'FINSUM b5-VG b5-Psi 'b5t_)))
(set! b5-D (list 'IMAGE b5-Phi b5-FS))
;; D is countable
(fact 'bo2-nn-countable)
(fact 'countable-cartesian 'ix 'NN)
(fact 'countable-fin-subsets b5-CX)
(fact 'cartesian-set-iff 'ix 'NN)
(b5-and! '(IN ix SET) '(IN NN SET))
(b5-prop! (list 'IN b5-CX 'SET) (dk-cite! 'cartesian-set-iff 'ix 'NN) '(AND (IN ix SET) (IN NN SET)))
(fact 'fin-subsets-is-set b5-CX)
(dk-have! (list 'IN b5-Phi (list 'FUN b5-FS b5-V))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((t (cadr (car (dk-peel!)))))
          (b5-fs-sum-typ! t)
          (dk-ass!)))
      (lambda () (ass)))))
(fact 'subset-refl b5-FS)
(fact 'countable-image b5-FS b5-Phi b5-FS b5-V)
;; D holds 0 = Phi(EMPTY-SET)
(dk-have! (list 'IN 'EMPTY-SET b5-FS)
  (lambda ()
    (b5-fs-in! 'EMPTY-SET
      (lambda ()
        (let ((g2 (dk-goal)))
          (cond ((dk-ass!) #t)
                ((dk-head-is? g2 'FORALL) (b5-vacuous!))
                (#t (fact 'card-empty) (fact 'nn-zero-in)
                    (subst '(= (CARD EMPTY-SET) 0)) (dk-ass!))))))))
(b5-in-D! 'EMPTY-SET)
(dk-have! (list 'FORSOME 'b5o_ (list 'IN 'b5o_ b5-D)) (lambda () (ew (b5-fsum b5-Psi 'EMPTY-SET)) (dk-ass!)))
(define b5-en
  (let ((ex (dk-cite! 'countable-enum-nonempty b5-D)))
    (dk-skolem! ex)))
(dk-split-all!)
(define b5-onto (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f b5-en) (dk-contains? f b5-D))) "onto"))
(dk-have! (list 'SUBSET b5-D b5-V)
  (lambda ()
    (mac 'subset-def)
    (let* ((y (dk-di-var!))
           (iff (dk-cite! 'image-membership-iff b5-Phi b5-FS y))
           (r (b5-prop! (caddr iff) iff (list 'IN y b5-D)))
           (t (dk-skolem! r)))
      (dk-split-all!)
      (b5-fs-sum-typ! t)
      (dk-have! (list '= (list b5-Phi t) (b5-fsum b5-Psi t)) (lambda () (dk-close-if! dk-lam-b! b5-close!)))
      (subst (list '= y (list b5-Phi t)))
      (subst (list '= (list b5-Phi t) (b5-fsum b5-Psi t)))
      (dk-ass!))))
(fact 'fun-codomain-superset b5-en 'NN b5-D b5-V)
;; the goal
(fact 'ip-metric-space-is-metric-space 'v)
(fact 'ip-metric-space-pts 'v)
(mac 'is-separable)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? g 'FORSOME)
         (ew b5-en)
         (subst (list '== (list 'PTS b5-M) b5-V))
         (dk-conj-close!
           (lambda ()
             (cond
               ((dk-ass!) #t)
               (#t
                (let* ((ld (dk-peel!))
                       (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) b5-V))) ld)))
                       (eps (cadr (find-first (dk-head? 'POS-RR) ld)))
                       (cf (b5-replace b5-cf 'x x))
                       (d2 (dk-halve! eps))
                       (st (dk-cite! 'onb-expansion 'v 'ix 'e x))
                       (sb (dk-landed-1 (lambda () (mac-h 'sums-to st))))
                       (exf (dk-apply! sb d2))
                       (fF (dk-skolem! exf)))
                  (dk-split-all!)
                  (fact 'rr-pos-rr-in-rr eps)
                  ;; DOM(cf) = ix
                  (dk-have! (list 'IN cf (list 'FUN 'ix b5-V))
                    (lambda ()
                      (dk-lam-type!
                        (lambda ()
                          (let ((k (dk-di-var!)))
                            (fact 'fun-apply-type-c 'e 'ix b5-V k)
                            (fact 'cips-ip-type 'v x (list 'e k))
                            (fact 'cips-act-type 'v (b5-ip x (list 'e k)) (list 'e k))
                            (dk-ass!)))
                        (lambda () (ass)))))
                  (dk-project! (list 'IN cf '(FUN ix)) 'fun-codomain-iff (list 'IN cf (list 'FUN 'ix b5-V)))
                  (b5-and! (list 'IN cf '(FUN ix)) '(IN ix SET))
                  (fact 'dom-of-fun 'ix cf)
                  (let ((dd2 (dk-ctx-form (list 'AND (list 'IN (list 'DOM cf) 'SET) (list '= (list 'DOM cf) 'ix)))))
                    (if dd2 (dk-split-all! (list dd2))))
                  (dk-rewrite-h! (list 'SUBSET fF (list 'DOM cf)) (list 'DOM cf) 'ix)
                  ;; ext := F in the tail bound
                  (fact 'subset-refl fF)
                  (b5-and! (list 'IN fF 'SET) (list 'IN (list 'CARD fF) 'NN) (list 'SUBSET fF fF) (list 'SUBSET fF (list 'DOM cf)))
                  (let* ((yF (b5-fsum cf fF))
                         (tb (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a (list 'NRM b5-G)) (dk-contains? a fF))) "the tail bound"))
                         (bnd (dk-apply! tb fF)))
                    (b5-ptw-u-gen! cf fF)
                    (b5-fsum-typ! cf fF (b5-ptw-u-gen! cf fF))
                    (fact 'cips-vneg-type 'v yF)
                    (fact 'cips-vadd-type 'v x (b5-neg yF))
                    (fact 'ip-normed-ag-norm-value 'v (b5-sub x yF))
                    (let* ((b1 (dk-rewrite-h! bnd (list 'OPR b5-G) '(VADD v)))
                           (b2 (dk-rewrite-h! b1 (list 'INV b5-G) '(VNEG v)))
                           (b3 (dk-rewrite-h! b2 (list (list 'NRM b5-G) (b5-sub x yF)) (b5-n (b5-sub x yF)))))
                      ;; the two hypotheses of b5-finite-approx at u := cf
                      (let ((h1 (b5-replace b5-hu1 'u cf))
                            (h2 (b5-replace (b5-replace b5-hu2 'u cf) 'dq b5-dq)))
                        (dk-have! h1
                          (lambda ()
                            (let ((k (dk-di-var!)))
                              (fact 'fun-apply-type-c 'e 'ix b5-V k)
                              (fact 'cips-ip-type 'v x (list 'e k))
                              (fact 'cips-act-type 'v (b5-ip x (list 'e k)) (list 'e k))
                              (dk-close-if! dk-lam-b! b5-close!))))
                        (dk-have! h2
                          (lambda ()
                            (let* ((k (dk-di-var!))
                                   (ld2 (dk-peel!))
                                   (e2 (cadr (find-first (dk-head? 'POS-RR) ld2)))
                                   (ek (list 'e k))
                                   (c (b5-ip x ek)))
                              (fact 'fun-apply-type-c 'e 'ix b5-V k)
                              (fact 'cips-ip-type 'v x ek)
                              (fact 'cips-act-type 'v c ek)
                              (dk-apply! b5-unit k)
                              (dk-have! (list '= (list cf k) (b5-act c ek)) (lambda () (dk-close-if! dk-lam-b! b5-close!)))
                              (let* ((exn (dk-apply! b5-dqd c e2))
                                     (n (dk-skolem! exn))
                                     (qn (list b5-dq n)))
                                (dk-split-all!)
                                (fact 'fun-apply-type-c b5-dq 'NN 'CC n)
                                (fact 'cc-ms-dist c qn)
                                (fact 'b5-act-sub-norm 'v ek c qn)
                                (fact 'cc-neg-closed qn)
                                (dk-have! (list '= (list '- c qn) (list '+ c (list '- qn))) (lambda () (mac 'binary-minus-def) (b5-close!)))
                                (let* ((db (dk-pick (lambda (f) (and (dk-head-is? f '<) (dk-contains? f qn))) "the CC distance bound"))
                                       (db1 (dk-rewrite-h! db (list (list 'DIST 'CC-MS) c qn) (list 'MAGNITUDE (list '- c qn))))
                                       (db2 (dk-rewrite-h! db1 (list '- c qn) (list '+ c (list '- qn)))))
                                  (ew n)
                                  (subst (list '= (list cf k) (b5-act c ek)))
                                  (subst (list '= (b5-n (b5-sub (b5-act c ek) (b5-act qn ek))) (list 'MAGNITUDE (list '+ c (list '- qn)))))
                                  (dk-conj-close! (lambda () (dk-ass!)))))))))
                      (let* ((c1 (dk-cite! 'b5-finite-approx 'v 'ix 'e b5-dq cf))
                             (c2 (dk-apply! c1 fF))
                             (exs (dk-apply! c2 d2))
                             (sS (dk-skolem! exs)))
                        (dk-split-all!)
                        (b5-in-D! sS)
                        (let* ((y (b5-fsum b5-Psi sS))
                               (exm (dk-apply! b5-onto y))
                               (m (dk-skolem! exm)))
                          (dk-split-all!)
                          (b5-fs-sum-typ! sS)
                          (ew m)
                          (subst (list '= (list b5-en m) y))
                          (dk-conj-close!
                            (lambda ()
                              (cond
                                ((dk-ass!) #t)
                                (#t
                                 (fact 'metric-triangle b5-M)
                                 (for-each (lambda (z) (dk-have! (list 'IN z (list 'PTS b5-M)) (lambda () (subst (list '== (list 'PTS b5-M) b5-V)) (dk-ass!))))
                                           (list x yF y))
                                 (let* ((tri (dk-cite! 'metric-triangle b5-M x yF y))
                                        (q1 (b5-sub x yF)) (q2 (b5-sub yF y)) (q3 (b5-sub x y)))
                                   (fact 'cips-vneg-type 'v y)
                                   (fact 'cips-vadd-type 'v yF (b5-neg y))
                                   (fact 'cips-vadd-type 'v x (b5-neg y))
                                   (for-each (lambda (pq)
                                               (fact 'ip-metric-space-dist 'v (car pq) (cadr pq))
                                               (b5-norm-facts! (b5-sub (car pq) (cadr pq))))
                                             (list (list x yF) (list yF y) (list x y)))
                                   (let* ((t1 (dk-rewrite-h! tri (list (list 'DIST b5-M) x yF) (list 'SQRT (b5-ip q1 q1))))
                                          (t2 (dk-rewrite-h! t1 (list (list 'DIST b5-M) yF y) (list 'SQRT (b5-ip q2 q2))))
                                          (t3 (dk-rewrite-h! t2 (list (list 'DIST b5-M) x y) (list 'SQRT (b5-ip q3 q3))))
                                          (t4 (dk-rewrite-h! t3 (list 'SQRT (b5-ip q1 q1)) (b5-n q1)))
                                          (t5 (dk-rewrite-h! t4 (list 'SQRT (b5-ip q2 q2)) (b5-n q2)))
                                          (t6 (dk-rewrite-h! t5 (list 'SQRT (b5-ip q3 q3)) (b5-n q3))))
                                     (subst (list '= (list (list 'DIST b5-M) x y) (list 'SQRT (b5-ip q3 q3))))
                                     (subst (list '== (list 'SQRT (b5-ip q3 q3)) (b5-n q3)))
                                     (dk-ineq! t6 b3
                                               (dk-pick (lambda (f) (and (dk-head-is? f '<) (dk-contains? f sS))) "the S bound")
                                               (list '= (list '+ d2 d2) eps)
                                               (list 'IN (b5-n q1) 'RR) (list 'IN (b5-n q2) 'RR) (list 'IN (b5-n q3) 'RR)
                                               (list 'IN d2 'RR) (list 'IN eps 'RR))))))))))))))))))
        (#t (error "b5 main: unexpected goal" (expression->string g)))))))
(b5-done! 'onb-countable-separable)

