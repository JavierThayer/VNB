  (dk-cite! 'group-carr-set 'g)
  (dk-cite! 'bk-metric-lam-type 's 'g 'vs)
  (mac 'BK-METRIC)
  (slot acc)
  (nth-r)
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (qrfl))
