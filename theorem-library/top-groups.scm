;;; ---- a ball of radius (1/2)^(k+1) lies in a vs(k) translate ----
(sp (make-wff (tgk-hyps '(FORALL k (IMPLIES (IN k NN) (FORALL a (IMPLIES (IN a (CARR g)) (FORALL z
   (IMPLIES (IN z (BALL (BK-METRIC g vs) a (power 1/2 (succ k))))
     (AND (IN z (CARR g)) (IN ((OPR g) ((INV g) a) z) (vs k))))))))))))
(dk-peel!)
(tgk-setup!)
(let* ((sk '(succ k)) (r (tgk-h sk)) (z (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (dk-head-is? (caddr q) 'BALL))) (dk-asms))))))
  (dk-cite! 'nn-succ-closed 'k)
  (tgk-ball-parts! z 'a r)
  (dk-cite! 'bk-metric-pts 's 'g 'vs)
  (dk-rewrite-h! (list 'IN z (list 'PTS tgk-BKM)) (list 'PTS tgk-BKM) tgk-C)
  (tgk-dd-real! 'a z)
  (tgk-hf! sk)
  (tgk-and! (list '<= (tgk-dd 'a z) r) (list 'NOT (list '= (tgk-dd 'a z) r)))
  (dk-cite! 'rr-le-ne-lt (tgk-dd 'a z) r)
  (dk-cite! 'bk-nbhd-of-ball 's 'g 'vs 'k 'a z)
  (dk-conj-close! (lambda () (tgk-ass!))))
(qed 'bk-ball-in-nbhd)
(topic! 'bk-ball-in-nbhd 'analysis)

;;; ---- Theorem A.4 ----
(define tga4-rhs
  '(FORALL a (IMPLIES (IN a U) (FORSOME vs (AND (IS-BK-SEQUENCE s g vs)
     (FORSOME r (AND (POS-RR r) (SUBSET (BALL (BK-METRIC g vs) a r) U))))))))
(sp (make-wff (tgx-keep! 'top-group-pseudometrics-define-topology-gt (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (list 'FORALL 'U (list 'IMPLIES '(SUBSET U (PTS s)) (list 'IFF '(IN U (OPENS s)) tga4-rhs)))))))))
(dk-peel!)
(define tga4-cont (tgt-parts!))
(tgt-pts! '(IDEN g))
;; open  ==>  a ball of a BK pseudometric around each point
(dk-have! (list 'IMPLIES '(IN U (OPENS s)) tga4-rhs)
  (lambda ()
    (di)
    (let* ((a (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) 'U))) (dk-peel!)))))
           (ia (tgt-inv a)) (W (tgt-aW ia 'U))
           (bsq (list 'VNB-LAMBDA 'cw_ 'NN W)))
      (tgt-in-open! a 'U)
      (dk-cite! 'group-inv-in 'g a)
      (dk-cite! 'group-inv-inv 'g a)
      (dk-cite! 'top-group-translate-open-gt 's 'g ia 'U)
      (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g a)))
      (dk-have! (list 'IN '(IDEN g) W)
        (lambda () (in-sep! (lambda () (tgk-ass!))
                            (lambda () (subst (list '= (tgt-inv ia) a)) (subst (list '= (tgt-op a '(IDEN g)) a)) (tgk-ass!)))))
      (fact 'nn-is-set)
      (dk-have! (list 'IN bsq '(FUN NN (OPENS s)))
        (lambda () (for-each (lambda (leaf) (dk-focus! leaf)
                               (if (and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET)) (tgk-ass!)
                                   (begin (dk-peel!) (tgk-ass!))))
                             (dk-opened (lambda () (lam-t))))))
      (dk-have! (list 'FORALL 'bk_ (list 'IMPLIES '(IN bk_ NN) (list 'IN '(IDEN g) (list bsq 'bk_))))
        (lambda () (dk-peel!) (dk-lam-b!) (tgk-ass!)))
      (let* ((vs (dk-skolem! (dk-cite! 'top-group-nbhd-sequence-gt 's 'g bsq)))
             (dummy (dk-split-all!))
             (props (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h vs) (dk-contains? h 'cw_))) "the sequence clause")))
        (dk-have! (list 'IS-BK-SEQUENCE 's 'g vs)
          (lambda ()
            (mac 'IS-BK-SEQUENCE)
            (dk-conj-close!
             (lambda ()
               (if (dk-head-is? (dk-goal) 'FORALL)
                   (let ((k (cadr (car (dk-peel!)))))
                     (dk-split-all! (list (dk-apply! props k)))
                     (dk-conj-close! (lambda () (tgk-ass!))))
                   (tgk-ass!))))))
        (fact 'nn-zero-in)
        (dk-cite! 'nn-succ-closed 0)
        (dk-split-all! (list (dk-apply! props 0)))
        (dk-have! (list '= (list bsq 0) W) (lambda () (if (not (dk-lam-b!)) (rfl))))
        (dk-have! (list 'SUBSET (list vs '(succ 0)) W) (lambda () (subst (list '= W (list bsq 0))) (tgk-ass!)))
        (let* ((r (tgk-h '(succ (succ 0)))) (BKM (list 'BK-METRIC 'g vs)) (B (list 'BALL BKM a r)))
          (dk-cite! 'nn-succ-closed '(succ 0))
          (tgk-hf! '(succ (succ 0)))
          (fact 'rr-pos-rr-of-lt r)
          (dk-cite! 'group-carr-set 'g)
          (dk-cite! 'bk-metric-pts 's 'g vs)
          (dk-have! (list 'IN B 'SET)
            (lambda () (mac 'BALL) (sep-set) (subst (list '== (list 'PTS BKM) '(CARR g))) (tgk-ass!)))
          (ew vs)
          (dk-conj-close!
           (lambda ()
             (if (dk-head-is? (dk-goal) 'FORSOME)
                 (begin
                   (ew r)
                   (dk-conj-close!
                    (lambda ()
                      (if (dk-head-is? (dk-goal) 'SUBSET)
                          (begin
                            (mac 'subset-def)
                            (let ((z (cadr (car (filter (lambda (h) (dk-head-is? h 'IN)) (dk-peel!))))))
                              (dk-split-all! (list (dk-cite! 'bk-ball-in-nbhd 's 'g vs '(succ 0) a z)))
                              (dk-cite! 'subset-mem-fwd (list vs '(succ 0)) W (tgk-ivx a z))
                              (sep-me (list 'IN (tgk-ivx a z) W))
                              (dk-cite! 'group-mul-inv-cancel 'g a z)
                              (dk-rewrite-h! (list 'IN (tgt-op (tgt-inv ia) (tgk-ivx a z)) 'U) (tgt-inv ia) a)
                              (dk-rewrite-h! (list 'IN (tgt-op a (tgk-ivx a z)) 'U) (tgt-op a (tgk-ivx a z)) z)
                              (tgk-ass!)))
                          (tgk-ass!)))))
                 (tgk-ass!)))))
        ))))
;; a ball of a BK pseudometric around each point  ==>  open
(dk-have! (list 'IMPLIES tga4-rhs '(IN U (OPENS s)))
  (lambda ()
    (di)
    (let ((rh (dk-pick (lambda (h) (alpha-equiv? h tga4-rhs)) "the balls")))
      (dk-have! '(FORALL a (IMPLIES (IN a U) (FORSOME W2 (AND (IN W2 (OPENS s)) (AND (IN a W2) (SUBSET W2 U))))))
        (lambda ()
          (let* ((a (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!)))))
                 (vs (dk-skolem! (dk-apply! rh a))))
            (dk-split-all!)
            (let* ((r (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h vs) (dk-contains? h 'BALL))) "the radius")))
                   (BKM (list 'BK-METRIC 'g vs)) (B (list 'BALL BKM a r)))
              (dk-split-all!)
              (dk-cite! 'subset-mem-fwd 'U '(PTS s) a)
              (tgt-carr! a)
              (fact 'rr-pos-rr-in-rr r)
              (fact 'rr-lt-of-pos-rr r)
              (dk-cite! 'bk-ball-open 's 'g vs a r)
              (dk-cite! 'bk-metric-self 's 'g vs a)
              (dk-cite! 'bk-metric-pts 's 'g vs)
              (dk-have! (list 'IN a (list 'PTS BKM)) (lambda () (subst (list '== (list 'PTS BKM) '(CARR g))) (tgk-ass!)))
              (fact 'rr-zero-in)
              (dk-have! (list 'IN (list (list 'DIST BKM) a a) 'RR) (lambda () (subst (list '= (list (list 'DIST BKM) a a) 0)) (arith)))
              (dk-have! (list '<= (list (list 'DIST BKM) a a) r) (lambda () (subst (list '= (list (list 'DIST BKM) a a) 0)) (dk-ineq! (list '< 0 r) (list 'IN r 'RR))))
              (dk-have! (list 'NOT (list '= (list (list 'DIST BKM) a a) r))
                (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '= (list (list 'DIST BKM) a a) r) (list '= (list (list 'DIST BKM) a a) 0) (list '< 0 r) (list 'IN r 'RR) (list 'IN (list (list 'DIST BKM) a a) 'RR))))
                           (ai (dk-cite! 'rr-lt-irrefl 0))))
              (let ((iff (dk-cite! 'ball-membership BKM a r a)))
                (dk-have! (list 'IN a B)
                  (lambda () (if (dk-only! iff (list 'IN a (list 'PTS BKM)) (list '<= (list (list 'DIST BKM) a a) r) (list 'NOT (list '= (list (list 'DIST BKM) a a) r))) (prop)))))
              (ew B)
              (dk-conj-close! (lambda () (tgk-ass!)))))))
      (dk-cite! 'top-open-of-local 's 'U)
      (tgk-ass!))))
(if (dk-only! (list 'IMPLIES '(IN U (OPENS s)) tga4-rhs) (list 'IMPLIES tga4-rhs '(IN U (OPENS s)))) (prop))
