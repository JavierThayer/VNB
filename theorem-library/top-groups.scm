;;; ---- (135): g(x y z) <= 2 max(g x, g y, g z) ----
(sp (make-wff (tgk-hyps '(FORALL x (IMPLIES (IN x (CARR g)) (FORALL y (IMPLIES (IN y (CARR g)) (FORALL z (IMPLIES (IN z (CARR g))
   (<= (BK-GAUGE vs ((OPR g) ((OPR g) x y) z)) (* 2 (MAX (BK-GAUGE vs x) (MAX (BK-GAUGE vs y) (BK-GAUGE vs z))))))))))))))
(dk-peel!)
(tgk-setup!)
(fact 'nn-zero-in)
(define tgk-w (tgt-op (tgt-op 'x 'y) 'z))
(dk-cite! 'group-carrier-closed-opr 'g 'x 'y)
(dk-cite! 'group-carrier-closed-opr 'g (tgt-op 'x 'y) 'z)
(for-each tgt-pts! (list 'x 'y 'z tgk-w))
(for-each (lambda (t) (dk-have! (list 'IN t '(vs 0)) (lambda () (subst '(= (vs 0) (PTS s))) (tgk-ass!))) (tgk-gx! t)) (list 'x 'y 'z tgk-w))
(define tgk-m23 (list 'MAX (tgk-g 'y) (tgk-g 'z)))
(define tgk-M (list 'MAX (tgk-g 'x) tgk-m23))
(dk-cite! 'rr-max-closed (tgk-g 'y) (tgk-g 'z))
(dk-cite! 'rr-max-closed (tgk-g 'x) tgk-m23)
(dk-cite! 'rr-le-max-left (tgk-g 'x) tgk-m23)
(dk-cite! 'rr-le-max-right (tgk-g 'x) tgk-m23)
(dk-cite! 'rr-le-max-left (tgk-g 'y) (tgk-g 'z))
(dk-cite! 'rr-le-max-right (tgk-g 'y) (tgk-g 'z))
(define tgk-Mprem
  (list (list '<= (tgk-g 'x) tgk-M) (list '<= tgk-m23 tgk-M) (list '<= (tgk-g 'y) tgk-m23) (list '<= (tgk-g 'z) tgk-m23)
        (list 'IN tgk-M 'RR) (list 'IN tgk-m23 'RR) (list 'IN (tgk-g 'x) 'RR) (list 'IN (tgk-g 'y) 'RR) (list 'IN (tgk-g 'z) 'RR)
        (list '<= 0 (tgk-g 'x)) (list 'IN (tgk-g tgk-w) 'RR)))
;; the key claim
(define tgk-kc (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'IMPLIES (list '<= tgk-M '(power 1/2 (succ j))) (list '<= (tgk-g tgk-w) '(power 1/2 j))))))
(dk-have! tgk-kc
  (lambda ()
    (let* ((pl (dk-peel!))
           (j (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'NN))) pl))))
           (sj (list 'succ j)))
      (dk-cite! 'nn-succ-closed j)
      (tgk-hf! sj)
      (for-each (lambda (t)
                  (dk-have! (list '<= (tgk-g t) (tgk-h sj)) (lambda () (apply dk-ineq! (append (list (list '<= tgk-M (tgk-h sj)) (list 'IN (tgk-h sj) 'RR)) tgk-Mprem))))
                  (dk-cite! 'bk-gauge-char 's 'g 'vs t sj))
                (list 'x 'y 'z))
      (tgk-q! j)
      (dk-apply! (dk-apply! (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'bsr_) (dk-contains? h (list 'vs j)) (not (dk-contains? h 'bsk_)))) "the triple clause") 'x) 'y) 'z)
      (tgk-gle! tgk-w j)
      (tgk-ass!))))
(use-em (list '<= tgk-M 0)
  (lambda ()
    (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (tgk-g tgk-w) '(power 1/2 k))))
      (lambda ()
        (let* ((k (cadr (car (dk-peel!)))) (sk (list 'succ k)))
          (dk-cite! 'nn-succ-closed k)
          (tgk-hf! sk)
          (dk-have! (list '<= tgk-M (tgk-h sk)) (lambda () (dk-ineq! (list '<= tgk-M 0) (list '< 0 (tgk-h sk)) (list 'IN tgk-M 'RR) (list 'IN (tgk-h sk) 'RR))))
          (dk-apply! tgk-kc k)
          (tgk-ass!))))
    (dk-cite! 'half-power-small (tgk-g tgk-w))
    (apply dk-ineq! (append (list (list '<= (tgk-g tgk-w) 0)) tgk-Mprem)))
  (lambda ()
    (dk-cite! 'rr-not-le-lt tgk-M 0)
    (let ((pw (list 'FORSOME 'pk_ (list 'AND '(IN pk_ NN) (list '= tgk-M '(power 1/2 pk_)))))
          (from! (lambda (t chain)        ; chain: equations linking M to g(t), in context
                   (dk-have! (list '< 0 (tgk-g t))
                     (lambda () (apply dk-ineq! (append (list (list '< 0 tgk-M)) chain tgk-Mprem))))
                   (let ((kq (dk-skolem! (dk-cite! 'bk-gauge-power 's 'g 'vs t))))
                     (tgk-hf! kq)
                     (ew kq)
                     (dk-conj-close!
                      (lambda ()
                        (if (dk-head-is? (dk-goal) 'IN) (tgk-ass!)
                            (apply dk-ineq! (append (list (list '= (tgk-g t) (tgk-h kq)) (list 'IN (tgk-h kq) 'RR)) chain tgk-Mprem)))))))))
      (dk-have! pw
        (lambda ()
          (dk-cite! 'rr-max-cases (tgk-g 'x) tgk-m23)
          (use-em (list '= tgk-M (tgk-g 'x))
            (lambda () (from! 'x (list (list '= tgk-M (tgk-g 'x)))))
            (lambda ()
              (let ((or1 (dk-pick (lambda (h) (and (dk-head-is? h 'OR) (dk-contains? h tgk-m23) (dk-contains? h tgk-M))) "max cases")))
                (dk-have! (list '= tgk-M tgk-m23) (lambda () (if (dk-only! or1 (list 'NOT (list '= tgk-M (tgk-g 'x)))) (prop)))))
              (dk-cite! 'rr-max-cases (tgk-g 'y) (tgk-g 'z))
              (use-em (list '= tgk-m23 (tgk-g 'y))
                (lambda () (from! 'y (list (list '= tgk-M tgk-m23) (list '= tgk-m23 (tgk-g 'y)))))
                (lambda ()
                  (let ((or2 (dk-pick (lambda (h) (and (dk-head-is? h 'OR) (not (dk-contains? h tgk-M)) (dk-contains? h tgk-m23))) "max cases 2")))
                    (dk-have! (list '= tgk-m23 (tgk-g 'z)) (lambda () (if (dk-only! or2 (list 'NOT (list '= tgk-m23 (tgk-g 'y)))) (prop)))))
                  (from! 'z (list (list '= tgk-M tgk-m23) (list '= tgk-m23 (tgk-g 'z))))))))))
      (let* ((kk (dk-skolem! pw)) (eqM (list '= tgk-M (tgk-h kk))))
        (dk-split-all!)
        (use-em (list '= kk 0)
          (lambda ()
            (let ((e0 (begin (dk-rewrite-h! eqM kk 0))))
              (dk-have! '(IN 1/2 CC) (lambda () (arith)))
              (fact 'power-zero 1/2)
              (tgk-hf! 0)
              (apply dk-ineq! (append (list (list '<= (tgk-g tgk-w) (tgk-h 0)) (list '= tgk-M (tgk-h 0)) (list '= (tgk-h 0) 1)
                                            (list 'IN (tgk-h 0) 'RR)) tgk-Mprem))))
          (lambda ()
            (let* ((jj (begin (dk-skolem! (dk-cite! 'nn-nonzero-is-succ kk)))) (sj (list 'succ jj)))
              (dk-cite! 'nn-succ-closed jj)
              (dk-rewrite-h! eqM kk sj)
              (tgk-hf! jj) (tgk-hf! sj)
              (dk-have! (list '<= tgk-M (tgk-h sj)) (lambda () (dk-ineq! (list '= tgk-M (tgk-h sj)) (list 'IN tgk-M 'RR) (list 'IN (tgk-h sj) 'RR))))
              (dk-apply! tgk-kc jj)
              (apply dk-ineq! (append (list (list '<= (tgk-g tgk-w) (tgk-h jj)) (list '= tgk-M (tgk-h sj)) (list '= (tgk-h sj) (list '* 1/2 (tgk-h jj)))
                                            (list 'IN (tgk-h jj) 'RR) (list 'IN (tgk-h sj) 'RR)) tgk-Mprem)))))))))
(qed 'bk-gauge-triple)
(topic! 'bk-gauge-triple 'analysis)

;;; =====================================================================
;;; Proposition A.5 applied to the gauge on the monoid of g
;;; =====================================================================
(define tgk-Mo '(GRP-MONOID g))
(define tgk-Gf '(VNB-LAMBDA bfz_ (CARR g) (BK-GAUGE vs bfz_)))
(define (tgk-F x) (list 'BK-F 'g 'vs x))
(define (tgk-SR x) (list 'SUBADD-REG tgk-Mo tgk-Gf x))
(sp (make-wff (list 'FORALL 'g (list 'FORALL 'vs (list 'FORALL 'x (list '== (tgk-F 'x) (tgk-SR 'x)))))))
(dk-peel!)
(mac 'BK-F)
(qrfl)
(qed 'bk-f-unfold)
(topic! 'bk-f-unfold 'plumbing)

;; a point of g: in PTS(s), in vs(0), its gauge real and >= 0
(define (tgk-pt! v)
  (tgt-pts! v)
  (if (not (dk-asm? (list 'IN v '(vs 0))))
      (dk-have! (list 'IN v '(vs 0)) (lambda () (subst '(= (vs 0) (PTS s))) (tgk-ass!))))
  (tgk-gx! v))
(define (tgk-a5-triple!)
  (let* ((g0 (dk-goal)) (arg (cadr (cadr g0))) (xy (cadr arg)) (z (caddr arg)) (x (cadr xy)) (y (caddr xy)))
    (dk-cite! 'group-carrier-closed-opr 'g x y)
    (dk-cite! 'group-carrier-closed-opr 'g xy z)
    (for-each tgk-pt! (list x y z arg))
    (dk-lam-b!)
    (dk-cite! 'bk-gauge-triple 's 'g 'vs x y z)
    (tgk-ass!)))
;; land the five hypotheses of the A.5 theorems at m := GRP-MONOID(g), g := the gauge
(define (tgk-a5-hyps!)
  (fact 'grp-monoid-is-monoid 'g)
  (fact 'grp-monoid-carr 'g) (fact 'grp-monoid-opr 'g) (fact 'grp-monoid-iden 'g)
  (let ((cm (list 'CARR tgk-Mo)))
    (dk-have! (list 'IN tgk-Gf '(FUN (CARR g) RR))
      (lambda ()
        (for-each (lambda (leaf) (dk-focus! leaf)
                    (if (and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET))
                        (begin (dk-cite! 'group-carr-set 'g) (tgk-ass!))
                        (let ((v (cadr (car (dk-peel!))))) (tgk-pt! v) (tgk-ass!))))
                  (dk-opened (lambda () (lam-t))))))
    (dk-have! (list 'IN tgk-Gf (list 'FUN cm 'RR)) (lambda () (subst (list '== cm '(CARR g))) (tgk-ass!)))
    (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x cm) (list '<= 0 (list tgk-Gf 'x))))
      (lambda ()
        (let ((v (cadr (car (dk-peel!)))))
          (dk-rewrite-h! (list 'IN v cm) cm '(CARR g))
          (tgk-pt! v)
          (dk-lam-b!)
          (tgk-ass!))))
    (dk-have! (list '= (list tgk-Gf (list 'IDEN tgk-Mo)) 0)
      (lambda ()
        (subst (list '== (list 'IDEN tgk-Mo) '(IDEN g)))
        (dk-lam-b!)
        (dk-cite! 'bk-gauge-iden 's 'g 'vs)
        (tgk-ass!)))
    (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x cm) (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y cm) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z cm)
                (list '<= (list tgk-Gf (list (list 'OPR tgk-Mo) (list (list 'OPR tgk-Mo) 'x 'y) 'z))
                          (list '* 2 (list 'MAX (list tgk-Gf 'x) (list 'MAX (list tgk-Gf 'y) (list tgk-Gf 'z)))))))))))
      (lambda ()
        (let* ((pl (dk-peel!))
               (vs3 (map cadr (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) cm))) pl))))
          (for-each (lambda (v) (dk-rewrite-h! (list 'IN v cm) cm '(CARR g))) vs3)
          (subst (list '== (list 'OPR tgk-Mo) '(OPR g)))
          (tgk-a5-triple!))))))

;;; ---- the regularised gauge: real, between g/2 and g, subadditive ----
(define (tgk-tocm! v) (dk-rewrite-h! (list 'IN v '(CARR g)) '(CARR g) (list 'CARR tgk-Mo)))
(sp (make-wff (tgk-hyps '(FORALL x (IMPLIES (IN x (CARR g))
   (AND (IN (BK-F g vs x) RR) (AND (<= (* 1/2 (BK-GAUGE vs x)) (BK-F g vs x)) (<= (BK-F g vs x) (BK-GAUGE vs x)))))))))
(dk-peel!)
(tgk-setup!)
(tgk-a5-hyps!)
(tgk-tocm! 'x)
(tgk-pt! 'x)
(dk-cite! 'bk-f-unfold 'g 'vs 'x)
(let ((b (dk-cite! 'subadd-reg-bounds tgk-Mo tgk-Gf 'x)))
  (dk-split-all! (list b))
  (dk-have! (list '= (list tgk-Gf 'x) '(BK-GAUGE vs x)) (lambda () (if (not (dk-lam-b!)) (rfl))))
  (subst (list '== (tgk-F 'x) (tgk-SR 'x)))
  (subst (list '= '(BK-GAUGE vs x) (list tgk-Gf 'x)))
  (dk-conj-close! (lambda () (tgk-ass!))))
(qed 'bk-f-bounds)
(topic! 'bk-f-bounds 'analysis)

(sp (make-wff (tgk-hyps '(FORALL a (IMPLIES (IN a (CARR g)) (FORALL b (IMPLIES (IN b (CARR g))
   (<= (BK-F g vs ((OPR g) a b)) (+ (BK-F g vs a) (BK-F g vs b))))))))))
(dk-peel!)
(tgk-setup!)
(tgk-a5-hyps!)
(dk-cite! 'group-carrier-closed-opr 'g 'a 'b)
(tgk-tocm! 'a) (tgk-tocm! 'b)
(dk-cite! 'bk-f-unfold 'g 'vs 'a)
(dk-cite! 'bk-f-unfold 'g 'vs 'b)
(dk-cite! 'bk-f-unfold 'g 'vs '((OPR g) a b))
(subst (list '== (tgk-F '((OPR g) a b)) (tgk-SR '((OPR g) a b))))
(subst (list '== (tgk-F 'a) (tgk-SR 'a)))
(subst (list '== (tgk-F 'b) (tgk-SR 'b)))
(subst (list '== '(OPR g) (list 'OPR tgk-Mo)))
(dk-cite! 'subadd-reg-subadditive tgk-Mo tgk-Gf 'a 'b)
(tgk-ass!)
(qed 'bk-f-subadditive)
(topic! 'bk-f-subadditive 'analysis)

;;; =====================================================================
;;; The metric d(x, y) = f(y^-1 x) + f(x^-1 y)
;;; =====================================================================
(define tgk-hsep '(FORALL hz_ (IMPLIES (IN hz_ (CARR g)) (IMPLIES (FORALL hk_ (IMPLIES (IN hk_ NN) (IN hz_ (vs hk_)))) (= hz_ (IDEN g))))))
(define (tgk-hyps2 body) (tgk-hyps (list 'IMPLIES tgk-hsep body)))
(define tgk-C '(CARR g))
(define tgk-BKM '(BK-METRIC g vs))
(define (tgk-ivx a b) (tgt-op (tgt-inv a) b))          ; a^-1 b
(define (tgk-D x y) (list '+ (tgk-F (tgk-ivx y x)) (tgk-F (tgk-ivx x y))))
(define tgk-lam (list 'VNB-LAMBDA '(LIST bmx_ bmy_) (list 'CARTESIAN tgk-C tgk-C) (tgk-D 'bmx_ 'bmy_)))
;; a^-1 b in the carrier, with F of it real and >= 0
(define (tgk-ivf! a b)
  (let ((z (tgk-ivx a b)))
    (if (not (dk-asm? (list '<= 0 (tgk-F z))))
        (begin
          (dk-cite! 'group-inv-in 'g a)
          (dk-cite! 'group-carrier-closed-opr 'g (tgt-inv a) b)
          (tgk-pt! z)
          (dk-split-all! (list (dk-cite! 'bk-f-bounds 's 'g 'vs z)))
          (dk-have! (list '<= 0 (tgk-F z))
            (lambda () (dk-ineq! (list '<= (list '* 1/2 (tgk-g z)) (tgk-F z)) (list '<= 0 (tgk-g z)) (list 'IN (tgk-g z) 'RR) (list 'IN (tgk-F z) 'RR))))))
    z))
(define (tgk-d! x y)                       ; D(x, y) real, >= 0
  (tgk-ivf! y x) (tgk-ivf! x y)
  (let ((d (tgk-D x y)))
    (if (not (dk-asm? (list 'IN d 'RR)))
        (begin
          (dk-cite! 'rr-add-in-rr (tgk-F (tgk-ivx y x)) (tgk-F (tgk-ivx x y)))
          (dk-have! (list '<= 0 d) (lambda () (dk-ineq! (list '<= 0 (tgk-F (tgk-ivx y x))) (list '<= 0 (tgk-F (tgk-ivx x y)))
                                                        (list 'IN (tgk-F (tgk-ivx y x)) 'RR) (list 'IN (tgk-F (tgk-ivx x y)) 'RR))))))
    d))

(sp (make-wff (tgk-hyps (list 'IN tgk-lam (list 'FUN (list 'CARTESIAN tgk-C tgk-C) 'RR)))))
(dk-peel!)
(tgk-setup!)
(dk-cite! 'group-carr-set 'g)
(for-each (lambda (leaf) (dk-focus! leaf)
            (if (and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET))
                (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (tgk-ass!))))
                (let* ((pl (dk-peel!)) (d (cadr (dk-goal))) (z (cadddr (cadr d)))
                       (y (cadr (cadr z))) (xx (caddr z)))
                  (tgk-d! xx y)
                  (tgk-ass!))))
          (dk-opened (lambda () (lam-t))))
(qed 'bk-metric-lam-type)
(topic! 'bk-metric-lam-type 'plumbing)

(define (tgk-readoff! name acc val)
