(topic! 'bk-gauge-char 'analysis)

;;; ---- g(e) = 0 ----
(sp (make-wff (tgk-hyps '(= (BK-GAUGE vs (IDEN g)) 0))))
(dk-peel!)
(tgk-setup!)
