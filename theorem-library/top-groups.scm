;;; ---- a positive value of the gauge is a power of 1/2 ----
(sp (make-wff (tgk-hyps '(FORALL x (IMPLIES (IN x (PTS s)) (IMPLIES (< 0 (BK-GAUGE vs x))
   (FORSOME kq (AND (IN kq NN) (= (BK-GAUGE vs x) (power 1/2 kq))))))))))
(dk-peel!)
(tgk-setup!)
(dk-have! '(IN x (vs 0)) (lambda () (subst '(= (vs 0) (PTS s))) (tgk-ass!)))
(fact 'nn-zero-in)
(tgk-gx! 'x)
(define tgk-ex '(FORSOME k (AND (IN k NN) (NOT (IN x (vs k))))))
(use-em tgk-ex
  (lambda ()
    (let* ((k (dk-skolem! tgk-ex))
           (kq (dk-skolem! (dk-cite! 'bk-last-nbhd 's 'g 'vs 'x k))))
      (dk-split-all!)
      (dk-cite! 'bk-gauge-exact 's 'g 'vs 'x kq)
      (ew kq)
      (dk-conj-close! (lambda () (tgk-ass!)))))
  (lambda ()
    (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (tgk-g 'x) '(power 1/2 k))))
      (lambda ()
        (let ((k (cadr (car (dk-peel!)))))
          (dk-have! (list 'IN 'x (list 'vs k))
            (lambda ()
              (use-em (list 'IN 'x (list 'vs k))
                (lambda () (tgk-ass!))
                (lambda () (dk-have! tgk-ex (lambda () (ew k) (dk-conj-close! (lambda () (tgk-ass!)))))
                           (ai (list 'NOT tgk-ex))))))
          (tgk-gle! 'x k)
          (tgk-ass!))))
    (dk-cite! 'half-power-small (tgk-g 'x))
    (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '<= (tgk-g 'x) 0) (list '< 0 (tgk-g 'x)) (list 'IN (tgk-g 'x) 'RR))))
    (ai (dk-cite! 'rr-lt-irrefl 0))))
