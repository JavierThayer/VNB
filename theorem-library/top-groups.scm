(dk-split-all! (list (dk-cite! 'bk-f-bounds 's 'g 'vs '(IDEN g))))
(dk-cite! 'bk-gauge-iden 's 'g 'vs)
(dk-ineq! (list '<= (tgk-F '(IDEN g)) (tgk-g '(IDEN g))) (list '<= (list '* 1/2 (tgk-g '(IDEN g))) (tgk-F '(IDEN g)))
          (list '= (tgk-g '(IDEN g)) 0) (list 'IN (tgk-F '(IDEN g)) 'RR) (list 'IN (tgk-g '(IDEN g)) 'RR))
