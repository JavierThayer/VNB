;;; tg-top.scm -- what continuity of (x, y) |-> x y^-1 gives in a topological group: the
;;; inverse and the left translates of an open set are open, and an open neighbourhood of e
;;; contains a symmetric open V with V V V inside it.  Plus the local criterion for openness.
;;; Agent ISOM, 2026-10-26.  Helper prefix: tgt-.  Library: analysis.
;;; 2026-10-26 (later): every theorem about a topological group is proved for a group topology
;;; (s, g) under NAME-gt and restated for the structure TOP-GROUP under NAME (tgx-lift!,
;;; through top-group-group-topology of tg-struct.scm).

(define (tgt-head g) (and (pair? g) (car g)))
(define (tgt-and! a b) (dk-have! (list 'AND a b) (lambda () (dk-conj-close! (lambda () (ass))))))
(define (tgt-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (tgt-var-in pl cls)
  (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) cls))) pl))))

;;; ---- the lift to the structure (2026-10-26): each NAME-gt is proved for a group topology
;;; (s, g); NAME restates it for a TOP-GROUP G at s := TOP-GROUP-SPACE(G),
;;; g := TOP-GROUP-GROUP(G), by top-group-group-topology (tb11/tg-struct.scm).
(define tgx-stmts '())
(define (tgx-keep! nm f) (set! tgx-stmts (cons (cons nm f) tgx-stmts)) f)
(define (tgx-subst e)
  (cond ((eq? e 's) '(TOP-GROUP-SPACE G)) ((eq? e 'g) '(TOP-GROUP-GROUP G))
        ((pair? e) (map tgx-subst e)) (#t e)))
(define (tgx-lift! nm-gt nm)
  (let* ((f (cdr (assq nm-gt tgx-stmts)))          ; (FORALL s (FORALL g (IMPLIES HYP BODY)))
         (body (caddr (caddr (caddr f)))))
    (dk-sp-qed! (make-wff (list 'FORALL 'G (list 'IMPLIES '(IS-TOP-GROUP G) (tgx-subst body))))
      (lambda ()
        (di) (di)
        (dk-cite! 'top-group-space-is-top-space 'G)
        (dk-cite! 'top-group-group-is-group 'G)
        (dk-cite! 'top-group-group-topology 'G)
        (dk-cite! nm-gt '(TOP-GROUP-SPACE G) '(TOP-GROUP-GROUP G))
        (ass))
      nm)
    (topic! nm 'analysis)))


;;; ---- a set that is a neighbourhood of each of its points is open ----
(define tgt-fam '(SEP lw_ (OPENS s) (SUBSET lw_ U)))
(define tgt-bu (list 'BIG-UNION 'lu_ tgt-fam 'lu_))
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-TOP-SPACE s) (list 'FORALL 'U (list 'IMPLIES '(SUBSET U (PTS s))
   (list 'IMPLIES '(FORALL a (IMPLIES (IN a U) (FORSOME W (AND (IN W (OPENS s)) (AND (IN a W) (SUBSET W U))))))
     '(IN U (OPENS s)))))))))
(dk-peel!)
(let* ((iff (dk-cite! 'is-top-space 's)))
  (dk-have! (caddr iff) (lambda () (if (dk-only! iff '(IS-TOP-SPACE s)) (prop))))
  (dk-split-all! (list (caddr iff))))
(define tgt-loc (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'U) (dk-contains? h 'FORSOME))) "the local hypothesis"))
(dk-have! (list 'SUBSET tgt-fam '(OPENS s))
  (lambda () (mac 'subset-def)
             (let ((v (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
               (sep-me (list 'IN v tgt-fam)) (tgt-ass!))))
(dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'BIG-UNION))) "the union law") tgt-fam)
(dk-have! (list 'FORALL 'x (list 'IFF '(IN x U) (list 'IN 'x tgt-bu)))
  (lambda ()
    (begin
      (di)
      (let* ((g (dk-goal)) (x (cadr (cadr g))))
        (dk-have! (list 'IMPLIES (list 'IN x 'U) (list 'IN x tgt-bu))
          (lambda ()
            (di)
            (let ((w (dk-skolem! (dk-apply! tgt-loc x))))
              (dk-split-all!)
              (for-each (lambda (leaf) (dk-focus! leaf)
                          (if (equal? (dk-goal) (list 'IN w tgt-fam))
                              (in-sep! (lambda () (tgt-ass!)) (lambda () (tgt-ass!)))
                              (tgt-ass!)))
                        (dk-opened (lambda () (bu-mi w)))))))
        (dk-have! (list 'IMPLIES (list 'IN x tgt-bu) (list 'IN x 'U))
          (lambda ()
            (di)
            (let ((ls (dk-landed (lambda () (bu-me (list 'IN x tgt-bu))))))
              (let ((e (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) tgt-fam))) ls)))))
                (sep-me (list 'IN e tgt-fam))
                (dk-cite! 'subset-mem-fwd e 'U x)
                (tgt-ass!)))))
        (if (dk-only! (list 'IMPLIES (list 'IN x 'U) (list 'IN x tgt-bu)) (list 'IMPLIES (list 'IN x tgt-bu) (list 'IN x 'U))) (prop))))))
(dk-cite! 'class-extensionality 'U tgt-bu)
(subst (list '= 'U tgt-bu))
(tgt-ass!)
(qed 'top-open-of-local)
(topic! 'top-open-of-local 'analysis)

;;; ---- an open set is a set of points ----
(sp (make-wff '(FORALL s (IMPLIES (IS-TOP-SPACE s) (FORALL V (IMPLIES (IN V (OPENS s)) (SUBSET V (PTS s))))))))
(dk-peel!)
(let* ((iff (dk-cite! 'is-top-space 's)))
  (dk-have! (caddr iff) (lambda () (if (dk-only! iff '(IS-TOP-SPACE s)) (prop))))
  (dk-split-all! (list (caddr iff))))
(let ((iff (dk-cite! 'power-set-membership '(POWER (PTS s)) '(OPENS s))))
  (dk-have! (caddr iff) (lambda () (if (dk-only! iff '(IN (OPENS s) (POWER (POWER (PTS s))))) (prop))))
  (dk-split-all! (list (caddr iff))))
(dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(OPENS s)) (dk-contains? h 'POWER))) "opens in power") 'V)
(let ((iff (dk-cite! 'power-set-membership '(PTS s) 'V)))
  (dk-have! (caddr iff) (lambda () (if (dk-only! iff '(IN V (POWER (PTS s)))) (prop))))
  (dk-split-all! (list (caddr iff))))
(mac 'subset-def)
(tgt-ass!)
(qed 'top-open-subset)
(topic! 'top-open-subset 'plumbing)

;;; ---- the parts of a topological group ----
(define tgt-cont
  '(FORALL tga_ (IMPLIES (IN tga_ (CARR g)) (FORALL tgb_ (IMPLIES (IN tgb_ (CARR g))
     (FORALL tgw_ (IMPLIES (IN tgw_ (OPENS s)) (IMPLIES (IN ((OPR g) tga_ ((INV g) tgb_)) tgw_)
       (FORSOME tgu_ (AND (IN tgu_ (OPENS s)) (AND (IN tga_ tgu_)
         (FORSOME tgv_ (AND (IN tgv_ (OPENS s)) (AND (IN tgb_ tgv_)
           (FORALL tgp_ (IMPLIES (IN tgp_ tgu_) (FORALL tgq_ (IMPLIES (IN tgq_ tgv_)
             (IN ((OPR g) tgp_ ((INV g) tgq_)) tgw_)))))))))))))))))))
(sp (make-wff (tgx-keep! 'top-group-parts-gt (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (list 'AND '(IS-TOP-SPACE s) (list 'AND '(IS-GROUP g) (list 'AND '(= (PTS s) (CARR g)) tgt-cont)))))))))
(dk-peel!)
(mac-h 'IS-GROUP-TOPOLOGY '(IS-GROUP-TOPOLOGY s g))
(tgt-ass!)
(qed 'top-group-parts-gt)
(topic! 'top-group-parts-gt 'plumbing)
(tgx-lift! 'top-group-parts-gt 'top-group-parts)

;;; common set-up: the parts of IS-TOP-GROUP(s, g) and the continuity universal
(define (tgt-parts!)
  (dk-split-all! (list (dk-cite! 'top-group-parts-gt 's 'g)))
  (fact 'group-identity-in 'g)
  (dk-pick (lambda (h) (alpha-equiv? h tgt-cont)) "continuity"))
;; t in PTS(s)  <->  t in CARR(g)
(define (tgt-carr! t)
  (if (not (dk-asm? (list 'IN t '(CARR g))))
      (dk-rewrite-h! (list 'IN t '(PTS s)) '(PTS s) '(CARR g))))
(define (tgt-pts! t)
  (if (not (dk-asm? (list 'IN t '(PTS s))))
      (dk-rewrite-h! (list 'IN t '(CARR g)) '(CARR g) '(PTS s))))
;; a point of an open set is a point of the space
(define (tgt-in-open! q V)
  (dk-cite! 'top-open-subset 's V)
  (dk-cite! 'subset-mem-fwd V '(PTS s) q)
  (tgt-carr! q))
(define (tgt-op a b) (list '(OPR g) a b))
(define (tgt-inv a) (list '(INV g) a))
;; the continuity universal at (a, b, W), with a b^-1 in W in context: returns (U V clause)
(define (tgt-cont-at! cont a b W)
  (let* ((u (dk-skolem! (dk-apply! cont a b W)))
         (ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h u) (eq? (cadr h) 'tgv_))) "the second neighbourhood"))
         (v (dk-skolem! ex))
         (cl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u) (dk-contains? h v))) "the product clause")))
    (list u v cl)))

;;; ---- the inverse image of an open set is open ----
(define (tgt-WI W) (list 'SEP 'iz_ '(PTS s) (list 'IN '((INV g) iz_) W)))
(sp (make-wff (tgx-keep! 'top-group-inv-open-gt (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (list 'FORALL 'W (list 'IMPLIES '(IN W (OPENS s)) (list 'IN (tgt-WI 'W) '(OPENS s))))))))))
(dk-peel!)
(let* ((cont (tgt-parts!)) (WI (tgt-WI 'W)) (e '(IDEN g)))
  (dk-have! (list 'SUBSET WI '(PTS s))
    (lambda () (mac 'subset-def)
               (let ((z (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
                 (sep-me (list 'IN z WI)) (tgt-ass!))))
  (dk-have! (list 'FORALL 'a (list 'IMPLIES (list 'IN 'a WI)
              (list 'FORSOME 'W2 (list 'AND '(IN W2 (OPENS s)) (list 'AND '(IN a W2) (list 'SUBSET 'W2 WI))))))
    (lambda ()
      (let ((y (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
        (sep-me (list 'IN y WI))
        (tgt-carr! y)
        (dk-cite! 'group-inv-in 'g y)
        (dk-cite! 'group-left-id 'g (tgt-inv y))
        (dk-have! (list 'IN (tgt-op e (tgt-inv y)) 'W) (lambda () (subst (list '= (tgt-op e (tgt-inv y)) (tgt-inv y))) (tgt-ass!)))
        (let* ((uvc (tgt-cont-at! cont e y 'W)) (u1 (car uvc)) (v (cadr uvc)) (cl (caddr uvc)))
          (ew v)
          (dk-conj-close!
           (lambda ()
             (if (dk-head-is? (dk-goal) 'SUBSET)
                 (begin
                   (mac 'subset-def)
                   (let ((q (cadr (car (filter (lambda (h) (dk-head-is? h 'IN)) (dk-peel!))))))
                     (tgt-in-open! q v)
                     (dk-cite! 'group-inv-in 'g q)
                     (dk-cite! 'group-left-id 'g (tgt-inv q))
                     (dk-apply! (dk-apply! cl e) q)
                     (in-sep! (lambda () (tgt-ass!))
                              (lambda () (subst (list '= (tgt-inv q) (tgt-op e (tgt-inv q)))) (tgt-ass!)))))
                 (tgt-ass!))))))))
  (dk-cite! 'top-open-of-local 's WI)
  (tgt-ass!))
(qed 'top-group-inv-open-gt)
(topic! 'top-group-inv-open-gt 'analysis)
(tgx-lift! 'top-group-inv-open-gt 'top-group-inv-open)

;;; ---- left translates of an open set are open: a W = { z : a^-1 z in W } ----
(define (tgt-aW a W) (list 'SEP 'tz_ '(PTS s) (list 'IN (list '(OPR g) (list '(INV g) a) 'tz_) W)))
(sp (make-wff (tgx-keep! 'top-group-translate-open-gt (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (list 'FORALL 'a (list 'IMPLIES '(IN a (CARR g)) (list 'FORALL 'W (list 'IMPLIES '(IN W (OPENS s))
     (list 'IN (tgt-aW 'a 'W) '(OPENS s))))))))))))
(dk-peel!)
(let* ((cont (tgt-parts!)) (aW (tgt-aW 'a 'W)) (ia (tgt-inv 'a)))
  (dk-cite! 'group-inv-in 'g 'a)
  (dk-have! (list 'SUBSET aW '(PTS s))
    (lambda () (mac 'subset-def)
               (let ((z (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
                 (sep-me (list 'IN z aW)) (tgt-ass!))))
  (dk-have! (list 'FORALL 'a2 (list 'IMPLIES (list 'IN 'a2 aW)
              (list 'FORSOME 'W2 (list 'AND '(IN W2 (OPENS s)) (list 'AND '(IN a2 W2) (list 'SUBSET 'W2 aW))))))
    (lambda ()
      (let* ((y (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!)))))
             (iy (tgt-inv y)))
        (sep-me (list 'IN y aW))
        (tgt-carr! y)
        (dk-cite! 'group-inv-in 'g y)
        (dk-cite! 'group-inv-inv 'g y)
        (dk-have! (list 'IN (tgt-op ia (tgt-inv iy)) 'W) (lambda () (subst (list '= (tgt-inv iy) y)) (tgt-ass!)))
        (let* ((uvc (tgt-cont-at! cont ia iy 'W)) (v (cadr uvc)) (cl (caddr uvc)) (vi (tgt-WI v)))
          (dk-cite! 'top-group-inv-open-gt 's 'g v)
          (ew vi)
          (dk-conj-close!
           (lambda ()
             (cond
              ((dk-head-is? (dk-goal) 'SUBSET)
               (mac 'subset-def)
               (let ((z (cadr (car (filter (lambda (h) (dk-head-is? h 'IN)) (dk-peel!))))))
                 (sep-me (list 'IN z vi))
                 (tgt-carr! z)
                 (dk-cite! 'group-inv-in 'g z)
                 (dk-cite! 'group-inv-inv 'g z)
                 (dk-apply! (dk-apply! cl ia) (tgt-inv z))
                 (in-sep! (lambda () (tgt-ass!))
                          (lambda () (subst (list '= z (tgt-inv (tgt-inv z)))) (tgt-ass!)))))
              ((equal? (dk-goal) (list 'IN y vi))
               (in-sep! (lambda () (tgt-pts! y) (tgt-ass!)) (lambda () (tgt-ass!))))
              (#t (tgt-ass!)))))))))
  (dk-cite! 'top-open-of-local 's aW)
  (tgt-ass!))
(qed 'top-group-translate-open-gt)
(topic! 'top-group-translate-open-gt 'analysis)
(tgx-lift! 'top-group-translate-open-gt 'top-group-translate-open)

;;; ---- an open neighbourhood W of e contains a symmetric open V with V V inside W ----
(define (tgt-sym V) (list 'FORALL 'sp_ (list 'IMPLIES (list 'IN 'sp_ V) (list 'IN '((INV g) sp_) V))))
(define (tgt-pair V W) (list 'FORALL 'pp_ (list 'IMPLIES (list 'IN 'pp_ V) (list 'FORALL 'pq_ (list 'IMPLIES (list 'IN 'pq_ V)
                        (list 'IN '((OPR g) pp_ pq_) W))))))
(define (tgt-int a b) (list 'INTERSECTION a b))
;; membership in an intersection, both ways
(define (tgt-int-parts! z a b)
  (let ((iff (dk-cite! 'intersection-membership a b z)))
    (dk-have! (list 'AND (list 'IN z a) (list 'IN z b)) (lambda () (if (dk-only! iff (list 'IN z (tgt-int a b))) (prop))))
    (dk-split-all! (list (list 'AND (list 'IN z a) (list 'IN z b))))))
(define (tgt-int-intro! z a b)
  (let ((iff (dk-cite! 'intersection-membership a b z)))
    (dk-have! (list 'IN z (tgt-int a b)) (lambda () (if (dk-only! iff (list 'IN z a) (list 'IN z b)) (prop))))))
;; the binary intersection law
(define tgt-int-law '(FORALL u (IMPLIES (IN u (OPENS s)) (FORALL v (IMPLIES (IN v (OPENS s)) (IN (INTERSECTION u v) (OPENS s)))))))
(define (tgt-int-open! a b)
  (if (not (dk-asm? tgt-int-law))
      (let ((iff (dk-cite! 'is-top-space 's)))
        (dk-have! (caddr iff) (lambda () (if (dk-only! iff '(IS-TOP-SPACE s)) (prop))))
        (dk-split-all! (list (caddr iff)))))
  (if (not (dk-asm? (list 'IN (tgt-int a b) '(OPENS s))))
      (dk-apply! (dk-ctx-form tgt-int-law) a b)))

(sp (make-wff (tgx-keep! 'top-group-sym-pair-gt (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (list 'FORALL 'W (list 'IMPLIES '(IN W (OPENS s)) (list 'IMPLIES '(IN (IDEN g) W)
     (list 'FORSOME 'V (list 'AND '(IN V (OPENS s)) (list 'AND '(IN (IDEN g) V)
       (list 'AND (tgt-sym 'V) (tgt-pair 'V 'W))))))))))))))
(dk-peel!)
(let* ((cont (tgt-parts!)) (e '(IDEN g)))
  (dk-cite! 'group-inv-iden 'g)
  (dk-have! (list 'IN (tgt-op e (tgt-inv e)) 'W) (lambda () (subst (list '= (tgt-inv e) e)) (dk-cite! 'group-left-id 'g e) (subst (list '= (tgt-op e e) e)) (tgt-ass!)))
  (let* ((uvc (tgt-cont-at! cont e e 'W)) (u1 (car uvc)) (u2 (cadr uvc)) (cl (caddr uvc))
         (u2i (tgt-WI u2)) (A (tgt-int u1 u2i)) (ai (tgt-WI A)) (S (tgt-int A ai)))
    (dk-cite! 'top-group-inv-open-gt 's 'g u2)
    (tgt-int-open! u1 u2i)
    (dk-cite! 'top-group-inv-open-gt 's 'g A)
    (tgt-int-open! A ai)
    (fact 'group-identity-in 'g)
    (tgt-pts! e)
    ;; e is in all of them
    (dk-have! (list 'IN e u2i) (lambda () (in-sep! (lambda () (tgt-ass!)) (lambda () (subst (list '= (tgt-inv e) e)) (tgt-ass!)))))
    (tgt-int-intro! e u1 u2i)
    (dk-have! (list 'IN e ai) (lambda () (in-sep! (lambda () (tgt-ass!)) (lambda () (subst (list '= (tgt-inv e) e)) (tgt-ass!)))))
    (tgt-int-intro! e A ai)
    (ew S)
    (dk-conj-close!
     (lambda ()
       (let ((g0 (dk-goal)))
         (cond
          ((and (dk-head-is? g0 'FORALL) (dk-contains? g0 'pq_))
           ;; S S inside W
           (let* ((pl (dk-peel!))
                  (ins (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) S))) pl))
                  (p (cadr (car ins))) (q (cadr (cadr ins))))
             (tgt-int-parts! p A ai) (tgt-int-parts! p u1 u2i)
             (tgt-int-parts! q A ai) (tgt-int-parts! q u1 u2i)
             (sep-me (list 'IN q u2i))
             (tgt-in-open! p u1) (tgt-in-open! q u1)
             (dk-cite! 'group-inv-in 'g q)
             (dk-cite! 'group-inv-inv 'g q)
             (dk-apply! (dk-apply! cl p) (tgt-inv q))
             (dk-rewrite-h! (list 'IN (tgt-op p (tgt-inv (tgt-inv q))) 'W) (tgt-inv (tgt-inv q)) q)
             (tgt-ass!)))
          ((dk-head-is? g0 'FORALL)
           ;; S symmetric
           (let* ((p (cadr (car (filter (lambda (h) (dk-head-is? h 'IN)) (dk-peel!))))))
             (tgt-int-parts! p A ai)
             (tgt-int-parts! p u1 u2i)
             (sep-me (list 'IN p ai))
             (tgt-in-open! p u1)
             (dk-cite! 'group-inv-in 'g p)
             (dk-cite! 'group-inv-inv 'g p)
             (tgt-pts! (tgt-inv p))
             (dk-have! (list 'IN (tgt-inv p) ai)
               (lambda () (in-sep! (lambda () (tgt-ass!)) (lambda () (subst (list '= (tgt-inv (tgt-inv p)) p)) (tgt-ass!)))))
             (tgt-int-intro! (tgt-inv p) A ai)
             (tgt-ass!)))
          (#t (tgt-ass!))))))))
(qed 'top-group-sym-pair-gt)
(topic! 'top-group-sym-pair-gt 'analysis)
(tgx-lift! 'top-group-sym-pair-gt 'top-group-sym-pair)

;;; ---- ... and a symmetric open V with V V V inside W ----
(define (tgt-triple V W)
  (list 'FORALL 'tp_ (list 'IMPLIES (list 'IN 'tp_ V) (list 'FORALL 'tq_ (list 'IMPLIES (list 'IN 'tq_ V)
    (list 'FORALL 'tr_ (list 'IMPLIES (list 'IN 'tr_ V) (list 'IN '((OPR g) ((OPR g) tp_ tq_) tr_) W))))))))
(define (tgt-sym-pair! W)                 ; returns (V pair-clause)
  (let* ((v (dk-skolem! (dk-cite! 'top-group-sym-pair-gt 's 'g W)))
         (cl (dk-pick (lambda (h) (alpha-equiv? h (tgt-pair v W))) "the pair clause")))
    (list v cl)))
(sp (make-wff (tgx-keep! 'top-group-sym-triple-gt (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (list 'FORALL 'W (list 'IMPLIES '(IN W (OPENS s)) (list 'IMPLIES '(IN (IDEN g) W)
     (list 'FORSOME 'V (list 'AND '(IN V (OPENS s)) (list 'AND '(IN (IDEN g) V)
       (list 'AND (tgt-sym 'V) (tgt-triple 'V 'W))))))))))))))
(dk-peel!)
(let* ((cont (tgt-parts!)) (e '(IDEN g))
       (s1c (tgt-sym-pair! 'W)) (s1 (car s1c)) (c1 (cadr s1c))
       (s2c (tgt-sym-pair! s1)) (s2 (car s2c)) (c2 (cadr s2c)))
  (ew s2)
  (dk-conj-close!
   (lambda ()
     (if (and (dk-head-is? (dk-goal) 'FORALL) (dk-contains? (dk-goal) 'tr_))
         (let* ((pl (dk-peel!))
                (ins (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) s2))) pl))
                (p (cadr (car ins))) (q (cadr (cadr ins))) (r (cadr (caddr ins))))
           (tgt-in-open! r s2)
           (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g r)))
           (dk-apply! (dk-apply! c2 r) e)
           (dk-rewrite-h! (list 'IN (tgt-op r e) s1) (tgt-op r e) r)
           (dk-apply! (dk-apply! c2 p) q)
           (dk-apply! (dk-apply! c1 (tgt-op p q)) r)
           (tgt-ass!))
         (tgt-ass!)))))
(qed 'top-group-sym-triple-gt)
(topic! 'top-group-sym-triple-gt 'analysis)
(tgx-lift! 'top-group-sym-triple-gt 'top-group-sym-triple)

;;; ==== THE NEIGHBOURHOOD SEQUENCE (was tg-seq.scm) ====
;;; tg-seq.scm -- the neighbourhood sequence of the proof of Proposition A.6: from a countable
;;; base bsq at e, open symmetric V_k with V_0 = G, e in V_k, V_{k+1}^3 inside V_k and
;;; V_{k+1} inside bsq(k), by dependent choice (dc-on-nn-pred; rake-dc-on-nn.scm is the
;;; model).  Agent ISOM, 2026-10-26.  Helper prefix: tgq-.  Library: analysis.

(define (tgq-head g) (and (pair? g) (car g)))
(define (tgq-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define tgq-e '(IDEN g))
(define tgq-X (list 'SEP 'xo_ '(OPENS s) (list 'AND '(IN (IDEN g) xo_) (tgt-sym 'xo_))))
(define (tgq-nxtbody k u)
  (list 'SEP 'no_ tgq-X (list 'AND (tgt-triple 'no_ u) (list 'SUBSET 'no_ (list 'bsq k)))))
(define tgq-nxt (list 'VNB-LAMBDA '(LIST nk_ nu_) (list 'CARTESIAN 'NN tgq-X) (tgq-nxtbody 'nk_ 'nu_)))
(define tgq-props
  (lambda (vs)
    (list 'AND (list 'IN vs '(FUN NN (OPENS s)))
      (list 'AND (list '= (list vs 0) '(PTS s))
        (list 'FORALL 'qk_ (list 'IMPLIES '(IN qk_ NN)
          (list 'AND (list 'IN tgq-e (list vs 'qk_))
            (list 'AND (tgt-sym (list vs 'qk_))
              (list 'AND (tgt-triple (list vs '(succ qk_)) (list vs 'qk_))
                         (list 'SUBSET (list vs '(succ qk_)) '(bsq qk_)))))))))))
(sp (make-wff (tgx-keep! 'top-group-nbhd-sequence-gt (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (list 'FORALL 'bsq (list 'IMPLIES '(IN bsq (FUN NN (OPENS s)))
     (list 'IMPLIES '(FORALL bk_ (IMPLIES (IN bk_ NN) (IN (IDEN g) (bsq bk_))))
       (list 'FORSOME 'vs (tgq-props 'vs)))))))))))
(dk-peel!)
(define tgq-cont (tgt-parts!))
(tgt-pts! tgq-e)
(define tgq-bse (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'bsq) (dk-contains? h '(IDEN g)))) "e in the base"))
;; the open-set laws
(let ((iff (dk-cite! 'is-top-space 's)))
  (dk-have! (caddr iff) (lambda () (if (dk-only! iff '(IS-TOP-SPACE s)) (prop))))
  (dk-split-all! (list (caddr iff))))
(dk-cite! 'membership-implies-sethood '(OPENS s) '(POWER (POWER (PTS s))))
(dk-have! (list 'IN tgq-X 'SET) (lambda () (sep-set) (tgq-ass!)))
;; a = PTS s is in X
(dk-have! (list 'IN '(PTS s) tgq-X)
  (lambda ()
    (in-sep! (lambda () (tgq-ass!))
             (lambda ()
               (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'FORALL)
                      (let ((p (cadr (car (dk-peel!)))))
                        (tgt-carr! p) (dk-cite! 'group-inv-in 'g p) (tgt-pts! (tgt-inv p)) (tgq-ass!))
                      (tgq-ass!))))))))
;; X is a class of open sets
(dk-have! (list 'SUBSET tgq-X '(OPENS s))
  (lambda () (mac 'subset-def)
             (let ((z (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
               (sep-me (list 'IN z tgq-X)) (tgq-ass!))))
;; parts of a member of X, landed without consuming the membership
(define (tgq-xparts! u)
  (if (not (dk-asm? (list 'IN u '(OPENS s))))
      (begin
        (dk-cite! 'subset-mem-fwd tgq-X '(OPENS s) u)
        (dk-have! (list 'AND (list 'IN tgq-e u) (tgt-sym u)) (lambda () (sep-me (list 'IN u tgq-X)) (tgq-ass!)))
        (dk-split-all! (list (list 'AND (list 'IN tgq-e u) (tgt-sym u)))))))
;; totality of the step
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u tgq-X)
            (list 'FORSOME 'y (list 'AND (list 'IN 'y tgq-X) (list 'IN 'y (list tgq-nxt 'k 'u))))))))
  (lambda ()
    (let* ((pl (dk-peel!))
           (k (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'NN))) pl))))
           (u (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) tgq-X))) pl))))
           (bk (list 'bsq k))
           (W (tgt-int u bk)))
      (tgq-xparts! u)
      (dk-cite! 'fun-apply-type-c 'bsq 'NN '(OPENS s) k)
      (dk-apply! tgq-bse k)
      (tgt-int-open! u bk)
      (tgt-int-intro! tgq-e u bk)
      (let* ((v (dk-skolem! (dk-cite! 'top-group-sym-triple-gt 's 'g W)))
             (tr (dk-pick (lambda (h) (alpha-equiv? h (tgt-triple v W))) "the triple clause")))
        (dk-have! (list 'IN v tgq-X) (lambda () (in-sep! (lambda () (tgq-ass!)) (lambda () (dk-conj-close! (lambda () (tgq-ass!)))))))
        (ew v)
        (dk-conj-close!
         (lambda ()
           (if (equal? (dk-goal) (list 'IN v tgq-X))
               (tgq-ass!)
               (begin
                 (dk-lam-b!)
                 (in-sep! (lambda () (tgq-ass!))
                   (lambda ()
                     (dk-conj-close!
                      (lambda ()
                        (if (dk-head-is? (dk-goal) 'SUBSET)
                            (begin
                              (mac 'subset-def)
                              (let ((wv (cadr (car (filter (lambda (h) (dk-head-is? h 'IN)) (dk-peel!))))))
                                (tgt-in-open! wv v)
                                (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g wv)))
                                (dk-apply! (dk-apply! (dk-apply! tr wv) tgq-e) tgq-e)
                                (let ((we (tgt-op wv tgq-e)) (wee (tgt-op (tgt-op wv tgq-e) tgq-e)))
                                  (dk-have! (list '= wee wv)
                                    (lambda () (subst (list '= we wv)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (if (dk-asm? (dk-goal)) (ass) (rfl)))))
                                  (dk-have! (list 'IN wv W) (lambda () (subst (list '= wv wee)) (tgq-ass!))))
                                (tgt-int-parts! wv u bk)
                                (tgq-ass!)))
                            (let* ((pl2 (dk-peel!))
                                   (ins (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) v))) pl2))
                                   (p (cadr (car ins))) (q (cadr (cadr ins))) (r (cadr (caddr ins))))
                              (dk-apply! (dk-apply! (dk-apply! tr p) q) r)
                              (tgt-int-parts! (tgt-op (tgt-op p q) r) u bk)
                              (tgq-ass!)))))))))))))))
(dk-cite! 'dc-on-nn-pred tgq-X '(PTS s) tgq-nxt)
(define tgq-f (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'succ))) "the chosen sequence")))
(dk-split-all!)
(define tgq-stepcl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h tgq-f) (dk-contains? h 'succ))) "the step clause"))
(ew tgq-f)
(dk-conj-close!
 (lambda ()
   (let ((g0 (dk-goal)))
     (cond
      ((and (dk-head-is? g0 'IN) (equal? (caddr g0) '(FUN NN (OPENS s))))
       (dk-cite! 'fun-codomain-superset tgq-f 'NN tgq-X '(OPENS s))
       (tgq-ass!))
      ((dk-head-is? g0 'FORALL)
       (let* ((k (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'NN))) (dk-peel!)))))
              (fk (list tgq-f k)) (fsk (list tgq-f (list 'succ k))))
         (dk-cite! 'nn-succ-closed k)
         (dk-cite! 'fun-apply-type-c tgq-f 'NN tgq-X k)
         (dk-cite! 'fun-apply-type-c tgq-f 'NN tgq-X (list 'succ k))
         (tgq-xparts! fk)
         (let* ((h (dk-apply! tgq-stepcl k))
                (h2 (dk-landed-1 (lambda () (dk-lam-b-h! h)))))
           (dk-have! (list 'AND (tgt-triple fsk fk) (list 'SUBSET fsk (list 'bsq k)))
             (lambda () (sep-me h2) (tgq-ass!)))
           (dk-split-all! (list (list 'AND (tgt-triple fsk fk) (list 'SUBSET fsk (list 'bsq k)))))
           (dk-conj-close! (lambda () (tgq-ass!))))))
      (#t (tgq-ass!))))))
(qed 'top-group-nbhd-sequence-gt)
(topic! 'top-group-nbhd-sequence-gt 'analysis)
(tgx-lift! 'top-group-nbhd-sequence-gt 'top-group-nbhd-sequence)

