;;; tg-bk.scm -- the Birkhoff-Kakutani gauge (147)-(148) and the facts about (1/2)^k it needs.
;;; Agent ISOM, 2026-10-26.  Helper prefix: tgk-.  Library: analysis.  Appended to tg-top.scm's
;;; environment (it uses the tgt- helpers): in integration, the two are one file.

(define (tgk-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (tgk-and! a b) (dk-have! (list 'AND a b) (lambda () (dk-conj-close! (lambda () (ass))))))
(define (tgk-h k) (list 'power 1/2 k))

;;; ---- (1/2)^k ----
(sp (make-wff '(FORALL k (IMPLIES (IN k NN)
   (AND (IN (power 1/2 k) RR) (AND (< 0 (power 1/2 k)) (= (power 1/2 (succ k)) (* 1/2 (power 1/2 k)))))))))
(dk-peel!)
(dk-have! '(IN 1/2 RR) (lambda () (arith)))
(dk-have! '(IN 1/2 CC) (lambda () (arith)))
(dk-have! '(< 0 1/2) (lambda () (arith)))
(fact 'power-real-closed 1/2 'k)
(fact 'rr-power-pos 1/2 'k)
(tgk-and! '(IN 1/2 CC) '(IN k NN))
(fact 'power-succ 1/2 'k)
(dk-conj-close! (lambda () (tgk-ass!)))
(qed 'half-power-facts)
(topic! 'half-power-facts 'plumbing)
(define (tgk-hf! k) (if (not (dk-asm? (list '< 0 (tgk-h k)))) (dk-split-all! (list (dk-cite! 'half-power-facts k)))))

(sp (make-wff '(FORALL j (IMPLIES (IN j NN) (FORALL k (IMPLIES (IN k NN) (IMPLIES (<= j k) (<= (power 1/2 k) (power 1/2 j)))))))))
(dk-peel!)
(define tgk-hlam '(VNB-LAMBDA hk_ NN (power 1/2 hk_)))
(fact 'nn-is-set)
(dk-have! (list 'IN tgk-hlam '(FUN NN RR))
  (lambda () (for-each (lambda (leaf) (dk-focus! leaf)
                         (if (and (dk-head-is? (dk-goal) 'IN) (eq? (caddr (dk-goal)) 'SET)) (tgk-ass!)
                             (let ((v (cadr (car (dk-peel!))))) (tgk-hf! v) (tgk-ass!))))
                       (dk-opened (lambda () (lam-t))))))
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '<= (list tgk-hlam '(succ k)) (list tgk-hlam 'k))))
  (lambda ()
    (let ((v (cadr (car (dk-peel!)))))
      (dk-cite! 'nn-succ-closed v)
      (dk-lam-b!)
      (tgk-hf! v) (tgk-hf! (list 'succ v))
      (dk-ineq! (list '= (tgk-h (list 'succ v)) (list '* 1/2 (tgk-h v))) (list '< 0 (tgk-h v)) (list 'IN (tgk-h v) 'RR)
                (list 'IN (tgk-h (list 'succ v)) 'RR)))))
(dk-apply! (dk-cite! 'nn-antitone-step-implies-le tgk-hlam) 'k 'j)
(tgk-hf! 'j) (tgk-hf! 'k)
(dk-lam-b-h! (dk-pick (lambda (h) (and (dk-head-is? h '<=) (dk-contains? h 'hk_))) "the lambda inequality"))
(tgk-ass!)
(qed 'half-power-anti)
(topic! 'half-power-anti 'plumbing)

(sp (make-wff '(FORALL a (IMPLIES (IN a RR) (IMPLIES (FORALL k (IMPLIES (IN k NN) (<= a (power 1/2 k)))) (<= a 0))))))
(dk-peel!)
(use-em '(<= a 0)
  (lambda () (tgk-ass!))
  (lambda ()
    (fact 'rr-zero-in)
    (dk-cite! 'rr-not-le-lt 'a 0)
    (fact 'rr-pos-rr-of-lt 'a)
    (dk-have! '(IN 1/2 RR) (lambda () (arith)))
    (dk-have! '(AND (<= 0 1/2) (< 1/2 1)) (lambda () (dk-conj-close! (lambda () (arith)))))
    (dk-cite! 'rr-mul-in-rr 1/2 'a)
    (dk-have! '(< 0 (* 1/2 a)) (lambda () (dk-ineq! '(< 0 a) '(IN a RR))))
    (fact 'rr-pos-rr-of-lt '(* 1/2 a))
    (let* ((c (dk-skolem! (dk-apply! (dk-cite! 'power-small-threshold 1/2) '(* 1/2 a))))
           (cl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h c))) "the threshold")))
      (dk-cite! 'nn-le-refl c)
      (dk-apply! cl c)
      (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(<= a (power 1/2 k))))) "the bound") c)
      (tgk-hf! c)
      (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '<= 'a (tgk-h c)) (list '<= (tgk-h c) '(* 1/2 a)) '(< 0 a) '(IN a RR) (list 'IN (tgk-h c) 'RR))))
      (ai (dk-cite! 'rr-lt-irrefl 0)))))
(qed 'half-power-small)
(topic! 'half-power-small 'plumbing)

;;; =====================================================================
;;; The gauge (147)
;;; =====================================================================
(define tgk-bkq
  '(FORALL bsk_ (IMPLIES (IN bsk_ NN)
     (AND (IN (IDEN g) (vs bsk_))
       (AND (FORALL bsp_ (IMPLIES (IN bsp_ (vs bsk_)) (IN ((INV g) bsp_) (vs bsk_))))
         (FORALL bsp_ (IMPLIES (IN bsp_ (vs (succ bsk_))) (FORALL bsq_ (IMPLIES (IN bsq_ (vs (succ bsk_)))
           (FORALL bsr_ (IMPLIES (IN bsr_ (vs (succ bsk_)))
             (IN ((OPR g) ((OPR g) bsp_ bsq_) bsr_) (vs bsk_)))))))))))))
(sp (make-wff (list 'FORALL 's (list 'FORALL 'g (list 'FORALL 'vs (list 'IMPLIES '(IS-BK-SEQUENCE s g vs)
   (list 'AND '(IN vs (FUN NN (OPENS s))) (list 'AND '(= (vs 0) (PTS s)) tgk-bkq))))))))
(dk-peel!)
(mac-h 'IS-BK-SEQUENCE '(IS-BK-SEQUENCE s g vs))
(tgk-ass!)
(qed 'bk-sequence-parts)
(topic! 'bk-sequence-parts 'plumbing)

(define (tgk-GS x) (list 'SEP 'bgr_ 'RR (list 'FORSOME 'bgk_ (list 'AND '(IN bgk_ NN) (list 'AND (list 'IN x '(vs bgk_)) '(= bgr_ (power 1/2 bgk_)))))))
(define (tgk-g x) (list 'BK-GAUGE 'vs x))
(sp (make-wff (list 'FORALL 'vs (list 'FORALL 'x (list '== (tgk-g 'x) (list 'EINF (tgk-GS 'x)))))))
(dk-peel!)
(mac 'BK-GAUGE)
(qrfl)
(qed 'bk-gauge-unfold)
(topic! 'bk-gauge-unfold 'plumbing)

;; set-up for the gauge lemmas: hypotheses IS-TOP-GROUP(s, g), IS-BK-SEQUENCE(s, g, vs)
(define (tgk-hyps body)
  (list 'FORALL 's (list 'FORALL 'g (list 'FORALL 'vs (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g) (list 'IMPLIES '(IS-BK-SEQUENCE s g vs) body))))))
(define (tgk-setup!)
  (let ((cont (tgt-parts!)))
    (dk-split-all! (list (dk-cite! 'bk-sequence-parts 's 'g 'vs)))
    (tgt-pts! '(IDEN g))
    cont))
(define (tgk-q! k)                       ; the k-th clause of the sequence, split
  (if (not (dk-asm? (list 'IN '(IDEN g) (list 'vs k))))
      (dk-split-all! (list (dk-apply! (dk-ctx-form tgk-bkq) k)))))
(define (tgk-vs-open! k) (dk-cite! 'fun-apply-type-c 'vs 'NN '(OPENS s) k))

;;; ---- the sequence decreases ----
(sp (make-wff (tgk-hyps '(FORALL k (IMPLIES (IN k NN) (SUBSET (vs (succ k)) (vs k)))))))
(dk-peel!)
(tgk-setup!)
(let ((k (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'NN))) (dk-asms))))))
  (dk-cite! 'nn-succ-closed k)
  (tgk-q! k) (tgk-q! (list 'succ k))
  (tgk-vs-open! (list 'succ k))
  (mac 'subset-def)
  (let* ((v (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!)))))
         (e '(IDEN g)) (ve (tgt-op v e)) (vee (tgt-op (tgt-op v e) e)))
    (tgt-in-open! v (list 'vs (list 'succ k)))
    (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g v)))
    (dk-apply! (dk-apply! (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'bsr_) (dk-contains? h (list 'vs k)) (not (dk-contains? h 'bsk_)))) "the triple clause") v) e) e)
    (dk-have! (list '= vee v) (lambda () (subst (list '= ve v)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (if (dk-asm? (dk-goal)) (ass) (rfl)))))
    (dk-have! (list 'IN v (list 'vs k)) (lambda () (subst (list '= v vee)) (tgk-ass!)))
    (tgk-ass!)))
(qed 'bk-sequence-decreasing)
(topic! 'bk-sequence-decreasing 'plumbing)

(sp (make-wff (tgk-hyps '(FORALL k (IMPLIES (IN k NN) (FORALL j (IMPLIES (IN j NN) (IMPLIES (<= k j) (SUBSET (vs j) (vs k))))))))))
(dk-peel!)
(tgk-setup!)
(dk-have! '(FORALL k (IMPLIES (IN k NN) (IN (vs k) SET)))
  (lambda () (let ((v (cadr (car (dk-peel!))))) (tgk-vs-open! v) (dk-cite! 'membership-implies-sethood (list 'vs v) '(OPENS s)) (tgk-ass!))))
(dk-have! '(FORALL k (IMPLIES (IN k NN) (SUBSET (vs (succ k)) (vs k))))
  (lambda () (let ((v (cadr (car (dk-peel!))))) (dk-apply! (dk-cite! 'bk-sequence-decreasing 's 'g 'vs) v) (tgk-ass!))))
(let* ((pl (filter (lambda (q) (and (dk-head-is? q 'IN) (eq? (caddr q) 'NN))) (dk-asms))))
  (dk-apply! (dk-cite! 'nn-nested-subset-chain 'vs) 'k 'j)
  (tgk-ass!))
(qed 'bk-sequence-nested)
(topic! 'bk-sequence-nested 'plumbing)

;;; ---- the gauge set is a set of positive reals; the gauge is real, >= 0, <= (1/2)^k on vs(k) ----
(sp (make-wff (list 'FORALL 'vs (list 'FORALL 'x (list 'SUBSET (tgk-GS 'x) 'RR-POS-STAR)))))
(dk-peel!)
(mac 'subset-def)
(let* ((r (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
  (sep-me (list 'IN r (tgk-GS 'x)))
  (let ((k (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h r))) "the index"))))
    (dk-split-all!)
    (tgk-hf! k)
    (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '= r (tgk-h k)) (list '< 0 (tgk-h k)) (list 'IN (tgk-h k) 'RR) (list 'IN r 'RR))))
    (dk-have! (list 'IN r 'RR-POS-STAR) (lambda () (mac 'rr-pos-star-membership) (oi-l) (dk-conj-close! (lambda () (tgk-ass!)))))
    (tgk-ass!)))
(qed 'bk-gauge-set-nonneg)
(topic! 'bk-gauge-set-nonneg 'plumbing)

(sp (make-wff (list 'FORALL 'vs (list 'FORALL 'x (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES '(IN x (vs k))
   (list 'AND (list 'IN (tgk-g 'x) 'RR) (list 'AND (list '<= 0 (tgk-g 'x)) (list '<= (tgk-g 'x) '(power 1/2 k)))))))))))
(dk-peel!)
(let* ((GS (tgk-GS 'x)) (E (list 'EINF GS)) (hk (tgk-h 'k)))
  (tgk-hf! 'k)
  (dk-cite! 'bk-gauge-set-nonneg 'vs 'x)
  (dk-cite! 'bk-gauge-unfold 'vs 'x)
  (dk-have! (list 'IN hk GS)
    (lambda () (in-sep! (lambda () (tgk-ass!)) (lambda () (ew 'k) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))))
  (dk-cite! 'einf-lower GS hk)
  (dk-cite! 'einf-in GS)
  (tgk-and! (list 'IN E 'RR-POS-STAR) (list 'IN hk 'RR))
  (fact 'rr-pos-star-le-real-in-rr E hk)
  (fact 'rr-zero-in)
  (dk-have! '(<= 0 0) (lambda () (arith)))
  (dk-have! '(IN 0 RR-POS-STAR) (lambda () (mac 'rr-pos-star-membership) (oi-l) (dk-conj-close! (lambda () (tgk-ass!)))))
  (dk-have! (list 'FORALL 'cpsx_ (list 'IMPLIES (list 'IN 'cpsx_ GS) '(<= 0 cpsx_)))
    (lambda ()
      (let ((r (cadr (car (dk-peel!)))))
        (dk-cite! 'subset-mem-fwd GS 'RR-POS-STAR r)
        (sep-me (list 'IN r GS))
        (let ((j (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h r))) "the index"))))
          (dk-split-all!)
          (tgk-hf! j)
          (dk-ineq! (list '= r (tgk-h j)) (list '< 0 (tgk-h j)) (list 'IN (tgk-h j) 'RR) (list 'IN r 'RR))))))
  (dk-cite! 'einf-greatest GS 0)
  (subst (list '== (tgk-g 'x) E))
  (dk-conj-close! (lambda () (tgk-ass!))))
(qed 'bk-gauge-le)
(topic! 'bk-gauge-le 'analysis)
(define (tgk-gle! x k) (if (not (dk-asm? (list '<= (tgk-g x) (tgk-h k)))) (dk-split-all! (list (dk-cite! 'bk-gauge-le 'vs x k)))))

;;; ---- the last neighbourhood containing x ----
(define tgk-miss '(SEP mj_ NN (NOT (IN x (vs mj_)))))
(sp (make-wff (tgk-hyps '(FORALL x (IMPLIES (IN x (PTS s)) (FORALL k (IMPLIES (IN k NN) (IMPLIES (NOT (IN x (vs k)))
   (FORSOME kq (AND (IN kq NN) (AND (IN x (vs kq)) (AND (NOT (IN x (vs (succ kq)))) (<= (succ kq) k)))))))))))))
(dk-peel!)
(tgk-setup!)
(dk-have! (list 'SUBSET tgk-miss 'NN)
  (lambda () (mac 'subset-def)
             (let ((v (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
               (sep-me (list 'IN v tgk-miss)) (tgk-ass!))))
(dk-have! (list 'IN 'k tgk-miss) (lambda () (in-sep! (lambda () (tgk-ass!)))))
(dk-have! (list 'FORSOME 'tn_ (list 'IN 'tn_ tgk-miss)) (lambda () (ew 'k) (tgk-ass!)))
(tgk-and! (list 'SUBSET tgk-miss 'NN) (list 'FORSOME 'tn_ (list 'IN 'tn_ tgk-miss)))
(let* ((j0 (dk-skolem! (dk-cite! 'nn-least-element tgk-miss)))
       (mc (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h j0))) "minimality")))
  (dk-have! (list 'IN j0 'NN) (lambda () (sep-me (list 'IN j0 tgk-miss)) (tgk-ass!)))
  (dk-have! (list 'NOT (list 'IN 'x (list 'vs j0))) (lambda () (sep-me (list 'IN j0 tgk-miss)) (tgk-ass!)))
  (dk-have! (list 'NOT (list '= j0 0))
    (lambda () (di)
               (dk-have! (list 'IN 'x (list 'vs j0)) (lambda () (subst (list '= j0 0)) (subst '(= (vs 0) (PTS s))) (tgk-ass!)))
               (ai (list 'NOT (list 'IN 'x (list 'vs j0))))))
  (let* ((kq (dk-skolem! (dk-cite! 'nn-nonzero-is-succ j0))) (sK (list 'succ kq)))
    (dk-cite! 'nn-succ-closed kq)
    (dk-apply! mc 'k)
    (dk-have! (list 'IN 'x (list 'vs kq))
      (lambda ()
        (use-em (list 'IN 'x (list 'vs kq))
          (lambda () (tgk-ass!))
          (lambda ()
            (dk-have! (list 'IN kq tgk-miss) (lambda () (in-sep! (lambda () (tgk-ass!)))))
            (dk-apply! mc kq)
            (dk-have! '(< 0 0) (lambda () (dk-nn! (list '<= j0 kq) (list '= j0 sK))))
            (ai (dk-cite! 'rr-lt-irrefl 0))))))
    (ew kq)
    (dk-conj-close!
     (lambda ()
       (let ((g0 (dk-goal)))
         (cond ((dk-head-is? g0 'NOT) (subst (list '= sK j0)) (tgk-ass!))
               ((dk-head-is? g0 '<=) (dk-nn! (list '<= j0 'k) (list '= j0 sK)))
               (#t (tgk-ass!))))))))
(qed 'bk-last-nbhd)
(topic! 'bk-last-nbhd 'plumbing)

;;; ---- on vs(kq) \ vs(kq+1) the gauge is (1/2)^kq ----
(sp (make-wff (tgk-hyps '(FORALL x (IMPLIES (IN x (PTS s)) (FORALL kq (IMPLIES (IN kq NN) (IMPLIES (IN x (vs kq))
   (IMPLIES (NOT (IN x (vs (succ kq)))) (= (BK-GAUGE vs x) (power 1/2 kq)))))))))))
(dk-peel!)
(tgk-setup!)
(let* ((GS (tgk-GS 'x)) (E (list 'EINF GS)) (hK (tgk-h 'kq)) (sK '(succ kq)))
  (dk-cite! 'nn-succ-closed 'kq)
  (tgk-gle! 'x 'kq)
  (tgk-hf! 'kq)
  (dk-cite! 'bk-gauge-set-nonneg 'vs 'x)
  (dk-cite! 'bk-gauge-unfold 'vs 'x)
  (dk-have! (list 'IN hK 'RR-POS-STAR) (lambda () (mac 'rr-pos-star-membership) (oi-l)
                                         (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 0 hK) (list 'IN hK 'RR)))))))
  (dk-have! (list 'FORALL 'cpsx_ (list 'IMPLIES (list 'IN 'cpsx_ GS) (list '<= hK 'cpsx_)))
    (lambda ()
      (let ((r (cadr (car (dk-peel!)))))
        (sep-me (list 'IN r GS))
        (let ((j (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h r))) "the index"))))
          (dk-split-all!)
          (tgk-hf! j)
          (use-em (list '<= j 'kq)
            (lambda ()
              (dk-cite! 'half-power-anti j 'kq)
              (dk-ineq! (list '= r (tgk-h j)) (list '<= hK (tgk-h j)) (list 'IN (tgk-h j) 'RR) (list 'IN r 'RR) (list 'IN hK 'RR)))
            (lambda ()
              (dk-cite! 'nn-not-le-succ-le j 'kq)
              (dk-apply! (dk-cite! 'bk-sequence-nested 's 'g 'vs) sK j)
              (dk-cite! 'subset-mem-fwd (list 'vs j) (list 'vs sK) 'x)
              (ai (list 'NOT (list 'IN 'x (list 'vs sK))))))))))
  (dk-cite! 'einf-greatest GS hK)
  (dk-have! (list '<= hK (tgk-g 'x)) (lambda () (subst (list '== (tgk-g 'x) E)) (tgk-ass!)))
  (dk-ineq! (list '<= hK (tgk-g 'x)) (list '<= (tgk-g 'x) hK) (list 'IN hK 'RR) (list 'IN (tgk-g 'x) 'RR)))
(qed 'bk-gauge-exact)
(topic! 'bk-gauge-exact 'analysis)

;;; ---- (148): g(x) <= (1/2)^k  iff  x in vs(k) ----
(define (tgk-gx! x) (tgk-gle! x 0))
(sp (make-wff (tgk-hyps '(FORALL x (IMPLIES (IN x (PTS s)) (FORALL k (IMPLIES (IN k NN)
   (IMPLIES (<= (BK-GAUGE vs x) (power 1/2 k)) (IN x (vs k))))))))))
(dk-peel!)
(tgk-setup!)
(dk-have! '(IN x (vs 0)) (lambda () (subst '(= (vs 0) (PTS s))) (tgk-ass!)))
(fact 'nn-zero-in)
(tgk-gx! 'x)
(use-em '(IN x (vs k))
  (lambda () (tgk-ass!))
  (lambda ()
    (let* ((kq (dk-skolem! (dk-cite! 'bk-last-nbhd 's 'g 'vs 'x 'k))) (skq (list 'succ kq)))
      (dk-split-all!)
      (dk-cite! 'nn-succ-closed kq)
      (dk-cite! 'bk-gauge-exact 's 'g 'vs 'x kq)
      (tgk-hf! kq) (tgk-hf! 'k) (tgk-hf! skq)
      (dk-cite! 'half-power-anti skq 'k)
      (dk-have! '(< 0 0)
        (lambda () (dk-ineq! (list '<= (tgk-g 'x) (tgk-h 'k)) (list '<= (tgk-h 'k) (tgk-h skq)) (list '= (tgk-h skq) (list '* 1/2 (tgk-h kq)))
                             (list '= (tgk-g 'x) (tgk-h kq)) (list '< 0 (tgk-h kq))
                             (list 'IN (tgk-h kq) 'RR) (list 'IN (tgk-h 'k) 'RR) (list 'IN (tgk-h skq) 'RR) (list 'IN (tgk-g 'x) 'RR))))
      (ai (dk-cite! 'rr-lt-irrefl 0)))))
