  (topic! name 'plumbing))
(tgk-readoff! 'bk-metric-pts 'PTS tgk-C)
(tgk-readoff! 'bk-metric-dist-fun 'DIST tgk-lam)

(sp (make-wff (tgk-hyps (list 'FORALL 'x (list 'IMPLIES '(IN x (CARR g)) (list 'FORALL 'y (list 'IMPLIES '(IN y (CARR g))
   (list '= (list (list 'DIST tgk-BKM) 'x 'y) (tgk-D 'x 'y)))))))))
(dk-peel!)
(tgk-setup!)
(dk-cite! 'bk-metric-lam-type 's 'g 'vs)
(dk-cite! 'bk-metric-dist-fun 's 'g 'vs)
(tgk-d! 'x 'y)
(subst (list '== (list 'DIST tgk-BKM) tgk-lam))
(dk-lam-b!)
