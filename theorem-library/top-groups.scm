(topic! 'bk-f-iden 'plumbing)

;;; ---- BK-METRIC(g, vs) is a metric space ----
;; F(u^-1 v) <= F(u^-1 w) + F(w^-1 v)  (subadditivity through w)
(define (tgk-via! u w v)
  (let ((a (tgk-ivx u w)) (b (tgk-ivx w v)))
    (tgk-ivf! u w) (tgk-ivf! w v) (tgk-ivf! u v)
    (dk-cite! 'bk-f-subadditive 's 'g 'vs a b)
    (dk-cite! 'group-cancel-mid 'g u w v)
    (dk-have! (list '<= (tgk-F (tgk-ivx u v)) (list '+ (tgk-F a) (tgk-F b)))
      (lambda () (subst (list '= (tgk-ivx u v) (tgt-op a b))) (tgk-ass!)))))
(define (tgk-law!)
  (if (dk--redex? (dk-goal)) (dk-lam-b!))
  (let ((g0 (dk-goal)))
    (cond
     ;; D(u, u) = 0
     ((and (dk-head-is? g0 '=) (equal? (caddr g0) 0))
      (let* ((z (cadddr (cadr (cadr g0)))) (u (caddr z)))
        (dk-cite! 'group-left-inv 'g u)
        (dk-cite! 'bk-f-iden 's 'g 'vs)
        (subst (list '= (tgk-ivx u u) '(IDEN g)))
        (subst (list '= (tgk-F '(IDEN g)) 0))
        (arith)))
     ;; 0 <= D(u, v)
     ((and (dk-head-is? g0 '<=) (equal? (cadr g0) 0))
      (let* ((z (cadddr (cadr (caddr g0)))) (v (cadr (cadr z))) (u (caddr z)))
        (tgk-d! u v) (tgk-ass!)))
     ;; D(u, v) = 0  ==>  u = v
     ((and (dk-head-is? g0 '=) (symbol? (cadr g0)) (symbol? (caddr g0)))
      (let* ((u (cadr g0)) (v (caddr g0)))
        (let ((h (car (filter (lambda (q) (and (dk-head-is? q '=) (equal? (caddr q) 0) (dk--redex? q))) (dk-asms)))))
          (dk-lam-b-h! h))
        (tgk-d! u v)
        (let* ((z (tgk-ivx v u)))
          (dk-have! (list '<= (tgk-F z) 0)
            (lambda () (dk-ineq! (list '= (tgk-D u v) 0) (list '<= 0 (tgk-F (tgk-ivx u v)))
                                 (list 'IN (tgk-F z) 'RR) (list 'IN (tgk-F (tgk-ivx u v)) 'RR))))
          (dk-have! (list 'FORALL 'hk_ (list 'IMPLIES '(IN hk_ NN) (list 'IN z '(vs hk_))))
            (lambda ()
              (let ((k (cadr (car (dk-peel!)))))
                (tgk-hf! k)
                (dk-have! (list '<= (tgk-g z) (tgk-h k))
                  (lambda () (dk-ineq! (list '<= (list '* 1/2 (tgk-g z)) (tgk-F z)) (list '<= (tgk-F z) 0) (list '< 0 (tgk-h k))
                                       (list 'IN (tgk-g z) 'RR) (list 'IN (tgk-F z) 'RR) (list 'IN (tgk-h k) 'RR))))
                (dk-cite! 'bk-gauge-char 's 'g 'vs z k)
                (tgk-ass!))))
          (dk-apply! (dk-ctx-form tgk-hsep) z)
          (dk-cite! 'group-eq-of-inv-eq-iden 'g u v)
          (tgk-ass!))))
     ;; D(u, v) = D(v, u)
     ((dk-head-is? g0 '=)
      (let* ((z (cadddr (cadr (cadr g0)))) (v (cadr (cadr z))) (u (caddr z)))
        (tgk-d! u v) (tgk-d! v u)
        (dk-ineq! (list 'IN (tgk-F (tgk-ivx v u)) 'RR) (list 'IN (tgk-F (tgk-ivx u v)) 'RR))))
     ;; D(u, w) <= D(u, v) + D(v, w)
     ((dk-head-is? g0 '<=)
      (let* ((zl (cadddr (cadr (cadr g0)))) (w (cadr (cadr zl))) (u (caddr zl))
             (zr (cadddr (cadr (cadr (caddr g0))))) (v (cadr (cadr zr))))
        (tgk-d! u w) (tgk-d! u v) (tgk-d! v w)
        (tgk-via! w v u)
        (tgk-via! u v w)
        (dk-ineq! (list '<= (tgk-F (tgk-ivx w u)) (list '+ (tgk-F (tgk-ivx w v)) (tgk-F (tgk-ivx v u))))
                  (list '<= (tgk-F (tgk-ivx u w)) (list '+ (tgk-F (tgk-ivx u v)) (tgk-F (tgk-ivx v w))))
                  (list 'IN (tgk-F (tgk-ivx w u)) 'RR) (list 'IN (tgk-F (tgk-ivx u w)) 'RR)
                  (list 'IN (tgk-F (tgk-ivx w v)) 'RR) (list 'IN (tgk-F (tgk-ivx v u)) 'RR)
                  (list 'IN (tgk-F (tgk-ivx u v)) 'RR) (list 'IN (tgk-F (tgk-ivx v w)) 'RR))))
     (#t (error "tgk-law!: unexpected leaf" g0)))))

(sp (make-wff (tgk-hyps2 (list 'IS-METRIC-SPACE tgk-BKM))))
(dk-peel!)
(tgk-setup!)
(dk-cite! 'group-carr-set 'g)
(dk-cite! 'bk-metric-lam-type 's 'g 'vs)
(dk-cite! 'bk-metric-pts 's 'g 'vs)
(dk-cite! 'bk-metric-dist-fun 's 'g 'vs)
(mac 'IS-METRIC-SPACE)
(subst (list '== (list 'PTS tgk-BKM) tgk-C))
(subst (list '== (list 'DIST tgk-BKM) tgk-lam))
(dk-conj-close!
 (lambda ()
   (let ((g0 (dk-goal)))
     (cond
      ((and (dk-head-is? g0 '=) (dk-head-is? (cadr g0) 'LENGTH))
       (mac 'BK-METRIC) (len-r) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (vnb-guard (lambda () (arith)))))
      ((dk-head-is? g0 'IS-METRIC)
       (mac 'is-metric)
       (let loop ((fuel 80))
         (let ((n (find-first (lambda (n) (let ((gg (dk-goal-of n))) (and (pair? gg) (memq (car gg) '(FORALL IMPLIES AND)))))
                              (dk-open-leaves))))
           (if (and n (> fuel 0)) (begin (dk-focus! n) (di) (loop (- fuel 1))))))
       (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (tgk-law!)))) (dk-open-leaves)))
      (#t (tgk-ass!))))))
(qed 'bk-metric-is-metric-space)
(topic! 'bk-metric-is-metric-space 'analysis)

;;; ---- left invariance ----
(sp (make-wff (tgk-hyps (list 'IS-LEFT-INVARIANT tgk-BKM 'g))))
(dk-peel!)
(tgk-setup!)
(mac 'IS-LEFT-INVARIANT)
(let* ((pl (dk-peel!)) (g0 (dk-goal))
       (lhs (cadr g0)) (ax (cadr lhs)) (ay (caddr lhs)) (a (cadr ax)) (x (caddr ax)) (y (caddr ay)))
  (dk-cite! 'group-carrier-closed-opr 'g a x)
  (dk-cite! 'group-carrier-closed-opr 'g a y)
  (dk-cite! 'bk-metric-dist 's 'g 'vs ax ay)
  (dk-cite! 'bk-metric-dist 's 'g 'vs x y)
  (dk-cite! 'group-inv-translate 'g a x y)
  (dk-cite! 'group-inv-translate 'g a y x)
  (tgk-d! x y)
  (subst (list '= (list (list 'DIST tgk-BKM) ax ay) (tgk-D ax ay)))
  (subst (list '= (list (list 'DIST tgk-BKM) x y) (tgk-D x y)))
  (subst (list '= (tgk-ivx ay ax) (tgk-ivx y x)))
  (subst (list '= (tgk-ivx ax ay) (tgk-ivx x y)))
  (rfl))
(qed 'bk-metric-left-invariant)
(topic! 'bk-metric-left-invariant 'analysis)

;;; ---- balls against the neighbourhoods ----
(define (tgk-dd a z) (list (list 'DIST tgk-BKM) a z))
(define (tgk-dd-real! a z)
  (tgk-d! a z)
  (if (not (dk-asm? (list '= (tgk-dd a z) (tgk-D a z)))) (dk-cite! 'bk-metric-dist 's 'g 'vs a z))
  (dk-have! (list 'IN (tgk-dd a z) 'RR) (lambda () (subst (list '= (tgk-dd a z) (tgk-D a z))) (tgk-ass!))))
;; a^-1 z in vs(k+2)  ==>  d(a, z) <= (1/2)^(k+1)
(sp (make-wff (tgk-hyps '(FORALL k (IMPLIES (IN k NN) (FORALL a (IMPLIES (IN a (CARR g)) (FORALL z (IMPLIES (IN z (CARR g))
   (IMPLIES (IN ((OPR g) ((INV g) a) z) (vs (succ (succ k))))
     (<= ((DIST (BK-METRIC g vs)) a z) (power 1/2 (succ k)))))))))))))
(dk-peel!)
(tgk-setup!)
(let* ((k 'k) (sk '(succ k)) (ssk '(succ (succ k))) (w (tgk-ivx 'a 'z)) (iw (tgt-inv w)))
  (dk-cite! 'nn-succ-closed k) (dk-cite! 'nn-succ-closed sk)
  (tgk-q! ssk)
  (tgk-ivf! 'a 'z) (tgk-ivf! 'z 'a)
  (dk-cite! 'group-inv-in 'g 'a)
  (dk-cite! 'group-inv-opr 'g (tgt-inv 'a) 'z)
  (dk-cite! 'group-inv-inv 'g 'a)
  (dk-have! (list '= iw (tgk-ivx 'z 'a)) (lambda () (subst (list '= iw (tgt-op (tgt-inv 'z) (tgt-inv (tgt-inv 'a))))) (subst (list '= (tgt-inv (tgt-inv 'a)) 'a)) (rfl)))
  (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(INV g)) (dk-contains? h (list 'vs ssk)) (not (dk-contains? h 'bsr_)) (not (dk-contains? h 'bsk_)))) "symmetry") w)
  (dk-have! (list 'IN (tgk-ivx 'z 'a) (list 'vs ssk)) (lambda () (subst (list '= (tgk-ivx 'z 'a) iw)) (tgk-ass!)))
  (for-each (lambda (t) (tgk-pt! t) (tgk-gle! t ssk)) (list w (tgk-ivx 'z 'a)))
  (tgk-hf! sk) (tgk-hf! ssk)
  (dk-cite! 'bk-metric-dist 's 'g 'vs 'a 'z)
  (tgk-d! 'a 'z)
  (tgk-dd-real! 'a 'z)
  (dk-ineq! (list '= (tgk-dd 'a 'z) (tgk-D 'a 'z))
            (list '<= (tgk-F w) (tgk-g w)) (list '<= (tgk-g w) (tgk-h ssk))
            (list '<= (tgk-F (tgk-ivx 'z 'a)) (tgk-g (tgk-ivx 'z 'a))) (list '<= (tgk-g (tgk-ivx 'z 'a)) (tgk-h ssk))
            (list '= (tgk-h ssk) (list '* 1/2 (tgk-h sk)))
            (list 'IN (tgk-F w) 'RR) (list 'IN (tgk-g w) 'RR) (list 'IN (tgk-F (tgk-ivx 'z 'a)) 'RR) (list 'IN (tgk-g (tgk-ivx 'z 'a)) 'RR)
            (list 'IN (tgk-h ssk) 'RR) (list 'IN (tgk-h sk) 'RR) (list 'IN (tgk-dd 'a 'z) 'RR)))
(qed 'bk-ball-of-nbhd)
(topic! 'bk-ball-of-nbhd 'analysis)

;; d(a, z) < (1/2)^(k+1)  ==>  a^-1 z in vs(k)
(sp (make-wff (tgk-hyps '(FORALL k (IMPLIES (IN k NN) (FORALL a (IMPLIES (IN a (CARR g)) (FORALL z (IMPLIES (IN z (CARR g))
   (IMPLIES (< ((DIST (BK-METRIC g vs)) a z) (power 1/2 (succ k)))
     (IN ((OPR g) ((INV g) a) z) (vs k))))))))))))
(dk-peel!)
(tgk-setup!)
(let* ((sk '(succ k)) (w (tgk-ivx 'a 'z)))
  (dk-cite! 'nn-succ-closed 'k)
  (tgk-ivf! 'a 'z) (tgk-ivf! 'z 'a)
  (tgk-dd-real! 'a 'z)
  (tgk-hf! 'k) (tgk-hf! sk)
  (tgk-pt! w)
  (dk-have! (list '<= (tgk-g w) (tgk-h 'k))
    (lambda () (dk-ineq! (list '< (tgk-dd 'a 'z) (tgk-h sk)) (list '= (tgk-dd 'a 'z) (tgk-D 'a 'z))
                         (list '<= 0 (tgk-F (tgk-ivx 'z 'a))) (list '<= (list '* 1/2 (tgk-g w)) (tgk-F w))
                         (list '= (tgk-h sk) (list '* 1/2 (tgk-h 'k)))
                         (list 'IN (tgk-F w) 'RR) (list 'IN (tgk-F (tgk-ivx 'z 'a)) 'RR) (list 'IN (tgk-g w) 'RR)
                         (list 'IN (tgk-dd 'a 'z) 'RR) (list 'IN (tgk-h 'k) 'RR) (list 'IN (tgk-h sk) 'RR))))
  (dk-cite! 'bk-gauge-char 's 'g 'vs w 'k)
  (tgk-ass!))
(qed 'bk-nbhd-of-ball)
(topic! 'bk-nbhd-of-ball 'analysis)

;;; =====================================================================
;;; The metric topology is the topology of s
;;; =====================================================================
(define tgk-hfund '(FORALL fw_ (IMPLIES (IN fw_ (OPENS s)) (IMPLIES (IN (IDEN g) fw_) (FORSOME fk_ (AND (IN fk_ NN) (SUBSET (vs fk_) fw_)))))))
(define (tgk-ball a r) (list 'BALL tgk-BKM a r))
;; z in BALL(a, r)  <->  z in CARR, d(a, z) <= r, d(a, z) /= r ; land the parts / build it
(define (tgk-ball-parts! z a r)
  (let ((iff (dk-cite! 'ball-membership tgk-BKM a r z)))
    (dk-have! (caddr iff) (lambda () (if (dk-only! iff (list 'IN z (tgk-ball a r))) (prop))))
    (dk-split-all! (list (caddr iff)))))
(sp (make-wff (tgk-hyps2 (list 'IMPLIES tgk-hfund '(FORALL U (IFF (IN U (OPENS s)) (IS-OPEN (BK-METRIC g vs) U)))))))
(dk-peel!)
(define tgk-cont (tgk-setup!))
(dk-cite! 'bk-metric-is-metric-space 's 'g 'vs)
(dk-cite! 'bk-metric-pts 's 'g 'vs)
(define tgk-U (cadr (cadr (dk-goal))))
(define tgk-iso (dk-cite! 'is-open tgk-BKM tgk-U))
(define tgk-subU (list 'SUBSET tgk-U tgk-C))
(dk-have! (list 'IMPLIES (list 'IN tgk-U '(OPENS s)) (list 'IS-OPEN tgk-BKM tgk-U))
  (lambda ()
    (di)
    (dk-cite! 'top-open-subset 's tgk-U)
    (dk-have! (list 'SUBSET tgk-U (list 'PTS tgk-BKM))
      (lambda () (subst (list '== (list 'PTS tgk-BKM) tgk-C)) (subst (list '= tgk-C '(PTS s))) (tgk-ass!)))
    (dk-have! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y tgk-U)
                (list 'FORSOME 'r (list 'AND '(POS-RR r) (list 'SUBSET (tgk-ball 'y 'r) tgk-U)))))
      (lambda ()
        (let* ((y (cadr (car (dk-peel!))))
               (iy (tgt-inv y)) (W (tgt-aW iy tgk-U)))
          (tgt-in-open! y tgk-U)
          (dk-cite! 'group-inv-in 'g y)
          (dk-cite! 'group-inv-inv 'g y)
          (dk-cite! 'top-group-translate-open-gt 's 'g iy tgk-U)
          (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g y)))
          (dk-have! (list 'IN '(IDEN g) W)
            (lambda () (in-sep! (lambda () (tgk-ass!))
                                (lambda () (subst (list '= (tgt-inv iy) y)) (subst (list '= (tgt-op y '(IDEN g)) y)) (tgk-ass!)))))
          (let* ((k (dk-skolem! (dk-apply! (dk-ctx-form tgk-hfund) W))) (sk (list 'succ k)) (r (tgk-h sk)))
            (dk-cite! 'nn-succ-closed k)
            (tgk-hf! sk)
            (fact 'rr-pos-rr-of-lt r)
            (ew r)
            (dk-conj-close!
             (lambda ()
               (if (dk-head-is? (dk-goal) 'SUBSET)
                   (begin
                     (mac 'subset-def)
                     (let ((p (cadr (car (filter (lambda (h) (dk-head-is? h 'IN)) (dk-peel!))))))
                       (tgk-ball-parts! p y r)
                       (dk-rewrite-h! (list 'IN p (list 'PTS tgk-BKM)) (list 'PTS tgk-BKM) tgk-C)
                       (tgk-dd-real! y p)
                       (tgk-and! (list '<= (tgk-dd y p) r) (list 'NOT (list '= (tgk-dd y p) r)))
                       (dk-cite! 'rr-le-ne-lt (tgk-dd y p) r)
                       (dk-cite! 'bk-nbhd-of-ball 's 'g 'vs k y p)
                       (dk-cite! 'subset-mem-fwd (list 'vs k) W (tgk-ivx y p))
                       (sep-me (list 'IN (tgk-ivx y p) W))
                       (dk-cite! 'group-mul-inv-cancel 'g y p)
                       (dk-rewrite-h! (list 'IN (tgt-op (tgt-inv iy) (tgk-ivx y p)) tgk-U) (tgt-inv iy) y)
                       (dk-rewrite-h! (list 'IN (tgt-op y (tgk-ivx y p)) tgk-U) (tgt-op y (tgk-ivx y p)) p)
                       (tgk-ass!)))
                   (tgk-ass!))))))))
    (if (dk-only! tgk-iso '(IS-METRIC-SPACE (BK-METRIC g vs)) (list 'SUBSET tgk-U (list 'PTS tgk-BKM))
                  (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y tgk-U) (list 'FORSOME 'r (list 'AND '(POS-RR r) (list 'SUBSET (tgk-ball 'y 'r) tgk-U))))))
        (prop))))
(dk-have! (list 'IMPLIES (list 'IS-OPEN tgk-BKM tgk-U) (list 'IN tgk-U '(OPENS s)))
  (lambda ()
    (di)
    (dk-have! (caddr tgk-iso) (lambda () (if (dk-only! tgk-iso (list 'IS-OPEN tgk-BKM tgk-U)) (prop))))
    (dk-split-all! (list (caddr tgk-iso)))
    (let ((h1 (dk-rewrite-h! (list 'SUBSET tgk-U (list 'PTS tgk-BKM)) (list 'PTS tgk-BKM) tgk-C)))
      (dk-rewrite-h! h1 tgk-C '(PTS s)))
    (dk-have! (list 'FORALL 'a (list 'IMPLIES (list 'IN 'a tgk-U)
                (list 'FORSOME 'W2 (list 'AND '(IN W2 (OPENS s)) (list 'AND '(IN a W2) (list 'SUBSET 'W2 tgk-U))))))
      (lambda ()
        (let* ((a (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!)))))
               (bcl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'BALL))) "the ball clause"))
               (r (dk-skolem! (dk-apply! bcl a))))
          (dk-split-all!)
          (dk-cite! 'subset-mem-fwd tgk-U '(PTS s) a)
          (tgt-carr! a)
          (fact 'rr-pos-rr-in-rr r)
          (fact 'rr-lt-of-pos-rr r)
          (dk-have! '(IN 1/2 RR) (lambda () (arith)))
          (dk-have! '(AND (<= 0 1/2) (< 1/2 1)) (lambda () (dk-conj-close! (lambda () (arith)))))
          (let* ((cap (dk-skolem! (dk-apply! (dk-cite! 'power-small-threshold 1/2) r)))
                 (ccl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h cap))) "the threshold"))
                 (sc (list 'succ cap)) (c2 (list 'succ sc))
                 (T (tgt-aW a (list 'vs c2))))
            (dk-cite! 'nn-le-refl cap)
            (dk-apply! ccl cap)
            (dk-cite! 'nn-succ-closed cap) (dk-cite! 'nn-succ-closed sc)
            (tgk-hf! cap) (tgk-hf! sc)
            (tgk-q! c2)
            (tgk-vs-open! c2)
            (dk-cite! 'top-group-translate-open-gt 's 'g a (list 'vs c2))
            (dk-cite! 'group-left-inv 'g a)
            (tgt-pts! a)
            (dk-have! (list 'IN a T)
              (lambda () (in-sep! (lambda () (tgk-ass!)) (lambda () (subst (list '= (tgk-ivx a a) '(IDEN g))) (tgk-ass!)))))
            (ew T)
            (dk-conj-close!
             (lambda ()
               (if (dk-head-is? (dk-goal) 'SUBSET)
                   (begin
                     (mac 'subset-def)
                     (let ((z (cadr (car (filter (lambda (h) (dk-head-is? h 'IN)) (dk-peel!))))))
                       (sep-me (list 'IN z T))
                       (tgt-carr! z)
                       (dk-cite! 'bk-ball-of-nbhd 's 'g 'vs cap a z)
                       (tgk-dd-real! a z)
                       (dk-have! (list '<= (tgk-dd a z) r)
                         (lambda () (dk-ineq! (list '<= (tgk-dd a z) (tgk-h sc)) (list '= (tgk-h sc) (list '* 1/2 (tgk-h cap)))
                                              (list '<= (tgk-h cap) r) (list '< 0 (tgk-h cap))
                                              (list 'IN (tgk-dd a z) 'RR) (list 'IN (tgk-h sc) 'RR) (list 'IN (tgk-h cap) 'RR) (list 'IN r 'RR))))
                       (dk-have! (list 'NOT (list '= (tgk-dd a z) r))
                         (lambda () (di)
                           (dk-have! '(< 0 0)
                             (lambda () (dk-ineq! (list '= (tgk-dd a z) r) (list '<= (tgk-dd a z) (tgk-h sc)) (list '= (tgk-h sc) (list '* 1/2 (tgk-h cap)))
                                                  (list '<= (tgk-h cap) r) (list '< 0 (tgk-h cap))
                                                  (list 'IN (tgk-dd a z) 'RR) (list 'IN (tgk-h sc) 'RR) (list 'IN (tgk-h cap) 'RR) (list 'IN r 'RR))))
                           (ai (dk-cite! 'rr-lt-irrefl 0))))
                       (dk-cite! 'bk-metric-pts 's 'g 'vs)
                       (dk-have! (list 'IN z (list 'PTS tgk-BKM)) (lambda () (subst (list '== (list 'PTS tgk-BKM) tgk-C)) (tgk-ass!)))
                       (let ((iff (dk-cite! 'ball-membership tgk-BKM a r z)))
                         (dk-have! (list 'IN z (tgk-ball a r))
                           (lambda () (if (dk-only! iff (list 'IN z (list 'PTS tgk-BKM)) (list '<= (tgk-dd a z) r) (list 'NOT (list '= (tgk-dd a z) r))) (prop)))))
                       (dk-cite! 'subset-mem-fwd (tgk-ball a r) tgk-U z)
                       (tgk-ass!)))
                   (tgk-ass!))))))))
    (dk-cite! 'top-open-of-local 's tgk-U)
    (tgk-ass!)))
(if (dk-only! (list 'IMPLIES (list 'IN tgk-U '(OPENS s)) (list 'IS-OPEN tgk-BKM tgk-U))
              (list 'IMPLIES (list 'IS-OPEN tgk-BKM tgk-U) (list 'IN tgk-U '(OPENS s))))
    (prop))
(qed 'bk-metric-topology)
(topic! 'bk-metric-topology 'analysis)

;;; =====================================================================
;;; Proposition A.6 (Birkhoff-Kakutani)
;;; =====================================================================
(sp (make-wff (tgx-keep! 'birkhoff-kakutani-gt '(FORALL s (FORALL g (IMPLIES (IS-GROUP-TOPOLOGY s g) (IMPLIES (IS-HAUSDORFF s) (IMPLIES (HAS-COUNTABLE-NBHD-BASE s (IDEN g))
   (FORSOME md (AND (IS-METRIC-SPACE md) (AND (= (PTS md) (PTS s))
     (AND (IS-LEFT-INVARIANT md g) (= (OPENS (METRIC-TOP md)) (OPENS s))))))))))))))
(dk-peel!)
(define tga-cont (tgt-parts!))
(tgt-pts! '(IDEN g))
(dk-split-all! (dk-landed (lambda () (mac-h 'HAS-COUNTABLE-NBHD-BASE '(HAS-COUNTABLE-NBHD-BASE s (IDEN g))))))
(define tga-bsq (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (eq? (cadr h) 'cbn_))) "the base")))
(dk-split-all!)
(define tga-bfund (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'SUBSET) (dk-contains? h tga-bsq))) "fundamental"))
(define tga-vs (dk-skolem! (dk-cite! 'top-group-nbhd-sequence-gt 's 'g tga-bsq)))
(dk-split-all!)
(define tga-props (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h tga-vs) (dk-contains? h tga-bsq))) "the sequence clause"))
;; the BK hypotheses, at vs := tga-vs
(define (tga-sub e) (subst-free 'vs tga-vs e))
(dk-have! (list 'IS-BK-SEQUENCE 's 'g tga-vs)
  (lambda ()
    (mac 'IS-BK-SEQUENCE)
    (dk-conj-close!
     (lambda ()
       (if (dk-head-is? (dk-goal) 'FORALL)
           (let ((k (cadr (car (dk-peel!)))))
             (dk-split-all! (list (dk-apply! tga-props k)))
             (dk-conj-close! (lambda () (tgk-ass!))))
           (tgk-ass!))))))
(dk-have! (tga-sub tgk-hfund)
  (lambda ()
    (let* ((pl (dk-peel!))
           (w (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) '(OPENS s)))) pl))))
           (k0 (dk-skolem! (dk-apply! tga-bfund w))))
      (dk-split-all!)
      (dk-cite! 'nn-succ-closed k0)
      (dk-split-all! (list (dk-apply! tga-props k0)))
      (dk-cite! 'subset-trans (list tga-vs (list 'succ k0)) (list tga-bsq k0) w)
      (ew (list 'succ k0))
      (dk-conj-close! (lambda () (tgk-ass!))))))
(dk-have! (tga-sub tgk-hsep)
  (lambda ()
    (let* ((pl (dk-peel!))
           (z (cadr (car (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) '(CARR g)))) pl))))
           (allv (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h tga-vs) (dk-contains? h z))) "z in every vs")))
      (use-em (list '= z '(IDEN g))
        (lambda () (tgk-ass!))
        (lambda ()
          (tgt-pts! z)
          (let ((iff (dk-cite! 'is-hausdorff 's)))
            (dk-have! (caddr iff) (lambda () (if (dk-only! iff '(IS-HAUSDORFF s)) (prop))))
            (dk-split-all! (list (caddr iff))))
          (dk-have! (list 'NOT (list '== '(IDEN g) z))
            (lambda () (di)
                       (dk-have! (list '= z '(IDEN g)) (lambda () (subst (list '== '(IDEN g) z)) (rfl)))
                       (ai (list 'NOT (list '= z '(IDEN g))))))
          (let* ((hd (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'INTERSECTION) (dk-contains? h 'EMPTY-SET))) "Hausdorff"))
                 (u (dk-skolem! (dk-apply! hd '(IDEN g) z)))
                 (v (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h u))) "the second open"))))
            (dk-split-all!)
            (let ((hf (dk-ctx-form (tga-sub tgk-hfund))))
              (let ((k (dk-skolem! (dk-apply! hf u))))
                (dk-split-all!)
                (dk-apply! allv k)
                (dk-cite! 'subset-mem-fwd (list tga-vs k) u z)
                (tgt-int-intro! z u v)
                (dk-have! (list 'IN z 'EMPTY-SET) (lambda () (subst (list '== 'EMPTY-SET (tgt-int u v))) (tgk-ass!)))
                (dk-cite! 'empty-set-has-no-members z)
                (ai (list 'NOT (list 'IN z 'EMPTY-SET)))))))))))
;; the metric
(define tga-md (list 'BK-METRIC 'g tga-vs))
(dk-cite! 'bk-metric-is-metric-space 's 'g tga-vs)
(dk-cite! 'bk-metric-pts 's 'g tga-vs)
(dk-cite! 'bk-metric-left-invariant 's 'g tga-vs)
(dk-cite! 'bk-metric-topology 's 'g tga-vs)
(dk-cite! 'metric-top-opens-iff tga-md)
(ew tga-md)
(dk-conj-close!
 (lambda ()
   (let ((g0 (dk-goal)))
     (cond
      ((and (dk-head-is? g0 '=) (equal? (cadr g0) (list 'PTS tga-md)))
       (subst (list '== (list 'PTS tga-md) '(CARR g)))
       (subst (list '= '(PTS s) '(CARR g)))
       (rfl))
      ((dk-head-is? g0 '=)
       (dk-have! (list 'FORALL 'x (list 'IFF (list 'IN 'x (list 'OPENS (list 'METRIC-TOP tga-md))) '(IN x (OPENS s))))
         (lambda ()
           (di)
           (let* ((x (cadr (cadr (dk-goal))))
                  (i1 (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'METRIC-TOP))) "metric-top opens") x))
                  (i2 (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(OPENS s)) (dk-contains? h 'IS-OPEN) (not (dk-contains? h 'METRIC-TOP)))) "the topology") x)))
             (if (dk-only! i1 i2) (prop)))))
       (dk-cite! 'metric-top-is-top-space tga-md)
       (dk-cite! 'class-extensionality (list 'OPENS (list 'METRIC-TOP tga-md)) '(OPENS s))
       (tgk-ass!))
      (#t (tgk-ass!))))))
(qed 'birkhoff-kakutani-gt)
(topic! 'birkhoff-kakutani-gt 'analysis)
(tgx-lift! 'birkhoff-kakutani-gt 'birkhoff-kakutani)

;;; =====================================================================
;;; Theorem A.4: without countability or separation, the BK-METRICs are left-invariant
;;; pseudometrics, their balls are open, and together they define the topology.
;;; =====================================================================
(sp (make-wff (tgk-hyps (list 'IS-PSEUDOMETRIC-SPACE tgk-BKM))))
(dk-peel!)
(tgk-setup!)
(dk-cite! 'group-carr-set 'g)
(dk-cite! 'bk-metric-lam-type 's 'g 'vs)
(dk-cite! 'bk-metric-pts 's 'g 'vs)
(dk-cite! 'bk-metric-dist-fun 's 'g 'vs)
(mac 'IS-PSEUDOMETRIC-SPACE)
(subst (list '== (list 'PTS tgk-BKM) tgk-C))
(subst (list '== (list 'DIST tgk-BKM) tgk-lam))
(dk-conj-close!
 (lambda ()
   (let ((g0 (dk-goal)))
     (cond
      ((and (dk-head-is? g0 '=) (dk-head-is? (cadr g0) 'LENGTH))
       (mac 'BK-METRIC) (len-r) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (vnb-guard (lambda () (arith)))))
      ((dk-head-is? g0 'IS-PSEUDOMETRIC)
       (mac 'is-pseudometric)
       (let loop ((fuel 80))
         (let ((n (find-first (lambda (n) (let ((gg (dk-goal-of n))) (and (pair? gg) (memq (car gg) '(FORALL IMPLIES AND)))))
                              (dk-open-leaves))))
           (if (and n (> fuel 0)) (begin (dk-focus! n) (di) (loop (- fuel 1))))))
       (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (tgk-law!)))) (dk-open-leaves)))
      (#t (tgk-ass!))))))
(qed 'bk-metric-pseudometric)
(topic! 'bk-metric-pseudometric 'analysis)

;;; ---- the balls of a BK-METRIC are open: the pseudometric is continuous ----
