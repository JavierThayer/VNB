(sp (g4n-st (list 'FORALL 'b (list 'IMPLIES '(IN b (VEC a)) (list 'FORALL 'c (list 'IMPLIES '(IN c (VEC a))
  (list '= (list (list 'VADD g4n-H) (g4n-cl 'b) (g4n-cl 'c)) (g4n-cl '((VADD a) b c)))))))))
(dk-peel!)
(g4n-hsetup!)
(subst (dk-cite! 'gns-pre-vadd 'a 'f))
(mac 'GNS-SETOID)
(g4n-vmd! 'b) (g4n-vmd! 'c)
(subst (g4n-cite*! 'qmod-vadd-computes g4n-md g4n-N 'b 'c))
(g4n-onto-a!)
(g4n-close-eq!)
(g4n-qed! 'gns-pre-vadd-computes)

(sp (g4n-st (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'b (list 'IMPLIES '(IN b (VEC a))
  (list '= (list (list 'ACT g4n-H) 'c (g4n-cl 'b)) (g4n-cl '((ACT a) c b)))))))))
(dk-peel!)
(g4n-hsetup!)
(subst (dk-cite! 'gns-pre-act 'a 'f))
(mac 'GNS-SETOID)
(g4n-vmd! 'b)
(dk-have! (list 'IN 'c (list 'CARR (list 'SCAL g4n-md)))
  (lambda () (subst (list '= (list 'SCAL g4n-md) g4n-R)) (subst (dk-cite! 'sip-cc-ring-carr)) (dk-ass!)))
(subst (g4n-cite*! 'qmod-act-computes g4n-md g4n-N 'c 'b))
(g4n-onto-a!)
(g4n-close-eq!)
(g4n-qed! 'gns-pre-act-computes)

;;; ---- pi(x) is linear on H0, and x |-> pi(x) is linear
(define (g4n-vadd x y) (list '(VADD a) x y))
(define (g4n-act c x) (list '(ACT a) c x))
(define (g4n-hvadd u w) (list (list 'VADD g4n-H) u w))
(define (g4n-hact c u) (list (list 'ACT g4n-H) c u))
(define (g4n-fin! lhs rhs)    ; goal [lhs] = [rhs] after the computations: lhs = rhs by algebra
  (g4n-vt! lhs) (g4n-vt! rhs)
  (if (not (equal? lhs rhs)) (begin (g4n-alg! (list '= lhs rhs)) (g4n-rw! lhs rhs)))
  (g4n-close-eq!))

(sp (g4n-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u (list 'VEC g4n-H)) (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w (list 'VEC g4n-H))
    (list '= (list (g4n-op 'x) (g4n-hvadd 'u 'w)) (g4n-hvadd (list (g4n-op 'x) 'u) (list (g4n-op 'x) 'w)))))))))))
(dk-peel!)
(g4n-vsetup!)
(let* ((b (g4n-rep! 'u)) (c (g4n-rep! 'w)) (bc (g4n-vadd b c)) (xb (g4n-mu 'x b)) (xc (g4n-mu 'x c)))
  (g4n-vt! bc) (g4n-vt! xb) (g4n-vt! xc)
  (subst (g4n-cite*! 'gns-pre-vadd-computes 'a 'f b c))
  (subst (g4n-cite*! 'gns-op-computes 'a 'f 'x b))
  (subst (g4n-cite*! 'gns-op-computes 'a 'f 'x c))
  (subst (g4n-cite*! 'gns-op-computes 'a 'f 'x bc))
  (subst (g4n-cite*! 'gns-pre-vadd-computes 'a 'f xb xc))
  (g4n-fin! (g4n-mu 'x bc) (g4n-vadd xb xc)))
(g4n-qed! 'gns-op-vadd)

(sp (g4n-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u (list 'VEC g4n-H))
    (list '= (list (g4n-op 'x) (g4n-hact 'c 'u)) (g4n-hact 'c (list (g4n-op 'x) 'u)))))))))))
(dk-peel!)
(g4n-vsetup!)
(let* ((b (g4n-rep! 'u)) (cb (g4n-act 'c b)) (xb (g4n-mu 'x b)))
  (g4n-vt! cb) (g4n-vt! xb)
  (subst (g4n-cite*! 'gns-pre-act-computes 'a 'f 'c b))
  (subst (g4n-cite*! 'gns-op-computes 'a 'f 'x b))
  (subst (g4n-cite*! 'gns-op-computes 'a 'f 'x cb))
  (subst (g4n-cite*! 'gns-pre-act-computes 'a 'f 'c xb))
  (g4n-fin! (g4n-mu 'x cb) (g4n-act 'c xb)))
(g4n-qed! 'gns-op-act)

(sp (g4n-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'FORALL 'y (list 'IMPLIES '(IN y (VEC a))
  (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u (list 'VEC g4n-H))
    (list '= (list (g4n-op (g4n-vadd 'x 'y)) 'u) (g4n-hvadd (list (g4n-op 'x) 'u) (list (g4n-op 'y) 'u)))))))))))
(dk-peel!)
(g4n-vsetup!)
(let* ((b (g4n-rep! 'u)) (xy (g4n-vadd 'x 'y)) (xb (g4n-mu 'x b)) (yb (g4n-mu 'y b)))
  (g4n-vt! xy) (g4n-vt! xb) (g4n-vt! yb)
  (subst (g4n-cite*! 'gns-op-computes 'a 'f 'x b))
  (subst (g4n-cite*! 'gns-op-computes 'a 'f 'y b))
  (subst (g4n-cite*! 'gns-op-computes 'a 'f xy b))
  (subst (g4n-cite*! 'gns-pre-vadd-computes 'a 'f xb yb))
  (g4n-fin! (g4n-mu xy b) (g4n-vadd xb yb)))
(g4n-qed! 'gns-op-sum)

(sp (g4n-st (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u (list 'VEC g4n-H))
    (list '= (list (g4n-op (g4n-act 'c 'x)) 'u) (g4n-hact 'c (list (g4n-op 'x) 'u)))))))))))
(dk-peel!)
(g4n-vsetup!)
(let* ((b (g4n-rep! 'u)) (cx (g4n-act 'c 'x)) (xb (g4n-mu 'x b)))
  (g4n-vt! cx) (g4n-vt! xb)
  (subst (g4n-cite*! 'gns-op-computes 'a 'f 'x b))
  (subst (g4n-cite*! 'gns-op-computes 'a 'f cx b))
  (subst (g4n-cite*! 'gns-pre-act-computes 'a 'f 'c xb))
  (g4n-fin! (g4n-mu cx b) (g4n-act 'c xb)))
(g4n-qed! 'gns-op-scale)

;;; Remarks 4.28: <pi(x) pi(y) xi | pi(z) xi> = phi(z* x y)
(sp (g4n-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'FORALL 'y (list 'IMPLIES '(IN y (VEC a))
  (list 'FORALL 'z (list 'IMPLIES '(IN z (VEC a))
    (list '= (list (list 'IP g4n-H) (list (g4n-op 'x) (list (g4n-op 'y) g4n-xi)) (list (g4n-op 'z) g4n-xi))
             (list 'f (g4n-q 'z (g4n-mu 'x 'y))))))))))))
(dk-peel!)
(g4n-ssetup!)
(mac 'GNS-VECTOR)
(g4n-vt! g4n-one)
(subst (g4n-cite*! 'gns-op-computes 'a 'f 'y g4n-one))
(subst (g4n-cite*! 'gns-op-computes 'a 'f 'z g4n-one))
(g4n-vt! (g4n-mu 'y g4n-one)) (g4n-vt! (g4n-mu 'z g4n-one))
(g4n-alg! (list '= (g4n-mu 'y g4n-one) 'y))
(g4n-alg! (list '= (g4n-mu 'z g4n-one) 'z))
(g4n-rw! (g4n-mu 'y g4n-one) 'y)
(g4n-rw! (g4n-mu 'z g4n-one) 'z)
(subst (g4n-cite*! 'gns-op-computes 'a 'f 'x 'y))
(g4n-vt! (g4n-mu 'x 'y))
(subst (g4n-cite*! 'gns-ip-computes 'a 'f (g4n-mu 'x 'y) 'z))
(g4n-close-eq!)
(g4n-qed! 'gns-matrix-coeff)
