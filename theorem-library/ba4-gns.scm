;;; ba4-gns.scm -- THE GNS CONSTRUCTION, pre-Hilbert stage: BanachAlgebras.pdf Theorem 4.13 (87) and the
;;; first half of its proof.  Agent BA-1111-B, 2026-11-11.  Destination: theorem-library/ba4-gns.scm.
;;; Library: operator-algebras.  Load window: after ba4-pos (Lemma 4.4, Corollary 4.10), ba4-rep,
;;; structure-library/ba-gns-vocab, and BA-1111-A2's ipf-laws / ipf-quotient (form-quotient-is-cips,
;;; form-qip-computes, form-null-*).
;;;
;;; a is a unital involutive Banach algebra, phi a positive functional, md = GNS-MODULE(a),
;;; B = GNS-FORM(a, phi), S = GNS-SETOID(a, phi), H0 = GNS-PRE(a, phi), xi = GNS-VECTOR(a, phi).
;;;   gns-md-{vec,vadd,act,vzero,vneg,scal}   the module's slots
;;;   gns-form-value        B(x, y) = phi(y* x)
;;;   gns-form-psd          B is a positive semi-definite hermitian form          (Lemma 4.4)
;;;   gns-pre-is-cips       H0 is a complex inner product space (the pre-Hilbert space)
;;;   gns-null-invariant    phi(b* b) = 0 => phi((x b)* (x b)) = 0                (Corollary 4.10)
;;;   gns-op-computes       pi(x)[b] = [x b]
;;;   gns-ip-computes       <[b] | [c]> = phi(c* b)
;;;   gns-represents        (87): phi(x) = <pi(x) xi | xi>
;;;   gns-cyclic            every vector of H0 is pi(b) xi
;;;   gns-op-adjoint        <pi(x) u | w> = <u | pi(x*) w>
;;;   gns-op-bounded        <pi(x) u | pi(x) u> <= ||x||^2 <u | u>
;;;   gns-op-mul, gns-op-unit, gns-op-add, gns-op-act      pi is a unital algebra map, pointwise

(define (g4n-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (if (and (not (sequent-node-grounded? l))
                           (let ((g (dk-goal-of l))) (and (pair? g) (eq? (car g) '=) (equal? (cadr g) (caddr g)))))
                      (begin (dk-focus! l) (rfl))))
                (dk-open-leaves)))
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba4-gns: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba4-gns: unfinished" name))))
(define (g4n-close-eq!) (if (not (proof-done? *ps*)) (let ((g (dk-goal))) (if (and (eq? (car g) '=) (equal? (cadr g) (caddr g))) (rfl)))))
(define (g4n-cite*! . args)
  (let loop ((r (apply dk-cite! args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (loop (if (dk-asm? (cadr r))
                  (dk-landed-1 (lambda () (detach! r)))
                  (detach-with! r (lambda () (dk-conj-close! (lambda () (dk-ass!)))))))
        r)))
(define (g4n-occurs? x t) (or (equal? x t) (and (pair? t) (or (g4n-occurs? x (car t)) (g4n-occurs? x (cdr t))))))
(define (g4n-rw! from to) (subst (list '= from to)))

(define g4n-V '(UIBA-AS-UBA a))
(define g4n-md '(GNS-MODULE a))
(define g4n-B '(GNS-FORM a f))
(define g4n-R '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define g4n-accs '(VEC VADD ACT VZERO VNEG))
(define (g4n-ro-name acc) (string->symbol (string-append "gns-md-" (string-downcase (symbol->string acc)))))

;;; ---- the module's slots
(for-each
  (lambda (acc)
    (sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
                    (list '== (list acc g4n-md) (list acc 'a))))))
    (dk-peel!)
    (dk-cite! 'bcs-uiba-is-uba 'a)
    (mac 'GNS-MODULE)
    (subst (dk-cite! (string->symbol (string-append "bqn-uam-" (string-downcase (symbol->string acc)))) g4n-V))
    (subst (dk-cite! (string->symbol (string-append "bcs-uu-" (string-downcase (symbol->string acc)))) 'a))
    (if (not (proof-done? *ps*)) (qrfl))
    (g4n-qed! (g4n-ro-name acc)))
  g4n-accs)

(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
                (list '= (list 'SCAL g4n-md) g4n-R)))))
(dk-peel!)
(dk-cite! 'bcs-uiba-is-uba 'a)
(mac 'GNS-MODULE)
(subst (dk-cite! 'bqn-uam-scal g4n-V))
(subst (dk-cite! 'bal-uba-scal-pin g4n-V))
(if (not (proof-done? *ps*)) (g4n-close-eq!))
(g4n-qed! 'gns-md-scal)

;;; the goal's md-slots rewritten onto a
(define (g4n-onto-a!)
  (for-each (lambda (acc)
              (let ((t (list acc g4n-md)))
                (if (g4n-occurs? t (dk-goal))
                    (subst (dk-cite! (g4n-ro-name acc) 'a)))))
            g4n-accs))
;;; a hypothesis rewritten onto a
(define (g4n-h-onto-a! f)
  (let loop ((accs g4n-accs) (g f))
    (if (null? accs) g
        (let ((t (list (car accs) g4n-md)))
          (if (g4n-occurs? t g)
              (begin (dk-cite! (g4n-ro-name (car accs)) 'a)
                     (loop (cdr accs) (dk-rewrite-h! g t (list (car accs) 'a))))
              (loop (cdr accs) g))))))

(define (g4n-st body)
  (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
    (list 'FORALL 'f (list 'IMPLIES '(IS-POSITIVE-LF a f) body))))))
(define (g4n-mu x y) (list '(VMUL a) x y))
(define (g4n-sr x) (list '(VSTAR a) x))
(define (g4n-q x y) (g4n-mu (g4n-sr x) y))
(define (g4n-vt! t) (dk-alg-type! 'kal-uiba 'a t) t)
(define (g4n-alg! claim) (dk-alg-have! 'kal-uiba 'a claim))
;;; open IS-POSITIVE-LF(a, f): f typed, la, lm, pos
(define g4n-la #f) (define g4n-lm #f) (define g4n-pos #f)
(define (g4n-setup!)
  (let* ((hyp '(IS-POSITIVE-LF a f))
         (body (caddr (dk-cite! 'IS-POSITIVE-LF 'a 'f)))
         (lin (dk-project! (cadr body) 'IS-POSITIVE-LF hyp))
         (pos (dk-project! (caddr body) 'IS-POSITIVE-LF hyp))
         (ld (caddr (dk-cite! 'IS-CC-LINEAR-ON 'a 'f))))
    (dk-project! (cadr ld) 'IS-CC-LINEAR-ON lin)
    (set! g4n-la (dk-project! (cadr (caddr ld)) 'IS-CC-LINEAR-ON lin))
    (set! g4n-lm (dk-project! (caddr (caddr ld)) 'IS-CC-LINEAR-ON lin))
    (set! g4n-pos pos)))
(define (g4n-cv! t) (g4n-vt! t) (dk-cite! 'fun-apply-type-c 'f '(VEC a) 'CC t))

;;; ---- gns-form-value
(sp (g4n-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'FORALL 'y (list 'IMPLIES '(IN y (VEC a))
  (list '= (list g4n-B 'x 'y) (list 'f (g4n-q 'y 'x)))))))))
(dk-peel!)
(g4n-setup!)
(g4n-cv! (g4n-q 'y 'x))
(mac 'GNS-FORM)
(let ((l (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? l)) (g4n-close-eq!)))
(g4n-qed! 'gns-form-value)

;;; ---- gns-form-psd: Lemma 4.4 in the form ipf-vocab asks
(define (g4n-form-apps t)
  (cond ((not (pair? t)) '())
        ((and (equal? (car t) g4n-B) (= (length t) 3)) (list t))
        (#t (apply append (map g4n-form-apps t)))))
(define (g4n-unform!)      ; every B(u, w) of the goal rewritten to phi(w* u)
  (for-each (lambda (app)
              (g4n-vt! (cadr app)) (g4n-vt! (caddr app))
              (g4n-cv! (g4n-q (caddr app) (cadr app)))
              (subst (dk-cite! 'gns-form-value 'a 'f (cadr app) (caddr app))))
            (g4n-form-apps (dk-goal))))
(define (g4n-form-leaf!)
  (g4n-onto-a!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'IN)
           (mac 'GNS-FORM)
           (dk-lam-type!
             (lambda ()
               (dk-peel!)
               (let ((body (cadr (dk-goal))))
                 (g4n-cv! (cadr body))
                 (dk-ass!)))
             (lambda ()
               (dk-cite! 'fun-domain-in-set '(VEC a) 'CC 'f)
               (if (dk-head-is? (cadr (dk-goal)) 'CARTESIAN)
                   (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (dk-ass!))))
                   (dk-ass!)))))
          (#t
           (dk-peel!)
           (g4n-unform!)
           (let* ((g2 (dk-goal)))
             (cond ((or (dk-head-is? g2 'IN) (dk-head-is? g2 '<=))
                    (let* ((term (if (dk-head-is? g2 'IN) (cadr g2) (caddr g2)))
                           (x (caddr (cadr term))))
                      (dk-split! (dk-apply! g4n-pos x))
                      (dk-ass!)))
                   ((dk-head-is? (caddr g2) 'CONJUGATE)
                    (let* ((lhs (cadr (cadr g2))))          ; (x* y)
                      (dk-cite! 'pos-lf-conj-sym 'a 'f (cadr (cadr lhs)) (caddr lhs))
                      (dk-ass!)))
                   ((dk-head-is? (caddr g2) '+)
                    (let* ((arg (cadr (cadr g2))) (zs (cadr arg)) (s (caddr arg))
                           (rhs-t (list '(VADD a) (g4n-mu zs (cadr s)) (g4n-mu zs (caddr s)))))
                      (g4n-vt! rhs-t)
                      (g4n-alg! (list '= arg rhs-t))
                      (g4n-rw! arg rhs-t)
                      (subst (dk-apply! g4n-la (cadr rhs-t) (caddr rhs-t)))
                      (g4n-close-eq!)))
                   (#t
                    (let* ((arg (cadr (cadr g2))) (zs (cadr arg)) (s (caddr arg)) (c (cadr s))
                           (rhs-t (list '(ACT a) c (g4n-mu zs (caddr s)))))
                      (g4n-vt! rhs-t)
                      (g4n-alg! (list '= arg rhs-t))
                      (g4n-rw! arg rhs-t)
                      (subst (dk-apply! g4n-lm c (caddr rhs-t)))
                      (g4n-close-eq!)))))))))

(sp (g4n-st (list 'IS-PSD-FORM g4n-md g4n-B)))
(dk-peel!)
(g4n-setup!)
(let* ((piff (dk-cite! 'IS-PSD-FORM g4n-md g4n-B))
       (hiff (dk-cite! 'IS-HERMITIAN-FORM g4n-md g4n-B))
       (herm (list 'IS-HERMITIAN-FORM g4n-md g4n-B)))
  (dk-have! (caddr hiff) (lambda () (dk-conj-close! g4n-form-leaf!)))
  (dk-have! herm (lambda () (keep hiff (caddr hiff)) (prop)))
  (dk-have! (caddr piff) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!) (g4n-form-leaf!))))))
  (keep piff (caddr piff))
  (prop))
(g4n-qed! 'gns-form-psd)

;;; ---- the module, the null space, the setoid
(define g4n-N (list 'FORM-NULL g4n-md g4n-B))
(define g4n-S '(GNS-SETOID a f))
(define g4n-Su (list 'QMOD-SETOID g4n-md g4n-N))
(define g4n-H '(GNS-PRE a f))
(define (g4n-cl b) (list 'CLASS g4n-S b))

(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (list 'IS-MODULE g4n-md)))))
