(g4n-qsetup!)
(mac 'GNS-SETOID)
(subst (dk-cite! 'qmod-setoid-pts g4n-md g4n-N))
(subst (dk-cite! 'gns-md-vec 'a))
(if (not (proof-done? *ps*)) (qrfl))
(g4n-qed! 'gns-setoid-pts)

;;; ---- phi(b* b) = 0 => phi((x b)* (x b)) = 0   (Corollary 4.10 with y = b, x := x* x)
(sp (g4n-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'FORALL 'b (list 'IMPLIES '(IN b (VEC a))
  (list 'IMPLIES (list '= (list 'f (g4n-q 'b 'b)) 0) (list '= (list 'f (g4n-q (g4n-mu 'x 'b) (g4n-mu 'x 'b))) 0))))))))
(dk-peel!)
(g4n-setup!)
(let* ((xx (g4n-q 'x 'x)) (xb (g4n-mu 'x 'b)) (q (g4n-q xb xb))
       (sw (g4n-mu (g4n-mu (g4n-sr 'b) xx) 'b)) (nxx (list '(VNRM a) xx)) (fq (list 'f q)))
  (g4n-vt! xx) (g4n-vt! xb) (g4n-vt! q) (g4n-vt! sw)
  (g4n-alg! (list '= sw q))
  (let* ((h (dk-cite! 'pos-lf-sandwich-bound 'a 'f xx 'b))
         (h1 (dk-rewrite-h! h sw q))
         (h2 (dk-rewrite-h! h1 (list 'f (g4n-q 'b 'b)) 0)))
    (dk-split! (dk-apply! g4n-pos xb))
    (dk-split! (dk-cite! 'uiba-vnrm-real 'a xx))
    (dk-cite! 'rr-magnitude-is-abs fq) (dk-cite! 'rr-abs-of-nonneg fq)
    (let ((h3 (dk-rewrite-h! (dk-rewrite-h! h2 (list 'MAGNITUDE fq) (list 'ABS fq)) (list 'ABS fq) fq)))
      (dk-have! (list '= (list '* nxx 0) 0) (lambda () (crs)))
      (let ((h4 (dk-rewrite-h! h3 (list '* nxx 0) 0)))
        (dk-have! '(IN 0 RR) (lambda () (arith)))
        (dk-have! (list 'AND (list 'IN fq 'RR) '(IN 0 RR)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
        (dk-have! (list 'AND (list '<= fq 0) (list '<= 0 fq)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
        (g4n-cite*! 'rr-leq-antisymmetric fq 0)
        (dk-ass!)))))
(g4n-qed! 'gns-null-invariant)

;;; ---- related b c iff phi((b - c)* (b - c)) = 0
(define (g4n-sb x y) (list '(VADD a) x (list '(VNEG a) y)))
(define (g4n-md-sb x y) (list (list 'VADD g4n-md) x (list (list 'VNEG g4n-md) y)))
(define (g4n-vmd! t)     ; (IN t (VEC md)) from (IN t (VEC a))
  (g4n-vt! t)
  (let ((g (list 'IN t (list 'VEC g4n-md))))
    (if (not (dk-asm? g)) (dk-have! g (lambda () (g4n-onto-a!) (dk-ass!))))
    g))
(sp (g4n-st (list 'FORALL 'b (list 'IMPLIES '(IN b (VEC a)) (list 'FORALL 'c (list 'IMPLIES '(IN c (VEC a))
  (list 'IFF (list 'RELATED g4n-S 'b 'c) (list '= (list 'f (g4n-q (g4n-sb 'b 'c) (g4n-sb 'b 'c))) 0))))))))
(dk-peel!)
(g4n-qsetup!)
(mac 'GNS-SETOID)
(let* ((d (g4n-sb 'b 'c)) (dmd (g4n-md-sb 'b 'c)) (dq (g4n-q d d)))
  (g4n-vt! d) (g4n-cv! dq)
  (g4n-vmd! 'b) (g4n-vmd! 'c) (g4n-vmd! d)
  (dk-have! (list '= dmd d) (lambda () (g4n-onto-a!) (g4n-close-eq!)))
  (for-each
    (lambda (l)
      (if (not (sequent-node-grounded? l))
          (begin
            (dk-focus! l)
            (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
            (if (dk-head-is? (dk-goal) 'RELATED)
                ;; <=
                (begin
                  (dk-have! (list '= (list g4n-B d d) 0)
                    (lambda () (subst (dk-cite! 'gns-form-value 'a 'f d d)) (dk-ass!)))
                  (dk-cite! 'form-null-in g4n-md g4n-B d)
                  (dk-have! (list 'IN dmd g4n-N) (lambda () (subst (list '= dmd d)) (dk-ass!)))
                  (dk-cite! 'qmod-related-in g4n-md g4n-N 'b 'c)
                  (dk-ass!))
                ;; =>
                (let* ((o (dk-cite! 'qmod-related-out g4n-md g4n-N 'b 'c))
                       (o2 (dk-rewrite-h! o dmd d))
                       (pr (dk-cite! 'form-null-out g4n-md g4n-B d)))
                  (dk-split! pr)
                  (dk-cite! 'gns-form-value 'a 'f d d)
                  (subst (list '= (list 'f dq) (list g4n-B d d)))
                  (dk-ass!))))))
    (dk-opened (lambda () (di)))))
(g4n-qed! 'gns-related-iff)

;;; ---- the pre-Hilbert space H0 = GNS-PRE(a, phi): its vectors and its inner product
(define g4n-QM (list 'QUOTIENT-MODULE g4n-md g4n-N))
(define g4n-G (list 'FORM-QIP g4n-md g4n-B))
(define (g4n-hsetup!)
  (g4n-qsetup!)
  (dk-cite! 'quotient-module-is-module g4n-md g4n-N)
  (dk-cite! 'qmod-ro-vec g4n-md g4n-N)
  (dk-cite! 'form-qip-type g4n-md g4n-B)
  (let ((g (list 'IN g4n-G (list 'FUN (list 'CARTESIAN (list 'VEC g4n-QM) (list 'VEC g4n-QM)) 'CC))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (subst (list '= (list 'VEC g4n-QM) (list 'QUOTIENT g4n-Su))) (dk-ass!))))))
(define (g4n-pre-ro! acc ro val)
  (sp (g4n-st (list '== (list acc g4n-H) val)))
  (dk-peel!)
  (g4n-hsetup!)
  (mac 'GNS-PRE) (mac 'FORM-QUOTIENT)
  (subst (g4n-cite*! ro g4n-QM g4n-G))
  (if (and (not (proof-done? *ps*)) (g4n-occurs? (list 'VEC g4n-QM) (dk-goal)))
      (subst (list '= (list 'VEC g4n-QM) (list 'QUOTIENT g4n-Su))))
  (if (and (not (proof-done? *ps*)) (g4n-occurs? g4n-S (dk-goal))) (mac 'GNS-SETOID))
  (if (not (proof-done? *ps*)) (qrfl)))
(g4n-pre-ro! 'VEC 'module-with-form-vec (list 'QUOTIENT g4n-S))
(g4n-qed! 'gns-pre-vec)
(g4n-pre-ro! 'IP 'module-with-form-ip g4n-G)
(g4n-qed! 'gns-pre-ip)

(define (g4n-pts! t)     ; (IN t (PTS S)) from (IN t (VEC a)); gns-setoid-pts in context
  (g4n-vt! t)
  (let ((g (list 'IN t (list 'PTS g4n-S))))
    (if (not (dk-asm? g)) (dk-have! g (lambda () (subst (list '= (list 'PTS g4n-S) '(VEC a))) (dk-ass!))))
    g))
(define (g4n-ssetup!)
  (g4n-qsetup!)
  (dk-cite! 'gns-setoid-is-setoid 'a 'f)
  (dk-cite! 'gns-setoid-pts 'a 'f))
;;; B from A by an IFF in context, on a lane
(define (g4n-iff! iff from)
  (let ((other (if (alpha-equiv? (cadr iff) from) (caddr iff) (cadr iff))))
    (if (not (dk-asm? other)) (dk-have! other (lambda () (keep iff from) (prop))))
    other))

;;; <[b] | [c]> = phi(c* b)
(sp (g4n-st (list 'FORALL 'b (list 'IMPLIES '(IN b (VEC a)) (list 'FORALL 'c (list 'IMPLIES '(IN c (VEC a))
  (list '= (list (list 'IP g4n-H) (g4n-cl 'b) (g4n-cl 'c)) (list 'f (g4n-q 'c 'b)))))))))
(dk-peel!)
(g4n-hsetup!)
(subst (dk-cite! 'gns-pre-ip 'a 'f))
(mac 'GNS-SETOID)
(g4n-vmd! 'b) (g4n-vmd! 'c)
(subst (g4n-cite*! 'form-qip-computes g4n-md g4n-B 'b 'c))
(g4n-cv! (g4n-q 'c 'b))
(subst (dk-cite! 'gns-form-value 'a 'f 'b 'c))
(g4n-close-eq!)
(g4n-qed! 'gns-ip-computes)

;;; ---- the operators pi(x) = DESCEND(S, b |-> [x b])
(define (g4n-F x) (list 'VNB-LAMBDA 'g4gb_ '(VEC a) (g4n-cl (g4n-mu x 'g4gb_))))
(sp (g4n-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list 'AND (list 'IN (g4n-F 'x) (list 'FUN (list 'PTS g4n-S) (list 'QUOTIENT g4n-S)))
             (list 'RESPECTS g4n-S (g4n-F 'x)))))))
(dk-peel!)
(g4n-ssetup!)
(let ((F (g4n-F 'x)))
  (dk-have! (list 'IN F (list 'FUN (list 'PTS g4n-S) (list 'QUOTIENT g4n-S)))
    (lambda ()
      (subst (list '= (list 'PTS g4n-S) '(VEC a)))
      (dk-lam-type!
        (lambda ()
          (dk-peel!)
          (let ((t (caddr (cadr (dk-goal)))))
            (g4n-pts! t)
            (g4n-cite*! 'class-in-quotient g4n-S t)
            (dk-ass!)))
        (lambda () (dk-cite! 'fun-domain-in-set '(VEC a) 'CC 'f) (dk-ass!)))))
  (let* ((iff (dk-cite! 'respects-unfold g4n-S F)) (rhs (caddr iff)))
    (dk-have! rhs
      (lambda ()
        (dk-peel!)
        (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
        (let* ((g (dk-goal)) (u (cadr (cadr g))) (w (cadr (caddr g)))
               (rel (list 'RELATED g4n-S u w)) (d (g4n-sb u w))
               (xu (g4n-mu 'x u)) (xw (g4n-mu 'x w)) (e (g4n-sb xu xw)))
          (for-each (lambda (t) (dk-have! (list 'IN t '(VEC a)) (lambda () (subst (list '= '(VEC a) (list 'PTS g4n-S))) (dk-ass!))))
                    (list u w))
          (dk-lam-b!)
          (g4n-vt! d) (g4n-vt! xu) (g4n-vt! xw) (g4n-vt! e) (g4n-vt! (g4n-mu 'x d))
          (g4n-cv! (g4n-q d d))
          (g4n-iff! (g4n-cite*! 'gns-related-iff 'a 'f u w) rel)
          (let* ((nd (g4n-cite*! 'gns-null-invariant 'a 'f 'x d)))
            (g4n-alg! (list '= (g4n-mu 'x d) e))
            (dk-rewrite-h! nd (g4n-mu 'x d) e)
            (g4n-cv! (g4n-q e e))
            (let ((rel2 (g4n-iff! (g4n-cite*! 'gns-related-iff 'a 'f xu xw) (list '= (list 'f (g4n-q e e)) 0))))
              (g4n-pts! xu) (g4n-pts! xw)
              (let ((i3 (g4n-cite*! 'class-eq-iff g4n-S xu xw)))
                (keep i3 rel2)
                (prop)))))))
    (dk-have! (list 'RESPECTS g4n-S F) (lambda () (keep iff rhs) (prop)))
    (dk-conj-close! (lambda () (dk-ass!)))))
(g4n-qed! 'gns-op-ok)

(define (g4n-op x) (list 'GNS-OP 'a 'f x))
(define g4n-xi '(GNS-VECTOR a f))
(define g4n-one '(VONE a))

;;; pi(x)[b] = [x b]
(sp (g4n-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'FORALL 'b (list 'IMPLIES '(IN b (VEC a))
  (list '= (list (g4n-op 'x) (g4n-cl 'b)) (g4n-cl (g4n-mu 'x 'b)))))))))
(dk-peel!)
(g4n-ssetup!)
(g4n-pts! 'b)
(g4n-cite*! 'gns-op-ok 'a 'f 'x)
(mac 'GNS-OP)
(subst (g4n-cite*! 'descend-computes g4n-S (list 'QUOTIENT g4n-S) (g4n-F 'x) 'b))
(if (not (proof-done? *ps*)) (dk-lam-b!))
(g4n-close-eq!)
(g4n-qed! 'gns-op-computes)

;;; pi(x) maps H0 into H0
(sp (g4n-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list 'IN (g4n-op 'x) (list 'FUN (list 'VEC g4n-H) (list 'VEC g4n-H)))))))
(dk-peel!)
(g4n-ssetup!)
(subst (dk-cite! 'gns-pre-vec 'a 'f))
(g4n-cite*! 'gns-op-ok 'a 'f 'x)
(mac 'GNS-OP)
(g4n-cite*! 'descend-in-fun g4n-S (list 'QUOTIENT g4n-S) (g4n-F 'x))
(dk-ass!)
(g4n-qed! 'gns-op-type)

;;; xi = [1] is a vector of H0
(sp (g4n-st (list 'IN g4n-xi (list 'VEC g4n-H))))
(dk-peel!)
(g4n-ssetup!)
(subst (dk-cite! 'gns-pre-vec 'a 'f))
(mac 'GNS-VECTOR)
(g4n-pts! g4n-one)
(g4n-cite*! 'class-in-quotient g4n-S g4n-one)
(dk-ass!)
(g4n-qed! 'gns-vector-in)

;;; (87): phi(x) = <pi(x) xi | xi>
(sp (g4n-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list '= (list 'f 'x) (list (list 'IP g4n-H) (list (g4n-op 'x) g4n-xi) g4n-xi))))))
(dk-peel!)
(g4n-ssetup!)
(mac 'GNS-VECTOR)
(g4n-vt! g4n-one)
(subst (g4n-cite*! 'gns-op-computes 'a 'f 'x g4n-one))
(g4n-alg! (list '= (g4n-mu 'x g4n-one) 'x))
(g4n-rw! (g4n-mu 'x g4n-one) 'x)
(subst (g4n-cite*! 'gns-ip-computes 'a 'f 'x g4n-one))
(g4n-vt! (g4n-q g4n-one 'x))
(g4n-alg! (list '= (g4n-q g4n-one 'x) 'x))
(g4n-rw! (g4n-q g4n-one 'x) 'x)
(g4n-close-eq!)
(g4n-qed! 'gns-represents)

;;; a vector u of H0 as [b]: lands b in VEC a and u = [b], rewrites u in the goal
(define (g4n-rep! u)
  (let ((g (list 'IN u (list 'QUOTIENT g4n-S))))
    (if (not (dk-asm? g)) (dk-have! g (lambda () (subst (list '= (list 'QUOTIENT g4n-S) (list 'VEC g4n-H))) (dk-ass!))))
    (let* ((ex (g4n-cite*! 'quotient-rep g4n-S u))
           (b (dk-skolem! ex)))
      (dk-have! (list 'IN b '(VEC a)) (lambda () (subst (list '= '(VEC a) (list 'PTS g4n-S))) (dk-ass!)))
      (subst (list '= u (g4n-cl b)))
      b)))
(define (g4n-vsetup!) (g4n-ssetup!) (dk-cite! 'gns-pre-vec 'a 'f))

;;; every vector of H0 is pi(b) xi: xi is cyclic for pi on H0
(sp (g4n-st (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u (list 'VEC g4n-H))
  (list 'FORSOME 'b (list 'AND '(IN b (VEC a)) (list '= 'u (list (g4n-op 'b) g4n-xi))))))))
(dk-peel!)
(g4n-vsetup!)
(let ((w (g4n-rep! 'u)))
  (ew w)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (dk-ass!)
          (begin
            (mac 'GNS-VECTOR)
            (g4n-vt! g4n-one)
            (subst (g4n-cite*! 'gns-op-computes 'a 'f w g4n-one))
            (g4n-alg! (list '= (g4n-mu w g4n-one) w))
            (g4n-rw! (g4n-mu w g4n-one) w)
            (g4n-close-eq!))))))
(g4n-qed! 'gns-cyclic)

;;; <pi(x) u | w> = <u | pi(x*) w>
(sp (g4n-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u (list 'VEC g4n-H)) (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w (list 'VEC g4n-H))
    (list '= (list (list 'IP g4n-H) (list (g4n-op 'x) 'u) 'w)
             (list (list 'IP g4n-H) 'u (list (g4n-op (g4n-sr 'x)) 'w)))))))))))
(dk-peel!)
(g4n-vsetup!)
(let* ((b (g4n-rep! 'u)) (c (g4n-rep! 'w)) (xs (g4n-sr 'x)))
  (g4n-vt! xs)
  (subst (g4n-cite*! 'gns-op-computes 'a 'f 'x b))
  (subst (g4n-cite*! 'gns-op-computes 'a 'f xs c))
  (g4n-vt! (g4n-mu 'x b)) (g4n-vt! (g4n-mu xs c))
  (subst (g4n-cite*! 'gns-ip-computes 'a 'f (g4n-mu 'x b) c))
  (subst (g4n-cite*! 'gns-ip-computes 'a 'f b (g4n-mu xs c)))
  (let ((l (g4n-q c (g4n-mu 'x b))) (r (g4n-q (g4n-mu xs c) b)))
    (g4n-vt! l) (g4n-vt! r)
    (g4n-alg! (list '= r l))
    (g4n-rw! r l)
    (g4n-close-eq!)))
(g4n-qed! 'gns-op-adjoint)

;;; pi(x y) = pi(x) pi(y), pi(1) = id, pointwise on H0
(sp (g4n-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list 'FORALL 'y (list 'IMPLIES '(IN y (VEC a))
  (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u (list 'VEC g4n-H))
    (list '= (list (g4n-op (g4n-mu 'x 'y)) 'u) (list (g4n-op 'x) (list (g4n-op 'y) 'u)))))))))))
(dk-peel!)
(g4n-vsetup!)
(let* ((b (g4n-rep! 'u)) (yb (g4n-mu 'y b)) (xy (g4n-mu 'x 'y)))
  (g4n-vt! yb) (g4n-vt! xy)
  (subst (g4n-cite*! 'gns-op-computes 'a 'f 'y b))
  (subst (g4n-cite*! 'gns-op-computes 'a 'f 'x yb))
  (subst (g4n-cite*! 'gns-op-computes 'a 'f xy b))
  (g4n-vt! (g4n-mu xy b)) (g4n-vt! (g4n-mu 'x yb))
  (g4n-alg! (list '= (g4n-mu xy b) (g4n-mu 'x yb)))
  (g4n-rw! (g4n-mu xy b) (g4n-mu 'x yb))
  (g4n-close-eq!))
(g4n-qed! 'gns-op-mul)

(sp (g4n-st (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u (list 'VEC g4n-H))
  (list '= (list (g4n-op g4n-one) 'u) 'u)))))
(dk-peel!)
(g4n-vsetup!)
(let* ((b (g4n-rep! 'u)))
  (g4n-vt! g4n-one)
  (subst (g4n-cite*! 'gns-op-computes 'a 'f g4n-one b))
  (g4n-vt! (g4n-mu g4n-one b))
  (g4n-alg! (list '= (g4n-mu g4n-one b) b))
  (g4n-rw! (g4n-mu g4n-one b) b)
  (g4n-close-eq!))
(g4n-qed! 'gns-op-unit)

;;; <pi(x) u | pi(x) u> <= ||x||^2 <u | u>   (the estimate behind Theorem 4.13's ||pi(x)|| <= ||x||)
(sp (g4n-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u (list 'VEC g4n-H))
    (list '<= (list (list 'IP g4n-H) (list (g4n-op 'x) 'u) (list (g4n-op 'x) 'u))
              (list '* (list '* '((VNRM a) x) '((VNRM a) x)) (list (list 'IP g4n-H) 'u 'u)))))))))
(dk-peel!)
(g4n-vsetup!)
(let* ((b (g4n-rep! 'u)) (xb (g4n-mu 'x b)) (xx (g4n-q 'x 'x)) (q (g4n-q xb xb)) (qb (g4n-q b b))
       (sw (g4n-mu (g4n-mu (g4n-sr b) xx) b)) (nx '((VNRM a) x)) (nxx (list '(VNRM a) xx))
       (fq (list 'f q)) (P (list 'f qb)) (nn (list '* nx nx)))
  (g4n-vt! xb) (g4n-vt! xx) (g4n-vt! q) (g4n-vt! qb) (g4n-vt! sw)
  (subst (g4n-cite*! 'gns-op-computes 'a 'f 'x b))
  (subst (g4n-cite*! 'gns-ip-computes 'a 'f xb xb))
  (subst (g4n-cite*! 'gns-ip-computes 'a 'f b b))
  (g4n-alg! (list '= sw q))
  (let* ((h (dk-cite! 'pos-lf-sandwich-bound 'a 'f xx b))
         (h1 (dk-rewrite-h! h sw q)))
    (dk-split! (dk-apply! g4n-pos xb))
    (dk-split! (dk-apply! g4n-pos b))
    (dk-split! (dk-cite! 'uiba-vnrm-real 'a xx))
    (dk-split! (dk-cite! 'uiba-vnrm-real 'a 'x))
    (dk-cite! 'rr-magnitude-is-abs fq) (dk-cite! 'rr-abs-of-nonneg fq)
    (dk-rewrite-h! (dk-rewrite-h! h1 (list 'MAGNITUDE fq) (list 'ABS fq)) (list 'ABS fq) fq)
    (dk-cite! 'uiba-star-mul-le 'a 'x)
    (dk-real! nn)
    (g4n-cite*! 'rr-mul-le-right nxx nn P)
    (dk-le-trans! fq (list '* nxx P) (list '* nn P))
    (dk-ass!)))
(g4n-qed! 'gns-op-bounded)

;;; ---- the linear structure of H0 on classes
(g4n-pre-ro! 'VADD 'module-with-form-vadd (list 'VADD g4n-QM))
(g4n-qed! 'gns-pre-vadd)
(g4n-pre-ro! 'ACT 'module-with-form-act (list 'ACT g4n-QM))
