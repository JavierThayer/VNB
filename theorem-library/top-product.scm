(define (ty-box-elim! y bb)            ; (IN y (BOX bb)) in context: y in P and the constraint clause
  (let* ((i (dk-cite! 'tprod-box-mem 'ix 'tf bb y)) (r (caddr i)))
    (if (not (dk-asm? (caddr r)))
        (begin (dk-have! r (lambda () (if (dk-only! i (list 'IN y (ty-box bb))) (prop)))) (dk-split! r)))
    (caddr r)))
(define (ty-box-intro! y bb cl!)       ; goal (IN y (BOX bb)); y in P in context; CL! proves the clause goal
  (let* ((i (dk-cite! 'tprod-box-mem 'ix 'tf bb y)) (r (caddr i)))
    (dk-have! (caddr r) cl!)
    (ty-and! (cadr r) (caddr r))
    (if (dk-only! i r) (prop))))
(define (ty-subset! x y memb!)
  (dk-have! (list 'SUBSET x y)
    (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (memb! w)))))

;; fewer constraints, larger box
(sp (make-wff (ty-alls '(ix tf b1 b2) (ty-imps '((SUBSET b1 b2)) (list 'SUBSET (ty-box 'b2) (ty-box 'b1))))))
(dk-peel!)
(ty-subset! (ty-box 'b2) (ty-box 'b1)
  (lambda (y)
    (let ((cl (ty-box-elim! y 'b2)))
      (ty-box-intro! y 'b1 (lambda () (let ((c (dk-di-var!))) (dk-cite! 'subset-mem-fwd 'b1 'b2 c) (dk-apply! cl c) (dk-ass!)))))))
(ty-qed! 'tprod-box-anti)

(define (ty-open-parts! u)            ; IS-TPROD-OPEN(u) in context: its universal part
  (let* ((h (list 'IS-TPROD-OPEN 'ix 'tf u))
         (iff (dk-cite! 'is-tprod-open 'ix 'tf u))
         (rhs (caddr iff)))
    (dk-have! (cadr rhs) (lambda () (mac-h 'IS-TPROD-OPEN (dk-ctx-form h)) (dk-split-all!) (ass)))
    (dk-have! (caddr rhs) (lambda () (mac-h 'IS-TPROD-OPEN (dk-ctx-form h)) (dk-split-all!) (ass)))
    (caddr rhs)))
(define (ty-basic! all x)             ; the finite constraint set bb at x: lands its facts, returns bb
  (dk-skolem! (dk-apply! all x) #t))
(define (ty-finite! bb)               ; bb subset K, CARD bb in NN: bb in SET
  (dk-cite! 'subclass-of-set-is-set bb ty-K))

(sp (make-wff (ty-alls '(ix tf) (ty-imps (list ty-fam) '(IS-TPROD-OPEN ix tf EMPTY-SET)))))
(dk-peel!)
(mac 'is-tprod-open)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'SUBSET)
        (begin (fact 'empty-subset-any ty-P) (dk-ass!))
        (let ((x (dk-di-var!))) (fact 'empty-set-has-no-members x) (pbc) (ai (list 'NOT (list 'IN x 'EMPTY-SET)))))))
(ty-qed! 'tprod-open-empty)

(sp (make-wff (ty-alls '(ix tf) (ty-imps (list ty-fam) (list 'IS-TPROD-OPEN 'ix 'tf ty-P)))))
(dk-peel!)
(ty-sets!)
(fact 'empty-subset-any ty-K)
(fact 'card-empty)
(fact 'nn-zero-in)
(dk-have! '(IN (CARD EMPTY-SET) NN) (lambda () (subst '(= (CARD EMPTY-SET) 0)) (ass)))
(mac 'is-tprod-open)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'SUBSET)
        (begin (fact 'subset-refl ty-P) (dk-ass!))
        (let ((x (dk-di-var!)))
          (ew 'EMPTY-SET)
          (dk-conj-close!
            (lambda ()
              (cond ((dk-ass!) #t)
                    ((dk-head-is? (dk-goal) 'IN)
                     (ty-box-intro! x 'EMPTY-SET (lambda () (let ((c (dk-di-var!))) (fact 'empty-set-has-no-members c) (pbc) (ai (list 'NOT (list 'IN c 'EMPTY-SET)))))))
                    (#t (ty-subset! (ty-box 'EMPTY-SET) ty-P (lambda (y) (ty-box-elim! y 'EMPTY-SET) (dk-ass!)))
                        (dk-ass!)))))))))
(ty-qed! 'tprod-open-whole)

(sp (make-wff (ty-alls '(ix tf u v) (ty-imps (list ty-fam '(IS-TPROD-OPEN ix tf u) '(IS-TPROD-OPEN ix tf v)) '(IS-TPROD-OPEN ix tf (INTERSECTION u v))))))
(dk-peel!)
(ty-sets!)
(let ((au (ty-open-parts! 'u)) (av (ty-open-parts! 'v)))
  (mac 'is-tprod-open)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'SUBSET)
          (begin (mac 'subset-def)
                 (let ((w (dk-di-var!)))
                   (dk-cite! 'intersection-membership 'u 'v w)
                   (dk-cite! 'subset-mem-fwd 'u ty-P w)
                   (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop))))
          (let* ((x (dk-di-var!))
                 (im (dk-cite! 'intersection-membership 'u 'v x)))
            (dk-have! (list 'IN x 'u) (lambda () (if (dk-only! im (list 'IN x '(INTERSECTION u v))) (prop))))
            (dk-have! (list 'IN x 'v) (lambda () (if (dk-only! im (list 'IN x '(INTERSECTION u v))) (prop))))
            (let* ((b1 (ty-basic! au x)) (b2 (ty-basic! av x)) (bb (list 'UNION b1 b2)))
              (ty-finite! b1) (ty-finite! b2)
              (dk-cite! 'card-union-nn b1 b2)
              (ty-subset! bb ty-K (lambda (c) (dk-cite! 'union-membership b1 b2 c) (dk-cite! 'subset-mem-fwd b1 ty-K c) (dk-cite! 'subset-mem-fwd b2 ty-K c)
                                     (if (apply dk-only! (filter (lambda (f) (dk-contains? f c)) (dk-asms))) (prop))))
              (ty-subset! b1 bb (lambda (c) (dk-cite! 'union-membership b1 b2 c) (if (apply dk-only! (filter (lambda (f) (dk-contains? f c)) (dk-asms))) (prop))))
              (ty-subset! b2 bb (lambda (c) (dk-cite! 'union-membership b1 b2 c) (if (apply dk-only! (filter (lambda (f) (dk-contains? f c)) (dk-asms))) (prop))))
              (dk-cite! 'tprod-box-anti 'ix 'tf b1 bb)
              (dk-cite! 'tprod-box-anti 'ix 'tf b2 bb)
              (dk-cite! 'subset-trans (ty-box bb) (ty-box b1) 'u)
              (dk-cite! 'subset-trans (ty-box bb) (ty-box b2) 'v)
              (ew bb)
              (dk-conj-close!
                (lambda ()
                  (cond ((dk-ass!) #t)
                        ((dk-head-is? (dk-goal) 'IN)
                         (let ((c1 (ty-box-elim! x b1)) (c2 (ty-box-elim! x b2)))
                           (ty-box-intro! x bb
                             (lambda () (let* ((c (dk-di-var!)) (um (dk-cite! 'union-membership b1 b2 c)))
                                          (use-em (list 'IN c b1)
                                            (lambda () (dk-apply! c1 c) (dk-ass!))
                                            (lambda () (dk-have! (list 'IN c b2) (lambda () (if (dk-only! um (list 'IN c bb) (list 'NOT (list 'IN c b1))) (prop))))
                                                       (dk-apply! c2 c) (dk-ass!))))))))
                        (#t (mac 'subset-def)
                            (let ((w (dk-di-var!)))
                              (dk-cite! 'subset-mem-fwd (ty-box bb) 'u w)
                              (dk-cite! 'subset-mem-fwd (ty-box bb) 'v w)
                              (dk-cite! 'intersection-membership 'u 'v w)
                              (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop)))))))))))))
(ty-qed! 'tprod-open-inter)

(define (ty-bu-in-imp! w e bu)
  (dk-have! (list 'IMPLIES (list 'IN w e) (list 'IN w bu))
    (lambda () (di) (for-each (lambda (n) (dk-focus! n) (ass)) (dk-opened (lambda () (bu-mi e)))))))
(sp (make-wff (ty-alls '(ix tf fam) (ty-imps (list ty-fam '(FORALL tpo_ (IMPLIES (IN tpo_ fam) (IS-TPROD-OPEN ix tf tpo_))))
                                       '(IS-TPROD-OPEN ix tf (BIG-UNION u fam u))))))
(dk-peel!)
(let ((hall (dk-ctx-form '(FORALL tpo_ (IMPLIES (IN tpo_ fam) (IS-TPROD-OPEN ix tf tpo_)))))
      (bu '(BIG-UNION u fam u)))
  (mac 'is-tprod-open)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'SUBSET)
          (begin
            (mac 'subset-def)
            (let* ((w (dk-di-var!))
                   (landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
                   (e (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'fam))) landed)))))
              (dk-apply! hall e)
              (ty-open-parts! e)
              (dk-cite! 'subset-mem-fwd e ty-P w)
              (dk-ass!)))
          (let* ((x (dk-di-var!))
                 (landed (dk-landed (lambda () (bu-me (list 'IN x bu)))))
                 (e (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'fam))) landed)))))
            (dk-apply! hall e)
            (let* ((ae (ty-open-parts! e)) (bb (ty-basic! ae x)))
              (ty-subset! e bu (lambda (w) (ty-bu-in-imp! w e bu) (dk-only! (list 'IMPLIES (list 'IN w e) (list 'IN w bu))) (prop)))
              (dk-cite! 'subset-trans (ty-box bb) e bu)
              (ew bb)
              (dk-conj-close! dk-ass!)))))))
(ty-qed! 'tprod-open-union)

(define (ty-pow-of-open! x)
  (if (not (dk-asm? (list 'IN x (list 'POWER ty-P))))
      (begin
        (ty-open-parts! x)
        (dk-cite! 'subclass-of-set-is-set x ty-P)
        (let ((s (caddr (dk-cite! 'subset-def x ty-P))))
          (dk-have! s (lambda () (mac-h 'subset-def (list 'SUBSET x ty-P)) (ass))))
        (dk-cite! 'power-mem-intro ty-P x))))
(define (ty-open-of-mem! w)
  (let ((c (list 'IS-TPROD-OPEN 'ix 'tf w)))
    (if (not (dk-asm? c))
        (dk-have! c (lambda () (sep-me (dk-ctx-form (list 'IN w ty-opens))) (dk-split-all!) (ass))))))
(define (ty-into-opens! x) (ty-pow-of-open! x) (in-sep! (lambda () (ass)) (lambda () (ass))))

(sp (make-wff (ty-alls '(ix tf) (ty-imps (list ty-fam) (list 'IS-TOP-SPACE ty-T)))))
(dk-peel!)
(ty-sets!)
(dk-cite! 'tprod-top-pts 'ix 'tf)
(dk-cite! 'tprod-top-opens 'ix 'tf)
(dk-have! (list 'IN ty-opens 'SET) (lambda () (sep-set) (ass)))
(dk-cite! 'empty-set-is-set)
(dk-cite! 'tprod-open-empty 'ix 'tf)
(dk-cite! 'tprod-open-whole 'ix 'tf)
(mac 'is-top-space)
(subst (list '== (list 'PTS ty-T) ty-P))
(subst (list '== (list 'OPENS ty-T) ty-opens))
(dk-conj-close!
  (lambda ()
    (let ((g0 (dk-goal)))
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? g0 '=) (mac 'TPRODUCT-TOP) (len-r) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (arith)))
        ((and (dk-head-is? g0 'IN) (equal? (cadr g0) ty-opens))
         (mac 'power-set-membership)
         (dk-conj-close!
           (lambda ()
             (if (not (dk-ass!))
                 (let ((z (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                   (sep-me (dk-ctx-form (list 'IN z ty-opens))) (dk-split-all!) (ass))))))
        ((and (dk-head-is? g0 'IN) (eq? (cadr g0) 'EMPTY-SET))
         (fact 'empty-subset-any ty-P) (ty-into-opens! 'EMPTY-SET))
        ((and (dk-head-is? g0 'IN) (equal? (cadr g0) ty-P)) (ty-into-opens! ty-P))
        ((dk-contains? g0 'INTERSECTION)
         (let* ((ld (dk-peel!))
                (uv (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) ld)))
                (u (car uv)) (v (cadr uv)))
           (ty-open-of-mem! u) (ty-open-of-mem! v)
           (dk-cite! 'tprod-open-inter 'ix 'tf u v)
           (ty-into-opens! (list 'INTERSECTION u v))))
        (#t
         (let* ((ld (dk-peel!))
                (fv (cadr (car (filter (lambda (f) (dk-head-is? f 'SUBSET)) ld)))))
           (dk-have! (list 'FORALL 'tpo_ (list 'IMPLIES (list 'IN 'tpo_ fv) '(IS-TPROD-OPEN ix tf tpo_)))
             (lambda () (let ((w (dk-di-var!))) (dk-cite! 'subset-mem-fwd fv ty-opens w) (ty-open-of-mem! w) (dk-ass!))))
           (dk-cite! 'tprod-open-union 'ix 'tf fv)
           (ty-into-opens! (list 'BIG-UNION 'u fv 'u))))))))
(ty-qed! 'tprod-top-is-top-space)

;;; ===========================================================================
;;; (3) BOXES ARE OPEN; THE PROJECTIONS ARE CONTINUOUS
;;; ===========================================================================
(sp (make-wff (ty-alls '(ix tf bb) (ty-imps (list ty-fam (list 'SUBSET 'bb ty-K) '(IN (CARD bb) NN)) (list 'IN (ty-box 'bb) (list 'OPENS ty-T))))))
(dk-peel!)
(ty-sets!)
(dk-cite! 'tprod-top-opens 'ix 'tf)
(subst (list '== (list 'OPENS ty-T) ty-opens))
(dk-have! (list 'IS-TPROD-OPEN 'ix 'tf (ty-box 'bb))
  (lambda ()
    (mac 'is-tprod-open)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'SUBSET)
            (begin (mac 'subset-def) (let ((y (dk-di-var!))) (ty-box-elim! y 'bb) (dk-ass!)))
            (let ((x (dk-di-var!)))
              (fact 'subset-refl (ty-box 'bb))
              (ew 'bb) (dk-conj-close! dk-ass!)))))))
(ty-subset! (ty-box 'bb) ty-P (lambda (y) (ty-box-elim! y 'bb) (dk-ass!)))
(ty-into-opens! (ty-box 'bb))
(ty-qed! 'tprod-box-open)

;; [i, v] is a constraint when v is open in the i-th factor; the box of {[i, v]} is open
(define (ty-constr-in! i v)
  (let ((b (list 'LIST i v)))
    (if (not (dk-asm? (list 'IN b ty-K)))
        (let ((s (ty-factor! i)))
          (dk-have! (list 'IN v ty-BUO) (lambda () (for-each (lambda (l) (dk-focus! l) (if (not (dk-ass!)) (begin (nt-free-nth!) (dk-ass!)))) (dk-opened (lambda () (bu-mi i))))))
          (dk-cite! 'pair-in-cartesian 'ix ty-BUO i v)
          (let ((im (dk-cite! 'tprod-constr-mem 'ix 'tf b)))
            (dk-have! (caddr (caddr im)) (lambda () (ty-nth-all!) (dk-ass!)))
            (dk-have! (list 'IN b ty-K) (lambda () (if (dk-only! im (list 'IN b (list 'CARTESIAN 'ix ty-BUO)) (caddr (caddr im))) (prop)))))))
    b))
(define (nt-free-nth!) #t)
(define (ty-single! b)                 ; b in K: (PAIR b b) subset K, its CARD in NN; returns (PAIR b b)
  (let ((sb (list 'PAIR b b)))
    (dk-cite! 'membership-implies-sethood b ty-K)
    (ty-and! (list 'IN b 'SET) (list 'IN b 'SET))
    (dk-cite! 'pairing b b)
    (dk-cite! 'card-singleton b)
    (fact 'nn-zero-in)
    (dk-cite! 'nn-succ-closed 0)
    (dk-have! (list 'IN (list 'CARD sb) 'NN) (lambda () (subst (list '= (list 'CARD sb) '(succ 0))) (ass)))
    (ty-subset! sb ty-K (lambda (c) (dk-cite! 'pair-self-eq b c) (subst (list '= c b)) (dk-ass!)))
    (dk-cite! 'pair-self-member b)
    sb))

(define (ty-coord! y i)                ; y in P, i in ix: (IN (y i) (PTS (tf i)))
  (let ((ty (list 'IN (list y i) (list 'PTS (list 'tf i)))))
    (if (not (dk-asm? ty))
        (let* ((im (dk-cite! 'tprod-pts-mem 'ix 'tf y)) (r (caddr im)))
          (dk-have! (caddr r) (lambda () (if (dk-only! im (list 'IN y ty-P)) (prop))))
          (dk-apply! (caddr r) i)))
    ty))

(sp (make-wff (ty-alls '(ix tf i y) (ty-imps (list ty-fam '(IN i ix) (list 'IN 'y ty-P)) '(= ((TPROJ ix tf i) y) (y i))))))
(dk-peel!)
(ty-coord! 'y 'i)
(mac 'TPROJ)
(dk-lam-b!)
(if (not (proof-done? *ps*)) (rfl))
(ty-qed! 'tproj-value)

(sp (make-wff (ty-alls '(ix tf i) (ty-imps (list ty-fam '(IN i ix)) (list 'IS-HOM-TOP-SPACE ty-T '(tf i) '(TPROJ ix tf i))))))
(dk-peel!)
(ty-sets!)
(ty-factor! 'i)
(dk-cite! 'tprod-top-is-top-space 'ix 'tf)
(dk-cite! 'tprod-top-pts 'ix 'tf)
(let ((pj '(TPROJ ix tf i)))
  (mac 'is-hom-top-space-def)
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? (dk-goal) 'IN)
         (subst (list '== (list 'PTS ty-T) ty-P))
         (mac 'TPROJ)
         (dk-lam-type! (lambda () (let ((y (dk-di-var!))) (ty-coord! y 'i) (dk-ass!))) (lambda () (ass))))
        (#t
         (let* ((v (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(OPENS (tf i))))) (dk-peel!))))
                (b (ty-constr-in! 'i v))
                (sb (ty-single! b))
                (pre (list 'PREIMAGE ty-T pj v)))
           (dk-cite! 'tprod-box-open 'ix 'tf sb)
           (dk-have! (list 'FORALL 'tpz_ (list 'IFF (list 'IN 'tpz_ pre) (list 'IN 'tpz_ (ty-box sb))))
             (lambda ()
               (let ((y (begin (di) (cadr (cadr (dk-goal))))))
                 (dk-iff! (lambda (g) (equal? g (list 'IN y (ty-box sb))))
                   (lambda ()
                     (let ((pm (dk-cite! 'preimage-membership ty-T pj v y)))
                       (dk-have! (caddr pm) (lambda () (if (dk-only! pm (list 'IN y pre)) (prop))))
                       (dk-split! (caddr pm))
                       (dk-rewrite-h! (list 'IN y (list 'PTS ty-T)) (list 'PTS ty-T) ty-P)
                       (dk-cite! 'tproj-value 'ix 'tf 'i y)
                       (dk-rewrite-h! (list 'IN (list pj y) v) (list pj y) (list y 'i))
                       (ty-box-intro! y sb
                         (lambda () (let ((c (dk-di-var!))) (dk-cite! 'pair-self-eq b c) (subst (list '= c b)) (ty-nth-all!) (dk-ass!))))))
                   (lambda ()
                     (let ((cl (ty-box-elim! y sb)))
                       (dk-apply! cl b)
                       (ty-nth-h! (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (dk-contains? f 'NTH) (dk-contains? f y))) "the constraint"))
                       (dk-cite! 'tproj-value 'ix 'tf 'i y)
                       (let ((pm (dk-cite! 'preimage-membership ty-T pj v y)))
                         (dk-have! (list 'IN y (list 'PTS ty-T)) (lambda () (subst (list '== (list 'PTS ty-T) ty-P)) (ass)))
                         (dk-have! (list 'IN (list pj y) v) (lambda () (subst (list '= (list pj y) (list y 'i))) (ass)))
                         (if (dk-only! pm (list 'IN y (list 'PTS ty-T)) (list 'IN (list pj y) v)) (prop)))))))))
           (dk-cite! 'class-extensionality pre (ty-box sb))
           (subst (list '= pre (ty-box sb)))
           (dk-ass!)))))))
(ty-qed! 'tproj-continuous)

;;; ===========================================================================
;;; (4) THE UNIVERSAL PROPERTY: f into the product is continuous iff every coordinate x |-> f(x)(k) is
;;; ===========================================================================
;; a set containing an open neighbourhood of each of its points is open: top-open-of-local (tvs-kernel-closed), CITED


(define (ty-coordmap k) (list 'VNB-LAMBDA 'tpq_ '(PTS z) (list '(f tpq_) k)))
(define ty-coordcl '(FORALL tpk_ (IMPLIES (IN tpk_ ix) (IS-HOM-TOP-SPACE z (tf tpk_) (VNB-LAMBDA tpq_ (PTS z) ((f tpq_) tpk_))))))
(define (ty-cmval! k q)                ; q in PTS z, k in ix: (= ((coordmap k) q) ((f q) k)); returns it
  (let ((e (list '= (list (ty-coordmap k) q) (list (list 'f q) k))))
    (if (not (dk-asm? e))
        (begin
          (dk-cite! 'fun-apply-type-c 'f '(PTS z) ty-P q)
          (ty-coord! (list 'f q) k)
          (dk-have! e (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))))
    e))

;; finitely many coordinate constraints satisfied at a are satisfied on an open neighbourhood of a
(define (ty-nbhd-body g)
  (list 'IMPLIES (list 'SUBSET g 'bb)
    (list 'FORSOME 'tpw_ (list 'AND '(IN tpw_ (OPENS z)) (list 'AND '(IN a tpw_)
      (list 'FORALL 'tpp_ (list 'IMPLIES '(IN tpp_ tpw_) (list 'FORALL 'tpc_ (list 'IMPLIES (list 'IN 'tpc_ g)
        '(IN ((f tpp_) (NTH 1 tpc_)) (NTH 2 tpc_)))))))))))
(define ty-nbhd-cls (list 'COMP 'tpg_ (ty-nbhd-body 'tpg_)))
(sp (make-wff (ty-alls '(ix tf z f a bb)
  (ty-imps (list ty-fam '(IS-TOP-SPACE z) (list 'IN 'f (list 'FUN '(PTS z) ty-P)) ty-coordcl '(IN a (PTS z))
                 (list 'SUBSET 'bb ty-K) '(IN bb SET) '(IN (CARD bb) NN)
                 '(FORALL tpc_ (IMPLIES (IN tpc_ bb) (IN ((f a) (NTH 1 tpc_)) (NTH 2 tpc_)))))
    (caddr (ty-nbhd-body 'bb))))))
(dk-peel!)
(ty-sets!)
(dk-project! '(IN (PTS z) (OPENS z)) 'is-top-space '(IS-TOP-SPACE z))
(let ((inter (dk-project! '(FORALL u (IMPLIES (IN u (OPENS z)) (FORALL v (IMPLIES (IN v (OPENS z)) (IN (INTERSECTION u v) (OPENS z))))))
                          'is-top-space '(IS-TOP-SPACE z)))
      (cc (dk-ctx-form ty-coordcl))
      (atf (dk-ctx-form '(FORALL tpc_ (IMPLIES (IN tpc_ bb) (IN ((f a) (NTH 1 tpc_)) (NTH 2 tpc_))))))
      (base (list 'IN 'EMPTY-SET ty-nbhd-cls))
      (step (list 'FORALL 'tps_ (list 'IMPLIES (list 'AND '(IN tps_ SET) (list 'AND '(IN (CARD tps_) NN) (list 'IN 'tps_ ty-nbhd-cls)))
              (list 'FORALL 'tpx_ (list 'IMPLIES '(AND (IN tpx_ SET) (NOT (IN tpx_ tps_))) (list 'IN '(UNION tps_ (PAIR tpx_ tpx_)) ty-nbhd-cls)))))))
  (dk-have! base
    (lambda ()
      (for-each
        (lambda (l)
          (dk-focus! l)
          (if (dk-head-is? (dk-goal) 'IN)
              (begin (fact 'empty-set-is-set) (ass))
              (begin
                (di)
                (ew '(PTS z))
                (dk-conj-close!
                  (lambda ()
                    (if (not (dk-ass!))
                        (let* ((ld (dk-peel!))
                               (c (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'EMPTY-SET))) ld))))
                          (pbc) (fact 'empty-set-has-no-members c) (ai (list 'NOT (list 'IN c 'EMPTY-SET))))))))))
        (dk-opened (lambda () (comp-mi))))))
  (dk-have! step
    (lambda ()
      (dk-peel!)
      (dk-split-all!)
      (let* ((g0 (dk-goal)) (un (cadr g0)) (s (cadr un)) (x (cadr (caddr un))) (px (list 'PAIR x x)))
        (ty-and! (list 'IN x 'SET) (list 'IN x 'SET))
        (fact 'pairing x x)
        (ty-and! (list 'IN s 'SET) (list 'IN px 'SET))
        (fact 'union-set-closure s px)
        (dk-cite! 'pair-self-member x)
        (comp-me (list 'IN s ty-nbhd-cls))
        (let ((ih (dk-pick (lambda (h) (and (dk-head-is? h 'IMPLIES) (dk-head-is? (cadr h) 'SUBSET) (equal? (cadr (cadr h)) s))) "IH")))
          (for-each
            (lambda (l)
              (dk-focus! l)
              (if (dk-head-is? (dk-goal) 'IN)
                  (ass)
                  (begin
                    (di)
                    (ty-subset! s un (lambda (q) (dk-cite! 'union-membership s px q) (if (apply dk-only! (filter (lambda (h) (dk-contains? h q)) (dk-asms))) (prop))))
                    (dk-cite! 'subset-trans s un 'bb)
                    (detach! ih)
                    (let* ((w1 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'tpw_) (dk-contains? h s))) "IH result") #t))
                           (t1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h w1) (dk-contains? h s))) "IH tail")))
                      (let ((im (dk-cite! 'union-membership s px x)))
                        (dk-have! (list 'IN x un) (lambda () (if (dk-only! im (list 'IN x px)) (prop)))))
                      (dk-cite! 'subset-mem-fwd un 'bb x)
                      (dk-cite! 'subset-mem-fwd 'bb ty-K x)
                      (let* ((k (list 'NTH 1 x)) (v (list 'NTH 2 x))
                             (cm (dk-cite! 'tprod-constr-mem 'ix 'tf x)))
                        (dk-have! (caddr cm) (lambda () (if (dk-only! cm (list 'IN x ty-K)) (prop))))
                        (dk-split! (caddr cm))
                        (dk-split-all! (list (dk-cite! 'cartesian-nth x 'ix ty-BUO)))
                        (dk-apply! cc k)
                        (let* ((g (ty-coordmap k)) (hom (list 'IS-HOM-TOP-SPACE 'z (list 'tf k) g))
                               (pre (dk-project! (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u (list 'OPENS (list 'tf k))) (list 'IN (list 'PREIMAGE 'z g 'u) '(OPENS z))))
                                                 'is-hom-top-space-def hom))
                               (pg (list 'PREIMAGE 'z g v))
                               (w (list 'INTERSECTION w1 pg)))
                          (dk-apply! pre v)
                          (dk-apply! atf x)
                          (ty-cmval! k 'a)
                          (let ((pm (dk-cite! 'preimage-membership 'z g v 'a)))
                            (dk-have! (list 'IN (list g 'a) v) (lambda () (subst (list '= (list g 'a) (list '(f a) k))) (ass)))
                            (dk-have! (list 'IN 'a pg) (lambda () (if (dk-only! pm '(IN a (PTS z)) (list 'IN (list g 'a) v)) (prop)))))
                          (dk-apply! inter w1 pg)
                          (let ((ima (dk-cite! 'intersection-membership w1 pg 'a)))
                            (dk-have! (list 'IN 'a w) (lambda () (if (dk-only! ima (list 'IN 'a w1) (list 'IN 'a pg)) (prop)))))
                          (ew w)
                          (dk-conj-close!
                            (lambda ()
                              (if (not (dk-ass!))
                                  (let* ((ld (dk-peel!))
                                         (q (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) w))) ld)))
                                         (c (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) un))) ld)))
                                         (imq (dk-cite! 'intersection-membership w1 pg q)))
                                    (dk-have! (list 'IN q w1) (lambda () (if (dk-only! imq (list 'IN q w)) (prop))))
                                    (dk-have! (list 'IN q pg) (lambda () (if (dk-only! imq (list 'IN q w)) (prop))))
                                    (let ((pmq (dk-cite! 'preimage-membership 'z g v q)))
                                      (dk-have! (caddr pmq) (lambda () (if (dk-only! pmq (list 'IN q pg)) (prop))))
                                      (dk-split! (caddr pmq)))
                                    (ty-cmval! k q)
                                    (dk-rewrite-h! (list 'IN (list g q) v) (list g q) (list (list 'f q) k))
                                    (let ((umc (dk-cite! 'union-membership s px c)))
                                      (use-em (list 'IN c s)
                                        (lambda () (dk-apply! t1 q c) (dk-ass!))
                                        (lambda ()
                                          (dk-have! (list 'IN c px) (lambda () (if (dk-only! umc (list 'IN c un) (list 'NOT (list 'IN c s))) (prop))))
                                          (dk-cite! 'pair-self-eq x c)
                                          (subst (list '= c x))
                                          (dk-ass!))))))))))))))
            (dk-opened (lambda () (comp-mi))))))))
  (ty-and! base step)
  (let* ((ind (dk-fact! 'finite-set-induction ty-nbhd-cls)))
    (ty-and! '(IN bb SET) '(IN (CARD bb) NN))
    (let ((int (dk-apply! ind 'bb)))
      (comp-me int)
      (dk-cite! 'subset-refl 'bb)
      (detach! (dk-pick (lambda (h) (and (dk-head-is? h 'IMPLIES) (dk-contains? h 'tpw_) (equal? (cadr h) '(SUBSET bb bb)))) "the instance"))
      (dk-ass!))))
(ty-qed! 'tprod-coord-nbhd)

(sp (make-wff (ty-alls '(ix tf z f)
  (ty-imps (list ty-fam '(IS-TOP-SPACE z) (list 'IN 'f (list 'FUN '(PTS z) ty-P)))
    (list 'IFF (list 'IS-HOM-TOP-SPACE 'z ty-T 'f) ty-coordcl)))))
(dk-peel!)
(ty-sets!)
(dk-cite! 'tprod-top-is-top-space 'ix 'tf)
(dk-cite! 'tprod-top-pts 'ix 'tf)
(dk-cite! 'tprod-top-opens 'ix 'tf)
(dk-project! '(IN (OPENS z) (POWER (POWER (PTS z)))) 'is-top-space '(IS-TOP-SPACE z))
(dk-iff! (lambda (g) (dk-head-is? g 'FORALL))
  ;; continuous => every coordinate continuous
  (lambda ()
    (let ((pref (dk-project! (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u (list 'OPENS ty-T)) '(IN (PREIMAGE z f u) (OPENS z))))
                             'is-hom-top-space-def (list 'IS-HOM-TOP-SPACE 'z ty-T 'f))))
      (let* ((k (dk-di-var!)) (g (ty-coordmap k)))
        (ty-factor! k)
        (mac 'is-hom-top-space-def)
        (dk-conj-close!
          (lambda ()
            (cond
              ((dk-ass!) #t)
              ((dk-head-is? (dk-goal) 'IN)
               (dk-lam-type! (lambda () (let ((q (dk-di-var!))) (dk-cite! 'fun-apply-type-c 'f '(PTS z) ty-P q) (ty-coord! (list 'f q) k) (dk-ass!)))
                             (lambda () (dk-project! '(IN (PTS z) (OPENS z)) 'is-top-space '(IS-TOP-SPACE z))
                                        (dk-cite! 'membership-implies-sethood '(PTS z) '(OPENS z)) (dk-ass!))))
              (#t
               (let* ((v (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (list 'OPENS (list 'tf k))))) (dk-peel!))))
                      (b (ty-constr-in! k v))
                      (sb (ty-single! b))
                      (bx (ty-box sb))
                      (pg (list 'PREIMAGE 'z g v))
                      (pf (list 'PREIMAGE 'z 'f bx)))
                 (dk-cite! 'tprod-box-open 'ix 'tf sb)
                 (dk-apply! pref bx)
                 (dk-have! (list 'FORALL 'tpz_ (list 'IFF (list 'IN 'tpz_ pg) (list 'IN 'tpz_ pf)))
                   (lambda ()
                     (let ((q (begin (di) (cadr (cadr (dk-goal))))))
                       (dk-iff! (lambda (gg) (equal? gg (list 'IN q pf)))
                         (lambda ()
                           (let ((pm (dk-cite! 'preimage-membership 'z g v q)))
                             (dk-have! (caddr pm) (lambda () (if (dk-only! pm (list 'IN q pg)) (prop))))
                             (dk-split! (caddr pm))
                             (ty-cmval! k q)
                             (dk-rewrite-h! (list 'IN (list g q) v) (list g q) (list (list 'f q) k))
                             (dk-have! (list 'IN (list 'f q) bx)
                               (lambda () (ty-box-intro! (list 'f q) sb
                                            (lambda () (let ((c (dk-di-var!))) (dk-cite! 'pair-self-eq b c) (subst (list '= c b)) (ty-nth-all!) (dk-ass!))))))
                             (let ((pm2 (dk-cite! 'preimage-membership 'z 'f bx q)))
                               (if (dk-only! pm2 (list 'IN q '(PTS z)) (list 'IN (list 'f q) bx)) (prop)))))
                         (lambda ()
                           (let ((pm2 (dk-cite! 'preimage-membership 'z 'f bx q)))
                             (dk-have! (caddr pm2) (lambda () (if (dk-only! pm2 (list 'IN q pf)) (prop))))
                             (dk-split! (caddr pm2))
                             (let ((cl (ty-box-elim! (list 'f q) sb)))
                               (dk-apply! cl b)
                               (ty-nth-h! (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (dk-contains? h 'NTH) (dk-contains? h (list 'f q)))) "the constraint")))
                             (ty-cmval! k q)
                             (let ((pm (dk-cite! 'preimage-membership 'z g v q)))
                               (dk-have! (list 'IN (list g q) v) (lambda () (subst (list '= (list g q) (list (list 'f q) k))) (ass)))
                               (if (dk-only! pm (list 'IN q '(PTS z)) (list 'IN (list g q) v)) (prop)))))))))
                 (dk-cite! 'class-extensionality pg pf)
                 (subst (list '= pg pf))
                 (dk-ass!)))))))))
  ;; every coordinate continuous => continuous
  (lambda ()
    (mac 'is-hom-top-space-def)
    (dk-conj-close!
      (lambda ()
        (cond
          ((dk-ass!) #t)
          ((dk-head-is? (dk-goal) 'IN) (subst (list '== (list 'PTS ty-T) ty-P)) (dk-ass!))
          (#t
           (let* ((uu (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (list 'OPENS ty-T)))) (dk-peel!))))
                  (pre (list 'PREIMAGE 'z 'f uu)))
             (dk-rewrite-h! (list 'IN uu (list 'OPENS ty-T)) (list 'OPENS ty-T) ty-opens)
             (dk-have! (list 'IS-TPROD-OPEN 'ix 'tf uu) (lambda () (sep-me (dk-ctx-form (list 'IN uu ty-opens))) (dk-split-all!) (ass)))
             (let ((au (ty-open-parts! uu)))
               (dk-have! (list 'SUBSET pre '(PTS z))
                 (lambda () (mac 'subset-def) (let* ((q (dk-di-var!)) (pm (dk-cite! 'preimage-membership 'z 'f uu q)))
                                                (if (dk-only! pm (list 'IN q pre)) (prop)))))
               (dk-have! (list 'FORALL 'tlx_ (list 'IMPLIES (list 'IN 'tlx_ pre)
                           (list 'FORSOME 'tlw_ (list 'AND '(IN tlw_ (OPENS z)) (list 'AND '(IN tlx_ tlw_) (list 'SUBSET 'tlw_ pre))))))
                 (lambda ()
                   (let* ((a (dk-di-var!))
                          (pm (dk-cite! 'preimage-membership 'z 'f uu a)))
                     (dk-have! (caddr pm) (lambda () (if (dk-only! pm (list 'IN a pre)) (prop))))
                     (dk-split! (caddr pm))
                     (let* ((bb (ty-basic! au (list 'f a))))
                       (ty-finite! bb)
                       (ty-box-elim! (list 'f a) bb)
                       (dk-cite! 'tprod-coord-nbhd 'ix 'tf 'z 'f a bb)
                       (let* ((w (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'tpw_) (dk-contains? h bb))) "the neighbourhood") #t))
                              (tl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h w) (dk-contains? h bb))) "its clause")))
                         (ew w)
