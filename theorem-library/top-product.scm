(define ty-gfcl '(FORALL tpk_ (IMPLIES (IN tpk_ ix) (IS-HOM-TOP-SPACE z (tf tpk_) (gf tpk_)))))
(define ty-F '(VNB-LAMBDA tpq_ (PTS z) (VNB-LAMBDA tpm_ ix ((gf tpm_) tpq_))))
