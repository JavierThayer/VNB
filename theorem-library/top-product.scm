  (dk-have! (list 'FORSOME 'w_ (list 'IN 'w_ ty-GRD)) (lambda () (ew 'c0) (dk-ass!)))
  (dk-cite! 'zorn-lemma ty-GRD ty-POR)
  (let* ((mx (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'IS-MAXIMAL))) "Zorn") #t))
         (im (list 'IS-MAXIMAL ty-GRD ty-POR mx))
