                              (lambda () (dk-have! (list 'IN (list 'LIST b a) ty-POR)
                                           (lambda () (dk-only! (list 'OR (list 'IN (list 'LIST a b) ty-POR) (list 'IN (list 'LIST b a) ty-POR)) (list 'NOT (list 'IN (list 'LIST a b) ty-POR))) (prop)))
                                         (ty-por-out! b a) (dk-only! (list 'SUBSET b a)) (prop))))
                          (lambda ()
                            (let ((umb (dk-cite! 'union-membership ch pc b)))
                              (dk-have! (list 'IN b pc) (lambda () (if (dk-only! umb (list 'IN b chp) (list 'NOT (list 'IN b ch))) (prop))))
                              (dk-cite! 'pair-self-eq 'c0 b)
                              (dk-have! (list 'SUBSET b a) (lambda () (subst (list '= b 'c0)) (ass)))
                              (dk-only! (list 'SUBSET b a)) (prop)))))
                      (lambda ()
                        (let ((uma (dk-cite! 'union-membership ch pc a)))
                          (dk-have! (list 'IN a pc) (lambda () (if (dk-only! uma (list 'IN a chp) (list 'NOT (list 'IN a ch))) (prop))))
                          (dk-cite! 'pair-self-eq 'c0 a)
                          (dk-have! (list 'SUBSET a b) (lambda () (subst (list '= a 'c0)) (ass)))
                          (dk-only! (list 'SUBSET a b)) (prop)))))))
              (dk-cite! 'chain-finite-in-member chp)
              (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'tpf_) (dk-contains? h chp))) "the chain lemma") g)
              (let ((a (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'tpd_) (dk-contains? h g))) "the member") #t)))
                (chp-grd! a)
                (ty-hasfin! a g)
                (ai (list 'NOT (list 'HAS-FINITE-SUBCOVER 's a)))))))
        (ty-grd-in! ub)
        (ew ub)
        (mac 'is-upper-bound)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (let ((x (dk-di-var!)))
                  (dk-cite! 'subset-mem-fwd ch ty-GRD x)
