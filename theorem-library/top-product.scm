(let ((cov (dk-ctx-form '(FORALL tpu_ (IMPLIES (IN tpu_ c0) (IN tpu_ (OPENS s)))))))
  (dk-have! (list 'SUBSET 'c0 ty-O) (lambda () (mac 'subset-def) (let ((e (dk-di-var!))) (dk-apply! cov e) (dk-ass!))))
