;;; tych.scm -- THE PRODUCT TOPOLOGY OF AN ARBITRARY FAMILY, its projections and universal property, and TYCHONOFF'S
;;; THEOREM for arbitrary products, from zorn-lemma (Alexander's argument, specialised to the subbasic constraints
;;; of the product).  Agent TYCH (worker-08), 2026-10-26.
;;; DESTINATION: theorem-library/top-product.scm.  Library: analysis.  Helper prefix: ty-.
;;; Needs: tych-vocab.scm (structure-library/top-product.scm), top-space, order-zorn / zorn-route-two (zorn-lemma),
;;; card-laws (card-union-nn, card-subset-nn, card-singleton), rake-card-star-laws (finite-set-induction),
;;; tvs-kernel-closed (top-open-of-local; scratchpad/dualfix2/tkr.scm).

(define (ty-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; TY OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (ty-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))
    c))
(define (ty-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (ty-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define ty-fam '(IS-TOP-FAMILY ix tf))
(define ty-P '(TPROD-PTS ix tf))
(define ty-K '(TPROD-CONSTR ix tf))
(define ty-T '(TPRODUCT-TOP ix tf))
(define (ty-box bb) (list 'TPROD-BOX 'ix 'tf bb))
(define ty-BUP '(BIG-UNION tpj_ ix (PTS (tf tpj_))))
(define ty-BUO '(BIG-UNION tpj_ ix (OPENS (tf tpj_))))
(define ty-famcl '(FORALL tpi_ (IMPLIES (IN tpi_ ix) (IS-TOP-SPACE (tf tpi_)))))
(define (ty-fam!)                      ; IS-TOP-FAMILY in context: ix SET and the clause
  (if (not (dk-asm? '(IN ix SET)))
      (begin (dk-project! '(IN ix SET) 'is-top-family ty-fam)
             (dk-project! ty-famcl 'is-top-family ty-fam)))
  (dk-ctx-form ty-famcl))
(define (ty-factor! i)                 ; i in ix: IS-TOP-SPACE (tf i), its PTS and OPENS sets, PTS open
  (let ((s (list 'tf i)))
    (if (not (dk-asm? (list 'IS-TOP-SPACE s)))
        (begin
          (dk-apply! (ty-fam!) i)
          (dk-project! (list 'IN (list 'PTS s) (list 'OPENS s)) 'is-top-space (list 'IS-TOP-SPACE s))
          (dk-project! (list 'IN (list 'OPENS s) (list 'POWER (list 'POWER (list 'PTS s)))) 'is-top-space (list 'IS-TOP-SPACE s))
          (dk-cite! 'membership-implies-sethood (list 'PTS s) (list 'OPENS s))
          (dk-cite! 'membership-implies-sethood (list 'OPENS s) (list 'POWER (list 'POWER (list 'PTS s))))))
    s))

;; reduce every NTH of a literal list in the goal / in a hypothesis
(define (ty-has-nth-list? e) (and (pair? e) (list? e)
  (or (and (eq? (car e) 'NTH) (= (length e) 3) (pair? (caddr e)) (eq? (car (caddr e)) 'LIST)) (any-pred ty-has-nth-list? e))))
(define (ty-nth-all!) (let loop ((k 0)) (if (and (< k 10) (ty-has-nth-list? (dk-goal))) (begin (nth-r) (loop (+ k 1))))))
(define (ty-nth-redex e)
  (cond ((not (and (pair? e) (list? e))) #f)
        ((let loop ((xs e)) (cond ((null? xs) #f) ((ty-nth-redex (car xs))) (#t (loop (cdr xs))))))
        ((and (eq? (car e) 'NTH) (= (length e) 3) (number? (cadr e)) (pair? (caddr e)) (eq? (car (caddr e)) 'LIST)
              (<= (cadr e) (length (cdr (caddr e)))))
         e)
        (#t #f)))
(define (ty-nth-h! f)
  (let loop ((f f) (k 0))
    (let ((rx (ty-nth-redex f)))
      (if (and rx (< k 12))
          (let* ((v (list-ref (caddr rx) (cadr rx))) (e (list '= rx v)))
            (if (not (dk-asm? e)) (dk-have! e (lambda () (ty-nth-all!) (rfl))))
            (loop (dk-rewrite-h! f rx v) (+ k 1)))
          f))))
;;; ===========================================================================
;;; (1) UNFOLDS, SETS, READ-OFFS, MEMBERSHIP
;;; ===========================================================================
(define (ty-unfold! name fn args body)
  (dk-sp-qed! (make-wff (ty-alls args (list '== (cons fn args) body)))
    (lambda () (dk-peel!) (mac fn) (qrfl))
    name)
  (topic! name 'analysis))
(ty-unfold! 'tprod-pts-unfold 'TPROD-PTS '(ix tf)
  '(SEP tpx_ (FUN ix (BIG-UNION tpj_ ix (PTS (tf tpj_)))) (FORALL tpi_ (IMPLIES (IN tpi_ ix) (IN (tpx_ tpi_) (PTS (tf tpi_)))))))
(ty-unfold! 'tprod-constr-unfold 'TPROD-CONSTR '(ix tf)
  '(SEP tpb_ (CARTESIAN ix (BIG-UNION tpj_ ix (OPENS (tf tpj_)))) (IN (NTH 2 tpb_) (OPENS (tf (NTH 1 tpb_))))))
(ty-unfold! 'tprod-box-unfold 'TPROD-BOX '(ix tf bb)
  '(SEP tpy_ (TPROD-PTS ix tf) (FORALL tpc_ (IMPLIES (IN tpc_ bb) (IN (tpy_ (NTH 1 tpc_)) (NTH 2 tpc_))))))

;; membership in a SEP-defined functoid: (IFF (IN z F) (AND (IN z DOM) COND[z]))
(define (ty-mem-thm! name args f dom cond-of)
  (sp (make-wff (ty-alls (append args '(z)) (list 'IFF (list 'IN 'z f) (list 'AND (list 'IN 'z dom) (cond-of 'z))))))
  (dk-peel!)
  (let ((u (dk-cite! (symbol-append (string->symbol (string-downcase (symbol->string (car f)))) '-unfold) (cadr f) (caddr f)))
        (body #f))
    (set! body (caddr (if (dk-head-is? u '==) u (dk-ctx-form u))))
    (if (= (length f) 4) (set! body (caddr (dk-cite! 'tprod-box-unfold (cadr f) (caddr f) (cadddr f)))))
    (subst (list '== f body))
    (dk-iff! (lambda (g) (dk-head-is? g 'AND))
      (lambda () (sep-me (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (eq? (cadr h) 'z) (dk-head-is? (caddr h) 'SEP))) "sep")) (dk-split-all!) (dk-conj-close! dk-ass!))
      (lambda () (dk-split-all!) (in-sep! (lambda () (ass)) (lambda () (ass))))))
  (ty-qed! name))
(ty-mem-thm! 'tprod-pts-mem '(ix tf) ty-P '(FUN ix (BIG-UNION tpj_ ix (PTS (tf tpj_))))
  (lambda (z) (list 'FORALL 'tpi_ (list 'IMPLIES '(IN tpi_ ix) (list 'IN (list z 'tpi_) '(PTS (tf tpi_)))))))
(ty-mem-thm! 'tprod-constr-mem '(ix tf) ty-K '(CARTESIAN ix (BIG-UNION tpj_ ix (OPENS (tf tpj_))))
  (lambda (z) (list 'IN (list 'NTH 2 z) (list 'OPENS (list 'tf (list 'NTH 1 z))))))
(ty-mem-thm! 'tprod-box-mem '(ix tf bb) (ty-box 'bb) ty-P
  (lambda (z) (list 'FORALL 'tpc_ (list 'IMPLIES '(IN tpc_ bb) (list 'IN (list z '(NTH 1 tpc_)) '(NTH 2 tpc_))))))

(define (ty-bu-set! bu acc)           ; (IN (BIG-UNION tpj_ ix (ACC (tf tpj_))) SET)
  (if (not (dk-asm? (list 'IN bu 'SET)))
      (dk-have! (list 'IN bu 'SET)
        (lambda ()
          (for-each (lambda (l)
                      (dk-focus! l)
                      (if (not (dk-ass!))
                          (let ((j (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'ix))) (dk-peel!)))))
                            (ty-factor! j) (dk-ass!))))
                    (dk-opened (lambda () (bu-set))))))))
(sp (make-wff (ty-alls '(ix tf) (ty-imps (list ty-fam) (list 'AND (list 'IN ty-P 'SET) (list 'IN ty-K 'SET))))))
(dk-peel!)
(ty-fam!)
(ty-bu-set! ty-BUP 'PTS)
(ty-bu-set! ty-BUO 'OPENS)
(dk-have! (list 'IN (list 'FUN 'ix ty-BUP) 'SET) (lambda () (mac 'fun-set-iff) (dk-conj-close! (lambda () (ass)))))
(dk-have! (list 'IN (list 'CARTESIAN 'ix ty-BUO) 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass)))))
(dk-cite! 'tprod-pts-unfold 'ix 'tf)
(dk-cite! 'tprod-constr-unfold 'ix 'tf)
(dk-conj-close!
  (lambda ()
    (if (dk-contains? (dk-goal) 'TPROD-PTS)
        (begin (subst (list '== ty-P (caddr (dk-ctx-form (list '== ty-P '(SEP tpx_ (FUN ix (BIG-UNION tpj_ ix (PTS (tf tpj_)))) (FORALL tpi_ (IMPLIES (IN tpi_ ix) (IN (tpx_ tpi_) (PTS (tf tpi_)))))))))))
               (sep-set) (dk-ass!))
        (begin (subst (list '== ty-K '(SEP tpb_ (CARTESIAN ix (BIG-UNION tpj_ ix (OPENS (tf tpj_)))) (IN (NTH 2 tpb_) (OPENS (tf (NTH 1 tpb_)))))))
               (sep-set) (dk-ass!)))))
(ty-qed! 'tprod-sets)
(define (ty-sets!)
  (if (not (dk-asm? (list 'IN ty-P 'SET)))
      (begin (dk-split! (dk-cite! 'tprod-sets 'ix 'tf)) (dk-cite! 'power-set ty-P))))

;;; the two slots of TPRODUCT-TOP
(define ty-opens (list 'SEP 'tpu_ (list 'POWER ty-P) '(IS-TPROD-OPEN ix tf tpu_)))
(define (ty-slot! name acc val)
  (dk-sp-qed! (make-wff (ty-alls '(ix tf) (ty-imps (list ty-fam) (list '== (list acc ty-T) val))))
    (lambda ()
      (dk-peel!)
      (ty-sets!)
      (mac 'TPRODUCT-TOP)
      (slot acc)
      (nth-r)
      (if (and (not (proof-done? *ps*)) (dk-contains? (dk-goal) acc)) (slot acc))
      (if (not (proof-done? *ps*)) (qrfl)))
    name)
  (topic! name 'analysis))
(ty-slot! 'tprod-top-pts 'PTS ty-P)
(ty-slot! 'tprod-top-opens 'OPENS ty-opens)

