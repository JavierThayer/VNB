(define ty-cpt '(FORALL tpi_ (IMPLIES (IN tpi_ ix) (IS-COMPACT-T (tf tpi_)))))
(define (ty-sbox i v) (ty-box (list 'PAIR (list 'LIST i v) (list 'LIST i v))))
(define (ty-cpt-clause sp)            ; the open-cover clause of IS-COMPACT-T(SP)
  (list 'FORALL 'c (list 'IMPLIES (list 'FORALL 'u (list 'IMPLIES '(IN u c) (list 'IN 'u (list 'OPENS sp))))
                     (list 'IMPLIES (list '== '(BIG-UNION u c u) (list 'PTS sp))
                       (list 'FORSOME 'f_ (list 'AND '(SUBSET f_ c) (list 'AND '(IN (CARD f_) NN)
                         (list '== '(BIG-UNION u f_ u) (list 'PTS sp)))))))))
(define (ty-in-sbox! y i v)            ; y in P, (y i) in v, [i, v] a constraint: (IN y (sbox i v))
  (let* ((b (list 'LIST i v)) (sb (list 'PAIR b b)))
    (dk-cite! 'membership-implies-sethood b ty-K)
    (dk-have! (list 'IN y (ty-box sb))
      (lambda () (ty-box-intro! y sb (lambda () (let ((c (dk-di-var!))) (dk-cite! 'pair-self-eq b c) (subst (list '= c b)) (ty-nth-all!) (dk-ass!))))))))

;; for a family of COMPACT factors: if mm is a family of open sets of the product with no finite subcover, then each
;; factor has a point outside every open set V whose cylinder {x : x(i) in V} belongs to mm
(sp (make-wff (ty-alls '(ix tf mm i)
  (ty-imps (list ty-fam ty-cpt (list 'SUBSET 'mm (list 'OPENS ty-T)) (list 'NOT (list 'HAS-FINITE-SUBCOVER ty-T 'mm)) '(IN i ix))
    (list 'FORSOME 'tpe_ (list 'AND '(IN tpe_ (PTS (tf i)))
      (list 'FORALL 'tpv5_ (list 'IMPLIES '(IN tpv5_ (OPENS (tf i)))
        (list 'IMPLIES (list 'IN (ty-sbox 'i 'tpv5_) 'mm) '(NOT (IN tpe_ tpv5_)))))))))))
(dk-peel!)
(ty-fam!)
(ty-sets!)
(ty-factor! 'i)
(dk-cite! 'tprod-top-pts 'ix 'tf)
(dk-cite! 'tprod-top-opens 'ix 'tf)
(dk-cite! 'tprod-top-is-top-space 'ix 'tf)
(dk-project! (list 'IN (list 'OPENS ty-T) (list 'POWER (list 'POWER (list 'PTS ty-T)))) 'is-top-space (list 'IS-TOP-SPACE ty-T))
(let* ((si '(tf i))
       (goal0 (dk-goal))
       (wi (list 'SEP 'tpv6_ '(OPENS (tf i)) (list 'IN (ty-sbox 'i 'tpv6_) 'mm)))
       (bw (list 'BIG-UNION 'u wi 'u)))
  (dk-apply! (dk-ctx-form ty-cpt) 'i)
  (let ((ccl (dk-project! (ty-cpt-clause si) 'is-compact-t (list 'IS-COMPACT-T si))))
    (pbc)
    (dk-have! (list 'IN wi 'SET) (lambda () (sep-set) (ass)))
    (dk-have! (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u wi) '(IN u (OPENS (tf i)))))
      (lambda () (let ((e (dk-di-var!))) (sep-me (dk-ctx-form (list 'IN e wi))) (dk-split-all!) (dk-ass!))))
    ;; the cylinders in mm cover the factor
    (dk-have! (list 'FORALL 'tpz_ (list 'IFF (list 'IN 'tpz_ bw) '(IN tpz_ (PTS (tf i)))))
      (lambda ()
        (let ((z (begin (di) (cadr (cadr (dk-goal))))))
          (dk-iff! (lambda (g) (equal? g (list 'IN z '(PTS (tf i)))))
            (lambda ()
              (let* ((ld (dk-landed (lambda () (bu-me (list 'IN z bw)))))
                     (v (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) wi))) ld))))
                (sep-me (list 'IN v wi)) (dk-split-all!)
                (dk-cite! 'power-mem-in '(POWER (PTS (tf i))) '(OPENS (tf i)) v)
                (dk-cite! 'power-mem-in '(PTS (tf i)) v z)
                (dk-ass!)))
            (lambda ()
              (pbc)
              (dk-have! goal0
                (lambda ()
                  (ew z)
                  (dk-conj-close!
                    (lambda ()
                      (if (not (dk-ass!))
                          (let* ((ld (dk-peel!))
                                 (v (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(OPENS (tf i))))) ld))))
                            (if (dk-head-is? (dk-goal) 'NOT) (di))
                            (dk-have! (list 'IN v wi) (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))
                            (dk-have! (list 'IN z bw) (lambda () (for-each (lambda (l) (dk-focus! l) (dk-ass!)) (dk-opened (lambda () (bu-mi v))))))
                            (ai (list 'NOT (list 'IN z bw)))))))))
              (ai (list 'NOT goal0)))))))
    (dk-cite! 'class-extensionality bw '(PTS (tf i)))
    (dk-have! (list '== bw '(PTS (tf i))) (lambda () (subst (list '= bw '(PTS (tf i)))) (qrfl)))
    ;; a finite subcover of the factor
    (dk-apply! ccl wi)
    (let* ((ff (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'f_) (dk-contains? h wi))) "the finite subcover") #t))
           (phi (list 'VNB-LAMBDA 'tpv7_ '(OPENS (tf i)) (ty-sbox 'i 'tpv7_)))
           (fb (list 'IMAGE phi ff))
           (bfb (list 'BIG-UNION 'tpv_ fb 'tpv_)))
      (define (phival! x)              ; x in OPENS(tf i): (= (phi x) (sbox i x))
        (dk-have! (list '= (list phi x) (ty-sbox 'i x)) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
      (dk-cite! 'subclass-of-set-is-set ff wi)
      (dk-cite! 'card-image-finite phi ff)
      (dk-have! (list 'SUBSET fb 'mm)
        (lambda ()
          (mac 'subset-def)
          (let* ((w (dk-di-var!))
                 (imf (dk-cite! 'image-membership-iff phi ff w)))
            (dk-have! (caddr imf) (lambda () (if (dk-only! imf (list 'IN w fb)) (prop))))
