  (dk-have! (list 'IN ty-POR 'SET) (lambda () (sep-set) (ass)))
  ;; the partial order
  (dk-have! (list 'IS-PARTIAL-ORDER ty-GRD ty-POR)
    (lambda ()
      (mac 'is-partial-order)
