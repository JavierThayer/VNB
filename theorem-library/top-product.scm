        (let ((im (dk-cite! 'tprod-pts-mem 'ix 'tf fq)))
          (dk-have! (list 'IN fq (list 'FUN 'ix ty-BUP))
            (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (ty-gfval! k q) (ty-factor! k)
                                                    (for-each (lambda (l) (dk-focus! l) (dk-ass!)) (dk-opened (lambda () (bu-mi k))))))
                                     (lambda () (dk-ass!)))))
          (dk-have! (caddr (caddr im))
            (lambda () (let ((k (dk-di-var!))) (ty-gfval! k q) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-ass!)))))
          (ty-and! (list 'IN fq (list 'FUN 'ix ty-BUP)) (caddr (caddr im)))
          (dk-have! (list 'IN fq ty-P) (lambda () (if (dk-only! im (caddr im)) (prop))))))
    fq))
(sp (make-wff (ty-alls '(ix tf z gf)
  (ty-imps (list ty-fam '(IS-TOP-SPACE z) ty-gftyp ty-gfcl)
    (list 'AND (list 'IS-HOM-TOP-SPACE 'z ty-T ty-F)
          (list 'FORALL 'tpk_ (list 'IMPLIES '(IN tpk_ ix) (list 'FORALL 'tpp_ (list 'IMPLIES '(IN tpp_ (PTS z))
            (list '= (list '(TPROJ ix tf tpk_) (list ty-F 'tpp_)) '((gf tpk_) tpp_)))))))))))
(dk-peel!)
(ty-fam!)
(ty-sets!)
(dk-project! '(IN (PTS z) (OPENS z)) 'is-top-space '(IS-TOP-SPACE z))
(dk-cite! 'membership-implies-sethood '(PTS z) '(OPENS z))
(dk-have! (list 'IN ty-F (list 'FUN '(PTS z) ty-P))
  (lambda () (dk-lam-type! (lambda () (let ((q (dk-di-var!))) (ty-Fq-in! q) (dk-ass!))) (lambda () (dk-ass!)))))
(define (ty-Fval! q)                   ; (= (F q) (Fq q)), q in PTS z
  (ty-Fq-in! q)
  (let ((e (list '= (list ty-F q) (ty-Fq q))))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
    e))
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IS-HOM-TOP-SPACE)
        (let ((iff (dk-cite! 'tprod-hom-iff 'ix 'tf 'z ty-F)))
          (dk-have! (caddr iff)
            (lambda ()
              (let* ((k (dk-di-var!)) (cm (list 'VNB-LAMBDA 'tpq_ '(PTS z) (list (list ty-F 'tpq_) k))))
                (ty-factor! k)
                (dk-apply! (dk-ctx-form ty-gfcl) k)
                (dk-have! (list 'IN cm (list 'FUN '(PTS z) (list 'PTS (list 'tf k))))
                  (lambda () (dk-lam-type! (lambda () (let ((q (dk-di-var!))) (ty-Fval! q) (ty-gfval! k q)
                                                         (subst (list '= (list ty-F q) (ty-Fq q))) (dk-lam-b!) (dk-ass!)))
                                           (lambda () (dk-ass!)))))
                (dk-have! (list 'FORALL 'tpq_ (list 'IMPLIES '(IN tpq_ (PTS z)) (list '= (list cm 'tpq_) (list (list 'gf k) 'tpq_))))
                  (lambda () (let ((q (dk-di-var!))) (ty-Fval! q) (ty-gfval! k q)
                               (dk-lam-b!)
                               (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
                (dk-apply! (dk-ctx-form ty-gftyp) k)
                (dk-cite! 'hom-top-space-ptwise-eq 'z (list 'tf k) (list 'gf k) cm)
