          (if (dk-only! iff (caddr iff)) (prop)))
        (let* ((ld (dk-peel!))
               (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'ix))) ld)))
               (q (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(PTS z)))) ld))))
          (ty-Fval! q)
          (ty-gfval! k q)
          (dk-cite! 'fun-apply-type-c ty-F '(PTS z) ty-P q)
          (dk-cite! 'tproj-value 'ix 'tf k (list ty-F q))
          (subst (list '= (list (list 'TPROJ 'ix 'tf k) (list ty-F q)) (list (list ty-F q) k)))
          (subst (list '= (list ty-F q) (ty-Fq q)))
          (dk-lam-b!)
          (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))))
(ty-qed! 'tprod-induced-map)

;; ... and it is the only map into the product with those coordinates
(sp (make-wff (ty-alls '(ix tf z gf h)
