        (lambda ()
          (if (not (dk-ass!))
              (let* ((ld (dk-peel!))
                     (vs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) ty-GRD))) ld))))
                (dk-split-all!)
                (for-each ty-grd-out! vs)
