(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (let* ((ld (dk-peel!))
               (cov (find-first (lambda (h) (dk-head-is? h 'FORALL)) ld))
               (eq0 (find-first (lambda (h) (dk-head-is? h '==)) ld))
               (c0 (caddr (cadr (caddr cov))))
               (hf0 (list 'HAS-FINITE-SUBCOVER ty-T c0)))
          (dk-have! hf0
            (lambda ()
              (pbc)
              (dk-cite! 'alexander-maximal-cover ty-T c0)
              (let* ((mm (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h c0) (dk-contains? h 'HAS-FINITE-SUBCOVER))) "Alexander") #t))
                     (mxc (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h mm) (dk-contains? h 'HAS-FINITE-SUBCOVER))) "maximality"))
                     (xx (list 'VNB-LAMBDA 'tpm3_ 'ix (list 'CHOICE (ty-xsep 'tpm3_ mm)))))
                (define (choice! i)    ; i in ix: CHOICE(A_i) in PTS(tf i) and avoids the cylinders of mm
                  (let* ((ai (ty-xsep i mm)) (ch (list 'CHOICE ai)))
                    (if (not (dk-asm? (list 'IN ch (list 'PTS (list 'tf i)))))
                        (begin
                          (dk-cite! 'tychonoff-factor-point 'ix 'tf mm i)
                          (let ((e (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'tpe_) (dk-contains? h i) (dk-contains? h mm))) "the factor point") #t)))
                            (dk-have! (list 'IN e ai) (lambda () (in-sep! (lambda () (ass)) (lambda () (dk-ass!)))))
                            (dk-have! (list 'FORSOME 'tpq9_ (list 'IN 'tpq9_ ai)) (lambda () (ew e) (dk-ass!)))
                            (dk-cite! 'choice-axiom ai)
                            (dk-have! (list 'IN ch (list 'PTS (list 'tf i))) (lambda () (sep-me (dk-ctx-form (list 'IN ch ai))) (dk-split-all!) (dk-ass!)))
                            (dk-have! (ty-symsub (cadddr ai) 'tpe9_ ch)
                              (lambda () (sep-me (dk-ctx-form (list 'IN ch ai))) (dk-split-all!) (dk-ass!)))
                            #t)))
                    ch))
                (define (xval! i)
                  (let ((ch (choice! i)))
                    (if (not (dk-asm? (list '= (list xx i) ch)))
                        (dk-have! (list '= (list xx i) ch) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
                    ch))
                ;; the point x of the product
                (dk-have! (list 'IN xx (list 'FUN 'ix ty-BUP))
                  (lambda () (dk-lam-type! (lambda () (let ((i (dk-di-var!))) (choice! i) (ty-factor! i)
                                                       (for-each (lambda (l) (dk-focus! l) (dk-ass!)) (dk-opened (lambda () (bu-mi i))))))
                                           (lambda () (dk-ass!)))))
                (let ((im (dk-cite! 'tprod-pts-mem 'ix 'tf xx)))
                  (dk-have! (caddr (caddr im)) (lambda () (let ((i (dk-di-var!))) (xval! i) (subst (list '= (list xx i) (list 'CHOICE (ty-xsep i mm)))) (dk-ass!))))
                  (dk-have! (list 'IN xx ty-P) (lambda () (ty-and! (list 'IN xx (list 'FUN 'ix ty-BUP)) (caddr (caddr im))) (if (dk-only! im (caddr im)) (prop)))))
                ;; x lies in a member U of mm, in a finite box inside U
                (let ((bu0 (cadr eq0)))
                  (dk-have! (list 'IN xx bu0) (lambda () (subst eq0) (subst (list '== (list 'PTS ty-T) ty-P)) (dk-ass!)))
                  (let* ((ld2 (dk-landed (lambda () (bu-me (list 'IN xx bu0)))))
                         (uu (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) c0))) ld2))))
                    (dk-cite! 'subset-mem-fwd c0 mm uu)
                    (dk-cite! 'subset-mem-fwd mm (list 'OPENS ty-T) uu)
                    (dk-cite! 'membership-implies-sethood uu (list 'OPENS ty-T))
                    (dk-cite! 'subclass-of-set-is-set mm (list 'OPENS ty-T))
                    (dk-have! (list 'IS-TPROD-OPEN 'ix 'tf uu)
                      (lambda () (let ((h (dk-rewrite-h! (list 'IN uu (list 'OPENS ty-T)) (list 'OPENS ty-T) ty-opens)))
                                   (sep-me h) (dk-split-all!) (dk-ass!))))
                    (let* ((au (ty-open-parts! uu))
                           (bb (ty-basic! au xx))
                           (xcl (begin (ty-finite! bb) (ty-box-elim! xx bb)))
                           (pcon (ty-symsub (ty-symsub ty-percon 'mm mm) 'bb bb)))
                      ;; each constraint of the box: its cylinder is not in mm, so a finite family of mm covers its outside
                      (dk-have! pcon
                        (lambda ()
                          (let* ((c (dk-di-var!))
                                 (i (list 'NTH 1 c)) (v (list 'NTH 2 c)))
                            (dk-cite! 'subset-mem-fwd bb ty-K c)
                            (let ((cm (dk-cite! 'tprod-constr-mem 'ix 'tf c)))
                              (dk-have! (caddr cm) (lambda () (if (dk-only! cm (list 'IN c ty-K)) (prop))))
                              (dk-split! (caddr cm)))
                            (dk-split-all! (list (dk-cite! 'cartesian-nth c 'ix ty-BUO)))
                            (dk-cite! 'cartesian-pair-eq c 'ix ty-BUO)
                            (let* ((sb (ty-single! c)) (bc (ty-box sb)))
                              (dk-cite! 'tprod-box-open 'ix 'tf sb)
                              (dk-cite! 'membership-implies-sethood bc (list 'OPENS ty-T))
                              (dk-have! (list 'NOT (list 'IN bc mm))
                                (lambda ()
                                  (di)
                                  (dk-have! (list 'IN (ty-sbox i v) mm) (lambda () (subst (list '= (list 'LIST i v) c)) (dk-ass!)))
                                  (dk-apply! xcl c)
                                  (let ((ch (xval! i)))
                                    (dk-rewrite-h! (list 'IN (list xx i) v) (list xx i) ch)
                                    (dk-apply! (dk-ctx-form (ty-symsub (cadddr (ty-xsep i mm)) 'tpe9_ ch)) v)
                                    (ai (list 'NOT (list 'IN ch v))))))
                              (dk-apply! mxc bc)
                              (dk-cite! 'finite-cover-outside ty-T mm bc)
                              (dk-ass!)))))
                      (dk-cite! 'tprod-finite-constraint-cover 'ix 'tf mm bb)
                      (let* ((gg (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'tpk3_) (dk-contains? h bb))) "the finite family") #t))
                             (og (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h gg) (dk-contains? h 'tpy_))) "its cover clause"))
                             (pu (list 'PAIR uu uu))
                             (gs (list 'UNION gg pu))
                             (bgs (list 'BIG-UNION 'tpv_ gs 'tpv_)))
                        (dk-have! (list 'SUBSET gg mm) (lambda () (mac 'subset-def) (let ((e (dk-di-var!))) (dk-cite! 'power-mem-in mm gg e) (dk-ass!))))
                        (dk-cite! 'membership-implies-sethood gg (list 'POWER mm))
                        (ty-and! (list 'IN uu 'SET) (list 'IN uu 'SET))
                        (fact 'pairing uu uu)
                        (dk-cite! 'pair-self-member uu)
                        (dk-cite! 'card-singleton uu)
                        (fact 'nn-zero-in) (dk-cite! 'nn-succ-closed 0)
                        (dk-have! (list 'IN (list 'CARD pu) 'NN) (lambda () (subst (list '= (list 'CARD pu) '(succ 0))) (ass)))
                        (dk-cite! 'card-union-nn gg pu)
                        (ty-and! (list 'IN gg 'SET) (list 'IN pu 'SET))
                        (fact 'union-set-closure gg pu)
                        (ty-subset! gs mm
                          (lambda (q) (let ((um (dk-cite! 'union-membership gg pu q)))
                                        (dk-have! (list 'IMPLIES (list 'IN q gg) (list 'IN q mm)) (lambda () (di) (dk-cite! 'subset-mem-fwd gg mm q) (dk-ass!)))
                                        (dk-have! (list 'IMPLIES (list 'IN q pu) (list 'IN q mm)) (lambda () (di) (dk-cite! 'pair-self-eq uu q) (subst (list '= q uu)) (dk-ass!)))
                                        (dk-only! um (list 'IN q gs) (list 'IMPLIES (list 'IN q gg) (list 'IN q mm)) (list 'IMPLIES (list 'IN q pu) (list 'IN q mm)))
                                        (prop))))
                        (let ((um (dk-cite! 'union-membership gg pu uu)))
                          (dk-have! (list 'IN uu gs) (lambda () (if (dk-only! um (list 'IN uu pu)) (prop)))))
                        (ty-subset! gg gs (lambda (q) (dk-cite! 'union-membership gg pu q) (if (apply dk-only! (filter (lambda (h) (dk-contains? h q)) (dk-asms))) (prop))))
                        (dk-have! (list 'FORALL 'tpz_ (list 'IFF (list 'IN 'tpz_ bgs) (list 'IN 'tpz_ (list 'PTS ty-T))))
                          (lambda ()
                            (let ((z (begin (di) (cadr (cadr (dk-goal))))))
                              (dk-iff! (lambda (g) (equal? g (list 'IN z (list 'PTS ty-T))))
                                (lambda ()
                                  (let* ((ld3 (dk-landed (lambda () (bu-me (list 'IN z bgs)))))
                                         (a (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) gs))) ld3))))
                                    (dk-cite! 'subset-mem-fwd gs mm a)
                                    (dk-cite! 'subset-mem-fwd mm (list 'OPENS ty-T) a)
                                    (dk-cite! 'power-mem-in (list 'POWER (list 'PTS ty-T)) (list 'OPENS ty-T) a)
                                    (dk-cite! 'power-mem-in (list 'PTS ty-T) a z)
                                    (dk-ass!)))
                                (lambda ()
                                  (dk-have! (list 'IMPLIES (list 'IN z (ty-box bb)) (list 'IN z bgs))
                                    (lambda () (di) (dk-cite! 'subset-mem-fwd (ty-box bb) uu z)
                                               (for-each (lambda (l) (dk-focus! l) (dk-ass!)) (dk-opened (lambda () (bu-mi uu))))))
                                  (dk-have! (list 'IMPLIES (list 'NOT (list 'IN z (ty-box bb))) (list 'IN z bgs))
                                    (lambda () (di) (dk-apply! og z) (ty-bu-transfer! z gg gs) (dk-ass!)))
                                  (dk-only! (list 'IMPLIES (list 'IN z (ty-box bb)) (list 'IN z bgs))
                                            (list 'IMPLIES (list 'NOT (list 'IN z (ty-box bb))) (list 'IN z bgs)))
                                  (prop))))))
                        (dk-cite! 'class-extensionality bgs (list 'PTS ty-T))
                        (dk-have! (list '== bgs (list 'PTS ty-T)) (lambda () (subst (list '= bgs (list 'PTS ty-T))) (qrfl)))
                        (dk-have! (list 'HAS-FINITE-SUBCOVER ty-T mm) (lambda () (mac 'has-finite-subcover) (ew gs) (dk-conj-close! dk-ass!)))
                        (ai (list 'NOT (list 'HAS-FINITE-SUBCOVER ty-T mm))))))))))
          (mac-h 'HAS-FINITE-SUBCOVER (dk-ctx-form hf0))
          (dk-ass!)))))
(ty-qed! 'tychonoff)

;;; ===========================================================================
;;; (7) A CONTINUOUS MAP ONTO PRESERVES COMPACTNESS (the first step of the metric form; see TYCH-REPORT.md)
;;; ===========================================================================
;; a continuous map ONTO t carries compactness: the preimages of a cover of t cover s; one chosen member of the cover
;; for each member of a finite subcover of s gives a finite subcover of t
(sp (make-wff (ty-alls '(s t f)
  (ty-imps '((IS-HOM-TOP-SPACE s t f) (IS-COMPACT-T s) (FORALL tpy_ (IMPLIES (IN tpy_ (PTS t)) (FORSOME tpx_ (AND (IN tpx_ (PTS s)) (= (f tpx_) tpy_))))))
    '(IS-COMPACT-T t)))))
(dk-peel!)
(let* ((hom '(IS-HOM-TOP-SPACE s t f))
       (onto (dk-ctx-form '(FORALL tpy_ (IMPLIES (IN tpy_ (PTS t)) (FORSOME tpx_ (AND (IN tpx_ (PTS s)) (= (f tpx_) tpy_)))))))
       (pre (dk-project! '(FORALL u (IMPLIES (IN u (OPENS t)) (IN (PREIMAGE s f u) (OPENS s)))) 'is-hom-top-space-def hom))
       (ccl (dk-project! (ty-cpt-clause 's) 'is-compact-t '(IS-COMPACT-T s))))
  (dk-project! '(IS-TOP-SPACE s) 'is-hom-top-space-def hom)
  (dk-project! '(IS-TOP-SPACE t) 'is-hom-top-space-def hom)
  (dk-project! '(IN f (FUN (PTS s) (PTS t))) 'is-hom-top-space-def hom)
  (dk-project! '(IN (OPENS s) (POWER (POWER (PTS s)))) 'is-top-space '(IS-TOP-SPACE s))
  (dk-project! '(IN (OPENS t) (POWER (POWER (PTS t)))) 'is-top-space '(IS-TOP-SPACE t))
  (dk-cite! 'membership-implies-sethood '(OPENS s) '(POWER (POWER (PTS s))))
  (dk-cite! 'membership-implies-sethood '(OPENS t) '(POWER (POWER (PTS t))))
  (mac 'is-compact-t)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((ld (dk-peel!))
                 (cov (find-first (lambda (h) (dk-head-is? h 'FORALL)) ld))
                 (eqc (find-first (lambda (h) (dk-head-is? h '==)) ld))
                 (cc (caddr (cadr (caddr cov))))
                 (buc (cadr eqc))
                 (dd (list 'SEP 'tpd2_ '(OPENS s) (list 'FORSOME 'tpu2_ (list 'AND (list 'IN 'tpu2_ cc) '(= tpd2_ (PREIMAGE s f tpu2_)))))))
            (dk-have! (list 'SUBSET cc '(OPENS t)) (lambda () (mac 'subset-def) (let ((e (dk-di-var!))) (dk-apply! cov e) (dk-ass!))))
            (dk-cite! 'subclass-of-set-is-set cc '(OPENS t))
            (dk-have! (list 'IN dd 'SET) (lambda () (sep-set) (ass)))
            ;; the preimages cover s
            (dk-have! (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u dd) '(IN u (OPENS s))))
              (lambda () (let ((e (dk-di-var!))) (sep-me (dk-ctx-form (list 'IN e dd))) (dk-split-all!) (dk-ass!))))
            (let ((bud (list 'BIG-UNION 'u dd 'u)))
              (dk-have! (list 'FORALL 'tpz_ (list 'IFF (list 'IN 'tpz_ bud) '(IN tpz_ (PTS s))))
                (lambda ()
                  (let ((x (begin (di) (cadr (cadr (dk-goal))))))
                    (dk-iff! (lambda (g) (equal? g (list 'IN x '(PTS s))))
                      (lambda ()
                        (let* ((ld2 (dk-landed (lambda () (bu-me (list 'IN x bud)))))
                               (v (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) dd))) ld2))))
                          (sep-me (list 'IN v dd)) (dk-split-all!)
                          (dk-cite! 'power-mem-in '(POWER (PTS s)) '(OPENS s) v)
                          (dk-cite! 'power-mem-in '(PTS s) v x)
                          (dk-ass!)))
                      (lambda ()
                        (dk-cite! 'fun-apply-type-c 'f '(PTS s) '(PTS t) x)
                        (dk-have! (list 'IN (list 'f x) buc) (lambda () (subst eqc) (dk-ass!)))
                        (let* ((ld2 (dk-landed (lambda () (bu-me (list 'IN (list 'f x) buc)))))
                               (u (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) cc))) ld2)))
                               (pu (list 'PREIMAGE 's 'f u)))
                          (dk-apply! cov u)
                          (dk-apply! pre u)
                          (dk-have! (list 'IN pu dd) (lambda () (in-sep! (lambda () (ass)) (lambda () (ew u) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))
                          (let ((pm (dk-cite! 'preimage-membership 's 'f u x)))
                            (dk-have! (list 'IN x pu) (lambda () (if (dk-only! pm (list 'IN x '(PTS s)) (list 'IN (list 'f x) u)) (prop)))))
                          (for-each (lambda (l) (dk-focus! l) (dk-ass!)) (dk-opened (lambda () (bu-mi pu))))))))))
              (dk-cite! 'class-extensionality bud '(PTS s))
              (dk-have! (list '== bud '(PTS s)) (lambda () (subst (list '= bud '(PTS s))) (qrfl)))
              (dk-apply! ccl dd)
              (let* ((ff (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'f_) (dk-contains? h dd))) "the finite subcover") #t))
                     (bff (list 'BIG-UNION 'u ff 'u))
                     (cv (lambda (v) (list 'SEP 'tpu3_ cc (list '= v '(PREIMAGE s f tpu3_)))))
                     (phi (list 'VNB-LAMBDA 'tpv8_ dd (list 'CHOICE (cv 'tpv8_))))
                     (gg (list 'IMAGE phi ff))
                     (bgg (list 'BIG-UNION 'tpv_ gg 'tpv_)))
                (define (pick! v)      ; v in dd: (phi v) in cc and (= v (PREIMAGE s f (phi v)))
                  (let* ((cvv (cv v)) (ch (list 'CHOICE cvv)))
                    (if (not (dk-asm? (list 'IN ch cc)))
                        (begin
                          (dk-have! (list 'FORSOME 'tpq9_ (list 'IN 'tpq9_ cvv))
                            (lambda ()
                              (let ((ex (dk-have! (list 'FORSOME 'tpu2_ (list 'AND (list 'IN 'tpu2_ cc) (list '= v '(PREIMAGE s f tpu2_))))
                                          (lambda () (sep-me (dk-ctx-form (list 'IN v dd))) (dk-split-all!) (dk-ass!)))))
                                (let ((u (dk-skolem! (dk-ctx-form (list 'FORSOME 'tpu2_ (list 'AND (list 'IN 'tpu2_ cc) (list '= v '(PREIMAGE s f tpu2_))))) #t)))
                                  (ew u) (in-sep! (lambda () (ass)) (lambda () (dk-ass!)))))))
                          (dk-have! (list 'IN cvv 'SET) (lambda () (sep-set) (ass)))
                          (dk-cite! 'choice-axiom cvv)
                          (dk-have! (list 'IN ch cc) (lambda () (sep-me (dk-ctx-form (list 'IN ch cvv))) (dk-split-all!) (dk-ass!)))
                          (dk-have! (list '= v (list 'PREIMAGE 's 'f ch)) (lambda () (sep-me (dk-ctx-form (list 'IN ch cvv))) (dk-split-all!) (dk-ass!)))
                          (dk-have! (list '= (list phi v) ch) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))))
                    ch))
                (dk-cite! 'subclass-of-set-is-set ff dd)
                (dk-cite! 'card-image-finite phi ff)
                (dk-have! (list 'SUBSET gg cc)
                  (lambda ()
                    (mac 'subset-def)
                    (let* ((w (dk-di-var!))
                           (imf (dk-cite! 'image-membership-iff phi ff w)))
                      (dk-have! (caddr imf) (lambda () (if (dk-only! imf (list 'IN w gg)) (prop))))
                      (dk-split! (caddr imf))
                      (let ((v (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h ff) (dk-contains? h w))) "the preimage") #t)))
                        (dk-cite! 'subset-mem-fwd ff dd v)
                        (let ((ch (pick! v)))
                          (dk-rewrite-h! (list '= (list phi v) w) (list phi v) ch)
                          (subst (list '= w ch))
                          (dk-ass!))))))
                (dk-have! (list 'FORALL 'tpz_ (list 'IFF (list 'IN 'tpz_ bgg) '(IN tpz_ (PTS t))))
                  (lambda ()
                    (let ((y (begin (di) (cadr (cadr (dk-goal))))))
                      (dk-iff! (lambda (g) (equal? g (list 'IN y '(PTS t))))
                        (lambda ()
                          (let* ((ld3 (dk-landed (lambda () (bu-me (list 'IN y bgg)))))
                                 (w (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) gg))) ld3))))
                            (dk-cite! 'subset-mem-fwd gg cc w)
                            (dk-apply! cov w)
                            (dk-cite! 'power-mem-in '(POWER (PTS t)) '(OPENS t) w)
                            (dk-cite! 'power-mem-in '(PTS t) w y)
                            (dk-ass!)))
                        (lambda ()
                          (let* ((x (dk-skolem! (dk-apply! onto y) #t)))
                            (dk-have! (list 'IN x bff) (lambda () (subst (list '== bff '(PTS s))) (dk-ass!)))
                            (let* ((ld4 (dk-landed (lambda () (bu-me (list 'IN x bff)))))
                                   (v (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) ff))) ld4))))
                              (dk-cite! 'subset-mem-fwd ff dd v)
                              (let* ((ch (pick! v)))
                                (dk-have! (list 'IN x (list 'PREIMAGE 's 'f ch)) (lambda () (subst (list '= (list 'PREIMAGE 's 'f ch) v)) (dk-ass!)))
                                (let ((pm (dk-cite! 'preimage-membership 's 'f ch x)))
                                  (dk-have! (list 'IN (list 'f x) ch) (lambda () (if (dk-only! pm (list 'IN x (list 'PREIMAGE 's 'f ch))) (prop)))))
                                (dk-rewrite-h! (list 'IN (list 'f x) ch) (list 'f x) y)
                                (dk-cite! 'membership-implies-sethood ch cc)
                                (let ((imf (dk-cite! 'image-membership-iff phi ff ch)))
                                  (dk-have! (caddr (caddr imf)) (lambda () (ew v) (dk-conj-close! dk-ass!)))
                                  (dk-have! (list 'IN ch gg) (lambda () (ty-and! (list 'IN ch 'SET) (caddr (caddr imf))) (if (dk-only! imf (caddr imf)) (prop)))))
                                (for-each (lambda (l) (dk-focus! l) (dk-ass!)) (dk-opened (lambda () (bu-mi ch))))))))))))
                (dk-cite! 'class-extensionality bgg '(PTS t))
                (dk-have! (list '== bgg '(PTS t)) (lambda () (subst (list '= bgg '(PTS t))) (qrfl)))
                (ew gg)
                (dk-conj-close! dk-ass!))))))))
(ty-qed! 'compact-t-continuous-onto)
