  ;; every chain has an upper bound
  (dk-have! (list 'FORALL 'ch_ (list 'IMPLIES (list 'IS-CHAIN ty-GRD ty-POR 'ch_) (list 'FORSOME 'u_ (list 'IS-UPPER-BOUND ty-GRD ty-POR 'ch_ 'u_))))
    (lambda ()
      (let* ((ch (cadddr (find-first (lambda (h) (dk-head-is? h 'IS-CHAIN)) (dk-peel!))))
