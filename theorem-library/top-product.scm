                                       (if (dk-only! pmq (list 'IN q '(PTS z)) (list 'IN (list 'f q) uu)) (prop))))))))))))))
               (dk-cite! 'top-open-of-local 'z pre)
               (dk-ass!))))))))
(ty-qed! 'tprod-hom-iff)

;; a map equal pointwise to a continuous map is continuous
(sp (make-wff (ty-alls '(s t g h)
  (ty-imps '((IS-HOM-TOP-SPACE s t g) (IN h (FUN (PTS s) (PTS t))) (FORALL tpq_ (IMPLIES (IN tpq_ (PTS s)) (= (h tpq_) (g tpq_)))))
    '(IS-HOM-TOP-SPACE s t h)))))
(dk-peel!)
(let ((hom '(IS-HOM-TOP-SPACE s t g))
      (eqs (dk-ctx-form '(FORALL tpq_ (IMPLIES (IN tpq_ (PTS s)) (= (h tpq_) (g tpq_)))))))
  (dk-project! '(IS-TOP-SPACE s) 'is-hom-top-space-def hom)
  (dk-project! '(IS-TOP-SPACE t) 'is-hom-top-space-def hom)
  (let ((pre (dk-project! '(FORALL u (IMPLIES (IN u (OPENS t)) (IN (PREIMAGE s g u) (OPENS s)))) 'is-hom-top-space-def hom)))
    (mac 'is-hom-top-space-def)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let* ((v (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (equal? (caddr x) '(OPENS t)))) (dk-peel!))))
                   (ph (list 'PREIMAGE 's 'h v)) (pg (list 'PREIMAGE 's 'g v)))
              (dk-apply! pre v)
              (dk-have! (list 'FORALL 'tpz_ (list 'IFF (list 'IN 'tpz_ ph) (list 'IN 'tpz_ pg)))
                (lambda ()
                  (let ((q (begin (di) (cadr (cadr (dk-goal))))))
                    (let ((m1 (dk-cite! 'preimage-membership 's 'h v q)) (m2 (dk-cite! 'preimage-membership 's 'g v q)))
                      (dk-iff! (lambda (gg) (equal? gg (list 'IN q pg)))
                        (lambda ()
                          (dk-have! (caddr m1) (lambda () (if (dk-only! m1 (list 'IN q ph)) (prop))))
                          (dk-split! (caddr m1))
                          (dk-apply! eqs q)
                          (dk-rewrite-h! (list 'IN (list 'h q) v) (list 'h q) (list 'g q))
                          (if (dk-only! m2 (list 'IN q '(PTS s)) (list 'IN (list 'g q) v)) (prop)))
                        (lambda ()
                          (dk-have! (caddr m2) (lambda () (if (dk-only! m2 (list 'IN q pg)) (prop))))
                          (dk-split! (caddr m2))
                          (dk-apply! eqs q)
                          (dk-rewrite-h! (list 'IN (list 'g q) v) (list 'g q) (list 'h q))
                          (if (dk-only! m1 (list 'IN q '(PTS s)) (list 'IN (list 'h q) v)) (prop))))))))
              (dk-cite! 'class-extensionality ph pg)
              (subst (list '= ph pg))
              (dk-ass!)))))))
(ty-qed! 'hom-top-space-ptwise-eq)

;; the universal property: continuous gf(k) : z -> tf(k) assemble into ONE continuous map into the product, with
