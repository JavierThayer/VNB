(define ty-gftyp '(FORALL tpk_ (IMPLIES (IN tpk_ ix) (IN (gf tpk_) (FUN (PTS z) (PTS (tf tpk_)))))))
(define (ty-gfval! k q)                ; k in ix, q in PTS z: ((gf k) q) in PTS (tf k)
  (dk-apply! (dk-ctx-form ty-gftyp) k)
  (dk-cite! 'fun-apply-type-c (list 'gf k) '(PTS z) (list 'PTS (list 'tf k)) q))
(define (ty-Fq-in! q)                  ; q in PTS z: (F q) in P
  (let ((fq (ty-Fq q)))
