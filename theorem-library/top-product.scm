;;; (5) ALEXANDER'S MAXIMAL COVER, FROM ZORN
;;; ===========================================================================
;; a finite subset of the union of a nonempty chain of sets (under inclusion) lies in one member
(define (ty-inbu g) (list 'FORALL 'tpe_ (list 'IMPLIES (list 'IN 'tpe_ g) '(FORSOME tpo_ (AND (IN tpo_ hh) (IN tpe_ tpo_))))))
(define (ty-insub g a) (list 'FORALL 'tpe2_ (list 'IMPLIES (list 'IN 'tpe2_ g) (list 'IN 'tpe2_ a))))
(define (ty-ch-body g)
  (list 'IMPLIES (ty-inbu g) (list 'FORSOME 'tpd_ (list 'AND '(IN tpd_ hh) (ty-insub g 'tpd_)))))
(define (ty-sub2in! g a) (dk-have! (ty-insub g a) (lambda () (let ((e (dk-di-var!))) (dk-cite! 'subset-mem-fwd g a e) (dk-ass!)))))
(define (ty-in2sub! g a)
  (let ((h (dk-ctx-form (ty-insub g a))))
    (dk-have! (list 'SUBSET g a) (lambda () (mac 'subset-def) (let ((e (dk-di-var!))) (dk-apply! h e) (dk-ass!))))))
(define ty-ch-cls (list 'COMP 'tpg_ (ty-ch-body 'tpg_)))
(define ty-ch-cmp '(FORALL tpa_ (IMPLIES (IN tpa_ hh) (FORALL tpb_ (IMPLIES (IN tpb_ hh) (OR (SUBSET tpa_ tpb_) (SUBSET tpb_ tpa_)))))))
(define (ty-union1-sub! s px un)        ; (SUBSET s un) for un = (UNION s px)
  (ty-subset! s un (lambda (q) (dk-cite! 'union-membership s px q) (if (apply dk-only! (filter (lambda (h) (dk-contains? h q)) (dk-asms))) (prop)))))
(define (ty-union-sub! s px un a)       ; (SUBSET un a) from (SUBSET s a) and the member x of px = (PAIR x x) in a
  (let ((x (cadr px)))
    (ty-subset! un a
      (lambda (q)
        (let ((um (dk-cite! 'union-membership s px q)))
          (use-em (list 'IN q s)
            (lambda () (dk-cite! 'subset-mem-fwd s a q) (dk-ass!))
            (lambda () (dk-have! (list 'IN q px) (lambda () (if (dk-only! um (list 'IN q un) (list 'NOT (list 'IN q s))) (prop))))
                       (dk-cite! 'pair-self-eq x q) (subst (list '= q x)) (dk-ass!))))))))
(define (ty-fin-step-setup! s x)       ; the finite-set induction step facts; returns (un . px)
  (let ((px (list 'PAIR x x)))
    (ty-and! (list 'IN x 'SET) (list 'IN x 'SET))
    (fact 'pairing x x)
    (ty-and! (list 'IN s 'SET) (list 'IN px 'SET))
    (fact 'union-set-closure s px)
    (dk-cite! 'pair-self-member x)
    (cons (list 'UNION s px) px)))
(define (ty-step-claim cls)
  (list 'FORALL 'tps_ (list 'IMPLIES (list 'AND '(IN tps_ SET) (list 'AND '(IN (CARD tps_) NN) (list 'IN 'tps_ cls)))
    (list 'FORALL 'tpx_ (list 'IMPLIES '(AND (IN tpx_ SET) (NOT (IN tpx_ tps_))) (list 'IN '(UNION tps_ (PAIR tpx_ tpx_)) cls))))))
(define (ty-induct! cls base! step! g)  ; finite-set induction over CLS: base and step proofs, then the instance at G
  (let ((base (list 'IN 'EMPTY-SET cls)) (step (ty-step-claim cls)))
    (dk-have! base base!)
    (dk-have! step step!)
    (ty-and! base step)
    (let ((ind (dk-fact! 'finite-set-induction cls)))
      (ty-and! (list 'IN g 'SET) (list 'IN (list 'CARD g) 'NN))
      (comp-me (dk-apply! ind g)))))

(sp (make-wff (ty-alls '(hh) (ty-imps (list '(FORSOME tph_ (IN tph_ hh)) ty-ch-cmp)
   (list 'FORALL 'tpf_ (list 'IMPLIES '(IN tpf_ SET) (list 'IMPLIES '(IN (CARD tpf_) NN)
     (list 'IMPLIES '(SUBSET tpf_ (BIG-UNION tpv_ hh tpv_)) '(FORSOME tpd_ (AND (IN tpd_ hh) (SUBSET tpf_ tpd_)))))))))))
(dk-peel!)
(let ((cmp (dk-ctx-form ty-ch-cmp))
      (g0 (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'SET))) (dk-asms)))))
  (ty-induct! ty-ch-cls
    (lambda ()
      (for-each (lambda (l) (dk-focus! l)
                  (if (dk-head-is? (dk-goal) 'IN) (begin (fact 'empty-set-is-set) (ass))
                      (begin (di) (let ((a0 (dk-skolem! (dk-ctx-form '(FORSOME tph_ (IN tph_ hh))) #t)))
                                    (fact 'empty-subset-any a0) (ty-sub2in! 'EMPTY-SET a0) (ew a0) (dk-conj-close! dk-ass!)))))
                (dk-opened (lambda () (comp-mi)))))
    (lambda ()
      (dk-peel!) (dk-split-all!)
      (let* ((g (dk-goal)) (un0 (cadr g)) (s (cadr un0)) (x (cadr (caddr un0)))
             (up (ty-fin-step-setup! s x)) (un (car up)) (px (cdr up)))
        (comp-me (list 'IN s ty-ch-cls))
        (let ((ih (dk-pick (lambda (h) (and (dk-head-is? h 'IMPLIES) (equal? (cadr h) (ty-inbu s)))) "IH")))
          (for-each
            (lambda (l)
              (dk-focus! l)
              (if (dk-head-is? (dk-goal) 'IN) (ass)
                  (begin
                    (di)
                    (ty-union1-sub! s px un)
                    (let ((hyp (dk-ctx-form (ty-inbu un))))
                      (dk-have! (ty-inbu s) (lambda () (let ((e (dk-di-var!))) (dk-cite! 'subset-mem-fwd s un e) (dk-apply! hyp e) (dk-ass!)))))
                    (detach! ih)
                    (let* ((a1 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'tpd_) (dk-contains? h s))) "IH result") #t)))
                      (let ((im (dk-cite! 'union-membership s px x)))
                        (dk-have! (list 'IN x un) (lambda () (if (dk-only! im (list 'IN x px)) (prop)))))
                      (let* ((a2 (dk-skolem! (dk-apply! (dk-ctx-form (ty-inbu un)) x) #t)))
                        (dk-apply! cmp a1 a2)
                        (use-em (list 'SUBSET a1 a2)
                          (lambda () (ty-in2sub! s a1) (dk-cite! 'subset-trans s a1 a2) (ty-union-sub! s px un a2) (ty-sub2in! un a2) (ew a2) (dk-conj-close! dk-ass!))
                          (lambda ()
                            (dk-have! (list 'SUBSET a2 a1) (lambda () (dk-only! (list 'OR (list 'SUBSET a1 a2) (list 'SUBSET a2 a1)) (list 'NOT (list 'SUBSET a1 a2))) (prop)))
                            (dk-cite! 'subset-mem-fwd a2 a1 x)
                            (ty-in2sub! s a1) (ty-union-sub! s px un a1) (ty-sub2in! un a1) (ew a1) (dk-conj-close! dk-ass!))))))))
            (dk-opened (lambda () (comp-mi)))))))
    g0)
  (let ((sub (dk-ctx-form (list 'SUBSET g0 '(BIG-UNION tpv_ hh tpv_)))))
    (dk-have! (ty-inbu g0)
      (lambda () (let ((e (dk-di-var!))) (dk-cite! 'subset-mem-fwd g0 '(BIG-UNION tpv_ hh tpv_) e)
                   (let* ((ld (dk-landed (lambda () (bu-me (list 'IN e '(BIG-UNION tpv_ hh tpv_))))))
                          (a2 (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'hh))) ld))))
                     (ew a2) (dk-conj-close! dk-ass!))))))
  (detach! (dk-pick (lambda (h) (and (dk-head-is? h 'IMPLIES) (dk-contains? h 'tpd_) (dk-contains? h g0))) "the instance"))
  (let ((a (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h 'tpd_) (dk-contains? h 'tpe2_))) "the member") #t)))
    (ty-in2sub! g0 a)
    (ew a) (dk-conj-close! dk-ass!)))
(ty-qed! 'chain-finite-in-member)

;; ALEXANDER: an open cover of a topological space with no finite subcover is contained in a MAXIMAL one, and
;; adding any open set outside the maximal cover produces a finite subcover (zorn-lemma)
(define ty-O '(OPENS s))
(define ty-GRD '(SEP tpm_ (POWER (OPENS s)) (AND (SUBSET c0 tpm_) (NOT (HAS-FINITE-SUBCOVER s tpm_)))))
(define ty-POR (list 'SEP 'tpr_ (list 'CARTESIAN ty-GRD ty-GRD) '(SUBSET (NTH 1 tpr_) (NTH 2 tpr_))))
(define (ty-pow-in! m)                 ; (IN m (POWER O)) from (SUBSET m O)
  (let ((g (list 'IN m (list 'POWER ty-O))))
    (if (not (dk-asm? g))
        (begin
          (dk-cite! 'subclass-of-set-is-set m ty-O)
          (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ m) (list 'IN 'z_ ty-O)))
            (lambda () (let ((e (dk-di-var!))) (dk-cite! 'subset-mem-fwd m ty-O e) (dk-ass!))))
          (dk-cite! 'power-mem-intro ty-O m)))
    g))
(define (ty-pow-out! m)                ; (IN m (POWER O)) in context: (SUBSET m O)
  (let ((g (list 'SUBSET m ty-O)))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (mac 'subset-def) (let ((e (dk-di-var!))) (dk-cite! 'power-mem-in ty-O m e) (dk-ass!)))))
    g))
(define (ty-grd-in! m)                 ; goal-free: land (IN m GRD) from m subset O, c0 subset m, NOT HAS-FIN
  (ty-pow-in! m)
  (dk-have! (list 'IN m ty-GRD) (lambda () (in-sep! (lambda () (ass)) (lambda () (dk-conj-close! dk-ass!))))))
(define (ty-grd-out! m)                ; (IN m GRD) in context: the three facts
  (let ((c (list 'AND (list 'IN m (list 'POWER ty-O)) (list 'AND (list 'SUBSET 'c0 m) (list 'NOT (list 'HAS-FINITE-SUBCOVER 's m))))))
    (if (not (dk-asm? (list 'SUBSET 'c0 m)))
        (begin (dk-have! c (lambda () (sep-me (dk-ctx-form (list 'IN m ty-GRD))) (dk-split-all!) (dk-conj-close! dk-ass!)))
               (dk-split-all! (list c))
               (ty-pow-out! m)))))
(define (ty-por-in! a b)               ; a, b in GRD, (SUBSET a b): (IN (LIST a b) POR)
  (dk-cite! 'pair-in-cartesian ty-GRD ty-GRD a b)
  (dk-have! (list 'IN (list 'LIST a b) ty-POR) (lambda () (in-sep! (lambda () (ass)) (lambda () (ty-nth-all!) (dk-ass!))))))
(define (ty-por-out! a b)              ; (IN (LIST a b) POR) in context: (SUBSET a b)
  (let ((g (list 'SUBSET a b)))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (sep-me (dk-ctx-form (list 'IN (list 'LIST a b) ty-POR))) (dk-split-all!)
                               (ty-nth-h! (dk-pick (lambda (h) (and (dk-head-is? h 'SUBSET) (dk-contains? h 'NTH))) "the order"))
                               (dk-ass!))))
