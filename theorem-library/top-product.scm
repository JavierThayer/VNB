                                 (begin
                                   (mac 'subset-def)
                                   (let ((q (dk-di-var!)))
                                     (dk-cite! 'power-mem-in '(POWER (PTS z)) '(OPENS z) w)
                                     (dk-cite! 'power-mem-in '(PTS z) w q)
                                     (dk-cite! 'fun-apply-type-c 'f '(PTS z) ty-P q)
