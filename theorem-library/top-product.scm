;;; TYCHONOFF'S THEOREM: a product of compact topological spaces is compact.
;;; Alexander's argument at the subbasic constraints: if an open cover had no finite subcover, extend it to a maximal
;;; such cover M (alexander-maximal-cover); each factor i has a point x(i) outside every V whose cylinder lies in M
;;; (tychonoff-factor-point, compactness of the factor), chosen by CHOICE; x lies in some U of M, hence in a finite box
;;; inside U; no cylinder of that box is in M, so by maximality each, together with finitely many members of M, covers
;;; the product (finite-cover-outside); finitely many such families and U cover the product, against the choice of M.
(define ty-xsep (lambda (i mm) (list 'SEP 'tpe9_ (list 'PTS (list 'tf i))
  (list 'FORALL 'tpv5_ (list 'IMPLIES (list 'IN 'tpv5_ (list 'OPENS (list 'tf i)))
    (list 'IMPLIES (list 'IN (ty-sbox i 'tpv5_) mm) '(NOT (IN tpe9_ tpv5_))))))))
