                    (subst (list '= Dz Ez))
                    (dk-ass!))))))
          (for-each (lambda (acd-g1) (dk-have! (list 'HOLOMORPHIC-ON V acd-g1) (lambda () (dk-holomorphic! V acd-g1)))
                                (fact 'holomorphic-on-in-fun V acd-g1) (fact 'holomorphic-on-continuous V acd-g1))
                    (list G dG h2 hd))
          ;; the vertices lie in V
          (for-each
            (lambda (vx wx)
              (let ((cr (ao-cr (list '- vx u) (list '- wx u))))
                (an-cc! (list '- wx u)) (an-cc! (list '- vx u)) (fact 'rr-zero-in) (fact 'rr-subset-cc 0)
                (fact 'cc-conjugate-closed (list '- wx u)) (fact 'cc-conjugate-fixes-rr 0) (dk-cite! 'cc-im-zero)
                (dk-have! (list 'NOT (list '= vx u))
                  (lambda () (di)
                             (dk-have! (list '= (list '- vx u) 0) (lambda () (subst (list '= vx u)) (crs)))
                             (let* ((h1 (dk-rewrite-h! (list '< 0 cr) (list '- vx u) 0)))
                               (dk-have! (list '= (list '* 0 (list 'conjugate (list '- wx u))) 0) (lambda () (crs)))
                               (let* ((h2x (dk-rewrite-h! h1 (list '* 0 (list 'conjugate (list '- wx u))) 0))
                                      (h3 (dk-rewrite-h! h2x '(imag-part 0) 0)))
                                 (dk-absurd! h3)))))
                (dk-have! (list 'IN vx V)
                  (lambda () (mac 'difference-membership)
                             (dk-conj-close!
                               (lambda ()
                                 (if (dk-asm? (dk-goal)) (dk-ass!)
                                     (begin (di)
                                            (let ((sb (dk-cite! 'singleton-membership u vx)))
                                              (ai sb) (detach! (list 'IMPLIES (cadr sb) (caddr sb))) (dk-split-all!)
                                              (ai (list 'NOT (list '= vx u))))))))))
                (fact 'fun-apply-type-c G V 'CC vx)))
            (list b c a) (list a b c))
          ;; TRI-INT(dG) = 0: on each segment the integral of a derivative
          (fact 'rr-zero-in) (fact 'rr-one-in)
          (for-each (lambda (t) (dk-have! (list 'IN t '(CCINT 0 1))
                                  (lambda () (mac 'ccint-membership) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (arith)))))))
                    (list 0 1))
          (for-each
            (lambda (pq)
              (let* ((p (car pq)) (q2 (cadr pq)) (SP (list 'SEG-PATH p q2)) (SD (list 'SEG-DERIV p q2)))
                (fact 'seg-path-is-road p q2)
                (dk-cite! 'seg-path-apply p q2 1) (dk-cite! 'seg-path-apply p q2 0)
                (dk-have! (list '= (list '+ p (list '* 1 (list '- q2 p))) q2) (lambda () (crs)))
                (dk-have! (list '= (list '+ p (list '* 0 (list '- q2 p))) p) (lambda () (crs)))
                (let ((lod (dk-cite! 'line-int-of-derivative V G dG SP SD 0 1)))
                  (dk-have! (list '= (list 'SEG-INT dG p q2) (list '- (list G q2) (list G p)))
                    (lambda () (subst (dk-cite! 'seg-int-unfold dG p q2))
