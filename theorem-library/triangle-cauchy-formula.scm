;;; triangle-cauchy-formula.scm -- WAVE 2 (2026-10-27..30), wired 2026-10-30 from scratchpad/ch3e/ch3e-cif.scm, scratchpad/ch3e/ch3e-cif2.scm.
;;; Library: complex-analysis.

;;; ch3e-cif.scm -- CH3-E: Proposition 3.41, the Cauchy integral formula over a positively oriented
;;; triangle.  Loaded after ch3e-angle.scm, ch3e-orient.scm, ch3e-wind.scm.  Helper prefix ac-.
;;; f(u) = (1/2 pi i) TRI-INT(w |-> f(w)/(w - u), a, b, c) for u interior to conv{a, b, c} within U.
;;; Proof: f(w) = f(u) + q(w)(w - u) (holomorphic-difference-quotient); TRI-INT(q) = 0 by Goursat with
;;; an exceptional point; TRI-INT(1/(w - u)) = 2 pi i (triangle-tri-int-interior).  The integrand lives
;;; on U \ {u}; the sums are taken along the triangle road, whose trace misses u.

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

;;; ---- helper defines COPIED 2026-10-30 (wave-2 integration) from ch3e/ch3e-angle.scm, ch3e/ch3e-orient.scm, ch3e/ch3e-wind.scm:
;;; the probe loaded this chain in ONE environment; load.scm gives each file its own.
(define (an-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "an-pick: nothing matching" what) (car l))))
(define (an-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (an-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (an-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))
(define (ao-cr z w) (list 'imag-part (list '* z (list 'conjugate w))))
(define (ao-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define ao-int '(INTERIOR CC-MS (CONV3 aoa_ aob_ aoc_)))
(define (aw-fu u) (list 'VNB-LAMBDA 'wnw_ (list 'DIFFERENCE 'CC (list 'SINGLETON u)) (list 'recip (list '- 'wnw_ u))))
;;; ---- end of copied helpers ----

(define (ac-h Uo f u) (list 'VNB-LAMBDA 'aotw_ (list 'DIFFERENCE Uo (list 'SINGLETON u)) (list '* (list f 'aotw_) (list 'recip (list '- 'aotw_ u)))))
(sp (make-wff
  (list 'FORALL 'aoopen_ (list 'FORALL 'aof_ (list 'IMPLIES '(HOLOMORPHIC-ON aoopen_ aof_)
   (list 'FORALL 'aoa_ (list 'IMPLIES '(IN aoa_ CC) (list 'FORALL 'aob_ (list 'IMPLIES '(IN aob_ CC) (list 'FORALL 'aoc_ (list 'IMPLIES '(IN aoc_ CC)
   (list 'IMPLIES '(NOT (= aoa_ aob_)) (list 'IMPLIES '(NOT (= aob_ aoc_)) (list 'IMPLIES '(NOT (= aoc_ aoa_))
   (list 'IMPLIES '(POSITIVELY-ORIENTED aoa_ aob_ aoc_)
   (list 'IMPLIES '(SUBSET (CONV3 aoa_ aob_ aoc_) aoopen_)
   (list 'FORALL 'aou_ (list 'IMPLIES (list 'IN 'aou_ ao-int)
     (list '= '(aof_ aou_) (list '* '(recip (* (* 2 PI) +i)) (list 'TRI-INT (ac-h 'aoopen_ 'aof_ 'aou_) 'aoa_ 'aob_ 'aoc_)))))))))))))))))))))
(dk-peel!)
(let loop () (if (and (pair? (dk-goal)) (memq (car (dk-goal)) '(IMPLIES FORALL))) (begin (di) (loop))))
(let* ((a 'aoa_) (b 'aob_) (c 'aoc_) (Uo 'aoopen_) (f 'aof_)
       (u (cadr (an-pick "the interior point" (lambda (x) (and (ao-op? x 'IN 3) (equal? (caddr x) ao-int))))))
       (T3 (list 'CONV3 a b c))
       (V (list 'DIFFERENCE Uo (list 'SINGLETON u)))
       (Pu (list 'DIFFERENCE 'CC (list 'SINGLETON u)))
       (fu (aw-fu u))
       (h (ac-h Uo f u))
       (TR '(TRI-ROAD aoa_ aob_ aoc_)) (TRD '(TRI-ROAD-DERIV aoa_ aob_ aoc_))
       (TT (list 'TRACE TR 0 3))
       (segs (list (list a b) (list b c) (list c a)))
       (straces (map (lambda (pq) (list 'TRACE (list 'SEG-PATH (car pq) (cadr pq)) 0 1)) segs)))
  ;; the open set, the point, the vertices
  (fact 'holomorphic-on-open Uo f) (fact 'holomorphic-on-in-fun Uo f) (fact 'holomorphic-on-continuous Uo f)
  (fact 'cc-open-subset-cc Uo)
  (fact 'cc-is-metric-space)
  (let ((ii (dk-cite! 'interior-in-set 'CC-MS))) (dk-apply! ii T3))
  (dk-fact! 'subset-mem-fwd ao-int T3 u)
  (dk-fact! 'subset-mem-fwd T3 Uo u)
  (dk-split-all! (list (dk-cite! 'conv3-vertices-in a b c)))
  (for-each (lambda (acc-vn) (dk-fact! 'subset-mem-fwd T3 Uo acc-vn)) (list a b c))
  (dk-have! (list 'IN u 'CC) (lambda () (fact 'subset-mem-fwd Uo 'CC u) (dk-ass!)))
  ;; the segments miss u; their traces lie in U, in CC \ {u}, in U \ {u}
  (let ((pre (dk-cite! 'triangle-crosses-positive a b c)))
    (dk-split-all! (list (dk-apply! pre u))))
  (for-each (lambda (pq) (dk-cite! 'seg-trace-punctured (car pq) (cadr pq) u)) segs)
  (dk-split-all! (list (dk-cite! 'seg-trace-in-conv3 a b c)))
  (for-each (lambda (st) (fact 'subset-trans st T3 Uo)) straces)
  (define (sub-V! X)                          ; X subset U and X subset CC \ {u}  ==>  X subset U \ {u}
    (dk-have! (list 'SUBSET X V)
      (lambda ()
        (let* ((z (subset-by-element!)))
          (dk-fact! 'subset-mem-fwd X Uo z) (dk-fact! 'subset-mem-fwd X Pu z)
          (let ((bi (dk-cite! 'cc-punctured-membership u z)))
            (ai bi) (detach! (list 'IMPLIES (cadr bi) (caddr bi))) (dk-split-all!))
          (dk-have! (list 'NOT (list 'IN z (list 'SINGLETON u)))
            (lambda () (di) (let ((sb (dk-cite! 'singleton-membership u z)))
                              (ai sb) (detach! (list 'IMPLIES (cadr sb) (caddr sb))) (dk-split-all!)
                              (ai (list 'NOT (list '= z u))))))
          (mac 'difference-membership) (dk-conj-close! (lambda () (dk-ass!)))))))
  (for-each sub-V! straces)
  ;; the trace of the triangle road
  (let ((te (dk-cite! 'tri-road-trace a b c)))
    (define (sub-TT! X)
      (dk-have! (list 'SUBSET TT X)
        (lambda ()
          (let* ((z (subset-by-element!))
                 (m (dk-rewrite-h! (list 'IN z TT) TT (caddr te)))
                 (o1 (car (dk-landed* (lambda () (mac-h 'union-membership m))))))
            (use-cases (list (cadr o1) (caddr o1))
              (lambda ()
                (let ((o2 (car (dk-landed* (lambda () (mac-h 'union-membership (cadr o1)))))))
                  (use-cases (list (cadr o2) (caddr o2))
                    (lambda () (dk-fact! 'subset-mem-fwd (car straces) X z) (dk-ass!))
                    (lambda () (dk-fact! 'subset-mem-fwd (cadr straces) X z) (dk-ass!)))))
              (lambda () (dk-fact! 'subset-mem-fwd (caddr straces) X z) (dk-ass!)))))))
    (for-each sub-TT! (list Uo Pu V)))
  (fact 'tri-road-is-road a b c)
  ;; the difference quotient q: f(w) - f(u) = q(w) (w - u)
  (let* ((dq (dk-cite! 'holomorphic-difference-quotient Uo f))
         (q (dk-skolem! (dk-apply! dq u) #t))
         (g1 (list 'RESTRICT q V))
         (g2 (list 'VNB-LAMBDA 'aotw_ V (list '* (list f u) (list 'recip (list '- 'aotw_ u)))))
         (fV (list 'VNB-LAMBDA 'aotw_ V (list 'recip (list '- 'aotw_ u))))
         (Z2 '(* (* 2 PI) +i))
         (dqlaw (an-pick "the quotient law" (lambda (x) (and (ao-op? x 'FORALL 3) (dk-contains? x q) (dk-contains? x f))))))
    (dk-split-all!)
    (fact 'holomorphic-on-in-fun V g1) (fact 'holomorphic-on-continuous V g1) (fact 'holomorphic-on-open V g1)
    (define (in-V! z)                         ; z in V in context: z in U, z /= u, z - u /= 0
      (let ((bi (dk-cite! 'difference-membership Uo (list 'SINGLETON u) z)))
        (dk-have! (list 'AND (list 'IN z Uo) (list 'NOT (list 'IN z (list 'SINGLETON u))))
          (lambda () (ai bi) (detach! (list 'IMPLIES (cadr bi) (caddr bi))) (dk-ass!)))
        (dk-split-all! (list (list 'AND (list 'IN z Uo) (list 'NOT (list 'IN z (list 'SINGLETON u)))))))
      (dk-fact! 'subset-mem-fwd Uo 'CC z)
      (an-cc! (list '- z u))
      (dk-have! (list 'NOT (list '= (list '- z u) 0))
        (lambda () (di)
                   (dk-fact! 'cc-sub-zero-eq z u)
                   (dk-have! (list 'IN z (list 'SINGLETON u))
                     (lambda () (mac 'singleton-membership) (fact 'cc-is-set)
                                (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!) (begin (fact 'subset-set 'CC) (fact 'subset-mem-fwd 'CC 'SET z) (dk-ass!)))))))
                   (ai (list 'NOT (list 'IN z (list 'SINGLETON u)))))))
    (dk-have! (list 'SUBSET V 'CC) (lambda () (let ((z (subset-by-element!))) (in-V! z) (dk-ass!))))
    (dk-have! (list 'FORALL 'aoty_ (list 'IMPLIES (list 'IN 'aoty_ V) (list 'NOT (list '= (list '- 'aoty_ u) 0))))
      (lambda () (let ((z (dk-di-var!))) (in-V! z) (dk-ass!))))
    (dk-have! (list 'FORALL 'aoty_ (list 'IMPLIES (list 'IN 'aoty_ V) (list 'IN 'aoty_ Uo)))
      (lambda () (let ((z (dk-di-var!))) (in-V! z) (dk-ass!))))
    (for-each (lambda (g) (dk-have! (list 'HOLOMORPHIC-ON V g) (lambda () (dk-holomorphic! V g)))
                          (fact 'holomorphic-on-in-fun V g) (fact 'holomorphic-on-continuous V g))
              (list h g2 fV))
    ;; pointwise identities
    (dk-have! (list 'FORALL 'aotz_ (list 'IMPLIES (list 'IN 'aotz_ V) (list '== (list h 'aotz_) (list '+ (list g1 'aotz_) (list g2 'aotz_)))))
      (lambda ()
        (let* ((z (dk-di-var!)) (Zd (list '- z u)))
          (in-V! z)
          (dk-lam-b!)
          (subst (dk-cite! 'restrict-apply q V z))
          (dk-apply! dqlaw z)
          (fact 'fun-apply-type-c f Uo 'CC z) (fact 'fun-apply-type-c f Uo 'CC u) (fact 'fun-apply-type-c q Uo 'CC z)
          (an-and! (list 'IN Zd 'CC) (list 'NOT (list '= Zd 0)))
          (fact 'cc-recip-closed Zd) (fact 'cc-recip-inverse Zd)
          (let* ((r (dk-name! (list 'recip Zd) 'CC))
                 (inv (dk-rewrite-h! (list '= (list '* Zd (list 'recip Zd)) 1) (list 'recip Zd) r))
                 (fz (dk-name! (list f z) 'CC)) (f0 (dk-name! (list f u) 'CC)) (qz (dk-name! (list q z) 'CC))
                 (dqz (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (list '= (list '- (list f z) (list f u)) (list '* (list q z) Zd))
                                                                  (list f z) fz) (list f u) f0) (list q z) qz)))
            (subst (list '= (list 'recip Zd) r))
            (subst (list '= (list f z) fz)) (subst (list '= (list f u) f0)) (subst (list '= (list q z) qz))
            (let ((lhs (list '* fz r)) (rhs (list '+ qz (list '* f0 r))))
              (dk-have! (list '= lhs rhs)
                (lambda ()
                  (dk-have! (list '= lhs (list '+ (list '* (list '- fz f0) r) (list '* f0 r))) (lambda () (crs)))
                  (subst (list '= lhs (list '+ (list '* (list '- fz f0) r) (list '* f0 r))))
                  (subst dqz)
                  (dk-have! (list '= (list '* (list '* qz Zd) r) (list '* qz (list '* Zd r))) (lambda () (crs)))
                  (subst (list '= (list '* (list '* qz Zd) r) (list '* qz (list '* Zd r))))
                  (subst inv)
                  (crs)))
              (subst (list '= lhs rhs))
              (if (not (proof-done? *ps*)) (qrfl)))))))
    (dk-have! (list 'FORALL 'aotz_ (list 'IMPLIES (list 'IN 'aotz_ V) (list '== (list g2 'aotz_) (list '* (list f u) (list fV 'aotz_)))))
      (lambda () (let ((z (dk-di-var!))) (in-V! z) (dk-lam-b!) (if (not (proof-done? *ps*)) (qrfl)))))
    (dk-have! (list 'FORALL 'aotz_ (list 'IMPLIES (list 'IN 'aotz_ TT) (list '== (list fV 'aotz_) (list fu 'aotz_))))
      (lambda () (let ((z (dk-di-var!)))
                   (dk-fact! 'subset-mem-fwd TT V z) (dk-fact! 'subset-mem-fwd TT Pu z)
                   (dk-lam-b!) (if (not (proof-done? *ps*)) (qrfl)))))
    (dk-have! (list 'FORALL 'aotz_ (list 'IMPLIES (list 'IN 'aotz_ TT) (list '== (list g1 'aotz_) (list q 'aotz_))))
      (lambda () (let ((z (dk-di-var!)))
                   (dk-fact! 'subset-mem-fwd TT V z)
                   (subst (dk-cite! 'restrict-apply q V z)) (if (not (proof-done? *ps*)) (qrfl)))))
    ;; the integrand on CC \ {u}
    (dk-cite! 'winding-integrand-holomorphic u)
    (fact 'holomorphic-on-in-fun Pu fu) (fact 'holomorphic-on-continuous Pu fu)
    (dk-have! (list 'SUBSET Pu 'CC)
      (lambda () (let* ((z (subset-by-element!)) (bi (dk-cite! 'cc-punctured-membership u z)))
                   (ai bi) (detach! (list 'IMPLIES (cadr bi) (caddr bi))) (dk-split-all!) (dk-ass!))))
    ;; the integrals
    (fact 'fun-apply-type-c f Uo 'CC u)
    (let* ((LI (lambda (g) (list 'LINE-INT g TR TRD 0 3)))
           (ls (begin (dk-apply! (dk-cite! 'line-int-sum V g1 g2 TR TRD 0 3) h)))
           (lsc (begin (dk-apply! (dk-cite! 'line-int-scalar V fV TR TRD 0 3) (list f u) g2)))
           (dc1 (begin (dk-apply! (dk-cite! 'line-int-domain-congruence Pu fu) TR TRD 0 3 V fV)))
           (dc2 (begin (dk-apply! (dk-cite! 'line-int-domain-congruence Uo q) TR TRD 0 3 V g1)))
           (tiq (begin (dk-cite! 'tri-int-is-line-int Uo q a b c)))
           (tif (dk-cite! 'tri-int-is-line-int Pu fu a b c))
           (tih (begin (dk-cite! 'tri-int-is-line-int V h a b c)))
           (gq (begin (dk-cite! 'goursat-triangle-except Uo q u a b c)))
           (tf (dk-cite! 'triangle-tri-int-interior a b c u)))
      (subst tih) (subst ls) (subst dc2)
      (subst (list '= (LI q) (list 'TRI-INT q a b c))) (subst gq)
      (subst lsc) (subst dc1)
      (subst (list '= (LI fu) (list 'TRI-INT fu a b c))) (subst tf)
      (dk-split-all! (list (dk-cite! 'pi-pos)))
      (fact 'cc-i-in) (an-rr! '(* 2 PI)) (fact 'rr-subset-cc '(* 2 PI)) (an-cc! Z2)
      (dk-have! '(NOT (= (* 2 PI) 0)) (lambda () (di) (dk-absurd! '(= (* 2 PI) 0) '(< 0 PI))))
      (dk-have! '(NOT (= +i 0)) (lambda () (arith)))
      (dk-fact! 'cc-mul-nonzero '(* 2 PI) '+i)
      (an-and! (list 'IN Z2 'CC) (list 'NOT (list '= Z2 0)))
      (fact 'cc-recip-inverse Z2) (fact 'cc-recip-closed Z2)
      (fact 'fun-apply-type-c f Uo 'CC u)
      (let* ((r (dk-name! (list 'recip Z2) 'CC))
             (inv (dk-rewrite-h! (list '= (list '* Z2 (list 'recip Z2)) 1) (list 'recip Z2) r))
             (zv (dk-name! Z2 'CC))
             (inv2 (dk-rewrite-h! inv Z2 zv))
             (f0 (dk-name! (list f u) 'CC)))
        (subst (list '= (list 'recip Z2) r)) (subst (list '= Z2 zv)) (subst (list '= (list f u) f0))
        (dk-have! (list '= (list '* r (list '+ 0 (list '* f0 zv))) (list '* f0 (list '* zv r))) (lambda () (crs)))
        (subst (list '= (list '* r (list '+ 0 (list '* f0 zv))) (list '* f0 (list '* zv r))))
        (subst inv2)
        (crs)))))
(qed 'triangle-cauchy-formula)
  

