                               (subst (list '= (list SP 1) (list '+ p (list '* 1 (list '- q2 p)))))
                               (subst (list '= (list SP 0) (list '+ p (list '* 0 (list '- q2 p)))))
                               (subst (list '= (list '+ p (list '* 1 (list '- q2 p))) q2))
                               (subst (list '= (list '+ p (list '* 0 (list '- q2 p))) p))
                               (if (not (proof-done? *ps*)) (rfl)))))))
            segs)
          (dk-have! (list '= (list 'TRI-INT dG a b c) 0)
            (lambda () (mac 'TRI-INT)
                       (for-each (lambda (pq) (subst (list '= (list 'SEG-INT dG (car pq) (cadr pq)) (list '- (list G (cadr pq)) (list G (car pq)))))) segs)
                       (let* ((ga (dk-name! (list G a) 'CC)) (gb (dk-name! (list G b) 'CC)) (gc (dk-name! (list G c) 'CC)))
                         (subst (list '= (list G a) ga)) (subst (list '= (list G b) gb)) (subst (list '= (list G c) gc))
                         (crs))))
          ;; hd = h2 + dG on V
          (dk-have! (list 'FORALL 'aotz_ (list 'IMPLIES (list 'IN 'aotz_ V) (list '== (list hd 'aotz_) (list '+ (list h2 'aotz_) (list dG 'aotz_)))))
            (lambda ()
              (let* ((z (dk-di-var!)) (Zd (list '- z u)))
                (in-V! z)
                (dk-lam-b!)
                (an-and! (list 'IN Zd 'CC) (list 'NOT (list '= Zd 0)))
                (fact 'cc-recip-closed Zd)
                (fact 'fun-apply-type-c f Uo 'CC z) (fact 'fun-apply-type-c fdv Uo 'CC z)
                (let* ((r (dk-name! (list 'recip Zd) 'CC)) (fz (dk-name! (list f z) 'CC)) (gz (dk-name! (list fdv z) 'CC)))
                  (subst (list '= (list 'recip Zd) r)) (subst (list '= (list f z) fz)) (subst (list '= (list fdv z) gz))
                  (let ((acd-g2 (dk-goal)))
                    (dk-have! (list '= (cadr acd-g2) (caddr acd-g2)) (lambda () (crs)))
                    (subst (list '= (caddr acd-g2) (cadr acd-g2)))
                    (if (not (proof-done? *ps*)) (qrfl)))))))
          (let* ((LI (lambda (acd-g3) (list 'LINE-INT acd-g3 TR TRD 0 3)))
                 (ls (begin (dk-apply! (dk-cite! 'line-int-sum V h2 dG TR TRD 0 3) hd)))
                 (tih (dk-cite! 'tri-int-is-line-int V hd a b c))
                 (ti2 (dk-cite! 'tri-int-is-line-int V h2 a b c))
                 (tig (dk-cite! 'tri-int-is-line-int V dG a b c))
                 (c41 (begin (dk-apply! (dk-cite! 'triangle-cauchy-formula Uo fdv a b c) u)))
                 (du (begin (dk-apply! (list 'FORALL 'aoty_ (list 'IMPLIES (list 'IN 'aoty_ Uo) (list 'IS-DIFF-ON 'CC-NORMED-FIELD Uo f 'aoty_ (list fdv 'aoty_)))) u)))
                 (de (dk-cite! 'cc-deriv-on-of-is-diff-on Uo f u (list fdv u))))
            (subst de)
            (subst c41)
            (subst tih) (subst ls)
            (subst (list '= (LI dG) (list 'TRI-INT dG a b c)))
            (subst (list '= (list 'TRI-INT dG a b c) 0))
            (subst (list '= (LI h2) (list 'TRI-INT h2 a b c)))
            (fact 'cc-i-in) (dk-split-all! (list (dk-cite! 'pi-pos)))
            (dk-cite! 'line-int-in-cc V h2 TR TRD 0 3)
            (dk-rewrite-h! (list 'IN (LI h2) 'CC) (LI h2) (list 'TRI-INT h2 a b c))
            (let* ((t2 (dk-name! (list 'TRI-INT h2 a b c) 'CC)))
              (subst (list '= (list 'TRI-INT h2 a b c) t2))
              (let ((acd-g4 (dk-goal)))
                (if (not (proof-done? *ps*))
                    (let* ((Rr '(recip (* (* 2 PI) +i))))
                      (an-rr! '(* 2 PI)) (fact 'rr-subset-cc '(* 2 PI)) (an-cc! '(* (* 2 PI) +i))
                      (dk-have! '(NOT (= (* 2 PI) 0)) (lambda () (di) (dk-absurd! '(= (* 2 PI) 0) '(< 0 PI))))
                      (dk-have! '(NOT (= +i 0)) (lambda () (arith)))
                      (fact 'rr-subset-cc '(* 2 PI))
                      (dk-fact! 'cc-mul-nonzero '(* 2 PI) '+i)
                      (an-and! '(IN (* (* 2 PI) +i) CC) '(NOT (= (* (* 2 PI) +i) 0)))
                      (fact 'cc-recip-closed '(* (* 2 PI) +i))
                      (let ((rv (dk-name! Rr 'CC)))
                        (subst (list '= Rr rv))
                        (crs)))))))))))
