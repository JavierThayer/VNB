;;; mb67-prod.scm -- countable products of metric spaces (M-B67, 2026-10-26): PRODUCT-METRIC-W of a sequence of
;;; metric spaces with a summable weight preserves completeness, separability, hence Polishness.
;;;   product-coord-le, product-coord-cauchy, product-complete, product-separable, product-polish
;;; Library: measure.  Helper prefixes mr- (copied) and mpr-.
;;; Load window: after product-convergence (product-*), bdd-metric laws, riesz-markov-model (rmm-nn-choice),
;;; mb67-baire (baire-code-prefix), mb4-vocab (IS-POLISH).
(define (mr-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (mr-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (mr-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
(define (mr-iff-parts! iff)
  ;; the conjunct equal to the focus GOAL (if any) is projected LAST: proving it closes the leaf, and a
  ;; projection after that would fire on a sibling (focus drift)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc)))))
         (goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
         (opener (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
         (rest (filter (lambda (c) (not (goal? c))) cs))
         (last (filter goal? cs)))
    (append (mr-map (lambda (c) (mr-project! c opener)) rest)
            (mr-map (lambda (c) (mr-project! c opener)) last))))
(define (mr-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (mr-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))
(define (mr-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
(define (mr-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
(define (mr-ne! a b lt)
  (dk-have! (list 'NOT (list '= a b))
    (lambda ()
      (di)
      (dk-have! '(< 0 0) (lambda () (dk-ineq! lt (list '= a b))))
      (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
      (ai (dk-cite! 'rr-lt-irrefl 0)))))
(define (mr-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s0 (caddr m)) (v (cadr s0)) (dom (caddr s0))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s0)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "mr-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (ai (dk-ctx-form conj))))
    p))
(define (mr-and-close! closer)
  (if (dk-head-is? (dk-goal) 'AND)
      (for-each (lambda (k) (dk-focus! k) (mr-and-close! closer)) (dk-opened (lambda () (di))))
      (closer)))
(define (mr-find tag pred lst)
  (or (find-first pred lst) (error "mr-find: nothing matches at" tag (map expression->string lst))))
(define (mr-real! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)) (list 'IN t 'RR))
(define (mr-pos! e) (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))
(define (mr-recip! k)              ; recip(k + 1), k in NN: typed, positive (idempotent)
  (let* ((k1 (list '+ k 1)) (rq (list 'RECIP k1)))
   (if (dk-asm? (list 'POS-RR rq))
    rq
    (begin
    (dk-cite! 'nn-in-rr k) (dk-type! k1 'RR)
    (dk-have! (list '< 0 k1) (lambda () (dk-cite! 'nn-zero-le k) (dk-ineq! (list '<= 0 k))))
    (mr-ne! k1 0 (list '< 0 k1))
    (mr-chain! (dk-fact! 'rr-recip-closed k1))
    (dk-cite! 'rr-recip-pos k1)
    (dk-cite! 'rr-pos-rr-of-lt rq)
    rq))))
(define (mr-sep-open! sp0)           ; IS-SEPARABLE(sp0) in context: is-metric-space and a dense sequence, returned
  (let* ((iff (dk-cite! 'is-separable sp0)) (rhs (caddr iff)) (ex (caddr rhs)))
    (dk-project! (list 'IS-METRIC-SPACE sp0) (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (dk-project! ex (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (let ((d (dk-skolem! ex))) (dk-split-all!) d)))
(define (mr-dense ds sp0) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'PTS sp0)) (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
  (list 'FORSOME 'n (list 'AND '(IN n NN) (list '< (list (list 'DIST sp0) 'x (list ds 'n)) 'eps))))))))
(define (mr-iff-back! iff)           ; the right side of an IFF in context (proved by the caller): land the left side
  (ai iff)
  (detach! (list 'IMPLIES (caddr iff) (cadr iff))))

(define mpr-P '(PRODUCT-METRIC-W ms w))
(define mpr-PC '(PRODUCT-CARRIER ms))
(define mpr-hyp (lambda (body) (list 'FORALL 'ms (list 'IMPLIES '(IS-MS-SEQUENCE ms) (list 'FORALL 'w (list 'IMPLIES '(SUMMABLE-WEIGHT w) body))))))
(define (mpr-bdd n x y) (list (list 'DIST (list 'BDD-METRIC (list 'ms n))) (list x n) (list y n)))
(define (mpr-term n x y) (list '* (list 'w n) (mpr-bdd n x y)))
(define (mpr-dP x y) (list (list 'DIST mpr-P) x y))
(define (mpr-ims! n)                 ; IS-METRIC-SPACE(ms n), n in NN
  (let ((g0 (list 'IS-METRIC-SPACE (list 'ms n))))
    (if (not (dk-asm? g0))
        (dk-apply! (dk-ctx-form '(FORALL n (IMPLIES (IN n NN) (IS-METRIC-SPACE (ms n))))) n))
    g0))
(define (mpr-setup!)
  (mr-iff-parts! (dk-cite! 'is-ms-sequence 'ms))
  (mr-iff-parts! (dk-cite! 'summable-weight 'w))
  (dk-cite! 'product-is-metric-space 'ms 'w)
  (dk-cite! 'product-metric-carrier 'ms 'w))
(define (mpr-w! n)                   ; w(n) in RR, 0 < w(n)
  (dk-cite! 'fun-apply-type-c 'w 'NN 'RR n)
  (dk-apply! (mr-find 'wpos (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '<) (dk-contains? f 'w) (not (dk-contains? f 'SUMMABLE-WEIGHT)) (not (dk-contains? f 'ms)))) (dk-asms)) n))

;; each weighted coordinate distance is at most the product distance
(sp (make-wff (mpr-hyp (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x mpr-PC) (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y mpr-PC)
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '<= (mpr-term 'n 'x 'y) (mpr-dP 'x 'y)))))))))))
(dk-peel!)
(define mpr-sc (dk-cite! 'product-metric-dist-converges 'ms 'w 'x 'y))
(define mpr-T (cadr mpr-sc))
(dk-cite! 'product-term-seq-in-fun 'ms 'w 'x 'y)
(dk-cite! 'product-term-nonneg 'ms 'w 'x 'y)
(define mpr-le (mr-chain! (dk-cite! 'series-term-le-sum mpr-T (mpr-dP 'x 'y))))
(dk-cite! 'product-carrier-coord 'ms 'x 'n)
(dk-cite! 'product-carrier-coord 'ms 'y 'n)
(dk-lam-b-h! (dk-apply! mpr-le 'n))
(mr-close-open!)
(qed 'product-coord-le)
(topic! 'product-coord-le 'analysis)

;; a Cauchy sequence of the product has Cauchy coordinates
(define (mpr-a u n) (list 'VNB-LAMBDA 'mpj_ 'NN (list (list u 'mpj_) n)))
(sp (make-wff (mpr-hyp (list 'FORALL 'u (list 'IMPLIES (list 'IS-CAUCHY-SEQ mpr-P 'u)
  (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IS-CAUCHY-SEQ '(ms n) (mpr-a 'u 'n)))))))))
(dk-peel!)
(mpr-setup!)
(define mpr-cu (mr-iff-parts! (dk-cite! 'is-cauchy-seq mpr-P 'u)))
(define mpr-cuu (mr-find 'cuu (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR))) mpr-cu))
(dk-have! (list 'IN 'u (list 'FUN 'NN mpr-PC)) (lambda () (subst (list '= mpr-PC (list 'PTS mpr-P))) (mr-close-open!)))
(mpr-ims! 'n)
(mpr-w! 'n)
(fact 'nn-is-set)
(define mpr-a0 (mpr-a 'u 'n))
(dk-have! (list 'IN mpr-a0 '(FUN NN (PTS (ms n))))
  (lambda ()
    (for-each (lambda (kn)
                (if (not (sequent-node-grounded? kn))
                    (begin (dk-focus! kn)
                           (if (dk-asm? (dk-goal)) (ass)
                               (let ((k (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!))))))
                                 (dk-cite! 'fun-apply-type-c 'u 'NN mpr-PC k)
                                 (dk-cite! 'product-carrier-coord 'ms (list 'u k) 'n)
                                 (mr-close-open!))))))
              (dk-opened (lambda () (lam-t))))))
(let ((iff (dk-cite! 'is-cauchy-seq '(ms n) mpr-a0)))
  (dk-have! (caddr iff)
    (lambda ()
      (mr-and-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (let* ((eps (cadr (car (dk-peel!))))
                     (ope (list '+ 1 eps)) (rq (list 'RECIP ope)) (q (list '* eps rq)) (wn '(w n)) (eta (list '* wn q)))
                (dk-cite! 'rr-pos-rr-in-rr eps) (dk-cite! 'rr-lt-of-pos-rr eps)
                (dk-type! 1 'RR) (dk-type! ope 'RR)
                (dk-have! (list '< 0 ope) (lambda () (dk-ineq! (list '< 0 eps) (list 'IN eps 'RR))))
                (mr-ne! ope 0 (list '< 0 ope))
                (mr-chain! (dk-fact! 'rr-recip-closed ope))
                (dk-cite! 'rr-recip-pos ope)
                (dk-type! q 'RR) (dk-cite! 'rr-mul-pos eps rq)
                (dk-type! eta 'RR) (dk-cite! 'rr-mul-pos wn q)
                (dk-cite! 'rr-pos-rr-of-lt eta)
                (let ((nn0 (dk-skolem! (dk-apply! mpr-cuu eta))))
                  (dk-split-all!)
                  (ew nn0)
                  (mr-and-close!
                    (lambda ()
                      (if (dk-asm? (dk-goal)) (ass)
                          (let* ((lm (dk-peel!))
                                 (ms2 (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lm)))
                                 (m1 (car ms2)) (m2 (cadr ms2))
                                 (cun (mr-find 'cun (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nn0) (dk-contains? f 'DIST))) (dk-asms)))
                                 (le (dk-apply! cun m1 m2))
                                 (x1 (list 'u m1)) (x2 (list 'u m2))
                                 (bd (mpr-bdd 'n x1 x2)) (tm (mpr-term 'n x1 x2)) (dP (mpr-dP x1 x2)))
                            (dk-cite! 'fun-apply-type-c 'u 'NN mpr-PC m1)
                            (dk-cite! 'fun-apply-type-c 'u 'NN mpr-PC m2)
                            (dk-cite! 'product-carrier-coord 'ms x1 'n)
                            (dk-cite! 'product-carrier-coord 'ms x2 'n)
                            (dk-cite! 'product-coord-le 'ms 'w x1 x2 'n)
                            (dk-cite! 'product-dist-in-rr 'ms 'w x1 x2)
                            (dk-cite! 'bdd-metric-is-metric-space '(ms n))
                            (dk-cite! 'bdd-metric-carrier '(ms n))
                            (dk-have! (list 'IN (list x1 'n) (list 'PTS '(BDD-METRIC (ms n)))) (lambda () (subst (list '= (list 'PTS '(BDD-METRIC (ms n))) '(PTS (ms n)))) (mr-close-open!)))
                            (dk-have! (list 'IN (list x2 'n) (list 'PTS '(BDD-METRIC (ms n)))) (lambda () (subst (list '= (list 'PTS '(BDD-METRIC (ms n))) '(PTS (ms n)))) (mr-close-open!)))
                            (dk-cite! 'metric-dist-real '(BDD-METRIC (ms n)) (list x1 'n) (list x2 'n))
                            (dk-type! tm 'RR)
                            (dk-cite! 'metric-dist-real '(BDD-METRIC (ms n)) (list x1 'n) (list x2 'n))
                            (mr-chain! (dk-cite! 'rr-mul-comm wn bd)) (mr-chain! (dk-cite! 'rr-mul-comm wn q))
                            (dk-type! (list '* bd wn) 'RR) (dk-type! (list '* q wn) 'RR)
                            (dk-have! (list '<= (list '* bd wn) (list '* q wn))
                              (lambda () (dk-ineq! (list '<= tm dP) le (list '= tm (list '* bd wn)) (list '= eta (list '* q wn))
                                                   (list 'IN dP 'RR) (list 'IN tm 'RR) (list 'IN eta 'RR) (list 'IN (list '* bd wn) 'RR) (list 'IN (list '* q wn) 'RR))))
                            (mr-chain! (dk-cite! 'rr-mul-le-cancel-pos bd wn q))
                            (dk-have! (list '<= bd (list '/ eps ope)) (lambda () (mac 'binary-divide-def) (mr-close-open!)))
                            (dk-have! (list '<= 0 eps) (lambda () (dk-ineq! (list '< 0 eps))))
                            (mr-chain! (dk-cite! 'bdd-metric-dist-reflect '(ms n) (list x1 'n) (list x2 'n) eps))
                            (dk-lam-b!)
                            (mr-close-open!))))))))))))
  (mr-iff-back! iff))
(mr-close-open!)
(qed 'product-coord-cauchy)
(topic! 'product-coord-cauchy 'analysis)

;; completeness
(define mpr-allc '(FORALL n (IMPLIES (IN n NN) (IS-COMPLETE (ms n)))))
(define mpr-ca '(BIG-UNION n NN (PTS (ms n))))
(define (mpr-fam u) (list 'VNB-LAMBDA 'mpm_ 'NN (list 'SEP 'mpy_ '(PTS (ms mpm_)) (list 'CONVERGES-TO '(ms mpm_) (mpr-a u 'mpm_) 'mpy_))))
(sp (make-wff (mpr-hyp (list 'IMPLIES mpr-allc (list 'IS-COMPLETE mpr-P)))))
(dk-peel!)
(mpr-setup!)
(fact 'nn-is-set)
(let ((iff (dk-cite! 'is-complete mpr-P)))
  (dk-have! (caddr iff)
    (lambda ()
      (mr-and-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (let* ((u (caddr (mr-find 'ucs (lambda (f) (dk-head-is? f 'IS-CAUCHY-SEQ)) (dk-peel!))))
                     (_0 (mr-iff-parts! (dk-cite! 'is-cauchy-seq mpr-P u)))
                     (_1 (dk-have! (list 'IN u (list 'FUN 'NN mpr-PC)) (lambda () (subst (list '= mpr-PC (list 'PTS mpr-P))) (mr-close-open!))))
                     (fam (mpr-fam u)))
                (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORSOME 'y (list 'AND (list 'IN 'y mpr-ca) (list 'IN 'y (list fam 'k))))))
                  (lambda ()
                    (let* ((k (dk-di-var!)) (ak (mpr-a u k)))
                      (dk-cite! 'product-coord-cauchy 'ms 'w u k)
                      (dk-apply! mpr-allc k)
                      (mr-iff-parts! (dk-cite! 'is-complete (list 'ms k)))
                      (dk-apply! (mr-find 'ccv (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'CONVERGES) (dk-contains? f (list 'ms k)))) (dk-asms)) ak)
                      (let ((l (dk-skolem! (car (mr-iff-parts! (dk-cite! 'converges (list 'ms k) ak))))))
                        (mr-iff-parts! (dk-cite! 'converges-to (list 'ms k) ak l))
                        (dk-have! (list 'IN l mpr-ca) (lambda () (mr-bu-close! k)))
                        (ew l)
                        (mr-and-close!
                          (lambda ()
                            (if (dk-asm? (dk-goal)) (ass)
                                (begin (dk-lam-b!) (in-sep! (lambda () (mr-close-open!)))))))))))
                (let* ((Lch (dk-skolem! (dk-cite! 'rmm-nn-choice mpr-ca fam)))
                       (_2 (dk-split-all!))
                       (Lin (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f Lch) (dk-contains? f 'mpy_))) "Lch choice"))
                       (cvk! (lambda (k)
                               (if (not (dk-asm? (list 'CONVERGES-TO (list 'ms k) (mpr-a u k) (list Lch k))))
                                   (begin
                                     (dk-cite! 'fun-apply-type-c Lch 'NN mpr-ca k)
                                     (dk-lam-b-h! (dk-apply! Lin k))
                                     (mr-sep-parts! (list 'IN (list Lch k) (subst-free 'mpm_ k (cadddr fam)))))))))
                  (let ((unf (dk-cite! 'product-carrier-unfold 'ms)))
                    (dk-have! (list 'IN Lch mpr-PC)
                      (lambda ()
                        (subst (list '= mpr-PC (caddr unf)))
                        (in-sep! (lambda () (let ((k (dk-di-var!)))
                                              (cvk! k)
                                              (mr-close-open!)))))))
                  (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'CONVERGES-TO '(ms n_) (list 'VNB-LAMBDA 'k 'NN (list (list u 'k) 'n_)) (list Lch 'n_))))
                    (lambda () (let ((k (dk-di-var!))) (cvk! k) (mr-close-open!))))
                  (dk-cite! 'product-convergence-coordinatewise-bwd 'ms 'w u Lch)
                  (let ((iffv (dk-cite! 'converges mpr-P u)))
                    (dk-have! (caddr iffv) (lambda () (ew Lch) (mr-close-open!)))
                    (mr-iff-back! iffv)
                    (mr-close-open!)))))))))
  (mr-iff-back! iff))
(mr-close-open!)
(qed 'product-complete)
(topic! 'product-complete 'analysis)

;;; ======================================================================
;;; separability
;;; ======================================================================
(define mps-allsep '(FORALL n (IMPLIES (IN n NN) (IS-SEPARABLE (ms n)))))
(define mps-ca '(BIG-UNION mpm_ NN (FUN NN (PTS (ms mpm_)))))
;;; NBGSEP (2026-10-28): mde_ is bounded by mde_ in RR (implied by POS-RR), so the separation in
;;; the choice family below is predicative (NBG).  DENSE-CONV! passes from the IS-SEPARABLE form.
(define (mps-dense-f ds sp) (list 'FORALL 'mdx_ (list 'IMPLIES (list 'IN 'mdx_ (list 'PTS sp)) (list 'FORALL 'mde_ (list 'IMPLIES '(IN mde_ RR) (list 'IMPLIES '(POS-RR mde_)
  (list 'FORSOME 'mdn_ (list 'AND '(IN mdn_ NN) (list '< (list (list 'DIST sp) 'mdx_ (list ds 'mdn_)) 'mde_)))))))))
(define (mps-dense-conv! d sp)         ; goal DENSE-F(d, sp), the IS-SEPARABLE density of d in context
  (let* ((h (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d) (dk-contains? f 'POS-RR)
                                      (not (dk-contains? f 'mdx_))))
                     "the separable density"))
         (lk (dk-peel!))
         (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'PTS sp)))) lk)))
         (e (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) lk))))
    (dk-apply! h x e)
    (ass)))
(define mps-fam (list 'VNB-LAMBDA 'mpm_ 'NN (list 'SEP 'mpd_ '(FUN NN (PTS (ms mpm_))) (mps-dense-f 'mpd_ '(ms mpm_)))))
(define mps-D #f) (define mps-Din #f)
(define (mps-D! k)                   ; k in NN: D(k) typed and dense in ms(k); returns the density universal
  (let ((dk (list mps-D k)))
    (if (not (dk-asm? (list 'IN dk (list 'FUN 'NN (list 'PTS (list 'ms k))))))
        (begin
          (dk-cite! 'fun-apply-type-c mps-D 'NN mps-ca k)
          (dk-lam-b-h! (dk-apply! mps-Din k))
          (mr-sep-parts! (list 'IN dk (subst-free 'mpm_ k (cadddr mps-fam))))))
    (dk-ctx-form (mps-dense-f dk (list 'ms k)))))
(define (mps-Q a b) (list 'VNB-LAMBDA 'mpn_ 'NN (list 'IF (list '< 'mpn_ b) (list (list mps-D 'mpn_) (list (list 'BAIRE-CODE a) 'mpn_)) (list (list mps-D 'mpn_) 0))))
(define mps-BU '(BIG-UNION n NN (PTS (ms n))))
(define (mps-cf! a)                  ; baire-code-facts at a, once
  (if (not (dk-asm? (list 'IN (list 'BAIRE-CODE a) '(FUN NN NN)))) (dk-split-all! (list (dk-cite! 'baire-code-facts a)))))
(define (mps-val! a b n)              ; a, b, n in NN, goal (IN (IF ...) C): close by cases, C = PTS(ms n) or the big union
  (mps-cf! a)
  (dk-cite! 'fun-apply-type-c (list 'BAIRE-CODE a) 'NN 'NN n)
  (mps-D! n)
  (fact 'nn-zero-in)
  (dk-cite! 'fun-apply-type-c (list mps-D n) 'NN (list 'PTS (list 'ms n)) (list (list 'BAIRE-CODE a) n))
  (dk-cite! 'fun-apply-type-c (list mps-D n) 'NN (list 'PTS (list 'ms n)) 0)
  (let ((cls (caddr (dk-goal))))
    (dk-case-if! (cadr (dk-goal))
      (lambda (tv val)
        (if (equal? cls mps-BU)
            (mr-bu-close! n)
            (mr-close-open!))))))
