;;; ch3d-sc.scm -- CH3-D: consequences of simple connectedness (complex analysis, notes ch. 3).
;;; Proposition 3.21: a function holomorphic on a simply connected open set has a primitive.
;;; The primitive is F(z) = the integral of f along any road in u from a base point to z: the value
;;; does not depend on the road (3.20 on the closed road "first road, then the second reversed"), and
;;; a road reaches every point of u (u is connected).  Helpers: sd- prefix.
;;; Needs: ch3c (vocabulary, null-homotopic-line-int), ca-connected, goursat, line-int-* laws.

(define sd-m1 (cadr (cadr (->raw-formula "-1 * sdx_ = sdx_"))))   ; the reader's -1, as the opposite-road laws spell it
(define (sd-pick what pred)
  (let ((l (filter pred (dk-asms))))
    (if (null? l) (error "sd-pick: nothing matching" what) (car l))))
(define (sd-split-goal!)
  (let loop ((todo (list (proof-state-focus *ps*))) (acc '()))
    (if (null? todo) (reverse acc)
        (begin (dk-focus! (car todo))
               (if (dk-head-is? (dk-goal) 'AND)
                   (loop (append (dk-opened (lambda () (di))) (cdr todo)) acc)
                   (loop (cdr todo) (cons (car todo) acc)))))))
(define (sd-in-ccint! x lo hi . prems)
  (let ((g (list 'IN x (list 'CCINT lo hi))))
    (if (not (dk-asm? g))
        (dk-have! g (lambda ()
                      (mac 'ccint-membership)
                      (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (apply dk-ineq! prems)))))))))
(define (sd-ccint-parts! z lo hi)
  (for-each (lambda (c) (if (not (dk-asm? c)) (dk-project! c (lambda () (mac-h 'ccint-membership (list 'IN z (list 'CCINT lo hi))) (dk-split-all!)))))
            (list (list 'IN z 'RR) (list '<= lo z) (list '<= z hi))))
(define (sd-holo! u f)                         ; the standing facts of a function holomorphic on u
  (dk-cite! 'holomorphic-on-in-fun u f)
  (dk-cite! 'holomorphic-on-continuous u f)
  (dk-cite! 'holomorphic-on-open u f)
  (dk-cite! 'cc-open-subset-cc u))
(define (sd-road! g d a b)                     ; a road: path, ends typed, a < b, both in FUN
  (fact 'is-road-is-path g d a b)
  (if (not (and (dk-asm? (list 'IN a 'RR)) (dk-asm? (list 'IN b 'RR)) (dk-asm? (list '< a b))))
      (let ((ep (dk-cite! 'is-path-endpoints g a b))) (if (dk-head-is? ep 'AND) (dk-split-all! (list ep)))))
  (fact 'is-path-in-fun g a b)
  (fact 'is-road-dgam-in-fun g d a b))
(define (sd-cc! t)                             ; type a CC expression from typed atoms by + - *
  (let ((ty (list 'IN t 'CC)))
    (cond ((dk-asm? ty) ty)
          ((dk-asm? (list 'IN t 'RR)) (fact 'rr-subset-cc t) ty)
          ((and (number? t) (real? t)) (dk-have! (list 'IN t 'RR)) (fact 'rr-subset-cc t) ty)
          ((and (pair? t) (memq (car t) '(+ - *)) (= (length t) 3))
           (sd-cc! (cadr t)) (sd-cc! (caddr t))
           (if (eq? (car t) '-) (fact 'cc-sub-in-cc (cadr t) (caddr t))
               (begin (dk-have! (list 'AND (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)))
                      (fact (if (eq? (car t) '+) 'cc-add-closed 'cc-mul-closed) (cadr t) (caddr t))))
           ty)
          (#t (error "sd-cc!: cannot type" t)))))

;;; ---------------------------------------------------------------------------
;;; the union of two subsets of c is a subset of c
;;; MOVED 2026-11-10 (integration): the proof of `union-subset-both' is now in
;;; theorem-library/union-subset-both.scm (library core).

;;; ---------------------------------------------------------------------------
;;; PATH INDEPENDENCE: on a simply connected u, two roads in u with the same ends give the same integral
(sp (make-wff (forall-guarded '(u f pgam dgam a b prho drho c d)
  '((SIMPLY-CONNECTED u) (HOLOMORPHIC-ON u f) (IS-ROAD pgam dgam a b) (SUBSET (TRACE pgam a b) u)
    (IS-ROAD prho drho c d) (SUBSET (TRACE prho c d) u) (= (prho c) (pgam a)) (= (prho d) (pgam b)))
  '(= (LINE-INT f pgam dgam a b) (LINE-INT f prho drho c d)))))
(dk-peel!)
(let* ((rhs (caddr (dk-cite! 'simply-connected 'u))))
  (dk-project! rhs 'simply-connected '(SIMPLY-CONNECTED u))
  (dk-split-all! (list rhs)))
(sd-holo! 'u 'f)
(sd-road! 'pgam 'dgam 'a 'b) (sd-road! 'prho 'drho 'c 'd)
(let* ((nh (sd-pick 'nh (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'NULL-HOMOTOPIC)))))
       (m '(- b c)) (a2 '(- a (- b c)))
       (PG (list 'VNB-LAMBDA 'sdz_ (list 'CCINT a2 'c) (list 'pgam (list '+ m '(* 1 sdz_)))))
       (PGD (list 'VNB-LAMBDA 'sdz_ (list 'CCINT a2 'c) (list '* 1 (list 'dgam (list '+ m '(* 1 sdz_))))))
       (OP '(VNB-LAMBDA sdv_ (CCINT c d) (prho (- (+ c d) sdv_))))
       (OPD (list 'VNB-LAMBDA 'sdv_ '(CCINT c d) (list '* sd-m1 '(drho (- (+ c d) sdv_)))))
       (J (list 'JUXTA PG OP a2 'c 'd)) (JD (list 'JUXTA PGD OPD a2 'c 'd))
       (Lg '(LINE-INT f pgam dgam a b)) (Lr '(LINE-INT f prho drho c d))
       (Lpg (list 'LINE-INT 'f PG PGD a2 'c)) (Lop (list 'LINE-INT 'f OP OPD 'c 'd)) (LJ (list 'LINE-INT 'f J JD a2 'd)))
  (dk-have! '(IN 1 RR)) (fact 'rr-neg-closed 1) (fact 'rr-subset-cc 1) (fact 'rr-subset-cc sd-m1)
  (fact 'rr-sub-in-rr 'b 'c) (fact 'rr-sub-in-rr 'a m)
  (dk-have! (list '= (list '+ m (list '* 1 a2)) 'a) (lambda () (crs)))
  (dk-have! (list '= (list '+ m '(* 1 c)) 'b) (lambda () (crs)))
  (dk-have! (list '< a2 'c) (lambda () (dk-ineq! '(< a b))))
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (fact 'rr-is-set) (fact 'ccint-subset-rr a2 'c) (fact 'subclass-of-set-is-set (list 'CCINT a2 'c) 'RR)
  (fact 'ccint-subset-rr 'c 'd) (fact 'subclass-of-set-is-set '(CCINT c d) 'RR)
  ;; the argument maps of the two reparametrisations, into [a, b] and [c, d]
  (define (pg-arg! z)                          ; z in [a2, c]: m + 1 z in [a, b]
    (let ((x (list '+ m (list '* 1 z))))
      (sd-ccint-parts! z a2 'c)
      (dk-real! (list '* 1 z)) (dk-real! x)
      (sd-in-ccint! x 'a 'b (list '<= a2 z) (list '<= z 'c) (list '= (list '+ m (list '* 1 a2)) 'a) (list '= (list '+ m '(* 1 c)) 'b))
      (fact 'fun-apply-type-c 'pgam '(CCINT a b) 'CC x) (fact 'fun-apply-type-c 'dgam '(CCINT a b) 'CC x)
      x))
  (define (op-arg! z)                          ; z in [c, d]: c + d - z in [c, d]
    (let ((x (list '- '(+ c d) z)))
      (sd-ccint-parts! z 'c 'd)
      (dk-real! '(+ c d)) (dk-real! x)
      (sd-in-ccint! x 'c 'd (list '<= 'c z) (list '<= z 'd))
      (fact 'fun-apply-type-c 'prho '(CCINT c d) 'CC x) (fact 'fun-apply-type-c 'drho '(CCINT c d) 'CC x)
      x))
  (define (val-lane! arg!)                     ; prove (== (L z) body(z)) or a typing of a lambda body
    (lambda ()
      (let* ((pl (dk-peel!)) (z (cadr (car (filter (lambda (f) (dk-head-is? f 'IN)) pl)))))
        (arg! z)
        (if (not (dk-lam-b!)) (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass) (qrfl)))))))
  (define (typ-lane! arg! body)
    (lambda ()
      (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (arg! z) (sd-cc! (body z)) (ass)))
                    (lambda () (ass)))))
  (define (prover-for ante)
    (cond ((dk-asm? ante) (lambda () (ass)))
          ((and (dk-head-is? ante 'IN) (equal? (cadr ante) PG)) (typ-lane! pg-arg! (lambda (z) (list 'pgam (list '+ m (list '* 1 z))))))
          ((and (dk-head-is? ante 'IN) (equal? (cadr ante) PGD)) (typ-lane! pg-arg! (lambda (z) (list '* 1 (list 'dgam (list '+ m (list '* 1 z)))))))
          ((and (dk-head-is? ante 'IN) (equal? (cadr ante) OP)) (typ-lane! op-arg! (lambda (z) (list 'prho (list '- '(+ c d) z)))))
          ((and (dk-head-is? ante 'IN) (equal? (cadr ante) OPD)) (typ-lane! op-arg! (lambda (z) (list '* sd-m1 (list 'drho (list '- '(+ c d) z))))))
          ((and (dk-head-is? ante 'FORALL) (dk-contains? ante PG)) (val-lane! pg-arg!))
          ((and (dk-head-is? ante 'FORALL) (dk-contains? ante PGD)) (val-lane! pg-arg!))
          ((and (dk-head-is? ante 'FORALL) (dk-contains? ante OP)) (val-lane! op-arg!))
          ((and (dk-head-is? ante 'FORALL) (dk-contains? ante OPD)) (val-lane! op-arg!))
          ((dk-head-is? ante '<) (lambda () (dk-ineq!)))
          (#t (lambda () (ass)))))
  ;; the two new roads, their traces and integrals
  (let ((rr1 (dk-chain! (dk-cite! 'road-affine-reparam 'a 'b a2 'c 1 m) prover-for)))
    (dk-chain! (inst*! rr1 'pgam 'dgam PG PGD) prover-for))
  (dk-chain! (dk-cite! 'opposite-is-road 'c 'd 'prho 'drho OP OPD) prover-for)
  (dk-split-all! (list (dk-chain! (dk-cite! 'trace-affine-reparam 'a 'b a2 'c 1 m 'pgam PG) prover-for)))
  (dk-chain! (dk-cite! 'trace-opposite-subset 'c 'd 'prho OP) prover-for)
  (fact 'subset-trans (list 'TRACE PG a2 'c) '(TRACE pgam a b) 'u)
  (fact 'subset-trans (list 'TRACE OP 'c 'd) '(TRACE prho c d) 'u)
  (let ((lri (dk-chain! (dk-cite! 'line-int-affine-reparam 'u 'f 'pgam 'dgam 'a 'b) prover-for)))
    (dk-chain! (inst*! lri a2 'c 1 m) prover-for)
    (dk-chain! (inst*! (sd-pick 'lr2 (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'lrpr_) (dk-contains? f 'LINE-INT)))) PG PGD) prover-for))
  (dk-chain! (inst*! (dk-chain! (dk-cite! 'line-int-opposite-road 'u 'f 'prho 'drho 'c 'd) prover-for) OP OPD) prover-for)
  ;; the ends: PG(c) = pgam(b) = prho(d) = OP(c), PG(a2) = pgam(a), OP(d) = prho(c)
  (sd-in-ccint! 'c a2 'c (list '< a2 'c)) (sd-in-ccint! a2 a2 'c (list '< a2 'c))
  (sd-in-ccint! 'c 'c 'd '(< c d)) (sd-in-ccint! 'd 'c 'd '(< c d))
  (define (end! L arg! z e)                    ; (= (L z) e), e the value at the reduced argument
    (let ((g (list '= (list L z) e)))
      (dk-have! g (lambda () (arg! z) (dk-lam-b!) (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass) (crs)))))
      g))
  (dk-have! (list '= (list '+ m '(* 1 c)) 'b) (lambda () (crs)))
  (dk-have! '(= (- (+ c d) c) d) (lambda () (crs)))
  (dk-have! '(= (- (+ c d) d) c) (lambda () (crs)))
  (let* ((e1 (list '= (list PG 'c) '(pgam b)))
         (e2 (list '= (list OP 'c) '(pgam b)))
         (e3 (list '= (list PG a2) '(pgam a)))
         (e4 (list '= (list OP 'd) '(pgam a))))
    (dk-have! e1 (lambda () (pg-arg! 'c) (dk-lam-b!) (if (not (proof-done? *ps*)) (begin (subst (list '= (list '+ m '(* 1 c)) 'b)) (if (not (proof-done? *ps*)) (rfl))))))
    (dk-have! e2 (lambda () (op-arg! 'c) (dk-lam-b!) (if (not (proof-done? *ps*)) (begin (subst '(= (- (+ c d) c) d)) (subst '(= (prho d) (pgam b))) (if (not (proof-done? *ps*)) (rfl))))))
    (dk-have! e3 (lambda () (pg-arg! a2) (dk-lam-b!) (if (not (proof-done? *ps*)) (begin (subst (list '= (list '+ m (list '* 1 a2)) 'a)) (if (not (proof-done? *ps*)) (rfl))))))
    (dk-have! e4 (lambda () (op-arg! 'd) (dk-lam-b!) (if (not (proof-done? *ps*)) (begin (subst '(= (- (+ c d) d) c)) (subst '(= (prho c) (pgam a))) (if (not (proof-done? *ps*)) (rfl))))))
    (dk-have! (list '= (list PG 'c) (list OP 'c)) (lambda () (subst e1) (subst e2) (rfl)))
    ;; the closed road J = PG then OP on [a2, d]
    (dk-have! (list '<= a2 'c) (lambda () (dk-ineq! (list '< a2 'c))))
    (dk-have! '(<= c d) (lambda () (dk-ineq! '(< c d))))
    (dk-have! (list '< a2 'd) (lambda () (dk-ineq! (list '< a2 'c) '(< c d))))
    (fact 'juxta-is-road PG PGD OP OPD a2 'c 'd)
    (fact 'is-road-is-path J JD a2 'd)
    (dk-have! (list 'SUBSET (list 'TRACE J a2 'd) 'u)
      (lambda ()
        (fact 'juxta-trace-subset PG OP a2 'c 'd)
        (fact 'union-subset-both (list 'TRACE PG a2 'c) (list 'TRACE OP 'c 'd) 'u)
        (fact 'subset-trans (list 'TRACE J a2 'd) (list 'UNION (list 'TRACE PG a2 'c) (list 'TRACE OP 'c 'd)) 'u)
        (ass)))
    (sd-in-ccint! a2 a2 'c (list '< a2 'c))
    (fact 'juxta-apply-left PG OP a2 'c 'd a2)
    (inst*! (dk-fact! 'juxta-apply-right-closed PG OP a2 'c 'd) 'd)
    (dk-have! (list '= (list J 'd) (list J a2))
      (lambda () (subst (list '= (list J 'd) (list OP 'd))) (subst (list '= (list J a2) (list PG a2))) (subst e4) (subst e3) (rfl)))
    (inst*! nh a2 'd J)
    (dk-fact! 'null-homotopic-line-int 'u 'f J JD a2 'd)
    (dk-fact! 'line-int-juxta 'u 'f PG PGD OP OPD a2 'c 'd)
    ;; LJ = Lpg + Lop = Lg - Lr = 0
    (dk-fact! 'line-int-in-cc 'u 'f 'pgam 'dgam 'a 'b)
    (dk-fact! 'line-int-in-cc 'u 'f 'prho 'drho 'c 'd)
    (let* ((s0 (list '+ Lpg Lop)) (s1 (list '+ Lg (list '* sd-m1 Lr))))
      (dk-have! (list '= s1 0)
        (lambda () (subst (list '= Lg Lpg)) (subst (list '= (list '* sd-m1 Lr) Lop)) (subst (list '= s0 LJ)) (if (dk-asm? (dk-goal)) (ass))))
      (dk-have! (list '= Lg (list '+ s1 Lr)) (lambda () (crs)))
      (dk-rewrite-h! (list '= Lg (list '+ s1 Lr)) s1 0)
      (dk-have! (list '= (list '+ 0 Lr) Lr) (lambda () (crs)))
      (subst (list '= Lg (list '+ 0 Lr)))
      (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass))))))
(qed 'sc-path-independent)

;;; ---------------------------------------------------------------------------
;;; A LOCAL SEGMENT PRIMITIVE IS A PRIMITIVE: if prim(y) = prim(z) + SEG-INT(f, z, y) on a ball about each
;;; z of u, then prim is differentiable on u with derivative f.  On the ball, the convex primitive g of f
;;; gives SEG-INT(f, z, y) = g(y) - g(z), so prim = prim(z) - g(z) + g there.
(define sd-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (sd-loc prim)
  (list 'FORALL 'sdz_ (list 'IMPLIES '(IN sdz_ u) (list 'FORSOME 'sdr_ (list 'AND '(POS-RR sdr_) (list 'AND '(SUBSET (BALL CC-MS sdz_ sdr_) u)
    (list 'FORALL 'sdy_ (list 'IMPLIES '(IN sdy_ (BALL CC-MS sdz_ sdr_))
      (list '= (list prim 'sdy_) (list '+ (list prim 'sdz_) '(SEG-INT f sdz_ sdy_)))))))))))
(sp (make-wff (forall-guarded '(u f prim) (list '(HOLOMORPHIC-ON u f) '(IN prim (FUN u CC)) (sd-loc 'prim))
  '(FORALL sdw_ (IMPLIES (IN sdw_ u) (IS-DIFF-ON CC-NORMED-FIELD u prim sdw_ (f sdw_)))))))
(dk-peel!)
(sd-holo! 'u 'f)
(fact 'cc-is-metric-space) (fact 'cc-ms@pts) (fact 'cc-is-normed-field) (fact 'cc-nf-carr) (fact 'cc-nf-zero)
(dk-have! '(IN 0 RR)) (dk-have! '(IN 1 RR)) (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
(sd-in-ccint! 0 0 1 '(< 0 1)) (sd-in-ccint! 1 0 1 '(< 0 1))
(let* ((loc (sd-pick 'loc (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'sdz_)))))
       (_pk (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!)))
       (z (list-ref (dk-goal) 4))
       (r (dk-skolem! (dk-apply! loc z) #t))
       (_s (dk-split-all!))
       (B (list 'BALL 'CC-MS z r)) (fB (list 'RESTRICT 'f B)) (pB (list 'RESTRICT 'prim B))
       (vl (sd-pick 'vl (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'sdy_) (dk-contains? f r))))))
  (fact 'subset-mem-fwd 'u 'CC z)
  (dk-pos-parts! r)
  (fact 'cc-ms-ball-centre z r)
  (dk-have! (list 'IN z '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
  (dk-have! (list 'AND (list 'IN r 'RR) (list 'AND (list '<= 0 r) (list 'NOT (list '= 0 r)))))
  (fact 'ball-is-open 'CC-MS z r)
  (let ((biff (dk-cite! 'cc-ms-open-iff B)))
    (dk-have! (list 'IS-OPEN sd-nfm B) (lambda () (if (dk-only! biff (list 'IS-OPEN 'CC-MS B)) (prop)))))
  (fact 'cc-ball-is-convex z r)
  (fact 'subset-trans B 'u 'CC)
  (dk-cite! 'holomorphic-on-restrict 'u 'f B)
  (dk-cite! 'restrict-in-fun 'f 'u 'CC B)
  (dk-cite! 'restrict-in-fun 'prim 'u 'CC B)
  (let* ((g (dk-skolem! (dk-apply! (dk-cite! 'cauchy-convex-primitive B fB) z) #t))
         (_s2 (dk-split-all!))
         (gd (sd-pick 'gd (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-DIFF-ON) (dk-contains? f g)))))
         (c (list '- (list 'prim z) (list g z))))
    (fact 'fun-apply-type-c 'prim 'u 'CC z) (fact 'fun-apply-type-c g B 'CC z)
    (sd-cc! c)
    ;; on the ball: prim(y) = c + g(y)
    (define (pt! y)                            ; y in B: typed, and (= (prim y) (+ c (g y)))
      (let* ((bi (dk-cite! 'cc-ms-ball-membership z r y))
             (sg (list 'SEG-PATH z y)) (sdv (list 'SEG-DERIV z y)) (tr (list 'TRACE sg 0 1)))
        (dk-have! (list 'IN y 'CC) (lambda () (if (dk-only! bi (list 'IN y B)) (prop))))
        (fact 'subset-mem-fwd B 'u y)
        (fact 'fun-apply-type-c 'prim 'u 'CC y) (fact 'fun-apply-type-c g B 'CC y)
        (dk-cite! 'seg-trace-in-convex B z y)
        (fact 'subset-trans tr B 'u)
        (fact 'seg-path-is-road z y)
        (dk-chain! (dk-cite! 'line-int-of-derivative B g fB sg sdv 0 1) (lambda (ante) (lambda () (ass))))
        (dk-have! (list '== (list 'SEG-INT fB z y) (list 'LINE-INT fB sg sdv 0 1)) (lambda () (mac 'SEG-INT) (qrfl)))
        (dk-have! (list 'FORALL 'goxz_ (list 'IMPLIES (list 'IN 'goxz_ tr) (list '== (list fB 'goxz_) '(f goxz_))))
          (lambda () (let ((x (dk-di-var!))) (fact 'subset-mem-fwd tr B x) (dk-cite! 'restrict-apply 'f B x) (ass))))
        (dk-chain! (dk-cite! 'seg-int-congruence 'u 'f B fB z y) (lambda (ante) (lambda () (ass))))
        (dk-cite! 'seg-int-in-cc 'u 'f z y)
        (inst*! vl y)
        (let ((gl (list '= (list 'prim y) (list '+ c (list g y)))))
          (if (not (dk-asm? gl))
              (dk-have! gl
                (lambda ()
                  (subst (list '= (list 'prim y) (list '+ (list 'prim z) (list 'SEG-INT 'f z y))))
                  (subst (list '= (list 'SEG-INT 'f z y) (list 'SEG-INT fB z y)))
                  (subst (list '= (list 'SEG-INT fB z y) (list 'LINE-INT fB sg sdv 0 1)))
                  (subst (list '= (list 'LINE-INT fB sg sdv 0 1) (list '- (list g (list sg 1)) (list g (list sg 0)))))
                  (let ((p1 (list '+ z (list '* 1 (list '- y z)))) (p0 (list '+ z (list '* 0 (list '- y z)))))
                    (inst*! (dk-cite! 'seg-path-apply z y) 1) (inst*! (dk-cite! 'seg-path-apply z y) 0)
                    (sd-cc! p1) (sd-cc! p0)
                    (dk-have! (list '= p1 y) (lambda () (crs))) (dk-have! (list '= p0 z) (lambda () (crs)))
                    (subst (list '= (list sg 1) p1)) (subst (list '= (list sg 0) p0))
                    (subst (list '= p1 y)) (subst (list '= p0 z))
                    (crs)))))
          gl)))
    (fact 'cc-ms-ball-centre z r)
    (dk-have! (list 'IN c '(CARR CC-NORMED-FIELD)) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
    (inst*! gd z)
    (let* ((d0 (dk-cite! 'diff-on-const 'CC-NORMED-FIELD B c z))
           (CL (list-ref d0 3))
           (ds (dk-fact! 'diff-on-sum 'CC-NORMED-FIELD B CL g z '(ZERO CC-NORMED-FIELD) (list fB z)))
           (H (list-ref ds 3)) (L (list-ref ds 5)))
      (dk-have! (list 'IN pB (list 'FUN B '(CARR CC-NORMED-FIELD))) (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
      (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ B) (list '== (list pB 'hbx_) (list H 'hbx_))))
        (lambda ()
          (let ((y (dk-di-var!)))
            (pt! y)
            (dk-cite! 'restrict-apply 'prim B y)
            (subst (list '= (list pB y) (list 'prim y)))
            (dk-lam-b!)
            (if (not (proof-done? *ps*))
                (begin (fact 'cc-nf-add-apply c (list g y))
                       (subst (list '= (list '(ADD CC-NORMED-FIELD) c (list g y)) (list '+ c (list g y))))
                       (subst (list '= (list 'prim y) (list '+ c (list g y))))
                       (qrfl))))))
      (dk-fact! 'diff-on-transfer-ptwise-eq 'CC-NORMED-FIELD B pB H z L)
      (let ((d1 (dk-chain! (dk-cite! 'diff-on-local 'u 'prim B z L) (lambda (ante) (lambda () (ass))))))
        (fact 'fun-apply-type-c 'f 'u 'CC z)
        (dk-cite! 'restrict-apply 'f B z)
        (fact 'cc-zero-in)
        (fact 'cc-nf-add-apply 0 (list 'f z))
        (dk-have! (list '= L (list 'f z))
          (lambda () (subst '(= (ZERO CC-NORMED-FIELD) 0)) (subst (list '= (list fB z) (list 'f z)))
                     (subst (list '= (list '(ADD CC-NORMED-FIELD) 0 (list 'f z)) (list '+ 0 (list 'f z)))) (crs)))
        (dk-rewrite-h! d1 L (list 'f z))
        (ass)))))
(qed 'segment-primitive-diff)

;;; ---------------------------------------------------------------------------
;;; REACHING z FROM z0 BY A ROAD IN u WITH INTEGRAL v
(define (sd-reach-b A B G D z0 z v)            ; the reach formula with binder names A B G D
  ;; NBGSEP (2026-10-28): the road's parameters carry their typings (A, B in RR, G, D in
  ;; FUN(CCINT(A, B), CC), all implied by IS-ROAD), so the separations RS and VS that hold
  ;; this formula are predicative.
  (list 'FORSOME A (list 'FORSOME B (list 'FORSOME G (list 'FORSOME D
    (list 'AND (list 'IN A 'RR) (list 'AND (list 'IN B 'RR)
    (list 'AND (list 'IN G (list 'FUN (list 'CCINT A B) 'CC)) (list 'AND (list 'IN D (list 'FUN (list 'CCINT A B) 'CC))
    (list 'AND (list 'IS-ROAD G D A B) (list 'AND (list 'SUBSET (list 'TRACE G A B) 'u)
      (list 'AND (list '= (list G A) z0) (list 'AND (list '= (list G B) z) (list '= (list 'LINE-INT 'f G D A B) v))))))))))))))
(define (sd-reach z0 z v) (sd-reach-b 'sda_ 'sdb_ 'sdg_ 'sdd_ z0 z v))
(define (sd-drive! wits closer)                ; ew the witnesses in order of the existentials met; close the rest
  (let ((ws wits))
    (let drive ()
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (ass))
              ((dk-head-is? g 'AND) (for-each (lambda (l) (dk-focus! l) (drive)) (dk-opened (lambda () (di)))))
              ((dk-head-is? g 'FORSOME) (ew (car ws)) (set! ws (cdr ws)) (drive))
              (#t (closer)))))))

;;; a road from z0 to z, then the segment from z to w (inside u): a road from z0 to w
(sp (make-wff (forall-guarded '(u f z0 z w pgam dgam a b)
  (list '(HOLOMORPHIC-ON u f) '(IS-ROAD pgam dgam a b) '(SUBSET (TRACE pgam a b) u) '(= (pgam a) z0) '(= (pgam b) z)
        '(IN z CC) '(IN w CC) '(SUBSET (TRACE (SEG-PATH z w) 0 1) u))
  (sd-reach 'z0 'w '(+ (LINE-INT f pgam dgam a b) (SEG-INT f z w))))))
(dk-peel!)
(sd-holo! 'u 'f)
(sd-road! 'pgam 'dgam 'a 'b)
(let* ((b1 '(+ b 1)) (sg '(SEG-PATH z w)) (sgd '(SEG-DERIV z w))
       (SS (list 'VNB-LAMBDA 'trs_ (list 'CCINT 'b b1) (list sg '(- trs_ b))))
       (SSD (list 'VNB-LAMBDA 'trs_ (list 'CCINT 'b b1) (list sgd '(- trs_ b))))
       (J (list 'JUXTA 'pgam SS 'a 'b b1)) (JD (list 'JUXTA 'dgam SSD 'a 'b b1))
       (Lg '(LINE-INT f pgam dgam a b)) (Lss (list 'LINE-INT 'f SS SSD 'b b1)) (Lsg (list 'LINE-INT 'f sg sgd 0 1))
       (LJ (list 'LINE-INT 'f J JD 'a b1)))
  (dk-have! '(IN 0 RR)) (dk-have! '(IN 1 RR)) (dk-real! b1)
  (dk-have! (list '= b1 b1) (lambda () (rfl)))
  (dk-have! (list '< 'b b1) (lambda () (dk-ineq!)))
  (dk-have! (list '<= 'b b1) (lambda () (dk-ineq!)))
  (dk-have! '(<= a b) (lambda () (dk-ineq! '(< a b))))
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (sd-in-ccint! 0 0 1 '(< 0 1)) (sd-in-ccint! 1 0 1 '(< 0 1))
  (fact 'seg-shift-is-road 'z 'w 'b b1)
  (fact 'seg-shift-trace 'z 'w 'b b1)
  (sd-road! SS SSD 'b b1)
  (dk-have! (list 'SUBSET (list 'TRACE SS 'b b1) 'u)
    (lambda () (subst (list '= (list 'TRACE SS 'b b1) (list 'TRACE sg 0 1))) (ass)))
  (sd-in-ccint! 'b 'b b1 (list '< 'b b1)) (sd-in-ccint! b1 'b b1 (list '< 'b b1)) (sd-in-ccint! 'a 'a 'b '(< a b))
  (inst*! (dk-cite! 'seg-path-apply 'z 'w) 0) (inst*! (dk-cite! 'seg-path-apply 'z 'w) 1)
  (sd-cc! '(+ z (* 0 (- w z)))) (sd-cc! '(+ z (* 1 (- w z))))
  (dk-have! '(= (- b b) 0) (lambda () (crs)))
  (dk-have! (list '= (list '- b1 'b) 1) (lambda () (crs)))
  (dk-have! (list '= (list SS 'b) 'z)
    (lambda () (dk-lam-b!) (subst '(= (- b b) 0)) (subst (list '= (list sg 0) '(+ z (* 0 (- w z))))) (crs)))
  (dk-have! (list '= (list SS b1) 'w)
    (lambda () (dk-lam-b!) (subst (list '= (list '- b1 'b) 1)) (subst (list '= (list sg 1) '(+ z (* 1 (- w z))))) (crs)))
  (dk-have! (list '= '(pgam b) (list SS 'b)) (lambda () (subst (list '= (list SS 'b) 'z)) (ass)))
  (fact 'juxta-is-road 'pgam 'dgam SS SSD 'a 'b b1)
  (sd-road! J JD 'a b1)                        ; the reach formula's typing guards for the new road
  (fact 'juxta-trace-subset 'pgam SS 'a 'b b1)
  (fact 'union-subset-both '(TRACE pgam a b) (list 'TRACE SS 'b b1) 'u)
  (fact 'subset-trans (list 'TRACE J 'a b1) (list 'UNION '(TRACE pgam a b) (list 'TRACE SS 'b b1)) 'u)
  (dk-chain! (dk-cite! 'line-int-juxta 'u 'f 'pgam 'dgam SS SSD 'a 'b b1) (lambda (ante) (lambda () (ass))))
  (dk-chain! (dk-cite! 'seg-shift-line-int 'u 'f 'z 'w 'b b1) (lambda (ante) (lambda () (ass))))
  (dk-have! (list '== '(SEG-INT f z w) Lsg) (lambda () (mac 'SEG-INT) (qrfl)))
  (dk-chain! (dk-cite! 'line-int-in-cc 'u 'f 'pgam 'dgam 'a 'b) (lambda (ante) (lambda () (ass))))
  (dk-chain! (dk-cite! 'seg-int-in-cc 'u 'f 'z 'w) (lambda (ante) (lambda () (ass))))
  (fact 'juxta-apply-left 'pgam SS 'a 'b b1 'a)
  (inst*! (dk-fact! 'juxta-apply-right-closed 'pgam SS 'a 'b b1) b1)
  (sd-drive! (list 'a b1 J JD)
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((equal? (cadr g) (list J 'a)) (subst (list '= (list J 'a) '(pgam a))) (ass))
              ((equal? (cadr g) (list J b1)) (subst (list '= (list J b1) (list SS b1))) (ass))
              (#t (subst (list '= LJ (list '+ Lg Lss))) (subst (list '= Lss Lsg)) (subst (list '= Lsg '(SEG-INT f z w)))
                  (if (not (proof-done? *ps*)) (rfl))))))))
(qed 'road-extend-segment)

;;; ---------------------------------------------------------------------------
;;; ON A CONNECTED OPEN u EVERY POINT IS REACHED FROM z0 BY A ROAD IN u
(define (sd-rch q) (list 'FORSOME 'sdv_ (list 'AND '(IN sdv_ CC) (sd-reach 'z0 q 'sdv_))))
(sp (make-wff (forall-guarded '(u f z0) '((HOLOMORPHIC-ON u f) (IS-CONNECTED CC-MS u) (IN z0 u))
  (list 'FORALL 'sdq_ (list 'IMPLIES '(IN sdq_ u) (sd-rch 'sdq_))))))
(dk-peel!)
(sd-holo! 'u 'f)
(fact 'cc-is-metric-space) (fact 'cc-ms@pts)
(dk-have! '(IN 0 RR)) (dk-have! '(IN 1 RR)) (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
(sd-in-ccint! 0 0 1 '(< 0 1)) (sd-in-ccint! 1 0 1 '(< 0 1))
(let* ((q0 'sdq_)
       (oiff (dk-cite! 'cc-ms-open-iff 'u))
       (_o (dk-have! '(IS-OPEN CC-MS u) (lambda () (if (dk-only! oiff '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u)) (prop)))))
       (ob '(FORALL y (IMPLIES (IN y u) (FORSOME r (AND (POS-RR r) (SUBSET (BALL CC-MS y r) u))))))
       (_p (dk-project! ob (lambda () (mac-h 'IS-OPEN '(IS-OPEN CC-MS u)) (dk-split-all!))))
       (ob1 (sd-pick 'ob (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'BALL) (dk-contains? f 'POS-RR)))))
       (RS (list 'SEP 'sdp_ 'u (sd-rch 'sdp_)))
       (chi (list 'VNB-LAMBDA 'sdj_ 'u (list 'IF (list 'IN 'sdj_ RS) 1 0))))
  (define (ball-at! x)                         ; x in u: r, the ball B(x, r) inside u, convex, holding x
    (let* ((r (dk-skolem! (dk-apply! ob1 x) #t)))
      (dk-split-all!)
      (dk-pos-parts! r)
      (fact 'subset-mem-fwd 'u 'CC x)
      (fact 'cc-ms-ball-centre x r)
      (fact 'cc-ball-is-convex x r)
      r))
  (define (seg-in! x y r)                      ; x, y in B(x, r): the segment [x, y] lies in u
    (let ((Bx (list 'BALL 'CC-MS x r)))
      (dk-cite! 'seg-trace-in-convex Bx x y)
      (fact 'subset-trans (list 'TRACE (list 'SEG-PATH x y) 0 1) Bx 'u)))
  (define (extend! q y)                        ; (sd-rch q) in context, segment [q, y] in u: lands (sd-rch y)
    (let* ((v (dk-skolem! (dk-ctx-form (sd-rch q)) #t)) (_0 (dk-split-all!))
           (a (dk-skolem! (sd-pick 'ea (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'sda_) (dk-contains? f v)))) #t)) (_1 (dk-split-all!))
           (b (dk-skolem! (sd-pick 'eb (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'sdb_) (dk-contains? f v)))) #t)) (_2 (dk-split-all!))
           (g (dk-skolem! (sd-pick 'eg (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'sdg_) (dk-contains? f v)))) #t)) (_3 (dk-split-all!))
           (d (dk-skolem! (sd-pick 'ed (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'sdd_) (dk-contains? f v)))) #t)) (_4 (dk-split-all!))
           (nv (list '+ (list 'LINE-INT 'f g d a b) (list 'SEG-INT 'f q y))))
      (fact 'subset-mem-fwd 'u 'CC q) (fact 'subset-mem-fwd 'u 'CC y)
      (dk-fact! 'road-extend-segment 'u 'f 'z0 q y g d a b)
      (dk-chain! (dk-cite! 'seg-int-in-cc 'u 'f q y) (lambda (ante) (lambda () (ass))))
      (dk-chain! (dk-cite! 'line-int-in-cc 'u 'f g d a b) (lambda (ante) (lambda () (ass))))
      (sd-cc! nv)
      (dk-have! (sd-rch y) (lambda () (ew nv) (dk-conj-close! (lambda () (ass)))))))
  (define (in-rs! q)                           ; (sd-rch q), q in u: lands (IN q RS)
    (let ((g (list 'IN q RS))) (if (not (dk-asm? g)) (dk-have! g (lambda () (in-sep! (lambda () (ass)) (lambda () (ass))))))))
  (define (rch-of! q)                          ; (IN q RS): lands (sd-rch q), keeping the membership
    (if (not (dk-asm? (sd-rch q))) (dk-project! (sd-rch q) (lambda () (sep-me (list 'IN q RS))))))
  (define (chi-val! q t?)                      ; (= (chi q) 1) or (= (chi q) 0), the case in context
    (let ((g (list '= (list chi q) (if t? 1 0))))
      (if (not (dk-asm? g))
          (dk-have! g (lambda () (dk-lam-b!)
                        (dk-if-branch! t? (list 'IF (list 'IN q RS) 1 0) #f (lambda () (if (not (proof-done? *ps*)) (rfl)))))))
      g))
  ;; z0 is reached by the constant segment
  (let* ((r0 (ball-at! 'z0)) (sg '(SEG-PATH z0 z0)) (sgd '(SEG-DERIV z0 z0)) (si '(SEG-INT f z0 z0)))
    (seg-in! 'z0 'z0 r0)
    (fact 'seg-path-is-road 'z0 'z0)
    (sd-road! sg sgd 0 1)                      ; the reach formula's typing guards
    (inst*! (dk-cite! 'seg-path-apply 'z0 'z0) 0) (inst*! (dk-cite! 'seg-path-apply 'z0 'z0) 1)
    (dk-chain! (dk-cite! 'seg-int-in-cc 'u 'f 'z0 'z0) (lambda (ante) (lambda () (ass))))
    (dk-have! (list '== si (list 'LINE-INT 'f sg sgd 0 1)) (lambda () (mac 'SEG-INT) (qrfl)))
    (dk-have! (sd-rch 'z0)
      (lambda ()
        (sd-drive! (list si 0 1 sg sgd)
          (lambda ()
            (let ((g (dk-goal)))
              (cond ((equal? (cadr g) (list sg 0)) (subst (list '= (list sg 0) '(+ z0 (* 0 (- z0 z0))))) (crs))
                    ((equal? (cadr g) (list sg 1)) (subst (list '= (list sg 1) '(+ z0 (* 1 (- z0 z0))))) (crs))
                    (#t (subst (list '= (list 'LINE-INT 'f sg sgd 0 1) si)) (if (not (proof-done? *ps*)) (rfl))))))))))
  ;; chi is locally constant
  (let* ((clc (dk-cite! 'connected-locally-constant 'CC-MS 'u))
         (ci (inst*! clc chi))
         (LC (cadr ci)))
    (dk-have! LC
      (lambda ()
        (let* ((pl (dk-peel!)) (x (cadr (car (filter (lambda (f) (dk-head-is? f 'IN)) pl))))
               (r (ball-at! x)) (Bx (list 'BALL 'CC-MS x r)))
          (ew r)
          (dk-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal)) (ass)
                  (let* ((pl2 (dk-peel!))
                         (y (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) Bx))) pl2)))))
                    (fact 'subset-mem-fwd 'u 'CC y)
                    (fact 'subset-mem-fwd Bx 'u y)
                    (use-em (list 'IN x RS)
                      (lambda ()
                        (chi-val! x #t)
                        (rch-of! x)
                        (seg-in! x y r)
                        (extend! x y)
                        (in-rs! y)
                        (chi-val! y #t)
                        (subst (list '= (list chi y) 1)) (subst (list '= (list chi x) 1)) (rfl))
                      (lambda ()
                        (dk-have! (list 'NOT (list 'IN y RS))
                          (lambda ()
                            (di)
                            (rch-of! y)
                            (seg-in! x y r)
                            (let ((ty (list 'TRACE (list 'SEG-PATH y x) 0 1)))
                              (dk-cite! 'seg-trace-in-convex Bx y x)
                              (fact 'subset-trans ty Bx 'u))
                            (extend! y x)
                            (in-rs! x)
                            (ai (list 'NOT (list 'IN x RS)))))
                        (chi-val! x #f) (chi-val! y #f)
                        (subst (list '= (list chi y) 0)) (subst (list '= (list chi x) 0)) (rfl)))))))))))
    (let ((all (dk-fact! 'connected-locally-constant 'CC-MS 'u chi)))
      (inst*! all q0 'z0)
      (in-rs! 'z0)
      (chi-val! 'z0 #t)
      (use-em (list 'IN q0 RS)
        (lambda () (sep-me (list 'IN q0 RS)) (if (not (proof-done? *ps*)) (ass)))
        (lambda ()
          (chi-val! q0 #f)
          (dk-have! '(= 0 1) (lambda () (subst (list '= 0 (list chi q0))) (subst (list '= (list chi q0) (list chi 'z0))) (subst (list '= (list chi 'z0) 1)) (rfl)))
          (dk-have! '(NOT (= 0 1)) (lambda () (arith)))
          (if (dk-only! '(= 0 1) '(NOT (= 0 1))) (prop))))))
(qed 'sc-reach)

;;; ---------------------------------------------------------------------------
;;; THE PRIMITIVE: F(q) = the integral along some road in u from z0 to q (CHOICE of the values, which
;;; agree by sc-path-independent); it satisfies the local segment law of segment-primitive-diff.
(define (sd-reach-x z0 z v) (sd-reach-b 'sxa_ 'sxb_ 'sxg_ 'sxd_ z0 z v))   ; other binder names, for use INSIDE a term
(define (sd-vs q) (list 'SEP 'sdw_ 'CC (sd-reach-x 'z0 q 'sdw_)))
(sp (make-wff (forall-guarded '(u f z0) '((SIMPLY-CONNECTED u) (HOLOMORPHIC-ON u f) (IN z0 u))
  (list 'FORSOME 'sdpr_ (list 'AND '(IN sdpr_ (FUN u CC)) (sd-loc 'sdpr_))))))
(dk-peel!)
(let* ((rhs (caddr (dk-cite! 'simply-connected 'u))))
  (dk-project! rhs 'simply-connected '(SIMPLY-CONNECTED u))
  (dk-split-all! (list rhs)))
(sd-holo! 'u 'f)
(fact 'cc-is-metric-space) (fact 'cc-ms@pts)
(let* ((reach (dk-fact! 'sc-reach 'u 'f 'z0))
       (Fp (list 'VNB-LAMBDA 'sdk_ 'u (list 'CHOICE (sd-vs 'sdk_))))
       (oiff (dk-cite! 'cc-ms-open-iff 'u))
       (_o (dk-have! '(IS-OPEN CC-MS u) (lambda () (if (dk-only! oiff '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u)) (prop)))))
       (ob '(FORALL y (IMPLIES (IN y u) (FORSOME r (AND (POS-RR r) (SUBSET (BALL CC-MS y r) u))))))
       (_p (dk-project! ob (lambda () (mac-h 'IS-OPEN '(IS-OPEN CC-MS u)) (dk-split-all!))))
       (ob1 (sd-pick 'ob (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'BALL) (dk-contains? f 'POS-RR))))))
  (define (choice-mem! q)                      ; q in u: (IN (CHOICE VS) VS)
    (let* ((vs (sd-vs q)) (c (list 'CHOICE vs)))
      (if (not (dk-asm? (list 'IN c vs)))
          (dk-have! (list 'IN c vs)
            (lambda ()
              (inst*! reach q)
              (let ((v (dk-skolem! (dk-ctx-form (sd-rch q)) #t)))
                (choose-mem! vs v (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))
                (if (not (proof-done? *ps*)) (ass))))))
      (list 'IN c vs)))
  (define (choice-of! q)                       ; q in u: C = CHOICE(VS q) in CC, reach(z0, q, C), F(q) = C
    (let* ((vs (sd-vs q)) (c (list 'CHOICE vs)))
      (if (not (dk-asm? (list 'IN c vs)))
          (dk-have! (list 'IN c vs)
            (lambda ()
              (inst*! reach q)
              (let ((v (dk-skolem! (dk-ctx-form (sd-rch q)) #t)))
                (choose-mem! vs v (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))
                (if (not (proof-done? *ps*)) (ass))))))
      (if (not (dk-asm? (list 'IN c 'CC))) (dk-have! (list 'IN c 'CC) (lambda () (sep-me (list 'IN c vs)) (if (not (proof-done? *ps*)) (ass)))))
      (if (not (dk-asm? (sd-reach 'z0 q c))) (dk-have! (sd-reach 'z0 q c) (lambda () (sep-me (list 'IN c vs)) (if (not (proof-done? *ps*)) (ass)))))
      (let ((g (list '= (list Fp q) c)))
        (if (not (dk-asm? g)) (dk-have! g (lambda () (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl))))))
      c))
  (define (road-of! q v)                       ; (sd-reach z0 q v) in context: skolemise it; returns (g d a b)
    (let* ((a (dk-skolem! (dk-ctx-form (sd-reach 'z0 q v)) #t)) (_1 (dk-split-all!))
           (b (dk-skolem! (sd-pick 'eb (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'sdb_) (dk-contains? f a)))) #t)) (_2 (dk-split-all!))
           (g (dk-skolem! (sd-pick 'eg (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'sdg_) (dk-contains? f a)))) #t)) (_3 (dk-split-all!))
           (d (dk-skolem! (sd-pick 'ed (lambda (f) (and (dk-head-is? f 'FORSOME) (eq? (cadr f) 'sdd_) (dk-contains? f a)))) #t)) (_4 (dk-split-all!)))
      (list g d a b)))
  (dk-have! (list 'IN Fp '(FUN u CC))
    (lambda () (dk-lam-type! (lambda () (let ((q (dk-di-var!))) (sep-me (choice-mem! q)) (if (not (proof-done? *ps*)) (ass))))
                             (lambda () (fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC) (ass)))))
  (ew Fp)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (ass)
          (let* ((pl (dk-peel!)) (z (cadr (car (filter (lambda (f) (dk-head-is? f 'IN)) pl))))
                 (r (dk-skolem! (dk-apply! ob1 z) #t)) (_s (dk-split-all!)) (Bz (list 'BALL 'CC-MS z r)))
            (ew r)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (ass)
                    (let* ((pl2 (dk-peel!)) (y (cadr (car (filter (lambda (f) (dk-head-is? f 'IN)) pl2))))
                           (sz (list 'SEG-INT 'f z y)))
                      (dk-pos-parts! r)
                      (fact 'subset-mem-fwd 'u 'CC z) (fact 'subset-mem-fwd Bz 'u y) (fact 'subset-mem-fwd 'u 'CC y)
                      (fact 'cc-ms-ball-centre z r) (fact 'cc-ball-is-convex z r)
                      (dk-cite! 'seg-trace-in-convex Bz z y)
                      (fact 'subset-trans (list 'TRACE (list 'SEG-PATH z y) 0 1) Bz 'u)
                      (dk-chain! (dk-cite! 'seg-int-in-cc 'u 'f z y) (lambda (ante) (lambda () (ass))))
                      (let* ((cz (choice-of! z)) (cy (choice-of! y))
                             (r1 (road-of! z cz))
                             (l1 (list 'LINE-INT 'f (car r1) (cadr r1) (caddr r1) (cadddr r1)))
                             (nv (list '+ l1 sz)))
                        (dk-fact! 'road-extend-segment 'u 'f 'z0 z y (car r1) (cadr r1) (caddr r1) (cadddr r1))
                        (let* ((r2 (road-of! y nv))
                               (l2 (list 'LINE-INT 'f (car r2) (cadr r2) (caddr r2) (cadddr r2)))
                               (r3 (road-of! y cy))
