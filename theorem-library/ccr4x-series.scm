         (dl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'NV-DIGIT) (not (dk-contains? h 'succ)))) "the digit law"))
         (fk `(f ,kv)) (fk1 `(f (succ ,kv))) (nk `(+ n ,kv)) (pnk (s4-zp nk)) (sk `(NV-PSUM K w dga n ,kv)))
    (dk-cite! 'nn-succ-closed kv) (dk-cite! 'nn-in-rr kv) (dk-cite! 'zz-in-rr 'n)
    (for-each (lambda (j) (dk-cite! 'fun-apply-type-c 'f 'NN 'A j) (s4-in-a! `(f ,j))) (list 0 kv `(succ ,kv)))
