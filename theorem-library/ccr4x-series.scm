;;; D. w^n f(0) = S_m + w^(n+m) f(m), for the digit sequence f and digits a with a(n+j) = digit(f j)

(define (s4-dig-law a f) `(FORALL j (IMPLIES (IN j NN) (= (,a (+ n j)) ,(s4-dg `(,f j))))))
