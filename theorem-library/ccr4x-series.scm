;;; ccr4x-series.scm -- CCR.pdf section 4.4: the series representation (Proposition 4.17, existence) of the
;;; elements of a local NV field K over a representative set R, with integer powers of the uniformizer w.
;;; Agent CCR-1109-C, 2026-11-09.  Destination: theorem-library/ccr4x-series.scm.  Library: analysis.
;;; (The additive group's OPR / IDEN are read off by `slot' here: nfag-opr / nfag-iden sit in pruefer-laws, complex-analysis.)
;;; Load window: after theorem-library/ccr4x-zpow (NV-ZPOW laws, the representative-set projections) and
;;; structure-library/ccr4x-vocab (NV-DIGIT, NV-TERM, NV-PSUM, IS-NV-EXPANSION).
;;;
;;; The route is the p-adic one of qp-laws.scm (qe-*, sections D-F), with the p-adic digit QP-DIGIT replaced by
;;; NV-DIGIT (the element of R within distance < 1) and p^k by NV-ZPOW.
;;;   A. ZPOW laws: nv-zpow-char (w^k w^t = w^s when s - t = k), nv-zpow-succ, nv-zpow-inv, nv-zpow-norm-nat.
;;;   B. partial sums: nv-psum-zero, nv-psum-succ, nv-psum-type.
;;;   C. digits: nv-digit-def, nv-digit-step, nv-digit-sequence (dependent choice).
;;;   D. nv-expand-ind: w^n f(0) = S_m + w^(n+m) f(m).
;;;   E. ccr-4-17 (existence for x with w^(-n) x in Z(K)); ccr-4-17-start (every x has such an n).
;;; Helper prefix s4-.

(define s4-view '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define (s4-n x) `((FNRM K) ,x))
(define (s4-mul x y) `((MUL K) ,x ,y))
(define (s4-add x y) `((ADD K) ,x ,y))
(define (s4-neg x) `((NEG K) ,x))
(define (s4-d x y) `((ADD K) ,x ((NEG K) ,y)))
(define (s4-pw x e) `(RING-POWER ,s4-view ,x ,e))
(define (s4-zp e) `(NV-ZPOW K w ,e))
(define (s4-amax e) `(MAX ,e 0))
(define (s4-bmax e) `(MAX (- ,e) 0))
(define (s4-and! . fs)
  (let ((c (let loop ((fs fs)) (if (null? (cdr fs)) (car fs) `(AND ,(car fs) ,(loop (cdr fs)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define (s4-typek! x)
  (dk-cite! 'nf-norm-in-rr 'K x)
  (dk-cite! 'nf-norm-nonneg 'K x))
(define (s4-view!)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
  (dk-cite! 'commutative-ring-is-ring s4-view)
  (for-each (lambda (r) (dk-cite! r 'K))
            '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
              normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one)))
(define (s4-in-view! x)
  (if (not (dk-asm? `(IN ,x (CARR ,s4-view))))
      (dk-have! `(IN ,x (CARR ,s4-view)) (lambda () (subst `(= (CARR ,s4-view) (CARR K))) (dk-ass!)))))
(define (s4-crs! vs)
  (s4-view!)
  (for-each s4-in-view! vs)
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,s4-view))))) '(ADD MUL NEG))
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,s4-view))))) '(ZERO ONE))
  (crs))
(define (s4-ring-eq! eq vs) (dk-have! eq (lambda () (s4-crs! vs))) eq)
;; X in CARR K, E in NN: land X^E in CARR K and |X^E| = |X|^E
(define (s4-pow! x e)
  (s4-view!)
  (s4-in-view! x)
  (dk-cite! 'ring-power-type s4-view x e)
  (dk-have! `(IN ,(s4-pw x e) (CARR K)) (lambda () (subst `(= (CARR K) (CARR ,s4-view))) (dk-ass!)))
  (dk-cite! 'nv-pow-norm-power 'K x e)
  (s4-typek! x)
  (dk-cite! 'power-real-closed (s4-n x) e)
  (s4-typek! (s4-pw x e)))
;; X /= ZERO K in context: land 0 < |X|
(define (s4-norm-pos! x)
  (s4-typek! x)
  (dk-have! `(NOT (= 0 ,(s4-n x)))
    (lambda ()
      (di)
      (let ((iff (dk-cite! 'nf-norm-zero-iff 'K x)))
        (dk-have! `(= ,(s4-n x) 0) (lambda () (subst `(= ,(s4-n x) 0)) (rfl)))
        (dk-have! `(= ,x (ZERO K)) (lambda () (ai iff) (detach! `(IMPLIES (= ,(s4-n x) 0) (= ,x (ZERO K)))) (dk-ass!)))
        (ai `(NOT (= ,x (ZERO K)))))))
  (s4-and! `(<= 0 ,(s4-n x)) `(NOT (= 0 ,(s4-n x))))
  (dk-cite! 'rr-le-ne-lt 0 (s4-n x)))
;; 0 < |W| in context: land W^E /= 0
(define (s4-pow-nonzero! wv e)
  (let* ((p (s4-pw wv e)) (pw `(power ,(s4-n wv) ,e)))
    (dk-cite! 'rr-power-pos (s4-n wv) e)
    (dk-cite! 'nf-norm-of-zero 'K)
    (dk-have! `(NOT (= ,p (ZERO K)))
      (lambda ()
        (di)
        (dk-have! `(= ,(s4-n p) 0) (lambda () (subst `(= ,p (ZERO K))) (dk-ass!)))
        (dk-absurd! `(= ,(s4-n p) 0) `(= ,(s4-n p) ,pw) `(< 0 ,pw))))))
(define (s4-rr-mul! p q)
  (if (not (dk-asm? `(IN (* ,p ,q) RR)))
      (begin
        (s4-and! `(IN ,p RR) `(IN ,q RR))
        (dk-cite! 'rr-mul-closed p q))))
(define (s4-open-sep! name h)
  (let ((s (car (dk-landed (lambda () (mac-h name h))))))
    (dk-landed (lambda () (sep-me s)))))
;; w^(J + E) = w^J w^E in K form (J, E in NN; w typed); return the equation
(define (s4-pmul! j e)
  (s4-and! `(IN ,j NN) `(IN ,e NN))
  (dk-cite! 'nn-add-closed j e)
  (s4-pow! 'w j) (s4-pow! 'w e) (s4-pow! 'w `(+ ,j ,e))
  (let ((eq `(= ,(s4-pw 'w `(+ ,j ,e)) ,(s4-mul (s4-pw 'w j) (s4-pw 'w e)))))
    (dk-have! eq
      (lambda ()
        (subst (dk-cite! 'ring-power-add s4-view 'w j e))
        (subst `(= (MUL ,s4-view) (MUL K)))
        (rfl)))
    eq))
;; the field facts every proof here starts from (K a normed field, w in CARR K nonzero)
(define (s4-field!)
  (dk-cite! 'nf-zero-in-carr 'K) (dk-cite! 'nf-one-in-carr 'K) (dk-cite! 'nf-norm-of-zero 'K)
  (fact 'rr-zero-in) (fact 'rr-one-in) (fact 'nn-zero-in) (fact 'zz-zero-in)
  (s4-view!)
  (s4-norm-pos! 'w))
;; ZE in ZZ: land ZP(ZE) in CARR K and its defining equation; return ZP(ZE)
(define (s4-zp! e)
  (if (not (dk-asm? `(IN ,(s4-zp e) (CARR K))))
      (dk-split-all! (list (dk-cite! 'nv-zpow-def 'K 'w e))))
  (s4-zp e))
;; X, Y in ZZ: land X + Y in ZZ
(define (s4-zz-add! x y)
  (if (not (dk-asm? `(IN (+ ,x ,y) ZZ)))
      (begin (s4-and! `(IN ,x ZZ) `(IN ,y ZZ)) (dk-cite! 'zz-add-closed x y))))

;;; -----------------------------------------------------------------------
;;; A. integer powers

(define s4-wf-hyps '((IS-NORMED-FIELD K) (IN w (CARR K)) (NOT (= w (ZERO K)))))
(define (s4-curry fs body) (fold-right (lambda (p acc) `(IMPLIES ,p ,acc)) body fs))

;; w^k is characterised by any s - t = k: w^k w^t = w^s
(sp (make-wff `(FORALL K (FORALL w ,(s4-curry s4-wf-hyps
  `(FORALL ze (IMPLIES (IN ze ZZ) (FORALL s (IMPLIES (IN s NN) (FORALL t (IMPLIES (IN t NN)
     (IMPLIES (= (+ s (- t)) ze) (= ,(s4-mul (s4-zp 'ze) (s4-pw 'w 't)) ,(s4-pw 'w 's))))))))))))))
(dk-peel!)
(s4-field!)
(dk-split-all! (list (dk-cite! 'zz-int-halves 'ze)))
(s4-zp! 'ze)
(let* ((a (s4-amax 'ze)) (b (s4-bmax 'ze)) (y (s4-zp 'ze))
       (d0 `(= ,(s4-mul y (s4-pw 'w b)) ,(s4-pw 'w a)))
       (av (dk-name! a 'NN))
       (bv (dk-name! b 'NN))
       (d1 (dk-rewrite-h! d0 a av))
       (d2 (dk-rewrite-h! d1 b bv))
       (h1 (dk-rewrite-h! `(= (+ ,a (- ,b)) ze) a av))
       (h2 (dk-rewrite-h! h1 b bv)))
  (for-each (lambda (e) (dk-cite! 'nn-in-rr e)) (list av bv 's 't))
  (dk-cite! 'zz-in-rr 'ze)
  (dk-have! '(= s (+ ze t)) (lambda () (subst '(= ze (+ s (- t)))) (crs)))
  (dk-have! `(= ,av (+ ze ,bv)) (lambda () (subst `(= ze (+ ,av (- ,bv)))) (crs)))
  (dk-have! `(= (+ s ,bv) (+ ,av t)) (lambda () (subst '(= s (+ ze t))) (subst `(= ,av (+ ze ,bv))) (crs)))
  (let* ((et (s4-pw 'w 't)) (es (s4-pw 'w 's)) (eb (s4-pw 'w bv)) (ea (s4-pw 'w av))
         (p1 (s4-pmul! av 't))
         (p2 (s4-pmul! 's bv)))
    (s4-pow-nonzero! 'w bv)
    (dk-cite! 'nf-mul-in-carr 'K y et)
    (dk-cite! 'nf-mul-in-carr 'K es eb)
    (dk-have! `(= ,(s4-mul (s4-mul y et) eb) ,(s4-mul es eb))
      (lambda ()
        (subst (s4-ring-eq! `(= ,(s4-mul (s4-mul y et) eb) ,(s4-mul (s4-mul y eb) et)) (list y et eb)))
        (subst d2)
        (subst `(= ,(s4-mul ea et) ,(s4-pw 'w `(+ ,av t))))
        (subst `(= ,(s4-mul es eb) ,(s4-pw 'w `(+ s ,bv))))
        (subst `(= (+ s ,bv) (+ ,av t)))
        (rfl)))
    (dk-chain-ass! (dk-cite! 'nf-mul-cancel 'K (s4-mul y et) es eb))
    (dk-ass!)))
(qed 'nv-zpow-char)

;; w^k w = w^(k+1)
(sp (make-wff `(FORALL K (FORALL w ,(s4-curry s4-wf-hyps
  `(FORALL ze (IMPLIES (IN ze ZZ) (= ,(s4-mul (s4-zp 'ze) 'w) ,(s4-zp '(+ ze 1))))))))))
(dk-peel!)
(s4-field!)
(fact 'zz-one-in) (fact 'nn-one-in)
(dk-split-all! (list (dk-cite! 'zz-int-halves 'ze)))
(s4-zp! 'ze)
(s4-zz-add! 'ze 1)
(s4-zp! '(+ ze 1))
(let* ((a (s4-amax 'ze)) (b (s4-bmax 'ze)) (y (s4-zp 'ze)) (y1 (s4-zp '(+ ze 1)))
       (d0 `(= ,(s4-mul y (s4-pw 'w b)) ,(s4-pw 'w a)))
       (av (dk-name! a 'NN))
       (bv (dk-name! b 'NN))
       (d1 (dk-rewrite-h! d0 a av))
       (d2 (dk-rewrite-h! d1 b bv))
       (h1 (dk-rewrite-h! `(= (+ ,a (- ,b)) ze) a av))
       (h2 (dk-rewrite-h! h1 b bv)))
  (for-each (lambda (e) (dk-cite! 'nn-in-rr e)) (list av bv))
  (dk-cite! 'zz-in-rr 'ze)
  (s4-and! `(IN ,av NN) '(IN 1 NN)) (dk-cite! 'nn-add-closed av 1)
  (dk-have! `(= (+ (+ ,av 1) (- ,bv)) (+ ze 1)) (lambda () (subst `(= ze (+ ,av (- ,bv)))) (crs)))
  (let* ((c (dk-chain-ass! (dk-cite! 'nv-zpow-char 'K 'w '(+ ze 1) `(+ ,av 1) bv)))
         (eb (s4-pw 'w bv)) (ea (s4-pw 'w av))
         (p1 (s4-pmul! av 1)))
    (dk-cite! 'ring-power-one s4-view 'w)
    (s4-pow! 'w bv)
    (s4-pow-nonzero! 'w bv)
    (dk-cite! 'nf-mul-in-carr 'K y 'w)
    (dk-cite! 'nf-mul-in-carr 'K y1 eb)
    (dk-have! `(= ,(s4-mul (s4-mul y 'w) eb) ,(s4-mul y1 eb))
      (lambda ()
        (subst (s4-ring-eq! `(= ,(s4-mul (s4-mul y 'w) eb) ,(s4-mul (s4-mul y eb) 'w)) (list y 'w eb)))
        (subst d2)
        (subst c)
        (subst p1)
        (subst `(= ,(s4-pw 'w 1) w))
        (rfl)))
    (dk-chain-ass! (dk-cite! 'nf-mul-cancel 'K (s4-mul y 'w) y1 eb))
    (dk-ass!)))
(qed 'nv-zpow-succ)

;; w^k w^(-k) = 1
(sp (make-wff `(FORALL K (FORALL w ,(s4-curry s4-wf-hyps
  `(FORALL ze (IMPLIES (IN ze ZZ) (= ,(s4-mul (s4-zp 'ze) (s4-zp '(- ze))) (ONE K)))))))))
(dk-peel!)
(s4-field!)
(dk-split-all! (list (dk-cite! 'zz-int-halves 'ze)))
(dk-cite! 'zz-neg-closed 'ze)
(s4-zp! 'ze) (s4-zp! '(- ze))
(let* ((a (s4-amax 'ze)) (b (s4-bmax 'ze)) (y (s4-zp 'ze)) (z (s4-zp '(- ze)))
       (d0 `(= ,(s4-mul y (s4-pw 'w b)) ,(s4-pw 'w a)))
       (av (dk-name! a 'NN))
       (bv (dk-name! b 'NN))
       (d1 (dk-rewrite-h! d0 a av))
       (d2 (dk-rewrite-h! d1 b bv))
       (h1 (dk-rewrite-h! `(= (+ ,a (- ,b)) ze) a av))
       (h2 (dk-rewrite-h! h1 b bv)))
  (for-each (lambda (e) (dk-cite! 'nn-in-rr e)) (list av bv))
  (dk-cite! 'zz-in-rr 'ze)
  (dk-have! `(= (+ ,bv (- ,av)) (- ze)) (lambda () (subst `(= ze (+ ,av (- ,bv)))) (crs)))
  (let* ((c (dk-chain-ass! (dk-cite! 'nv-zpow-char 'K 'w '(- ze) bv av)))
         (eb (s4-pw 'w bv)) (ea (s4-pw 'w av)) (q (s4-pw 'w `(+ ,av ,bv)))
         (p1 (s4-pmul! av bv)))
    (s4-pow-nonzero! 'w `(+ ,av ,bv))
    (dk-cite! 'nf-mul-in-carr 'K y z)
    (dk-have! `(= ,(s4-mul (s4-mul y z) q) ,(s4-mul '(ONE K) q))
      (lambda ()
        (subst p1)
        (subst (s4-ring-eq! `(= ,(s4-mul (s4-mul y z) (s4-mul ea eb)) ,(s4-mul (s4-mul y eb) (s4-mul z ea))) (list y z ea eb)))
        (subst d2)
        (subst c)
        (s4-crs! (list ea eb))))
    (dk-chain-ass! (dk-cite! 'nf-mul-cancel 'K (s4-mul y z) '(ONE K) q))
    (dk-ass!)))
(qed 'nv-zpow-inv)

;; |w^k| = |w|^k for k in NN
(sp (make-wff `(FORALL K (FORALL w ,(s4-curry s4-wf-hyps
  `(FORALL ze (IMPLIES (IN ze NN) (= ,(s4-n (s4-zp 'ze)) (power ,(s4-n 'w) ze)))))))))
(dk-peel!)
(s4-field!)
(dk-cite! 'nv-zpow-nat 'K 'w 'ze)
(s4-pow! 'w 'ze)
(subst `(= ,(s4-zp 'ze) ,(s4-pw 'w 'ze)))
(dk-ass!)
(qed 'nv-zpow-norm-nat)

