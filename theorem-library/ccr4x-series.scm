;;; B. the partial sums

(define (s4-term a n j) (s4-mul `(,a (+ ,n ,j)) (s4-zp `(+ ,n ,j))))

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL w (FORALL a (FORALL n (= (NV-PSUM K w a n 0) (ZERO K)))))))))
(dk-peel!)
(dk-cite! 'nf-zero-in-carr 'K)
(mac 'NV-PSUM) (mac 'NV-TERM)
(mac 'sum-ag-zero)
(dk-have! '(== (IDEN (NORMED-FIELD-ADDITIVE-AG K)) (ZERO K)) (lambda () (mac 'normed-field-additive-ag) (slot 'IDEN) (nth-r) (qrfl)))
(subst '(== (IDEN (NORMED-FIELD-ADDITIVE-AG K)) (ZERO K)))
(rfl)
(qed 'nv-psum-zero)

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL w (FORALL a (FORALL n (FORALL m (IMPLIES (IN m NN)
  (== (NV-PSUM K w a n (succ m)) ,(s4-add '(NV-PSUM K w a n m) (s4-term 'a 'n 'm))))))))))))
(dk-peel!)
(mac 'NV-PSUM) (mac 'NV-TERM)
(mac 'sum-ag-succ)
(dk-have! '(== (OPR (NORMED-FIELD-ADDITIVE-AG K)) (ADD K)) (lambda () (mac 'normed-field-additive-ag) (slot 'OPR) (nth-r) (qrfl)))
(subst '(== (OPR (NORMED-FIELD-ADDITIVE-AG K)) (ADD K)))
(dk-lam-b!)
(qrfl)
(qed 'nv-psum-succ)

;; A in FUN(ZZ, CARR K), N in ZZ, J in NN: land the term a(n+j) w^(n+j) in CARR K; return it
(define (s4-term! a n j)
  (let ((nj `(+ ,n ,j)))
    (if (not (dk-asm? `(IN ,j ZZ))) (dk-cite! 'nn-subset-zz j))
    (s4-zz-add! n j)
    (if (not (dk-asm? `(IN (,a ,nj) (CARR K)))) (dk-cite! 'fun-apply-type-c a 'ZZ '(CARR K) nj))
    (s4-zp! nj)
    (if (not (dk-asm? `(IN ,(s4-term a n j) (CARR K)))) (dk-cite! 'nf-mul-in-carr 'K `(,a ,nj) (s4-zp nj)))
    (s4-term a n j)))

(sp (make-wff `(FORALL m (IMPLIES (IN m NN) (FORALL K (FORALL w ,(s4-curry s4-wf-hyps
  `(FORALL a (IMPLIES (IN a (FUN ZZ (CARR K))) (FORALL n (IMPLIES (IN n ZZ) (IN (NV-PSUM K w a n m) (CARR K)))))))))))))
(let* ((r (dk-use-induction-fixed! '(K w a n)))
       (base (cdr (assq 'base r))) (step (cdr (assq 'step r))) (ih (cdr (assq 'ih r))) (m (cdr (assq 'var r))))
  (dk-focus! base)
  (dk-cite! 'nf-zero-in-carr 'K)
  (subst (dk-cite! 'nv-psum-zero 'K 'w 'a 'n))
  (dk-ass!)
  (dk-focus! step)
  (subst (dk-cite! 'nv-psum-succ 'K 'w 'a 'n m))
  (s4-term! 'a 'n m)
  (dk-cite! 'nf-add-in-carr 'K `(NV-PSUM K w a n ,m) (s4-term 'a 'n m))
  (dk-ass!))
(qed 'nv-psum-type)

;;; -----------------------------------------------------------------------
;;; C. digits

(define s4-hyps '((IS-COMPACT-NV-DOMAIN K A) (IN w A) (= (NV-MAXIMAL K A) (NV-PRINCIPAL K A w)) (NOT (= w (ZERO K)))
                  (= A (NV-INTEGERS K)) (IS-NV-REP-SET K A RP)))
(define (s4-all body) `(FORALL K (FORALL A (FORALL w (FORALL RP ,(s4-curry s4-hyps body))))))
(define (s4-setup!)
  (dk-cite! 'nv-compact-domain 'K 'A)
  (dk-cite! 'nv-domain-normed 'K 'A)
  (dk-cite! 'nv-domain-field 'K 'A)
  (dk-cite! 'nv-domain-sub 'K 'A 'w)
  (s4-field!))
(define (s4-dg z) `(NV-DIGIT K RP ,z))
;; X in A: land X in CARR K
(define (s4-in-a! x)
  (if (not (dk-asm? `(IN ,x (CARR K)))) (dk-cite! 'nv-domain-sub 'K 'A x)))

(sp (make-wff (s4-all `(FORALL z (IMPLIES (IN z A) (AND (IN ,(s4-dg 'z) RP) (< ,(s4-n (s4-d 'z (s4-dg 'z))) 1)))))))
(dk-peel!)
(s4-setup!)
(s4-in-a! 'z)
(mac 'NV-DIGIT)
(let* ((io (cadr (cadr (dk-goal))))
       (ls (dk-opened (lambda () (iota-d io)))))
  (for-each
    (lambda (l)
      (if (not (sequent-node-grounded? l))
          (begin
            (dk-focus! l)
            (if (dk-head-is? (dk-goal) 'FORSOME)
                (let ((r0 (dk-skolem! (dk-cite! 'nv-rep-set-exists 'K 'A 'RP 'z))))
                  (dk-cite! 'nv-rep-set-sub 'K 'A 'RP r0)
                  (s4-in-a! r0)
                  (ew r0)
                  (dk-conj-close!
                    (lambda ()
                      (if (not (dk-ass!))
                          (begin
                            (dk-landed (lambda () (dk-peel!)))
                            (dk-split-all!)
                            (let* ((y (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (not (equal? (cadr f) r0)) (eq? (caddr f) 'RP))) (dk-asms))))
                                   (e1 (s4-d 'z r0)) (e2 (s4-d 'z y)))
                              (dk-cite! 'nv-rep-set-sub 'K 'A 'RP y)
                              (s4-in-a! y)
                              (dk-cite! 'nf-neg-in-carr 'K r0) (dk-cite! 'nf-neg-in-carr 'K y)
                              (dk-cite! 'nf-add-in-carr 'K 'z (s4-neg r0)) (dk-cite! 'nf-add-in-carr 'K 'z (s4-neg y))
                              (dk-cite! 'nf-neg-in-carr 'K e2)
                              (s4-typek! e1) (s4-typek! e2)
                              (dk-cite! 'nf-norm-neg 'K e2)
                              (dk-cite! 'nf-add-in-carr 'K e1 (s4-neg e2))
                              (s4-typek! (s4-add e1 (s4-neg e2)))
                              (let* ((u0 (dk-cite! 'nv-ultra 'K e1 (s4-neg e2)))
                                     (u1 (dk-rewrite-h! u0 (s4-n (s4-neg e2)) (s4-n e2))))
