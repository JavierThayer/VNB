                                        (dk-ineq! `(= (* ,np ,nf) (* ,nf ,np)) `(<= (* ,nf ,np) (* 1 ,np)) `(= ,np ,wn) `(= ,wn ,wcd)
                                                  `(= ,wcd (* ,wc ,wd)) `(= (* ,wc ,wd) (* ,wd ,wc)) `(<= (* ,wd ,wc) (* 1 ,wc))
                                                  `(< ,wc ,eps) `(IN ,np RR) `(IN ,wc RR))))))))))))))))))))))
(qed 'ccr-4-17)

;; every x in K has an expansion (x = 0: start 0; x = w^k u: start k)
(sp (make-wff (s4-all `(FORALL x (IMPLIES (IN x (CARR K))
  (FORSOME n (AND (IN n ZZ) (FORSOME dga (IS-NV-EXPANSION K w RP dga n x)))))))))
(dk-peel!)
(s4-setup!)
(use-em '(= x (ZERO K))
  (lambda ()
    (dk-cite! 'nv-domain-zero 'K 'A)
    (dk-cite! 'zz-neg-closed 0)
    (s4-zp! '(- 0))
    (dk-have! `(IN ,(s4-mul (s4-zp '(- 0)) 'x) A)
      (lambda ()
        (subst '(= x (ZERO K)))
        (subst (s4-ring-eq! `(= ,(s4-mul (s4-zp '(- 0)) '(ZERO K)) (ZERO K)) (list (s4-zp '(- 0)))))
        (dk-ass!)))
    (dk-cite! 'ccr-4-17 'K 'A 'w 'RP 'x 0)
    (ew 0)
    (dk-conj-close! (lambda () (dk-ass!))))
  (lambda ()
    (let* ((e (dk-skolem! (dk-cite! 'ccr-4-8 'K 'A 'w 'x)))
           (u (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f e))) "the unit")))
           (ze (s4-zp e)) (zm (s4-zp `(- ,e))))
      (dk-have! `(IN ,u A)
        (lambda () (let ((s (car (dk-landed (lambda () (mac-h 'nv-units-unfold `(IN ,u (NV-UNITS K A)))))))) (sep-me s) (dk-ass!))))
      (s4-in-a! u)
      (dk-cite! 'zz-neg-closed e)
      (s4-zp! e) (s4-zp! `(- ,e))
      (dk-cite! 'nv-zpow-inv 'K 'w e)
      (dk-have! `(IN ,(s4-mul zm 'x) A)
        (lambda ()
          (subst `(= x ,(s4-mul ze u)))
          (subst (s4-ring-eq! `(= ,(s4-mul zm (s4-mul ze u)) ,(s4-mul (s4-mul ze zm) u)) (list zm ze u)))
          (subst `(= ,(s4-mul ze zm) (ONE K)))
          (subst (s4-ring-eq! `(= ,(s4-mul '(ONE K) u) ,u) (list u)))
          (dk-ass!)))
      (dk-cite! 'ccr-4-17 'K 'A 'w 'RP 'x e)
      (ew e)
      (dk-conj-close! (lambda () (dk-ass!))))))
(qed 'ccr-4-17-exists)
