    (s4-or-asm `(IN ,j NN) (lambda () (dk-chain-ass! (dk-cite! 'zz-nonneg-in-nn j))))
    (s4-or-asm `(IN (,f ,j) A) (lambda () (dk-cite! 'fun-apply-type-c f 'NN 'A j)))
