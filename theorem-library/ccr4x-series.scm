       (base (cdr (assq 'base r))) (step (cdr (assq 'step r))) (ih (cdr (assq 'ih r))) (kv (cdr (assq 'var r))))
  (dk-focus! base)
  (s4-setup!)
  (dk-cite! 'fun-apply-type-c 'f 'NN 'A 0)
