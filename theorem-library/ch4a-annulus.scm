(define (ann-via! A B w) (dk-have! (list '= A w) (lambda () (subst (list '== A B)) (ass))))
;; ---- the traces of the pieces lie in u
(define (ann-trace! P a b pointwise)  ; POINTWISE: t -> land (IN (P t) u)
  (dk-have! (list 'FORALL 'ant_ (list 'IMPLIES (list 'IN 'ant_ (list 'CCINT a b)) (list 'IN (list P 'ant_) 'u)))
    (lambda () (let ((t (dk-di-var!))) (pointwise t) (ass))))
  (dk-cite! 'trace-in-of-values P a b 'u))
(define (ann-trace-cases! P a b pointwise)  ; POINTWISE splits and closes each branch itself
  (dk-have! (list 'FORALL 'ant_ (list 'IMPLIES (list 'IN 'ant_ (list 'CCINT a b)) (list 'IN (list P 'ant_) 'u)))
    (lambda () (let ((t (dk-di-var!))) (pointwise t))))
  (dk-cite! 'trace-in-of-values P a b 'u))
(ann-trace! ann-K2 0 1 (lambda (t) (ann-u! (list ann-K2 t) (ann-v-K! ann-p2 'r2 t))))
