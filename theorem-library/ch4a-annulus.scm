(define (ann-shift-at-start! P b1 c2 d2 w)   ; (= ((shift P) b1) w) from (= (P c2) w), c2 = 0
  (let* ((S (ann-shift P b1 c2 d2)) (T (ann-end b1 c2 d2)))
    (ann-in-cc! b1 b1 T (list 'IN b1 'RR) (list 'IN T 'RR) (list '< b1 T))
    (let ((v (ann-shift-val! P b1 c2 d2 b1)))
      (dk-have! (list '= (list S b1) w)
        (lambda () (subst (list '== (list S b1) v))
                   (dk-have! (list '= (ann-arg c2 b1 b1) c2) (lambda () (crs)))
                   (subst (list '= (ann-arg c2 b1 b1) c2))
                   (ass))))))
