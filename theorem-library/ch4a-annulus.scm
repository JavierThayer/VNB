;; ---- the constant pieces integrate to 0: congruence with CH3-C's constant road, then const-road-line-int
(define (ann-const0! p r)          ; p = ac + r, r in [r1, r2]: (= (LINE-INT f K KD 0 1) 0) for K = SEG-PATH(p, p)
  (let* ((K (list 'SEG-PATH p p)) (KD (list 'SEG-DERIV p p))
         (kap (list 'VNB-LAMBDA 'cgq_ '(CCINT 0 1) p)) (kap1 '(VNB-LAMBDA cgq_ (CCINT 0 1) 0))
         (li (list 'LINE-INT 'f K KD 0 1)))
    ;; p in u
    (fact 'rr-subset-cc r)
    (dk-have! (list '= p (list '+ 'ac (list '* r 1))) (lambda () (crs)))
    (ann-in-band! p r 1)
    ;; the typings of the constant lambdas
    (fact 'rr-is-set) (fact 'ccint-subset-rr 0 1) (fact 'subclass-of-set-is-set '(CCINT 0 1) 'RR)
    (fact 'subset-mem-fwd 'u 'CC p)
    (for-each (lambda (kk)
                (if (not (dk-asm? (list 'IN kk '(FUN (CCINT 0 1) CC))))
                    (dk-have! (list 'IN kk '(FUN (CCINT 0 1) CC))
                      (lambda () (dk-lam-type! (lambda () (dk-di-var!) (ass)) (lambda () (ass)))))))
              (list kap kap1))
    ;; pointwise agreement
    (dk-have! (list 'FORALL 'ant_ (list 'IMPLIES '(IN ant_ (CCINT 0 1)) (list '== (list kap 'ant_) (list K 'ant_))))
      (lambda ()
        (let* ((t (dk-di-var!)) (v (ann-seg-val! p p t)))
          (ann-ccparts! t 0 1) (fact 'rr-subset-cc t)
          (dk-lam-b!)
          (if (pair? (dk-open-leaves))
              (begin
                (subst (list '== (list K t) v))
                (dk-have! (list '= v p) (lambda () (crs)))
                (subst (list '= v p))
                (if (pair? (dk-open-leaves)) (qrfl)))))))
    (dk-have! (list '= (list '- p p) 0) (lambda () (crs)))
    (fact 'seg-deriv-bridge p p 0)
    (dk-have! (list 'FORALL 'ant_ (list 'IMPLIES '(IN ant_ (OOINT 0 1)) (list '== (list kap1 'ant_) (list KD 'ant_))))
      (lambda ()
        (let* ((t (dk-di-var!)))
          (subst (list '== KD '(VNB-LAMBDA psx_ (CCINT 0 1) 0)))
          (qrfl))))
    (let ((c1 (dk-cite! 'line-int-interior-congruence 'u 'f K KD 0 1 kap kap1))
          (c2 (dk-cite! 'const-road-line-int 'u 'f p 0 1)))
      (dk-have! (list '= li 0)
        (lambda () (subst (list '= li (list 'LINE-INT 'f kap kap1 0 1))) (ass))))))
(dk-have! '(<= r1 r2) (lambda () (dk-ineq! '(< r1 r2))))
(dk-have! '(<= r2 r2) (lambda () (dk-ineq! '(IN r2 RR))))
(dk-have! '(<= r1 r1) (lambda () (dk-ineq! '(IN r1 RR))))
(ann-const0! ann-p2 'r2)
(ann-const0! ann-p1 'r1)
;; ---- the straight-line homotopy from P to Q stays in u
;; (= Z0 W) from (== Z0 Z1), ..., (== Zn-1 Zn) and (= Zn W) in context
(define (ann-chain! w zs)
  (let ((z0 (car zs)))
    (dk-have! (list '= z0 w)
      (lambda ()
        (let loop ((l zs))
          (if (pair? (cdr l)) (begin (subst (list '== (car l) (cadr l))) (loop (cdr l)))))
        (ass)))))
;; Pt = c + a e, Qt = c + b e, b <= a, r1 <= b, a <= r2, s in [0, 1]: Pt + s (Qt - Pt) in u
(define (ann-seg-pt! Pt a Qt b e s)
  (let* ((m (list '+ a (list '* s (list '- b a)))) (z (list '+ Pt (list '* s (list '- Qt Pt)))))
    (fact 'rr-sub-in-rr b a) (fact 'rr-mul-in-rr s (list '- b a)) (fact 'rr-add-in-rr a (list '* s (list '- b a)))
    (ann-split-cite! 'lerp-between b a s)
    (dk-have! (list '<= 'r1 m) (lambda () (dk-ineq! (list '<= 'r1 b) (list '<= b m))))
    (dk-have! (list '<= m 'r2) (lambda () (dk-ineq! (list '<= m a) (list '<= a 'r2))))
    (for-each (lambda (x) (fact 'rr-subset-cc x)) (list a b s))
    (dk-have! (list '= z (list '+ 'ac (list '* m e)))
      (lambda ()
        (subst (list '= Pt (list '+ 'ac (list '* a e))))
        (subst (list '= Qt (list '+ 'ac (list '* b e))))
        (crs)))
    (ann-in-band! z m e)))
(define ann-seg-goal
  (list 'FORALL 'slt_ (list 'IMPLIES (list 'IN 'slt_ (list 'CCINT 0 ann-T)) (list 'FORALL 'sls_ (list 'IMPLIES '(IN sls_ (CCINT 0 1))
    (list 'IN (list '+ (list ann-P 'slt_) (list '* 'sls_ (list '- (list ann-Q 'slt_) (list ann-P 'slt_)))) 'u))))))
(dk-have! (list '<= ann-T1 ann-T) (lambda () (apply dk-ineq! ann-tprem)))
(dk-have! ann-seg-goal
  (lambda ()
    (let* ((pl (dk-peel!)) (t (cadr (car pl))) (s (cadr (cadr pl))) (Pt (list ann-P t)) (Qt (list ann-Q t)))
 (ann-ccparts! t 0 ann-T) (ann-ccparts! s 0 1)      (use-em (list '<= t ann-T1)
        (lambda ()
          (ann-in-cc! t 0 ann-T1 (list 'IN t 'RR) (list '<= 0 t) (list '<= t ann-T1))
          (ann-left! ann-J1 ann-SL 0 ann-T1 ann-T t)
          (ann-left! ann-J3 ann-SK1 0 ann-T1 ann-T t)
          (use-em (list '<= t 1)
            (lambda ()
              (ann-in-cc! t 0 1 (list 'IN t 'RR) (list '<= 0 t) (list '<= t 1))
              (ann-left! ann-K2 ann-SG2 0 1 ann-T1 t)
              (ann-left! ann-L ann-SG1 0 1 ann-T1 t)
              (let* ((rp (ann-v-K! ann-p2 'r2 t)) (rq (ann-v-L! t)))
                (ann-chain! (list '+ 'ac (list '* 'r2 1)) (list Pt (list ann-J1 t) (list ann-K2 t)))
                (ann-chain! (list '+ 'ac (list '* (car rq) 1)) (list Qt (list ann-J3 t) (list ann-L t)))
                (dk-have! '(<= r2 r2) (lambda () (dk-ineq! '(IN r2 RR))))
                (ann-seg-pt! Pt 'r2 Qt (car rq) 1 s)
                (ass)))
            (lambda ()
              (fact 'rr-not-le-lt t 1)
              (ann-in-cc! t 1 ann-T1 (list 'IN t 'RR) (list '< 1 t) (list '<= t ann-T1))
              (ann-right! ann-K2 ann-SG2 0 1 ann-T1 t)
              (ann-right! ann-L ann-SG1 0 1 ann-T1 t)
              (let* ((x (ann-arg 0 t 1)))
                (ann-shift-val! ann-G2 1 0 ann-TP t) (ann-shift-val! ann-G1 1 0 ann-TP t)
                (fact 'rr-sub-in-rr t 1) (fact 'rr-add-in-rr 0 (list '- t 1))
                (ann-in-cc! x 0 ann-TP (list 'IN t 'RR) (list '< 1 t) (list '<= t ann-T1) (list 'IN ann-TP 'RR))
                (let* ((e2 (ann-v-G! 'r2 x)) (e1 (ann-v-G! 'r1 x)) (E (cadr e2)))
                  (ann-chain! (list '+ 'ac (list '* 'r2 E)) (list Pt (list ann-J1 t) (list ann-SG2 t) (list ann-G2 x)))
                  (ann-chain! (list '+ 'ac (list '* 'r1 E)) (list Qt (list ann-J3 t) (list ann-SG1 t) (list ann-G1 x)))
                  (dk-have! '(<= r2 r2) (lambda () (dk-ineq! '(IN r2 RR))))
                  (dk-have! '(<= r1 r1) (lambda () (dk-ineq! '(IN r1 RR))))
                  (ann-seg-pt! Pt 'r2 Qt 'r1 E s)
                  (ass))))))
        (lambda ()
          (fact 'rr-not-le-lt t ann-T1)
          (ann-in-cc! t ann-T1 ann-T (list 'IN t 'RR) (list '< ann-T1 t) (list '<= t ann-T))
          (ann-right! ann-J1 ann-SL 0 ann-T1 ann-T t)
          (ann-right! ann-J3 ann-SK1 0 ann-T1 ann-T t)
          (let* ((x (ann-arg 0 t ann-T1)))
            (ann-shift-val! ann-L ann-T1 0 1 t) (ann-shift-val! ann-K1 ann-T1 0 1 t)
            (fact 'rr-sub-in-rr t ann-T1) (fact 'rr-add-in-rr 0 (list '- t ann-T1))
            (apply ann-in-cc! x 0 1 (append (list (list 'IN t 'RR) (list '< ann-T1 t) (list '<= t ann-T)) ann-tprem))
            (let* ((rp (ann-v-L! x)) (rq (ann-v-K! ann-p1 'r1 x)))
              (ann-chain! (list '+ 'ac (list '* (car rp) 1)) (list Pt (list ann-SL t) (list ann-L x)))
              (ann-chain! (list '+ 'ac (list '* 'r1 1)) (list Qt (list ann-SK1 t) (list ann-K1 x)))
              (dk-have! '(<= r1 r1) (lambda () (dk-ineq! '(IN r1 RR))))
              (ann-seg-pt! Pt (car rp) Qt 'r1 1 s)
              (ass))))))))
