;; juxta values
(define (ann-left! P1 S2 a1 b1 c1 t)  ; t in [a1, b1], b1 <= c1: (== ((JUXTA P1 S2 a1 b1 c1) t) (P1 t))
  (dk-cite! 'juxta-apply-left P1 S2 a1 b1 c1 t))
(define (ann-right! P1 S2 a1 b1 c1 t) ; t in [b1, c1], a1 <= b1, b1 < t: (== (J t) (S2 t))
  (dk-cite! 'juxta-apply-right P1 S2 a1 b1 c1 t))
