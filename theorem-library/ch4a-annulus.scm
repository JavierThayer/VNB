        (lambda ()
          (subst (list '== (list J ann-T1) (list S ann-T1)))
          (subst (list '== (list S ann-T1) v))
          (dk-have! (list '= (ann-arg 0 ann-T1 1) ann-TP) (lambda () (crs)))
          (subst (list '= (ann-arg 0 ann-T1 1) ann-TP))
          (ass))))
    (list '= (list J ann-T1) w)))
(ann-J-end! ann-K2 ann-G2 'r2)
(ann-J-end! ann-L ann-G1 'r1)
