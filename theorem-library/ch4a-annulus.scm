    (ann-split-cite! 'cc-exp-converges (list '* '+i x))
    (dk-have! (list '= (list G x) (list '+ 'ac (list '* r E))) (lambda () (subst (list '== (list G x) v)) (rfl)))
    (list r E)))
(define (ann-v-L! t)              ; t in [0, 1]: (= (L t) (+ ac (* rho 1))), r1 <= rho <= r2
  (let* ((v (ann-seg-val! ann-p2 ann-p1 t)) (rho (list '+ 'r2 (list '* t (list '- 'r1 'r2)))))
    (ann-ccparts! t 0 1) (fact 'rr-subset-cc t)
    (fact 'rr-sub-in-rr 'r1 'r2) (fact 'rr-mul-in-rr t (list '- 'r1 'r2)) (fact 'rr-add-in-rr 'r2 (list '* t (list '- 'r1 'r2)))
    (ann-split-cite! 'lerp-between 'r1 'r2 t)
    (fact 'rr-subset-cc rho)
    (dk-have! (list '= (list ann-L t) (list '+ 'ac (list '* rho 1))) (lambda () (subst (list '== (list ann-L t) v)) (crs)))
    (list rho 1)))
;; a point with a value form lies in u
(define (ann-u! z re)             ; re = (rho e) with (= z (+ ac (* rho e))) landed, |e| = 1, r1 <= rho <= r2
