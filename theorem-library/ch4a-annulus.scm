;; ---- values of the first joins on [0, T1], by cases (inside a goal lane: use-em splits the goal)
;; left piece of J at t <= 1, right piece (G shifted) at t > 1; BODY receives (= (J t) value) and (rho e)
(define (ann-J-cases! P1 v1! G r t body)
  (let* ((S (ann-shift G 1 0 ann-TP)) (J (list 'JUXTA P1 S 0 1 ann-T1)))
    (ann-ccparts! t 0 ann-T1)
    (use-em (list '<= t 1)
      (lambda ()
        (ann-in-cc! t 0 1 (list 'IN t 'RR) (list '<= 0 t) (list '<= t 1))
        (ann-left! P1 S 0 1 ann-T1 t)
        (let ((re (v1! t)))
          (ann-via! (list J t) (list P1 t) (list '+ 'ac (list '* (car re) (cadr re))))
          (body (list J t) re)))
      (lambda ()
        (fact 'rr-not-le-lt t 1)
        (ann-in-cc! t 1 ann-T1 (list 'IN t 'RR) (list '< 1 t) (list '<= t ann-T1))
        (ann-right! P1 S 0 1 ann-T1 t)
        (let* ((x (ann-arg 0 t 1))
               (_v (ann-shift-val! G 1 0 ann-TP t)))
          (fact 'rr-sub-in-rr t 1) (fact 'rr-add-in-rr 0 (list '- t 1))
          (ann-in-cc! x 0 ann-TP (list 'IN t 'RR) (list '< 1 t) (list '<= t ann-T1) (list 'IN ann-TP 'RR))
          (let ((re (ann-v-G! r x)))
            (dk-have! (list '= (list J t) (list '+ 'ac (list '* (car re) (cadr re))))
              (lambda () (subst (list '== (list J t) (list S t))) (subst (list '== (list S t) (list G x))) (ass)))
            (body (list J t) re)))))))
(fact 'rr-zero-in) (fact 'rr-one-in)
(if (not (dk-asm? '(<= 0 1))) (dk-have! '(<= 0 1) (lambda () (dk-ineq!))))
(if (not (dk-asm? (list '<= 1 ann-T1))) (dk-have! (list '<= 1 ann-T1) (lambda () (dk-ineq! (list 'IN ann-TP 'RR) (list '< 0 ann-TP)))))
(if (not (dk-asm? (list '<= 0 ann-T1))) (dk-have! (list '<= 0 ann-T1) (lambda () (dk-ineq! (list 'IN ann-TP 'RR) (list '< 0 ann-TP)))))
(ann-trace-cases! ann-J1 0 ann-T1 (lambda (t) (ann-J-cases! ann-K2 (lambda (t) (ann-v-K! ann-p2 'r2 t)) ann-G2 'r2 t (lambda (z re) (ann-u! z re) (ass)))))
(ann-trace-cases! ann-J3 0 ann-T1 (lambda (t) (ann-J-cases! ann-L ann-v-L! ann-G1 'r1 t (lambda (z re) (ann-u! z re) (ass)))))
