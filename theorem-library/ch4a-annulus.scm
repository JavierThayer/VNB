;; ---- the homotopy and the bookkeeping
(define (ann-finish!)
  (let* ((LI (lambda (g d a b) (list 'LINE-INT 'f g d a b)))
         (A (LI ann-G2 ann-D2 0 ann-TP)) (B (LI ann-G1 ann-D1 0 ann-TP)) (C (LI ann-L ann-DL 0 1))
         (K2I (LI ann-K2 ann-K2D 0 1)) (K1I (LI ann-K1 ann-K1D 0 1))
         (J1I (LI ann-J1 ann-J1D 0 ann-T1)) (J3I (LI ann-J3 ann-J3D 0 ann-T1))
         (PI_ (LI ann-P ann-PD 0 ann-T)) (QI (LI ann-Q ann-QD 0 ann-T)))
    (dk-cite! 'straight-line-homotopic 'u ann-P ann-Q 0 ann-T)
    (dk-cite! 'homotopy-line-int 'u 'f ann-P ann-PD ann-Q ann-QD 0 ann-T)
    (dk-cite! 'line-int-in-cc 'u 'f ann-G2 ann-D2 0 ann-TP)
    (dk-cite! 'line-int-in-cc 'u 'f ann-G1 ann-D1 0 ann-TP)
    (dk-cite! 'line-int-in-cc 'u 'f ann-L ann-DL 0 1)
    (let* ((QB (list '+ (list '+ C B) 0)) (PA (list '+ (list '+ 0 A) C)))
      (dk-have! (list '= QB QI)
        (lambda () (subst (list '= QI (list '+ J3I K1I))) (subst (list '= J3I (list '+ C B))) (subst (list '= K1I 0)) (rfl)))
      (dk-have! (list '= PA PI_)
        (lambda () (subst (list '= PI_ (list '+ J1I C))) (subst (list '= J1I (list '+ K2I A))) (subst (list '= K2I 0)) (rfl)))
      (dk-have! (list '= B (list '- QB C)) (lambda () (crs)))
      (subst (list '= B (list '- QB C)))
      (subst (list '= QB QI))
      (subst (list '= QI PI_))
      (subst (list '= PI_ PA))
      (crs))))
(ann-finish!)
(qed 'annulus-cauchy)
