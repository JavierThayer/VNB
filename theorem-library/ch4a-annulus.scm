;;; Library: complex-analysis.

;;; ch4a-annulus.scm -- Cauchy's theorem on an annulus (CH4-A, 2026-10-28): for f holomorphic on an open u
;;; holding the closed annulus r1 <= |z - c| <= r2, the integrals over the two circles agree.
;;; HOMOTOPIC fixes the ends, and two circles do not share an end, so the circles are not compared directly:
;;;   P = (constant at c + r2) * (circle r2) * (segment c + r2 -> c + r1)
;;;   Q = (segment c + r2 -> c + r1) * (circle r1) * (constant at c + r1)
;;; on the same parameter interval have the same ends and, at every time, P(t) and Q(t) lie on one ray from c
;;; at radii in [r1, r2]; so the straight-line homotopy stays in u (straight-line-homotopic), CH3-C's
;;; homotopy-line-int gives int_P = int_Q, and line-int-concat splits both: the segment integrals cancel and the
;;; constant ones vanish.  Library: complex-analysis.  Load window: after ch4a-straight and CH3-C (ch3c-ga's
;;; const-road / const-road-line-int, ch3c-hom's homotopy-line-int).  Prefix ann-.

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (ann-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (if (pair? (dk-open-leaves)) (ass)))))))
    f))
;; cite a conjunctive fact and split it, unless every conjunct is already in context
(define (ann-conjs f) (if (and (pair? f) (eq? (car f) 'AND)) (append (ann-conjs (cadr f)) (ann-conjs (caddr f))) (list f)))
(define (ann-split-cite! name . args)
  (let ((f (apply dk-cite! name args)))
    (if (not (every dk-asm? (ann-conjs f))) (dk-split-all! (list f)))
    f))
(define (ann-find what pred)
  (let ((l (filter pred (dk-asms)))) (if (null? l) (error "ann-find: nothing matching" what) (car l))))

;;; (1) a path all of whose values lie in s has its trace in s
(sp (make-wff "forall([anp_, ana_, anb_, ans_], forall([ant_ in ccint(ana_, anb_)], anp_(ant_) in ans_) implies trace(anp_, ana_, anb_) subset ans_)"))
(dk-peel!)
(let ((hw (ann-find 'hw (lambda (z) (dk-head-is? z 'FORALL)))))
  (mac 'subset-def)
  (let* ((pl (dk-peel!)) (z (cadr (car pl)))
         (mz (list 'IN z '(TRACE anp_ ana_ anb_))))
    (fact 'trace-unfold 'anp_ 'ana_ 'anb_)
    (dk-rewrite-h! mz '(TRACE anp_ ana_ anb_) '(IMAGE anp_ (CCINT ana_ anb_)))
    (let* ((iff (dk-cite! 'image-membership-iff 'anp_ '(CCINT ana_ anb_) z)))
      (dk-have! (caddr iff) (lambda () (prop)))
      (dk-split! (caddr iff))
      (let* ((x (dk-skolem! (ann-find 'ex (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f z)))) #t)))
        (inst+ hw x)
        (subst (list '= z (list 'anp_ x)))
        (ass)))))
(qed 'trace-in-of-values)

;;; ---------------------------------------------------------------------------------------------------------
;;; (2) Cauchy on the annulus
(define ann-TP '(* 2 PI))
(define ann-p2 '(+ ac r2))
(define ann-p1 '(+ ac r1))
(define ann-K2 '(SEG-PATH (+ ac r2) (+ ac r2))) (define ann-K2D '(SEG-DERIV (+ ac r2) (+ ac r2)))
(define ann-K1 '(SEG-PATH (+ ac r1) (+ ac r1))) (define ann-K1D '(SEG-DERIV (+ ac r1) (+ ac r1)))
(define ann-G2 '(CIRCLE-PATH ac r2)) (define ann-D2 '(CIRCLE-DERIV ac r2))
(define ann-G1 '(CIRCLE-PATH ac r1)) (define ann-D1 '(CIRCLE-DERIV ac r1))
(define ann-L '(SEG-PATH (+ ac r2) (+ ac r1))) (define ann-DL '(SEG-DERIV (+ ac r2) (+ ac r1)))
(define ann-band '(FORALL z (IMPLIES (IN z CC) (IMPLIES (<= r1 (magnitude (- z ac))) (IMPLIES (<= (magnitude (- z ac)) r2) (IN z u))))))

;; a real t: land t in RR from (IN t (CCINT lo hi)) and its bounds
(define (ann-ccparts! t lo hi)
  (if (not (dk-asm? (list 'IN t 'RR))) (fact 'ccint-elt-in-rr lo hi t))
  (if (not (and (dk-asm? (list '<= lo t)) (dk-asm? (list '<= t hi))))
      (dk-split-all! (list (dk-cite! 'ccint-parts lo hi t)))))
(define (ann-in-cc! t lo hi . prems)
  (if (not (dk-asm? (list 'IN t (list 'CCINT lo hi))))
      (dk-have! (list 'IN t (list 'CCINT lo hi))
        (lambda () (mac 'ccint-membership) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (apply dk-ineq! prems))))))))
;; the point c + rho e with |e| = 1 and rho in [r1, r2] lies in u
(define (ann-in-band! z rho e)    ; (= z (+ ac (* rho e))) and rho in RR, r1 <= rho <= r2, |e| = 1 in context
  (fact 'rr-subset-cc rho)
  (ann-and! (list 'IN rho 'CC) (list 'IN e 'CC)) (fact 'cc-mul-closed rho e)
  (ann-and! '(IN ac CC) (list 'IN (list '* rho e) 'CC)) (fact 'cc-add-closed 'ac (list '* rho e))
  (if (not (dk-asm? (list 'IN z 'CC)))
      (dk-have! (list 'IN z 'CC) (lambda () (subst (list '= z (list '+ 'ac (list '* rho e)))) (ass))))
  (dk-have! (list '= (list '- z 'ac) (list '* rho e)) (lambda () (subst (list '= z (list '+ 'ac (list '* rho e)))) (crs)))
  (dk-cite! 'cc-magnitude-mul rho e)
  (dk-cite! 'rr-magnitude-is-abs rho)
  (dk-have! (list '<= 0 rho) (lambda () (dk-ineq! (list 'IN rho 'RR) '(< 0 r1) (list '<= 'r1 rho))))
  (dk-cite! 'rr-abs-of-nonneg rho)
  (dk-have! (list '= (list 'magnitude (list '- z 'ac)) rho)
    (lambda ()
      (subst (list '= (list '- z 'ac) (list '* rho e)))
      (subst (list '= (list 'magnitude (list '* rho e)) (list '* (list 'magnitude rho) (list 'magnitude e))))
      (subst (list '= (list 'magnitude e) 1))
      (subst (list '= (list 'magnitude rho) (list 'abs rho)))
      (subst (list '= (list 'abs rho) rho))
      (crs)))
  (fact 'cc-sub-in-cc z 'ac)
  (let ((m (list 'magnitude (list '- z 'ac))))
    (fact 'cc-magnitude-closed (list '- z 'ac))
    (dk-have! (list '<= 'r1 m) (lambda () (dk-ineq! (list 'IN m 'RR) (list 'IN rho 'RR) (list '= m rho) (list '<= 'r1 rho))))
    (dk-have! (list '<= m 'r2) (lambda () (dk-ineq! (list 'IN m 'RR) (list 'IN rho 'RR) (list '= m rho) (list '<= rho 'r2))))
    (dk-apply! (dk-ctx-form ann-band) z)))

;;; (2a) between: x <= y, m in [0, 1] ==> x <= y + m (x - y) <= y
(sp (make-wff "forall([anx_ in rr, any_ in rr, anm_ in rr], anx_ <= any_ implies 0 <= anm_ implies anm_ <= 1 implies
   anx_ <= any_ + anm_ * (anx_ - any_) and any_ + anm_ * (anx_ - any_) <= any_)"))
(dk-peel!)
(fact 'rr-sub-in-rr 'any_ 'anx_) (fact 'rr-sub-in-rr 'anx_ 'any_)
(fact 'rr-one-in) (fact 'rr-zero-in)
(dk-have! '(<= 0 (- any_ anx_)) (lambda () (dk-ineq! '(IN anx_ RR) '(IN any_ RR) '(<= anx_ any_))))
(ann-and! '(<= anm_ 1) '(<= 0 (- any_ anx_)))
(dk-cite! 'rr-mul-le-right 'anm_ 1 '(- any_ anx_))
(ann-and! '(<= 0 anm_) '(<= 0 (- any_ anx_)))
(dk-cite! 'rr-mul-le-right 0 'anm_ '(- any_ anx_))
(fact 'rr-mul-in-rr 'anm_ '(- any_ anx_)) (fact 'rr-mul-in-rr 'anm_ '(- anx_ any_))
(fact 'rr-mul-in-rr 1 '(- any_ anx_)) (fact 'rr-mul-in-rr 0 '(- any_ anx_))
(dk-have! '(= (* anm_ (- anx_ any_)) (- 0 (* anm_ (- any_ anx_)))) (lambda () (crs)))
(dk-have! '(= (* 1 (- any_ anx_)) (- any_ anx_)) (lambda () (crs)))
(dk-have! '(= (* 0 (- any_ anx_)) 0) (lambda () (crs)))
(dk-conj-close!
 (lambda ()
   (dk-ineq! '(IN anx_ RR) '(IN any_ RR) '(IN (* anm_ (- any_ anx_)) RR) '(IN (* anm_ (- anx_ any_)) RR)
             '(IN (* 1 (- any_ anx_)) RR) '(IN (* 0 (- any_ anx_)) RR)
             '(<= (* anm_ (- any_ anx_)) (* 1 (- any_ anx_))) '(<= (* 0 (- any_ anx_)) (* anm_ (- any_ anx_)))
             '(= (* anm_ (- anx_ any_)) (- 0 (* anm_ (- any_ anx_)))) '(= (* 1 (- any_ anx_)) (- any_ anx_)) '(= (* 0 (- any_ anx_)) 0))))
(qed 'lerp-between)

;;; (2b) the product of two numbers of [0, 1] is in [0, 1]
(sp (make-wff "forall([anp_ in rr, anq_ in rr], 0 <= anp_ implies anp_ <= 1 implies 0 <= anq_ implies anq_ <= 1 implies 0 <= anp_ * anq_ and anp_ * anq_ <= 1)"))
(dk-peel!)
(fact 'rr-one-in) (fact 'rr-zero-in)
(ann-and! '(<= anp_ 1) '(<= 0 anq_)) (dk-cite! 'rr-mul-le-right 'anp_ 1 'anq_)
(ann-and! '(<= 0 anp_) '(<= 0 anq_)) (dk-cite! 'rr-mul-le-right 0 'anp_ 'anq_)
(fact 'rr-mul-in-rr 'anp_ 'anq_) (fact 'rr-mul-in-rr 1 'anq_) (fact 'rr-mul-in-rr 0 'anq_)
(dk-have! '(= (* 1 anq_) anq_) (lambda () (crs)))
(dk-have! '(= (* 0 anq_) 0) (lambda () (crs)))
(dk-conj-close!
 (lambda ()
   (dk-ineq! '(IN anq_ RR) '(IN (* anp_ anq_) RR) '(IN (* 1 anq_) RR) '(IN (* 0 anq_) RR)
             '(<= (* anp_ anq_) (* 1 anq_)) '(<= (* 0 anq_) (* anp_ anq_)) '(= (* 1 anq_) anq_) '(= (* 0 anq_) 0) '(<= anq_ 1))))
(qed 'unit-interval-mul)

;;; the terms line-int-concat builds
;; the shapes of line-int-concat: end b + (d - c), argument c + (s - b)
(define (ann-end b1 c2 d2) (list '+ b1 (list '- d2 c2)))
(define (ann-arg c2 s b1) (list '+ c2 (list '- s b1)))
(define (ann-shift P b1 c2 d2) (list 'VNB-LAMBDA 'jxs_ (list 'CCINT b1 (ann-end b1 c2 d2)) (list P (ann-arg c2 'jxs_ b1))))
(define (ann-cat P1 P2 a1 b1 c2 d2) (list 'JUXTA P1 (ann-shift P2 b1 c2 d2) a1 b1 (ann-end b1 c2 d2)))
(define ann-T1 (ann-end 1 0 ann-TP))
(define ann-T (ann-end ann-T1 0 1))
(define ann-J1 (ann-cat ann-K2 ann-G2 0 1 0 ann-TP))  (define ann-J1D (ann-cat ann-K2D ann-D2 0 1 0 ann-TP))
(define ann-J3 (ann-cat ann-L ann-G1 0 1 0 ann-TP))   (define ann-J3D (ann-cat ann-DL ann-D1 0 1 0 ann-TP))
(define ann-P (ann-cat ann-J1 ann-L 0 ann-T1 0 1))    (define ann-PD (ann-cat ann-J1D ann-DL 0 ann-T1 0 1))
(define ann-Q (ann-cat ann-J3 ann-K1 0 ann-T1 0 1))   (define ann-QD (ann-cat ann-J3D ann-K1D 0 ann-T1 0 1))

;;; values of the base paths: (== (P x) v) landed for x in the domain (in context)
(define (ann-seg-val! p q x)      ; SEG-PATH(p, q)(x) == p + x (q - p)
  (let ((v (list '+ p (list '* x (list '- q p)))))
    (dk-have! (list '== (list (list 'SEG-PATH p q) x) v) (lambda () (mac 'SEG-PATH) (dk-lam-b!) (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl)))))
    v))
(define (ann-circ-val! r x)       ; CIRCLE-PATH(ac, r)(x) == ac + r e^{ix}
  (let ((v (list '+ 'ac (list '* r (list 'CC-EXP (list '* '+i x))))))
    (dk-have! (list '== (list (list 'CIRCLE-PATH 'ac r) x) v) (lambda () (mac 'CIRCLE-PATH) (dk-lam-b!) (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl)))))
    v))

;;; generic: prove (= LHS RHS) on a lane by THUNK; land and return it
(define (ann-eq! lhs rhs thunk) (dk-have! (list '= lhs rhs) thunk) (list '= lhs rhs))
;;; value lanes: (== (F t) v) landed; F one of the six pieces, t typed in its domain
(define (ann-K-val! p t) (ann-seg-val! p p t))
;;; the shift lambda applied: (== ((shift P b1 c2 d2) t) (P (- (+ c2 t) b1)))  for t in [b1, T]
(define (ann-shift-val! P b1 c2 d2 t)
  (let ((S (ann-shift P b1 c2 d2)) (v (list P (ann-arg c2 t b1))))
    (dk-have! (list '== (list S t) v) (lambda () (dk-lam-b!) (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl)))))
    v))
;;; a shifted road is a road (road-affine-reparam with slope 1)
(define (ann-shift-road! P D c2 d2 b1)
  (let* ((T (ann-end b1 c2 d2)) (m (list '- c2 b1))
         (SP (ann-shift P b1 c2 d2)) (SD (ann-shift D b1 c2 d2))
         (prem (list (list 'IN b1 'RR) (list 'IN c2 'RR) (list 'IN d2 'RR) (list '< c2 d2))))
    (fact 'rr-sub-in-rr d2 c2) (fact 'rr-add-in-rr b1 (list '- d2 c2)) (fact 'rr-sub-in-rr c2 b1)
    (fact 'rr-one-in) (fact 'rr-zero-lt-one)
    (dk-have! (list '= (list '+ m (list '* 1 b1)) c2) (lambda () (crs)))
    (dk-have! (list '= (list '+ m (list '* 1 T)) d2) (lambda () (crs)))
    (dk-have! (list '< b1 T) (lambda () (apply dk-ineq! prem)))
    (fact 'rr-is-set) (fact 'ccint-subset-rr b1 T) (fact 'subclass-of-set-is-set (list 'CCINT b1 T) 'RR)
    (fact 'is-road-is-path P D c2 d2) (fact 'is-path-in-fun P c2 d2)
    (dk-project! (list 'IN D (list 'FUN (list 'CCINT c2 d2) 'CC)) 'IS-ROAD (list 'IS-ROAD P D c2 d2))
    (define (arg-in! z)            ; z in [b1, T]: (c2 + z) - b1 in [c2, d2]
      (ann-ccparts! z b1 T)
      (let ((x (ann-arg c2 z b1)))
        (fact 'rr-sub-in-rr z b1) (fact 'rr-add-in-rr c2 (list '- z b1))
        (apply ann-in-cc! x c2 d2 (append (list (list 'IN z 'RR) (list '<= b1 z) (list '<= z T)) prem))
        x))
    (for-each (lambda (pr)
                (let ((S (car pr)) (F (cadr pr)))
                  (dk-have! (list 'IN S (list 'FUN (list 'CCINT b1 T) 'CC))
                    (lambda () (dk-lam-type! (lambda () (let* ((z (dk-di-var!)) (x (arg-in! z)))
                                                          (fact 'fun-apply-type-c F (list 'CCINT c2 d2) 'CC x)
                                                          (if (dk--redex? (dk-goal)) (dk-lam-b!)) (ass))))))))
              (list (list SP P) (list SD D)))
    (dk-have! (list 'FORALL 'lrpz_ (list 'IMPLIES (list 'IN 'lrpz_ (list 'CCINT b1 T)) (list '== (list SP 'lrpz_) (list P (list '+ m (list '* 1 'lrpz_))))))
      (lambda () (let* ((z (dk-di-var!)) (x (arg-in! z)))
                   (dk-lam-b!)
                   (dk-have! (list '= (list '+ m (list '* 1 z)) x) (lambda () (crs)))
                   (subst (list '= (list '+ m (list '* 1 z)) x))
                   (qrfl))))
    (dk-have! (list 'FORALL 'lrpz_ (list 'IMPLIES (list 'IN 'lrpz_ (list 'CCINT b1 T)) (list '== (list SD 'lrpz_) (list '* 1 (list D (list '+ m (list '* 1 'lrpz_)))))))
      (lambda () (let* ((z (dk-di-var!)) (x (arg-in! z)))
                   (dk-lam-b!)
                   (fact 'fun-apply-type-c D (list 'CCINT c2 d2) 'CC x)
                   (dk-have! (list '= (list '+ m (list '* 1 z)) x) (lambda () (crs)))
                   (subst (list '= (list '+ m (list '* 1 z)) x))
                   (dk-cite! 'cc-one-mul (list D x))
                   (subst (list '= (list '* 1 (list D x)) (list D x)))
                   (qrfl))))
    (dk-apply! (dk-cite! 'road-affine-reparam c2 d2 b1 T 1 m) P D SP SD)
    (list SP SD)))

(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'FORALL 'ac (list 'IMPLIES '(IN ac CC) (list 'FORALL 'r1 (list 'IMPLIES '(IN r1 RR) (list 'FORALL 'r2 (list 'IMPLIES '(IN r2 RR)
  (list 'IMPLIES '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u) (list 'IMPLIES '(HOLOMORPHIC-ON u f)
    (list 'IMPLIES '(< 0 r1) (list 'IMPLIES '(< r1 r2) (list 'IMPLIES ann-band
      (list '= (list 'LINE-INT 'f ann-G1 ann-D1 0 ann-TP) (list 'LINE-INT 'f ann-G2 ann-D2 0 ann-TP)))))))))))))))))
(dk-peel!)
(fact 'cc-open-subset-cc 'u)
(fact 'holomorphic-on-in-fun 'u 'f)
(fact 'holomorphic-on-continuous 'u 'f)
(dk-split-all! (list (dk-cite! 'pi-pos)))
(fact 'rr-zero-in) (fact 'rr-one-in) (fact 'cc-zero-in) (fact 'cc-one-in)
(fact 'rr-mul-in-rr 2 'PI)
(dk-have! (list '< 0 ann-TP) (lambda () (dk-ineq! '(IN PI RR) '(< 0 PI))))
(fact 'rr-sub-in-rr ann-TP 0) (fact 'rr-add-in-rr 1 (list '- ann-TP 0))
(fact 'rr-sub-in-rr 1 0) (fact 'rr-add-in-rr ann-T1 (list '- 1 0))
(define ann-tprem (list (list 'IN ann-TP 'RR) (list '< 0 ann-TP) (list 'IN ann-T1 'RR) (list 'IN ann-T 'RR)))
(dk-have! (list '< 1 ann-T1) (lambda () (apply dk-ineq! ann-tprem)))
(dk-have! (list '< ann-T1 ann-T) (lambda () (apply dk-ineq! ann-tprem)))
(dk-have! (list '<= ann-T1 ann-T) (lambda () (apply dk-ineq! ann-tprem)))
(dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
(dk-have! (list '<= 0 ann-T1) (lambda () (apply dk-ineq! ann-tprem)))
(fact 'rr-subset-cc 'r1) (fact 'rr-subset-cc 'r2)
(ann-and! '(IN ac CC) '(IN r2 CC)) (fact 'cc-add-closed 'ac 'r2)
(ann-and! '(IN ac CC) '(IN r1 CC)) (fact 'cc-add-closed 'ac 'r1)
(dk-cite! 'rr-magnitude-is-abs 1) (dk-cite! 'rr-abs-of-nonneg 1)
(dk-have! '(= (magnitude 1) 1) (lambda () (subst '(= (magnitude 1) (abs 1))) (subst '(= (abs 1) 1)) (rfl)))
(dk-have! '(<= r1 r2) (lambda () (dk-ineq! '(IN r1 RR) '(IN r2 RR) '(< r1 r2))))
(dk-have! '(<= r2 r2) (lambda () (dk-ineq! '(IN r2 RR))))
(dk-have! '(<= r1 r1) (lambda () (dk-ineq! '(IN r1 RR))))
(dk-have! '(<= 0 r2) (lambda () (dk-ineq! '(IN r1 RR) '(IN r2 RR) '(< 0 r1) '(< r1 r2))))
(dk-have! '(<= 0 r1) (lambda () (dk-ineq! '(IN r1 RR) '(< 0 r1))))
;; the roads
(dk-cite! 'circle-is-road 'ac 'r2) (dk-cite! 'circle-is-road 'ac 'r1)
(dk-cite! 'seg-path-is-road ann-p2 ann-p1) (dk-cite! 'seg-path-is-road ann-p2 ann-p2) (dk-cite! 'seg-path-is-road ann-p1 ann-p1)
(for-each (lambda (pd) (fact 'is-road-is-path (car pd) (cadr pd) 0 (caddr pd)) (fact 'is-path-in-fun (car pd) 0 (caddr pd)))
          (list (list ann-G2 ann-D2 ann-TP) (list ann-G1 ann-D1 ann-TP) (list ann-L ann-DL 1) (list ann-K2 ann-K2D 1) (list ann-K1 ann-K1D 1)))
(for-each (lambda (x) (ann-in-cc! x 0 1 '(<= 0 1)) (ann-in-cc! x 0 ann-TP (list '< 0 ann-TP))) '(0))
(ann-in-cc! 1 0 1 '(<= 0 1))
(ann-in-cc! ann-TP 0 ann-TP (list '< 0 ann-TP))
;; the values at the ends: K2(t) = p2, L(0) = p2, L(1) = p1, K1(t) = p1, G(0) = G(2 pi) = ac + r
(define (ann-circ0! r)            ; (= (G 0) (+ ac r)) and (= (G TP) (+ ac r))
  (let* ((G (list 'CIRCLE-PATH 'ac r)) (v (ann-circ-val! r 0)))
    (dk-have! (list '= (list G 0) (list '+ 'ac r))
      (lambda ()
        (subst (list '== (list G 0) v))
        (dk-have! '(= (* +i 0) 0) (lambda () (crs)))
        (subst '(= (* +i 0) 0))
        (fact 'cc-exp-zero)
        (subst '(= (CC-EXP 0) 1))
        (crs)))
    (dk-cite! 'circle-path-closed 'ac r)
    (dk-have! (list '= (list G ann-TP) (list '+ 'ac r))
      (lambda () (subst (list '= (list G ann-TP) (list G 0))) (ass)))))
(ann-circ0! 'r2) (ann-circ0! 'r1)
(define (ann-segv! p q x)          ; (= (SEG-PATH p q)(x) value) for a numeral end x in {0, 1}
  (let* ((S (list 'SEG-PATH p q)) (v (ann-seg-val! p q x)) (w (if (eqv? x 0) p q)))
    (dk-have! (list '= (list S x) w) (lambda () (subst (list '== (list S x) v)) (crs)))))
(ann-segv! ann-p2 ann-p1 0) (ann-segv! ann-p2 ann-p1 1)
(ann-segv! ann-p2 ann-p2 0) (ann-segv! ann-p2 ann-p2 1)
(ann-segv! ann-p1 ann-p1 0) (ann-segv! ann-p1 ann-p1 1)
;; ---- value forms c + rho e of the pieces
(define (ann-v-K! p r t)          ; t in [0, 1]: (= (K t) (+ ac (* r 1)))
  (let* ((K (list 'SEG-PATH p p)) (v (ann-seg-val! p p t)) (w (list '+ 'ac (list '* r 1))))
    (ann-ccparts! t 0 1) (fact 'rr-subset-cc t)
    (dk-have! (list '= (list K t) w) (lambda () (subst (list '== (list K t) v)) (crs)))
    (list r 1)))
(define (ann-v-G! r x)            ; x in [0, TP]: (= (G x) (+ ac (* r E))), |E| = 1
  (let* ((G (list 'CIRCLE-PATH 'ac r)) (v (ann-circ-val! r x)) (E (list 'CC-EXP (list '* '+i x))))
    (ann-ccparts! x 0 ann-TP)
    (dk-cite! 'cc-exp-magnitude-imaginary x)
    (fact 'cc-i-in) (fact 'rr-subset-cc x)
