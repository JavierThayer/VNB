;;; RECIP-GAMMA does not vanish on the right half-plane
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

;;; ---- helper defines COPIED 2026-10-30 (wave-2 integration) from ch3g/ch3g-gamma.scm, ch6/ch6-fun.scm, ch6/ch6-g629.scm, ch6/ch6-prod.scm, ch6/ch6-quot.scm, ch6/ch6-weier.scm:
;;; the probe loaded this chain in ONE environment; load.scm gives each file its own.
(define gx-OM '(SEP gdz_ CC (FORALL gdn_ (IMPLIES (IN gdn_ NN) (NOT (= (+ gdz_ gdn_) 0))))))
(define (gx-om-mem! z)                       ; z in OMEGA in context: z in CC and the universal (z + n /= 0)
  (let ((m (list 'IN z gx-OM)))
    (dk-project! (list 'IN z 'CC) (lambda () (sep-me (dk-ctx-form m))))
    (dk-project! (list 'FORALL 'gdn_ (list 'IMPLIES '(IN gdn_ NN) (list 'NOT (list '= (list '+ z 'gdn_) 0))))
                 (lambda () (sep-me (dk-ctx-form m))))))
(define (c6-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (c6-nn! n) (fact 'nn-in-rr n) (fact 'rr-subset-cc n))
(define (c6-steps!)                          ; peel FORALL / IMPLIES; return the landed formulas
  (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
(define (c6-chain-end f) (if (c6-op? f 'IMPLIES 3) (c6-chain-end (caddr f)) f))
(define (c6-cite! . args)                     ; dk-cite! that refuses to return an undetached implication link
  (let ((r (apply dk-cite! args)))
    (cond ((not (c6-op? r 'IMPLIES 3)) r)
          ((dk-asm? (c6-chain-end r)) (dk-ctx-form (c6-chain-end r)))     ; the consequent was already in context
          (#t (error "c6-cite!: the chain stopped at an antecedent not in context" (car args) (expression->string (cadr r)))))))
(define (c6f-rfl-close!) (dk-close-if! (lambda () #t) (lambda () (rfl))))
(define (c6w-cc-setup!) (fact 'cc-is-set) (fact 'cc-one-in) (fact 'cc-zero-in) (fact 'nn-zero-in) (fact 'rr-zero-in) (fact 'rr-one-in))
(define (c6q-recip-nz! t)                          ; t in CC, t /= 0, t recip(t) = 1 in context: recip(t) /= 0
  (let ((r (list 'NOT (list '= (list 'recip t) 0))))
    (if (not (dk-asm? r))
        (dk-have! r (lambda () (di) (dk-have! '(= 1 0) (lambda () (subst (list '= 1 (list '* t (list 'recip t)))) (subst (list '= (list 'recip t) 0)) (crs))) (dk-absurd! '(= 1 0)))))
    r))
(define (c6t-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (c6t-and! a b)
  (let* ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (c6t-rr! t)
  (let* ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((eq? t 'PI) (c6t-cite-split! 'pi-pos) typ)
          ((number? t) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((c6t-op? t 'succ 2) (c6t-nn! t) (fact 'nn-in-rr t) typ)
          ((c6t-op? t '* 3) (c6t-rr! (cadr t)) (c6t-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((c6t-op? t '+ 3) (c6t-rr! (cadr t)) (c6t-rr! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((c6t-op? t '- 3) (c6t-rr! (cadr t)) (c6t-rr! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((c6t-op? t '- 2) (c6t-rr! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((c6t-op? t 'magnitude 2) (c6t-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((c6t-op? t 'real-part 2) (c6t-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((c6t-op? t 'imag-part 2) (c6t-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((c6t-op? t 'abs 2) (c6t-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((c6t-op? t 'LOG 2) (fact 'log-in-rr (cadr t)) typ)
          ((and (c6t-op? t 'CC-EXP 2) (or (dk-asm? (list 'IN (cadr t) 'RR)) (begin (c6t-rr! (cadr t)) #t)))
           (c6t-cite-split! 'cc-exp-real (cadr t)) typ)
          ((c6t-op? t 'recip 2)
           (c6t-rr! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (if (dk-asm? (list '< 0 (cadr t)))
                   (fact 'rr-pos-ne-zero (cadr t))
                   (error "c6t-rr!: land the non-vanishing first" (expression->string (cadr t)))))
           (c6t-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t))
           typ)
          (#t (dk-real! t) typ))))
(define (c6t-nn! t)
  (let* ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((c6t-op? t 'succ 2) (c6t-nn! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          (#t (dk-type! t 'NN)))))
(define (c6t-cc! t)
  (let* ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((or (and (number? t) (real? t)) (eq? t 'PI) (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
               (c6t-op? t 'succ 2)
               (c6t-op? t 'magnitude 2) (c6t-op? t 'real-part 2) (c6t-op? t 'imag-part 2) (c6t-op? t 'LOG 2))
           (c6t-rr! t) (fact 'rr-subset-cc t) typ)
          ((c6t-op? t '- 3) (c6t-cc! (cadr t)) (c6t-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((c6t-op? t '- 2) (c6t-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((c6t-op? t '+ 3) (c6t-cc! (cadr t)) (c6t-cc! (caddr t))
           (c6t-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((c6t-op? t '* 3) (c6t-cc! (cadr t)) (c6t-cc! (caddr t))
           (c6t-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((c6t-op? t 'power 3) (c6t-cc! (cadr t)) (c6t-nn! (caddr t))
           (c6t-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((c6t-op? t 'CC-EXP 2) (c6t-cc! (cadr t))
           (c6t-cite-split! 'cc-exp-converges (cadr t)) typ)
          ((c6t-op? t 'recip 2) (c6t-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "c6t-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (c6t-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (dk-type! t 'CC)))))
(define (c6t-conjs f) (if (dk-head-is? f 'AND) (append (c6t-conjs (cadr f)) (c6t-conjs (caddr f))) (list f)))
(define (c6t-cite-split! . args)
  (let ((c (apply dk-cite! args)))
    (if (and (dk-head-is? c 'AND) (not (every dk-asm? (c6t-conjs c))))
        (dk-split-all! (list c)))
    c))
(define (c6t-re-im-real! x)
  (let* ((e1 (list '= (list 'real-part x) x))
         (e2 (list '= (list 'imag-part x) 0)))
    (if (not (and (dk-asm? e1) (dk-asm? e2)))
        (begin
          (c6t-rr! x) (c6t-cc! x) (fact 'rr-zero-in)
          (c6t-cc! (list '+ x (list '* 0 +i)))
          (dk-have! (list '= x (list '+ x (list '* 0 +i))) (lambda () (crs)))
          (dk-split-all! (list (dk-cite! 'cc-re-im-of x x 0)))))
    e1))
;;; ---- end of copied helpers ----

(sp (make-wff '(FORALL c6sw_ (IMPLIES (IN c6sw_ CC) (IMPLIES (< 0 (real-part c6sw_)) (NOT (= (RECIP-GAMMA c6sw_) 0)))))))
(let* ((new (c6-steps!)) (w 'c6sw_) (s '(real-part c6sw_)))
  (c6w-cc-setup!) (c6t-rr! s)
  (dk-split-all! (list (c6-cite! 'proposition-6-28)))
  (let ((nzs (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q '(RECIP-GAMMA egw_)))) (dk-asms))))
    (dk-have! '(FORALL egn_ (IMPLIES (IN egn_ NN) (NOT (= c6sw_ (- egn_)))))
      (lambda () (let ((n (dk-di-var!)))
                   (c6-nn! n) (fact 'nn-zero-le n) (c6t-rr! (list '- n)) (c6t-re-im-real! (list '- n)) (c6t-rr! (list 'real-part (list '- n)))
                   (di)
                   (dk-have! (list '= (list 'real-part w) (list 'real-part (list '- n))) (lambda () (subst (list '= w (list '- n))) (c6f-rfl-close!)))
                   (dk-absurd! (list '< 0 s) (list '= s (list 'real-part (list '- n))) (list '= (list 'real-part (list '- n)) (list '- n)) (list '<= 0 n)))))
    (dk-apply! nzs w)
    (dk-close-if! (lambda () #t) (lambda () (dk-ass!)))))
(qed 'recip-gamma-nonzero-rhp)

;;; COROLLARY 3.61: GAMMA-EXT(z) /= 0 for every z off the non-positive integers
(sp (make-wff (list 'FORALL 'c6sz_ (list 'IMPLIES (list 'IN 'c6sz_ gx-OM) '(NOT (= (GAMMA-EXT c6sz_) 0))))))
(let* ((new (c6-steps!)) (z 'c6sz_) (s '(real-part c6sz_)))
  (c6w-cc-setup!) (gx-om-mem! z) (c6t-rr! s) (c6t-rr! (list '- s))
  (let* ((n (dk-skolem! (c6-cite! 'nn-unbounded-in-rr (list '- s)) #t))
         (zn (list '+ z n)) (rg (list 'RECIP-GAMMA zn)) (gm (list 'GAMMA-FUNCTION zn)) (pc (list 'POCH z n)))
    (c6-nn! n) (c6t-rr! (list '- s))
    (dk-have! (list '< 0 (list '+ s n)) (lambda () (dk-ineq! (list '< (list '- s) n))))
    (c6t-cc! zn) (c6t-re-im-real! n) (c6t-and! (list 'IN z 'CC) (list 'IN n 'CC)) (fact 'cc-re-add z n)
    (c6t-rr! (list 'real-part zn)) (c6t-rr! (list 'real-part n))
    (dk-have! (list '< 0 (list 'real-part zn))
      (lambda () (dk-ineq! (list '= (list 'real-part zn) (list '+ s (list 'real-part n))) (list '= (list 'real-part n) n) (list '< 0 (list '+ s n)))))
    (subst (c6-cite! 'gamma-ext-value n z))
    (subst (c6-cite! 'proposition-6-29 zn))
    (c6-cite! 'recip-gamma-nonzero-rhp zn)
    (dk-split-all! (list (c6-cite! 'proposition-6-28)))
    (dk-cite! 'holomorphic-on-in-fun 'CC 'RECIP-GAMMA)
    (fact 'fun-apply-type-c 'RECIP-GAMMA 'CC 'CC zn)
    (c6t-and! (list 'IN rg 'CC) (list 'NOT (list '= rg 0))) (fact 'cc-recip-closed rg) (fact 'cc-recip-inverse rg)
    (c6-cite! 'poch-nonzero n z) (c6-cite! 'poch-in-cc n z)
    (c6t-and! (list 'IN pc 'CC) (list 'NOT (list '= pc 0))) (fact 'cc-recip-closed pc) (fact 'cc-recip-inverse pc)
    (c6q-recip-nz! rg) (c6q-recip-nz! pc)
    (c6-cite! 'cc-mul-nonzero (list 'recip rg) (list 'recip pc))
    (dk-close-if! (lambda () #t) (lambda () (dk-ass!)))))
(qed 'corollary-3-61)

  
