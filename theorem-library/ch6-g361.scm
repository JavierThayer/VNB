;;; ch6-g361.scm -- CH6-B: Corollary 3.61, the Gamma function has no zeros, for CH3-G's continuation GAMMA-EXT
;;; (scratchpad/ch3g/ch3g-gamma.scm, loaded before this file with its dependencies).  Loads after ch6-g629.
;;; Prefix c6s-.  Library: complex-analysis.
