                                      (c6-at! opv opa sj) (dk-lam-b!) (subst (list '= (list opv sj) (list '+ 1 (list a sj)))) (rfl))))
                       (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ kv) (list '= (list mkv 'c6j_) (list mf 'c6j_)))))
                         (lambda ()
