;;; PROPOSITION 6.12.  If prod (1 + f_k) is normally convergent on compact subsets of u, its value
;;; x |-> prod_k (1 + f_k(x)) is a function on u, and the partial products converge to it uniformly on
;;; compact subsets of u.
(define (c6-ppf u f) (list 'VNB-LAMBDA 'c6n_ 'NN (list 'VNB-LAMBDA 'c6x_ u (list 'PPROD (c6-opx f 'c6x_) 'c6n_))))
(sp (make-wff (list 'FORALL 'c6u_ (list 'IMPLIES '(IS-OPEN CC-MS c6u_) (list 'FORALL 'c6f_ (list 'IMPLIES (c6-famty 'c6u_ 'c6f_)
  (list 'IMPLIES '(PROD-NORMAL-ON-COMPACTA c6u_ c6f_)
    (list 'AND '(IN (PROD-FUN c6u_ c6f_) (FUN c6u_ CC))
               (list 'UNIF-ON-COMPACTA 'c6u_ (c6-ppf 'c6u_ 'c6f_) '(PROD-FUN c6u_ c6f_))))))))))
(let* ((new (c6-steps!)) (u (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) new)))
       (f (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (c6-op? (caddr q) 'FUN 3) (eq? (cadr (caddr q)) 'NN))) new)))
       (pf (list 'PROD-FUN u f)) (pp (c6-ppf u f))
       (val! (lambda (z)                         ; z in u: PROD-FUN(u, f)(z) = PROD-VALUE(1 + f(z)), in CC
               (let* ((ox (c6-opx f z)))
                 (c6-lam-typ! ox 'CC (lambda (k) (c6-fv! f u k z) (fact 'cc-one-in) (c6-cc! (list '+ 1 (list (list f k) z)))))
                 (dk-split-all! (list (c6-cite! 'prop-6-11 u f z)))
                 (dk-split-all! (list (c6-cite! 'prod-value-spec ox)))))))
  (c6-cite! 'cc-ms-open-iff u)
  (dk-have! (list 'IS-OPEN '(NF-METRIC-SPACE CC-NORMED-FIELD) u) (lambda () (mac 'cc-ms-open-iff) (dk-ass!)))
  (fact 'cc-is-metric-space) (c6-pts!) (fact 'cc-is-set)
  (dk-have! (list 'SUBSET u 'CC) (lambda () (c6-cite! 'cc-open-subset-cc u) (dk-ass!)))
  (fact 'subclass-of-set-is-set u 'CC)
  (dk-have! (list 'IN pf (list 'FUN u 'CC))
    (lambda () (mac 'PROD-FUN)
               (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (val! z) (dk-ass!))) (lambda () (dk-ass!)))))
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (dk-ass!)
        (let* ((iff (dk-cite! 'cc-exhaust-uniform-iff-compacta u pp pf)) (lhs (cadr iff)))
         (dk-have! lhs (lambda ()
          (let* ((n (dk-di-var!)) (nn (c6-steps!)) (eps (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) nn)))
                 (est (dk-apply! (c6-cite! 'prop-6-12-estimate u f) n eps))
                 (cap (c6-sk! est))
                 (eu (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q cap) (dk-contains? q 'PROD-VALUE))) (dk-asms))))
            (ew cap)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (dk-ass!)
                  (let* ((nk (c6-steps!)) (k (find-first (lambda (v) (not (eq? v n))) (c6-vars nk 'NN)))
                         (z (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (c6-op? (caddr q) 'CC-EXHAUST 3))) nk))))
                    (fact 'subset-mem-fwd (list 'CC-EXHAUST u n) u z) (c6-cite! 'cc-exhaust-subset u n)
                    (fact 'subset-mem-fwd (list 'CC-EXHAUST u n) u z)
                    (val! z)
                    (fact 'fun-apply-type-c pp 'NN (list 'FUN u 'CC) k)
                    (mac 'PROD-FUN)
                    (dk-lam-b!)
                    (dk-apply! eu k z)
                    (dk-ass!))))))))
         (keep iff lhs) (prop))))))
(qed 'prop-6-12)

;;; typing of a lambda over u: (IN lam (FUN u CC))
(define (c6-lam-typ-on! lam u typer f)
  (let ((typ (list 'IN lam (list 'FUN u 'CC))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                           (c6-lam-typ! (c6-opx f x) 'CC (lambda (k) (c6-fv! f u k x) (fact 'cc-one-in) (c6-cc! (list '+ 1 (list (list f k) x)))))
                           (typer x) (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
              (lambda () (dk-ass!))))))
    typ))
;;; ---------------------------------------------------------------- holomorphic factors (for 6.13)
(define c6-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (c6-famhol u f) (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list 'HOLOMORPHIC-ON u (list f 'c6i_)))))
(define (c6-ppx u f n) (list 'VNB-LAMBDA 'c6x_ u (list 'PPROD (c6-opx f 'c6x_) n)))     ; x |-> prod_{k<n} (1 + f_k(x))

;;; the partial products of holomorphic factors are holomorphic
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6u_ (list 'IMPLIES (list 'IS-OPEN c6-nfm 'c6u_)
  (list 'FORALL 'c6f_ (list 'IMPLIES (c6-famty 'c6u_ 'c6f_) (list 'IMPLIES (c6-famhol 'c6u_ 'c6f_)
    (list 'HOLOMORPHIC-ON 'c6u_ (c6-ppx 'c6u_ 'c6f_ 'c6n_)))))))))))
(define (c6-setu! u)
  (fact 'cc-is-set) (c6-cite! 'cc-open-subset-cc u) (fact 'subclass-of-set-is-set u 'CC))
(dk-ni-fixed! '(c6u_ c6f_))   ; W1G-B: c6u_, c6f_ fixed
(c6-induct!
  (lambda ()
    (let* ((new '()) (u (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) (dk-asms))))   ; W1G-B: u, f hoisted; the base goal is the HOLOMORPHIC-ON atom, nothing to peel
           (f (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (c6-op? (caddr q) 'FUN 3) (eq? (cadr (caddr q)) 'NN))) (dk-asms))))   ; W1G-B: u, f hoisted
           (g1 (list 'VNB-LAMBDA 'c6x_ u 1)) (pp (c6-ppx u f 0)))
      (c6-setu! u) (fact 'cc-one-in) (fact 'nn-zero-in)
      (dk-have! (list 'HOLOMORPHIC-ON u g1) (lambda () (dk-holomorphic! u g1)))
      (c6-lam-typ-on! pp u (lambda (x) (dk-cite! 'pprod-in-cc 0 (c6-opx f x)) (dk-ass!)) f)
      (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ u) (list '== (list pp 'hbx_) (list g1 'hbx_))))
        (lambda () (let ((x (dk-di-var!))) (dk-lam-b!) (dk-cite! 'pprod-zero (c6-opx f x)) (dk-ass!))))
      (c6-cite! 'holomorphic-transfer-ptwise-eq u pp g1)
      (dk-ass!)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (u (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) (dk-asms))))   ; W1G-B: u, f hoisted
           (f (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (c6-op? (caddr q) 'FUN 3) (eq? (cadr (caddr q)) 'NN))) (dk-asms))))   ; W1G-B: u, f hoisted
           (ih (find-first (lambda (q) (and (c6-op? q 'HOLOMORPHIC-ON 3) (dk-contains? q 'PPROD))) new))   ; W1G-B: the IH is HOLOMORPHIC-ON(u, ppx(n))
           (fh (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'HOLOMORPHIC-ON) (not (dk-contains? q 'PPROD)))) (dk-asms)))   ; W1G-B: u, f hoisted
           (p0 (c6-ppx u f n)) (p1 (c6-ppx u f (list 'succ n))))
      (c6-setu! u) (fact 'cc-one-in) (fact 'nn-succ-closed n)
      (let* ((hp ih) (hf (dk-apply! fh n)))
        (dk-project! (list 'IN p0 (list 'FUN u 'CC)) 'HOLOMORPHIC-ON hp)
        (fact 'fun-apply-type-c f 'NN (list 'FUN u 'CC) n)
        (let* ((pv (dk-name! p0 (list 'FUN u 'CC))) (gv (dk-name! (list f n) (list 'FUN u 'CC)))
               (tg (list 'VNB-LAMBDA 'c6x_ u (list '* (list pv 'c6x_) (list '+ 1 (list gv 'c6x_))))))
          (dk-rewrite-h! hp p0 pv) (dk-rewrite-h! hf (list f n) gv)
          (dk-have! (list 'FORALL 'dkdoy_ (list 'IMPLIES (list 'IN 'dkdoy_ u) (list 'IN 'dkdoy_ u))) (lambda () (dk-di-var!) (dk-ass!)))
          (dk-have! (list 'HOLOMORPHIC-ON u tg) (lambda () (dk-holomorphic! u tg)))
          (c6-lam-typ-on! p1 u (lambda (x) (dk-cite! 'pprod-in-cc (list 'succ n) (c6-opx f x)) (dk-ass!)) f)
          (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ u) (list '== (list p1 'hbx_) (list tg 'hbx_))))
            (lambda ()
              (let* ((x (dk-di-var!)) (ox (c6-opx f x)))
                (c6-fv! f u n x)
                (c6-lam-typ! ox 'CC (lambda (k) (c6-fv! f u k x) (c6-cc! (list '+ 1 (list (list f k) x)))))
                (dk-lam-b!)
                (subst (list '= pv p0)) (subst (list '= gv (list f n)))
                (dk-lam-b!)
                (subst (dk-cite! 'pprod-succ ox n))
                (dk-lam-b!)
                (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
          (c6-cite! 'holomorphic-transfer-ptwise-eq u p1 tg)
          (dk-ass!))))))
(qed 'ppx-holomorphic)

;;; the product of holomorphic factors, normally convergent on compacta, is holomorphic (6.12 + 5.22's limit theorem)
(sp (make-wff (list 'FORALL 'c6u_ (list 'IMPLIES '(IS-OPEN CC-MS c6u_) (list 'FORALL 'c6f_ (list 'IMPLIES (c6-famty 'c6u_ 'c6f_)
  (list 'IMPLIES (c6-famhol 'c6u_ 'c6f_) (list 'IMPLIES '(PROD-NORMAL-ON-COMPACTA c6u_ c6f_)
    '(HOLOMORPHIC-ON c6u_ (PROD-FUN c6u_ c6f_))))))))))
(let* ((new (c6-steps!)) (u (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) new)))
       (f (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (c6-op? (caddr q) 'FUN 3) (eq? (cadr (caddr q)) 'NN))) new)))
       (pp (c6-ppf u f)))
  (c6-cite! 'cc-ms-open-iff u)
  (dk-have! (list 'IS-OPEN c6-nfm u) (lambda () (mac 'cc-ms-open-iff) (dk-ass!)))
  (dk-split-all! (list (c6-cite! 'prop-6-12 u f)))
  (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'HOLOMORPHIC-ON u (list pp 'k))))
    (lambda () (let* ((k (dk-di-var!)) (px (c6-ppx u f k)))
                 (c6-setu! u)
                 (c6-lam-typ-on! px u (lambda (x) (dk-cite! 'pprod-in-cc k (c6-opx f x)) (dk-ass!)) f)
                 (fact 'membership-implies-sethood px (list 'FUN u 'CC))
                 (dk-lam-b!) (c6-cite! 'ppx-holomorphic k u f) (dk-ass!))))
  (c6-cite! 'holomorphic-limit-on-compacta u pp (list 'PROD-FUN u f))
  (dk-ass!))
(qed 'prod-fun-holomorphic)

;;; ---------------------------------------------------------------- 6.13
(define (c6-za-neg u g c)
  (list 'FORSOME 'c6r_ (list 'AND '(POS-RR c6r_)
    (list 'FORALL 'c6w_ (list 'IMPLIES (list 'IN 'c6w_ u) (list 'IMPLIES (list 'IN 'c6w_ (list 'BALL 'CC-MS c 'c6r_))
      (list 'IMPLIES (list 'NOT (list '= 'c6w_ c)) (list 'NOT (list '= (list g 'c6w_) 0)))))))))
;;; zeros that do not accumulate at c leave a punctured ball about c free of zeros
(sp (make-wff (list 'FORALL 'c6u_ (list 'FORALL 'c6g_ (list 'FORALL 'c6c_
  (list 'IMPLIES '(NOT (ZEROS-ACCUMULATE-AT c6u_ c6g_ c6c_)) (c6-za-neg 'c6u_ 'c6g_ 'c6c_)))))))
(let* ((new (c6-steps!)) (nz (find-first (lambda (q) (dk-head-is? q 'NOT)) new)) (za (cadr nz))
       (u (cadr za)) (g (caddr za)) (c (cadddr za)) (gl (c6-za-neg u g c)))
  (use-em gl
    (lambda () (dk-ass!))
    (lambda ()
      (dk-have! za
        (lambda ()
          (mac 'ZEROS-ACCUMULATE-AT)
          (let* ((nr (c6-steps!)) (r (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) nr))) (ex (dk-goal)))
            (use-em ex
              (lambda () (dk-ass!))
              (lambda ()
                (dk-have! gl
                  (lambda ()
                    (ew r)
                    (dk-conj-close!
                      (lambda ()
                        (if (dk-asm? (dk-goal)) (dk-ass!)
                          (let* ((nw (c6-steps!)) (w (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) u))) nw))))
                            (di)
                            (dk-have! ex (lambda () (ew w) (dk-conj-close! (lambda () (dk-ass!)))))
                            (ai (list 'NOT ex))))))))
                (ai (list 'NOT gl)))))))
      (ai nz))))
(qed 'zeros-not-accumulating)

(define (c6-gk u f k) (list 'VNB-LAMBDA 'c6x_ u (list '+ 1 (list (list f k) 'c6x_))))   ; x |-> 1 + f_k(x)
(define (c6-gk-hol! u f k)                      ; u open (NF), famty, famhol in context: HOLOMORPHIC-ON u (1 + f_k)
  (let ((goal (list 'HOLOMORPHIC-ON u (c6-gk u f k))))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (let* ((hf (dk-apply! (dk-ctx-form (c6-famhol u f)) k)))
              (c6-setu! u) (fact 'cc-one-in)
              (fact 'fun-apply-type-c f 'NN (list 'FUN u 'CC) k)
              (let* ((gv (dk-name! (list f k) (list 'FUN u 'CC))) (tg (list 'VNB-LAMBDA 'c6x_ u (list '+ 1 (list gv 'c6x_)))))
                (dk-rewrite-h! hf (list f k) gv)
                (dk-have! (list 'FORALL 'dkdoy_ (list 'IMPLIES (list 'IN 'dkdoy_ u) (list 'IN 'dkdoy_ u))) (lambda () (dk-di-var!) (dk-ass!)))
                (dk-have! (list 'HOLOMORPHIC-ON u tg) (lambda () (dk-holomorphic! u tg)))
                (dk-have! (list 'IN (c6-gk u f k) (list 'FUN u 'CC))
                  (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (c6-fv! f u k x) (c6-cc! (list '+ 1 (list (list f k) x)))))
                                           (lambda () (dk-ass!)))))
                (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ u) (list '== (list (c6-gk u f k) 'hbx_) (list tg 'hbx_))))
                  (lambda () (let ((x (dk-di-var!))) (c6-fv! f u k x) (dk-lam-b!) (subst (list '= gv (list f k))) (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
                (c6-cite! 'holomorphic-transfer-ptwise-eq u (c6-gk u f k) tg)
                (dk-ass!))))))
    goal))

(define (c6-zcov u f c r nv)
  (list 'FORALL 'c6x_ (list 'IMPLIES (list 'IN 'c6x_ (list 'BALL 'CC-MS c r))
    (list 'FORSOME 'c6q_ (list 'AND '(IN c6q_ NN) (list 'AND (list '< 'c6q_ nv) (list '= (list '+ 1 (list (list f 'c6q_) 'c6x_)) 0)))))))
(define (c6-allz u f k) (list 'FORALL 'c6z_ (list 'IMPLIES (list 'IN 'c6z_ u) (list '= (list '+ 1 (list (list f k) 'c6z_)) 0))))
(define (c6-zconc u f nv) (list 'FORSOME 'c6q_ (list 'AND '(IN c6q_ NN) (list 'AND (list '< 'c6q_ nv) (c6-allz u f 'c6q_)))))
(define (c6-ball-iff! c r w)
  (let ((ff (list 'IFF (list 'IN w (list 'BALL 'CC-MS c r)) (list 'AND (list 'IN w 'CC) (list '< (list 'magnitude (list '- w c)) r)))))
    (if (not (dk-asm? ff)) (fact 'cc-ms-ball-membership c r w))
    (or (dk-ctx-form ff) (error "c6-ball-iff!: did not land" (expression->string ff)))))
(define (c6-ball-parts! w c r)                 ; w in BALL(c, r): w in CC, |w - c| < r
  (let* ((iff (c6-ball-iff! c r w)) (mem (list 'IN w (list 'BALL 'CC-MS c r))) (lt (list '< (list 'magnitude (list '- w c)) r)))
    (if (not (dk-asm? (list 'IN w 'CC))) (dk-have! (list 'IN w 'CC) (lambda () (keep iff mem) (prop))))
    (if (not (dk-asm? lt)) (dk-have! lt (lambda () (keep iff mem) (prop))))
    (fact 'cc-sub-in-cc w c) (fact 'cc-magnitude-closed (list '- w c))
    lt))

;;; finitely many holomorphic factors whose zeros cover a ball: one factor vanishes on the connected u
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6u_ (list 'IMPLIES (list 'IS-OPEN c6-nfm 'c6u_)
  (list 'IMPLIES '(IS-CONNECTED CC-MS c6u_) (list 'FORALL 'c6f_ (list 'IMPLIES (c6-famty 'c6u_ 'c6f_) (list 'IMPLIES (c6-famhol 'c6u_ 'c6f_)
    (list 'FORALL 'c6c_ (list 'IMPLIES '(IN c6c_ c6u_) (list 'FORALL 'c6r_ (list 'IMPLIES '(POS-RR c6r_)
      (list 'IMPLIES '(SUBSET (BALL CC-MS c6c_ c6r_) c6u_) (list 'IMPLIES (c6-zcov 'c6u_ 'c6f_ 'c6c_ 'c6r_ 'c6n_)
        (c6-zconc 'c6u_ 'c6f_ 'c6n_)))))))))))))))))
(dk-ni-fixed! '(c6u_ c6f_))   ; W1G-B: c6u_, c6f_ fixed; c6c_ and c6r_ vary
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (u (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) (dk-asms))))   ; W1G-B: u, f hoisted
           (c (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) u))) new)))
           (r (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) new)))
           (zc (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'BALL))) new)))
      (c6-setu! u) (fact 'subset-mem-fwd u 'CC c) (fact 'rr-pos-rr-in-rr r) (fact 'rr-lt-of-pos-rr r)
      (c6-cite! 'cc-ms-ball-centre c r)
      (let ((k (c6-sk! (dk-apply! zc c)))) (c6-nn! k) (fact 'nn-zero-le k) (dk-absurd! (list '< k 0) (list '<= 0 k)))))
  (lambda ()
    (let* ((new (c6-steps!)) (nn (c6-succ-var new)) (u (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) (dk-asms))))   ; W1G-B: u, f hoisted
           (f (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (c6-op? (caddr q) 'FUN 3) (eq? (cadr (caddr q)) 'NN))) (dk-asms))))   ; W1G-B: u, f hoisted
           (c (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) u))) new)))
           (r (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) new)))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'POS-RR))) new))   ; W1G-B: the IH is forall c. .. forall r. POS-RR(r) => ..
           (zc (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'BALL) (not (dk-contains? q 'POS-RR)))) new))
           (gn (c6-gk u f nn)) (az (c6-allz u f nn)) (n1 (list 'succ nn)))
      (c6-setu! u) (fact 'subset-mem-fwd u 'CC c) (fact 'rr-pos-rr-in-rr r) (fact 'rr-lt-of-pos-rr r) (c6-nn! nn) (c6-lt-succ-n! nn)
      (fact 'nn-succ-closed nn)
      (use-em az
        (lambda () (ew nn) (dk-conj-close! (lambda () (dk-ass!))))
        (lambda ()
          (c6-gk-hol! u f nn)
          (dk-have! (list 'NOT (list 'ZEROS-ACCUMULATE-AT u gn c))
            (lambda ()
              (di)
              (dk-have! az
                (lambda ()
                  (let ((z (cadr (car (c6-steps!)))))
                    (c6-fv! f u nn z)
                    (let ((all (c6-cite! 'holomorphic-identity-principle u gn c)))
                      (dk-apply! all z)
                      (dk-lam-b-h! (list '= (list gn z) 0))
                      (dk-ass!)))))
              (ai (list 'NOT az))))
          (let* ((r1 (c6-sk! (c6-cite! 'zeros-not-accumulating u gn c)))
                 (zf (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q r1) (dk-contains? q 'BALL))) (dk-asms))))
            (fact 'rr-pos-rr-in-rr r1) (fact 'rr-lt-of-pos-rr r1)
            (let ((go!
                    (lambda (r2)                 ; r2 <= r, r2 <= r1, 0 < r2
                      (let* ((r2p (c6-cite! 'rr-pos-rr-of-lt r2))
                             (d (dk-halve! r2)) (e (dk-halve! d)) (c2 (list '+ c d)) (b2 (list 'BALL 'CC-MS c2 e)))
                        (fact 'rr-pos-rr-in-rr d) (fact 'rr-lt-of-pos-rr d) (fact 'rr-pos-rr-in-rr e) (fact 'rr-lt-of-pos-rr e)
                        (fact 'rr-subset-cc d) (c6-cc! c2)
                        (let* ((cc2 (list '- c2 c)))
                          (c6-cc! cc2)
                          (dk-have! (list '= cc2 d) (lambda () (crs)))
                          (c6-cite! 'rr-magnitude-is-abs d)
                          (dk-have! (list '<= 0 d) (lambda () (dk-ineq! (list '< 0 d))))
                          (c6-cite! 'rr-abs-of-nonneg d)
                          (dk-have! (list '= (list 'magnitude cc2) d)
                            (lambda () (subst (list '= cc2 d)) (subst (list '= (list 'magnitude d) (list 'abs d))) (dk-ass!)))
                          (fact 'cc-magnitude-closed cc2)
                          (let ((pt! (lambda (w)  ; w in b2: |w - c| < r2, w /= c, w in BALL(c, r), w in u
                                       (let* ((lt (c6-ball-parts! w c2 e)) (wc (list '- w c)) (wc2 (list '- w c2)))
                                         (c6-cc! wc) (fact 'cc-magnitude-closed wc)
                                         (let* ((ch (c6-cite! 'cc-magnitude-sub-chain w c2 c))
                                                (t2 (begin (c6-and! (list 'IN wc2 'CC) (list 'IN cc2 'CC)) (c6-cite! 'cc-magnitude-sub-chain c2 w c)))
                                                (sy (c6-cite! 'cc-magnitude-sub-sym c2 w)))
                                           (fact 'cc-sub-in-cc c2 w) (fact 'cc-magnitude-closed (list '- c2 w))
                                           (dk-have! (list '< (list 'magnitude wc) r2)
                                             (lambda () (dk-ineq! ch lt (list '= (list 'magnitude cc2) d) (list '= (list '+ e e) d) (list '= (list '+ d d) r2) (list '< 0 e))))
                                           (dk-have! (list '< 0 (list 'magnitude wc))
                                             (lambda () (dk-ineq! t2 sy lt (list '= (list 'magnitude cc2) d) (list '= (list '+ e e) d) (list '< 0 e))))
                                           (dk-have! (list 'NOT (list '= w c))
                                             (lambda () (di) (dk-have! (list '= wc 0) (lambda () (subst (list '= w c)) (crs)))
                                                        (fact 'cc-magnitude-zero) (fact 'cc-zero-in) (c6-mag! 0)
                                                        (dk-absurd! (dk-rewrite-h! (dk-rewrite-h! (list '< 0 (list 'magnitude wc)) wc 0) '(magnitude 0) 0))))
                                           (let ((iff (c6-ball-iff! c r w)))
                                             (dk-have! (list '< (list 'magnitude wc) r) (lambda () (dk-ineq! (list '< (list 'magnitude wc) r2) (list '<= r2 r))))
                                             (dk-have! (list 'IN w (list 'BALL 'CC-MS c r)) (lambda () (keep iff (list 'IN w 'CC) (list '< (list 'magnitude wc) r)) (prop))))
                                           (fact 'subset-mem-fwd (list 'BALL 'CC-MS c r) u w)
                                           (let ((iff1 (c6-ball-iff! c r1 w)))
                                             (dk-have! (list '< (list 'magnitude wc) r1) (lambda () (dk-ineq! (list '< (list 'magnitude wc) r2) (list '<= r2 r1))))
                                             (dk-have! (list 'IN w (list 'BALL 'CC-MS c r1)) (lambda () (keep iff1 (list 'IN w 'CC) (list '< (list 'magnitude wc) r1)) (prop)))))))))
                            ;; c2 in u, BALL(c2, e) inside u, and the cover of BALL(c2, e) by the first N factors
                            (c6-cite! 'cc-ms-ball-centre c2 e)
                            (pt! c2)
                            (dk-have! (list 'SUBSET b2 u) (lambda () (let ((w (subset-by-element!))) (pt! w) (dk-ass!))))
                            (dk-have! (c6-zcov u f c2 e nn)
                              (lambda ()
                                (let* ((w (dk-di-var!)))
                                  (pt! w)
                                  (let* ((k (c6-sk! (dk-apply! zc w))))
                                    (c6-nn! k)
                                    (use-em (list '= k nn)
                                      (lambda ()
                                        (dk-apply! zf w)
                                        (c6-fv! f u nn w)
                                        (dk-have! (list '= (list gn w) 0)
                                          (lambda () (dk-lam-b!) (subst (list '= nn k)) (dk-ass!)))
                                        (ai (list 'NOT (list '= (list gn w) 0))))
                                      (lambda ()
                                        (c6-lt-from-le! k nn)
                                        (ew k) (dk-conj-close! (lambda () (dk-ass!)))))))))
                            (let ((k (c6-sk! (dk-apply! ih c2 e))))   ; W1G-B: u, f hoisted
                              (c6-nn! k)
                              (c6-lt-succ! k nn)
                              (ew k) (dk-conj-close! (lambda () (dk-ass!))))))))))
              (c6-and! (list 'IN r 'RR) (list 'IN r1 'RR))
              (use-cases (dk-fact! 'rr-leq-total r r1)
                (lambda () (dk-have! (list '<= r r) (lambda () (dk-ineq!))) (go! r))
                (lambda () (dk-have! (list '<= r1 r1) (lambda () (dk-ineq!))) (go! r1))))))))))
(qed 'finite-zero-cover)

;;; the terms of a convergent real series of nonnegative terms are eventually at most eps
(sp (make-wff (list 'FORALL 'c6g_ (list 'IMPLIES '(IN c6g_ (FUN NN RR)) (list 'IMPLIES (c6-nonneg 'c6g_) (list 'IMPLIES '(SERIES-CONVERGES c6g_)
  '(FORALL c6e_ (IMPLIES (POS-RR c6e_)
    (FORSOME c6m_ (AND (IN c6m_ NN) (FORALL c6q_ (IMPLIES (IN c6q_ NN) (IMPLIES (<= c6m_ c6q_) (<= (c6g_ c6q_) c6e_))))))))))))))
(let* ((new (c6-steps!)) (g (c6-var new '(FUN NN RR))) (ev (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) new))))
  (fact 'rr-pos-rr-in-rr ev)
  (let* ((nb (c6-sk! (dk-apply! (c6-cite! 'series-tail-small g) ev)))
         (tl (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q nb) (dk-contains? q ev))) (dk-asms))))
    (ew nb)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (dk-ass!)
          (let* ((nk (c6-steps!)) (k (c6-var nk 'NN)) (k1 (list 'succ k)))
            (c6-nn! k) (c6-nn! nb) (fact 'nn-succ-closed k) (c6-nn! k1) (fact 'nn-succ-plus-one k)
            (dk-have! (list '<= nb k1) (lambda () (dk-ineq! (list '<= nb k) (list '= k1 (list '+ k 1)))))
            (dk-apply! tl k1)
            (c6-sps-typ! g k) (c6-sps-typ! g nb) (c6-sps-typ! g k1) (fact 'fun-apply-type-c g 'NN 'RR k)
            (let* ((su (c6-sps-succ! g k)) (mo (c6-cite! 'series-partial-sum-mono k nb g))
                   (t2 (dk-rewrite-h! (list '<= (list '- (c6-sps g k1) (c6-sps g nb)) ev) (c6-sps g k1) (list '+ (c6-sps g k) (list g k)))))
              (dk-ineq! t2 mo))))))))
(qed 'nonneg-series-terms-small)

;;; the sup norms of f on K = K_n: real, nonnegative, and |f_k(x)| <= ||f_k||_K (pn = PROD-NORMAL in context)
(define (c6-sn-setup! u f n pn)
  (let* ((kn (list 'CC-EXHAUST u n)) (sn (c6-sn f kn)))
    (dk-have! (list 'IS-NORMALLY-CONVERGENT f kn)
      (lambda () (dk-split-all! (dk-landed (lambda () (mac-h 'PROD-NORMAL-ON-COMPACTA (dk-ctx-form pn)))))
                 (dk-apply! (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'IS-NORMALLY-CONVERGENT))) (dk-asms)) n)
                 (dk-ass!)))
    (dk-split-all! (dk-landed (lambda () (mac-h 'IS-NORMALLY-CONVERGENT (list 'IS-NORMALLY-CONVERGENT f kn)))))
    (c6-cite! 'cc-exhaust-subset u n)
    (let* ((snr (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'CC-SUP-NORM) (dk-contains? q kn) (not (dk-contains? q 'SERIES-CONVERGES)))) (dk-asms)))
           (kty! (lambda (k)
                   (dk-have! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y kn) (list 'IN (list (list f k) 'y) 'CC)))
                     (lambda () (let ((y (dk-di-var!))) (fact 'subset-mem-fwd kn u y) (c6-fv! f u k y) (dk-ass!))))))
           (up! (lambda (k x)
                  (fact 'subset-mem-fwd kn u x) (c6-fv! f u k x) (c6-mag! (list (list f k) x))
                  (kty! k) (dk-apply! snr k)
                  (dk-apply! (c6-cite! 'cc-sup-norm-upper (list f k) kn) x))))
      (c6-lam-typ! sn 'RR (lambda (k) (dk-apply! snr k) (dk-ass!)))
      (dk-have! (c6-nonneg sn)
        (lambda () (let* ((k (dk-di-var!)) (snk (list 'CC-SUP-NORM (list f k) kn)))
                     (dk-lam-b!) (dk-apply! snr k) (kty! k)
                     (let ((ab (list 'abs snk)))
                       (fact 'rr-abs-closed snk) (c6-cite! 'rr-abs-nonneg snk) (c6-rr! (list '- snk)) (fact 'rr-abs-closed (list '- snk))
                       (c6-cite! 'rr-neg-abs-le (list '- snk))
                       (dk-have! (list '<= snk ab) (lambda () (c6-cite! 'rr-abs-neg snk) (dk-ineq! (dk-ctx-form (list '<= (list '- (list 'abs (list '- snk))) (list '- snk))) (list '= (list 'abs (list '- snk)) ab))))
                       (dk-have! (list 'FORALL 'cpsx_ (list 'IMPLIES (list 'IN 'cpsx_ kn) (list '<= (list 'magnitude (list (list f k) 'cpsx_)) ab)))
                         (lambda () (let ((x (dk-di-var!))) (up! k x) (dk-ineq! (list '<= (list 'magnitude (list (list f k) x)) snk) (list '<= snk ab)))))
                       (dk-split-all! (list (c6-cite! 'cc-sup-norm-bound (list f k) kn ab)))
                       (dk-ass!)))))
      (list sn snr up!))))
;;; COROLLARY 6.13 (on a connected u).  If each 1 + f_k is holomorphic on u and not identically zero, and
;;; prod (1 + f_k) is normally convergent on compact subsets, the product is holomorphic on u and not
;;; identically zero.
(define (c6-nz-each u f) (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list 'FORSOME 'c6w_ (list 'AND (list 'IN 'c6w_ u) (list 'NOT (list '= (list '+ 1 (list (list f 'c6i_) 'c6w_)) 0)))))))
(sp (make-wff (list 'FORALL 'c6u_ (list 'IMPLIES '(IS-OPEN CC-MS c6u_) (list 'IMPLIES '(IS-CONNECTED CC-MS c6u_)
  (list 'FORALL 'c6f_ (list 'IMPLIES (c6-famty 'c6u_ 'c6f_) (list 'IMPLIES (c6-famhol 'c6u_ 'c6f_) (list 'IMPLIES (c6-nz-each 'c6u_ 'c6f_)
    (list 'IMPLIES '(PROD-NORMAL-ON-COMPACTA c6u_ c6f_)
      (list 'AND '(HOLOMORPHIC-ON c6u_ (PROD-FUN c6u_ c6f_))
        '(FORSOME c6v_ (AND (IN c6v_ c6u_) (NOT (= ((PROD-FUN c6u_ c6f_) c6v_) 0)))))))))))))))
(let* ((new (c6-steps!)) (u (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) new)))
       (f (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (c6-op? (caddr q) 'FUN 3) (eq? (cadr (caddr q)) 'NN))) new)))
       (nz (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'c6w_))) new))
       (pn (find-first (lambda (q) (dk-head-is? q 'PROD-NORMAL-ON-COMPACTA)) new))
       (pf (list 'PROD-FUN u f))
       (gl '(FORSOME c6v_ (AND (IN c6v_ c6u_) (NOT (= ((PROD-FUN c6u_ c6f_) c6v_) 0))))))
  (c6-cite! 'prod-fun-holomorphic u f)
  (c6-cite! 'cc-ms-open-iff u)
  (dk-have! (list 'IS-OPEN c6-nfm u) (lambda () (mac 'cc-ms-open-iff) (dk-ass!)))
  (c6-setu! u) (fact 'nn-zero-in) (fact 'cc-one-in)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (dk-ass!)
        (use-em (dk-goal)
          (lambda () (dk-ass!))
          (lambda ()
            (let* ((gl0 (dk-goal))
                   (x0 (c6-sk! (dk-apply! nz 0)))
                   (n (begin (fact 'subset-mem-fwd u 'CC x0) (c6-sk! (c6-cite! 'cc-exhaust-covers u x0))))
                   (m (list '+ (list '* 4 n) 3)) (km (list 'CC-EXHAUST u m))
                   (rho (list '* 1/2 (list 'recip (list '+ n 1)))))
              (c6-nn! n)
              (dk-have! (list 'IN m 'NN) (lambda () (type-term)))
              (c6-cite! 'cc-exhaust-ball-inside u n x0)
              (c6-cite! 'cc-exhaust-subset u m)
              (dk-have! (list 'SUBSET (list 'BALL 'CC-MS x0 rho) u) (lambda () (c6-cite! 'subset-trans (list 'BALL 'CC-MS x0 rho) km u) (dk-ass!)))
              (c6-rr! (list '+ n 1))
              (dk-have! (list '< 0 (list '+ n 1)) (lambda () (fact 'nn-zero-le n) (dk-ineq! (list '<= 0 n))))
              (c6-cite! 'rr-recip-pos (list '+ n 1)) (c6-cite! 'rr-pos-ne-zero (list '+ n 1))
              (c6-and! (list 'IN (list '+ n 1) 'RR) (list 'NOT (list '= (list '+ n 1) 0))) (fact 'rr-recip-closed (list '+ n 1))
              (c6-rr! rho)
              (dk-have! (list '< 0 rho) (lambda () (dk-ineq! (list '< 0 (list 'recip (list '+ n 1))))))
              (c6-cite! 'rr-pos-rr-of-lt rho)
              (let* ((st (c6-sn-setup! u f m pn)) (sn (car st)) (up! (caddr st)))
                (c6-pos-rr! 1/2)
                (let* ((nv (c6-sk! (dk-apply! (c6-cite! 'nonneg-series-terms-small sn) 1/2)))
                       (sm (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q nv) (dk-contains? q 1/2))) (dk-asms))))
                  (c6-nn! nv)
                  (dk-have! (c6-zcov u f x0 rho nv)
                    (lambda ()
                      (let* ((x (dk-di-var!)) (ox (c6-opx f x)) (fx (list (list 'PROD-FUN u f) x)))
                        (fact 'subset-mem-fwd (list 'BALL 'CC-MS x0 rho) km x) (fact 'subset-mem-fwd km u x)
                        (dk-have! (list '= fx 0)
                          (lambda () (use-em (list '= fx 0) (lambda () (dk-ass!))
                                       (lambda () (dk-have! gl0 (lambda () (ew x) (dk-conj-close! (lambda () (dk-ass!))))) (ai (list 'NOT gl0))))))
                        (c6-lam-typ! ox 'CC (lambda (k) (c6-fv! f u k x) (c6-cc! (list '+ 1 (list (list f k) x)))))
                        (dk-split-all! (list (c6-cite! 'prop-6-11 u f x)))
                        (dk-split-all! (list (c6-cite! 'prod-value-spec ox)))
                        (dk-have! (list '= fx (list 'PROD-VALUE ox)) (lambda () (mac 'PROD-FUN) (dk-lam-b!) (dk-close-if! (lambda () #t) (lambda () (rfl)))))
                        (dk-have! (list '= (list 'PROD-VALUE ox) 0) (lambda () (subst (list '= (list 'PROD-VALUE ox) fx)) (dk-ass!)))
                        (dk-have! (c6-zx f x) (lambda () (keep (dk-ctx-form (list 'IFF (list '= (list 'PROD-VALUE ox) 0) (c6-zx f x))) (list '= (list 'PROD-VALUE ox) 0)) (prop)))
                        (let ((q (c6-sk! (c6-zx f x))))
                          (c6-nn! q)
                          (use-em (list '< q nv)
                            (lambda () (ew q) (dk-conj-close! (lambda () (dk-ass!))))
                            (lambda ()
                              (c6-cite! 'nn-not-lt-le q nv)
                              (let* ((up (up! q x)) (fq (list (list f q) x)) (oa (list '+ 1 fq)))
                                (fact 'cc-one-in) (c6-cc! oa) (c6-mag! oa)
                                (c6-and! (list 'IN oa 'CC) (list 'IN fq 'CC))
                                (let ((tr (dk-fact! 'cc-magnitude-sub-triangle oa fq)))
                                  (dk-have! (list '= (list '- oa fq) 1) (lambda () (crs)))
                                  (fact 'cc-magnitude-one) (fact 'cc-magnitude-zero) (fact 'cc-zero-in) (c6-mag! 0)
                                  (let* ((t4 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! tr (list '- oa fq) 1) '(magnitude 1) 1) oa 0) '(magnitude 0) 0))
                                         (s1 (begin (dk-lam-b-h! (dk-apply! sm q)) (list '<= (list 'CC-SUP-NORM (list f q) km) 1/2))))
                                    (dk-absurd! t4 up s1))))))))))
                  (let* ((k (c6-sk! (c6-cite! 'finite-zero-cover nv u f x0 rho)))
                         (w (c6-sk! (dk-apply! nz k))))
                    (dk-apply! (dk-ctx-form (c6-allz u f k)) w)
                    (ai (list 'NOT (list '= (list '+ 1 (list (list f k) w)) 0)))))))))))))
(qed 'corollary-6-13)

  
