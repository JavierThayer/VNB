                               (let ((k (c6-cite! 'rr-mul-le-right em 1 pn)))
                                 (dk-have! (list '= (list '* em pn) cv) (lambda () (crs)))
                                 (dk-have! (list '= (list '* 1 pn) pn) (lambda () (crs)))
                                 (c6-ineq*! k (list '= (list '* em pn) cv) (list '= (list '* 1 pn) pn)))))
                (use-cases (begin (c6-and! (list 'IN j 'RR) (list 'IN nv 'RR)) (dk-fact! 'rr-leq-total j nv))
                  (lambda ()                    ; j <= N: the products decrease
                    (let* ((dv (c6-sk! (c6-cite! 'nn-le-gap nv j))))
                      (dk-have! (c6-le1 (c6-omr r))
                        (lambda () (let ((i (dk-di-var!))) (fact 'fun-apply-type-c r 'NN 'RR i) (dk-apply! (dk-ctx-form (c6-nonneg r)) i) (dk-lam-b!) (dk-ineq! (list '<= 0 (list r i))))))
                      (let ((dc (c6-cite! 'pprod-dec dv j (c6-omr r))))
                        (dk-ineq! (dk-rewrite-h! dc (list '+ j dv) nv) (list '<= cv pn)))))
                  (lambda ()                    ; N <= j: the ratio estimate
                    (let* ((dv (c6-sk! (c6-cite! 'nn-le-gap j nv))) (nd (list '+ nv dv)) (sd (c6-sps r nd)) (sn (c6-sps r nv))
                           (xx (list '* -2 (list '- sd sn))))
                      (c6-and! (list 'IN nv 'NN) (list 'IN dv 'NN)) (fact 'nn-add-closed nv dv)
                      (subst (list '= j nd))
                      (dk-cite! 'pprod-in-rr nd (c6-omr r))
                      (c6-sps-typ! r nd) (c6-rr! xx) (fact 'r-exp-in-rr xx)
                      (let* ((ra (c6-cite! 'pprod-omr-ratio dv nv r)))
                        (c6-bnd-at bs r nd)
                        (c6-cite! 'series-partial-sum-nonneg nv r)
                        (dk-have! (list '<= m2 xx) (lambda () (dk-ineq! (list '<= sd bs) (list '<= 0 sn))))
                        (dk-have! (list '<= 0 pn) (lambda () (dk-ineq! (list '< 0 pn))))
                        (let* ((mo (c6-cite! 'r-exp-mono m2 xx))
                               (k (c6-cite! 'rr-mul-le-right em (list 'R-EXP xx) pn))
                               (e1 (list '= (list '* em pn) cv))
                               (e2 (list '= (list '* (list 'R-EXP xx) pn) (list '* pn (list 'R-EXP xx)))))
                          (dk-have! e1 (lambda () (crs))) (dk-have! e2 (lambda () (crs)))
                          (c6-ineq*! ra k e1 e2))))))))))))))
(qed 'lemma-6-4-4-3)

;;; (3) => (2)
(sp (make-wff (c6-l64 'c6r_ (list 'IMPLIES (c6-c3 'c6r_) (c6-c2 'c6r_)))))
(let* ((new (c6-steps!)) (r (c6-l64-setup! new)) (cv (c6-sk! (c6-c3 r)))
       (cu (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q cv))) (dk-asms)))
       (rc (list 'recip cv)))
  (dk-have! (list 'NOT (list '= cv 0)) (lambda () (c6-cite! 'rr-pos-ne-zero cv) (dk-ass!)))
  (c6-and! (list 'IN cv 'RR) (list 'NOT (list '= cv 0)))
  (fact 'rr-recip-closed cv) (fact 'rr-recip-inverse cv)
  (ew rc)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (dk-ass!)
        (let* ((j (dk-di-var!)) (qj (list 'PPROD (c6-opr r) j)) (pj (list 'PPROD (c6-omr r) j)))
          (dk-cite! 'pprod-in-rr j (c6-opr r)) (dk-cite! 'pprod-in-rr j (c6-omr r)) (c6-sps-typ! r j)
          (dk-apply! cu j)
          (dk-split-all! (list (c6-cite! 'pprod-exp-bounds j r)))
          (c6-cite! 'series-partial-sum-nonneg j r)
          (dk-have! (list '<= 0 qj) (lambda () (dk-ineq! (list '<= (list '+ 1 (c6-sps r j)) qj) (list '<= 0 (c6-sps r j)))))
          (dk-split-all! (list (c6-cite! 'pprod-opr-omr-le j r)))
          (let* ((k (c6-cite! 'rr-mul-le-right cv pj qj))
                 (e1 (list '= (list '* pj qj) (list '* qj pj)))
                 (e2 (list '= (list '* qj cv) (list '* cv qj)))
                 (e3 (list '= (list '* rc cv) (list '* cv rc))))
            (for-each (lambda (e) (dk-have! e (lambda () (crs)))) (list e1 e2 e3))
            (c6-rr! (list '* qj cv)) (c6-rr! (list '* rc cv))
            (dk-have! (list '<= (list '* qj cv) (list '* rc cv)) (lambda () (c6-ineq*! k e1 e2 e3 (list '= (list '* cv rc) 1) (list '<= (list '* qj pj) 1))))
            (c6-cite! 'rr-mul-le-cancel-pos qj cv rc)
            (dk-ass!)))))))
(qed 'lemma-6-4-3-2)

;;; LEMMA 6.4.  For 0 < r_i < 1 the following are equivalent:
;;;   (1) sum ln(1 + r_i) < oo;  (2) prod (1 + r_i) < oo;  (3) prod (1 - r_i) > 0;  (4) sum r_i < oo.
;;; (2) is read as "the partial products are bounded" and (3) as "the partial products of the 1 - r_i are
;;; bounded below by a positive constant" -- the values in [0, oo] of Remark 6.2 being their limits.
(sp (make-wff (c6-l64 'c6r_ (list 'AND (list 'IFF (c6-c1 'c6r_) (c6-c2 'c6r_))
                              (list 'AND (list 'IFF (c6-c2 'c6r_) (c6-c4 'c6r_)) (list 'IFF (c6-c3 'c6r_) (c6-c4 'c6r_)))))))
(let* ((new (c6-steps!)) (r (c6-var new '(FUN NN RR)))
       (ims (map (lambda (nm) (dk-cite! nm r)) '(lemma-6-4-1-2 lemma-6-4-2-1 lemma-6-4-2-4 lemma-6-4-4-2 lemma-6-4-4-3 lemma-6-4-3-2))))
  (apply keep ims)
  (prop))
(qed 'lemma-6-4)

;;; ---------------------------------------------------------------- the logarithm near 1 (for 6.8)
(define (c6-slit w) (list 'NOT (list 'AND (list '= (list 'imag-part w) 0) (list '<= (list 'real-part w) 0))))
(define (c6-pow2! x)                           ; (= (power x 2) (* x x)), x in CC
  (let ((e (list '= (list 'power x 2) (list '* x x))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (fact 'nn-two-is-succ-succ-zero) (subst '(= 2 (succ (succ 0))))
            (fact 'nn-zero-in) (fact 'nn-succ-closed 0)
            (c6-and! (list 'IN x 'CC) '(IN (succ 0) NN)) (subst (dk-fact! 'power-succ x '(succ 0)))
            (c6-and! (list 'IN x 'CC) '(IN 0 NN)) (subst (dk-fact! 'power-succ x 0))
            (subst (dk-fact! 'power-zero x))
            (crs))))
    e))
(define (c6-exp-le-log! x y)                   ; x, y in RR, R-EXP(x) <= R-EXP(y): lands x <= y
  (fact 'r-exp-in-rr x) (fact 'r-exp-in-rr y) (fact 'r-exp-pos x) (fact 'log-r-exp x) (fact 'log-r-exp y)
  (let ((lm (c6-cite! 'log-monotone (list 'R-EXP x) (list 'R-EXP y))))
    (dk-have! (list '<= x y)
      (lambda () (dk-ineq! (dk-rewrite-h! (dk-rewrite-h! lm (list 'LOG (list 'R-EXP x)) x) (list 'LOG (list 'R-EXP y)) y))))
    (list '<= x y)))

;;; |log(1 + z)| <= 2|z| and |z| <= 2|log(1 + z)| for |z| <= 1/10 (and 1 + z is in the domain of log):
;;; the quantitative form of (154)
(sp (make-wff '(FORALL c6z_ (IMPLIES (IN c6z_ CC) (IMPLIES (<= (magnitude c6z_) 1/10)
  (AND (NOT (AND (= (imag-part (+ 1 c6z_)) 0) (<= (real-part (+ 1 c6z_)) 0)))
       (AND (<= (magnitude (CC-LOG (+ 1 c6z_))) (* 2 (magnitude c6z_)))
            (<= (magnitude c6z_) (* 2 (magnitude (CC-LOG (+ 1 c6z_))))))))))))
(let* ((new (c6-steps!)) (z (c6-var new 'CC)) (u (list '+ 1 z)) (w (list 'CC-LOG u)) (mz (list 'magnitude z))
       (rw (list 'real-part w)) (iw (list 'imag-part w)))
  (fact 'cc-one-in) (fact 'rr-one-in) (fact 'rr-zero-in) (c6-cc! u) (c6-mag! z) (c6-mag! u)
  (fact 'pi-pos) (dk-split-all!) (fact 'cc-pi-gt-three)
  (for-each (lambda (q) (dk-have! (list 'IN q 'RR) (lambda () (arith)))) '(1/8 1/9 1/10))
  (dk-have! '(< 0 1/8) (lambda () (dk-ineq!))) (dk-have! '(< 0 1/9) (lambda () (dk-ineq!)))
  (dk-have! '(<= (* 1/9 (+ 1 PI)) PI) (lambda () (dk-ineq! '(< 3 PI))))
  (dk-have! '(<= (* 1/9 (+ 1 1/8)) 1/8) (lambda () (arith)))
  ;; u in BALL(1, 1/9)
  (fact 'cc-is-metric-space)
  (let* ((um1 (list '- u 1)) (iff (begin (c6-cc! um1) (c6-cite! 'cc-ms-ball-membership 1 1/9 u))))
    (dk-have! (list '= um1 z) (lambda () (crs)))
    (dk-have! (list '< (list 'magnitude um1) 1/9) (lambda () (subst (list '= um1 z)) (dk-ineq! (list '<= mz 1/10))))
    (dk-have! (list 'IN u '(BALL CC-MS 1 1/9)) (lambda () (keep iff (list 'IN u 'CC) (list '< (list 'magnitude um1) 1/9)) (prop))))
  (dk-split-all! (list (c6-cite! 'cc-log-im-near-one 1/8 1/9 u)))
  (dk-split-all! (list (c6-cite! 'cc-log-spec u)))
  (fact 'real-part-in-rr w) (fact 'imag-part-in-rr w) (c6-mag! w)
  ;; Re w = ln|u|, bounded by |z| above and -2|z| below
  (let* ((em (c6-cite! 'cc-exp-magnitude w))
         (er (c6-cite! 'cc-exp-real-is-r-exp rw))
         (eu (dk-rewrite-h! (dk-rewrite-h! em (list 'CC-EXP w) u) (list 'CC-EXP rw) (list 'R-EXP rw))))  ; |u| = R-EXP(Re w)
    (c6-and! '(IN 1 CC) (list 'IN z 'CC)) (fact 'cc-magnitude-one)
    (let* ((t1 (dk-rewrite-h! (dk-fact! 'cc-magnitude-triangle 1 z) '(magnitude 1) 1))
           (t2 (begin (fact 'cc-magnitude-one) (c6-and! (list 'IN u 'CC) (list 'IN z 'CC)) (dk-fact! 'cc-magnitude-sub-triangle u z)))
           (t2b (begin (dk-have! (list '= (list '- u z) 1) (lambda () (crs)))
                       (dk-rewrite-h! (dk-rewrite-h! t2 (list '- u z) 1) '(magnitude 1) 1))))
      (fact 'cc-magnitude-one)
      (c6-cite! 'r-exp-ge-one-plus mz)
      (fact 'r-exp-in-rr mz) (fact 'r-exp-in-rr rw)
      (dk-have! (list '<= (list 'R-EXP rw) (list 'R-EXP mz)) (lambda () (dk-ineq! eu t1 (list '<= (list '+ 1 mz) (list 'R-EXP mz)))))
      (c6-exp-le-log! rw mz)
      (dk-have! (list '<= mz 1/2) (lambda () (dk-ineq! (list '<= mz 1/10))))
      (let ((m2 (list '* -2 mz)))
        (c6-rr! m2) (fact 'r-exp-in-rr m2)
        (c6-cite! 'r-exp-neg-two-le mz)
        (dk-have! (list '<= (list 'R-EXP m2) (list 'R-EXP rw)) (lambda () (dk-ineq! eu t2b (list '<= (list 'R-EXP m2) (list '- 1 mz)))))
        (c6-exp-le-log! m2 rw))))
  ;; |w| <= |Re w| + |Im w| <= 2/10 + 1/8 < 1/2
  (let* ((le (c6-cite! 'cc-magnitude-le-re-im w))
         (ar (begin (dk-have! (list '<= (list '- (list '* 2 mz)) rw) (lambda () (dk-ineq! (list '<= (list '* -2 mz) rw))))
                    (dk-have! (list '<= rw (list '* 2 mz)) (lambda () (dk-ineq! (list '<= rw mz) (list '<= 0 mz))))
                    (c6-rr! (list '* 2 mz))
                    (c6-cite! 'rr-abs-le-of-parts rw (list '* 2 mz))))
         (ai2 (begin (dk-have! (list '<= (list '- 1/8) iw) (lambda () (dk-ineq! (list '< (list '- 1/8) iw))))
                     (dk-have! (list '<= iw 1/8) (lambda () (dk-ineq! (list '< iw 1/8))))
                     (c6-cite! 'rr-abs-le-of-parts iw 1/8))))
    (fact 'rr-abs-closed rw) (fact 'rr-abs-closed iw)
    (dk-have! (list '<= (list 'magnitude w) 1/2) (lambda () (dk-ineq! le ar ai2 (list '<= mz 1/10))))
    (dk-have! (list '<= (list 'magnitude w) 1) (lambda () (dk-ineq! (list '<= (list 'magnitude w) 1/2)))))
  ;; |z - w| <= |w|^2 <= |w| / 2
  (let* ((mw (list 'magnitude w)) (zw (list '- z w))
         (ne (c6-cite! 'cc-exp-near-one w))
         (p2 (begin (fact 'rr-subset-cc mw) (c6-pow2! mw)))
         (e1 (begin (dk-have! (list '= (list '- (list '- u 1) w) zw) (lambda () (crs))) #t))
         (ne2 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! ne (list 'CC-EXP w) u) (list '- (list '- u 1) w) zw) (list 'power mw 2) (list '* mw mw))))
    (c6-cc! zw) (c6-mag! zw)
    (let* ((k (c6-cite! 'rr-mul-le-right mw 1/2 mw))
           (t3 (begin (c6-and! (list 'IN z 'CC) (list 'IN zw 'CC)) (dk-fact! 'cc-magnitude-sub-triangle z zw)))
           (t3b (begin (dk-have! (list '= (list '- z zw) w) (lambda () (crs))) (dk-rewrite-h! t3 (list '- z zw) w)))
           (t4 (begin (c6-and! (list 'IN w 'CC) (list 'IN zw 'CC)) (dk-fact! 'cc-magnitude-triangle w zw)))
           (t4b (begin (dk-have! (list '= (list '+ w zw) z) (lambda () (crs))) (dk-rewrite-h! t4 (list '+ w zw) z))))
      (dk-have! (list '= (list '* 1/2 mw) (list '* 1/2 mw)) (lambda () (rfl)))
      (dk-conj-close!
        (lambda ()
          (cond ((dk-asm? (dk-goal)) (dk-ass!))
                ((equal? (cadr (dk-goal)) mw) (c6-ineq*! t3b ne2 k))
                (#t (c6-ineq*! t4b ne2 k (list '<= 0 mw)))))))))
(qed 'cc-log-one-plus-near-zero)

;;; ---------------------------------------------------------------- Proposition 6.8
;;; the terms of an absolutely convergent series are eventually at most eps in modulus
(sp (make-wff (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC)) (list 'IMPLIES (list 'SERIES-CONVERGES (c6-mag 'c6a_))
  '(FORALL c6e_ (IMPLIES (POS-RR c6e_)
    (FORSOME c6m_ (AND (IN c6m_ NN) (FORALL c6q_ (IMPLIES (IN c6q_ NN) (IMPLIES (<= c6m_ c6q_) (<= (magnitude (c6a_ c6q_)) c6e_)))))))))))))
(let* ((new (c6-steps!)) (a (c6-var new '(FUN NN CC))) (g (c6-mag a))
       (ev (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) new))))
  (c6-mag-typ! a) (c6-mag-nonneg! a) (fact 'rr-pos-rr-in-rr ev)
  (let* ((nb (c6-sk! (dk-apply! (c6-cite! 'series-tail-small g) ev)))
         (tl (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q nb) (dk-contains? q ev))) (dk-asms))))
    (ew nb)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (dk-ass!)
          (let* ((nk (c6-steps!)) (k (c6-var nk 'NN)) (k1 (list 'succ k)))
            (c6-nn! k) (c6-nn! nb) (fact 'nn-succ-closed k) (c6-nn! k1) (fact 'nn-succ-plus-one k)
            (dk-have! (list '<= nb k1) (lambda () (dk-ineq! (list '<= nb k) (list '= k1 (list '+ k 1)))))
            (dk-apply! tl k1)
            (c6-sps-typ! g k) (c6-sps-typ! g nb) (c6-sps-typ! g k1)
            (let* ((su (c6-sps-succ! g k)) (mo (c6-cite! 'series-partial-sum-mono k nb g)))
              (fact 'fun-apply-type-c a 'NN 'CC k) (c6-mag! (list a k))
              (dk-lam-b-h! su)
              (let ((t2 (dk-rewrite-h! (list '<= (list '- (c6-sps g k1) (c6-sps g nb)) ev) (c6-sps g k1)
                                       (list '+ (c6-sps g k) (list 'magnitude (list a k))))))
                (dk-ineq! t2 mo)))))))))
(qed 'abs-series-terms-small-eps)

;;; and back: if the shifted moduli are summable, so are the moduli
(sp (make-wff (list 'FORALL 'c6m_ (list 'IMPLIES '(IN c6m_ NN) (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC))
  (list 'IMPLIES (list 'SERIES-CONVERGES (c6-gs 'c6a_ 'c6m_)) (list 'SERIES-CONVERGES (c6-mag 'c6a_)))))))))
(let* ((new (c6-steps!)) (mv (c6-var new 'NN)) (a (c6-var new '(FUN NN CC))) (g (c6-mag a)) (gs (c6-gs a mv)))
  (c6-mag-typ! a) (c6-mag-nonneg! a) (c6-gs-typ! a mv)
  (dk-have! (c6-nonneg gs) (lambda () (let ((i (dk-di-var!))) (c6-and! (list 'IN mv 'NN) (list 'IN i 'NN)) (fact 'nn-add-closed mv i)
                                          (fact 'fun-apply-type-c a 'NN 'CC (list '+ mv i)) (c6-mag! (list a (list '+ mv i))) (dk-lam-b!) (dk-ass!))))
  (let* ((bv (c6-bound-of! gs)) (sm (c6-sps g mv)) (bb (list '+ sm bv)))
    (c6-sps-typ! g mv) (c6-rr! bb)
    (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list '<= (c6-sps g 'c6j_) bb)))
      (lambda ()
        (let* ((k (dk-di-var!)) (j (list '+ mv k)))
          (c6-and! (list 'IN mv 'NN) (list 'IN k 'NN)) (fact 'nn-add-closed mv k)
          (c6-sps-typ! g j) (c6-sps-typ! g k) (c6-sps-typ! gs k)
          (c6-nn! mv) (c6-nn! k) (fact 'nn-zero-le mv)
          (dk-have! (list '<= k j) (lambda () (dk-ineq! (list '<= 0 mv))))
          (let* ((mo (c6-cite! 'series-partial-sum-mono j k g))
                 (sh (c6-cite! 'sps-shift k mv a)))
            (c6-bnd-at bv gs k)
            (dk-ineq! mo sh (list '<= (c6-sps gs k) bv))))))
    (c6-cite! 'series-bounded-converges g bb)
    (dk-ass!)))
(qed 'series-unshift-abs-converges)

(define (c6-lgs a nv) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'magnitude (list 'CC-LOG (list '+ 1 (list a (list '+ nv 'c6k_)))))))
(define (c6-lgc a nv) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'CC-LOG (list '+ 1 (list a (list '+ nv 'c6k_))))))   ; k |-> log(1 + a(N + k))
(define (c6-guard-from a nv) (list 'FORALL 'c6q_ (list 'IMPLIES '(IN c6q_ NN) (list 'IMPLIES (list '<= nv 'c6q_) (c6-slit (list '+ 1 (list a 'c6q_)))))))
(define (c6-pos-rr! q) (if (not (dk-asm? (list 'POS-RR q))) (begin (dk-have! (list 'IN q 'RR) (lambda () (arith))) (dk-have! (list '< 0 q) (lambda () (dk-ineq!))) (c6-cite! 'rr-pos-rr-of-lt q))))
(define (c6-nk! nv k)                         ; nv, k in NN: (+ nv k) in NN, RR, CC and nv <= nv + k
  (let ((j (list '+ nv k)))
    (c6-and! (list 'IN nv 'NN) (list 'IN k 'NN)) (fact 'nn-add-closed nv k) (c6-nn! nv) (c6-nn! k) (c6-nn! j) (fact 'nn-zero-le k)
    (if (not (dk-asm? (list '<= nv j))) (dk-have! (list '<= nv j) (lambda () (dk-ineq! (list '<= 0 k)))))
    j))

;;; the w = log(1 + z) facts at a point: slit guard of 1 + z in context, z in CC: w in CC
(define (c6-log-typ! z)
  (let ((u (list '+ 1 z)))
    (fact 'cc-one-in) (c6-cc! u)
    (if (not (dk-asm? (list 'IN (list 'CC-LOG u) 'CC))) (dk-split-all! (list (c6-cite! 'cc-log-spec u))))
    (c6-mag! (list 'CC-LOG u))))
(define (c6-two-times lam-body-of) (list 'VNB-LAMBDA 'c6k_ 'NN (list '* 2 (lam-body-of 'c6k_))))

;;; 6.8, forward: |a_k| <= 1/10 from N on and sum |a_k| < oo give sum_k |log(1 + a(N + k))| < oo
(sp (make-wff (list 'FORALL 'c6m_ (list 'IMPLIES '(IN c6m_ NN) (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC))
  (list 'IMPLIES (list 'SERIES-CONVERGES (c6-mag 'c6a_))
    (list 'IMPLIES '(FORALL c6q_ (IMPLIES (IN c6q_ NN) (IMPLIES (<= c6m_ c6q_) (<= (magnitude (c6a_ c6q_)) 1/10))))
      (list 'SERIES-CONVERGES (c6-lgs 'c6a_ 'c6m_))))))))))
(let* ((new (c6-steps!)) (nv (c6-var new 'NN)) (a (c6-var new '(FUN NN CC)))
       (uu (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 1/10))) new))
       (lgs (c6-lgs a nv)) (gs (c6-gs a nv))
       (hh (c6-two-times (lambda (k) (list 'magnitude (list a (list '+ nv k))))))
       (pt! (lambda (k)                        ; k in NN: the facts at j = N + k
              (let ((j (c6-nk! nv k)))
                (fact 'fun-apply-type-c a 'NN 'CC j) (c6-mag! (list a j))
                (dk-apply! uu j)
                (dk-split-all! (list (c6-cite! 'cc-log-one-plus-near-zero (list a j))))
                (c6-log-typ! (list a j))
                j))))
  (c6-mag-typ! a) (c6-gs-typ! a nv) (fact 'rr-zero-in)
  (c6-lam-typ! lgs 'RR (lambda (k) (pt! k)))
  (c6-lam-typ! hh 'RR (lambda (k) (let ((j (pt! k))) (c6-rr! (list '* 2 (list 'magnitude (list a j)))))))
  (c6-cite! 'series-shift-abs-converges nv a)
  (dk-have! (c6-nonneg gs) (lambda () (let ((i (dk-di-var!))) (pt! i) (dk-lam-b!) (dk-ass!))))
  (dk-have! (c6-nonneg lgs) (lambda () (let ((i (dk-di-var!))) (pt! i) (dk-lam-b!) (dk-ass!))))
  (dk-have! (c6-nonneg hh) (lambda () (let* ((i (dk-di-var!)) (j (pt! i))) (dk-lam-b!) (dk-ineq! (list '<= 0 (list 'magnitude (list a j)))))))
  (dk-have! '(IN 2 RR) (lambda () (arith))) (dk-have! '(<= 0 2) (lambda () (arith)))
  (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list '= (list hh 'c6j_) (list '* 2 (list gs 'c6j_)))))
    (lambda () (let ((k (dk-di-var!))) (pt! k) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
  (c6-cite! 'series-scale-converges gs 2 hh)
  (fact 'nn-zero-in)
  (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES '(<= 0 c6j_) (list '<= (list lgs 'c6j_) (list hh 'c6j_)))))
    (lambda () (let* ((nk (c6-steps!)) (k (c6-var nk 'NN))) (pt! k) (dk-lam-b!) (dk-ass!))))
  (c6-cite! 'series-eventually-dominated-converges lgs hh 0)
  (dk-ass!))
(qed 'prop-6-8-forward)

;;; 6.8, backward: the guard from N on and sum_k |log(1 + a(N + k))| < oo give sum |a_k| < oo
(sp (make-wff (list 'FORALL 'c6m_ (list 'IMPLIES '(IN c6m_ NN) (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC))
  (list 'IMPLIES (c6-guard-from 'c6a_ 'c6m_)
    (list 'IMPLIES (list 'SERIES-CONVERGES (c6-lgs 'c6a_ 'c6m_)) (list 'SERIES-CONVERGES (c6-mag 'c6a_))))))))))
(let* ((new (c6-steps!)) (nv (c6-var new 'NN)) (a (c6-var new '(FUN NN CC)))
       (gd (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'imag-part))) new))
       (lgs (c6-lgs a nv)) (lgc (c6-lgc a nv)) (gs (c6-gs a nv))
       (h2 (c6-two-times (lambda (k) (list 'magnitude (list 'CC-LOG (list '+ 1 (list a (list '+ nv k))))))))
       (pt! (lambda (k) (let ((j (c6-nk! nv k))) (fact 'fun-apply-type-c a 'NN 'CC j) (c6-mag! (list a j)) (dk-apply! gd j) (c6-log-typ! (list a j)) j))))
  (c6-mag-typ! a) (c6-gs-typ! a nv) (fact 'rr-zero-in) (fact 'rr-one-in)
  (c6-lam-typ! lgc 'CC (lambda (k) (pt! k)))
  (c6-lam-typ! lgs 'RR (lambda (k) (pt! k)))
  (c6-lam-typ! h2 'RR (lambda (k) (let ((j (pt! k))) (c6-rr! (list '* 2 (list 'magnitude (list 'CC-LOG (list '+ 1 (list a j)))))))))
  (dk-have! (list 'SERIES-CONVERGES (c6-mag lgc)) (lambda () (dk-lam-b!) (dk-ass!)))
  (c6-pos-rr! 1/2)
  (let* ((mv (c6-sk! (dk-apply! (c6-cite! 'abs-series-terms-small-eps lgc) 1/2)))
         (sm (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q mv) (dk-contains? q 1/2))) (dk-asms))))
    (dk-have! (c6-nonneg gs) (lambda () (let ((i (dk-di-var!))) (pt! i) (dk-lam-b!) (dk-ass!))))
    (dk-have! (c6-nonneg lgs) (lambda () (let ((i (dk-di-var!))) (pt! i) (dk-lam-b!) (dk-ass!))))
    (dk-have! (c6-nonneg h2) (lambda () (let* ((i (dk-di-var!)) (j (pt! i))) (dk-lam-b!) (dk-ineq! (list '<= 0 (list 'magnitude (list 'CC-LOG (list '+ 1 (list a j)))))))))
    (dk-have! '(IN 2 RR) (lambda () (arith))) (dk-have! '(<= 0 2) (lambda () (arith)))
    (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list '= (list h2 'c6j_) (list '* 2 (list lgs 'c6j_)))))
      (lambda () (let ((k (dk-di-var!))) (pt! k) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
    (c6-cite! 'series-scale-converges lgs 2 h2)
    ;; |a(N + k)| <= 2 |log(1 + a(N + k))| for k >= M
    (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '<= mv 'c6j_) (list '<= (list gs 'c6j_) (list h2 'c6j_)))))
      (lambda ()
        (let* ((nk (c6-steps!)) (k (c6-var nk 'NN)) (j (pt! k)) (aj (list a j)) (u (list '+ 1 aj)) (w (list 'CC-LOG u)) (mw (list 'magnitude w))
               (aw (list '- aj w)))
          (dk-lam-b!)
          (dk-apply! sm k) (dk-lam-b-h! (list '<= (list 'magnitude (list lgc k)) 1/2))
          (dk-have! (list '<= mw 1) (lambda () (dk-ineq! (list '<= mw 1/2))))
          (c6-cc! aw) (c6-mag! aw)
          (let* ((ne (c6-cite! 'cc-exp-near-one w))
                 (p2 (begin (fact 'rr-subset-cc mw) (c6-pow2! mw)))
                 (e1 (begin (dk-have! (list '= (list '- (list '- u 1) w) aw) (lambda () (crs))) #t))
                 (ne2 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! ne (list 'CC-EXP w) u) (list '- (list '- u 1) w) aw) (list 'power mw 2) (list '* mw mw)))
                 (k1 (c6-cite! 'rr-mul-le-right mw 1/2 mw))
                 (t4 (begin (c6-and! (list 'IN w 'CC) (list 'IN aw 'CC)) (dk-fact! 'cc-magnitude-triangle w aw)))
                 (t4b (begin (dk-have! (list '= (list '+ w aw) aj) (lambda () (crs))) (dk-rewrite-h! t4 (list '+ w aw) aj))))
            (c6-ineq*! t4b ne2 k1 (list '<= 0 mw))))))
    (c6-cite! 'series-eventually-dominated-converges gs h2 mv)
    (c6-cite! 'series-unshift-abs-converges nv a)
    (dk-ass!)))
(qed 'prop-6-8-backward)

;;; PROPOSITION 6.8.  sum |a_k| < oo  iff  for some N, 1 + a_k is in dom log for k >= N and
;;; sum_{k >= N} |log(1 + a_k)| < oo   (the tail written as the series k |-> |log(1 + a(N + k))|)
(sp (make-wff (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC))
  (list 'IFF (list 'SERIES-CONVERGES (c6-mag 'c6a_))
    (list 'FORSOME 'c6m_ (list 'AND '(IN c6m_ NN) (list 'AND (c6-guard-from 'c6a_ 'c6m_) (list 'SERIES-CONVERGES (c6-lgs 'c6a_ 'c6m_))))))))))
(let* ((new (c6-steps!)) (a (c6-var new '(FUN NN CC))))
  (dk-iff! (dk-head? 'FORSOME)
    (lambda ()
      (c6-pos-rr! 1/10)
      (let* ((nv (c6-sk! (dk-apply! (c6-cite! 'abs-series-terms-small-eps a) 1/10)))
             (uu (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q nv) (dk-contains? q 1/10))) (dk-asms))))
        (c6-cite! 'prop-6-8-forward nv a)
        (dk-have! (c6-guard-from a nv)
          (lambda () (let* ((nq (c6-steps!)) (q (c6-var nq 'NN)))
                       (dk-apply! uu q) (fact 'fun-apply-type-c a 'NN 'CC q)
                       (dk-split-all! (list (c6-cite! 'cc-log-one-plus-near-zero (list a q)))) (dk-ass!))))
        (ew nv)
        (dk-conj-close! (lambda () (dk-ass!)))))
    (lambda ()
      (let* ((ex (find-first (lambda (q) (dk-head-is? q 'FORSOME)) (dk-asms))) (nv (c6-sk! ex)))
        (c6-cite! 'prop-6-8-backward nv a)
        (dk-ass!)))))
(qed 'prop-6-8)

;;; ---------------------------------------------------------------- finite sums with masks (for the rearrangement)
(define (c6-csps f n) (list 'CC-SERIES-PARTIAL-SUM f n))
(define (c6-csps-typ! f n) (dk-cite! 'cc-series-partial-sum-in-cc n f) (c6-csps f n))
(define (c6-csps-succ! f n)                  ; f in FUN(NN, CC), n in NN: S(f, succ n) == S(f, n) + f(n)
  (c6-csps-typ! f n) (fact 'fun-apply-type-c f 'NN 'CC n)
  (dk-cite! 'cc-series-partial-sum-succ f n))
(define (c6-lt-succ-n! n)                     ; n < succ n
  (c6-nn! n) (fact 'nn-succ-plus-one n) (fact 'nn-succ-closed n)
  (if (not (dk-asm? (list '< n (list 'succ n))))
      (dk-have! (list '< n (list 'succ n)) (lambda () (subst (list '= (list 'succ n) (list '+ n 1))) (dk-ineq!)))))

;;; partial sums of sequences agreeing below n agree
(sp (make-wff '(FORALL c6n_ (IMPLIES (IN c6n_ NN) (FORALL c6f_ (IMPLIES (IN c6f_ (FUN NN CC)) (FORALL c6g_ (IMPLIES (IN c6g_ (FUN NN CC))
  (IMPLIES (FORALL c6j_ (IMPLIES (IN c6j_ NN) (IMPLIES (< c6j_ c6n_) (= (c6f_ c6j_) (c6g_ c6j_)))))
    (= (CC-SERIES-PARTIAL-SUM c6f_ c6n_) (CC-SERIES-PARTIAL-SUM c6g_ c6n_)))))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (fs (c6-vars new '(FUN NN CC))))
      (subst (dk-cite! 'cc-series-partial-sum-zero (car fs))) (subst (dk-cite! 'cc-series-partial-sum-zero (cadr fs)))
      (fact 'cc-zero-in) (rfl)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (fs (c6-vars new '(FUN NN CC)))
           (f (find-first (lambda (v) (c6-has-sub? (cadr (dk-goal)) v)) fs)) (g (find-first (lambda (v) (not (eq? v f))) fs))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'CC-SERIES-PARTIAL-SUM))) new))
           (hh (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (not (dk-contains? q 'CC-SERIES-PARTIAL-SUM)))) new))
           (h2 (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ n) (list '= (list f 'c6j_) (list g 'c6j_)))))))
      (dk-have! h2 (lambda () (let* ((nj (c6-steps!)) (j (c6-var nj 'NN))) (c6-lt-succ! j n) (dk-apply! hh j) (dk-ass!))))
      (c6-lt-succ-n! n) (dk-apply! hh n)
      (subst (c6-csps-succ! f n)) (subst (c6-csps-succ! g n))
      (subst (dk-apply! ih f g))
      (subst (list '= (list f n) (list g n)))
      (fact 'fun-apply-type-c g 'NN 'CC n) (c6-csps-typ! g n)
      (dk-close-if! (lambda () #t) (lambda () (rfl))))))
(qed 'csps-agree-below)

(define (c6-sumf f g) (list 'VNB-LAMBDA 'c6k_ 'NN (list '+ (list f 'c6k_) (list g 'c6k_))))
(define (c6-delta sv cv) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'IF (list '= 'c6k_ sv) cv 0)))
(define (c6-trunc a nv) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'IF (list '< 'c6k_ nv) (list a 'c6k_) 0)))
(define (c6-if! ift k)                       ; resolve (IF c a b): the side the context decides, else split
  (let ((c (cadr ift)))
    (cond ((dk-asm? c) (dk-if-branch! #t ift #f (lambda () (k #t (caddr ift)))))
          ((dk-asm? (list 'NOT c)) (dk-if-branch! #f ift #f (lambda () (k #f (cadddr ift)))))
          (#t (dk-case-if! ift k)))))
(define (c6-if-cc! ift)                       ; (IN IFT CC) for an IF term whose branches are typed CC
  (let ((goal (list 'IN ift 'CC)))
    (if (not (dk-asm? goal))
        (dk-have! goal (lambda () (fact 'cc-zero-in) (fact 'cc-one-in) (c6-if! ift (lambda (tr v) (dk-ass!))))))
    goal))

;;; partial sums are additive
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6f_ (list 'IMPLIES '(IN c6f_ (FUN NN CC)) (list 'FORALL 'c6g_ (list 'IMPLIES '(IN c6g_ (FUN NN CC))
  (list '= (c6-csps (c6-sumf 'c6f_ 'c6g_) 'c6n_) (list '+ (c6-csps 'c6f_ 'c6n_) (c6-csps 'c6g_ 'c6n_)))))))))))
(define (c6-sumf-typ! f g)
  (c6-lam-typ! (c6-sumf f g) 'CC (lambda (k) (fact 'fun-apply-type-c f 'NN 'CC k) (fact 'fun-apply-type-c g 'NN 'CC k) (c6-cc! (list '+ (list f k) (list g k))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (fs (c6-vars new '(FUN NN CC))) (f (car fs)) (g (cadr fs)))
      (for-each (lambda (h) (subst (dk-cite! 'cc-series-partial-sum-zero h))) (list (c6-sumf f g) f g))
      (fact 'cc-zero-in) (crs)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (fs (c6-vars new '(FUN NN CC)))
           (f (find-first (lambda (v) (c6-has-sub? (caddr (dk-goal)) (list 'CC-SERIES-PARTIAL-SUM v (list 'succ n)))) fs))
           (g (find-first (lambda (v) (not (eq? v f))) fs)) (ih (c6-ih new)) (h (c6-sumf f g)))
      (c6-sumf-typ! f g)
      (subst (c6-csps-succ! h n)) (subst (c6-csps-succ! f n)) (subst (c6-csps-succ! g n))
      (dk-lam-b!)
      (subst (dk-apply! ih f g))
      (crs))))
(qed 'csps-add)

;;; a single-point sequence: sum_{j < K} [j = s] c  is  c when s < K and 0 when K <= s
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6s_ (list 'IMPLIES '(IN c6s_ NN) (list 'FORALL 'c6c_ (list 'IMPLIES '(IN c6c_ CC)
  (list 'AND (list 'IMPLIES '(< c6s_ c6n_) (list '= (c6-csps (c6-delta 'c6s_ 'c6c_) 'c6n_) 'c6c_))
             (list 'IMPLIES '(<= c6n_ c6s_) (list '= (c6-csps (c6-delta 'c6s_ 'c6c_) 'c6n_) 0)))))))))))
(define (c6-delta-typ! sv cv)
  (c6-lam-typ! (c6-delta sv cv) 'CC (lambda (k) (c6-if-cc! (list 'IF (list '= k sv) cv 0)))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (sv (c6-var new 'NN)) (cv (c6-var new 'CC)))
      (subst (dk-cite! 'cc-series-partial-sum-zero (c6-delta sv cv)))
      (c6-nn! sv) (fact 'nn-zero-le sv)
      (dk-conj-close!
        (lambda ()
          (di)
          (if (dk-asm? (list '< sv 0)) (dk-absurd! (list '< sv 0) (list '<= 0 sv)) (begin (fact 'cc-zero-in) (rfl)))))))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (sv (find-first (lambda (v) (not (eq? v n))) (c6-vars new 'NN))) (cv (c6-var new 'CC))
           (ih (c6-ih new)) (d (c6-delta sv cv)) (ift (list 'IF (list '= n sv) cv 0)))
      (c6-delta-typ! sv cv) (c6-nn! n) (c6-nn! sv) (fact 'cc-zero-in)
      (dk-split-all! (list (dk-apply! ih sv cv)))
      (subst (c6-csps-succ! d n))
      (dk-lam-b!)
      (c6-csps-typ! d n)
      (c6-lt-succ-n! n) (fact 'nn-succ-plus-one n) (c6-nn! (list 'succ n))
      (let* ((sn (c6-csps d n)) (i1 (list 'IMPLIES (list '< sv n) (list '= sn cv))) (i2 (list 'IMPLIES (list '<= n sv) (list '= sn 0))))
        (c6-csps-typ! d n)
        (c6-if! ift
          (lambda (tr v)
            (dk-conj-close!
              (lambda ()
                (di)
                (cond
                  ((and tr (dk-asm? (list '< sv (list 'succ n))))
                   (dk-have! (list '<= n sv) (lambda () (dk-ineq! (list '= n sv))))
                   (detach! (dk-ctx-form i2)) (subst (list '= sn 0)) (crs))
                  (tr (dk-absurd! (list '<= (list 'succ n) sv) (list '= n sv) (list '= (list 'succ n) (list '+ n 1))))
                  ((dk-asm? (list '< sv (list 'succ n)))
                   (dk-have! (list 'NOT (list '= sv n))
                     (lambda () (di) (dk-have! (list '= n sv) (lambda () (subst (list '= n sv)) (rfl))) (ai (list 'NOT (list '= n sv)))))
                   (c6-lt-from-le! sv n)
                   (detach! (dk-ctx-form i1)) (subst (list '= sn cv)) (crs))
                  (#t
                   (dk-have! (list '<= n sv) (lambda () (dk-ineq! (list '<= (list 'succ n) sv) (list '= (list 'succ n) (list '+ n 1)))))
                   (detach! (dk-ctx-form i2)) (subst (list '= sn 0)) (crs)))))))))))
(qed 'csps-delta)

;;; truncation: sum_{j < n + p} [j < n] a_j = sum_{j < n} a_j
(define (c6-trunc-typ! a nv)
  (c6-lam-typ! (c6-trunc a nv) 'CC (lambda (k) (fact 'fun-apply-type-c a 'NN 'CC k) (c6-if-cc! (list 'IF (list '< k nv) (list a k) 0)))))
(sp (make-wff (list 'FORALL 'c6p_ (list 'IMPLIES '(IN c6p_ NN) (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC))
  (list '= (c6-csps (c6-trunc 'c6a_ 'c6n_) '(+ c6n_ c6p_)) (c6-csps 'c6a_ 'c6n_))))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-var new 'NN)) (a (c6-var new '(FUN NN CC))) (tr (c6-trunc a n)))
      (fact 'nn-zero-in) (fact 'nn-add-zero n) (subst (list '= (list '+ n 0) n))
      (c6-trunc-typ! a n)
      (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ n) (list '= (list tr 'c6j_) (list a 'c6j_)))))
        (lambda ()
          (let* ((nj (c6-steps!)) (j (c6-var nj 'NN)) (ift (list 'IF (list '< j n) (list a j) 0)))
            (fact 'fun-apply-type-c a 'NN 'CC j) (fact 'cc-zero-in)
            (dk-lam-b!)
            (c6-if! ift (lambda (t v) (if t (rfl) (ai (list 'NOT (list '< j n)))))))))
      (c6-cite! 'csps-agree-below n tr a)
      (dk-ass!)))
  (lambda ()
    (let* ((new (c6-steps!)) (p (c6-succ-var new)) (n (find-first (lambda (v) (not (eq? v p))) (c6-vars new 'NN)))
           (a (c6-var new '(FUN NN CC))) (ih (c6-ih new)) (tr (c6-trunc a n)) (j (c6-nk! n p))
           (ift (list 'IF (list '< j n) (list a j) 0)))
      (c6-trunc-typ! a n) (fact 'fun-apply-type-c a 'NN 'CC j) (fact 'cc-zero-in)
      (subst (dk-cite! 'nn-add-succ n p))
      (subst (c6-csps-succ! tr j))
      (dk-lam-b!)
      (subst (dk-apply! ih n a))
      (c6-csps-typ! a n)
      (c6-if! ift
        (lambda (t v) (if t (dk-absurd! (list '< j n) (list '<= n j)) (crs)))))))
(qed 'csps-trunc)

;;; ---------------------------------------------------------------- the mask identity
(define (c6-in-img sg m j) (list 'FORSOME 'c6t_ (list 'AND '(IN c6t_ NN) (list 'AND (list '< 'c6t_ m) (list '= (list sg 'c6t_) j)))))
(define (c6-mask a sg m) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'IF (c6-in-img sg m 'c6k_) (list a 'c6k_) 0)))
(define (c6-inj sg) (list 'FORALL 'c6u_ (list 'IMPLIES '(IN c6u_ NN) (list 'FORALL 'c6v_ (list 'IMPLIES '(IN c6v_ NN)
                      (list 'IMPLIES (list '= (list sg 'c6u_) (list sg 'c6v_)) '(= c6u_ c6v_)))))))
(define (c6-comp a sg) (list 'VNB-LAMBDA 'c6k_ 'NN (list a (list sg 'c6k_))))
(define (c6-below sg m kv) (list 'FORALL 'c6u_ (list 'IMPLIES '(IN c6u_ NN) (list 'IMPLIES (list '< 'c6u_ m) (list '< (list sg 'c6u_) kv)))))
(define (c6-mask-typ! a sg m)
  (c6-lam-typ! (c6-mask a sg m) 'CC (lambda (k) (fact 'fun-apply-type-c a 'NN 'CC k) (c6-if-cc! (list 'IF (c6-in-img sg m k) (list a k) 0)))))
(define (c6-comp-typ! a sg)
  (c6-lam-typ! (c6-comp a sg) 'CC (lambda (k) (fact 'fun-apply-type-c sg 'NN 'NN k) (fact 'fun-apply-type-c a 'NN 'CC (list sg k)))))

;;; for an injective sigma with sigma(k) < K for k < m:  sum_{k < m} a_sigma(k) = sum_{j < K} [j in sigma[0, m)] a_j
(sp (make-wff (list 'FORALL 'c6m_ (list 'IMPLIES '(IN c6m_ NN) (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN)
  (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC)) (list 'FORALL 'c6g_ (list 'IMPLIES '(IN c6g_ (FUN NN NN))
    (list 'IMPLIES (c6-inj 'c6g_) (list 'IMPLIES (c6-below 'c6g_ 'c6m_ 'c6n_)
      (list '= (c6-csps (c6-comp 'c6a_ 'c6g_) 'c6m_) (c6-csps (c6-mask 'c6a_ 'c6g_ 'c6m_) 'c6n_))))))))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (kv (c6-var new 'NN)) (a (c6-var new '(FUN NN CC))) (sg (c6-var new '(FUN NN NN)))
           (mk (c6-mask a sg 0)) (dl (c6-delta kv 0)))
      (fact 'cc-zero-in) (c6-nn! kv)
      (subst (dk-cite! 'cc-series-partial-sum-zero (c6-comp a sg)))
      (c6-mask-typ! a sg 0) (c6-delta-typ! kv 0)
      (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ kv) (list '= (list mk 'c6j_) (list dl 'c6j_)))))
        (lambda ()
          (let* ((nj (c6-steps!)) (j (c6-var nj 'NN)))
            (fact 'fun-apply-type-c a 'NN 'CC j) (c6-nn! j)
            (dk-lam-b!)
            (dk-have! (list 'NOT (c6-in-img sg 0 j))
              (lambda () (di) (let ((t (c6-sk! (c6-in-img sg 0 j)))) (c6-nn! t) (fact 'nn-zero-le t) (dk-absurd! (list '< t 0) (list '<= 0 t)))))
            (dk-have! (list 'NOT (list '= j kv)) (lambda () (dk-ne! j kv (list '< j kv)) (dk-ass!)))
            (c6-if! (list 'IF (c6-in-img sg 0 j) (list a j) 0)
              (lambda (t1 v1) (c6-if! (list 'IF (list '= j kv) 0 0) (lambda (t2 v2) (rfl))))))))
      (subst (c6-cite! 'csps-agree-below kv mk dl))
      (dk-have! (list '<= kv kv) (lambda () (dk-ineq!)))
      (let ((de (c6-cite! 'csps-delta kv kv 0)))
        (dk-split-all! (list de))
        (detach! (dk-ctx-form (list 'IMPLIES (list '<= kv kv) (list '= (c6-csps dl kv) 0))))
        (dk-close-if! (lambda () (subst (list '= (c6-csps dl kv) 0))) (lambda () (rfl))))))
  (lambda ()
    (let* ((new (c6-steps!)) (m (c6-succ-var new)) (kv (find-first (lambda (v) (not (eq? v m))) (c6-vars new 'NN)))
           (a (c6-var new '(FUN NN CC))) (sg (c6-var new '(FUN NN NN)))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'CC-SERIES-PARTIAL-SUM))) new))
           (inj (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'c6v_))) new))
           (bl (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q kv) (not (dk-contains? q 'CC-SERIES-PARTIAL-SUM)))) new))
           (sm (list sg m)) (asm (list a sm)) (m1 (list 'succ m))
           (mk0 (c6-mask a sg m)) (mk1 (c6-mask a sg m1)) (dl (c6-delta sm asm)) (sf (c6-sumf mk0 dl)))
      (fact 'cc-zero-in) (c6-nn! m) (c6-nn! kv) (c6-lt-succ-n! m) (fact 'nn-succ-closed m) (fact 'nn-succ-plus-one m)
      (fact 'fun-apply-type-c sg 'NN 'NN m) (fact 'fun-apply-type-c a 'NN 'CC sm) (c6-nn! sm)
      (c6-comp-typ! a sg) (c6-mask-typ! a sg m) (c6-mask-typ! a sg m1) (c6-delta-typ! sm asm) (c6-sumf-typ! mk0 dl)
      (dk-have! (c6-below sg m kv) (lambda () (let* ((nu (c6-steps!)) (u (c6-var nu 'NN))) (c6-lt-succ! u m) (dk-apply! bl u) (dk-ass!))))
      (dk-apply! bl m)
      (subst (c6-csps-succ! (c6-comp a sg) m))
      (dk-lam-b!)
      (subst (dk-apply! ih kv a sg))
      ;; pointwise: mask_{m+1} = mask_m + delta
      (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ kv) (list '= (list mk1 'c6j_) (list sf 'c6j_)))))
        (lambda ()
          (let* ((nj (c6-steps!)) (j (c6-var nj 'NN)) (aj (list a j))
                 (i0 (c6-in-img sg m j)) (i1 (c6-in-img sg m1 j)))
            (fact 'fun-apply-type-c a 'NN 'CC j) (c6-nn! j)
            (dk-lam-b!)
            (use-em i0
              (lambda ()                        ; j = sigma(t), t < m
                (dk-have! i1 (lambda () (let ((t (c6-sk! i0))) (c6-lt-succ! t m) (ew t) (dk-conj-close! (lambda () (dk-ass!))))))
                (dk-have! (list 'NOT (list '= j sm))
                  (lambda ()
                    (di)
                    (let ((t (c6-sk! i0)))
                      (c6-nn! t)
                      (dk-have! (list '= (list sg t) sm) (lambda () (subst (list '= (list sg t) j)) (dk-ass!)))
                      (dk-apply! inj t m)
                      (dk-absurd! (list '< t m) (list '= t m)))))
                (c6-if! (list 'IF i1 aj 0) (lambda (x y) (c6-if! (list 'IF i0 aj 0) (lambda (x2 y2) (c6-if! (list 'IF (list '= j sm) asm 0) (lambda (x3 y3) (crs))))))))
              (lambda ()
                (use-em (list '= j sm)
                  (lambda ()
                    (dk-have! i1 (lambda () (ew m) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!) (begin (subst (list '= j sm)) (rfl)))))))
                    (c6-if! (list 'IF i1 aj 0) (lambda (x y) (c6-if! (list 'IF i0 aj 0) (lambda (x2 y2) (c6-if! (list 'IF (list '= j sm) asm 0)
                      (lambda (x3 y3) (subst (list '= j sm)) (crs))))))))
                  (lambda ()
                    (dk-have! (list 'NOT i1)
                      (lambda ()
                        (di)
                        (let ((t (c6-sk! i1)))
                          (c6-nn! t)
                          (use-em (list '= t m)
                            (lambda () (dk-have! (list '= j sm) (lambda () (subst (list '= j (list sg t))) (subst (list '= t m)) (rfl)))
                                       (ai (list 'NOT (list '= j sm))))
                            (lambda () (c6-lt-from-le! t m)
                                       (dk-have! i0 (lambda () (ew t) (dk-conj-close! (lambda () (dk-ass!)))))
                                       (ai (list 'NOT i0)))))))
                    (c6-if! (list 'IF i1 aj 0) (lambda (x y) (c6-if! (list 'IF i0 aj 0) (lambda (x2 y2) (c6-if! (list 'IF (list '= j sm) asm 0) (lambda (x3 y3) (crs))))))))))))))
      (subst (c6-cite! 'csps-agree-below kv mk1 sf))
      (subst (c6-cite! 'csps-add kv mk0 dl))
      (dk-split-all! (list (c6-cite! 'csps-delta kv sm asm)))
      (detach! (dk-ctx-form (list 'IMPLIES (list '< sm kv) (list '= (c6-csps dl kv) asm))))
      (subst (list '= (c6-csps dl kv) asm))
      (c6-csps-typ! mk0 kv)
      (dk-close-if! (lambda () #t) (lambda () (rfl))))))
(qed 'csps-mask)

;;; ---------------------------------------------------------------- the same five laws for real partial sums
(define (c6-rsps f n) (list 'SERIES-PARTIAL-SUM f n))
(define (c6-rsps-typ! f n) (dk-cite! 'series-partial-sum-in-rr n f) (c6-rsps f n))
(define (c6-rsps-succ! f n)                  ; f in FUN(NN, CC), n in NN: S(f, succ n) == S(f, n) + f(n)
  (c6-rsps-typ! f n) (fact 'fun-apply-type-c f 'NN 'RR n)
  (dk-cite! 'series-partial-sum-succ f n))
(define (c6-lt-succ-n-r! n)                     ; n < succ n
  (c6-nn! n) (fact 'nn-succ-plus-one n) (fact 'nn-succ-closed n)
  (if (not (dk-asm? (list '< n (list 'succ n))))
      (dk-have! (list '< n (list 'succ n)) (lambda () (subst (list '= (list 'succ n) (list '+ n 1))) (dk-ineq!)))))

;;; partial sums of sequences agreeing below n agree
(sp (make-wff '(FORALL c6n_ (IMPLIES (IN c6n_ NN) (FORALL c6f_ (IMPLIES (IN c6f_ (FUN NN RR)) (FORALL c6g_ (IMPLIES (IN c6g_ (FUN NN RR))
  (IMPLIES (FORALL c6j_ (IMPLIES (IN c6j_ NN) (IMPLIES (< c6j_ c6n_) (= (c6f_ c6j_) (c6g_ c6j_)))))
    (= (SERIES-PARTIAL-SUM c6f_ c6n_) (SERIES-PARTIAL-SUM c6g_ c6n_)))))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (fs (c6-vars new '(FUN NN RR))))
      (subst (dk-cite! 'series-partial-sum-zero (car fs))) (subst (dk-cite! 'series-partial-sum-zero (cadr fs)))
      (fact 'rr-zero-in) (rfl)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (fs (c6-vars new '(FUN NN RR)))
           (f (find-first (lambda (v) (c6-has-sub? (cadr (dk-goal)) v)) fs)) (g (find-first (lambda (v) (not (eq? v f))) fs))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'SERIES-PARTIAL-SUM))) new))
           (hh (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (not (dk-contains? q 'SERIES-PARTIAL-SUM)))) new))
           (h2 (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ n) (list '= (list f 'c6j_) (list g 'c6j_)))))))
      (dk-have! h2 (lambda () (let* ((nj (c6-steps!)) (j (c6-var nj 'NN))) (c6-lt-succ! j n) (dk-apply! hh j) (dk-ass!))))
      (c6-lt-succ-n! n) (dk-apply! hh n)
      (subst (c6-rsps-succ! f n)) (subst (c6-rsps-succ! g n))
      (subst (dk-apply! ih f g))
      (subst (list '= (list f n) (list g n)))
      (fact 'fun-apply-type-c g 'NN 'RR n) (c6-rsps-typ! g n)
      (dk-close-if! (lambda () #t) (lambda () (rfl))))))
(qed 'rsps-agree-below)

(define (c6-sumf-r f g) (list 'VNB-LAMBDA 'c6k_ 'NN (list '+ (list f 'c6k_) (list g 'c6k_))))
(define (c6-delta-r sv cv) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'IF (list '= 'c6k_ sv) cv 0)))
(define (c6-trunc-r a nv) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'IF (list '< 'c6k_ nv) (list a 'c6k_) 0)))
(define (c6-if-r! ift k)                       ; resolve (IF c a b): the side the context decides, else split
  (let ((c (cadr ift)))
    (cond ((dk-asm? c) (dk-if-branch! #t ift #f (lambda () (k #t (caddr ift)))))
          ((dk-asm? (list 'NOT c)) (dk-if-branch! #f ift #f (lambda () (k #f (cadddr ift)))))
          (#t (dk-case-if! ift k)))))
(define (c6-if-rr! ift)                       ; (IN IFT CC) for an IF term whose branches are typed CC
  (let ((goal (list 'IN ift 'RR)))
    (if (not (dk-asm? goal))
        (dk-have! goal (lambda () (fact 'rr-zero-in) (c6-if! ift (lambda (tr v) (dk-ass!))))))
    goal))

;;; partial sums are additive
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6f_ (list 'IMPLIES '(IN c6f_ (FUN NN RR)) (list 'FORALL 'c6g_ (list 'IMPLIES '(IN c6g_ (FUN NN RR))
  (list '= (c6-rsps (c6-sumf 'c6f_ 'c6g_) 'c6n_) (list '+ (c6-rsps 'c6f_ 'c6n_) (c6-rsps 'c6g_ 'c6n_)))))))))))
(define (c6-sumf-typ-r! f g)
  (c6-lam-typ! (c6-sumf f g) 'RR (lambda (k) (fact 'fun-apply-type-c f 'NN 'RR k) (fact 'fun-apply-type-c g 'NN 'RR k) (c6-rr! (list '+ (list f k) (list g k))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (fs (c6-vars new '(FUN NN RR))) (f (car fs)) (g (cadr fs)))
      (for-each (lambda (h) (subst (dk-cite! 'series-partial-sum-zero h))) (list (c6-sumf f g) f g))
      (fact 'rr-zero-in) (crs)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (fs (c6-vars new '(FUN NN RR)))
           (f (find-first (lambda (v) (c6-has-sub? (caddr (dk-goal)) (list 'SERIES-PARTIAL-SUM v (list 'succ n)))) fs))
           (g (find-first (lambda (v) (not (eq? v f))) fs)) (ih (c6-ih new)) (h (c6-sumf f g)))
      (c6-sumf-typ-r! f g)
      (subst (c6-rsps-succ! h n)) (subst (c6-rsps-succ! f n)) (subst (c6-rsps-succ! g n))
      (dk-lam-b!)
      (subst (dk-apply! ih f g))
      (crs))))
(qed 'rsps-add)

;;; a single-point sequence: sum_{j < K} [j = s] c  is  c when s < K and 0 when K <= s
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6s_ (list 'IMPLIES '(IN c6s_ NN) (list 'FORALL 'c6c_ (list 'IMPLIES '(IN c6c_ RR)
  (list 'AND (list 'IMPLIES '(< c6s_ c6n_) (list '= (c6-rsps (c6-delta 'c6s_ 'c6c_) 'c6n_) 'c6c_))
             (list 'IMPLIES '(<= c6n_ c6s_) (list '= (c6-rsps (c6-delta 'c6s_ 'c6c_) 'c6n_) 0)))))))))))
(define (c6-delta-typ-r! sv cv)
  (c6-lam-typ! (c6-delta sv cv) 'RR (lambda (k) (c6-if-rr! (list 'IF (list '= k sv) cv 0)))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (sv (c6-var new 'NN)) (cv (c6-var new 'RR)))
      (subst (dk-cite! 'series-partial-sum-zero (c6-delta sv cv)))
      (c6-nn! sv) (fact 'nn-zero-le sv)
      (dk-conj-close!
        (lambda ()
          (di)
          (if (dk-asm? (list '< sv 0)) (dk-absurd! (list '< sv 0) (list '<= 0 sv)) (begin (fact 'rr-zero-in) (rfl)))))))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (sv (find-first (lambda (v) (not (eq? v n))) (c6-vars new 'NN))) (cv (c6-var new 'RR))
           (ih (c6-ih new)) (d (c6-delta sv cv)) (ift (list 'IF (list '= n sv) cv 0)))
      (c6-delta-typ-r! sv cv) (c6-nn! n) (c6-nn! sv) (fact 'rr-zero-in)
      (dk-split-all! (list (dk-apply! ih sv cv)))
      (subst (c6-rsps-succ! d n))
      (dk-lam-b!)
      (c6-rsps-typ! d n)
      (c6-lt-succ-n! n) (fact 'nn-succ-plus-one n) (c6-nn! (list 'succ n))
      (let* ((sn (c6-rsps d n)) (i1 (list 'IMPLIES (list '< sv n) (list '= sn cv))) (i2 (list 'IMPLIES (list '<= n sv) (list '= sn 0))))
        (c6-rsps-typ! d n)
        (c6-if! ift
          (lambda (tr v)
            (dk-conj-close!
              (lambda ()
                (di)
                (cond
                  ((and tr (dk-asm? (list '< sv (list 'succ n))))
                   (dk-have! (list '<= n sv) (lambda () (dk-ineq! (list '= n sv))))
                   (detach! (dk-ctx-form i2)) (subst (list '= sn 0)) (crs))
                  (tr (dk-absurd! (list '<= (list 'succ n) sv) (list '= n sv) (list '= (list 'succ n) (list '+ n 1))))
                  ((dk-asm? (list '< sv (list 'succ n)))
                   (dk-have! (list 'NOT (list '= sv n))
                     (lambda () (di) (dk-have! (list '= n sv) (lambda () (subst (list '= n sv)) (rfl))) (ai (list 'NOT (list '= n sv)))))
                   (c6-lt-from-le! sv n)
                   (detach! (dk-ctx-form i1)) (subst (list '= sn cv)) (crs))
                  (#t
                   (dk-have! (list '<= n sv) (lambda () (dk-ineq! (list '<= (list 'succ n) sv) (list '= (list 'succ n) (list '+ n 1)))))
                   (detach! (dk-ctx-form i2)) (subst (list '= sn 0)) (crs)))))))))))
(qed 'rsps-delta)

;;; truncation: sum_{j < n + p} [j < n] a_j = sum_{j < n} a_j
(define (c6-trunc-typ-r! a nv)
  (c6-lam-typ! (c6-trunc a nv) 'RR (lambda (k) (fact 'fun-apply-type-c a 'NN 'RR k) (c6-if-rr! (list 'IF (list '< k nv) (list a k) 0)))))
(sp (make-wff (list 'FORALL 'c6p_ (list 'IMPLIES '(IN c6p_ NN) (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN RR))
  (list '= (c6-rsps (c6-trunc 'c6a_ 'c6n_) '(+ c6n_ c6p_)) (c6-rsps 'c6a_ 'c6n_))))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-var new 'NN)) (a (c6-var new '(FUN NN RR))) (tr (c6-trunc a n)))
      (fact 'nn-zero-in) (fact 'nn-add-zero n) (subst (list '= (list '+ n 0) n))
      (c6-trunc-typ-r! a n)
      (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ n) (list '= (list tr 'c6j_) (list a 'c6j_)))))
        (lambda ()
          (let* ((nj (c6-steps!)) (j (c6-var nj 'NN)) (ift (list 'IF (list '< j n) (list a j) 0)))
            (fact 'fun-apply-type-c a 'NN 'RR j) (fact 'rr-zero-in)
            (dk-lam-b!)
            (c6-if! ift (lambda (t v) (if t (rfl) (ai (list 'NOT (list '< j n)))))))))
      (c6-cite! 'rsps-agree-below n tr a)
      (dk-ass!)))
  (lambda ()
    (let* ((new (c6-steps!)) (p (c6-succ-var new)) (n (find-first (lambda (v) (not (eq? v p))) (c6-vars new 'NN)))
           (a (c6-var new '(FUN NN RR))) (ih (c6-ih new)) (tr (c6-trunc a n)) (j (c6-nk! n p))
           (ift (list 'IF (list '< j n) (list a j) 0)))
      (c6-trunc-typ-r! a n) (fact 'fun-apply-type-c a 'NN 'RR j) (fact 'rr-zero-in)
      (subst (dk-cite! 'nn-add-succ n p))
      (subst (c6-rsps-succ! tr j))
      (dk-lam-b!)
      (subst (dk-apply! ih n a))
      (c6-rsps-typ! a n)
      (c6-if! ift
        (lambda (t v) (if t (dk-absurd! (list '< j n) (list '<= n j)) (crs)))))))
(qed 'rsps-trunc)

;;; ---------------------------------------------------------------- the mask identity
(define (c6-in-img-r sg m j) (list 'FORSOME 'c6t_ (list 'AND '(IN c6t_ NN) (list 'AND (list '< 'c6t_ m) (list '= (list sg 'c6t_) j)))))
(define (c6-mask-r a sg m) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'IF (c6-in-img sg m 'c6k_) (list a 'c6k_) 0)))
(define (c6-inj-r sg) (list 'FORALL 'c6u_ (list 'IMPLIES '(IN c6u_ NN) (list 'FORALL 'c6v_ (list 'IMPLIES '(IN c6v_ NN)
                      (list 'IMPLIES (list '= (list sg 'c6u_) (list sg 'c6v_)) '(= c6u_ c6v_)))))))
(define (c6-comp-r a sg) (list 'VNB-LAMBDA 'c6k_ 'NN (list a (list sg 'c6k_))))
(define (c6-below-r sg m kv) (list 'FORALL 'c6u_ (list 'IMPLIES '(IN c6u_ NN) (list 'IMPLIES (list '< 'c6u_ m) (list '< (list sg 'c6u_) kv)))))
(define (c6-mask-typ-r! a sg m)
  (c6-lam-typ! (c6-mask a sg m) 'RR (lambda (k) (fact 'fun-apply-type-c a 'NN 'RR k) (c6-if-rr! (list 'IF (c6-in-img sg m k) (list a k) 0)))))
(define (c6-comp-typ-r! a sg)
  (c6-lam-typ! (c6-comp a sg) 'RR (lambda (k) (fact 'fun-apply-type-c sg 'NN 'NN k) (fact 'fun-apply-type-c a 'NN 'RR (list sg k)))))

;;; for an injective sigma with sigma(k) < K for k < m:  sum_{k < m} a_sigma(k) = sum_{j < K} [j in sigma[0, m)] a_j
(sp (make-wff (list 'FORALL 'c6m_ (list 'IMPLIES '(IN c6m_ NN) (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN)
  (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN RR)) (list 'FORALL 'c6g_ (list 'IMPLIES '(IN c6g_ (FUN NN NN))
    (list 'IMPLIES (c6-inj 'c6g_) (list 'IMPLIES (c6-below 'c6g_ 'c6m_ 'c6n_)
      (list '= (c6-rsps (c6-comp 'c6a_ 'c6g_) 'c6m_) (c6-rsps (c6-mask 'c6a_ 'c6g_ 'c6m_) 'c6n_))))))))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (kv (c6-var new 'NN)) (a (c6-var new '(FUN NN RR))) (sg (c6-var new '(FUN NN NN)))
           (mk (c6-mask a sg 0)) (dl (c6-delta kv 0)))
      (fact 'rr-zero-in) (c6-nn! kv)
      (subst (dk-cite! 'series-partial-sum-zero (c6-comp a sg)))
      (c6-mask-typ-r! a sg 0) (c6-delta-typ-r! kv 0)
      (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ kv) (list '= (list mk 'c6j_) (list dl 'c6j_)))))
        (lambda ()
          (let* ((nj (c6-steps!)) (j (c6-var nj 'NN)))
            (fact 'fun-apply-type-c a 'NN 'RR j) (c6-nn! j)
            (dk-lam-b!)
            (dk-have! (list 'NOT (c6-in-img sg 0 j))
              (lambda () (di) (let ((t (c6-sk! (c6-in-img sg 0 j)))) (c6-nn! t) (fact 'nn-zero-le t) (dk-absurd! (list '< t 0) (list '<= 0 t)))))
            (dk-have! (list 'NOT (list '= j kv)) (lambda () (dk-ne! j kv (list '< j kv)) (dk-ass!)))
            (c6-if! (list 'IF (c6-in-img sg 0 j) (list a j) 0)
              (lambda (t1 v1) (c6-if! (list 'IF (list '= j kv) 0 0) (lambda (t2 v2) (rfl))))))))
      (subst (c6-cite! 'rsps-agree-below kv mk dl))
      (dk-have! (list '<= kv kv) (lambda () (dk-ineq!)))
      (let ((de (c6-cite! 'rsps-delta kv kv 0)))
        (dk-split-all! (list de))
        (detach! (dk-ctx-form (list 'IMPLIES (list '<= kv kv) (list '= (c6-rsps dl kv) 0))))
        (dk-close-if! (lambda () (subst (list '= (c6-rsps dl kv) 0))) (lambda () (rfl))))))
  (lambda ()
    (let* ((new (c6-steps!)) (m (c6-succ-var new)) (kv (find-first (lambda (v) (not (eq? v m))) (c6-vars new 'NN)))
           (a (c6-var new '(FUN NN RR))) (sg (c6-var new '(FUN NN NN)))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'SERIES-PARTIAL-SUM))) new))
           (inj (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'c6v_))) new))
           (bl (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q kv) (not (dk-contains? q 'SERIES-PARTIAL-SUM)))) new))
           (sm (list sg m)) (asm (list a sm)) (m1 (list 'succ m))
           (mk0 (c6-mask a sg m)) (mk1 (c6-mask a sg m1)) (dl (c6-delta sm asm)) (sf (c6-sumf mk0 dl)))
      (fact 'rr-zero-in) (c6-nn! m) (c6-nn! kv) (c6-lt-succ-n! m) (fact 'nn-succ-closed m) (fact 'nn-succ-plus-one m)
      (fact 'fun-apply-type-c sg 'NN 'NN m) (fact 'fun-apply-type-c a 'NN 'RR sm) (c6-nn! sm)
      (c6-comp-typ-r! a sg) (c6-mask-typ-r! a sg m) (c6-mask-typ-r! a sg m1) (c6-delta-typ-r! sm asm) (c6-sumf-typ-r! mk0 dl)
      (dk-have! (c6-below sg m kv) (lambda () (let* ((nu (c6-steps!)) (u (c6-var nu 'NN))) (c6-lt-succ! u m) (dk-apply! bl u) (dk-ass!))))
      (dk-apply! bl m)
      (subst (c6-rsps-succ! (c6-comp a sg) m))
      (dk-lam-b!)
      (subst (dk-apply! ih kv a sg))
      ;; pointwise: mask_{m+1} = mask_m + delta
      (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ kv) (list '= (list mk1 'c6j_) (list sf 'c6j_)))))
        (lambda ()
          (let* ((nj (c6-steps!)) (j (c6-var nj 'NN)) (aj (list a j))
                 (i0 (c6-in-img sg m j)) (i1 (c6-in-img sg m1 j)))
            (fact 'fun-apply-type-c a 'NN 'RR j) (c6-nn! j)
            (dk-lam-b!)
            (use-em i0
              (lambda ()                        ; j = sigma(t), t < m
                (dk-have! i1 (lambda () (let ((t (c6-sk! i0))) (c6-lt-succ! t m) (ew t) (dk-conj-close! (lambda () (dk-ass!))))))
                (dk-have! (list 'NOT (list '= j sm))
                  (lambda ()
                    (di)
                    (let ((t (c6-sk! i0)))
                      (c6-nn! t)
                      (dk-have! (list '= (list sg t) sm) (lambda () (subst (list '= (list sg t) j)) (dk-ass!)))
                      (dk-apply! inj t m)
                      (dk-absurd! (list '< t m) (list '= t m)))))
                (c6-if! (list 'IF i1 aj 0) (lambda (x y) (c6-if! (list 'IF i0 aj 0) (lambda (x2 y2) (c6-if! (list 'IF (list '= j sm) asm 0) (lambda (x3 y3) (crs))))))))
              (lambda ()
                (use-em (list '= j sm)
                  (lambda ()
                    (dk-have! i1 (lambda () (ew m) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!) (begin (subst (list '= j sm)) (rfl)))))))
                    (c6-if! (list 'IF i1 aj 0) (lambda (x y) (c6-if! (list 'IF i0 aj 0) (lambda (x2 y2) (c6-if! (list 'IF (list '= j sm) asm 0)
                      (lambda (x3 y3) (subst (list '= j sm)) (crs))))))))
                  (lambda ()
                    (dk-have! (list 'NOT i1)
                      (lambda ()
                        (di)
                        (let ((t (c6-sk! i1)))
                          (c6-nn! t)
                          (use-em (list '= t m)
                            (lambda () (dk-have! (list '= j sm) (lambda () (subst (list '= j (list sg t))) (subst (list '= t m)) (rfl)))
                                       (ai (list 'NOT (list '= j sm))))
                            (lambda () (c6-lt-from-le! t m)
                                       (dk-have! i0 (lambda () (ew t) (dk-conj-close! (lambda () (dk-ass!)))))
                                       (ai (list 'NOT i0)))))))
                    (c6-if! (list 'IF i1 aj 0) (lambda (x y) (c6-if! (list 'IF i0 aj 0) (lambda (x2 y2) (c6-if! (list 'IF (list '= j sm) asm 0) (lambda (x3 y3) (crs))))))))))))))
      (subst (c6-cite! 'rsps-agree-below kv mk1 sf))
      (subst (c6-cite! 'rsps-add kv mk0 dl))
      (dk-split-all! (list (c6-cite! 'rsps-delta kv sm asm)))
      (detach! (dk-ctx-form (list 'IMPLIES (list '< sm kv) (list '= (c6-rsps dl kv) asm))))
      (subst (list '= (c6-rsps dl kv) asm))
      (c6-rsps-typ! mk0 kv)
      (dk-close-if! (lambda () #t) (lambda () (rfl))))))
(qed 'rsps-mask)

;;; ---------------------------------------------------------------- the rearrangement theorem
(define (c6-surj sg) (list 'FORALL 'c6w_ (list 'IMPLIES '(IN c6w_ NN) (list 'FORSOME 'c6t_ (list 'AND '(IN c6t_ NN) (list '= (list sg 'c6t_) 'c6w_))))))
(define (c6-covers sg mv nv) (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ nv) (c6-in-img sg mv 'c6j_)))))

;;; a surjection covers [0, n) by an initial segment [0, M)
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6g_ (list 'IMPLIES '(IN c6g_ (FUN NN NN))
  (list 'IMPLIES (c6-surj 'c6g_) (list 'FORSOME 'c6m_ (list 'AND '(IN c6m_ NN) (c6-covers 'c6g_ 'c6m_ 'c6n_))))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (sg (c6-var new '(FUN NN NN))))
      (fact 'nn-zero-in) (ew 0)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (dk-ass!)
            (let* ((nj (c6-steps!)) (j (c6-var nj 'NN))) (c6-nn! j) (fact 'nn-zero-le j) (dk-absurd! (list '< j 0) (list '<= 0 j))))))))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (sg (c6-var new '(FUN NN NN)))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'c6m_))) new))
           (su (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'c6w_))) new))
           (mv (c6-sk! (dk-apply! ih sg)))
           (cv (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q mv))) (dk-asms)))
           (tv (c6-sk! (dk-apply! su n)))
           (m2 (list '+ mv (list 'succ tv))))
      (c6-nn! mv) (c6-nn! tv) (fact 'nn-succ-closed tv) (c6-nn! (list 'succ tv)) (fact 'nn-succ-plus-one tv)
      (c6-and! (list 'IN mv 'NN) (list 'IN (list 'succ tv) 'NN)) (fact 'nn-add-closed mv (list 'succ tv)) (c6-nn! m2)
      (c6-lt-succ-n! n) (dk-cite! 'nn-zero-le mv) (dk-cite! 'nn-zero-le tv)
      (ew m2)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (dk-ass!)
            (let* ((nj (c6-steps!)) (j (c6-var nj 'NN)))
              (c6-nn! j)
              (use-em (list '= j n)
                (lambda ()
                  (ew tv)
                  (dk-conj-close!
                    (lambda ()
                      (cond ((dk-asm? (dk-goal)) (dk-ass!))
                            ((dk-head-is? (dk-goal) '<) (dk-ineq! (list '= (list 'succ tv) (list '+ tv 1)) (list '<= 0 mv)))
                            (#t (subst (list '= j n)) (dk-ass!))))))
                (lambda ()
                  (c6-lt-from-le! j n)
                  (dk-apply! cv j)
                  (let ((t2 (c6-sk! (c6-in-img sg mv j))))
                    (c6-nn! t2)
                    (ew t2)
                    (dk-conj-close!
                      (lambda ()
                        (cond ((dk-asm? (dk-goal)) (dk-ass!))
                              ((dk-head-is? (dk-goal) '<) (dk-ineq! (list '< t2 mv) (list '= (list 'succ tv) (list '+ tv 1)) (list '<= 0 tv)))
                              (#t (dk-ass!)))))))))))))))
(qed 'surj-covers)

;;; finitely many values sigma(0), ..., sigma(m - 1) lie below some K
(sp (make-wff (list 'FORALL 'c6m_ (list 'IMPLIES '(IN c6m_ NN) (list 'FORALL 'c6g_ (list 'IMPLIES '(IN c6g_ (FUN NN NN))
  (list 'FORSOME 'c6n_ (list 'AND '(IN c6n_ NN) (c6-below 'c6g_ 'c6m_ 'c6n_)))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (sg (c6-var new '(FUN NN NN))))
      (fact 'nn-zero-in) (ew 0)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (dk-ass!)
            (let* ((nj (c6-steps!)) (j (c6-var nj 'NN))) (c6-nn! j) (fact 'nn-zero-le j) (dk-absurd! (list '< j 0) (list '<= 0 j))))))))
  (lambda ()
    (let* ((new (c6-steps!)) (m (c6-succ-var new)) (sg (c6-var new '(FUN NN NN))) (ih (c6-ih new))
           (kv (c6-sk! (dk-apply! ih sg)))
           (bl (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q kv))) (dk-asms)))
           (sm (list sg m)) (k2 (list '+ kv (list 'succ sm))))
      (fact 'fun-apply-type-c sg 'NN 'NN m)
      (c6-nn! kv) (c6-nn! sm) (fact 'nn-succ-closed sm) (fact 'nn-succ-plus-one sm) (c6-nn! (list 'succ sm))
      (c6-and! (list 'IN kv 'NN) (list 'IN (list 'succ sm) 'NN)) (fact 'nn-add-closed kv (list 'succ sm)) (c6-nn! k2)
      (dk-cite! 'nn-zero-le kv)
      (ew k2)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (dk-ass!)
            (let* ((nu (c6-steps!)) (u (c6-var nu 'NN)) (su (list sg u)))
              (c6-nn! u) (fact 'fun-apply-type-c sg 'NN 'NN u) (c6-nn! su)
              (use-em (list '= u m)
                (lambda () (subst (list '= u m)) (dk-ineq! (list '= (list 'succ sm) (list '+ sm 1)) (list '<= 0 kv)))
                (lambda () (c6-lt-from-le! u m) (dk-apply! bl u)
                           (fact 'nn-zero-le sm) (dk-ineq! (list '< su kv) (list '= (list 'succ sm) (list '+ sm 1)) (list '<= 0 sm)))))))))))
(qed 'finite-values-bounded)

(define (c6-fn-name! lam cod)                 ; lam in FUN(NN, cod) in context: a symbol v with v = lam; returns v
  (dk-name! lam (list 'FUN 'NN cod)))
(define (c6-at! v lam k)                       ; v = lam (VNB-LAMBDA c6k_ NN body), k in NN: lands (= (v k) body[k])
  (let* ((body (subst-free 'c6k_ k (cadddr lam))) (e (list '= (list v k) body)))
    (if (not (dk-asm? e))
        (dk-have! e (lambda () (subst (list '= v lam)) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
    e))

;;; THE REARRANGEMENT THEOREM, absolute part: sum |a_sigma(k)| < oo for an injective sigma
(define (c6-mcomp a sg) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'magnitude (list a (list sg 'c6k_)))))
(sp (make-wff (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC)) (list 'FORALL 'c6g_ (list 'IMPLIES '(IN c6g_ (FUN NN NN))
  (list 'IMPLIES (c6-inj 'c6g_) (list 'IMPLIES (list 'SERIES-CONVERGES (c6-mag 'c6a_)) (list 'SERIES-CONVERGES (c6-mcomp 'c6a_ 'c6g_))))))))))
(let* ((new (c6-steps!)) (a (c6-var new '(FUN NN CC))) (sg (c6-var new '(FUN NN NN))) (g (c6-mag a)) (am (c6-mcomp a sg)))
  (c6-mag-typ! a) (c6-mag-nonneg! a) (fact 'rr-zero-in)
  (c6-lam-typ! am 'RR (lambda (k) (fact 'fun-apply-type-c sg 'NN 'NN k) (fact 'fun-apply-type-c a 'NN 'CC (list sg k)) (c6-mag! (list a (list sg k)))))
  (dk-have! (c6-nonneg am) (lambda () (let ((i (dk-di-var!))) (fact 'fun-apply-type-c sg 'NN 'NN i) (fact 'fun-apply-type-c a 'NN 'CC (list sg i))
                                                (c6-mag! (list a (list sg i))) (dk-lam-b!) (dk-ass!))))
  (let* ((bv (c6-bound-of! g)) (gv (c6-fn-name! g 'RR)))
    (dk-have! (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list '<= (c6-sps am 'c6i_) bv)))
      (lambda ()
        (let* ((m (dk-di-var!)) (kv (c6-sk! (c6-cite! 'finite-values-bounded m sg)))
               (cg (c6-comp gv sg)) (mk (c6-mask gv sg m)))
          (c6-comp-typ-r! gv sg) (c6-mask-typ-r! gv sg m)
          (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ m) (list '= (list am 'c6j_) (list cg 'c6j_)))))
            (lambda () (let* ((nj (c6-steps!)) (j (c6-var nj 'NN)))
                         (fact 'fun-apply-type-c sg 'NN 'NN j) (fact 'fun-apply-type-c a 'NN 'CC (list sg j)) (c6-mag! (list a (list sg j)))
                         (dk-lam-b!) (c6-at! gv g (list sg j)) (subst (list '= (list gv (list sg j)) (list 'magnitude (list a (list sg j))))) (rfl))))
          (c6-sps-typ! am m) (c6-sps-typ! g kv)
          (let* ((e1 (c6-cite! 'rsps-agree-below m am cg))
                 (e2 (c6-cite! 'rsps-mask m kv gv sg)))
            (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list '<= (list mk 'c6j_) (list gv 'c6j_))))
              (lambda () (let* ((j (dk-di-var!)) (ift (list 'IF (c6-in-img sg m j) (list gv j) 0)))
                           (fact 'fun-apply-type-c a 'NN 'CC j) (c6-mag! (list a j)) (c6-at! gv g j) (fact 'fun-apply-type-c gv 'NN 'RR j)
                           (dk-lam-b!)
                           (c6-if! ift (lambda (t v) (if t (dk-ineq!) (begin (subst (list '= (list gv j) (list 'magnitude (list a j)))) (dk-ass!))))))))
            (let* ((tw (c6-cite! 'series-partial-sum-le-termwise mk gv))
                   (tk (dk-apply! tw kv))
                   (gb (dk-apply! (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q bv) (dk-contains? q 'SERIES-PARTIAL-SUM))) (dk-asms)) kv))
                   (sg2 (dk-rewrite-h! gb g gv)))
              (c6-sps-typ! mk kv) (c6-sps-typ! gv kv) (c6-sps-typ! cg m)
              (dk-ineq! e1 e2 tk sg2))))))
    (c6-cite! 'series-bounded-converges am bv)
    (dk-ass!)))
(qed 'rearrangement-abs)

(define (c6-if-sub t)                          ; the first IF subterm (outermost first)
  (cond ((not (pair? t)) #f)
        ((and (eq? (car t) 'IF) (= (length t) 4)) t)
        ((memq (car t) '(VNB-LAMBDA FORALL FORSOME SEP IOTA)) #f)
        (#t (c6-first-map c6-if-sub (cdr t)))))
(define (c6-if-close! closer)                   ; resolve every IF in the goal (deciding from context or splitting), then CLOSER
  (let ((ift (c6-if-sub (dk-goal))))
    (if ift (c6-if! ift (lambda (t v) (c6-if-close! closer))) (closer))))
;;; THE REARRANGEMENT THEOREM, the value: for a bijection sigma, sum a_sigma(k) = sum a_k
(define (c6-ccl a) (list 'CC-SERIES-LIMIT a))
(define (c6-pseq-s a) (list 'VNB-LAMBDA 'k 'NN (list 'CC-SERIES-PARTIAL-SUM a 'k)))
(sp (make-wff (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC)) (list 'FORALL 'c6g_ (list 'IMPLIES '(IN c6g_ (FUN NN NN))
  (list 'IMPLIES (c6-inj 'c6g_) (list 'IMPLIES (c6-surj 'c6g_) (list 'IMPLIES (list 'SERIES-CONVERGES (c6-mag 'c6a_))
    (list 'CC-SERIES-CONVERGES-TO (c6-comp 'c6a_ 'c6g_) (c6-ccl 'c6a_)))))))))))
(let* ((new (c6-steps!)) (a (c6-var new '(FUN NN CC))) (sg (c6-var new '(FUN NN NN))) (g (c6-mag a)) (lv (c6-ccl a))
       (ca (c6-comp a sg)))
  (c6-mag-typ! a) (c6-mag-nonneg! a) (c6-comp-typ! a sg) (c6-pts!)
  (fact 'rr-zero-in) (fact 'cc-zero-in) (fact 'nn-zero-in)
  (dk-have! (list 'FORALL 'cpsj_ (list 'IMPLIES '(IN cpsj_ NN) (list '= (list g 'cpsj_) (list 'magnitude (list a 'cpsj_)))))
    (lambda () (let ((j (dk-di-var!))) (fact 'fun-apply-type-c a 'NN 'CC j) (c6-mag! (list a j)) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
  (c6-cite! 'cc-series-abs-converges a g)
  (c6-cite! 'cc-series-limit-in-cc a)
  (let* ((lc (c6-cite! 'cc-series-limit-converges-to a))
         (su (begin (mac-h 'CC-SERIES-CONVERGES-TO lc)
                    (mac-h 'CONVERGES-TO (find-first (lambda (q) (and (dk-head-is? q 'CONVERGES-TO) (dk-contains? q lv))) (dk-asms)))
                    (dk-split-all!)
                    (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'POS-RR) (dk-contains? q lv))) (dk-asms))))
         (gv (c6-fn-name! g 'RR)))
    (mac 'CC-SERIES-CONVERGES-TO) (mac 'CONVERGES-TO)
    (dk-conj-close!
      (lambda ()
        (cond
          ((dk-asm? (dk-goal)) (dk-ass!))
          ((and (dk-head-is? (dk-goal) 'IN) (equal? (cadr (dk-goal)) lv)) (subst '(== (PTS CC-MS) CC)) (dk-ass!))
          ((dk-head-is? (dk-goal) 'IN)
           (subst '(== (PTS CC-MS) CC))
           (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (c6-csps-typ! ca k) (dk-ass!))) (lambda () (fact 'nn-is-set) (dk-ass!))))
          (#t
           (let* ((ne (c6-steps!)) (eps (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) ne)))
                  (e2 (dk-halve! eps))
                  (n1 (c6-sk! (dk-apply! (c6-cite! 'series-tail-small g) e2)))
                  (tl1 (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q n1) (dk-contains? q e2))) (dk-asms)))
                  (n2 (c6-sk! (dk-apply! su e2)))
                  (u2 (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q n2) (dk-contains? q 'DIST))) (dk-asms)))
                  (nv (list '+ n1 n2))
                  (mv (begin (c6-and! (list 'IN n1 'NN) (list 'IN n2 'NN)) (fact 'nn-add-closed n1 n2)
                             (c6-sk! (c6-cite! 'surj-covers nv sg))))
                  (cov (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q mv) (dk-contains? q 'c6t_))) (dk-asms))))
             (c6-nn! n1) (c6-nn! n2) (c6-nn! nv) (c6-nn! mv) (fact 'rr-pos-rr-in-rr e2) (fact 'rr-lt-of-pos-rr e2)
             (dk-cite! 'nn-zero-le n1) (dk-cite! 'nn-zero-le n2)
             (ew mv)
             (dk-conj-close!
               (lambda ()
                 (if (dk-asm? (dk-goal)) (dk-ass!)
                   (let* ((nm (c6-steps!)) (m (c6-var nm 'NN))
                          (k0 (c6-sk! (c6-cite! 'finite-values-bounded m sg)))
                          (bl0 (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q k0))) (dk-asms)))
                          (kv (list '+ nv k0))
                          (mk (c6-mask a sg m)) (tr (c6-trunc a nv))
                          (el (list 'VNB-LAMBDA 'c6k_ 'NN (list 'IF (list '< 'c6k_ nv) 0 (list 'IF (c6-in-img sg m 'c6k_) (list a 'c6k_) 0))))
                          (trr (c6-trunc gv nv))
                          (fl (list 'VNB-LAMBDA 'c6k_ 'NN (list 'IF (list '< 'c6k_ nv) 0 (list gv 'c6k_)))))
                     (c6-nn! m) (c6-nn! k0) (dk-cite! 'nn-zero-le k0)
                     (c6-and! (list 'IN nv 'NN) (list 'IN k0 'NN)) (fact 'nn-add-closed nv k0) (c6-nn! kv)
                     (dk-have! (c6-below sg m kv) (lambda () (let* ((nu (c6-steps!)) (u (c6-var nu 'NN))) (dk-apply! bl0 u)
                                                               (fact 'fun-apply-type-c sg 'NN 'NN u) (c6-nn! (list sg u))
                                                               (dk-ineq! (list '< (list sg u) k0) (list '<= 0 n1) (list '<= 0 n2)))))
                     (c6-mask-typ! a sg m) (c6-trunc-typ! a nv) (c6-trunc-typ-r! gv nv)
                     (c6-lam-typ! el 'CC (lambda (k) (fact 'fun-apply-type-c a 'NN 'CC k)
                                           (c6-if-cc! (list 'IF (c6-in-img sg m k) (list a k) 0))
                                           (c6-if-cc! (list 'IF (list '< k nv) 0 (list 'IF (c6-in-img sg m k) (list a k) 0)))))
                     (c6-lam-typ! fl 'RR (lambda (k) (fact 'fun-apply-type-c gv 'NN 'RR k) (c6-if-rr! (list 'IF (list '< k nv) 0 (list gv k)))))
                     (let* ((mkv (c6-fn-name! mk 'CC)) (trv (c6-fn-name! tr 'CC)) (ev (c6-fn-name! el 'CC))
                            (trrv (c6-fn-name! trr 'RR)) (fv (c6-fn-name! fl 'RR))
                            (sf (c6-sumf trv ev)) (sfr (c6-sumf gv gv))
                            (pt! (lambda (j)          ; the values at j
                                   (fact 'fun-apply-type-c a 'NN 'CC j) (c6-nn! j) (c6-mag! (list a j))
                                   (c6-if-cc! (list 'IF (c6-in-img sg m j) (list a j) 0))
                                   (c6-if-cc! (list 'IF (list '< j nv) (list a j) 0))
                                   (c6-if-cc! (list 'IF (list '< j nv) 0 (list 'IF (c6-in-img sg m j) (list a j) 0)))
                                   (c6-at! gv g j) (fact 'fun-apply-type-c gv 'NN 'RR j)
                                   (c6-if-rr! (list 'IF (list '< j nv) (list gv j) 0)) (c6-if-rr! (list 'IF (list '< j nv) 0 (list gv j)))
                                   (c6-at! mkv mk j) (c6-at! trv tr j) (c6-at! ev el j) (c6-at! trrv trr j) (c6-at! fv fl j)
                                   (dk-have! (list 'IMPLIES (list '< j nv) (c6-in-img sg m j))
                                     (lambda () (di) (dk-apply! cov j)
                                       (let ((t (c6-sk! (c6-in-img sg mv j))))
                                         (c6-nn! t) (ew t)
                                         (dk-conj-close! (lambda () (cond ((dk-asm? (dk-goal)) (dk-ass!))
                                                                          ((dk-head-is? (dk-goal) '<) (dk-ineq! (list '< t mv) (list '<= mv m)))
                                                                          (#t (dk-ass!))))))))))
                            (sub-vals! (lambda (j) (for-each (lambda (v) (subst (list '= (list v j) (caddr (dk-ctx-form (c6-at! v (cond ((eq? v mkv) mk) ((eq? v trv) tr) ((eq? v ev) el) ((eq? v trrv) trr) ((eq? v fv) fl) (#t g)) j))))))
                                                             (filter (lambda (v) (dk-contains? (dk-goal) (list v j))) (list mkv trv ev trrv fv gv))))))
                       (c6-sumf-typ! trv ev) (c6-sumf-typ-r! trrv fv)
                       ;; mask_m = trunc + E pointwise
                       (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ kv) (list '= (list mkv 'c6j_) (list sf 'c6j_)))))
                         (lambda ()
                           (let* ((nj (c6-steps!)) (j (c6-var nj 'NN)))
                             (pt! j) (dk-lam-b!) (sub-vals! j)
                             (use-em (list '< j nv)
                               (lambda () (detach! (dk-ctx-form (list 'IMPLIES (list '< j nv) (c6-in-img sg m j)))) (c6-if-close! (lambda () (crs))))
                               (lambda () (c6-if-close! (lambda () (crs))))))))
                       ;; |a| = trunc |a| + F pointwise
                       (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ kv) (list '= (list gv 'c6j_) (list (c6-sumf trrv fv) 'c6j_)))))
                         (lambda ()
                           (let* ((nj (c6-steps!)) (j (c6-var nj 'NN)))
                             (pt! j) (dk-lam-b!) (subst (list '= (list trrv j) (caddr (c6-at! trrv trr j)))) (subst (list '= (list fv j) (caddr (c6-at! fv fl j))))
                             (c6-if-close! (lambda () (crs))))))
                       (let* ((m1 (dk-rewrite-h! (c6-cite! 'csps-mask m kv a sg) mk mkv))
                              (ag (c6-cite! 'csps-agree-below kv mkv sf))
                              (ad (c6-cite! 'csps-add kv trv ev))
                              (t1 (dk-rewrite-h! (c6-cite! 'csps-trunc k0 nv a) tr trv))
                              (sa (c6-csps a nv)) (se (c6-csps ev kv)) (tm (c6-csps ca m))
                              (evm (list 'VNB-LAMBDA 'c6k_ 'NN (list 'magnitude (list ev 'c6k_)))))
                         (c6-csps-typ! a nv) (c6-csps-typ! ev kv) (c6-csps-typ! ca m) (fact 'cc-is-metric-space)
                         (c6-cc! (list '- sa lv)) (c6-mag! (list '- sa lv)) (c6-mag! se)
                         (dk-lam-b!)
                         (subst (c6-cite! 'cc-ms-dist tm lv))
                         (subst m1) (subst ag) (subst ad) (subst t1)
                         (let ((e (list '= (list '- (list '+ sa se) lv) (list '+ se (list '- sa lv)))))
                           (dk-have! e (lambda () (crs))) (subst e))
                         (c6-cc! (list '+ se (list '- sa lv))) (c6-mag! (list '+ se (list '- sa lv)))
                         (c6-and! (list 'IN se 'CC) (list 'IN (list '- sa lv) 'CC))
                         (let* ((dq (c6-cite! 'cc-ms-dist sa lv))
                                (tri (dk-fact! 'cc-magnitude-triangle se (list '- sa lv)))
                                (d2 (begin (dk-have! (list '<= n2 nv) (lambda () (dk-ineq! (list '<= 0 n1))))
                                           (let ((d (dk-apply! u2 nv)))
                                             (dk-lam-b-h! d)
                                             (dk-rewrite-h! (dk-ctx-form (list '<= (list (list 'DIST 'CC-MS) sa lv) e2))
                                                            (list (list 'DIST 'CC-MS) sa lv) (list 'magnitude (list '- sa lv)))))))
                           (c6-lam-typ! evm 'RR (lambda (k) (fact 'fun-apply-type-c ev 'NN 'CC k) (c6-mag! (list ev k))))
                           (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '= (list evm 'k) (list 'magnitude (list ev 'k)))))
                             (lambda () (let ((k (dk-di-var!))) (fact 'fun-apply-type-c ev 'NN 'CC k) (c6-mag! (list ev k)) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
                           (let* ((mle (c6-cite! 'cc-series-partial-sum-magnitude-le kv ev evm))
                                  (twh (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '<= (list evm 'n_) (list fv 'n_))))
                                         (lambda ()
                                           (let ((j (dk-di-var!)))
                                             (pt! j) (fact 'fun-apply-type-c ev 'NN 'CC j) (c6-mag! (list ev j))
                                             (dk-lam-b!) (sub-vals! j) (sub-vals! j)
                                             (fact 'cc-magnitude-zero) (fact 'cc-zero-in) (c6-mag! 0)
                                             (c6-if-close! (lambda () (dk-ineq! '(= (magnitude 0) 0) (list '<= 0 (list 'magnitude (list a j))))))))))
                                  (tw (dk-apply! (c6-cite! 'series-partial-sum-le-termwise evm fv) kv))
                                  (ra (c6-cite! 'rsps-agree-below kv gv (c6-sumf trrv fv)))
                                  (ar (c6-cite! 'rsps-add kv trrv fv))
                                  (rt (dk-rewrite-h! (c6-cite! 'rsps-trunc k0 nv gv) trr trrv))
                                  (tl (begin (dk-have! (list '<= n1 kv) (lambda () (dk-ineq! (list '<= 0 n2) (list '<= 0 k0))))
                                             (dk-rewrite-h! (dk-apply! tl1 kv) g gv)))
                                  (nng (begin (dk-have! (c6-nonneg gv) (lambda () (let ((i (dk-di-var!))) (fact 'fun-apply-type-c a 'NN 'CC i) (c6-mag! (list a i)) (c6-at! gv g i)
                                                                                    (subst (list '= (list gv i) (list 'magnitude (list a i)))) (dk-ass!))))
                                              (dk-have! (list '<= n1 nv) (lambda () (dk-ineq! (list '<= 0 n2))))
                                              (c6-cite! 'series-partial-sum-mono nv n1 gv))))
                             (for-each (lambda (f k) (c6-sps-typ! f k)) (list evm fv gv gv gv trrv (c6-sumf trrv fv)) (list kv kv kv nv n1 kv kv))
                             (fact 'rr-pos-rr-in-rr eps)
                             (dk-ineq! tri d2 mle tw ra ar rt tl nng (list '= (list '+ e2 e2) eps))))))
                       )))))))))))
(qed 'rearrangement-value)

;;; ---------------------------------------------------------------- the same identities for partial PRODUCTS (for 6.9)
(define (c6-pps f n) (list 'PPROD f n))
(define (c6-pps-typ! f n) (dk-cite! 'pprod-in-cc n f) (c6-pps f n))
(define (c6-pps-succ! f n)                  ; f in FUN(NN, CC), n in NN: S(f, succ n) == S(f, n) + f(n)
  (c6-pps-typ! f n) (fact 'fun-apply-type-c f 'NN 'CC n)
  (dk-cite! 'pprod-succ f n))


;;; partial sums of sequences agreeing below n agree
(sp (make-wff '(FORALL c6n_ (IMPLIES (IN c6n_ NN) (FORALL c6f_ (IMPLIES (IN c6f_ (FUN NN CC)) (FORALL c6g_ (IMPLIES (IN c6g_ (FUN NN CC))
  (IMPLIES (FORALL c6j_ (IMPLIES (IN c6j_ NN) (IMPLIES (< c6j_ c6n_) (= (c6f_ c6j_) (c6g_ c6j_)))))
    (= (PPROD c6f_ c6n_) (PPROD c6g_ c6n_)))))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (fs (c6-vars new '(FUN NN CC))))
      (subst (dk-cite! 'pprod-zero (car fs))) (subst (dk-cite! 'pprod-zero (cadr fs)))
      (fact 'cc-one-in) (rfl)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (fs (c6-vars new '(FUN NN CC)))
           (f (find-first (lambda (v) (c6-has-sub? (cadr (dk-goal)) v)) fs)) (g (find-first (lambda (v) (not (eq? v f))) fs))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'PPROD))) new))
           (hh (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (not (dk-contains? q 'PPROD)))) new))
           (h2 (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ n) (list '= (list f 'c6j_) (list g 'c6j_)))))))
      (dk-have! h2 (lambda () (let* ((nj (c6-steps!)) (j (c6-var nj 'NN))) (c6-lt-succ! j n) (dk-apply! hh j) (dk-ass!))))
      (c6-lt-succ-n! n) (dk-apply! hh n)
      (subst (c6-pps-succ! f n)) (subst (c6-pps-succ! g n))
      (subst (dk-apply! ih f g))
      (subst (list '= (list f n) (list g n)))
      (fact 'fun-apply-type-c g 'NN 'CC n) (c6-pps-typ! g n)
      (dk-close-if! (lambda () #t) (lambda () (rfl))))))
(qed 'pps-agree-below)

(define (c6-mulf f g) (list 'VNB-LAMBDA 'c6k_ 'NN (list '* (list f 'c6k_) (list g 'c6k_))))
(define (c6-deltap sv cv) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'IF (list '= 'c6k_ sv) cv 1)))
(define (c6-truncp a nv) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'IF (list '< 'c6k_ nv) (list a 'c6k_) 1)))



;;; partial sums are additive
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6f_ (list 'IMPLIES '(IN c6f_ (FUN NN CC)) (list 'FORALL 'c6g_ (list 'IMPLIES '(IN c6g_ (FUN NN CC))
  (list '= (c6-pps (c6-mulf 'c6f_ 'c6g_) 'c6n_) (list '* (c6-pps 'c6f_ 'c6n_) (c6-pps 'c6g_ 'c6n_)))))))))))
(define (c6-mulf-typ! f g)
  (c6-lam-typ! (c6-mulf f g) 'CC (lambda (k) (fact 'fun-apply-type-c f 'NN 'CC k) (fact 'fun-apply-type-c g 'NN 'CC k) (c6-cc! (list '* (list f k) (list g k))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (fs (c6-vars new '(FUN NN CC))) (f (car fs)) (g (cadr fs)))
      (for-each (lambda (h) (subst (dk-cite! 'pprod-zero h))) (list (c6-mulf f g) f g))
      (fact 'cc-one-in) (crs)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (fs (c6-vars new '(FUN NN CC)))
           (f (find-first (lambda (v) (c6-has-sub? (caddr (dk-goal)) (list 'PPROD v (list 'succ n)))) fs))
           (g (find-first (lambda (v) (not (eq? v f))) fs)) (ih (c6-ih new)) (h (c6-mulf f g)))
      (c6-mulf-typ! f g)
      (subst (c6-pps-succ! h n)) (subst (c6-pps-succ! f n)) (subst (c6-pps-succ! g n))
      (dk-lam-b!)
      (subst (dk-apply! ih f g))
      (crs))))
(qed 'pps-mul)

;;; a single-point sequence: sum_{j < K} [j = s] c  is  c when s < K and 0 when K <= s
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6s_ (list 'IMPLIES '(IN c6s_ NN) (list 'FORALL 'c6c_ (list 'IMPLIES '(IN c6c_ CC)
  (list 'AND (list 'IMPLIES '(< c6s_ c6n_) (list '= (c6-pps (c6-deltap 'c6s_ 'c6c_) 'c6n_) 'c6c_))
             (list 'IMPLIES '(<= c6n_ c6s_) (list '= (c6-pps (c6-deltap 'c6s_ 'c6c_) 'c6n_) 1)))))))))))
(define (c6-deltap-typ! sv cv)
  (c6-lam-typ! (c6-deltap sv cv) 'CC (lambda (k) (c6-if-cc! (list 'IF (list '= k sv) cv 1)))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (sv (c6-var new 'NN)) (cv (c6-var new 'CC)))
      (subst (dk-cite! 'pprod-zero (c6-deltap sv cv)))
      (c6-nn! sv) (fact 'nn-zero-le sv)
      (dk-conj-close!
        (lambda ()
          (di)
          (if (dk-asm? (list '< sv 0)) (dk-absurd! (list '< sv 0) (list '<= 0 sv)) (begin (fact 'cc-one-in) (rfl)))))))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (sv (find-first (lambda (v) (not (eq? v n))) (c6-vars new 'NN))) (cv (c6-var new 'CC))
           (ih (c6-ih new)) (d (c6-deltap sv cv)) (ift (list 'IF (list '= n sv) cv 1)))
      (c6-deltap-typ! sv cv) (c6-nn! n) (c6-nn! sv) (fact 'cc-zero-in) (fact 'cc-one-in)
      (dk-split-all! (list (dk-apply! ih sv cv)))
      (subst (c6-pps-succ! d n))
      (dk-lam-b!)
      (c6-pps-typ! d n)
      (c6-lt-succ-n! n) (fact 'nn-succ-plus-one n) (c6-nn! (list 'succ n))
      (let* ((sn (c6-pps d n)) (i1 (list 'IMPLIES (list '< sv n) (list '= sn cv))) (i2 (list 'IMPLIES (list '<= n sv) (list '= sn 1))))
        (c6-pps-typ! d n)
        (c6-if! ift
          (lambda (tr v)
            (dk-conj-close!
              (lambda ()
                (di)
                (cond
                  ((and tr (dk-asm? (list '< sv (list 'succ n))))
                   (dk-have! (list '<= n sv) (lambda () (dk-ineq! (list '= n sv))))
                   (detach! (dk-ctx-form i2)) (subst (list '= sn 1)) (crs))
                  (tr (dk-absurd! (list '<= (list 'succ n) sv) (list '= n sv) (list '= (list 'succ n) (list '+ n 1))))
                  ((dk-asm? (list '< sv (list 'succ n)))
                   (dk-have! (list 'NOT (list '= sv n))
                     (lambda () (di) (dk-have! (list '= n sv) (lambda () (subst (list '= n sv)) (rfl))) (ai (list 'NOT (list '= n sv)))))
                   (c6-lt-from-le! sv n)
                   (detach! (dk-ctx-form i1)) (subst (list '= sn cv)) (crs))
                  (#t
                   (dk-have! (list '<= n sv) (lambda () (dk-ineq! (list '<= (list 'succ n) sv) (list '= (list 'succ n) (list '+ n 1)))))
                   (detach! (dk-ctx-form i2)) (subst (list '= sn 1)) (crs)))))))))))
(qed 'pps-delta)

;;; truncation: sum_{j < n + p} [j < n] a_j = sum_{j < n} a_j
(define (c6-truncp-typ! a nv)
  (c6-lam-typ! (c6-truncp a nv) 'CC (lambda (k) (fact 'fun-apply-type-c a 'NN 'CC k) (c6-if-cc! (list 'IF (list '< k nv) (list a k) 1)))))
(sp (make-wff (list 'FORALL 'c6p_ (list 'IMPLIES '(IN c6p_ NN) (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC))
  (list '= (c6-pps (c6-truncp 'c6a_ 'c6n_) '(+ c6n_ c6p_)) (c6-pps 'c6a_ 'c6n_))))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-var new 'NN)) (a (c6-var new '(FUN NN CC))) (tr (c6-truncp a n)))
      (fact 'nn-zero-in) (fact 'nn-add-zero n) (subst (list '= (list '+ n 0) n))
      (c6-truncp-typ! a n)
      (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ n) (list '= (list tr 'c6j_) (list a 'c6j_)))))
        (lambda ()
          (let* ((nj (c6-steps!)) (j (c6-var nj 'NN)) (ift (list 'IF (list '< j n) (list a j) 1)))
            (fact 'fun-apply-type-c a 'NN 'CC j) (fact 'cc-zero-in) (fact 'cc-one-in)
            (dk-lam-b!)
            (c6-if! ift (lambda (t v) (if t (rfl) (ai (list 'NOT (list '< j n)))))))))
      (c6-cite! 'pps-agree-below n tr a)
      (dk-ass!)))
  (lambda ()
    (let* ((new (c6-steps!)) (p (c6-succ-var new)) (n (find-first (lambda (v) (not (eq? v p))) (c6-vars new 'NN)))
           (a (c6-var new '(FUN NN CC))) (ih (c6-ih new)) (tr (c6-truncp a n)) (j (c6-nk! n p))
           (ift (list 'IF (list '< j n) (list a j) 1)))
      (c6-truncp-typ! a n) (fact 'fun-apply-type-c a 'NN 'CC j) (fact 'cc-zero-in) (fact 'cc-one-in)
      (subst (dk-cite! 'nn-add-succ n p))
      (subst (c6-pps-succ! tr j))
      (dk-lam-b!)
      (subst (dk-apply! ih n a))
      (c6-pps-typ! a n)
      (c6-if! ift
        (lambda (t v) (if t (dk-absurd! (list '< j n) (list '<= n j)) (crs)))))))
(qed 'pps-trunc)

;;; ---------------------------------------------------------------- the mask identity

(define (c6-maskp a sg m) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'IF (c6-in-img sg m 'c6k_) (list a 'c6k_) 1)))



(define (c6-maskp-typ! a sg m)
  (c6-lam-typ! (c6-maskp a sg m) 'CC (lambda (k) (fact 'fun-apply-type-c a 'NN 'CC k) (c6-if-cc! (list 'IF (c6-in-img sg m k) (list a k) 1)))))


;;; for an injective sigma with sigma(k) < K for k < m:  sum_{k < m} a_sigma(k) = sum_{j < K} [j in sigma[0, m)] a_j
(sp (make-wff (list 'FORALL 'c6m_ (list 'IMPLIES '(IN c6m_ NN) (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN)
  (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC)) (list 'FORALL 'c6g_ (list 'IMPLIES '(IN c6g_ (FUN NN NN))
    (list 'IMPLIES (c6-inj 'c6g_) (list 'IMPLIES (c6-below 'c6g_ 'c6m_ 'c6n_)
      (list '= (c6-pps (c6-comp 'c6a_ 'c6g_) 'c6m_) (c6-pps (c6-maskp 'c6a_ 'c6g_ 'c6m_) 'c6n_))))))))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (kv (c6-var new 'NN)) (a (c6-var new '(FUN NN CC))) (sg (c6-var new '(FUN NN NN)))
           (mk (c6-maskp a sg 0)) (dl (c6-deltap kv 1)))
      (fact 'cc-zero-in) (fact 'cc-one-in) (c6-nn! kv)
      (subst (dk-cite! 'pprod-zero (c6-comp a sg)))
      (c6-maskp-typ! a sg 0) (c6-deltap-typ! kv 1)
      (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ kv) (list '= (list mk 'c6j_) (list dl 'c6j_)))))
        (lambda ()
          (let* ((nj (c6-steps!)) (j (c6-var nj 'NN)))
            (fact 'fun-apply-type-c a 'NN 'CC j) (c6-nn! j)
            (dk-lam-b!)
            (dk-have! (list 'NOT (c6-in-img sg 0 j))
              (lambda () (di) (let ((t (c6-sk! (c6-in-img sg 0 j)))) (c6-nn! t) (fact 'nn-zero-le t) (dk-absurd! (list '< t 0) (list '<= 0 t)))))
            (dk-have! (list 'NOT (list '= j kv)) (lambda () (dk-ne! j kv (list '< j kv)) (dk-ass!)))
            (c6-if! (list 'IF (c6-in-img sg 0 j) (list a j) 1)
              (lambda (t1 v1) (c6-if! (list 'IF (list '= j kv) 1 1) (lambda (t2 v2) (rfl))))))))
      (subst (c6-cite! 'pps-agree-below kv mk dl))
      (dk-have! (list '<= kv kv) (lambda () (dk-ineq!)))
      (let ((de (c6-cite! 'pps-delta kv kv 1)))
        (dk-split-all! (list de))
        (detach! (dk-ctx-form (list 'IMPLIES (list '<= kv kv) (list '= (c6-pps dl kv) 1))))
        (dk-close-if! (lambda () (subst (list '= (c6-pps dl kv) 1))) (lambda () (rfl))))))
  (lambda ()
    (let* ((new (c6-steps!)) (m (c6-succ-var new)) (kv (find-first (lambda (v) (not (eq? v m))) (c6-vars new 'NN)))
           (a (c6-var new '(FUN NN CC))) (sg (c6-var new '(FUN NN NN)))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'PPROD))) new))
           (inj (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'c6v_))) new))
           (bl (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q kv) (not (dk-contains? q 'PPROD)))) new))
           (sm (list sg m)) (asm (list a sm)) (m1 (list 'succ m))
           (mk0 (c6-maskp a sg m)) (mk1 (c6-maskp a sg m1)) (dl (c6-deltap sm asm)) (sf (c6-mulf mk0 dl)))
