                                   (dk-have! (list '= (list '* eb a2) (list '* a2 eb)) (lambda () (crs)))
                                   (c6-ineq*! tri mu d2 k3 k4 e6 (list '= (list '* eb a2) (list '* a2 eb)) (list '= (list '+ e2 e2) eps))))))))))))))))))))
(qed 'prod-rearrangement-limit)

;;; COROLLARY 6.9.  If prod (1 + a_k) is absolutely convergent, then for any permutation sigma of NN the
;;; product prod (1 + a_sigma(k)) is absolutely convergent and converges to the same value.
(sp (make-wff (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC)) (list 'FORALL 'c6g_ (list 'IMPLIES '(IN c6g_ (FUN NN NN))
  (list 'IMPLIES (c6-inj 'c6g_) (list 'IMPLIES (c6-surj 'c6g_) (list 'IMPLIES '(PROD-ABS-CONVERGES c6a_)
    (list 'AND (list 'PROD-ABS-CONVERGES (c6-comp 'c6a_ 'c6g_))
      (list 'FORALL 'c6l_ (list 'IMPLIES (list 'PROD-CONVERGES-TO (c6-op 'c6a_) 'c6l_)
                                         (list 'PROD-CONVERGES-TO (c6-op (c6-comp 'c6a_ 'c6g_)) 'c6l_)))))))))))))
(let* ((new (c6-steps!)) (a (c6-var new '(FUN NN CC))) (sg (c6-var new '(FUN NN NN)))
       (pac (find-first (lambda (q) (dk-head-is? q 'PROD-ABS-CONVERGES)) new))
       (b (c6-comp a sg)) (oc (c6-opcomp a sg)))
  (dk-split-all! (dk-landed (lambda () (mac-h 'PROD-ABS-CONVERGES pac))))
  (c6-comp-typ! a sg) (c6-pts!) (fact 'cc-one-in)
  (c6-cite! 'rearrangement-abs a sg)
  (dk-have! (list 'SERIES-CONVERGES (c6-mag b)) (lambda () (dk-lam-b!) (dk-ass!)))
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'PROD-ABS-CONVERGES)
          (begin (mac 'PROD-ABS-CONVERGES) (dk-conj-close! (lambda () (dk-ass!))))
          (let* ((nl (c6-steps!)) (pc (find-first (lambda (q) (dk-head-is? q 'PROD-CONVERGES-TO)) nl)) (lv (caddr pc))
                 (l2 (c6-sk! (c6-cite! 'prod-abs-converges-exists b)))
                 (pc2 (list 'PROD-CONVERGES-TO (c6-op b) l2)))
            (c6-op-typ! b)
            (let* ((cv2 (c6-cite! 'prod-partial-converges (c6-op b) l2))
                   (cv1 (c6-cite! 'prod-rearrangement-limit a sg lv)))
              (dk-lam-b-h! cv2)
              (c6-lam-typ! (c6-ppseq oc) 'CC (lambda (k) (c6-lam-typ! oc 'CC (lambda (j) (fact 'fun-apply-type-c sg 'NN 'NN j) (fact 'fun-apply-type-c a 'NN 'CC (list sg j)) (c6-cc! (list '+ 1 (list a (list sg j))))))
                                                          (dk-cite! 'pprod-in-cc k oc)))
              (let ((c2 (list 'CONVERGES-TO 'CC-MS (c6-ppseq oc) l2)) (c1 (list 'CONVERGES-TO 'CC-MS (c6-ppseq oc) lv)))
                (dk-have! (list 'IN l2 'CC) (lambda () (dk-split-all! (dk-landed (lambda () (mac-h 'CONVERGES-TO (dk-ctx-form c2))))) (subst '(== CC (PTS CC-MS))) (dk-ass!)))
                (dk-have! (list 'IN lv 'CC) (lambda () (dk-split-all! (dk-landed (lambda () (mac-h 'CONVERGES-TO (dk-ctx-form c1))))) (subst '(== CC (PTS CC-MS))) (dk-ass!)))
                (c6-cite! 'cc-limit-unique (c6-ppseq oc) l2 lv)
                (dk-rewrite-h! (dk-ctx-form pc2) l2 lv)
                (dk-ass!))))))))
(qed 'corollary-6-9)

;;; ======================================================================
;;; PRODUCTS OF FUNCTIONS (6.10 - 6.17).  X is taken to be an open subset u of C, and "normally
;;; convergent on compact subsets" is read on the exhaustion K_n = CC-EXHAUST(u, n), as in
;;; ca5-series.scm (every compact subset of u lies in some K_n).
;;; ======================================================================







;;; a convergent product has one value
(sp (make-wff '(FORALL c6f_ (IMPLIES (IN c6f_ (FUN NN CC)) (FORALL c6l_ (FORALL c6m_
  (IMPLIES (PROD-CONVERGES-TO c6f_ c6l_) (IMPLIES (PROD-CONVERGES-TO c6f_ c6m_) (= c6l_ c6m_)))))))))
(let* ((new (c6-steps!)) (f (c6-var new '(FUN NN CC)))
       (pcs (filter (lambda (q) (dk-head-is? q 'PROD-CONVERGES-TO)) new)) (l1 (caddr (car pcs))) (l2 (caddr (cadr pcs)))
       (c1 (c6-cite! 'prod-partial-converges f l1)) (c2 (c6-cite! 'prod-partial-converges f l2)))
  (c6-pts!)
  (c6-lam-typ! (c6-ppseq f) 'CC (lambda (k) (dk-cite! 'pprod-in-cc k f)))
  (dk-have! (list 'IN l1 'CC) (lambda () (dk-split-all! (dk-landed (lambda () (mac-h 'CONVERGES-TO (dk-ctx-form c1))))) (subst '(== CC (PTS CC-MS))) (dk-ass!)))
  (dk-have! (list 'IN l2 'CC) (lambda () (dk-split-all! (dk-landed (lambda () (mac-h 'CONVERGES-TO (dk-ctx-form c2))))) (subst '(== CC (PTS CC-MS))) (dk-ass!)))
  (dk-cite! 'cc-limit-unique (c6-ppseq f) l1 l2)
  (if (dk-asm? (dk-goal)) (dk-ass!) (dk-close-if! (lambda () (subst (list '= l1 l2))) (lambda () (rfl)))))
(qed 'prod-value-unique)



(define (c6-famty u f) (list 'IN f (list 'FUN 'NN (list 'FUN u 'CC))))
(define (c6-at-pt f x) (list 'VNB-LAMBDA 'c6k_ 'NN (list (list f 'c6k_) x)))          ; k |-> f_k(x)
(define (c6-sn f xs) (list 'VNB-LAMBDA 'cpsi_ 'NN (list 'CC-SUP-NORM (list f 'cpsi_) xs)))   ; i |-> ||f_i||_xs
(define (c6-fv! f u k y)                        ; f in FUN(NN, FUN(u, CC)), k in NN, y in u: f_k in FUN(u, CC), f_k(y) in CC
  (fact 'fun-apply-type-c f 'NN (list 'FUN u 'CC) k) (fact 'fun-apply-type-c (list f k) u 'CC y))

;;; the value of a convergent product is a complex number (read off the definition)
(define (c6-pv-cc! h lv)
  (let ((goal (list 'IN lv 'CC)))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (mac-h 'PROD-CONVERGES-TO (dk-ctx-form (list 'PROD-CONVERGES-TO h lv)))
            (dk-split-all!)
            (let* ((nv (c6-sk! (find-first (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q 'pcm_))) (dk-asms))))
                   (mv (c6-sk! (find-first (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q 'pcz_))) (dk-asms)))))
              (dk-cite! 'pprod-in-cc nv h) (c6-cc! (list '* (list 'PPROD h nv) mv))
              (subst (list '= lv (list '* (list 'PPROD h nv) mv)))
              (dk-ass!)))))
    goal))
;;; PROD-VALUE is the value of a convergent product, a complex number
(sp (make-wff '(FORALL c6f_ (IMPLIES (IN c6f_ (FUN NN CC)) (IMPLIES (PROD-CONVERGES c6f_)
  (AND (IN (PROD-VALUE c6f_) CC) (PROD-CONVERGES-TO c6f_ (PROD-VALUE c6f_))))))))
(let* ((new (c6-steps!)) (f (c6-var new '(FUN NN CC)))
       (io (list 'IOTA 'pvl_ (list 'AND '(IN pvl_ CC) (list 'PROD-CONVERGES-TO f 'pvl_)))))
  (mac 'PROD-VALUE)
  (let ((lv (c6-sk! (dk-landed-1 (lambda () (mac-h 'PROD-CONVERGES (list 'PROD-CONVERGES f)))))))
    (c6-pv-cc! f lv)
    (for-each
      (lambda (l)
        (dk-focus! l)
        (cond
          ((dk-asm? (dk-goal)) (dk-ass!))
          ((dk-head-is? (dk-goal) 'FORSOME)
           (ew lv)
           (dk-conj-close!
             (lambda ()
               (cond ((dk-asm? (dk-goal)) (dk-ass!))
                     ((dk-head-is? (dk-goal) 'FORALL)
                      (let* ((ny (c6-steps!)) (an (find-first (lambda (q) (dk-head-is? q 'AND)) ny)) (y (cadr (cadr an))))
                        (dk-split-all! (list an))
                        (c6-cite! 'prod-value-unique f y lv)
                        (if (dk-asm? (dk-goal)) (dk-ass!) (dk-close-if! (lambda () (subst (list '= y lv))) (lambda () (rfl))))))
                     (#t (dk-ass!))))))
          (#t (dk-split-all!) (dk-conj-close! (lambda () (dk-ass!))))))
      (dk-opened (lambda () (iota-d io))))))
(qed 'prod-value-spec)

;;; normal convergence on compacta gives absolute convergence at each point
(sp (make-wff (list 'FORALL 'c6u_ (list 'IMPLIES '(IS-OPEN CC-MS c6u_) (list 'FORALL 'c6f_ (list 'IMPLIES (c6-famty 'c6u_ 'c6f_)
  (list 'IMPLIES '(PROD-NORMAL-ON-COMPACTA c6u_ c6f_)
    (list 'FORALL 'c6x_ (list 'IMPLIES '(IN c6x_ c6u_) (list 'SERIES-CONVERGES (c6-mag (c6-at-pt 'c6f_ 'c6x_))))))))))))
(let* ((new (c6-steps!)) (u (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) new)))
       (f (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (c6-op? (caddr q) 'FUN 3) (eq? (cadr (caddr q)) 'NN))) new)))
       (x (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (eq? (caddr q) u))) new)))
       (pn (find-first (lambda (q) (dk-head-is? q 'PROD-NORMAL-ON-COMPACTA)) new))
       (n (c6-sk! (c6-cite! 'cc-exhaust-covers u x)))
       (kn (list 'CC-EXHAUST u n)) (ax (c6-at-pt f x)) (g (c6-mag ax)) (sn (c6-sn f kn)))
  (dk-split-all! (dk-landed (lambda () (mac-h 'PROD-NORMAL-ON-COMPACTA pn))))
  (let ((nc (dk-apply! (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'IS-NORMALLY-CONVERGENT))) (dk-asms)) n)))
    (dk-split-all! (dk-landed (lambda () (mac-h 'IS-NORMALLY-CONVERGENT nc)))))
  (c6-cite! 'cc-exhaust-subset u n)
  (let* ((snr (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'CC-SUP-NORM) (not (dk-contains? q 'SERIES-CONVERGES)))) (dk-asms)))
         (up! (lambda (k)                       ; |f_k(x)| <= ||f_k||_{K_n}, both real
                (c6-fv! f u k x) (c6-mag! (list (list f k) x))
                (dk-have! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y kn) (list 'IN (list (list f k) 'y) 'CC)))
                  (lambda () (let ((y (dk-di-var!))) (fact 'subset-mem-fwd kn u y) (c6-fv! f u k y) (dk-ass!))))
                (fact 'subset-mem-fwd kn u x)
                (dk-apply! snr k)
                (dk-apply! (c6-cite! 'cc-sup-norm-upper (list f k) kn) x))))
    (c6-lam-typ! ax 'CC (lambda (k) (c6-fv! f u k x) (dk-ass!)))
    (c6-lam-typ! g 'RR (lambda (k) (dk-lam-b!) (c6-fv! f u k x) (c6-mag! (list (list f k) x))))
    (dk-have! (c6-nonneg g) (lambda () (let ((i (dk-di-var!))) (c6-fv! f u i x) (c6-mag! (list (list f i) x)) (dk-lam-b!) (dk-ass!))))
    (c6-lam-typ! sn 'RR (lambda (k) (dk-apply! snr k) (dk-ass!)))
    (dk-have! (c6-nonneg sn)
      (lambda () (let* ((k (dk-di-var!)) (up (up! k))) (dk-lam-b!) (dk-ineq! up (list '<= 0 (list 'magnitude (list (list f k) x)))))))
    (fact 'nn-zero-in)
    (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list 'IMPLIES '(<= 0 cpdj_) (list '<= (list g 'cpdj_) (list sn 'cpdj_)))))
      (lambda () (let* ((nk (c6-steps!)) (k (c6-var nk 'NN))) (up! k) (dk-lam-b!) (dk-ass!))))
    (c6-cite! 'series-eventually-dominated-converges g sn 0)
    (dk-ass!)))
(qed 'normal-on-compacta-pointwise)

(define (c6-opx f x) (list 'VNB-LAMBDA 'c6k_ 'NN (list '+ 1 (list (list f 'c6k_) x))))   ; k |-> 1 + f_k(x)
(define (c6-zx f x) (list 'FORSOME 'c6q_ (list 'AND '(IN c6q_ NN) (list '= (list '+ 1 (list (list f 'c6q_) x)) 0))))

;;; PROPOSITION 6.11.  If prod (1 + f_k) is normally convergent on compact subsets of u and x is in u,
;;; the product at x converges, and it is 0 exactly when one of the factors 1 + f_k(x) is 0.
(sp (make-wff (list 'FORALL 'c6u_ (list 'IMPLIES '(IS-OPEN CC-MS c6u_) (list 'FORALL 'c6f_ (list 'IMPLIES (c6-famty 'c6u_ 'c6f_)
  (list 'IMPLIES '(PROD-NORMAL-ON-COMPACTA c6u_ c6f_)
    (list 'FORALL 'c6x_ (list 'IMPLIES '(IN c6x_ c6u_)
      (list 'AND (list 'PROD-CONVERGES (c6-opx 'c6f_ 'c6x_))
                 (list 'IFF (list '= (list 'PROD-VALUE (c6-opx 'c6f_ 'c6x_)) 0) (c6-zx 'c6f_ 'c6x_))))))))))))
(let* ((new (c6-steps!)) (u (caddr (find-first (lambda (q) (dk-head-is? q 'IS-OPEN)) new)))
