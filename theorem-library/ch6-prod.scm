;;; Library: complex-analysis.

;;; ch6-prod.scm -- CH6: infinite products, section 6.1 of the complex analysis notes.
;;; VOCABULARY (to move to a proof-free structure-library file at wiring):
;;;   PPROD(f, n)            the partial product f(0) f(1) ... f(n-1)          (def-by-nn-recursion)
;;;   PROD-CONVERGES-TO(f,L) Definition 6.1: finitely many zero terms (none from N on), the products of
;;;                          the terms from N on converge to a NON-ZERO M, and L = PPROD(f, N) M
;;;   PROD-CONVERGES(f)      some L
;;;   PROD-ABS-CONVERGES(a)  Definition 6.7: prod (1 + a_k) is absolutely convergent iff sum |a_k| < oo
;;; Library: complex-analysis.  Helpers: c6- prefix, local to this file.

;;; ---------------------------------------------------------------- local helpers
;;; KIT-9 link skipping, opt-in per file since 2026-10-29 (this file was developed with it on); guarded for bands that predate it

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (c6-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (c6-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (c6-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (c6-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))
(define (c6-nn! n) (fact 'nn-in-rr n) (fact 'rr-subset-cc n))
(define (c6-has-sub? t u) (or (equal? t u) (and (pair? t) (any-pred (lambda (x) (c6-has-sub? x u)) t))))
(define (c6-induct! base step)               ; after (ni): BASE on the base leaf, STEP on the step leaf
  (let* ((ls (dk-open-leaves))
         (step? (lambda (l) (let ((g (dk-goal-of l)))
                              (and (c6-op? g 'FORALL 3) (c6-op? (caddr g) 'IMPLIES 3)
                                   (c6-op? (cadr (caddr g)) 'IN 3) (eq? (caddr (cadr (caddr g))) 'NN)
                                   (eq? (cadr (cadr (caddr g))) (cadr g))
                                   (c6-has-sub? g (list 'succ (cadr g)))))))
         (b (find-first (lambda (l) (not (step? l))) ls))
         (st (find-first step? ls)))
    (if (not (and b st)) (error "c6-induct!: leaves not found" (map dk-goal-of ls)))
    (dk-focus! b) (base)
    (dk-focus! st) (step)))
(define (c6-steps!)                          ; peel FORALL / IMPLIES; return the landed formulas
  (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
(define (c6-var new cls) (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (c6-vars new cls) (map cadr (filter (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (c6-succ-var new) (let ((vs (c6-vars new 'NN))) (find-first (lambda (v) (c6-has-sub? (dk-goal) (list 'succ v))) vs)))
(define (c6-ih new) (find-first (lambda (q) (c6-op? q 'FORALL 3)) new))

;;; ---------------------------------------------------------------- vocabulary









(define (c6-tl f n) (list 'VNB-LAMBDA 'c6k_ 'NN (list f (list '+ n 'c6k_))))   ; k |-> f(n + k)

;;; ---------------------------------------------------------------- PPROD laws
;;; partial products of complex terms are complex
(sp (make-wff '(FORALL c6n_ (IMPLIES (IN c6n_ NN) (FORALL c6f_ (IMPLIES (IN c6f_ (FUN NN CC)) (IN (PPROD c6f_ c6n_) CC)))))))
(ni)
(c6-induct!
  (lambda () (let ((f (dk-di-var!))) (subst (dk-cite! 'pprod-zero f)) (fact 'cc-one-in) (dk-ass!)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-var new 'NN)) (f (c6-var new '(FUN NN CC))) (ih (c6-ih new)))
      (dk-apply! ih f)
      (fact 'fun-apply-type-c f 'NN 'CC n)
      (subst (dk-cite! 'pprod-succ f n))
      (c6-cc! (list '* (list 'PPROD f n) (list f n)))
      (dk-ass!))))
(qed 'pprod-in-cc)

;;; ... and of real terms real
(sp (make-wff '(FORALL c6n_ (IMPLIES (IN c6n_ NN) (FORALL c6f_ (IMPLIES (IN c6f_ (FUN NN RR)) (IN (PPROD c6f_ c6n_) RR)))))))
(ni)
(c6-induct!
  (lambda () (let ((f (dk-di-var!))) (subst (dk-cite! 'pprod-zero f)) (fact 'rr-one-in) (dk-ass!)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-var new 'NN)) (f (c6-var new '(FUN NN RR))) (ih (c6-ih new)))
      (dk-apply! ih f)
      (fact 'fun-apply-type-c f 'NN 'RR n)
      (subst (dk-cite! 'pprod-succ f n))
      (c6-rr! (list '* (list 'PPROD f n) (list f n)))
      (dk-ass!))))
(qed 'pprod-in-rr)

(define (c6-tl-typ! f n)                     ; f in FUN(NN, CC), n in NN: the tail sequence is in FUN(NN, CC)
  (let ((typ (list 'IN (c6-tl f n) '(FUN NN CC))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let* ((k (dk-di-var!)) (nk (list '+ n k)))
                  (c6-and! (list 'IN n 'NN) (list 'IN k 'NN)) (fact 'nn-add-closed n k)
                  (fact 'fun-apply-type-c f 'NN 'CC nk)
                  (dk-ass!)))
              (lambda () (fact 'nn-is-set) (dk-ass!))))))
    typ))

;;; splitting a partial product: PPROD(f, n + p) = PPROD(f, n) PPROD(k |-> f(n + k), p)
(sp (make-wff (list 'FORALL 'c6p_ (list 'IMPLIES '(IN c6p_ NN) (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN)
  (list 'FORALL 'c6f_ (list 'IMPLIES '(IN c6f_ (FUN NN CC))
    (list '= '(PPROD c6f_ (+ c6n_ c6p_)) (list '* '(PPROD c6f_ c6n_) (list 'PPROD (c6-tl 'c6f_ 'c6n_) 'c6p_)))))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-var new 'NN)) (f (c6-var new '(FUN NN CC))) (tl (c6-tl f n)))
      (fact 'nn-zero-in) (fact 'nn-add-zero n)
      (dk-cite! 'pprod-in-cc n f)
      (subst (list '= (list '+ n 0) n))
      (subst (dk-cite! 'pprod-zero tl))
      (fact 'cc-one-in)
      (crs)))
  (lambda ()
    (let* ((new (c6-steps!)) (vs (c6-vars new 'NN))
           (p (find-first (lambda (v) (c6-has-sub? (dk-goal) (list 'succ v))) vs))
           (n (find-first (lambda (v) (not (eq? v p))) vs))
           (f (c6-var new '(FUN NN CC))) (ih (c6-ih new)) (tl (c6-tl f n)) (np (list '+ n p)))
      (c6-and! (list 'IN n 'NN) (list 'IN p 'NN)) (fact 'nn-add-closed n p)
      (fact 'nn-succ-closed p)
      (c6-tl-typ! f n)
      (dk-cite! 'pprod-in-cc n f) (dk-cite! 'pprod-in-cc np f) (dk-cite! 'pprod-in-cc p tl)
      (fact 'fun-apply-type-c f 'NN 'CC np)
      (subst (dk-cite! 'nn-add-succ n p))
      (subst (dk-cite! 'pprod-succ f np))
      (subst (dk-cite! 'pprod-succ tl p))
      (dk-lam-b!)
      (subst (dk-apply! ih n f))
      (crs))))
(qed 'pprod-split)

(define (c6-mag f) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'magnitude (list f 'c6k_))))   ; k |-> |f(k)|
(define (c6-mag-typ! f)                      ; f in FUN(NN, CC): k |-> |f k| in FUN(NN, RR)
  (let ((typ (list 'IN (c6-mag f) '(FUN NN RR))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (fact 'fun-apply-type-c f 'NN 'CC k)
                  (fact 'cc-magnitude-closed (list f k))
                  (dk-ass!)))
              (lambda () (fact 'nn-is-set) (dk-ass!))))))
    typ))
(define (c6-lt-from-le! j m)                  ; j, m in NN, j < succ m, NOT j = m in context: j < m
  (fact 'nn-succ-closed m) (fact 'nn-succ-closed j)
  (dk-cite! 'nn-lt-succ-le j (list 'succ m))
  (fact 'nn-succ-plus-one j) (fact 'nn-succ-plus-one m)
  (c6-nn! j) (c6-nn! m) (c6-nn! (list 'succ j)) (c6-nn! (list 'succ m))
  (dk-have! (list '<= j m)
    (lambda () (dk-ineq! (list '<= (list 'succ j) (list 'succ m)) (list '= (list 'succ j) (list '+ j 1)) (list '= (list 'succ m) (list '+ m 1)))))
  (dk-have! (list '< j m) (lambda () (mac '<) (dk-conj-close! (lambda () (dk-ass!))))))
(define (c6-lt-succ! j m)                     ; j < m (NN) in context: j < succ m
  (fact 'nn-succ-plus-one m) (c6-nn! j) (c6-nn! m)
  (dk-have! (list '< j (list 'succ m)) (lambda () (subst (list '= (list 'succ m) (list '+ m 1))) (dk-ineq! (list '< j m)))))

;;; |PPROD(f, n)| = PPROD(|f|, n)
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6f_ (list 'IMPLIES '(IN c6f_ (FUN NN CC))
  (list '= '(magnitude (PPROD c6f_ c6n_)) (list 'PPROD (c6-mag 'c6f_) 'c6n_))))))))
(ni)
(c6-induct!
  (lambda ()
    (let ((f (dk-di-var!)))
      (subst (dk-cite! 'pprod-zero f)) (subst (dk-cite! 'pprod-zero (c6-mag f)))
      (fact 'cc-magnitude-one) (dk-ass!)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (f (c6-var new '(FUN NN CC))) (ih (c6-ih new)) (g (c6-mag f))
           (pf (list 'PPROD f n)) (fn (list f n)))
      (c6-mag-typ! f)
      (dk-cite! 'pprod-in-cc n f) (dk-cite! 'pprod-in-rr n g)
      (fact 'fun-apply-type-c f 'NN 'CC n)
      (subst (dk-cite! 'pprod-succ f n))
      (subst (dk-cite! 'pprod-succ g n))
      (dk-lam-b!)
      (c6-and! (list 'IN pf 'CC) (list 'IN fn 'CC))
      (subst (dk-fact! 'cc-magnitude-mul pf fn))
      (subst (dk-apply! ih f))
      (fact 'cc-magnitude-closed fn)
      (crs))))
(qed 'pprod-magnitude)

;;; a partial product of non-zero factors is non-zero
(sp (make-wff '(FORALL c6n_ (IMPLIES (IN c6n_ NN) (FORALL c6f_ (IMPLIES (IN c6f_ (FUN NN CC))
  (IMPLIES (FORALL c6j_ (IMPLIES (IN c6j_ NN) (IMPLIES (< c6j_ c6n_) (NOT (= (c6f_ c6j_) 0)))))
    (NOT (= (PPROD c6f_ c6n_) 0)))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (f (c6-var new '(FUN NN CC))))
      (subst (dk-cite! 'pprod-zero f)) (arith)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (f (c6-var new '(FUN NN CC)))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'PPROD))) new))
           (hh (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (not (dk-contains? q 'PPROD)))) new))
           (h2 (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ n) (list 'NOT (list '= (list f 'c6j_) 0)))))))
      (dk-have! h2 (lambda () (let* ((nj (c6-steps!)) (j (c6-var nj 'NN))) (c6-lt-succ! j n) (dk-apply! hh j) (dk-ass!))))
      (dk-apply! ih f)
      (c6-nn! n)
      (dk-have! (list '< n (list 'succ n)) (lambda () (fact 'nn-succ-plus-one n) (subst (list '= (list 'succ n) (list '+ n 1))) (dk-ineq!)))
      (dk-apply! hh n)
      (dk-cite! 'pprod-in-cc n f) (fact 'fun-apply-type-c f 'NN 'CC n)
      (subst (dk-cite! 'pprod-succ f n))
      (dk-fact! 'cc-mul-nonzero (list 'PPROD f n) (list f n))
      (dk-ass!))))
(qed 'pprod-nonzero)

;;; a partial product with a zero factor is zero
(sp (make-wff '(FORALL c6n_ (IMPLIES (IN c6n_ NN) (FORALL c6f_ (IMPLIES (IN c6f_ (FUN NN CC))
  (FORALL c6j_ (IMPLIES (IN c6j_ NN) (IMPLIES (< c6j_ c6n_) (IMPLIES (= (c6f_ c6j_) 0) (= (PPROD c6f_ c6n_) 0)))))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (j (c6-var new 'NN)))
      (c6-nn! j) (fact 'nn-zero-le j)
      (dk-absurd! (list '< j 0) (list '<= 0 j))))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (f (c6-var new '(FUN NN CC)))
           (j (find-first (lambda (v) (not (eq? v n))) (c6-vars new 'NN))) (ih (c6-ih new)))
      (dk-cite! 'pprod-in-cc n f) (fact 'fun-apply-type-c f 'NN 'CC n)
      (subst (dk-cite! 'pprod-succ f n))
      (use-em (list '= j n)
        (lambda ()
          (dk-have! (list '= (list f n) 0) (lambda () (subst (list '= n j)) (dk-ass!)))
          (subst (list '= (list f n) 0))
          (crs))
        (lambda ()
          (c6-lt-from-le! j n)
          (dk-apply! ih f j)
          (subst (list '= (list 'PPROD f n) 0))
          (crs))))))
(qed 'pprod-zero-factor)

(define (c6-op a) (list 'VNB-LAMBDA 'c6k_ 'NN (list '+ 1 (list a 'c6k_))))                 ; k |-> 1 + a(k)
(define (c6-opr r) (list 'VNB-LAMBDA 'c6k_ 'NN (list '+ 1 (list r 'c6k_))))   ; k |-> 1 + r(k), r real
(define (c6-opm a) (list 'VNB-LAMBDA 'c6k_ 'NN (list '+ 1 (list 'magnitude (list a 'c6k_)))))  ; k |-> 1 + |a(k)|
(define (c6-lam-typ! lam cod typer)          ; (IN lam (FUN NN cod)); TYPER gets the eigenvariable, must ground
  (let ((typ (list 'IN lam (list 'FUN 'NN cod))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda () (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*))) (typer k) (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
              (lambda () (fact 'nn-is-set) (dk-ass!))))))
    typ))
(define (c6-op-typ! a)
  (c6-lam-typ! (c6-op a) 'CC (lambda (k) (fact 'fun-apply-type-c a 'NN 'CC k) (fact 'cc-one-in) (c6-cc! (list '+ 1 (list a k))))))
(define (c6-opm-typ! a)
  (c6-lam-typ! (c6-opm a) 'RR (lambda (k) (fact 'fun-apply-type-c a 'NN 'CC k) (fact 'rr-one-in) (fact 'cc-magnitude-closed (list a k))
                                 (c6-rr! (list '+ 1 (list 'magnitude (list a k)))))))
(define (c6-mag! t) (fact 'cc-magnitude-closed t) (fact 'cc-magnitude-nonneg t) (list 'magnitude t))

;;; |prod (1 + a_k) - 1| <= prod (1 + |a_k|) - 1   (the estimate behind (153))
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC))
  (list '<= (list 'magnitude (list '- (list 'PPROD (c6-op 'c6a_) 'c6n_) 1)) (list '- (list 'PPROD (c6-opm 'c6a_) 'c6n_) 1))))))))
(ni)
(c6-induct!
  (lambda ()
    (let ((a (dk-di-var!)))
      (subst (dk-cite! 'pprod-zero (c6-op a))) (subst (dk-cite! 'pprod-zero (c6-opm a)))
      (fact 'cc-one-in) (fact 'rr-one-in)
      (dk-have! '(= (- 1 1) 0) (lambda () (arith)))
      (subst '(= (- 1 1) 0))
      (fact 'cc-magnitude-zero)
      (subst '(= (magnitude 0) 0))
      (arith)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (a (c6-var new '(FUN NN CC))) (ih (c6-ih new))
           (pp (list 'PPROD (c6-op a) n)) (qq (list 'PPROD (c6-opm a) n)) (an (list a n)) (m (list 'magnitude an))
           (pm1 (list '- pp 1)) (oa (list '+ 1 an)) (xx (list '* pm1 oa)))
      (c6-op-typ! a) (c6-opm-typ! a)
      (fact 'fun-apply-type-c a 'NN 'CC n) (fact 'cc-one-in) (fact 'rr-one-in)
      (dk-cite! 'pprod-in-cc n (c6-op a)) (dk-cite! 'pprod-in-rr n (c6-opm a))
      (c6-cc! oa) (c6-cc! pm1) (c6-cc! xx)
      (c6-cc! (list '+ xx an)) (c6-mag! pm1) (c6-mag! oa) (c6-mag! xx) (c6-mag! an) (c6-mag! (list '+ xx an))
      (c6-rr! (list '- qq 1)) (c6-rr! (list '+ 1 m))
      (dk-apply! ih a)
      (subst (dk-cite! 'pprod-succ (c6-op a) n))
      (subst (dk-cite! 'pprod-succ (c6-opm a) n))
      (dk-lam-b!)
      (let ((e1 (list '= (list '- (list '* pp oa) 1) (list '+ xx an))))
        (dk-have! e1 (lambda () (crs)))
        (subst e1))
      (c6-and! (list 'IN xx 'CC) (list 'IN an 'CC)) (fact 'cc-magnitude-triangle xx an)
      (c6-and! (list 'IN pm1 'CC) (list 'IN oa 'CC)) (fact 'cc-magnitude-mul pm1 oa)
      (c6-and! '(IN 1 CC) (list 'IN an 'CC)) (fact 'cc-magnitude-triangle 1 an) (fact 'cc-magnitude-one)
      (let* ((av (dk-name! (list 'magnitude pm1) 'RR)) (bv (dk-name! (list 'magnitude oa) 'RR))
             (cv (dk-name! (list '- qq 1) 'RR)) (dv (dk-name! (list '+ 1 m) 'RR))
             (mula (dk-rewrite-h! (dk-rewrite-h! (list '= (list 'magnitude xx) (list '* (list 'magnitude pm1) (list 'magnitude oa)))
                                                 (list 'magnitude pm1) av) (list 'magnitude oa) bv))
             (ih2 (dk-rewrite-h! (dk-rewrite-h! (list '<= (list 'magnitude pm1) (list '- qq 1)) (list 'magnitude pm1) av) (list '- qq 1) cv))
             (ob (dk-rewrite-h! (dk-rewrite-h! (list '<= (list 'magnitude oa) (list '+ '(magnitude 1) m)) (list 'magnitude oa) bv) '(magnitude 1) 1))
             (ob2 (dk-rewrite-h! ob (list '+ 1 m) dv)))
        (dk-have! (list '<= 0 bv) (lambda () (subst (list '= bv (list 'magnitude oa))) (dk-ass!)))
        (dk-have! (list '<= 0 av) (lambda () (subst (list '= av (list 'magnitude pm1))) (dk-ass!)))
        (dk-have! (list '<= 0 cv) (lambda () (dk-ineq! ih2 (list '<= 0 av))))
        (let* ((mono1 (dk-cite! 'rr-mul-le-right av cv bv))
              (mono2 (dk-cite! 'rr-mul-le-right bv dv cv))
              (e2 (list '= (list '* qq (list '+ 1 m)) (list '+ (list '* (list '- qq 1) (list '+ 1 m)) (list '+ 1 m)))))
          (dk-have! e2 (lambda () (crs)))
          (let* ((e2b (dk-rewrite-h! (dk-rewrite-h! e2 (list '- qq 1) cv) (list '+ 1 m) dv)))
            (dk-have! (list '= (list '* cv bv) (list '* bv cv)) (lambda () (crs)))
            (dk-have! (list '= (list '* dv cv) (list '* cv dv)) (lambda () (crs)))
            (subst (list '= (list '+ 1 m) dv))
            (c6-rr! (list '* qq dv))
            (let* ((t1 (dk-name! (list 'magnitude (list '+ xx an)) 'RR)) (t2 (dk-name! (list 'magnitude xx) 'RR))
                   (t3 (dk-name! (list '* qq dv) 'RR)) (mv (dk-name! m 'RR))
                   (tri (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (list '<= (list 'magnitude (list '+ xx an)) (list '+ (list 'magnitude xx) m))
                                                                     (list 'magnitude (list '+ xx an)) t1) (list 'magnitude xx) t2) m mv))
                   (mul2 (dk-rewrite-h! mula (list 'magnitude xx) t2))
                   (e2c (dk-rewrite-h! e2b (list '* qq dv) t3))
                   (dm (dk-rewrite-h! (list '= dv (list '+ 1 m)) m mv)))
              (subst (list '= (list 'magnitude (list '+ xx an)) t1))
              (subst (list '= (list '* qq dv) t3))
              (let* ((ab (list '* av bv)) (cb (list '* cv bv)) (bc (list '* bv cv)) (dc (list '* dv cv)) (cd (list '* cv dv))
                     (prs (list ab cb bc dc cd)))
                (for-each c6-rr! prs)
                (let* ((nms (map (lambda (t) (dk-name! t 'RR)) prs))
                       (rw (lambda (f) (let loop ((f f) (ps prs) (ns nms))
                                         (if (null? ps) f
                                             (loop (if (dk-contains? f (car ps)) (dk-rewrite-h! f (car ps) (car ns)) f) (cdr ps) (cdr ns)))))))
                  (dk-ineq! tri (rw mul2) (rw mono1) (rw mono2) (rw (list '= cb bc)) (rw (list '= dc cd)) (rw e2c) dm))))))))))
(qed 'pprod-one-plus-le)

;;; ineq with every product of two non-numeric terms named first (ineq drops a non-linear premise)
(define c6-debug #f)
(define (c6-first-map f l) (cond ((null? l) #f) ((f (car l)) => (lambda (x) x)) (#t (c6-first-map f (cdr l)))))
(define (c6-prod-sub t)
  (cond ((not (pair? t)) #f)
        ((not (memq (car t) '(+ - * < <= = AND))) #f)                ; any other head is an atom for ineq
        (#t (or (c6-first-map c6-prod-sub (cdr t))
                (and (eq? (car t) '*) (= (length t) 3) (not (number? (cadr t))) (not (number? (caddr t))) t)))))
(define (c6-ineq*! . prems)
  (let loop ((prems prems))
    (let ((pt (c6-first-map c6-prod-sub (cons (dk-goal) prems))))
      (if (not pt)
          (begin
            (if c6-debug (for-each (lambda (q) (display ";; C6I ") (display (expression->string q)) (newline)) (cons (dk-goal) prems)))
            (apply dk-ineq! prems))
          (begin
            (c6-rr! pt)
            (let ((v (dk-name! pt 'RR)))
              (if (dk-contains? (dk-goal) pt) (subst (list '= pt v)))
              (loop (map (lambda (f) (if (dk-contains? f pt) (dk-rewrite-h! f pt v) f)) prems))))))))
(define (c6-opr-typ! r)
  (c6-lam-typ! (c6-opr r) 'RR (lambda (k) (fact 'fun-apply-type-c r 'NN 'RR k) (fact 'rr-one-in) (c6-rr! (list '+ 1 (list r k))))))
(define (c6-sps r n) (list 'SERIES-PARTIAL-SUM r n))
(define (c6-sps-succ! r n)                    ; r in FUN(NN, RR), n in NN: SPS(r, succ n) = SPS(r, n) + r(n)
  (fact 'series-partial-sum-in-rr n r) (fact 'fun-apply-type-c r 'NN 'RR n)
  (dk-cite! 'series-partial-sum-succ r n))
(define (c6-nonneg r) (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list '<= 0 (list r 'c6i_)))))

;;; 1 + sum r <= prod (1 + r) <= exp(sum r)   for r >= 0
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6r_ (list 'IMPLIES '(IN c6r_ (FUN NN RR))
  (list 'IMPLIES (c6-nonneg 'c6r_)
    (list 'AND (list '<= (list '+ 1 (c6-sps 'c6r_ 'c6n_)) (list 'PPROD (c6-opr 'c6r_) 'c6n_))
               (list '<= (list 'PPROD (c6-opr 'c6r_) 'c6n_) (list 'R-EXP (c6-sps 'c6r_ 'c6n_)))))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (r (c6-var new '(FUN NN RR))))
      (subst (dk-cite! 'pprod-zero (c6-opr r)))
      (subst (dk-cite! 'series-partial-sum-zero r))
      (fact 'r-exp-zero) (subst '(= (R-EXP 0) 1)) (fact 'rr-one-in)
      (dk-conj-close! (lambda () (dk-ineq!)))))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (r (c6-var new '(FUN NN RR)))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'PPROD))) new))
           (nn (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (not (dk-contains? q 'PPROD)))) new))
           (pp (list 'PPROD (c6-opr r) n)) (ss (c6-sps r n)) (rn (list r n)) (es (list 'R-EXP ss)) (er (list 'R-EXP rn)))
      (c6-opr-typ! r)
      (dk-cite! 'pprod-in-rr n (c6-opr r))
      (dk-apply! ih r) (dk-split-all!)
      (dk-apply! nn n)
      (subst (dk-cite! 'pprod-succ (c6-opr r) n))
      (subst (c6-sps-succ! r n))
      (dk-lam-b!)
      (fact 'r-exp-in-rr ss) (fact 'r-exp-in-rr rn) (fact 'rr-one-in) (fact 'rr-zero-in)
      (dk-cite! 'series-partial-sum-nonneg n r)
      (dk-cite! 'r-exp-ge-one-plus rn)
      (c6-rr! (list '+ 1 rn)) (c6-rr! (list '+ 1 ss))
      (dk-have! (list '<= 0 (list '+ 1 rn)) (lambda () (dk-ineq! (list '<= 0 rn))))
      (dk-have! (list '<= 0 es) (lambda () (dk-ineq! (list '<= (list '+ 1 ss) pp) (list '<= pp es) (list '<= 0 (c6-sps r n)))))
      (let* ((m1 (dk-cite! 'rr-mul-le-right (list '+ 1 ss) pp (list '+ 1 rn)))
             (m2 (dk-cite! 'rr-mul-le-right pp es (list '+ 1 rn)))
             (m3 (dk-cite! 'rr-mul-le-right (list '+ 1 rn) er es))
             (ea (begin (c6-rr! (list '+ ss rn)) (fact 'r-exp-in-rr (list '+ ss rn)) (dk-cite! 'r-exp-add ss rn)))
             (e1 (list '= (list '* (list '+ 1 ss) (list '+ 1 rn)) (list '+ (list '+ 1 (list '+ ss rn)) (list '* ss rn))))
             (e2 (list '= (list '* (list '+ 1 rn) es) (list '* es (list '+ 1 rn))))
             (e3 (list '= (list '* er es) (list '* es er))))
        (dk-have! e1 (lambda () (crs))) (dk-have! e2 (lambda () (crs))) (dk-have! e3 (lambda () (crs)))
        (c6-rr! (list '* ss rn))
        (dk-have! (list '<= 0 (list '* ss rn))
          (lambda () (let ((z (dk-cite! 'rr-mul-le-right 0 ss rn)))
                       (dk-have! (list '= (list '* 0 rn) 0) (lambda () (crs)))
                       (c6-ineq*! z (list '= (list '* 0 rn) 0)))))
        (dk-conj-close!
          (lambda ()
            (if (dk-contains? (cadr (dk-goal)) 'R-EXP)
                (error "c6: unexpected conjunct order")
                (if (dk-contains? (caddr (dk-goal)) 'R-EXP)
                    (c6-ineq*! m2 m3 ea e2 e3)
                    (c6-ineq*! m1 e1 (list '<= 0 (list '* ss rn)))))))))))
(qed 'pprod-exp-bounds)

;;; exp(-2x) <= 1 - x on [0, 1/2]
(sp (make-wff '(FORALL c6x_ (IMPLIES (IN c6x_ RR) (IMPLIES (<= 0 c6x_) (IMPLIES (<= c6x_ 1/2) (<= (R-EXP (* -2 c6x_)) (- 1 c6x_))))))))
(let* ((new (c6-steps!)) (x (c6-var new 'RR))
       (m2x (list '* -2 x)) (p2x (list '* 2 x)) (uu (list 'R-EXP m2x)) (ee (list 'R-EXP p2x)) (omx (list '- 1 x)) (opx (list '+ 1 p2x))
       (omx2 (list '- 1 p2x)))
  (fact 'rr-zero-in) (fact 'rr-one-in)
  (for-each c6-rr! (list m2x p2x omx opx omx2 (list '+ m2x p2x)))
  (for-each (lambda (t) (fact 'r-exp-in-rr t)) (list m2x p2x (list '+ m2x p2x)))
  (fact 'r-exp-pos p2x)
  (let* ((ea (dk-cite! 'r-exp-add m2x p2x))
         (z0 (list '= (list '+ m2x p2x) 0)))
    (dk-have! z0 (lambda () (crs)))
    (fact 'r-exp-zero)
    (let* ((ue (dk-rewrite-h! (dk-rewrite-h! ea (list '+ m2x p2x) 0) '(R-EXP 0) 1))      ; 1 = u E
           (ge (dk-cite! 'r-exp-ge-one-plus p2x)))
      (dk-have! (list '<= 0 omx) (lambda () (dk-ineq! (list '<= x 1/2))))
      (dk-have! (list '<= 0 omx2) (lambda () (dk-ineq! (list '<= x 1/2))))
      (let* ((m1 (dk-cite! 'rr-mul-le-right opx ee omx))
             (m0 (dk-cite! 'rr-mul-le-right 0 x omx2))
             (e1 (list '= (list '* opx omx) (list '+ 1 (list '* x omx2))))
             (e0 (list '= (list '* 0 omx2) 0))
             (ec (list '= (list '* ee omx) (list '* omx ee))))
        (dk-have! e1 (lambda () (crs))) (dk-have! e0 (lambda () (crs))) (dk-have! ec (lambda () (crs)))
        (c6-rr! (list '* uu ee)) (c6-rr! (list '* omx ee))
        (dk-have! (list '<= (list '* uu ee) (list '* omx ee)) (lambda () (c6-ineq*! ue m1 m0 e1 e0 ec)))
        (dk-cite! 'rr-mul-le-cancel-pos uu ee omx)
        (dk-ass!)))))
(qed 'r-exp-neg-two-le)

;;; |prod (1 + a_k)| >= exp(-2 sum |a_k|)   when every |a_k| <= 1/2
(define (c6-small a) (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list '<= (list 'magnitude (list a 'c6i_)) 1/2))))
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC))
  (list 'IMPLIES (c6-small 'c6a_)
    (list '<= (list 'R-EXP (list '* -2 (c6-sps (c6-mag 'c6a_) 'c6n_))) (list 'magnitude (list 'PPROD (c6-op 'c6a_) 'c6n_))))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (a (c6-var new '(FUN NN CC))))
      (subst (dk-cite! 'pprod-zero (c6-op a)))
      (subst (dk-cite! 'series-partial-sum-zero (c6-mag a)))
      (dk-have! '(= (* -2 0) 0) (lambda () (arith)))
      (subst '(= (* -2 0) 0))
      (fact 'r-exp-zero) (subst '(= (R-EXP 0) 1))
      (fact 'cc-magnitude-one) (subst '(= (magnitude 1) 1))
      (fact 'rr-one-in) (dk-ineq!)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (a (c6-var new '(FUN NN CC)))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'PPROD))) new))
           (sm (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (not (dk-contains? q 'PPROD)))) new))
           (g (c6-mag a)) (pp (list 'PPROD (c6-op a) n)) (ss (c6-sps g n)) (an (list a n)) (m (list 'magnitude an))
           (oa (list '+ 1 an)) (ms (list '* -2 ss)) (mm (list '* -2 m)))
      (c6-op-typ! a) (c6-mag-typ! a)
      (dk-cite! 'pprod-in-cc n (c6-op a))
      (fact 'fun-apply-type-c a 'NN 'CC n) (fact 'cc-one-in) (fact 'rr-one-in) (fact 'rr-zero-in)
      (c6-cc! oa) (c6-mag! pp) (c6-mag! an) (c6-mag! oa)
      (dk-apply! ih a) (dk-apply! sm n)
      (subst (dk-cite! 'pprod-succ (c6-op a) n))
      (subst (c6-sps-succ! g n))
      (dk-lam-b!)
      (c6-and! (list 'IN pp 'CC) (list 'IN oa 'CC))
      (subst (dk-fact! 'cc-magnitude-mul pp oa))
      (for-each c6-rr! (list ms mm (list '+ ms mm) (list '- 1 m)))
      (for-each (lambda (t) (fact 'r-exp-in-rr t)) (list ms mm (list '+ ms mm)))
      (fact 'r-exp-pos mm)
      (let ((e (list '= (list '* -2 (list '+ ss m)) (list '+ ms mm))))
        (dk-have! e (lambda () (crs)))
        (subst e))
      (subst (dk-cite! 'r-exp-add ms mm))
      ;; |1 + a| >= 1 - |a|
      (c6-and! (list 'IN oa 'CC) (list 'IN an 'CC))
      (dk-fact! 'cc-magnitude-sub-triangle oa an)
      (dk-have! (list '<= (list '- 1 m) (list 'magnitude oa))
        (lambda ()
          (let ((e1 (list '= (list '- oa an) 1)))
            (dk-have! e1 (lambda () (crs)))
            (fact 'cc-magnitude-one)
            (let ((tr (dk-rewrite-h! (dk-rewrite-h! (list '<= (list 'magnitude (list '- oa an)) (list '+ (list 'magnitude oa) m)) (list '- oa an) 1)
                                     '(magnitude 1) 1)))
              (dk-ineq! tr)))))
      (dk-cite! 'r-exp-neg-two-le m)
      (dk-have! (list '<= 0 (list 'R-EXP mm)) (lambda () (dk-ineq! (list '< 0 (list 'R-EXP mm)))))
      (let* ((rs (list 'R-EXP ms)) (rm (list 'R-EXP mm)) (mp (list 'magnitude pp)) (mo (list 'magnitude oa)) (om (list '- 1 m))
             (k1 (dk-cite! 'rr-mul-le-right rs mp rm))
             (k2 (dk-cite! 'rr-mul-le-right rm om mp))
             (k3 (dk-cite! 'rr-mul-le-right om mo mp))
             (c1 (list '= (list '* rm mp) (list '* mp rm)))
             (c2 (list '= (list '* om mp) (list '* mp om)))
             (c3 (list '= (list '* mo mp) (list '* mp mo))))
        (dk-have! c1 (lambda () (crs))) (dk-have! c2 (lambda () (crs))) (dk-have! c3 (lambda () (crs)))
        (c6-ineq*! k1 k2 k3 c1 c2 c3)))))
(qed 'pprod-lower)

(define (c6-chain-end f) (if (c6-op? f 'IMPLIES 3) (c6-chain-end (caddr f)) f))
(define (c6-cite! . args)                     ; dk-cite! that refuses to return an undetached implication link
  (let ((r (apply dk-cite! args)))
    (cond ((not (c6-op? r 'IMPLIES 3)) r)
          ((dk-asm? (c6-chain-end r)) (dk-ctx-form (c6-chain-end r)))     ; the consequent was already in context
          (#t (error "c6-cite!: the chain stopped at an antecedent not in context" (car args) (expression->string (cadr r)))))))

;;; |PPROD(1 + a, n)| <= PPROD(1 + |a|, n)
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC))
  (list '<= (list 'magnitude (list 'PPROD (c6-op 'c6a_) 'c6n_)) (list 'PPROD (c6-opm 'c6a_) 'c6n_))))))))
(let* ((new (c6-steps!)) (n (c6-var new 'NN)) (a (c6-var new '(FUN NN CC)))
       (pp (list 'PPROD (c6-op a) n)) (qq (list 'PPROD (c6-opm a) n)) (pm1 (list '- pp 1)))
  (c6-op-typ! a) (c6-opm-typ! a)
  (dk-cite! 'pprod-in-cc n (c6-op a)) (dk-cite! 'pprod-in-rr n (c6-opm a))
  (fact 'cc-one-in) (c6-cc! pm1) (c6-mag! pm1) (c6-mag! pp)
  (let ((le (c6-cite! 'pprod-one-plus-le n a)))
    (c6-and! (list 'IN pm1 'CC) '(IN 1 CC))
    (let ((tr (dk-fact! 'cc-magnitude-triangle pm1 1)))
      (dk-have! (list '= (list '+ pm1 1) pp) (lambda () (crs)))
      (fact 'cc-magnitude-one)
      (c6-ineq*! le (dk-rewrite-h! (dk-rewrite-h! tr (list '+ pm1 1) pp) '(magnitude 1) 1)))))
(qed 'pprod-mag-le)

;;; |PPROD(1 + a, n + p) - PPROD(1 + a, n)| <= PPROD(1 + |a|, n + p) - PPROD(1 + |a|, n)
(sp (make-wff (list 'FORALL 'c6p_ (list 'IMPLIES '(IN c6p_ NN) (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN)
  (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC))
    (list '<= (list 'magnitude (list '- (list 'PPROD (c6-op 'c6a_) '(+ c6n_ c6p_)) (list 'PPROD (c6-op 'c6a_) 'c6n_)))
              (list '- (list 'PPROD (c6-opm 'c6a_) '(+ c6n_ c6p_)) (list 'PPROD (c6-opm 'c6a_) 'c6n_)))))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-var new 'NN)) (a (c6-var new '(FUN NN CC))))
      (fact 'nn-zero-in) (fact 'nn-add-zero n) (subst (list '= (list '+ n 0) n))
      (c6-op-typ! a) (c6-opm-typ! a)
      (dk-cite! 'pprod-in-cc n (c6-op a)) (dk-cite! 'pprod-in-rr n (c6-opm a))
      (let ((pp (list 'PPROD (c6-op a) n)))
        (dk-have! (list '= (list '- pp pp) 0) (lambda () (crs)))
        (subst (list '= (list '- pp pp) 0))
        (fact 'cc-magnitude-zero) (subst '(= (magnitude 0) 0))
        (dk-ineq!))))
  (lambda ()
    (let* ((new (c6-steps!)) (p (c6-succ-var new)) (n (find-first (lambda (v) (not (eq? v p))) (c6-vars new 'NN)))
           (a (c6-var new '(FUN NN CC))) (ih (c6-ih new)) (j (list '+ n p))
           (pj (list 'PPROD (c6-op a) j)) (p0 (list 'PPROD (c6-op a) n)) (qj (list 'PPROD (c6-opm a) j)) (q0 (list 'PPROD (c6-opm a) n))
           (b (list a j)) (mb (list 'magnitude b)) (ob (list '+ 1 b)) (dd (list '- pj p0)))
      (c6-and! (list 'IN n 'NN) (list 'IN p 'NN)) (fact 'nn-add-closed n p)
      (c6-op-typ! a) (c6-opm-typ! a)
      (dk-cite! 'pprod-in-cc n (c6-op a)) (dk-cite! 'pprod-in-cc j (c6-op a))
      (dk-cite! 'pprod-in-rr n (c6-opm a)) (dk-cite! 'pprod-in-rr j (c6-opm a))
      (fact 'fun-apply-type-c a 'NN 'CC j) (fact 'cc-one-in) (fact 'rr-one-in) (fact 'rr-zero-in)
      (c6-cc! ob) (c6-cc! dd) (c6-mag! b) (c6-mag! ob) (c6-mag! dd) (c6-mag! p0)
      (dk-apply! ih n a)
      (c6-cite! 'pprod-mag-le n a)
      (subst (dk-cite! 'nn-add-succ n p))
      (subst (dk-cite! 'pprod-succ (c6-op a) j))
      (subst (dk-cite! 'pprod-succ (c6-opm a) j))
      (dk-lam-b!)
      (let* ((x1 (list '* dd ob)) (x2 (list '* p0 b)))
        (c6-cc! x1) (c6-cc! x2) (c6-cc! (list '+ x1 x2)) (c6-mag! x1) (c6-mag! x2) (c6-mag! (list '+ x1 x2))
        (let ((e (list '= (list '- (list '* pj ob) p0) (list '+ x1 x2))))
          (dk-have! e (lambda () (crs)))
          (subst e))
        (c6-and! (list 'IN x1 'CC) (list 'IN x2 'CC))
        (let* ((tr (dk-fact! 'cc-magnitude-triangle x1 x2))
               (m1 (begin (c6-and! (list 'IN dd 'CC) (list 'IN ob 'CC)) (dk-fact! 'cc-magnitude-mul dd ob)))
               (m2 (begin (c6-and! (list 'IN p0 'CC) (list 'IN b 'CC)) (dk-fact! 'cc-magnitude-mul p0 b)))
               (t1 (begin (c6-and! '(IN 1 CC) (list 'IN b 'CC)) (fact 'cc-magnitude-one) (dk-fact! 'cc-magnitude-triangle 1 b)))
               (t1b (dk-rewrite-h! t1 '(magnitude 1) 1))
               (md (list 'magnitude dd)) (mo (list 'magnitude ob)) (mp0 (list 'magnitude p0)) (dq (list '- qj q0)) (om (list '+ 1 mb)))
          (c6-rr! dq) (c6-rr! om)
          (dk-have! (list '<= 0 dq) (lambda () (dk-ineq! (list '<= md dq) (list '<= 0 md))))
          (let* ((k1 (c6-cite! 'rr-mul-le-right md dq mo))
                 (k2 (c6-cite! 'rr-mul-le-right mo om dq))
                 (k3 (c6-cite! 'rr-mul-le-right mp0 q0 mb))
                 (c1 (list '= (list '* dq mo) (list '* mo dq)))
                 (c2 (list '= (list '* om dq) (list '* dq om)))
                 (e2 (list '= (list '- (list '* qj om) q0) (list '+ (list '* dq om) (list '* q0 mb)))))
            (dk-have! c1 (lambda () (crs))) (dk-have! c2 (lambda () (crs))) (dk-have! e2 (lambda () (crs)))
            (c6-ineq*! tr m1 m2 k1 k2 k3 c1 c2 e2)))))))
(qed 'pprod-diff-le)

;;; exp(x) - 1 <= x exp(x) for x >= 0
(sp (make-wff '(FORALL c6x_ (IMPLIES (IN c6x_ RR) (IMPLIES (<= 0 c6x_) (<= (- (R-EXP c6x_) 1) (* c6x_ (R-EXP c6x_))))))))
(let* ((new (c6-steps!)) (x (c6-var new 'RR)) (mx (list '- x)) (ex (list 'R-EXP x)) (emx (list 'R-EXP mx)))
  (fact 'rr-zero-in) (fact 'rr-one-in)
  (c6-rr! mx) (c6-rr! (list '+ mx x)) (c6-rr! (list '- 1 x))
  (fact 'r-exp-in-rr x) (fact 'r-exp-in-rr mx) (fact 'r-exp-in-rr (list '+ mx x)) (fact 'r-exp-pos x)
  (let* ((ea (dk-cite! 'r-exp-add mx x))
         (z0 (list '= (list '+ mx x) 0)))
    (dk-have! z0 (lambda () (crs)))
    (fact 'r-exp-zero)
    (let* ((ue (dk-rewrite-h! (dk-rewrite-h! ea (list '+ mx x) 0) '(R-EXP 0) 1))
           (ge (dk-cite! 'r-exp-ge-one-plus mx)))
      (dk-have! (list '<= 0 ex) (lambda () (dk-ineq! (list '< 0 ex))))
      (dk-have! (list '<= (list '- 1 x) emx) (lambda () (dk-ineq! ge)))
      (let* ((k (c6-cite! 'rr-mul-le-right (list '- 1 x) emx ex))
             (e1 (list '= (list '* (list '- 1 x) ex) (list '- ex (list '* x ex)))))
        (dk-have! e1 (lambda () (crs)))
        (c6-ineq*! ue k e1)))))
(qed 'r-exp-sub-one-le)

;;; PPROD(1 + r, n + p) <= PPROD(1 + r, n) exp(S(n + p) - S(n))   for r >= 0
(sp (make-wff (list 'FORALL 'c6p_ (list 'IMPLIES '(IN c6p_ NN) (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN)
  (list 'FORALL 'c6r_ (list 'IMPLIES '(IN c6r_ (FUN NN RR)) (list 'IMPLIES (c6-nonneg 'c6r_)
    (list '<= (list 'PPROD (c6-opr 'c6r_) '(+ c6n_ c6p_))
              (list '* (list 'PPROD (c6-opr 'c6r_) 'c6n_) (list 'R-EXP (list '- (c6-sps 'c6r_ '(+ c6n_ c6p_)) (c6-sps 'c6r_ 'c6n_))))))))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-var new 'NN)) (r (c6-var new '(FUN NN RR))) (q0 (list 'PPROD (c6-opr r) n)) (s0 (c6-sps r n)))
      (fact 'nn-zero-in) (fact 'nn-add-zero n) (subst (list '= (list '+ n 0) n))
      (c6-opr-typ! r) (dk-cite! 'pprod-in-rr n (c6-opr r)) (fact 'series-partial-sum-in-rr n r)
      (dk-have! (list '= (list '- s0 s0) 0) (lambda () (crs)))
      (subst (list '= (list '- s0 s0) 0))
      (fact 'r-exp-zero) (subst '(= (R-EXP 0) 1))
      (fact 'rr-one-in)
      (dk-have! (list '= (list '* q0 1) q0) (lambda () (crs)))
      (subst (list '= (list '* q0 1) q0))
      (dk-ineq!)))
  (lambda ()
    (let* ((new (c6-steps!)) (p (c6-succ-var new)) (n (find-first (lambda (v) (not (eq? v p))) (c6-vars new 'NN)))
           (r (c6-var new '(FUN NN RR))) (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'PPROD))) new))
           (nn (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (not (dk-contains? q 'PPROD)))) new))
           (j (list '+ n p)) (qj (list 'PPROD (c6-opr r) j)) (q0 (list 'PPROD (c6-opr r) n))
           (sj (c6-sps r j)) (s0 (c6-sps r n)) (rj (list r j)) (xx (list '- sj s0)) (ex (list 'R-EXP xx)) (er (list 'R-EXP rj)))
      (c6-and! (list 'IN n 'NN) (list 'IN p 'NN)) (fact 'nn-add-closed n p)
      (c6-opr-typ! r)
      (dk-cite! 'pprod-in-rr n (c6-opr r)) (dk-cite! 'pprod-in-rr j (c6-opr r))
      (fact 'series-partial-sum-in-rr n r) (fact 'series-partial-sum-in-rr j r)
      (fact 'fun-apply-type-c r 'NN 'RR j) (fact 'rr-one-in) (fact 'rr-zero-in)
      (dk-apply! ih n r) (dk-apply! nn j)
      (subst (dk-cite! 'nn-add-succ n p))
      (subst (dk-cite! 'pprod-succ (c6-opr r) j))
      (subst (c6-sps-succ! r j))
      (dk-lam-b!)
      (c6-rr! xx) (c6-rr! (list '+ sj rj)) (c6-rr! (list '- (list '+ sj rj) s0)) (c6-rr! (list '+ 1 rj))
      (for-each (lambda (t) (fact 'r-exp-in-rr t)) (list xx rj (list '- (list '+ sj rj) s0)))
      (fact 'r-exp-pos xx)
      (let ((e (list '= (list '- (list '+ sj rj) s0) (list '+ xx rj))))
        (dk-have! e (lambda () (crs)))
        (subst e))
      (c6-rr! (list '+ xx rj)) (fact 'r-exp-in-rr (list '+ xx rj))
      (subst (c6-cite! 'r-exp-add xx rj))
      (let* ((lo (c6-cite! 'pprod-exp-bounds n r)))
        (dk-split-all! (list lo))
        (dk-cite! 'series-partial-sum-nonneg n r)
        (dk-cite! 'r-exp-ge-one-plus rj)
        (let* ((qe (list '* q0 ex)))
          (c6-rr! qe)
          (dk-have! (list '<= 0 (list '+ 1 rj)) (lambda () (dk-ineq! (list '<= 0 rj))))
          (dk-have! (list '<= 0 q0) (lambda () (dk-ineq! (list '<= (list '+ 1 s0) q0) (list '<= 0 s0))))
          (dk-have! (list '<= 0 ex) (lambda () (dk-ineq! (list '< 0 ex))))
          (c6-rr! (list '* q0 ex))
          (dk-have! (list '<= 0 qe) (lambda () (let ((z (c6-cite! 'rr-mul-le-right 0 q0 ex))) (dk-have! (list '= (list '* 0 ex) 0) (lambda () (crs))) (c6-ineq*! z (list '= (list '* 0 ex) 0)))))
          (let* ((k1 (c6-cite! 'rr-mul-le-right qj qe (list '+ 1 rj)))
                 (k2 (c6-cite! 'rr-mul-le-right (list '+ 1 rj) er qe))
                 (c1 (list '= (list '* er qe) (list '* q0 (list '* ex er))))
                 (c2 (list '= (list '* (list '+ 1 rj) qe) (list '* qe (list '+ 1 rj)))))
            (dk-have! c1 (lambda () (crs))) (dk-have! c2 (lambda () (crs)))
            (c6-ineq*! k1 k2 c1 c2)))))))
(qed 'pprod-ratio-le)

(define (c6-mag-nonneg! a)                    ; a in FUN(NN, CC): forall i. 0 <= |a|(i)
  (let ((f (c6-nonneg (c6-mag a))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (let ((i (dk-di-var!))) (fact 'fun-apply-type-c a 'NN 'CC i) (c6-mag! (list a i)) (dk-lam-b!) (dk-ass!)))))
    f))
(define (c6-sps-typ! g n) (fact 'series-partial-sum-in-rr n g) (c6-sps g n))
(define (c6-bnd g bv) (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list '<= (c6-sps g 'c6i_) bv))))

;;; the Cauchy bound: if every partial sum of |a| is at most B, then
;;; |P(n + p) - P(n)| <= exp(B) exp(B) (S(n + p) - S(n)),  P = partial products of 1 + a, S of |a|
(sp (make-wff (list 'FORALL 'c6p_ (list 'IMPLIES '(IN c6p_ NN) (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN)
  (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC)) (list 'FORALL 'c6b_ (list 'IMPLIES '(IN c6b_ RR)
    (list 'IMPLIES (c6-bnd (c6-mag 'c6a_) 'c6b_)
      (list '<= (list 'magnitude (list '- (list 'PPROD (c6-op 'c6a_) '(+ c6n_ c6p_)) (list 'PPROD (c6-op 'c6a_) 'c6n_)))
                (list '* (list '* '(R-EXP c6b_) '(R-EXP c6b_)) (list '- (c6-sps (c6-mag 'c6a_) '(+ c6n_ c6p_)) (c6-sps (c6-mag 'c6a_) 'c6n_)))))))))))))))
(let* ((new (c6-steps!)) (vs (c6-vars new 'NN)) (a (c6-var new '(FUN NN CC))) (bv (c6-var new 'RR))
       (n (find-first (lambda (v) (c6-has-sub? (dk-goal) (list 'PPROD (c6-op a) v))) vs))
       (p (find-first (lambda (v) (not (eq? v n))) vs))
       (bnd (find-first (lambda (q) (c6-op? q 'FORALL 3)) new))
       (g (c6-mag a)) (m (list '+ n p)) (sm (c6-sps g m)) (s0 (c6-sps g n)) (xx (list '- sm s0))
       (qm (list 'PPROD (c6-opm a) m)) (q0 (list 'PPROD (c6-opm a) n)) (eb (list 'R-EXP bv)) (ex (list 'R-EXP xx)) (es0 (list 'R-EXP s0)))
  (c6-and! (list 'IN n 'NN) (list 'IN p 'NN)) (fact 'nn-add-closed n p)
  (c6-mag-typ! a) (c6-opm-typ! a) (c6-mag-nonneg! a)
  (c6-sps-typ! g m) (c6-sps-typ! g n) (c6-rr! xx)
  (dk-cite! 'pprod-in-rr n (c6-opm a)) (dk-cite! 'pprod-in-rr m (c6-opm a))
  (fact 'r-exp-in-rr bv) (fact 'r-exp-in-rr xx) (fact 'r-exp-in-rr s0) (fact 'r-exp-pos bv) (fact 'r-exp-pos xx)
  (fact 'rr-zero-in) (fact 'rr-one-in)
  (let* ((d1 (c6-cite! 'pprod-diff-le p n a))
         (ra (dk-lam-b-h! (c6-cite! 'pprod-ratio-le p n g)))
         (eb0 (let ((f (c6-cite! 'pprod-exp-bounds n g))) (dk-lam-b-h! f) (dk-split-all!) #t))
         (rau (dk-ctx-form (list '<= qm (list '* q0 ex))))
         (qlo (dk-ctx-form (list '<= (list '+ 1 s0) q0)))
         (qhi (dk-ctx-form (list '<= q0 es0)))
         (s0n (c6-cite! 'series-partial-sum-nonneg n g))
         (x0 (begin (dk-have! (list '<= n m) (lambda () (c6-nn! n) (c6-nn! p) (fact 'nn-zero-le p) (dk-ineq! (list '<= 0 p)))) #t))
         (le-mono (c6-cite! 'series-partial-sum-mono m n g))
         (bm (dk-apply! bnd m)))
    (dk-apply! bnd n)
    (let ((pd (list '- (list 'PPROD (c6-op a) m) (list 'PPROD (c6-op a) n))))
      (c6-op-typ! a) (dk-cite! 'pprod-in-cc n (c6-op a)) (dk-cite! 'pprod-in-cc m (c6-op a)) (c6-cc! pd) (c6-mag! pd))
    (dk-have! (list '<= 0 xx) (lambda () (dk-ineq! le-mono)))
    (dk-have! (list '<= xx bv) (lambda () (dk-ineq! bm s0n)))
    (dk-have! (list '<= 0 q0) (lambda () (dk-ineq! qlo s0n)))
    (dk-have! (list '<= 0 eb) (lambda () (dk-ineq! (list '< 0 eb))))
    (let* ((m1 (c6-cite! 'r-exp-mono s0 bv)) (m2 (c6-cite! 'r-exp-mono xx bv))
           (so (c6-cite! 'r-exp-sub-one-le xx))
           (exm1 (list '- ex 1)) (xe (list '* xx ex)) (ebx (list '* eb xx)))
      (c6-rr! exm1) (c6-rr! xe) (c6-rr! ebx) (c6-rr! (list '* ex xx))
      (dk-have! (list '<= 0 ebx) (lambda () (let ((z (c6-cite! 'rr-mul-le-right 0 eb xx))) (dk-have! (list '= (list '* 0 xx) 0) (lambda () (crs))) (c6-ineq*! z (list '= (list '* 0 xx) 0)))))
      (dk-have! (list '<= q0 eb) (lambda () (dk-ineq! qhi m1)))
      (let* ((k1 (c6-cite! 'rr-mul-le-right exm1 xe q0))
             (k2 (c6-cite! 'rr-mul-le-right ex eb xx))
             (k3 (c6-cite! 'rr-mul-le-right (list '* ex xx) ebx q0))
             (k4 (c6-cite! 'rr-mul-le-right q0 eb ebx))
             (e1 (list '= (list '* exm1 q0) (list '- (list '* q0 ex) q0)))
             (e2 (list '= (list '* xe q0) (list '* (list '* ex xx) q0)))
             (e3 (list '= (list '* ebx q0) (list '* q0 ebx)))
             (e4 (list '= (list '* eb ebx) (list '* (list '* eb eb) xx))))
        (for-each (lambda (e) (dk-have! e (lambda () (crs)))) (list e1 e2 e3 e4))
        (c6-ineq*! d1 rau k1 k2 k3 k4 e1 e2 e3 e4)))))
(qed 'pprod-cauchy-bound)

(define (c6-pseq a) (list 'VNB-LAMBDA 'c6n_ 'NN (list 'PPROD (c6-op a) 'c6n_)))   ; n |-> PPROD(1 + a, n)
(define (c6-pseq-typ! a)
  (c6-op-typ! a)
  (c6-lam-typ! (c6-pseq a) 'CC (lambda (k) (dk-cite! 'pprod-in-cc k (c6-op a)))))
(define (c6-pts!)
  (fact 'cc-is-metric-space)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (c6-sk! ex) (dk-skolem! (dk-ctx-form ex) #t))   ; skolemise an existential in context, split; the witness

;;; THE CORE OF 6.6: when every |a_k| <= 1/2 and sum |a_k| < oo, the partial products of 1 + a_k
;;; converge in C to a NON-ZERO limit
(sp (make-wff (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC)) (list 'IMPLIES (c6-small 'c6a_)
  (list 'IMPLIES (list 'SERIES-CONVERGES (c6-mag 'c6a_))
    (list 'FORSOME 'c6z_ (list 'AND '(IN c6z_ CC) (list 'AND '(NOT (= c6z_ 0)) (list 'CONVERGES-TO 'CC-MS (c6-pseq 'c6a_) 'c6z_))))))))))
(let* ((new (c6-steps!)) (a (c6-var new '(FUN NN CC))) (small (find-first (lambda (q) (c6-op? q 'FORALL 3)) new))
       (g (c6-mag a)) (sq (c6-pseq a)))
  (c6-mag-typ! a) (c6-mag-nonneg! a) (c6-pseq-typ! a) (c6-pts!)
  (fact 'rr-zero-in) (fact 'rr-one-in) (fact 'nn-zero-in)
  (let* ((bv (c6-sk! (c6-cite! 'series-partial-sum-bounded g)))
         (eb (list 'R-EXP bv)) (kk (list '* eb eb)) (m2b (list '* -2 bv)) (kinv (list 'R-EXP m2b)))
    (fact 'r-exp-in-rr bv) (fact 'r-exp-pos bv)
    (dk-have! (list '<= 0 eb) (lambda () (dk-ineq! (list '< 0 eb))))
    (c6-rr! m2b) (fact 'r-exp-in-rr m2b) (fact 'r-exp-pos m2b) (c6-rr! kk)
    (dk-have! (list '<= 0 bv) (lambda () (let ((b0 (dk-apply! (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q bv))) (dk-asms)) 0)))
                                           (fact 'series-partial-sum-zero g)
                                           (dk-rewrite-h! b0 (c6-sps g 0) 0)
                                           (dk-ass!))))
    ;; K kinv = 1
    (let* ((bb (list '+ bv bv)) (z (list '+ bb m2b)))
      (c6-rr! bb) (c6-rr! z) (fact 'r-exp-in-rr bb) (fact 'r-exp-in-rr z) (fact 'r-exp-zero)
      (let* ((a1 (c6-cite! 'r-exp-add bv bv)) (a2 (c6-cite! 'r-exp-add bb m2b)))
        (dk-have! (list '= z 0) (lambda () (crs)))
        (dk-have! (list '= (list '* kk kinv) 1)
          (lambda () (subst (list '= kk (list 'R-EXP bb))) (subst (list '= (list '* (list 'R-EXP bb) kinv) (list 'R-EXP z)))
                     (subst (list '= z 0)) (dk-ass!)))))
    ;; the sequence is Cauchy
    (dk-have! (list 'IS-CAUCHY-SEQ 'CC-MS sq)
      (lambda ()
        (mac 'IS-CAUCHY-SEQ)
        (dk-conj-close!
          (lambda ()
            (cond
              ((dk-asm? (dk-goal)) (dk-ass!))
              ((dk-head-is? (dk-goal) 'IN) (subst '(== (PTS CC-MS) CC)) (dk-ass!))
              (#t
               (let* ((ne (c6-steps!)) (eps (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) ne)))
                      (dl (list '* eps kinv)))
                 (fact 'rr-pos-rr-in-rr eps) (fact 'rr-lt-of-pos-rr eps)
                 (c6-rr! dl) (c6-cite! 'rr-mul-pos eps kinv) (c6-cite! 'rr-pos-rr-of-lt dl)
                 (let* ((tl0 (c6-cite! 'series-tail-small g))
                        (nb (c6-sk! (dk-apply! tl0 dl)))
                        (tl (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q nb))) (dk-asms))))
                   (c6-nn! nb)
                   (ew nb)
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-asm? (dk-goal)) (dk-ass!)
                         (let* ((nm (c6-steps!)) (vs (c6-vars nm 'NN)) (mv (car vs)) (nv (cadr vs)))
                           (dk-split-all!)
                           (let ((gm (dk-goal)))
                             #t)
                           (fact 'fun-apply-type-c sq 'NN 'CC mv) (fact 'fun-apply-type-c sq 'NN 'CC nv)
                           (subst (dk-cite! 'cc-ms-dist (list sq mv) (list sq nv)))
                           (dk-lam-b!)
                           (c6-nn! mv) (c6-nn! nv)
                           (let ((close!
                                   (lambda (lo hi)          ; lo <= hi, both >= nb; goal |P_hi - P_lo| <= eps
                                     (let* ((dv (c6-sk! (c6-cite! 'nn-le-gap hi lo)))
                                            (hh (list '+ lo dv)) (shi (c6-sps g hh)) (slo (c6-sps g lo)) (snb (c6-sps g nb))
                                            (xx (list '- shi slo)))
                                       (c6-and! (list 'IN lo 'NN) (list 'IN dv 'NN)) (fact 'nn-add-closed lo dv)
                                       (subst (list '= hi hh))
                                       (dk-cite! 'pprod-in-cc hh (c6-op a)) (dk-cite! 'pprod-in-cc lo (c6-op a))
                                       (let ((pd (list '- (list 'PPROD (c6-op a) hh) (list 'PPROD (c6-op a) lo)))) (c6-cc! pd) (c6-mag! pd))
                                       (c6-sps-typ! g hh) (c6-sps-typ! g lo) (c6-sps-typ! g nb) (c6-rr! xx)
                                       (let* ((cb (c6-cite! 'pprod-cauchy-bound dv lo a bv))
                                              (t1 (begin (c6-nn! hh) (c6-nn! dv) (fact 'nn-zero-le dv)
                                                         (dk-have! (list '<= nb hh) (lambda () (dk-ineq! (list '<= nb lo) (list '<= 0 dv))))
                                                         (dk-apply! tl hh)))
                                              (mo (c6-cite! 'series-partial-sum-mono lo nb g))
                                              (x1 (begin (dk-have! (list '<= xx dl) (lambda () (dk-ineq! t1 mo))) (list '<= xx dl)))
                                              (k0 (begin (dk-have! (list '= (list '* 0 eb) 0) (lambda () (crs))) (dk-have! (list '<= 0 kk) (lambda () (c6-ineq*! (c6-cite! 'rr-mul-le-right 0 eb eb) (list '= (list '* 0 eb) 0) (list '< 0 eb))))
                                                         #t))
                                              (k1 (c6-cite! 'rr-mul-le-right xx dl kk))
                                              (e1 (list '= (list '* kk xx) (list '* xx kk)))
                                              (e2 (list '= (list '* dl kk) (list '* (list '* kk kinv) eps))))
                                         (dk-have! e1 (lambda () (crs))) (dk-have! e2 (lambda () (crs)))
                                         (let ((e3 (dk-rewrite-h! e2 (list '* kk kinv) 1)))
                                           (c6-ineq*! cb k1 e1 e3)))))))
                             (use-cases (begin (c6-and! (list 'IN nv 'RR) (list 'IN mv 'RR)) (dk-fact! 'rr-leq-total nv mv))
                               (lambda () (close! nv mv))
                               (lambda ()
                                 (dk-cite! 'pprod-in-cc mv (c6-op a)) (dk-cite! 'pprod-in-cc nv (c6-op a))
                                 (subst (dk-cite! 'cc-magnitude-sub-sym (list 'PPROD (c6-op a) mv) (list 'PPROD (c6-op a) nv)))
                                 (close! mv nv))))))))))))))))
    ;; the limit
    (dk-cite! 'cc-complete)
    (dk-have! (list 'CONVERGES 'CC-MS sq)
      (lambda ()
        (mac-h 'IS-COMPLETE '(IS-COMPLETE CC-MS)) (dk-split-all!)
        (dk-apply! (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'IS-CAUCHY-SEQ))) (dk-asms)) sq)
        (dk-ass!)))
    (let* ((cl (dk-landed-1 (lambda () (mac-h 'CONVERGES (list 'CONVERGES 'CC-MS sq)))))
           (mv (c6-sk! cl))
           (conv (list 'CONVERGES-TO 'CC-MS sq mv)))
      (dk-have! (list 'IN mv 'CC)
        (lambda () (mac-h 'CONVERGES-TO conv) (dk-split-all!) (subst '(== CC (PTS CC-MS))) (dk-ass!)))
      ;; |P_j| >= exp(-2B) for every j
      (let ((lowall (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list '<= kinv (list 'magnitude (list 'PPROD (c6-op a) 'c6j_)))))))
        (dk-have! lowall
          (lambda ()
            (let* ((j (dk-di-var!)) (sj (c6-sps g j)) (msj (list '* -2 sj)))
              (c6-sps-typ! g j) (c6-rr! msj) (fact 'r-exp-in-rr msj)
              (dk-apply! (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q bv) (dk-contains? q 'SERIES-PARTIAL-SUM))) (dk-asms)) j)
              (dk-have! (list '<= m2b msj) (lambda () (dk-ineq! (list '<= sj bv))))
              (let* ((lo (c6-cite! 'pprod-lower j a)) (mo (c6-cite! 'r-exp-mono m2b msj)))
                (dk-cite! 'pprod-in-cc j (c6-op a)) (c6-mag! (list 'PPROD (c6-op a) j))
                (dk-ineq! lo mo)))))
        (dk-have! (list 'NOT (list '= mv 0))
          (lambda ()
            (di)
            (c6-cite! 'rr-pos-rr-of-lt kinv)
            (let* ((c2 (dk-halve! kinv))
                   (cs (dk-landed (lambda () (mac-h 'CONVERGES-TO conv)))))
              (dk-split-all!)
              (let* ((ue (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'POS-RR))) (dk-asms)))
                     (n2 (c6-sk! (dk-apply! ue c2)))
                     (u2 (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'DIST) (dk-contains? q n2))) (dk-asms))))
                (c6-nn! n2)
                (dk-have! (list '<= n2 n2) (lambda () (dk-ineq!)))
                (let* ((d0 (dk-apply! u2 n2))
                       (sn (list sq n2)) (pn (list 'PPROD (c6-op a) n2)))
                  (fact 'fun-apply-type-c sq 'NN 'CC n2) (fact 'cc-zero-in)
                  (let* ((d1 (dk-rewrite-h! d0 mv 0))
                         (dq (c6-cite! 'cc-ms-dist sn 0))
                         (d2 (dk-rewrite-h! d1 (list (list 'DIST 'CC-MS) sn 0) (list 'magnitude (list '- sn 0))))
                         (d3 (dk-lam-b-h! d2))
                         (e0 (begin (dk-cite! 'pprod-in-cc n2 (c6-op a)) (dk-have! (list '= (list '- pn 0) pn) (lambda () (crs))) #t))
                         (d4 (dk-rewrite-h! (dk-ctx-form (list '<= (list 'magnitude (list '- pn 0)) c2)) (list '- pn 0) pn)))
                    (c6-mag! pn)
                    (dk-absurd! d4 (dk-apply! lowall n2) (list '= (list '+ c2 c2) kinv) (list '< 0 c2)))))))))
      (ew mv)
      (dk-conj-close! (lambda () (dk-ass!))))))
(qed 'pprod-small-converges)

(define (c6-gs a nv) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'magnitude (list a (list '+ nv 'c6k_)))))   ; k |-> |a(N + k)|

;;; partial sums of the shifted moduli: S'(n) = S(N + n) - S(N)
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6m_ (list 'IMPLIES '(IN c6m_ NN)
  (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC))
    (list '= (c6-sps (c6-gs 'c6a_ 'c6m_) 'c6n_) (list '- (c6-sps (c6-mag 'c6a_) '(+ c6m_ c6n_)) (c6-sps (c6-mag 'c6a_) 'c6m_)))))))))))
(define (c6-gs-typ! a nv)
  (c6-lam-typ! (c6-gs a nv) 'RR (lambda (k) (c6-and! (list 'IN nv 'NN) (list 'IN k 'NN)) (fact 'nn-add-closed nv k)
                                  (fact 'fun-apply-type-c a 'NN 'CC (list '+ nv k)) (fact 'cc-magnitude-closed (list a (list '+ nv k))) (dk-ass!))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (mv (c6-var new 'NN)) (a (c6-var new '(FUN NN CC))) (g (c6-mag a)))
      (c6-mag-typ! a)
      (fact 'nn-zero-in) (fact 'nn-add-zero mv) (subst (list '= (list '+ mv 0) mv))
      (subst (dk-cite! 'series-partial-sum-zero (c6-gs a mv)))
      (c6-sps-typ! g mv)
      (dk-have! (list '= (list '- (c6-sps g mv) (c6-sps g mv)) 0) (lambda () (crs)))
      (subst (list '= (list '- (c6-sps g mv) (c6-sps g mv)) 0))
      (fact 'rr-zero-in) (dk-ineq!)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (mv (find-first (lambda (v) (not (eq? v n))) (c6-vars new 'NN)))
           (a (c6-var new '(FUN NN CC))) (ih (c6-ih new)) (g (c6-mag a)) (gs (c6-gs a mv)) (j (list '+ mv n)))
      (c6-mag-typ! a) (c6-gs-typ! a mv)
      (c6-and! (list 'IN mv 'NN) (list 'IN n 'NN)) (fact 'nn-add-closed mv n)
      (fact 'fun-apply-type-c a 'NN 'CC j) (c6-mag! (list a j))
      (subst (c6-sps-succ! gs n))
      (subst (dk-cite! 'nn-add-succ mv n))
      (subst (c6-sps-succ! g j))
      (dk-lam-b!)
      (subst (dk-apply! ih mv a))
      (c6-sps-typ! g mv) (c6-sps-typ! g j)
      (crs))))
(qed 'sps-shift)

;;; a shifted absolutely convergent series converges absolutely
(sp (make-wff (list 'FORALL 'c6m_ (list 'IMPLIES '(IN c6m_ NN) (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC))
  (list 'IMPLIES (list 'SERIES-CONVERGES (c6-mag 'c6a_)) (list 'SERIES-CONVERGES (c6-gs 'c6a_ 'c6m_)))))))))
(let* ((new (c6-steps!)) (mv (c6-var new 'NN)) (a (c6-var new '(FUN NN CC))) (g (c6-mag a)) (gs (c6-gs a mv)))
  (c6-mag-typ! a) (c6-mag-nonneg! a) (c6-gs-typ! a mv)
  (let ((bv (c6-sk! (c6-cite! 'series-partial-sum-bounded g)))
        (nn (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list '<= 0 (list gs 'c6i_))))))
    (dk-have! nn (lambda () (let ((i (dk-di-var!))) (c6-and! (list 'IN mv 'NN) (list 'IN i 'NN)) (fact 'nn-add-closed mv i)
                                                    (fact 'fun-apply-type-c a 'NN 'CC (list '+ mv i)) (c6-mag! (list a (list '+ mv i))) (dk-lam-b!) (dk-ass!))))
    (c6-sps-typ! g mv)
    (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list '<= (c6-sps gs 'c6j_) bv)))
      (lambda ()
        (let* ((k (dk-di-var!)) (j (list '+ mv k)))
          (c6-and! (list 'IN mv 'NN) (list 'IN k 'NN)) (fact 'nn-add-closed mv k)
          (c6-sps-typ! g j)
          (let ((bu (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q bv) (dk-contains? q 'SERIES-PARTIAL-SUM))) (dk-asms))))
            (dk-apply! bu j)
            (subst (c6-cite! 'sps-shift k mv a))
            (dk-ineq! (list '<= (c6-sps g j) bv) (c6-cite! 'series-partial-sum-nonneg mv g))))))
    (c6-cite! 'series-bounded-converges gs bv)
    (dk-ass!)))
(qed 'series-shift-abs-converges)

;;; the terms of an absolutely convergent series are eventually at most 1/2 in modulus
(sp (make-wff (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC)) (list 'IMPLIES (list 'SERIES-CONVERGES (c6-mag 'c6a_))
  '(FORSOME c6m_ (AND (IN c6m_ NN) (FORALL c6q_ (IMPLIES (IN c6q_ NN) (IMPLIES (<= c6m_ c6q_) (<= (magnitude (c6a_ c6q_)) 1/2)))))))))))
(let* ((new (c6-steps!)) (a (c6-var new '(FUN NN CC))) (g (c6-mag a)))
  (c6-mag-typ! a) (c6-mag-nonneg! a)
  (dk-have! '(IN 1/2 RR) (lambda () (arith)))
  (dk-have! '(< 0 1/2) (lambda () (dk-ineq!)))
  (c6-cite! 'rr-pos-rr-of-lt 1/2)
  (let* ((nb (c6-sk! (dk-apply! (c6-cite! 'series-tail-small g) 1/2)))
         (tl (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q nb))) (dk-asms))))
    (ew nb)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (dk-ass!)
          (let* ((nk (c6-steps!)) (k (c6-var nk 'NN)) (k1 (list 'succ k)))
            (c6-nn! k) (c6-nn! nb) (fact 'nn-succ-closed k) (c6-nn! k1) (fact 'nn-succ-plus-one k)
            (dk-have! (list '<= nb k1) (lambda () (dk-ineq! (list '<= nb k) (list '= k1 (list '+ k 1)))))
            (dk-apply! tl k1)
            (c6-sps-typ! g k) (c6-sps-typ! g nb)
            (let* ((su (c6-sps-succ! g k)) (mo (c6-cite! 'series-partial-sum-mono k nb g)))
              (fact 'fun-apply-type-c a 'NN 'CC k) (c6-mag! (list a k))
              (dk-lam-b-h! su)
              (let ((su2 (dk-ctx-form (list '== (c6-sps g k1) (list '+ (c6-sps g k) (list 'magnitude (list a k)))))))
                (let ((t2 (dk-rewrite-h! (list '<= (list '- (c6-sps g k1) (c6-sps g nb)) 1/2) (c6-sps g k1)
                                         (list '+ (c6-sps g k) (list 'magnitude (list a k))))))
                  (dk-ineq! t2 mo))))))))))
(qed 'abs-series-terms-small)

(define (c6-tf f nv) (list 'VNB-LAMBDA 'pcj_ 'NN (list f (list '+ nv 'pcj_))))        ; the tail of Definition 6.1
(define (c6-opn a nv) (list 'VNB-LAMBDA 'c6k_ 'NN (list '+ 1 (list a (list '+ nv 'c6k_)))))   ; k |-> 1 + a(N + k)
(define (c6-one-plus-ne! a k)                 ; |a k| <= 1/2 in context: NOT (1 + a k = 0)
  (let ((goal (list 'NOT (list '= (list '+ 1 (list a k)) 0))) (ak (list a k)))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (di)
            (let ((oa (list '+ 1 ak)))
              (fact 'fun-apply-type-c a 'NN 'CC k) (fact 'cc-one-in) (c6-cc! oa) (c6-mag! ak) (c6-mag! oa)
              (c6-and! (list 'IN oa 'CC) (list 'IN ak 'CC))
              (let ((tr (dk-fact! 'cc-magnitude-sub-triangle oa ak)))
                (dk-have! (list '= (list '- oa ak) 1) (lambda () (crs)))
                (fact 'cc-magnitude-one) (fact 'cc-magnitude-zero)
                (let ((t2 (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! tr (list '- oa ak) 1) '(magnitude 1) 1) oa 0) '(magnitude 0) 0)))
                  (dk-absurd! t2 (list '<= (list 'magnitude ak) 1/2))))))))
    goal))

;;; PROPOSITION 6.6 (existence): if sum |a_k| < oo, the product of the 1 + a_k converges
(sp (make-wff (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC)) (list 'IMPLIES (list 'SERIES-CONVERGES (c6-mag 'c6a_))
  (list 'FORSOME 'c6l_ (list 'PROD-CONVERGES-TO (c6-op 'c6a_) 'c6l_)))))))
(let* ((new (c6-steps!)) (a (c6-var new '(FUN NN CC))))
  (c6-mag-typ! a) (c6-op-typ! a)
  (let* ((nv (c6-sk! (c6-cite! 'abs-series-terms-small a)))
         (uu (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q nv) (dk-contains? q 1/2))) (dk-asms)))
         (b (c6-tl a nv)))
    (c6-tl-typ! a nv) (c6-nn! nv)
    (dk-have! (c6-small b)
      (lambda () (let ((i (dk-di-var!))) (dk-lam-b!) (c6-nn! i) (fact 'nn-zero-le i)
                   (c6-and! (list 'IN nv 'NN) (list 'IN i 'NN)) (fact 'nn-add-closed nv i) (c6-nn! (list '+ nv i))
                   (dk-have! (list '<= nv (list '+ nv i)) (lambda () (dk-ineq! (list '<= 0 i))))
                   (dk-apply! uu (list '+ nv i)) (dk-ass!))))
    (dk-have! (list 'SERIES-CONVERGES (c6-mag b))
      (lambda () (dk-lam-b!) (c6-cite! 'series-shift-abs-converges nv a) (dk-ass!)))
    (let* ((mv (c6-sk! (c6-cite! 'pprod-small-converges b)))
           (cv0 (find-first (lambda (q) (and (dk-head-is? q 'CONVERGES-TO) (dk-contains? q mv))) (dk-asms))))
      (dk-lam-b-h! cv0)
      (let* ((tf (c6-tf (c6-op a) nv)) (opn (c6-opn a nv))
             (lv (list '* (list 'PPROD (c6-op a) nv) mv)))
        (c6-lam-typ! tf 'CC (lambda (k) (c6-and! (list 'IN nv 'NN) (list 'IN k 'NN)) (fact 'nn-add-closed nv k)
                                        (fact 'fun-apply-type-c (c6-op a) 'NN 'CC (list '+ nv k)) (dk-ass!)))
        (c6-lam-typ! opn 'CC (lambda (k) (c6-and! (list 'IN nv 'NN) (list 'IN k 'NN)) (fact 'nn-add-closed nv k)
                                         (fact 'fun-apply-type-c a 'NN 'CC (list '+ nv k)) (fact 'cc-one-in) (c6-cc! (list '+ 1 (list a (list '+ nv k))))))
        (dk-fun-ext! tf opn 'NN 'CC #f #f
          (lambda (v) (c6-and! (list 'IN nv 'NN) (list 'IN v 'NN)) (fact 'nn-add-closed nv v)
                      (fact 'fun-apply-type-c a 'NN 'CC (list '+ nv v)) (fact 'cc-one-in) (c6-cc! (list '+ 1 (list a (list '+ nv v))))
                      (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
        (dk-cite! 'pprod-in-cc nv (c6-op a))
        (c6-cc! lv)
        (ew lv)
        (mac 'PROD-CONVERGES-TO)
        (dk-conj-close!
          (lambda ()
            (cond
              ((dk-asm? (dk-goal)) (dk-ass!))
              ((dk-head-is? (dk-goal) 'FORSOME)
               (ew nv)
               (dk-conj-close!
                 (lambda ()
                   (cond
                     ((dk-asm? (dk-goal)) (dk-ass!))
                     ((dk-head-is? (dk-goal) 'FORALL)
                      (let* ((nk (c6-steps!)) (k (c6-var nk 'NN)))
                        (dk-lam-b!)
                        (dk-apply! uu k)
                        (c6-one-plus-ne! a k)
                        (dk-ass!)))
                     ((dk-head-is? (dk-goal) 'FORSOME)
                      (ew mv)
                      (dk-conj-close!
                        (lambda ()
                          (cond
                            ((dk-asm? (dk-goal)) (dk-ass!))
                            ((dk-head-is? (dk-goal) 'CONVERGES-TO) (subst (list '= tf opn)) (dk-ass!))
                            (#t (rfl))))))
                     (#t (dk-ass!))))))
              (#t (dk-ass!)))))))))
(qed 'prod-abs-converges-exists)

;;; the value of a convergent product is 0 exactly when a factor is 0 (the second half of 6.6, for any product)
(define (c6-zf f) (list 'FORSOME 'c6q_ (list 'AND '(IN c6q_ NN) (list '= (list f 'c6q_) 0))))
(sp (make-wff (list 'FORALL 'c6f_ (list 'IMPLIES '(IN c6f_ (FUN NN CC)) (list 'FORALL 'c6l_
  (list 'IMPLIES '(PROD-CONVERGES-TO c6f_ c6l_) (list 'IFF '(= c6l_ 0) (c6-zf 'c6f_))))))))
(let* ((new (c6-steps!)) (f (c6-var new '(FUN NN CC)))
       (cv (find-first (lambda (q) (dk-head-is? q 'PROD-CONVERGES-TO)) new)) (lv (caddr cv)))
  (mac-h 'PROD-CONVERGES-TO cv)
  (dk-split-all!)
  (let* ((nv (c6-sk! (find-first (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q 'pcm_))) (dk-asms))))
         (tl (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q nv) (dk-contains? q 'NOT))) (dk-asms)))
         (mv (c6-sk! (find-first (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q 'pcz_))) (dk-asms))))
         (pp (list 'PPROD f nv)) (pm (list '* pp mv)))
    (dk-cite! 'pprod-in-cc nv f) (c6-cc! pm) (fact 'cc-zero-in)
    (dk-iff! (dk-head? 'FORSOME)
      (lambda ()                              ; L = 0  =>  some factor is 0
        (use-em (c6-zf f)
          (lambda () (dk-ass!))
          (lambda ()
            (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ nv) (list 'NOT (list '= (list f 'c6j_) 0)))))
              (lambda ()
                (let* ((nj (c6-steps!)) (j (c6-var nj 'NN)))
                  (di)
                  (dk-have! (c6-zf f) (lambda () (ew j) (dk-conj-close! (lambda () (dk-ass!)))))
                  (ai (list 'NOT (c6-zf f))))))
            (c6-cite! 'pprod-nonzero nv f)
            (dk-fact! 'cc-mul-nonzero pp mv)
            (dk-have! (list '= pm 0) (lambda () (subst (list '= pm lv)) (dk-ass!)))
            (ai (list 'NOT (list '= pm 0))))))
      (lambda ()                              ; some factor is 0  =>  L = 0
        (let* ((k (c6-sk! (c6-zf f))))
          (c6-nn! k) (c6-nn! nv)
          (use-em (list '< k nv)
            (lambda ()
              (c6-cite! 'pprod-zero-factor nv f k)
              (subst (list '= lv pm))
              (subst (list '= pp 0))
              (crs))
            (lambda ()
              (c6-cite! 'nn-not-lt-le k nv)
              (dk-apply! tl k)
              (ai (list 'NOT (list '= (list f k) 0))))))))))
(qed 'prod-zero-iff)

;;; PROPOSITION 6.6.  If sum |a_k| < oo, then prod (1 + a_k) converges; and a necessary and sufficient
;;; condition that the product be 0 is that one of the factors be zero.
(sp (make-wff (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC)) (list 'IMPLIES (list 'SERIES-CONVERGES (c6-mag 'c6a_))
  (list 'AND (list 'PROD-CONVERGES (c6-op 'c6a_))
    (list 'FORALL 'c6l_ (list 'IMPLIES (list 'PROD-CONVERGES-TO (c6-op 'c6a_) 'c6l_)
      (list 'IFF '(= c6l_ 0) '(FORSOME c6q_ (AND (IN c6q_ NN) (= (+ 1 (c6a_ c6q_)) 0))))))))))))
(let* ((new (c6-steps!)) (a (c6-var new '(FUN NN CC))) (f (c6-op a)))
  (c6-op-typ! a)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'PROD-CONVERGES)
          (begin (mac 'PROD-CONVERGES) (c6-cite! 'prod-abs-converges-exists a) (dk-ass!))
          (let* ((nl (c6-steps!)) (cv (find-first (lambda (q) (dk-head-is? q 'PROD-CONVERGES-TO)) nl)) (lv (caddr cv))
                 (zi (c6-cite! 'prod-zero-iff f lv)))
            (dk-iff! (dk-head? 'FORSOME)
              (lambda ()
                (dk-have! (c6-zf f) (lambda () (keep zi (list '= lv 0)) (prop)))
                (let* ((k (c6-sk! (c6-zf f))))
                  (dk-lam-b-h! (list '= (list f k) 0))
                  (ew k)
                  (dk-conj-close! (lambda () (dk-ass!)))))
              (lambda ()
                (let* ((k (c6-sk! '(FORSOME c6q_ (AND (IN c6q_ NN) (= (+ 1 (c6a_ c6q_)) 0))))))
                  (dk-have! (c6-zf f) (lambda () (ew k) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!) (begin (dk-lam-b!) (dk-ass!)))))))
                  (keep zi (c6-zf f))
                  (prop)))))))))
(qed 'abs-convergent-product)

;;; ---------------------------------------------------------------- real products (Lemma 6.4)
(define (c6-omr r) (list 'VNB-LAMBDA 'c6k_ 'NN (list '- 1 (list r 'c6k_))))          ; k |-> 1 - r(k)
(define (c6-lg r) (list 'VNB-LAMBDA 'c6k_ 'NN (list 'LOG (list '+ 1 (list r 'c6k_)))))   ; k |-> ln(1 + r(k))
(define (c6-omr-typ! r)
  (c6-lam-typ! (c6-omr r) 'RR (lambda (k) (fact 'fun-apply-type-c r 'NN 'RR k) (fact 'rr-one-in) (c6-rr! (list '- 1 (list r k))))))
(define (c6-lg-typ! r)
  (c6-lam-typ! (c6-lg r) 'RR (lambda (k) (fact 'log-in-rr (list '+ 1 (list r k))))))
(define (c6-pos f) (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list '< 0 (list f 'c6i_)))))
(define (c6-le1 f) (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list '<= (list f 'c6i_) 1))))

;;; partial products of positive reals are positive
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6f_ (list 'IMPLIES '(IN c6f_ (FUN NN RR))
  (list 'IMPLIES (c6-pos 'c6f_) '(< 0 (PPROD c6f_ c6n_)))))))))
(ni)
(c6-induct!
  (lambda () (let* ((new (c6-steps!)) (f (c6-var new '(FUN NN RR)))) (subst (dk-cite! 'pprod-zero f)) (fact 'rr-one-in) (fact 'rr-zero-in) (dk-ineq!)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (f (c6-var new '(FUN NN RR)))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'PPROD))) new))
           (ps (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (not (dk-contains? q 'PPROD)))) new)))
      (dk-apply! ih f) (dk-apply! ps n)
      (dk-cite! 'pprod-in-rr n f) (fact 'fun-apply-type-c f 'NN 'RR n)
      (subst (dk-cite! 'pprod-succ f n))
      (c6-cite! 'rr-mul-pos (list 'PPROD f n) (list f n))
      (dk-ass!))))
(qed 'pprod-pos)

;;; partial products of factors in (0, 1] decrease
(sp (make-wff (list 'FORALL 'c6p_ (list 'IMPLIES '(IN c6p_ NN) (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN)
  (list 'FORALL 'c6f_ (list 'IMPLIES '(IN c6f_ (FUN NN RR)) (list 'IMPLIES (c6-pos 'c6f_) (list 'IMPLIES (c6-le1 'c6f_)
    '(<= (PPROD c6f_ (+ c6n_ c6p_)) (PPROD c6f_ c6n_))))))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-var new 'NN)) (f (c6-var new '(FUN NN RR))))
      (fact 'nn-zero-in) (fact 'nn-add-zero n) (subst (list '= (list '+ n 0) n))
      (dk-cite! 'pprod-in-rr n f) (dk-ineq!)))
  (lambda ()
    (let* ((new (c6-steps!)) (p (c6-succ-var new)) (n (find-first (lambda (v) (not (eq? v p))) (c6-vars new 'NN)))
           (f (c6-var new '(FUN NN RR))) (j (list '+ n p))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'PPROD))) new))
           (ps (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q '<) (not (dk-contains? q 'PPROD)))) new))
           (le (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q '<=) (not (dk-contains? q 'PPROD)))) new)))
      (c6-and! (list 'IN n 'NN) (list 'IN p 'NN)) (fact 'nn-add-closed n p)
      (dk-apply! ih n f) (dk-apply! ps j) (dk-apply! le j)
      (dk-cite! 'pprod-in-rr n f) (dk-cite! 'pprod-in-rr j f) (fact 'fun-apply-type-c f 'NN 'RR j)
      (c6-cite! 'pprod-pos j f)
      (subst (dk-cite! 'nn-add-succ n p))
      (subst (dk-cite! 'pprod-succ f j))
      (let* ((pj (list 'PPROD f j)) (k1 (begin (dk-have! (list '<= 0 pj) (lambda () (dk-ineq! (list '< 0 pj))))
                                              (c6-cite! 'rr-mul-le-right (list f j) 1 pj))))
        (dk-have! (list '= (list '* 1 pj) pj) (lambda () (crs)))
        (dk-have! (list '= (list '* (list f j) pj) (list '* pj (list f j))) (lambda () (crs)))
        (c6-ineq*! k1 (list '= (list '* 1 pj) pj) (list '= (list '* (list f j) pj) (list '* pj (list f j)))
                   (list '<= pj (list 'PPROD f n)))))))
(qed 'pprod-dec)

;;; ln PPROD(1 + r, n) = sum_{i < n} ln(1 + r_i)   for r >= 0
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6r_ (list 'IMPLIES '(IN c6r_ (FUN NN RR))
  (list 'IMPLIES (c6-nonneg 'c6r_) (list '= (list 'LOG (list 'PPROD (c6-opr 'c6r_) 'c6n_)) (c6-sps (c6-lg 'c6r_) 'c6n_)))))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (r (c6-var new '(FUN NN RR))))
      (subst (dk-cite! 'pprod-zero (c6-opr r))) (subst (dk-cite! 'series-partial-sum-zero (c6-lg r)))
      (fact 'log-one) (dk-ass!)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-succ-var new)) (r (c6-var new '(FUN NN RR)))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'PPROD))) new))
           (nn (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (not (dk-contains? q 'PPROD)))) new))
           (qq (list 'PPROD (c6-opr r) n)) (rn (list r n)) (orn (list '+ 1 rn)))
      (c6-opr-typ! r) (c6-lg-typ! r)
      (dk-apply! ih r) (dk-apply! nn n)
      (dk-cite! 'pprod-in-rr n (c6-opr r)) (fact 'fun-apply-type-c r 'NN 'RR n) (fact 'rr-one-in) (fact 'rr-zero-in) (c6-rr! orn)
      (dk-split-all! (list (c6-cite! 'pprod-exp-bounds n r)))
      (c6-cite! 'series-partial-sum-nonneg n r) (c6-sps-typ! r n)
