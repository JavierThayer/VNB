                                  (d2 (begin (dk-have! (list '<= n2 nv) (lambda () (dk-ineq! (list '<= 0 n1))))
                                             (let ((d (dk-apply! u2 nv)))
                                               (dk-lam-b-h! d)
                                               (dk-rewrite-h! (dk-ctx-form (list '<= (list (list 'DIST 'CC-MS) pn lv) e2))
                                                              (list (list 'DIST 'CC-MS) pn lv) (list 'magnitude pnl)))))
                                  ;; |P_N| <= e^B
                                  (mpn (begin (c6-cite! 'pprod-mag-le nv a)
                                              (let ((eb0 (c6-cite! 'pprod-exp-bounds nv g))) (dk-lam-b-h! eb0) (dk-split-all!))
                                              (c6-sps-typ! g nv) (fact 'r-exp-in-rr (c6-sps g nv))
                                              (dk-apply! bu nv)
                                              (c6-cite! 'r-exp-mono (c6-sps g nv) bv)
                                              (dk-cite! 'pprod-in-rr nv (c6-opm a))
                                              (dk-have! (list '<= (list 'magnitude pn) eb)
                                                (lambda () (dk-ineq! (list '<= (list 'magnitude pn) (list 'PPROD (c6-opm a) nv))
                                                                     (list '<= (list 'PPROD (c6-opm a) nv) (list 'R-EXP (c6-sps g nv)))
                                                                     (list '<= (list 'R-EXP (c6-sps g nv)) eb))))
                                              (list '<= (list 'magnitude pn) eb)))
                                  ;; x = sum |e| over [0, K): |PPROD(1 + e) - 1| <= x e^x
                                  (me (c6-mag ev)) (xx (c6-sps me kv)) (exx (list 'R-EXP xx)))
                             (c6-mag-typ! ev) (c6-mag-nonneg! ev) (c6-opm-typ! ev) (c6-sps-typ! me kv) (fact 'r-exp-in-rr xx)
                             (c6-cite! 'series-partial-sum-nonneg kv me)
                             (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '< 'c6j_ kv) (list '= (list gv 'c6j_) (list (c6-sumf trrv fv) 'c6j_)))))
                               (lambda ()
                                 (let* ((nj (c6-steps!)) (j (c6-var nj 'NN)))
                                   (pt! j) (dk-lam-b!) (subst (list '= (list trrv j) (caddr (c6-at! trrv trr j)))) (subst (list '= (list fv j) (caddr (c6-at! fv fl j))))
                                   (c6-if-close! (lambda () (crs))))))
                             (let* ((le1 (c6-cite! 'pprod-one-plus-le kv ev))
                                    (le2 (let ((f (c6-cite! 'pprod-exp-bounds kv me))) (dk-lam-b-h! f) (dk-split-all!)
