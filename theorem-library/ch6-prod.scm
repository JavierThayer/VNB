                                      (dle (begin (dk-have! (list '<= a2 (list '* xx exx)) (lambda () (c6-ineq*! le1 le2 le3))) (list '<= a2 (list '* xx exx))))
                                      (k1 (c6-cite! 'rr-mul-le-right exx eb xx))
                                      (k2 (c6-cite! 'rr-mul-le-right xx dl eb))
                                      (a2b (begin (dk-have! (list '<= a2 (list '* dl eb))
                                                    (lambda () (dk-have! (list '= (list '* exx xx) (list '* xx exx)) (lambda () (crs)))
                                                               (dk-have! (list '= (list '* eb xx) (list '* xx eb)) (lambda () (crs)))
                                                               (c6-ineq*! dle k1 k2 (list '= (list '* exx xx) (list '* xx exx)) (list '= (list '* eb xx) (list '* xx eb)))))
