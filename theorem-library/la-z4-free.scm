;;; la-z4-free.scm -- module homomorphisms and LINCOMB, isomorphisms of modules, the free
;;; module Z^n and its unit basis (LA-Z4, 2026-10-24).  Vocabulary:
;;; structure-library/la-z4-vocab (ZZ-POW, ZZ-UNITS, ZZ-ROW, MAP-SEQ) and la-z3-vocab
;;; (DIRECT-SUM, RING-AS-MODULE, IS-ISO-MODULE).  Prefix lzf-.
;;;
;;; PLAN.
;;;  (A) hom-lincomb: h(c_1 u_1 + ... + c_n u_n) = c_1 h(u_1) + ... + c_n h(u_n) for a
;;;      module homomorphism h, by induction on n through lincomb-row-peel.
;;;  (B) iso-module-inverse, iso-module-compose: the inverse of an isomorphism and the
;;;      composite of two are isomorphisms.
;;;  (C) Z^n = ZZ-POW(n): a module; the unit vectors are a free generating sequence,
;;;      x = LINCOMB(ZZ-ROW(x), units) (evaluation at an index is a homomorphism, so
;;;      hom-lincomb computes the components of a combination).
;;;  (D) an isomorphism carries a free generating sequence to one.
;;;
;;; Destination theorem-library/.  Library: linear-algebra.  LOAD WINDOW: after
;;; structure-library/la-z4-vocab, theorem-library/la-z3-quotient (ring-as-module-is-module,
;;; ram-ro-*) and la-z3-dsum (direct-sum-is-module, dsum-*).

(define (lzf-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z4-free: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'algebra))
(define (lzf-split-all! f)
  (if (dk-head-is? f 'AND) (for-each lzf-split-all! (dk-split! f))))
(define (lzf-grounded?) (sequent-node-grounded? (proof-state-focus *ps*)))
(define (lzf-iv-var ld cls)              ; the variable typed in CLS among the landed formulas
  (let ((f (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cls))) ld)))
    (if (not f) (error "lzf-iv-var: no typing in" (expression->string cls)))
    (cadr f)))
(define (lzf-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!) #f))   ; #t when beta grounded the leaf
(define (lzf-ensure! f thunk) (if (not (dk-asm? f)) (dk-have! f thunk)) f)

;;; the clauses of IS-HOM-MODULE(A, B, f), as is-hom-module-def states them
(define (lzf-hcl-add a b f)
  (list 'FORALL 'x1_ (list 'IMPLIES (list 'IN 'x1_ (list 'VEC a)) (list 'FORALL 'x2_ (list 'IMPLIES (list 'IN 'x2_ (list 'VEC a))
    (list '= (list f (list (list 'VADD a) 'x1_ 'x2_)) (list (list 'VADD b) (list f 'x1_) (list f 'x2_))))))))
(define (lzf-hcl-neg a b f)
  (list 'FORALL 'x1_ (list 'IMPLIES (list 'IN 'x1_ (list 'VEC a))
    (list '= (list f (list (list 'VNEG a) 'x1_)) (list (list 'VNEG b) (list f 'x1_))))))
(define (lzf-hcl-act a b f)
  (list 'FORALL 'x1_ (list 'IMPLIES (list 'IN 'x1_ (list 'CARR (list 'SCAL a))) (list 'FORALL 'x2_ (list 'IMPLIES (list 'IN 'x2_ (list 'VEC a))
    (list '= (list f (list (list 'ACT a) 'x1_ 'x2_)) (list (list 'ACT b) 'x1_ (list f 'x2_))))))))
(define (lzf-hcl-zero a b f) (list '= (list f (list 'VZERO a)) (list 'VZERO b)))
(define (lzf-hom-open! a b f)           ; the conjuncts of IS-HOM-MODULE(a, b, f) into context
  (if (not (dk-asm? (lzf-hcl-zero a b f)))
      (lzf-split-all! (dk-meta-iff-r! (dk-meta-iff! 'is-hom-module-def a b f)))))
(define (lzf-fapp! f x dom cod)         ; (IN (f x) cod) from f in FUN(dom, cod), x in dom
  (if (not (dk-asm? (list 'IN (list f x) cod))) (fact 'fun-apply-type-c f dom cod x)))

;;; prove IS-HOM-MODULE(a, b, f) in the goal; the four procedures run on the leaves:
;;; (ADD x y), (NEG x), (ACT r x), (ZERO); module and FUN typings must be in context.
(define (lzf-prove-hom! a b f add-p neg-p act-p zero-p . scal-p)
  (mac 'is-hom-module-def)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (ass))
          ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'SCAL))
           (cond ((pair? scal-p) ((car scal-p)))
                 ((dk-asm? (list '= (caddr g) (cadr g)))
                  (subst (list '= (cadr g) (caddr g))) (rfl))
                 (#t (error "lzf-prove-hom!: no SCAL equation" (expression->string g)))))
          ((dk-head-is? g '=) (zero-p))
          (#t
           (let* ((ld (dk-peel!))
                  (vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'VEC a)))) ld)))
                  (rs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'CARR (list 'SCAL a))))) ld))))
             (cond ((pair? rs) (act-p (car rs) (car vs)))
                   ((= (length vs) 2) (add-p (car vs) (cadr vs)))
                   (#t (neg-p (car vs)))))))))))

;;; =====================================================================
;;; (A) MAP-SEQ and hom-lincomb.
;;; =====================================================================
(define (lzf-msg n) (list 'VNB-LAMBDA '(LIST msa_ msb_) (list 'CARTESIAN (list 'INTERVAL 1 n) '(INTERVAL 1 1)) '(h (ENTRY u msa_ msb_))))
(define (lzf-ms-pt! n cls finish)       ; forall i in [1,n], j in [1,1]. G(i,j) in CLS
  (let ((g (lzf-msg n)))
    (dk-have! (list 'FORALL 'i (list 'IMPLIES (list 'IN 'i (list 'INTERVAL 1 n))
                (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 1)) (list 'IN (list g 'i 'j) cls)))))
      (lambda ()
        (let* ((ld (dk-peel!))
               (i (lzf-iv-var ld (list 'INTERVAL 1 n)))
               (j (lzf-iv-var ld '(INTERVAL 1 1))))
          (if (not (lzf-beta!))
              (begin
                (fact 'entry-in-carrier n 1 'V 'u i j)
                (lzf-fapp! 'h (list 'ENTRY 'u i j) 'V 'W)
                (finish (list 'h (list 'ENTRY 'u i j)))
                (ass))))))))

(sp (make-wff (forall-guarded '(h V W n u) '((IN h (FUN V W)) (IN n NN) (IN u (MAT n 1 V)))
  '(IN (MAP-SEQ h n u) (MAT n 1 W)))))
(dk-peel!)
(fact 'nn-one-in)
(mac 'MAP-SEQ)
(lzf-ms-pt! 'n 'W (lambda (t) #t))
(fact 'matof-in-mat 'n 1 'W (lzf-msg 'n))
(if (not (lzf-grounded?)) (ass))
(lzf-done! 'map-seq-type)

(sp (make-wff (forall-guarded '(h V W n u i) '((IN h (FUN V W)) (IN n NN) (IN u (MAT n 1 V)) (IN i (INTERVAL 1 n)))
  '(= (ENTRY (MAP-SEQ h n u) i 1) (h (ENTRY u i 1))))))
(dk-peel!)
(fact 'nn-one-in)
(fact 'one-in-interval-1)
(fact 'entry-in-carrier 'n 1 'V 'u 'i 1)
(lzf-fapp! 'h '(ENTRY u i 1) 'V 'W)
(mac 'MAP-SEQ)
(lzf-ms-pt! 'n 'SET (lambda (t) (fact 'membership-implies-sethood t 'W)))
(subst (dk-cite! 'entry-of-matof 'n 1 (lzf-msg 'n) 'i 1))
(if (not (lzf-beta!)) (rfl))
(lzf-done! 'map-seq-entry)

;;; the leading block of an image sequence is the image of the leading block
(sp (make-wff (forall-guarded '(h V W m k u) '((IN h (FUN V W)) (IN m NN) (IN k NN) (<= k m) (IN u (MAT m 1 V)))
  '(= (BLOCK (MAP-SEQ h m u) k 1) (MAP-SEQ h k (BLOCK u k 1))))))
(dk-peel!)
(fact 'nn-one-in)
(fact 'one-in-interval-1)
(fact 'nn-le-refl 1)
(fact 'map-seq-type 'h 'V 'W 'm 'u)
(fact 'block-type 'm 1 'W '(MAP-SEQ h m u) 'k 1)
(fact 'block-type 'm 1 'V 'u 'k 1)
(fact 'map-seq-type 'h 'V 'W 'k '(BLOCK u k 1))
(dk-have! '(FORALL i (IMPLIES (IN i (INTERVAL 1 k)) (FORALL j (IMPLIES (IN j (INTERVAL 1 1))
             (= (ENTRY (BLOCK (MAP-SEQ h m u) k 1) i j) (ENTRY (MAP-SEQ h k (BLOCK u k 1)) i j))))))
  (lambda ()
    (let* ((ld (dk-peel!))
           (i (lzf-iv-var ld '(INTERVAL 1 k)))
           (j (lzf-iv-var ld '(INTERVAL 1 1))))
      (fact 'interval-elt-in-nn 1 1 j)
      (fact 'interval-lo 1 1 j)
      (fact 'interval-hi 1 1 j)
      (dk-cite! 'nn-le-antisym j 1)
      (subst (list '= j 1))
      (fact 'interval-widen 'k 'm 1 i)
      (subst (dk-cite! 'entry-of-block '(MAP-SEQ h m u) 'k 1 i 1 'm 1 'W))
      (subst (dk-cite! 'map-seq-entry 'h 'V 'W 'm 'u i))
      (subst (dk-cite! 'map-seq-entry 'h 'V 'W 'k '(BLOCK u k 1) i))
      (subst (dk-cite! 'entry-of-block 'u 'k 1 i 1 'm 1 'V))
      (fact 'entry-in-carrier 'm 1 'V 'u i 1)
      (lzf-fapp! 'h (list 'ENTRY 'u i 1) 'V 'W)
      (rfl))))
(fact 'matrix-entry-extensionality 'k 1 'W '(BLOCK (MAP-SEQ h m u) k 1) '(MAP-SEQ h k (BLOCK u k 1)))
(if (not (lzf-grounded?)) (ass))
(lzf-done! 'map-seq-block)

;;; ---- hom-lincomb, by induction on the length -------------------------------------------
(define (lzf-hl-claim n)
  (list 'FORALL 'A (list 'FORALL 'B (list 'FORALL 'h (list 'IMPLIES '(IS-HOM-MODULE A B h)
    (list 'FORALL 'c (list 'FORALL 'u (list 'IMPLIES (list 'IN 'c (list 'MAT 1 n '(CARR (SCAL A))))
      (list 'IMPLIES (list 'IN 'u (list 'MAT n 1 '(VEC A)))
        (list '= (list 'h (list 'LINCOMB 'A n 'c 'u)) (list 'LINCOMB 'B n 'c (list 'MAP-SEQ 'h n 'u))))))))))))
(define (lzf-find-succ e)
  (cond ((and (pair? e) (eq? (car e) 'succ) (symbol? (cadr e))) (cadr e))
        ((pair? e) (or (lzf-find-succ (car e)) (lzf-find-succ (cdr e))))
        (#t #f)))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (lzf-hl-claim 'n)))))
(let* ((opened (cdr (assq 'cases (dk-ni-fixed! '(A B h)))))   ; W1D: A, B, h fixed
       (step (find-first (lambda (l) (dk-contains? (dk-goal-of l) 'succ)) opened))
       (base (find-first (lambda (l) (not (eq? l step))) opened)))
  ;; ---- base ----
  (dk-focus! base)
  (dk-peel!)
  (let* ((g (dk-goal))
         (lhs (cadr g)) (rhs (caddr g))
         (h (car lhs)) (lc (cadr lhs))
         (a (cadr lc)) (c (cadddr lc)) (u (car (cddddr lc)))
         (b (cadr rhs)))
    (lzf-hom-open! a b h)
    (fact 'nn-zero-in)
    (fact 'map-seq-type h (list 'VEC a) (list 'VEC b) 0 u)
    (subst (dk-cite! 'lincomb-empty a c u))
    (subst (dk-cite! 'lincomb-empty b c (list 'MAP-SEQ h 0 u)))
    (ass))
  ;; ---- step ----
  (dk-focus! step)
  (let* ((k (lzf-find-succ (dk-goal)))
         (sk (list 'succ k))
         (ih (caddr (caddr (caddr (caddr (lzf-hl-claim k))))))   ; W1D: the claim at the fixed A, B, h
         (ld (dk-peel!))
         (g (dk-goal))
         (lhs (cadr g)) (rhs (caddr g))
         (h (car lhs)) (lc (cadr lhs))
         (a (cadr lc)) (c (cadddr lc)) (u (car (cddddr lc)))
         (b (cadr rhs))
         (va (list 'VEC a)) (vb (list 'VEC b))
         (sa (list 'CARR (list 'SCAL a))) (sb (list 'CARR (list 'SCAL b)))
         (bc (list 'BLOCK c 1 k)) (bu (list 'BLOCK u k 1))
         (ms (list 'MAP-SEQ h sk u))
         (r (list 'ENTRY c 1 sk)) (x (list 'ENTRY u sk 1)))
    (if (not (dk-asm? ih)) (error "lzf hom-lincomb: no induction hypothesis" (expression->string ih)))
    (lzf-hom-open! a b h)
    (fact 'nn-one-in)
    (fact 'nn-succ-closed k)
    (fact 'nn-le-succ k)
    (fact 'nn-le-refl 1)
    (fact 'one-in-interval-1)
    (dk-have! (list '<= 1 sk) (lambda () (dk-nn!)))
    (fact 'nn-le-refl sk)
    (fact 'interval-mem-intro 1 sk sk)
    (fact 'block-type 1 sk sa c 1 k)
    (fact 'block-type sk 1 va u k 1)
    (fact 'entry-in-carrier 1 sk sa c 1 sk)
    (fact 'entry-in-carrier sk 1 va u sk 1)
    (fact 'lincomb-type a k bc bu)
    (fact 'module-act-type a r x)
    (subst (dk-cite! 'lincomb-row-peel a k c u))
    (subst (dk-apply! (lzf-hcl-add a b h) (list 'LINCOMB a k bc bu) (list (list 'ACT a) r x)))
    (subst (dk-apply! (lzf-hcl-act a b h) r x))
    (subst (dk-apply! ih bc bu))   ; W1D: A, B, h fixed
    ;; the right side
    (fact 'map-seq-type h va vb sk u)
    (let ((cb (dk-rewrite-h! (list 'IN c (list 'MAT 1 sk sa)) (list 'SCAL a) (list 'SCAL b))))
      (subst (dk-cite! 'lincomb-row-peel b k c ms)))
    (subst (dk-cite! 'map-seq-block h va vb sk k u))
    (subst (dk-cite! 'map-seq-entry h va vb sk u sk))
    ;; both sides are now one term; type it
    (let ((bcb (dk-rewrite-h! (list 'IN bc (list 'MAT 1 k sa)) (list 'SCAL a) (list 'SCAL b)))
          (rb (dk-rewrite-h! (list 'IN r sa) (list 'SCAL a) (list 'SCAL b))))
      (fact 'map-seq-type h va vb k bu)
      (fact 'lincomb-type b k bc (list 'MAP-SEQ h k bu))
      (lzf-fapp! h x va vb)
      (fact 'module-act-type b r (list h x))
      (fact 'module-vadd-type b (list 'LINCOMB b k bc (list 'MAP-SEQ h k bu)) (list (list 'ACT b) r (list h x)))
      (rfl))))
(lzf-done! 'lzf-hom-lincomb-ind)

(sp (make-wff (forall-guarded '(A B h) '((IS-HOM-MODULE A B h))
  (forall-guarded '(n c u) '((IN n NN) (IN c (MAT 1 n (CARR (SCAL A)))) (IN u (MAT n 1 (VEC A))))
    '(= (h (LINCOMB A n c u)) (LINCOMB B n c (MAP-SEQ h n u)))))))
(dk-peel!)
(dk-apply! (dk-cite! 'lzf-hom-lincomb-ind 'n) 'A 'B 'h 'c 'u)
(ass)
(lzf-done! 'hom-lincomb)
(gloss! 'hom-lincomb "A module homomorphism h carries the combination c_1 u_1 + ... + c_n u_n to c_1 h(u_1) + ... + c_n h(u_n).")

;;; =====================================================================
;;; (B) isomorphisms: the inverse and the composite.
;;; =====================================================================
(define LZF-GINV '(INVERSE-BIJ f (VEC A) (VEC B)))
(define (lzf-gat y) (list LZF-GINV y))
;; goal (= (G Y) X) with X in VEC A and Y = f(X) proved by FEQ (a thunk, goal (= Y (f X)))
(define (lzf-inv-at! y x feq)
  (dk-have! (list '= y (list 'f x)) feq)
  (subst (list '= y (list 'f x)))
  (dk-cite! 'inverse-bij-left '(VEC A) '(VEC B) 'f x)
  (ass))
(define (lzf-gy! y)                     ; land (G y) in VEC A and f(G y) = y, for y in VEC B
  (lzf-fapp! LZF-GINV y '(VEC B) '(VEC A))
  (dk-cite! 'inverse-bij-right '(VEC A) '(VEC B) 'f y))
(sp (make-wff (forall-guarded '(A B f) '((IS-ISO-MODULE A B f)) (list 'IS-ISO-MODULE 'B 'A LZF-GINV))))
(dk-peel!)
(lzf-split-all! (dk-meta-iff-r! (dk-meta-iff! 'is-iso-module 'A 'B 'f)))
(lzf-hom-open! 'A 'B 'f)
(fact 'inverse-bij-is-bijection '(VEC A) '(VEC B) 'f)
(fact 'inverse-bij-in-fun '(VEC A) '(VEC B) 'f)
(mac 'IS-ISO-MODULE)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal))
        (ass)
        (lzf-prove-hom! 'B 'A LZF-GINV
          (lambda (y1 y2)                ; G(y1 + y2) = G y1 + G y2
            (lzf-gy! y1) (lzf-gy! y2)
            (let ((x1 (lzf-gat y1)) (x2 (lzf-gat y2)))
              (fact 'module-vadd-type 'A x1 x2)
              (lzf-inv-at! (list '(VADD B) y1 y2) (list '(VADD A) x1 x2)
                (lambda ()
                  (subst (dk-apply! (lzf-hcl-add 'A 'B 'f) x1 x2))
                  (subst (list '= (list 'f x1) y1))
                  (subst (list '= (list 'f x2) y2))
                  (fact 'module-vadd-type 'B y1 y2)
                  (rfl)))))
          (lambda (y)                    ; G(-y) = -G y
            (lzf-gy! y)
            (let ((x (lzf-gat y)))
              (fact 'module-vneg-type 'A x)
              (lzf-inv-at! (list '(VNEG B) y) (list '(VNEG A) x)
                (lambda ()
                  (subst (dk-apply! (lzf-hcl-neg 'A 'B 'f) x))
                  (subst (list '= (list 'f x) y))
                  (fact 'module-vneg-type 'B y)
                  (rfl)))))
          (lambda (r y)                  ; G(r y) = r G y
            (lzf-gy! y)
            (let ((x (lzf-gat y)))
              (dk-have! (list 'IN r '(CARR (SCAL A))) (lambda () (subst '(= (SCAL A) (SCAL B))) (ass)))
              (fact 'module-act-type 'A r x)
              (lzf-inv-at! (list '(ACT B) r y) (list '(ACT A) r x)
                (lambda ()
                  (subst (dk-apply! (lzf-hcl-act 'A 'B 'f) r x))
                  (subst (list '= (list 'f x) y))
                  (fact 'module-act-type 'B r y)
                  (rfl)))))
          (lambda ()                     ; G(0) = 0
            (fact 'module-vzero-in 'A)
            (lzf-inv-at! '(VZERO B) '(VZERO A)
              (lambda ()
                (subst (lzf-hcl-zero 'A 'B 'f))
                (fact 'module-vzero-in 'B)
                (rfl))))))))
(lzf-done! 'iso-module-inverse)
(gloss! 'iso-module-inverse "The inverse of a module isomorphism is a module isomorphism.")

(sp (make-wff (forall-guarded '(A B C f g) '((IS-ISO-MODULE A B f) (IS-ISO-MODULE B C g))
  '(IS-ISO-MODULE A C (COMPOSE g f)))))
(dk-peel!)
(lzf-split-all! (dk-meta-iff-r! (dk-meta-iff! 'is-iso-module 'A 'B 'f)))
(lzf-split-all! (dk-meta-iff-r! (dk-meta-iff! 'is-iso-module 'B 'C 'g)))
(lzf-hom-open! 'A 'B 'f)
(lzf-hom-open! 'B 'C 'g)
(fact 'hom-module-compose 'A 'B 'C 'f 'g)
(fact 'frm-module-vec-set 'A)
(fact 'frm-module-vec-set 'C)
(fact 'bijection-in-fun '(VEC A) '(VEC B) 'f)
(fact 'bijection-in-fun '(VEC B) '(VEC C) 'g)
(fact 'inverse-bij-in-fun '(VEC A) '(VEC B) 'f)
(fact 'inverse-bij-in-fun '(VEC B) '(VEC C) 'g)
(let* ((fi '(INVERSE-BIJ f (VEC A) (VEC B)))
       (gi '(INVERSE-BIJ g (VEC B) (VEC C)))
       (gf '(COMPOSE g f))
       (ig (list 'COMPOSE fi gi)))
  (dk-have! '(AND (IN f (FUN (VEC A) (VEC B))) (IN g (FUN (VEC B) (VEC C)))) (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'compose-type '(VEC A) '(VEC B) '(VEC C) 'g 'f)
  (dk-have! (list 'AND (list 'IN gi '(FUN (VEC C) (VEC B))) (list 'IN fi '(FUN (VEC B) (VEC A)))) (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'compose-type '(VEC C) '(VEC B) '(VEC A) fi gi)
  (mac 'IS-ISO-MODULE)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (begin
            (dk-have! (list 'FORALL 'u_ (list 'IMPLIES '(IN u_ (VEC A)) (list '= (list ig (list gf 'u_)) 'u_)))
              (lambda ()
                (let* ((ld (dk-peel!)) (x (lzf-iv-var ld '(VEC A))))
                  (subst (dk-cite! 'compose-apply '(VEC A) '(VEC B) '(VEC C) 'g 'f x))
                  (lzf-fapp! 'f x '(VEC A) '(VEC B))
                  (lzf-fapp! 'g (list 'f x) '(VEC B) '(VEC C))
                  (subst (dk-cite! 'compose-apply '(VEC C) '(VEC B) '(VEC A) fi gi (list 'g (list 'f x))))
                  (subst (dk-cite! 'inverse-bij-left '(VEC B) '(VEC C) 'g (list 'f x)))
                  (subst (dk-cite! 'inverse-bij-left '(VEC A) '(VEC B) 'f x))
                  (rfl))))
            (dk-have! (list 'FORALL 'v_ (list 'IMPLIES '(IN v_ (VEC C)) (list '= (list gf (list ig 'v_)) 'v_)))
              (lambda ()
                (let* ((ld (dk-peel!)) (y (lzf-iv-var ld '(VEC C))))
                  (subst (dk-cite! 'compose-apply '(VEC C) '(VEC B) '(VEC A) fi gi y))
                  (lzf-fapp! gi y '(VEC C) '(VEC B))
                  (lzf-fapp! fi (list gi y) '(VEC B) '(VEC A))
                  (subst (dk-cite! 'compose-apply '(VEC A) '(VEC B) '(VEC C) 'g 'f (list fi (list gi y))))
                  (subst (dk-cite! 'inverse-bij-right '(VEC A) '(VEC B) 'f (list gi y)))
                  (subst (dk-cite! 'inverse-bij-right '(VEC B) '(VEC C) 'g y))
                  (rfl))))
            (fact 'bijection-from-inverse '(VEC A) '(VEC C) gf ig)
            (if (not (lzf-grounded?)) (ass)))))))
(lzf-done! 'iso-module-compose)
(gloss! 'iso-module-compose "The composite of two module isomorphisms is a module isomorphism.")

;;; =====================================================================
;;; (C) direct sums: evaluation at an index; the free module Z^n.
;;; =====================================================================
;;; ---- a combination with one nonzero vector ----------------------------------------
(define LZF-LCS '(VNB-LAMBDA j (INTERVAL 1 n) ((ACT md) (ENTRY c 1 j) (ENTRY u j 1))))
(sp (make-wff (forall-guarded '(md n c u i)
  '((IS-MODULE md) (IN n NN) (IN c (MAT 1 n (CARR (SCAL md)))) (IN u (MAT n 1 (VEC md))) (IN i (INTERVAL 1 n))
    (FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 n)) (IMPLIES (NOT (= j_ i)) (= (ENTRY u j_ 1) (VZERO md))))))
  '(= (LINCOMB md n c u) ((ACT md) (ENTRY c 1 i) (ENTRY u i 1))))))
(dk-peel!)
(fact 'module-scalar-ring 'md)
(fact 'one-in-interval-1)
(fact 'interval-in-set 1 'n)
(fact 'nn-one-in)
(fact 'interval-card-in-nn 1 'n)
(fact 'mvag-carr 'md)
(fact 'mvag-id 'md)
(fact 'module-vector-ag-is-abelian-group 'md)
(fact 'module-vzero-in 'md)
(mac 'lincomb-unfold)
(dk-have! (list 'IN LZF-LCS '(FUN (INTERVAL 1 n) (CARR (MODULE-VECTOR-AG md))))
  (lambda ()
    (subst '(= (CARR (MODULE-VECTOR-AG md)) (VEC md)))
    (dk-lam-type!
      (lambda ()
        (let* ((ld (dk-peel!)) (j (cadr (car ld))))
          (if (not (lzf-beta!))
              (begin
                (fact 'entry-in-carrier 1 'n '(CARR (SCAL md)) 'c 1 j)
                (fact 'entry-in-carrier 'n 1 '(VEC md) 'u j 1)
                (fact 'module-act-type 'md (list 'ENTRY 'c 1 j) (list 'ENTRY 'u j 1))
                (ass)))))
      (lambda () (ass)))))
(dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 n)) (list 'IMPLIES '(NOT (= j i))
            (list '= (list LZF-LCS 'j) '(IDEN (MODULE-VECTOR-AG md))))))
  (lambda ()
    (let* ((ld (dk-peel!)) (j (lzf-iv-var ld '(INTERVAL 1 n))))
      (if (not (lzf-beta!))
          (begin
            (subst (dk-apply! '(FORALL j_ (IMPLIES (IN j_ (INTERVAL 1 n)) (IMPLIES (NOT (= j_ i)) (= (ENTRY u j_ 1) (VZERO md))))) j))
            (subst '(= (IDEN (MODULE-VECTOR-AG md)) (VZERO md)))
            (fact 'entry-in-carrier 1 'n '(CARR (SCAL md)) 'c 1 j)
            (subst (dk-cite! 'module-act-zero-vec 'md (list 'ENTRY 'c 1 j)))
            (rfl))))))
(subst (dk-cite! 'finsum-single-support '(MODULE-VECTOR-AG md) '(INTERVAL 1 n) LZF-LCS 'i))
(fact 'entry-in-carrier 1 'n '(CARR (SCAL md)) 'c 1 'i)
(fact 'entry-in-carrier 'n 1 '(VEC md) 'u 'i 1)
(fact 'module-act-type 'md '(ENTRY c 1 i) '(ENTRY u i 1))
(if (not (lzf-beta!)) (rfl))
(lzf-done! 'lincomb-single-support)
(gloss! 'lincomb-single-support "A combination c_1 u_1 + ... + c_n u_n in which every u_j with j /= i is zero equals c_i u_i.")

;;; ---- evaluation at an index of a direct sum -----------------------------------------
(define LZF-HM '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 n)) (IS-MODULE (F i_)))))
(define LZF-HS '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 n)) (= (SCAL (F i_)) S))))
(define LZF-DS '(DIRECT-SUM S n F))
(define (lzf-ev i) (list 'VNB-LAMBDA 'evx_ (list 'VEC LZF-DS) (list 'evx_ i)))
(define (lzf-dstmt vars guards body)
  (forall-guarded (append '(S n F) vars) (append (list '(IS-RING S) '(IN n NN) LZF-HM LZF-HS) guards) body))
(define (lzf-ds-setup! i)
  (fact 'direct-sum-is-module 'S 'n 'F)
  (for-each (lambda (nm) (fact nm 'S 'n 'F)) '(dsum-ro-scal dsum-ro-vec dsum-ro-vadd dsum-ro-vzero dsum-ro-vneg dsum-ro-act dsum-vec-set2))
  (if i (begin (dk-apply! LZF-HM i) (dk-apply! LZF-HS i))))
(define (lzf-ev-fun! i)
  (let ((ev (lzf-ev i)))
    (if (not (dk-asm? (list 'IN ev (list 'FUN (list 'VEC LZF-DS) (list 'VEC (list 'F i))))))
        (dk-have! (list 'IN ev (list 'FUN (list 'VEC LZF-DS) (list 'VEC (list 'F i))))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let* ((ld (dk-peel!)) (x (lzf-iv-var ld (list 'VEC LZF-DS))))
                  (if (not (lzf-beta!))
                      (begin (fact 'dsum-member-elim 'S 'n 'F x i) (ass)))))
              (lambda () (ass))))))))
(sp (make-wff (lzf-dstmt '(i) '((IN i (INTERVAL 1 n))) (list 'IS-HOM-MODULE LZF-DS '(F i) (lzf-ev 'i)))))
(dk-peel!)
(lzf-ds-setup! 'i)
(lzf-ev-fun! 'i)
(define (lzf-dsv! x)                    ; (IN x (DSUM-VEC n F)) from (IN x (VEC DS))
  (if (not (dk-asm? (list 'IN x '(DSUM-VEC n F))))
      (dk-rewrite-h! (list 'IN x (list 'VEC LZF-DS)) (list 'VEC LZF-DS) '(DSUM-VEC n F))))
(let ((ev (lzf-ev 'i)) (vds (list 'VEC LZF-DS)))
  (lzf-prove-hom! LZF-DS '(F i) ev
    (lambda (x y)
      (fact 'module-vadd-type LZF-DS x y)
      (lzf-dsv! x) (lzf-dsv! y)
      (if (not (dk-lam-b!)) (begin (fact 'dsum-vadd-at 'S 'n 'F x y 'i) (ass))))
    (lambda (x)
      (fact 'module-vneg-type LZF-DS x)
      (lzf-dsv! x)
      (if (not (dk-lam-b!)) (begin (fact 'dsum-vneg-at 'S 'n 'F x 'i) (ass))))
    (lambda (r x)
      (fact 'module-act-type LZF-DS r x)
      (lzf-dsv! x)
      (dk-rewrite-h! (list 'IN r (list 'CARR (list 'SCAL LZF-DS))) (list 'SCAL LZF-DS) 'S)
      (if (not (dk-lam-b!)) (begin (fact 'dsum-act-at 'S 'n 'F r x 'i) (ass))))
    (lambda ()
      (fact 'module-vzero-in LZF-DS)
      (if (not (dk-lam-b!)) (begin (fact 'dsum-vzero-at 'S 'n 'F 'i) (ass))))
    (lambda ()
      (subst (list '= (list 'SCAL LZF-DS) 'S))
      (subst '(= (SCAL (F i)) S))
      (rfl))))
(lzf-done! 'dsum-eval-hom)
(gloss! 'dsum-eval-hom "Evaluation at an index i is a module homomorphism from a direct sum onto its i-th summand.")

(sp (make-wff (lzf-dstmt '(m c u i) (list '(IN m NN) '(IN c (MAT 1 m (CARR S))) (list 'IN 'u (list 'MAT 'm 1 (list 'VEC LZF-DS))) '(IN i (INTERVAL 1 n)))
  (list '= (list (list 'LINCOMB LZF-DS 'm 'c 'u) 'i) (list 'LINCOMB '(F i) 'm 'c (list 'MAP-SEQ (lzf-ev 'i) 'm 'u))))))
(dk-peel!)
(lzf-ds-setup! 'i)
(fact 'dsum-eval-hom 'S 'n 'F 'i)
(dk-have! (list 'IN 'c (list 'MAT 1 'm (list 'CARR (list 'SCAL LZF-DS))))
  (lambda () (subst (list '= (list 'SCAL LZF-DS) 'S)) (ass)))
(fact 'lincomb-type LZF-DS 'm 'c 'u)
(let ((e (dk-cite! 'hom-lincomb LZF-DS '(F i) (lzf-ev 'i) 'm 'c 'u)))
  (dk-lam-b-h! e)
  (ass))
(lzf-done! 'dsum-lincomb-at)
(gloss! 'dsum-lincomb-at "The i-th component of a combination in a direct sum is the combination of the i-th components.")

;;; ---- Z^n -------------------------------------------------------------------------------
(define LZF-ZFAM '(VNB-LAMBDA zpi_ (INTERVAL 1 n) (RING-AS-MODULE ZZ-RING)))
(define LZF-DSZ (list 'DIRECT-SUM 'ZZ-RING 'n LZF-ZFAM))
(define LZF-ZP '(ZZ-POW n))
(define LZF-RAM '(RING-AS-MODULE ZZ-RING))
(define LZF-UN '(ZZ-UNITS n))
(define (lzf-unit k) (list 'VNB-LAMBDA 'zut_ '(INTERVAL 1 n) (list 'ENTRY (list 'UNITROW 'ZZ-RING 'n k) 1 'zut_)))
(define LZF-ZHM (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 n)) (list 'IS-MODULE (list LZF-ZFAM 'i_)))))
(define LZF-ZHS (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 n)) (list '= (list 'SCAL (list LZF-ZFAM 'i_)) 'ZZ-RING))))

(sp (make-wff (list 'FORALL 'n (list '== LZF-ZP LZF-DSZ))))
(di)
(mac 'ZZ-POW)
(qrfl)
(lzf-done! 'zz-pow-unfold)

(sp (make-wff (forall-guarded '(n) '((IN n NN)) (list 'AND LZF-ZHM LZF-ZHS))))
(dk-peel!)
(fact 'zz-is-ring)
(fact 'ring-as-module-is-module 'ZZ-RING)
(fact 'ram-ro-scal 'ZZ-RING)
(dk-conj-close!
  (lambda ()
    (let* ((ld (dk-peel!)))
      (if (not (lzf-beta!))
          (if (dk-head-is? (dk-goal) 'IS-MODULE)
              (ass)
              (begin (subst (list '= (list 'SCAL LZF-RAM) 'ZZ-RING)) (rfl)))))))
(lzf-done! 'zz-pow-family)

(define (lzf-zsetup!)                   ; n in NN in context
  (fact 'zz-is-ring)
  (fact 'zz-is-commutative-ring)
  (fact 'nn-one-in)
  (fact 'one-in-interval-1)
  (fact 'ring-as-module-is-module 'ZZ-RING)
  (for-each (lambda (nm) (fact nm 'ZZ-RING)) '(ram-ro-scal ram-ro-vec ram-ro-vadd ram-ro-vzero ram-ro-vneg ram-ro-act))
  (if (not (dk-asm? '(== (CARR ZZ-RING) ZZ)))
      (dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl))))
  (if (not (dk-asm? LZF-ZHM)) (dk-split! (dk-cite! 'zz-pow-family 'n)))
  (fact 'direct-sum-is-module 'ZZ-RING 'n LZF-ZFAM)
  (for-each (lambda (nm) (fact nm 'ZZ-RING 'n LZF-ZFAM)) '(dsum-ro-scal dsum-ro-vec dsum-ro-vadd dsum-ro-vzero dsum-ro-vneg dsum-ro-act dsum-vec-set2))
  (fact 'zz-pow-unfold 'n))
(define (lzf-zp->ds!) (if (dk--occurs? LZF-ZP (dk-goal)) (subst (list '= LZF-ZP LZF-DSZ))))
(define (lzf-fam-ram! i)                ; (== (ZFAM i) RAM) for i in [1,n] in context
  (let ((e (list '== (list LZF-ZFAM i) LZF-RAM)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (if (not (dk-lam-b!)) (qrfl)))))
    e))

(sp (make-wff (forall-guarded '(n) '((IN n NN)) '(IS-MODULE (ZZ-POW n)))))
(dk-peel!)
(lzf-zsetup!)
(lzf-zp->ds!)
(ass)
(lzf-done! 'zz-pow-is-module)
(gloss! 'zz-pow-is-module "Z^n, the direct sum of n copies of Z, is a module over Z.")

(sp (make-wff (forall-guarded '(n) '((IN n NN)) '(= (SCAL (ZZ-POW n)) ZZ-RING))))
(dk-peel!)
(lzf-zsetup!)
(lzf-zp->ds!)
(subst (list '= (list 'SCAL LZF-DSZ) 'ZZ-RING))
(rfl)
(lzf-done! 'zz-pow-scal)

(sp (make-wff (forall-guarded '(n x) '((IN n NN) (IN x (FUN (INTERVAL 1 n) ZZ))) '(IN x (VEC (ZZ-POW n))))))
(dk-peel!)
(lzf-zsetup!)
(lzf-zp->ds!)
(dk-have! '(IN x (FUN (INTERVAL 1 n)))
  (lambda ()
    (mac-h 'fun-codomain-iff (dk-ctx-form '(IN x (FUN (INTERVAL 1 n) ZZ))))
    (dk-split-all!)
    (ass)))
(dk-have! (list 'FORALL 'dsj_ (list 'IMPLIES '(IN dsj_ (INTERVAL 1 n)) (list 'IN '(x dsj_) (list 'VEC (list LZF-ZFAM 'dsj_)))))
  (lambda ()
    (let* ((ld (dk-peel!)) (j (lzf-iv-var ld '(INTERVAL 1 n))))
      (lzf-fam-ram! j)
      (subst (list '= (list LZF-ZFAM j) LZF-RAM))
      (subst (list '= (list 'VEC LZF-RAM) '(CARR ZZ-RING)))
      (subst '(= (CARR ZZ-RING) ZZ))
      (fact 'fun-apply-type-c 'x '(INTERVAL 1 n) 'ZZ j)
      (ass))))
(fact 'dsum-member-intro 'ZZ-RING 'n LZF-ZFAM 'x)
(ass)
(lzf-done! 'zz-pow-vec-in)

(sp (make-wff (forall-guarded '(n x i) '((IN n NN) (IN x (VEC (ZZ-POW n))) (IN i (INTERVAL 1 n))) '(IN (x i) ZZ))))
(dk-peel!)
(lzf-zsetup!)
(let* ((h1 (dk-rewrite-h! '(IN x (VEC (ZZ-POW n))) LZF-ZP LZF-DSZ))
       (h2 (dk-cite! 'dsum-member-elim 'ZZ-RING 'n LZF-ZFAM 'x 'i)))
  (lzf-fam-ram! 'i)
  (let* ((h3 (dk-rewrite-h! h2 (list LZF-ZFAM 'i) LZF-RAM))
         (h4 (dk-rewrite-h! h3 (list 'VEC LZF-RAM) '(CARR ZZ-RING)))
         (h5 (dk-rewrite-h! h4 '(CARR ZZ-RING) 'ZZ)))
    (ass)))
(lzf-done! 'zz-pow-vec-out)

(sp (make-wff (forall-guarded '(n x y) '((IN n NN) (IN x (VEC (ZZ-POW n))) (IN y (VEC (ZZ-POW n)))
    (FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 n)) (= (x i_) (y i_)))))
  '(= x y))))
(dk-peel!)
(lzf-zsetup!)
(dk-rewrite-h! '(IN x (VEC (ZZ-POW n))) LZF-ZP LZF-DSZ)
(dk-rewrite-h! '(IN y (VEC (ZZ-POW n))) LZF-ZP LZF-DSZ)
(fact 'dsum-ext 'ZZ-RING 'n LZF-ZFAM 'x 'y)
(ass)
(lzf-done! 'zz-pow-ext)

(sp (make-wff (forall-guarded '(n i) '((IN n NN) (IN i (INTERVAL 1 n))) '(= ((VZERO (ZZ-POW n)) i) (ZERO ZZ-RING)))))
(dk-peel!)
(lzf-zsetup!)
(lzf-zp->ds!)
(subst (dk-cite! 'dsum-vzero-at 'ZZ-RING 'n LZF-ZFAM 'i))
(lzf-fam-ram! 'i)
(subst (list '= (list LZF-ZFAM 'i) LZF-RAM))
(subst (list '= (list 'VZERO LZF-RAM) '(ZERO ZZ-RING)))
(fact 'ring-zero-in 'ZZ-RING)
(rfl)
(lzf-done! 'zz-pow-vzero-at)

;;; ---- the unit vectors ------------------------------------------------------------------
(sp (make-wff (forall-guarded '(n k) '((IN n NN)) (list 'IN (lzf-unit 'k) '(VEC (ZZ-POW n))))))
(dk-peel!)
(lzf-zsetup!)
(fact 'unitrow-type 'ZZ-RING 'n 'k)
(dk-have! (list 'IN (lzf-unit 'k) '(FUN (INTERVAL 1 n) ZZ))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let* ((ld (dk-peel!)) (t (lzf-iv-var ld '(INTERVAL 1 n))))
          (if (not (lzf-beta!))
              (let ((e (list 'ENTRY '(UNITROW ZZ-RING n k) 1 t)))
                (fact 'entry-in-carrier 1 'n '(CARR ZZ-RING) '(UNITROW ZZ-RING n k) 1 t)
                (dk-rewrite-h! (list 'IN e '(CARR ZZ-RING)) '(CARR ZZ-RING) 'ZZ)
                (ass)))))
      (lambda () (fact 'interval-in-set 1 'n) (ass)))))
(fact 'zz-pow-vec-in 'n (lzf-unit 'k))
(ass)
(lzf-done! 'zz-unit-vec)

(define LZF-UG '(VNB-LAMBDA (LIST zua_ zub_) (CARTESIAN (INTERVAL 1 n) (INTERVAL 1 1))
                  (VNB-LAMBDA zut_ (INTERVAL 1 n) (ENTRY (UNITROW ZZ-RING n zua_) 1 zut_))))
(define (lzf-ug-pt! cls finish)         ; forall i in [1,n], j in [1,1]. UG(i,j) in CLS
  (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n))
              (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 1)) (list 'IN (list LZF-UG 'i 'j) cls)))))
    (lambda ()
      (let* ((ld (dk-peel!))
             (i (lzf-iv-var ld '(INTERVAL 1 n))))
        (if (not (lzf-beta!))
            (begin
              (fact 'zz-unit-vec 'n i)
              (finish (lzf-unit i))
              (ass)))))))
(sp (make-wff (forall-guarded '(n) '((IN n NN)) '(IN (ZZ-UNITS n) (MAT n 1 (VEC (ZZ-POW n)))))))
(dk-peel!)
(fact 'nn-one-in)
(fact 'zz-pow-is-module 'n)
(mac 'ZZ-UNITS)
(lzf-ug-pt! '(VEC (ZZ-POW n)) (lambda (t) #t))
(fact 'matof-in-mat 'n 1 '(VEC (ZZ-POW n)) LZF-UG)
(ass)
(lzf-done! 'zz-units-type)

(sp (make-wff (forall-guarded '(n k) '((IN n NN) (IN k (INTERVAL 1 n))) (list '= '(ENTRY (ZZ-UNITS n) k 1) (lzf-unit 'k)))))
(dk-peel!)
(fact 'nn-one-in)
(fact 'one-in-interval-1)
(fact 'zz-unit-vec 'n 'k)
(fact 'zz-pow-is-module 'n)
(mac 'ZZ-UNITS)
(lzf-ug-pt! 'SET (lambda (t) (fact 'membership-implies-sethood t '(VEC (ZZ-POW n)))))
(subst (dk-cite! 'entry-of-matof 'n 1 LZF-UG 'k 1))
(if (not (lzf-beta!)) (rfl))
(lzf-done! 'zz-units-entry)

(sp (make-wff (forall-guarded '(n k i) '((IN n NN) (IN i (INTERVAL 1 n)))
  (list '= (list (lzf-unit 'k) 'i) '(ENTRY (UNITROW ZZ-RING n k) 1 i)))))
(dk-peel!)
(fact 'zz-is-ring)
(fact 'one-in-interval-1)
(fact 'unitrow-type 'ZZ-RING 'n 'k)
(fact 'entry-in-carrier 1 'n '(CARR ZZ-RING) '(UNITROW ZZ-RING n k) 1 'i)
(if (not (lzf-beta!)) (rfl))
(lzf-done! 'zz-unit-at)

;;; ---- the components of a combination of the unit vectors -----------------------------
;; the entry at j of the image sequence of the units under evaluation at i: rewritten to e_j(i)
(define (lzf-ms-at! ev j)
  (subst (dk-cite! 'map-seq-entry ev (list 'VEC LZF-DSZ) (list 'VEC LZF-RAM) 'n LZF-UN j))
  (subst (dk-cite! 'zz-units-entry 'n j))
  (fact 'zz-unit-vec 'n j)
  (dk-rewrite-h! (list 'IN (lzf-unit j) (list 'VEC LZF-ZP)) LZF-ZP LZF-DSZ)
  (dk-lam-b!))
(sp (make-wff (forall-guarded '(n c i) '((IN n NN) (IN c (MAT 1 n (CARR ZZ-RING))) (IN i (INTERVAL 1 n)))
  '(= ((LINCOMB (ZZ-POW n) n c (ZZ-UNITS n)) i) (ENTRY c 1 i)))))
(dk-peel!)
(lzf-zsetup!)
(fact 'zz-units-type 'n)
(dk-rewrite-h! (list 'IN LZF-UN (list 'MAT 'n 1 (list 'VEC LZF-ZP))) LZF-ZP LZF-DSZ)
(lzf-zp->ds!)
(let* ((ev (list 'VNB-LAMBDA 'evx_ (list 'VEC LZF-DSZ) '(evx_ i)))
       (ms (list 'MAP-SEQ ev 'n LZF-UN)))
  (subst (dk-cite! 'dsum-lincomb-at 'ZZ-RING 'n LZF-ZFAM 'n 'c LZF-UN 'i))
  (lzf-fam-ram! 'i)
  (subst (list '= (list LZF-ZFAM 'i) LZF-RAM))
  (dk-apply! LZF-ZHM 'i)
  (fact 'dsum-eval-hom 'ZZ-RING 'n LZF-ZFAM 'i)
  (lzf-hom-open! LZF-DSZ (list LZF-ZFAM 'i) ev)
  (dk-rewrite-h! (list 'IN ev (list 'FUN (list 'VEC LZF-DSZ) (list 'VEC (list LZF-ZFAM 'i)))) (list LZF-ZFAM 'i) LZF-RAM)
  (fact 'map-seq-type ev (list 'VEC LZF-DSZ) (list 'VEC LZF-RAM) 'n LZF-UN)
  (dk-have! (list 'IN 'c (list 'MAT 1 'n (list 'CARR (list 'SCAL LZF-RAM))))
    (lambda () (subst (list '= (list 'SCAL LZF-RAM) 'ZZ-RING)) (ass)))
  (dk-have! (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ (INTERVAL 1 n)) (list 'IMPLIES '(NOT (= j_ i))
              (list '= (list 'ENTRY ms 'j_ 1) (list 'VZERO LZF-RAM)))))
    (lambda ()
      (let* ((ld (dk-peel!))
             (j (lzf-iv-var ld '(INTERVAL 1 n))))
        (dk-have! (list 'NOT (list '= 'i j))
          (lambda () (di) (dk-cite! 'equality-symmetry 'i j) (ai (list 'NOT (list '= j 'i)))))
        (lzf-ms-at! ev j)
        (subst (dk-cite! 'unitrow-entry-off 'ZZ-RING 'n j 'i))
        (subst (list '= (list 'VZERO LZF-RAM) '(ZERO ZZ-RING)))
        (fact 'ring-zero-in 'ZZ-RING)
        (rfl))))
  (subst (dk-cite! 'lincomb-single-support LZF-RAM 'n 'c ms 'i))
  (lzf-ms-at! ev 'i)
  (subst (dk-cite! 'unitrow-entry-at 'ZZ-RING 'n 'i))
  (subst (list '= (list 'ACT LZF-RAM) '(MUL ZZ-RING)))
  (fact 'entry-in-carrier 1 'n '(CARR ZZ-RING) 'c 1 'i)
  (subst (dk-cite! 'ring-mul-right-id 'ZZ-RING '(ENTRY c 1 i)))
  (rfl))
(lzf-done! 'zz-pow-lincomb-at)
(gloss! 'zz-pow-lincomb-at "In Z^n the i-th component of c_1 e_1 + ... + c_n e_n is c_i.")

;;; ---- the coefficient row of a vector ---------------------------------------------------
(define LZF-RG '(VNB-LAMBDA (LIST zra_ zrb_) (CARTESIAN (INTERVAL 1 1) (INTERVAL 1 n)) (x zrb_)))
(define (lzf-rg-pt! cls)                 ; forall i in [1,1], j in [1,n]. RG(i,j) in CLS (CARR ZZ-RING or SET)
  (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 1))
              (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 n)) (list 'IN (list LZF-RG 'i 'j) cls)))))
    (lambda ()
      (let* ((ld (dk-peel!))
             (j (lzf-iv-var ld '(INTERVAL 1 n))))
        (if (not (lzf-beta!))
            (begin
              (fact 'zz-pow-vec-out 'n 'x j)
              (if (equal? cls 'SET)
                  (fact 'membership-implies-sethood (list 'x j) 'ZZ)
                  (dk-rewrite-h! (list 'IN (list 'x j) 'ZZ) 'ZZ '(CARR ZZ-RING)))
              (ass)))))))
(sp (make-wff (forall-guarded '(n x) '((IN n NN) (IN x (VEC (ZZ-POW n)))) '(IN (ZZ-ROW n x) (MAT 1 n (CARR ZZ-RING))))))
(dk-peel!)
(lzf-zsetup!)
(mac 'ZZ-ROW)
(lzf-rg-pt! '(CARR ZZ-RING))
(fact 'matof-in-mat 1 'n '(CARR ZZ-RING) LZF-RG)
(ass)
(lzf-done! 'zz-row-type)

(sp (make-wff (forall-guarded '(n x i) '((IN n NN) (IN x (VEC (ZZ-POW n))) (IN i (INTERVAL 1 n))) '(= (ENTRY (ZZ-ROW n x) 1 i) (x i)))))
(dk-peel!)
(lzf-zsetup!)
(fact 'zz-pow-vec-out 'n 'x 'i)
(mac 'ZZ-ROW)
(lzf-rg-pt! 'SET)
(subst (dk-cite! 'entry-of-matof 1 'n LZF-RG 1 'i))
(if (not (lzf-beta!)) (rfl))
(lzf-done! 'zz-row-entry)

(define LZF-ZRL '(LINCOMB (ZZ-POW n) n (ZZ-ROW n x) (ZZ-UNITS n)))
(define (lzf-zrl-type!)                  ; the combination is a vector of Z^n
  (fact 'zz-pow-is-module 'n)
  (fact 'zz-pow-scal 'n)
  (fact 'zz-row-type 'n 'x)
  (fact 'zz-units-type 'n)
  (dk-have! '(IN (ZZ-ROW n x) (MAT 1 n (CARR (SCAL (ZZ-POW n))))) (lambda () (subst '(= (SCAL (ZZ-POW n)) ZZ-RING)) (ass)))
  (fact 'lincomb-type '(ZZ-POW n) 'n '(ZZ-ROW n x) '(ZZ-UNITS n)))
(sp (make-wff (forall-guarded '(n x) '((IN n NN) (IN x (VEC (ZZ-POW n)))) (list '= LZF-ZRL 'x))))
(dk-peel!)
(lzf-zsetup!)
(lzf-zrl-type!)
(dk-have! (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 n)) (list '= (list LZF-ZRL 'i_) '(x i_))))
  (lambda ()
    (let* ((ld (dk-peel!)) (i (lzf-iv-var ld '(INTERVAL 1 n))))
      (subst (dk-cite! 'zz-pow-lincomb-at 'n '(ZZ-ROW n x) i))
      (subst (dk-cite! 'zz-row-entry 'n 'x i))
      (fact 'zz-pow-vec-out 'n 'x i)
      (rfl))))
(fact 'zz-pow-ext 'n LZF-ZRL 'x)
(ass)
(lzf-done! 'zz-pow-row-lincomb)
(gloss! 'zz-pow-row-lincomb "Every vector x of Z^n is x(1) e_1 + ... + x(n) e_n.")

(sp (make-wff (forall-guarded '(n) '((IN n NN)) '(GENERATES (ZZ-POW n) n (ZZ-UNITS n)))))
(dk-peel!)
(lzf-zsetup!)
(fact 'zz-pow-is-module 'n)
(fact 'zz-units-type 'n)
(mac 'GENERATES)
(let* ((ld (dk-peel!)) (x (lzf-iv-var ld '(VEC (ZZ-POW n))))
       (row (list 'ZZ-ROW 'n x))
       (lc (list 'LINCOMB '(ZZ-POW n) 'n row '(ZZ-UNITS n))))
  (fact 'zz-pow-scal 'n)
  (fact 'zz-row-type 'n x)
  (dk-have! (list 'IN row '(MAT 1 n (CARR (SCAL (ZZ-POW n))))) (lambda () (subst '(= (SCAL (ZZ-POW n)) ZZ-RING)) (ass)))
  (ew row)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (begin
            (dk-cite! 'zz-pow-row-lincomb 'n x)
            (dk-cite! 'equality-symmetry lc x)
            (ass))))))
(lzf-done! 'zz-units-generate)

(sp (make-wff (forall-guarded '(n) '((IN n NN)) '(REL-FREE (ZZ-POW n) n (ZZ-UNITS n)))))
(dk-peel!)
(lzf-zsetup!)
(fact 'zz-pow-scal 'n)
(fact 'zz-pow-is-module 'n)
(fact 'zz-units-type 'n)
(mac 'REL-FREE)
(let* ((ld (dk-peel!))
       (c (lzf-iv-var ld '(MAT 1 n (CARR (SCAL (ZZ-POW n))))))
       (j (lzf-iv-var ld '(INTERVAL 1 n)))
       (lc (list 'LINCOMB '(ZZ-POW n) 'n c '(ZZ-UNITS n))))
  (dk-rewrite-h! (list 'IN c '(MAT 1 n (CARR (SCAL (ZZ-POW n))))) '(SCAL (ZZ-POW n)) 'ZZ-RING)
  (let* ((e1 (dk-cite! 'zz-pow-lincomb-at 'n c j))
         (e2 (dk-rewrite-h! e1 lc '(VZERO (ZZ-POW n)))))
    (subst '(= (SCAL (ZZ-POW n)) ZZ-RING))
    (subst (list '= (list 'ENTRY c 1 j) (list '(VZERO (ZZ-POW n)) j)))
    (fact 'zz-pow-vzero-at 'n j)
    (ass)))
(lzf-done! 'zz-units-rel-free)
(gloss! 'zz-units-rel-free "The unit vectors e_1, ..., e_n of Z^n are relation-free; with zz-units-generate, they freely generate Z^n.")

;;; =====================================================================
;;; (D) kernels, maps out of a free module, isomorphisms and free generating sequences.
;;; =====================================================================
;;; ---- the kernel of a homomorphism is a submodule ---------------------------------------
(define LZF-KER '(SEP kx_ (VEC A) (= (h kx_) (VZERO B))))
(define (lzf-in-sep? f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP)))
(define (lzf-ker-out! x)                 ; from (IN x KER): x in VEC A and h(x) = 0, KER kept
  (let ((m (find-first (lambda (f) (and (lzf-in-sep? f) (equal? (cadr f) x))) (dk-asms))))
    (if (not m) (error "lzf-ker-out!: no SEP membership of" x))
    (for-each (lambda (want)
                (if (not (dk-asm? want))
                    (dk-have! want (lambda () (dk-landed (lambda () (sep-me m))) (dk-split-all!) (ass)))))
              (list (list 'IN x '(VEC A)) (list '= (list 'h x) '(VZERO B))))))
(define (lzf-ker-in! x vt cond)          ; goal (IN x KER): VT types x in VEC A, COND proves h(x) = 0
  (in-sep! vt cond))
(define (lzf-neg-zero! b)                ; land (= (VNEG b (VZERO b)) (VZERO b))
  (let ((want (list '= (list (list 'VNEG b) (list 'VZERO b)) (list 'VZERO b))))
    (if (not (dk-asm? want))
        (begin
          (fact 'module-vzero-in b)
          (fact 'abelian-group-right-id-module-vector-ag b (list 'VZERO b))
          (dk-cite! 'abelian-group-inverse-unique-module-vector-ag b (list 'VZERO b) (list 'VZERO b))
          (fact 'module-vneg-type b (list 'VZERO b))
          (dk-cite! 'equality-symmetry (list 'VZERO b) (list (list 'VNEG b) (list 'VZERO b)))))
    want))
(sp (make-wff (forall-guarded '(A B h) '((IS-HOM-MODULE A B h)) (list 'IS-SUBMODULE 'A LZF-KER))))
(dk-peel!)
(lzf-hom-open! 'A 'B 'h)
(fact 'module-vzero-in 'A)
(fact 'module-vzero-in 'B)
(mac 'IS-SUBMODULE)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-head-is? g 'SUBSET)
         (mac 'subset-def)
         (let* ((ld (dk-peel!)) (x (cadr (car ld)))
                (m (find-first (lambda (f) (and (lzf-in-sep? f) (equal? (cadr f) x))) (dk-asms))))
           (dk-landed (lambda () (sep-me m)))
           (dk-split-all!)
           (ass)))
        ((and (dk-head-is? g 'IN) (equal? (cadr g) '(VZERO A)))
         (lzf-ker-in! '(VZERO A) (lambda () (ass)) (lambda () (ass))))
        (#t
         (let* ((ld (dk-peel!))
                (xs (map cadr (filter lzf-in-sep? ld)))
                (rs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(CARR (SCAL A))))) ld))))
           (for-each lzf-ker-out! xs)
           (cond
             ((= (length xs) 2)
              (let ((x (car xs)) (y (cadr xs)))
                (fact 'module-vadd-type 'A x y)
                (lzf-ker-in! (list '(VADD A) x y) (lambda () (ass))
                  (lambda ()
                    (subst (dk-apply! (lzf-hcl-add 'A 'B 'h) x y))
                    (subst (list '= (list 'h x) '(VZERO B)))
                    (subst (list '= (list 'h y) '(VZERO B)))
                    (subst (dk-cite! 'abelian-group-right-id-module-vector-ag 'B '(VZERO B)))
                    (rfl)))))
             ((pair? rs)
              (let ((r (car rs)) (x (car xs)))
                (fact 'module-act-type 'A r x)
                (dk-have! (list 'IN r '(CARR (SCAL B))) (lambda () (subst '(= (SCAL B) (SCAL A))) (ass)))
                (lzf-ker-in! (list '(ACT A) r x) (lambda () (ass))
                  (lambda ()
                    (subst (dk-apply! (lzf-hcl-act 'A 'B 'h) r x))
                    (subst (list '= (list 'h x) '(VZERO B)))
                    (subst (dk-cite! 'module-act-zero-vec 'B r))
                    (rfl)))))
             (#t
              (let ((x (car xs)))
                (fact 'module-vneg-type 'A x)
                (lzf-ker-in! (list '(VNEG A) x) (lambda () (ass))
                  (lambda ()
                    (subst (dk-apply! (lzf-hcl-neg 'A 'B 'h) x))
                    (subst (list '= (list 'h x) '(VZERO B)))
                    (subst (lzf-neg-zero! 'B))
                    (rfl))))))))))))
(lzf-done! 'hom-kernel-submodule)
(gloss! 'hom-kernel-submodule "The kernel {x : h(x) = 0} of a module homomorphism h is a submodule.")

;;; ---- the map out of a free module given by images of the basis --------------------------
(define LZF-ROWS '(MAT 1 n (CARR (SCAL md))))
(define LZF-LC '(VNB-LAMBDA lcc_ (MAT 1 n (CARR (SCAL md))) (LINCOMB md n lcc_ es)))
(define LZF-KAP (list 'INVERSE-BIJ LZF-LC LZF-ROWS '(VEC md)))
(define (lzf-kp x) (list LZF-KAP x))
(define LZF-LEXT (list 'VNB-LAMBDA 'lex_ '(VEC md) (list 'LINCOMB 'M 'n (lzf-kp 'lex_) 'w)))
(define (lzf-lx x) (list LZF-LEXT x))
(define LZF-FHYPS '((IS-MODULE md) (IN n NN) (IN es (MAT n 1 (VEC md))) (GENERATES md n es) (REL-FREE md n es)
                    (IS-MODULE M) (= (SCAL M) (SCAL md)) (IN w (MAT n 1 (VEC M)))))
(define (lzf-fstmt vars guards body)
  (forall-guarded (append '(md n es M w) vars) (append LZF-FHYPS guards) body))
(define (lzf-fsetup!)
  (fact 'one-in-interval-1)
  (fact 'nn-one-in)
  (fact 'module-scalar-ring 'md)
  (fact 'lzt-lc-bijection 'md 'n 'es)
  (fact 'inverse-bij-in-fun LZF-ROWS '(VEC md) LZF-LC))
(define (lzf-coord! x)                   ; (IN (KAP x) ROWS) and LINCOMB(KAP x, es) = x
  (if (not (dk-asm? (list 'IN (lzf-kp x) LZF-ROWS)))
      (let ((c (dk-cite! 'coord-lincomb 'md 'n 'es x)))
        (if (dk-head-is? c 'AND) (dk-split! c)))))
(define (lzf-rows-m! c)                  ; (IN c (MAT 1 n (CARR (SCAL M)))) from (IN c ROWS)
  (let ((want (list 'IN c '(MAT 1 n (CARR (SCAL M))))))
    (if (not (dk-asm? want)) (dk-have! want (lambda () (subst '(= (SCAL M) (SCAL md))) (ass))))))
(define (lzf-lx-type! x)                 ; (IN (LEXT x) (VEC M)) and the beta equation (LEXT x) = LINCOMB(M, KAP x, w)
  (lzf-coord! x)
  (lzf-rows-m! (lzf-kp x))
  (fact 'lincomb-type 'M 'n (lzf-kp x) 'w))
(define (lzf-kap-is! x c)                ; LINCOMB(md, c, es) = x in context, c in ROWS: land KAP(x) = c
  (let ((e (dk-cite! 'lincomb-coord 'md 'n 'es c)))
    (dk-rewrite-h! e (list 'LINCOMB 'md 'n c 'es) x)))

(sp (make-wff (lzf-fstmt '() '() (list 'IN LZF-LEXT '(FUN (VEC md) (VEC M))))))
(dk-peel!)
(lzf-fsetup!)
(dk-lam-type!
  (lambda ()
    (let* ((ld (dk-peel!)) (x (lzf-iv-var ld '(VEC md))))
      (if (not (lzf-beta!))
          (begin (lzf-lx-type! x) (ass)))))
  (lambda () (fact 'frm-module-vec-set 'md) (ass)))
(lzf-done! 'free-lift-type)

(sp (make-wff (lzf-fstmt '(c) (list (list 'IN 'c LZF-ROWS))
  (list '= (lzf-lx '(LINCOMB md n c es)) '(LINCOMB M n c w)))))
(dk-peel!)
(lzf-fsetup!)
(fact 'lincomb-type 'md 'n 'c 'es)
(lzf-rows-m! 'c)
(fact 'lincomb-type 'M 'n 'c 'w)
(if (not (lzf-beta!))
    (begin
      (subst (dk-cite! 'lincomb-coord 'md 'n 'es 'c))
      (rfl)))
(lzf-done! 'free-lift-lincomb)

(sp (make-wff (lzf-fstmt '(j) '((IN j (INTERVAL 1 n))) (list '= (lzf-lx '(ENTRY es j 1)) '(ENTRY w j 1)))))
(dk-peel!)
(lzf-fsetup!)
(fact 'unitrow-type '(SCAL md) 'n 'j)
(let ((ur '(UNITROW (SCAL md) n j)))
  (dk-cite! 'lincomb-unitrow 'md 'n 'j 'es)
  (fact 'entry-in-carrier 'n 1 '(VEC md) 'es 'j 1)
  (subst (list '= '(ENTRY es j 1) (list 'LINCOMB 'md 'n ur 'es)))
  (subst (dk-cite! 'free-lift-lincomb 'md 'n 'es 'M 'w ur))
  (fact 'unitrow-type '(SCAL M) 'n 'j)
  (fact 'module-scalar-ring 'M)
  (let ((e (dk-cite! 'lincomb-unitrow 'M 'n 'j 'w)))
    (subst (dk-rewrite-h! e '(SCAL M) '(SCAL md))))
  (fact 'entry-in-carrier 'n 1 '(VEC M) 'w 'j 1)
  (rfl))
(lzf-done! 'free-lift-basis)

(sp (make-wff (lzf-fstmt '(x y) '((IN x (VEC md)) (IN y (VEC md)))
  (list '= (lzf-lx '((VADD md) x y)) (list '(VADD M) (lzf-lx 'x) (lzf-lx 'y))))))
(dk-peel!)
(lzf-fsetup!)
(fact 'module-vadd-type 'md 'x 'y)
(lzf-lx-type! 'x) (lzf-lx-type! 'y) (lzf-lx-type! '((VADD md) x y))
(dk-lam-b!)
(let* ((kx (lzf-kp 'x)) (ky (lzf-kp 'y)) (xy '((VADD md) x y))
       (ma (list 'MATADD '(SCAL md) kx ky)))
  (fact 'matadd-type '(SCAL md) 1 'n kx ky)
  (let ((e1 (dk-cite! 'lincomb-row-add 'md 'n kx ky 'es)))
    (dk-have! (list '= (list 'LINCOMB 'md 'n ma 'es) xy)
      (lambda ()
        (subst e1)
        (subst (list '= (list 'LINCOMB 'md 'n kx 'es) 'x))
        (subst (list '= (list 'LINCOMB 'md 'n ky 'es) 'y))
        (rfl)))
    (subst (lzf-kap-is! xy ma))
    (let ((e4 (dk-cite! 'lincomb-row-add 'M 'n kx ky 'w)))
      (subst (dk-rewrite-h! e4 '(SCAL M) '(SCAL md))))
    (fact 'module-vadd-type 'M (list 'LINCOMB 'M 'n kx 'w) (list 'LINCOMB 'M 'n ky 'w))
    (rfl)))
(lzf-done! 'free-lift-add)

(sp (make-wff (lzf-fstmt '(r x) '((IN r (CARR (SCAL md))) (IN x (VEC md)))
  (list '= (lzf-lx '((ACT md) r x)) (list '(ACT M) 'r (lzf-lx 'x))))))
(dk-peel!)
(lzf-fsetup!)
(fact 'module-act-type 'md 'r 'x)
(lzf-lx-type! 'x) (lzf-lx-type! '((ACT md) r x))
(dk-lam-b!)
(let* ((kx (lzf-kp 'x)) (rx '((ACT md) r x))
       (ms (list 'MATSCALE '(SCAL md) 'r kx)))
  (fact 'matscale-type '(SCAL md) 1 'n 'r kx)
  (let ((e1 (dk-cite! 'lincomb-row-scale 'md 'n 'r kx 'es)))
    (dk-have! (list '= (list 'LINCOMB 'md 'n ms 'es) rx)
      (lambda ()
        (subst e1)
        (subst (list '= (list 'LINCOMB 'md 'n kx 'es) 'x))
        (rfl)))
    (subst (lzf-kap-is! rx ms))
    (dk-have! '(IN r (CARR (SCAL M))) (lambda () (subst '(= (SCAL M) (SCAL md))) (ass)))
    (let ((e4 (dk-cite! 'lincomb-row-scale 'M 'n 'r kx 'w)))
      (subst (dk-rewrite-h! e4 '(SCAL M) '(SCAL md))))
    (fact 'module-act-type 'M 'r (list 'LINCOMB 'M 'n kx 'w))
    (rfl)))
(lzf-done! 'free-lift-act)

(sp (make-wff (lzf-fstmt '() '() (list '= (lzf-lx '(VZERO md)) '(VZERO M)))))
(dk-peel!)
(lzf-fsetup!)
(fact 'module-vzero-in 'md)
(fact 'module-vzero-in 'M)
(lzf-lx-type! '(VZERO md))
(dk-lam-b!)
(let ((z '(ZEROMAT (SCAL md) 1 n)))
  (fact 'zeromat-type '(SCAL md) 1 'n)
  (dk-cite! 'lincomb-zerorow 'md 'n 'es)
  (subst (lzf-kap-is! '(VZERO md) z))
  (fact 'module-scalar-ring 'M)
  (let ((e (dk-cite! 'lincomb-zerorow 'M 'n 'w)))
    (subst (dk-rewrite-h! e '(SCAL M) '(SCAL md))))
  (rfl))
(lzf-done! 'free-lift-zero)

(sp (make-wff (lzf-fstmt '() '() (list 'IS-HOM-MODULE 'md 'M LZF-LEXT))))
(dk-peel!)
(lzf-fsetup!)
(fact 'free-lift-type 'md 'n 'es 'M 'w)
(lzf-prove-hom! 'md 'M LZF-LEXT
  (lambda (x y) (dk-cite! 'free-lift-add 'md 'n 'es 'M 'w x y) (ass))
  (lambda (x)
    (let ((m1 '((NEG (SCAL md)) (ONE (SCAL md)))))
      (fact 'ring-one-in '(SCAL md))
      (fact 'ring-neg-in-carr '(SCAL md) '(ONE (SCAL md)))
      (dk-cite! 'module-act-neg-one 'md x)
      (subst (list '= (list '(VNEG md) x) (list '(ACT md) m1 x)))
      (subst (dk-cite! 'free-lift-act 'md 'n 'es 'M 'w m1 x))
      (fact 'fun-apply-type-c LZF-LEXT '(VEC md) '(VEC M) x)
      (fact 'module-scalar-ring 'M)
      (let ((e (dk-cite! 'module-act-neg-one 'M (lzf-lx x))))
        (dk-rewrite-h! e '(SCAL M) '(SCAL md)))
      (ass)))
  (lambda (r x) (dk-cite! 'free-lift-act 'md 'n 'es 'M 'w r x) (ass))
  (lambda () (dk-cite! 'free-lift-zero 'md 'n 'es 'M 'w) (ass)))
(lzf-done! 'free-lift-hom)
(gloss! 'free-lift-hom "If e_1, ..., e_n freely generate E, then for any w_1, ..., w_n in a module M (same scalars) the map x_1 e_1 + ... + x_n e_n |-> x_1 w_1 + ... + x_n w_n is a homomorphism.")

;;; ---- an isomorphism carries a free generating sequence to one -----------------------
(define LZF-MS '(MAP-SEQ g n es))
(sp (make-wff (forall-guarded '(A B g n es)
  '((IS-ISO-MODULE A B g) (IN n NN) (IN es (MAT n 1 (VEC A))) (GENERATES A n es) (REL-FREE A n es))
  (list 'AND (list 'IN LZF-MS '(MAT n 1 (VEC B))) (list 'AND (list 'GENERATES 'B 'n LZF-MS) (list 'REL-FREE 'B 'n LZF-MS))))))
(dk-peel!)
(lzf-split-all! (dk-meta-iff-r! (dk-meta-iff! 'is-iso-module 'A 'B 'g)))
(lzf-hom-open! 'A 'B 'g)
(fact 'nn-one-in)
(fact 'one-in-interval-1)
(fact 'map-seq-type 'g '(VEC A) '(VEC B) 'n 'es)
(let ((gi '(INVERSE-BIJ g (VEC A) (VEC B))))
  (fact 'inverse-bij-in-fun '(VEC A) '(VEC B) 'g)
  (dk-conj-close!
    (lambda ()
      (let ((g0 (dk-goal)))
        (cond
          ((dk-asm? g0) (ass))
          ((dk-head-is? g0 'GENERATES)
           (mac 'GENERATES)
           (let* ((ld (dk-peel!)) (y (lzf-iv-var ld '(VEC B)))
                  (x (list gi y)))
             (fact 'fun-apply-type-c gi '(VEC B) '(VEC A) y)
             (dk-cite! 'inverse-bij-right '(VEC A) '(VEC B) 'g y)
             (let* ((gen (dk-meta-iff-r! (dk-meta-iff! 'generates 'A 'n 'es)))
                    (ex (dk-apply! gen x))
                    (c (dk-skolem! ex)))
               (dk-have! (list 'IN c '(MAT 1 n (CARR (SCAL B)))) (lambda () (subst '(= (SCAL B) (SCAL A))) (ass)))
               (ew c)
               (dk-conj-close!
                 (lambda ()
                   (if (dk-asm? (dk-goal))
                       (ass)
                       (let* ((e1 (dk-cite! 'hom-lincomb 'A 'B 'g 'n c 'es))
                              (e2 (dk-rewrite-h! e1 (list 'LINCOMB 'A 'n c 'es) x))
                              (e3 (dk-rewrite-h! e2 (list 'g x) y)))
                         (ass))))))))
          ((dk-head-is? g0 'REL-FREE)
           (mac 'REL-FREE)
           (let* ((ld (dk-peel!))
                  (c (lzf-iv-var ld '(MAT 1 n (CARR (SCAL B)))))
                  (j (lzf-iv-var ld '(INTERVAL 1 n)))
                  (l (list 'LINCOMB 'A 'n c 'es)))
             (dk-have! (list 'IN c '(MAT 1 n (CARR (SCAL A)))) (lambda () (subst '(= (SCAL A) (SCAL B))) (ass)))
             (fact 'lincomb-type 'A 'n c 'es)
             (fact 'module-vzero-in 'A)
             (let* ((e1 (dk-cite! 'hom-lincomb 'A 'B 'g 'n c 'es))
                    (e2 (dk-rewrite-h! e1 (list 'LINCOMB 'B 'n c LZF-MS) '(VZERO B)))
                    (e3 (dk-rewrite-h! e2 '(VZERO B) '(g (VZERO A)))))
               (dk-cite! 'bijection-injective '(VEC A) '(VEC B) 'g l '(VZERO A))
               (let ((rf (dk-meta-iff-r! (dk-meta-iff! 'rel-free 'A 'n 'es))))
                 (dk-apply! rf c j)
                 (subst '(= (SCAL B) (SCAL A)))
                 (ass)))))
          (#t (error "iso-free-generating: unexpected conjunct" (expression->string g0))))))))
(lzf-done! 'iso-free-generating)
(gloss! 'iso-free-generating "A module isomorphism carries a free generating sequence to a free generating sequence.")
