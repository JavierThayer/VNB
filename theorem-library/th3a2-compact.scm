;;; th3a2-compact.scm -- TH3-A2 (2026-11-09).  Concatenation of tqb-helpers.scm and b1-b6 (scratchpad/th3-1109/a2/).
;;; Library: operator-algebras.  Helper prefixes tqb- tsb- tsc-.  35 theorems, all modulo 0.

;;; ======== from tqb-helpers.scm
;;; tqb helpers: copy of TH3-A's tqa-helpers.scm (scratchpad/th3-1109/a/), prefix tqb-.
;;; tqa helpers: copies of ba-bh2.scm's bb2- helpers (themselves copies of ba-bh.scm's bbh- and hilbert-projection.scm's hpr- kit), prefix tqb-.
(define tqb-v 'v)
(define (tqb-ip a b) (list (list 'IP tqb-v) a b))
(define (tqb-sub a b) (list (list 'VADD tqb-v) a (list (list 'VNEG tqb-v) b)))
(define (tqb-add a b) (list (list 'VADD tqb-v) a b))
(define (tqb-act c a) (list (list 'ACT tqb-v) c a))
(define (tqb-q a) (tqb-ip a a))

(define (tqb-op? e op)
  (and (pair? e) (pair? (car e)) (eq? (car (car e)) op) (equal? (cadr (car e)) tqb-v)))
(define (tqb-zero? e) (equal? e (list 'VZERO tqb-v)))

;;; land (IN e (VEC v)) for a vector term built from typed atoms
(define (tqb-vt! e)
  (let ((goal (list 'IN e (list 'VEC tqb-v))))
    (cond ((and (dk-asm? goal) (not (or (tqb-op? e 'VADD) (tqb-op? e 'VNEG) (tqb-op? e 'ACT))))
           goal)
          ((dk-asm? goal)                  ; typed: still type the parts, which the laws need
           (cond ((tqb-op? e 'VADD) (tqb-vt! (cadr e)) (tqb-vt! (caddr e)))
                 ((tqb-op? e 'VNEG) (tqb-vt! (cadr e)))
                 ((tqb-op? e 'ACT)  (tqb-ct! (cadr e)) (tqb-vt! (caddr e))))
           goal)
          ((tqb-op? e 'VADD) (tqb-vt! (cadr e)) (tqb-vt! (caddr e))
                             (dk-cite! 'cips-vadd-type tqb-v (cadr e) (caddr e)) goal)
          ((tqb-op? e 'VNEG) (tqb-vt! (cadr e))
                             (dk-cite! 'cips-vneg-type tqb-v (cadr e)) goal)
          ((tqb-op? e 'ACT)  (tqb-ct! (cadr e)) (tqb-vt! (caddr e))
                             (dk-cite! 'cips-act-type tqb-v (cadr e) (caddr e)) goal)
          ((tqb-zero? e) (dk-cite! 'cips-vzero-in tqb-v) goal)
          ((tqb-app-fun e) => (lambda (ft) (tqb-arg-t! (cadr e) (cadr (caddr ft)))
                                    (dk-cite! 'fun-apply-type-c (car e) (cadr (caddr ft)) (caddr (caddr ft)) (cadr e))
                                    goal))
          (#t (error "tqb-vt!: no typing for the vector" (expression->string e))))))

;;; an application (f a) with (IN f (FUN D (VEC v))) in context: that typing
(define (tqb-app-fun e)
  (and (pair? e) (= (length e) 2)
       (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (cadr h) (car e))
                                    (pair? (caddr h)) (eq? (car (caddr h)) 'FUN)
                                    (= (length (caddr h)) 3)
                                    (equal? (caddr (caddr h)) (list 'VEC tqb-v))))
                   (dk-asms))))
;;; type the argument a in D: by recursion when D is VEC v, else from context
(define (tqb-arg-t! a d)
  (cond ((dk-asm? (list 'IN a d)) #t)
        ((equal? d (list 'VEC tqb-v)) (tqb-vt! a))
        ((and (pair? d) (eq? (car d) 'VEC))
         (fluid-let ((tqb-v (cadr d))) (tqb-vt! a)))
        (#t (error "tqb-arg-t!: argument not typed" (expression->string (list 'IN a d))))))

;;; land (IN c CC) for a scalar term
(define (tqb-ct! c)
  (let ((goal (list 'IN c 'CC)))
    (cond ((dk-asm? goal) goal)
          ((eqv? c +i) (dk-cite! 'cc-i-in) goal)
          ((number? c) (dk-have! goal (lambda () (arith))) goal)
          ((dk-asm? (list 'IN c 'RR)) (dk-cite! 'rr-subset-cc c) goal)
          ((tqb-op? c 'IP) (tqb-vt! (cadr c)) (tqb-vt! (caddr c))
                           (dk-cite! 'cips-ip-type tqb-v (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) 'conjugate))
           (tqb-ct! (cadr c)) (dk-cite! 'cc-conjugate-closed (cadr c)) goal)
          ((and (pair? c) (memq (car c) '(* +)) (= (length c) 3))
           (tqb-ct! (cadr c)) (tqb-ct! (caddr c))
           (tqb-have-and! (list 'IN (cadr c) 'CC) (list 'IN (caddr c) 'CC))
           (dk-cite! (if (eq? (car c) '*) 'cc-mul-closed 'cc-add-closed) (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 3))
           (tqb-ct! (cadr c)) (tqb-ct! (caddr c))
           (dk-cite! 'cc-sub-in-cc (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 2))
           (tqb-ct! (cadr c)) (dk-cite! 'cc-neg-closed (cadr c)) goal)
          (#t (dk-have! goal (lambda () (type-term))) goal))))

;;; the first inner-product term in E (preorder) with a compound argument
(define (tqb-find-redex e)
  (cond ((not (pair? e)) #f)
        ((and (tqb-op? e 'IP) (= (length e) 3)
              (or (tqb-compound? (cadr e)) (tqb-compound? (caddr e))))
         e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((tqb-find-redex (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
(define (tqb-compound? e)
  (or (tqb-op? e 'VADD) (tqb-op? e 'VNEG) (tqb-op? e 'ACT) (tqb-zero? e)))

;;; the law instance that opens the redex <a, b>
(define (tqb-open-law! r)
  (let ((a (cadr r)) (b (caddr r)))
    (tqb-vt! a) (tqb-vt! b)
    (cond ((tqb-op? a 'VADD) (dk-cite! 'cips-ip-add-left tqb-v (cadr a) (caddr a) b))
          ((tqb-op? a 'VNEG) (dk-cite! 'cips-ip-neg-left tqb-v (cadr a) b))
          ((tqb-op? a 'ACT)  (dk-cite! 'cips-ip-homog-left tqb-v (cadr a) (caddr a) b))
          ((tqb-zero? a)     (dk-cite! 'cips-ip-zero-left tqb-v b))
          ((tqb-op? b 'VADD) (dk-cite! 'cips-ip-add-right tqb-v a (cadr b) (caddr b)))
          ((tqb-op? b 'VNEG) (dk-cite! 'cips-ip-neg-right tqb-v a (cadr b)))
          ((tqb-op? b 'ACT)  (dk-cite! 'cips-ip-conj-homog-right tqb-v (cadr b) a (caddr b)))
          ((tqb-zero? b)     (dk-cite! 'cips-ip-zero-right tqb-v a))
          (#t (error "tqb-open-law!: not a redex" (expression->string r))))))

;;; a conjugate that can be pushed inwards: of a real (a numeral, or typed RR
;;; in context), of a product, sum, negation or conjugate, of an inner product
(define (tqb-conj-redex? e)
  (and (pair? e) (eq? (car e) 'conjugate) (= (length e) 2)
       (let ((x (cadr e)))
         (or (number? x) (dk-asm? (list 'IN x 'RR))
             (and (pair? x) (memq (car x) '(* + conjugate)))
             (and (pair? x) (eq? (car x) '-) (= (length x) 2))
             (and (tqb-op? x 'IP) (= (length x) 3))))))
(define (tqb-find-real-conj e)
  (cond ((not (pair? e)) #f)
        ((tqb-conj-redex? e) e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((tqb-find-real-conj (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))

;;; EXPAND the goal: every inner product of a constructed vector is opened by
;;; its law (first argument first), and every conjugate of a real is dropped,
;;; until the goal is a polynomial in inner products of ATOMS.  Loops on a redex
;;; test, never on a count.
(define (tqb-expand!)
  (let loop ((fuel 200))
    (if (<= fuel 0) (error "tqb-expand!: out of fuel"))
    (let ((r (tqb-find-redex (dk-goal))))
      (if r
          (let ((eq (tqb-open-law! r)))
            (subst eq)
            (loop (- fuel 1)))
          (let ((c (tqb-find-real-conj (dk-goal))))
            (if c
                (begin
                  (tqb-push-conj! c)
                  (loop (- fuel 1)))))))))

;;; one step of pushing a conjugate inwards
(define (tqb-push-conj! c)
  (let ((x (cadr c)))
    (cond ((or (number? x) (dk-asm? (list 'IN x 'RR)))
           (if (number? x) (dk-have! (list 'IN x 'RR) (lambda () (arith))))
           (subst (dk-cite! 'cc-conjugate-fixes-rr x)))
          ((tqb-op? x 'IP)
           (tqb-vt! (cadr x)) (tqb-vt! (caddr x))
           (dk-cite! 'cips-ip-conj-sym tqb-v (cadr x) (caddr x))
           (subst (list '= c (tqb-ip (caddr x) (cadr x)))))
          ((eq? (car x) 'conjugate)
           (tqb-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-involution (cadr x))))
          ((eq? (car x) '-)
           (tqb-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-neg (cadr x))))
          (#t
           (tqb-ct! (cadr x)) (tqb-ct! (caddr x))
           (tqb-have-and! (list 'IN (cadr x) 'CC) (list 'IN (caddr x) 'CC))
           (subst (dk-cite! (if (eq? (car x) '*) 'cc-conjugate-mul 'cc-conjugate-add)
                            (cadr x) (caddr x)))))))

;;; with (IN a RR) and (0 <= a) in context: land (IN (SQRT a) RR), 0 <= SQRT(a)
;;; and SQRT(a) * SQRT(a) = a
(define (tqb-sqrt! a)
  (if (not (dk-asm? (list 'IN (list 'SQRT a) 'RR)))
      (begin
        (dk-have! (list 'AND (list 'IN a 'RR) (list '<= 0 a)))
        (dk-split! (dk-cite! 'sqrt-nonneg a))
        (dk-cite! 'sqrt-sq a))))

;;; <u,u> is real and nonnegative
(define (tqb-q-facts! u)
  (tqb-vt! u)
  (dk-cite! 'cips-ip-self-real tqb-v u)
  (dk-cite! 'cips-ip-self-nonneg tqb-v u))

;;; rewrite ||u|| * ||u|| in the goal to <u, u>
(define (tqb-norm-sq! u)
  (tqb-vt! u)
  (subst (dk-cite! 'ip-norm-unfold tqb-v u))
  (tqb-q-facts! u)
  (tqb-sqrt! (tqb-q u))
  (subst (dk-cite! 'sqrt-sq (tqb-q u))))
(define (tqb-nsq u) (list '* (list 'IP-NORM tqb-v u) (list 'IP-NORM tqb-v u)))

;;; an IFF instance used forwards: cite THM at ARGS, land its right side (split)
(define (tqb-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))

;;; an IFF instance used backwards: its right side's conjuncts are in context;
;;; land the left side and return it
(define (tqb-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))

;;; the right-nested conjunction of FS, landed from its conjuncts in context
(define (tqb-and fs)
  (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (tqb-and (cdr fs)))))
(define (tqb-have-and! . fs)
  (let ((c (tqb-and fs)))
    (dk-have! c (lambda () (dk-conj-close! dk-ass!)))
    c))

;;; type every inner product of atoms in the goal (crs wants its atoms in CC)
(define (tqb-type-ips! e)
  (cond ((not (pair? e)) #t)
        ((tqb-op? e 'IP) (tqb-ct! e))
        ((and (eq? (car e) 'conjugate) (= (length e) 2)) (tqb-ct! e))
        (#t (for-each tqb-type-ips! e))))

(define (tqb-qd p xi) (tqb-q (tqb-sub p xi)))
(define (tqb-vec-eq! a b)
  (let ((goal (list '= a b)))
    (if (not (dk-asm? goal))
        (begin
          (tqb-vt! a) (tqb-vt! b)
          (dk-have! (list '= (tqb-qd a b) 0)
            (lambda () (tqb-expand!) (tqb-type-ips! (dk-goal)) (crs)))
          (dk-cite! 'cips-eq-of-dist-sq-zero tqb-v a b)))
    goal))

;;; Q(A) = Q(B) for two expressions of one vector, by expansion
(define (tqb-q-eq! a b)
  (let ((goal (list '= (tqb-q a) (tqb-q b))))
    (if (not (dk-asm? goal))
        (begin (tqb-vt! a) (tqb-vt! b)
               (dk-have! goal (lambda () (tqb-expand!) (tqb-type-ips! (dk-goal)) (crs)))))
    goal))

;;; ---- BA-BH additions -------------------------------------------------------------------
;;; qed, or a dump of the open leaves and an error
(define (tqb-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** TQB: ") (display name) (display " did NOT close.  Open leaves:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "TQB: unfinished" name))))
;;; dump the focus leaf (debugging)
(define (tqb-show! tag)
  (display "\n--- TQB ") (display tag) (display " GOAL: ") (display (expression->string (dk-goal))) (newline)
  (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline)) (dk-asms)))
;;; x in ks, ks a submodule of v: x in VEC v
(define (tqb-sub! ks x)
  (dk-cite! 'submodule-subset tqb-v ks)
  (dk-cite! 'subset-mem-fwd ks (list 'VEC tqb-v) x))
;;; c in CC => c in CARR(SCAL v)
(define (tqb-scal! c)
  (dk-cite! 'cips-scal-carrier tqb-v)
  (dk-have! (list 'IN c (list 'CARR (list 'SCAL tqb-v)))
            (lambda () (subst (list '= (list 'CARR (list 'SCAL tqb-v)) 'CC)) (ass))))

;;; ---- from ba-bh.scm parts 2-5 (prefix tqb-) -----------------------------------------------
(define tqb-w 'w)
(define (tqb-n u) (list 'IP-NORM tqb-v u))
(define (tqb-ipv a b) (list '(IP v) a b))
(define (tqb-ipw a b) (list '(IP w) a b))
(define (tqb-mul-in! u w2)
  (dk-have! (list 'AND (list 'IN u 'RR) (list 'IN w2 'RR)) (lambda () (dk-conj-close! dk-ass!)))
  (dk-cite! 'rr-mul-closed u w2))
(define (tqb-prod? t) (and (pair? t) (eq? (car t) '*) (= (length t) 3)
                           (not (number? (cadr t))) (not (number? (caddr t)))))
(define (tqb-prods e)
  (cond ((tqb-prod? e) (list e))
        ((and (pair? e) (memq (car e) '(<= < = + -))) (append-map tqb-prods (cdr e)))
        (#t '())))
(define (tqb-mul-type! p)
  (if (not (dk-asm? (list 'IN p 'RR)))
      (begin
        (if (tqb-prod? (cadr p)) (tqb-mul-type! (cadr p)))
        (if (tqb-prod? (caddr p)) (tqb-mul-type! (caddr p)))
        (dk-cite! 'rr-mul-in-rr (cadr p) (caddr p)))))
;;; (tqb-lin! TYPINGS PREMS): every product in PREMS and in the GOAL named, then dk-ineq!
(define (tqb-lin! typings prems)
  (let* ((ps (let loop ((l (append (append-map tqb-prods prems) (tqb-prods (dk-goal)))) (acc '()))
               (cond ((null? l) (reverse acc)) ((member (car l) acc) (loop (cdr l) acc))
                     (#t (loop (cdr l) (cons (car l) acc))))))
         (names (map (lambda (p)
                       (tqb-mul-type! p)
                       (cons p (dk-name! p)))
                     ps))
         (new (map (lambda (f)
                     (let loop ((f f) (ns names))
                       (cond ((null? ns) f)
                             ((dk-contains? f (caar ns)) (loop (dk-rewrite-h! f (caar ns) (cdar ns)) (cdr ns)))
                             (#t (loop f (cdr ns))))))
                   prems)))
    (for-each (lambda (n) (if (dk-contains? (dk-goal) (car n)) (subst (list '= (car n) (cdr n))))) names)
    (apply dk-ineq! (append typings (map (lambda (n) (list 'IN (cdr n) 'RR)) names) new))))
;;; the least-bound clause of opnorm-spec for T (spec split into context first)
(define (tqb-least t)
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'd_) (dk-contains? h t)
                            (dk-contains? h 'OPNORM)))
           "the least-bound clause"))
;;; the bound clause  forall x in VEC v. ||t x|| <= d ||x||
(define (tqb-ub v w t d)
  (list 'FORALL 'box_ (list 'IMPLIES (list 'IN 'box_ (list 'VEC v))
     (list '<= (list 'IP-NORM w (list t 'box_)) (list '* d (list 'IP-NORM v 'box_))))))
;;; ||x|| typed and nonnegative
(define (tqb-nt! v x) (dk-cite! 'ip-norm-in-rr v x) (dk-cite! 'ip-norm-nonneg v x))
;;; debugging: dump every open leaf (goal + context)
(define (tqb-dump! tag)
  (display "\n=== TQB DUMP ") (display tag) (newline)
  (for-each (lambda (l)
              (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
              (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                        (dk-asms-of l)))
            (dk-open-leaves)))
;;; run THUNK; on an error print the condition and dump, then re-raise
(define (tqb-try tag thunk)
  (call-with-current-continuation
    (lambda (k)
      (with-exception-handler
        (lambda (e)
          (display "\n*** TQB ERROR in ") (display tag) (display ": ")
          (display (if (condition? e) (condition/report-string e) e)) (newline)
          (tqb-dump! tag)
          (k (error "TQB stop" tag)))
        thunk))))

;;; ---- TH3-A2 additions ----------------------------------------------------------------------
;;; the focus goal is (= a a) / (== a a)
(define (tqb-trivial-goal?)
  (and (pair? (dk-open-leaves))
       (let ((g (dk-goal)))
         (and (pair? g) (memq (car g) '(= ==)) (= (length g) 3) (equal? (cadr g) (caddr g))))))
(define (tqb-rfl-trivial!) (if (tqb-trivial-goal?) (rfl)))

;;; ======== from b1-diag.scm
;;; ==========================================================================================
;;; (B1) SUBSEQUENCES: the bridge between the SUBSEQ form and the POINTWISE form of a
;;; convergent subsequence, Bolzano-Weierstrass in CC in the pointwise form, ONE refinement
;;; step for any sequence all of whose subsequences have convergent subsequences, and the
;;; DIAGONAL-SUBSEQUENCE LEMMA: a countable family of such sequences has ONE common
;;; subsequence along which every member converges.  Library: analysis.  Prefix tqb-.
;;; ==========================================================================================

(define (tqb-nn-var lk)
  (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lk)))

;;; subseq-ptwise-converges: SUBSEQ(g, phi) -> p and b(n) = g(phi(n)) for all n: b -> p
(sp (make-wff (forall-guarded '(s g phi p b)
  '((CONVERGES-TO s (SUBSEQ g phi) p) (IN b (FUN NN (PTS s)))
    (FORALL n_ (IMPLIES (IN n_ NN) (= (b n_) (g (phi n_))))))
  '(CONVERGES-TO s b p))))
(dk-peel!)
(let ((eqc (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'b))) "the values")))
  (dk-have! '(FORALL n_ (IMPLIES (IN n_ NN) (= (b n_) ((SUBSEQ g phi) n_))))
    (lambda ()
      (let ((k (dk-di-var!)))
        (subst (dk-cite! 'subseq-apply 'g 'phi k))
        (dk-apply! eqc k)
        (dk-close-if-asm!))))
  (dk-cite! 'converges-ptwise-eq 's '(SUBSEQ g phi) 'b 'p)
  (dk-close-if-asm!))
(tqb-qed! 'subseq-ptwise-converges)

;;; ptwise-subseq-converges: the converse
(sp (make-wff (forall-guarded '(s g phi p b)
  '((CONVERGES-TO s b p) (STRICTLY-MONO-NN phi) (IN g (FUN NN (PTS s)))
    (FORALL n_ (IMPLIES (IN n_ NN) (= (b n_) (g (phi n_))))))
  '(CONVERGES-TO s (SUBSEQ g phi) p))))
(dk-peel!)
(let ((eqc (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'b))) "the values")))
  (tqb-iff-fwd! 'strictly-mono-nn 'phi)
  (tqb-have-and! '(IN g (FUN NN (PTS s))) '(STRICTLY-MONO-NN phi))
  (dk-cite! 'subseq-is-fun 's 'g 'phi)
  (dk-have! '(FORALL n_ (IMPLIES (IN n_ NN) (= ((SUBSEQ g phi) n_) (b n_))))
    (lambda ()
      (let ((k (dk-di-var!)))
        (dk-cite! 'fun-apply-type-c 'phi 'NN 'NN k)
        (dk-cite! 'fun-apply-type-c 'g 'NN '(PTS s) (list 'phi k))
        (subst (dk-cite! 'subseq-apply 'g 'phi k))
        (dk-apply! eqc k)
        (let ((leaf (proof-state-focus *ps*)))
          (subst (list '= (list 'b k) (list 'g (list 'phi k))))
          (tqb-rfl-trivial!)))))
  (dk-cite! 'converges-ptwise-eq 's 'b '(SUBSEQ g phi) 'p)
  (dk-close-if-asm!))
(tqb-qed! 'ptwise-subseq-converges)

;;; cc-bolzano-weierstrass-ptwise: a bounded sequence in CC has a subsequence converging
;;; in the pointwise form (every b with b(n) = h(phi(n)) converges to l)
(sp (make-wff '(FORALL h (IMPLIES (IN h (FUN NN CC)) (FORALL bd (IMPLIES (IN bd RR)
  (IMPLIES (FORALL i (IMPLIES (IN i NN) (<= (magnitude (h i)) bd)))
    (FORSOME phi (AND (STRICTLY-MONO-NN phi)
      (FORSOME l (AND (IN l CC)
        (FORALL bq_ (IMPLIES (IN bq_ (FUN NN CC))
          (IMPLIES (FORALL nq_ (IMPLIES (IN nq_ NN) (= (bq_ nq_) (h (phi nq_)))))
            (CONVERGES-TO CC-MS bq_ l)))))))))))))))
(dk-peel!)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(let* ((ex (dk-cite! 'cc-bolzano-weierstrass 'h 'bd))
       (phi (dk-skolem! ex))
       (ex2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (memq phi (free-vars f)))) "the limit"))
       (lm (dk-skolem! ex2)))
  (witness! phi
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (witness! lm
                (lambda ()
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-asm? (dk-goal)) (ass)
                          (let* ((lk (dk-peel!))
                                 (b (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (eq? (car (caddr f)) 'FUN))) lk))))
                            (dk-have! (list 'IN b '(FUN NN (PTS CC-MS))) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
                            (dk-cite! 'subseq-ptwise-converges 'CC-MS 'h phi lm b)
                            (dk-close-if-asm!)))))))))))))
(tqb-qed! 'cc-bolzano-weierstrass-ptwise)

;;; ------------------------------------------------------------------------------------------
;;; "every subsequence of h has a convergent subsequence"
(define (tqb-subhyp s h)
  (list 'FORALL 'phi (list 'IMPLIES '(STRICTLY-MONO-NN phi)
    (list 'FORSOME 'psi (list 'AND '(STRICTLY-MONO-NN psi)
      (list 'FORSOME 'p (list 'AND (list 'IN 'p (list 'PTS s))
        (list 'CONVERGES-TO s (list 'SUBSEQ (list 'SUBSEQ h 'phi) 'psi) 'p))))))))

;;; seq-block-step: for such an h, every infinite block J of NN contains an infinite
;;; sub-block along which h converges (block-step-converges, rake-block-tower.scm, with the
;;; sequential compactness of the space replaced by the hypothesis on h alone)
(sp (make-wff (list 'FORALL 's (list 'FORALL 'h (list 'IMPLIES '(IN h (FUN NN (PTS s)))
  (list 'IMPLIES (tqb-subhyp 's 'h)
    (list 'FORALL 'jb (list 'IMPLIES '(IN jb (INF-SUBSETS NN))
      (list 'FORSOME 'b_ (list 'AND '(IN b_ (INF-SUBSETS NN))
        (list 'AND '(SUBSET b_ jb)
          (list 'FORSOME 'p (list 'AND '(IN p (PTS s)) '(CONVERGES-ALONG s h b_ p))))))))))))))
(dk-peel!)
(let* ((hyp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'SUBSEQ))) "the subsequence hypothesis"))
       (e '(NN-ENUM jb))
       (eat (dk-split-all! (dk-landed (lambda () (fact 'nn-enum-spec 'jb)))))
       (emono (or (find-first (dk-head? 'FORALL) eat) (error "tqb: no enumeration monotonicity"))))
  (dk-have! '(SUBSET jb NN) (lambda () (tqb-iff-fwd! 'inf-subsets-membership 'NN 'jb) (dk-close-if-asm!)))
  (fact 'fun-codomain-superset e 'NN 'jb 'NN)
  (dk-have! (list 'STRICTLY-MONO-NN e) (lambda () (mac 'STRICTLY-MONO-NN) (from-context!)))
  (let* ((ex (dk-apply! hyp e))
         (phi (dk-skolem! ex))
         (ex2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (memq phi (free-vars f)))) "the limit"))
         (lm (dk-skolem! ex2))
         (sq0 (list 'SUBSEQ 'h e))
         (sq (list 'SUBSEQ sq0 phi))
         (pr (tqb-iff-fwd! 'strictly-mono-nn phi))
         (phimono (caddr pr))
         (psi (list 'VNB-LAMBDA 'tqv_ 'NN (list e (list phi 'tqv_)))))
    (dk-have! (list 'STRICTLY-MONO-NN psi)
      (lambda ()
        (mac 'STRICTLY-MONO-NN)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type!
                  (lambda () (let ((iv (dk-di-var!)))
                               (fact 'fun-apply-type-c phi 'NN 'NN iv)
                               (fact 'fun-apply-type-c e 'NN 'NN (list phi iv))
                               (dk-close-if-asm!)))
                  (lambda () (fact 'nn-is-set) (ass)))
                (let* ((ls (dk-peel!))
                       (gl (dk-goal))
                       (mv (cadr (cadr gl)))
                       (nv (cadr (caddr gl))))
                  (fact 'fun-apply-type-c phi 'NN 'NN mv)
                  (fact 'fun-apply-type-c phi 'NN 'NN nv)
                  (dk-lam-b!)
                  (dk-apply! phimono mv nv)
                  (dk-apply! emono (list phi mv) (list phi nv))
                  (dk-close-if-asm!)))))))
    (tqb-iff-fwd! 'strictly-mono-nn psi)
    (dk-have! (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ NN) (list 'IN (list psi 'k_) 'jb)))
      (lambda ()
        (let ((kv (dk-di-var!)))
          (fact 'fun-apply-type-c phi 'NN 'NN kv)
          (dk-lam-b!)
          (fact 'fun-apply-type-c e 'NN 'jb (list phi kv))
          (dk-close-if-asm!))))
    (let* ((bmem (dk-fact! 'strictly-mono-image-infinite psi 'jb))
           (b (cadr bmem))
           (cv (tqb-iff-fwd! 'converges-to 's sq lm))
           (epsu (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR))) (dk-asms))))
      (witness! b
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (let ((gl (dk-goal)))
                (cond
                  ((dk-asm? gl) (ass))
                  ((dk-head-is? gl 'SUBSET)
                   (mac 'subset-def)
                   (let ((xv (dk-di-var!)))
                     (sep-me (list 'IN xv b))
                     (dk-close-if-asm!)))
                  (#t
                   (witness! lm
                     (lambda ()
                       (dk-conj-close!
                         (lambda ()
                           (if (dk-asm? (dk-goal)) (ass)
                               (begin
                                 (mac 'CONVERGES-ALONG)
                                 (dk-conj-close!
                                   (lambda ()
                                     (if (dk-asm? (dk-goal)) (ass)
                                         (let* ((lk (dk-peel!))
                                                (ev (cadr (find-first (dk-head? 'POS-RR) lk)))
                                                (bign (dk-skolem! (dk-apply! epsu ev)))
                                                (tail (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f bign))) "the tail")))
                                           (fact 'fun-apply-type-c psi 'NN 'NN bign)
                                           (witness! (list psi bign)
                                             (lambda ()
                                               (dk-conj-close!
                                                 (lambda ()
                                                   (if (dk-asm? (dk-goal)) (ass)
                                                       (let* ((lk2 (dk-peel!))
                                                              (hmem (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) b))) "the block membership"))
                                                              (iv (cadr hmem))
                                                              (fs (dk-landed (lambda () (sep-me (list 'IN iv b)))))
                                                              (ex3 (or (find-first (dk-head? 'FORSOME) fs) (error "tqb: no block witness")))
                                                              (kv (dk-skolem! ex3)))
                                                         (dk-have! (list '<= (list psi bign) (list psi kv))
                                                           (lambda () (subst (list '= (list psi kv) iv)) (ass)))
                                                         (fact 'strictly-mono-le-reflect psi bign kv)
                                                         (dk-apply! tail kv)
                                                         (fact 'fun-apply-type-c phi 'NN 'NN kv)
                                                         (dk-have! (list '== (list 'h iv) (list sq kv))
                                                           (lambda ()
                                                             (subst (list '= iv (list psi kv)))
                                                             (subst (dk-fact! 'subseq-apply sq0 phi kv))
                                                             (subst (dk-fact! 'subseq-apply 'h e (list phi kv)))
                                                             (if (not (dk-lam-b!)) (qrfl))))
                                                         (subst (list '= (list 'h iv) (list sq kv)))
                                                         (dk-close-if-asm!)))))))))))))))))))))))))))
(tqb-qed! 'seq-block-step)

;;; ------------------------------------------------------------------------------------------
;;; diagonal-subseq: THE DIAGONAL-SUBSEQUENCE LEMMA.  af : NN -> FUN(NN, PTS s) a family of
;;; sequences each of whose subsequences has a convergent subsequence: ONE strictly increasing
;;; delta makes every SUBSEQ(af(k), delta) converge.  A nested tower of blocks by one dependent
;;; choice (dc-on-nn-pred, step set = seq-block-step), then diagonalization and
;;; coord-block-estimate (the route of rake-block-tower.scm / rake-diagonal-subseq.scm).
(sp (make-wff (list 'FORALL 's (list 'FORALL 'af (list 'IMPLIES '(IN af (FUN NN (FUN NN (PTS s))))
  (list 'IMPLIES (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (tqb-subhyp 's '(af k))))
    (list 'FORSOME 'delta (list 'AND '(STRICTLY-MONO-NN delta)
      (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
        (list 'FORSOME 'p (list 'AND '(IN p (PTS s)) '(CONVERGES-TO s (SUBSEQ (af k) delta) p)))))))))))))
(dk-peel!)
(let* ((hyp (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'SUBSEQ))) "the family hypothesis"))
       (xx '(INF-SUBSETS NN))
       (nxt (list 'VNB-LAMBDA '(LIST k_ u_) (list 'CARTESIAN 'NN xx)
              (list 'SEP 'bb_ xx
                (list 'AND '(SUBSET bb_ u_)
                  (list 'FORSOME 'p (list 'AND '(IN p (PTS s)) '(CONVERGES-ALONG s (af k_) bb_ p)))))))
       (tot (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
              (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u xx)
                (list 'FORSOME 'y (list 'AND (list 'IN 'y xx) (list 'IN 'y (list nxt 'k 'u))))))))))
  (dk-have! tot
    (lambda ()
      (let* ((lk (dk-peel!))
             (kv (tqb-nn-var lk))
             (uv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) xx))) lk))))
        (dk-lam-b!)
        (dk-cite! 'fun-apply-type-c 'af 'NN '(FUN NN (PTS s)) kv)
        (dk-apply! hyp kv)
        (let* ((ex (dk-fact! 'seq-block-step 's (list 'af kv) uv))
               (bv (dk-skolem! ex)))
          (dk-split-all!)
          (witness! bv
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (let ((gl (dk-goal)))
                    (if (and (dk-head-is? gl 'IN) (pair? (caddr gl)) (eq? (car (caddr gl)) 'SEP))
                        (for-each (lambda (l) (dk-focus! l) (dk-conj-close! (lambda () (ass))))
                                  (dk-opened (lambda () (sep-mi))))
                        (ass)))))))))))
  (fact 'nn-is-set)
  (fact 'inf-subsets-is-set 'NN)
  (fact 'nn-in-inf-subsets)
  (let* ((ex (dk-fact! 'dc-on-nn-pred xx 'NN nxt))
         (f (dk-skolem! ex)))
    (let ((c (find-first (lambda (g) (and (dk-head-is? g 'AND) (dk-contains? g 'succ))) (dk-asms))))
      (if c (dk-split! c)))
    (let* ((fstep (dk-pick (lambda (g) (and (dk-head-is? g 'FORALL) (dk-contains? g f) (dk-contains? g 'succ))) "the step"))
           (hstep (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                    (list 'AND (list 'SUBSET (list f '(succ n_)) (list f 'n_))
                      (list 'FORSOME 'p (list 'AND '(IN p (PTS s))
                        (list 'CONVERGES-ALONG 's '(af n_) (list f '(succ n_)) 'p))))))))
      (dk-have! hstep
        (lambda ()
          (let ((nv (dk-di-var!)))
            (fact 'nn-succ-closed nv)
            (fact 'fun-apply-type-c f 'NN xx nv)
            (let* ((h1 (dk-apply! fstep nv))
                   (h2 (car (dk-landed (lambda () (lam-b-h h1))))))
              (sep-me h2)
              (dk-close-if-asm!)))))
      (let* ((lams (list 'VNB-LAMBDA 'tqn_ 'NN (list f '(succ tqn_)))))
        (dk-have! (list 'IN lams (list 'FUN 'NN xx))
          (lambda ()
            (dk-lam-type!
              (lambda () (let ((nv (dk-di-var!)))
                           (fact 'nn-succ-closed nv)
                           (fact 'fun-apply-type-c f 'NN xx (list 'succ nv))
                           (dk-close-if-asm!)))
              (lambda () (ass)))))
        (let* ((sv (dk-name! lams (list 'FUN 'NN xx)))
               (sval (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '= (list sv 'n_) (list f '(succ n_)))))))
          (dk-have! sval
            (lambda ()
              (let ((nv (dk-di-var!)))
                (fact 'nn-succ-closed nv)
                (fact 'fun-apply-type-c f 'NN xx (list 'succ nv))
                (subst (list '= sv lams))
                (if (not (dk-lam-b!)) (rfl)))))
          (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'SUBSET (list sv '(succ k)) (list sv 'k))))
            (lambda ()
              (let ((kv (dk-di-var!)))
                (fact 'nn-succ-closed kv)
                (dk-apply! sval kv)
                (dk-apply! sval (list 'succ kv))
                (subst (list '= (list sv kv) (list f (list 'succ kv))))
                (subst (list '= (list sv (list 'succ kv)) (list f (list 'succ (list 'succ kv)))))
                (dk-split! (dk-apply! hstep (list 'succ kv)))
                (dk-close-if-asm!))))
          (let* ((dx (dk-fact! 'diagonalization sv))
                 (delta (dk-skolem! dx))
                 (dtail (dk-pick (lambda (g) (and (dk-head-is? g 'FORALL) (dk-contains? g delta) (dk-contains? g sv))) "the diagonal tail")))
            (witness! delta
              (lambda ()
                (dk-conj-close!
                  (lambda ()
                    (if (dk-asm? (dk-goal)) (ass)
                        (let* ((kv (dk-di-var!))
                               (two (dk-split! (dk-apply! hstep kv)))
                               (ex4 (or (find-first (dk-head? 'FORSOME) two) (error "tqb: no rung limit")))
                               (pv (dk-skolem! ex4))
                               (blk (list f (list 'succ kv))))
                          (dk-have! (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'IMPLIES (list '<= kv 'j) (list 'IN (list delta 'j) blk))))
                            (lambda ()
                              (let* ((lk (dk-peel!))
                                     (jv (tqb-nn-var (filter (lambda (g) (not (equal? g (list 'IN kv 'NN)))) lk))))
                                (dk-apply! dtail kv jv)
                                (dk-apply! sval kv)
                                (subst (list '= blk (list sv kv)))
                                (dk-close-if-asm!))))
                          (witness! pv
                            (lambda ()
                              (dk-conj-close!
                                (lambda ()
                                  (if (dk-asm? (dk-goal)) (ass)
                                      (begin
                                        (fact 'nn-succ-closed kv)
                                        (fact 'fun-apply-type-c f 'NN xx (list 'succ kv))
                                        (dk-cite! 'coord-block-estimate 's (list 'af kv) blk pv delta kv)
                                        (dk-close-if-asm!)))))))))))))))))))
(tqb-qed! 'diagonal-subseq)

;;; ======== from b2-limit.scm
;;; ==========================================================================================
;;; (B2) NORM LIMITS OF COMPACT OPERATORS ARE COMPACT (Prop. 1.59, second half).
;;; Library: operator-algebras.  Prefix tqb-.
;;; ==========================================================================================

(define (tqb-M w) (list 'IP-METRIC-SPACE w))
(define (tqb-bound v f)
  (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN) (list '<= (list 'IP-NORM v (list f 'nq_)) 1))))
(define (tqb-seqc v w t f)
  (list 'FORSOME 'phq_ (list 'AND '(STRICTLY-MONO-NN phq_)
    (list 'FORSOME 'lq_ (list 'FORALL 'bq_ (list 'IMPLIES (list 'IN 'bq_ (list 'FUN 'NN (list 'VEC w)))
      (list 'IMPLIES (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN) (list '= '(bq_ nq_) (list t (list f '(phq_ nq_))))))
        (list 'CONVERGES-TO (tqb-M w) 'bq_ 'lq_))))))))
;;; (IN X C') from (IN X C) where C' is C with PTS(M_w) for VEC(w) (or back)
(define (tqb-swap-pts w form)
  (let ((pts (list 'PTS (tqb-M w))) (vec (list 'VEC w)))
    (let walk ((e form))
      (cond ((equal? e vec) pts) ((equal? e pts) vec)
            ((pair? e) (map walk e)) (#t e)))))
(define (tqb-pts-eq! w)
  (let ((g (list '== (list 'PTS (tqb-M w)) (list 'VEC w))))
    (if (not (dk-asm? g)) (dk-cite! 'ip-metric-space-pts w))
    g))
;;; land FORM (an IN whose class mentions PTS(M_w) or VEC(w)) from its swapped twin in context
(define (tqb-swap! w form)
  (if (not (dk-asm? form))
      (let ((twin (tqb-swap-pts w form)))
        (tqb-pts-eq! w)
        (if (not (dk-asm? twin)) (error "tqb-swap!: twin not in context" (expression->string twin)))
        (dk-have! form
          (lambda ()
            (if (dk-contains? form (list 'PTS (tqb-M w)))
                (subst (list '= (list 'PTS (tqb-M w)) (list 'VEC w)))
                (subst (list '= (list 'VEC w) (list 'PTS (tqb-M w)))))
            (ass)))))
  form)

;;; compact-op-subseq-hyp: for T compact, f bounded by 1 and g(n) = T(f(n)): every
;;; subsequence of g has a convergent subsequence (the hypothesis of diagonal-subseq)
(sp (make-wff (forall-guarded '(v w t_ f g)
  (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) '(IS-COMPLEX-INNER-PRODUCT-SPACE w) '(IS-COMPACT-OP v w t_)
        '(IN f (FUN NN (VEC v))) (tqb-bound 'v 'f) '(IN g (FUN NN (VEC w)))
        '(FORALL n_ (IMPLIES (IN n_ NN) (= (g n_) (t_ (f n_))))))
  (tqb-subhyp (tqb-M 'w) 'g))))
(dk-peel!)
(let* ((bd (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'IP-NORM))) "the bound"))
       (geq (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x '(g n_)))) "the values"))
       (phi (cadr (dk-pick (dk-head? 'STRICTLY-MONO-NN) "the reindexing")))
       (f1 (list 'SUBSEQ 'f phi))
       (g1 (list 'SUBSEQ 'g phi)))
  (dk-cite! 'bop-fun 'v 'w 't_)
  (tqb-iff-fwd! 'strictly-mono-nn phi)
  (dk-cite! 'subseq-fun-typing 'f '(VEC v) phi)
  (dk-cite! 'subseq-fun-typing 'g '(VEC w) phi)
  (dk-have! (tqb-bound 'v f1)
    (lambda ()
      (let ((k (dk-di-var!)))
        (dk-cite! 'fun-apply-type-c phi 'NN 'NN k)
        (subst (dk-cite! 'subseq-apply 'f phi k))
        (dk-apply! bd (list phi k))
        (dk-close-if-asm!))))
  (let* ((ex (dk-cite! 'compact-op-seq 'v 'w 't_ f1))
         (phq (dk-skolem! ex))
         (ex2 (dk-pick (lambda (x) (and (dk-head-is? x 'FORSOME) (memq phq (free-vars x)))) "the limit"))
         (lq (dk-skolem! ex2))
         (ucl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (memq lq (free-vars x)))) "the limit clause"))
         (bq (list 'SUBSEQ g1 phq)))
    (tqb-iff-fwd! 'strictly-mono-nn phq)
    (dk-cite! 'subseq-fun-typing g1 '(VEC w) phq)
    (dk-have! (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN) (list '= (list bq 'nq_) (list 't_ (list f1 (list phq 'nq_))))))
      (lambda ()
        (let* ((k (dk-di-var!)) (pk (list phq k)) (ppk (list phi pk)))
          (dk-cite! 'fun-apply-type-c phq 'NN 'NN k)
          (dk-cite! 'fun-apply-type-c phi 'NN 'NN pk)
          (dk-cite! 'fun-apply-type-c 'f 'NN '(VEC v) ppk)
          (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) (list 'f ppk))
          (subst (dk-cite! 'subseq-apply g1 phq k))
          (subst (dk-cite! 'subseq-apply 'g phi pk))
          (subst (dk-cite! 'subseq-apply 'f phi pk))
          (dk-apply! geq ppk)
          (let ((leaf (proof-state-focus *ps*)))
            (subst (list '= (list 'g ppk) (list 't_ (list 'f ppk))))
            (tqb-rfl-trivial!)))))
    (let ((cv (dk-apply! ucl bq)))
      (tqb-iff-fwd! 'converges-to (tqb-M 'w) bq lq)
      (witness! phq
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal)) (ass)
                  (witness! lq (lambda () (dk-conj-close! (lambda () (ass)))))))))))))
(tqb-qed! 'compact-op-subseq-hyp)

;;; ------------------------------------------------------------------------------------------
;;; compact-op-norm-limit: T bounded, w a Hilbert space, (T_k) compact, and for every eps > 0
;;; some T_k with ||T x - T_k x|| <= eps on the unit ball (that is, ||T - T_k|| <= eps):
;;; T is compact.  The diagonal subsequence of the T_k f, then T f along it is Cauchy (eps/4
;;; three times) and converges by completeness.
(define (tqb-approx v w t tk)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'kq_ (list 'AND '(IN kq_ NN)
      (list 'FORALL 'xq_ (list 'IMPLIES (list 'IN 'xq_ (list 'VEC v))
        (list 'IMPLIES (list '<= (list 'IP-NORM v 'xq_) 1)
          (list '<= (list 'IP-NORM w (list (list 'VADD w) (list t 'xq_) (list (list 'VNEG w) (list (list tk 'kq_) 'xq_))))
                'eps)))))))))

(sp (make-wff (forall-guarded '(v w t_ tk)
  (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) '(IS-HILBERT-SPACE w) '(IN t_ (BOUNDED-OPS v w))
        '(IN tk (FUN NN (BOUNDED-OPS v w))) '(FORALL k (IMPLIES (IN k NN) (IS-COMPACT-OP v w (tk k))))
        (tqb-approx 'v 'w 't_ 'tk))
  '(IS-COMPACT-OP v w t_))))
(dk-peel!)
(let* ((ms (tqb-M 'w))
       (ptsw (list 'PTS ms))
       (dist (lambda (a b) (list (list 'DIST ms) a b)))
       (hcomp (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'IS-COMPACT-OP))) "the compact family"))
       (happ (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'POS-RR))) "the approximation")))
  (tqb-iff-fwd! 'is-hilbert-space 'w)
  (dk-cite! 'ip-metric-space-is-metric-space 'w)
  (tqb-pts-eq! 'w)
  (dk-cite! 'bop-fun 'v 'w 't_)
  (dk-have! (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN NN (VEC v))) (list 'IMPLIES (tqb-bound 'v 'f) (tqb-seqc 'v 'w 't_ 'f))))
    (lambda ()
      (let* ((lk (dk-peel!))
             (f (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (pair? (caddr x)) (eq? (car (caddr x)) 'FUN))) lk)))
             (bd (find-first (lambda (x) (dk-head-is? x 'FORALL)) lk))
             (tki (lambda (k) (list 'tk k)))
             (lama (list 'VNB-LAMBDA 'tqk_ 'NN (list 'VNB-LAMBDA 'tqm_ 'NN (list '(tk tqk_) (list f 'tqm_)))))
             (fama (list 'FUN 'NN (list 'FUN 'NN ptsw))))
        ;; the family a(k)(m) = T_k(f(m))
        (dk-have! (list 'IN lama fama)
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((k (dk-di-var!)))
                  (dk-cite! 'fun-apply-type-c 'tk 'NN '(BOUNDED-OPS v w) k)
                  (dk-cite! 'bop-fun 'v 'w (tki k))
                  (dk-lam-type!
                    (lambda ()
                      (let ((m (dk-di-var!)))
                        (dk-cite! 'fun-apply-type-c f 'NN '(VEC v) m)
                        (dk-cite! 'fun-apply-type-c (tki k) '(VEC v) '(VEC w) (list f m))
                        (tqb-swap! 'w (list 'IN (list (tki k) (list f m)) ptsw))
                        (dk-close-if-asm!)))
                    (lambda () (fact 'nn-is-set) (dk-close-if-asm!)))))
              (lambda () (fact 'nn-is-set) (dk-close-if-asm!)))))
        (let* ((af (dk-name! lama fama))
               (veq (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
                      (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '= (list (list af 'k) 'n_) (list '(tk k) (list f 'n_)))))))))
          (dk-have! veq
            (lambda ()
              (let* ((lk2 (dk-peel!))
                     (ns (map cadr (filter (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) lk2)))
                     (k (car ns)) (m (cadr ns)))
                (dk-cite! 'fun-apply-type-c 'tk 'NN '(BOUNDED-OPS v w) k)
                (dk-cite! 'bop-fun 'v 'w (tki k))
                (dk-cite! 'fun-apply-type-c f 'NN '(VEC v) m)
                (dk-cite! 'fun-apply-type-c (tki k) '(VEC v) '(VEC w) (list f m))
                (subst (list '= af lama))
                (if (not (dk-lam-b!)) (rfl)))))
          ;; each a(k) has the subsequence property
          (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (tqb-subhyp ms (list af 'k))))
            (lambda ()
              (let* ((lk2 (dk-peel!))
                     (k (tqb-nn-var lk2))
                     (ph (cadr (find-first (dk-head? 'STRICTLY-MONO-NN) lk2))))
                (dk-apply! hcomp k)
                (dk-cite! 'fun-apply-type-c af 'NN (list 'FUN 'NN ptsw) k)
                (tqb-swap! 'w (list 'IN (list af k) (list 'FUN 'NN '(VEC w))))
                (dk-apply! veq k)
                (dk-apply! (dk-cite! 'compact-op-subseq-hyp 'v 'w (tki k) f (list af k)) ph)
                (dk-close-if-asm!))))
          (let* ((dx (dk-fact! 'diagonal-subseq ms af))
                 (delta (dk-skolem! dx))
                 (dconv (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x delta) (dk-contains? x 'CONVERGES-TO))) "the diagonal convergence"))
                 (xd (lambda (m) (list f (list delta m))))
                 (lamu (list 'VNB-LAMBDA 'tqm_ 'NN (list 't_ (list f (list delta 'tqm_))))))
            (tqb-iff-fwd! 'strictly-mono-nn delta)
            (dk-have! (list 'IN lamu (list 'FUN 'NN ptsw))
              (lambda ()
                (dk-lam-type!
                  (lambda ()
                    (let ((m (dk-di-var!)))
                      (dk-cite! 'fun-apply-type-c delta 'NN 'NN m)
                      (dk-cite! 'fun-apply-type-c f 'NN '(VEC v) (list delta m))
                      (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) (xd m))
                      (tqb-swap! 'w (list 'IN (list 't_ (xd m)) ptsw))
                      (dk-close-if-asm!)))
                  (lambda () (fact 'nn-is-set) (dk-close-if-asm!)))))
            (let* ((u (dk-name! lamu (list 'FUN 'NN ptsw)))
                   (uval (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '= (list u 'n_) (list 't_ (xd 'n_)))))))
              (dk-have! uval
                (lambda ()
                  (let ((m (dk-di-var!)))
                    (dk-cite! 'fun-apply-type-c delta 'NN 'NN m)
                    (dk-cite! 'fun-apply-type-c f 'NN '(VEC v) (list delta m))
                    (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) (xd m))
                    (subst (list '= u lamu))
                    (if (not (dk-lam-b!)) (rfl)))))
              ;; u is Cauchy
              (let* ((ci (dk-cite! 'is-cauchy-seq ms u))
                     (ccl (caddr (caddr (caddr ci)))))
                (dk-have! ccl
                  (lambda ()
                    (let* ((lk3 (dk-peel!))
                           (eps (cadr (find-first (dk-head? 'POS-RR) lk3)))
                           (_e (dk-cite! 'rr-pos-rr-in-rr eps))
                           (d1 (dk-halve! eps))
                           (d2 (dk-halve! d1))
                           (kk (dk-skolem! (dk-apply! happ d2)))
                           (xcl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x (list 'tk kk)))) "the approximant"))
                           (pk (dk-skolem! (dk-apply! dconv kk)))
                           (av (list 'SUBSEQ (list af kk) delta))
                           (cva (dk-pick (lambda (x) (and (dk-head-is? x 'CONVERGES-TO) (dk-contains? x pk))) "the k-th limit")))
                      (dk-cite! 'fun-apply-type-c af 'NN (list 'FUN 'NN ptsw) kk)
                      (dk-cite! 'fun-apply-type-c 'tk 'NN '(BOUNDED-OPS v w) kk)
                      (dk-cite! 'bop-fun 'v 'w (tki kk))
                      (dk-cite! 'subseq-fun-typing (list af kk) ptsw delta)
                      (dk-cite! 'metric-converges-to-cauchy ms av pk)
                      (tqb-iff-fwd! 'is-cauchy-seq ms av)
                      (let* ((acl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'POS-RR) (dk-contains? x av))) "the Cauchy clause of a"))
                             (nb (dk-skolem! (dk-apply! acl d2)))
                             (atail (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x nb) (dk-contains? x av))) "the Cauchy tail of a"))
                             ;; dist(u m, a m) <= d2
                             (near (lambda (m)
                                     (let ((g (list '<= (dist (list u m) (list av m)) d2)))
                                       (dk-have! g
                                         (lambda ()
                                           (dk-cite! 'fun-apply-type-c delta 'NN 'NN m)
                                           (dk-cite! 'fun-apply-type-c f 'NN '(VEC v) (list delta m))
                                           (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) (xd m))
                                           (dk-cite! 'fun-apply-type-c (tki kk) '(VEC v) '(VEC w) (xd m))
                                           (dk-apply! uval m)
                                           (subst (list '= (list u m) (list 't_ (xd m))))
                                           (subst (dk-cite! 'subseq-apply (list af kk) delta m))
                                           (dk-apply! (dk-apply! veq kk) (list delta m))
                                           (subst (list '= (list (list af kk) (list delta m)) (list (tki kk) (xd m))))
                                           (subst (dk-cite! 'ipms-dist-norm 'w (list 't_ (xd m)) (list (tki kk) (xd m))))
                                           (dk-apply! bd (list delta m))
                                           (dk-apply! xcl (xd m))
                                           (dk-close-if-asm!)))
                                       g))))
                        (witness! nb
                          (lambda ()
                            (dk-conj-close!
                              (lambda ()
                                (if (dk-asm? (dk-goal)) (ass)
                                    (let* ((lk4 (dk-peel!))
                                           (ns (map cadr (filter (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) lk4)))
                                           (m (car ns)) (n (cadr ns))
                                           (um (list u m)) (un (list u n)) (am (list av m)) (an (list av n)))
                                      (dk-cite! 'fun-apply-type-c u 'NN ptsw m)
                                      (dk-cite! 'fun-apply-type-c u 'NN ptsw n)
                                      (dk-cite! 'fun-apply-type-c av 'NN ptsw m)
                                      (dk-cite! 'fun-apply-type-c av 'NN ptsw n)
                                      (if (not (dk-asm? (list 'AND (list '<= nb m) (list '<= nb n))))
                                          (tqb-have-and! (list '<= nb m) (list '<= nb n)))
                                      (let* ((h1 (near m)) (h2 (near n))
                                             (h3 (dk-apply! atail m n))
                                             (t1 (dk-cite! 'metric-triangle ms um am un))
                                             (t2 (dk-cite! 'metric-triangle ms am an un))
                                             (sy (dk-cite! 'metric-sym ms an un)))
                                        (for-each (lambda (pr) (dk-cite! 'metric-dist-real ms (car pr) (cadr pr)))
                                                  (list (list um am) (list am un) (list am an) (list an un) (list um un) (list un an)))
                                        (dk-ineq! h1 h2 h3 t1 t2 sy (list '= (list '+ d1 d1) eps) (list '= (list '+ d2 d2) d1)
                                                  (list '< 0 d2)))))))))))))
                (tqb-iff-bwd! 'is-cauchy-seq ms u)
                (tqb-iff-fwd! 'is-complete ms)
                (dk-apply! (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'IS-CAUCHY-SEQ) (dk-contains? x 'CONVERGES))) "completeness") u)
                (let* ((cex (find-first (dk-head? 'FORSOME) (dk-landed (lambda () (mac-h 'CONVERGES (list 'CONVERGES ms u))))))
                       (lq (dk-skolem! cex)))
                  (witness! delta
                    (lambda ()
                      (dk-conj-close!
                        (lambda ()
                          (if (dk-asm? (dk-goal)) (ass)
                              (witness! lq
                                (lambda ()
                                  (let* ((lk5 (dk-peel!))
                                         (b (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (pair? (caddr x)) (eq? (car (caddr x)) 'FUN))) lk5)))
                                         (eqb (find-first (lambda (x) (dk-head-is? x 'FORALL)) lk5)))
                                    (tqb-swap! 'w (list 'IN b (list 'FUN 'NN ptsw)))
                                    (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '= (list b 'n_) (list u 'n_))))
                                      (lambda ()
                                        (let ((m (dk-di-var!)))
                                          (dk-apply! eqb m)
                                          (dk-apply! uval m)
                                          (subst (list '= (list b m) (list 't_ (xd m))))
                                          (let ((leaf (proof-state-focus *ps*)))
                                            (subst (list '= (list u m) (list 't_ (xd m))))
                                            (if (tqb-trivial-goal?)
                                                (begin (dk-cite! 'fun-apply-type-c delta 'NN 'NN m)
                                                       (dk-cite! 'fun-apply-type-c f 'NN '(VEC v) (list delta m))
                                                       (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) (xd m))
                                                       (rfl)))))))
                                    (dk-cite! 'converges-ptwise-eq ms u b lq)
                                    (dk-close-if-asm!)))))))))))))))))
  (dk-cite! 'compact-op-intro 'v 'w 't_)
  (dk-close-if-asm!))
(tqb-qed! 'compact-op-norm-limit)

;;; ======== from b3-adjoint.scm
;;; ==========================================================================================
;;; (B3) T COMPACT IMPLIES T* COMPACT (H a Hilbert space).  T T* is compact (compact o
;;; bounded); along a subsequence where T T* f converges, ||T* y||^2 = <T T* y, y>
;;; <= ||T T* y|| ||y|| <= 2 ||T T* y|| (y a difference of two terms of f), so T* f is Cauchy
;;; there and converges by completeness.  Library: operator-algebras.  Prefix tqb-.
;;; ==========================================================================================

(define tqb-ts '(OP-ADJOINT v v t_))
(define tqb-tt (list 'BOP-COMP 'v 't_ tqb-ts))

(sp (make-wff (forall-guarded '(v t_) '((IS-HILBERT-SPACE v) (IS-COMPACT-OP v v t_))
  (list 'IS-COMPACT-OP 'v 'v tqb-ts))))
(dk-peel!)
(let* ((ts tqb-ts) (tt tqb-tt) (ms (tqb-M 'v)) (ptsv (list 'PTS ms))
       (dist (lambda (a b) (list (list 'DIST ms) a b)))
       (nrm (lambda (x) (list 'IP-NORM 'v x))))
  (tqb-iff-fwd! 'is-hilbert-space 'v)
  (dk-cite! 'compact-op-bounded 'v 'v 't_)
  (dk-cite! 'bop-fun 'v 'v 't_)
  (dk-cite! 'op-adjoint-bounded 'v 'v 't_)
  (dk-cite! 'op-adjoint-fun 'v 'v 't_)
  (dk-cite! 'compact-op-comp-right 'v ts 't_)
  (dk-cite! 'compact-op-bounded 'v 'v tt)
  (dk-cite! 'bop-fun 'v 'v tt)
  (dk-cite! 'ip-metric-space-is-metric-space 'v)
  (tqb-pts-eq! 'v)
  (dk-have! (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN NN (VEC v))) (list 'IMPLIES (tqb-bound 'v 'f) (tqb-seqc 'v 'v ts 'f))))
    (lambda ()
      (let* ((lk (dk-peel!))
             (f (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (pair? (caddr x)) (eq? (car (caddr x)) 'FUN))) lk)))
             (bd (find-first (lambda (x) (dk-head-is? x 'FORALL)) lk))
             (ex (dk-cite! 'compact-op-seq 'v 'v tt f))
             (phq (dk-skolem! ex))
             (ex2 (dk-pick (lambda (x) (and (dk-head-is? x 'FORSOME) (memq phq (free-vars x)))) "the limit"))
             (lq (dk-skolem! ex2))
             (ucl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (memq lq (free-vars x)))) "the limit clause"))
             (xs (lambda (m) (list f (list phq m))))
             (xty! (lambda (m)
                     (dk-cite! 'fun-apply-type-c phq 'NN 'NN m)
                     (dk-cite! 'fun-apply-type-c f 'NN '(VEC v) (list phq m)))))
        (tqb-iff-fwd! 'strictly-mono-nn phq)
        ;; c(m) = T T* f(phq m), convergent hence Cauchy
        (let ((lamc (list 'VNB-LAMBDA 'tqm_ 'NN (list tt (list f (list phq 'tqm_))))))
          (dk-have! (list 'IN lamc '(FUN NN (VEC v)))
            (lambda ()
              (dk-lam-type!
                (lambda () (let ((m (dk-di-var!)))
                             (xty! m)
                             (dk-cite! 'fun-apply-type-c tt '(VEC v) '(VEC v) (xs m))
                             (dk-close-if-asm!)))
                (lambda () (fact 'nn-is-set) (dk-close-if-asm!)))))
          (let* ((c (dk-name! lamc '(FUN NN (VEC v))))
                 (cval (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '= (list c 'n_) (list tt (xs 'n_)))))))
            (dk-have! cval
              (lambda ()
                (let ((m (dk-di-var!)))
                  (xty! m)
                  (dk-cite! 'fun-apply-type-c tt '(VEC v) '(VEC v) (xs m))
                  (subst (list '= c lamc))
                  (if (not (dk-lam-b!)) (rfl)))))
            (dk-apply! ucl c)
            (dk-cite! 'metric-converges-to-cauchy ms c lq)
            (tqb-iff-fwd! 'is-cauchy-seq ms c)
            (let ((cclc (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'POS-RR) (dk-contains? x c))) "the Cauchy clause of c"))
                  (lamu (list 'VNB-LAMBDA 'tqm_ 'NN (list ts (list f (list phq 'tqm_))))))
              (dk-have! (list 'IN lamu (list 'FUN 'NN ptsv))
                (lambda ()
                  (dk-lam-type!
                    (lambda () (let ((m (dk-di-var!)))
                                 (xty! m)
                                 (dk-cite! 'fun-apply-type-c ts '(VEC v) '(VEC v) (xs m))
                                 (tqb-swap! 'v (list 'IN (list ts (xs m)) ptsv))
                                 (dk-close-if-asm!)))
                    (lambda () (fact 'nn-is-set) (dk-close-if-asm!)))))
              (let* ((u (dk-name! lamu (list 'FUN 'NN ptsv)))
                     (uval (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '= (list u 'n_) (list ts (xs 'n_)))))))
                (dk-have! uval
                  (lambda ()
                    (let ((m (dk-di-var!)))
                      (xty! m)
                      (dk-cite! 'fun-apply-type-c ts '(VEC v) '(VEC v) (xs m))
                      (subst (list '= u lamu))
                      (if (not (dk-lam-b!)) (rfl)))))
                ;; u is Cauchy
                (let* ((ci (dk-cite! 'is-cauchy-seq ms u))
                       (ccl (caddr (caddr (caddr ci)))))
                  (dk-have! ccl
                    (lambda ()
                      (let* ((lk3 (dk-peel!))
                             (eps (cadr (find-first (dk-head? 'POS-RR) lk3)))
                             (ee (list '* eps eps)))
                        (dk-cite! 'rr-pos-rr-in-rr eps)
                        (dk-cite! 'rr-lt-of-pos-rr eps)
                        (dk-cite! 'rr-mul-in-rr eps eps)
                        (dk-cite! 'rr-mul-pos eps eps)
                        (dk-cite! 'rr-pos-rr-of-lt ee)
                        (let* ((d (dk-halve! ee))
                               (nb (dk-skolem! (dk-apply! cclc d)))
                               (ctail (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x nb) (dk-contains? x c))) "the Cauchy tail of c")))
                          (witness! nb
                            (lambda ()
                              (dk-conj-close!
                                (lambda ()
                                  (if (dk-asm? (dk-goal)) (ass)
                                      (let* ((lk4 (dk-peel!))
                                             (ns (map cadr (filter (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) lk4)))
                                             (m (car ns)) (n (cadr ns))
                                             (xm (xs m)) (xn (xs n))
                                             (y (tqb-sub xm xn))
                                             (ty (list ts y)) (tty (list 't_ ty)))
                                        (if (not (dk-asm? (list 'AND (list '<= nb m) (list '<= nb n))))
                                            (tqb-have-and! (list '<= nb m) (list '<= nb n)))
                                        (xty! m) (xty! n)
                                        (tqb-vt! y) (tqb-vt! ty) (tqb-vt! tty)
                                        (dk-cite! 'fun-apply-type-c ts '(VEC v) '(VEC v) xm)
                                        (dk-cite! 'fun-apply-type-c ts '(VEC v) '(VEC v) xn)
                                        (dk-cite! 'cips-vneg-type 'v xn)
                                        (let* ((h3 (dk-apply! ctail m n))
                                               ;; T*(xm - xn) = T* xm - T* xn and T(T* xm - T* xn) = T T* xm - T T* xn
                                               (e1 (dk-cite! 'bop-add 'v 'v ts xm (list '(VNEG v) xn)))
                                               (e2 (dk-cite! 'bop-vneg 'v 'v ts xn))
                                               (txm (list ts xm)) (txn (list ts xn)))
                                          (dk-cite! 'cips-vneg-type 'v txn)
                                          (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) txm)
                                          (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) txn)
                                          (let* ((e3 (dk-cite! 'bop-add 'v 'v 't_ txm (list '(VNEG v) txn)))
                                                 (e4 (dk-cite! 'bop-vneg 'v 'v 't_ txn))
                                                 (ta (nrm tty)) (yn (nrm y)) (nn (nrm ty))
                                                 (z (list '(IP v) ty ty)))
                                            (dk-cite! 'bop-comp-apply 'v 't_ ts xm)
                                            (dk-cite! 'bop-comp-apply 'v 't_ ts xn)
                                            (dk-apply! cval m) (dk-apply! cval n)
                                            (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) txm)
                                            (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) txn)
                                            (dk-cite! 'ipms-dist-norm 'v (list 't_ txm) (list 't_ txn))
                                            ;; ||T T* y|| <= d
                                            (let ((ha (list '<= ta d)))
                                              (dk-have! ha
                                                (lambda ()
                                                  (subst e1) (subst e2) (subst e3) (subst e4)
                                                  (subst (list '= (nrm (tqb-sub (list 't_ txm) (list 't_ txn)))
                                                                  (dist (list 't_ txm) (list 't_ txn))))
                                                  (subst (list '= (list 't_ txm) (list tt xm)))
                                                  (subst (list '= (list 't_ txn) (list tt xn)))
                                                  (subst (list '= (list tt xm) (list c m)))
                                                  (subst (list '= (list tt xn) (list c n)))
                                                  (dk-close-if-asm!)))
                                              ;; ||y|| <= 2
                                              (let ((hy (list '<= yn 2)))
                                                (dk-have! hy
                                                  (lambda ()
                                                    (let* ((mk (dk-cite! 'cips-minkowski 'v xm (list '(VNEG v) xn)))
                                                           (nv (dk-cite! 'ip-norm-vneg 'v xn))
                                                           (b1 (dk-apply! bd (list phq m)))
                                                           (b2 (dk-apply! bd (list phq n))))
                                                      (tqb-nt! 'v xm) (tqb-nt! 'v xn) (tqb-nt! 'v (list '(VNEG v) xn)) (tqb-nt! 'v y)
                                                      (dk-ineq! mk nv b1 b2))))
                                                (tqb-nt! 'v tty) (tqb-nt! 'v y) (tqb-nt! 'v ty)
                                                (let* ((hb (dk-cite! 'cips-ip-magnitude-le 'v tty y))
                                                       (eq2 (dk-cite! 'op-adjoint-ip 'v 'v 't_ ty y))
                                                       (zr (dk-cite! 'cips-ip-self-real 'v ty))
                                                       (z0 (dk-cite! 'cips-ip-self-nonneg 'v ty))
                                                       (eq1 (dk-cite! 'ip-norm-sq 'v ty))
                                                       (hb2 (dk-rewrite-h! hb (list '(IP v) tty y) z))
                                                       (ma (dk-cite! 'rr-magnitude-is-abs z))
                                                       (la (dk-cite! 'rr-le-abs z)))
                                                  (dk-cite! 'rr-subset-cc z)
                                                  (dk-cite! 'cc-magnitude-closed z)
                                                  (dk-have! '(IN 2 RR) (lambda () (arith)))
                                                  (let* ((ml (dk-cite! 'rr-mul-le-right yn 2 ta))
                                                         (cm (list '= (list '* ta yn) (list '* yn ta))))
                                                    (dk-cite! 'rr-mul-in-rr ta yn)
                                                    (dk-cite! 'rr-mul-in-rr yn ta)
                                                    (dk-have! cm (lambda () (crs)))
                                                    (let ((sq (list '<= (list '* nn nn) ee)))
                                                      (dk-have! sq
                                                        (lambda ()
                                                          (tqb-lin! '() (list eq1 hb2 ma la cm ml ha (list '= (list '+ d d) ee)))))
                                                      (dk-have! (list '<= 0 eps) (lambda () (dk-ineq! (list '< 0 eps))))
                                                      (dk-cite! 'rr-square-le-imp-le nn eps)
                                                      ;; the goal: dist(u m, u n) <= eps
                                                      (dk-apply! uval m) (dk-apply! uval n)
                                                      (dk-cite! 'ipms-dist-norm 'v txm txn)
                                                      (subst (list '= (list u m) txm))
                                                      (subst (list '= (list u n) txn))
                                                      (subst (list '= (dist txm txn) (nrm (tqb-sub txm txn))))
                                                      (subst (list '= (list '(VNEG v) txn) (list ts (list '(VNEG v) xn))))
                                                      (subst (list '= (list '(VADD v) txm (list ts (list '(VNEG v) xn))) ty))
                                                      (dk-close-if-asm!))))))))))))))))))
                  (tqb-iff-bwd! 'is-cauchy-seq ms u)
                  (tqb-iff-fwd! 'is-complete ms)
                  (dk-apply! (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'IS-CAUCHY-SEQ) (dk-contains? x 'CONVERGES))) "completeness") u)
                  (let* ((cex (find-first (dk-head? 'FORSOME) (dk-landed (lambda () (mac-h 'CONVERGES (list 'CONVERGES ms u))))))
                         (lq2 (dk-skolem! cex)))
                    (witness! phq
                      (lambda ()
                        (dk-conj-close!
                          (lambda ()
                            (if (dk-asm? (dk-goal)) (ass)
                                (witness! lq2
                                  (lambda ()
                                    (let* ((lk5 (dk-peel!))
                                           (b (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (pair? (caddr x)) (eq? (car (caddr x)) 'FUN))) lk5)))
                                           (eqb (find-first (lambda (x) (dk-head-is? x 'FORALL)) lk5)))
                                      (tqb-swap! 'v (list 'IN b (list 'FUN 'NN ptsv)))
                                      (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '= (list b 'n_) (list u 'n_))))
                                        (lambda ()
                                          (let ((m (dk-di-var!)))
                                            (dk-apply! eqb m)
                                            (dk-apply! uval m)
                                            (subst (list '= (list b m) (list ts (xs m))))
                                            (subst (list '= (list u m) (list ts (xs m))))
                                            (if (tqb-trivial-goal?)
                                                (begin (xty! m)
                                                       (dk-cite! 'fun-apply-type-c ts '(VEC v) '(VEC v) (xs m))
                                                       (rfl))))))
                                      (dk-cite! 'converges-ptwise-eq ms u b lq2)
                                      (dk-close-if-asm!))))))))))))))))))
  (dk-cite! 'compact-op-intro 'v 'v tqb-ts)
  (dk-close-if-asm!))
(tqb-qed! 'compact-op-adjoint)

;;; ======== from b4-rank1.scm
;;; ==========================================================================================
;;; (B4) RANK-ONE OPERATORS x |-> <x | a> b ARE BOUNDED AND COMPACT (Example 1.60, the
;;; rank-one case).  Library: operator-algebras.  Prefix tqb-.
;;; ==========================================================================================

(define tqb-r1 '(RANK-ONE-OP v w a_ b_))
(define tqb-r1-hyps '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN a_ (VEC v)) (IN b_ (VEC w))))
(define (tqb-r1v x) (list '(ACT w) (list '(IP v) x 'a_) 'b_))

;;; rank-one-op-apply
(sp (make-wff (forall-guarded '(v w a_ b_ x_) (append tqb-r1-hyps '((IN x_ (VEC v))))
  (list '= (list tqb-r1 'x_) (tqb-r1v 'x_)))))
(dk-peel!)
(subst (dk-cite! 'rank-one-op-unfold 'v 'w 'a_ 'b_))
(dk-cite! 'cips-ip-type 'v 'x_ 'a_)
(dk-cite! 'cips-act-type 'w '((IP v) x_ a_) 'b_)
(if (not (dk-lam-b!)) (rfl))
(tqb-qed! 'rank-one-op-apply)

;;; rank-one-op-fun
(sp (make-wff (forall-guarded '(v w a_ b_) tqb-r1-hyps (list 'IN tqb-r1 '(FUN (VEC v) (VEC w))))))
(dk-peel!)
(subst (dk-cite! 'rank-one-op-unfold 'v 'w 'a_ 'b_))
(dk-lam-type!
  (lambda () (let ((x (dk-di-var!)))
               (dk-cite! 'cips-ip-type 'v x 'a_)
               (dk-cite! 'cips-act-type 'w (list '(IP v) x 'a_) 'b_)
               (dk-close-if-asm!)))
  (lambda () (dk-cite! 'cips-vec-set 'v) (dk-close-if-asm!)))
(tqb-qed! 'rank-one-op-fun)

;;; rank-one-op-bounded: ||<x|a> b|| <= (||a|| ||b||) ||x||
(sp (make-wff (forall-guarded '(v w a_ b_) tqb-r1-hyps (list 'IN tqb-r1 '(BOUNDED-OPS v w)))))
(dk-peel!)
(dk-cite! 'rank-one-op-fun 'v 'w 'a_ 'b_)
(tqb-nt! 'v 'a_)
(tqb-nt! 'w 'b_)
(dk-have! (list 'IS-LINEAR-OP 'v 'w tqb-r1)
  (lambda ()
    (mac 'is-linear-op)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IN)
            (ass)
            (let* ((lk (dk-peel!))
                   (g (dk-goal))
                   (arg (cadr (cadr g))))
              (fluid-let ((tqb-v 'v))
                (if (tqb-op? arg 'VADD)
                    (let ((x (cadr arg)) (y (caddr arg)))
                      (tqb-vt! arg)
                      (subst (dk-cite! 'rank-one-op-apply 'v 'w 'a_ 'b_ arg))
                      (subst (dk-cite! 'rank-one-op-apply 'v 'w 'a_ 'b_ x))
                      (subst (dk-cite! 'rank-one-op-apply 'v 'w 'a_ 'b_ y))
                      (subst (dk-cite! 'cips-ip-add-left 'v x y 'a_))
                      (dk-cite! 'cips-ip-type 'v x 'a_)
                      (dk-cite! 'cips-ip-type 'v y 'a_))
                    (let ((c (cadr arg)) (x (caddr arg)))
                      (tqb-vt! arg)
                      (subst (dk-cite! 'rank-one-op-apply 'v 'w 'a_ 'b_ arg))
                      (subst (dk-cite! 'rank-one-op-apply 'v 'w 'a_ 'b_ x))
                      (subst (dk-cite! 'cips-ip-homog-left 'v c x 'a_))
                      (dk-cite! 'cips-ip-type 'v x 'a_))))
              (fluid-let ((tqb-v 'w))
                (let ((g2 (dk-goal)))
                  (tqb-vec-eq! (cadr g2) (caddr g2))
                  (dk-close-if-asm!)))))))))
(let ((na '(IP-NORM v a_)) (nb '(IP-NORM w b_)))
  (dk-cite! 'rr-mul-in-rr na nb)
  (tqb-have-and! (list 'IN na 'RR) (list 'IN nb 'RR))
  (tqb-have-and! (list '<= 0 na) (list '<= 0 nb))
  (dk-cite! 'rr-leq-mul-nonneg na nb)
  (dk-have! (list 'FORALL 'box_ (list 'IMPLIES '(IN box_ (VEC v))
              (list '<= (list 'IP-NORM 'w (list tqb-r1 'box_)) (list '* (list '* na nb) '(IP-NORM v box_)))))
    (lambda ()
      (let* ((x (dk-di-var!))
             (c (list '(IP v) x 'a_))
             (nx (list 'IP-NORM 'v x))
             (mg (list 'magnitude c)))
        (dk-cite! 'cips-ip-type 'v x 'a_)
        (subst (dk-cite! 'rank-one-op-apply 'v 'w 'a_ 'b_ x))
        (subst (dk-cite! 'ip-norm-act 'w c 'b_))
        (dk-cite! 'cc-magnitude-closed c)
        (dk-cite! 'cc-magnitude-nonneg c)
        (tqb-nt! 'v x)
        (dk-cite! 'cips-ip-magnitude-le 'v x 'a_)
        (dk-cite! 'rr-mul-in-rr nx na)
        (dk-cite! 'rr-mul-le-right mg (list '* nx na) nb)
        (dk-cite! 'rr-mul-in-rr (list '* nx na) nb)
        (dk-cite! 'rr-mul-in-rr (list '* na nb) nx)
        (dk-have! (list '= (list '* (list '* na nb) nx) (list '* (list '* nx na) nb)) (lambda () (crs)))
        (subst (list '= (list '* (list '* na nb) nx) (list '* (list '* nx na) nb)))
        (dk-close-if-asm!))))
  (dk-cite! 'bop-intro 'v 'w tqb-r1 (list '* na nb))
  (dk-close-if-asm!))
(tqb-qed! 'rank-one-op-bounded)

;;; ipms-dist-act-diff: d(c x, d x) = ||x|| |c - d|
(sp (make-wff (forall-guarded '(w c_ d_ x_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN c_ CC) (IN d_ CC) (IN x_ (VEC w)))
  '(= ((DIST (IP-METRIC-SPACE w)) ((ACT w) c_ x_) ((ACT w) d_ x_)) (* (IP-NORM w x_) (magnitude (- c_ d_)))))))
(dk-peel!)
(mac 'binary-minus-def)
(fluid-let ((tqb-v 'w))
  (let ((cd '(+ c_ (- d_))))
    (tqb-ct! cd)
    (tqb-vt! '((ACT w) c_ x_))
    (tqb-vt! '((ACT w) d_ x_))
    (subst (dk-cite! 'ipms-dist-norm 'w '((ACT w) c_ x_) '((ACT w) d_ x_)))
    (subst (tqb-vec-eq! '((VADD w) ((ACT w) c_ x_) ((VNEG w) ((ACT w) d_ x_))) (list '(ACT w) cd 'x_)))
    (subst (dk-cite! 'ip-norm-act 'w cd 'x_))
    (dk-cite! 'cc-magnitude-closed cd)
    (dk-cite! 'ip-norm-in-rr 'w 'x_)
    (crs)))
(tqb-qed! 'ipms-dist-act-diff)

;;; rank-one-op-compact (Example 1.60, rank one): along a subsequence where <f(n)|a>
;;; converges to l (Bolzano-Weierstrass in CC), <f(n)|a> b converges to l b
(sp (make-wff (forall-guarded '(v w a_ b_) tqb-r1-hyps (list 'IS-COMPACT-OP 'v 'w tqb-r1))))
(dk-peel!)
(let* ((r tqb-r1) (mw (tqb-M 'w)) (na '(IP-NORM v a_)) (nb '(IP-NORM w b_)))
  (dk-cite! 'rank-one-op-bounded 'v 'w 'a_ 'b_)
  (dk-cite! 'rank-one-op-fun 'v 'w 'a_ 'b_)
  (dk-cite! 'ip-metric-space-is-metric-space 'w)
  (tqb-pts-eq! 'w)
  (tqb-nt! 'v 'a_)
  (tqb-nt! 'w 'b_)
  (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
  (dk-have! (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN NN (VEC v))) (list 'IMPLIES (tqb-bound 'v 'f) (tqb-seqc 'v 'w r 'f))))
    (lambda ()
      (let* ((lk (dk-peel!))
             (f (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (pair? (caddr x)) (eq? (car (caddr x)) 'FUN))) lk)))
             (bd (find-first (lambda (x) (dk-head-is? x 'FORALL)) lk))
             (h (list 'VNB-LAMBDA 'tqh_ 'NN (list '(IP v) (list f 'tqh_) 'a_))))
        (dk-have! (list 'IN h '(FUN NN CC))
          (lambda ()
            (dk-lam-type!
              (lambda () (let ((m (dk-di-var!)))
                           (dk-cite! 'fun-apply-type-c f 'NN '(VEC v) m)
                           (dk-cite! 'cips-ip-type 'v (list f m) 'a_)
                           (dk-close-if-asm!)))
              (lambda () (fact 'nn-is-set) (dk-close-if-asm!)))))
        (let* ((hn (dk-name! h '(FUN NN CC)))
               (hval (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list '= (list hn 'n_) (list '(IP v) (list f 'n_) 'a_))))))
          (dk-have! hval
            (lambda ()
              (let ((m (dk-di-var!)))
                (dk-cite! 'fun-apply-type-c f 'NN '(VEC v) m)
                (subst (list '= hn h))
                (if (not (dk-lam-b!)) (rfl)))))
          (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i NN) (list '<= (list 'magnitude (list hn 'i)) na)))
            (lambda ()
              (let* ((m (dk-di-var!))
                     (fm (list f m))
                     (nf (list 'IP-NORM 'v fm)))
                (dk-cite! 'fun-apply-type-c f 'NN '(VEC v) m)
                (subst (dk-apply! hval m))
                (dk-cite! 'cips-ip-type 'v fm 'a_)
                (dk-cite! 'cc-magnitude-closed (list '(IP v) fm 'a_))
                (tqb-nt! 'v fm)
                (dk-have! '(IN 1 RR) (lambda () (arith)))
                (let* ((hb (dk-cite! 'cips-ip-magnitude-le 'v fm 'a_))
                       (b1 (dk-apply! bd m))
                       (ml (dk-cite! 'rr-mul-le-right nf 1 na)))
                  (tqb-lin! (list (list 'IN nf 'RR) (list 'IN na 'RR)) (list hb ml))))))
          (let* ((ex (dk-cite! 'cc-bolzano-weierstrass-ptwise hn na))
                 (phi (dk-skolem! ex))
                 (ex2 (dk-pick (lambda (x) (and (dk-head-is? x 'FORSOME) (memq phi (free-vars x)))) "the limit"))
                 (l (dk-skolem! ex2))
                 (ucl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (memq l (free-vars x)) (dk-contains? x 'CC-MS))) "the limit clause"))
                 (cs (list 'SUBSEQ hn phi))
                 (lv (list '(ACT w) l 'b_)))
            (tqb-iff-fwd! 'strictly-mono-nn phi)
            (dk-cite! 'subseq-fun-typing hn 'CC phi)
            (dk-have! (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN) (list '= (list cs 'nq_) (list hn (list phi 'nq_)))))
              (lambda ()
                (let ((m (dk-di-var!)))
                  (dk-cite! 'fun-apply-type-c phi 'NN 'NN m)
                  (dk-cite! 'fun-apply-type-c hn 'NN 'CC (list phi m))
                  (subst (dk-cite! 'subseq-apply hn phi m))
                  (tqb-rfl-trivial!))))
            (dk-apply! ucl cs)
            (dk-cite! 'cips-act-type 'w l 'b_)
            (witness! phi
              (lambda ()
                (dk-conj-close!
                  (lambda ()
                    (if (dk-asm? (dk-goal)) (ass)
                        (witness! lv
                          (lambda ()
                            (let* ((lk5 (dk-peel!))
                                   (b (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (pair? (caddr x)) (eq? (car (caddr x)) 'FUN))) lk5)))
                                   (eqb (find-first (lambda (x) (dk-head-is? x 'FORALL)) lk5)))
                              (tqb-swap! 'w (list 'IN b (list 'FUN 'NN (list 'PTS mw))))
                              (tqb-swap! 'w (list 'IN lv (list 'PTS mw)))
                              (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                                          (list '<= (list (list 'DIST mw) (list b 'n_) lv)
                                                    (list '* nb (list '(DIST CC-MS) (list cs 'n_) l)))))
                                (lambda ()
                                  (let* ((m (dk-di-var!))
                                         (pm (list phi m))
                                         (fm (list f pm))
                                         (c (list '(IP v) fm 'a_)))
                                    (dk-cite! 'fun-apply-type-c phi 'NN 'NN m)
                                    (dk-cite! 'fun-apply-type-c f 'NN '(VEC v) pm)
                                    (dk-cite! 'cips-ip-type 'v fm 'a_)
                                    (subst (dk-apply! eqb m))
                                    (subst (dk-cite! 'rank-one-op-apply 'v 'w 'a_ 'b_ fm))
                                    (subst (dk-cite! 'subseq-apply hn phi m))
                                    (subst (dk-apply! hval pm))
                                    (subst (dk-cite! 'cc-ms-dist c l))
                                    (subst (dk-cite! 'ipms-dist-act-diff 'w c l 'b_))
                                    (dk-cite! 'cc-sub-in-cc c l)
                                    (dk-cite! 'cc-magnitude-closed (list '- c l))
                                    (dk-cite! 'rr-mul-in-rr nb (list 'magnitude (list '- c l)))
                                    (dk-cite! 'rr-leq-reflexive (list '* nb (list 'magnitude (list '- c l))))
                                    (dk-close-if-asm!))))
                              (dk-cite! 'ms-converges-of-scaled mw 'CC-MS b cs lv l nb)
                              (dk-close-if-asm!))))))))))))))
  (dk-cite! 'compact-op-intro 'v 'w r)
  (dk-close-if-asm!))
(tqb-qed! 'rank-one-op-compact)

;;; ======== from b5-subspace.scm
;;; ==========================================================================================
;;; (B5) A SUBSPACE kk OF A COMPLEX INNER PRODUCT SPACE v, WITH THE RESTRICTED OPERATIONS, IS
;;; ONE (SUB-CIPS, th3a2-vocab.scm); A CLOSED ONE OF A HILBERT SPACE IS A HILBERT SPACE.
;;; The restriction of a bounded / self-adjoint / compact operator leaving kk invariant is one
;;; on SUB-CIPS(v, kk); a self-adjoint operator leaving kk invariant leaves PERP(v, kk)
;;; invariant.  Library: operator-algebras.  Prefix tsb- (file-local), tqb- (helpers).
;;; ==========================================================================================

(define tsb-S '(SUB-CIPS v kk))
(define tsb-R '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define tsb-H '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-SUBMODULE v kk)))
(define (tsb-acc a) (list a tsb-S))
(define (tsb-head-in? acc e)
  (and (pair? e) (or (eq? (car e) acc) (any (lambda (x) (tsb-head-in? acc x)) e))))
(define (tsb-has-lam? g)
  (cond ((and (pair? g) (pair? (car g)) (eq? (caar g) 'VNB-LAMBDA)) #t)
        ((pair? g) (or (tsb-has-lam? (car g)) (tsb-has-lam? (cdr g))))
        (#t #f)))
(define (tsb-open?) (pair? (dk-open-leaves)))

;;; kk in SET, kk subset VEC v, CC in SET, the CC ring view a commutative ring
(define (tsb-base!)
  (if (not (dk-asm? '(SUBSET kk (VEC v)))) (dk-cite! 'submodule-subset 'v 'kk))
  (if (not (dk-asm? '(IN kk SET)))
      (begin (dk-cite! 'cips-vec-set 'v)
             (dk-cite! 'subclass-of-set-is-set 'kk '(VEC v))))
  (if (not (dk-asm? '(IN CC SET))) (fact 'cc-is-set))
  (if (not (dk-asm? '(IS-NORMED-FIELD CC-NORMED-FIELD))) (fact 'cc-is-normed-field))
  (if (not (dk-asm? (list 'IS-COMMUTATIVE-RING tsb-R)))
      (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)))

;;; x in kk  ==>  x in VEC v
(define (tsb-vv! x)
  (if (not (dk-asm? (list 'IN x '(VEC v))))
      (dk-cite! 'subset-mem-fwd 'kk '(VEC v) x)))
(define (tsb-vecall!)
  (for-each (lambda (h) (if (and (dk-head-is? h 'IN) (eq? (caddr h) 'kk)) (tsb-vv! (cadr h))))
            (dk-asms)))
;;; land (IN e kk): atoms from context, the operations of v by the submodule closure laws,
;;; an application (h a) by an invariance clause forall z in kk. h(z) in kk in context
(define (tsb-kt! e)
  (let ((g (list 'IN e 'kk)))
    (cond ((dk-asm? g) g)
          ((equal? e '(VZERO v)) (dk-cite! 'submodule-vzero-in 'v 'kk) g)
          ((and (pair? e) (equal? (car e) '(VADD v)))
           (tsb-kt! (cadr e)) (tsb-kt! (caddr e))
           (dk-cite! 'submodule-vadd-closed 'v 'kk (cadr e) (caddr e)) g)
          ((and (pair? e) (equal? (car e) '(VNEG v)))
           (tsb-kt! (cadr e)) (dk-cite! 'submodule-vneg-closed 'v 'kk (cadr e)) g)
          ((and (pair? e) (equal? (car e) '(ACT v)))
           (fluid-let ((tqb-v 'v)) (tqb-ct! (cadr e)) (tqb-scal! (cadr e)))
           (tsb-kt! (caddr e))
           (dk-cite! 'submodule-act-closed 'v 'kk (cadr e) (caddr e)) g)
          ((and (pair? e) (= (length e) 2)
                (find-first (lambda (h) (and (dk-head-is? h 'FORALL)
                                             (let ((b (caddr h)))
                                               (and (dk-head-is? b 'IMPLIES)
                                                    (equal? (cadr b) (list 'IN (cadr h) 'kk))
                                                    (equal? (caddr b) (list 'IN (list (car e) (cadr h)) 'kk))))))
                            (dk-asms)))
           => (lambda (cl) (tsb-kt! (cadr e)) (dk-apply! cl (cadr e)) g))
          (#t (error "tsb-kt!: no kk typing for" (expression->string e))))))

;;; ---- the read-offs of SUB-CIPS(v, kk) -----------------------------------------------------
(define (tsb-read-off! name acc val)
  (sp (make-wff (forall-guarded '(v kk) tsb-H (list '== (tsb-acc acc) val))))
  (dk-peel!)
  (tsb-base!)
  (slot acc)
  (mac 'SUB-CIPS)
  (nth-r)
  (if (and (tsb-open?) (tsb-head-in? acc (dk-goal))) (slot acc))
  (if (tsb-open?) (qrfl))
  (tqb-qed! name))
(tsb-read-off! 'sub-cips-scal 'SCAL tsb-R)
(tsb-read-off! 'sub-cips-vec 'VEC 'kk)
(tsb-read-off! 'sub-cips-vadd 'VADD '(VNB-LAMBDA (LIST tsbx_ tsby_) (CARTESIAN kk kk) ((VADD v) tsbx_ tsby_)))
(tsb-read-off! 'sub-cips-vzero 'VZERO '(VZERO v))
(tsb-read-off! 'sub-cips-vneg 'VNEG '(VNB-LAMBDA tsbx_ kk ((VNEG v) tsbx_)))
(tsb-read-off! 'sub-cips-act 'ACT '(VNB-LAMBDA (LIST tsbc_ tsbx_) (CARTESIAN CC kk) ((ACT v) tsbc_ tsbx_)))
(tsb-read-off! 'sub-cips-ip 'IP '(VNB-LAMBDA (LIST tsbx_ tsby_) (CARTESIAN kk kk) ((IP v) tsbx_ tsby_)))

;;; ---- the operations of SUB-CIPS(v, kk) on kk are those of v -------------------------------
(define (tsb-value! name vars hyps lhs rhs readoff)
  (sp (make-wff (forall-guarded (append '(v kk) vars) (append tsb-H hyps) (list '== lhs rhs))))
  (dk-peel!)
  (tsb-base!)
  (subst (dk-cite! readoff 'v 'kk))
  (dk-lam-b!)
  (if (tsb-open?) (qrfl))
  (tqb-qed! name))
(tsb-value! 'sub-cips-vadd-apply '(a_ b_) '((IN a_ kk) (IN b_ kk))
  (list (tsb-acc 'VADD) 'a_ 'b_) '((VADD v) a_ b_) 'sub-cips-vadd)
(tsb-value! 'sub-cips-vneg-apply '(a_) '((IN a_ kk))
  (list (tsb-acc 'VNEG) 'a_) '((VNEG v) a_) 'sub-cips-vneg)
(tsb-value! 'sub-cips-act-apply '(c_ a_) '((IN c_ CC) (IN a_ kk))
  (list (tsb-acc 'ACT) 'c_ 'a_) '((ACT v) c_ a_) 'sub-cips-act)
(tsb-value! 'sub-cips-ip-apply '(a_ b_) '((IN a_ kk) (IN b_ kk))
  (list (tsb-acc 'IP) 'a_ 'b_) '((IP v) a_ b_) 'sub-cips-ip)

;;; ---- the rewriting of a goal stated with SUB-CIPS operations into v's ---------------------
(define tsb-ops (list (tsb-acc 'VADD) (tsb-acc 'VNEG) (tsb-acc 'ACT) (tsb-acc 'IP)
                      (list 'ADD tsb-R) (list 'MUL tsb-R)))
(define (tsb-app? e) (and (pair? e) (member (car e) tsb-ops) #t))
;;; an innermost application of a SUB-CIPS operation (or of the ring view's ADD / MUL)
(define (tsb-find e)
  (cond ((not (pair? e)) #f)
        (#t (or (let loop ((l (if (tsb-app? e) (cdr e) e)))
                  (cond ((not (pair? l)) #f)
                        ((tsb-find (car l)) => (lambda (x) x))
                        (#t (loop (cdr l)))))
                (and (tsb-app? e) e)))))
(define (tsb-rw1! a)
  (let ((op (car (car a))))
    (cond ((eq? op 'VADD) (tsb-kt! (cadr a)) (tsb-kt! (caddr a))
                          (subst (dk-cite! 'sub-cips-vadd-apply 'v 'kk (cadr a) (caddr a))))
          ((eq? op 'VNEG) (tsb-kt! (cadr a))
                          (subst (dk-cite! 'sub-cips-vneg-apply 'v 'kk (cadr a))))
          ((eq? op 'ACT)  (fluid-let ((tqb-v 'v)) (tqb-ct! (cadr a))) (tsb-kt! (caddr a))
                          (subst (dk-cite! 'sub-cips-act-apply 'v 'kk (cadr a) (caddr a))))
          ((eq? op 'IP)   (tsb-kt! (cadr a)) (tsb-kt! (caddr a))
                          (subst (dk-cite! 'sub-cips-ip-apply 'v 'kk (cadr a) (caddr a))))
          ((memq op '(ADD MUL))
           (fluid-let ((tqb-v 'v)) (tqb-ct! (cadr a)) (tqb-ct! (caddr a)))
           (subst (dk-cite! (if (eq? op 'ADD) 'sip-cc-ring-add-value 'sip-cc-ring-mul-value) (cadr a) (caddr a))))
          (#t (error "tsb-rw1!" (expression->string a))))))
(define (tsb-rw!)
  (let loop ((fuel 60))
    (if (<= fuel 0) (error "tsb-rw!: out of fuel"))
    (let ((a (and (tsb-open?) (tsb-find (dk-goal)))))
      (if a (begin (tsb-rw1! a) (loop (- fuel 1)))))))

(define (tsb-vector? e)
  (or (equal? e '(VZERO v))
      (and (pair? e) (member (car e) '((VADD v) (VNEG v) (ACT v))) #t)
      (dk-asm? (list 'IN e 'kk))))
;;; close a law of v, stated with v's operations on points of kk
(define (tsb-close!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (ass))
          ((dk-head-is? g 'IFF)
           (let ((x (cadr (cadr (cadr g)))))
             (tsb-vv! x) (dk-cite! 'cips-ip-definite 'v x) (dk-close-if-asm!)))
          ((and (dk-head-is? g 'IN) (eq? (caddr g) 'RR))
           (let ((x (cadr (cadr g)))) (tsb-vv! x) (dk-cite! 'cips-ip-self-real 'v x) (dk-close-if-asm!)))
          ((dk-head-is? g '<=)
           (let ((x (cadr (caddr g)))) (tsb-vv! x) (dk-cite! 'cips-ip-self-nonneg 'v x) (dk-close-if-asm!)))
          ((and (dk-head-is? g '=) (tsb-vector? (cadr g)))
           (tsb-vecall!)
           (fluid-let ((tqb-v 'v)) (tqb-vec-eq! (cadr g) (caddr g)))
           (dk-close-if-asm!))
          ((dk-head-is? g '=)
           (tsb-vecall!)
           (fluid-let ((tqb-v 'v)) (tqb-expand!) (tqb-type-ips! (dk-goal)) (crs)))
          (#t (error "tsb-close!: unexpected goal" (expression->string g))))))
(define (tsb-peel!)
  (let loop ()
    (if (and (tsb-open?) (memq (dk-head (dk-goal)) '(FORALL IMPLIES))) (begin (di) (loop)))))
(define (tsb-atom-law!) (tsb-rw!) (if (tsb-open?) (tsb-close!)))
(define (tsb-law!)
  (tsb-peel!)
  (if (dk-head-is? (dk-goal) 'AND) (dk-conj-close! tsb-atom-law!) (tsb-atom-law!)))

;;; the leaves `lam-t' opens for a restricted operation
(define (tsb-beta!)
  (let loop ((fuel 20))
    (if (and (> fuel 0) (tsb-has-lam? (dk-goal)))
        (let ((before (dk-goal))) (lam-b)
          (if (not (equal? (dk-goal) before)) (loop (- fuel 1)))))))
(define (tsb-type-atom!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (ass))
          ((and (dk-head-is? g 'IN) (dk-head-is? (cadr g) 'CARTESIAN) (eq? (caddr g) 'SET))
           (mac 'cartesian-set-iff) (dk-conj-close! dk-ass!))
          ((and (dk-head-is? g 'IN) (eq? (caddr g) 'kk)) (tsb-kt! (cadr g)) (dk-close-if-asm!))
          ((and (dk-head-is? g 'IN) (eq? (caddr g) 'CC))
           (let ((ip (cadr g))) (tsb-vv! (cadr ip)) (tsb-vv! (caddr ip))
                (dk-cite! 'cips-ip-type 'v (cadr ip) (caddr ip)) (dk-close-if-asm!)))
          (#t (error "tsb-type-atom!: unexpected leaf" (expression->string g))))))
(define (tsb-type-leaf!)
  (let loop ()
    (let ((g (dk-goal)))
      (cond ((memq (dk-head g) '(FORALL IMPLIES)) (tsb-beta!) (if (memq (dk-head (dk-goal)) '(FORALL IMPLIES)) (di)) (loop))
            ((dk-head-is? g 'AND) (dk-conj-close! (lambda () (tsb-beta!) (tsb-type-atom!))))
            (#t (tsb-beta!) (tsb-type-atom!))))))
(define (tsb-fun-typing! x)
  (subst (dk-cite! (cdr (assq (car x) '((VADD . sub-cips-vadd) (VNEG . sub-cips-vneg) (ACT . sub-cips-act) (IP . sub-cips-ip))))
                   'v 'kk))
  (for-each (lambda (k) (dk-focus! k) (tsb-type-leaf!)) (dk-opened (lambda () (lam-t)))))

(define (tsb-conjunct!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (ass))
          ((and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl))
          ((dk-head-is? g 'IS-RING) (dk-cite! 'commutative-ring-is-ring tsb-R) (dk-close-if-asm!))
          ((and (dk-head-is? g 'IN) (equal? (cadr g) '(VZERO v)))
           (dk-cite! 'submodule-vzero-in 'v 'kk) (dk-close-if-asm!))
          ((and (dk-head-is? g 'IN) (pair? (caddr g)) (eq? (car (caddr g)) 'FUN)) (tsb-fun-typing! (cadr g)))
          ((memq (dk-head g) '(IS-ASSOCIATIVE IS-COMMUTATIVE IS-IDENTITY HAS-INVERSES)) (mac (dk-head g)) (tsb-law!))
          ((dk-head-is? g 'FORALL) (tsb-law!))
          (#t (error "tsb-conjunct!: unexpected conjunct" (expression->string g))))))

;;; run THUNK; on an error raise one carrying TAG, the report and the focus goal
(define (tsb-try tag thunk)
  (call-with-current-continuation
    (lambda (k)
      (with-exception-handler
        (lambda (e)
          (k (error "TSB stop" tag (if (condition? e) (condition/report-string e) e)
                    (if (tsb-open?) (expression->string (dk-goal)) "no open leaf"))))
        thunk))))

;;; ---- THE BRIDGE: SUB-CIPS(v, kk) is a complex inner product space -------------------------
(sp (make-wff (forall-guarded '(v kk) tsb-H (list 'IS-COMPLEX-INNER-PRODUCT-SPACE tsb-S))))
(dk-peel!)
(tsb-base!)
(dk-have! (list '= (list 'LENGTH tsb-S) 7)
  (lambda () (mac 'SUB-CIPS) (len-r) (if (and (tsb-open?) (equal? (dk-goal) '(= 7 7))) (arith))))
(mac 'IS-COMPLEX-INNER-PRODUCT-SPACE)
(tsb-try "isx-set" (lambda () (dk-isx-set!)))
(tsb-try "readoffs" (lambda ()
  (subst (dk-cite! 'sub-cips-scal 'v 'kk))
  (subst (dk-cite! 'sub-cips-vec 'v 'kk))
  (subst (dk-cite! 'sub-cips-vzero 'v 'kk))
  (subst (dk-cite! 'sip-cc-ring-carr))
  (subst (dk-cite! 'sip-cc-ring-one))))
(dk-conj-close! (lambda () (let ((g (dk-goal))) (tsb-try (expression->string g) tsb-conjunct!))))
;;; the substitution of a read-off owes (= X X) for X = VADD(S) / VNEG(S): X is certified
;;; once typed, so type it on a lane and close by reflexivity
(define tsb-fun-classes
  (list (cons (tsb-acc 'VADD) '(FUN (CARTESIAN kk kk) kk)) (cons (tsb-acc 'VNEG) '(FUN kk kk))
        (cons (tsb-acc 'ACT) '(FUN (CARTESIAN CC kk) kk)) (cons (tsb-acc 'IP) '(FUN (CARTESIAN kk kk) CC))))
(let loop ((fuel 10))
  (let ((k (find-first (lambda (n) (let ((g (dk-goal-of n)))
                                      (and (dk-head-is? g '=) (equal? (cadr g) (caddr g)) (assoc (cadr g) tsb-fun-classes))))
                       (dk-open-leaves))))
    (if (and k (> fuel 0))
        (let ((x (cadr (dk-goal-of k))))
          (dk-focus! k)
          (tsb-try "owed reflexivity"
            (lambda ()
              (dk-have! (list 'IN x (cdr (assoc x tsb-fun-classes))) (lambda () (tsb-fun-typing! x)))
              (rfl)))
          (loop (- fuel 1))))))
(tqb-qed! 'sub-cips-is-cips)

;;; the norm and the distance of SUB-CIPS(v, kk) on kk are those of v
(sp (make-wff (forall-guarded '(v kk a_) (append tsb-H '((IN a_ kk)))
  (list '== (list 'IP-NORM tsb-S 'a_) '(IP-NORM v a_)))))
(dk-peel!)
(tsb-base!)
(dk-cite! 'sub-cips-is-cips 'v 'kk)
(subst (dk-cite! 'ip-norm-unfold tsb-S 'a_))
(subst (dk-cite! 'ip-norm-unfold 'v 'a_))
(subst (dk-cite! 'sub-cips-ip-apply 'v 'kk 'a_ 'a_))
(if (tsb-open?) (qrfl))
(tqb-qed! 'sub-cips-norm)

(sp (make-wff (forall-guarded '(v kk a_ b_) (append tsb-H '((IN a_ kk) (IN b_ kk)))
  (list '= (list (list 'DIST (tqb-M tsb-S)) 'a_ 'b_) (list (list 'DIST (tqb-M 'v)) 'a_ 'b_)))))
(dk-peel!)
(tsb-base!)
(dk-cite! 'sub-cips-is-cips 'v 'kk)
(dk-cite! 'sub-cips-vec 'v 'kk)
(for-each (lambda (x)
            (tsb-vv! x)
            (dk-have! (list 'IN x (list 'VEC tsb-S)) (lambda () (subst (list '= (list 'VEC tsb-S) 'kk)) (ass))))
          '(a_ b_))
(subst (dk-cite! 'ipms-dist-norm tsb-S 'a_ 'b_))
(subst (dk-cite! 'ipms-dist-norm 'v 'a_ 'b_))
(tsb-rw!)
(let ((z '((VADD v) a_ ((VNEG v) b_))))
  (tsb-kt! z)
  (subst (dk-cite! 'sub-cips-norm 'v 'kk z))
  (fluid-let ((tqb-v 'v)) (tqb-vt! z))
  (dk-cite! 'ip-norm-in-rr 'v z)
  (tqb-rfl-trivial!))
(tqb-qed! 'sub-cips-dist)

;;; ---- convergence transfers from v to SUB-CIPS(v, kk) for sequences and limits in kk ------
;;; with (CONVERGES-TO M_v b l), b in FUN(NN, kk), l in kk in context: land CONVERGES-TO M_S b l
(define (tsb-conv-transfer! b l)
  (let* ((ms (tqb-M tsb-S)) (mv (tqb-M 'v)))
    (dk-cite! 'fun-codomain-superset b 'NN 'kk '(VEC v))
    (if (not (dk-asm? (list 'IN b (list 'FUN 'NN (list 'PTS ms)))))
        (dk-have! (list 'IN b (list 'FUN 'NN (list 'PTS ms)))
          (lambda () (subst (list '= (list 'PTS ms) (list 'VEC tsb-S))) (subst (list '= (list 'VEC tsb-S) 'kk)) (ass))))
    (if (not (dk-asm? (list 'IN l (list 'PTS ms))))
        (dk-have! (list 'IN l (list 'PTS ms))
          (lambda () (subst (list '= (list 'PTS ms) (list 'VEC tsb-S))) (subst (list '= (list 'VEC tsb-S) 'kk)) (ass))))
    (tsb-vv! l)
    (tqb-swap! 'v (list 'IN l (list 'PTS mv)))
    (dk-have! '(IN 1 RR) (lambda () (arith)))
    (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
    (dk-have! (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                (list '<= (list (list 'DIST ms) (list b 'n_) l) (list '* 1 (list (list 'DIST mv) (list b 'n_) l)))))
      (lambda ()
        (let* ((m (dk-di-var!)) (bm (list b m)))
          (dk-cite! 'fun-apply-type-c b 'NN 'kk m)
          (tsb-vv! bm)
          (tqb-swap! 'v (list 'IN bm (list 'PTS mv)))
          (subst (dk-cite! 'sub-cips-dist 'v 'kk bm l))
          (let ((dr (dk-cite! 'metric-dist-real mv bm l)))
            (dk-ineq! dr)))))
    (dk-cite! 'ms-converges-of-scaled ms mv b b l l 1)))

;;; the common context of the metric arguments
(define (tsb-metric-base!)
  (dk-cite! 'sub-cips-is-cips 'v 'kk)
  (dk-cite! 'ip-metric-space-is-metric-space tsb-S)
  (dk-cite! 'ip-metric-space-is-metric-space 'v)
  (dk-cite! 'ip-metric-space-pts tsb-S)
  (dk-cite! 'sub-cips-vec 'v 'kk)
  (tqb-pts-eq! 'v))

;;; ---- a closed subspace of a Hilbert space is a Hilbert space ------------------------------
(sp (make-wff (forall-guarded '(v kk) '((IS-HILBERT-SPACE v) (IS-SUBMODULE v kk) (IS-CLOSED (IP-METRIC-SPACE v) kk))
  (list 'IS-HILBERT-SPACE tsb-S))))
(dk-peel!)
(tqb-iff-fwd! 'is-hilbert-space 'v)
(tsb-base!)
(tsb-metric-base!)
(let* ((ms (tqb-M tsb-S)) (mv (tqb-M 'v)))
  (tqb-iff-fwd! 'is-complete mv)
  (let ((cmp (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'IS-CAUCHY-SEQ) (dk-contains? x mv))) "completeness of v")))
    (dk-have! (list 'FORALL 'tsbf_ (list 'IMPLIES (list 'IS-CAUCHY-SEQ ms 'tsbf_) (list 'CONVERGES ms 'tsbf_)))
      (lambda ()
        (let* ((lk (dk-peel!))
               (f (caddr (find-first (dk-head? 'IS-CAUCHY-SEQ) lk)))
               (ft (dk-cite! 'cauchy-seq-is-fun ms f))
               (ft2 (dk-rewrite-h! ft (list 'PTS ms) (list 'VEC tsb-S)))
               (ft3 (dk-rewrite-h! ft2 (list 'VEC tsb-S) 'kk)))
          (dk-cite! 'fun-codomain-superset f 'NN 'kk '(VEC v))
          (tqb-swap! 'v (list 'IN f (list 'FUN 'NN (list 'PTS mv))))
          (dk-have! (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                      (list '<= (list (list 'DIST mv) (list f 'm) (list f 'n_)) (list (list 'DIST ms) (list f 'm) (list f 'n_)))))))
            (lambda ()
              (let* ((lk2 (dk-peel!))
                     (ks (map cadr (filter (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) lk2))))
                (for-each (lambda (k)
                            (dk-cite! 'fun-apply-type-c f 'NN 'kk k)
                            (tsb-vv! (list f k))
                            (tqb-swap! 'v (list 'IN (list f k) (list 'PTS mv))))
                          ks)
                (subst (dk-cite! 'sub-cips-dist 'v 'kk (list f (car ks)) (list f (cadr ks))))
                (let ((dr (dk-cite! 'metric-dist-real mv (list f (car ks)) (list f (cadr ks)))))
                  (dk-cite! 'rr-leq-reflexive (cadr dr))
                  (dk-close-if-asm!)))))
          (dk-cite! 'ms-cauchy-of-dominated ms mv f f)
          (dk-apply! cmp f)
          (let* ((cex (find-first (dk-head? 'FORSOME) (dk-landed (lambda () (mac-h 'CONVERGES (list 'CONVERGES mv f))))))
                 (l (dk-skolem! cex)))
            (dk-cite! 'closed-limit-in mv 'kk f l)
            (tsb-conv-transfer! f l)
            (mac 'converges)
            (ew l)
            (dk-close-if-asm!)))))
    (tqb-iff-bwd! 'is-complete ms)
    (tqb-iff-bwd! 'is-hilbert-space tsb-S)
    (dk-close-if-asm!)))
(tqb-qed! 'sub-cips-hilbert)

;;; ---- restrictions of operators leaving kk invariant ---------------------------------------
(define tsb-rt '(RESTRICT t_ kk))
(define tsb-inv '(FORALL tsbx_ (IMPLIES (IN tsbx_ kk) (IN (t_ tsbx_) kk))))
;;; typings (IN x (VEC S)) in context, rewritten to (IN x kk)
(define (tsb-to-kk! xs)
  (for-each (lambda (x)
              (if (not (dk-asm? (list 'IN x 'kk)))
                  (dk-rewrite-h! (list 'IN x (list 'VEC tsb-S)) (list 'VEC tsb-S) 'kk)))
            xs))
(define (tsb-ra! x) (tsb-kt! x) (subst (dk-cite! 'restrict-apply 't_ 'kk x)))
(define (tsb-vars-of lk) (map cadr (filter (lambda (h) (dk-head-is? h 'IN)) lk)))

(sp (make-wff (forall-guarded '(v kk t_) (append tsb-H (list '(IN t_ (BOUNDED-OPS v v)) tsb-inv))
  (list 'IN tsb-rt (list 'BOUNDED-OPS tsb-S tsb-S)))))
(dk-peel!)
(tsb-base!)
(dk-cite! 'sub-cips-is-cips 'v 'kk)
(dk-cite! 'sub-cips-vec 'v 'kk)
(dk-cite! 'bop-fun 'v 'v 't_)
(dk-have! (list 'IN tsb-rt (list 'FUN (list 'VEC tsb-S) (list 'VEC tsb-S)))
  (lambda ()
    (subst (list '= (list 'VEC tsb-S) 'kk))
    (mac 'RESTRICT)
    (for-each (lambda (k) (dk-focus! k) (tsb-type-leaf!)) (dk-opened (lambda () (lam-t))))))
(dk-have! (list 'IS-LINEAR-OP tsb-S tsb-S tsb-rt)
  (lambda ()
    (mac 'is-linear-op)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
            (let* ((lk (dk-peel!))
                   (xs (filter (lambda (x) (dk-asm? (list 'IN x (list 'VEC tsb-S)))) (tsb-vars-of lk))))
              (tsb-to-kk! xs)
              (for-each tsb-ra! xs)
              (tsb-rw!)
              (let* ((g (dk-goal)) (arg (cadr (cadr g))))
                (tsb-ra! arg)
                (for-each tsb-vv! xs)
                (if (equal? (car arg) '(VADD v))
                    (dk-cite! 'bop-add 'v 'v 't_ (cadr arg) (caddr arg))
                    (dk-cite! 'bop-act 'v 'v 't_ (cadr arg) (caddr arg)))
                (dk-close-if-asm!))))))))
(let ((m '(OPNORM v v t_)))
  (dk-cite! 'opnorm-in-rr 'v 'v 't_)
  (dk-cite! 'opnorm-nonneg 'v 'v 't_)
  (let ((ob (dk-cite! 'opnorm-bound 'v 'v 't_)))
    (dk-have! (list 'FORALL 'box_ (list 'IMPLIES (list 'IN 'box_ (list 'VEC tsb-S))
                (list '<= (list 'IP-NORM tsb-S (list tsb-rt 'box_)) (list '* m (list 'IP-NORM tsb-S 'box_)))))
      (lambda ()
        (let ((x (dk-di-var!)))
          (tsb-to-kk! (list x))
          (tsb-ra! x)
          (tsb-kt! (list 't_ x))
          (subst (dk-cite! 'sub-cips-norm 'v 'kk (list 't_ x)))
          (subst (dk-cite! 'sub-cips-norm 'v 'kk x))
          (tsb-vv! x)
          (dk-apply! ob x)
          (dk-close-if-asm!))))
    (dk-cite! 'bop-intro tsb-S tsb-S tsb-rt m)
    (dk-close-if-asm!)))
(tqb-qed! 'sub-cips-restrict-bounded)

(sp (make-wff (forall-guarded '(v kk t_) (append tsb-H (list '(IS-SELF-ADJOINT-OP v t_) tsb-inv))
  (list 'IS-SELF-ADJOINT-OP tsb-S tsb-rt))))
(dk-peel!)
(tsb-base!)
(dk-cite! 'sub-cips-is-cips 'v 'kk)
(dk-cite! 'sub-cips-vec 'v 'kk)
(tqb-iff-fwd! 'is-self-adjoint-op 'v 't_)
(dk-cite! 'sub-cips-restrict-bounded 'v 'kk 't_)
(let ((sa (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(IP v)) (dk-contains? h 't_))) "self-adjointness of t")))
  (dk-have! (list 'FORALL 'kqx_ (list 'IMPLIES (list 'IN 'kqx_ (list 'VEC tsb-S))
              (list 'FORALL 'kqy_ (list 'IMPLIES (list 'IN 'kqy_ (list 'VEC tsb-S))
                (list '= (list (tsb-acc 'IP) (list tsb-rt 'kqx_) 'kqy_) (list (tsb-acc 'IP) 'kqx_ (list tsb-rt 'kqy_)))))))
    (lambda ()
      (let* ((lk (dk-peel!)) (xs (tsb-vars-of lk)))
        (tsb-to-kk! xs)
        (for-each tsb-ra! xs)
        (tsb-rw!)
        (for-each tsb-vv! xs)
        (dk-apply! sa (car xs) (cadr xs))
        (dk-close-if-asm!))))
  (tqb-iff-bwd! 'is-self-adjoint-op tsb-S tsb-rt)
  (dk-close-if-asm!))
(tqb-qed! 'sub-cips-restrict-self-adjoint)

;;; compact: along the subsequence where t(f(phi n)) converges in v, the limit is in kk (closed)
(sp (make-wff (forall-guarded '(v kk t_) (append tsb-H (list '(IS-CLOSED (IP-METRIC-SPACE v) kk) '(IS-COMPACT-OP v v t_) tsb-inv))
  (list 'IS-COMPACT-OP tsb-S tsb-S tsb-rt))))
(dk-peel!)
(tsb-base!)
(tsb-metric-base!)
(dk-cite! 'compact-op-bounded 'v 'v 't_)
(dk-cite! 'bop-fun 'v 'v 't_)
(dk-cite! 'sub-cips-restrict-bounded 'v 'kk 't_)
(let* ((ms (tqb-M tsb-S)) (mv (tqb-M 'v)) (vs (list 'VEC tsb-S)))
  (dk-have! (list 'FORALL 'f (list 'IMPLIES (list 'IN 'f (list 'FUN 'NN vs)) (list 'IMPLIES (tqb-bound tsb-S 'f) (tqb-seqc tsb-S tsb-S tsb-rt 'f))))
    (lambda ()
      (let* ((lk (dk-peel!))
             (f (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (pair? (caddr x)) (eq? (car (caddr x)) 'FUN))) lk)))
             (bd (find-first (lambda (x) (dk-head-is? x 'FORALL)) lk)))
        (dk-rewrite-h! (list 'IN f (list 'FUN 'NN vs)) vs 'kk)
        (dk-cite! 'fun-codomain-superset f 'NN 'kk '(VEC v))
        (dk-have! (tqb-bound 'v f)
          (lambda ()
            (let ((m (dk-di-var!)))
              (dk-cite! 'fun-apply-type-c f 'NN 'kk m)
              (dk-cite! 'sub-cips-norm 'v 'kk (list f m))
              (subst (list '= (list 'IP-NORM 'v (list f m)) (list 'IP-NORM tsb-S (list f m))))
              (dk-apply! bd m)
              (dk-close-if-asm!))))
        (let* ((ex (dk-cite! 'compact-op-seq 'v 'v 't_ f))
               (phi (dk-skolem! ex))
               (ex2 (dk-pick (lambda (x) (and (dk-head-is? x 'FORSOME) (memq phi (free-vars x)))) "the limit"))
               (l (dk-skolem! ex2))
               (ucl (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (memq l (free-vars x)))) "the limit clause"))
               (xs (lambda (m) (list f (list phi m))))
               (xty! (lambda (m)
                       (dk-cite! 'fun-apply-type-c phi 'NN 'NN m)
                       (dk-cite! 'fun-apply-type-c f 'NN 'kk (list phi m))
                       (tsb-kt! (list 't_ (xs m)))))
               (valc (lambda (b) (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN) (list '= (list b 'nq_) (list 't_ (xs 'nq_))))))))
          (tqb-iff-fwd! 'strictly-mono-nn phi)
          ;; the limit lies in kk
          (let ((lamc (list 'VNB-LAMBDA 'tsbn_ 'NN (list 't_ (xs 'tsbn_)))))
            (dk-have! (list 'IN lamc '(FUN NN kk))
              (lambda ()
                (dk-lam-type!
                  (lambda () (let ((m (dk-di-var!))) (xty! m) (dk-close-if-asm!)))
                  (lambda () (fact 'nn-is-set) (dk-close-if-asm!)))))
            (dk-cite! 'fun-codomain-superset lamc 'NN 'kk '(VEC v))
            (dk-have! (valc lamc)
              (lambda ()
                (let ((m (dk-di-var!)))
                  (xty! m)
                  (if (not (dk-lam-b!)) (rfl)))))
            (dk-apply! ucl lamc)
            (dk-cite! 'closed-limit-in mv 'kk lamc l))
          (witness! phi
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (dk-asm? (dk-goal)) (ass)
                      (witness! l
                        (lambda ()
                          (let* ((lk5 (dk-peel!))
                                 (b (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (pair? (caddr x)) (eq? (car (caddr x)) 'FUN))) lk5)))
                                 (eqb (find-first (lambda (x) (dk-head-is? x 'FORALL)) lk5)))
                            (dk-rewrite-h! (list 'IN b (list 'FUN 'NN vs)) vs 'kk)
                            (dk-cite! 'fun-codomain-superset b 'NN 'kk '(VEC v))
                            (dk-have! (valc b)
                              (lambda ()
                                (let ((m (dk-di-var!)))
                                  (xty! m)
                                  (subst (dk-apply! eqb m))
                                  (tsb-ra! (xs m))
                                  (tqb-rfl-trivial!))))
                            (dk-apply! ucl b)
                            (tsb-conv-transfer! b l)
                            (dk-close-if-asm!)))))))))))))
  (dk-cite! 'compact-op-intro tsb-S tsb-S tsb-rt)
  (dk-close-if-asm!))
(tqb-qed! 'sub-cips-restrict-compact)

;;; ---- the orthocomplement ------------------------------------------------------------------
;;; a self-adjoint t leaving kk invariant leaves PERP(v, kk) invariant
(sp (make-wff (forall-guarded '(v kk t_)
  (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) '(SUBSET kk (VEC v)) '(IS-SELF-ADJOINT-OP v t_) tsb-inv)
  '(FORALL tsbx_ (IMPLIES (IN tsbx_ (PERP v kk)) (IN (t_ tsbx_) (PERP v kk)))))))
(dk-peel!)
(tqb-iff-fwd! 'is-self-adjoint-op 'v 't_)
(dk-cite! 'bop-fun 'v 'v 't_)
(let* ((z (cadr (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(PERP v kk)))) "the point of the perp")))
       (sa (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(IP v)) (dk-contains? h 't_))) "self-adjointness of t"))
       (inv (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(IN tsbx_ kk)))) "invariance")))
  (tqb-iff-fwd! 'perp-membership 'v 'kk z)
  (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) z)
  (dk-have! (list 'FORALL 'prk_ (list 'IMPLIES '(IN prk_ kk) (list '= (list '(IP v) (list 't_ z) 'prk_) 0)))
    (lambda ()
      (let ((k (dk-di-var!)))
        (dk-cite! 'subset-mem-fwd 'kk '(VEC v) k)
        (subst (dk-apply! sa z k))
        (dk-apply! inv k)
        (dk-cite! 'perp-orth 'v 'kk z (list 't_ k))
        (dk-close-if-asm!))))
  (tqb-iff-bwd! 'perp-membership 'v 'kk (list 't_ z))
  (dk-close-if-asm!))
(tqb-qed! 'sa-perp-invariant)

;;; ... so its restriction to PERP(v, kk) is self-adjoint there, and PERP(v, kk) is a Hilbert space
(define tsb-P '(PERP v kk))
(sp (make-wff (forall-guarded '(v kk t_)
  (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) '(SUBSET kk (VEC v)) '(IS-SELF-ADJOINT-OP v t_) tsb-inv)
  (list 'IS-SELF-ADJOINT-OP (list 'SUB-CIPS 'v tsb-P) (list 'RESTRICT 't_ tsb-P)))))
(dk-peel!)
(dk-cite! 'perp-is-submodule 'v 'kk)
(dk-cite! 'sa-perp-invariant 'v 'kk 't_)
(dk-cite! 'sub-cips-restrict-self-adjoint 'v tsb-P 't_)
(dk-close-if-asm!)
(tqb-qed! 'sub-cips-perp-self-adjoint)

(sp (make-wff (forall-guarded '(v kk) '((IS-HILBERT-SPACE v) (SUBSET kk (VEC v)))
  (list 'IS-HILBERT-SPACE (list 'SUB-CIPS 'v tsb-P)))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'perp-is-submodule 'v 'kk)
(dk-cite! 'perp-is-closed 'v 'kk)
(dk-cite! 'sub-cips-hilbert 'v tsb-P)
(dk-close-if-asm!)
(tqb-qed! 'sub-cips-perp-hilbert)


;;; ======== from b6-sq-eigen.scm
;;; ==========================================================================================
;;; (B6) THE LAST STEP OF THE CRUCIAL OBSERVATION (Teorema 3.1, step (b), its algebraic end):
;;; if T(T z) = m^2 z with z /= 0 and m real, then m or -m is an eigenvalue of T.  With w =
;;; T z + m z: if w = 0 then T z = -m z, else T w = m w.  Library: operator-algebras.  Prefix
;;; tsc- (file-local), tqb- (helpers).
;;; ==========================================================================================

;;; with x in VEC v, x /= 0, c in CC and T x = c x in context: land IS-EIGENVALUE(v, t_, c)
(define (tsc-eig! c x)
  (tqb-iff-bwd! 'eigenspace-membership 'v 't_ c x)
  (let ((iff (dk-cite! 'is-eigenvalue 'v 't_ c)))
    (dk-have! (caddr iff)
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal)) (ass)
                (witness! x (lambda () (dk-conj-close! dk-ass!))))))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))

(sp (make-wff (forall-guarded '(v t_ z_ m_)
  '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN t_ (BOUNDED-OPS v v)) (IN z_ (VEC v)) (NOT (= z_ (VZERO v)))
    (IN m_ RR) (= (t_ (t_ z_)) ((ACT v) (* m_ m_) z_)))
  '(FORSOME tscl_ (AND (IS-EIGENVALUE v t_ tscl_) (OR (= tscl_ m_) (= tscl_ (- m_))))))))
(dk-peel!)
(dk-cite! 'bop-fun 'v 'v 't_)
(dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) 'z_)
(fluid-let ((tqb-v 'v))
  (let* ((tz '(t_ z_))
         (mz '((ACT v) m_ z_))
         (w (list '(VADD v) tz mz)))
    (tqb-vt! w)
    (use-em (list '= w '(VZERO v))
      (lambda ()
        (tqb-ct! '(- m_))
        (let* ((nz '((ACT v) (- m_) z_))
               (rhs (list '(VADD v) w nz)))
          (tqb-vt! rhs)
          (let* ((e1 (tqb-vec-eq! tz rhs))
                 (e2 (dk-rewrite-h! e1 w '(VZERO v)))
                 (e3 (dk-cite! 'cips-vadd-vzero 'v nz))
                 (e4 (dk-rewrite-h! e2 (list '(VADD v) '(VZERO v) nz) nz)))
            (tsc-eig! '(- m_) 'z_)
            (witness! '(- m_)
              (lambda ()
                (dk-conj-close!
                  (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (oi-r) (rfl))))))))))
      (lambda ()
        (tqb-ct! 'm_)
        (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) w)
        (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) tz)
        (dk-have! (list '= (list 't_ w) (list '(ACT v) 'm_ w))
          (lambda ()
            (subst (dk-cite! 'bop-add 'v 'v 't_ tz mz))
            (subst (dk-cite! 'bop-act 'v 'v 't_ 'm_ 'z_))
            (subst '(= (t_ (t_ z_)) ((ACT v) (* m_ m_) z_)))
            (let ((g (dk-goal)))
              (tqb-vec-eq! (cadr g) (caddr g))
              (dk-close-if-asm!))))
        (tsc-eig! 'm_ w)
        (witness! 'm_
          (lambda ()
            (dk-conj-close!
              (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (oi-l) (rfl)))))))))))
(tqb-qed! 'sq-eigen-split)
