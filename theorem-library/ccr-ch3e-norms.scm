              (list '(IS-MODULE md) `(= (SCAL md) ,cn5-v) `(IN ,nu (FUN (VEC md) RR))
                    (cn5-nonneg-u nu) (cn5-iff-u nu) (cn5-tri-u nu) (cn5-hom-u nu)))))
