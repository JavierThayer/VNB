                                    (dk-cite! 'matadd-entry cn5-v 1 'n bkk dm 1 jj)
                                    (dk-cite! 'matadd-entry cn5-v 1 'n bv ms 1 jj)
                                    (dk-cite! 'matscale-entry cn5-v 1 'n m1 bkk 1 jj)
                                    (dk-cite! 'entry-in-carrier 1 'n '(CARR K) bv 1 jj)
                                    (dk-cite! 'entry-in-carrier 1 'n '(CARR K) bkk 1 jj)
                                    (subst `(= (ENTRY ,sm 1 ,jj) ((ADD ,cn5-v) ,kj (ENTRY ,dm 1 ,jj))))
                                    (subst `(= (ENTRY ,dm 1 ,jj) ((ADD ,cn5-v) ,bj (ENTRY ,ms 1 ,jj))))
                                    (subst `(= (ENTRY ,ms 1 ,jj) ((MUL ,cn5-v) ,m1 ,kj)))
                                    (for-each cn5-in-v! (list bj kj))
                                    (subst `(= (NEG K) (NEG ,cn5-v)))
                                    (subst `(= (ONE K) (ONE ,cn5-v)))
                                    (crs))))
                              (dk-cite! 'matrix-entry-extensionality 1 'n '(CARR K) sm bv)
                              (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-ass!))))
                          ;; LINCOMB(B) = LINCOMB(bk) + LINCOMB(D), and the estimate
                          (let* ((e6 (dk-cite! 'lincomb-row-add 'md 'n bkk dm 'u))
                                 (e7 (dk-rewrite-h! e6 '(SCAL md) cn5-v))
                                 (e8 (dk-rewrite-h! e7 sm bv)))
                            (dk-cite! 'lincomb-type 'md 'n dm 'u)
                            (cn5-nu! 'nu ld)
                            (dk-cite! 'module-vadd-type 'md lbk ld)
                            (cn5-nu! 'nu `((VADD md) ,lbk ,ld))
                            (dk-apply! (cn5-tri-u 'nu) lbk ld)
                            (dk-apply! upu dm dv)
                            (dk-apply! sc dv)
                            (dk-le-chain! `(nu ,ld) `(* ,cu ,dv) e2)
                            (dk-le-add! nlbk e2 `(nu ,ld) e2)
                            (subst `(= ,lb ((VADD md) ,lbk ,ld)))
                            (dk-le-chain! `(nu ((VADD md) ,lbk ,ld)) `(+ ,nlbk (nu ,ld)) `(+ ,e2 ,e2) ev)))))))))
            (dk-cite! 'rr-nonneg-below-all-zero `(nu ,lb))
            (dk-iff-fwd! (dk-apply! (cn5-iff-u 'nu) lb))
            ;; so B = 0 by REL-FREE
            (dk-project! relu (lambda () (mac-h 'rel-free '(REL-FREE md n u))))
            (let ((zer (dk-apply! relu bv)))
              ;; but the rows keep an entry of norm 1
              (dk-have! '(POS-RR 1/2) (lambda () (mac 'pos-rr) (dk-conj-close! (lambda () (arith)))))
              (let* ((nr (near! '1/2))
                     (cv (car nr))
                     (ig (dk-have! `(<= ,cv ,cv) (lambda () (dk-nn!))))
                     (clk (dk-apply! (cdr nr) cv))
                     (cls (at-phi! cv))
                     (bkk (bk cv))
                     (jx (dk-skolem! (list-ref cls 2) #t))
                     (ig2 (dk-split-all!))
                     (x `(ENTRY ,bkk 1 ,jx))
                     (eqn `(= ,(cn5-n x) 1))
                     (wc (cn5-close-parts! bkk bv 1 'n '1/2))
                     (h0 (dk-apply! wc 1 jx)))
                (dk-apply! zer jx)
                (let* ((h1 (dk-rewrite-h! h0 `(ENTRY ,bv 1 ,jx) '(ZERO (SCAL md))))
                       (h2 (dk-rewrite-h! h1 '(SCAL md) cn5-v))
                       (h3 (dk-rewrite-h! h2 `(ZERO ,cn5-v) '(ZERO K))))
                  (dk-cite! 'entry-in-carrier 1 'n '(CARR K) bkk 1 jx)
                  (dk-cite! 'nf-zero-in-carr 'K)
                  (cn5-crs! `(= ,(cn5-sub x '(ZERO K)) ,x) (list x))
                  (let ((h4 (dk-rewrite-h! h3 (cn5-sub x '(ZERO K)) x)))
                    (cn5-real! (cn5-n x))
                    (dk-absurd! h4 eqn `(IN ,(cn5-n x) RR))))))))))))
(cn5-qed! 'ccr-3-8-lower)

;;; 5. DOMINATION.  Two norms and a basis: nu2 <= C nu1 with C = C2 c1 + 1 > 0 (C2 the upper constant of
;;;    nu2, c1 the lower constant of nu1; the + 1 makes C positive when n = 0).

(define (cn5-two-norms body)
  `(FORALL md (FORALL nu1 (FORALL nu2 (IMPLIES (IS-NORM-ON K md nu1) (IMPLIES (IS-NORM-ON K md nu2)
     (FORALL n (IMPLIES (IN n NN) (FORALL u (IMPLIES (IN u (MAT n 1 (VEC md)))
       (IMPLIES (GENERATES md n u) (IMPLIES (REL-FREE md n u) ,body))))))))))))
(define (cn5-head! . nus)
  (dk-peel!)
  (dk-project! '(IS-NV-FIELD K) (lambda () (mac-h 'is-local-nv-field '(IS-LOCAL-NV-FIELD K))))
  (dk-cite! 'nv-field-normed 'K)
  (cn5-view!)
  (for-each cn5-norm-parts! nus))

(sp (make-wff `(FORALL K (IMPLIES (IS-LOCAL-NV-FIELD K) ,(cn5-two-norms
  '(FORSOME cnk (AND (IN cnk RR) (AND (< 0 cnk)
     (FORALL cnx (IMPLIES (IN cnx (VEC md)) (<= (nu2 cnx) (* cnk (nu1 cnx)))))))))))))
(cn5-head! 'nu1 'nu2)
(let* ((ex2 (dk-cite! 'ccr-3-8-upper 'K 'md 'nu2 'n 'u))
       (c2 (dk-skolem! ex2 #t)) (ig (dk-split-all!))
       (u2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f c2) (dk-contains? f 'LINCOMB))) "the upper bound of nu2"))
       (ex1 (dk-cite! 'ccr-3-8-lower 'K 'md 'nu1 'n 'u))
       (c1 (dk-skolem! ex1 #t)) (ig1 (dk-split-all!))
       (l1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f c1) (dk-contains? f 'LINCOMB))) "the lower bound of nu1"))
       (cc `(* ,c2 ,c1))
       (ck `(+ ,cc 1))
       (genu `(FORALL x_ (IMPLIES (IN x_ (VEC md))
                (FORSOME c_ (AND (IN c_ ,(cn5-mats 1 'n)) (= x_ (LINCOMB md n c_ u))))))))
  (dk-project! genu (lambda () (mac-h 'generates '(GENERATES md n u))))
  (dk-real! cc)
  (cn5-nonneg-prod! c2 c1)
  (dk-real! ck)
  (ew ck)
  (dk-conj-close!
    (lambda ()
      (cond
        ((dk-asm? (dk-goal)) (dk-ass!))
        ((dk-head-is? (dk-goal) '<) (dk-ineq! `(<= 0 ,cc) `(IN ,cc RR)))
        (#t
         (let* ((l (dk-peel!))
                (xv (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) l)))
                (ex (dk-apply! genu xv))
                (av (dk-skolem! ex #t))
                (ig2 (dk-split-all!))
                (lc `(LINCOMB md n ,av u))
                (n1 `(nu1 ,xv))
                (mv `(* ,c1 ,n1)))
           (cn5-to-k! av 1 'n)
           (cn5-nu! 'nu1 xv) (cn5-nu! 'nu2 xv)
           (dk-real! mv)
           (cn5-nonneg-prod! c1 n1)
           (cn5-row-bound! av 'n mv
             (lambda (jj)
               (let ((h (dk-apply! l1 av jj)))
                 (dk-rewrite-h! h lc xv)
                 (dk-ass!))))
           (let* ((h2 (dk-apply! u2 av mv))
                  (h3 (dk-rewrite-h! h2 lc xv)))
             (dk-have! `(= (* ,c2 ,mv) (* ,cc ,n1)) (lambda () (crs)))
             (dk-have! `(<= ,cc ,ck) (lambda () (dk-ineq! `(IN ,cc RR))))
             (dk-cite! 'rr-mul-le-right cc ck n1)
             (dk-le-chain! `(nu2 ,xv) `(* ,c2 ,mv) `(* ,cc ,n1) `(* ,ck ,n1)))))))))
(cn5-qed! 'ccr-3-8-dominate)

;;; 6. PROPOSITION 3.8 with a given basis: c nu1(x) <= nu2(x) <= C nu1(x), 0 < c, C (c = 1/D for D the
;;;    domination constant of nu1 by nu2).

(define cn5-38-body
  '(FORSOME cnl (AND (IN cnl RR) (AND (< 0 cnl)
     (FORSOME cnu (AND (IN cnu RR) (AND (< 0 cnu)
       (FORALL cnx (IMPLIES (IN cnx (VEC md))
         (AND (<= (* cnl (nu1 cnx)) (nu2 cnx)) (<= (nu2 cnx) (* cnu (nu1 cnx)))))))))))))

(sp (make-wff `(FORALL K (IMPLIES (IS-LOCAL-NV-FIELD K) ,(cn5-two-norms cn5-38-body)))))
(cn5-head! 'nu1 'nu2)
(let* ((ea (dk-cite! 'ccr-3-8-dominate 'K 'md 'nu1 'nu2 'n 'u))
       (ca (dk-skolem! ea #t)) (ig (dk-split-all!))
       (da (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ca))) "nu2 <= C nu1"))
       (eb (dk-cite! 'ccr-3-8-dominate 'K 'md 'nu2 'nu1 'n 'u))
       (cb (dk-skolem! eb #t)) (ig2 (dk-split-all!))
       (db (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f cb))) "nu1 <= D nu2"))
       (rc `(recip ,cb)))
  (dk-cite! 'rr-pos-ne-zero cb)
  (dk-have! `(AND (IN ,cb RR) (NOT (= ,cb 0))) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
  (dk-cite! 'rr-recip-closed cb)
  (dk-cite! 'rr-recip-pos cb)
  (dk-have! `(<= 0 ,rc) (lambda () (dk-ineq! `(< 0 ,rc) `(IN ,rc RR))))
  (ew rc)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (dk-ass!)
          (begin
            (ew ca)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (dk-ass!)
                    (let* ((tl (dk-landed-1 (lambda () (di))))
                           (xv (cadr tl))
                           (n1 `(nu1 ,xv)) (n2 `(nu2 ,xv)))
                      (cn5-nu! 'nu1 xv) (cn5-nu! 'nu2 xv)
                      (dk-apply! da xv)
                      (dk-apply! db xv)
                      (dk-have! `(= (* ,cb ,n2) (* ,n2 ,cb)) (lambda () (crs)))
                      (dk-le-chain! n1 `(* ,cb ,n2) `(* ,n2 ,cb))
                      (dk-real! `(* ,n2 ,cb))
                      (dk-cite! 'rr-mul-le-right n1 `(* ,n2 ,cb) rc)
                      (dk-cite! 'rr-mul-recip-cancel n2 cb)
                      (dk-have! `(AND (IN ,rc RR) (IN ,n1 RR)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                      (dk-cite! 'rr-mul-comm rc n1)
                      (dk-have! `(<= (* ,rc ,n1) ,n2)
                        (lambda () (dk-le-chain! `(* ,rc ,n1) `(* ,n1 ,rc) `(* (* ,n2 ,cb) ,rc) n2)))
                      (dk-conj-close! (lambda () (dk-ass!))))))))))))
(cn5-qed! 'ccr-3-8-basis)

;;; 7. PROPOSITION 3.8: all norms on a finite-dimensional vector space over K are equivalent -- E has
;;;    SOME finite basis (n, u).

(sp (make-wff `(FORALL K (IMPLIES (IS-LOCAL-NV-FIELD K)
  (FORALL md (FORALL nu1 (FORALL nu2 (IMPLIES (IS-NORM-ON K md nu1) (IMPLIES (IS-NORM-ON K md nu2)
    (IMPLIES (FORSOME n (AND (IN n NN) (FORSOME u (AND (IN u (MAT n 1 (VEC md)))
                (AND (GENERATES md n u) (REL-FREE md n u))))))
      ,cn5-38-body))))))))))
(dk-peel!)
(let* ((ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'GENERATES))) "the basis"))
       (nv (dk-skolem! ex #t))
       (ig (dk-split-all!))
       (ex2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'GENERATES))) "the column"))
       (uv (dk-skolem! ex2 #t))
       (ig2 (dk-split-all!)))
  (dk-cite! 'ccr-3-8-basis 'K 'md 'nu1 'nu2 nv uv)
  (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-ass!)))
(cn5-qed! 'ccr-3-8)
