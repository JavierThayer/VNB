      (dk-have! `(<= (* (nu ,lb) ,c) 1)
        (lambda () (dk-le-chain! `(* (nu ,lb) ,c) `(* ,cnu ,ny) `(* ,nb ,ny) `(* ,ny ,nb) 1)))
      ;; the entry of norm 1
      (dk-cite! 'matscale-entry cn5-v 1 'n yv av 1 j0)
