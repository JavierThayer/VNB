                      (if (not (dk-lam-b!))
                          (in-sep! (lambda () (dk-conj-close! (lambda () (dk-ass!))))))))))))
        (let* ((chx (dk-cite! 'rmm-nn-choice (cn5-mat 1 'n) cn5-fam))
               (gv (dk-skolem! chx #t))
               (ig0 (dk-split-all!))
