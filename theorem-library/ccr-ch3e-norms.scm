(dk-cite! 'nn-in-rr '(+ cnk 1))
(dk-have! '(<= 0 (+ cnk 1)) (lambda () (dk-nn!)))
(dk-have! '(<= 1 1) (lambda () (dk-nn!)))
(dk-cite! 'interval-mem-intro 1 1 1)
(let* ((c '(+ cnk 1))
       (ex (dk-apply! cn5-H c))
       (av (dk-skolem! ex #t)) (ig1 (dk-split-all!))
       (ex2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f av))) "j"))
       (jv (dk-skolem! ex2 #t)) (ig2 (dk-split-all!))
       (x `(LINCOMB md n ,av u))
       (nx `(nu ,x))
       (aj `(ENTRY ,av 1 ,jv))
       (naj (cn5-n aj))
       (cnu `(* ,c ,nx)))
  (cn5-to-s! av 1 'n)
  (dk-cite! 'lincomb-type 'md 'n av 'u)
  (cn5-nu! 'nu x)
  (dk-cite! 'entry-in-carrier 1 'n '(CARR K) av 1 jv)
  (cn5-real! naj)
  (dk-real! cnu)
  (cn5-nonneg-prod! c nx)
  (dk-cite! 'rr-not-le-lt naj cnu)
  (dk-cite! 'interval-lo 1 'n jv) (dk-cite! 'interval-hi 1 'n jv) (dk-cite! 'interval-elt-in-nn 1 'n jv)
  (dk-have! '(<= 1 n) (lambda () (dk-nn! `(<= 1 ,jv) `(<= ,jv n) `(IN ,jv NN) '(IN n NN))))
  (let* ((exm (dk-cite! 'cn5-row-argmax 'K 'n av))
         (j0 (dk-skolem! exm #t)) (ig3 (dk-split-all!))
         (mx (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f j0) (dk-contains? f av))) "the max"))
         (beta `(ENTRY ,av 1 ,j0))
         (nb (cn5-n beta)))
    (dk-cite! 'entry-in-carrier 1 'n '(CARR K) av 1 j0)
    (cn5-real! nb)
    (dk-apply! mx jv)
    (dk-have! `(< ,cnu ,nb) (lambda () (dk-ineq! `(< ,cnu ,naj) `(<= ,naj ,nb) `(IN ,cnu RR) `(IN ,naj RR) `(IN ,nb RR))))
    (dk-have! `(<= ,cnu ,nb) (lambda () (dk-ineq! `(< ,cnu ,nb) `(IN ,cnu RR) `(IN ,nb RR))))
    ;; beta /= 0
    (dk-cite! 'nf-norm-of-zero 'K)
    (dk-have! `(NOT (= ,beta (ZERO K)))
      (lambda ()
        (di)
        (let* ((h1 (dk-rewrite-h! `(< ,cnu ,nb) beta '(ZERO K)))
