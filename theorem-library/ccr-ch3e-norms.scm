;;; 3. THE STEP.  If no c works in the lower bound -- for every real c >= 0 some row a and index j
;;;    have |a_j| > c nu(LINCOMB(a, u)) -- then for every k there is a row y with ||y||_max <= 1,
;;;    nu(LINCOMB(y, u)) (k + 1) <= 1 and an entry of norm 1.

(define (cn5-Q c)
  `(FORSOME cna (AND (IN cna ,(cn5-mat 1 'n))
     (FORSOME cnj (AND (IN cnj (INTERVAL 1 n))
       (NOT (<= ,(cn5-n '(ENTRY cna 1 cnj)) (* ,c (nu (LINCOMB md n cna u))))))))))
(define cn5-H `(FORALL cnc (IMPLIES (IN cnc RR) (IMPLIES (<= 0 cnc) ,(cn5-Q 'cnc)))))
(define (cn5-good kk y)
  `(AND (IS-MAT-BOUND K 1 n ,y 1)
   (AND (<= (* (nu (LINCOMB md n ,y u)) (+ ,kk 1)) 1)
        (FORSOME cn5j_ (AND (IN cn5j_ (INTERVAL 1 n)) (= ,(cn5-n `(ENTRY ,y 1 cn5j_)) 1))))))
(define (cn5-norm-head body)
  `(FORALL md (FORALL nu (IMPLIES (IS-NORM-ON K md nu)
     (FORALL n (IMPLIES (IN n NN) (FORALL u (IMPLIES (IN u (MAT n 1 (VEC md))) ,body))))))))

(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) ,(cn5-norm-head
  `(IMPLIES ,cn5-H (FORALL cnk (IMPLIES (IN cnk NN)
     (FORSOME cnY (AND (IN cnY ,(cn5-mat 1 'n)) ,(cn5-good 'cnk 'cnY)))))))))))
