;; the clauses of IS-NORM-ON(K, md, nu), with the binders of the definition
(define (cn5-nonneg-u nu) `(FORALL zkvx_ (IMPLIES (IN zkvx_ (VEC md)) (<= 0 (,nu zkvx_)))))
(define (cn5-iff-u nu) `(FORALL zkvx_ (IMPLIES (IN zkvx_ (VEC md)) (IFF (= (,nu zkvx_) 0) (= zkvx_ (VZERO md))))))
(define (cn5-tri-u nu)
  `(FORALL zkvx_ (IMPLIES (IN zkvx_ (VEC md)) (FORALL zkvy_ (IMPLIES (IN zkvy_ (VEC md))
     (<= (,nu ((VADD md) zkvx_ zkvy_)) (+ (,nu zkvx_) (,nu zkvy_))))))))
(define (cn5-hom-u nu)
  `(FORALL zkvr_ (IMPLIES (IN zkvr_ (CARR K)) (FORALL zkvx_ (IMPLIES (IN zkvx_ (VEC md))
     (= (,nu ((ACT md) zkvr_ zkvx_)) (* ((FNRM K) zkvr_) (,nu zkvx_))))))))
