                                              (begin (ew jv) (dk-conj-close! (lambda () (dk-ass!)))))))))
                                  (ai `(NOT ,q))))))))))
                (ai notg))))))
      (let* ((stp (dk-cite! 'cn5-step 'K 'md 'nu 'n 'u))
             (ante `(FORALL cn5q_ (IMPLIES (IN cn5q_ NN)
                      (FORSOME cn5w_ (AND (IN cn5w_ ,(cn5-mat 1 'n)) (IN cn5w_ (,cn5-fam cn5q_))))))))
        (dk-have! ante
          (lambda ()
            (let* ((landed (dk-peel!)) (qv (cadr (car landed)))
                   (ex (dk-apply! stp qv))
                   (yv (dk-skolem! ex #t)))
