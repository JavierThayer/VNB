             (e3 (begin (dk-cite! 'nf-norm-one 'K) (dk-rewrite-h! e2 (cn5-n '(ONE K)) 1))))
        (dk-have! `(= (* ,ny ,nb) (* ,nb ,ny)) (lambda () (crs)))
        (dk-have! `(= (* ,ny ,nb) 1) (lambda () (subst `(= (* ,ny ,nb) (* ,nb ,ny))) (subst `(= (* ,nb ,ny) 1)) (rfl))))
      ;; ||a|| <= |beta|, so ||b|| <= 1
      (cn5-row-bound! av 'n nb (lambda (jj) (dk-apply! mx jj) (dk-ass!)))
      (dk-have! `(<= (* ,ny ,nb) 1) (lambda () (subst `(= (* ,ny ,nb) 1)) (dk-ineq!)))
      (dk-cite! 'rr-one-in)
      (cn5-in-v! yv)
