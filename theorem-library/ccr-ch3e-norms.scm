      (dk-cite! 'matscale-type cn5-v 1 'n yv av)
      (cn5-to-k! b 1 'n)
      (dk-cite! 'cd8-scale-bound 'K 1 'n yv av nb 1)
      ;; LINCOMB(b) = y . LINCOMB(a), so nu(LINCOMB b) = |y| nu(x)
      (cn5-in-s! yv)
      (let* ((e4 (dk-cite! 'lincomb-row-scale 'md 'n yv av 'u))
