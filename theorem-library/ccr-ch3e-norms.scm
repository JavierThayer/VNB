(cn5-qed! 'cn5-step)

;;; 4. THE LOWER BOUND.  K a local NV field and u relation free: some c >= 0 has |a_j| <= c nu(LINCOMB(a, u))
;;;    for every row a and every j.  The notes' compactness argument, on the max-norm unit ball of rows.

(define cn5-G
  `(FORSOME cnc (AND (IN cnc RR) (AND (<= 0 cnc)
     (FORALL cna (IMPLIES (IN cna ,(cn5-mat 1 'n)) (FORALL cnj (IMPLIES (IN cnj (INTERVAL 1 n))
       (<= ,(cn5-n '(ENTRY cna 1 cnj)) (* cnc (nu (LINCOMB md n cna u))))))))))))
(define cn5-fam `(VNB-LAMBDA cn5k_ NN (SEP cn5y_ ,(cn5-mat 1 'n) ,(cn5-good 'cn5k_ 'cn5y_))))

;; with the choice universal CHV (forall k in NN. g(k) in fam(k)) and kv typed in NN: land g(kv) in MAT and
;; the three clauses of good(kv, g(kv)); return the clause list (a clause equal to the focus goal last)
(define (cn5-good-at! gv chv kv)
  (let* ((gk `(,gv ,kv))
         (mem (dk-apply! chv kv))
         (mem2 `(IN ,gk (SEP cn5y_ ,(cn5-mat 1 'n) ,(cn5-good kv 'cn5y_))))
         (gd (cn5-good kv gk)))
    (cn5-app-type! gv 'NN (cn5-mat 1 'n) kv)
    (if (not (dk-asm? gd))
        (begin
          (if (not (dk-asm? mem2)) (dk-lam-b-h! mem))
          (if (not (dk-asm? mem2)) (error "cn5-good-at!: no SEP membership" (expression->string mem2)))
          (dk-project! gd (lambda () (sep-me mem2)))))
    (let* ((gdc (or (dk-ctx-form gd) (error "cn5-good-at!: clauses not in context" (expression->string gd))))
           (c1 (cadr gdc)) (r1 (caddr gdc)) (c2 (cadr r1)) (c3 (caddr r1)))
      (let* ((g0 (dk-goal)) (cs (list c1 c2 c3))
             (isg (lambda (f) (alpha-equiv? f g0))))
        (for-each (lambda (f) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-only! gdc) (dk-split! gdc) (dk-ass!)))))
                  (append (filter (lambda (f) (not (isg f))) cs) (filter isg cs))))
      (list c1 c2 c3))))

(sp (make-wff `(FORALL K (IMPLIES (IS-LOCAL-NV-FIELD K) ,(cn5-norm-head `(IMPLIES (REL-FREE md n u) ,cn5-G))))))
