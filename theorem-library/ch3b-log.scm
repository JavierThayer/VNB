;;; ch3b-log.scm -- complex-analysis.pdf: logarithms and n-th roots of a nonvanishing
;;; holomorphic function on a CONVEX open set (the convex forms of Prop 3.22 and Cor 3.25),
;;; and Lemma 6.19 (a nowhere-zero entire function is an exponential).  Agent ISOM (brief
;;; CH3-B), 2026-10-26.
;;;
;;;   zero-deriv-connected-constant   zero derivative on a connected set => constant
;;;   holomorphic-log-convex          (3.22 on convex U) f holomorphic, nonvanishing on a
;;;                                   convex U  ==>  f = exp g, g holomorphic; any other such
;;;                                   h has g = h + 2 pi i n
;;;   ... (see the section headers)
;;;
;;; Existence (3.22): G a primitive of f'/f (cauchy-convex-primitive), then
;;; K = exp(-G) f has derivative exp(-G)(f' - (f'/f) f) = 0, so K is a constant c /= 0
;;; (zero-deriv-connected-constant); c = exp(w), and g = G + w.
;;;
;;; WINDOW.  Citations: ch3b-const.scm (exp-equal-diff-2-pi-i), cauchy-convex-primitive,
;;; holomorphic-deriv-holomorphic, deriv-on-of-is-diff-on, holomorphic-on-diff, dk-diff!'s
;;; laws (diff-on-*, cc-exp-deriv), alg-zero-deriv-ball, connected-locally-constant,
;;; cc-convex-connected (scratchpad/camontel/ca-connected.scm, UNWIRED), cc-exp-*.
;;; lo = after ch3b-const.scm; hi = none.  Library: complex-analysis.
;;;
;;; Helper prefix: c3l-.

(define (c3l-head g) (and (pair? g) (car g)))
(define c3l-NF '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (c3l-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass))))))
    f))
(define (c3l-cc! t)
  (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))))

;;; =====================================================================
;;; zero-deriv-connected-constant
;;; =====================================================================
(sp (make-wff '(FORALL u (FORALL f (IMPLIES (IS-CONNECTED CC-MS u)
     (IMPLIES (IN f (FUN u CC))
       (IMPLIES (FORALL z (IMPLIES (IN z u) (IS-DIFF-ON CC-NORMED-FIELD u f z 0)))
         (FORALL p (IMPLIES (IN p u) (FORALL q (IMPLIES (IN q u) (= (f p) (f q)))))))))))))
(dk-peel!)
(define c3l-D0 (dk-pick (lambda (h) (and (eq? (c3l-head h) 'FORALL) (dk-contains? h 'IS-DIFF-ON))) "zero derivative"))
(fact 'cc-is-metric-space)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(define c3l-inst (dk-cite! 'connected-locally-constant 'CC-MS 'u 'f))
(dk-have! (cadr c3l-inst)
  (lambda ()
    (let* ((x (dk-di-var!))
           (dx (dk-apply! c3l-D0 x)))
      (fact 'diff-on-open 'CC-NORMED-FIELD 'u 'f x 0)
      (dk-split-all! (list (dk-cite! 'cc-ms-open-iff 'u)))
      (let* ((iff (dk-ctx-form (list 'IFF (list 'IS-OPEN c3l-NF 'u) '(IS-OPEN CC-MS u)))))
        (dk-have! '(IS-OPEN CC-MS u) (lambda () (prop))))
      (dk-split-all! (dk-landed (lambda () (dk-project! '(FORALL y (IMPLIES (IN y u) (FORSOME r (AND (POS-RR r) (SUBSET (BALL CC-MS y r) u)))))
                                                          'is-open '(IS-OPEN CC-MS u)))))
      (let* ((ocl (dk-pick (lambda (h) (and (eq? (c3l-head h) 'FORALL) (dk-contains? h 'BALL))) "the openness clause"))
             (r (dk-skolem! (dk-apply! ocl x)))
             (B (list 'BALL 'CC-MS x r))
             (h (list 'RESTRICT 'f B)))
        (fact 'rr-pos-rr-in-rr r)
        (fact 'rr-lt-of-pos-rr r)
        (dk-project! '(SUBSET u (PTS CC-MS)) 'is-open '(IS-OPEN CC-MS u))
        (dk-have! '(SUBSET u CC) (lambda () (subst '(== CC (PTS CC-MS))) (ass)))
        (fact 'subset-mem-fwd 'u 'CC x)
        (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
        (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r) (list 'IN r 'RR))))
        (dk-have! (list 'NOT (list '= 0 r)) (lambda () (di) (dk-absurd! (list '= 0 r) (list '< 0 r))))
        (c3l-and! (list 'IN r 'RR) (c3l-and! (list '<= 0 r) (list 'NOT (list '= 0 r))))
        (fact 'ball-is-open 'CC-MS x r)
        (dk-split-all! (list (dk-cite! 'cc-ms-open-iff B)))
        (dk-have! (list 'IS-OPEN c3l-NF B) (lambda () (prop)))
        (fact 'restrict-in-fun 'f 'u 'CC B)
        (dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES (list 'IN 'hbz_ B) (list 'IS-DIFF-ON 'CC-NORMED-FIELD B h 'hbz_ 0)))
          (lambda ()
            (let ((y (dk-di-var!)))
              (fact 'subset-mem-fwd B 'u y)
              (dk-apply! c3l-D0 y)
              (dk-close-if! (lambda () (fact 'diff-on-shrink 'CC-NORMED-FIELD 'u 'f y 0 B)) ass))))
        (let ((cz (dk-cite! 'alg-zero-deriv-ball x r h)))
          (ew r)
          (dk-conj-close!
           (lambda ()
             (if (not (eq? (c3l-head (dk-goal)) 'FORALL))
                 (ass)
                 (let* ((pl (dk-peel!))
                        (y (cadr (car (filter (lambda (q) (and (eq? (c3l-head q) 'IN) (eq? (caddr q) 'u))) pl)))))
                   (fact 'cc-ms-ball-centre x r)
                   (dk-apply! cz y)
                   (fact 'restrict-apply 'f B y)
                   (fact 'restrict-apply 'f B x)
                   (fact 'fun-apply-type-c 'f 'u 'CC y)
                   (fact 'fun-apply-type-c 'f 'u 'CC x)
                   (subst (list '== (list 'f y) (list h y)))
                   (subst (list '== (list 'f x) (list h x)))
                   (ass))))))))))
(define c3l-all (dk-apply! c3l-inst))
(dk-close-if! (lambda () (inst*! c3l-all 'p 'q)) ass)
(qed 'zero-deriv-connected-constant)
(topic! 'zero-deriv-connected-constant 'analysis)
(alias! 'zero-deriv-connected-constant "a function with zero derivative on a connected open set is constant")

;;; =====================================================================
;;; holomorphic-log-convex-exists (3.22 on a convex set, existence)
;;; =====================================================================
(define c3l-hyp-nz '(FORALL z (IMPLIES (IN z u) (NOT (= (f z) 0)))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(IS-CONVEX-CC u)
     (list 'IMPLIES '(HOLOMORPHIC-ON u f)
       (list 'IMPLIES c3l-hyp-nz
         '(FORSOME g (AND (HOLOMORPHIC-ON u g)
             (FORALL z (IMPLIES (IN z u) (= (CC-EXP (g z)) (f z)))))))))))))
(dk-peel!)
(define c3l-nz (dk-pick (lambda (h) (and (eq? (c3l-head h) 'FORALL) (dk-contains? h 'NOT))) "f nonvanishing"))
(fact 'holomorphic-on-in-fun 'u 'f)
(fact 'holomorphic-on-open 'u 'f)
(dk-project! '(SUBSET u CC) 'is-convex-cc '(IS-CONVEX-CC u))
(fact 'cc-convex-connected 'u)
(fact 'cc-nf-small-elements)
(fact 'cc-is-normed-field)
(define (c3l-fz! z)                   ; z in u: z in CC, f z in CC, f z /= 0, recip(f z) in CC
  (fact 'subset-mem-fwd 'u 'CC z)
  (fact 'fun-apply-type-c 'f 'u 'CC z)
  (dk-apply! c3l-nz z)
  (c3l-and! (list 'IN (list 'f z) 'CC) (list 'NOT (list '= (list 'f z) 0)))
  (fact 'cc-recip-closed (list 'f z)))
(use-em '(FORSOME c3lw_ (IN c3lw_ u))
 (lambda ()
   (let* ((z0 (dk-skolem! (dk-pick (lambda (h) (and (eq? (c3l-head h) 'FORSOME) (dk-contains? h 'c3lw_))) "a point")))
          (FD '(VNB-LAMBDA cifdw_ u (DERIV-ON CC-NORMED-FIELD u f cifdw_))))
     (fact 'holomorphic-deriv-holomorphic 'u 'f)
     (fact 'holomorphic-on-in-fun 'u FD)
     (let* ((fdv (dk-name! FD '(FUN u CC)))
            (Q (list 'VNB-LAMBDA 'c3lz_ 'u (list '* (list fdv 'c3lz_) (list 'recip '(f c3lz_))))))
       (dk-have! (list 'HOLOMORPHIC-ON 'u fdv) (lambda () (subst (list '= fdv FD)) (ass)))
       (dk-have! (list 'HOLOMORPHIC-ON 'u Q) (lambda () (dk-holomorphic! 'u Q)))
       (let* ((Gp (dk-skolem! (dk-apply! (dk-cite! 'cauchy-convex-primitive 'u Q) z0)))
              (Gcl (dk-pick (lambda (h) (and (eq? (c3l-head h) 'FORALL) (dk-contains? h Gp) (dk-contains? h 'IS-DIFF-ON)))
                            "the primitive clause"))
              (Kf (list 'VNB-LAMBDA 'c3lz_ 'u (list '* (list 'CC-EXP (list '- (list Gp 'c3lz_))) '(f c3lz_)))))
         (fact 'holomorphic-on-in-fun 'u Gp)
         ;; Kf has derivative 0 at every point
         (dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list 'IS-DIFF-ON 'CC-NORMED-FIELD 'u Kf 'z 0)))
           (lambda ()
             (let* ((z (dk-di-var!)))
               (c3l-fz! z)
               (fact 'fun-apply-type-c Gp 'u 'CC z)
               (fact 'fun-apply-type-c fdv 'u 'CC z)
               (dk-lam-b-h! (dk-apply! Gcl z))
               (let* ((lf (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff 'u 'f) z)))
                      (dv (dk-cite! 'deriv-on-of-is-diff-on 'CC-NORMED-FIELD)))
                 (dk-apply! dv 'u 'f z lf)
                 (dk-have! (list '= (list fdv z) lf)
                   (lambda ()
                     (subst (list '= fdv FD))
                     (dk-lam-b!)
                     (ass)))
                 (let* ((res (dk-diff! 'u Kf z))
                        (Lstar (list-ref res 5)))
                   (dk-have! (list '= Lstar 0)
                     (lambda ()
                       (let* ((Gz (list Gp z)) (fz (list 'f z)) (E (list 'CC-EXP (list '- Gz))))
                         (subst (list '= (list fdv z) lf))
                         ;; exp(c * Gp z) for the constant c the laws wrote: the same as exp(-G z)
                         (let walk ((t (dk-goal)))
                           (if (pair? t)
                               (if (and (eq? (car t) 'CC-EXP) (pair? (cdr t)) (not (equal? (cadr t) (list '- Gz))))
                                   (let ((x (cadr t)))
                                     (c3l-cc! x)
                                     (dk-have! (list '= x (list '- Gz)) (lambda () (crs)))
                                     (subst (list '= x (list '- Gz))))
                                   (for-each walk t))))
                         (fact 'cc-recip-inverse fz)
                         (let ((r (dk-name! (list 'recip fz) 'CC)))
                           (subst (list '= (list 'recip fz) r))
                           (dk-have! (list '= (list '* fz r) 1)
                             (lambda () (subst (list '= r (list 'recip fz))) (ass)))
                           (c3l-cc! (list '- Gz))
                           (fact 'cc-exp-converges (list '- Gz))
                           (dk-split-all!)
                           (fact 'diff-on-deriv-in-carr 'CC-NORMED-FIELD 'u 'f z lf)
                           (dk-have! (list 'IN lf 'CC) (lambda () (subst (list '== 'CC '(CARR CC-NORMED-FIELD))) (ass)))
                           (let ((g (dk-goal)))
                             (dk-have! (list '= (cadr g) (list '* (list '* E lf) (list '- 1 (list '* fz r)))) (lambda () (crs)))
                             (subst (list '= (cadr g) (list '* (list '* E lf) (list '- 1 (list '* fz r)))))
                             (subst (list '= (list '* fz r) 1))
                             (crs))))))
                   (dk-rewrite-h! res Lstar 0)
                   (ass))))))
         ;; Kf is constant: Kf(z) = Kf(z0) = c, and c /= 0
         (let* ((Dcl (dk-pick (lambda (h) (and (eq? (c3l-head h) 'FORALL) (dk-contains? h Kf) (dk-contains? h 'IS-DIFF-ON)))
                              "Kf' = 0"))
                (_0 (c3l-fz! z0))
                (_1 (fact 'fun-apply-type-c Gp 'u 'CC z0))
                (d0 (dk-apply! Dcl z0)))
           (fact 'diff-on-in-fun 'CC-NORMED-FIELD 'u Kf z0 0)
           (fact 'cc-nf-carr)
           (dk-have! (list 'IN Kf '(FUN u CC)) (lambda () (subst (list '== 'CC '(CARR CC-NORMED-FIELD))) (ass)))
           (let* ((const (dk-apply! (dk-cite! 'zero-deriv-connected-constant 'u Kf)))
                  (Gz0 (list Gp z0)) (fz0 (list 'f z0))
                  (c (list '* (list 'CC-EXP (list '- Gz0)) fz0)))
             (c3l-cc! (list '- Gz0))
             (fact 'cc-exp-converges (list '- Gz0))
             (dk-split-all!)
             (fact 'cc-exp-nonzero (list '- Gz0))
             (c3l-cc! c)
             (dk-have! (list 'NOT (list '= c 0))
               (lambda ()
                 (di)
                 ;; cc-mul-nonzero (cc-reciprocal), not cc-mul-zero-left: the latter is proven in
                 ;; ca-lft-compose, which loads AFTER this file
                 (fact 'cc-mul-nonzero (list 'CC-EXP (list '- Gz0)) fz0)
                 (dk-only! (list '= c 0) (list 'NOT (list '= c 0)))
                 (prop)))
             (let* ((w (dk-skolem! (dk-apply! (dk-cite! 'cc-exp-surjective-strip) c)))
                    (glog (list 'VNB-LAMBDA 'c3lz_ 'u (list '+ (list Gp 'c3lz_) w))))
               (ew glog)
               (dk-conj-close!
                (lambda ()
                  (if (eq? (c3l-head (dk-goal)) 'HOLOMORPHIC-ON)
                      (dk-holomorphic! 'u glog)
                      (let ((z (dk-di-var!)))
                        (c3l-fz! z)
                        (fact 'fun-apply-type-c Gp 'u 'CC z)
                        (dk-lam-b!)
                        (let* ((Gz (list Gp z)) (fz (list 'f z))
                               (A (list 'CC-EXP Gz)) (B (list 'CC-EXP (list '- Gz)))
                               (ew (list 'CC-EXP w)))
                          (c3l-cc! (list '- Gz))
                          (for-each (lambda (t) (fact 'cc-exp-converges t)) (list Gz (list '- Gz) w))
                          (dk-split-all!)
                          (dk-lam-b-h! (dk-apply! const z z0))
                          (fact 'cc-exp-add Gz w)
                          (fact 'cc-exp-add Gz (list '- Gz))
                          (fact 'cc-exp-zero)
                          (dk-have! (list '= (list '* A B) 1)
                            (lambda ()
                              (subst (list '= (list '* A B) (list 'CC-EXP (list '+ Gz (list '- Gz)))))
                              (dk-have! (list '= (list '+ Gz (list '- Gz)) 0) (lambda () (crs)))
                              (subst (list '= (list '+ Gz (list '- Gz)) 0))
                              (ass)))
                          (subst (list '= (list 'CC-EXP (list '+ Gz w)) (list '* A ew)))
                          (subst (list '= ew c))
                          (subst (list '= c (list '* B fz)))
                          (dk-have! (list '= (list '* A (list '* B fz)) (list '* (list '* A B) fz)) (lambda () (crs)))
                          (subst (list '= (list '* A (list '* B fz)) (list '* (list '* A B) fz)))
                          (subst (list '= (list '* A B) 1))
                          (crs)))))))))))))
 (lambda ()
   (ew 'f)
   (dk-conj-close!
    (lambda ()
      (if (not (eq? (c3l-head (dk-goal)) 'FORALL))
          (ass)
          (let ((z (dk-di-var!)))
            (dk-have! '(FORSOME c3lw_ (IN c3lw_ u)) (lambda () (ew z) (ass)))
            (dk-only! '(FORSOME c3lw_ (IN c3lw_ u)) '(NOT (FORSOME c3lw_ (IN c3lw_ u))))
            (prop)))))))
(qed 'holomorphic-log-convex-exists)
(topic! 'holomorphic-log-convex-exists 'analysis)
(alias! 'holomorphic-log-convex-exists
        "a nonvanishing holomorphic function on a convex open set has a holomorphic logarithm")

;;; =====================================================================
;;; exp-power-nn: exp(w)^n = exp(n w)
;;; =====================================================================
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL w (IMPLIES (IN w CC)
     (= (power (CC-EXP w) n) (CC-EXP (* n w)))))))))
(define c3l-leaves (dk-opened (lambda () (ni))))
(for-each
 (lambda (lf)
   (if (not (sequent-node-grounded? lf))
       (begin
         (dk-focus! lf)
         (if (not (dk-contains? (dk-goal) 'succ))
             ;; base
             (let ((w (begin (dk-peel!) (cadr (cadr (cadr (dk-goal)))))))
               (fact 'nn-zero-in)
               (fact 'cc-exp-converges w) (dk-split-all!)
               (fact 'power-zero (list 'CC-EXP w))
               (dk-have! (list '= (list '* 0 w) 0) (lambda () (crs)))
               (subst (list '= (list '* 0 w) 0))
               (fact 'cc-exp-zero)
               (subst (list '= (list 'power (list 'CC-EXP w) 0) 1))
               (subst (list '= '(CC-EXP 0) 1))
               (fact 'cc-one-in)
               (rfl))
             ;; step
             (let* ((pl (dk-peel!))
                    (ih (dk-pick (lambda (h) (and (eq? (c3l-head h) 'FORALL) (dk-contains? h 'power))) "the hypothesis"))
                    (gl (dk-goal))
                    (k (caddr (cadr gl)))
                    (n (cadr k))
                    (w (cadr (cadr (cadr gl))))
                    (E (list 'CC-EXP w)))
               (fact 'cc-exp-converges w) (dk-split-all!)
               (c3l-and! (list 'IN E 'CC) (list 'IN n 'NN))
               (fact 'power-succ E n)
               (subst (list '= (list 'power E k) (list '* E (list 'power E n))))
               (dk-apply! ih w)
               (subst (list '= (list 'power E n) (list 'CC-EXP (list '* n w))))
               (fact 'nn-succ-plus-one n)
               (subst (list '= k (list '+ n 1)))
               (fact 'nn-in-rr n) (fact 'rr-subset-cc n)
               (c3l-cc! (list '* n w))
               (fact 'cc-exp-add w (list '* n w))
               (dk-have! (list '= (list '* (list '+ n 1) w) (list '+ w (list '* n w))) (lambda () (crs)))
               (subst (list '= (list '* (list '+ n 1) w) (list '+ w (list '* n w))))
               (subst (list '= (list 'CC-EXP (list '+ w (list '* n w))) (list '* E (list 'CC-EXP (list '* n w)))))
               (fact 'cc-exp-converges (list '* n w)) (dk-split-all!)
               (dk-have! (list 'IN (list '* E (list 'CC-EXP (list '* n w))) 'CC) (lambda () (type-term)))
               (rfl))))))
 c3l-leaves)
(qed 'exp-power-nn)
(topic! 'exp-power-nn 'analysis)

;;; =====================================================================
;;; holomorphic-log-convex (3.22 on a convex set, as the notes state it)
;;; =====================================================================
(define c3l-2pii '(* (* 2 PI) +i))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(IS-CONVEX-CC u)
     (list 'IMPLIES '(HOLOMORPHIC-ON u f)
       (list 'IMPLIES c3l-hyp-nz
         (list 'AND
           '(FORSOME g (AND (HOLOMORPHIC-ON u g) (FORALL z (IMPLIES (IN z u) (= (CC-EXP (g z)) (f z))))))
           (list 'FORALL 'g (list 'FORALL 'h (list 'IMPLIES '(HOLOMORPHIC-ON u g) (list 'IMPLIES '(HOLOMORPHIC-ON u h)
             (list 'IMPLIES '(FORALL z (IMPLIES (IN z u) (= (CC-EXP (g z)) (f z))))
               (list 'IMPLIES '(FORALL z (IMPLIES (IN z u) (= (CC-EXP (h z)) (f z))))
                 (list 'FORALL 'z0 (list 'IMPLIES '(IN z0 u)
                   (list 'FORSOME 'n (list 'AND '(IN n ZZ)
                     (list 'FORALL 'z (list 'IMPLIES '(IN z u)
                       (list '= '(g z) (list '+ '(h z) (list '* 'n c3l-2pii)))))))))))))))))))))))
(dk-peel!)
(fact 'holomorphic-log-convex-exists 'u 'f)
(fact 'cc-convex-connected 'u)
(dk-conj-close!
 (lambda ()
   (if (dk-asm? (dk-goal))
       (ass)
       (let* ((pl (dk-peel!))
              (eqs (filter (lambda (q) (and (eq? (c3l-head q) 'FORALL) (dk-contains? q 'CC-EXP) (dk-contains? q '(f z)))) (dk-asms)))
              (eg (find-first (lambda (q) (dk-contains? q '(g z))) eqs))
              (eh (find-first (lambda (q) (dk-contains? q '(h z))) eqs))
              (z0 (cadr (car (filter (lambda (q) (and (eq? (c3l-head q) 'IN) (eq? (caddr q) 'u))) pl)))))
         (dk-have! '(FORALL z (IMPLIES (IN z u) (= (CC-EXP (g z)) (CC-EXP (h z)))))
           (lambda ()
             (let ((z (dk-di-var!)))
               (dk-apply! eg z) (dk-apply! eh z)
               (subst (list '= (list 'CC-EXP (list 'g z)) (list 'f z)))
               (subst (list '= (list 'CC-EXP (list 'h z)) (list 'f z)))
               (fact 'holomorphic-on-in-fun 'u 'f)
               (dk-project! '(SUBSET u CC) 'is-convex-cc '(IS-CONVEX-CC u))
               (fact 'fun-apply-type-c 'f 'u 'CC z)
               (rfl))))
         (dk-close-if! (lambda () (inst*! (dk-cite! 'exp-equal-diff-2-pi-i 'u 'g 'h) z0)) ass)))))
(qed 'holomorphic-log-convex)
(topic! 'holomorphic-log-convex 'analysis)
(alias! 'holomorphic-log-convex
        "on a convex open set a nonvanishing holomorphic f is exp g, g unique up to 2 pi i n")

;;; =====================================================================
;;; CC is convex; Lemma 6.19
;;; =====================================================================
(sp (make-wff '(IS-CONVEX-CC CC)))
(mac 'is-convex-cc)
(dk-conj-close!
 (lambda ()
   (if (eq? (c3l-head (dk-goal)) 'SUBSET)
       (dk-close-if! (lambda () (fact 'subset-refl 'CC)) ass)
       (let* ((pl (dk-peel!))
              (t (cadr (car (filter (lambda (q) (and (eq? (c3l-head q) 'IN) (dk-head-is? (caddr q) 'CCINT))) pl)))))
         (dk-project! (list 'IN t 'RR) 'ccint-membership (list 'IN t '(CCINT 0 1)))
         (fact 'rr-subset-cc t)
         (type-term)))))
(qed 'cc-is-convex)
(topic! 'cc-is-convex 'analysis)

(sp (make-wff '(FORALL f (IMPLIES (HOLOMORPHIC-ON CC f)
     (IFF (FORALL z (IMPLIES (IN z CC) (NOT (= (f z) 0))))
          (FORSOME g (AND (HOLOMORPHIC-ON CC g)
            (FORALL z (IMPLIES (IN z CC) (= (f z) (CC-EXP (g z))))))))))))
(dk-peel!)
(fact 'cc-is-convex)
(fact 'holomorphic-on-in-fun 'CC 'f)
(dk-iff! (dk-head? 'FORSOME)
  (lambda ()
    (let* ((g (dk-skolem! (dk-cite! 'holomorphic-log-convex-exists 'CC 'f)))
           (ecl (dk-pick (lambda (q) (and (eq? (c3l-head q) 'FORALL) (dk-contains? q g))) "exp g = f")))
      (ew g)
      (dk-conj-close!
       (lambda ()
         (if (not (eq? (c3l-head (dk-goal)) 'FORALL))
             (ass)
             (let ((z (dk-di-var!)))
               (dk-apply! ecl z)
               (fact 'fun-apply-type-c 'f 'CC 'CC z)
               (subst (list '= (list 'CC-EXP (list g z)) (list 'f z)))
               (rfl)))))))
  (lambda ()
    (let* ((g (dk-skolem! (dk-pick (lambda (q) (eq? (c3l-head q) 'FORSOME)) "the exponent")))
           (ecl (dk-pick (lambda (q) (and (eq? (c3l-head q) 'FORALL) (dk-contains? q g))) "f = exp g")))
      (fact 'holomorphic-on-in-fun 'CC g)
      (let ((z (dk-di-var!)))
        (dk-apply! ecl z)
        (fact 'fun-apply-type-c g 'CC 'CC z)
        (fact 'cc-exp-nonzero (list g z))
        (subst (list '= (list 'f z) (list 'CC-EXP (list g z))))
        (ass)))))
(qed 'entire-nonvanishing-iff-exp)
(topic! 'entire-nonvanishing-iff-exp 'analysis)
(alias! 'entire-nonvanishing-iff-exp "an entire function is nowhere zero iff it is exp g for an entire g")

;;; =====================================================================
;;; Cor 3.25 on a convex set: n-th roots
;;; =====================================================================
(define (c3l-n-facts!)                 ; n in NN, 1 <= n in context: n in CC, n /= 0, r := recip n named
  (fact 'nn-in-rr 'n)
  (fact 'rr-subset-cc 'n)
  (dk-have! '(NOT (= n 0)) (lambda () (di) (dk-absurd! '(= n 0) '(<= 1 n) '(IN n RR))))
  (c3l-and! '(IN n CC) '(NOT (= n 0)))
  (fact 'cc-recip-closed 'n)
  (fact 'cc-recip-inverse 'n))
(define (c3l-recip-name!)              ; name recip(n), with n * r = 1
  (let ((r (dk-name! '(recip n) 'CC)))
    (dk-have! (list '= (list '* 'n r) 1) (lambda () (subst (list '= r '(recip n))) (ass)))
    r))
(define c3l-root-hyps (list '(IS-CONVEX-CC u) '(HOLOMORPHIC-ON u f) c3l-hyp-nz '(IN n NN) '(<= 1 n)))
(define (c3l-imps hs body) (if (null? hs) body (list 'IMPLIES (car hs) (c3l-imps (cdr hs) body))))

(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'FORALL 'n (c3l-imps c3l-root-hyps
     '(FORSOME g (AND (HOLOMORPHIC-ON u g)
        (FORALL z (IMPLIES (IN z u) (= (power (g z) n) (f z))))))))))))
(dk-peel!)
(dk-project! '(SUBSET u CC) 'is-convex-cc '(IS-CONVEX-CC u))
(fact 'holomorphic-on-in-fun 'u 'f)
(c3l-n-facts!)
(define c3l-L (dk-skolem! (dk-cite! 'holomorphic-log-convex-exists 'u 'f)))
(define c3l-Lcl (dk-pick (lambda (q) (and (eq? (c3l-head q) 'FORALL) (dk-contains? q c3l-L))) "exp L = f"))
(fact 'holomorphic-on-in-fun 'u c3l-L)
(define c3l-groot (list 'VNB-LAMBDA 'c3lz_ 'u (list 'CC-EXP (list '* '(recip n) (list c3l-L 'c3lz_)))))
(ew c3l-groot)
(dk-conj-close!
 (lambda ()
   (if (eq? (c3l-head (dk-goal)) 'HOLOMORPHIC-ON)
       (dk-holomorphic! 'u c3l-groot)
       (let* ((z (dk-di-var!)) (Lz (list c3l-L z)))
         (fact 'subset-mem-fwd 'u 'CC z)
         (fact 'fun-apply-type-c c3l-L 'u 'CC z)
         (fact 'fun-apply-type-c 'f 'u 'CC z)
         (c3l-cc! (list '* '(recip n) Lz))
         (fact 'cc-exp-converges (list '* '(recip n) Lz)) (dk-split-all!)
         (dk-lam-b!)
         (dk-apply! (dk-cite! 'exp-power-nn 'n) (list '* '(recip n) Lz))
         (subst (list '= (list 'power (list 'CC-EXP (list '* '(recip n) Lz)) 'n) (list 'CC-EXP (list '* 'n (list '* '(recip n) Lz)))))
         (let ((r (c3l-recip-name!)))
           (subst (list '= '(recip n) r))
           (dk-have! (list '= (list '* 'n (list '* r Lz)) (list '* (list '* 'n r) Lz)) (lambda () (crs)))
           (subst (list '= (list '* 'n (list '* r Lz)) (list '* (list '* 'n r) Lz)))
           (subst (list '= (list '* 'n r) 1))
           (dk-have! (list '= (list '* 1 Lz) Lz) (lambda () (crs)))
           (subst (list '= (list '* 1 Lz) Lz))
           (dk-apply! c3l-Lcl z)
           (ass))))))
(qed 'holomorphic-root-convex-exists)
(topic! 'holomorphic-root-convex-exists 'analysis)
(alias! 'holomorphic-root-convex-exists
        "a nonvanishing holomorphic function on a convex open set has a holomorphic n-th root")

(define c3l-pow-g '(FORALL z (IMPLIES (IN z u) (= (power (g z) n) (f z)))))
(define c3l-pow-h '(FORALL z (IMPLIES (IN z u) (= (power (h z) n) (f z)))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'FORALL 'n (c3l-imps c3l-root-hyps
     (list 'FORALL 'g (list 'FORALL 'h (c3l-imps (list '(HOLOMORPHIC-ON u g) '(HOLOMORPHIC-ON u h) c3l-pow-g c3l-pow-h)
       '(FORALL z0 (IMPLIES (IN z0 u)
          (FORSOME a (AND (IN a CC) (AND (= (power a n) 1)
            (FORALL z (IMPLIES (IN z u) (= (h z) (* a (g z)))))))))))))))))))
(dk-peel!)
(dk-project! '(SUBSET u CC) 'is-convex-cc '(IS-CONVEX-CC u))
(fact 'holomorphic-on-in-fun 'u 'f)
(fact 'holomorphic-on-in-fun 'u 'g)
(fact 'holomorphic-on-in-fun 'u 'h)
(fact 'cc-convex-connected 'u)
(c3l-n-facts!)
(define c3l-q (dk-skolem! (dk-cite! 'nn-pos-is-succ 'n)))
(fact 'power-zero-base c3l-q)
;;; fn^n = f with f nonvanishing: fn nonvanishing
(define (c3l-nonvan! fn pw)
  (dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list 'NOT (list '= (list fn 'z) 0))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (di)
        (dk-apply! pw z)
        (dk-apply! c3l-nz z)
        (dk-have! (list '= (list 'f z) 0)
          (lambda ()
            (subst (list '= (list 'f z) (list 'power (list fn z) 'n)))
            (subst (list '= (list fn z) 0))
            (subst (list '= 'n (list 'succ c3l-q)))
            (ass)))
        (dk-close-if! (lambda () (dk-only! (list '= (list 'f z) 0) (list 'NOT (list '= (list 'f z) 0)))) prop)))))
(define c3l-pg (dk-pick (lambda (q) (and (eq? (c3l-head q) 'FORALL) (dk-contains? q '(g z)) (dk-contains? q 'power))) "g^n = f"))
(define c3l-ph (dk-pick (lambda (q) (and (eq? (c3l-head q) 'FORALL) (dk-contains? q '(h z)) (dk-contains? q 'power))) "h^n = f"))
(c3l-nonvan! 'g c3l-pg)
(c3l-nonvan! 'h c3l-ph)
(define c3l-N (dk-skolem! (dk-cite! 'holomorphic-log-convex-exists 'u 'g)))
(define c3l-Ncl (dk-pick (lambda (q) (and (eq? (c3l-head q) 'FORALL) (dk-contains? q c3l-N))) "exp N = g"))
(define c3l-M (dk-skolem! (dk-cite! 'holomorphic-log-convex-exists 'u 'h)))
(define c3l-Mcl (dk-pick (lambda (q) (and (eq? (c3l-head q) 'FORALL) (dk-contains? q c3l-M))) "exp M = h"))
(fact 'holomorphic-on-in-fun 'u c3l-N)
(fact 'holomorphic-on-in-fun 'u c3l-M)
(define c3l-nM (list 'VNB-LAMBDA 'c3lz_ 'u (list '* 'n (list c3l-M 'c3lz_))))
(define c3l-nN (list 'VNB-LAMBDA 'c3lz_ 'u (list '* 'n (list c3l-N 'c3lz_))))
(dk-have! (list 'HOLOMORPHIC-ON 'u c3l-nM) (lambda () (dk-holomorphic! 'u c3l-nM)))
(dk-have! (list 'HOLOMORPHIC-ON 'u c3l-nN) (lambda () (dk-holomorphic! 'u c3l-nN)))
;;; exp(n M z) = h(z)^n = f(z), and likewise for N
(define (c3l-expn! L Lcl fn pw z)      ; lands exp(n L z) = f z
  (let ((Lz (list L z)))
    (fact 'fun-apply-type-c L 'u 'CC z)
    (fact 'fun-apply-type-c fn 'u 'CC z)
    (dk-have! (list '= (list 'CC-EXP (list '* 'n Lz)) (list 'f z))
      (lambda ()
        (dk-apply! (dk-cite! 'exp-power-nn 'n) Lz)
        (subst (list '= (list 'CC-EXP (list '* 'n Lz)) (list 'power (list 'CC-EXP Lz) 'n)))
        (dk-apply! Lcl z)
        (subst (list '= (list 'CC-EXP Lz) (list fn z)))
        (dk-apply! pw z)
        (ass)))))
(dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list '= (list 'CC-EXP (list c3l-nM 'z)) (list 'CC-EXP (list c3l-nN 'z)))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (fact 'subset-mem-fwd 'u 'CC z)
      (fact 'fun-apply-type-c c3l-M 'u 'CC z)
      (fact 'fun-apply-type-c c3l-N 'u 'CC z)
      (dk-lam-b!)
      (c3l-expn! c3l-M c3l-Mcl 'h c3l-ph z)
      (c3l-expn! c3l-N c3l-Ncl 'g c3l-pg z)
      (subst (list '= (list 'CC-EXP (list '* 'n (list c3l-M z))) (list 'f z)))
      (subst (list '= (list 'CC-EXP (list '* 'n (list c3l-N z))) (list 'f z)))
      (fact 'fun-apply-type-c 'f 'u 'CC z)
      (rfl))))
(define c3l-z0 (cadr (car (filter (lambda (q) (and (eq? (c3l-head q) 'IN) (eq? (caddr q) 'u) (not (memq (cadr q) '(z))))) (dk-asms)))))
(define c3l-kint (dk-skolem! (dk-apply! (dk-cite! 'exp-equal-diff-2-pi-i 'u c3l-nM c3l-nN) 'z0)))
(define c3l-kcl (dk-pick (lambda (q) (and (eq? (c3l-head q) 'FORALL) (dk-contains? q c3l-kint))) "n M = n N + m 2 pi i"))
(define c3l-r (c3l-recip-name!))
(define c3l-c (list '* c3l-r (list '* c3l-kint c3l-2pii)))
(define c3l-a (list 'CC-EXP c3l-c))
(if (not (dk-asm? '(IN PI RR))) (begin (fact 'pi-pos) (dk-split-all!)))
(fact 'rr-subset-cc 'PI)
(c3l-cc! c3l-kint)
(fact 'cc-i-in)
(c3l-cc! c3l-2pii)
(c3l-cc! c3l-c)
(fact 'cc-exp-converges c3l-c) (dk-split-all!)
(ew c3l-a)
(dk-conj-close!
 (lambda ()
   (let ((gl (dk-goal)))
     (cond
      ((eq? (c3l-head gl) '=)
       ;; a^n = exp(n c) = exp(m 2 pi i) = 1
       (dk-apply! (dk-cite! 'exp-power-nn 'n) c3l-c)
       (subst (list '= (list 'power c3l-a 'n) (list 'CC-EXP (list '* 'n c3l-c))))
       (dk-have! (list '= (list '* 'n c3l-c) (list '* (list '* 'n c3l-r) (list '* c3l-kint c3l-2pii))) (lambda () (crs)))
       (subst (list '= (list '* 'n c3l-c) (list '* (list '* 'n c3l-r) (list '* c3l-kint c3l-2pii))))
       (subst (list '= (list '* 'n c3l-r) 1))
       (dk-have! (list '= (list '* 1 (list '* c3l-kint c3l-2pii)) (list '* c3l-kint c3l-2pii)) (lambda () (crs)))
       (subst (list '= (list '* 1 (list '* c3l-kint c3l-2pii)) (list '* c3l-kint c3l-2pii)))
       (fact 'cc-exp-two-pi-i)
       (dk-close-if! (lambda () (inst*! (dk-cite! 'cc-exp-kernel-zz-multiple c3l-2pii) c3l-kint)) ass))
      ((eq? (c3l-head gl) 'FORALL)
       (let* ((z (dk-di-var!)) (Mz (list c3l-M z)) (Nz (list c3l-N z)))
         (fact 'subset-mem-fwd 'u 'CC z)
         (fact 'fun-apply-type-c c3l-M 'u 'CC z)
         (fact 'fun-apply-type-c c3l-N 'u 'CC z)
         (fact 'fun-apply-type-c 'g 'u 'CC z)
         (dk-lam-b-h! (dk-apply! c3l-kcl z))
         ;; M z = N z + c
         (dk-have! (list '= Mz (list '+ Nz c3l-c))
           (lambda ()
             (dk-have! (list '= Mz (list '* c3l-r (list '* 'n Mz)))
               (lambda ()
                 (dk-have! (list '= (list '* c3l-r (list '* 'n Mz)) (list '* (list '* 'n c3l-r) Mz)) (lambda () (crs)))
                 (subst (list '= (list '* c3l-r (list '* 'n Mz)) (list '* (list '* 'n c3l-r) Mz)))
                 (subst (list '= (list '* 'n c3l-r) 1))
                 (crs)))
             (subst (list '= Mz (list '* c3l-r (list '* 'n Mz))))
             (subst (list '= (list '* 'n Mz) (list '+ (list '* 'n Nz) (list '* c3l-kint c3l-2pii))))
             (dk-have! (list '= (list '* c3l-r (list '+ (list '* 'n Nz) (list '* c3l-kint c3l-2pii)))
                             (list '+ (list '* (list '* 'n c3l-r) Nz) c3l-c))
               (lambda () (crs)))
             (subst (list '= (list '* c3l-r (list '+ (list '* 'n Nz) (list '* c3l-kint c3l-2pii)))
                          (list '+ (list '* (list '* 'n c3l-r) Nz) c3l-c)))
             (subst (list '= (list '* 'n c3l-r) 1))
             (crs)))
         (dk-apply! c3l-Mcl z)
         (dk-apply! c3l-Ncl z)
         (fact 'cc-exp-add Nz c3l-c)
         (subst (list '= (list 'h z) (list 'CC-EXP Mz)))
         (subst (list '= Mz (list '+ Nz c3l-c)))
         (subst (list '= (list 'CC-EXP (list '+ Nz c3l-c)) (list '* (list 'CC-EXP Nz) c3l-a)))
         (subst (list '= (list 'CC-EXP Nz) (list 'g z)))
         (crs)))
      (#t (ass))))))
(qed 'holomorphic-root-convex-unique)
(topic! 'holomorphic-root-convex-unique 'analysis)
(alias! 'holomorphic-root-convex-unique
        "two holomorphic n-th roots of the same function on a convex open set differ by an n-th root of unity")
