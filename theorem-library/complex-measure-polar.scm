(define (mfm-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MFM OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mfm-find-if x)
  (cond ((not (pair? x)) #f)
        ((eq? (car x) 'IF) x)
        (#t (let loop ((xs x))
              (cond ((null? xs) #f)
                    ((not (pair? xs)) #f)
                    ((mfm-find-if (car xs)) => (lambda (r) r))
                    (#t (loop (cdr xs))))))))
;; a in ca: land (SUBSET a omega)
(define (mfm-sub-omega! a)
  (if (not (dk-asm? (list 'SUBSET a 'omega)))
      (begin
        (dk-cite! 'sigma-algebra-in-power-power 'omega 'ca)
        (dk-iff-fwd! (dk-cite! 'power-set-membership '(POWER omega) 'ca))
        (dk-apply! '(FORALL z (IMPLIES (IN z ca) (IN z (POWER omega)))) a)
        (dk-iff-fwd! (dk-cite! 'power-set-membership 'omega a))
        (dk-iff-bwd! (dk-cite! 'subset-def a 'omega)))))
(define (mfm-real! . ts) (for-each (lambda (t) (dk-type! t 'RR)) ts))

;; ---------------------------------------------------------------------------
;; real integrals against the density measure TV = pp . rho
(define mfm-TV '(VNB-LAMBDA dma_ ca (INTEGRAL omega ca rho (PTWISE-ETIMES omega pp (INDICATOR omega dma_)))))
(define (mfm-ptw body) (list 'FORALL 'x (list 'IMPLIES '(IN x omega) body)))
(sp (make-wff (dk-foralls '(omega ca rho pp g f)
  (dk-curry (list '(IS-MEASURE omega ca rho) '(IS-MEASURABLE-FN omega ca pp) (mfm-ptw '(IN (pp x) RR))
                  '(IS-REAL-MEASURABLE-FN omega ca g) '(IN f (FUN omega RR)) (mfm-ptw '(= (f x) (* (pp x) (g x))))
                  '(IS-INTEGRABLE omega ca rho f))
    (list '= (list 'RINTEGRAL 'omega 'ca mfm-TV 'g) '(RINTEGRAL omega ca rho f))))))
(dk-peel!)
(let* ((gp (dk-iff-parts! (dk-cite! 'is-real-measurable-fn 'omega 'ca 'g)))
       (fp (dk-iff-parts! (dk-cite! 'is-integrable 'omega 'ca 'rho 'f)))
       (hp (dk-iff-parts! (dk-cite! 'is-measurable-fn 'omega 'ca 'pp)))
       (fr (dk-iff-parts! (dk-cite! 'is-real-measurable-fn 'omega 'ca 'f)))
       (TV mfm-TV)
       (pt! (lambda (x)
              (dk-cite! 'fun-apply-type-c 'pp 'omega 'RR-POS-STAR x)
              (dk-cite! 'rr-pos-star-nonneg (list 'pp x))
              (dk-apply! (mfm-ptw '(IN (pp x) RR)) x)
              (dk-cite! 'fun-apply-type-c 'g 'omega 'RR x)
              (dk-cite! 'fun-apply-type-c 'f 'omega 'RR x)
              (dk-apply! (mfm-ptw '(= (f x) (* (pp x) (g x)))) x))))
  (dk-cite! 'density-measure 'omega 'ca 'rho 'pp)
  (dk-have! (list 'FORALL 'rna_ (list 'IMPLIES '(IN rna_ ca)
              (list '= (list TV 'rna_) '(INTEGRAL omega ca rho (PTWISE-ETIMES omega pp (INDICATOR omega rna_))))))
    (lambda ()
      (let ((a (dk-di-var!)))
        (dk-cite! 'measurable-fn-indicator 'omega 'ca a)
        (dk-cite! 'measurable-fn-etimes 'omega 'ca 'pp (list 'INDICATOR 'omega a))
        (dk-cite! 'integral-in 'omega 'ca 'rho (list 'PTWISE-ETIMES 'omega 'pp (list 'INDICATOR 'omega a)))
        (dk-lam-b!)
        (if (not (proof-done? *ps*)) (if (not (dk-ass!)) (rfl))))))
  (let ((dcu (dk-cite! 'density-change 'omega 'ca 'rho TV 'pp)))
    (subst (dk-cite! 'rintegral-unfold 'omega 'ca TV 'g))
    (subst (dk-cite! 'rintegral-unfold 'omega 'ca 'rho 'f))
    (for-each
      (lambda (part law)
        (let* ((pg (list part 'omega 'g)) (pf (list part 'omega 'f))
               (hg (list 'PTWISE-ETIMES 'omega 'pp pg)))
          (subst (dk-apply! dcu pg))
          (dk-cite! 'measurable-fn-etimes 'omega 'ca 'pp pg)
          (dk-project! (list 'IN hg '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'ca hg))
          (dk-cite! (if (eq? part 'POS-PART) 'pos-part-fun 'neg-part-fun) 'omega 'f)
          (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES '(IN icx_ omega) (list '= (list hg 'icx_) (list pf 'icx_))))
            (lambda ()
              (let ((x (dk-di-var!)))
                (pt! x)
                (mac 'PTWISE-ETIMES)
                (mac part)
                (dk-lam-b!)
                (subst (list '= (list 'f x) (list '* (list 'pp x) (list 'g x))))
                (dk-cite! law (list 'pp x) (list 'g x))
                (dk-ass!))))
          (subst (dk-cite! 'integral-congruence-ptwise 'omega 'ca 'rho hg pf))))
      '(POS-PART NEG-PART) '(ptwise-pos-part-scale ptwise-neg-part-scale))
    (rfl)))
(mfm-qed! 'rintegral-density)

