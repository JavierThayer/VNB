;;; mf-c7.scm -- Proposition 3.17 (existence): a complex measure nu has a finite measure |nu| with the null sets of nu
;;; and a measurable phase u, |u| = 1, with nu(A) = int_A u d|nu|.
;;; Agent M-F, 2026-10-29.  DESTINATION: theorem-library/complex-measure-polar.scm (after mf-c6).  Library: measure.
;;; Helper prefix: mfz-.  Load window: after mf-c6.scm.
;;; Route (the notes' proof): rho = nu1 + nu2 + nu3 + nu4 dominates the four measures; Radon-Nikodym
;;; (rn-finite-dominated) gives densities d1..d4; phi = (d1 - d2) + i(d3 - d4); |nu| = |phi| rho; u = phi/|phi| (1 where
;;; phi = 0).  Null sets: |nu|(A) = 0 forces nu = 0 on subsets of A (integrals over a null set); conversely nu null on A
;;; makes int_B (d1 - d2) 1_A = 0 for every B, so 1_A (d1 - d2) = 0 a.e., and the same for d3 - d4, hence |phi| 1_A = 0 a.e.

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)

(define (mfz-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MFZ OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mfz-real! . ts) (for-each (lambda (t) (dk-type! t 'RR)) ts))
(define (mfz-ptw body) (list 'FORALL 'x (list 'IMPLIES '(IN x omega) body)))
(define (mfz-dreal d) (list 'FORALL 'rnx_ (list 'IMPLIES '(IN rnx_ omega) (list 'IN (list d 'rnx_) 'RR))))
(define (mfz-dens m d) (list 'FORALL 'rna_ (list 'IMPLIES '(IN rna_ ca)
                         (list '= (list m 'rna_) (list 'INTEGRAL 'omega 'ca 'rho (list 'PTWISE-ETIMES 'omega d '(INDICATOR omega rna_)))))))
(define (mfz-ind a x) (list (list 'INDICATOR 'omega a) x))
(define (mfz-ind-val! a x k)
  (use-em (list 'IN x a)
    (lambda () (dk-cite! 'indicator-value-in 'omega a x) (k 1))
    (lambda () (dk-cite! 'indicator-value-out 'omega a x) (k 0))))
(define mfz-tv-tmpl '(VNB-LAMBDA dma_ ca (INTEGRAL omega ca rho (PTWISE-ETIMES omega pp (INDICATOR omega dma_)))))
(define (mfz-G a f) (list 'VNB-LAMBDA 'cix_ 'omega (list '* (list (list 'INDICATOR 'omega a) 'cix_) (list f 'cix_))))
(define (mfz-H c d1 d2) (list 'VNB-LAMBDA 'hx_ 'omega (list '* (list (list 'INDICATOR 'omega c) 'hx_) (list '- (list d1 'hx_) (list d2 'hx_)))))
(define mfz-concl
  '(FORSOME tv_ (AND (IS-FINITE-MEASURE omega ca tv_)
     (AND (FORALL a_ (IMPLIES (IN a_ ca) (IFF (= (tv_ a_) 0) (IS-COMPLEX-NULL-SET omega ca nu a_))))
          (FORSOME u_ (AND (IS-COMPLEX-MEASURABLE-FN omega ca u_)
            (AND (FORALL x_ (IMPLIES (IN x_ omega) (= (magnitude (u_ x_)) 1)))
                 (FORALL a_ (IMPLIES (IN a_ ca)
                   (= (nu a_) (COMPLEX-INTEGRAL omega ca tv_ (VNB-LAMBDA cux_ omega (* ((INDICATOR omega a_) cux_) (u_ cux_))))))))))))))

(sp (make-wff (dk-foralls '(omega ca nu) (dk-curry '((IS-COMPLEX-MEASURE omega ca nu)) mfz-concl))))
