;; the indicator of a measurable set: values, real measurability
(define (mfm-ind a x) (list (list 'INDICATOR 'omega a) x))
(define (mfm-ind-val! a x k)          ; split on x in a; k called with the value (1 or 0); (= (1_a x) v) in context
  (use-em (list 'IN x a)
    (lambda () (dk-cite! 'indicator-value-in 'omega a x) (k 1))
    (lambda () (dk-cite! 'indicator-value-out 'omega a x) (k 0))))
(sp (make-wff (dk-foralls '(omega ca a) (dk-curry '((IS-SIGMA-ALGEBRA omega ca) (IN a ca)) '(IS-REAL-MEASURABLE-FN omega ca (INDICATOR omega a))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'rr-one-in)
(dk-cite! 'measurable-fn-indicator 'omega 'ca 'a)
(dk-have! '(FORALL x_ (IMPLIES (IN x_ omega) (IN ((INDICATOR omega a) x_) RR)))
  (lambda () (let ((x (dk-di-var!)))
               (mfm-ind-val! 'a x (lambda (v) (subst (list '= (mfm-ind 'a x) v)) (dk-ass!))))))
