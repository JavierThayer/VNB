;; the phase: measurable, of modulus one, and the polar formula
(define (mfz-phase!)
  (let ((us (mfz-n 'us)))
    (ew us)
    (dk-conj-close!
      (lambda ()
        (let ((gl (dk-goal)))
          (cond
            ((dk-ass!) #t)
            ((dk-head-is? gl 'IS-COMPLEX-MEASURABLE-FN)
             (mac 'is-complex-measurable-fn)
             (dk-conj-close!
               (lambda ()
                 (if (not (dk-ass!))
                     (let* ((lfn (cadddr (dk-goal)))
                            (part (car (cadddr lfn)))
                            (u (if (eq? part 'REAL-PART) (mfz-n 'ru) (mfz-n 'iu))))
                       (dk-have! (list 'IN lfn '(FUN omega RR))
                         (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!)))
                                                               (dk-cite! 'fun-apply-type-c us 'omega 'CC x)
                                                               (dk-cite! (if (eq? part 'REAL-PART) 'real-part-in-rr 'imag-part-in-rr) (list us x))
                                                               (dk-ass!))))))
                       (dk-have! (list 'FORALL 'ex_ (list 'IMPLIES '(IN ex_ omega) (list '= (list u 'ex_) (list lfn 'ex_))))
                         (lambda () (let ((x (dk-di-var!)))
                                      (mfz-u-parts! x)
                                      (dk-lam-b!)
                                      (subst (list '= (list part (list us x)) (list u x)))
                                      (rfl))))
                       (dk-project! (list 'IN u '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca u))
                       (dk-cite! 'real-measurable-ptwise-eq 'omega 'ca u lfn)
                       (dk-ass!))))))
            ((and (dk-head-is? gl 'FORALL) (dk-contains? gl 'magnitude))
             (let ((x (dk-di-var!)))
               (mfz-u-parts! x)
               (subst (dk-cite! 'magnitude-def (list us x)))
               (subst (list '= (list 'REAL-PART (list us x)) (mfz-n-x 'ru x)))
               (subst (list '= (list 'IMAG-PART (list us x)) (mfz-n-x 'iu x)))
               (subst (mfz-s (list '= (list '+ (list '* (list 'ru x) (list 'ru x)) (list '* (list 'iu x) (list 'iu x))) 1)))
               (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
               (dk-have! '(= (* 1 1) 1) (lambda () (crs)))
               (dk-have-and! '(IN 1 RR) '(<= 0 1))
               (dk-cite! 'sqrt-char 1 1)
               (dk-ass!)))
            (#t
             (let ((a (dk-di-var!)))
               (mfz-sub-omega! a)
               (mac 'COMPLEX-INTEGRAL)
               (for-each
                 (lambda (part u da db ma mb)
                   (let* ((ia (list 'VNB-LAMBDA 'cux_ 'omega (list '* (list (list 'INDICATOR 'omega a) 'cux_) (list us 'cux_))))
                          (lfn (list 'VNB-LAMBDA 'cix_ 'omega (list part (list ia 'cix_))))
                          (gfn (mfz-s (mfz-G a u))))
                     (dk-have! (list 'IN lfn '(FUN omega RR))
                       (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!)))
                                                             (mfz-u-parts! x) (mfz-ind-ty! a x)
                                                             (dk-lam-b!)
                                                             (mfz-cite! 'rr-subset-cc (mfz-ind a x))
                                                             (dk-have-and! (list 'IN (mfz-ind a x) 'CC) (list 'IN (list us x) 'CC))
                                                             (dk-cite! 'cc-mul-closed (mfz-ind a x) (list us x))
                                                             (dk-cite! (if (eq? part 'REAL-PART) 'real-part-in-rr 'imag-part-in-rr) (list '* (mfz-ind a x) (list us x)))
                                                             (dk-ass!))))))
                     (dk-have! (list 'IN gfn '(FUN omega RR))
                       (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (mfz-pt! x) (mfz-ind-ty! a x) (dk-type! (cadr (dk-goal)) 'RR))))))
                     (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list '= (list lfn 'x) (list gfn 'x))))
                       (lambda () (let ((x (dk-di-var!)))
                                    (mfz-u-parts! x) (mfz-ind-ty! a x)
                                    (dk-lam-b!)
                                    (subst (dk-cite! (if (eq? part 'REAL-PART) 'cc-re-real-mul 'cc-im-real-mul) (mfz-ind a x) (list us x)))
                                    (subst (list '= (list part (list us x)) (mfz-n-x u x)))
                                    (rfl))))
                     (subst (dk-cite! 'rintegral-congruence 'omega 'ca mfz-tv lfn gfn))
                     (subst (mfz-cite! 'polar-real-part 'omega 'ca 'rho 'pp u da db ma mb a))))
                 '(REAL-PART IMAG-PART) '(ru iu) '(d1 d3) '(d2 d4) '(m1 m3) '(m2 m4))
               (dk-apply! (mfz-s '(FORALL cma_ (IMPLIES (IN cma_ ca) (= (nu cma_) (+ (- (m1 cma_) (m2 cma_)) (* +i (- (m3 cma_) (m4 cma_)))))))) a)
               (dk-ass!)))))))))
(define (mfz-n-x role x) (list (if (symbol? role) (let ((r (assq role mfz-names))) (if r (cdr r) role)) role) x))


(define (mfz-null-forward! a)
  (mac 'is-complex-null-set)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let ((b (dk-di-var!)))
            (di)
            (mfz-sub-omega! b)
            (dk-cite! 'fun-apply-type-c mfz-tv 'ca 'RR-POS-STAR b)
            (dk-cite! 'measure-monotone 'omega 'ca mfz-tv b a)
            (dk-rewrite-h! (list '<= (list mfz-tv b) (list mfz-tv a)) (list mfz-tv a) 0)
            (dk-cite! 'rr-pos-star-nonneg (list mfz-tv b))
            (dk-have-and! (list 'IN (list mfz-tv b) 'RR-POS-STAR) '(IN 0 RR-POS-STAR))
            (dk-have-and! (list '<= (list mfz-tv b) 0) (list '<= 0 (list mfz-tv b)))
            (dk-cite! 'rr-pos-star-le-antisymm (list mfz-tv b) 0)
            (mfz-mreal! b)
            (for-each
              (lambda (u da db ma mb)
                (mfz-cite! 'polar-real-part 'omega 'ca 'rho 'pp u da db ma mb b)
                (mfz-cite! 'rintegral-null-support 'omega 'ca mfz-tv b u)
                (let ((ri (list 'RINTEGRAL 'omega 'ca mfz-tv (mfz-s (mfz-G b u)))))
                  (dk-have! (mfz-s (list '= (list '- (list ma b) (list mb b)) 0))
                    (lambda () (subst (mfz-s (list '= (list '- (list ma b) (list mb b)) ri))) (dk-ass!)))))
              '(ru iu) '(d1 d3) '(d2 d4) '(m1 m3) '(m2 m4))
            (subst (dk-apply! (mfz-s '(FORALL cma_ (IMPLIES (IN cma_ ca) (= (nu cma_) (+ (- (m1 cma_) (m2 cma_)) (* +i (- (m3 cma_) (m4 cma_)))))))) b))
            (subst (mfz-s (list '= (list '- (list 'm1 b) (list 'm2 b)) 0)))
            (subst (mfz-s (list '= (list '- (list 'm3 b) (list 'm4 b)) 0)))
            (crs))))))
(define mfz-conj (cadr (dk-goal)))      ; (FORSOME tv_ BODY): BODY
(define mfz-body (mfz-s (subst-free 'tv_ mfz-tv (caddr (dk-goal)))))
(define mfz-c1 (cadr mfz-body))
(define mfz-c2 (cadr (caddr mfz-body)))
(define mfz-c3 (caddr (caddr mfz-body)))
;; (1) |nu| is a finite measure
(dk-have! mfz-c1
  (lambda ()
    (mac 'is-finite-measure)
    (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (lam-b) (dk-ass!)))))))
;; (2) its null sets are those of nu
(dk-have! mfz-c2
  (lambda ()
    (let ((a (dk-di-var!)))
      (mfz-sub-omega! a)
      (dk-cite! 'fun-apply-type-c mfz-tv 'ca 'RR-POS-STAR a)
      (dk-iff! (lambda (g) (dk-head-is? g 'IS-COMPLEX-NULL-SET))
        (lambda () (mfz-null-forward! a))
        (lambda () (mfz-null-backward! a))))))
;; (3) the phase
(dk-have! mfz-c3 (lambda () (mfz-phase!)))
(ew mfz-tv)
(dk-conj-close! dk-ass!)
(mfz-qed! 'polar-decomposition-exists)
  

