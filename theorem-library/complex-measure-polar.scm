(define (mfu-eplus-real! u v)
  (dk-cite! 'rr-pos-star-nonneg u) (dk-cite! 'rr-pos-star-nonneg v)
  (dk-cite! 'eplus-real-defined u v) (dk-cite! 'binplus-apply u v)
