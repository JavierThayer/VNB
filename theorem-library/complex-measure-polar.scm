    (dk-split-all! (list (dk-cite! 'integrable-ptwise-eq 'omega 'ca mfu-rho (mfu-D part 'omega) f)))
    (dk-have! (list 'FORALL 'bb_ (list 'IMPLIES '(IN bb_ ca)
                (list '= (mfu-RI (list 'VNB-LAMBDA 'rx_ 'omega (list '* (list f 'rx_) '((INDICATOR omega bb_) rx_)))) 0)))
      (lambda ()
        (let* ((bb (dk-di-var!))
               (fb (list 'VNB-LAMBDA 'rx_ 'omega (list '* (list f 'rx_) (list (list 'INDICATOR 'omega bb) 'rx_))))
               (f1 (mfu-Fi mfu-h1 'u1 part bb)) (f2 (mfu-Fi mfu-h2 'u2 part bb)))
          (mfu-parts! bb)
          (dk-split-all! (list (dk-apply! (list 'FORALL 'qa_ (list 'IMPLIES '(IN qa_ ca) (mfu-qa 'qa_))) bb)))
          (mfu-lin! part bb)
          (dk-cite! 'indicator-real-measurable 'omega 'ca bb)
          (dk-project! (list 'IN (list 'INDICATOR 'omega bb) '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca (list 'INDICATOR 'omega bb)))
          (dk-have! (list 'IN fb '(FUN omega RR))
            (lambda () (dk-lam-type! (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                                  (mfu-pt2! x)
                                                  (dk-cite! 'fun-apply-type-c (list 'INDICATOR 'omega bb) 'omega 'RR x)
                                                  (dk-lam-b!)
                                                  (dk-type! (cadr (dk-goal)) 'RR))))))
          (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list '= (list fb 'x) (list (mfu-D part bb) 'x))))
            (lambda () (let ((x (dk-di-var!)))
                         (mfu-pt2! x)
                         (dk-cite! 'fun-apply-type-c (list 'INDICATOR 'omega bb) 'omega 'RR x)
                         (dk-lam-b!)
                         (crs))))
          (subst (dk-cite! 'rintegral-congruence 'omega 'ca mfu-rho fb (mfu-D part bb)))
          (subst (list '= (mfu-RI (mfu-D part bb)) (list '+ (mfu-RI f1) (mfu-RI (mfu-S2 part bb)))))
          (subst (list '= (mfu-RI (mfu-S2 part bb)) (list '* '(- 1) (mfu-RI f2))))
          (subst (list '= (mfu-RI f2) (mfu-RI f1)))
          (crs))))
    (dk-cite! 'rintegral-zero-on-sets-null 'omega 'ca mfu-rho f)
    (list 'SEP 'nzx_ 'omega (list 'NOT (list '= (list f 'nzx_) 0)))))
(define mfu-nre (mfu-null-part! 'REAL-PART))
