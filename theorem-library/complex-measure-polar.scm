(define mfu-h2 (dk-skolem! (dk-cite! 'rn-finite-dominated 'omega 'ca 'mu2 mfu-rho)))
(define (mfu-rn e)                 ; rename the roles rho, h1, h2
  (cond ((eq? e 'rho) mfu-rho) ((eq? e 'h1) mfu-h1) ((eq? e 'h2) mfu-h2)
        ((pair? e) (cons (mfu-rn (car e)) (mfu-rn (cdr e)))) (#t e)))

;; F_i^P(a) = h_i 1_a P(u_i): its integral over rho is the P-part of int_a u_i d mu_i
(define (mfu-Fi h u part a) (list 'VNB-LAMBDA 'ux_ 'omega (list '* (list h 'ux_) (list '* (list (list 'INDICATOR 'omega a) 'ux_) (list part (list u 'ux_))))))
(define (mfu-RI f) (list 'RINTEGRAL 'omega 'ca mfu-rho f))
(define (mfu-qa a)
  (list 'AND (list '= (mfu-RI (mfu-Fi mfu-h1 'u1 'REAL-PART a)) (mfu-RI (mfu-Fi mfu-h2 'u2 'REAL-PART a)))
             (list '= (mfu-RI (mfu-Fi mfu-h1 'u1 'IMAG-PART a)) (mfu-RI (mfu-Fi mfu-h2 'u2 'IMAG-PART a)))))
(define (mfu-parts! a)            ; integrability and the density forms of the four parts at a (once per a)
 (if (not (dk-asm? (list 'IS-INTEGRABLE 'omega 'ca mfu-rho (mfu-Fi mfu-h1 'u1 'REAL-PART a))))
 (begin
  (for-each (lambda (m h u)
              (for-each (lambda (thm) (dk-split-all! (list (dk-cite! thm 'omega 'ca mfu-rho m h u a))))
                        '(polar-part-density-re polar-part-density-im)))
            '(mu1 mu2) (list mfu-h1 mfu-h2) '(u1 u2))
  (for-each (lambda (h u)
              (for-each (lambda (part)
                          (let ((f (mfu-Fi h u part a)))
                            (dk-iff-parts! (dk-cite! 'is-integrable 'omega 'ca mfu-rho f))
                            (dk-project! (list 'IN f '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca f))
                            (dk-cite! 'rintegral-in-rr 'omega 'ca mfu-rho f)))
                        '(REAL-PART IMAG-PART)))
            (list mfu-h1 mfu-h2) '(u1 u2)))))
(dk-have! (list 'FORALL 'qa_ (list 'IMPLIES '(IN qa_ ca) (mfu-qa 'qa_)))
  (lambda ()
    (let ((a (dk-di-var!)))
      (mfu-parts! a)
      (let ((ex (lambda (m h u)
                  (let* ((e (dk-apply! (mfu-polar m u) a))
                         (cu (dk-cite! 'complex-integral-unfold 'omega 'ca m (mfu-I u a)))
                         (e2 (dk-rewrite-h! e (caddr e) (caddr cu))))
                    (for-each (lambda (part)
                                (let ((l (list 'VNB-LAMBDA 'cix_ 'omega (list part (list (mfu-I u a) 'cix_)))))
                                  (set! e2 (dk-rewrite-h! e2 (list 'RINTEGRAL 'omega 'ca m l) (mfu-RI (mfu-Fi h u part a))))))
                              '(REAL-PART IMAG-PART))
                    (caddr e2)))))
        (let ((z1 (ex 'mu1 mfu-h1 'u1)) (z2 (ex 'mu2 mfu-h2 'u2)))
          (dk-have! (list '= z1 z2) (lambda () (subst (list '= z1 (list 'nu a))) (subst (list '= (list 'nu a) z2)) (rfl)))
          (dk-split-all! (list (dk-cite! 'complex-parts-equal (cadr z1) (caddr (caddr z1)) (cadr z2) (caddr (caddr z2)))))
          (dk-conj-close! dk-ass!))))))

;; pointwise typings at x
(define (mfu-pt2! x)
  (for-each (lambda (h)
              (dk-apply! (mfu-dreal h) x)
              (dk-project! (list 'IN h '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'ca h))
              (dk-cite! 'fun-apply-type-c h 'omega 'RR-POS-STAR x) (dk-cite! 'rr-pos-star-nonneg (list h x)))
            (list mfu-h1 mfu-h2))
  (for-each (lambda (u)
              (dk-iff-parts! (dk-cite! 'is-complex-measurable-fn 'omega 'ca u))
              (dk-cite! 'fun-apply-type-c u 'omega 'CC x)
              (dk-cite! 'real-part-in-rr (list u x)) (dk-cite! 'imag-part-in-rr (list u x)))
            '(u1 u2)))
(define (mfu-fP part) (list 'VNB-LAMBDA 'kx_ 'omega (list '- (list '* (list mfu-h1 'kx_) (list part '(u1 kx_))) (list '* (list mfu-h2 'kx_) (list part '(u2 kx_))))))
(define (mfu-S2 part a) (list 'VNB-LAMBDA 'sx_ 'omega (list '* '(- 1) (list (mfu-Fi mfu-h2 'u2 part a) 'sx_))))
(define (mfu-D part a) (list 'VNB-LAMBDA 'sx_ 'omega (list '+ (list (mfu-Fi mfu-h1 'u1 part a) 'sx_) (list (mfu-S2 part a) 'sx_))))
(define (mfu-lin! part a)        ; integrability of D, and RINT(D) = RINT(F1) + (-1) RINT(F2)
  (dk-cite! 'rr-neg-closed 1)
  (dk-split-all! (list (dk-cite! 'rintegral-scale 'omega 'ca mfu-rho (mfu-Fi mfu-h2 'u2 part a) '(- 1))))
  (dk-split-all! (list (dk-cite! 'rintegral-add 'omega 'ca mfu-rho (mfu-Fi mfu-h1 'u1 part a) (mfu-S2 part a))))
  (dk-iff-parts! (dk-cite! 'is-integrable 'omega 'ca mfu-rho (mfu-D part a)))
  (dk-project! (list 'IN (mfu-D part a) '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca (mfu-D part a))))
(define (mfu-typer)
  (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
               (mfu-pt2! x)
               (if (not (sequent-node-grounded? leaf))
                   (begin (if (dk-contains? (dk-goal) 'VNB-LAMBDA) (dk-lam-b!))
                          (if (not (sequent-node-grounded? leaf)) (dk-type! (cadr (dk-goal)) 'RR)))))))
(define (mfu-null-part! part)    ; returns the null set {f^P /= 0}
  (let* ((f (mfu-fP part)))
    (mfu-parts! 'omega)
    (mfu-lin! part 'omega)
    (dk-have! (list 'IN f '(FUN omega RR)) (lambda () (dk-lam-type! (mfu-typer))))
    (dk-have! (list 'FORALL 'ex_ (list 'IMPLIES '(IN ex_ omega) (list '= (list (mfu-D part 'omega) 'ex_) (list f 'ex_))))
      (lambda () (let ((x (dk-di-var!)))
                   (mfu-pt2! x)
