;; off nb: h1 Re u1 = h2 Re u2, h1 Im u1 = h2 Im u2, h1 = h2
(define (mfu-sq u x) (list '+ (list '* (list 'REAL-PART (list u x)) (list 'REAL-PART (list u x))) (list '* (list 'IMAG-PART (list u x)) (list 'IMAG-PART (list u x)))))
(define (mfu-unit! u x)          ; Re^2 + Im^2 = 1 at x
  (dk-apply! (mfu-ptw (list '= (list 'magnitude (list u 'x)) 1)) x)
  (dk-cite! 'magnitude-def (list u x))
  (let ((sq (mfu-sq u x)) (re (list 'REAL-PART (list u x))) (im (list 'IMAG-PART (list u x))))
    (mfu-real! (list '* re re) (list '* im im) sq)
    (dk-cite! 'rr-sq-nonneg re) (dk-cite! 'rr-sq-nonneg im)
    (dk-have! (list '<= 0 sq) (lambda () (dk-ineq! (list '<= 0 (list '* re re)) (list '<= 0 (list '* im im)) (list 'IN (list '* re re) 'RR) (list 'IN (list '* im im) 'RR))))
    (dk-have-and! (list 'IN sq 'RR) (list '<= 0 sq))
    (dk-cite! 'sqrt-sq sq)
    (dk-have! (list '= (list 'SQRT sq) 1) (lambda () (subst (list '== (list 'SQRT sq) (list 'magnitude (list u x)))) (dk-ass!)))
    (dk-rewrite-h! (list '= (list '* (list 'SQRT sq) (list 'SQRT sq)) sq) (list 'SQRT sq) 1)
    (dk-have! (list '= sq 1) (lambda () (subst (list '= sq (list '* 1 1))) (crs)))))
(define (mfu-eqh-claim x)
  (dk-and (list (list '= (list mfu-h1 x) (list mfu-h2 x))
                (list '= (list '* (list mfu-h1 x) (list 'REAL-PART (list 'u1 x))) (list '* (list mfu-h2 x) (list 'REAL-PART (list 'u2 x))))
                (list '= (list '* (list mfu-h1 x) (list 'IMAG-PART (list 'u1 x))) (list '* (list mfu-h2 x) (list 'IMAG-PART (list 'u2 x)))))))
(define mfu-eqh (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'NOT (list 'IN 'x mfu-nb)) (mfu-eqh-claim 'x)))))
(dk-have! mfu-eqh
  (lambda ()
    (let ((x (dk-di-var!)))
      (di)
      (mfu-pt2! x)
      (for-each
        (lambda (nset part)
          (let* ((f (car (cadr (cadr (cadddr nset))))) (fx (list f x))
                 (h1p (list '* (list mfu-h1 x) (list part (list 'u1 x)))) (h2p (list '* (list mfu-h2 x) (list part (list 'u2 x)))))
            (dk-have! (list '= fx 0)
              (lambda ()
                (use-em (list '= fx 0)
                  (lambda () (dk-ass!))
                  (lambda ()
                    (dk-have! (list 'IN x nset) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
                    (dk-have! (list 'IN x mfu-un) (lambda () (mac 'union-membership) (if (eq? nset mfu-nre) (oi-l) (oi-r)) (dk-ass!)))
                    (dk-cite! 'subset-mem-fwd mfu-un mfu-nb x)
                    (ai (list 'NOT (list 'IN x mfu-nb)))))))
            (dk-lam-b-h! (dk-ctx-form (list '= fx 0)))
            (mfu-real! h1p h2p)
            (dk-have! (list '= h1p h2p) (lambda () (dk-ineq! (list '= (list '- h1p h2p) 0) (list 'IN h1p 'RR) (list 'IN h2p 'RR))))))
        (list mfu-nre mfu-nim) '(REAL-PART IMAG-PART))
      (mfu-unit! 'u1 x) (mfu-unit! 'u2 x)
      (let* ((h1 (list mfu-h1 x)) (h2 (list mfu-h2 x))
             (r1 (list 'REAL-PART (list 'u1 x))) (i1 (list 'IMAG-PART (list 'u1 x)))
             (r2 (list 'REAL-PART (list 'u2 x))) (i2 (list 'IMAG-PART (list 'u2 x)))
             (a1 (list '* h1 r1)) (b1 (list '* h1 i1)) (a2 (list '* h2 r2)) (b2 (list '* h2 i2)))
        (dk-have! (list '= (list '* h1 h1) (list '* h2 h2))
          (lambda ()
            (dk-have! (list '= (list '* h1 h1) (list '+ (list '* a1 a1) (list '* b1 b1)))
              (lambda () (dk-have! (list '= (list '+ (list '* a1 a1) (list '* b1 b1)) (list '* (list '* h1 h1) (mfu-sq 'u1 x))) (lambda () (crs)))
                         (subst (list '= (list '+ (list '* a1 a1) (list '* b1 b1)) (list '* (list '* h1 h1) (mfu-sq 'u1 x))))
                         (subst (list '= (mfu-sq 'u1 x) 1)) (crs)))
            (dk-have! (list '= (list '* h2 h2) (list '+ (list '* a2 a2) (list '* b2 b2)))
              (lambda () (dk-have! (list '= (list '+ (list '* a2 a2) (list '* b2 b2)) (list '* (list '* h2 h2) (mfu-sq 'u2 x))) (lambda () (crs)))
                         (subst (list '= (list '+ (list '* a2 a2) (list '* b2 b2)) (list '* (list '* h2 h2) (mfu-sq 'u2 x))))
                         (subst (list '= (mfu-sq 'u2 x) 1)) (crs)))
            (subst (list '= (list '* h1 h1) (list '+ (list '* a1 a1) (list '* b1 b1))))
            (subst (list '= (list '* h2 h2) (list '+ (list '* a2 a2) (list '* b2 b2))))
