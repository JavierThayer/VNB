(define (mfr-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MFR OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mfr-find-if x)
  (cond ((not (pair? x)) #f)
        ((eq? (car x) 'IF) x)
        (#t (let loop ((xs x))
              (cond ((null? xs) #f)
                    ((not (pair? xs)) #f)
                    ((mfr-find-if (car xs)) => (lambda (r) r))
                    (#t (loop (cdr xs))))))))
(define (mfr-real! . ts) (for-each (lambda (t) (dk-type! t 'RR)) ts))
(define (mfr-ind a x) (list (list 'INDICATOR 'omega a) x))
(define (mfr-ind-val! a x k)
  (use-em (list 'IN x a)
    (lambda () (dk-cite! 'indicator-value-in 'omega a x) (k 1))
    (lambda () (dk-cite! 'indicator-value-out 'omega a x) (k 0))))
(define (mfr-sub-omega! a)
  (if (not (dk-asm? (list 'SUBSET a 'omega)))
      (begin
        (dk-cite! 'sigma-algebra-in-power-power 'omega 'ca)
        (dk-iff-fwd! (dk-cite! 'power-set-membership '(POWER omega) 'ca))
        (dk-apply! '(FORALL z (IMPLIES (IN z ca) (IN z (POWER omega)))) a)
        (dk-iff-fwd! (dk-cite! 'power-set-membership 'omega a))
        (dk-iff-bwd! (dk-cite! 'subset-def a 'omega)))))
(define (mfr-dreal d) (list 'FORALL 'rnx_ (list 'IMPLIES '(IN rnx_ omega) (list 'IN (list d 'rnx_) 'RR))))
(define (mfr-dens m d) (list 'FORALL 'rna_ (list 'IMPLIES '(IN rna_ ca)
                         (list '= (list m 'rna_) (list 'INTEGRAL 'omega 'ca 'rho (list 'PTWISE-ETIMES 'omega d '(INDICATOR omega rna_)))))))

;; ---------------------------------------------------------------------------
;; int_c (d1 - d2) d rho = m1(c) - m2(c)
(define mfr-Hc '(VNB-LAMBDA hx_ omega (* ((INDICATOR omega c) hx_) (- (d1 hx_) (d2 hx_)))))
(sp (make-wff (dk-foralls '(omega ca rho d1 d2 m1 m2 c)
  (dk-curry (list '(IS-MEASURE omega ca rho) '(IS-MEASURABLE-FN omega ca d1) '(IS-MEASURABLE-FN omega ca d2) (mfr-dreal 'd1) (mfr-dreal 'd2)
                  '(IS-FINITE-MEASURE omega ca m1) '(IS-FINITE-MEASURE omega ca m2) (mfr-dens 'm1 'd1) (mfr-dens 'm2 'd2) '(IN c ca))
    (list 'AND (list 'IS-INTEGRABLE 'omega 'ca 'rho mfr-Hc) (list '= (list 'RINTEGRAL 'omega 'ca 'rho mfr-Hc) '(- (m1 c) (m2 c))))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'rr-one-in)
(let* ((sig (dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measure '(IS-MEASURE omega ca rho)))
       (H mfr-Hc)
       (h1 '(PTWISE-ETIMES omega d1 (INDICATOR omega c)))
       (h2 '(PTWISE-ETIMES omega d2 (INDICATOR omega c)))
       (pt! (lambda (x)
              (for-each (lambda (d) (dk-apply! (mfr-dreal d) x)) '(d1 d2))
              (for-each (lambda (d) (dk-project! (list 'IN d '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'ca d))
                                    (dk-cite! 'fun-apply-type-c d 'omega 'RR-POS-STAR x) (dk-cite! 'rr-pos-star-nonneg (list d x)))
                        '(d1 d2))
              (dk-cite! 'indicator-real-measurable 'omega 'ca 'c)
              (dk-project! '(IN (INDICATOR omega c) (FUN omega RR)) 'is-real-measurable-fn '(IS-REAL-MEASURABLE-FN omega ca (INDICATOR omega c)))
              (dk-cite! 'fun-apply-type-c '(INDICATOR omega c) 'omega 'RR x)
              (mfr-real! (list '- (list 'd1 x) (list 'd2 x)))))
       (case! (lambda (x k)
                (mfr-ind-val! 'c x
                  (lambda (v)
                    (dk-have! (list '<= 0 v) (lambda () (dk-ineq!)))
                    (for-each (lambda (d) (dk-cite! 'etimes-real-defined (list d x) v) (dk-cite! 'bintimes-apply (list d x) v)
                                          (mfr-real! (list '* (list d x) v)))
                              '(d1 d2))
                    (k v))))))
  (dk-cite! 'measurable-fn-indicator 'omega 'ca 'c)
  (dk-cite! 'measurable-fn-etimes 'omega 'ca 'd1 '(INDICATOR omega c))
  (dk-cite! 'measurable-fn-etimes 'omega 'ca 'd2 '(INDICATOR omega c))
  (dk-cite! 'sigma-algebra-ambient-set 'omega 'ca)
  (dk-have! (list 'IN H '(FUN omega RR))
    (lambda () (dk-lam-type! (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                          (pt! x)
                                          (if (not (sequent-node-grounded? leaf)) (dk-type! (cadr (dk-goal)) 'RR)))))))
  (for-each
    (lambda (hh d)
      (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IN (list hh 'x) 'RR)))
        (lambda () (let ((x (dk-di-var!)))
                     (pt! x)
                     (mac 'PTWISE-ETIMES) (dk-lam-b!)
                     (case! x (lambda (v) (subst (list '= (mfr-ind 'c x) v))
                                          (subst (list '= (list 'etimes (list d x) v) (list 'bintimes (list d x) v)))
                                          (subst (list '== (list 'bintimes (list d x) v) (list '* (list d x) v)))
                                          (dk-ass!)))))))
    (list h1 h2) '(d1 d2))
  (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list '= (list H 'x) (list '- (list h1 'x) (list h2 'x)))))
    (lambda () (let ((x (dk-di-var!)))
                 (pt! x)
                 (dk-lam-b!) (mac 'PTWISE-ETIMES) (dk-lam-b!)
                 (case! x (lambda (v) (subst (list '= (mfr-ind 'c x) v))
                                      (for-each (lambda (d) (subst (list '= (list 'etimes (list d x) v) (list 'bintimes (list d x) v)))
                                                            (subst (list '== (list 'bintimes (list d x) v) (list '* (list d x) v))))
                                                '(d1 d2))
                                      (crs))))))
  (for-each
    (lambda (m d)
      (dk-split-all! (list (dk-iff-fwd! (dk-cite! 'is-finite-measure 'omega 'ca m))))
      (dk-cite! 'sigma-algebra-whole-in 'omega 'ca)
      (mfr-sub-omega! 'c)
      (dk-cite! 'measure-monotone 'omega 'ca m 'c 'omega)
      (dk-iff-parts! (dk-cite! 'is-measure 'omega 'ca m))
      (dk-cite! 'fun-apply-type-c m 'ca 'RR-POS-STAR 'c)
      (dk-have-and! (list 'IN (list m 'c) 'RR-POS-STAR) (list 'IN (list m 'omega) 'RR))
      (dk-cite! 'rr-pos-star-le-real-in-rr (list m 'c) (list m 'omega))
      (let ((e (dk-apply! (mfr-dens m d) 'c)))
        (dk-rewrite-h! (list 'IN (list m 'c) 'RR) (list m 'c) (caddr e))))
    '(m1 m2) '(d1 d2))
  (dk-split-all! (list (dk-cite! 'rintegral-decomposition 'omega 'ca 'rho H h1 h2)))
  (subst (dk-apply! (mfr-dens 'm1 'd1) 'c))
  (subst (dk-apply! (mfr-dens 'm2 'd2) 'c))
  (dk-conj-close! dk-ass!))
(mfr-qed! 'rintegral-diff-density)

;; the integral over a null set vanishes
(define mfr-F '(VNB-LAMBDA cix_ omega (* ((INDICATOR omega b) cix_) (g cix_))))
(sp (make-wff (dk-foralls '(omega ca mu b g) (dk-curry '((IS-MEASURE omega ca mu) (IN b ca) (= (mu b) 0) (IS-REAL-MEASURABLE-FN omega ca g))
  (list '= (list 'RINTEGRAL 'omega 'ca 'mu mfr-F) 0)))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'zero-in-rr-pos-star)
(let* ((sig (dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measure '(IS-MEASURE omega ca mu)))
       (F mfr-F) (Z '(VNB-LAMBDA cx_ omega 0)))
  (dk-cite! 'indicator-real-measurable 'omega 'ca 'b)
  (dk-cite! 'real-measurable-mul 'omega 'ca '(INDICATOR omega b) 'g)
  (dk-iff-parts! (dk-cite! 'is-real-measurable-fn 'omega 'ca F))
  (dk-cite! 'measurable-fn-const 'omega 'ca 0)
  (dk-project! '(IN g (FUN omega RR)) 'is-real-measurable-fn '(IS-REAL-MEASURABLE-FN omega ca g))
  (subst (dk-cite! 'rintegral-unfold 'omega 'ca 'mu F))
  (for-each
    (lambda (part)
      (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'NOT (list 'IN 'x 'b)) (list '= (list (list part 'omega F) 'x) (list Z 'x)))))
        (lambda ()
          (let ((x (dk-di-var!)))
            (di)
            (dk-cite! 'fun-apply-type-c 'g 'omega 'RR x)
            (dk-cite! 'indicator-value-out 'omega 'b x)
            (mac part)
            (dk-lam-b!)
            (subst (list '= (mfr-ind 'b x) 0))
            (dk-have! (list '= (list '* 0 (list 'g x)) 0) (lambda () (crs)))
            (subst (list '= (list '* 0 (list 'g x)) 0))
            (dk-case-if! (mfr-find-if (dk-goal)) (lambda (t v) (if (dk-contains? (dk-goal) '(- 0)) (crs) (rfl)))))))
      (subst (dk-cite! 'integral-ae-eq 'omega 'ca 'mu 'b (list part 'omega F) Z)))
    '(POS-PART NEG-PART))
  (subst (dk-cite! 'integral-zero-fn 'omega 'ca 'mu))
  (crs))
(mfr-qed! 'rintegral-null-support)

;; ---------------------------------------------------------------------------
;; an integrable function whose integral over every measurable set vanishes is zero almost everywhere
(define (mfr-fb b) (list 'VNB-LAMBDA 'rx_ 'omega (list '* '(f rx_) (list (list 'INDICATOR 'omega b) 'rx_))))
(define mfr-zs (list 'FORALL 'bb_ (list 'IMPLIES '(IN bb_ ca) (list '= (list 'RINTEGRAL 'omega 'ca 'rho (mfr-fb 'bb_)) 0))))
(define mfr-g '(VNB-LAMBDA sx_ omega (* (- 1) (f sx_))))
(sp (make-wff (dk-foralls '(omega ca rho f) (dk-curry (list '(IS-MEASURE omega ca rho) '(IS-INTEGRABLE omega ca rho f) mfr-zs)
  '(IS-NULL-SET omega ca rho (SEP nzx_ omega (NOT (= (f nzx_) 0))))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'rr-one-in) (dk-cite! 'rr-neg-closed 1)
(let* ((sig (dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measure '(IS-MEASURE omega ca rho)))
       (ip (dk-iff-parts! (dk-cite! 'is-integrable 'omega 'ca 'rho 'f)))
       (fr (dk-project! '(IN f (FUN omega RR)) 'is-real-measurable-fn '(IS-REAL-MEASURABLE-FN omega ca f)))
       (g mfr-g))
  ;; f >= 0 on sets, so {f < 0} is null
  (dk-have! (list 'FORALL 'aa (list 'IMPLIES '(IN aa ca) (list '<= 0 (list 'RINTEGRAL 'omega 'ca 'rho (mfr-fb 'aa)))))
    (lambda () (let ((a (dk-di-var!))) (subst (dk-apply! mfr-zs a)) (dk-ineq!))))
  (dk-cite! 'rintegral-nonneg-on-sets-null 'omega 'ca 'rho 'f)
  ;; -f
  (dk-split-all! (list (dk-cite! 'rintegral-scale 'omega 'ca 'rho 'f '(- 1))))
  (dk-iff-parts! (dk-cite! 'is-integrable 'omega 'ca 'rho g))
  (dk-project! (list 'IN g '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca g))
  (dk-have! (list 'FORALL 'aa (list 'IMPLIES '(IN aa ca)
              (list '<= 0 (list 'RINTEGRAL 'omega 'ca 'rho (list 'VNB-LAMBDA 'rx_ 'omega (list '* (list g 'rx_) '((INDICATOR omega aa) rx_)))))))
    (lambda ()
      (let* ((a (dk-di-var!))
             (fa (mfr-fb a))
             (ga (list 'VNB-LAMBDA 'rx_ 'omega (list '* (list g 'rx_) (list (list 'INDICATOR 'omega a) 'rx_))))
             (sfa (list 'VNB-LAMBDA 'sx_ 'omega (list '* '(- 1) (list fa 'sx_)))))
        (dk-split-all! (list (dk-cite! 'rintegral-restrict 'omega 'ca 'rho 'f a)))
        (dk-split-all! (list (dk-cite! 'rintegral-scale 'omega 'ca 'rho fa '(- 1))))
        (dk-iff-parts! (dk-cite! 'is-integrable 'omega 'ca 'rho fa))
        (dk-iff-parts! (dk-cite! 'is-integrable 'omega 'ca 'rho sfa))
        (dk-project! (list 'IN fa '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca fa))
        (dk-cite! 'indicator-real-measurable 'omega 'ca a)
        (dk-project! (list 'IN (list 'INDICATOR 'omega a) '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca (list 'INDICATOR 'omega a)))
        (dk-cite! 'sigma-algebra-ambient-set 'omega 'ca)
        (dk-have! (list 'IN ga '(FUN omega RR))
          (lambda () (dk-lam-type! (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                                (dk-cite! 'fun-apply-type-c g 'omega 'RR x)
                                                (dk-cite! 'fun-apply-type-c (list 'INDICATOR 'omega a) 'omega 'RR x)
                                                (dk-lam-b-h! (dk-ctx-form (list 'IN (list g x) 'RR)))
                                                (if (not (sequent-node-grounded? leaf)) (dk-type! (cadr (dk-goal)) 'RR)))))))
        (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list '= (list ga 'x) (list sfa 'x))))
          (lambda () (let ((x (dk-di-var!)))
                       (dk-cite! 'fun-apply-type-c 'f 'omega 'RR x)
                       (dk-cite! 'fun-apply-type-c (list 'INDICATOR 'omega a) 'omega 'RR x)
                       (dk-lam-b!)
                       (crs))))
        (dk-project! (list 'IN sfa '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca sfa))
        (subst (dk-cite! 'rintegral-congruence 'omega 'ca 'rho ga sfa))
        (subst (list '= (list 'RINTEGRAL 'omega 'ca 'rho sfa) (list '* '(- 1) (list 'RINTEGRAL 'omega 'ca 'rho fa))))
        (subst (dk-apply! mfr-zs a))
        (dk-have! '(= (* (- 1) 0) 0) (lambda () (crs)))
        (subst '(= (* (- 1) 0) 0))
        (dk-ineq!))))
  (dk-cite! 'rintegral-nonneg-on-sets-null 'omega 'ca 'rho g)
  (let ((n1 '(SEP nx_ omega (< (f nx_) 0)))
        (n2 (list 'SEP 'nx_ 'omega (list '< (list g 'nx_) 0)))
        (nz '(SEP nzx_ omega (NOT (= (f nzx_) 0)))))
    (dk-cite! 'ae-null-union 'omega 'ca 'rho n1 n2)
    (dk-have! (list 'SUBSET nz (list 'UNION n1 n2))
      (lambda ()
        (let ((w (subset-by-element!)))
          (dk-sep-parts! (list 'IN w nz))
          (dk-cite! 'fun-apply-type-c 'f 'omega 'RR w)
          (mac 'union-membership)
          (dk-or-each! (dk-cite! 'rr-lt-trichotomy (list 'f w) 0)
            (lambda (d)
              (cond ((equal? d (list '= (list 'f w) 0)) (ai (list 'NOT d)))
                    ((equal? d (list '< (list 'f w) 0)) (oi-l) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!))))
                    (#t (oi-r)
                        (in-sep! (lambda () (dk-ass!))
                                 (lambda () (dk-lam-b!) (dk-ineq! (list '< 0 (list 'f w)) (list 'IN (list 'f w) 'RR)))))))))))
    (let* ((un (list 'UNION n1 n2))
           (iff (dk-cite! 'is-null-set 'omega 'ca 'rho un))
           (ex (begin (dk-iff-fwd! iff) (dk-pick (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z un))) "the null cover")))
           (nl (dk-skolem! ex)))
      (dk-cite! 'subset-trans nz un nl)
      (mac 'is-null-set)
      (ew nl)
      (dk-conj-close! dk-ass!))))
(mfr-qed! 'rintegral-zero-on-sets-null)

;; ---------------------------------------------------------------------------
;; |nu|(X) is finite: pp <= d1 + d2 + d3 + d4 and the four integrals are finite
(define (mfr-ptw body) (list 'FORALL 'x (list 'IMPLIES '(IN x omega) body)))
(define (mfr-e d) (list 'PTWISE-ETIMES 'omega d '(INDICATOR omega omega)))
(sp (make-wff (dk-foralls '(omega ca rho pp d1 d2 d3 d4 m1 m2 m3 m4)
  (dk-curry (append (list '(IS-MEASURE omega ca rho) '(IS-MEASURABLE-FN omega ca pp) (mfr-dreal 'pp))
                    (map (lambda (d) (list 'IS-MEASURABLE-FN 'omega 'ca d)) '(d1 d2 d3 d4))
                    (map mfr-dreal '(d1 d2 d3 d4))
                    (map (lambda (m) (list 'IS-FINITE-MEASURE 'omega 'ca m)) '(m1 m2 m3 m4))
                    (map mfr-dens '(m1 m2 m3 m4) '(d1 d2 d3 d4))
                    (list (mfr-ptw '(<= (pp x) (+ (+ (d1 x) (d2 x)) (+ (d3 x) (d4 x)))))))
    (list 'IN (list 'INTEGRAL 'omega 'ca 'rho (mfr-e 'pp)) 'RR)))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'rr-one-in) (fact 'zero-in-rr-pos-star)
(let* ((sig (dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measure '(IS-MEASURE omega ca rho)))
       (e12 (list 'PTWISE-EPLUS 'omega (mfr-e 'd1) (mfr-e 'd2)))
       (e34 (list 'PTWISE-EPLUS 'omega (mfr-e 'd3) (mfr-e 'd4)))
       (ee (list 'PTWISE-EPLUS 'omega e12 e34))
       (I (lambda (f) (list 'INTEGRAL 'omega 'ca 'rho f)))
       (rr-eplus! (lambda (u v)        ; u, v real, nonneg: (= (eplus u v) (+ u v)) and the sum typed
                    (dk-cite! 'eplus-real-defined u v) (dk-cite! 'binplus-apply u v)
                    (dk-have-and! (list 'IN u 'RR) (list 'IN v 'RR)) (dk-cite! 'rr-add-closed u v)
                    (dk-have! (list '= (list 'eplus u v) (list '+ u v))
                      (lambda () (subst (list '= (list 'eplus u v) (list 'binplus u v))) (subst (list '== (list 'binplus u v) (list '+ u v))) (rfl))))))
  (dk-cite! 'sigma-algebra-whole-in 'omega 'ca)
  (dk-cite! 'measurable-fn-indicator 'omega 'ca 'omega)
  (for-each (lambda (d) (dk-cite! 'measurable-fn-etimes 'omega 'ca d '(INDICATOR omega omega))) '(pp d1 d2 d3 d4))
  (dk-cite! 'measurable-fn-eplus 'omega 'ca (mfr-e 'd1) (mfr-e 'd2))
  (dk-cite! 'measurable-fn-eplus 'omega 'ca (mfr-e 'd3) (mfr-e 'd4))
  (dk-cite! 'measurable-fn-eplus 'omega 'ca e12 e34)
  ;; the four integrals: m_j(X), real and nonnegative
  (for-each
    (lambda (m d)
      (dk-split-all! (list (dk-iff-fwd! (dk-cite! 'is-finite-measure 'omega 'ca m))))
      (let ((e (dk-apply! (mfr-dens m d) 'omega)))
        (dk-rewrite-h! (list 'IN (list m 'omega) 'RR) (list m 'omega) (caddr e)))
      (dk-cite! 'integral-in 'omega 'ca 'rho (mfr-e d))
      (dk-cite! 'rr-pos-star-nonneg (I (mfr-e d))))
    '(m1 m2 m3 m4) '(d1 d2 d3 d4))
  (let ((Ij (lambda (d) (I (mfr-e d)))))
    (dk-cite! 'integral-additive 'omega 'ca 'rho (mfr-e 'd1) (mfr-e 'd2))
    (dk-cite! 'integral-additive 'omega 'ca 'rho (mfr-e 'd3) (mfr-e 'd4))
    (dk-cite! 'integral-additive 'omega 'ca 'rho e12 e34)
    (rr-eplus! (Ij 'd1) (Ij 'd2)) (rr-eplus! (Ij 'd3) (Ij 'd4))
    (let ((s12 (list '+ (Ij 'd1) (Ij 'd2))) (s34 (list '+ (Ij 'd3) (Ij 'd4))))
      (dk-have! (list '= (I e12) s12) (lambda () (subst (list '= (I e12) (list 'eplus (Ij 'd1) (Ij 'd2)))) (subst (list '= (list 'eplus (Ij 'd1) (Ij 'd2)) s12)) (rfl)))
      (dk-have! (list '= (I e34) s34) (lambda () (subst (list '= (I e34) (list 'eplus (Ij 'd3) (Ij 'd4)))) (subst (list '= (list 'eplus (Ij 'd3) (Ij 'd4)) s34)) (rfl)))
      (dk-have! (list '<= 0 s12) (lambda () (dk-ineq! (list '<= 0 (Ij 'd1)) (list '<= 0 (Ij 'd2)) (list 'IN (Ij 'd1) 'RR) (list 'IN (Ij 'd2) 'RR))))
      (dk-have! (list '<= 0 s34) (lambda () (dk-ineq! (list '<= 0 (Ij 'd3)) (list '<= 0 (Ij 'd4)) (list 'IN (Ij 'd3) 'RR) (list 'IN (Ij 'd4) 'RR))))
      (rr-eplus! s12 s34)
      (dk-have! (list 'IN (I ee) 'RR)
        (lambda () (subst (list '= (I ee) (list 'eplus (I e12) (I e34)))) (subst (list '= (I e12) s12)) (subst (list '= (I e34) s34))
                   (subst (list '= (list 'eplus s12 s34) (list '+ s12 s34))) (dk-ass!)))))
  ;; pointwise: pp 1_X <= the sum
  (dk-have! (list 'PTWISE-LE 'omega (mfr-e 'pp) ee)
    (lambda ()
      (mac 'ptwise-le)
      (let ((x (dk-di-var!)))
        (dk-cite! 'indicator-value-in 'omega 'omega x)
        (for-each (lambda (d) (dk-apply! (mfr-dreal d) x)
                              (dk-project! (list 'IN d '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'ca d))
                              (dk-cite! 'fun-apply-type-c d 'omega 'RR-POS-STAR x) (dk-cite! 'rr-pos-star-nonneg (list d x)))
                  '(pp d1 d2 d3 d4))
        (subst (dk-cite! 'ptwise-etimes-value-q 'omega 'pp '(INDICATOR omega omega) x))
        (subst (dk-cite! 'ptwise-eplus-value-q 'omega e12 e34 x))
        (subst (dk-cite! 'ptwise-eplus-value-q 'omega (mfr-e 'd1) (mfr-e 'd2) x))
        (subst (dk-cite! 'ptwise-eplus-value-q 'omega (mfr-e 'd3) (mfr-e 'd4) x))
        (for-each (lambda (d) (subst (dk-cite! 'ptwise-etimes-value-q 'omega d '(INDICATOR omega omega) x))) '(d1 d2 d3 d4))
        (subst (list '= (list (list 'INDICATOR 'omega 'omega) x) 1))
        (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
        (for-each (lambda (d)
                    (let ((dx (list d x)))
                      (subst (dk-cite! 'etimes-real-defined dx 1))
                      (subst (dk-cite! 'bintimes-apply dx 1))
                      (dk-have! (list '= (list '* dx 1) dx) (lambda () (crs)))
                      (subst (list '= (list '* dx 1) dx))))
                  '(pp d1 d2 d3 d4))
        (rr-eplus! (list 'd1 x) (list 'd2 x)) (rr-eplus! (list 'd3 x) (list 'd4 x))
        (subst (list '= (list 'eplus (list 'd1 x) (list 'd2 x)) (list '+ (list 'd1 x) (list 'd2 x))))
        (subst (list '= (list 'eplus (list 'd3 x) (list 'd4 x)) (list '+ (list 'd3 x) (list 'd4 x))))
        (let ((s12 (list '+ (list 'd1 x) (list 'd2 x))) (s34 (list '+ (list 'd3 x) (list 'd4 x))))
          (dk-have! (list '<= 0 s12) (lambda () (dk-ineq! (list '<= 0 (list 'd1 x)) (list '<= 0 (list 'd2 x)) (list 'IN (list 'd1 x) 'RR) (list 'IN (list 'd2 x) 'RR))))
          (dk-have! (list '<= 0 s34) (lambda () (dk-ineq! (list '<= 0 (list 'd3 x)) (list '<= 0 (list 'd4 x)) (list 'IN (list 'd3 x) 'RR) (list 'IN (list 'd4 x) 'RR))))
          (rr-eplus! s12 s34)
          (subst (list '= (list 'eplus s12 s34) (list '+ s12 s34))))
        (dk-apply! (mfr-ptw '(<= (pp x) (+ (+ (d1 x) (d2 x)) (+ (d3 x) (d4 x))))) x)
        (dk-ass!))))
  (dk-cite! 'integral-monotone 'omega 'ca 'rho (mfr-e 'pp) ee)
  (dk-cite! 'integral-in 'omega 'ca 'rho (mfr-e 'pp))
  (dk-have-and! (list 'IN (I (mfr-e 'pp)) 'RR-POS-STAR) (list 'IN (I ee) 'RR))
  (dk-cite! 'rr-pos-star-le-real-in-rr (I (mfr-e 'pp)) (I ee))
  (dk-ass!))
(mfr-qed! 'polar-total-finite)

  

