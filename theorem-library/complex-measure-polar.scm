      (eqp! m2 ff)
      (dk-cite! 'real-measurable-ptwise-eq 'omega 'ca m2 ff))
    ;; ff is dominated by h
    (dk-cite! 'density-integrable 'omega 'ca 'rho 'mu 'h)
    (dk-have! (list 'FORALL 'dx_ (list 'IMPLIES '(IN dx_ omega) (list '<= (list 'abs (list ff 'dx_)) '(abs (h dx_)))))
      (lambda () (let ((x (dk-di-var!)))
                   (pt! x)
                   (dk-lam-b!)
                   (let ((q (list '* (mfu-ind 'a x) (list part (list 'u x)))) (p (list part (list 'u x))))
                     (dk-apply! (mfu-ptw '(= (magnitude (u x)) 1)) x)
                     (dk-split-all! (list (dk-cite! 'unit-parts-bound (list 'u x))))
                     (dk-cite! 'rr-abs-closed p)
                     (dk-have! (list '<= (list 'abs q) 1)
                       (lambda ()
                         (dk-cite! 'indicator-real-measurable 'omega 'ca 'a)
                         (mfu-ind-val! 'a x
                           (lambda (v)
                             (subst (list '= (mfu-ind 'a x) v))
                             (dk-have! (list '= (list '* v p) (if (eqv? v 1) p 0)) (lambda () (crs)))
                             (subst (list '= (list '* v p) (if (eqv? v 1) p 0)))
                             (if (eqv? v 1) (dk-ass!)
                                 (begin (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
                                        (subst (dk-cite! 'rr-abs-of-nonneg 0)) (dk-ineq!)))))))
                     (mfu-real! q)
                     (dk-cite! 'abs-mul-le-unit (list 'h x) q)
                     (dk-ass!)))))
    (dk-project! '(IN h (FUN omega RR-POS-STAR)) 'is-measurable-fn '(IS-MEASURABLE-FN omega ca h))
    (dk-cite! 'integrable-dominated 'omega 'ca 'rho ff 'h)
    (eqp! lf gf)
    (dk-cite! 'rintegral-congruence 'omega 'ca 'mu lf gf)
    (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list '= (list ff 'x) (list '* '(h x) (list gf 'x)))))
      (lambda () (let ((x (dk-di-var!))) (pt! x) (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl)))))
    (dk-cite! 'rintegral-density-hyp 'omega 'ca 'rho 'mu 'h gf ff)
    (dk-iff-parts! (dk-cite! 'is-integrable 'omega 'ca 'rho ff))
    (dk-cite! 'rintegral-in-rr 'omega 'ca 'rho ff)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (subst (list '== (list 'RINTEGRAL 'omega 'ca 'mu lf) (list 'RINTEGRAL 'omega 'ca 'mu gf)))
              (subst (list '= (list 'RINTEGRAL 'omega 'ca 'mu gf) (list 'RINTEGRAL 'omega 'ca 'rho ff)))
              (rfl))))))
  )
  name)
  (topic! name 'analysis))
