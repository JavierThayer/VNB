;; four finite measures lie below one finite measure
(define (mfm-le m) (list 'FORALL 'a_ (list 'IMPLIES '(IN a_ ca) (list '<= (list m 'a_) '(rho_ a_)))))
(sp (make-wff (dk-foralls '(omega ca m1 m2 m3 m4)
  (dk-curry '((IS-FINITE-MEASURE omega ca m1) (IS-FINITE-MEASURE omega ca m2) (IS-FINITE-MEASURE omega ca m3) (IS-FINITE-MEASURE omega ca m4))
    (list 'FORSOME 'rho_ (dk-and (list '(IS-FINITE-MEASURE omega ca rho_) (mfm-le 'm1) (mfm-le 'm2) (mfm-le 'm3) (mfm-le 'm4))))))))
(dk-peel!)
(let* ((fin (lambda (m) (dk-split-all! (list (dk-iff-fwd! (dk-cite! 'is-finite-measure 'omega 'ca m))))
                        (dk-iff-parts! (dk-cite! 'is-measure 'omega 'ca m))))
       (r12 '(VNB-LAMBDA rsa_ ca (eplus (m1 rsa_) (m2 rsa_))))
       (r34 '(VNB-LAMBDA rsa_ ca (eplus (m3 rsa_) (m4 rsa_))))
       (rr (list 'VNB-LAMBDA 'rsa_ 'ca (list 'eplus (list r12 'rsa_) (list r34 'rsa_))))
       (ty! (lambda (a) (for-each (lambda (m) (dk-cite! 'fun-apply-type-c m 'ca 'RR-POS-STAR a)) '(m1 m2 m3 m4))
                        (dk-have-and! (list 'IN (list 'm1 a) 'RR-POS-STAR) (list 'IN (list 'm2 a) 'RR-POS-STAR)) (dk-cite! 'eplus-closed (list 'm1 a) (list 'm2 a))
                        (dk-have-and! (list 'IN (list 'm3 a) 'RR-POS-STAR) (list 'IN (list 'm4 a) 'RR-POS-STAR)) (dk-cite! 'eplus-closed (list 'm3 a) (list 'm4 a))
                        (let ((e1 (list 'eplus (list 'm1 a) (list 'm2 a))) (e2 (list 'eplus (list 'm3 a) (list 'm4 a))))
                          (dk-have-and! (list 'IN e1 'RR-POS-STAR) (list 'IN e2 'RR-POS-STAR)) (dk-cite! 'eplus-closed e1 e2)))))
  (for-each fin '(m1 m2 m3 m4))
  (dk-cite! 'measure-sum 'omega 'ca 'm1 'm2)
  (dk-cite! 'measure-sum 'omega 'ca 'm3 'm4)
  (dk-cite! 'measure-sum 'omega 'ca r12 r34)
  (dk-cite! 'sigma-algebra-whole-in 'omega 'ca)
  (ew rr)
  (dk-conj-close!
    (lambda ()
      (let ((gl (dk-goal)))
        (if (dk-head-is? gl 'IS-FINITE-MEASURE)
            (begin
              (mac 'is-finite-measure)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin
                        (ty! 'omega)
                        (dk-lam-b!)
                        (let ((ps (lambda (u v) (dk-cite! 'rr-pos-star-nonneg u) (dk-cite! 'rr-pos-star-nonneg v)
                                                (dk-cite! 'eplus-real-defined u v) (dk-cite! 'binplus-apply u v)
                                                (dk-have-and! (list 'IN u 'RR) (list 'IN v 'RR)) (dk-cite! 'rr-add-closed u v)
                                                (let ((thunk (lambda () (subst (list '= (list 'eplus u v) (list 'binplus u v))) (subst (list '== (list 'binplus u v) (list '+ u v))) (dk-ass!))))
                                                  (if (equal? (dk-goal) (list 'IN (list 'eplus u v) 'RR))
                                                      (thunk)
                                                      (dk-have! (list 'IN (list 'eplus u v) 'RR) thunk))))))
                          (ps '(m1 omega) '(m2 omega)) (ps '(m3 omega) '(m4 omega))
                          (ps '(eplus (m1 omega) (m2 omega)) '(eplus (m3 omega) (m4 omega)))))))))
            (let* ((a (dk-di-var!)) (m (car (cadr (dk-goal)))))
              (ty! a)
              (dk-lam-b!)
              (let* ((e1 (list 'eplus (list 'm1 a) (list 'm2 a))) (e2 (list 'eplus (list 'm3 a) (list 'm4 a))) (e (list 'eplus e1 e2))
                     (inner (if (memq m '(m1 m2)) e1 e2))
                     (le-trans (lambda (x y z) (dk-have-and! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR) (list 'IN z 'RR-POS-STAR))
                                                 (dk-have-and! (list '<= x y) (list '<= y z)) (dk-cite! 'rr-pos-star-le-trans x y z))))
                (dk-have-and! (list 'IN e1 'RR-POS-STAR) (list 'IN e2 'RR-POS-STAR))
                (dk-cite! 'eplus-le-left e1 e2) (dk-cite! 'eplus-comm e1 e2)
                (dk-have-and! (list 'IN e2 'RR-POS-STAR) (list 'IN e1 'RR-POS-STAR))
                (dk-cite! 'eplus-le-left e2 e1)
                (dk-rewrite-h! (list '<= e2 (list 'eplus e2 e1)) (list 'eplus e2 e1) e)
                (let* ((u (list (if (memq m '(m1 m3)) (if (eq? m 'm1) 'm1 'm3) (if (eq? m 'm2) 'm2 'm4)) a))
                       (o (list (cdr (assq m '((m1 . m2) (m2 . m1) (m3 . m4) (m4 . m3)))) a)))
                  (dk-have-and! (list 'IN u 'RR-POS-STAR) (list 'IN o 'RR-POS-STAR))
                  (dk-cite! 'eplus-le-left u o) (dk-cite! 'eplus-comm u o)
                  (dk-have-and! (list 'IN o 'RR-POS-STAR) (list 'IN u 'RR-POS-STAR))
                  (dk-cite! 'eplus-le-left o u)
                  (if (memq m '(m2 m4)) (dk-rewrite-h! (list '<= u (list 'eplus u o)) (list 'eplus u o) inner))
                  (le-trans u inner e)
                  (dk-ass!)))))))))
(mfm-qed! 'four-finite-measures-below)

;; ---------------------------------------------------------------------------
;; the real part of the polar formula: int_a ru d|nu| = m1(a) - m2(a)
(define (mfm-ptw body) (list 'FORALL 'x (list 'IMPLIES '(IN x omega) body)))
(define (mfm-dreal d) (list 'FORALL 'rnx_ (list 'IMPLIES '(IN rnx_ omega) (list 'IN (list d 'rnx_) 'RR))))
(define (mfm-dens m d) (list 'FORALL 'rna_ (list 'IMPLIES '(IN rna_ ca)
                         (list '= (list m 'rna_) (list 'INTEGRAL 'omega 'ca 'rho (list 'PTWISE-ETIMES 'omega d '(INDICATOR omega rna_)))))))
(define mfm-G '(VNB-LAMBDA cix_ omega (* ((INDICATOR omega a) cix_) (ru cix_))))
(sp (make-wff (dk-foralls '(omega ca rho pp ru d1 d2 m1 m2 a)
  (dk-curry (list '(IS-MEASURE omega ca rho) '(IS-MEASURABLE-FN omega ca pp) (mfm-dreal 'pp) '(IS-REAL-MEASURABLE-FN omega ca ru)
                  '(IS-MEASURABLE-FN omega ca d1) '(IS-MEASURABLE-FN omega ca d2) (mfm-dreal 'd1) (mfm-dreal 'd2)
                  '(IS-FINITE-MEASURE omega ca m1) '(IS-FINITE-MEASURE omega ca m2) (mfm-dens 'm1 'd1) (mfm-dens 'm2 'd2)
                  (mfm-ptw '(= (* (pp x) (ru x)) (- (d1 x) (d2 x)))) '(IN a ca))
    (list '= (list 'RINTEGRAL 'omega 'ca mfm-TV mfm-G) '(- (m1 a) (m2 a)))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'rr-one-in)
(let* ((sig (dk-project! '(IS-SIGMA-ALGEBRA omega ca) 'is-measure '(IS-MEASURE omega ca rho)))
       (G mfm-G)
       (H '(VNB-LAMBDA hx_ omega (* ((INDICATOR omega a) hx_) (- (d1 hx_) (d2 hx_)))))
       (h1 '(PTWISE-ETIMES omega d1 (INDICATOR omega a)))
       (h2 '(PTWISE-ETIMES omega d2 (INDICATOR omega a)))
       (pt! (lambda (x)
              (for-each (lambda (d) (dk-apply! (mfm-dreal d) x)) '(pp d1 d2))
              (for-each (lambda (d) (dk-project! (list 'IN d '(FUN omega RR-POS-STAR)) 'is-measurable-fn (list 'IS-MEASURABLE-FN 'omega 'ca d))
                                    (dk-cite! 'fun-apply-type-c d 'omega 'RR-POS-STAR x) (dk-cite! 'rr-pos-star-nonneg (list d x)))
                        '(pp d1 d2))
              (dk-project! '(IN ru (FUN omega RR)) 'is-real-measurable-fn '(IS-REAL-MEASURABLE-FN omega ca ru))
              (dk-cite! 'fun-apply-type-c 'ru 'omega 'RR x)
              (dk-cite! 'indicator-real-measurable 'omega 'ca 'a)
              (dk-project! '(IN (INDICATOR omega a) (FUN omega RR)) 'is-real-measurable-fn '(IS-REAL-MEASURABLE-FN omega ca (INDICATOR omega a)))
              (dk-cite! 'fun-apply-type-c '(INDICATOR omega a) 'omega 'RR x)
              (mfm-real! (list '- (list 'd1 x) (list 'd2 x)) (list '* (mfm-ind 'a x) (list 'ru x))
                         (list '* (mfm-ind 'a x) (list '- (list 'd1 x) (list 'd2 x))))))
       (case! (lambda (x k)          ; the indicator value v at x, the etimes reduced: k gets v
                (mfm-ind-val! 'a x
                  (lambda (v)
                    (dk-have! (list '<= 0 v) (lambda () (dk-ineq!)))
                    (for-each (lambda (d) (dk-cite! 'etimes-real-defined (list d x) v) (dk-cite! 'bintimes-apply (list d x) v)
                                          (mfm-real! (list '* (list d x) v)))
                              '(d1 d2))
                    (k v))))))
  (dk-cite! 'measurable-fn-indicator 'omega 'ca 'a)
  (dk-cite! 'measurable-fn-etimes 'omega 'ca 'd1 '(INDICATOR omega a))
  (dk-cite! 'measurable-fn-etimes 'omega 'ca 'd2 '(INDICATOR omega a))
  (dk-cite! 'indicator-real-measurable 'omega 'ca 'a)
  (dk-cite! 'real-measurable-mul 'omega 'ca '(INDICATOR omega a) 'ru)
  (dk-cite! 'sigma-algebra-ambient-set 'omega 'ca)
  (dk-have! (list 'IN H '(FUN omega RR))
    (lambda () (dk-lam-type! (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                          (pt! x)
                                          (if (not (sequent-node-grounded? leaf)) (dk-ass!)))))))
  (for-each
    (lambda (hh d)
      (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IN (list hh 'x) 'RR)))
        (lambda () (let ((x (dk-di-var!)))
                     (pt! x)
                     (mac 'PTWISE-ETIMES) (dk-lam-b!)
                     (case! x (lambda (v) (subst (list '= (mfm-ind 'a x) v))
                                          (subst (list '= (list 'etimes (list d x) v) (list 'bintimes (list d x) v)))
                                          (subst (list '== (list 'bintimes (list d x) v) (list '* (list d x) v)))
                                          (dk-ass!)))))))
    (list h1 h2) '(d1 d2))
  (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list '= (list H 'x) (list '- (list h1 'x) (list h2 'x)))))
    (lambda () (let ((x (dk-di-var!)))
                 (pt! x)
                 (dk-lam-b!) (mac 'PTWISE-ETIMES) (dk-lam-b!)
                 (case! x (lambda (v) (subst (list '= (mfm-ind 'a x) v))
                                      (for-each (lambda (d) (subst (list '= (list 'etimes (list d x) v) (list 'bintimes (list d x) v)))
                                                            (subst (list '== (list 'bintimes (list d x) v) (list '* (list d x) v))))
                                                '(d1 d2))
                                      (crs))))))
  ;; the two integrals are m1(a), m2(a): finite
  (for-each
    (lambda (m d)
      (dk-split-all! (list (dk-iff-fwd! (dk-cite! 'is-finite-measure 'omega 'ca m))))
      (dk-cite! 'sigma-algebra-whole-in 'omega 'ca)
      (mfm-sub-omega! 'a)
      (dk-cite! 'measure-monotone 'omega 'ca m 'a 'omega)
      (dk-iff-parts! (dk-cite! 'is-measure 'omega 'ca m))
      (dk-cite! 'fun-apply-type-c m 'ca 'RR-POS-STAR 'a)
      (dk-have-and! (list 'IN (list m 'a) 'RR-POS-STAR) (list 'IN (list m 'omega) 'RR))
      (dk-cite! 'rr-pos-star-le-real-in-rr (list m 'a) (list m 'omega))
      (let ((e (dk-apply! (mfm-dens m d) 'a)))
        (dk-rewrite-h! (list 'IN (list m 'a) 'RR) (list m 'a) (caddr e))))
    '(m1 m2) '(d1 d2))
  (dk-split-all! (list (dk-cite! 'rintegral-decomposition 'omega 'ca 'rho H h1 h2)))
  (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list '= (list H 'x) (list '* '(pp x) (list G 'x)))))
    (lambda () (let ((x (dk-di-var!)))
                 (pt! x)
                 (dk-lam-b!)
                 (let ((c (mfm-ind 'a x)))
                   (dk-have! (list '= (list '* (list 'pp x) (list '* c (list 'ru x))) (list '* c (list '* (list 'pp x) (list 'ru x))))
                     (lambda () (crs)))
                   (subst (list '= (list '* (list 'pp x) (list '* c (list 'ru x))) (list '* c (list '* (list 'pp x) (list 'ru x)))))
                   (subst (dk-apply! (mfm-ptw '(= (* (pp x) (ru x)) (- (d1 x) (d2 x)))) x))
                   (rfl)))))
  (subst (dk-cite! 'rintegral-density 'omega 'ca 'rho 'pp G H))
  (subst (list '= (list 'RINTEGRAL 'omega 'ca 'rho H) (list '- (list 'INTEGRAL 'omega 'ca 'rho h1) (list 'INTEGRAL 'omega 'ca 'rho h2))))
  (subst (dk-apply! (mfm-dens 'm1 'd1) 'a))
  (subst (dk-apply! (mfm-dens 'm2 'd2) 'a))
  (rfl))
(mfm-qed! 'polar-real-part)

  

