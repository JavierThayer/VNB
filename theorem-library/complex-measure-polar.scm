;; re = d1 - d2, im = d3 - d4
(define (mfz-diff! role da db)
  (let* ((ab (dk-abstract! 'omega 'RR (lambda (x) (list '- (list (mfz-n da) x) (list (mfz-n db) x)))
                           (lambda (x) (dk-apply! (mfz-s (mfz-dreal da)) x) (dk-apply! (mfz-s (mfz-dreal db)) x)
                                       (mfz-real! (list '- (list (mfz-n da) x) (list (mfz-n db) x))))))
         (g (car ab)) (ve (cdr ab))
         (lam (list 'VNB-LAMBDA 'sx_ 'omega (list '- (list (mfz-n da) 'sx_) (list (mfz-n db) 'sx_)))))
    (mfz-name! role g)
    (mfz-name! (if (eq? role 're) 're-ve 'im-ve) ve)
    (mfz-cite! 'real-measurable-sub 'omega 'ca da db)
    (dk-project! (list 'IN lam '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca lam))
    (dk-have! (list 'FORALL 'ex_ (list 'IMPLIES '(IN ex_ omega) (list '= (list lam 'ex_) (list g 'ex_))))
      (lambda () (let ((x (dk-di-var!)))
                   (dk-apply! (mfz-s (mfz-dreal da)) x) (dk-apply! (mfz-s (mfz-dreal db)) x)
                   (mfz-real! (list '- (list (mfz-n da) x) (list (mfz-n db) x)))
                   (dk-lam-b!)
                   (subst (dk-apply! ve x))
                   (rfl))))
    (dk-cite! 'real-measurable-ptwise-eq 'omega 'ca lam g)))
