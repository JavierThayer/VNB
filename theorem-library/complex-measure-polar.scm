;; the phase u = ru + iu i
(define mfz-us-ab
  (dk-abstract! 'omega 'CC (lambda (x) (mfz-s (list '+ (list 'ru x) (list '* (list 'iu x) '+i))))
    (lambda (x)
      (let ((leaf (proof-state-focus *ps*)))
        (mfz-pt! x)
        (fact 'cc-i-in)
        (mfz-cite! 'rr-subset-cc (list 'ru x)) (mfz-cite! 'rr-subset-cc (list 'iu x))
        (dk-have-and! (mfz-s (list 'IN (list 'iu x) 'CC)) '(IN +i CC))
        (mfz-cite! 'cc-mul-closed (list 'iu x) '+i)
        (dk-have-and! (mfz-s (list 'IN (list 'ru x) 'CC)) (mfz-s (list 'IN (list '* (list 'iu x) '+i) 'CC)))
        (if (not (sequent-node-grounded? leaf)) (begin (mfz-cite! 'cc-add-closed (list 'ru x) (list '* (list 'iu x) '+i)) (dk-ass!)))))))
(mfz-name! 'us (car mfz-us-ab))
(define mfz-us-ve (cdr mfz-us-ab))
;; at x: the parts of u
(define (mfz-u-parts! x)
  (mfz-pt! x)
  (fact 'cc-i-in)
  (mfz-cite! 'fun-apply-type-c 'us 'omega 'CC x)
  (let ((z (mfz-s (list '+ (list 'ru x) (list '* (list 'iu x) '+i)))))
    (mfz-cite! 'rr-subset-cc (list 'ru x)) (mfz-cite! 'rr-subset-cc (list 'iu x))
    (dk-have-and! (mfz-s (list 'IN (list 'iu x) 'CC)) '(IN +i CC))
    (mfz-cite! 'cc-mul-closed (list 'iu x) '+i)
    (dk-have-and! (mfz-s (list 'IN (list 'ru x) 'CC)) (mfz-s (list 'IN (list '* (list 'iu x) '+i) 'CC)))
    (mfz-cite! 'cc-add-closed (list 'ru x) (list '* (list 'iu x) '+i))
    (dk-have! (mfz-s (list '= (list 'us x) z)) (lambda () (subst (dk-apply! mfz-us-ve x)) (rfl)))
    (dk-split-all! (list (mfz-cite! 'cc-re-im-of (list 'us x) (list 'ru x) (list 'iu x))))))


;; the null-set facts for c in ca with nu(c) = 0: m1(c) = m2(c), m3(c) = m4(c)
(define (mfz-nuf c) (mfz-s (list '= (list 'nu c) (list '+ (list '- (list 'm1 c) (list 'm2 c)) (list '* '+i (list '- (list 'm3 c) (list 'm4 c)))))))
(define (mfz-mreal! c)
  (for-each (lambda (m)
              (mfz-cite! 'sigma-algebra-whole-in 'omega 'ca)
              (dk-iff-parts! (mfz-cite! 'is-measure 'omega 'ca m))
              (mfz-cite! 'fun-apply-type-c m 'ca 'RR-POS-STAR c)
              (mfz-cite! 'measure-monotone 'omega 'ca m c 'omega)
              (dk-have-and! (mfz-s (list 'IN (list m c) 'RR-POS-STAR)) (mfz-s (list 'IN (list m 'omega) 'RR)))
              (mfz-cite! 'rr-pos-star-le-real-in-rr (list m c) (list m 'omega)))
            '(m1 m2 m3 m4))
  (mfz-real! (mfz-s (list '- (list 'm1 c) (list 'm2 c))) (mfz-s (list '- (list 'm3 c) (list 'm4 c)))))
(define (mfz-zero-parts! c)       ; (= (nu c) 0) in context, c in ca, c subset omega: land both differences = 0
  (mfz-mreal! c)
  (let ((e (dk-apply! (mfz-s '(FORALL cma_ (IMPLIES (IN cma_ ca) (= (nu cma_) (+ (- (m1 cma_) (m2 cma_)) (* +i (- (m3 cma_) (m4 cma_)))))))) c)))
    (dk-rewrite-h! (list '= (list 'nu c) 0) (list 'nu c) (caddr e))
    (dk-split-all! (list (mfz-cite! 'complex-zero-parts (list '- (list 'm1 c) (list 'm2 c)) (list '- (list 'm3 c) (list 'm4 c)))))))

(define (mfz-sub-omega! a)
