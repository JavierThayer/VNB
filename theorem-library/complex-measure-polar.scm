             (let* ((a (dk-di-var!)) (m (car (cadr (dk-goal)))))
               (for-each (lambda (mm) (dk-cite! 'fun-apply-type-c mm 'ca 'RR-POS-STAR a)) '(mu1 mu2))
               (lam-b)
               (let ((u (list 'mu1 a)) (v (list 'mu2 a)))
