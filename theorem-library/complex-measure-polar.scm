;; pointwise facts at x
(define (mfz-pt! x)
  (for-each (lambda (d) (dk-apply! (mfz-s (mfz-dreal d)) x)
                        (dk-project! (mfz-s (list 'IN d '(FUN omega RR-POS-STAR))) 'is-measurable-fn (mfz-s (list 'IS-MEASURABLE-FN 'omega 'ca d)))
                        (mfz-cite! 'fun-apply-type-c d 'omega 'RR-POS-STAR x) (mfz-cite! 'rr-pos-star-nonneg (list d x)))
            '(d1 d2 d3 d4))
  (for-each (lambda (g) (dk-project! (mfz-s (list 'IN g '(FUN omega RR))) 'is-real-measurable-fn (mfz-s (list 'IS-REAL-MEASURABLE-FN 'omega 'ca g)))
                        (mfz-cite! 'fun-apply-type-c g 'omega 'RR x))
            '(re im pp ru iu))
  (for-each (lambda (f) (dk-apply! (mfz-s f) x))
            (list (mfz-ptw '(<= 0 (pp x))) (mfz-ptw '(= (* (pp x) (pp x)) (+ (* (re x) (re x)) (* (im x) (im x)))))
                  (mfz-ptw '(= (* (pp x) (ru x)) (re x))) (mfz-ptw '(= (* (pp x) (iu x)) (im x)))
                  (mfz-ptw '(= (+ (* (ru x) (ru x)) (* (iu x) (iu x))) 1))))
  (for-each (lambda (r a b)
              (let ((e (mfz-s (list '= (list r x) (list '- (list a x) (list b x))))))
                (mfz-real! (mfz-s (list '- (list a x) (list b x))))
                (if (not (dk-asm? e)) (dk-have! e (lambda () (subst (dk-apply! (mfz-n (if (eq? r 're) 're-ve 'im-ve)) x)) (rfl))))))
            '(re im) '(d1 d3) '(d2 d4)))

;; pp real; pp ru = d1 - d2; pp iu = d3 - d4; pp <= d1 + d2 + d3 + d4
(dk-have! (mfz-s (mfz-dreal 'pp)) (lambda () (let ((x (dk-di-var!))) (mfz-pt! x) (dk-ass!))))
(for-each
  (lambda (u r a b)
    (dk-have! (mfz-s (mfz-ptw (list '= (list '* '(pp x) (list u 'x)) (list '- (list a 'x) (list b 'x)))))
      (lambda () (let ((x (dk-di-var!)))
                   (mfz-pt! x)
                   (subst (mfz-s (list '= (list '* (list 'pp x) (list u x)) (list r x))))
                   (dk-ass!)))))
  '(ru iu) '(re im) '(d1 d3) '(d2 d4))
(dk-have! (mfz-s (mfz-ptw '(<= (pp x) (+ (+ (d1 x) (d2 x)) (+ (d3 x) (d4 x))))))
  (lambda () (let ((x (dk-di-var!)))
               (mfz-pt! x)
               (mfz-cite! 'polar-bound (list 're x) (list 'im x) (list 'pp x) (list 'd1 x) (list 'd2 x) (list 'd3 x) (list 'd4 x))
               (dk-ass!))))
