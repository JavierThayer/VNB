  (dk-cite! 'fun-apply-type-c (list 'INDICATOR 'omega a) 'omega 'RR x))

;; |nu|(a) = 0 from nu null on a
(define (mfz-null-backward! a)
  (dk-iff-parts! (dk-cite! 'is-complex-null-set 'omega 'ca 'nu a))
  (let* ((nullu (list 'FORALL 'cnb_ (list 'IMPLIES '(IN cnb_ ca) (list 'IMPLIES (list 'SUBSET 'cnb_ a) '(= (nu cnb_) 0)))))
         (nsets
           (map
             (lambda (da db ma mb)
               (let ((f (mfz-s (mfz-H a da db))))
                 (dk-split-all! (list (mfz-cite! 'rintegral-diff-density 'omega 'ca 'rho da db ma mb a)))
                 (dk-have! (list 'FORALL 'bb_ (list 'IMPLIES '(IN bb_ ca)
                             (list '= (list 'RINTEGRAL 'omega 'ca (mfz-n 'rho) (list 'VNB-LAMBDA 'rx_ 'omega (list '* (list f 'rx_) '((INDICATOR omega bb_) rx_)))) 0)))
                   (lambda ()
                     (let* ((bb (dk-di-var!))
                            (c (list 'INTERSECTION a bb))
                            (fb (list 'VNB-LAMBDA 'rx_ 'omega (list '* (list f 'rx_) (list (list 'INDICATOR 'omega bb) 'rx_))))
                            (hc (mfz-s (mfz-H c da db))))
                       (dk-cite! 'sigma-algebra-inter-closed-2 'omega 'ca a bb)
                       (dk-have! (list 'SUBSET c a) (lambda () (let ((w (subset-by-element!))) (dk-iff-fwd! (dk-cite! 'intersection-membership a bb w)) (dk-ass!))))
                       (mfz-sub-omega! c)
                       (dk-apply! nullu c)
                       (mfz-zero-parts! c)
                       (dk-split-all! (list (mfz-cite! 'rintegral-diff-density 'omega 'ca 'rho da db ma mb c)))
                       (dk-iff-parts! (dk-cite! 'is-integrable 'omega 'ca (mfz-n 'rho) hc))
                       (dk-project! (list 'IN hc '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca hc))
                       (dk-have! (list 'IN fb '(FUN omega RR))
                         (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!)))
                                                               (mfz-pt! x) (mfz-ind-ty! a x) (mfz-ind-ty! bb x)
                                                               (dk-lam-b!)
                                                               (dk-type! (cadr (dk-goal)) 'RR))))))
                       (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list '= (list fb 'x) (list hc 'x))))
                         (lambda ()
                           (let ((x (dk-di-var!)))
                             (mfz-pt! x) (mfz-ind-ty! a x) (mfz-ind-ty! bb x) (mfz-ind-ty! c x)
                             (dk-lam-b!)
                             (let ((iff (dk-cite! 'intersection-membership a bb x)))
                               (mfz-ind-val! a x
                                 (lambda (va)
                                   (mfz-ind-val! bb x
                                     (lambda (vb)
                                       (if (and (eqv? va 1) (eqv? vb 1))
                                           (begin (dk-have-and! (list 'IN x a) (list 'IN x bb)) (dk-iff-bwd! iff)
                                                  (dk-cite! 'indicator-value-in 'omega c x))
                                           (begin (dk-have! (list 'NOT (list 'IN x c))
                                                    (lambda () (di) (dk-iff-fwd! iff) (ai (list 'NOT (list 'IN x (if (eqv? va 1) bb a))))))
                                                  (dk-cite! 'indicator-value-out 'omega c x)))
                                       (subst (list '= (mfz-ind a x) va))
                                       (subst (list '= (mfz-ind bb x) vb))
                                       (subst (list '= (mfz-ind c x) (if (and (eqv? va 1) (eqv? vb 1)) 1 0)))
                                       (crs)))))))))
                       (subst (dk-cite! 'rintegral-congruence 'omega 'ca (mfz-n 'rho) fb hc))
                       (subst (list '= (list 'RINTEGRAL 'omega 'ca (mfz-n 'rho) hc) (mfz-s (list '- (list ma c) (list mb c)))))
                       (subst (mfz-s (list '= (list '- (list ma c) (list mb c)) 0)))
                       (rfl))))
                 (mfz-cite! 'rintegral-zero-on-sets-null 'omega 'ca 'rho f)
                 (list 'SEP 'nzx_ 'omega (list 'NOT (list '= (list f 'nzx_) 0)))))
             '(d1 d3) '(d2 d4) '(m1 m3) '(m2 m4)))
         (n1 (car nsets)) (n2 (cadr nsets))
         (un (list 'UNION n1 n2))
         (pe (mfz-s (list 'PTWISE-ETIMES 'omega 'pp (list 'INDICATOR 'omega a))))
         (zf '(VNB-LAMBDA cx_ omega 0)))
    (mfz-cite! 'ae-null-union 'omega 'ca 'rho n1 n2)
    (let* ((iff (mfz-cite! 'is-null-set 'omega 'ca 'rho un))
           (nb (begin (dk-iff-fwd! iff) (dk-skolem! (dk-pick (lambda (z) (and (dk-head-is? z 'FORSOME) (dk-contains? z un))) "the null cover")))))
      (dk-cite! 'measurable-fn-indicator 'omega 'ca a)
      (mfz-cite! 'measurable-fn-etimes 'omega 'ca 'pp (list 'INDICATOR 'omega a))
      (dk-cite! 'measurable-fn-const 'omega 'ca 0)
      (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
      (let ((i1 (dk-cite! 'rr-pos-star-membership 1)))
        (dk-have! '(IN 1 RR-POS-STAR) (lambda () (keep i1 '(IN 1 RR) '(<= 0 1)) (prop))))
      (dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x omega) (list 'IMPLIES (list 'NOT (list 'IN 'x nb)) (list '= (list pe 'x) (list zf 'x)))))
        (lambda ()
          (let ((x (dk-di-var!)))
            (di)
            (mfz-pt! x) (mfz-ind-ty! a x)
            (for-each
              (lambda (nset)
                (let* ((f (car (cadr (cadr (cadddr nset))))) (fx (list f x)))
                  (dk-have! (list '= fx 0)
                   (lambda ()
                    (use-em (list '= fx 0)
                    (lambda () (dk-ass!))
                    (lambda ()
                      (dk-have! (list 'IN x nset) (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
                      (dk-have! (list 'IN x un) (lambda () (mac 'union-membership) (if (eq? nset n1) (oi-l) (oi-r)) (dk-ass!)))
                      (dk-cite! 'subset-mem-fwd un nb x)
                      (ai (list 'NOT (list 'IN x nb)))))))
                  (dk-lam-b-h! (dk-ctx-form (list '= fx 0)))))
              (list n1 n2))
            (subst (mfz-cite! 'ptwise-etimes-value-q 'omega 'pp (list 'INDICATOR 'omega a) x))
            (dk-lam-b!)
            (mfz-ind-val! a x
              (lambda (v)
                (subst (list '= (mfz-ind a x) v))
                (if (eqv? v 1)
                    (begin
                      (for-each (lambda (r da db)
                                  (let ((dd (mfz-s (list '- (list da x) (list db x)))))
                                    (dk-rewrite-h! (mfz-s (list '= (list '* (mfz-ind a x) dd) 0)) (mfz-ind a x) 1)
                                    (dk-have! (mfz-s (list '= (list r x) 0))
                                      (lambda () (subst (mfz-s (list '= (list r x) dd)))
                                                 (dk-ineq! (mfz-s (list '= (list '* 1 dd) 0)) (list 'IN dd 'RR))))))
                                '(re im) '(d1 d3) '(d2 d4))
                      (dk-have! (mfz-s (list '= (list '* (list 'pp x) (list 'pp x)) 0))
                        (lambda () (subst (mfz-s (list '= (list '* (list 'pp x) (list 'pp x)) (list '+ (list '* (list 're x) (list 're x)) (list '* (list 'im x) (list 'im x))))))
                                   (subst (mfz-s (list '= (list 're x) 0))) (subst (mfz-s (list '= (list 'im x) 0))) (crs)))
