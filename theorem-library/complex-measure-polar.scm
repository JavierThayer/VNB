;; the eigenvariables, by role: (mfz-s E) renames the role symbols in E
(define mfz-names (list (cons 'm1 mfz-m1) (cons 'm2 mfz-m2) (cons 'm3 mfz-m3) (cons 'm4 mfz-m4)))
(define (mfz-name! role v) (set! mfz-names (cons (cons role v) mfz-names)) v)
(define (mfz-s e)
  (cond ((symbol? e) (let ((r (assq e mfz-names))) (if r (cdr r) e)))
        ((pair? e) (cons (mfz-s (car e)) (mfz-s (cdr e))))
        (#t e)))
(define (mfz-n role) (cdr (assq role mfz-names)))
(define (mfz-cite! thm . args) (apply dk-cite! thm (map mfz-s args)))

