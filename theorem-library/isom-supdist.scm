;;; =====================================================================
;;; isometry-group-ms-is-metric-space: for s compact, Gamma with d_Gamma is a
;;; metric space
;;; =====================================================================
(define isd-M '(ISOMETRY-GROUP-MS s))
(define (isd-D a b) (list '(DIST (ISOMETRY-GROUP-MS s)) a b))
(define (isd-S a b) (list 'SUP-DIST 's 's a b))
(define (isd-app f x) (list f x))
(define isd-B #f)
(define isd-bcl #f)

;;; a, b in Gamma in context: land a, b in FUN(pts s, pts s), and S(a, b) in RR,
;;; 0 <= S(a, b) <= B (sup-dist-bound at the diameter bound B)
(define (isd-sd! a b)
  (if (not (dk-asm? (list 'IN (isd-S a b) 'RR)))
      (begin
        (if (not (dk-asm? (list 'IN a '(FUN (PTS s) (PTS s))))) (fact 'isometry-group-in-fun 's a))
        (if (not (dk-asm? (list 'IN b '(FUN (PTS s) (PTS s))))) (fact 'isometry-group-in-fun 's b))
        (let ((fa (list 'FORALL 'isx_ (list 'IMPLIES '(IN isx_ (PTS s))
                          (list '<= (isd-ds (isd-app a 'isx_) (isd-app b 'isx_)) isd-B)))))
          (if (not (dk-asm? fa))
              (dk-have! fa
                (lambda ()
                  (let ((x (dk-di-var!)))
                    (fact 'fun-apply-type-c a '(PTS s) '(PTS s) x)
                    (fact 'fun-apply-type-c b '(PTS s) '(PTS s) x)
                    (dk-close-if! (lambda () (inst*! isd-bcl (isd-app a x) (isd-app b x))) ass)))))
          (dk-split-all! (list (dk-cite! 'sup-dist-bound 's 's a b isd-B)))))))

;;; the read-off D(a, b) == S(a, b), landed
(define (isd-readoff! a b)
  (let ((e (list '== (isd-D a b) (isd-S a b))))
    (if (not (dk-asm? e)) (fact 'isometry-group-ms-dist 's a b))
    e))

;;; a <= b and b <= a, both real: a = b
(define (isd-antisym! a b)
  (isd-and! (list 'IN a 'RR) (list 'IN b 'RR))
  (isd-and! (list '<= a b) (list '<= b a))
  (dk-close-if! (lambda () (fact 'rr-leq-antisymmetric a b)) ass))

;;; S(a, c) <= BOUND from a pointwise bound proved by PTWISE (a procedure of x
;;; proving d(a x, c x) <= BOUND on the focus); BOUND real and >= 0 in context
(define (isd-sd-le! a c bound ptwise)
  (let ((fa (list 'FORALL 'isx_ (list 'IMPLIES '(IN isx_ (PTS s))
                    (list '<= (isd-ds (isd-app a 'isx_) (isd-app c 'isx_)) bound)))))
    (dk-have! fa (lambda () (ptwise (dk-di-var!))))
    (dk-split-all! (list (dk-cite! 'sup-dist-bound 's 's a c bound)))))

(define (isd-pt! f x)                       ; f in FUN(pts s, pts s), x in pts s
  (fact 'fun-apply-type-c f '(PTS s) '(PTS s) x))

(define (isd-up! a b x)                     ; d(a x, b x) <= S(a, b)
  (dk-apply! (dk-cite! 'sup-dist-upper 's 's a b) x))

(define (isd-law!)
  (let ((g (dk-goal)))
    (cond
     ;; D(u, u) = 0
     ((and (eq? (car g) '=) (equal? (caddr g) 0))
      (let ((u (cadr (cadr g))))
        (isd-sd! u u)
        (subst (isd-readoff! u u))
        (fact 'rr-zero-in)
        (isd-sd-le! u u 0
          (lambda (x)
            (isd-pt! u x)
            (fact 'metric-self-zero 's (isd-app u x))
            (fact 'metric-dist-real 's (isd-app u x) (isd-app u x))
            (dk-ineq! (list '= (isd-ds (isd-app u x) (isd-app u x)) 0)
                      (list 'IN (isd-ds (isd-app u x) (isd-app u x)) 'RR))))
        (isd-antisym! (isd-S u u) 0)))
     ;; 0 <= D(u, v)
     ((and (eq? (car g) '<=) (equal? (cadr g) 0))
      (let* ((r (caddr g)) (u (cadr r)) (v (caddr r)))
        (isd-sd! u v)
        (subst (isd-readoff! u v))
        (ass)))
     ;; D(u, v) = 0  |-  u = v
     ((and (eq? (car g) '=) (symbol? (cadr g)) (symbol? (caddr g)))
      (let* ((u (cadr g)) (v (caddr g)))
        (isd-sd! u v)
        (let ((ro (isd-readoff! u v)))
          (dk-have! (list '= (isd-D u v) (isd-S u v)) (lambda () (subst ro) (rfl))))
        (dk-rewrite-h! (list '= (isd-D u v) 0) (isd-D u v) (isd-S u v))
        (dk-fun-ext! u v '(PTS s) '(PTS s) #f #f
          (lambda (x)
            (isd-pt! u x) (isd-pt! v x)
            (isd-up! u v x)
            (fact 'metric-pos 's (isd-app u x) (isd-app v x))
            (fact 'metric-dist-real 's (isd-app u x) (isd-app v x))
            (let ((d (isd-ds (isd-app u x) (isd-app v x))))
              (dk-have! (list '<= d 0)
                (lambda () (dk-ineq! (list '<= d (isd-S u v)) (list '= (isd-S u v) 0)
                                     (list 'IN d 'RR) (list 'IN (isd-S u v) 'RR))))
              (fact 'rr-zero-in)
              (isd-antisym! d 0)
              (dk-close-if! (lambda () (fact 'metric-zero-eq 's (isd-app u x) (isd-app v x))) ass))))))
     ;; D(u, v) = D(v, u)
     ((eq? (car g) '=)
      (let* ((u (cadr (cadr g))) (v (caddr (cadr g))))
        (isd-sd! u v) (isd-sd! v u)
        (subst (isd-readoff! u v))
        (subst (isd-readoff! v u))
        (define (half! a b)
          (isd-sd-le! a b (isd-S b a)
            (lambda (x)
              (isd-pt! a x) (isd-pt! b x)
              (isd-up! b a x)
              (fact 'metric-sym 's (isd-app a x) (isd-app b x))
              (fact 'metric-dist-real 's (isd-app a x) (isd-app b x))
              (fact 'metric-dist-real 's (isd-app b x) (isd-app a x))
              (dk-ineq! (list '= (isd-ds (isd-app a x) (isd-app b x)) (isd-ds (isd-app b x) (isd-app a x)))
                        (list '<= (isd-ds (isd-app b x) (isd-app a x)) (isd-S b a))
                        (list 'IN (isd-ds (isd-app a x) (isd-app b x)) 'RR)
                        (list 'IN (isd-ds (isd-app b x) (isd-app a x)) 'RR)
                        (list 'IN (isd-S b a) 'RR)))))
        (half! u v)
        (half! v u)
        (isd-antisym! (isd-S u v) (isd-S v u))))
     ;; D(u, w) <= D(u, v) + D(v, w)
     ((eq? (car g) '<=)
      (let* ((lhs (cadr g)) (rhs (caddr g))
             (u (cadr lhs)) (w (caddr lhs)) (v (caddr (cadr rhs)))
             (suv (isd-S u v)) (svw (isd-S v w)) (sum (list '+ (isd-S u v) (isd-S v w))))
        (isd-sd! u w) (isd-sd! u v) (isd-sd! v w)
        (subst (isd-readoff! u w))
        (subst (isd-readoff! u v))
        (subst (isd-readoff! v w))
        (fact 'rr-add-in-rr suv svw)
        (dk-have! (list '<= 0 sum)
          (lambda () (dk-ineq! (list '<= 0 suv) (list '<= 0 svw) (list 'IN suv 'RR) (list 'IN svw 'RR))))
        (isd-sd-le! u w sum
          (lambda (x)
            (isd-pt! u x) (isd-pt! v x) (isd-pt! w x)
            (isd-up! u v x)
            (isd-up! v w x)
            (fact 'metric-triangle 's (isd-app u x) (isd-app v x) (isd-app w x))
            (let ((a (isd-ds (isd-app u x) (isd-app w x)))
                  (b (isd-ds (isd-app u x) (isd-app v x)))
                  (c (isd-ds (isd-app v x) (isd-app w x))))
              (fact 'metric-dist-real 's (isd-app u x) (isd-app w x))
              (fact 'metric-dist-real 's (isd-app u x) (isd-app v x))
              (fact 'metric-dist-real 's (isd-app v x) (isd-app w x))
              (dk-ineq! (list '<= a (list '+ b c)) (list '<= b suv) (list '<= c svw)
                        (list 'IN a 'RR) (list 'IN b 'RR) (list 'IN c 'RR)
                        (list 'IN suv 'RR) (list 'IN svw 'RR)))))
        (ass)))
     (#t (error "isd-law!: unexpected leaf" g)))))

(sp (make-wff '(FORALL s (IMPLIES (IS-COMPACT s) (IS-METRIC-SPACE (ISOMETRY-GROUP-MS s))))))
(dk-peel!)
(dk-project! '(IS-METRIC-SPACE s) 'is-compact '(IS-COMPACT s))
(set! isd-B (dk-skolem! (dk-cite! 'compact-dist-bound 's)))
(set! isd-bcl (dk-pick (lambda (h) (and (eq? (isd-head h) 'FORALL) (dk-contains? h isd-B))) "the diameter bound"))
(fact 'isometry-group-is-set 's)
(fact 'isometry-group-ms-pts 's)
(fact 'isometry-group-ms-dist-fun 's)
(define isd-G '(ISOMETRY-GROUP s))
;;; the distance is real-valued
(dk-have! (list 'IN (list 'DIST isd-M) (list 'FUN (list 'CARTESIAN isd-G isd-G) 'RR))
  (lambda ()
    (subst (list '== (list 'DIST isd-M) isd-lam))
    (for-each
     (lambda (k)
       (if (not (sequent-node-grounded? k))
           (begin
             (dk-focus! k)
             (let ((gg (dk-goal)))
               (if (and (eq? (isd-head gg) 'IN) (eq? (caddr gg) 'SET))
                   (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))
                   (begin
                     (dk-peel!)
                     (let* ((sd (cadr (dk-goal))) (u (cadddr sd)) (v (car (cddddr sd))))
                       (isd-sd! u v)
                       (ass))))))))
     (dk-opened (lambda () (lam-t))))))
(mac 'IS-METRIC-SPACE)
(dk-isx-set!)                ; W1J-A: the conjunct t in SET, from the typings
(subst (list '== (list 'PTS isd-M) isd-G))
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
      ((and (eq? (isd-head g) '=) (dk-head-is? (cadr g) 'LENGTH))
       (mac 'ISOMETRY-GROUP-MS) (len-r) (arith))
      ((eq? (isd-head g) 'IS-METRIC)
       (mac 'is-metric)
       (let loop ((fuel 80))
         (let ((n (find-first (lambda (n)
                                (let ((gg (dk-goal-of n)))
                                  (and (pair? gg) (memq (car gg) '(FORALL IMPLIES AND)))))
                              (dk-open-leaves))))
           (if (and n (> fuel 0)) (begin (dk-focus! n) (di) (loop (- fuel 1))))))
       (for-each (lambda (n)
                   (if (not (sequent-node-grounded? n))
                       (begin (dk-focus! n) (isd-law!))))
                 (dk-open-leaves)))
      (#t (ass))))))
(qed 'isometry-group-ms-is-metric-space)
(topic! 'isometry-group-ms-is-metric-space 'analysis)
(alias! 'isometry-group-ms-is-metric-space
        "the isometries of a compact metric space onto itself, with the sup metric, form a metric space")
