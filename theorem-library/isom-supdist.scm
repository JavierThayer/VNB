;;; isom-supdist.scm -- the sup distance between two functions into a metric space,
;;; boundedness of a compact metric space, and the group of isometries of a compact
;;; metric space as a metric space (calculus.pdf ch. 3 sec. 8, the metric (54)).
;;; Agent ISOM, 2026-10-26.
;;;
;;;   sup-dist-upper       d_t(f(x), g(x)) <= SUP-DIST(s, t, f, g) for x in pts(s)
;;;   sup-dist-bound       a real bound b >= 0 on the d_t(f(x), g(x)) makes SUP-DIST a
;;;                        real number in [0, b]
;;;   compact-is-bounded   a compact metric space is bounded
;;;   isometry-group-membership, isometry-group-is-set, isometry-group-ms-pts,
;;;   isometry-group-ms-dist-fun, isometry-group-ms-dist
;;;                        the read-offs of the vocabulary (isom-vocab.scm)
;;;   isometry-group-ms-is-metric-space
;;;                        for s compact, ISOMETRY-GROUP-MS(s) is a metric space
;;;
;;; compact-is-bounded covers pts(s) by the balls B(x0, n + 1), n in NN, around one
;;; point x0 (the empty space is bounded by 0): compact-closed-countable-subcover gives
;;; N with every point within N of x0, so every distance is at most 2N.
;;;
;;; WINDOW.  Citations: esup-in / esup-upper / esup-least (extended-reals-pos laws),
;;; image-membership-iff, rr-pos-star-*, carrier-is-closed (isom-uc.scm),
;;; compact-closed-countable-subcover (metric-finite-subcover), ball-is-open,
;;; ball-membership (rake-balls), nn-unbounded-in-rr, metric-* laws, bijection-*.
;;; lo = after isom-uc.scm and isom-vocab.scm; hi = none.  Library: analysis.
;;;
;;; Helper prefix: isd-.

(define (isd-head g) (and (pair? g) (car g)))
(define (isd-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass))))))
    f))
(define (isd-iff-rhs! iff)
  (let ((rhs (caddr iff)))
    (dk-have! rhs (lambda () (prop)))
    (if (eq? (isd-head rhs) 'AND) (dk-split-all! (list rhs)))
    rhs))
(define (isd-dt a b) (list '(DIST t) a b))
(define isd-im '(IMAGE (VNB-LAMBDA sdx_ (PTS s) ((DIST t) (f sdx_) (g sdx_))) (PTS s)))
(define isd-sd '(SUP-DIST s t f g))

;;; an element W of the image (its membership in context): skolemise the preimage x,
;;; turn the value equation into d(f x, g x) = W, type the distance, rewrite W in the
;;; goal; return x
(define (isd-elim! w)
  (let* ((mem (dk-pick (lambda (h) (and (eq? (isd-head h) 'IN) (eq? (cadr h) w)
                                        (dk-head-is? (caddr h) 'IMAGE)))
                       "the image membership"))
         (_1 (dk-split-all! (dk-landed (lambda () (mac-h 'image-membership-iff mem)))))
         (x (dk-skolem! (dk-pick (lambda (h) (and (eq? (isd-head h) 'FORSOME) (dk-contains? h w)))
                                 "the preimage"))))
    (dk-lam-b-h! (dk-pick (lambda (h) (and (eq? (isd-head h) '=) (eq? (caddr h) w))) "the value equation"))
    (fact 'fun-apply-type-c 'f '(PTS s) '(PTS t) x)
    (fact 'fun-apply-type-c 'g '(PTS s) '(PTS t) x)
    (fact 'metric-dist-real 't (list 'f x) (list 'g x))
    (fact 'metric-pos 't (list 'f x) (list 'g x))
    (subst (list '= w (isd-dt (list 'f x) (list 'g x))))
    x))

(define (isd-pos-star!)          ; goal (IN e RR-POS-STAR), e real and >= 0 in context
  (mac 'rr-pos-star-membership) (oi-l) (dk-conj-close! (lambda () (ass))))

(define (isd-im-subset!)
  (if (not (dk-asm? (list 'SUBSET isd-im 'RR-POS-STAR)))
      (dk-have! (list 'SUBSET isd-im 'RR-POS-STAR)
        (lambda ()
          (mac 'subset-def)
          (let ((w (dk-di-var!)))
            (isd-elim! w)
            (isd-pos-star!))))))

;;; =====================================================================
;;; sup-dist-upper
;;; =====================================================================
(sp (make-wff '(FORALL s (FORALL t (FORALL f (FORALL g
     (IMPLIES (IS-METRIC-SPACE t)
       (IMPLIES (IN f (FUN (PTS s) (PTS t)))
         (IMPLIES (IN g (FUN (PTS s) (PTS t)))
           (FORALL x (IMPLIES (IN x (PTS s))
             (<= ((DIST t) (f x) (g x)) (SUP-DIST s t f g)))))))))))))
(dk-peel!)
(mac 'SUP-DIST)
(isd-im-subset!)
(define isd-up (dk-fact! 'esup-upper isd-im))
(fact 'fun-apply-type-c 'f '(PTS s) '(PTS t) 'x)
(fact 'fun-apply-type-c 'g '(PTS s) '(PTS t) 'x)
(fact 'metric-dist-real 't '(f x) '(g x))
(fact 'membership-implies-sethood (isd-dt '(f x) '(g x)) 'RR)
(dk-have! (list 'IN (isd-dt '(f x) '(g x)) isd-im)
  (lambda ()
    (mac 'image-membership-iff)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'FORSOME)
            (begin (ew 'x)
                   (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (dk-lam-b!) (rfl))))))
            (ass))))))
(dk-apply! isd-up (isd-dt '(f x) '(g x)))
(ass)
(qed 'sup-dist-upper)
(topic! 'sup-dist-upper 'analysis)

;;; =====================================================================
;;; sup-dist-pos-star: always a value in [0, +inf]
;;; =====================================================================
(sp (make-wff '(FORALL s (FORALL t (FORALL f (FORALL g
     (IMPLIES (IS-METRIC-SPACE t)
       (IMPLIES (IN f (FUN (PTS s) (PTS t)))
         (IMPLIES (IN g (FUN (PTS s) (PTS t)))
           (IN (SUP-DIST s t f g) RR-POS-STAR))))))))))
(dk-peel!)
(mac 'SUP-DIST)
(isd-im-subset!)
(dk-close-if! (lambda () (fact 'esup-in isd-im)) ass)
(qed 'sup-dist-pos-star)
(topic! 'sup-dist-pos-star 'analysis)

;;; =====================================================================
;;; sup-dist-bound
;;; =====================================================================
(sp (make-wff '(FORALL s (FORALL t (FORALL f (FORALL g (FORALL b
     (IMPLIES (IS-METRIC-SPACE t)
       (IMPLIES (IN f (FUN (PTS s) (PTS t)))
         (IMPLIES (IN g (FUN (PTS s) (PTS t)))
           (IMPLIES (IN b RR)
             (IMPLIES (<= 0 b)
               (IMPLIES (FORALL x (IMPLIES (IN x (PTS s)) (<= ((DIST t) (f x) (g x)) b)))
                 (AND (IN (SUP-DIST s t f g) RR)
                      (AND (<= 0 (SUP-DIST s t f g)) (<= (SUP-DIST s t f g) b))))))))))))))))
(dk-peel!)
(define isd-bd (dk-pick (lambda (h) (and (eq? (isd-head h) 'FORALL) (dk-contains? h 'b))) "the bound"))
(dk-have! (list 'IN isd-sd 'RR-POS-STAR)
  (lambda () (mac 'SUP-DIST) (isd-im-subset!) (fact 'esup-in isd-im) (ass)))
(dk-have! (list '<= isd-sd 'b)
  (lambda ()
    (mac 'SUP-DIST)
    (isd-im-subset!)
    (dk-have! (list 'AND '(IN b RR-POS-STAR) (list 'FORALL 'isw_ (list 'IMPLIES (list 'IN 'isw_ isd-im) '(<= isw_ b))))
      (lambda ()
        (dk-conj-close!
          (lambda ()
            (if (eq? (isd-head (dk-goal)) 'FORALL)
                (let* ((w (dk-di-var!)) (x (isd-elim! w)))
                  (dk-apply! isd-bd x)
                  (ass))
                (isd-pos-star!))))))
    (fact 'esup-least isd-im 'b)
    (ass)))
(isd-and! (list 'IN isd-sd 'RR-POS-STAR) '(IN b RR))
(fact 'rr-pos-star-le-real-in-rr isd-sd 'b)
(fact 'rr-pos-star-nonneg isd-sd)
(dk-conj-close! (lambda () (ass)))
(qed 'sup-dist-bound)
(topic! 'sup-dist-bound 'analysis)

;;; =====================================================================
;;; compact-dist-bound, compact-is-bounded
;;; =====================================================================
(define (isd-ds a b) (list '(DIST s) a b))
(sp (make-wff '(FORALL s (IMPLIES (IS-COMPACT s)
     (FORSOME b (AND (IN b RR) (AND (<= 0 b)
       (FORALL x (FORALL y (IMPLIES (IN x (PTS s)) (IMPLIES (IN y (PTS s))
         (<= ((DIST s) x y) b))))))))))))
(dk-peel!)
(dk-project! '(IS-METRIC-SPACE s) 'is-compact '(IS-COMPACT s))
(use-em '(FORSOME isz_ (IN isz_ (PTS s)))
 ;; a point x0: the balls B(x0, n + 1) cover
 (lambda ()
   (let* ((x0 (dk-skolem! (dk-pick (lambda (h) (and (eq? (isd-head h) 'FORSOME)
                                                    (dk-contains? h 'isz_)))
                                   "the point")))
          (cs (list 'VNB-LAMBDA 'isbn_ 'NN (list 'BALL 's x0 '(+ isbn_ 1))))
          (inst (dk-cite! 'compact-closed-countable-subcover 's '(PTS s) cs)))
     (fact 'rr-one-in)
     (dk-have! (cadr inst) (lambda () (fact 'carrier-is-closed 's) (ass)))
     (dk-have! (cadr (caddr inst))
       (lambda ()
         (let* ((n (dk-di-var!)) (r (list '+ n 1)))
           (dk-lam-b!)
           (fact 'nn-in-rr n)
           (fact 'nn-zero-le n)
           (fact 'rr-add-in-rr n 1)
           (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '<= 0 n))))
           (dk-have! (list 'NOT (list '= 0 r))
             (lambda () (di) (dk-absurd! (list '= 0 r) (list '<= 0 n))))
           (dk-have! (list 'AND (list 'IN r 'RR) (list 'AND (list '<= 0 r) (list 'NOT (list '= 0 r))))
             (lambda () (dk-conj-close! (lambda () (ass)))))
           (fact 'ball-is-open 's x0 r)
           (ass))))
     (dk-have! (cadr (caddr (caddr inst)))
       (lambda ()
         (let* ((x (dk-di-var!))
                (d (isd-ds x0 x)))
           (fact 'metric-dist-real 's x0 x)
           (let* ((n (dk-skolem! (dk-cite! 'nn-unbounded-in-rr d)))
                  (r (list '+ n 1)))
             (fact 'nn-in-rr n)
             (fact 'rr-add-in-rr n 1)
             (ew n)
             (dk-conj-close!
              (lambda ()
                (if (and (eq? (isd-head (dk-goal)) 'IN) (dk-contains? (dk-goal) 'VNB-LAMBDA))
                    (begin
                      (dk-lam-b!)
                      (mac 'ball-membership)
                      (dk-conj-close!
                       (lambda ()
                         (let ((g (dk-goal)))
                           (cond ((eq? (isd-head g) '<=) (dk-ineq! (list '< d n)))
                                 ((eq? (isd-head g) 'NOT)
                                  (di) (dk-absurd! (list '= d r) (list '< d n)))
                                 (#t (ass)))))))
                    (ass))))))))
     (let* ((nf (dk-skolem! (dk-apply! inst)))
            (cover (dk-pick (lambda (h) (and (eq? (isd-head h) 'FORALL) (dk-contains? h nf)))
                            "the finite subcover clause"))
            (b (list '+ nf nf)))
       (fact 'nn-in-rr nf)
       (fact 'nn-zero-le nf)
       (fact 'rr-add-in-rr nf nf)
       (ew b)
       (dk-conj-close!
        (lambda ()
          (cond
           ((eq? (isd-head (dk-goal)) '<=) (dk-ineq! (list '<= 0 nf) (list 'IN nf 'RR)))
           ((not (eq? (isd-head (dk-goal)) 'FORALL)) (ass))
           (#t
            (dk-peel!)
            (let* ((x (cadr (cadr (dk-goal))))
                   (y (caddr (cadr (dk-goal)))))
              (define (near! z)
                (let* ((m (dk-skolem! (dk-apply! cover z)))
                       (mem (dk-pick (lambda (h) (and (eq? (isd-head h) 'IN) (eq? (cadr h) z)
                                                      (dk-contains? h 'VNB-LAMBDA)))
                                     "z in the ball family")))
                  (dk-lam-b-h! mem)
                  (dk-split-all! (dk-landed (lambda () (mac-h 'ball-membership
                                                              (list 'IN z (list 'BALL 's x0 (list '+ m 1)))))))
                  (fact 'metric-dist-real 's x0 z)
                  (fact 'nn-lt-succ-le m nf)
                  (dk-have! (list '<= (isd-ds x0 z) nf)
                    (lambda () (dk-nn! (list '<= (isd-ds x0 z) (list '+ m 1))
                                       (list '<= (list 'succ m) nf))))))
              (near! x)
              (near! y)
              (fact 'metric-triangle 's x x0 y)
              (fact 'metric-sym 's x x0)
              (fact 'metric-dist-real 's x y)
              (fact 'metric-dist-real 's x x0)
              (dk-ineq! (list '<= (isd-ds x y) (list '+ (isd-ds x x0) (isd-ds x0 y)))
                        (list '= (isd-ds x x0) (isd-ds x0 x))
                        (list '<= (isd-ds x0 x) nf) (list '<= (isd-ds x0 y) nf)
                        (list 'IN (isd-ds x y) 'RR) (list 'IN (isd-ds x x0) 'RR)
                        (list 'IN (isd-ds x0 x) 'RR) (list 'IN (isd-ds x0 y) 'RR)
                        (list 'IN nf 'RR))))))))))
 ;; no point: 0 bounds every distance, vacuously
 (lambda ()
   (fact 'rr-zero-in)
   (ew 0)
   (dk-conj-close!
    (lambda ()
      (cond
       ((eq? (isd-head (dk-goal)) '<=) (dk-ineq!))
       ((not (eq? (isd-head (dk-goal)) 'FORALL)) (ass))
       (#t
        (let* ((pl (dk-peel!))
               (x (cadr (car (filter (lambda (f) (eq? (isd-head f) 'IN)) pl)))))
          (dk-have! '(FORSOME isz_ (IN isz_ (PTS s))) (lambda () (ew x) (ass)))
          (prop))))))))
(qed 'compact-dist-bound)
(topic! 'compact-dist-bound 'analysis)
(alias! 'compact-dist-bound "the distances of a compact metric space have a common non-negative real bound")

(sp (make-wff '(FORALL s (IMPLIES (IS-COMPACT s) (IS-BOUNDED-METRIC-SPACE s)))))
(dk-peel!)
(dk-project! '(IS-METRIC-SPACE s) 'is-compact '(IS-COMPACT s))
(define isd-b0 (dk-skolem! (dk-cite! 'compact-dist-bound 's)))
(mac 'is-bounded-metric-space)
(dk-conj-close!
 (lambda ()
   (if (eq? (isd-head (dk-goal)) 'FORSOME)
       (begin (ew isd-b0) (dk-conj-close! (lambda () (ass))))
       (ass))))
(qed 'compact-is-bounded)
(topic! 'compact-is-bounded 'analysis)
(alias! 'compact-is-bounded "a compact metric space is bounded")

