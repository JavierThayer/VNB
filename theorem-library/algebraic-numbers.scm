                    (ew b)
                    (dk-conj-close!
                      (lambda ()
                        (if (not (dk-ass!))
                            (let ((id (list '= (list '* (list '* a w) b) (list '* a (list '* b w)))))
                              (subst e2)
                              (dk-have! id (lambda () (crs)))
                              (subst id)
                              (subst e1)
                              (crs))))))))))))))
(qed 'qq-in-zz-fractions)

;;; (25) the inverse of a non-zero number algebraic over a subfield K of C is algebraic over K; over a subfield a
;;; relation with a non-zero leading coefficient can be made monic; COR. 4.23 (the field half); COR. 4.26
(define (am14-sc c) (list 'VNB-LAMBDA 'ansk_ 'NN (list c '(succ ansk_))))

;;; sum_{j <= n} c_j z^j = c_0 + z sum_{j < n} c_(j+1) z^j
(sp (make-wff (forall-guarded '(n c z) '((IN n NN) (IN c (FUN NN CC)) (IN z CC))
  (list '= (cp-ps 'c 'z '(succ n)) (list '+ '(c 0) (list '* 'z (cp-ps (am14-sc 'c) 'z 'n)))))))
(dk-peel!)
(fact 'nn-zero-in) (fact 'cc-zero-in) (fact 'cc-one-in)
(fact 'nn-succ-closed 'n)
(fact 'fun-apply-type-c 'c 'NN 'CC 0)
(let* ((sc (am14-sc 'c)) (cons (list 'CF-CONS '(c 0) sc)))
  (dk-have! (list 'IN sc '(FUN NN CC))
    (lambda ()
      (dk-lam-type!
        (lambda () (let ((k (dk-di-var!))) (fact 'nn-succ-closed k) (fact 'fun-apply-type-c 'c 'NN 'CC (list 'succ k)) (ass)))
        (lambda () (fact 'nn-is-set) (ass)))))
  (dk-cite! 'cc-subring-cc)
  (dk-apply! (dk-cite! 'cf-cons-in-fun 'CC) '(c 0) sc)
  (dk-have! (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) (list '= '(c pfk_) (list cons 'pfk_))))
    (lambda ()
      (let ((k (dk-di-var!)))
        (ma-or-split! (dk-cite! 'nn-zero-or-succ k)
          (list
            (lambda ()
              (subst (list '= k 0))
              (subst (dk-apply! (dk-cite! 'cf-cons-zero) '(c 0) sc))
              (rfl))
            (lambda ()
              (let ((p (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f k))) (dk-asms)))))
                (fact 'nn-succ-closed p)
                (fact 'fun-apply-type-c 'c 'NN 'CC (list 'succ p))
                (subst (list '= k (list 'succ p)))
                (subst (dk-apply! (dk-cite! 'cf-cons-succ) '(c 0) sc p))
                (if (not (dk-lam-b!)) (rfl)))))))))
  (let ((cg (dk-apply! (dk-apply! (dk-cite! 'cc-ps-congr '(succ n)) 'c cons) 'z))
        (cn (dk-apply! (dk-cite! 'cc-ps-cons 'n) '(c 0) sc 'z)))
    (subst cg)
    (subst cn)
    (rfl)))
(qed 'cc-ps-shift)

;;; the inverse of a non-zero root of a monic polynomial over a subfield K is algebraic over K
(define am14-alg '(SEP anq_ CC (IS-ALGEBRAIC-OVER kk anq_)))
(define (am14-inv-body n)
  (forall-guarded '(kk c b) (list '(IS-SUBFIELD-OF-CC kk) '(IN c (FUN NN kk)) (cp-van 'c (list 'succ n)) (list '= (list 'c n) 1)
                                  '(IN b CC) '(NOT (= b 0)) (list '= (cp-ps 'c 'b (list 'succ n)) 0))
    '(IS-ALGEBRAIC-OVER kk (recip b))))
(define (am14-setup! n)
  ;; the common opening: returns P = sum_{j < n} c_(j+1) b^j, with c_0 + b P = 0 landed
  (dk-project! '(IS-SUBRING-OF-CC kk) 'is-subfield-of-cc '(IS-SUBFIELD-OF-CC kk))
  (dk-project! '(FORALL ansf_ (IMPLIES (IN ansf_ kk) (IMPLIES (NOT (= ansf_ 0)) (IN (recip ansf_) kk)))) 'is-subfield-of-cc '(IS-SUBFIELD-OF-CC kk))
  (cp-sub-parts! 'kk)
  (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-zero-in) (fact 'nn-one-in)
  (cp-fcc! 'c 'kk)
  (fact 'fun-apply-type-c 'c 'NN 'kk 0) (fact 'fun-apply-type-c 'c 'NN 'CC 0)
  (let* ((sc (am14-sc 'c)) (p (cp-ps sc 'b n)))
    (dk-have! (list 'IN sc '(FUN NN kk))
      (lambda ()
        (dk-lam-type!
          (lambda () (let ((k (dk-di-var!))) (fact 'nn-succ-closed k) (fact 'fun-apply-type-c 'c 'NN 'kk (list 'succ k)) (ass)))
          (lambda () (fact 'nn-is-set) (ass)))))
    (cp-fcc! sc 'kk)
    (cp-ps-typ! sc 'b n)
    (let ((sh (dk-apply! (dk-cite! 'cc-ps-shift) n 'c 'b)))
      (dk-rewrite-h! (list '= (cp-ps 'c 'b (list 'succ n)) 0) (cp-ps 'c 'b (list 'succ n)) (list '+ '(c 0) (list '* 'b p))))
    p))
(define (am14-nonzero-const! n p)
  ;; c_0 /= 0: recip b = -(recip c_0) P, a product of numbers algebraic over kk
  (let ((s am14-alg) (rc '(recip (c 0))))
    (fact 'subset-mem-fwd 'kk 'CC '(c 0))
    (dk-apply! (dk-ctx-form '(FORALL ansf_ (IMPLIES (IN ansf_ kk) (IMPLIES (NOT (= ansf_ 0)) (IN (recip ansf_) kk))))) '(c 0))
    (fact 'subset-mem-fwd 'kk 'CC rc)
    (dk-have! '(AND (IN (c 0) CC) (NOT (= (c 0) 0))))
    (fact 'cc-recip-inverse '(c 0))
    (dk-have! '(AND (IN b CC) (NOT (= b 0))))
    (fact 'cc-recip-inverse 'b)
    (fact 'cc-recip-closed 'b)
    ;; the numbers algebraic over kk: a subring holding kk, b and P
    (dk-apply! (dk-cite! 'algebraic-numbers-subring) 'kk)
    (cp-sub-parts! s)
    (dk-have! '(IS-ALGEBRAIC-OVER kk b) (lambda () (am13-close! 'IS-ALGEBRAIC-OVER n 'c)))
    (dk-have! (list 'IN 'b s) (lambda () (in-sep! dk-ass! dk-ass!)))
    (dk-have! (list 'SUBSET 'kk s)
      (lambda ()
        (let ((x (subset-by-element!)))
          (fact 'subset-mem-fwd 'kk 'CC x)
          (dk-apply! (dk-cite! 'algebraic-of-ring-element) 'kk x)
          (in-sep! dk-ass! dk-ass!))))
    (let ((sc (am14-sc 'c)))
      (fact 'fun-codomain-superset sc 'NN 'kk s)
      (dk-apply! (dk-cite! 'cc-ps-in-subring n) s sc 'b))
    (fact 'subset-mem-fwd 'kk s rc)
    (cp-neg-in! s rc)
    (cp-mul-in! s (list '- rc) p)
    ;; recip b = -(recip c_0) P
    (let* ((pn (dk-name! p 'CC))
           (vn (dk-name! rc 'CC))
           (wn (dk-name! '(recip b) 'CC))
           (ec (dk-rewrite-h! (list '= (list '* '(c 0) rc) 1) rc vn))
           (eb (dk-rewrite-h! '(= (* b (recip b)) 1) '(recip b) wn))
           (hh (dk-rewrite-h! (list '= (list '+ '(c 0) (list '* 'b p)) 0) p pn))
           (yn (list '* (list '- vn) pn))
           (m1 (dk-rewrite-h! (list 'IN (list '* (list '- rc) p) s) rc vn))
           (m2 (dk-rewrite-h! m1 p pn)))
      (dk-have! (list '= (list '* 'b yn) 1)
        (lambda ()
          (let ((id (list '= (list '* 'b yn) (list '- (list '* '(c 0) vn) (list '* vn (list '+ '(c 0) (list '* 'b pn)))))))
            (dk-have! id (lambda () (crs)))
            (subst id)
            (subst (list '= (list '+ '(c 0) (list '* 'b pn)) 0))
            (subst (list '= (list '* '(c 0) vn) 1))
            (crs))))
      (dk-have! (list '= wn yn)
        (lambda ()
          (let ((id (list '= wn (list '+ (list '* (list '* 'b wn) yn) (list '* wn (list '- 1 (list '* 'b yn)))))))
            (dk-have! id (lambda () (crs)))
            (subst id)
            (subst (list '= (list '* 'b wn) 1))
            (subst (list '= (list '* 'b yn) 1))
            (crs))))
      (ma-sep-parts! m2)
      (subst (list '= '(recip b) wn))
      (subst (list '= wn yn))
      (ass))))

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (am14-inv-body 'n)))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (let ((p (am14-setup! 0)))
    (dk-have! '(NOT (= (c 0) 0))
      (lambda ()
        (di)
        (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
        (let ((h (dk-rewrite-h! '(= (c 0) 0) '(c 0) 1)))
          (ma-prop-with! (list h '(NOT (= 1 0)))))))
    (am14-nonzero-const! 0 p))
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (fact 'nn-succ-closed v) (fact 'nn-succ-closed (list 'succ v))
  (let* ((sv (list 'succ v)) (ssv (list 'succ sv)) (p (am14-setup! sv)) (sc (am14-sc 'c)))
    (use-em '(= (c 0) 0)
      (lambda ()
        ;; c_0 = 0: b P = 0, so P = 0, and P is the same kind of relation one degree lower
        (let ((h2 (dk-rewrite-h! (list '= (list '+ '(c 0) (list '* 'b p)) 0) '(c 0) 0)))
          (dk-have! (list '= (list '* 'b p) 0)
            (lambda ()
              (let ((id (list '= (list '* 'b p) (list '+ 0 (list '* 'b p)))))
                (dk-have! id (lambda () (crs)))
                (subst id)
                (ass))))
          (dk-have! (list '= p 0)
            (lambda ()
              (use-em (list '= p 0)
                (lambda () (ass))
                (lambda ()
                  (dk-apply! (dk-cite! 'cc-mul-nonzero 'b p))
                  (ma-prop-with! (list (list '= (list '* 'b p) 0) (list 'NOT (list '= (list '* 'b p) 0))))))))
          (dk-have! (cp-van sc sv)
            (lambda ()
              (dk-peel!)
              (let ((k (cadr (cadr (dk-goal)))))
                (fact 'nn-succ-closed k)
                (fact 'fun-apply-type-c 'c 'NN 'CC (list 'succ k))
                (dk-have! (list '<= ssv (list 'succ k)) (lambda () (dk-nn! (list '<= sv k))))
                (dk-apply! (dk-ctx-form (cp-van 'c ssv)) (list 'succ k))
                (dk-lam-b!)
                (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))
          (dk-have! (list '= (list sc v) 1)
            (lambda () (fact 'fun-apply-type-c 'c 'NN 'CC sv) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))
          (dk-apply! (dk-ctx-form ih) 'kk sc 'b)
          (ass)))
      (lambda () (am14-nonzero-const! sv p)))))
(qed 'recip-algebraic)

;;; (26) over a subfield a relation can be made monic; COR. 4.23, the field half; COR. 4.26
(sp (make-wff '(FORALL aa (SUBSET (SEP anfq_ CC (FORSOME anfa_ (AND (IN anfa_ aa)
     (FORSOME anfb_ (AND (IN anfb_ aa) (AND (NOT (= anfb_ 0)) (= (* anfq_ anfb_) anfa_))))))) (CC-FRACTION-FIELD aa)))))
(dk-peel!)
(mac 'CC-FRACTION-FIELD)
(dk-cite! 'subset-refl (am11-frac 'aa))
(ass)
(qed 'cc-fraction-field-sup)

;;; over a subfield K: a relation with a non-zero leading coefficient gives a monic one
(sp (make-wff (forall-guarded '(kk x) '((IS-SUBFIELD-OF-CC kk) (IS-ALGEBRAIC-OVER-FIELD kk x)) '(IS-ALGEBRAIC-OVER kk x))))
(dk-peel!)
(cp-ring!)
(dk-project! '(IS-SUBRING-OF-CC kk) 'is-subfield-of-cc '(IS-SUBFIELD-OF-CC kk))
(dk-project! '(FORALL ansf_ (IMPLIES (IN ansf_ kk) (IMPLIES (NOT (= ansf_ 0)) (IN (recip ansf_) kk)))) 'is-subfield-of-cc '(IS-SUBFIELD-OF-CC kk))
(cp-sub-parts! 'kk)
(fact 'cc-zero-in) (fact 'cc-one-in)
(let* ((nc (am13-open! 'IS-ALGEBRAIC-OVER-FIELD 'kk 'x (am13-field-body 'kk 'x))) (n (car nc)) (c (cadr nc))
       (ln (list c n)) (sn (list 'succ n)))
  (fact 'nn-succ-closed n)
  (cp-fcc! c 'kk)
  (fact 'fun-apply-type-c c 'NN 'kk n) (fact 'fun-apply-type-c c 'NN 'CC n)
  (dk-apply! (dk-ctx-form '(FORALL ansf_ (IMPLIES (IN ansf_ kk) (IMPLIES (NOT (= ansf_ 0)) (IN (recip ansf_) kk))))) ln)
  (dk-have! (list 'AND (list 'IN ln 'CC) (list 'NOT (list '= ln 0))))
  (fact 'cc-recip-inverse ln)
  (fact 'subset-mem-fwd 'kk 'CC (list 'recip ln))
  (let* ((rn (dk-name! (list 'recip ln) 'CC))
         (er (dk-rewrite-h! (list '= (list '* ln (list 'recip ln)) 1) (list 'recip ln) rn))
         (rk (dk-rewrite-h! (list 'IN (list 'recip ln) 'kk) (list 'recip ln) rn))
         (c1 (list 'VNB-LAMBDA 'anmk_ 'NN (list '* rn (list c 'anmk_)))))
    (dk-have! (list 'IN c1 '(FUN NN kk))
      (lambda ()
        (dk-lam-type!
          (lambda () (let ((k (dk-di-var!))) (fact 'fun-apply-type-c c 'NN 'kk k) (cp-mul-in! 'kk rn (list c k)) (ass)))
          (lambda () (fact 'nn-is-set) (ass)))))
    (cp-fcc! c1 'kk)
    (dk-have! (cp-van c1 sn)
      (lambda ()
        (dk-peel!)
        (let ((k (cadr (cadr (dk-goal)))))
          (fact 'fun-apply-type-c c 'NN 'CC k)
          (dk-apply! (dk-ctx-form (cp-van c sn)) k)
          (dk-lam-b!)
          (subst (list '= (list c k) 0))
          (crs))))
    (dk-have! (list '= (list c1 n) 1)
      (lambda ()
        (dk-lam-b!)
        (let ((id (list '= (list '* rn ln) (list '* ln rn))))
          (dk-have! id (lambda () (crs)))
          (subst id)
          (ass))))
    (dk-have! (cp-lcomb c1 c c rn 0)
      (lambda () (let ((k (dk-di-var!))) (fact 'fun-apply-type-c c 'NN 'CC k) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (crs)))))
    (cp-ps-typ! c 'x sn)
    (let ((lc (dk-apply! (dk-apply! (dk-cite! 'cc-ps-lincomb sn c c c1 rn 0)) 'x)))
      (dk-have! (list '= (cp-ps c1 'x sn) 0)
        (lambda () (subst lc) (subst (list '= (cp-ps c 'x sn) 0)) (crs))))
    (am13-close! 'IS-ALGEBRAIC-OVER n c1)))
(qed 'algebraic-field-to-monic)

;;; COR. 4.23, the field half: the numbers algebraic over a subfield K of C form a subfield of C
(define am15-f '(SEP anth_ CC (IS-ALGEBRAIC-OVER-FIELD kk anth_)))
(define am15-s '(SEP anq_ CC (IS-ALGEBRAIC-OVER kk anq_)))
(sp (make-wff '(FORALL kk (IMPLIES (IS-SUBFIELD-OF-CC kk) (IS-SUBFIELD-OF-CC (ALGEBRAIC-NUMBERS-OVER kk))))))
(dk-peel!)
(dk-project! '(IS-SUBRING-OF-CC kk) 'is-subfield-of-cc '(IS-SUBFIELD-OF-CC kk))
(mac 'ALGEBRAIC-NUMBERS-OVER)
(let ((e (ma-ext2! am15-f am15-s
           (lambda (w)
             (ma-sep-parts! (list 'IN w am15-f))
             (dk-apply! (dk-cite! 'algebraic-field-to-monic) 'kk w)
             (in-sep! dk-ass! dk-ass!))
           (lambda (w)
             (ma-sep-parts! (list 'IN w am15-s))
             (dk-apply! (dk-cite! 'algebraic-ring-to-field) 'kk w)
             (in-sep! dk-ass! dk-ass!)))))
  (subst e)
  (dk-apply! (dk-cite! 'algebraic-numbers-subring) 'kk)
  (mac 'is-subfield-of-cc)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (dk-peel!)
            (let* ((x (cadr (cadr (dk-goal)))))
              (ma-sep-parts! (list 'IN x am15-s))
              (let* ((nc (am13-open! 'IS-ALGEBRAIC-OVER 'kk x (am13-ring-body 'kk x))) (n (car nc)) (c (cadr nc)))
                (dk-apply! (dk-cite! 'recip-algebraic n) 'kk c x)
                (dk-have! (list 'AND (list 'IN x 'CC) (list 'NOT (list '= x 0))))
                (fact 'cc-recip-closed x)
                (in-sep! dk-ass! dk-ass!))))))))
(qed 'algebraic-numbers-over-subfield-field)

;;; COR. 4.26: theta is algebraic over Q iff theta lies in the field of fractions of the algebraic integers
(define am15-ai '(SEP anq_ CC (IS-ALGEBRAIC-OVER ZZ anq_)))
(sp (make-wff (forall-guarded '(th) '((IN th CC))
  (list 'IFF '(IS-ALGEBRAIC-OVER-FIELD QQ th) (list 'IN 'th (list 'CC-FRACTION-FIELD am15-ai))))))
(dk-peel!)
(dk-cite! 'zz-is-subring-of-cc)
(dk-cite! 'qq-is-subring-of-cc)
(dk-cite! 'qq-is-subfield-of-cc)
(fact 'cc-zero-in) (fact 'cc-one-in)
(dk-have! '(SUBSET ZZ QQ) (lambda () (let ((x (subset-by-element!))) (dk-type! x 'QQ))))
(dk-iff! (lambda (g) (dk-head-is? g 'IN))
  (lambda ()
    ;; algebraic over Q: k theta is an algebraic integer for a non-zero integer k, and theta = (k theta) / k
    (let ((fz (am11-frac 'ZZ)))
      (dk-cite! 'qq-in-zz-fractions)
      (dk-cite! 'cc-fraction-field-sup 'ZZ)
      (dk-apply! (dk-cite! 'algebraic-over-field-mono) 'QQ fz 'th)
      (dk-apply! (dk-cite! 'algebraic-over-field-mono) fz '(CC-FRACTION-FIELD ZZ) 'th)
      (let* ((k (dk-skolem! (dk-apply! (dk-cite! 'algebraic-over-fractions-scaled) 'ZZ 'th)))
             (kt (list '* k 'th)))
        (dk-type! k 'CC)
        (cp-type! kt)
        (dk-apply! (dk-cite! 'algebraic-of-ring-element) 'ZZ k)
        (mac 'CC-FRACTION-FIELD)
        (in-sep! dk-ass!
          (lambda ()
            (ew kt)
            (dk-conj-close!
              (lambda ()
                (cond ((dk-ass!) #t)
                      ((dk-head-is? (dk-goal) 'IN) (in-sep! dk-ass! dk-ass!))
                      (#t
                       (ew k)
                       (dk-conj-close!
                         (lambda ()
                           (cond ((dk-ass!) #t)
                                 ((dk-head-is? (dk-goal) 'IN) (in-sep! dk-ass! dk-ass!))
                                 (#t (crs))))))))))))))
  (lambda ()
    ;; theta b = a with a, b algebraic integers, b /= 0: theta = a recip(b), algebraic over Q
    (let ((fa (am11-frac am15-ai)))
      (dk-cite! 'cc-fraction-field-sub am15-ai)
      (fact 'subset-mem-fwd (list 'CC-FRACTION-FIELD am15-ai) fa 'th)
      (let* ((a (dk-skolem! (ma-sep-parts! (list 'IN 'th fa))))
             (b (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'anfb_) (dk-contains? f a))) (dk-asms)))))
        (ma-sep-parts! (list 'IN a am15-ai))
        (ma-sep-parts! (list 'IN b am15-ai))
        (dk-apply! (dk-cite! 'algebraic-over-mono) 'ZZ 'QQ a)
        (dk-apply! (dk-cite! 'algebraic-over-mono) 'ZZ 'QQ b)
        (let* ((nc (am13-open! 'IS-ALGEBRAIC-OVER 'QQ b (am13-ring-body 'QQ b))) (n (car nc)) (c (cadr nc)))
          (dk-apply! (dk-cite! 'recip-algebraic n) 'QQ c b))
        (dk-have! (list 'AND (list 'IN b 'CC) (list 'NOT (list '= b 0))))
        (fact 'cc-recip-inverse b)
        (fact 'cc-recip-closed b)
        (dk-split-all! (list (dk-apply! (dk-cite! 'algebraic-add-mul) 'QQ a (list 'recip b))))
        (let* ((wn (dk-name! (list 'recip b) 'CC))
               (eb (dk-rewrite-h! (list '= (list '* b (list 'recip b)) 1) (list 'recip b) wn))
               (h (dk-rewrite-h! (list 'IS-ALGEBRAIC-OVER 'QQ (list '* a (list 'recip b))) (list 'recip b) wn))
               (aw (list '* a wn)))
          (dk-apply! (dk-cite! 'algebraic-ring-to-field) 'QQ aw)
          (dk-have! (list '= 'th aw)
            (lambda ()
              (let ((id (list '= 'th (list '+ (list '* (list '* 'th b) wn) (list '* 'th (list '- 1 (list '* b wn)))))))
                (dk-have! id (lambda () (crs)))
                (subst id)
                (subst (list '= (list '* 'th b) a))
                (subst (list '= (list '* b wn) 1))
                (crs))))
          (subst (list '= 'th aw))
          (ass))))))
(qed 'algebraic-over-qq-iff-fraction-of-algebraic-integers)

;;; (29) PROP. 4.22: theta is algebraic of degree <= n over a subfield K of C iff theta V is contained in V for a
;;; non-trivial K-vector space V inside C of dimension <= n
(define (am18-sub-parts!)
  (dk-project! '(IS-SUBRING-OF-CC kk) 'is-subfield-of-cc '(IS-SUBFIELD-OF-CC kk))
