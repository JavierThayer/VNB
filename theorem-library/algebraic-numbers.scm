;;; theorem-library/algebraic-numbers.scm -- ALGEBRAIC NUMBERS IN C OVER A SUBRING AND OVER A SUBFIELD
;;; (ALGNUM, B7, 2026-10-26): the characteristic polynomial, Props. 4.18, 4.19, 4.22, 4.24, 4.25, Cor. 4.23 (the
;;; field half) and Cor. 4.26 of the algebraic-numbers notes.
;;; Vocabulary: structure-library/algnum-vocab.scm (IS-ALGEBRAIC-OVER, IS-ALGEBRAIC-OVER-FIELD,
;;; ALGEBRAIC-NUMBERS-OVER, IS-SUBRING-OF-CC, CC-LINCOMB, IS-CC-MODULE-OVER, IS-FG-CC-MODULE-OVER, CC-FRACTION-FIELD,
;;; IS-SUBFIELD-OF-CC, IS-CC-SPACE-DIM-LE, IS-ALGEBRAIC-OF-DEGREE-LE); POLY-2 (CF-CONS, cc-ps-cons, cc-ps-lincomb,
;;; cc-ps-congr, cc-ps-in-subring, cc-subring-power, IS-CC-SUBRING); the determinant over a ring (DET, MINOR,
;;; det-cofactor, adj-mul); the ring R = NORMED-FIELD-AS-COMMUTATIVE-RING(CC-NORMED-FIELD) and its read-offs
;;; cc-scalar-ring-*.  Helper prefixes: ma- (kit), cp-, am-, ap-, am8- .. am21-.
;;;
;;; THE HEADLINES.
;;;   characteristic-polynomial     DET(B - zI) is a polynomial in z with coefficients in K, z^n-coefficient (-1)^n
;;;                                 (det-linear-pencil-polynomial: DET(b + z e) for two matrices over K).
;;;   algebraic-iff-invariant-module  PROP. 4.18: r algebraic over a subring A (a root of a monic polynomial over A)
;;;                                 iff r V is contained in V for a non-trivial finitely generated A-module V in C.
;;;   algebraic-add-mul, algebraic-neg, algebraic-of-ring-element, algebraic-numbers-subring
;;;                                 PROP. 4.19: the numbers algebraic over A form a subring of C (the module of the
;;;                                 products g_i h_j: product-generators-exist, module-product-invariance).
;;;   algebraic-degree-iff-invariant-space  PROP. 4.22: theta algebraic of degree <= n over a subfield K iff
;;;                                 theta V is contained in V for a non-trivial K-space V in C of dimension <= n.
;;;   algebraic-numbers-over-subfield-field  COR. 4.23, the field half: ALGEBRAIC-NUMBERS-OVER(K) is a subfield
;;;                                 (recip-algebraic: 1/b from a monic relation of b, by induction on the degree,
;;;                                 dropping a zero constant term; algebraic-field-to-monic).  The countability
;;;                                 half is algebraic-numbers-countable (algnum-countable.scm).
;;;   algebraic-numbers-algebraically-closed, algebraic-numbers-factorization  PROP. 4.24: a polynomial of degree
;;;                                 >= 1 with coefficients algebraic over K has a root algebraic over K, and factors
;;;                                 completely, c(n) (z - a_0) ... (z - a_(n-1)), with every a_i algebraic over K
;;;                                 (fundamental-theorem-of-algebra / CH3-A's cc-poly-factorization for the complex
;;;                                 roots, algebraic-root-in-closure: a root is algebraic, through
;;;                                 algebraic-over-algebraic and the tower module algebraic-tower-module).
;;;   algebraic-over-fractions-scaled  PROP. 4.25: theta algebraic over the field of fractions of A gives k theta
;;;                                 algebraic over A for a non-zero k in A.
;;;   algebraic-over-qq-iff-fraction-of-algebraic-integers  COR. 4.26.
;;;
;;; 4.18 is proved in its COUNTED form (algebraic-monic-of-invariant-space, invariant-space-of-relation: the
;;; generator count bounds the degree and conversely); the uncounted 4.18 and the converse half of 4.22 are a few
;;; lines each from it (fg-module-dim-le, dim-le-fg-module).
;;;
;;; LOAD WINDOW.  lo: POLY-2 (poly-fn-vocab, poly-fn-laws, poly-fn-roots; unwired), CH3-A's ch3a-vocab and ch3a-factor
;;; (CC-PARTIAL-PROD, cc-poly-factorization; unwired), algnum-vocab, ca-lft-compose
;;; (cc-mul-zero-left, load.scm 3803), cauchy-estimates (fundamental-theorem-of-algebra, 3777), cc-exp
;;; (cc-power-add, cc-power-mul-base, 3762), cc-power-series-deriv (cc-series-partial-sum-lincomb, 3693),
;;; rake-asm-b3 (cc-scalar-ring-*, 3624), the determinant files.  hi: none.  Library: complex-analysis (the three
;;; complex-analysis citations above; without them the file would sit in analysis).

;;; (0) the ma- kit
;;; (0) the ma- kit (file-local; most from push-forward.scm's pfw- kit and product-measure.scm's pms- kit)

(define (ma-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; dk-project!, except that a claim equal to the focus goal is proved in place
(define (ma-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
;;; sequential map (MIT evaluates arguments right to left)
(define (ma-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (ma-for-each f l) (let loop ((l l)) (if (pair? l) (begin (f (car l)) (loop (cdr l))))))
;;; the right-hand conjuncts of an IFF in context whose left side is in context, landed (by prop, on a lane)
(define (ma-iff-parts! iff0)
  (let* ((iff (or (dk-ctx-form iff0) (error "ma-iff-parts!: not in context" (expression->string iff0))))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    ;; the conjunct that is the focus goal (closed in place) goes LAST: closing it moves the focus
    (let* ((goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
           (late  (filter goal? cs))
           (early (filter (lambda (c) (not (goal? c))) cs)))
      (ma-map (lambda (c) (ma-by-prop! c (list iff (cadr iff)))) (append early late))
      cs)))
;;; the LEFT side of an IFF in context whose right side is in context, landed
(define (ma-iff-back! iff0)
  (let ((iff (or (dk-ctx-form iff0) (error "ma-iff-back!: not in context" (expression->string iff0)))))
    (ma-by-prop! (cadr iff)
      (cons iff (let ((r (caddr iff)))
                  (if (dk-asm? r)
                      (list r)
                      (let loop ((r r) (acc '()))
                        (if (and (pair? r) (eq? (car r) 'AND) (not (dk-asm? r)))
                            (loop (caddr r) (cons (cadr r) acc))
                            (reverse (cons r acc))))))))))
;;; CLAIM by prop from the formulas FS: on a lane, or in place when CLAIM is the focus goal; returns CLAIM
(define (ma-by-prop! claim fs)
  (cond ((dk-asm? claim) (dk-ctx-form claim))
        ((eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
         (ma-prop-with! fs) claim)
        (#t (dk-have! claim (lambda () (ma-prop-with! fs))) (dk-ctx-form claim))))
;;; (IN w (SEP v A P)) in context: land (IN w A) and P[w], the membership kept; return P[w].
(define (ma-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s (caddr m)) (v (cadr s)) (dom (caddr s))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "ma-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (let ((c (dk-ctx-form conj))) (if c (ai c)))))
    p))
;;; class extensionality, each direction driven: FWD / BWD procedures of the element; lands lhs = rhs
(define (ma-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'mew_ (list 'IFF (list 'IN 'mew_ lhs) (list 'IN 'mew_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs)
  (list '= lhs rhs))
;;; w in BIG-UNION(v, D, g(v)) gives the index and w in g(index): returns (k . formula)
(define (ma-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (caddr bu)))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
;;; prove the focus goal (IN w bu) at the index k (k in D and w in the k-th term in context)
(define (ma-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
;;; prop on the named formulas only
(define (ma-prop-with! fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))
;;; (IN z (UNION a b)) from (IN z a) / (IN z b) in context
(define (ma-in-union-left! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-l) (dk-ass!))))
(define (ma-in-union-right! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-r) (dk-ass!))))
;;; (IN x (PAIR x x)), x in SET in context
(define (ma-in-singleton! xv)
  (dk-have! (list 'IN xv (list 'PAIR xv xv))
    (lambda ()
      (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
      (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) xv)))
        (dk-have! (list '= xv xv) (lambda () (rfl)))
        (ma-prop-with! (list pm (list '= xv xv)))))))
;;; with (IN b (PAIR x x)) and x in SET in context, land b = x
(define (ma-singleton-eq! b xv)
  (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
  (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) b)))
    (dk-have! (list '= b xv)
      (lambda () (ma-prop-with! (list pm (list 'IN b (list 'PAIR xv xv))))))
    (list '= b xv)))

;;; FINITE-SET INDUCTION (pms-induct!, product-measure.scm).  PROP-OF builds P(s); BASE! proves P(EMPTY-SET)
;;; on its leaf; (STEP! sv xv u ih) proves P(u), u = sv u {xv}, with ih = P(sv) in context.  Returns P(xs).
(define (ma-class prop-of) (list 'COMP 'miu_ (prop-of 'miu_)))
(define (ma-step-formula c)
  (list 'FORALL 'is_
    (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ c)))
      (list 'FORALL 'ix_
        (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
          (list 'IN '(UNION is_ (PAIR ix_ ix_)) c))))))
(define (ma-induct! xs prop-of base! step!)
  (let* ((c     (ma-class prop-of))
         (stepf (ma-step-formula c)))
    (have! (list 'IN 'EMPTY-SET c)
      (lambda ()
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) '(in empty-set set))
                (begin (fact 'empty-set-is-set) (ass))
                (base!)))
          (dk-opened (lambda () (comp-mi))))))
    (have! stepf
      (lambda ()
        (let* ((landed (dk-peel!))
               (g      (dk-goal))
               (u      (cadr g))
               (sv     (cadr u))
               (xv     (cadr (caddr u))))
          (dk-split-all! landed)
          (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
          (fact 'pairing xv xv)
          (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET)))
          (fact 'union-set-closure sv (list 'PAIR xv xv))
          (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv c)))))
                 (ih (car (filter (lambda (f) (not (equal? f (list 'in sv 'set)))) ls))))
            (for-each
              (lambda (leaf)
                (dk-focus! leaf)
                (if (equal? (dk-goal) (list 'in u 'set))
                    (ass)
                    (step! sv xv u ih)))
              (dk-opened (lambda () (comp-mi))))))))
    (dk-have! (list 'AND (list 'IN 'EMPTY-SET c) stepf))
    (let ((ind (dk-fact! 'finite-set-induction c)))
      (dk-have! (list 'AND (list 'IN xs 'SET) (list 'IN (list 'CARD xs) 'NN)))
      (let* ((inx (dk-apply! ind xs))
             (ls  (dk-landed (lambda () (comp-me inx)))))
        (car (filter (lambda (f) (not (equal? f (list 'in xs 'set)))) ls))))))
;;; the membership laws whose instances make the two memberships propositionally equivalent
(define (ma-ext-prop! lhs rhs cites)
  (let ((side (lambda (have)
                (lambda (w)
                  (let ((fs (ma-map (lambda (c) (apply dk-cite! (car c) (cdr c))) (cites w))))
                    (ma-prop-with! (cons (list 'IN w have) fs)))))))
    (ma-ext2! lhs rhs (side lhs) (side rhs))))

;;; (SUBSET (SEP v d p) d)
(define (ma-sep-subset! sep)
  (dk-have! (list 'SUBSET sep (caddr sep))
    (lambda ()
      (mac 'subset-def)
      (let ((z (dk-di-var!)))
        (ma-sep-parts! (list 'IN z sep))
        (ass)))))
;;; s subset of the finite set ca (ca in SET, CARD ca in NN in context): land (IN s SET), (IN (CARD s) NN)
(define (ma-finite-sub! s ca)
  (fact 'subclass-of-set-is-set s ca)
  (dk-have! (list 'AND (list 'IN ca 'SET) (list 'IN (list 'CARD ca) 'NN)))
  (let ((cs (dk-fact! 'card-subset-nn ca)))
    (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s ca z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))))
    (dk-apply! cs s)))

;;; case split on a right-nested disjunction ORF in context, one THUNK per disjunct (each run with that
;;; disjunct in context, on its own leaf)
(define (ma-or-split! orf thunks)
  (let* ((o (or (dk-ctx-form orf) (error "ma-or-split!: not in context" (expression->string orf))))
         (l (cadr o)) (r (caddr o)))
    (for-each
      (lambda (leaf)
        (dk-focus! leaf)
        (cond ((dk-asm? l) ((car thunks)))
              ((pair? (cddr thunks)) (ma-or-split! r (cdr thunks)))
              (#t ((cadr thunks)))))
      (dk-opened (lambda () (ai o))))))
;;; f in FUN(NN, A) and every f(k) in B: f in FUN(NN, B)   (pfw-retype!, push-forward.scm)
(define (ma-retype! fv a b in-b!)
  (dk-have! (list 'IN fv (list 'FUN 'NN b))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c fv 'NN a kv)
                (ma-then-ass! (lambda () (in-b! (list fv kv)))))
              (begin
                (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN fv (list 'FUN 'NN a))))))
                (ass))))))))
;;; a function symbol G in FUN(DOM, COD) with G(k) == BODY(k): returns (G . VALUE-EQUATION)   (pfw-abstract!)
(define (ma-abstract! dom cod body-of typer pre)
  (let* ((body  (body-of 'mak_))
         (lam   (list 'VNB-LAMBDA 'mak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'mak_ (list 'IMPLIES (list 'IN 'mak_ dom)
                                                    (list '== (list g 'mak_) body)))))
         (claim (list 'FORSOME 'mag_ (list 'AND (list 'IN 'mag_ (list 'FUN dom cod))
                                            (vals 'mag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!))))
                (let ((kv (dk-di-var!)))
                  (pre kv)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "ma-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "ma-abstract!: the value equation did not land"))))
      (cons g ve))))


;;; (6) THE CHARACTERISTIC POLYNOMIAL: matrices over C and their determinants, the ring R = C
(define cp-r '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define (cp-ring!)
  (fact 'cc-is-normed-field)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
  (dk-cite! 'commutative-ring-is-ring cp-r))
(define (cp-sign j) (list 'MPOW (list 'RING-MULTIPLICATIVE-MONOID cp-r) (list (list 'NEG cp-r) (list 'ONE cp-r)) j))
(define (cp-lin n b e z)
  (list 'MATOF n n (list 'VNB-LAMBDA '(LIST cpi_ cpj_) (list 'CARTESIAN (list 'INTERVAL 1 n) (list 'INTERVAL 1 n))
                     (list '+ (list 'ENTRY b 'cpi_ 'cpj_) (list '* z (list 'ENTRY e 'cpi_ 'cpj_))))))
(define (cp-type! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-type! t 'CC)))
;;; the parts of IS-SUBRING-OF-CC kk: (SUBSET kk CC), 0, 1 in kk, closures; returns nothing
(define (cp-sub-parts! kk)
  (dk-project! (list 'IS-CC-SUBRING kk) 'is-subring-of-cc (list 'IS-SUBRING-OF-CC kk))
  (dk-project! (list 'FORALL 'ansn_ (list 'IMPLIES (list 'IN 'ansn_ kk) (list 'IN '(- ansn_) kk)))
               'is-subring-of-cc (list 'IS-SUBRING-OF-CC kk))
  (ma-for-each (lambda (p) (dk-project! p 'is-cc-subring (list 'IS-CC-SUBRING kk)))
    (list (list 'SUBSET kk 'CC) (list 'IN 0 kk) (list 'IN 1 kk)
          (list 'FORALL 'psu_ (list 'IMPLIES (list 'IN 'psu_ kk) (list 'FORALL 'psv_ (list 'IMPLIES (list 'IN 'psv_ kk) (list 'IN '(+ psu_ psv_) kk)))))
          (list 'FORALL 'psu_ (list 'IMPLIES (list 'IN 'psu_ kk) (list 'FORALL 'psv_ (list 'IMPLIES (list 'IN 'psv_ kk) (list 'IN '(* psu_ psv_) kk))))))))
(define (cp-add-in! kk x y) (dk-apply! (dk-ctx-form (list 'FORALL 'psu_ (list 'IMPLIES (list 'IN 'psu_ kk) (list 'FORALL 'psv_ (list 'IMPLIES (list 'IN 'psv_ kk) (list 'IN '(+ psu_ psv_) kk)))))) x y))
(define (cp-mul-in! kk x y) (dk-apply! (dk-ctx-form (list 'FORALL 'psu_ (list 'IMPLIES (list 'IN 'psu_ kk) (list 'FORALL 'psv_ (list 'IMPLIES (list 'IN 'psv_ kk) (list 'IN '(* psu_ psv_) kk)))))) x y))
(define (cp-neg-in! kk x) (dk-apply! (dk-ctx-form (list 'FORALL 'ansn_ (list 'IMPLIES (list 'IN 'ansn_ kk) (list 'IN '(- ansn_) kk)))) x))

(define cp-nr1 (list (list 'NEG cp-r) (list 'ONE cp-r)))
;;; land (= NR1 (- 1)) and (IN NR1 CC), NR1 = (NEG R)(ONE R)
(define (cp-nr1!)
  (fact 'cc-one-in)
  (fact 'cc-neg-closed 1)
  (dk-have! (list '= cp-nr1 '(- 1))
    (lambda ()
      (subst (dk-cite! 'cc-scalar-ring-one))
      (subst (dk-cite! 'cc-scalar-ring-neg))
      (dk-lam-b!)
      (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
  (dk-have! (list 'IN cp-nr1 'CC) (lambda () (subst (list '= cp-nr1 '(- 1))) (ass))))

;;; the sign (-1)^j over R lies in every subring of C, and in CC
(sp (make-wff (list 'FORALL 'j (list 'IMPLIES '(IN j NN) (list 'FORALL 'kk (list 'IMPLIES '(IS-SUBRING-OF-CC kk)
  (list 'AND (list 'IN (cp-sign 'j) 'kk) (list 'IN (cp-sign 'j) 'CC))))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (cp-ring!)
  (cp-sub-parts! 'kk)
  (cp-nr1!)
  (subst (dk-cite! 'mpow-zero (list 'RING-MULTIPLICATIVE-MONOID cp-r) (list (list 'NEG cp-r) (list 'ONE cp-r))))
  (subst (dk-cite! 'rmm-iden cp-r))
  (subst (dk-cite! 'cc-scalar-ring-one))
  (fact 'cc-one-in)
  (dk-conj-close! dk-ass!)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (cp-ring!)
  (cp-sub-parts! 'kk)
  (fact 'cc-one-in)
  (fact 'cc-neg-closed 1)
  (cp-neg-in! 'kk 1)
  (let* ((s0 (cp-sign v)) (s1 (cp-sign (list 'succ v)))
         (nr1 (list (list 'NEG cp-r) (list 'ONE cp-r))))
    (dk-split! (dk-apply! (dk-ctx-form ih) 'kk))
    (let* ((w (dk-name! s0 'CC))
           (e1 (dk-cite! 'dtr-sign-succ cp-r v)))
      (cp-nr1!)
      (dk-rewrite-h! (list 'IN s0 'kk) s0 w)
      (dk-rewrite-h! (list 'IN s0 'CC) s0 w)
      (let ((e2 (list '= s1 (list '* '(- 1) w))))
        (dk-have! e2
          (lambda ()
            (subst e1)
            (subst (list '= s0 w))
            (subst (dk-cite! 'cc-scalar-ring-mul))
            (dk-lam-b!)
            (subst (list '= nr1 '(- 1)))
            (cp-type! (list '* '(- 1) w))
            (rfl)))
        (subst e2)
        (cp-mul-in! 'kk '(- 1) w)
        (cp-type! (list '* '(- 1) w))
        (dk-conj-close! dk-ass!)))))
(qed 'cc-sign-in-subring)

;;; (IN t (MAT m m CC)) <-> (IN t (MAT m m (CARR R)))
(define (cp-mat-carr! t m)
  (let ((f (list 'IN t (list 'MAT m m (list 'CARR cp-r)))))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (mac 'cc-scalar-ring-carr) (from-context!))))
    f))
(define (cp-mat-cc! t m)
  (let ((f (list 'IN t (list 'MAT m m 'CC))))
    (if (not (dk-asm? f))
        (dk-have! f (lambda () (fact 'cc-scalar-ring-carr) (subst (list '= 'CC (list 'CARR cp-r))) (from-context!))))
    f))
(define (cp-int-parts! a b v) (fact 'interval-elt-in-nn a b v) (fact 'interval-lo a b v) (fact 'interval-hi a b v))

;;; LIN(n, b, e, z) = (b_ij + z e_ij) is an n-by-n complex matrix with those entries
(define cp-lin-entries
  (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n)) (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 n))
    (list '= (list 'ENTRY (cp-lin 'n 'b 'e 'z) 'i 'j) '(+ (ENTRY b i j) (* z (ENTRY e i j)))))))))
(sp (make-wff (forall-guarded '(n b e z) '((IN n NN) (IN b (MAT n n CC)) (IN e (MAT n n CC)) (IN z CC))
  (list 'AND (list 'IN (cp-lin 'n 'b 'e 'z) '(MAT n n CC)) cp-lin-entries))))
(dk-peel!)
(let* ((g (cadddr (cp-lin 'n 'b 'e 'z)))
       (val! (lambda (i j)
               (fact 'entry-in-carrier 'n 'n 'CC 'b i j)
               (fact 'entry-in-carrier 'n 'n 'CC 'e i j)
               (cp-type! (list '+ (list 'ENTRY 'b i j) (list '* 'z (list 'ENTRY 'e i j))))))
       (gij! (lambda (i j)
               (val! i j)
               (let ((eq (list '= (list g i j) (list '+ (list 'ENTRY 'b i j) (list '* 'z (list 'ENTRY 'e i j))))))
                 (dk-have! eq (lambda () (if (not (dk-lam-b!)) (rfl))))
                 eq))))
  (dk-have! (list 'FORALL 'cpu_ (list 'IMPLIES '(IN cpu_ (INTERVAL 1 n)) (list 'FORALL 'cpv_ (list 'IMPLIES '(IN cpv_ (INTERVAL 1 n)) (list 'IN (list g 'cpu_ 'cpv_) 'CC)))))
    (lambda ()
      (let* ((ls (dk-peel!)) (vs (ma-map cadr ls)) (i (car vs)) (j (cadr vs)))
        (subst (gij! i j))
        (ass))))
  (dk-have! (list 'FORALL 'cpu_ (list 'IMPLIES '(IN cpu_ (INTERVAL 1 n)) (list 'FORALL 'cpv_ (list 'IMPLIES '(IN cpv_ (INTERVAL 1 n)) (list 'IN (list g 'cpu_ 'cpv_) 'SET)))))
    (lambda ()
      (let* ((ls (dk-peel!)) (vs (ma-map cadr ls)) (i (car vs)) (j (cadr vs)))
        (subst (gij! i j))
        (fact 'membership-implies-sethood (list '+ (list 'ENTRY 'b i j) (list '* 'z (list 'ENTRY 'e i j))) 'CC)
        (ass))))
  (dk-apply! (dk-cite! 'matof-in-mat 'n 'n 'CC g))
  (dk-have! cp-lin-entries
    (lambda ()
      (let* ((ls (dk-peel!)) (vs (ma-map cadr ls)) (i (car vs)) (j (cadr vs)))
        (dk-apply! (dk-cite! 'entry-of-matof 'n 'n g i j))
        (subst (list '= (list 'ENTRY (cp-lin 'n 'b 'e 'z) i j) (list g i j)))
        (gij! i j))))
  (dk-conj-close! dk-ass!))
(qed 'cp-lin-mat)

;;; the index map of a minor lands in the bigger index set
;;; CUT 2026-10-27 (integration): `cp-minor-index-in-range' was an accidental duplicate -- its statement is alpha-equal to the tree's
;;; `dtr-skip-in', which is cited below in its place (proven-duplicate audit).

;;; the (1, j) minor of LIN(n + 1, b, e, z) is LIN(n, minor b, minor e, z)
(define (cp-minor m j n) (list 'MINOR m 1 j n))
(sp (make-wff (forall-guarded '(n b e j z) '((IN n NN) (IN b (MAT (succ n) (succ n) CC)) (IN e (MAT (succ n) (succ n) CC))
                                              (IN j (INTERVAL 1 (succ n))) (IN z CC))
  (list '= (cp-minor (cp-lin '(succ n) 'b 'e 'z) 'j 'n) (cp-lin 'n (cp-minor 'b 'j 'n) (cp-minor 'e 'j 'n) 'z)))))
(dk-peel!)
(cp-ring!)
(fact 'nn-succ-closed 'n)
(fact 'nn-one-in)
(fact 'interval-elt-in-nn 1 '(succ n) 'j)
(let* ((sn '(succ n)) (l (cp-lin sn 'b 'e 'z)) (p (cp-minor l 'j 'n))
       (mb (cp-minor 'b 'j 'n)) (me (cp-minor 'e 'j 'n)) (q (cp-lin 'n mb me 'z))
       (lp (dk-apply! (dk-cite! 'cp-lin-mat) sn 'b 'e 'z)))
  (dk-split! lp)
  (ma-for-each (lambda (t) (cp-mat-carr! t sn)) (list l 'b 'e))
  (ma-for-each (lambda (t) (dk-apply! (dk-cite! 'minor-type cp-r t 1 'j 'n)) (cp-mat-cc! (cp-minor t 'j 'n) 'n)) (list l 'b 'e))
  (let ((lq (dk-apply! (dk-cite! 'cp-lin-mat) 'n mb me 'z)))
    (dk-split! lq)
    (dk-have! (list 'FORALL 'cpu_ (list 'IMPLIES '(IN cpu_ (INTERVAL 1 n)) (list 'FORALL 'cpv_ (list 'IMPLIES '(IN cpv_ (INTERVAL 1 n))
                (list '= (list 'ENTRY p 'cpu_ 'cpv_) (list 'ENTRY q 'cpu_ 'cpv_))))))
      (lambda ()
        (let* ((ls (dk-peel!)) (vs (ma-map cadr ls)) (u (car vs)) (v (cadr vs))
               (ii (list 'IF (list '< u 1) u (list 'succ u))) (jj (list 'IF (list '< v 'j) v (list 'succ v))))
          (dk-apply! (dk-cite! 'dtr-skip-in) 'n 1 u)
          (dk-apply! (dk-cite! 'dtr-skip-in) 'n 'j v)
          (let* ((e1 (dk-apply! (dk-cite! 'minor-entry cp-r l 1 'j 'n u v)))
                (e2 (dk-apply! (dk-cite! 'minor-entry cp-r 'b 1 'j 'n u v)))
                (e3 (dk-apply! (dk-cite! 'minor-entry cp-r 'e 1 'j 'n u v)))
                (e4 (dk-apply! (caddr lp) ii jj))
                (e5 (dk-apply! (caddr lq) u v)))
            (fact 'entry-in-carrier sn sn 'CC 'b ii jj)
            (fact 'entry-in-carrier sn sn 'CC 'e ii jj)
            (subst e1) (subst e4) (subst e5) (subst e2) (subst e3)
            (cp-type! (list '+ (list 'ENTRY 'b ii jj) (list '* 'z (list 'ENTRY 'e ii jj))))
            (rfl)))))
    (dk-apply! (dk-cite! 'matrix-entry-extensionality 'n 'n 'CC p q))
    (ass)))
(qed 'cp-lin-minor)


;;; (7) polynomial algebra on coefficient sequences (POLY-2's sums): zero, sum, and (al + z be) times
(define (cp-ps c z n) (list 'CC-SERIES-PARTIAL-SUM (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list c 'pfj_) (list 'power z 'pfj_))) n))
(define (cp-van c n) (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) (list 'IMPLIES (list '<= n 'pfk_) (list '= (list c 'pfk_) 0)))))
(define (cp-lcomb e c d al be) (list 'FORALL 'pfk_ (list 'IMPLIES '(IN pfk_ NN) (list '= (list e 'pfk_) (list '+ (list '* al (list c 'pfk_)) (list '* be (list d 'pfk_)))))))
(define (cp-ps-typ! c z n)
  (let ((h (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list c 'pfj_) (list 'power z 'pfj_)))))
    (dk-have! (list 'IN h '(FUN NN CC))
      (lambda ()
        (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (fact 'fun-apply-type-c c 'NN 'CC j) (cp-type! (list '* (list c j) (list 'power z j))) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))
                      (lambda () (fact 'nn-is-set) (ass)))))
    (dk-cite! 'cc-series-partial-sum-in-cc n h)))
;;; (IN c (FUN NN CC)) from (IN c (FUN NN kk)), kk subset CC in context
(define (cp-fcc! c kk) (fact 'fun-codomain-superset c 'NN kk 'CC))

;;; the zero sequence
(define cp-z0 '(VNB-LAMBDA cpk_ NN 0))
(sp (make-wff (list 'FORALL 'kk (list 'IMPLIES '(IS-SUBRING-OF-CC kk) (list 'AND (list 'IN cp-z0 '(FUN NN kk))
  (list 'AND (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (cp-van cp-z0 'm)))
             (list 'FORALL 'nz (list 'IMPLIES '(IN nz NN) (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (list '= (cp-ps cp-z0 'z 'nz) 0)))))))))))
(dk-peel!)
(cp-sub-parts! 'kk)
(fact 'nn-is-set)
(dk-have! (list 'IN cp-z0 '(FUN NN kk)) (lambda () (dk-lam-type! (lambda () (dk-di-var!) (ass)) (lambda () (ass)))))
(cp-fcc! cp-z0 'kk)
(fact 'cc-zero-in)
(dk-have! (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (cp-van cp-z0 'm)))
  (lambda () (let ((ls (dk-peel!))) (if (not (dk-lam-b!)) (rfl)))))
(dk-have! (cp-lcomb cp-z0 cp-z0 cp-z0 0 0)
  (lambda () (dk-di-var!) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (crs))))
(dk-have! (list 'FORALL 'nz (list 'IMPLIES '(IN nz NN) (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (list '= (cp-ps cp-z0 'z 'nz) 0)))))
  (lambda ()
    (let* ((ls (dk-peel!)) (vs (ma-map cadr ls)) (nz (car vs)) (z (cadr vs)))
      (cp-ps-typ! cp-z0 z nz)
      (subst (dk-apply! (dk-apply! (dk-cite! 'cc-ps-lincomb nz cp-z0 cp-z0 cp-z0 0 0)) z))
      (crs))))
(dk-conj-close! dk-ass!)
(qed 'cp-zero-coefficients)

;;; the sum of two coefficient sequences
(define (cp-sum c1 c2) (list 'VNB-LAMBDA 'cpk_ 'NN (list '+ (list c1 'cpk_) (list c2 'cpk_))))
(sp (make-wff (list 'FORALL 'nn_ (list 'IMPLIES '(IN nn_ NN) (list 'FORALL 'kk (list 'IMPLIES '(IS-SUBRING-OF-CC kk)
  (forall-guarded '(c1 c2) (list '(IN c1 (FUN NN kk)) '(IN c2 (FUN NN kk)) (cp-van 'c1 'nn_) (cp-van 'c2 'nn_))
    (list 'AND (list 'IN (cp-sum 'c1 'c2) '(FUN NN kk))
      (list 'AND (cp-van (cp-sum 'c1 'c2) 'nn_)
        (list 'AND (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '= (list (cp-sum 'c1 'c2) 'k) '(+ (c1 k) (c2 k)))))
          (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (list '= (cp-ps (cp-sum 'c1 'c2) 'z 'nn_) (list '+ (cp-ps 'c1 'z 'nn_) (cp-ps 'c2 'z 'nn_)))))))))))))))
(dk-peel!)
(cp-sub-parts! 'kk)
(fact 'nn-is-set)
(fact 'cc-one-in)
(let* ((s (cp-sum 'c1 'c2))
       (val! (lambda (k) (fact 'fun-apply-type-c 'c1 'NN 'kk k) (fact 'fun-apply-type-c 'c2 'NN 'kk k)
                         (fact 'subset-mem-fwd 'kk 'CC (list 'c1 k)) (fact 'subset-mem-fwd 'kk 'CC (list 'c2 k)))))
  (dk-have! (list 'IN s '(FUN NN kk))
    (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (val! k) (cp-add-in! 'kk (list 'c1 k) (list 'c2 k)) (ass))) (lambda () (ass)))))
  (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '= (list s 'k) '(+ (c1 k) (c2 k)))))
    (lambda () (let ((k (dk-di-var!))) (val! k) (cp-type! (list '+ (list 'c1 k) (list 'c2 k))) (if (not (dk-lam-b!)) (rfl)))))
  (dk-have! (cp-van s 'nn_)
    (lambda ()
      (let* ((ls (dk-peel!)) (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ls))))
        (val! k)
        (dk-apply! (dk-ctx-form (cp-van 'c1 'nn_)) k)
        (dk-apply! (dk-ctx-form (cp-van 'c2 'nn_)) k)
        (dk-lam-b!)
        (subst (list '= (list 'c1 k) 0)) (subst (list '= (list 'c2 k) 0))
        (crs))))
  (cp-fcc! 'c1 'kk) (cp-fcc! 'c2 'kk) (cp-fcc! s 'kk)
  (dk-have! (cp-lcomb s 'c1 'c2 1 1)
    (lambda () (let ((k (dk-di-var!))) (val! k) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (crs)))))
  (dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (list '= (cp-ps s 'z 'nn_) (list '+ (cp-ps 'c1 'z 'nn_) (cp-ps 'c2 'z 'nn_)))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (cp-ps-typ! 'c1 z 'nn_) (cp-ps-typ! 'c2 z 'nn_)
        (subst (dk-apply! (dk-apply! (dk-cite! 'cc-ps-lincomb 'nn_ 'c1 'c2 s 1 1)) z))
        (crs))))
  (dk-conj-close! dk-ass!))
(qed 'cp-sum-coefficients)

;;; (al + z be) times a polynomial: coefficients al c(k) + be c(k - 1)
(define (cp-shift al be c) (list 'VNB-LAMBDA 'cpk_ 'NN (list '+ (list '* al (list c 'cpk_)) (list '* be (list (list 'CF-CONS 0 c) 'cpk_)))))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'kk (list 'IMPLIES '(IS-SUBRING-OF-CC kk)
  (forall-guarded '(c al be) (list '(IN c (FUN NN kk)) (cp-van 'c '(succ n)) '(IN al kk) '(IN be kk))
    (list 'AND (list 'IN (cp-shift 'al 'be 'c) '(FUN NN kk))
      (list 'AND (cp-van (cp-shift 'al 'be 'c) '(succ (succ n)))
        (list 'AND (list '= (list (cp-shift 'al 'be 'c) '(succ n)) '(* be (c n)))
          (list 'FORALL 'z (list 'IMPLIES '(IN z CC)
            (list '= (cp-ps (cp-shift 'al 'be 'c) 'z '(succ (succ n))) (list '* '(+ al (* z be)) (cp-ps 'c 'z '(succ n))))))))))))))))
(dk-peel!)
(cp-sub-parts! 'kk)
(fact 'nn-is-set)
(fact 'cc-zero-in)
(fact 'nn-succ-closed 'n)
(fact 'nn-succ-closed '(succ n))
(let* ((q (cp-shift 'al 'be 'c)) (f0 '(CF-CONS 0 c)) (sn '(succ n)) (ssn '(succ (succ n)))
       (vc (cp-van 'c sn)))
  (dk-apply! (dk-cite! 'cf-cons-in-fun 'kk) 0 'c)
  (cp-fcc! 'c 'kk) (cp-fcc! f0 'kk)
  (fact 'subset-mem-fwd 'kk 'CC 'al) (fact 'subset-mem-fwd 'kk 'CC 'be)
  (let ((val! (lambda (k)
                (fact 'fun-apply-type-c 'c 'NN 'kk k) (fact 'fun-apply-type-c f0 'NN 'kk k)
                (fact 'subset-mem-fwd 'kk 'CC (list 'c k)) (fact 'subset-mem-fwd 'kk 'CC (list f0 k)))))
    (dk-have! (list 'IN q '(FUN NN kk))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((k (dk-di-var!)))
              (val! k)
              (cp-mul-in! 'kk 'al (list 'c k)) (cp-mul-in! 'kk 'be (list f0 k))
              (cp-add-in! 'kk (list '* 'al (list 'c k)) (list '* 'be (list f0 k)))
              (ass)))
          (lambda () (ass)))))
    (cp-fcc! q 'kk)
    (dk-have! (cp-lcomb q 'c f0 'al 'be)
      (lambda () (let ((k (dk-di-var!))) (val! k) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))))
    ;; the value at n + 1
    (dk-have! (list '= (list q sn) '(* be (c n)))
      (lambda ()
        (val! sn) (val! 'n)
        (dk-apply! (dk-ctx-form (cp-lcomb q 'c f0 'al 'be)) sn)
        (subst (list '= (list q sn) (list '+ (list '* 'al (list 'c sn)) (list '* 'be (list f0 sn)))))
        (dk-have! (list '<= sn sn) (lambda () (dk-nn!)))
        (dk-apply! (dk-ctx-form vc) sn)
        (subst (dk-apply! (dk-cite! 'cf-cons-succ 0) 'c 'n))
        (subst (list '= (list 'c sn) 0))
        (crs)))
    ;; vanishing from n + 2
    (dk-have! (cp-van q ssn)
      (lambda ()
        (let* ((ls (dk-peel!)) (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ls))))
          (val! k)
          (dk-apply! (dk-ctx-form (cp-lcomb q 'c f0 'al 'be)) k)
          (subst (list '= (list q k) (list '+ (list '* 'al (list 'c k)) (list '* 'be (list f0 k)))))
          (ma-or-split! (dk-cite! 'nn-zero-or-succ k)
            (list
              (lambda ()
                (dk-have! '(< 0 0) (lambda () (dk-nn! (list '= k 0) (list '<= ssn k))))
                (dk-cite! 'rr-lt-irrefl 0)
                (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0)))))
              (lambda ()
                (let ((p (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f k))) (dk-asms)))))
                  (dk-have! (list '<= sn k) (lambda () (dk-nn! (list '<= ssn k))))
                  (dk-have! (list '<= sn p) (lambda () (dk-nn! (list '<= ssn k) (list '= k (list 'succ p)))))
                  (dk-apply! (dk-ctx-form vc) k)
                  (dk-apply! (dk-ctx-form vc) p)
                  (subst (list '= k (list 'succ p)))
                  (subst (dk-apply! (dk-cite! 'cf-cons-succ 0) 'c p))
                  (subst (list '= (list 'c p) 0))
                  (dk-rewrite-h! (list '= (list 'c k) 0) k (list 'succ p))
                  (subst (list '= (list 'c (list 'succ p)) 0))
                  (crs))))))))
    ;; the value of the polynomial
    (dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z CC)
                (list '= (cp-ps q 'z ssn) (list '* '(+ al (* z be)) (cp-ps 'c 'z sn)))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (cp-ps-typ! 'c z sn) (cp-ps-typ! 'c z ssn) (cp-ps-typ! f0 z ssn)
          (subst (dk-apply! (dk-apply! (dk-cite! 'cc-ps-lincomb ssn 'c f0 q 'al 'be)) z))
          (subst (dk-apply! (dk-cite! 'cc-ps-cons sn) 0 'c z))
          (let* ((st (dk-apply! (dk-apply! (dk-cite! 'cc-ps-stable 1 sn 'c)) z))
                 (e1 (dk-cite! 'nn-succ-plus-one sn))
                 (st2 (dk-rewrite-h! st (list '+ sn 1) ssn)))
            (subst st2)
            (crs)))))
    (dk-conj-close! dk-ass!)))
(qed 'cp-shift-coefficients)


;;; (8) the cofactor summands and their partial sums
(define cp-ag (list 'RING-ADDITIVE-AG cp-r))
(define (cp-summ n a)
  (list 'VNB-LAMBDA 'j (list 'INTERVAL 1 (list 'succ n))
    (list (list 'MUL cp-r) (cp-sign '(succ j)) (list (list 'MUL cp-r) (list 'ENTRY a 1 'j) (list 'DET cp-r n (list 'MINOR a 1 'j n))))))
(define (cp-fs f s) (list 'FINSUM cp-ag f s))

;;; a minor of a matrix over kk is a matrix over kk
(sp (make-wff (forall-guarded '(n kk s j) '((IN n NN) (IN s (MAT (succ n) (succ n) kk)) (IN j (INTERVAL 1 (succ n))))
  '(IN (MINOR s 1 j n) (MAT n n kk)))))
(dk-peel!)
(fact 'nn-succ-closed 'n)
(mac 'MINOR)
(let* ((g (cadddr (cadr (dk-goal)))))
  (dk-have! (list 'FORALL 'cpu_ (list 'IMPLIES '(IN cpu_ (INTERVAL 1 n)) (list 'FORALL 'cpv_ (list 'IMPLIES '(IN cpv_ (INTERVAL 1 n)) (list 'IN (list g 'cpu_ 'cpv_) 'kk)))))
    (lambda ()
      (let* ((ls (dk-peel!)) (vs (ma-map cadr ls)) (u (car vs)) (v (cadr vs)))
        (dk-apply! (dk-cite! 'dtr-skip-in) 'n 1 u)
        (dk-apply! (dk-cite! 'dtr-skip-in) 'n 'j v)
        (fact 'entry-in-carrier '(succ n) '(succ n) 'kk 's (list 'IF (list '< u 1) u (list 'succ u)) (list 'IF (list '< v 'j) v (list 'succ v)))
        (dk-lam-b!)
        (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))))
  (dk-apply! (dk-cite! 'matof-in-mat 'n 'n 'kk g))
  (ass))
(qed 'cp-minor-in-subring)

;;; the value of a summand at j, over C
(sp (make-wff (forall-guarded '(n a jx) '((IN n NN) (IN a (MAT (succ n) (succ n) CC)) (IN jx (INTERVAL 1 (succ n))))
  (list 'AND (list '= (list (cp-summ 'n 'a) 'jx) (list '* (cp-sign '(succ jx)) (list '* '(ENTRY a 1 jx) (list 'DET cp-r 'n '(MINOR a 1 jx n)))))
             (list 'IN (list (cp-summ 'n 'a) 'jx) 'CC)))))
(dk-peel!)
(cp-ring!)
(fact 'nn-succ-closed 'n)
(fact 'nn-one-in)
(fact 'interval-elt-in-nn 1 '(succ n) 'jx)
(fact 'nn-succ-closed 'jx)
(fact 'cc-scalar-ring-carr)
(let* ((sg (cp-sign '(succ jx))) (mi '(MINOR a 1 jx n)) (dt (list 'DET cp-r 'n mi))
       (val (list '* sg (list '* '(ENTRY a 1 jx) dt))))
  (cp-mat-carr! 'a '(succ n))
  (dk-apply! (dk-cite! 'minor-type cp-r 'a 1 'jx 'n))
  (dk-apply! (dk-cite! 'det-in-carrier cp-r 'n mi))
  (dk-apply! (dk-cite! 'dtr-sign-type cp-r '(succ jx)))
  (ma-for-each (lambda (t) (dk-have! (list 'IN t 'CC) (lambda () (subst (list '= 'CC (list 'CARR cp-r))) (ass)))) (list dt sg))
  (dk-have! '(IN 1 (INTERVAL 1 (succ n))) (lambda () (dk-have! '(<= 1 1) (lambda () (dk-nn!))) (dk-have! '(<= 1 (succ n)) (lambda () (dk-nn!))) (dk-apply! (dk-cite! 'interval-mem-intro 1 '(succ n) 1)) (ass)))
  (fact 'entry-in-carrier '(succ n) '(succ n) 'CC 'a 1 'jx)
  (cp-type! (list '* '(ENTRY a 1 jx) dt))
  (cp-type! val)
  (dk-have! (list '= (list (cp-summ 'n 'a) 'jx) val)
    (lambda ()
      (dk-lam-b!)
      (subst (dk-cite! 'cc-scalar-ring-mul))
      (dk-lam-b!)
      (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
  (dk-have! (list 'IN (list (cp-summ 'n 'a) 'jx) 'CC) (lambda () (subst (list '= (list (cp-summ 'n 'a) 'jx) val)) (ass)))
  (dk-conj-close! dk-ass!))
(qed 'cp-summand-value)

;;; a partial cofactor sum, one more term
(sp (make-wff (forall-guarded '(n a k) '((IN n NN) (IN a (MAT (succ n) (succ n) CC)) (IN k NN) (<= (succ k) (succ n)))
  (list 'AND (list 'IN (cp-fs (cp-summ 'n 'a) '(INTERVAL 1 k)) 'CC)
    (list '= (cp-fs (cp-summ 'n 'a) '(INTERVAL 1 (succ k)))
             (list '+ (cp-fs (cp-summ 'n 'a) '(INTERVAL 1 k)) (list (cp-summ 'n 'a) '(succ k))))))))
(dk-peel!)
(cp-ring!)
(fact 'nn-succ-closed 'n)
(fact 'nn-succ-closed 'k)
(fact 'nn-one-in)
(let* ((f (cp-summ 'n 'a)) (ik '(INTERVAL 1 k)) (sk '(succ k)) (un (list 'UNION ik (list 'PAIR sk sk)))
       (in-big! (lambda (w)
                  ;; w in INTERVAL(1, k) or w = succ k gives w in INTERVAL(1, succ n) and the summand typing
                  (dk-split! (dk-apply! (dk-cite! 'cp-summand-value) 'n 'a w)))))
  (dk-cite! 'ring-additive-ag-is-abelian-group cp-r)
  (fact 'cc-scalar-ring-carr)
  (dk-have! (list 'IN (list 'CARR cp-ag) 'SET) (lambda () (subst (dk-cite! 'ras-carr cp-r)) (subst (list '= (list 'CARR cp-r) 'CC)) (fact 'cc-is-set) (ass)))
  (dk-have! (list '= (list 'CARR cp-ag) 'CC) (lambda () (subst (dk-cite! 'ras-carr cp-r)) (subst (list '= (list 'CARR cp-r) 'CC)) (fact 'cc-is-set) (rfl)))
  (fact 'interval-in-set 1 'k)
  (dk-apply! (dk-cite! 'interval-card-in-nn 1 'k))
  (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z ik) (list 'IN (list f 'z) (list 'CARR cp-ag))))
    (lambda ()
      (let ((w (dk-di-var!)))
        (cp-int-parts! 1 'k w)
        (dk-have! (list '<= w '(succ n)) (lambda () (dk-nn! (list '<= w 'k) '(<= (succ k) (succ n)))))
        (dk-apply! (dk-cite! 'interval-mem-intro 1 '(succ n) w))
        (in-big! w)
        (subst (list '= (list 'CARR cp-ag) 'CC))
        (ass))))
  (dk-apply! (dk-cite! 'finsum-type-ptwise cp-ag) ik f)
  (dk-have! (list 'IN (cp-fs f ik) 'CC) (lambda () (subst (list '= 'CC (list 'CARR cp-ag))) (ass)))
  ;; insert succ k
  (let* ((e0 (dk-cite! 'interval-succ-insert 'k)))
    (fact 'membership-implies-sethood sk 'NN)
    (dk-have! (list 'NOT (list 'IN sk ik))
      (lambda ()
        (di)
        (cp-int-parts! 1 'k sk)
        (dk-have! '(< 0 0) (lambda () (dk-nn! (list '<= sk 'k))))
        (dk-cite! 'rr-lt-irrefl 0)
        (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0))))))
    (dk-have! (list '<= 1 sk) (lambda () (dk-nn!)))
    (dk-apply! (dk-cite! 'interval-mem-intro 1 '(succ n) sk))
    (in-big! sk)
    (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ un) (list 'IN (list f 'z_) (list 'CARR cp-ag))))
      (lambda ()
        (let* ((w (dk-di-var!))
               (or1 (car (ma-iff-parts! (dk-cite! 'union-membership ik (list 'PAIR sk sk) w)))))
          (ma-or-split! or1
            (list
              (lambda () (dk-apply! (dk-ctx-form (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z ik) (list 'IN (list f 'z) (list 'CARR cp-ag))))) w) (ass))
              (lambda ()
                (ma-singleton-eq! w sk)
                (subst (list '= w sk))
                (subst (list '= (list 'CARR cp-ag) 'CC))
                (ass)))))))
    (let ((e1 (dk-apply! (dk-cite! 'finsum-insert-ptwise cp-ag) ik sk f)))
      (dk-have! (list '= (cp-fs f '(INTERVAL 1 (succ k))) (list '+ (cp-fs f ik) (list f sk)))
        (lambda ()
          (subst e0)
          (subst e1)
          (subst (dk-cite! 'ras-op cp-r))
          (let ((w1 (dk-name! (cp-fs f ik) 'CC)) (w2 #f))
            (subst (list '= (cp-fs f ik) w1))
            (set! w2 (dk-name! (list f sk) 'CC))
            (subst (list '= (list f sk) w2))
            (subst (dk-cite! 'cc-scalar-ring-add))
            (dk-lam-b!))
          (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
      (dk-conj-close! dk-ass!))))
(qed 'cp-finsum-step)

;;; (9) the partial cofactor sums of DET(b + z e) are polynomials in z (induction on the number of terms)
(define (cp-gbody n kk)
  (forall-guarded '(cpb_ cpe_) (list (list 'IN 'cpb_ (list 'MAT n n kk)) (list 'IN 'cpe_ (list 'MAT n n kk)))
    (list 'FORSOME 'cpc_ (list 'AND (list 'IN 'cpc_ (list 'FUN 'NN kk))
      (list 'AND (cp-van 'cpc_ (list 'succ n))
        (list 'AND (list '= (list 'cpc_ n) (list 'DET cp-r n 'cpe_))
          (list 'FORALL 'cpz_ (list 'IMPLIES '(IN cpz_ CC)
            (list '= (list 'DET cp-r n (cp-lin n 'cpb_ 'cpe_ 'cpz_)) (cp-ps 'cpc_ 'cpz_ (list 'succ n)))))))))))
(define (cp-qbody n kk b e k)
  (list 'FORSOME 'cpd_ (list 'AND (list 'IN 'cpd_ (list 'FUN 'NN kk))
    (list 'AND (cp-van 'cpd_ (list 'succ (list 'succ n)))
      (list 'AND (list '= (list 'cpd_ (list 'succ n)) (cp-fs (cp-summ n e) (list 'INTERVAL 1 k)))
        (list 'FORALL 'cpz_ (list 'IMPLIES '(IN cpz_ CC)
          (list '= (cp-fs (cp-summ n (cp-lin (list 'succ n) b e 'cpz_)) (list 'INTERVAL 1 k)) (cp-ps 'cpd_ 'cpz_ (list 'succ (list 'succ n)))))))))))

(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'kk (list 'IMPLIES '(IS-SUBRING-OF-CC kk)
  (forall-guarded '(b e) (list '(IN b (MAT (succ n) (succ n) kk)) '(IN e (MAT (succ n) (succ n) kk)) (cp-gbody 'n 'kk) '(<= k (succ n)))
    (cp-qbody 'n 'kk 'b 'e 'k))))))))))
(define (cp-empty-sum! f)
  ;; rewrite FINSUM(AG, f, EMPTY-SET) to 0 in the goal
  (subst (dk-cite! 'finsum-empty cp-ag f))
  (subst (dk-cite! 'ras-id cp-r))
  (subst (dk-cite! 'cc-scalar-ring-zero)))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  ;; no term: the zero polynomial
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (cp-ring!)
  (cp-sub-parts! 'kk)
  (fact 'nn-succ-closed 'n)
  (fact 'nn-succ-closed '(succ n))
  (subst (dk-cite! 'interval-1-0-empty))
  (let* ((zc (dk-apply! (dk-cite! 'cp-zero-coefficients) 'kk)))
    (dk-split-all! (list zc))
    (fact 'cc-zero-in)
    (ew cp-z0)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond ((dk-ass!) #t)
                ((and (dk-head-is? g 'FORALL) (dk-contains? g 'pfk_))
                 (dk-apply! (dk-ctx-form (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (cp-van cp-z0 'm)))) '(succ (succ n)))
                 (ass))
                ((dk-head-is? g 'FORALL)
                 (let ((z (dk-di-var!)))
                   (cp-empty-sum! (cp-summ 'n (cp-lin '(succ n) 'b 'e z)))
                   (subst (dk-apply! (dk-apply! (dk-ctx-form (list 'FORALL 'nz (list 'IMPLIES '(IN nz NN) (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (list '= (cp-ps cp-z0 'z 'nz) 0)))))) '(succ (succ n))) z))
                   (rfl)))
                (#t
                 (cp-empty-sum! (cp-summ 'n 'e))
                 (if (not (dk-lam-b!)) (rfl))))))))
  ;; one more term
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (cp-ring!)
  (cp-sub-parts! 'kk)
  (fact 'nn-succ-closed 'n)
  (fact 'nn-succ-closed '(succ n))
  (fact 'nn-succ-closed v)
  (fact 'nn-one-in)
  (let* ((sn '(succ n)) (ssn '(succ (succ n))) (j0 (list 'succ v))
         (mb (list 'MINOR 'b 1 j0 'n)) (me (list 'MINOR 'e 1 j0 'n))
         (gb (dk-ctx-form (cp-gbody 'n 'kk))))
    (dk-have! (list '<= v sn) (lambda () (dk-nn! (list '<= j0 sn))))
    (let* ((dq (dk-apply! (dk-ctx-form ih) 'n 'kk 'b 'e))
           (d (dk-skolem! dq)))
      (dk-have! (list '<= 1 j0) (lambda () (dk-nn!)))
      (dk-apply! (dk-cite! 'interval-mem-intro 1 sn j0))
      (dk-have! (list 'IN 1 (list 'INTERVAL 1 sn)) (lambda () (dk-have! '(<= 1 1) (lambda () (dk-nn!))) (dk-have! (list '<= 1 sn) (lambda () (dk-nn!))) (dk-apply! (dk-cite! 'interval-mem-intro 1 sn 1)) (ass)))
      (dk-apply! (dk-cite! 'cp-minor-in-subring) 'n 'kk 'b j0)
      (dk-apply! (dk-cite! 'cp-minor-in-subring) 'n 'kk 'e j0)
      (let* ((c (dk-skolem! (dk-apply! gb mb me)))
             (sg (cp-sign (list 'succ j0)))
             (b1 (list 'ENTRY 'b 1 j0)) (e1 (list 'ENTRY 'e 1 j0))
             (al (list '* sg b1)) (be (list '* sg e1))
             (q (cp-shift al be c)) (s (cp-sum d q))
             (dt (list 'DET cp-r 'n me)))
        (fact 'nn-succ-closed j0)
        (dk-split! (dk-apply! (dk-apply! (dk-cite! 'cc-sign-in-subring) (list 'succ j0)) 'kk))
        (fact 'entry-in-carrier sn sn 'kk 'b 1 j0)
        (fact 'entry-in-carrier sn sn 'kk 'e 1 j0)
        (ma-for-each (lambda (t) (fact 'subset-mem-fwd 'kk 'CC t)) (list b1 e1))
        (cp-mul-in! 'kk sg b1) (cp-mul-in! 'kk sg e1)
        (let* ((sh (dk-apply! (dk-apply! (dk-cite! 'cp-shift-coefficients) 'n 'kk) c al be))
               (shp (dk-split-all! (list sh)))
               (sm (dk-apply! (dk-apply! (dk-cite! 'cp-sum-coefficients) ssn 'kk) d q))
               (smp (dk-split-all! (list sm))))
          ;; matrices over C
          (dk-have! '(FORALL cpw_ (IMPLIES (IN cpw_ kk) (IN cpw_ CC))) (lambda () (let ((w (dk-di-var!))) (fact 'subset-mem-fwd 'kk 'CC w) (ass))))
          (ma-for-each (lambda (m) (dk-apply! (dk-cite! 'mat-mono sn sn 'kk 'CC) m)) '(b e))
          (fact 'fun-apply-type-c c 'NN 'kk 'n)
          (fact 'subset-mem-fwd 'kk 'CC (list c 'n))
          (dk-have! (list 'IN dt 'CC) (lambda () (subst (list '= dt (list c 'n))) (ass)))
          (ew s)
          (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond
                  ((dk-ass!) #t)
                  ((dk-head-is? g '=)
                   ;; the value at n + 1: the partial sums of the cofactor expansion of e
                   (let* ((fs (dk-apply! (dk-cite! 'cp-finsum-step) 'n 'e v)) (fsp (dk-split-all! (list fs)))
                          (sv (dk-apply! (dk-cite! 'cp-summand-value) 'n 'e j0)) (svp (dk-split-all! (list sv))))
                     (dk-apply! (dk-ctx-form (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list '= (list s 'k) (list '+ (list d 'k) (list q 'k)))))) sn)
                     (subst (list '= (list s sn) (list '+ (list d sn) (list q sn))))
                     (subst (list '= (list d sn) (cp-fs (cp-summ 'n 'e) (list 'INTERVAL 1 v))))
                     (subst (list '= (list q sn) (list '* be (list c 'n))))
                     (subst (list '= (list c 'n) dt))
                     (subst (list '= (cp-fs (cp-summ 'n 'e) (list 'INTERVAL 1 j0)) (list '+ (cp-fs (cp-summ 'n 'e) (list 'INTERVAL 1 v)) (list (cp-summ 'n 'e) j0))))
                     (subst (list '= (list (cp-summ 'n 'e) j0) (list '* sg (list '* e1 dt))))
                     (crs)))
                  (#t
                   ;; the polynomial identity
                   (let* ((z (dk-di-var!))
                          (l (cp-lin sn 'b 'e z))
                          (lm (dk-apply! (dk-cite! 'cp-lin-mat) sn 'b 'e z)) (lmp (dk-split! lm))
                          (fs (dk-apply! (dk-cite! 'cp-finsum-step) 'n l v)) (fsp (dk-split-all! (list fs)))
                          (sv (dk-apply! (dk-cite! 'cp-summand-value) 'n l j0)) (svp (dk-split-all! (list sv)))
                          (el (dk-apply! (caddr lm) 1 j0))
                          (mn (dk-apply! (dk-cite! 'cp-lin-minor) 'n 'b 'e j0 z))
                          (cv (dk-apply! (dk-ctx-form (list 'FORALL 'cpz_ (list 'IMPLIES '(IN cpz_ CC) (list '= (list 'DET cp-r 'n (cp-lin 'n mb me 'cpz_)) (cp-ps c 'cpz_ sn))))) z))
                          (dv (dk-apply! (dk-ctx-form (list 'FORALL 'cpz_ (list 'IMPLIES '(IN cpz_ CC) (list '= (cp-fs (cp-summ 'n (cp-lin sn 'b 'e 'cpz_)) (list 'INTERVAL 1 v)) (cp-ps d 'cpz_ ssn))))) z))
                          (pv (dk-apply! (dk-ctx-form (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (list '= (cp-ps s 'z ssn) (list '+ (cp-ps d 'z ssn) (cp-ps q 'z ssn)))))) z))
                          (qv (dk-apply! (dk-ctx-form (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (list '= (cp-ps q 'z ssn) (list '* (list '+ al (list '* 'z be)) (cp-ps c 'z sn)))))) z)))
                     (cp-fcc! c 'kk) (cp-fcc! d 'kk)
                     (cp-ps-typ! c z sn) (cp-ps-typ! d z ssn)
                     (subst (list '= (cp-fs (cp-summ 'n l) (list 'INTERVAL 1 j0)) (list '+ (cp-fs (cp-summ 'n l) (list 'INTERVAL 1 v)) (list (cp-summ 'n l) j0))))
                     (subst (cadr sv))
                     (subst el)
                     (subst mn)
                     (subst cv)
                     (subst dv)
                     (subst pv)
                     (subst qv)
                     (crs))))))))))))
(qed 'cp-cofactor-partial-sums)

;;; (10) DET(b + z e) is a polynomial in z with coefficients in K, of length n + 1, with z^n-coefficient DET(e)
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'kk (list 'IMPLIES '(IS-SUBRING-OF-CC kk) (cp-gbody 'n 'kk)))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  ;; n = 0: the constant 1
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (cp-ring!)
  (cp-sub-parts! 'kk)
  (fact 'cc-one-in) (fact 'cc-zero-in) (fact 'nn-zero-in)
  (let* ((zc (dk-apply! (dk-cite! 'cp-zero-coefficients) 'kk))
         (zcp (dk-split-all! (list zc)))
         (c (list 'CF-CONS 1 cp-z0)))
    (dk-apply! (dk-cite! 'cf-cons-in-fun 'kk) 1 cp-z0)
    (cp-fcc! cp-z0 'kk) (cp-fcc! c 'kk)
    (ew c)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((dk-ass!) #t)
            ((and (dk-head-is? g 'FORALL) (dk-contains? g 'pfk_))
             (let* ((ls (dk-peel!)) (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ls))))
               (ma-or-split! (dk-cite! 'nn-zero-or-succ k)
                 (list
                   (lambda ()
                     (dk-have! '(< 0 0) (lambda () (dk-nn! (list '= k 0) (list '<= '(succ 0) k))))
                     (dk-cite! 'rr-lt-irrefl 0)
                     (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0)))))
                   (lambda ()
                     (let ((p (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f k))) (dk-asms)))))
                       (subst (list '= k (list 'succ p)))
                       (subst (dk-apply! (dk-cite! 'cf-cons-succ 1) cp-z0 p))
                       (if (not (dk-lam-b!)) (rfl))))))))
            ((dk-head-is? g 'FORALL)
             (let ((z (dk-di-var!)))
               (dk-have! '(FORALL cpw_ (IMPLIES (IN cpw_ kk) (IN cpw_ CC))) (lambda () (let ((w (dk-di-var!))) (fact 'subset-mem-fwd 'kk 'CC w) (ass))))
               (ma-for-each (lambda (m) (dk-apply! (dk-cite! 'mat-mono 0 0 'kk 'CC) m)) '(cpb_ cpe_))
               (dk-split! (dk-apply! (dk-cite! 'cp-lin-mat) 0 'cpb_ 'cpe_ z))
               (subst (dk-cite! 'det-zero cp-r (cp-lin 0 'cpb_ 'cpe_ z)))
               (subst (dk-cite! 'cc-scalar-ring-one))
               (subst (dk-apply! (dk-cite! 'cc-ps-cons 0) 1 cp-z0 z))
               (subst (dk-cite! 'cc-series-partial-sum-zero (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list cp-z0 'pfj_) (list 'power z 'pfj_)))))
               (crs)))
            (#t
             (subst (dk-apply! (dk-cite! 'cf-cons-zero 1) cp-z0))
             (subst (dk-cite! 'det-zero cp-r 'cpe_))
             (subst (dk-cite! 'cc-scalar-ring-one))
             (rfl)))))))
  ;; n + 1: the cofactor expansion
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (cp-ring!)
  (cp-sub-parts! 'kk)
  (fact 'nn-succ-closed v)
  (let* ((sv (list 'succ v)) (ssv (list 'succ sv)))
    (dk-apply! (dk-ctx-form ih) 'kk)
    (dk-have! (list '<= sv sv) (lambda () (dk-nn!)))
    (let ((d (dk-skolem! (dk-apply! (dk-apply! (dk-cite! 'cp-cofactor-partial-sums) sv v 'kk) 'cpb_ 'cpe_))))
      (dk-have! '(FORALL cpw_ (IMPLIES (IN cpw_ kk) (IN cpw_ CC))) (lambda () (let ((w (dk-di-var!))) (fact 'subset-mem-fwd 'kk 'CC w) (ass))))
      (ma-for-each (lambda (m) (dk-apply! (dk-cite! 'mat-mono sv sv 'kk 'CC) m) (cp-mat-carr! m sv)) '(cpb_ cpe_))
      (ew d)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-ass!) #t)
              ((dk-head-is? g 'FORALL)
               (let* ((z (dk-di-var!))
                      (l (cp-lin sv 'cpb_ 'cpe_ z)))
                 (dk-split! (dk-apply! (dk-cite! 'cp-lin-mat) sv 'cpb_ 'cpe_ z))
                 (cp-mat-carr! l sv)
                 (subst (dk-apply! (dk-cite! 'det-cofactor cp-r v l)))
                 (dk-apply! (dk-ctx-form (list 'FORALL 'cpz_ (list 'IMPLIES '(IN cpz_ CC) (list '= (cp-fs (cp-summ v (cp-lin sv 'cpb_ 'cpe_ 'cpz_)) (list 'INTERVAL 1 sv)) (cp-ps d 'cpz_ ssv))))) z)
                 (ass)))
              (#t
               (subst (dk-apply! (dk-cite! 'det-cofactor cp-r v 'cpe_)))
               (ass)))))))))
(qed 'det-linear-pencil-polynomial)

;;; (11) -I and its determinant (-1)^n
;; binders renamed cpi_/cpj_ -> cqi_/cqj_ at integration 2026-10-28: cp-lin nests this matrix under its own
;; (LIST cpi_ cpj_) lambda, a shadowing binder the suite's case-fold audit refuses.
(define (cp-negi n) (list 'MATOF n n (list 'VNB-LAMBDA '(LIST cqi_ cqj_) (list 'CARTESIAN (list 'INTERVAL 1 n) (list 'INTERVAL 1 n)) '(IF (= cqi_ cqj_) (- 1) 0))))
(define cp-negi-entries
  (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n)) (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 n))
    (list '= (list 'ENTRY (cp-negi 'n) 'i 'j) '(IF (= i j) (- 1) 0)))))))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'kk (list 'IMPLIES '(IS-SUBRING-OF-CC kk)
  (list 'AND (list 'IN (cp-negi 'n) '(MAT n n kk)) (list 'AND (list 'IN (cp-negi 'n) '(MAT n n CC)) cp-negi-entries))))))))
(dk-peel!)
(cp-sub-parts! 'kk)
(fact 'cc-one-in) (fact 'cc-zero-in) (fact 'cc-neg-closed 1)
(cp-neg-in! 'kk 1)
(let* ((g (cadddr (cp-negi 'n)))
       (gij! (lambda (i j)
               (let ((eq (list '= (list g i j) (list 'IF (list '= i j) '(- 1) 0)))
                     (ift (list 'IF (list '= i j) '(- 1) 0)))
                 (dk-have! (list 'IN ift 'CC) (lambda () (dk-case-if! ift (lambda (t? v) (ass)))))
                 (dk-have! eq (lambda () (if (not (dk-lam-b!)) (rfl))))
                 eq)))
       (typ! (lambda (cls)
               (dk-have! (list 'FORALL 'cpu_ (list 'IMPLIES '(IN cpu_ (INTERVAL 1 n)) (list 'FORALL 'cpv_ (list 'IMPLIES '(IN cpv_ (INTERVAL 1 n)) (list 'IN (list g 'cpu_ 'cpv_) cls)))))
                 (lambda ()
                   (let* ((ls (dk-peel!)) (vs (ma-map cadr ls)) (i (car vs)) (j (cadr vs)))
                     (dk-lam-b!)
                     (dk-case-if! (list 'IF (list '= i j) '(- 1) 0) (lambda (t? val) (ass)))))))))
  (typ! 'kk) (typ! 'CC)
  (dk-have! (list 'FORALL 'cpu_ (list 'IMPLIES '(IN cpu_ (INTERVAL 1 n)) (list 'FORALL 'cpv_ (list 'IMPLIES '(IN cpv_ (INTERVAL 1 n)) (list 'IN (list g 'cpu_ 'cpv_) 'SET)))))
    (lambda ()
      (let* ((ls (dk-peel!)) (vs (ma-map cadr ls)) (i (car vs)) (j (cadr vs)))
        (dk-apply! (dk-ctx-form (list 'FORALL 'cpu_ (list 'IMPLIES '(IN cpu_ (INTERVAL 1 n)) (list 'FORALL 'cpv_ (list 'IMPLIES '(IN cpv_ (INTERVAL 1 n)) (list 'IN (list g 'cpu_ 'cpv_) 'CC)))))) i j)
        (fact 'membership-implies-sethood (list g i j) 'CC)
        (ass))))
  (dk-apply! (dk-cite! 'matof-in-mat 'n 'n 'kk g))
  (dk-apply! (dk-cite! 'matof-in-mat 'n 'n 'CC g))
  (dk-have! cp-negi-entries
    (lambda ()
      (let* ((ls (dk-peel!)) (vs (ma-map cadr ls)) (i (car vs)) (j (cadr vs)))
        (dk-apply! (dk-cite! 'entry-of-matof 'n 'n g i j))
        (subst (list '= (list 'ENTRY (cp-negi 'n) i j) (list g i j)))
        (gij! i j))))
  (dk-conj-close! dk-ass!))
(qed 'cp-negi-mat)

(sp (make-wff '(IS-SUBRING-OF-CC CC)))
(mac 'is-subring-of-cc)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IS-CC-SUBRING)
        (begin (fact 'cc-subring-cc) (ass))
        (let ((x (dk-di-var!))) (fact 'cc-neg-closed x) (ass)))))
(qed 'cc-is-subring-of-cc)

(define (cp-negi-at! n)
  ;; land negi(n) in MAT(n, n, CC), in MAT(n, n, CARR R), and its entry law; return the entry law
  (fact 'cc-is-subring-of-cc)
  (let ((nm (dk-apply! (dk-apply! (dk-cite! 'cp-negi-mat) n) 'CC)))
    (dk-split-all! (list nm))
    (cp-mat-carr! (cp-negi n) n)
    (caddr (caddr nm))))

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list '= (list 'DET cp-r 'n (cp-negi 'n)) (cp-sign 'n))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (cp-ring!)
  (fact 'nn-zero-in)
  (cp-nr1!)
  (cp-negi-at! 0)
  (subst (dk-cite! 'det-zero cp-r (cp-negi 0)))
  (subst (dk-cite! 'mpow-zero (list 'RING-MULTIPLICATIVE-MONOID cp-r) cp-nr1))
  (subst (dk-cite! 'rmm-iden cp-r))
  (subst (dk-cite! 'cc-scalar-ring-one))
  (rfl)
  (dk-focus! (cdr (assq 'step ind)))
  (cp-ring!)
  (cp-nr1!)
  (fact 'nn-succ-closed v)
  (fact 'nn-one-in)
  (let* ((sv (list 'succ v)) (ns (cp-negi sv)) (nv (cp-negi v))
         (ens (cp-negi-at! sv)) (env (cp-negi-at! v))
         (mn (list 'MINOR ns 1 1 v)))
    (dk-have! (list 'IN 1 (list 'INTERVAL 1 sv)) (lambda () (dk-have! '(<= 1 1) (lambda () (dk-nn!))) (dk-have! (list '<= 1 sv) (lambda () (dk-nn!))) (dk-apply! (dk-cite! 'interval-mem-intro 1 sv 1)) (ass)))
    ;; row 1 of -I has one non-zero entry
    (dk-have! (list 'FORALL 'frj_ (list 'IMPLIES (list 'IN 'frj_ (list 'INTERVAL 1 sv)) (list 'IMPLIES '(NOT (= frj_ 1)) (list '= (list 'ENTRY ns 1 'frj_) (list 'ZERO cp-r)))))
      (lambda ()
        (let* ((ls (dk-peel!)) (w (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) ls))))
          (fact 'interval-elt-in-nn 1 sv w)
          (subst (dk-apply! ens 1 w))
          (subst (dk-cite! 'cc-scalar-ring-zero))
          (dk-if-branch! #f (list 'IF (list '= 1 w) '(- 1) 0)
            (lambda ()
              (di)
              (dk-have! (list '= w 1) (lambda () (subst (list '= 1 w)) (rfl)))
              (ma-prop-with! (list (list '= w 1) (list 'NOT (list '= w 1)))))
            (lambda () (fact 'cc-zero-in) (rfl))))))
    (let ((rs (dk-apply! (dk-cite! 'det-row-single cp-r v ns 1))))
      ;; the (1, 1) minor of -I is -I
      (dk-apply! (dk-cite! 'minor-type cp-r ns 1 1 v))
      (cp-mat-cc! mn v)
      (dk-have! (list 'FORALL 'cpu_ (list 'IMPLIES (list 'IN 'cpu_ (list 'INTERVAL 1 v)) (list 'FORALL 'cpv_ (list 'IMPLIES (list 'IN 'cpv_ (list 'INTERVAL 1 v))
                  (list '= (list 'ENTRY mn 'cpu_ 'cpv_) (list 'ENTRY nv 'cpu_ 'cpv_))))))
        (lambda ()
          (let* ((ls (dk-peel!)) (vs (ma-map cadr ls)) (u (car vs)) (w (cadr vs)))
            (cp-int-parts! 1 v u) (cp-int-parts! 1 v w)
            (fact 'nn-succ-closed u) (fact 'nn-succ-closed w)
            (subst (dk-apply! (dk-cite! 'minor-entry cp-r ns 1 1 v u w)))
            (dk-if-branch! #f (list 'IF (list '< u 1) u (list 'succ u)) (lambda () (dk-nn! (list '<= 1 u)))
              (lambda ()
                (dk-if-branch! #f (list 'IF (list '< w 1) w (list 'succ w)) (lambda () (dk-nn! (list '<= 1 w)))
                  (lambda ()
                    (dk-have! (list 'IN (list 'succ u) (list 'INTERVAL 1 sv)) (lambda () (dk-have! (list '<= 1 (list 'succ u)) (lambda () (dk-nn!))) (dk-have! (list '<= (list 'succ u) sv) (lambda () (dk-nn! (list '<= u v)))) (dk-apply! (dk-cite! 'interval-mem-intro 1 sv (list 'succ u))) (ass)))
                    (dk-have! (list 'IN (list 'succ w) (list 'INTERVAL 1 sv)) (lambda () (dk-have! (list '<= 1 (list 'succ w)) (lambda () (dk-nn!))) (dk-have! (list '<= (list 'succ w) sv) (lambda () (dk-nn! (list '<= w v)))) (dk-apply! (dk-cite! 'interval-mem-intro 1 sv (list 'succ w))) (ass)))
                    (subst (dk-apply! ens (list 'succ u) (list 'succ w)))
                    (subst (dk-apply! env u w))
                    (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'cc-neg-closed 1)
                    (use-em (list '= u w)
                      (lambda ()
                        (dk-if-branch! #t (list 'IF (list '= u w) '(- 1) 0) #f
                          (lambda ()
                            (dk-if-branch! #t (list 'IF (list '= (list 'succ u) (list 'succ w)) '(- 1) 0) (lambda () (subst (list '= u w)) (rfl))
                              (lambda () (rfl))))))
                      (lambda ()
                        (dk-if-branch! #f (list 'IF (list '= u w) '(- 1) 0) #f
                          (lambda ()
                            (dk-if-branch! #f (list 'IF (list '= (list 'succ u) (list 'succ w)) '(- 1) 0)
                              (lambda ()
                                (di)
                                (dk-apply! (dk-cite! 'nn-succ-inj u w))
                                (ma-prop-with! (list (list '= u w) (list 'NOT (list '= u w)))))
                              (lambda () (rfl))))))))))))))
      (dk-apply! (dk-cite! 'matrix-entry-extensionality v v 'CC mn nv))
      (subst rs)
      (subst (dk-apply! ens 1 1))
      (dk-if-branch! #t '(IF (= 1 1) (- 1) 0) (lambda () (rfl))
        (lambda ()
          (subst (list '= mn nv))
          (subst ih)
          (subst (dk-cite! 'dtr-sign-succ cp-r v))
          (subst (list '= '(- 1) cp-nr1))
          (dk-apply! (dk-cite! 'dtr-sign-type cp-r v))
          (rfl))))))
(qed 'cp-negi-det)

;;; THE CHARACTERISTIC POLYNOMIAL: for B over a subring K of C, DET(B - zI) = c(0) + c(1) z + ... + c(n) z^n
;;; with c(k) in K and c(n) = (-1)^n (the matrix B - zI is LIN(n, B, -I, z), entries b_ij - z delta_ij)
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'kk (list 'IMPLIES '(IS-SUBRING-OF-CC kk)
  (list 'FORALL 'b (list 'IMPLIES '(IN b (MAT n n kk))
    (list 'FORSOME 'cpc_ (list 'AND '(IN cpc_ (FUN NN kk))
      (list 'AND (cp-van 'cpc_ '(succ n))
        (list 'AND (list '= '(cpc_ n) (cp-sign 'n))
          (list 'FORALL 'cpz_ (list 'IMPLIES '(IN cpz_ CC)
            (list '= (list 'DET cp-r 'n (cp-lin 'n 'b (cp-negi 'n) 'cpz_)) (cp-ps 'cpc_ 'cpz_ '(succ n)))))))))))))))))
(dk-peel!)
(let* ((nm (dk-apply! (dk-apply! (dk-cite! 'cp-negi-mat) 'n) 'kk)))
  (dk-split-all! (list nm))
  (let* ((c (dk-skolem! (dk-apply! (dk-apply! (dk-apply! (dk-cite! 'det-linear-pencil-polynomial) 'n) 'kk) 'b (cp-negi 'n)))))
    (ew c)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (cp-ring!)
              (subst (list '= (list c 'n) (list 'DET cp-r 'n (cp-negi 'n))))
              (subst (dk-apply! (dk-cite! 'cp-negi-det) 'n))
              (cp-nr1!)
              (dk-apply! (dk-cite! 'dtr-sign-type cp-r 'n))
              (rfl)))))))
(qed 'characteristic-polynomial)


;;; (12) PROP. 4.18, the converse: the adjugate kills the generators
;;; ((MUL R) x y) = x * y and ((ADD R) x y) = x + y for x, y typed in CC (named first: a rewrite of the ring
;;; operation must not reach inside x or y)
(define (am-op-eq! op x y)
  (let* ((thm (if (eq? op 'MUL) 'cc-scalar-ring-mul 'cc-scalar-ring-add))
         (cop (if (eq? op 'MUL) '* '+))
         (eq (list '= (list (list op cp-r) x y) (list cop x y))))
    (if (not (dk-asm? eq))
        (dk-have! eq
          (lambda ()
            (let* ((w1 (if (pair? x) (dk-name! x 'CC) x))
                   (w2 (cond ((equal? x y) w1) ((pair? y) (dk-name! y 'CC)) (#t y))))
              (if (pair? x) (subst (list '= x w1)))
              (if (and (pair? y) (not (equal? x y))) (subst (list '= y w2)))
              (subst (dk-cite! thm))
              (if (not (dk-lam-b!)) (rfl))))))
    eq))
(define (am-gm n g) (list 'MATOF n n (list 'VNB-LAMBDA '(LIST amp_ amq_) (list 'CARTESIAN (list 'INTERVAL 1 n) (list 'INTERVAL 1 n)) (list g 'amp_))))

(sp (make-wff (forall-guarded '(n g) '((IN n NN) (IN g (FUN (INTERVAL 1 n) CC)))
  (list 'AND (list 'IN (am-gm 'n 'g) '(MAT n n CC))
    (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n)) (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 n))
      (list '= (list 'ENTRY (am-gm 'n 'g) 'i 'j) '(g i))))))))))
(dk-peel!)
(let* ((gl (cadddr (am-gm 'n 'g)))
       (gij! (lambda (i j)
               (fact 'fun-apply-type-c 'g '(INTERVAL 1 n) 'CC i)
               (let ((eq (list '= (list gl i j) (list 'g i))))
                 (dk-have! eq (lambda () (if (not (dk-lam-b!)) (rfl))))
                 eq))))
  (ma-for-each
    (lambda (cls)
      (dk-have! (list 'FORALL 'cpu_ (list 'IMPLIES '(IN cpu_ (INTERVAL 1 n)) (list 'FORALL 'cpv_ (list 'IMPLIES '(IN cpv_ (INTERVAL 1 n)) (list 'IN (list gl 'cpu_ 'cpv_) cls)))))
        (lambda ()
          (let* ((ls (dk-peel!)) (vs (ma-map cadr ls)) (i (car vs)) (j (cadr vs)))
            (subst (gij! i j))
            (if (eq? cls 'SET) (fact 'membership-implies-sethood (list 'g i) 'CC))
            (ass)))))
    '(CC SET))
  (dk-apply! (dk-cite! 'matof-in-mat 'n 'n 'CC gl))
  (dk-have! (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n)) (list 'FORALL 'j (list 'IMPLIES '(IN j (INTERVAL 1 n))
              (list '= (list 'ENTRY (am-gm 'n 'g) 'i 'j) '(g i))))))
    (lambda ()
      (let* ((ls (dk-peel!)) (vs (ma-map cadr ls)) (i (car vs)) (j (cadr vs)))
        (dk-apply! (dk-cite! 'entry-of-matof 'n 'n gl i j))
        (subst (list '= (list 'ENTRY (am-gm 'n 'g) i j) (list gl i j)))
        (gij! i j))))
  (dk-conj-close! dk-ass!))
(qed 'am-generator-matrix)

(define (am-hyp n bm g r)
  (list 'FORALL 'ami_ (list 'IMPLIES (list 'IN 'ami_ (list 'INTERVAL 1 n))
    (list '= (list '* r (list g 'ami_))
             (cp-fs (list 'VNB-LAMBDA 'amj_ (list 'INTERVAL 1 n) (list '* (list 'ENTRY bm 'ami_ 'amj_) (list g 'amj_))) (list 'INTERVAL 1 n))))))
(define (am-p n bm g r) (list 'MATMUL cp-r (cp-lin n bm (cp-negi n) r) (am-gm n g)))
;;; carr of the additive group of C
(define (am-carr-ag!)
  (fact 'cc-scalar-ring-carr)
  (dk-have! (list '= (list 'CARR cp-ag) 'CC) (lambda () (subst (dk-cite! 'ras-carr cp-r)) (subst (list '= (list 'CARR cp-r) 'CC)) (fact 'cc-is-set) (rfl))))

;;; if r g_i = sum_j B_ij g_j for every i, then (B - rI) G = 0
(sp (make-wff (forall-guarded '(n bm g r) (list '(IN n NN) '(IN bm (MAT n n CC)) '(IN g (FUN (INTERVAL 1 n) CC)) '(IN r CC) (am-hyp 'n 'bm 'g 'r))
  (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n)) (list 'FORALL 'l (list 'IMPLIES '(IN l (INTERVAL 1 n))
    (list '= (list 'ENTRY (am-p 'n 'bm 'g 'r) 'i 'l) 0))))))))
(dk-peel!)
(cp-ring!)
(am-carr-ag!)
(cp-int-parts! 1 'n 'i)
(fact 'cc-zero-in) (fact 'cc-one-in) (fact 'cc-neg-closed 1)
(dk-have! '(<= 1 n) (lambda () (dk-nn! '(<= 1 i) '(<= i n))))
(let* ((ni (cp-negi 'n)) (m (cp-lin 'n 'bm ni 'r)) (gm (am-gm 'n 'g)) (int '(INTERVAL 1 n))
       (ens (cp-negi-at! 'n))
       (lm (dk-apply! (dk-cite! 'cp-lin-mat) 'n 'bm ni 'r)) (lmp (dk-split! lm))
       (gg (dk-apply! (dk-cite! 'am-generator-matrix) 'n 'g)) (ggp (dk-split! gg))
       (ift (lambda (z) (list 'IF (list '= 'i z) '(- 1) 0)))
       (f1 (list 'VNB-LAMBDA 'amj_ int '(* (ENTRY bm i amj_) (g amj_))))
       (f2 (list 'VNB-LAMBDA 'amj_ int (list '* (list '* 'r (ift 'amj_)) '(g amj_))))
       (s (list 'VNB-LAMBDA 'j int (list (list 'MUL cp-r) (list 'ENTRY m 'i 'j) (list 'ENTRY gm 'j 'l))))
       (t (list 'VNB-LAMBDA 'z int (list (list 'OPR cp-ag) (list f1 'z) (list f2 'z))))
       (typ! (lambda (z)
               (cp-int-parts! 1 'n z)
               (fact 'entry-in-carrier 'n 'n 'CC 'bm 'i z)
               (fact 'fun-apply-type-c 'g int 'CC z)
               (dk-have! (list 'IN (ift z) 'CC) (lambda () (dk-case-if! (ift z) (lambda (t? v) (ass))))))))
  (cp-mat-carr! m 'n) (cp-mat-carr! gm 'n)
  (dk-cite! 'ring-additive-ag-is-abelian-group cp-r)
  (fact 'interval-in-set 1 'n)
  (dk-apply! (dk-cite! 'interval-card-in-nn 1 'n))
  ;; the summands agree pointwise
  (dk-have! (list 'FORALL 'amz_ (list 'IMPLIES (list 'IN 'amz_ int) (list '= (list s 'amz_) (list t 'amz_))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (typ! z)
        (dk-lam-b!)
        (subst (dk-apply! (caddr lm) 'i z))
        (subst (dk-apply! ens 'i z))
        (subst (dk-apply! (caddr gg) z 'l))
        (subst (dk-cite! 'ras-op cp-r))
        (let ((x (list '+ (list 'ENTRY 'bm 'i z) (list '* 'r (ift z))))
              (y1 (list '* (list 'ENTRY 'bm 'i z) (list 'g z)))
              (y2 (list '* (list '* 'r (ift z)) (list 'g z))))
          (cp-type! x) (cp-type! y1) (cp-type! y2)
          (subst (am-op-eq! 'MUL x (list 'g z)))
          (subst (am-op-eq! 'ADD y1 y2))
          (crs)))))
  (dk-have! (list 'FORALL 'amz_ (list 'IMPLIES (list 'IN 'amz_ int) (list 'IN (list s 'amz_) (list 'CARR cp-ag))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (typ! z)
        (subst (dk-apply! (dk-ctx-form (list 'FORALL 'amz_ (list 'IMPLIES (list 'IN 'amz_ int) (list '= (list s 'amz_) (list t 'amz_))))) z))
        (dk-lam-b!)
        (subst (dk-cite! 'ras-op cp-r))
        (subst (list '= (list 'CARR cp-ag) 'CC))
        (let ((y1 (list '* (list 'ENTRY 'bm 'i z) (list 'g z)))
              (y2 (list '* (list '* 'r (ift z)) (list 'g z))))
          (cp-type! y1) (cp-type! y2)
          (subst (am-op-eq! 'ADD y1 y2))
          (cp-type! (list '+ y1 y2))
          (ass)))))
  (ma-for-each
    (lambda (f)
      (dk-have! (list 'IN f (list 'FUN int (list 'CARR cp-ag)))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let ((z (dk-di-var!)))
                (typ! z)
                (subst (list '= (list 'CARR cp-ag) 'CC))
                (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-type! (cadr (dk-goal)) 'CC))))
            (lambda () (ass))))))
    (list f1 f2))
  (let* ((e0 (dk-apply! (dk-cite! 'matmul-entry cp-r) 'n 'n 'n m gm 'i 'l))
         (e1 (dk-apply! (dk-cite! 'finsum-congruence cp-ag) int s t))
         (e2 (dk-apply! (dk-cite! 'finsum-add-ag cp-ag) int f1 f2))
         (h1 (dk-apply! (dk-ctx-form (am-hyp 'n 'bm 'g 'r)) 'i)))
    ;; the second sum has one term
    (dk-have! (list 'FORALL 'j (list 'IMPLIES (list 'IN 'j int) (list 'IMPLIES '(NOT (= j i)) (list '= (list f2 'j) (list 'IDEN cp-ag)))))
      (lambda ()
        (let* ((ls (dk-peel!)) (j (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) ls))))
          (typ! j)
          (dk-lam-b!)
          (subst (dk-cite! 'ras-id cp-r))
          (subst (dk-cite! 'cc-scalar-ring-zero))
          (dk-if-branch! #f (ift j)
            (lambda () (di) (dk-have! (list '= j 'i) (lambda () (subst (list '= 'i j)) (rfl))) (ma-prop-with! (list (list '= j 'i) (list 'NOT (list '= j 'i)))))
            (lambda () (crs))))))
    (let ((e3 (dk-apply! (dk-cite! 'finsum-single-support cp-ag) int f2 'i)))
      (typ! 'i)
      (subst e0) (subst e1) (subst e2)
      (subst (list '= (cp-fs f1 int) (list '* 'r '(g i))))
      (subst e3)
      (dk-lam-b!)
      (dk-if-branch! #t (ift 'i) (lambda () (rfl))
        (lambda ()
          (subst (dk-cite! 'ras-op cp-r))
          (cp-type! '(* r (g i)))
          (cp-type! (list '* (list '* 'r '(- 1)) '(g i)))
          (subst (am-op-eq! 'ADD '(* r (g i)) (list '* (list '* 'r '(- 1)) '(g i))))
          (crs))))))
(qed 'am-pencil-kills-generators)

;;; adj(M) M = det(M) I, so det(B - rI) g_k = 0 for every generator
(sp (make-wff (forall-guarded '(n bm g r) (list '(IN n NN) '(IN bm (MAT (succ n) (succ n) CC)) '(IN g (FUN (INTERVAL 1 (succ n)) CC)) '(IN r CC)
                                           (am-hyp '(succ n) 'bm 'g 'r))
  (list 'FORALL 'k (list 'IMPLIES '(IN k (INTERVAL 1 (succ n)))
    (list '= (list '* (list 'DET cp-r '(succ n) (cp-lin '(succ n) 'bm (cp-negi '(succ n)) 'r)) '(g k)) 0))))))
(dk-peel!)
(cp-ring!)
(am-carr-ag!)
(fact 'nn-succ-closed 'n)
(fact 'nn-one-in)
(fact 'cc-zero-in)
(let* ((sn '(succ n)) (int (list 'INTERVAL 1 sn)) (ni (cp-negi sn)) (m (cp-lin sn 'bm ni 'r)) (gm (am-gm sn 'g))
       (a (list 'ADJ cp-r 'n m)) (p (list 'MATMUL cp-r m gm)) (d (list 'DET cp-r sn m)) (id (list 'IDENTMAT cp-r sn))
       (ens (cp-negi-at! sn))
       (lm (dk-apply! (dk-cite! 'cp-lin-mat) sn 'bm ni 'r)) (lmp (dk-split! lm))
       (gg (dk-apply! (dk-cite! 'am-generator-matrix) sn 'g)) (ggp (dk-split! gg))
       (nz! (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-nn! (list '= sn 0)))) (dk-cite! 'rr-lt-irrefl 0) (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0)))))))
  (cp-mat-carr! m sn) (cp-mat-carr! gm sn)
  (dk-have! (list '<= 1 sn) (lambda () (dk-nn!)))
  (dk-have! (list 'IN 1 int) (lambda () (dk-have! '(<= 1 1) (lambda () (dk-nn!))) (dk-apply! (dk-cite! 'interval-mem-intro 1 sn 1)) (ass)))
  (dk-apply! (dk-cite! 'adj-type cp-r 'n m))
  (dk-apply! (dk-cite! 'det-in-carrier cp-r sn m))
  (dk-apply! (dk-cite! 'identmat-type cp-r) sn)
  (dk-have! (list 'IMPLIES (list '= sn 0) (list 'OR (list '= sn 0) (list '= sn 0))) nz!)
  (dk-apply! (dk-cite! 'matmul-type cp-r) sn sn sn m gm)
  (dk-have! (list 'IMPLIES (list '= sn 0) (list 'OR (list '= sn 0) (list 'AND (list '= sn 0) (list '= sn 0)))) nz!)
  (let* ((e-assoc (dk-apply! (dk-cite! 'matmul-assoc cp-r) sn sn sn sn a m gm))
         (e-adj (dk-apply! (dk-cite! 'adj-mul cp-r 'n m)))
         (e-sc (dk-apply! (dk-cite! 'matmul-matscale-left cp-r 'n id gm d)))
         (e-id (dk-apply! (dk-cite! 'identmat-left-identity cp-r) sn sn gm)))
    (dk-apply! (dk-cite! 'matscale-type cp-r) sn sn d gm)
    (dk-have! (list '= (list 'MATMUL cp-r a p) (list 'MATSCALE cp-r d gm))
      (lambda ()
        (subst (list '= (list 'MATMUL cp-r a p) (list 'MATMUL cp-r (list 'MATMUL cp-r a m) gm)))
        (subst e-adj) (subst e-sc) (subst e-id)
        (rfl)))
    (let ((k 'k))
      (cp-int-parts! 1 sn k)
      (fact 'fun-apply-type-c 'g int 'CC k)
      (dk-have! (list 'IN d 'CC) (lambda () (subst (list '= 'CC (list 'CARR cp-r))) (ass)))
      (dk-apply! (dk-cite! 'matmul-type cp-r) sn sn sn a p)
      (let* ((e-l (dk-apply! (dk-cite! 'matmul-entry cp-r) sn sn sn a p k 1))
             (e-r (dk-apply! (dk-cite! 'matscale-entry cp-r sn sn d gm) k 1))
             (fl (caddr e-l)) (f (caddr fl)))
