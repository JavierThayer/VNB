        (dk-have! (am9-gh-in nw n u g us)
          (lambda ()
            (dk-peel!)
            (let* ((lj (am9-goal-pair)) (l (car lj)) (j (cadr lj))
                   (e (list '= (list '* (list u l) (list g j)) (list '* (list g j) (list u l)))))
              (fact 'fun-apply-type-c g intn 'CC j) (fact 'fun-apply-type-c u intw 'CC l)
              (dk-apply! (dk-ctx-form (am9-gh-in n nw g u us)) j l)
              (dk-have! e (lambda () (crs)))
              (subst e)
              (ass))))
        (let ((at! (lambda (t)
                     ;; t in INT(1, nb): returns (i j eq), u2(t) = g(i) u(j)
                     (let* ((i (dk-skolem! (dk-apply! afm t)))
                            (jx (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'apj_) (dk-contains? f i))) (dk-asms)))
                            (j (dk-skolem! jx)))
                       (fact 'fun-apply-type-c g intn 'CC i) (fact 'fun-apply-type-c u intw 'CC j)
                       (fact 'fun-apply-type-c u2 intb 'CC t)
                       (list i j (list '= (list u2 t) (list '* (list g i) (list u j))))))))
          ;; the invariance, for c_0 .. c_v
          (dk-have! (am19-inv (list 'succ v) nb u2)
            (lambda ()
              (let* ((i (dk-di-var!)))
                (di)
                (let ((t (dk-di-var!)))
                  (fact 'fun-apply-type-c 'c 'NN 'CC i)
                  (use-em (list '< i v)
                    (lambda ()
                      ;; an old number: the span W is c_i-invariant
                      (dk-apply! (dk-ctx-form (am19-inv v nw u)) i)
                      (dk-apply! (dk-cite! 'cc-span-invariant) 'aa nw u (list 'c i))
                      (let* ((r2 (dk-apply! (dk-cite! 'module-product-invariance) 'aa (list 'c i) ws nw u n g us))
                             (ije (at! t)) (ii (car ije)) (jj (cadr ije))
                             (e (list '= (list '* (list 'c i) (list '* (list g ii) (list u jj))) (list '* (list 'c i) (list '* (list u jj) (list g ii))))))
                        (dk-apply! r2 jj ii)
                        (subst (caddr ije))
                        (dk-have! e (lambda () (crs)))
                        (subst e)
                        (ass)))
                    (lambda ()
                      ;; the new number c_v
                      (fact 'nn-in-rr i) (fact 'nn-in-rr v)
