    (list 'FORSOME 'anac_ (list 'AND '(IN anac_ (FUN NN aa))
      (list 'AND (cp-van 'anac_ '(succ anan_))
        (list 'AND '(= (anac_ anan_) 1) (list '= (cp-ps 'anac_ 'r '(succ anan_)) 0)))))))))
;;; (14) the counted form: r V in V for a non-trivial space V of dimension <= ndim makes r a root of a monic
;;; polynomial of degree <= ndim
(sp (make-wff (forall-guarded '(aa r vv ndim) (list '(IS-SUBRING-OF-CC aa) '(IN r CC) '(IN ndim NN) '(IS-CC-SPACE-DIM-LE aa vv ndim) am-nontriv am-inv)
  (am3-monic-le 'ndim))))
(dk-peel!)
(cp-ring!)
(am-carr-ag!)
(cp-sub-parts! 'aa)
(fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-one-in)
(dk-project! '(IS-CC-MODULE-OVER aa vv) 'is-cc-space-dim-le '(IS-CC-SPACE-DIM-LE aa vv ndim))
(dk-project! '(SUBSET vv CC) 'is-cc-module-over '(IS-CC-MODULE-OVER aa vv))
(define am17-body (list 'FORSOME 'amn_ (list 'AND '(IN amn_ NN) (list 'AND '(<= amn_ ndim) (list 'FORSOME 'amg_ (list 'AND '(IN amg_ (FUN (INTERVAL 1 amn_) vv)) (am-span 'amn_ 'amg_)))))))
(let* ((fgex (dk-project! am17-body 'is-cc-space-dim-le '(IS-CC-SPACE-DIM-LE aa vv ndim)))
       (n (dk-skolem! fgex))
       (gex (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'amg_))) (dk-asms)))
       (g (dk-skolem! gex))
       (v0 (dk-skolem! (dk-ctx-form am-nontriv)))
       (zeros (list 'FORALL 'amk_ (list 'IMPLIES (list 'IN 'amk_ (list 'INTERVAL 1 n)) (list '= (list g 'amk_) 0)))))
  (fact 'fun-codomain-superset g (list 'INTERVAL 1 n) 'vv 'CC)
  (use-em zeros
    (lambda ()
      ;; all generators 0: V = {0}
      (let ((b0 (dk-skolem! (dk-apply! (dk-ctx-form (am-span n g)) v0))))
        (dk-have! (list 'FORALL 'amk_ (list 'IMPLIES (list 'IN 'amk_ (list 'INTERVAL 1 n)) (list 'IN (list b0 'amk_) 'CC)))
          (lambda () (let ((z (dk-di-var!))) (fact 'fun-apply-type-c b0 (list 'INTERVAL 1 n) 'aa z) (fact 'subset-mem-fwd 'aa 'CC (list b0 z)) (ass))))
        (dk-apply! (dk-cite! 'cc-lincomb-zero-generators n b0 g))
        (let ((h (dk-rewrite-h! (list '= v0 (list 'CC-LINCOMB n b0 g)) (list 'CC-LINCOMB n b0 g) 0)))
          (ma-prop-with! (list h (list 'NOT h))))))
    (lambda ()
      (let* ((ex (dk-landed-1 (lambda () (push-not-h (list 'NOT zeros)))))
             (k0 (dk-skolem! ex)))
        (cp-int-parts! 1 n k0)
        (ma-or-split! (dk-cite! 'nn-zero-or-succ n)
          (list
            (lambda ()
              (dk-have! '(< 0 0) (lambda () (dk-nn! (list '<= 1 k0) (list '<= k0 n) (list '= n 0))))
              (dk-cite! 'rr-lt-irrefl 0)
              (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0)))))
            (lambda ()
              (let* ((m (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f n))) (dk-asms))))
                     (sn (list 'succ m)) (int (list 'INTERVAL 1 sn)))
                (fact 'nn-succ-closed m)
                (ma-for-each (lambda (f) (dk-rewrite-h! f n sn))
                  (list (list 'IN g (list 'FUN (list 'INTERVAL 1 n) 'vv)) (list 'IN g (list 'FUN (list 'INTERVAL 1 n) 'CC))
                        (am-span n g) (list 'IN k0 (list 'INTERVAL 1 n))))
                (let* ((bm (am-bmat sn g)) (bl (cadddr bm))
                       (ch! (lambda (i)
                              ;; CHOICE S(i) in S(i): a coefficient sequence for r g(i)
                              (let ((si (am-sset sn g i)))
                                (if (not (dk-asm? (list 'IN (list 'CHOICE si) si)))
                                    (begin
                                      (fact 'fun-apply-type-c g int 'vv i)
                                      (dk-apply! (dk-ctx-form am-inv) (list g i))
                                      (dk-have! (list 'FORSOME 'cv_ (list 'IN 'cv_ si))
                                        (lambda ()
                                          (let ((b (dk-skolem! (dk-apply! (dk-ctx-form (am-span sn g)) (list '* 'r (list g i))))))
                                            (ew b)
                                            (in-sep! dk-ass! (lambda () (ass))))))
                                      (fact 'choice-axiom si)
                                      (ma-sep-parts! (list 'IN (list 'CHOICE si) si))))
                                (list 'CHOICE si)))))
                  ;; B: the coefficients of r g(i)
                  (ma-for-each
                    (lambda (cls)
                      (dk-have! (list 'FORALL 'cpu_ (list 'IMPLIES (list 'IN 'cpu_ int) (list 'FORALL 'cpv_ (list 'IMPLIES (list 'IN 'cpv_ int) (list 'IN (list bl 'cpu_ 'cpv_) cls)))))
                        (lambda ()
                          (let* ((ls (dk-peel!)) (vs (ma-map cadr ls)) (u (car vs)) (v (cadr vs)) (cu (ch! u)))
                            (fact 'fun-apply-type-c cu int 'aa v)
                            (fact 'subset-mem-fwd 'aa 'CC (list cu v))
                            (if (eq? cls 'SET) (fact 'membership-implies-sethood (list cu v) 'aa))
                            (dk-lam-b!)
                            (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass))))))
                    '(aa CC SET))
                  (dk-apply! (dk-cite! 'matof-in-mat sn sn 'aa bl))
                  (dk-apply! (dk-cite! 'matof-in-mat sn sn 'CC bl))
                  ;; the hypothesis of am-det-kills-generators
                  (dk-have! (am-hyp sn bm g 'r)
                    (lambda ()
                      (let* ((i (dk-di-var!)) (cu (ch! i))
                             (unf (dk-cite! 'cc-lincomb-unfold sn cu g))
                             (eqi (dk-rewrite-h! (list '= (list '* 'r (list g i)) (list 'CC-LINCOMB sn cu g)) (list 'CC-LINCOMB sn cu g) (am-lc-sep sn cu g)))
                             (f (list 'VNB-LAMBDA 'amj_ int (list '* (list 'ENTRY bm i 'amj_) (list g 'amj_))))
                             (f2 (caddr (caddr eqi))))
                        (dk-cite! 'ring-additive-ag-is-abelian-group cp-r)
                        (fact 'interval-in-set 1 sn)
                        (dk-apply! (dk-cite! 'interval-card-in-nn 1 sn))
                        (let ((pt! (lambda (z)
                                     (cp-int-parts! 1 sn z)
                                     (fact 'fun-apply-type-c cu int 'aa z) (fact 'subset-mem-fwd 'aa 'CC (list cu z))
                                     (fact 'fun-apply-type-c g int 'CC z)
                                     (dk-apply! (dk-cite! 'entry-of-matof sn sn bl i z))
                                     (cp-type! (list '* (list cu z) (list g z))))))
                          (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z int) (list '= (list f 'z) (list f2 'z))))
                            (lambda ()
                              (let ((z (dk-di-var!)))
                                (pt! z)
                                (dk-lam-b!)
                                (subst (list '= (list 'ENTRY bm i z) (list bl i z)))
                                (if (not (dk-lam-b!)) (rfl)))))
                          (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z int) (list 'IN (list f 'z) (list 'CARR cp-ag))))
                            (lambda ()
                              (let ((z (dk-di-var!)))
                                (pt! z)
                                (dk-lam-b!)
                                (subst (list '= (list 'ENTRY bm i z) (list bl i z)))
                                (dk-lam-b!)
                                (subst (list '= (list 'CARR cp-ag) 'CC))
                                (ass))))
                          (subst (dk-apply! (dk-cite! 'finsum-congruence cp-ag) int f f2))
                          (ass)))))
                  ;; det(B - rI) = 0
                  (let* ((lin (cp-lin sn bm (cp-negi sn) 'r))
                         (d (list 'DET cp-r sn lin))
                         (kills (dk-apply! (dk-cite! 'am-det-kills-generators) m bm g 'r)))
                    (fact 'fun-apply-type-c g int 'CC k0)
                    (cp-negi-at! sn)
                    (dk-split! (dk-apply! (dk-cite! 'cp-lin-mat) sn bm (cp-negi sn) 'r))
                    (cp-mat-carr! lin sn)
                    (dk-apply! (dk-cite! 'det-in-carrier cp-r sn lin))
                    (fact 'cc-scalar-ring-carr)
                    (dk-have! (list 'IN d 'CC) (lambda () (subst (list '= 'CC (list 'CARR cp-r))) (ass)))
                    (dk-apply! kills k0)
                    (dk-apply! (dk-cite! 'cc-mul-zero-left d (list g k0)))
                    ;; the characteristic polynomial, made monic
                    (let* ((c (dk-skolem! (dk-apply! (dk-apply! (dk-apply! (dk-cite! 'characteristic-polynomial) sn) 'aa) bm)))
                           (ssn (list 'succ sn))
                           (sg (cp-sign sn))
                           (c1 (list 'VNB-LAMBDA 'amk_ 'NN (list '* sg (list c 'amk_)))))
                      (dk-split! (dk-apply! (dk-apply! (dk-cite! 'cc-sign-in-subring) sn) 'aa))
                      (fact 'nn-is-set)
                      (fact 'nn-succ-closed sn)
                      (cp-fcc! c 'aa)
                      (dk-have! (list 'IN c1 '(FUN NN aa))
                        (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (fact 'fun-apply-type-c c 'NN 'aa k) (cp-mul-in! 'aa sg (list c k)) (ass))) (lambda () (ass)))))
                      (cp-fcc! c1 'aa)
                      (dk-have! (cp-lcomb c1 c c sg 0)
                        (lambda () (let ((k (dk-di-var!))) (fact 'fun-apply-type-c c 'NN 'CC k) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (crs)))))
                      (cp-ps-typ! c 'r ssn)
                      (let* ((cv (dk-apply! (dk-ctx-form (list 'FORALL 'cpz_ (list 'IMPLIES '(IN cpz_ CC) (list '= (list 'DET cp-r sn (cp-lin sn bm (cp-negi sn) 'cpz_)) (cp-ps c 'cpz_ ssn))))) 'r))
                             (lc (dk-apply! (dk-apply! (dk-cite! 'cc-ps-lincomb ssn c c c1 sg 0)) 'r)))
                        (dk-have! (list '= (cp-ps c1 'r ssn) 0)
                          (lambda ()
                            (subst lc)
                            (subst (list '= (cp-ps c 'r ssn) d))
                            (subst (list '= d 0))
                            (crs)))
                        (dk-have! (list '= (list c1 sn) 1)
                          (lambda ()
                            (fact 'fun-apply-type-c c 'NN 'CC sn)
                            (dk-lam-b!)
                            (subst (list '= (list c sn) sg))
                            (subst (dk-apply! (dk-cite! 'cc-sign-square) sn))
                            (rfl)))
                        (dk-have! (cp-van c1 ssn)
                          (lambda ()
                            (let* ((ls (dk-peel!)) (k (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) ls))))
                              (fact 'fun-apply-type-c c 'NN 'CC k)
                              (dk-apply! (dk-ctx-form (cp-van c ssn)) k)
                              (dk-lam-b!)
                              (subst (list '= (list c k) 0))
                              (crs))))
                        (dk-have! (list '<= sn 'ndim) (lambda () (dk-nn! (list '= n sn) (list '<= n 'ndim))))
                        (ew sn)
                        (dk-conj-close!
                          (lambda ()
                            (if (not (dk-ass!))
                                (begin (ew c1) (dk-conj-close! dk-ass!)))))))))))))))))
(qed 'algebraic-monic-of-invariant-space)

;;; a finitely generated module is a space of dimension at most its number of generators, and conversely
(define (am3-fg-body vs) (list 'FORSOME 'amn_ (list 'AND '(IN amn_ NN) (list 'FORSOME 'amg_ (list 'AND (list 'IN 'amg_ (list 'FUN '(INTERVAL 1 amn_) vs)) (am3-span-of vs 'amn_ 'amg_))))))
(define (am3-span-of vs n g) (list 'FORALL 'amv_ (list 'IMPLIES (list 'IN 'amv_ vs)
  (list 'FORSOME 'amb_ (list 'AND (list 'IN 'amb_ (list 'FUN (list 'INTERVAL 1 n) 'aa)) (list '= 'amv_ (list 'CC-LINCOMB n 'amb_ g)))))))
(define am-fgbody (list 'FORSOME 'amn_ (list 'AND '(IN amn_ NN) (list 'FORSOME 'amg_ (list 'AND '(IN amg_ (FUN (INTERVAL 1 amn_) vv)) (am-span 'amn_ 'amg_))))))
(define (am3-dim-body vs nd) (list 'FORSOME 'amn_ (list 'AND '(IN amn_ NN) (list 'AND (list '<= 'amn_ nd) (list 'FORSOME 'amg_ (list 'AND (list 'IN 'amg_ (list 'FUN '(INTERVAL 1 amn_) vs)) (am3-span-of vs 'amn_ 'amg_)))))))
(define (am3-reclose! pred n g)
  ;; goal (pred aa vv ...): the module conjunct and n, g with their facts in context
  (mac pred)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-ass!) #t)
            (#t (ew n)
                (dk-conj-close!
                  (lambda ()
                    (cond ((dk-ass!) #t)
                          ((dk-head-is? (dk-goal) '<=) (dk-nn!))
                          (#t (ew g) (dk-conj-close! dk-ass!))))))))))
(sp (make-wff '(FORALL aa (FORALL vv (IMPLIES (IS-FG-CC-MODULE-OVER aa vv) (FORSOME amd_ (AND (IN amd_ NN) (IS-CC-SPACE-DIM-LE aa vv amd_))))))))
(dk-peel!)
(dk-project! '(IS-CC-MODULE-OVER aa vv) 'is-fg-cc-module-over '(IS-FG-CC-MODULE-OVER aa vv))
(let* ((n (dk-skolem! (dk-project! (am3-fg-body 'vv) 'is-fg-cc-module-over '(IS-FG-CC-MODULE-OVER aa vv))))
       (g (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'amg_) (dk-contains? f n))) (dk-asms)))))
  (ew n)
  (dk-conj-close! (lambda () (if (not (dk-ass!)) (am3-reclose! 'is-cc-space-dim-le n g)))))
(qed 'fg-module-dim-le)
(sp (make-wff '(FORALL aa (FORALL vv (FORALL amd_ (IMPLIES (IS-CC-SPACE-DIM-LE aa vv amd_) (IS-FG-CC-MODULE-OVER aa vv)))))))
(dk-peel!)
(dk-project! '(IS-CC-MODULE-OVER aa vv) 'is-cc-space-dim-le '(IS-CC-SPACE-DIM-LE aa vv amd_))
(let* ((n (dk-skolem! (dk-project! (am3-dim-body 'vv 'amd_) 'is-cc-space-dim-le '(IS-CC-SPACE-DIM-LE aa vv amd_))))
       (g (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'amg_) (dk-contains? f n))) (dk-asms)))))
  (am3-reclose! 'is-fg-cc-module-over n g))
(qed 'dim-le-fg-module)

;;; (14) PROP. 4.18, module => algebraic, from the counted form
(sp (make-wff (forall-guarded '(aa r vv) (list '(IS-SUBRING-OF-CC aa) '(IN r CC) '(IS-FG-CC-MODULE-OVER aa vv) am-nontriv am-inv)
  '(IS-ALGEBRAIC-OVER aa r))))
(dk-peel!)
(let* ((nd (dk-skolem! (dk-apply! (dk-cite! 'fg-module-dim-le) 'aa 'vv)))
       (n (dk-skolem! (dk-apply! (dk-cite! 'algebraic-monic-of-invariant-space) 'aa 'r 'vv nd)))
       (c (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'anac_) (dk-contains? f n))) (dk-asms)))))
  (mac 'is-algebraic-over)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin (ew n) (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew c) (dk-conj-close! dk-ass!))))))))))
(qed 'algebraic-of-invariant-module)


;;; (15) laws of CC-LINCOMB: sum, scalar multiple, zero coefficients, unit coefficients, power sums
(define (am-int n) (list 'INTERVAL 1 n))
(define (am-lc n b g) (list 'CC-LINCOMB n b g))
(define (am-fs-setup! n)
  (cp-ring!) (am-carr-ag!)
  (dk-cite! 'ring-additive-ag-is-abelian-group cp-r)
  (fact 'interval-in-set 1 n)
  (dk-apply! (dk-cite! 'interval-card-in-nn 1 n)))
;;; the summand lambda of CC-LINCOMB(n, b, g)
(define (am-lsum n b g) (caddr (am-lc-sep n b g)))
;;; (IN f (FUN INT (CARR AG))) for a summand lambda, by a typer of the point
(define (am-sum-fun! f int typ!)
  (dk-have! (list 'IN f (list 'FUN int (list 'CARR cp-ag)))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*)))
            (typ! z)
            (subst (list '= (list 'CARR cp-ag) 'CC))
            (if (dk-contains? (dk-goal) 'VNB-LAMBDA) (dk-lam-b!))
            (if (not (sequent-node-grounded? leaf)) (dk-type! (cadr (dk-goal)) 'CC))))
        (lambda () (ass))))))
(define (am-cc-fun b n) (list 'IN b (list 'FUN (am-int n) 'CC)))

(sp (make-wff (forall-guarded '(n b1 b2 g) (list '(IN n NN) (am-cc-fun 'b1 'n) (am-cc-fun 'b2 'n) (am-cc-fun 'g 'n))
  (list '= (list '+ (am-lc 'n 'b1 'g) (am-lc 'n 'b2 'g))
           (am-lc 'n (list 'VNB-LAMBDA 'amj_ '(INTERVAL 1 n) '(+ (b1 amj_) (b2 amj_))) 'g)))))
(dk-peel!)
(am-fs-setup! 'n)
(let* ((int (am-int 'n)) (b3 (list 'VNB-LAMBDA 'amj_ int '(+ (b1 amj_) (b2 amj_))))
       (f1 (am-lsum 'n 'b1 'g)) (f2 (am-lsum 'n 'b2 'g)) (f3 (am-lsum 'n b3 'g))
       (t (list 'VNB-LAMBDA 'z int (list (list 'OPR cp-ag) (list f1 'z) (list f2 'z))))
       (typ! (lambda (z) (ma-for-each (lambda (f) (fact 'fun-apply-type-c f int 'CC z)) '(b1 b2 g)))))
  (am-sum-fun! f1 int typ!) (am-sum-fun! f2 int typ!)
  (dk-have! (list 'FORALL 'amz_ (list 'IMPLIES (list 'IN 'amz_ int) (list '= (list f3 'amz_) (list t 'amz_))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (typ! z)
        (cp-type! (list '+ (list 'b1 z) (list 'b2 z)))
        (dk-lam-b!)
        (subst (dk-cite! 'ras-op cp-r))
        (let ((y1 (list '* (list 'b1 z) (list 'g z))) (y2 (list '* (list 'b2 z) (list 'g z))))
          (cp-type! y1) (cp-type! y2)
          (subst (am-op-eq! 'ADD y1 y2))
          (crs)))))
  (dk-have! (list 'FORALL 'amz_ (list 'IMPLIES (list 'IN 'amz_ int) (list 'IN (list f3 'amz_) (list 'CARR cp-ag))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (typ! z)
        (cp-type! (list '+ (list 'b1 z) (list 'b2 z)))
        (dk-lam-b!)
        (subst (list '= (list 'CARR cp-ag) 'CC))
        (dk-type! (cadr (dk-goal)) 'CC))))
  (subst (dk-cite! 'cc-lincomb-unfold 'n 'b1 'g))
  (subst (dk-cite! 'cc-lincomb-unfold 'n 'b2 'g))
  (subst (dk-cite! 'cc-lincomb-unfold 'n b3 'g))
  (subst (dk-apply! (dk-cite! 'finsum-congruence cp-ag) int f3 t))
  (subst (dk-apply! (dk-cite! 'finsum-add-ag cp-ag) int f1 f2))
  (subst (dk-cite! 'ras-op cp-r))
  (dk-apply! (dk-cite! 'finsum-type cp-ag) int f1)
  (dk-apply! (dk-cite! 'finsum-type cp-ag) int f2)
  (ma-for-each (lambda (f) (dk-have! (list 'IN (cp-fs f int) 'CC) (lambda () (subst (list '= 'CC (list 'CARR cp-ag))) (ass)))) (list f1 f2))
  (subst (am-op-eq! 'ADD (cp-fs f1 int) (cp-fs f2 int)))
  (cp-type! (list '+ (cp-fs f1 int) (cp-fs f2 int)))
  (rfl))
(qed 'cc-lincomb-add)

(sp (make-wff (forall-guarded '(n a b g) (list '(IN n NN) '(IN a CC) (am-cc-fun 'b 'n) (am-cc-fun 'g 'n))
  (list '= (list '* 'a (am-lc 'n 'b 'g))
           (am-lc 'n (list 'VNB-LAMBDA 'amj_ '(INTERVAL 1 n) '(* a (b amj_))) 'g)))))
(dk-peel!)
(am-fs-setup! 'n)
(fact 'cc-scalar-ring-carr)
(let* ((int (am-int 'n)) (b3 (list 'VNB-LAMBDA 'amj_ int '(* a (b amj_))))
       (f1 (am-lsum 'n 'b 'g)) (f3 (am-lsum 'n b3 'g))
       (t (list 'VNB-LAMBDA 'z int (list (list 'MUL cp-r) 'a (list f1 'z))))
       (typ! (lambda (z) (ma-for-each (lambda (f) (fact 'fun-apply-type-c f int 'CC z)) '(b g)))))
  (am-sum-fun! f1 int typ!)
  (dk-have! (list 'IN f1 (list 'FUN int (list 'CARR cp-r))) (lambda () (subst (list '= (list 'CARR cp-r) 'CC)) (subst (list '= 'CC (list 'CARR cp-ag))) (ass)))
  (dk-have! (list 'IN 'a (list 'CARR cp-r)) (lambda () (subst (list '= (list 'CARR cp-r) 'CC)) (ass)))
  (dk-have! (list 'FORALL 'amz_ (list 'IMPLIES (list 'IN 'amz_ int) (list '= (list f3 'amz_) (list t 'amz_))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (typ! z)
        (cp-type! (list '* 'a (list 'b z)))
        (dk-lam-b!)
        (let ((y (list '* (list 'b z) (list 'g z))))
          (cp-type! y)
          (subst (am-op-eq! 'MUL 'a y))
          (crs)))))
  (dk-have! (list 'FORALL 'amz_ (list 'IMPLIES (list 'IN 'amz_ int) (list 'IN (list f3 'amz_) (list 'CARR cp-ag))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (typ! z)
        (cp-type! (list '* 'a (list 'b z)))
        (dk-lam-b!)
        (subst (list '= (list 'CARR cp-ag) 'CC))
        (dk-type! (cadr (dk-goal)) 'CC))))
  (subst (dk-cite! 'cc-lincomb-unfold 'n 'b 'g))
  (subst (dk-cite! 'cc-lincomb-unfold 'n b3 'g))
  (subst (dk-apply! (dk-cite! 'finsum-congruence cp-ag) int f3 t))
  (let ((e (dk-apply! (dk-cite! 'finsum-ring-distrib-left-gen cp-r) 'a int f1)))
    (subst (list '= (cp-fs t int) (list (list 'MUL cp-r) 'a (cp-fs f1 int))))
    (dk-apply! (dk-cite! 'finsum-type cp-ag) int f1)
    (dk-have! (list 'IN (cp-fs f1 int) 'CC) (lambda () (subst (list '= 'CC (list 'CARR cp-ag))) (ass)))
    (subst (am-op-eq! 'MUL 'a (cp-fs f1 int)))
    (cp-type! (list '* 'a (cp-fs f1 int)))
    (rfl)))
(qed 'cc-lincomb-scale)

(sp (make-wff (forall-guarded '(n g) (list '(IN n NN) (am-cc-fun 'g 'n))
  (list '= (am-lc 'n (list 'VNB-LAMBDA 'amj_ '(INTERVAL 1 n) 0) 'g) 0))))
(dk-peel!)
(am-fs-setup! 'n)
(fact 'cc-zero-in)
(let* ((int (am-int 'n)) (b0 (list 'VNB-LAMBDA 'amj_ int 0)) (f (am-lsum 'n b0 'g)))
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ int) (list '= (list f 'z_) (list 'IDEN cp-ag))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (fact 'fun-apply-type-c 'g int 'CC z)
        (dk-lam-b!)
        (subst (dk-cite! 'ras-id cp-r))
        (subst (dk-cite! 'cc-scalar-ring-zero))
        (crs))))
  (subst (dk-cite! 'cc-lincomb-unfold 'n b0 'g))
  (subst (dk-apply! (dk-cite! 'finsum-all-id-ptwise cp-ag) int f))
  (subst (dk-cite! 'ras-id cp-r))
  (subst (dk-cite! 'cc-scalar-ring-zero))
  (rfl))
(qed 'cc-lincomb-zero-coefficients)

(define (am-unit i n) (list 'VNB-LAMBDA 'amj_ (am-int n) (list 'IF (list '= 'amj_ i) 1 0)))
(sp (make-wff (forall-guarded '(n g i) (list '(IN n NN) (am-cc-fun 'g 'n) '(IN i (INTERVAL 1 n)))
  (list '= (am-lc 'n (am-unit 'i 'n) 'g) '(g i)))))
(dk-peel!)
(am-fs-setup! 'n)
(fact 'cc-zero-in) (fact 'cc-one-in)
(let* ((int (am-int 'n)) (u (am-unit 'i 'n)) (f (am-lsum 'n u 'g))
       (ift (lambda (z) (list 'IF (list '= z 'i) 1 0)))
       (typ! (lambda (z)
               (fact 'fun-apply-type-c 'g int 'CC z)
               (dk-have! (list 'IN (ift z) 'CC) (lambda () (dk-case-if! (ift z) (lambda (t? v) (ass))))))))
  (am-sum-fun! f int typ!)
  (dk-have! (list 'FORALL 'j (list 'IMPLIES (list 'IN 'j int) (list 'IMPLIES '(NOT (= j i)) (list '= (list f 'j) (list 'IDEN cp-ag)))))
    (lambda ()
      (let* ((ls (dk-peel!)) (j (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) ls))))
        (fact 'fun-apply-type-c 'g int 'CC j)
        (dk-lam-b!)
        (subst (dk-cite! 'ras-id cp-r))
        (subst (dk-cite! 'cc-scalar-ring-zero))
        (dk-if-branch! #f (ift j) #f (lambda () (crs))))))
  (typ! 'i)
  (subst (dk-cite! 'cc-lincomb-unfold 'n u 'g))
  (subst (dk-apply! (dk-cite! 'finsum-single-support cp-ag) int f 'i))
  (dk-lam-b!)
  (dk-if-branch! #t (ift 'i) (lambda () (rfl)) (lambda () (crs))))
(qed 'cc-lincomb-unit)

;;; a power sum is a combination of the generators r^(i-1)
(define (am-cb c n) (list 'VNB-LAMBDA 'ami_ (am-int n) (list c '(NN-MINUS ami_ 1))))
(define (am-gp r n) (list 'VNB-LAMBDA 'ami_ (am-int n) (list 'power r '(NN-MINUS ami_ 1))))
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (forall-guarded '(nb c r) '((IN nb NN) (IN c (FUN NN CC)) (IN r CC) (<= k nb))
  (list '= (cp-fs (am-lsum 'nb (am-cb 'c 'nb) (am-gp 'r 'nb)) '(INTERVAL 1 k)) (cp-ps 'c 'r 'k)))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (cp-ring!)
  (subst (dk-cite! 'interval-1-0-empty))
  (cp-empty-sum! (am-lsum 'nb (am-cb 'c 'nb) (am-gp 'r 'nb)))
  (subst (dk-cite! 'cc-series-partial-sum-zero (list 'VNB-LAMBDA 'pfj_ 'NN '(* (c pfj_) (power r pfj_)))))
  (fact 'cc-zero-in)
  (rfl)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (am-fs-setup! 'nb)
  (fact 'nn-succ-closed v)
  (fact 'nn-one-in)
  (let* ((h (am-lsum 'nb (am-cb 'c 'nb) (am-gp 'r 'nb))) (big (am-int 'nb)) (ik (am-int v)) (sk (list 'succ v))
         (un (list 'UNION ik (list 'PAIR sk sk)))
         (pf (list 'VNB-LAMBDA 'pfj_ 'NN '(* (c pfj_) (power r pfj_))))
         (hval! (lambda (w)
                  ;; w in INTERVAL(1, nb): h(w) = c(w - 1) r^(w - 1), typed
                  (cp-int-parts! 1 'nb w)
                  (fact 'nn-minus-in-nn w 1)
                  (let ((km (list 'NN-MINUS w 1)))
                    (fact 'fun-apply-type-c 'c 'NN 'CC km)
                    (cp-type! (list 'power 'r km))
                    (cp-type! (list '* (list 'c km) (list 'power 'r km)))
                    (let ((e (list '= (list h w) (list '* (list 'c km) (list 'power 'r km)))))
                      (dk-have! e (lambda () (if (not (dk-lam-b!)) (rfl))))
                      e)))))
    (dk-have! (list '<= v 'nb) (lambda () (dk-nn! (list '<= sk 'nb))))
    (dk-apply! (dk-ctx-form ih) 'nb 'c 'r)
    ;; the new term
    (dk-have! (list 'IN sk big) (lambda () (dk-have! (list '<= 1 sk) (lambda () (dk-nn!))) (dk-apply! (dk-cite! 'interval-mem-intro 1 'nb sk)) (ass)))
    (let ((e-sk (hval! sk)))
      (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ un) (list 'IN (list h 'z_) (list 'CARR cp-ag))))
        (lambda ()
          (let* ((w (dk-di-var!))
                 (or1 (car (ma-iff-parts! (dk-cite! 'union-membership ik (list 'PAIR sk sk) w)))))
            (subst (list '= (list 'CARR cp-ag) 'CC))
            (ma-or-split! or1
              (list
                (lambda ()
                  (cp-int-parts! 1 v w)
                  (dk-have! (list '<= w 'nb) (lambda () (dk-nn! (list '<= w v) (list '<= sk 'nb))))
                  (dk-apply! (dk-cite! 'interval-mem-intro 1 'nb w))
                  (subst (hval! w))
                  (ass))
                (lambda ()
                  (fact 'membership-implies-sethood sk 'NN)
                  (ma-singleton-eq! w sk)
                  (subst (list '= w sk))
                  (subst e-sk)
                  (ass)))))))
      (fact 'interval-in-set 1 v)
      (dk-apply! (dk-cite! 'interval-card-in-nn 1 v))
      (fact 'membership-implies-sethood sk 'NN)
      (dk-have! (list 'NOT (list 'IN sk ik))
        (lambda () (di) (cp-int-parts! 1 v sk) (dk-have! '(< 0 0) (lambda () (dk-nn! (list '<= sk v)))) (dk-cite! 'rr-lt-irrefl 0) (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0))))))
      (let* ((e0 (dk-cite! 'interval-succ-insert v))
             (e1 (dk-apply! (dk-cite! 'finsum-insert-ptwise cp-ag) ik sk h))
             (km (list 'NN-MINUS sk 1)))
        (cp-fcc! 'c 'CC)
        (cp-ps-typ! 'c 'r v)
        (fact 'fun-apply-type-c 'c 'NN 'CC v)
        (cp-type! (list 'power 'r v))
        (dk-have! (list 'IN (list pf v) 'CC) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-type! (cadr (dk-goal)) 'CC))))
        (let ((e2 (dk-apply! (dk-cite! 'cc-series-partial-sum-succ pf) v)))
          (subst e0) (subst e1)
          (subst (dk-cite! 'ras-op cp-r))
          (subst (list '= (cp-fs h ik) (cp-ps 'c 'r v)))
          (subst e-sk)
          (subst (dk-apply! (dk-cite! 'nn-minus-succ-1) v))
          (subst e2)
          (dk-lam-b!)
          (cp-type! (list '* (list 'c v) (list 'power 'r v)))
          (let ((w (dk-name! (cp-ps 'c 'r v) 'CC)))
            (subst (list '= (cp-ps 'c 'r v) w))
            (subst (dk-cite! 'cc-scalar-ring-add))
            (dk-lam-b!)
            (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                (begin (cp-type! (list '+ w (list '* (list 'c v) (list 'power 'r v)))) (rfl)))))))))
(qed 'cc-power-sum-as-lincomb)


;;; (16) PROP. 4.18, algebraic => module, counted: for a monic relation of degree n, the span of 1, r, ..., r^(n-1)
;;; over A is an r-invariant space of dimension <= n
(define am-algo-body
  (list 'FORSOME 'anan_ (list 'AND '(IN anan_ NN)
    (list 'FORSOME 'anac_ (list 'AND '(IN anac_ (FUN NN aa))
      (list 'AND (cp-van 'anac_ '(succ anan_))
        (list 'AND '(= (anac_ anan_) 1) (list '= (cp-ps 'anac_ 'r '(succ anan_)) 0))))))))
(define (am-vspan n gp) (list 'SEP 'amvv_ 'CC (list 'FORSOME 'amb_ (list 'AND (list 'IN 'amb_ (list 'FUN (am-int n) 'aa)) (list '= 'amvv_ (am-lc n 'amb_ gp))))))
(define (am-pow-succ! x k)
  ;; (= (power x (succ k)) (* x (power x k))), x in CC, k in NN
  (dk-have! (list 'AND (list 'IN x 'CC) (list 'IN k 'NN)))
  (fact 'power-succ x k))

(define am16-dim-le '(IS-CC-SPACE-DIM-LE aa vv ndg))
(sp (make-wff (forall-guarded '(aa r ndg c) (list '(IS-SUBRING-OF-CC aa) '(IN r CC) '(IN ndg NN) '(IN c (FUN NN aa)) (cp-van 'c '(succ ndg)) '(= (c ndg) 1)
                                                  (list '= (cp-ps 'c 'r '(succ ndg)) 0))
  (list 'FORSOME 'vv (list 'AND am16-dim-le (list 'AND am-nontriv am-inv))))))
(dk-peel!)
(cp-ring!)
(am-carr-ag!)
(cp-sub-parts! 'aa)
(fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-one-in) (fact 'nn-zero-in) (fact 'cc-neg-closed 1)
(cp-neg-in! 'aa 1)
(let* ((n 'ndg)
       (c 'c)
       (pf (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list c 'pfj_) '(power r pfj_)))))
  (cp-fcc! c 'aa)
  (fact 'fun-apply-type-c c 'NN 'CC n)
  (cp-type! (list 'power 'r n))
  (cp-ps-typ! c 'r n)
  (dk-have! (list 'IN (list pf n) 'CC) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-type! (cadr (dk-goal)) 'CC))))
  ;; r^n = - sum_{k < n} c(k) r^k
  (let ((e-ps (dk-apply! (dk-cite! 'cc-series-partial-sum-succ pf) n)))
    (dk-have! (list '= (list 'power 'r n) (list '- (cp-ps c 'r n)))
      (lambda ()
        (let ((h (dk-rewrite-h! (list '= (cp-ps c 'r (list 'succ n)) 0) (cp-ps c 'r (list 'succ n)) (list '+ (cp-ps c 'r n) (list pf n)))))
          (dk-have! (list '= (list pf n) (list '* (list c n) (list 'power 'r n))) (lambda () (if (not (dk-lam-b!)) (rfl))))
          (let* ((h2 (dk-rewrite-h! h (list pf n) (list '* (list c n) (list 'power 'r n))))
                 (h3 (dk-rewrite-h! h2 (list c n) 1))
                 (pw (list 'power 'r n)) (ps (cp-ps c 'r n))
                 (sum (cadr h3))
                 (id (list '= pw (list '- sum ps))))
            (dk-have! id (lambda () (crs)))
            (subst id)
            (subst h3)
            (crs))))))
  (ma-or-split! (dk-cite! 'nn-zero-or-succ n)
    (list
      ;; n = 0: the polynomial is the constant 1
      (lambda ()
        (let* ((h (dk-rewrite-h! (list '= (list 'power 'r n) (list '- (cp-ps c 'r n))) n 0)))
          (fact 'power-zero 'r)
          (dk-have! '(= 1 0)
            (lambda ()
              (let* ((h2 (dk-rewrite-h! h '(power r 0) 1))
                     (z0 (dk-cite! 'cc-series-partial-sum-zero pf)))
                (dk-have! (list '= (cp-ps c 'r 0) 0) (lambda () (subst z0) (rfl)))
                (let ((h3 (dk-rewrite-h! h2 (cp-ps c 'r 0) 0)))
                  (dk-ineq! h3)))))
          (dk-have! '(< 0 0) (lambda () (dk-ineq! '(= 1 0))))
          (dk-cite! 'rr-lt-irrefl 0)
          (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0))))))
      (lambda ()
        (let* ((m (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f n))) (dk-asms))))
               (int (am-int n)) (gp (am-gp 'r n)) (vs (am-vspan n gp))
               (lcin! (lambda (v b)
                        ;; (IN v V) from b in FUN(INT, aa), v = LC(n, b, gp), v in CC
                        (dk-have! (list 'IN v vs)
                          (lambda () (in-sep! dk-ass! (lambda () (ew b) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))))
               (vopen! (lambda (v)
                         ;; v in V: land b with b in FUN(INT, aa), FUN(INT, CC), v = LC(n, b, gp); return b
                         (let ((b (dk-skolem! (ma-sep-parts! (list 'IN v vs)))))
                           (fact 'fun-codomain-superset b int 'aa 'CC)
                           b))))
          (fact 'nn-succ-closed m)
          (dk-have! (list '<= 1 n) (lambda () (dk-nn! (list '= n (list 'succ m)))))
          (ma-sep-subset! vs)
          ;; the generators r^(i-1)
          (dk-have! (list 'IN gp (list 'FUN int 'CC))
            (lambda ()
              (dk-lam-type! (lambda () (let ((i (dk-di-var!))) (cp-int-parts! 1 n i) (fact 'nn-minus-in-nn i 1) (cp-type! (list 'power 'r (list 'NN-MINUS i 1))) (ass)))
                            (lambda () (fact 'interval-in-set 1 n) (ass)))))
          ;; 0 in V
          (let ((b0 (list 'VNB-LAMBDA 'amj_ int 0)))
            (dk-have! (list 'IN b0 (list 'FUN int 'aa)) (lambda () (dk-lam-type! (lambda () (dk-di-var!) (ass)) (lambda () (fact 'interval-in-set 1 n) (ass)))))
            (dk-apply! (dk-cite! 'cc-lincomb-zero-coefficients) n gp)
            (dk-have! (list '= 0 (am-lc n b0 gp)) (lambda () (subst (list '= (am-lc n b0 gp) 0)) (rfl)))
            (lcin! 0 b0))
          ;; the closure laws of V
          (dk-have! (list 'FORALL 'amx_ (list 'IMPLIES (list 'IN 'amx_ vs) (list 'FORALL 'amy_ (list 'IMPLIES (list 'IN 'amy_ vs) (list 'IN '(+ amx_ amy_) vs)))))
            (lambda ()
              (let* ((ls (dk-peel!)) (xy (ma-map cadr ls)) (x (car xy)) (y (cadr xy))
                     (b1 (vopen! x)) (b2 (vopen! y))
                     (b3 (list 'VNB-LAMBDA 'amj_ int (list '+ (list b1 'amj_) (list b2 'amj_)))))
                (fact 'subset-mem-fwd vs 'CC x) (fact 'subset-mem-fwd vs 'CC y)
                (cp-type! (list '+ x y))
                (dk-have! (list 'IN b3 (list 'FUN int 'aa))
                  (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (fact 'fun-apply-type-c b1 int 'aa j) (fact 'fun-apply-type-c b2 int 'aa j) (cp-add-in! 'aa (list b1 j) (list b2 j)) (ass))) (lambda () (fact 'interval-in-set 1 n) (ass)))))
                (let ((e (dk-apply! (dk-cite! 'cc-lincomb-add) n b1 b2 gp)))
                  (dk-have! (list '= (list '+ x y) (am-lc n b3 gp))
                    (lambda () (subst (list '= x (am-lc n b1 gp))) (subst (list '= y (am-lc n b2 gp))) (ass))))
                (lcin! (list '+ x y) b3))))
          (let ((scale-in!
                  (lambda (a x)
                    ;; a in CC with a * b(j) in aa for b the coefficients of x: (* a x) in V
                    (let* ((b (vopen! x)) (b3 (list 'VNB-LAMBDA 'amj_ int (list '* a (list b 'amj_)))))
                      (fact 'subset-mem-fwd vs 'CC x)
                      (cp-type! (list '* a x))
                      (dk-have! (list 'IN b3 (list 'FUN int 'aa))
                        (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (fact 'fun-apply-type-c b int 'aa j) (cp-mul-in! 'aa a (list b j)) (ass))) (lambda () (fact 'interval-in-set 1 n) (ass)))))
                      (let ((e (dk-apply! (dk-cite! 'cc-lincomb-scale) n a b gp)))
                        (dk-have! (list '= (list '* a x) (am-lc n b3 gp))
                          (lambda () (subst (list '= x (am-lc n b gp))) (ass))))
                      (lcin! (list '* a x) b3)))))
            (dk-have! (list 'FORALL 'ama_ (list 'IMPLIES '(IN ama_ aa) (list 'FORALL 'amx_ (list 'IMPLIES (list 'IN 'amx_ vs) (list 'IN '(* ama_ amx_) vs)))))
              (lambda ()
                (let* ((ls (dk-peel!)) (ax (ma-map cadr ls)) (a (car ax)) (x (cadr ax)))
                  (fact 'subset-mem-fwd 'aa 'CC a)
                  (scale-in! a x))))
            (dk-have! (list 'FORALL 'amx_ (list 'IMPLIES (list 'IN 'amx_ vs) (list 'IN '(- amx_) vs)))
              (lambda ()
                (let ((x (dk-di-var!)))
                  (scale-in! '(- 1) x)
                  (dk-have! (list '= (list '- x) (list '* '(- 1) x)) (lambda () (crs)))
                  (subst (list '= (list '- x) (list '* '(- 1) x)))
                  (ass)))))
          ;; the generators lie in V
          (dk-have! (list 'IN gp (list 'FUN int vs))
            (lambda ()
              (dk-lam-type!
                (lambda ()
                  (let* ((i (dk-di-var!)) (u (am-unit i n)) (pw (list 'power 'r (list 'NN-MINUS i 1))))
                    (cp-int-parts! 1 n i)
                    (fact 'nn-minus-in-nn i 1)
                    (cp-type! pw)
                    (dk-have! (list 'IN u (list 'FUN int 'aa))
                      (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (dk-case-if! (list 'IF (list '= j i) 1 0) (lambda (t? v) (ass))))) (lambda () (fact 'interval-in-set 1 n) (ass)))))
                    (dk-apply! (dk-cite! 'cc-lincomb-unit) n gp i)
                    (dk-have! (list '= pw (am-lc n u gp))
                      (lambda () (subst (list '= (am-lc n u gp) (list gp i))) (if (not (dk-lam-b!)) (rfl))))
                    (lcin! pw u)
                    (ass)))
                (lambda () (fact 'interval-in-set 1 n) (ass)))))
          ;; r g(i) is in V
          (let ((rg (list 'FORALL 'ami_ (list 'IMPLIES (list 'IN 'ami_ int) (list 'IN (list '* 'r (list gp 'ami_)) vs)))))
            (dk-have! rg
              (lambda ()
                (let* ((i (dk-di-var!)))
                  (cp-int-parts! 1 n i)
                  (fact 'nn-minus-in-nn i 1)
                  (dk-have! (list '= (list gp i) (list 'power 'r (list 'NN-MINUS i 1))) (lambda () (cp-type! (list 'power 'r (list 'NN-MINUS i 1))) (if (not (dk-lam-b!)) (rfl))))
                  (subst (list '= (list gp i) (list 'power 'r (list 'NN-MINUS i 1))))
                  (ma-or-split! (dk-cite! 'nn-zero-or-succ i)
                    (list
                      (lambda ()
                        (dk-have! '(< 0 0) (lambda () (dk-nn! (list '= i 0) (list '<= 1 i))))
                        (dk-cite! 'rr-lt-irrefl 0)
                        (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0)))))
                      (lambda ()
                        (let ((q (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f i))) (dk-asms)))))
                          (subst (list '= i (list 'succ q)))
                          (subst (dk-apply! (dk-cite! 'nn-minus-succ-1) q))
                          (am-pow-succ! 'r q)
                          (subst (list '= (list '* 'r (list 'power 'r q)) (list 'power 'r (list 'succ q))))
                          (use-em (list '= i n)
                            (lambda ()
                              ;; r^n: minus the power sum
                              (let* ((cb (am-cb c n)) (h (am-lsum n cb gp)))
                                (dk-have! (list '= (list 'succ q) n) (lambda () (subst (list '= (list 'succ q) i)) (ass)))
                                (subst (list '= (list 'succ q) n))
                                (dk-have! (list 'IN cb (list 'FUN int 'aa))
                                  (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (cp-int-parts! 1 n j) (fact 'nn-minus-in-nn j 1) (fact 'fun-apply-type-c c 'NN 'aa (list 'NN-MINUS j 1)) (ass))) (lambda () (fact 'interval-in-set 1 n) (ass)))))
                                (dk-have! (list '<= n n) (lambda () (dk-nn!)))
                                (let ((e1 (dk-apply! (dk-apply! (dk-cite! 'cc-power-sum-as-lincomb) n) n c 'r)))
                                  (dk-cite! 'cc-lincomb-unfold n cb gp)
                                  (dk-have! (list '= (cp-ps c 'r n) (am-lc n cb gp))
                                    (lambda () (subst (list '= (am-lc n cb gp) (cp-fs h int))) (subst e1) (rfl)))
                                  (dk-have! (list 'IN (am-lc n cb gp) 'CC) (lambda () (subst (list '= (am-lc n cb gp) (cp-ps c 'r n))) (ass)))
                                  (lcin! (am-lc n cb gp) cb)
                                  (dk-apply! (dk-ctx-form (list 'FORALL 'amx_ (list 'IMPLIES (list 'IN 'amx_ vs) (list 'IN '(- amx_) vs)))) (am-lc n cb gp))
                                  (subst (list '= (list 'power 'r n) (list '- (cp-ps c 'r n))))
                                  (subst (list '= (cp-ps c 'r n) (am-lc n cb gp)))
                                  (ass))))
                            (lambda ()
                              ;; r^i with i + 1 <= n: the next generator
                              (let ((si (list 'succ i)))
                                (fact 'nn-succ-closed i)
                                (dk-have! (list '<= si n)
                                  (lambda ()
                                    (fact 'nn-in-rr i) (fact 'nn-in-rr n)
                                    (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases i n))
                                      (list (lambda () (dk-apply! (dk-cite! 'nn-lt-succ-le i n)) (ass))
                                            (lambda () (ma-prop-with! (list (list '= i n) (list 'NOT (list '= i n)))))))))
                                (dk-have! (list '<= 1 si) (lambda () (dk-nn!)))
                                (dk-apply! (dk-cite! 'interval-mem-intro 1 n si))
                                (fact 'fun-apply-type-c gp int vs si)
                                (fact 'nn-minus-in-nn si 1)
                                (dk-have! (list '= (list gp si) (list 'power 'r (list 'NN-MINUS si 1)))
                                  (lambda () (cp-type! (list 'power 'r (list 'NN-MINUS si 1))) (if (not (dk-lam-b!)) (rfl))))
                                (dk-apply! (dk-cite! 'nn-minus-succ-1) i)
                                (let* ((h1 (dk-rewrite-h! (list 'IN (list gp si) vs) (list gp si) (list 'power 'r (list 'NN-MINUS si 1))))
                                       (h2 (dk-rewrite-h! h1 (list 'NN-MINUS si 1) i))
                                       )
                                  (subst (list '= (list 'succ q) i))
                                  (ass))))))))))))
            ;; the module
            (let* ((one-in (list 'IN 1 vs)))
              (dk-have! (list 'IN 1 int) (lambda () (dk-have! '(<= 1 1) (lambda () (dk-nn!))) (dk-apply! (dk-cite! 'interval-mem-intro 1 n 1)) (ass)))
              (dk-have! one-in
                (lambda ()
                  (fact 'fun-apply-type-c gp int vs 1)
                  (fact 'nn-minus-in-nn 1 1)
                  (dk-have! (list '= (list gp 1) '(power r (NN-MINUS 1 1))) (lambda () (cp-type! '(power r (NN-MINUS 1 1))) (if (not (dk-lam-b!)) (rfl))))
                  (dk-apply! (dk-cite! 'nn-minus-succ-1) 0)
                  (dk-have! '(= (succ 0) 1) (lambda () (arith)))
                  (fact 'power-zero 'r)
                  (let* ((e0 (dk-rewrite-h! '(= (NN-MINUS (succ 0) 1) 0) '(succ 0) 1))
                         (h1 (dk-rewrite-h! (list 'IN (list gp 1) vs) (list gp 1) '(power r (NN-MINUS 1 1))))
                         (h2 (dk-rewrite-h! h1 '(NN-MINUS 1 1) 0))
                         (h3 (dk-rewrite-h! h2 '(power r 0) 1)))
                    (ass))))
              (dk-have! '(NOT (= 1 0)) (lambda () (di) (dk-absurd! '(= 1 0))))
              (ew vs)
              (dk-conj-close!
                (lambda ()
                  (let ((g (dk-goal)))
                    (cond
                      ((dk-ass!) #t)
                      ((dk-head-is? g 'IS-CC-SPACE-DIM-LE)
                       (mac 'is-cc-space-dim-le)
                       (dk-conj-close!
                         (lambda ()
                           (cond
                             ((dk-ass!) #t)
                             ((dk-head-is? (dk-goal) 'IS-CC-MODULE-OVER) (mac 'is-cc-module-over) (dk-conj-close! dk-ass!))
                             (#t
                              (ew n)
                              (dk-conj-close!
                                (lambda ()
                                  (cond
                                    ((dk-ass!) #t)
                                    ((dk-head-is? (dk-goal) '<=) (dk-nn!))
                                    (#t
                                     (ew gp)
                                     (dk-conj-close!
                                       (lambda ()
                                         (if (not (dk-ass!))
                                             (let ((v (dk-di-var!)))
                                               (ma-sep-parts! (list 'IN v vs))
                                               (ass))))))))))))))
                      ((dk-head-is? g 'FORSOME)
                       (ew 1)
                       (dk-conj-close! dk-ass!))
                      (#t
                       ;; r V in V: a sum of elements of V
                       (let* ((v (dk-di-var!)) (b (vopen! v)) (sm (am-lsum n b gp))
                              (rs (list 'VNB-LAMBDA 'z int (list (list 'MUL cp-r) 'r (list sm 'z)))))
                         (fact 'cc-scalar-ring-carr)
                         (dk-cite! 'ring-additive-ag-is-abelian-group cp-r)
                         (fact 'interval-in-set 1 n)
                         (dk-apply! (dk-cite! 'interval-card-in-nn 1 n))
                         (am-sum-fun! sm int (lambda (z) (fact 'fun-apply-type-c b int 'CC z) (fact 'fun-apply-type-c gp int 'CC z)
                                                (cp-int-parts! 1 n z) (fact 'nn-minus-in-nn z 1) (cp-type! (list 'power 'r (list 'NN-MINUS z 1)))))
                         (dk-have! (list 'IN sm (list 'FUN int (list 'CARR cp-r))) (lambda () (subst (list '= (list 'CARR cp-r) 'CC)) (subst (list '= 'CC (list 'CARR cp-ag))) (ass)))
                         (dk-have! (list 'IN 'r (list 'CARR cp-r)) (lambda () (subst (list '= (list 'CARR cp-r) 'CC)) (ass)))
                         (dk-apply! (dk-cite! 'finsum-type cp-ag) int sm)
                         (dk-have! (list 'IN (cp-fs sm int) 'CC) (lambda () (subst (list '= 'CC (list 'CARR cp-ag))) (ass)))
                         (dk-cite! 'cc-lincomb-unfold n b gp)
                         (subst (list '= v (am-lc n b gp)))
                         (subst (list '= (am-lc n b gp) (cp-fs sm int)))
                         (am-op-eq! 'MUL 'r (cp-fs sm int))
                         (subst (list '= (list '* 'r (cp-fs sm int)) (list (list 'MUL cp-r) 'r (cp-fs sm int))))
                         (subst (dk-apply! (dk-cite! 'finsum-ring-distrib-left-gen cp-r) 'r int sm))
                         (dk-have! (list 'IN (list 'IDEN cp-ag) vs) (lambda () (subst (dk-cite! 'ras-id cp-r)) (subst (dk-cite! 'cc-scalar-ring-zero)) (ass)))
                         (dk-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ vs) (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ vs) (list 'IN (list (list 'OPR cp-ag) 'x_ 'y_) vs)))))
                           (lambda ()
                             (let* ((ls (dk-peel!)) (xy (ma-map cadr ls)) (x (car xy)) (y (cadr xy)))
                               (fact 'subset-mem-fwd vs 'CC x) (fact 'subset-mem-fwd vs 'CC y)
                               (subst (dk-cite! 'ras-op cp-r))
                               (subst (am-op-eq! 'ADD x y))
                               (dk-apply! (dk-ctx-form (list 'FORALL 'amx_ (list 'IMPLIES (list 'IN 'amx_ vs) (list 'FORALL 'amy_ (list 'IMPLIES (list 'IN 'amy_ vs) (list 'IN '(+ amx_ amy_) vs)))))) x y)
                               (ass))))
                         (dk-have! (list 'IN rs (list 'FUN int (list 'CARR cp-ag)))
                           (lambda ()
                             (dk-lam-type!
                               (lambda ()
                                 (let* ((z (dk-di-var!)) (t (list '* (list b z) (list 'power 'r (list 'NN-MINUS z 1)))))
                                   (fact 'fun-apply-type-c b int 'CC z)
                                   (cp-int-parts! 1 n z) (fact 'nn-minus-in-nn z 1) (cp-type! (list 'power 'r (list 'NN-MINUS z 1)))
                                   (cp-type! t)
                                   (dk-lam-b!)
                                   (subst (am-op-eq! 'MUL 'r t))
                                   (subst (list '= (list 'CARR cp-ag) 'CC))
                                   (cp-type! (list '* 'r t))
                                   (ass)))
                               (lambda () (ass)))))
                         (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z int) (list 'IN (list rs 'z) vs)))
                           (lambda ()
                             (let* ((z (dk-di-var!)) (pw (list 'power 'r (list 'NN-MINUS z 1))) (t (list '* (list b z) pw)))
                               (fact 'fun-apply-type-c b int 'aa z) (fact 'fun-apply-type-c b int 'CC z)
                               (cp-int-parts! 1 n z) (fact 'nn-minus-in-nn z 1) (cp-type! pw) (cp-type! t)
                               (dk-lam-b!)
                               (subst (am-op-eq! 'MUL 'r t))
                               (dk-have! (list '= (list gp z) pw) (lambda () (if (not (dk-lam-b!)) (rfl))))
                               (let ((h (dk-rewrite-h! (dk-apply! (dk-ctx-form rg) z) (list gp z) pw)))
                                 (dk-apply! (dk-ctx-form (list 'FORALL 'ama_ (list 'IMPLIES '(IN ama_ aa) (list 'FORALL 'amx_ (list 'IMPLIES (list 'IN 'amx_ vs) (list 'IN '(* ama_ amx_) vs)))))) (list b z) (list '* 'r pw))
                                 (dk-have! (list '= (list '* 'r t) (list '* (list b z) (list '* 'r pw))) (lambda () (crs)))
                                 (subst (list '= (list '* 'r t) (list '* (list b z) (list '* 'r pw))))
                                 (ass)))))
                         (dk-apply! (dk-cite! 'finsum-in-subset cp-ag) vs int rs)
                         (ass))))))))))))))
(qed 'invariant-space-of-relation)

;;; (16) PROP. 4.18, algebraic => module, from the counted form
(sp (make-wff (forall-guarded '(aa r) '((IS-SUBRING-OF-CC aa) (IS-ALGEBRAIC-OVER aa r))
  (list 'FORSOME 'vv (list 'AND '(IS-FG-CC-MODULE-OVER aa vv) (list 'AND am-nontriv am-inv))))))
(dk-peel!)
(dk-project! '(IN r CC) 'is-algebraic-over '(IS-ALGEBRAIC-OVER aa r))
(let* ((n (dk-skolem! (dk-project! am-algo-body 'is-algebraic-over '(IS-ALGEBRAIC-OVER aa r))))
       (c (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'anac_))) (dk-asms))))
       (v (dk-skolem! (dk-apply! (dk-cite! 'invariant-space-of-relation) 'aa 'r n c))))
  (dk-apply! (dk-cite! 'dim-le-fg-module) 'aa v n)
  (ew v)
  (dk-conj-close! dk-ass!))
(qed 'invariant-module-of-algebraic)

;;; PROP. 4.18: r is algebraic over A iff r V is contained in V for a non-trivial finitely generated A-module V in C
(define am-mod-ex (list 'FORSOME 'vv (list 'AND '(IS-FG-CC-MODULE-OVER aa vv) (list 'AND am-nontriv am-inv))))
(sp (make-wff (forall-guarded '(aa r) '((IS-SUBRING-OF-CC aa) (IN r CC))
  (list 'IFF '(IS-ALGEBRAIC-OVER aa r) am-mod-ex))))
(dk-peel!)
(dk-iff! (lambda (g) (dk-head-is? g 'FORSOME))
  (lambda () (dk-apply! (dk-cite! 'invariant-module-of-algebraic) 'aa 'r) (ass))
  (lambda ()
    (let ((vv (dk-skolem! (dk-ctx-form am-mod-ex))))
      (dk-apply! (dk-cite! 'algebraic-of-invariant-module) 'aa 'r vv)
      (ass))))
(qed 'algebraic-iff-invariant-module)


;;; (17) the A-span of a finite family of complex numbers: a finitely generated A-module, and r-invariant as soon
;;; as r maps every generator into it
(define (am-span-closures! n gp vs)
  ;; lands: (SUBSET vs CC), 0 in vs, the +, -, scalar closures of vs (IS-CC-MODULE-OVER's forms), gp in FUN(INT, vs)
  (let* ((int (am-int n))
         (lcin! (lambda (v b)
                  (dk-have! (list 'IN v vs)
                    (lambda () (in-sep! dk-ass! (lambda () (ew b) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))))
         (vopen! (lambda (v)
                   (let ((b (dk-skolem! (ma-sep-parts! (list 'IN v vs)))))
                     (fact 'fun-codomain-superset b int 'aa 'CC)
                     b))))
    (ma-sep-subset! vs)
    (fact 'interval-in-set 1 n)
    (let ((b0 (list 'VNB-LAMBDA 'amj_ int 0)))
      (dk-have! (list 'IN b0 (list 'FUN int 'aa)) (lambda () (dk-lam-type! (lambda () (dk-di-var!) (ass)) (lambda () (ass)))))
      (dk-apply! (dk-cite! 'cc-lincomb-zero-coefficients) n gp)
      (dk-have! (list '= 0 (am-lc n b0 gp)) (lambda () (subst (list '= (am-lc n b0 gp) 0)) (rfl)))
      (lcin! 0 b0))
    (dk-have! (list 'FORALL 'amx_ (list 'IMPLIES (list 'IN 'amx_ vs) (list 'FORALL 'amy_ (list 'IMPLIES (list 'IN 'amy_ vs) (list 'IN '(+ amx_ amy_) vs)))))
      (lambda ()
        (let* ((ls (dk-peel!)) (xy (ma-map cadr ls)) (x (car xy)) (y (cadr xy))
               (b1 (vopen! x)) (b2 (vopen! y))
               (b3 (list 'VNB-LAMBDA 'amj_ int (list '+ (list b1 'amj_) (list b2 'amj_)))))
          (fact 'subset-mem-fwd vs 'CC x) (fact 'subset-mem-fwd vs 'CC y)
          (cp-type! (list '+ x y))
          (dk-have! (list 'IN b3 (list 'FUN int 'aa))
            (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (fact 'fun-apply-type-c b1 int 'aa j) (fact 'fun-apply-type-c b2 int 'aa j) (cp-add-in! 'aa (list b1 j) (list b2 j)) (ass))) (lambda () (ass)))))
          (dk-apply! (dk-cite! 'cc-lincomb-add) n b1 b2 gp)
          (dk-have! (list '= (list '+ x y) (am-lc n b3 gp))
            (lambda () (subst (list '= x (am-lc n b1 gp))) (subst (list '= y (am-lc n b2 gp))) (ass)))
          (lcin! (list '+ x y) b3))))
    (let ((scale-in!
            (lambda (a x)
              (let* ((b (vopen! x)) (b3 (list 'VNB-LAMBDA 'amj_ int (list '* a (list b 'amj_)))))
                (fact 'subset-mem-fwd vs 'CC x)
                (cp-type! (list '* a x))
                (dk-have! (list 'IN b3 (list 'FUN int 'aa))
                  (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (fact 'fun-apply-type-c b int 'aa j) (cp-mul-in! 'aa a (list b j)) (ass))) (lambda () (ass)))))
                (dk-apply! (dk-cite! 'cc-lincomb-scale) n a b gp)
                (dk-have! (list '= (list '* a x) (am-lc n b3 gp))
                  (lambda () (subst (list '= x (am-lc n b gp))) (ass)))
                (lcin! (list '* a x) b3)))))
      (dk-have! (list 'FORALL 'ama_ (list 'IMPLIES '(IN ama_ aa) (list 'FORALL 'amx_ (list 'IMPLIES (list 'IN 'amx_ vs) (list 'IN '(* ama_ amx_) vs)))))
        (lambda ()
          (let* ((ls (dk-peel!)) (ax (ma-map cadr ls)) (a (car ax)) (x (cadr ax)))
            (fact 'subset-mem-fwd 'aa 'CC a)
            (scale-in! a x))))
      (dk-have! (list 'FORALL 'amx_ (list 'IMPLIES (list 'IN 'amx_ vs) (list 'IN '(- amx_) vs)))
        (lambda ()
          (let ((x (dk-di-var!)))
            (scale-in! '(- 1) x)
            (dk-have! (list '= (list '- x) (list '* '(- 1) x)) (lambda () (crs)))
            (subst (list '= (list '- x) (list '* '(- 1) x)))
            (ass)))))
    (let ((gin! (lambda (i)
                  (let ((u (am-unit i n)))
                    (fact 'fun-apply-type-c gp int 'CC i)
                    (dk-have! (list 'IN u (list 'FUN int 'aa))
                      (lambda () (dk-lam-type! (lambda () (let ((j (dk-di-var!))) (dk-case-if! (list 'IF (list '= j i) 1 0) (lambda (t? v) (ass))))) (lambda () (ass)))))
                    (dk-apply! (dk-cite! 'cc-lincomb-unit) n gp i)
                    (dk-have! (list '= (list gp i) (am-lc n u gp)) (lambda () (subst (list '= (am-lc n u gp) (list gp i))) (rfl)))
                    (lcin! (list gp i) u)))))
      (dk-have! (list 'IN gp (list 'FUN int vs))
        (lambda ()
          (mac 'fun-codomain-iff)
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'FORALL)
                  (let ((kv (dk-di-var!))) (gin! kv) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (ass)))
                  (begin
                    (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN gp (list 'FUN int 'CC))))))
                    (ass))))))))))
(define am-span-module-body
  (lambda (n u vs)
    (list 'AND (list 'IS-FG-CC-MODULE-OVER 'aa vs) (list 'IN u (list 'FUN (am-int n) vs)))))

(sp (make-wff (forall-guarded '(aa nb u) '((IS-SUBRING-OF-CC aa) (IN nb NN) (IN u (FUN (INTERVAL 1 nb) CC)))
  (am-span-module-body 'nb 'u (am-vspan 'nb 'u)))))
(dk-peel!)
(cp-ring!)
(am-carr-ag!)
(cp-sub-parts! 'aa)
(fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-one-in) (fact 'cc-neg-closed 1)
(cp-neg-in! 'aa 1)
(let ((vs (am-vspan 'nb 'u)))
  (am-span-closures! 'nb 'u vs)
  (dk-have! (list 'IS-FG-CC-MODULE-OVER 'aa vs)
    (lambda ()
      (mac 'is-fg-cc-module-over)
      (dk-conj-close!
        (lambda ()
          (cond
            ((dk-ass!) #t)
            ((dk-head-is? (dk-goal) 'IS-CC-MODULE-OVER) (mac 'is-cc-module-over) (dk-conj-close! dk-ass!))
            (#t
             (ew 'nb)
             (dk-conj-close!
               (lambda ()
                 (cond
                   ((dk-ass!) #t)
                   (#t
                    (ew 'u)
                    (dk-conj-close!
                      (lambda ()
                        (if (not (dk-ass!))
                            (let ((v (dk-di-var!)))
                              (ma-sep-parts! (list 'IN v vs))
                              (ass)))))))))))))))
  (dk-conj-close! dk-ass!))
(qed 'cc-span-module)

;;; a span is rho-invariant when rho maps every generator into it
(sp (make-wff (forall-guarded '(aa nb u rho) (list '(IS-SUBRING-OF-CC aa) '(IN nb NN) '(IN u (FUN (INTERVAL 1 nb) CC)) '(IN rho CC)
                                                (list 'FORALL 'amt_ (list 'IMPLIES '(IN amt_ (INTERVAL 1 nb)) (list 'IN '(* rho (u amt_)) (am-vspan 'nb 'u)))))
  (list 'FORALL 'amrv_ (list 'IMPLIES (list 'IN 'amrv_ (am-vspan 'nb 'u)) (list 'IN '(* rho amrv_) (am-vspan 'nb 'u)))))))
(dk-peel!)
(cp-ring!)
(am-carr-ag!)
(cp-sub-parts! 'aa)
(fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-one-in) (fact 'cc-neg-closed 1)
(cp-neg-in! 'aa 1)
(let* ((vs (am-vspan 'nb 'u)) (int (am-int 'nb)) (n 'nb) (gp 'u)
       (rg (list 'FORALL 'amt_ (list 'IMPLIES '(IN amt_ (INTERVAL 1 nb)) (list 'IN '(* rho (u amt_)) vs)))))
  (am-span-closures! 'nb 'u vs)
  (let* ((v 'amrv_) (b (dk-skolem! (ma-sep-parts! (list 'IN v vs)))) (sm (am-lsum n b gp))
         (rs (list 'VNB-LAMBDA 'z int (list (list 'MUL cp-r) 'rho (list sm 'z)))))
    (fact 'fun-codomain-superset b int 'aa 'CC)
    (fact 'cc-scalar-ring-carr)
    (dk-cite! 'ring-additive-ag-is-abelian-group cp-r)
    (dk-apply! (dk-cite! 'interval-card-in-nn 1 n))
    (am-sum-fun! sm int (lambda (z) (fact 'fun-apply-type-c b int 'CC z) (fact 'fun-apply-type-c gp int 'CC z)))
    (dk-have! (list 'IN sm (list 'FUN int (list 'CARR cp-r))) (lambda () (subst (list '= (list 'CARR cp-r) 'CC)) (subst (list '= 'CC (list 'CARR cp-ag))) (ass)))
    (dk-have! (list 'IN 'rho (list 'CARR cp-r)) (lambda () (subst (list '= (list 'CARR cp-r) 'CC)) (ass)))
    (dk-apply! (dk-cite! 'finsum-type cp-ag) int sm)
    (dk-have! (list 'IN (cp-fs sm int) 'CC) (lambda () (subst (list '= 'CC (list 'CARR cp-ag))) (ass)))
    (dk-cite! 'cc-lincomb-unfold n b gp)
    (subst (list '= v (am-lc n b gp)))
    (subst (list '= (am-lc n b gp) (cp-fs sm int)))
    (am-op-eq! 'MUL 'rho (cp-fs sm int))
    (subst (list '= (list '* 'rho (cp-fs sm int)) (list (list 'MUL cp-r) 'rho (cp-fs sm int))))
    (subst (dk-apply! (dk-cite! 'finsum-ring-distrib-left-gen cp-r) 'rho int sm))
    (dk-have! (list 'IN (list 'IDEN cp-ag) vs) (lambda () (subst (dk-cite! 'ras-id cp-r)) (subst (dk-cite! 'cc-scalar-ring-zero)) (ass)))
    (dk-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ vs) (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ vs) (list 'IN (list (list 'OPR cp-ag) 'x_ 'y_) vs)))))
      (lambda ()
        (let* ((ls (dk-peel!)) (xy (ma-map cadr ls)) (x (car xy)) (y (cadr xy)))
          (fact 'subset-mem-fwd vs 'CC x) (fact 'subset-mem-fwd vs 'CC y)
          (subst (dk-cite! 'ras-op cp-r))
          (subst (am-op-eq! 'ADD x y))
          (dk-apply! (dk-ctx-form (list 'FORALL 'amx_ (list 'IMPLIES (list 'IN 'amx_ vs) (list 'FORALL 'amy_ (list 'IMPLIES (list 'IN 'amy_ vs) (list 'IN '(+ amx_ amy_) vs)))))) x y)
          (ass))))
    (dk-have! (list 'IN rs (list 'FUN int (list 'CARR cp-ag)))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let* ((z (dk-di-var!)) (t (list '* (list b z) (list gp z))))
              (fact 'fun-apply-type-c b int 'CC z) (fact 'fun-apply-type-c gp int 'CC z)
              (cp-type! t)
              (dk-lam-b!)
              (subst (am-op-eq! 'MUL 'rho t))
              (subst (list '= (list 'CARR cp-ag) 'CC))
              (cp-type! (list '* 'rho t))
              (ass)))
          (lambda () (ass)))))
    (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z int) (list 'IN (list rs 'z) vs)))
      (lambda ()
        (let* ((z (dk-di-var!)) (t (list '* (list b z) (list gp z))))
          (fact 'fun-apply-type-c b int 'aa z) (fact 'fun-apply-type-c b int 'CC z) (fact 'fun-apply-type-c gp int 'CC z)
          (cp-type! t)
          (dk-lam-b!)
          (subst (am-op-eq! 'MUL 'rho t))
          (dk-apply! (dk-ctx-form rg) z)
          (dk-apply! (dk-ctx-form (list 'FORALL 'ama_ (list 'IMPLIES '(IN ama_ aa) (list 'FORALL 'amx_ (list 'IMPLIES (list 'IN 'amx_ vs) (list 'IN '(* ama_ amx_) vs)))))) (list b z) (list '* 'rho (list gp z)))
          (dk-have! (list '= (list '* 'rho t) (list '* (list b z) (list '* 'rho (list gp z)))) (lambda () (crs)))
          (subst (list '= (list '* 'rho t) (list '* (list b z) (list '* 'rho (list gp z)))))
          (ass))))
    (dk-apply! (dk-cite! 'finsum-in-subset cp-ag) vs int rs)
    (ass)))
(qed 'cc-span-invariant)


;;; (18) a generator list for the products: for k <= n there are N and u_1..u_N, each u_t a product g_i h_j
;;; (i <= k), with every g_i h_j (i <= k) an A-combination of the u's
(define (ap-a nn uu k)
  (list 'FORALL 'apt_ (list 'IMPLIES (list 'IN 'apt_ (am-int nn))
    (list 'FORSOME 'api_ (list 'AND (list 'IN 'api_ (am-int k))
      (list 'FORSOME 'apj_ (list 'AND '(IN apj_ (INTERVAL 1 m)) (list '= (list uu 'apt_) '(* (g api_) (h apj_))))))))))
(define (ap-b nn uu k)
  (list 'FORALL 'api_ (list 'IMPLIES (list 'IN 'api_ (am-int k))
    (list 'FORALL 'apj_ (list 'IMPLIES '(IN apj_ (INTERVAL 1 m))
      (list 'FORSOME 'apb_ (list 'AND (list 'IN 'apb_ (list 'FUN (am-int nn) 'aa)) (list '= '(* (g api_) (h apj_)) (am-lc nn 'apb_ uu)))))))))
(define (ap-body k)
  (list 'FORSOME 'apn_ (list 'AND '(IN apn_ NN)
    (list 'FORSOME 'apu_ (list 'AND '(IN apu_ (FUN (INTERVAL 1 apn_) CC)) (list 'AND (ap-a 'apn_ 'apu_ k) (ap-b 'apn_ 'apu_ k)))))))
(define (ap-conj-close! closer)
  (let walk ()
    (let ((g (dk-goal)))
      (if (and (pair? g) (eq? (car g) 'AND))
          (let ((kids (dk-opened (lambda () (di)))))
            (for-each (lambda (k)
                        (if (not (sequent-node-grounded? k))
                            (begin (dk-focus! k) (walk))))
                      kids))
          (closer)))))
(define (ap-sum-fun! f int typ!)
  ;; am-sum-fun! without the beta pass: the factors are typed as applications
  (dk-have! (list 'IN f (list 'FUN int (list 'CARR cp-ag)))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let* ((z (dk-di-var!)) (leaf (proof-state-focus *ps*)))
            (typ! z)
            (subst (list '= (list 'CARR cp-ag) 'CC))
            (if (not (sequent-node-grounded? leaf)) (dk-type! (cadr (dk-goal)) 'CC))))
        (lambda () (ass))))))
(define (ap-absurd!) (dk-cite! 'rr-lt-irrefl 0) (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0)))))
(define (ap-mem! a b t)
  ;; t in NN, a <= t, t <= b (in context): land (IN t (INTERVAL a b))
  (dk-apply! (dk-cite! 'interval-mem-intro a b t)))

(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
  (forall-guarded '(aa n m g h) '((IS-SUBRING-OF-CC aa) (IN n NN) (IN m NN) (IN g (FUN (INTERVAL 1 n) CC)) (IN h (FUN (INTERVAL 1 m) CC)) (<= k n))
    (ap-body 'k))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  ;; k = 0: the empty list
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (fact 'cc-zero-in) (fact 'nn-zero-in) (fact 'interval-in-set 1 0)
  (let ((u0 '(VNB-LAMBDA apt_ (INTERVAL 1 0) 0)))
    (dk-have! (list 'IN u0 '(FUN (INTERVAL 1 0) CC)) (lambda () (dk-lam-type! (lambda () (dk-di-var!) (ass)) (lambda () (ass)))))
    (ew 0)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (ew u0)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (let* ((ls (dk-peel!)) (t (cadr (car ls))))
                        (cp-int-parts! 1 0 t)
                        (dk-have! '(< 0 0) (lambda () (dk-nn! (list '<= 1 t) (list '<= t 0))))
                        (ap-absurd!))))))))))
  ;; k + 1: append the products g_(k+1) h_j
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (cp-ring!) (am-carr-ag!)
  (cp-sub-parts! 'aa)
  (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-one-in) (fact 'nn-zero-in)
  (let* ((sk (list 'succ v)))
    (fact 'nn-succ-closed v)
    (dk-have! (list '<= v 'n) (lambda () (dk-nn! (list '<= sk 'n))))
    (let* ((ex (dk-apply! (dk-ctx-form ih) 'aa 'n 'm 'g 'h))
           (nn (dk-skolem! ex))
           (uu (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'apu_))) (dk-asms))))
           (n2 (list '+ nn 'm))
           (u2 (list 'VNB-LAMBDA 'apw_ (am-int n2) (list 'IF (list '<= 'apw_ nn) (list uu 'apw_) (list '* (list 'g sk) (list 'h (list 'NN-MINUS 'apw_ nn))))))
           (int2 (am-int n2)))
      (dk-type! n2 'NN)
      (dk-have! (list '<= 1 sk) (lambda () (dk-nn!)))
      (ap-mem! 1 'n sk)
      (fact 'fun-apply-type-c 'g '(INTERVAL 1 n) 'CC sk)
      (fact 'interval-in-set 1 n2) (fact 'interval-in-set 1 nn)
      (let* ((near! (lambda (t)
                      ;; t in INT(1, n2), t <= nn: t in INT(1, nn)
                      (cp-int-parts! 1 n2 t)
                      (ap-mem! 1 nn t)))
             (far! (lambda (t)
                     ;; t in INT(1, n2), not t <= nn: j = NN-MINUS(t, nn) in INT(1, m), t = nn + j; returns j
                     (cp-int-parts! 1 n2 t)
                     (fact 'nn-in-rr t) (fact 'nn-in-rr nn)
                     (dk-have! (list '<= (list 'succ nn) t)
                       (lambda ()
                         (ma-or-split! (dk-apply! (dk-cite! 'rr-lt-trichotomy t nn))
                           (list (lambda () (dk-have! (list '<= t nn) (lambda () (dk-ineq! (list '< t nn)))) (ma-prop-with! (list (list '<= t nn) (list 'NOT (list '<= t nn)))))
                                 (lambda () (dk-have! (list '<= t nn) (lambda () (dk-ineq! (list '= t nn)))) (ma-prop-with! (list (list '<= t nn) (list 'NOT (list '<= t nn)))))
                                 (lambda () (dk-apply! (dk-cite! 'nn-lt-succ-le nn t)) (ass))))))
                     (let ((j (list 'NN-MINUS t nn)))
                       (fact 'nn-minus-in-nn t nn)
                       (dk-have! (list '<= nn t) (lambda () (dk-nn! (list '<= (list 'succ nn) t))))
                       (let ((e (dk-apply! (dk-cite! 'nn-minus-def) t nn)))
                         (dk-have! (list '= j (list '- t nn))
                           (lambda () (subst e) (dk-if-branch! #t (list 'IF (list '<= nn t) (list '- t nn) 0) #f (lambda () (dk-type! (list '- t nn)) (rfl))))))
                       (fact 'nn-in-rr j)
                       (dk-have! (list '<= 1 j) (lambda () (dk-nn! (list '= j (list '- t nn)) (list '<= (list 'succ nn) t))))
                       (dk-have! (list '<= j 'm) (lambda () (dk-nn! (list '= j (list '- t nn)) (list '<= t n2))))
                       (ap-mem! 1 'm j)
                       (fact 'fun-apply-type-c 'h '(INTERVAL 1 m) 'CC j)
                       j)))
             (val! (lambda (t)
                     ;; the value of u2 at t, an equation, by cases; returns (near? . equation)
                     (let ((ift (list 'IF (list '<= t nn) (list uu t) (list '* (list 'g sk) (list 'h (list 'NN-MINUS t nn))))))
                       (if (dk-asm? (list '<= t nn))
                           (begin
                             (near! t)
                             (fact 'fun-apply-type-c uu (am-int nn) 'CC t)
                             (dk-have! (list '= (list u2 t) (list uu t))
                               (lambda () (dk-lam-b!) (dk-if-branch! #t ift #f (lambda () (rfl)))))
                             (cons #t (list '= (list u2 t) (list uu t))))
                           (let* ((j (far! t)) (pr (list '* (list 'g sk) (list 'h j))))
                             (cp-type! pr)
                             (dk-have! (list '= (list u2 t) pr)
                               (lambda () (dk-lam-b!) (dk-if-branch! #f ift #f (lambda () (rfl)))))
                             (cons #f (list '= (list u2 t) pr))))))))
        ;; typing
        (dk-have! (list 'IN u2 (list 'FUN int2 'CC))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((t (dk-di-var!)))
                  (dk-case-if! (list 'IF (list '<= t nn) (list uu t) (list '* (list 'g sk) (list 'h (list 'NN-MINUS t nn))))
                    (lambda (t? val)
                      (if t?
                          (begin (near! t) (fact 'fun-apply-type-c uu (am-int nn) 'CC t))
                          (let ((j (far! t))) (cp-type! (list '* (list 'g sk) (list 'h j)))))
                      (dk-ass!)))))
              (lambda () (dk-ass!)))))
        (ew n2)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (begin
                  (ew u2)
                  (ap-conj-close!
                    (lambda ()
                      (cond
                        ((dk-ass!) #t)
                        ((begin (and (dk-head-is? (dk-goal) 'FORALL) (eq? (cadr (dk-goal)) 'apt_)))
                         ;; every u2(t) is a product
                         (let ((t (dk-di-var!)))
                           (use-em (list '<= t nn)
                             (lambda ()
                               (let* ((e (cdr (val! t)))
                                      (pi (dk-apply! (dk-ctx-form (ap-a nn uu v)) t))
                                      (i (dk-skolem! pi))
                                      (j (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'apj_) (dk-contains? f i))) (dk-asms)))))
                                 (cp-int-parts! 1 v i)
                                 (dk-have! (list '<= i sk) (lambda () (dk-nn! (list '<= i v))))
                                 (ap-mem! 1 sk i)
                                 (ew i)
                                 (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew j) (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (subst e) (ass)))))))))))
                             (lambda ()
                               (let* ((j (far! t)) (e (cdr (val! t))))
                                 (dk-have! (list '<= sk sk) (lambda () (dk-nn!)))
                                 (ap-mem! 1 sk sk)
                                 (ew sk)
                                 (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew j) (dk-conj-close! (lambda () (if (not (dk-ass!)) (ass)))))))))))))
                        (#t
                         ;; every product g_i h_j is a combination of the u2's
                         (let* ((ls (dk-peel!)) (ij (ma-map cadr (filter (lambda (f) (dk-head-is? f 'IN)) ls))) (i (car ij)) (j (cadr ij)))
                           (cp-int-parts! 1 sk i) (cp-int-parts! 1 'm j)
                           (fact 'fun-apply-type-c 'g '(INTERVAL 1 n) 'CC i) (fact 'fun-apply-type-c 'h '(INTERVAL 1 m) 'CC j)
                           (dk-have! (list '<= i 'n) (lambda () (dk-nn! (list '<= i sk) (list '<= sk 'n))))
                           (ap-mem! 1 'n i)
                           (fact 'fun-apply-type-c 'g '(INTERVAL 1 n) 'CC i)
                           (use-em (list '<= i v)
                             (lambda ()
                               ;; an old product: pad the coefficients with zeros
                               (ap-mem! 1 v i)
                               (let* ((b (dk-skolem! (dk-apply! (dk-ctx-form (ap-b nn uu v)) i j)))
                                      (b2 (list 'VNB-LAMBDA 'apw_ int2 (list 'IF (list '<= 'apw_ nn) (list b 'apw_) 0)))
                                      (s1 (am-lsum nn b uu)) (s2 (am-lsum n2 b2 u2)))
                                 (fact 'fun-codomain-superset b (am-int nn) 'aa 'CC)
                                 (fact 'fun-codomain-superset uu (am-int nn) 'CC 'CC)
                                 (dk-have! (list 'IN b2 (list 'FUN int2 'aa))
                                   (lambda ()
                                     (dk-lam-type!
                                       (lambda ()
                                         (let ((t (dk-di-var!)))
                                           (dk-case-if! (list 'IF (list '<= t nn) (list b t) 0)
                                             (lambda (t? val) (if t? (begin (near! t) (fact 'fun-apply-type-c b (am-int nn) 'aa t))) (ass)))))
                                       (lambda () (ass)))))
                                 (fact 'fun-codomain-superset b2 int2 'aa 'CC)
                                 (dk-cite! 'ring-additive-ag-is-abelian-group cp-r)
                                 (dk-apply! (dk-cite! 'interval-card-in-nn 1 nn))
                                 (dk-apply! (dk-cite! 'interval-card-in-nn 1 n2))
                                 (ap-sum-fun! s2 int2 (lambda (z) (fact 'fun-apply-type-c b2 int2 'CC z) (fact 'fun-apply-type-c u2 int2 'CC z)))
                                 (dk-have! (list 'SUBSET (am-int nn) int2)
                                   (lambda () (mac 'subset-def) (let ((z (dk-di-var!))) (cp-int-parts! 1 nn z) (dk-have! (list '<= z n2) (lambda () (dk-nn! (list '<= z nn)))) (ap-mem! 1 n2 z) (ass))))
                                 (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'AND (list 'IN 'z int2) (list 'NOT (list 'IN 'z (am-int nn)))) (list '= (list s2 'z) (list 'IDEN cp-ag))))
                                   (lambda ()
                                     (let* ((z (dk-di-var! (lambda (g) (cadr (cadr (cadr g)))))))
                                       (di)
                                       (dk-split-all!)
                                       (cp-int-parts! 1 n2 z)
                                       (dk-have! (list 'NOT (list '<= z nn))
                                         (lambda () (di) (dk-have! (list 'IN z (am-int nn)) (lambda () (ap-mem! 1 nn z) (ass))) (ma-prop-with! (list (list 'IN z (am-int nn)) (list 'NOT (list 'IN z (am-int nn)))))))
                                       (fact 'fun-apply-type-c u2 int2 'CC z)
                                       (dk-lam-b!)
                                       (subst (dk-cite! 'ras-id cp-r)) (subst (dk-cite! 'cc-scalar-ring-zero))
                                       (let ((jz (far! z)))
                                         (dk-if-branch! #f (list 'IF (list '<= z nn) (list b z) 0) #f
                                           (lambda ()
                                             (dk-if-branch! #f (list 'IF (list '<= z nn) (list uu z) (list '* (list 'g sk) (list 'h (list 'NN-MINUS z nn)))) #f
                                               (lambda () (crs)))))))))
                                 (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z (am-int nn)) (list '= (list s2 'z) (list s1 'z))))
                                   (lambda ()
                                     (let ((z (dk-di-var!)))
                                       (cp-int-parts! 1 nn z)
                                       (dk-have! (list '<= z n2) (lambda () (dk-nn! (list '<= z nn))))
                                       (ap-mem! 1 n2 z)
                                       (fact 'fun-apply-type-c b (am-int nn) 'CC z) (fact 'fun-apply-type-c uu (am-int nn) 'CC z)
                                       (let ((e (cdr (val! z))))
                                         (dk-lam-b!)
                                         (dk-if-branch! #t (list 'IF (list '<= z nn) (list b z) 0) #f
                                           (lambda ()
                                             (dk-if-branch! #t (list 'IF (list '<= z nn) (list uu z) (list '* (list 'g sk) (list 'h (list 'NN-MINUS z nn)))) #f
                                               (lambda ()
                                                 (cp-type! (list '* (list b z) (list uu z)))
                                                 (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))))))))
                                 (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z (am-int nn)) (list 'IN (list s2 'z) (list 'CARR cp-ag))))
                                   (lambda ()
                                     (let ((z (dk-di-var!)))
                                       (cp-int-parts! 1 nn z)
                                       (dk-have! (list '<= z n2) (lambda () (dk-nn! (list '<= z nn))))
                                       (ap-mem! 1 n2 z)
                                       (fact 'fun-apply-type-c s2 int2 (list 'CARR cp-ag) z)
                                       (ass))))
                                 (ew b2)
                                 (dk-conj-close!
                                   (lambda ()
                                     (if (not (dk-ass!))
                                         (begin
                                           (dk-cite! 'cc-lincomb-unfold nn b uu)
                                           (subst (dk-cite! 'cc-lincomb-unfold n2 b2 u2))
                                           (subst (dk-apply! (dk-cite! 'finsum-embed cp-ag) (am-int nn) int2 s2))
                                           (subst (dk-apply! (dk-cite! 'finsum-congruence cp-ag) (am-int nn) s2 s1))
                                           (subst (list '= (cp-fs s1 (am-int nn)) (am-lc nn b uu)))
                                           (ass)))))))
                             (lambda ()
                               ;; the new products: a unit combination
                               (fact 'nn-in-rr i) (fact 'nn-in-rr sk)
                               (dk-have! (list '= i sk)
                                 (lambda ()
                                   (ma-or-split! (dk-apply! (dk-cite! 'rr-lt-trichotomy i sk))
                                     (list (lambda ()
                                             (dk-apply! (dk-cite! 'nn-lt-succ-le i sk))
                                             (dk-have! (list '<= i v) (lambda () (dk-nn! (list '<= (list 'succ i) sk))))
                                             (ma-prop-with! (list (list '<= i v) (list 'NOT (list '<= i v)))))
                                           (lambda () (ass))
                                           (lambda () (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '< sk i) (list '<= i sk)))) (ap-absurd!))))))
                               (let* ((t0 (list '+ nn j)))
                                 (dk-type! t0 'NN)
                                 (fact 'nn-in-rr j) (fact 'nn-in-rr nn)
                                 (dk-have! (list '<= 1 t0) (lambda () (dk-nn! (list '<= 1 j))))
                                 (dk-have! (list '<= t0 n2) (lambda () (dk-nn! (list '<= j 'm))))
                                 (ap-mem! 1 n2 t0)
                                 (dk-have! (list 'NOT (list '<= t0 nn)) (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-nn! (list '<= t0 nn) (list '<= 1 j)))) (ap-absurd!)))
                                 (let* ((vv (val! t0)) (e (cdr vv)) (j2 (list 'NN-MINUS t0 nn)))
                                   (dk-have! (list '= j2 j) (lambda () (dk-ineq! (list '= j2 (list '- t0 nn)))))
                                   (let* ((e2 (dk-rewrite-h! e j2 j))
                                          (un (am-unit t0 n2)))
                                     (dk-have! (list 'IN un (list 'FUN int2 'aa))
                                       (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (dk-case-if! (list 'IF (list '= z t0) 1 0) (lambda (t? val) (ass))))) (lambda () (ass)))))
                                     (dk-apply! (dk-cite! 'cc-lincomb-unit) n2 u2 t0)
                                     (ew un)
                                     (dk-conj-close!
                                       (lambda ()
                                         (if (not (dk-ass!))
                                             (begin
                                               (subst (list '= (am-lc n2 un u2) (list u2 t0)))
                                               (subst e2)
                                               (subst (list '= i sk))
                                               (cp-type! (list '* (list 'g sk) (list 'h j)))
                                               (rfl)))))))))))))))))))))))
(qed 'product-generators-exist)

;;; (19) PROP. 4.19, the module lemmas: a combination with coefficients in A of members of an A-module is in it;
;;; the preimage of a module under multiplication by c is a module; a non-trivial finitely generated module has a
;;; non-zero generator; r g_i h_j lies in any module holding every g_l h_j when the g's span an r-invariant module
(define (am8-mod-forms aa vs)
  (list (list 'SUBSET vs 'CC)
        (list 'IN 0 vs)
        (list 'FORALL 'amx_ (list 'IMPLIES (list 'IN 'amx_ vs) (list 'FORALL 'amy_ (list 'IMPLIES (list 'IN 'amy_ vs) (list 'IN '(+ amx_ amy_) vs)))))
        (list 'FORALL 'amx_ (list 'IMPLIES (list 'IN 'amx_ vs) (list 'IN '(- amx_) vs)))
        (list 'FORALL 'ama_ (list 'IMPLIES (list 'IN 'ama_ aa) (list 'FORALL 'amx_ (list 'IMPLIES (list 'IN 'amx_ vs) (list 'IN '(* ama_ amx_) vs)))))))
(define (am8-mod-parts! aa vs)
  (ma-for-each (lambda (p) (if (not (dk-asm? p)) (dk-project! p 'is-cc-module-over (list 'IS-CC-MODULE-OVER aa vs))))
    (am8-mod-forms aa vs)))
(define (am8-add-in! vs x y) (dk-apply! (dk-ctx-form (caddr (am8-mod-forms 'aa vs))) x y))
(define (am8-neg-in! vs x) (dk-apply! (dk-ctx-form (cadddr (am8-mod-forms 'aa vs))) x))
(define (am8-scale-in! aa vs a x) (dk-apply! (dk-ctx-form (list-ref (am8-mod-forms aa vs) 4)) a x))

;;; a combination with coefficients in A of members of an A-module lies in the module
(sp (make-wff (forall-guarded '(aa vv n b w) '((IS-CC-MODULE-OVER aa vv) (SUBSET aa CC) (IN n NN) (IN b (FUN (INTERVAL 1 n) aa)) (IN w (FUN (INTERVAL 1 n) vv)))
  '(IN (CC-LINCOMB n b w) vv))))
(dk-peel!)
(am-fs-setup! 'n)
(fact 'cc-zero-in)
(am8-mod-parts! 'aa 'vv)
(let* ((int (am-int 'n)) (f (am-lsum 'n 'b 'w)))
  (fact 'fun-codomain-superset 'b int 'aa 'CC)
  (fact 'fun-codomain-superset 'w int 'vv 'CC)
  (subst (dk-cite! 'cc-lincomb-unfold 'n 'b 'w))
  (dk-have! (list 'IN (list 'IDEN cp-ag) 'vv)
    (lambda () (subst (dk-cite! 'ras-id cp-r)) (subst (dk-cite! 'cc-scalar-ring-zero)) (ass)))
  (dk-have! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ vv) (list 'FORALL 'y_ (list 'IMPLIES '(IN y_ vv) (list 'IN (list (list 'OPR cp-ag) 'x_ 'y_) 'vv)))))
    (lambda ()
      (let* ((ls (dk-peel!)) (xy (ma-map cadr ls)) (x (car xy)) (y (cadr xy)))
        (fact 'subset-mem-fwd 'vv 'CC x) (fact 'subset-mem-fwd 'vv 'CC y)
        (subst (dk-cite! 'ras-op cp-r))
        (subst (am-op-eq! 'ADD x y))
        (am8-add-in! 'vv x y)
        (ass))))
  (am-sum-fun! f int (lambda (z) (fact 'fun-apply-type-c 'b int 'CC z) (fact 'fun-apply-type-c 'w int 'CC z)))
  (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z int) (list 'IN (list f 'z) 'vv)))
    (lambda ()
      (let ((z (dk-di-var!)))
        (fact 'fun-apply-type-c 'b int 'aa z) (fact 'fun-apply-type-c 'w int 'vv z)
        (fact 'fun-apply-type-c 'b int 'CC z) (fact 'fun-apply-type-c 'w int 'CC z)
        (dk-lam-b!)
        (am8-scale-in! 'aa 'vv (list 'b z) (list 'w z))
        (ass))))
  (dk-apply! (dk-cite! 'finsum-in-subset cp-ag) 'vv int f)
  (ass))
(qed 'lincomb-in-module)

;;; the preimage of an A-module under multiplication by c is an A-module
(sp (make-wff (forall-guarded '(aa vv c) '((IS-CC-MODULE-OVER aa vv) (SUBSET aa CC) (IN c CC))
  '(IS-CC-MODULE-OVER aa (SEP amq_ CC (IN (* amq_ c) vv))))))
(dk-peel!)
(fact 'cc-zero-in)
(am8-mod-parts! 'aa 'vv)
(let* ((s '(SEP amq_ CC (IN (* amq_ c) vv)))
       (fs (am8-mod-forms 'aa s))
       (open! (lambda (x) (ma-sep-parts! (list 'IN x s))))
       (close! (lambda (t e)
                 ;; t in CC in context; e: (= (* t c) RHS) with RHS in vv in context
                 (dk-have! (list 'IN t s)
                   (lambda ()
                     (in-sep! dk-ass!
                       (lambda ()
                         (dk-have! e (lambda () (crs)))
                         (subst e)
                         (ass))))))))
  (ma-sep-subset! s)
  (dk-have! '(= (* 0 c) 0) (lambda () (crs)))
  (close! 0 '(= (* 0 c) 0))
  (dk-have! (caddr fs)
    (lambda ()
      (let* ((ls (dk-peel!)) (xy (ma-map cadr ls)) (x (car xy)) (y (cadr xy)))
        (open! x) (open! y)
        (cp-type! (list '* x 'c)) (cp-type! (list '* y 'c)) (cp-type! (list '+ x y))
        (am8-add-in! 'vv (list '* x 'c) (list '* y 'c))
        (close! (list '+ x y) (list '= (list '* (list '+ x y) 'c) (list '+ (list '* x 'c) (list '* y 'c)))))))
  (dk-have! (cadddr fs)
    (lambda ()
      (let ((x (dk-di-var!)))
        (open! x)
        (cp-type! (list '* x 'c)) (cp-type! (list '- x))
        (am8-neg-in! 'vv (list '* x 'c))
        (close! (list '- x) (list '= (list '* (list '- x) 'c) (list '- (list '* x 'c)))))))
  (dk-have! (list-ref fs 4)
    (lambda ()
      (let* ((ls (dk-peel!)) (ax (ma-map cadr ls)) (a (car ax)) (x (cadr ax)))
        (open! x)
        (fact 'subset-mem-fwd 'aa 'CC a)
        (cp-type! (list '* x 'c)) (cp-type! (list '* a x))
        (am8-scale-in! 'aa 'vv a (list '* x 'c))
        (close! (list '* a x) (list '= (list '* (list '* a x) 'c) (list '* a (list '* x 'c)))))))
  (mac 'is-cc-module-over)
  (dk-conj-close! dk-ass!))
(qed 'module-preimage-mul)

;;; a non-trivial finitely generated module has generators one of which is not 0
(define am8-gens-body
  (list 'FORSOME 'amn_ (list 'AND '(IN amn_ NN)
    (list 'FORSOME 'amg_ (list 'AND '(IN amg_ (FUN (INTERVAL 1 amn_) vv))
      (list 'AND (am-span 'amn_ 'amg_)
        '(FORSOME amk_ (AND (IN amk_ (INTERVAL 1 amn_)) (NOT (= (amg_ amk_) 0))))))))))
(sp (make-wff (forall-guarded '(aa vv) (list '(IS-SUBRING-OF-CC aa) '(IS-FG-CC-MODULE-OVER aa vv) am-nontriv)
  am8-gens-body)))
(dk-peel!)
(cp-ring!)
(am-carr-ag!)
(cp-sub-parts! 'aa)
(fact 'cc-zero-in)
(dk-project! '(IS-CC-MODULE-OVER aa vv) 'is-fg-cc-module-over '(IS-FG-CC-MODULE-OVER aa vv))
(dk-project! '(SUBSET vv CC) 'is-cc-module-over '(IS-CC-MODULE-OVER aa vv))
(let* ((fgex (dk-project! am-fgbody 'is-fg-cc-module-over '(IS-FG-CC-MODULE-OVER aa vv)))
       (n (dk-skolem! fgex))
       (gex (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'amg_))) (dk-asms)))
       (g (dk-skolem! gex))
       (v0 (dk-skolem! (dk-ctx-form am-nontriv)))
       (zeros (list 'FORALL 'amk_ (list 'IMPLIES (list 'IN 'amk_ (list 'INTERVAL 1 n)) (list '= (list g 'amk_) 0)))))
  (fact 'fun-codomain-superset g (list 'INTERVAL 1 n) 'vv 'CC)
  (use-em zeros
    (lambda ()
      (let ((b0 (dk-skolem! (dk-apply! (dk-ctx-form (am-span n g)) v0))))
        (dk-have! (list 'FORALL 'amk_ (list 'IMPLIES (list 'IN 'amk_ (list 'INTERVAL 1 n)) (list 'IN (list b0 'amk_) 'CC)))
          (lambda () (let ((z (dk-di-var!))) (fact 'fun-apply-type-c b0 (list 'INTERVAL 1 n) 'aa z) (fact 'subset-mem-fwd 'aa 'CC (list b0 z)) (ass))))
        (dk-apply! (dk-cite! 'cc-lincomb-zero-generators n b0 g))
        (let ((h (dk-rewrite-h! (list '= v0 (list 'CC-LINCOMB n b0 g)) (list 'CC-LINCOMB n b0 g) 0)))
          (ma-prop-with! (list h (list 'NOT h))))))
    (lambda ()
      (let* ((ex (dk-landed-1 (lambda () (push-not-h (list 'NOT zeros)))))
             (k0 (dk-skolem! ex)))
        (ew n)
        (dk-conj-close!
          (lambda ()
            (if (not (dk-ass!))
                (begin
                  (ew g)
                  (dk-conj-close!
                    (lambda ()
                      (if (not (dk-ass!))
                          (begin (ew k0) (dk-conj-close! dk-ass!)))))))))))))
(qed 'fg-module-nonzero-generator)

;;; r g_i h_j lies in a module W holding every g_l h_j, when the g's span an r-invariant module
(define am8-gh-in '(FORALL apl_ (IMPLIES (IN apl_ (INTERVAL 1 n)) (FORALL apm_ (IMPLIES (IN apm_ (INTERVAL 1 m)) (IN (* (g apl_) (h apm_)) vw))))))
(sp (make-wff (forall-guarded '(aa r vv n g m h vw)
  (list '(IS-SUBRING-OF-CC aa) '(IN r CC) '(IN n NN) '(IN m NN) '(IN g (FUN (INTERVAL 1 n) vv)) '(SUBSET vv CC) (am-span 'n 'g) am-inv
        '(IN h (FUN (INTERVAL 1 m) CC)) '(IS-CC-MODULE-OVER aa vw) am8-gh-in)
  '(FORALL api_ (IMPLIES (IN api_ (INTERVAL 1 n)) (FORALL apj_ (IMPLIES (IN apj_ (INTERVAL 1 m)) (IN (* r (* (g api_) (h apj_))) vw))))))))
(dk-peel!)
(cp-ring!)
(am-carr-ag!)
(cp-sub-parts! 'aa)
(let* ((gp (caddr (cadr (dk-goal)))) (i (cadr (cadr gp))) (j (cadr (caddr gp)))
       (int (am-int 'n)) (c (list 'h j))
       (s (list 'SEP 'amq_ 'CC (list 'IN (list '* 'amq_ c) 'vw))))
  (fact 'fun-apply-type-c 'h '(INTERVAL 1 m) 'CC j)
  (fact 'fun-codomain-superset 'g int 'vv 'CC)
  (fact 'fun-apply-type-c 'g int 'vv i) (fact 'fun-apply-type-c 'g int 'CC i)
  (dk-apply! (dk-cite! 'module-preimage-mul) 'aa 'vw c)
  ;; every generator lies in S
  (dk-have! (list 'IN 'g (list 'FUN int s))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c 'g int 'CC kv)
                (dk-apply! (dk-ctx-form am8-gh-in) kv j)
                (in-sep! dk-ass! dk-ass!))
              (begin
                (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN 'g (list 'FUN int 'CC))))))
                (ass)))))))
  (dk-apply! (dk-ctx-form am-inv) (list 'g i))
  (let* ((bt (dk-skolem! (dk-apply! (dk-ctx-form (am-span 'n 'g)) (list '* 'r (list 'g i)))))
         (lc (list 'CC-LINCOMB 'n bt 'g)))
    (dk-apply! (dk-cite! 'lincomb-in-module) 'aa s 'n bt 'g)
    (let* ((p (ma-sep-parts! (list 'IN lc s)))
           (p2 (dk-rewrite-h! p lc (list '* 'r (list 'g i))))
           (e (list '= (list '* 'r (list '* (list 'g i) c)) (list '* (list '* 'r (list 'g i)) c))))
      (dk-have! e (lambda () (crs)))
      (subst e)
      (ass))))
(qed 'module-product-invariance)

;;; (20) PROP. 4.19: sums and products of numbers algebraic over A are algebraic over A
(define (am9-fg-open! aa vs)
  ;; IS-FG-CC-MODULE-OVER aa vs in context: land IS-CC-MODULE-OVER aa vs and its parts
  (dk-project! (list 'IS-CC-MODULE-OVER aa vs) 'is-fg-cc-module-over (list 'IS-FG-CC-MODULE-OVER aa vs))
  (am8-mod-parts! aa vs))
(define (am9-module! rho)
  ;; rho algebraic over aa: returns (V n g k0), V non-trivial f.g. rho-invariant, generators g with g(k0) /= 0
  (let* ((vx (dk-apply! (dk-cite! 'invariant-module-of-algebraic) 'aa rho))
         (v (dk-skolem! vx)))
    (am9-fg-open! 'aa v)
    (let* ((gx (dk-apply! (dk-cite! 'fg-module-nonzero-generator) 'aa v))
           (n (dk-skolem! gx))
           (g (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'amg_) (dk-contains? f n))) (dk-asms))))
           (k0 (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'amk_) (dk-contains? f g))) (dk-asms)))))
      (fact 'fun-codomain-superset g (am-int n) v 'CC)
      (list v n g k0))))
(define (am9-gh-in n m g h vs)
  (list 'FORALL 'apl_ (list 'IMPLIES (list 'IN 'apl_ (am-int n)) (list 'FORALL 'apm_ (list 'IMPLIES (list 'IN 'apm_ (am-int m)) (list 'IN (list '* (list g 'apl_) (list h 'apm_)) vs))))))
(define (am9-on-gens rho nb u vs) (list 'FORALL 'amt_ (list 'IMPLIES (list 'IN 'amt_ (am-int nb)) (list 'IN (list '* rho (list u 'amt_)) vs))))
(define (am9-inv rho vs) (list 'FORALL 'amrv_ (list 'IMPLIES (list 'IN 'amrv_ vs) (list 'IN (list '* rho 'amrv_) vs))))
(define (am9-goal-pair) (let ((gp (cadr (dk-goal)))) (list (cadr (cadr gp)) (cadr (caddr gp)))))

(sp (make-wff (forall-guarded '(aa r s) '((IS-SUBRING-OF-CC aa) (IS-ALGEBRAIC-OVER aa r) (IS-ALGEBRAIC-OVER aa s))
  '(AND (IS-ALGEBRAIC-OVER aa (+ r s)) (IS-ALGEBRAIC-OVER aa (* r s))))))
(dk-peel!)
(cp-ring!)
(am-carr-ag!)
(cp-sub-parts! 'aa)
(fact 'cc-zero-in) (fact 'nn-one-in)
(dk-project! '(IN r CC) 'is-algebraic-over '(IS-ALGEBRAIC-OVER aa r))
(dk-project! '(IN s CC) 'is-algebraic-over '(IS-ALGEBRAIC-OVER aa s))
(let* ((mv (am9-module! 'r)) (vv1 (car mv)) (n (cadr mv)) (g (caddr mv)) (k0 (cadddr mv))
       (mw (am9-module! 's)) (ww1 (car mw)) (m (cadr mw)) (h (caddr mw)) (j0 (cadddr mw)))
  (dk-have! (list '<= n n) (lambda () (dk-nn!)))
  (let* ((px (dk-apply! (dk-cite! 'product-generators-exist) n 'aa n m g h))
         (nb (dk-skolem! px))
         (u (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'apu_) (dk-contains? f nb))) (dk-asms))))
         (afm (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'apt_) (dk-contains? f u))) (dk-asms)))
         (bfm (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'api_) (dk-contains? f u))) (dk-asms)))
         (intn (am-int n)) (intm (am-int m)) (intb (am-int nb))
         (us (am-vspan nb u)))
    (dk-split-all! (list (dk-apply! (dk-cite! 'cc-span-module) 'aa nb u)))
    (am9-fg-open! 'aa us)
    ;; every g_l h_j is in U
    (dk-have! (am9-gh-in n m g h us)
      (lambda ()
        (dk-peel!)
        (let* ((lj (am9-goal-pair)) (l (car lj)) (j (cadr lj)))
          (fact 'fun-apply-type-c g intn 'CC l) (fact 'fun-apply-type-c h intm 'CC j)
          (cp-type! (list '* (list g l) (list h j)))
          (let ((bt (dk-skolem! (dk-apply! bfm l j))))
            (in-sep! dk-ass! (lambda () (ew bt) (dk-conj-close! dk-ass!)))))))
    (dk-have! (am9-gh-in m n h g us)
      (lambda ()
        (dk-peel!)
        (let* ((lj (am9-goal-pair)) (l (car lj)) (j (cadr lj))
               (e (list '= (list '* (list h l) (list g j)) (list '* (list g j) (list h l)))))
          (fact 'fun-apply-type-c g intn 'CC j) (fact 'fun-apply-type-c h intm 'CC l)
          (dk-apply! (dk-ctx-form (am9-gh-in n m g h us)) j l)
          (dk-have! e (lambda () (crs)))
          (subst e)
          (ass))))
    (let ((r1 (dk-apply! (dk-cite! 'module-product-invariance) 'aa 'r vv1 n g m h us))
          (r2 (dk-apply! (dk-cite! 'module-product-invariance) 'aa 's ww1 m h n g us))
          (at! (lambda (t)
                 ;; t in INT(1, nb): returns (i j eq), u(t) = g(i) h(j)
                 (let* ((i (dk-skolem! (dk-apply! afm t)))
                        (jx (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'apj_) (dk-contains? f i))) (dk-asms)))
                        (j (dk-skolem! jx)))
                   (fact 'fun-apply-type-c g intn 'CC i) (fact 'fun-apply-type-c h intm 'CC j)
                   (fact 'fun-apply-type-c u intb 'CC t)
                   (list i j (list '= (list u t) (list '* (list g i) (list h j))))))))
      (dk-have! (am9-on-gens 'r nb u us)
        (lambda ()
          (let* ((t (dk-di-var!)) (ije (at! t)) (i (car ije)) (j (cadr ije)))
            (dk-apply! r1 i j)
            (subst (caddr ije))
            (ass))))
      (dk-have! (am9-on-gens 's nb u us)
        (lambda ()
          (let* ((t (dk-di-var!)) (ije (at! t)) (i (car ije)) (j (cadr ije))
                 (e (list '= (list '* 's (list '* (list g i) (list h j))) (list '* 's (list '* (list h j) (list g i))))))
            (dk-apply! r2 j i)
            (subst (caddr ije))
            (dk-have! e (lambda () (crs)))
            (subst e)
            (ass))))
      (dk-apply! (dk-cite! 'cc-span-invariant) 'aa nb u 'r)
      (cp-type! '(+ r s)) (cp-type! '(* r s))
      (dk-have! (am9-on-gens '(+ r s) nb u us)
        (lambda ()
          (let* ((t (dk-di-var!)) (ut (list u t)) (e (list '= (list '* '(+ r s) ut) (list '+ (list '* 'r ut) (list '* 's ut)))))
            (fact 'fun-apply-type-c u intb 'CC t)
            (dk-apply! (dk-ctx-form (am9-on-gens 'r nb u us)) t)
            (dk-apply! (dk-ctx-form (am9-on-gens 's nb u us)) t)
            (cp-type! (list '* 'r ut)) (cp-type! (list '* 's ut))
            (am8-add-in! us (list '* 'r ut) (list '* 's ut))
            (dk-have! e (lambda () (crs)))
            (subst e)
            (ass))))
      (dk-have! (am9-on-gens '(* r s) nb u us)
        (lambda ()
          (let* ((t (dk-di-var!)) (ut (list u t)) (e (list '= (list '* '(* r s) ut) (list '* 'r (list '* 's ut)))))
            (fact 'fun-apply-type-c u intb 'CC t)
            (dk-apply! (dk-ctx-form (am9-on-gens 's nb u us)) t)
            (cp-type! (list '* 's ut))
            (dk-apply! (dk-ctx-form (am9-inv 'r us)) (list '* 's ut))
            (dk-have! e (lambda () (crs)))
            (subst e)
            (ass))))
      (dk-apply! (dk-cite! 'cc-span-invariant) 'aa nb u '(+ r s))
      (dk-apply! (dk-cite! 'cc-span-invariant) 'aa nb u '(* r s))
      ;; U is not trivial: g(k0) h(j0) /= 0 lies in it
      (let ((x (list '* (list g k0) (list h j0))))
        (fact 'fun-apply-type-c g intn 'CC k0) (fact 'fun-apply-type-c h intm 'CC j0)
        (dk-apply! (dk-cite! 'cc-mul-nonzero (list g k0) (list h j0)))
        (dk-apply! (dk-ctx-form (am9-gh-in n m g h us)) k0 j0)
        (dk-have! (list 'FORSOME 'amnz_ (list 'AND (list 'IN 'amnz_ us) '(NOT (= amnz_ 0))))
          (lambda () (ew x) (dk-conj-close! dk-ass!))))
      (dk-apply! (dk-cite! 'algebraic-of-invariant-module) 'aa '(+ r s) us)
      (dk-apply! (dk-cite! 'algebraic-of-invariant-module) 'aa '(* r s) us)
      (dk-conj-close! dk-ass!))))
(qed 'algebraic-add-mul)

;;; (21) PROP. 4.19, the rest: -r and the elements of A are algebraic over A; the numbers algebraic over A form a
;;; subring of C
(sp (make-wff (forall-guarded '(aa r) '((IS-SUBRING-OF-CC aa) (IS-ALGEBRAIC-OVER aa r))
  '(IS-ALGEBRAIC-OVER aa (- r)))))
(dk-peel!)
(cp-ring!)
(am-carr-ag!)
(cp-sub-parts! 'aa)
(fact 'cc-zero-in)
(dk-project! '(IN r CC) 'is-algebraic-over '(IS-ALGEBRAIC-OVER aa r))
(cp-type! '(- r))
(let* ((vx (dk-apply! (dk-cite! 'invariant-module-of-algebraic) 'aa 'r))
       (v (dk-skolem! vx)))
  (am9-fg-open! 'aa v)
  (dk-have! (am9-inv '(- r) v)
    (lambda ()
      (let* ((x (dk-di-var!)) (e (list '= (list '* '(- r) x) (list '- (list '* 'r x)))))
        (fact 'subset-mem-fwd v 'CC x)
        (dk-apply! (dk-ctx-form (am9-inv 'r v)) x)
        (cp-type! (list '* 'r x))
        (am8-neg-in! v (list '* 'r x))
        (dk-have! e (lambda () (crs)))
        (subst e)
        (ass))))
  (dk-apply! (dk-cite! 'algebraic-of-invariant-module) 'aa '(- r) v)
  (ass))
(qed 'algebraic-neg)

(sp (make-wff (forall-guarded '(aa a) '((IS-SUBRING-OF-CC aa) (IN a aa))
  '(IS-ALGEBRAIC-OVER aa a))))
(dk-peel!)
(cp-ring!)
(am-carr-ag!)
(cp-sub-parts! 'aa)
(fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-one-in)
(fact 'subset-mem-fwd 'aa 'CC 'a)
(fact 'interval-in-set 1 1)
(let* ((int (am-int 1)) (u (list 'VNB-LAMBDA 'amw_ int 1)) (us (am-vspan 1 u)))
  (dk-have! (list 'IN u (list 'FUN int 'CC)) (lambda () (dk-lam-type! (lambda () (dk-di-var!) (ass)) (lambda () (ass)))))
  (dk-split-all! (list (dk-apply! (dk-cite! 'cc-span-module) 'aa 1 u)))
  (am9-fg-open! 'aa us)
  (dk-have! (am9-on-gens 'a 1 u us)
    (lambda ()
      (let ((t (dk-di-var!)))
        (fact 'fun-apply-type-c u int us t)
        (am8-scale-in! 'aa us 'a (list u t))
        (ass))))
  (dk-apply! (dk-cite! 'cc-span-invariant) 'aa 1 u 'a)
  (dk-have! '(<= 1 1) (lambda () (dk-nn!)))
  (dk-apply! (dk-cite! 'interval-mem-intro 1 1 1))
  (fact 'fun-apply-type-c u int us 1)
  (dk-have! (list '= (list u 1) 1) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
  (dk-rewrite-h! (list 'IN (list u 1) us) (list u 1) 1)
  (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
  (dk-have! (list 'FORSOME 'amnz_ (list 'AND (list 'IN 'amnz_ us) '(NOT (= amnz_ 0))))
    (lambda () (ew 1) (dk-conj-close! dk-ass!)))
  (dk-apply! (dk-cite! 'algebraic-of-invariant-module) 'aa 'a us)
  (ass))
(qed 'algebraic-of-ring-element)

;;; PROP. 4.19: the numbers algebraic over A form a subring of C
(define am10-s '(SEP anq_ CC (IS-ALGEBRAIC-OVER aa anq_)))
(sp (make-wff (forall-guarded '(aa) '((IS-SUBRING-OF-CC aa))
  (list 'IS-SUBRING-OF-CC am10-s))))
(dk-peel!)
(cp-sub-parts! 'aa)
(fact 'cc-zero-in) (fact 'cc-one-in)
(let* ((s am10-s)
       (open! (lambda (x) (ma-sep-parts! (list 'IN x s))))
       (close! (lambda (x) (dk-have! (list 'IN x s) (lambda () (in-sep! dk-ass! dk-ass!))))))
  (ma-sep-subset! s)
  (dk-apply! (dk-cite! 'algebraic-of-ring-element) 'aa 0) (close! 0)
  (dk-apply! (dk-cite! 'algebraic-of-ring-element) 'aa 1) (close! 1)
  (ma-for-each
    (lambda (op)
      (dk-have! (list 'FORALL 'psu_ (list 'IMPLIES (list 'IN 'psu_ s) (list 'FORALL 'psv_ (list 'IMPLIES (list 'IN 'psv_ s) (list 'IN (list op 'psu_ 'psv_) s)))))
        (lambda ()
          (let* ((ls (dk-peel!)) (xy (ma-map cadr ls)) (x (car xy)) (y (cadr xy)))
            (open! x) (open! y)
            (dk-split-all! (list (dk-apply! (dk-cite! 'algebraic-add-mul) 'aa x y)))
            (cp-type! (list op x y))
            (in-sep! dk-ass! dk-ass!)))))
    '(+ *))
  (dk-have! (list 'FORALL 'ansn_ (list 'IMPLIES (list 'IN 'ansn_ s) (list 'IN '(- ansn_) s)))
    (lambda ()
      (let ((x (dk-di-var!)))
        (open! x)
        (dk-apply! (dk-cite! 'algebraic-neg) 'aa x)
        (cp-type! (list '- x))
        (in-sep! dk-ass! dk-ass!))))
  (mac 'is-subring-of-cc)
  (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (mac 'is-cc-subring) (dk-conj-close! dk-ass!))))))
(qed 'algebraic-numbers-subring)

;;; (22) PROP. 4.25: theta algebraic over the field of fractions K of A gives k theta algebraic over A for a
;;; non-zero k in A (clear the denominators, then substitute a_n theta)
(define (am11-frac aa)
  (list 'SEP 'anfq_ 'CC (list 'FORSOME 'anfa_ (list 'AND (list 'IN 'anfa_ aa)
    (list 'FORSOME 'anfb_ (list 'AND (list 'IN 'anfb_ aa) '(AND (NOT (= anfb_ 0)) (= (* anfq_ anfb_) anfa_))))))))
(define (am11-cleared d c k)
  (list 'FORALL 'anj_ (list 'IMPLIES '(IN anj_ NN) (list 'IMPLIES (list '< 'anj_ k) (list 'IN (list '* d (list c 'anj_)) 'aa)))))
(define (am11-ge! j b)
  ;; j, b in NN, (NOT (< j b)) in context: land (<= b j)
  (fact 'nn-in-rr j) (fact 'nn-in-rr b)
  (dk-have! (list '<= b j)
    (lambda ()
      (ma-or-split! (dk-apply! (dk-cite! 'rr-lt-trichotomy j b))
        (list (lambda () (ma-prop-with! (list (list '< j b) (list 'NOT (list '< j b)))))
              (lambda () (dk-nn! (list '= j b)))
              (lambda () (dk-nn! (list '< b j))))))))
(define (am11-rfl!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))

;;; the field of fractions, as the SEP the drivers read
(sp (make-wff '(FORALL aa (SUBSET (CC-FRACTION-FIELD aa) (SEP anfq_ CC (FORSOME anfa_ (AND (IN anfa_ aa)
     (FORSOME anfb_ (AND (IN anfb_ aa) (AND (NOT (= anfb_ 0)) (= (* anfq_ anfb_) anfa_)))))))))))
(dk-peel!)
(mac 'CC-FRACTION-FIELD)
(dk-cite! 'subset-refl (am11-frac 'aa))
(ass)
(qed 'cc-fraction-field-sub)

;;; a common denominator for the first k coefficients
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
  (forall-guarded '(aa c) (list '(IS-SUBRING-OF-CC aa) (list 'IN 'c (list 'FUN 'NN (am11-frac 'aa))))
    (list 'FORSOME 'cdd_ (list 'AND '(IN cdd_ aa) (list 'AND '(NOT (= cdd_ 0)) (am11-cleared 'cdd_ 'c 'k)))))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))) (fr (am11-frac 'aa)))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (cp-sub-parts! 'aa)
  (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
  (ew 1)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (dk-peel!)
            (let ((j (cadr (caddr (cadr (dk-goal))))))
              (dk-have! '(< 0 0) (lambda () (dk-nn! (list '< j 0))))
              (ap-absurd!))))))
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (cp-sub-parts! 'aa)
  (ma-sep-subset! fr)
  (fact 'fun-codomain-superset 'c 'NN fr 'CC)
  (fact 'nn-succ-closed v)
  (let* ((d (dk-skolem! (dk-apply! (dk-ctx-form ih) 'aa 'c))))
    (fact 'fun-apply-type-c 'c 'NN fr v)
    (let* ((al (dk-skolem! (ma-sep-parts! (list 'IN (list 'c v) fr))))
           (be (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'anfb_) (dk-contains? f al))) (dk-asms))))
           (d2 (list '* d be)))
      (ma-for-each (lambda (x) (fact 'subset-mem-fwd 'aa 'CC x)) (list d be al))
      (fact 'fun-apply-type-c 'c 'NN 'CC v)
      (cp-mul-in! 'aa d be)
      (dk-apply! (dk-cite! 'cc-mul-nonzero d be))
      (ew d2)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (begin
                (dk-peel!)
                (let ((j (cadr (caddr (cadr (dk-goal))))))
                  (fact 'fun-apply-type-c 'c 'NN 'CC j)
                  (use-em (list '< j v)
                    (lambda ()
                      (let ((e (list '= (list '* d2 (list 'c j)) (list '* be (list '* d (list 'c j))))))
                        (dk-apply! (dk-ctx-form (am11-cleared d 'c v)) j)
                        (cp-type! (list '* d (list 'c j)))
                        (cp-mul-in! 'aa be (list '* d (list 'c j)))
                        (dk-have! e (lambda () (crs)))
                        (subst e)
                        (ass)))
                    (lambda ()
                      (fact 'nn-in-rr j) (fact 'nn-in-rr v)
                      (dk-have! (list '= j v)
                        (lambda ()
                          (ma-or-split! (dk-apply! (dk-cite! 'rr-lt-trichotomy j v))
                            (list (lambda () (ma-prop-with! (list (list '< j v) (list 'NOT (list '< j v)))))
                                  (lambda () (ass))
                                  (lambda ()
                                    (dk-apply! (dk-cite! 'nn-lt-succ-le v j))
                                    (dk-have! '(< 0 0) (lambda () (dk-nn! (list '<= (list 'succ v) j) (list '< j (list 'succ v)))))
                                    (ap-absurd!))))))
                      (subst (list '= j v))
                      (let ((e (list '= (list '* d2 (list 'c v)) (list '* d (list '* (list 'c v) be)))))
                        (dk-have! e (lambda () (crs)))
                        (subst e)
                        (subst (list '= (list '* (list 'c v) be) al))
                        (cp-mul-in! 'aa d al)
                        (ass))))))))))))
(qed 'cc-fraction-common-denominator)

;;; a_(p+1) theta is algebraic over A when sum_{j <= p+1} a_j theta^j = 0, a_j in A, a_(p+1) /= 0
(define (am11-if1 j) (list 'IF (list '<= j 'p) (list '* (list 'a j) (list 'power 'an (list 'NN-MINUS 'p j))) (list 'IF (list '= j '(succ p)) 1 0)))
(define (am11-if2 j) (list 'IF (list '= j '(succ p)) 1 0))
(sp (make-wff (forall-guarded '(aa p a th an)
  (list '(IS-SUBRING-OF-CC aa) '(IN p NN) '(IN a (FUN NN aa)) (cp-van 'a '(succ (succ p))) '(IN th CC) '(= (a (succ p)) an) '(NOT (= an 0))
        (list '= (cp-ps 'a 'th '(succ (succ p))) 0))
  '(IS-ALGEBRAIC-OVER aa (* an th)))))
(dk-peel!)
(cp-ring!)
(am-carr-ag!)
(cp-sub-parts! 'aa)
(fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-zero-in) (fact 'nn-one-in)
(let* ((sp1 '(succ p)) (ssp '(succ (succ p))) (x '(* an th))
       (e (list 'VNB-LAMBDA 'anej_ 'NN (am11-if1 'anej_)))
       (hf (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list e 'pfj_) (list 'power x 'pfj_))))
       (ff (list 'VNB-LAMBDA 'pfj_ 'NN (list '* '(a pfj_) '(power th pfj_))))
       (c0 '(power an p))
       (absurd-le! (lambda (prem) (dk-have! '(< 0 0) (lambda () (apply dk-nn! prem))) (ap-absurd!))))
  (fact 'nn-succ-closed 'p) (fact 'nn-succ-closed sp1)
  (cp-fcc! 'a 'aa)
  (fact 'fun-apply-type-c 'a 'NN 'aa sp1)
  (dk-have! '(IN an aa) (lambda () (subst (list '= 'an (list 'a sp1))) (ass)))
  (fact 'subset-mem-fwd 'aa 'CC 'an)
  (cp-type! x) (cp-type! c0)
  ;; the new coefficients
  (dk-have! (list 'IN e '(FUN NN aa))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((j (dk-di-var!)))
            (dk-case-if! (am11-if1 j)
              (lambda (t? val)
                (if t?
                    (let ((m (list 'NN-MINUS 'p j)))
                      (fact 'nn-minus-in-nn 'p j)
                      (dk-apply! (dk-cite! 'cc-subring-power m) 'aa 'an)
                      (fact 'fun-apply-type-c 'a 'NN 'aa j)
                      (cp-mul-in! 'aa (list 'a j) (list 'power 'an m))
                      (ass))
                    (dk-case-if! (am11-if2 j) (lambda (t2 v2) (ass))))))))
        (lambda () (fact 'nn-is-set) (ass)))))
  (cp-fcc! e 'aa)
  (dk-have! (list '= (list e sp1) 1)
    (lambda ()
      (dk-lam-b!)
      (dk-if-branch! #f (am11-if1 sp1) (lambda () (di) (absurd-le! (list (list '<= sp1 'p))))
        (lambda () (dk-if-branch! #t (am11-if2 sp1) (lambda () (rfl)) am11-rfl!)))))
  (dk-have! (cp-van e ssp)
    (lambda ()
      (dk-peel!)
      (let ((k (cadr (cadr (dk-goal)))))
        (dk-lam-b!)
        (dk-if-branch! #f (am11-if1 k) (lambda () (di) (absurd-le! (list (list '<= k 'p) (list '<= ssp k))))
          (lambda () (dk-if-branch! #f (am11-if2 k) (lambda () (di) (absurd-le! (list (list '= k sp1) (list '<= ssp k)))) am11-rfl!))))))
  ;; sum_j e_j (an th)^j = an^p sum_j a_j th^j
  (cp-ps-typ! e x ssp)
  (cp-ps-typ! 'a 'th ssp)
  (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '= (list hf 'cpdj_) (list '+ (list '* c0 (list ff 'cpdj_)) (list '* 0 (list ff 'cpdj_))))))
    (lambda ()
      (let* ((j (dk-di-var!)) (aj (list 'a j)) (thj (list 'power 'th j)) (xj (list 'power x j)))
        (fact 'fun-apply-type-c 'a 'NN 'CC j)
        (cp-type! thj) (cp-type! xj) (cp-type! (list 'power 'an j))
        (fact 'nn-in-rr j) (fact 'nn-in-rr 'p) (fact 'nn-in-rr sp1)
        (dk-lam-b!)
        (use-em (list '<= j 'p)
          (lambda ()
            (let* ((m (list 'NN-MINUS 'p j))
                   (mb (dk-apply! (dk-cite! 'cc-power-mul-base j 'an 'th)))
                   (ed (dk-apply! (dk-cite! 'nn-minus-def) 'p j)))
              (fact 'nn-minus-in-nn 'p j)
              (cp-type! (list 'power 'an m))
              (dk-have! (list '= (list '+ m j) 'p)
                (lambda () (subst ed) (dk-if-branch! #t (list 'IF (list '<= j 'p) (list '- 'p j) 0) #f (lambda () (crs)))))
              (let* ((pa (dk-apply! (dk-cite! 'cc-power-add j m 'an)))
                     (pa2 (dk-rewrite-h! pa (list '+ m j) 'p)))
                (dk-if-branch! #t (am11-if1 j) #f
                  (lambda ()
                    (subst mb)
                    (subst pa2)
                    (crs))))))
          (lambda ()
            (dk-if-branch! #f (am11-if1 j) #f
              (lambda ()
                (use-em (list '= j sp1)
                  (lambda ()
                    (dk-if-branch! #t (am11-if2 j) #f
                      (lambda ()
                        (subst (list '= j sp1))
                        (subst (list '= (list 'a sp1) 'an))
                        (cp-type! (list 'power 'th sp1))
                        (let ((mb (dk-apply! (dk-cite! 'cc-power-mul-base sp1 'an 'th))))
                          (am-pow-succ! 'an 'p)
                          (subst mb)
                          (subst (list '= (list 'power 'an sp1) (list '* 'an c0)))
                          (crs)))))
                  (lambda ()
                    (dk-if-branch! #f (am11-if2 j) #f
                      (lambda ()
                        (dk-have! (list '<= ssp j)
                          (lambda ()
                            (ma-or-split! (dk-apply! (dk-cite! 'rr-lt-trichotomy j sp1))
                              (list (lambda ()
                                      (dk-apply! (dk-cite! 'nn-lt-succ-le j sp1))
                                      (dk-have! (list '<= j 'p) (lambda () (dk-nn! (list '<= (list 'succ j) sp1))))
                                      (ma-prop-with! (list (list '<= j 'p) (list 'NOT (list '<= j 'p)))))
                                    (lambda () (ma-prop-with! (list (list '= j sp1) (list 'NOT (list '= j sp1)))))
                                    (lambda () (dk-apply! (dk-cite! 'nn-lt-succ-le sp1 j)) (ass))))))
                        (dk-apply! (dk-ctx-form (cp-van 'a ssp)) j)
                        (subst (list '= aj 0))
                        (crs))))))))))))
  (let ((lin (dk-apply! (dk-cite! 'cc-series-partial-sum-lincomb ssp ff ff hf c0 0))))
    (dk-have! (list '= (cp-ps e x ssp) 0)
      (lambda ()
        (subst lin)
        (subst (list '= (cp-ps 'a 'th ssp) 0))
        (crs))))
  (mac 'is-algebraic-over)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (ew sp1)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (begin (ew e) (dk-conj-close! dk-ass!))))))))))
(qed 'algebraic-scale-leading)

;;; (23) PROP. 4.25: if theta is algebraic over the field of fractions K of a subring A of C, then k theta is
;;; algebraic over A for some non-zero k in A
(define am12-body
  (list 'FORSOME 'anan_ (list 'AND '(IN anan_ NN)
    (list 'FORSOME 'anac_ (list 'AND '(IN anac_ (FUN NN (CC-FRACTION-FIELD aa)))
      (list 'AND (cp-van 'anac_ '(succ anan_))
        (list 'AND '(NOT (= (anac_ anan_) 0)) (list '= (cp-ps 'anac_ 'th '(succ anan_)) 0))))))))
(sp (make-wff (forall-guarded '(aa th) '((IS-SUBRING-OF-CC aa) (IS-ALGEBRAIC-OVER-FIELD (CC-FRACTION-FIELD aa) th))
  '(FORSOME ank_ (AND (IN ank_ aa) (AND (NOT (= ank_ 0)) (IS-ALGEBRAIC-OVER aa (* ank_ th))))))))
(dk-peel!)
(cp-ring!)
(am-carr-ag!)
(cp-sub-parts! 'aa)
(fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-zero-in) (fact 'nn-one-in)
(dk-project! '(IN th CC) 'is-algebraic-over-field '(IS-ALGEBRAIC-OVER-FIELD (CC-FRACTION-FIELD aa) th))
(let* ((ab (dk-project! am12-body 'is-algebraic-over-field '(IS-ALGEBRAIC-OVER-FIELD (CC-FRACTION-FIELD aa) th)))
       (n (dk-skolem! ab))
       (c (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'anac_))) (dk-asms))))
       (fr (am11-frac 'aa)) (sn (list 'succ n)))
  (dk-cite! 'cc-fraction-field-sub 'aa)
  (fact 'fun-codomain-superset c 'NN '(CC-FRACTION-FIELD aa) fr)
  (ma-sep-subset! fr)
  (fact 'fun-codomain-superset c 'NN fr 'CC)
  (fact 'nn-succ-closed n)
  (let* ((d (dk-skolem! (dk-apply! (dk-cite! 'cc-fraction-common-denominator sn) 'aa c)))
         (a (list 'VNB-LAMBDA 'anaj_ 'NN (list '* d (list c 'anaj_)))))
    (fact 'subset-mem-fwd 'aa 'CC d)
    ;; a = d c has its coefficients in A, vanishes from n + 1, and has the partial sums of c times d
    (dk-have! (list 'IN a '(FUN NN aa))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((j (dk-di-var!)))
              (fact 'fun-apply-type-c c 'NN 'CC j)
              (use-em (list '< j sn)
                (lambda () (dk-apply! (dk-ctx-form (am11-cleared d c sn)) j) (ass))
                (lambda ()
                  (am11-ge! j sn)
                  (dk-apply! (dk-ctx-form (cp-van c sn)) j)
                  (subst (list '= (list c j) 0))
                  (dk-have! (list '= (list '* d 0) 0) (lambda () (crs)))
                  (subst (list '= (list '* d 0) 0))
                  (ass)))))
          (lambda () (fact 'nn-is-set) (ass)))))
    (cp-fcc! a 'aa)
    (dk-have! (cp-van a sn)
      (lambda ()
        (dk-peel!)
        (let ((k (cadr (cadr (dk-goal)))))
          (fact 'fun-apply-type-c c 'NN 'CC k)
          (dk-apply! (dk-ctx-form (cp-van c sn)) k)
          (dk-lam-b!)
          (subst (list '= (list c k) 0))
          (crs))))
    (dk-have! (cp-lcomb a c c d 0)
      (lambda () (let ((k (dk-di-var!))) (fact 'fun-apply-type-c c 'NN 'CC k) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (crs)))))
    (ma-or-split! (dk-cite! 'nn-zero-or-succ n)
      (list
        (lambda ()
          ;; n = 0: c(0) = sum_{j < 1} c_j theta^j = 0, against c(n) /= 0
          (let* ((pf (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list c 'pfj_) '(power th pfj_))))
                 (hps (dk-rewrite-h! (list '= (cp-ps c 'th sn) 0) n 0))
                 (hn (dk-rewrite-h! (list 'NOT (list '= (list c n) 0)) n 0)))
            (cp-ps-typ! c 'th 0)
            (fact 'fun-apply-type-c c 'NN 'CC 0)
            (cp-type! '(power th 0))
            (dk-have! (list 'IN (list pf 0) 'CC) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-type! (cadr (dk-goal)) 'CC))))
            (dk-apply! (dk-cite! 'cc-series-partial-sum-succ pf) 0)
            (let* ((h1 (dk-rewrite-h! hps (cp-ps c 'th '(succ 0)) (list '+ (cp-ps c 'th 0) (list pf 0)))))
              (dk-cite! 'cc-series-partial-sum-zero pf)
              (dk-have! (list '= (list pf 0) (list '* (list c 0) '(power th 0))) (lambda () (if (not (dk-lam-b!)) (rfl))))
              (dk-cite! 'power-zero 'th)
              (let* ((h2 (dk-rewrite-h! h1 (cp-ps c 'th 0) 0))
                     (h3 (dk-rewrite-h! h2 (list pf 0) (list '* (list c 0) '(power th 0))))
                     (h4 (dk-rewrite-h! h3 '(power th 0) 1))
                     (e (list '= (list c 0) (cadr h4))))
                (dk-have! e (lambda () (crs)))
                (dk-have! (list '= (list c 0) 0) (lambda () (subst e) (ass)))
                (ma-prop-with! (list (list '= (list c 0) 0) hn))))))
        (lambda ()
          ;; n = p + 1
          (let* ((p (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f n) (not (dk-contains? f 'anac_)))) (dk-asms))))
                 (sp1 (list 'succ p)) (ssp (list 'succ sp1))
                 (an (list '* d (list c sp1))))
            (fact 'nn-succ-closed p)
            (fact 'nn-succ-closed sp1)
            (let* ((hps (dk-rewrite-h! (list '= (cp-ps c 'th sn) 0) n sp1))
                   (hn (dk-rewrite-h! (list 'NOT (list '= (list c n) 0)) n sp1))
                   (hv (dk-rewrite-h! (cp-van a sn) n sp1))
                   (lc (dk-apply! (dk-apply! (dk-cite! 'cc-ps-lincomb ssp c c a d 0)) 'th)))
              (fact 'fun-apply-type-c c 'NN 'CC sp1)
              (cp-ps-typ! c 'th ssp)
              (dk-have! (list '= (cp-ps a 'th ssp) 0)
                (lambda () (subst lc) (subst (list '= (cp-ps c 'th ssp) 0)) (crs)))
              (dk-apply! (dk-cite! 'cc-mul-nonzero d (list c sp1)))
              (dk-have! (list '< sp1 sn) (lambda () (dk-nn! (list '= n sp1))))
              (dk-apply! (dk-ctx-form (am11-cleared d c sn)) sp1)
              (cp-type! an)
              (dk-have! (list '= (list a sp1) an) (lambda () (if (not (dk-lam-b!)) (rfl))))
              (dk-apply! (dk-cite! 'algebraic-scale-leading) 'aa p a 'th an)
              (ew an)
              (dk-conj-close! dk-ass!))))))))
(qed 'algebraic-over-fractions-scaled)

;;; (24) toward COR. 4.26: Z and Q as subrings of C, Q a subfield, monotonicity in the coefficient ring,
;;; monic implies algebraic over a field, Q inside the fractions of Z
(define (am13-subring! kc)
  ;; goal (IS-SUBRING-OF-CC kc) for a number class kc with its closure laws known to dk-type!
  (mac 'is-subring-of-cc)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (ass))
              ((dk-head-is? g 'IS-CC-SUBRING)
               (mac 'is-cc-subring)
               (dk-conj-close!
                 (lambda ()
                   (let ((g2 (dk-goal)))
                     (cond ((dk-asm? g2) (ass))
                           ((dk-head-is? g2 'SUBSET) (let ((x (subset-by-element!))) (dk-type! x 'CC)))
                           ((dk-head-is? g2 'FORALL) (dk-peel!) (dk-type! (cadr (dk-goal)) kc))
                           ((number? (cadr g2)) (arith))
                           (#t (dk-type! (cadr g2) kc)))))))
              (#t (dk-peel!) (dk-type! (cadr (dk-goal)) kc)))))))
(sp (make-wff '(IS-SUBRING-OF-CC ZZ)))
(am13-subring! 'ZZ)
(qed 'zz-is-subring-of-cc)
(sp (make-wff '(IS-SUBRING-OF-CC QQ)))
(am13-subring! 'QQ)
(qed 'qq-is-subring-of-cc)
(sp (make-wff '(IS-SUBFIELD-OF-CC QQ)))
(dk-cite! 'qq-is-subring-of-cc)
(mac 'is-subfield-of-cc)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (begin
          (dk-peel!)
          (let ((x (cadr (cadr (dk-goal)))))
            (dk-have! (list 'AND (list 'IN x 'QQ) (list 'NOT (list '= x 0))))
            (fact 'qq-recip-closed x)
            (ass))))))
(qed 'qq-is-subfield-of-cc)

;;; the monic body of IS-ALGEBRAIC-OVER and the body of IS-ALGEBRAIC-OVER-FIELD
(define (am13-ring-body kk x)
  (list 'FORSOME 'anan_ (list 'AND '(IN anan_ NN)
    (list 'FORSOME 'anac_ (list 'AND (list 'IN 'anac_ (list 'FUN 'NN kk))
      (list 'AND (cp-van 'anac_ '(succ anan_))
        (list 'AND '(= (anac_ anan_) 1) (list '= (cp-ps 'anac_ x '(succ anan_)) 0))))))))
(define (am13-field-body kk x)
  (list 'FORSOME 'anan_ (list 'AND '(IN anan_ NN)
    (list 'FORSOME 'anac_ (list 'AND (list 'IN 'anac_ (list 'FUN 'NN kk))
      (list 'AND (cp-van 'anac_ '(succ anan_))
        (list 'AND '(NOT (= (anac_ anan_) 0)) (list '= (cp-ps 'anac_ x '(succ anan_)) 0))))))))
(define (am13-open! pred kk x body)
  ;; (pred kk x) in context: land (IN x CC) and skolemize the body; returns (n c)
  (dk-project! (list 'IN x 'CC) (if (eq? pred 'IS-ALGEBRAIC-OVER) 'is-algebraic-over 'is-algebraic-over-field) (list pred kk x))
  (let* ((ab (dk-project! body (if (eq? pred 'IS-ALGEBRAIC-OVER) 'is-algebraic-over 'is-algebraic-over-field) (list pred kk x)))
         (n (dk-skolem! ab))
         (c (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'anac_) (dk-contains? f n))) (dk-asms)))))
    (list n c)))
(define (am13-close! pred n c)
  ;; goal (pred kk x), every conjunct of the body at n, c in context
  (mac (if (eq? pred 'IS-ALGEBRAIC-OVER) 'is-algebraic-over 'is-algebraic-over-field))
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (ew n)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (begin (ew c) (dk-conj-close! dk-ass!))))))))))

(sp (make-wff (forall-guarded '(aa bb x) '((SUBSET aa bb) (IS-ALGEBRAIC-OVER aa x)) '(IS-ALGEBRAIC-OVER bb x))))
(dk-peel!)
(let* ((nc (am13-open! 'IS-ALGEBRAIC-OVER 'aa 'x (am13-ring-body 'aa 'x))) (n (car nc)) (c (cadr nc)))
  (fact 'fun-codomain-superset c 'NN 'aa 'bb)
  (am13-close! 'IS-ALGEBRAIC-OVER n c))
(qed 'algebraic-over-mono)

(sp (make-wff (forall-guarded '(aa bb x) '((SUBSET aa bb) (IS-ALGEBRAIC-OVER-FIELD aa x)) '(IS-ALGEBRAIC-OVER-FIELD bb x))))
(dk-peel!)
(let* ((nc (am13-open! 'IS-ALGEBRAIC-OVER-FIELD 'aa 'x (am13-field-body 'aa 'x))) (n (car nc)) (c (cadr nc)))
  (fact 'fun-codomain-superset c 'NN 'aa 'bb)
  (am13-close! 'IS-ALGEBRAIC-OVER-FIELD n c))
(qed 'algebraic-over-field-mono)

;;; a monic relation is a relation with a non-zero leading coefficient
(sp (make-wff (forall-guarded '(aa x) '((IS-ALGEBRAIC-OVER aa x)) '(IS-ALGEBRAIC-OVER-FIELD aa x))))
(dk-peel!)
(let* ((nc (am13-open! 'IS-ALGEBRAIC-OVER 'aa 'x (am13-ring-body 'aa 'x))) (n (car nc)) (c (cadr nc)))
  (dk-have! (list 'NOT (list '= (list c n) 0))
    (lambda ()
      (di)
      (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
      (let ((h (dk-rewrite-h! (list '= (list c n) 0) (list c n) 1)))
        (ma-prop-with! (list h '(NOT (= 1 0)))))))
  (am13-close! 'IS-ALGEBRAIC-OVER-FIELD n c))
(qed 'algebraic-ring-to-field)

;;; Q lies in the field of fractions of Z
(sp (make-wff (list 'SUBSET 'QQ (am11-frac 'ZZ))))
(let ((q (subset-by-element!)))
  (let* ((a (dk-skolem! (dk-apply! (dk-cite! 'qq-is-fraction) q)))
         (b (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f a))) (dk-asms)))))
    (dk-type! q 'CC) (dk-type! a 'CC) (dk-type! b 'CC)
    (dk-have! (list 'AND (list 'IN b 'CC) (list 'NOT (list '= b 0))))
    (fact 'cc-recip-inverse b)
    (fact 'cc-recip-closed b)
    (let* ((w (dk-name! (list 'recip b) 'CC))
           (e1 (dk-rewrite-h! (list '= (list '* b (list 'recip b)) 1) (list 'recip b) w))
           (e2 (dk-rewrite-h! (list '= q (list '* a (list 'recip b))) (list 'recip b) w)))
      (in-sep! dk-ass!
        (lambda ()
          (ew a)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
