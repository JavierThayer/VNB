        (dk-have! (list '= (list pf 'n) '(* (c n) (power th n))) (lambda () (if (not (dk-lam-b!)) (rfl))))
        (let* ((h2 (dk-rewrite-h! h (list pf 'n) '(* (c n) (power th n))))
               (h3 (dk-rewrite-h! h2 '(c n) 1))
               (sum (cadr h3))
               (id (list '= '(power th n) (list '- sum ps))))
          (dk-have! id (lambda () (crs)))
          (subst id)
          (subst h3)
          (crs)))))
  (ma-or-split! (dk-cite! 'nn-zero-or-succ 'n)
    (list
      (lambda ()
        ;; n = 0: the monic polynomial is the constant 1
        (let* ((h (dk-rewrite-h! (list '= '(power th n) (list '- ps)) 'n 0)))
          (fact 'power-zero 'th)
          (dk-cite! 'cc-series-partial-sum-zero pf)
          (let* ((h2 (dk-rewrite-h! h '(power th 0) 1))
                 (h3 (dk-rewrite-h! h2 (cp-ps 'c 'th 0) 0)))
            (dk-have! '(< 0 0) (lambda () (dk-ineq! h3)))
            (ap-absurd!))))
      (lambda ()
        (let ((p0 (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'n) (dk-contains? f 'succ) (not (dk-contains? f 'c)))) (dk-asms)))))
          (dk-have! '(<= 1 n) (lambda () (dk-nn! (list '= 'n (list 'succ p0))))))
        (let* ((nw (dk-skolem! (dk-apply! (dk-cite! 'algebraic-tower-module '(succ n)) 'aa 'c)))
               (u (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'atu_) (dk-contains? f nw))) (dk-asms))))
               (ws (am19-span nw u))
               (x0 (dk-skolem! (dk-ctx-form (am19-nontriv nw u))))
               (intw (am-int nw)) (intn (am-int 'n))
               (h (list 'VNB-LAMBDA 'atp_ intn '(power th (NN-MINUS atp_ 1)))))
          (dk-split-all! (list (dk-apply! (dk-cite! 'cc-span-module) 'aa nw u)))
          (am9-fg-open! 'aa ws)
          (fact 'interval-in-set 1 'n)
          (dk-have! (list 'IN h (list 'FUN intn 'CC))
            (lambda ()
              (dk-lam-type! (lambda () (let ((i (dk-di-var!))) (cp-int-parts! 1 'n i) (fact 'nn-minus-in-nn i 1) (cp-type! (list 'power 'th (list 'NN-MINUS i 1))) (ass)))
                            (lambda () (ass)))))
          (dk-have! (list '<= nw nw) (lambda () (dk-nn!)))
          (let* ((px (dk-apply! (dk-cite! 'product-generators-exist) nw 'aa nw 'n u h))
                 (nb (dk-skolem! px))
                 (u2 (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'apu_) (dk-contains? f nb))) (dk-asms))))
                 (afm (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'apt_) (dk-contains? f u2))) (dk-asms)))
                 (bfm (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'api_) (dk-contains? f u2))) (dk-asms)))
                 (intb (am-int nb))
                 (us (am19-span nb u2))
                 (hval! (lambda (k)
                          ;; k in NN, k < n: (succ k) in INT(1, n) and h(succ k) = th^k
                          (fact 'nn-succ-closed k)
                          (dk-apply! (dk-cite! 'nn-lt-succ-le k 'n))
                          (dk-have! (list '<= 1 (list 'succ k)) (lambda () (dk-nn!)))
                          (dk-apply! (dk-cite! 'interval-mem-intro 1 'n (list 'succ k)))
                          (cp-type! (list 'power 'th k))
                          (dk-apply! (dk-cite! 'nn-minus-succ-1) k)
                          (fact 'nn-minus-in-nn (list 'succ k) 1)
                          (dk-have! (list '= (list h (list 'succ k)) (list 'power 'th k))
                            (lambda () (dk-lam-b!) (subst (list '= (list 'NN-MINUS (list 'succ k) 1) k)) (am11-rfl!))))))
            (dk-split-all! (list (dk-apply! (dk-cite! 'cc-span-module) 'aa nb u2)))
            (am9-fg-open! 'aa us)
            ;; every u_l h_b is in U
            (dk-have! (am9-gh-in nw 'n u h us)
              (lambda ()
                (dk-peel!)
                (let* ((lj (am9-goal-pair)) (l (car lj)) (j (cadr lj)))
                  (fact 'fun-apply-type-c u intw 'CC l) (fact 'fun-apply-type-c h intn 'CC j)
                  (cp-type! (list '* (list u l) (list h j)))
                  (let ((bt (dk-skolem! (dk-apply! bfm l j))))
                    (in-sep! dk-ass! (lambda () (ew bt) (dk-conj-close! dk-ass!)))))))
            (let ((into! (lambda (x k)
                           ;; x in W, k in NN, k < n: land (IN (* x th^k) U)
                           (let* ((pk (list 'power 'th k)) (sk (list 'SEP 'amq_ 'CC (list 'IN (list '* 'amq_ pk) us))))
                             (hval! k)
                             (dk-apply! (dk-cite! 'module-preimage-mul) 'aa us pk)
                             (dk-have! (list 'IN u (list 'FUN intw sk))
                               (lambda ()
                                 (mac 'fun-codomain-iff)
                                 (dk-conj-close!
                                   (lambda ()
                                     (if (dk-head-is? (dk-goal) 'FORALL)
                                         (let ((kv (dk-di-var!)))
                                           (fact 'fun-apply-type-c u intw 'CC kv)
                                           (let ((m (dk-apply! (dk-ctx-form (am9-gh-in nw 'n u h us)) kv (list 'succ k))))
                                             (dk-rewrite-h! m (list h (list 'succ k)) pk))
                                           (in-sep! dk-ass! dk-ass!))
                                         (begin
                                           (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN u (list 'FUN intw 'CC))))))
                                           (ass)))))))
                             (let* ((b (dk-skolem! (ma-sep-parts! (list 'IN x ws))))
                                    (lc (list 'CC-LINCOMB nw b u)))
                               (dk-apply! (dk-cite! 'lincomb-in-module) 'aa sk nw b u)
                               (dk-rewrite-h! (ma-sep-parts! (list 'IN lc sk)) lc x))))))
              ;; theta u2(t) is in U
              (dk-have! (am9-on-gens 'th nb u2 us)
                (lambda ()
                  (let* ((t (dk-di-var!))
                         (i (dk-skolem! (dk-apply! afm t)))
                         (j (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'apj_) (dk-contains? f i))) (dk-asms)))))
                    (fact 'fun-apply-type-c u intw 'CC i)
                    (fact 'fun-apply-type-c u2 intb 'CC t)
                    (cp-int-parts! 1 'n j)
                    (subst (list '= (list u2 t) (list '* (list u i) (list h j))))
                    (ma-or-split! (dk-cite! 'nn-zero-or-succ j)
                      (list
                        (lambda ()
                          (dk-have! '(< 0 0) (lambda () (dk-nn! (list '= j 0) (list '<= 1 j))))
                          (ap-absurd!))
                        (lambda ()
                          (let* ((q (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f j))) (dk-asms))))
                                 (pq (list 'power 'th q)))
                            (fact 'nn-minus-in-nn j 1)
                            (dk-apply! (dk-cite! 'nn-minus-succ-1) q)
                            (cp-type! pq)
                            (dk-have! (list '= (list h j) pq)
                              (lambda () (dk-lam-b!) (subst (list '= j (list 'succ q))) (subst (list '= (list 'NN-MINUS (list 'succ q) 1) q)) (am11-rfl!)))
                            (subst (list '= (list h j) pq))
                            (let ((e1 (list '= (list '* 'th (list '* (list u i) pq)) (list '* (list u i) (list '* 'th pq)))))
                              (dk-have! e1 (lambda () (crs)))
                              (subst e1))
                            (am-pow-succ! 'th q)
                            (subst (list '= (list '* 'th pq) (list 'power 'th (list 'succ q))))
                            (subst (list '= (list 'succ q) j))
                            (fact 'nn-in-rr j) (fact 'nn-in-rr 'n)
                            (ma-or-split! (dk-apply! (dk-cite! 'rr-le-cases j 'n))
                              (list
                                (lambda ()
                                  ;; j < n: u_i th^j is a generator product
                                  (fact 'fun-apply-type-c u intw ws i)
                                  (into! (list u i) j)
                                  (ass))
                                (lambda ()
                                  ;; j = n: u_i th^n = - sum_{k < n} (c_k u_i) th^k
                                  (subst (list '= j 'n))
                                  (subst (list '= '(power th n) (list '- ps)))
                                  (let* ((ui (list u i))
                                         (gg (list 'VNB-LAMBDA 'atk_ 'NN (list '* (list '* '(c atk_) ui) '(power th atk_)))))
                                    (dk-have! (list 'IN gg '(FUN NN CC))
                                      (lambda ()
                                        (dk-lam-type!
                                          (lambda () (let ((k (dk-di-var!))) (fact 'fun-apply-type-c 'c 'NN 'CC k) (cp-type! (list 'power 'th k)) (cp-type! (list '* (list '* (list 'c k) ui) (list 'power 'th k))) (ass)))
                                          (lambda () (fact 'nn-is-set) (ass)))))
                                    (dk-have! (list 'FORALL 'amj_ (list 'IMPLIES '(IN amj_ NN) (list 'IMPLIES '(< amj_ n) (list 'IN (list gg 'amj_) us))))
                                      (lambda ()
                                        (let ((k (dk-di-var!)))
                                          (di)
                                          (fact 'fun-apply-type-c 'c 'NN 'CC k)
                                          (dk-have! (list '< k '(succ n)) (lambda () (dk-nn! (list '< k 'n))))
                                          (dk-apply! (dk-ctx-form (am19-inv '(succ n) nw u)) k i)
                                          (into! (list '* (list 'c k) ui) k)
                                          (cp-type! (list 'power 'th k))
                                          (cp-type! (list '* (list '* (list 'c k) ui) (list 'power 'th k)))
                                          (let ((leaf (proof-state-focus *ps*)))
                                            (dk-lam-b!)
                                            (if (not (sequent-node-grounded? leaf)) (ass))))))
                                    (dk-apply! (dk-cite! 'partial-sum-in-module 'n) 'aa us gg)
                                    (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '= (list gg 'cpdj_) (list '+ (list '* ui (list pf 'cpdj_)) (list '* 0 (list pf 'cpdj_))))))
                                      (lambda ()
                                        (let ((k (dk-di-var!)))
                                          (fact 'fun-apply-type-c 'c 'NN 'CC k) (cp-type! (list 'power 'th k))
                                          (dk-lam-b!)
                                          (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (crs)))))
                                    (cp-ps-typ! 'c 'th 'n)
                                    (let* ((lin (dk-apply! (dk-cite! 'cc-series-partial-sum-lincomb 'n pf pf gg ui 0)))
                                           (psg (list 'CC-SERIES-PARTIAL-SUM gg 'n))
                                           (tg (fact 'subset-mem-fwd us 'CC psg))
                                           (wg (dk-name! psg 'CC))
                                           (wf (dk-name! ps 'CC))
                                           (l2 (dk-rewrite-h! lin psg wg))
                                           (l3 (dk-rewrite-h! l2 ps wf))
                                           (m2 (dk-rewrite-h! (list 'IN psg us) psg wg)))
                                      (subst (list '= ps wf))
                                      (let ((e2 (list '= (list '* ui (list '- wf)) (list '- (list '+ (list '* ui wf) (list '* 0 wf))))))
                                        (dk-have! e2 (lambda () (crs)))
                                        (subst e2)
                                        (subst (list '= (list '+ (list '* ui wf) (list '* 0 wf)) wg))
                                        (am8-neg-in! us wg)
                                        (ass))))))))))))))
              (dk-apply! (dk-cite! 'cc-span-invariant) 'aa nb u2 'th)
              ;; U is not trivial: x0 = x0 th^0 lies in it
              (dk-have! '(< 0 n) (lambda () (dk-nn! '(<= 1 n))))
              (into! x0 0)
              (fact 'power-zero 'th)
              (fact 'subset-mem-fwd ws 'CC x0)
              (let ((m (dk-rewrite-h! (list 'IN (list '* x0 '(power th 0)) us) '(power th 0) 1)))
                (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
                (dk-apply! (dk-cite! 'cc-mul-nonzero x0 1))
                (cp-type! (list '* x0 1))
                (dk-have! (list 'FORSOME 'amnz_ (list 'AND (list 'IN 'amnz_ us) '(NOT (= amnz_ 0))))
                  (lambda () (ew (list '* x0 1)) (dk-conj-close! dk-ass!))))
              (dk-apply! (dk-cite! 'algebraic-of-invariant-module) 'aa 'th us)
              (ass))))))))
(qed 'algebraic-over-algebraic)

;;; (32) PROP. 4.24: for a subfield K of C, the field of numbers algebraic over K is algebraically closed.
;;; First: a complex root of a polynomial with coefficients algebraic over K (non-zero leading coefficient) is
;;; algebraic over K
(define am21-f '(ALGEBRAIC-NUMBERS-OVER kk))
(sp (make-wff (forall-guarded '(kk c sm z) (list '(IS-SUBFIELD-OF-CC kk) (list 'IN 'c (list 'FUN 'NN am21-f)) '(IN sm NN) '(NOT (= (c sm) 0))
                                                '(IN z CC) (list '= (cp-ps 'c 'z '(succ sm)) 0))
  (list 'IN 'z am21-f))))
(dk-peel!)
(cp-ring!)
(fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-zero-in)
(fact 'nn-succ-closed 'sm)
(let* ((fs am15-f) (sm 'sm) (ssm '(succ sm)) (ln (list 'c sm))
       (fe (list '== am21-f fs)))
  (dk-have! fe (lambda () (mac 'ALGEBRAIC-NUMBERS-OVER) (qrfl)))
  (dk-apply! (dk-cite! 'algebraic-numbers-over-subfield-field) 'kk)
  (dk-rewrite-h! (list 'IS-SUBFIELD-OF-CC am21-f) am21-f fs)
  (dk-rewrite-h! (list 'IN 'c (list 'FUN 'NN am21-f)) am21-f fs)
  (dk-project! '(IS-SUBRING-OF-CC kk) 'is-subfield-of-cc '(IS-SUBFIELD-OF-CC kk))
  (dk-project! (list 'IS-SUBRING-OF-CC fs) 'is-subfield-of-cc (list 'IS-SUBFIELD-OF-CC fs))
  (dk-project! (list 'FORALL 'ansf_ (list 'IMPLIES (list 'IN 'ansf_ fs) (list 'IMPLIES '(NOT (= ansf_ 0)) (list 'IN '(recip ansf_) fs)))) 'is-subfield-of-cc (list 'IS-SUBFIELD-OF-CC fs))
  (cp-sub-parts! fs)
  (cp-fcc! 'c fs)
  ;; a root in C
  (let* ((z 'z))
    ;; divide by the leading coefficient
    (fact 'fun-apply-type-c 'c 'NN fs sm) (fact 'fun-apply-type-c 'c 'NN 'CC sm)
    (dk-apply! (dk-ctx-form (list 'FORALL 'ansf_ (list 'IMPLIES (list 'IN 'ansf_ fs) (list 'IMPLIES '(NOT (= ansf_ 0)) (list 'IN '(recip ansf_) fs))))) ln)
    (dk-have! (list 'AND (list 'IN ln 'CC) (list 'NOT (list '= ln 0))))
    (fact 'cc-recip-inverse ln)
    (fact 'subset-mem-fwd fs 'CC (list 'recip ln))
    (let* ((rn (dk-name! (list 'recip ln) 'CC))
           (er (dk-rewrite-h! (list '= (list '* ln (list 'recip ln)) 1) (list 'recip ln) rn))
           (rk (dk-rewrite-h! (list 'IN (list 'recip ln) fs) (list 'recip ln) rn))
           (c1 (list 'VNB-LAMBDA 'atm_ 'NN (list '* rn '(c atm_)))))
      (dk-have! (list 'IN c1 (list 'FUN 'NN fs))
        (lambda ()
          (dk-lam-type!
            (lambda () (let ((k (dk-di-var!))) (fact 'fun-apply-type-c 'c 'NN fs k) (cp-mul-in! fs rn (list 'c k)) (ass)))
            (lambda () (fact 'nn-is-set) (ass)))))
      (cp-fcc! c1 fs)
      (dk-have! (cp-lcomb c1 'c 'c rn 0)
        (lambda () (let ((k (dk-di-var!))) (fact 'fun-apply-type-c 'c 'NN 'CC k) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (crs)))))
      (cp-ps-typ! 'c z ssm)
      (let ((lc (dk-apply! (dk-apply! (dk-cite! 'cc-ps-lincomb ssm 'c 'c c1 rn 0)) z)))
        (dk-have! (list '= (cp-ps c1 z ssm) 0)
          (lambda () (subst lc) (subst (list '= (cp-ps 'c z ssm) 0)) (crs))))
      (dk-have! (list '= (list c1 sm) 1)
        (lambda ()
          (dk-lam-b!)
          (let ((id (list '= (list '* rn ln) (list '* ln rn))))
            (dk-have! id (lambda () (crs)))
            (subst id)
            (ass))))
      ;; every coefficient is algebraic over K
      (dk-have! (list 'FORALL 'ati_ (list 'IMPLIES '(IN ati_ NN) (list 'IMPLIES (list '< 'ati_ ssm) (list 'IS-ALGEBRAIC-OVER 'kk (list c1 'ati_)))))
        (lambda ()
          (let ((i (dk-di-var!)))
            (di)
            (fact 'fun-apply-type-c c1 'NN fs i)
            (ma-sep-parts! (list 'IN (list c1 i) fs))
            (dk-apply! (dk-cite! 'algebraic-field-to-monic) 'kk (list c1 i))
            (ass))))
      (dk-apply! (dk-cite! 'algebraic-over-algebraic) 'kk sm c1 z)
      (dk-apply! (dk-cite! 'algebraic-ring-to-field) 'kk z)
      (subst fe)
      (in-sep! dk-ass! dk-ass!))))
(qed 'algebraic-root-in-closure)

;;; PROP. 4.24, one root: a polynomial of degree >= 1 with coefficients algebraic over K has a root algebraic over K
(sp (make-wff (forall-guarded '(kk c m) (list '(IS-SUBFIELD-OF-CC kk) (list 'IN 'c (list 'FUN 'NN am21-f)) '(IN m NN) '(NOT (= (c (succ m)) 0)))
  (list 'FORSOME 'atz_ (list 'AND (list 'IN 'atz_ am21-f) (list '= (cp-ps 'c 'atz_ '(succ (succ m))) 0))))))
(dk-peel!)
(fact 'nn-succ-closed 'm)
(dk-have! (list '== am21-f am15-f) (lambda () (mac 'ALGEBRAIC-NUMBERS-OVER) (qrfl)))
(dk-rewrite-h! (list 'IN 'c (list 'FUN 'NN am21-f)) am21-f am15-f)
(ma-sep-subset! am15-f)
(cp-fcc! 'c am15-f)
(let ((z (dk-skolem! (dk-apply! (dk-cite! 'fundamental-theorem-of-algebra) 'c 'm))))
  (dk-have! (list '= (cp-ps 'c z '(succ (succ m))) 0) (lambda () (ass)))
  (dk-apply! (dk-cite! 'algebraic-root-in-closure) 'kk 'c '(succ m) z)
  (ew z)
  (dk-conj-close! dk-ass!))
(qed 'algebraic-numbers-algebraically-closed)

;;; (33) PROP. 4.24, complete factorisation: a polynomial of degree n with coefficients algebraic over K is
;;; c(n) (z - a_0) ... (z - a_(n-1)) with every a_i algebraic over K (CH3-A's cc-poly-factorization gives the
;;; complex roots; each is a root, hence algebraic by algebraic-root-in-closure)
(define (am22-G z a) (list 'VNB-LAMBDA 'cfi_ 'NN (list '- z (list a 'cfi_))))

;;; a finite product with a zero factor is zero
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL g (IMPLIES (FORALL atk_ (IMPLIES (IN atk_ NN) (IN (g atk_) CC)))
  (FORALL atq_ (IMPLIES (IN atq_ NN) (IMPLIES (< atq_ n) (IMPLIES (= (g atq_) 0) (= (CC-PARTIAL-PROD g n) 0)))))))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (let* ((ls (dk-peel!)) (q (cadr (find-first (lambda (f) (and (dk-head-is? f '<) (eqv? (caddr f) 0))) ls))))
    (dk-have! '(< 0 0) (lambda () (dk-nn! (list '< q 0))))
    (ap-absurd!))
  (dk-focus! (cdr (assq 'step ind)))
  (let* ((ls (dk-peel!))
         (g (cadr (cadr (dk-goal))))
         (q (cadr (find-first (lambda (f) (and (dk-head-is? f '<) (equal? (caddr f) (list 'succ v)))) ls)))
         (typ (find-first (lambda (f) (dk-head-is? f 'FORALL)) ls)))
    (dk-apply! (dk-ctx-form typ) v)
    (dk-apply! (dk-cite! 'cc-partial-prod-in-cc v) g)
    (subst (dk-cite! 'cc-partial-prod-succ g v))
    (use-em (list '< q v)
      (lambda ()
        (dk-apply! (dk-apply! (dk-ctx-form ih) g) q)
        (subst (list '= (list 'CC-PARTIAL-PROD g v) 0))
        (crs))
      (lambda ()
        (fact 'nn-in-rr q) (fact 'nn-in-rr v)
        (dk-have! (list '= q v)
          (lambda ()
            (ma-or-split! (dk-apply! (dk-cite! 'rr-lt-trichotomy q v))
              (list (lambda () (ma-prop-with! (list (list '< q v) (list 'NOT (list '< q v)))))
                    (lambda () (ass))
                    (lambda ()
                      (dk-apply! (dk-cite! 'nn-lt-succ-le v q))
                      (dk-have! '(< 0 0) (lambda () (dk-nn! (list '<= (list 'succ v) q) (list '< q (list 'succ v)))))
                      (ap-absurd!))))))
        (dk-rewrite-h! (list '= (list g q) 0) q v)
        (subst (list '= (list g v) 0))
        (crs)))))
(qed 'cc-partial-prod-zero-factor)

(sp (make-wff (forall-guarded '(kk c n) (list '(IS-SUBFIELD-OF-CC kk) (list 'IN 'c (list 'FUN 'NN am21-f)) '(IN n NN) (cp-van 'c '(succ n)) '(NOT (= (c n) 0)))
  (list 'FORSOME 'atr_ (list 'AND '(IN atr_ (FUN NN CC))
    (list 'AND (list 'FORALL 'ati_ (list 'IMPLIES '(IN ati_ NN) (list 'IMPLIES '(< ati_ n) (list 'IN '(atr_ ati_) am21-f))))
               (list 'FORALL 'atz_ (list 'IMPLIES '(IN atz_ CC)
                 (list '= (cp-ps 'c 'atz_ '(succ n)) (list '* '(c n) (list 'CC-PARTIAL-PROD (am22-G 'atz_ 'atr_) 'n)))))))))))
(dk-peel!)
(fact 'nn-succ-closed 'n)
(fact 'cc-zero-in)
(dk-have! (list '== am21-f am15-f) (lambda () (mac 'ALGEBRAIC-NUMBERS-OVER) (qrfl)))
(dk-rewrite-h! (list 'IN 'c (list 'FUN 'NN am21-f)) am21-f am15-f)
(ma-sep-subset! am15-f)
(cp-fcc! 'c am15-f)
(fact 'fun-apply-type-c 'c 'NN 'CC 'n)
(let* ((ra (dk-skolem! (dk-apply! (dk-cite! 'cc-poly-factorization 'n) 'c)))
       (idf (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'CC-PARTIAL-PROD) (dk-contains? f ra))) (dk-asms))))
  (dk-have! (list 'FORALL 'ati_ (list 'IMPLIES '(IN ati_ NN) (list 'IMPLIES '(< ati_ n) (list 'IN (list ra 'ati_) am21-f))))
    (lambda ()
      (let* ((i (dk-di-var!)))
        (di)
        (let* ((z (list ra i)) (g (am22-G z ra)) (pr (list 'CC-PARTIAL-PROD g 'n)))
          (fact 'fun-apply-type-c ra 'NN 'CC i)
          (dk-have! (list 'FORALL 'atk_ (list 'IMPLIES '(IN atk_ NN) (list 'IN (list g 'atk_) 'CC)))
            (lambda ()
              (let ((k (dk-di-var!)))
                (fact 'fun-apply-type-c ra 'NN 'CC k)
                (cp-type! (list '- z (list ra k)))
                (let ((leaf (proof-state-focus *ps*)))
                  (dk-lam-b!)
                  (if (not (sequent-node-grounded? leaf)) (ass))))))
          (dk-have! (list '= (list g i) 0) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (crs)))))
          (dk-apply! (dk-apply! (dk-cite! 'cc-partial-prod-zero-factor 'n) g) i)
          (let* ((e (dk-apply! (dk-ctx-form idf) z))
                 (e2 (dk-rewrite-h! e pr 0)))
            (dk-have! (list '= (cp-ps 'c z '(succ n)) 0)
              (lambda () (subst e2) (crs))))
          (dk-apply! (dk-cite! 'algebraic-root-in-closure) 'kk 'c 'n z)
          (ass)))))
  (ew ra)
  (dk-conj-close! dk-ass!))
(qed 'algebraic-numbers-factorization)
