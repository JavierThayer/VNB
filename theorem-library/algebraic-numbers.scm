;;; (14) PROP. 4.18, module => algebraic: r V in V for a non-trivial finitely generated A-module V makes r a root
;;; of a monic polynomial over A
(define am-nontriv '(FORSOME amnz_ (AND (IN amnz_ vv) (NOT (= amnz_ 0)))))
(define am-inv '(FORALL amrv_ (IMPLIES (IN amrv_ vv) (IN (* r amrv_) vv))))
(define (am-span n g) (list 'FORALL 'amv_ (list 'IMPLIES '(IN amv_ vv)
  (list 'FORSOME 'amb_ (list 'AND (list 'IN 'amb_ (list 'FUN (list 'INTERVAL 1 n) 'aa)) (list '= 'amv_ (list 'CC-LINCOMB n 'amb_ g)))))))
