            (dk-apply! (dk-cite! 'module-preimage-mul) 'aa us gk)
            (dk-have! (list 'IN u (list 'FUN intw sv))
              (lambda ()
                (mac 'fun-codomain-iff)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-head-is? (dk-goal) 'FORALL)
                        (let ((kv (dk-di-var!)))
