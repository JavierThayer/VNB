              (ew nb)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin
                        (ew u2)
                        (dk-conj-close!
                          (lambda ()
                            (cond ((dk-ass!) #t)
                                  ((dk-head-is? (dk-goal) 'FORSOME) (ew (list '* x0 gk)) (dk-conj-close! dk-ass!))
                                  (#t #f)))))))))))))))
(qed 'algebraic-tower-module)

;;; (31) toward PROP. 4.24: a root of a monic polynomial whose coefficients are algebraic over A is algebraic
;;; over A (the products u_i theta^b, i over the tower's generators, b < n, span a theta-invariant module)
(sp (make-wff (forall-guarded '(aa n c th)
  (list '(IS-SUBRING-OF-CC aa) '(IN n NN) '(IN c (FUN NN CC)) (am19-alg-below '(succ n)) '(= (c n) 1) '(IN th CC)
        (list '= (cp-ps 'c 'th '(succ n)) 0))
  '(IS-ALGEBRAIC-OVER aa th))))
(dk-peel!)
(cp-ring!)
(am-carr-ag!)
(cp-sub-parts! 'aa)
(fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-one-in) (fact 'nn-zero-in)
(fact 'nn-succ-closed 'n)
(let* ((pf (list 'VNB-LAMBDA 'pfj_ 'NN '(* (c pfj_) (power th pfj_))))
       (ps (cp-ps 'c 'th 'n)))
  (fact 'fun-apply-type-c 'c 'NN 'CC 'n)
  (cp-type! '(power th n))
  (cp-ps-typ! 'c 'th 'n)
  (dk-have! (list 'IN (list pf 'n) 'CC) (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-type! (cadr (dk-goal)) 'CC))))
  ;; th^n = - sum_{k < n} c(k) th^k
  (dk-apply! (dk-cite! 'cc-series-partial-sum-succ pf) 'n)
  (dk-have! (list '= '(power th n) (list '- ps))
    (lambda ()
