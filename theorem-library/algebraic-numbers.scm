  (cp-sub-parts! 'kk))

;;; the converse half of 4.22, from the counted 4.18
(sp (make-wff (forall-guarded '(aa r vv ndim) (list '(IS-SUBRING-OF-CC aa) '(IN r CC) '(IN ndim NN) '(IS-CC-SPACE-DIM-LE aa vv ndim) am-nontriv am-inv)
  '(IS-ALGEBRAIC-OF-DEGREE-LE aa r ndim))))
(dk-peel!)
(let* ((n (dk-skolem! (dk-apply! (dk-cite! 'algebraic-monic-of-invariant-space) 'aa 'r 'vv 'ndim)))
       (c (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'anac_) (dk-contains? f n))) (dk-asms)))))
  (dk-have! (list 'NOT (list '= (list c n) 0))
    (lambda ()
      (di)
      (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
      (let ((h (dk-rewrite-h! (list '= (list c n) 0) (list c n) 1)))
        (ma-prop-with! (list h '(NOT (= 1 0)))))))
  (mac 'is-algebraic-of-degree-le)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin (ew n) (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew c) (dk-conj-close! dk-ass!))))))))))
(qed 'algebraic-degree-of-invariant-space)

;;; dividing by the leading coefficient, the degree kept
(sp (make-wff (forall-guarded '(kk m c x)
  (list '(IS-SUBFIELD-OF-CC kk) '(IN m NN) '(IN c (FUN NN kk)) (cp-van 'c '(succ m)) '(NOT (= (c m) 0)) '(IN x CC) (list '= (cp-ps 'c 'x '(succ m)) 0))
  (list 'FORSOME 'anmc_ (list 'AND '(IN anmc_ (FUN NN kk)) (list 'AND (cp-van 'anmc_ '(succ m)) (list 'AND '(= (anmc_ m) 1) (list '= (cp-ps 'anmc_ 'x '(succ m)) 0))))))))
(dk-peel!)
(cp-ring!)
(am18-sub-parts!)
(fact 'cc-zero-in) (fact 'cc-one-in)
(let* ((n 'm) (c 'c) (ln (list c n)) (sn (list 'succ n)))
  (fact 'nn-succ-closed n)
  (cp-fcc! c 'kk)
