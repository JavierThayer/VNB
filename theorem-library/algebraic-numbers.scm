    (let* ((mv (am9-module! al)) (vv1 (car mv)) (n (cadr mv)) (g (caddr mv)) (k0 (cadddr mv)))
      (dk-have! (list '<= n n) (lambda () (dk-nn!)))
      (let* ((px (dk-apply! (dk-cite! 'product-generators-exist) n 'aa n nw g u))
             (nb (dk-skolem! px))
             (u2 (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'apu_) (dk-contains? f nb))) (dk-asms))))
             (afm (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'apt_) (dk-contains? f u2))) (dk-asms)))
             (bfm (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'api_) (dk-contains? f u2))) (dk-asms)))
             (intn (am-int n)) (intw (am-int nw)) (intb (am-int nb))
             (us (am19-span nb u2)))
        (dk-split-all! (list (dk-apply! (dk-cite! 'cc-span-module) 'aa nb u2)))
        (am9-fg-open! 'aa us)
        ;; every g_l u_t is in U2, and every u_t g_l
        (dk-have! (am9-gh-in n nw g u us)
          (lambda ()
            (dk-peel!)
            (let* ((lj (am9-goal-pair)) (l (car lj)) (j (cadr lj)))
              (fact 'fun-apply-type-c g intn 'CC l) (fact 'fun-apply-type-c u intw 'CC j)
