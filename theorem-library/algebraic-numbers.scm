  (let* ((rn (dk-name! (list 'recip ln) 'CC))
         (er (dk-rewrite-h! (list '= (list '* ln (list 'recip ln)) 1) (list 'recip ln) rn))
         (rk (dk-rewrite-h! (list 'IN (list 'recip ln) 'kk) (list 'recip ln) rn))
         (c1 (list 'VNB-LAMBDA 'anmk_ 'NN (list '* rn (list c 'anmk_)))))
    (dk-have! (list 'IN c1 '(FUN NN kk))
      (lambda ()
        (dk-lam-type!
          (lambda () (let ((k (dk-di-var!))) (fact 'fun-apply-type-c c 'NN 'kk k) (cp-mul-in! 'kk rn (list c k)) (ass)))
          (lambda () (fact 'nn-is-set) (ass)))))
    (cp-fcc! c1 'kk)
    (dk-have! (cp-van c1 sn)
      (lambda ()
        (dk-peel!)
        (let ((k (cadr (cadr (dk-goal)))))
          (fact 'fun-apply-type-c c 'NN 'CC k)
          (dk-apply! (dk-ctx-form (cp-van c sn)) k)
          (dk-lam-b!)
          (subst (list '= (list c k) 0))
          (crs))))
    (dk-have! (list '= (list c1 n) 1)
      (lambda ()
        (dk-lam-b!)
        (let ((id (list '= (list '* rn ln) (list '* ln rn))))
          (dk-have! id (lambda () (crs)))
          (subst id)
          (ass))))
    (dk-have! (cp-lcomb c1 c c rn 0)
      (lambda () (let ((k (dk-di-var!))) (fact 'fun-apply-type-c c 'NN 'CC k) (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (crs)))))
    (cp-ps-typ! c 'x sn)
    (let ((lc (dk-apply! (dk-apply! (dk-cite! 'cc-ps-lincomb sn c c c1 rn 0)) 'x)))
      (dk-have! (list '= (cp-ps c1 'x sn) 0)
        (lambda () (subst lc) (subst (list '= (cp-ps c 'x sn) 0)) (crs))))
    (ew c1)
    (dk-conj-close! dk-ass!)))
(qed 'monic-of-leading)

;;; a bound on the dimension can be raised
(define (am18-dim-body kk vs n)
  (list 'FORSOME 'amn_ (list 'AND '(IN amn_ NN) (list 'AND (list '<= 'amn_ n)
    (list 'FORSOME 'amg_ (list 'AND (list 'IN 'amg_ (list 'FUN '(INTERVAL 1 amn_) vs))
      (list 'FORALL 'amv_ (list 'IMPLIES (list 'IN 'amv_ vs)
        (list 'FORSOME 'amb_ (list 'AND (list 'IN 'amb_ (list 'FUN '(INTERVAL 1 amn_) kk)) '(= amv_ (CC-LINCOMB amn_ amb_ amg_))))))))))))
(sp (make-wff (forall-guarded '(kk vv m n) '((IN m NN) (IN n NN) (<= m n) (IS-CC-SPACE-DIM-LE kk vv m)) '(IS-CC-SPACE-DIM-LE kk vv n))))
(dk-peel!)
(dk-project! '(IS-CC-MODULE-OVER kk vv) 'is-cc-space-dim-le '(IS-CC-SPACE-DIM-LE kk vv m))
(let* ((k (dk-skolem! (dk-project! (am18-dim-body 'kk 'vv 'm) 'is-cc-space-dim-le '(IS-CC-SPACE-DIM-LE kk vv m))))
       (g (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'amg_) (dk-contains? f k))) (dk-asms)))))
  (mac 'is-cc-space-dim-le)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (begin
            (ew k)
            (dk-conj-close!
              (lambda ()
                (cond ((dk-ass!) #t)
                      ((dk-head-is? (dk-goal) '<=) (dk-nn! (list '<= k 'm) '(<= m n)))
                      (#t (ew g) (dk-conj-close! dk-ass!))))))))))
(qed 'cc-space-dim-le-mono)

(define am18-nontriv '(FORSOME amnz_ (AND (IN amnz_ vv) (NOT (= amnz_ 0)))))
(define am18-inv '(FORALL amrv_ (IMPLIES (IN amrv_ vv) (IN (* th amrv_) vv))))
(define am18-deg-body
  (list 'FORSOME 'anan_ (list 'AND '(IN anan_ NN) (list 'AND '(<= anan_ n)
    (list 'FORSOME 'anac_ (list 'AND '(IN anac_ (FUN NN kk))
      (list 'AND (cp-van 'anac_ '(succ anan_))
        (list 'AND '(NOT (= (anac_ anan_) 0)) (list '= (cp-ps 'anac_ 'th '(succ anan_)) 0)))))))))
(sp (make-wff (forall-guarded '(kk th n) '((IS-SUBFIELD-OF-CC kk) (IN th CC) (IN n NN))
  (list 'IFF '(IS-ALGEBRAIC-OF-DEGREE-LE kk th n)
             (list 'FORSOME 'vv (list 'AND '(IS-CC-SPACE-DIM-LE kk vv n) (list 'AND am18-nontriv am18-inv)))))))
(dk-peel!)
(dk-project! '(IS-SUBRING-OF-CC kk) 'is-subfield-of-cc '(IS-SUBFIELD-OF-CC kk))
(dk-iff! (lambda (g) (dk-head-is? g 'FORSOME))
  (lambda ()
    (let* ((m (dk-skolem! (dk-project! am18-deg-body 'is-algebraic-of-degree-le '(IS-ALGEBRAIC-OF-DEGREE-LE kk th n))))
           (c (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'anac_) (dk-contains? f m))) (dk-asms))))
           (c1 (dk-skolem! (dk-apply! (dk-cite! 'monic-of-leading) 'kk m c 'th)))
           (v (dk-skolem! (dk-apply! (dk-cite! 'invariant-space-of-relation) 'kk 'th m c1))))
      (dk-apply! (dk-cite! 'cc-space-dim-le-mono) 'kk v m 'n)
      (ew v)
      (dk-conj-close! dk-ass!)))
  (lambda ()
    (let ((v (dk-skolem! (dk-ctx-form (list 'FORSOME 'vv (list 'AND '(IS-CC-SPACE-DIM-LE kk vv n) (list 'AND am18-nontriv am18-inv)))))))
      (dk-apply! (dk-cite! 'algebraic-degree-of-invariant-space) 'kk 'th v 'n)
      (ass))))
(qed 'algebraic-degree-iff-invariant-space)

;;; (30) toward PROP. 4.24: a partial sum of members of an A-module is in it; a non-trivial finitely generated
;;; A-module invariant under finitely many numbers algebraic over A (the tower of product modules)
(sp (make-wff (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
  (forall-guarded '(aa vv f) '((IS-CC-MODULE-OVER aa vv) (IN f (FUN NN CC)) (FORALL amj_ (IMPLIES (IN amj_ NN) (IMPLIES (< amj_ k) (IN (f amj_) vv)))))
    '(IN (CC-SERIES-PARTIAL-SUM f k) vv))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (am8-mod-parts! 'aa 'vv)
  (subst (dk-cite! 'cc-series-partial-sum-zero 'f))
  (ass)
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (am8-mod-parts! 'aa 'vv)
  (fact 'nn-succ-closed v)
  (let ((hk (list 'FORALL 'amj_ (list 'IMPLIES '(IN amj_ NN) (list 'IMPLIES (list '< 'amj_ (list 'succ v)) '(IN (f amj_) vv))))))
    (dk-have! (list 'FORALL 'amj_ (list 'IMPLIES '(IN amj_ NN) (list 'IMPLIES (list '< 'amj_ v) '(IN (f amj_) vv))))
      (lambda ()
        (let ((j (dk-di-var!)))
          (di)
          (dk-have! (list '< j (list 'succ v)) (lambda () (dk-nn! (list '< j v))))
          (dk-apply! (dk-ctx-form hk) j)
          (ass))))
    (dk-apply! (dk-ctx-form ih) 'aa 'vv 'f)
    (dk-have! (list '< v (list 'succ v)) (lambda () (dk-nn!)))
    (dk-apply! (dk-ctx-form hk) v))
  (fact 'fun-apply-type-c 'f 'NN 'CC v)
  (dk-cite! 'cc-series-partial-sum-in-cc v 'f)
  (dk-apply! (dk-cite! 'cc-series-partial-sum-succ 'f) v)
  (subst (list '== (list 'CC-SERIES-PARTIAL-SUM 'f (list 'succ v)) (list '+ (list 'CC-SERIES-PARTIAL-SUM 'f v) (list 'f v))))
  (am8-add-in! 'vv (list 'CC-SERIES-PARTIAL-SUM 'f v) (list 'f v))
  (ass))
(qed 'partial-sum-in-module)

;;; the tower: for c_0, ..., c_(j-1) algebraic over A, a non-trivial A-span of finitely many numbers invariant
;;; under multiplication by each c_i
(define (am19-span n u) (am-vspan n u))
(define (am19-nontriv n u) (list 'FORSOME 'atz_ (list 'AND (list 'IN 'atz_ (am19-span n u)) '(NOT (= atz_ 0)))))
(define (am19-inv j n u)
  (list 'FORALL 'ati_ (list 'IMPLIES '(IN ati_ NN) (list 'IMPLIES (list '< 'ati_ j)
    (list 'FORALL 'att_ (list 'IMPLIES (list 'IN 'att_ (am-int n)) (list 'IN (list '* '(c ati_) (list u 'att_)) (am19-span n u))))))))
(define (am19-body j)
  (list 'FORSOME 'atn_ (list 'AND '(IN atn_ NN)
    (list 'FORSOME 'atu_ (list 'AND '(IN atu_ (FUN (INTERVAL 1 atn_) CC))
      (list 'AND (am19-nontriv 'atn_ 'atu_) (am19-inv j 'atn_ 'atu_)))))))
(define (am19-alg-below j) (list 'FORALL 'ati_ (list 'IMPLIES '(IN ati_ NN) (list 'IMPLIES (list '< 'ati_ j) '(IS-ALGEBRAIC-OVER aa (c ati_))))))
(define (am19-span-form n u)
  ;; every member of span(n, u) is a combination of u
  (list 'FORALL 'amv_ (list 'IMPLIES (list 'IN 'amv_ (am19-span n u))
    (list 'FORSOME 'amb_ (list 'AND (list 'IN 'amb_ (list 'FUN (am-int n) 'aa)) (list '= 'amv_ (list 'CC-LINCOMB n 'amb_ u)))))))
(define (am19-span-form! n u)
  (dk-have! (am19-span-form n u)
    (lambda () (let ((x (dk-di-var!))) (ma-sep-parts! (list 'IN x (am19-span n u))) (ass)))))
(define (am19-pair) (let ((gp (caddr (cadr (dk-goal))))) (list (cadr (cadr gp)) (cadr (caddr gp)))))

(sp (make-wff (list 'FORALL 'j (list 'IMPLIES '(IN j NN)
  (forall-guarded '(aa c) (list '(IS-SUBRING-OF-CC aa) '(IN c (FUN NN CC)) (am19-alg-below 'j)) (am19-body 'j))))))
(let* ((ind (use-induction)) (v (cdr (assq 'var ind))) (ih (cdr (assq 'ih ind))))
  ;; j = 0: the span of the number 1
  (dk-focus! (cdr (assq 'base ind)))
  (dk-peel!)
  (cp-ring!)
  (am-carr-ag!)
  (cp-sub-parts! 'aa)
  (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-one-in) (fact 'nn-zero-in)
  (fact 'interval-in-set 1 1)
  (let* ((int (am-int 1)) (u (list 'VNB-LAMBDA 'atw_ int 1)) (us (am19-span 1 u)))
    (dk-have! (list 'IN u (list 'FUN int 'CC)) (lambda () (dk-lam-type! (lambda () (dk-di-var!) (ass)) (lambda () (ass)))))
    (dk-split-all! (list (dk-apply! (dk-cite! 'cc-span-module) 'aa 1 u)))
    (dk-have! '(<= 1 1) (lambda () (dk-nn!)))
    (dk-apply! (dk-cite! 'interval-mem-intro 1 1 1))
    (fact 'fun-apply-type-c u int us 1)
    (dk-have! (list '= (list u 1) 1) (lambda () (dk-lam-b!) (am11-rfl!)))
    (dk-rewrite-h! (list 'IN (list u 1) us) (list u 1) 1)
    (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
    (ew 1)
    (dk-conj-close!
      (lambda ()
        (cond ((dk-ass!) #t)
              ((dk-head-is? (dk-goal) 'FORSOME)
               (ew u)
               (dk-conj-close!
                 (lambda ()
                   (cond ((dk-ass!) #t)
                         ((dk-head-is? (dk-goal) 'FORSOME) (ew 1) (dk-conj-close! dk-ass!))
                         (#t
                          (dk-peel!)
                          (let ((i (cadr (cadr (cadr (dk-goal))))))
                            (dk-have! '(< 0 0) (lambda () (dk-nn! (list '< i 0))))
                            (ap-absurd!)))))))
              (#t #f)))))
  ;; j + 1
  (dk-focus! (cdr (assq 'step ind)))
  (dk-peel!)
  (cp-ring!)
  (am-carr-ag!)
  (cp-sub-parts! 'aa)
  (fact 'cc-zero-in) (fact 'cc-one-in) (fact 'nn-one-in)
  (fact 'nn-succ-closed v)
  (let ((hb (am19-alg-below (list 'succ v))))
    (dk-have! (am19-alg-below v)
