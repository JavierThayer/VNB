;;; ---- RPOW-STAR is decreasing in the exponent for a base 0 < r < 1 ----
(sp (make-wff '(FORALL rq_ (IMPLIES (IN rq_ RR) (IMPLIES (< 0 rq_) (IMPLIES (< rq_ 1)
