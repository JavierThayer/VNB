;;; ---- the lowest coefficient of a product ----
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_)
   ,(c3v-all 'fq_ (c3v-funk 'kq_) (c3v-all 'gq_ (c3v-funk 'kq_) (c3v-all 'pq_ 'ZZ (c3v-all 'qr_ 'ZZ
      `(IMPLIES ,(c3v-below 'kq_ 'fq_ 'pq_) (IMPLIES ,(c3v-below 'kq_ 'gq_ 'qr_)
         (= (,(c3v-mm 'kq_ 'fq_ 'gq_) (+ pq_ qr_)) ((MUL kq_) (fq_ pq_) (gq_ qr_)))))))))))))
(dk-peel!)
(let* ((k 'kq_) (f 'fq_) (g 'gq_) (p 'pq_) (q 'qr_) (n '(+ pq_ qr_)))
  (dk-cite! 'zz-in-rr p) (dk-cite! 'zz-in-rr q)
  (dk-have-and! `(IN ,p ZZ) `(IN ,q ZZ))
  (dk-cite! 'zz-add-closed p q)
  (dk-have! `(= ,n ,n) (lambda () (c3v-rfl!)))
  (dk-have! (c3v-single-hyp k f g n p)
    (lambda ()
      (dk-peel!)
      (let* ((ps (find-first (lambda (v) (dk-asm? `(NOT (= ,v ,p)))) (map cadr (filter (lambda (h) (dk-head-is? h 'IN)) (dk-asms)))))
             (qs (caddr (cadr (find-first (lambda (h) (and (dk-head-is? h '=) (equal? (caddr h) n) (dk-head-is? (cadr h) '+)
                                                          (eq? (cadr (cadr h)) ps))) (dk-asms))))))
        (dk-cite! 'zz-in-rr ps) (dk-cite! 'zz-in-rr qs)
        (use-em `(< ,ps ,p)
          (lambda () (oi-l) (dk-chain-ass! (dk-apply! (c3v-below k f p) ps)) (dk-close-if-asm!))
          (lambda ()
            (dk-chain-ass! (dk-cite! 'rr-not-lt-ge ps p))
            (dk-have! `(< ,qs ,q)
              (lambda ()
                (dk-have! `(< ,p ,ps)
                  (lambda ()
                    (pbc)
                    (dk-chain-ass! (dk-cite! 'rr-not-lt-ge p ps))
                    (dk-have-and! `(IN ,ps RR) `(IN ,p RR))
                    (dk-have-and! `(<= ,ps ,p) `(<= ,p ,ps))
                    (dk-chain-ass! (dk-cite! 'rr-leq-antisymmetric ps p))
                    (ai `(NOT (= ,ps ,p)))))
                (dk-ineq! `(= (+ ,ps ,qs) ,n) `(< ,p ,ps))))
            (oi-r) (dk-chain-ass! (dk-apply! (c3v-below k g q) qs)) (dk-close-if-asm!))))))
  (use-em `(<= ,p ,q)
    (lambda ()
      (dk-chain-ass! (dk-cite! 'laurent-below-mono k g q p))
      (dk-chain-ass! (dk-cite! 'laurent-mul-single k f g p p q n))
      (dk-close-if-asm!))
    (lambda ()
      (dk-chain-ass! (dk-cite! 'rr-not-le-lt p q))
      (dk-have! `(<= ,q ,p) (lambda () (dk-ineq! `(< ,q ,p))))
      (dk-chain-ass! (dk-cite! 'laurent-below-mono k f p q))
      (dk-chain-ass! (dk-cite! 'laurent-mul-single k f g q p q n))
