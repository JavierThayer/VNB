    (lambda ()
      (use-em `(= ,g ,c3v-lz)
        (lambda ()
          (subst `(= ,g ,c3v-lz))
          (subst (dk-cite! 'laurent-mul-comm k f c3v-lz))
          (subst (dk-cite! 'laurent-mul-zero-left k f))
          (subst (dk-cite! 'laurent-abs-zero k r))
          (crs))
        (lambda ()
          (dk-chain-ass! (dk-cite! 'laurent-ord-mul-eq k f g))
          (dk-split-all!)
          (for-each (lambda (x) (dk-chain-ass! (dk-cite! 'laurent-abs-nonzero k r x)) (dk-split-all!)) (list fg f g))
          (let* ((o1 (c3v-ord! k f)) (o2 (c3v-ord! k g)))
            (subst `(= ,(c3v-abs k r fg) (RPOW-STAR ,r (LAURENT-ORD ,k ,fg))))
            (subst `(= ,(c3v-abs k r f) (RPOW-STAR ,r (LAURENT-ORD ,k ,f))))
            (subst `(= ,(c3v-abs k r g) (RPOW-STAR ,r (LAURENT-ORD ,k ,g))))
