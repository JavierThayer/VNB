         (le (list 'VNB-LAMBDA (cadr l) 'EMPTY-SET (cadddr l))))
    (dk-have! `(FORALL xcq_ (IFF (IN xcq_ ,i) (IN xcq_ EMPTY-SET)))
      (lambda ()
        (let ((x (dk-di-var! (lambda (gl) (cadr (cadr gl))))))
          (dk-iff! (lambda (gl) (equal? (caddr gl) 'EMPTY-SET))
            (lambda ()
              (sep-me `(IN ,x ,i))
              (let ((x1 `(NTH 1 ,x)) (x2 `(NTH 2 ,x)))
                (dk-fact-split! 'cartesian-nth x sf sg)
                (c3v-coord! k f x1) (c3v-coord! k g x2)
                (dk-chain-ass! (dk-cite! 'zz-add-monoid-opr x1 x2))
                (dk-rewrite-h! `(= ((OPR ZZ-ADD-MONOID) ,x1 ,x2) ,n) `((OPR ZZ-ADD-MONOID) ,x1 ,x2) `(+ ,x1 ,x2))
                (for-each
                  (lambda (fn xi bd)
                    (dk-have! `(<= ,bd ,xi)
                      (lambda ()
                        (pbc)
