  (dk-cite! 'zz-add-monoid-is-monoid)
  (dk-cite! 'zz-add-monoid-carr)
  (if (not (dk-asm? '(IN (CARR ZZ-ADD-MONOID) SET)))
      (dk-have! '(IN (CARR ZZ-ADD-MONOID) SET) (lambda () (subst '(= (CARR ZZ-ADD-MONOID) ZZ)) (dk-close-if-asm!)))))
(define (c3v-lt-var b)
  (find-first (lambda (v) (dk-asm? `(< ,v ,b))) (map cadr (filter (lambda (h) (dk-head-is? h '<)) (dk-asms)))))

;;; ---- the product of f vanishing below p and g vanishing below q vanishes below p + q ----
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_)
   ,(c3v-all 'fq_ (c3v-funk 'kq_) (c3v-all 'gq_ (c3v-funk 'kq_) (c3v-all 'pq_ 'ZZ (c3v-all 'qr_ 'ZZ
      `(IMPLIES ,(c3v-below 'kq_ 'fq_ 'pq_) (IMPLIES ,(c3v-below 'kq_ 'gq_ 'qr_)
         ,(c3v-below 'kq_ (c3v-mm 'kq_ 'fq_ 'gq_) '(+ pq_ qr_))))))))))))
(dk-peel!)
(let* ((k 'kq_) (f 'fq_) (g 'gq_) (p 'pq_) (q 'qr_)
       (n (c3v-lt-var '(+ pq_ qr_)))
       (sf `(SUPP ,k ZZ-ADD-MONOID ,f)) (sg `(SUPP ,k ZZ-ADD-MONOID ,g))
       (ag `(RING-ADDITIVE-AG ,k)))
  (c3v-zfacts!)
  (c3v-inz! n)
  (for-each (lambda (v) (dk-cite! 'zz-in-rr v)) (list p q n))
  (dk-cite! 'ring-zero-in k)
  (let* ((inst (dk-cite! 'monalg-mul-apply k c3v-Z f g n))
