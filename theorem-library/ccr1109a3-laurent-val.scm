            (let ((ps (find-first (lambda (x) (dk-asm? `(NOT (= ,x 0)))) (map cadr (filter (lambda (h) (dk-head-is? h 'IN)) (dk-asms))))))
              (subst (dk-cite! 'laurent-zero-apply k ps)) (c3v-rfl!))))
        (subst (dk-chain-ass! (dk-cite! 'laurent-mul-single k z g b 0 v v)))
        (subst (dk-cite! 'laurent-zero-apply k 0))
        (subst (dk-cite! 'laurent-zero-apply k v))
        (c3v-app! k g v)
        (subst (dk-cite! 'ring-mul-zero-left k `(,g ,v)))
        (c3v-rfl!)))))
