;;; ---- f g /= 0 and ord(f g) = ord f + ord g, through LAURENT-ORD ----
(define (c3v-ord! k f)
  ;; f in LAURENT-SET, f /= 0 in context: return the order o, with ordp(f, o) split in context and (= (LAURENT-ORD k f) o)
  (let ((o (dk-skolem! (dk-chain-ass! (dk-cite! 'laurent-nonzero-ord k f)))))
    (dk-have! (c3v-ordp k f o) (lambda () (prop)))
    (dk-chain-ass! (dk-cite! 'laurent-ord-eq k f o))
    (for-each (lambda (c) (if (not (dk-asm? c)) (dk-have! c (lambda () (prop)))))
              (list `(IN ,o ZZ) `(NOT (= (,f ,o) (ZERO ,k))) (c3v-below k f o)))
    (dk-cite! 'zz-in-rr o)
    o))
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-INTEGRAL-DOMAIN kq_) ,(c3v-all 'fq_ '(LAURENT-SET kq_) (c3v-all 'gq_ '(LAURENT-SET kq_)
   '(IMPLIES (NOT (= fq_ (LAURENT-ZERO kq_))) (IMPLIES (NOT (= gq_ (LAURENT-ZERO kq_)))
      (AND (NOT (= (LAURENT-MUL kq_ fq_ gq_) (LAURENT-ZERO kq_)))
           (= (LAURENT-ORD kq_ (LAURENT-MUL kq_ fq_ gq_)) (+ (LAURENT-ORD kq_ fq_) (LAURENT-ORD kq_ gq_))))))))))))
(dk-peel!)
(let* ((k 'kq_) (f 'fq_) (g 'gq_) (fg '(LAURENT-MUL kq_ fq_ gq_)))
  (dk-chain-ass! (dk-cite! 'integral-domain-is-commutative-ring k))
  (dk-chain-ass! (dk-cite! 'commutative-ring-is-ring k))
  (dk-cite! 'ring-zero-in k)
  (let* ((o1 (c3v-ord! k f)) (o2 (c3v-ord! k g)) (n `(+ ,o1 ,o2)))
    (dk-have! (c3v-ordp k f o1) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (dk-have! (c3v-ordp k g o2) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (dk-chain-ass! (dk-cite! 'laurent-ord-mul k f g o1 o2))
    (dk-chain-ass! (dk-cite! 'laurent-ord-eq k fg n))
    (for-each (lambda (c) (if (not (dk-asm? c)) (dk-have! c (lambda () (prop)))))
              (list `(NOT (= (,fg ,n) (ZERO ,k)))))
    (dk-have-and! `(IN ,o1 ZZ) `(IN ,o2 ZZ))
    (dk-cite! 'zz-add-closed o1 o2)
    (dk-have! `(NOT (= ,fg (LAURENT-ZERO ,k)))
      (lambda ()
        (di)
        (dk-rewrite-h! `(NOT (= (,fg ,n) (ZERO ,k))) fg '(LAURENT-ZERO kq_))
        (dk-cite! 'laurent-zero-apply k n)
        (dk-rewrite-h! `(NOT (= ((LAURENT-ZERO kq_) ,n) (ZERO ,k))) `((LAURENT-ZERO kq_) ,n) `(ZERO ,k))
        (dk-have! `(= (ZERO ,k) (ZERO ,k)) (lambda () (c3v-rfl!)))
        (ai `(NOT (= (ZERO ,k) (ZERO ,k))))))
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
            (begin
              (subst `(= (LAURENT-ORD ,k ,fg) ,n))
              (subst `(= (LAURENT-ORD ,k ,f) ,o1))
              (subst `(= (LAURENT-ORD ,k ,g) ,o2))
              (c3v-rfl!)))))))
(qed 'laurent-ord-mul-eq)

;; 0 * g = 0
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) ,(c3v-all 'gq_ '(LAURENT-SET kq_)
   '(= (LAURENT-MUL kq_ (LAURENT-ZERO kq_) gq_) (LAURENT-ZERO kq_)))))))
(dk-peel!)
(let* ((k 'kq_) (g 'gq_) (z '(LAURENT-ZERO kq_)))
  (dk-cite! 'ring-zero-in k)
  (dk-cite! 'laurent-zero-in k)
  (for-each (lambda (x)
              (dk-chain-ass! (dk-cite! 'laurent-set-out k x))
              (dk-split! (dk-pick (lambda (h) (and (dk-head-is? h 'AND) (equal? (cadr h) `(IN ,x ,(c3v-funk k))))) "laurent-set-out")))
            (list g z))
  (let* ((b (dk-skolem! (dk-chain-ass! (dk-cite! 'laurent-bound-le k g 0)))))
