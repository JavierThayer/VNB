            (subst `(= (LAURENT-ORD ,k ,f) ,o1))
            (subst `(= (LAURENT-ORD ,k ,g) ,o2))
            (dk-chain-ass! (dk-cite! 'rpow-star-add r o1 o2))
            (dk-close-if-asm!)))))))
(qed 'laurent-abs-mul)

;; |f + g| <= max(|f|, |g|)  (0 < r < 1)
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) ,(c3v-all 'rq_ 'RR `(IMPLIES (< 0 rq_) (IMPLIES (< rq_ 1)
   ,(c3v-all 'fq_ '(LAURENT-SET kq_) (c3v-all 'gq_ '(LAURENT-SET kq_)
   `(<= ,(c3v-abs 'kq_ 'rq_ '(LAURENT-ADD kq_ fq_ gq_)) (MAX ,(c3v-abs 'kq_ 'rq_ 'fq_) ,(c3v-abs 'kq_ 'rq_ 'gq_))))))))))))
(dk-peel!)
(let* ((k 'kq_) (r 'rq_) (f 'fq_) (g 'gq_) (s '(LAURENT-ADD kq_ fq_ gq_))
       (af (c3v-abs k r f)) (ag (c3v-abs k r g)) (as (c3v-abs k r s)))
  (dk-cite! 'ring-zero-in k)
  (dk-cite! 'laurent-zero-in k)
  (dk-cite! 'laurent-add-in k f g)
  (for-each (lambda (x) (dk-fact-split! 'laurent-abs-in-rr k r x)) (list f g s))
  (fact 'rr-zero-in)
  (dk-cite! 'rr-max-closed af ag)
  (use-em `(= ,s ,c3v-lz)
    (lambda ()
      (dk-cite! 'rr-le-max-left af ag)
      (subst `(= ,s ,c3v-lz))
      (subst (dk-cite! 'laurent-abs-zero k r))
      (dk-ineq! `(<= 0 ,af) `(<= ,af (MAX ,af ,ag))))
    (lambda ()
      (use-em `(= ,f ,c3v-lz)
        (lambda ()
          (subst `(= ,f ,c3v-lz))
          (subst (dk-cite! 'laurent-add-zero-left k g))
          (subst (dk-cite! 'laurent-abs-zero k r))
          (dk-cite! 'rr-le-max-right 0 ag)
          (dk-close-if-asm!))
        (lambda ()
          (use-em `(= ,g ,c3v-lz)
            (lambda ()
              (subst `(= ,g ,c3v-lz))
              (subst (dk-cite! 'laurent-add-comm k f c3v-lz))
              (subst (dk-cite! 'laurent-add-zero-left k f))
              (subst (dk-cite! 'laurent-abs-zero k r))
              (dk-cite! 'rr-le-max-left af 0)
              (dk-close-if-asm!))
            (lambda ()
              (for-each (lambda (x) (dk-chain-ass! (dk-cite! 'laurent-abs-nonzero k r x)) (dk-split-all!)) (list f g s))
              (let* ((o1 (c3v-ord! k f)) (o2 (c3v-ord! k g)) (o3 (c3v-ord! k s)))
                (for-each (lambda (x o) (dk-have! (c3v-ordp k x o) (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
                          (list f g s) (list o1 o2 o3))
                (for-each (lambda (x o)
                            (dk-cite! 'rpow-star-in-rr r o)
                            (dk-have! `(= ,(c3v-abs k r x) (RPOW-STAR ,r ,o))
                              (lambda () (subst `(= ,(c3v-abs k r x) (RPOW-STAR ,r (LAURENT-ORD ,k ,x))))
                                         (subst `(= (LAURENT-ORD ,k ,x) ,o)) (c3v-rfl!))))
                          (list f g s) (list o1 o2 o3))
                (dk-cite! 'rr-le-max-left af ag) (dk-cite! 'rr-le-max-right af ag)
                (let ((finish!
                        (lambda (oc ac)
                          (dk-have-and! `(<= ,oc ,o1) `(<= ,oc ,o2))
                          (dk-chain-ass! (dk-cite! 'laurent-ord-add k f g o1 o2 o3 oc))
                          (dk-chain-ass! (dk-cite! 'rpow-star-anti-exp r oc o3))
                          (dk-ineq! `(= ,as (RPOW-STAR ,r ,o3)) `(<= (RPOW-STAR ,r ,o3) (RPOW-STAR ,r ,oc))
                                    `(= ,ac (RPOW-STAR ,r ,oc)) `(<= ,ac (MAX ,af ,ag))))))
                  (use-em `(<= ,o1 ,o2)
                    (lambda ()
                      (dk-have! `(<= ,o1 ,o1) (lambda () (dk-ineq!)))
                      (finish! o1 af))
                    (lambda ()
                      (dk-chain-ass! (dk-cite! 'rr-not-le-lt o1 o2))
                      (dk-have! `(<= ,o2 ,o1) (lambda () (dk-ineq! `(< ,o2 ,o1))))
                      (dk-have! `(<= ,o2 ,o2) (lambda () (dk-ineq!)))
                      (finish! o2 ag))))))))))))
(qed 'laurent-abs-ultra)
