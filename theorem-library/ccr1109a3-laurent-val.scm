        (dk-have! `(FORALL xcq_ (IFF (IN xcq_ ,i2) (IN xcq_ EMPTY-SET)))
          (lambda ()
            (let ((x (dk-di-var! (lambda (gl) (cadr (cadr gl))))))
              (dk-iff! (lambda (gl) (equal? (caddr gl) 'EMPTY-SET))
