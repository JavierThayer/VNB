;;; ccr1109a3-laurent-val.scm -- CCR.pdf 1.35 / Remark 1.36: the order of a formal Laurent series and the
;;; order valuation |f| = r^ord(f) on K((x)).
;;; Agent CCR-1109-A3, 2026-11-09.  Destination: theorem-library/ccr1109a3-laurent-val.scm.  Library: analysis
;;; (RPOW-STAR).  Helper prefix c3v-.
;;;
;;; The one FINSUM fact here is laurent-mul-single: when the fibre {(p, q) : p + q = n} meets the supports of f
;;; and g in at most the pair (p0, q0), the coefficient (f g)(n) is f(p0) g(q0).  It is proven on the
;;; TRUNCATIONS (laurent-mul-trunc of ccr1109a3-laurent-ring), where the fibre is finite, by
;;; finsum-single-support (or finsum-empty when the pair is not in the fibre).  Its two consumers: the lowest
;;; coefficient of a product (laurent-mul-lowest, hence ord(f g) = ord f + ord g over an integral domain), and
;;; the product with a monomial (ccr1109a3-laurent-field).
;;;
;;; Load window: after theorem-library/ccr1109a3-laurent-ring and ccr1109a2-laurent (laurent-ord-exists),
;;; rpow-star, log laws (log-neg-below-one), r-exp-mono, rr-max laws.

(define (c3v-rfl!) (dk-close-if-asm!) (if (pair? (dk-open-leaves)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
(define (c3v-below k f b) `(FORALL lzj (IMPLIES (IN lzj ZZ) (IMPLIES (< lzj ,b) (= (,f lzj) (ZERO ,k))))))
(define (c3v-tr k f t) `(LAURENT-TRUNC ,k ,f ,t))
(define c3v-Z 'ZZ-ADD-MONOID)
(define (c3v-all v c body) `(FORALL ,v (IMPLIES (IN ,v ,c) ,body)))
(define (c3v-mm k f g) `(MONALG-MUL ,k ZZ-ADD-MONOID ,f ,g))
(define (c3v-funk k) `(FUN ZZ (CARR ,k)))
(define (c3v-app! k f x)
  (dk-have-and! `(IN ,f (FUN ZZ (CARR ,k))) `(IN ,x ZZ))
  (dk-cite! 'fun-apply-type f 'ZZ `(CARR ,k) x))
(define (c3v-inz! v)
  (if (not (dk-asm? `(IN ,v (CARR ZZ-ADD-MONOID))))
      (dk-have! `(IN ,v (CARR ZZ-ADD-MONOID)) (lambda () (subst '(= (CARR ZZ-ADD-MONOID) ZZ)) (dk-close-if-asm!)))))
(define (c3v-coord! k fn v)
  (dk-iff-fwd! (dk-cite! 'supp-membership k c3v-Z fn v))
  (dk-rewrite-h! `(IN ,v (CARR ZZ-ADD-MONOID)) '(CARR ZZ-ADD-MONOID) 'ZZ)
  (dk-cite! 'zz-in-rr v))
(define (c3v-in-supp! k fn v)
  (c3v-inz! v)
  (let ((iff (dk-cite! 'supp-membership k c3v-Z fn v)))
    (dk-have! (caddr iff) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (dk-iff-bwd! iff)))
(define (c3v-level! v c)
  (let ((tt `(+ ,v (- ,c))))
    (dk-cite! 'zz-in-rr v) (dk-cite! 'zz-in-rr c)
    (dk-cite! 'zz-neg-closed c)
    (dk-have-and! `(IN ,v ZZ) `(IN (- ,c) ZZ))
    (dk-cite! 'zz-add-closed v `(- ,c))
    (dk-cite! 'zz-in-rr tt)
    (dk-have! `(<= ,v (+ ,tt ,c)) (lambda () (dk-ineq!)))
    tt))
(define (c3v-trunc-facts! k f b t)
  (dk-cite! 'laurent-trunc-fun k f t)
  (dk-chain-ass! (dk-cite! 'laurent-trunc-low k f b t))
  (dk-chain-ass! (dk-cite! 'laurent-trunc-finsupp k f b t)))
(define (c3v-zfacts!)
