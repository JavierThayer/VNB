(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) ,(c3v-all 'rq_ 'RR `(IMPLIES (< 0 rq_) ,(c3v-all 'fq_ '(LAURENT-SET kq_)
   `(IMPLIES (NOT (= fq_ ,c3v-lz))
      (AND (= ,(c3v-abs 'kq_ 'rq_ 'fq_) (RPOW-STAR rq_ (LAURENT-ORD kq_ fq_))) (< 0 ,(c3v-abs 'kq_ 'rq_ 'fq_)))))))))))
