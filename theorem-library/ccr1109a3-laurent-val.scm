;; |f g| = |f| |g|  (K an integral domain)
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-INTEGRAL-DOMAIN kq_) ,(c3v-all 'rq_ 'RR `(IMPLIES (< 0 rq_)
   ,(c3v-all 'fq_ '(LAURENT-SET kq_) (c3v-all 'gq_ '(LAURENT-SET kq_)
   `(= ,(c3v-abs 'kq_ 'rq_ '(LAURENT-MUL kq_ fq_ gq_)) (* ,(c3v-abs 'kq_ 'rq_ 'fq_) ,(c3v-abs 'kq_ 'rq_ 'gq_)))))))))))
(dk-peel!)
(let* ((k 'kq_) (r 'rq_) (f 'fq_) (g 'gq_) (fg '(LAURENT-MUL kq_ fq_ gq_)))
  (dk-chain-ass! (dk-cite! 'integral-domain-is-commutative-ring k))
  (dk-chain-ass! (dk-cite! 'commutative-ring-is-ring k))
  (dk-cite! 'ring-zero-in k)
  (dk-cite! 'laurent-zero-in k)
