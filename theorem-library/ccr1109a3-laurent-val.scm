          (list f g) (list tf tg) (list p0 q0) (list b b))
        (dk-have! `(<= ,p0 ,t) (lambda () (dk-ineq! `(= (+ ,p0 ,q0) ,n) `(<= ,b ,q0) `(<= ,n (+ ,t ,b)))))
        (dk-have! `(<= ,q0 ,t) (lambda () (dk-ineq! `(= (+ ,p0 ,q0) ,n) `(<= ,b ,p0) `(<= ,n (+ ,t ,b)))))
        (for-each
          (lambda (fn tfn xi)
            (dk-chain-ass! (dk-cite! 'laurent-trunc-le k fn t xi))
            (dk-rewrite-h! `(NOT (= (,fn ,xi) (ZERO ,k))) `(,fn ,xi) `(,tfn ,xi))
            (c3v-in-supp! k tfn xi))
          (list f g) (list tf tg) (list p0 q0))
        (dk-cite! 'pair-in-cartesian sf2 sg2 p0 q0)
        (dk-chain-ass! (dk-cite! 'zz-add-monoid-opr p0 q0))
        (dk-have! `(IN ,i0 ,i2)
          (lambda () (in-sep! (lambda () (dk-ass!))
                       (lambda () (nth-r) (subst `(= ((OPR ZZ-ADD-MONOID) ,p0 ,q0) (+ ,p0 ,q0))) (dk-close-if-asm!)))))
        ;; I2 is finite and the summand is typed on it
        (for-each
          (lambda (tfn)
            (dk-cite! 'supp-in-set k c3v-Z tfn)
            (dk-iff-fwd! (dk-cite! 'finsupp-membership k c3v-Z tfn)))
          (list tf tg))
        (let ((cart `(CARTESIAN ,sf2 ,sg2)))
          (dk-have! `(IN ,cart SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (dk-ass!)))))
          (dk-chain-ass! (dk-cite! 'card-cartesian-nn sf2 sg2))
          (dk-have! `(IN ,i2 SET) (lambda () (sep-set) (dk-close-if-asm!)))
          (dk-have! `(FORALL zcq_ (IMPLIES (IN zcq_ ,i2) (IN zcq_ ,cart)))
            (lambda () (let ((z (dk-di-var!))) (sep-me `(IN ,z ,i2)) (dk-close-if-asm!))))
          (dk-have-and! `(IN ,cart SET) `(IN (CARD ,cart) NN))
          (dk-have-and! `(IN ,i2 SET) `(FORALL zcq_ (IMPLIES (IN zcq_ ,i2) (IN zcq_ ,cart))))
          (dk-chain-ass! (dk-cite! 'card-subset-nn cart i2)))
        (dk-cite! 'raag-carr k)
        (dk-have! `(IN ,l2 (FUN ,i2 (CARR ,ag)))
          (lambda ()
            (subst `(= (CARR ,ag) (CARR ,k)))
            (dk-each-leaf! (lambda () (lam-t))
              (lambda ()
                (if (dk-head-is? (dk-goal) 'FORALL)
                    (let ((z (dk-di-var!)))
                      (open-j! z)
                      (c3v-app! k tf `(NTH 1 ,z)) (c3v-app! k tg `(NTH 2 ,z))
                      (dk-cite! 'ring-carrier-closed-mul k `(,tf (NTH 1 ,z)) `(,tg (NTH 2 ,z)))
                      (dk-close-if-asm!))
                    (dk-close-if-asm!))))))
        (dk-have! `(FORALL jdq_ (IMPLIES (IN jdq_ ,i2) (IMPLIES (NOT (= jdq_ ,i0)) (= (,l2 jdq_) (IDEN ,ag)))))
          (lambda ()
            (let ((j (dk-di-var!)))
              (di)
              (dk-chain-ass! (dk-apply! cclaim j))
              (dk-split-all!)
              (pbc)
              (ai `(NOT (= ,j ,i0))))))
        (dk-cite! 'ring-additive-ag-is-abelian-group k)
        (subst `(= (,(c3v-mm k tf tg) ,n) ,(caddr inst2)))
        (subst (dk-chain-ass! (dk-cite! 'finsum-single-support ag i2 l2 i0)))
        (dk-lam-b!)
        (nth-r)
        (subst `(= (,tf ,p0) (,f ,p0)))
        (subst `(= (,tg ,q0) (,g ,q0)))
