(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) (FORALL fq_ (FORALL oq_ (IMPLIES ,(c3v-ordp 'kq_ 'fq_ 'oq_) (= (LAURENT-ORD kq_ fq_) oq_))))))))
