  (use-em `(= ,f ,c3v-lz)
    (lambda ()
      (subst `(= ,f ,c3v-lz))
      (subst (dk-cite! 'laurent-mul-zero-left k g))
      (subst (dk-cite! 'laurent-abs-zero k r))
