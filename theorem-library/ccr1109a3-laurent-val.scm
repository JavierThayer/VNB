    (dk-fun-ext! (c3v-mm k z g) z 'ZZ `(CARR ,k) #f #f
      (lambda (v)
        (fact 'zz-zero-in)
        (dk-have! `(= (+ 0 ,v) ,v) (lambda () (dk-cite! 'zz-in-rr v) (dk-ineq!)))
        (dk-have! (c3v-single-hyp k z g v 0)
