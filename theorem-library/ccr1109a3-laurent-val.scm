(qed 'laurent-mul-vanish2)

;;; ---- THE SINGLE-PAIR LEMMA ----
(define (c3v-single-hyp k f g n p0)
  `(FORALL ps_ (IMPLIES (IN ps_ ZZ) (FORALL qs_ (IMPLIES (IN qs_ ZZ) (IMPLIES (= (+ ps_ qs_) ,n)
     (IMPLIES (NOT (= ps_ ,p0)) (OR (= (,f ps_) (ZERO ,k)) (= (,g qs_) (ZERO ,k))))))))))
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_)
   ,(c3v-all 'fq_ (c3v-funk 'kq_) (c3v-all 'gq_ (c3v-funk 'kq_) (c3v-all 'bq_ 'ZZ
      `(IMPLIES ,(c3v-below 'kq_ 'fq_ 'bq_) (IMPLIES ,(c3v-below 'kq_ 'gq_ 'bq_)
        ,(c3v-all 'pq_ 'ZZ (c3v-all 'qr_ 'ZZ (c3v-all 'nq_ 'ZZ
          `(IMPLIES (= (+ pq_ qr_) nq_) (IMPLIES ,(c3v-single-hyp 'kq_ 'fq_ 'gq_ 'nq_ 'pq_)
             (= (,(c3v-mm 'kq_ 'fq_ 'gq_) nq_) ((MUL kq_) (fq_ pq_) (gq_ qr_)))))))))))))))))
(dk-peel!)
(let* ((k 'kq_) (f 'fq_) (g 'gq_) (b 'bq_) (p0 'pq_) (q0 'qr_) (n 'nq_)
       (hyp (c3v-single-hyp k f g n p0))
       (t (c3v-level! n b))
       (tf (c3v-tr k f t)) (tg (c3v-tr k g t))
       (sf2 `(SUPP ,k ZZ-ADD-MONOID ,tf)) (sg2 `(SUPP ,k ZZ-ADD-MONOID ,tg))
       (ag `(RING-ADDITIVE-AG ,k))
       (i0 `(LIST ,p0 ,q0)))
  (c3v-zfacts!)
  (c3v-inz! n)
  (for-each (lambda (v) (dk-cite! 'zz-in-rr v)) (list b p0 q0))
  (dk-cite! 'ring-zero-in k)
  (c3v-trunc-facts! k f b t) (c3v-trunc-facts! k g b t)
  (c3v-app! k f p0) (c3v-app! k g q0)
  (dk-cite! 'ring-carrier-closed-mul k `(,f ,p0) `(,g ,q0))
  (subst (dk-chain-ass! (dk-cite! 'laurent-mul-trunc k f g b n t)))
  (let* ((inst2 (dk-cite! 'monalg-mul-apply k c3v-Z tf tg n))
         (l2 (caddr (caddr inst2))) (i2 (cadddr (caddr inst2)))
         ;; a member j of I2, opened: coordinates typed, trunc = original, original /= 0, j1 + j2 = n
         (open-j! (lambda (j)
                    (sep-me `(IN ,j ,i2))
                    (dk-cite! 'cartesian-pair-eq j sf2 sg2)
                    (dk-fact-split! 'cartesian-nth j sf2 sg2)
                    (for-each
                      (lambda (fn tfn xi)
                        (c3v-coord! k tfn xi)
                        (dk-have! `(<= ,xi ,t)
                          (lambda ()
                            (pbc)
                            (dk-chain-ass! (dk-cite! 'rr-not-le-lt xi t))
                            (dk-chain-ass! (dk-cite! 'laurent-trunc-gt k fn t xi))
                            (ai `(NOT (= (,tfn ,xi) (ZERO ,k))))))
                        (dk-chain-ass! (dk-cite! 'laurent-trunc-le k fn t xi))
                        (dk-rewrite-h! `(NOT (= (,tfn ,xi) (ZERO ,k))) `(,tfn ,xi) `(,fn ,xi))
                        (c3v-app! k fn xi))
                      (list f g) (list tf tg) (list `(NTH 1 ,j) `(NTH 2 ,j)))
                    (dk-chain-ass! (dk-cite! 'zz-add-monoid-opr `(NTH 1 ,j) `(NTH 2 ,j)))
                    (dk-rewrite-h! `(= ((OPR ZZ-ADD-MONOID) (NTH 1 ,j) (NTH 2 ,j)) ,n)
                                   `((OPR ZZ-ADD-MONOID) (NTH 1 ,j) (NTH 2 ,j)) `(+ (NTH 1 ,j) (NTH 2 ,j)))))
         (both `(AND (NOT (= (,f ,p0) (ZERO ,k))) (NOT (= (,g ,q0) (ZERO ,k)))))
         (cclaim `(FORALL jcq_ (IMPLIES (IN jcq_ ,i2) (AND (= jcq_ ,i0) ,both)))))
    ;; every member of the fibre is the pair (p0, q0), and then both coefficients are non-zero
    (dk-have! cclaim
      (lambda ()
        (let* ((j (dk-di-var!)) (j1 `(NTH 1 ,j)) (j2 `(NTH 2 ,j)))
          (open-j! j)
          (use-em `(= ,j1 ,p0)
            (lambda ()
              (dk-have! `(<= ,j2 ,q0) (lambda () (dk-ineq! `(= (+ ,j1 ,j2) ,n) `(= (+ ,p0 ,q0) ,n) `(= ,j1 ,p0))))
              (dk-have! `(<= ,q0 ,j2) (lambda () (dk-ineq! `(= (+ ,j1 ,j2) ,n) `(= (+ ,p0 ,q0) ,n) `(= ,j1 ,p0))))
              (dk-have-and! `(IN ,j2 RR) `(IN ,q0 RR))
              (dk-have-and! `(<= ,j2 ,q0) `(<= ,q0 ,j2))
              (dk-chain-ass! (dk-cite! 'rr-leq-antisymmetric j2 q0))
              (let* ((e1 (dk-rewrite-h! `(= ,j (LIST ,j1 ,j2)) j1 p0))
                     (e2 (dk-rewrite-h! `(= ,j (LIST ,p0 ,j2)) j2 q0)))
                (dk-rewrite-h! `(NOT (= (,f ,j1) (ZERO ,k))) j1 p0)
                (dk-rewrite-h! `(NOT (= (,g ,j2) (ZERO ,k))) j2 q0)
                (dk-conj-close! (lambda () (dk-ass!)))))
            (lambda ()
              (dk-chain-ass! (dk-apply! hyp j1 j2))
              (pbc)
              (dk-or-each! (dk-pick (lambda (h) (and (dk-head-is? h 'OR) (dk-contains? h `(,f ,j1)))) "the disjunction")
                (lambda (d) (ai `(NOT ,d)))))))))
    (use-em both
      (lambda ()
        (dk-split! both)
        ;; (p0, q0) lies in the fibre of the truncations
        (for-each
          (lambda (fn tfn xi bd)
            (dk-have! `(<= ,b ,xi)
              (lambda ()
                (pbc)
                (dk-chain-ass! (dk-cite! 'rr-not-le-lt b xi))
