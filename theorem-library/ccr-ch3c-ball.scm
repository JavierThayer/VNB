(for-each (lambda (lf) (dk-focus! lf) (rfl)) (dk-open-leaves))
(cd7-qed! 'cd7-B-bound)

;;; 5. Coordinatewise convergence, read off the product: for every code t, the distance in X from
;;;    G(delta(k), t) to l(t) is eventually <= eps.

(define (cd7-H kk t) `((DIST ,cd7-X) ,(cd7-G `(delta ,kk) t) (l ,t)))
;; delta(k) in NN, from delta in FUN(NN, NN) and k in NN in context
(define (cd7-delta-type! kv)
  (dk-have! `(AND (IN delta (FUN NN NN)) (IN ,kv NN)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
  (dk-cite! 'fun-apply-type 'delta 'NN 'NN kv))
;; on a goal (<= H(k, t) e): (k t)
(define (cd7-goal-kt)
  (let* ((h (cadr (dk-goal))) (tv (cadr (caddr h))) (gg (cadr h)) (kv (cadr (cadr (cadr (caddr gg))))))
    (list kv tv)))
(define cd7-coord-hyp
  `(FORALL cdt (IMPLIES (IN cdt NN)
     (CONVERGES-TO (,cd7-ms cdt) (VNB-LAMBDA cd7v_ NN (((SUBSEQ ,cd7-sq delta) cd7v_) cdt)) (l cdt)))))
(define (cd7-pc e)
  `(FORALL cdt (IMPLIES (IN cdt NN) (FORSOME cdc (AND (IN cdc NN)
     (FORALL cdk (IMPLIES (IN cdk NN) (IMPLIES (<= cdc cdk) (<= ,(cd7-H 'cdk 'cdt) ,e)))))))))

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (FORALL m (FORALL bs (IMPLIES ,cd7-bnd-hyp
  (FORALL delta (IMPLIES (STRICTLY-MONO-NN delta) (FORALL l (IMPLIES ,cd7-coord-hyp
    (FORALL eps (IMPLIES (POS-RR eps) ,(cd7-pc 'eps)))))))))))))))
(define cd7-l0 (dk-peel!))
(cd7-xfacts!)
(dk-project! '(IN delta (FUN NN NN)) (lambda () (mac-h 'strictly-mono-nn '(STRICTLY-MONO-NN delta))))
(let* ((tv (cadr (car (last-pair (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) cd7-l0))))))
  (let* ((cv (dk-apply! (dk-ctx-form cd7-coord-hyp) tv))
         (fv (caddr cv)))
    (mac-h 'converges-to cv)
    (dk-split-all!)
    (let* ((epsf (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR) (dk-contains? f 'DIST))) "the eps clause"))
           (ex (dk-apply! epsf 'eps))
           (cv0 (dk-skolem! ex #t)))
      (ew cv0)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (let* ((l2 (dk-peel!)) (kv (car (cd7-goal-kt)))
                     (univ (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'DIST) (dk-contains? f cv0))) "the tail clause"))
                     (h0 (dk-apply! univ kv))
                     (gt (cd7-G `(delta ,kv) tv)))
                (cd7-delta-type! kv)
                (dk-cite! 'cd7-coord-int 'K 'n 'm 'bs `(delta ,kv) tv)
                (dk-have! `(= (,fv ,kv) ,gt)
                  (lambda ()
                    (dk-lam-b!)
                    (subst (dk-cite! 'subseq-apply cd7-sq 'delta kv))
                    (if (not (dk-lam-b!)) (rfl))))
                (let* ((h1 (dk-rewrite-h! h0 `(,fv ,kv) gt)))
                  (dk-cite! 'cd7-const-app cd7-X tv)
                  (dk-rewrite-h! h1 `(,cd7-ms ,tv) cd7-X)
                  (dk-ass!)))))))))
(cd7-qed! 'cd7-coord-conv)

;;; 6. The finite max: the thresholds of the codes t <= c have a common bound (induction on c).

(sp (make-wff `(FORALL cdc0 (IMPLIES (IN cdc0 NN) (FORALL K (FORALL n (FORALL m (FORALL bs (FORALL delta (FORALL l (FORALL eps
  (IMPLIES ,(cd7-pc 'eps)
    (FORSOME cdc (AND (IN cdc NN) (FORALL cdt (IMPLIES (IN cdt NN) (IMPLIES (<= cdt cdc0)
      (FORALL cdk (IMPLIES (IN cdk NN) (IMPLIES (<= cdc cdk) (<= ,(cd7-H 'cdk 'cdt) eps)))))))))))))))))))))
(let* ((r (dk-ni-fixed!)) (base (cdr (assq 'base r))) (step (cdr (assq 'step r))))
  (define (pc-form) (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'FORSOME) (dk-contains? f 'DIST)
                                              (not (dk-contains? f 'succ)))) "the per-code thresholds"))
  ;; c = 0
  (dk-focus! base)
  (dk-peel!)
  (let* ((pc (pc-form))
         (c0 (dk-skolem! (dk-apply! pc 0) #t)))
    (dk-cite! 'nn-zero-in)
    (ew c0)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
            (let* ((l2 (dk-peel!)) (tv (cadr (cd7-goal-kt))) (kv (car (cd7-goal-kt))))
              (dk-cite! 'nn-le-zero-is-zero tv)
              (subst `(= ,tv 0))
              (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f c0))) "tail") kv)
              (dk-ass!))))))
  ;; c -> c + 1
  (dk-focus! step)
  (dk-peel!)
  (let* ((g (dk-goal))
         (ih (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the induction hypothesis"))
         (cv (let ((le (cd7-find g (lambda (u) (and (pair? u) (eq? (car u) '<=) (pair? (caddr u)) (eq? (car (caddr u)) 'succ)))))) (cadr (caddr le))))
         (pc (pc-form))
         (c1 (dk-skolem! ih #t))
         (u1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f c1))) "IH tail"))
         (c2 (begin (dk-cite! 'nn-succ-closed cv) (dk-skolem! (dk-apply! pc `(succ ,cv)) #t)))
         (u2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f c2))) "new tail")))
    (dk-have! `(AND (IN ,c1 NN) (IN ,c2 NN)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (dk-cite! 'nn-add-closed c1 c2)
    (ew `(+ ,c1 ,c2))
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
            (let* ((l2 (dk-peel!)) (tv (cadr (cd7-goal-kt))) (kv (car (cd7-goal-kt))))
              (dk-cite! 'nn-le-succ-cases cv tv)
              (use-em `(<= ,tv ,cv)
                (lambda ()
                  (dk-have! `(<= ,c1 ,kv) (lambda () (dk-nn!)))
                  (dk-apply! u1 tv kv)
                  (dk-ass!))
                (lambda ()
                  (dk-have! `(= ,tv (succ ,cv))
                    (lambda () (dk-only! `(OR (<= ,tv ,cv) (= ,tv (succ ,cv))) `(NOT (<= ,tv ,cv))) (prop)))
                  (subst `(= ,tv (succ ,cv)))
                  (dk-have! `(<= ,c2 ,kv) (lambda () (dk-nn!)))
                  (dk-apply! u2 kv)
                  (dk-ass!)))))))))
(cd7-qed! 'cd7-unif-ind)

;;; 7. The codes of the index pairs in range are bounded, and the coordinate distance reads back as the
;;;    entry distance.

(define cd7-cbound '(+ (TRINUM (+ n m)) m))
(sp (make-wff `(FORALL n (IMPLIES (IN n NN) (FORALL m (IMPLIES (IN m NN)
  (FORALL cdi (IMPLIES (IN cdi (INTERVAL 1 n)) (FORALL cdj (IMPLIES (IN cdj (INTERVAL 1 m))
    (<= (NNPAIR cdi cdj) ,cd7-cbound)))))))))))
(dk-peel!)
(mac 'NNPAIR)
(dk-cite! 'interval-elt-in-nn 1 'n 'cdi) (dk-cite! 'interval-elt-in-nn 1 'm 'cdj)
(dk-cite! 'interval-hi 1 'n 'cdi) (dk-cite! 'interval-hi 1 'm 'cdj)
(dk-have! '(AND (IN cdi NN) (IN cdj NN)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
(dk-have! '(AND (IN n NN) (IN m NN)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
(dk-cite! 'nn-add-closed 'cdi 'cdj)
(dk-cite! 'nn-add-closed 'n 'm)
(dk-have! '(<= (+ cdi cdj) (+ n m)) (lambda () (dk-nn!)))
(dk-cite! 'trinum-mono '(+ n m) '(+ cdi cdj))
(dk-cite! 'trinum-type '(+ n m))
(dk-cite! 'trinum-type '(+ cdi cdj))
(dk-nn!)
(cd7-qed! 'cd7-code-bound)

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL m (IMPLIES (IN m NN)
  (FORALL bs (IMPLIES ,cd7-bnd-hyp (FORALL delta (IMPLIES (STRICTLY-MONO-NN delta)
    (FORALL l (IMPLIES (IN l (PRODUCT-CARRIER ,cd7-ms))
      (FORALL cdk (IMPLIES (IN cdk NN)
        (FORALL cdi (IMPLIES (IN cdi (INTERVAL 1 n)) (FORALL cdj (IMPLIES (IN cdj (INTERVAL 1 m))
          (= ,(cd7-H 'cdk '(NNPAIR cdi cdj))
             ,(cd7-n (cd7-sub '(ENTRY (bs (delta cdk)) cdi cdj) `(ENTRY ,(cd7-B) cdi cdj))))))))))))))))))))))))
(dk-peel!)
(cd7-xfacts!)
(dk-project! '(IN delta (FUN NN NN)) (lambda () (mac-h 'strictly-mono-nn '(STRICTLY-MONO-NN delta))))
(cd7-delta-type! 'cdk)
(dk-cite! 'interval-elt-in-nn 1 'n 'cdi) (dk-cite! 'interval-elt-in-nn 1 'm 'cdj)
(dk-cite! 'nnpair-type 'cdi 'cdj)
(dk-cite! 'nnfst-nnpair 'cdi 'cdj)
(dk-cite! 'nnsnd-nnpair 'cdi 'cdj)
(let* ((t0 '(NNPAIR cdi cdj))
       (ty0 (dk-cite! 'cd7-coord-int 'K 'n 'm 'bs '(delta cdk) t0))
       (ty1 (dk-rewrite-h! ty0 `(NNFST ,t0) 'cdi))
       (ty2 (dk-rewrite-h! ty1 `(NNSND ,t0) 'cdj))
       (ent (dk-cite! 'cd7-B-entry 'K 'n 'm 'l 'cdi 'cdj)))
  (dk-split-all! (list ent))
  (subst `(= (NNFST ,t0) cdi))
  (subst `(= (NNSND ,t0) cdj))
  (subst `(= (ENTRY ,(cd7-B) cdi cdj) (l ,t0)))
  (dk-have! '(AND (IN cdi (INTERVAL 1 n)) (IN cdj (INTERVAL 1 m))) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
  (let* ((ift (cadr (cadr (dk-goal)))) (val (caddr ift)))
    (dk-if-branch! #t ift #f
      (lambda ()
        (let ((ty3 (dk-rewrite-h! ty2 ift val)))
          (dk-cite! 'subspace-dist '(NF-METRIC-SPACE K) '(NV-INTEGERS K) val `(l ,t0))
          (subst `(= ((DIST ,cd7-X) ,val (l ,t0)) ((DIST (NF-METRIC-SPACE K)) ,val (l ,t0))))
          (dk-cite! 'cq4-nvint-parts 'K val)
          (dk-cite! 'cq4-nvint-parts 'K `(l ,t0))
          (dk-split-all!)
          (dk-cite! 'nf-metric-distance 'K val `(l ,t0))
          (subst `(= ((DIST (NF-METRIC-SPACE K)) ,val (l ,t0)) ,(cd7-n (cd7-sub val `(l ,t0)))))
          (rfl))))))
(cd7-qed! 'cd7-read)

;;; 8. THE THEOREM.

(sp (make-wff `(FORALL K (IMPLIES (IS-LOCAL-NV-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL m (IMPLIES (IN m NN)
  (FORALL bs (IMPLIES ,cd7-bnd-hyp
    (FORSOME phi (AND (STRICTLY-MONO-NN phi)
      (FORSOME B (AND (IS-MAT-BOUND K n m B 1)
        (FORALL eps (IMPLIES (POS-RR eps) (FORSOME cdc (AND (IN cdc NN)
          (FORALL cdk (IMPLIES (IN cdk NN) (IMPLIES (<= cdc cdk) (IS-MAT-CLOSE K n m (bs (phi cdk)) B eps))))))))))))))))))))))
(dk-peel!)
(dk-project! '(IS-NV-FIELD K) (lambda () (mac-h 'is-local-nv-field '(IS-LOCAL-NV-FIELD K))))
(dk-cite! 'nv-field-normed 'K)
(cd7-xfacts!)
(dk-cite! 'ccr-local-integers-compact 'K)
(dk-cite! 'compact-implies-seq-compact cd7-X)
(dk-cite! 'cd7-const-ms cd7-X)
(dk-have! `(FORALL cdt (IMPLIES (IN cdt NN) (SEQ-COMPACT (,cd7-ms cdt))))
  (lambda ()
    (let* ((landed (dk-peel!)) (tv (cadr (car landed))))
      (dk-cite! 'cd7-const-app cd7-X tv)
      (subst `(= (,cd7-ms ,tv) ,cd7-X))
      (dk-ass!))))
(dk-cite! 'cd7-sq-type 'K 'n 'm 'bs)
(define cd7-dv #f)
(define cd7-lv #f)
(let* ((ex (dk-cite! 'coordinatewise-diagonal-subseq cd7-ms cd7-sq)))
  (set! cd7-dv (dk-skolem! ex #t))
  (set! cd7-lv (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'PRODUCT-CARRIER))) "the limit") #t)))
(define cd7-Bm (subst-free 'l cd7-lv (cd7-B)))
(ew cd7-dv)
(dk-conj-close!
  (lambda ()
    (cond
      ((dk-asm? (dk-goal)) (ass))
      (#t
       (dk-cite! 'cd7-B-bound 'K 'n 'm cd7-lv)
       (dk-project! `(IN ,cd7-Bm (MAT n m (CARR K))) (lambda () (mac-h 'is-mat-bound `(IS-MAT-BOUND K n m ,cd7-Bm 1))))
       (ew cd7-Bm)
       (dk-conj-close!
         (lambda ()
           (if (dk-asm? (dk-goal)) (ass)
               (let* ((landed (dk-peel!))
                      (ev (cadr (car landed))))
                 (dk-cite! 'cd7-coord-conv 'K 'n 'm 'bs cd7-dv cd7-lv ev)
                 (dk-have! '(AND (IN n NN) (IN m NN)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                 (dk-cite! 'nn-add-closed 'n 'm)
                 (dk-cite! 'trinum-type '(+ n m))
                 (dk-have! `(AND (IN (TRINUM (+ n m)) NN) (IN m NN)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                 (dk-cite! 'nn-add-closed '(TRINUM (+ n m)) 'm)
                 (let* ((ux (dk-cite! 'cd7-unif-ind cd7-cbound 'K 'n 'm 'bs cd7-dv cd7-lv ev))
                        (cu (dk-skolem! ux #t))
                        (uu (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f cu))) "the uniform tail")))
                   (ew cu)
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-asm? (dk-goal)) (ass)
                           (let* ((l2 (dk-peel!))
                                  (kv (cadr (cadr (list-ref (dk-goal) 4)))))
                             (dk-project! `(IN ,cd7-dv (FUN NN NN)) (lambda () (mac-h 'strictly-mono-nn `(STRICTLY-MONO-NN ,cd7-dv))))
                             (dk-have! `(AND (IN ,cd7-dv (FUN NN NN)) (IN ,kv NN)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                             (dk-cite! 'fun-apply-type cd7-dv 'NN 'NN kv)
                             (let ((bd (dk-apply! (dk-ctx-form cd7-bnd-hyp) `(,cd7-dv ,kv))))
                               (dk-project! `(IN (bs (,cd7-dv ,kv)) (MAT n m (CARR K))) (lambda () (mac-h 'is-mat-bound bd))))
                             (mac 'is-mat-close)
                             (dk-conj-close!
                               (lambda ()
                                 (if (dk-asm? (dk-goal)) (ass)
                                     (let* ((l3 (dk-peel!))
                                            (en (cadr (cadr (cadr (dk-goal)))))
                                            (iv (caddr en)) (jv (cadddr en))
                                            (t0 `(NNPAIR ,iv ,jv)))
                                       (dk-cite! 'cd7-code-bound 'n 'm iv jv)
                                       (dk-cite! 'interval-elt-in-nn 1 'n iv) (dk-cite! 'interval-elt-in-nn 1 'm jv)
                                       (dk-cite! 'nnpair-type iv jv)
                                       (dk-apply! uu t0 kv)
                                       (dk-cite! 'cd7-read 'K 'n 'm 'bs cd7-dv cd7-lv kv iv jv)
                                       (subst `(= ,(cadr (dk-goal)) ,(subst-free 'l cd7-lv (subst-free 'delta cd7-dv (cd7-H kv t0)))))
                                       (dk-ass!))))))))))))))))))
(cd7-qed! 'ccr-mat-ball-seq-compact)
