  (let ((f1 (dk-rewrite-h! f `(,cd7-ms ,t) cd7-X)))
    (dk-rewrite-h! f1 `(PTS ,cd7-X) '(NV-INTEGERS K))))

;;; 3. The coded sequence is a sequence in the product carrier.

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (FORALL m (FORALL bs (IMPLIES ,cd7-bnd-hyp
