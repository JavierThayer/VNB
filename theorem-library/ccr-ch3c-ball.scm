(cd7-qed! 'cd7-B-entry)

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL m (IMPLIES (IN m NN)
  (FORALL l (IMPLIES (IN l (PRODUCT-CARRIER ,cd7-ms)) (IS-MAT-BOUND K n m ,(cd7-B) 1)))))))))))
(dk-peel!)
(dk-have! `(FORALL cd7a_ (IMPLIES (IN cd7a_ (INTERVAL 1 n)) (FORALL cd7b_ (IMPLIES (IN cd7b_ (INTERVAL 1 m))
