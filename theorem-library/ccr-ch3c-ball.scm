;;; Library: analysis.

;;; ccr-ch3c-ball.scm -- CCR.pdf chapter 3, s. 3.1: the max-norm closed unit ball of n-by-m matrices over a
;;; LOCAL NV field is sequentially compact, in the form the limit argument of Lemma 3.4 uses:
;;;
;;;   every sequence bs with ||bs(k)||_max <= 1 has a strictly increasing phi and a matrix B with
;;;   ||B||_max <= 1 and ||bs(phi k) - B||_max -> 0.
;;;
;;; Agent CCR-1109-B3, wave 2026-11-09.  Destination: theorem-library/ccr-ch3c-ball.scm.  Library:
;;; analysis.  Helper prefix cd7-.
;;;
;;; ROUTE (the one CCR-1109-B2 named).  X = Z(K) with the subspace metric is compact
;;; (ccr-local-integers-compact, CCR-1109-B2), hence sequentially compact.  The matrix bs(k) is read as a
;;; point of the countable product X^NN through the Cantor pairing: coordinate t is the entry
;;; (NNFST t, NNSND t) when that index pair is in range, 0 otherwise.  coordinatewise-diagonal-subseq
;;; gives one strictly increasing delta and a limit l in the product with every coordinate converging.
;;; B is the matrix with entries l(NNPAIR(i, j)).  The convergence is made uniform over the finitely many
;;; codes t <= TRINUM(n + m) + m by an induction on the bound (the finite max), and read back entrywise
;;; (nnfst-nnpair, nnsnd-nnpair, the distance of the subspace and of the field).
;;;
;;; LOAD WINDOW: after theorem-library/ccr-ch3b-an (ccr-local-integers-compact) and ccr-ch3b-alg
;;; (cq4-nvint-parts, cq4-nvint-intro), CCR-1109-B2, unwired; after structure-library/ccr-ch3c-vocab
;;; (IS-MAT-CLOSE).  The other citations are older: rake-block-tower / ascoli-arzela
;;; (coordinatewise-diagonal-subseq), product-metric, nn-pairing, cauchy-subsequence, matrix.

(define cd7-X '(SUBSPACE-MS (NF-METRIC-SPACE K) (NV-INTEGERS K)))
(define cd7-ms `(VNB-LAMBDA cd7t_ NN ,cd7-X))
(define (cd7-cond t) `(AND (IN (NNFST ,t) (INTERVAL 1 n)) (IN (NNSND ,t) (INTERVAL 1 m))))
(define (cd7-G kk t) `(IF ,(cd7-cond t) (ENTRY (bs ,kk) (NNFST ,t) (NNSND ,t)) (ZERO K)))
(define (cd7-row kk) `(VNB-LAMBDA cd7u_ NN ,(cd7-G kk 'cd7u_)))
(define cd7-sq `(VNB-LAMBDA cd7k_ NN ,(cd7-row 'cd7k_)))
(define cd7-bnd-hyp '(FORALL cdk (IMPLIES (IN cdk NN) (IS-MAT-BOUND K n m (bs cdk) 1))))
(define (cd7-n x) `((FNRM K) ,x))
(define (cd7-sub x y) `((ADD K) ,x ((NEG K) ,y)))
(define cd7-cart '(CARTESIAN (INTERVAL 1 n) (INTERVAL 1 m)))
(define (cd7-gl) `(VNB-LAMBDA (LIST cd7i_ cd7j_) ,cd7-cart (l (NNPAIR cd7i_ cd7j_))))
(define (cd7-B) `(MATOF n m ,(cd7-gl)))

(define (cd7-qed! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; cd7: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l)
                    (display ";;   GOAL ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (f) (display ";;      | ") (display (expression->string f)) (newline))
                              (let ((a (dk-asms-of l))) (list-head a (min 14 (length a))))))
                  (dk-open-leaves))))
  (qed name))
(define (cd7-dump! tag)
  (display ";; cd7 DUMP ") (display tag) (newline)
  (display ";;   GOAL ") (display (expression->string (dk-goal))) (newline)
  (for-each (lambda (f) (display ";;      | ") (display (expression->string f)) (newline))
            (let ((a (dk-asms))) (list-head a (min 30 (length a))))))

(define (cd7-find tree pred)
  (let walk ((t tree))
    (cond ((pred t) t)
          ((pair? t) (or (walk (car t)) (walk (cdr t))))
          (#t #f))))

;;; 0. Small facts.

