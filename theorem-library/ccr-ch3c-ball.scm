            (dk-ass!)))))))
(cd7-qed! 'cd7-sq-type)

;;; 4. The limit matrix B = (l(NNPAIR(i, j)))_ij: its entries, its typing, its bound.

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL m (IMPLIES (IN m NN)
  (FORALL l (IMPLIES (IN l (PRODUCT-CARRIER ,cd7-ms))
    (FORALL cdi (IMPLIES (IN cdi (INTERVAL 1 n)) (FORALL cdj (IMPLIES (IN cdj (INTERVAL 1 m))
      (AND (IN (l (NNPAIR cdi cdj)) (NV-INTEGERS K)) (= (ENTRY ,(cd7-B) cdi cdj) (l (NNPAIR cdi cdj))))))))))))))))))
(dk-peel!)
(cd7-xfacts!)
(define (cd7-coord! iv jv)            ; l(NNPAIR(i, j)) in Z(K), i, j typed in their intervals
