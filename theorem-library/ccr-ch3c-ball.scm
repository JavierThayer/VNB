;;; 2. The X-facts, in context: K a normed field.
(define (cd7-xfacts!)
  (dk-cite! 'cd7-nvint-set 'K)
  (dk-split-all! (list (dk-ctx-form '(AND (IN (NV-INTEGERS K) SET) (SUBSET (NV-INTEGERS K) (PTS (NF-METRIC-SPACE K)))))))
