;;; 1. The coordinates of the coded matrices lie in Z(K).

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (FORALL m (FORALL bs (IMPLIES ,cd7-bnd-hyp
  (FORALL cdk (IMPLIES (IN cdk NN) (FORALL cdt (IMPLIES (IN cdt NN) (IN ,(cd7-G 'cdk 'cdt) (NV-INTEGERS K))))))))))))))
(dk-peel!)
(let* ((g (dk-goal)) (ift (cadr g)) (kv (cadr (cadr (caddr ift)))))
