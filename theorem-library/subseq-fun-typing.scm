;;; theorem-library/ca6-hurwitz.scm, so that files of library analysis may cite them (the library gate).
;;; The proofs are the originals, verbatim; the helper defines are a copy of ca6-hurwitz.scm's.  Loaded
;;; immediately before ca6-hurwitz.scm.
;;;   subseq-fun-typing

;;; ---- helper defines copied from ca6-hurwitz.scm ----
(define (ca6x-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (ca6x-and! a b)
  (let* ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (ca6x-rr! t)
  (let* ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((eq? t 'PI) (dk-split-all! (list (dk-cite! 'pi-pos))) typ)
          ((number? t) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((ca6x-op? t 'succ 2) (ca6x-nn! t) (fact 'nn-in-rr t) typ)
          ((ca6x-op? t '* 3) (ca6x-rr! (cadr t)) (ca6x-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((ca6x-op? t '+ 3) (ca6x-rr! (cadr t)) (ca6x-rr! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((ca6x-op? t '- 3) (ca6x-rr! (cadr t)) (ca6x-rr! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((ca6x-op? t '- 2) (ca6x-rr! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((ca6x-op? t 'magnitude 2) (ca6x-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((ca6x-op? t 'real-part 2) (ca6x-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((ca6x-op? t 'imag-part 2) (ca6x-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((ca6x-op? t 'abs 2) (ca6x-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((ca6x-op? t 'recip 2)
           (ca6x-rr! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (if (dk-asm? (list '< 0 (cadr t)))
                   (fact 'rr-pos-ne-zero (cadr t))
                   (error "ca6x-rr!: land the non-vanishing first" (expression->string (cadr t)))))
           (ca6x-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t))
           typ)
          (#t (dk-real! t) typ))))
(define (ca6x-nn! t)
  (let* ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((ca6x-op? t 'succ 2) (ca6x-nn! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          (#t (dk-type! t 'NN)))))
(define (ca6x-cc! t)
  (let* ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((or (and (number? t) (real? t)) (eq? t 'PI) (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
               (ca6x-op? t 'succ 2)
               (ca6x-op? t 'magnitude 2) (ca6x-op? t 'real-part 2) (ca6x-op? t 'imag-part 2))
           (ca6x-rr! t) (fact 'rr-subset-cc t) typ)
          ((ca6x-op? t '- 3) (ca6x-cc! (cadr t)) (ca6x-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((ca6x-op? t '- 2) (ca6x-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((ca6x-op? t '+ 3) (ca6x-cc! (cadr t)) (ca6x-cc! (caddr t))
           (ca6x-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((ca6x-op? t '* 3) (ca6x-cc! (cadr t)) (ca6x-cc! (caddr t))
           (ca6x-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((ca6x-op? t 'power 3) (ca6x-cc! (cadr t)) (ca6x-nn! (caddr t))
           (ca6x-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((ca6x-op? t 'CC-EXP 2) (ca6x-cc! (cadr t))
           (dk-split-all! (list (dk-cite! 'cc-exp-converges (cadr t)))) typ)
          ((ca6x-op? t 'recip 2) (ca6x-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "ca6x-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (ca6x-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (dk-type! t 'CC)))))
(define (ca6x-steps . thunks)
  ;; run THUNKS in order while the leaf focused at the start stays open
  (let* ((leaf (proof-state-focus *ps*)))
    (let loop ((ts thunks))
      (if (and (pair? ts) (not (sequent-node-grounded? leaf)))
          (begin ((car ts)) (loop (cdr ts)))))))
(define (ca6x-only-prop! . fs) ((dk-lane (lambda () (apply dk-only! fs) (dk-lane-if! prop)))))
(define (ca6-lam-goal! pre)
  (dk-lam-type! (lambda ()
                  (let* ((v (dk-di-var!)))
                    (ca6x-steps
                      (lambda () (pre v))
                      (lambda () (if (dk--redex? (dk-goal)) (dk-lam-b!)))
                      (lambda () (if (not (dk-asm? (dk-goal))) (ca6x-cc! (cadr (dk-goal)))))
                      (lambda () (ass)))))))
(define (ca6-mono-fun! phi)     ; STRICTLY-MONO-NN(phi) in context: land phi in FUN(NN, NN)
  (let ((typ (list 'IN phi '(FUN NN NN))))
    (if (not (dk-asm? typ))
        (let ((iff (dk-cite! 'strictly-mono-nn phi)))
          (dk-have! typ (lambda () (ca6x-only-prop! iff (list 'STRICTLY-MONO-NN phi))))))
    typ))

;;; ---- the moved proofs ----
(sp (make-wff '(FORALL f (FORALL ssa_ (IMPLIES (IN f (FUN NN ssa_))
                 (FORALL phi (IMPLIES (STRICTLY-MONO-NN phi) (IN (SUBSEQ f phi) (FUN NN ssa_)))))))))
(dk-peel!)
(ca6-mono-fun! 'phi)
(mac 'SUBSEQ)
(ca6-lam-goal! (lambda (v) (fact 'fun-apply-type-c 'phi 'NN 'NN v) (fact 'fun-apply-type-c 'f 'NN 'ssa_ (list 'phi v))))
(qed 'subseq-fun-typing)

