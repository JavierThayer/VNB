;;; Library: complex-analysis.

;;; calint-poly-integral.scm -- complex-analysis Corollary 3.3 as the notes state it: a polynomial
;;; function integrates to 0 along a closed path.  "Any polynomial function has an antiderivative":
;;;   (1) monomial-cc-diff        z^(j+1) has derivative (j+1) z^j on CC (induction, product rule);
;;;   (2) cc-ps-antiderivative    every finite power sum sum_{j<n} c(j) z^j has an antiderivative on CC
;;;                               (induction on n: add c(n) recip(n+1) z^(n+1));
;;;   (3) poly-fn-closed-road-integral  through line-int-closed-road-of-derivative.
;;; Needs POLY-2's IS-POLY-FN-ON (scratchpad/camontel/poly-fn-vocab.scm) for (3) only.
;;; Library: complex-analysis.  Load window: after poly-fn-vocab and the line-integral laws
;;; (line-int-closed-road-of-derivative, goursat-bricks).

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define cpi-K 'CC-NORMED-FIELD)
(define (cpi-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (cpi-and! a b)
  (let* ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (cpi-nn! t)
  (let* ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((cpi-op? t 'succ 2) (cpi-nn! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          (#t (dk-type! t 'NN)))))
(define (cpi-cc! t)
  (let* ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t 1) (fact 'cc-one-in) typ)
          ((or (dk-asm? (list 'IN t 'NN)) (cpi-op? t 'succ 2))
           (cpi-nn! t) (fact 'nn-in-rr t) (fact 'rr-subset-cc t) typ)
          ((cpi-op? t '+ 3) (cpi-cc! (cadr t)) (cpi-cc! (caddr t))
           (cpi-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((cpi-op? t '* 3) (cpi-cc! (cadr t)) (cpi-cc! (caddr t))
           (cpi-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((cpi-op? t 'power 3) (cpi-cc! (cadr t)) (cpi-nn! (caddr t))
           (cpi-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((cpi-op? t 'recip 2) (cpi-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "cpi-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (cpi-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (dk-type! t 'CC)))))
(define (cpi-carr-typ! lam)
  (fact 'cc-nf-carr)
  (dk-have! (list 'IN lam '(FUN CC (CARR CC-NORMED-FIELD)))
    (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass))))
(define (cpi-lam-typ! lam pre)
  (dk-have! (list 'IN lam '(FUN CC CC))
    (lambda ()
      (dk-lam-type! (lambda ()
                      (let* ((v (dk-di-var!)))
                        (pre v)
                        (if (dk--redex? (dk-goal)) (dk-lam-b!))
                        (if (not (dk-asm? (dk-goal))) (cpi-cc! (cadr (dk-goal))))
                        (ass)))))))
;;; CC open in itself, both spellings; the field; CC a set
(define (cpi-setup!)
  (fact 'cc-is-normed-field)
  (fact 'cc-nf-carr)
  (fact 'cc-is-set)
  (fact 'cc-zero-in) (fact 'cc-one-in)
  (fact 'cc-is-metric-space)
  (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
  (fact 'carrier-is-open 'CC-MS)
  (dk-have! '(IS-OPEN CC-MS CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass)))
  (let ((oiff (dk-fact! 'cc-ms-open-iff 'CC)))
    (dk-have! '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) CC)
      (lambda () (dk-only! oiff '(IS-OPEN CC-MS CC)) (prop)))))
(define (cpi-pow-succ! a n)
  (cpi-cc! a) (cpi-nn! n)
  (cpi-and! (list 'IN a 'CC) (list 'IN n 'NN))
  (dk-cite! 'power-succ a n))

;;; =====================================================================
;;; (1) THE MONOMIAL
;;; =====================================================================
(define (cpi-M j) (list 'VNB-LAMBDA 'cpv_ 'CC (list 'power 'cpv_ (list 'succ j))))
(define (cpi-mono-goal j)
  (list 'FORALL 'cpw_ (list 'IMPLIES '(IN cpw_ CC)
    (list 'IS-DIFF-ON cpi-K 'CC (cpi-M j) 'cpw_ (list '* (list 'succ j) (list 'power 'cpw_ j))))))
(sp (make-wff (list 'FORALL 'cpj_ (list 'IMPLIES '(IN cpj_ NN) (cpi-mono-goal 'cpj_)))))
(define cpi-md-br (use-induction))
(dk-focus! (cdr (assq 'base cpi-md-br)))
(dk-peel!)
(cpi-setup!)
(let* ((g (dk-goal)) (P (list-ref g 3)) (w (list-ref g 4)) (gv (list-ref g 5))
       (dI (dk-cite! 'diff-on-identity cpi-K 'CC w))
       (RL (list-ref dI 3)))
  (fact 'nn-zero-in)
  (cpi-lam-typ! P (lambda (v) 'nothing))
  (cpi-carr-typ! P)
  (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES '(IN hbx_ CC) (list '== (list P 'hbx_) (list RL 'hbx_))))
    (lambda ()
      (let* ((x (dk-di-var!)))
        (dk-lam-b!)
        (subst (cpi-pow-succ! x 0))
        (subst (dk-cite! 'power-zero x))
        (dk-have! (list '= (list '* x 1) x) (lambda () (crs)))
        (subst (list '= (list '* x 1) x))
        (qrfl))))
  (dk-cite! 'diff-on-transfer-ptwise-eq cpi-K 'CC P RL w '(ONE CC-NORMED-FIELD))
  (dk-have! (list '= gv '(ONE CC-NORMED-FIELD))
    (lambda ()
      (slot 'ONE)
      (subst (dk-cite! 'power-zero w))
      (subst (dk-cite! 'nn-succ-plus-one 0))
      (crs)))
  (subst (list '= gv '(ONE CC-NORMED-FIELD)))
  (ass))
(dk-focus! (cdr (assq 'step cpi-md-br)))
(define cpi-md-n (cdr (assq 'var cpi-md-br)))
(define cpi-md-ih (cdr (assq 'ih cpi-md-br)))
(dk-peel!)
(cpi-setup!)
(let* ((n cpi-md-n) (sn (list 'succ n)) (ssn (list 'succ sn))
       (g (dk-goal)) (P (list-ref g 3)) (w (list-ref g 4)) (gv (list-ref g 5))
       (Pn (cpi-M n)))
  (cpi-nn! sn) (cpi-nn! ssn)
  (cpi-lam-typ! P (lambda (v) 'nothing))
  (cpi-lam-typ! Pn (lambda (v) 'nothing))
  (cpi-carr-typ! P)
  (let* ((dI (dk-cite! 'diff-on-identity cpi-K 'CC w))
         (RL (list-ref dI 3))
         (dp (dk-apply! cpi-md-ih w))
         (m (list-ref dp 5))
         (pr (dk-cite! 'diff-on-product cpi-K 'CC RL Pn w '(ONE CC-NORMED-FIELD) m))
         (plam (list-ref pr 3)) (pval (list-ref pr 5)))
    (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES '(IN hbx_ CC) (list '== (list P 'hbx_) (list plam 'hbx_))))
      (lambda ()
        (let* ((x (dk-di-var!)) (q (list 'power x sn)))
          (dk-lam-b!)
          (cpi-cc! q)
          (subst (dk-cite! 'cc-nf-mul-apply x q))
          (subst (cpi-pow-succ! x sn))
          (qrfl))))
    (dk-cite! 'diff-on-transfer-ptwise-eq cpi-K 'CC P plam w pval)
    (let* ((q (list 'power w sn)) (q0 (list 'power w n)))
      (cpi-cc! q) (cpi-cc! q0) (cpi-cc! m) (cpi-cc! sn)
      (dk-have! (list '= gv pval)
        (lambda ()
          (dk-lam-b!)
          (slot 'ONE)
          (cpi-cc! (list '* 1 q)) (cpi-cc! (list '* m w))
          (subst (dk-cite! 'cc-nf-mul-apply 1 q))
          (subst (dk-cite! 'cc-nf-mul-apply m w))
          (subst (dk-cite! 'cc-nf-add-apply (list '* 1 q) (list '* m w)))
          (subst (cpi-pow-succ! w n))
          (subst (dk-cite! 'nn-succ-plus-one sn))
          (let* ((qv (dk-name! q0 'CC)))
            (subst (list '= q0 qv))
            (let* ((sv (dk-name! sn 'CC)))
              (subst (list '= sn sv))
              (crs)))))
      (subst (list '= gv pval))
      (ass))))
(qed 'monomial-cc-diff)

;;; =====================================================================
;;; (2) AN ANTIDERIVATIVE OF EVERY FINITE POWER SUM
;;; =====================================================================
(define (cpi-H c z) (list 'VNB-LAMBDA 'pfj_ 'NN (list '* (list c 'pfj_) (list 'power z 'pfj_))))
(define (cpi-PS c z n) (list 'CC-SERIES-PARTIAL-SUM (cpi-H c z) n))
(define (cpi-H-typ! c z)
  (let ((g (list 'IN (cpi-H c z) '(FUN NN CC))))
    (if (not (dk-asm? g))
        (dk-have! g
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let* ((j (dk-di-var!)))
                  (fact 'fun-apply-type-c c 'NN 'CC j)
                  (if (dk--redex? (dk-goal)) (dk-lam-b!))
                  (if (not (dk-asm? (dk-goal))) (cpi-cc! (cadr (dk-goal))))
                  (ass)))))))
    g))
(define (cpi-ad-goal n)
  (list 'FORALL 'cpc_ (list 'IMPLIES '(IN cpc_ (FUN NN CC))
    (list 'FORSOME 'cpf_ (list 'AND '(IN cpf_ (FUN CC CC))
      (list 'FORALL 'cpw_ (list 'IMPLIES '(IN cpw_ CC)
        (list 'IS-DIFF-ON cpi-K 'CC 'cpf_ 'cpw_ (cpi-PS 'cpc_ 'cpw_ n)))))))))
(sp (make-wff (list 'FORALL 'cpn_ (list 'IMPLIES '(IN cpn_ NN) (cpi-ad-goal 'cpn_)))))
(define cpi-ad-br (use-induction))
(dk-focus! (cdr (assq 'base cpi-ad-br)))
(dk-peel!)
(cpi-setup!)
(let* ((Z '(VNB-LAMBDA cpv_ CC 0)))
  (ew Z)
  (dk-conj-close!
   (lambda ()
     (let ((g (dk-goal)))
       (cond ((dk-head-is? g 'IN) (cpi-lam-typ! Z (lambda (v) 'nothing)))
             ((dk-head-is? g 'FORALL)
              (let* ((w (dk-di-var!)))
                (dk-have! '(IN 0 (CARR CC-NORMED-FIELD))
                  (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass)))
                (dk-cite! 'diff-on-const cpi-K 'CC 0 w)
                (let ((gv (list-ref (dk-goal) 5)))
                  (dk-have! (list '= gv '(ZERO CC-NORMED-FIELD))
                    (lambda ()
                      (slot 'ZERO)
                      (subst (dk-cite! 'cc-series-partial-sum-zero (cadr gv)))
                      (rfl)))
                  (subst (list '= gv '(ZERO CC-NORMED-FIELD)))
                  (ass))))
             (#t (ass)))))))
(dk-focus! (cdr (assq 'step cpi-ad-br)))
(define cpi-ad-n (cdr (assq 'var cpi-ad-br)))
(define cpi-ad-ih (cdr (assq 'ih cpi-ad-br)))
(dk-peel!)
(cpi-setup!)
(let* ((n cpi-ad-n) (sn (list 'succ n))
       (c (cadr (dk-pick (lambda (f) (and (cpi-op? f 'IN 3) (equal? (caddr f) '(FUN NN CC)))) "c")))
       (Fn (dk-skolem! (dk-apply! cpi-ad-ih c)))
       (dfa (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-DIFF-ON) (dk-contains? f Fn)))
                     "the derivative of the antiderivative of the shorter sum"))
       (cn (list c n))
       (_1 (begin (cpi-nn! sn) (fact 'nn-succ-nonzero n)
                  (fact 'fun-apply-type-c c 'NN 'CC n)))
       (k (list '* cn (list 'recip sn)))
       (_2 (cpi-cc! k))
       (AG (list 'VNB-LAMBDA 'cpv_ 'CC (list '+ (list Fn 'cpv_) (list '* k (list 'power 'cpv_ sn))))))
  (ew AG)
  (dk-conj-close!
   (lambda ()
     (let ((g (dk-goal)))
       (cond
        ((dk-head-is? g 'IN)
         (cpi-lam-typ! AG (lambda (v) (fact 'fun-apply-type-c Fn 'CC 'CC v))))
        ((dk-head-is? g 'FORALL)
         (let* ((w (dk-di-var!))
                (gv (list-ref (dk-goal) 5))
                (dF (dk-apply! dfa w))
                (psn (list-ref dF 5))
                (_3 (dk-have! (list 'IN k '(CARR CC-NORMED-FIELD))
                      (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass))))
                (dC (dk-cite! 'diff-on-const cpi-K 'CC k w))
                (CL (list-ref dC 3))
                (dM (dk-cite! 'monomial-cc-diff n w))
                (Mn (list-ref dM 3)) (mv (list-ref dM 5))
                (pr (dk-cite! 'diff-on-product cpi-K 'CC CL Mn w '(ZERO CC-NORMED-FIELD) mv))
                (plam (list-ref pr 3)) (pval (list-ref pr 5))
                (sm (dk-cite! 'diff-on-sum cpi-K 'CC Fn plam w psn pval))
                (slam (list-ref sm 3)) (sval (list-ref sm 5)))
           (cpi-lam-typ! AG (lambda (v) (fact 'fun-apply-type-c Fn 'CC 'CC v)))
           (cpi-carr-typ! AG)
           (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES '(IN hbx_ CC) (list '== (list AG 'hbx_) (list slam 'hbx_))))
             (lambda ()
               (let* ((x (dk-di-var!)) (q (list 'power x sn)) (kq (list '* k q)) (fx (list Fn x)))
                 (fact 'fun-apply-type-c Fn 'CC 'CC x)
                 (cpi-cc! q) (cpi-cc! kq)
                 (dk-lam-b!)
                 (subst (dk-cite! 'cc-nf-mul-apply k q))
                 (subst (dk-cite! 'cc-nf-add-apply fx kq))
                 (qrfl))))
           (dk-cite! 'diff-on-transfer-ptwise-eq cpi-K 'CC AG slam w sval)
           (let* ((q (list 'power w sn)) (q0 (list 'power w n))
                  (H (cpi-H c w)) (hn (list H n)))
             (cpi-cc! q) (cpi-cc! q0) (cpi-cc! mv) (cpi-cc! sn)
             (cpi-H-typ! c w)
             (fact 'cc-series-partial-sum-in-cc n H)
             (dk-have! (list 'IN hn 'CC) (lambda () (dk-lam-b!) (cpi-cc! (cadr (dk-goal))) (ass)))
             (dk-have! (list '= gv sval)
               (lambda ()
                 (dk-lam-b!)
                 (slot 'ZERO)
                 (cpi-cc! (list '* 0 q)) (cpi-cc! (list '* mv k))
                 (subst (dk-cite! 'cc-nf-mul-apply 0 q))
                 (subst (dk-cite! 'cc-nf-mul-apply mv k))
                 (cpi-cc! (list '+ (list '* 0 q) (list '* mv k)))
                 (subst (dk-cite! 'cc-nf-add-apply (list '* 0 q) (list '* mv k)))
                 (subst (dk-cite! 'cc-nf-add-apply psn (list '+ (list '* 0 q) (list '* mv k))))
                 (subst (dk-cite! 'cc-series-partial-sum-succ H n))
                 (dk-lam-b!)
                 (let* ((rv (dk-name! (list 'recip sn) 'CC)))
                   (subst (list '= (list 'recip sn) rv))
                   (dk-have! (list '= (list '* sn rv) 1)
                     (lambda ()
                       (subst (list '= rv (list 'recip sn)))
                       (cpi-and! (list 'IN sn 'CC) (list 'NOT (list '= sn 0)))
                       (dk-cite! 'cc-recip-inverse sn)
                       (ass)))
                   (let* ((pv (dk-name! psn 'CC)) (_a (subst (list '= psn pv)))
                          (qv (dk-name! q 'CC)) (_b (subst (list '= q qv)))
                          (q0v (dk-name! q0 'CC)) (_c (subst (list '= q0 q0v)))
                          (cv (dk-name! cn 'CC)) (_d (subst (list '= cn cv)))
                          (sv (dk-name! sn 'CC)) (_e (subst (list '= sn sv)))
                          (lhs (list '* (list '* sv q0v) (list '* cv rv)))
                          (mid (list '* (list '* cv q0v) (list '* sv rv))))
                     (dk-have! (list '= (list '* sv rv) 1)
                       (lambda () (subst (list '= sv sn)) (ass)))
                     (dk-have! (list '= lhs mid) (lambda () (crs)))
                     (subst (list '= lhs mid))
                     (subst (list '= (list '* sv rv) 1))
                     (crs)))))
             (subst (list '= gv sval))
             (ass))))
        (#t (ass)))))))
(qed 'cc-ps-antiderivative)

;;; =====================================================================
;;; (3) complex-analysis Corollary 3.3
;;; =====================================================================
(sp (make-wff '(FORALL f (IMPLIES (IS-POLY-FN-ON CC CC f)
  (FORALL pgam (FORALL dgam (FORALL a (FORALL b
    (IMPLIES (IS-ROAD pgam dgam a b)
      (IMPLIES (= (pgam b) (pgam a))
        (= (LINE-INT f pgam dgam a b) 0)))))))))))
(dk-peel!)
(cpi-setup!)
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'IS-POLY-FN-ON (dk-pick (dk-head? 'IS-POLY-FN-ON) "the polynomial")))))
(let* ((n (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm 'CC-SERIES-PARTIAL-SUM)))
                               "the length")))
       (c (begin (dk-split-all!)
                 (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm 'CC-SERIES-PARTIAL-SUM)))
                                      "the coefficients"))))
       (vf (begin (dk-split-all!)
                  (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'CC-SERIES-PARTIAL-SUM)
                                             (dk-contains? fm 'f)))
                           "the values of f")))
       (F (dk-skolem! (dk-cite! 'cc-ps-antiderivative n c)))
       (dfa (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'IS-DIFF-ON) (dk-contains? fm F)))
                     "F' = the power sum")))
  (dk-have! (list 'HOLOMORPHIC-ON 'CC F)
    (lambda ()
      (mac 'HOLOMORPHIC-ON)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-head-is? (dk-goal) 'FORALL))
              (ass)
              (let* ((z (dk-di-var!))
                     (d (dk-apply! dfa z)))
                (ew (list-ref d 5))
                (ass)))))))
  (dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES '(IN hbz_ CC)
              (list 'IS-DIFF-ON cpi-K 'CC F 'hbz_ '(f hbz_))))
    (lambda ()
      (let* ((z (dk-di-var!)))
        (dk-apply! dfa z)
        (subst (dk-apply! vf z))
        (ass))))
  (fact 'is-road-is-path 'pgam 'dgam 'a 'b)
  (fact 'is-path-in-fun 'pgam 'a 'b)
  (fact 'trace-subset-cc 'pgam 'a 'b)
  (dk-cite! 'line-int-closed-road-of-derivative 'CC F 'f 'pgam 'dgam 'a 'b)
  (ass))
(qed 'poly-fn-closed-road-integral)
