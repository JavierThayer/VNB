;;; Prop 1.12, (<=): the bound gives continuity (the preimage of an open set is open)
(define tbc-top1 '(SEMINORM-TOP m1 ix1 pf1))
(define tbc-top2 '(SEMINORM-TOP m2 ix2 pf2))
(define tbc-opens1 '(SEP snu_ (POWER (VEC m1)) (IS-SN-OPEN m1 ix1 pf1 snu_)))
(define (tbc-sub m a b) (list (list 'VADD m) a (list (list 'VNEG m) b)))
(define tbc-cont-stmt
  (tbc-alls '(fld m1 ix1 pf1 m2 ix2 pf2 tt)
    (tbc-imps (list tbc-fam1 tbc-fam2 tbc-lin tbc-allb)
      (list 'IS-HOM-TOP-SPACE tbc-top1 tbc-top2 'tt))))
(sp (make-wff tbc-cont-stmt))
(dk-peel!)
(tbc-fam-parts!)
(dk-cite! 'sntop-is-top-space 'fld 'm1 'ix1 'pf1)
(dk-cite! 'sntop-is-top-space 'fld 'm2 'ix2 'pf2)
(dk-cite! 'sntop-pts 'm1 'ix1 'pf1)
(dk-cite! 'sntop-pts 'm2 'ix2 'pf2)
(dk-cite! 'sntop-opens 'm1 'ix1 'pf1)
(mac 'is-hom-top-space-def)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? g 'IN)
         (subst (list '== (list 'PTS tbc-top1) '(VEC m1)))
         (subst (list '== (list 'PTS tbc-top2) '(VEC m2)))
         (dk-ass!))
        (#t
         (let* ((u (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
                (pp (list 'PREIMAGE tbc-top1 'tt u)))
           (subst (list '== (list 'OPENS tbc-top1) tbc-opens1))
           (dk-have! (list 'IN (list 'PTS tbc-top1) 'SET) (lambda () (subst (list '== (list 'PTS tbc-top1) '(VEC m1))) (dk-ass!)))
           ;; preimage-in-power, proved in place: its home, compact-image, loads AFTER this file
           (dk-have! (list 'IN pp (list 'POWER (list 'PTS tbc-top1)))
             (lambda ()
               (dk-have! (list 'IN pp 'SET) (lambda () (mac 'PREIMAGE) (sep-set) (ass)))
               (dk-have! (list 'FORALL 'tbcz_ (list 'IMPLIES (list 'IN 'tbcz_ pp) (list 'IN 'tbcz_ (list 'PTS tbc-top1))))
                 (lambda ()
                   (let ((e (dk-di-var!)))
                     (mac-h 'preimage-membership (list 'IN e pp))
                     (dk-split-all!)
                     (ass))))
               (fact 'power-mem-intro (list 'PTS tbc-top1) pp)
               (ass)))
           (dk-rewrite-h! (list 'IN pp (list 'POWER (list 'PTS tbc-top1))) (list 'PTS tbc-top1) '(VEC m1))
           (in-sep!
             (lambda () (dk-ass!))
             (lambda ()
               (mac 'is-sn-open)
               (dk-conj-close!
                 (lambda ()
                   (if (dk-head-is? (dk-goal) 'SUBSET)
                       (begin
                         (mac 'subset-def)
                         (let* ((w (dk-di-var!))
                                (pm (dk-cite! 'preimage-membership tbc-top1 'tt u w))
                                (pm2 (dk-rewrite-h! pm (list 'PTS tbc-top1) '(VEC m1))))
                           (if (dk-only! pm2 (list 'IN w pp)) (prop))))
                       (let* ((x (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
                              (pm (dk-rewrite-h! (dk-cite! 'preimage-membership tbc-top1 'tt u x) (list 'PTS tbc-top1) '(VEC m1)))
                              (_1 (dk-have! (list 'AND (list 'IN x '(VEC m1)) (list 'IN (list 'tt x) u))
                                    (lambda () (if (dk-only! pm (list 'IN x pp)) (prop)))))
                              (_2 (dk-split! (list 'AND (list 'IN x '(VEC m1)) (list 'IN (list 'tt x) u))))
                              (ex (dk-cite! 'sntop-open-basic 'fld 'm2 'ix2 'pf2 u (list 'tt x)))
                              (gg (dk-skolem! ex #t))
                              (ep (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f gg))) "radius") #t))
                              (b2 (list 'SN-BALL 'm2 'pf2 gg (list 'tt x) ep))
                              (cmb (dk-apply! (dk-cite! 'sn-bound-combine 'fld 'm1 'ix1 'pf1 'm2 'ix2 'pf2 'tt) gg))
                              (ff (dk-skolem! cmb #t))
                              (cb (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f ff))) "constant") #t))
                              (body (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f cb))) "the joint bound")))
                         (dk-cite! 'rr-pos-rr-in-rr ep) (dk-cite! 'rr-lt-of-pos-rr ep)
                         (dk-cite! 'rr-lt-of-pos-rr cb)
                         (dk-have! (list '<= 0 cb) (lambda () (dk-ineq! (list '< 0 cb) (list 'IN cb 'RR))))
                         (let* ((dd (dk-skolem! (dk-cite! 'rr-scale-eps cb ep) #t))
                                (sc (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f dd))) "scale")))
                           (dk-cite! 'rr-pos-rr-in-rr dd) (dk-cite! 'rr-lt-of-pos-rr dd)
                           (dk-have! (list '<= 0 dd) (lambda () (dk-ineq! (list '< 0 dd) (list 'IN dd 'RR))))
                           (ew ff)
                           (dk-conj-close!
                             (lambda ()
                               (if (not (dk-ass!))
                                   (begin
                                     (ew dd)
                                     (dk-conj-close!
                                       (lambda ()
                                         (if (not (dk-ass!))
                                             (begin
                                               (mac 'subset-def)
                                               (let* ((y (dk-di-var!))
                                                      (bi (dk-cite! 'sn-ball-membership 'm1 'pf1 ff x dd y))
                                                      (br (caddr bi)))
                                                 (dk-have! br (lambda () (if (dk-only! bi (list 'IN y (list 'SN-BALL 'm1 'pf1 ff x dd))) (prop))))
                                                 (dk-split! br)
                                                 (let* ((yx (tbc-sub 'm1 y x))
                                                        (ty (list 'tt y))
                                                        (b2i (dk-cite! 'sn-ball-membership 'm2 'pf2 gg (list 'tt x) ep ty))
                                                        (b2r (caddr b2i)))
                                                   (dk-cite! 'module-vneg-type 'm1 x)
                                                   (dk-cite! 'module-vadd-type 'm1 y (list '(VNEG m1) x))
                                                   (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) y)
                                                   (dk-cite! 'frm-linear-sub 'm1 'm2 'tt y x)
                                                   (dk-have! b2r
                                                     (lambda ()
                                                       (dk-conj-close!
                                                         (lambda ()
                                                           (if (not (dk-ass!))
                                                               (let* ((j (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
                                                                      (dlt (tbc-sub 'm2 ty (list 'tt x))))
                                                                 (dk-cite! 'subset-mem-fwd gg 'ix2 j)
                                                                 (tbc-qval! j yx)
                                                                 (let ((le (dk-apply! body j yx dd)))
                                                                   (dk-rewrite-h! le (list 'tt yx) dlt))
                                                                 (dk-cite! 'rr-leq-reflexive dd)
                                                                 (dk-apply! sc dd)
                                                                 (dk-real! (list '* cb dd))
                                                                 (dk-rewrite-h! (list 'IN (list (list 'pf2 j) (list 'tt yx)) 'RR) (list 'tt yx) dlt)
                                                                 (dk-ineq! (list '<= (list (list 'pf2 j) dlt) (list '* cb dd))
                                                                           (list '<= (list '* cb dd) ep)
                                                                           (list 'IN (list (list 'pf2 j) dlt) 'RR)
                                                                           (list 'IN (list '* cb dd) 'RR) (list 'IN ep 'RR))))))))
                                                   (dk-have! (list 'IN ty b2) (lambda () (if (dk-only! b2i b2r) (prop))))
                                                   (dk-cite! 'subset-mem-fwd b2 u ty)
                                                   (let ((pmy (dk-rewrite-h! (dk-cite! 'preimage-membership tbc-top1 'tt u y)
                                                                             (list 'PTS tbc-top1) '(VEC m1))))
                                                     (if (dk-only! pmy (list 'IN y '(VEC m1)) (list 'IN ty u)) (prop))))))))))))))))))))))))))
(tbc-qed! 'sn-cont-of-bound)

;;; ---------------------------------------------------------------------------
;;; Prop 1.12, (=>), over the reals: continuity gives the bound (the notes' homogeneity argument, by
;;; contradiction: if q_j(Tx) > t / eps, rescale x by 1 / q_j(Tx) into the basic neighbourhood)
(define tbc-rfam1 '(IS-SEMINORM-FAMILY-ON RR-NORMED-FIELD m1 ix1 pf1))
(define tbc-rfam2 '(IS-SEMINORM-FAMILY-ON RR-NORMED-FIELD m2 ix2 pf2))
(define tbc-hom (list 'IS-HOM-TOP-SPACE tbc-top1 tbc-top2 'tt))
(define tbc-rrv '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define (tbc-rfam-parts!)
  (for-each (lambda (pr)
              (let ((h (car pr)) (c (cdr pr)))
                (if (not (dk-asm? c))
                    (dk-have! c (lambda () (mac-h 'IS-SEMINORM-FAMILY-ON (dk-ctx-form h)) (dk-split-all!) (ass))))))
            (list (cons tbc-rfam1 '(IS-MODULE m1)) (cons tbc-rfam1 '(IN pf1 (FUN ix1 (FUN (VEC m1) RR))))
                  (cons tbc-rfam1 '(IN ix1 SET)) (cons tbc-rfam1 (list '= '(SCAL m1) tbc-rrv))
                  (cons tbc-rfam1 '(FORALL sni_ (IMPLIES (IN sni_ ix1) (IS-SEMINORM RR-NORMED-FIELD m1 (pf1 sni_)))))
                  (cons tbc-rfam2 '(IS-MODULE m2)) (cons tbc-rfam2 '(IN pf2 (FUN ix2 (FUN (VEC m2) RR))))
                  (cons tbc-rfam2 '(IN ix2 SET)) (cons tbc-rfam2 (list '= '(SCAL m2) tbc-rrv))
                  (cons tbc-rfam2 '(FORALL sni_ (IMPLIES (IN sni_ ix2) (IS-SEMINORM RR-NORMED-FIELD m2 (pf2 sni_)))))))
  (if (not (dk-asm? '(IN tt (FUN (VEC m1) (VEC m2)))))
      (dk-have! '(IN tt (FUN (VEC m1) (VEC m2)))
        (lambda () (mac-h 'IS-LINEAR-MAP (dk-ctx-form tbc-lin)) (dk-split-all!) (ass))))
  (dk-cite! 'frm-module-vec-set 'm1)
  (dk-cite! 'frm-module-vec-set 'm2))
;;; (IN v (CARR (SCAL mi))) from (IN v RR)
(define (tbc-scal-of-rr! v mi)
  (let ((goal (list 'IN v (list 'CARR (list 'SCAL mi)))))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (subst (list '= (list 'SCAL mi) tbc-rrv))
            (subst (list '== (list 'CARR tbc-rrv) '(CARR RR-NORMED-FIELD)))
            (subst '(== (CARR RR-NORMED-FIELD) RR))
            (dk-ass!))))
    goal))
(define (tbc-single! j ix)
  (let ((pp (list 'PAIR j j)))
    (dk-cite! 'membership-implies-sethood j ix)
    (tbc-and! (list 'IN j 'SET) (list 'IN j 'SET))
    (dk-cite! 'pairing j j)
    (dk-cite! 'card-singleton j)
    (fact 'nn-zero-in)
    (dk-cite! 'nn-succ-closed 0)
    (dk-have! (list 'IN (list 'CARD pp) 'NN) (lambda () (subst (list '= (list 'CARD pp) '(succ 0))) (ass)))
    (dk-have! (list 'SUBSET pp ix)
      (lambda ()
        (mac 'subset-def)
        (let ((w (dk-di-var!)))
          (dk-cite! 'pair-self-eq j w)
          (subst (list '= w j))
          (ass))))
    (dk-cite! 'pair-self-member j)
    pp))

(define tbc-bnd-stmt
  (tbc-alls '(m1 ix1 pf1 m2 ix2 pf2 tt)
    (tbc-imps (list tbc-rfam1 tbc-rfam2 tbc-lin tbc-hom) tbc-allb)))
(sp (make-wff tbc-bnd-stmt))
(dk-peel!)
(tbc-rfam-parts!)
(fact 'rr-is-normed-field)
(dk-cite! 'normed-field-ring-view-carr 'RR-NORMED-FIELD)
(fact 'rr-nf-carr)
(dk-cite! 'sntop-pts 'm1 'ix1 'pf1)
(let* ((j (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'ix2) (symbol? (cadr f)))) "j")))
       (iff (dk-cite! 'is-hom-top-space-def tbc-top1 tbc-top2 'tt))
       (pre (caddr (caddr (caddr (caddr iff)))))
       (z1 '(VZERO m1)) (z2 '(VZERO m2))
       (pp (tbc-single! j 'ix2))
       (ww (list 'SN-OBALL 'm2 'pf2 pp z2 1))
       (pw (list 'PREIMAGE tbc-top1 'tt ww)))
  (dk-have! pre (lambda () (mac-h 'is-hom-top-space-def (dk-ctx-form tbc-hom)) (dk-split-all!) (ass)))
  (dk-cite! 'module-vzero-in 'm1) (dk-cite! 'module-vzero-in 'm2)
  (fact 'rr-one-in) (fact 'rr-zero-in)
  (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
  (dk-cite! 'rr-pos-rr-of-lt 1)
  (dk-cite! 'sntop-oball-open 'RR-NORMED-FIELD 'm2 'ix2 'pf2 pp z2 1)
  (dk-cite! 'sn-oball-center 'RR-NORMED-FIELD 'm2 'ix2 'pf2 pp z2 1)
  (inst*! pre ww)
  (dk-cite! 'frm-linear-zero 'm1 'm2 'tt)
  (dk-have! (list 'IN pw (list 'OPENS tbc-top1)) (lambda () (dk-ass!)))
  (let ((pm (dk-rewrite-h! (dk-cite! 'preimage-membership tbc-top1 'tt ww z1) (list 'PTS tbc-top1) '(VEC m1))))
    (dk-have! (list 'IN (list 'tt z1) ww) (lambda () (subst (list '= (list 'tt z1) z2)) (dk-ass!)))
    (dk-have! (list 'IN z1 pw) (lambda () (if (dk-only! pm (list 'IN z1 '(VEC m1)) (list 'IN (list 'tt z1) ww)) (prop)))))
  (let* ((ex (dk-cite! 'sntop-open-basic 'RR-NORMED-FIELD 'm1 'ix1 'pf1 pw z1))
         (ff (dk-skolem! ex #t))
         (ep (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f ff))) "radius") #t))
         (b1 (list 'SN-BALL 'm1 'pf1 ff z1 ep))
         (cc (list 'recip ep)))
    (dk-cite! 'rr-pos-rr-in-rr ep) (dk-cite! 'rr-lt-of-pos-rr ep)
    (dk-have! (list 'NOT (list '= ep 0)) (lambda () (di) (dk-absurd! (list '= ep 0) (list '< 0 ep) (list 'IN ep 'RR))))
    (tbc-and! (list 'IN ep 'RR) (list 'NOT (list '= ep 0)))
    (dk-cite! 'rr-recip-closed ep)
    (dk-cite! 'rr-recip-pos ep)
    (dk-cite! 'rr-pos-rr-of-lt cc)
    (ew ff)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (ew cc)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (let* ((ld (dk-peel!))
                             (x (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC m1)))) ld))))
                             (t (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) ld))))
                             (pall (car (filter (lambda (f) (dk-head-is? f 'FORALL)) ld)))
                             (q (list (list 'pf2 j) (list 'tt x)))
                             (ct (list '* cc t)))
                        (tbc-qval! j x)
                        (dk-real! ct)
                        (use-em (list '<= q ct)
                          (lambda () (dk-ass!))
                          (lambda ()
                            (dk-cite! 'rr-not-le-lt q ct)
                            (tbc-and! (list 'IN cc 'RR) (list 'IN t 'RR))
                            (dk-have! (list '<= 0 cc) (lambda () (dk-ineq! (list '< 0 cc) (list 'IN cc 'RR))))
                            (tbc-and! (list '<= 0 cc) (list '<= 0 t))
                            (dk-cite! 'rr-leq-mul-nonneg cc t)
                            (dk-have! (list '< 0 q) (lambda () (dk-ineq! (list '< ct q) (list '<= 0 ct) (list 'IN ct 'RR) (list 'IN q 'RR))))
                            (dk-cite! 'rr-mul-comm cc t)
                            (let* ((tc (list '* t cc))
                                   (lt1 (dk-rewrite-h! (list '< ct q) ct tc))
                                   (sw (dk-cite! 'rr-recip-swap-lt t q ep))
                                   (lam (list 'recip q)))
                              (dk-have! (list 'NOT (list '= q 0)) (lambda () (di) (dk-absurd! (list '= q 0) (list '< 0 q) (list 'IN q 'RR))))
                              (tbc-and! (list 'IN q 'RR) (list 'NOT (list '= q 0)))
                              (dk-cite! 'rr-recip-closed q)
                              (dk-cite! 'rr-recip-pos q)
                              (dk-cite! 'rr-recip-inverse q)
                              (dk-have! (list '<= 0 lam) (lambda () (dk-ineq! (list '< 0 lam) (list 'IN lam 'RR))))
                              (dk-cite! 'rr-abs-of-nonneg lam)
                              (dk-cite! 'rr-nf-fnrm-apply lam)
                              (tbc-scal-of-rr! lam 'm1)
                              (tbc-scal-of-rr! lam 'm2)
                              (let* ((y (list '(ACT m1) lam x))
                                     (ty1 (dk-cite! 'module-act-type 'm1 lam x))
                                     (bi (dk-cite! 'sn-ball-membership 'm1 'pf1 ff z1 ep y))
                                     (br (caddr bi)))
                                (dk-cite! 'module-act-type 'm1 lam x)
                                (dk-cite! 'frm-v-sub-zero 'm1 y)
                                (dk-have! br
                                  (lambda ()
                                    (dk-conj-close!
                                      (lambda ()
                                        (if (not (dk-ass!))
                                            (let* ((i (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
                                                   (pi (list 'pf1 i))
                                                   (px (list pi x)) (py (list pi y)))
                                              (subst (list '= (list '(VADD m1) y (list '(VNEG m1) z1)) y))
                                              (dk-cite! 'subset-mem-fwd ff 'ix1 i)
                                              (inst*! (dk-ctx-form '(FORALL sni_ (IMPLIES (IN sni_ ix1) (IS-SEMINORM RR-NORMED-FIELD m1 (pf1 sni_))))) i)
                                              (dk-cite! 'fun-apply-type-c 'pf1 'ix1 '(FUN (VEC m1) RR) i)
                                              (dk-cite! 'fun-apply-type-c pi '(VEC m1) 'RR x)
                                              (dk-cite! 'fun-apply-type-c pi '(VEC m1) 'RR y)
                                              (inst*! pall i)
                                              (let* ((h (dk-cite! 'frm-sn-homog 'RR-NORMED-FIELD 'm1 pi lam x))
                                                     (h2 (dk-rewrite-h! h (list '(FNRM RR-NORMED-FIELD) lam) (list 'abs lam)))
                                                     (h3 (dk-rewrite-h! h2 (list 'abs lam) lam)))
                                                (dk-cite! 'rr-mul-le-right px t lam)
                                                (tbc-and! (list 'IN lam 'RR) (list 'IN px 'RR))
                                                (dk-cite! 'rr-mul-comm lam px)
                                                (for-each dk-real! (list (list '* lam px) (list '* px lam) (list '* t lam)))
                                                (let* ((n1 (dk-name! (list '* lam px)))
                                                       (n2 (dk-name! (list '* px lam)))
                                                       (n3 (dk-name! (list '* t lam)))
                                                       (rw (lambda (f)
                                                             (fold-left (lambda (f pr) (if (dk-contains? f (car pr)) (dk-rewrite-h! f (car pr) (cdr pr)) f))
                                                                        f (list (cons (list '* lam px) n1) (cons (list '* px lam) n2)
                                                                                (cons (list '* t lam) n3))))))
                                                  (apply dk-ineq!
                                                         (append (map rw (list h3 (list '= (list '* lam px) (list '* px lam))
                                                                               (list '<= (list '* px lam) (list '* t lam))
                                                                               (list '< (list '* t lam) ep)))
                                                                 (list (list 'IN py 'RR) (list 'IN ep 'RR)
                                                                       (list 'IN n1 'RR) (list 'IN n2 'RR) (list 'IN n3 'RR))))))))))))
                                (dk-have! (list 'IN y b1) (lambda () (if (dk-only! bi br) (prop))))
                                (dk-cite! 'subset-mem-fwd b1 pw y)
                                (let* ((pm (dk-rewrite-h! (dk-cite! 'preimage-membership tbc-top1 'tt ww y) (list 'PTS tbc-top1) '(VEC m1)))
                                       (ty (list 'tt y)))
                                  (dk-have! (list 'IN ty ww) (lambda () (if (dk-only! pm (list 'IN y pw)) (prop))))
                                  (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) y)
                                  (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) x)
                                  (let* ((oi (dk-cite! 'sn-oball-membership 'm2 'pf2 pp z2 1 ty))
                                         (orr (caddr oi)))
                                    (dk-have! orr (lambda () (if (dk-only! oi (list 'IN ty ww)) (prop))))
                                    (dk-split! orr)
                                    (let* ((e (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f ty))) "margin") #t))
                                           (bd (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f e))) "bound at j")))
                                      (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e)
                                      (inst*! bd j)
                                      (dk-cite! 'frm-v-sub-zero 'm2 ty)
                                      (dk-cite! 'frm-linear-homog 'm1 'm2 'tt lam x)
                                      (inst*! (dk-ctx-form '(FORALL sni_ (IMPLIES (IN sni_ ix2) (IS-SEMINORM RR-NORMED-FIELD m2 (pf2 sni_))))) j)
                                      (let* ((qj (list 'pf2 j))
                                             (tx (list 'tt x))
                                             (h (dk-cite! 'frm-sn-homog 'RR-NORMED-FIELD 'm2 qj lam tx))
                                             (h2 (dk-rewrite-h! h (list '(FNRM RR-NORMED-FIELD) lam) (list 'abs lam)))
                                             (h3 (dk-rewrite-h! h2 (list 'abs lam) lam))
                                             (b0 (dk-pick (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f e))) "the bound"))
                                             (b1x (dk-rewrite-h! b0 (list '(VADD m2) ty (list '(VNEG m2) z2)) ty))
                                             (b2x (dk-rewrite-h! b1x ty (list '(ACT m2) lam tx))))
                                        (tbc-and! (list 'IN q 'RR) (list 'IN lam 'RR))
                                        (dk-cite! 'rr-mul-comm q lam)
                                        (for-each dk-real! (list (list '* lam q) (list '* q lam)))
                                        (dk-cite! 'module-act-type 'm2 lam tx)
                                        (dk-cite! 'fun-apply-type-c qj '(VEC m2) 'RR (list '(ACT m2) lam tx))
                                        (let* ((n1 (dk-name! (list '* lam q)))
                                               (n2 (dk-name! (list '* q lam)))
                                               (rw (lambda (f)
                                                     (fold-left (lambda (f pr) (if (dk-contains? f (car pr)) (dk-rewrite-h! f (car pr) (cdr pr)) f))
                                                                f (list (cons (list '* lam q) n1) (cons (list '* q lam) n2))))))
                                          (pbc)
                                          (apply dk-absurd!
                                                 (append (map rw (list h3 b2x (list '= (list '* q lam) (list '* lam q))
                                                                       (list '= (list '* q lam) 1)))
                                                         (list (list '< 0 e) (list 'IN e 'RR) (list 'IN n1 'RR) (list 'IN n2 'RR)
                                                               (list 'IN (list qj (list '(ACT m2) lam tx)) 'RR)))))))))))))))))))))))
(tbc-qed! 'sn-bound-of-cont)

;;; ---------------------------------------------------------------------------
;;; PROP 1.12 (over the reals, as the notes): continuous iff bounded by the seminorms
(define tbc-iff-stmt
  (tbc-alls '(m1 ix1 pf1 m2 ix2 pf2 tt)
    (tbc-imps (list tbc-rfam1 tbc-rfam2 tbc-lin) (list 'IFF tbc-hom tbc-allb))))
(sp (make-wff tbc-iff-stmt))
(dk-peel!)
(dk-iff! (lambda (g) (or (dk-head-is? g 'FORALL) (and (dk-head-is? g 'IMPLIES) (dk-head-is? (cadr g) 'IS-HOM-TOP-SPACE))))
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
    (dk-cite! 'sn-bound-of-cont 'm1 'ix1 'pf1 'm2 'ix2 'pf2 'tt)
    (dk-ass!))
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
    (dk-cite! 'sn-cont-of-bound 'RR-NORMED-FIELD 'm1 'ix1 'pf1 'm2 'ix2 'pf2 'tt)
    (dk-ass!)))
(tbc-qed! 'sn-cont-iff-bound)
