;;; tb-cont.scm -- topological-vector-space.pdf Prop 1.12 / Cor 1.13: a linear map between spaces with
;;; separating families of seminorms is continuous iff every q_j(Tx) is bounded by C max(p_i1(x), ..., p_ik(x)).
;;; Agent TB-01, 2026-10-26.  DESTINATION: theorem-library/tvs-continuity.scm (after tvs-seminorm-tvs).
;;; Library: analysis.  Helper prefix: tbc-.
;;;
;;; "q_j(Tx) <= C max(p_i1(x), ..., p_ik(x))" is stated without forming the maximum: for every t >= 0 with
;;; p_i(x) <= t for all i in the finite set ff, q_j(Tx) <= C t (take t = the maximum; an empty ff reads
;;; max = 0).

(define (tbc-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (tbc-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (tbc-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define (tbc-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))))
(define tbc-fam1 '(IS-SEMINORM-FAMILY-ON fld m1 ix1 pf1))
(define tbc-fam2 '(IS-SEMINORM-FAMILY-ON fld m2 ix2 pf2))
(define tbc-lin '(IS-LINEAR-MAP m1 m2 tt))
;;; the bound of q_j by the finite set ff of p's with constant cb, for all x and t
(define (tbc-bound-body j ff cb)
  (list 'FORALL 'sbx_ (list 'IMPLIES '(IN sbx_ (VEC m1))
    (list 'FORALL 'sbt_ (list 'IMPLIES '(IN sbt_ RR) (list 'IMPLIES '(<= 0 sbt_)
      (list 'IMPLIES (list 'FORALL 'sbi_ (list 'IMPLIES (list 'IN 'sbi_ ff) '(<= ((pf1 sbi_) sbx_) sbt_)))
        (list '<= (list (list 'pf2 j) '(tt sbx_)) (list '* cb 'sbt_)))))))))
(define (tbc-exists-bound inner)   ; FORSOME ff finite in ix1, FORSOME cb > 0, INNER(ff, cb)
  (list 'FORSOME 'sbf_ (list 'AND '(IN sbf_ SET) (list 'AND '(IN (CARD sbf_) NN) (list 'AND '(SUBSET sbf_ ix1)
    (list 'FORSOME 'sbc_ (list 'AND '(IN sbc_ RR) (list 'AND '(POS-RR sbc_) (inner 'sbf_ 'sbc_)))))))))
(define (tbc-bound j) (tbc-exists-bound (lambda (ff cb) (tbc-bound-body j ff cb))))
(define tbc-allb (list 'FORALL 'sbj_ (list 'IMPLIES '(IN sbj_ ix2) (tbc-bound 'sbj_))))
(define (tbc-gbound gg)
  (tbc-exists-bound (lambda (ff cb) (list 'FORALL 'sbj_ (list 'IMPLIES (list 'IN 'sbj_ gg) (tbc-bound-body 'sbj_ ff cb))))))

(define (tbc-fam-parts!)
  (for-each (lambda (pr)
              (let ((h (car pr)) (c (cdr pr)))
                (if (not (dk-asm? c))
                    (dk-have! c (lambda () (mac-h 'IS-SEMINORM-FAMILY-ON (dk-ctx-form h)) (dk-split-all!) (ass))))))
            (list (cons tbc-fam1 '(IS-MODULE m1)) (cons tbc-fam1 '(IN pf1 (FUN ix1 (FUN (VEC m1) RR))))
                  (cons tbc-fam1 '(IN ix1 SET))
                  (cons tbc-fam2 '(IS-MODULE m2)) (cons tbc-fam2 '(IN pf2 (FUN ix2 (FUN (VEC m2) RR))))
                  (cons tbc-fam2 '(IN ix2 SET))))
  (if (not (dk-asm? '(IN tt (FUN (VEC m1) (VEC m2)))))
      (dk-have! '(IN tt (FUN (VEC m1) (VEC m2)))
        (lambda () (mac-h 'IS-LINEAR-MAP (dk-ctx-form tbc-lin)) (dk-split-all!) (ass))))
  (dk-cite! 'frm-module-vec-set 'm1)
  (dk-cite! 'frm-module-vec-set 'm2))
;;; (IN ((pf2 j) (tt x)) RR) with j in ix2, x in VEC m1
(define (tbc-qval! j x)
  (let ((ty (list 'IN (list (list 'pf2 j) (list 'tt x)) 'RR)))
    (if (not (dk-asm? ty))
        (begin
          (dk-cite! 'fun-apply-type-c 'tt '(VEC m1) '(VEC m2) x)
          (if (not (dk-asm? (list 'IN (list 'pf2 j) '(FUN (VEC m2) RR))))
              (dk-cite! 'fun-apply-type-c 'pf2 'ix2 '(FUN (VEC m2) RR) j))
          (dk-cite! 'fun-apply-type-c (list 'pf2 j) '(VEC m2) 'RR (list 'tt x))))
    ty))
;;; from the bound body of q_j with (ff, cb) at (x, t), all antecedents in context except the p-bounds,
;;; which are proved from the p-bounds over ff2 (a superset of ff): land q_j(tt x) <= cb t
(define (tbc-use-body! body js x t ff ff2)
  (let ((allf (list 'FORALL 'sbi_ (list 'IMPLIES (list 'IN 'sbi_ ff) (list '<= (list '(pf1 sbi_) x) t))))
        (allf2 (list 'FORALL 'sbi_ (list 'IMPLIES (list 'IN 'sbi_ ff2) (list '<= (list '(pf1 sbi_) x) t)))))
    (if (not (dk-asm? allf))
        (dk-have! allf
          (lambda ()
            (let ((i (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
              (dk-cite! 'subset-mem-fwd ff ff2 i)
              (inst*! (dk-ctx-form allf2) i)
              (dk-ass!)))))
    (apply dk-apply! body (append js (list x t)))))

;;; ---------------------------------------------------------------------------
;;; finitely many q_j share one bound (finite-set-induction on the set of j's)
(define tbc-ccls (list 'COMP 'gs_ (list 'IMPLIES '(SUBSET gs_ ix2) (tbc-gbound 'gs_))))
(define tbc-cstep
  (list 'FORALL 'is_
    (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ tbc-ccls)))
      (list 'FORALL 'ix_
        (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
          (list 'IN '(UNION is_ (PAIR ix_ ix_)) tbc-ccls))))))
(define tbc-combine-stmt
  (tbc-alls '(fld m1 ix1 pf1 m2 ix2 pf2 tt)
    (tbc-imps (list tbc-fam1 tbc-fam2 tbc-lin tbc-allb)
      (list 'FORALL 'gg (tbc-imps '((IN gg SET) (IN (CARD gg) NN) (SUBSET gg ix2)) (tbc-gbound 'gg))))))
(sp (make-wff tbc-combine-stmt))
(dk-peel!)
(tbc-fam-parts!)
;; base: the empty set of j's, with ff empty and cb = 1
(dk-have! (list 'IN 'EMPTY-SET tbc-ccls)
  (lambda ()
    (for-each
      (lambda (leaf)
        (dk-focus! leaf)
        (if (equal? (dk-goal) '(IN EMPTY-SET SET))
            (begin (fact 'empty-set-is-set) (ass))
            (begin
              (dk-peel!)
              (fact 'empty-set-is-set) (fact 'card-empty) (fact 'nn-zero-in)
              (dk-have! '(IN (CARD EMPTY-SET) NN) (lambda () (subst '(= (CARD EMPTY-SET) 0)) (ass)))
              (fact 'empty-subset-any 'ix1)
              (fact 'rr-one-in)
              (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
              (dk-cite! 'rr-pos-rr-of-lt 1)
              (ew 'EMPTY-SET)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin
                        (ew 1)
                        (dk-conj-close!
                          (lambda ()
                            (if (not (dk-ass!))
                                (let ((j (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                                  (fact 'empty-set-has-no-members j)
                                  (ai (list 'NOT (list 'IN j 'EMPTY-SET))))))))))))))
      (dk-opened (lambda () (comp-mi))))
    ))
;; step
(dk-have! tbc-cstep
  (lambda ()
    (let* ((landed (dk-peel!))
           (uu (cadr (dk-goal)))
           (sv (cadr uu))
           (xv (cadr (caddr uu)))
           (pp (list 'PAIR xv xv)))
      (dk-split-all! landed)
      (tbc-and! (list 'IN xv 'SET) (list 'IN xv 'SET))
      (fact 'pairing xv xv)
      (tbc-and! (list 'IN sv 'SET) (list 'IN pp 'SET))
      (fact 'union-set-closure sv pp)
      (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv tbc-ccls)))))
             (ih (car (filter (lambda (f) (dk-head-is? f 'IMPLIES)) ls))))
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) (list 'IN uu 'SET))
                (ass)
                (begin
                  (dk-peel!)
                  (dk-have! (list 'SUBSET sv 'ix2)
                    (lambda ()
                      (mac 'subset-def)
                      (let ((w (dk-di-var!)))
                        (dk-cite! 'union-membership sv pp w)
                        (dk-cite! 'subset-mem-fwd uu 'ix2 w)
                        (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop)))))
                  (dk-cite! 'pair-self-member xv)
                  (let ((ui (dk-cite! 'union-membership sv pp xv)))
                    (dk-have! (list 'IN xv uu) (lambda () (if (dk-only! (list 'IN xv pp) ui) (prop)))))
                  (dk-cite! 'subset-mem-fwd uu 'ix2 xv)
                  (detach! ih)
                  (let* ((f1 (dk-skolem! (caddr ih) #t))
                         (c1 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f f1))) "c1") #t))
                         (b1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f c1))) "body 1"))
                         (hb (inst*! (dk-ctx-form tbc-allb) xv))
                         (f0 (dk-skolem! hb #t))
                         (c0 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f f0))) "c0") #t))
                         (b0 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f c0))) "body 0"))
                         (fu (list 'UNION f1 f0))
                         (cu (list '+ c1 c0)))
                    (dk-cite! 'rr-pos-rr-in-rr c1) (dk-cite! 'rr-lt-of-pos-rr c1)
                    (dk-cite! 'rr-pos-rr-in-rr c0) (dk-cite! 'rr-lt-of-pos-rr c0)
                    (tbc-and! (list 'IN f1 'SET) (list 'IN f0 'SET))
                    (dk-cite! 'union-set-closure f1 f0)
                    (dk-cite! 'card-union-nn f1 f0)
                    (dk-have! (list 'SUBSET fu 'ix1)
                      (lambda ()
                        (mac 'subset-def)
                        (let ((w (dk-di-var!)))
                          (dk-cite! 'union-membership f1 f0 w)
                          (dk-cite! 'subset-mem-fwd f1 'ix1 w) (dk-cite! 'subset-mem-fwd f0 'ix1 w)
                          (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop)))))
                    (dk-have! (list 'SUBSET f1 fu)
                      (lambda () (mac 'subset-def)
                        (let ((w (dk-di-var!))) (dk-cite! 'union-membership f1 f0 w)
                          (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop)))))
                    (dk-have! (list 'SUBSET f0 fu)
                      (lambda () (mac 'subset-def)
                        (let ((w (dk-di-var!))) (dk-cite! 'union-membership f1 f0 w)
                          (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop)))))
                    (dk-have! (list 'IN cu 'RR) (lambda () (type-term)))
                    (dk-have! (list '< 0 cu) (lambda () (dk-ineq! (list '< 0 c1) (list '< 0 c0) (list 'IN c1 'RR) (list 'IN c0 'RR))))
                    (dk-cite! 'rr-pos-rr-of-lt cu)
                    (dk-have! (list '<= c1 cu) (lambda () (dk-ineq! (list '< 0 c0) (list 'IN c1 'RR) (list 'IN c0 'RR))))
                    (dk-have! (list '<= c0 cu) (lambda () (dk-ineq! (list '< 0 c1) (list 'IN c1 'RR) (list 'IN c0 'RR))))
                    (ew fu)
                    (dk-conj-close!
                      (lambda ()
                        (if (not (dk-ass!))
                            (begin
                              (ew cu)
                              (dk-conj-close!
                                (lambda ()
                                  (if (not (dk-ass!))
                                      (let* ((ld (dk-peel!))
                                             (j (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) uu))) ld))))
                                             (x (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC m1)))) ld))))
                                             (t (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) ld)))))
                                        (dk-cite! 'subset-mem-fwd uu 'ix2 j)
                                        (tbc-qval! j x)
                                        (dk-cite! 'union-membership sv pp j)
                                        (use-em (list 'IN j sv)
                                          (lambda ()
                                            (tbc-use-body! b1 (list j) x t f1 fu)
                                            (dk-cite! 'rr-mul-le-right c1 cu t)
                                            (dk-real! (list '* c1 t)) (dk-real! (list '* cu t))
                                            (dk-ineq! (list '<= (list (list 'pf2 j) (list 'tt x)) (list '* c1 t))
                                                      (list '<= (list '* c1 t) (list '* cu t))
                                                      (list 'IN (list (list 'pf2 j) (list 'tt x)) 'RR)
                                                      (list 'IN (list '* c1 t) 'RR) (list 'IN (list '* cu t) 'RR)))
                                          (lambda ()
                                            (let ((ui (dk-pick (lambda (f) (and (dk-head-is? f 'IFF) (equal? (cadr f) (list 'IN j uu)))) "union iff j")))
                                              (dk-have! (list 'IN j pp) (lambda () (if (dk-only! (list 'IN j uu) (list 'NOT (list 'IN j sv)) ui) (prop)))))
                                            (dk-cite! 'pair-self-eq xv j)
                                            (subst (list '= j xv))
                                            (tbc-qval! xv x)
                                            (tbc-use-body! b0 '() x t f0 fu)
                                            (dk-cite! 'rr-mul-le-right c0 cu t)
                                            (dk-real! (list '* c0 t)) (dk-real! (list '* cu t))
                                            (dk-ineq! (list '<= (list (list 'pf2 xv) (list 'tt x)) (list '* c0 t))
                                                      (list '<= (list '* c0 t) (list '* cu t))
                                                      (list 'IN (list (list 'pf2 xv) (list 'tt x)) 'RR)
                                                      (list 'IN (list '* c0 t) 'RR) (list 'IN (list '* cu t) 'RR))))))))))))))))
          (dk-opened (lambda () (comp-mi))))))))
(tbc-and! (list 'IN 'EMPTY-SET tbc-ccls) tbc-cstep)
(let* ((ind (dk-fact! 'finite-set-induction tbc-ccls))
       (gv (cadr (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (cadr f) 'CARD))) "the finite set")))))
  (tbc-and! (list 'IN gv 'SET) (list 'IN (list 'CARD gv) 'NN))
  (let* ((inc (dk-apply! ind gv))
         (pc (car (filter (lambda (f) (dk-head-is? f 'IMPLIES)) (dk-landed (lambda () (comp-me inc)))))))
    (detach! pc)
    (dk-ass!)))
(tbc-qed! 'sn-bound-combine)

