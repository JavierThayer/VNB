;;; mb67-prod2.scm -- the product of two Polish spaces is Polish (M-B67, 2026-10-26); X x N^N Polish (for 5.38).
;;;   product2-complete, product2-separable, product2-polish, product2-baire-polish
;;; Library: measure.  Helper prefixes mr- (copied) and mpq-.
;;; Load window: after mb67-baire (baire-ms-polish), mb4-vocab (IS-POLISH), the PRODUCT2-MS laws (product2-*).
(define (mr-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (mr-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (mr-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
(define (mr-iff-parts! iff)
  ;; the conjunct equal to the focus GOAL (if any) is projected LAST: proving it closes the leaf, and a
  ;; projection after that would fire on a sibling (focus drift)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc)))))
         (goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
         (opener (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
         (rest (filter (lambda (c) (not (goal? c))) cs))
         (last (filter goal? cs)))
    (append (mr-map (lambda (c) (mr-project! c opener)) rest)
            (mr-map (lambda (c) (mr-project! c opener)) last))))
(define (mr-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (mr-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))
(define (mr-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
(define (mr-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
(define (mr-ne! a b lt)
  (dk-have! (list 'NOT (list '= a b))
    (lambda ()
      (di)
      (dk-have! '(< 0 0) (lambda () (dk-ineq! lt (list '= a b))))
      (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
      (ai (dk-cite! 'rr-lt-irrefl 0)))))
(define (mr-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s0 (caddr m)) (v (cadr s0)) (dom (caddr s0))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s0)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "mr-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (ai (dk-ctx-form conj))))
    p))
(define (mr-and-close! closer)
  (if (dk-head-is? (dk-goal) 'AND)
      (for-each (lambda (k) (dk-focus! k) (mr-and-close! closer)) (dk-opened (lambda () (di))))
      (closer)))
(define (mr-find tag pred lst)
  (or (find-first pred lst) (error "mr-find: nothing matches at" tag (map expression->string lst))))
(define (mr-real! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-type! t 'RR)) (list 'IN t 'RR))
(define (mr-pos! e) (dk-cite! 'rr-pos-rr-in-rr e) (dk-cite! 'rr-lt-of-pos-rr e))
(define (mr-recip! k)              ; recip(k + 1), k in NN: typed, positive (idempotent)
  (let* ((k1 (list '+ k 1)) (rq (list 'RECIP k1)))
   (if (dk-asm? (list 'POS-RR rq))
    rq
    (begin
    (dk-cite! 'nn-in-rr k) (dk-type! k1 'RR)
    (dk-have! (list '< 0 k1) (lambda () (dk-cite! 'nn-zero-le k) (dk-ineq! (list '<= 0 k))))
    (mr-ne! k1 0 (list '< 0 k1))
    (mr-chain! (dk-fact! 'rr-recip-closed k1))
    (dk-cite! 'rr-recip-pos k1)
    (dk-cite! 'rr-pos-rr-of-lt rq)
    rq))))
(define (mr-sep-open! sp0)           ; IS-SEPARABLE(sp0) in context: is-metric-space and a dense sequence, returned
  (let* ((iff (dk-cite! 'is-separable sp0)) (rhs (caddr iff)) (ex (caddr rhs)))
    (dk-project! (list 'IS-METRIC-SPACE sp0) (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (dk-project! ex (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (let ((d (dk-skolem! ex))) (dk-split-all!) d)))
(define (mr-dense ds sp0) (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x (list 'PTS sp0)) (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
  (list 'FORSOME 'n (list 'AND '(IN n NN) (list '< (list (list 'DIST sp0) 'x (list ds 'n)) 'eps))))))))
(define (mr-iff-back! iff)           ; the right side of an IFF in context (proved by the caller): land the left side
  (ai iff)
  (detach! (list 'IMPLIES (caddr iff) (cadr iff))))

(define mpq-P '(PRODUCT2-MS s t))
(define mpq-C '(CARTESIAN (PTS s) (PTS t)))
(define (mpq-pt! p)                  ; p in PTS s x PTS t: p = [p1, p2], both typed; returns (p1 p2)
  (let ((p1 (list 'NTH 1 p)) (p2 (list 'NTH 2 p)))
    (if (not (dk-asm? (list 'IN p1 '(PTS s))))
        (begin
          (dk-split-all! (list (mr-chain! (dk-cite! 'cartesian-nth p '(PTS s) '(PTS t)))))
          (dk-cite! 'cartesian-pair-eq p '(PTS s) '(PTS t))))
    (list p1 p2)))
(define (mpq-dcomp! p q)             ; p, q in the product: d_s(p1, q1), d_t(p2, q2) <= d_P(p, q), all typed; returns d_P
  (let* ((pp (mpq-pt! p)) (qq (mpq-pt! q))
         (d1 (list '(DIST s) (car pp) (car qq))) (d2 (list '(DIST t) (cadr pp) (cadr qq)))
         (mx (list 'MAX d1 d2)) (dP (list (list 'DIST mpq-P) p q)))
    (if (not (dk-asm? (list '<= d1 dP)))
        (begin
          (dk-cite! 'metric-dist-real 's (car pp) (car qq))
          (dk-cite! 'metric-dist-real 't (cadr pp) (cadr qq))
          (dk-cite! 'rr-max-closed d1 d2)
          (dk-cite! 'rr-le-max-left d1 d2) (dk-cite! 'rr-le-max-right d1 d2)
          (dk-cite! 'product2-dist 's 't p q)
          (dk-have! (list 'IN dP 'RR) (lambda () (subst (list '= dP mx)) (mr-close-open!)))
          (dk-have! (list '<= d1 dP) (lambda () (subst (list '= dP mx)) (mr-close-open!)))
          (dk-have! (list '<= d2 dP) (lambda () (subst (list '= dP mx)) (mr-close-open!)))))
    dP))
(define (mpq-comp! u i sp cuu)       ; u Cauchy in P (eps-universal cuu): the i-th coordinate sequence is Cauchy in sp
  (let ((a (list 'VNB-LAMBDA 'mpk_ 'NN (list 'NTH i (list u 'mpk_)))))
    (dk-have! (list 'IN a (list 'FUN 'NN (list 'PTS sp)))
      (lambda ()
        (for-each (lambda (kn)
                    (if (not (sequent-node-grounded? kn))
                        (begin (dk-focus! kn)
                               (if (dk-asm? (dk-goal)) (ass)
                                   (let ((k (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!))))))
                                     (dk-cite! 'fun-apply-type-c u 'NN mpq-C k)
                                     (mpq-pt! (list u k))
                                     (mr-close-open!))))))
                  (dk-opened (lambda () (lam-t))))))
    (let ((iffc (dk-cite! 'is-cauchy-seq sp a)))
      (dk-have! (caddr iffc)
        (lambda ()
          (mr-and-close!
            (lambda ()
              (if (dk-asm? (dk-goal)) (ass)
                  (let* ((eps (cadr (car (dk-peel!))))
                         (n (dk-skolem! (dk-apply! cuu eps))))
                    (dk-split-all!)
                    (ew n)
                    (mr-and-close!
                      (lambda ()
                        (if (dk-asm? (dk-goal)) (ass)
                            (let* ((lm (dk-peel!))
                                   (ms (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lm)))
                                   (m1 (car ms)) (m2 (cadr ms))
                                   (cun (mr-find 'cun (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n) (dk-contains? f 'DIST) (not (dk-contains? f 'mpk_)))) (dk-asms)))
                                   (le (dk-apply! cun m1 m2)))
                              (dk-cite! 'fun-apply-type-c u 'NN mpq-C m1)
                              (dk-cite! 'fun-apply-type-c u 'NN mpq-C m2)
                              (let* ((dP (mpq-dcomp! (list u m1) (list u m2)))
                                     (di_ (list (list 'DIST sp) (list 'NTH i (list u m1)) (list 'NTH i (list u m2)))))
                                (dk-lam-b!)
                                (dk-cite! 'rr-pos-rr-in-rr eps)
                                (dk-ineq! (list '<= di_ dP) le (list 'IN dP 'RR) (list 'IN eps 'RR) (list 'IN di_ 'RR)))))))))))))
      (mr-iff-back! iffc))
    a))

;;; ======================================================================
;;; completeness
;;; ======================================================================
(sp (make-wff '(FORALL s (IMPLIES (IS-COMPLETE s) (FORALL t (IMPLIES (IS-COMPLETE t) (IS-COMPLETE (PRODUCT2-MS s t))))))))
(dk-peel!)
(define mpq-cs (cadr (mr-iff-parts! (dk-cite! 'is-complete 's))))
(define mpq-ct (cadr (mr-iff-parts! (dk-cite! 'is-complete 't))))
(dk-cite! 'product2-is-metric-space 's 't)
(dk-cite! 'product2-pts 's 't)
(fact 'nn-is-set)
(define (mpq-limit! cuniv sp a)      ; a Cauchy in sp complete: its limit l (in PTS sp, CONVERGES-TO landed)
  (dk-apply! cuniv a)
  (let ((l (dk-skolem! (car (mr-iff-parts! (dk-cite! 'converges sp a))))))
    (mr-iff-parts! (dk-cite! 'converges-to sp a l))
    l))
(let ((iff (dk-cite! 'is-complete mpq-P)))
  (dk-have! (caddr iff)
    (lambda ()
      (mr-and-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (let* ((u (caddr (mr-find 'ucs (lambda (f) (dk-head-is? f 'IS-CAUCHY-SEQ)) (dk-peel!))))
                     (cu (mr-iff-parts! (dk-cite! 'is-cauchy-seq mpq-P u)))
                     (cuu (mr-find 'cu (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR))) cu)))
                (dk-have! (list 'IN u (list 'FUN 'NN mpq-C)) (lambda () (subst (list '= mpq-C (list 'PTS mpq-P))) (mr-close-open!)))
                (let* ((a1 (mpq-comp! u 1 's cuu)) (a2 (mpq-comp! u 2 't cuu))
                       (l1 (mpq-limit! mpq-cs 's a1)) (l2 (mpq-limit! mpq-ct 't a2)))
                  (dk-have! (list 'FORALL 'p2n_ (list 'IMPLIES '(IN p2n_ NN) (list '= (list u 'p2n_) (list 'LIST (list a1 'p2n_) (list a2 'p2n_)))))
                    (lambda ()
                      (let ((k (dk-di-var!)))
                        (dk-cite! 'fun-apply-type-c u 'NN mpq-C k)
                        (mpq-pt! (list u k))
                        (dk-lam-b!)
                        (mr-close-open!))))
                  (let ((ci (dk-cite! 'product2-converges-to-iff 's 't u a1 a2 l1 l2)))
                    (dk-have! (caddr ci) (lambda () (dk-conj-close! dk-ass!)))
                    (mr-iff-back! ci))
                  (let ((iffv (dk-cite! 'converges mpq-P u)))
                    (dk-have! (caddr iffv) (lambda () (ew (list 'LIST l1 l2)) (mr-close-open!)))
                    (mr-iff-back! iffv)
                    (mr-close-open!)))))))))
  (mr-iff-back! iff))
(mr-close-open!)
(qed 'product2-complete)
(topic! 'product2-complete 'analysis)

;;; ======================================================================
;;; separability
;;; ======================================================================
(sp (make-wff '(FORALL s (IMPLIES (IS-SEPARABLE s) (FORALL t (IMPLIES (IS-SEPARABLE t) (IS-SEPARABLE (PRODUCT2-MS s t))))))))
(dk-peel!)
(define mpq-d1 (mr-sep-open! 's))
(define mpq-d2 (mr-sep-open! 't))
(define mpq-den1 (mr-find 'den1 (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f mpq-d1) (dk-contains? f 'POS-RR))) (dk-asms)))
(define mpq-den2 (mr-find 'den2 (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f mpq-d2) (dk-contains? f 'POS-RR))) (dk-asms)))
(dk-cite! 'product2-is-metric-space 's 't)
(dk-cite! 'product2-pts 's 't)
(fact 'nn-is-set)
(define mpq-ds (list 'VNB-LAMBDA 'mpk_ 'NN (list 'LIST (list mpq-d1 '(NNFST mpk_)) (list mpq-d2 '(NNSND mpk_)))))
(define (mpq-dpt! k)                 ; k in NN: the k-th point typed in the product
  (dk-cite! 'nnfst-type k) (dk-cite! 'nnsnd-type k)
  (dk-cite! 'fun-apply-type-c mpq-d1 'NN '(PTS s) (list 'NNFST k))
  (dk-cite! 'fun-apply-type-c mpq-d2 'NN '(PTS t) (list 'NNSND k))
  (dk-cite! 'pair-in-cartesian '(PTS s) '(PTS t) (list mpq-d1 (list 'NNFST k)) (list mpq-d2 (list 'NNSND k))))
(let ((iff (dk-cite! 'is-separable mpq-P)))
  (dk-have! (caddr iff)
    (lambda ()
      (mr-and-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (begin
                (ew mpq-ds)
                (mr-and-close!
                  (lambda ()
                    (if (dk-head-is? (dk-goal) 'IN)
                        (begin
                          (subst (list '= (list 'PTS mpq-P) mpq-C))
                          (for-each (lambda (kn)
                                      (if (not (sequent-node-grounded? kn))
                                          (begin (dk-focus! kn)
                                                 (if (dk-asm? (dk-goal)) (ass)
                                                     (let ((k (car (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) (dk-peel!))))))
                                                       (mpq-dpt! k)
                                                       (mr-close-open!))))))
                                    (dk-opened (lambda () (lam-t)))))
                        (let* ((lx (dk-peel!))
                               (x (cadr (mr-find 'px (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'PTS mpq-P)))) lx)))
                               (eps (cadr (mr-find 'pe (lambda (f) (dk-head-is? f 'POS-RR)) lx)))
                               (_0 (dk-have! (list 'IN x mpq-C) (lambda () (subst (list '= mpq-C (list 'PTS mpq-P))) (mr-close-open!))))
                               (xx (mpq-pt! x)) (x1 (car xx)) (x2 (cadr xx))
                               (n1 (dk-skolem! (dk-apply! mpq-den1 x1 eps)))
                               (_1 (dk-split-all!))
                               (n2 (dk-skolem! (dk-apply! mpq-den2 x2 eps)))
                               (_2 (dk-split-all!))
                               (k (list 'NNPAIR n1 n2))
                               (pk (list 'LIST (list mpq-d1 n1) (list mpq-d2 n2))))
                          (dk-cite! 'nnpair-type n1 n2)
                          (dk-cite! 'nnfst-nnpair n1 n2) (dk-cite! 'nnsnd-nnpair n1 n2)
                          (mpq-dpt! k)
                          (ew k)
                          (mr-and-close!
                            (lambda ()
                              (if (dk-asm? (dk-goal)) (ass)
                                  (begin
                                    (dk-lam-b!)
                                    (subst (list '= (list 'NNFST k) n1))
                                    (subst (list '= (list 'NNSND k) n2))
                                    (dk-cite! 'fun-apply-type-c mpq-d1 'NN '(PTS s) n1)
                                    (dk-cite! 'fun-apply-type-c mpq-d2 'NN '(PTS t) n2)
                                    (dk-cite! 'pair-in-cartesian '(PTS s) '(PTS t) (list mpq-d1 n1) (list mpq-d2 n2))
                                    (dk-cite! 'product2-dist-pair 's 't x1 (list mpq-d1 n1) x2 (list mpq-d2 n2))
                                    (dk-cite! 'cartesian-pair-eq x '(PTS s) '(PTS t))
                                    (subst (list '= x (list 'LIST x1 x2)))
                                    (let ((e1 (list '(DIST s) x1 (list mpq-d1 n1))) (e2 (list '(DIST t) x2 (list mpq-d2 n2))))
                                      (subst (list '= (list (list 'DIST mpq-P) (list 'LIST x1 x2) pk) (list 'MAX e1 e2)))
                                      (dk-cite! 'metric-dist-real 's x1 (list mpq-d1 n1))
                                      (dk-cite! 'metric-dist-real 't x2 (list mpq-d2 n2))
                                      (dk-cite! 'rr-pos-rr-in-rr eps)
                                      (mr-chain! (dk-cite! 'rr-max-lt e1 e2 eps))
                                      (mr-close-open!))))))))))))))))
  (mr-iff-back! iff))
(mr-close-open!)
(qed 'product2-separable)
(topic! 'product2-separable 'analysis)

(sp (make-wff '(FORALL s (IMPLIES (IS-POLISH s) (FORALL t (IMPLIES (IS-POLISH t) (IS-POLISH (PRODUCT2-MS s t))))))))
(dk-peel!)
(mr-iff-parts! (dk-cite! 'is-polish 's))
(mr-iff-parts! (dk-cite! 'is-polish 't))
(dk-cite! 'product2-complete 's 't)
(dk-cite! 'product2-separable 's 't)
(let ((iff (dk-cite! 'is-polish mpq-P)))
  (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!)))
  (mr-iff-back! iff))
(mr-close-open!)
(qed 'product2-polish)
(topic! 'product2-polish 'analysis)

(sp (make-wff '(FORALL s (IMPLIES (IS-POLISH s) (IS-POLISH (PRODUCT2-MS s BAIRE-MS))))))
(dk-peel!)
(dk-cite! 'baire-ms-polish)
(dk-cite! 'product2-polish 's 'BAIRE-MS)
(mr-close-open!)
(qed 'product2-baire-polish)
