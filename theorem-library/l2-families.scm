;;; bo2-l2a.scm -- l2(I) groundwork, the coefficient map of an orthonormal basis, th-main Cor 2.9.
;;; Agent BA-ONB2, 2026-11-09.  Prefix bl2-.  15 theorems, all modulo 0, nothing asserted.
;;; DESTINATION: theorem-library/l2-families.scm.  Library: analysis.
;;; LOAD WINDOW [hilbert-onb + 1, end): cites onb-expansion, parseval-identity,
;;; onb-ip-normed-ag-iden (hilbert-onb); needs structure-library/l2-families-vocab (CC-NAG,
;;; CC-FAMILY-SUM, L2-FAMILIES, L2-IP) loaded before it.
;;;   CC-NAG:        cc-nag-is-normed-ag, cc-nag-ag-{carr,iden,opr,inv}, cc-nag-nrm,
;;;                  cc-nag-ag-is-abelian-group
;;;   general:       finsum-hom-ag (a hom of abelian groups through FINSUM over any finite set),
;;;                  sums-to-uniform-hom (SUMS-TO through a uniformly continuous hom),
;;;                  cc-family-sum-value
;;;   the functional <., y>: ip-functional-hom, ip-functional-ucont
;;;   th-main 2.6 / 2.9: onb-inner-product-expansion, onb-coefficients-in-l2, onb-coefficients-ip
(define (bl2-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; bl2: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l) (display ";;   ") (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))
        (error "bl2: proof not complete" name)))
  (qed name)
  (topic! name 'analysis))
(define (bl2-dump! tag)
  (display ";; bl2 DUMP ") (display tag) (newline)
  (for-each (lambda (l) (display ";;   ") (display (expression->string (dk-goal-of l))) (newline))
            (dk-open-leaves)))

(define bl2-cc-closure '((+ . cc-add-closed) (* . cc-mul-closed) (- . cc-neg-closed)
                         (conjugate . cc-conjugate-closed) (magnitude . cc-magnitude-closed)))
(define (bl2-has-lam? g)
  (and (pair? g)
       (or (and (pair? (car g)) (eq? (car (car g)) 'VNB-LAMBDA))
           (let loop ((l g)) (and (pair? l) (or (bl2-has-lam? (car l)) (loop (cdr l))))))))
(define (bl2-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
;; type the CC arithmetic in the goal, then beta, to a fixpoint; returns #t when the leaf closed
(define (bl2-cc-beta!)
  (let loop ((fuel 8))
    (dk-saturate-slot-ops! 'CC bl2-cc-closure)
    (if (and (> fuel 0) (bl2-has-lam? (dk-goal)))
        (let ((home (proof-state-focus *ps*)))
          (dk-lam-b!)
          (if (sequent-node-grounded? home) #t (loop (- fuel 1))))
        #f)))
;; peel a leaf, split its conjunctions, and close every resulting leaf with CLOSE!
(define (bl2-peel-split-close! close!)
  (let ((home (proof-state-focus *ps*)))
    (dk-peel!)
    (if (dk-head-is? (dk-goal) 'AND)
        (for-each (lambda (k) (if (not (sequent-node-grounded? k)) (begin (dk-focus! k) (bl2-peel-split-close! close!))))
                  (dk-opened (lambda () (di))))
        (close!))))
;; a CC law leaf: beta, then crs or the magnitude laws
(define (bl2-cc-law!)
  (if (not (bl2-cc-beta!))
      (let ((g (dk-goal)))
        (cond
          ((and (dk-head-is? g '<=) (eqv? (cadr g) 0) (dk-head-is? (caddr g) 'magnitude))
           (fact 'cc-magnitude-nonneg (cadr (caddr g))) (ass))
          ((dk-head-is? g 'IFF)
           (fact 'cc-magnitude-zero-iff (cadr (cadr (cadr g)))) (ass))
          ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'magnitude) (dk-head-is? (cadr (cadr g)) '-))
           (fact 'cc-magnitude-neg (cadr (cadr (cadr g)))) (ass))
          ((and (dk-head-is? g '<=) (dk-head-is? (cadr g) 'magnitude))
           (let* ((sm (cadr (cadr g))) (a (cadr sm)) (b (caddr sm)))
             (dk-have! (list 'AND (list 'IN a 'CC) (list 'IN b 'CC)) (lambda () (dk-conj-close! (lambda () (ass)))))
             (fact 'cc-magnitude-triangle a b) (ass)))
          (#t (crs))))))
(define (bl2-nag-leaf!)
  (let ((g (dk-goal)))
    (cond
      ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH)) (mac 'cc-nag-def) (len-r) (arith))
      ((equal? g '(IN CC SET)) (fact 'cc-is-set) (ass))
      ((and (dk-head-is? g 'IN) (number? (cadr g))) (arith))
      ((and (dk-head-is? g 'IN) (dk-head-is? (cadr g) 'VNB-LAMBDA))
       (dk-lam-type! (lambda () (dk-peel!) (if (not (bl2-cc-beta!)) (ass)))))
      ((memq (car g) '(is-associative is-commutative is-identity has-inverses is-group-norm))
       (mac (car g))
       (bl2-peel-split-close!
         (lambda ()
           (let ((g2 (dk-goal)))
             (if (and (dk-head-is? g2 'IN) (dk-head-is? (cadr g2) 'VNB-LAMBDA))
                 (dk-lam-type! (lambda () (dk-peel!) (if (not (bl2-cc-beta!)) (ass))))
                 (bl2-cc-law!))))))
      (#t (error "bl2: unexpected conjunct" (expression->string g))))))

(sp (make-wff '(IS-NORMED-AG CC-NAG)))
(mac 'IS-NORMED-AG)
(dk-isx-set!)
(quietly (lambda () (surface-goal! 'CC-NAG)))
(let split ((fuel 40))
  (let ((andl (find-first (lambda (s) (dk-head-is? (dk-goal-of s) 'AND)) (dk-open-leaves))))
    (when andl
      (if (= fuel 0) (error "bl2: AND split did not terminate"))
      (dk-focus! andl) (di) (split (- fuel 1)))))
(let sweep ((fuel 40))
  (let* ((open (dk-open-leaves)) (n (length open)))
    (when (pair? open)
      (if (= fuel 0) (error "bl2: sweep out of fuel"))
      (dk-focus! (car open))
      (let ((g (dk-goal)))
        (bl2-nag-leaf!)
        (if (>= (length (dk-open-leaves)) n)
            (begin (bl2-dump! "stuck") (error "bl2: this conjunct did not close" (expression->string g)))))
      (sweep (- fuel 1)))))
(bl2-done! 'cc-nag-is-normed-ag)

;;; ---------------------------------------------------------------------------
;;; read-offs of CC-NAG and of its abelian group
(define bl2-AG '(NORMED-AG-AS-ABELIAN-GROUP CC-NAG))
(define bl2-addl '(VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (+ x_ y_)))
(define bl2-negl '(VNB-LAMBDA x_ CC (- x_)))
(define bl2-nrml '(VNB-LAMBDA x_ CC (magnitude x_)))
(define (bl2-slot-close! view acc)
  (mac view)
  (let loop ((n 0))
    (let ((g (dk-goal)))
      (if (and (< n 8) (not (equal? (cadr g) (caddr g))))
          (begin (quietly (lambda () (slot acc)))
                 (quietly (lambda () (nth-r)))
                 (if (not (equal? (dk-goal) g)) (loop (+ n 1)))))))
  (qrfl))
(define (bl2-ag-readoff! acc val)
  (dk-have! (list '== (list acc bl2-AG) (list acc 'CC-NAG))
    (lambda () (bl2-slot-close! 'NORMED-AG-AS-ABELIAN-GROUP acc)))
  (fact (symbol-append 'cc-nag@ acc))
  (dk-have! (list '== (list acc bl2-AG) val)
    (lambda () (subst (list '== (list acc bl2-AG) (list acc 'CC-NAG)))
               (subst (list '== (list acc 'CC-NAG) val)) (qrfl))))

(sp (make-wff (list '== (list 'CARR bl2-AG) 'CC)))
(bl2-ag-readoff! 'CARR 'CC)
(bl2-done! 'cc-nag-ag-carr)
(sp (make-wff (list '== (list 'IDEN bl2-AG) 0)))
(bl2-ag-readoff! 'IDEN 0)
(bl2-done! 'cc-nag-ag-iden)

(sp (make-wff (list 'FORALL 'a_ (list 'IMPLIES '(IN a_ CC) (list 'FORALL 'b_ (list 'IMPLIES '(IN b_ CC)
   (list '= (list (list 'OPR bl2-AG) 'a_ 'b_) '(+ a_ b_))))))))
(dk-peel!)
(bl2-ag-readoff! 'OPR bl2-addl)
(subst (list '== (list 'OPR bl2-AG) bl2-addl))
(dk-close-if! (lambda () (bl2-cc-beta!)) (lambda () (rfl)))
(bl2-done! 'cc-nag-ag-opr)

(sp (make-wff (list 'FORALL 'a_ (list 'IMPLIES '(IN a_ CC)
   (list '= (list (list 'INV bl2-AG) 'a_) '(- a_))))))
(dk-peel!)
(bl2-ag-readoff! 'INV bl2-negl)
(subst (list '== (list 'INV bl2-AG) bl2-negl))
(dk-close-if! (lambda () (bl2-cc-beta!)) (lambda () (rfl)))
(bl2-done! 'cc-nag-ag-inv)

(sp (make-wff (list 'FORALL 'a_ (list 'IMPLIES '(IN a_ CC)
   (list '= (list '(NRM CC-NAG) 'a_) '(magnitude a_))))))
(dk-peel!)
(fact 'cc-nag@nrm)
(subst (list '== '(NRM CC-NAG) bl2-nrml))
(bl2-cc-beta!)
(if (bl2-open?) (rfl))
(bl2-done! 'cc-nag-nrm)

(sp (make-wff (list 'IS-ABELIAN-GROUP bl2-AG)))
(fact 'cc-nag-is-normed-ag)
(fact 'normed-ag-as-abelian-group-is-abelian-group 'CC-NAG)
(if (bl2-open?) (ass))
(bl2-done! 'cc-nag-ag-is-abelian-group)

;;; ---------------------------------------------------------------------------
;;; A HOMOMORPHISM OF ABELIAN GROUPS PASSES THROUGH A FINITE SUM (any finite index set).
;;; hom-ag-finsum-interval (gal-ch.scm) is the interval case; this is the general one, from
;;; hom-ag-sum-ag through the enumeration that defines FINSUM.
(define bl2-hf '(VNB-LAMBDA fhz_ S (h (f fhz_))))
(define bl2f-n '(CARD S))
(define bl2f-phi '(FIN-ENUM S))
(define bl2f-seg '(ORD-SEGMENT (CARD S)))
(define bl2f-G '(ENUM-FAM a1 f (FIN-ENUM S) (CARD S)))
(define bl2f-H (list 'ENUM-FAM 'a2 bl2-hf '(FIN-ENUM S) '(CARD S)))
(define (bl2f-app! fn A B x) (if (not (dk-asm? (list 'IN (list fn x) B))) (dk-cite! 'fun-apply-type-c fn A B x)))
;; i in seg: lands i in NN, phi(i) in S, f(phi i) in CARR a1, h(f(phi i)) in CARR a2
(define (bl2f-pt! i ftyp)
  (if (not (dk-asm? (list 'IN i 'NN))) (dk-cite! 'ord-segment-nn-subset bl2f-n i))
  (bl2f-app! bl2f-phi bl2f-seg 'S i)
  (let ((fx (list 'f (list bl2f-phi i))))
    (if (not (dk-asm? (list 'IN fx '(CARR a1)))) (dk-apply! ftyp (list bl2f-phi i)))
    (bl2f-app! 'h '(CARR a1) '(CARR a2) fx)))
(define (bl2f-seg-var) (cadr (cadr (dk-goal))))
(define (bl2f-close!) (cond ((not (bl2-open?)) #t) ((dk-asm? (dk-goal)) (ass)) ((dk-head-is? (dk-goal) '==) (qrfl)) (#t (rfl))))
(sp (make-wff
  '(FORALL a1 (FORALL a2 (FORALL h (IMPLIES (IS-HOM-ABELIAN-GROUP a1 a2 h)
     (FORALL S (IMPLIES (IN S SET) (IMPLIES (IN (CARD S) NN)
       (FORALL f (IMPLIES (FORALL fhz_ (IMPLIES (IN fhz_ S) (IN (f fhz_) (CARR a1))))
         (= (h (FINSUM a1 f S)) (FINSUM a2 (VNB-LAMBDA fhz_ S (h (f fhz_))) S)))))))))))))
(dk-peel!)
(define bl2f-ftyp (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a '(CARR a1)) (dk-contains? a 'f))) "f's typing"))
(let* ((iff (dk-cite! 'is-hom-abelian-group-def 'a1 'a2 'h)) (rhs (caddr iff)))
  (dk-project! rhs 'is-hom-abelian-group-def '(IS-HOM-ABELIAN-GROUP a1 a2 h))
  (dk-split-all! (list rhs)))
(let ((bij (dk-fact! 'fin-enum-is-bijection 'S)))
  (dk-cite! 'bijection-in-fun bl2f-seg 'S bl2f-phi))
(mac 'FINSUM)
(dk-have! (list 'FORALL 'gwi_ (list 'IMPLIES (list 'IN 'gwi_ bl2f-seg) (list 'IN (list bl2f-G 'gwi_) '(CARR a1))))
  (lambda ()
    (dk-peel!)
    (let ((i (bl2f-seg-var)))
      (bl2f-pt! i bl2f-ftyp)
      (subst (dk-cite! 'enum-fam-value bl2f-n 'a1 'f bl2f-phi i))
      (bl2f-close!))))
(define bl2f-e (dk-cite! 'hom-ag-sum-ag bl2f-n 'a1 'a2 'h bl2f-G))
(subst bl2f-e)
(define bl2f-hG (caddr (caddr bl2f-e)))
(dk-have! (list 'FORALL 'gwi_ (list 'IMPLIES (list 'IN 'gwi_ bl2f-seg) (list '== (list bl2f-hG 'gwi_) (list bl2f-H 'gwi_))))
  (lambda ()
    (dk-peel!)
    (let ((i (cadr (cadr (dk-goal)))))
      (bl2f-pt! i bl2f-ftyp)
      (let* ((e1 (dk-cite! 'enum-fam-value bl2f-n 'a1 'f bl2f-phi i))
            (e2 (dk-cite! 'enum-fam-value bl2f-n 'a2 bl2-hf bl2f-phi i)))
        (dk-lam-b!)
        (if (bl2-open?) (subst e1))
        (if (bl2-open?) (subst e2))
        (if (and (bl2-open?) (bl2-has-lam? (dk-goal))) (dk-lam-b!))
        (bl2f-close!)))))
(subst (dk-cite! 'sum-ag-segment-congruence bl2f-n 'a2 bl2f-hG bl2f-H))
(dk-have! (list 'FORALL 'gwi_ (list 'IMPLIES (list 'IN 'gwi_ bl2f-seg) (list 'IN (list bl2f-H 'gwi_) '(CARR a2))))
  (lambda ()
    (dk-peel!)
    (let ((i (bl2f-seg-var)))
      (bl2f-pt! i bl2f-ftyp)
      (subst (dk-cite! 'enum-fam-value bl2f-n 'a2 bl2-hf bl2f-phi i))
      (dk-close-if! (lambda () (dk-lam-b!)) bl2f-close!))))
(dk-cite! 'sum-ag-type-ptwise bl2f-n 'a2 bl2f-H)
(bl2f-close!)
(bl2-done! 'finsum-hom-ag)

;;; ---------------------------------------------------------------------------
;;; AN UNORDERED SUM PASSES THROUGH A UNIFORMLY CONTINUOUS HOMOMORPHISM.
;;; h : g1 -> g2 additive (a hom of the abelian groups underneath) and uniformly continuous in the
;;; difference form; then f sums to r in g1 => h o f sums to h(r) in g2.  No norm bound is needed,
;;; and no arithmetic: the hom carries the finite sums (finsum-hom-ag), continuity carries the net.
(define (bl2-NV g) (list 'NORMED-AG-AS-ABELIAN-GROUP g))
(define (bl2-nd g x y) (list (list 'NRM g) (list (list 'OPR g) x (list (list 'INV g) y))))
(define (bl2-view-carr! g)
  (let ((lhs (list 'CARR (bl2-NV g))) (rhs (list 'CARR g)))
    (dk-have! (list '== lhs rhs) (lambda () (bl2-slot-close! 'NORMED-AG-AS-ABELIAN-GROUP 'CARR)))
    (dk-have! (list '== rhs lhs) (lambda () (bl2-slot-close! 'NORMED-AG-AS-ABELIAN-GROUP 'CARR)))))
(define bl2u-lam '(VNB-LAMBDA shz_ (DOM f) (h (f shz_))))
(define bl2u-ucont
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'del (list 'AND '(POS-RR del)
      (list 'FORALL 'x (list 'IMPLIES '(IN x (CARR g1)) (list 'FORALL 'y (list 'IMPLIES '(IN y (CARR g1))
        (list 'IMPLIES (list '< (bl2-nd 'g1 'x 'y) 'del)
                       (list '< (bl2-nd 'g2 '(h x) '(h y)) 'eps)))))))))))
(sp (make-wff
  (list 'FORALL 'g1 (list 'FORALL 'g2 (list 'FORALL 'h
    (list 'IMPLIES '(IS-NORMED-AG g1) (list 'IMPLIES '(IS-NORMED-AG g2)
      (list 'IMPLIES (list 'IS-HOM-ABELIAN-GROUP (bl2-NV 'g1) (bl2-NV 'g2) 'h)
        (list 'IMPLIES bl2u-ucont
          (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN (DOM f) (CARR g1)))
            (list 'FORALL 'r (list 'IMPLIES '(IN r (CARR g1))
              (list 'IMPLIES '(SUMS-TO g1 f r)
                (list 'SUMS-TO 'g2 bl2u-lam '(h r))))))))))))))))
(dk-peel!)
(define bl2u-D '(DOM f))
(fact 'normed-ag-as-abelian-group-is-abelian-group 'g1)
(fact 'normed-ag-as-abelian-group-is-abelian-group 'g2)
(bl2-view-carr! 'g1)
(bl2-view-carr! 'g2)
(fact 'fun-domain-in-set bl2u-D '(CARR g1) 'f)
(define bl2u-hom (list 'IS-HOM-ABELIAN-GROUP (bl2-NV 'g1) (bl2-NV 'g2) 'h))
(let ((ht (dk-project! (list 'IN 'h (list 'FUN (list 'CARR (bl2-NV 'g1)) (list 'CARR (bl2-NV 'g2))))
                       'is-hom-abelian-group-def bl2u-hom)))
  (let ((ht2 (dk-rewrite-h! ht (list 'CARR (bl2-NV 'g1)) '(CARR g1))))
    (dk-rewrite-h! ht2 (list 'CARR (bl2-NV 'g2)) '(CARR g2))))
;; lam in FUN(D, CARR g2), DOM lam = D
(dk-have! (list 'IN bl2u-lam (list 'FUN bl2u-D '(CARR g2)))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((z (dk-di-var!)))
          (fact 'fun-apply-type-c 'f bl2u-D '(CARR g1) z)
          (fact 'fun-apply-type-c 'h '(CARR g1) '(CARR g2) (list 'f z))
          (bl2f-close!)))
      (lambda () (ass)))))
(dk-project! (list 'IN bl2u-lam (list 'FUN bl2u-D)) 'fun-codomain-iff (list 'IN bl2u-lam (list 'FUN bl2u-D '(CARR g2))))
(dk-have! (list 'AND (list 'IN bl2u-lam (list 'FUN bl2u-D)) (list 'IN bl2u-D 'SET))
  (lambda () (dk-conj-close! (lambda () (ass)))))
(fact 'dom-of-fun bl2u-D bl2u-lam)
(dk-split-all! (list (list 'AND (list 'IN (list 'DOM bl2u-lam) 'SET) (list '= (list 'DOM bl2u-lam) bl2u-D))))
;; the hypothesis, opened
(define bl2u-ucf (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a 'del))) "uniform continuity"))
(mac-h 'SUMS-TO '(SUMS-TO g1 f r))
(define bl2u-sh (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a 'fin) (dk-contains? a 'r))) "f sums to r"))
(mac 'SUMS-TO)
(let* ((eps (cadr (car (dk-peel!))))
       (dx (dk-apply! bl2u-ucf eps))
       (del (dk-skolem! dx #t))
       (ubd (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a del) (dk-contains? a eps))) "the modulus"))
       (fx (dk-apply! bl2u-sh del))
       (fin (dk-skolem! fx #t))
       (e1 (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a fin) (dk-contains? a del))) "the tail clause")))
  (ew fin)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-asm? (dk-goal)) (ass))
            ((dk-head-is? (dk-goal) 'SUBSET)
             (subst (list '= (list 'DOM bl2u-lam) bl2u-D)) (ass))
            (#t
             (let* ((landed (dk-peel!))
                    (ext (cadr (cadr (car landed)))))
               (dk-split-all!)
               (let ((sx (dk-pick (lambda (a) (and (dk-head-is? a 'SUBSET) (equal? (cadr a) ext))) "ext <= DOM lam")))
                 (dk-rewrite-h! sx (list 'DOM bl2u-lam) bl2u-D))
               (dk-have! (list 'AND (list 'IN ext 'SET) (list 'AND (list 'IN (list 'CARD ext) 'NN)
                                (list 'AND (list 'SUBSET fin ext) (list 'SUBSET ext bl2u-D))))
                 (lambda () (dk-conj-close! (lambda () (ass)))))
               (dk-apply! e1 ext)
               ;; F1 = FINSUM(NV g1, f, ext) in CARR g1
               (let* ((F1 (list 'FINSUM (bl2-NV 'g1) 'f ext))
                      (ptw (list 'FORALL 'fhz_ (list 'IMPLIES (list 'IN 'fhz_ ext) (list 'IN '(f fhz_) '(CARR g1))))))
                 (dk-have! ptw
                   (lambda ()
                     (let ((z (cadr (car (dk-peel!)))))
                       (fact 'subset-mem-fwd ext bl2u-D z)
                       (fact 'fun-apply-type-c 'f bl2u-D '(CARR g1) z)
                       (ass))))
                 (dk-have! (list 'FORALL 'fhz_ (list 'IMPLIES (list 'IN 'fhz_ ext) (list 'IN '(f fhz_) (list 'CARR (bl2-NV 'g1)))))
                   (lambda () (subst (list '== (list 'CARR (bl2-NV 'g1)) '(CARR g1))) (ass)))
                 (fact 'finsum-type-ptwise (bl2-NV 'g1) ext 'f)
                 (dk-have! (list 'IN F1 '(CARR g1))
                   (lambda () (subst (list '== '(CARR g1) (list 'CARR (bl2-NV 'g1)))) (ass)))
                 (dk-apply! ubd 'r F1)
                 (let* ((he (dk-cite! 'finsum-hom-ag (bl2-NV 'g1) (bl2-NV 'g2) 'h ext 'f))
                        (FE (caddr he))
                        (lamE (caddr FE))
                        (FL (list 'FINSUM (bl2-NV 'g2) bl2u-lam ext)))
                   (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z ext) (list '= (list bl2u-lam 'z) (list lamE 'z))))
                     (lambda ()
                       (let ((z (cadr (car (dk-peel!)))))
                         (fact 'subset-mem-fwd ext bl2u-D z)
                         (fact 'fun-apply-type-c 'f bl2u-D '(CARR g1) z)
                         (fact 'fun-apply-type-c 'h '(CARR g1) '(CARR g2) (list 'f z))
                         (dk-lam-b!)
                         (if (and (bl2-open?) (bl2-has-lam? (dk-goal))) (dk-lam-b!))
                         (bl2f-close!))))
                   (subst (dk-cite! 'finsum-congruence-q (bl2-NV 'g2) ext bl2u-lam lamE))
                   (subst (list '= FE (list 'h F1)))
                   (bl2f-close!)))))))))
(bl2-done! 'sums-to-uniform-hom)

;;; ===========================================================================
;;; th-main Cor 2.9 -- <x, y> = sum_i <x, e_i> <e_i, y> for an orthonormal basis, as an unordered
;;; sum in CC: the expansion x = sum_i <x, e_i> e_i (onb-expansion) carried by the functional
;;; <., y>, which is additive and uniformly continuous (Cauchy-Schwarz), through
;;; sums-to-uniform-hom.  Needs hilbert-onb (onb-expansion).
(define (bl2-tsub t al)
  (cond ((and (symbol? t) (assq t al)) => cdr)
        ((pair? t) (cons (bl2-tsub (car t) al) (bl2-tsub (cdr t) al)))
        (#t t)))
(define bl2-H '(VNB-LAMBDA ipw_ (VEC v) ((IP v) ipw_ yv)))
(define bl2-IG '(IP-NORMED-AG v))
(define bl2-A (bl2-NV bl2-IG))
(define bl2-B (bl2-NV 'CC-NAG))
(define (bl2-ip a b) (list (list 'IP 'v) a b))
;; land (== (ACC (NV (IP-NORMED-AG v))) VAL) through the view and the ip-normed-ag read-off
(define (bl2-ig-readoff! acc ig-thm val)
  (let ((l1 (list acc bl2-A)) (l2 (list acc bl2-IG)))
    (dk-have! (list '== l1 l2) (lambda () (bl2-slot-close! 'NORMED-AG-AS-ABELIAN-GROUP acc)))
    (fact ig-thm 'v)
    (dk-have! (list '== l1 val) (lambda () (subst (list '== l1 l2)) (subst (list '== l2 val)) (qrfl)))))
(define (bl2-cc-readoff! acc val)
  (let ((l1 (list acc bl2-B)) (l2 (list acc 'CC-NAG)))
    (dk-have! (list '== l1 l2) (lambda () (bl2-slot-close! 'NORMED-AG-AS-ABELIAN-GROUP acc)))
    (fact (symbol-append 'cc-nag@ acc))
    (dk-have! (list '== l1 val) (lambda () (subst (list '== l1 l2)) (subst (list '== l2 val)) (qrfl)))))
(define (bl2-vtype! z) (if (not (dk-asm? (list 'IN z '(VEC v)))) (error "bl2: untyped vector" z)))
(define (bl2-iptype! a b) (if (not (dk-asm? (list 'IN (bl2-ip a b) 'CC))) (dk-cite! 'cips-ip-type 'v a b)))

;;; the functional <., yv> is a homomorphism of the abelian groups
(sp (make-wff
  (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-INNER-PRODUCT-SPACE v)
    (list 'FORALL 'yv (list 'IMPLIES '(IN yv (VEC v))
      (list 'IS-HOM-ABELIAN-GROUP bl2-A bl2-B bl2-H)))))))
(dk-peel!)
(fact 'ip-normed-ag-is-normed-ag 'v)
(fact 'normed-ag-as-abelian-group-is-abelian-group bl2-IG)
(fact 'cc-nag-is-normed-ag)
(fact 'normed-ag-as-abelian-group-is-abelian-group 'CC-NAG)
(bl2-ig-readoff! 'CARR 'ip-normed-ag-carrier '(VEC v))
(bl2-ig-readoff! 'OPR 'ip-normed-ag-opr '(VADD v))
(bl2-ig-readoff! 'INV 'ip-normed-ag-inv '(VNEG v))
(bl2-ig-readoff! 'IDEN 'onb-ip-normed-ag-iden '(VZERO v))
(bl2-cc-readoff! 'CARR 'CC)
(bl2-cc-readoff! 'OPR bl2-addl)
(bl2-cc-readoff! 'INV bl2-negl)
(bl2-cc-readoff! 'IDEN 0)
(let* ((iff (dk-cite! 'is-hom-abelian-group-def bl2-A bl2-B bl2-H)) (rhs (caddr iff)))
  (dk-have! rhs
    (lambda ()
      (for-each (lambda (pr) (if (dk-contains? (dk-goal) (car pr)) (subst (list '== (car pr) (cdr pr)))))
                (list (cons (list 'CARR bl2-A) '(VEC v)) (cons (list 'OPR bl2-A) '(VADD v))
                      (cons (list 'INV bl2-A) '(VNEG v)) (cons (list 'IDEN bl2-A) '(VZERO v))
                      (cons (list 'CARR bl2-B) 'CC) (cons (list 'OPR bl2-B) bl2-addl)
                      (cons (list 'INV bl2-B) bl2-negl) (cons (list 'IDEN bl2-B) 0)))
      (dk-conj-close!
        (lambda ()
          (cond ((dk-asm? (dk-goal)) (ass))
                ((dk-head-is? (dk-goal) 'IN)
                 (dk-lam-type!
                   (lambda () (let ((z (dk-di-var!))) (bl2-iptype! z 'yv) (bl2f-close!)))
                   (lambda () (fact 'cips-vec-set 'v) (bl2f-close!))))
                ((dk-head-is? (dk-goal) 'FORALL)
                 (let* ((landed (dk-peel!)) (xs (map cadr landed)))
                   (for-each (lambda (z) (bl2-iptype! z 'yv)) xs)
                   (if (= (length xs) 2)
                       (let ((a (car xs)) (b (cadr xs)))
                         (fact 'cips-vadd-type 'v a b)
                         (bl2-cc-beta!)
                         (if (bl2-open?) (subst (dk-cite! 'cips-ip-add-left 'v a b 'yv)))
                         (bl2f-close!))
                       (let ((a (car xs)))
                         (fact 'cips-vneg-type 'v a)
                         (bl2-cc-beta!)
                         (if (bl2-open?) (subst (dk-cite! 'cips-ip-neg-left 'v a 'yv)))
                         (bl2f-close!)))))
                (#t
                 (fact 'cips-vzero-in 'v)
                 (bl2-cc-beta!)
                 (if (bl2-open?) (subst (dk-cite! 'cips-ip-zero-left 'v 'yv)))
                 (bl2f-close!)))))))
  (dk-close-if! (lambda () (dk-only! iff rhs)) prop))
(bl2-done! 'ip-functional-hom)

;;; the functional <., yv> is uniformly continuous: |<x,yv> - <y,yv>| <= ||x - y|| ||yv||, and
;;; del = eps / (||yv|| + 1) serves
(define bl2-ucont-H (bl2-tsub bl2u-ucont (list (cons 'g1 bl2-IG) (cons 'g2 'CC-NAG) (cons 'h bl2-H))))
(define (bl2-norm-facts! z)        ; z in VEC v: IP-NORM(v, z) in RR and 0 <= it
  (let ((n (list 'IP-NORM 'v z)) (q (bl2-ip z z)))
    (fact 'cips-ip-self-real 'v z)
    (fact 'cips-ip-self-nonneg 'v z)
    (dk-have! (list 'AND (list 'IN q 'RR) (list '<= 0 q)) (lambda () (dk-conj-close! (lambda () (ass)))))
    (dk-split-all! (list (dk-fact! 'sqrt-nonneg q)))
    (fact 'ip-norm-unfold 'v z)
    (dk-have! (list 'IN n 'RR) (lambda () (subst (list '== n (list 'SQRT q))) (ass)))
    (dk-have! (list '<= 0 n) (lambda () (subst (list '== n (list 'SQRT q))) (ass)))
    n))
(define (bl2-rr*! a b)
  (dk-have! (list 'AND (list 'IN a 'RR) (list 'IN b 'RR)) (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'rr-mul-closed a b))
(sp (make-wff
  (list 'FORALL 'v (list 'IMPLIES '(IS-COMPLEX-INNER-PRODUCT-SPACE v)
    (list 'FORALL 'yv (list 'IMPLIES '(IN yv (VEC v)) bl2-ucont-H))))))
(dk-peel!)
(fact 'ip-normed-ag-is-normed-ag 'v)
(fact 'ip-normed-ag-carrier 'v)
(fact 'ip-normed-ag-opr 'v)
(fact 'ip-normed-ag-inv 'v)
(fact 'cc-nag@opr)
(fact 'cc-nag@inv)
(fact 'cc-nag@nrm)
(let* ((eps (cadr (dk-pick (lambda (a) (dk-head-is? a 'POS-RR)) "eps")))
       (ny (bl2-norm-facts! 'yv))
       (D (list '+ ny 1)))
  (fact 'rr-pos-rr-in-rr eps)
  (fact 'rr-lt-of-pos-rr eps)
  (dk-have! (list 'AND (list 'IN ny 'RR) '(IN 1 RR)) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (arith))))))
  (fact 'rr-add-closed ny 1)
  (dk-have! (list '< 0 D) (lambda () (dk-ineq! (list '<= 0 ny))))
  (dk-have! (list 'NOT (list '= D 0)) (lambda () (di) (dk-absurd! (list '< 0 D) (list '= D 0))))
  (dk-have! (list 'AND (list 'IN D 'RR) (list 'NOT (list '= D 0))) (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'rr-recip-closed D)
  (fact 'rr-recip-pos D)
  (bl2-rr*! eps (list 'RECIP D))
  (fact 'rr-mul-pos eps (list 'RECIP D))
  (let* ((dl (dk-name! (list '* eps (list 'RECIP D))))
         (dleq (list '= dl (list '* eps (list 'RECIP D)))))
    (dk-have! (list '< 0 dl) (lambda () (subst dleq) (ass)))
    (fact 'rr-pos-rr-of-lt dl)
    (fact 'rr-recip-cancel-right eps D)
    (dk-have! (list '= eps (list '* dl D))
      (lambda () (subst dleq) (ass)))
    (ew dl)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
            (let* ((landed (dk-peel!))
                   (xs (map cadr (filter (lambda (a) (dk-head-is? a 'IN)) landed)))
                   (x (car xs)) (y (cadr xs))
                   (hyp (dk-pick (lambda (a) (and (dk-head-is? a '<) (equal? (caddr a) dl))) "the del bound")))
              (for-each (lambda (z) (dk-rewrite-h! (list 'IN z (list 'CARR bl2-IG)) (list 'CARR bl2-IG) '(VEC v))) xs)
              (fact 'cips-vneg-type 'v y)
              (let* ((ny_ (list (list 'VNEG 'v) y))
                     (dv (list (list 'VADD 'v) x ny_)))
                (fact 'cips-vadd-type 'v x ny_)
                (let* ((h1 (dk-rewrite-h! hyp (list 'OPR bl2-IG) '(VADD v)))
                       (h2 (dk-rewrite-h! h1 (list 'INV bl2-IG) '(VNEG v)))
                       (nv (dk-cite! 'ip-normed-ag-norm-value 'v dv))
                       (h3 (dk-rewrite-h! h2 (cadr nv) (caddr nv)))
                       (nd (bl2-norm-facts! dv)))
                  (bl2-iptype! x 'yv) (bl2-iptype! y 'yv) (bl2-iptype! dv 'yv)
                  (subst '(== (OPR CC-NAG) (VNB-LAMBDA (LIST x_ y_) (CARTESIAN CC CC) (+ x_ y_))))
                  (subst '(== (INV CC-NAG) (VNB-LAMBDA x_ CC (- x_))))
                  (subst '(== (NRM CC-NAG) (VNB-LAMBDA x_ CC (magnitude x_))))
                  (fact 'cc-neg-closed (bl2-ip y 'yv))
                  (dk-have! (list 'AND (list 'IN (bl2-ip x 'yv) 'CC) (list 'IN (list '- (bl2-ip y 'yv)) 'CC))
                    (lambda () (dk-conj-close! (lambda () (ass)))))
                  (fact 'cc-add-closed (bl2-ip x 'yv) (list '- (bl2-ip y 'yv)))
                  (bl2-cc-beta!)
                  (let ((sum (list '+ (bl2-ip x 'yv) (list '- (bl2-ip y 'yv)))))
                    (dk-have! (list '= (bl2-ip dv 'yv) sum)
                      (lambda ()
                        (subst (dk-cite! 'cips-ip-add-left 'v x ny_ 'yv))
                        (subst (dk-cite! 'cips-ip-neg-left 'v y 'yv))
                        (bl2f-close!)))
                    (subst (list '= sum (bl2-ip dv 'yv))))
                  (let* ((M (list 'MAGNITUDE (bl2-ip dv 'yv)))
                         (mle (dk-cite! 'cips-ip-magnitude-le 'v dv 'yv)))
                    (fact 'cc-magnitude-closed (bl2-ip dv 'yv))
                    (bl2-rr*! nd ny) (bl2-rr*! dl ny) (bl2-rr*! dl D)
                    (dk-have! (list '<= nd dl) (lambda () (dk-ineq! h3)))
                    (fact 'rr-mul-le-right nd dl ny)
                    (dk-have! (list '= (list '* dl D) (list '+ (list '* dl ny) dl)) (lambda () (crs)))
                    (dk-ineq! mle (list '<= (list '* nd ny) (list '* dl ny))
                              (list '= eps (list '* dl D)) (list '= (list '* dl D) (list '+ (list '* dl ny) dl))
                              (list '< 0 dl)))))))))))
(bl2-done! 'ip-functional-ucont)

;;; Cor 2.9: <x, yv> = sum_i <x, e_i> <e_i, yv>
(define bl2-cf '(VNB-LAMBDA onk_ ix ((ACT v) ((IP v) x (e onk_)) (e onk_))))
(define bl2-T '(VNB-LAMBDA ipk_ ix (* ((IP v) x (e ipk_)) ((IP v) (e ipk_) yv))))
(sp (make-wff
  (list 'FORALL 'v (list 'IMPLIES '(IS-HILBERT-SPACE v)
    (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES '(IS-ORTHONORMAL-BASIS v ix e)
      (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC v))
        (list 'FORALL 'yv (list 'IMPLIES '(IN yv (VEC v))
          (list 'SUMS-TO 'CC-NAG bl2-T '((IP v) x yv)))))))))))))
(dk-peel!)
(fact 'hilbert-space-is-cips 'v)
(fact 'ip-normed-ag-is-normed-ag 'v)
(fact 'cc-nag-is-normed-ag)
(fact 'ip-normed-ag-carrier 'v)
(fact 'cips-vec-set 'v)
(define bl2c-exp (dk-cite! 'onb-expansion 'v 'ix 'e 'x))
(let* ((onf (dk-project! '(IS-ORTHONORMAL-FAMILY v ix e) 'is-orthonormal-basis '(IS-ORTHONORMAL-BASIS v ix e))))
  (dk-project! '(IN e (FUN ix (VEC v))) 'is-orthonormal-family onf))
(fact 'fun-domain-in-set 'ix '(VEC v) 'e)
(define (bl2c-pt! k)                 ; k in ix: e k, <x, e k>, the coefficient vector, <e k, yv>
  (fact 'fun-apply-type-c 'e 'ix '(VEC v) k)
  (bl2-iptype! 'x (list 'e k))
  (bl2-iptype! (list 'e k) 'yv)
  (fact 'cips-act-type 'v (bl2-ip 'x (list 'e k)) (list 'e k))
  (bl2-iptype! (list (list 'ACT 'v) (bl2-ip 'x (list 'e k)) (list 'e k)) 'yv))
;; cf in FUN(ix, VEC v), DOM cf = ix
(dk-have! (list 'IN bl2-cf '(FUN ix (VEC v)))
  (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (bl2c-pt! k) (bl2f-close!))) (lambda () (ass)))))
(dk-project! (list 'IN bl2-cf '(FUN ix)) 'fun-codomain-iff (list 'IN bl2-cf '(FUN ix (VEC v))))
(dk-have! (list 'AND (list 'IN bl2-cf '(FUN ix)) '(IN ix SET)) (lambda () (dk-conj-close! (lambda () (ass)))))
(fact 'dom-of-fun 'ix bl2-cf)
(dk-split-all! (list (list 'AND (list 'IN (list 'DOM bl2-cf) 'SET) (list '= (list 'DOM bl2-cf) 'ix))))
(dk-have! (list 'IN bl2-cf (list 'FUN (list 'DOM bl2-cf) (list 'CARR bl2-IG)))
  (lambda () (subst (list '= (list 'DOM bl2-cf) 'ix)) (subst (list '== (list 'CARR bl2-IG) '(VEC v))) (ass)))
(dk-have! (list 'IN 'x (list 'CARR bl2-IG)) (lambda () (subst (list '== (list 'CARR bl2-IG) '(VEC v))) (ass)))
(dk-cite! 'ip-functional-hom 'v 'yv)
(dk-cite! 'ip-functional-ucont 'v 'yv)
(define bl2c-res (dk-cite! 'sums-to-uniform-hom bl2-IG 'CC-NAG bl2-H bl2-cf 'x))
(define bl2c-res2 (dk-rewrite-h! bl2c-res (list 'DOM bl2-cf) 'ix))
(define bl2c-L (caddr bl2c-res2))
(define bl2c-Hx (cadddr bl2c-res2))
(dk-have! (list 'IN bl2c-L '(FUN ix CC))
  (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (bl2c-pt! k) (bl2-cc-beta!) (bl2f-close!))) (lambda () (ass)))))
(dk-have! (list 'IN bl2-T '(FUN ix CC))
  (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (bl2c-pt! k)
                                         (dk-have! (list 'AND (list 'IN (bl2-ip 'x (list 'e k)) 'CC) (list 'IN (bl2-ip (list 'e k) 'yv) 'CC))
                                                   (lambda () (dk-conj-close! (lambda () (ass)))))
                                         (fact 'cc-mul-closed (bl2-ip 'x (list 'e k)) (bl2-ip (list 'e k) 'yv))
                                         (bl2f-close!)))
                           (lambda () (ass)))))
(define bl2c-eq
  (dk-fun-ext! bl2c-L bl2-T 'ix 'CC #f #f
    (lambda (k)
      (bl2c-pt! k)
      (let ((c (bl2-ip 'x (list 'e k))))
        (dk-have! (list 'AND (list 'IN c 'CC) (list 'IN (bl2-ip (list 'e k) 'yv) 'CC))
                  (lambda () (dk-conj-close! (lambda () (ass)))))
        (fact 'cc-mul-closed c (bl2-ip (list 'e k) 'yv))
        (let ((hl (dk-cite! 'cips-ip-homog-left 'v c (list 'e k) 'yv)))
          (dk-lam-b!)
          (let loop ((n 0)) (if (and (< n 6) (bl2-open?) (bl2-has-lam? (dk-goal))) (begin (dk-lam-b!) (loop (+ n 1)))))
          (if (bl2-open?) (subst hl))
          (bl2f-close!))))))
(dk-have! (list '= bl2c-Hx '((IP v) x yv))
  (lambda () (bl2-iptype! 'x 'yv) (dk-close-if! (lambda () (dk-lam-b!)) bl2f-close!)))
(let* ((r3 (dk-rewrite-h! bl2c-res2 bl2c-L bl2-T))
       (r4 (dk-rewrite-h! r3 bl2c-Hx '((IP v) x yv))))
  (ass))
(bl2-done! 'onb-inner-product-expansion)

;;; ---------------------------------------------------------------------------
;;; CC-FAMILY-SUM denotes the sum: f sums to r in CC => CC-FAMILY-SUM(f) = r
(sp (make-wff
  '(FORALL f (IMPLIES (IN f (FUN (DOM f) CC))
     (FORALL r (IMPLIES (IN r CC)
       (IMPLIES (SUMS-TO CC-NAG f r) (= (CC-FAMILY-SUM f) r))))))))
(dk-peel!)
(fact 'cc-nag-is-normed-ag)
(fact 'cc-nag@carr)
(define bl2s-S '(SEP csw_ CC (SUMS-TO CC-NAG f csw_)))
(mac 'CC-FAMILY-SUM)
(let* ((mem (choose-mem! bl2s-S 'r (lambda () (in-sep! (lambda () (ass)) (lambda () (ass))))))
       (ch (list 'CHOICE bl2s-S)))
  (dk-landed (lambda () (sep-me mem)))
  (dk-have! (list 'IN 'f (list 'FUN '(DOM f) '(CARR CC-NAG))) (lambda () (subst '(== (CARR CC-NAG) CC)) (ass)))
  (dk-have! (list 'IN ch '(CARR CC-NAG)) (lambda () (subst '(== (CARR CC-NAG) CC)) (ass)))
  (dk-have! '(IN r (CARR CC-NAG)) (lambda () (subst '(== (CARR CC-NAG) CC)) (ass)))
  (dk-have! (list 'AND (list 'SUMS-TO 'CC-NAG 'f ch) '(SUMS-TO CC-NAG f r)) (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'sums-to-unique 'CC-NAG 'f ch 'r)
  (bl2f-close!))
(bl2-done! 'cc-family-sum-value)

;;; ---------------------------------------------------------------------------
;;; th-main Prop 2.6, the part that does not need l2(I) to be a Hilbert space:
;;; W x = (<x, e_i>)_i lies in l2(I), and W preserves the inner product,
;;; <W x, W y>_{l2} = <x, y> (hence W is isometric and injective).
(define (bl2-W z) (list 'VNB-LAMBDA 'cfk_ 'ix (bl2-ip z '(e cfk_))))
(define bl2-gq '(VNB-LAMBDA onk_ ix (* (MAGNITUDE ((IP v) x (e onk_))) (MAGNITUDE ((IP v) x (e onk_))))))
(define (bl2w-ctx!)            ; after the peel: CIPS, e typed, ix a set
  (fact 'hilbert-space-is-cips 'v)
  (fact 'cips-vec-set 'v)
  (let ((onf (dk-project! '(IS-ORTHONORMAL-FAMILY v ix e) 'is-orthonormal-basis '(IS-ORTHONORMAL-BASIS v ix e))))
    (dk-project! '(IN e (FUN ix (VEC v))) 'is-orthonormal-family onf))
  (fact 'fun-domain-in-set 'ix '(VEC v) 'e))
(define (bl2w-type! z)         ; W z in FUN(ix, CC)
  (dk-have! (list 'IN (bl2-W z) '(FUN ix CC))
    (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (bl2c-pt! k) (bl2-iptype! z (list 'e k)) (bl2f-close!)))
                             (lambda () (ass))))))
(sp (make-wff
  (list 'FORALL 'v (list 'IMPLIES '(IS-HILBERT-SPACE v)
    (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES '(IS-ORTHONORMAL-BASIS v ix e)
      (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC v))
        (list 'IN (bl2-W 'x) '(L2-FAMILIES ix)))))))))))
(dk-peel!)
(bl2w-ctx!)
(bl2w-type! 'x)
(mac 'L2-FAMILIES)
(in-sep! (lambda () (ass))
  (lambda ()
    (let* ((lq (cadr (cadr (dk-goal)))))
      (dk-have! (list 'IN bl2-gq '(FUN ix RR))
        (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (bl2c-pt! k)
                                               (fact 'cc-magnitude-closed (bl2-ip 'x (list 'e k)))
                                               (bl2-rr*! (list 'MAGNITUDE (bl2-ip 'x (list 'e k))) (list 'MAGNITUDE (bl2-ip 'x (list 'e k))))
                                               (bl2f-close!)))
                                 (lambda () (ass)))))
      (dk-have! (list 'IN lq '(FUN ix RR))
        (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (bl2c-pt! k)
                                               (let loop ((n 0)) (if (and (< n 6) (bl2-open?) (bl2-has-lam? (dk-goal))) (begin (dk-lam-b!) (loop (+ n 1)))))
                                               (if (bl2-open?)
                                                   (begin
                                                     (fact 'cc-magnitude-closed (bl2-ip 'x (list 'e k)))
                                                     (bl2-rr*! (list 'MAGNITUDE (bl2-ip 'x (list 'e k))) (list 'MAGNITUDE (bl2-ip 'x (list 'e k))))
                                                     (bl2f-close!)))))
                                 (lambda () (ass)))))
      (dk-fun-ext! lq bl2-gq 'ix 'RR #f #f
        (lambda (k)
          (bl2c-pt! k)
          (fact 'cc-magnitude-closed (bl2-ip 'x (list 'e k)))
          (bl2-rr*! (list 'MAGNITUDE (bl2-ip 'x (list 'e k))) (list 'MAGNITUDE (bl2-ip 'x (list 'e k))))
          (let loop ((n 0)) (if (and (< n 6) (bl2-open?) (bl2-has-lam? (dk-goal))) (begin (dk-lam-b!) (loop (+ n 1)))))
          (bl2f-close!)))
      (subst (list '= lq bl2-gq))
      (subst (dk-cite! 'parseval-identity 'v 'ix 'e 'x))
      (fact 'cips-ip-self-real 'v 'x)
      (bl2f-close!))))
(bl2-done! 'onb-coefficients-in-l2)

;;; <W x, W yv>_{l2(I)} = <x, yv>
(define bl2-Tc (list 'VNB-LAMBDA 'ipk_ 'ix (list '* (bl2-ip 'x '(e ipk_)) (list 'conjugate (bl2-ip 'yv '(e ipk_))))))
(sp (make-wff
  (list 'FORALL 'v (list 'IMPLIES '(IS-HILBERT-SPACE v)
    (list 'FORALL 'ix (list 'FORALL 'e (list 'IMPLIES '(IS-ORTHONORMAL-BASIS v ix e)
      (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC v))
        (list 'FORALL 'yv (list 'IMPLIES '(IN yv (VEC v))
          (list '= (list '(L2-IP ix) (bl2-W 'x) (bl2-W 'yv)) (bl2-ip 'x 'yv)))))))))))))
(dk-peel!)
(bl2w-ctx!)
(dk-cite! 'onb-coefficients-in-l2 'v 'ix 'e 'x)
(dk-cite! 'onb-coefficients-in-l2 'v 'ix 'e 'yv)
(define bl2i-exp (dk-cite! 'onb-inner-product-expansion 'v 'ix 'e 'x 'yv))
(bl2-iptype! 'x 'yv)
(mac 'L2-IP)
(let loop ((n 0)) (if (and (< n 4) (bl2-open?) (dk-contains? (dk-goal) 'CARTESIAN)) (begin (dk-lam-b!) (loop (+ n 1)))))
(define (bl2i-pt! k)
  (bl2c-pt! k)
  (bl2-iptype! 'yv (list 'e k))
  (fact 'cc-conjugate-closed (bl2-ip 'yv (list 'e k)))
  (dk-have! (list 'AND (list 'IN (bl2-ip 'x (list 'e k)) 'CC) (list 'IN (bl2-ip (list 'e k) 'yv) 'CC))
            (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'cc-mul-closed (bl2-ip 'x (list 'e k)) (bl2-ip (list 'e k) 'yv))
  (dk-have! (list 'AND (list 'IN (bl2-ip 'x (list 'e k)) 'CC) (list 'IN (list 'conjugate (bl2-ip 'yv (list 'e k))) 'CC))
            (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'cc-mul-closed (bl2-ip 'x (list 'e k)) (list 'conjugate (bl2-ip 'yv (list 'e k)))))
(define (bl2i-beta!) (let loop ((n 0)) (if (and (< n 6) (bl2-open?) (bl2-has-lam? (dk-goal))) (begin (dk-lam-b!) (loop (+ n 1))))))
(let* ((F (cadr (cadr (dk-goal)))))
  (dk-have! (list 'IN F '(FUN ix CC))
    (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (bl2i-pt! k) (bl2i-beta!) (bl2f-close!))) (lambda () (ass)))))
  (dk-have! (list 'IN bl2-T '(FUN ix CC))
    (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (bl2i-pt! k) (bl2f-close!))) (lambda () (ass)))))
  (dk-fun-ext! F bl2-T 'ix 'CC #f #f
    (lambda (k)
      (bl2i-pt! k)
      (let ((cs (dk-cite! 'cips-ip-conj-sym 'v 'yv (list 'e k))))
        (bl2i-beta!)
        (if (bl2-open?) (subst (list '= (list 'conjugate (bl2-ip 'yv (list 'e k))) (bl2-ip (list 'e k) 'yv))))
        (bl2f-close!))))
  (subst (list '= F bl2-T))
  (dk-project! '(IN (VNB-LAMBDA ipk_ ix (* ((IP v) x (e ipk_)) ((IP v) (e ipk_) yv))) (FUN ix))
               'fun-codomain-iff (list 'IN bl2-T '(FUN ix CC)))
  (dk-have! (list 'AND (list 'IN bl2-T '(FUN ix)) '(IN ix SET)) (lambda () (dk-conj-close! (lambda () (ass)))))
  (fact 'dom-of-fun 'ix bl2-T)
  (dk-split-all! (list (list 'AND (list 'IN (list 'DOM bl2-T) 'SET) (list '= (list 'DOM bl2-T) 'ix))))
  (dk-have! (list 'IN bl2-T (list 'FUN (list 'DOM bl2-T) 'CC)) (lambda () (subst (list '= (list 'DOM bl2-T) 'ix)) (ass)))
  (fact 'cc-family-sum-value bl2-T (bl2-ip 'x 'yv))
  (bl2f-close!))
(bl2-done! 'onb-coefficients-ip)
