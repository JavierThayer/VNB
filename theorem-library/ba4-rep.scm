;;; ba4-rep.scm -- THE FUNCTIONAL OF A REPRESENTATION: BanachAlgebras.pdf Proposition 4.11.
;;; Agent BA-1111-B, 2026-11-11.  Destination: theorem-library/ba4-rep.scm.  Library: operator-algebras.
;;; Load window: after ba4-pos (pos-lf-norm), ba-bh2 (B(H) and its value lemmas), hilbert-adjoint
;;; (op-adjoint-ip, -bounded, -involutive, -fun), and structure-library/ba-rep-vocab.
;;;
;;;   bh-ro-vec bh-ro-vadd bh-ro-act bh-ro-vmul bh-ro-vstar bh-ro-vone bh-ro-vnrm
;;;                          the slots of BH-ALGEBRA(v), read off the tuple (H Hilbert)
;;;   rep-functional-value   f_(pi,xi)(x) = <pi(x) xi | xi>
;;;   rep-functional-positive  Proposition 4.11: f_(pi,xi) is a positive linear functional
;;;   rep-functional-norm    Proposition 4.11: ||f_(pi,xi)|| = ||xi||^2
;;;
;;; THE ROUTE for positivity: with T = pi(x), pi(x* x) = T* o T, and <T*(T xi) | xi> = <T xi | T** xi>
;;; = <T xi | T xi> (the adjoint relation at T*, then T** = T); no conjugation is needed.

(define (g4r-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (if (and (not (sequent-node-grounded? l))
                           (let ((g (dk-goal-of l))) (and (pair? g) (eq? (car g) '=) (equal? (cadr g) (caddr g)))))
                      (begin (dk-focus! l) (rfl))))
                (dk-open-leaves)))
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba4-rep: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba4-rep: unfinished" name))))
(define (g4r-close-eq!) (if (not (proof-done? *ps*)) (let ((g (dk-goal))) (if (and (eq? (car g) '=) (equal? (cadr g) (caddr g))) (rfl)))))

;;; ---- the read-offs
(define g4r-B '(BH-ALGEBRA v))
(define g4r-ro '((VEC . (BOUNDED-OPS v v)) (VADD . (BH-VADD v)) (ACT . (BH-ACT v)) (VMUL . (BH-VMUL v))
                 (VSTAR . (BH-VSTAR v)) (VONE . (BOP-ID v)) (VNRM . (BH-VNRM v))))
(define (g4r-ro-name acc) (string->symbol (string-append "bh-ro-" (string-downcase (symbol->string acc)))))
(for-each
  (lambda (pr)
    (sp (make-wff (list 'FORALL 'v (list 'IMPLIES '(IS-HILBERT-SPACE v) (list '== (list (car pr) g4r-B) (cdr pr))))))
    (dk-peel!)
    (mac 'BH-ALGEBRA)
    (slot (car pr))
    (nth-r)
    (if (not (proof-done? *ps*)) (qrfl))
    (g4r-qed! (g4r-ro-name (car pr))))
  g4r-ro)

;;; a formula about BH-ALGEBRA(v)'s slots, rewritten onto the tuple's components
(define (g4r-occurs? x t) (or (equal? x t) (and (pair? t) (or (g4r-occurs? x (car t)) (g4r-occurs? x (cdr t))))))
(define (g4r-readback! f)
  (let loop ((ps g4r-ro) (g f))
    (if (null? ps) g
        (let ((t (list (car (car ps)) g4r-B)))
          (if (g4r-occurs? t g)
              (begin (dk-cite! (g4r-ro-name (car (car ps))) 'v)
                     (loop (cdr ps) (dk-rewrite-h! g t (cdr (car ps)))))
              (loop (cdr ps) g))))))

(define (g4r-st body)
  (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
    (list 'FORALL 'v (list 'FORALL 'p (list 'IMPLIES '(IS-REPRESENTATION a v p)
      (list 'FORALL 'e (list 'IMPLIES '(IN e (VEC v)) body)))))))))
(define g4r-F '(REP-FUNCTIONAL a v p e))
(define (g4r-ip x y) (list '(IP v) x y))
(define (g4r-pe x) (list (list 'p x) 'e))
(define (g4r-vt! t) (dk-alg-type! 'kal-uiba 'a t) t)

;;; open IS-REPRESENTATION(a, v, p); returns the alist of the read-back laws
(define g4r-laws #f)
(define (g4r-open!)
  (let* ((rep '(IS-REPRESENTATION a v p))
         (rb (caddr (dk-cite! 'IS-REPRESENTATION 'a 'v 'p)))
         (hs (dk-project! (cadr rb) 'IS-REPRESENTATION rep))
         (sh (dk-project! (caddr rb) 'IS-REPRESENTATION rep))
         (sb (caddr (dk-cite! 'IS-STAR-HOM 'a g4r-B 'p)))
         (ah (dk-project! (cadr sb) 'IS-STAR-HOM sh))
         (pst (dk-project! (caddr sb) 'IS-STAR-HOM sh))
         (hb (caddr (dk-cite! 'IS-ALG-HOM 'a g4r-B 'p)))
         (c1 (cadr hb)) (r1 (caddr hb)) (c2 (cadr r1)) (r2 (caddr r1)) (c3 (cadr r2)) (r3 (caddr r2))
         (c4 (cadr r3)) (c5 (caddr r3))
         (pf (dk-project! c1 'IS-ALG-HOM ah)) (pa (dk-project! c2 'IS-ALG-HOM ah))
         (pc (dk-project! c3 'IS-ALG-HOM ah)) (pm (dk-project! c4 'IS-ALG-HOM ah))
         (po (dk-project! c5 'IS-ALG-HOM ah)))
    (dk-cite! 'hilbert-space-is-cips 'v)
    (set! g4r-laws
      (list (cons 'fun (g4r-readback! pf)) (cons 'add (g4r-readback! pa)) (cons 'act (g4r-readback! pc))
            (cons 'mul (g4r-readback! pm)) (cons 'one (g4r-readback! po)) (cons 'star (g4r-readback! pst))))
    g4r-laws))
(define (g4r-law k) (cdr (assq k g4r-laws)))
;;; x in VEC a: land p(x) in BOUNDED-OPS, in FUN(VEC v, VEC v), and p(x)(e) in VEC v
(define (g4r-px! x)
  (g4r-vt! x)
  (let ((px (list 'p x)))
    (dk-cite! 'fun-apply-type-c 'p '(VEC a) '(BOUNDED-OPS v v) x)
    (dk-cite! 'bop-fun 'v 'v px)
    (dk-cite! 'fun-apply-type-c px '(VEC v) '(VEC v) 'e)
    px))

;;; ---- rep-functional-value
(sp (g4r-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) (list '= (list g4r-F 'x) (g4r-ip (g4r-pe 'x) 'e))))))
(dk-peel!)
(g4r-open!)
(g4r-px! 'x)
(dk-cite! 'cips-ip-type 'v (g4r-pe 'x) 'e)
(mac 'REP-FUNCTIONAL)
(let ((l (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? l)) (g4r-close-eq!)))
(g4r-qed! 'rep-functional-value)

;;; ---- rep-functional-positive: Proposition 4.11, first part
(define (g4r-val! x) (dk-cite! 'rep-functional-value 'a 'v 'p 'e x))
(define (g4r-rw! from to) (subst (list '= from to)))
(define (g4r-cite*! . args)
  (let loop ((r (apply dk-cite! args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (loop (if (dk-asm? (cadr r))
                  (dk-landed-1 (lambda () (detach! r)))
                  (detach-with! r (lambda () (dk-conj-close! (lambda () (dk-ass!)))))))
        r)))
(sp (g4r-st (list 'IS-POSITIVE-LF 'a g4r-F)))
(dk-peel!)
(g4r-open!)
(let* ((iff (dk-cite! 'IS-POSITIVE-LF 'a g4r-F))
       (liff (dk-cite! 'IS-CC-LINEAR-ON 'a g4r-F))
       (ft (list 'IN g4r-F '(FUN (VEC a) CC))))
  (dk-have! ft
    (lambda ()
      (mac 'REP-FUNCTIONAL)
      (dk-lam-type!
        (lambda ()
          (let* ((x (dk-di-var!)) (claim (dk-goal)))
            (g4r-px! x)
            (dk-cite! 'cips-ip-type 'v (g4r-pe x) 'e)
            (if (equal? (dk-goal) claim) (dk-ass!))))
        (lambda () (dk-cite! 'fun-domain-in-set '(VEC a) '(BOUNDED-OPS v v) 'p) (dk-ass!)))))
  (dk-have! (caddr liff)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (dk-ass!)
              (begin
                (dk-peel!)
                (let* ((g (dk-goal)) (arg (cadr (cadr g))))
                  (if (equal? (car arg) '(VADD a))
                      (let* ((x (cadr arg)) (y (caddr arg)) (px (g4r-px! x)) (py (g4r-px! y))
                             (pxy (g4r-px! arg)))
                        (g4r-rw! (list g4r-F arg) (caddr (g4r-val! arg)))
                        (g4r-rw! (list g4r-F x) (caddr (g4r-val! x)))
                        (g4r-rw! (list g4r-F y) (caddr (g4r-val! y)))
                        (subst (dk-apply! (g4r-law 'add) x y))
                        (subst (dk-cite! 'bh-vadd-value 'v px py))
                        (subst (dk-cite! 'bop-sum-apply 'v 'v px py 'e))
                        (subst (dk-cite! 'cips-ip-add-left 'v (g4r-pe x) (g4r-pe y) 'e))
                        (g4r-close-eq!))
                      (let* ((z (cadr arg)) (x (caddr arg)) (px (g4r-px! x)))
                        (g4r-px! arg)
                        (g4r-rw! (list g4r-F arg) (caddr (g4r-val! arg)))
                        (g4r-rw! (list g4r-F x) (caddr (g4r-val! x)))
                        (subst (dk-apply! (g4r-law 'act) z x))
                        (subst (dk-cite! 'bh-act-value 'v z px))
                        (subst (dk-cite! 'bop-scale-apply 'v 'v z px 'e))
                        (subst (dk-cite! 'cips-ip-homog-left 'v z (g4r-pe x) 'e))
                        (g4r-close-eq!))))))))))
  (let ((lin (list 'IS-CC-LINEAR-ON 'a g4r-F))
        (pos (caddr (caddr iff))))
    (dk-have! lin (lambda () (keep liff (caddr liff)) (prop)))
    (dk-have! pos
      (lambda ()
        (let* ((x (dk-di-var!)) (xs (list '(VSTAR a) x)) (xx (list '(VMUL a) xs x))
               (px (g4r-px! x)) (pxs (g4r-px! xs)) (pxx (g4r-px! xx))
               (A (list 'OP-ADJOINT 'v 'v px)) (w (g4r-pe x)))
          (g4r-rw! (list g4r-F xx) (caddr (g4r-val! xx)))
          (subst (dk-apply! (g4r-law 'mul) xs x))
          (subst (dk-cite! 'bh-vmul-value 'v pxs px))
          (subst (dk-apply! (g4r-law 'star) x))
          (subst (dk-cite! 'bh-vstar-value 'v px))
          (dk-cite! 'op-adjoint-fun 'v 'v px)
          (dk-cite! 'op-adjoint-bounded 'v 'v px)
          (subst (dk-cite! 'bop-comp-apply 'v A px 'e))
          (subst (dk-cite! 'op-adjoint-ip 'v 'v A w 'e))
          (subst (dk-cite! 'op-adjoint-involutive 'v 'v px))
          (dk-cite! 'cips-ip-self-real 'v w)
          (dk-cite! 'cips-ip-self-nonneg 'v w)
          (dk-conj-close! (lambda () (dk-ass!))))))
    (keep iff lin pos)
    (prop)))
(g4r-qed! 'rep-functional-positive)

;;; ---- rep-functional-norm: Proposition 4.11, second part
(sp (g4r-st (list 'AND (list 'IN g4r-F '(CDUAL-VEC a))
                       (list '= (list 'CDUAL-NORM 'a g4r-F) '(* (IP-NORM v e) (IP-NORM v e))))))
(dk-peel!)
(g4r-open!)
(dk-cite! 'rep-functional-positive 'a 'v 'p 'e)
(let* ((nm (dk-cite! 'pos-lf-norm 'a g4r-F))
       (o '(VONE a)))
  (dk-split! nm)
  (g4r-px! o)
  (let* ((v1 (g4r-val! o)))
    (subst (list '= (list 'CDUAL-NORM 'a g4r-F) (list g4r-F o)))
    (g4r-rw! (list g4r-F o) (caddr v1))
    (subst (g4r-law 'one))
    (subst (dk-cite! 'bop-id-apply 'v 'e))
    (dk-cite! 'ip-norm-sq 'v 'e)
    (subst (list '= '(* (IP-NORM v e) (IP-NORM v e)) '((IP v) e e)))
    (dk-conj-close! (lambda () (if (not (dk-ass!)) (g4r-close-eq!))))))
(g4r-qed! 'rep-functional-norm)

;;; ---- f_(pi,xi)(x* x) = <pi(x) xi | pi(x) xi>, f_(pi,xi)(1) = <xi | xi>
(sp (g4r-st (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list '= (list g4r-F '((VMUL a) ((VSTAR a) x) x)) (g4r-ip (g4r-pe 'x) (g4r-pe 'x)))))))
(dk-peel!)
(g4r-open!)
(let* ((x 'x) (xs (list '(VSTAR a) x)) (xx (list '(VMUL a) xs x))
       (px (g4r-px! x)) (pxs (g4r-px! xs)) (pxx (g4r-px! xx))
       (A (list 'OP-ADJOINT 'v 'v px)) (w (g4r-pe x)))
  (g4r-rw! (list g4r-F xx) (caddr (g4r-val! xx)))
  (subst (dk-apply! (g4r-law 'mul) xs x))
  (subst (dk-cite! 'bh-vmul-value 'v pxs px))
  (subst (dk-apply! (g4r-law 'star) x))
  (subst (dk-cite! 'bh-vstar-value 'v px))
  (dk-cite! 'op-adjoint-fun 'v 'v px)
  (dk-cite! 'op-adjoint-bounded 'v 'v px)
  (subst (dk-cite! 'bop-comp-apply 'v A px 'e))
  (subst (dk-cite! 'op-adjoint-ip 'v 'v A w 'e))
  (subst (dk-cite! 'op-adjoint-involutive 'v 'v px))
  (dk-cite! 'cips-ip-type 'v w w)
  (g4r-close-eq!))
(g4r-qed! 'rep-functional-square)

(sp (g4r-st (list '= (list g4r-F '(VONE a)) '((IP v) e e))))
(dk-peel!)
(g4r-open!)
(g4r-px! '(VONE a))
(g4r-rw! (list g4r-F '(VONE a)) (caddr (g4r-val! '(VONE a))))
(subst (g4r-law 'one))
(subst (dk-cite! 'bop-id-apply 'v 'e))
(dk-cite! 'cips-ip-type 'v 'e 'e)
(g4r-close-eq!)
(g4r-qed! 'rep-functional-unit)

;;; ---- Corollary 4.12: a representation is contractive, ||pi(x)|| <= ||x||
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
  (list 'FORALL 'v (list 'FORALL 'p (list 'IMPLIES '(IS-REPRESENTATION a v p)
    (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) '(<= ((VNRM (BH-ALGEBRA v)) (p x)) ((VNRM a) x)))))))))))
(dk-peel!)
(g4r-open!)
(let* ((px (g4r-px! 'x)) (nx '((VNRM a) x)) (xx '((VMUL a) ((VSTAR a) x) x)))
  (dk-split! (dk-cite! 'uiba-vnrm-real 'a 'x))
  (g4r-vt! xx)
  (dk-split! (dk-cite! 'uiba-vnrm-real 'a xx))
  (dk-cite! 'uiba-star-mul-le 'a 'x)
  (subst (dk-cite! 'bh-ro-vnrm 'v))
  (subst (dk-cite! 'bh-vnrm-value 'v px))
  (let* ((spec (dk-cite! 'opnorm-spec 'v 'v px))
         (least (caddr (caddr (caddr spec)))))
    (dk-split-all! (list spec))
    (let loop ((ch (inst*! least nx)))
     (if (and (pair? ch) (eq? (car ch) 'IMPLIES) (dk-asm? (cadr ch)))
      (loop (dk-landed-1 (lambda () (detach! ch))))
      (detach-with! ch
        (lambda ()
          (let* ((eta (dk-di-var!))
                 (F (list 'REP-FUNCTIONAL 'a 'v 'p eta))
                 (te (list px eta)) (q (g4r-ip te te)) (r (g4r-ip eta eta))
                 (n1 (list 'IP-NORM 'v te)) (n2 (list 'IP-NORM 'v eta)) (nxx (list '(VNRM a) xx)))
            (dk-cite! 'fun-apply-type-c px '(VEC v) '(VEC v) eta)
            (dk-cite! 'rep-functional-positive 'a 'v 'p eta)
            (let* ((sq (dk-cite! 'rep-functional-square 'a 'v 'p eta 'x))
                   (un (dk-cite! 'rep-functional-unit 'a 'v 'p eta))
                   (bd (dk-cite! 'pos-lf-bounded 'a F xx))
                   (b1 (dk-rewrite-h! bd (cadr sq) q))
                   (b2 (dk-rewrite-h! b1 (cadr un) r)))
              (dk-cite! 'cips-ip-self-real 'v te) (dk-cite! 'cips-ip-self-nonneg 'v te)
              (dk-cite! 'cips-ip-self-real 'v eta) (dk-cite! 'cips-ip-self-nonneg 'v eta)
              (dk-cite! 'rr-magnitude-is-abs q) (dk-cite! 'rr-abs-of-nonneg q)
              (let* ((b3 (dk-rewrite-h! (dk-rewrite-h! b2 (list 'MAGNITUDE q) (list 'ABS q)) (list 'ABS q) q))
                     (nn (list '* nx nx)))
                (dk-have! (list 'IN nn 'RR) (lambda () (in-rr)))
                (dk-cite! 'rr-mul-le-right nxx nn r)
                (dk-have! (list '= (list '* r nxx) (list '* nxx r)) (lambda () (crs)))
                (dk-have! (list '<= q (list '* nn r))
                  (lambda () (dk-le-chain! q (list '* r nxx) (list '* nxx r) (list '* nn r))))
                (dk-cite! 'ip-norm-in-rr 'v te) (dk-cite! 'ip-norm-nonneg 'v te)
                (dk-cite! 'ip-norm-in-rr 'v eta) (dk-cite! 'ip-norm-nonneg 'v eta)
                (let* ((s1 (dk-cite! 'ip-norm-sq 'v te)) (s2 (dk-cite! 'ip-norm-sq 'v eta))
                       (m (list '* nx n2)))
                  (dk-have! (list 'IN m 'RR) (lambda () (in-rr)))
                  (dk-have! (list '<= 0 m) (lambda () (g4r-cite*! 'cvx-mul-nonneg nx n2) (if (not (proof-done? *ps*)) (dk-ass!))))
                  (dk-have! (list '= (list '* nn (list '* n2 n2)) (list '* m m)) (lambda () (crs)))
                  (dk-have! (list '<= (list '* n1 n1) (list '* m m))
                    (lambda ()
                      (subst s1)
                      (subst (list '= (list '* m m) (list '* nn (list '* n2 n2))))
                      (subst s2)
                      (dk-ass!)))
                  (g4r-cite*! 'rr-square-le-imp-le n1 m)
                  (dk-ass!))))))))
      (dk-ass!))))
(g4r-qed! 'rep-contractive)

;;; pi(1) is the identity, of norm 1 when H is not {0}
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a)
  (list 'FORALL 'v (list 'FORALL 'p (list 'IMPLIES '(IS-REPRESENTATION a v p)
    (list 'IMPLIES '(FORSOME bnx_ (AND (IN bnx_ (VEC v)) (NOT (= bnx_ (VZERO v)))))
      '(= ((VNRM (BH-ALGEBRA v)) (p (VONE a))) 1)))))))))
(dk-peel!)
(g4r-open!)
(subst (dk-cite! 'bh-ro-vnrm 'v))
(subst (g4r-law 'one))
(dk-cite! 'bh-vnrm-vone 'v)
(dk-ass!)
(g4r-qed! 'rep-norm-one)
