;;; THE ROUTE.  (1) The read-offs of the tuple UNITIZATION-NA(a): ACC(U) == the component.  (2) The
;;; norm at literal pairs: nonnegative and definite (here), homogeneous, subadditive and
;;; submultiplicative (BA-1C), each lifted to elements of UNIT-VEC(a) by eta.  (3) The typings of
;;; the operations by lam-t.  (4) IS-COMPLEX-NORMED-ALGEBRA unfolded, the accessors read off, and
;;; every conjunct closed by ONE citation of a law of kal-unit.scm or of (2).
;;;
;;; LOAD WINDOW: after kal-unit.scm (and so BA-1C's ba-unitization and kal-laws).

(define (kuc-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (if (and (not (sequent-node-grounded? l))
                           (let ((g (dk-goal-of l))) (and (pair? g) (eq? (car g) '=) (equal? (cadr g) (caddr g)))))
                      (begin (dk-focus! l) (rfl))))
                (dk-open-leaves)))
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** kal-unit-cna: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "kal-unit-cna: unfinished" name))))
(define (kuc-cite2! . args)
  (let loop ((ch (apply dk-cite! args)))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
(define (kuc-fa v cls body) (list 'FORALL v (list 'IMPLIES (list 'IN v cls) body)))
(define (kuc-st body) (list 'FORALL 'a (list 'IMPLIES '(IS-COMPLEX-NORMED-ALGEBRA a) body)))
(define kuc-U '(UNITIZATION-NA a))
(define kuc-Z '(VZERO a))
(define kuc-zero '(LIST 0 (VZERO a)))
(define (kuc-un p) (list '(UNIT-VNRM a) p))
(define (kuc-nr x) (list '(VNRM a) x))

;;; the components of the tuple UNITIZATION-NA(a), by accessor
(define kuc-components
  '((SCAL (NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)) (VEC (UNIT-VEC a)) (VADD (UNIT-VADD a))
    (VZERO (LIST 0 (VZERO a))) (VNEG (UNIT-VNEG a)) (ACT (UNIT-ACT a)) (VNRM (UNIT-VNRM a))
    (VMUL (UNIT-VMUL a))))
(define kuc-L (cons 'LIST (map cadr kuc-components)))
(define (kuc-ro-name acc) (symbol-append 'kuc-ro- (string->symbol (string-downcase (symbol->string acc)))))

;;; ---- (2) the norm --------------------------------------------------------------------------
(define (kuc-vnrm-open! l x)              ; rewrite ||(l, x)|| = |l| + ||x|| in the goal; type both terms
  (dk-cc-type! l) (dk-alg-type! 'kal-cna 'a x)
  (let ((e (dk-cite! 'bun-vnrm-apply 'a l x)))
    (dk-cite! 'cc-magnitude-closed l) (dk-cite! 'cc-magnitude-nonneg l)
    (dk-cite! 'bal-cna-vnrm-fun 'a)
    (dk-cite! 'fun-apply-type-c '(VNRM a) '(VEC a) 'RR x)
    (dk-cite! 'bal-cna-vnrm-nonneg 'a x)
    e))
;;; 0 <= ||(l, x)||
(sp (make-wff (kuc-st (kuc-fa 'l 'CC (kuc-fa 'x '(VEC a) (list '<= 0 (kuc-un '(LIST l x))))))))
(dk-peel!)
(let ((e (kuc-vnrm-open! 'l 'x)))
  (subst e)
  (dk-ineq! '(<= 0 (magnitude l)) (list '<= 0 (kuc-nr 'x))))
(kuc-qed! 'kuc-vnrm-nonneg-pair)
;;; ||(l, x)|| = 0 iff (l, x) = (0, 0)
(sp (make-wff (kuc-st (kuc-fa 'l 'CC (kuc-fa 'x '(VEC a)
  (list 'IFF (list '= (kuc-un '(LIST l x)) 0) (list '= '(LIST l x) kuc-zero)))))))
(dk-peel!)
(let ((e (kuc-vnrm-open! 'l 'x)) (ml '(magnitude l)) (nx (kuc-nr 'x)))
  (dk-alg-type! 'kal-cna 'a kuc-Z)
  (dk-cc-type! 0)
  (dk-have! '(IN 0 RR) (lambda () (arith)))
  (dk-iff! (lambda (g) (equal? g (list '= '(LIST l x) kuc-zero)))
    (lambda ()
      (let ((h (dk-rewrite-h! (list '= (kuc-un '(LIST l x)) 0) (cadr e) (caddr e))))
        (dk-have! (list '<= ml 0) (lambda () (dk-ineq! h (list '<= 0 nx))))
        (dk-have! (list '<= nx 0) (lambda () (dk-ineq! h '(<= 0 (magnitude l)))))
        (kuc-cite2! 'rr-leq-antisymmetric ml 0)
        (kuc-cite2! 'rr-leq-antisymmetric nx 0)
        (let ((d1 (dk-cite! 'cc-magnitude-zero-iff 'l)) (d2 (dk-cite! 'bal-cna-vnrm-definite 'a 'x)))
          (dk-have! '(= l 0) (lambda () (keep d1 (list '= ml 0)) (prop)))
          (dk-have! (list '= 'x kuc-Z) (lambda () (keep d2 (list '= nx 0)) (prop))))
        (subst '(= l 0))
        (subst (list '= 'x kuc-Z))
        (dk-cite! 'pair-in-cartesian 'CC '(VEC a) 0 kuc-Z)
        (rfl)))
    (lambda ()
      (subst (list '= '(LIST l x) kuc-zero))
      (let ((e0 (kuc-vnrm-open! 0 kuc-Z)))
        (subst e0)
        (dk-cite! 'cc-magnitude-zero)
        (subst '(= (magnitude 0) 0))
        (dk-cite! 'bun-vnrm-zero 'a)
        (subst (list '= (kuc-nr kuc-Z) 0))
        (arith)))))
(kuc-qed! 'kuc-vnrm-definite-pair)

;;; eta lifts: (kuc-lift! PAIR NAME NSCAL NVEC BUILD), BUILD (scalars elements) -> the body
(define kuc-cs '(kqc_ kqd_))
(define kuc-ls '(kql_ kqm_))
(define kuc-xs '(kqx_ kqy_))
(define kuc-us '(kqu_ kqv_))
(define (kuc-take l n) (if (= n 0) '() (cons (car l) (kuc-take (cdr l) (- n 1)))))
(define (kuc-eta! u)
  (dk-project! (list 'IN u '(CARTESIAN CC (VEC a))) 'unit-vec-unfold (list 'IN u '(UNIT-VEC a)))
  (dk-cite! 'cartesian-pair-eq u 'CC '(VEC a))
  (dk-split! (dk-cite! 'cartesian-nth u 'CC '(VEC a)))
  (list 'LIST (list 'NTH 1 u) (list 'NTH 2 u)))
(define (kuc-lift! pair-name name nscal nvec build)
  (let* ((cs (kuc-take kuc-cs nscal)) (us (kuc-take kuc-us nvec)))
    (sp (make-wff (kuc-st
      (fold-right (lambda (c b) (kuc-fa c 'CC b))
        (fold-right (lambda (u b) (kuc-fa u '(UNIT-VEC a) b)) (build cs us) us)
        cs))))
    (dk-peel!)
    (let* ((etas (map kuc-eta! us))
           (f0 (apply dk-cite! pair-name 'a (append cs (append-map cdr etas)))))
      (let loop ((f f0) (prs etas) (vs us))
        (if (pair? prs) (loop (dk-rewrite-h! f (car prs) (car vs)) (cdr prs) (cdr vs))))
      (dk-ass!))
    (kuc-qed! name)))
(define (kuc-ad p q) (list '(UNIT-VADD a) p q))
(define (kuc-mu p q) (list '(UNIT-VMUL a) p q))
(define (kuc-ac c p) (list '(UNIT-ACT a) c p))
(kuc-lift! 'kuc-vnrm-nonneg-pair 'unitization-vnrm-nonneg 0 1
  (lambda (cs ps) (list '<= 0 (kuc-un (car ps)))))
(kuc-lift! 'kuc-vnrm-definite-pair 'unitization-vnrm-definite 0 1
  (lambda (cs ps) (list 'IFF (list '= (kuc-un (car ps)) 0) (list '= (car ps) kuc-zero))))
(kuc-lift! 'unitization-norm-homog 'unitization-vnrm-homog 1 1
  (lambda (cs ps) (list '= (kuc-un (kuc-ac (car cs) (car ps))) (list '* (list 'magnitude (car cs)) (kuc-un (car ps))))))
(kuc-lift! 'unitization-norm-triangle 'unitization-vnrm-triangle 0 2
  (lambda (cs ps) (list '<= (kuc-un (kuc-ad (car ps) (cadr ps))) (list '+ (kuc-un (car ps)) (kuc-un (cadr ps))))))
(kuc-lift! 'unitization-norm-submult 'unitization-vnrm-submult 0 2
  (lambda (cs ps) (list '<= (kuc-un (kuc-mu (car ps) (cadr ps))) (list '* (kuc-un (car ps)) (kuc-un (cadr ps))))))

;;; ---- (3) the typings of the operations ---------------------------------------------------------
(define (kuc-binders g)                    ; the guarded binders of a FORALL chain: ((v C) ...)
  (if (and (dk-head-is? g 'FORALL) (dk-head-is? (caddr g) 'IMPLIES) (dk-head-is? (cadr (caddr g)) 'IN)
           (eq? (cadr (cadr (caddr g))) (cadr g)))
      (cons (list (cadr g) (caddr (cadr (caddr g)))) (kuc-binders (caddr (caddr g))))
      '()))
(define (kuc-cna-facts!)
  (dk-cite! 'cc-is-set) (dk-cite! 'bal-cna-vec-set 'a))
(sp (make-wff (kuc-st '(IN (UNIT-VEC a) SET))))
(dk-peel!)
(kuc-cna-facts!)
(mac 'UNIT-VEC)
(mac 'cartesian-set-iff)
(dk-conj-close! (lambda () (dk-ass!)))
(kuc-qed! 'kuc-uv-set)
(define (kuc-set-close!)
  (let ((x (cadr (dk-goal))))
    (cond ((dk-asm? (dk-goal)) (dk-ass!))
          ((equal? x 'CC) (dk-cite! 'cc-is-set) (dk-ass!))
          ((equal? x '(UNIT-VEC a)) (dk-cite! 'kuc-uv-set 'a) (dk-ass!))
          ((dk-head-is? x 'CARTESIAN)
           (mac 'cartesian-set-iff) (dk-conj-close! kuc-set-close!))
          (#t (error "kuc-set-close!: no route" (expression->string (dk-goal)))))))
(define (kuc-uv-close!)                    ; the goal (IN (LIST c w) (UNIT-VEC a)), c and w built from typed atoms
  (let* ((p (cadr (dk-goal))) (c (cadr p)) (w (caddr p)))
    (dk-cc-type! c) (dk-alg-type! 'kal-cna 'a w)
    (dk-cite! 'pair-in-cartesian 'CC '(VEC a) c w)
    (dk-cite! 'unit-vec-unfold 'a)
    (subst '(= (UNIT-VEC a) (CARTESIAN CC (VEC a))))
    (dk-ass!)))
(define (kuc-typer!)
  (let ((bs (kuc-binders (dk-goal))))
    (dk-peel!)
    (for-each (lambda (b) (if (equal? (cadr b) '(UNIT-VEC a)) (kuc-eta! (car b)))) bs)
    (let* ((g (dk-goal)) (t (cadr g)) (cls (caddr g)))
      (cond ((equal? cls '(UNIT-VEC a)) (kuc-uv-close!))
            ((eq? cls 'RR)                 ; |l| + ||x||
             (let ((m (cadr t)) (n (caddr t)))
               (dk-cite! 'cc-magnitude-closed (cadr m))
               (dk-cite! 'bal-cna-vnrm-fun 'a)
               (dk-cite! 'fun-apply-type-c '(VNRM a) '(VEC a) 'RR (cadr n))
               (kuc-cite2! 'rr-add-closed m n)
               (dk-ass!)))
            (#t (error "kuc-typer!: unexpected typing goal" (expression->string g)))))))
(sp (make-wff (kuc-st (list 'IN kuc-zero '(UNIT-VEC a)))))
(dk-peel!)
(kuc-uv-close!)
(kuc-qed! 'kuc-zero-in)
(define kuc-typings
  '((kuc-typ-vadd UNIT-VADD (FUN (CARTESIAN (UNIT-VEC a) (UNIT-VEC a)) (UNIT-VEC a)))
    (kuc-typ-vneg UNIT-VNEG (FUN (UNIT-VEC a) (UNIT-VEC a)))
    (kuc-typ-act UNIT-ACT (FUN (CARTESIAN CC (UNIT-VEC a)) (UNIT-VEC a)))
    (kuc-typ-vnrm UNIT-VNRM (FUN (UNIT-VEC a) RR))
    (kuc-typ-vmul UNIT-VMUL (FUN (CARTESIAN (UNIT-VEC a) (UNIT-VEC a)) (UNIT-VEC a)))))
(for-each
  (lambda (e)
    (sp (make-wff (kuc-st (list 'IN (list (cadr e) 'a) (caddr e)))))
    (dk-peel!)
    (mac (cadr e))
    (dk-lam-type! kuc-typer! kuc-set-close!)
    (kuc-qed! (car e)))
  kuc-typings)
(define (kuc-typings!)                     ; every component of the tuple typed, in context
  (kuc-cna-facts!)
  (dk-cite! 'kuc-uv-set 'a) (dk-cite! 'kuc-zero-in 'a)
  (for-each (lambda (e) (dk-cite! (car e) 'a)) kuc-typings)
  (dk-cite! 'cc-is-normed-field)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD))

;;; ---- (4) the read-offs of the tuple -------------------------------------------------------------
(for-each
  (lambda (e)
    (let ((acc (car e)) (val (cadr e)))
      (sp (make-wff (kuc-st (list '== (list acc kuc-U) val))))
      (dk-peel!)
      (kuc-typings!)
      (dk-have! (list 'IN kuc-L 'SET) (lambda () (dk-list-in-set!)))
      (mac 'UNITIZATION-NA)
      ;; slot + nth-r to a FIXPOINT: (slot 'VZERO) also reads the inner algebra's (VZERO a), so
      ;; the two sides agree only once every occurrence has been read the same way
      (let outer ((j 0))
        (let ((g0 (dk-goal)))
          (if (dk-contains? g0 acc) (quietly (lambda () (slot acc))))
          (let loop ((k 0))
            (let ((g (dk-goal)))
              (quietly (lambda () (nth-r)))
              (if (and (< k 6) (not (equal? g (dk-goal)))) (loop (+ k 1)))))
          (if (and (< j 4) (not (alpha-equiv? (cadr (dk-goal)) (caddr (dk-goal))))
                   (not (equal? g0 (dk-goal))))
              (outer (+ j 1)))))
      (qrfl)
      (kuc-qed! (kuc-ro-name acc))))
  kuc-components)
(display "\n;; KUC stage 4 qed failures: ")  

;;; ---- (5) Proposition 1.1: the unitization is a complex normed algebra ------------------------------
;;; the general laws a conjunct may be: each is forall a. IS-CNA(a) => BODY
(define kuc-law-names
  '(unitization-vadd-assoc unitization-vadd-comm unitization-vadd-zero-left unitization-vadd-zero-right
    unitization-vadd-neg-left unitization-vadd-neg-right unitization-act-vadd unitization-act-add
    unitization-act-mul unitization-act-one unitization-vmul-assoc unitization-vmul-dist-left
    unitization-vmul-dist-right unitization-vmul-act-left unitization-vmul-act-right
    unitization-vnrm-nonneg unitization-vnrm-definite unitization-vnrm-homog unitization-vnrm-triangle
    unitization-vnrm-submult))
(define (kuc-law-body name)                ; BODY at the variable a
  (let ((f (->raw-formula (lookup-theorem name))))
    (caddr (caddr f))))
(define (kuc-strip body n)                 ; peel n guarded binders: (vars . matrix)
  (if (= n 0) (cons '() body)
      (let ((r (kuc-strip (caddr (caddr body)) (- n 1))))
        (cons (cons (cadr body) (car r)) (cdr r)))))
(define (kuc-cite-matching! eigs)          ; close the focus goal by the law whose matrix at EIGS is it
  (let ((g (dk-goal)) (n (length eigs)))
    (let loop ((ns kuc-law-names))
      (if (null? ns) (error "kuc-cite-matching!: no law matches" (expression->string g)))
      (let* ((b (kuc-law-body (car ns))) (bs (kuc-binders b)))
        (if (= (length bs) n)
            (let* ((r (kuc-strip b n))
                   (m (let sub ((vs (car r)) (es eigs) (m (cdr r)))
                        (if (null? vs) m (sub (cdr vs) (cdr es) (subst-free (car vs) (car es) m))))))
              (if (alpha-equiv? m g)
                  (begin (apply dk-cite! (car ns) 'a eigs) (dk-ass!))
                  (loop (cdr ns))))
            (loop (cdr ns)))))))
(define (kuc-close-forall!)
  (let ((eigs (map car (kuc-binders (dk-goal)))))
    (dk-peel!)
    (let ((g (dk-goal)))
      (if (dk-contains? g 'VNB-LAMBDA) (dk-lam-b!))
      (if (dk-head-is? (dk-goal) 'AND)
          (dk-each-leaf! di (lambda () (kuc-cite-matching! eigs)))
          (kuc-cite-matching! eigs)))))
(define (kuc-close-leaf!)
  (let* ((g (dk-goal)) (h (dk-head g)))
    (cond ((dk-asm? g) (dk-ass!))
          ((and (eq? h '=) (dk-head-is? (cadr g) 'LENGTH)) (mac 'UNITIZATION-NA) (len-r) (arith))
          ((eq? h 'IS-RING)
           (dk-cite! 'commutative-ring-is-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)) (dk-ass!))
          ((and (eq? h '=) (equal? (cadr g) (caddr g))) (rfl))
          ((memq h '(is-associative is-commutative is-identity has-inverses))
           (mac h) (kuc-close-forall!))
          ((eq? h 'FORALL) (kuc-close-forall!))
          (#t (error "kuc-close-leaf!: unexpected conjunct" (expression->string g))))))
(define (kuc-guard tag thunk)
  (call-with-current-continuation
    (lambda (k) (with-exception-handler
                  (lambda (e) (display "\n;; KUC LEAF FAILED ") (display tag) (display ": ")
                          (display (if (condition? e) (condition/report-string e) e)) (newline) (k #f))
                  thunk))))
(sp (make-wff (kuc-st (list 'IS-COMPLEX-NORMED-ALGEBRA kuc-U))))
(dk-peel!)
(kuc-typings!)
(mac 'IS-COMPLEX-NORMED-ALGEBRA)
(dk-isx-set! 'UNITIZATION-NA)
(for-each (lambda (e)
            (let ((t (list (car e) kuc-U)))
              (if (dk-contains? (dk-goal) (car e))
                  (begin (dk-cite! (kuc-ro-name (car e)) 'a)
                         (if (dk--occurs? t (dk-goal)) (subst (list '= t (cadr e))))))))
          kuc-components)
(for-each (lambda (m) (if (dk--occurs? (list (string->symbol (string-upcase (symbol->string m)))) (dk-goal)) #t)
                      (vnb-guard (lambda () (quietly (lambda () (mac m))))))
          '(cc-scalar-ring-carr cc-scalar-ring-add cc-scalar-ring-mul cc-scalar-ring-one))
(let loop ((k 0))
  (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (dk-open-leaves))))
    (if (and l (< k 80)) (begin (dk-focus! l) (di) (loop (+ k 1))))))
(for-each (lambda (l)
            (if (not (sequent-node-grounded? l))
                (begin (dk-focus! l)
                       (kuc-guard (expression->string (dk-goal-of l)) kuc-close-leaf!))))
          (dk-open-leaves))
(kuc-qed! 'unitization-is-complex-normed-algebra)
(display "\n;; KUC qed failures: ")  
