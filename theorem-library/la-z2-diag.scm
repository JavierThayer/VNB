;;; la-z2-diag.scm -- the uniqueness half of linear algebra 3.36: the gcd of the
;;; order-s subdeterminants of a diagonal matrix with the divisibility chain is
;;; b_11 ... b_ss, so two such matrices equivalent by integral elementary operations
;;; are equal (LA-Z2, 2026-10-23).
;;;
;;; Vocabulary: SUBMATRIX, SDET, ELEM-EQUIV, ZZ-IS-GCD-SET (structure-library/la-z-vocab);
;;; the theorems of la-z-sdet / la-z-gcd (3.29, 3.31).  Prefix lzd-.
;;;
;;; PLAN.
;;;  (1) Pigeonhole on intervals: an injection [1,s] -> [1,m] all of whose values are
;;;      <= t has s <= t (card-image-injection-curried, card-subset-mono).
;;;  (2) The skip map x |-> (x < i0 ? x : x + 1) of MINOR, composed with an index map:
;;;      typing, injectivity; the minor of a submatrix is the submatrix on the skipped
;;;      index maps (lzd-minor-submatrix).
;;;  (3) THE DIVISIBILITY (lzd-diag-minor-div), by induction on s: for D diagonal with
;;;      the chain b_i | b_j (i <= j) and injections p, q from [1,s], the product
;;;      b_1 ... b_s divides det SUBMATRIX(D, s, p, q).  Step: by (1) some row i0 has
;;;      p(i0) >= s+1; expand along row i0 (det-expand-row).  Row i0 of the submatrix
;;;      holds D_{p(i0), q(j)}, zero unless q(j) = p(i0), which happens for at most one
;;;      j0 (q injective).  The surviving term is +/- b_{p(i0)} det(minor), the minor is
;;;      an order-s subdeterminant of D (2), divisible by b_1 ... b_s (induction), and
;;;      b_{s+1} | b_{p(i0)} (chain).
;;;  (4) The leading subdeterminant (p = q = identity) is b_1 ... b_s
;;;      (det-upper-triangular).  So b_1 ... b_s is a gcd of SDET_s(D) over Z.
;;;  (5) Uniqueness: D ~ D2 (ELEM-EQUIV over ZZ-RING), both diagonal, non-negative,
;;;      with the chain: by 3.31 the products agree up to sign for every s; induction
;;;      on s gives b_s = b2_s.
;;;
;;; Destination theorem-library/.  Library: linear-algebra.

(define (lzd-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z2-diag: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline))
                  (dk-open-leaves))))
  (qed name))
(define (lzd-iv n) (list 'INTERVAL 1 n))
(define (lzd-typ! t cls)
  (if (not (dk-asm? (list 'IN t cls)))
      (dk-have! (list 'IN t cls) dk-typ-close!)))
(define (lzd-app! f x dom cod)
  (if (not (dk-asm? (list 'IN (list f x) cod)))
      (fact 'fun-apply-type-c f dom cod x)))
(define (lzd-iv-vars landed s)
  (map cadr (filter (lambda (f) (and (eq? (car f) 'IN) (equal? (caddr f) (lzd-iv s)))) landed)))
;; injection read-offs (la-z-sdet's lzs-inj-parts!: injection-in-fun loads too late)
(define (lzd-inj-parts! f dom cod)
  (let* ((mem (list 'IN f (list 'INJECTION dom cod)))
         (ignore (dk-cite! 'injection-membership-iff dom cod f))
         (iff (iff-for mem))
         (rhs (caddr iff)))
    (if (not (dk-asm? (cadr rhs)))
        (dk-have! (cadr rhs) (dk-lane (lambda () (dk-only! iff mem) (dk-lane-if! prop)))))
    (if (not (dk-asm? (caddr rhs)))
        (dk-have! (caddr rhs) (dk-lane (lambda () (dk-only! iff mem) (dk-lane-if! prop)))))
    rhs))
(define (lzd-inj-fun! f dom cod)
  (if (not (dk-asm? (list 'IN f (list 'FUN dom cod))))
      (lzd-inj-parts! f dom cod)))
(define (lzd-inj-eq! dom cod f a b)
  (let ((rhs (lzd-inj-parts! f dom cod)))
    (dk-apply! (dk-ctx-form (caddr rhs)) a b)))
(define (lzd-contra! notf)
  (if (not (eq? (dk-goal) 'FALSITY)) (pbc))
  (ai notf))
;; the interval facts of u in [1,s]: u in NN, 1 <= u, u <= s
(define (lzd-iv-facts! u s)
  (fact 'interval-elt-in-nn 1 s u)
  (fact 'interval-lo 1 s u)
  (fact 'interval-hi 1 s u))

;;; =====================================================================
;;; (1) Pigeonhole on intervals.
;;; =====================================================================
(sp (make-wff (forall-guarded '(s m t p)
                '((IN s NN) (IN m NN) (IN t NN) (IN p (INJECTION (INTERVAL 1 s) (INTERVAL 1 m)))
                  (FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 s)) (<= (p i_) t))))
                '(<= s t))))
(dk-peel!)
(lzd-inj-fun! 'p (lzd-iv 's) (lzd-iv 'm))
(fact 'interval-in-set 1 's) (fact 'interval-card-in-nn 1 's)
(fact 'interval-in-set 1 't) (fact 'interval-card-in-nn 1 't)
(fact 'nn-one-in)
(let* ((img '(IMAGE p (INTERVAL 1 s)))
       (ci (dk-cite! 'card-image-injection-curried '(INTERVAL 1 s) '(INTERVAL 1 m) 'p))
       (allt '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 s)) (<= (p i_) t)))))
  (dk-have! (list 'SUBSET img '(INTERVAL 1 t))
    (lambda ()
      (mac 'subset-def)
      (let* ((w (dk-di-var!))
             (iff (dk-cite! 'image-membership-iff 'p '(INTERVAL 1 s) w))
             (rhs (caddr iff)))
        (dk-have! rhs (dk-lane (lambda () (dk-only! iff (list 'IN w img)) (dk-lane-if! prop))))
        (let* ((x (dk-skolem! (dk-ctx-form rhs))))
          (lzd-app! 'p x (lzd-iv 's) (lzd-iv 'm))
          (lzd-iv-facts! (list 'p x) 'm)
          (dk-apply! allt x)
          (dk-cite! 'interval-mem-intro 1 't (list 'p x))
          (subst (list '= w (list 'p x)))
          (ass)))))
  (let* ((le (dk-cite! 'card-subset-mono '(INTERVAL 1 t) img))
         (e1 (dk-cite! 'interval-card 's))
         (e2 (dk-cite! 'interval-card 't))
         (h1 (dk-rewrite-h! le (list 'CARD img) '(CARD (INTERVAL 1 s))))
         (h2 (dk-rewrite-h! h1 '(CARD (INTERVAL 1 s)) 's))
         (h3 (dk-rewrite-h! h2 '(CARD (INTERVAL 1 t)) 't)))
    (ass)))
(lzd-done! 'interval-injection-bound)
(topic! 'interval-injection-bound 'algebra)
(gloss! 'interval-injection-bound "Pigeonhole: an injection of [1,s] into [1,m] whose values are at most t has s <= t.")

;;; =====================================================================
;;; (2) The skip map.
;;; =====================================================================
(define (lzd-sk x i0) (list 'IF (list '< x i0) x (list 'succ x)))
(define (lzd-skp p i0) (list 'VNB-LAMBDA 'skx_ '(INTERVAL 1 s) (list p (lzd-sk 'skx_ i0))))

(sp (make-wff (forall-guarded '(s i0 u) '((IN s NN) (IN i0 NN) (IN u (INTERVAL 1 s)))
                (list 'IN (lzd-sk 'u 'i0) '(INTERVAL 1 (succ s))))))
(dk-peel!)
(lzd-iv-facts! 'u 's)
(fact 'nn-succ-closed 's)
(dk-case-if! (lzd-sk 'u 'i0)
  (lambda (tv val)
    (if tv
        (begin
          (dk-have! '(<= u (succ s)) (lambda () (dk-nn! '(<= u s))))
          (dk-cite! 'interval-mem-intro 1 '(succ s) 'u)
          (ass))
        (begin
          (fact 'nn-succ-closed 'u)
          (fact 'nn-one-le-succ 'u)
          (dk-cite! 'nn-succ-mono 'u 's)
          (dk-cite! 'interval-mem-intro 1 '(succ s) '(succ u))
          (ass)))))
(lzd-done! 'lzd-skip-type)
(topic! 'lzd-skip-type 'plumbing)

;; the skip map is injective
(sp (make-wff (forall-guarded '(i0 u v) '((IN i0 NN) (IN u NN) (IN v NN) (= (IF (< u i0) u (succ u)) (IF (< v i0) v (succ v))))
                '(= u v))))
(let* ((ld (dk-peel!))
       (e (find-first (dk-head? '=) ld))
       (su (lzd-sk 'u 'i0)) (sv (lzd-sk 'v 'i0)))
  (fact 'nn-succ-closed 'u) (fact 'nn-succ-closed 'v)
  (for-each (lambda (t) (fact 'nn-in-rr t)) '(u v i0 (succ u) (succ v)))
  (dk-cite! 'nn-succ-plus-one 'u) (dk-cite! 'nn-succ-plus-one 'v)
  (define (value-eq! x tv)                   ; land (= sk(x) value) on the branch
    (let ((ift (lzd-sk x 'i0)) (val (if tv x (list 'succ x))))
      (dk-have! (list '= ift val)
        (lambda () (dk-if-branch! tv ift #f (lambda () (rfl)))))
      (list '= ift val)))
  (use-em '(< u i0)
    (lambda ()
      (use-em '(< v i0)
        (lambda ()
          (value-eq! 'u #t) (value-eq! 'v #t)
          (let* ((h1 (dk-rewrite-h! e su 'u)) (h2 (dk-rewrite-h! h1 sv 'v))) (ass)))
        (lambda ()
          (value-eq! 'u #t) (value-eq! 'v #f)
          (let* ((h1 (dk-rewrite-h! e su 'u)) (h2 (dk-rewrite-h! h1 sv '(succ v))))
            (dk-cite! 'nn-not-lt-le 'v 'i0)
            (dk-absurd! '(< u i0) '(<= i0 v) h2 '(= (succ v) (+ v 1)))))))
    (lambda ()
      (use-em '(< v i0)
        (lambda ()
          (value-eq! 'u #f) (value-eq! 'v #t)
          (let* ((h1 (dk-rewrite-h! e su '(succ u))) (h2 (dk-rewrite-h! h1 sv 'v)))
            (dk-cite! 'nn-not-lt-le 'u 'i0)
            (dk-absurd! '(< v i0) '(<= i0 u) h2 '(= (succ u) (+ u 1)))))
        (lambda ()
          (value-eq! 'u #f) (value-eq! 'v #f)
          (let* ((h1 (dk-rewrite-h! e su '(succ u))) (h2 (dk-rewrite-h! h1 sv '(succ v))))
            (dk-cite! 'nn-succ-inj 'u 'v)
            (ass)))))))
(lzd-done! 'lzd-skip-inj)
(topic! 'lzd-skip-inj 'plumbing)

(define (lzd-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
;; the skipped index map is a function [1,s] -> [1,m]
(sp (make-wff (forall-guarded '(s m p i0)
                '((IN s NN) (IN m NN) (IN p (FUN (INTERVAL 1 (succ s)) (INTERVAL 1 m))) (IN i0 NN))
                (list 'IN (lzd-skp 'p 'i0) '(FUN (INTERVAL 1 s) (INTERVAL 1 m))))))
(dk-peel!)
(dk-lam-type!
  (lambda ()
    (let ((x (car (lzd-iv-vars (dk-peel!) 's))))
      (lzd-beta!)
      (dk-cite! 'lzd-skip-type 's 'i0 x)
      (lzd-app! 'p (lzd-sk x 'i0) (lzd-iv '(succ s)) (lzd-iv 'm))
      (ass)))
  (lambda () (fact 'interval-in-set 1 's) (ass)))
(lzd-done! 'lzd-skp-fun)
(topic! 'lzd-skp-fun 'plumbing)

;; ... and an injection when p is one
(sp (make-wff (forall-guarded '(s m p i0)
                '((IN s NN) (IN m NN) (IN p (INJECTION (INTERVAL 1 (succ s)) (INTERVAL 1 m))) (IN i0 NN))
                (list 'IN (lzd-skp 'p 'i0) '(INJECTION (INTERVAL 1 s) (INTERVAL 1 m))))))
(dk-peel!)
(fact 'nn-succ-closed 's)
(lzd-inj-fun! 'p (lzd-iv '(succ s)) (lzd-iv 'm))
(define lzd-P2 (lzd-skp 'p 'i0))
(fact 'injection-membership-iff (lzd-iv 's) (lzd-iv 'm) lzd-P2)
(let* ((iff (iff-for (list 'IN lzd-P2 '(INJECTION (INTERVAL 1 s) (INTERVAL 1 m)))))
       (rhs (caddr iff)) (c1 (cadr rhs)) (c2 (caddr rhs)))
  (dk-cite! 'lzd-skp-fun 's 'm 'p 'i0)
  (dk-have! c2
    (lambda ()
      (let* ((landed (dk-peel!))
             (ab (lzd-iv-vars landed 's)) (a (car ab)) (b (cadr ab))
             (e (find-first (dk-head? '=) landed)))
        (dk-cite! 'lzd-skip-type 's 'i0 a)
        (dk-cite! 'lzd-skip-type 's 'i0 b)
        (fact 'interval-elt-in-nn 1 's a)
        (fact 'interval-elt-in-nn 1 's b)
        (let ((e2 (dk-landed-1 (lambda () (dk-lam-b-h! e)))))
          (lzd-inj-eq! (lzd-iv '(succ s)) (lzd-iv 'm) 'p (lzd-sk a 'i0) (lzd-sk b 'i0))
          (dk-cite! 'lzd-skip-inj 'i0 a b)
          (ass)))))
  (dk-only! iff c1 c2)
  (prop))
(lzd-done! 'lzd-skp-inj)
(topic! 'lzd-skp-inj 'plumbing)

;;; the minor of a submatrix is the submatrix on the skipped index maps
(define LZD-SUB1 '(SUBMATRIX A (succ s) p q))
(define LZD-MIN (list 'MINOR LZD-SUB1 'i0 'j0 's))
(define LZD-SUB0 (list 'SUBMATRIX 'A 's (lzd-skp 'p 'i0) (lzd-skp 'q 'j0)))
(sp (make-wff (forall-guarded '(R m n s A p q i0 j0)
                '((IS-RING R) (IN m NN) (IN n NN) (IN s NN) (IN A (MAT m n (CARR R)))
                  (IN p (FUN (INTERVAL 1 (succ s)) (INTERVAL 1 m))) (IN q (FUN (INTERVAL 1 (succ s)) (INTERVAL 1 n)))
                  (IN i0 (INTERVAL 1 (succ s))) (IN j0 (INTERVAL 1 (succ s))))
                (list '= LZD-MIN LZD-SUB0))))
(dk-peel!)
(fact 'nn-succ-closed 's)
(fact 'interval-elt-in-nn 1 '(succ s) 'i0)
(fact 'interval-elt-in-nn 1 '(succ s) 'j0)
(dk-cite! 'submatrix-type 'R 'm 'n '(succ s) 'A 'p 'q)
(dk-cite! 'minor-type 'R LZD-SUB1 'i0 'j0 's)
(dk-cite! 'lzd-skp-fun 's 'm 'p 'i0)
(dk-cite! 'lzd-skp-fun 's 'n 'q 'j0)
(dk-cite! 'submatrix-type 'R 'm 'n 's 'A (lzd-skp 'p 'i0) (lzd-skp 'q 'j0))
(detach-with! (dk-cite! 'matrix-entry-extensionality 's 's '(CARR R) LZD-MIN LZD-SUB0)
  (lambda ()
    (let* ((uv (lzd-iv-vars (dk-peel!) 's)) (u (car uv)) (v (cadr uv))
           (su (lzd-sk u 'i0)) (sv (lzd-sk v 'j0)))
      (dk-cite! 'lzd-skip-type 's 'i0 u)
      (dk-cite! 'lzd-skip-type 's 'j0 v)
      (lzd-app! 'p su (lzd-iv '(succ s)) (lzd-iv 'm))
      (lzd-app! 'q sv (lzd-iv '(succ s)) (lzd-iv 'n))
      (subst (dk-cite! 'minor-entry 'R LZD-SUB1 'i0 'j0 's u v))
      (subst (dk-cite! 'submatrix-entry 'R 'm 'n '(succ s) 'A 'p 'q su sv))
      (subst (dk-cite! 'submatrix-entry 'R 'm 'n 's 'A (lzd-skp 'p 'i0) (lzd-skp 'q 'j0) u v))
      (fact 'entry-in-carrier 'm 'n '(CARR R) 'A (list 'p su) (list 'q sv))
      (if (not (dk-lam-b!)) (rfl)))))
(ass)
(lzd-done! 'lzd-minor-submatrix)
(topic! 'lzd-minor-submatrix 'plumbing)

;;; =====================================================================
;;; (3) Products and the divisibility of the subdeterminants.
;;; =====================================================================
;; PROD over [1, s+1] = PROD over [1, s] times the last factor
(sp (make-wff (forall-guarded '(R s g)
                '((IS-COMMUTATIVE-RING R) (IN s NN)
                  (FORALL z_ (IMPLIES (IN z_ (INTERVAL 1 (succ s))) (IN (g z_) (CARR R)))))
                '(= (PROD-RING R g (INTERVAL 1 (succ s))) ((MUL R) (PROD-RING R g (INTERVAL 1 s)) (g (succ s)))))))
(dk-peel!)
(fact 'nn-succ-closed 's)
(fact 'interval-in-set 1 's) (fact 'interval-card-in-nn 1 's)
(fact 'membership-implies-sethood '(succ s) 'NN)
(dk-have! '(NOT (IN (succ s) (INTERVAL 1 s)))
  (lambda ()
    (di)
    (fact 'interval-hi 1 's '(succ s))
    (lzd-contra! (dk-cite! 'nn-succ-not-le 's))))
(let* ((e (dk-cite! 'interval-succ-insert 's))
       (u (caddr e))
       (h (dk-rewrite-h! '(FORALL z_ (IMPLIES (IN z_ (INTERVAL 1 (succ s))) (IN (g z_) (CARR R)))) '(INTERVAL 1 (succ s)) u)))
  (subst e)
  (dk-cite! 'prod-ring-insert-ptwise 'R '(INTERVAL 1 s) '(succ s) 'g)
  (ass))
(lzd-done! 'lzd-prod-succ)
(topic! 'lzd-prod-succ 'plumbing)

;; the statement builders
(define (lzd-div c x)
  (list 'FORSOME 'dvy_ (list 'AND '(IN dvy_ (CARR R)) (list '= x (list '(MUL R) c 'dvy_)))))
(define (lzd-chain d)
  (list 'FORALL 'ci_ (list 'FORALL 'cj_
    (list 'IMPLIES '(IN ci_ (INTERVAL 1 m)) (list 'IMPLIES '(IN ci_ (INTERVAL 1 n))
    (list 'IMPLIES '(IN cj_ (INTERVAL 1 m)) (list 'IMPLIES '(IN cj_ (INTERVAL 1 n))
    (list 'IMPLIES '(<= ci_ cj_) (lzd-div (list 'ENTRY d 'ci_ 'ci_) (list 'ENTRY d 'cj_ 'cj_))))))))))
(define (lzd-pf d s) (list 'VNB-LAMBDA 'pk_ (lzd-iv s) (list 'ENTRY d 'pk_ 'pk_)))
(define (lzd-ps d s) (list 'PROD-RING 'R (lzd-pf d s) (lzd-iv s)))
(define (lzd-diag-hyps d)
  (list '(IS-COMMUTATIVE-RING R) '(IN m NN) '(IN n NN) (list 'IN d '(MAT m n (CARR R)))
        (list 'IS-DIAGONAL 'R 'm 'n d) (lzd-chain d)))
(define (lzd-inj-hyps s)
  (list (list 'IN 'p (list 'INJECTION (lzd-iv s) '(INTERVAL 1 m)))
        (list 'IN 'q (list 'INJECTION (lzd-iv s) '(INTERVAL 1 n)))))
(define (lzd-minor-claim s)
  (forall-guarded '(R m n D p q) (append (lzd-diag-hyps 'D) (lzd-inj-hyps s))
    (lzd-div (lzd-ps 'D s) (list 'DET 'R s (list 'SUBMATRIX 'D s 'p 'q)))))

;; the product of the first s diagonal entries is a ring element (s <= m, s <= n)
(define (lzd-ps-type! d s . dims)
  (define dm (if (pair? dims) (car dims) 'm))
  (define dn (if (pair? dims) (cadr dims) 'n))
  (let ((pt (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ (lzd-iv s)) (list 'IN (list (lzd-pf d s) 'z_) '(CARR R))))))
    (fact 'interval-in-set 1 s) (fact 'interval-card-in-nn 1 s)
    (dk-have! pt
      (lambda ()
        (let ((z (car (lzd-iv-vars (dk-peel!) s))))
          (lzd-beta!)
          (lzd-iv-facts! z s)
          (dk-have! (list '<= z dm) (lambda () (dk-nn! (list '<= z s) (list '<= s dm))))
          (dk-have! (list '<= z dn) (lambda () (dk-nn! (list '<= z s) (list '<= s dn))))
          (dk-cite! 'interval-mem-intro 1 dm z)
          (dk-cite! 'interval-mem-intro 1 dn z)
          (fact 'entry-in-carrier dm dn '(CARR R) d z z)
          (ass))))
    (dk-cite! 'prod-ring-type-ptwise 'R (lzd-iv s) (lzd-pf d s))))

;;; ---- the induction ----
(define (lzd-find-succ e)
  (cond ((and (pair? e) (eq? (car e) 'succ) (symbol? (cadr e))) (cadr e))
        ((pair? e) (or (lzd-find-succ (car e)) (lzd-find-succ (cdr e))))
        (#t #f)))
(define (lzd-mul a b) (list '(MUL R) a b))
(define (lzd-mul-type! a b)
  (if (not (dk-asm? (list 'IN (lzd-mul a b) '(CARR R))))
      (fact 'ring-carrier-closed-mul 'R a b)))
(define (lzd-nn-add! a b)
  (if (not (dk-asm? (list 'IN (list '+ a b) 'NN)))
      (begin
        (dk-have! (list 'AND (list 'IN a 'NN) (list 'IN b 'NN)) (lambda () (dk-conj-close! (lambda () (ass)))))
        (fact 'nn-add-closed a b))))

(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IN s NN) (lzd-minor-claim 's)))))
(let* ((opened (dk-opened (lambda () (ni))))
       (step (find-first (lambda (l) (dk-contains? (dk-goal-of l) 'succ)) opened))
       (base (find-first (lambda (l) (not (eq? l step))) opened)))
  ;; ---- base: s = 0 ----
  (dk-focus! base)
  (dk-peel!)
  (fact 'commutative-ring-is-ring 'R)
  (fact 'ring-one-in 'R)
  (fact 'nn-zero-in)
  (lzd-inj-fun! 'p (lzd-iv 0) '(INTERVAL 1 m))
  (lzd-inj-fun! 'q (lzd-iv 0) '(INTERVAL 1 n))
  (dk-cite! 'submatrix-type 'R 'm 'n 0 'D 'p 'q)
  (ew '(ONE R))
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IN)
          (ass)
          (begin
            (subst (dk-cite! 'det-zero 'R '(SUBMATRIX D 0 p q)))
            (subst (dk-cite! 'interval-1-0-empty))
            (subst (dk-cite! 'prod-ring-empty 'R (list 'VNB-LAMBDA 'pk_ 'EMPTY-SET '(ENTRY D pk_ pk_))))
            (subst (dk-cite! 'ring-mul-left-id 'R '(ONE R)))
            (rfl)))))
  ;; ---- step ----
  (dk-focus! step)
  (let* ((sv (lzd-find-succ (dk-goal)))
         (s1 (list 'succ sv))
         (ih (lzd-minor-claim sv))
         (ld (dk-peel!)))
    (if (not (dk-asm? ih)) (error "lzd: no induction hypothesis" (expression->string ih)))
    (fact 'commutative-ring-is-ring 'R)
    (fact 'nn-succ-closed sv)
    (fact 'nn-one-in)
    (fact 'one-in-interval-1)
    (lzd-inj-fun! 'p (lzd-iv s1) '(INTERVAL 1 m))
    (lzd-inj-fun! 'q (lzd-iv s1) '(INTERVAL 1 n))
    ;; s+1 <= m, s+1 <= n
    (define (bound! f cod t)
      (let ((all (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (lzd-iv s1)) (list '<= (list f 'i_) t)))))
        (dk-have! all
          (lambda ()
            (let ((x (car (lzd-iv-vars (dk-peel!) s1))))
              (lzd-app! f x (lzd-iv s1) cod)
              (fact 'interval-hi 1 t (list f x))
              (ass))))
        (dk-cite! 'interval-injection-bound s1 t t f)))
        (bound! 'p '(INTERVAL 1 m) 'm)
    (bound! 'q '(INTERVAL 1 n) 'n)
    (dk-have! (list '<= sv 'm) (lambda () (dk-nn! (list '<= s1 'm))))
    (dk-have! (list '<= sv 'n) (lambda () (dk-nn! (list '<= s1 'n))))
    ;; a row i0 with p(i0) >= s+1
    (let* ((ex (list 'FORSOME 'i0_ (list 'AND (list 'IN 'i0_ (lzd-iv s1)) (list '<= s1 '(p i0_))))))
      (dk-have! ex
        (lambda ()
          (pbc)
          (let ((nex (list 'NOT ex))
                (all (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (lzd-iv s1)) (list '<= '(p i_) sv)))))
            (dk-have! all
              (lambda ()
                (let* ((x (car (lzd-iv-vars (dk-peel!) s1))) (px (list 'p x)))
                  (lzd-app! 'p x (lzd-iv s1) '(INTERVAL 1 m))
                  (fact 'interval-elt-in-nn 1 'm px)
                  (use-em (list '<= px sv)
                    (lambda () (ass))
                    (lambda ()
                      (dk-cite! 'nn-not-le-succ-le px sv)
                      (dk-have! ex (lambda () (ew x) (dk-conj-close! (lambda () (ass)))))
                      (lzd-contra! nex))))))
            (dk-cite! 'interval-injection-bound s1 'm sv 'p)
            (ai (dk-cite! 'nn-succ-not-le sv)))))
            (let* ((i0 (dk-skolem! (dk-ctx-form ex)))
             (pi0 (list 'p i0))
             (mm (list 'SUBMATRIX 'D s1 'p 'q))
             (rag '(RING-ADDITIVE-AG R)))
        (lzd-app! 'p i0 (lzd-iv s1) '(INTERVAL 1 m))
        (lzd-iv-facts! i0 s1)
        (lzd-iv-facts! pi0 'm)
        (dk-cite! 'submatrix-type 'R 'm 'n s1 'D 'p 'q)
        (fact 'interval-in-set 1 s1) (fact 'interval-card-in-nn 1 s1)
        (let* ((de (dk-cite! 'det-expand-row 'R sv mm i0))
               (tt (caddr (caddr de)))
               (sign-of (lambda (j) (list 'MPOW '(RING-MULTIPLICATIVE-MONOID R) '((NEG R) (ONE R)) (list '+ i0 j))))
               (minor-of (lambda (j) (list 'MINOR mm i0 j sv)))
               (ent-of (lambda (j) (list 'ENTRY mm i0 j)))
               (term-of (lambda (j) (lzd-mul (sign-of j) (lzd-mul (ent-of j) (list 'DET 'R sv (minor-of j)))))))
          ;; type every term of the expansion
          (define (term-parts! j)
            (fact 'interval-elt-in-nn 1 s1 j)
            (lzd-nn-add! i0 j)
            (dk-cite! 'dtr-sign-type 'R (list '+ i0 j))
            (fact 'entry-in-carrier s1 s1 '(CARR R) mm i0 j)
            (dk-cite! 'minor-type 'R mm i0 j sv)
            (dk-cite! 'det-in-carrier 'R sv (minor-of j)))
          (define (term-type! j)
            (term-parts! j)
            (lzd-mul-type! (ent-of j) (list 'DET 'R sv (minor-of j)))
            (lzd-mul-type! (sign-of j) (lzd-mul (ent-of j) (list 'DET 'R sv (minor-of j)))))
          (dk-have! (list 'IN tt (list 'FUN (lzd-iv s1) '(CARR R)))
            (lambda ()
              (dk-lam-type!
                (lambda ()
                  (let ((j (car (lzd-iv-vars (dk-peel!) s1))))
                    (lzd-beta!)
                    (term-type! j)
                    (ass)))
                (lambda () (ass)))))
                    ;; a term whose row entry is off the diagonal vanishes
          (define (term-zero! j)              ; needs (NOT (= pi0 (q j))) in context
            (term-parts! j)
            (let ((qj (list 'q j)))
              (lzd-app! 'q j (lzd-iv s1) '(INTERVAL 1 n))
              (dk-have! (list '= (list tt j) '(ZERO R))
                (lambda ()
                  (dk-lam-b!)
                  (subst (dk-cite! 'submatrix-entry 'R 'm 'n s1 'D 'p 'q i0 j))
                  (subst (dk-cite! 'diagonal-off-entry 'R 'm 'n 'D pi0 qj))
                  (subst (dk-cite! 'ring-mul-zero-left 'R (list 'DET 'R sv (minor-of j))))
                  (subst (dk-cite! 'ring-mul-zero-right 'R (sign-of j)))
                  (rfl)))))
          (let ((exj (list 'FORSOME 'j0_ (list 'AND (list 'IN 'j0_ (lzd-iv s1)) (list '= '(q j0_) pi0)))))
            (use-em exj
              ;; ---- some column j0 carries the diagonal entry of row p(i0) ----
              (lambda ()
                (let* ((j0 (dk-skolem! (dk-ctx-form exj)))
                       (qj0 (list 'q j0))
                       (van (list 'FORALL 'jz (list 'IMPLIES (list 'IN 'jz (lzd-iv s1))
                              (list 'IMPLIES (list 'NOT (list '= 'jz j0)) (list '= (list tt 'jz) '(ZERO R)))))))
                  (lzd-app! 'q j0 (lzd-iv s1) '(INTERVAL 1 n))
                  (dk-have! van
                    (lambda ()
                      (let* ((ld2 (dk-peel!)) (jz (car (lzd-iv-vars ld2 s1))))
                        (lzd-app! 'q jz (lzd-iv s1) '(INTERVAL 1 n))
                        (dk-have! (list 'NOT (list '= pi0 (list 'q jz)))
                          (lambda ()
                            (di)
                            (dk-have! (list '= (list 'q jz) qj0)
                              (lambda () (subst (list '= (list 'q jz) pi0)) (subst (list '= qj0 pi0)) (rfl)))
                            (lzd-inj-eq! (lzd-iv s1) '(INTERVAL 1 n) 'q jz j0)
                            (lzd-contra! (list 'NOT (list '= jz j0)))))
                        (term-zero! jz))))
                                    (term-type! j0)
                  (let* ((fs (dk-cite! 'finsum-single-support-ring-additive-ag 'R (lzd-iv s1) tt j0))
                         (e1 (list '= (list 'DET 'R s1 mm) (list tt j0))))
                    (dk-have! e1 (lambda () (subst de) (subst fs) (rfl)))
                    (let* ((e2 (dk-landed-1 (lambda () (dk-lam-b-h! e1))))
                           (se (dk-cite! 'submatrix-entry 'R 'm 'n s1 'D 'p 'q i0 j0))
                           (e3 (dk-rewrite-h! e2 (ent-of j0) (list 'ENTRY 'D pi0 qj0)))
                           (e4 (dk-rewrite-h! e3 qj0 pi0))
                           (pp (lzd-skp 'p i0)) (qq (lzd-skp 'q j0))
                           (sub0 (list 'SUBMATRIX 'D sv pp qq))
                           (ms (dk-cite! 'lzd-minor-submatrix 'R 'm 'n sv 'D 'p 'q i0 j0))
                           (e5 (dk-rewrite-h! e4 (minor-of j0) sub0)))
                      (fact 'interval-elt-in-nn 1 s1 j0)
                      (dk-cite! 'lzd-skp-inj sv 'm 'p i0)
                      (dk-cite! 'lzd-skp-inj sv 'n 'q j0)
                      (let* ((y (dk-skolem! (dk-apply! ih 'R 'm 'n 'D pp qq)))
                             (bs (list 'ENTRY 'D s1 s1))
                             (bp (list 'ENTRY 'D pi0 pi0)))
                        ;; the chain: b_{s+1} | b_{p(i0)}
                        (fact 'nn-one-le-succ sv)
                        (dk-cite! 'interval-mem-intro 1 'm s1)
                        (dk-cite! 'interval-mem-intro 1 'n s1)
                        (dk-rewrite-h! (list 'IN qj0 '(INTERVAL 1 n)) qj0 pi0)
                        (let* ((z (dk-skolem! (dk-apply! (lzd-chain 'D) s1 pi0)))
                               (ps0 (lzd-ps 'D sv)) (ps1 (lzd-ps 'D s1))
                               (f1 (lzd-pf 'D s1)))
                          ;; PS(s+1) = PS(s) b_{s+1}
                          (lzd-ps-type! 'D sv)
                          (lzd-ps-type! 'D s1)
                          (let* ((pss (dk-cite! 'lzd-prod-succ 'R sv f1))
                                 (cong (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ (lzd-iv sv))
                                         (list '= (list f1 'z_) (list (lzd-pf 'D sv) 'z_))))))
                            (dk-have! cong
                              (lambda ()
                                (let ((zz (car (lzd-iv-vars (dk-peel!) sv))))
                                  (lzd-iv-facts! zz sv)
                                  (dk-have! (list '<= zz s1) (lambda () (dk-nn! (list '<= zz sv))))
                                  (dk-cite! 'interval-mem-intro 1 s1 zz)
                                  (dk-have! (list '<= zz 'm) (lambda () (dk-nn! (list '<= zz sv) (list '<= sv 'm))))
                                  (dk-have! (list '<= zz 'n) (lambda () (dk-nn! (list '<= zz sv) (list '<= sv 'n))))
                                  (dk-cite! 'interval-mem-intro 1 'm zz)
                                  (dk-cite! 'interval-mem-intro 1 'n zz)
                                  (fact 'entry-in-carrier 'm 'n '(CARR R) 'D zz zz)
                                  (if (not (dk-lam-b!)) (rfl)))))
                            (fact 'interval-in-set 1 sv) (fact 'interval-card-in-nn 1 sv)
                            (dk-have! (list '<= s1 s1) (lambda () (dk-nn!)))
                            (dk-cite! 'interval-mem-intro 1 s1 s1)
                            (let* ((cq (dk-cite! 'prod-ring-congruence-q 'R (lzd-iv sv) f1 (lzd-pf 'D sv)))
                                   (p1 (dk-rewrite-h! pss (cadr cq) (caddr cq)))
                                   (p2 (dk-landed-1 (lambda () (dk-lam-b-h! p1)))))
                              (fact 'entry-in-carrier 'm 'n '(CARR R) 'D s1 s1)
                              (lzd-mul-type! z y)
                              (let ((w (lzd-mul (sign-of j0) (lzd-mul z y))))
                                (lzd-mul-type! (sign-of j0) (lzd-mul z y))
                                (ew w)
                                (dk-conj-close!
                                  (lambda ()
                                    (if (dk-head-is? (dk-goal) 'IN)
                                        (ass)
                                        (begin
                                          (subst e5)
                                          (subst (list '= (list 'DET 'R sv sub0) (lzd-mul ps0 y)))
                                          (subst (list '= bp (lzd-mul bs z)))
                                          (subst p2)
                                          (crs))))))))))))))
              ;; ---- row p(i0) of D meets no chosen column: the determinant is 0 ----
              (lambda ()
                (let ((all0 (list 'FORALL 'jz (list 'IMPLIES (list 'IN 'jz (lzd-iv s1)) (list '= (list tt 'jz) '(ZERO R))))))
                  (dk-have! all0
                    (lambda ()
                      (let ((jz (car (lzd-iv-vars (dk-peel!) s1))))
                        (lzd-app! 'q jz (lzd-iv s1) '(INTERVAL 1 n))
                        (dk-have! (list 'NOT (list '= pi0 (list 'q jz)))
                          (lambda ()
                            (di)
                            (dk-have! exj (lambda () (ew jz) (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass) (begin (subst (list '= pi0 (list 'q jz))) (rfl)))))))
                            (lzd-contra! (list 'NOT exj))))
                        (term-zero! jz))))
                  (let ((f0 (dk-cite! 'finsum-all-id-ring-additive-ag 'R (lzd-iv s1) tt)))
                    (lzd-ps-type! 'D s1)
                    (fact 'ring-zero-in 'R)
                    (ew '(ZERO R))
                    (dk-conj-close!
                      (lambda ()
                        (if (dk-head-is? (dk-goal) 'IN)
                            (ass)
                            (begin
                              (subst de) (subst f0)
                              (subst (dk-cite! 'ring-mul-zero-right 'R (lzd-ps 'D s1)))
                              (rfl)))))))))))))))
(lzd-done! 'diagonal-chain-minor-divisible)
(topic! 'diagonal-chain-minor-divisible 'algebra)
(gloss! 'diagonal-chain-minor-divisible "For a diagonal matrix whose diagonal entries form a divisibility chain, the product of the first s diagonal entries divides every subdeterminant of order s.")

