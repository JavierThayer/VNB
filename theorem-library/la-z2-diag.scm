                                (lambda () (subst (list '= bs (list '* bz c))) (subst (list '= bz 0)) (crs))))))
                        (last-zero! 'D)
                        (last-zero! 'D2)
                        (subst (list '= b 0))
                        (subst (list '= b2 0))
                        (rfl)))
                    (lambda ()
                      (use-cases o5
                        (lambda ()
                          (let ((k (list '- b b2)))
                            (dk-have! (list '= (list '* k p) 0)
                              (lambda ()
                                (dk-have! (list '= (list '* k p) (list '- (list '* p b) (list '* p b2))) (lambda () (crs)))
                                (subst (list '= (list '* k p) (list '- (list '* p b) (list '* p b2))))
                                (subst (list '= (list '* p b) (list '* p b2)))
                                (crs)))
                            (lzd-typ! k 'ZZ)
                            (dk-cite! 'zz-mul-cancel-zero k p)
                            (dk-ineq! (list '= k 0))))
                        (lambda ()
                          (let ((k (list '+ b b2)))
                            (dk-have! (list '= (list '* k p) 0)
                              (lambda ()
                                (dk-have! (list '= (list '* k p) (list '+ (list '* p b) (list '* p b2))) (lambda () (crs)))
                                (subst (list '= (list '* k p) (list '+ (list '* p b) (list '* p b2))))
                                (subst (list '= (list '* p b) (list '- (list '* p b2))))
                                (crs)))
                            (lzd-typ! k 'ZZ)
                            (dk-cite! 'zz-mul-cancel-zero k p)
                            (dk-apply! (lzd-nonneg 'D) s1)
                            (dk-apply! (lzd-nonneg 'D2) s1)
                            (dk-ineq! (list '= k 0) (list '<= 0 b) (list '<= 0 b2))))))))))))))))
