;; Z conversions
(define (lzd-zmul-eq! a b)                 ; (= ((MUL ZZ-RING) a b) (* a b)), a, b in ZZ
  (let ((eq (list '= (list '(MUL ZZ-RING) a b) (list '* a b))))
    (if (not (dk-asm? eq))
        (dk-have! eq (lambda () (slot 'MUL)
                       (if (not (dk-lam-b!))
                           (begin (if (not (dk-asm? (list 'IN (list '* a b) 'ZZ)))
                                      (dk-have! (list 'IN (list '* a b) 'ZZ) dk-typ-close!))
                                  (rfl))))))
    eq))
(define (lzd-zcarr! t)                     ; (IN t ZZ) from (IN t (CARR ZZ-RING))
  (if (not (dk-asm? (list 'IN t 'ZZ)))
      (dk-rewrite-h! (list 'IN t '(CARR ZZ-RING)) '(CARR ZZ-RING) 'ZZ)))
(define (lzd-in-mn-of! x s)                ; x in [1,s], s <= m, s <= n => x in [1,m], [1,n]
  (lzd-iv-facts! x s)
  (dk-have! (list '<= x 'm) (lambda () (dk-nn! (list '<= x s) (list '<= s 'm))))
  (dk-have! (list '<= x 'n) (lambda () (dk-nn! (list '<= x s) (list '<= s 'n))))
  (dk-cite! 'interval-mem-intro 1 'm x)
  (dk-cite! 'interval-mem-intro 1 'n x))
;; open ZZ-DIVIDES(D, X) in context: the cofactor c, with (IN c ZZ), (= X (* D c))
(define (lzd-zzdiv-open! d x)
  (let* ((hyp (list 'ZZ-DIVIDES d x))
         (iff (dk-cite! 'zz-divides d x))
         (rhs (caddr iff)))
    (dk-have! rhs (dk-lane (lambda () (dk-only! iff hyp) (dk-lane-if! prop))))
    (let* ((parts (dk-split! (dk-ctx-form rhs)))
           (more (append-map (lambda (f) (if (dk-head-is? f 'AND) (dk-split! f) (list f))) parts))
           (ex (find-first (dk-head? 'FORSOME) more)))
      (dk-skolem! ex #t))))

;; a vanishing product of the chain forces the last factor to vanish
(define (lzd-zhyps d) (list '(IN m NN) '(IN n NN) (list 'IN d '(MAT m n ZZ)) (list 'IS-DIAGONAL 'ZZ-RING 'm 'n d) (lzd-zchain d)))
(define (lzd-zero-claim s)
  (forall-guarded '(m n D) (append (lzd-zhyps 'D) (list (list '<= s 'm) (list '<= s 'n) (list '= (lzd-zps 'D s) 0)))
    (list 'AND (list '<= 1 s) (list '= (list 'ENTRY 'D s s) 0))))
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IN s NN) (lzd-zero-claim 's)))))
(let* ((opened (dk-opened (lambda () (ni))))
       (step (find-first (lambda (l) (dk-contains? (dk-goal-of l) 'succ)) opened))
       (base (find-first (lambda (l) (not (eq? l step))) opened)))
  (dk-focus! base)
  (let* ((ld (dk-peel!))
         (h (find-first (lambda (f) (and (dk-head-is? f '=) (dk-head-is? (cadr f) 'PROD-RING))) ld)))
    (fact 'zz-is-commutative-ring)
    (dk-have! '(== (ONE ZZ-RING) 1) (lambda () (slot 'ONE) (qrfl)))
    (dk-cite! 'interval-1-0-empty)
    (let* ((h1 (dk-rewrite-h! h '(INTERVAL 1 0) 'EMPTY-SET))
           (pe (dk-cite! 'prod-ring-empty 'ZZ-RING (caddr (cadr h1))))
           (h2 (dk-rewrite-h! h1 (cadr h1) '(ONE ZZ-RING)))
           (h3 (dk-rewrite-h! h2 '(ONE ZZ-RING) 1)))
      (pbc)
      (dk-absurd! h3)))
  (dk-focus! step)
  (let* ((sv (lzd-find-succ (dk-goal)))
         (s1 (list 'succ sv))
         (ih (lzd-zero-claim sv))
         (ld (dk-peel!))
         (h (find-first (lambda (f) (and (dk-head-is? f '=) (dk-head-is? (cadr f) 'PROD-RING))) ld)))
    (lzd-zsetup! 'D)
    (fact 'nn-succ-closed sv)
    (fact 'nn-one-in)
    (fact 'nn-one-le-succ sv)
    (dk-have! (list '<= sv 'm) (lambda () (dk-nn! (list '<= s1 'm))))
    (dk-have! (list '<= sv 'n) (lambda () (dk-nn! (list '<= s1 'n))))
    (let* ((ps0 (lzd-zps 'D sv))
           (b (list 'ENTRY 'D s1 s1))
           (e (dk-cite! 'diagonal-product-succ 'ZZ-RING 'm 'n 'D sv))
           (h1 (dk-rewrite-h! h (cadr e) (caddr e))))
      ;; ps0 and b are integers
      (dk-cite! 'diagonal-leading-minor 'ZZ-RING 'm 'n 'D sv)
      (dk-cite! 'interval-mem-intro 1 'm s1)
      (dk-cite! 'interval-mem-intro 1 'n s1)
      (fact 'entry-in-carrier 'm 'n '(CARR ZZ-RING) 'D s1 s1)
      (lzd-zcarr! b)
      (dk-cite! 'lzd-id-injection sv 'm)
      (dk-cite! 'lzd-id-injection sv 'n)
      (lzd-inj-fun! (lzd-id sv) (lzd-iv sv) (lzd-iv 'm))
      (lzd-inj-fun! (lzd-id sv) (lzd-iv sv) (lzd-iv 'n))
      (let ((lead (list 'SUBMATRIX 'D sv (lzd-id sv) (lzd-id sv))))
        (dk-cite! 'submatrix-type 'ZZ-RING 'm 'n sv 'D (lzd-id sv) (lzd-id sv))
        (dk-cite! 'det-in-carrier 'ZZ-RING sv lead)
        (let ((t1 (dk-rewrite-h! (list 'IN (list 'DET 'ZZ-RING sv lead) '(CARR ZZ-RING)) (list 'DET 'ZZ-RING sv lead) ps0)))
          (lzd-zcarr! ps0)))
      (lzd-zmul-eq! ps0 b)
      (let* ((h2 (dk-rewrite-h! h1 (list '(MUL ZZ-RING) ps0 b) (list '* ps0 b)))
             (d (dk-cite! 'zz-no-zero-divisors ps0 b)))
        (use-cases d
          (lambda ()
            (let* ((r (dk-apply! ih 'm 'n 'D))
                   (parts (dk-split! r))
                   (bz (list 'ENTRY 'D sv sv)))
              (dk-cite! 'interval-mem-intro 1 'm sv)
              (dk-cite! 'interval-mem-intro 1 'n sv)
              (dk-have! (list '<= sv s1) (lambda () (dk-nn!)))
              (dk-apply! (lzd-zchain 'D) sv s1)
              (let ((c (lzd-zzdiv-open! bz b)))
                (dk-conj-close!
                  (lambda ()
                    (if (dk-head-is? (dk-goal) '<=)
                        (ass)
                        (begin
                          (subst (list '= b (list '* bz c)))
                          (subst (list '= bz 0))
                          (fact 'zz-in-rr c)
                          (crs))))))))
          (lambda ()
            (dk-conj-close! (lambda () (ass)))))))))
(lzd-done! 'diagonal-chain-product-zero)
(topic! 'diagonal-chain-product-zero 'plumbing)

;; (IN PS_s ZZ) for the integer product (s <= m, s <= n in context)
(define (lzd-zps-type! d s)
  (let ((lead (list 'SUBMATRIX d s (lzd-id s) (lzd-id s)))
        (ps (lzd-zps d s)))
    (if (not (dk-asm? (list 'IN ps 'ZZ)))
        (begin
          (dk-cite! 'diagonal-leading-minor 'ZZ-RING 'm 'n d s)
          (dk-cite! 'lzd-id-injection s 'm)
          (dk-cite! 'lzd-id-injection s 'n)
          (lzd-inj-fun! (lzd-id s) (lzd-iv s) (lzd-iv 'm))
          (lzd-inj-fun! (lzd-id s) (lzd-iv s) (lzd-iv 'n))
          (dk-cite! 'submatrix-type 'ZZ-RING 'm 'n s d (lzd-id s) (lzd-id s))
          (dk-cite! 'det-in-carrier 'ZZ-RING s lead)
          (let ((t1 (dk-rewrite-h! (list 'IN (list 'DET 'ZZ-RING s lead) '(CARR ZZ-RING)) (list 'DET 'ZZ-RING s lead) ps)))
            (lzd-zcarr! ps))))))
(define (lzd-nonneg d)
  (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 m)) (list 'IMPLIES '(IN i_ (INTERVAL 1 n)) (list '<= 0 (list 'ENTRY d 'i_ 'i_))))))
(define (lzd-ebody s)
  (list 'IMPLIES (list '<= s 'm) (list 'IMPLIES (list '<= s 'n)
    (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (lzd-iv s)) '(= (ENTRY D i_ i_) (ENTRY D2 i_ i_)))))))

(define LZD-PSIGN
  (list 'FORALL 'ps_ (list 'IMPLIES '(IN ps_ NN) (list 'IMPLIES '(<= ps_ m) (list 'IMPLIES '(<= ps_ n)
    (list 'OR (list '= (lzd-zps 'D 'ps_) (lzd-zps 'D2 'ps_)) (list '= (lzd-zps 'D 'ps_) (list '- (lzd-zps 'D2 'ps_)))))))))
(define LZD-UHYPS
  (list '(IN m NN) '(IN n NN) '(IN D (MAT m n ZZ)) '(IN D2 (MAT m n ZZ))
        '(IS-DIAGONAL ZZ-RING m n D) '(IS-DIAGONAL ZZ-RING m n D2)
        (lzd-nonneg 'D) (lzd-nonneg 'D2) (lzd-zchain 'D) (lzd-zchain 'D2)))
(sp (make-wff (forall-guarded '(m n D D2) (append LZD-UHYPS (list LZD-PSIGN)) '(= D D2))))
(dk-peel!)
(lzd-zsetup! 'D)
(lzd-zsetup! 'D2)
(fact 'nn-one-in)
(define LZD-E (list 'FORALL 's (list 'IMPLIES '(IN s NN) (lzd-ebody 's))))
(dk-have! LZD-E
  (lambda ()
    (let* ((opened (dk-opened (lambda () (ni))))
           (step (find-first (lambda (l) (dk-contains? (dk-goal-of l) 'succ)) opened))
           (base (find-first (lambda (l) (not (eq? l step))) opened)))
      (dk-focus! base)
      (let* ((ld (dk-peel!)) (i (car (lzd-iv-vars ld 0))))
        (lzd-iv-facts! i 0)
        (fact 'nn-in-rr i)
        (pbc)
        (dk-absurd! (list '<= 1 i) (list '<= i 0)))
      (dk-focus! step)
      (let* ((sv (lzd-find-succ (dk-goal)))
             (s1 (list 'succ sv))
             (ld (dk-peel!))
