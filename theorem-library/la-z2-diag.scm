(sp (make-wff (forall-guarded '(m n D D2 um vm)
                (append LZD-UHYPS (list '(IS-INVERTIBLE-MAT ZZ-RING m um) '(IS-INVERTIBLE-MAT ZZ-RING n vm)
                                        '(= D2 (MATMUL ZZ-RING (MATMUL ZZ-RING um D) vm))))
                '(= D D2))))
(dk-peel!)
(fact 'zz-is-euclidean-ring)
(define (lzd-elem-gen! k w)
  (let* ((iff (dk-cite! 'euclidean-invertible-iff-elem-gen 'ZZ-RING k w))
         (want (list 'IN w (list 'ELEM-GEN 'ZZ-RING k))))
    (dk-have! want (dk-lane (lambda () (dk-only! iff (list 'IS-INVERTIBLE-MAT 'ZZ-RING k w)) (dk-lane-if! prop))))))
(lzd-elem-gen! 'm 'um)
(lzd-elem-gen! 'n 'vm)
(dk-have! '(ELEM-EQUIV ZZ-RING m n D D2)
  (lambda ()
    (mac 'ELEM-EQUIV)
    (ew 'um) (ew 'vm)
    (dk-conj-close! (lambda () (ass)))))
