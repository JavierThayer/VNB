                ;; the products of the first sv diagonal entries agree
                (fact 'interval-in-set 1 sv) (fact 'interval-card-in-nn 1 sv)
                (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ (lzd-iv sv))
                                (list '= (list (lzd-pf 'D sv) 'z_) (list (lzd-pf 'D2 sv) 'z_))))
                  (lambda ()
                    (let ((z (car (lzd-iv-vars (dk-peel!) sv))))
                      (dk-apply! allih z)
                      (lzd-in-mn-of! z sv)
                      (fact 'entry-in-carrier 'm 'n '(CARR ZZ-RING) 'D z z)
                      (fact 'entry-in-carrier 'm 'n '(CARR ZZ-RING) 'D2 z z)
                      (if (not (dk-lam-b!)) (ass)))))
                (let* ((cq (dk-cite! 'prod-ring-congruence-q 'ZZ-RING (lzd-iv sv) (lzd-pf 'D sv) (lzd-pf 'D2 sv)))
                       (inv (dk-apply! LZD-PSIGN s1))
                       (e1 (dk-cite! 'diagonal-product-succ 'ZZ-RING 'm 'n 'D sv))
                       (e2 (dk-cite! 'diagonal-product-succ 'ZZ-RING 'm 'n 'D2 sv))
                       (ignore (begin (lzd-zmul-eq! p b) (lzd-zmul-eq! p2 b2)))
                       (o1 (dk-rewrite-h! inv q (caddr e1)))
                       (o2 (dk-rewrite-h! o1 q2 (caddr e2)))
                       (o3 (dk-rewrite-h! o2 (list '(MUL ZZ-RING) p b) (list '* p b)))
                       (o4 (dk-rewrite-h! o3 (list '(MUL ZZ-RING) p2 b2) (list '* p2 b2)))
                       (o5 (dk-rewrite-h! o4 p2 p)))
                  (fact 'zz-in-rr p)
                  (dk-cite! 'nn-in-rr sv)
                  (use-em (list '= p 0)
                    (lambda ()
                      (let ((z2 (dk-rewrite-h! (list '= p 0) p p2)))
                        (define (last-zero! d)
                          (let* ((r (dk-cite! 'diagonal-chain-product-zero sv 'm 'n d))
                                 (parts (dk-split! r))
