                     (p (lzd-zps 'D sv)) (p2 (lzd-zps 'D2 sv))
                     (q (lzd-zps 'D s1)) (q2 (lzd-zps 'D2 s1)))
                (dk-cite! 'interval-mem-intro 1 'm s1)
                (dk-cite! 'interval-mem-intro 1 'n s1)
                (fact 'entry-in-carrier 'm 'n '(CARR ZZ-RING) 'D s1 s1)
                (fact 'entry-in-carrier 'm 'n '(CARR ZZ-RING) 'D2 s1 s1)
                (lzd-zcarr! b) (lzd-zcarr! b2)
