(define (lzd-id s) (list 'VNB-LAMBDA 'idx_ (lzd-iv s) 'idx_))
(sp (make-wff (forall-guarded '(s m) '((IN s NN) (IN m NN) (<= s m))
                (list 'IN (lzd-id 's) '(INJECTION (INTERVAL 1 s) (INTERVAL 1 m))))))
(dk-peel!)
(fact 'nn-one-in)
(let* ((idm (lzd-id 's))
       (iff (dk-cite! 'injection-membership-iff (lzd-iv 's) (lzd-iv 'm) idm))
       (rhs (caddr iff)) (c1 (cadr rhs)) (c2 (caddr rhs)))
  (dk-have! c1
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((x (car (lzd-iv-vars (dk-peel!) 's))))
            (lzd-beta!)
            (lzd-iv-facts! x 's)
            (dk-have! (list '<= x 'm) (lambda () (dk-nn! (list '<= x 's) '(<= s m))))
            (dk-cite! 'interval-mem-intro 1 'm x)
            (ass)))
        (lambda () (fact 'interval-in-set 1 's) (ass)))))
  (dk-have! c2
    (lambda ()
      (let* ((landed (dk-peel!))
             (e (find-first (dk-head? '=) landed)))
        (dk-lam-b-h! e)
        (ass))))
  (dk-only! iff c1 c2)
  (prop))
(lzd-done! 'lzd-id-injection)
(topic! 'lzd-id-injection 'plumbing)

(define LZD-LEAD (list 'SUBMATRIX 'D 's (lzd-id 's) (lzd-id 's)))
(sp (make-wff (forall-guarded '(R m n D s)
                '((IS-COMMUTATIVE-RING R) (IN m NN) (IN n NN) (IN D (MAT m n (CARR R))) (IS-DIAGONAL R m n D)
                  (IN s NN) (<= s m) (<= s n))
                (list '= (list 'DET 'R 's LZD-LEAD) (lzd-ps 'D 's)))))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(dk-cite! 'lzd-id-injection 's 'm)
(dk-cite! 'lzd-id-injection 's 'n)
(lzd-inj-fun! (lzd-id 's) (lzd-iv 's) (lzd-iv 'm))
(lzd-inj-fun! (lzd-id 's) (lzd-iv 's) (lzd-iv 'n))
(dk-cite! 'submatrix-type 'R 'm 'n 's 'D (lzd-id 's) (lzd-id 's))
(define (lzd-in-mn! x)                    ; x in [1,s] => x in [1,m], x in [1,n]
  (lzd-iv-facts! x 's)
  (dk-have! (list '<= x 'm) (lambda () (dk-nn! (list '<= x 's) '(<= s m))))
  (dk-have! (list '<= x 'n) (lambda () (dk-nn! (list '<= x 's) '(<= s n))))
  (dk-cite! 'interval-mem-intro 1 'm x)
  (dk-cite! 'interval-mem-intro 1 'n x))
;; the leading submatrix is upper triangular
(dk-have! (list 'IS-UPPER-TRIANGULAR 'R 's LZD-LEAD)
  (lambda ()
    (mac 'IS-UPPER-TRIANGULAR)
    (let* ((ld (dk-peel!))
           (lt (find-first (dk-head? '<) ld)) (v (cadr lt)) (u (caddr lt)))
      (lzd-in-mn! u) (lzd-in-mn! v)
      (dk-have! (list 'NOT (list '= u v)) (lambda () (dk-nn! (list '< v u))))
      (subst (dk-cite! 'submatrix-entry 'R 'm 'n 's 'D (lzd-id 's) (lzd-id 's) u v))
      (dk-lam-b!)
      (subst (dk-cite! 'diagonal-off-entry 'R 'm 'n 'D u v))
      (fact 'ring-zero-in 'R)
      (rfl))))
(let* ((dt (dk-cite! 'det-upper-triangular 'R 's LZD-LEAD))
       (g (caddr (caddr dt))))
  (fact 'interval-in-set 1 's) (fact 'interval-card-in-nn 1 's)
  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ (lzd-iv 's)) (list '= (list g 'z_) (list (lzd-pf 'D 's) 'z_))))
    (lambda ()
      (let ((z (car (lzd-iv-vars (dk-peel!) 's))))
        (lzd-in-mn! z)
        (fact 'entry-in-carrier 'm 'n '(CARR R) 'D z z)
        (dk-lam-b!)
        (subst (dk-cite! 'submatrix-entry 'R 'm 'n 's 'D (lzd-id 's) (lzd-id 's) z z))
        (if (not (dk-lam-b!)) (rfl)))))
  (let ((cq (dk-cite! 'prod-ring-congruence-q 'R (lzd-iv 's) g (lzd-pf 'D 's))))
    (subst dt)
    (subst cq)
    (lzd-ps-type! 'D 's)
    (rfl)))
(lzd-done! 'diagonal-leading-minor)
(topic! 'diagonal-leading-minor 'algebra)
(gloss! 'diagonal-leading-minor "The leading order-s subdeterminant of a diagonal matrix is the product of its first s diagonal entries.")

;; over Z
(define (lzd-z f) (dk--replace f 'R 'ZZ-RING))
(define (lzd-zchain d)
  (list 'FORALL 'ci_ (list 'FORALL 'cj_
    (list 'IMPLIES '(IN ci_ (INTERVAL 1 m)) (list 'IMPLIES '(IN ci_ (INTERVAL 1 n))
    (list 'IMPLIES '(IN cj_ (INTERVAL 1 m)) (list 'IMPLIES '(IN cj_ (INTERVAL 1 n))
    (list 'IMPLIES '(<= ci_ cj_) (list 'ZZ-DIVIDES (list 'ENTRY d 'ci_ 'ci_) (list 'ENTRY d 'cj_ 'cj_))))))))))
(define (lzd-zps d s) (lzd-z (lzd-ps d s)))
;; the Z setting of D in context: ring facts, D over CARR(ZZ-RING), the ring-form chain
(define (lzd-zsetup! d)
  (fact 'zz-is-commutative-ring)
  (fact 'zz-is-ring)
  (dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl)))
  (dk-rewrite-h! (list 'IN d '(MAT m n ZZ)) 'ZZ '(CARR ZZ-RING))
  (dk-have! (lzd-z (lzd-chain d))
    (lambda ()
      (let* ((ld (dk-peel!))
             (le (find-first (dk-head? '<=) ld))
             (ci (cadr le)) (cj (caddr le)))
        (dk-apply! (lzd-zchain d) ci cj)
        (dk-cite! 'lzg-zz-to-ring (list 'ENTRY d ci ci) (list 'ENTRY d cj cj))
        (ass)))))

(sp (make-wff (forall-guarded '(m n D s)
                (list '(IN m NN) '(IN n NN) '(IN D (MAT m n ZZ)) '(IS-DIAGONAL ZZ-RING m n D) (lzd-zchain 'D)
                      '(IN s NN) '(<= s m) '(<= s n))
                (list 'ZZ-IS-GCD-SET '(SDET ZZ-RING m n D s) (lzd-zps 'D 's)))))
(dk-peel!)
(lzd-zsetup! 'D)
(let* ((ps (lzd-zps 'D 's))
       (lead (lzd-z LZD-LEAD))
       (dl (dk-cite! 'diagonal-leading-minor 'ZZ-RING 'm 'n 'D 's)))
  (dk-cite! 'lzd-id-injection 's 'm)
  (dk-cite! 'lzd-id-injection 's 'n)
  (lzd-inj-fun! (lzd-id 's) (lzd-iv 's) (lzd-iv 'm))
  (lzd-inj-fun! (lzd-id 's) (lzd-iv 's) (lzd-iv 'n))
  (dk-cite! 'submatrix-type 'ZZ-RING 'm 'n 's 'D (lzd-id 's) (lzd-id 's))
  (dk-cite! 'det-in-carrier 'ZZ-RING 's lead)
  (let* ((t1 (dk-rewrite-h! (list 'IN (list 'DET 'ZZ-RING 's lead) '(CARR ZZ-RING)) (list 'DET 'ZZ-RING 's lead) ps))
         (t2 (dk-rewrite-h! t1 '(CARR ZZ-RING) 'ZZ))
         (lin (dk-cite! 'sdet-intro 'ZZ-RING 'm 'n 's 'D (lzd-id 's) (lzd-id 's))))
    (mac 'ZZ-IS-GCD-SET)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((dk-head-is? g 'IN) (ass))
            ((dk-contains? g '(IN gse_ ZZ))
             (let* ((ld (dk-peel!))
                    (e (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'ZZ))) ld)))
                    (h (find-first (dk-head? 'FORALL) ld)))
               (dk-apply! h (list 'DET 'ZZ-RING 's lead))
               (let ((h2 (dk-rewrite-h! (list 'ZZ-DIVIDES e (list 'DET 'ZZ-RING 's lead)) (list 'DET 'ZZ-RING 's lead) ps)))
                 (ass))))
            (#t
             (let* ((ld (dk-peel!))
                    (mem (find-first (dk-head? 'IN) ld))
                    (x (cadr mem))
                    (ex (dk-cite! 'sdet-elim 'ZZ-RING 'm 'n 'D 's x))
                    (pv (dk-skolem! ex #f))
                    (e2 (find-first (lambda (f) (and (eq? (car f) 'FORSOME) (dk-contains? f pv))) (dk-asms)))
                    (qv (dk-skolem! e2 #f))
                    (cj (find-first (lambda (f) (and (eq? (car f) 'AND) (dk-contains? f qv) (dk-contains? f pv))) (dk-asms))))
               (dk-split-all! (list cj))
               (dk-split-all!)
               (let* ((dv (dk-cite! 'diagonal-chain-minor-divisible 's 'ZZ-RING 'm 'n 'D pv qv))
                      (y (dk-skolem! dv))
                      (sub (list 'SUBMATRIX 'D 's pv qv))
                      (h1 (dk-rewrite-h! (list '= (list 'DET 'ZZ-RING 's sub) (list '(MUL ZZ-RING) ps y))
                                         (list 'DET 'ZZ-RING 's sub) x)))
                 (dk-cite! 'lzg-ring-to-zz ps x y)
                 (ass))))))))))
(lzd-done! 'diagonal-chain-sdet-gcd)
(topic! 'diagonal-chain-sdet-gcd 'algebra)
(gloss! 'diagonal-chain-sdet-gcd "Over Z, for a diagonal matrix whose diagonal entries form a divisibility chain, the product of the first s diagonal entries is a gcd of the order-s subdeterminants.")

;;; =====================================================================
;;; (5) Uniqueness of the diagonal normal form (the second half of 3.36).
;;; =====================================================================
;; PS(s+1) = PS(s) b_{s+1}
(sp (make-wff (forall-guarded '(R m n D s)
                '((IS-COMMUTATIVE-RING R) (IN m NN) (IN n NN) (IN D (MAT m n (CARR R)))
                  (IN s NN) (<= (succ s) m) (<= (succ s) n))
                (list '= (lzd-ps 'D '(succ s)) (lzd-mul (lzd-ps 'D 's) '(ENTRY D (succ s) (succ s)))))))
(dk-peel!)
(fact 'commutative-ring-is-ring 'R)
(fact 'nn-succ-closed 's)
(fact 'nn-one-in)
(fact 'nn-one-le-succ 's)
(dk-have! '(<= s m) (lambda () (dk-nn! '(<= (succ s) m))))
(dk-have! '(<= s n) (lambda () (dk-nn! '(<= (succ s) n))))
(lzd-ps-type! 'D 's)
(lzd-ps-type! 'D '(succ s))
(let* ((s1 '(succ s)) (sv 's)
       (f1 (lzd-pf 'D s1))
       (pss (dk-cite! 'lzd-prod-succ 'R sv f1))
       (cong (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ (lzd-iv sv))
               (list '= (list f1 'z_) (list (lzd-pf 'D sv) 'z_))))))
  (dk-have! cong
    (lambda ()
      (let ((zz (car (lzd-iv-vars (dk-peel!) sv))))
        (lzd-iv-facts! zz sv)
        (dk-have! (list '<= zz s1) (lambda () (dk-nn! (list '<= zz sv))))
        (dk-cite! 'interval-mem-intro 1 s1 zz)
        (dk-have! (list '<= zz 'm) (lambda () (dk-nn! (list '<= zz sv) (list '<= sv 'm))))
        (dk-have! (list '<= zz 'n) (lambda () (dk-nn! (list '<= zz sv) (list '<= sv 'n))))
        (dk-cite! 'interval-mem-intro 1 'm zz)
        (dk-cite! 'interval-mem-intro 1 'n zz)
        (fact 'entry-in-carrier 'm 'n '(CARR R) 'D zz zz)
