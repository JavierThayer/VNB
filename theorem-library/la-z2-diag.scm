(define (lzd-nn f) (dk--replace f 'm 'n))
(define LZD-XD '(MATMUL R X D))
(sp (make-wff (forall-guarded '(R k n s X D p q)
                '((IS-RING R) (IN k NN) (IN n NN) (IN s NN) (IN X (MAT k n (CARR R))) (IN D (MAT n n (CARR R)))
                  (IS-DIAGONAL R n n D) (IN p (FUN (INTERVAL 1 s) (INTERVAL 1 k)))
                  (IN q (INJECTION (INTERVAL 1 s) (INTERVAL 1 n))))
                (list '= (list 'SUBMATRIX LZD-XD 's 'p 'q)
                      '(MATMUL R (SUBMATRIX X s p q) (SUBMATRIX D s q q))))))
(dk-peel!)
(lzd-inj-fun! 'q (lzd-iv 's) (lzd-iv 'n))
(let ((g (dk-cite! 'matmul-type 'R 'k 'n 'n 'X 'D)))
  (if (dk-head-is? g 'IMPLIES) (detach-with! g (lambda () (prop)))))
(dk-cite! 'submatrix-type 'R 'k 'n 's LZD-XD 'p 'q)
(dk-cite! 'submatrix-type 'R 'k 'n 's 'X 'p 'q)
(dk-cite! 'submatrix-type 'R 'n 'n 's 'D 'q 'q)
(let ((g (dk-cite! 'matmul-type 'R 's 's 's '(SUBMATRIX X s p q) '(SUBMATRIX D s q q))))
  (if (dk-head-is? g 'IMPLIES) (detach-with! g (lambda () (prop)))))
(detach-with! (dk-cite! 'matrix-entry-extensionality 's 's '(CARR R)
                (list 'SUBMATRIX LZD-XD 's 'p 'q) '(MATMUL R (SUBMATRIX X s p q) (SUBMATRIX D s q q)))
  (lambda ()
    (let* ((uv (lzd-iv-vars (dk-peel!) 's)) (u (car uv)) (v (cadr uv))
           (pu (list 'p u)) (qv (list 'q v)))
      (lzd-app! 'p u (lzd-iv 's) (lzd-iv 'k))
      (lzd-app! 'q v (lzd-iv 's) (lzd-iv 'n))
      ;; column q(v) of D vanishes off the diagonal
      (dk-have! (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 n)) (list 'IMPLIES (list 'NOT (list '= 'i_ qv)) (list '= (list 'ENTRY 'D 'i_ qv) '(ZERO R)))))
        (lambda ()
          (let ((x (car (lzd-iv-vars (dk-peel!) 'n))))
            (dk-cite! 'diagonal-off-entry 'R 'n 'n 'D x qv)
            (ass))))
      ;; column v of the diagonal submatrix vanishes off the diagonal
      (dk-have! (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 s)) (list 'IMPLIES (list 'NOT (list '= 'i_ v)) (list '= (list 'ENTRY '(SUBMATRIX D s q q) 'i_ v) '(ZERO R)))))
        (lambda ()
          (let* ((ld (dk-peel!)) (x (car (lzd-iv-vars ld 's))) (qx (list 'q x)))
            (lzd-app! 'q x (lzd-iv 's) (lzd-iv 'n))
            (subst (dk-cite! 'submatrix-entry 'R 'n 'n 's 'D 'q 'q x v))
            (dk-have! (list 'NOT (list '= qx qv))
              (lambda ()
                (di)
                (lzd-inj-eq! (lzd-iv 's) (lzd-iv 'n) 'q x v)
                (lzd-contra! (list 'NOT (list '= x v)))))
            (subst (dk-cite! 'diagonal-off-entry 'R 'n 'n 'D qx qv))
            (fact 'ring-zero-in 'R)
            (rfl))))
      (subst (dk-cite! 'submatrix-entry 'R 'k 'n 's LZD-XD 'p 'q u v))
      (subst (dk-cite! 'rb4-matmul-entry-single 'R 'k 'n 'n 'X 'D pu qv))
      (subst (dk-cite! 'rb4-matmul-entry-single 'R 's 's 's '(SUBMATRIX X s p q) '(SUBMATRIX D s q q) u v))
      (subst (dk-cite! 'submatrix-entry 'R 'k 'n 's 'X 'p 'q u v))
      (subst (dk-cite! 'submatrix-entry 'R 'n 'n 's 'D 'q 'q v v))
      (fact 'entry-in-carrier 'k 'n '(CARR R) 'X pu qv)
      (fact 'entry-in-carrier 'n 'n '(CARR R) 'D qv qv)
      (fact 'ring-carrier-closed-mul 'R (list 'ENTRY 'X pu qv) (list 'ENTRY 'D qv qv))
      (rfl))))
(ass)
(lzd-done! 'submatrix-mul-diagonal)
(topic! 'submatrix-mul-diagonal 'algebra)
(gloss! 'submatrix-mul-diagonal "The submatrix of X D on rows p and injective columns q, D diagonal, is the submatrix of X times the diagonal submatrix of D on (q, q).")

(define (lzd-div-all c S)
  (list 'FORALL 'dvx_ (list 'IMPLIES (list 'IN 'dvx_ S)
    (list 'FORSOME 'dvy_ (list 'AND '(IN dvy_ (CARR R)) (list '= 'dvx_ (list '(MUL R) c 'dvy_)))))))
(sp (make-wff (forall-guarded '(R k n s X D)
                (append (list '(IS-COMMUTATIVE-RING R) '(IN k NN) '(IN n NN) '(IN s NN) '(IN X (MAT k n (CARR R)))
                              '(IN D (MAT n n (CARR R))) '(IS-DIAGONAL R n n D) (lzd-nn (lzd-chain 'D)) '(<= s n)))
                (lzd-div-all (lzd-nn (lzd-ps 'D 's)) (list 'SDET 'R 'k 'n LZD-XD 's)))))
(let* ((ld (dk-peel!))
       (ignore0 (fact 'commutative-ring-is-ring 'R))
       (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SDET))) ld)))
       (ex (dk-cite! 'sdet-elim 'R 'k 'n LZD-XD 's x))
       (pv (dk-skolem! ex #f))
       (e2 (find-first (lambda (f) (and (eq? (car f) 'FORSOME) (dk-contains? f pv))) (dk-asms)))
       (qv (dk-skolem! e2 #f))
       (cj (find-first (lambda (f) (and (eq? (car f) 'AND) (dk-contains? f qv) (dk-contains? f pv))) (dk-asms))))
  (dk-split-all! (list cj))
  (dk-split-all!)
  (lzd-inj-fun! pv (lzd-iv 's) (lzd-iv 'k))
  (lzd-inj-fun! qv (lzd-iv 's) (lzd-iv 'n))
  (let* ((sx (list 'SUBMATRIX 'X 's pv qv))
         (sd (list 'SUBMATRIX 'D 's qv qv))
         (sm1 (dk-cite! 'submatrix-mul-diagonal 'R 'k 'n 's 'X 'D pv qv))
         (ignore (begin (dk-cite! 'submatrix-type 'R 'k 'n 's 'X pv qv)
                        (dk-cite! 'submatrix-type 'R 'n 'n 's 'D qv qv)))
         (dm (dk-cite! 'det-multiplicative 'R 's sx sd))
         (y (dk-skolem! (dk-cite! 'diagonal-chain-minor-divisible 's 'R 'n 'n 'D qv qv)))
         (ps (lzd-nn (lzd-ps 'D 's))))
    (dk-cite! 'det-in-carrier 'R 's sx)
    (lzd-ps-type! 'D 's 'n 'n)
    (lzd-mul-type! (list 'DET 'R 's sx) y)
    (ew (lzd-mul (list 'DET 'R 's sx) y))
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IN)
            (ass)
            (begin
              (subst (list '= x (list 'DET 'R 's (list 'SUBMATRIX LZD-XD 's pv qv))))
              (subst sm1)
              (subst dm)
              (subst (list '= (list 'DET 'R 's sd) (lzd-mul ps y)))
              (crs)))))))
(lzd-done! 'diagonal-right-factor-sdet-divisible)
(topic! 'diagonal-right-factor-sdet-divisible 'algebra)
(gloss! 'diagonal-right-factor-sdet-divisible "For D diagonal with a divisibility chain, the product of the first s diagonal entries of D divides every order-s subdeterminant of X D.")

;; the same, for an equivalence by invertible integer matrices (3.38 turns them into
