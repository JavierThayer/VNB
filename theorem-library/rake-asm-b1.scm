;;; theorem-library/rake-asm-b1.scm -- THE FOUR FINITE-SUM INEQUALITIES OF
;;; analysis-inequalities.scm, PROVEN under their own names and statements
;;; (RAKE-ASM-B, agent RB-1, 2026-10-12):
;;;
;;;   cauchy-schwarz-finite  (SUM a b)^2 <= (SUM a^2)(SUM b^2)
;;;   cauchy-schwarz-sqrt    |SUM a b| <= sqrt(SUM a^2) sqrt(SUM b^2)
;;;   minkowski-l2           sqrt(SUM (a+b)^2) <= sqrt(SUM a^2) + sqrt(SUM b^2)
;;;   holder-finite          SUM |a b| <= (SUM |a|^p)^(1/p) (SUM |b|^q)^(1/q)
;;;
;;; Every sum runs over COMMUTATIVE-RING-ADDITIVE-AG(RR-NORMED-FIELD), the
;;; additive group whose carrier, identity and operation rake-inequalities.scm
;;; reads off (cra-ag-rr-carr, -iden, -opr-apply).
;;;
;;; THE ONE MISSING BRICK WAS LINEARITY.  The tree had the sum of two families
;;; (finsum-add-ag) but no way to pull a REAL scalar out of a sum over this
;;; group: finsum-ring-distrib-left-gen wants IS-COMMUTATIVE-RING of the ring,
;;; and RR-NORMED-FIELD is a 7-tuple (rake-inequalities.scm's header).  So the
;;; file proves, by finite-set induction with POINTWISE typing (the device of
;;; integral-laws.scm's comm-monoid section, whose induction kit is copied
;;; below under the rb1- prefix):
;;;
;;;   rb1-fs-empty   SUM over the empty set is 0
;;;   rb1-fs-real    a sum of a pointwise-real family is real
;;;   rb1-fs-ins     SUM over S u {k} = SUM over S + f(k)
;;;   rb1-fs-lin     h = c1 f + c2 g pointwise  =>  SUM h = c1 SUM f + c2 SUM g
;;;
;;; THE PROOFS.
;;; Cauchy-Schwarz: for all reals l, m, 0 <= SUM (l a_i - m b_i)^2
;;; = l^2 A - 2 l m C + m^2 B (rb1-fs-lin twice, finsum-rr-nonneg once).  The
;;; scalar lemma rb1-disc turns that universal into C^2 <= A B with no division:
;;; the instances (l, m) = (B, C) and (C, A) give B D >= 0 and A D >= 0 for
;;; D = A B - C^2, so (A + B) D >= 0 and A + B > 0 cancels; when A + B <= 0 the
;;; instances (1, 1), (1, -1) pin C between -(A+B)/2 and (A+B)/2 = 0.
;;; The root forms: sqrt-of-sq, sqrt-mul and sqrt-mono move the square form
;;; under SQRT; Minkowski expands SUM (a+b)^2 = A + 2C + B by rb1-fs-lin and
;;; bounds C by |C| <= sqrt A sqrt B.
;;; Hoelder: see its section.
;;;
;;; NOTHING IS ASSERTED.  No late tactic (contra, prep, ineq-supply).
;;;
;;; LOAD WINDOW [3400, 3668) in load.scm LINE numbers (2026-10-12).  lo: the
;;; latest citations are the RPOW laws and young-inequality
;;; (theorem-library/rpow-defined, line 3399); below them rake-inequalities
;;; (2439: cra-ag-rr-*, finsum-rr-nonneg, finsum-sq-nonneg, finsum-le-termwise),
;;; sqrt-defined (2188), rake-finsum-union (1381: finsum-insert-ptwise),
;;; rake-finsum-laws (1303), makeset-card-bound (1294), finsum-insert (1205),
;;; rake-card-star-laws (983: finite-set-induction), rr-recip-order (879),
;;; rr-abs-basics (845), rr-order-basics (827), fun-apply-type-proof (750).
;;; hi: theorem-library/pss-topics (3668) files the four names; nothing else
;;; cites them.  No late tactic (contra, prep, ineq-supply); type-term,
;;; dk-name!, dk-crs-opaque! are driver-kit.  Library: analysis.

;;; =====================================================================
;;; (0) file-local kit, prefix rb1-
;;; =====================================================================

(define rb1-ag '(COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD))
(define (rb1-fs f s) (list 'FINSUM rb1-ag f s))

(define (rb1-check name)
  (if (not (proof-done? *ps*))
      (error "rake-asm-b1: proof did not close" name
             (expression->string (dk-goal)))))

;;; (IN t RR) by the closure laws, its atoms typed in context first
(define (rb1-type! t)
  (if (not (dk-asm? (list 'IN t 'RR)))
      (dk-have! (list 'IN t 'RR) (lambda () (type-term)))))

;;; The finite-set induction kit of integral-laws.scm (ibk-), copied.
(define (rb1-keep-prop! . keepers)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! keepers)
    (if (not (sequent-node-grounded? leaf)) (prop))))
(define (rb1-syms x)
  (cond ((symbol? x) (list x))
        ((pair? x) (append (rb1-syms (car x)) (rb1-syms (cdr x))))
        (#t '())))
(define (rb1-ptw u body-of)
  (let* ((used (append (rb1-syms u) (rb1-syms (body-of 'rb1-dummy))))
         (b    (let loop ((cs '(z_ zz_ zq_ zr_ zs_ zt_)))
                 (if (memq (car cs) used) (loop (cdr cs)) (car cs)))))
    (list 'FORALL b (list 'IMPLIES (list 'IN b u) (body-of b)))))
(define (rb1-class prop-of) (list 'COMP 'iu_ (prop-of 'iu_)))
(define (rb1-step-formula c)
  (list 'FORALL 'is_
    (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ c)))
      (list 'FORALL 'ix_
        (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
          (list 'IN '(UNION is_ (PAIR ix_ ix_)) c))))))
(define (rb1-induct! xs prop-of base! step!)
  (let* ((c     (rb1-class prop-of))
         (stepf (rb1-step-formula c)))
    (have! (list 'IN 'EMPTY-SET c)
      (lambda ()
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) '(in empty-set set))
                (begin (fact 'empty-set-is-set) (ass))
                (base!)))
          (dk-opened (lambda () (comp-mi))))))
    (have! stepf
      (lambda ()
        (let* ((landed (dk-peel!))
               (g      (dk-goal))
               (u      (cadr g))
               (sv     (cadr u))
               (xv     (cadr (caddr u))))
          (dk-split-all! landed)
          (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
          (fact 'pairing xv xv)
          (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET)))
          (fact 'union-set-closure sv (list 'PAIR xv xv))
          (let ((pu (list 'UNION (list 'PAIR xv xv) sv)))
            (dk-split! (dk-fact! 'card-union-singleton-bound sv xv))
            (fact 'union-comm (list 'PAIR xv xv) sv)
            (dk-have! (list 'IN (list 'CARD u) 'NN)
              (lambda () (subst (list '= u pu)) (ass))))
          (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv c)))))
                 (ih (car (filter (lambda (f) (not (equal? f (list 'in sv 'set)))) ls))))
            (for-each
              (lambda (leaf)
                (dk-focus! leaf)
                (if (equal? (dk-goal) (list 'in u 'set))
                    (ass)
                    (step! sv xv u ih)))
              (dk-opened (lambda () (comp-mi))))))))
    (dk-have! (list 'AND (list 'IN 'EMPTY-SET c) stepf))
    (let ((ind (dk-fact! 'finite-set-induction c)))
      (dk-have! (list 'AND (list 'IN xs 'SET) (list 'IN (list 'CARD xs) 'NN)))
      (let* ((inx (dk-apply! ind xs))
             (ls  (dk-landed (lambda () (comp-me inx)))))
        (car (filter (lambda (f) (not (equal? f (list 'in xs 'set)))) ls))))))
(define (rb1-in-union-left! z sv u)
  (dk-have! (list 'IN z u)
    (lambda () (mac 'union-membership) (oi-l) (dk-ass!))))
(define (rb1-in-union-new! xv u)
  (dk-have! (list 'IN xv u)
    (lambda ()
      (mac 'union-membership) (oi-r)
      (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
      (let ((pm (inst*! (dk-cite! 'pairing-membership xv xv) xv)))
        (have! (list '= xv xv) (lambda () (rfl)))
        (rb1-keep-prop! pm (list '= xv xv))))))
(define (rb1-restrict! hyp-u sv u body-of)
  (let ((claim (rb1-ptw sv body-of)))
    (dk-have! claim
      (lambda ()
        (let ((zv (dk-di-var!)))
          (rb1-in-union-left! zv sv u)
          (inst+ hyp-u zv)
          (ass))))
    claim))
(define (rb1-detach-all! imp)
  (let loop ((f imp))
    (if (and (pair? f) (eq? (car f) 'implies) (dk-asm? (cadr f)))
        (let ((new (dk-landed (lambda () (detach! f)))))
          (loop (if (pair? new) (car new) (caddr f))))
        f)))

;;; =====================================================================
;;; (1) FINITE SUMS OVER RR'S ADDITIVE GROUP, POINTWISE-TYPED
;;; =====================================================================

;;; rb1-fs-empty
(sp (make-wff (list 'FORALL 'f_ (list '= (rb1-fs 'f_ 'EMPTY-SET) 0))))
(di)
(fact 'cra-ag-rr-is-abelian-group)
(fact 'finsum-empty rb1-ag 'f_)
(subst (list '== (rb1-fs 'f_ 'EMPTY-SET) (list 'IDEN rb1-ag)))
(mac 'cra-ag-rr-iden)
(rfl)
(rb1-check 'rb1-fs-empty)
(qed 'rb1-fs-empty)
(topic! 'rb1-fs-empty 'plumbing)

;;; rb1-fs-real
(sp (make-wff
  (list 'FORALL 's_ (list 'IMPLIES '(IN s_ SET) (list 'IMPLIES '(IN (CARD s_) NN)
    (list 'FORALL 'f_
      (list 'IMPLIES '(FORALL z_ (IMPLIES (IN z_ s_) (IN (f_ z_) RR)))
        (list 'IN (rb1-fs 'f_ 's_) 'RR))))))))
(dk-peel!)
(fact 'cra-ag-rr-is-abelian-group)
(dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ s_) (list 'IN '(f_ z_) (list 'CARR rb1-ag))))
  (lambda () (mac 'cra-ag-rr-carr) (ass)))
(fact 'finsum-type-ptwise rb1-ag 's_ 'f_)
(mac 'cra-ag-rr-carr-rev)
(ass)
(rb1-check 'rb1-fs-real)
(qed 'rb1-fs-real)
(topic! 'rb1-fs-real 'plumbing)

;;; rb1-fs-ins
(define rb1-u0 '(UNION s_ (PAIR k_ k_)))
(sp (make-wff
  (list 'FORALL 's_ (list 'IMPLIES '(IN s_ SET) (list 'IMPLIES '(IN (CARD s_) NN)
   (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ SET) (list 'IMPLIES '(NOT (IN k_ s_))
    (list 'FORALL 'f_
      (list 'IMPLIES (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ rb1-u0) '(IN (f_ z_) RR)))
        (list '= (rb1-fs 'f_ rb1-u0) (list '+ (rb1-fs 'f_ 's_) '(f_ k_)))))))))))))
(dk-peel!)
(fact 'cra-ag-rr-is-abelian-group)
(let* ((tf  (lambda (z) (list 'IN (list 'f_ z) 'RR)))
       (hu  (rb1-ptw rb1-u0 tf)))
  (dk-have! (rb1-ptw rb1-u0 (lambda (z) (list 'IN (list 'f_ z) (list 'CARR rb1-ag))))
    (lambda () (mac 'cra-ag-rr-carr) (ass)))
  (let ((ins (dk-fact! 'finsum-insert-ptwise rb1-ag 's_ 'k_ 'f_)))
    (rb1-restrict! hu 's_ rb1-u0 tf)
    (fact 'rb1-fs-real 's_ 'f_)
    (rb1-in-union-new! 'k_ rb1-u0)
    (inst+ hu 'k_)
    (subst ins)
    (mac 'cra-ag-rr-opr-apply)
    (rfl)))
(rb1-check 'rb1-fs-ins)
(qed 'rb1-fs-ins)
(topic! 'rb1-fs-ins 'plumbing)

;;; rb1-fs-lin -- LINEARITY: a real combination of two pointwise-real families.
(define (rb1-lin-rhs c1 c2 fa ga) (list '+ (list '* c1 fa) (list '* c2 ga)))
(sp (make-wff
  (list 'FORALL 's (list 'IMPLIES '(IN s SET) (list 'IMPLIES '(IN (CARD s) NN)
   (list 'FORALL 'c1 (list 'IMPLIES '(IN c1 RR) (list 'FORALL 'c2 (list 'IMPLIES '(IN c2 RR)
    (list 'FORALL 'f (list 'FORALL 'g (list 'FORALL 'h
     (list 'IMPLIES '(FORALL z_ (IMPLIES (IN z_ s) (IN (f z_) RR)))
     (list 'IMPLIES '(FORALL z_ (IMPLIES (IN z_ s) (IN (g z_) RR)))
     (list 'IMPLIES '(FORALL z_ (IMPLIES (IN z_ s) (= (h z_) (+ (* c1 (f z_)) (* c2 (g z_))))))
       (list '= (rb1-fs 'h 's) (rb1-lin-rhs 'c1 'c2 (rb1-fs 'f 's) (rb1-fs 'g 's))))))))))))))))))
(dk-peel!)
(fact 'cra-ag-rr-is-abelian-group)
(let* ((tf (lambda (z) (list 'IN (list 'f z) 'RR)))
       (tg (lambda (z) (list 'IN (list 'g z) 'RR)))
       (th (lambda (z) (list 'IN (list 'h z) 'RR)))
       (eh (lambda (z) (list '= (list 'h z) (rb1-lin-rhs 'c1 'c2 (list 'f z) (list 'g z)))))
       (prop-of (lambda (u)
                  (list 'IMPLIES (rb1-ptw u tf)
                    (list 'IMPLIES (rb1-ptw u tg)
                      (list 'IMPLIES (rb1-ptw u eh)
                        (list '= (rb1-fs 'h u)
                              (rb1-lin-rhs 'c1 'c2 (rb1-fs 'f u) (rb1-fs 'g u))))))))
       (px (rb1-induct! 's prop-of
             (lambda ()
               (dk-peel!)
               (for-each (lambda (fv) (fact 'rb1-fs-empty fv)) '(h f g))
               (for-each (lambda (fv) (subst (list '= (rb1-fs fv 'EMPTY-SET) 0))) '(h f g))
               (crs))
             (lambda (sv xv u ih)
               (let* ((hs  (dk-peel!))
                      (hfu (rb1-ptw u tf)) (hgu (rb1-ptw u tg)) (hhu (rb1-ptw u eh)))
                 (rb1-restrict! hfu sv u tf)
                 (rb1-restrict! hgu sv u tg)
                 (rb1-restrict! hhu sv u eh)
                 (let ((ihq (rb1-detach-all! ih)))
                   (rb1-in-union-new! xv u)
                   (inst+ hfu xv) (inst+ hgu xv) (inst+ hhu xv)
                   (let ((thu (rb1-ptw u th)))
                     (dk-have! thu
                       (lambda ()
                         (let ((zv (dk-di-var!)))
                           (inst+ hhu zv) (inst+ hfu zv) (inst+ hgu zv)
                           (subst (eh zv))
                           (type-term))))
                     (rb1-restrict! thu sv u th))
                   (for-each (lambda (fv) (fact 'rb1-fs-ins sv xv fv)) '(f g h))
                   (for-each (lambda (fv) (fact 'rb1-fs-real sv fv)) '(f g h))
                   (for-each (lambda (fv)
                               (subst (list '= (rb1-fs fv u)
                                            (list '+ (rb1-fs fv sv) (list fv xv)))))
                             '(h f g))
                   (subst ihq)
                   (subst (eh xv))
                   (crs)))))))
  (rb1-detach-all! px)
  (ass))
(rb1-check 'rb1-fs-lin)
(qed 'rb1-fs-lin)
(topic! 'rb1-fs-lin 'algebra)
(alias! 'rb1-fs-lin "a finite real sum is linear in the summand")

;;; ---- driver helpers over a set SV and coefficient functions FNS ------

;;; forall z in SV. (LAM z) in RR, by beta and the closure laws
(define (rb1-ptw-real! sv lam fns)
  (let ((claim (rb1-ptw sv (lambda (z) (list 'IN (list lam z) 'RR)))))
    (dk-have! claim
      (lambda ()
        (let ((zv (dk-di-var!)))
          (for-each (lambda (fv) (fact 'fun-apply-type-c fv sv 'RR zv)) fns)
          (if (not (dk-lam-b!)) (type-term)))))
    claim))

;;; forall z in SV. (H z) = (RHS-OF z), by beta and `crs'
(define (rb1-ptw-eq! sv h rhs-of fns)
  (let ((claim (rb1-ptw sv (lambda (z) (list '= (list h z) (rhs-of z))))))
    (dk-have! claim
      (lambda ()
        (let ((zv (dk-di-var!)))
          (for-each (lambda (fv) (fact 'fun-apply-type-c fv sv 'RR zv)) fns)
          (if (not (dk-lam-b!)) (crs)))))
    claim))

;;; SUM h = c1 SUM f + c2 SUM g, h given pointwise; the pointwise realness of
;;; f and g must be in context.  Returns the equation.
(define (rb1-lin! sv c1 c2 f g h fns)
  (rb1-type! c1)
  (rb1-type! c2)
  (rb1-ptw-eq! sv h (lambda (z) (rb1-lin-rhs c1 c2 (list f z) (list g z))) fns)
  (dk-fact! 'rb1-fs-lin sv c1 c2 f g h))

;;; 0 <= SUM LAM for a lambda whose body is a square (* X X).
(define (rb1-sq-nonneg! sv lam fns)
  (dk-have! (list 'IN lam (list 'FUN sv 'RR))
    (lambda ()
      (for-each (lambda (n)
                  (dk-focus! n)
                  (if (equal? (dk-goal) (list 'IN sv 'SET))
                      (ass)
                      (let* ((landed (dk-peel!)) (iv (cadr (car landed))))
                        (for-each (lambda (fv) (fact 'fun-apply-type-c fv sv 'RR iv)) fns)
                        (type-term))))
                (dk-opened (lambda () (lam-t))))))
  (dk-have! (rb1-ptw sv (lambda (z) (list '<= 0 (list lam z))))
    (lambda ()
      (let ((zv (dk-di-var!)))
        (for-each (lambda (fv) (fact 'fun-apply-type-c fv sv 'RR zv)) fns)
        (dk-lam-b!)
        (let ((x (cadr (caddr (dk-goal)))))
          (rb1-type! x)
          (fact 'rr-sq-nonneg x)
          (ass)))))
  (dk-fact! 'finsum-rr-nonneg sv lam))

;;; =====================================================================
;;; (2) THE SCALAR STEP: a nonnegative binary quadratic form has
;;;     nonpositive discriminant.  No division.
;;; =====================================================================

;;; l^2 A - 2 l m C + m^2 B
(define (rb1-qf l m qa qb qc)
  (list '+ (list '+ (list '* (list '* l l) qa)
                    (list '* (list '- (list '* 2 (list '* l m))) qc))
           (list '* (list '* m m) qb)))
(define (rb1-qh qa qb qc)
  (list 'FORALL 'l_ (list 'IMPLIES '(IN l_ RR)
    (list 'FORALL 'm_ (list 'IMPLIES '(IN m_ RR)
      (list '<= 0 (rb1-qf 'l_ 'm_ qa qb qc)))))))

(sp (make-wff
  (list 'FORALL 'qa (list 'IMPLIES '(IN qa RR)
   (list 'FORALL 'qb (list 'IMPLIES '(IN qb RR)
    (list 'FORALL 'qc (list 'IMPLIES '(IN qc RR)
     (list 'IMPLIES (rb1-qh 'qa 'qb 'qc)
       '(<= (* qc qc) (* qa qb)))))))))))
(dk-peel!)
(fact 'rr-zero-in)
(fact 'rr-one-in)
(fact 'rr-neg-closed 1)
(define rb1-dh (rb1-qh 'qa 'qb 'qc))
;;; an instance, rewritten to CLEAN by a ring identity; lands (<= 0 CLEAN)
(define (rb1-dinst! l m clean)
  (let* ((mid (list 'FORALL 'm_ (list 'IMPLIES '(IN m_ RR)
                (list '<= 0 (rb1-qf l 'm_ 'qa 'qb 'qc)))))
         (ex  (rb1-qf l m 'qa 'qb 'qc)))
    ;; an instance already in context is not landed twice (inst+ would error)
    (if (not (dk-asm? mid)) (inst+ rb1-dh l))
    (if (not (dk-asm? (list '<= 0 ex))) (inst+ mid m))
    (if (not (dk-asm? (list '<= 0 ex)))
        (error "rb1-dinst!: the instance did not land" (expression->string ex)))
    (rb1-type! clean)
    (dk-have! (list '= ex clean) (lambda () (crs)))
    (dk-have! (list '<= 0 clean)
      (lambda () (subst (list '= clean ex)) (ass)))
    (list '<= 0 clean)))
(define rb1-dx (list '- '(* qa qb) '(* qc qc)))
(define rb1-d1 (rb1-dinst! 'qb 'qc (list '* 'qb rb1-dx)))
(define rb1-d2 (rb1-dinst! 'qc 'qa (list '* 'qa rb1-dx)))
(define rb1-d3 (rb1-dinst! 1 0 'qa))
(define rb1-d4 (rb1-dinst! 0 1 'qb))
(define rb1-d5 (rb1-dinst! 1 1 '(+ (- qa (* 2 qc)) qb)))
(define rb1-d6 (rb1-dinst! 1 '(- 1) '(+ (+ qa (* 2 qc)) qb)))
(rb1-type! '(* qa qb))
(rb1-type! '(* qc qc))
(rb1-type! rb1-dx)
(define rb1-v (dk-name! rb1-dx))
(define (rb1-dv! k dk)
  (rb1-type! (list '* k rb1-v))
  (dk-have! (list '<= 0 (list '* k rb1-v))
    (lambda ()
      (subst (list '= rb1-v rb1-dx))
      (ass)))
  (list '<= 0 (list '* k rb1-v)))
(define rb1-e1 (rb1-dv! 'qb rb1-d1))
(define rb1-e2 (rb1-dv! 'qa rb1-d2))
(define rb1-s '(+ qa qb))
(rb1-type! rb1-s)
(fact 'rr-lt-trichotomy 0 rb1-s)
(define (rb1-degenerate! case-f)
  (dk-have! '(= qa 0) (lambda () (dk-ineq! case-f rb1-d3 rb1-d4)))
  (dk-have! '(= qb 0) (lambda () (dk-ineq! case-f rb1-d3 rb1-d4)))
  (dk-have! '(= qc 0) (lambda () (dk-ineq! case-f rb1-d3 rb1-d4 rb1-d5 rb1-d6)))
  (subst '(= qc 0))
  (subst '(= qa 0))
  (subst '(= qb 0))
  (dk-ineq!))
(use-cases (list (list '< 0 rb1-s) (list '= 0 rb1-s) (list '< rb1-s 0))
  (lambda ()
    (let ((vs (list '* rb1-s rb1-v)))
      (rb1-type! vs)
      (dk-have! (list '= vs (list '+ (list '* 'qb rb1-v) (list '* 'qa rb1-v))) (lambda () (crs)))
      (dk-have! (list '<= 0 vs)
        (lambda ()
          (subst (list '= vs (list '+ (list '* 'qb rb1-v) (list '* 'qa rb1-v))))
          (dk-ineq! rb1-e1 rb1-e2)))
      (fact 'rr-nonneg-cancel-pos rb1-s rb1-v)
      (dk-ineq! (list '<= 0 rb1-v) (list '= rb1-v rb1-dx))))
  (lambda () (rb1-degenerate! (list '= 0 rb1-s)))
  (lambda () (rb1-degenerate! (list '< rb1-s 0))))
(rb1-check 'rb1-disc)
(qed 'rb1-disc)
(topic! 'rb1-disc 'inequalities)
(alias! 'rb1-disc "a nonnegative binary quadratic form has nonpositive discriminant")

;;; =====================================================================
;;; (3) CAUCHY-SCHWARZ, SQUARE FORM
;;; =====================================================================

;;; Peel a statement  forall S, (S set and card S in NN) => forall a in FUN(S,RR)
;;; => forall b in FUN(S,RR) => ...; split the AND.
(define (rb1-open!)
  (dk-split-all! (dk-peel!)))

;;; A^1, B^1, C^1 read off a summand family (VNB-LAMBDA i S (* (a i) (b i)))
(define (rb1-lam-parts lam)          ; -> (S a b)
  (let ((body (cadddr lam)))
    (list (caddr lam) (car (cadr body)) (car (caddr body)))))

(sp (make-wff
  '(FORALL S (IMPLIES (AND (IN S SET) (IN (CARD S) NN))
     (FORALL a (IMPLIES (IN a (FUN S RR))
       (FORALL b (IMPLIES (IN b (FUN S RR))
         (<= (* (FINSUM (COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD)
                        (VNB-LAMBDA i S (* (a i) (b i))) S)
                (FINSUM (COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD)
                        (VNB-LAMBDA i S (* (a i) (b i))) S))
             (* (FINSUM (COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD)
                        (VNB-LAMBDA i S (* (a i) (a i))) S)
                (FINSUM (COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD)
                        (VNB-LAMBDA i S (* (b i) (b i))) S)))))))))))
(rb1-open!)
(fact 'cra-ag-rr-is-abelian-group)
(let* ((g     (dk-goal))
       (fc    (cadr (cadr g)))
       (fa    (cadr (caddr g)))
       (fb    (caddr (caddr g)))
       (lab   (caddr fc)) (laa (caddr fa)) (lbb (caddr fb))
       (parts (rb1-lam-parts lab))
       (sv    (car parts)) (av (cadr parts)) (bv (caddr parts))
       (fns   (list av bv)))
  (for-each (lambda (lam) (rb1-ptw-real! sv lam fns)) (list laa lab lbb))
  (for-each (lambda (lam) (fact 'rb1-fs-real sv lam)) (list laa lab lbb))
  (dk-have! (rb1-qh fa fb fc)
    (lambda ()
      (dk-peel!)
      (if (not (and (dk-asm? '(IN l_ RR)) (dk-asm? '(IN m_ RR))))
          (error "rb1: the eigenvariables are not l_, m_" (expression->string (dk-goal))))
      (let* ((k1 '(* l_ l_)) (k2 '(- (* 2 (* l_ m_)))) (k3 '(* m_ m_))
             (ax (lambda (z) (list av z))) (bx (lambda (z) (list bv z)))
             (lq (list 'VNB-LAMBDA 'rbw_ sv
                       (list '* (list '- (list '* 'l_ (ax 'rbw_)) (list '* 'm_ (bx 'rbw_)))
                                (list '- (list '* 'l_ (ax 'rbw_)) (list '* 'm_ (bx 'rbw_))))))
             (lh (list 'VNB-LAMBDA 'rbw_ sv
                       (list '+ (list '* k1 (list '* (ax 'rbw_) (ax 'rbw_)))
                                (list '* k2 (list '* (ax 'rbw_) (bx 'rbw_)))))))
        (for-each rb1-type! (list k1 k2 k3))
        (rb1-ptw-real! sv lh fns)
        (rb1-ptw-real! sv lq fns)
        (let* ((eqb (rb1-lin! sv k1 k2 laa lab lh fns))
               (eqa (rb1-lin! sv 1 k3 lh lbb lq fns))
               (nn  (rb1-sq-nonneg! sv lq fns))
               (fq  (rb1-fs lq sv))
               (tgt (rb1-qf 'l_ 'm_ fa fb fc)))
          (fact 'rb1-fs-real sv lh)
          (fact 'rb1-fs-real sv lq)
          (dk-have! (list '= fq tgt)
            (lambda () (subst eqa) (subst eqb) (dk-crs-opaque!)))
          (subst (list '= tgt fq))
          (ass)))))
  (fact 'rb1-disc fa fb fc)
  (ass))
(rb1-check 'cauchy-schwarz-finite)
(qed 'cauchy-schwarz-finite)

;;; =====================================================================
;;; (4) CAUCHY-SCHWARZ, ROOT FORM
;;; =====================================================================

(sp (make-wff
  '(FORALL S (IMPLIES (AND (IN S SET) (IN (CARD S) NN))
     (FORALL a (IMPLIES (IN a (FUN S RR)) (FORALL b (IMPLIES (IN b (FUN S RR))
       (<= (abs (FINSUM (COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD)
                        (VNB-LAMBDA i S (* (a i) (b i))) S))
           (* (SQRT (FINSUM (COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD)
                            (VNB-LAMBDA i S (* (a i) (a i))) S))
              (SQRT (FINSUM (COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD)
                            (VNB-LAMBDA i S (* (b i) (b i))) S))))))))))))
(rb1-open!)
(fact 'cra-ag-rr-is-abelian-group)
(let* ((g     (dk-goal))
       (fc    (cadr (cadr g)))
       (fa    (cadr (cadr (caddr g))))
       (fb    (cadr (caddr (caddr g))))
       (lab   (caddr fc)) (laa (caddr fa)) (lbb (caddr fb))
       (parts (rb1-lam-parts lab))
       (sv    (car parts)) (av (cadr parts)) (bv (caddr parts))
       (fns   (list av bv))
       (cc    (list '* fc fc))
       (ab    (list '* fa fb)))
  (for-each (lambda (lam) (rb1-ptw-real! sv lam fns)) (list laa lab lbb))
  (for-each (lambda (lam) (fact 'rb1-fs-real sv lam)) (list laa lab lbb))
  (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'CARD sv) 'NN)))
  (fact 'finsum-sq-nonneg sv av)
  (fact 'finsum-sq-nonneg sv bv)
  (fact 'cauchy-schwarz-finite sv av bv)
  (rb1-type! cc)
  (rb1-type! ab)
  (fact 'rr-sq-nonneg fc)
  (dk-have! (list 'AND (list 'IN fa 'RR) (list 'IN fb 'RR)))
  (dk-have! (list 'AND (list '<= 0 fa) (list '<= 0 fb)))
  (fact 'rr-leq-mul-nonneg fa fb)
  (fact 'sqrt-of-sq fc)
  (dk-have! (list 'AND (list 'IN fa 'RR) (list '<= 0 fa)))
  (dk-have! (list 'AND (list 'IN fb 'RR) (list '<= 0 fb)))
  (fact 'sqrt-mul fa fb)
  (dk-have! (list 'AND (list 'IN cc 'RR) (list '<= 0 cc)))
  (dk-have! (list 'AND (list 'IN ab 'RR) (list '<= cc ab)))
  (fact 'sqrt-mono cc ab)
  (subst (list '= (list 'abs fc) (list 'SQRT cc)))
  (subst (list '= (list '* (list 'SQRT fa) (list 'SQRT fb)) (list 'SQRT ab)))
  (ass))
(rb1-check 'cauchy-schwarz-sqrt)
(qed 'cauchy-schwarz-sqrt)

;;; =====================================================================
;;; (5) MINKOWSKI, l^2
;;; =====================================================================

(sp (make-wff
  '(FORALL S (IMPLIES (AND (IN S SET) (IN (CARD S) NN))
     (FORALL a (IMPLIES (IN a (FUN S RR)) (FORALL b (IMPLIES (IN b (FUN S RR))
       (<= (SQRT (FINSUM (COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD)
                         (VNB-LAMBDA i S (* (+ (a i) (b i)) (+ (a i) (b i)))) S))
           (+ (SQRT (FINSUM (COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD)
                            (VNB-LAMBDA i S (* (a i) (a i))) S))
              (SQRT (FINSUM (COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD)
                            (VNB-LAMBDA i S (* (b i) (b i))) S))))))))))))
(rb1-open!)
(fact 'cra-ag-rr-is-abelian-group)
(let* ((g     (dk-goal))
       (fp    (cadr (cadr g)))
       (fa    (cadr (cadr (caddr g))))
       (fb    (cadr (caddr (caddr g))))
       (lp    (caddr fp)) (laa (caddr fa)) (lbb (caddr fb))
       (sv    (caddr laa))
       (av    (car (cadr (cadddr laa))))
       (bv    (car (cadr (cadddr lbb))))
       (fns   (list av bv))
       (lab   (list 'VNB-LAMBDA 'i sv (list '* (list av 'i) (list bv 'i))))
       (fc    (rb1-fs lab sv))
       (sa    (list 'SQRT fa)) (sb (list 'SQRT fb))
       (tt    (list '+ sa sb))
       (t2    (list '* tt tt))
       (lh    (list 'VNB-LAMBDA 'rbw_ sv
                    (list '+ (list '* 1 (list '* (list av 'rbw_) (list av 'rbw_)))
                             (list '* 2 (list '* (list av 'rbw_) (list bv 'rbw_)))))))
  (for-each (lambda (lam) (rb1-ptw-real! sv lam fns)) (list laa lab lbb lh lp))
  (for-each (lambda (lam) (fact 'rb1-fs-real sv lam)) (list laa lab lbb lh lp))
  (let* ((eqh (rb1-lin! sv 1 2 laa lab lh fns))
         (eqp (rb1-lin! sv 1 1 lh lbb lp fns))
         (nnp (rb1-sq-nonneg! sv lp fns)))
    (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'CARD sv) 'NN)))
    (fact 'finsum-sq-nonneg sv av)
    (fact 'finsum-sq-nonneg sv bv)
    (dk-have! (list 'AND (list 'IN fa 'RR) (list '<= 0 fa)))
    (dk-have! (list 'AND (list 'IN fb 'RR) (list '<= 0 fb)))
    (dk-split! (dk-fact! 'sqrt-nonneg fa))
    (dk-split! (dk-fact! 'sqrt-nonneg fb))
    (fact 'sqrt-sq fa)
    (fact 'sqrt-sq fb)
    (let ((csq (dk-fact! 'cauchy-schwarz-sqrt sv av bv)))
      (if (not (equal? (cadr (cadr csq)) fc))
          (error "rb1: the C of cauchy-schwarz-sqrt is not the C built here"
                 (expression->string csq)))
      (fact 'rr-le-abs fc)
      (fact 'rr-abs-closed fc)
      (for-each rb1-type! (list (list '* sa sa) (list '* sb sb) (list '* sa sb) tt t2))
      (dk-have! (list '<= 0 tt) (lambda () (dk-ineq! (list '<= 0 sa) (list '<= 0 sb))))
      (let ((ex (list '+ (list '+ (list '* sa sa) (list '* 2 (list '* sa sb))) (list '* sb sb))))
        (dk-have! (list '= t2 ex) (lambda () (dk-crs-opaque!)))
        (dk-have! (list '<= fp t2)
          (lambda ()
            (subst (list '= t2 ex))
            (dk-ineq! eqh eqp
                      (list '= (list '* sa sa) fa) (list '= (list '* sb sb) fb)
                      (list '<= fc (list 'abs fc)) csq))))
      (fact 'rr-sq-nonneg tt)
      (dk-have! (list 'AND (list 'IN fp 'RR) (list '<= 0 fp)))
      (dk-have! (list 'AND (list 'IN t2 'RR) (list '<= fp t2)))
      (fact 'sqrt-mono fp t2)
      (dk-split! (dk-fact! 'sqrt-nonneg fp))
      (dk-have! (list 'AND (list 'IN t2 'RR) (list '<= 0 t2)))
      (dk-split! (dk-fact! 'sqrt-nonneg t2))
      (fact 'sqrt-of-sq tt)
      (fact 'rr-abs-closed tt)
      (fact 'rr-abs-of-nonneg tt)
      (dk-ineq! (list '<= (list 'SQRT fp) (list 'SQRT t2))
                (list '= (list 'SQRT t2) (list 'abs tt))
                (list '= (list 'abs tt) tt)))))
(rb1-check 'minkowski-l2)
(qed 'minkowski-l2)



;;; =====================================================================
;;; (6) HOELDER.
;;;
;;; With X = SUM |a|^p, Y = SUM |b|^q, s = X^(1/p), t = Y^(1/q):
;;;   X = 0 (or Y = 0): every |a_i|^p <= X = 0 (rb1-fs-term-le), so |a_i| = 0
;;;     (rb1-rpow-zero), every |a_i b_i| = 0 and the left side is 0 <= s t.
;;;   X, Y > 0: s, t > 0, s^p = X, t^q = Y (rpow-pow, rpow-one), and termwise
;;;     |a_i b_i| <= K1 |a_i|^p + K2 |b_i|^q,  K1 = s t / (s^p p),
;;;     K2 = s t / (t^q q)  (rb1-young-scaled: Young at |a_i|/s, |b_i|/t,
;;;     scaled by s t), summed (finsum-le-termwise, rb1-fs-lin):
;;;     SUM |a b| <= K1 X + K2 Y = s t (1/p + 1/q) = s t.
;;; =====================================================================

;;; ---- scalar lemmas on RPOW --------------------------------------------

;;; x >= 0, r in QQ, r > 0  =>  x^r real and >= 0
(sp (make-wff
  '(FORALL x (IMPLIES (IN x RR) (IMPLIES (<= 0 x)
     (FORALL r (IMPLIES (IN r QQ) (IMPLIES (< 0 r)
       (AND (IN (RPOW x r) RR) (<= 0 (RPOW x r)))))))))))
(dk-peel!)
(fact 'qq-subset-rr 'r)
(fact 'rr-zero-in)
(fact 'rr-lt-trichotomy 0 'x)
(define (rb1-rnn-pos!)
  (dk-have! '(AND (IN x RR) (< 0 x)))
  (dk-split! (dk-fact! 'rpow-pos 'x 'r))
  (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass) (dk-ineq! '(< 0 (RPOW x r)))))))
(use-cases '((< 0 x) (= 0 x) (< x 0))
  rb1-rnn-pos!
  (lambda ()
    (subst '(= x 0))
    (dk-have! '(AND (IN r QQ) (< 0 r)))
    (fact 'rpow-zero-base 'r)
    (subst '(= (RPOW 0 r) 0))
    (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'IN) (ass) (dk-ineq!)))))
  (lambda ()
    (dk-have! '(< 0 x) (lambda () (dk-ineq! '(< x 0) '(<= 0 x))))
    (rb1-rnn-pos!)))
(rb1-check 'rb1-rpow-nn)
(qed 'rb1-rpow-nn)
(topic! 'rb1-rpow-nn 'plumbing)

;;; x >= 0, r in QQ, r > 0, x^r = 0  =>  x = 0
(sp (make-wff
  '(FORALL x (IMPLIES (IN x RR) (IMPLIES (<= 0 x)
     (FORALL r (IMPLIES (IN r QQ) (IMPLIES (< 0 r)
       (IMPLIES (= (RPOW x r) 0) (= x 0))))))))))
(dk-peel!)
(fact 'qq-subset-rr 'r)
(fact 'rr-zero-in)
(fact 'rr-lt-trichotomy 0 'x)
(use-cases '((< 0 x) (= 0 x) (< x 0))
  (lambda ()
    (dk-have! '(AND (IN x RR) (< 0 x)))
    (dk-split! (dk-fact! 'rpow-pos 'x 'r))
    (dk-ineq! '(= (RPOW x r) 0) '(< 0 (RPOW x r))))
  (lambda () (dk-ineq! '(= 0 x)))
  (lambda () (dk-ineq! '(< x 0) '(<= 0 x))))
(rb1-check 'rb1-rpow-zero)
(qed 'rb1-rpow-zero)
(topic! 'rb1-rpow-zero 'plumbing)

;;; (x / c)^r = x^r / c^r  for x >= 0, c > 0, r in QQ, r > 0
(sp (make-wff
  '(FORALL x (IMPLIES (IN x RR) (IMPLIES (<= 0 x)
     (FORALL c (IMPLIES (IN c RR) (IMPLIES (< 0 c)
       (FORALL r (IMPLIES (IN r QQ) (IMPLIES (< 0 r)
         (= (RPOW (* x (recip c)) r) (* (RPOW x r) (recip (RPOW c r)))))))))))))))
(dk-peel!)
(fact 'qq-subset-rr 'r)
(fact 'rr-zero-in)
(fact 'qq-one-in)
(fact 'qq-zero-in)
(fact 'rr-pos-ne-zero 'c)
(dk-have! '(AND (IN c RR) (NOT (= c 0))))
(fact 'rr-recip-closed 'c)
(fact 'rr-recip-pos 'c)
(dk-have! '(AND (IN c RR) (< 0 c)))
(dk-split! (dk-fact! 'rpow-pos 'c 'r))
(fact 'rr-pos-ne-zero '(RPOW c r))
(dk-have! '(AND (IN (RPOW c r) RR) (NOT (= (RPOW c r) 0))))
(fact 'rr-recip-closed '(RPOW c r))
(fact 'rr-lt-trichotomy 0 'x)
(define (rb1-rsc-pos!)
  (dk-have! '(AND (IN x RR) (< 0 x)))
  (dk-have! '(AND (IN (recip c) RR) (< 0 (recip c))))
  (fact 'rpow-mul-base 'x '(recip c) 'r)
  (subst '(= (RPOW (* x (recip c)) r) (* (RPOW x r) (RPOW (recip c) r))))
  ;; c^(-1) = recip c, and (c^(-1))^r = c^(-r) = recip(c^r)
  (fact 'rpow-neg 'c 1)
  (fact 'rpow-one 'c)
  (dk-have! '(IN (- 0 1) QQ) (lambda () (type-term)))
  (dk-have! '(IN (- 0 r) QQ) (lambda () (type-term)))
  (dk-have! '(= (RPOW c (- 0 1)) (recip c))
    (lambda () (subst '(= (RPOW c (- 0 1)) (recip (RPOW c 1))))
               (subst '(= (RPOW c 1) c))
               (rfl)))
  (fact 'rpow-pow 'c '(- 0 1) 'r)
  (dk-have! '(= (* (- 0 1) r) (- 0 r)) (lambda () (crs)))
  (fact 'rpow-neg 'c 'r)
  (dk-have! '(= (RPOW (recip c) r) (recip (RPOW c r)))
    (lambda ()
      (subst '(= (recip c) (RPOW c (- 0 1))))
      (subst '(= (RPOW (RPOW c (- 0 1)) r) (RPOW c (* (- 0 1) r))))
      (subst '(= (* (- 0 1) r) (- 0 r)))
      (subst '(= (RPOW c (- 0 r)) (recip (RPOW c r))))
      (rfl)))
  (subst '(= (RPOW (recip c) r) (recip (RPOW c r))))
  (dk-split! (dk-fact! 'rpow-pos 'x 'r))
  (rb1-type! '(* (RPOW x r) (recip (RPOW c r))))
  (rfl))
(use-cases '((< 0 x) (= 0 x) (< x 0))
  rb1-rsc-pos!
  (lambda ()
    (subst '(= x 0))
    (dk-have! '(= (* 0 (recip c)) 0) (lambda () (dk-crs-opaque!)))
    (subst '(= (* 0 (recip c)) 0))
    (dk-have! '(AND (IN r QQ) (< 0 r)))
    (fact 'rpow-zero-base 'r)
    (subst '(= (RPOW 0 r) 0))
    (dk-crs-opaque!))
  (lambda ()
    (dk-have! '(< 0 x) (lambda () (dk-ineq! '(< x 0) '(<= 0 x))))
    (rb1-rsc-pos!)))
(rb1-check 'rb1-rpow-scale)
(qed 'rb1-rpow-scale)
(topic! 'rb1-rpow-scale 'plumbing)

;;; Young on the closed quadrant: u, v >= 0 (young-inequality wants u, v > 0)
(define rb1-pq-head
  (lambda (body)
    (list 'FORALL 'p (list 'IMPLIES '(AND (IN p QQ) (< 1 p))
      (list 'FORALL 'q (list 'IMPLIES '(AND (IN q QQ) (< 1 q))
        (list 'IMPLIES '(= (+ (/ 1 p) (/ 1 q)) 1) body)))))))
(sp (make-wff
  (rb1-pq-head
    '(FORALL u (IMPLIES (IN u RR) (IMPLIES (<= 0 u)
       (FORALL v (IMPLIES (IN v RR) (IMPLIES (<= 0 v)
         (<= (* u v) (+ (/ (RPOW u p) p) (/ (RPOW v q) q))))))))))))
(dk-split-all! (dk-peel!))
(fact 'rr-zero-in)
(fact 'qq-subset-rr 'p)
(fact 'qq-subset-rr 'q)
(dk-have! '(< 0 p) (lambda () (dk-ineq! '(< 1 p))))
(dk-have! '(< 0 q) (lambda () (dk-ineq! '(< 1 q))))
(dk-split! (dk-fact! 'rb1-rpow-nn 'u 'p))
(dk-split! (dk-fact! 'rb1-rpow-nn 'v 'q))
(define (rb1-y0-recip! pv)
  (fact 'rr-pos-ne-zero pv)
  (dk-have! (list 'AND (list 'IN pv 'RR) (list 'NOT (list '= pv 0))))
  (fact 'rr-recip-closed pv)
  (fact 'rr-recip-pos pv))
(rb1-y0-recip! 'p)
(rb1-y0-recip! 'q)
(fact 'binary-divide-def '(RPOW u p) 'p)
(fact 'binary-divide-def '(RPOW v q) 'q)
(rb1-type! '(* (RPOW u p) (recip p)))
(rb1-type! '(* (RPOW v q) (recip q)))
(rb1-type! '(* u v))
(dk-have! '(AND (IN (RPOW u p) RR) (IN (recip p) RR)))
(dk-have! '(AND (<= 0 (RPOW u p)) (<= 0 (recip p))) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! '(< 0 (recip p))))))))
(fact 'rr-leq-mul-nonneg '(RPOW u p) '(recip p))
(dk-have! '(AND (IN (RPOW v q) RR) (IN (recip q) RR)))
(dk-have! '(AND (<= 0 (RPOW v q)) (<= 0 (recip q))) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! '(< 0 (recip q))))))))
(fact 'rr-leq-mul-nonneg '(RPOW v q) '(recip q))
(define (rb1-y0-zero! zeq)
  (dk-have! '(= (* u v) 0) (lambda () (subst zeq) (crs)))
  (subst '(== (/ (RPOW u p) p) (* (RPOW u p) (recip p))))
  (subst '(== (/ (RPOW v q) q) (* (RPOW v q) (recip q))))
  (dk-ineq! '(= (* u v) 0) '(<= 0 (* (RPOW u p) (recip p))) '(<= 0 (* (RPOW v q) (recip q)))))
(fact 'rr-lt-trichotomy 0 'u)
(fact 'rr-lt-trichotomy 0 'v)
(use-cases '((< 0 u) (= 0 u) (< u 0))
  (lambda ()
    (use-cases '((< 0 v) (= 0 v) (< v 0))
      (lambda ()
        (dk-have! '(AND (IN u RR) (< 0 u)))
        (dk-have! '(AND (IN v RR) (< 0 v)))
        (dk-have! '(AND (IN p QQ) (< 1 p)))
        (dk-have! '(AND (IN q QQ) (< 1 q)))
        (fact 'young-inequality 'u 'v 'p 'q)
        (ass))
      (lambda () (rb1-y0-zero! '(= v 0)))
      (lambda ()
        (dk-have! '(= v 0) (lambda () (dk-ineq! '(< v 0) '(<= 0 v))))
        (rb1-y0-zero! '(= v 0)))))
  (lambda () (rb1-y0-zero! '(= u 0)))
  (lambda ()
    (dk-have! '(= u 0) (lambda () (dk-ineq! '(< u 0) '(<= 0 u))))
    (rb1-y0-zero! '(= u 0))))
(rb1-check 'rb1-young0)
(qed 'rb1-young0)
(topic! 'rb1-young0 'inequalities)

;;; Young at x/s, y/t, scaled by s t:
;;;   x y <= (s t / (s^p p)) x^p + (s t / (t^q q)) y^q.
(define (rb1-k s t base p) (list '* (list '* (list '* s t) (list 'recip (list 'RPOW base p))) (list 'recip p)))
(sp (make-wff
  (rb1-pq-head
    (list 'FORALL 's (list 'IMPLIES '(IN s RR) (list 'IMPLIES '(< 0 s)
     (list 'FORALL 't (list 'IMPLIES '(IN t RR) (list 'IMPLIES '(< 0 t)
      (list 'FORALL 'x (list 'IMPLIES '(IN x RR) (list 'IMPLIES '(<= 0 x)
       (list 'FORALL 'y (list 'IMPLIES '(IN y RR) (list 'IMPLIES '(<= 0 y)
         (list '<= '(* x y)
               (list '+ (list '* (rb1-k 's 't 's 'p) '(RPOW x p))
                        (list '* (rb1-k 's 't 't 'q) '(RPOW y q)))))))))))))))))))
(dk-split-all! (dk-peel!))
(fact 'rr-zero-in)
(fact 'qq-subset-rr 'p)
(fact 'qq-subset-rr 'q)
(dk-have! '(< 0 p) (lambda () (dk-ineq! '(< 1 p))))
(dk-have! '(< 0 q) (lambda () (dk-ineq! '(< 1 q))))
(rb1-y0-recip! 'p)
(rb1-y0-recip! 'q)
(rb1-y0-recip! 's)
(rb1-y0-recip! 't)
(fact 'rr-recip-inverse 's)
(fact 'rr-recip-inverse 't)
(define rb1-yu '(* x (recip s)))
(define rb1-yv '(* y (recip t)))
(rb1-type! rb1-yu)
(rb1-type! rb1-yv)
(dk-have! (list '<= 0 rb1-yu)
  (lambda ()
    (dk-have! '(AND (IN x RR) (IN (recip s) RR)))
    (dk-have! '(AND (<= 0 x) (<= 0 (recip s))) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! '(< 0 (recip s))))))))
    (fact 'rr-leq-mul-nonneg 'x '(recip s))
    (ass)))
(dk-have! (list '<= 0 rb1-yv)
  (lambda ()
    (dk-have! '(AND (IN y RR) (IN (recip t) RR)))
    (dk-have! '(AND (<= 0 y) (<= 0 (recip t))) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! '(< 0 (recip t))))))))
    (fact 'rr-leq-mul-nonneg 'y '(recip t))
    (ass)))
(dk-have! '(AND (IN p QQ) (< 1 p)))
(dk-have! '(AND (IN q QQ) (< 1 q)))
(define rb1-yg (dk-fact! 'rb1-young0 'p 'q rb1-yu rb1-yv))
(define rb1-yw (caddr rb1-yg))
(define rb1-uv (cadr rb1-yg))
(fact 'rb1-rpow-scale 'x 's 'p)
(fact 'rb1-rpow-scale 'y 't 'q)
(fact 'binary-divide-def (list 'RPOW rb1-yu 'p) 'p)
(fact 'binary-divide-def (list 'RPOW rb1-yv 'q) 'q)
(dk-split! (dk-fact! 'rb1-rpow-nn rb1-yu 'p))
(dk-split! (dk-fact! 'rb1-rpow-nn rb1-yv 'q))
(dk-split! (dk-fact! 'rb1-rpow-nn 'x 'p))
(dk-split! (dk-fact! 'rb1-rpow-nn 'y 'q))
(dk-have! '(AND (IN s RR) (< 0 s)))
(dk-split! (dk-fact! 'rpow-pos 's 'p))
(dk-have! '(AND (IN t RR) (< 0 t)))
(dk-split! (dk-fact! 'rpow-pos 't 'q))
(rb1-y0-recip! '(RPOW s p))
(rb1-y0-recip! '(RPOW t q))
(define rb1-dvu (list '== (list '/ (list 'RPOW rb1-yu 'p) 'p) (list '* (list 'RPOW rb1-yu 'p) '(recip p))))
(define rb1-dvv (list '== (list '/ (list 'RPOW rb1-yv 'q) 'q) (list '* (list 'RPOW rb1-yv 'q) '(recip q))))
(dk-have! (list 'IN rb1-yw 'RR)
  (lambda () (subst rb1-dvu) (subst rb1-dvv) (type-term)))
(rb1-type! '(* s t))
(rb1-type! rb1-uv)
(dk-have! '(<= 0 (* s t)) (lambda () (dk-have! '(AND (IN s RR) (IN t RR)))
                                     (dk-have! '(AND (<= 0 s) (<= 0 t)) (lambda () (dk-conj-close! (lambda () (dk-ineq! '(< 0 s) '(< 0 t))))))
                                     (fact 'rr-leq-mul-nonneg 's 't)
                                     (ass)))
(dk-have! (list 'AND '(<= 0 (* s t)) rb1-yg))
(define rb1-sc (dk-fact! 'rr-le-scale-nonneg '(* s t) rb1-uv rb1-yw))
(define rb1-stuv (cadr rb1-sc))
(define rb1-stw (caddr rb1-sc))
(dk-have! (list '= rb1-stuv '(* x y))
  (lambda ()
    (let ((e (list '= rb1-stuv '(* (* x y) (* (* s (recip s)) (* t (recip t)))))))
      (dk-have! e (lambda () (dk-crs-opaque!)))
      (subst e)
      (subst '(= (* s (recip s)) 1))
      (subst '(= (* t (recip t)) 1))
      (crs))))
(define rb1-yrhs (caddr (dk-goal)))
(dk-have! (list '= rb1-stw rb1-yrhs)
  (lambda ()
    (subst rb1-dvu)
    (subst rb1-dvv)
    (subst (list '= (list 'RPOW rb1-yu 'p) '(* (RPOW x p) (recip (RPOW s p)))))
    (subst (list '= (list 'RPOW rb1-yv 'q) '(* (RPOW y q) (recip (RPOW t q)))))
    (dk-crs-opaque!)))
(subst (list '= '(* x y) rb1-stuv))
(subst (list '= rb1-yrhs rb1-stw))
(ass)
(rb1-check 'rb1-young-scaled)
(qed 'rb1-young-scaled)
(topic! 'rb1-young-scaled 'inequalities)

;;; ---- a term of a nonnegative finite sum is at most the sum ------------
(sp (make-wff
  (list 'FORALL 's (list 'IMPLIES '(IN s SET) (list 'IMPLIES '(IN (CARD s) NN)
   (list 'FORALL 'f
    (list 'IMPLIES '(FORALL z_ (IMPLIES (IN z_ s) (IN (f z_) RR)))
    (list 'IMPLIES '(FORALL z_ (IMPLIES (IN z_ s) (<= 0 (f z_))))
      (list 'AND (list '<= 0 (rb1-fs 'f 's))
        (list 'FORALL 'k_ (list 'IMPLIES '(IN k_ s) (list '<= '(f k_) (rb1-fs 'f 's)))))))))))))
(dk-peel!)
(fact 'cra-ag-rr-is-abelian-group)
(let* ((tf (lambda (z) (list 'IN (list 'f z) 'RR)))
       (tn (lambda (z) (list '<= 0 (list 'f z))))
       (prop-of (lambda (u)
                  (list 'IMPLIES (rb1-ptw u tf)
                    (list 'IMPLIES (rb1-ptw u tn)
                      (list 'AND (list '<= 0 (rb1-fs 'f u))
                        (list 'FORALL 'k_ (list 'IMPLIES (list 'IN 'k_ u)
                                            (list '<= '(f k_) (rb1-fs 'f u)))))))))
       (px (rb1-induct! 's prop-of
             (lambda ()
               (dk-peel!)
               (fact 'rb1-fs-empty 'f)
               (subst (list '= (rb1-fs 'f 'EMPTY-SET) 0))
               (dk-conj-close!
                 (lambda ()
                   (if (dk-head-is? (dk-goal) 'FORALL)
                       (let ((kv (dk-di-var!)))
                         (fact 'empty-set-has-no-members kv)
                         (prop))
                       (dk-ineq!)))))
             (lambda (sv xv u ih)
               (let* ((hs  (dk-peel!))
                      (hfu (rb1-ptw u tf)) (hnu (rb1-ptw u tn)))
                 (rb1-restrict! hfu sv u tf)
                 (rb1-restrict! hnu sv u tn)
                 (let* ((ihc (rb1-detach-all! ih))
                        (ihs (dk-split! ihc))
                        (iha (car (filter (lambda (f) (dk-head-is? f 'FORALL)) ihs)))
                        (fs  (rb1-fs 'f sv)))
                   (rb1-in-union-new! xv u)
                   (inst+ hfu xv) (inst+ hnu xv)
                   (fact 'rb1-fs-ins sv xv 'f)
                   (fact 'rb1-fs-real sv 'f)
                   (subst (list '= (rb1-fs 'f u) (list '+ fs (list 'f xv))))
                   (dk-conj-close!
                     (lambda ()
                       (if (dk-head-is? (dk-goal) 'FORALL)
                           (let ((kv (dk-di-var!)))
                             (fact 'membership-implies-sethood kv u)
                             (inst+ hfu kv)
                             (dk-have! (list 'OR (list 'IN kv sv) (list 'IN kv (list 'PAIR xv xv)))
                               (lambda () (mac-h 'union-membership (list 'IN kv u)) (ass)))
                             (use-cases (list (list 'IN kv sv) (list 'IN kv (list 'PAIR xv xv)))
                               (lambda ()
                                 (inst+ iha kv)
                                 (dk-ineq! (list '<= (list 'f kv) fs) (list '<= 0 (list 'f xv))))
                               (lambda ()
                                 (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
                                 (let ((pm (inst*! (dk-cite! 'pairing-membership xv xv) kv)))
                                   (dk-have! (list '= kv xv)
                                     (lambda () (rb1-keep-prop! pm (list 'IN kv (list 'PAIR xv xv))))))
                                 (subst (list '= kv xv))
                                 (dk-ineq! (list '<= 0 fs)))))
                           (dk-ineq! (list '<= 0 fs) (list '<= 0 (list 'f xv))))))))))))
  (rb1-detach-all! px)
  (ass))
(rb1-check 'rb1-fs-term-le)
(qed 'rb1-fs-term-le)
(topic! 'rb1-fs-term-le 'inequalities)


;;; ---- holder-finite ------------------------------------------------------

;;; forall z in SV. BODY(z), proved by beta and then CLOSER on the eigenvariable
(define (rb1-ptw-by! sv body-of fns closer)
  (let ((claim (rb1-ptw sv body-of)))
    (dk-have! claim
      (lambda ()
        (let ((zv (dk-di-var!)))
          (for-each (lambda (fv) (fact 'fun-apply-type-c fv sv 'RR zv)) fns)
          (if (not (dk-lam-b!)) (closer zv)))))
    claim))

;;; (IN LAM (FUN SV RR)) by lam-t; CLOSER types the body at the eigenvariable
(define (rb1-fun! sv lam fns closer)
  (dk-have! (list 'IN lam (list 'FUN sv 'RR))
    (lambda ()
      (for-each (lambda (n)
                  (dk-focus! n)
                  (if (equal? (dk-goal) (list 'IN sv 'SET))
                      (ass)
                      (let* ((landed (dk-peel!)) (iv (cadr (car landed))))
                        (for-each (lambda (fv) (fact 'fun-apply-type-c fv sv 'RR iv)) fns)
                        (closer iv))))
                (dk-opened (lambda () (lam-t)))))))

;;; |x| in RR and 0 <= |x|
(define (rb1-abs-typed! x)
  (if (not (dk-asm? (list 'IN (list 'abs x) 'RR))) (fact 'rr-abs-closed x))
  (if (not (dk-asm? (list '<= 0 (list 'abs x)))) (fact 'rr-abs-nonneg x)))
;;; |x|^r in RR and >= 0 ((IN r QQ), (< 0 r) in context)
(define (rb1-rpow-abs! x r)
  (rb1-abs-typed! x)
  (if (not (dk-asm? (list 'IN (list 'RPOW (list 'abs x) r) 'RR)))
      (dk-split! (dk-fact! 'rb1-rpow-nn (list 'abs x) r))))

;;; the exponent facts: p real, positive, nonzero; recip p; 1/p in QQ, RR,
;;; positive; 1/p = 1 * recip p; (1/p) p = 1
(define (rb1-h-exp! pv ip)
  (fact 'qq-subset-rr pv)
  (dk-have! (list '< 0 pv) (lambda () (dk-ineq! (list '< 1 pv))))
  (fact 'rr-pos-ne-zero pv)
  (dk-have! (list 'AND (list 'IN pv 'RR) (list 'NOT (list '= pv 0))))
  (fact 'rr-recip-closed pv)
  (fact 'rr-recip-pos pv)
  (fact 'rr-recip-inverse pv)
  (dk-have! (list 'AND (list 'IN pv 'QQ) (list 'NOT (list '= pv 0))))
  (fact 'qq-recip-closed pv)
  (fact 'binary-divide-def 1 pv)
  (let ((dv (list '== ip (list '* 1 (list 'recip pv)))))
    (dk-have! (list 'IN ip 'QQ) (lambda () (subst dv) (type-term)))
    (fact 'qq-subset-rr ip)
    (dk-have! (list '< 0 ip) (lambda () (subst dv) (dk-ineq! (list '< 0 (list 'recip pv)))))
    (dk-have! (list '= (list '* ip pv) 1)
      (lambda ()
        (subst dv)
        (let ((e (list '= (list '* (list '* 1 (list 'recip pv)) pv) (list '* pv (list 'recip pv)))))
          (dk-have! e (lambda () (dk-crs-opaque!)))
          (subst e))
        (subst (list '= (list '* pv (list 'recip pv)) 1))
        (dk-ineq!)))))

(sp (make-wff
  '(FORALL S (IMPLIES (AND (IN S SET) (IN (CARD S) NN))
     (FORALL a (IMPLIES (IN a (FUN S RR)) (FORALL b (IMPLIES (IN b (FUN S RR))
       (FORALL p (IMPLIES (AND (IN p QQ) (< 1 p)) (FORALL q (IMPLIES (AND (IN q QQ) (< 1 q))
         (IMPLIES (= (+ (/ 1 p) (/ 1 q)) 1)
           (<= (FINSUM (COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD)
                       (VNB-LAMBDA i S (abs (* (a i) (b i)))) S)
               (* (RPOW (FINSUM (COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD)
                                (VNB-LAMBDA i S (RPOW (abs (a i)) p)) S) (/ 1 p))
                  (RPOW (FINSUM (COMMUTATIVE-RING-ADDITIVE-AG RR-NORMED-FIELD)
                                (VNB-LAMBDA i S (RPOW (abs (b i)) q)) S) (/ 1 q)))))))))))))))))
(rb1-open!)
(fact 'cra-ag-rr-is-abelian-group)
(fact 'rr-zero-in)
(fact 'rr-one-in)
(fact 'qq-one-in)
(let* ((g   (dk-goal))
       (fl  (cadr g))
       (ll  (caddr fl)) (sv (cadddr fl))
       (rhs (caddr g))
       (sx  (cadr rhs)) (ty (caddr rhs))
       (fx  (cadr sx)) (ip (caddr sx)) (pv (caddr ip))
       (fy  (cadr ty)) (iq (caddr ty)) (qv (caddr iq))
       (lx  (caddr fx)) (ly (caddr fy))
       (av  (car (cadr (cadr (cadddr lx)))))
       (bv  (car (cadr (cadr (cadddr ly)))))
       (fns (list av bv))
       (conj (list '= (list '+ ip iq) 1)))
  (if (not (dk-asm? conj)) (error "rb1-holder: the conjugacy hypothesis is not in context"))
  (rb1-h-exp! pv ip)
  (rb1-h-exp! qv iq)
  (dk-have! (list 'AND (list 'IN pv 'QQ) (list '< 1 pv)))
  (dk-have! (list 'AND (list 'IN qv 'QQ) (list '< 1 qv)))
  ;; pointwise typings of the three families
  (let* ((rl (rb1-ptw-by! sv (lambda (z) (list 'IN (list ll z) 'RR)) fns
               (lambda (zv)
                 (let ((ab (list '* (list av zv) (list bv zv))))
                   (rb1-type! ab) (fact 'rr-abs-closed ab) (ass)))))
         (rx (rb1-ptw-by! sv (lambda (z) (list 'IN (list lx z) 'RR)) fns
               (lambda (zv) (rb1-rpow-abs! (list av zv) pv) (ass))))
         (ry (rb1-ptw-by! sv (lambda (z) (list 'IN (list ly z) 'RR)) fns
               (lambda (zv) (rb1-rpow-abs! (list bv zv) qv) (ass)))))
    (rb1-ptw-by! sv (lambda (z) (list '<= 0 (list lx z))) fns
      (lambda (zv) (rb1-rpow-abs! (list av zv) pv) (ass)))
    (rb1-ptw-by! sv (lambda (z) (list '<= 0 (list ly z))) fns
      (lambda (zv) (rb1-rpow-abs! (list bv zv) qv) (ass)))
    (fact 'rb1-fs-real sv ll)
    (fact 'rb1-fs-real sv lx)
    (fact 'rb1-fs-real sv ly)
    (let* ((tx  (dk-split! (dk-fact! 'rb1-fs-term-le sv lx)))
           (tlx (car (filter (lambda (f) (dk-head-is? f 'FORALL)) tx)))
           (tyl (dk-split! (dk-fact! 'rb1-fs-term-le sv ly)))
           (tly (car (filter (lambda (f) (dk-head-is? f 'FORALL)) tyl))))
      ;; s = X^(1/p), t = Y^(1/q), named
      (dk-split! (dk-fact! 'rb1-rpow-nn fx ip))
      (dk-split! (dk-fact! 'rb1-rpow-nn fy iq))
      (let* ((sn (dk-name! sx))
             (tn (dk-name! ty))
             (st (list '* sn tn)))
        (subst (list '= sx sn))
        (subst (list '= ty tn))
        (dk-have! (list '<= 0 sn) (lambda () (dk-ineq! (list '<= 0 sx) (list '= sn sx))))
        (dk-have! (list '<= 0 tn) (lambda () (dk-ineq! (list '<= 0 ty) (list '= tn ty))))
        (rb1-type! st)
        (dk-have! (list '<= 0 st)
          (lambda ()
            (dk-have! (list 'AND (list 'IN sn 'RR) (list 'IN tn 'RR)))
            (dk-have! (list 'AND (list '<= 0 sn) (list '<= 0 tn)))
            (fact 'rr-leq-mul-nonneg sn tn)
            (ass)))
        (let ()
        ;; ---- one of the sums is 0: the left side is 0 ----
        (define (zero-case! fz lz fz-sum r tl rz zeq)
          (rb1-ptw-by! sv (lambda (z) (list '= (list ll z) (rb1-lin-rhs 0 0 (list ll z) (list ll z)))) fns
            (lambda (zv)
              (let* ((fzv (list fz zv)) (az (list av zv)) (bz (list bv zv))
                     (rp  (list 'RPOW (list 'abs fzv) r)))
                (inst+ tl zv)
                (inst+ rz zv)
                (rb1-rpow-abs! fzv r)
                (dk-have! (list '= (list lz zv) rp)
                  (lambda () (if (not (dk-lam-b!)) (rfl))))
                (dk-have! (list '= rp 0)
                  (lambda () (dk-ineq! (list '<= (list lz zv) fz-sum) (list '= (list lz zv) rp)
                                       zeq (list '<= 0 rp))))
                (fact 'rb1-rpow-zero (list 'abs fzv) r)
                (dk-have! (list 'AND (list 'IN az 'RR) (list 'IN bz 'RR)))
                (fact 'rr-abs-mult az bz)
                (subst (list '= (list 'abs (list '* az bz)) (list '* (list 'abs az) (list 'abs bz))))
                (subst (list '= (list 'abs fzv) 0))
                (rb1-abs-typed! az)
                (rb1-abs-typed! bz)
                (crs))))
          (let ((lin (dk-fact! 'rb1-fs-lin sv 0 0 ll ll ll)))
            (dk-ineq! lin (list '<= 0 st))))
        ;; ---- both sums positive ----
        (define (pos-case!)
          (dk-have! (list 'AND (list 'IN fx 'RR) (list '< 0 fx)))
          (dk-have! (list 'AND (list 'IN fy 'RR) (list '< 0 fy)))
          (dk-split! (dk-fact! 'rpow-pos fx ip))
          (dk-split! (dk-fact! 'rpow-pos fy iq))
          (dk-have! (list '< 0 sn) (lambda () (dk-ineq! (list '< 0 sx) (list '= sn sx))))
          (dk-have! (list '< 0 tn) (lambda () (dk-ineq! (list '< 0 ty) (list '= tn ty))))
          (fact 'rpow-pow fx ip pv)
          (fact 'rpow-one fx)
          (fact 'rpow-pow fy iq qv)
          (fact 'rpow-one fy)
          (let ((psn (list 'RPOW sn pv)) (qtn (list 'RPOW tn qv)))
            (dk-have! (list '= psn fx)
              (lambda ()
                (subst (list '= sn sx))
                (subst (list '= (list 'RPOW sx pv) (list 'RPOW fx (list '* ip pv))))
                (subst (list '= (list '* ip pv) 1))
                (subst (list '= (list 'RPOW fx 1) fx))
                (rfl)))
            (dk-have! (list '= qtn fy)
              (lambda ()
                (subst (list '= tn ty))
                (subst (list '= (list 'RPOW ty qv) (list 'RPOW fy (list '* iq qv))))
                (subst (list '= (list '* iq qv) 1))
                (subst (list '= (list 'RPOW fy 1) fy))
                (rfl)))
            (dk-have! (list 'AND (list 'IN sn 'RR) (list '< 0 sn)))
            (dk-split! (dk-fact! 'rpow-pos sn pv))
            (dk-have! (list 'AND (list 'IN tn 'RR) (list '< 0 tn)))
            (dk-split! (dk-fact! 'rpow-pos tn qv))
            (rb1-y0-recip! psn)
            (rb1-y0-recip! qtn)
            (fact 'rr-recip-inverse psn)
            (fact 'rr-recip-inverse qtn)
            (let* ((k1 (rb1-k sn tn sn pv))
                   (k2 (rb1-k sn tn tn qv)))
              (rb1-type! k1)
              (rb1-type! k2)
              (let* ((k1n (dk-name! k1))
                     (k2n (dk-name! k2))
                     (lr  (list 'VNB-LAMBDA 'rbw_ sv
                                (list '+ (list '* k1n (list 'RPOW (list 'abs (list av 'rbw_)) pv))
                                         (list '* k2n (list 'RPOW (list 'abs (list bv 'rbw_)) qv)))))
                     (fr  (rb1-fs lr sv)))
                (rb1-ptw-by! sv (lambda (z) (list 'IN (list lr z) 'RR)) fns
                  (lambda (zv)
                    (rb1-rpow-abs! (list av zv) pv)
                    (rb1-rpow-abs! (list bv zv) qv)
                    (type-term)))
                ;; termwise: |a b| <= K1 |a|^p + K2 |b|^q
                (rb1-ptw-by! sv (lambda (z) (list '<= (list ll z) (list lr z))) fns
                  (lambda (zv)
                    (let ((az (list av zv)) (bz (list bv zv)))
                      (rb1-rpow-abs! az pv)
                      (rb1-rpow-abs! bz qv)
                      (fact 'rb1-young-scaled pv qv sn tn (list 'abs az) (list 'abs bz))
                      (dk-have! (list 'AND (list 'IN az 'RR) (list 'IN bz 'RR)))
                      (fact 'rr-abs-mult az bz)
                      (subst (list '= (list 'abs (list '* az bz)) (list '* (list 'abs az) (list 'abs bz))))
                      (subst (list '= k1n k1))
                      (subst (list '= k2n k2))
                      (ass))))
                (rb1-fun! sv ll fns
                  (lambda (iv)
                    (let ((ab (list '* (list av iv) (list bv iv))))
                      (rb1-type! ab) (fact 'rr-abs-closed ab) (ass))))
                (rb1-fun! sv lr fns
                  (lambda (iv)
                    (rb1-rpow-abs! (list av iv) pv)
                    (rb1-rpow-abs! (list bv iv) qv)
                    (type-term)))
                (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'CARD sv) 'NN)))
                (let* ((le  (dk-fact! 'finsum-le-termwise sv ll lr))
                       (peq (rb1-ptw-by! sv (lambda (z) (list '= (list lr z) (rb1-lin-rhs k1n k2n (list lx z) (list ly z)))) fns
                              (lambda (zv)
                                (rb1-rpow-abs! (list av zv) pv)
                                (rb1-rpow-abs! (list bv zv) qv)
                                (crs))))
                       (lin (dk-fact! 'rb1-fs-lin sv k1n k2n lx ly lr)))
                  (fact 'rb1-fs-real sv lr)
                  (dk-have! (list '= fr st)
                    (lambda ()
                      (subst lin)
                      (subst (list '= k1n k1))
                      (subst (list '= k2n k2))
                      (subst (list '= fx psn))
                      (subst (list '= fy qtn))
                      (let ((ea (list '= (list '+ (list '* k1 psn) (list '* k2 qtn))
                                      (list '* st
                                            (list '+ (list '* (list '* psn (list 'recip psn)) (list 'recip pv))
                                                     (list '* (list '* qtn (list 'recip qtn)) (list 'recip qv)))))))
                        (dk-have! ea (lambda () (dk-crs-opaque!)))
                        (subst ea))
                      (subst (list '= (list '* psn (list 'recip psn)) 1))
                      (subst (list '= (list '* qtn (list 'recip qtn)) 1))
                      (subst (list '= (list '* 1 (list 'recip pv)) ip))
                      (subst (list '= (list '* 1 (list 'recip qv)) iq))
                      (subst conj)
                      (crs)))
                  (dk-ineq! le (list '= fr st)))))))
        (fact 'rr-lt-trichotomy 0 fx)
        (fact 'rr-lt-trichotomy 0 fy)
        (use-cases (list (list '< 0 fx) (list '= 0 fx) (list '< fx 0))
          (lambda ()
            (use-cases (list (list '< 0 fy) (list '= 0 fy) (list '< fy 0))
              pos-case!
              (lambda () (zero-case! bv ly fy qv tly ry (list '= 0 fy)))
              (lambda ()
