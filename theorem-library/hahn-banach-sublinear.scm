                   (list 'AND (list 'IN '(NTH 1 hgw_) hbs-GRD) (list 'AND (list 'IN '(NTH 2 hgw_) hbs-GRD)
                     '(FORALL hgx_ (IMPLIES (IN hgx_ (VEC m)) (<= ((NTH 2 hgw_) hgx_) ((NTH 1 hgw_) hgx_))))))))
(define (hbs-below a b) ; a <= b pointwise
