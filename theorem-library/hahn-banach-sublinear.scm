      (if (not (dk-lam-b!)) (ass)))))
(dk-have! (list 'FORALL 'hix_ (list 'IMPLIES '(IN hix_ (VEC m)) (list 'FORSOME 'hib_ (list 'AND '(IN hib_ RR)
            (list 'FORALL 'hij_ (list 'IMPLIES '(IN hij_ ch) (list '<= 'hib_ (list hbs-chain-phi 'hix_ 'hij_))))))))
  (lambda ()
