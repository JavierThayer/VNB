;;; ---- the reduction p0(x) = inf_{z in s} p(x + z) - f(z) ----
(define (hbs-rb x z) (list '- (list 'p (list '(VADD m) x z)) (list 'f z)))
(define hbs-red-phi (list 'VNB-LAMBDA '(LIST hx_ hz_) '(CARTESIAN (VEC m) s) (hbs-rb 'hx_ 'hz_)))
(define hbs-fle '(FORALL z_ (IMPLIES (IN z_ s) (<= (f z_) (p z_)))))
(define (hbs-red-hyps body)
  (hbs-mod (list 'FORALL 'p (list 'IMPLIES '(IS-SUBLINEAR m p) (list 'FORALL 's (list 'IMPLIES '(IS-SUBMODULE m s)
    (list 'FORALL 'f (list 'IMPLIES '(IS-LINEAR-FUNCTIONAL-ON m s f) (list 'IMPLIES hbs-fle body)))))))))
(define hbs-red-lb
  (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ s) (list '<= '(pz x_) (hbs-rb 'x_ 'z_)))))))
(define hbs-red-glb
  (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list 'FORALL 'b_ (list 'IMPLIES '(IN b_ RR)
    (list 'IMPLIES (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ s) (list '<= 'b_ (hbs-rb 'x_ 'z_))))
          '(<= b_ (pz x_))))))))
(define (hbs-red-ant b x)
  (let ((v (dk--fresh-binder '(hza_ hzb_ hzc_) (list b x) "hbs-red-ant")))
    (list 'FORALL v (list 'IMPLIES (list 'IN v 's) (list '<= b (hbs-rb x v))))))
;;; x in VEC m, z in s in context: the value is a real
(define (hbs-red-typ! x z)
  (dk-cite! 'hbs-sub-vec 'm 's z)
  (dk-cite! 'module-vadd-type 'm x z)
  (dk-cite! 'hbs-sl-val 'm 'p (list '(VADD m) x z))
  (dk-cite! 'hbs-lf-val 'm 's 'f z)
  (dk-cite! 'rr-sub-in-rr (list 'p (list '(VADD m) x z)) (list 'f z)))

(sp (make-wff (hbs-red-hyps (list 'FORSOME 'pz (hbs-conj! '(IN pz (FUN (VEC m) RR)) hbs-red-lb hbs-red-glb)))))
(dk-peel!)
(hbs-vec-set!)
(hbs-m1!)
(dk-cite! 'submodule-vzero-in 'm 's)
(dk-have! '(FORALL hix_ (IMPLIES (IN hix_ (VEC m)) (FORSOME hi0_ (IN hi0_ s))))
  (lambda () (dk-di-var!) (ew '(VZERO m)) (ass)))
(dk-have! (list 'FORALL 'hix_ (list 'IMPLIES '(IN hix_ (VEC m)) (list 'FORALL 'hij_ (list 'IMPLIES '(IN hij_ s)
            (list 'IN (list hbs-red-phi 'hix_ 'hij_) 'RR)))))
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (x (cadr (cadr g))) (j (caddr (cadr g))))
      (hbs-red-typ! x j)
      (if (not (dk-lam-b!)) (ass)))))
(dk-have! (list 'FORALL 'hix_ (list 'IMPLIES '(IN hix_ (VEC m)) (list 'FORSOME 'hib_ (list 'AND '(IN hib_ RR)
            (list 'FORALL 'hij_ (list 'IMPLIES '(IN hij_ s) (list '<= 'hib_ (list hbs-red-phi 'hix_ 'hij_))))))))
  (lambda ()
    (let* ((x (dk-di-var!)) (mx (list '(ACT m) hbs-m1 x)))
      (dk-cite! 'hbs-act-in 'm hbs-m1 x)
      (dk-cite! 'hbs-sl-val 'm 'p mx)
      (dk-cite! 'rr-neg-closed (list 'p mx))
      (ew (list '- (list 'p mx)))
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
            (let* ((j (dk-di-var!)) (xz (list '(VADD m) x j)))
              (hbs-red-typ! x j)
              (if (not (dk-lam-b!))
                (begin
                  (let ((h (dk-cite! 'hbs-sl-sub 'm 'p xz mx)))
                    (dk-cite! 'hbs-cancel-l 'm x j)
                    (dk-rewrite-h! h (list '(VADD m) xz mx) j))
                  (dk-cite! 'hbs-sl-val 'm 'p j)
                  (hbs-apply! (dk-ctx-form hbs-fle) j)
                  (dk-ineq! (list '<= (list 'p j) (list '+ (list 'p xz) (list 'p mx)))
                            (list '<= (list 'f j) (list 'p j))
                            (list 'IN (list 'p j) 'RR) (list 'IN (list 'p xz) 'RR) (list 'IN (list 'p mx) 'RR)
                            (list 'IN (list 'f j) 'RR)))))))))))
(let* ((r (dk-skolem! (dk-cite! 'hbs-inf-family-c '(VEC m) 's hbs-red-phi)))
       (r-lb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r) (not (dk-contains? f 'hib_)))) "LB"))
       (r-glb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r) (dk-contains? f 'hib_))) "GLB")))
  (ew r)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (ass))
              ((dk-contains? g 'b_)
               (hbs-read-glb! r-glb 's (lambda (j) #t) hbs-red-phi))
              (#t
               (set! hbs-lb-index (lambda (g) (cadr (caddr (caddr g)))))
               (hbs-read-lb! r-lb (lambda (j) #t))))))))
(hbs-qed! 'hbs-red-exists)

;;; the reduction is sublinear, below p, and below f on s
(sp (make-wff (hbs-red-hyps (list 'FORALL 'pz (list 'IMPLIES '(IN pz (FUN (VEC m) RR)) (list 'IMPLIES hbs-red-lb (list 'IMPLIES hbs-red-glb
  (hbs-conj! '(IS-SUBLINEAR m pz)
             '(FORALL x_ (IMPLIES (IN x_ (VEC m)) (<= (pz x_) (p x_))))
             '(FORALL z_ (IMPLIES (IN z_ s) (<= (pz z_) (f z_))))))))))))
(dk-peel!)
(hbs-m1!)
(dk-cite! 'rr-zero-in)
(dk-cite! 'module-vzero-in 'm)
(dk-cite! 'submodule-vzero-in 'm 's)
(dk-cite! 'hbs-sl-zero 'm 'p)
(dk-cite! 'hbs-lf-zero 'm 's 'f)
(dk-cite! 'hbs-lf-val 'm 's 'f '(VZERO m))
(dk-cite! 'hbs-sl-val 'm 'p '(VZERO m))
(define (hbs-pz-lb!) (dk-ctx-form hbs-red-lb))
(define (hbs-pz-glb!) (dk-ctx-form hbs-red-glb))
;;; pz <= p: the clause at z = 0
(define (hbs-pz-le-p! x)
  (hbs-red-typ! x '(VZERO m))
  (hbs-val! 'pz x)
  (dk-cite! 'hbs-sl-val 'm 'p x)
  (let ((h (hbs-apply! (hbs-pz-lb!) x '(VZERO m))))
    (dk-cite! 'hbs-vzero-r 'm x)
    (let ((h1 (dk-rewrite-h! h (list '(VADD m) x '(VZERO m)) x)))
      (dk-have! (list '<= (list 'pz x) (list 'p x))
        (lambda () (dk-ineq! h1 '(= (f (VZERO m)) 0) (list 'IN (list 'pz x) 'RR) (list 'IN (list 'p x) 'RR)
                             '(IN (f (VZERO m)) RR)))))))
(dk-have! '(FORALL x_ (IMPLIES (IN x_ (VEC m)) (<= (pz x_) (p x_))))
  (lambda () (let ((x (dk-di-var!))) (hbs-pz-le-p! x))))
;;; pz <= f on s: the clause at x = z, z = (-1).z
(dk-have! '(FORALL z_ (IMPLIES (IN z_ s) (<= (pz z_) (f z_))))
  (lambda ()
    (let* ((z (dk-di-var!)) (mz (list '(ACT m) hbs-m1 z)))
      (dk-cite! 'hbs-sub-vec 'm 's z)
