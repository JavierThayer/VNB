            (let ((x (dk-di-var!)))
              (hbs-val! r x) (dk-cite! 'hbs-sl-val 'm mx x) (hbs-val! 'pz x)
              (hbs-apply! (dk-ctx-form (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list '<= (list r 'x_) (list mx 'x_))))) x)
              (hbs-pt-le! mx 'pz x)
              (dk-ineq! (list '<= (list r x) (list mx x)) (list '<= (list mx x) (list 'pz x))
                        (list 'IN (list r x) 'RR) (list 'IN (list mx x) 'RR) (list 'IN (list 'pz x) 'RR)))))
        (dk-cite! 'hbs-grd-in 'm 'pz r)
        (dk-have! (hbs-below r mx)
          (lambda () (let ((x (dk-di-var!)))
                       (hbs-apply! (dk-ctx-form (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list '<= (list r 'x_) (list mx 'x_))))) x) (ass))))
        (dk-cite! 'hbs-porel-in 'm 'pz mx r)
        (hbs-apply! maxl r)
        (hbs-porel-parts! r mx)
        (dk-cite! 'hbs-act-in 'm hbs-m1 y)
        (hbs-pt-le! mx r my)
        (hbs-val! r my) (dk-cite! 'hbs-sl-val 'm mx my) (dk-cite! 'hbs-sl-val 'm mx y)
        (dk-ineq! (list '<= (list mx my) (list r my)) (list '<= (list r my) (list '- (list mx y)))
                  (list 'IN (list r my) 'RR) (list 'IN (list mx my) 'RR) (list 'IN (list mx y) 'RR)))))
  (dk-cite! 'hbs-sl-odd-linear 'm mx)
  (ew mx)
  (dk-conj-close! (lambda () (ass))))
(hbs-qed! 'hbs-dominated-linear)

;;; =====================================================================
;;; (F) HAHN-BANACH, SUBLINEAR FORM.  A real vector space m, p sublinear on m,
;;;     s a submodule, f linear on s with f <= p there: f extends to a linear ff on
;;;     the whole space with ff <= p.
;;; =====================================================================
(sp (make-wff (hbs-red-hyps
  '(FORSOME ff (AND (IS-LINEAR-FUNCTIONAL-ON m (VEC m) ff)
                    (AND (EXTENDS-ON s ff f)
                         (FORALL x_ (IMPLIES (IN x_ (VEC m)) (<= (ff x_) (p x_))))))))))
(dk-peel!)
(hbs-m1!)
(let* ((pz (dk-skolem! (dk-cite! 'hbs-red-exists 'm 'p 's 'f))))
  (dk-split-all! (list (dk-cite! 'hbs-red-props 'm 'p 's 'f pz)))
  (let* ((ff (dk-skolem! (dk-cite! 'hbs-dominated-linear 'm pz)))
         (ff-le (dk-ctx-form (hbs-below ff pz)))
         (pz-le (dk-ctx-form (hbs-below pz 'p)))
         (pz-f (dk-ctx-form (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ s) (list '<= (list pz 'z_) '(f z_)))))))
    (dk-cite! 'hbs-sl-fun 'm pz)
    (dk-cite! 'hbs-lf-fun 'm '(VEC m) ff)
    (ew ff)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((dk-asm? g) (ass))
            ((dk-head-is? g 'EXTENDS-ON)
             (mac 'extends-on)
             (let* ((z (dk-di-var!)) (mz (list '(ACT m) hbs-m1 z)))
               (dk-cite! 'hbs-sub-vec 'm 's z)
               (dk-cite! 'hbs-sub-act 'm 's hbs-m1 z)
               (dk-cite! 'hbs-sub-vec 'm 's mz)
               (for-each (lambda (v) (hbs-val! ff v) (hbs-val! pz v) (dk-cite! 'hbs-lf-val 'm 's 'f v)) (list z mz))
               (for-each (lambda (v) (hbs-apply! ff-le v) (hbs-apply! pz-f v)) (list z mz))
               (dk-cite! 'hbs-lf-hom 'm '(VEC m) ff hbs-m1 z)
               (dk-cite! 'hbs-lf-hom 'm 's 'f hbs-m1 z)
               (let ((typs (list (list 'IN (list ff z) 'RR) (list 'IN (list ff mz) 'RR) (list 'IN (list pz z) 'RR)
                                 (list 'IN (list pz mz) 'RR) (list 'IN (list 'f z) 'RR) (list 'IN (list 'f mz) 'RR))))
                 (hbs-antisym! (list ff z) (list 'f z)
                   (lambda () (apply dk-ineq! (append (list (list '<= (list ff z) (list pz z)) (list '<= (list pz z) (list 'f z))) typs)))
                   (lambda () (apply dk-ineq! (append (list (list '<= (list ff mz) (list pz mz)) (list '<= (list pz mz) (list 'f mz))
                                                            (list '= (list ff mz) (list '* hbs-m1 (list ff z)))
                                                            (list '= (list 'f mz) (list '* hbs-m1 (list 'f z))))
                                                      typs)))))))
            (#t
             (let ((x (dk-di-var!)))
               (hbs-val! ff x) (hbs-val! pz x) (dk-cite! 'hbs-sl-val 'm 'p x)
               (hbs-apply! ff-le x) (hbs-apply! pz-le x)
               (dk-ineq! (list '<= (list ff x) (list pz x)) (list '<= (list pz x) (list 'p x))
                         (list 'IN (list ff x) 'RR) (list 'IN (list pz x) 'RR) (list 'IN (list 'p x) 'RR))))))))))
(hbs-qed! 'hbs-hahn-banach-sublinear)

;;; =====================================================================
;;; (G) COROLLARY: hahn-banach-seminorm at fld = RR-NORMED-FIELD.  |f| <= p on s
;;;     gives f <= p; the extension ff <= p of (F) satisfies -ff(x) = ff((-1).x)
;;;     <= p((-1).x) = p(x), so |ff| <= p.  The K-linear vocabulary is read through
;;;     SCAL(m) = the real ring view (hbs-carr, hbs-add-eq, hbs-mul-eq).
;;; =====================================================================
(define hbs-FN '(FNRM RR-NORMED-FIELD))
(sp (make-wff (hbs-fa 't_ 'RR (list '= (list hbs-FN 't_) '(abs t_)))))
(dk-peel!)
(slot 'FNRM)
(quietly (lambda () (surface-goal! 'RR-NORMED-FIELD)))
(if (dk-contains? (dk-goal) 'NTH) (nth-r))
(if (not (dk-lam-b!)) (rfl))
(hbs-qed! 'hbs-rr-fnrm)

(sp (make-wff '(FORALL m (FORALL p (FORALL s (FORALL f
  (IMPLIES (IS-MODULE m) (IMPLIES (= (SCAL m) (NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
  (IMPLIES (IS-SEMINORM RR-NORMED-FIELD m p) (IMPLIES (IS-SUBMODULE m s) (IMPLIES (IS-K-LINEAR-ON m s f)
  (IMPLIES (FORALL x (IMPLIES (IN x s) (<= ((FNRM RR-NORMED-FIELD) (f x)) (p x))))
    (FORSOME ff (AND (IS-K-LINEAR m ff)
                     (AND (EXTENDS-ON s ff f)
                          (FORALL x (IMPLIES (IN x (VEC m)) (<= ((FNRM RR-NORMED-FIELD) (ff x)) (p x)))))))))))))))))))
(dk-peel!)
(hbs-m1!)
(dk-cite! 'hbs-carr 'm)
;;; the seminorm's parts, each read off on a lane
(define (hbs-semi-part! claim)
  (dk-have! claim
    (lambda () (mac-h 'is-seminorm (dk-ctx-form '(IS-SEMINORM RR-NORMED-FIELD m p))) (dk-split-all!) (ass))))
(define hbs-semi-hom '(FORALL lam (IMPLIES (IN lam (CARR (SCAL m))) (FORALL x (IMPLIES (IN x (VEC m))
                         (= (p ((ACT m) lam x)) (* ((FNRM RR-NORMED-FIELD) lam) (p x))))))))
(define hbs-p-subadd (subst-free 'q 'p hbs-subadd))
(hbs-semi-part! hbs-semi-hom)
(hbs-semi-part! '(IN p (FUN (VEC m) RR)))
(hbs-semi-part! hbs-p-subadd)
;;; p is sublinear: |t| = t for t >= 0
(dk-have! '(IS-SUBLINEAR m p)
  (lambda ()
    (mac 'is-sublinear)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
          (begin
            (dk-peel!)
            (let* ((g (dk-goal)) (tx (cadr (cadr g))) (t (cadr tx)) (x (caddr tx)))
              (dk-cite! 'hbs-in-carr 'm t)
              (hbs-apply! (dk-ctx-form hbs-semi-hom) t x)
              (dk-cite! 'hbs-rr-fnrm t)
              (dk-cite! 'rr-abs-of-nonneg t)
              (subst (list '= (list 'p tx) (list '* (list hbs-FN t) (list 'p x))))
              (subst (list '= (list hbs-FN t) (list 'abs t)))
              (subst (list '= (list 'abs t) t))
              (dk-cite! 'fun-apply-type-c 'p '(VEC m) 'RR x)
              (rfl))))))))
;;; f is a real linear functional on s, below p there
(define (hbs-klin-part! claim)
  (dk-have! claim
    (lambda () (mac-h 'is-k-linear-on (dk-ctx-form '(IS-K-LINEAR-ON m s f))) (dk-split-all!) (ass))))
(hbs-klin-part! '(IN f (FUN s (CARR (SCAL m)))))
(hbs-klin-part! '(FORALL x (IMPLIES (IN x s) (FORALL y (IMPLIES (IN y s) (= (f ((VADD m) x y)) ((ADD (SCAL m)) (f x) (f y))))))))
(hbs-klin-part! '(FORALL lam (IMPLIES (IN lam (CARR (SCAL m))) (FORALL x (IMPLIES (IN x s) (= (f ((ACT m) lam x)) ((MUL (SCAL m)) lam (f x))))))))
(dk-rewrite-h! (dk-ctx-form '(IN f (FUN s (CARR (SCAL m))))) '(CARR (SCAL m)) 'RR)
(define (hbs-fv! x) (dk-cite! 'fun-apply-type-c 'f 's 'RR x))
(dk-have! '(IS-LINEAR-FUNCTIONAL-ON m s f)
  (lambda ()
    (mac 'is-linear-functional-on)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (ass)
          (begin
            (dk-peel!)
            (let* ((g (dk-goal)) (app (cadr (cadr g))))
              (if (equal? (car app) '(VADD m))
                  (let ((x (cadr app)) (y (caddr app)))
                    (dk-cite! 'submodule-vadd-closed 'm 's x y)
                    (hbs-fv! x) (hbs-fv! y)
                    (hbs-apply! (dk-ctx-form '(FORALL x (IMPLIES (IN x s) (FORALL y (IMPLIES (IN y s) (= (f ((VADD m) x y)) ((ADD (SCAL m)) (f x) (f y)))))))) x y)
                    (dk-cite! 'hbs-add-eq 'm (list 'f x) (list 'f y))
                    (subst (list '= (list '+ (list 'f x) (list 'f y)) (list '(ADD (SCAL m)) (list 'f x) (list 'f y))))
                    (ass))
                  (let ((r (cadr app)) (x (caddr app)))
                    (dk-cite! 'hbs-in-carr 'm r)
                    (hbs-fv! x)
                    (hbs-apply! (dk-ctx-form '(FORALL lam (IMPLIES (IN lam (CARR (SCAL m))) (FORALL x (IMPLIES (IN x s) (= (f ((ACT m) lam x)) ((MUL (SCAL m)) lam (f x)))))))) r x)
                    (dk-cite! 'hbs-mul-eq 'm r (list 'f x))
                    (subst (list '= (list '* r (list 'f x)) (list '(MUL (SCAL m)) r (list 'f x))))
                    (ass))))))))))
(dk-have! '(FORALL z_ (IMPLIES (IN z_ s) (<= (f z_) (p z_))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (hbs-fv! z)
      (dk-cite! 'hbs-sub-vec 'm 's z)
      (dk-cite! 'fun-apply-type-c 'p '(VEC m) 'RR z)
      (hbs-apply! (dk-ctx-form '(FORALL x (IMPLIES (IN x s) (<= ((FNRM RR-NORMED-FIELD) (f x)) (p x))))) z)
      (dk-cite! 'hbs-rr-fnrm (list 'f z))
      (dk-have! (list '<= (list 'abs (list 'f z)) (list 'p z))
        (lambda () (subst (list '= (list 'abs (list 'f z)) (list hbs-FN (list 'f z)))) (ass)))
      (dk-cite! 'rr-le-abs (list 'f z))
      (dk-ineq! (list '<= (list 'abs (list 'f z)) (list 'p z))
                (list '<= (list 'f z) (list 'abs (list 'f z))) (list 'IN (list 'f z) 'RR) (list 'IN (list 'p z) 'RR)))))
;;; |-1| = 1 and p((-1).x) = p(x)
(dk-have! '(<= (- 1) 0) (lambda () (dk-ineq!)))
(dk-cite! 'rr-abs-of-nonpos hbs-m1)
(dk-cite! 'hbs-in-carr 'm hbs-m1)
(dk-cite! 'hbs-rr-fnrm hbs-m1)
(define hbs-c1l (dk-landed (lambda () (ai (dk-cite! 'hbs-hahn-banach-sublinear 'm 'p 's 'f)))))
(dk-split-all! hbs-c1l)
(define hbs-sr-ff (cadddr (cadr (car hbs-c1l))))
(dk-cite! 'hbs-lf-fun 'm '(VEC m) hbs-sr-ff)
;;; ff is K-linear
(dk-have! (list 'IS-K-LINEAR 'm hbs-sr-ff)
  (lambda ()
    (mac 'is-k-linear)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)) (ff hbs-sr-ff))
          (cond
            ((dk-asm? g) (ass))
            ((dk-head-is? g 'IN) (subst '(= (CARR (SCAL m)) RR)) (ass))
            (#t
             (dk-peel!)
             (let* ((g (dk-goal)) (app (cadr (cadr g))))
               (if (equal? (car app) '(VADD m))
                   (let ((x (cadr app)) (y (caddr app)))
                     (dk-cite! 'hbs-lf-val 'm '(VEC m) ff x) (dk-cite! 'hbs-lf-val 'm '(VEC m) ff y)
                     (dk-cite! 'hbs-lf-add 'm '(VEC m) ff x y)
                     (dk-cite! 'hbs-add-eq 'm (list ff x) (list ff y))
                     (subst (list '= (list '(ADD (SCAL m)) (list ff x) (list ff y)) (list '+ (list ff x) (list ff y))))
                     (ass))
                   (let ((r (cadr app)) (x (caddr app)))
                     (dk-have! (list 'IN r 'RR) (lambda () (subst '(= RR (CARR (SCAL m)))) (ass)))
                     (dk-cite! 'hbs-lf-val 'm '(VEC m) ff x)
                     (dk-cite! 'hbs-lf-hom 'm '(VEC m) ff r x)
                     (dk-cite! 'hbs-mul-eq 'm r (list ff x))
                     (subst (list '= (list '(MUL (SCAL m)) r (list ff x)) (list '* r (list ff x))))
                     (ass)))))))))))
;;; |ff| <= p
(dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC m)) (list '<= (list hbs-FN (list hbs-sr-ff 'x)) '(p x))))
  (lambda ()
    (let* ((ff hbs-sr-ff)
           (x (dk-di-var!)) (mx (list '(ACT m) hbs-m1 x))
           (ff-le (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ff) (dk-contains? f 'p)
                                            (not (dk-contains? f 'FNRM)))) "ff <= p")))
      (dk-cite! 'hbs-act-in 'm hbs-m1 x)
      (dk-cite! 'hbs-lf-val 'm '(VEC m) ff x) (dk-cite! 'hbs-lf-val 'm '(VEC m) ff mx)
      (dk-cite! 'fun-apply-type-c 'p '(VEC m) 'RR x) (dk-cite! 'fun-apply-type-c 'p '(VEC m) 'RR mx)
      (hbs-apply! ff-le x) (hbs-apply! ff-le mx)
      (dk-cite! 'hbs-lf-hom 'm '(VEC m) ff hbs-m1 x)
      (hbs-apply! (dk-ctx-form hbs-semi-hom) hbs-m1 x)
      (dk-have! (list '= (list 'p mx) (list 'p x))
        (lambda ()
          (subst (list '= (list 'p mx) (list '* (list hbs-FN hbs-m1) (list 'p x))))
          (subst (list '= (list hbs-FN hbs-m1) (list 'abs hbs-m1)))
          (subst (list '= (list 'abs hbs-m1) (list '- hbs-m1)))
          (crs)))
      (dk-cite! 'hbs-rr-fnrm (list ff x))
      (subst (list '= (list hbs-FN (list ff x)) (list 'abs (list ff x))))
      (let ((typs (list (list 'IN (list ff x) 'RR) (list 'IN (list ff mx) 'RR) (list 'IN (list 'p x) 'RR)
                        (list 'IN (list 'p mx) 'RR))))
        (dk-have! (list '<= (list '- (list 'p x)) (list ff x))
          (lambda () (apply dk-ineq! (append (list (list '<= (list ff mx) (list 'p mx))
                                                   (list '= (list ff mx) (list '* hbs-m1 (list ff x)))
                                                   (list '= (list 'p mx) (list 'p x)))
                                             typs))))
        (dk-have! (list '<= (list ff x) (list 'p x)) (lambda () (ass)))
        (let ((iff (dk-cite! 'rr-abs-bound (list ff x) (list 'p x))))
          (hbs-prop! iff (list '<= (list '- (list 'p x)) (list ff x)) (list '<= (list ff x) (list 'p x))))))))
(ew hbs-sr-ff)
(dk-conj-close! (lambda () (ass)))
(hbs-qed! 'hahn-banach-seminorm-rr)
