;;; theorem-library/hahn-banach-sublinear.scm -- HAHN-BANACH FOR A SUBLINEAR
;;; FUNCTIONAL on a real vector space (RM-3A, 2026-10-10).  Prefix hbs-.
;;;
;;; THE THEOREM (hbs-hahn-banach-sublinear).  m a module with SCAL(m) =
;;; NORMED-FIELD-AS-COMMUTATIVE-RING(RR-NORMED-FIELD) (a real vector space, the pin
;;; of seminorm-hahn-banach.scm and IS-NORMED-VECTOR-SPACE), p sublinear on m
;;; (IS-SUBLINEAR, structure-library/hahn-banach-sublinear.scm), s a submodule, f a
;;; real linear functional on s (IS-LINEAR-FUNCTIONAL-ON) with f <= p on s.  Then
;;; some ff, linear on VEC(m), extends f and satisfies ff <= p everywhere.
;;; COROLLARY (hahn-banach-seminorm-rr): the asserted support hahn-banach-seminorm
;;; at fld = RR-NORMED-FIELD, proven.  The support itself is untouched.
;;;
;;; THE ROUTE is Zorn on SUBLINEAR functionals, not on partial extensions:
;;;  (B) the tree has SUP and no INF; hbs-inf-family builds, for any family of
;;;      reals phi(x, i), i in IDX(x), bounded below and inhabited, a function r on
;;;      the domain with  r(x) <= phi(x, i)  and the greatest-lower-bound clause.
;;;  (D) three infima are sublinear: the TILT  inf_{t>=0} q(x + t.y) - t q(y)
;;;      (below q, and r((-1).y) <= -q(y)); the REDUCTION  inf_{z in s} p(x+z) - f(z)
;;;      (below p, below f on s); the infimum of a nonempty CHAIN.  Each property is
;;;      proven from the two clauses only (two greatest-lower-bound steps for
;;;      subadditivity; homogeneity from above with 1/t, hbs-sl-intro-pos).
;;;  (E) Zorn (zorn-lemma) on the sublinear q <= p0 ordered "pointwise below": a
;;;      chain's infimum (or p0, for the empty chain) bounds it; a MINIMAL q equals
;;;      its tilt, so q((-1).y) <= -q(y), and a sublinear q odd from above is linear
;;;      (hbs-sl-odd-linear).
;;;  (F) a linear F <= p0 = the reduction is <= p, and F = f on s.
;;; Nothing here uses the one-dimension step or SPAN-ADD-ONE.
;;;
;;; LOAD WINDOW: [after theorem-library/module-zero-act, end), with
;;; structure-library/hahn-banach-sublinear immediately before this file.  The
;;; latest citations: module-zero-act (module-zero-act), zorn-lemma (zorn-route-two),
;;; IS-SEMINORM / IS-K-LINEAR(-ON) (seminorm-hahn-banach), rr-recip-pos
;;; (rr-recip-order), rr-le-scale-nonneg-right (rr-order-bundle), subset-mem-fwd
;;; (subset-lemmas), pair-in-cartesian (pair-tuple-sethood), rr-abs-* (rr-abs-basics),
;;; the scalar read-offs (normed-field-ring-view).  Natural slot: right after
;;; theorem-library/hahn-banach-full-proof.  Citer: theorem-library/positive-extension.
;;; Library: analysis.  No late tactic, no top-level macro (compilable).
;;; Every theorem is `proven modulo 0' (oracles ineq, crs, arith).

(define hbs-R '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
(define hbs-pin '(= (SCAL m) (NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD)))
(define (hbs-mod body) (list 'FORALL 'm (list 'IMPLIES '(IS-MODULE m) (list 'IMPLIES hbs-pin body))))
(define (hbs-mod1 body) (list 'FORALL 'm (list 'IMPLIES '(IS-MODULE m) body)))
(define (hbs-va a b) (list '(VADD m) a b))
(define (hbs-ac r x) (list '(ACT m) r x))
(define (hbs-fa v dom body) (list 'FORALL v (list 'IMPLIES (list 'IN v dom) body)))

;;; dk-apply! that tolerates an instance already in context (then returns it)
(define (hbs-apply! f . terms)
  (let loop ((g (->raw-formula f)) (ts terms))
    (cond ((and (pair? g) (eq? (car g) 'FORALL) (pair? ts))
           (loop (subst-free (cadr g) (car ts) (caddr g)) (cdr ts)))
          ((and (null? ts) (pair? g) (eq? (car g) 'IMPLIES) (dk-asm? (cadr g)))
           (loop (caddr g) ts))
          ((and (null? ts) (dk-ctx-form g)) => (lambda (h) h))
          (#t (apply dk-apply! f terms)))))

(define (hbs-qed! name)
  (if (not (proof-done? *ps*))
      (error "hahn-banach-sublinear: proof did not close" name (expression->string (dk-goal))))
  (qed name)
  (topic! name 'analysis))

(define (hbs-prop! . keepers) (if (apply dk-only! keepers) (prop)))

;;; =====================================================================
;;; (A) A REAL MODULE: the scalar slots read as reals, the module laws at real scalars
;;; =====================================================================

(sp (make-wff (hbs-mod '(= (CARR (SCAL m)) RR))))
(dk-peel!)
(subst hbs-pin)
(mac 'rr-scalar-ring-carr)
(rfl)
(hbs-qed! 'hbs-carr)

(sp (make-wff (hbs-mod (hbs-fa 'r_ 'RR '(IN r_ (CARR (SCAL m)))))))
(dk-peel!)
(dk-cite! 'hbs-carr 'm)
(subst '(= (CARR (SCAL m)) RR))
(ass)
(hbs-qed! 'hbs-in-carr)

(define (hbs-scalar-eq! name thm lhs rhs)
  (sp (make-wff (hbs-mod (hbs-fa 'r_ 'RR (hbs-fa 's_ 'RR (list '= lhs rhs))))))
  (dk-peel!)
  (subst hbs-pin)
  (mac thm)
  (if (not (dk-lam-b!)) (rfl))
  (hbs-qed! name))

(hbs-scalar-eq! 'hbs-add-eq 'rr-scalar-ring-add '((ADD (SCAL m)) r_ s_) '(+ r_ s_))
(hbs-scalar-eq! 'hbs-mul-eq 'rr-scalar-ring-mul '((MUL (SCAL m)) r_ s_) '(* r_ s_))

(sp (make-wff (hbs-mod '(= (ONE (SCAL m)) 1))))
(dk-peel!)
(subst hbs-pin)
(mac 'rr-scalar-ring-one)
(rfl)
(hbs-qed! 'hbs-one-eq)

(sp (make-wff (hbs-mod '(= (ZERO (SCAL m)) 0))))
(dk-peel!)
(subst hbs-pin)
(mac 'rr-scalar-ring-zero)
(rfl)
(hbs-qed! 'hbs-zero-eq)

(sp (make-wff (hbs-mod (hbs-fa 'r_ 'RR (hbs-fa 'x_ '(VEC m) '(IN ((ACT m) r_ x_) (VEC m)))))))
(dk-peel!)
(dk-cite! 'hbs-in-carr 'm 'r_)
(dk-cite! 'module-act-type 'm 'r_ 'x_)
(ass)
(hbs-qed! 'hbs-act-in)

(sp (make-wff (hbs-mod (hbs-fa 'r_ 'RR (hbs-fa 's_ 'RR (hbs-fa 'x_ '(VEC m)
  '(= ((ACT m) (+ r_ s_) x_) ((VADD m) ((ACT m) r_ x_) ((ACT m) s_ x_)))))))))
(dk-peel!)
(dk-cite! 'hbs-in-carr 'm 'r_)
(dk-cite! 'hbs-in-carr 'm 's_)
(dk-cite! 'hbs-add-eq 'm 'r_ 's_)
(dk-cite! 'module-act-distrib-scalar 'm 'r_ 's_ 'x_)
(subst '(= (+ r_ s_) ((ADD (SCAL m)) r_ s_)))
(ass)
(hbs-qed! 'hbs-act-add)

(sp (make-wff (hbs-mod (hbs-fa 'r_ 'RR (hbs-fa 's_ 'RR (hbs-fa 'x_ '(VEC m)
  '(= ((ACT m) (* r_ s_) x_) ((ACT m) r_ ((ACT m) s_ x_)))))))))
(dk-peel!)
(dk-cite! 'hbs-in-carr 'm 'r_)
(dk-cite! 'hbs-in-carr 'm 's_)
(dk-cite! 'hbs-mul-eq 'm 'r_ 's_)
(dk-cite! 'module-act-mul-compat 'm 'r_ 's_ 'x_)
(subst '(= (* r_ s_) ((MUL (SCAL m)) r_ s_)))
(ass)
(hbs-qed! 'hbs-act-mul)

(sp (make-wff (hbs-mod (hbs-fa 'x_ '(VEC m) '(= ((ACT m) 1 x_) x_)))))
(dk-peel!)
(dk-cite! 'hbs-one-eq 'm)
(dk-cite! 'module-act-unital 'm 'x_)
(subst '(= 1 (ONE (SCAL m))))
(ass)
(hbs-qed! 'hbs-act-one)

(sp (make-wff (hbs-mod (hbs-fa 'x_ '(VEC m) '(= ((ACT m) 0 x_) (VZERO m))))))
(dk-peel!)
(dk-cite! 'hbs-zero-eq 'm)
(dk-cite! 'module-zero-act 'm)
(dk-cite! 'module-zero-act 'm 'x_)
(subst '(= 0 (ZERO (SCAL m))))
(ass)
(hbs-qed! 'hbs-act-zero)

(sp (make-wff (hbs-mod (hbs-fa 'r_ 'RR (hbs-fa 'x_ '(VEC m) (hbs-fa 'y_ '(VEC m)
  '(= ((ACT m) r_ ((VADD m) x_ y_)) ((VADD m) ((ACT m) r_ x_) ((ACT m) r_ y_)))))))))
(dk-peel!)
(dk-cite! 'hbs-in-carr 'm 'r_)
(dk-cite! 'module-act-distrib-vec 'm 'r_ 'x_ 'y_)
(ass)
(hbs-qed! 'hbs-act-vadd)

;;; ---- the vector group, read off the IS-MODULE unfold ----
(define (hbs-module-law! prop)
  (dk-project! prop 'is-module '(IS-MODULE m)))

(sp (make-wff (hbs-mod1 (hbs-fa 'x_ '(VEC m) (hbs-fa 'y_ '(VEC m) (hbs-fa 'z_ '(VEC m)
  '(= ((VADD m) ((VADD m) x_ y_) z_) ((VADD m) x_ ((VADD m) y_ z_)))))))))
(dk-peel!)
(let* ((h (hbs-module-law! '(IS-ASSOCIATIVE (VADD m) (VEC m))))
       (u (dk-landed-1 (lambda () (mac-h 'is-associative h)))))
  (dk-apply! u 'x_ 'y_ 'z_))
(ass)
(hbs-qed! 'hbs-vadd-assoc)

(sp (make-wff (hbs-mod1 (hbs-fa 'x_ '(VEC m) (hbs-fa 'y_ '(VEC m)
  '(= ((VADD m) x_ y_) ((VADD m) y_ x_)))))))
(dk-peel!)
(let* ((h (hbs-module-law! '(IS-COMMUTATIVE (VADD m) (VEC m))))
       (u (dk-landed-1 (lambda () (mac-h 'is-commutative h)))))
  (dk-apply! u 'x_ 'y_))
(ass)
(hbs-qed! 'hbs-vadd-comm)

(sp (make-wff (hbs-mod1 (hbs-fa 'x_ '(VEC m)
  '(AND (= ((VADD m) (VZERO m) x_) x_) (= ((VADD m) x_ (VZERO m)) x_))))))
(dk-peel!)
(let* ((h (hbs-module-law! '(IS-IDENTITY (VADD m) (VZERO m) (VEC m))))
       (u (dk-landed-1 (lambda () (mac-h 'is-identity h)))))
  (dk-apply! u 'x_))
(ass)
(hbs-qed! 'hbs-vzero-lr)

(sp (make-wff (hbs-mod1 (hbs-fa 'x_ '(VEC m) '(= ((VADD m) x_ (VZERO m)) x_)))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'hbs-vzero-lr 'm 'x_)))
(ass)
(hbs-qed! 'hbs-vzero-r)

(sp (make-wff (hbs-mod1 (hbs-fa 'x_ '(VEC m) '(= ((VADD m) (VZERO m) x_) x_)))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'hbs-vzero-lr 'm 'x_)))
(ass)
(hbs-qed! 'hbs-vzero-l)


;;; ---- cancellation by (-1).x ----
(define (hbs-m1!)
  (dk-cite! 'rr-one-in)
  (dk-cite! 'rr-neg-closed 1))

(define hbs-m1 '(- 1))

(sp (make-wff (hbs-mod (hbs-fa 'x_ '(VEC m) '(= ((VADD m) x_ ((ACT m) (- 1) x_)) (VZERO m))))))
(dk-peel!)
(hbs-m1!)
(dk-cite! 'hbs-act-in 'm hbs-m1 'x_)
(dk-cite! 'hbs-act-in 'm 1 'x_)
(dk-cite! 'module-vzero-in 'm)
(let ((e1 (dk-cite! 'hbs-act-add 'm 1 hbs-m1 'x_)))
  (dk-cite! 'hbs-act-one 'm 'x_)
  (dk-rewrite-h! e1 '((ACT m) 1 x_) 'x_))
(dk-have! '(= (+ 1 (- 1)) 0) (lambda () (arith)))
(dk-cite! 'hbs-act-zero 'm 'x_)
(subst '(= ((VADD m) x_ ((ACT m) (- 1) x_)) ((ACT m) (+ 1 (- 1)) x_)))
(subst '(= (+ 1 (- 1)) 0))
(ass)
(hbs-qed! 'hbs-neg-cancel)

(sp (make-wff (hbs-mod (hbs-fa 'x_ '(VEC m) '(= ((VADD m) ((ACT m) (- 1) x_) x_) (VZERO m))))))
(dk-peel!)
(hbs-m1!)
(dk-cite! 'hbs-act-in 'm hbs-m1 'x_)
(dk-cite! 'hbs-vadd-comm 'm '((ACT m) (- 1) x_) 'x_)
(dk-cite! 'hbs-neg-cancel 'm 'x_)
(subst '(= ((VADD m) ((ACT m) (- 1) x_) x_) ((VADD m) x_ ((ACT m) (- 1) x_))))
(ass)
(hbs-qed! 'hbs-neg-cancel-l)

;;; (x + y) + (-1).y = x
(sp (make-wff (hbs-mod (hbs-fa 'x_ '(VEC m) (hbs-fa 'y_ '(VEC m)
  '(= ((VADD m) ((VADD m) x_ y_) ((ACT m) (- 1) y_)) x_))))))
(dk-peel!)
(hbs-m1!)
(dk-cite! 'hbs-act-in 'm hbs-m1 'y_)
(dk-cite! 'hbs-vadd-assoc 'm 'x_ 'y_ '((ACT m) (- 1) y_))
(dk-cite! 'hbs-neg-cancel 'm 'y_)
(dk-cite! 'hbs-vzero-r 'm 'x_)
(subst '(= ((VADD m) ((VADD m) x_ y_) ((ACT m) (- 1) y_)) ((VADD m) x_ ((VADD m) y_ ((ACT m) (- 1) y_)))))
(subst '(= ((VADD m) y_ ((ACT m) (- 1) y_)) (VZERO m)))
(ass)
(hbs-qed! 'hbs-cancel-r)

;;; (x + y) + (-1).x = y
(sp (make-wff (hbs-mod (hbs-fa 'x_ '(VEC m) (hbs-fa 'y_ '(VEC m)
  '(= ((VADD m) ((VADD m) x_ y_) ((ACT m) (- 1) x_)) y_))))))
(dk-peel!)
(dk-cite! 'hbs-vadd-comm 'm 'x_ 'y_)
(dk-cite! 'hbs-cancel-r 'm 'y_ 'x_)
(subst '(= ((VADD m) x_ y_) ((VADD m) y_ x_)))
(ass)
(hbs-qed! 'hbs-cancel-l)

;;; (a + b) + (c + d) = (a + c) + (b + d)
(sp (make-wff (hbs-mod1 (hbs-fa 'a_ '(VEC m) (hbs-fa 'b_ '(VEC m) (hbs-fa 'c_ '(VEC m) (hbs-fa 'd_ '(VEC m)
  '(= ((VADD m) ((VADD m) a_ b_) ((VADD m) c_ d_)) ((VADD m) ((VADD m) a_ c_) ((VADD m) b_ d_))))))))))
(dk-peel!)
(dk-cite! 'module-vadd-type 'm 'c_ 'd_)
(dk-cite! 'module-vadd-type 'm 'b_ 'd_)
(dk-cite! 'module-vadd-type 'm 'b_ 'c_)
(dk-cite! 'module-vadd-type 'm 'c_ 'b_)
(dk-cite! 'hbs-vadd-assoc 'm 'a_ 'b_ '((VADD m) c_ d_))
(subst '(= ((VADD m) ((VADD m) a_ b_) ((VADD m) c_ d_)) ((VADD m) a_ ((VADD m) b_ ((VADD m) c_ d_)))))
(dk-cite! 'hbs-vadd-assoc 'm 'b_ 'c_ 'd_)
(subst '(= ((VADD m) b_ ((VADD m) c_ d_)) ((VADD m) ((VADD m) b_ c_) d_)))
(dk-cite! 'hbs-vadd-comm 'm 'b_ 'c_)
(subst '(= ((VADD m) b_ c_) ((VADD m) c_ b_)))
(dk-cite! 'hbs-vadd-assoc 'm 'c_ 'b_ 'd_)
(subst '(= ((VADD m) ((VADD m) c_ b_) d_) ((VADD m) c_ ((VADD m) b_ d_))))
(dk-cite! 'hbs-vadd-assoc 'm 'a_ 'c_ '((VADD m) b_ d_))
(subst '(= ((VADD m) a_ ((VADD m) c_ ((VADD m) b_ d_))) ((VADD m) ((VADD m) a_ c_) ((VADD m) b_ d_))))
(rfl)
(hbs-qed! 'hbs-interchange)

;;; =====================================================================
;;; (B) THE GREATEST LOWER BOUND OF A FAMILY OF REALS, AS A FUNCTION.
;;;     The tree has SUP (order completeness) and no INF: the infimum of the
;;;     values phi(x, i), i in iif(x), is -(SUP of their negatives).  Only its
;;;     two characterising properties leave this section.
;;; =====================================================================

(define hbs-BX '(SEP hiw_ RR (FORSOME hik_ (AND (IN hik_ ii) (= hiw_ (- (phi x hik_)))))))
(define hbs-NS (list '- (list 'SUP hbs-BX)))

;;; (IN (- (phi x j)) BX), with (IN j ii) and (IN (phi x j) RR) in context
(define (hbs-in-bx! j)
  (let ((v (list 'phi 'x j)))
    (dk-cite! 'rr-neg-closed v)
    (dk-have! (list 'IN (list '- v) hbs-BX)
      (lambda ()
        (hbs-sep-in! j)))))

;;; sep-mi on the focus, each opened leaf closed by hbs-close-witness!
(define (hbs-sep-in! j)
  (for-each (lambda (l)
              (if (not (sequent-node-grounded? l))
                  (begin (dk-focus! l) (hbs-close-witness! j))))
            (dk-opened (lambda () (sep-mi)))))

;;; close a sep-mi leaf: the domain typing from context, the FORSOME condition by its witness
(define (hbs-close-witness! j)
  (if (dk-asm? (dk-goal)) (ass)
      (begin (ew j)
             (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))))))

;;; (RR-UPPER-BOUND BX (- b)), with (IN b RR) and b a lower bound of the phi x j in context
(define (hbs-ub! b lb)
  (dk-cite! 'rr-neg-closed b)
  (dk-have! (list 'RR-UPPER-BOUND hbs-BX (list '- b))
    (lambda ()
      (mac 'rr-upper-bound)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (let* ((w (dk-di-var!))
                     (h (dk-ctx-form (list 'IN w hbs-BX)))
                     (parts (dk-landed (lambda () (sep-me h))))
                     (ex (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts))
                     (k (dk-skolem! ex)))
                (dk-apply! (dk-ctx-form '(FORALL hij_ (IMPLIES (IN hij_ ii) (IN (phi x hij_) RR)))) k)
                (dk-apply! lb k)
                (dk-ineq! (list '= w (list '- (list 'phi 'x k)))
                          (list '<= b (list 'phi 'x k))
                          (list 'IN (list 'phi 'x k) 'RR) (list 'IN b 'RR)))))))))

(sp (make-wff
  (list 'FORALL 'ii (list 'FORALL 'phi (list 'FORALL 'x
   (list 'IMPLIES '(FORSOME hi0_ (IN hi0_ ii))
   (list 'IMPLIES '(FORALL hij_ (IMPLIES (IN hij_ ii) (IN (phi x hij_) RR)))
   (list 'IMPLIES '(FORSOME hib_ (AND (IN hib_ RR) (FORALL hij_ (IMPLIES (IN hij_ ii) (<= hib_ (phi x hij_))))))
    (list 'AND (list 'IN hbs-NS 'RR)
     (list 'AND (list 'FORALL 'hij_ (list 'IMPLIES '(IN hij_ ii) (list '<= hbs-NS '(phi x hij_))))
       (list 'FORALL 'hib_ (list 'IMPLIES '(IN hib_ RR)
          (list 'IMPLIES '(FORALL hij_ (IMPLIES (IN hij_ ii) (<= hib_ (phi x hij_))))
                (list '<= 'hib_ hbs-NS))))))))))))))
(dk-peel!)
(define hbs-TY '(FORALL hij_ (IMPLIES (IN hij_ ii) (IN (phi x hij_) RR))))
(dk-have! (list 'SUBSET hbs-BX 'RR)
  (lambda ()
    (mac 'subset-def)
    (let* ((w (dk-di-var!))
           (parts (dk-landed (lambda () (sep-me (dk-ctx-form (list 'IN w hbs-BX)))))))
      (ass))))
(dk-have! (list 'FORSOME 'hiw_ (list 'IN 'hiw_ hbs-BX))
  (lambda ()
    (let ((i0 (dk-skolem! (dk-ctx-form '(FORSOME hi0_ (IN hi0_ ii))))))
      (dk-apply! (dk-ctx-form hbs-TY) i0)
      (hbs-in-bx! i0)
      (ew (list '- (list 'phi 'x i0)))
      (ass))))
(dk-have! (list 'RR-BOUNDED-ABOVE hbs-BX)
  (lambda ()
    (let* ((ex (dk-ctx-form '(FORSOME hib_ (AND (IN hib_ RR) (FORALL hij_ (IMPLIES (IN hij_ ii) (<= hib_ (phi x hij_))))))))
           (b0 (dk-skolem! ex 'top)))
      (hbs-ub! b0 (dk-ctx-form (list 'FORALL 'hij_ (list 'IMPLIES '(IN hij_ ii) (list '<= b0 '(phi x hij_))))))
      (mac 'rr-bounded-above)
      (ew (list '- b0))
      (ass))))
(define hbs-sup (list 'SUP hbs-BX))
(dk-cite! 'rr-sup-in hbs-BX)
(define hbs-supub (dk-cite! 'rr-sup-upper hbs-BX))
(define hbs-supleast (dk-cite! 'rr-sup-least hbs-BX))
(dk-cite! 'rr-neg-closed hbs-sup)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ((dk-contains? g 'hib_)
         (let* ((b (dk-di-var!))
                (lb (dk-landed-1 (lambda () (di)))))
           (hbs-ub! b lb)
           (dk-apply! hbs-supleast (list '- b))
           (dk-ineq! (list '<= hbs-sup (list '- b)) (list 'IN hbs-sup 'RR) (list 'IN b 'RR))))
        (#t
         (let ((j (dk-di-var!)))
           (dk-apply! (dk-ctx-form hbs-TY) j)
           (hbs-in-bx! j)
           (let* ((parts (dk-split-all! (dk-landed (lambda () (mac-h 'rr-upper-bound hbs-supub)))))
                  (u (find-first (lambda (f) (dk-head-is? f 'FORALL)) parts)))
             (dk-apply! u (list '- (list 'phi 'x j))))
           (dk-ineq! (list '<= (list '- (list 'phi 'x j)) hbs-sup)
                     (list 'IN hbs-sup 'RR) (list 'IN (list 'phi 'x j) 'RR))))))))
(hbs-qed! 'hbs-inf-point)

;;; the family version: a function r on dd whose value at x is the infimum of the
;;; phi(x, i), i in IDX(x).  Two theorems from one driver: IDX(x) = iif(x) (the
;;; index set may depend on x: hbs-inf-family) and IDX(x) = ii (hbs-inf-family-c).
(define (hbs-fam! name ivar idx)
  (let* ((BXv (list 'SEP 'hiw_ 'RR (list 'FORSOME 'hik_ (list 'AND (list 'IN 'hik_ (idx 'hiv_)) '(= hiw_ (- (phi hiv_ hik_)))))))
         (LAM (list 'VNB-LAMBDA 'hiv_ 'dd (list '- (list 'SUP BXv))))
         (H2 (list 'FORALL 'hix_ (list 'IMPLIES '(IN hix_ dd) (list 'FORSOME 'hi0_ (list 'IN 'hi0_ (idx 'hix_))))))
         (H3 (list 'FORALL 'hix_ (list 'IMPLIES '(IN hix_ dd) (list 'FORALL 'hij_ (list 'IMPLIES (list 'IN 'hij_ (idx 'hix_)) '(IN (phi hix_ hij_) RR))))))
         (H4 (list 'FORALL 'hix_ (list 'IMPLIES '(IN hix_ dd) (list 'FORSOME 'hib_ (list 'AND '(IN hib_ RR)
               (list 'FORALL 'hij_ (list 'IMPLIES (list 'IN 'hij_ (idx 'hix_)) '(<= hib_ (phi hix_ hij_)))))))))
         (LB (lambda (r) (list 'FORALL 'hix_ (list 'IMPLIES '(IN hix_ dd) (list 'FORALL 'hij_ (list 'IMPLIES (list 'IN 'hij_ (idx 'hix_)) (list '<= (list r 'hix_) '(phi hix_ hij_))))))))
         (GLB (lambda (r) (list 'FORALL 'hix_ (list 'IMPLIES '(IN hix_ dd) (list 'FORALL 'hib_ (list 'IMPLIES '(IN hib_ RR)
                (list 'IMPLIES (list 'FORALL 'hij_ (list 'IMPLIES (list 'IN 'hij_ (idx 'hix_)) '(<= hib_ (phi hix_ hij_))))
                      (list '<= 'hib_ (list r 'hix_)))))))))
         (concl (lambda (r) (list 'AND (list 'IN r '(FUN dd RR)) (list 'AND (LB r) (GLB r))))))
    (sp (make-wff
      (list 'FORALL 'dd (list 'FORALL ivar (list 'FORALL 'phi
       (list 'IMPLIES '(IN dd SET)
       (list 'IMPLIES H2
       (list 'IMPLIES H3
       (list 'IMPLIES H4
         (list 'FORSOME 'hir_ (concl 'hir_)))))))))))
    (dk-peel!)
    (let ((point! (lambda (v)
                    (let ((i0 (dk-skolem! (dk-apply! (dk-ctx-form H2) v))))
                      (dk-have! (list 'FORSOME 'hi0_ (list 'IN 'hi0_ (idx v)))
                        (lambda () (ew i0) (ass)))
                      (dk-apply! (dk-ctx-form H3) v)
                      (dk-apply! (dk-ctx-form H4) v)
                      (dk-split-all! (list (dk-cite! 'hbs-inf-point (idx v) 'phi v)))))))
      (dk-have! (list 'IN LAM '(FUN dd RR))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let ((v (dk-di-var!)))
                (point! v)
                (ass))))))
      (dk-have! (LB LAM)
        (lambda ()
          (dk-peel!)
          (let* ((g (dk-goal)) (v (cadr (cadr g))) (j (caddr (caddr g))))
            (point! v)
            (dk-lam-b!)
            (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'SUP) (not (dk-contains? f 'hib_))))
                                "the lower-bound clause") j)
            (ass))))
      (dk-have! (GLB LAM)
        (lambda ()
          (dk-peel!)
          (let* ((g (dk-goal)) (b (cadr g)) (v (cadr (caddr g))))
            (point! v)
            (dk-lam-b!)
            (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'SUP) (dk-contains? f 'hib_)))
                                "the greatest-lower-bound clause") b)
            (ass))))
      (ew LAM)
      (dk-conj-close! (lambda () (ass)))
      (hbs-qed! name))))

(hbs-fam! 'hbs-inf-family 'iif (lambda (x) (list 'iif x)))
(hbs-fam! 'hbs-inf-family-c 'ii (lambda (x) 'ii))

;;; =====================================================================
;;; (C) REAL ARITHMETIC BRICKS, and the laws of a sublinear functional
;;; =====================================================================

;;; split the disjunction ORF in context; run LEFT on the leaf holding its left
;;; disjunct, RIGHT on the other
(define (hbs-cases! orf left right)
  (let ((ls (dk-opened (lambda () (ai (dk-ctx-form orf))))))
    (for-each (lambda (l)
                (if (not (sequent-node-grounded? l))
                    (begin (dk-focus! l)
                           (if (dk-asm? (cadr orf)) (left) (right)))))
              ls)))

;;; x = y from x <= y and y <= x (each closed by its thunk), both typed RR in context
(define (hbs-antisym! x y le1 le2)
  (dk-have! (list '<= x y) le1)
  (dk-have! (list '<= y x) le2)
  (dk-have! (list 'AND (list 'IN x 'RR) (list 'IN y 'RR))
    (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (in-rr))))))
  (dk-have! (list 'AND (list '<= x y) (list '<= y x)) (lambda () (dk-conj-close! (lambda () (ass)))))
  (dk-cite! 'rr-leq-antisymmetric x y)
  (ass))

;;; every positive real has a positive inverse
(sp (make-wff '(FORALL t_ (IMPLIES (IN t_ RR) (IMPLIES (< 0 t_)
   (FORSOME u_ (AND (IN u_ RR) (AND (< 0 u_) (= (* t_ u_) 1)))))))))
(dk-peel!)
(dk-have! '(NOT (= t_ 0))
  (lambda ()
    (di)
    (dk-absurd! '(< 0 t_) '(= t_ 0) '(IN t_ RR))))
(dk-have! '(AND (IN t_ RR) (NOT (= t_ 0))) (lambda () (dk-conj-close! (lambda () (ass)))))
(dk-cite! 'rr-recip-closed 't_)
(dk-cite! 'rr-recip-inverse 't_)
(dk-cite! 'rr-recip-pos 't_)
(ew '(recip t_))
(dk-conj-close! (lambda () (ass)))
(hbs-qed! 'hbs-pos-inv)

;;; t u = 1 lets a product by t be undone: (t a) u = a
(define (hbs-undo! t u a)
  (dk-have! (list '= (list '* (list '* t a) u) a)
    (lambda ()
      (dk-have! (list '= (list '* (list '* t a) u) (list '* (list '* t u) a)) (lambda () (crs)))
      (subst (list '= (list '* (list '* t a) u) (list '* (list '* t u) a)))
      (subst (list '= (list '* t u) 1))
      (crs))))

;;; from c <= t a with t, u > 0, t u = 1:  u c <= a
(sp (make-wff '(FORALL t_ (IMPLIES (IN t_ RR) (FORALL u_ (IMPLIES (IN u_ RR) (FORALL c_ (IMPLIES (IN c_ RR) (FORALL a_ (IMPLIES (IN a_ RR)
   (IMPLIES (< 0 t_) (IMPLIES (< 0 u_) (IMPLIES (= (* t_ u_) 1) (IMPLIES (<= c_ (* t_ a_)) (<= (* u_ c_) a_)))))))))))))))
(dk-peel!)
(dk-cite! 'rr-mul-in-rr 't_ 'a_)
(dk-cite! 'rr-mul-in-rr 'u_ 'c_)
(dk-cite! 'rr-mul-in-rr 'c_ 'u_)
(dk-cite! 'rr-mul-in-rr '(* t_ a_) 'u_)
(dk-have! '(<= 0 u_) (lambda () (dk-ineq! '(< 0 u_) '(IN u_ RR))))
(dk-cite! 'rr-le-scale-nonneg-right 'c_ '(* t_ a_) 'u_)
(dk-have! '(= (* c_ u_) (* u_ c_)) (lambda () (crs)))
(hbs-undo! 't_ 'u_ 'a_)
(dk-ineq! '(<= (* c_ u_) (* (* t_ a_) u_)) '(= (* c_ u_) (* u_ c_)) '(= (* (* t_ a_) u_) a_)
          '(IN (* c_ u_) RR) '(IN (* u_ c_) RR) '(IN (* (* t_ a_) u_) RR) '(IN a_ RR))
(hbs-qed! 'hbs-rr-div-le)

;;; from u c <= a with t, u > 0, t u = 1:  c <= t a
(sp (make-wff '(FORALL t_ (IMPLIES (IN t_ RR) (FORALL u_ (IMPLIES (IN u_ RR) (FORALL c_ (IMPLIES (IN c_ RR) (FORALL a_ (IMPLIES (IN a_ RR)
   (IMPLIES (< 0 t_) (IMPLIES (< 0 u_) (IMPLIES (= (* t_ u_) 1) (IMPLIES (<= (* u_ c_) a_) (<= c_ (* t_ a_))))))))))))))))
(dk-peel!)
(dk-cite! 'rr-mul-in-rr 't_ 'a_)
(dk-cite! 'rr-mul-in-rr 'u_ 'c_)
(dk-cite! 'rr-mul-in-rr '(* u_ c_) 't_)
(dk-cite! 'rr-mul-in-rr 'a_ 't_)
(dk-have! '(<= 0 t_) (lambda () (dk-ineq! '(< 0 t_) '(IN t_ RR))))
(dk-cite! 'rr-le-scale-nonneg-right '(* u_ c_) 'a_ 't_)
(dk-have! '(= (* a_ t_) (* t_ a_)) (lambda () (crs)))
(dk-have! '(= (* (* u_ c_) t_) c_)
  (lambda ()
    (dk-have! '(= (* (* u_ c_) t_) (* (* t_ u_) c_)) (lambda () (crs)))
    (subst '(= (* (* u_ c_) t_) (* (* t_ u_) c_)))
    (subst '(= (* t_ u_) 1))
    (crs)))
(dk-ineq! '(<= (* (* u_ c_) t_) (* a_ t_)) '(= (* a_ t_) (* t_ a_)) '(= (* (* u_ c_) t_) c_)
          '(IN (* (* u_ c_) t_) RR) '(IN (* a_ t_) RR) '(IN (* t_ a_) RR) '(IN c_ RR))
(hbs-qed! 'hbs-rr-mul-back)

;;; ---- the parts of IS-SUBLINEAR ----
(define (hbs-sl-core f)
  (cond ((and (pair? f) (eq? (car f) 'FORALL)) (hbs-sl-core (caddr f)))
        ((and (pair? f) (eq? (car f) 'IMPLIES)) (hbs-sl-core (caddr f)))
        (#t f)))

(define (hbs-sl-open!)
  (dk-split-all! (dk-landed (lambda () (mac-h 'is-sublinear (dk-ctx-form '(IS-SUBLINEAR m q)))))))

(sp (make-wff '(FORALL m (FORALL q (IMPLIES (IS-SUBLINEAR m q) (IN q (FUN (VEC m) RR)))))))
(dk-peel!)
(hbs-sl-open!)
(ass)
(hbs-qed! 'hbs-sl-fun)

(sp (make-wff '(FORALL m (FORALL q (IMPLIES (IS-SUBLINEAR m q)
  (FORALL x_ (IMPLIES (IN x_ (VEC m)) (FORALL y_ (IMPLIES (IN y_ (VEC m))
    (<= (q ((VADD m) x_ y_)) (+ (q x_) (q y_))))))))))))
(dk-peel!)
(let ((parts (hbs-sl-open!)))
  (dk-apply! (find-first (lambda (f) (dk-head-is? (hbs-sl-core f) '<=)) parts) 'x_ 'y_))
(ass)
(hbs-qed! 'hbs-sl-sub)

(sp (make-wff '(FORALL m (FORALL q (IMPLIES (IS-SUBLINEAR m q)
  (FORALL t_ (IMPLIES (IN t_ RR) (IMPLIES (<= 0 t_) (FORALL x_ (IMPLIES (IN x_ (VEC m))
    (= (q ((ACT m) t_ x_)) (* t_ (q x_)))))))))))))
(dk-peel!)
(let ((parts (hbs-sl-open!)))
  (dk-apply! (find-first (lambda (f) (dk-head-is? (hbs-sl-core f) '=)) parts) 't_ 'x_))
(ass)
(hbs-qed! 'hbs-sl-hom)

(sp (make-wff '(FORALL m (FORALL q (IMPLIES (IS-SUBLINEAR m q)
  (FORALL x_ (IMPLIES (IN x_ (VEC m)) (IN (q x_) RR))))))))
(dk-peel!)
(dk-cite! 'hbs-sl-fun 'm 'q)
(dk-cite! 'fun-apply-type-c 'q '(VEC m) 'RR 'x_)
(ass)
(hbs-qed! 'hbs-sl-val)

;;; q(0) = 0
(sp (make-wff (hbs-mod '(FORALL q (IMPLIES (IS-SUBLINEAR m q) (= (q (VZERO m)) 0))))))
(dk-peel!)
(dk-cite! 'module-vzero-in 'm)
(dk-cite! 'rr-zero-in)
(dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
(let ((e (dk-cite! 'hbs-act-zero 'm '(VZERO m)))
      (h (dk-cite! 'hbs-sl-hom 'm 'q 0 '(VZERO m))))
  (dk-rewrite-h! h '((ACT m) 0 (VZERO m)) '(VZERO m)))
(dk-cite! 'hbs-sl-val 'm 'q '(VZERO m))
(dk-have! '(= (* 0 (q (VZERO m))) 0) (lambda () (crs)))
(dk-ineq! '(= (q (VZERO m)) (* 0 (q (VZERO m)))) '(= (* 0 (q (VZERO m))) 0)
          '(IN (q (VZERO m)) RR))
(hbs-qed! 'hbs-sl-zero)

;;; 0 <= q(x) + q((-1).x)
(sp (make-wff (hbs-mod '(FORALL q (IMPLIES (IS-SUBLINEAR m q)
  (FORALL x_ (IMPLIES (IN x_ (VEC m)) (<= 0 (+ (q x_) (q ((ACT m) (- 1) x_)))))))))))
(dk-peel!)
(hbs-m1!)
(dk-cite! 'hbs-act-in 'm hbs-m1 'x_)
(dk-cite! 'module-vzero-in 'm)
(let ((h (dk-cite! 'hbs-sl-sub 'm 'q 'x_ '((ACT m) (- 1) x_))))
  (dk-cite! 'hbs-neg-cancel 'm 'x_)
  (dk-rewrite-h! h '((VADD m) x_ ((ACT m) (- 1) x_)) '(VZERO m)))
(dk-cite! 'hbs-sl-zero 'm 'q)
(dk-cite! 'hbs-sl-val 'm 'q 'x_)
(dk-cite! 'hbs-sl-val 'm 'q '((ACT m) (- 1) x_))
(dk-cite! 'hbs-sl-val 'm 'q '(VZERO m))
(dk-ineq! '(<= (q (VZERO m)) (+ (q x_) (q ((ACT m) (- 1) x_)))) '(= (q (VZERO m)) 0)
          '(IN (q x_) RR) '(IN (q ((ACT m) (- 1) x_)) RR) '(IN (q (VZERO m)) RR))
(hbs-qed! 'hbs-sl-negsum)

;;; a subadditive q with q(0) = 0 and q(t.x) <= t q(x) for t > 0 is sublinear
(define hbs-subadd
  '(FORALL x_ (IMPLIES (IN x_ (VEC m)) (FORALL y_ (IMPLIES (IN y_ (VEC m))
     (<= (q ((VADD m) x_ y_)) (+ (q x_) (q y_))))))))
(define hbs-homle
  '(FORALL t_ (IMPLIES (IN t_ RR) (IMPLIES (< 0 t_) (FORALL x_ (IMPLIES (IN x_ (VEC m))
     (<= (q ((ACT m) t_ x_)) (* t_ (q x_)))))))))
(sp (make-wff (hbs-mod (list 'FORALL 'q (list 'IMPLIES '(IN q (FUN (VEC m) RR))
  (list 'IMPLIES hbs-subadd (list 'IMPLIES hbs-homle
    (list 'IMPLIES '(= (q (VZERO m)) 0) '(IS-SUBLINEAR m q)))))))))
(dk-peel!)
(mac 'is-sublinear)
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (ass)
      (begin
        (dk-peel!)
        (let* ((g (dk-goal)) (tx (cadr (cadr g))) (t (cadr tx)) (x (caddr tx)))
          (dk-cite! 'fun-apply-type-c 'q '(VEC m) 'RR x)
          (dk-cite! 'hbs-act-in 'm t x)
          (dk-cite! 'fun-apply-type-c 'q '(VEC m) 'RR tx)
          (dk-cite! 'rr-zero-in)
          (dk-cite! 'rr-le-cases 0 t)
          (hbs-cases! (list 'OR (list '< 0 t) (list '= 0 t))
            (lambda ()
              (let* ((u (dk-skolem! (dk-cite! 'hbs-pos-inv t)))
                     (qx (list 'q x)) (qtx (list 'q tx))
                     (utx (list '(ACT m) u tx)))
                (dk-apply! (dk-ctx-form hbs-homle) t x)
                (let ((le2 (dk-apply! (dk-ctx-form hbs-homle) u tx)))
                  (dk-have! (list '= (list '* u t) (list '* t u)) (lambda () (crs)))
                  (dk-have! (list '= (list '* u t) 1)
                    (lambda () (subst (list '= (list '* u t) (list '* t u))) (ass)))
                  (let* ((am (dk-cite! 'hbs-act-mul 'm u t x))
                         (am1 (dk-rewrite-h! am (list '* u t) 1)))
                    (dk-cite! 'hbs-act-one 'm x)
                    (let* ((le2a (dk-rewrite-h! le2 utx (list '(ACT m) 1 x)))
                           (le2b (dk-rewrite-h! le2a (list '(ACT m) 1 x) x)))
                      (dk-cite! 'rr-mul-in-rr u qtx)
                      (dk-cite! 'rr-mul-in-rr qx t)
                      (dk-cite! 'rr-mul-in-rr t qx)
                      (dk-cite! 'rr-mul-in-rr (list '* u qtx) t)
                      (dk-have! (list '<= 0 t) (lambda () (dk-ineq! (list '< 0 t) (list 'IN t 'RR))))
                      (dk-cite! 'rr-le-scale-nonneg-right qx (list '* u qtx) t)
                      (hbs-undo! u t qtx)
                      (dk-have! (list '= (list '* qx t) (list '* t qx)) (lambda () (crs)))
                      (hbs-antisym! qtx (list '* t qx)
                        (lambda () (ass))
                        (lambda () (dk-ineq! (list '<= (list '* qx t) (list '* (list '* u qtx) t))
                                             (list '= (list '* (list '* u qtx) t) qtx)
                                             (list '= (list '* qx t) (list '* t qx))
                                             (list 'IN (list '* qx t) 'RR) (list 'IN (list '* t qx) 'RR)
                                             (list 'IN (list '* (list '* u qtx) t) 'RR) (list 'IN qtx 'RR)))))))))
            (lambda ()
              (subst (list '= t 0))
              (dk-cite! 'hbs-act-zero 'm x)
              (subst (list '= (list '(ACT m) 0 x) '(VZERO m)))
              (subst '(= (q (VZERO m)) 0))
              (crs))))))))
(hbs-qed! 'hbs-sl-intro-pos)

;;; a sublinear q that is odd from above, q((-1).y) <= -q(y), is LINEAR on the whole space
(define hbs-odd '(FORALL y_ (IMPLIES (IN y_ (VEC m)) (<= (q ((ACT m) (- 1) y_)) (- (q y_))))))
(sp (make-wff (hbs-mod (list 'FORALL 'q (list 'IMPLIES '(IS-SUBLINEAR m q)
  (list 'IMPLIES hbs-odd '(IS-LINEAR-FUNCTIONAL-ON m (VEC m) q)))))))
(dk-peel!)
(hbs-m1!)
(dk-cite! 'hbs-sl-fun 'm 'q)
(define hbs-oddeq '(FORALL y_ (IMPLIES (IN y_ (VEC m)) (= (q ((ACT m) (- 1) y_)) (- (q y_))))))
(dk-have! hbs-oddeq
  (lambda ()
    (let ((y (dk-di-var!)))
      (dk-cite! 'hbs-act-in 'm hbs-m1 y)
      (dk-cite! 'hbs-sl-val 'm 'q y)
      (dk-cite! 'hbs-sl-val 'm 'q (list '(ACT m) hbs-m1 y))
      (dk-cite! 'rr-neg-closed (list 'q y))
      (dk-apply! (dk-ctx-form hbs-odd) y)
      (dk-cite! 'hbs-sl-negsum 'm 'q y)
      (hbs-antisym! (list 'q (list '(ACT m) hbs-m1 y)) (list '- (list 'q y))
        (lambda () (ass))
        (lambda () (dk-ineq! (list '<= 0 (list '+ (list 'q y) (list 'q (list '(ACT m) hbs-m1 y))))
                             (list 'IN (list 'q y) 'RR) (list 'IN (list 'q (list '(ACT m) hbs-m1 y)) 'RR)))))))
(mac 'is-linear-functional-on)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ((dk-contains? g '(VADD m))
         (dk-peel!)
         (let* ((g (dk-goal)) (xy (cadr (cadr g))) (x (cadr xy)) (y (caddr xy))
                (my (list '(ACT m) hbs-m1 y)))
           (dk-cite! 'module-vadd-type 'm x y)
           (dk-cite! 'hbs-act-in 'm hbs-m1 y)
           (dk-cite! 'hbs-sl-sub 'm 'q x y)
           (let ((h (dk-cite! 'hbs-sl-sub 'm 'q xy my)))
             (dk-cite! 'hbs-cancel-r 'm x y)
             (dk-rewrite-h! h (list '(VADD m) xy my) x))
           (dk-apply! (dk-ctx-form hbs-oddeq) y)
           (for-each (lambda (v) (dk-cite! 'hbs-sl-val 'm 'q v)) (list x y xy my))
           (hbs-antisym! (list 'q xy) (list '+ (list 'q x) (list 'q y))
             (lambda () (ass))
             (lambda () (dk-ineq! (list '<= (list 'q x) (list '+ (list 'q xy) (list 'q my)))
                                  (list '= (list 'q my) (list '- (list 'q y)))
                                  (list 'IN (list 'q x) 'RR) (list 'IN (list 'q y) 'RR)
                                  (list 'IN (list 'q xy) 'RR) (list 'IN (list 'q my) 'RR))))))
        (#t
         (dk-peel!)
         (let* ((g (dk-goal)) (rx (cadr (cadr g))) (r (cadr rx)) (x (caddr rx))
                (mx (list '(ACT m) hbs-m1 x)))
           (dk-cite! 'rr-zero-in)
           (dk-have! (list 'AND '(IN 0 RR) (list 'IN r 'RR)) (lambda () (dk-conj-close! (lambda () (ass)))))
           (dk-cite! 'rr-leq-total 0 r)
           (hbs-cases! (list 'OR (list '<= 0 r) (list '<= r 0))
             (lambda () (dk-cite! 'hbs-sl-hom 'm 'q r x) (ass))
             (lambda ()
               (dk-cite! 'rr-neg-closed r)
               (dk-cite! 'hbs-act-in 'm hbs-m1 x)
               (dk-have! (list '<= 0 (list '- r)) (lambda () (dk-ineq! (list '<= r 0) (list 'IN r 'RR))))
               (dk-have! (list '= (list '* (list '- r) hbs-m1) r) (lambda () (crs)))
               (let ((am (dk-cite! 'hbs-act-mul 'm (list '- r) hbs-m1 x)))
                 (dk-rewrite-h! am (list '* (list '- r) hbs-m1) r))
               (subst (list '= rx (list '(ACT m) (list '- r) mx)))
               (dk-cite! 'hbs-sl-hom 'm 'q (list '- r) mx)
               (subst (list '= (list 'q (list '(ACT m) (list '- r) mx)) (list '* (list '- r) (list 'q mx))))
               (dk-apply! (dk-ctx-form hbs-oddeq) x)
               (subst (list '= (list 'q mx) (list '- (list 'q x))))
               (dk-cite! 'hbs-sl-val 'm 'q x)
               (crs)))))))))
(hbs-qed! 'hbs-sl-odd-linear)

;;; =====================================================================
;;; (D) THREE INFIMA, EACH A SUBLINEAR FUNCTIONAL
;;;   tilt:   r(x)  = inf_{t >= 0} q(x + t.y) - t q(y)        (q sublinear, y fixed)
;;;   reduce: p0(x) = inf_{z in s} p(x + z) - f(z)            (f <= p on the submodule s)
;;;   chain:  r(x)  = inf_{q in ch} q(x)                      (ch a chain of sublinear q)
;;; Each is built by hbs-inf-family-c and read back in beta-reduced form.
;;; =====================================================================

(define hbs-TS '(SEP hts_ RR (<= 0 hts_)))
(define (hbs-sep-part! hyp claim)
  (dk-have! claim
    (lambda ()
      (dk-split-all! (dk-landed (lambda () (sep-me (dk-ctx-form hyp)))))
      (ass))))
(define (hbs-ts-parts! j)
  (hbs-sep-part! (list 'IN j hbs-TS) (list 'IN j 'RR))
  (hbs-sep-part! (list 'IN j hbs-TS) (list '<= 0 j)))
(define (hbs-ts-in! j)
  (dk-have! (list 'IN j hbs-TS)
    (lambda () (dk-close-all! (lambda () (sep-mi))))))
(define (hbs-vec-set!)
  (dk-project! '(IN (VEC m) SET) 'is-module '(IS-MODULE m)))

;;; read a family r built by hbs-inf-family-c back in reduced form: R-LB / R-GLB are
;;; the landed clauses, IDX the index set, IN! proves (IN j IDX) for the eigenvariables
;;; of the reduced clause (its guards in context), PARTS! lands the guards from (IN j IDX).
(define (hbs-read-lb! r-lb in!)
  (dk-peel!)
  (let* ((g (dk-goal)) (x (cadr (cadr g))) (j (hbs-lb-index g)))
    (in! j)
    (let ((h (dk-apply! r-lb x j)))
      (if (not (dk-lam-b-h! h)) (ass)))))
(define hbs-lb-index #f)
(define (hbs-read-glb! r-glb idx parts! phi)
  (dk-peel!)
  (let* ((g (dk-goal)) (b (cadr g)) (x (cadr (caddr g)))
         (hb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f b) (dk-contains? f x)
                                       (not (dk-contains? f 'SEP))))
                      "the lower-bound hypothesis")))
    (dk-have! (list 'FORALL 'hij_ (list 'IMPLIES (list 'IN 'hij_ idx) (list '<= b (list phi x 'hij_))))
      (lambda ()
        (let ((j (dk-di-var!)))
          (parts! j)
          (dk-apply! hb j)
          (if (not (dk-lam-b!)) (ass)))))
    (dk-apply! r-glb x b)
    (ass)))

(define (hbs-tilt-body x t) (list '- (list 'q (list '(VADD m) x (list '(ACT m) t 'y_))) (list '* t '(q y_))))
(define hbs-tilt-phi (list 'VNB-LAMBDA '(LIST hx_ ht_) (list 'CARTESIAN '(VEC m) hbs-TS) (hbs-tilt-body 'hx_ 'ht_)))

(sp (make-wff (hbs-mod (list 'FORALL 'q (list 'IMPLIES '(IS-SUBLINEAR m q) (list 'FORALL 'y_ (list 'IMPLIES '(IN y_ (VEC m))
  (list 'FORSOME 'r_ (list 'AND '(IN r_ (FUN (VEC m) RR))
   (list 'AND (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list 'FORALL 't_ (list 'IMPLIES '(IN t_ RR) (list 'IMPLIES '(<= 0 t_)
           (list '<= '(r_ x_) (hbs-tilt-body 'x_ 't_)))))))
        (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list 'FORALL 'b_ (list 'IMPLIES '(IN b_ RR)
           (list 'IMPLIES (list 'FORALL 't_ (list 'IMPLIES '(IN t_ RR) (list 'IMPLIES '(<= 0 t_) (list '<= 'b_ (hbs-tilt-body 'x_ 't_)))))
                 '(<= b_ (r_ x_)))))))))))))))))
(dk-peel!)
(hbs-vec-set!)
(dk-cite! 'rr-zero-in)
(dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
(hbs-m1!)
(dk-cite! 'hbs-sl-val 'm 'q 'y_)
;;; the value at (x, t) is a real, given x in VEC m and t in RR in context
(define (hbs-tilt-typ! x t)
  (let ((ty (list '(ACT m) t 'y_)))
    (dk-cite! 'hbs-act-in 'm t 'y_)
    (dk-cite! 'module-vadd-type 'm x ty)
    (dk-cite! 'hbs-sl-val 'm 'q (list '(VADD m) x ty))
    (dk-cite! 'hbs-sl-val 'm 'q ty)
    (dk-cite! 'rr-mul-in-rr t '(q y_))
    (dk-cite! 'rr-sub-in-rr (list 'q (list '(VADD m) x ty)) (list '* t '(q y_)))))
(dk-have! (list 'FORALL 'hix_ (list 'IMPLIES '(IN hix_ (VEC m)) (list 'FORSOME 'hi0_ (list 'IN 'hi0_ hbs-TS))))
  (lambda ()
    (dk-di-var!)
    (hbs-ts-in! 0)
    (ew 0)
    (ass)))
(dk-have! (list 'FORALL 'hix_ (list 'IMPLIES '(IN hix_ (VEC m)) (list 'FORALL 'hij_ (list 'IMPLIES (list 'IN 'hij_ hbs-TS)
            (list 'IN (list hbs-tilt-phi 'hix_ 'hij_) 'RR)))))
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (x (cadr (cadr g))) (j (caddr (cadr g))))
      (hbs-ts-parts! j)
      (hbs-tilt-typ! x j)
      (if (not (dk-lam-b!)) (ass)))))
(dk-have! (list 'FORALL 'hix_ (list 'IMPLIES '(IN hix_ (VEC m)) (list 'FORSOME 'hib_ (list 'AND '(IN hib_ RR)
            (list 'FORALL 'hij_ (list 'IMPLIES (list 'IN 'hij_ hbs-TS) (list '<= 'hib_ (list hbs-tilt-phi 'hix_ 'hij_))))))))
  (lambda ()
    (let* ((x (dk-di-var!)) (mx (list '(ACT m) hbs-m1 x)))
      (dk-cite! 'hbs-act-in 'm hbs-m1 x)
      (dk-cite! 'hbs-sl-val 'm 'q mx)
      (dk-cite! 'rr-neg-closed (list 'q mx))
      (ew (list '- (list 'q mx)))
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
            (let* ((j (dk-di-var!)) (ty (list '(ACT m) j 'y_)) (xty (list '(VADD m) x ty)))
              (hbs-ts-parts! j)
              (hbs-tilt-typ! x j)
              (if (not (dk-lam-b!))
                (begin
                  (let ((h (dk-cite! 'hbs-sl-sub 'm 'q xty mx)))
                    (dk-cite! 'hbs-cancel-l 'm x ty)
                    (dk-rewrite-h! h (list '(VADD m) xty mx) ty))
                  (dk-cite! 'hbs-sl-hom 'm 'q j 'y_)
                  (dk-ineq! (list '<= (list 'q ty) (list '+ (list 'q xty) (list 'q mx)))
                            (list '= (list 'q ty) (list '* j '(q y_)))
                            (list 'IN (list 'q ty) 'RR) (list 'IN (list 'q xty) 'RR) (list 'IN (list 'q mx) 'RR)
                            (list 'IN (list '* j '(q y_)) 'RR)))))))))))
(let* ((r (dk-skolem! (dk-cite! 'hbs-inf-family-c '(VEC m) hbs-TS hbs-tilt-phi)))
       (r-lb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r) (not (dk-contains? f 'hib_)))) "LB"))
       (r-glb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r) (dk-contains? f 'hib_))) "GLB")))
  (ew r)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-asm? g) (ass))
              ((dk-contains? g 'b_)
               (hbs-read-glb! r-glb hbs-TS hbs-ts-parts! hbs-tilt-phi))
              (#t
               (set! hbs-lb-index (lambda (g) (cadr (caddr (caddr g)))))
               (hbs-read-lb! r-lb (lambda (j) (hbs-ts-in! j)))))))))
(hbs-qed! 'hbs-tilt-exists)

(define (hbs-conj! . fs)
  (let loop ((fs fs))
    (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (loop (cdr fs))))))
(define (hbs-have-conj! . fs)
  (dk-have! (apply hbs-conj! fs)
    (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (in-rr)))))))
(define (hbs-nonneg-prod! a b)
  (dk-cite! 'rr-mul-in-rr a b)
  (hbs-have-conj! (list 'IN a 'RR) (list 'IN b 'RR))
  (hbs-have-conj! (list '<= 0 a) (list '<= 0 b))
  (dk-cite! 'rr-leq-mul-nonneg a b))
(define (hbs-val! f x) (dk-cite! 'fun-apply-type-c f '(VEC m) 'RR x))

;;; the reduced clauses of a family, for a function symbol FN, index guard GUARDS
;;; (a list of formulas in the index variable IV) and value BODY (in XV, IV)
(define (hbs-lb-form fn xv iv guards body)
  (list 'FORALL xv (list 'IMPLIES (list 'IN xv '(VEC m))
    (let loop ((g (cons (list 'IN iv 'RR) guards)) (first #t))
      (cond ((null? g) (list '<= (list fn xv) body))
            (first (list 'FORALL iv (list 'IMPLIES (car g) (loop (cdr g) #f))))
            (#t (list 'IMPLIES (car g) (loop (cdr g) #f))))))))

;;; ---- the tilt is sublinear, below q, and odd from above at y ----
(define (hbs-tb x t) (hbs-tilt-body x t))
(define hbs-tilt-lb
  '(FORALL x_ (IMPLIES (IN x_ (VEC m)) (FORALL t_ (IMPLIES (IN t_ RR) (IMPLIES (<= 0 t_)
     (<= (rt x_) (- (q ((VADD m) x_ ((ACT m) t_ y_))) (* t_ (q y_))))))))))
(define hbs-tilt-glb
  '(FORALL x_ (IMPLIES (IN x_ (VEC m)) (FORALL b_ (IMPLIES (IN b_ RR)
     (IMPLIES (FORALL t_ (IMPLIES (IN t_ RR) (IMPLIES (<= 0 t_) (<= b_ (- (q ((VADD m) x_ ((ACT m) t_ y_))) (* t_ (q y_)))))))
              (<= b_ (rt x_))))))))
(define (hbs-tilt-ant b x)
  (let ((v (dk--fresh-binder '(hta_ htb_ htc_ htd_) (list b x) "hbs-tilt-ant")))
    (list 'FORALL v (list 'IMPLIES (list 'IN v 'RR) (list 'IMPLIES (list '<= 0 v) (list '<= b (hbs-tb x v)))))))

(sp (make-wff (hbs-mod (list 'FORALL 'q (list 'IMPLIES '(IS-SUBLINEAR m q) (list 'FORALL 'y_ (list 'IMPLIES '(IN y_ (VEC m))
  (list 'FORALL 'rt (list 'IMPLIES '(IN rt (FUN (VEC m) RR)) (list 'IMPLIES hbs-tilt-lb (list 'IMPLIES hbs-tilt-glb
    (hbs-conj! '(IS-SUBLINEAR m rt)
               '(FORALL x_ (IMPLIES (IN x_ (VEC m)) (<= (rt x_) (q x_))))
               '(<= (rt ((ACT m) (- 1) y_)) (- (q y_)))))))))))))))
(dk-peel!)
(hbs-m1!)
(dk-cite! 'rr-zero-in)
(dk-cite! 'rr-one-in)
(dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
(dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
(dk-cite! 'module-vzero-in 'm)
(dk-cite! 'hbs-sl-val 'm 'q 'y_)
(dk-cite! 'hbs-sl-zero 'm 'q)
(define hbs-qy '(q y_))
(define (hbs-tilt-typ2! x t)
  (let ((ty (list '(ACT m) t 'y_)))
    (dk-cite! 'hbs-act-in 'm t 'y_)
    (dk-cite! 'module-vadd-type 'm x ty)
    (dk-cite! 'hbs-sl-val 'm 'q (list '(VADD m) x ty))
    (dk-cite! 'rr-mul-in-rr t hbs-qy)
    (dk-cite! 'rr-sub-in-rr (list 'q (list '(VADD m) x ty)) (list '* t hbs-qy))))
;;; rt(x) <= q(x): the clause at t = 0
(define (hbs-tilt-le-q! x)
  (hbs-tilt-typ2! x 0)
  (let ((h (dk-apply! (dk-ctx-form hbs-tilt-lb) x 0)))
    (dk-cite! 'hbs-act-zero 'm 'y_)
    (dk-cite! 'hbs-vzero-r 'm x)
    (let* ((h1 (dk-rewrite-h! h '((ACT m) 0 y_) '(VZERO m)))
           (h2 (dk-rewrite-h! h1 (list '(VADD m) x '(VZERO m)) x)))
      (dk-have! (list '= (list '* 0 hbs-qy) 0) (lambda () (crs)))
      (hbs-val! 'rt x)
      (dk-cite! 'hbs-sl-val 'm 'q x)
      (dk-have! (list '<= (list 'rt x) (list 'q x))
        (lambda () (dk-ineq! h2 (list '= (list '* 0 hbs-qy) 0) (list 'IN (list 'rt x) 'RR) (list 'IN (list 'q x) 'RR)
                             (list 'IN (list '* 0 hbs-qy) 'RR)))))))
(dk-have! '(FORALL x_ (IMPLIES (IN x_ (VEC m)) (<= (rt x_) (q x_))))
  (lambda () (let ((x (dk-di-var!))) (hbs-tilt-le-q! x))))
;;; rt((-1).y) <= -q(y): the clause at x = (-1).y, t = 1
(dk-have! '(<= (rt ((ACT m) (- 1) y_)) (- (q y_)))
  (lambda ()
    (let ((my '((ACT m) (- 1) y_)))
      (dk-cite! 'hbs-act-in 'm hbs-m1 'y_)
      (hbs-tilt-typ2! my 1)
      (let ((h (dk-apply! (dk-ctx-form hbs-tilt-lb) my 1)))
        (dk-cite! 'hbs-act-one 'm 'y_)
        (dk-cite! 'hbs-neg-cancel-l 'm 'y_)
        (let* ((h1 (dk-rewrite-h! h '((ACT m) 1 y_) 'y_))
               (h2 (dk-rewrite-h! h1 (list '(VADD m) my 'y_) '(VZERO m))))
          (dk-have! (list '= (list '* 1 hbs-qy) hbs-qy) (lambda () (crs)))
          (hbs-val! 'rt my)
          (dk-cite! 'hbs-sl-val 'm 'q '(VZERO m))
          (dk-ineq! h2 (list '= (list '* 1 hbs-qy) hbs-qy) '(= (q (VZERO m)) 0)
                    (list 'IN (list 'rt my) 'RR) '(IN (q (VZERO m)) RR) (list 'IN hbs-qy 'RR)
                    (list 'IN (list '* 1 hbs-qy) 'RR)))))))
;;; rt(0) = 0
(dk-have! '(= (rt (VZERO m)) 0)
  (lambda ()
    (hbs-val! 'rt '(VZERO m))
    (dk-cite! 'hbs-sl-val 'm 'q '(VZERO m))
    (hbs-tilt-le-q! '(VZERO m))
    (dk-have! (hbs-tilt-ant 0 '(VZERO m))
      (lambda ()
        (dk-peel!)
        (let* ((g (dk-goal)) (t (cadr (caddr (caddr g))))
               (ty (list '(ACT m) t 'y_)))
          (dk-cite! 'hbs-act-in 'm t 'y_)
          (dk-cite! 'hbs-vzero-l 'm ty)
          (subst (list '= (list '(VADD m) '(VZERO m) ty) ty))
          (dk-cite! 'hbs-sl-hom 'm 'q t 'y_)
          (subst (list '= (list 'q ty) (list '* t hbs-qy)))
          (dk-cite! 'rr-mul-in-rr t hbs-qy)
          (dk-ineq! (list 'IN (list '* t hbs-qy) 'RR)))))
    (dk-apply! (dk-ctx-form hbs-tilt-glb) '(VZERO m) 0)
    (hbs-antisym! '(rt (VZERO m)) 0
      (lambda () (dk-ineq! '(<= (rt (VZERO m)) (q (VZERO m))) '(= (q (VZERO m)) 0)
                           '(IN (rt (VZERO m)) RR) '(IN (q (VZERO m)) RR)))
      (lambda () (ass)))))
;;; subadditivity: two greatest-lower-bound steps over
;;;   rt(x1 + x2) <= phi(x1 + x2, t1 + t2) <= phi(x1, t1) + phi(x2, t2)
(define hbs-rt-subadd
  '(FORALL x_ (IMPLIES (IN x_ (VEC m)) (FORALL y_ (IMPLIES (IN y_ (VEC m))
     (<= (rt ((VADD m) x_ y_)) (+ (rt x_) (rt y_))))))))
(define (hbs-rt-subadd-proof! x1 x2)
  (let* ((x12 (list '(VADD m) x1 x2)) (r12 (list 'rt x12))
         (glb (dk-ctx-form hbs-tilt-glb)) (lb (dk-ctx-form hbs-tilt-lb)))
    (dk-cite! 'module-vadd-type 'm x1 x2)
    (hbs-val! 'rt x12) (hbs-val! 'rt x1) (hbs-val! 'rt x2)
    (dk-have! (hbs-tilt-ant (list '- r12 (list 'rt x1)) x2)
      (lambda ()
        (dk-peel!)
        (let* ((t2 (cadr (caddr (caddr (dk-goal))))))
          (hbs-tilt-typ2! x2 t2)
          (let ((b1 (list '- r12 (hbs-tb x2 t2))))
            (dk-cite! 'rr-sub-in-rr r12 (hbs-tb x2 t2))
            (dk-have! (hbs-tilt-ant b1 x1)
              (lambda ()
                (dk-peel!)
                (let* ((t1 (cadr (caddr (caddr (dk-goal)))))
                       (t1y (list '(ACT m) t1 'y_)) (t2y (list '(ACT m) t2 'y_))
                       (a1 (list '(VADD m) x1 t1y)) (a2 (list '(VADD m) x2 t2y)))
                  (hbs-tilt-typ2! x1 t1)
                  (dk-cite! 'rr-add-in-rr t1 t2)
                  (dk-have! (list '<= 0 (list '+ t1 t2))
                    (lambda () (dk-ineq! (list '<= 0 t1) (list '<= 0 t2) (list 'IN t1 'RR) (list 'IN t2 'RR))))
                  (hbs-tilt-typ2! x12 (list '+ t1 t2))
                  (let ((h (dk-apply! lb x12 (list '+ t1 t2))))
                    (dk-cite! 'hbs-act-add 'm t1 t2 'y_)
                    (dk-cite! 'hbs-interchange 'm x1 x2 t1y t2y)
                    (let* ((h1 (dk-rewrite-h! h (list '(ACT m) (list '+ t1 t2) 'y_) (list '(VADD m) t1y t2y)))
                           (h2 (dk-rewrite-h! h1 (list '(VADD m) x12 (list '(VADD m) t1y t2y)) (list '(VADD m) a1 a2))))
                      (dk-cite! 'hbs-sl-sub 'm 'q a1 a2)
                      (dk-cite! 'module-vadd-type 'm a1 a2)
                      (dk-cite! 'hbs-sl-val 'm 'q (list '(VADD m) a1 a2))
                      (dk-cite! 'rr-mul-in-rr (list '+ t1 t2) hbs-qy)
                      (dk-have! (list '= (list '* (list '+ t1 t2) hbs-qy) (list '+ (list '* t1 hbs-qy) (list '* t2 hbs-qy)))
                        (lambda () (crs)))
                      (dk-ineq! h2 (list '<= (list 'q (list '(VADD m) a1 a2)) (list '+ (list 'q a1) (list 'q a2)))
                                (list '= (list '* (list '+ t1 t2) hbs-qy) (list '+ (list '* t1 hbs-qy) (list '* t2 hbs-qy)))
                                (list 'IN r12 'RR) (list 'IN (list 'q (list '(VADD m) a1 a2)) 'RR)
                                (list 'IN (list 'q a1) 'RR) (list 'IN (list 'q a2) 'RR)
                                (list 'IN (list '* (list '+ t1 t2) hbs-qy) 'RR)
                                (list 'IN (list '* t1 hbs-qy) 'RR) (list 'IN (list '* t2 hbs-qy) 'RR)))))))
            (dk-apply! glb x1 b1)
            (dk-ineq! (list '<= b1 (list 'rt x1)) (list 'IN r12 'RR) (list 'IN (list 'rt x1) 'RR)
                      (list 'IN (hbs-tb x2 t2) 'RR))))))
    (dk-cite! 'rr-sub-in-rr r12 (list 'rt x1))
    (dk-apply! glb x2 (list '- r12 (list 'rt x1)))
    (dk-ineq! (list '<= (list '- r12 (list 'rt x1)) (list 'rt x2))
              (list 'IN r12 'RR) (list 'IN (list 'rt x1) 'RR) (list 'IN (list 'rt x2) 'RR))))
(dk-have! hbs-rt-subadd
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (x12 (cadr (cadr g))))
      (hbs-rt-subadd-proof! (cadr x12) (caddr x12)))))
;;; positive homogeneity from above:  rt(t.x) <= t rt(x), t > 0
(define hbs-rt-homle
  '(FORALL t_ (IMPLIES (IN t_ RR) (IMPLIES (< 0 t_) (FORALL x_ (IMPLIES (IN x_ (VEC m))
     (<= (rt ((ACT m) t_ x_)) (* t_ (rt x_)))))))))
(dk-have! hbs-rt-homle
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (tx (cadr (cadr g))) (t (cadr tx)) (x (caddr tx))
           (u (dk-skolem! (dk-cite! 'hbs-pos-inv t)))
           (glb (dk-ctx-form hbs-tilt-glb)) (lb (dk-ctx-form hbs-tilt-lb)))
      (dk-cite! 'hbs-act-in 'm t x)
      (hbs-val! 'rt tx) (hbs-val! 'rt x)
      (dk-cite! 'rr-mul-in-rr u (list 'rt tx))
      (dk-have! (list '<= 0 t) (lambda () (dk-ineq! (list '< 0 t) (list 'IN t 'RR))))
      (dk-have! (hbs-tilt-ant (list '* u (list 'rt tx)) x)
        (lambda ()
          (dk-peel!)
          (let* ((sv (cadr (caddr (caddr (dk-goal)))))
                 (sy (list '(ACT m) sv 'y_)) (xsy (list '(VADD m) x sy)))
            (hbs-tilt-typ2! x sv)
            (hbs-nonneg-prod! t sv)
            (hbs-tilt-typ2! tx (list '* t sv))
            (dk-cite! 'hbs-act-in 'm sv 'y_)
            (let ((h (dk-apply! lb tx (list '* t sv))))
              (dk-cite! 'hbs-act-mul 'm t sv 'y_)
              (dk-cite! 'hbs-act-vadd 'm t x sy)
              (let* ((h1 (dk-rewrite-h! h (list '(ACT m) (list '* t sv) 'y_) (list '(ACT m) t sy)))
                     (h2 (dk-rewrite-h! h1 (list '(VADD m) tx (list '(ACT m) t sy)) (list '(ACT m) t xsy))))
                (dk-cite! 'hbs-sl-hom 'm 'q t xsy)
                (dk-cite! 'hbs-sl-val 'm 'q xsy)
                (dk-cite! 'hbs-act-in 'm t xsy)
                (dk-cite! 'hbs-sl-val 'm 'q (list '(ACT m) t xsy))
                (dk-cite! 'rr-mul-in-rr t (list 'q xsy))
                (dk-cite! 'rr-mul-in-rr (list '* t sv) hbs-qy)
                (dk-cite! 'rr-mul-in-rr t (hbs-tb x sv))
                (dk-have! (list '= (list '* t (hbs-tb x sv)) (list '- (list '* t (list 'q xsy)) (list '* (list '* t sv) hbs-qy)))
                  (lambda () (crs)))
                (dk-have! (list '<= (list 'rt tx) (list '* t (hbs-tb x sv)))
                  (lambda ()
                    (dk-ineq! h2 (list '= (list 'q (list '(ACT m) t xsy)) (list '* t (list 'q xsy)))
                              (list '= (list '* t (hbs-tb x sv)) (list '- (list '* t (list 'q xsy)) (list '* (list '* t sv) hbs-qy)))
                              (list 'IN (list 'rt tx) 'RR) (list 'IN (list 'q (list '(ACT m) t xsy)) 'RR)
                              (list 'IN (list '* t (list 'q xsy)) 'RR) (list 'IN (list '* (list '* t sv) hbs-qy) 'RR)
                              (list 'IN (list '* t (hbs-tb x sv)) 'RR))))
                (dk-cite! 'hbs-rr-div-le t u (list 'rt tx) (hbs-tb x sv))
                (ass))))))
      (dk-apply! glb x (list '* u (list 'rt tx)))
      (dk-cite! 'hbs-rr-mul-back t u (list 'rt tx) (list 'rt x))
      (ass))))
(dk-cite! 'hbs-sl-intro-pos 'm 'rt)
(dk-conj-close! (lambda () (ass)))
(hbs-qed! 'hbs-tilt-props)

;;; ---- the infimum of a family ch of real functions on VEC m, pointwise ----
(define hbs-chain-phi '(VNB-LAMBDA (LIST hx_ hq_) (CARTESIAN (VEC m) ch) (hq_ hx_)))
(define hbs-ch-typ '(FORALL q (IMPLIES (IN q ch) (IN q (FUN (VEC m) RR)))))
(define hbs-ch-bdd '(FORALL x_ (IMPLIES (IN x_ (VEC m)) (FORSOME b_ (AND (IN b_ RR) (FORALL q (IMPLIES (IN q ch) (<= b_ (q x_)))))))))
(define hbs-ch-lb '(FORALL x_ (IMPLIES (IN x_ (VEC m)) (FORALL q (IMPLIES (IN q ch) (<= (rt x_) (q x_)))))))
(define hbs-ch-glb '(FORALL x_ (IMPLIES (IN x_ (VEC m)) (FORALL b_ (IMPLIES (IN b_ RR)
