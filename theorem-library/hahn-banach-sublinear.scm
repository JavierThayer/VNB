;;; the pointwise infimum of a nonempty CHAIN of sublinear functionals is sublinear
(define hbs-ch-sl '(FORALL q (IMPLIES (IN q ch) (IS-SUBLINEAR m q))))
(define hbs-ch-comp
  '(FORALL q1_ (IMPLIES (IN q1_ ch) (FORALL q2_ (IMPLIES (IN q2_ ch)
     (OR (FORALL x_ (IMPLIES (IN x_ (VEC m)) (<= (q1_ x_) (q2_ x_))))
         (FORALL x_ (IMPLIES (IN x_ (VEC m)) (<= (q2_ x_) (q1_ x_))))))))))
(define (hbs-ch-ant b x)
  (let ((v (dk--fresh-binder '(hqa_ hqb_ hqc_) (list b x) "hbs-ch-ant")))
    (list 'FORALL v (list 'IMPLIES (list 'IN v 'ch) (list '<= b (list v x))))))
(define (hbs-ch-val! q x)
  (hbs-apply! (dk-ctx-form hbs-ch-sl) q)
  (dk-cite! 'hbs-sl-val 'm q x))

(sp (make-wff (hbs-mod (list 'FORALL 'ch (list 'IMPLIES '(FORSOME q0_ (IN q0_ ch))
  (list 'IMPLIES hbs-ch-sl (list 'IMPLIES hbs-ch-comp
    (list 'FORALL 'rt (list 'IMPLIES '(IN rt (FUN (VEC m) RR)) (list 'IMPLIES hbs-ch-lb (list 'IMPLIES hbs-ch-glb
      '(IS-SUBLINEAR m rt))))))))))))
(dk-peel!)
(dk-cite! 'module-vzero-in 'm)
(dk-cite! 'rr-zero-in)
(define (hbs-ch-glb!) (dk-ctx-form hbs-ch-glb))
(define (hbs-ch-lb!) (dk-ctx-form hbs-ch-lb))
(dk-have! hbs-rt-subadd
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (x12 (cadr (cadr g))) (x1 (cadr x12)) (x2 (caddr x12)) (r12 (list 'rt x12)))
      (dk-cite! 'module-vadd-type 'm x1 x2)
      (hbs-val! 'rt x12) (hbs-val! 'rt x1) (hbs-val! 'rt x2)
      (dk-have! (hbs-ch-ant (list '- r12 (list 'rt x1)) x2)
        (lambda ()
          (let* ((q2 (dk-di-var!)) (b1 (list '- r12 (list q2 x2))))
            (hbs-ch-val! q2 x2) (hbs-ch-val! q2 x1) (hbs-ch-val! q2 x12)
            (dk-cite! 'rr-sub-in-rr r12 (list q2 x2))
            (dk-have! (hbs-ch-ant b1 x1)
              (lambda ()
                (let ((q1 (dk-di-var!)))
                  (hbs-ch-val! q1 x1) (hbs-ch-val! q1 x2) (hbs-ch-val! q1 x12)
                  (let ((typs (list (list 'IN r12 'RR) (list 'IN (list q1 x1) 'RR) (list 'IN (list q1 x2) 'RR)
                                    (list 'IN (list q1 x12) 'RR) (list 'IN (list q2 x1) 'RR)
                                    (list 'IN (list q2 x2) 'RR) (list 'IN (list q2 x12) 'RR))))
                    (dk-apply! (dk-ctx-form hbs-ch-comp) q1 q2)
                    (hbs-cases! (list 'OR (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list '<= (list q1 'x_) (list q2 'x_))))
                                          (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list '<= (list q2 'x_) (list q1 'x_)))))
                      (lambda ()
                        (dk-apply! (dk-ctx-form (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list '<= (list q1 'x_) (list q2 'x_))))) x2)
                        (dk-apply! (hbs-ch-lb!) x12 q1)
                        (dk-cite! 'hbs-sl-sub 'm q1 x1 x2)
                        (apply dk-ineq! (append (list (list '<= (list q1 x2) (list q2 x2))
                                                      (list '<= r12 (list q1 x12))
                                                      (list '<= (list q1 x12) (list '+ (list q1 x1) (list q1 x2))))
                                                typs)))
                      (lambda ()
                        (dk-apply! (dk-ctx-form (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC m)) (list '<= (list q2 'x_) (list q1 'x_))))) x1)
                        (dk-apply! (hbs-ch-lb!) x12 q2)
                        (dk-cite! 'hbs-sl-sub 'm q2 x1 x2)
                        (apply dk-ineq! (append (list (list '<= (list q2 x1) (list q1 x1))
                                                      (list '<= r12 (list q2 x12))
                                                      (list '<= (list q2 x12) (list '+ (list q2 x1) (list q2 x2))))
                                                typs))))))))
            (dk-apply! (hbs-ch-glb!) x1 b1)
            (dk-ineq! (list '<= b1 (list 'rt x1)) (list 'IN r12 'RR) (list 'IN (list 'rt x1) 'RR) (list 'IN (list q2 x2) 'RR)))))
      (dk-cite! 'rr-sub-in-rr r12 (list 'rt x1))
      (dk-apply! (hbs-ch-glb!) x2 (list '- r12 (list 'rt x1)))
      (dk-ineq! (list '<= (list '- r12 (list 'rt x1)) (list 'rt x2))
                (list 'IN r12 'RR) (list 'IN (list 'rt x1) 'RR) (list 'IN (list 'rt x2) 'RR)))))
(dk-have! hbs-rt-homle
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (tx (cadr (cadr g))) (t (cadr tx)) (x (caddr tx))
           (u (dk-skolem! (dk-cite! 'hbs-pos-inv t))))
      (dk-cite! 'hbs-act-in 'm t x)
      (hbs-val! 'rt tx) (hbs-val! 'rt x)
      (dk-cite! 'rr-mul-in-rr u (list 'rt tx))
      (dk-have! (list '<= 0 t) (lambda () (dk-ineq! (list '< 0 t) (list 'IN t 'RR))))
      (dk-have! (hbs-ch-ant (list '* u (list 'rt tx)) x)
        (lambda ()
          (let ((q (dk-di-var!)))
            (hbs-ch-val! q x) (hbs-ch-val! q tx)
            (dk-apply! (hbs-ch-lb!) tx q)
            (dk-cite! 'hbs-sl-hom 'm q t x)
            (dk-cite! 'rr-mul-in-rr t (list q x))
            (dk-have! (list '<= (list 'rt tx) (list '* t (list q x)))
              (lambda () (dk-ineq! (list '<= (list 'rt tx) (list q tx)) (list '= (list q tx) (list '* t (list q x)))
                                   (list 'IN (list 'rt tx) 'RR) (list 'IN (list q tx) 'RR) (list 'IN (list '* t (list q x)) 'RR))))
            (dk-cite! 'hbs-rr-div-le t u (list 'rt tx) (list q x))
            (ass))))
      (dk-apply! (hbs-ch-glb!) x (list '* u (list 'rt tx)))
      (dk-cite! 'hbs-rr-mul-back t u (list 'rt tx) (list 'rt x))
      (ass))))
(dk-have! '(= (rt (VZERO m)) 0)
  (lambda ()
    (hbs-val! 'rt '(VZERO m))
    (dk-have! '(<= (rt (VZERO m)) 0)
      (lambda ()
        (let ((q0 (dk-skolem! (dk-ctx-form '(FORSOME q0_ (IN q0_ ch))))))
          (hbs-ch-val! q0 '(VZERO m))
          (dk-apply! (hbs-ch-lb!) '(VZERO m) q0)
          (dk-cite! 'hbs-sl-zero 'm q0)
          (dk-ineq! (list '<= '(rt (VZERO m)) (list q0 '(VZERO m))) (list '= (list q0 '(VZERO m)) 0)
                    '(IN (rt (VZERO m)) RR) (list 'IN (list q0 '(VZERO m)) 'RR)))))
    (dk-have! (hbs-ch-ant 0 '(VZERO m))
      (lambda ()
        (let ((q (dk-di-var!)))
          (hbs-ch-val! q '(VZERO m))
          (dk-cite! 'hbs-sl-zero 'm q)
          (dk-ineq! (list '= (list q '(VZERO m)) 0) (list 'IN (list q '(VZERO m)) 'RR)))))
    (dk-apply! (hbs-ch-glb!) '(VZERO m) 0)
    (hbs-antisym! '(rt (VZERO m)) 0 (lambda () (ass)) (lambda () (ass)))))
(dk-cite! 'hbs-sl-intro-pos 'm 'rt)
(ass)
(hbs-qed! 'hbs-chain-props)

;;; ---- a linear functional on a submodule: its parts ----
(define (hbs-lf-open!)
  (dk-split-all! (dk-landed (lambda () (mac-h 'is-linear-functional-on (dk-ctx-form '(IS-LINEAR-FUNCTIONAL-ON m s f)))))))

