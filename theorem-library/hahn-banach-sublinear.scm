(sp (make-wff '(FORALL m (FORALL s (FORALL f (IMPLIES (IS-LINEAR-FUNCTIONAL-ON m s f)
  (FORALL x_ (IMPLIES (IN x_ s) (FORALL y_ (IMPLIES (IN y_ s)
    (= (f ((VADD m) x_ y_)) (+ (f x_) (f y_)))))))))))))
