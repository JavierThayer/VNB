(define (hbs-subst-sym f old new) (subst-free old new f))

(sp (make-wff (hbs-mod (list 'FORALL 'ch (list 'IMPLIES '(FORSOME q0_ (IN q0_ ch))
  (list 'IMPLIES hbs-ch-typ (list 'IMPLIES hbs-ch-bdd
    (list 'FORSOME 'rt (hbs-conj! '(IN rt (FUN (VEC m) RR)) hbs-ch-lb hbs-ch-glb)))))))))
(dk-peel!)
(hbs-vec-set!)
