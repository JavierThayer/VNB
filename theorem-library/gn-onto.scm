;;; gn-onto.scm -- Theorem 1.23 of F. J. Thayer, "Banach Algebras and Applications", ch. 1: the ONTO half
;;; of commutative Gelfand-Naimark.  Agent BA-1117-GN, wave 2026-11-17.  All proofs modulo 0.
;;; Destination: theorem-library/gn-onto.scm.  Library: operator-algebras.  Helper prefix gno-.
;;; Binders gn*_ (gnc_ gnk_ gnu_ gny_ gnx_ gne_ gnm_), used by no other file.
;;;
;;; THE ROUTE (the notes').  (1) The range R = {G(x) : x in A} is a unital self-adjoint subalgebra of
;;; C(A-hat) that separates points (characters are functions: two that agree everywhere are equal),
;;; so complex Stone-Weierstrass (bsw-stone-weierstrass-complex) makes it uniformly dense.  (2) G is
;;; isometric (gelfand-isometric) and A is complete, so the range is closed: given f in C(A-hat),
;;; choose x_k with |chi(x_k) - f(chi)| < 2^-(k+1) for every character chi (dc-on-nn-pred); then
;;; ||x_k - x_(k+1)|| = sup |G(x_k - x_(k+1))| <= 2^-(k+1) + 2^-(k+2) <= 2^-k, the sequence converges
;;; (summable-bound-converges) to some l, and chi(l) = lim chi(x_k) = f(chi) (bgf-psi-conv, the
;;; uniqueness of limits in CC).
;;;
;;; gno-closed-range is stated for any unital Banach algebra whose Gelfand transform is isometric, with
;;; the uniform approximability of f as a CURRIED antecedent; gelfand-onto applies it to UIBA-AS-UBA(a).

(define (gno-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** gn-onto: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (if (< (string-length (expression->string a)) 400)
                                              (begin (display "      asm: ") (display (expression->string a)) (newline))))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "gn-onto: unfinished" name))))
(define (gno-dump! tag)
  (display "\n*** DUMP ") (display tag) (newline)
  (for-each (lambda (l)
              (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
              (for-each (lambda (a) (if (< (string-length (expression->string a)) 400)
                                        (begin (display "      asm: ") (display (expression->string a)) (newline))))
                        (dk-asms-of l)))
            (dk-open-leaves)))
(define (gno-cite2! . args)
  (let loop ((ch (apply dk-cite! args)))
    (if (dk-head-is? ch 'IMPLIES)
        (loop (detach-with! ch (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        ch)))
(define (gno-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (gno-ass!) (if (and (gno-open?) (dk-asm? (dk-goal))) (ass)))

(define gno-T '(GELFAND-SPACE a))
(define gno-PT '(PTS (GELFAND-SPACE a)))
(define gno-CH '(CHARACTERS a))
(define (gno-G y) (list '(GELFAND-TRANSFORM a) y))
(define (gno-pw k) (list 'power 1/2 k))
(define (gno-ad x y) (list '(VADD a) x y))
(define (gno-ng x) (list '(VNEG a) x))
(define gno-bam '(BA-METRIC-SPACE a))

;;; typing in VEC a, bottom-up
(define (gno-vt x)
  (let ((want (list 'IN x '(VEC a))))
    (cond ((dk-asm? want) x)
          ((and (pair? x) (equal? (car x) '(VADD a)))
           (gno-vt (cadr x)) (gno-vt (caddr x))
           (dk-cite! 'ring-add-closed-uba-as-ring 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VNEG a)))
           (gno-vt (cadr x))
           (dk-cite! 'ring-neg-in-carr-uba-as-ring 'a (cadr x)) x)
          (#t (error "gno-vt: cannot type" (expression->string x))))))
;;; 1/2 facts and (1/2)^k facts at k (k typed in NN): (1/2)^k in RR, 0 < (1/2)^k, POS-RR, the succ law
(define (gno-half!)
  (if (not (dk-asm? '(IN 1/2 RR)))
      (begin (dk-have! '(IN 1/2 RR) (lambda () (arith)))
             (dk-have! '(IN 1/2 CC) (lambda () (arith)))
             (dk-have! '(< 0 1/2) (lambda () (arith))))))
(define (gno-hp! k)
  (gno-half!)
  (if (not (dk-asm? (list '< 0 (gno-pw k))))
      (dk-split-all! (list (dk-cite! 'half-power-facts k))))
  (if (not (dk-asm? (list 'POS-RR (gno-pw k))))
      (dk-cite! 'rr-pos-rr-of-lt (gno-pw k))))

;;; ---- a character is CC-linear ------------------------------------------------------------------------
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a) (FORALL c (IMPLIES (IN c (CHARACTERS a))
  (IS-CC-LINEAR-ON a c)))))))
(dk-peel!)
(let* ((m0 '(IN c (CHARACTERS a)))
       (body (caddr (dk-cite! 'bas-characters-unfold 'a)))
       (m1 (dk-rewrite-h! m0 '(CHARACTERS a) body)))
  (dk-project! '(IS-CC-LINEAR-ON a c) (lambda () (sep-me m1))))
(gno-qed! 'gno-char-linear)

;;; ---- chi(x - y) = chi(x) - chi(y) --------------------------------------------------------------------
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-BANACH-ALGEBRA a) (FORALL c (IMPLIES (IN c (CHARACTERS a))
  (FORALL x (IMPLIES (IN x (VEC a)) (FORALL y (IMPLIES (IN y (VEC a))
    (= (c ((VADD a) x ((VNEG a) y))) (- (c x) (c y)))))))))))))
(dk-peel!)
(let* ((ny (gno-ng 'y)) (d (gno-ad 'x ny)))
  (gno-vt ny) (gno-vt d)
  (dk-cite! 'gno-char-linear 'a 'c)
  (dk-cite! 'character-in-fun 'a 'c)
  (for-each (lambda (u) (dk-cite! 'fun-apply-type-c 'c '(VEC a) 'CC u)) (list 'x 'y ny d))
  (dk-cite! 'bsn-psi-neg 'a 'c 'y)
  (dk-cite! 'gelfand-transform-add 'a 'x ny 'c)
  (for-each (lambda (u) (dk-cite! 'gelfand-transform-value 'a u 'c)) (list 'x ny d))
  (subst (list '= (list 'c d) (list (gno-G d) 'c)))
  (subst (list '= (list (gno-G d) 'c) (list '+ (list (gno-G 'x) 'c) (list (gno-G ny) 'c))))
  (subst (list '= (list (gno-G 'x) 'c) '(c x)))
  (subst (list '= (list (gno-G ny) 'c) (list 'c ny)))
  (subst (list '= (list 'c ny) '(- (c y))))
  (crs))
(gno-qed! 'gno-char-sub)

;;; ---- the range of an isometric Gelfand transform is closed -------------------------------------------
(define gno-iso
  '(FORALL gnx_ (IMPLIES (IN gnx_ (VEC a))
     (= (SUP-NORM-T (GELFAND-SPACE a) ((GELFAND-TRANSFORM a) gnx_)) ((VNRM a) gnx_)))))
(define gno-approx
  '(FORALL gne_ (IMPLIES (POS-RR gne_) (FORSOME gny_ (AND (IN gny_ (VEC a))
     (FORALL gnc_ (IMPLIES (IN gnc_ (CHARACTERS a)) (< (magnitude (- (gnc_ gny_) (f gnc_))) gne_))))))))
(define (gno-Q k y)
  (list 'FORALL 'gnc_ (list 'IMPLIES '(IN gnc_ (CHARACTERS a))
    (list '< (list 'magnitude (list '- (list 'gnc_ y) '(f gnc_))) (gno-pw (list 'succ k))))))
(define gno-nxt
  (list 'VNB-LAMBDA '(LIST gnk_ gnu_) '(CARTESIAN NN (VEC a))
        (list 'SEP 'gny_ '(VEC a) (gno-Q '(succ gnk_) 'gny_))))
(define gno-rad '(VNB-LAMBDA n NN (power 1/2 n)))

(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-BANACH-ALGEBRA a) (list 'IMPLIES gno-iso
  (list 'FORALL 'f (list 'IMPLIES '(IN f (CCONT (GELFAND-SPACE a))) (list 'IMPLIES gno-approx
    '(FORSOME gnx_ (AND (IN gnx_ (VEC a)) (= ((GELFAND-TRANSFORM a) gnx_) f)))))))))))
(dk-peel!)
(dk-cite! 'gelfand-space-pts 'a)
(dk-split-all! (list (dk-cite! 'ccont-parts gno-T 'f)))
(dk-rewrite-h! (list 'IN 'f (list 'FUN gno-PT 'CC)) gno-PT gno-CH)
(dk-cite! 'bal-uba-vec-set 'a)
(dk-cite! 'nn-zero-in)
(dk-cite! 'nn-succ-closed 0)
(gno-hp! '(succ 0))
(let* ((apx (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'gne_))) "the approximation hypothesis"))
       (iso (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'SUP-NORM-T))) "the isometry hypothesis"))
       (a0 (dk-skolem! (dk-apply! apx (gno-pw '(succ 0)))))
       ;; (A) the sequence
       (ch (dk-cite! 'dc-on-nn-pred '(VEC a) a0 gno-nxt))
       (ex (detach-with! ch
             (lambda ()
               (let* ((ls (dk-peel!)) (k (cadr (car ls))) (u (cadr (cadr ls))))
                 (if (not (dk-asm? (list 'IN u '(VEC a))))
                     (begin (gno-dump! "dc step: u not typed") (error "gn-onto: dc step")))
                 (dk-cite! 'nn-succ-closed k)
                 (dk-cite! 'nn-succ-closed (list 'succ k))
                 (gno-hp! (list 'succ (list 'succ k)))
                 (let ((y1 (dk-skolem! (dk-apply! apx (gno-pw (list 'succ (list 'succ k)))))))
                   (ew y1)
                   (dk-conj-close!
                     (lambda ()
                       (if (not (dk-ass!))
                           (begin
                             (dk-lam-b!)
                             (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!))))))))))))
       (s (dk-skolem! ex))
       (s0 (list 's 0)))
  (if (not (equal? s 's)) (begin (display "\n*** the sequence is named ") (display s) (newline)))
  (let* ((sk (lambda (k) (list s k)))
         (sf (list 'IN s '(FUN NN (VEC a))))
         (stp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'gnk_) (dk-contains? h s))) "the dc step clause"))
         (typ! (lambda (k) (dk-cite! 'fun-apply-type-c s 'NN '(VEC a) k))))
    ;; (B) every term is within (1/2)^(k+1) of f
    (dk-have! (list 'FORALL 'gnm_ (list 'IMPLIES '(IN gnm_ NN) (gno-Q 'gnm_ (list s 'gnm_))))
      (lambda ()
        (let* ((ls (dk-peel!)) (k (cadr (car ls))) (c (cadr (cadr ls))) (o (dk-cite! 'nn-zero-or-succ k)))
          (dk-or-each! o
            (lambda (br)
              (if (dk-head-is? br '=)
                  (begin (subst br) (subst (list '= (list s 0) a0))
                         (dk-apply! (gno-Q 0 a0) c) (dk-ass!))
                  (let* ((q (dk-skolem! br)))
                    (subst (list '= k (list 'succ q)))
                    (typ! q)
                    (let* ((m (dk-apply! stp q))
                           (m2 (begin (dk-lam-b-h! m) (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (dk-head-is? (caddr h) 'SEP) (dk-contains? h q))) "the reduced step")))
                           (qf (gno-Q (list 'succ q) (list s (list 'succ q)))))
                      (dk-project! qf (lambda () (sep-me m2)))
                      (dk-apply! qf c) (dk-ass!)))))))))
    (let ((inv (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'gnm_))) "the invariant")))
      ;; (C) consecutive distances
      (dk-have! (list 'FORALL 'gnk_ (list 'IMPLIES '(IN gnk_ NN)
                  (list '<= (list (list 'DIST gno-bam) (list s 'gnk_) (list s '(succ gnk_))) (gno-pw 'gnk_))))
        (lambda ()
          (let* ((k (dk-di-var!)) (k1 (list 'succ k)) (x0 (sk k)) (x1 (sk k1))
                 (d (gno-ad x0 (gno-ng x1))) (gd (gno-G d)))
            (dk-cite! 'nn-succ-closed k)
            (typ! k) (typ! k1) (gno-vt d)
            (dk-cite! 'nn-succ-closed k1)
            (gno-hp! k) (gno-hp! k1) (gno-hp! (list 'succ k1))
            (dk-cite! 'ban-dist 'a x0 x1)
            (dk-apply! iso d)
            (let ((gf (dk-cite! 'gelfand-transform-in-fun 'a d)))
              (dk-rewrite-h! gf gno-CH gno-PT))
            (dk-have! (list '<= 0 (gno-pw k)) (lambda () (dk-ineq! (list '< 0 (gno-pw k)) (list 'IN (gno-pw k) 'RR))))
            (let ((bd (dk-have! (list 'FORALL 'gnu_ (list 'IMPLIES (list 'IN 'gnu_ gno-PT) (list '<= (list 'magnitude (list gd 'gnu_)) (gno-pw k))))
                        (lambda ()
                          (let* ((c (dk-di-var!))
                                 (m (dk-pick (lambda (h) (equal? h (list 'IN c gno-PT))) "c in the points"))
                                 (p (list c x0)) (r (list c x1)) (q (list 'f c)))
                            (dk-rewrite-h! m gno-PT gno-CH)
                            (dk-cite! 'gelfand-transform-value 'a d c)
                            (dk-cite! 'gno-char-sub 'a c x0 x1)
                            (subst (list '= (list gd c) (list c d)))
                            (subst (list '= (list c d) (list '- p r)))
                            (dk-cite! 'character-in-fun 'a c)
                            (for-each (lambda (u) (dk-cite! 'fun-apply-type-c c '(VEC a) 'CC u)) (list x0 x1))
                            (dk-cite! 'fun-apply-type-c 'f gno-CH 'CC c)
                            (let* ((pq (list '- p q)) (rq (list '- r q)))
                              (dk-cite! 'cc-sub-in-cc p q) (dk-cite! 'cc-sub-in-cc r q) (dk-cite! 'cc-sub-in-cc p r)
                              (dk-have! (list '= (list '- p r) (list '- pq rq)) (lambda () (crs)))
                              (subst (list '= (list '- p r) (list '- pq rq)))
                              (dk-cite! 'cc-sub-in-cc pq rq)
                              (let* ((tri (dk-cite! 'cc-magnitude-sub-triangle pq rq))
                                     (a1 (dk-apply! (dk-apply! inv k) c))
                                     (a2 (dk-apply! (dk-apply! inv k1) c)))
                                (for-each (lambda (z) (dk-cite! 'cc-magnitude-closed z)) (list pq rq (list '- pq rq)))
                                (dk-ineq! tri a1 a2
                                          (list '= (gno-pw (list 'succ k)) (list '* 1/2 (gno-pw k)))
                                          (list '= (gno-pw (list 'succ k1)) (list '* 1/2 (gno-pw k1)))
                                          (list '< 0 (gno-pw k))
                                          (list 'IN (gno-pw k) 'RR) (list 'IN (gno-pw k1) 'RR) (list 'IN (gno-pw (list 'succ k1)) 'RR)
                                          (list 'IN (list 'magnitude pq) 'RR) (list 'IN (list 'magnitude rq) 'RR)
                                          (list 'IN (list 'magnitude (list '- pq rq)) 'RR)))))))))
              (let ((sl (gno-cite2! 'sup-norm-t-least gno-T gd (gno-pw k))))
                (dk-split-all! (list sl))
                (subst (list '= (list (list 'DIST gno-bam) x0 x1) (list '(VNRM a) d)))
                (subst (list '= (list '(VNRM a) d) (list 'SUP-NORM-T gno-T gd)))
                (dk-ass!))))))
      ;; (D) the sequence converges
      (let* ((stb (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'DIST))) "the distance bound"))
             (rad gno-rad))
        (dk-cite! 'ban-pts 'a)
        (dk-cite! 'bal-uba-complete 'a)
        (dk-rewrite-h! sf '(VEC a) (list 'PTS gno-bam))
        (dk-have! (list 'IN rad '(FUN NN RR))
          (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (gno-hp! v) (gno-ass!))))))
        (dk-have! '(<= 0 1/2) (lambda () (arith)))
        (dk-have! '(< 1/2 1) (lambda () (arith)))
        (gno-cite2! 'geometric-series-converges 1/2)
        (dk-have! (list 'FORALL 'gnk_ (list 'IMPLIES '(IN gnk_ NN)
                    (list '<= (list (list 'DIST gno-bam) (list s 'gnk_) (list s '(succ gnk_))) (list rad 'gnk_))))
          (lambda ()
            (let ((k (dk-di-var!)))
              (dk-lam-b!)
              (dk-apply! stb k)
              (gno-ass!))))
        (let* ((cv (gno-cite2! 'summable-bound-converges gno-bam s rad))
               (ex (dk-landed-1 (lambda () (mac-h 'converges cv))))
               (lm (dk-skolem! ex)))
          (dk-project! (list 'IN lm (list 'PTS gno-bam)) 'converges-to (list 'CONVERGES-TO gno-bam s lm))
          (dk-have! (list 'IN lm '(VEC a)) (lambda () (subst (list '== '(VEC a) (list 'PTS gno-bam))) (dk-ass!)))
          ;; (E) the limit is the preimage of f
          (ew lm)
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'IN)
                  (dk-ass!)
                  (dk-fun-ext! (gno-G lm) 'f gno-CH 'CC
                    (lambda () (dk-cite! 'gelfand-transform-in-fun 'a lm) (gno-ass!))
                    (lambda () (gno-ass!))
                    (lambda (c)
                      (let* ((fc (list 'f c)) (cl (list c lm))
                             (hh (list 'VNB-LAMBDA 'gnu_ 'NN (list c (list s 'gnu_)))))
                        (dk-cite! 'gelfand-transform-value 'a lm c)
                        (subst (list '= (list (gno-G lm) c) cl))
                        (dk-cite! 'gno-char-linear 'a c)
                        (dk-cite! 'character-in-fun 'a c)
                        (dk-cite! 'character-bounded 'a c)
                        (dk-cite! 'fun-apply-type-c 'f gno-CH 'CC c)
                        (let ((tyc! (lambda (v) (typ! v) (dk-cite! 'fun-apply-type-c c '(VEC a) 'CC (list s v)))))
                          (dk-have! (list 'IN hh '(FUN NN CC))
                            (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (tyc! v) (gno-ass!))))))
                          (dk-have! (list 'FORALL 'gnm_ (list 'IMPLIES '(IN gnm_ NN) (list '= (list hh 'gnm_) (list c (list s 'gnm_)))))
                            (lambda () (let ((v (dk-di-var!))) (tyc! v) (dk-lam-b!) (if (gno-open?) (rfl)))))
                          (gno-cite2! 'bgf-psi-conv 'a c s lm hh)
                          (dk-cite! 'cc-is-metric-space)
                          (dk-cite! 'cc-ms@pts)
                          (dk-rewrite-h! (list 'IN hh '(FUN NN CC)) 'CC '(PTS CC-MS))
                          (dk-rewrite-h! (list 'IN fc 'CC) 'CC '(PTS CC-MS))
                          (let* ((ch2 (dk-cite! 'converges-dist-null-bwd 'CC-MS hh fc))
                                 (dl (caddr (cadr ch2))))
                            (detach-with! ch2
                              (lambda ()
                                (let ((ptw! (lambda (v)
                                              (tyc! v) (dk-lam-b!)
                                              (let ((cs (list c (list s v))))
                                                (dk-cite! 'cc-ms-dist cs fc)
                                                (subst (list '= (list '(DIST CC-MS) cs fc) (list 'magnitude (list '- cs fc))))
                                                (dk-cite! 'cc-sub-in-cc cs fc)
                                                (dk-cite! 'cc-magnitude-closed (list '- cs fc))
                                                (list '- cs fc)))))
                                  (dk-have! (list 'IN dl '(FUN NN RR))
                                    (lambda () (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (ptw! v) (gno-ass!))))))
                                  (dk-have! '(< (abs 1/2) 1) (lambda () (arith)))
                                  (gno-cite2! 'power-tends-to-zero 1/2)
                                  (dk-have! (list 'FORALL 'gnm_ (list 'IMPLIES '(IN gnm_ NN)
                                              (list 'AND (list '<= 0 (list dl 'gnm_)) (list '<= (list dl 'gnm_) (list rad 'gnm_)))))
                                    (lambda ()
                                      (let* ((v (dk-di-var!)) (d (ptw! v))
                                             (a1 (dk-apply! (dk-apply! inv v) c)))
                                        (gno-hp! v)
                                        (dk-cite! 'nn-succ-closed v)
                                        (gno-hp! (list 'succ v))
                                        (dk-cite! 'cc-magnitude-nonneg d)
                                        (dk-conj-close!
                                          (lambda ()
                                            (dk-ineq! a1 (list '<= 0 (list 'magnitude d))
                                                      (list '= (gno-pw (list 'succ v)) (list '* 1/2 (gno-pw v)))
                                                      (list '< 0 (gno-pw v)) (list 'IN (gno-pw v) 'RR)
                                                      (list 'IN (gno-pw (list 'succ v)) 'RR) (list 'IN (list 'magnitude d) 'RR)))))))
                                  (gno-cite2! 'rr-null-squeeze rad dl)
                                  (gno-ass!)))))
                          (dk-cite! 'metric-limit-unique 'CC-MS hh cl fc)
                          (gno-ass!)))))))))))))
(gno-qed! 'gno-closed-range)

;;; ==== the involutive-algebra forms of the Gelfand facts (through the view UIBA-AS-UBA) ================
(define gno-B '(UIBA-AS-UBA a))
(define (gno-views!)
  (dk-cite! 'bcs-uiba-is-uba 'a)
  (dk-cite! 'b2g-gelfand-transform-view 'a)
  (dk-cite! 'b2g-gelfand-space-view 'a)
  (dk-cite! 'bcs-characters-view 'a)
  (dk-cite! 'bcp-ro-vec 'a)
  (dk-cite! 'bcp-ro-vnrm 'a))
(define (gno-to-B!)                   ; rewrite the a-level heads of the goal to the view's
  (for-each (lambda (h)
              (if (dk-contains? (dk-goal) (list h 'a))
                  (subst (list '= (list h 'a) (list h gno-B)))))
            '(GELFAND-SPACE GELFAND-TRANSFORM CHARACTERS VEC VNRM)))
(define (gno-hyp-to-B! f)             ; f in context: land its view form
  (let loop ((f f) (hs '(GELFAND-SPACE GELFAND-TRANSFORM CHARACTERS VEC VNRM)))
    (cond ((null? hs) f)
          ((dk-contains? f (list (car hs) 'a)) (loop (dk-rewrite-h! f (list (car hs) 'a) (list (car hs) gno-B)) (cdr hs)))
          (#t (loop f (cdr hs))))))

(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (== (PTS (GELFAND-SPACE a)) (CHARACTERS a))))))
(dk-peel!) (gno-views!) (gno-to-B!) (dk-cite! 'gelfand-space-pts gno-B) (gno-ass!)
(gno-qed! 'gno-u-pts)
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (IN (PTS (GELFAND-SPACE a)) SET)))))
(dk-peel!) (gno-views!) (gno-to-B!) (dk-cite! 'gelfand-space-pts gno-B) (dk-cite! 'characters-in-set gno-B)
(subst (list '== (list 'PTS (list 'GELFAND-SPACE gno-B)) (list 'CHARACTERS gno-B))) (gno-ass!)
(gno-qed! 'gno-u-pts-set)
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (IS-COMPACT-T (GELFAND-SPACE a))))))
(dk-peel!) (gno-views!) (gno-to-B!) (dk-cite! 'gelfand-space-compact gno-B) (gno-ass!)
(gno-qed! 'gno-u-compact)
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (FORALL x (IMPLIES (IN x (VEC a))
  (IN ((GELFAND-TRANSFORM a) x) (CCONT (GELFAND-SPACE a)))))))))
(dk-peel!) (gno-views!) (gno-hyp-to-B! '(IN x (VEC a))) (gno-to-B!) (dk-cite! 'gelfand-transform-in-ccont gno-B 'x) (gno-ass!)
(gno-qed! 'gno-u-in-ccont)
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (FORALL x (IMPLIES (IN x (VEC a))
  (FORALL c (IMPLIES (IN c (CHARACTERS a)) (= (((GELFAND-TRANSFORM a) x) c) (c x))))))))))
(dk-peel!) (gno-views!) (gno-hyp-to-B! '(IN x (VEC a))) (gno-hyp-to-B! '(IN c (CHARACTERS a))) (gno-to-B!)
(dk-cite! 'gelfand-transform-value gno-B 'x 'c) (gno-ass!)
(gno-qed! 'gno-u-value)

;;; c in CHARACTERS(a) in context: land c in FUN(VEC a, CC) and the four laws; return (add act mul one)
(define (gno-char-open! c)
  (let* ((m0 (list 'IN c '(CHARACTERS a)))
         (body (caddr (dk-cite! 'bas-characters-unfold 'a)))
         (m1 (dk-rewrite-h! m0 '(CHARACTERS a) body))
         (rest (subst-free 'bac_ c (caddr (cadddr body)))))
    (dk-project! (list 'IN c '(FUN (VEC a) CC)) (lambda () (sep-me m1)))
    (dk-project! (list 'IS-CC-LINEAR-ON 'a c) (lambda () (sep-me m1)))
    (dk-project! (cadr rest) (lambda () (sep-me m1)))
    (dk-project! (caddr rest) (lambda () (sep-me m1)))
    (let* ((ld (caddr (dk-cite! 'IS-CC-LINEAR-ON 'a c)))
           (la (dk-project! (cadr (caddr ld)) 'IS-CC-LINEAR-ON (list 'IS-CC-LINEAR-ON 'a c)))
           (lm (dk-project! (caddr (caddr ld)) 'IS-CC-LINEAR-ON (list 'IS-CC-LINEAR-ON 'a c))))
      (list la lm (cadr rest) (caddr rest)))))

;;; ==== the range of G is a point-separating unital self-adjoint subalgebra; Stone-Weierstrass ============
(define gno-R '(SEP gng_ (CCONT (GELFAND-SPACE a)) (FORSOME gny_ (AND (IN gny_ (VEC a)) (= gng_ ((GELFAND-TRANSFORM a) gny_))))))
(define (gno-uvt x)                   ; typing in VEC a for a unital involutive a
  (let ((want (list 'IN x '(VEC a))))
    (cond ((dk-asm? want) x)
          ((equal? x '(VONE a)) (dk-cite! 'ring-one-in-uba-as-ring-uiba-as-uba 'a) x)
          ((equal? x '(VZERO a)) (dk-cite! 'ring-zero-in-uba-as-ring-uiba-as-uba 'a) x)
          ((and (pair? x) (equal? (car x) '(VNEG a)))
           (gno-uvt (cadr x)) (dk-cite! 'ring-neg-in-carr-uba-as-ring-uiba-as-uba 'a (cadr x)) x)
          ((and (pair? x) (equal? (car x) '(VADD a)))
           (gno-uvt (cadr x)) (gno-uvt (caddr x)) (dk-cite! 'ring-add-closed-uba-as-ring-uiba-as-uba 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VMUL a)))
           (gno-uvt (cadr x)) (gno-uvt (caddr x)) (dk-cite! 'ring-carrier-closed-mul-uba-as-ring-uiba-as-uba 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(ACT a)))
           (gno-uvt (caddr x)) (dk-cite! 'bcp-u-bae-act-type 'a (cadr x) (caddr x)) x)
          ((and (pair? x) (equal? (car x) '(VSTAR a)))
           (gno-uvt (cadr x)) (dk-cite! 'bcp-star-fun 'a) (dk-cite! 'fun-apply-type-c '(VSTAR a) '(VEC a) '(VEC a) (cadr x)) x)
          (#t (error "gno-uvt: cannot type" (expression->string x))))))
;;; a member g of R in context: return the y with g = G(y) (landed)
(define (gno-range-open! g)
  (let* ((m (list 'IN g gno-R))
         (ex (dk-project! (list 'FORSOME 'gny_ (list 'AND '(IN gny_ (VEC a)) (list '= g '((GELFAND-TRANSFORM a) gny_))))
                          (lambda () (sep-me m)))))
    (dk-project! (list 'IN g '(CCONT (GELFAND-SPACE a))) (lambda () (sep-me m)))
    (dk-skolem! ex)))
;;; the goal (IN L R): L = G(y) proved pointwise by PTW (called with the point z, z in CHARACTERS a in
;;; context, the goal (= <L z reduced> (z y))), then membership
(define (gno-in-range! L y ptw)
  (gno-uvt y)
  (dk-cite! 'gno-u-in-ccont 'a y)
  (let ((gy (gno-G y)))
    (dk-fun-ext! L gy gno-PT 'CC
      (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!)))
                                            (dk-rewrite-h! (list 'IN z gno-PT) gno-PT gno-CH)
                                            (ptw z 'type)))))
      (lambda () (dk-split-all! (list (dk-cite! 'ccont-parts gno-T gy))) (gno-ass!))
      (lambda (z)
        (dk-rewrite-h! (list 'IN z gno-PT) gno-PT gno-CH)
        (dk-lam-b!)
        (dk-cite! 'gno-u-value 'a y z)
        (subst (list '= (list gy z) (list z y)))
        (ptw z 'value)))
    (in-sep! (lambda () (subst (list '= L gy)) (gno-ass!))
             (lambda () (ew y) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))

(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-C-STAR-ALGEBRA a) (list 'IS-CCONT-STAR-SUBALGEBRA gno-T gno-R)))))
(dk-peel!)
(dk-cite! 'bcp-ucsa-uiba 'a)
(gno-views!)
(dk-cite! 'gno-u-pts 'a)
(dk-cite! 'gno-u-pts-set 'a)
(mac 'IS-CCONT-STAR-SUBALGEBRA)
(let ((fa! (lambda (g) (dk-split-all! (list (dk-cite! 'ccont-parts gno-T g)))))
      (ap! (lambda (g z) (dk-cite! 'fun-apply-type-c g gno-PT 'CC z) (list g z))))
  (dk-conj-close!
    (lambda ()
      (let ((goal (dk-goal)))
        (cond
          ((dk-contains? goal 'IS-HOM-TOP-SPACE)
           (let* ((g (cadr (car (dk-peel!)))))
             (gno-range-open! g) (fa! g) (dk-conj-close! (lambda () (dk-ass!)))))
          ((dk-contains? goal 'conjugate)
           (let* ((g (cadr (car (dk-peel!)))) (y1 (gno-range-open! g)) (L (cadr (dk-goal))))
             (fa! g)
             (gno-in-range! L (list '(VSTAR a) y1)
               (lambda (z mode)
                 (if (eq? mode 'type)
                     (begin (ap! g z) (dk-cite! 'cc-conjugate-closed (list g z)) (gno-ass!))
                     (begin
                       (subst (list '= g (gno-G y1)))
                       (dk-cite! 'gno-u-value 'a y1 z)
                       (subst (list '= (list (gno-G y1) z) (list z y1)))
                       (dk-cite! 'character-preserves-involution 'a z y1)
                       (subst (list '= (list z (list '(VSTAR a) y1)) (list 'conjugate (list z y1))))
                       (if (gno-open?) (rfl))))))))
          ((or (dk-contains? goal '+) (dk-contains? goal '*))
           (let* ((ls (dk-peel!)) (g1 (cadr (car ls))) (g2 (cadr (cadr ls)))
                  (y1 (gno-range-open! g1)) (y2 (gno-range-open! g2)) (L (cadr (dk-goal)))
                  (op (if (dk-contains? goal '+) '+ '*)))
             (fa! g1) (fa! g2)
             (gno-in-range! L (list (if (eq? op '+) '(VADD a) '(VMUL a)) y1 y2)
               (lambda (z mode)
                 (if (eq? mode 'type)
                     (begin (ap! g1 z) (ap! g2 z)
                            (gno-cite2! (if (eq? op '+) 'cc-add-closed 'cc-mul-closed) (list g1 z) (list g2 z)) (gno-ass!))
                     (let ((laws (gno-char-open! z)))
                       (subst (list '= g1 (gno-G y1)))
                       (subst (list '= g2 (gno-G y2)))
                       (dk-cite! 'gno-u-value 'a y1 z) (dk-cite! 'gno-u-value 'a y2 z)
                       (subst (list '= (list (gno-G y1) z) (list z y1)))
                       (subst (list '= (list (gno-G y2) z) (list z y2)))
                       (let ((e (dk-apply! (if (eq? op '+) (car laws) (caddr laws)) y1 y2)))
                         (subst (list '= (cadr e) (caddr e))))
                       (if (gno-open?) (rfl))))))))
          (#t
           (let* ((c (cadr (car (dk-peel!)))) (L (cadr (dk-goal))))
             (gno-in-range! L (list '(ACT a) c '(VONE a))
               (lambda (z mode)
                 (if (eq? mode 'type)
                     (gno-ass!)
                     (let ((laws (gno-char-open! z)))
                       (gno-uvt '(VONE a))
                       (let ((e (dk-apply! (cadr laws) c '(VONE a))))
                         (subst (list '= (cadr e) (caddr e))))
                       (subst (list '= (list z '(VONE a)) 1))
                       (crs))))))))))))
(gno-qed! 'gno-range-star-subalgebra)

(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (list 'IS-POINT-SEPARATING gno-T gno-R)))))
(dk-peel!)
(gno-views!)
(dk-cite! 'gno-u-pts 'a)
(dk-cite! 'gno-u-pts-set 'a)
(mac 'IS-POINT-SEPARATING)
(let* ((ls0 (dk-peel!)) (ls (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) gno-PT))) (dk-asms-of (proof-state-focus *ps*))))
       (neq (dk-pick (lambda (h) (and (dk-head-is? h 'NOT) (dk-head-is? (cadr h) '=))) "p /= q"))
       (p (cadr (cadr neq))) (q (caddr (cadr neq))))
  (dk-rewrite-h! (list 'IN p gno-PT) gno-PT gno-CH)
  (dk-rewrite-h! (list 'IN q gno-PT) gno-PT gno-CH)
  (gno-char-open! p) (gno-char-open! q)
  (let ((pall (list 'FORALL 'gnx_ (list 'IMPLIES '(IN gnx_ (VEC a)) (list '= (list p 'gnx_) (list q 'gnx_))))))
    (use-em pall
      (lambda ()
        (dk-fun-ext! p q '(VEC a) 'CC (lambda () (gno-ass!)) (lambda () (gno-ass!))
                     (lambda (x) (dk-apply! pall x) (gno-ass!)))
        (keep (list '= p q) neq)
        (prop))
      (lambda ()
        (push-not-h (list 'NOT pall))
        (let* ((ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h p) (dk-contains? h q))) "the witness of difference"))
               (x (dk-skolem! ex)))
          (dk-cite! 'gno-u-in-ccont 'a x)
          (ew (gno-G x))
          (dk-conj-close!
            (lambda ()
              (if (dk-head-is? (dk-goal) 'IN)
                  (in-sep! (lambda () (gno-ass!))
                           (lambda () (ew x) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))
                  (begin
                    (dk-cite! 'gno-u-value 'a x p) (dk-cite! 'gno-u-value 'a x q)
                    (subst (list '= (list (gno-G x) p) (list p x)))
                    (subst (list '= (list (gno-G x) q) (list q x)))
                    (gno-ass!))))))))))
(gno-qed! 'gno-range-separating)

;;; ---- the range is uniformly dense (Stone-Weierstrass) ------------------------------------------------
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-C-STAR-ALGEBRA a)
  (list 'FORALL 'f (list 'IMPLIES '(IN f (CCONT (GELFAND-SPACE a))) gno-approx))))))
(dk-peel!)
(let* ((e (cadr (dk-pick (lambda (h) (dk-head-is? h 'POS-RR)) "the tolerance"))))
  (dk-cite! 'bcp-ucsa-uiba 'a)
  (gno-views!)
  (dk-cite! 'gno-u-pts 'a)
(dk-cite! 'gno-u-pts-set 'a)
  (dk-cite! 'gno-u-compact 'a)
  (dk-cite! 'gno-range-star-subalgebra 'a)
  (dk-cite! 'gno-range-separating 'a)
  (dk-split-all! (list (dk-cite! 'ccont-parts gno-T 'f)))
  (let* ((sw (gno-cite2! 'bsw-stone-weierstrass-complex gno-T gno-R 'f))
         (sg (dk-skolem! (dk-apply! sw e)))
         (apx (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h sg))) "the approximation"))
         (y (gno-range-open! sg)))
    (ew y)
    (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'IN)
            (gno-ass!)
            (let* ((c (cadr (car (dk-peel!)))))
              (dk-have! (list 'IN c gno-PT) (lambda () (subst (list '== gno-PT gno-CH)) (gno-ass!)))
              (gno-char-open! c)
              (dk-split-all! (list (dk-cite! 'ccont-parts gno-T sg)))
              (dk-cite! 'fun-apply-type-c 'f gno-PT 'CC c)
              (dk-cite! 'fun-apply-type-c c '(VEC a) 'CC y)
              (let* ((a1 (dk-apply! apx c))
                     (a2 (dk-rewrite-h! a1 sg (gno-G y)))
                     (v (dk-cite! 'gno-u-value 'a y c))
                     (a3 (dk-rewrite-h! a2 (list (gno-G y) c) (list c y)))
                     (sy (dk-cite! 'cc-magnitude-sub-sym (list 'f c) (list c y))))
                (subst (list '= (caddr sy) (cadr sy)))
                (gno-ass!))))))))
(gno-qed! 'gelfand-dense)

;;; ==== THEOREM 1.23, ONTO: every continuous function on A-hat is a Gelfand transform ====================
(sp (make-wff '(FORALL a (IMPLIES (IS-COMMUTATIVE-C-STAR-ALGEBRA a)
  (FORALL f (IMPLIES (IN f (CCONT (GELFAND-SPACE a)))
    (FORSOME gnx_ (AND (IN gnx_ (VEC a)) (= ((GELFAND-TRANSFORM a) gnx_) f)))))))))
(dk-peel!)
(dk-cite! 'bcs-ccsa-ucsa 'a)
(dk-cite! 'bcp-ucsa-uiba 'a)
(gno-views!)
(gno-to-B!)
(let* ((fB (gno-hyp-to-B! '(IN f (CCONT (GELFAND-SPACE a)))))
       (isoB (subst-free 'a gno-B gno-iso))
       (apxB (let ((r (subst-free 'a gno-B gno-approx))) r)))
  (dk-have! isoB
    (lambda ()
      (let ((x (cadr (car (dk-peel!)))))
        (for-each (lambda (h) (if (dk-contains? (dk-goal) (list h gno-B)) (subst (list '= (list h gno-B) (list h 'a)))))
                  '(GELFAND-SPACE GELFAND-TRANSFORM VNRM))
        (dk-rewrite-h! (list 'IN x (list 'VEC gno-B)) (list 'VEC gno-B) '(VEC a))
        (dk-cite! 'gelfand-isometric 'a x)
        (gno-ass!))))
  (dk-have! apxB
    (lambda ()
      (let ((e (cadr (car (dk-peel!)))))
        (for-each (lambda (h) (if (dk-contains? (dk-goal) (list h gno-B)) (subst (list '= (list h gno-B) (list h 'a)))))
                  '(VEC CHARACTERS))
        (dk-cite! 'gelfand-dense 'a 'f e)
        (gno-ass!))))
  (dk-apply! (dk-cite! 'gno-closed-range gno-B) 'f)
  (gno-ass!))
(gno-qed! 'gelfand-onto)

;;; ==== THEOREM 1.23, the full statement: G is an isometric *-isomorphism onto C(A-hat) ==================
(define gno-C (list 'CCONT-ALGEBRA gno-T))
(define gno-T-cc (list 'CCONT gno-T))
(define (gno-conjs f) (if (and (pair? f) (eq? (car f) 'AND)) (append (gno-conjs (cadr f)) (gno-conjs (caddr f))) (list f)))
(define (gno-lhs! iff) (if (not (dk-asm? (cadr iff))) (dk-iff-bwd! iff)))
(define gno-opmap '((VADD CCONT-VADD) (VZERO CCONT-VZERO) (VNEG CCONT-VNEG) (ACT CCONT-ACT) (VNRM CCONT-VNRM)
                    (VMUL CCONT-VMUL) (VONE CCONT-VONE) (VSTAR CCONT-VSTAR)))
(define (gno-ccsa-setup!)             ; a commutative C*-algebra: the views, T compact, T a top space, T nonempty
  (dk-cite! 'bcs-ccsa-ucsa 'a)
  (dk-cite! 'bcp-ucsa-uiba 'a)
  (gno-views!)
  (dk-cite! 'gno-u-pts 'a)
  (dk-cite! 'gno-u-pts-set 'a)
  (dk-cite! 'gno-u-compact 'a)
  (dk-project! (list 'IS-TOP-SPACE gno-T) 'IS-COMPACT-T (list 'IS-COMPACT-T gno-T))
  (dk-cite! 'bcs-uiba-scal-carr 'a)
  (dk-rewrite-h! (dk-cite! 'bal-uba-vec-set gno-B) (list 'VEC gno-B) '(VEC a))
  (for-each (lambda (n) (dk-cite! n gno-T))
            '(ccont-algebra-vec ccont-algebra-vadd ccont-algebra-vzero ccont-algebra-vneg ccont-algebra-act
              ccont-algebra-vnrm ccont-algebra-vmul ccont-algebra-vone ccont-algebra-vstar ccont-algebra-scal)))
(define (gno-lin-B! z)               ; z a character of a: IS-CC-LINEAR-ON(B, z)
  (let ((m (list 'IN z (list 'CHARACTERS gno-B))))
    (if (not (dk-asm? m)) (dk-have! m (lambda () (subst (list '== (list 'CHARACTERS gno-B) gno-CH)) (gno-ass!))))
    (dk-cite! 'bcp-ro-vzero 'a) (dk-cite! 'bcp-ro-vneg 'a)
    (dk-cite! 'gno-char-linear gno-B z)))
(define (gno-nonempty!)               ; land forsome([tp_], tp_ in pts(T))
  (let ((goal (list 'FORSOME 'tp_ (list 'IN 'tp_ gno-PT))))
    (if (not (dk-asm? goal))
        (dk-have! goal
          (lambda ()
            (dk-cite! 'b2g-ccsa-commutative-view 'a)
            (dk-cite! 'ring-one-in-uba-as-ring-uiba-as-uba 'a)
            (dk-rewrite-h! '(IN (VONE a) (VEC a)) '(VEC a) (list 'VEC gno-B))
            (dk-cite! 'bcp-ro-vone 'a)
            (let* ((z (dk-skolem! (dk-cite! 'spectrum-nonempty gno-B '(VONE a))))
                   (ch (dk-skolem! (dk-cite! 'spectrum-character-value gno-B '(VONE a) z))))
              (dk-rewrite-h! (list 'IN ch (list 'CHARACTERS gno-B)) (list 'CHARACTERS gno-B) gno-CH)
              (dk-rewrite-h! (list 'IN ch gno-CH) gno-CH gno-PT)
              (ew ch)
              (gno-ass!)))))))

(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a)
  (list 'IS-HOM-COMMUTATIVE-C-STAR-ALGEBRA 'a gno-C '(GELFAND-TRANSFORM a))))))
(dk-peel!)
(gno-ccsa-setup!)
(gno-nonempty!)
(dk-cite! 'ccont-algebra-commutative-c-star gno-T)
(dk-cite! 'ccont-algebra-unital-c-star gno-T)
(dk-cite! 'bcs-ucsa-uiba gno-C)
(let* ((Gf '(GELFAND-TRANSFORM a))
       (rew! (lambda ()             ; the C-accessors of the goal to the CCONT operations
               (for-each (lambda (p) (if (dk-contains? (dk-goal) (list (car p) gno-C))
                                         (subst (list '== (list (car p) gno-C) (list (cadr p) gno-T)))))
                         '((VADD CCONT-VADD) (VZERO CCONT-VZERO) (VNEG CCONT-VNEG) (ACT CCONT-ACT) (VNRM CCONT-VNRM)
                           (VMUL CCONT-VMUL) (VONE CCONT-VONE) (VSTAR CCONT-VSTAR)))
               (if (dk-contains? (dk-goal) (list 'VEC gno-C)) (subst (list '== (list 'VEC gno-C) (list 'CCONT gno-T))))))
       (gin! (lambda (x) (gno-uvt x) (dk-cite! 'gno-u-in-ccont 'a x) (gno-G x)))
       (val! (lambda (x z)          ; rewrite G(x)(z) to z(x) in the goal
               (dk-cite! 'gno-u-value 'a x z)
               (if (dk-contains? (dk-goal) (list (gno-G x) z)) (subst (list '= (list (gno-G x) z) (list z x))))))
       ;; goal L = R with L = G(x0) and R a CCONT operation in CCONT(T) (RIN! lands that); PTW! at the point z
       (ptw! (lambda (L R rin! ptw)
               (dk-fun-ext! L R gno-PT 'CC
                 (lambda () (dk-split-all! (list (dk-cite! 'ccont-parts gno-T L))) (gno-ass!))
                 (lambda () (rin!) (dk-split-all! (list (dk-cite! 'ccont-parts gno-T R))) (gno-ass!))
                 (lambda (z) (dk-rewrite-h! (list 'IN z gno-PT) gno-PT gno-CH)
                             (ptw z))))))
  (let* ((hc (dk-cite! 'is-hom-commutative-c-star-algebra-def 'a gno-C Gf))
         (hu (dk-cite! 'is-hom-unital-c-star-algebra-def 'a gno-C Gf))
         (hi (dk-cite! 'is-hom-unital-involutive-banach-algebra-def 'a gno-C Gf)))
    (define (rt f)
      (cond ((equal? f (list 'VEC gno-C)) gno-T-cc)
            ((and (pair? f) (= (length f) 2) (equal? (cadr f) gno-C) (assq (car f) gno-opmap))
             (list (cadr (assq (car f) gno-opmap)) gno-T))
            ((pair? f) (map rt f))
            (#t f)))
    (define (conjs f) (if (dk-head-is? f 'AND) (append (conjs (cadr f)) (conjs (caddr f))) (list f)))
    (for-each (lambda (cj)
      (dk-have! cj
          (lambda ()
            (let ((g (dk-goal)))
              (cond
                ((dk-asm? g) (dk-ass!))
                ((dk-head-is? g 'IN)                       ; G in FUN(VEC a, CCONT T)
                 (mac 'GELFAND-TRANSFORM)
                 (dk-lam-type!
                   (lambda ()
                     (let* ((x (dk-di-var!)) (lam (caddr (dk-goal))))
                       (gin! x)
                       (dk-have! (list '= (gno-G x) (cadr (dk-goal)))
                         (lambda () (mac 'GELFAND-TRANSFORM) (if (not (dk-lam-b!)) (rfl))))
                       (dk-rewrite-h! (list 'IN (gno-G x) gno-T-cc) (gno-G x) (cadr (dk-goal)))
                       (gno-ass!)))))
                ((and (dk-head-is? g '=) (dk-contains? g 'SCAL))
                 (dk-cite! 'bcp-u-bal-uba-scal-pin 'a)
                 (subst (list '== (list 'SCAL gno-C) '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)))
                 (gno-ass!))
                ((dk-head-is? g '=)                        ; G(0) = 0, G(1) = 1
                 (let* ((x0 (cadr (cadr g))) (R (caddr g)))
                   (ptw! (gin! x0) R (lambda () (dk-cite! (if (dk-contains? R 'CCONT-VZERO) 'ccont-vzero-type 'ccont-vone-type) gno-T))
                     (lambda (z)
                       (let ((laws (gno-char-open! z)))
                         (val! x0 z)
                         (if (dk-contains? R 'CCONT-VZERO)
                             (begin (dk-cite! 'ccont-vzero-val gno-T z) (subst (list '= (list R z) 0))
                                    (gno-lin-B! z) (dk-cite! 'bgf-psi-zero gno-B z) (dk-rewrite-h! (list '= (list z (list 'VZERO gno-B)) 0) (list 'VZERO gno-B) '(VZERO a)))
                             (begin (dk-cite! 'ccont-vone-val gno-T z) (subst (list '= (list R z) 1))))
                         (gno-ass!))))))
                (#t
                 (let* ((ls (dk-peel!)) (g2 (dk-goal)))
                   (if (dk-contains? g2 'VNRM)
                       (let ((x (cadr (car ls))))
                         (gin! x)
                         (dk-cite! 'ccont-vnrm-val gno-T (gno-G x))
                         (subst (list '= (list (list 'CCONT-VNRM gno-T) (gno-G x)) (list 'SUP-NORM-T gno-T (gno-G x))))
                         (subst (dk-cite! 'gelfand-isometric 'a x))
                         (if (gno-open?) (rfl)))
                       (let* ((L (cadr g2)) (R (caddr g2)) (arg (cadr L)) (op (car arg)) (vs (map cadr ls)))
                         (if (equal? op '(ACT a)) (dk-rewrite-h! (list 'IN (car vs) '(CARR (SCAL a))) '(CARR (SCAL a)) 'CC))
                         (gin! arg) (for-each (lambda (v) (if (dk-asm? (list 'IN v '(VEC a))) (gin! v))) vs)
                         (cond
                           ((equal? op '(VADD a))
                            (ptw! L R (lambda () (dk-cite! 'ccont-vadd-in gno-T (gno-G (car vs)) (gno-G (cadr vs))))
                              (lambda (z) (let ((laws (gno-char-open! z)))
                                (val! arg z) (subst (dk-apply! (car laws) (car vs) (cadr vs)))
                                (dk-cite! 'ccont-vadd-val gno-T (gno-G (car vs)) (gno-G (cadr vs)) z)
                                (subst (list '= (list R z) (list '+ (list (gno-G (car vs)) z) (list (gno-G (cadr vs)) z))))
                                (val! (car vs) z) (val! (cadr vs) z) (if (gno-open?) (rfl))))))
                           ((equal? op '(VMUL a))
                            (ptw! L R (lambda () (dk-cite! 'ccont-vmul-in gno-T (gno-G (car vs)) (gno-G (cadr vs))))
                              (lambda (z) (let ((laws (gno-char-open! z)))
                                (val! arg z) (subst (dk-apply! (caddr laws) (car vs) (cadr vs)))
                                (dk-cite! 'ccont-vmul-val gno-T (gno-G (car vs)) (gno-G (cadr vs)) z)
                                (subst (list '= (list R z) (list '* (list (gno-G (car vs)) z) (list (gno-G (cadr vs)) z))))
                                (val! (car vs) z) (val! (cadr vs) z) (if (gno-open?) (rfl))))))
                           ((equal? op '(ACT a))
                            (let ((c (car vs)) (x (cadr vs)))
                              (ptw! L R (lambda () (dk-cite! 'ccont-act-in gno-T c (gno-G x)))
                                (lambda (z) (let ((laws (gno-char-open! z)))
                                  (val! arg z) (subst (dk-apply! (cadr laws) c x))
                                  (dk-cite! 'ccont-act-val gno-T c (gno-G x) z)
                                  (subst (list '= (list R z) (list '* c (list (gno-G x) z))))
                                  (val! x z) (if (gno-open?) (rfl)))))))
                           ((equal? op '(VNEG a))
                            (let ((x (car vs)))
                              (ptw! L R (lambda () (dk-cite! 'ccont-vneg-in gno-T (gno-G x)))
                                (lambda (z) (let ((laws (gno-char-open! z)))
                                  (val! arg z)
                                  (gno-lin-B! z)
                                  (dk-have! (list 'IN x (list 'VEC gno-B)) (lambda () (subst (list '== (list 'VEC gno-B) '(VEC a))) (gno-ass!)))
                                  (subst (list '= '(VNEG a) (list 'VNEG gno-B)))
                                  (let ((e (dk-cite! 'bsn-psi-neg gno-B z x)))
                                    (subst e))
                                  (dk-cite! 'ccont-vneg-val gno-T (gno-G x) z)
                                  (subst (list '= (list R z) (list '- (list (gno-G x) z))))
                                  (val! x z) (if (gno-open?) (rfl)))))))
                           (#t                                   ; VSTAR
                            (let ((x (car vs)))
                              (ptw! L R (lambda () (dk-cite! 'ccont-vstar-in gno-T (gno-G x)))
                                (lambda (z)
                                  (val! arg z)
                                  (dk-cite! 'character-preserves-involution 'a z x)
                                  (subst (list '= (list z arg) (list 'conjugate (list z x))))
                                  (dk-cite! 'ccont-vstar-val gno-T (gno-G x) z)
                                  (subst (list '= (list R z) (list 'conjugate (list (gno-G x) z))))
                                  (val! x z) (if (gno-open?) (rfl)))))))))))))))
        )
      (conjs (rt (caddr hi))))
    (dk-have! (caddr hi) (lambda () (rew!) (dk-conj-close! (lambda () (gno-ass!)))))
    (gno-lhs! hi)
    (dk-have! (caddr hu) (lambda () (dk-conj-close! (lambda () (gno-ass!)))))
    (gno-lhs! hu)
    (dk-have! (caddr hc) (lambda () (dk-conj-close! (lambda () (gno-ass!)))))
    (gno-lhs! hc)
    (gno-ass!)))
(gno-qed! 'gelfand-star-iso)

;;; =====================================================================================================
;;; PROPOSITION 1.31 IN A COMMUTATIVE C*-ALGEBRA: the continuous functional calculus  f |-> f(x), the
;;; element whose Gelfand transform is f o G(x) (CFC, gn-vocab).  sigma(x) is the range of G(x)
;;; (1.16), so f o G(x) is continuous on A-hat for f continuous on sigma(x), and 1.23 supplies a
;;; unique preimage.  The notes' general case (a normal in any C*-algebra) applies this to the
;;; commutative C*-algebra C*(a, 1) -- see the report (the restriction of a to CSTAR-GEN is not a
;;; structure of the tree yet).
;;; =====================================================================================================
(define gno-S '(SPECTRUM a x))
(define gno-K '(SPEC-TOP a x))
(define gno-MT '(METRIC-TOP CC-MS))
(define gno-Gx (gno-G 'x))

;;; the unfolding of SPECTRUM, as a theorem
(sp (make-wff '(FORALL a (FORALL x (== (SPECTRUM a x) (SEP baz_ CC (NOT (IS-INVERTIBLE-EL a (SHIFT-EL a baz_ x)))))))))
(di) (mac 'SPECTRUM) (qrfl)
(gno-qed! 'spectrum-unfold)

;;; the values of G(x) lie in the spectrum (an involutive algebra; through the view)
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (FORALL x (IMPLIES (IN x (VEC a))
  (FORALL c (IMPLIES (IN c (CHARACTERS a)) (IN (c x) (SPECTRUM a x))))))))))
(dk-peel!)
(gno-views!)
(let* ((xb (gno-hyp-to-B! '(IN x (VEC a))))
       (cb (gno-hyp-to-B! '(IN c (CHARACTERS a))))
       (m (dk-cite! 'character-value-in-spectrum gno-B 'x 'c))
       (un (dk-cite! 'spectrum-unfold gno-B 'x))
       (m1 (dk-rewrite-h! m (cadr un) (caddr un)))
       (z '(c x)))
  (sep-me m1) (dk-split-all!)
  (dk-cite! 'bcp-shift-view 'a z 'x)
  (let* ((nb (dk-pick (lambda (h) (and (dk-head-is? h 'NOT) (dk-contains? h 'IS-INVERTIBLE-EL))) "not invertible in the view"))
         (nb2 (dk-rewrite-h! nb (list 'SHIFT-EL gno-B z 'x) (list 'SHIFT-EL 'a z 'x)))
         (_t (dk-cite! 'bcp-u-bas-shift-type 'a z 'x))
         (iff (dk-cite! 'bcp-invertible-view 'a (list 'SHIFT-EL 'a z 'x))))
    (dk-have! (list 'NOT (list 'IS-INVERTIBLE-EL 'a (list 'SHIFT-EL 'a z 'x))) (lambda () (if (dk-only! nb2 iff) (prop))))
    (subst (dk-cite! 'spectrum-unfold 'a 'x))
    (in-sep! (lambda () (gno-ass!)) (lambda () (gno-ass!)))))
(gno-qed! 'gelfand-value-in-spectrum)

(sp (make-wff '(FORALL a (FORALL x (== (SPEC-TOP a x) (SUBSPACE-TOP (METRIC-TOP CC-MS) (SPECTRUM a x)))))))
(di) (mac 'SPEC-TOP) (qrfl)
(gno-qed! 'spec-top-unfold)

(define (gno-spec-facts!)             ; land S subset CC, S in set, PTS(MT) == CC, PTS(K) == S, MT and K top spaces
  (let ((un (dk-cite! 'spectrum-unfold 'a 'x)))
    (dk-cite! 'cc-is-set)
    (dk-have! (list 'SUBSET gno-S 'CC)
      (lambda () (mac 'subset-def)
        (let ((z (dk-di-var!))) (sep-me (dk-rewrite-h! (list 'IN z gno-S) (cadr un) (caddr un))) (dk-split-all!) (gno-ass!))))
    (dk-cite! 'subclass-of-set-is-set gno-S 'CC)
    (dk-cite! 'cc-is-metric-space)
    (dk-cite! 'metric-top-is-top-space 'CC-MS)
    (dk-cite! 'metric-top-pts 'CC-MS)
    (dk-cite! 'cc-ms@pts)
    (dk-have! (list '== (list 'PTS gno-MT) 'CC) (lambda () (subst (list '== (list 'PTS gno-MT) '(PTS CC-MS))) (gno-ass!)))
    (dk-have! (list 'SUBSET gno-S (list 'PTS gno-MT)) (lambda () (subst (list '== (list 'PTS gno-MT) 'CC)) (gno-ass!)))
    (dk-cite! 'spec-top-unfold 'a 'x)
    (dk-cite! 'subspace-top-pts gno-MT gno-S)
    (dk-cite! 'subspace-top-is-top-space gno-MT gno-S)
    (dk-have! (list '== (list 'PTS gno-K) gno-S)
      (lambda () (subst (list '== gno-K (list 'SUBSPACE-TOP gno-MT gno-S))) (gno-ass!)))
    (dk-have! (list 'IS-TOP-SPACE gno-K)
      (lambda () (subst (list '== gno-K (list 'SUBSPACE-TOP gno-MT gno-S))) (gno-ass!)))))

;;; G(x) is a continuous map of A-hat onto (into) sigma(x)
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list 'IS-HOM-TOP-SPACE gno-T gno-K gno-Gx)))))))
(dk-peel!)
(gno-views!)
(gno-spec-facts!)
(dk-cite! 'gno-u-pts 'a)
(let* ((xb (gno-hyp-to-B! '(IN x (VEC a))))
       (h0 (dk-cite! 'gelfand-transform-continuous gno-B 'x))
       (h1 (dk-rewrite-h! (dk-rewrite-h! h0 (list 'GELFAND-SPACE gno-B) gno-T) (list 'GELFAND-TRANSFORM gno-B) '(GELFAND-TRANSFORM a)))
       (_t (dk-cite! 'gno-u-in-ccont 'a 'x))
       (imp (dk-cite! 'hom-into-subspace gno-T gno-MT gno-S gno-Gx)))
  (detach-with! imp
    (lambda ()
      (let ((p (dk-di-var!)))
        (dk-rewrite-h! (list 'IN p gno-PT) gno-PT gno-CH)
        (dk-cite! 'gno-u-value 'a 'x p)
        (subst (list '= (list gno-Gx p) (list p 'x)))
        (dk-cite! 'gelfand-value-in-spectrum 'a 'x p)
        (gno-ass!))))
  (subst (list '== gno-K (list 'SUBSPACE-TOP gno-MT gno-S)))
  (gno-ass!))
(gno-qed! 'gelfand-into-spectrum-continuous)

;;; f o G(x) is continuous on A-hat for f continuous on sigma(x)
(define gno-fG (list 'COMPOSE 'f gno-Gx))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list 'FORALL 'f (list 'IMPLIES (list 'IN 'f (list 'CCONT gno-K)) (list 'IN gno-fG (list 'CCONT gno-T))))))))))
(dk-peel!)
(gno-views!)
(gno-spec-facts!)
(dk-cite! 'gno-u-pts-set 'a)
(let* ((_t (dk-cite! 'gno-u-in-ccont 'a 'x))
       (hg (dk-cite! 'gelfand-into-spectrum-continuous 'a 'x))
       (gf (dk-project! (list 'IN gno-Gx (list 'FUN gno-PT (list 'PTS gno-K))) 'is-hom-top-space-def hg)))
  (dk-split-all! (list (dk-cite! 'ccont-parts gno-K 'f)))
  (gno-cite2! 'hom-top-space-compose gno-T gno-K gno-MT gno-Gx 'f)
  (gno-cite2! 'compose-type gno-PT (list 'PTS gno-K) 'CC 'f gno-Gx)
  (subst (dk-cite! 'ccont-unfold gno-T))
  (in-sep! (lambda () (gno-ass!)) (lambda () (gno-ass!))))
(gno-qed! 'compose-gelfand-in-ccont)

;;; ---- G is injective (it is isometric) ----
(define (gno-rsubst! e)                ; e = (= L R) in context: rewrite R to L in the goal
  (let ((L (cadr e)) (R (caddr e)))
    (dk-have! (list '= R L) (lambda () (subst e) (if (gno-open?) (rfl))))
    (subst (list '= R L))))
(sp (make-wff '(FORALL a (IMPLIES (IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (FORALL y (IMPLIES (IN y (VEC a)) (FORALL z (IMPLIES (IN z (VEC a))
  (IMPLIES (= ((VADD a) y ((VNEG a) z)) (VZERO a)) (= y z))))))))))
(dk-peel!)
(let* ((w (gno-ad 'y (gno-ng 'z))) (h1 (list '= (gno-ad w 'z) 'y)))
  (gno-uvt w) (gno-uvt (gno-ad w 'z)) (gno-uvt '(VZERO a))
  (dk-have! h1
    (lambda ()
      (subst (dk-cite! 'ring-add-assoc-uba-as-ring-uiba-as-uba 'a 'y (gno-ng 'z) 'z))
      (subst (dk-cite! 'ring-add-left-inv-uba-as-ring-uiba-as-uba 'a 'z))
      (subst (dk-cite! 'ring-add-right-id-uba-as-ring-uiba-as-uba 'a 'y))
      (if (gno-open?) (rfl))))
  (let* ((h2 (dk-rewrite-h! h1 w '(VZERO a)))
         (_l (dk-cite! 'ring-add-left-id-uba-as-ring-uiba-as-uba 'a 'z))
         (h3 (dk-rewrite-h! h2 (gno-ad '(VZERO a) 'z) 'z)))
    (subst h3)
    (if (gno-open?) (rfl))))
(gno-qed! 'uiba-sub-zero-eq)

(sp (make-wff '(FORALL a (IMPLIES (IS-COMMUTATIVE-C-STAR-ALGEBRA a) (FORALL y (IMPLIES (IN y (VEC a)) (FORALL z (IMPLIES (IN z (VEC a))
  (IMPLIES (= ((GELFAND-TRANSFORM a) y) ((GELFAND-TRANSFORM a) z)) (= y z))))))))))
(dk-peel!)
(gno-ccsa-setup!)
(dk-cite! 'bcp-ro-vadd 'a) (dk-cite! 'bcp-ro-vneg 'a) (dk-cite! 'bcp-ro-vzero 'a)
(let ((w (gno-ad 'y (gno-ng 'z))))
  (gno-uvt w)
  (dk-cite! 'gno-u-in-ccont 'a w)
  (dk-split-all! (list (dk-cite! 'ccont-parts gno-T (gno-G w))))
  (let ((imp (dk-cite! 'sup-norm-t-zero-intro gno-T (gno-G w))))
    (detach-with! imp
      (lambda ()
        (let ((p (dk-di-var!)))
          (dk-rewrite-h! (list 'IN p gno-PT) gno-PT gno-CH)
          (dk-cite! 'gno-u-value 'a w p)
          (subst (list '= (list (gno-G w) p) (list p w)))
          (gno-char-open! p)
          (gno-lin-B! p)
          (dk-have! (list 'IN 'y (list 'VEC gno-B)) (lambda () (subst (list '== (list 'VEC gno-B) '(VEC a))) (gno-ass!)))
          (dk-have! (list 'IN 'z (list 'VEC gno-B)) (lambda () (subst (list '== (list 'VEC gno-B) '(VEC a))) (gno-ass!)))
          (let ((e (dk-cite! 'gno-char-sub gno-B p 'y 'z)))
            (dk-rewrite-h! (dk-rewrite-h! e (list 'VNEG gno-B) '(VNEG a)) (list 'VADD gno-B) '(VADD a)))
          (subst (list '= (list p w) (list '- (list p 'y) (list p 'z))))
          (dk-cite! 'gno-u-value 'a 'y p) (dk-cite! 'gno-u-value 'a 'z p)
          (dk-have! (list '= (list p 'y) (list p 'z))
            (lambda ()
              (gno-rsubst! (list '= (list (gno-G 'y) p) (list p 'y)))
              (subst (list '= (gno-G 'y) (gno-G 'z)))
              (subst (list '= (list (gno-G 'z) p) (list p 'z)))
              (if (gno-open?) (begin (dk-cite! 'fun-apply-type-c p '(VEC a) 'CC 'z) (rfl)))))
          (subst (list '= (list p 'y) (list p 'z)))
          (dk-cite! 'fun-apply-type-c p '(VEC a) 'CC 'z)
          (if (gno-open?) (crs)))))
    (dk-cite! 'gelfand-isometric 'a w)
    (let* ((nz (dk-have! (list '= (list '(VNRM a) w) 0)
                 (lambda () (gno-rsubst! (list '= (list 'SUP-NORM-T gno-T (gno-G w)) (list '(VNRM a) w))) (gno-ass!))))
           (iff (dk-cite! 'bal-uba-vnrm-definite gno-B w)))
      (dk-have! (list '= w '(VZERO a))
        (lambda ()
          (dk-have! (list 'IN w (list 'VEC gno-B)) (lambda () (subst (list '== (list 'VEC gno-B) '(VEC a))) (gno-ass!)))
          (let* ((iff2 (dk-cite! 'bal-uba-vnrm-definite gno-B w))
                 (iff3 (fold-left (lambda (f h) (if (dk-contains? f (list h gno-B)) (dk-rewrite-h! f (list h gno-B) (list h 'a)) f))
                                  iff2 '(VADD VNEG VZERO VNRM))))
            (if (dk-only! iff3 (list '= (list '(VNRM a) w) 0)) (prop)))))
      (gno-cite2! 'uiba-sub-zero-eq 'a 'y 'z)
      (gno-ass!))))
(gno-qed! 'gelfand-injective)

;;; ---- the calculus: existence, uniqueness, values ----
(define (gno-cfc f) (list 'CFC 'a 'x f))
(define (gno-fGo f) (list 'COMPOSE f gno-Gx))
(define gno-Sy (lambda (f) (list 'SEP 'gnvy_ '(VEC a) (list '= (list '(GELFAND-TRANSFORM a) 'gnvy_) (gno-fGo f)))))
(sp (make-wff '(FORALL a (FORALL x (FORALL f (== (CFC a x f)
  (CHOICE (SEP gnvy_ (VEC a) (= ((GELFAND-TRANSFORM a) gnvy_) (COMPOSE f ((GELFAND-TRANSFORM a) x)))))))))))
(di) (mac 'CFC) (qrfl)
(gno-qed! 'cfc-unfold)

(define gno-cfc-hyps '(IMPLIES (IS-COMMUTATIVE-C-STAR-ALGEBRA a) (FORALL x (IMPLIES (IN x (VEC a))
  (FORALL f (IMPLIES (IN f (CCONT (SPEC-TOP a x))) BODY))))))
(define (gno-tree-replace old new e) (cond ((eq? e old) new) ((pair? e) (map (lambda (s) (gno-tree-replace old new s)) e)) (#t e)))
(define (gno-cfc-stmt body) (list 'FORALL 'a (gno-tree-replace 'BODY body gno-cfc-hyps)))

;;; 1.31, existence: f(x) is in A and G(f(x)) = f o G(x)
(sp (make-wff (gno-cfc-stmt (list 'AND (list 'IN (gno-cfc 'f) '(VEC a)) (list '= (gno-G (gno-cfc 'f)) (gno-fGo 'f))))))
(dk-peel!)
(gno-ccsa-setup!)
(dk-cite! 'compose-gelfand-in-ccont 'a 'x 'f)
(let* ((ex (dk-cite! 'gelfand-onto 'a (gno-fGo 'f)))
       (y (dk-skolem! ex))
       (_ (dk-split-all!))
       (sy (gno-Sy 'f)))
  (dk-have! (list 'FORSOME 'gnvq_ (list 'IN 'gnvq_ sy))
    (lambda () (ew y) (in-sep! (lambda () (gno-ass!)) (lambda () (gno-ass!)))))
  (let* ((ch (dk-cite! 'choice-axiom sy)))
    (subst (dk-cite! 'cfc-unfold 'a 'x 'f))
    (sep-me (list 'IN (list 'CHOICE sy) sy)) (dk-split-all!)
    (dk-conj-close! (lambda () (gno-ass!)))))
(gno-qed! 'cfc-spec)

;;; uniqueness: an element whose transform is f o G(x) is f(x)
(sp (make-wff (gno-cfc-stmt (list 'FORALL 'y (list 'IMPLIES '(IN y (VEC a)) (list 'IMPLIES (list '= (gno-G 'y) (gno-fGo 'f)) (list '= 'y (gno-cfc 'f))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'cfc-spec 'a 'x 'f)))
(let ((imp (dk-cite! 'gelfand-injective 'a 'y (gno-cfc 'f))))
  (detach-with! imp (lambda () (subst (list '= (gno-G (gno-cfc 'f)) (gno-fGo 'f))) (gno-ass!)))
  (gno-ass!))
(gno-qed! 'cfc-unique)

;;; the values: chi(f(x)) = f(chi(x)) for every character chi
(sp (make-wff (gno-cfc-stmt (list 'FORALL 'c (list 'IMPLIES '(IN c (CHARACTERS a)) (list '= (list 'c (gno-cfc 'f)) (list 'f '(c x))))))))
(dk-peel!)
(gno-ccsa-setup!)
(gno-spec-facts!)
(dk-split-all! (list (dk-cite! 'cfc-spec 'a 'x 'f)))
(dk-cite! 'gno-u-value 'a (gno-cfc 'f) 'c)
(dk-cite! 'gno-u-in-ccont 'a 'x)
(let* ((hg (dk-cite! 'gelfand-into-spectrum-continuous 'a 'x))
       (gf (dk-project! (list 'IN gno-Gx (list 'FUN gno-PT (list 'PTS gno-K))) 'is-hom-top-space-def hg)))
  (dk-split-all! (list (dk-cite! 'ccont-parts gno-K 'f)))
  (dk-have! (list 'IN 'c gno-PT) (lambda () (subst (list '== gno-PT gno-CH)) (gno-ass!)))
  (let ((ca (gno-cite2! 'compose-apply gno-PT (list 'PTS gno-K) 'CC 'f gno-Gx)))
    (dk-apply! ca 'c))
  (dk-cite! 'gno-u-value 'a 'x 'c)
  (gno-rsubst! (list '= (list (gno-G (gno-cfc 'f)) 'c) (list 'c (gno-cfc 'f))))
  (subst (list '= (gno-G (gno-cfc 'f)) (gno-fGo 'f)))
  (subst (list '= (list (gno-fGo 'f) 'c) (list 'f (list gno-Gx 'c))))
  (subst (list '= (list gno-Gx 'c) '(c x)))
  (if (gno-open?) (begin (dk-cite! 'gelfand-value-in-spectrum 'a 'x 'c)
                         (dk-have! (list 'IN '(c x) (list 'PTS gno-K)) (lambda () (subst (list '== (list 'PTS gno-K) gno-S)) (gno-ass!)))
                         (dk-cite! 'fun-apply-type-c 'f (list 'PTS gno-K) 'CC '(c x))
                         (rfl))))
(gno-qed! 'cfc-value)

;;; ---- the calculus is a unital *-homomorphism C(sigma(x)) -> A sending z |-> z to x ----
(define (gno-cfc-ty! h)                ; h in CCONT(K) in context: CFC(h) in VEC a and its transform
  (dk-split-all! (list (dk-cite! 'cfc-spec 'a 'x h))))
(define (gno-px! p)                    ; p a character: p(x) in sigma(x) = PTS(K), and p's laws
  (dk-cite! 'gelfand-value-in-spectrum 'a 'x p)
  (dk-have! (list 'IN (list p 'x) (list 'PTS gno-K)) (lambda () (subst (list '== (list 'PTS gno-K) gno-S)) (gno-ass!)))
  (gno-char-open! p))
;;; goal (= CFC(h) y): H-IN! lands h in CCONT(K), Y-IN! lands y in VEC a; PTW! p proves (= (p y) (h (p x)))
(define (gno-cfc-law! h y h-in! y-in! ptw!)
  (gno-ccsa-setup!)
  (gno-spec-facts!)
  (h-in!) (y-in!)
  (gno-cfc-ty! h)
  (dk-cite! 'gno-u-in-ccont 'a y)
  (dk-cite! 'gno-u-in-ccont 'a 'x)
  (dk-cite! 'compose-gelfand-in-ccont 'a 'x h)
  (let* ((hg (dk-cite! 'gelfand-into-spectrum-continuous 'a 'x))
         (gf (dk-project! (list 'IN gno-Gx (list 'FUN gno-PT (list 'PTS gno-K))) 'is-hom-top-space-def hg))
         (imp (dk-cite! 'cfc-unique 'a 'x h y)))
    (dk-split-all! (list (dk-cite! 'ccont-parts gno-K h)))
    (detach-with! imp
      (lambda ()
        (dk-fun-ext! (gno-G y) (gno-fGo h) gno-PT 'CC
          (lambda () (dk-split-all! (list (dk-cite! 'ccont-parts gno-T (gno-G y)))) (gno-ass!))
          (lambda () (dk-split-all! (list (dk-cite! 'ccont-parts gno-T (gno-fGo h)))) (gno-ass!))
          (lambda (p)
            (dk-apply! (gno-cite2! 'compose-apply gno-PT (list 'PTS gno-K) 'CC h gno-Gx) p)
            (subst (list '= (list (gno-fGo h) p) (list h (list gno-Gx p))))
            (dk-rewrite-h! (list 'IN p gno-PT) gno-PT gno-CH)
            (dk-cite! 'gno-u-value 'a y p)
            (subst (list '= (list (gno-G y) p) (list p y)))
            (dk-cite! 'gno-u-value 'a 'x p)
            (subst (list '= (list gno-Gx p) (list p 'x)))
            (ptw! p)))))
    (gno-cite2! 'eq-sym y (gno-cfc h))
    (gno-ass!)))
(define (gno-cin! h) (lambda () (if (not (dk-asm? (list 'IN h (list 'CCONT gno-K)))) (error "gno-cin!: untyped" h))))

(define (gno-binary-law! name ccop vop law-index val-lemma cop)
  (sp (make-wff (gno-cfc-stmt (list 'FORALL 'g (list 'IMPLIES (list 'IN 'g (list 'CCONT gno-K))
    (list '= (gno-cfc (list (list ccop gno-K) 'f 'g)) (list (list vop 'a) (gno-cfc 'f) (gno-cfc 'g))))))))
  (dk-peel!)
  (let ((h (list (list ccop gno-K) 'f 'g)) (y (list (list vop 'a) (gno-cfc 'f) (gno-cfc 'g))))
    (gno-cfc-law! h y
      (lambda () (gno-spec-facts!) (dk-cite! (if (eq? ccop 'CCONT-VADD) 'ccont-vadd-in 'ccont-vmul-in) gno-K 'f 'g))
      (lambda () (gno-cfc-ty! 'f) (gno-cfc-ty! 'g) (gno-uvt y))
      (lambda (p)
        (let ((laws (gno-px! p)))
          (subst (dk-apply! (list-ref laws law-index) (gno-cfc 'f) (gno-cfc 'g)))
          (subst (dk-cite! 'cfc-value 'a 'x 'f p))
          (subst (dk-cite! 'cfc-value 'a 'x 'g p))
          (let* ((pf (dk-cite! 'ccont-parts gno-K 'f)) (pg (dk-cite! 'ccont-parts gno-K 'g))) (dk-split-all! (list pf pg)))
          (subst (dk-cite! val-lemma gno-K 'f 'g (list p 'x)))
          (if (gno-open?) (begin (dk-cite! 'fun-apply-type-c 'f (list 'PTS gno-K) 'CC (list p 'x))
                                 (dk-cite! 'fun-apply-type-c 'g (list 'PTS gno-K) 'CC (list p 'x))
                                 (rfl)))))))
  (gno-qed! name))
(gno-binary-law! 'cfc-add 'CCONT-VADD 'VADD 0 'ccont-vadd-val '+)
(gno-binary-law! 'cfc-mul 'CCONT-VMUL 'VMUL 2 'ccont-vmul-val '*)

;;; scalar multiples
(sp (make-wff (gno-cfc-stmt (list 'FORALL 'z (list 'IMPLIES '(IN z CC)
  (list '= (gno-cfc (list (list 'CCONT-ACT gno-K) 'z 'f)) (list '(ACT a) 'z (gno-cfc 'f))))))))
(dk-peel!)
(let ((h (list (list 'CCONT-ACT gno-K) 'z 'f)) (y (list '(ACT a) 'z (gno-cfc 'f))))
  (gno-cfc-law! h y
    (lambda () (gno-spec-facts!) (dk-cite! 'ccont-act-in gno-K 'z 'f))
    (lambda () (gno-cfc-ty! 'f) (gno-uvt y))
    (lambda (p)
      (let ((laws (gno-px! p)))
        (subst (dk-apply! (cadr laws) 'z (gno-cfc 'f)))
        (subst (dk-cite! 'cfc-value 'a 'x 'f p))
        (dk-split-all! (list (dk-cite! 'ccont-parts gno-K 'f)))
        (subst (dk-cite! 'ccont-act-val gno-K 'z 'f (list p 'x)))
        (if (gno-open?) (begin (dk-cite! 'fun-apply-type-c 'f (list 'PTS gno-K) 'CC (list p 'x)) (rfl)))))))
(gno-qed! 'cfc-act)

;;; the involution: conj(f)(x) = f(x)*
(sp (make-wff (gno-cfc-stmt (list '= (gno-cfc (list (list 'CCONT-VSTAR gno-K) 'f)) (list '(VSTAR a) (gno-cfc 'f))))))
(dk-peel!)
(let ((h (list (list 'CCONT-VSTAR gno-K) 'f)) (y (list '(VSTAR a) (gno-cfc 'f))))
  (gno-cfc-law! h y
    (lambda () (gno-spec-facts!) (dk-cite! 'ccont-vstar-in gno-K 'f))
    (lambda () (gno-cfc-ty! 'f) (gno-uvt y))
    (lambda (p)
      (gno-px! p)
      (subst (dk-cite! 'character-preserves-involution 'a p (gno-cfc 'f)))
      (subst (dk-cite! 'cfc-value 'a 'x 'f p))
      (dk-split-all! (list (dk-cite! 'ccont-parts gno-K 'f)))
      (subst (dk-cite! 'ccont-vstar-val gno-K 'f (list p 'x)))
      (if (gno-open?) (begin (dk-cite! 'fun-apply-type-c 'f (list 'PTS gno-K) 'CC (list p 'x))
                             (dk-cite! 'cc-conjugate-closed (list 'f (list p 'x))) (rfl))))))
(gno-qed! 'cfc-star)

;;; the unit: 1(x) = 1
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a) (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list '= (gno-cfc (list 'CCONT-VONE gno-K)) '(VONE a))))))))
(dk-peel!)
(let ((h (list 'CCONT-VONE gno-K)) (y '(VONE a)))
  (gno-cfc-law! h y
    (lambda () (gno-spec-facts!) (dk-cite! 'ccont-vone-type gno-K))
    (lambda () (gno-uvt y))
    (lambda (p)
      (let ((laws (gno-px! p)))
        (subst (cadddr laws))
        (subst (dk-cite! 'ccont-vone-val gno-K (list p 'x)))
        (if (gno-open?) (rfl))))))
(gno-qed! 'cfc-one)

;;; the coordinate: id(x) = x, id(z) = z on sigma(x)
(define gno-id (list 'VNB-LAMBDA 'gnvz_ gno-S 'gnvz_))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a) (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
  (list 'AND (list 'IN gno-id (list 'CCONT gno-K)) (list '= (gno-cfc gno-id) 'x))))))))
(dk-peel!)
(define (gno-id-in!)
  (if (not (dk-asm? (list 'IN gno-id (list 'CCONT gno-K))))
      (dk-have! (list 'IN gno-id (list 'CCONT gno-K))
        (lambda ()
          (gno-spec-facts!)
          (let ((hc (dk-cite! 'subspace-inclusion-continuous gno-MT gno-S)))
            (dk-rewrite-h! hc (list 'SUBSPACE-TOP gno-MT gno-S) gno-K)
            (subst (dk-cite! 'ccont-unfold gno-K))
            (in-sep!
              (lambda () (subst (list '== (list 'PTS gno-K) gno-S))
                         (dk-lam-type! (lambda () (let ((v (dk-di-var!))) (dk-cite! 'subset-mem-fwd gno-S 'CC v) (gno-ass!)))))
              (lambda () (gno-ass!))))))))
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IN)
        (begin (gno-ccsa-setup!) (gno-id-in!))
        (gno-cfc-law! gno-id 'x
          (lambda () (gno-id-in!))
          (lambda () #t)
          (lambda (p)
            (gno-px! p)
            (dk-have! (list 'IN (list p 'x) gno-S) (lambda () (gno-ass!)))
            (if (not (dk-lam-b!)) (rfl))
            (if (gno-open?) (rfl)))))))
(gno-qed! 'cfc-id)

;;; =====================================================================================================
;;; 1.31 FOR A NORMAL ELEMENT OF ANY C*-ALGEBRA b, RELATIVE TO A COMMUTATIVE C*-SUBALGEBRA a OF b CONTAINING
;;; IT (the notes take a = C*(x, 1)): f |-> CFC(a, x, f) is a unital *-homomorphism C(sigma_b(x)) -> b
;;; with id |-> x.  sigma_a(x) = sigma_b(x) is spectral-permanence (1.29).
;;; =====================================================================================================
(define gno-Kb '(SPEC-TOP b x))
(define gno-rel-hyps '(IMPLIES (IS-COMMUTATIVE-C-STAR-ALGEBRA a) (IMPLIES (IS-UNITAL-C-STAR-SUBALGEBRA a b)
  (FORALL x (IMPLIES (IN x (VEC a)) (FORALL f (IMPLIES (IN f (CCONT (SPEC-TOP b x))) BODY)))))))
(define (gno-rel-stmt body) (list 'FORALL 'a (list 'FORALL 'b (gno-tree-replace 'BODY body gno-rel-hyps))))
(define (gno-rel-setup!)               ; K_b == K_a; f (and g) rewritten to C(K_a); the goal's K_b to K_a
  (dk-cite! 'spectral-permanence 'a 'b 'x)
  (dk-have! (list '== gno-Kb gno-K)
    (lambda () (subst (dk-cite! 'spec-top-unfold 'b 'x)) (subst (dk-cite! 'spec-top-unfold 'a 'x))
               (subst (list '= '(SPECTRUM a x) '(SPECTRUM b x))) (if (gno-open?) (qrfl))))
  (for-each (lambda (v) (if (dk-asm? (list 'IN v (list 'CCONT gno-Kb))) (dk-rewrite-h! (list 'IN v (list 'CCONT gno-Kb)) gno-Kb gno-K)))
            '(f g))
  (if (dk-contains? (dk-goal) gno-Kb) (subst (list '== gno-Kb gno-K))))

(sp (make-wff (gno-rel-stmt (list 'IN (gno-cfc 'f) '(VEC b)))))
(dk-peel!)
(gno-rel-setup!)
(dk-split-all! (list (dk-cite! 'cfc-spec 'a 'x 'f)))
(dk-cite! 'bcp-sub-vec 'a 'b (gno-cfc 'f))
(gno-ass!)
(gno-qed! 'cfc-normal-in)

(define (gno-rel-binary! name ccop vop law sub)
  (sp (make-wff (gno-rel-stmt (list 'FORALL 'g (list 'IMPLIES (list 'IN 'g (list 'CCONT gno-Kb))
    (list '= (gno-cfc (list (list ccop gno-Kb) 'f 'g)) (list (list vop 'b) (gno-cfc 'f) (gno-cfc 'g))))))))
  (dk-peel!)
  (gno-rel-setup!)
  (let* ((sf (dk-cite! 'cfc-spec 'a 'x 'f)) (sg (dk-cite! 'cfc-spec 'a 'x 'g))) (dk-split-all! (list sf sg)))
  (subst (dk-cite! law 'a 'x 'f 'g))
  (dk-cite! sub 'a 'b (gno-cfc 'f) (gno-cfc 'g))
  (gno-ass!)
  (gno-qed! name))
(gno-rel-binary! 'cfc-normal-add 'CCONT-VADD 'VADD 'cfc-add 'bcp-sub-vadd)
(gno-rel-binary! 'cfc-normal-mul 'CCONT-VMUL 'VMUL 'cfc-mul 'bcp-sub-vmul)

(sp (make-wff (gno-rel-stmt (list 'FORALL 'z (list 'IMPLIES '(IN z CC)
  (list '= (gno-cfc (list (list 'CCONT-ACT gno-Kb) 'z 'f)) (list '(ACT b) 'z (gno-cfc 'f))))))))
(dk-peel!)
(gno-rel-setup!)
(dk-split-all! (list (dk-cite! 'cfc-spec 'a 'x 'f)))
(subst (dk-cite! 'cfc-act 'a 'x 'f 'z))
(dk-cite! 'bcp-sub-act 'a 'b 'z (gno-cfc 'f))
(gno-ass!)
(gno-qed! 'cfc-normal-act)

(sp (make-wff (gno-rel-stmt (list '= (gno-cfc (list (list 'CCONT-VSTAR gno-Kb) 'f)) (list '(VSTAR b) (gno-cfc 'f))))))
(dk-peel!)
(gno-rel-setup!)
(dk-split-all! (list (dk-cite! 'cfc-spec 'a 'x 'f)))
(subst (dk-cite! 'cfc-star 'a 'x 'f))
(dk-cite! 'bcp-sub-vstar 'a 'b (gno-cfc 'f))
(gno-ass!)
(gno-qed! 'cfc-normal-star)

(sp (make-wff (list 'FORALL 'a (list 'FORALL 'b (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a) (list 'IMPLIES '(IS-UNITAL-C-STAR-SUBALGEBRA a b)
  (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a))
    (list 'AND (list '= (gno-cfc (list 'CCONT-VONE gno-Kb)) '(VONE b))
               (list '= (gno-cfc (list 'VNB-LAMBDA 'gnvz_ '(SPECTRUM b x) 'gnvz_)) 'x))))))))))
(dk-peel!)
(gno-rel-setup!)
(dk-cite! 'cfc-one 'a 'x)
(dk-cite! 'bcp-sub-one 'a 'b)
(dk-split-all! (list (dk-cite! 'cfc-id 'a 'x)))
(dk-conj-close!
  (lambda ()
    (if (dk-contains? (dk-goal) 'VONE)
        (begin (subst (list '= (gno-cfc (list 'CCONT-VONE gno-K)) '(VONE a))) (gno-ass!))
        (begin (subst (list '= '(SPECTRUM b x) '(SPECTRUM a x))) (gno-ass!)))))
(gno-qed! 'cfc-normal-one-id)

;;; ---- the character laws, citable (a unital involutive Banach algebra, c a character) ----
(define (gno-char-stmt vars body)
  (list 'FORALL 'a (list 'IMPLIES '(IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA a) (list 'FORALL 'c (list 'IMPLIES '(IN c (CHARACTERS a))
    (let loop ((vs vars))
      (cond ((null? vs) body)
            ((eq? (car vs) 'z) (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (loop (cdr vs)))))
            (#t (list 'FORALL (car vs) (list 'IMPLIES (list 'IN (car vs) '(VEC a)) (loop (cdr vs))))))))))))
(sp (make-wff (gno-char-stmt '(x y) '(= (c ((VADD a) x y)) (+ (c x) (c y))))))
(dk-peel!) (let ((laws (gno-char-open! 'c))) (subst (dk-apply! (car laws) 'x 'y)) (if (gno-open?) (begin (dk-cite! 'fun-apply-type-c 'c '(VEC a) 'CC 'x) (dk-cite! 'fun-apply-type-c 'c '(VEC a) 'CC 'y) (rfl))))
(gno-qed! 'char-vadd)
(sp (make-wff (gno-char-stmt '(z x) '(= (c ((ACT a) z x)) (* z (c x))))))
(dk-peel!) (let ((laws (gno-char-open! 'c))) (subst (dk-apply! (cadr laws) 'z 'x)) (if (gno-open?) (begin (dk-cite! 'fun-apply-type-c 'c '(VEC a) 'CC 'x) (rfl))))
(gno-qed! 'char-act)
(sp (make-wff (gno-char-stmt '(x y) '(= (c ((VMUL a) x y)) (* (c x) (c y))))))
(dk-peel!) (let ((laws (gno-char-open! 'c))) (subst (dk-apply! (caddr laws) 'x 'y)) (if (gno-open?) (begin (dk-cite! 'fun-apply-type-c 'c '(VEC a) 'CC 'x) (dk-cite! 'fun-apply-type-c 'c '(VEC a) 'CC 'y) (rfl))))
(gno-qed! 'char-vmul)
(sp (make-wff (gno-char-stmt '() '(= (c (VONE a)) 1))))
(dk-peel!) (let ((laws (gno-char-open! 'c))) (dk-have! (cadddr laws) (lambda () (gno-ass!))) (gno-ass!) (if (gno-open?) (begin (subst (cadddr laws)) (if (gno-open?) (rfl)))))
(gno-qed! 'char-vone)
(sp (make-wff (gno-char-stmt '(x) '(= (c ((VNEG a) x)) (- (c x))))))
(dk-peel!)
(let* ((laws (gno-char-open! 'c))
       (ey (dk-cite! 'kal-uiba-vneg-act 'a 'x))
       (m1 (cadr (caddr ey))))
  (subst ey)
  (dk-have! (list 'IN m1 'CC) (lambda () (arith)))
  (subst (dk-apply! (cadr laws) m1 'x))
  (dk-cite! 'fun-apply-type-c 'c '(VEC a) 'CC 'x)
  (if (gno-open?) (crs)))
(gno-qed! 'char-vneg)

;;; the Gelfand space of a commutative C*-algebra is nonempty, and C(A-hat) is a commutative C*-algebra
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IS-COMMUTATIVE-C-STAR-ALGEBRA a)
  (list 'AND (list 'FORSOME 'tp_ (list 'IN 'tp_ gno-PT)) (list 'IS-COMMUTATIVE-C-STAR-ALGEBRA gno-C))))))
(dk-peel!)
(gno-ccsa-setup!)
(gno-nonempty!)
(dk-cite! 'ccont-algebra-commutative-c-star gno-T)
(dk-conj-close! (lambda () (gno-ass!)))
(gno-qed! 'gelfand-space-nonempty)
