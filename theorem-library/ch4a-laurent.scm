;;; Library: complex-analysis.

;;; ch4a-laurent.scm -- complex-analysis 4.1: a Laurent series is holomorphic on its annulus (CH4-A, 2026-10-28).
;;;   annulus-open            the open annulus is open (both spellings of the plane's metric)
;;;   laurent-holomorphic     4.1
;;; Library: complex-analysis.  Load window: after ch4a-vocab, cc-power-series-laws (cps-holomorphic-ball),
;;; cc-holomorphic-algebra (holomorphic-compose, -recip-of, -product, -sum).  Prefix lau-.

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (lau-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (lau-find pred lst what)
  (let ((r (filter pred lst))) (if (null? r) (error "lau-find: nothing matching" what) (car r))))
(define (lau-pts!)
  (fact 'cc-is-metric-space)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (lau-mag! x y)            ; x, y in CC: x - y in CC, |x - y| in RR, >= 0
  (fact 'cc-sub-in-cc x y) (fact 'cc-magnitude-closed (list '- x y)) (fact 'cc-magnitude-nonneg (list '- x y)))
(define lau-U '(ANNULUS a rm rp))
(define (lau-ann-parts! y)        ; y in the annulus (in context): land y in CC, rm < |y - a|, |y - a| < rp
  (dk-have! (list 'AND (list 'IN y 'CC) (list 'AND (list '< 'rm (list 'magnitude (list '- y 'a))) (list '< (list 'magnitude (list '- y 'a)) 'rp)))
    (lambda ()
      (let* ((eq (dk-cite! 'annulus-unfold 'a 'rm 'rp))
             (h (dk-rewrite-h! (list 'IN y lau-U) lau-U (caddr eq))))
        (sep-me h) (dk-split-all!) (dk-conj-close! (lambda () (ass))))))
  (dk-split-all!))

;;; (0) the unfold equation (mac-h cannot unfold a functoid by its own name)
(sp (make-wff "forall([a, rm, rp], annulus(a, rm, rp) == {anlz_ in cc: rm < magnitude(anlz_ - a) and magnitude(anlz_ - a) < rp})"))
(dk-peel!)
(mac 'ANNULUS)
(qrfl)
(qed 'annulus-unfold)

;;; (1) the annulus is open
(sp (make-wff "forall([a in cc, rm in rr, rp in rr], is-open(cc-ms, annulus(a, rm, rp)))"))
(dk-peel!)
(lau-pts!)
(mac 'IS-OPEN)
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
      ((dk-head-is? g 'SUBSET)
       (let ((y (subset-by-element!))) (lau-ann-parts! y) (subst '(== (PTS CC-MS) CC)) (ass)))
      ((dk-head-is? g 'FORALL)
       (let* ((y (dk-di-var!))
              (_0 (lau-ann-parts! y))
              (m (list 'magnitude (list '- y 'a))))
         (lau-mag! y 'a)
         (fact 'rr-sub-in-rr m 'rm) (fact 'rr-sub-in-rr 'rp m)
         (dk-have! (list '< 0 (list '- m 'rm)) (lambda () (dk-ineq! (list 'IN m 'RR) '(IN rm RR) (list '< 'rm m))))
         (dk-have! (list '< 0 (list '- 'rp m)) (lambda () (dk-ineq! (list 'IN m 'RR) '(IN rp RR) (list '< m 'rp))))
         (let ((w (dk-skolem! (dk-cite! 'rr-min-pos (list '- m 'rm) (list '- 'rp m)))))
           (fact 'rr-pos-rr-of-lt w)
           (ew w)
           (dk-conj-close!
            (lambda ()
              (if (not (dk-head-is? (dk-goal) 'SUBSET))
                  (ass)
                  (let* ((x (subset-by-element!))
                         (_1 (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'cc-ms-ball-membership y w x)))))
                         (mx (list 'magnitude (list '- x 'a))) (dxy (list 'magnitude (list '- x y))) (dyx (list 'magnitude (list '- y x))))
                    (lau-mag! x 'a) (lau-mag! x y) (lau-mag! y x)
                    (fact 'cc-magnitude-sub-sym x y)
                    (lau-and! (list 'IN (list '- x y) 'CC) (list 'IN (list '- y 'a) 'CC))
                    (dk-cite! 'cc-magnitude-triangle (list '- x y) (list '- y 'a))
                    (lau-and! (list 'IN (list '- y x) 'CC) (list 'IN (list '- x 'a) 'CC))
                    (dk-cite! 'cc-magnitude-triangle (list '- y x) (list '- x 'a))
                    (dk-have! (list '= (list '+ (list '- x y) (list '- y 'a)) (list '- x 'a)) (lambda () (crs)))
                    (dk-have! (list '= (list '+ (list '- y x) (list '- x 'a)) (list '- y 'a)) (lambda () (crs)))
                    (let* ((t1 (dk-rewrite-h! (list '<= (list 'magnitude (list '+ (list '- x y) (list '- y 'a))) (list '+ dxy m))
                                              (list '+ (list '- x y) (list '- y 'a)) (list '- x 'a)))
                           (t2 (dk-rewrite-h! (list '<= (list 'magnitude (list '+ (list '- y x) (list '- x 'a))) (list '+ dyx mx))
                                              (list '+ (list '- y x) (list '- x 'a)) (list '- y 'a)))
                           (prem (list (list 'IN mx 'RR) (list 'IN m 'RR) (list 'IN dxy 'RR) (list 'IN dyx 'RR) (list 'IN w 'RR)
                                       '(IN rm RR) '(IN rp RR) t1 t2 (list '= dxy dyx) (list '< (list 'magnitude (list '- x y)) w)
                                       (list '<= w (list '- m 'rm)) (list '<= w (list '- 'rp m)))))
                      (subst (dk-cite! 'annulus-unfold 'a 'rm 'rp))
                      (in-sep! (lambda ()
                        (dk-conj-close! (lambda () (apply dk-ineq! prem)))))))))))))
      (#t (ass))))))
(qed 'annulus-open)


;;; (2) the annulus under z |-> z - a and z |-> 1/(z - a)
(define lau-shift-facts
  (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y lau-U)
    '(AND (NOT (= (- y a) 0)) (AND (IN (- y a) (BALL CC-MS 0 rp)) (IN (recip (- y a)) (BALL CC-MS 0 (recip rm))))))))
(define (lau-y-facts! y)          ; y in the annulus: y - a in CC, nonzero; |y - a| real and between the radii
  (lau-ann-parts! y)
  (lau-mag! y 'a)
  (dk-have! (list 'NOT (list '= (list '- y 'a) 0))
    (lambda () (di)
      (dk-have! (list '= (list 'magnitude (list '- y 'a)) 0) (lambda () (subst (list '= (list '- y 'a) 0)) (fact 'cc-magnitude-zero) (ass)))
      (dk-have! '(< 0 0) (lambda () (dk-ineq! (list 'IN (list 'magnitude (list '- y 'a)) 'RR) '(IN rm RR) '(< 0 rm)
                                              (list '< 'rm (list 'magnitude (list '- y 'a))) (list '= (list 'magnitude (list '- y 'a)) 0))))
      (fact 'rr-zero-in) (fact 'rr-lt-irrefl 0) (ai '(NOT (< 0 0))))))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IN a CC) (list 'FORALL 'rm (list 'IMPLIES '(IN rm RR) (list 'FORALL 'rp (list 'IMPLIES '(IN rp RR)
  (list 'IMPLIES '(< 0 rm) lau-shift-facts)))))))))
(dk-peel!)
(lau-pts!)
(fact 'cc-zero-in) (fact 'rr-pos-ne-zero 'rm)
(lau-and! '(IN rm RR) '(NOT (= rm 0)))
(fact 'rr-recip-closed 'rm) (fact 'rr-recip-pos 'rm)
(dk-have! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y lau-U) '(NOT (= (- y a) 0))))
  (lambda () (let ((y (dk-di-var!))) (lau-y-facts! y) (ass))))
(dk-have! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y lau-U) '(IN (- y a) (BALL CC-MS 0 rp))))
  (lambda ()
    (let ((y (dk-di-var!)) (d '(- y a)))
      (lau-y-facts! y)
      (let ((iff (dk-cite! 'cc-ms-ball-membership 0 'rp (list '- y 'a)))
            (cj (list 'AND (list 'IN (list '- y 'a) 'CC) (list '< (list 'magnitude (list '- (list '- y 'a) 0)) 'rp))))
        (dk-have! cj
          (lambda ()
            (dk-conj-close!
             (lambda ()
               (if (dk-asm? (dk-goal)) (ass)
                   (begin
                     (dk-have! (list '= (list '- (list '- y 'a) 0) (list '- y 'a)) (lambda () (crs)))
                     (subst (list '= (list '- (list '- y 'a) 0) (list '- y 'a)))
                     (ass)))))))
        (dk-only! iff cj) (prop)))))
(dk-have! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y lau-U) '(IN (recip (- y a)) (BALL CC-MS 0 (recip rm)))))
  (lambda ()
    (let* ((y (dk-di-var!)) (d (list '- y 'a)) (w (list 'recip d)) (m (list 'magnitude d)))
      (lau-y-facts! y)
      (lau-and! (list 'IN d 'CC) (list 'NOT (list '= d 0)))
      (fact 'cc-recip-closed d)
      (dk-cite! 'aif-magnitude-recip d)
      (fact 'cc-sub-in-cc w 0) (fact 'cc-magnitude-closed (list '- w 0))
      (dk-have! (list '= (list '- w 0) w) (lambda () (crs)))
      (dk-have! (list '< 0 m) (lambda () (dk-ineq! (list 'IN m 'RR) '(IN rm RR) '(< 0 rm) (list '< 'rm m))))
      (fact 'rr-recip-recip-pos 'rm)
      (fact 'rr-one-in)
      (dk-have! (list '< (list '* 1 (list 'recip (list 'recip 'rm))) m)
        (lambda () (subst (list '= (list 'recip (list 'recip 'rm)) 'rm)) (dk-ineq! (list 'IN m 'RR) '(IN rm RR) (list '< 'rm m))))
      (dk-cite! 'rr-recip-swap-lt 1 m (list 'recip 'rm))
      (fact 'rr-pos-ne-zero m) (lau-and! (list 'IN m 'RR) (list 'NOT (list '= m 0))) (fact 'rr-recip-closed m)
      (let ((iff (dk-cite! 'cc-ms-ball-membership 0 (list 'recip 'rm) w))
            (cj (list 'AND (list 'IN w 'CC) (list '< (list 'magnitude (list '- w 0)) (list 'recip 'rm)))))
        (dk-have! cj
          (lambda ()
            (dk-conj-close!
             (lambda ()
               (if (dk-asm? (dk-goal)) (ass)
                   (begin
                     (subst (list '= (list '- w 0) w))
                     (subst (list '= (list 'magnitude w) (list 'recip m)))
                     (dk-ineq! (list 'IN (list 'recip m) 'RR) (list 'IN (list 'recip 'rm) 'RR)
                               (list '< (list '* 1 (list 'recip m)) (list 'recip 'rm)))))))))
        (dk-only! iff cj) (prop)))))
(define lau-sf-y (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) lau-U))) "y")))
(dk-apply! (dk-ctx-form (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y lau-U) '(NOT (= (- y a) 0))))) lau-sf-y)
(dk-apply! (dk-ctx-form (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y lau-U) '(IN (- y a) (BALL CC-MS 0 rp))))) lau-sf-y)
(dk-apply! (dk-ctx-form (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y lau-U) '(IN (recip (- y a)) (BALL CC-MS 0 (recip rm)))))) lau-sf-y)
(dk-conj-close! (lambda () (ass)))
(qed 'annulus-shift-facts)

;;; (3) the assembly: hp holomorphic on B(0, rp), hn on B(0, 1/rm): z |-> hp(z - a) + (z - a)^-1 hn((z - a)^-1)
;;;     is holomorphic on the annulus A(a, rm, rp)   (dk-holomorphic!, the side conditions proved first)
(define lau-LAM '(VNB-LAMBDA lax_ (ANNULUS a rm rp) (+ (hp (- lax_ a)) (* (recip (- lax_ a)) (hn (recip (- lax_ a)))))))
(sp (make-wff (list 'FORALL 'a (list 'IMPLIES '(IN a CC) (list 'FORALL 'rm (list 'IMPLIES '(IN rm RR) (list 'FORALL 'rp (list 'IMPLIES '(IN rp RR)
  (list 'FORALL 'hp (list 'FORALL 'hn
    (list 'IMPLIES '(< 0 rm) (list 'IMPLIES '(< rm rp)
      (list 'IMPLIES '(HOLOMORPHIC-ON (BALL CC-MS 0 rp) hp)
        (list 'IMPLIES '(HOLOMORPHIC-ON (BALL CC-MS 0 (recip rm)) hn)
          (list 'HOLOMORPHIC-ON lau-U lau-LAM)))))))))))))))
(dk-peel!)
(lau-pts!)
(fact 'cc-zero-in) (fact 'rr-pos-ne-zero 'rm)
(lau-and! '(IN rm RR) '(NOT (= rm 0)))
(fact 'rr-recip-closed 'rm) (fact 'rr-recip-pos 'rm)
(dk-cite! 'annulus-open 'a 'rm 'rp)
(dk-have! (list 'IS-OPEN '(NF-METRIC-SPACE CC-NORMED-FIELD) lau-U)
  (lambda () (dk-only! (dk-cite! 'cc-ms-open-iff lau-U) (list 'IS-OPEN 'CC-MS lau-U)) (prop)))
(define (lau-from-facts! form pick)
  (dk-have! form
    (lambda () (let ((y (dk-di-var!))) (dk-split-all! (list (dk-apply! (dk-cite! 'annulus-shift-facts 'a 'rm 'rp) y))) (ass)))))
(lau-from-facts! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y lau-U) '(NOT (= (- y a) 0)))) 0)
(lau-from-facts! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y lau-U) '(IN (- y a) (BALL CC-MS 0 rp)))) 1)
(lau-from-facts! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y lau-U) '(IN (recip (- y a)) (BALL CC-MS 0 (recip rm))))) 2)
(dk-holomorphic! lau-U lau-LAM)
(qed 'laurent-assembly)

;;; (4) complex-analysis Proposition 4.1
(define lau-P '(VNB-LAMBDA lak_ NN (c lak_)))
(define lau-N '(VNB-LAMBDA lak_ NN (c (- (+ lak_ 1)))))
(define lau-F '(VNB-LAMBDA lax_ (ANNULUS a rm rp) (LAURENT-SUM c a lax_)))
(sp (make-wff "forall([c in fun(zz, cc), a in cc, rm in rr, rp in rr], 0 < rm implies rm < rp implies
   rp < cps-radius(vnb-lambda(lak_, nn, c(lak_))) implies recip(rm) < cps-radius(vnb-lambda(lak_, nn, c(-(lak_ + 1)))) implies
   holomorphic-on(annulus(a, rm, rp), vnb-lambda(lax_, annulus(a, rm, rp), laurent-sum(c, a, lax_))))"))
(dk-peel!)
(lau-pts!)
(fact 'nn-one-in)
(define (lau-coef-typ! lam)
  (dk-have! (list 'IN lam '(FUN NN CC))
    (lambda ()
      (dk-lam-type!
       (lambda ()
         (let ((k (dk-di-var!)))
           (if (dk--redex? (dk-goal)) (dk-lam-b!))
           (fact 'nn-subset-zz k)
           (lau-and! (list 'IN k 'NN) '(IN 1 NN))
           (fact 'nn-add-closed k 1)
           (fact 'nn-subset-zz (list '+ k 1))
           (fact 'zz-neg-closed (list '+ k 1))
           (fact 'fun-apply-type-c 'c 'ZZ 'CC (cadr (cadr (dk-goal))))
           (ass)))))))
(lau-coef-typ! lau-P)
(lau-coef-typ! lau-N)
(fact 'rr-pos-ne-zero 'rm)
(lau-and! '(IN rm RR) '(NOT (= rm 0)))
(fact 'rr-recip-closed 'rm) (fact 'rr-recip-pos 'rm)
(dk-have! '(< 0 rp) (lambda () (dk-ineq! '(IN rm RR) '(IN rp RR) '(< 0 rm) '(< rm rp))))
(define (lau-hol! cf rad)          ; cps-holomorphic-ball at cf, rad: return the holomorphic lambda on B(0, rad)
  (dk-split-all! (list (dk-cite! 'cps-holomorphic-ball cf rad)))
  (caddr (dk-pick (lambda (f) (and (dk-head-is? f 'HOLOMORPHIC-ON) (equal? (cadr f) (list 'BALL 'CC-MS 0 rad)))) "the ball sum")))
(define lau-Hp (lau-hol! lau-P 'rp))
(define lau-Hn (lau-hol! lau-N '(recip rm)))
(define lau-asm (dk-cite! 'laurent-assembly 'a 'rm 'rp lau-Hp lau-Hn))
(define lau-LAMa (caddr (dk-pick (lambda (f) (and (dk-head-is? f 'HOLOMORPHIC-ON) (equal? (cadr f) lau-U))) "the assembled function")))
(fact 'holomorphic-on-in-fun lau-U lau-LAMa)
(dk-cite! 'annulus-shift-facts 'a 'rm 'rp)
(define lau-sf (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(recip rm)) (dk-contains? f 'NOT))) "shift facts"))
;; the two spellings of each series agree: the coefficient lambda reduced under the binder, by extensionality
(define (lau-ser-eq! s1 s2)       ; s1, s2 lambdas on NN: land (= s2 s1)
  (if (not (alpha-equiv? s1 s2))
      (dk-fun-ext! s2 s1 'NN 'CC
        (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (dk-lam-b!) (lau-ser-typ! (cadr (dk-goal))) (ass)))))
        (lambda () (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (dk-lam-b!) (lau-ser-typ! (cadr (dk-goal))) (ass)))))
        (lambda (v) (dk-lam-b!) (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (rfl)))))))
(define (lau-ser-typ! t)          ; t = (* (c i) (power w k)) with the pieces typed in context
  (let ((ci (cadr t)) (pw (caddr t)))
    (lau-cc! ci) (lau-cc! pw)
    (lau-and! (list 'IN ci 'CC) (list 'IN pw 'CC))
    (fact 'cc-mul-closed ci pw)))
(define (lau-cc! t)
  (cond ((dk-asm? (list 'IN t 'CC)) #t)
        ((and (pair? t) (eq? (car t) 'power))
         (lau-cc! (cadr t))
         (lau-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN))
         (fact 'power-typing-nonneg (cadr t) (caddr t)))
        ((and (pair? t) (eq? (car t) 'c))
         (let ((i (cadr t)))
           (if (and (pair? i) (eq? (car i) '-))
               (let ((k (cadr (cadr i))))
                 (lau-and! (list 'IN k 'NN) '(IN 1 NN)) (fact 'nn-add-closed k 1)
                 (fact 'nn-subset-zz (list '+ k 1)) (fact 'zz-neg-closed (list '+ k 1)))
               (fact 'nn-subset-zz i))
           (fact 'fun-apply-type-c 'c 'ZZ 'CC i)))
        (#t (dk-type! t 'CC))))
(dk-have! (list 'FORALL 'lax_ (list 'IMPLIES (list 'IN 'lax_ lau-U) (list '== (list lau-F 'lax_) (list lau-LAMa 'lax_))))
  (lambda ()
    (let* ((x (dk-di-var!)) (d (list '- x 'a)) (w (list 'recip d)))
      (dk-split-all! (list (dk-apply! lau-sf x)))
      (lau-ann-parts! x) (lau-mag! x 'a)
      (fact 'cc-is-set)
      (lau-and! (list 'IN d 'CC) (list 'NOT (list '= d 0)))
      (fact 'cc-recip-closed d)
      (dk-lam-b!)
      (mac 'LAURENT-SUM)
      (if (dk--redex? (dk-goal)) (dk-lam-b!))
      (let* ((g (dk-goal))
             (s1 (cadr (cadr (cadr g)))) (s2 (cadr (cadr (caddr g))))
             (t1 (cadr (caddr (caddr (cadr g))))) (t2 (cadr (caddr (caddr (caddr g))))))
        (lau-ser-eq! s1 s2)
        (lau-ser-eq! t1 t2)
        (if (not (alpha-equiv? s1 s2)) (subst (list '= s2 s1)))
        (if (not (alpha-equiv? t1 t2)) (subst (list '= t2 t1)))
        (qrfl)))))
(dk-have! (list 'IN lau-F (list 'FUN lau-U 'CC))
  (lambda ()
    (dk-lam-type!
     (lambda ()
       (let ((x (dk-di-var!)))
         (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'LAURENT-SUM))) "pointwise") x)
         (fact 'fun-apply-type-c lau-LAMa lau-U 'CC x)
         (if (not (dk-contains? (dk-goal) lau-F))
             (begin
               (dk-have! (list '== (list lau-F x) (list 'LAURENT-SUM 'c 'a x)) (lambda () (dk-lam-b!) (if (pair? (dk-open-leaves)) (if (dk-asm? (dk-goal)) (ass) (qrfl)))))
               (subst (list '== (list 'LAURENT-SUM 'c 'a x) (list lau-F x)))))
         (subst (list '== (list lau-F x) (list lau-LAMa x)))
         (ass)))
     (lambda () (dk-apply! (dk-cite! 'annulus-open 'a 'rm 'rp)) (fact 'cc-is-set) (dk-sethood! lau-U)))))
(dk-cite! 'holomorphic-transfer-ptwise-eq lau-U lau-F lau-LAMa)
(ass)
(qed 'laurent-holomorphic)
