;;; Library: complex-analysis.

;;; mvp-bounded.scm -- complex-analysis Corollary 3.56 (CAL-INT-2, 2026-10-28): the maximum modulus
;;; principle on a bounded connected open set, with the boundary and the closure written with the
;;; NEW CLOSURE (structure-library/baire-category.scm) and INTERIOR.  What it needs and the tree lacked:
;;;   (1) cc-closed-bounded-seq-limit / cc-closed-bounded-max: a real function continuous on a closed
;;;       bounded set of complex numbers attains its maximum (Bolzano-Weierstrass in CC, the
;;;       completeness of RR through sup, countable choice through rmm-nn-choice);
;;;   (2) the closure of a bounded set is closed and bounded, a bounded nonempty open set has a
;;;       nonempty boundary (the plane is connected), a continuous function constant on u is
;;;       constant on its closure;
;;;   (3) 3.56.
;;; Library: complex-analysis.  Needs mvp-vocab, mvp-max, mvp-modulus and, for cc-plane-connected,
;;; POLY-2/CONN's ca-connected.  Prefix mxb-.

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (mxb-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (mxb-find pred lst what)
  (let ((r (filter pred lst))) (if (null? r) (error "mxb-find: nothing matching" what) (car r))))

;;; =====================================================================
;;; (1a) a sequence in a closed bounded K has a subsequence converging in K, along which a function
;;;      continuous on K converges to its value at the limit
;;; =====================================================================
(define mxb-closed '(FORALL x (IMPLIES (IN x CC) (IMPLIES (FORALL r (IMPLIES (POS-RR r) (FORSOME y (AND (IN y kk) (< (magnitude (- y x)) r))))) (IN x kk)))))
(define mxb-cont '(FORALL x (IMPLIES (IN x kk) (FORALL eps (IMPLIES (POS-RR eps) (FORSOME d (AND (POS-RR d)
                    (FORALL y (IMPLIES (IN y kk) (IMPLIES (<= (magnitude (- x y)) d) (<= (abs (- (g x) (g y))) eps)))))))))))
(define (mxb-hyps body)
  (list 'IMPLIES '(SUBSET kk CC) (list 'IMPLIES mxb-closed
    (list 'FORALL 'bd (list 'IMPLIES '(IN bd RR) (list 'IMPLIES '(FORALL z (IMPLIES (IN z kk) (<= (magnitude z) bd)))
      (list 'IMPLIES '(IN g (FUN kk RR)) (list 'IMPLIES mxb-cont body))))))))
(sp (make-wff (list 'FORALL 'kk (list 'FORALL 'g (mxb-hyps
  '(FORALL h (IMPLIES (IN h (FUN NN CC)) (IMPLIES (FORALL n (IMPLIES (IN n NN) (IN (h n) kk)))
     (FORSOME phi (AND (STRICTLY-MONO-NN phi) (FORSOME l (AND (IN l kk)
       (FORALL eps (IMPLIES (POS-RR eps) (FORSOME mxn_ (AND (IN mxn_ NN)
         (FORALL k (IMPLIES (IN k NN) (IMPLIES (<= mxn_ k) (<= (abs (- (g (h (phi k))) (g l))) eps))))))))))))))))))))
(dk-peel!)
(define mxb-CL (dk-ctx-form mxb-closed))
(define mxb-CT (dk-ctx-form mxb-cont))
(define mxb-hk (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(h n)))) "h in K"))
(define mxb-BB (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'bd))) "the bound"))
(dk-have! '(FORALL i (IMPLIES (IN i NN) (<= (magnitude (h i)) bd)))
  (lambda () (let ((i (dk-di-var!))) (dk-apply! mxb-hk i) (dk-apply! mxb-BB (list 'h i)) (ass))))
(define mxb-phi (dk-skolem! (dk-cite! 'cc-bolzano-weierstrass 'h 'bd)))
(define mxb-l (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the limit")))
(define mxb-cv (dk-pick (dk-head? 'CONVERGES-TO) "the convergence"))
(dk-split-all! (dk-landed* (lambda () (mac-h 'CONVERGES-TO mxb-cv))))
(define mxb-cc (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'DIST))) "the convergence clause"))
(dk-project! (list 'IN mxb-phi '(FUN NN NN)) 'STRICTLY-MONO-NN (list 'STRICTLY-MONO-NN mxb-phi))
(fact 'cc-is-metric-space)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(define (mxb-at! k)          ; k in NN: land the facts about h(phi(k)) and its distance to l
  (let* ((pk (list mxb-phi k)) (hk (list 'h pk)) (sk (list (list 'SUBSEQ 'h mxb-phi) k)))
    (fact 'fun-apply-type-c mxb-phi 'NN 'NN k)
    (dk-apply! mxb-hk pk)
    (fact 'fun-apply-type-c 'h 'NN 'CC pk)
    (fact 'subseq-apply 'h mxb-phi k)
    (fact 'cc-sub-in-cc hk mxb-l)
    (fact 'cc-sub-in-cc mxb-l hk)
    (fact 'cc-magnitude-closed (list '- hk mxb-l))
    (fact 'cc-magnitude-closed (list '- mxb-l hk))
    (fact 'cc-magnitude-sub-sym hk mxb-l)
    (dk-cite! 'cc-ms-dist hk mxb-l)
    hk))
(define (mxb-dist-le! k e)   ; the convergence clause instance at k landed: magnitude(h(phi k) - l) <= e
  (let* ((hk (mxb-at! k)) (sk (list (list 'SUBSEQ 'h mxb-phi) k)))
    (dk-have! (list '<= (list 'magnitude (list '- hk mxb-l)) e)
      (lambda ()
        (subst (list '== (list 'magnitude (list '- hk mxb-l)) (list '(DIST CC-MS) hk mxb-l)))
        (subst (list '== hk sk))
        (ass)))
    hk))
(dk-have! (list 'IN mxb-l 'kk)
  (lambda ()
    (dk-have! (list 'FORALL 'r (list 'IMPLIES '(POS-RR r) (list 'FORSOME 'y (list 'AND '(IN y kk) (list '< (list 'magnitude (list '- 'y mxb-l)) 'r)))))
                (lambda ()
                  (dk-peel!)
                  (let* ((r (cadr (dk-pick (dk-head? 'POS-RR) "r")))
                         (r2 (dk-halve! r))
                         (n (dk-skolem! (dk-apply! mxb-cc r2)))
                         (ncl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n))) "clause")))
                    (fact 'nn-in-rr n) (fact 'rr-leq-reflexive n)
                    (dk-apply! ncl n)
                    (let ((hk (mxb-dist-le! n r2)))
                      (fact 'rr-pos-rr-in-rr r)
                      (ew hk)
                      (dk-conj-close!
                       (lambda ()
                         (if (dk-head-is? (dk-goal) 'IN)
                             (ass)
                             (dk-ineq! (list 'IN (list 'magnitude (list '- hk mxb-l)) 'RR) (list '<= (list 'magnitude (list '- hk mxb-l)) r2)
                                       (list '= (list '+ r2 r2) r) (list '< 0 r2)))))))))
              (dk-apply! mxb-CL mxb-l)
              (ass)))
(ew mxb-phi)
(dk-conj-close!
 (lambda ()
   (let ((gl (dk-goal)))
     (cond
      ((dk-head-is? gl 'FORSOME)
       (ew mxb-l)
       (dk-conj-close!
        (lambda ()
          (let ((g2 (dk-goal)))
            (cond
             ((dk-head-is? g2 'FORALL)
              (dk-peel!)
              (let* ((e (cadr (dk-pick (dk-head? 'POS-RR) "eps")))
                     (d (dk-skolem! (dk-apply! mxb-CT mxb-l e)))
                     (cd (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d))) "the continuity clause"))
                     (_0 (fact 'rr-pos-rr-in-rr d))
                     (n (dk-skolem! (dk-apply! mxb-cc d)))
                     (ncl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n))) "clause")))
                (ew n)
                (dk-conj-close!
                 (lambda ()
                   (if (not (dk-head-is? (dk-goal) 'FORALL))
                       (ass)
                       (let* ((ls (dk-peel!))
                              (k (cadr (mxb-find (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN) (not (eq? (cadr f) n)))) ls "k"))))
                         (dk-apply! ncl k)
                         (let* ((hk (mxb-dist-le! k d)))
                           (dk-have! (list '<= (list 'magnitude (list '- mxb-l hk)) d)
                             (lambda () (subst (list '= (list 'magnitude (list '- mxb-l hk)) (list 'magnitude (list '- hk mxb-l)))) (ass)))
                           (dk-apply! cd hk)
                           (fact 'fun-apply-type-c 'g 'kk 'RR hk)
                           (fact 'fun-apply-type-c 'g 'kk 'RR mxb-l)
                           (fact 'rr-abs-sub-sym (list 'g hk) (list 'g mxb-l))
                           (subst (list '= (list 'abs (list '- (list 'g hk) (list 'g mxb-l))) (list 'abs (list '- (list 'g mxb-l) (list 'g hk)))))
                           (ass))))))))
             (#t (ass)))))))
      (#t (ass))))))
(qed 'cc-closed-bounded-seq-limit)

;;; =====================================================================
;;; (1b) the maximum is attained: first g is bounded above (else a sequence with g(h(k)) > k has a
;;;      subsequence along which g converges), then a sequence with g(h(k)) > sup - 1/(k+1) has one
;;;      converging to a point where g is the sup
;;; =====================================================================
(define (mxb-nn-big! a b)          ; a, b in NN: land a + b in NN, RR, a <= a + b, b <= a + b; return a + b
  (let ((k (list '+ a b)))
    (mxb-and! (list 'IN a 'NN) (list 'IN b 'NN))
    (fact 'nn-add-closed a b)
    (fact 'nn-in-rr a) (fact 'nn-in-rr b) (fact 'nn-in-rr k)
    (fact 'nn-zero-le a) (fact 'nn-zero-le b)
    (dk-have! (list '<= a k) (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN b 'RR) (list '<= 0 b))))
    (dk-have! (list '<= b k) (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN b 'RR) (list '<= 0 a))))
    k))
(define (mxb-choose! fam famcl)    ; FAMCL (forall k in NN, exists w in kk, w in fam(k)) in context: return hh
  (let* ((hh (dk-skolem! (dk-cite! 'rmm-nn-choice 'kk fam))))
    (fact 'fun-codomain-superset hh 'NN 'kk 'CC)
    (dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IN (list hh 'n) 'kk)))
      (lambda () (let ((n (dk-di-var!))) (fact 'fun-apply-type-c hh 'NN 'kk n) (ass))))
    hh))
(define (mxb-fam-at! hh k fam)     ; hh(k) in fam(k) landed (choice clause): land the SEP property, return it
  (let* ((cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f hh) (dk-contains? f fam))) "the choice clause"))
         (m (dk-apply! cl k))
         (m2 (dk-lam-b-h! m)))
    (dk-landed* (lambda () (sep-me (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list hh k)) (dk-contains? f 'SEP))) "the SEP membership"))))
    (dk-split-all!)))
(define mxb-BA '(FORSOME mxB_ (AND (IN mxB_ RR) (FORALL z (IMPLIES (IN z kk) (<= (g z) mxB_))))))
(sp (make-wff (list 'FORALL 'kk (list 'FORALL 'g (mxb-hyps
  '(IMPLIES (FORSOME x0 (IN x0 kk)) (FORSOME a (AND (IN a kk) (FORALL z (IMPLIES (IN z kk) (<= (g z) (g a))))))))))))
(dk-peel!)
(define mxb-x0 (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'x0))) "a point")))
(define mxb-SLh (dk-apply! (dk-cite! 'cc-closed-bounded-seq-limit 'kk 'g) 'bd))
(define (mxb-sub! hh)              ; the subsequence lemma at hh: return (phi l clause)
  (let* ((phi (dk-skolem! (dk-apply! mxb-SLh hh)))
         (l (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f phi))) "the limit")))
         (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f l) (dk-contains? f phi) (dk-contains? f 'POS-RR))) "the clause")))
    (dk-project! (list 'IN phi '(FUN NN NN)) 'STRICTLY-MONO-NN (list 'STRICTLY-MONO-NN phi))
    (fact 'fun-apply-type-c 'g 'kk 'RR l)
    (list phi l cl)))
(define (mxb-near! hh phi l cl e k)  ; e > 0, the index N from cl at e, k >= N: land g(hh(phi k)) <= g(l) + e and >= g(l) - e
  (let* ((pk (list phi k)) (hk (list hh pk)) (gh (list 'g hk)) (gl (list 'g l)))
    (fact 'fun-apply-type-c phi 'NN 'NN k)
    (fact 'fun-apply-type-c hh 'NN 'kk pk)
    (fact 'fun-apply-type-c 'g 'kk 'RR hk)
    (fact 'rr-sub-in-rr gh gl)
    (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list '- gh gl) e)))
    hk))
(define mxb-lt-absurd!            ; FALSITY-style close of any goal from (< 0 0) derivable by ineq
  (lambda prems
    (dk-have! '(< 0 0) (lambda () (apply dk-ineq! prems)))
    (fact 'rr-zero-in) (fact 'rr-lt-irrefl 0)
    (ai '(NOT (< 0 0)))))
;; ---- (A) bounded above
(define mxb-fam1 '(VNB-LAMBDA mxk_ NN (SEP mxw_ kk (< mxk_ (g mxw_)))))
(dk-have! mxb-BA
  (lambda ()
    (use-em mxb-BA
      (lambda () (ass))
      (lambda ()
        (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORSOME 'w (list 'AND '(IN w kk) (list 'IN 'w (list mxb-fam1 'k))))))
          (lambda ()
            (let* ((k (dk-di-var!)) (ex (list 'FORSOME 'mxw2_ (list 'AND '(IN mxw2_ kk) (list '< k '(g mxw2_))))))
              (fact 'nn-in-rr k)
              (use-em ex
                (lambda ()
                  (let ((w (dk-skolem! (dk-ctx-form ex))))
                    (ew w)
                    (dk-conj-close!
                     (lambda ()
                       (if (dk-contains? (dk-goal) 'SEP)
                           (begin (dk-lam-b!) (in-sep! (lambda () (ass))))
                           (ass))))))
                (lambda ()
                  ;; then k bounds g: contradicts NOT BA
                  (dk-have! mxb-BA
                    (lambda ()
                      (ew k)
                      (dk-conj-close!
                       (lambda ()
                         (if (not (dk-head-is? (dk-goal) 'FORALL))
                             (ass)
                             (let ((z (dk-di-var!)))
                               (fact 'fun-apply-type-c 'g 'kk 'RR z)
                               (use-em (list '<= (list 'g z) k)
                                 (lambda () (ass))
                                 (lambda ()
                                   (dk-cite! 'rr-not-le-lt (list 'g z) k)
                                   (dk-have! ex (lambda () (ew z) (dk-conj-close! (lambda () (ass)))))
                                   (ai (list 'NOT ex))))))))))
                  (ai (list 'NOT mxb-BA)))))))
        (let* ((hh (mxb-choose! mxb-fam1 #f))
               (pl (mxb-sub! hh)) (phi (car pl)) (l (cadr pl)) (cl (caddr pl))
               (gl (list 'g l)))
          (fact 'rr-one-in)
          (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
          (fact 'rr-pos-rr-of-lt 1)
          (let* ((N (dk-skolem! (dk-apply! cl 1)))
                 (ncl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f N))) "clause at 1"))
                 (_0 (fact 'rr-add-in-rr gl 1))
                 (n0 (dk-skolem! (dk-cite! 'rr-archimedean-multiple 1 (list '+ gl 1))))
                 (k (mxb-nn-big! N n0)))
            (dk-apply! ncl k)
            (let* ((hk (mxb-near! hh phi l cl 1 k)) (pk (list phi k)))
              (dk-cite! 'strictly-mono-ge-id phi k)
              (fact 'nn-in-rr pk)
              (mxb-fam-at! hh pk mxb-fam1)
              (mxb-lt-absurd! (list 'IN (list 'g hk) 'RR) (list 'IN gl 'RR) (list 'IN k 'RR) (list 'IN pk 'RR) (list 'IN n0 'RR)
                              (list '<= (list '- (list 'g hk) gl) 1) (list '<= (list '+ gl 1) (list '* n0 1))
                              (list '<= n0 k) (list '<= k pk) (list '< pk (list 'g hk))))))))))
;; ---- (B) the sup of g over K is attained
(fact 'rr-one-in)
(dk-have! '(< 0 1) (lambda () (dk-ineq!)))
(fact 'rr-pos-rr-of-lt 1)
(define mxb-IM '(SEP mxt_ RR (FORSOME mxz_ (AND (IN mxz_ kk) (= mxt_ (g mxz_))))))
(define mxb-B (dk-skolem! (dk-ctx-form mxb-BA)))
(define mxb-Bcl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f mxb-B))) "the bound B"))
(fact 'fun-apply-type-c 'g 'kk 'RR mxb-x0)
(dk-have! (list 'SUBSET mxb-IM 'RR)
  (lambda () (let ((t (subset-by-element!))) (sep-me (list 'IN t mxb-IM)) (dk-split-all!) (ass))))
(dk-have! (list 'IN (list 'g mxb-x0) mxb-IM)
  (lambda () (in-sep! (lambda () (ew mxb-x0) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))))
(dk-have! (list 'FORSOME 'mxx_ (list 'IN 'mxx_ mxb-IM)) (lambda () (ew (list 'g mxb-x0)) (ass)))
(define (mxb-im-elim! t)           ; t in IM in context: return z with z in kk, t = g(z)
  (dk-have! (list 'FORSOME 'mxz_ (list 'AND '(IN mxz_ kk) (list '= t '(g mxz_))))
    (lambda () (sep-me (list 'IN t mxb-IM)) (dk-split-all!) (ass)))
  (dk-skolem! (dk-ctx-form (list 'FORSOME 'mxz_ (list 'AND '(IN mxz_ kk) (list '= t '(g mxz_)))))))
(dk-have! (list 'RR-BOUNDED-ABOVE mxb-IM)
  (lambda ()
    (mac 'RR-BOUNDED-ABOVE)
    (ew mxb-B)
    (mac 'RR-UPPER-BOUND)
    (dk-conj-close!
     (lambda ()
       (if (not (dk-head-is? (dk-goal) 'FORALL))
           (ass)
           (let* ((t (dk-di-var!)) (z (mxb-im-elim! t)))
             (dk-apply! mxb-Bcl z)
             (subst (list '= t (list 'g z)))
             (ass)))))))
(define mxb-S (list 'SUP mxb-IM))
(dk-cite! 'rr-sup-in mxb-IM)
(dk-split-all! (dk-landed* (lambda () (mac-h 'RR-UPPER-BOUND (dk-cite! 'rr-sup-upper mxb-IM)))))
(define mxb-Scl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'SUP) (not (dk-contains? f 'POS-RR)))) "S bounds IM"))
(dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z kk) (list '<= '(g z) mxb-S)))
  (lambda ()
    (let ((z (dk-di-var!)))
      (fact 'fun-apply-type-c 'g 'kk 'RR z)
      (dk-have! (list 'IN (list 'g z) mxb-IM)
        (lambda () (in-sep! (lambda () (ew z) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))))
      (dk-apply! mxb-Scl (list 'g z))
      (ass))))
(define mxb-fam2 (list 'VNB-LAMBDA 'mxk_ 'NN (list 'SEP 'mxw_ 'kk (list '< (list '- mxb-S '(recip (+ mxk_ 1))) '(g mxw_)))))
(define (mxb-recip! n)             ; n in NN: land n + 1 > 0, recip(n + 1) in RR and > 0
  (let ((n1 (list '+ n 1)))
    (fact 'nn-in-rr n) (fact 'nn-zero-le n) (fact 'rr-one-in)
    (fact 'rr-add-in-rr n 1)
    (dk-have! (list '< 0 n1) (lambda () (dk-ineq! (list 'IN n 'RR) (list '<= 0 n))))
    (fact 'rr-pos-ne-zero n1)
    (mxb-and! (list 'IN n1 'RR) (list 'NOT (list '= n1 0)))
    (fact 'rr-recip-closed n1)
    (fact 'rr-recip-pos n1)
    n1))
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORSOME 'w (list 'AND '(IN w kk) (list 'IN 'w (list mxb-fam2 'k))))))
  (lambda ()
    (let* ((k (dk-di-var!)) (n1 (mxb-recip! k)) (d (list 'recip n1)))
      (let* ((w (dk-skolem! (dk-cite! 'rr-sup-approx mxb-IM d)))
             (z (mxb-im-elim! w)))
        (ew z)
        (dk-conj-close!
         (lambda ()
           (if (dk-contains? (dk-goal) 'SEP)
               (begin (dk-lam-b!) (in-sep! (lambda () (subst (list '= (list 'g z) w)) (ass))))
               (ass))))))))
(let* ((hh (mxb-choose! mxb-fam2 #f))
       (pl (mxb-sub! hh)) (phi (car pl)) (l (cadr pl)) (cl (caddr pl))
       (gl (list 'g l)))
  (ew l)
  (dk-conj-close!
   (lambda ()
     (if (not (dk-head-is? (dk-goal) 'FORALL))
         (ass)
         (let ((z (dk-di-var!)))
           (fact 'fun-apply-type-c 'g 'kk 'RR z)
           (dk-apply! (dk-ctx-form (list 'FORALL 'z (list 'IMPLIES '(IN z kk) (list '<= '(g z) mxb-S)))) z)
           (dk-have! (list '<= mxb-S gl)
             (lambda ()
               (use-em (list '<= mxb-S gl)
                 (lambda () (ass))
                 (lambda ()
                   (dk-cite! 'rr-not-le-lt mxb-S gl)
                   (fact 'rr-sub-in-rr mxb-S gl)
                   (dk-have! (list '< 0 (list '- mxb-S gl)) (lambda () (dk-ineq! (list '< gl mxb-S))))
                   (fact 'rr-pos-rr-of-lt (list '- mxb-S gl))
                   (let* ((e (dk-halve! (list '- mxb-S gl)))
                          (N (dk-skolem! (dk-apply! cl e)))
                          (ncl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f N))) "clause at e"))
                          (_0 (fact 'rr-lt-of-pos-rr e))
                          (_1 (fact 'rr-pos-ne-zero e))
                          (_2 (mxb-and! (list 'IN e 'RR) (list 'NOT (list '= e 0))))
                          (_3 (fact 'rr-recip-closed e))
                          (_4 (fact 'rr-recip-pos e))
                          (re (dk-name! (list 'recip e) 'RR))
                          (n1 (dk-skolem! (dk-cite! 'rr-archimedean-multiple 1 re)))
                          (k (mxb-nn-big! N n1))
                          (_5 (dk-apply! ncl k))
                          (hk (mxb-near! hh phi l cl e k))
                          (pk (list phi k))
                          (_6 (dk-cite! 'strictly-mono-ge-id phi k))
                          (_7 (fact 'nn-in-rr pk))
                          (u1 (mxb-recip! n1))
                          (v1 (mxb-recip! pk)))
                     (mxb-fam-at! hh pk mxb-fam2)
                     ;; recip(n1 + 1) < e by rr-recip-swap-lt, recip(phi(k) + 1) <= recip(n1 + 1)
                     (dk-have! (list '< (list '* 1 re) u1)
                       (lambda () (dk-ineq! (list 'IN re 'RR) (list 'IN n1 'RR) (list '<= re (list '* n1 1)))))
                     (dk-have! (list '< (list '* 1 (list 'recip e)) u1) (lambda () (subst (list '= (list 'recip e) re)) (ass)))
                     (dk-cite! 'rr-recip-swap-lt 1 u1 e)
                     (dk-have! (list '<= u1 v1) (lambda () (dk-ineq! (list 'IN n1 'RR) (list 'IN k 'RR) (list 'IN pk 'RR) (list '<= n1 k) (list '<= k pk))))
                     (dk-cite! 'rr-recip-antitone u1 v1)
                     (fact 'rr-mul-in-rr 1 (list 'recip u1))
                     (mxb-lt-absurd! (list 'IN (list 'g hk) 'RR) (list 'IN gl 'RR) (list 'IN mxb-S 'RR) (list 'IN e 'RR)
                                     (list 'IN (list 'recip u1) 'RR) (list 'IN (list 'recip v1) 'RR)
                                     (list '= (list '+ e e) (list '- mxb-S gl))
                                     (list '<= (list '- (list 'g hk) gl) e)
                                     (list '< (list '- mxb-S (list 'recip v1)) (list 'g hk))
                                     (list '<= (list 'recip v1) (list 'recip u1))
                                     (list '< (list '* 1 (list 'recip u1)) e)))))))
           (dk-ineq! (list 'IN '(g z) 'RR) (list 'IN gl 'RR) (list 'IN mxb-S 'RR) (list '<= '(g z) mxb-S) (list '<= mxb-S gl)))))))
(qed 'cc-closed-bounded-max)

;;; =====================================================================
;;; (2) CLOSURE, BOUNDARY, CONTINUITY IN ABS FORM
;;; =====================================================================
(define mxb-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (mxb-cc-pts!)
  (fact 'cc-is-metric-space)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (mxb-in-pts! x) (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass))))

;;; (2a) continuity of a complex function on a set W of CC, at x, in magnitude form
(sp (make-wff "forall([mxw_, f, x], mxw_ subset cc implies
   is-continuous-at(subspace-ms(nf-metric-space(cc-normed-field), mxw_), nf-metric-space(cc-normed-field), f, x) implies
   forall([eps], pos-rr(eps) implies forsome([d], pos-rr(d) and forall([y in mxw_], magnitude(x - y) <= d implies magnitude(f(x) - f(y)) <= eps))))"))
(dk-peel!)
(define mxb-a-sub (list 'SUBSPACE-MS mxb-nfm 'mxw_))
(mxb-cc-pts!)
(fact 'cc-is-set) (dk-cite! 'subclass-of-set-is-set 'mxw_ 'CC)
(fact 'nf-cc-is-metric-space) (fact 'cc-is-normed-field) (fact 'nf-metric-carrier 'CC-NORMED-FIELD) (fact 'cc-nf-carr)
(dk-have! (list '== (list 'PTS mxb-nfm) 'CC) (lambda () (subst (list '== (list 'PTS mxb-nfm) '(CARR CC-NORMED-FIELD))) (ass)))
(dk-cite! 'subspace-pts mxb-nfm 'mxw_)
(dk-split-all! (dk-landed* (lambda () (mac-h 'IS-CONTINUOUS-AT (dk-pick (dk-head? 'IS-CONTINUOUS-AT) "continuity")))))
(dk-have! '(IN x mxw_) (lambda () (subst (list '= 'mxw_ (list 'PTS mxb-a-sub))) (ass)))
(dk-have! '(IN f (FUN mxw_ CC)) (lambda () (subst (list '= 'mxw_ (list 'PTS mxb-a-sub))) (subst (list '= 'CC (list 'PTS mxb-nfm))) (ass)))
(let* ((cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'DIST))) "eps clause"))
       (e (cadr (dk-pick (dk-head? 'POS-RR) "eps")))
       (d (dk-skolem! (dk-apply! cl e)))
       (cd (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d))) "delta clause")))
  (ew d)
  (dk-conj-close!
   (lambda ()
     (if (not (dk-head-is? (dk-goal) 'FORALL))
         (ass)
         (let* ((ls (dk-peel!))
                (y (cadr (mxb-find (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'mxw_) (not (eq? (cadr f) 'x)))) ls "y")))
                (fx '(f x)) (fy (list 'f y)))
           (for-each (lambda (z) (fact 'subset-mem-fwd 'mxw_ 'CC z) (fact 'fun-apply-type-c 'f 'mxw_ 'CC z) (mxb-in-pts! z)) (list 'x y))
           (mxb-in-pts! fx) (mxb-in-pts! fy)
           (dk-have! (list 'IN y (list 'PTS mxb-a-sub)) (lambda () (subst (list '== (list 'PTS mxb-a-sub) 'mxw_)) (ass)))
           (dk-cite! 'subspace-dist mxb-nfm 'mxw_ 'x y)
           (dk-cite! 'nf-cc-agree-dist 'x y)
           (dk-cite! 'cc-ms-dist 'x y)
           (dk-have! (list '<= (list (list 'DIST mxb-a-sub) 'x y) d)
             (lambda ()
               (subst (list '== (list (list 'DIST mxb-a-sub) 'x y) (list (list 'DIST mxb-nfm) 'x y)))
               (subst (list '== (list (list 'DIST mxb-nfm) 'x y) '((DIST CC-MS) x y)))
               (subst (list '== '((DIST CC-MS) x y) (list 'magnitude (list '- 'x y))))
               (ass)))
           (dk-apply! cd y)
           (dk-cite! 'nf-cc-agree-dist fx fy)
           (dk-cite! 'cc-ms-dist fx fy)
           (subst (list '== (list 'magnitude (list '- fx fy)) (list '(DIST CC-MS) fx fy)))
           (subst (list '== (list '(DIST CC-MS) fx fy) (list (list 'DIST mxb-nfm) fx fy)))
           (ass))))))
(qed 'cc-continuous-at-magnitude-form)

;;; (2b) the closure of a subset of CC is closed, in sequence-free form
(define mxb-K '(CLOSURE CC-MS u))
(sp (make-wff "forall([u], u subset cc implies forall([x in cc],
   forall([r], pos-rr(r) implies forsome([y in closure(cc-ms, u)], magnitude(y - x) < r)) implies x in closure(cc-ms, u)))"))
(dk-peel!)
(mxb-cc-pts!)
(define mxb-b-h (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR))) "the hypothesis"))
(define mxb-b-x (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC) (not (eq? (cadr f) 'u)))) "x")))
(dk-apply! (dk-cite! 'closure-in-carrier 'CC-MS) 'u)
(let* ((x mxb-b-x)
       (iff (dk-cite! 'closure-membership 'CC-MS 'u x))
       (rhs (caddr iff)))
  (dk-have! rhs
    (lambda ()
      (dk-conj-close!
       (lambda ()
         (if (not (dk-head-is? (dk-goal) 'FORALL))
             (mxb-in-pts! x)
             (let* ((ls (dk-peel!))
                    (_0 (dk-split-all!))
                    (op (dk-pick (lambda (f) (and (dk-head-is? f 'IS-OPEN) (not (eq? (caddr f) 'u)))) "the open set"))
                    (O (caddr op))
                    (balls (dk-project! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y O) (list 'FORSOME 'r (list 'AND '(POS-RR r) (list 'SUBSET '(BALL CC-MS y r) O)))))
                                        'IS-OPEN op))
                    (r (dk-skolem! (dk-apply! balls x)))
                    (_1 (dk-split-all!))
                    (y (dk-skolem! (dk-apply! mxb-b-h r))))
               (dk-split-all!)
               (dk-cite! 'subset-mem-fwd mxb-K '(PTS CC-MS) y)
               (dk-have! (list 'IN y 'CC) (lambda () (subst '(== CC (PTS CC-MS))) (ass)))
               (fact 'cc-sub-in-cc y x) (fact 'cc-sub-in-cc x y)
               (fact 'cc-magnitude-closed (list '- y x)) (fact 'cc-magnitude-closed (list '- x y))
               (fact 'cc-magnitude-sub-sym x y)
               (dk-cite! 'cc-ms-dist x y)
               (fact 'rr-pos-rr-in-rr r)
               (dk-have! (list 'IN y (list 'BALL 'CC-MS x r))
                 (lambda ()
                   (mac 'ball-membership)
                   (subst (list '== (list '(DIST CC-MS) x y) (list 'magnitude (list '- x y))))
                   (subst (list '= (list 'magnitude (list '- x y)) (list 'magnitude (list '- y x))))
                   (dk-conj-close!
                    (lambda ()
                      (let ((g (dk-goal)))
                        (cond ((dk-asm? g) (ass))
                              ((dk-head-is? g 'NOT) (di) (mxb-lt-absurd! (list 'IN r 'RR) (list 'IN (list 'magnitude (list '- y x)) 'RR) (list '= (list 'magnitude (list '- y x)) r) (list '< (list 'magnitude (list '- y x)) r)))
                              (#t (dk-ineq! (list 'IN r 'RR) (list '< (list 'magnitude (list '- y x)) r)))))))))
               (dk-cite! 'subset-mem-fwd (list 'BALL 'CC-MS x r) O y)
               (let* ((iff2 (dk-cite! 'closure-membership 'CC-MS 'u y))
                      (rhs2 (dk-meta-iff-r! iff2)))
                 (dk-split-all! (list rhs2))
                 (mxb-and! op (list 'IN y O))
                 (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-OPEN) (not (dk-contains? f x)))) "the closure clause at y") O)
                 (ass))))))))
  (dk-have! (list 'IN x mxb-K) (lambda () (dk-only! iff rhs) (prop)))
  (ass))
(qed 'closure-cc-sequence-free-closed)

;;; (2c) the closure of a set bounded by bd is bounded by bd
(sp (make-wff "forall([u, bd], u subset cc implies bd in rr implies forall([z in u], magnitude(z) <= bd) implies
   forall([z in closure(cc-ms, u)], magnitude(z) <= bd))"))
(dk-peel!)
(mxb-cc-pts!)
(define mxb-c-B '(CLOSED-BALL CC-MS 0 bd))
(define mxb-c-hb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'magnitude) (not (dk-contains? f 'CLOSURE)))) "the bound"))
(define mxb-c-z (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) mxb-K))) "z")))
(fact 'cc-zero-in) (mxb-in-pts! 0)
(dk-apply! (dk-cite! 'closed-ball-is-closed 'CC-MS) 0 'bd)
(define (mxb-c-dist! z)           ; z in CC: land (dist(cc-ms))(0, z) == magnitude(0 - z) and magnitude(0 - z) = magnitude(z)
  (fact 'cc-sub-in-cc 0 z)
  (dk-cite! 'cc-ms-dist 0 z)
  (fact 'cc-magnitude-sub-sym 0 z)
  (fact 'cc-sub-in-cc z 0)
  (fact 'cc-magnitude-closed z)
  (dk-have! (list '= (list '- z 0) z) (lambda () (crs)))
  (dk-have! (list '= (list 'magnitude (list '- 0 z)) (list 'magnitude z))
    (lambda () (subst (list '= (list 'magnitude (list '- 0 z)) (list 'magnitude (list '- z 0)))) (subst (list '= (list '- z 0) z)) (rfl))))
(dk-have! (list 'SUBSET 'u mxb-c-B)
  (lambda ()
    (let ((z (subset-by-element!)))
      (fact 'subset-mem-fwd 'u 'CC z)
      (mxb-c-dist! z)
      (dk-apply! mxb-c-hb z)
      (mac 'closed-ball-membership)
      (dk-conj-close!
       (lambda ()
         (if (dk-head-is? (dk-goal) 'IN)
             (mxb-in-pts! z)
             (begin
               (subst (list '== (list '(DIST CC-MS) 0 z) (list 'magnitude (list '- 0 z))))
               (subst (list '= (list 'magnitude (list '- 0 z)) (list 'magnitude z)))
               (ass))))))))
(dk-cite! 'closure-in-closed 'CC-MS 'u mxb-c-B)
(let ((z mxb-c-z))
  (fact 'subset-mem-fwd mxb-K mxb-c-B z)
  (dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'closed-ball-membership 'CC-MS 0 'bd z))))
  (dk-have! (list 'IN z 'CC) (lambda () (subst '(== CC (PTS CC-MS))) (ass)))
  (mxb-c-dist! z)
  (subst (list '= (list 'magnitude z) (list 'magnitude (list '- 0 z))))
  (subst (list '= (list 'magnitude (list '- 0 z)) (list '(DIST CC-MS) 0 z)))
  (ass))
(qed 'closure-cc-bounded)

;;; shared: x in CC, 0 < d: the open ball B(x, d) is open and contains x
(define (mxb-ball-facts! x d)
  (mxb-cc-pts!)
  (mxb-in-pts! x)
  (fact 'rr-lt-implies-le 0 d)
  (dk-have! (list '<= 0 d) (lambda () (dk-ineq! (list 'IN d 'RR) (list '< 0 d))))
  (dk-have! (list 'NOT (list '= 0 d)) (lambda () (di) (mxb-lt-absurd! (list 'IN d 'RR) (list '= 0 d) (list '< 0 d))))
  (mxb-and! (list 'IN d 'RR) (mxb-and! (list '<= 0 d) (list 'NOT (list '= 0 d))))
  (dk-apply! (dk-cite! 'ball-is-open 'CC-MS) x d)
  (dk-apply! (dk-cite! 'ball-center-in 'CC-MS) x d))
;;; y in B(x, d) (x, y in CC): land magnitude(x - y) <= d and < d
(define (mxb-ball-dist! x y d)
  (let ((iff (dk-cite! 'ball-membership 'CC-MS x d y)))
    (dk-split-all! (list (dk-meta-iff-r! iff)))
    (fact 'cc-sub-in-cc x y) (fact 'cc-magnitude-closed (list '- x y))
    (dk-cite! 'cc-ms-dist x y)
    (dk-have! (list '<= (list 'magnitude (list '- x y)) d)
      (lambda () (subst (list '== (list 'magnitude (list '- x y)) (list '(DIST CC-MS) x y))) (ass)))
    (dk-have! (list 'NOT (list '= (list 'magnitude (list '- x y)) d))
      (lambda () (subst (list '== (list 'magnitude (list '- x y)) (list '(DIST CC-MS) x y))) (ass)))
    (mxb-and! (list '<= (list 'magnitude (list '- x y)) d) (list 'NOT (list '= (list 'magnitude (list '- x y)) d)))
    (dk-cite! 'rr-le-ne-lt (list 'magnitude (list '- x y)) d)))
;;; x in CC with f(x) /= c, both in CC: land e = magnitude(f(x) - c) > 0, POS-RR e; return e
(define (mxb-gap! fx c)
  (let* ((d (list '- fx c)) (e (list 'magnitude d)))
    (fact 'cc-sub-in-cc fx c)
    (fact 'cc-magnitude-closed d) (fact 'cc-magnitude-nonneg d)
    (dk-have! (list 'NOT (list '= d 0))
      (lambda () (di) (dk-cite! 'cc-sub-zero-eq fx c) (ai (list 'NOT (list '= fx c)))))
    (let ((ziff (dk-cite! 'cc-magnitude-zero-iff d)))
      (dk-have! (list 'NOT (list '= 0 e))
        (lambda () (di) (fact 'eq-sym 0 e)
                   (if (dk-only! (list '= e 0) (list 'NOT (list '= d 0)) ziff) (prop)))))
    (mxb-and! (list '<= 0 e) (list 'NOT (list '= 0 e)))
    (dk-cite! 'rr-le-ne-lt 0 e)
    (fact 'rr-pos-rr-of-lt e)
    e))

;;; (2d) a function continuous on the closure and constant on u is constant on the closure
(sp (make-wff "forall([u, f, c], u subset cc implies f in fun(closure(cc-ms, u), cc) implies
   forall([x in closure(cc-ms, u)], is-continuous-at(subspace-ms(nf-metric-space(cc-normed-field), closure(cc-ms, u)), nf-metric-space(cc-normed-field), f, x)) implies
   c in cc implies forall([z in u], f(z) = c) implies forall([x in closure(cc-ms, u)], f(x) = c))"))
(dk-peel!)
(mxb-cc-pts!)
(define mxb-e-x (cadr (cadr (dk-goal))))
(define mxb-e-cont (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-CONTINUOUS-AT))) "continuity"))
(define mxb-e-const (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'c) (not (dk-contains? f 'CLOSURE)))) "constancy"))
(dk-apply! (dk-cite! 'closure-in-carrier 'CC-MS) 'u)
(dk-have! '(SUBSET (CLOSURE CC-MS u) CC) (lambda () (subst '(== CC (PTS CC-MS))) (ass)))
(dk-have! '(SUBSET u (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
(dk-apply! (dk-cite! 'closure-contains 'CC-MS) 'u)
(let* ((x mxb-e-x) (fx (list 'f x)))
  (fact 'subset-mem-fwd mxb-K 'CC x)
  (fact 'fun-apply-type-c 'f mxb-K 'CC x)
  (use-em (list '= fx 'c)
    (lambda () (ass))
    (lambda ()
      (let* ((e (mxb-gap! fx 'c))
             (e2 (dk-halve! e))
             (_c (dk-apply! mxb-e-cont x))
             (af (dk-cite! 'cc-continuous-at-magnitude-form mxb-K 'f x))
             (af1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'magnitude) (dk-contains? f fx))) "the magnitude form"))
             (d (dk-skolem! (dk-apply! af1 e2)))
             (cd (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d))) "delta clause")))
        (fact 'rr-pos-rr-in-rr d) (fact 'rr-lt-of-pos-rr d)
        (mxb-ball-facts! x d)
        (let* ((rhs (dk-meta-iff-r! (dk-cite! 'closure-membership 'CC-MS 'u x)))
               (_0 (dk-split-all! (list rhs)))
               (cl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-OPEN))) "the closure clause"))
               (B (list 'BALL 'CC-MS x d)))
          (mxb-and! (list 'IS-OPEN 'CC-MS B) (list 'IN x B))
          (let* ((y (dk-skolem! (dk-apply! cl B)))
                 (fy (list 'f y)))
            (dk-split-all!)
            (fact 'subset-mem-fwd 'u mxb-K y)
            (fact 'subset-mem-fwd 'u 'CC y)
            (fact 'fun-apply-type-c 'f mxb-K 'CC y)
            (mxb-ball-dist! x y d)
            (dk-apply! cd y)
            (dk-apply! mxb-e-const y)
            (dk-have! (list '<= e e2)
              (lambda () (subst (list '= 'c fy)) (ass)))
            (fact 'rr-pos-rr-in-rr e2) (fact 'rr-lt-of-pos-rr e2)
            (mxb-lt-absurd! (list 'IN e 'RR) (list 'IN e2 'RR) (list '<= e e2) (list '= (list '+ e2 e2) e) (list '< 0 e2))))))))
(qed 'continuous-constant-on-closure)

;;; (2e) a nonempty bounded open set of the plane has a point on its boundary: else it would be
;;;      clopen in the connected plane, hence the plane, which is not bounded
(define mxb-f-I '(INTERIOR CC-MS u))
(define mxb-f-balls '(FORALL y (IMPLIES (IN y u) (FORSOME r (AND (POS-RR r) (SUBSET (BALL CC-MS y r) u))))))
(define mxb-f-Kin (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x mxb-K) '(IN x u))))
(define mxb-f-goal #f)
;; NOT goal in context: every point of the closure is in u
(define (mxb-f-closure-in-u!)
  (dk-have! mxb-f-Kin
    (lambda ()
      (let ((x (dk-di-var!)))
        (use-em (list 'IN x 'u)
          (lambda () (ass))
          (lambda ()
            (dk-have! (list 'NOT (list 'IN x mxb-f-I))
              (lambda () (di) (fact 'subset-mem-fwd mxb-f-I 'u x) (ai (list 'NOT (list 'IN x 'u)))))
            (dk-have! mxb-f-goal
              (lambda ()
                (ew x)
                (let ((iff (dk-cite! 'difference-membership mxb-K mxb-f-I x))
                      (cj (list 'AND (list 'IN x mxb-K) (list 'NOT (list 'IN x mxb-f-I)))))
                  (dk-have! cj (lambda () (dk-conj-close! (lambda () (ass)))))
                  (dk-only! iff cj)
                  (prop))))
            (ai (list 'NOT mxb-f-goal))))))))
;; u open in the plane, in the clopen lemma's form
(define mxb-f-open '(FORALL x (IMPLIES (IN x u) (FORSOME r (AND (POS-RR r) (FORALL y (IMPLIES (IN y CC) (IMPLIES (IN y (BALL CC-MS x r)) (IN y u)))))))))
(define (mxb-f-open!)
  (dk-have! mxb-f-open
    (lambda ()
      (let* ((x (dk-di-var!)) (r (dk-skolem! (dk-apply! (dk-ctx-form mxb-f-balls) x))))
        (dk-split-all!)
        (ew r)
        (dk-conj-close!
         (lambda ()
           (if (not (dk-head-is? (dk-goal) 'FORALL))
               (ass)
               (let* ((ls (dk-peel!))
                      (y (cadr (mxb-find (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'BALL))) ls "y"))))
                 (fact 'subset-mem-fwd (list 'BALL 'CC-MS x r) 'u y)
                 (ass)))))))))
;; the complement of u open in the plane
(define mxb-f-comp '(FORALL x (IMPLIES (IN x CC) (IMPLIES (NOT (IN x u)) (FORSOME r (AND (POS-RR r) (FORALL y (IMPLIES (IN y CC) (IMPLIES (IN y (BALL CC-MS x r)) (NOT (IN y u)))))))))))
(define (mxb-f-Q x)
  (list 'FORSOME 'mxr_ (list 'AND '(POS-RR mxr_) (list 'FORALL 'mxy_ (list 'IMPLIES (list 'IN 'mxy_ mxb-K)
    (list 'NOT (list '< (list 'magnitude (list '- 'mxy_ x)) 'mxr_)))))))
(define (mxb-f-Q! x)              ; x not in the closure: a gap around x
  (let ((Q (mxb-f-Q x)))
    (dk-have! Q
      (lambda ()
        (use-em Q
          (lambda () (ass))
          (lambda ()
            (dk-have! (list 'IN x mxb-K) (lambda () (mxb-f-in-closure! x Q)))
            (ai (list 'NOT (list 'IN x mxb-K)))))))
    Q))
(define (mxb-f-in-closure! x Q)   ; NOT Q in context: x is in the closure (closure-cc-sequence-free-closed)
  (let ((cl (dk-cite! 'closure-cc-sequence-free-closed 'u)))
    (dk-have! (list 'FORALL 'r (list 'IMPLIES '(POS-RR r) (list 'FORSOME 'y (list 'AND (list 'IN 'y mxb-K) (list '< (list 'magnitude (list '- 'y x)) 'r)))))
      (lambda ()
        (dk-peel!)
        (let* ((r (cadr (dk-pick (dk-head? 'POS-RR) "r")))
               (ex (list 'FORSOME 'mxy2_ (list 'AND (list 'IN 'mxy2_ mxb-K) (list '< (list 'magnitude (list '- 'mxy2_ x)) r)))))
          (use-em ex
            (lambda () (ass))
            (lambda ()
              (dk-have! Q (lambda () (mxb-f-Q-from! x r ex)))
              (ai (list 'NOT Q)))))))
    (dk-apply! cl x)
    (ass)))
(define (mxb-f-Q-from! x r ex)     ; NOT ex in context: Q with radius r
  (ew r)
  (dk-conj-close!
   (lambda ()
     (if (not (dk-head-is? (dk-goal) 'FORALL))
         (ass)
         (let* ((y (dk-di-var!)))
           (di)
           (dk-have! ex (lambda () (ew y) (dk-conj-close! (lambda () (ass)))))
           (ai (list 'NOT ex)))))))
(define (mxb-f-comp!)
  (dk-have! mxb-f-comp
    (lambda ()
      (let* ((x (dk-di-var!)))
        (dk-peel!)
        (dk-have! (list 'NOT (list 'IN x mxb-K))
          (lambda () (di) (dk-apply! (dk-ctx-form mxb-f-Kin) x) (ai (list 'NOT (list 'IN x 'u)))))
        (let* ((Q (mxb-f-Q! x))
               (r (dk-skolem! (dk-ctx-form Q)))
               (cq (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f r) (dk-contains? f 'NOT))) "the gap")))
          (fact 'rr-pos-rr-in-rr r) (fact 'rr-lt-of-pos-rr r)
          (ew r)
          (dk-conj-close! (lambda () (mxb-f-gap-close! x r cq))))))))
(define (mxb-f-gap-close! x r cq)
  (if (not (dk-head-is? (dk-goal) 'FORALL))
      (ass)
      (let* ((ls (dk-peel!))
             (y (cadr (mxb-find (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'BALL))) ls "y"))))
        (di)
        (fact 'subset-mem-fwd 'u mxb-K y)
        (fact 'subset-mem-fwd 'u 'CC y)
        (mxb-ball-dist! x y r)
        (fact 'cc-magnitude-sub-sym x y)
        (fact 'cc-sub-in-cc y x) (fact 'cc-magnitude-closed (list '- y x))
        (dk-apply! cq y)
        (dk-have! (list '< (list 'magnitude (list '- y x)) r)
          (lambda () (subst (list '= (list 'magnitude (list '- y x)) (list 'magnitude (list '- x y)))) (ass)))
        (ai (list 'NOT (list '< (list 'magnitude (list '- y x)) r))))))
(define (mxb-f-final! x0 hb)
  (fact 'cc-plane-connected)
  (let* ((cl (dk-cite! 'connected-clopen 'CC-MS 'CC 'u))
         (q (list '+ 'bd 1)))
    (fact 'rr-one-in) (fact 'rr-add-in-rr 'bd 1) (fact 'rr-subset-cc q)
    (fact 'subset-mem-fwd 'u 'CC x0)
    (dk-apply! cl x0 q)
    (dk-apply! hb q)
    (dk-apply! hb x0)
    (fact 'cc-magnitude-nonneg x0) (fact 'cc-magnitude-closed x0)
    (dk-have! (list '<= 0 q) (lambda () (dk-ineq! (list 'IN (list 'magnitude x0) 'RR) (list '<= 0 (list 'magnitude x0)) (list '<= (list 'magnitude x0) 'bd))))
    (dk-cite! 'rr-magnitude-is-abs q)
    (dk-cite! 'rr-abs-of-nonneg q)
    (dk-have! (list '<= q 'bd)
      (lambda () (subst (list '= q (list 'abs q))) (subst (list '= (list 'abs q) (list 'magnitude q))) (ass)))
    (mxb-lt-absurd! '(IN bd RR) (list '<= q 'bd))))

(sp (make-wff "forall([u], is-open(cc-ms, u) implies forall([x0 in u, bd in rr], forall([z in u], magnitude(z) <= bd) implies
   forsome([b], b in difference(closure(cc-ms, u), interior(cc-ms, u)))))"))
(dk-peel!)
(mxb-cc-pts!)
(set! mxb-f-goal (dk-goal))
(define mxb-f-hb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'magnitude))) "the bound"))
(define mxb-f-x0 (cadr (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'u))) "x0")))
(dk-project! mxb-f-balls 'IS-OPEN '(IS-OPEN CC-MS u))
(dk-project! '(SUBSET u (PTS CC-MS)) 'IS-OPEN '(IS-OPEN CC-MS u))
(dk-have! '(SUBSET u CC) (lambda () (subst '(== CC (PTS CC-MS))) (ass)))
(dk-apply! (dk-cite! 'closure-contains 'CC-MS) 'u)
(dk-apply! (dk-cite! 'interior-in-set 'CC-MS) 'u)
(use-em mxb-f-goal
  (lambda () (ass))
  (lambda ()
    (mxb-f-closure-in-u!)
    (mxb-f-open!)
    (mxb-f-comp!)
    (mxb-f-final! mxb-f-x0 mxb-f-hb)))
(qed 'bounded-open-boundary-nonempty)

;;; =====================================================================
;;; (3) complex-analysis Corollary 3.56.  u connected, open, bounded; f continuous on the closure of
;;; u, with the mean value property on u.  For every bound m of |f| on the boundary
;;; closure(u) \ interior(u):  (1) |f| <= m on u;  (2) |f(w)| = m at a point w of u makes f constant
;;; on the closure.  (The notes' m is the maximum of |f| on the boundary, one such bound.)
;;; =====================================================================
(define mxs-FR '(RESTRICT f u))
(define mxs-G (list 'VNB-LAMBDA 'mxsv_ mxb-K '(magnitude (f mxsv_))))
(define (mxs-typ! z)              ; z in the closure: f(z) in CC, magnitude in RR
  (fact 'subset-mem-fwd mxb-K 'CC z)
  (fact 'fun-apply-type-c 'f mxb-K 'CC z)
  (fact 'cc-magnitude-closed (list 'f z))
  (fact 'cc-magnitude-nonneg (list 'f z)))
(define (mxs-u! z)                ; z in u: also in the closure, FR(z) == f(z)
  (fact 'subset-mem-fwd 'u mxb-K z)
  (mxs-typ! z)
  (fact 'restrict-apply 'f 'u z))
;;; a in u, |f| <= |f(a)| on u (the formula BND in context): f = f(a) on the closure
(define (mxs-const! a bnd)
  (let ((fa (list 'f a)))
    (mxs-u! a)
    (dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list '<= (list 'magnitude (list mxs-FR 'z)) (list 'magnitude (list mxs-FR a)))))
      (lambda ()
        (let ((z (dk-di-var!)))
          (mxs-u! z)
          (subst (list '== (list mxs-FR z) (list 'f z)))
          (subst (list '== (list mxs-FR a) fa))
          (dk-apply! bnd z)
          (ass))))
    (let* ((mm (dk-cite! 'mvp-maximum-modulus 'u mxs-FR))
           (cst (dk-apply! mm a)))
      (dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list '= '(f z) fa)))
        (lambda ()
          (let ((z (dk-di-var!)))
            (mxs-u! z)
            (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f mxs-FR) (dk-contains? f '=))) "constancy of FR") z)
            (subst (list '= (list 'f z) (list mxs-FR z)))
            (subst (list '= fa (list mxs-FR a)))
            (ass))))
      (dk-cite! 'continuous-constant-on-closure 'u 'f fa))))
;;; the continuity of |f| on the closure, in the form cc-closed-bounded-max asks for
(define mxs-Gcont
  (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x mxb-K) (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'd (list 'AND '(POS-RR d)
    (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y mxb-K) (list 'IMPLIES '(<= (magnitude (- x y)) d)
      (list '<= (list 'abs (list '- (list mxs-G 'x) (list mxs-G 'y))) 'eps)))))))))))
(define (mxs-Gcont! ct)
  (dk-have! mxs-Gcont
    (lambda ()
      (let* ((x (dk-di-var!)))
        (dk-peel!)
        (mxs-typ! x)
        (let* ((e (cadr (dk-pick (dk-head? 'POS-RR) "eps")))
               (_0 (dk-apply! ct x))
               (af (dk-cite! 'cc-continuous-at-magnitude-form mxb-K 'f x))
               (d (dk-skolem! (dk-apply! af e)))
               (cd (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f d))) "delta clause")))
          (ew d)
          (dk-conj-close! (lambda () (mxs-Gcont-close! x e cd))))))))
(define (mxs-Gcont-close! x e cd)
  (if (not (dk-head-is? (dk-goal) 'FORALL))
      (ass)
      (let* ((ls (dk-peel!))
             (y (cadr (mxb-find (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) mxb-K) (not (eq? (cadr f) x)))) ls "y")))
             (fx (list 'f x)) (fy (list 'f y)) (dxy (list '- fx fy)) (dyx (list '- fy fx)))
        (mxs-typ! y)
        (dk-apply! cd y)
        (dk-lam-b!)
        (fact 'cc-sub-in-cc fx fy) (fact 'cc-sub-in-cc fy fx)
        (fact 'cc-magnitude-closed dxy) (fact 'cc-magnitude-closed dyx)
        (fact 'cc-magnitude-sub-sym fx fy)
        (mxb-and! (list 'IN dxy 'CC) (list 'IN fy 'CC))
        (dk-cite! 'cc-magnitude-triangle dxy fy)
        (mxb-and! (list 'IN dyx 'CC) (list 'IN fx 'CC))
        (dk-cite! 'cc-magnitude-triangle dyx fx)
        (dk-have! (list '= (list '+ dxy fy) fx) (lambda () (crs)))
        (dk-have! (list '= (list '+ dyx fx) fy) (lambda () (crs)))
        (let* ((h1 (dk-rewrite-h! (list '<= (list 'magnitude (list '+ dxy fy)) (list '+ (list 'magnitude dxy) (list 'magnitude fy))) (list '+ dxy fy) fx))
               (h2 (dk-rewrite-h! (list '<= (list 'magnitude (list '+ dyx fx)) (list '+ (list 'magnitude dyx) (list 'magnitude fx))) (list '+ dyx fx) fy))
               (mx (list 'magnitude fx)) (my (list 'magnitude fy))
               (prem (list (list 'IN mx 'RR) (list 'IN my 'RR) (list 'IN (list 'magnitude dxy) 'RR) (list 'IN (list 'magnitude dyx) 'RR)
                           (list 'IN e 'RR) h1 h2
                           (list '= (list 'magnitude dxy) (list 'magnitude dyx)) (list '<= (list 'magnitude dxy) e))))
          (fact 'rr-pos-rr-in-rr e)
          (fact 'rr-sub-in-rr mx my)
          (dk-have! (list '<= (list '- e) (list '- mx my)) (lambda () (apply dk-ineq! prem)))
          (dk-have! (list '<= (list '- mx my) e) (lambda () (apply dk-ineq! prem)))
          (dk-cite! 'rr-abs-le-of-parts (list '- mx my) e)
          (ass)))))

(sp (make-wff "forall([u, f], is-connected(cc-ms, u) implies forall([bd in rr], forall([z in u], magnitude(z) <= bd) implies
   f in fun(closure(cc-ms, u), cc) implies
   forall([x in closure(cc-ms, u)], is-continuous-at(subspace-ms(nf-metric-space(cc-normed-field), closure(cc-ms, u)), nf-metric-space(cc-normed-field), f, x)) implies
   has-mean-value-property(u, restrict(f, u)) implies
   forall([m in rr], forall([z in difference(closure(cc-ms, u), interior(cc-ms, u))], magnitude(f(z)) <= m) implies
     forall([w in u], magnitude(f(w)) <= m) and forall([w in u], magnitude(f(w)) = m implies forall([z in closure(cc-ms, u)], f(z) = f(w))))))"))
(dk-peel!)
(mxb-cc-pts!)
(define mxs-H (list 'HAS-MEAN-VALUE-PROPERTY 'u mxs-FR))
(define mxs-hb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'bd))) "the bound of u"))
(define mxs-ct (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-CONTINUOUS-AT))) "continuity on the closure"))
(define mxs-hm (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'DIFFERENCE))) "the bound on the boundary"))
(define mxs-BD '(DIFFERENCE (CLOSURE CC-MS u) (INTERIOR CC-MS u)))
(dk-project! '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u) 'HAS-MEAN-VALUE-PROPERTY mxs-H)
(fact 'cc-open-subset-cc 'u)
(dk-split-all! (list (dk-cite! 'cc-ms-open-iff 'u)))
(dk-have! '(IS-OPEN CC-MS u) (lambda () (prop)))
(dk-have! '(SUBSET u (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
(dk-apply! (dk-cite! 'closure-contains 'CC-MS) 'u)
(dk-apply! (dk-cite! 'closure-in-carrier 'CC-MS) 'u)
(dk-have! (list 'SUBSET mxb-K 'CC) (lambda () (subst '(== CC (PTS CC-MS))) (ass)))
(dk-apply! (dk-cite! 'interior-in-set 'CC-MS) 'u)
(dk-apply! (dk-cite! 'closure-is-set 'CC-MS) 'u)
(define mxs-P1 '(FORALL w (IMPLIES (IN w u) (<= (magnitude (f w)) m))))
(define (mxs-bd-at! z)            ; z in the boundary: |f(z)| <= m
  (dk-apply! mxs-hm z))
(define (mxs-P1!)
  (dk-have! mxs-P1
    (lambda ()
      (let* ((w (dk-di-var!)))
        (mxs-u! w)
        (dk-have! (list 'IN mxs-G (list 'FUN mxb-K 'RR))
          (lambda () (dk-lam-type! (lambda () (let ((z (dk-di-var!))) (mxs-typ! z) (if (dk--redex? (dk-goal)) (dk-lam-b!)) (ass))))))
        (mxs-Gcont! mxs-ct)
        (dk-cite! 'closure-cc-sequence-free-closed 'u)
        (dk-cite! 'closure-cc-bounded 'u 'bd)
        (dk-have! (list 'FORSOME 'x0 (list 'IN 'x0 mxb-K)) (lambda () (ew w) (ass)))
        (let* ((a (dk-skolem! (dk-apply! (dk-cite! 'cc-closed-bounded-max mxb-K mxs-G) 'bd)))
               (ga (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f a) (dk-contains? f mxs-G))) "the maximum"))
               (fa (list 'f a)))
          (mxs-typ! a)
          (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z mxb-K) (list '<= '(magnitude (f z)) (list 'magnitude fa))))
            (lambda ()
              (let ((z (dk-di-var!)))
                (mxs-typ! z)
                (dk-apply! ga z)
                (dk-lam-b-h! (dk-pick (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f mxs-G))) "the instance"))
                (ass))))
          (let ((kb (dk-ctx-form (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z mxb-K) (list '<= '(magnitude (f z)) (list 'magnitude fa)))))))
            (dk-apply! kb w)
            (use-em (list 'IN a 'u)
              (lambda () (mxs-case-in! a kb w))
              (lambda () (mxs-case-out! a w)))))))))
(define (mxs-case-in! a kb w)
  (let ((fa (list 'f a)))
    (dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list '<= '(magnitude (f z)) (list 'magnitude fa))))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd 'u mxb-K z) (dk-apply! kb z) (ass))))
    (mxs-const! a (dk-ctx-form (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list '<= '(magnitude (f z)) (list 'magnitude fa))))))
    (let* ((b (dk-skolem! (dk-cite! 'bounded-open-boundary-nonempty 'u a 'bd)))
           (iff (dk-cite! 'difference-membership mxb-K '(INTERIOR CC-MS u) b)))
      (dk-have! (list 'IN b mxb-K) (lambda () (dk-only! iff (list 'IN b mxs-BD)) (prop)))
      (mxs-bd-at! b)
      (mxs-typ! b)
      (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'CLOSURE) (dk-contains? f fa) (dk-contains? f '=))) "constancy on the closure") b)
      (dk-have! (list '<= (list 'magnitude fa) 'm)
        (lambda () (subst (list '= fa (list 'f b))) (ass)))
      (dk-ineq! (list 'IN '(magnitude (f w)) 'RR) (list 'IN (list 'magnitude fa) 'RR) '(IN m RR)
                (list '<= (list 'magnitude (list 'f w)) (list 'magnitude fa)) (list '<= (list 'magnitude fa) 'm)))))
(define (mxs-case-out! a w)
  (let ((fa (list 'f a)) (I '(INTERIOR CC-MS u)))
    (dk-have! (list 'NOT (list 'IN a I))
      (lambda () (di) (fact 'subset-mem-fwd I 'u a) (ai (list 'NOT (list 'IN a 'u)))))
    (let ((iff (dk-cite! 'difference-membership mxb-K I a))
          (cj (list 'AND (list 'IN a mxb-K) (list 'NOT (list 'IN a I)))))
      (dk-have! cj (lambda () (dk-conj-close! (lambda () (ass)))))
      (dk-have! (list 'IN a mxs-BD) (lambda () (dk-only! iff cj) (prop))))
    (mxs-bd-at! a)
    (dk-ineq! (list 'IN '(magnitude (f w)) 'RR) (list 'IN (list 'magnitude fa) 'RR) '(IN m RR)
              (list '<= (list 'magnitude (list 'f w)) (list 'magnitude fa)) (list '<= (list 'magnitude fa) 'm))))
(mxs-P1!)
(dk-conj-close!
 (lambda ()
   (if (alpha-equiv? (dk-goal) mxs-P1)
       (ass)
       (let* ((w (dk-di-var!)))
         (dk-peel!)
         (mxs-u! w)
         (dk-have! (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list '<= '(magnitude (f z)) (list 'magnitude (list 'f w)))))
           (lambda ()
             (let ((z (dk-di-var!)))
               (dk-apply! (dk-ctx-form mxs-P1) z)
               (subst (list '= (list 'magnitude (list 'f w)) 'm))
               (ass))))
         (mxs-const! w (dk-ctx-form (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list '<= '(magnitude (f z)) (list 'magnitude (list 'f w)))))))
         (let ((z (cadr (cadr (dk-goal)))))
           (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'CLOSURE) (dk-contains? f (list 'f w)) (dk-contains? f '=))) "constancy on the closure") z)
           (ass))))))
(qed 'mvp-maximum-modulus-closure)
