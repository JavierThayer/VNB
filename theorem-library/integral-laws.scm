(define igl-ind '(INDICATOR omega a_))
(define igl-t2 '(UNION (PAIR 0 0) (PAIR 1 1)))

;;; x in omega: split on x in a_, K called as (K v) with (= (ind x) v) landed
(define (igl-ind-cases! x k)
  (use-em (list 'IN x 'a_)
    (lambda () (fact 'indicator-value-in 'omega 'a_ x) (k 1))
    (lambda () (fact 'indicator-value-out 'omega 'a_ x) (k 0))))

;;; 0, 1 and {0}, {1}, {0} u {1}: sets; the last finite
(define (igl-t2-facts!)
  (fact 'rr-zero-in) (fact 'rr-one-in)
  (fact 'membership-implies-sethood 0 'RR)
  (fact 'membership-implies-sethood 1 'RR)
  (dk-have! '(AND (IN 0 SET) (IN 0 SET)))
  (fact 'pairing 0 0)
  (dk-have! '(AND (IN 1 SET) (IN 1 SET)))
  (fact 'pairing 1 1)
  (dk-have! '(AND (IN (PAIR 0 0) SET) (IN (PAIR 1 1) SET)))
  (fact 'union-set-closure '(PAIR 0 0) '(PAIR 1 1))
  (fact 'nn-zero-in)
  (fact 'nn-succ-closed 0)
  (fact 'card-singleton 1)
  (fact 'card-singleton 0)
  (dk-have! '(IN (CARD (PAIR 1 1)) NN) (lambda () (subst '(= (CARD (PAIR 1 1)) (succ 0))) (ass)))
  (dk-have! '(IN (CARD (PAIR 0 0)) NN) (lambda () (subst '(= (CARD (PAIR 0 0)) (succ 0))) (ass)))
  (dk-split! (dk-cite! 'card-union-singleton-bound '(PAIR 1 1) 0)))

;;; (IN v T2) for v = 0 or 1
(define (igl-in-t2! v)
  (dk-have! (list 'IN v igl-t2)
    (lambda ()
      (mac 'union-membership)
      (if (equal? v 0) (oi-l) (oi-r))
      (let ((pm (inst*! (dk-cite! 'pairing-membership v v) v)))
        (dk-have! (list '= v v) (lambda () (rfl)))
        (igl-keep-prop! pm (list '= v v))))))

;;; p in T2: (OR (= p 0) (= p 1)), on a lane (the membership survives)
(define (igl-t2-or! p)
  (let ((claim (list 'OR (list '= p 0) (list '= p 1))))
    (dk-have! claim
      (lambda ()
        (let ((cs (dk-landed-1 (lambda () (mac-h 'union-membership (list 'IN p igl-t2))))))
          (let ((pm0 (inst*! (dk-cite! 'pairing-membership 0 0) p))
                (pm1 (inst*! (dk-cite! 'pairing-membership 1 1) p)))
            (igl-keep-prop! cs pm0 pm1)))))
    claim))

;;; indicator-simple: the indicator of a measurable set is a simple function.
