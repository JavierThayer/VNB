;;; etimes-closed
(sp (make-wff
     '(FORALL x (FORALL y
        (IMPLIES (AND (IN x RR-POS-STAR) (IN y RR-POS-STAR))
          (IN (etimes x y) RR-POS-STAR))))))
(dk-peel!)
(dk-split! '(AND (IN x RR-POS-STAR) (IN y RR-POS-STAR)))
(ibk-star-cases! 'x
  (lambda ()
    (ibk-star-cases! 'y
      (lambda ()
        (ibk-etimes-real! 'x 'y)
        (ibk-mul-nonneg! 'x 'y)
        (ibk-rps-from-real!))
      (lambda ()
        (subst '(= y POS-INF))
        (ibk-zero-split! 'x
          (lambda ()
            (subst '(= x 0))
            (fact 'etimes-zero-pos-inf)
            (subst '(= (etimes 0 POS-INF) 0))
            (fact 'zero-in-rr-pos-star) (ass))
          (lambda ()
            (ibk-et-inf-right! 'x)
            (fact 'pos-inf-in-rr-pos-star) (ass))))))
  (lambda ()
    (subst '(= x POS-INF))
    (ibk-zero-split! 'y
      (lambda ()
        (subst '(= y 0))
        (fact 'etimes-pos-inf-zero)
        (subst '(= (etimes POS-INF 0) 0))
        (fact 'zero-in-rr-pos-star) (ass))
      (lambda ()
        (ibk-et-inf-left! 'y)
        (fact 'pos-inf-in-rr-pos-star) (ass)))))
(qed 'etimes-closed)
(topic! 'etimes-closed 'analysis)

;;; etimes-zero-left
(sp (make-wff '(FORALL x (IMPLIES (IN x RR-POS-STAR) (= (etimes 0 x) 0)))))
(dk-peel!)
(ibk-star-cases! 'x
  (lambda ()
    (ibk-etimes-real! 0 'x)
    (fact 'rr-zero-mul 'x)
    (ass))
  (lambda ()
    (subst '(= x POS-INF))
    (fact 'etimes-zero-pos-inf)
    (ass)))
(qed 'etimes-zero-left)
(topic! 'etimes-zero-left 'analysis)

;;; etimes-zero-right
(sp (make-wff '(FORALL x (IMPLIES (IN x RR-POS-STAR) (= (etimes x 0) 0)))))
(dk-peel!)
(ibk-star-cases! 'x
  (lambda ()
    (ibk-etimes-real! 'x 0)
    (fact 'rr-mul-zero 'x)
    (ass))
  (lambda ()
    (subst '(= x POS-INF))
    (fact 'etimes-pos-inf-zero)
    (ass)))
(qed 'etimes-zero-right)
(topic! 'etimes-zero-right 'analysis)

;;; etimes-one-left
(sp (make-wff '(FORALL x (IMPLIES (IN x RR-POS-STAR) (= (etimes 1 x) x)))))
(dk-peel!)
(ibk-star-cases! 'x
  (lambda ()
    (ibk-etimes-real! 1 'x)
    (fact 'rr-one-mul 'x)
    (ass))
  (lambda ()
    (subst '(= x POS-INF))
    (fact 'rr-one-in)
    (have! '(<= 0 1) (lambda () (arith)))
    (ibk-rps! 1)
    (have! '(NOT (= 1 0)) (lambda () (arith)))
    (ibk-et-inf-right! 1)
    (rfl)))
(qed 'etimes-one-left)
(topic! 'etimes-one-left 'analysis)

;;; etimes-comm
(sp (make-wff
     '(FORALL x (FORALL y
        (IMPLIES (AND (IN x RR-POS-STAR) (IN y RR-POS-STAR))
          (= (etimes x y) (etimes y x)))))))
(dk-peel!)
(dk-split! '(AND (IN x RR-POS-STAR) (IN y RR-POS-STAR)))
(ibk-star-cases! 'x
  (lambda ()
    (ibk-star-cases! 'y
      (lambda ()
        (ibk-etimes-real! 'x 'y)
        (ibk-etimes-real! 'y 'x)
        (have! '(AND (IN x RR) (IN y RR)))
        (fact 'rr-mul-comm 'x 'y)
        (ass))
      (lambda ()
        (subst '(= y POS-INF))
        (ibk-zero-split! 'x
          (lambda ()
            (subst '(= x 0))
            (fact 'etimes-zero-pos-inf)
            (fact 'etimes-pos-inf-zero)
            (subst '(= (etimes 0 POS-INF) 0))
            (subst '(= (etimes POS-INF 0) 0))
            (rfl))
          (lambda ()
            (ibk-et-inf-right! 'x)
            (ibk-et-inf-left! 'x)
            (rfl))))))
  (lambda ()
    (subst '(= x POS-INF))
    (ibk-zero-split! 'y
      (lambda ()
        (subst '(= y 0))
        (fact 'etimes-zero-pos-inf)
        (fact 'etimes-pos-inf-zero)
        (subst '(= (etimes 0 POS-INF) 0))
        (subst '(= (etimes POS-INF 0) 0))
        (rfl))
      (lambda ()
        (ibk-et-inf-left! 'y)
        (ibk-et-inf-right! 'y)
        (rfl)))))
(qed 'etimes-comm)
(topic! 'etimes-comm 'analysis)


;;; etimes-distrib-left: a REAL nonnegative scalar distributes over eplus.
(sp (make-wff
     '(FORALL c (IMPLIES (IN c RR) (IMPLIES (<= 0 c)
        (FORALL x (FORALL y
          (IMPLIES (AND (IN x RR-POS-STAR) (IN y RR-POS-STAR))
            (= (etimes c (eplus x y)) (eplus (etimes c x) (etimes c y)))))))))))
(dk-peel!)
(dk-split! '(AND (IN x RR-POS-STAR) (IN y RR-POS-STAR)))
(ibk-rps! 'c)
(have! '(AND (IN x RR-POS-STAR) (IN y RR-POS-STAR)))
(fact 'eplus-closed 'x 'y)
(have! '(AND (IN c RR-POS-STAR) (IN x RR-POS-STAR)))
(fact 'etimes-closed 'c 'x)
(have! '(AND (IN c RR-POS-STAR) (IN y RR-POS-STAR)))
(fact 'etimes-closed 'c 'y)
(ibk-zero-split! 'c
  (lambda ()
    (subst '(= c 0))
    (fact 'etimes-zero-left '(eplus x y))
    (subst '(= (etimes 0 (eplus x y)) 0))
    (fact 'etimes-zero-left 'x)
    (subst '(= (etimes 0 x) 0))
    (fact 'etimes-zero-left 'y)
    (subst '(= (etimes 0 y) 0))
    (fact 'zero-in-rr-pos-star)
    (fact 'eplus-zero-left 0)
    (subst '(= (eplus 0 0) 0))
    (rfl))
  (lambda ()
    (ibk-star-cases! 'x
      (lambda ()
        (ibk-star-cases! 'y
          (lambda ()
            (ibk-eplus-real! 'x 'y)
            (ibk-add-nonneg! 'x 'y)
            (ibk-etimes-real! 'c '(+ x y))
            (ibk-etimes-real! 'c 'x)
            (ibk-etimes-real! 'c 'y)
            (ibk-mul-nonneg! 'c 'x)
            (ibk-mul-nonneg! 'c 'y)
            (ibk-eplus-real! '(* c x) '(* c y))
            (have! '(AND (IN c RR) (AND (IN x RR) (IN y RR))))
            (fact 'rr-distributive 'c 'x 'y)
            (ass))
          (lambda ()
            (subst '(= y POS-INF))
            (ibk-ep-inf-right! 'x)
            (ibk-et-inf-right! 'c)
            (ibk-ep-inf-right! '(etimes c x))
            (rfl))))
      (lambda ()
        (subst '(= x POS-INF))
        (ibk-ep-inf-left! 'y)
        (ibk-et-inf-right! 'c)
        (ibk-ep-inf-left! '(etimes c y))
        (rfl)))))
(qed 'etimes-distrib-left)
(topic! 'etimes-distrib-left 'analysis)

;;; etimes-mono-left: multiplication by a real c >= 0 is monotone.
(sp (make-wff
     '(FORALL c (IMPLIES (IN c RR) (IMPLIES (<= 0 c)
        (FORALL x (FORALL y
          (IMPLIES (AND (IN x RR-POS-STAR) (IN y RR-POS-STAR))
            (IMPLIES (<= x y)
              (<= (etimes c x) (etimes c y)))))))))))
(dk-peel!)
(dk-split! '(AND (IN x RR-POS-STAR) (IN y RR-POS-STAR)))
(ibk-rps! 'c)
(have! '(AND (IN c RR-POS-STAR) (IN x RR-POS-STAR)))
(fact 'etimes-closed 'c 'x)
(ibk-zero-split! 'c
  (lambda ()
    (subst '(= c 0))
    (fact 'etimes-zero-left 'x)
    (subst '(= (etimes 0 x) 0))
    (fact 'etimes-zero-left 'y)
    (subst '(= (etimes 0 y) 0))
    (fact 'zero-in-rr-pos-star)
    (fact 'rr-pos-star-le-refl 0)
    (ass))
  (lambda ()
    (ibk-star-cases! 'y
      (lambda ()
        (have! '(AND (IN x RR-POS-STAR) (IN y RR)))
        (fact 'rr-pos-star-le-real-in-rr 'x 'y)
        (fact 'rr-pos-star-nonneg 'x)
        (ibk-etimes-real! 'c 'x)
        (ibk-etimes-real! 'c 'y)
        (fact 'rr-mul-le-right 'x 'y 'c)
        (have! '(AND (IN c RR) (IN x RR)))
        (fact 'rr-mul-comm 'c 'x)
        (have! '(AND (IN c RR) (IN y RR)))
        (fact 'rr-mul-comm 'c 'y)
        (subst '(= (* c x) (* x c)))
        (subst '(= (* c y) (* y c)))
        (ass))
      (lambda ()
        (subst '(= y POS-INF))
        (ibk-et-inf-right! 'c)
        (fact 'rr-pos-star-below-pos-inf '(etimes c x))
        (ass)))))
(qed 'etimes-mono-left)
(topic! 'etimes-mono-left 'inequalities)

;;; etimes-assoc-real: c (d x) = (c d) x for real c, d >= 0.
(sp (make-wff
     '(FORALL c (IMPLIES (IN c RR) (IMPLIES (<= 0 c)
        (FORALL d (IMPLIES (IN d RR) (IMPLIES (<= 0 d)
          (FORALL x (IMPLIES (IN x RR-POS-STAR)
            (= (etimes c (etimes d x)) (etimes (* c d) x))))))))))))
(dk-peel!)
(ibk-rps! 'c)
(ibk-rps! 'd)
(ibk-mul-nonneg! 'c 'd)
(ibk-star-cases! 'x
  (lambda ()
    (ibk-etimes-real! 'd 'x)
    (ibk-mul-nonneg! 'd 'x)
    (ibk-etimes-real! 'c '(* d x))
    (ibk-etimes-real! '(* c d) 'x)
    (have! '(AND (IN c RR) (AND (IN d RR) (IN x RR))))
    (fact 'rr-mul-assoc 'c 'd 'x)
    (subst '(= (* (* c d) x) (* c (* d x))))
    (rfl))
  (lambda ()
    (subst '(= x POS-INF))
    (ibk-zero-split! 'd
      (lambda ()
        (subst '(= d 0))
        (fact 'etimes-zero-pos-inf)
        (subst '(= (etimes 0 POS-INF) 0))
        (fact 'rr-mul-zero 'c)
        (subst '(= (* c 0) 0))
        (subst '(= (etimes 0 POS-INF) 0))
        (fact 'etimes-zero-right 'c)
        (ass))
      (lambda ()
        (ibk-et-inf-right! 'd)
        (ibk-zero-split! 'c
          (lambda ()
            (subst '(= c 0))
            (fact 'rr-zero-mul 'd)
            (subst '(= (* 0 d) 0))
            (fact 'etimes-zero-pos-inf)
            (subst '(= (etimes 0 POS-INF) 0))
            (rfl))
          (lambda ()
            (ibk-et-inf-right! 'c)
            (ibk-pos! 'c)
            (ibk-pos! 'd)
            (fact 'rr-mul-pos 'c 'd)
            (ibk-nz-of-pos! '(* c d))
            (ibk-rps! '(* c d))
            (ibk-et-inf-right! '(* c d))
            (rfl)))))))
(qed 'etimes-assoc-real)
(topic! 'etimes-assoc-real 'analysis)

;;; etimes-distrib-right-real: (c + d) x = c x + d x for real c, d >= 0, the
;;; sum written with eplus (the sum of two values of a simple function).
(sp (make-wff
     '(FORALL c (IMPLIES (IN c RR) (IMPLIES (<= 0 c)
        (FORALL d (IMPLIES (IN d RR) (IMPLIES (<= 0 d)
          (FORALL x (IMPLIES (IN x RR-POS-STAR)
            (= (etimes (eplus c d) x) (eplus (etimes c x) (etimes d x)))))))))))))
(dk-peel!)
(ibk-rps! 'c)
(ibk-rps! 'd)
(have! '(AND (IN c RR-POS-STAR) (IN x RR-POS-STAR)))
(fact 'etimes-closed 'c 'x)
(have! '(AND (IN d RR-POS-STAR) (IN x RR-POS-STAR)))
(fact 'etimes-closed 'd 'x)
(ibk-zero-split! 'c
  (lambda ()
    (subst '(= c 0))
    (fact 'eplus-zero-left 'd)
    (subst '(= (eplus 0 d) d))
    (fact 'etimes-zero-left 'x)
    (subst '(= (etimes 0 x) 0))
    (fact 'eplus-zero-left '(etimes d x))
    (subst '(= (eplus 0 (etimes d x)) (etimes d x)))
    (rfl))
  (lambda ()
    (ibk-zero-split! 'd
      (lambda ()
        (subst '(= d 0))
        (fact 'eplus-zero-right 'c)
        (subst '(= (eplus c 0) c))
        (fact 'etimes-zero-left 'x)
        (subst '(= (etimes 0 x) 0))
        (fact 'eplus-zero-right '(etimes c x))
        (subst '(= (eplus (etimes c x) 0) (etimes c x)))
        (rfl))
      (lambda ()
        (ibk-eplus-real! 'c 'd)
        (ibk-add-nonneg! 'c 'd)
        (ibk-star-cases! 'x
          (lambda ()
            (ibk-etimes-real! '(+ c d) 'x)
            (ibk-etimes-real! 'c 'x)
            (ibk-etimes-real! 'd 'x)
            (ibk-mul-nonneg! 'c 'x)
            (ibk-mul-nonneg! 'd 'x)
            (ibk-eplus-real! '(* c x) '(* d x))
            (crs))
          (lambda ()
            (subst '(= x POS-INF))
            (ibk-pos! 'c)
            (have! '(< 0 (+ c d))
              (lambda () (dk-ineq! '(IN c RR) '(IN d RR) '(< 0 c) '(<= 0 d))))
            (ibk-nz-of-pos! '(+ c d))
            (ibk-rps! '(+ c d))
            (ibk-et-inf-right! '(+ c d))
            (ibk-et-inf-right! 'c)
            (ibk-et-inf-right! 'd)
            (fact 'pos-inf-in-rr-pos-star)
            (ibk-ep-inf-left! 'POS-INF)
            (rfl)))))))
(qed 'etimes-distrib-right-real)
(topic! 'etimes-distrib-right-real 'analysis)


;;; etimes-mono-real-left: monotone in a REAL left factor, the right factor any
;;; element of [0,+inf] (the termwise comparison of two simple integrals).
(sp (make-wff
     '(FORALL a (FORALL b (IMPLIES (IN a RR) (IMPLIES (IN b RR) (IMPLIES (<= 0 a)
        (IMPLIES (<= a b)
          (FORALL m (IMPLIES (IN m RR-POS-STAR)
            (<= (etimes a m) (etimes b m))))))))))))
(dk-peel!)
(dk-have! '(<= 0 b) (lambda () (dk-ineq! '(IN a RR) '(IN b RR) '(<= 0 a) '(<= a b))))
(ibk-rps! 'a)
(ibk-rps! 'b)
(ibk-star-cases! 'm
  (lambda ()
    (ibk-etimes-real! 'a 'm)
    (ibk-etimes-real! 'b 'm)
    (fact 'rr-mul-le-right 'a 'b 'm)
    (ass))
  (lambda ()
    (subst '(= m POS-INF))
    (fact 'pos-inf-in-rr-pos-star)
    (dk-have! '(AND (IN b RR-POS-STAR) (IN POS-INF RR-POS-STAR)))
    (fact 'etimes-closed 'b 'POS-INF)
    (ibk-zero-split! 'a
      (lambda ()
        (subst '(= a 0))
        (fact 'etimes-zero-pos-inf)
        (subst '(= (etimes 0 POS-INF) 0))
        (fact 'rr-pos-star-nonneg '(etimes b POS-INF))
        (ass))
      (lambda ()
        (ibk-pos! 'a)
        (dk-have! '(< 0 b) (lambda () (dk-ineq! '(IN a RR) '(IN b RR) '(< 0 a) '(<= a b))))
        (ibk-nz-of-pos! 'b)
        (ibk-et-inf-right! 'a)
        (ibk-et-inf-right! 'b)
        (fact 'rr-pos-star-le-refl 'POS-INF)
        (ass)))))
(qed 'etimes-mono-real-left)
(topic! 'etimes-mono-real-left 'inequalities)

;;; =====================================================================
;;; (B) FINITE SUMS IN A COMMUTATIVE MONOID, pointwise-typed.
;;;     The comm-monoid mirrors the integral needs of the abelian-group laws
;;;     (finsum-all-id-ptwise, finsum-add-ag, finsum-fiber), each by
;;;     finite-set-induction.  Pointwise typing throughout, so a hypothesis
;;;     about a set restricts to its subsets for free.
;;; =====================================================================

;;; forall z_ in U. BODY(z_)
(define (ibk-syms x)
  (cond ((symbol? x) (list x)) ((pair? x) (append (ibk-syms (car x)) (ibk-syms (cdr x)))) (#t '())))
(define (ibk-ptw u body-of)
  (let* ((used (append (ibk-syms u) (ibk-syms (body-of 'ibk-dummy))))
         (b    (let loop ((cs '(z_ zz_ zq_ zr_ zs_ zt_)))
                 (if (memq (car cs) used) (loop (cdr cs)) (car cs)))))
    (list 'FORALL b (list 'IMPLIES (list 'IN b u) (body-of b)))))
(define (ibk-carr-of m) (lambda (fv) (lambda (z) (list 'IN (list fv z) (list 'CARR m)))))

;;; The finite-set induction.  Goal anything; context holds (IN X SET) and
;;; (IN (CARD X) NN).  PROP-OF maps a set term to the claim P(u).  BASE! proves
;;; P(EMPTY-SET) on its leaf; (STEP! S x U IH) proves P(U), U = S u {x}, with
;;; (IN S SET), (IN (CARD S) NN), (IN x SET), (NOT (IN x S)), (IN U SET) and
;;; IH = P(S) in context.  Lands P(X) and returns it.
(define (ibk-class prop-of) (list 'COMP 'iu_ (prop-of 'iu_)))
(define (ibk-step-formula c)
  (list 'FORALL 'is_
    (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ c)))
      (list 'FORALL 'ix_
        (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
          (list 'IN '(UNION is_ (PAIR ix_ ix_)) c))))))
(define (ibk-induct! xs prop-of base! step!)
  (let* ((c     (ibk-class prop-of))
         (stepf (ibk-step-formula c)))
    (have! (list 'IN 'EMPTY-SET c)
      (lambda ()
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) '(in empty-set set))
                (begin (fact 'empty-set-is-set) (ass))
                (base!)))
          (dk-opened (lambda () (comp-mi))))))
    (have! stepf
      (lambda ()
        (let* ((landed (dk-peel!))
               (g      (dk-goal))
               (u      (cadr g))
               (sv     (cadr u))
               (xv     (cadr (caddr u))))
          (dk-split-all! landed)
          (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
          (fact 'pairing xv xv)
          (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET)))
          (fact 'union-set-closure sv (list 'PAIR xv xv))
          ;; ... and U is finite
          (let ((pu (list 'UNION (list 'PAIR xv xv) sv)))
            (dk-split! (dk-fact! 'card-union-singleton-bound sv xv))
            (fact 'union-comm (list 'PAIR xv xv) sv)
            (dk-have! (list 'IN (list 'CARD u) 'NN)
              (lambda () (subst (list '= u pu)) (ass))))
          (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv c)))))
                 (ih (car (filter (lambda (f) (not (equal? f (list 'in sv 'set)))) ls))))
            (for-each
              (lambda (leaf)
                (dk-focus! leaf)
                (if (equal? (dk-goal) (list 'in u 'set))
                    (ass)
                    (step! sv xv u ih)))
              (dk-opened (lambda () (comp-mi))))))))
    (dk-have! (list 'AND (list 'IN 'EMPTY-SET c) stepf))
    (let ((ind (dk-fact! 'finite-set-induction c)))
      (dk-have! (list 'AND (list 'IN xs 'SET) (list 'IN (list 'CARD xs) 'NN)))
      (let* ((inx (dk-apply! ind xs))
             (ls  (dk-landed (lambda () (comp-me inx)))))
        (car (filter (lambda (f) (not (equal? f (list 'in xs 'set)))) ls))))))

;;; (IN z U) for z in S, U = S u {x}.
(define (ibk-in-union-left! z sv u)
  (dk-have! (list 'IN z u)
    (lambda () (mac 'union-membership) (oi-l) (dk-ass!))))
;;; (IN x U), U = S u {x}, (IN x SET) in context.
(define (ibk-in-union-new! xv u)
  (dk-have! (list 'IN xv u)
    (lambda ()
      (mac 'union-membership) (oi-r)
      (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
      (let ((pm (inst*! (dk-cite! 'pairing-membership xv xv) xv)))
        (have! (list '= xv xv) (lambda () (rfl)))
        (ibk-keep-prop! pm (list '= xv xv))))))

;;; From HYP-U = forall z_ in U. B(z_), land forall z_ in S. B(z_).
(define (ibk-restrict! hyp-u sv u body-of)
  (let ((claim (ibk-ptw sv body-of)))
    (dk-have! claim
      (lambda ()
        (let ((zv (dk-di-var!)))
          (ibk-in-union-left! zv sv u)
          (inst+ hyp-u zv)
          (ass))))
    claim))

;;; finsum-cm-all-iden-ptwise
(sp (make-wff
     '(FORALL m (IMPLIES (IS-COMM-MONOID m)
        (FORALL S (IMPLIES (IN S SET) (IMPLIES (IN (CARD S) NN)
          (FORALL f
            (IMPLIES (FORALL z_ (IMPLIES (IN z_ S) (= (f z_) (IDEN m))))
              (= (FINSUM m f S) (IDEN m)))))))))))
(dk-peel!)
(fact 'comm-monoid-identity-in-carr 'm)
(let* ((body (lambda (z) (list '= (list 'f z) '(IDEN m))))
       (prop-of (lambda (u) (list 'IMPLIES (ibk-ptw u body)
                                  (list '= (list 'FINSUM 'm 'f u) '(IDEN m)))))
       (px (ibk-induct! 's prop-of
             (lambda ()
               (di)
               (fact 'finsum-empty 'm 'f)
               (subst '(== (FINSUM m f EMPTY-SET) (IDEN m)))
               (rfl))
             (lambda (sv xv u ih)
               (let* ((hu (car (dk-landed (lambda () (di))))))
                 (ibk-restrict! hu sv u body)
                 (detach! ih)
                 (dk-have! (ibk-ptw u ((ibk-carr-of 'm) 'f))
                   (lambda ()
                     (let ((zv (dk-di-var!)))
                       (inst+ hu zv)
                       (subst (list '= (list 'f zv) '(IDEN m)))
                       (ass))))
                 (fact 'finsum-cm-insert-ptwise 'm sv xv 'f)
                 (subst (list '= (list 'FINSUM 'm 'f u)
                              (list '(OPR m) (list 'FINSUM 'm 'f sv) (list 'f xv))))
                 (subst (list '= (list 'FINSUM 'm 'f sv) '(IDEN m)))
                 (ibk-in-union-new! xv u)
                 (inst+ hu xv)
                 (subst (list '= (list 'f xv) '(IDEN m)))
                 (fact 'comm-monoid-left-id 'm '(IDEN m))
                 (ass))))))
  (detach! px)
  (ass))
(qed 'finsum-cm-all-iden-ptwise)
(topic! 'finsum-cm-all-iden-ptwise 'algebra)


;;; Detach every leading antecedent of IMP that is in context; return the
;;; formula reached (the consequent as the context holds it).
(define (ibk-detach-all! imp)
  (let loop ((f imp))
    (if (and (pair? f) (eq? (car f) 'implies) (dk-asm? (cadr f)))
        (let ((new (dk-landed (lambda () (detach! f)))))
          (loop (if (pair? new) (car new) (caddr f))))
        f)))

;;; (IN k (PAIR k k)) with (IN k SET) in context.
(define (ibk-in-pair-self! kv)
  (dk-have! (list 'IN kv (list 'PAIR kv kv))
    (lambda ()
      (dk-have! (list 'AND (list 'IN kv 'SET) (list 'IN kv 'SET)))
      (let ((pm (inst*! (dk-cite! 'pairing-membership kv kv) kv)))
        (have! (list '= kv kv) (lambda () (rfl)))
        (ibk-keep-prop! pm (list '= kv kv))))))

;;; Set equality by elements: lands (= A B).  (FWD! w) proves (IN w B) with
;;; (IN w A) in context, (BWD! w) the converse.
(define (ibk-set-eq! a b fwd! bwd!)
  (dk-have! (list 'FORALL 'ew_ (list 'IFF (list 'IN 'ew_ a) (list 'IN 'ew_ b)))
    (lambda ()
      (let ((w (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (for-each (lambda (l)
                    (dk-focus! l)
                    (if (equal? (dk-goal) (list 'in w b)) (fwd! w) (bwd! w)))
                  (dk-opened (lambda () (di)))))))
  (fact 'class-extensionality a b)
  (list '= a b))

;;; Goal (IN w (SEP x A p)): `sep-mi', then CLOSER on every leaf it opened
;;; that is still open (a leaf grounded by an earlier closer is skipped -- a
;;; focus move to a grounded leaf is a no-op, and the closer would then fire on
;;; whatever leaf holds the focus).
(define (ibk-sep-in! closer)
  (for-each (lambda (l)
              (if (not (sequent-node-grounded? l))
                  (begin (dk-focus! l) (closer))))
            (dk-opened (lambda () (sep-mi)))))
;;; The closer most SEP intros want: an assumption, else membership in the
;;; union U = S u {x} from membership in S, else reflexivity.
(define (ibk-sep-closer sv u)
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (ass))
            ((and (pair? g) (eq? (car g) 'in) (equal? (caddr g) u))
             (ibk-in-union-left! (cadr g) sv u))
            (#t (rfl))))))

;;; A subset SUB of the finite set BIG (both terms): land (IN SUB SET) and
;;; (IN (CARD SUB) NN).  (IN BIG SET), (IN (CARD BIG) NN) in context; MEMB!
;;; proves (IN w BIG) with (IN w SUB) in context.
(define (ibk-fin-sub! big sub memb!)
  (let ((incl (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z sub) (list 'IN 'z big)))))
    (dk-have! incl (lambda () (let ((w (dk-di-var!))) (memb! w))))
    (dk-have! (list 'SUBSET sub big)
      (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (inst+ incl w) (ass))))
    (fact 'subclass-of-set-is-set sub big)
    (dk-have! (list 'AND (list 'IN big 'SET) (list 'IN (list 'CARD big) 'NN)))
    (dk-have! (list 'AND (list 'IN sub 'SET) incl))
    (fact 'card-subset-nn big sub)))

;;; finsum-cm-add-ptwise: the sum of a pointwise sum is the sum of the sums.
(sp (make-wff
     '(FORALL m (IMPLIES (IS-COMM-MONOID m)
        (FORALL S (IMPLIES (IN S SET) (IMPLIES (IN (CARD S) NN)
          (FORALL f (FORALL g (FORALL h
            (IMPLIES (FORALL z_ (IMPLIES (IN z_ S) (IN (f z_) (CARR m))))
            (IMPLIES (FORALL z_ (IMPLIES (IN z_ S) (IN (g z_) (CARR m))))
            (IMPLIES (FORALL z_ (IMPLIES (IN z_ S) (= (h z_) ((OPR m) (f z_) (g z_)))))
              (= (FINSUM m h S) ((OPR m) (FINSUM m f S) (FINSUM m g S))))))))))))))))
(dk-peel!)
(fact 'comm-monoid-identity-in-carr 'm)
(let* ((tf (lambda (z) (list 'IN (list 'f z) '(CARR m))))
       (tg (lambda (z) (list 'IN (list 'g z) '(CARR m))))
       (eh (lambda (z) (list '= (list 'h z) (list '(OPR m) (list 'f z) (list 'g z)))))
       (fs (lambda (fv u) (list 'FINSUM 'm fv u)))
       (prop-of (lambda (u)
                  (list 'IMPLIES (ibk-ptw u tf)
                    (list 'IMPLIES (ibk-ptw u tg)
                      (list 'IMPLIES (ibk-ptw u eh)
                        (list '= (fs 'h u) (list '(OPR m) (fs 'f u) (fs 'g u))))))))
       (px (ibk-induct! 's prop-of
             (lambda ()
               (dk-peel!)
               (fact 'finsum-empty 'm 'h)
               (fact 'finsum-empty 'm 'f)
               (fact 'finsum-empty 'm 'g)
               (subst (list '== (fs 'h 'EMPTY-SET) '(IDEN m)))
               (subst (list '== (fs 'f 'EMPTY-SET) '(IDEN m)))
               (subst (list '== (fs 'g 'EMPTY-SET) '(IDEN m)))
               (fact 'comm-monoid-left-id 'm '(IDEN m))
               (subst '(= ((OPR m) (IDEN m) (IDEN m)) (IDEN m)))
               (rfl))
             (lambda (sv xv u ih)
               (let* ((hs  (dk-peel!))
                      (hfu (ibk-ptw u tf)) (hgu (ibk-ptw u tg)) (hhu (ibk-ptw u eh)))
                 (ibk-restrict! hfu sv u tf)
                 (ibk-restrict! hgu sv u tg)
                 (ibk-restrict! hhu sv u eh)
                 (ibk-detach-all! ih)
                 (ibk-in-union-new! xv u)
                 (inst+ hfu xv) (inst+ hgu xv) (inst+ hhu xv)
                 (dk-have! (ibk-ptw u (lambda (z) (list 'IN (list 'h z) '(CARR m))))
                   (lambda ()
                     (let ((zv (dk-di-var!)))
                       (inst+ hhu zv) (inst+ hfu zv) (inst+ hgu zv)
                       (subst (eh zv))
                       (fact 'comm-monoid-carrier-closed-opr 'm (list 'f zv) (list 'g zv))
                       (ass))))
                 (for-each (lambda (fv) (fact 'finsum-cm-insert-ptwise 'm sv xv fv)) '(f g h))
                 (fact 'finsum-comm-monoid-type-ptwise 'm sv 'f)
                 (fact 'finsum-comm-monoid-type-ptwise 'm sv 'g)
                 (for-each (lambda (fv)
                             (subst (list '= (fs fv u)
                                          (list '(OPR m) (fs fv sv) (list fv xv)))))
                           '(h f g))
                 (subst (list '= (fs 'h sv) (list '(OPR m) (fs 'f sv) (fs 'g sv))))
                 (subst (eh xv))
                 (fact 'comm-monoid-opr-interchange 'm (fs 'f sv) (fs 'g sv)
                       (list 'f xv) (list 'g xv))
                 (ass))))))
  (ibk-detach-all! px)
  (ass))
(qed 'finsum-cm-add-ptwise)
(topic! 'finsum-cm-add-ptwise 'algebra)

;;; finsum-cm-remove-ptwise: peel one known element off a finite sum.
(sp (make-wff
     '(FORALL m (IMPLIES (IS-COMM-MONOID m)
        (FORALL T (IMPLIES (IN T SET) (IMPLIES (IN (CARD T) NN)
          (FORALL k (IMPLIES (IN k T)
            (FORALL g
              (IMPLIES (FORALL z_ (IMPLIES (IN z_ T) (IN (g z_) (CARR m))))
                (= (FINSUM m g T)
                   ((OPR m) (FINSUM m g (DIFFERENCE T (PAIR k k))) (g k))))))))))))))
(dk-peel!)
(let* ((d  '(DIFFERENCE t (PAIR k k)))
       (ud (list 'UNION d '(PAIR k k))))
  (fact 'membership-implies-sethood 'k 't)
  (fact 'difference-set 't '(PAIR k k))
  (ibk-fin-sub! 't d
    (lambda (w)
      (mac-h 'difference-membership (list 'IN w d))
      (dk-split-all!)
      (ass)))
  (ibk-in-pair-self! 'k)
  (dk-have! (list 'NOT (list 'IN 'k d))
    (lambda ()
      (di)
      (mac-h 'difference-membership (list 'IN 'k d))
      (dk-split-all!)
      (ibk-keep-prop! '(IN k (PAIR k k)) '(NOT (IN k (PAIR k k))))))
  (fact 'remove-restore 't 'k)
  (dk-have! (ibk-ptw ud (lambda (z) (list 'IN (list 'g z) '(CARR m))))
    (lambda () (subst (list '= ud 't)) (ass)))
  (fact 'finsum-cm-insert-ptwise 'm d 'k 'g)
  (fact 'finsum-comm-monoid-type-ptwise 'm 't 'g)
  (dk-congr! (list '= ud 't) (lambda (x) (list 'FINSUM 'm 'g x)))
  (subst (list '= '(FINSUM m g t) (list 'FINSUM 'm 'g ud)))
  (ass))
(qed 'finsum-cm-remove-ptwise)
(topic! 'finsum-cm-remove-ptwise 'algebra)


;;; The two fiber identities the fibered sum turns on.  For U = S u {x}:
;;;   sep-fiber-insert-other: phi(x) /= z  =>  fib_U(z) = fib_S(z)
;;;   sep-fiber-insert-same:  fib_U(phi(x)) = fib_S(phi(x)) u {x}, phi(x) DEFINED
;;;   (x lies in its own fiber only when phi(x) = phi(x), and `=' is strict)

;;; (= w x) from (IN w (PAIR x x)), (IN x SET) in context.
(define (ibk-single-eq! w xv)
  (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
  (let ((pm (inst*! (dk-cite! 'pairing-membership xv xv) w)))
    (dk-have! (list '= w xv)
      (lambda () (ibk-keep-prop! pm (list 'IN w (list 'PAIR xv xv)))))))

(sp (make-wff
     '(FORALL S (FORALL x (FORALL phi (FORALL z
        (IMPLIES (IN x SET)
          (IMPLIES (NOT (= (phi x) z))
            (= (SEP fw_ (UNION S (PAIR x x)) (= (phi fw_) z))
               (SEP fw_ S (= (phi fw_) z)))))))))))
(dk-peel!)
(let* ((u  '(UNION s (PAIR x x)))
       (fa (list 'SEP 'fw_ u '(= (phi fw_) z)))
       (fb '(SEP fw_ s (= (phi fw_) z))))
  (ibk-set-eq! fa fb
    (lambda (w)
      (sep-me (list 'IN w fa))
      (let ((cs (dk-landed-1 (lambda () (mac-h 'union-membership (list 'IN w u))))))
        (use-cases cs
          (lambda () (ibk-sep-in! (lambda () (ass))))
          (lambda ()
            (ibk-single-eq! w 'x)
            (dk-have! '(= (phi x) z)
              (lambda () (subst (list '= 'x w)) (ass)))
            (ibk-keep-prop! '(= (phi x) z) '(NOT (= (phi x) z)))))))
    (lambda (w)
      (sep-me (list 'IN w fb))
      (ibk-sep-in! (ibk-sep-closer 's u))))
  (ass))
(qed 'sep-fiber-insert-other)
(topic! 'sep-fiber-insert-other 'set-quotient)

(sp (make-wff
     '(FORALL S (FORALL x (FORALL phi
        (IMPLIES (IN x SET) (IMPLIES (IN (phi x) SET)
          (= (SEP fw_ (UNION S (PAIR x x)) (= (phi fw_) (phi x)))
             (UNION (SEP fw_ S (= (phi fw_) (phi x))) (PAIR x x))))))))))
(dk-peel!)
(let* ((u  '(UNION s (PAIR x x)))
       (fa (list 'SEP 'fw_ u '(= (phi fw_) (phi x))))
       (fs '(SEP fw_ s (= (phi fw_) (phi x))))
       (fb (list 'UNION fs '(PAIR x x))))
  (ibk-set-eq! fa fb
    (lambda (w)
      (sep-me (list 'IN w fa))
      (mac 'union-membership)
      (let ((cs (dk-landed-1 (lambda () (mac-h 'union-membership (list 'IN w u))))))
        (use-cases cs
          (lambda () (oi-l) (ibk-sep-in! (lambda () (ass))))
          (lambda () (oi-r) (dk-ass!)))))
    (lambda (w)
      (let ((cs (dk-landed-1 (lambda () (mac-h 'union-membership (list 'IN w fb))))))
        (use-cases cs
          (lambda ()
            (sep-me (list 'IN w fs))
            (ibk-sep-in! (ibk-sep-closer 's u)))
          (lambda ()
            (ibk-single-eq! w 'x)
            (subst (list '= w 'x))
            (ibk-sep-in!
              (lambda ()
                (let ((g (dk-goal)))
                  (if (and (pair? g) (eq? (car g) 'in))
                      (ibk-in-union-new! 'x u)
                      (rfl))))))))))
  (ass))
(qed 'sep-fiber-insert-same)
(topic! 'sep-fiber-insert-same 'set-quotient)

;;; finsum-cm-fiber-ptwise: FIBERED SUMMATION in a commutative monoid.  For
;;; phi : S -> T and any G with G(t) == the sum of f over the fiber of t,
;;;      SUM_{x in S} f(x)  =  SUM_{t in T} G(t).
;;; The comm-monoid twin of finsum-fiber (finsum-fiber.scm), which needs an
;;; abelian group; proved directly by finite-set-induction on S, peeling the
;;; new point's fiber off T with finsum-cm-remove-ptwise.

(define (ibk-fib u z) (list 'SEP 'fw_ u (list '= '(phi fw_) z)))
(define (ibk-hg-of u gv)
  (ibk-ptw 't (lambda (z) (list '== (list gv z) (list 'FINSUM 'm 'f (ibk-fib u z))))))
(define (ibk-tphi z) (list 'IN (list 'phi z) 't))
(define (ibk-tf z) (list 'IN (list 'f z) '(CARR m)))

;;; Land the finiteness and the typing of SUM f over fib_U(z):
;;; (IN fib SET), (IN (CARD fib) NN), the pointwise typing, (IN SUM (CARR m)).
(define (ibk-fib-typed! u z)
  (let ((fb (ibk-fib u z)))
    (if (not (dk-asm? (list 'IN (list 'FINSUM 'm 'f fb) '(CARR m))))
        (begin
          (ibk-fin-sub! u fb
            (lambda (w) (sep-me (list 'IN w fb)) (ass)))
          (dk-have! (ibk-ptw fb ibk-tf)
            (lambda ()
              (let ((w (dk-di-var!)))
                (sep-me (list 'IN w fb))
                (inst+ (ibk-ptw u ibk-tf) w)
                (ass))))
          (fact 'finsum-comm-monoid-type-ptwise 'm fb 'f)))))

(sp (make-wff
     '(FORALL m (IMPLIES (IS-COMM-MONOID m)
        (FORALL S (IMPLIES (IN S SET) (IMPLIES (IN (CARD S) NN)
          (FORALL T (IMPLIES (IN T SET) (IMPLIES (IN (CARD T) NN)
            (FORALL phi (FORALL f
              (IMPLIES (FORALL z_ (IMPLIES (IN z_ S) (IN (phi z_) T)))
              (IMPLIES (FORALL z_ (IMPLIES (IN z_ S) (IN (f z_) (CARR m))))
                (FORALL gq
                  (IMPLIES (FORALL z_ (IMPLIES (IN z_ T)
                             (== (gq z_) (FINSUM m f (SEP fw_ S (= (phi fw_) z_))))))
                    (= (FINSUM m f S) (FINSUM m gq T))))))))))))))))))
(dk-peel!)
(fact 'comm-monoid-identity-in-carr 'm)
(let* ((prop-of
         (lambda (u)
           (list 'IMPLIES (ibk-ptw u ibk-tphi)
             (list 'IMPLIES (ibk-ptw u ibk-tf)
               (list 'FORALL 'gq_
                 (list 'IMPLIES (ibk-hg-of u 'gq_)
                   (list '= (list 'FINSUM 'm 'f u) '(FINSUM m gq_ t))))))))
       (px (ibk-induct! 's prop-of
             ;; ---- base: S = EMPTY-SET
             (lambda ()
               (dk-peel!)
               (let* ((g  (dk-goal))
                      (gv (caddr (caddr g))))
                 (fact 'finsum-empty 'm 'f)
                 (subst '(== (FINSUM m f EMPTY-SET) (IDEN m)))
                 (dk-have! (ibk-ptw 't (lambda (z) (list '= (list gv z) '(IDEN m))))
                   (lambda ()
                     (let* ((zv (dk-di-var!))
                            (fb (ibk-fib 'EMPTY-SET zv)))
                       (inst+ (ibk-hg-of 'EMPTY-SET gv) zv)
                       (ibk-set-eq! fb 'EMPTY-SET
                         (lambda (w)
                           (sep-me (list 'IN w fb))
                           (fact 'empty-set-has-no-members w)
                           (ibk-keep-prop! (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET))))
                         (lambda (w)
                           (fact 'empty-set-has-no-members w)
                           (ibk-keep-prop! (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET)))))
                       (subst (list '== (list gv zv) (list 'FINSUM 'm 'f fb)))
                       (subst (list '= fb 'EMPTY-SET))
                       (subst '(== (FINSUM m f EMPTY-SET) (IDEN m)))
                       (rfl))))
                 (fact 'finsum-cm-all-iden-ptwise 'm 't gv)
                 (subst (list '= (list 'FINSUM 'm gv 't) '(IDEN m)))
                 (rfl)))
             ;; ---- step: U = S u {x}
             (lambda (sv xv u ih)
               (dk-peel!)
               (let* ((g    (dk-goal))
                      (gv   (caddr (caddr g)))
                      (pxv  (list 'phi xv))
                      (gs   (list 'VNB-LAMBDA 'tv_ 't (list 'FINSUM 'm 'f (ibk-fib sv 'tv_))))
                      (tp   (list 'DIFFERENCE 't (list 'PAIR pxv pxv)))
                      (fbu  (ibk-fib u pxv))
                      (fbs  (ibk-fib sv pxv))
                      (fbsx (list 'UNION fbs (list 'PAIR xv xv))))
                 (ibk-restrict! (ibk-ptw u ibk-tphi) sv u ibk-tphi)
                 (ibk-restrict! (ibk-ptw u ibk-tf) sv u ibk-tf)
                 (ibk-in-union-new! xv u)
                 (inst+ (ibk-ptw u ibk-tphi) xv)
                 (inst+ (ibk-ptw u ibk-tf) xv)
                 ;; the S-side G, and its fiber equation
                 (dk-have! (ibk-hg-of sv gs)
                   (lambda ()
                     (let ((zv (dk-di-var!)))
                       (dk-lam-b!)
                       (qrfl))))
                 ;; the induction hypothesis at gs
                 (let ((fa (ibk-detach-all! ih)))
                   (dk-apply! fa gs))
                 (fact 'finsum-cm-insert-ptwise 'm sv xv 'f)
                 ;; G and gs are typed on T
                 (for-each
                   (lambda (pr)
                     (let ((gg (car pr)) (uu (cdr pr)))
                       (dk-have! (ibk-ptw 't (lambda (z) (list 'IN (list gg z) '(CARR m))))
                         (lambda ()
                           (let ((zv (dk-di-var!)))
                             (inst+ (ibk-hg-of uu gg) zv)
                             (ibk-fib-typed! uu zv)
                             (subst (list '== (list gg zv) (list 'FINSUM 'm 'f (ibk-fib uu zv))))
                             (ass))))))
                   (list (cons gv u) (cons gs sv)))
                 ;; peel phi(x) off T on both sides
                 (fact 'finsum-cm-remove-ptwise 'm 't pxv gv)
                 (fact 'finsum-cm-remove-ptwise 'm 't pxv gs)
                 (fact 'difference-set 't (list 'PAIR pxv pxv))
                 (ibk-fin-sub! 't tp
                   (lambda (w) (mac-h 'difference-membership (list 'IN w tp)) (dk-split-all!) (ass)))
                 ;; off phi(x), the two fibers agree
                 (dk-have! (ibk-ptw tp (lambda (z) (list '= (list gv z) (list gs z))))
                   (lambda ()
                     (let* ((zv  (dk-di-var!))
                            (fu  (ibk-fib u zv))
                            (fs  (ibk-fib sv zv)))
                       (dk-project! (list 'IN zv 't) 'difference-membership (list 'IN zv tp))
                       (dk-project! (list 'NOT (list 'IN zv (list 'PAIR pxv pxv)))
                                    'difference-membership (list 'IN zv tp))
                       (inst+ (ibk-hg-of u gv) zv)
                       (inst+ (ibk-hg-of sv gs) zv)
                       (ibk-fib-typed! sv zv)
                       (dk-have! (list 'NOT (list '= pxv zv))
                         (lambda ()
                           (di)
                           (fact 'equality-symmetry pxv zv)
                           (dk-have! (list 'AND (list 'IN pxv 'SET) (list 'IN pxv 'SET))
                             (lambda ()
                               (fact 'membership-implies-sethood pxv 't)
                               (ibk-conj-close! dk-ass!)))
                           (let ((pm2 (inst*! (dk-cite! 'pairing-membership pxv pxv) zv)))
                             (ibk-keep-prop! pm2 (list '= zv pxv)
                                       (list 'NOT (list 'IN zv (list 'PAIR pxv pxv)))))))
                       (fact 'sep-fiber-insert-other sv xv 'phi zv)
                       (subst (list '== (list gv zv) (list 'FINSUM 'm 'f fu)))
                       (subst (list '== (list gs zv) (list 'FINSUM 'm 'f fs)))
                       (subst (list '= fu fs))
                       (rfl))))
                 (fact 'finsum-cm-congruence-q 'm tp gv gs)
                 ;; at phi(x): the U-fiber is the S-fiber plus x
                 (inst+ (ibk-hg-of u gv) pxv)
                 (inst+ (ibk-hg-of sv gs) pxv)
                 (ibk-fib-typed! sv pxv)
                 (fact 'membership-implies-sethood pxv 't)
                 (fact 'sep-fiber-insert-same sv xv 'phi)
                 (dk-have! (list 'NOT (list 'IN xv fbs))
                   (lambda ()
                     (di)
                     (sep-me (list 'IN xv fbs))
                     (ibk-keep-prop! (list 'IN xv sv) (list 'NOT (list 'IN xv sv)))))
                 (dk-have! (ibk-ptw fbsx ibk-tf)
                   (lambda ()
                     (subst (list '= fbsx fbu))
                     (let ((w (dk-di-var!)))
                       (sep-me (list 'IN w fbu))
                       (inst+ (ibk-ptw u ibk-tf) w)
                       (ass))))
                 (fact 'finsum-cm-insert-ptwise 'm fbs xv 'f)
                 ;; gs is typed at phi(x), and on the punctured T
                 (inst+ (ibk-ptw 't (lambda (z) (list 'IN (list gs z) '(CARR m)))) pxv)
                 (dk-have! (ibk-ptw tp (lambda (z) (list 'IN (list gs z) '(CARR m))))
                   (lambda ()
                     (let ((w (dk-di-var!)))
                       (mac-h 'difference-membership (list 'IN w tp))
                       (dk-split-all!)
                       (inst+ (ibk-ptw 't (lambda (z) (list 'IN (list gs z) '(CARR m)))) w)
                       (ass))))
                 (fact 'finsum-comm-monoid-type-ptwise 'm tp gs)
                 ;; assemble
                 (subst (list '= (list 'FINSUM 'm 'f u)
                              (list '(OPR m) (list 'FINSUM 'm 'f sv) (list 'f xv))))
                 (subst (list '= (list 'FINSUM 'm 'f sv) (list 'FINSUM 'm gs 't)))
                 (subst (list '= (list 'FINSUM 'm gs 't)
                              (list '(OPR m) (list 'FINSUM 'm gs tp) (list gs pxv))))
                 (subst (list '= (list 'FINSUM 'm gv 't)
                              (list '(OPR m) (list 'FINSUM 'm gv tp) (list gv pxv))))
                 (subst (list '== (list 'FINSUM 'm gv tp) (list 'FINSUM 'm gs tp)))
                 (subst (list '== (list gv pxv) (list 'FINSUM 'm 'f fbu)))
                 (subst (list '= fbu fbsx))
                 (subst (list '= (list 'FINSUM 'm 'f fbsx)
                              (list '(OPR m) (list 'FINSUM 'm 'f fbs) (list 'f xv))))
                 (subst (list '= (list 'FINSUM 'm 'f fbs) (list gs pxv)))
                 (fact 'comm-monoid-assoc 'm (list 'FINSUM 'm gs tp) (list gs pxv) (list 'f xv))
                 (ass))))))
  (ibk-detach-all! px)
  (let ((fa (dk-ctx-form '(FORALL gq_ (IMPLIES (FORALL z_ (IMPLIES (IN z_ t)
                             (== (gq_ z_) (FINSUM m f (SEP fw_ s (= (phi fw_) z_))))))
                          (= (FINSUM m f s) (FINSUM m gq_ t)))))))
    (dk-apply! fa 'gq)
    (ass)))
(qed 'finsum-cm-fiber-ptwise)
(topic! 'finsum-cm-fiber-ptwise 'algebra)


;;; finsum-cm-pad-ptwise: summing over a finite superset T of R adds nothing
;;; when the summand is the identity on T \ R.
(sp (make-wff
     '(FORALL m (IMPLIES (IS-COMM-MONOID m)
        (FORALL T (IMPLIES (IN T SET) (IMPLIES (IN (CARD T) NN)
          (FORALL R (IMPLIES (FORALL z_ (IMPLIES (IN z_ R) (IN z_ T)))
            (FORALL g
              (IMPLIES (FORALL z_ (IMPLIES (IN z_ T) (IN (g z_) (CARR m))))
              (IMPLIES (FORALL z_ (IMPLIES (IN z_ T) (IMPLIES (NOT (IN z_ R)) (= (g z_) (IDEN m)))))
                (= (FINSUM m g T) (FINSUM m g R))))))))))))))
(dk-peel!)
(let* ((d   '(COMPLEMENT-IN t r))
       (rd  (list 'UNION 'r d))
       (inc '(FORALL z_ (IMPLIES (IN z_ r) (IN z_ t))))
       (tg  (lambda (z) (list 'IN (list 'g z) '(CARR m)))))
  (fact 'comm-monoid-identity-in-carr 'm)
  (ibk-fin-sub! 't 'r (lambda (w) (inst+ inc w) (ass)))
  (fact 'complement-in-set-closure 't 'r)
  (ibk-fin-sub! 't d
    (lambda (w) (mac-h 'complement-in-membership (list 'IN w d)) (dk-split-all!) (ass)))
  (dk-have! '(SUBSET r t)
    (lambda () (mac 'subset-def) (let ((w (dk-di-var!))) (inst+ inc w) (ass))))
  (fact 'union-complement-in 'r 't)
  (dk-have! (ibk-ptw d (lambda (z) (list 'NOT (list 'IN z 'r))))
    (lambda ()
      (let ((w (dk-di-var!)))
        (mac-h 'complement-in-membership (list 'IN w d))
        (dk-split-all!)
        (ass))))
  (dk-have! (ibk-ptw rd tg)
    (lambda () (subst (list '= rd 't)) (ass)))
  (fact 'finsum-cm-union-disjoint 'm 'r d 'g)
  (dk-have! (ibk-ptw d (lambda (z) (list '= (list 'g z) '(IDEN m))))
    (lambda ()
      (let ((w (dk-di-var!)))
        (mac-h 'complement-in-membership (list 'IN w d))
        (dk-split-all!)
        (inst+ '(FORALL z_ (IMPLIES (IN z_ t) (IMPLIES (NOT (IN z_ r)) (= (g z_) (IDEN m))))) w)
        (ass))))
  (fact 'finsum-cm-all-iden-ptwise 'm d 'g)
  (dk-have! (ibk-ptw 'r tg)
    (lambda () (let ((w (dk-di-var!))) (inst+ inc w) (inst+ (ibk-ptw 't tg) w) (ass))))
  (fact 'finsum-comm-monoid-type-ptwise 'm 'r 'g)
  (fact 'finsum-comm-monoid-type-ptwise 'm 't 'g)
  (fact 'comm-monoid-is-monoid 'm)
  (fact 'monoid-right-id 'm '(FINSUM m g r))
  (dk-congr! (list '= rd 't) (lambda (x) (list 'FINSUM 'm 'g x)))
  (subst (list '= '(FINSUM m g t) (list 'FINSUM 'm 'g rd)))
  (subst (list '= (list 'FINSUM 'm 'g rd) (list '(OPR m) '(FINSUM m g r) (list 'FINSUM 'm 'g d))))
  (subst (list '= (list 'FINSUM 'm 'g d) '(IDEN m)))
  (ass))
(qed 'finsum-cm-pad-ptwise)
(topic! 'finsum-cm-pad-ptwise 'algebra)

;;; =====================================================================
;;; (C) FINITE SUMS IN [0, +inf]: termwise comparison and a real scalar.
;;; =====================================================================

(define ibk-m 'RR-POS-STAR-ADD-MONOID)
(define (ibk-fs fv u) (list 'FINSUM 'RR-POS-STAR-ADD-MONOID fv u))
(define (ibk-readoff! eqn)
  (dk-have! eqn
    (lambda ()
      (quietly (lambda () (surface-goal! 'RR-POS-STAR-ADD-MONOID)))
      (qrfl))))
(define ibk-opr-eq  '(== (OPR RR-POS-STAR-ADD-MONOID) eplus))
(define ibk-iden-eq '(== (IDEN RR-POS-STAR-ADD-MONOID) 0))
(define ibk-carr-eq '(== (CARR RR-POS-STAR-ADD-MONOID) RR-POS-STAR))
(define (ibk-rps-setup!)
  (fact 'rr-pos-star-is-comm-monoid)
  (ibk-readoff! ibk-opr-eq)
  (ibk-readoff! ibk-iden-eq)
  (ibk-readoff! ibk-carr-eq))
(define (ibk-rps-of fv) (lambda (z) (list 'IN (list fv z) 'RR-POS-STAR)))
(define (ibk-carr-rps-of fv) (lambda (z) (list 'IN (list fv z) '(CARR RR-POS-STAR-ADD-MONOID))))

;;; the CARR-typing of fv on u, from its RR-POS-STAR typing in context
(define (ibk-carr-typing! u fv)
  (dk-have! (ibk-ptw u (ibk-carr-rps-of fv))
    (lambda () (subst ibk-carr-eq) (ass))))

;;; (IN (FINSUM M fv u) RR-POS-STAR); u finite, fv RR-POS-STAR-typed on u
(define (ibk-rps-typed! u fv)
  (let ((sm (ibk-fs fv u)))
    (if (not (dk-asm? (list 'IN sm 'RR-POS-STAR)))
        (begin
          (ibk-carr-typing! u fv)
          (fact 'finsum-comm-monoid-type-ptwise ibk-m u fv)
          (dk-have! (list 'IN sm 'RR-POS-STAR)
            (lambda () (subst (list '= 'RR-POS-STAR '(CARR RR-POS-STAR-ADD-MONOID))) (ass)))))))

;;; (= (FINSUM M fv U) (eplus (FINSUM M fv S) (fv x))), U = S u {x}
(define (ibk-rps-insert! sv xv u fv)
  (let ((claim (list '= (ibk-fs fv u) (list 'eplus (ibk-fs fv sv) (list fv xv)))))
    (ibk-carr-typing! u fv)
    (fact 'finsum-cm-insert-ptwise ibk-m sv xv fv)
    (ibk-rps-typed! sv fv)
    (if (not (dk-asm? (list 'IN (list fv xv) 'RR-POS-STAR)))
        (inst+ (ibk-ptw u (ibk-rps-of fv)) xv))
    (dk-have! (list 'AND (list 'IN (ibk-fs fv sv) 'RR-POS-STAR) (list 'IN (list fv xv) 'RR-POS-STAR)))
    (fact 'eplus-closed (ibk-fs fv sv) (list fv xv))
    (dk-have! claim
      (lambda ()
        (subst (list '= (ibk-fs fv u)
                     (list '(OPR RR-POS-STAR-ADD-MONOID) (ibk-fs fv sv) (list fv xv))))
        (subst ibk-opr-eq)
        (rfl)))
    claim))

;;; (= (FINSUM M fv EMPTY-SET) 0)
(define (ibk-rps-empty! fv)
  (let ((claim (list '= (ibk-fs fv 'EMPTY-SET) 0)))
    (fact 'finsum-empty ibk-m fv)
    (dk-have! claim
      (lambda ()
        (subst (list '== (ibk-fs fv 'EMPTY-SET) '(IDEN RR-POS-STAR-ADD-MONOID)))
        (subst ibk-iden-eq)
        (rfl)))
    claim))

;;; rps-finsum-le-ptwise: termwise comparison of finite sums in [0, +inf].
(sp (make-wff
     '(FORALL S (IMPLIES (IN S SET) (IMPLIES (IN (CARD S) NN)
        (FORALL f (FORALL g
          (IMPLIES (FORALL z_ (IMPLIES (IN z_ S) (IN (f z_) RR-POS-STAR)))
          (IMPLIES (FORALL z_ (IMPLIES (IN z_ S) (IN (g z_) RR-POS-STAR)))
          (IMPLIES (FORALL z_ (IMPLIES (IN z_ S) (<= (f z_) (g z_))))
            (<= (FINSUM RR-POS-STAR-ADD-MONOID f S) (FINSUM RR-POS-STAR-ADD-MONOID g S))))))))))))
(dk-peel!)
(ibk-rps-setup!)
(let* ((le (lambda (z) (list '<= (list 'f z) (list 'g z))))
       (prop-of (lambda (u)
                  (list 'IMPLIES (ibk-ptw u (ibk-rps-of 'f))
                    (list 'IMPLIES (ibk-ptw u (ibk-rps-of 'g))
                      (list 'IMPLIES (ibk-ptw u le)
                        (list '<= (ibk-fs 'f u) (ibk-fs 'g u)))))))
       (px (ibk-induct! 's prop-of
             (lambda ()
               (dk-peel!)
               (ibk-rps-empty! 'f)
               (ibk-rps-empty! 'g)
               (subst (list '= (ibk-fs 'f 'EMPTY-SET) 0))
               (subst (list '= (ibk-fs 'g 'EMPTY-SET) 0))
               (fact 'zero-in-rr-pos-star)
               (fact 'rr-pos-star-le-refl 0)
               (ass))
             (lambda (sv xv u ih)
               (dk-peel!)
               (for-each (lambda (b) (ibk-restrict! (ibk-ptw u b) sv u b))
                         (list (ibk-rps-of 'f) (ibk-rps-of 'g) le))
               (ibk-detach-all! ih)
               (ibk-in-union-new! xv u)
               (for-each (lambda (b) (inst+ (ibk-ptw u b) xv))
                         (list (ibk-rps-of 'f) (ibk-rps-of 'g) le))
               (ibk-rps-insert! sv xv u 'f)
               (ibk-rps-insert! sv xv u 'g)
               (subst (list '= (ibk-fs 'f u) (list 'eplus (ibk-fs 'f sv) (list 'f xv))))
               (subst (list '= (ibk-fs 'g u) (list 'eplus (ibk-fs 'g sv) (list 'g xv))))
               (dk-have! (list 'AND (list 'IN (ibk-fs 'f sv) 'RR-POS-STAR)
                               (list 'AND (list 'IN (list 'f xv) 'RR-POS-STAR)
                                     (list 'AND (list 'IN (ibk-fs 'g sv) 'RR-POS-STAR)
                                           (list 'IN (list 'g xv) 'RR-POS-STAR)))))
               (dk-have! (list 'AND (list '<= (ibk-fs 'f sv) (ibk-fs 'g sv))
                               (list '<= (list 'f xv) (list 'g xv))))
               (fact 'eplus-mono (ibk-fs 'f sv) (list 'f xv) (ibk-fs 'g sv) (list 'g xv))
               (ass)))))
  (ibk-detach-all! px)
  (ass))
(qed 'rps-finsum-le-ptwise)
(topic! 'rps-finsum-le-ptwise 'inequalities)

;;; rps-finsum-scale-ptwise: a real scalar c >= 0 comes out of a finite sum.
(sp (make-wff
     '(FORALL c (IMPLIES (IN c RR) (IMPLIES (<= 0 c)
        (FORALL S (IMPLIES (IN S SET) (IMPLIES (IN (CARD S) NN)
          (FORALL f (FORALL h
            (IMPLIES (FORALL z_ (IMPLIES (IN z_ S) (IN (f z_) RR-POS-STAR)))
            (IMPLIES (FORALL z_ (IMPLIES (IN z_ S) (= (h z_) (etimes c (f z_)))))
              (= (FINSUM RR-POS-STAR-ADD-MONOID h S)
                 (etimes c (FINSUM RR-POS-STAR-ADD-MONOID f S)))))))))))))))
(dk-peel!)
(ibk-rps-setup!)
(ibk-rps! 'c)
(let* ((eh (lambda (z) (list '= (list 'h z) (list 'etimes 'c (list 'f z)))))
       (prop-of (lambda (u)
                  (list 'IMPLIES (ibk-ptw u (ibk-rps-of 'f))
                    (list 'IMPLIES (ibk-ptw u eh)
                      (list '= (ibk-fs 'h u) (list 'etimes 'c (ibk-fs 'f u)))))))
       (px (ibk-induct! 's prop-of
             (lambda ()
               (dk-peel!)
               (ibk-rps-empty! 'f)
               (ibk-rps-empty! 'h)
               (subst (list '= (ibk-fs 'f 'EMPTY-SET) 0))
               (subst (list '= (ibk-fs 'h 'EMPTY-SET) 0))
               (fact 'etimes-zero-right 'c)
               (subst '(= (etimes c 0) 0))
               (rfl))
             (lambda (sv xv u ih)
               (dk-peel!)
               (for-each (lambda (b) (ibk-restrict! (ibk-ptw u b) sv u b))
                         (list (ibk-rps-of 'f) eh))
               (ibk-detach-all! ih)
               (ibk-in-union-new! xv u)
               (inst+ (ibk-ptw u (ibk-rps-of 'f)) xv)
               (inst+ (ibk-ptw u eh) xv)
               (dk-have! (ibk-ptw u (ibk-rps-of 'h))
                 (lambda ()
                   (let ((w (dk-di-var!)))
                     (inst+ (ibk-ptw u eh) w)
                     (inst+ (ibk-ptw u (ibk-rps-of 'f)) w)
                     (subst (eh w))
                     (dk-have! (list 'AND '(IN c RR-POS-STAR) (list 'IN (list 'f w) 'RR-POS-STAR)))
                     (fact 'etimes-closed 'c (list 'f w))
                     (ass))))
               (ibk-restrict! (ibk-ptw u (ibk-rps-of 'h)) sv u (ibk-rps-of 'h))
               (ibk-rps-insert! sv xv u 'f)
               (ibk-rps-insert! sv xv u 'h)
               (subst (list '= (ibk-fs 'h u) (list 'eplus (ibk-fs 'h sv) (list 'h xv))))
               (subst (list '= (ibk-fs 'f u) (list 'eplus (ibk-fs 'f sv) (list 'f xv))))
               (subst (list '= (ibk-fs 'h sv) (list 'etimes 'c (ibk-fs 'f sv))))
               (subst (eh xv))
               (dk-have! (list 'AND (list 'IN (ibk-fs 'f sv) 'RR-POS-STAR)
                               (list 'IN (list 'f xv) 'RR-POS-STAR)))
               (fact 'etimes-distrib-left 'c (ibk-fs 'f sv) (list 'f xv))
               (subst (list '= (list 'etimes 'c (list 'eplus (ibk-fs 'f sv) (list 'f xv)))
                            (list 'eplus (list 'etimes 'c (ibk-fs 'f sv))
                                  (list 'etimes 'c (list 'f xv)))))
               (dk-have! (list 'AND '(IN c RR-POS-STAR) (list 'IN (ibk-fs 'f sv) 'RR-POS-STAR)))
               (fact 'etimes-closed 'c (ibk-fs 'f sv))
               (dk-have! (list 'AND '(IN c RR-POS-STAR) (list 'IN (list 'f xv) 'RR-POS-STAR)))
               (fact 'etimes-closed 'c (list 'f xv))
               (dk-have! (list 'AND (list 'IN (list 'etimes 'c (ibk-fs 'f sv)) 'RR-POS-STAR)
                               (list 'IN (list 'etimes 'c (list 'f xv)) 'RR-POS-STAR)))
               (fact 'eplus-closed (list 'etimes 'c (ibk-fs 'f sv)) (list 'etimes 'c (list 'f xv)))
               (rfl)))))
  (ibk-detach-all! px)
  (ass))
(qed 'rps-finsum-scale-ptwise)
(topic! 'rps-finsum-scale-ptwise 'analysis)


;;; =====================================================================
;;; (D) A MEASURE ON A FINITE PARTITION.  For k : omega -> anything and a
;;;     finite K, the preimage k^-1(K) = { x in omega : k(x) in K } is the
;;;     disjoint union of the fibers F_p = { x in omega : k(x) = p }, p in K:
;;;       sigma-algebra-preimage-finite-in   k^-1(K) is measurable
;;;       measure-preimage-finite-sum        mu(k^-1(K)) = SUM_{p in K} mu(F_p)
;;; Induction on K; no BIG-UNION is formed.
;;; =====================================================================

(define (ibk-pre u) (list 'SEP 'fx_ 'omega (list 'IN '(k fx_) u)))
(define (ibk-fbr z) (list 'SEP 'fx_ 'omega (list '= '(k fx_) z)))
(define (ibk-fbr-in z) (list 'IN (ibk-fbr z) 'cA))

;;; the four conjuncts of IS-MEASURE(om, ca, mu), landed, the hypothesis kept
(define (ibk-measure-parts! om ca mu)
  (let* ((iff (dk-cite! 'is-measure om ca mu))
         (rhs (caddr iff))
         (c1 (cadr rhs)) (c2 (cadr (caddr rhs)))
         (c3 (cadr (caddr (caddr rhs)))) (c4 (caddr (caddr (caddr rhs)))))
    (map (lambda (c) (dk-project! c 'IS-MEASURE (list 'IS-MEASURE om ca mu)))
         (list c1 c2 c3 c4))))

;;; Closer for a membership in U = S u {x}: from (IN t S) or (= t x) in context.
(define (ibk-u-closer sv xv u)
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (ass))
            ((and (pair? g) (eq? (car g) 'in) (equal? (caddr g) u))
             (let ((t (cadr g)))
               (cond ((dk-asm? (list 'IN t sv)) (ibk-in-union-left! t sv u))
                     ((dk-asm? (list '= t xv))
                      (subst (list '= t xv))
                      (if (dk-asm? (dk-goal)) (ass) (ibk-in-union-new! xv u)))
                     (#t (error "ibk-u-closer: no route to" g)))))
            (#t (rfl))))))

;;; (= pre(EMPTY-SET) EMPTY-SET)
(define (ibk-pre-empty!)
  (let ((a (ibk-pre 'EMPTY-SET)))
    (ibk-set-eq! a 'EMPTY-SET
      (lambda (w)
        (sep-me (list 'IN w a))
        (let ((kw (list 'k w)))
          (fact 'empty-set-has-no-members kw)
          (ibk-keep-prop! (list 'IN kw 'EMPTY-SET) (list 'NOT (list 'IN kw 'EMPTY-SET)))))
      (lambda (w)
        (fact 'empty-set-has-no-members w)
        (ibk-keep-prop! (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET)))))))

;;; (= pre(U) (UNION pre(S) F_x)), U = S u {x}, (IN x SET) in context
(define (ibk-pre-insert! sv xv u)
  (let* ((a  (ibk-pre u))
         (ps (ibk-pre sv))
         (fx (ibk-fbr xv))
         (b  (list 'UNION ps fx)))
    (ibk-set-eq! a b
      (lambda (w)
        (sep-me (list 'IN w a))
        (mac 'union-membership)
        (let ((cs (dk-landed-1 (lambda () (mac-h 'union-membership (list 'IN (list 'k w) u))))))
          (use-cases cs
            (lambda () (oi-l) (ibk-sep-in! (lambda () (ass))))
            (lambda ()
              (oi-r)
              (ibk-single-eq! (list 'k w) xv)
              (ibk-sep-in! (lambda () (ass)))))))
      (lambda (w)
        (let ((cs (dk-landed-1 (lambda () (mac-h 'union-membership (list 'IN w b))))))
          (use-cases cs
            (lambda ()
              (sep-me (list 'IN w ps))
              (ibk-sep-in! (ibk-u-closer sv xv u)))
            (lambda ()
              (sep-me (list 'IN w fx))
              (ibk-sep-in! (ibk-u-closer sv xv u)))))))))

;;; sigma-algebra-preimage-finite-in
(sp (make-wff
     '(FORALL omega (FORALL cA (IMPLIES (IS-SIGMA-ALGEBRA omega cA)
        (FORALL KS (IMPLIES (IN KS SET) (IMPLIES (IN (CARD KS) NN)
          (FORALL k
            (IMPLIES (FORALL z_ (IMPLIES (IN z_ KS) (IN (SEP fx_ omega (= (k fx_) z_)) cA)))
              (IN (SEP fx_ omega (IN (k fx_) KS)) cA)))))))))))
(dk-peel!)
(let* ((prop-of (lambda (u) (list 'IMPLIES (ibk-ptw u ibk-fbr-in) (list 'IN (ibk-pre u) 'cA))))
       (px (ibk-induct! 'ks prop-of
             (lambda ()
               (di)
               (ibk-pre-empty!)
               (subst (list '= (ibk-pre 'EMPTY-SET) 'EMPTY-SET))
               (fact 'sigma-algebra-empty-in 'omega 'cA)
               (ass))
             (lambda (sv xv u ih)
               (di)
               (ibk-restrict! (ibk-ptw u ibk-fbr-in) sv u ibk-fbr-in)
               (ibk-detach-all! ih)
               (ibk-in-union-new! xv u)
               (inst+ (ibk-ptw u ibk-fbr-in) xv)
               (ibk-pre-insert! sv xv u)
               (subst (list '= (ibk-pre u) (list 'UNION (ibk-pre sv) (ibk-fbr xv))))
               (fact 'sigma-algebra-union-closed-2 'omega 'cA (ibk-pre sv) (ibk-fbr xv))
               (ass)))))
  (ibk-detach-all! px)
  (ass))
(qed 'sigma-algebra-preimage-finite-in)
(topic! 'sigma-algebra-preimage-finite-in 'analysis)

;;; measure-preimage-finite-sum
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (IMPLIES (IS-MEASURE omega cA mu)
        (FORALL KS (IMPLIES (IN KS SET) (IMPLIES (IN (CARD KS) NN)
          (FORALL k
            (IMPLIES (FORALL z_ (IMPLIES (IN z_ KS) (IN (SEP fx_ omega (= (k fx_) z_)) cA)))
              (FORALL G
                (IMPLIES (FORALL z_ (IMPLIES (IN z_ KS) (= (G z_) (mu (SEP fx_ omega (= (k fx_) z_))))))
                  (= (mu (SEP fx_ omega (IN (k fx_) KS)))
                     (FINSUM RR-POS-STAR-ADD-MONOID G KS)))))))))))))))
(dk-peel!)
(ibk-rps-setup!)
(ibk-measure-parts! 'omega 'cA 'mu)
(let* ((eg (lambda (z) (list '= (list 'g z) (list 'mu (ibk-fbr z)))))
       (prop-of (lambda (u)
                  (list 'IMPLIES (ibk-ptw u ibk-fbr-in)
                    (list 'IMPLIES (ibk-ptw u eg)
                      (list '= (list 'mu (ibk-pre u)) (ibk-fs 'g u))))))
       (px (ibk-induct! 'ks prop-of
             (lambda ()
               (dk-peel!)
               (ibk-pre-empty!)
               (subst (list '= (ibk-pre 'EMPTY-SET) 'EMPTY-SET))
               (ibk-rps-empty! 'g)
               (subst (list '= (ibk-fs 'g 'EMPTY-SET) 0))
               (subst '(= (mu EMPTY-SET) 0))
               (rfl))
             (lambda (sv xv u ih)
               (dk-peel!)
               (ibk-restrict! (ibk-ptw u ibk-fbr-in) sv u ibk-fbr-in)
               (ibk-restrict! (ibk-ptw u eg) sv u eg)
               (ibk-detach-all! ih)
               (ibk-in-union-new! xv u)
               (inst+ (ibk-ptw u ibk-fbr-in) xv)
               (inst+ (ibk-ptw u eg) xv)
               ;; g is RR-POS-STAR-typed on U
               (dk-have! (ibk-ptw u (ibk-rps-of 'g))
                 (lambda ()
                   (let ((w (dk-di-var!)))
                     (inst+ (ibk-ptw u eg) w)
                     (inst+ (ibk-ptw u ibk-fbr-in) w)
                     (subst (eg w))
                     (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (ibk-fbr w))
                     (ass))))
               (ibk-restrict! (ibk-ptw u (ibk-rps-of 'g)) sv u (ibk-rps-of 'g))
               (ibk-rps-insert! sv xv u 'g)
               ;; pre(U) = pre(S) u F_x, a disjoint union of measurable sets
               (ibk-pre-insert! sv xv u)
               (fact 'sigma-algebra-preimage-finite-in 'omega 'cA sv 'k)
               (let ((ix (list 'INTERSECTION (ibk-pre sv) (ibk-fbr xv))))
                 (ibk-set-eq! ix 'EMPTY-SET
                   (lambda (w)
                     (mac-h 'intersection-membership (list 'IN w ix))
                     (dk-split-all!)
                     (sep-me (list 'IN w (ibk-pre sv)))
                     (sep-me (list 'IN w (ibk-fbr xv)))
                     (dk-have! (list 'IN xv sv)
                       (lambda () (subst (list '= xv (list 'k w))) (ass)))
                     (ibk-keep-prop! (list 'IN xv sv) (list 'NOT (list 'IN xv sv))))
                   (lambda (w)
                     (fact 'empty-set-has-no-members w)
                     (ibk-keep-prop! (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET))))))
               (fact 'measure-finitely-additive 'omega 'cA 'mu (ibk-pre sv) (ibk-fbr xv))
               (subst (list '= (ibk-pre u) (list 'UNION (ibk-pre sv) (ibk-fbr xv))))
               (subst (list '= (list 'mu (list 'UNION (ibk-pre sv) (ibk-fbr xv)))
                            (list 'eplus (list 'mu (ibk-pre sv)) (list 'mu (ibk-fbr xv)))))
               (subst (list '= (ibk-fs 'g u) (list 'eplus (ibk-fs 'g sv) (list 'g xv))))
               (subst (list '= (list 'mu (ibk-pre sv)) (ibk-fs 'g sv)))
               (subst (eg xv))
               (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (ibk-fbr xv))
               (ibk-rps-typed! sv 'g)
               (dk-have! (list 'AND (list 'IN (ibk-fs 'g sv) 'RR-POS-STAR)
                               (list 'IN (list 'mu (ibk-fbr xv)) 'RR-POS-STAR)))
               (fact 'eplus-closed (ibk-fs 'g sv) (list 'mu (ibk-fbr xv)))
               (rfl)))))
  (ibk-detach-all! px)
  (ass))
(qed 'measure-preimage-finite-sum)
(topic! 'measure-preimage-finite-sum 'analysis)


;;; =====================================================================
;;; (E) LEVEL SETS OF A MEASURABLE FUNCTION.  IS-MEASURABLE-FN is the tail
;;;     criterion { alpha < f } (integral.scm's header says why); the closed
;;;     tails and the level sets follow, by the archimedean property:
;;;       measurable-fn-ge          { a <= f } = omega \ U_n (omega \ { a - 1/(n+1) < f })
;;;       measurable-fn-level-set   { f = a } = { a <= f } \ { a < f }
;;; =====================================================================

;;; the three conjuncts of IS-MEASURABLE-FN(om, ca, fv), landed, kept
(define (ibk-mfn-parts! om ca fv)
  (let* ((iff (dk-cite! 'is-measurable-fn om ca fv))
         (rhs (caddr iff))
         (c1 (cadr rhs)) (c2 (cadr (caddr rhs))) (c3 (caddr (caddr rhs))))
    (map (lambda (c) (dk-project! c 'IS-MEASURABLE-FN (list 'IS-MEASURABLE-FN om ca fv)))
         (list c1 c2 c3))))

(define (ibk-alpha n) (list '- 'a (list 'recip (list '+ n 1))))
(define (ibk-tail al) (list 'SEP 'gx_ 'omega (list '< al '(f gx_))))
(define (ibk-gbody n) (list 'COMPLEMENT-IN 'omega (ibk-tail (ibk-alpha n))))

;;; n in NN in context: land (IN (recip (+ n 1)) RR), (< 0 (recip (+ n 1))),
;;; (IN (ibk-alpha n) RR).
(define (ibk-alpha-facts! n)
  (let* ((n1 (list '+ n 1)) (r (list 'recip n1)))
    (if (not (dk-asm? (list 'IN (ibk-alpha n) 'RR)))
        (begin
          (fact 'nn-in-rr n)
          (fact 'nn-zero-le n)
          (dk-have! '(IN 1 RR) (lambda () (fact 'rr-one-in) (ass)))
          (dk-have! (list 'AND (list 'IN n 'RR) '(IN 1 RR)))
          (fact 'rr-add-closed n 1)
          (dk-have! (list '< 0 n1)
            (lambda () (dk-ineq! (list 'IN n 'RR) (list '<= 0 n))))
          (ibk-nz-of-pos! n1)
          (dk-have! (list 'AND (list 'IN n1 'RR) (list 'NOT (list '= n1 0))))
          (fact 'rr-recip-closed n1)
          (fact 'rr-recip-pos n1)
          (fact 'rr-sub-in-rr 'a r)))))

;;; (IN a RR-STAR) from (IN a RR)
(define (ibk-rr-star! t)
  (dk-have! (list 'IN t 'RR-STAR)
    (lambda ()
      (let ((iff (dk-cite! 'rr-star-membership t)))
        (ibk-keep-prop! iff (list 'IN t 'RR))))))

;;; dk-abstract! (driver-kit.scm) with a hook PRE-BETA! run on the value lane
;;; before the beta step, with the index eigenvariable: a VNB-LAMBDA's values
;;; must be SETS, and beta owes (IN body SET), which the kit's lane cannot see.
(define (ibk-abstract! dom cod body-of typer pre-beta!)
  (let* ((body  (body-of 'dkak_))
         (lam   (list 'VNB-LAMBDA 'dkak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'dkak_ (list 'IMPLIES (list 'IN 'dkak_ dom)
                                                    (list '== (list g 'dkak_) body)))))
         (claim (list 'FORSOME 'dkag_ (list 'AND (list 'IN 'dkag_ (list 'FUN dom cod))
                                            (vals 'dkag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (ibk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                ;; the sethood leaf: from context when it is there --
                ;; dk-set-close! on a CARTESIAN recurses and fires a bare
                ;; `ass' at each level, which then lands on another leaf
                (dk-lam-type! (lambda () (typer (dk-di-var!)))
                              (lambda ()
                                (if (dk-asm? (dk-goal))
                                    (ass)
                                    (dk-set-close! (cadr (dk-goal))))))
                (let ((k (dk-di-var!)))
                  (pre-beta! k)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "ibk-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "ibk-abstract!: the value equation did not land"
                          (expression->string (vals g))))))
      (cons g ve))))

;;; measurable-fn-ge
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL f
        (IMPLIES (IS-MEASURABLE-FN omega cA f)
          (FORALL a (IMPLIES (IN a RR)
            (IN (SEP gx_ omega (<= a (f gx_))) cA)))))))))
(dk-peel!)
(let* ((parts (ibk-mfn-parts! 'omega 'cA 'f))
       (tails (caddr parts))
       (ge    '(SEP gx_ omega (<= a (f gx_))))
       (sa    (fact 'sigma-algebra-ambient-set 'omega 'cA))
       (gve   (ibk-abstract! 'NN 'cA ibk-gbody
                (lambda (n)
                  (ibk-alpha-facts! n)
                  (dk-apply! tails (ibk-alpha n))
                  (fact 'sigma-algebra-complement-closed 'omega 'cA (ibk-tail (ibk-alpha n)))
                  (ass))
                (lambda (n)
                  (fact 'complement-in-set-closure 'omega (ibk-tail (ibk-alpha n))))))
       (gv    (car gve))
       (ve    (cdr gve))
       (bu    (list 'BIG-UNION 'n_ 'NN (list gv 'n_)))
       (cc    (list 'COMPLEMENT-IN 'omega bu)))
  (fact 'sigma-algebra-union-closed 'omega 'cA gv)
  (fact 'sigma-algebra-complement-closed 'omega 'cA bu)
  (ibk-set-eq! cc ge
    ;; w in cc  =>  a <= f(w)
    (lambda (w)
      (let ((fw (list 'f w)))
        (mac-h 'complement-in-membership (list 'IN w cc))
        (dk-split-all!)
        (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR w)
        (ibk-sep-in!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (ibk-star-cases! fw
                  (lambda ()
                    (dk-have! (list 'AND '(IN a RR) (list 'IN fw 'RR)))
                    (let ((tot (dk-cite! 'rr-leq-total 'a fw)))
                      (use-cases tot
                        (lambda () (ass))
                        (lambda ()
                          (use-em (list '< fw 'a)
                            (lambda ()
                              (let* ((eps (list '- 'a fw)))
                                (fact 'rr-sub-in-rr 'a fw)
                                (dk-have! (list '< 0 eps)
                                  (lambda () (dk-ineq! '(IN a RR) (list 'IN fw 'RR) (list '< fw 'a))))
                                (let ((iff (dk-cite! '< 0 eps)))
                                  (dk-have! (list 'AND (list 'IN eps 'RR)
                                                  (list 'AND (list '<= 0 eps) (list 'NOT (list '= 0 eps))))
                                    (lambda ()
                                      (ibk-keep-prop! iff (list '< 0 eps) (list 'IN eps 'RR)))))
                                (let ((iff2 (dk-cite! 'pos-rr eps)))
                                  (dk-have! (list 'POS-RR eps)
                                    (lambda ()
                                      (ibk-keep-prop! iff2 (list 'AND (list 'IN eps 'RR)
                                                           (list 'AND (list '<= 0 eps)
                                                                 (list 'NOT (list '= 0 eps))))))))
                                (let* ((ex (dk-cite! 'nn-recip-succ-small eps))
                                       (nv (dk-skolem! ex))
                                       (r  (list 'recip (list '+ nv 1)))
                                       (al (ibk-alpha nv)))
                                  (ibk-alpha-facts! nv)
                                  (dk-have! (list 'NOT (list '< al fw))
                                    (lambda ()
                                      (di)
                                      (dk-absurd! '(IN a RR) (list 'IN fw 'RR) (list 'IN r 'RR)
                                                  (list '< al fw) (list '< r eps))))
                                  (dk-apply! ve nv)
                                  (dk-have! (list 'IN w (list gv nv))
                                    (lambda ()
                                      (subst (list '== (list gv nv) (ibk-gbody nv)))
                                      (mac 'complement-in-membership)
                                      (ibk-conj-close!
                                        (lambda ()
                                          (if (dk-asm? (dk-goal))
                                              (ass)
                                              (begin
                                                (di)
                                                (sep-me (list 'IN w (ibk-tail al)))
                                                (ibk-keep-prop! (list '< al fw) (list 'NOT (list '< al fw)))))))))
                                  (dk-have! (list 'IN w bu)
                                    (lambda ()
                                      (for-each (lambda (l)
                                                  (if (not (sequent-node-grounded? l))
                                                      (begin (dk-focus! l) (ass))))
                                                (dk-opened (lambda () (bu-mi nv))))))
                                  (ibk-keep-prop! (list 'IN w bu) (list 'NOT (list 'IN w bu))))))
                            (lambda ()
                              (let ((iff (dk-cite! '< fw 'a)))
                                (dk-have! (list '= fw 'a)
                                  (lambda ()
                                    (ibk-keep-prop! iff (list 'NOT (list '< fw 'a)) (list '<= fw 'a)))))
                              (subst (list '= fw 'a))
                              (dk-ineq! '(IN a RR))))))))
                  (lambda ()
                    (subst (list '= fw 'POS-INF))
                    (ibk-rr-star! 'a)
                    (fact 'pos-inf-upper-bound 'a)
                    (ass))))))))
    ;; a <= f(w)  =>  w in cc
    (lambda (w)
      (let ((fw (list 'f w)))
        (sep-me (list 'IN w ge))
        (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR w)
        (mac 'complement-in-membership)
        (ibk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (begin
                  (di)
                  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
                         (nin (car (filter (lambda (f) (equal? (caddr f) 'nn)) landed)))
                         (nv  (cadr nin))
                         (al  (ibk-alpha nv))
                         (tl  (ibk-tail al)))
                    (ibk-alpha-facts! nv)
                    (dk-apply! ve nv)
                    (dk-have! (list 'IN w (ibk-gbody nv))
                      (lambda () (subst (list '= (ibk-gbody nv) (list gv nv))) (ass)))
                    (mac-h 'complement-in-membership (list 'IN w (ibk-gbody nv)))
                    (dk-split-all!)
                    (dk-have! (list 'IN w tl)
                      (lambda ()
                        (ibk-sep-in!
                          (lambda ()
                            (if (dk-asm? (dk-goal))
                                (ass)
                                (ibk-star-cases! fw
                                  (lambda ()
                                    (dk-ineq! '(IN a RR) (list 'IN fw 'RR)
                                              (list 'IN (list 'recip (list '+ nv 1)) 'RR)
                                              (list '< 0 (list 'recip (list '+ nv 1)))
                                              (list '<= 'a fw)))
                                  (lambda ()
                                    (subst (list '= fw 'POS-INF))
                                    (mac '<)
                                    (ibk-conj-close!
                                      (lambda ()
                                        (if (dk-head-is? (dk-goal) '<=)
                                            (begin (ibk-rr-star! al)
                                                   (fact 'pos-inf-upper-bound al)
                                                   (ass))
                                            (begin
                                              (di)
                                              (dk-have! '(IN POS-INF RR)
                                                (lambda () (subst (list '= 'POS-INF al)) (ass)))
                                              (fact 'pos-inf-not-in-rr)
                                              (ibk-keep-prop! '(IN POS-INF RR) '(NOT (IN POS-INF RR))))))))))))))
                    (ibk-keep-prop! (list 'IN w tl) (list 'NOT (list 'IN w tl)))))))))))
  (subst (list '= ge cc))
  (ass))
(qed 'measurable-fn-ge)
(topic! 'measurable-fn-ge 'analysis)

;;; measurable-fn-level-set
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL f
        (IMPLIES (IS-MEASURABLE-FN omega cA f)
          (FORALL a (IMPLIES (IN a RR)
            (IN (SEP gx_ omega (= (f gx_) a)) cA)))))))))
(dk-peel!)
(let* ((parts (ibk-mfn-parts! 'omega 'cA 'f))
       (tails (caddr parts))
       (ge    '(SEP gx_ omega (<= a (f gx_))))
       (tl    (ibk-tail 'a))
       (d     (list 'COMPLEMENT-IN ge tl))
       (lv    '(SEP gx_ omega (= (f gx_) a))))
  (fact 'measurable-fn-ge 'omega 'cA 'f 'a)
  (dk-apply! tails 'a)
  (fact 'sigma-algebra-difference-closed 'omega 'cA ge tl)
  (ibk-set-eq! lv d
    (lambda (w)
      (let ((fw (list 'f w)))
        (sep-me (list 'IN w lv))
        (fact 'equality-symmetry fw 'a)
        (mac 'complement-in-membership)
        (ibk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'NOT)
                (begin
                  (di)
                  (sep-me (list 'IN w tl))
                  (let ((iff (dk-cite! '< 'a fw)))
                    (ibk-keep-prop! iff (list '< 'a fw) (list '= 'a fw))))
                (ibk-sep-in!
                  (lambda ()
                    (if (dk-asm? (dk-goal))
                        (ass)
                        (begin (subst (list '= fw 'a)) (dk-ineq! '(IN a RR)))))))))))
    (lambda (w)
      (let ((fw (list 'f w)))
        (mac-h 'complement-in-membership (list 'IN w d))
        (dk-split-all!)
        (sep-me (list 'IN w ge))
        (dk-have! (list 'NOT (list '< 'a fw))
          (lambda ()
            (di)
            (dk-have! (list 'IN w tl) (lambda () (ibk-sep-in! (lambda () (ass)))))
            (ibk-keep-prop! (list 'IN w tl) (list 'NOT (list 'IN w tl)))))
        (let ((iff (dk-cite! '< 'a fw)))
          (dk-have! (list '= 'a fw)
            (lambda ()
              (ibk-keep-prop! iff (list 'NOT (list '< 'a fw)) (list '<= 'a fw)))))
        (fact 'equality-symmetry 'a fw)
        (ibk-sep-in! (lambda () (ass))))))
  (subst (list '= lv d))
  (ass))
(qed 'measurable-fn-level-set)
(topic! 'measurable-fn-level-set 'analysis)


;;; =====================================================================
;;; (F) THE INTEGRAL.  File-local kit, part 2.  Prefix igl-.
;;; =====================================================================

;;; dk-only! then prop, on the leaf that was the focus (see integral-bricks.scm)
(define (igl-conj-close! . opt) (apply ibk-conj-close! opt))

(define (igl-keep-prop! . keepers)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! keepers)
    (if (not (sequent-node-grounded? leaf)) (prop))))

;;; the conjuncts of IS-MEASURE / IS-MEASURABLE-FN / IS-SIMPLE-FN, landed, kept
(define (igl-parts! pred args)
  (let* ((iff (apply dk-cite! (cons pred args)))
         (rhs (caddr iff))
         (cs  (let loop ((r rhs) (acc '()))
                (if (and (pair? r) (eq? (car r) 'and))
                    (loop (caddr r) (cons (cadr r) acc))
                    (reverse (cons r acc))))))
    (map (lambda (c) (dk-project! c pred (cons pred args))) cs)))
(define (igl-measure-parts! om ca mu) (igl-parts! 'IS-MEASURE (list om ca mu)))
(define (igl-mfn-parts! om ca fv) (igl-parts! 'IS-MEASURABLE-FN (list om ca fv)))
(define (igl-simple-parts! om ca fv) (igl-parts! 'IS-SIMPLE-FN (list om ca fv)))

;;; (SUBSET (SEP v RR-POS-STAR p) RR-POS-STAR)
(define (igl-sep-subset! x)
  (dk-have! (list 'SUBSET x 'RR-POS-STAR)
    (lambda ()
      (mac 'subset-def)
      (let ((w (dk-di-var!)))
        (sep-me (list 'IN w x))
        (ass)))))

;;; =====================================================================
;;; (F1) THE UNFOLD EQUATIONS (def-functoid installs only a macete).
;;; =====================================================================

(sp (make-wff
     '(FORALL omega (FORALL mu (FORALL s
        (== (SIMPLE-INTEGRAL omega mu s)
            (FINSUM RR-POS-STAR-ADD-MONOID
              (VNB-LAMBDA siy_ (IMAGE s omega)
                (etimes siy_ (mu (SEP six_ omega (= (s six_) siy_)))))
              (IMAGE s omega))))))))
(di)
(mac 'SIMPLE-INTEGRAL)
(qrfl)
(qed 'simple-integral-unfold)
(topic! 'simple-integral-unfold 'analysis)

(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL f
        (== (INTEGRAL omega cA mu f)
            (ESUP (SEP iny_ RR-POS-STAR
                    (FORSOME ins_
                      (AND (IS-SIMPLE-FN omega cA ins_)
                           (AND (PTWISE-LE omega ins_ f)
                                (= iny_ (SIMPLE-INTEGRAL omega mu ins_))))))))))))))
(di)
(mac 'INTEGRAL)
(qrfl)
(qed 'integral-unfold)
(topic! 'integral-unfold 'analysis)

;;; =====================================================================
;;; (F2) integral-in and integral-monotone: read off the definition.
;;; =====================================================================

;;; integral-in (was a support of integral.scm, Thayer Thm. 2.7(1)).  The
;;; integral is the least upper bound of a subset of [0,+inf], so it lies in
;;; [0,+inf]; the two hypotheses are not used.
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL f
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IS-MEASURABLE-FN omega cA f)
            (IN (INTEGRAL omega cA mu f) RR-POS-STAR)))))))))
(dk-peel!)
(mac 'INTEGRAL)
(let ((x (cadr (cadr (dk-goal)))))
  (igl-sep-subset! x)
  (fact 'esup-in x)
  (ass))
(qed 'integral-in)
(topic! 'integral-in 'plumbing)
(gloss! 'integral-in
  "The integral of a measurable [0,+inf]-valued function is an element of
   [0,+inf] (Thayer Thm. 2.7, property (1), p. 9).  Since 2026-10-04 the integral is
   DEFINED (simple-integral.scm) as a least upper bound in [0,+inf], so this is
   esup-in read off the definition; the two hypotheses are not used.")

;;; PTWISE-LE(omega, s, g) from PTWISE-LE(omega, s, f), PTWISE-LE(omega, f, g)
;;; and the three typings into RR-POS-STAR (FUN omega RR-POS-STAR) in context.
(define (igl-ptwise-le-trans! sv fv gv)
  (let ((le-sf (dk-project! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ omega)
                                                   (list '<= (list sv 'x_) (list fv 'x_))))
                            'PTWISE-LE (list 'PTWISE-LE 'omega sv fv)))
        (le-fg (dk-project! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ omega)
                                                   (list '<= (list fv 'x_) (list gv 'x_))))
                            'PTWISE-LE (list 'PTWISE-LE 'omega fv gv))))
    (dk-have! (list 'PTWISE-LE 'omega sv gv)
      (lambda ()
        (mac 'PTWISE-LE)
        (let* ((w (dk-di-var!)))
          (inst+ le-sf w)
          (inst+ le-fg w)
          (for-each (lambda (h) (fact 'fun-apply-type-c h 'omega 'RR-POS-STAR w))
                    (list sv fv gv))
          (dk-have! (list 'AND (list 'IN (list sv w) 'RR-POS-STAR)
                          (list 'AND (list 'IN (list fv w) 'RR-POS-STAR)
                                (list 'IN (list gv w) 'RR-POS-STAR))))
          (dk-have! (list 'AND (list '<= (list sv w) (list fv w))
                          (list '<= (list fv w) (list gv w))))
          (fact 'rr-pos-star-le-trans (list sv w) (list fv w) (list gv w))
          (ass))))))

;;; integral-monotone (was a support, Thayer Thm. 2.7(6)): every simple s below
;;; f is below g, so the set whose supremum is the integral of f is a subset of
;;; the one for g.
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL f (FORALL g
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IS-MEASURABLE-FN omega cA f)
            (IMPLIES (IS-MEASURABLE-FN omega cA g)
              (IMPLIES (PTWISE-LE omega f g)
                (<= (INTEGRAL omega cA mu f) (INTEGRAL omega cA mu g)))))))))))))
(dk-peel!)
(igl-mfn-parts! 'omega 'cA 'f)
(igl-mfn-parts! 'omega 'cA 'g)
(mac 'INTEGRAL)
(let* ((gl (dk-goal))
       (xf (cadr (cadr gl)))
       (xg (cadr (caddr gl)))
       (eg (list 'ESUP xg)))
  (igl-sep-subset! xf)
  (igl-sep-subset! xg)
  (fact 'esup-in xg)
  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x xf) (list '<= 'x eg)))
    (lambda ()
      (let* ((w  (dk-di-var!))
             (ls (dk-landed (lambda () (sep-me (list 'IN w xf)))))
             (ex (car (filter (lambda (f) (dk-head-is? f 'FORSOME)) ls)))
             (sv (dk-skolem! ex)))
        (igl-simple-parts! 'omega 'cA sv)
        (igl-mfn-parts! 'omega 'cA sv)
        (igl-ptwise-le-trans! sv 'f 'g)
        (dk-have! (list 'IN w xg)
          (lambda ()
            (for-each
              (lambda (l)
                (if (not (sequent-node-grounded? l))
                    (begin
                      (dk-focus! l)
                      (if (dk-asm? (dk-goal))
                          (ass)
                          (begin (ew sv) (igl-conj-close! dk-ass!))))))
              (dk-opened (lambda () (sep-mi))))))
        (fact 'esup-upper xg w)
        (ass))))
  (dk-have! (list 'AND (list 'IN eg 'RR-POS-STAR)
                  (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x xf) (list '<= 'x eg)))))
  (fact 'esup-least xf eg)
  (ass))
(qed 'integral-monotone)
(topic! 'integral-monotone 'inequalities)
(gloss! 'integral-monotone
  "The integral is monotone: f <= g pointwise gives integral f <= integral g
   (Thayer Thm. 2.7(6), p. 10; Rudin Prop. 1.24(a), p. 19).  Proved from the
   definition: every simple function below f is below g.")

;;; =====================================================================
;;; (F3) THE PARTITION LEMMA.  A simple function factored through a finite
;;;     partition: if s = hh o k with k : omega -> KS (KS finite), hh real and
;;;     >= 0 on KS, and every fiber F_p = { x : k(x) = p } measurable, then
;;;
;;;        SIMPLE-INTEGRAL(omega, mu, s) = SUM_{p in KS} hh(p) * mu(F_p).
;;;
;;;     This is the common-refinement argument behind Rudin Prop. 1.24 and
;;;     the notes' Prop. 2.2: monotonicity, additivity, homogeneity and the
;;;     indicator are each ONE instance of it.  The proof: group the sum over
;;;     KS by the value hh(p) (finsum-cm-fiber-ptwise), recognise each group as
;;;     y * mu({ s = y }) (the level set is the preimage of the group, so its
;;;     measure is the group's sum, measure-preimage-finite-sum, and the real
;;;     y comes out, rps-finsum-scale-ptwise), and drop the values of hh that s
;;;     does not take (finsum-cm-pad-ptwise: their level sets are empty).
;;; =====================================================================

(define igl-m 'RR-POS-STAR-ADD-MONOID)
(define (igl-fs fv u) (list 'FINSUM 'RR-POS-STAR-ADD-MONOID fv u))
(define (igl-lev y) (list 'SEP 'six_ 'omega (list '= '(s six_) y)))
(define (igl-lam d) (list 'VNB-LAMBDA 'siy_ d (list 'etimes 'siy_ (list 'mu (igl-lev 'siy_)))))
(define (igl-hfib y) (list 'SEP 'fw_ 'ks (list '= '(hh fw_) y)))
(define (igl-gm) '(VNB-LAMBDA gmp_ ks (mu (SEP fx_ omega (= (k fx_) gmp_)))))

;;; (IN (mu X) RR-POS-STAR) and (IN (mu X) SET), X in cA in context
(define (igl-mu-typed! x)
  (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR x)
  (fact 'membership-implies-sethood (list 'mu x) 'RR-POS-STAR))

;;; y in T = IMAGE(hh, KS): land (IN y RR), (<= 0 y), (IN y RR-POS-STAR)
(define (igl-t-real! y tset)
  (if (not (dk-asm? (list 'IN y 'RR-POS-STAR)))
      (let ((cj (list 'AND (list 'IN y 'RR) (list '<= 0 y))))
        ;; on a lane: dk-image-hyp! CONSUMES the membership, which callers need
        (dk-have! cj
          (lambda ()
            (let* ((ex (dk-image-hyp! (list 'IN y tset)))
                   (p  (dk-skolem! ex)))
              (inst+ '(FORALL z_ (IMPLIES (IN z_ ks) (IN (hh z_) RR))) p)
              (inst+ '(FORALL z_ (IMPLIES (IN z_ ks) (<= 0 (hh z_)))) p)
              (igl-conj-close!
                (lambda () (subst (list '= y (list 'hh p))) (dk-ass!))))))
        (dk-split! cj)
        (ibk-rps! y))))

(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (IMPLIES (IS-MEASURE omega cA mu)
        (FORALL s (FORALL KS (IMPLIES (IN KS SET) (IMPLIES (IN (CARD KS) NN)
          (FORALL k
            (IMPLIES (FORALL z_ (IMPLIES (IN z_ omega) (IN (k z_) KS)))
            (IMPLIES (FORALL z_ (IMPLIES (IN z_ KS) (IN (SEP fx_ omega (= (k fx_) z_)) cA)))
              (FORALL hh
                (IMPLIES (FORALL z_ (IMPLIES (IN z_ KS) (IN (hh z_) RR)))
                (IMPLIES (FORALL z_ (IMPLIES (IN z_ KS) (<= 0 (hh z_))))
                (IMPLIES (FORALL z_ (IMPLIES (IN z_ omega) (= (s z_) (hh (k z_)))))
                  (FORALL gg
                    (IMPLIES (FORALL z_ (IMPLIES (IN z_ KS)
                               (= (gg z_) (etimes (hh z_) (mu (SEP fx_ omega (= (k fx_) z_)))))))
                      (= (SIMPLE-INTEGRAL omega mu s)
                         (FINSUM RR-POS-STAR-ADD-MONOID gg KS)))))))))))))))))))))
(dk-peel!)
(igl-measure-parts! 'omega 'cA 'mu)
(ibk-rps-setup!)
(let* ((r     '(IMAGE s omega))
       (tt    '(IMAGE hh ks))
       (lt    (igl-lam tt))
       (lr    (igl-lam r))
       (ktyp  '(FORALL z_ (IMPLIES (IN z_ omega) (IN (k z_) ks))))
       (fmeas '(FORALL z_ (IMPLIES (IN z_ ks) (IN (SEP fx_ omega (= (k fx_) z_)) cA))))
       (sdef  '(FORALL z_ (IMPLIES (IN z_ omega) (= (s z_) (hh (k z_))))))
       (gdef  '(FORALL z_ (IMPLIES (IN z_ ks) (= (gg z_) (etimes (hh z_) (mu (SEP fx_ omega (= (k fx_) z_)))))))))
  (fact 'sigma-algebra-ambient-set 'omega 'cA)
  ;; (A) T = hh(KS) is a finite set
  (fact 'image-set 'hh 'ks)
  (fact 'card-image-finite 'hh 'ks)
  ;; (B) hh maps KS into T; gg is typed on KS
  (dk-have! (ibk-ptw 'ks (lambda (z) (list 'IN (list 'hh z) tt)))
    (lambda ()
      (let ((p (dk-di-var!)))
        (inst+ '(FORALL z_ (IMPLIES (IN z_ ks) (IN (hh z_) RR))) p)
        (dk-image-goal!)
        (ew p)
        (igl-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))))))
  (dk-have! (ibk-ptw 'ks (lambda (z) (list 'IN (list 'gg z) '(CARR RR-POS-STAR-ADD-MONOID))))
    (lambda ()
      (let ((p (dk-di-var!)))
        (inst+ gdef p)
        (inst+ fmeas p)
        (inst+ '(FORALL z_ (IMPLIES (IN z_ ks) (IN (hh z_) RR))) p)
        (inst+ '(FORALL z_ (IMPLIES (IN z_ ks) (<= 0 (hh z_)))) p)
        (ibk-rps! (list 'hh p))
        (igl-mu-typed! (ibk-fbr p))
        (dk-have! (list 'AND (list 'IN (list 'hh p) 'RR-POS-STAR)
                        (list 'IN (list 'mu (ibk-fbr p)) 'RR-POS-STAR)))
        (fact 'etimes-closed (list 'hh p) (list 'mu (ibk-fbr p)))
        (subst ibk-carr-eq)
        (subst (list '= (list 'gg p) (list 'etimes (list 'hh p) (list 'mu (ibk-fbr p)))))
        (ass))))
  ;; (C) R = s(omega) lies in T, so it is a finite set
  (ibk-fin-sub! tt r
    (lambda (w)
      (let* ((ex (dk-image-hyp! (list 'IN w r)))
             (x  (dk-skolem! ex)))
        (inst+ ktyp x)
        (inst+ sdef x)
        (dk-image-goal!)
        (ew (list 'k x))
        (igl-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (begin
                  (subst (list '= (list 'hh (list 'k x)) (list 's x)))
                  (ass))))))))
  ;; (D) at every value y in T: the level set of s is the preimage of the
  ;;     y-group of KS; it is measurable; y * mu(level) is typed
  (dk-have! (ibk-ptw tt (lambda (y) (list '= (igl-lev y) (ibk-pre (igl-hfib y)))))
    (lambda ()
      (let* ((y   (dk-di-var!))
             (fb  (igl-hfib y))
             (lv  (igl-lev y))
             (pre (ibk-pre fb)))
        (ibk-set-eq! lv pre
          (lambda (w)
            (sep-me (list 'IN w lv))
            (inst+ ktyp w)
            (inst+ sdef w)
            (ibk-sep-in!
              (lambda ()
                (if (dk-asm? (dk-goal))
                    (ass)
                    (ibk-sep-in!
                      (lambda ()
                        (if (dk-asm? (dk-goal))
                            (ass)
                            (begin
                              (subst (list '= (list 'hh (list 'k w)) (list 's w)))
                              (ass)))))))))
          (lambda (w)
            (sep-me (list 'IN w pre))
            (sep-me (list 'IN (list 'k w) fb))
            (inst+ sdef w)
            (ibk-sep-in!
              (lambda ()
                (if (dk-asm? (dk-goal))
                    (ass)
                    (begin (subst (list '= (list 's w) (list 'hh (list 'k w)))) (ass)))))))
        (ass))))
  (dk-have! (ibk-ptw tt (lambda (y) (list 'IN (igl-lev y) 'cA)))
    (lambda ()
      (let* ((y   (dk-di-var!))
             (fb  (igl-hfib y)))
        (ibk-fin-sub! 'ks fb (lambda (w) (sep-me (list 'IN w fb)) (ass)))
        (dk-have! (ibk-ptw fb ibk-fbr-in)
          (lambda ()
            (let ((w (dk-di-var!)))
              (sep-me (list 'IN w fb))
              (inst+ fmeas w)
              (ass))))
        (fact 'sigma-algebra-preimage-finite-in 'omega 'cA fb 'k)
        (inst+ (ibk-ptw tt (lambda (y) (list '= (igl-lev y) (ibk-pre (igl-hfib y))))) y)
        (subst (list '= (igl-lev y) (ibk-pre fb)))
        (ass))))
  (dk-have! (ibk-ptw tt (lambda (y) (list 'IN (list 'etimes y (list 'mu (igl-lev y))) 'RR-POS-STAR)))
    (lambda ()
      (let* ((y (dk-di-var!)) (lv (igl-lev y)))
        (igl-t-real! y tt)
        (inst+ (ibk-ptw tt (lambda (y) (list 'IN (igl-lev y) 'cA))) y)
        (igl-mu-typed! lv)
        (dk-have! (list 'AND (list 'IN y 'RR-POS-STAR) (list 'IN (list 'mu lv) 'RR-POS-STAR)))
        (fact 'etimes-closed y (list 'mu lv))
        (ass))))
  ;; (E) at every y in T, Lt(y) is the sum of gg over the y-group
  (dk-have! (ibk-ptw tt (lambda (y) (list '== (list lt y) (igl-fs 'gg (igl-hfib y)))))
    (lambda ()
      (let* ((y   (dk-di-var!))
             (fb  (igl-hfib y))
             (lv  (igl-lev y))
             (pre (ibk-pre fb))
             (gm  (igl-gm))
             (gme (lambda (z) (list '= (list gm z) (list 'mu (ibk-fbr z))))))
        (igl-t-real! y tt)
        (ibk-fin-sub! 'ks fb (lambda (w) (sep-me (list 'IN w fb)) (ass)))
        (dk-have! (ibk-ptw fb ibk-fbr-in)
          (lambda ()
            (let ((w (dk-di-var!)))
              (sep-me (list 'IN w fb))
              (inst+ fmeas w)
              (ass))))
        (dk-have! (ibk-ptw fb gme)
          (lambda ()
            (let ((w (dk-di-var!)))
              (sep-me (list 'IN w fb))
              (inst+ fmeas w)
              (igl-mu-typed! (ibk-fbr w))
              (dk-lam-b!)
              (rfl))))
        (fact 'measure-preimage-finite-sum 'omega 'cA 'mu fb 'k gm)
        (dk-have! (ibk-ptw fb (lambda (z) (list 'IN (list gm z) 'RR-POS-STAR)))
          (lambda ()
            (let ((w (dk-di-var!)))
              (inst+ (ibk-ptw fb gme) w)
              (sep-me (list 'IN w fb))
              (inst+ fmeas w)
              (igl-mu-typed! (ibk-fbr w))
              (subst (gme w))
              (ass))))
        (dk-have! (ibk-ptw fb (lambda (z) (list '= (list 'gg z) (list 'etimes y (list gm z)))))
          (lambda ()
            (let ((w (dk-di-var!)))
              (inst+ (ibk-ptw fb gme) w)
              (sep-me (list 'IN w fb))
              (inst+ gdef w)
              (subst (list '= (list 'gg w) (list 'etimes (list 'hh w) (list 'mu (ibk-fbr w)))))
              (subst (gme w))
              (subst (list '= (list 'hh w) y))
              (inst+ fmeas w)
              (igl-mu-typed! (ibk-fbr w))
              (dk-have! (list 'AND (list 'IN y 'RR-POS-STAR) (list 'IN (list 'mu (ibk-fbr w)) 'RR-POS-STAR)))
              (fact 'etimes-closed y (list 'mu (ibk-fbr w)))
              (rfl))))
        (fact 'rps-finsum-scale-ptwise y fb gm 'gg)
        (inst+ (ibk-ptw tt (lambda (y) (list '= (igl-lev y) (ibk-pre (igl-hfib y))))) y)
        (inst+ (ibk-ptw tt (lambda (y) (list 'IN (list 'etimes y (list 'mu (igl-lev y))) 'RR-POS-STAR))) y)
        (fact 'membership-implies-sethood (list 'etimes y (list 'mu lv)) 'RR-POS-STAR)
        (dk-lam-b!)
        (subst (list '= lv pre))
        (subst (list '= (list 'mu pre) (igl-fs gm fb)))
        (subst (list '= (list 'etimes y (igl-fs gm fb)) (igl-fs 'gg fb)))
        (qrfl))))
  ;; (F) group KS by the value of hh
  (fact 'finsum-cm-fiber-ptwise igl-m 'ks tt 'hh 'gg lt)
  ;; (G) Lt is typed on T, and vanishes off R
  (dk-have! (ibk-ptw tt (lambda (y) (list 'IN (list lt y) '(CARR RR-POS-STAR-ADD-MONOID))))
    (lambda ()
      (let* ((y (dk-di-var!)) (lv (igl-lev y)))
        (inst+ (ibk-ptw tt (lambda (y) (list 'IN (list 'etimes y (list 'mu (igl-lev y))) 'RR-POS-STAR))) y)
        (fact 'membership-implies-sethood (list 'etimes y (list 'mu lv)) 'RR-POS-STAR)
        (dk-lam-b!)
        (subst ibk-carr-eq)
        (ass))))
  (dk-have! (ibk-ptw tt (lambda (y) (list 'IMPLIES (list 'NOT (list 'IN y r))
                                          (list '= (list lt y) '(IDEN RR-POS-STAR-ADD-MONOID)))))
    (lambda ()
      (let* ((y (dk-di-var!)) (lv (igl-lev y)))
        (di)
        (igl-t-real! y tt)
        (ibk-set-eq! lv 'EMPTY-SET
          (lambda (w)
            (sep-me (list 'IN w lv))
            (dk-have! (list 'IN y r)
              (lambda ()
                (dk-image-goal!)
                (ew w)
                (igl-conj-close! (lambda () (ass)))))
            (igl-keep-prop! (list 'IN y r) (list 'NOT (list 'IN y r))))
          (lambda (w)
            (fact 'empty-set-has-no-members w)
            (igl-keep-prop! (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET)))))
        (inst+ (ibk-ptw tt (lambda (y) (list 'IN (list 'etimes y (list 'mu (igl-lev y))) 'RR-POS-STAR))) y)
        (fact 'membership-implies-sethood (list 'etimes y (list 'mu lv)) 'RR-POS-STAR)
        (dk-lam-b!)
        (subst ibk-iden-eq)
        (subst (list '= lv 'EMPTY-SET))
        (subst '(= (mu EMPTY-SET) 0))
        (fact 'etimes-zero-right y)
        (ass))))
  (fact 'finsum-cm-pad-ptwise igl-m tt r lt)
  ;; (H) on R the two lambdas agree
  (dk-have! (ibk-ptw r (lambda (y) (list '= (list lt y) (list lr y))))
    (lambda ()
      (let* ((y (dk-di-var!)) (lv (igl-lev y)))
        (inst+ (ibk-ptw r (lambda (z) (list 'IN z tt))) y)
        (inst+ (ibk-ptw tt (lambda (y) (list 'IN (list 'etimes y (list 'mu (igl-lev y))) 'RR-POS-STAR))) y)
        (fact 'membership-implies-sethood (list 'etimes y (list 'mu lv)) 'RR-POS-STAR)
        (dk-lam-b!)
        (rfl))))
  (fact 'finsum-cm-congruence-q igl-m r lt lr)
  ;; (I) assemble
  (fact 'finsum-comm-monoid-type-ptwise igl-m 'ks 'gg)
  (mac 'SIMPLE-INTEGRAL)
  (subst (list '= (igl-fs lr r) (igl-fs lt r)))
  (subst (list '= (igl-fs lt r) (igl-fs lt tt)))
  (subst (list '= (igl-fs lt tt) (igl-fs 'gg 'ks)))
  (rfl))
(qed 'simple-integral-partition)
(topic! 'simple-integral-partition 'analysis)


;;; =====================================================================
;;; (F4) MONOTONICITY OF THE SIMPLE INTEGRAL, and the supremum attained.
;;; =====================================================================

(define (igl-lev-of fv y) (list 'SEP 'six_ 'omega (list '= (list fv 'six_) y)))
(define (igl-lam-of fv d) (list 'VNB-LAMBDA 'siy_ d (list 'etimes 'siy_ (list 'mu (igl-lev-of fv 'siy_)))))
(define (igl-real-ptw fv) (ibk-ptw 'omega (lambda (z) (list 'IN (list fv z) 'RR))))

;;; y in IMAGE(fv, omega), fv simple (its parts in context): land (IN y RR),
;;; (<= 0 y), (IN y RR-POS-STAR); the membership survives.
(define (igl-range-real! y fv)
  (if (not (dk-asm? (list 'IN y 'RR-POS-STAR)))
      (let ((cj (list 'AND (list 'IN y 'RR) (list '<= 0 y))))
        (dk-have! cj
          (lambda ()
            (let* ((ex (dk-image-hyp! (list 'IN y (list 'IMAGE fv 'omega))))
                   (x  (dk-skolem! ex)))
              (inst+ (igl-real-ptw fv) x)
              (fact 'fun-apply-type-c fv 'omega 'RR-POS-STAR x)
              (fact 'rr-pos-star-nonneg (list fv x))
              (igl-conj-close!
                (lambda () (subst (list '= y (list fv x))) (dk-ass!))))))
        (dk-split! cj)
        (ibk-rps! y))))

;;; the parts of IS-MEASURE(omega, cA, mu) and of IS-SIMPLE-FN of each fv
(define (igl-setup! . fvs)
  (igl-measure-parts! 'omega 'cA 'mu)
  (fact 'sigma-algebra-ambient-set 'omega 'cA)
  (ibk-rps-setup!)
  (for-each (lambda (fv)
              (igl-simple-parts! 'omega 'cA fv)
              (igl-mfn-parts! 'omega 'cA fv)
              (fact 'image-set fv 'omega))
            fvs))

;;; simple-integral-in: the simple integral of a simple function is in [0,+inf].
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL s
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IS-SIMPLE-FN omega cA s)
            (IN (SIMPLE-INTEGRAL omega mu s) RR-POS-STAR)))))))))
(dk-peel!)
(igl-setup! 's)
(let* ((r '(IMAGE s omega)) (lr (igl-lam-of 's r)))
  (dk-have! (ibk-ptw r (lambda (y) (list 'IN (list lr y) '(CARR RR-POS-STAR-ADD-MONOID))))
    (lambda ()
      (let* ((y (dk-di-var!)) (lv (igl-lev-of 's y)))
        (igl-range-real! y 's)
        (fact 'measurable-fn-level-set 'omega 'cA 's y)
        (igl-mu-typed! lv)
        (dk-have! (list 'AND (list 'IN y 'RR-POS-STAR) (list 'IN (list 'mu lv) 'RR-POS-STAR)))
        (fact 'etimes-closed y (list 'mu lv))
        (fact 'membership-implies-sethood (list 'etimes y (list 'mu lv)) 'RR-POS-STAR)
        (dk-lam-b!)
        (subst ibk-carr-eq)
        (ass))))
  (fact 'finsum-comm-monoid-type-ptwise igl-m r lr)
  (mac 'SIMPLE-INTEGRAL)
  (subst (list '= 'RR-POS-STAR '(CARR RR-POS-STAR-ADD-MONOID)))
  (ass))
(qed 'simple-integral-in)
(topic! 'simple-integral-in 'plumbing)

;;; The joint partition of two simple functions sv, tv: KS = s(omega) x t(omega),
;;; K(x) = [s(x), t(x)] as a function symbol (ibk-abstract!), and every fiber
;;; of K measurable (it is a level set of s cut with a level set of t).
;;; Returns (K C VALUE-EQUATION).
(define (igl-joint! sv tv)
  (let* ((rs (list 'IMAGE sv 'omega))
         (rt (list 'IMAGE tv 'omega))
         (cc (list 'CARTESIAN rs rt))
         (pairx (lambda (x) (list 'LIST (list sv x) (list tv x))))
         (in-image! (lambda (x)
                      (dk-image-goal!) (ew x)
                      (igl-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!) (rfl))))))
         (typer (lambda (x)
                  (fact 'fun-apply-type-c sv 'omega 'RR-POS-STAR x)
                  (fact 'fun-apply-type-c tv 'omega 'RR-POS-STAR x)
                  (dk-have! (list 'IN (list sv x) rs) (lambda () (in-image! x)))
                  (dk-have! (list 'IN (list tv x) rt) (lambda () (in-image! x)))
                  (fact 'pair-in-cartesian rs rt (list sv x) (list tv x)))))
    ;; C is a finite set
    (let ((iff (dk-cite! 'cartesian-set-iff rs rt)))
      (dk-have! (list 'IN cc 'SET)
        (lambda () (igl-keep-prop! iff (list 'IN rs 'SET) (list 'IN rt 'SET)))))
    (fact 'card-cartesian-nn rs rt)
    (let* ((kve (ibk-abstract! 'omega cc pairx
                  (lambda (x) (typer x) (dk-ass!))
                  (lambda (x) (typer x) (fact 'membership-implies-sethood (pairx x) cc))))
           (kv  (car kve))
           (ve  (cdr kve))
           (fbr (lambda (p) (list 'SEP 'fx_ 'omega (list '= (list kv 'fx_) p)))))
      (dk-have! (ibk-ptw 'omega (lambda (z) (list 'IN (list kv z) cc)))
        (lambda ()
          (let ((x (dk-di-var!)))
            (fact 'fun-apply-type-c kv 'omega cc x)
            (dk-ass!))))
      ;; every fiber of K is measurable
      (dk-have! (ibk-ptw cc (lambda (p) (list 'IN (fbr p) 'cA)))
        (lambda ()
          (let* ((p  (dk-di-var!))
                 (p1 (list 'NTH 1 p)) (p2 (list 'NTH 2 p))
                 (a1 (list 'SEP 'gx_ 'omega (list '= (list sv 'gx_) p1)))
                 (a2 (list 'SEP 'gx_ 'omega (list '= (list tv 'gx_) p2)))
                 (ix (list 'INTERSECTION a1 a2)))
            (dk-split! (dk-cite! 'cartesian-nth p rs rt))
            (igl-range-real! p1 sv)
            (igl-range-real! p2 tv)
            (fact 'measurable-fn-level-set 'omega 'cA sv p1)
            (fact 'measurable-fn-level-set 'omega 'cA tv p2)
            (fact 'sigma-algebra-inter-closed-2 'omega 'cA a1 a2)
            (fact 'cartesian-pair-eq-rev p rs rt)
            (ibk-set-eq! (fbr p) ix
              (lambda (w)
                (sep-me (list 'IN w (fbr p)))
                (dk-apply! ve w)
                (dk-have! (list '= (pairx w) p)
                  (lambda () (subst (list '= (pairx w) (list kv w))) (dk-ass!)))
                (mac 'intersection-membership)
                (igl-conj-close!
                  (lambda ()
                    (ibk-sep-in!
                      (lambda ()
                        (if (dk-asm? (dk-goal))
                            (dk-ass!)
                            (begin
                              (subst (list '= p (pairx w)))
                              (nth-r)
                              (rfl))))))))
              (lambda (w)
                (mac-h 'intersection-membership (list 'IN w ix))
                (dk-split-all!)
                (sep-me (list 'IN w a1))
                (sep-me (list 'IN w a2))
                (dk-apply! ve w)
                (ibk-sep-in!
                  (lambda ()
                    (if (dk-asm? (dk-goal))
                        (dk-ass!)
                        (begin
                          (subst (list '== (list kv w) (pairx w)))
                          (subst (list '= (list sv w) p1))
                          (subst (list '= (list tv w) p2))
                          (dk-ass!)))))))
            (subst (list '= (fbr p) ix))
            (dk-ass!))))
      (list kv cc ve))))

;;; A factor function H(p) == NTH(i, p) on C, and the summand
;;; G(p) == etimes(H(p), mu(F_p)), both as function symbols; land every
;;; hypothesis of simple-integral-partition for the function fv = NTH(i) o K.
;;; Returns (H G).
(define (igl-factor! i fv sv tv kv cc ve)
  (let* ((rr-of (if (= i 1) sv tv))
         (fbr   (lambda (p) (list 'SEP 'fx_ 'omega (list '= (list kv 'fx_) p))))
         (nth-real! (lambda (p)
                      (dk-split! (dk-cite! 'cartesian-nth p (cadr cc) (caddr cc)))
                      (igl-range-real! (list 'NTH i p) rr-of)))
         (hve  (ibk-abstract! cc 'RR (lambda (p) (list 'NTH i p))
                 (lambda (p) (nth-real! p) (dk-ass!))
                 (lambda (p) (nth-real! p)
                   (fact 'membership-implies-sethood (list 'NTH i p) 'RR))))
         (hv   (car hve))
         (hval (cdr hve))
         (h-facts! (lambda (p)
                     (nth-real! p)
                     (dk-apply! hval p)
                     (fact 'fun-apply-type-c hv cc 'RR p)
                     (dk-have! (list '<= 0 (list hv p))
                       (lambda () (subst (list '== (list hv p) (list 'NTH i p))) (dk-ass!)))
                     (ibk-rps! (list hv p))
                     (inst+ (ibk-ptw cc (lambda (q) (list 'IN (fbr q) 'cA))) p)
                     (igl-mu-typed! (fbr p))
                     (dk-have! (list 'AND (list 'IN (list hv p) 'RR-POS-STAR)
                                     (list 'IN (list 'mu (fbr p)) 'RR-POS-STAR)))
                     (fact 'etimes-closed (list hv p) (list 'mu (fbr p)))))
         (gve  (ibk-abstract! cc 'RR-POS-STAR
                 (lambda (p) (list 'etimes (list hv p) (list 'mu (fbr p))))
                 (lambda (p) (h-facts! p) (dk-ass!))
                 (lambda (p) (h-facts! p)
                   (fact 'membership-implies-sethood
                         (list 'etimes (list hv p) (list 'mu (fbr p))) 'RR-POS-STAR))))
         (gv   (car gve))
         (gval (cdr gve)))
    (dk-have! (ibk-ptw cc (lambda (p) (list 'IN (list hv p) 'RR)))
      (lambda () (let ((p (dk-di-var!))) (fact 'fun-apply-type-c hv cc 'RR p) (dk-ass!))))
    (dk-have! (ibk-ptw cc (lambda (p) (list '<= 0 (list hv p))))
      (lambda ()
        (let ((p (dk-di-var!)))
          (nth-real! p)
          (dk-apply! hval p)
          (subst (list '== (list hv p) (list 'NTH i p)))
          (dk-ass!))))
    (dk-have! (ibk-ptw cc (lambda (p) (list 'IN (list gv p) 'RR-POS-STAR)))
      (lambda () (let ((p (dk-di-var!))) (fact 'fun-apply-type-c gv cc 'RR-POS-STAR p) (dk-ass!))))
    (dk-have! (ibk-ptw cc (lambda (p) (list '= (list gv p) (list 'etimes (list hv p) (list 'mu (fbr p))))))
      (lambda ()
        (let ((p (dk-di-var!)))
          (fact 'fun-apply-type-c gv cc 'RR-POS-STAR p)
          (dk-apply! gval p)
          (subst (list '= (list 'etimes (list hv p) (list 'mu (fbr p))) (list gv p)))
          (rfl))))
    (dk-have! (ibk-ptw 'omega (lambda (z) (list '= (list fv z) (list hv (list kv z)))))
      (lambda ()
        (let ((x (dk-di-var!)))
          (inst+ (ibk-ptw 'omega (lambda (z) (list 'IN (list kv z) cc))) x)
          (dk-apply! hval (list kv x))
          (dk-apply! ve x)
          (fact 'fun-apply-type-c fv 'omega 'RR-POS-STAR x)
          (subst (list '== (list hv (list kv x)) (list 'NTH i (list kv x))))
          (subst (list '== (list kv x) (list 'LIST (list sv x) (list tv x))))
          (nth-r)
          (rfl))))
    (list hv gv)))

;;; simple-integral-mono: s <= t pointwise, both simple => SINT(s) <= SINT(t)
;;; (Rudin Prop. 1.24(a) for simple functions; the notes' Prop. 2.2).
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL s (FORALL t
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IS-SIMPLE-FN omega cA s)
            (IMPLIES (IS-SIMPLE-FN omega cA t)
              (IMPLIES (PTWISE-LE omega s t)
                (<= (SIMPLE-INTEGRAL omega mu s) (SIMPLE-INTEGRAL omega mu t)))))))))))))
(dk-peel!)
(igl-setup! 's 't)
(let* ((j   (igl-joint! 's 't))
       (kv  (car j)) (cc (cadr j)) (ve (caddr j))
       (fbr (lambda (p) (list 'SEP 'fx_ 'omega (list '= (list kv 'fx_) p))))
       (f1  (igl-factor! 1 's 's 't kv cc ve))
       (f2  (igl-factor! 2 't 's 't kv cc ve))
       (h1 (car f1)) (g1 (cadr f1)) (h2 (car f2)) (g2 (cadr f2))
       (le  (dk-project! '(FORALL x_ (IMPLIES (IN x_ omega) (<= (s x_) (t x_))))
                         'PTWISE-LE '(PTWISE-LE omega s t))))
  (fact 'simple-integral-partition 'omega 'cA 'mu 's cc kv h1 g1)
  (fact 'simple-integral-partition 'omega 'cA 'mu 't cc kv h2 g2)
  ;; termwise: g1 <= g2 on C
  (dk-have! (ibk-ptw cc (lambda (p) (list '<= (list g1 p) (list g2 p))))
    (lambda ()
      (let* ((p  (dk-di-var!))
             (m  (list 'mu (fbr p))))
        (inst+ (ibk-ptw cc (lambda (q) (list '= (list g1 q) (list 'etimes (list h1 q) (list 'mu (fbr q)))))) p)
        (inst+ (ibk-ptw cc (lambda (q) (list '= (list g2 q) (list 'etimes (list h2 q) (list 'mu (fbr q)))))) p)
        (inst+ (ibk-ptw cc (lambda (q) (list 'IN (list h1 q) 'RR))) p)
        (inst+ (ibk-ptw cc (lambda (q) (list 'IN (list h2 q) 'RR))) p)
        (inst+ (ibk-ptw cc (lambda (q) (list '<= 0 (list h1 q)))) p)
        (inst+ (ibk-ptw cc (lambda (q) (list '<= 0 (list h2 q)))) p)
        (inst+ (ibk-ptw cc (lambda (q) (list 'IN (fbr q) 'cA))) p)
        (igl-mu-typed! (fbr p))
        (subst (list '= (list g1 p) (list 'etimes (list h1 p) m)))
        (subst (list '= (list g2 p) (list 'etimes (list h2 p) m)))
        (use-em (list 'FORSOME 'ex_ (list 'AND '(IN ex_ omega) (list '= (list kv 'ex_) p)))
          (lambda ()
            (let* ((ex (dk-ctx-form (list 'FORSOME 'ex_ (list 'AND '(IN ex_ omega) (list '= (list kv 'ex_) p)))))
                   (x  (dk-skolem! ex)))
              (dk-apply! ve x)
              (dk-have! (list '= (list 'LIST (list 's x) (list 't x)) p)
                (lambda () (subst (list '= (list 'LIST (list 's x) (list 't x)) (list kv x))) (ass)))
              (inst+ (ibk-ptw 'omega (lambda (z) (list '= (list 's z) (list h1 (list kv z))))) x)
              (inst+ (ibk-ptw 'omega (lambda (z) (list '= (list 't z) (list h2 (list kv z))))) x)
              (inst+ le x)
              (dk-have! (list '<= (list h1 p) (list h2 p))
                (lambda ()
                  (subst (list '= p (list kv x)))
                  (subst (list '= (list h1 (list kv x)) (list 's x)))
                  (subst (list '= (list h2 (list kv x)) (list 't x)))
                  (ass)))
              (fact 'etimes-mono-real-left (list h1 p) (list h2 p) m)
              (ass)))
          (lambda ()
            (ibk-set-eq! (fbr p) 'EMPTY-SET
              (lambda (w)
                (sep-me (list 'IN w (fbr p)))
                (dk-have! (list 'FORSOME 'ex_ (list 'AND '(IN ex_ omega) (list '= (list kv 'ex_) p)))
                  (lambda () (ew w) (igl-conj-close! (lambda () (ass)))))
                (igl-keep-prop! (list 'FORSOME 'ex_ (list 'AND '(IN ex_ omega) (list '= (list kv 'ex_) p)))
                                (list 'NOT (list 'FORSOME 'ex_ (list 'AND '(IN ex_ omega) (list '= (list kv 'ex_) p))))))
              (lambda (w)
                (fact 'empty-set-has-no-members w)
                (igl-keep-prop! (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET)))))
            (subst (list '= (fbr p) 'EMPTY-SET))
            (subst '(= (mu EMPTY-SET) 0))
            (ibk-rps! (list h1 p))
            (ibk-rps! (list h2 p))
            (fact 'etimes-zero-right (list h1 p))
            (fact 'etimes-zero-right (list h2 p))
            (subst (list '= (list 'etimes (list h1 p) 0) 0))
            (subst (list '= (list 'etimes (list h2 p) 0) 0))
            (fact 'zero-in-rr-pos-star)
            (fact 'rr-pos-star-le-refl 0)
            (ass))))))
  (fact 'rps-finsum-le-ptwise cc g1 g2)
  (subst (list '= '(SIMPLE-INTEGRAL omega mu s) (igl-fs g1 cc)))
  (subst (list '= '(SIMPLE-INTEGRAL omega mu t) (igl-fs g2 cc)))
  (ass))
(qed 'simple-integral-mono)
(topic! 'simple-integral-mono 'inequalities)

;;; integral-simple: for a simple s the supremum is attained at s itself, so
;;; the integral of a simple function is its simple integral (Rudin, remark after
;;; Def. 1.23: the two definitions agree on simple functions, by 1.24(a)).
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL s
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IS-SIMPLE-FN omega cA s)
            (= (INTEGRAL omega cA mu s) (SIMPLE-INTEGRAL omega mu s))))))))))
(dk-peel!)
(igl-setup! 's)
(fact 'simple-integral-in 'omega 'cA 'mu 's)
(fact 'integral-in 'omega 'cA 'mu 's)
(let* ((iu (dk-cite! 'integral-unfold 'omega 'cA 'mu 's))
       (x  (cadr (caddr iu)))
       (ex (list 'ESUP x))
       (si '(SIMPLE-INTEGRAL omega mu s)))
  (igl-sep-subset! x)
  (fact 'esup-in x)
  ;; ESUP X <= SINT(s): every member is the simple integral of some s' <= s
  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x x) (list '<= 'x si)))
    (lambda ()
      (let* ((w  (dk-di-var!))
             (ls (dk-landed (lambda () (sep-me (list 'IN w x)))))
             (e  (car (filter (lambda (f) (dk-head-is? f 'FORSOME)) ls)))
             (sv (dk-skolem! e)))
        (fact 'simple-integral-mono 'omega 'cA 'mu sv 's)
        (subst (list '= w (list 'SIMPLE-INTEGRAL 'omega 'mu sv)))
        (ass))))
  (dk-have! (list 'AND (list 'IN si 'RR-POS-STAR)
                  (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x x) (list '<= 'x si)))))
  (fact 'esup-least x si)
  ;; SINT(s) <= ESUP X: s itself is one of the s' (s <= s)
  (dk-have! '(PTWISE-LE omega s s)
    (lambda ()
      (mac 'PTWISE-LE)
      (let ((w (dk-di-var!)))
        (fact 'fun-apply-type-c 's 'omega 'RR-POS-STAR w)
        (fact 'rr-pos-star-le-refl (list 's w))
        (ass))))
  (dk-have! (list 'IN si x)
    (lambda ()
      (ibk-sep-in!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (begin (ew 's) (igl-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))))))
  (fact 'esup-upper x si)
  (dk-have! (list 'AND (list 'IN ex 'RR-POS-STAR) (list 'IN si 'RR-POS-STAR)))
  (dk-have! (list 'AND (list '<= ex si) (list '<= si ex)))
  (fact 'rr-pos-star-le-antisymm ex si)
  (subst (list '== '(INTEGRAL omega cA mu s) ex))
  (ass))
(qed 'integral-simple)
(topic! 'integral-simple 'analysis)

;;; integral-sup-of-simple (was a support, Rudin Def. 1.23): the definition read
;;; back with INTEGRAL in place of SIMPLE-INTEGRAL inside the set, which
;;; integral-simple licenses member by member.
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL f
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IS-MEASURABLE-FN omega cA f)
            (= (INTEGRAL omega cA mu f)
               (ESUP (SEP y_ RR-POS-STAR
                       (FORSOME s_
                         (AND (IS-SIMPLE-FN omega cA s_)
                              (AND (PTWISE-LE omega s_ f)
                                   (= y_ (INTEGRAL omega cA mu s_))))))))))))))))
(dk-peel!)
(fact 'integral-in 'omega 'cA 'mu 'f)
(let* ((gl (dk-goal))
       (y  (cadr (caddr gl)))
       (iu (dk-cite! 'integral-unfold 'omega 'cA 'mu 'f))
       (x  (cadr (caddr iu)))
       ;; one direction of the set equality: a member of A, witnessed by s', is
       ;; a member of B; EQ-OF gives the value equation B wants from A's
       (transfer!
         (lambda (a b to-sint?)
           (lambda (w)
             (let* ((ls (dk-landed (lambda () (sep-me (list 'IN w a)))))
                    (e  (car (filter (lambda (f) (dk-head-is? f 'FORSOME)) ls)))
                    (sv (dk-skolem! e))
                    (iv (list 'INTEGRAL 'omega 'cA 'mu sv))
                    (sv-int (list 'SIMPLE-INTEGRAL 'omega 'mu sv)))
               (fact 'integral-simple 'omega 'cA 'mu sv)
               (ibk-sep-in!
                 (lambda ()
                   (if (dk-asm? (dk-goal))
                       (ass)
                       (begin
                         (ew sv)
                         (igl-conj-close!
                           (lambda ()
                             (cond ((dk-asm? (dk-goal)) (ass))
                                   (to-sint? (subst (list '= sv-int iv)) (ass))
                                   (#t (subst (list '= iv sv-int)) (ass))))))))))))))
  (ibk-set-eq! y x (transfer! y x #t) (transfer! x y #f))
  (subst (list '= y x))
  (subst (list '= (list 'ESUP x) '(INTEGRAL omega cA mu f)))
  (rfl))
(qed 'integral-sup-of-simple)
(topic! 'integral-sup-of-simple 'analysis)
(gloss! 'integral-sup-of-simple
  "The integral of f is the supremum of the integrals of the simple
   measurable functions below f (Rudin Def. 1.23, p. 19).  Since 2026-10-04 this IS
   the definition of INTEGRAL (simple-integral.scm), read back with INTEGRAL in
   place of SIMPLE-INTEGRAL inside the set, which integral-simple licenses.")

