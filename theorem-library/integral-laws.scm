;;; dk-only! then prop, on the leaf that was the focus: `keep' may find the
;;; kept sequent already proven and close the leaf itself, after which a bare
;;; `prop' would fire on whatever leaf took the focus.
(define (ibk-keep-prop! . keepers)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! keepers)
    (if (not (sequent-node-grounded? leaf)) (prop))))

;;; dk-conj-close! that skips a conjunct leaf an earlier closer already
;;; grounded (hash-consing): dk-conj-close! focuses it anyway, the focus move to
;;; a grounded leaf is a no-op, and the closer then fires on whatever leaf holds
;;; the focus (the "assumption: goal not in context" lines of the first probes).
(define (ibk-conj-close! . opt)
  (let ((closer (if (pair? opt) (car opt) from-context!)))
    (let walk ()
      (let ((g (dk-goal)))
        (if (and (pair? g) (eq? (car g) 'AND))
            (for-each (lambda (k)
                        (if (not (sequent-node-grounded? k))
                            (begin (dk-focus! k) (walk))))
                      (dk-opened (lambda () (di))))
            (closer))))))

(define (ibk-real-case tm) (list 'AND (list 'IN tm 'RR) (list '<= 0 tm)))
(define (ibk-inf-case  tm) (list '= tm 'POS-INF))

;;; Split on tm in RR-POS-STAR: REAL-BODY runs with (IN tm RR), (<= 0 tm) in
;;; context (the conjunction already split), INF-BODY with (= tm POS-INF).
(define (ibk-star-cases! tm real-body inf-body)
  (have! (list 'OR (ibk-real-case tm) (ibk-inf-case tm))
         (lambda ()
           (let ((inst (dk-fact! 'rr-pos-star-membership tm)))
             (ibk-keep-prop! inst (list 'IN tm 'RR-POS-STAR)))))
  (use-cases (list (ibk-real-case tm) (ibk-inf-case tm))
    (lambda () (dk-split! (ibk-real-case tm)) (real-body))
    inf-body))

;;; Split on tm = 0.
(define (ibk-zero-split! tm zero-body nz-body)
  (use-em (list '= tm 0) zero-body nz-body))

;;; (<= 0 tm) and (IN tm RR), from whatever the context offers.
(define (ibk-nonneg! tm)
  (let ((claim (list '<= 0 tm)))
    (cond ((dk-asm? claim) #t)
          ((member tm '(0 1)) (have! claim (lambda () (arith))))
          ((dk-asm? (list 'IN tm 'RR-POS-STAR)) (fact 'rr-pos-star-nonneg tm))
          (#t (error "ibk-nonneg!: no source for" claim)))))
(define (ibk-real! tm)
  (let ((claim (list 'IN tm 'RR)))
    (cond ((dk-asm? claim) #t)
          ((equal? tm 0) (fact 'rr-zero-in))
          ((equal? tm 1) (fact 'rr-one-in))
          (#t (error "ibk-real!: no source for" claim)))))

;;; Rewrite (etimes a b) to (* a b) in the goal; a, b real and >= 0.
(define (ibk-etimes-real! a b)
  (ibk-real! a) (ibk-real! b) (ibk-nonneg! a) (ibk-nonneg! b)
  (fact 'etimes-real-defined a b)
  (subst (list '= (list 'etimes a b) (list 'bintimes a b)))
  (fact 'bintimes-apply a b)
  (subst (list '== (list 'bintimes a b) (list '* a b))))

;;; Rewrite (eplus a b) to (+ a b) in the goal; a, b real and >= 0.
(define (ibk-eplus-real! a b)
  (ibk-real! a) (ibk-real! b) (ibk-nonneg! a) (ibk-nonneg! b)
  (fact 'eplus-real-defined a b)
  (subst (list '= (list 'eplus a b) (list 'binplus a b)))
  (fact 'binplus-apply a b)
  (subst (list '== (list 'binplus a b) (list '+ a b))))

;;; Land (IN (* a b) RR) and (<= 0 (* a b)); a, b real and >= 0 in context.
(define (ibk-mul-nonneg! a b)
  (let ((ab (list '* a b)))
    (have! (list 'AND (list 'IN a 'RR) (list 'IN b 'RR)))
    (fact 'rr-mul-closed a b)
    (if (not (dk-asm? (list '<= 0 ab)))
        (have! (list '<= 0 ab)
          (lambda ()
            (fact 'rr-zero-in)
            (fact 'rr-mul-le-right 0 a b)            ; (<= (* 0 b) (* a b))
            (fact 'rr-zero-mul b)                    ; (= (* 0 b) 0)
            (subst (list '= 0 (list '* 0 b)))
            (ass))))))

;;; Land (IN (+ a b) RR) and (<= 0 (+ a b)).
(define (ibk-add-nonneg! a b)
  (let ((ab (list '+ a b)))
    (have! (list 'AND (list 'IN a 'RR) (list 'IN b 'RR)))
    (fact 'rr-add-closed a b)
    (if (not (dk-asm? (list '<= 0 ab)))
        (have! (list '<= 0 ab)
          (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN b 'RR)
                               (list '<= 0 a) (list '<= 0 b)))))))

;;; Goal (IN tm RR-POS-STAR), with (IN tm RR) and (<= 0 tm) in context.
(define (ibk-rps-from-real!)
  (let* ((tm   (cadr (dk-goal)))
         (inst (dk-fact! 'rr-pos-star-membership tm)))
    (ibk-keep-prop! inst (list 'IN tm 'RR) (list '<= 0 tm))))

;;; Land (IN tm RR-POS-STAR) from (IN tm RR), (<= 0 tm) in context.
(define (ibk-rps! tm)
  (if (not (dk-asm? (list 'IN tm 'RR-POS-STAR)))
      (have! (list 'IN tm 'RR-POS-STAR) ibk-rps-from-real!)))

;;; (< 0 c) from (<= 0 c), (IN c RR) and (NOT (= c 0)).
(define (ibk-pos! c)
  (have! (list '< 0 c)
    (lambda ()
      (mac '<)
      (ibk-conj-close!
        (lambda ()
          (if (equal? (dk-goal) (list '<= 0 c))
              (ass)
              (begin
                (di)                                   ; (= 0 c)
                (fact 'equality-symmetry 0 c)
                (ibk-keep-prop! (list '= c 0) (list 'NOT (list '= c 0))))))))))

;;; (NOT (= c 0)) from (< 0 c).
(define (ibk-nz-of-pos! c)
  (have! (list 'NOT (list '= c 0))
    (lambda ()
      (di)                                             ; (= c 0)
      (fact 'equality-symmetry c 0)
      (let ((iff (dk-fact! '< 0 c)))
        (ibk-keep-prop! iff (list '< 0 c) (list '= 0 c))))))

;;; Goal-side rewrites for the POS-INF cases.
(define (ibk-et-inf-right! tm)            ; etimes(tm, POS-INF) -> POS-INF, tm /= 0
  (fact 'etimes-pos-inf-right tm)
  (subst (list '= (list 'etimes tm 'POS-INF) 'POS-INF)))
(define (ibk-et-inf-left! tm)             ; etimes(POS-INF, tm) -> POS-INF, tm /= 0
  (fact 'etimes-pos-inf-left tm)
  (subst (list '= (list 'etimes 'POS-INF tm) 'POS-INF)))
(define (ibk-ep-inf-right! tm)            ; eplus(tm, POS-INF) -> POS-INF
  (fact 'eplus-pos-inf-right tm)
  (subst (list '= (list 'eplus tm 'POS-INF) 'POS-INF)))
(define (ibk-ep-inf-left! tm)             ; eplus(POS-INF, tm) -> POS-INF
  (fact 'eplus-pos-inf-left tm)
  (subst (list '= (list 'eplus 'POS-INF tm) 'POS-INF)))


