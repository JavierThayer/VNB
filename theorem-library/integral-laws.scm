;;; simple-integral-indicator: SINT(1_a) = mu(a)  (Rudin Def. 1.23 at chi_A).
(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL a_
        (IMPLIES (IS-MEASURE omega cA mu) (IMPLIES (IN a_ cA)
          (= (SIMPLE-INTEGRAL omega mu (INDICATOR omega a_)) (mu a_))))))))))
(dk-peel!)
(igl-measure-parts! 'omega 'cA 'mu)
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(ibk-rps-setup!)
(igl-t2-facts!)
(fact 'measurable-fn-indicator 'omega 'cA 'a_)
(let* ((fbr (lambda (p) (list 'SEP 'fx_ 'omega (list '= (list igl-ind 'fx_) p))))
       (val! (lambda (p)                       ; p in T2: (IN p RR), (<= 0 p)
               (use-cases (igl-t2-or! p)
                 (lambda () (subst (list '= p 0)) (dk-ass!))
                 (lambda () (subst (list '= p 1)) (dk-ass!)))))
       (hve (ibk-abstract! igl-t2 'RR (lambda (p) p)
              (lambda (p) (val! p))
              (lambda (p)
                (dk-have! (list 'IN p 'RR) (lambda () (val! p)))
                (fact 'membership-implies-sethood p 'RR))))
       (hv (car hve)) (hval (cdr hve))
       (h-facts! (lambda (p)
                   (dk-have! (list 'IN p 'RR) (lambda () (val! p)))
                   (dk-have! '(<= 0 1) (lambda () (arith)))
                   (dk-have! '(<= 0 0) (lambda () (arith)))
                   (dk-have! (list '<= 0 p) (lambda () (val! p)))
                   (dk-apply! hval p)
                   (fact 'fun-apply-type-c hv igl-t2 'RR p)
                   (dk-have! (list '<= 0 (list hv p))
                     (lambda () (subst (list '== (list hv p) p)) (dk-ass!)))
                   (ibk-rps! (list hv p))
                   (fact 'measurable-fn-level-set 'omega 'cA igl-ind p)
                   (igl-mu-typed! (fbr p))
                   (dk-have! (list 'AND (list 'IN (list hv p) 'RR-POS-STAR)
                                   (list 'IN (list 'mu (fbr p)) 'RR-POS-STAR)))
                   (fact 'etimes-closed (list hv p) (list 'mu (fbr p)))))
       (gve (ibk-abstract! igl-t2 'RR-POS-STAR
              (lambda (p) (list 'etimes (list hv p) (list 'mu (fbr p))))
              (lambda (p) (h-facts! p) (dk-ass!))
              (lambda (p) (h-facts! p)
                (fact 'membership-implies-sethood
                      (list 'etimes (list hv p) (list 'mu (fbr p))) 'RR-POS-STAR))))
       (gv (car gve)) (gval (cdr gve)))
  ;; the partition lemma's hypotheses, with s = k = 1_a
  (dk-have! (ibk-ptw 'omega (lambda (z) (list 'IN (list igl-ind z) 'RR)))
    (lambda ()
      (let ((x (dk-di-var!)))
        (igl-ind-cases! x
          (lambda (v) (subst (list '= (list igl-ind x) v)) (dk-ass!))))))
  (dk-have! (ibk-ptw 'omega (lambda (z) (list 'IN (list igl-ind z) igl-t2)))
    (lambda ()
      (let ((x (dk-di-var!)))
        (igl-ind-cases! x
          (lambda (v) (igl-in-t2! v) (subst (list '= (list igl-ind x) v)) (dk-ass!))))))
  (dk-have! (ibk-ptw igl-t2 (lambda (p) (list 'IN (fbr p) 'cA)))
    (lambda ()
      (let ((p (dk-di-var!)))
        (dk-have! (list 'IN p 'RR) (lambda () (val! p)))
        (fact 'measurable-fn-level-set 'omega 'cA igl-ind p)
        (dk-ass!))))
  (dk-have! (ibk-ptw igl-t2 (lambda (p) (list 'IN (list hv p) 'RR)))
    (lambda () (let ((p (dk-di-var!))) (fact 'fun-apply-type-c hv igl-t2 'RR p) (dk-ass!))))
  (dk-have! (ibk-ptw igl-t2 (lambda (p) (list '<= 0 (list hv p))))
    (lambda ()
      (let ((p (dk-di-var!)))
        (dk-have! '(<= 0 1) (lambda () (arith)))
        (dk-have! '(<= 0 0) (lambda () (arith)))
        (dk-have! (list '<= 0 p) (lambda () (val! p)))
        (dk-apply! hval p)
        (subst (list '== (list hv p) p))
        (dk-ass!))))
  (dk-have! (ibk-ptw 'omega (lambda (z) (list '= (list igl-ind z) (list hv (list igl-ind z)))))
    (lambda ()
      (let ((x (dk-di-var!)))
        (inst+ (ibk-ptw 'omega (lambda (z) (list 'IN (list igl-ind z) igl-t2))) x)
        (inst+ (ibk-ptw 'omega (lambda (z) (list 'IN (list igl-ind z) 'RR))) x)
        (dk-apply! hval (list igl-ind x))
        (subst (list '== (list hv (list igl-ind x)) (list igl-ind x)))
        (rfl))))
  (dk-have! (ibk-ptw igl-t2 (lambda (p) (list 'IN (list gv p) 'RR-POS-STAR)))
    (lambda () (let ((p (dk-di-var!))) (fact 'fun-apply-type-c gv igl-t2 'RR-POS-STAR p) (dk-ass!))))
  (dk-have! (ibk-ptw igl-t2 (lambda (p) (list '= (list gv p) (list 'etimes (list hv p) (list 'mu (fbr p))))))
    (lambda ()
      (let ((p (dk-di-var!)))
        (fact 'fun-apply-type-c gv igl-t2 'RR-POS-STAR p)
        (dk-apply! gval p)
        (subst (list '= (list 'etimes (list hv p) (list 'mu (fbr p))) (list gv p)))
        (rfl))))
  (fact 'simple-integral-partition 'omega 'cA 'mu igl-ind igl-t2 igl-ind hv gv)
  ;; the sum over {0} u {1}
  (igl-in-t2! 0) (igl-in-t2! 1)
  (dk-have! '(NOT (IN 1 (PAIR 0 0)))
    (lambda ()
      (di)
      (let ((pm (inst*! (dk-cite! 'pairing-membership 0 0) 1)))
        (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
        (igl-keep-prop! pm '(IN 1 (PAIR 0 0)) '(NOT (= 1 0))))))
  (ibk-restrict! (ibk-ptw igl-t2 (lambda (p) (list 'IN (list gv p) 'RR-POS-STAR)))
                 '(PAIR 0 0) igl-t2 (lambda (p) (list 'IN (list gv p) 'RR-POS-STAR)))
  (ibk-rps-insert! '(PAIR 0 0) 1 igl-t2 gv)
  (inst+ (ibk-ptw igl-t2 (lambda (p) (list 'IN (list gv p) 'RR-POS-STAR))) 0)
  (dk-have! (list 'IN (list gv 0) '(CARR RR-POS-STAR-ADD-MONOID))
    (lambda () (subst ibk-carr-eq) (dk-ass!)))
  (fact 'finsum-cm-singleton-ptwise igl-m 0 gv)
  ;; the two terms
  (for-each (lambda (p)
              (inst+ (ibk-ptw igl-t2 (lambda (q) (list '= (list gv q) (list 'etimes (list hv q) (list 'mu (fbr q)))))) p)
              (dk-apply! hval p)
              (fact 'measurable-fn-level-set 'omega 'cA igl-ind p)
              (igl-mu-typed! (fbr p)))
            '(0 1))
  (fact 'etimes-zero-left (list 'mu (fbr 0)))
  (fact 'etimes-one-left (list 'mu (fbr 1)))
  ;; F_1 = a
  (let* ((sub (dk-project! '(SUBSET cA (POWER omega)) 'IS-SIGMA-ALGEBRA '(IS-SIGMA-ALGEBRA omega cA))))
    (fact 'subset-mem-fwd 'cA '(POWER omega) 'a_)
    (ibk-set-eq! (fbr 1) 'a_
      (lambda (w)
        (sep-me (list 'IN w (fbr 1)))
        (use-em (list 'IN w 'a_)
          (lambda () (ass))
          (lambda ()
            (fact 'indicator-value-out 'omega 'a_ w)
            (dk-have! '(= 1 0)
              (lambda () (subst (list '= 1 (list igl-ind w))) (dk-ass!)))
            (dk-have! '(NOT (= 1 0)) (lambda () (arith)))
            (igl-keep-prop! '(= 1 0) '(NOT (= 1 0))))))
      (lambda (w)
        (fact 'power-mem-in 'omega 'a_ w)
        (fact 'indicator-value-in 'omega 'a_ w)
        (ibk-sep-in! (lambda () (dk-ass!))))))
  (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR 'a_)
  (fact 'eplus-zero-left '(mu a_))
  (subst (list '= (list 'SIMPLE-INTEGRAL 'omega 'mu igl-ind) (igl-fs gv igl-t2)))
  (subst (list '= (igl-fs gv igl-t2) (list 'eplus (igl-fs gv '(PAIR 0 0)) (list gv 1))))
  (subst (list '= (igl-fs gv '(PAIR 0 0)) (list gv 0)))
  (subst (list '= (list gv 0) (list 'etimes (list hv 0) (list 'mu (fbr 0)))))
  (subst (list '= (list gv 1) (list 'etimes (list hv 1) (list 'mu (fbr 1)))))
  (subst (list '== (list hv 0) 0))
  (subst (list '== (list hv 1) 1))
  (subst (list '= (list 'etimes 0 (list 'mu (fbr 0))) 0))
  (subst (list '= (list 'etimes 1 (list 'mu (fbr 1))) (list 'mu (fbr 1))))
  (subst (list '= (fbr 1) 'a_))
  (subst '(= (eplus 0 (mu a_)) (mu a_)))
  (rfl))
