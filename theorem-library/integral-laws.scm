;;; =====================================================================
;;; (F6) +inf ON A NULL SET INTEGRATES TO 0 (was a support, Thayer Thm. 2.7(3)).
;;;     A simple s below +inf * 1_a vanishes off a, so each of its level sets
;;;     at a nonzero value lies inside a and is null: every term of SINT(s) is 0.
;;; =====================================================================

(define igl-ff (list 'PTWISE-SCALE 'omega 'POS-INF igl-ind))

;;; (= (ff w) 0) for w in omega, w not in a_
(define (igl-ff-zero! w)
  (let ((fw (list igl-ff w)) (iw (list igl-ind w)))
    (fact 'indicator-value-out 'omega 'a_ w)
    (dk-have! (list '= fw 0)
      (lambda ()
        (mac 'PTWISE-SCALE)
        (dk-have! (list 'IN (list 'etimes 'POS-INF iw) 'SET)
          (lambda ()
            (subst (list '= iw 0))
            (fact 'etimes-pos-inf-zero)
            (subst '(= (etimes POS-INF 0) 0))
            (fact 'rr-zero-in)
            (fact 'membership-implies-sethood 0 'RR)
            (dk-ass!)))
        (dk-lam-b!)
        (subst (list '= iw 0))
        (fact 'etimes-pos-inf-zero)
        (dk-ass!)))))

(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL a_
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IN a_ cA)
            (IMPLIES (= (mu a_) 0)
              (= (INTEGRAL omega cA mu (PTWISE-SCALE omega POS-INF (INDICATOR omega a_))) 0))))))))))
(dk-peel!)
(igl-measure-parts! 'omega 'cA 'mu)
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(ibk-rps-setup!)
(fact 'zero-in-rr-pos-star)
(let* ((iu (dk-cite! 'integral-unfold 'omega 'cA 'mu igl-ff))
       (x  (cadr (caddr iu)))
       (ex (list 'ESUP x)))
  (igl-sep-subset! x)
  (fact 'esup-in x)
  (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x x) (list '<= 'x 0)))
    (lambda ()
      (let* ((w  (dk-di-var!))
             (ls (dk-landed (lambda () (sep-me (list 'IN w x)))))
             (e  (car (filter (lambda (f) (dk-head-is? f 'FORSOME)) ls)))
             (sv (dk-skolem! e))
             (r  (list 'IMAGE sv 'omega))
             (lr (igl-lam-of sv r))
             (si (list 'SIMPLE-INTEGRAL 'omega 'mu sv))
             (le (dk-project! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ omega)
                                                     (list '<= (list sv 'x_) (list igl-ff 'x_))))
                              'PTWISE-LE (list 'PTWISE-LE 'omega sv igl-ff))))
        (igl-simple-parts! 'omega 'cA sv)
        (igl-mfn-parts! 'omega 'cA sv)
        (fact 'image-set sv 'omega)
        (dk-have! (ibk-ptw r (lambda (y) (list '= (list lr y) '(IDEN RR-POS-STAR-ADD-MONOID))))
          (lambda ()
            (let* ((y  (dk-di-var!))
                   (lv (igl-lev-of sv y)))
              (igl-range-real! y sv)
              (fact 'measurable-fn-level-set 'omega 'cA sv y)
              (igl-mu-typed! lv)
              (dk-have! (list 'AND (list 'IN y 'RR-POS-STAR) (list 'IN (list 'mu lv) 'RR-POS-STAR)))
              (fact 'etimes-closed y (list 'mu lv))
              (fact 'membership-implies-sethood (list 'etimes y (list 'mu lv)) 'RR-POS-STAR)
              (dk-lam-b!)
              (subst ibk-iden-eq)
              (use-em (list '= y 0)
                (lambda ()
                  ;; name mu(level) first: the level set mentions y too
                  (let ((mv (dk-name! (list 'mu lv) 'RR-POS-STAR)))
                    (subst (list '= (list 'mu lv) mv))
                    (subst (list '= y 0))
                    (fact 'etimes-zero-left mv)
                    (dk-ass!)))
                (lambda ()
                  ;; the level set at y /= 0 lies in a_
                  (dk-have! (list 'SUBSET lv 'a_)
                    (lambda ()
                      (mac 'subset-def)
                      (let ((v (dk-di-var!)))
                        (sep-me (list 'IN v lv))
                        (use-em (list 'IN v 'a_)
                          (lambda () (ass))
                          (lambda ()
                            (igl-ff-zero! v)
                            (inst+ le v)
                            (fact 'fun-apply-type-c sv 'omega 'RR-POS-STAR v)
                            (fact 'rr-pos-star-nonneg (list sv v))
                            (dk-have! (list '<= (list sv v) 0)
                              (lambda () (subst (list '= 0 (list igl-ff v))) (dk-ass!)))
                            (dk-have! (list 'AND (list 'IN (list sv v) 'RR-POS-STAR) '(IN 0 RR-POS-STAR)))
                            (dk-have! (list 'AND (list '<= (list sv v) 0) (list '<= 0 (list sv v))))
                            (fact 'rr-pos-star-le-antisymm (list sv v) 0)
                            (dk-have! (list '= y 0)
                              (lambda ()
                                (subst (list '= y (list sv v)))
                                (dk-ass!)))
                            (igl-keep-prop! (list '= y 0) (list 'NOT (list '= y 0))))))))
                  (fact 'measure-monotone 'omega 'cA 'mu lv 'a_)
                  (fact 'rr-pos-star-nonneg (list 'mu lv))
                  (dk-have! (list '<= (list 'mu lv) 0)
                    (lambda () (subst (list '= 0 '(mu a_))) (dk-ass!)))
                  (dk-have! (list 'AND (list 'IN (list 'mu lv) 'RR-POS-STAR) '(IN 0 RR-POS-STAR)))
                  (dk-have! (list 'AND (list '<= (list 'mu lv) 0) (list '<= 0 (list 'mu lv))))
                  (fact 'rr-pos-star-le-antisymm (list 'mu lv) 0)
                  (subst (list '= (list 'mu lv) 0))
                  (fact 'etimes-zero-right y)
                  (dk-ass!))))))
        (fact 'finsum-cm-all-iden-ptwise igl-m r lr)
        (fact 'simple-integral-unfold 'omega 'mu sv)
        (dk-have! (list '= si 0)
          (lambda ()
            (subst (list '== si (igl-fs lr r)))
            (subst (list '= (igl-fs lr r) '(IDEN RR-POS-STAR-ADD-MONOID)))
            (subst ibk-iden-eq)
            (rfl)))
        (subst (list '= w si))
        (subst (list '= si 0))
        (dk-have! '(<= 0 0) (lambda () (arith)))
        (dk-ass!))))
  (dk-have! (list 'AND '(IN 0 RR-POS-STAR)
                  (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x x) (list '<= 'x 0)))))
  (fact 'esup-least x 0)
  (fact 'rr-pos-star-nonneg ex)
  (dk-have! (list 'AND (list 'IN ex 'RR-POS-STAR) '(IN 0 RR-POS-STAR)))
  (dk-have! (list 'AND (list '<= ex 0) (list '<= 0 ex)))
  (fact 'rr-pos-star-le-antisymm ex 0)
  (subst (list '== (list 'INTEGRAL 'omega 'cA 'mu igl-ff) ex))
  (dk-ass!))
(qed 'integral-infinite-on-null)
(topic! 'integral-infinite-on-null 'analysis)
(gloss! 'integral-infinite-on-null
  "+inf on a null set and 0 off it integrates to 0 (Thayer Thm. 2.7(3),
   p. 10): a simple function below it vanishes off the set, so each of its level
   sets at a nonzero value is null and every term of its simple integral is 0.")

;;; =====================================================================
;;; (F7) ADDITIVITY OF THE SIMPLE INTEGRAL (Rudin Prop. 1.24-1.25 for simple
;;;     functions; the notes' Prop. 2.2): the joint partition of s and t,
;;;     on which s + t is the sum of the two coordinates.
;;; =====================================================================

;;; (IN (eplus a b) RR) and (<= 0 (eplus a b)): a, b real and >= 0 in context
(define (igl-eplus-real! a b)
  (let ((e (list 'eplus a b)) (ab (list '+ a b)))
    (if (not (dk-asm? (list 'IN e 'RR)))
        (begin
          (fact 'eplus-real-defined a b)
          (fact 'binplus-apply a b)
          (dk-have! (list 'AND (list 'IN a 'RR) (list 'IN b 'RR)))
          (fact 'rr-add-closed a b)
          (dk-have! (list '<= 0 ab)
            (lambda () (dk-ineq! (list 'IN a 'RR) (list 'IN b 'RR) (list '<= 0 a) (list '<= 0 b))))
          ;; (<= 0 e) first: a caller's goal may be (IN e RR) itself, which
          ;; dk-have! then proves in place, moving the focus away
          (dk-have! (list '<= 0 e)
            (lambda ()
              (subst (list '= e (list 'binplus a b)))
              (subst (list '== (list 'binplus a b) ab))
              (dk-ass!)))
          (dk-have! (list 'IN e 'RR)
            (lambda ()
              (subst (list '= e (list 'binplus a b)))
              (subst (list '== (list 'binplus a b) ab))
              (dk-ass!)))))))

;;; (= ((PTWISE-EPLUS omega s t) x) (eplus (s x) (t x))), x in omega, s and t
;;; typed into RR-POS-STAR (FUN omega RR-POS-STAR) in context
(define (igl-ptw-eplus-at! sv tv x)
  (let* ((u (list 'PTWISE-EPLUS 'omega sv tv))
         (e (list 'eplus (list sv x) (list tv x))))
    (fact 'fun-apply-type-c sv 'omega 'RR-POS-STAR x)
    (fact 'fun-apply-type-c tv 'omega 'RR-POS-STAR x)
    (dk-have! (list 'AND (list 'IN (list sv x) 'RR-POS-STAR) (list 'IN (list tv x) 'RR-POS-STAR)))
    (fact 'eplus-closed (list sv x) (list tv x))
    (fact 'membership-implies-sethood e 'RR-POS-STAR)
    (dk-have! (list '= (list u x) e)
      (lambda ()
        (mac 'PTWISE-EPLUS)
        (dk-lam-b!)
        (rfl)))))

(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL s (FORALL t
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IS-SIMPLE-FN omega cA s)
            (IMPLIES (IS-SIMPLE-FN omega cA t)
              (= (SIMPLE-INTEGRAL omega mu (PTWISE-EPLUS omega s t))
                 (eplus (SIMPLE-INTEGRAL omega mu s) (SIMPLE-INTEGRAL omega mu t)))))))))))))
(dk-peel!)
(igl-setup! 's 't)
(let* ((j   (igl-joint! 's 't))
       (kv  (car j)) (cc (cadr j)) (ve (caddr j))
       (u   '(PTWISE-EPLUS omega s t))
       (fbr (lambda (p) (list 'SEP 'fx_ 'omega (list '= (list kv 'fx_) p))))
       (f1  (igl-factor! 1 's 's 't kv cc ve))
       (f2  (igl-factor! 2 't 's 't kv cc ve))
       (h1 (car f1)) (g1 (cadr f1)) (h2 (car f2)) (g2 (cadr f2))
       (inst-at! (lambda (p)
                   (for-each (lambda (b) (inst+ (ibk-ptw cc b) p))
                             (list (lambda (q) (list 'IN (list h1 q) 'RR))
                                   (lambda (q) (list 'IN (list h2 q) 'RR))
                                   (lambda (q) (list '<= 0 (list h1 q)))
                                   (lambda (q) (list '<= 0 (list h2 q)))))
                   (igl-eplus-real! (list h1 p) (list h2 p))))
       (h3e (ibk-abstract! cc 'RR (lambda (p) (list 'eplus (list h1 p) (list h2 p)))
              (lambda (p) (inst-at! p) (dk-ass!))
              (lambda (p) (inst-at! p)
                (fact 'membership-implies-sethood (list 'eplus (list h1 p) (list h2 p)) 'RR))))
       (h3 (car h3e)) (h3v (cdr h3e))
       (g-facts! (lambda (p)
                   (inst-at! p)
                   (dk-apply! h3v p)
                   (fact 'fun-apply-type-c h3 cc 'RR p)
                   (dk-have! (list '<= 0 (list h3 p))
                     (lambda () (subst (list '== (list h3 p) (list 'eplus (list h1 p) (list h2 p)))) (dk-ass!)))
                   (ibk-rps! (list h3 p))
                   (inst+ (ibk-ptw cc (lambda (q) (list 'IN (fbr q) 'cA))) p)
                   (igl-mu-typed! (fbr p))
                   (dk-have! (list 'AND (list 'IN (list h3 p) 'RR-POS-STAR)
                                   (list 'IN (list 'mu (fbr p)) 'RR-POS-STAR)))
                   (fact 'etimes-closed (list h3 p) (list 'mu (fbr p)))))
       (g3e (ibk-abstract! cc 'RR-POS-STAR
              (lambda (p) (list 'etimes (list h3 p) (list 'mu (fbr p))))
              (lambda (p) (g-facts! p) (dk-ass!))
              (lambda (p) (g-facts! p)
                (fact 'membership-implies-sethood
                      (list 'etimes (list h3 p) (list 'mu (fbr p))) 'RR-POS-STAR))))
       (g3 (car g3e)) (g3v (cdr g3e)))
  ;; the partition lemma at u = s + t
  (dk-have! (ibk-ptw cc (lambda (p) (list 'IN (list h3 p) 'RR)))
    (lambda () (let ((p (dk-di-var!))) (fact 'fun-apply-type-c h3 cc 'RR p) (dk-ass!))))
  (dk-have! (ibk-ptw cc (lambda (p) (list '<= 0 (list h3 p))))
    (lambda ()
      (let ((p (dk-di-var!)))
        (inst-at! p)
        (dk-apply! h3v p)
        (subst (list '== (list h3 p) (list 'eplus (list h1 p) (list h2 p))))
        (dk-ass!))))
  (dk-have! (ibk-ptw cc (lambda (p) (list '= (list g3 p) (list 'etimes (list h3 p) (list 'mu (fbr p))))))
    (lambda ()
      (let ((p (dk-di-var!)))
        (fact 'fun-apply-type-c g3 cc 'RR-POS-STAR p)
        (dk-apply! g3v p)
        (subst (list '= (list 'etimes (list h3 p) (list 'mu (fbr p))) (list g3 p)))
        (rfl))))
  (dk-have! (ibk-ptw 'omega (lambda (z) (list '= (list u z) (list h3 (list kv z)))))
    (lambda ()
      (let ((x (dk-di-var!)))
        (inst+ (ibk-ptw 'omega (lambda (z) (list 'IN (list kv z) cc))) x)
        (inst+ (ibk-ptw 'omega (lambda (z) (list '= (list 's z) (list h1 (list kv z))))) x)
        (inst+ (ibk-ptw 'omega (lambda (z) (list '= (list 't z) (list h2 (list kv z))))) x)
        (dk-apply! h3v (list kv x))
        (igl-ptw-eplus-at! 's 't x)
        (subst (list '= (list u x) (list 'eplus (list 's x) (list 't x))))
        (subst (list '== (list h3 (list kv x)) (list 'eplus (list h1 (list kv x)) (list h2 (list kv x)))))
        (subst (list '= (list h1 (list kv x)) (list 's x)))
        (subst (list '= (list h2 (list kv x)) (list 't x)))
        (rfl))))
  (fact 'simple-integral-partition 'omega 'cA 'mu u cc kv h3 g3)
  (fact 'simple-integral-partition 'omega 'cA 'mu 's cc kv h1 g1)
  (fact 'simple-integral-partition 'omega 'cA 'mu 't cc kv h2 g2)
  ;; termwise: g3 = g1 + g2
  (for-each
    (lambda (gv)
      (dk-have! (ibk-ptw cc (lambda (p) (list 'IN (list gv p) '(CARR RR-POS-STAR-ADD-MONOID))))
        (lambda ()
          (let ((p (dk-di-var!)))
            (fact 'fun-apply-type-c gv cc 'RR-POS-STAR p)
            (subst ibk-carr-eq)
            (dk-ass!)))))
    (list g1 g2))
  (dk-have! (ibk-ptw cc (lambda (p) (list '= (list g3 p)
                                          (list '(OPR RR-POS-STAR-ADD-MONOID) (list g1 p) (list g2 p)))))
    (lambda ()
      (let* ((p (dk-di-var!)) (m (list 'mu (fbr p))))
        (for-each (lambda (gv hv)
                    (inst+ (ibk-ptw cc (lambda (q) (list '= (list gv q) (list 'etimes (list hv q) (list 'mu (fbr q)))))) p))
                  (list g1 g2 g3) (list h1 h2 h3))
        (inst-at! p)
        (dk-apply! h3v p)
        (inst+ (ibk-ptw cc (lambda (q) (list 'IN (fbr q) 'cA))) p)
        (igl-mu-typed! (fbr p))
        (fact 'etimes-distrib-right-real (list h1 p) (list h2 p) m)
        (subst ibk-opr-eq)
        (subst (list '= (list g3 p) (list 'etimes (list h3 p) m)))
        (subst (list '== (list h3 p) (list 'eplus (list h1 p) (list h2 p))))
        (subst (list '= (list 'etimes (list 'eplus (list h1 p) (list h2 p)) m)
                     (list 'eplus (list 'etimes (list h1 p) m) (list 'etimes (list h2 p) m))))
        (subst (list '= (list 'etimes (list h1 p) m) (list g1 p)))
        (subst (list '= (list 'etimes (list h2 p) m) (list g2 p)))
        (fact 'fun-apply-type-c g1 cc 'RR-POS-STAR p)
        (fact 'fun-apply-type-c g2 cc 'RR-POS-STAR p)
        (dk-have! (list 'AND (list 'IN (list g1 p) 'RR-POS-STAR) (list 'IN (list g2 p) 'RR-POS-STAR)))
        (fact 'eplus-closed (list g1 p) (list g2 p))
        (rfl))))
  (fact 'finsum-cm-add-ptwise igl-m cc g1 g2 g3)
  (for-each (lambda (gv) (ibk-rps-typed! cc gv)) (list g1 g2))
  (dk-have! (list 'AND (list 'IN (igl-fs g1 cc) 'RR-POS-STAR) (list 'IN (igl-fs g2 cc) 'RR-POS-STAR)))
  (fact 'eplus-closed (igl-fs g1 cc) (igl-fs g2 cc))
  (subst (list '= (list 'SIMPLE-INTEGRAL 'omega 'mu u) (igl-fs g3 cc)))
  (subst (list '= (igl-fs g3 cc) (list '(OPR RR-POS-STAR-ADD-MONOID) (igl-fs g1 cc) (igl-fs g2 cc))))
  (subst ibk-opr-eq)
  (subst (list '= '(SIMPLE-INTEGRAL omega mu s) (igl-fs g1 cc)))
  (subst (list '= '(SIMPLE-INTEGRAL omega mu t) (igl-fs g2 cc)))
  (rfl))
(qed 'simple-integral-additive)
(topic! 'simple-integral-additive 'analysis)

;;; =====================================================================
;;; (F8) HOMOGENEITY OF THE SIMPLE INTEGRAL: a real c >= 0 comes out (Rudin
;;;     Prop. 1.24(c) for simple functions).  The partition is the range of s
;;;     itself, on which c * s takes the value c * y.
;;; =====================================================================

;;; (= ((PTWISE-SCALE omega c sv) x) (etimes c (sv x))), x in omega
(define (igl-ptw-scale-at! cv sv x)
  (let* ((u (list 'PTWISE-SCALE 'omega cv sv))
         (e (list 'etimes cv (list sv x))))
    (fact 'fun-apply-type-c sv 'omega 'RR-POS-STAR x)
    (dk-have! (list 'AND (list 'IN cv 'RR-POS-STAR) (list 'IN (list sv x) 'RR-POS-STAR)))
    (fact 'etimes-closed cv (list sv x))
    (fact 'membership-implies-sethood e 'RR-POS-STAR)
    (dk-have! (list '= (list u x) e)
      (lambda ()
        ;; a compound sv (itself a PTWISE-SCALE) is named first, so the
        ;; unfold below opens the outer functoid only
        (if (pair? sv)
            (let ((nv (dk-name! sv '(FUN omega RR-POS-STAR))))
              (subst (list '= sv nv))
              (fact 'fun-apply-type-c nv 'omega 'RR-POS-STAR x)
              (dk-have! (list 'AND (list 'IN cv 'RR-POS-STAR) (list 'IN (list nv x) 'RR-POS-STAR)))
              (fact 'etimes-closed cv (list nv x))
              (fact 'membership-implies-sethood (list 'etimes cv (list nv x)) 'RR-POS-STAR)))
        (mac 'PTWISE-SCALE)
        (dk-lam-b!)
        (rfl)))))

(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL s (FORALL c
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IS-SIMPLE-FN omega cA s)
            (IMPLIES (IN c RR) (IMPLIES (<= 0 c)
              (= (SIMPLE-INTEGRAL omega mu (PTWISE-SCALE omega c s))
                 (etimes c (SIMPLE-INTEGRAL omega mu s))))))))))))))
(dk-peel!)
(igl-setup! 's)
(ibk-rps! 'c)
(let* ((r   '(IMAGE s omega))
       (u   '(PTWISE-SCALE omega c s))
       (lr  (igl-lam-of 's r))
       (fbr (lambda (y) (list 'SEP 'fx_ 'omega (list '= '(s fx_) y))))
       (y-facts! (lambda (y)
                   (igl-range-real! y 's)
                   (ibk-mul-nonneg! 'c y)))
       (hce (ibk-abstract! r 'RR (lambda (y) (list '* 'c y))
              (lambda (y) (y-facts! y) (dk-ass!))
              (lambda (y) (y-facts! y) (fact 'membership-implies-sethood (list '* 'c y) 'RR))))
       (hc (car hce)) (hcv (cdr hce))
       (g-facts! (lambda (y)
                   (y-facts! y)
                   (dk-apply! hcv y)
                   (fact 'fun-apply-type-c hc r 'RR y)
                   (dk-have! (list '<= 0 (list hc y))
                     (lambda () (subst (list '== (list hc y) (list '* 'c y))) (dk-ass!)))
                   (ibk-rps! (list hc y))
                   (fact 'measurable-fn-level-set 'omega 'cA 's y)
                   (igl-mu-typed! (fbr y))
                   (dk-have! (list 'AND (list 'IN (list hc y) 'RR-POS-STAR)
                                   (list 'IN (list 'mu (fbr y)) 'RR-POS-STAR)))
                   (fact 'etimes-closed (list hc y) (list 'mu (fbr y)))))
       (gce (ibk-abstract! r 'RR-POS-STAR
              (lambda (y) (list 'etimes (list hc y) (list 'mu (fbr y))))
              (lambda (y) (g-facts! y) (dk-ass!))
              (lambda (y) (g-facts! y)
                (fact 'membership-implies-sethood
                      (list 'etimes (list hc y) (list 'mu (fbr y))) 'RR-POS-STAR))))
       (gc (car gce)) (gcv (cdr gce)))
  ;; the partition lemma at KS = s(omega), k = s, hh = c * _
  (dk-have! (ibk-ptw 'omega (lambda (z) (list 'IN (list 's z) r)))
    (lambda ()
      (let ((x (dk-di-var!)))
        (dk-image-goal!) (ew x)
        (igl-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))))))
  (dk-have! (ibk-ptw r (lambda (y) (list 'IN (fbr y) 'cA)))
    (lambda ()
      (let ((y (dk-di-var!)))
        (igl-range-real! y 's)
        (fact 'measurable-fn-level-set 'omega 'cA 's y)
        (dk-ass!))))
  (dk-have! (ibk-ptw r (lambda (y) (list 'IN (list hc y) 'RR)))
    (lambda () (let ((y (dk-di-var!))) (fact 'fun-apply-type-c hc r 'RR y) (dk-ass!))))
  (dk-have! (ibk-ptw r (lambda (y) (list '<= 0 (list hc y))))
    (lambda ()
      (let ((y (dk-di-var!)))
        (y-facts! y)
        (dk-apply! hcv y)
        (subst (list '== (list hc y) (list '* 'c y)))
        (dk-ass!))))
  (dk-have! (ibk-ptw r (lambda (y) (list '= (list gc y) (list 'etimes (list hc y) (list 'mu (fbr y))))))
    (lambda ()
      (let ((y (dk-di-var!)))
        (fact 'fun-apply-type-c gc r 'RR-POS-STAR y)
        (dk-apply! gcv y)
        (subst (list '= (list 'etimes (list hc y) (list 'mu (fbr y))) (list gc y)))
        (rfl))))
  (dk-have! (ibk-ptw 'omega (lambda (z) (list '= (list u z) (list hc (list 's z)))))
    (lambda ()
      (let ((x (dk-di-var!)))
        (inst+ (ibk-ptw 'omega (lambda (z) (list 'IN (list 's z) r))) x)
        (inst+ (igl-real-ptw 's) x)
        (fact 'fun-apply-type-c 's 'omega 'RR-POS-STAR x)
        (fact 'rr-pos-star-nonneg (list 's x))
        (dk-apply! hcv (list 's x))
        (igl-ptw-scale-at! 'c 's x)
        (ibk-mul-nonneg! 'c (list 's x))
        (subst (list '= (list u x) (list 'etimes 'c (list 's x))))
        (subst (list '== (list hc (list 's x)) (list '* 'c (list 's x))))
        (ibk-etimes-real! 'c (list 's x))
        (rfl))))
  (fact 'simple-integral-partition 'omega 'cA 'mu u r 's hc gc)
  ;; c comes out termwise: gc(y) = c * (y * mu(level y)) = c * L(y)
  (dk-have! (ibk-ptw r (lambda (y) (list 'IN (list lr y) 'RR-POS-STAR)))
    (lambda ()
      (let* ((y (dk-di-var!)) (lv (igl-lev-of 's y)))
        (igl-range-real! y 's)
        (fact 'measurable-fn-level-set 'omega 'cA 's y)
        (igl-mu-typed! lv)
        (dk-have! (list 'AND (list 'IN y 'RR-POS-STAR) (list 'IN (list 'mu lv) 'RR-POS-STAR)))
        (fact 'etimes-closed y (list 'mu lv))
        (fact 'membership-implies-sethood (list 'etimes y (list 'mu lv)) 'RR-POS-STAR)
        (dk-lam-b!)
        (dk-ass!))))
  (dk-have! (ibk-ptw r (lambda (y) (list '= (list gc y) (list 'etimes 'c (list lr y)))))
    (lambda ()
      (let* ((y (dk-di-var!)) (lv (igl-lev-of 's y)) (m (list 'mu lv)))
        (inst+ (ibk-ptw r (lambda (q) (list '= (list gc q) (list 'etimes (list hc q) (list 'mu (fbr q)))))) y)
        (y-facts! y)
        (dk-apply! hcv y)
        (fact 'measurable-fn-level-set 'omega 'cA 's y)
        (igl-mu-typed! lv)
        (dk-have! (list 'AND (list 'IN y 'RR-POS-STAR) (list 'IN m 'RR-POS-STAR)))
        (fact 'etimes-closed y m)
        (fact 'membership-implies-sethood (list 'etimes y m) 'RR-POS-STAR)
        (fact 'etimes-assoc-real 'c y m)
        (dk-lam-b!)
        (subst (list '= (list gc y) (list 'etimes (list hc y) m)))
        (subst (list '== (list hc y) (list '* 'c y)))
        (subst (list '= (list 'etimes 'c (list 'etimes y m)) (list 'etimes (list '* 'c y) m)))
        (dk-have! (list 'AND (list 'IN (list '* 'c y) 'RR-POS-STAR) (list 'IN m 'RR-POS-STAR))
          (lambda () (ibk-rps! (list '* 'c y)) (igl-conj-close! dk-ass!)))
        (fact 'etimes-closed (list '* 'c y) m)
        (rfl))))
  (fact 'rps-finsum-scale-ptwise 'c r lr gc)
  (fact 'simple-integral-unfold 'omega 'mu 's)
  (ibk-rps-typed! r lr)
  (dk-have! (list 'AND '(IN c RR-POS-STAR) (list 'IN (igl-fs lr r) 'RR-POS-STAR)))
  (fact 'etimes-closed 'c (igl-fs lr r))
  (subst (list '= (list 'SIMPLE-INTEGRAL 'omega 'mu u) (igl-fs gc r)))
  (subst (list '= (igl-fs gc r) (list 'etimes 'c (igl-fs lr r))))
  (subst (list '== '(SIMPLE-INTEGRAL omega mu s) (igl-fs lr r)))
  (rfl))
(qed 'simple-integral-homogeneous)
(topic! 'simple-integral-homogeneous 'analysis)

;;; =====================================================================
;;; (F9) A SCALED SIMPLE FUNCTION IS SIMPLE.
;;;   measurable-fn-finite-range: a [0,+inf]-valued function with finite range
;;;     and measurable level sets is measurable (each tail is the preimage of a
;;;     finite set of values: sigma-algebra-preimage-finite-in).
;;;   simple-fn-scale: c * s is simple for a simple s and a real c >= 0.
;;; =====================================================================

(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL u
        (IMPLIES (IS-SIGMA-ALGEBRA omega cA)
          (IMPLIES (IN u (FUN omega RR-POS-STAR))
            (IMPLIES (IN (CARD (IMAGE u omega)) NN)
              (IMPLIES (FORALL z_ (IMPLIES (IN z_ (IMAGE u omega))
                         (IN (SEP fx_ omega (= (u fx_) z_)) cA)))
                (IS-MEASURABLE-FN omega cA u))))))))))
(dk-peel!)
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(fact 'image-set 'u 'omega)
(let ((r '(IMAGE u omega))
      (fm '(FORALL z_ (IMPLIES (IN z_ (IMAGE u omega)) (IN (SEP fx_ omega (= (u fx_) z_)) cA)))))
  (mac 'IS-MEASURABLE-FN)
  (igl-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal))
          (ass)
          (let* ((al (dk-di-var!))
                 (ks (list 'SEP 'gy_ r (list '< al 'gy_)))
                 (tl (list 'SEP 'x_ 'omega (list '< al '(u x_))))
                 (pre (list 'SEP 'fx_ 'omega (list 'IN '(u fx_) ks))))
            (ibk-fin-sub! r ks (lambda (w) (sep-me (list 'IN w ks)) (dk-ass!)))
            (dk-have! (ibk-ptw ks (lambda (z) (list 'IN (list 'SEP 'fx_ 'omega (list '= '(u fx_) z)) 'cA)))
              (lambda ()
                (let ((w (dk-di-var!)))
                  (sep-me (list 'IN w ks))
                  (inst+ fm w)
                  (dk-ass!))))
            (fact 'sigma-algebra-preimage-finite-in 'omega 'cA ks 'u)
            (ibk-set-eq! tl pre
              (lambda (w)
                (sep-me (list 'IN w tl))
                (fact 'fun-apply-type-c 'u 'omega 'RR-POS-STAR w)
                (dk-have! (list 'IN (list 'u w) r)
                  (lambda ()
                    (dk-image-goal!) (ew w)
                    (igl-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))
                (ibk-sep-in! (lambda () (if (dk-asm? (dk-goal)) (ass) (ibk-sep-in! (lambda () (dk-ass!)))))))
              (lambda (w)
                (sep-me (list 'IN w pre))
                (sep-me (list 'IN (list 'u w) ks))
                (ibk-sep-in! (lambda () (dk-ass!)))))
            (subst (list '= tl pre))
            (dk-ass!))))))
(qed 'measurable-fn-finite-range)
(topic! 'measurable-fn-finite-range 'analysis)

(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL s (FORALL c
        (IMPLIES (IS-SIGMA-ALGEBRA omega cA)
          (IMPLIES (IS-SIMPLE-FN omega cA s)
            (IMPLIES (IN c RR) (IMPLIES (<= 0 c)
              (IS-SIMPLE-FN omega cA (PTWISE-SCALE omega c s))))))))))))
(dk-peel!)
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(igl-simple-parts! 'omega 'cA 's)
(igl-mfn-parts! 'omega 'cA 's)
(fact 'image-set 's 'omega)
(ibk-rps! 'c)
(let* ((r   '(IMAGE s omega))
       (u   '(PTWISE-SCALE omega c s))
       (ru  (list 'IMAGE u 'omega))
       (y-facts! (lambda (y) (igl-range-real! y 's) (ibk-mul-nonneg! 'c y)))
       (hce (ibk-abstract! r 'RR (lambda (y) (list '* 'c y))
              (lambda (y) (y-facts! y) (dk-ass!))
              (lambda (y) (y-facts! y) (fact 'membership-implies-sethood (list '* 'c y) 'RR))))
       (hc (car hce)) (hcv (cdr hce))
       (hr (list 'IMAGE hc r))
       ;; at x in omega: (= (u x) (* c (s x))), (= (u x) (hc (s x))), u x real >= 0
       (at! (lambda (x)
              (inst+ (igl-real-ptw 's) x)
              (fact 'fun-apply-type-c 's 'omega 'RR-POS-STAR x)
              (fact 'rr-pos-star-nonneg (list 's x))
              (igl-ptw-scale-at! 'c 's x)
              (ibk-mul-nonneg! 'c (list 's x))
              (dk-have! (list '= (list u x) (list '* 'c (list 's x)))
                (lambda ()
                  (subst (list '= (list u x) (list 'etimes 'c (list 's x))))
                  (ibk-etimes-real! 'c (list 's x))
                  (rfl)))
              (dk-have! (list 'IN (list 's x) r)
                (lambda () (dk-image-goal!) (ew x)
                  (igl-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))
              (dk-apply! hcv (list 's x))
              (dk-have! (list '= (list u x) (list hc (list 's x)))
                (lambda ()
                  (subst (list '== (list hc (list 's x)) (list '* 'c (list 's x))))
                  (dk-ass!))))))
  ;; u is a [0,+inf]-valued function on omega
  (dk-have! (list 'IN u '(FUN omega RR-POS-STAR))
    (lambda ()
      (mac 'PTWISE-SCALE)
      (dk-lam-type!
        (lambda ()
          (let ((x (dk-di-var!)))
            (fact 'fun-apply-type-c 's 'omega 'RR-POS-STAR x)
            (dk-have! (list 'AND '(IN c RR-POS-STAR) (list 'IN (list 's x) 'RR-POS-STAR)))
            (fact 'etimes-closed 'c (list 's x))
            (dk-ass!))))))
  ;; its values are real
  (dk-have! (ibk-ptw 'omega (lambda (z) (list 'IN (list u z) 'RR)))
    (lambda ()
      (let ((x (dk-di-var!)))
        (at! x)
        (subst (list '= (list u x) (list '* 'c (list 's x))))
        (dk-ass!))))
  ;; its range lies in hc(s(omega)), which is finite
  (fact 'image-set u 'omega)
  (fact 'image-set hc r)
  (fact 'card-image-finite hc r)
  (ibk-fin-sub! hr ru
    (lambda (w)
      (let* ((ex (dk-image-hyp! (list 'IN w ru)))
             (x  (dk-skolem! ex)))
        (at! x)
        (dk-image-goal!)
        (ew (list 's x))
        (igl-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal))
                (ass)
                (begin
                  (subst (list '= (list hc (list 's x)) (list u x)))
                  (dk-ass!))))))))
  ;; its level sets are preimages under s of finite sets of values
  (dk-have! (ibk-ptw ru (lambda (y) (list 'IN (list 'SEP 'fx_ 'omega (list '= (list u 'fx_) y)) 'cA)))
    (lambda ()
      (let* ((y   (dk-di-var!))
             (lv  (list 'SEP 'fx_ 'omega (list '= (list u 'fx_) y)))
             (ks  (list 'SEP 'gz_ r (list '= (list hc 'gz_) y)))
             (pre (list 'SEP 'fx_ 'omega (list 'IN '(s fx_) ks))))
        (ibk-fin-sub! r ks (lambda (w) (sep-me (list 'IN w ks)) (dk-ass!)))
        (dk-have! (ibk-ptw ks (lambda (z) (list 'IN (list 'SEP 'fx_ 'omega (list '= '(s fx_) z)) 'cA)))
          (lambda ()
            (let ((w (dk-di-var!)))
              (sep-me (list 'IN w ks))
              (igl-range-real! w 's)
              (fact 'measurable-fn-level-set 'omega 'cA 's w)
              (dk-ass!))))
        (fact 'sigma-algebra-preimage-finite-in 'omega 'cA ks 's)
        (ibk-set-eq! lv pre
          (lambda (w)
            (sep-me (list 'IN w lv))
            (at! w)
            (ibk-sep-in!
              (lambda ()
                (if (dk-asm? (dk-goal))
                    (ass)
                    (ibk-sep-in!
                      (lambda ()
                        (if (dk-asm? (dk-goal))
                            (ass)
                            (begin (subst (list '= (list hc (list 's w)) (list u w))) (dk-ass!)))))))))
          (lambda (w)
            (sep-me (list 'IN w pre))
            (sep-me (list 'IN (list 's w) ks))
            (at! w)
            (ibk-sep-in!
              (lambda ()
                (if (dk-asm? (dk-goal))
                    (ass)
                    (begin (subst (list '= (list u w) (list hc (list 's w)))) (dk-ass!)))))))
        (subst (list '= lv pre))
        (dk-ass!))))
  (fact 'measurable-fn-finite-range 'omega 'cA u)
  (mac 'IS-SIMPLE-FN)
  (igl-conj-close! dk-ass!))
(qed 'simple-fn-scale)
(topic! 'simple-fn-scale 'analysis)

;;; =====================================================================
;;; (F10) integral-homogeneous (was a support, Thayer Thm. 2.7(5); Rudin
;;;      Prop. 1.24(c)).  c = 0: every simple s below 0 * f is 0, so both
;;;      sides are 0.  c > 0: scaling by c and by 1/c moves simple functions
;;;      below f to simple functions below c f and back (simple-fn-scale,
;;;      simple-integral-homogeneous), which gives the two inequalities.
;;; =====================================================================

;;; (IN (INTEGRAL omega cA mu fv) RR-POS-STAR) off the definition; returns the
;;; set X with INTEGRAL == ESUP X
(define (igl-integral-typed! fv)
  (let* ((iu (dk-cite! 'integral-unfold 'omega 'cA 'mu fv))
         (x  (cadr (caddr iu)))
         (iv (list 'INTEGRAL 'omega 'cA 'mu fv)))
    (igl-sep-subset! x)
    (fact 'esup-in x)
    (dk-have! (list 'IN iv 'RR-POS-STAR)
      (lambda () (subst (list '== iv (list 'ESUP x))) (dk-ass!)))
    x))

;;; x in X (an integral's set): land the simple witness sv, its parts, and
;;; (= x (SIMPLE-INTEGRAL omega mu sv)); returns sv
(define (igl-open-member! w x)
  (let* ((ls (dk-landed (lambda () (sep-me (list 'IN w x)))))
         (e  (car (filter (lambda (f) (dk-head-is? f 'FORSOME)) ls)))
         (sv (dk-skolem! e)))
    (igl-simple-parts! 'omega 'cA sv)
    (igl-mfn-parts! 'omega 'cA sv)
    sv))

;;; (IN (SIMPLE-INTEGRAL omega mu sv) X) for X the set of fv, sv simple and
;;; PTWISE-LE(omega, sv, fv) in context
(define (igl-member! sv x)
  (fact 'simple-integral-in 'omega 'cA 'mu sv)
  (dk-have! (list 'IN (list 'SIMPLE-INTEGRAL 'omega 'mu sv) x)
    (lambda ()
      (ibk-sep-in!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (begin (ew sv) (igl-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))))))))))

;;; PTWISE-LE(omega, (PTWISE-SCALE omega c sv), (PTWISE-SCALE omega c fv)) from
;;; PTWISE-LE(omega, sv, fv), c real >= 0
(define (igl-scale-le! cv sv fv)
  (let ((le (dk-project! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ omega)
                                                (list '<= (list sv 'x_) (list fv 'x_))))
                         'PTWISE-LE (list 'PTWISE-LE 'omega sv fv)))
        (cs (list 'PTWISE-SCALE 'omega cv sv))
        (cf (list 'PTWISE-SCALE 'omega cv fv)))
    (dk-have! (list 'PTWISE-LE 'omega cs cf)
      (lambda ()
        (mac 'PTWISE-LE)
        (let ((w (dk-di-var!)))
          (inst+ le w)
          (igl-ptw-scale-at! cv sv w)
          (igl-ptw-scale-at! cv fv w)
          (dk-have! (list 'AND (list 'IN (list sv w) 'RR-POS-STAR) (list 'IN (list fv w) 'RR-POS-STAR)))
          (fact 'etimes-mono-left cv (list sv w) (list fv w))
          (subst (list '= (list cs w) (list 'etimes cv (list sv w))))
          (subst (list '= (list cf w) (list 'etimes cv (list fv w))))
          (dk-ass!))))))

(sp (make-wff
     '(FORALL omega (FORALL cA (FORALL mu (FORALL f (FORALL c
        (IMPLIES (IS-MEASURE omega cA mu)
          (IMPLIES (IS-MEASURABLE-FN omega cA f)
            (IMPLIES (IN c RR)
              (IMPLIES (<= 0 c)
                (= (INTEGRAL omega cA mu (PTWISE-SCALE omega c f))
                   (etimes c (INTEGRAL omega cA mu f))))))))))))))
(dk-peel!)
(igl-measure-parts! 'omega 'cA 'mu)
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(igl-mfn-parts! 'omega 'cA 'f)
(ibk-rps-setup!)
(ibk-rps! 'c)
(fact 'zero-in-rr-pos-star)
(let* ((cf  '(PTWISE-SCALE omega c f))
       (iv  '(INTEGRAL omega cA mu f))
       (jv  (list 'INTEGRAL 'omega 'cA 'mu cf))
       (ci  (list 'etimes 'c iv))
       (xf  (igl-integral-typed! 'f))
       (xc  (igl-integral-typed! cf)))
  (dk-have! (list 'AND '(IN c RR-POS-STAR) (list 'IN iv 'RR-POS-STAR)))
  (fact 'etimes-closed 'c iv)
  (use-em '(= c 0)
    ;; ---------------- c = 0: both sides are 0
    (lambda ()
      (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x xc) (list '<= 'x 0)))
        (lambda ()
          (let* ((w  (dk-di-var!))
                 (sv (igl-open-member! w xc))
                 (r  (list 'IMAGE sv 'omega))
                 (lr (igl-lam-of sv r))
                 (si (list 'SIMPLE-INTEGRAL 'omega 'mu sv))
                 (le (dk-project! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ omega)
                                                         (list '<= (list sv 'x_) (list cf 'x_))))
                                  'PTWISE-LE (list 'PTWISE-LE 'omega sv cf))))
            (fact 'image-set sv 'omega)
            (dk-have! (ibk-ptw r (lambda (y) (list '= (list lr y) '(IDEN RR-POS-STAR-ADD-MONOID))))
              (lambda ()
                (let* ((y  (dk-di-var!))
                       (lv (igl-lev-of sv y)))
                  (igl-range-real! y sv)
                  ;; y = 0: y = s(x0) <= (0 * f)(x0) = 0
                  (dk-have! (list '= y 0)
                    (lambda ()
                      (let* ((ex (dk-image-hyp! (list 'IN y r)))
                             (x0 (dk-skolem! ex)))
                        (inst+ le x0)
                        (igl-ptw-scale-at! 'c 'f x0)
                        (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR x0)
                        (fact 'fun-apply-type-c sv 'omega 'RR-POS-STAR x0)
                        (fact 'rr-pos-star-nonneg (list sv x0))
                        (dk-have! (list '<= (list sv x0) 0)
                          (lambda ()
                            (fact 'etimes-zero-left (list 'f x0))
                            (dk-have! (list '= (list cf x0) 0)
                              (lambda ()
                                (subst (list '= (list cf x0) (list 'etimes 'c (list 'f x0))))
                                (subst '(= c 0))
                                (dk-ass!)))
                            (subst (list '= 0 (list cf x0)))
                            (dk-ass!)))
                        (dk-have! (list 'AND (list 'IN (list sv x0) 'RR-POS-STAR) '(IN 0 RR-POS-STAR)))
                        (dk-have! (list 'AND (list '<= (list sv x0) 0) (list '<= 0 (list sv x0))))
                        (fact 'rr-pos-star-le-antisymm (list sv x0) 0)
                        (subst (list '= y (list sv x0)))
                        (dk-ass!))))
                  (fact 'measurable-fn-level-set 'omega 'cA sv y)
                  (igl-mu-typed! lv)
                  (dk-have! (list 'AND (list 'IN y 'RR-POS-STAR) (list 'IN (list 'mu lv) 'RR-POS-STAR)))
                  (fact 'etimes-closed y (list 'mu lv))
                  (fact 'membership-implies-sethood (list 'etimes y (list 'mu lv)) 'RR-POS-STAR)
                  (dk-lam-b!)
                  (subst ibk-iden-eq)
                  (let ((mv (dk-name! (list 'mu lv) 'RR-POS-STAR)))
                    (subst (list '= (list 'mu lv) mv))
                    (subst (list '= y 0))
                    (fact 'etimes-zero-left mv)
                    (dk-ass!)))))
            (fact 'finsum-cm-all-iden-ptwise igl-m r lr)
            (fact 'simple-integral-unfold 'omega 'mu sv)
            (dk-have! (list '= si 0)
              (lambda ()
                (subst (list '== si (igl-fs lr r)))
                (subst (list '= (igl-fs lr r) '(IDEN RR-POS-STAR-ADD-MONOID)))
                (subst ibk-iden-eq)
                (rfl)))
            (subst (list '= w si))
            (subst (list '= si 0))
            (dk-have! '(<= 0 0) (lambda () (arith)))
            (dk-ass!))))
      (dk-have! (list 'AND '(IN 0 RR-POS-STAR)
                      (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x xc) (list '<= 'x 0)))))
      (fact 'esup-least xc 0)
      (fact 'rr-pos-star-nonneg jv)
      (dk-have! (list '<= jv 0)
        (lambda () (subst (list '== jv (list 'ESUP xc))) (dk-ass!)))
      (dk-have! (list 'AND (list 'IN jv 'RR-POS-STAR) '(IN 0 RR-POS-STAR)))
      (dk-have! (list 'AND (list '<= jv 0) (list '<= 0 jv)))
      (fact 'rr-pos-star-le-antisymm jv 0)
      (dk-have! (list '= ci 0)
        (lambda () (subst '(= c 0)) (fact 'etimes-zero-left iv) (dk-ass!)))
      (subst (list '= jv 0))
      (subst (list '= ci 0))
      (rfl))
    ;; ---------------- c > 0: scale by c and by 1/c
    (lambda ()
      (let* ((d '(recip c)))
        (ibk-pos! 'c)
        (dk-have! '(AND (IN c RR) (NOT (= c 0))))
        (fact 'rr-recip-closed 'c)
        (fact 'rr-recip-pos 'c)
        (fact 'rr-recip-inverse 'c)
        (dk-have! (list '<= 0 d) (lambda () (dk-ineq! (list 'IN d 'RR) (list '< 0 d))))
        (ibk-rps! d)
        (dk-have! (list 'AND '(IN c RR) (list 'IN d 'RR)))
        (fact 'rr-mul-comm 'c d)
        (let ((cancel!                  ; (= (etimes d (etimes c v)) v) and the c-d one
                (lambda (v)
                  (fact 'etimes-assoc-real d 'c v)
                  (fact 'etimes-assoc-real 'c d v)
                  (fact 'etimes-one-left v)
                  (dk-have! (list '= (list 'etimes d (list 'etimes 'c v)) v)
                    (lambda ()
                      (subst (list '= (list 'etimes d (list 'etimes 'c v)) (list 'etimes (list '* d 'c) v)))
                      (subst (list '= (list '* d 'c) (list '* 'c d)))
                      (subst (list '= (list '* 'c d) 1))
                      (dk-ass!)))
                  (dk-have! (list '= (list 'etimes 'c (list 'etimes d v)) v)
                    (lambda ()
                      (subst (list '= (list 'etimes 'c (list 'etimes d v)) (list 'etimes (list '* 'c d) v)))
                      (subst (list '= (list '* 'c d) 1))
                      (dk-ass!))))))
          ;; (A) J <= c I: each simple s' <= c f is c times the simple (1/c) s' <= f
          (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x xc) (list '<= 'x ci)))
            (lambda ()
              (let* ((w   (dk-di-var!))
                     (sp1 (igl-open-member! w xc))
                     (sv  (list 'PTWISE-SCALE 'omega d sp1))
                     (csv (list 'PTWISE-SCALE 'omega 'c sv))
                     (lec (dk-project! (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ omega)
                                                              (list '<= (list sp1 'x_) (list cf 'x_))))
                                       'PTWISE-LE (list 'PTWISE-LE 'omega sp1 cf))))
                (fact 'simple-fn-scale 'omega 'cA sp1 d)
                (igl-simple-parts! 'omega 'cA sv)
                (igl-mfn-parts! 'omega 'cA sv)
                (fact 'simple-fn-scale 'omega 'cA sv 'c)
                (igl-simple-parts! 'omega 'cA csv)
                (igl-mfn-parts! 'omega 'cA csv)
                ;; (1/c) s' <= f
                (dk-have! (list 'PTWISE-LE 'omega sv 'f)
                  (lambda ()
                    (mac 'PTWISE-LE)
                    (let ((v (dk-di-var!)))
                      (inst+ lec v)
                      (igl-ptw-scale-at! d sp1 v)
                      (igl-ptw-scale-at! 'c 'f v)
                      (fact 'fun-apply-type-c 'f 'omega 'RR-POS-STAR v)
                      (dk-have! (list 'AND '(IN c RR-POS-STAR) (list 'IN (list 'f v) 'RR-POS-STAR)))
                      (fact 'etimes-closed 'c (list 'f v))
                      (dk-have! (list 'AND (list 'IN (list sp1 v) 'RR-POS-STAR)
                                      (list 'IN (list 'etimes 'c (list 'f v)) 'RR-POS-STAR)))
                      (dk-have! (list '<= (list sp1 v) (list 'etimes 'c (list 'f v)))
                        (lambda () (subst (list '= (list 'etimes 'c (list 'f v)) (list cf v))) (dk-ass!)))
                      (fact 'etimes-mono-left d (list sp1 v) (list 'etimes 'c (list 'f v)))
                      (cancel! (list 'f v))
                      (subst (list '= (list sv v) (list 'etimes d (list sp1 v))))
                      (subst (list '= (list 'f v) (list 'etimes d (list 'etimes 'c (list 'f v)))))
                      (dk-ass!))))
                ;; c ((1/c) s') = s'
                (dk-fun-ext! csv sp1 'omega 'RR-POS-STAR #f #f
                  (lambda (v)
                    (igl-ptw-scale-at! 'c sv v)
                    (igl-ptw-scale-at! d sp1 v)
                    (fact 'fun-apply-type-c sp1 'omega 'RR-POS-STAR v)
                    (cancel! (list sp1 v))
                    (subst (list '= (list csv v) (list 'etimes 'c (list sv v))))
                    (subst (list '= (list sv v) (list 'etimes d (list sp1 v))))
                    (subst (list '= (list 'etimes 'c (list 'etimes d (list sp1 v))) (list sp1 v)))
                    (rfl)))
                (fact 'simple-integral-homogeneous 'omega 'cA 'mu sv 'c)
                (igl-member! sv xf)
                (fact 'esup-upper xf (list 'SIMPLE-INTEGRAL 'omega 'mu sv))
                (dk-have! (list '<= (list 'SIMPLE-INTEGRAL 'omega 'mu sv) iv)
                  (lambda () (subst (list '== iv (list 'ESUP xf))) (dk-ass!)))
                (fact 'simple-integral-in 'omega 'cA 'mu sv)
                (dk-have! (list 'AND (list 'IN (list 'SIMPLE-INTEGRAL 'omega 'mu sv) 'RR-POS-STAR)
                                (list 'IN iv 'RR-POS-STAR)))
                (fact 'etimes-mono-left 'c (list 'SIMPLE-INTEGRAL 'omega 'mu sv) iv)
                (subst (list '= w (list 'SIMPLE-INTEGRAL 'omega 'mu sp1)))
                (subst (list '= sp1 csv))
                (subst (list '= (list 'SIMPLE-INTEGRAL 'omega 'mu csv)
                             (list 'etimes 'c (list 'SIMPLE-INTEGRAL 'omega 'mu sv))))
                (dk-ass!))))
          (dk-have! (list 'AND (list 'IN ci 'RR-POS-STAR)
                          (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x xc) (list '<= 'x ci)))))
          (fact 'esup-least xc ci)
          (dk-have! (list '<= jv ci)
            (lambda () (subst (list '== jv (list 'ESUP xc))) (dk-ass!)))
          ;; (B) c I <= J: each simple s <= f gives the simple c s <= c f
          (dk-have! (list 'AND (list 'IN d 'RR-POS-STAR) (list 'IN jv 'RR-POS-STAR)))
          (fact 'etimes-closed d jv)
          (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x xf) (list '<= 'x (list 'etimes d jv))))
            (lambda ()
              (let* ((w   (dk-di-var!))
                     (sv  (igl-open-member! w xf))
                     (csv (list 'PTWISE-SCALE 'omega 'c sv))
                     (si  (list 'SIMPLE-INTEGRAL 'omega 'mu sv))
                     (csi (list 'SIMPLE-INTEGRAL 'omega 'mu csv)))
                (fact 'simple-fn-scale 'omega 'cA sv 'c)
                (igl-simple-parts! 'omega 'cA csv)
                (igl-mfn-parts! 'omega 'cA csv)
                (igl-scale-le! 'c sv 'f)
                (igl-member! csv xc)
                (fact 'esup-upper xc csi)
                (dk-have! (list '<= csi jv)
                  (lambda () (subst (list '== jv (list 'ESUP xc))) (dk-ass!)))
                (fact 'simple-integral-homogeneous 'omega 'cA 'mu sv 'c)
                (fact 'simple-integral-in 'omega 'cA 'mu sv)
                (dk-have! (list 'AND '(IN c RR-POS-STAR) (list 'IN si 'RR-POS-STAR)))
                (fact 'etimes-closed 'c si)
                (dk-have! (list 'AND (list 'IN (list 'etimes 'c si) 'RR-POS-STAR) (list 'IN jv 'RR-POS-STAR)))
                (dk-have! (list '<= (list 'etimes 'c si) jv)
                  (lambda () (subst (list '= (list 'etimes 'c si) csi)) (dk-ass!)))
                (fact 'etimes-mono-left d (list 'etimes 'c si) jv)
                (cancel! si)
                (subst (list '= w si))
                (subst (list '= si (list 'etimes d (list 'etimes 'c si))))
                (dk-ass!))))
          (dk-have! (list 'AND (list 'IN (list 'etimes d jv) 'RR-POS-STAR)
                          (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x xf) (list '<= 'x (list 'etimes d jv))))))
          (fact 'esup-least xf (list 'etimes d jv))
          (dk-have! (list '<= iv (list 'etimes d jv))
            (lambda () (subst (list '== iv (list 'ESUP xf))) (dk-ass!)))
          (dk-have! (list 'AND (list 'IN iv 'RR-POS-STAR) (list 'IN (list 'etimes d jv) 'RR-POS-STAR)))
          (fact 'etimes-mono-left 'c iv (list 'etimes d jv))
          (cancel! jv)
          (dk-have! (list '<= ci jv)
            (lambda () (subst (list '= jv (list 'etimes 'c (list 'etimes d jv)))) (dk-ass!)))
          ;; antisymmetry
          (dk-have! (list 'AND (list 'IN jv 'RR-POS-STAR) (list 'IN ci 'RR-POS-STAR)))
          (dk-have! (list 'AND (list '<= jv ci) (list '<= ci jv)))
          (fact 'rr-pos-star-le-antisymm jv ci)
          (dk-ass!))))))
(qed 'integral-homogeneous)
(topic! 'integral-homogeneous 'analysis)
(gloss! 'integral-homogeneous
  "Positive homogeneity for a REAL scalar c >= 0 (Thayer Thm. 2.7(5), p. 10;
   Rudin Prop. 1.24(c), p. 20).  c = 0: both sides are 0.  c > 0: scaling by c and
   by 1/c carries the simple functions below f onto those below c f
   (simple-fn-scale, simple-integral-homogeneous).")

