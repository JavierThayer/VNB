;;; replace each class variable v (v in QUOTIENT S in context, v free in the goal) by CLASS S w
(define (ipq-reps!)
  (for-each
    (lambda (f)
      (if (and (dk-head-is? f 'IN) (symbol? (cadr f)) (equal? (caddr f) (list 'QUOTIENT ipq-S))
               (ipq-has-sub? (cadr f) (dk-goal)))
          (let* ((v (cadr f))
                 (ex (dk-cite! 'quotient-rep ipq-S v))
                 (w (dk-skolem! ex)))
            (ipq-pts! w)
            (subst (list '= v (ipq-cl w))))))
    (dk-asms)))
;;; compute the quotient operations and the induced form on classes, innermost first
(define (ipq-find-q e)
  (cond ((not (pair? e)) #f)
        ((let l2 ((l (cdr e))) (cond ((not (pair? l)) #f) ((ipq-find-q (car l)) => (lambda (x) x)) (#t (l2 (cdr l))))) => (lambda (x) x))
        ((and (equal? (car e) (list 'VADD ipq-Q)) (= (length e) 3) (dk-head-is? (cadr e) 'CLASS) (dk-head-is? (caddr e) 'CLASS)) e)
        ((and (equal? (car e) (list 'ACT ipq-Q)) (= (length e) 3) (dk-head-is? (caddr e) 'CLASS)) e)
        ((and (equal? (car e) ipq-G) (= (length e) 3) (dk-head-is? (cadr e) 'CLASS) (dk-head-is? (caddr e) 'CLASS)) e)
        (#t #f)))
(define (ipq-compute-q!)
  (let loop ((fuel 30))
    (let ((r (and (ipq-open?) (ipq-find-q (dk-goal)))))
      (if (and r (> fuel 0))
          (let ((u (if (dk-head-is? (cadr r) 'CLASS) (caddr (cadr r)) #f)) (v (caddr (caddr r))))
            (cond ((equal? (car r) (list 'VADD ipq-Q))
                   (ipq-vt! u) (ipq-vt! v) (subst (dk-cite! 'qmod-vadd-computes 'md ipq-N u v)))
                  ((equal? (car r) (list 'ACT ipq-Q))
                   (let* ((a (cadr r)) (g (list 'IN a '(CARR (SCAL md)))))
                     (ipq-ct! a)
                     (if (not (dk-asm? g)) (dk-have! g (lambda () (subst '(= (CARR (SCAL md)) CC)) (ass))))
                     (ipq-vt! v)
                     (subst (dk-cite! 'qmod-act-computes 'md ipq-N a v))))
                  (#t (ipq-vt! u) (ipq-vt! v) (subst (dk-cite! 'form-qip-computes 'md 'fq u v))))
            (loop (- fuel 1)))))))
;;; the module-level law that the goal has become
(define (ipq-md-law!)
  (let ((g (dk-goal)))
    (cond
      ((dk-asm? g) (ass))
      ((and (dk-head-is? g '=) (pair? (cadr g)) (eq? (car (cadr g)) 'fq) (ipq-op? (cadr (cadr g)) 'VADD))
       (let ((l (cadr g))) (ipq-vt! (cadr (cadr l))) (ipq-vt! (caddr (cadr l))) (ipq-vt! (caddr l))
         (dk-cite! 'herm-form-add-left 'md 'fq (cadr (cadr l)) (caddr (cadr l)) (caddr l)) (dk-close-if-asm!)))
      ((and (dk-head-is? g '=) (pair? (cadr g)) (eq? (car (cadr g)) 'fq) (ipq-op? (cadr (cadr g)) 'ACT))
       (let ((l (cadr g))) (ipq-ct! (cadr (cadr l))) (ipq-vt! (caddr (cadr l))) (ipq-vt! (caddr l))
         (dk-cite! 'herm-form-homog-left 'md 'fq (cadr (cadr l)) (caddr (cadr l)) (caddr l)) (dk-close-if-asm!)))
      ((and (dk-head-is? g '=) (dk-head-is? (caddr g) 'conjugate))
       (let ((l (cadr g))) (dk-cite! 'herm-form-conj-sym 'md 'fq (caddr l) (cadr l)) (dk-close-if-asm!)))
      ((and (dk-head-is? g 'IN) (eq? (caddr g) 'RR))
       (dk-cite! 'psd-form-real 'md 'fq (cadr (cadr g))) (dk-close-if-asm!))
      ((dk-head-is? g '<=)
       (dk-cite! 'psd-form-nonneg 'md 'fq (cadr (caddr g))) (dk-close-if-asm!))
      ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'CLASS) (dk-head-is? (caddr g) 'CLASS))
       ;; definiteness: [u] = [0] from fq(u, u) = 0
       (let* ((u (caddr (cadr g))) (z (caddr (caddr g)))
              (d (list '(VADD md) u (list '(VNEG md) z))))
         (ipq-vt! u) (ipq-vt! z) (ipq-vt! d)
         (dk-cite! 'psd-form-zero 'md 'fq)
         (dk-have! (list '= (list 'fq d d) 0)
           (lambda ()
             (ipq-expand!)
             (ipq-null-zero! (list u z))
             (if (ipq-open?) (ipq-type-scalars! (dk-goal)))
             (if (ipq-open?) (crs))))
         (dk-cite! 'form-null-in 'md 'fq d)
         (let ((iff (dk-cite! 'qmod-class-eq-iff 'md ipq-N u z)))
           (ai iff)
           (detach! (list 'IMPLIES (caddr iff) (cadr iff))))
         (dk-close-if-asm!)))
      (#t (error "ipq-md-law!: unexpected goal" (expression->string g))))))

;;; a hypothesis G(v, v) = 0 with v a class variable: rewrite v to its representative's class, then compute
(define (ipq-hyp-q!)
  (for-each
    (lambda (h)
      (if (and (dk-head-is? h '=) (pair? (cadr h)) (equal? (car (cadr h)) ipq-G) (= (length (cadr h)) 3))
          (let* ((p (cadr (cadr h)))
                 (eqn (and (symbol? p)
                           (find-first (lambda (f) (and (dk-head-is? f '=) (eq? (cadr f) p) (dk-head-is? (caddr f) 'CLASS))) (dk-asms))))
                 (h2 (if eqn (dk-rewrite-h! h p (caddr eqn)) h))
                 (r (cadr h2)))
            (if (dk-head-is? (cadr r) 'CLASS)
                (let ((u (caddr (cadr r))) (v (caddr (caddr r))))
                  (ipq-vt! u) (ipq-vt! v)
                  (dk-cite! 'form-qip-computes 'md 'fq u v)
                  (dk-rewrite-h! h2 r (list 'fq u v)))))))
    (dk-asms)))

(sp (make-wff (ipq-stmt '() ipq-HP '() (list 'IS-INNER-PRODUCT-FORM ipq-Q ipq-G))))
(dk-peel!)
(ipq-qsetup!)
(dk-cite! 'form-qip-type 'md 'fq)
(mac 'IS-INNER-PRODUCT-FORM) (mac 'IS-PSD-FORM) (mac 'IS-HERMITIAN-FORM)
(subst (list '= (list 'VEC ipq-Q) (list 'QUOTIENT ipq-S)))
(subst (list '= (list 'VZERO ipq-Q) (ipq-cl '(VZERO md))))
(dk-conj-close!
  (lambda ()
    (if (ipq-open?)
        (let ((g (dk-goal)))
          (cond ((dk-asm? g) (ass))
                ((dk-head-is? g 'FORALL)
                 (dk-peel!)
                 (ipq-reps!)
                 (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
                 (ipq-hyp-q!)
                 (ipq-compute-q!)
                 (if (ipq-open?) (ipq-md-law!)))
                (#t (error "form-quotient-ipf: unexpected conjunct" (expression->string g))))))))
(ipq-qed! 'form-quotient-inner-product-form)

