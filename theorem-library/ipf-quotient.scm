;;; ipf-quotient.scm -- HERMITIAN FORMS ON A COMPLEX MODULE: the right-hand laws, the Cauchy-Schwarz
;;; consequence for a positive semi-definite form (a null vector is orthogonal to everything), the null
;;; space as a submodule, and THE QUOTIENT BY THE NULL SPACE AS A COMPLEX INNER PRODUCT SPACE (the
;;; pre-Hilbert step of the GNS construction).  Agent BA-1111-A2, 2026-11-11.
;;; Destination: theorem-library/ipf-quotient.scm.  Library: analysis.  Helper prefix ipq-.
;;;
;;; Standing hypotheses: md a module (IS-MODULE md) over CC (SCAL(md) = the CC ring view), fq a hermitian
;;; form (IS-HERMITIAN-FORM md fq) or a positive semi-definite one (IS-PSD-FORM md fq).
;;;
;;;   herm-form-{type,add-left,homog-left,conj-sym,value-type,add-right,homog-right}
;;;   psd-form-{hermitian,real,nonneg}
;;;   psd-form-null-orth        fq(n, n) = 0  =>  fq(n, y) = 0 for every y  (the step of Cauchy-Schwarz
;;;                             that the quotient needs, proved directly: with c = fq(n, y), B = fq(y, y),
;;;                             z = (B + 1) n - c y gives 0 <= fq(z, z) = -(B + 2) |c|^2)
;;;   psd-form-zero-left, psd-form-neg-left, psd-form-null-right
;;;   form-null-in, form-null-out, form-null-submodule, form-respects2
;;;   form-quotient-* read-offs, form-qip-computes, form-quotient-is-cips (THE THEOREM)
;;;
;;; LOAD WINDOW: after theorem-library/ipf-laws, theorem-library/la-z3-quotient (quotient-module-is-module,
;;; qmod-*), the rmod-* module laws (rmod-vneg-left, rmod-vzero-left/right, rmod-vadd-assoc), the CC
;;; conjugate and magnitude laws (cc-conjugate-*, cc-magnitude-*), rr-square-zero, rr-leq-mul-nonneg.

(define (ipq-open?) (pair? (dk-open-leaves)))
(define (ipq-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; IPQ OPEN ") (display (expression->string (dk-goal-of l))) (newline)
                  (for-each (lambda (a) (display ";;    asm ") (display (expression->string a)) (newline)) (dk-asms-of l)))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define ipq-R '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define ipq-H0 (list '(IS-MODULE md) (list '= '(SCAL md) ipq-R) '(IS-HERMITIAN-FORM md fq)))
(define ipq-HP (list '(IS-MODULE md) (list '= '(SCAL md) ipq-R) '(IS-PSD-FORM md fq)))
(define (ipq-stmt vars hyps guards concl)
  (forall-guarded (append '(md fq) vars) (append hyps guards) concl))
(define (ipq-in-vec x) (list 'IN x '(VEC md)))

;;; the laws as they land from the predicates (ipf-vocab binders)
(define ipq-law-type '(IN fq (FUN (CARTESIAN (VEC md) (VEC md)) CC)))
(define ipq-law-add
  '(FORALL ipfx_ (IMPLIES (IN ipfx_ (VEC md)) (FORALL ipfy_ (IMPLIES (IN ipfy_ (VEC md))
     (FORALL ipfz_ (IMPLIES (IN ipfz_ (VEC md))
       (= (fq ((VADD md) ipfx_ ipfy_) ipfz_) (+ (fq ipfx_ ipfz_) (fq ipfy_ ipfz_))))))))))
(define ipq-law-homog
  '(FORALL ipfa_ (IMPLIES (IN ipfa_ CC) (FORALL ipfx_ (IMPLIES (IN ipfx_ (VEC md))
     (FORALL ipfy_ (IMPLIES (IN ipfy_ (VEC md))
       (= (fq ((ACT md) ipfa_ ipfx_) ipfy_) (* ipfa_ (fq ipfx_ ipfy_))))))))))
(define ipq-law-herm
  '(FORALL ipfx_ (IMPLIES (IN ipfx_ (VEC md)) (FORALL ipfy_ (IMPLIES (IN ipfy_ (VEC md))
     (= (fq ipfy_ ipfx_) (conjugate (fq ipfx_ ipfy_))))))))
(define ipq-law-real '(FORALL ipfx_ (IMPLIES (IN ipfx_ (VEC md)) (IN (fq ipfx_ ipfx_) RR))))
(define ipq-law-nonneg '(FORALL ipfx_ (IMPLIES (IN ipfx_ (VEC md)) (<= 0 (fq ipfx_ ipfx_)))))
(define (ipq-need! f) (if (not (dk-asm? f)) (error "ipq: expected in context" (expression->string f))) f)
(define (ipq-open-herm!) (mac-h 'is-hermitian-form '(IS-HERMITIAN-FORM md fq)) (dk-split-all!))
(define (ipq-open-psd!) (mac-h 'is-psd-form '(IS-PSD-FORM md fq)) (dk-split-all!))

;;; ---- projections -----------------------------------------------------------------------------
(sp (make-wff (ipq-stmt '() ipq-H0 '() ipq-law-type)))
(dk-peel!) (ipq-open-herm!) (ass)
(ipq-qed! 'herm-form-type)
(sp (make-wff (ipq-stmt '(x_ y_ z_) ipq-H0 (map ipq-in-vec '(x_ y_ z_))
  '(= (fq ((VADD md) x_ y_) z_) (+ (fq x_ z_) (fq y_ z_))))))
(dk-peel!) (ipq-open-herm!) (dk-apply! (ipq-need! ipq-law-add) 'x_ 'y_ 'z_) (dk-close-if-asm!)
(ipq-qed! 'herm-form-add-left)
(sp (make-wff (ipq-stmt '(a_ x_ y_) ipq-H0 (cons '(IN a_ CC) (map ipq-in-vec '(x_ y_)))
  '(= (fq ((ACT md) a_ x_) y_) (* a_ (fq x_ y_))))))
(dk-peel!) (ipq-open-herm!) (dk-apply! (ipq-need! ipq-law-homog) 'a_ 'x_ 'y_) (dk-close-if-asm!)
(ipq-qed! 'herm-form-homog-left)
(sp (make-wff (ipq-stmt '(x_ y_) ipq-H0 (map ipq-in-vec '(x_ y_))
  '(= (fq y_ x_) (conjugate (fq x_ y_))))))
(dk-peel!) (ipq-open-herm!) (dk-apply! (ipq-need! ipq-law-herm) 'x_ 'y_) (dk-close-if-asm!)
(ipq-qed! 'herm-form-conj-sym)
(sp (make-wff (ipq-stmt '(x_ y_) ipq-H0 (map ipq-in-vec '(x_ y_)) '(IN (fq x_ y_) CC))))
(dk-peel!)
(dk-cite! 'herm-form-type 'md 'fq)
(dk-cite! 'pair-in-cartesian '(VEC md) '(VEC md) 'x_ 'y_)
(dk-cite! 'fun-apply-type-c 'fq '(CARTESIAN (VEC md) (VEC md)) 'CC '(LIST x_ y_))
(subst (dk-cite! 'apply-tupling-2 'fq 'x_ 'y_))
(dk-close-if-asm!)
(ipq-qed! 'herm-form-value-type)
(sp (make-wff (ipq-stmt '() ipq-HP '() '(IS-HERMITIAN-FORM md fq))))
(dk-peel!) (ipq-open-psd!) (dk-close-if-asm!)
(ipq-qed! 'psd-form-hermitian)
(sp (make-wff (ipq-stmt '(x_) ipq-HP (list (ipq-in-vec 'x_)) '(IN (fq x_ x_) RR))))
(dk-peel!) (ipq-open-psd!) (dk-apply! (ipq-need! ipq-law-real) 'x_) (dk-close-if-asm!)
(ipq-qed! 'psd-form-real)
(sp (make-wff (ipq-stmt '(x_) ipq-HP (list (ipq-in-vec 'x_)) '(<= 0 (fq x_ x_)))))
(dk-peel!) (ipq-open-psd!) (dk-apply! (ipq-need! ipq-law-nonneg) 'x_) (dk-close-if-asm!)
(ipq-qed! 'psd-form-nonneg)

;;; ---- typing ----------------------------------------------------------------------------------
(define (ipq-cscal!)                   ; (= (CARR (SCAL md)) CC)
  (let ((g '(= (CARR (SCAL md)) CC)))
    (if (not (dk-asm? g))
        (dk-have! g (lambda () (subst (list '= '(SCAL md) ipq-R)) (subst (dk-cite! 'sip-cc-ring-carr))
                               (dk-close-if! (lambda () #t) (lambda () (rfl))))))))
(define (ipq-op? e op) (and (pair? e) (equal? (car e) (list op 'md))))
(define (ipq-vt! e)                    ; land (IN e (VEC md))
  (let ((g (ipq-in-vec e)))
    (cond ((dk-asm? g) g)
          ((equal? e '(VZERO md)) (dk-cite! 'module-vzero-in 'md) g)
          ((ipq-op? e 'VADD) (ipq-vt! (cadr e)) (ipq-vt! (caddr e)) (dk-cite! 'module-vadd-type 'md (cadr e) (caddr e)) g)
          ((ipq-op? e 'VNEG) (ipq-vt! (cadr e)) (dk-cite! 'module-vneg-type 'md (cadr e)) g)
          ((ipq-op? e 'ACT)
           (ipq-ct! (cadr e)) (ipq-cscal!)
           (let ((gs (list 'IN (cadr e) '(CARR (SCAL md)))))
             (if (not (dk-asm? gs)) (dk-have! gs (lambda () (subst '(= (CARR (SCAL md)) CC)) (ass)))))
           (ipq-vt! (caddr e)) (dk-cite! 'module-act-type 'md (cadr e) (caddr e)) g)
          (#t (error "ipq-vt!: no typing for" (expression->string e))))))
(define (ipq-and! a b)
  (let ((c (list 'AND a b))) (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! dk-ass!)))) c))
(define (ipq-ct! c)                    ; land (IN c CC)
  (let ((g (list 'IN c 'CC)))
    (cond ((dk-asm? g) g)
          ((number? c) (dk-have! g (lambda () (arith))) g)
          ((dk-asm? (list 'IN c 'RR)) (dk-cite! 'rr-subset-cc c) g)
          ((and (pair? c) (eq? (car c) 'fq) (= (length c) 3))
           (ipq-vt! (cadr c)) (ipq-vt! (caddr c)) (dk-cite! 'herm-form-value-type 'md 'fq (cadr c) (caddr c)) g)
          ((and (pair? c) (eq? (car c) 'conjugate)) (ipq-ct! (cadr c)) (dk-cite! 'cc-conjugate-closed (cadr c)) g)
          ((and (pair? c) (memq (car c) '(+ *)) (= (length c) 3))
           (ipq-ct! (cadr c)) (ipq-ct! (caddr c)) (ipq-and! (list 'IN (cadr c) 'CC) (list 'IN (caddr c) 'CC))
           (dk-cite! (if (eq? (car c) '*) 'cc-mul-closed 'cc-add-closed) (cadr c) (caddr c)) g)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 2)) (ipq-ct! (cadr c)) (dk-cite! 'cc-neg-closed (cadr c)) g)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 3))
           (ipq-ct! (cadr c)) (ipq-ct! (caddr c)) (dk-cite! 'cc-sub-in-cc (cadr c) (caddr c)) g)
          (#t (dk-have! g (lambda () (type-term))) g))))
(define (ipq-type-scalars! e)
  (cond ((not (pair? e)) #t)
        ((and (eq? (car e) 'fq) (= (length e) 3)) (ipq-ct! e))
        ((and (eq? (car e) 'conjugate) (= (length e) 2)) (ipq-ct! e))
        (#t (for-each ipq-type-scalars! (cdr e)))))

(define (ipq-has-sub? t e)
  (or (equal? t e) (and (pair? e) (let loop ((l e)) (and (pair? l) (or (ipq-has-sub? t (car l)) (loop (cdr l))))))))
(define (ipq-subst-if! eq) (if (and (ipq-open?) (ipq-has-sub? (cadr eq) (dk-goal))) (subst eq)))
;;; ---- the right-hand laws ---------------------------------------------------------------------
;;; <x | y + z> = conj <y + z | x> = conj(<y|x> + <z|x>) = <x|y> + <x|z>
(sp (make-wff (ipq-stmt '(x_ y_ z_) ipq-H0 (map ipq-in-vec '(x_ y_ z_))
  '(= (fq x_ ((VADD md) y_ z_)) (+ (fq x_ y_) (fq x_ z_))))))
(dk-peel!)
(ipq-vt! '((VADD md) y_ z_))
(subst (dk-cite! 'herm-form-conj-sym 'md 'fq '((VADD md) y_ z_) 'x_))
(subst (dk-cite! 'herm-form-add-left 'md 'fq 'y_ 'z_ 'x_))
(ipq-type-scalars! (dk-goal))
(ipq-and! '(IN (fq y_ x_) CC) '(IN (fq z_ x_) CC))
(subst (dk-cite! 'cc-conjugate-add '(fq y_ x_) '(fq z_ x_)))
(subst (dk-cite! 'herm-form-conj-sym 'md 'fq 'y_ 'x_))
(subst (dk-cite! 'herm-form-conj-sym 'md 'fq 'z_ 'x_))
(ipq-type-scalars! (dk-goal))
(ipq-subst-if! (dk-cite! 'cc-conjugate-involution '(fq x_ y_)))
(ipq-subst-if! (dk-cite! 'cc-conjugate-involution '(fq x_ z_)))
(dk-close-if! (lambda () #t) (lambda () (rfl)))
(ipq-qed! 'herm-form-add-right)
;;; <x | a y> = conj <a y | x> = conj(a <y|x>) = conj(a) <x|y>
(sp (make-wff (ipq-stmt '(a_ x_ y_) ipq-H0 (cons '(IN a_ CC) (map ipq-in-vec '(x_ y_)))
  '(= (fq x_ ((ACT md) a_ y_)) (* (conjugate a_) (fq x_ y_))))))
(dk-peel!)
(ipq-vt! '((ACT md) a_ y_))
(subst (dk-cite! 'herm-form-conj-sym 'md 'fq '((ACT md) a_ y_) 'x_))
(subst (dk-cite! 'herm-form-homog-left 'md 'fq 'a_ 'y_ 'x_))
(ipq-type-scalars! (dk-goal))
(ipq-and! '(IN a_ CC) '(IN (fq y_ x_) CC))
(subst (dk-cite! 'cc-conjugate-mul 'a_ '(fq y_ x_)))
(subst (dk-cite! 'herm-form-conj-sym 'md 'fq 'y_ 'x_))
(ipq-type-scalars! (dk-goal))
(ipq-subst-if! (dk-cite! 'cc-conjugate-involution '(fq x_ y_)))
(dk-close-if! (lambda () #t) (lambda () (rfl)))
(ipq-qed! 'herm-form-homog-right)

;;; ---- the expander: open fq at compound arguments ---------------------------------------------
(define (ipq-compound? e) (or (ipq-op? e 'VADD) (ipq-op? e 'ACT)))
(define (ipq-find-redex e)
  (cond ((not (pair? e)) #f)
        ((and (eq? (car e) 'fq) (= (length e) 3) (or (ipq-compound? (cadr e)) (ipq-compound? (caddr e)))) e)
        (#t (let loop ((l e)) (cond ((not (pair? l)) #f) ((ipq-find-redex (car l)) => (lambda (x) x)) (#t (loop (cdr l))))))))
(define (ipq-open-law! r)
  (let ((a (cadr r)) (b (caddr r)))
    (ipq-vt! a) (ipq-vt! b)
    (cond ((ipq-op? a 'VADD) (dk-cite! 'herm-form-add-left 'md 'fq (cadr a) (caddr a) b))
          ((ipq-op? a 'ACT)  (ipq-ct! (cadr a)) (dk-cite! 'herm-form-homog-left 'md 'fq (cadr a) (caddr a) b))
          ((ipq-op? b 'VADD) (dk-cite! 'herm-form-add-right 'md 'fq a (cadr b) (caddr b)))
          ((ipq-op? b 'ACT)  (ipq-ct! (cadr b)) (dk-cite! 'herm-form-homog-right 'md 'fq (cadr b) a (caddr b)))
          (#t (error "ipq-open-law!" (expression->string r))))))
(define (ipq-expand!)
  (let loop ((fuel 40))
    (if (<= fuel 0) (error "ipq-expand!: out of fuel"))
    (let ((r (and (ipq-open?) (ipq-find-redex (dk-goal)))))
      (if r (begin (subst (ipq-open-law! r)) (loop (- fuel 1)))))))

;;; ---- a null vector is orthogonal to everything ------------------------------------------------
(sp (make-wff (ipq-stmt '(n_ y_) ipq-HP (list (ipq-in-vec 'n_) '(= (fq n_ n_) 0) (ipq-in-vec 'y_))
  '(= (fq n_ y_) 0))))
(dk-peel!)
(dk-cite! 'psd-form-hermitian 'md 'fq)
(ipq-cscal!)
(let* ((c '(fq n_ y_)) (bb '(fq y_ y_)) (al (list '+ bb 1)) (be (list '- c))
       (z (list '(VADD md) (list '(ACT md) al 'n_) (list '(ACT md) be 'y_)))
       (pp (list 'fq z z))
       (kk (list '* c (list 'conjugate c)))
       (tt (list '+ (list '- (list '* bb kk)) (list '- (list '* 2 kk)))))
  (ipq-ct! c)
  (dk-cite! 'psd-form-real 'md 'fq 'y_)
  (dk-have! '(IN 1 RR) (lambda () (arith)))
  (dk-cite! 'rr-add-in-rr bb 1)
  (ipq-ct! al) (ipq-ct! be)
  (ipq-vt! z)
  (dk-cite! 'psd-form-real 'md 'fq z)
  (dk-cite! 'psd-form-nonneg 'md 'fq z)
  (let ((q (dk-have! (list '= pp tt)
             (lambda ()
               (ipq-expand!)
               (subst '(= (fq n_ n_) 0))
               (subst (dk-cite! 'herm-form-conj-sym 'md 'fq 'n_ 'y_))
               (subst (dk-cite! 'cc-conjugate-fixes-rr al))
               (subst (dk-cite! 'cc-conjugate-neg c))
               (ipq-type-scalars! (dk-goal))
               (crs)))))
    (let* ((qf (list '= pp tt))
           (m (list 'magnitude c))
           (e1 (dk-cite! 'cc-magnitude-sq-conjugate-rev c))
           (q1 (dk-rewrite-h! qf kk (list '* m m))))
      (dk-have! (list 'IN m 'RR) (lambda () (type-term)))
      (dk-cite! 'cc-magnitude-nonneg c)
      (dk-cite! 'rr-mul-in-rr m m)
      (ipq-and! (list 'IN m 'RR) (list 'IN m 'RR))
      (ipq-and! (list '<= 0 m) (list '<= 0 m))
      (dk-cite! 'rr-leq-mul-nonneg m m)
      (let* ((kv (dk-name! (list '* m m) 'RR))
             (q2 (dk-rewrite-h! q1 (list '* m m) kv))
             (n2 (dk-rewrite-h! (list '<= 0 (list '* m m)) (list '* m m) kv)))
        (dk-cite! 'rr-mul-in-rr bb kv)
        (dk-cite! 'psd-form-nonneg 'md 'fq 'y_)
        (ipq-and! (list 'IN bb 'RR) (list 'IN kv 'RR))
        (ipq-and! (list '<= 0 bb) (list '<= 0 kv))
        (dk-cite! 'rr-leq-mul-nonneg bb kv)
        (let* ((bk (dk-name! (list '* bb kv) 'RR))
               (q3 (dk-rewrite-h! q2 (list '* bb kv) bk))
               (n3 (dk-rewrite-h! (list '<= 0 (list '* bb kv)) (list '* bb kv) bk)))
          (dk-have! (list '<= kv 0)
            (lambda () (dk-ineq! (list 'IN pp 'RR) (list '<= 0 pp) q3 (list 'IN bk 'RR) (list '<= 0 bk)
                                 (list 'IN kv 'RR) (list '<= 0 kv))))
          (dk-have! '(IN 0 RR) (lambda () (arith)))
          (ipq-and! (list 'IN kv 'RR) '(IN 0 RR))
          (ipq-and! (list '<= kv 0) (list '<= 0 kv))
          (dk-cite! 'rr-leq-antisymmetric kv 0)
          (let ((mm0 (dk-rewrite-h! (list '= kv 0) kv (list '* m m))))
            (dk-cite! 'rr-square-zero m)
            (let ((iff (dk-cite! 'cc-magnitude-zero-iff c)))
              (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))))
            (dk-close-if-asm!)))))))
(ipq-qed! 'psd-form-null-orth)

;;; ---- consequences: f(0, y) = 0, f(y, n) = 0, f(-x, y) = -f(x, y), f(x, -y) = -f(x, y) --------
(sp (make-wff (ipq-stmt '(y_) ipq-HP (list (ipq-in-vec 'y_)) '(= (fq (VZERO md) y_) 0))))
(dk-peel!)
(dk-cite! 'module-vzero-in 'md)
(dk-cite! 'psd-form-zero 'md 'fq)
(dk-cite! 'psd-form-null-orth 'md 'fq '(VZERO md) 'y_)
(dk-close-if-asm!)
(ipq-qed! 'psd-form-zero-left)

(sp (make-wff (ipq-stmt '(n_ y_) ipq-HP (list (ipq-in-vec 'n_) '(= (fq n_ n_) 0) (ipq-in-vec 'y_))
  '(= (fq y_ n_) 0))))
(dk-peel!)
(dk-cite! 'psd-form-hermitian 'md 'fq)
(subst (dk-cite! 'herm-form-conj-sym 'md 'fq 'n_ 'y_))
(dk-cite! 'psd-form-null-orth 'md 'fq 'n_ 'y_)
(subst '(= (fq n_ y_) 0))
(dk-have! '(IN 0 RR) (lambda () (arith)))
(subst (dk-cite! 'cc-conjugate-fixes-rr 0))
(dk-close-if! (lambda () #t) (lambda () (rfl)))
(ipq-qed! 'psd-form-null-right)

;;; A + B = 0 in CC (as (= Z (+ A B)) with Z = 0 in context) gives A = -B
(define (ipq-neg-of-sum! a b zt)
  (ipq-ct! a) (ipq-ct! b)
  (dk-have! (list '= (list '+ a (list '- (list '- b))) 0)
    (lambda ()
      (dk-have! (list '= (list '+ a (list '- (list '- b))) (list '+ a b)) (lambda () (crs)))
      (subst (list '= (list '+ a (list '- (list '- b))) (list '+ a b)))
      (subst (list '= (list '+ a b) zt))
      (dk-close-if-asm!)))
  (ipq-ct! (list '- b))
  (dk-cite! 'cc-eq-of-add-neg-zero a (list '- b)))

(sp (make-wff (ipq-stmt '(x_ y_) ipq-HP (map ipq-in-vec '(x_ y_)) '(= (fq ((VNEG md) x_) y_) (- (fq x_ y_))))))
(dk-peel!)
(dk-cite! 'psd-form-hermitian 'md 'fq)
(ipq-vt! '((VNEG md) x_))
(let* ((h1 (dk-cite! 'herm-form-add-left 'md 'fq '((VNEG md) x_) 'x_ 'y_))
       (e  (dk-cite! 'rmod-vneg-left 'md 'x_))
       (h2 (dk-rewrite-h! h1 '((VADD md) ((VNEG md) x_) x_) '(VZERO md))))
  (dk-cite! 'psd-form-zero-left 'md 'fq 'y_)
  (ipq-neg-of-sum! '(fq ((VNEG md) x_) y_) '(fq x_ y_) '(fq (VZERO md) y_)))
(dk-close-if-asm!)
(ipq-qed! 'psd-form-neg-left)

(sp (make-wff (ipq-stmt '(x_ y_) ipq-HP (map ipq-in-vec '(x_ y_)) '(= (fq x_ ((VNEG md) y_)) (- (fq x_ y_))))))
(dk-peel!)
(dk-cite! 'psd-form-hermitian 'md 'fq)
(ipq-vt! '((VNEG md) y_))
(subst (dk-cite! 'herm-form-conj-sym 'md 'fq '((VNEG md) y_) 'x_))
(subst (dk-cite! 'psd-form-neg-left 'md 'fq 'y_ 'x_))
(ipq-ct! '(fq y_ x_))
(subst (dk-cite! 'cc-conjugate-neg '(fq y_ x_)))
(subst (dk-cite! 'herm-form-conj-sym 'md 'fq 'y_ 'x_))
(ipq-ct! '(fq x_ y_))
(ipq-subst-if! (dk-cite! 'cc-conjugate-involution '(fq x_ y_)))
(dk-close-if! (lambda () #t) (lambda () (rfl)))
(ipq-qed! 'psd-form-neg-right)

;;; ---- the null space ----------------------------------------------------------------------------
(define ipq-N '(FORM-NULL md fq))
(sp (make-wff '(FORALL md (FORALL fq (== (FORM-NULL md fq) (SEP ipfx_ (VEC md) (= (fq ipfx_ ipfx_) 0)))))))
(di) (mac 'FORM-NULL) (qrfl)
(ipq-qed! 'form-null-unfold)

(sp (make-wff (forall-guarded '(md fq x_) (list (ipq-in-vec 'x_) '(= (fq x_ x_) 0)) (list 'IN 'x_ ipq-N))))
(dk-peel!)
(mac 'FORM-NULL)
(in-sep! (lambda () (ass)) (lambda () (ass)))
(ipq-qed! 'form-null-in)

(sp (make-wff (forall-guarded '(md fq x_) (list (list 'IN 'x_ ipq-N))
  (list 'AND (ipq-in-vec 'x_) '(= (fq x_ x_) 0)))))
(dk-peel!)
(let* ((h  (dk-landed-1 (lambda () (mac-h 'form-null-unfold (list 'IN 'x_ ipq-N)))))
       (ls (dk-landed (lambda () (sep-me h)))))
  (dk-split-all!)
  (dk-conj-close! (lambda () (dk-close-if-asm!))))
(ipq-qed! 'form-null-out)

;;; the expander, with VNEG
(define (ipq-open-law! r)
  (let ((a (cadr r)) (b (caddr r)))
    (ipq-vt! a) (ipq-vt! b)
    (for-each (lambda (e) (cond ((or (ipq-op? e 'VADD)) (ipq-vt! (cadr e)) (ipq-vt! (caddr e)))
                                ((ipq-op? e 'ACT) (ipq-vt! (caddr e)))
                                ((ipq-op? e 'VNEG) (ipq-vt! (cadr e)))))
              (list a b))
    (cond ((ipq-op? a 'VADD) (dk-cite! 'herm-form-add-left 'md 'fq (cadr a) (caddr a) b))
          ((ipq-op? a 'ACT)  (ipq-ct! (cadr a)) (dk-cite! 'herm-form-homog-left 'md 'fq (cadr a) (caddr a) b))
          ((ipq-op? a 'VNEG) (dk-cite! 'psd-form-neg-left 'md 'fq (cadr a) b))
          ((ipq-op? b 'VADD) (dk-cite! 'herm-form-add-right 'md 'fq a (cadr b) (caddr b)))
          ((ipq-op? b 'ACT)  (ipq-ct! (cadr b)) (dk-cite! 'herm-form-homog-right 'md 'fq (cadr b) a (caddr b)))
          ((ipq-op? b 'VNEG) (dk-cite! 'psd-form-neg-right 'md 'fq a (cadr b)))
          (#t (error "ipq-open-law!" (expression->string r))))))
(define (ipq-compound? e) (or (ipq-op? e 'VADD) (ipq-op? e 'ACT) (ipq-op? e 'VNEG)))
;;; x in N: land (IN x (VEC md)) and (= (fq x x) 0)
(define (ipq-null-out! x) (dk-split! (dk-cite! 'form-null-out 'md 'fq x)))
;;; zero the fq-terms with a null argument
(define (ipq-null-zero! nulls)
  (let loop ((fuel 20))
    (let ((r (and (ipq-open?)
                  (let find ((e (dk-goal)))
                    (cond ((not (pair? e)) #f)
                          ((and (eq? (car e) 'fq) (= (length e) 3) (or (member (cadr e) nulls) (member (caddr e) nulls))) e)
                          (#t (let l2 ((l e)) (cond ((not (pair? l)) #f) ((find (car l)) => (lambda (x) x)) (#t (l2 (cdr l)))))))))))
      (if (and r (> fuel 0))
          (begin
            (ipq-vt! (cadr r)) (ipq-vt! (caddr r))
            (subst (if (dk-asm? (list '= r 0)) (list '= r 0) (if (member (cadr r) nulls)
                       (dk-cite! 'psd-form-null-orth 'md 'fq (cadr r) (caddr r))
                       (dk-cite! 'psd-form-null-right 'md 'fq (caddr r) (cadr r)))))
            (loop (- fuel 1)))))))

(sp (make-wff (ipq-stmt '() ipq-HP '() (list 'IS-SUBMODULE 'md ipq-N))))
(dk-peel!)
(dk-cite! 'psd-form-hermitian 'md 'fq)
(ipq-cscal!)
(dk-cite! 'module-vzero-in 'md)
(dk-cite! 'psd-form-zero 'md 'fq)
(mac 'IS-SUBMODULE)
(define (ipq-sub-conj!)
  (let ((g (dk-goal)))
    (cond
      ((dk-asm? g) (ass))
      ((dk-head-is? g 'SUBSET)
       (mac 'SUBSET) (di)
       (let ((x (cadr (dk-goal)))) (ipq-null-out! x) (dk-close-if-asm!)))
      ((dk-head-is? g 'IN) (dk-cite! 'form-null-in 'md 'fq (cadr g)) (dk-close-if-asm!))
      ((dk-head-is? g 'FORALL)
       (let* ((ls (dk-peel!))
              (g1 (dk-goal)) (e (cadr g1))
              (xs (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) ipq-N))) (dk-asms))))
         (for-each (lambda (f) (ipq-null-out! (cadr f))) xs)
         (for-each (lambda (f)
                     (if (and (dk-head-is? f 'IN) (equal? (caddr f) '(CARR (SCAL md))))
                         (let ((gc (list 'IN (cadr f) 'CC)))
                           (if (not (dk-asm? gc)) (dk-have! gc (lambda () (subst '(= CC (CARR (SCAL md)))) (ass)))))))
                   (dk-asms))
         (ipq-vt! e)
         (let ((nulls (map cadr xs)))
           (dk-have! (list '= (list 'fq e e) 0)
             (lambda ()
               (ipq-expand!)
               (ipq-null-zero! nulls)
               (ipq-type-scalars! (dk-goal))
               (if (ipq-open?) (crs)))))
         (dk-cite! 'form-null-in 'md 'fq e)
         (dk-close-if-asm!)))
      (#t (error "ipq-sub-conj!: unexpected conjunct" (expression->string g))))))
(dk-conj-close! (lambda () (if (ipq-open?) (ipq-sub-conj!))))
(ipq-qed! 'form-null-submodule)

;;; ---- f descends: it respects the null-difference relation in both arguments --------------------
(define ipq-S (list 'QMOD-SETOID 'md ipq-N))
(sp (make-wff (ipq-stmt '() ipq-HP '() (list 'RESPECTS2 ipq-S 'fq))))
(dk-peel!)
(dk-cite! 'psd-form-hermitian 'md 'fq)
(dk-cite! 'form-null-submodule 'md 'fq)
(mac 'RESPECTS2)
(subst (dk-cite! 'qmod-setoid-pts 'md ipq-N))
(dk-peel!)
(let* ((g (dk-goal)) (l (cadr g)) (r (caddr g))
       (a (cadr l)) (b (caddr l)) (a2 (cadr r)) (b2 (caddr r)))
  (if (dk-head-is? g 'IMPLIES) (error "respects2: expected the equation after the peel" (expression->string g)))
  (let ((rel (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-head-is? (cadr f) 'RELATED))) (dk-asms))))
    (if rel (dk-split! rel)))
  (dk-cite! 'qmod-related-out 'md ipq-N a a2)
  (dk-cite! 'qmod-related-out 'md ipq-N b b2)
  (let ((d1 (list '(VADD md) a (list '(VNEG md) a2))) (d2 (list '(VADD md) b (list '(VNEG md) b2))))
    (ipq-null-out! d1) (ipq-null-out! d2)
    (ipq-vt! d1) (ipq-vt! d2)
    (let* ((e1 (dk-cite! 'psd-form-null-orth 'md 'fq d1 b))
           (e2 (dk-cite! 'psd-form-null-right 'md 'fq d2 a2)))
      ;; e1: f(a - a2, b) = 0, i.e. f(a,b) + -f(a2,b) = 0;  e2: f(a2, b - b2) = 0
      (dk-have! (list '= (list 'fq d1 b) (list '+ (list 'fq a b) (list '- (list 'fq a2 b))))
        (lambda () (ipq-expand!) (if (ipq-open?) (ipq-type-scalars! (dk-goal))) (if (ipq-open?) (dk-close-if! (lambda () #t) (lambda () (rfl))))))
      (dk-have! (list '= (list 'fq a2 d2) (list '+ (list 'fq a2 b) (list '- (list 'fq a2 b2))))
        (lambda () (ipq-expand!) (if (ipq-open?) (ipq-type-scalars! (dk-goal))) (if (ipq-open?) (dk-close-if! (lambda () #t) (lambda () (rfl))))))
      (ipq-ct! (list 'fq a b)) (ipq-ct! (list 'fq a2 b)) (ipq-ct! (list 'fq a2 b2))
      (dk-have! (list '= (list '+ (list 'fq a b) (list '- (list 'fq a2 b))) 0)
        (lambda () (subst (list '= (list '+ (list 'fq a b) (list '- (list 'fq a2 b))) (list 'fq d1 b))) (dk-close-if-asm!)))
      (dk-have! (list '= (list '+ (list 'fq a2 b) (list '- (list 'fq a2 b2))) 0)
        (lambda () (subst (list '= (list '+ (list 'fq a2 b) (list '- (list 'fq a2 b2))) (list 'fq a2 d2))) (dk-close-if-asm!)))
      (dk-cite! 'cc-eq-of-add-neg-zero (list 'fq a b) (list 'fq a2 b))
      (dk-cite! 'cc-eq-of-add-neg-zero (list 'fq a2 b) (list 'fq a2 b2))
      (subst (list '= (list 'fq a b) (list 'fq a2 b)))
      (dk-close-if-asm!))))
(ipq-qed! 'form-respects2)

;;; ---- the induced form on the classes --------------------------------------------------------------
(define ipq-Q (list 'QUOTIENT-MODULE 'md ipq-N))
(define ipq-G '(FORM-QIP md fq))
(define (ipq-cl x) (list 'CLASS ipq-S x))
(define ipq-ptsq (list '= (list 'PTS ipq-S) '(VEC md)))
(define (ipq-qsetup!)
  (dk-cite! 'psd-form-hermitian 'md 'fq)
  (ipq-cscal!)
  (dk-cite! 'form-null-submodule 'md 'fq)
  (dk-cite! 'qmod-setoid-is-setoid 'md ipq-N)
  (dk-cite! 'qmod-setoid-pts 'md ipq-N)
  (dk-cite! 'quotient-module-is-module 'md ipq-N)
  (for-each (lambda (nm) (dk-cite! nm 'md ipq-N)) '(qmod-ro-scal qmod-ro-vec qmod-ro-vzero))
  (dk-cite! 'herm-form-type 'md 'fq)
  (let ((g (list 'IN 'fq (list 'FUN (list 'CARTESIAN (list 'PTS ipq-S) (list 'PTS ipq-S)) 'CC))))
    (if (not (dk-asm? g)) (dk-have! g (lambda () (subst ipq-ptsq) (ass)))))
  (dk-cite! 'form-respects2 'md 'fq))
(define (ipq-pts! x)
  (let ((g (list 'IN x (list 'PTS ipq-S))) (gv (ipq-in-vec x)))
    (if (and (dk-asm? g) (not (dk-asm? gv)))
        (dk-have! gv (lambda () (subst (list '= '(VEC md) (list 'PTS ipq-S))) (ass))))
    (ipq-vt! x)
    (if (not (dk-asm? g)) (dk-have! g (lambda () (subst ipq-ptsq) (ass))))))

(sp (make-wff (ipq-stmt '() ipq-HP '()
  (list 'IN ipq-G (list 'FUN (list 'CARTESIAN (list 'QUOTIENT ipq-S) (list 'QUOTIENT ipq-S)) 'CC)))))
(dk-peel!)
(ipq-qsetup!)
(mac 'FORM-QIP)
(dk-cite! 'descend2-in-fun ipq-S 'CC 'fq)
(dk-close-if-asm!)
(ipq-qed! 'form-qip-type)

(sp (make-wff (ipq-stmt '(x_ y_) ipq-HP (map ipq-in-vec '(x_ y_))
  (list '= (list ipq-G (ipq-cl 'x_) (ipq-cl 'y_)) '(fq x_ y_)))))
(dk-peel!)
