;;; ba1i-unit-star.scm -- BANACH ALGEBRAS, Proposition 1.18: if A is an involutive Banach algebra (not
;;; necessarily unital), the unitization C x A with (l, x)* = (conj l, x*) is a unital involutive Banach
;;; algebra: IS-NU-INVOLUTIVE-BANACH-ALGEBRA(a) => IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA(UNITIZATION-STAR(a)).
;;; F. J. Thayer, "Banach Algebras and Applications", ch. 1 s. 2.
;;; Agent BA-1I, 2026-11-10.  Destination: theorem-library/ba1i-unit-star.scm.
;;; Library: operator-algebras.  All proofs modulo 0.  Helper prefix b1s-.
;;;
;;; THE ROUTE.  (1) The read-offs of the view V = NUIBA-AS-CBA(a): ACC(V) == ACC(a), and the unitization
;;; functoids at V equal those at a, UNIT-X(V) == UNIT-X(a).  So every theorem proved for a complex
;;; normed (Banach) algebra -- the unitization laws of BA-1C, KIT-ALG and ba1i-unit-banach -- is used at V
;;; and read back onto a by rewriting V-terms in the HYPOTHESIS (b1s-cite-at-a!).  (2) THE ISTAR-KEYED LAW
;;; SET b1s-nuiba: the 23 kal-cna roles transferred through V, plus vstar-in, star-vadd, star-act,
;;; star-star, star-mul, star-zero stated with ISTAR in place of VSTAR; dk-alg-norm! runs on it through a
;;; local wrapper (b1s-alg-norm!) that rebinds the kit's star head to ISTAR by fluid-let (the kit's
;;; 'star-head option of KIT-ALG-REPORT F6, done without editing the kit).  (3) The involution of the
;;; unitization at literal pairs, its five laws there, lifted by eta.  (4) The 10-tuple unfolded, its
;;; accessors read off, every conjunct closed by a citation.
;;;
;;; LOAD WINDOW: after ba1i-unit-banach.scm (and so kal-unit-cna, kal-laws, ba-unitization, ba-vocab);
;;; kit-alg.scm in the driver-kit environment.

(define (b1s-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (if (and (not (sequent-node-grounded? l))
                           (let ((g (dk-goal-of l))) (and (pair? g) (eq? (car g) '=) (equal? (cadr g) (caddr g)))))
                      (begin (dk-focus! l) (rfl))))
                (dk-open-leaves)))
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** ba1i-unit-star: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "ba1i-unit-star: unfinished" name))))
(define (b1s-fa v cls body) (list 'FORALL v (list 'IMPLIES (list 'IN v cls) body)))
(define (b1s-st body) (list 'FORALL 'a (list 'IMPLIES '(IS-NU-INVOLUTIVE-BANACH-ALGEBRA a) body)))
(define b1s-V '(NUIBA-AS-CBA a))
(define b1s-accs '(SCAL VEC VADD VZERO VNEG ACT VNRM VMUL))
(define b1s-ufs '(UNIT-VEC UNIT-VADD UNIT-VNEG UNIT-ACT UNIT-VNRM UNIT-VMUL))
(define (b1s-lc s) (string->symbol (string-downcase (symbol->string s))))
(define (b1s-nv-name acc) (symbol-append 'b1s-nv- (b1s-lc acc)))
(define (b1s-uf-name uf) (symbol-append 'b1s-uf- (b1s-lc uf)))
(define (b1s-occurs? x t) (or (equal? x t) (and (pair? t) (or (b1s-occurs? x (car t)) (b1s-occurs? x (cdr t))))))
(define (b1s-sym-replace from to t)
  (cond ((eq? t from) to) ((pair? t) (cons (b1s-sym-replace from to (car t)) (b1s-sym-replace from to (cdr t)))) (#t t)))

;;; ---- (1) the view NUIBA-AS-CBA(a) read back onto a ------------------------------------------------
(for-each
  (lambda (acc)
    (sp (make-wff (b1s-st (list '== (list acc b1s-V) (list acc 'a)))))
    (dk-peel!)
    (mac 'NUIBA-AS-CBA)
    (slot acc)
    (let loop ((n 0))
      (let ((g (dk-goal)))
        (quietly (lambda () (nth-r)))
        (if (and (< n 6) (not (proof-done? *ps*)) (not (equal? g (dk-goal)))) (loop (+ n 1)))))
    (if (not (proof-done? *ps*))
        (begin (quietly (lambda () (slot acc))) (qrfl)))
    (b1s-qed! (b1s-nv-name acc)))
  b1s-accs)
(for-each
  (lambda (uf)
    (sp (make-wff (b1s-st (list '== (list uf b1s-V) (list uf 'a)))))
    (dk-peel!)
    (for-each (lambda (acc) (dk-cite! (b1s-nv-name acc) 'a)) b1s-accs)
    (mac uf)
    (if (not (eq? uf 'UNIT-VEC)) (mac 'UNIT-VEC))
    (for-each (lambda (acc)
                (if (b1s-occurs? (list acc b1s-V) (dk-goal))
                    (subst (list '= (list acc b1s-V) (list acc 'a)))))
              b1s-accs)
    (qrfl)
    (b1s-qed! (b1s-uf-name uf)))
  b1s-ufs)

;;; the setup of every proof below: V is a complex normed algebra, the read-offs in context
(define (b1s-setup!)
  (dk-cite! 'nuiba-as-cba-is-complex-banach-algebra 'a)
  (dk-cite! 'bal-cba-is-cna b1s-V)
  (for-each (lambda (acc) (dk-cite! (b1s-nv-name acc) 'a)) b1s-accs)
  (for-each (lambda (uf) (dk-cite! (b1s-uf-name uf) 'a)) b1s-ufs))
;;; rewrite every V-term of the hypothesis F into its a-form; returns the final formula
(define (b1s-down f)
  (let loop ((f f)
             (prs (append (map (lambda (u) (cons (list u b1s-V) (list u 'a))) b1s-ufs)
                          (map (lambda (c) (cons (list c b1s-V) (list c 'a))) b1s-accs))))
    (cond ((null? prs) f)
          ((b1s-occurs? (caar prs) f) (loop (dk-rewrite-h! f (caar prs) (cdar prs)) (cdr prs)))
          (#t (loop f (cdr prs))))))
;;; (IN t (VEC a)) in context: land (IN t (VEC V))
(define (b1s-up-type! t)
  (if (not (dk-asm? (list 'IN t (list 'VEC b1s-V))))
      (dk-rewrite-h! (list 'IN t '(VEC a)) '(VEC a) (list 'VEC b1s-V))))
;;; cite THM (stated for a complex normed / Banach algebra) at V, the vector arguments VECS lifted first
(define (b1s-cite-at-a! thm vecs . args)
  (for-each b1s-up-type! vecs)
  (b1s-down (apply dk-cite! thm b1s-V args)))

;;; ---- (2) the ISTAR-keyed law set b1s-nuiba ---------------------------------------------------------
(define (b1s-law-statement role)
  (b1s-sym-replace 'VSTAR 'ISTAR (dk-alg-law-statement role 'IS-NU-INVOLUTIVE-BANACH-ALGEBRA)))
(define (b1s-law-name role) (symbol-append 'b1s-nuiba- role))
;;; the local wrapper: the kit with its star head rebound to ISTAR
(define (b1s-with-istar thunk)
  (fluid-let ((dk--alg-head (lambda (krec acc) (list (if (eq? acc 'VSTAR) 'ISTAR acc) (dk--alg-A krec))))
              (dk--alg-vecop? (lambda (krec t)
                                (and (pair? t) (pair? (car t)) (memq (caar t) '(VADD VNEG ACT VMUL ISTAR))
                                     (pair? (cdar t)) (equal? (cadar t) (dk--alg-A krec))))))
    (thunk)))
(define (b1s-alg-norm! . opts) (b1s-with-istar (lambda () (apply dk-alg-norm! 'b1s-nuiba 'a opts))))
(define (b1s-alg-have! claim . opts) (b1s-with-istar (lambda () (apply dk-alg-have! 'b1s-nuiba 'a claim opts))))
(define (b1s-vt t) (b1s-with-istar (lambda () (dk-alg-type! 'b1s-nuiba 'a t))))

(define b1s-cna-roles
  '(vadd-in vneg-in act-in vmul-in vzero-in add-assoc add-comm add-zero-l add-zero-r vneg-act act-vadd
    act-add act-mul act-one act-zero act-vzero mul-assoc mul-dist-l mul-dist-r mul-act-l mul-act-r
    mul-zero-l mul-zero-r))
(for-each
  (lambda (role)
    (sp (make-wff (b1s-law-statement role)))
    (di) (di)
    (fact 'nuiba-as-cba-is-complex-banach-algebra 'a)
    (fact 'bal-cba-is-cna b1s-V)
    (fact (symbol-append 'kal-cna- role) b1s-V)
    (for-each (lambda (acc)
                (if (b1s-occurs? (list acc 'a) (dk-goal))
                    (begin (fact (b1s-nv-name acc) 'a)
                           (subst (list '= (list acc 'a) (list acc b1s-V))))))
              '(VEC VADD VZERO VNEG ACT VMUL))
    (ass)
    (b1s-qed! (b1s-law-name role)))
  b1s-cna-roles)
;;; the involution: projections of IS-NU-INVOLUTIVE-BANACH-ALGEBRA
(define (b1s-project! name conj)
  (sp (make-wff (b1s-st conj)))
  (di) (di)
  (let ((u (dk-landed-1 (lambda () (mac-h 'IS-NU-INVOLUTIVE-BANACH-ALGEBRA '(IS-NU-INVOLUTIVE-BANACH-ALGEBRA a))))))
    (dk-split-all! (list u)))
  (ass)
  (b1s-qed! name))
(b1s-project! 'b1s-istar-fun '(IN (ISTAR a) (FUN (VEC a) (VEC a))))
(b1s-project! 'b1s-istar-isom '(FORALL x_ (IMPLIES (IN x_ (VEC a)) (= ((VNRM a) ((ISTAR a) x_)) ((VNRM a) x_)))))
(for-each (lambda (role) (b1s-project! (b1s-law-name role) (caddr (caddr (b1s-law-statement role)))))
          '(star-vadd star-act star-star star-mul))
(sp (make-wff (b1s-law-statement 'vstar-in)))
(dk-peel!)
(dk-cite! 'b1s-istar-fun 'a)
(dk-cite! 'fun-apply-type-c '(ISTAR a) '(VEC a) '(VEC a) 'kax_)
(dk-ass!)
(b1s-qed! 'b1s-nuiba-vstar-in)
(define (b1s-ac c x) (list '(ACT a) c x))
(define (b1s-is x) (list '(ISTAR a) x))
(define b1s-z '(VZERO a))
(sp (make-wff (b1s-law-statement 'star-zero)))       ; 0* = (0 0)* = conj(0) 0* = 0 0* = 0
(dk-peel!)
(b1s-vt b1s-z) (b1s-vt (b1s-is b1s-z))
(dk-have! '(IN 0 CC) (lambda () (arith)))
(dk-have! '(IN 0 RR) (lambda () (arith)))
(dk-cite! 'b1s-nuiba-act-zero 'a b1s-z)
(dk-cite! 'cc-conjugate-fixes-rr 0)
(dk-cite! 'b1s-nuiba-act-zero 'a (b1s-is b1s-z))
(let* ((e0 (dk-cite! 'b1s-nuiba-star-act 'a 0 b1s-z))
       (e1 (dk-rewrite-h! e0 (b1s-ac 0 b1s-z) b1s-z))
       (e2 (dk-rewrite-h! e1 '(conjugate 0) 0)))
  (dk-rewrite-h! e2 (b1s-ac 0 (b1s-is b1s-z)) b1s-z))
(dk-ass!)
(b1s-qed! 'b1s-nuiba-star-zero)

;;; ---- (3) the involution of the unitization ---------------------------------------------------------
(define b1s-ui '(UNIT-ISTAR a))
(define (b1s-pair? t) (and (pair? t) (eq? (car t) 'LIST) (= (length t) 3)))
;;; the read-off at a literal pair: (l, x)* = (conj l, x*)
(sp (make-wff (b1s-st (b1s-fa 'l 'CC (b1s-fa 'x '(VEC a)
  (list '= (list b1s-ui '(LIST l x)) (list 'LIST '(conjugate l) (b1s-is 'x))))))))
(dk-peel!)
(mac 'UNIT-ISTAR)
(mac 'UNIT-VEC)
(dk-cite! 'pair-in-cartesian 'CC '(VEC a) 'l 'x)
(b1s-vt (b1s-is 'x))
(dk-cc-type! '(conjugate l))
(if (not (dk-lam-b!))
    (begin
      (let loop ((n 0))
        (let ((g (dk-goal)))
          (quietly (lambda () (nth-r)))
          (if (and (< n 8) (not (equal? g (dk-goal)))) (loop (+ n 1)))))
      (if (not (proof-done? *ps*)) (rfl))))
(b1s-qed! 'b1s-istar-apply)
;;; eta for an element of UNIT-VEC(a)
(define (b1s-eta! u)
  (dk-project! (list 'IN u '(CARTESIAN CC (VEC a))) 'unit-vec-unfold (list 'IN u '(UNIT-VEC a)))
  (dk-cite! 'cartesian-pair-eq u 'CC '(VEC a))
  (dk-split! (dk-cite! 'cartesian-nth u 'CC '(VEC a)))
  (list 'LIST (list 'NTH 1 u) (list 'NTH 2 u)))
;;; the typing of the involution
(define (b1s-uv-close!)                  ; goal (IN (LIST c w) (UNIT-VEC a)), c and w built from typed atoms
  (let* ((p (cadr (dk-goal))) (c (cadr p)) (w (caddr p)))
    (dk-cc-type! c) (b1s-vt w)
    (dk-cite! 'pair-in-cartesian 'CC '(VEC a) c w)
    (dk-cite! 'unit-vec-unfold 'a)
    (subst '(= (UNIT-VEC a) (CARTESIAN CC (VEC a))))
    (dk-ass!)))
(sp (make-wff (b1s-st (list 'IN b1s-ui '(FUN (UNIT-VEC a) (UNIT-VEC a))))))
(dk-peel!)
(b1s-setup!)
(dk-cite! 'b1s-istar-fun 'a)
(b1s-cite-at-a! 'kuc-uv-set '())
(dk-cite! 'cc-is-set) (dk-cite! 'bal-cna-vec-set b1s-V)
(b1s-down (list 'IN (list 'VEC b1s-V) 'SET))
(mac 'UNIT-ISTAR)
(dk-lam-type!
  (lambda ()
    (let ((u (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(UNIT-VEC a)))) (dk-peel!))))))
      (b1s-eta! u)
      (b1s-uv-close!)))
  (lambda ()
    (cond ((dk-asm? (dk-goal)) (dk-ass!))
          (#t (error "b1s: set closer" (expression->string (dk-goal)))))))
(b1s-qed! 'b1s-typ-istar)

;;; the redexes at literal pairs, for a NUIBA a: (THUNK) or #f
(define (b1s-op? t op n) (and (pair? t) (equal? (car t) (list op 'a)) (= (length t) (+ n 1))))
(define (b1s-redex t)
  (cond ((and (b1s-op? t 'UNIT-ISTAR 1) (b1s-pair? (cadr t)))
         (let ((p (cadr t)))
           (lambda () (dk-cc-type! (cadr p)) (b1s-vt (caddr p))
                      (dk-cite! 'b1s-istar-apply 'a (cadr p) (caddr p)))))
        ((and (b1s-op? t 'UNIT-VADD 2) (b1s-pair? (cadr t)) (b1s-pair? (caddr t)))
         (let ((p (cadr t)) (q (caddr t)))
           (lambda () (for-each dk-cc-type! (list (cadr p) (cadr q))) (for-each b1s-vt (list (caddr p) (caddr q)))
                      (b1s-cite-at-a! 'bun-vadd-apply (list (caddr p) (caddr q)) (cadr p) (caddr p) (cadr q) (caddr q)))))
        ((and (b1s-op? t 'UNIT-VMUL 2) (b1s-pair? (cadr t)) (b1s-pair? (caddr t)))
         (let ((p (cadr t)) (q (caddr t)))
           (lambda () (for-each dk-cc-type! (list (cadr p) (cadr q))) (for-each b1s-vt (list (caddr p) (caddr q)))
                      (b1s-cite-at-a! 'bun-vmul-apply (list (caddr p) (caddr q)) (cadr p) (caddr p) (cadr q) (caddr q)))))
        ((and (b1s-op? t 'UNIT-ACT 2) (b1s-pair? (caddr t)))
         (let ((c (cadr t)) (p (caddr t)))
           (lambda () (for-each dk-cc-type! (list c (cadr p))) (b1s-vt (caddr p))
                      (b1s-vt (b1s-ac c (caddr p)))
                      (b1s-up-type! (b1s-ac c (caddr p)))
                      (b1s-cite-at-a! 'bun-act-apply (list (caddr p)) c (cadr p) (caddr p)))))
        ((and (b1s-op? t 'UNIT-VNRM 1) (b1s-pair? (cadr t)))
         (let ((p (cadr t)))
           (lambda () (dk-cc-type! (cadr p)) (b1s-vt (caddr p))
                      (b1s-cite-at-a! 'bun-vnrm-apply (list (caddr p)) (cadr p) (caddr p)))))
        (#t #f)))
(define (b1s-find t)
  (or (and (pair? t) (let loop ((ts t)) (and (pair? ts) (or (b1s-find (car ts)) (loop (cdr ts))))))
      (and (b1s-redex t) t)))
(define (b1s-reduce!)
  (let loop ((n 0))
    (if (> n 200) (error "b1s-reduce!: did not terminate"))
    (let ((t (b1s-find (dk-goal))))
      (if t
          (let ((inst ((b1s-redex t))))
            (if (not (and (pair? inst) (eq? (car inst) '=) (equal? (cadr inst) t)))
                (error "b1s-reduce!: the read-off did not land as expected" (expression->string inst)
                       (expression->string t)))
            (subst inst)
            (loop (+ n 1)))))))
(define (b1s-orient-subst! e1 e2)
  (if (not (equal? e1 e2))
      (subst (if (b1s-occurs? e1 e2) (list '= e2 e1) (list '= e1 e2)))))
(define (b1s-pair-close!)
  (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
    (if (not (and (eq? (car g) '=) (b1s-pair? l) (b1s-pair? r)))
        (error "b1s-pair-close!: not an equation of literal pairs" (expression->string g)))
    (let ((c1 (cadr l)) (v1 (caddr l)) (c2 (cadr r)) (v2 (caddr r)))
      (if (not (equal? v1 v2))
          (begin (b1s-alg-have! (list '= v1 v2)) (b1s-orient-subst! v1 v2)))
      (if (not (equal? c1 c2))
          (begin (dk-cc-type! c1) (dk-cc-type! c2)
                 (dk-have! (list '= c1 c2) (lambda () (dk-cc-norm!)))
                 (b1s-orient-subst! c1 c2)))
      (let* ((g2 (dk-goal)) (p (cadr g2)))
        (dk-cc-type! (cadr p)) (b1s-vt (caddr p))
        (dk-cite! 'pair-in-cartesian 'CC '(VEC a) (cadr p) (caddr p))
        (rfl)))))
(define (b1s-norm-close!)                ; |conj l| + ||x*|| = |l| + ||x||
  (let* ((g (dk-goal)) (m (cadr (cadr g))) (l (cadr (cadr m))) (n (caddr (cadr g))) (xs (cadr n)) (x (cadr xs)))
    (dk-cite! 'cc-magnitude-conjugate l)
    (subst (list '= m (list 'magnitude l)))
    (dk-cite! 'b1s-istar-isom 'a x)
    (subst (list '= n (list '(VNRM a) x)))
    (rfl)))

;;; (b1s-law! PAIR-NAME NAME NSCAL NVEC BUILD CLOSE): BUILD (scalars elements) -> (LHS . RHS)
(define b1s-cs '(kuc_))
(define b1s-ls '(kul_ kum_))
(define b1s-xs '(kux_ kuy_))
(define b1s-us '(kuu_ kuv_))
(define (b1s-take l n) (if (= n 0) '() (cons (car l) (b1s-take (cdr l) (- n 1)))))
(define (b1s-law! pair-name name nscal nvec build close)
  (let* ((cs (b1s-take b1s-cs nscal)) (ls (b1s-take b1s-ls nvec)) (xs (b1s-take b1s-xs nvec))
         (us (b1s-take b1s-us nvec))
         (prs (map (lambda (l x) (list 'LIST l x)) ls xs))
         (e1 (build cs prs)) (e2 (build cs us)))
    (sp (make-wff (b1s-st
      (fold-right (lambda (c b) (b1s-fa c 'CC b))
        (fold-right (lambda (l x b) (b1s-fa l 'CC (b1s-fa x '(VEC a) b))) (list '= (car e1) (cdr e1)) ls xs)
        cs))))
    (dk-peel!)
    (b1s-setup!)
    (b1s-reduce!)
    (close)
    (b1s-qed! pair-name)
    (sp (make-wff (b1s-st
      (fold-right (lambda (c b) (b1s-fa c 'CC b))
        (fold-right (lambda (u b) (b1s-fa u '(UNIT-VEC a) b)) (list '= (car e2) (cdr e2)) us)
        cs))))
    (dk-peel!)
    (let* ((etas (map b1s-eta! us))
           (f0 (apply dk-cite! pair-name 'a (append cs (append-map cdr etas)))))
      (let loop ((f f0) (prs etas) (vs us))
        (if (pair? prs) (loop (dk-rewrite-h! f (car prs) (car vs)) (cdr prs) (cdr vs))))
      (dk-ass!))
    (b1s-qed! name)))
(define (b1s-st1 p) (list b1s-ui p))
(define (b1s-ad p q) (list '(UNIT-VADD a) p q))
(define (b1s-mu p q) (list '(UNIT-VMUL a) p q))
(define (b1s-uac c p) (list '(UNIT-ACT a) c p))
(b1s-law! 'b1s-star-vadd-pair 'unitization-star-vadd 0 2
  (lambda (cs ps) (cons (b1s-st1 (b1s-ad (car ps) (cadr ps))) (b1s-ad (b1s-st1 (car ps)) (b1s-st1 (cadr ps)))))
  b1s-pair-close!)
(b1s-law! 'b1s-star-act-pair 'unitization-star-act 1 1
  (lambda (cs ps) (cons (b1s-st1 (b1s-uac (car cs) (car ps))) (b1s-uac (list 'conjugate (car cs)) (b1s-st1 (car ps)))))
  b1s-pair-close!)
(b1s-law! 'b1s-star-star-pair 'unitization-star-star 0 1
  (lambda (cs ps) (cons (b1s-st1 (b1s-st1 (car ps))) (car ps)))
  b1s-pair-close!)
(b1s-law! 'b1s-star-mul-pair 'unitization-star-mul 0 2
  (lambda (cs ps) (cons (b1s-st1 (b1s-mu (car ps) (cadr ps))) (b1s-mu (b1s-st1 (cadr ps)) (b1s-st1 (car ps)))))
  b1s-pair-close!)
(b1s-law! 'b1s-star-isom-pair 'unitization-star-isometric 0 1
  (lambda (cs ps) (cons (list '(UNIT-VNRM a) (b1s-st1 (car ps))) (list '(UNIT-VNRM a) (car ps))))
  b1s-norm-close!)
(display "\n;; B1S stage 3 qed failures: ")  

;;; ---- (4) Proposition 1.18 ----------------------------------------------------------------------------
(define b1s-Ws '(UNITIZATION-STAR a))
(define b1s-components
  (list '(SCAL (NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)) '(VEC (UNIT-VEC a)) '(VADD (UNIT-VADD a))
        '(VZERO (LIST 0 (VZERO a))) '(VNEG (UNIT-VNEG a)) '(ACT (UNIT-ACT a)) '(VNRM (UNIT-VNRM a))
        '(VMUL (UNIT-VMUL a)) '(VONE (LIST 1 (VZERO a))) (list 'VSTAR b1s-ui)))
(define b1s-L10 (cons 'LIST (map cadr b1s-components)))
(define b1s-L9 (cons 'LIST (map cadr (list-head b1s-components 9))))
(define (b1s-ro-name acc) (symbol-append 'b1s-ro- (b1s-lc acc)))
;;; the unfold of UNITIZATION
(sp (make-wff (list 'FORALL 'a (list '== '(UNITIZATION a) b1s-L9))))
(di)
(mac 'UNITIZATION)
(qrfl)
(b1s-qed! 'unitization-unfold)
(define (b1s-typings!)                   ; every component of the 10-tuple typed, in context
  (b1s-setup!)
  (dk-cite! 'cc-is-set)
  (dk-cite! 'bal-cna-vec-set b1s-V)
  (b1s-down (list 'IN (list 'VEC b1s-V) 'SET))
  (for-each (lambda (n) (b1s-cite-at-a! n '()))
            '(kuc-uv-set kuc-zero-in b1u-one-in kuc-typ-vadd kuc-typ-vneg kuc-typ-act kuc-typ-vnrm kuc-typ-vmul))
  (dk-cite! 'b1s-typ-istar 'a)
  (dk-cite! 'cc-is-normed-field)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD))
(for-each
  (lambda (e)
    (let ((acc (car e)) (val (cadr e)))
      (sp (make-wff (b1s-st (list '== (list acc b1s-Ws) val))))
      (dk-peel!)
      (b1s-typings!)
      (dk-have! (list 'IN b1s-L10 'SET) (lambda () (dk-list-in-set!)))
      (mac 'UNITIZATION-STAR)
      (let outer ((j 0))
        (let ((g0 (dk-goal)))
          (if (dk-contains? g0 acc) (quietly (lambda () (slot acc))))
          (let loop ((k 0))
            (let ((g (dk-goal)))
              (quietly (lambda () (nth-r)))
              (if (and (< k 6) (not (equal? g (dk-goal)))) (loop (+ k 1)))))
          (if (and (< j 4) (not (alpha-equiv? (cadr (dk-goal)) (caddr (dk-goal))))
                   (not (equal? g0 (dk-goal))))
              (outer (+ j 1)))))
      (qrfl)
      (b1s-qed! (b1s-ro-name acc))))
  b1s-components)

(define (b1s-close-leaf!)
  (let* ((g (dk-goal)) (h (dk-head g)))
    (cond ((dk-asm? g) (dk-ass!))
          ((and (eq? h '=) (dk-head-is? (cadr g) 'LENGTH)) (mac 'UNITIZATION-STAR) (len-r) (arith))
          ((eq? h 'IS-RING)
           (dk-cite! 'commutative-ring-is-ring '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD)) (dk-ass!))
          ((and (eq? h '=) (equal? (cadr g) (caddr g))) (rfl))
          ((eq? h 'IS-UNITAL-BANACH-ALGEBRA)
           (dk-cite! 'nuiba-as-cba-is-complex-banach-algebra 'a)
           (let* ((f (dk-cite! 'unitization-is-unital-banach-algebra b1s-V))
                  (e (dk-cite! 'unitization-unfold b1s-V))
                  (f1 (dk-rewrite-h! f (list 'UNITIZATION b1s-V) (b1s-sym-replace 'a b1s-V b1s-L9))))
             (b1s-down f1)
             (dk-ass!)))
          (#t (error "b1s-close-leaf!: unexpected conjunct" (expression->string g))))))
(define (b1s-guard tag thunk)
  (call-with-current-continuation
    (lambda (k) (with-exception-handler
                  (lambda (e) (display "\n;; B1S LEAF FAILED ") (display tag) (display ": ")
                          (display (if (condition? e) (condition/report-string e) e)) (newline) (k #f))
                  thunk))))
;;; THE UNITIZATION OF AN INVOLUTIVE BANACH ALGEBRA IS AN INVOLUTIVE BANACH ALGEBRA (Prop. 1.18)
(sp (make-wff (b1s-st (list 'IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA b1s-Ws))))
(dk-peel!)
(b1s-typings!)
(for-each (lambda (n) (dk-cite! n 'a))
          '(unitization-star-vadd unitization-star-act unitization-star-star unitization-star-mul
            unitization-star-isometric))
(mac 'IS-UNITAL-INVOLUTIVE-BANACH-ALGEBRA)
(dk-isx-set! 'UNITIZATION-STAR)
(for-each (lambda (e)
            (let ((t (list (car e) b1s-Ws)))
              (if (dk--occurs? t (dk-goal))
                  (begin (dk-cite! (b1s-ro-name (car e)) 'a)
                         (subst (list '= t (cadr e)))))))
          b1s-components)
(vnb-guard (lambda () (quietly (lambda () (mac 'cc-scalar-ring-carr)))))
(let loop ((k 0))
  (let ((l (find-first (lambda (l) (dk-head-is? (dk-goal-of l) 'AND)) (dk-open-leaves))))
    (if (and l (< k 80)) (begin (dk-focus! l) (di) (loop (+ k 1))))))
(for-each (lambda (l)
            (if (not (sequent-node-grounded? l))
                (begin (dk-focus! l)
                       (b1s-guard (expression->string (dk-goal-of l)) b1s-close-leaf!))))
          (dk-open-leaves))
(b1s-qed! 'unitization-is-involutive-banach-algebra)
(display "\n;; B1S qed failures: ")  
