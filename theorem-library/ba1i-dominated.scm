;;; ba1i-dominated.scm -- completeness passes to a metric that is DOMINATED both ways by a complete one.
;;;   complete-of-dominated-metric: s complete, t a metric space on the same points, d_s <= d_t <= 2 d_s
;;;   => t complete.  (The sum metric on a product is between the max metric and twice it; with
;;;   product2-complete this gives the completeness of C x A under ||(l, x)|| = |l| + ||x||, the
;;;   unitization of a Banach algebra, Thayer, Banach Algebras, Prop. 1.18.)
;;; Agent BA-1I, 2026-11-10.  Destination: theorem-library/ba1i-dominated.scm.  Library: analysis.
;;; All proofs modulo 0.  Helper prefix dmc-.  Binders dmp_ dmq_.
;;; Load window: after structure-library/metric-completeness (IS-COMPLETE, IS-CAUCHY-SEQ, CONVERGES-TO)
;;; and metric-dist-real; uses no other library theorem.

(define (dmc-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (dmc-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (dmc-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
;;; the conjuncts of the right side of IFF (in context), each landed; the one equal to the goal last
(define (dmc-iff-parts! iff)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc)))))
         (goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
         (opener (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
         (rest (filter (lambda (c) (not (goal? c))) cs))
         (last (filter goal? cs)))
    (append (dmc-map (lambda (c) (dmc-project! c opener)) rest)
            (dmc-map (lambda (c) (dmc-project! c opener)) last))))
(define (dmc-and-close! closer)
  (if (dk-head-is? (dk-goal) 'AND)
      (for-each (lambda (k) (dk-focus! k) (dmc-and-close! closer)) (dk-opened (lambda () (di))))
      (closer)))
(define (dmc-find tag pred lst)
  (or (find-first pred lst) (error "dmc-find: nothing matches at" tag (map expression->string lst))))
(define (dmc-iff-back! iff)           ; the right side of an IFF in context: land the left side
  (ai iff)
  (detach! (list 'IMPLIES (caddr iff) (cadr iff))))
(define (dmc-nn-vars lm) (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) lm)))

(define dmc-stmt
  '(FORALL s (IMPLIES (IS-COMPLETE s)
     (FORALL t (IMPLIES (IS-METRIC-SPACE t)
       (IMPLIES (= (PTS t) (PTS s))
         (IMPLIES (FORALL dmp_ (IMPLIES (IN dmp_ (PTS t)) (FORALL dmq_ (IMPLIES (IN dmq_ (PTS t))
                    (<= ((DIST s) dmp_ dmq_) ((DIST t) dmp_ dmq_))))))
           (IMPLIES (FORALL dmp_ (IMPLIES (IN dmp_ (PTS t)) (FORALL dmq_ (IMPLIES (IN dmq_ (PTS t))
                      (<= ((DIST t) dmp_ dmq_) (* 2 ((DIST s) dmp_ dmq_)))))))
             (IS-COMPLETE t)))))))))

(sp (make-wff dmc-stmt))
(define dmc-hyps (dk-peel!))
(define dmc-dom1 (dmc-find 'dom1 (lambda (f) (and (dk-head-is? f 'FORALL) (not (dk-contains? f '*)))) (dk-asms)))
(define dmc-dom2 (dmc-find 'dom2 (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '*))) (dk-asms)))
(define dmc-cs (cadr (dmc-iff-parts! (dk-cite! 'is-complete 's))))
(define (dmc-pt! f fty-cls k) (if (not (dk-asm? (list 'IN (list f k) fty-cls))) (dk-cite! 'fun-apply-type-c f 'NN fty-cls k)))
(let ((iff (dk-cite! 'is-complete 't)))
  (dk-have! (caddr iff)
    (lambda ()
      (dmc-and-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (ass)
              (let* ((u (caddr (dmc-find 'ucs (lambda (f) (dk-head-is? f 'IS-CAUCHY-SEQ)) (dk-peel!))))
                     (cu (dmc-iff-parts! (dk-cite! 'is-cauchy-seq 't u)))
                     (cuu (dmc-find 'cu (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR))) cu)))
                (dk-have! (list 'IN u '(FUN NN (PTS s))) (lambda () (subst '(= (PTS s) (PTS t))) (dmc-close-open!)))
                ;; u is Cauchy in s: d_s <= d_t
                (let ((iffc (dk-cite! 'is-cauchy-seq 's u)))
                  (dk-have! (caddr iffc)
                    (lambda ()
                      (dmc-and-close!
                        (lambda ()
                          (if (dk-asm? (dk-goal)) (ass)
                              (let* ((eps (cadr (car (dk-peel!))))
                                     (n (dk-skolem! (dk-apply! cuu eps))))
                                (dk-split-all!)
                                (ew n)
                                (dmc-and-close!
                                  (lambda ()
                                    (if (dk-asm? (dk-goal)) (ass)
                                        (let* ((ms (dmc-nn-vars (dk-peel!)))
                                               (m1 (car ms)) (m2 (cadr ms))
                                               (cun (dmc-find 'cun (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n)
                                                                                    (dk-contains? f 'DIST))) (dk-asms)))
                                               (le (dk-apply! cun m1 m2))
                                               (x1 (list u m1)) (x2 (list u m2))
                                               (dt (list '(DIST t) x1 x2)) (ds (list '(DIST s) x1 x2)))
                                          (dmc-pt! u '(PTS t) m1) (dmc-pt! u '(PTS t) m2)
                                          (dmc-pt! u '(PTS s) m1) (dmc-pt! u '(PTS s) m2)
                                          (dk-apply! dmc-dom1 x1 x2)
                                          (dk-cite! 'metric-dist-real 's x1 x2)
                                          (dk-cite! 'metric-dist-real 't x1 x2)
                                          (dk-cite! 'rr-pos-rr-in-rr eps)
                                          (dk-ineq! (list '<= ds dt) le (list 'IN dt 'RR) (list 'IN ds 'RR) (list 'IN eps 'RR))))))))))))
                  (dmc-iff-back! iffc))
                ;; its limit L in s
                (dk-apply! dmc-cs u)
                (let* ((L (dk-skolem! (car (dmc-iff-parts! (dk-cite! 'converges 's u)))))
                       (cv (dmc-iff-parts! (dk-cite! 'converges-to 's u L)))
                       (cvs (dmc-find 'cv (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'POS-RR))) cv)))
                  ;; u converges to L in t: d_t <= 2 d_s
                  (let ((iff2 (dk-cite! 'converges-to 't u L)))
                    (dk-have! (caddr iff2)
                      (lambda ()
                        (dmc-and-close!
                          (lambda ()
                            (cond ((dk-asm? (dk-goal)) (ass))
                                  ((equal? (dk-goal) (list 'IN L '(PTS t)))
                                   (subst '(= (PTS t) (PTS s))) (dmc-close-open!))
                                  (#t
                                   (let* ((eps (cadr (car (dk-peel!))))
                                          (d (dk-halve! eps))
                                          (nn (dk-skolem! (dk-apply! cvs d))))
                                     (dk-split-all!)
                                     (ew nn)
                                     (dmc-and-close!
                                       (lambda ()
                                         (if (dk-asm? (dk-goal)) (ass)
                                             (let* ((k (car (dmc-nn-vars (dk-peel!))))
                                                    (cvn (dmc-find 'cvn (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nn)
                                                                                         (dk-contains? f 'DIST))) (dk-asms)))
                                                    (le (dk-apply! cvn k))
                                                    (x1 (list u k))
                                                    (dt (list '(DIST t) x1 L)) (ds (list '(DIST s) x1 L)))
                                               (dmc-pt! u '(PTS t) k) (dmc-pt! u '(PTS s) k)
                                               (if (not (dk-asm? (list 'IN L '(PTS t))))
                                                   (dk-have! (list 'IN L '(PTS t)) (lambda () (subst '(= (PTS t) (PTS s))) (dmc-close-open!))))
                                               (let ((le2 (dk-apply! dmc-dom2 x1 L)))
                                                 (dk-cite! 'metric-dist-real 's x1 L)
                                                 (dk-cite! 'metric-dist-real 't x1 L)
                                                 (dk-cite! 'rr-pos-rr-in-rr eps)
                                                 (dk-ineq! le2 le (list '= (list '+ d d) eps)
                                                           (list 'IN dt 'RR) (list 'IN ds 'RR) (list 'IN d 'RR) (list 'IN eps 'RR))))))))))))))
                    (dmc-iff-back! iff2))
                  (let ((iffv (dk-cite! 'converges 't u)))
                    (dk-have! (caddr iffv) (lambda () (ew L) (dmc-close-open!)))
                    (dmc-iff-back! iffv)
                    (dmc-close-open!)))))))))
  (dmc-iff-back! iff))
(dmc-close-open!)
(qed 'complete-of-dominated-metric)
(topic! 'complete-of-dominated-metric 'analysis)
(display "\n;; DMC qed failures: ")  
