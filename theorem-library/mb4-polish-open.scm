;;; the typings of d(u, v) and |g(u) - g(v)| for u, v in A
(define (mpo-gtyp! u v)
  (dk-cite! 'subset-mem-fwd 'A '(PTS s) u)
  (dk-cite! 'subset-mem-fwd 'A '(PTS s) v)
  (dk-cite! 'metric-dist-real 's u v)
  (dk-cite! 'metric-pos 's u v)
  (dk-cite! 'fun-apply-type-c 'g 'A 'RR u)
  (dk-cite! 'fun-apply-type-c 'g 'A 'RR v)
  (let ((df (list '- (list 'g u) (list 'g v))))
    (dk-cite! 'rr-sub-in-rr (list 'g u) (list 'g v))
    (dk-cite! 'rr-abs-closed df)
    (dk-cite! 'rr-abs-nonneg df)
    (list (list '(DIST s) u v) (list 'ABS df))))
(define (mpo-glaw!)
  (let ((g (dk-goal)))
    (cond
      ;; d(u,u) + |g u - g u| = 0
      ((and (eq? (mpo-head g) '=) (equal? (caddr g) 0))
       (let* ((u (cadr (cadr (cadr g)))) (ts (mpo-gtyp! u u)) (df (list '- (list 'g u) (list 'g u))))
         (dk-cite! 'metric-self-zero 's u)
         (dk-have! (list '= df 0) (lambda () (dk-ineq!)))
         (dk-have! (list '= (list 'ABS df) 0)
           (lambda () (subst (list '= df 0)) (fact 'rr-abs-zero-value) (mpo-close-open!)))
         (dk-ineq! (list '= (car ts) 0) (list '= (cadr ts) 0))))
      ;; 0 <= d(u,v) + |...|
      ((and (eq? (mpo-head g) '<=) (equal? (cadr g) 0))
       (let* ((d (cadr (caddr g))) (ts (mpo-gtyp! (cadr d) (caddr d))))
         (dk-ineq! (list '<= 0 (car ts)) (list '<= 0 (cadr ts)))))
      ;; separation: the sum is 0 in context
      ((and (eq? (mpo-head g) '=) (symbol? (cadr g)))
       (let* ((u (cadr g)) (v (caddr g)) (ts (mpo-gtyp! u v))
              (sum (list '+ (car ts) (cadr ts))))
         (dk-have! (list '= (car ts) 0)
           (lambda () (dk-ineq! (list '= sum 0) (list '<= 0 (car ts)) (list '<= 0 (cadr ts)))))
         (dk-cite! 'metric-zero-eq 's u v)
         (mpo-close-open!)))
      ;; symmetry
      ((eq? (mpo-head g) '=)
       (let* ((d (cadr (cadr g))) (u (cadr d)) (v (caddr d)))
         (mpo-gtyp! u v) (mpo-gtyp! v u)
         (dk-cite! 'metric-sym 's u v)
         (dk-cite! 'rr-abs-sub-sym (list 'g u) (list 'g v))
         (dk-ineq! (list '= (list '(DIST s) u v) (list '(DIST s) v u))
                   (list '= (list 'ABS (list '- (list 'g u) (list 'g v))) (list 'ABS (list '- (list 'g v) (list 'g u)))))))
      ;; triangle: (<= (+ d(u,w) |gu-gw|) (+ (+ d(u,v) |gu-gv|) (+ d(v,w) |gv-gw|)))
      ((eq? (mpo-head g) '<=)
       (let* ((duw (cadr (cadr g))) (u (cadr duw)) (w (caddr duw))
              (v (caddr (cadr (cadr (caddr g)))))
              (gu (list 'g u)) (gv (list 'g v)) (gw (list 'g w))
              (a1 (list '- gu gv)) (a2 (list '- gv gw)) (a3 (list '- gu gw)))
         (mpo-gtyp! u v) (mpo-gtyp! v w) (mpo-gtyp! u w)
         (dk-cite! 'metric-triangle 's u v w)
         (dk-cite! 'rr-abs-triangle-c a1 a2)
         (dk-have! (list '= a3 (list '+ a1 a2)) (lambda () (crs)))
         (dk-have! (list '<= (list 'ABS a3) (list '+ (list 'ABS a1) (list 'ABS a2)))
           (lambda () (subst (list '= a3 (list '+ a1 a2))) (mpo-close-open!)))
         (dk-ineq! (list '<= (list '(DIST s) u w) (list '+ (list '(DIST s) u v) (list '(DIST s) v w)))
                   (list '<= (list 'ABS a3) (list '+ (list 'ABS a1) (list 'ABS a2))))))
      (#t (error "mpo-glaw!: unexpected leaf" g)))))

(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (FORALL A (IMPLIES (SUBSET A (PTS s))
  (FORALL g (IMPLIES (IN g (FUN A RR)) (IS-METRIC-SPACE (GRAPH-MS s A g))))))))))
