;;; mb4-polish-open.scm -- construction of measures, Lemma 5.18 (M-B4, 2026-10-26): an open set U of a Polish
;;; space X is itself Polish -- there is a complete separable metric space homeomorphic to U, namely the
;;; points of U with d'(x, y) = d(x, y) + |1/d(x, X\U) - 1/d(y, X\U)|, the metric U inherits as the graph
;;; Y = {(x, t) : d(x, X\U) t = 1} of the notes' proof (with the sum metric on X x R in place of the max).
;;; Vocabulary: mb4-vocab.scm (IS-POLISH, GRAPH-MS).  Library: measure.  Helper prefix mpo-.
;;;
;;;   graph-ms-pts, graph-ms-dist-slot, graph-ms-dist, graph-ms-is-metric-space   the graph metric
;;;   recip-near            1/v is close to 1/c once v is close to c > 0 (an explicit delta)
;;;   pt-set-dist-le, pt-set-dist-real, pt-set-dist-lipschitz, pt-set-dist-open-pos   d(., E)
;;;   graph-ms-near         g continuous: d-close points are d'-close
;;;   coarser-metric-separable   a metric on a nonempty subset A of a separable space, continuous w.r.t. d,
;;;                         is separable
;;;   graph-ms-homeomorphism     the identity of A, from (A, d') onto the subspace (A, d)
;;;   graph-ms-complete     s complete, g continuous and unbounded above near the boundary  ==>  (A, d') complete
;;;   graph-ms-polish       the assembly
;;;   polish-open-subspace  (Lemma 5.18) a nonempty open U of a Polish space is homeomorphic to a Polish space
;;;
;;; Load window: after structure-library/calc3-vocab (IS-HOMEOMORPHISM, load.scm 3734) and mb4-vocab; cites
;;; theorem-library/sip-d1 (ms-cauchy-of-dominated), metric-outer-measure (pt-set-dist-ge-intro),
;;; riesz-markov-model (rmm-nn-choice), metric-subspace-laws, rake-inverse-bij, nn-pairing.

(define (mpo-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (mpo-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))
(define (mpo-head g) (and (pair? g) (car g)))
(define (mpo-has-lam? g)
  (cond ((and (pair? g) (pair? (car g)) (eq? (caar g) 'VNB-LAMBDA)) #t)
        ((pair? g) (or (mpo-has-lam? (car g)) (mpo-has-lam? (cdr g))))
        (#t #f)))
(define (mpo-beta!)
  (let loop ((fuel 20))
    (if (and (> fuel 0) (mpo-has-lam? (dk-goal)))
        (let ((before (dk-goal))) (lam-b)
          (if (equal? (dk-goal) before) #t (loop (- fuel 1))))
        #t)))
(define (mpo-drive!)
  (let loop ((fuel 200))
    (let ((k (find-first (lambda (n) (memq (mpo-head (dk-goal-of n)) '(FORALL IMPLIES AND)))
                         (dk-open-leaves))))
      (if (and k (> fuel 0))
          (begin (dk-focus! k) (mpo-beta!)
                 (if (memq (mpo-head (dk-goal)) '(FORALL IMPLIES AND)) (di) #t)
                 (loop (- fuel 1)))
          #t))))
(define (mpo-and! closer)
  (if (eq? (mpo-head (dk-goal)) 'AND)
      (for-each (lambda (k) (dk-focus! k) (mpo-and! closer))
                (dk-opened (lambda () (di))))
      (closer)))
;;; the right-hand conjuncts of an IFF whose left side is in context, landed (mbk-iff-parts!, mb4-borel-product)
(define (mpo-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (mpo-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
(define (mpo-iff-parts! iff)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (mpo-map (lambda (c) (mpo-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))) cs)))
;;; (NOT (= a b)) from (< a b) or (< b a) in context
(define (mpo-ne! a b lt)
  (dk-have! (list 'NOT (list '= a b))
    (lambda ()
      (di)
      (dk-have! '(< 0 0) (lambda () (dk-ineq! lt (list '= a b))))
      (if (not (dk-asm? '(IN 0 RR))) (fact 'rr-zero-in))
      (ai (dk-cite! 'rr-lt-irrefl 0)))))

