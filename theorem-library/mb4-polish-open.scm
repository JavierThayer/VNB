(sp (make-wff '(FORALL c (IMPLIES (IN c RR) (IMPLIES (< 0 c) (FORALL eps (IMPLIES (POS-RR eps)
  (FORSOME delta (AND (POS-RR delta) (FORALL v (IMPLIES (IN v RR) (IMPLIES (<= (ABS (- c v)) delta)
    (AND (< 0 v) (<= (ABS (- (RECIP c) (RECIP v))) eps))))))))))))))
(dk-peel!)
(dk-cite! 'rr-pos-rr-in-rr 'eps) (dk-cite! 'rr-lt-of-pos-rr 'eps)
(define mpr-h '(* 1/2 c))
(dk-type! mpr-h 'RR)
(dk-have! (list '< 0 mpr-h) (lambda () (dk-ineq! '(< 0 c))))
(define (mpr-recip! a)          ; a in RR, 0 < a in context: recip(a) typed, positive, a * recip(a) = 1
  (mpo-ne! a 0 (list '< 0 a))
  (mpo-chain! (dk-fact! 'rr-recip-closed a))
  (mpo-chain! (dk-fact! 'rr-recip-inverse a))
  (dk-cite! 'rr-recip-pos a))
;;; name recip(a): returns the name, with (< 0 name) and (= (* a name) 1) landed
(define (mpr-name-recip! a)
  (mpr-recip! a)
  (let ((nm (dk-name! (list 'RECIP a))))
    (dk-have! (list '< 0 nm) (lambda () (dk-ineq! (list '< 0 (list 'RECIP a)) (list '= nm (list 'RECIP a)))))
    (dk-have! (list '= (list '* a nm) 1) (lambda () (subst (list '= nm (list 'RECIP a))) (mpo-close-open!)))
    nm))
(define (mpr-name-prod! a b)   ; a, b named positive reals: name a * b, with (< 0 name)
  (dk-type! (list '* a b) 'RR)
  (dk-cite! 'rr-mul-pos a b)
  (let ((nm (dk-name! (list '* a b))))
    (dk-have! (list '< 0 nm) (lambda () (dk-ineq! (list '< 0 (list '* a b)) (list '= nm (list '* a b)))))
    nm))
(define mpr-p (mpr-name-recip! 'c))
(define mpr-p2 (mpr-name-recip! mpr-h))
(define mpr-k (mpr-name-prod! mpr-p2 mpr-p))
(define mpr-rk (mpr-name-recip! mpr-k))
(define mpr-e2 (mpr-name-prod! 'eps mpr-rk))
(define mpr-w (dk-skolem! (dk-cite! 'rr-min-pos mpr-h mpr-e2)))
(dk-split-all!)
(ew mpr-w)
(for-each
 (lambda (k)
   (dk-focus! k)
   (if (dk-head-is? (dk-goal) 'POS-RR)
       (begin (dk-cite! 'rr-pos-rr-of-lt mpr-w) (mpo-close-open!))
       (let* ((lk (dk-peel!))
              (hyp (find-first (lambda (f) (dk-head-is? f '<=)) lk))
              (v (caddr (cadr (cadr hyp))))
              (cv (list '- 'c v)))
         (dk-cite! 'rr-sub-in-rr 'c v)
         (dk-split-all! (list (dk-cite! 'rr-abs-le-parts cv mpr-w)))
         (dk-have! (list '<= mpr-h v) (lambda () (dk-ineq! (list '<= cv mpr-w) (list '<= mpr-w mpr-h))))
         (dk-have! (list '< 0 v) (lambda () (dk-ineq! (list '<= mpr-h v) (list '< 0 mpr-h))))
         (for-each
          (lambda (j)
            (dk-focus! j)
            (if (dk-asm? (dk-goal))
                (ass)
                (let* ((q (begin (dk-cite! 'rr-recip-antitone mpr-h v) (mpr-name-recip! v)))
                       (p mpr-p) (vc (list '- v 'c)) (qp (list '* q p))
                       (id1 (list '= (list '* qp vc) (list '- (list '* p (list '* v q)) (list '* q (list '* 'c p)))))
                       (id2 (list '= (list '- p q) (list '* qp vc))))
                  (dk-have! (list '<= q mpr-p2)
                    (lambda () (dk-ineq! (list '<= (list 'RECIP v) (list 'RECIP mpr-h))
                                         (list '= q (list 'RECIP v)) (list '= mpr-p2 (list 'RECIP mpr-h)))))
                  (dk-have! id1 (lambda () (crs)))
                  (dk-have! id2 (lambda () (subst id1) (subst (list '= (list '* v q) 1)) (subst (list '= (list '* 'c p) 1)) (crs)))
                  (dk-cite! 'rr-sub-in-rr v 'c)
                  (dk-type! qp 'RR)
                  (mpo-chain! (dk-fact! 'rr-abs-mult qp vc))
                  (dk-cite! 'rr-mul-pos q p)
                  (dk-have! (list '<= 0 qp) (lambda () (dk-ineq! (list '< 0 qp))))
                  (dk-cite! 'rr-abs-of-nonneg qp)
                  (dk-cite! 'rr-abs-sub-sym v 'c)
                  (dk-cite! 'rr-abs-closed cv)
                  (dk-cite! 'rr-abs-nonneg cv)
                  (let* ((pq (dk-name! qp)) (aa (dk-name! (list 'ABS cv))))
                    (dk-have! (list '= (list 'ABS (list '- p q)) (list '* pq aa))
                      (lambda ()
                        (subst (list '= pq qp)) (subst (list '= aa (list 'ABS cv)))
                        (subst id2)
                        (subst (list '= (list 'ABS (list '* qp vc)) (list '* (list 'ABS qp) (list 'ABS vc))))
                        (subst (list '= (list 'ABS qp) qp))
                        (subst (list '= (list 'ABS vc) (list 'ABS cv)))
                        (rfl)))
                    (if (not (dk-asm? (list '<= 0 p))) (dk-have! (list '<= 0 p) (lambda () (dk-ineq! (list '< 0 p)))))
                    (dk-cite! 'rr-mul-le-right q mpr-p2 p)
                    (dk-type! (list '* mpr-p2 p) 'RR)
                    (dk-have! (list '<= pq mpr-k)
                      (lambda () (dk-ineq! (list '<= qp (list '* mpr-p2 p)) (list '= pq qp) (list '= mpr-k (list '* mpr-p2 p)))))
                    (dk-have! (list '<= 0 aa) (lambda () (dk-ineq! (list '<= 0 (list 'ABS cv)) (list '= aa (list 'ABS cv)))))
                    (dk-cite! 'rr-mul-le-right pq mpr-k aa)
                    (dk-have! (list '<= aa mpr-e2)
                      (lambda () (dk-ineq! (list '<= (list 'ABS cv) mpr-w) (list '<= mpr-w mpr-e2) (list '= aa (list 'ABS cv)))))
                    (dk-have! (list '<= 0 mpr-k) (lambda () (dk-ineq! (list '< 0 mpr-k))))
                    (dk-cite! 'rr-mul-le-right aa mpr-e2 mpr-k)
                    (mpo-chain! (dk-fact! 'rr-mul-comm mpr-k aa))
                    (let ((e3a (list '= (list '* (list '* 'eps mpr-rk) mpr-k) (list '* 'eps (list '* mpr-k mpr-rk)))))
                      (dk-have! e3a (lambda () (crs)))
                      (dk-have! (list '= (list '* mpr-e2 mpr-k) 'eps)
                        (lambda ()
                          (subst (list '= mpr-e2 (list '* 'eps mpr-rk)))
                          (subst e3a)
                          (subst (list '= (list '* mpr-k mpr-rk) 1))
                          (crs))))
                    (subst (list '= '(RECIP c) p))
                    (subst (list '= (list 'RECIP v) q))
                    (dk-cite! 'rr-sub-in-rr p q)
                    (dk-cite! 'rr-abs-closed (list '- p q))
                    (dk-le-chain! (list 'ABS (list '- p q)) (list '* pq aa) (list '* mpr-k aa) (list '* aa mpr-k)
                                  (list '* mpr-e2 mpr-k) 'eps)))))
          (dk-opened (lambda () (di)))))))
 (dk-opened (lambda () (di))))
