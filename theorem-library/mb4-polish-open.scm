   (if (dk-asm? (dk-goal))
       (ass)
       (let* ((lk (dk-peel!))
              (cy (find-first (lambda (f) (dk-head-is? f 'IS-CAUCHY-SEQ)) lk))
              (f (caddr cy))
              (cparts (mpo-iff-parts! (dk-cite! 'is-cauchy-seq mph-G f)))
              (cc (caddr cparts))
              (fin (dk-rewrite-h! (cadr cparts) (list 'PTS mph-G) 'A))
              (fa! (lambda (t) (dk-cite! 'fun-apply-type-c f 'NN 'A t))))
         (dk-cite! 'fun-codomain-superset f 'NN 'A '(PTS s))
         ;; f is Cauchy in s
         (dk-have! (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
                     (list '<= (list '(DIST s) (list f 'm) (list f 'n_)) (list (list 'DIST mph-G) (list f 'm) (list f 'n_)))))))
           (lambda ()
             (let* ((lk2 (dk-peel!))
                    (ns (map cadr (filter (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) lk2)))
                    (fm (list f (car ns))) (fn (list f (cadr ns))))
               (fa! (car ns)) (fa! (cadr ns))
               (let ((ts (mpo-gtyp! fm fn)))
                 (subst (dk-cite! 'graph-ms-dist 's 'A 'g fm fn))
                 (dk-ineq! (list '<= 0 (cadr ts)))))))
         (dk-cite! 'ms-cauchy-of-dominated mph-G 's f f)
         (dk-apply! mpk-cpl f)
         (let* ((lx (car (mpo-iff-parts! (dk-cite! 'converges 's f))))
                (l (dk-skolem! lx))
                (vparts (mpo-iff-parts! (dk-cite! 'converges-to 's f l)))
                (cv (cadddr vparts))
                (_0 (begin (dk-type! 1 'RR) (dk-have! '(< 0 1) (lambda () (dk-ineq!))) (dk-cite! 'rr-pos-rr-of-lt 1)))
                (n0 (dk-skolem! (dk-apply! cc 1)))
                (cn (begin (dk-split-all!) (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x n0) (dk-contains? x 'GRAPH-MS))) "the Cauchy clause")))
                (gN (list 'g (list f n0)))
                (c (list '+ gN 1))
                (bd (list 'FORALL 'gk_ (list 'IMPLIES '(IN gk_ NN) (list 'IMPLIES (list '<= n0 'gk_) (list '<= (list 'g (list f 'gk_)) c))))))
           (fa! n0)
           (dk-cite! 'fun-apply-type-c 'g 'A 'RR (list f n0))
           (dk-type! c 'RR)
           (dk-cite! 'nn-le-refl n0)
           (dk-have! bd
             (lambda ()
               (let* ((lk3 (dk-peel!))
                      (k (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) lk3)))
                      (fk (list f k)) (fnz (list f n0)))
                 (fa! k)
                 (dk-have! (list 'AND (list '<= n0 k) (list '<= n0 n0)) (lambda () (dk-conj-close! (lambda () (ass)))))
                 (let* ((le1 (dk-apply! cn k n0))
                        (ts (mpo-gtyp! fk fnz))
                        (le2 (begin (dk-cite! 'graph-ms-dist 's 'A 'g fk fnz)
                                    (dk-rewrite-h! le1 (list (list 'DIST mph-G) fk fnz) (list '+ (car ts) (cadr ts)))))
                        (x (cadr (cadr ts))))
                   (dk-have! (list '<= (cadr ts) (cadr ts)) (lambda () (dk-ineq!)))
                   (dk-split-all! (list (dk-cite! 'rr-abs-le-parts x (cadr ts))))
                   (dk-ineq! le2 (list '<= 0 (car ts)) (list '<= x (cadr ts)))))))
           (dk-apply! mpo-GH2 f l c n0)
           ;; the limit in the graph metric
           (mac 'converges)
           (ew l)
           (mac 'converges-to)
           (mac 'graph-ms-pts)
           (mpo-and!
            (lambda ()
              (let ((g1 (dk-goal)))
                (cond
                  ((dk-asm? g1) (ass))
                  ((dk-head-is? g1 'FORALL)
                   (let* ((lk4 (dk-peel!))
                          (eps (cadr (find-first (lambda (x) (dk-head-is? x 'POS-RR)) lk4)))
                          (_1 (dk-cite! 'rr-pos-rr-in-rr eps))
                          (e (dk-halve! eps))
                          (d1 (dk-skolem! (dk-apply! mpo-GH1 l e)))
                          (cl1 (begin (dk-split-all!) (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x 'gy_) (dk-contains? x d1))) "the g clause")))
                          (w (begin (dk-cite! 'rr-pos-rr-in-rr d1) (dk-cite! 'rr-lt-of-pos-rr d1) (dk-skolem! (dk-cite! 'rr-min-pos d1 e))))
                          (_2 (begin (dk-split-all!) (dk-cite! 'rr-pos-rr-of-lt w)))
                          (n1 (dk-skolem! (dk-apply! cv w)))
                          (cv1 (begin (dk-split-all!) (dk-pick (lambda (x) (and (dk-head-is? x 'FORALL) (dk-contains? x n1) (dk-contains? x w))) "the limit clause"))))
                     (ew n1)
                     (for-each
                      (lambda (k)
                        (dk-focus! k)
                        (if (dk-asm? (dk-goal))
                            (ass)
                            (let* ((lk5 (dk-peel!))
                                   (n (cadr (find-first (lambda (x) (and (dk-head-is? x 'IN) (eq? (caddr x) 'NN))) lk5)))
                                   (fn (list f n)))
                              (fa! n)
                              (dk-apply! cv1 n)
                              (let* ((ts (mpo-gtyp! fn l)) (ts2 (mpo-gtyp! l fn)))
                                (dk-cite! 'metric-sym 's fn l)
                                (dk-have! (list '<= (car ts2) d1)
                                  (lambda () (dk-ineq! (list '<= (car ts) w) (list '<= w d1) (list '= (car ts) (car ts2)))))
                                (dk-apply! cl1 fn)
                                (dk-cite! 'rr-abs-sub-sym (list 'g l) (list 'g fn))
                                (subst (dk-cite! 'graph-ms-dist 's 'A 'g fn l))
                                (dk-ineq! (list '<= (car ts) w) (list '<= w e) (list '<= (cadr ts2) e)
                                          (list '= (cadr ts2) (cadr ts)) (list '= (list '+ e e) eps))))))
                      (dk-opened (lambda () (di))))))
                  (#t (error "graph-ms-complete: unexpected leaf" g1))))))))))
 (dk-opened (lambda () (di))))
(qed 'graph-ms-complete)
(topic! 'graph-ms-complete 'analysis)

;;; ---- assembly: the graph space of such a g is Polish and homeomorphic to the subspace A
(sp (make-wff (mpo-fill (mpo-head-pre '(IS-POLISH s)) (list 'IMPLIES mpo-GH1 (list 'IMPLIES mpo-GH2
  (list 'IMPLIES '(FORSOME z (IN z A)) (list 'AND (list 'IS-POLISH mph-G) (list 'IS-HOMEOMORPHISM mph-G mph-S mph-L))))))))
(dk-peel!)
(mpo-iff-parts! (dk-cite! 'is-polish 's))
(mpo-iff-parts! (dk-cite! 'is-complete 's))
(dk-cite! 'ms-pts-is-set 's) (dk-cite! 'subclass-of-set-is-set 'A '(PTS s))
(dk-cite! 'graph-ms-complete 's 'A 'g)
(dk-cite! 'graph-ms-homeomorphism 's 'A 'g)
(dk-cite! 'graph-ms-is-metric-space 's 'A 'g)
(dk-cite! 'graph-ms-pts 's 'A 'g)
(dk-cite! 'graph-ms-near 's 'A 'g)
(dk-cite! 'coarser-metric-separable 's 'A mph-G)
(for-each
 (lambda (k)
   (dk-focus! k)
   (if (dk-asm? (dk-goal))
       (ass)
       (begin (mac 'is-polish) (dk-conj-close! (lambda () (ass))))))
 (dk-opened (lambda () (di))))
(qed 'graph-ms-polish)
(topic! 'graph-ms-polish 'analysis)

;;; ======================================================================
;;; LEMMA 5.18: an open subset of a Polish space is Polish
;;; ======================================================================
(define mpm-F '(COMPLEMENT-IN (PTS s) u))
(define mpm-P (list 'FORSOME 'mpq_ (list 'IN 'mpq_ mpm-F)))
(define mpm-G (list 'VNB-LAMBDA 'mpx_ 'u (list 'RECIP (list 'PT-SET-DIST 's 'mpx_ mpm-F))))
(define mpm-G0 '(VNB-LAMBDA mpx_ u 0))
(define (mpm-inst tmpl gg) (subst-free 'g gg (subst-free 'A 'u tmpl)))
(define (mpm-dto x) (list 'PT-SET-DIST 's x mpm-F))
(define (mpm-pick-in lk cls) (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cls))) lk)))
(sp (make-wff '(FORALL s (IMPLIES (IS-POLISH s) (FORALL u (IMPLIES (IS-OPEN s u) (IMPLIES (FORSOME z (IN z u))
  (FORSOME t (AND (IS-POLISH t) (FORSOME h (IS-HOMEOMORPHISM t (SUBSPACE-MS s u) h)))))))))))
(dk-peel!)
(mpo-iff-parts! (dk-cite! 'is-polish 's))
(mpo-iff-parts! (dk-cite! 'is-complete 's))
(mpo-iff-parts! (dk-cite! 'is-open 's 'u))
(dk-cite! 'ms-pts-is-set 's) (dk-cite! 'subclass-of-set-is-set 'u '(PTS s))
(dk-cite! 'complement-in-subset 'u '(PTS s))
(define (mpm-finish! gg)
  (dk-split-all! (list (dk-cite! 'graph-ms-polish 's 'u gg)))
  (ew (list 'GRAPH-MS 's 'u gg))
  (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (begin (ew '(VNB-LAMBDA x_ u x_)) (ass))))))
(use-em mpm-P
  ;; X \ U nonempty: g = 1 / d(., X \ U)
  (lambda ()
    (let* ((q0 (dk-skolem! mpm-P))
           (fr! (lambda (x)              ; x in PTS s: d(x, X\U) real, >= 0
                  (dk-split-all! (list (dk-cite! 'pt-set-dist-real 's mpm-F q0 x)))
                  (mpm-dto x)))
           (fpos! (lambda (x)            ; x in u: d(x, X\U) > 0
                    (dk-cite! 'subset-mem-fwd 'u '(PTS s) x)
                    (let* ((f (fr! x))
                           (r (dk-skolem! (dk-cite! 'pt-set-dist-open-pos 's 'u x))))
                      (dk-split-all!)
                      (dk-cite! 'rr-pos-rr-in-rr r) (dk-cite! 'rr-lt-of-pos-rr r)
                      (if (not (dk-asm? (list '< 0 f)))
                          (dk-have! (list '< 0 f) (lambda () (dk-ineq! (list '< 0 r) (list '<= r f)))))
                      f))))
      (dk-have! (list 'IN mpm-G '(FUN u RR))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let* ((x (dk-di-var!)) (f (fpos! x)))
                (mpo-ne! f 0 (list '< 0 f))
                (mpo-chain! (dk-fact! 'rr-recip-closed f))
                (mpo-close-open!))))))
      ;; continuity of g
      (dk-have! (mpm-inst mpo-GH1 mpm-G)
        (lambda ()
          (let* ((lk (dk-peel!))
                 (x (mpm-pick-in lk 'u))
                 (eps (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) lk)))
                 (c (fpos! x))
                 (delta (dk-skolem! (dk-cite! 'recip-near c eps)))
                 (rn (begin (dk-split-all!) (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f delta) (dk-contains? f 'RECIP))) "recip-near clause"))))
            (dk-cite! 'rr-pos-rr-in-rr delta)
            (ew delta)
            (for-each
             (lambda (k)
               (dk-focus! k)
               (if (dk-asm? (dk-goal))
                   (ass)
                   (let* ((lk2 (dk-peel!))
                          (y (mpm-pick-in lk2 'u))
                          (cy (fpos! y))
                          (dxy (list '(DIST s) x y)) (dyx (list '(DIST s) y x)) (df (list '- c cy)))
                     (dk-cite! 'pt-set-dist-lipschitz 's mpm-F q0 x y)
                     (dk-cite! 'pt-set-dist-lipschitz 's mpm-F q0 y x)
                     (dk-cite! 'metric-dist-real 's x y) (dk-cite! 'metric-dist-real 's y x)
                     (dk-cite! 'metric-sym 's x y)
                     (dk-cite! 'rr-sub-in-rr c cy)
                     (dk-have! (list '<= df delta)
                       (lambda () (dk-ineq! (list '<= c (list '+ dxy cy)) (list '<= dxy delta))))
                     (dk-have! (list '<= (list '- delta) df)
                       (lambda () (dk-ineq! (list '<= cy (list '+ dyx c)) (list '= dxy dyx) (list '<= dxy delta))))
                     (dk-cite! 'rr-abs-le-of-parts df delta)
                     (dk-split-all! (list (dk-apply! rn cy)))
                     (dk-lam-b!)
                     (mpo-close-open!))))
             (dk-opened (lambda () (di)))))))
      ;; g blows up at the boundary
      (dk-have! (mpm-inst mpo-GH2 mpm-G)
        (lambda ()
          (let* ((lk (dk-peel!))
                 (h (mpm-pick-in lk '(FUN NN u)))
                 (l (mpm-pick-in lk '(PTS s)))
                 (c (mpm-pick-in lk 'RR))
                 (n0 (mpm-pick-in lk 'NN))
                 (bd (find-first (lambda (f) (dk-head-is? f 'FORALL)) lk)))
            (pbc)
            (dk-have! (list 'IN l mpm-F) (lambda () (mac 'complement-in-membership) (dk-conj-close! (lambda () (ass)))))
            (let* ((fl (fr! l))
                   (ac (list 'ABS c))
                   (m1 (list '+ ac 1))
                   (rm (list 'RECIP m1)))
              (dk-cite! 'pt-set-dist-le 's mpm-F l l)
              (dk-cite! 'metric-self-zero 's l)
              (dk-cite! 'metric-dist-real 's l l)
              (dk-cite! 'rr-abs-closed c) (dk-cite! 'rr-abs-nonneg c)
              (dk-have! (list '<= ac ac) (lambda () (dk-ineq!)))
              (dk-split-all! (list (dk-cite! 'rr-abs-le-parts c ac)))
              (dk-type! m1 'RR)
              (dk-have! (list '< 0 m1) (lambda () (dk-ineq! (list '<= 0 ac))))
              (dk-have! (list '< c m1) (lambda () (dk-ineq! (list '<= c ac))))
              (mpr-recip! m1)
              (dk-cite! 'rr-pos-rr-of-lt rm)
              (let* ((cv (cadddr (mpo-iff-parts! (dk-cite! 'converges-to 's h l))))
                     (n1 (dk-skolem! (dk-apply! cv rm)))
                     (cv1 (begin (dk-split-all!) (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f n1) (dk-contains? f rm))) "the limit clause")))
                     (n (list '+ n0 n1))
                     (hn (list h n)))
                (mpo-chain! (dk-fact! 'nn-add-closed n0 n1))
                (dk-have! (list '<= n0 n) (lambda () (dk-nn!)))
                (dk-have! (list '<= n1 n) (lambda () (dk-nn!)))
                (dk-apply! cv1 n)
                (dk-cite! 'fun-apply-type-c h 'NN 'u n)
                (let* ((b0 (dk-apply! bd n))
                       (fhn (fpos! hn))
                       (b1 (begin (dk-lam-b-h! b0) (list '<= (list 'RECIP fhn) c))))
                  (mpr-recip! fhn)
                  (mpr-recip! rm)
                  (dk-cite! 'metric-dist-real 's hn l)
                  (dk-cite! 'pt-set-dist-lipschitz 's mpm-F q0 hn l)
                  (dk-have! (list '<= fhn rm)
                    (lambda () (dk-ineq! (list '<= fhn (list '+ (list '(DIST s) hn l) fl)) (list '<= (list '(DIST s) hn l) rm)
                                         (list '<= fl (list '(DIST s) l l)) (list '= (list '(DIST s) l l) 0))))
                  (dk-cite! 'rr-recip-antitone fhn rm)
                  (dk-cite! 'rr-recip-recip-pos m1)
                  (dk-absurd! (list '<= (list 'RECIP rm) (list 'RECIP fhn)) (list '= (list 'RECIP rm) m1)
                              b1 (list '< c m1))))))))
      (mpm-finish! mpm-G)))
  ;; X \ U empty, i.e. U = X: g = 0
  (lambda ()
    (dk-have! (list 'IN mpm-G0 '(FUN u RR))
      (lambda () (dk-lam-type! (lambda () (dk-di-var!) (dk-cite! 'rr-zero-in) (mpo-close-open!)))))
    (dk-have! (mpm-inst mpo-GH1 mpm-G0)
      (lambda ()
        (let* ((lk (dk-peel!))
               (eps (cadr (find-first (lambda (f) (dk-head-is? f 'POS-RR)) lk))))
          (dk-cite! 'rr-pos-rr-in-rr eps) (dk-cite! 'rr-lt-of-pos-rr eps)
          (ew eps)
          (for-each
           (lambda (k)
             (dk-focus! k)
             (if (dk-asm? (dk-goal))
                 (ass)
                 (begin
                   (dk-peel!)
                   (dk-lam-b!)
                   (dk-cite! 'rr-zero-in)
                   (dk-have! '(= (- 0 0) 0) (lambda () (dk-ineq!)))
                   (subst '(= (- 0 0) 0))
                   (dk-cite! 'rr-abs-zero-value)
                   (subst '(= (ABS 0) 0))
                   (dk-ineq! (list '< 0 eps)))))
           (dk-opened (lambda () (di)))))))
    (dk-have! (mpm-inst mpo-GH2 mpm-G0)
      (lambda ()
        (let* ((lk (dk-peel!)) (l (mpm-pick-in lk '(PTS s))))
          (pbc)
          (dk-have! (list 'IN l mpm-F) (lambda () (mac 'complement-in-membership) (dk-conj-close! (lambda () (ass)))))
          (dk-have! mpm-P (lambda () (ew l) (ass)))
          (ai (list 'NOT mpm-P)))))
    (mpm-finish! mpm-G0)))
(qed 'polish-open-subspace)
(topic! 'polish-open-subspace 'analysis)
