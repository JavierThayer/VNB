                        (hyp (find-first (lambda (f) (dk-head-is? f '<=)) lk2))
                        (ts (mpo-gtyp! a b)))
                   (dk-lam-b!)
                   (subst (dk-cite! 'subspace-dist 's 'A a b))
                   (dk-cite! 'graph-ms-dist 's 'A 'g a b)
                   (let ((h2 (dk-rewrite-h! hyp (list (list 'DIST mph-G) a b) (list '+ (car ts) (cadr ts)))))
                     (dk-ineq! h2 (list '<= 0 (cadr ts)))))))
           (dk-opened (lambda () (di)))))
