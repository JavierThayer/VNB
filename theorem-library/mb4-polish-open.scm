                            (mpo-drive!)
                            (let* ((g3 (dk-goal)) (d (cadr (cadr g3))))
                              (mpo-gtyp! (cadr d) (caddr d))
                              (dk-cite! 'rr-add-in-rr d (caddr (cadr g3)))
                              (mpo-close-open!))))))
                  (dk-opened (lambda () (lam-t)))))
       (#t (let ((before (dk-open-leaves)))
