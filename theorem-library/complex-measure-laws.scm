  (qed name) (topic! name 'analysis))
(define (mfo-real! . ts) (for-each (lambda (t) (dk-type! t 'RR)) ts))

;; RINTEGRAL is congruent under pointwise equality of real functions
(sp (make-wff (dk-foralls '(omega ca mu f g) (dk-curry '((IN f (FUN omega RR)) (IN g (FUN omega RR)) (FORALL x (IMPLIES (IN x omega) (= (f x) (g x)))))
  '(== (RINTEGRAL omega ca mu f) (RINTEGRAL omega ca mu g))))))
(dk-peel!)
(subst (dk-cite! 'rintegral-unfold 'omega 'ca 'mu 'f))
(subst (dk-cite! 'rintegral-unfold 'omega 'ca 'mu 'g))
(for-each
  (lambda (part fun)
    (dk-cite! fun 'omega 'f) (dk-cite! fun 'omega 'g)
    (dk-have! (list 'FORALL 'icx_ (list 'IMPLIES '(IN icx_ omega) (list '= (list (list part 'omega 'f) 'icx_) (list (list part 'omega 'g) 'icx_))))
      (lambda ()
        (let ((x (dk-di-var!)))
          (dk-cite! 'fun-apply-type-c 'f 'omega 'RR x) (dk-cite! 'fun-apply-type-c 'g 'omega 'RR x)
          (dk-apply! '(FORALL x (IMPLIES (IN x omega) (= (f x) (g x)))) x)
          (mac part)
          (dk-lam-b!)
          (subst (list '= (list 'f x) (list 'g x)))
          (let ((ift (list 'IF (list '<= 0 (list 'g x)) (if (eq? part 'POS-PART) (list 'g x) 0) (if (eq? part 'POS-PART) 0 (list '- (list 'g x))))))
            (dk-cite! 'rr-neg-closed (list 'g x))
            (fact 'rr-zero-in)
            (dk-case-if! ift (lambda (t v) (rfl)))))))
    (subst (dk-cite! 'integral-congruence-ptwise 'omega 'ca 'mu (list part 'omega 'f) (list part 'omega 'g))))
  '(POS-PART NEG-PART) '(pos-part-fun neg-part-fun))
(qrfl)
(mfo-qed! 'rintegral-congruence)

;; 0 <= a <= b gives a a <= b b;  0 <= a, 0 <= b, a a <= b b gives a <= b
(sp (make-wff (dk-foralls '(a b) (dk-curry '((IN a RR) (IN b RR) (<= 0 a) (<= a b)) '(<= (* a a) (* b b))))))
(dk-peel!)
(mfo-real! '(* a a) '(* a b) '(* b a) '(* b b))
(dk-have! '(<= 0 b) (lambda () (dk-ineq! '(<= 0 a) '(<= a b) '(IN a RR) '(IN b RR))))
(dk-cite! 'rr-mul-le-right 'a 'b 'a)
(dk-cite! 'rr-mul-le-right 'a 'b 'b)
(dk-have! '(= (* a b) (* b a)) (lambda () (crs)))
(dk-ineq! '(<= (* a a) (* b a)) '(<= (* a b) (* b b)) '(= (* a b) (* b a)) '(IN (* a a) RR) '(IN (* a b) RR) '(IN (* b a) RR) '(IN (* b b) RR))
(mfo-qed! 'rr-square-mono)

(sp (make-wff (dk-foralls '(a b) (dk-curry '((IN a RR) (IN b RR) (<= 0 a) (<= 0 b) (<= (* a a) (* b b))) '(<= a b)))))
(dk-peel!)
(use-em '(<= a b)
  (lambda () (dk-ass!))
  (lambda ()
    (dk-cite! 'rr-not-le-lt 'a 'b)
    (mfo-real! '(* a a) '(* a b) '(* b a) '(* b b))
    (dk-have! '(< 0 a) (lambda () (dk-ineq! '(< b a) '(<= 0 b) '(IN a RR) '(IN b RR))))
    (dk-have-and! '(< 0 a) '(< b a))
    (dk-cite! 'rr-lt-scale-pos 'a 'b 'a)
    (dk-have! '(<= b a) (lambda () (dk-ineq! '(< b a) '(IN a RR) '(IN b RR))))
    (dk-cite! 'rr-mul-le-right 'b 'a 'b)
    (dk-have! '(= (* a b) (* b a)) (lambda () (crs)))
    (dk-absurd! '(< (* a b) (* a a)) '(<= (* b b) (* a b)) '(<= (* a a) (* b b)) '(= (* a b) (* b a))
                '(IN (* a a) RR) '(IN (* a b) RR) '(IN (* b a) RR) '(IN (* b b) RR))))
(mfo-qed! 'rr-square-le-imp-le)

;; 0 <= x, 0 <= y: 0 <= x y
(define (mfo-pn! x y)
  (fact 'rr-zero-in)
  (mfo-real! (list '* x y) (list '* 0 y))
  (dk-cite! 'rr-mul-le-right 0 x y)
  (dk-have! (list '= (list '* 0 y) 0) (lambda () (crs)))
  (dk-have! (list '<= 0 (list '* x y))
    (lambda () (dk-ineq! (list '<= (list '* 0 y) (list '* x y)) (list '= (list '* 0 y) 0) (list 'IN (list '* x y) 'RR) (list 'IN (list '* 0 y) 'RR)))))

;; |phi| <= d1 + d2 + d3 + d4 pointwise
(sp (make-wff (dk-foralls '(a b p d1 d2 d3 d4)
  (dk-curry '((IN d1 RR) (IN d2 RR) (IN d3 RR) (IN d4 RR) (<= 0 d1) (<= 0 d2) (<= 0 d3) (<= 0 d4)
              (IN a RR) (IN b RR) (= a (- d1 d2)) (= b (- d3 d4)) (IN p RR) (<= 0 p) (= (* p p) (+ (* a a) (* b b))))
    '(<= p (+ (+ d1 d2) (+ d3 d4)))))))
(dk-peel!)
(let* ((s1 '(+ d1 d2)) (s2 '(+ d3 d4)) (dd (list '+ s1 s2)))
  (mfo-real! s1 s2 dd '(* a a) '(* b b) '(* p p) (list '* s1 s1) (list '* s2 s2) (list '* s1 s2) (list '* dd dd)
             (list '- s1 'a) (list '+ s1 'a) (list '- s2 'b) (list '+ s2 'b))
  (for-each (lambda (z) (dk-have! (list '<= 0 z) (lambda () (dk-ineq! '(<= 0 d1) '(<= 0 d2) '(<= 0 d3) '(<= 0 d4) '(= a (- d1 d2)) '(= b (- d3 d4))
                                                                    '(IN d1 RR) '(IN d2 RR) '(IN d3 RR) '(IN d4 RR) '(IN a RR) '(IN b RR)))))
            (list s1 s2 dd (list '- s1 'a) (list '+ s1 'a) (list '- s2 'b) (list '+ s2 'b)))
  (mfo-pn! (list '- s1 'a) (list '+ s1 'a))
  (mfo-pn! (list '- s2 'b) (list '+ s2 'b))
  (mfo-pn! s1 s2)
  (mfo-real! (list '* (list '- s1 'a) (list '+ s1 'a)) (list '* (list '- s2 'b) (list '+ s2 'b)))
  (dk-have! (list '= (list '* (list '- s1 'a) (list '+ s1 'a)) (list '- (list '* s1 s1) '(* a a))) (lambda () (crs)))
  (dk-have! (list '= (list '* (list '- s2 'b) (list '+ s2 'b)) (list '- (list '* s2 s2) '(* b b))) (lambda () (crs)))
  (dk-have! (list '= (list '* dd dd) (list '+ (list '+ (list '* s1 s1) (list '* s2 s2)) (list '+ (list '* s1 s2) (list '* s1 s2)))) (lambda () (crs)))
  (dk-have! (list '<= '(* p p) (list '* dd dd))
    (lambda () (dk-ineq! '(= (* p p) (+ (* a a) (* b b)))
                         (list '<= 0 (list '* (list '- s1 'a) (list '+ s1 'a))) (list '<= 0 (list '* (list '- s2 'b) (list '+ s2 'b)))
                         (list '<= 0 (list '* s1 s2))
                         (list '= (list '* (list '- s1 'a) (list '+ s1 'a)) (list '- (list '* s1 s1) '(* a a)))
                         (list '= (list '* (list '- s2 'b) (list '+ s2 'b)) (list '- (list '* s2 s2) '(* b b)))
                         (list '= (list '* dd dd) (list '+ (list '+ (list '* s1 s1) (list '* s2 s2)) (list '+ (list '* s1 s2) (list '* s1 s2))))
                         '(IN (* p p) RR) '(IN (* a a) RR) '(IN (* b b) RR) (list 'IN (list '* s1 s1) 'RR) (list 'IN (list '* s2 s2) 'RR)
                         (list 'IN (list '* s1 s2) 'RR) (list 'IN (list '* dd dd) 'RR)
                         (list 'IN (list '* (list '- s1 'a) (list '+ s1 'a)) 'RR) (list 'IN (list '* (list '- s2 'b) (list '+ s2 'b)) 'RR))))
  (dk-cite! 'rr-square-le-imp-le 'p dd)
  (dk-ass!))
(mfo-qed! 'polar-bound)

;; a + i b = 0 with a, b real gives a = 0 and b = 0
(sp (make-wff '(FORALL a (FORALL b (IMPLIES (IN a RR) (IMPLIES (IN b RR) (IMPLIES (= (+ a (* +i b)) 0) (AND (= a 0) (= b 0)))))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'cc-i-in)
(dk-cite! 'rr-subset-cc 0)
(dk-have! '(= 0 (+ 0 (* 0 +i))) (lambda () (crs)))
(dk-split-all! (list (dk-cite! 'cc-re-im-of 0 0 0)))
(dk-have! '(= 0 (+ a (* b +i))) (lambda () (subst '(= 0 (+ a (* +i b)))) (crs)))
(dk-split-all! (list (dk-cite! 'cc-re-im-of 0 'a 'b)))
(dk-rewrite-h! '(= (real-part 0) a) '(real-part 0) 0)
(dk-rewrite-h! '(= (imag-part 0) b) '(imag-part 0) 0)
(dk-conj-close! (lambda () (let ((v (cadr (dk-goal)))) (subst (list '= v 0)) (rfl))))
(mfo-qed! 'complex-zero-parts)

;; |Re z| <= 1 and |Im z| <= 1 for |z| = 1
(sp (make-wff '(FORALL z (IMPLIES (IN z CC) (IMPLIES (= (magnitude z) 1) (AND (<= (abs (real-part z)) 1) (<= (abs (imag-part z)) 1)))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'rr-one-in)
(let* ((re '(real-part z)) (im '(imag-part z))
       (s2 (list '+ (list '* re re) (list '* im im))))
  (dk-cite! 'real-part-in-rr 'z) (dk-cite! 'imag-part-in-rr 'z)
  (mfo-real! (list '* re re) (list '* im im) s2)
  (dk-cite! 'rr-sq-nonneg re) (dk-cite! 'rr-sq-nonneg im)
  (dk-have! (list '<= 0 s2) (lambda () (dk-ineq! (list '<= 0 (list '* re re)) (list '<= 0 (list '* im im)) (list 'IN (list '* re re) 'RR) (list 'IN (list '* im im) 'RR))))
  (dk-have-and! (list 'IN s2 'RR) (list '<= 0 s2))
  (dk-cite! 'sqrt-sq s2)
  (dk-cite! 'magnitude-def 'z)
  (dk-have! (list '= (list 'SQRT s2) 1) (lambda () (subst (list '== (list 'SQRT s2) '(magnitude z))) (dk-ass!)))
  (dk-rewrite-h! (list '= (list '* (list 'SQRT s2) (list 'SQRT s2)) s2) (list 'SQRT s2) 1)
  (for-each
    (lambda (t)
      (let ((at (list 'abs t)))
        (dk-cite! 'rr-abs-closed t) (dk-cite! 'rr-abs-nonneg t)
        (dk-have-and! (list 'IN t 'RR) (list 'IN t 'RR))
        (dk-cite! 'rr-abs-mult t t)
        (mfo-real! (list '* at at))
        (dk-cite! 'rr-abs-of-nonneg (list '* t t))
        (dk-cite! 'rr-abs-closed (list '* t t))
        (dk-have! (list '<= (list '* at at) '(* 1 1))
          (lambda () (dk-ineq! (list '= (list 'abs (list '* t t)) (list '* at at)) (list '= (list 'abs (list '* t t)) (list '* t t))
                               (list '= (list '* 1 1) s2) (list '<= 0 (list '* re re)) (list '<= 0 (list '* im im))
                               (list 'IN (list '* re re) 'RR) (list 'IN (list '* im im) 'RR) (list 'IN (list '* at at) 'RR)
                               (list 'IN (list 'abs (list '* t t)) 'RR))))
        (dk-cite! 'rr-square-le-imp-le at 1)))
    (list re im))
  (dk-conj-close! dk-ass!))
(mfo-qed! 'unit-parts-bound)

;; |h q| <= |h| for |q| <= 1
(sp (make-wff '(FORALL h (FORALL q (IMPLIES (IN h RR) (IMPLIES (IN q RR) (IMPLIES (<= (abs q) 1) (<= (abs (* h q)) (abs h)))))))))
(dk-peel!)
(dk-have-and! '(IN h RR) '(IN q RR))
(dk-cite! 'rr-abs-mult 'h 'q)
(dk-cite! 'rr-abs-closed 'h) (dk-cite! 'rr-abs-closed 'q) (dk-cite! 'rr-abs-nonneg 'h)
(fact 'rr-one-in)
(dk-cite! 'rr-mul-le-right '(abs q) 1 '(abs h))
(mfo-real! '(* (abs h) (abs q)) '(* (abs q) (abs h)) '(* 1 (abs h)) '(* h q))
(dk-cite! 'rr-abs-closed '(* h q))
(dk-have! '(= (* (abs h) (abs q)) (* (abs q) (abs h))) (lambda () (crs)))
(dk-have! '(= (* 1 (abs h)) (abs h)) (lambda () (crs)))
(dk-ineq! '(= (abs (* h q)) (* (abs h) (abs q))) '(= (* (abs h) (abs q)) (* (abs q) (abs h))) '(<= (* (abs q) (abs h)) (* 1 (abs h)))
          '(= (* 1 (abs h)) (abs h)) '(IN (abs (* h q)) RR) '(IN (* (abs h) (abs q)) RR) '(IN (* (abs q) (abs h)) RR) '(IN (* 1 (abs h)) RR) '(IN (abs h) RR))
(mfo-qed! 'abs-mul-le-unit)

;; the complex integral, unfolded (def-functoid installs only a macete; mac-h needs a theorem)
(define mfo-ciu
  '(== (COMPLEX-INTEGRAL omega ca mu u)
       (+ (RINTEGRAL omega ca mu (VNB-LAMBDA cix_ omega (REAL-PART (u cix_))))
          (* +i (RINTEGRAL omega ca mu (VNB-LAMBDA cix_ omega (IMAG-PART (u cix_))))))))
(sp (make-wff (dk-foralls '(omega ca mu u) mfo-ciu)))
(dk-peel!)
(mac 'COMPLEX-INTEGRAL)
(qrfl)
(mfo-qed! 'complex-integral-unfold)

;; equal complex numbers a + i b = c + i d with real parts: a = c and b = d
(sp (make-wff (dk-foralls '(a b c d) (dk-curry '((IN a RR) (IN b RR) (IN c RR) (IN d RR) (= (+ a (* +i b)) (+ c (* +i d))))
  '(AND (= a c) (= b d))))))
(dk-peel!)
(fact 'cc-i-in)
(mfo-real! '(- a c) '(- b d))
(dk-have! '(= (+ (- a c) (* +i (- b d))) 0)
  (lambda ()
    (dk-have! '(= (+ (- a c) (* +i (- b d))) (- (+ a (* +i b)) (+ c (* +i d)))) (lambda () (crs)))
    (subst '(= (+ (- a c) (* +i (- b d))) (- (+ a (* +i b)) (+ c (* +i d)))))
    (subst '(= (+ a (* +i b)) (+ c (* +i d))))
    (crs)))
(dk-split-all! (list (dk-cite! 'complex-zero-parts '(- a c) '(- b d))))
(dk-conj-close! (lambda () (dk-ineq! '(= (- a c) 0) '(= (- b d) 0) '(IN a RR) '(IN b RR) '(IN c RR) '(IN d RR))))
(mfo-qed! 'complex-parts-equal)

  
