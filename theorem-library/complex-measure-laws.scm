(define (mfl-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MFL OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mfl-find-if x)
  (cond ((not (pair? x)) #f)
        ((eq? (car x) 'IF) x)
        (#t (let loop ((xs x))
              (cond ((null? xs) #f)
                    ((not (pair? xs)) #f)
                    ((mfl-find-if (car xs)) => (lambda (r) r))
                    (#t (loop (cdr xs))))))))
(define (mfl-typer ty!)          ; a typer for dk-abstract! / dk-lam-type!: the goal's own typing is the LAST step
  (lambda (x) (let ((leaf (proof-state-focus *ps*)) (g (dk-goal)))
                (ty! x)
                (if (not (sequent-node-grounded? leaf))
                    (if (not (dk-ass!)) (dk-type! (cadr g) (caddr g)))))))
(define (mfl-real! . ts) (for-each (lambda (t) (dk-type! t 'RR)) ts))

;; x * x = 0 gives x = 0
(sp (make-wff '(FORALL x (IMPLIES (IN x RR) (IMPLIES (= (* x x) 0) (= x 0))))))
(dk-peel!)
(let ((e (dk-cite! 'sqrt-of-sq 'x)))
  (dk-rewrite-h! e '(* x x) 0)
  #t)
(fact 'sqrt-zero)
(dk-rewrite-h! '(= (SQRT 0) (abs x)) '(SQRT 0) 0)
(dk-have! '(= (abs x) 0) (lambda () (subst '(= 0 (abs x))) (rfl)))
(dk-iff-fwd! (dk-cite! 'rr-abs-zero 'x))
(dk-ass!)
(mfl-qed! 'rr-square-zero)

;; (a q)^2 + (b q)^2 = 1 when p^2 = a^2 + b^2 and p q = 1
(sp (make-wff (dk-foralls '(a b p q) (dk-curry '((IN a RR) (IN b RR) (IN p RR) (IN q RR) (= (* p p) (+ (* a a) (* b b))) (= (* p q) 1))
  '(= (+ (* (* a q) (* a q)) (* (* b q) (* b q))) 1)))))
(dk-peel!)
(let ((lhs '(+ (* (* a q) (* a q)) (* (* b q) (* b q)))))
  (dk-have! (list '= lhs '(* (* q q) (+ (* a a) (* b b)))) (lambda () (crs)))
  (subst (list '= lhs '(* (* q q) (+ (* a a) (* b b)))))
  (subst '(= (+ (* a a) (* b b)) (* p p)))
  (dk-have! '(= (* (* q q) (* p p)) (* (* p q) (* p q))) (lambda () (crs)))
  (subst '(= (* (* q q) (* p p)) (* (* p q) (* p q))))
  (subst '(= (* p q) 1))
  (crs))
(mfl-qed! 'alg-polar-unit)

;; ---------------------------------------------------------------------------
;; the polar decomposition of a pair of reals: p = sqrt(a^2 + b^2), q = 1/p (0 when p = 0),
;; r = a q + (1 - p q), i = b q: then p r = a, p i = b, r^2 + i^2 = 1
(define mfl-pw-concl
  (dk-and (list '(IN p RR) '(<= 0 p) '(= (* p p) (+ (* a a) (* b b))) '(IN q RR) '(IN r RR) '(IN i RR)
                '(= (* p r) a) '(= (* p i) b) '(= (+ (* r r) (* i i)) 1))))
(sp (make-wff (dk-foralls '(a b p q r i) (dk-curry '((IN a RR) (IN b RR) (= p (SQRT (+ (* a a) (* b b))))
                                                     (= q (IF (< 0 p) (recip p) 0)) (= r (+ (* a q) (- 1 (* p q)))) (= i (* b q)))
  mfl-pw-concl))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'rr-one-in)
(mfl-real! '(* a a) '(* b b) '(+ (* a a) (* b b)))
(dk-cite! 'rr-sq-nonneg 'a) (dk-cite! 'rr-sq-nonneg 'b)
(dk-have! '(<= 0 (+ (* a a) (* b b))) (lambda () (dk-ineq! '(<= 0 (* a a)) '(<= 0 (* b b)) '(IN (* a a) RR) '(IN (* b b) RR))))
(dk-have-and! '(IN (+ (* a a) (* b b)) RR) '(<= 0 (+ (* a a) (* b b))))
(dk-split-all! (list (dk-cite! 'sqrt-prop '(+ (* a a) (* b b)))))
(let ((sq '(SQRT (+ (* a a) (* b b)))))
  (for-each (lambda (f) (dk-rewrite-h! f sq 'p))
            (list (list 'IN sq 'RR) (list '<= 0 sq) (list '= (list '* sq sq) '(+ (* a a) (* b b))))))
(mfl-real! '(* p p))
(let ((ift '(IF (< 0 p) (recip p) 0))
      (finish!
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!)) (begin (dk-ineq!))))))))
  (use-em '(< 0 p)
    (lambda ()
      (dk-have! '(NOT (= p 0)) (lambda () (di) (dk-absurd! '(< 0 p) '(= p 0) '(IN p RR))))
      (dk-have-and! '(IN p RR) '(NOT (= p 0)))
      (dk-cite! 'rr-recip-closed 'p) (dk-cite! 'rr-recip-inverse 'p)
      (dk-have! '(= q (recip p))
        (lambda () (subst (list '= 'q ift)) (dk-if-branch! #t ift #f (lambda () (rfl)))))
      (dk-rewrite-h! '(= (* p (recip p)) 1) '(recip p) 'q)
      (dk-have! '(IN q RR) (lambda () (subst '(= q (recip p))) (dk-ass!)))
      (mfl-real! '(* a q) '(* b q) '(* p q))
      (dk-have! '(= r (* a q)) (lambda () (subst '(= r (+ (* a q) (- 1 (* p q))))) (subst '(= (* p q) 1)) (crs)))
      (dk-have! '(IN r RR) (lambda () (subst '(= r (* a q))) (dk-ass!)))
      (dk-have! '(IN i RR) (lambda () (subst '(= i (* b q))) (dk-ass!)))
      (dk-have! '(= (* p r) a)
        (lambda () (subst '(= r (* a q)))
                   (dk-have! '(= (* p (* a q)) (* a (* p q))) (lambda () (crs)))
                   (subst '(= (* p (* a q)) (* a (* p q)))) (subst '(= (* p q) 1)) (crs)))
      (dk-have! '(= (* p i) b)
        (lambda () (subst '(= i (* b q)))
                   (dk-have! '(= (* p (* b q)) (* b (* p q))) (lambda () (crs)))
                   (subst '(= (* p (* b q)) (* b (* p q)))) (subst '(= (* p q) 1)) (crs)))
      (dk-have! '(= (+ (* r r) (* i i)) 1)
        (lambda () (subst '(= r (* a q))) (subst '(= i (* b q)))
                   (dk-cite! 'alg-polar-unit 'a 'b 'p 'q) (dk-ass!)))
      (finish!))
    (lambda ()
      (dk-have! '(= p 0)
        (lambda () (use-em '(<= p 0)
                     (lambda () (dk-ineq! '(<= p 0) '(<= 0 p) '(IN p RR)))
                     (lambda () (dk-cite! 'rr-not-le-lt 'p 0) (ai '(NOT (< 0 p)))))))
      (dk-have! '(= q 0) (lambda () (subst (list '= 'q ift)) (dk-if-branch! #f ift #f (lambda () (rfl)))))
      (dk-have! '(= r 1) (lambda () (subst '(= r (+ (* a q) (- 1 (* p q))))) (subst '(= q 0)) (subst '(= p 0)) (crs)))
      (dk-have! '(= i 0) (lambda () (subst '(= i (* b q))) (subst '(= q 0)) (crs)))
      (dk-have! '(= (* p p) 0) (lambda () (subst '(= p 0)) (crs)))
      (dk-have! '(= (* a a) 0) (lambda () (dk-ineq! '(= (* p p) (+ (* a a) (* b b))) '(= (* p p) 0) '(<= 0 (* a a)) '(<= 0 (* b b))
                                                     '(IN (* a a) RR) '(IN (* b b) RR) '(IN (* p p) RR))))
      (dk-have! '(= (* b b) 0) (lambda () (dk-ineq! '(= (* p p) (+ (* a a) (* b b))) '(= (* p p) 0) '(<= 0 (* a a)) '(<= 0 (* b b))
                                                     '(IN (* a a) RR) '(IN (* b b) RR) '(IN (* p p) RR))))
      (dk-cite! 'rr-square-zero 'a) (dk-cite! 'rr-square-zero 'b)
      (dk-have! '(IN q RR) (lambda () (subst '(= q 0)) (dk-ass!)))
      (dk-have! '(IN r RR) (lambda () (subst '(= r 1)) (dk-ass!)))
      (dk-have! '(IN i RR) (lambda () (subst '(= i 0)) (dk-ass!)))
      (dk-have! '(= (* p r) a) (lambda () (subst '(= p 0)) (subst '(= r 1)) (subst '(= a 0)) (crs)))
      (dk-have! '(= (* p i) b) (lambda () (subst '(= p 0)) (subst '(= i 0)) (subst '(= b 0)) (crs)))
      (dk-have! '(= (+ (* r r) (* i i)) 1) (lambda () (subst '(= r 1)) (subst '(= i 0)) (crs)))
      (finish!))))
(mfl-qed! 'polar-pointwise)

;; ---------------------------------------------------------------------------
;; the polar functions of a pair (re, im) of real measurable functions
(define (mfl-ptw body) (list 'FORALL 'x (list 'IMPLIES '(IN x omega) body)))
(define mfl-concl
  (list 'FORSOME 'pp_ (list 'FORSOME 'ru_ (list 'FORSOME 'iu_ (dk-and (list
    '(IS-MEASURABLE-FN omega ca pp_) '(IS-REAL-MEASURABLE-FN omega ca pp_)
    '(IS-REAL-MEASURABLE-FN omega ca ru_) '(IS-REAL-MEASURABLE-FN omega ca iu_)
    (mfl-ptw '(<= 0 (pp_ x)))
    (mfl-ptw '(= (* (pp_ x) (pp_ x)) (+ (* (re x) (re x)) (* (im x) (im x)))))
    (mfl-ptw '(= (* (pp_ x) (ru_ x)) (re x)))
    (mfl-ptw '(= (* (pp_ x) (iu_ x)) (im x)))
    (mfl-ptw '(= (+ (* (ru_ x) (ru_ x)) (* (iu_ x) (iu_ x))) 1))))))))
;; IS-REAL-MEASURABLE-FN G from that of LAM, agreeing pointwise; TY! types what a point needs
(define (mfl-transfer! lam G ve ty!)
  (dk-project! (list 'IN lam '(FUN omega RR)) 'is-real-measurable-fn (list 'IS-REAL-MEASURABLE-FN 'omega 'ca lam))
  (dk-have! (list 'FORALL 'ex_ (list 'IMPLIES '(IN ex_ omega) (list '= (list lam 'ex_) (list G 'ex_))))
    (lambda () (let ((x (dk-di-var!)))
                 (ty! x)
                 (dk-lam-b!)
                 (if (not (proof-done? *ps*))
                     (let ((leaf (proof-state-focus *ps*)))
                       (subst (dk-apply! ve x))
                       (if (not (sequent-node-grounded? leaf)) (rfl)))))))
  (dk-cite! 'real-measurable-ptwise-eq 'omega 'ca lam G))

(sp (make-wff (dk-foralls '(omega ca re im) (dk-curry '((IS-SIGMA-ALGEBRA omega ca) (IS-REAL-MEASURABLE-FN omega ca re) (IS-REAL-MEASURABLE-FN omega ca im))
  mfl-concl))))
(dk-peel!)
(dk-cite! 'sigma-algebra-ambient-set 'omega 'ca)
(fact 'rr-zero-in) (fact 'rr-one-in)
(dk-project! '(IN re (FUN omega RR)) 'is-real-measurable-fn '(IS-REAL-MEASURABLE-FN omega ca re))
(dk-project! '(IN im (FUN omega RR)) 'is-real-measurable-fn '(IS-REAL-MEASURABLE-FN omega ca im))
(let* ((ty0! (lambda (x) (dk-cite! 'fun-apply-type-c 're 'omega 'RR x) (dk-cite! 'fun-apply-type-c 'im 'omega 'RR x)
                          (mfl-real! (list '* (list 're x) (list 're x)) (list '* (list 'im x) (list 'im x))
                                     (list '+ (list '* (list 're x) (list 're x)) (list '* (list 'im x) (list 'im x))))))
       (sb (lambda (x) (list '+ (list '* (list 're x) (list 're x)) (list '* (list 'im x) (list 'im x)))))
       (sab (dk-abstract! 'omega 'RR sb (mfl-typer ty0!)))
       (s (car sab)) (sve (cdr sab))
       (m1 '(VNB-LAMBDA sx_ omega (* (re sx_) (re sx_))))
       (m2 '(VNB-LAMBDA sx_ omega (* (im sx_) (im sx_))))
       (m12 (list 'VNB-LAMBDA 'sx_ 'omega (list '+ (list m1 'sx_) (list m2 'sx_))))
       (ty1! (lambda (x) (ty0! x) (dk-cite! 'fun-apply-type-c s 'omega 'RR x)
                         (dk-cite! 'rr-sq-nonneg (list 're x)) (dk-cite! 'rr-sq-nonneg (list 'im x))
                         (let ((v (dk-apply! sve x)))
                           (dk-have! (list '<= 0 (list s x))
                             (lambda () (subst v) (dk-ineq! (list '<= 0 (list '* (list 're x) (list 're x))) (list '<= 0 (list '* (list 'im x) (list 'im x)))
                                                           (list 'IN (list '* (list 're x) (list 're x)) 'RR) (list 'IN (list '* (list 'im x) (list 'im x)) 'RR)))))
