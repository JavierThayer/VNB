   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)

(define (mfm-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MFM OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mfm-find-if x)
  (cond ((not (pair? x)) #f)
        ((eq? (car x) 'IF) x)
        (#t (let loop ((xs x))
              (cond ((null? xs) #f)
                    ((not (pair? xs)) #f)
                    ((mfm-find-if (car xs)) => (lambda (r) r))
                    (#t (loop (cdr xs))))))))
(define (mfm-rps! t)            ; t in RR, 0 <= t in context: t in RR-POS-STAR
  (let ((iff (dk-cite! 'rr-pos-star-membership t)))
    (if (not (dk-asm? (list 'IN t 'RR-POS-STAR)))
        (dk-have! (list 'IN t 'RR-POS-STAR)
          (lambda () (let ((leaf (proof-state-focus *ps*)))
                       (keep iff (list 'IN t 'RR) (list '<= 0 t))
                       (if (not (sequent-node-grounded? leaf)) (prop))))))))
;; etimes of two nonnegative reals is their product
(define (mfm-et! a b)
  (dk-cite! 'etimes-real-defined a b)
  (dk-cite! 'bintimes-apply a b))

;; pointwise: p (g)+ = (p g)+ and p (g)- = (p g)- for p >= 0
(define (mfm-sign-facts!)        ; p, g in RR, 0 <= p: land (* p g) typed, and the sign of p g from that of g
  (fact 'rr-zero-in)
  (dk-type! '(* p g) 'RR) (dk-type! '(* g p) 'RR)
  (dk-have! '(= (* 0 g) 0) (lambda () (crs)))
  (dk-have! '(= (* 0 p) 0) (lambda () (crs)))
  (dk-have! '(= (* g p) (* p g)) (lambda () (crs)))
  (mfm-rps! 'p))
(sp (make-wff (dk-foralls '(p g) (dk-curry '((IN p RR) (IN g RR) (<= 0 p))
  '(= (etimes p (IF (<= 0 g) g 0)) (IF (<= 0 (* p g)) (* p g) 0))))))
(dk-peel!)
(mfm-sign-facts!)
(dk-case-if! '(IF (<= 0 g) g 0)
  (lambda (t v)
    (if t
        (begin
          (dk-cite! 'rr-mul-le-right 0 'p 'g)
          (dk-have! '(<= 0 (* p g)) (lambda () (dk-ineq! '(<= (* 0 g) (* p g)) '(= (* 0 g) 0) '(IN (* p g) RR))))
          (mfm-et! 'p 'g)
          (subst '(= (etimes p g) (bintimes p g))) (subst '(== (bintimes p g) (* p g)))
          (dk-if-branch! #t (mfm-find-if (dk-goal)) #f (lambda () (rfl))))
        (begin
          (fact 'zero-in-rr-pos-star)
          (subst (dk-cite! 'etimes-zero-right 'p))
          (dk-cite! 'rr-not-le-lt 0 'g)
          (dk-have! '(<= g 0) (lambda () (dk-ineq! '(< g 0) '(IN g RR))))
          (dk-cite! 'rr-mul-le-right 'g 0 'p)
          (dk-have! '(<= (* p g) 0) (lambda () (dk-ineq! '(<= (* g p) (* 0 p)) '(= (* 0 p) 0) '(= (* g p) (* p g)) '(IN (* p g) RR) '(IN (* g p) RR))))
          (dk-case-if! (mfm-find-if (dk-goal))
            (lambda (t2 v2)
              (if t2
                  (dk-ineq! '(<= (* p g) 0) '(<= 0 (* p g)) '(IN (* p g) RR))
                  (rfl))))))))
(mfm-qed! 'ptwise-pos-part-scale)

(sp (make-wff (dk-foralls '(p g) (dk-curry '((IN p RR) (IN g RR) (<= 0 p))
  '(= (etimes p (IF (<= 0 g) 0 (- g))) (IF (<= 0 (* p g)) 0 (- (* p g))))))))
(dk-peel!)
(mfm-sign-facts!)
(fact 'zero-in-rr-pos-star)
(dk-case-if! '(IF (<= 0 g) 0 (- g))
  (lambda (t v)
    (if t
        (begin
          (subst (dk-cite! 'etimes-zero-right 'p))
          (dk-cite! 'rr-mul-le-right 0 'p 'g)
          (dk-have! '(<= 0 (* p g)) (lambda () (dk-ineq! '(<= (* 0 g) (* p g)) '(= (* 0 g) 0) '(IN (* p g) RR))))
          (dk-if-branch! #t (mfm-find-if (dk-goal)) #f (lambda () (rfl))))
        (begin
          (dk-cite! 'rr-not-le-lt 0 'g)
          (dk-cite! 'rr-neg-closed 'g)
          (dk-have! '(<= 0 (- g)) (lambda () (dk-ineq! '(< g 0) '(IN g RR))))
          (mfm-rps! '(- g))
          (mfm-et! 'p '(- g))
          (subst '(= (etimes p (- g)) (bintimes p (- g)))) (subst '(== (bintimes p (- g)) (* p (- g))))
          (dk-type! '(* p (- g)) 'RR)
          (dk-have! '(= (* p (- g)) (- (* p g))) (lambda () (crs)))
          (subst '(= (* p (- g)) (- (* p g))))
          (dk-have! '(<= g 0) (lambda () (dk-ineq! '(< g 0) '(IN g RR))))
          (dk-cite! 'rr-mul-le-right 'g 0 'p)
          (dk-have! '(<= (* p g) 0) (lambda () (dk-ineq! '(<= (* g p) (* 0 p)) '(= (* 0 p) 0) '(= (* g p) (* p g)) '(IN (* p g) RR) '(IN (* g p) RR))))
          (dk-case-if! (mfm-find-if (dk-goal))
            (lambda (t2 v2)
              (if t2
                  (dk-ineq! '(<= (* p g) 0) '(<= 0 (* p g)) '(IN (* p g) RR))
                  (begin (dk-type! '(- (* p g)) 'RR) (rfl)))))))))
(mfm-qed! 'ptwise-neg-part-scale)

  

