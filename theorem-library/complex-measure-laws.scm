(define (mfk-keep-prop! . fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply keep fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))
;; the first IF subterm, outermost first
(define (mfk-find-if x)
  (cond ((not (pair? x)) #f)
        ((eq? (car x) 'IF) x)
        (#t (let loop ((xs x))
              (cond ((null? xs) #f)
                    ((not (pair? xs)) #f)
                    ((mfk-find-if (car xs)) => (lambda (r) r))
                    (#t (loop (cdr xs))))))))
(define (mfk-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MFK OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))

;; ---------------------------------------------------------------------------
;; for 0 <= al and 0 <= t:  al < sqrt(t)  iff  al * al < t
(sp (make-wff (dk-foralls '(al t) (dk-curry '((IN al RR) (<= 0 al) (IN t RR) (<= 0 t))
  '(IFF (< al (SQRT t)) (< (* al al) t))))))
(dk-peel!)
(dk-have-and! '(IN t RR) '(<= 0 t))
(dk-split-all! (list (dk-cite! 'sqrt-prop 't)))
(let ((s '(SQRT t)))
  (dk-have-and! '(IN al RR) '(IN al RR)) (dk-cite! 'rr-mul-closed 'al 'al)
  (dk-have-and! (list 'IN s 'RR) (list 'IN s 'RR)) (dk-cite! 'rr-mul-closed s s)
  (dk-iff! (lambda (g) (equal? g '(< (* al al) t)))
    (lambda ()
      (dk-have! (list '<= 'al s) (lambda () (dk-ineq! (list '< 'al s) '(IN al RR) (list 'IN s 'RR))))
      (dk-have! (list '< 0 s) (lambda () (dk-ineq! (list '< 'al s) '(<= 0 al) '(IN al RR) (list 'IN s 'RR))))
      (dk-cite! 'rr-mul-le-right 'al s 'al)
      (dk-have-and! (list '< 0 s) (list '< 'al s))
      (dk-cite! 'rr-lt-scale-pos s 'al s)
      (dk-have-and! (list 'IN s 'RR) '(IN al RR)) (dk-cite! 'rr-mul-closed s 'al)
      (dk-have-and! '(IN al RR) (list 'IN s 'RR)) (dk-cite! 'rr-mul-closed 'al s)
      (dk-cite! 'rr-mul-comm 'al s)
      (dk-ineq! (list '<= '(* al al) (list '* s 'al)) (list '< (list '* s 'al) (list '* s s)) (list '= (list '* s s) 't)
                (list 'IN (list '* s s) 'RR) (list 'IN (list '* s 'al) 'RR) '(IN (* al al) RR) '(IN t RR)))
    (lambda ()
      (use-em (list '< 'al s)
        (lambda () (dk-ass!))
        (lambda ()
         (use-em (list '<= s 'al)
          (lambda ()
          (dk-cite! 'rr-mul-le-right s 'al s)
          (dk-cite! 'rr-mul-le-right s 'al 'al)
          (dk-have-and! (list 'IN s 'RR) '(IN al RR)) (dk-cite! 'rr-mul-closed s 'al)
          (dk-have-and! '(IN al RR) (list 'IN s 'RR)) (dk-cite! 'rr-mul-closed 'al s)
          (dk-cite! 'rr-mul-comm 'al s)
          (dk-absurd! '(< (* al al) t) (list '= (list '* s s) 't) (list '<= (list '* s s) (list '* 'al s))
                      (list '<= (list '* s 'al) '(* al al)) (list '= (list '* 'al s) (list '* s 'al))
                      (list 'IN (list '* s s) 'RR) (list 'IN (list '* 'al s) 'RR) (list 'IN (list '* s 'al) 'RR)
                      '(IN (* al al) RR) '(IN t RR)))
          (lambda () (dk-cite! 'rr-not-le-lt s 'al) (ai (list 'NOT (list '< 'al s))))))))))
(mfk-qed! 'sqrt-gt-iff)

;; a nonnegative real measurable function is a measurable [0, +inf] function
(sp (make-wff (dk-foralls '(omega ca f) (dk-curry '((IS-REAL-MEASURABLE-FN omega ca f) (FORALL x_ (IMPLIES (IN x_ omega) (<= 0 (f x_)))))
  '(IS-MEASURABLE-FN omega ca f)))))
(dk-peel!)
(let ((parts (dk-iff-parts! (dk-cite! 'is-real-measurable-fn 'omega 'ca 'f))))
  (dk-iff-fwd! (dk-cite! 'fun-codomain-iff 'omega 'RR 'f))
  (dk-have! '(FORALL x (IMPLIES (IN x omega) (IN (f x) RR-POS-STAR)))
    (lambda () (let ((x (dk-di-var!)))
                 (dk-apply! '(FORALL x (IMPLIES (IN x omega) (IN (f x) RR))) x)
                 (dk-apply! '(FORALL x_ (IMPLIES (IN x_ omega) (<= 0 (f x_)))) x)
                 (let ((iff (dk-cite! 'rr-pos-star-membership (list 'f x))))
                   (dk-have! (list 'IN (list 'f x) 'RR-POS-STAR)
                     (lambda () (mfk-keep-prop! iff (list 'IN (list 'f x) 'RR) (list '<= 0 (list 'f x)))))))))
  (dk-have-and! '(IN f (FUN omega)) '(FORALL x (IMPLIES (IN x omega) (IN (f x) RR-POS-STAR))))
  (dk-iff-bwd! (dk-cite! 'fun-codomain-iff 'omega 'RR-POS-STAR 'f))
  (dk-have! '(FORALL icx_ (IMPLIES (IN icx_ omega) (= ((POS-PART omega f) icx_) (f icx_))))
    (lambda () (let ((x (dk-di-var!)))
                 (dk-apply! '(FORALL x_ (IMPLIES (IN x_ omega) (<= 0 (f x_)))) x)
                 (dk-apply! '(FORALL x (IMPLIES (IN x omega) (IN (f x) RR))) x)
                 (mac 'POS-PART)
                 (dk-lam-b!)
                 (dk-if-branch! #t (mfk-find-if (dk-goal)) #f (lambda () (rfl))))))
  (dk-cite! 'measurable-fn-congruence-ptwise 'omega 'ca '(POS-PART omega f) 'f)
  (dk-ass!))
(mfk-qed! 'real-nonneg-measurable)

;; the square root of a nonnegative real measurable function is real measurable
(define mfk-L '(VNB-LAMBDA sqx_ omega (SQRT (g sqx_))))
(sp (make-wff (dk-foralls '(omega ca g) (dk-curry '((IS-SIGMA-ALGEBRA omega ca) (IS-REAL-MEASURABLE-FN omega ca g) (FORALL x_ (IMPLIES (IN x_ omega) (<= 0 (g x_)))))
  (list 'IS-REAL-MEASURABLE-FN 'omega 'ca mfk-L)))))
(dk-peel!)
(let* ((parts (dk-iff-parts! (dk-cite! 'is-real-measurable-fn 'omega 'ca 'g)))
       (gpos '(FORALL x_ (IMPLIES (IN x_ omega) (<= 0 (g x_)))))
       (gx! (lambda (x) (dk-cite! 'fun-apply-type-c 'g 'omega 'RR x) (dk-apply! gpos x)
                        (dk-have-and! (list 'IN (list 'g x) 'RR) (list '<= 0 (list 'g x)))
                        (dk-split-all! (list (dk-cite! 'sqrt-nonneg (list 'g x)))))))
  (dk-cite! 'sigma-algebra-ambient-set 'omega 'ca)
  (dk-have! (list 'IN mfk-L '(FUN omega RR))
    (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (gx! x) (dk-ass!))))))
  (dk-have! (list 'FORALL 'al (list 'IMPLIES '(IN al RR) (list 'IN (list 'SEP 'x_ 'omega (list '< 'al (list mfk-L 'x_))) 'ca)))
    (lambda ()
      (let* ((al (dk-di-var!)) (sl (list 'SEP 'x_ 'omega (list '< al (list mfk-L 'x_)))))
        (fact 'rr-zero-in)
        (use-em (list '<= 0 al)
          (lambda ()
            (dk-have-and! (list 'IN al 'RR) (list 'IN al 'RR)) (dk-cite! 'rr-mul-closed al al)
            (let ((T (list 'SEP 'x_ 'omega (list '< (list '* al al) '(g x_)))))
              (dk-apply! (dk-cite! 'real-measurable-fn-tails 'omega 'ca 'g) (list '* al al))
              (dk-class-ext! sl T
                (lambda (w)
                  (dk-sep-parts! (list 'IN w sl))
                  (let ((r (dk-ctx-form (list '< al (list mfk-L w)))))
                    (dk-lam-b-h! r)
                    (gx! w)
                    (dk-iff-fwd! (dk-cite! 'sqrt-gt-iff al (list 'g w)))
                    (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
                (lambda (w)
                  (dk-sep-parts! (list 'IN w T))
                  (gx! w)
                  (dk-iff-bwd! (dk-cite! 'sqrt-gt-iff al (list 'g w)))
                  (in-sep! (lambda () (dk-ass!)) (lambda () (dk-lam-b!) (if (not (proof-done? *ps*)) (dk-ass!))))))
              (subst (list '= sl T))
              (dk-ass!)))
          (lambda ()
            (dk-cite! 'rr-not-le-lt 0 al)
            (dk-class-ext! sl 'omega
              (lambda (w) (dk-sep-parts! (list 'IN w sl)) (dk-ass!))
              (lambda (w)
                (gx! w)
                (in-sep! (lambda () (dk-ass!))
                         (lambda () (dk-lam-b!)
                                    (dk-ineq! (list '< al 0) (list '<= 0 (list 'SQRT (list 'g w))) (list 'IN al 'RR) (list 'IN (list 'SQRT (list 'g w)) 'RR))))))
            (subst (list '= sl 'omega))
            (dk-cite! 'sigma-algebra-whole-in 'omega 'ca)
            (dk-ass!))))))
  (dk-cite! 'real-measurable-of-tails 'omega 'ca mfk-L)
  (dk-ass!))
(mfk-qed! 'sqrt-real-measurable)

  

