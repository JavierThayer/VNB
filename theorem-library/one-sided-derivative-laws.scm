;;; =====================================================================
;;; STAGE 9.  THE NOTES' CASE (1): A FUNCTION DEFINED ON BOTH SIDES IS
;;; DIFFERENTIABLE AT x IF AND ONLY IF IT IS RIGHT AND LEFT DIFFERENTIABLE
;;; THERE AND THE TWO DERIVATIVES AGREE.
;;;
;;; One direction is `has-deriv-at-implies-right' / `-left' above (shrink the
;;; symmetric window to a half-window).  The other has to GLUE two Caratheodory
;;; factors -- phi+ on [x, x + w) and phi- on (x - w, x] -- into one on
;;; (x - w, x + w).  An IF on `t < x' would do it and cost a three-way case
;;; analysis in every later step (the typing, the value, and above all the
;;; continuity at x, where the IF's two branches meet).  Batch 15-A met the
;;; same obstacle in EXTEND-CONST and dissolved it with the CLAMP retraction;
;;; the same trick works here, and with no IF anywhere:
;;;
;;;     theta(t)  =  phi+( max(t, x) )  +  phi-( min(t, x) )  -  l .
;;;
;;; For t >= x this is phi+(t) + phi-(x) - l = phi+(t), and for t <= x it is
;;; phi+(x) + phi-(t) - l = phi-(t); at t = x both readings give l, so the two
;;; cases OVERLAP instead of meeting, and the boundary is not a case at all.
;;; max(., x) retracts the line onto [x, infinity) and min(., x) onto
;;; (-infinity, x], both carry (x - w, x + w) into the respective half-window,
;;; and both are 1-Lipschitz TOWARDS x (`rr-max-retract-close',
;;; `rr-min-retract-close'), so each factor's own delta serves unchanged and
;;; the continuity of theta at x is ONE eps/delta with `rr-abs-sum-bound' --
;;; no case analysis, no composition lemma, no metric-space algebra.
;;; =====================================================================

(sp (make-wff '(FORALL f (FORALL osx_ (FORALL osl_
   (IMPLIES (HAS-RIGHT-DERIV-AT f osx_ osl_)
   (IMPLIES (HAS-LEFT-DERIV-AT f osx_ osl_)
            (HAS-DERIV-AT f osx_ osl_))))))))
(dk-peel!)
(fact 'rr-is-metric-space)
(fact 'r7q-rr-pts)
(fact 'rr-is-set)
(fact 'has-right-deriv-at-pt-in-rr 'f 'osx_ 'osl_)
(fact 'has-right-deriv-at-in-rr 'f 'osx_ 'osl_)
(fact 'rr-leq-reflexive 'osx_)
(fact 'rr-one-in)
(fact 'rr-zero-lt-one)
(fact 'rr-pos-rr-of-lt 1)
(define os-gl-w1 (dk-skolem! (dk-fact! 'has-left-deriv-at-shrink 'f 'osx_ 'osl_ 1)))
(dk-split-all!)
(os-pos! os-gl-w1)
(define os-gl-w (dk-skolem! (dk-fact! 'has-right-deriv-at-shrink 'f 'osx_ 'osl_ os-gl-w1)))
(dk-split-all!)
(os-pos! os-gl-w)
(define os-gl-wp (list 'COINT 'osx_ (list '+ 'osx_ os-gl-w)))
(define os-gl-wm (list 'OCINT (list '- 'osx_ os-gl-w) 'osx_))
(define os-gl-v  (list 'OOINT (list '- 'osx_ os-gl-w) (list '+ 'osx_ os-gl-w)))

;;; z in the open window -> max(z, x) in the right half, min(z, x) in the left.
(define (os-gl-halves! z)
  (os-ooint-in! z (list '- 'osx_ os-gl-w) (list '+ 'osx_ os-gl-w))
  ;; `mac-h' CONSUMED the membership it unfolded; put it back (it is wanted
  ;; again, by `subspace-dist' and by the two half-window lemmas).
  (dk-have! (list 'IN z os-gl-v)
    (lambda () (mac 'ooint-membership) (dk-conj-close! (lambda () (ass)))))
  (fact 'rr-max-closed z 'osx_)
  (fact 'rr-min-closed z 'osx_)
  (fact 'rr-le-max-right z 'osx_)
  (fact 'rr-min-le-right z 'osx_)
  (fact 'rr-max-lt z 'osx_ (list '+ 'osx_ os-gl-w))
  (fact 'rr-lt-min (list '- 'osx_ os-gl-w) z 'osx_)
  (dk-have! (list 'IN (list 'max z 'osx_) os-gl-wp)
    (lambda () (mac 'coint-membership) (dk-conj-close! (lambda () (ass)))))
  (dk-have! (list 'IN (list 'min z 'osx_) os-gl-wm)
    (lambda () (mac 'ocint-membership) (dk-conj-close! (lambda () (ass))))))

(fact 'rr-sub-in-rr 'osx_ os-gl-w)
(fact 'rr-add-in-rr 'osx_ os-gl-w)
(dk-have! (list '< 'osx_ (list '+ 'osx_ os-gl-w))
  (lambda () (dk-ineq! '(IN osx_ RR) (list 'IN os-gl-w 'RR) (list '< 0 os-gl-w))))
(dk-have! (list '< (list '- 'osx_ os-gl-w) 'osx_)
  (lambda () (dk-ineq! '(IN osx_ RR) (list 'IN os-gl-w 'RR) (list '< 0 os-gl-w))))
(fact 'ocint-shrink 'osx_ os-gl-w1 os-gl-w)
(fact 'ocint-right-endpoint 'osx_ os-gl-w)
(fact 'coint-left-endpoint 'osx_ os-gl-w)
(fact 'ocint-subset-rr (list '- 'osx_ os-gl-w1) 'osx_)
(fact 'ocint-subset-rr (list '- 'osx_ os-gl-w) 'osx_)
(fact 'coint-subset-rr 'osx_ (list '+ 'osx_ os-gl-w))
(fact 'deriv-within-shrink 'f (list 'OCINT (list '- 'osx_ os-gl-w1) 'osx_)
      os-gl-wm 'osx_ 'osl_)
(fact 'ooint-subset-rr (list '- 'osx_ os-gl-w) (list '+ 'osx_ os-gl-w))
(fact 'ooint-center 'osx_ os-gl-w)
(fact 'subclass-of-set-is-set os-gl-v 'RR)
(dk-have! (list 'SUBSET os-gl-v '(PTS RR-MS))
  (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
(dk-have! (list 'SUBSET os-gl-wp '(PTS RR-MS))
  (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
(dk-have! (list 'SUBSET os-gl-wm '(PTS RR-MS))
  (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
(fact 'subspace-is-metric-space 'RR-MS os-gl-v)
(fact 'subspace-is-metric-space 'RR-MS os-gl-wp)
(fact 'subspace-is-metric-space 'RR-MS os-gl-wm)
(fact 'subspace-pts 'RR-MS os-gl-v)
(fact 'subspace-pts 'RR-MS os-gl-wp)
(fact 'subspace-pts 'RR-MS os-gl-wm)
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'HAS-DERIV-AT-WITHIN (list 'HAS-DERIV-AT-WITHIN 'f os-gl-wp 'osx_ 'osl_)))))
(define os-gl-phip (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the right factor")))
(dk-split-all!)
(define os-gl-univp (os-cara-univ os-gl-phip 'f))
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'HAS-DERIV-AT-WITHIN (list 'HAS-DERIV-AT-WITHIN 'f os-gl-wm 'osx_ 'osl_)))))
(define os-gl-phim (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the left factor")))
(dk-split-all!)
(define os-gl-univm (os-cara-univ os-gl-phim 'f))
(define os-gl-theta
  (list 'VNB-LAMBDA 'osz_ os-gl-v
        (list '- (list '+ (list os-gl-phip (list 'max 'osz_ 'osx_))
                          (list os-gl-phim (list 'min 'osz_ 'osx_)))
              'osl_)))

;;; (1) f is a function on the whole window: it is one on each half.
(dk-have! (list 'IN (list 'RESTRICT 'f os-gl-v) (list 'FUN os-gl-v 'RR))
  (lambda ()
    (mac 'RESTRICT)
    (for-each
     (lambda (k)
       (dk-focus! k)
       (if (equal? (dk-goal) (list 'IN os-gl-v 'SET))
           (ass)
           (let ((z (dk-di-var!)))
             (fact 'ooint-elt-in-rr (list '- 'osx_ os-gl-w) (list '+ 'osx_ os-gl-w) z)
             (for-each
              (lambda (nd)
                (dk-focus! nd)
                (if (dk-ctx-form (list '<= 'osx_ z))
                    (begin
                      (fact 'coint-of-ooint 'osx_ os-gl-w z)
                      (fact 'restrict-apply 'f os-gl-wp z)
                      (fact 'fun-apply-type-c (list 'RESTRICT 'f os-gl-wp) os-gl-wp 'RR z)
                      (subst (list '== (list 'f z) (list (list 'RESTRICT 'f os-gl-wp) z)))
                      (ass))
                    (begin
                      (fact 'rr-not-le-lt 'osx_ z)
                      (dk-have! (list '<= z 'osx_)
                        (lambda () (dk-ineq! (list 'IN z 'RR) '(IN osx_ RR)
                                             (list '< z 'osx_))))
                      (fact 'ocint-of-ooint 'osx_ os-gl-w z)
                      (fact 'restrict-apply 'f os-gl-wm z)
                      (fact 'fun-apply-type-c (list 'RESTRICT 'f os-gl-wm) os-gl-wm 'RR z)
                      (subst (list '== (list 'f z) (list (list 'RESTRICT 'f os-gl-wm) z)))
                      (ass))))
              (dk-opened (lambda () (use-em (list '<= 'osx_ z))))))))
     (dk-opened (lambda () (lam-t))))))

;;; (2) theta is a function on the window.
(dk-have! (list 'IN os-gl-theta (list 'FUN os-gl-v 'RR))
  (lambda ()
    (for-each
     (lambda (k)
       (dk-focus! k)
       (if (equal? (dk-goal) (list 'IN os-gl-v 'SET))
           (ass)
           (let ((z (dk-di-var!)))
             (os-gl-halves! z)
             (fact 'fun-apply-type-c os-gl-phip os-gl-wp 'RR (list 'max z 'osx_))
             (fact 'fun-apply-type-c os-gl-phim os-gl-wm 'RR (list 'min z 'osx_))
             (fact 'rr-add-in-rr (list os-gl-phip (list 'max z 'osx_))
                   (list os-gl-phim (list 'min z 'osx_)))
             (fact 'rr-sub-in-rr (list '+ (list os-gl-phip (list 'max z 'osx_))
                                       (list os-gl-phim (list 'min z 'osx_))) 'osl_)
             (ass))))
     (dk-opened (lambda () (lam-t))))))

;;; (3) theta(x) = l.
(fact 'rr-max-left-le 'osx_ 'osx_)
(fact 'rr-min-left-le 'osx_ 'osx_)
(dk-have! (list '= (list os-gl-theta 'osx_) 'osl_)
  (lambda ()
    (dk-lam-b!)
    (subst (list '= (list 'max 'osx_ 'osx_) 'osx_))
    (subst (list '= (list 'min 'osx_ 'osx_) 'osx_))
    (subst (list '= (list os-gl-phip 'osx_) 'osl_))
    (subst (list '= (list os-gl-phim 'osx_) 'osl_))
    (crs)))

;;; (4) theta is continuous at x.  ONE eps/delta: each retraction moves a point
;;; no further from x than it was, so phi+'s and phi-'s own deltas serve, and
;;; the two halves of eps are added by `rr-abs-sum-bound'.
(dk-have! (list 'IS-CONTINUOUS-AT (os-sub-rr os-gl-v) 'RR-MS os-gl-theta 'osx_)
  (lambda ()
    (dk-have! (list 'IN os-gl-theta (list 'FUN (list 'PTS (os-sub-rr os-gl-v))
                                          '(PTS RR-MS)))
      (lambda ()
        (subst (list '== (list 'PTS (os-sub-rr os-gl-v)) os-gl-v))
        (subst '(== (PTS RR-MS) RR))
        (ass)))
    (dk-have! (list 'IN 'osx_ (list 'PTS (os-sub-rr os-gl-v)))
      (lambda () (subst (list '== (list 'PTS (os-sub-rr os-gl-v)) os-gl-v)) (ass)))
    (mac 'IS-CONTINUOUS-AT)
    (dk-conj-close!
     (lambda ()
       (if (not (eq? (os-head (dk-goal)) 'FORALL))
           (ass)
           (let* ((new (dk-landed* (lambda () (dk-peel!))))
                  (eps (cadr (car (filter (dk-head? 'POS-RR) new)))))
             (os-pos! eps)
             (let ((he (dk-halve! eps)))
               (dk-split-all! (dk-landed* (lambda ()
                 (mac-h 'IS-CONTINUOUS-AT
                        (list 'IS-CONTINUOUS-AT (os-sub-rr os-gl-wp) 'RR-MS
                              os-gl-phip 'osx_)))))
               (dk-split-all! (dk-landed* (lambda ()
                 (mac-h 'IS-CONTINUOUS-AT
                        (list 'IS-CONTINUOUS-AT (os-sub-rr os-gl-wm) 'RR-MS
                              os-gl-phim 'osx_)))))
               (let* ((eup (dk-pick (lambda (fm)
                              (and (pair? fm) (eq? (car fm) 'FORALL)
                                   (dk-contains? fm os-gl-phip)
                                   (dk-contains? fm 'FORSOME)))
                            "the right eps universal"))
                      (eum (dk-pick (lambda (fm)
                              (and (pair? fm) (eq? (car fm) 'FORALL)
                                   (dk-contains? fm os-gl-phim)
                                   (dk-contains? fm 'FORSOME)))
                            "the left eps universal"))
                      (dp (dk-skolem! (dk-apply! eup he))))
                 (dk-split-all!)
                 (os-pos! dp)
                 (let ((dm (dk-skolem! (dk-apply! eum he))))
                   (dk-split-all!)
                   (os-pos! dm)
                   (let ((dup (dk-pick (lambda (fm)
                                 (and (pair? fm) (eq? (car fm) 'FORALL)
                                      (dk-contains? fm dp)
                                      (dk-contains? fm os-gl-phip)))
                               "the right delta universal"))
                         (dum (dk-pick (lambda (fm)
                                 (and (pair? fm) (eq? (car fm) 'FORALL)
                                      (dk-contains? fm dm)
                                      (dk-contains? fm os-gl-phim)))
                               "the left delta universal")))
                     (let ((d (dk-skolem! (dk-fact! 'rr-min-pos dp dm))))
                       (dk-split-all!)
                       (fact 'rr-pos-rr-of-lt d)
                       (ew d)
                       (dk-conj-close!
                        (lambda ()
                          (if (eq? (os-head (dk-goal)) 'POS-RR)
                              (ass)
                              (let* ((landed (dk-landed* (lambda () (dk-peel!))))
                                     (b (cadr (dk-pick
                                               (lambda (fm)
                                                 (and (member fm landed) (pair? fm)
                                                      (eq? (car fm) 'IN)
                                                      (equal? (caddr fm)
                                                              (list 'PTS (os-sub-rr os-gl-v)))))
                                               "the point of the window"))))
                                (dk-have! (list 'IN b os-gl-v)
                                  (lambda ()
                                    (subst (list '== os-gl-v
                                                 (list 'PTS (os-sub-rr os-gl-v))))
                                    (ass)))
                                (os-gl-halves! b)
                                (let ((mx (list 'max b 'osx_))
                                      (mn (list 'min b 'osx_)))
                                  (fact 'fun-apply-type-c os-gl-phip os-gl-wp 'RR mx)
                                  (fact 'fun-apply-type-c os-gl-phim os-gl-wm 'RR mn)
                                  (fact 'fun-apply-type-c os-gl-phip os-gl-wp 'RR 'osx_)
                                  (fact 'fun-apply-type-c os-gl-phim os-gl-wm 'RR 'osx_)
                                  (fact 'subspace-dist 'RR-MS os-gl-v 'osx_ b)
                                  (fact 'rr-ms-dist 'osx_ b)
                                  (fact 'rr-sub-in-rr 'osx_ b)
                                  (fact 'rr-abs-closed (list '- 'osx_ b))
                                  (dk-have! (list '<= (list 'abs (list '- 'osx_ b)) d)
                                    (lambda ()
                                      (subst (list '== (list 'abs (list '- 'osx_ b))
                                                   (list '(DIST RR-MS) 'osx_ b)))
                                      (subst (list '== (list '(DIST RR-MS) 'osx_ b)
                                                   (list (list 'DIST (os-sub-rr os-gl-v))
                                                         'osx_ b)))
                                      (ass)))
                                  (fact 'rr-max-retract-close b 'osx_)
                                  (fact 'rr-min-retract-close b 'osx_)
                                  (fact 'rr-sub-in-rr 'osx_ mx)
                                  (fact 'rr-sub-in-rr 'osx_ mn)
                                  (fact 'rr-abs-closed (list '- 'osx_ mx))
                                  (fact 'rr-abs-closed (list '- 'osx_ mn))
                                  (dk-have! (list 'IN mx (list 'PTS (os-sub-rr os-gl-wp)))
                                    (lambda ()
                                      (subst (list '== (list 'PTS (os-sub-rr os-gl-wp))
                                                   os-gl-wp))
                                      (ass)))
                                  (dk-have! (list 'IN mn (list 'PTS (os-sub-rr os-gl-wm)))
                                    (lambda ()
                                      (subst (list '== (list 'PTS (os-sub-rr os-gl-wm))
                                                   os-gl-wm))
                                      (ass)))
                                  (fact 'subspace-dist 'RR-MS os-gl-wp 'osx_ mx)
                                  (fact 'subspace-dist 'RR-MS os-gl-wm 'osx_ mn)
                                  (fact 'rr-ms-dist 'osx_ mx)
                                  (fact 'rr-ms-dist 'osx_ mn)
                                  (dk-have! (list '<= (list (list 'DIST (os-sub-rr os-gl-wp))
                                                            'osx_ mx) dp)
                                    (lambda ()
                                      (subst (list '== (list (list 'DIST (os-sub-rr os-gl-wp))
                                                             'osx_ mx)
                                                   (list '(DIST RR-MS) 'osx_ mx)))
                                      (subst (list '== (list '(DIST RR-MS) 'osx_ mx)
                                                   (list 'abs (list '- 'osx_ mx))))
                                      (dk-ineq!
                                       (list '<= (list 'abs (list '- 'osx_ mx))
                                             (list 'abs (list '- 'osx_ b)))
                                       (list '<= (list 'abs (list '- 'osx_ b)) d)
                                       (list '<= d dp)
                                       (list 'IN (list 'abs (list '- 'osx_ mx)) 'RR)
