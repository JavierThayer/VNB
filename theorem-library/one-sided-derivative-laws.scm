           (begin (ew os-gl-theta)
                  (dk-conj-close! (lambda () (ass)))))))))
(fact 'has-deriv-at-of-within-ooint 'osx_ os-gl-w 'f 'osl_)
(ass)
(qed 'has-deriv-at-of-one-sided)
