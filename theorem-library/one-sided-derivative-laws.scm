;;; =====================================================================
;;; STAGE 6.  PROPOSITION 2.10, SENTENCES ONE AND TWO.
;;;
;;;     Proposition 2.10.  Suppose f is a function defined on [a, b] with a
;;;     local maximum at x in [a, b].  If [D+ f](x) is defined, then
;;;     [D+ f](x) <= 0.  If [D- f](x) is defined, then [D- f](x) >= 0.
;;;
;;; THE NOTES' PROOF, verbatim: "there is an alpha > 0 such that
;;; f(x + h) <= f(x) for 0 <= h <= alpha.  Thus if 0 <= h <= alpha, the
;;; difference quotient (f(x + h) - f(x)) / h <= 0.  Thus the limit of the LHS
;;; as h -> 0 is <= 0."  Below, with no division: if l > 0 then the factor phi
;;; is above l/2 on a short window (continuity at x, where phi(x) = l), so for
;;; a point t just to the right of x,
;;;
;;;     f(t) - f(x) = phi(t) . (t - x) > 0,
;;;
;;; against the maximum.  t is x + k with k = min(delta, alpha, eps)/2: the
;;; halving is what makes t STRICTLY inside the window, so that t - x > 0 and
;;; the product is strictly positive.  The left half is the mirror, with
;;; t - x < 0 and phi(t) < 0 -- whence `rr-mul-neg-neg-pos'.
;;;
;;; NO HYPOTHESIS RELATES THE WINDOW TO THE DOMAIN, and none is needed:
;;; `restrict-fun-domain-subset' derives [x, x + eps) subset D from the
;;; definition's own `RESTRICT(f, W) in FUN(W, RR)'.  At x = b there is no such
;;; window, the right derivative is FALSE there, and the statement is vacuous
;;; -- which is what the notes mean by "if [D+ f](x) is defined".
;;;
;;; THE DOMAIN IS A PARAMETER.  The theorem is proven for an arbitrary D and
;;; restated at D = CCINT(a, b), the notes' shape, immediately after.
;;; =====================================================================

;;; the abs-bound of a hypothesis, landed as its two inequalities.
(define (os-absplit! f)
  (let* ((nw (dk-landed* (lambda () (mac-h 'rr-abs-bound f))))
         (a  (car (filter (dk-head? 'AND) nw))))
    (filter (lambda (g) (and (pair? g) (memq (car g) '(< <=))))
            (dk-landed* (lambda () (dk-split! a))))))

