(sp (make-wff (forall-guarded '(osx_ osr_) '((IN osx_ RR) (POS-RR osr_))
   '(FORALL osy_ (IMPLIES (IN osy_ (OOINT (- osx_ osr_) (+ osx_ osr_)))
      (IMPLIES (<= osx_ osy_) (IN osy_ (COINT osx_ (+ osx_ osr_)))))))))
(dk-peel!)
(os-pos! 'osr_)
(os-ooint-in! 'osy_ '(- osx_ osr_) '(+ osx_ osr_))
(mac 'coint-membership)
