;;; (5) the factorization, by the two OVERLAPPING cases.
(dk-have! (list 'FORALL 'ost2_ (list 'IMPLIES (list 'IN 'ost2_ os-gl-v)
            (list '= (list '- (list 'f 'ost2_) '(f osx_))
                  (list '* (list os-gl-theta 'ost2_) (list '- 'ost2_ 'osx_)))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (os-gl-halves! z)
      (fact 'fun-apply-type-c os-gl-phip os-gl-wp 'RR (list 'max z 'osx_))
      (fact 'fun-apply-type-c os-gl-phim os-gl-wm 'RR (list 'min z 'osx_))
      (fact 'fun-apply-type-c os-gl-phip os-gl-wp 'RR 'osx_)
      (fact 'fun-apply-type-c os-gl-phim os-gl-wm 'RR 'osx_)
      (fact 'rr-add-in-rr (list os-gl-phip (list 'max z 'osx_))
            (list os-gl-phim (list 'min z 'osx_)))
      (fact 'rr-sub-in-rr (list '+ (list os-gl-phip (list 'max z 'osx_))
                                (list os-gl-phim (list 'min z 'osx_))) 'osl_)
      (dk-have! (list '= (list os-gl-theta z)
                      (list '- (list '+ (list os-gl-phip (list 'max z 'osx_))
                                     (list os-gl-phim (list 'min z 'osx_))) 'osl_))
        (lambda () (dk-lam-b!) (rfl)))
      (for-each
       (lambda (nd)
         (dk-focus! nd)
         (if (dk-ctx-form (list '<= 'osx_ z))
             (begin
               (fact 'coint-of-ooint 'osx_ os-gl-w z)
               (fact 'rr-max-left-le z 'osx_)
               (fact 'rr-min-right-le z 'osx_)
               (fact 'fun-apply-type-c os-gl-phip os-gl-wp 'RR z)
               (dk-have! (list '= (list os-gl-theta z) (list os-gl-phip z))
                 (lambda ()
                   (subst (list '= (list os-gl-theta z)
                                (list '- (list '+ (list os-gl-phip (list 'max z 'osx_))
                                               (list os-gl-phim (list 'min z 'osx_)))
                                      'osl_)))
                   (subst (list '= (list 'max z 'osx_) z))
                   (subst (list '= (list 'min z 'osx_) 'osx_))
                   (subst (list '= (list os-gl-phim 'osx_) 'osl_))
                   (crs)))
               (dk-apply! os-gl-univp z)
               (subst (list '= (list os-gl-theta z) (list os-gl-phip z)))
               (ass))
             (begin
               (fact 'rr-not-le-lt 'osx_ z)
               (dk-have! (list '<= z 'osx_)
                 (lambda () (dk-ineq! (list 'IN z 'RR) '(IN osx_ RR) (list '< z 'osx_))))
               (fact 'ocint-of-ooint 'osx_ os-gl-w z)
               (fact 'rr-max-right-le z 'osx_)
               (fact 'rr-min-left-le z 'osx_)
               (fact 'fun-apply-type-c os-gl-phim os-gl-wm 'RR z)
               (dk-have! (list '= (list os-gl-theta z) (list os-gl-phim z))
                 (lambda ()
                   (subst (list '= (list os-gl-theta z)
                                (list '- (list '+ (list os-gl-phip (list 'max z 'osx_))
                                               (list os-gl-phim (list 'min z 'osx_)))
                                      'osl_)))
                   (subst (list '= (list 'max z 'osx_) 'osx_))
                   (subst (list '= (list 'min z 'osx_) z))
                   (subst (list '= (list os-gl-phip 'osx_) 'osl_))
                   (crs)))
               (dk-apply! os-gl-univm z)
               (subst (list '= (list os-gl-theta z) (list os-gl-phim z)))
               (ass))))
       (dk-opened (lambda () (use-em (list '<= 'osx_ z))))))))

