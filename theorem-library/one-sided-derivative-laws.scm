;;; theta is continuous at the point: ONE eps/delta, the two halves added by
;;; `rr-abs-sum-bound'.
(dk-have! (list 'IS-CONTINUOUS-AT (os-sub-rr 'osw_) 'RR-MS os-sm-theta 'osx_)
  (lambda ()
    (dk-have! (list 'IN os-sm-theta (list 'FUN '(PTS (SUBSPACE-MS RR-MS osw_))
                                          '(PTS RR-MS)))
      (lambda ()
        (subst '(== (PTS (SUBSPACE-MS RR-MS osw_)) osw_))
        (subst '(== (PTS RR-MS) RR))
        (ass)))
    (dk-have! '(IN osx_ (PTS (SUBSPACE-MS RR-MS osw_)))
      (lambda () (subst '(== (PTS (SUBSPACE-MS RR-MS osw_)) osw_)) (ass)))
    (mac 'IS-CONTINUOUS-AT)
    (dk-conj-close!
     (lambda ()
       (if (not (eq? (os-head (dk-goal)) 'FORALL))
           (ass)
           (let* ((new (dk-landed* (lambda () (dk-peel!))))
                  (eps (cadr (car (filter (dk-head? 'POS-RR) new)))))
             (os-pos! eps)
             (let ((he (dk-halve! eps)))
               (dk-split-all! (dk-landed* (lambda ()
                 (mac-h 'IS-CONTINUOUS-AT
                        (list 'IS-CONTINUOUS-AT (os-sub-rr 'osw_) 'RR-MS
                              os-sm-phi 'osx_)))))
               (dk-split-all! (dk-landed* (lambda ()
                 (mac-h 'IS-CONTINUOUS-AT
                        (list 'IS-CONTINUOUS-AT (os-sub-rr 'osw_) 'RR-MS
                              os-sm-psi 'osx_)))))
               (let* ((eup (dk-pick (lambda (fm)
                              (and (pair? fm) (eq? (car fm) 'FORALL)
                                   (dk-contains? fm os-sm-phi)
                                   (dk-contains? fm 'FORSOME)))
                            "the first eps universal"))
                      (eum (dk-pick (lambda (fm)
                              (and (pair? fm) (eq? (car fm) 'FORALL)
                                   (dk-contains? fm os-sm-psi)
                                   (dk-contains? fm 'FORSOME)))
                            "the second eps universal"))
                      (dp (dk-skolem! (dk-apply! eup he))))
                 (dk-split-all!)
                 (os-pos! dp)
                 (let ((dm (dk-skolem! (dk-apply! eum he))))
                   (dk-split-all!)
                   (os-pos! dm)
                   (let ((dup (dk-pick (lambda (fm)
                                 (and (pair? fm) (eq? (car fm) 'FORALL)
                                      (dk-contains? fm dp)
                                      (dk-contains? fm os-sm-phi)))
                               "the first delta universal"))
                         (dum (dk-pick (lambda (fm)
                                 (and (pair? fm) (eq? (car fm) 'FORALL)
                                      (dk-contains? fm dm)
                                      (dk-contains? fm os-sm-psi)))
                               "the second delta universal")))
                     (let ((d (dk-skolem! (dk-fact! 'rr-min-pos dp dm))))
                       (dk-split-all!)
                       (fact 'rr-pos-rr-of-lt d)
                       (ew d)
                       (dk-conj-close!
                        (lambda ()
                          (if (eq? (os-head (dk-goal)) 'POS-RR)
                              (ass)
                              (let* ((landed (dk-landed* (lambda () (dk-peel!))))
                                     (b (cadr (dk-pick
                                               (lambda (fm)
                                                 (and (member fm landed) (pair? fm)
                                                      (eq? (car fm) 'IN)
                                                      (equal? (caddr fm)
                                                              '(PTS (SUBSPACE-MS RR-MS osw_)))))
                                               "the point of the window"))))
                                (dk-have! (list 'IN b 'osw_)
                                  (lambda ()
                                    (subst '(== osw_ (PTS (SUBSPACE-MS RR-MS osw_))))
                                    (ass)))
                                (fact 'fun-apply-type-c os-sm-phi 'osw_ 'RR b)
                                (fact 'fun-apply-type-c os-sm-psi 'osw_ 'RR b)
                                (fact 'subset-mem-fwd 'osw_ 'RR b)
                                (fact 'rr-sub-in-rr 'osx_ b)
                                (fact 'rr-abs-closed (list '- 'osx_ b))
                                (fact 'subspace-dist 'RR-MS 'osw_ 'osx_ b)
                                (fact 'rr-ms-dist 'osx_ b)
                                (dk-have! (list 'IN (list (list 'DIST (os-sub-rr 'osw_))
                                                          'osx_ b) 'RR)
                                  (lambda ()
                                    (subst (list '== (list (list 'DIST (os-sub-rr 'osw_))
                                                           'osx_ b)
                                                 (list '(DIST RR-MS) 'osx_ b)))
                                    (subst (list '== (list '(DIST RR-MS) 'osx_ b)
                                                 (list 'abs (list '- 'osx_ b))))
                                    (ass)))
                                (dk-have! (list '<= (list (list 'DIST (os-sub-rr 'osw_))
                                                          'osx_ b) dp)
                                  (lambda ()
                                    (dk-ineq!
                                     (list '<= (list (list 'DIST (os-sub-rr 'osw_)) 'osx_ b) d)
                                     (list '<= d dp)
                                     (list 'IN d 'RR) (list 'IN dp 'RR)
                                     (list 'IN (list (list 'DIST (os-sub-rr 'osw_)) 'osx_ b)
                                           'RR))))
                                (dk-have! (list '<= (list (list 'DIST (os-sub-rr 'osw_))
                                                          'osx_ b) dm)
                                  (lambda ()
                                    (dk-ineq!
                                     (list '<= (list (list 'DIST (os-sub-rr 'osw_)) 'osx_ b) d)
                                     (list '<= d dm)
                                     (list 'IN d 'RR) (list 'IN dm 'RR)
                                     (list 'IN (list (list 'DIST (os-sub-rr 'osw_)) 'osx_ b)
                                           'RR))))
                                (dk-apply! dup b)
                                (dk-apply! dum b)
                                (fact 'rr-ms-dist (list os-sm-phi 'osx_) (list os-sm-phi b))
                                (fact 'rr-ms-dist (list os-sm-psi 'osx_) (list os-sm-psi b))
                                (fact 'rr-sub-in-rr (list os-sm-phi 'osx_) (list os-sm-phi b))
                                (fact 'rr-sub-in-rr (list os-sm-psi 'osx_) (list os-sm-psi b))
                                (dk-have! (list '<= (list 'abs
                                                     (list '- (list os-sm-phi 'osx_)
                                                           (list os-sm-phi b))) he)
                                  (lambda ()
                                    (subst (list '== (list 'abs
                                                     (list '- (list os-sm-phi 'osx_)
                                                           (list os-sm-phi b)))
                                                 (list '(DIST RR-MS) (list os-sm-phi 'osx_)
                                                       (list os-sm-phi b))))
                                    (ass)))
                                (dk-have! (list '<= (list 'abs
                                                     (list '- (list os-sm-psi 'osx_)
                                                           (list os-sm-psi b))) he)
                                  (lambda ()
                                    (subst (list '== (list 'abs
                                                     (list '- (list os-sm-psi 'osx_)
                                                           (list os-sm-psi b)))
                                                 (list '(DIST RR-MS) (list os-sm-psi 'osx_)
                                                       (list os-sm-psi b))))
                                    (ass)))
                                (dk-have!
                                 (list 'AND
                                       (list 'AND
                                             (list '<= (list 'abs
                                                        (list '- (list os-sm-phi 'osx_)
                                                              (list os-sm-phi b))) he)
                                             (list '<= (list 'abs
                                                        (list '- (list os-sm-psi 'osx_)
                                                              (list os-sm-psi b))) he))
                                       (list '= (list '+ he he) eps))
                                 (lambda () (dk-conj-close! (lambda () (ass)))))
                                (fact 'rr-abs-sum-bound
                                      (list os-sm-phi 'osx_) (list os-sm-psi 'osx_)
                                      (list os-sm-phi b) (list os-sm-psi b) he eps)
                                (fact 'rr-add-in-rr (list os-sm-phi b) (list os-sm-psi b))
                                (dk-have! (list '= (list os-sm-theta b)
                                                (list '+ (list os-sm-phi b)
                                                      (list os-sm-psi b)))
                                  (lambda () (dk-lam-b!) (rfl)))
                                (fact 'fun-apply-type-c os-sm-theta 'osw_ 'RR b)
                                (fact 'fun-apply-type-c os-sm-theta 'osw_ 'RR 'osx_)
                                (fact 'rr-ms-dist (list os-sm-theta 'osx_)
                                      (list os-sm-theta b))
                                (dk-have! (list '= (list os-sm-theta 'osx_)
                                                (list '+ (list os-sm-phi 'osx_)
                                                      (list os-sm-psi 'osx_)))
                                  (lambda () (dk-lam-b!) (rfl)))
                                (subst (list '== (list '(DIST RR-MS)
                                                       (list os-sm-theta 'osx_)
                                                       (list os-sm-theta b))
                                             (list 'abs (list '- (list os-sm-theta 'osx_)
                                                              (list os-sm-theta b)))))
                                (subst (list '= (list os-sm-theta 'osx_)
                                             (list '+ (list os-sm-phi 'osx_)
                                                   (list os-sm-psi 'osx_))))
                                (subst (list '= (list os-sm-theta b)
                                             (list '+ (list os-sm-phi b)
                                                   (list os-sm-psi b))))
                                (ass))))))))))))))))

;;; the factorization: one ring identity.
(dk-have! (list 'FORALL 'ost2_ (list 'IMPLIES '(IN ost2_ osw_)
            (list '= '(- (h ost2_) (h osx_))
                  (list '* (list os-sm-theta 'ost2_) '(- ost2_ osx_)))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (fact 'subset-mem-fwd 'osw_ 'RR z)
      (fact 'fun-apply-type-c os-sm-phi 'osw_ 'RR z)
      (fact 'fun-apply-type-c os-sm-psi 'osw_ 'RR z)
      (fact 'rr-add-in-rr (list os-sm-phi z) (list os-sm-psi z))
      (fact 'restrict-apply 'f 'osw_ z)
      (fact 'restrict-apply 'g 'osw_ z)
      (fact 'restrict-apply 'h 'osw_ z)
      (fact 'restrict-apply 'f 'osw_ 'osx_)
      (fact 'restrict-apply 'g 'osw_ 'osx_)
      (fact 'restrict-apply 'h 'osw_ 'osx_)
      (fact 'fun-apply-type-c '(RESTRICT f osw_) 'osw_ 'RR z)
      (fact 'fun-apply-type-c '(RESTRICT g osw_) 'osw_ 'RR z)
      (fact 'fun-apply-type-c '(RESTRICT f osw_) 'osw_ 'RR 'osx_)
      (fact 'fun-apply-type-c '(RESTRICT g osw_) 'osw_ 'RR 'osx_)
      (dk-have! (list 'IN (list 'f z) 'RR)
        (lambda () (subst (list '== (list 'f z) (list '(RESTRICT f osw_) z))) (ass)))
      (dk-have! (list 'IN (list 'g z) 'RR)
        (lambda () (subst (list '== (list 'g z) (list '(RESTRICT g osw_) z))) (ass)))
      (dk-have! '(IN (f osx_) RR)
        (lambda () (subst '(== (f osx_) ((RESTRICT f osw_) osx_))) (ass)))
      (dk-have! '(IN (g osx_) RR)
        (lambda () (subst '(== (g osx_) ((RESTRICT g osw_) osx_))) (ass)))
      (fact 'rr-sub-in-rr z 'osx_)
      (dk-apply! os-sm-agree z)
      (dk-apply! os-sm-agree 'osx_)
      (dk-apply! os-sm-univf z)
      (dk-apply! os-sm-univg z)
      (dk-have! (list '= (list os-sm-theta z)
                      (list '+ (list os-sm-phi z) (list os-sm-psi z)))
        (lambda () (dk-lam-b!) (rfl)))
      (fact 'rr-mul-in-rr (list os-sm-phi z) (list '- z 'osx_))
      (fact 'rr-mul-in-rr (list os-sm-psi z) (list '- z 'osx_))
      (fact 'rr-add-in-rr (list '* (list os-sm-phi z) (list '- z 'osx_))
            (list '* (list os-sm-psi z) (list '- z 'osx_)))
      (dk-have! (list '= (list '+ (list '- (list 'f z) '(f osx_))
                                (list '- (list 'g z) '(g osx_)))
                      (list '+ (list '* (list os-sm-phi z) (list '- z 'osx_))
                            (list '* (list os-sm-psi z) (list '- z 'osx_))))
        (lambda ()
          (subst (list '= (list '- (list 'f z) '(f osx_))
                       (list '* (list os-sm-phi z) (list '- z 'osx_))))
          (subst (list '= (list '- (list 'g z) '(g osx_))
                       (list '* (list os-sm-psi z) (list '- z 'osx_))))
          (rfl)))
      (subst (list '== (list 'h z) (list '+ (list 'f z) (list 'g z))))
      (subst '(== (h osx_) (+ (f osx_) (g osx_))))
      (subst (list '= (list os-sm-theta z)
                   (list '+ (list os-sm-phi z) (list os-sm-psi z))))
      (dk-have! (list '= (list '- (list '+ (list 'f z) (list 'g z))
                               (list '+ '(f osx_) '(g osx_)))
                      (list '+ (list '- (list 'f z) '(f osx_))
                            (list '- (list 'g z) '(g osx_))))
        (lambda () (crs)))
      (subst (list '= (list '- (list '+ (list 'f z) (list 'g z))
                            (list '+ '(f osx_) '(g osx_)))
                   (list '+ (list '- (list 'f z) '(f osx_))
                         (list '- (list 'g z) '(g osx_)))))
      (subst (list '= (list '+ (list '- (list 'f z) '(f osx_))
                            (list '- (list 'g z) '(g osx_)))
                   (list '+ (list '* (list os-sm-phi z) (list '- z 'osx_))
                         (list '* (list os-sm-psi z) (list '- z 'osx_)))))
      (crs))))

(mac 'HAS-DERIV-AT-WITHIN)
(dk-conj-close!
 (lambda ()
   (if (not (eq? (os-head (dk-goal)) 'FORSOME))
       (ass)
       (begin (ew os-sm-theta)
              (dk-conj-close! (lambda () (ass)))))))
(qed 'deriv-within-sum)
(topic! 'deriv-within-sum 'analysis)
(alias! 'deriv-within-sum "the derivative within a set of a sum is the sum of the derivatives")

;;; the two one-sided corollaries.
(sp (make-wff '(FORALL osr_ (IMPLIES (POS-RR osr_)
   (FORALL f (FORALL g (FORALL h (FORALL osx_ (FORALL osl_ (FORALL osm_
     (IMPLIES (IN (RESTRICT h (COINT osx_ (+ osx_ osr_)))
                  (FUN (COINT osx_ (+ osx_ osr_)) RR))
     (IMPLIES (FORALL osy_ (IMPLIES (IN osy_ (COINT osx_ (+ osx_ osr_)))
                (== (h osy_) (+ (f osy_) (g osy_)))))
     (IMPLIES (HAS-RIGHT-DERIV-AT f osx_ osl_)
     (IMPLIES (HAS-RIGHT-DERIV-AT g osx_ osm_)
              (HAS-RIGHT-DERIV-AT h osx_ (+ osl_ osm_))))))))))))))))
(dk-peel!)
(define os-rs-agree
  (dk-pick (lambda (fm) (and (pair? fm) (eq? (car fm) 'FORALL) (dk-contains? fm 'h)
                             (dk-contains? fm 'f) (dk-contains? fm 'g)))
           "the pointwise agreement"))
(fact 'has-right-deriv-at-pt-in-rr 'f 'osx_ 'osl_)
(os-pos! 'osr_)
(let ((w1 (dk-skolem! (dk-fact! 'has-right-deriv-at-shrink 'f 'osx_ 'osl_ 'osr_))))
  (dk-split-all!)
  (os-pos! w1)
  (let ((w (dk-skolem! (dk-fact! 'has-right-deriv-at-shrink 'g 'osx_ 'osm_ w1))))
    (dk-split-all!)
    (os-pos! w)
    (let ((ww (list 'COINT 'osx_ (list '+ 'osx_ w)))
          (w1w (list 'COINT 'osx_ (list '+ 'osx_ w1)))
          (wr '(COINT osx_ (+ osx_ osr_))))
      (fact 'coint-shrink 'osx_ w1 w)
      (fact 'coint-shrink 'osx_ 'osr_ w1)
      (fact 'coint-left-endpoint 'osx_ w)
      (fact 'coint-subset-rr 'osx_ (list '+ 'osx_ w1))
      (fact 'coint-subset-rr 'osx_ (list '+ 'osx_ w))
      (fact 'subset-trans ww w1w wr)
      (fact 'deriv-within-shrink 'f w1w ww 'osx_ 'osl_)
      (fact 'restrict-in-fun-of-restrict 'h wr 'RR ww)
      (dk-have! (list 'FORALL 'osy_ (list 'IMPLIES (list 'IN 'osy_ ww)
                  (list '== '(h osy_) '(+ (f osy_) (g osy_)))))
        (lambda ()
          (let ((z (dk-di-var!)))
            (fact 'subset-mem-fwd ww wr z)
            (dk-apply! os-rs-agree z)
            (ass))))
      (fact 'deriv-within-sum 'f 'g 'h ww 'osx_ 'osl_ 'osm_)
      (fact 'has-right-deriv-at-intro 'h 'osx_ '(+ osl_ osm_) w)
      (ass))))
(qed 'has-right-deriv-at-sum)
(topic! 'has-right-deriv-at-sum 'analysis)
(alias! 'has-right-deriv-at-sum "the right derivative of a sum is the sum of the right derivatives")

(sp (make-wff '(FORALL osr_ (IMPLIES (POS-RR osr_)
   (FORALL f (FORALL g (FORALL h (FORALL osx_ (FORALL osl_ (FORALL osm_
     (IMPLIES (IN (RESTRICT h (OCINT (- osx_ osr_) osx_))
                  (FUN (OCINT (- osx_ osr_) osx_) RR))
     (IMPLIES (FORALL osy_ (IMPLIES (IN osy_ (OCINT (- osx_ osr_) osx_))
