;;; =====================================================================
;;; STAGE 10.  THE SUM.
;;;
;;; A sum of two functions on a set is not a term the tree can form (there is
;;; no addition on FUN(W, RR)), so the rule is stated for ANY h that agrees
;;; with f + g on the window -- the shape every caller has in hand, and the
;;; shape `has-deriv-at-sum' (interval-calculus-laws.scm) already uses.
;;; The Caratheodory factor of the sum is the sum of the factors; its
;;; continuity is one eps/delta with `rr-abs-sum-bound', and the factorization
;;; is one `crs' identity.
;;; =====================================================================
(sp (make-wff '(FORALL f (FORALL g (FORALL h (FORALL osw_ (FORALL osx_
   (FORALL osl_ (FORALL osm_
   (IMPLIES (SUBSET osw_ RR)
   (IMPLIES (IN (RESTRICT h osw_) (FUN osw_ RR))
   (IMPLIES (FORALL osy_ (IMPLIES (IN osy_ osw_)
              (== (h osy_) (+ (f osy_) (g osy_)))))
   (IMPLIES (HAS-DERIV-AT-WITHIN f osw_ osx_ osl_)
   (IMPLIES (HAS-DERIV-AT-WITHIN g osw_ osx_ osm_)
            (HAS-DERIV-AT-WITHIN h osw_ osx_ (+ osl_ osm_))))))))))))))))
(dk-peel!)
(fact 'rr-is-metric-space)
(fact 'r7q-rr-pts)
(fact 'rr-is-set)
(define os-sm-agree
  (dk-pick (lambda (fm) (and (pair? fm) (eq? (car fm) 'FORALL) (dk-contains? fm 'h)
                             (dk-contains? fm 'f) (dk-contains? fm 'g)))
           "the pointwise agreement"))
(dk-have! '(SUBSET osw_ (PTS RR-MS))
  (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
(fact 'subclass-of-set-is-set 'osw_ 'RR)
(fact 'subspace-is-metric-space 'RR-MS 'osw_)
(fact 'subspace-pts 'RR-MS 'osw_)
(fact 'deriv-within-pt-in 'f 'osw_ 'osx_ 'osl_)
(fact 'subset-mem-fwd 'osw_ 'RR 'osx_)
(fact 'deriv-within-in-rr 'f 'osw_ 'osx_ 'osl_)
(fact 'deriv-within-in-rr 'g 'osw_ 'osx_ 'osm_)
(fact 'deriv-within-restrict-in-fun 'f 'osw_ 'osx_ 'osl_)
(fact 'deriv-within-restrict-in-fun 'g 'osw_ 'osx_ 'osm_)
(fact 'rr-add-in-rr 'osl_ 'osm_)
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'HAS-DERIV-AT-WITHIN '(HAS-DERIV-AT-WITHIN f osw_ osx_ osl_)))))
