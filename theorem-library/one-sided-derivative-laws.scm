;;; THE NOTES' CASE (1), as an equivalence.
(sp (make-wff '(FORALL f (FORALL osx_ (FORALL osl_
   (IFF (HAS-DERIV-AT f osx_ osl_)
        (AND (HAS-RIGHT-DERIV-AT f osx_ osl_)
             (HAS-LEFT-DERIV-AT f osx_ osl_))))))))
