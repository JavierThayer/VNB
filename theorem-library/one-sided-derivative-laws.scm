     (dk-opened (lambda () (lam-t))))))

;;; theta at the point.
(fact 'fun-apply-type-c os-sm-phi 'osw_ 'RR 'osx_)
(fact 'fun-apply-type-c os-sm-psi 'osw_ 'RR 'osx_)
