;;; one-sided-derivative-laws.scm -- the laws of
;;; structure-library/one-sided-derivative.scm: COINT, OCINT,
;;; HAS-DERIV-AT-WITHIN, HAS-RIGHT-DERIV-AT and HAS-LEFT-DERIV-AT.  Everything
;;; here is PROVEN; the definition file asserts nothing.
;;;
;;; THE SOURCE is the user's notes (Supplements to Calculus), section 2.1
;;; (equations (5) and (6) and the definition of differentiability BY CASES)
;;; and section 2.4 (Proposition 2.10, first two sentences).
;;;
;;; THE PLAN.  Every law is a law of HAS-DERIV-AT-WITHIN -- shrinking,
;;; uniqueness, locality -- and the right and left derivatives inherit it in
;;; four lines each.  HAS-DERIV-AT (structure-library/interval-calculus.scm) is
;;; the same predicate at a SYMMETRIC window (`has-deriv-at-iff-within-ooint'),
;;; so the notes' case (1) is a statement about three windows of one notion.
;;;
;;; STAGE 1  the two half-open intervals.
;;; STAGE 2  the domain lemma: a restriction that is a function on W forces W
;;;          inside the domain (this is what makes Proposition 2.10 a theorem
;;;          about f on [a, b] with no extra hypothesis).
;;; STAGE 3  HAS-DERIV-AT-WITHIN: read-offs, shrinking, uniqueness, locality.
;;; STAGE 4  the bridge to HAS-DERIV-AT over a symmetric window.
;;; STAGE 5  the right and left derivatives: read-offs, introduction,
;;;          shrinking, uniqueness, locality, and the two easy halves of the
;;;          notes' case (1).
;;; STAGE 6  Proposition 2.10, sentences one and two.
;;;
;;; Helper prefix: os-.
;;;
;;; Dependencies: structure-library/one-sided-derivative.scm,
;;; structure-library/interval-calculus.scm, structure-library/interval-
;;; extremum.scm; theorem-library/interval-calculus-laws.scm (ooint-*,
;;; has-deriv-at-intro / -shrink / -pt-in-rr / -in-rr, restrict-in-fun-of-
;;; restrict), metric-subspace-laws.scm (subspace-pts, subspace-dist,
;;; subspace-is-metric-space, restrict-apply, restrict-in-fun,
;;; subspace-restrict-continuous-at), diff-on-laws.scm (the ms-agree-*
;;; transports, the rr-nf-* slot read-offs), diff-on-laws-2.scm
;;; (ms-cont-agree-off-pt), rr-abs-basics, rr-order-basics (rr-min-pos),
;;; rr-halving (through dk-halve!), pos-rr-bridges, fun-apply-type-proof,
;;; fun-basics (fun-codomain-iff, fun-domain-apply-def).

;;; ---- file-local driver helpers ---------------------------------------

(define (os-head g) (and (pair? g) (car g)))

(define os-nfm '(NF-METRIC-SPACE RR-NORMED-FIELD))
(define (os-sub-rr w) (list 'SUBSPACE-MS 'RR-MS w))
(define (os-sub-nf w) (list 'SUBSPACE-MS os-nfm w))

;;; forall dfu_ in P1. forall dfv_ in P2. BODY -- the INTERLEAVED spelling the
;;; `ms-agree-*' laws are stated in (`fact' detaches an antecedent only when
;;; the context holds it VERBATIM).
(define (os-fa2 p1 p2 body)
  (list 'FORALL 'dfu_ (list 'IMPLIES (list 'IN 'dfu_ p1)
        (list 'FORALL 'dfv_ (list 'IMPLIES (list 'IN 'dfv_ p2) body)))))

;;; the membership of a half-open interval, landed as its three atoms.
(define (os-coint-in! y a b)
  (dk-split-all! (dk-landed* (lambda ()
    (mac-h 'coint-membership (list 'IN y (list 'COINT a b)))))))
(define (os-ocint-in! y a b)
  (dk-split-all! (dk-landed* (lambda ()
    (mac-h 'ocint-membership (list 'IN y (list 'OCINT a b)))))))
(define (os-ooint-in! y a b)
  (dk-split-all! (dk-landed* (lambda ()
    (mac-h 'ooint-membership (list 'IN y (list 'OOINT a b)))))))

;;; close an AND goal conjunct by conjunct: `ass' when the conjunct is already
;;; in the context, otherwise the oracle with PREMS named by FORMULA.
(define (os-conj-ineq! prems)
  (dk-conj-close!
   (lambda ()
     (if (dk-ctx-form (dk-goal))
         (ass)
         (apply dk-ineq! prems)))))

;;; POS-RR t -> (IN t RR), (< 0 t).
(define (os-pos! t)
  (fact 'rr-pos-rr-in-rr t)
  (fact 'rr-lt-of-pos-rr t))

;;; the base facts about the two spellings of the real line (ic-rr-setup!'s
;;; twin; interval-calculus-laws.scm ~:578).
(define (os-rr-setup!)
  (fact 'rr-is-normed-field)
  (fact 'rr-is-metric-space)
  (fact 'nf-rr-is-metric-space)
  (fact 'nf-rr-agree-pts)
  (fact 'nf-rr-agree-dist)
  (fact 'ms-agree-pts-sym 'RR-MS os-nfm)
  (fact 'ms-agree-dist-sym 'RR-MS os-nfm)
  (fact 'rr-nf-carr)
  (fact 'r7q-rr-pts))

;;; the distance-agreement lane between the two subspaces on W.  GUARD is the
;;; space whose PTS the universal is guarded by.
(define (os-dist-lane! w guard)
  (dk-peel!)
  (for-each
   (lambda (v)
     (dk-have! (list 'IN v w)
       (lambda () (subst (list '== w (list 'PTS guard))) (ass)))
     (fact 'subset-mem-fwd w 'RR v)
     (dk-have! (list 'IN v '(PTS RR-MS))
       (lambda () (subst '(== (PTS RR-MS) RR)) (ass))))
   '(dfu_ dfv_))
  (fact 'subspace-dist 'RR-MS w 'dfu_ 'dfv_)
  (fact 'subspace-dist os-nfm w 'dfu_ 'dfv_)
  (fact 'nf-rr-agree-dist 'dfu_ 'dfv_)
  (subst (list '== (list (list 'DIST (os-sub-nf w)) 'dfu_ 'dfv_)
                   (list (list 'DIST os-nfm) 'dfu_ 'dfv_)))
  (subst (list '== (list (list 'DIST (os-sub-rr w)) 'dfu_ 'dfv_)
                   (list '(DIST RR-MS) 'dfu_ 'dfv_)))
  (subst (list '== (list (list 'DIST os-nfm) 'dfu_ 'dfv_)
                   (list '(DIST RR-MS) 'dfu_ 'dfv_)))
  (qrfl))

;;; everything `ms-agree-continuous-at' wants, in BOTH directions, between
;;; SUBSPACE-MS(RR-MS, W) and SUBSPACE-MS(NF-METRIC-SPACE(RR-NORMED-FIELD), W).
;;; Requires (SUBSET W RR) in context, and os-rr-setup! already run.
(define (os-two-spaces! w)
  (dk-have! (list 'SUBSET w '(PTS RR-MS))
    (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
  (dk-have! (list 'SUBSET w (list 'PTS os-nfm))
    (lambda () (subst (list '== (list 'PTS os-nfm) '(PTS RR-MS))) (ass)))
  (fact 'subspace-is-metric-space 'RR-MS w)
  (fact 'subspace-is-metric-space os-nfm w)
  (fact 'subspace-pts 'RR-MS w)
  (fact 'subspace-pts os-nfm w)
  (dk-have! (list '== (list 'PTS (os-sub-nf w)) (list 'PTS (os-sub-rr w)))
    (lambda ()
      (subst (list '== (list 'PTS (os-sub-nf w)) w))
      (subst (list '== (list 'PTS (os-sub-rr w)) w))
      (qrfl)))
  (dk-have! (list '== (list 'PTS (os-sub-rr w)) (list 'PTS (os-sub-nf w)))
    (lambda ()
      (subst (list '== (list 'PTS (os-sub-nf w)) w))
      (subst (list '== (list 'PTS (os-sub-rr w)) w))
      (qrfl)))
  (dk-have! (os-fa2 (list 'PTS (os-sub-rr w)) (list 'PTS (os-sub-rr w))
              (list '== (list (list 'DIST (os-sub-nf w)) 'dfu_ 'dfv_)
                        (list (list 'DIST (os-sub-rr w)) 'dfu_ 'dfv_)))
    (lambda () (os-dist-lane! w (os-sub-rr w))))
  (dk-have! (os-fa2 (list 'PTS (os-sub-nf w)) (list 'PTS (os-sub-nf w))
              (list '== (list (list 'DIST (os-sub-rr w)) 'dfu_ 'dfv_)
                        (list (list 'DIST (os-sub-nf w)) 'dfu_ 'dfv_)))
    (lambda () (os-dist-lane! w (os-sub-nf w)))))

;;; the Caratheodory universal of a HAS-DERIV-AT-WITHIN package just opened.
(define (os-cara-univ phi fn)
  (dk-pick (lambda (fm) (and (pair? fm) (eq? (car fm) 'FORALL)
                             (dk-contains? fm phi) (dk-contains? fm fn)))
           "the Caratheodory universal"))

;;; =====================================================================
;;; STAGE 1.  THE TWO HALF-OPEN INTERVALS.
;;;
;;; STATEMENT CHECK.  COINT(a, b) and OCINT(a, b) are SEPs over RR, EMPTY
;;; whenever b <= a and whenever a or b is not a real.  That is the fact and no
;;; theorem below carries an `a < b' guard for it.  The membership laws and the
;;; two subset laws DO carry (IN a RR) / (IN b RR) where the order relations
;;; have to talk to each other: off the reals `a < x implies a <= x' is not
;;; available.
;;; =====================================================================

;;; coint-membership: t in [a, b) iff t in RR and a <= t and t < b.
(sp (make-wff '(FORALL a (FORALL b (FORALL osy_
   (IFF (IN osy_ (COINT a b))
        (AND (IN osy_ RR) (AND (<= a osy_) (< osy_ b)))))))))
(dk-peel!)
(mac 'COINT)
(for-each
 (lambda (k)
   (dk-focus! k)
   (if (eq? (os-head (dk-goal)) 'AND)
       (begin (sep-me (dk-pick (lambda (f)
                                 (and (pair? f) (eq? (car f) 'IN)
                                      (pair? (caddr f)) (eq? (car (caddr f)) 'SEP)))
                               "the separation membership"))
              (dk-split-all!)
              (from-context!))
       (begin (dk-split-all!)
              (for-each (lambda (j) (dk-focus! j) (from-context!))
                        (dk-opened (lambda () (sep-mi)))))))
 (dk-opened (lambda () (di))))
(qed 'coint-membership)
(topic! 'coint-membership 'topology)
(alias! 'coint-membership "membership in an interval closed on the left")

;;; ocint-membership: t in (a, b] iff t in RR and a < t and t <= b.
(sp (make-wff '(FORALL a (FORALL b (FORALL osy_
   (IFF (IN osy_ (OCINT a b))
        (AND (IN osy_ RR) (AND (< a osy_) (<= osy_ b)))))))))
(dk-peel!)
(mac 'OCINT)
(for-each
 (lambda (k)
   (dk-focus! k)
   (if (eq? (os-head (dk-goal)) 'AND)
       (begin (sep-me (dk-pick (lambda (f)
                                 (and (pair? f) (eq? (car f) 'IN)
                                      (pair? (caddr f)) (eq? (car (caddr f)) 'SEP)))
                               "the separation membership"))
              (dk-split-all!)
              (from-context!))
       (begin (dk-split-all!)
              (for-each (lambda (j) (dk-focus! j) (from-context!))
                        (dk-opened (lambda () (sep-mi)))))))
 (dk-opened (lambda () (di))))
(qed 'ocint-membership)
(topic! 'ocint-membership 'topology)
(alias! 'ocint-membership "membership in an interval closed on the right")

;;; the two elementhood read-offs.
(sp (make-wff '(FORALL a (FORALL b (FORALL osy_
   (IMPLIES (IN osy_ (COINT a b)) (IN osy_ RR)))))))
(dk-peel!)
(os-coint-in! 'osy_ 'a 'b)
(ass)
(qed 'coint-elt-in-rr)
(topic! 'coint-elt-in-rr 'topology)

(sp (make-wff '(FORALL a (FORALL b (FORALL osy_
   (IMPLIES (IN osy_ (OCINT a b)) (IN osy_ RR)))))))
(dk-peel!)
(os-ocint-in! 'osy_ 'a 'b)
(ass)
(qed 'ocint-elt-in-rr)
(topic! 'ocint-elt-in-rr 'topology)

(sp (make-wff '(FORALL a (FORALL b (SUBSET (COINT a b) RR)))))
(dk-peel!)
(let ((z (subset-by-element!)))
  (fact 'coint-elt-in-rr 'a 'b z)
  (ass))
(qed 'coint-subset-rr)
(topic! 'coint-subset-rr 'topology)

(sp (make-wff '(FORALL a (FORALL b (SUBSET (OCINT a b) RR)))))
(dk-peel!)
(let ((z (subset-by-element!)))
  (fact 'ocint-elt-in-rr 'a 'b z)
  (ass))
(qed 'ocint-subset-rr)
(topic! 'ocint-subset-rr 'topology)

;;; the endpoint that belongs: the left one of [x, x + e), the right one of
;;; (x - e, x].  This is what makes (IN x W) -- conjunct (c) of
;;; HAS-DERIV-AT-WITHIN -- available for the one-sided windows.
(sp (make-wff (forall-guarded '(osx_ osr_) '((IN osx_ RR) (POS-RR osr_))
   '(IN osx_ (COINT osx_ (+ osx_ osr_))))))
(dk-peel!)
(os-pos! 'osr_)
(mac 'coint-membership)
(os-conj-ineq! (list '(IN osx_ RR) '(IN osr_ RR) '(< 0 osr_)))
(qed 'coint-left-endpoint)
(topic! 'coint-left-endpoint 'topology)

(sp (make-wff (forall-guarded '(osx_ osr_) '((IN osx_ RR) (POS-RR osr_))
   '(IN osx_ (OCINT (- osx_ osr_) osx_)))))
(dk-peel!)
(os-pos! 'osr_)
(mac 'ocint-membership)
(os-conj-ineq! (list '(IN osx_ RR) '(IN osr_ RR) '(< 0 osr_)))
(qed 'ocint-right-endpoint)
(topic! 'ocint-right-endpoint 'topology)

;;; each half-window sits inside the symmetric open window of the same radius.
(sp (make-wff (forall-guarded '(osx_ osr_) '((IN osx_ RR) (POS-RR osr_))
   '(SUBSET (COINT osx_ (+ osx_ osr_)) (OOINT (- osx_ osr_) (+ osx_ osr_))))))
(dk-peel!)
(os-pos! 'osr_)
(let ((z (subset-by-element!)))
  (os-coint-in! z 'osx_ '(+ osx_ osr_))
  (mac 'ooint-membership)
  (os-conj-ineq! (list '(IN osx_ RR) '(IN osr_ RR) (list 'IN z 'RR) '(< 0 osr_)
                       (list '<= 'osx_ z) (list '< z '(+ osx_ osr_)))))
(qed 'coint-subset-ooint)
(topic! 'coint-subset-ooint 'topology)

(sp (make-wff (forall-guarded '(osx_ osr_) '((IN osx_ RR) (POS-RR osr_))
   '(SUBSET (OCINT (- osx_ osr_) osx_) (OOINT (- osx_ osr_) (+ osx_ osr_))))))
(dk-peel!)
(os-pos! 'osr_)
(let ((z (subset-by-element!)))
  (os-ocint-in! z '(- osx_ osr_) 'osx_)
  (mac 'ooint-membership)
  (os-conj-ineq! (list '(IN osx_ RR) '(IN osr_ RR) (list 'IN z 'RR) '(< 0 osr_)
                       (list '< '(- osx_ osr_) z) (list '<= z 'osx_))))
(qed 'ocint-subset-ooint)
(topic! 'ocint-subset-ooint 'topology)

;;; a smaller radius gives a smaller half-window.
(sp (make-wff (forall-guarded '(osx_ osr_ osv_)
                '((IN osx_ RR) (POS-RR osr_) (POS-RR osv_))
   '(IMPLIES (<= osv_ osr_)
             (SUBSET (COINT osx_ (+ osx_ osv_)) (COINT osx_ (+ osx_ osr_)))))))
(dk-peel!)
(os-pos! 'osr_)
(os-pos! 'osv_)
(let ((z (subset-by-element!)))
  (os-coint-in! z 'osx_ '(+ osx_ osv_))
  (mac 'coint-membership)
  (os-conj-ineq! (list '(IN osx_ RR) '(IN osr_ RR) '(IN osv_ RR) (list 'IN z 'RR)
                       '(<= osv_ osr_) (list '<= 'osx_ z)
                       (list '< z '(+ osx_ osv_)))))
(qed 'coint-shrink)
(topic! 'coint-shrink 'topology)

(sp (make-wff (forall-guarded '(osx_ osr_ osv_)
                '((IN osx_ RR) (POS-RR osr_) (POS-RR osv_))
   '(IMPLIES (<= osv_ osr_)
             (SUBSET (OCINT (- osx_ osv_) osx_) (OCINT (- osx_ osr_) osx_))))))
(dk-peel!)
(os-pos! 'osr_)
(os-pos! 'osv_)
(let ((z (subset-by-element!)))
  (os-ocint-in! z '(- osx_ osv_) 'osx_)
  (mac 'ocint-membership)
  (os-conj-ineq! (list '(IN osx_ RR) '(IN osr_ RR) '(IN osv_ RR) (list 'IN z 'RR)
                       '(<= osv_ osr_) (list '< '(- osx_ osv_) z)
                       (list '<= z 'osx_))))
(qed 'ocint-shrink)
(topic! 'ocint-shrink 'topology)

;;; THE LEFT ENDPOINT IS A LIMIT POINT OF [x, x + e) FROM INSIDE, and the right
;;; endpoint one of (x - e, x].  This is what makes the one-sided derivative
;;; UNIQUE: without it every value of l would do.  The witness is x + m/2 with
;;; m = min(e, r), the halving being what keeps it STRICTLY inside.
(sp (make-wff (forall-guarded '(osx_ osd_) '((IN osx_ RR) (POS-RR osd_))
   '(FORALL osr_ (IMPLIES (POS-RR osr_)
      (FORSOME osb_
        (AND (IN osb_ (COINT osx_ (+ osx_ osd_)))
        (AND (NOT (= osb_ osx_))
             (<= (abs (- osx_ osb_)) osr_)))))))))
(dk-peel!)
(os-pos! 'osd_)
(os-pos! 'osr_)
(let ((m (dk-skolem! (dk-fact! 'rr-min-pos 'osd_ 'osr_))))
  (dk-split-all!)
  (fact 'rr-pos-rr-of-lt m)
  (let* ((h (dk-halve! m))
         (b (list '+ 'osx_ h))
         (base (list '(IN osx_ RR) '(IN osd_ RR) '(IN osr_ RR)
                     (list 'IN m 'RR) (list 'IN h 'RR)
                     (list '= (list '+ h h) m) (list '<= m 'osd_) (list '<= m 'osr_)
                     (list '< 0 h) (list '< 0 m))))
    (fact 'rr-add-in-rr 'osx_ h)
    (fact 'rr-sub-in-rr 'osx_ b)
    (fact 'rr-sub-in-rr b 'osx_)
    (dk-have! (list '< 'osx_ b) (lambda () (apply dk-ineq! base)))
    (dk-have! (list '<= 0 (list '- b 'osx_)) (lambda () (apply dk-ineq! base)))
    (fact 'rr-abs-sub-sym 'osx_ b)
    (fact 'rr-abs-of-nonneg (list '- b 'osx_))
    (ew b)
    (dk-conj-close!
     (lambda ()
       (let ((g (dk-goal)))
         (cond
           ((eq? (os-head g) 'IN)
            (mac 'coint-membership)
            (os-conj-ineq! (cons (list 'IN b 'RR) base)))
           ((eq? (os-head g) 'NOT)
            (fact 'rr-lt-not-le 'osx_ b)
            (di)
            (fact 'rr-leq-reflexive 'osx_)
            (dk-have! (list '<= b 'osx_)
              (lambda () (subst (list '= b 'osx_)) (ass)))
            (ai (list 'NOT (list '<= b 'osx_))))
           (#t
            (subst (list '= (list 'abs (list '- 'osx_ b)) (list 'abs (list '- b 'osx_))))
            (subst (list '= (list 'abs (list '- b 'osx_)) (list '- b 'osx_)))
            (apply dk-ineq! (cons (list 'IN b 'RR) base)))))))))
(qed 'coint-left-limit-point)
(topic! 'coint-left-limit-point 'topology)
(alias! 'coint-left-limit-point
        "the included endpoint is approached from inside the half-open interval")

(sp (make-wff (forall-guarded '(osx_ osd_) '((IN osx_ RR) (POS-RR osd_))
   '(FORALL osr_ (IMPLIES (POS-RR osr_)
      (FORSOME osb_
        (AND (IN osb_ (OCINT (- osx_ osd_) osx_))
        (AND (NOT (= osb_ osx_))
             (<= (abs (- osx_ osb_)) osr_)))))))))
(dk-peel!)
(os-pos! 'osd_)
(os-pos! 'osr_)
(let ((m (dk-skolem! (dk-fact! 'rr-min-pos 'osd_ 'osr_))))
  (dk-split-all!)
  (fact 'rr-pos-rr-of-lt m)
  (let* ((h (dk-halve! m))
         (b (list '- 'osx_ h))
         (base (list '(IN osx_ RR) '(IN osd_ RR) '(IN osr_ RR)
                     (list 'IN m 'RR) (list 'IN h 'RR)
                     (list '= (list '+ h h) m) (list '<= m 'osd_) (list '<= m 'osr_)
                     (list '< 0 h) (list '< 0 m))))
    (fact 'rr-sub-in-rr 'osx_ h)
    (fact 'rr-sub-in-rr 'osx_ b)
    (dk-have! (list '< b 'osx_) (lambda () (apply dk-ineq! base)))
    (dk-have! (list '<= 0 (list '- 'osx_ b)) (lambda () (apply dk-ineq! base)))
    (fact 'rr-abs-of-nonneg (list '- 'osx_ b))
    (ew b)
    (dk-conj-close!
     (lambda ()
       (let ((g (dk-goal)))
         (cond
           ((eq? (os-head g) 'IN)
            (mac 'ocint-membership)
            (os-conj-ineq! (cons (list 'IN b 'RR) base)))
           ((eq? (os-head g) 'NOT)
            (fact 'rr-lt-not-le b 'osx_)
            (di)
            (fact 'rr-leq-reflexive 'osx_)
            (dk-have! (list '<= 'osx_ b)
              (lambda () (subst (list '= b 'osx_)) (ass)))
            (ai (list 'NOT (list '<= 'osx_ b))))
           (#t
            (subst (list '= (list 'abs (list '- 'osx_ b)) (list '- 'osx_ b)))
            (apply dk-ineq! (cons (list 'IN b 'RR) base)))))))))
(qed 'ocint-right-limit-point)
(topic! 'ocint-right-limit-point 'topology)
(alias! 'ocint-right-limit-point
        "the included endpoint is approached from inside the half-open interval")

;;; =====================================================================
;;; STAGE 2.  THE DOMAIN LEMMA.
;;;
;;; `RESTRICT(f, W) in FUN(W, C)' says that f(t) is DEFINED at every t of W,
;;; and a member of FUN(D, B) is defined EXACTLY on D; so W lies inside D.
;;; Nothing in the tree said this, and it is what Proposition 2.10 needs: the
;;; notes' f is a function on [a, b] and the window of a right derivative at x
;;; must then lie inside [a, b] -- at x = b there is no such window and the
;;; proposition is vacuous, which is exactly what the notes mean.
;;; =====================================================================
(sp (make-wff '(FORALL f (FORALL osd_ (FORALL osc_ (FORALL osw_ (FORALL osb_
   (IMPLIES (IN f (FUN osd_ osc_))
   (IMPLIES (IN (RESTRICT f osw_) (FUN osw_ osb_))
            (SUBSET osw_ osd_))))))))))
(dk-peel!)
(dk-have! '(IN f (FUN osd_))
  (lambda () (fact 'fun-codomain-iff 'osd_ 'osc_ 'f) (prop)))
(let ((z (subset-by-element!)))
  (fact 'restrict-apply 'f 'osw_ z)
  (fact 'fun-apply-type-c (list 'RESTRICT 'f 'osw_) 'osw_ 'osb_ z)
  (dk-have! (list 'IN (list 'f z) 'osb_)
    (lambda ()
      (subst (list '== (list 'f z) (list (list 'RESTRICT 'f 'osw_) z)))
      (ass)))
  (dk-have! (list '= (list 'f z) (list 'f z)) (lambda () (rfl)))
  (fact 'fun-domain-apply-def 'osd_ 'f z)
  (prop))
(qed 'restrict-fun-domain-subset)
(topic! 'restrict-fun-domain-subset 'plumbing)
(alias! 'restrict-fun-domain-subset
        "a restriction that is a function on W forces W inside the domain")

;;; =====================================================================
;;; STAGE 3.  HAS-DERIV-AT-WITHIN.
;;; =====================================================================

;;; the three read-offs the definition carries but does not state.
(sp (make-wff '(FORALL f (FORALL osw_ (FORALL osx_ (FORALL osl_
   (IMPLIES (HAS-DERIV-AT-WITHIN f osw_ osx_ osl_) (IN osl_ RR))))))))
(dk-peel!)
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'HAS-DERIV-AT-WITHIN '(HAS-DERIV-AT-WITHIN f osw_ osx_ osl_)))))
(ass)
(qed 'deriv-within-in-rr)
(topic! 'deriv-within-in-rr 'analysis)

(sp (make-wff '(FORALL f (FORALL osw_ (FORALL osx_ (FORALL osl_
   (IMPLIES (HAS-DERIV-AT-WITHIN f osw_ osx_ osl_) (IN osx_ osw_))))))))
(dk-peel!)
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'HAS-DERIV-AT-WITHIN '(HAS-DERIV-AT-WITHIN f osw_ osx_ osl_)))))
(ass)
(qed 'deriv-within-pt-in)
(topic! 'deriv-within-pt-in 'analysis)

(sp (make-wff '(FORALL f (FORALL osw_ (FORALL osx_ (FORALL osl_
   (IMPLIES (HAS-DERIV-AT-WITHIN f osw_ osx_ osl_)
            (IN (RESTRICT f osw_) (FUN osw_ RR)))))))))
(dk-peel!)
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'HAS-DERIV-AT-WITHIN '(HAS-DERIV-AT-WITHIN f osw_ osx_ osl_)))))
(ass)
(qed 'deriv-within-restrict-in-fun)
(topic! 'deriv-within-restrict-in-fun 'analysis)

;;; deriv-within-shrink: the package survives passing to any smaller window
;;; that still contains the point -- the SAME factor, restricted.  This is the
;;; one lemma the radius of the one-sided definitions rests on.
(sp (make-wff '(FORALL f (FORALL osw_ (FORALL osv_ (FORALL osx_ (FORALL osl_
   (IMPLIES (SUBSET osw_ RR)
   (IMPLIES (HAS-DERIV-AT-WITHIN f osw_ osx_ osl_)
   (IMPLIES (SUBSET osv_ osw_)
   (IMPLIES (IN osx_ osv_)
            (HAS-DERIV-AT-WITHIN f osv_ osx_ osl_))))))))))))
(dk-peel!)
(fact 'rr-is-metric-space)
(fact 'r7q-rr-pts)
(dk-have! '(SUBSET osw_ (PTS RR-MS))
  (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'HAS-DERIV-AT-WITHIN '(HAS-DERIV-AT-WITHIN f osw_ osx_ osl_)))))
(let ((os-phi (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the Caratheodory factor"))))
  (dk-split-all!)
  (let ((univ (os-cara-univ os-phi 'f)))
    (fact 'restrict-in-fun-of-restrict 'f 'osw_ 'RR 'osv_)
    (fact 'restrict-in-fun os-phi 'osw_ 'RR 'osv_)
    (fact 'restrict-apply os-phi 'osv_ 'osx_)
    (fact 'subspace-restrict-continuous-at 'RR-MS 'osw_ 'osv_ 'RR-MS os-phi 'osx_)
    (mac 'HAS-DERIV-AT-WITHIN)
    (dk-conj-close!
     (lambda ()
       (if (not (eq? (os-head (dk-goal)) 'FORSOME))
           (ass)
           (begin
             (ew (list 'RESTRICT os-phi 'osv_))
             (dk-conj-close!
              (lambda ()
                (let ((g (dk-goal)))
                  (cond
                    ((eq? (os-head g) '=)
                     (subst (list '== (list (list 'RESTRICT os-phi 'osv_) 'osx_)
                                  (list os-phi 'osx_)))
                     (ass))
                    ((eq? (os-head g) 'FORALL)
                     (let ((z (dk-di-var!)))
                       (fact 'subset-mem-fwd 'osv_ 'osw_ z)
                       (fact 'restrict-apply os-phi 'osv_ z)
                       (subst (list '== (list (list 'RESTRICT os-phi 'osv_) z)
                                    (list os-phi z)))
                       (dk-apply! univ z)
                       (ass)))
                    (#t (ass))))))))))))
(qed 'deriv-within-shrink)
(topic! 'deriv-within-shrink 'analysis)
(alias! 'deriv-within-shrink
        "a derivative within a set survives shrinking the set")

;;; deriv-within-local: two functions agreeing on the window have the same
;;; derivatives within it.
(sp (make-wff '(FORALL f (FORALL g (FORALL osw_ (FORALL osx_ (FORALL osl_
   (IMPLIES (IN (RESTRICT f osw_) (FUN osw_ RR))
   (IMPLIES (FORALL osy_ (IMPLIES (IN osy_ osw_) (== (f osy_) (g osy_))))
   (IMPLIES (HAS-DERIV-AT-WITHIN g osw_ osx_ osl_)
            (HAS-DERIV-AT-WITHIN f osw_ osx_ osl_)))))))))))
(dk-peel!)
(define os-loc-agree
  (dk-pick (lambda (fm) (and (pair? fm) (eq? (car fm) 'FORALL)
                             (dk-contains? fm 'g) (dk-contains? fm 'f)))
           "the pointwise agreement"))
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'HAS-DERIV-AT-WITHIN '(HAS-DERIV-AT-WITHIN g osw_ osx_ osl_)))))
(let ((os-phi (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the Caratheodory factor"))))
  (dk-split-all!)
  (let ((univ (os-cara-univ os-phi 'g)))
    (dk-apply! os-loc-agree 'osx_)
    (mac 'HAS-DERIV-AT-WITHIN)
    (dk-conj-close!
     (lambda ()
       (if (not (eq? (os-head (dk-goal)) 'FORSOME))
           (ass)
           (begin
             (ew os-phi)
             (dk-conj-close!
              (lambda ()
                (let ((g0 (dk-goal)))
                  (if (not (eq? (os-head g0) 'FORALL))
                      (ass)
                      (let ((z (dk-di-var!)))
                        (dk-apply! os-loc-agree z)
                        (subst (list '== (list 'f z) (list 'g z)))
                        (subst '(== (f osx_) (g osx_)))
                        (dk-apply! univ z)
                        (ass))))))))))))
(qed 'deriv-within-local)
(topic! 'deriv-within-local 'analysis)
(alias! 'deriv-within-local
        "functions agreeing on a set have the same derivatives within it")

;;; deriv-within-unique: the value is unique as soon as the point is approached
;;; from inside the window.  Off the point the two factors agree by cancelling
;;; t - x; at the point they agree by continuity (`ms-cont-agree-off-pt').
(sp (make-wff '(FORALL f (FORALL osw_ (FORALL osx_ (FORALL osl_ (FORALL osm_
   (IMPLIES (SUBSET osw_ RR)
   (IMPLIES (FORALL osr_ (IMPLIES (POS-RR osr_)
              (FORSOME osb_ (AND (IN osb_ osw_)
                            (AND (NOT (= osb_ osx_))
                                 (<= (abs (- osx_ osb_)) osr_))))))
   (IMPLIES (HAS-DERIV-AT-WITHIN f osw_ osx_ osl_)
   (IMPLIES (HAS-DERIV-AT-WITHIN f osw_ osx_ osm_)
            (= osl_ osm_))))))))))))
(dk-peel!)
(fact 'rr-is-metric-space)
(fact 'r7q-rr-pts)
(define os-uq-lim
  (dk-pick (lambda (fm) (and (pair? fm) (eq? (car fm) 'FORALL)
                             (dk-contains? fm 'FORSOME)))
           "the limit-point clause"))
(dk-have! '(SUBSET osw_ (PTS RR-MS))
  (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
(fact 'subspace-is-metric-space 'RR-MS 'osw_)
(fact 'subspace-pts 'RR-MS 'osw_)
(fact 'deriv-within-pt-in 'f 'osw_ 'osx_ 'osl_)
(fact 'subset-mem-fwd 'osw_ 'RR 'osx_)
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'HAS-DERIV-AT-WITHIN '(HAS-DERIV-AT-WITHIN f osw_ osx_ osl_)))))
(define os-phi1 (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the first factor")))
(dk-split-all!)
(define os-univ1 (os-cara-univ os-phi1 'f))
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'HAS-DERIV-AT-WITHIN '(HAS-DERIV-AT-WITHIN f osw_ osx_ osm_)))))
(define os-phi2 (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the second factor")))
(dk-split-all!)
(define os-univ2 (os-cara-univ os-phi2 'f))

;;; the two factors agree off the point, stated over the SUBSPACE's points and
;;; with the binder names `ms-cont-agree-off-pt' uses.
(dk-have! (list 'FORALL 'msy_
            (list 'IMPLIES (list 'IN 'msy_ (list 'PTS (os-sub-rr 'osw_)))
              (list 'IMPLIES '(NOT (= msy_ osx_))
                    (list '= (list os-phi1 'msy_) (list os-phi2 'msy_)))))
  (lambda ()
    (let ((y (dk-di-var!)))
      (di)
      (dk-have! (list 'IN y 'osw_)
        (lambda () (subst (list '== 'osw_ (list 'PTS (os-sub-rr 'osw_)))) (ass)))
      (fact 'subset-mem-fwd 'osw_ 'RR y)
      (fact 'fun-apply-type-c os-phi1 'osw_ 'RR y)
      (fact 'fun-apply-type-c os-phi2 'osw_ 'RR y)
      (fact 'rr-sub-in-rr y 'osx_)
      (fact 'rr-sub-ne-zero y 'osx_)
      (dk-apply! os-univ1 y)
      (dk-apply! os-univ2 y)
      (let ((lhs (list '- (list 'f y) '(f osx_)))
            (p1  (list '* (list os-phi1 y) (list '- y 'osx_)))
            (p2  (list '* (list os-phi2 y) (list '- y 'osx_))))
        (fact 'eq-sym lhs p1)
        (fact 'eq-trans p1 lhs p2))
      (fact 'rr-cancel-mul-right (list os-phi1 y) (list os-phi2 y)
            (list '- y 'osx_))
      (ass))))

;;; the limit-point clause, restated over the subspace's points and distance.
(dk-have! (list 'FORALL 'msr_
            (list 'IMPLIES '(POS-RR msr_)
              (list 'FORSOME 'msb_
                (list 'AND (list 'IN 'msb_ (list 'PTS (os-sub-rr 'osw_)))
                  (list 'AND '(NOT (= msb_ osx_))
                    (list '<= (list (list 'DIST (os-sub-rr 'osw_)) 'osx_ 'msb_)
                          'msr_))))))
  (lambda ()
    (let* ((peeled (dk-peel!))
           (r (cadr (dk-pick (lambda (fm) (and (member fm peeled)
                                               (eq? (os-head fm) 'POS-RR)))
                             "the radius")))
           (b (dk-skolem! (dk-apply! os-uq-lim r))))
      (fact 'subset-mem-fwd 'osw_ 'RR b)
      (fact 'subspace-dist 'RR-MS 'osw_ 'osx_ b)
      (fact 'rr-ms-dist 'osx_ b)
      (ew b)
      (dk-conj-close!
       (lambda ()
         (let ((g (dk-goal)))
           (cond
             ((eq? (os-head g) 'IN)
              (subst (list '== (list 'PTS (os-sub-rr 'osw_)) 'osw_)) (ass))
             ((eq? (os-head g) '<=)
              (subst (list '== (list (list 'DIST (os-sub-rr 'osw_)) 'osx_ b)
                           (list '(DIST RR-MS) 'osx_ b)))
              (subst (list '== (list '(DIST RR-MS) 'osx_ b)
                           (list 'abs (list '- 'osx_ b))))
              (ass))
             (#t (ass)))))))))

(fact 'ms-cont-agree-off-pt (os-sub-rr 'osw_) 'RR-MS os-phi1 os-phi2 'osx_)
(fact 'eq-sym (list os-phi1 'osx_) 'osl_)
(fact 'eq-trans 'osl_ (list os-phi1 'osx_) (list os-phi2 'osx_))
(fact 'eq-trans 'osl_ (list os-phi2 'osx_) 'osm_)
(ass)
(qed 'deriv-within-unique)
(topic! 'deriv-within-unique 'analysis)
(alias! 'deriv-within-unique
        "the derivative within a set is unique when the point is approached from inside")

;;; a product of two negatives is positive.  `rr-mul-pos' has only the positive
;;; case and the tree has neither; it is one `crs' identity away and the left
;;; half of Proposition 2.10 needs it (there t - x < 0).
(sp (make-wff (forall-guarded '(osy_ osb_) '((IN osy_ RR) (IN osb_ RR))
   '(IMPLIES (< osy_ 0) (IMPLIES (< osb_ 0) (< 0 (* osy_ osb_)))))))
(dk-peel!)
(fact 'rr-neg-closed 'osy_)
(fact 'rr-neg-closed 'osb_)
(dk-have! '(< 0 (- osy_)) (lambda () (dk-ineq! '(IN osy_ RR) '(< osy_ 0))))
(dk-have! '(< 0 (- osb_)) (lambda () (dk-ineq! '(IN osb_ RR) '(< osb_ 0))))
(fact 'rr-mul-pos '(- osy_) '(- osb_))
(dk-have! '(= (* (- osy_) (- osb_)) (* osy_ osb_)) (lambda () (crs)))
(subst '(= (* osy_ osb_) (* (- osy_) (- osb_))))
(ass)
(qed 'rr-mul-neg-neg-pos)
(topic! 'rr-mul-neg-neg-pos 'analysis)

;;; =====================================================================
;;; STAGE 4.  THE BRIDGE: HAS-DERIV-AT IS HAS-DERIV-AT-WITHIN ON A SYMMETRIC
;;; WINDOW.
;;;
;;; HAS-DERIV-AT is IS-DIFF-ON on OOINT(x - eps, x + eps), which speaks K's own
;;; operations -- (ADD K), (MUL K), (NEG K) -- and the metric space
;;; NF-METRIC-SPACE(RR-NORMED-FIELD).  HAS-DERIV-AT-WITHIN speaks the numeric
;;; `+ * -' and RR-MS.  The two spaces have the same points and the same
;;; distances (`nf-rr-agree-pts', `nf-rr-agree-dist'), and the operations agree
;;; by `rr-nf-sub' / `rr-nf-mul-apply'; so the translation is done ONCE here,
;;; in both directions, and no later proof of this file meets a normed field.
;;; =====================================================================

;;; has-deriv-at-of-within-ooint: the Caratheodory package on a symmetric
;;; window IS the local derivative.
(sp (make-wff '(FORALL osx_ (FORALL osr_ (IMPLIES (POS-RR osr_)
   (FORALL f (FORALL osl_
     (IMPLIES (HAS-DERIV-AT-WITHIN f (OOINT (- osx_ osr_) (+ osx_ osr_)) osx_ osl_)
              (HAS-DERIV-AT f osx_ osl_)))))))))
(dk-peel!)
(define os-bw-v '(OOINT (- osx_ osr_) (+ osx_ osr_)))
(define os-bw-rf (list 'RESTRICT 'f os-bw-v))
(os-pos! 'osr_)
(os-rr-setup!)
(fact 'deriv-within-pt-in 'f os-bw-v 'osx_ 'osl_)
(fact 'ooint-elt-in-rr '(- osx_ osr_) '(+ osx_ osr_) 'osx_)
(fact 'rr-sub-in-rr 'osx_ 'osr_)
(fact 'rr-add-in-rr 'osx_ 'osr_)
(fact 'ooint-subset-rr '(- osx_ osr_) '(+ osx_ osr_))
(fact 'ooint-open-nf '(- osx_ osr_) '(+ osx_ osr_))
(os-two-spaces! os-bw-v)
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'HAS-DERIV-AT-WITHIN (list 'HAS-DERIV-AT-WITHIN 'f os-bw-v 'osx_ 'osl_)))))
(define os-bw-phi (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the Caratheodory factor")))
(dk-split-all!)
(define os-bw-univ (os-cara-univ os-bw-phi 'f))
(fact 'ms-agree-continuous-at (os-sub-rr os-bw-v) (os-sub-nf os-bw-v)
      'RR-MS os-nfm os-bw-phi 'osx_)
(dk-have! (list 'IN os-bw-rf (list 'FUN os-bw-v '(CARR RR-NORMED-FIELD)))
  (lambda () (subst '(== (CARR RR-NORMED-FIELD) RR)) (ass)))
(dk-have! (list 'IN os-bw-phi (list 'FUN os-bw-v '(CARR RR-NORMED-FIELD)))
  (lambda () (subst '(== (CARR RR-NORMED-FIELD) RR)) (ass)))
(dk-have! '(IN osl_ (CARR RR-NORMED-FIELD))
  (lambda () (subst '(== (CARR RR-NORMED-FIELD) RR)) (ass)))
(dk-have! (list 'IS-DIFF-ON 'RR-NORMED-FIELD os-bw-v os-bw-rf 'osx_ 'osl_)
  (lambda ()
    (mac 'IS-DIFF-ON)
    (dk-conj-close!
     (lambda ()
       (if (not (eq? (os-head (dk-goal)) 'FORSOME))
           (ass)
           (begin
             (ew os-bw-phi)
             (dk-conj-close!
              (lambda ()
                (if (not (eq? (os-head (dk-goal)) 'FORALL))
                    (ass)
                    (let ((z (dk-di-var!)))
                      (fact 'ooint-elt-in-rr '(- osx_ osr_) '(+ osx_ osr_) z)
                      (fact 'fun-apply-type-c os-bw-rf os-bw-v 'RR z)
                      (fact 'fun-apply-type-c os-bw-rf os-bw-v 'RR 'osx_)
                      (fact 'fun-apply-type-c os-bw-phi os-bw-v 'RR z)
                      (fact 'restrict-apply 'f os-bw-v z)
                      (fact 'restrict-apply 'f os-bw-v 'osx_)
                      (fact 'rr-sub-in-rr z 'osx_)
                      (fact 'rr-nf-sub (list os-bw-rf z) (list os-bw-rf 'osx_))
                      (fact 'rr-nf-sub z 'osx_)
                      (fact 'rr-nf-mul-apply (list os-bw-phi z) (list '- z 'osx_))
                      (subst (list '== (list '(ADD RR-NORMED-FIELD) (list os-bw-rf z)
                                             (list '(NEG RR-NORMED-FIELD) (list os-bw-rf 'osx_)))
                                   (list '- (list os-bw-rf z) (list os-bw-rf 'osx_))))
                      (subst (list '== (list '(ADD RR-NORMED-FIELD) z
                                             '((NEG RR-NORMED-FIELD) osx_))
                                   (list '- z 'osx_)))
                      (subst (list '== (list '(MUL RR-NORMED-FIELD) (list os-bw-phi z)
                                             (list '- z 'osx_))
                                   (list '* (list os-bw-phi z) (list '- z 'osx_))))
                      (subst (list '== (list os-bw-rf z) (list 'f z)))
                      (subst (list '== (list os-bw-rf 'osx_) '(f osx_)))
                      (dk-apply! os-bw-univ z)
                      (ass)))))))))))
(fact 'has-deriv-at-intro 'f 'osx_ 'osl_ 'osr_)
(ass)
(qed 'has-deriv-at-of-within-ooint)
(topic! 'has-deriv-at-of-within-ooint 'analysis)
(alias! 'has-deriv-at-of-within-ooint
        "a derivative within a symmetric window is the derivative at the point")

;;; has-deriv-at-to-within-ooint: and conversely, on an arbitrarily small
;;; symmetric window.
(sp (make-wff '(FORALL f (FORALL osx_ (FORALL osl_
   (IMPLIES (HAS-DERIV-AT f osx_ osl_)
   (FORALL osr_ (IMPLIES (POS-RR osr_)
     (FORSOME osv_
       (AND (POS-RR osv_)
       (AND (<= osv_ osr_)
            (HAS-DERIV-AT-WITHIN f (OOINT (- osx_ osv_) (+ osx_ osv_))
                                 osx_ osl_))))))))))))
(dk-peel!)
(fact 'has-deriv-at-pt-in-rr 'f 'osx_ 'osl_)
(fact 'has-deriv-at-in-rr 'f 'osx_ 'osl_)
(os-rr-setup!)
(define os-fw-w (dk-skolem! (dk-fact! 'has-deriv-at-shrink 'f 'osx_ 'osl_ 'osr_)))
(dk-split-all!)
(os-pos! os-fw-w)
(fact 'rr-sub-in-rr 'osx_ os-fw-w)
(fact 'rr-add-in-rr 'osx_ os-fw-w)
(define os-fw-v (list 'OOINT (list '- 'osx_ os-fw-w) (list '+ 'osx_ os-fw-w)))
(define os-fw-rf (list 'RESTRICT 'f os-fw-v))
(fact 'ooint-subset-rr (list '- 'osx_ os-fw-w) (list '+ 'osx_ os-fw-w))
(fact 'ooint-center 'osx_ os-fw-w)
(os-two-spaces! os-fw-v)
(fact 'diff-on-in-fun 'RR-NORMED-FIELD os-fw-v os-fw-rf 'osx_ 'osl_)
(dk-have! (list 'IN os-fw-rf (list 'FUN os-fw-v 'RR))
  (lambda () (subst '(== RR (CARR RR-NORMED-FIELD))) (ass)))
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'IS-DIFF-ON (list 'IS-DIFF-ON 'RR-NORMED-FIELD os-fw-v os-fw-rf
                           'osx_ 'osl_)))))
(define os-fw-phi (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the Caratheodory factor")))
(dk-split-all!)
(define os-fw-univ (os-cara-univ os-fw-phi 'f))
(dk-have! (list 'IN os-fw-phi (list 'FUN os-fw-v 'RR))
  (lambda () (subst '(== RR (CARR RR-NORMED-FIELD))) (ass)))
(fact 'ms-agree-continuous-at (os-sub-nf os-fw-v) (os-sub-rr os-fw-v)
      os-nfm 'RR-MS os-fw-phi 'osx_)
(ew os-fw-w)
(dk-conj-close!
 (lambda ()
   (if (not (eq? (os-head (dk-goal)) 'HAS-DERIV-AT-WITHIN))
       (ass)
       (begin
         (mac 'HAS-DERIV-AT-WITHIN)
         (dk-conj-close!
          (lambda ()
            (if (not (eq? (os-head (dk-goal)) 'FORSOME))
                (ass)
                (begin
                  (ew os-fw-phi)
                  (dk-conj-close!
                   (lambda ()
                     (if (not (eq? (os-head (dk-goal)) 'FORALL))
                         (ass)
                         (let ((z (dk-di-var!)))
                           (fact 'ooint-elt-in-rr (list '- 'osx_ os-fw-w)
                                 (list '+ 'osx_ os-fw-w) z)
                           (fact 'fun-apply-type-c os-fw-rf os-fw-v 'RR z)
                           (fact 'fun-apply-type-c os-fw-rf os-fw-v 'RR 'osx_)
                           (fact 'fun-apply-type-c os-fw-phi os-fw-v 'RR z)
                           (fact 'restrict-apply 'f os-fw-v z)
                           (fact 'restrict-apply 'f os-fw-v 'osx_)
                           (fact 'rr-sub-in-rr z 'osx_)
                           (fact 'rr-nf-sub (list os-fw-rf z) (list os-fw-rf 'osx_))
                           (fact 'rr-nf-sub z 'osx_)
                           (fact 'rr-nf-mul-apply (list os-fw-phi z) (list '- z 'osx_))
                           (subst (list '== (list 'f z) (list os-fw-rf z)))
                           (subst (list '== '(f osx_) (list os-fw-rf 'osx_)))
                           (subst (list '== (list '- (list os-fw-rf z)
                                                  (list os-fw-rf 'osx_))
                                        (list '(ADD RR-NORMED-FIELD) (list os-fw-rf z)
                                              (list '(NEG RR-NORMED-FIELD)
                                                    (list os-fw-rf 'osx_)))))
                           (subst (list '== (list '* (list os-fw-phi z)
                                                  (list '- z 'osx_))
                                        (list '(MUL RR-NORMED-FIELD) (list os-fw-phi z)
                                              (list '- z 'osx_))))
                           (subst (list '== (list '- z 'osx_)
                                        (list '(ADD RR-NORMED-FIELD) z
                                              '((NEG RR-NORMED-FIELD) osx_))))
                           (dk-apply! os-fw-univ z)
                           (ass)))))))))))))
(qed 'has-deriv-at-to-within-ooint)
(topic! 'has-deriv-at-to-within-ooint 'analysis)
(alias! 'has-deriv-at-to-within-ooint
        "the derivative at a point is a derivative within arbitrarily small symmetric windows")

;;; has-deriv-at-iff-within-ooint: the two together.
(sp (make-wff '(FORALL f (FORALL osx_ (FORALL osl_
   (IFF (HAS-DERIV-AT f osx_ osl_)
        (FORSOME osv_
          (AND (POS-RR osv_)
               (HAS-DERIV-AT-WITHIN f (OOINT (- osx_ osv_) (+ osx_ osv_))
                                    osx_ osl_)))))))))
(dk-peel!)
