(dk-split-all!)
(define os-sm-univf (os-cara-univ os-sm-phi 'f))
(dk-split-all! (dk-landed* (lambda ()
  (mac-h 'HAS-DERIV-AT-WITHIN '(HAS-DERIV-AT-WITHIN g osw_ osx_ osm_)))))
(define os-sm-psi (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the second factor")))
(dk-split-all!)
(define os-sm-univg (os-cara-univ os-sm-psi 'g))
(define os-sm-theta
  (list 'VNB-LAMBDA 'osz_ 'osw_
        (list '+ (list os-sm-phi 'osz_) (list os-sm-psi 'osz_))))

;;; theta is a function on the window.
(dk-have! (list 'IN os-sm-theta '(FUN osw_ RR))
  (lambda ()
    (for-each
     (lambda (k)
       (dk-focus! k)
       (if (equal? (dk-goal) '(IN osw_ SET))
           (ass)
           (let ((z (dk-di-var!)))
             (fact 'fun-apply-type-c os-sm-phi 'osw_ 'RR z)
             (fact 'fun-apply-type-c os-sm-psi 'osw_ 'RR z)
