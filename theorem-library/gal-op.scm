;;; gal-op.scm -- a linear operator as an F[x]-module; cyclic vectors, the Krylov basis, the companion
;;; matrix and the minimum polynomial (galois-theory notes, section 7, Proposition 1.36) (GALOIS B6,
;;; 2026-10-26).  Destination: theorem-library/gal-op.scm, library linear-algebra.
;;; Helper prefix go-.
;;; ======================================================================
(define (go-gc-case! p pos neg)
  (cond ((dk-asm? (list 'NOT p)) (neg))
        ((dk-asm? p) (pos))
        (#t (use-em p pos neg))))
(define (go-open! name args hyp)        ; HYP = (NAME . ARGS) in context: land its definiens, split it
  (let* ((iff (apply dk-cite! name args)) (rhs (caddr iff)))
    (if (not (dk-asm? rhs)) (dk-project! rhs name hyp))
    (if (and (dk-head-is? rhs 'AND) (not (and (dk-asm? (cadr rhs)) (dk-asm? (caddr rhs))))) (dk-split-all! (list rhs)))
    rhs))
(define (go-close! name args rhs!)      ; close the goal (NAME . ARGS) by proving its definiens with RHS!
  (let ((iff (apply dk-cite! name args)))
    (dk-have! (caddr iff) rhs!)
    (dk-close-if! (lambda () (dk-only! iff (caddr iff))) prop)))
(define (go-skolem!)
  (let ((w (dk-skolem! (dk-pick (lambda (fm) (dk-head-is? fm 'FORSOME)) "the witness"))))
    (dk-split-all!)
    w))
(define (go-rfl-or-ass!) (cond ((dk-asm? (dk-goal)) (ass)) ((dk-head-is? (dk-goal) '==) (qrfl)) (#t (rfl))))

;;; the operator tt on md: (IS-HOM-MODULE md md tt) in context
(define go-hom-add #f)
(define go-hom-act #f)
(define go-hom-zero '(= (tt (VZERO md)) (VZERO md)))
(define (go-hom!)
  (if (not (dk-asm? '(IN tt (FUN (VEC md) (VEC md)))))
      (let ((rhs (go-open! 'is-hom-module-def '(md md tt) '(IS-HOM-MODULE md md tt))))
        (dk-split-all!)
        (dk-cite! 'module-scalar-ring 'md)
        (dk-cite! 'module-vector-ag-is-abelian-group 'md)
        (dk-cite! 'mvag-carr 'md) (dk-cite! 'mvag-op 'md) (dk-cite! 'mvag-id 'md)
        (dk-cite! 'module-vzero-in 'md)))
  (set! go-hom-add (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'VADD) (not (dk-contains? fm 'ACT)) (dk-contains? fm 'tt))) "additivity"))
  (set! go-hom-act (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'ACT) (dk-contains? fm 'tt))) "homogeneity")))
(define (go-it w k) (list 'OP-ITER 'md 'tt w k))
(define (go-vadd a b) (list '(VADD md) a b))
(define (go-act c a) (list '(ACT md) c a))
(define (go-it-type! w k)               ; w in VEC, k in NN
  (if (not (dk-asm? (list 'IN (go-it w k) '(VEC md)))) (dk-cite! 'op-iter-type k 'md 'tt w)))
(define (go-tt-type! x) (if (not (dk-asm? (list 'IN (list 'tt x) '(VEC md)))) (dk-type! (list 'tt x) '(VEC md))))
(define (go-ind-leaves!)                ; after (ni): (base . step)
  (let* ((ls (dk-open-leaves))
         (st (find-first (lambda (nd) (let ((g (dk-goal-of nd))) (and (dk-head-is? g 'FORALL) (dk-contains? g 'succ)
                                                                     (dk-head-is? (caddr g) 'IMPLIES)
                                                                     (dk-head-is? (cadr (caddr g)) 'IN)
                                                                     (equal? (caddr (cadr (caddr g))) 'NN)))) ls)))
    (cons (find-first (lambda (nd) (not (eq? nd st))) ls) st)))

;; T^k w is a vector
(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (FORALL md (FORALL tt (IMPLIES (IS-HOM-MODULE md md tt)
  (FORALL w (IMPLIES (IN w (VEC md)) (IN (OP-ITER md tt w k) (VEC md)))))))))))
(ni)
(define go1-l (go-ind-leaves!))
(dk-focus! (car go1-l))
(dk-peel!)
(subst (dk-cite! 'op-iter-zero 'md 'tt 'w))
(ass)
(dk-focus! (cdr go1-l))
(define go1-ih (find-first (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'OP-ITER))) (dk-peel!)))
(go-hom!)
(dk-apply! go1-ih 'md 'tt 'w)
(subst (dk-cite! 'op-iter-succ 'md 'tt 'w 'k))
(go-tt-type! (go-it 'w 'k))
(ass)
(qed 'op-iter-type)
(topic! 'op-iter-type 'algebra)

;; T^k is additive, homogeneous, and commutes with T
(define (go-iter-law! name stmt base! step!)
  (sp (make-wff stmt))
  (ni)
  (let ((l (go-ind-leaves!)))
    (dk-focus! (car l))
    (dk-peel!)
    (go-hom!)
    (base!)
    (dk-focus! (cdr l))
    (let ((ih (find-first (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'OP-ITER))) (dk-peel!))))
      (go-hom!)
      (step! ih)))
  (qed name)
  (topic! name 'algebra))
(define (go-hom-stmt body)
  (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'FORALL 'md (list 'FORALL 'tt (list 'IMPLIES '(IS-HOM-MODULE md md tt) body))))))
(define (go-z! w) (subst (dk-cite! 'op-iter-zero 'md 'tt w)))
(define (go-s! w k) (subst (dk-cite! 'op-iter-succ 'md 'tt w k)))

(go-iter-law! 'op-iter-add
  (go-hom-stmt '(FORALL a (IMPLIES (IN a (VEC md)) (FORALL b (IMPLIES (IN b (VEC md))
                  (= (OP-ITER md tt ((VADD md) a b) k) ((VADD md) (OP-ITER md tt a k) (OP-ITER md tt b k))))))))
  (lambda () (dk-cite! 'module-vadd-type 'md 'a 'b) (go-z! (go-vadd 'a 'b)) (go-z! 'a) (go-z! 'b) (go-rfl-or-ass!))
  (lambda (ih)
    (dk-cite! 'module-vadd-type 'md 'a 'b)
    (go-it-type! 'a 'k) (go-it-type! 'b 'k) (go-it-type! (go-vadd 'a 'b) 'k)
    (go-s! (go-vadd 'a 'b) 'k) (go-s! 'a 'k) (go-s! 'b 'k)
    (subst (dk-apply! ih 'md 'tt 'a 'b))
    (subst (dk-apply! go-hom-add (go-it 'a 'k) (go-it 'b 'k)))
    (go-rfl-or-ass!)))

(go-iter-law! 'op-iter-act
  (go-hom-stmt '(FORALL c (IMPLIES (IN c (CARR (SCAL md))) (FORALL a (IMPLIES (IN a (VEC md))
                  (= (OP-ITER md tt ((ACT md) c a) k) ((ACT md) c (OP-ITER md tt a k))))))))
  (lambda () (dk-cite! 'module-act-type 'md 'c 'a) (go-z! (go-act 'c 'a)) (go-z! 'a) (go-rfl-or-ass!))
  (lambda (ih)
    (dk-cite! 'module-act-type 'md 'c 'a)
    (go-it-type! 'a 'k) (go-it-type! (go-act 'c 'a) 'k)
    (go-s! (go-act 'c 'a) 'k) (go-s! 'a 'k)
    (subst (dk-apply! ih 'md 'tt 'c 'a))
    (subst (dk-apply! go-hom-act 'c (go-it 'a 'k)))
    (go-rfl-or-ass!)))

(go-iter-law! 'op-iter-shift
  (go-hom-stmt '(FORALL w (IMPLIES (IN w (VEC md)) (= (OP-ITER md tt (tt w) k) (tt (OP-ITER md tt w k))))))
  (lambda () (go-tt-type! 'w) (go-z! '(tt w)) (go-z! 'w) (go-rfl-or-ass!))
  (lambda (ih)
    (go-tt-type! 'w)
    (go-it-type! 'w 'k) (go-it-type! '(tt w) 'k)
    (go-s! '(tt w) 'k) (go-s! 'w 'k)
    (subst (dk-apply! ih 'md 'tt 'w))
    (go-tt-type! (go-it 'w 'k)) (go-tt-type! (list 'tt (go-it 'w 'k)))
    (go-rfl-or-ass!)))

(go-iter-law! 'op-iter-vzero
  (go-hom-stmt '(= (OP-ITER md tt (VZERO md) k) (VZERO md)))
  (lambda () (go-z! '(VZERO md)) (go-rfl-or-ass!))
  (lambda (ih)
    (go-s! '(VZERO md) 'k)
    (subst (dk-apply! ih 'md 'tt))
    (go-rfl-or-ass!)))

;; a finite sum over 1..n is the SUM-AG of the shifted sequence
(define (go-sh h) (list 'VNB-LAMBDA 'gbk_ 'NN (list h '(succ gbk_))))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'ag (list 'IMPLIES '(IS-ABELIAN-GROUP ag)
  (list 'FORALL 'h (list 'IMPLIES '(IN h (FUN (INTERVAL 1 n) (CARR ag)))
    (list '= '(FINSUM ag h (INTERVAL 1 n)) (list 'SUM-AG 'ag (go-sh 'h) 'n))))))))))
(ni)
(define go2-l (go-ind-leaves!))
(dk-focus! (car go2-l))
(dk-peel!)
(fact 'interval-1-0-empty)
(subst '(= (INTERVAL 1 0) EMPTY-SET))
(subst (dk-cite! 'finsum-empty 'ag 'h))
(subst (dk-cite! 'sum-ag-zero 'ag (go-sh 'h)))
(go-rfl-or-ass!)
(dk-focus! (cdr go2-l))
(define go2-ih (find-first (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'SUM-AG))) (dk-peel!)))
(define (go-seg! i n)                   ; i in ORD-SEGMENT(n), n in NN: land i in NN, i < n, succ i in 1..n
  (if (not (dk-asm? (list 'IN i 'NN))) (dk-cite! 'ord-segment-nn-subset n i))
  (if (not (dk-asm? (list '< i n)))
      (let ((iff (dk-cite! 'seg-mem-lt n i)))
        (dk-have! (list '< i n) (lambda () (dk-close-if! (lambda () (dk-only! iff (list 'IN i (list 'ORD-SEGMENT n)))) prop)))))
  (go-int-succ! i n))
(define (go-int-succ! i n)              ; i in NN, i < n: land succ i in INTERVAL(1, n)
  (if (not (dk-asm? (list 'IN (list 'succ i) (list 'INTERVAL 1 n))))
      (begin
        (dk-cite! 'nn-succ-closed i)
        (dk-cite! 'nn-one-le-succ i)
        (dk-cite! 'nn-lt-succ-le i n)
        (dk-cite! 'interval-mem-intro 1 n (list 'succ i)))))
(define (go-int! z n)                   ; z in INTERVAL(1, n): land z in NN, 1 <= z, z <= n
  (if (not (dk-asm? (list 'IN z 'NN)))
      (let* ((iff (dk-cite! 'interval-membership 1 n z)) (rhs (caddr iff)))
        (dk-have! rhs (lambda () (dk-close-if! (lambda () (dk-only! iff (list 'IN z (list 'INTERVAL 1 n)))) prop)))
        (dk-split-all! (list rhs)))))
(define (go-int-mem! z a b)             ; z in NN, a <= z, z <= b in context: z in INTERVAL(a, b)
  (if (not (dk-asm? (list 'IN z (list 'INTERVAL a b)))) (dk-cite! 'interval-mem-intro a b z)))
(define go2-h2 '(VNB-LAMBDA gbz_ (INTERVAL 1 n) (h gbz_)))
(define (go2-pt! z)                     ; z in 1..n: h(z) in CARR(ag) and h2(z) = h(z)
  (go-int! z 'n)
  (dk-cite! 'nn-succ-closed 'n)
  (dk-have! (list '<= z '(succ n)) (lambda () (dk-nn!)))
  (go-int-mem! z 1 '(succ n))
  (dk-cite! 'fun-apply-type-c 'h '(INTERVAL 1 (succ n)) '(CARR ag) z)
  (dk-have! (list '= (list go2-h2 z) (list 'h z)) (lambda () (dk-close-if! (lambda () (dk-lam-b!)) go-rfl-or-ass!))))
(dk-cite! 'finsum-interval-peel 'ag 'n 'h)
(subst (list '= '(FINSUM ag h (INTERVAL 1 (succ n))) '((OPR ag) (FINSUM ag h (INTERVAL 1 n)) (h (succ n)))))
(fact 'interval-in-set)
(fact 'nn-one-in)
(dk-cite! 'interval-in-set 1 'n)
(dk-cite! 'interval-card-in-nn 1 'n)
(dk-have! (list 'FORALL 'gbw_ (list 'IMPLIES '(IN gbw_ (INTERVAL 1 n)) (list '= '(h gbw_) (list go2-h2 'gbw_))))
  (lambda () (dk-peel!) (go2-pt! 'gbw_) (subst (list '= (list go2-h2 'gbw_) '(h gbw_))) (go-rfl-or-ass!)))
(subst (dk-cite! 'finsum-congruence-q 'ag '(INTERVAL 1 n) 'h go2-h2))
(dk-have! (list 'IN go2-h2 '(FUN (INTERVAL 1 n) (CARR ag)))
  (lambda ()
    (dk-lam-type!
      (lambda () (let ((z (dk-di-var!))) (go2-pt! z) (ass)))
      (lambda () (ass)))))
(subst (dk-apply! go2-ih 'ag go2-h2))
(dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES '(IN gbi_ (ORD-SEGMENT n)) (list '== (list (go-sh go2-h2) 'gbi_) (list (go-sh 'h) 'gbi_))))
  (lambda ()
    (dk-peel!)
    (go-seg! 'gbi_ 'n)
    (go2-pt! '(succ gbi_))
    (dk-close-if! (lambda () (dk-lam-b!)) go-rfl-or-ass!)))
(subst (dk-cite! 'sum-ag-segment-congruence 'n 'ag (go-sh go2-h2) (go-sh 'h)))
(subst (dk-cite! 'sum-ag-succ 'ag (go-sh 'h) 'n))
(dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES '(IN gbi_ (ORD-SEGMENT n)) (list 'IN (list (go-sh 'h) 'gbi_) '(CARR ag))))
  (lambda ()
    (dk-peel!)
    (go-seg! 'gbi_ 'n)
    (go2-pt! '(succ gbi_))
    (dk-close-if! (lambda () (dk-lam-b!)) go-rfl-or-ass!)))
(dk-cite! 'sum-ag-type-ptwise 'n 'ag (go-sh 'h))
(dk-have! '(< n (succ n)) (lambda () (dk-nn!)))
(go-int-succ! 'n '(succ n))
(dk-cite! 'fun-apply-type-c 'h '(INTERVAL 1 (succ n)) '(CARR ag) '(succ n))
(dk-close-if! (lambda () (dk-lam-b!)) go-rfl-or-ass!)
(qed 'finsum-interval-as-sum-ag)
(topic! 'finsum-interval-as-sum-ag 'algebra)

;;; ---- the Krylov family v, T v, ..., T^(n-1) v ----
(define (go-kry v n) (list 'KRYLOV 'md 'tt v n))
(define (go-kg v n) (list 'VNB-LAMBDA '(LIST gkri_ gkrj_) (list 'CARTESIAN (list 'INTERVAL 1 n) '(INTERVAL 1 1)) (list 'OP-ITER 'md 'tt v '(- gkri_ 1))))
(define (go-pred-nn! i n)               ; i in INTERVAL(1, n): land i - 1 in NN
  (go-int! i n)
  (if (not (dk-asm? (list 'IN (list '- i 1) 'NN)))
      (let ((k (begin (dk-cite! 'nn-pos-is-succ i) (go-skolem!))))
        (dk-cite! 'bt-succ-minus-1 k)
        (dk-have! (list 'IN (list '- i 1) 'NN)
          (lambda () (subst (list '= i (list 'succ k))) (subst (list '= (list '- (list 'succ k) 1) k)) (ass))))))
(define (go-kg-val! v n i j)            ; g(i, j) = T^(i-1) v, a vector
  (go-pred-nn! i n)
  (go-it-type! v (list '- i 1))
  (dk-have! (list '= (list (go-kg v n) i j) (go-it v (list '- i 1))) (lambda () (dk-close-if! (lambda () (dk-lam-b!)) go-rfl-or-ass!))))
(define (go-kg-set! v n)
  (dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 n)) (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ (INTERVAL 1 1)) (list 'IN (list (go-kg v n) 'i_ 'j_) 'SET)))))
    (lambda ()
      (let* ((ls (dk-peel!))
             (ins (map cadr (filter (lambda (fm) (and (dk-head-is? fm 'IN) (dk-head-is? (caddr fm) 'INTERVAL))) ls)))
             (i (car ins)) (j (cadr ins)))
        (go-kg-val! v n i j)
        (subst (list '= (list (go-kg v n) i j) (go-it v (list '- i 1))))
        (dk-cite! 'membership-implies-sethood (go-it v (list '- i 1)) '(VEC md))
        (ass)))))

(sp (make-wff '(FORALL md (FORALL tt (IMPLIES (IS-HOM-MODULE md md tt) (FORALL n (IMPLIES (IN n NN) (FORALL v (IMPLIES (IN v (VEC md))
  (FORALL i (IMPLIES (IN i (INTERVAL 1 n)) (= (ENTRY (KRYLOV md tt v n) i 1) (OP-ITER md tt v (- i 1))))))))))))))
(dk-peel!)
(go-hom!)
(fact 'nn-one-in)
(dk-cite! 'nn-one-le-succ 0)
(go-kg-set! 'v 'n)
(mac 'KRYLOV)
(fact 'nn-zero-in)
(dk-have! '(IN 1 (INTERVAL 1 1)) (lambda () (dk-have! '(<= 1 1) (lambda () (dk-nn!))) (dk-cite! 'interval-mem-intro 1 1 1) (ass)))
(subst (dk-cite! 'entry-of-matof 'n 1 (go-kg 'v 'n) 'i 1))
(go-kg-val! 'v 'n 'i 1)
(dk-close-if! (lambda () #t) go-rfl-or-ass!)
(qed 'krylov-entry)
(topic! 'krylov-entry 'algebra)

(sp (make-wff '(FORALL md (FORALL tt (IMPLIES (IS-HOM-MODULE md md tt) (FORALL n (IMPLIES (IN n NN) (FORALL v (IMPLIES (IN v (VEC md))
  (IN (KRYLOV md tt v n) (MAT n 1 (VEC md))))))))))))
(dk-peel!)
(go-hom!)
(fact 'nn-one-in)
(dk-have! (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 n)) (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ (INTERVAL 1 1)) (list 'IN (list (go-kg 'v 'n) 'i_ 'j_) '(VEC md))))))
  (lambda ()
    (let* ((ls (dk-peel!))
           (ins (map cadr (filter (lambda (fm) (and (dk-head-is? fm 'IN) (dk-head-is? (caddr fm) 'INTERVAL))) ls)))
           (i (car ins)) (j (cadr ins)))
      (go-kg-val! 'v 'n i j)
      (subst (list '= (list (go-kg 'v 'n) i j) (go-it 'v (list '- i 1))))
      (ass))))
(mac 'KRYLOV)
(dk-cite! 'matof-in-mat 'n 1 '(VEC md) (go-kg 'v 'n))
(ass)
(qed 'krylov-in-mat)
(topic! 'krylov-in-mat 'algebra)

;; a linear combination of the Krylov family is a polynomial-shaped sum
(define (go-ks c v) (list 'VNB-LAMBDA 'gpk_ 'NN (list '(ACT md) (list 'ENTRY c 1 '(succ gpk_)) (list 'OP-ITER 'md 'tt v 'gpk_))))
(define go-mv '(MODULE-VECTOR-AG md))
(sp (make-wff (list 'FORALL 'md (list 'FORALL 'tt (list 'IMPLIES '(IS-HOM-MODULE md md tt) (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
  (list 'FORALL 'v (list 'IMPLIES '(IN v (VEC md)) (list 'FORALL 'c (list 'IMPLIES '(IN c (MAT 1 n (CARR (SCAL md))))
    (list '= (list 'LINCOMB 'md 'n 'c (go-kry 'v 'n)) (list 'SUM-AG go-mv (go-ks 'c 'v) 'n)))))))))))))
(dk-peel!)
(go-hom!)
(fact 'nn-one-in)
(dk-have! '(IN 1 (INTERVAL 1 1)) (lambda () (dk-have! '(<= 1 1) (lambda () (dk-nn!))) (dk-cite! 'interval-mem-intro 1 1 1) (ass)))
(dk-cite! 'krylov-in-mat 'md 'tt 'n 'v)
(define go3-L (caddr (dk-cite! 'lincomb-unfold 'md 'n 'c (go-kry 'v 'n))))
(define go3-La (caddr go3-L))     ; FINSUM(ag, LAMBDA, S): the lambda
(subst (list '= (list 'LINCOMB 'md 'n 'c (go-kry 'v 'n)) go3-L))
(define (go3-pt! j)                     ; j in 1..n: Lambda(j) = c_j T^(j-1) v, a vector
  (go-int! j 'n)
  (dk-cite! 'entry-in-carrier 1 'n '(CARR (SCAL md)) 'c 1 j)
  (dk-cite! 'krylov-entry 'md 'tt 'n 'v j)
  (go-pred-nn! j 'n)
  (go-it-type! 'v (list '- j 1))
  (dk-cite! 'module-act-type 'md (list 'ENTRY 'c 1 j) (go-it 'v (list '- j 1)))
  (let ((val (list '(ACT md) (list 'ENTRY 'c 1 j) (go-it 'v (list '- j 1)))))
    (dk-have! (list '= (list go3-La j) val)
      (lambda () (dk-lam-b!) (subst (list '= (list 'ENTRY (go-kry 'v 'n) j 1) (go-it 'v (list '- j 1)))) (go-rfl-or-ass!)))
    val))
(dk-have! (list 'IN go3-La (list 'FUN '(INTERVAL 1 n) (list 'CARR go-mv)))
  (lambda ()
    (dk-lam-type!
      (lambda () (let* ((j (dk-di-var!)) (val (go3-pt! j)))
                   (subst (list '= (list 'CARR go-mv) '(VEC md)))
                   (subst (list '= (list 'ENTRY (go-kry 'v 'n) j 1) (go-it 'v (list '- j 1))))
                   (ass)))
      (lambda () (dk-cite! 'interval-in-set 1 'n) (ass)))))
(subst (dk-cite! 'finsum-interval-as-sum-ag 'n go-mv go3-La))
(dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES '(IN gbi_ (ORD-SEGMENT n)) (list '== (list (go-sh go3-La) 'gbi_) (list (go-ks 'c 'v) 'gbi_))))
  (lambda ()
    (dk-peel!)
    (go-seg! 'gbi_ 'n)
    (go3-pt! '(succ gbi_))
    (dk-cite! 'bt-succ-minus-1 'gbi_)
    (dk-lam-b!)
    (subst (list '= (list 'ENTRY (go-kry 'v 'n) '(succ gbi_) 1) (go-it 'v '(- (succ gbi_) 1))))
    (subst '(= (- (succ gbi_) 1) gbi_))
    (go-rfl-or-ass!)))
(subst (dk-cite! 'sum-ag-segment-congruence 'n go-mv (go-sh go3-La) (go-ks 'c 'v)))
(dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES '(IN gbi_ (ORD-SEGMENT n)) (list 'IN (list (go-ks 'c 'v) 'gbi_) (list 'CARR go-mv))))
  (lambda ()
    (dk-peel!)
    (go-seg! 'gbi_ 'n)
    (dk-cite! 'entry-in-carrier 1 'n '(CARR (SCAL md)) 'c 1 '(succ gbi_))
    (go-it-type! 'v 'gbi_)
    (dk-cite! 'module-act-type 'md '(ENTRY c 1 (succ gbi_)) (go-it 'v 'gbi_))
    (subst (list '= (list 'CARR go-mv) '(VEC md)))
    (dk-close-if! (lambda () (dk-lam-b!)) go-rfl-or-ass!)))
(dk-cite! 'sum-ag-type-ptwise 'n go-mv (go-ks 'c 'v))
(go-rfl-or-ass!)
(qed 'lincomb-krylov)
(topic! 'lincomb-krylov 'algebra)

;;; ---- polynomials: coefficients, and p(T) as a partial sum up to any degree bound ----
(define go-NM 'NN-ADD-MONOID)
(define (go-conjs f) (if (and (pair? f) (eq? (car f) 'AND)) (append (go-conjs (cadr f)) (go-conjs (caddr f))) (list f)))
(define (go-iff! thm lhs . args)
  (let ((ii (apply dk-cite! thm args)))
    (if (not (every dk-asm? (go-conjs (caddr ii))))
        (begin
          (dk-have! (caddr ii) (lambda () (dk-close-if! (lambda () (dk-only! ii lhs)) prop)))
          (dk-split-all! (list (caddr ii)))))
    (caddr ii)))
(define (go-km! k)
  (let ((want (list 'IN k '(CARR NN-ADD-MONOID))))
    (if (not (dk-asm? want)) (dk-have! want (lambda () (slot 'CARR) (ass))))))

(sp (make-wff '(FORALL a (IMPLIES (IS-RING a) (FORALL p (IMPLIES (IN p (CARR (POLY a)))
  (FORALL k (IMPLIES (IN k NN) (IN (p k) (CARR a))))))))))
(dk-peel!)
(if (not (dk-asm? '(IS-MONOID NN-ADD-MONOID)))
    (begin (fact 'nn-add-monoid-is-comm-monoid) (fact 'comm-monoid-is-monoid 'NN-ADD-MONOID)))
(dk-have! '(IN p (FINSUPP a NN-ADD-MONOID)) (lambda () (mac-h 'poly-carrier '(IN p (CARR (POLY a)))) (ass)))
(go-km! 'k)
(go-iff! 'finsupp-membership '(IN p (FINSUPP a NN-ADD-MONOID)) 'a go-NM 'p)
(dk-cite! 'fun-apply-type-c 'p '(CARR NN-ADD-MONOID) '(CARR a) 'k)
(ass)
(qed 'poly-coef-in)
(topic! 'poly-coef-in 'algebra)

(define go-F '(SCAL md))
(define (go-nn! t)                      ; land t in NN for t built from NN atoms by succ and +
  (if (not (dk-asm? (list 'IN t 'NN)))
      (cond ((dk-head-is? t 'succ) (go-nn! (cadr t)) (dk-cite! 'nn-succ-closed (cadr t)))
            ((dk-head-is? t '+) (go-nn! (cadr t)) (go-nn! (caddr t))
             (dk-have! (list 'AND (list 'IN (cadr t) 'NN) (list 'IN (caddr t) 'NN)) (lambda () (dk-conj-close!)))
             (dk-cite! 'nn-add-closed (cadr t) (caddr t)))
            ((dk-head-is? t 'DEG) (go-deg! (caddr t)))
            (#t (error "go-nn!: cannot type" (expression->string t))))))
(define (go-ps p w) (list 'VNB-LAMBDA 'gpok_ 'NN (list '(ACT md) (list p 'gpok_) (list 'OP-ITER 'md 'tt w 'gpok_))))
(define (go-S p w n) (list 'SUM-AG go-mv (go-ps p w) n))
(define (go-ps-at! p w k)               ; k in NN: PS(k) = p_k T^k w, a vector
  (let ((val (list '(ACT md) (list p k) (go-it w k))))
    (dk-cite! 'poly-coef-in go-F p k)
    (go-it-type! w k)
    (dk-cite! 'module-act-type 'md (list p k) (go-it w k))
    (if (not (dk-asm? (list '= (list (go-ps p w) k) val)))
        (dk-have! (list '= (list (go-ps p w) k) val) (lambda () (dk-close-if! (lambda () (dk-lam-b!)) go-rfl-or-ass!))))
    val))
(define (go-ps-sub! p w k)               ; rewrite PS(k) in the goal to p_k T^k w
  (let ((val (go-ps-at! p w k))) (subst (list '= (list (go-ps p w) k) val))))
(define (go-S-typ! p w n)               ; n in NN
  (go-nn! n)
  (dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT n)) (list 'IN (list (go-ps p w) 'gbi_) (list 'CARR go-mv))))
    (lambda ()
      (dk-peel!)
      (let* ((i (cadr (cadr (dk-goal)))) (_ (begin (go-nn! n) (dk-cite! 'ord-segment-nn-subset n i))) (val (go-ps-at! p w i)))
        (subst (list '= (list (go-ps p w) i) val))
        (subst (list '= (list 'CARR go-mv) '(VEC md)))
        (ass))))
  (dk-cite! 'sum-ag-type-ptwise n go-mv (go-ps p w))
  (let ((t (list 'IN (go-S p w n) (list 'CARR go-mv))))
    (if (not (dk-asm? (list 'IN (go-S p w n) '(VEC md)))) (dk-rewrite-h! t (list 'CARR go-mv) '(VEC md)))))
(define (go-deg! p)                     ; p in CARR(POLY F): DEG in NN, DEG-BOUND at DEG, minimality
  (dk-split-all! (list (dk-cite! 'deg-well-defined go-F p))))
(define go-poly-stmt                    ; md, tt, hom, p, w prefix
  (lambda (body)
    (list 'FORALL 'md (list 'FORALL 'tt (list 'IMPLIES '(IS-HOM-MODULE md md tt)
      (list 'FORALL 'p (list 'IMPLIES '(IN p (CARR (POLY (SCAL md))))
        (list 'FORALL 'w (list 'IMPLIES '(IN w (VEC md)) body)))))))))

(sp (make-wff (list 'FORALL 'j (list 'IMPLIES '(IN j NN)
  (go-poly-stmt (list '= (go-S 'p 'w '(succ (+ (DEG (SCAL md) p) j))) (go-S 'p 'w '(succ (DEG (SCAL md) p)))))))))
(ni)
(define go4-l (go-ind-leaves!))
(dk-focus! (car go4-l))
(dk-peel!)
(go-hom!)
(go-deg! 'p)
(fact 'nn-succ-closed '(DEG (SCAL md) p))
(go-S-typ! 'p 'w '(succ (DEG (SCAL md) p)))
(subst (dk-cite! 'nn-add-zero '(DEG (SCAL md) p)))
(go-rfl-or-ass!)
(dk-focus! (cdr go4-l))
(define go4-ih (find-first (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'SUM-AG))) (dk-peel!)))
(go-hom!)
(go-deg! 'p)
(define go4-Dj '(+ (DEG (SCAL md) p) j))
(dk-have! '(AND (IN (DEG (SCAL md) p) NN) (IN j NN)) (lambda () (dk-conj-close!)))
(fact 'nn-add-closed '(DEG (SCAL md) p) 'j)
(fact 'nn-succ-closed go4-Dj)
(subst (dk-cite! 'nn-add-succ '(DEG (SCAL md) p) 'j))
(subst (dk-cite! 'sum-ag-succ go-mv (go-ps 'p 'w) (list 'succ go4-Dj)))
(subst (dk-apply! go4-ih 'md 'tt 'p 'w))
(let ((val (go-ps-at! 'p 'w (list 'succ go4-Dj))))
  (subst (list '= (list (go-ps 'p 'w) (list 'succ go4-Dj)) val)))
(dk-have! (list '< '(DEG (SCAL md) p) (list 'succ go4-Dj)) (lambda () (dk-nn!)))
(subst (dk-cite! 'deg-bound-apply go-F 'p '(DEG (SCAL md) p) (list 'succ go4-Dj)))
(go-it-type! 'w (list 'succ go4-Dj))
(subst (dk-cite! 'module-zero-act 'md (go-it 'w (list 'succ go4-Dj))))
(subst (list '= (list 'OPR go-mv) '(VADD md)))
(go-S-typ! 'p 'w '(succ (DEG (SCAL md) p)))
(subst (dk-cite! 'abelian-group-right-id-module-vector-ag 'md (go-S 'p 'w '(succ (DEG (SCAL md) p)))))
(go-rfl-or-ass!)
(qed 'poly-op-sum-stable)
(topic! 'poly-op-sum-stable 'algebra)

(sp (make-wff (go-poly-stmt (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IMPLIES '(DEG-BOUND (SCAL md) p n)
  (list '= '(POLY-OP md tt p w) (go-S 'p 'w '(succ n)))))))))
(dk-peel!)
(go-hom!)
(define go5-mn (find-first (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'DEG-BOUND))) (go-conjs (dk-cite! 'deg-well-defined go-F 'p))))
(go-deg! 'p)
(dk-apply! go5-mn 'n)
(define go5-j (dk-skolem! (dk-cite! 'nn-le-gap 'n '(DEG (SCAL md) p))))
(dk-split-all!)
(define go5-st (dk-cite! 'poly-op-sum-stable go5-j 'md 'tt 'p 'w))
(go-S-typ! 'p 'w '(succ (DEG (SCAL md) p)))
(mac 'POLY-OP)
(subst (list '= 'n (list '+ '(DEG (SCAL md) p) go5-j)))
(subst go5-st)
(go-rfl-or-ass!)
(qed 'poly-op-bound)
(topic! 'poly-op-bound 'algebra)

;;; ---- p(T) is a linear map ----
(define (go-pop p w) (list 'POLY-OP 'md 'tt p w))
(define go-D '(DEG (SCAL md) p))
(define go-sD '(succ (DEG (SCAL md) p)))
(define (go-mvag!) (if (not (dk-asm? (list '== (list 'CARR go-mv) '(VEC md)))) #t))

(sp (make-wff (go-poly-stmt (list 'IN (go-pop 'p 'w) '(VEC md)))))
(dk-peel!)
(go-hom!)
(go-deg! 'p)
(go-S-typ! 'p 'w go-sD)
(mac 'POLY-OP)
(ass)
(qed 'poly-op-type)
(topic! 'poly-op-type 'algebra)

(sp (make-wff (list 'FORALL 'md (list 'FORALL 'tt (list 'IMPLIES '(IS-HOM-MODULE md md tt)
  (list 'FORALL 'p (list 'IMPLIES '(IN p (CARR (POLY (SCAL md))))
    (list '= (go-pop 'p '(VZERO md)) '(VZERO md)))))))))
(dk-peel!)
(go-hom!)
(go-deg! 'p)
(go-nn! go-sD)
(mac 'POLY-OP)
(dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT go-sD)) (list '= (list (go-ps 'p '(VZERO md)) 'gbi_) (list 'IDEN go-mv))))
  (lambda ()
    (dk-peel!)
    (let* ((i (cadr (cadr (dk-goal)))))
      (dk-cite! 'ord-segment-nn-subset go-sD i)
      (go-ps-sub! 'p '(VZERO md) i)
      (subst (dk-cite! 'op-iter-vzero i 'md 'tt))
      (dk-cite! 'poly-coef-in go-F 'p i)
      (subst (dk-cite! 'module-act-zero-vec 'md (list 'p i)))
      (subst (list '= (list 'IDEN go-mv) '(VZERO md)))
      (go-rfl-or-ass!))))
(subst (dk-cite! 'sum-ag-all-id-ind go-sD go-mv (go-ps 'p '(VZERO md))))
(subst (list '= (list 'IDEN go-mv) '(VZERO md)))
(go-rfl-or-ass!)
(qed 'poly-op-vzero)
(topic! 'poly-op-vzero 'algebra)

(sp (make-wff (list 'FORALL 'md (list 'FORALL 'tt (list 'IMPLIES '(IS-HOM-MODULE md md tt)
  (list 'FORALL 'p (list 'IMPLIES '(IN p (CARR (POLY (SCAL md))))
    (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC md)) (list 'FORALL 'y (list 'IMPLIES '(IN y (VEC md))
      (list '= (go-pop 'p (go-vadd 'x 'y)) (go-vadd (go-pop 'p 'x) (go-pop 'p 'y))))))))))))))
(dk-peel!)
(go-hom!)
(go-deg! 'p)
(dk-cite! 'module-vadd-type 'md 'x 'y)
(go-S-typ! 'p 'x go-sD) (go-S-typ! 'p 'y go-sD) (go-S-typ! 'p (go-vadd 'x 'y) go-sD)
(mac 'POLY-OP)
(dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT go-sD))
             (list '== (list (go-ps 'p (go-vadd 'x 'y)) 'gbi_) (list (list 'OPR go-mv) (list (go-ps 'p 'x) 'gbi_) (list (go-ps 'p 'y) 'gbi_)))))
  (lambda ()
    (dk-peel!)
    (let* ((i (cadr (cadr (dk-goal)))))
      (dk-cite! 'ord-segment-nn-subset go-sD i)
      (go-ps-sub! 'p (go-vadd 'x 'y) i)
      (go-ps-sub! 'p 'x i)
      (go-ps-sub! 'p 'y i)
      (subst (dk-cite! 'op-iter-add i 'md 'tt 'x 'y))
      (subst (list '= (list 'OPR go-mv) '(VADD md)))
      (go-it-type! 'x i) (go-it-type! 'y i)
      (subst (dk-cite! 'module-act-distrib-vec 'md (list 'p i) (go-it 'x i) (go-it 'y i)))
      (go-rfl-or-ass!))))
(dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT go-sD)) (list 'IN (list (go-ps 'p 'x) 'gbi_) (list 'CARR go-mv))))
  (lambda () (dk-peel!) (let ((i (cadr (cadr (dk-goal))))) (dk-cite! 'ord-segment-nn-subset go-sD i) (go-ps-sub! 'p 'x i) (subst (list '= (list 'CARR go-mv) '(VEC md))) (ass))))
(dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT go-sD)) (list 'IN (list (go-ps 'p 'y) 'gbi_) (list 'CARR go-mv))))
  (lambda () (dk-peel!) (let ((i (cadr (cadr (dk-goal))))) (dk-cite! 'ord-segment-nn-subset go-sD i) (go-ps-sub! 'p 'y i) (subst (list '= (list 'CARR go-mv) '(VEC md))) (ass))))
(subst (dk-cite! 'sum-ag-add-ind go-sD go-mv (go-ps 'p 'x) (go-ps 'p 'y) (go-ps 'p (go-vadd 'x 'y))))
(subst (list '= (list 'OPR go-mv) '(VADD md)))
(go-rfl-or-ass!)
(qed 'poly-op-add)
(topic! 'poly-op-add 'algebra)

(define (go-ptwise-typ-n! p w n)       ; PS(p, w) pointwise in CARR(MVAG) on ORD-SEGMENT(n)
  (dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT n)) (list 'IN (list (go-ps p w) 'gbi_) (list 'CARR go-mv))))
    (lambda () (dk-peel!) (let ((i (cadr (cadr (dk-goal))))) (go-nn! n) (dk-cite! 'ord-segment-nn-subset n i) (go-ps-sub! p w i) (subst (list '= (list 'CARR go-mv) '(VEC md))) (ass)))))
(define (go-ptwise-typ! p w)            ; PS(p, w) pointwise in CARR(MVAG) on ORD-SEGMENT(sD)
  (dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT go-sD)) (list 'IN (list (go-ps p w) 'gbi_) (list 'CARR go-mv))))
    (lambda () (dk-peel!) (let ((i (cadr (cadr (dk-goal))))) (dk-cite! 'ord-segment-nn-subset go-sD i) (go-ps-sub! p w i) (subst (list '= (list 'CARR go-mv) '(VEC md))) (ass)))))

(sp (make-wff (list 'FORALL 'md (list 'FORALL 'tt (list 'IMPLIES '(IS-HOM-MODULE md md tt) (list 'IMPLIES '(IS-COMMUTATIVE-RING (SCAL md))
  (list 'FORALL 'p (list 'IMPLIES '(IN p (CARR (POLY (SCAL md))))
    (list 'FORALL 'c (list 'IMPLIES '(IN c (CARR (SCAL md))) (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC md))
      (list '= (go-pop 'p (go-act 'c 'x)) (go-act 'c (go-pop 'p 'x)))))))))))))))
(dk-peel!)
(go-hom!)
(go-deg! 'p)
(dk-cite! 'module-act-type 'md 'c 'x)
(go-S-typ! 'p 'x go-sD) (go-S-typ! 'p (go-act 'c 'x) go-sD)
(mac 'POLY-OP)
(go-ptwise-typ! 'p 'x)
(dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT go-sD))
             (list '== (list (go-ps 'p (go-act 'c 'x)) 'gbi_) (list '(ACT md) 'c (list (go-ps 'p 'x) 'gbi_)))))
  (lambda ()
    (dk-peel!)
    (let* ((i (cadr (cadr (dk-goal)))) (pi_ (list 'p i)) (X (go-it 'x i)))
      (dk-cite! 'ord-segment-nn-subset go-sD i)
      (go-ps-sub! 'p (go-act 'c 'x) i)
      (go-ps-sub! 'p 'x i)
      (subst (dk-cite! 'op-iter-act i 'md 'tt 'c 'x))
      (go-it-type! 'x i)
      (dk-cite! 'module-act-mul-compat 'md pi_ 'c X)
      (dk-cite! 'module-act-mul-compat 'md 'c pi_ X)
      (subst (list '= (go-act pi_ (go-act 'c X)) (go-act (list '(MUL (SCAL md)) pi_ 'c) X)))
      (subst (list '= (go-act 'c (go-act pi_ X)) (go-act (list '(MUL (SCAL md)) 'c pi_) X)))
      (dk-have! (list '= (list '(MUL (SCAL md)) pi_ 'c) (list '(MUL (SCAL md)) 'c pi_)) (lambda () (crs)))
      (subst (list '= (list '(MUL (SCAL md)) pi_ 'c) (list '(MUL (SCAL md)) 'c pi_)))
      (go-rfl-or-ass!))))
(subst (dk-cite! 'sum-ag-act-ind go-sD 'md 'c (go-ps 'p 'x) (go-ps 'p (go-act 'c 'x))))
(go-rfl-or-ass!)
(qed 'poly-op-act)
(topic! 'poly-op-act 'algebra)

;; T passes through a finite sum
(define go-tg '(VNB-LAMBDA gti_ NN (tt (g gti_))))
(define (go-gtyp n) (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT n)) '(IN (g gbi_) (VEC md)))))
(define (go-seg-down! n)                ; from (go-gtyp (succ n)) in context, land (go-gtyp n)
  (let ((H (go-gtyp (list 'succ n))))
    (dk-have! (go-gtyp n)
      (lambda ()
        (dk-peel!)
        (let* ((i (cadr (cadr (dk-goal)))))
          (let ((iff (dk-cite! 'ord-segment-nn-succ n i)))
            (dk-have! (list 'IN i (list 'ORD-SEGMENT (list 'succ n)))
              (lambda () (dk-close-if! (lambda () (dk-only! iff (list 'IN i (list 'ORD-SEGMENT n)))) prop)))
            (dk-apply! H i)
            (ass)))))))
(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'FORALL 'md (list 'FORALL 'tt (list 'IMPLIES '(IS-HOM-MODULE md md tt)
  (list 'FORALL 'g (list 'IMPLIES (go-gtyp 'n)
    (list '= (list 'tt (list 'SUM-AG go-mv 'g 'n)) (list 'SUM-AG go-mv go-tg 'n)))))))))))
(ni)
(define go6-l (go-ind-leaves!))
(dk-focus! (car go6-l))
(dk-peel!)
(go-hom!)
(subst (dk-cite! 'sum-ag-zero go-mv 'g))
(subst (dk-cite! 'sum-ag-zero go-mv go-tg))
(subst (list '= (list 'IDEN go-mv) '(VZERO md)))
(dk-cite! 'module-vzero-in 'md)
(dk-type! '(tt (VZERO md)) '(VEC md))
(go-rfl-or-ass!)
(dk-focus! (cdr go6-l))
(define go6-ih (find-first (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'SUM-AG))) (dk-peel!)))
(go-hom!)
(go-seg-down! 'n)
(define (go6-styp! n)
  (dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT n)) (list 'IN '(g gbi_) (list 'CARR go-mv))))
    (lambda () (dk-peel!) (let ((i (cadr (cadr (dk-goal))))) (dk-apply! (go-gtyp n) i) (subst (list '= (list 'CARR go-mv) '(VEC md))) (ass))))
  (dk-cite! 'sum-ag-type-ptwise n go-mv 'g)
  (dk-rewrite-h! (list 'IN (list 'SUM-AG go-mv 'g n) (list 'CARR go-mv)) (list 'CARR go-mv) '(VEC md)))
(go6-styp! 'n)
(dk-cite! 'ord-segment-self 'n)
(let ((iff (dk-cite! 'ord-segment-nn-succ 'n 'n)))
  (dk-have! '(IN n (ORD-SEGMENT (succ n))) (lambda () (dk-close-if! (lambda () (dk-only! iff '(= n n))) (lambda () (dk-have! '(= n n) (lambda () (rfl))) (prop))))))
(dk-apply! (go-gtyp '(succ n)) 'n)
(subst (dk-cite! 'sum-ag-succ go-mv 'g 'n))
(subst (dk-cite! 'sum-ag-succ go-mv go-tg 'n))
(subst (list '= (list 'OPR go-mv) '(VADD md)))
(subst (dk-apply! go-hom-add (list 'SUM-AG go-mv 'g 'n) '(g n)))
(subst (dk-apply! go6-ih 'md 'tt 'g))
(go-tt-type! '(g n))
(dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ '(ORD-SEGMENT n)) (list 'IN (list go-tg 'gbi_) (list 'CARR go-mv))))
  (lambda () (dk-peel!) (let ((i (cadr (cadr (dk-goal)))))
                          (dk-cite! 'ord-segment-nn-subset 'n i)
                          (dk-apply! (go-gtyp 'n) i) (go-tt-type! (list 'g i))
                          (subst (list '= (list 'CARR go-mv) '(VEC md)))
                          (dk-close-if! (lambda () (dk-lam-b!)) go-rfl-or-ass!))))
(dk-cite! 'sum-ag-type-ptwise 'n go-mv go-tg)
(dk-rewrite-h! (list 'IN (list 'SUM-AG go-mv go-tg 'n) (list 'CARR go-mv)) (list 'CARR go-mv) '(VEC md))
(dk-close-if! (lambda () (dk-lam-b!)) go-rfl-or-ass!)
(qed 'hom-sum-ag)
