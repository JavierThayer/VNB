;; p(T) commutes with T, hence with every T^j
(define (go-ps-typ-vec! p w)            ; PS(p, w) pointwise in VEC on ORD-SEGMENT(sD)
  (dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT go-sD)) (list 'IN (list (go-ps p w) 'gbi_) '(VEC md))))
    (lambda () (dk-peel!) (let ((i (cadr (cadr (dk-goal))))) (dk-cite! 'ord-segment-nn-subset go-sD i) (go-ps-sub! p w i) (ass)))))
(sp (make-wff (go-poly-stmt (list '= (go-pop 'p '(tt w)) (list 'tt (go-pop 'p 'w))))))
(dk-peel!)
(go-hom!)
(go-deg! 'p)
(go-nn! go-sD)
(go-tt-type! 'w)
(mac 'POLY-OP)
(go-ps-typ-vec! 'p 'w)
(define go7-e (dk-cite! 'hom-sum-ag go-sD 'md 'tt (go-ps 'p 'w)))
(subst go7-e)
(define go7-rl (caddr (caddr go7-e)))   ; the lambda gti_ . tt(PS(gti_))
(dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES (list 'IN 'gbi_ (list 'ORD-SEGMENT go-sD)) (list '== (list (go-ps 'p '(tt w)) 'gbi_) (list go7-rl 'gbi_))))
  (lambda ()
    (dk-peel!)
    (let* ((i (cadr (cadr (dk-goal)))))
      (dk-cite! 'ord-segment-nn-subset go-sD i)
