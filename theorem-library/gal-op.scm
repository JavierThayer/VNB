  (let ((inner (list 'IF (list '< x 'nv_) (list 'av_ (list 'succ x)) '(ZERO fr))))
    (dk-cite! 'ring-one-in 'fr) (dk-cite! 'ring-zero-in 'fr)
    (mac 'MONIC-POLY)
    (dk-lam-b!)
    (cond ((eq? cls 'top) (dk-if-branch! #t (go-monv x) (lambda () (ass)) go-rfl-or-ass!))
          ((eq? cls 'low)
           (dk-have! (list 'NOT (list '= x 'nv_)) (lambda () (dk-nn!)))
           (go-int-succ! x 'nv_)
           (dk-apply! go-atyp (list 'succ x))
           (dk-if-branch! #f (go-monv x) (lambda () (ass))
             (lambda () (dk-if-branch! #t inner (lambda () (ass)) go-rfl-or-ass!))))
          (#t
           (dk-have! (list 'NOT (list '= x 'nv_)) (lambda () (dk-nn!)))
           (dk-have! (list 'NOT (list '< x 'nv_)) (lambda () (dk-nn!)))
           (dk-if-branch! #f (go-monv x) (lambda () (ass))
             (lambda () (dk-if-branch! #f inner (lambda () (ass)) go-rfl-or-ass!)))))))
(sp (make-wff (go-mon-pre (list 'IMPLIES '(= x nv_) (list '= (list go-mon 'x) '(ONE fr))))))
