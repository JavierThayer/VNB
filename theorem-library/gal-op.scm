;;; ---- Proposition 1.36 (4): the matrix of T in the basis v, T v, ..., T^(n-1) v is the companion matrix ----
(define go-atypF '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 nv_)) (IN (av_ i_) (CARR (SCAL md))))))
(define go-MONF '(MONIC-POLY (SCAL md) av_ nv_))
(define go-COMP '(COMPANION (SCAL md) av_ nv_))
(define go-KN (go-kry 'v 'nv_))
(define (go-cmp-pre body)
  (list 'FORALL 'md (list 'FORALL 'tt (list 'IMPLIES '(IS-HOM-MODULE md md tt) (list 'IMPLIES '(IS-COMMUTATIVE-RING (SCAL md))
    (list 'IMPLIES '(NOT (= (ONE (SCAL md)) (ZERO (SCAL md))))
      (list 'FORALL 'nv_ (list 'IMPLIES '(IN nv_ NN) (list 'IMPLIES '(<= 1 nv_)
        (list 'FORALL 'av_ (list 'IMPLIES go-atypF (list 'FORALL 'v (list 'IMPLIES '(IN v (VEC md)) body)))))))))))))
(define (go-ne-succ! i j)               ; (NOT (= i j)) in context, i j in NN: land (NOT (= (succ i) (succ j)))
  (dk-have! (list 'NOT (list '= (list 'succ i) (list 'succ j)))
    (lambda ()
      (di)
      (dk-cite! 'nn-succ-inj i j)
      (dk-only! (list '= i j) (list 'NOT (list '= i j)))
      (prop))))
(sp (make-wff (go-cmp-pre (list 'IMPLIES (list '= (go-pop go-MONF 'v) '(VZERO md)) (list 'IS-MATRIX-OF 'md 'nv_ go-KN 'tt go-COMP)))))
(dk-peel!)
(go-hom!)
(dk-cite! 'ring-one-in go-F) (dk-cite! 'ring-zero-in go-F)
(dk-split-all! (list (dk-cite! 'monic-poly-deg go-F 'nv_ 'av_)))
(go-open! 'IS-MONIC (list go-F go-MONF) (list 'IS-MONIC go-F go-MONF))
(define go19-top
  (let ((e (dk-cite! 'krylov-top 'md 'tt 'v go-MONF)))
    (dk-rewrite-h! e (list 'DEG go-F go-MONF) 'nv_)))
(dk-cite! 'companion-in-mat go-F 'nv_ 'av_)
(dk-cite! 'krylov-in-mat 'md 'tt 'nv_ 'v)
(define (go19-body!)
  (dk-peel!)
  (let* ((g (dk-goal)) (j (caddr (cadr (cadr g)))) (CR (go-cr go-COMP 'nv_ j)))
    (go-int! j 'nv_)
    (let ((j1 (begin (dk-cite! 'nn-pos-is-succ j) (go-skolem!))))
      (dk-cite! 'bt-succ-minus-1 j1)
      (dk-have! (list '= (list '- j 1) j1) (lambda () (subst (list '= j (list 'succ j1))) (subst (list '= (list '- (list 'succ j1) 1) j1)) (go-rfl-or-ass!)))
      (subst (dk-cite! 'krylov-entry 'md 'tt 'nv_ 'v j))
      (subst (list '= (list '- j 1) j1))
      (go-it-type! 'v j1)
      (dk-cite! 'op-iter-succ 'md 'tt 'v j1)
      (subst (list '= (list 'tt (go-it 'v j1)) (go-it 'v (list 'succ j1))))
      (subst (list '= (list 'succ j1) j))
      (dk-cite! 'col-as-row-type go-F 'nv_ '(CARR (SCAL md)) go-COMP j)
      (subst (dk-cite! 'lincomb-krylov 'md 'tt 'nv_ 'v CR))
      (go-case! (list '= j 'nv_)
        (lambda ()
          (subst (list '= j 'nv_))
          (dk-rewrite-h! (list 'IN j '(INTERVAL 1 nv_)) j 'nv_)
          (let ((CRn (go-cr go-COMP 'nv_ 'nv_)))
            (dk-cite! 'col-as-row-type go-F 'nv_ '(CARR (SCAL md)) go-COMP 'nv_)
            (subst go19-top)
            (dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES '(IN gbi_ (ORD-SEGMENT nv_)) (list '== (list (go-ns go-MONF 'v) 'gbi_) (list (go-ks CRn 'v) 'gbi_))))
              (lambda ()
                (dk-peel!)
                (let* ((i (cadr (cadr (dk-goal)))) (si (list 'succ i)))
                  (go-seg! i 'nv_)
                  (dk-apply! go-atypF si)
                  (dk-cite! 'monic-poly-low go-F 'nv_ 'av_ i)
                  (dk-cite! 'col-as-row-entry go-F 'nv_ '(CARR (SCAL md)) go-COMP 'nv_ si)
                  (dk-cite! 'companion-entry go-F 'nv_ 'av_ si 'nv_)
                  (dk-lam-b!)
                  (subst (list '= (list go-MONF i) (list 'av_ si)))
                  (subst (list '= (list 'ENTRY CRn 1 si) (list 'ENTRY go-COMP si 'nv_)))
                  (let ((cg (list 'IF '(= nv_ nv_) (list '(NEG (SCAL md)) (list 'av_ si)) (list 'IF (list '= si '(succ nv_)) '(ONE (SCAL md)) '(ZERO (SCAL md))))))
                    (subst (list '= (list 'ENTRY go-COMP si 'nv_) cg))
                    (dk-have! '(= nv_ nv_) (lambda () (rfl)))
                    (dk-if-branch! #t cg (lambda () (ass)) go-rfl-or-ass!)))))
            (subst (dk-cite! 'sum-ag-segment-congruence 'nv_ go-mv (go-ns go-MONF 'v) (go-ks CRn 'v)))
            (dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES '(IN gbi_ (ORD-SEGMENT nv_)) (list 'IN (list (go-ks CRn 'v) 'gbi_) (list 'CARR go-mv))))
              (lambda () (dk-peel!) (let* ((i (cadr (cadr (dk-goal)))) (val (go-ks-at! CRn 'v 'nv_ i)))
                                      (subst (list '= (list (go-ks CRn 'v) i) val)) (subst (list '= (list 'CARR go-mv) '(VEC md))) (ass))))
            (dk-cite! 'sum-ag-type-ptwise 'nv_ go-mv (go-ks CRn 'v))
            (dk-rewrite-h! (list 'IN (list 'SUM-AG go-mv (go-ks CRn 'v) 'nv_) (list 'CARR go-mv)) (list 'CARR go-mv) '(VEC md))
            (go-rfl-or-ass!)))
        (lambda ()
          (dk-cite! 'ladet-nn-lt-of-le-ne j 'nv_)
          (let* ((iff (dk-cite! 'seg-mem-lt 'nv_ j)))
            (dk-have! (list 'IN j '(ORD-SEGMENT nv_)) (lambda () (dk-close-if! (lambda () (dk-only! iff (list '< j 'nv_))) prop))))
          (let ((kj (go-ks-at! CR 'v 'nv_ j)) (sj (list 'succ j)))
            (dk-cite! 'mvag-carr 'md)
            (dk-have! (list 'IN (list (go-ks CR 'v) j) (list 'CARR go-mv)) (lambda () (subst (list '= (list 'CARR go-mv) '(VEC md))) (subst (list '= (list (go-ks CR 'v) j) kj)) (ass)))
            (dk-have! (list 'FORALL 'gbi_ (list 'IMPLIES '(IN gbi_ (ORD-SEGMENT nv_)) (list 'IMPLIES (list 'NOT (list '= 'gbi_ j)) (list '= (list (go-ks CR 'v) 'gbi_) (list 'IDEN go-mv)))))
              (lambda ()
                (dk-peel!)
                (let* ((i (cadr (cadr (dk-goal)))) (si (list 'succ i)) (ki (go-ks-at! CR 'v 'nv_ i)))
                  (subst (list '= (list (go-ks CR 'v) i) ki))
                  (dk-cite! 'col-as-row-entry go-F 'nv_ '(CARR (SCAL md)) go-COMP j si)
                  (dk-cite! 'companion-entry go-F 'nv_ 'av_ si j)
                  (subst (list '= (list 'ENTRY CR 1 si) (list 'ENTRY go-COMP si j)))
                  (let ((cg (list 'IF (list '= j 'nv_) (list '(NEG (SCAL md)) (list 'av_ si)) (list 'IF (list '= si sj) '(ONE (SCAL md)) '(ZERO (SCAL md))))))
                    (subst (list '= (list 'ENTRY go-COMP si j) cg))
                    (go-ne-succ! i j)
                    (dk-if-branch! #f cg (lambda () (ass))
                      (lambda () (dk-if-branch! #f (list 'IF (list '= si sj) '(ONE (SCAL md)) '(ZERO (SCAL md))) (lambda () (ass)) (lambda () #t)))))
                  (subst (dk-cite! 'module-zero-act 'md (go-it 'v i)))
                  (subst (list '= (list 'IDEN go-mv) '(VZERO md)))
                  (go-rfl-or-ass!))))
            (subst (dk-cite! 'sum-ag-single-ind 'nv_ go-mv (go-ks CR 'v) j))
            (subst (list '= (list (go-ks CR 'v) j) kj))
            (dk-cite! 'col-as-row-entry go-F 'nv_ '(CARR (SCAL md)) go-COMP j sj)
            (dk-cite! 'companion-entry go-F 'nv_ 'av_ sj j)
            (subst (list '= (list 'ENTRY CR 1 sj) (list 'ENTRY go-COMP sj j)))
            (let ((cg (list 'IF (list '= j 'nv_) (list '(NEG (SCAL md)) (list 'av_ sj)) (list 'IF (list '= sj sj) '(ONE (SCAL md)) '(ZERO (SCAL md))))))
              (subst (list '= (list 'ENTRY go-COMP sj j) cg))
              (dk-have! (list '= sj sj) (lambda () (rfl)))
              (dk-if-branch! #f cg (lambda () (ass))
                (lambda () (dk-if-branch! #t (list 'IF (list '= sj sj) '(ONE (SCAL md)) '(ZERO (SCAL md))) (lambda () (ass)) (lambda () #t)))))
            (go-it-type! 'v j)
            (subst (dk-cite! 'module-act-unital 'md (go-it 'v j)))
            (go-rfl-or-ass!)))))))
(go-close! 'IS-MATRIX-OF (list 'md 'nv_ go-KN 'tt go-COMP)
  (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (go19-body!))))))
