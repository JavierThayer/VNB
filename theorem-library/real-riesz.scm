;;; real-riesz.scm -- WAVE 2 (2026-10-27..30), wired 2026-10-30 from scratchpad/md/me-rz.scm.
;;; Library: analysis.

;;; me-rz.scm -- THE RIESZ REPRESENTATION THEOREM for a REAL Hilbert space (the tree has the complex one,
;;; hilbert-projection.scm).  Agent M-D (M-E targets), worker-02, 2026-10-28.
;;; DESTINATION: theorem-library/real-riesz.scm.  Library: analysis.  Helper prefix: mrz-.
;;; Load window: after sip-d1.scm (real-projection-point, the real Hilbert vocabulary).
;;; Route: the kernel K = f^{-1}{0} is a closed subspace (continuity); if f /= 0 take x0 with f(x0) /= 0,
;;; its projection residual z = x0 - P(x0) is orthogonal to K with f(z) = f(x0) /= 0, and
;;; e = (f(z) / <z,z>) z represents f, since x - (f(x)/f(z)) z lies in K.

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define (mrz-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; MRZ OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define (mrz-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (mrz-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define (mrz-mark! . xs)
  (let ((port (open-output-file "/tmp/mrz-trace.txt" #t)))
    (for-each (lambda (x) (write-string (cond ((string? x) x) ((boolean? x) (if x "#t" "#f")) (#t (expression->string x))) port) (write-string " " port)) xs)
    (newline port) (close-port port)))
(define (mrz-split! c)
  (if (and (pair? c) (eq? (car c) 'AND) (dk-asm? (cadr c)) (dk-asm? (caddr c))) c (dk-split! c)))
(define (mrz-pos-of fs) (find-first (lambda (h) (dk-head-is? h 'POS-RR)) fs))
;;; ---- the expansion kit of sip-d1.scm (sipd-), copied -------------------------------------
(define (mrz-pin!) (if (not (dk-asm? '(= (SCAL v) (NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))))
                       (fact 'sip-scal-pin 'v)))
(define (mrz-op? e op) (and (pair? e) (equal? (car e) (list op 'v))))
(define (mrz-sub a b) (list '(VADD v) a (list '(VNEG v) b)))
(define (mrz-act c a) (list '(ACT v) c a))
(define (mrz-ip a b) (list '(RIP v) a b))
(define (mrz-q a) (mrz-ip a a))
(define (mrz-vt x)
  (let ((want (list 'IN x '(VEC v))))
    (cond ((mrz-op? x 'VADD) (mrz-vt (cadr x)) (mrz-vt (caddr x)))
          ((mrz-op? x 'VNEG) (mrz-vt (cadr x)))
          ((mrz-op? x 'ACT) (mrz-pin!) (mrz-vt (caddr x)) (dk-real! (cadr x))))
    (cond ((dk-asm? want) x)
          ((equal? x '(VZERO v)) (dk-cite! 'module-vzero-in-sip-as-module 'v) x)
          ((mrz-op? x 'VADD) (dk-cite! 'module-vadd-type-sip-as-module 'v (cadr x) (caddr x)) x)
          ((mrz-op? x 'VNEG) (dk-cite! 'module-vneg-type-sip-as-module 'v (cadr x)) x)
          ((mrz-op? x 'ACT) (dk-cite! 'hbs-act-in-sip-as-module 'v (cadr x) (caddr x)) x)
          (#t (error "mrz-vt: cannot type" (expression->string x))))))
(define (mrz-ft x y) (mrz-vt x) (mrz-vt y) (dk-cite! 'sip-rip-type 'v x y))
(define (mrz-compound? e) (or (mrz-op? e 'VADD) (mrz-op? e 'VNEG) (mrz-op? e 'ACT) (equal? e '(VZERO v))))
(define (mrz-find-redex e)
  (cond ((not (pair? e)) #f)
        ((and (mrz-op? e 'RIP) (= (length e) 3) (or (mrz-compound? (cadr e)) (mrz-compound? (caddr e)))) e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((mrz-find-redex (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
(define (mrz-open-law! r)
  (let ((a (cadr r)) (b (caddr r)))
    (mrz-vt a) (mrz-vt b)
    (cond ((mrz-op? a 'VADD) (dk-cite! 'sip-rip-add-left 'v (cadr a) (caddr a) b))
          ((mrz-op? a 'VNEG) (dk-cite! 'sip-rip-neg-left 'v (cadr a) b))
          ((mrz-op? a 'ACT)  (dk-real! (cadr a)) (dk-cite! 'sip-rip-homog-left 'v (cadr a) (caddr a) b))
          ((equal? a '(VZERO v)) (dk-cite! 'sip-rip-zero-left 'v b))
          ((mrz-op? b 'VADD) (dk-cite! 'sip-rip-add-right 'v a (cadr b) (caddr b)))
          ((mrz-op? b 'VNEG) (dk-cite! 'sip-rip-neg-right 'v a (cadr b)))
          ((mrz-op? b 'ACT)  (dk-real! (cadr b)) (dk-cite! 'sip-rip-homog-right 'v (cadr b) a (caddr b)))
          ((equal? b '(VZERO v)) (dk-cite! 'sip-rip-zero-right 'v a))
          (#t (error "mrz-open-law!: not a redex" (expression->string r))))))
(define (mrz-atoms e)
  (cond ((not (pair? e)) '())
        ((and (mrz-op? e 'RIP) (= (length e) 3)) (list e))
        (#t (append-map mrz-atoms (if (list? e) e '())))))
(define (mrz-symmetrize!)
  (let loop ((done '()))
    (let* ((ats (mrz-atoms (dk-goal)))
           (hit (find-first (lambda (t)
                              (let ((rev (mrz-ip (caddr t) (cadr t))))
                                (and (not (equal? (cadr t) (caddr t))) (member rev ats) (not (member rev done)))))
                            ats)))
      (if hit
          (let ((rev (mrz-ip (caddr hit) (cadr hit))))
            (mrz-ft (cadr hit) (caddr hit))
            (dk-cite! 'sip-rip-sym 'v (cadr hit) (caddr hit))
            (subst (list '= rev hit))
            (loop (cons hit done))))))
  (for-each (lambda (t) (mrz-ft (cadr t) (caddr t))) (mrz-atoms (dk-goal))))
(define (mrz-expand!)
  (let loop ((fuel 200))
    (if (<= fuel 0) (error "mrz-expand!: out of fuel"))
    (let ((r (mrz-find-redex (dk-goal))))
      (if r (begin (subst (mrz-open-law! r)) (loop (- fuel 1))) (mrz-symmetrize!)))))
(define (mrz-ip-eq! goal)
  (if (not (dk-asm? goal))
      (dk-have! goal (lambda () (mrz-expand!) (if (mrz-open?) (crs)))))
  goal)
(define (mrz-vec-eq! a b)
  (let ((goal (list '= a b)))
    (if (not (dk-asm? goal))
        (let ((d (mrz-sub a b)))
          (mrz-vt a) (mrz-vt b) (mrz-vt d)
          (mrz-ip-eq! (list '= (mrz-q d) 0))
          (dk-cite! 'phs-definite 'v d)
          (dk-cite! 'frm-v-sub-zero-eq-sip-as-module 'v a b)))
    goal))
(define (mrz-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))
(define (mrz-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))

;;; ===========================================================================
;;; THE THEOREM
;;; ===========================================================================
(define mrz-add '(FORALL x_ (IMPLIES (IN x_ (VEC v)) (FORALL y_ (IMPLIES (IN y_ (VEC v)) (= (f ((VADD v) x_ y_)) (+ (f x_) (f y_))))))))
(define mrz-hom '(FORALL r_ (IMPLIES (IN r_ RR) (FORALL x_ (IMPLIES (IN x_ (VEC v)) (= (f ((ACT v) r_ x_)) (* r_ (f x_))))))))
(define mrz-M '(SIP-METRIC-SPACE v))
(define mrz-CB '(CLOSED-BALL RR-MS 0 0))
(define mrz-K (list 'PREIMAGE mrz-M 'f mrz-CB))
(sp (make-wff (list 'FORALL 'v (list 'FORALL 'f
  (list 'IMPLIES '(IS-REAL-HILBERT-SPACE v) (list 'IMPLIES '(IN f (FUN (VEC v) RR)) (list 'IMPLIES mrz-add (list 'IMPLIES mrz-hom
    (list 'IMPLIES (list 'IS-CONTINUOUS mrz-M 'RR-MS 'f)
      '(FORSOME rze_ (AND (IN rze_ (VEC v)) (FORALL rzx_ (IMPLIES (IN rzx_ (VEC v)) (= (f rzx_) ((RIP v) rzx_ rze_)))))))))))))))
(dk-peel!)
(dk-cite! 'real-hilbert-space-is-phs 'v)
(fact 'phs-is-sip 'v)
(mrz-pin!)
(fact 'rr-zero-in)
(dk-cite! 'sip-metric-space-pts 'v)
(dk-cite! 'sip-metric-space-is-metric-space 'v)
(dk-cite! 'sip-scal-carr 'v)
(fact 'rr-is-metric-space)
(dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl)))
(define (mrz-fx! x) (mrz-vt x) (dk-cite! 'fun-apply-type-c 'f '(VEC v) 'RR x) (list 'f x))
(define (mrz-fadd! x y) (mrz-fx! x) (mrz-fx! y) (dk-apply! (dk-ctx-form mrz-add) x y))
(define (mrz-fhom! r x) (dk-real! r) (mrz-fx! x) (dk-apply! (dk-ctx-form mrz-hom) r x))
;; f(0) = 0, f(-x) = -f(x)
(define mrz-0 '(VZERO v))
(mrz-vt mrz-0)
(mrz-vec-eq! (mrz-act 0 mrz-0) mrz-0)
(mrz-fhom! 0 mrz-0)
(dk-have! (list '= (list 'f mrz-0) 0)
  (lambda () (dk-rewrite-h! (dk-ctx-form (list '= (list 'f (mrz-act 0 mrz-0)) (list '* 0 (list 'f mrz-0)))) (mrz-act 0 mrz-0) mrz-0)
             (dk-ineq! (list 'IN (list 'f mrz-0) 'RR) (list '= (list 'f mrz-0) (list '* 0 (list 'f mrz-0))))))
(define (mrz-fneg! x)                  ; (= (f (VNEG x)) (- (f x)))
  (let ((e (list '= (list 'f (list '(VNEG v) x)) (list '- (list 'f x)))))
    (if (not (dk-asm? e))
        (begin
          (dk-have! '(IN -1 RR) (lambda () (arith)))
          (mrz-vec-eq! (list '(VNEG v) x) (mrz-act -1 x))
          (mrz-fhom! -1 x)
          (mrz-fx! (list '(VNEG v) x))
          (dk-have! e (lambda () (subst (list '= (list '(VNEG v) x) (mrz-act -1 x))) (subst (list '= (list 'f (mrz-act -1 x)) (list '* -1 (list 'f x)))) (crs)))))
    e))
;; the kernel
(define (mrz-kin! x)                   ; x in VEC, (= (f x) 0) in context: (IN x K)
  (let ((m (list 'IN x mrz-K)))
    (if (not (dk-asm? m))
        (begin
          (mrz-fx! x)
          (dk-have! (list 'IN x (list 'PTS mrz-M)) (lambda () (subst (list '== (list 'PTS mrz-M) '(VEC v))) (dk-ass!)))
          (dk-have! (list 'IN (list 'f x) '(PTS RR-MS)) (lambda () (subst '(== (PTS RR-MS) RR)) (dk-ass!)))
          (dk-have! '(IN 0 (PTS RR-MS)) (lambda () (subst '(== (PTS RR-MS) RR)) (dk-ass!)))
          (dk-have! (list '<= (list '(DIST RR-MS) 0 (list 'f x)) 0)
            (lambda () (subst (dk-cite! 'rr-ms-dist 0 (list 'f x)))
                       (subst (list '= (list 'f x) 0))
                       (dk-have! '(= (- 0 0) 0) (lambda () (arith)))
                       (subst '(= (- 0 0) 0))
                       (dk-cite! 'rr-abs-zero-value)
                       (subst '(= (abs 0) 0))
                       (dk-ineq!)))
          (mrz-iff-bwd! 'closed-ball-membership 'RR-MS 0 0 (list 'f x))
          (mrz-iff-bwd! 'preimage-membership mrz-M 'f mrz-CB x)))
    m))
(define (mrz-kout! x)                  ; (IN x K) in context: (IN x VEC), (= (f x) 0)
  (let ((e (list '= (list 'f x) 0)))
    (if (not (dk-asm? e))
        (begin
          (dk-have! (list 'AND (list 'IN x (list 'PTS mrz-M)) (list 'IN (list 'f x) mrz-CB))
            (lambda () (let* ((lf (proof-state-focus *ps*)) (iff (dk-cite! 'preimage-membership mrz-M 'f mrz-CB x))) (if (and (dk-only! iff (list 'IN x mrz-K)) (not (sequent-node-grounded? lf))) (prop)))))
          (dk-split-all! (list (list 'AND (list 'IN x (list 'PTS mrz-M)) (list 'IN (list 'f x) mrz-CB))))
          (dk-rewrite-h! (list 'IN x (list 'PTS mrz-M)) (list 'PTS mrz-M) '(VEC v))
          (mrz-fx! x)
          (dk-have! (list 'AND (list 'IN (list 'f x) '(PTS RR-MS)) (list '<= (list '(DIST RR-MS) 0 (list 'f x)) 0))
            (lambda () (let* ((lf (proof-state-focus *ps*)) (iff (dk-cite! 'closed-ball-membership 'RR-MS 0 0 (list 'f x)))) (if (and (dk-only! iff (list 'IN (list 'f x) mrz-CB)) (not (sequent-node-grounded? lf))) (prop)))))
          (dk-split-all! (list (list 'AND (list 'IN (list 'f x) '(PTS RR-MS)) (list '<= (list '(DIST RR-MS) 0 (list 'f x)) 0))))
          (let* ((dd (dk-cite! 'rr-ms-dist 0 (list 'f x))) (d (list '- 0 (list 'f x))))
            (dk-rewrite-h! (dk-ctx-form (list '<= (list '(DIST RR-MS) 0 (list 'f x)) 0)) (list '(DIST RR-MS) 0 (list 'f x)) (list 'abs d))
            (dk-type! d)
            (dk-split-all! (list (dk-cite! 'rr-abs-le-parts d 0)))
            (dk-have! e (lambda () (dk-ineq! (list 'IN (list 'f x) 'RR) (list '<= (list '- 0) d) (list '<= d 0)))))))
    e))
;; K is a closed subspace
(dk-have! (list 'IS-CLOSED mrz-M mrz-K)
  (lambda ()
    (dk-have! '(IN 0 (PTS RR-MS)) (lambda () (subst '(== (PTS RR-MS) RR)) (dk-ass!)))
    (dk-cite! 'closed-ball-is-closed 'RR-MS 0 0)
    (let ((all (dk-cite! 'continuous-implies-closed-preimage mrz-M 'RR-MS 'f)))
      (dk-apply! all mrz-CB)
      (dk-ass!))))
(dk-have! (list 'IS-SUBMODULE 'v mrz-K)
  (lambda ()
    (mac 'IS-SUBMODULE)
    (mrz-kin! mrz-0)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let ((g (dk-goal)))
              (cond
                ((dk-head-is? g 'SUBSET)
                 (mac 'subset-def)
                 (let ((x (dk-di-var!))) (mrz-kout! x) (dk-ass!)))
                (#t
                 (let* ((ld (dk-peel!))
                        (ks (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) mrz-K))) ld)))
                        (rs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (memq (caddr h) '(RR)))) ld))))
                   (for-each (lambda (h) (if (and (dk-head-is? h 'IN) (equal? (caddr h) '(CARR (SCAL v))))
                                             (dk-rewrite-h! h '(CARR (SCAL v)) 'RR)))
                             ld)
                   (for-each mrz-kout! ks)
                   (let ((tgt (cadr (dk-goal))))
                     (cond ((mrz-op? tgt 'VADD) (mrz-fadd! (cadr tgt) (caddr tgt)))
                           ((mrz-op? tgt 'VNEG) (mrz-fneg! (cadr tgt)))
                           ((mrz-op? tgt 'ACT) (mrz-fhom! (cadr tgt) (caddr tgt))))
                     (mrz-fx! tgt)
                     (dk-have! (list '= (list 'f tgt) 0)
                       (lambda ()
                         (cond ((mrz-op? tgt 'VADD) (subst (list '= (list 'f tgt) (list '+ (list 'f (cadr tgt)) (list 'f (caddr tgt))))))
                               ((mrz-op? tgt 'VNEG) (subst (list '= (list 'f tgt) (list '- (list 'f (cadr tgt))))))
                               ((mrz-op? tgt 'ACT) (subst (list '= (list 'f tgt) (list '* (cadr tgt) (list 'f (caddr tgt)))))))
                         (for-each (lambda (k) (subst (list '= (list 'f k) 0))) ks)
                         (if (mrz-open?) (crs))))
                     (mrz-kin! tgt)
                     (dk-ass!)))))))))))
;; the representation
(define mrz-all0 '(FORALL rzx_ (IMPLIES (IN rzx_ (VEC v)) (= (f rzx_) 0))))
(use-em mrz-all0
  (lambda ()
    (ew mrz-0)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (let* ((x (dk-di-var!)))
              (dk-apply! (dk-ctx-form mrz-all0) x)
              (mrz-vt x)
              (dk-cite! 'sip-rip-zero-right 'v x)
              (subst (list '= (list 'f x) 0))
              (subst (list '= (mrz-ip x mrz-0) 0))
              (if (mrz-open?) (arith)))))))
  (lambda ()
    (let* ((ex '(FORSOME rzo_ (AND (IN rzo_ (VEC v)) (NOT (= (f rzo_) 0))))))
      (dk-have! ex
        (lambda ()
          (pbc)
          (dk-have! mrz-all0
            (lambda ()
              (let ((x (dk-di-var!)))
                (pbc)
                (dk-have! ex (lambda () (ew x) (dk-conj-close! (lambda () (dk-ass!)))))
                (ai (list 'NOT ex)))))
          (ai (list 'NOT mrz-all0))))
      (let* ((x0 (dk-skolem! ex #t))
             (pp (dk-cite! 'real-projection-point 'v mrz-K x0))
             (a (dk-skolem! pp #t))
             (z (mrz-sub x0 a))
             (fz (list 'f z)) (fx0 (list 'f x0)) (q (mrz-q z)))
        (mrz-kout! a)
        (mrz-fadd! x0 (list '(VNEG v) a))
        (mrz-fneg! a)
        (mrz-fx! z)
        (dk-have! (list '= fz fx0)
          (lambda () (subst (list '= fz (list '+ fx0 (list 'f (list '(VNEG v) a)))))
                     (subst (list '= (list 'f (list '(VNEG v) a)) (list '- (list 'f a))))
                     (subst (list '= (list 'f a) 0))
                     (if (mrz-open?) (crs))))
        (dk-have! (list 'NOT (list '= fz 0))
          (lambda () (di) (dk-have! (list '= fx0 0) (lambda () (subst (list '= fx0 fz)) (dk-ass!))) (ai (list 'NOT (list '= fx0 0)))))
        (mrz-ft z z)
        (dk-cite! 'sip-rip-self-nonneg 'v z)
        (dk-have! (list 'NOT (list '= q 0))
          (lambda ()
            (di)
            (dk-cite! 'phs-definite 'v z)
            (dk-have! (list '= fz 0) (lambda () (subst (list '= z mrz-0)) (dk-ass!)))
            (ai (list 'NOT (list '= fz 0)))))
        (mrz-and! (list 'IN q 'RR) (list 'NOT (list '= q 0)))
        (mrz-and! (list 'IN fz 'RR) (list 'NOT (list '= fz 0)))
        (dk-cite! 'rr-recip-closed q) (dk-cite! 'rr-recip-inverse q)
        (dk-cite! 'rr-recip-closed fz) (dk-cite! 'rr-recip-inverse fz)
        (let* ((rq (list 'recip q)) (rf (list 'recip fz)) (kt (list '* fz rq)))
          (dk-type! kt)
          (let* ((k (dk-name! kt)) (e (mrz-act k z)))
            (mrz-vt e)
            (ew e)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (let* ((x (dk-di-var!)) (fx (mrz-fx! x)) (ct (list '* fx rf)))
                      (dk-type! ct)
                      (let* ((c (dk-name! ct)) (cz (mrz-act c z)) (w (mrz-sub x cz)))
                        (mrz-vt w)
                        (mrz-fadd! x (list '(VNEG v) cz))
                        (mrz-fneg! cz)
                        (mrz-fhom! c z)
                        (dk-have! (list '= (list '* (list '* fx rf) fz) (list '* fx (list '* fz rf))) (lambda () (dk-crs-opaque!)))
                        (dk-have! (list '= (list 'f w) 0)
                          (lambda () (subst (list '= (list 'f w) (list '+ fx (list 'f (list '(VNEG v) cz)))))
                                     (subst (list '= (list 'f (list '(VNEG v) cz)) (list '- (list 'f cz))))
                                     (subst (list '= (list 'f cz) (list '* c fz)))
                                     (subst (list '= c ct))
                                     (subst (list '= (list '* (list '* fx rf) fz) (list '* fx (list '* fz rf))))
                                     (subst (list '= (list '* fz rf) 1))
                                     (if (mrz-open?) (crs))))
                        (mrz-kin! w)
                        (dk-cite! 'sip-perp-orth 'v mrz-K z w)
                        (mrz-ip-eq! (list '= (mrz-ip z w) (list '- (mrz-ip z x) (list '* c q))))
                        (mrz-ip-eq! (list '= (mrz-ip x e) (list '* k (mrz-ip z x))))
                        (mrz-ft z x)
                        (dk-have! (list '= (mrz-ip z x) (list '* c q))
                          (lambda () (dk-type! (list '* c q))
                                     (mrz-ft z w)
                                     (dk-ineq! (list 'IN (mrz-ip z x) 'RR) (list 'IN (list '* c q) 'RR) (list 'IN (mrz-ip z w) 'RR)
                                               (list '= (mrz-ip z w) (list '- (mrz-ip z x) (list '* c q))) (list '= (mrz-ip z w) 0))))
                        (dk-have! (list '= (list '* (list '* fz rq) (list '* (list '* fx rf) q)) (list '* fx (list '* (list '* fz rf) (list '* q rq))))
                          (lambda () (dk-crs-opaque!)))
                        (subst (list '= (mrz-ip x e) (list '* k (mrz-ip z x))))
                        (subst (list '= (mrz-ip z x) (list '* c q)))
                        (subst (list '= k kt))
                        (subst (list '= c ct))
                        (subst (list '= (list '* (list '* fz rq) (list '* (list '* fx rf) q)) (list '* fx (list '* (list '* fz rf) (list '* q rq)))))
                        (subst (list '= (list '* fz rf) 1))
                        (subst (list '= (list '* q rq) 1))
                        (if (mrz-open?) (crs)))))))))))))
(mrz-qed! 'real-riesz-representation)

;;; ===========================================================================
;;; RIESZ ON A SEMI-INNER-PRODUCT SPACE complete for its seminorm (through the quotient):
;;; a linear f with |f(x)| <= C ||x|| is <., e> for some vector e.
;;; ===========================================================================
(define (mrs-d a b) (list '(VADD v) a (list '(VNEG v) b)))
(define (mrs-nv a b) (list 'SQRT (list '(RIP v) (mrs-d a b) (mrs-d a b))))
(define mrs-sc
  (list 'FORALL 's (list 'IMPLIES '(IN s (FUN NN (VEC v)))
    (list 'IMPLIES
      (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'nb (list 'AND '(IN nb NN)
        (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'q (list 'IMPLIES '(IN q NN)
          (list 'IMPLIES '(<= nb m) (list 'IMPLIES '(<= nb q) (list '<= (mrs-nv '(s m) '(s q)) 'eps)))))))))))
      (list 'FORSOME 'a (list 'AND '(IN a (VEC v))
        (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list 'FORSOME 'nb (list 'AND '(IN nb NN)
          (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN) (list 'IMPLIES '(<= nb n_) (list '<= (mrs-nv '(s n_) 'a) 'eps))))))))))))))
(define mrs-bound '(FORALL x_ (IMPLIES (IN x_ (VEC v)) (<= (abs (f x_)) (* cb (SQRT ((RIP v) x_ x_)))))))
(define mrs-Q '(SIP-QUOTIENT v))
(define mrs-S '(SIP-SETOID v))
(define (mrs-cl a) (list 'CLASS mrs-S a))
(define mrs-F (list 'DESCEND mrs-S 'f))
(define mrs-QM '(SIP-METRIC-SPACE (SIP-QUOTIENT v)))
(define (mrs-dist! a b)                ; a, b in VEC v: (= (DIST QM (CLASS a) (CLASS b)) nv(a,b))
  (let* ((ca (mrs-cl a)) (cb_ (mrs-cl b)) (nb (list '(VNEG v) b)) (d (mrs-d a b))
         (e (list '= (list (list 'DIST mrs-QM) ca cb_) (mrs-nv a b))))
    (if (not (dk-asm? e))
        (begin
          (mrz-vt d)
          (for-each (lambda (t) (if (not (dk-asm? (list 'IN (mrs-cl t) (list 'VEC mrs-Q))))
                                    (begin (mrz-vt t)
                                           (if (not (dk-asm? (list 'IN t (list 'PTS mrs-S))))
                                               (dk-have! (list 'IN t (list 'PTS mrs-S)) (lambda () (subst (list '== (list 'PTS mrs-S) '(VEC v))) (dk-ass!))))
                                           (dk-cite! 'class-in-quotient mrs-S t)
                                           (dk-have! (list 'IN (mrs-cl t) (list 'VEC mrs-Q)) (lambda () (subst (list '== (list 'VEC mrs-Q) (list 'QUOTIENT mrs-S))) (dk-ass!))))))
                    (list a b d))
          (dk-cite! 'sip-metric-space-dist mrs-Q ca cb_)
          (dk-cite! 'sipq-vneg-computes 'v b)
          (dk-cite! 'sipq-vadd-computes 'v a nb)
          (dk-cite! 'sipq-rip-computes 'v d d)
          (dk-cite! 'sip-rip-type 'v d d) (dk-cite! 'sip-rip-self-nonneg 'v d)
          (mrz-and! (list 'IN (list '(RIP v) d d) 'RR) (list '<= 0 (list '(RIP v) d d)))
          (mrz-split! (dk-cite! 'sqrt-nonneg (list '(RIP v) d d)))
          (dk-have! e
            (lambda ()
              (subst (list '= (list (list 'DIST mrs-QM) ca cb_)
                           (list 'SQRT (list (list 'RIP mrs-Q) (list (list 'VADD mrs-Q) ca (list (list 'VNEG mrs-Q) cb_))
                                                               (list (list 'VADD mrs-Q) ca (list (list 'VNEG mrs-Q) cb_))))))
              (subst (list '= (list (list 'VNEG mrs-Q) cb_) (mrs-cl nb)))
              (subst (list '= (list (list 'VADD mrs-Q) ca (mrs-cl nb)) (mrs-cl d)))
              (subst (list '= (list (list 'RIP mrs-Q) (mrs-cl d) (mrs-cl d)) (list '(RIP v) d d)))
              (if (mrz-open?) (rfl))))))
    e))
(define (mrs-continuity!)
  (dk-cite! 'sip-metric-space-is-metric-space mrs-Q)
  (dk-cite! 'sip-metric-space-pts mrs-Q)
  (dk-have! (list 'IN mrs-F (list 'FUN (list 'PTS mrs-QM) '(PTS RR-MS)))
    (lambda () (subst (list '== (list 'PTS mrs-QM) (list 'VEC mrs-Q))) (subst '(== (PTS RR-MS) RR)) (dk-ass!)))
  (dk-have! (list 'IS-CONTINUOUS mrs-QM 'RR-MS mrs-F)
    (lambda ()
      (mac 'IS-CONTINUOUS)
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((ld (dk-peel!)) (xcl (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) ld))))
                (dk-rewrite-h! (list 'IN xcl (list 'PTS mrs-QM)) (list 'PTS mrs-QM) (list 'VEC mrs-Q))
                (mac 'IS-CONTINUOUS-AT)
                (dk-conj-close!
                  (lambda ()
                    (if (not (dk-ass!))
                        (let* ((ld2 (dk-peel!)) (eps (cadr (mrz-pos-of (append ld2 (dk-asms)))))
                               (k1 '(+ cb 1)))
                          (dk-cite! 'rr-pos-rr-in-rr eps) (dk-cite! 'rr-lt-of-pos-rr eps)
                          (dk-type! k1)
                          (dk-have! (list '< 0 k1) (lambda () (dk-ineq! '(IN cb RR) '(<= 0 cb))))
                          (dk-have! (list 'NOT (list '= k1 0)) (lambda () (di) (dk-absurd! '(IN cb RR) (list '= k1 0) '(<= 0 cb))))
                          (mrz-and! (list 'IN k1 'RR) (list 'NOT (list '= k1 0)))
                          (dk-cite! 'rr-recip-closed k1) (dk-cite! 'rr-recip-inverse k1) (dk-cite! 'rr-recip-pos k1)
                          (let* ((rn (dk-name! (list 'recip k1))))
                            (dk-rewrite-h! (dk-ctx-form (list '= (list '* k1 (list 'recip k1)) 1)) (list 'recip k1) rn)
                            (dk-have! (list '< 0 rn) (lambda () (subst (list '= rn (list 'recip k1))) (dk-ass!)))
                            (dk-cite! 'rr-mul-pos eps rn)
                            (dk-type! (list '* eps rn))
                            (let* ((dn (dk-name! (list '* eps rn))))
                              (dk-have! (list '< 0 dn) (lambda () (subst (list '= dn (list '* eps rn))) (dk-ass!)))
                              (dk-project! (list 'AND (list '<= 0 dn) (list 'NOT (list '= 0 dn))) (lambda () (mac-h '< (dk-ctx-form (list '< 0 dn)))))
                              (dk-split-all! (list (list 'AND (list '<= 0 dn) (list 'NOT (list '= 0 dn)))))
                              (dk-have! (list 'POS-RR dn) (lambda () (mac 'pos-rr) (dk-conj-close! (lambda () (dk-ass!)))))
                              (dk-have! (list '= (list '* dn 'cb) (list '- eps dn))
                                (lambda ()
                                  (subst (list '= dn (list '* eps rn)))
                                  (dk-have! (list '= (list '* (list '* eps rn) 'cb) (list '- (list '* eps (list '* k1 rn)) (list '* eps rn))) (lambda () (crs)))
                                  (subst (list '= (list '* (list '* eps rn) 'cb) (list '- (list '* eps (list '* k1 rn)) (list '* eps rn))))
                                  (subst (list '= (list '* k1 rn) 1))
                                  (if (mrz-open?) (crs))))
                              (ew dn)
                              (dk-conj-close!
                                (lambda ()
                                  (if (not (dk-ass!))
                                      (let* ((ld3 (dk-peel!))
                                             (ycl (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (list 'PTS mrs-QM)))) ld3))))
                                        (dk-rewrite-h! (list 'IN ycl (list 'PTS mrs-QM)) (list 'PTS mrs-QM) (list 'VEC mrs-Q))
                                        (let* ((a (mrs-rep! xcl)) (b (mrs-rep! ycl)))
                                          (mrs-Fcl! a) (mrs-Fcl! b)
                                          (mrs-dist! a b)
                                          (dk-rewrite-h! (dk-ctx-form (list '<= (list (list 'DIST mrs-QM) xcl ycl) dn)) xcl (mrs-cl a))
                                          (dk-rewrite-h! (dk-ctx-form (list '<= (list (list 'DIST mrs-QM) (mrs-cl a) ycl) dn)) ycl (mrs-cl b))
                                          (dk-rewrite-h! (dk-ctx-form (list '<= (list (list 'DIST mrs-QM) (mrs-cl a) (mrs-cl b)) dn))
                                                         (list (list 'DIST mrs-QM) (mrs-cl a) (mrs-cl b)) (mrs-nv a b))
                                          (let* ((n (mrs-fdiff! a b)) (fa (list 'f a)) (fb (list 'f b)))
                                            (subst (list '= xcl (mrs-cl a))) (subst (list '= ycl (mrs-cl b)))
                                            (subst (list '= (list mrs-F (mrs-cl a)) fa))
                                            (subst (list '= (list mrs-F (mrs-cl b)) fb))
                                            (subst (dk-cite! 'rr-ms-dist fa fb))
                                            (dk-cite! 'rr-mul-le-right n dn 'cb)
                                            (dk-type! (list '* 'cb n)) (dk-type! (list '* n 'cb)) (dk-type! (list '* dn 'cb))
                                            (dk-have! (list '= (list '* 'cb n) (list '* n 'cb)) (lambda () (crs)))
                                            (dk-cite! 'rr-abs-closed (list '- fa fb))
                                            (dk-ineq! (list 'IN (list 'abs (list '- fa fb)) 'RR) (list 'IN eps 'RR) (list 'IN dn 'RR)
                                                      (list 'IN (list '* 'cb n) 'RR) (list 'IN (list '* n 'cb) 'RR) (list 'IN (list '* dn 'cb) 'RR)
                                                      (list '<= (list 'abs (list '- fa fb)) (list '* 'cb n))
                                                      (list '= (list '* 'cb n) (list '* n 'cb))
                                                      (list '<= (list '* n 'cb) (list '* dn 'cb))
                                                      (list '= (list '* dn 'cb) (list '- eps dn))
                                                      (list '<= 0 dn)))))))))))))))))))))
(sp (make-wff (list 'FORALL 'v (list 'FORALL 'f (list 'FORALL 'cb
  (list 'IMPLIES '(IS-SEMI-INNER-PRODUCT-SPACE v) (list 'IMPLIES mrs-sc (list 'IMPLIES '(IN f (FUN (VEC v) RR))
    (list 'IMPLIES mrz-add (list 'IMPLIES mrz-hom (list 'IMPLIES '(IN cb RR) (list 'IMPLIES '(<= 0 cb) (list 'IMPLIES mrs-bound
      '(FORSOME rze_ (AND (IN rze_ (VEC v)) (FORALL rzx_ (IMPLIES (IN rzx_ (VEC v)) (= (f rzx_) ((RIP v) rzx_ rze_)))))))))))))))))))
(dk-peel!)
(mrz-pin!)
(fact 'rr-zero-in) (fact 'nn-is-set)
(dk-cite! 'sip-quotient-complete 'v)
(dk-cite! 'sip-quotient-is-pre-hilbert 'v)
(dk-cite! 'sipq-vec 'v)
(dk-cite! 'sip-setoid-is-setoid 'v)
(dk-cite! 'sip-setoid-pts 'v)
(dk-cite! 'sip-vec-set 'v)
(fact 'rr-is-metric-space)
(dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl)))
(define (mrs-fx! x) (mrz-vt x) (dk-cite! 'fun-apply-type-c 'f '(VEC v) 'RR x) (list 'f x))
(define (mrs-fneg! y)                  ; (= (f (VNEG y)) (* (- 1) (f y)))
  (let ((e (list '= (list 'f (list '(VNEG v) y)) (list '* '(- 1) (list 'f y)))))
    (if (not (dk-asm? e))
        (begin
          (mrz-vt y)
          (dk-have! '(IN 1 RR) (lambda () (arith)))
          (dk-type! '(- 1))
          (dk-cite! 'sip-act-neg-scalar 'v 1 y)
          (dk-cite! 'hbs-act-one-sip-as-module 'v y)
          (dk-rewrite-h! (dk-ctx-form (list '= (list '(ACT v) '(- 1) y) (list '(VNEG v) (list '(ACT v) 1 y)))) (list '(ACT v) 1 y) y)
          (mrs-fx! y)
          (dk-apply! (dk-ctx-form mrz-hom) '(- 1) y)
          (dk-rewrite-h! (dk-ctx-form (list '= (list 'f (list '(ACT v) '(- 1) y)) (list '* '(- 1) (list 'f y)))) (list '(ACT v) '(- 1) y) (list '(VNEG v) y))))
    e))
(define (mrs-fsub! a b)                ; (= (f (a - b)) (- (f a) (f b)))
  (let ((e (list '= (list 'f (mrs-d a b)) (list '- (list 'f a) (list 'f b)))))
    (if (not (dk-asm? e))
        (begin
          (mrs-fneg! b)
          (mrs-fx! a) (mrs-fx! (list '(VNEG v) b)) (mrs-fx! (mrs-d a b))
          (dk-apply! (dk-ctx-form mrz-add) a (list '(VNEG v) b))
          (dk-have! e (lambda () (subst (list '= (list 'f (mrs-d a b)) (list '+ (list 'f a) (list 'f (list '(VNEG v) b)))))
                                 (subst (list '= (list 'f (list '(VNEG v) b)) (list '* '(- 1) (list 'f b))))
                                 (if (mrz-open?) (crs))))))
    e))
(define (mrs-fdiff! a b)               ; |f a - f b| <= cb * nv(a, b), all typed
  (let* ((d (mrs-d a b)) (q (list '(RIP v) d d)) (n (list 'SQRT q)))
    (mrz-vt d)
    (dk-cite! 'sip-rip-type 'v d d)
    (dk-cite! 'sip-rip-self-nonneg 'v d)
    (mrz-and! (list 'IN q 'RR) (list '<= 0 q))
    (mrz-split! (dk-cite! 'sqrt-nonneg q))
    (mrs-fsub! a b)
    (dk-apply! (dk-ctx-form mrs-bound) d)
    (dk-rewrite-h! (dk-ctx-form (list '<= (list 'abs (list 'f d)) (list '* 'cb n))) (list 'f d) (list '- (list 'f a) (list 'f b)))
    (dk-type! (list '- (list 'f a) (list 'f b)))
    n))
;; f respects the relation
(dk-have! (list 'RESPECTS mrs-S 'f)
  (lambda ()
    (mac 'RESPECTS)
    (let* ((ld (dk-peel!))
           (ins (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (list 'PTS mrs-S)))) ld))
           (a (cadr (car ins))) (b (cadr (cadr ins))))
      (for-each (lambda (h) (dk-rewrite-h! h (list 'PTS mrs-S) '(VEC v))) ins)
      (dk-cite! 'sip-related-out 'v a b)
      (let ((n (mrs-fdiff! a b)) (d (mrs-d a b)))
        (dk-cite! 'sqrt-zero)
        (dk-rewrite-h! (dk-ctx-form (list '<= (list 'abs (list '- (list 'f a) (list 'f b))) (list '* 'cb n))) (list '(RIP v) d d) 0)
        (dk-rewrite-h! (dk-ctx-form (list '<= (list 'abs (list '- (list 'f a) (list 'f b))) (list '* 'cb '(SQRT 0)))) '(SQRT 0) 0)
        (dk-have! '(= (* cb 0) 0) (lambda () (crs)))
        (dk-rewrite-h! (dk-ctx-form (list '<= (list 'abs (list '- (list 'f a) (list 'f b))) '(* cb 0))) '(* cb 0) 0)
        (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list '- (list 'f a) (list 'f b)) 0)))
        (dk-ineq! (list 'IN (list 'f a) 'RR) (list 'IN (list 'f b) 'RR)
                  (list '<= (list '- 0) (list '- (list 'f a) (list 'f b))) (list '<= (list '- (list 'f a) (list 'f b)) 0))))))

;; the descended functional
(dk-have! (list 'IN 'f (list 'FUN (list 'PTS mrs-S) 'RR)) (lambda () (subst (list '== (list 'PTS mrs-S) '(VEC v))) (dk-ass!)))
(mrz-and! (list 'IN 'f (list 'FUN (list 'PTS mrs-S) 'RR)) (list 'RESPECTS mrs-S 'f))
(dk-cite! 'descend-in-fun mrs-S 'RR 'f)
(dk-have! (list 'IN mrs-F (list 'FUN (list 'VEC mrs-Q) 'RR)) (lambda () (subst (list '== (list 'VEC mrs-Q) (list 'QUOTIENT mrs-S))) (dk-ass!)))
(define (mrs-rep! xcl)                   ; xcl in VEC Q: a with xcl = CLASS a, a in VEC v; returns a
  (dk-have! (list 'IN xcl (list 'QUOTIENT mrs-S)) (lambda () (subst (list '== (list 'QUOTIENT mrs-S) (list 'VEC mrs-Q))) (dk-ass!)))
  (let* ((qr (dk-cite! 'quotient-rep mrs-S xcl)) (a (dk-skolem! qr #t)))
    (dk-rewrite-h! (list 'IN a (list 'PTS mrs-S)) (list 'PTS mrs-S) '(VEC v))
    a))
(define (mrs-Fcl! a)                   ; a in VEC v: (= (F (CLASS a)) (f a)), CLASS a in VEC Q
  (dk-have! (list 'IN a (list 'PTS mrs-S)) (lambda () (subst (list '== (list 'PTS mrs-S) '(VEC v))) (dk-ass!)))
  (dk-cite! 'class-in-quotient mrs-S a)
  (dk-have! (list 'IN (mrs-cl a) (list 'VEC mrs-Q)) (lambda () (subst (list '== (list 'VEC mrs-Q) (list 'QUOTIENT mrs-S))) (dk-ass!)))
  (dk-cite! 'descend-computes mrs-S 'RR 'f a))
(dk-have! (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ (list 'VEC mrs-Q)) (list 'FORALL 'y_ (list 'IMPLIES (list 'IN 'y_ (list 'VEC mrs-Q))
            (list '= (list mrs-F (list (list 'VADD mrs-Q) 'x_ 'y_)) (list '+ (list mrs-F 'x_) (list mrs-F 'y_)))))))
  (lambda ()
    (let* ((ld (dk-peel!)) (ins (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (list 'VEC mrs-Q)))) ld))
           (xcl (cadr (car ins))) (ycl (cadr (cadr ins))) (a (mrs-rep! xcl)) (b (mrs-rep! ycl)))
      (subst (list '= xcl (mrs-cl a))) (subst (list '= ycl (mrs-cl b)))
      (mrz-vt (list '(VADD v) a b))
      (dk-cite! 'sipq-vadd-computes 'v a b)
      (subst (list '= (list (list 'VADD mrs-Q) (mrs-cl a) (mrs-cl b)) (mrs-cl (list '(VADD v) a b))))
      (mrs-Fcl! a) (mrs-Fcl! b) (mrs-Fcl! (list '(VADD v) a b))
      (mrs-fx! a) (mrs-fx! b)
      (dk-apply! (dk-ctx-form mrz-add) a b)
      (subst (list '= (list mrs-F (mrs-cl (list '(VADD v) a b))) (list 'f (list '(VADD v) a b))))
      (subst (list '= (list mrs-F (mrs-cl a)) (list 'f a)))
      (subst (list '= (list mrs-F (mrs-cl b)) (list 'f b)))
      (dk-ass!))))
(dk-have! (list 'FORALL 'r_ (list 'IMPLIES '(IN r_ RR) (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ (list 'VEC mrs-Q))
            (list '= (list mrs-F (list (list 'ACT mrs-Q) 'r_ 'x_)) (list '* 'r_ (list mrs-F 'x_)))))))
  (lambda ()
    (let* ((ld (dk-peel!)) (r (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'RR))) ld)))
           (xcl (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) (list 'VEC mrs-Q)))) ld)))
           (a (mrs-rep! xcl)))
      (subst (list '= xcl (mrs-cl a)))
      (mrz-vt (list '(ACT v) r a))
      (dk-cite! 'sipq-act-computes 'v r a)
      (subst (list '= (list (list 'ACT mrs-Q) r (mrs-cl a)) (mrs-cl (list '(ACT v) r a))))
      (mrs-Fcl! a) (mrs-Fcl! (list '(ACT v) r a))
      (mrs-fx! a)
      (dk-apply! (dk-ctx-form mrz-hom) r a)
      (subst (list '= (list mrs-F (mrs-cl (list '(ACT v) r a))) (list 'f (list '(ACT v) r a))))
      (subst (list '= (list mrs-F (mrs-cl a)) (list 'f a)))
      (dk-ass!))))
(mrs-continuity!)

(let* ((rz (dk-cite! 'real-riesz-representation mrs-Q mrs-F))
       (eta (dk-skolem! rz #t))
       (rep (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h eta))) "the representation"))
       (e (mrs-rep! eta)))
  (ew e)
  (dk-conj-close!
    (lambda ()
      (if (not (dk-ass!))
          (let* ((x (dk-di-var!)))
            (mrs-Fcl! x)
            (dk-apply! rep (mrs-cl x))
            (dk-cite! 'sipq-rip-computes 'v x e)
            (mrs-fx! x)
            (dk-rewrite-h! (dk-ctx-form (list '= (list mrs-F (mrs-cl x)) (list (list 'RIP mrs-Q) (mrs-cl x) eta))) eta (mrs-cl e))
            (subst (list '= (list 'f x) (list mrs-F (mrs-cl x))))
            (subst (list '= (list mrs-F (mrs-cl x)) (list (list 'RIP mrs-Q) (mrs-cl x) (mrs-cl e))))
            (subst (list '= (list (list 'RIP mrs-Q) (mrs-cl x) (mrs-cl e)) (list '(RIP v) x e)))
            (if (mrz-open?) (rfl)))))))
(mrz-qed! 'sip-riesz-representation)
