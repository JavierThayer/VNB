(define (cnvd-gx f x) (list 'VNB-LAMBDA 'kq_ 'NN (list (list f 'kq_) x)))
(define (cnvd-lims f x) (list 'SEP 'lq_ '(VEC w) (list 'CONVERGES-TO cnvd-wms (cnvd-gx f x) 'lq_)))
(define cnvd-BOw '(CNVS-BOUNDED-OPS v w))
(define (cnvd-ptype! t x)                ; t in BO in context: t in FUN, t x in VEC w
  (dk-cite! 'cbop-fun 'v 'w t)
  (dk-cite! 'fun-apply-type-c t '(VEC v) '(VEC w) x))
(define (cnvd-seqt! f k)                 ; f in FUN(NN, BO) in context, k in NN: f k in BO
  (dk-cite! 'fun-apply-type-c f 'NN cnvd-BOw k))

;;; a Cauchy sequence of the operator metric is a sequence of bounded operators
(sp (make-wff (forall-guarded '(v w f) (append cnvd-C2 (list (list 'IS-CAUCHY-SEQ cnvd-M 'f)))
   (list 'IN 'f (list 'FUN 'NN cnvd-BOw)))))
(dk-peel!)
(dk-cite! 'cbop-normed-ag-is-normed-ag 'v 'w)
(dk-cite! 'cauchy-seq-is-fun cnvd-M 'f)
(let* ((pe (dk-cite! 'nag-metric-carrier cnvd-G))
       (ce (dk-cite! 'cbop-nag-carr 'v 'w)))
  (subst (list '= cnvd-BOw (list 'CARR cnvd-G)))
  (subst (list '= (list 'CARR cnvd-G) (list 'PTS cnvd-M)))
  (ass))
(cnvd-qed! 'cbop-cauchy-seq-fun)

;;; the sequence k |-> f(k)(x) is a sequence of points of w
(sp (make-wff (forall-guarded '(v w f x_) (append cnvd-C2 (list (list 'IN 'f (list 'FUN 'NN cnvd-BOw)) '(IN x_ (VEC v))))
   (list 'IN (cnvd-gx 'f 'x_) (list 'FUN 'NN (list 'PTS cnvd-wms))))))
(dk-peel!)
(let ((pw (dk-cite! 'cnvd-ms-pts 'w)))
  (subst (list '= (list 'PTS cnvd-wms) '(VEC w)))
  (dk-lam-type!
    (lambda ()
      (dk-peel!)
      (cnvd-seqt! 'f (cadr (car (cadr (dk-goal)))))
      (cnvd-ptype! (car (cadr (dk-goal))) 'x_)
      (ass))
    (lambda () (dk-cite! 'nn-is-set) (ass))))
(cnvd-qed! 'cbop-ptwise-seq-fun)

;;; ... and it is Cauchy
(sp (make-wff (forall-guarded '(v w f x_) (append cnvd-C2 (list (list 'IS-CAUCHY-SEQ cnvd-M 'f) '(IN x_ (VEC v))))
   (list 'IS-CAUCHY-SEQ cnvd-wms (cnvd-gx 'f 'x_)))))
(dk-peel!)
(dk-cite! 'cbop-cauchy-seq-fun 'v 'w 'f)
(dk-cite! 'cbop-ptwise-seq-fun 'v 'w 'f 'x_)
(dk-cite! 'cnvd-ms-is-ms 'w)
(cnvd-nt! 'v 'x_)
(let* ((g (cnvd-gx 'f 'x_)) (nx '((VNRM v) x_))
       (dom (list 'FORALL 'm (list 'IMPLIES '(IN m NN) (list 'FORALL 'n_ (list 'IMPLIES '(IN n_ NN)
               (list '<= (list (list 'DIST cnvd-wms) (list g 'm) (list g 'n_))
                         (list '* nx (list (list 'DIST cnvd-M) '(f m) '(f n_))))))))))
  (dk-have! dom
    (lambda ()
      (let* ((lk (dk-peel!))
             (ks (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) lk))))
        (dk-lam-b!)
        (for-each (lambda (k) (cnvd-seqt! 'f k)) ks)
        (dk-cite! 'cbop-pt-dist 'v 'w (list 'f (car ks)) (list 'f (cadr ks)) 'x_)
        (ass))))
  (dk-cite! 'cnvd-ms-cauchy-of-scaled cnvd-M cnvd-wms 'f g nx)
  (ass))
(cnvd-qed! 'cbop-ptwise-cauchy)

;;; the limits at x form a nonempty set, so its CHOICE is one of them
(sp (make-wff (forall-guarded '(v w f x_)
   (list '(IS-COMPLEX-NORMED-VECTOR-SPACE v) '(IS-COMPLEX-BANACH-SPACE w) (list 'IS-CAUCHY-SEQ cnvd-M 'f) '(IN x_ (VEC v)))
   (list 'IN (list 'CHOICE (cnvd-lims 'f 'x_)) (cnvd-lims 'f 'x_)))))
(dk-peel!)
(dk-cite! 'cbs-is-cnvs 'w)
(let* ((g (cnvd-gx 'f 'x_)) (S (cnvd-lims 'f 'x_)))
  (dk-cite! 'cbop-ptwise-cauchy 'v 'w 'f 'x_)
  (dk-cite! 'cbs-complete 'w)
  (dk-cite! 'complete-cauchy-converges cnvd-wms g)
  (let* ((ex (cnvd-iff-fwd! 'converges cnvd-wms g))
         (l (dk-skolem! ex)))
    (cnvd-iff-fwd! 'converges-to cnvd-wms g l)
    (let ((pw (dk-cite! 'cnvd-ms-pts 'w)))
      (dk-have! (list 'IN l '(VEC w)) (lambda () (subst (list '= '(VEC w) (list 'PTS cnvd-wms))) (ass))))
    (dk-have! (list 'FORSOME 'zq_ (list 'IN 'zq_ S))
      (lambda () (witness! l (lambda () (in-sep! (lambda () (ass)) (lambda () (ass)))))))
    (dk-cite! 'choice-axiom S)
    (ass)))
(cnvd-qed! 'cbop-ptwise-limit)

;;; THE THEOREM
(sp (make-wff (forall-guarded '(v w) '((IS-COMPLEX-NORMED-VECTOR-SPACE v) (IS-COMPLEX-BANACH-SPACE w))
   (list 'IS-COMPLETE cnvd-M))))
(dk-peel!)
(dk-cite! 'cbs-is-cnvs 'w)
(dk-cite! 'cnvs-vec-set 'v)
(dk-cite! 'cbop-normed-ag-is-normed-ag 'v 'w)
(dk-cite! 'nag-metric-space-is-metric-space cnvd-G)
(dk-cite! 'cnvd-ms-is-ms 'w)
(define cnvd-pw (dk-cite! 'cnvd-ms-pts 'w))
(define cnvd-pm (dk-cite! 'nag-metric-carrier cnvd-G))
(define cnvd-cm (dk-cite! 'cbop-nag-carr 'v 'w))
(define (cnvd-in-pw! t)                  ; t in VEC w in context
  (dk-have! (list 'IN t (list 'PTS cnvd-wms)) (lambda () (subst (list '= (list 'PTS cnvd-wms) '(VEC w))) (ass))))
(define (cnvd-in-pm! t)                  ; t in BO in context
  (dk-have! (list 'IN t (list 'PTS cnvd-M))
    (lambda () (subst (list '= (list 'PTS cnvd-M) (list 'CARR cnvd-G)))
               (subst (list '= (list 'CARR cnvd-G) cnvd-BOw)) (ass))))
;;; the tail estimate: with N <= n and N <= k (k may be N), and `inner' the Cauchy clause at e,
;;; the goal d_w(g(n), f(k)(x)) <= e ||x|| for g = k |-> f(k)(x)
(define (cnvd-tail! f x n k nN e inner)
  (dk-lam-b!)
  (cnvd-seqt! f n) (cnvd-seqt! f k)
  (cnvd-ptype! (list f n) x) (cnvd-ptype! (list f k) x)
  (cnvd-in-pw! (list (list f n) x)) (cnvd-in-pw! (list (list f k) x))
  (cnvd-in-pm! (list f n)) (cnvd-in-pm! (list f k))
  (let* ((nx (list (list 'VNRM 'v) x)) (dd (cnvd-dm (list f n) (list f k)))
         (dwv (cnvd-dw (list (list f n) x) (list (list f k) x)))
         (p (dk-cite! 'cbop-pt-dist 'v 'w (list f n) (list f k) x)))
    (cnvd-have-and! (list '<= nN n) (list '<= nN k))
    (let ((q (dk-apply! inner n k)))
      (dk-cite! 'metric-dist-real cnvd-M (list f n) (list f k))
      (dk-cite! 'metric-dist-real cnvd-wms (list (list f n) x) (list (list f k) x))
      (cnvd-nt! 'v x)
      (if (not (dk-asm? (list 'IN e 'RR))) (dk-have! (list 'IN e 'RR) (lambda () (arith))))
      (let ((r (dk-cite! 'rr-mul-le-right dd e nx)))
        (dk-have! (list '= (list '* nx dd) (list '* dd nx)) (lambda () (crs)))
        (cnvd-lin! (list (list 'IN dwv 'RR) (list 'IN dd 'RR) (list 'IN e 'RR) (list 'IN nx 'RR))
                  (list p r (list '= (list '* nx dd) (list '* dd nx))))))))
(let* ((iff (dk-cite! 'is-complete cnvd-M))
       (clause (caddr (caddr iff))))
  (dk-have! clause
    (lambda ()
      (let* ((lk (dk-peel!))
             (cy (find-first (lambda (h) (dk-head-is? h 'IS-CAUCHY-SEQ)) lk))
             (f (caddr cy))
             (gx (lambda (x) (cnvd-gx f x)))
             (fs (dk-cite! 'cbop-cauchy-seq-fun 'v 'w f))
             (rhs (cnvd-iff-fwd! 'is-cauchy-seq cnvd-M f))
             (cu (caddr (caddr rhs)))
             (ab (dk-abstract! '(VEC v) '(VEC w) (lambda (x) (list 'CHOICE (cnvd-lims f x)))
                   (lambda (k)
                     (let ((m (dk-cite! 'cbop-ptwise-limit 'v 'w f k)))
                       (sep-me m)
                       (ass)))))
             (lfn (car ab)) (veq (cdr ab))
             (lim (list 'FORALL 'xq_ (list 'IMPLIES '(IN xq_ (VEC v))
                        (list 'CONVERGES-TO cnvd-wms (gx 'xq_) (list lfn 'xq_)))))
             (lim-at! (lambda (x) (dk-apply! lim x)))
             (gfun! (lambda (x) (dk-cite! 'cbop-ptwise-seq-fun 'v 'w f x)))
             (fx (lambda (x) (list lfn x)))
             (ftype! (lambda (x) (dk-cite! 'fun-apply-type-c lfn '(VEC v) '(VEC w) x))))
        ;; lfn(x) is the limit of f(k)(x)
        (dk-have! lim
          (lambda ()
            (let* ((lkx (dk-peel!))
                   (x (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) lkx)))
                   (m (dk-cite! 'cbop-ptwise-limit 'v 'w f x)))
              (sep-me m)
              (subst (dk-apply! veq x))
              (ass))))
        ;; linearity
        (dk-have! (list 'IS-CNVS-LINEAR-OP 'v 'w lfn)
          (lambda ()
            (mac 'IS-CNVS-LINEAR-OP)
            (dk-conj-close!
              (lambda ()
                (let ((g (dk-goal)))
                  (cond
                    ((dk-asm? g) (ass))
                    ((dk-contains? g '(VADD v))
                     (let* ((lk2 (dk-peel!))
                            (xs (map cadr (filter (lambda (h) (dk-head-is? h 'IN)) lk2)))
                            (x (car xs)) (y (cadr xs))
                            (xy (list '(VADD v) x y))
                            (sm (list '(VADD w) (fx x) (fx y))))
                       (fluid-let ((cnvd-v 'v)) (cnvd-vt! xy))
                       (ftype! x) (ftype! y) (ftype! xy) (cnvd-wt! sm) (cnvd-in-pw! sm)
                       (gfun! xy) (gfun! x) (gfun! y)
                       (lim-at! xy) (lim-at! x) (lim-at! y)
                       (dk-have! (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN)
                                   (list '<= (cnvd-dw (list (gx xy) 'nq_) sm)
                                         (list '+ (cnvd-dw (list (gx x) 'nq_) (fx x)) (cnvd-dw (list (gx y) 'nq_) (fx y))))))
                         (lambda ()
                           (let* ((lk3 (dk-peel!)) (n (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) lk3))))
                             (dk-lam-b!)
                             (cnvd-seqt! f n)
                             (cnvd-ptype! (list f n) x) (cnvd-ptype! (list f n) y)
                             (subst (dk-cite! 'cbop-add 'v 'w (list f n) x y))
                             (dk-cite! 'cnvdms-dist-sum-le 'w (list (list f n) x) (list (list f n) y) (fx x) (fx y))
                             (ass))))
                       (dk-cite! 'ms-converges-of-dominated-sum cnvd-wms cnvd-wms cnvd-wms (gx xy) (gx x) (gx y) sm (fx x) (fx y))
                       (dk-cite! 'metric-limit-unique cnvd-wms (gx xy) (fx xy) sm)
                       (ass)))
                    ((dk-contains? g '(CACT v))
                     (let* ((lk2 (dk-peel!))
                            (c (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'CC))) lk2)))
                            (x (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(VEC v)))) lk2)))
                            (cx (list '(CACT v) c x))
                            (cf (list '(CACT w) c (fx x)))
                            (mc (list 'magnitude c)))
                       (fluid-let ((cnvd-v 'v)) (cnvd-vt! cx))
                       (ftype! x) (ftype! cx) (cnvd-wt! cf) (cnvd-in-pw! cf)
                       (gfun! cx) (gfun! x) (lim-at! cx) (lim-at! x)
                       (dk-cite! 'cc-magnitude-closed c) (dk-cite! 'cc-magnitude-nonneg c)
                       (dk-have! (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN)
                                   (list '<= (cnvd-dw (list (gx cx) 'nq_) cf) (list '* mc (cnvd-dw (list (gx x) 'nq_) (fx x))))))
                         (lambda ()
                           (let* ((lk3 (dk-peel!)) (n (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) lk3))))
                             (dk-lam-b!)
                             (cnvd-seqt! f n)
                             (cnvd-ptype! (list f n) x)
                             (subst (dk-cite! 'cbop-act 'v 'w (list f n) c x))
                             (dk-cite! 'cnvdms-dist-act-le 'w c (list (list f n) x) (fx x))
                             (ass))))
                       (dk-cite! 'cnvd-ms-converges-of-scaled cnvd-wms cnvd-wms (gx cx) (gx x) cf (fx x) mc)
                       (dk-cite! 'metric-limit-unique cnvd-wms (gx cx) (fx cx) cf)
                       (ass)))
                    (#t (error "bb2: linearity conjunct" (expression->string g)))))))))
        ;; boundedness, from the Cauchy clause at 1
        (dk-have! '(POS-RR 1) (lambda () (mac 'POS-RR) (dk-conj-close! (lambda () (arith)))))
        (let* ((n1 (dk-skolem! (dk-apply! cu 1)))
               (in1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (memq n1 (free-vars h)))) "the Cauchy clause at 1"))
               (fN (list f n1)) (oN (cnvd-opn fN)) (m0 (list '+ 1 oN)))
          (cnvd-seqt! f n1)
          (cnvd-opn-facts! fN)
          (dk-have! (list '<= n1 n1) (lambda () (dk-nn!)))
          (dk-cite! 'rr-add-in-rr 1 oN)
          (dk-have! (list '<= 0 m0) (lambda () (dk-ineq! (list 'IN oN 'RR) (list '<= 0 oN))))
          (dk-have! (cnvd-ub 'v 'w lfn m0)
            (lambda ()
              (dk-peel!)
              (let* ((x (cadr (caddr (caddr (dk-goal)))))
                     (a (list fN x)) (nx (list (list 'VNRM 'v) x)) (bx (list '* 1 nx))
                     (dfa (cnvd-dw (fx x) a)) (d1 (cnvd-vsub 'w (fx x) a)) (s1 (list '(VADD w) d1 a)))
                (ftype! x) (cnvd-ptype! fN x) (cnvd-in-pw! a) (cnvd-in-pw! (fx x))
                (cnvd-nt! 'v x)
                (dk-have! (list 'IN 1 'RR) (lambda () (arith)))
                (cnvd-mul-in! 1 nx)
                (gfun! x) (lim-at! x)
                (dk-have! (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN) (list 'IMPLIES (list '<= n1 'nq_)
                            (list '<= (cnvd-dw (list (gx x) 'nq_) a) bx))))
                  (lambda ()
                    (let* ((lk3 (dk-peel!)) (n (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) lk3))))
                      (cnvd-tail! f x n n1 n1 1 in1))))
                (let ((t1 (dk-cite! 'cnvd-ms-limit-dist-le cnvd-wms (gx x) (fx x) a bx n1)))
                  (cnvd-wt! d1) (cnvd-wt! s1)
                  (cnvd-weq! s1 (fx x))
                  (let* ((mk (dk-cite! 'nvs-vnrm-triangle-cnvs-as-nvs 'w d1 a))
                         (mk2 (dk-rewrite-h! mk s1 (fx x)))
                         (de (dk-cite! 'cnvdms-dist-norm 'w (fx x) a))
                         (bN (dk-apply! (cnvd-bound-of fN) x)))
                    (cnvd-nt! 'w (fx x)) (cnvd-nt! 'w a) (cnvd-nt! 'w d1)
                    (dk-cite! 'metric-dist-real cnvd-wms (fx x) a)
                    (dk-have! (list '= (list '* m0 nx) (list '+ nx (list '* oN nx))) (lambda () (crs)))
                    (dk-have! (list '= bx nx) (lambda () (crs)))
                    (cnvd-lin! (list (list 'IN (list (list 'VNRM 'w) (fx x)) 'RR) (list 'IN (list (list 'VNRM 'w) a) 'RR)
                                    (list 'IN (list (list 'VNRM 'w) d1) 'RR) (list 'IN dfa 'RR) (list 'IN nx 'RR)
                                    (list 'IN oN 'RR) (list 'IN m0 'RR))
                              (list mk2 de t1 bN (list '= bx nx)
                                    (list '= (list '* m0 nx) (list '+ nx (list '* oN nx))))))))))
          (dk-cite! 'cbop-intro 'v 'w lfn m0))
        ;; convergence in the operator metric
        (cnvd-in-pm! lfn)
        (let* ((ci (dk-cite! 'converges-to cnvd-M f lfn))
               (cl (caddr (caddr (caddr (caddr ci))))))
          (dk-have! cl
            (lambda ()
              (let* ((lk3 (dk-peel!))
                     (e (cadr (find-first (lambda (h) (dk-head-is? h 'POS-RR)) lk3)))
                     (nv (dk-skolem! (dk-apply! cu e)))
                     (inner (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (memq nv (free-vars h)))) "the Cauchy clause")))
                (dk-cite! 'rr-pos-rr-in-rr e)
                (dk-cite! 'rr-lt-of-pos-rr e)
                (dk-have! (list '<= 0 e) (lambda () (dk-ineq! (list '< 0 e))))
                (witness! nv
                  (lambda ()
                    (dk-conj-close!
                      (lambda ()
                        (if (dk-head-is? (dk-goal) 'IN) (ass)
                            (let* ((lk4 (dk-peel!))
                                   (k (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) lk4)))
                                   (fk (list f k)) (nF (list 'CBOP-NEG 'v 'w lfn)) (U (list 'CBOP-SUM 'v 'w fk nF)))
                              (cnvd-seqt! f k)
                              (subst (dk-cite! 'cbop-nag-dist 'v 'w fk lfn))
                              (cnvd-optype! U)
                              (dk-have! (cnvd-ub 'v 'w U e)
                                (lambda ()
                                  (dk-peel!)
                                  (let* ((x (cadr (caddr (caddr (dk-goal)))))
                                         (nx (list (list 'VNRM 'v) x)) (b (list '* e nx))
                                         (fkx (list fk x)))
                                    (cnvd-ptype! fk x) (ftype! x) (cnvd-ptype! nF x)
                                    (dk-cite! 'cbop-fun 'v 'w U)
                                    (subst (dk-cite! 'cbop-sum-apply 'v 'w fk nF x))
                                    (subst (dk-cite! 'cbop-neg-apply 'v 'w lfn x))
                                    (cnvd-wt! (cnvd-vsub 'w fkx (fx x)))
                                    (let ((de (dk-cite! 'cnvdms-dist-norm 'w fkx (fx x))))
                                      (subst (list '= (caddr de) (cadr de))))
                                    (cnvd-in-pw! fkx) (cnvd-in-pw! (fx x))
                                    (subst (dk-cite! 'metric-sym cnvd-wms fkx (fx x)))
                                    (cnvd-nt! 'v x)
                                    (cnvd-mul-in! e nx)
                                    (gfun! x) (lim-at! x)
                                    (dk-have! (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN) (list 'IMPLIES (list '<= nv 'nq_)
                                                (list '<= (cnvd-dw (list (gx x) 'nq_) fkx) b))))
                                      (lambda ()
                                        (let* ((lk5 (dk-peel!)) (n (cadr (find-first (lambda (h) (dk-head-is? h 'IN)) lk5))))
                                          (cnvd-tail! f x n k nv e inner))))
                                    (dk-cite! 'cnvd-ms-limit-dist-le cnvd-wms (gx x) (fx x) fkx b nv)
                                    (ass))))
                              (cnvd-spec! U)
                              (dk-apply! (cnvd-least U) e)
                              (ass)))))))))))
          (cnvd-iff-bwd! 'converges-to cnvd-M f lfn)
          (dk-have! (list 'FORSOME 'lq_ (list 'CONVERGES-TO cnvd-M f 'lq_))
            (lambda () (witness! lfn (lambda () (ass)))))
          (cnvd-iff-bwd! 'converges cnvd-M f)
          (ass))))
  (cnvd-iff-bwd! 'is-complete cnvd-M)
  (ass))
(cnvd-qed! 'cbop-complete)
