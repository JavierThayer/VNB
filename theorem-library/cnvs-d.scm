;;; the read-offs of BOP-NORMED-AG
(define (cnvd-read-off! name acc val)
  (sp (make-wff (forall-guarded '(v w) cnvd-C2 (list '== (list acc cnvd-G) val))))
  (dk-peel!)
  ;; the literal list is certified defined once its components are typed (a list is defined iff
  ;; its components are sets)
  (dk-cite! 'cbops-is-set 'v 'w) (dk-cite! 'cbop-zero-bounded 'v 'w)
  (slot acc)
  (mac 'CBOP-NORMED-AG)
  (nth-r)
  (if (not (proof-done? *ps*)) (qrfl))
  (cnvd-qed! name))
(define cnvd-nag-vals
  '((CARR (CNVS-BOUNDED-OPS v w) cbop-nag-carr) (OPR (CBOP-VADD v w) cbop-nag-opr) (IDEN (CBOP-ZERO v w) cbop-nag-iden)
    (INV (CBOP-VINV v w) cbop-nag-inv) (NRM (CBOP-VNRM v w) cbop-nag-nrm)))
(for-each (lambda (p) (cnvd-read-off! (caddr p) (car p) (cadr p))) cnvd-nag-vals)
(define (cnvd-nag-readoffs!)
  (for-each (lambda (p)
              (if (dk-contains? (dk-goal) (list (car p) cnvd-G))
                  (subst (dk-cite! (caddr p) 'v 'w))))
            cnvd-nag-vals))

;;; the values of its operations
(sp (make-wff (forall-guarded '(v w s_ t_) (append cnvd-C2 (cnvd-in-bo 's_ 't_))
   '(= ((CBOP-VADD v w) s_ t_) (CBOP-SUM v w s_ t_)))))
(dk-peel!)
