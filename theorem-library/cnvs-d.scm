;;; cnvs-d.scm -- BOUNDED OPERATORS BETWEEN COMPLEX NORMED VECTOR SPACES: the operator norm, the
;;; normed abelian group CBOP-NORMED-AG(v, w), and its COMPLETENESS when w is a complex Banach
;;; space (CNVS, 2026-11-09).  All PROVEN modulo 0.  Destination: theorem-library/cnvs-d.scm.
;;; Vocabulary: structure-library/cnvs-vocab.scm (IS-CNVS-LINEAR-OP .. CBOP-NORMED-AG).
;;;
;;; A PORT of BA-BH's operator part (scratchpad/babh-1109/ba-bh.scm: bounded operators, the
;;; operator norm and its specification) and of BA-BH2's parts A, B (the abelian-group laws), C
;;; (zero, definiteness, triangle, negation), D (the normed group), E (three metric lemmas), F
;;; and G (completeness), from a complex inner-product space to a CNVS.  The port is mechanical
;;; (scratchpad/cnvs-1109/port/xlate.py: IP-NORM(v, x) -> VNRM(v)(x), the complex ACT -> CACT,
;;; the operator vocabulary -> its CNVS twin, the CIPS laws -> the CNVS laws and companions) except
;;; at two places, rewritten by hand: (1) the norm laws, which BA-BH derives from the inner product
;;; (sqrt), are here the companions of the CNVS-AS-NVS and CNVS-AS-NORMED-AG views; (2) BA-BH2
;;; proves every VECTOR IDENTITY in w by expanding inner products (bb2-vec-eq!); here
;;; cnvd-vec-eq! decides the identities the proofs meet by the abelian-group and CACT laws:
;;; a one-step match against a table of laws, else a rewrite by an expanding law and a retry.
;;;
;;; Part E (ms-converges-of-scaled, ms-cauchy-of-scaled, ms-limit-dist-le) is general metric-
;;; space analysis; BA-BH2 proves it in an operator-algebras file, so it is re-proved here under
;;; cnvd-ms-* names.  When both are wired the operator-algebras copies should go (FINDING).
;;;
;;; Helper prefixes: cnvd- (BA-BH2's bb2-) and cnvh- (BA-BH's bbh-).
;;; LOAD WINDOW: after theorem-library/cnvs-c (nothing of it is cited; cnvs-a is: cnvs-vec-set,
;;; cnvs-cact-*, cnvs-vnrm-cact, cbs-is-cnvs, cbs-complete) and the metric-space lemmas
;;; (complete-cauchy-converges, metric-limit-unique, ms-converges-of-dominated-sum).
;;; Library: analysis.

(define cnvd-v 'v)
(define (cnvd-op? e op)
  (and (pair? e) (pair? (car e)) (eq? (car (car e)) op) (equal? (cadr (car e)) cnvd-v)))
(define (cnvd-zero? e) (equal? e (list 'VZERO cnvd-v)))

;;; land (IN e (VEC v)) for a vector term of the CNVS cnvd-v built from typed atoms
(define (cnvd-vt! e)
  (let ((goal (list 'IN e (list 'VEC cnvd-v))))
    (cond ((dk-asm? goal) goal)
          ((cnvd-op? e 'VADD) (cnvd-vt! (cadr e)) (cnvd-vt! (caddr e))
                              (dk-cite! 'nvs-vadd-in-vec-cnvs-as-nvs cnvd-v (cadr e) (caddr e)) goal)
          ((cnvd-op? e 'VNEG) (cnvd-vt! (cadr e))
                              (dk-cite! 'nvs-vneg-in-vec-cnvs-as-nvs cnvd-v (cadr e)) goal)
          ((cnvd-op? e 'CACT) (cnvd-ct! (cadr e)) (cnvd-vt! (caddr e))
                              (dk-cite! 'cnvs-cact-type-pt cnvd-v (cadr e) (caddr e)) goal)
          ((cnvd-zero? e) (dk-cite! 'nvs-vzero-in-vec-cnvs-as-nvs cnvd-v) goal)
          ((cnvd-app-fun e) => (lambda (ft) (cnvd-arg-t! (cadr e) (cadr (caddr ft)))
                                     (dk-cite! 'fun-apply-type-c (car e) (cadr (caddr ft)) (caddr (caddr ft)) (cadr e))
                                     goal))
          (#t (error "cnvd-vt!: no typing for the vector" (expression->string e))))))
(define (cnvd-app-fun e)
  (and (pair? e) (= (length e) 2)
       (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (cadr h) (car e))
                                    (pair? (caddr h)) (eq? (car (caddr h)) 'FUN)
                                    (= (length (caddr h)) 3)
                                    (equal? (caddr (caddr h)) (list 'VEC cnvd-v))))
                   (dk-asms))))
(define (cnvd-arg-t! a d)
  (cond ((dk-asm? (list 'IN a d)) #t)
        ((equal? d (list 'VEC cnvd-v)) (cnvd-vt! a))
        ((and (pair? d) (eq? (car d) 'VEC)) (fluid-let ((cnvd-v (cadr d))) (cnvd-vt! a)))
        (#t (error "cnvd-arg-t!: argument not typed" (expression->string (list 'IN a d))))))

;;; land (IN c CC) for a scalar term
(define (cnvd-ct! c)
  (let ((goal (list 'IN c 'CC)))
    (cond ((dk-asm? goal) goal)
          ((number? c) (dk-have! goal (lambda () (arith))) goal)
          ((dk-asm? (list 'IN c 'RR)) (dk-cite! 'rr-subset-cc c) goal)
          ((and (pair? c) (eq? (car c) 'conjugate))
           (cnvd-ct! (cadr c)) (dk-cite! 'cc-conjugate-closed (cadr c)) goal)
          ((and (pair? c) (memq (car c) '(* +)) (= (length c) 3))
           (cnvd-ct! (cadr c)) (cnvd-ct! (caddr c))
           (cnvd-have-and! (list 'IN (cadr c) 'CC) (list 'IN (caddr c) 'CC))
           (dk-cite! (if (eq? (car c) '*) 'cc-mul-closed 'cc-add-closed) (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 2))
           (cnvd-ct! (cadr c)) (dk-cite! 'cc-neg-closed (cadr c)) goal)
          (#t (dk-have! goal (lambda () (type-term))) goal))))

(define (cnvd-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))
(define (cnvd-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))
(define (cnvd-and fs)
  (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (cnvd-and (cdr fs)))))
(define (cnvd-have-and! . fs)
  (let ((c (cnvd-and fs)))
    (dk-have! c (lambda () (dk-conj-close! dk-ass!)))
    c))
(define cnvh-iff-fwd! cnvd-iff-fwd!)
(define cnvh-iff-bwd! cnvd-iff-bwd!)
(define cnvh-have-and! cnvd-have-and!)
(define (cnvd-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** cnvs-d: ") (display name) (display " did NOT close.  Open leaves:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "cnvs-d: unfinished" name))))
(define cnvh-qed! cnvd-qed!)

;;; ==========================================================================================
;;; THE NORM of a CNVS, in the shapes BA-BH's ip-norm-* lemmas have
;;; ==========================================================================================
(define cnvd-cn '(IS-COMPLEX-NORMED-VECTOR-SPACE v))
(sp (make-wff (forall-guarded '(v x_) (list cnvd-cn '(IN x_ (VEC v))) '(IN ((VNRM v) x_) RR))))
(dk-peel!)
(dk-cite! 'normed-ag-nrm-type-cnvs-as-normed-ag 'v)
(dk-cite! 'fun-apply-type-c '(VNRM v) '(VEC v) 'RR 'x_)
(ass)
(cnvd-qed! 'cnvd-norm-in-rr)

(sp (make-wff (forall-guarded '(v x_) (list cnvd-cn '(IN x_ (VEC v))) '(<= 0 ((VNRM v) x_)))))
(dk-peel!)
(dk-cite! 'normed-ag-nrm-nonneg-cnvs-as-normed-ag 'v 'x_)
(ass)
(cnvd-qed! 'cnvd-norm-nonneg)

(sp (make-wff (forall-guarded '(v x_) (list cnvd-cn '(IN x_ (VEC v)) '(= ((VNRM v) x_) 0)) '(= x_ (VZERO v)))))
(dk-peel!)
(cnvd-iff-fwd! 'normed-ag-nrm-definite-cnvs-as-normed-ag 'v 'x_)
(ass)
(cnvd-qed! 'cnvd-norm-zero-vector)

;;; ||-x|| = ||x||: -x = (-1) x, and |-1| = 1
(sp (make-wff (forall-guarded '(v x_) (list cnvd-cn '(IN x_ (VEC v))) '(= ((VNRM v) ((VNEG v) x_)) ((VNRM v) x_)))))
(dk-peel!)
(let* ((e1 (dk-cite! 'nvs-neg-one-act-cnvs-as-nvs 'v 'x_))
       (m1 (cadr (cadr e1))))                    ; the literal -1 as the instance holds it
  (dk-have! (list 'IN m1 'RR) (lambda () (arith)))
  (dk-have! (list '<= m1 0) (lambda () (arith)))
  (dk-cite! 'nvs-act-in-vec-cnvs-as-nvs 'v m1 'x_)
  (subst (list '= (caddr e1) (cadr e1)))
  (subst (dk-cite! 'nvs-vnrm-homog-cnvs-as-nvs 'v m1 'x_))
  (subst (dk-cite! 'rr-abs-of-nonpos m1))
  (dk-cite! 'cnvd-norm-in-rr 'v 'x_))
(if (not (proof-done? *ps*)) (crs))
(cnvd-qed! 'cnvd-norm-vneg)

;;; ==========================================================================================
;;; CACT and the abelian group: the three laws the vector identities need besides cnvs-a's
;;; ==========================================================================================
(define (cnvd-cpeel!) (dk-peel!) (dk-cite! 'cnvs-scal-pin 'v))
;;; c(-x) = -(c x)
(sp (make-wff (forall-guarded '(v c_ x_) (list cnvd-cn '(IN c_ CC) '(IN x_ (VEC v)))
   '(= ((CACT v) c_ ((VNEG v) x_)) ((VNEG v) ((CACT v) c_ x_))))))
(cnvd-cpeel!)
(set! cnvd-v 'v)
(let* ((e1 (dk-cite! 'nvs-neg-one-act-cnvs-as-nvs 'v 'x_))
       (m1 (cadr (cadr e1)))
       (cx '((CACT v) c_ x_)))
  (dk-have! (list 'IN m1 'RR) (lambda () (arith)))
  (cnvd-ct! m1)
  (cnvd-vt! cx)
  (let ((e2 (dk-cite! 'nvs-neg-one-act-cnvs-as-nvs 'v cx)))
    ;; -(c x) = (-1)(c x) = CACT(-1)(c x) = CACT(-1 * c) x;  c(-x) = c((-1) x) = CACT(c * -1) x
    (subst (list '= (caddr e1) (cadr e1)))
    (subst (list '= (caddr e2) (cadr e2)))
    (dk-cite! 'nvs-act-in-vec-cnvs-as-nvs 'v m1 'x_)
    (let ((r1 (dk-cite! 'cnvs-cact-real 'v m1 'x_))
          (r2 (dk-cite! 'cnvs-cact-real 'v m1 cx)))
      (subst (list '= (caddr r1) (cadr r1)))
      (subst (list '= (caddr r2) (cadr r2))))
    (let ((u1 (dk-cite! 'cnvs-cact-mul 'v 'c_ m1 'x_))
          (u2 (dk-cite! 'cnvs-cact-mul 'v m1 'c_ 'x_)))
      (subst (list '= (caddr u1) (cadr u1)))
      (subst (list '= (caddr u2) (cadr u2)))
      (cnvd-ct! (list '* 'c_ m1))
      (dk-have! (list '= (list '* 'c_ m1) (list '* m1 'c_)) (lambda () (crs)))
      (subst (list '= (list '* 'c_ m1) (list '* m1 'c_)))
      (cnvd-ct! (list '* m1 'c_))
      (cnvd-vt! (list '(CACT v) (list '* m1 'c_) 'x_))
      (if (not (proof-done? *ps*)) (rfl)))))
(cnvd-qed! 'cnvd-cact-vneg)

;;; c(d x) = d(c x)
(sp (make-wff (forall-guarded '(v c_ d_ x_) (list cnvd-cn '(IN c_ CC) '(IN d_ CC) '(IN x_ (VEC v)))
   '(= ((CACT v) c_ ((CACT v) d_ x_)) ((CACT v) d_ ((CACT v) c_ x_))))))
(cnvd-cpeel!)
(set! cnvd-v 'v)
(let ((u1 (dk-cite! 'cnvs-cact-mul 'v 'c_ 'd_ 'x_))
      (u2 (dk-cite! 'cnvs-cact-mul 'v 'd_ 'c_ 'x_)))
  (subst (list '= (caddr u1) (cadr u1)))
  (subst (list '= (caddr u2) (cadr u2)))
  (cnvd-ct! '(* c_ d_))
  (dk-have! '(= (* c_ d_) (* d_ c_)) (lambda () (crs)))
  (subst '(= (* c_ d_) (* d_ c_)))
  (cnvd-ct! '(* d_ c_))
  (cnvd-vt! '((CACT v) (* d_ c_) x_))
  (if (not (proof-done? *ps*)) (rfl)))
(cnvd-qed! 'cnvd-cact-comm)

;;; c 0 = 0
(sp (make-wff (forall-guarded '(v c_) (list cnvd-cn '(IN c_ CC)) '(= ((CACT v) c_ (VZERO v)) (VZERO v)))))
(cnvd-cpeel!)
(set! cnvd-v 'v)
(let* ((z '(VZERO v)) (cz (list '(CACT v) 'c_ z)))
  (cnvd-vt! z) (cnvd-vt! cz)
  ;; c 0 = c (0 + 0) = c 0 + c 0, so c 0 = 0 by cancellation
  (let ((e (dk-cite! 'nvs-vzero-left-cnvs-as-nvs 'v z)))
    (dk-have! (list '= (list '(VADD v) cz cz) (list '(VADD v) cz z))
      (dk-lane (lambda ()
        (subst (dk-cite! 'nvs-vzero-right-cnvs-as-nvs 'v cz))
        (let ((d (dk-cite! 'cnvs-cact-vadd 'v 'c_ z z)))
          (subst (list '= (caddr d) (cadr d)))
          (subst e)
          (if (dk-lane-open?) (rfl))))))
    (dk-cite! 'nvs-vadd-cancel-cnvs-as-nvs 'v cz cz z)
    (ass)))
(cnvd-qed! 'cnvd-cact-vzero)

;;; ==========================================================================================
;;; THE VECTOR IDENTITIES in the CNVS cnvd-v
;;; ==========================================================================================
;;; a law: (NAME VARS LHS RHS), patterns over ?-variables, the space written as SP
(define cnvd-laws
  '((nvs-vadd-shuffle-cnvs-as-nvs (a b p q)
       ((VADD SP) ((VADD SP) ?a ?p) ((VADD SP) ?b ?q)) ((VADD SP) ((VADD SP) ?a ?b) ((VADD SP) ?p ?q)))
    (nvs-vadd-assoc-cnvs-as-nvs (u v x)
       ((VADD SP) ((VADD SP) ?u ?v) ?x) ((VADD SP) ?u ((VADD SP) ?v ?x)))
    (nvs-vadd-comm-cnvs-as-nvs (u x) ((VADD SP) ?u ?x) ((VADD SP) ?x ?u))
    (nvs-vzero-left-cnvs-as-nvs (u) ((VADD SP) (VZERO SP) ?u) ?u)
    (nvs-vzero-right-cnvs-as-nvs (u) ((VADD SP) ?u (VZERO SP)) ?u)
    (nvs-vneg-left-cnvs-as-nvs (u) ((VADD SP) ((VNEG SP) ?u) ?u) (VZERO SP))
    (nvs-vneg-right-cnvs-as-nvs (u) ((VADD SP) ?u ((VNEG SP) ?u)) (VZERO SP))
    (nvs-vneg-vadd-cnvs-as-nvs (x y) ((VNEG SP) ((VADD SP) ?x ?y)) ((VADD SP) ((VNEG SP) ?x) ((VNEG SP) ?y)))
    (cnvs-cact-vadd (c x y) ((CACT SP) ?c ((VADD SP) ?x ?y)) ((VADD SP) ((CACT SP) ?c ?x) ((CACT SP) ?c ?y)))
    (cnvd-cact-vneg (c x) ((CACT SP) ?c ((VNEG SP) ?x)) ((VNEG SP) ((CACT SP) ?c ?x)))
    (cnvd-cact-comm (c d x) ((CACT SP) ?c ((CACT SP) ?d ?x)) ((CACT SP) ?d ((CACT SP) ?c ?x)))
    (cnvd-cact-vzero (c) ((CACT SP) ?c (VZERO SP)) (VZERO SP))
    (cnvs-cact-add (c d x) ((CACT SP) (+ ?c ?d) ?x) ((VADD SP) ((CACT SP) ?c ?x) ((CACT SP) ?d ?x)))
    (cnvs-cact-mul (c d x) ((CACT SP) (* ?c ?d) ?x) ((CACT SP) ?c ((CACT SP) ?d ?x)))
    (cnvs-cact-one (x) ((CACT SP) 1 ?x) ?x)))
;;; the laws used as left-to-right REWRITES when no law matches the goal outright
(define cnvd-rewrites
  '(nvs-vneg-vadd-cnvs-as-nvs cnvs-cact-vadd cnvd-cact-vneg nvs-vadd-assoc-cnvs-as-nvs
    nvs-vneg-left-cnvs-as-nvs nvs-vneg-right-cnvs-as-nvs nvs-vzero-left-cnvs-as-nvs nvs-vzero-right-cnvs-as-nvs
    cnvd-cact-vzero))
(define (cnvd-pvar? p) (and (symbol? p) (let ((s (symbol->string p))) (and (> (string-length s) 1) (char=? (string-ref s 0) #\?)))))
(define (cnvd-inst p sp)
  (cond ((eq? p 'SP) sp) ((pair? p) (map (lambda (q) (cnvd-inst q sp)) p)) (#t p)))
(define (cnvd-match p e bs)             ; bs an alist, or #f
  (cond ((not bs) #f)
        ((cnvd-pvar? p) (let ((b (assq p bs))) (if b (and (equal? (cdr b) e) bs) (cons (cons p e) bs))))
        ((pair? p) (and (pair? e) (= (length p) (length e))
                        (let loop ((ps p) (es e) (bs bs))
                          (if (null? ps) bs (loop (cdr ps) (cdr es) (cnvd-match (car ps) (car es) bs))))))
        (#t (and (equal? p e) bs))))
(define (cnvd-law name) (or (assq name cnvd-laws) (error "cnvd-law: unknown" name)))
(define (cnvd-cite-law! law bs)         ; type the instance's atoms, cite, return the equation
  (let ((args (map (lambda (v) (cdr (assq (symbol-append '? v) bs))) (cadr law))))
    (for-each (lambda (v a) (if (memq v '(c d)) (cnvd-ct! a) (cnvd-vt! a))) (cadr law) args)
    (apply dk-cite! (car law) cnvd-v args)))
(define (cnvd-find-sub p e)             ; the first subterm of E matching P: (term . bindings)
  (let ((bs (cnvd-match p e '())))
    (cond (bs (cons e bs))
          ((pair? e) (let loop ((l e)) (cond ((null? l) #f) ((cnvd-find-sub p (car l))) (#t (loop (cdr l))))))
          (#t #f))))
(define (cnvd-vec-eq! a b)
  (cnvd-vt! a) (cnvd-vt! b)
  (dk-have! (list '= a b)
    (dk-lane
     (lambda ()
       (let loop ((fuel 12))
         (if (<= fuel 0) (error "cnvd-vec-eq!: no proof of" (expression->string (dk-goal))))
         (let* ((g (dk-goal)) (l (cadr g)) (r (caddr g)))
           (cond
             ((equal? l r) (cnvd-vt! l) (rfl))
             ((let try ((ls cnvd-laws))
                (cond ((null? ls) #f)
                      ((let* ((lw (car ls)) (lp (cnvd-inst (caddr lw) cnvd-v)) (rp (cnvd-inst (cadddr lw) cnvd-v))
                              (bs (cnvd-match rp r (cnvd-match lp l '())))
                              (bs2 (and (not bs) (cnvd-match rp l (cnvd-match lp r '())))))
                         (cond (bs (cnvd-cite-law! lw bs) (ass) #t)
                               (bs2 (let ((e (cnvd-cite-law! lw bs2))) (subst e) (cnvd-vt! (caddr e))
                                      (if (dk-lane-open?) (rfl))) #t)
                               (#t #f))))
                      (#t (try (cdr ls))))))
             ((let try ((rs cnvd-rewrites))
                (cond ((null? rs) #f)
                      ((let* ((lw (cnvd-law (car rs))) (lp (cnvd-inst (caddr lw) cnvd-v))
                              (hit (cnvd-find-sub lp g)))
                         (and hit (begin (subst (cnvd-cite-law! lw (cdr hit))) #t))))
                      (#t (try (cdr rs)))))
              (if (dk-lane-open?) (loop (- fuel 1))))
             (#t (error "cnvd-vec-eq!: stuck at" (expression->string g))))))))))

;;; ==========================================================================================
;;; THE METRIC SPACE of a CNVS: what BA-BH's ip-metric-space-* lemmas gave
;;; ==========================================================================================
(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-NORMED-VECTOR-SPACE v) (IS-METRIC-SPACE (CNVS-METRIC-SPACE v))))))
(dk-peel!)
(mac 'CNVS-METRIC-SPACE)
(dk-cite! 'nag-metric-space-is-metric-space-cnvs-as-normed-ag 'v)
(ass)
(cnvd-qed! 'cnvd-ms-is-ms)

(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-NORMED-VECTOR-SPACE v) (== (PTS (CNVS-METRIC-SPACE v)) (VEC v))))))
(dk-peel!)
(mac 'CNVS-METRIC-SPACE)
(dk-cite! 'nag-metric-carrier-cnvs-as-normed-ag 'v)
(ass)
(cnvd-qed! 'cnvd-ms-pts)



;;; ---- bounded operators ------------------------------------------------------------------
(sp (make-wff '(FORALL cbv_ (FORALL cbw_ (== (CNVS-BOUNDED-OPS cbv_ cbw_)
   (SEP cbt_ (FUN (VEC cbv_) (VEC cbw_)) (IS-CNVS-BOUNDED-OP cbv_ cbw_ cbt_)))))))
(di) (mac 'CNVS-BOUNDED-OPS) (qrfl)
(cnvh-qed! 'cbops-unfold)

(sp (make-wff '(FORALL v (FORALL w (FORALL t_ (IFF (IN t_ (CNVS-BOUNDED-OPS v w))
   (AND (IN t_ (FUN (VEC v) (VEC w))) (IS-CNVS-BOUNDED-OP v w t_))))))))
(dk-peel!)
(let ((u (dk-cite! 'cbops-unfold 'v 'w)))
  (subst u)
  (let ((sep (caddr u)))
    (dk-iff! (lambda (g) (dk-head-is? g 'AND))
      (lambda () (sep-me (list 'IN 't_ sep)) (dk-split-all!) (dk-conj-close! dk-ass!))
      (lambda () (dk-split-all!) (in-sep! dk-ass! (lambda () (ass)))))))
(cnvh-qed! 'cbops-membership)

;;; the laws of a bounded operator, as citable universals
(define (cnvh-bop-law! name concl)
  (sp (make-wff (list 'FORALL 'v (list 'FORALL 'w (list 'FORALL 't_
       (list 'IMPLIES '(IN t_ (CNVS-BOUNDED-OPS v w)) concl))))))
  (dk-peel!)
  (cnvh-iff-fwd! 'cbops-membership 'v 'w 't_)
  (mac-h 'IS-CNVS-BOUNDED-OP '(IS-CNVS-BOUNDED-OP v w t_))
  (dk-split-all!)
  (if (not (dk-asm? (dk-goal)))
      (begin (mac-h 'IS-CNVS-LINEAR-OP '(IS-CNVS-LINEAR-OP v w t_)) (dk-split-all!)))
  (ass)
  (cnvh-qed! name))

(cnvh-bop-law! 'cbop-fun '(IN t_ (FUN (VEC v) (VEC w))))
(cnvh-bop-law! 'cbop-linear '(IS-CNVS-LINEAR-OP v w t_))
(cnvh-bop-law! 'cbop-bound-exists
  '(FORSOME cbm_ (AND (IN cbm_ RR) (AND (<= 0 cbm_)
     (FORALL cbx_ (IMPLIES (IN cbx_ (VEC v)) (<= ((VNRM w) (t_ cbx_)) (* cbm_ ((VNRM v) cbx_)))))))))

(sp (make-wff (forall-guarded '(v w t_ x_ y_) '((IN t_ (CNVS-BOUNDED-OPS v w)) (IN x_ (VEC v)) (IN y_ (VEC v)))
   '(= (t_ ((VADD v) x_ y_)) ((VADD w) (t_ x_) (t_ y_))))))
(dk-peel!)
(dk-cite! 'cbop-linear 'v 'w 't_)
(mac-h 'IS-CNVS-LINEAR-OP '(IS-CNVS-LINEAR-OP v w t_))
(dk-split-all!)
(dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(VADD v)))) "additivity") 'x_ 'y_)
(ass)
(cnvh-qed! 'cbop-add)

(sp (make-wff (forall-guarded '(v w t_ c_ x_) '((IN t_ (CNVS-BOUNDED-OPS v w)) (IN c_ CC) (IN x_ (VEC v)))
   '(= (t_ ((CACT v) c_ x_)) ((CACT w) c_ (t_ x_))))))
(dk-peel!)
(dk-cite! 'cbop-linear 'v 'w 't_)
(mac-h 'IS-CNVS-LINEAR-OP '(IS-CNVS-LINEAR-OP v w t_))
(dk-split-all!)
(dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(CACT v)))) "homogeneity") 'c_ 'x_)
(ass)
(cnvh-qed! 'cbop-act)

;;; introduction: a linear operator with a bound is bounded
(sp (make-wff (forall-guarded '(v w t_ m_) '((IS-CNVS-LINEAR-OP v w t_) (IN m_ RR) (<= 0 m_)
     (FORALL cbx_ (IMPLIES (IN cbx_ (VEC v)) (<= ((VNRM w) (t_ cbx_)) (* m_ ((VNRM v) cbx_))))))
   '(IN t_ (CNVS-BOUNDED-OPS v w)))))
(dk-peel!)
(dk-have! '(IN t_ (FUN (VEC v) (VEC w)))
  (lambda () (mac-h 'IS-CNVS-LINEAR-OP '(IS-CNVS-LINEAR-OP v w t_)) (dk-split-all!) (ass)))
(dk-have! '(IS-CNVS-BOUNDED-OP v w t_)
  (lambda () (mac 'IS-CNVS-BOUNDED-OP)
    (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'FORSOME)
                                   (begin (ew 'm_) (dk-conj-close! dk-ass!))
                                   (ass))))))
(cnvh-iff-bwd! 'cbops-membership 'v 'w 't_)
(ass)
(cnvh-qed! 'cbop-intro)

;;; ---- the operator norm ------------------------------------------------------------------
(define (cnvh-A t)
  (list 'SEP 'cba_ 'RR
    (list 'OR '(= cba_ 0)
      (list 'FORSOME 'cbx_ (list 'AND '(IN cbx_ (VEC v))
        (list 'AND '(NOT (= ((VNRM v) cbx_) 0))
          (list '= 'cba_ (list '* (list (list 'VNRM 'w) (list t 'cbx_)) '(recip ((VNRM v) cbx_))))))))))

(define (cnvh-mul-in! u w2)
  (dk-have! (list 'AND (list 'IN u 'RR) (list 'IN w2 'RR)) (lambda () (dk-conj-close! dk-ass!)))
  (dk-cite! 'rr-mul-closed u w2))

;;; typings of a vector xv of v and of t xv
(define (cnvh-type-pt! t xv)
  (dk-cite! 'cnvd-norm-in-rr 'v xv)
  (dk-cite! 'cnvd-norm-nonneg 'v xv)
  (dk-cite! 'fun-apply-type-c t '(VEC v) '(VEC w) xv)
  (dk-cite! 'cnvd-norm-in-rr 'w (list t xv))
  (dk-cite! 'cnvd-norm-nonneg 'w (list t xv)))

(define (cnvh-recip-pos! nx)
  (dk-cite! 'neq-sym nx 0)
  (dk-have! (list '< 0 nx) (lambda () (mac '<) (from-context!)))
  (dk-have! (list 'AND (list 'IN nx 'RR) (list 'NOT (list '= nx 0))) (lambda () (dk-conj-close! dk-ass!)))
  (dk-cite! 'rr-recip-closed nx)
  (dk-cite! 'rr-recip-pos nx)
  (dk-have! (list '<= 0 (list 'recip nx))
            (lambda () (mac-h '< (list '< 0 (list 'recip nx))) (dk-split-all!) (ass))))

;;; every bound c of t bounds A(t)
(define (cnvh-upper-bound! t c ub-law)
  (let ((A (cnvh-A t)))
    (mac 'RR-UPPER-BOUND)
    (both!
     (lambda () (ass))
     (lambda ()
       (dk-peel!)
       (let* ((u (cadr (dk-goal)))
              (cnd (car (filter (dk-head? 'OR) (dk-landed (lambda () (sep-me (list 'IN u A))))))))
         (use-cases (list (list '= u 0) (caddr cnd))
           (lambda () (subst (list '= u 0)) (ass))
           (lambda ()
             (let* ((xv (dk-skolem! (caddr cnd)))
                    (nx (list (list 'VNRM 'v) xv))
                    (fx (list (list 'VNRM 'w) (list t xv))))
               (dk-split-all!)
               (cnvh-type-pt! t xv)
               (cnvh-recip-pos! nx)
               (dk-apply! ub-law xv)
               (cnvh-mul-in! c nx)
               (dk-cite! 'rr-le-scale-nonneg-right fx (list '* c nx) (list 'recip nx))
               (dk-cite! 'rr-mul-recip-cancel c nx)
               (subst (list '= u (list '* fx (list 'recip nx))))
               (subst (list '= c (list '* (list '* c nx) (list 'recip nx))))
               (ass)))))))))

(define (cnvh-ub t d)
  (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC v))
     (list '<= (list (list 'VNRM 'w) (list t 'x_)) (list '* d '((VNRM v) x_))))))

(sp (make-wff (list 'FORALL 'v (list 'FORALL 'w (list 'FORALL 't_
  (list 'IMPLIES '(IS-COMPLEX-NORMED-VECTOR-SPACE v) (list 'IMPLIES '(IS-COMPLEX-NORMED-VECTOR-SPACE w)
  (list 'IMPLIES '(IN t_ (CNVS-BOUNDED-OPS v w))
    (list 'AND '(IN (CNVS-OPNORM v w t_) RR)
      (list 'AND '(<= 0 (CNVS-OPNORM v w t_))
        (list 'AND (cnvh-ub 't_ '(CNVS-OPNORM v w t_))
          (list 'FORALL 'd_ (list 'IMPLIES '(IN d_ RR) (list 'IMPLIES '(<= 0 d_)
            (list 'IMPLIES (cnvh-ub 't_ 'd_) '(<= (CNVS-OPNORM v w t_) d_))))))))))))))))
(dk-peel!)
(dk-cite! 'cbop-fun 'v 'w 't_)
(define cnvh-c0 (dk-skolem! (dk-cite! 'cbop-bound-exists 'v 'w 't_)))
(dk-split-all!)
(define cnvh-ub0 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h cnvh-c0))) "the bound law"))
(mac 'CNVS-OPNORM)
(define cnvh-AA (cnvh-A 't_))
(define cnvh-sup (list 'SUP cnvh-AA))
(dk-have! (list 'SUBSET cnvh-AA 'RR)
  (lambda () (mac 'subset-def) (dk-peel!)
    (let ((u (cadr (dk-goal)))) (sep-me (list 'IN u cnvh-AA)) (dk-split-all!) (ass))))
(dk-have! (list 'IN 0 cnvh-AA)
  (lambda () (in-sep! (lambda () (dk-cite! 'rr-zero-in) (ass)) (lambda () (oi-l) (rfl)))))
(dk-have! (list 'FORSOME 'x (list 'IN 'x cnvh-AA)) (lambda () (ew 0) (ass)))
(define cnvh-c1 cnvh-c0)
(dk-have! (list 'RR-BOUNDED-ABOVE cnvh-AA)
  (lambda () (mac 'RR-BOUNDED-ABOVE) (ew cnvh-c1) (cnvh-upper-bound! 't_ cnvh-c1 (cnvh-ub 't_ cnvh-c1))))
(dk-cite! 'rr-sup-in cnvh-AA)
(dk-cite! 'rr-sup-upper cnvh-AA)
(define cnvh-supub (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x cnvh-AA) (list '<= 'x cnvh-sup))))
(dk-have! cnvh-supub
  (lambda () (mac-h 'RR-UPPER-BOUND (list 'RR-UPPER-BOUND cnvh-AA cnvh-sup)) (dk-split-all!) (ass)))
(dk-have! (list '<= 0 cnvh-sup) (lambda () (dk-apply! cnvh-supub 0) (ass)))
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
       ((not (dk-head-is? g 'FORALL)) (ass))
       ((eq? (cadr g) 'd_)
        (dk-peel!)
        (let ((dv (caddr (dk-goal))))
          (dk-have! (list 'RR-UPPER-BOUND cnvh-AA dv)
                    (lambda () (cnvh-upper-bound! 't_ dv (cnvh-ub 't_ dv))))
          (dk-cite! 'rr-sup-least cnvh-AA dv)
          (ass)))
       (#t
        (let* ((lk (dk-peel!))
               (xv (cadr (car (filter (dk-head? 'IN) lk))))
               (nx (list (list 'VNRM 'v) xv))
               (fx (list (list 'VNRM 'w) (list 't_ xv))))
          (cnvh-type-pt! 't_ xv)
          (dk-apply! cnvh-ub0 xv)
          (cnvh-mul-in! cnvh-c1 nx)
          (cnvh-mul-in! cnvh-sup nx)
          (use-em (list '= nx 0)
            (lambda ()
              (dk-have! (list '= (list '* cnvh-c1 nx) 0)
                        (lambda () (subst (list '= nx 0)) (dk-cite! 'rr-mul-zero cnvh-c1) (ass)))
              (dk-have! (list '= (list '* cnvh-sup nx) 0)
                        (lambda () (subst (list '= nx 0)) (dk-cite! 'rr-mul-zero cnvh-sup) (ass)))
              (dk-ineq! (list '<= fx (list '* cnvh-c1 nx))
                        (list '= (list '* cnvh-c1 nx) 0)
                        (list '= (list '* cnvh-sup nx) 0)
                        (list 'IN (list '* cnvh-c1 nx) 'RR)
                        (list 'IN (list '* cnvh-sup nx) 'RR)
                        (list 'IN fx 'RR)))
            (lambda ()
              (cnvh-recip-pos! nx)
              (let ((q (list '* fx (list 'recip nx))))
                (cnvh-mul-in! fx (list 'recip nx))
                (dk-have! (list 'IN q cnvh-AA)
                  (lambda ()
                    (in-sep! (lambda () (ass))
                             (lambda () (oi-r) (ew xv)
                                        (dk-conj-close!
                                         (lambda () (if (dk-head-is? (dk-goal) '=) (rfl) (ass))))))))
                (dk-apply! cnvh-supub q)
                (dk-cite! 'rr-le-scale-nonneg-right q cnvh-sup nx)
                (dk-cite! 'rr-recip-cancel-right fx nx)
                (subst (list '= fx (list '* q nx)))
                (ass))))))))))
(cnvh-qed! 'cnvs-opnorm-spec)

;;; the four corollaries
(define (cnvh-opnorm-cor! name concl)
  (sp (make-wff (list 'FORALL 'v (list 'FORALL 'w (list 'FORALL 't_
       (list 'IMPLIES '(IS-COMPLEX-NORMED-VECTOR-SPACE v) (list 'IMPLIES '(IS-COMPLEX-NORMED-VECTOR-SPACE w)
       (list 'IMPLIES '(IN t_ (CNVS-BOUNDED-OPS v w)) concl))))))))
  (dk-peel!)
  (dk-split-all! (list (dk-cite! 'cnvs-opnorm-spec 'v 'w 't_)))
  (if (eq? name 'cnvs-opnorm-bound)
      (let ((law (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (let ((b (cadr h))) (or (eq? b 'x_) (and (pair? b) (eq? (car b) 'x_)))))) (dk-asms))))
        (dk-apply! law 'x_)
        (if (not (proof-done? *ps*)) (ass)))
      (ass))
  (cnvh-qed! name))
(cnvh-opnorm-cor! 'cnvs-opnorm-in-rr '(IN (CNVS-OPNORM v w t_) RR))
(cnvh-opnorm-cor! 'cnvs-opnorm-nonneg '(<= 0 (CNVS-OPNORM v w t_)))
(cnvh-opnorm-cor! 'cnvs-opnorm-bound (cnvh-ub 't_ '(CNVS-OPNORM v w t_)))


(define (cnvd-show! tag)
  (display "\n--- BBH ") (display tag) (display " GOAL: ") (display (expression->string (dk-goal))) (newline)
  (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline)) (dk-asms)))
;;; ---- from ba-bh.scm parts 2-5 (prefix bb2-) -----------------------------------------------
(define cnvd-w 'w)
(define (cnvd-n u) (list (list 'VNRM cnvd-v) u))
(define (cnvd-ipv a b) (list '(IP v) a b))
(define (cnvd-ipw a b) (list '(IP w) a b))
(define (cnvd-mul-in! u w2)
  (dk-have! (list 'AND (list 'IN u 'RR) (list 'IN w2 'RR)) (lambda () (dk-conj-close! dk-ass!)))
  (dk-cite! 'rr-mul-closed u w2))
(define (cnvd-prod? t) (and (pair? t) (eq? (car t) '*) (= (length t) 3)
                           (not (number? (cadr t))) (not (number? (caddr t)))))
(define (cnvd-prods e)
  (cond ((cnvd-prod? e) (list e))
        ((and (pair? e) (memq (car e) '(<= < = + -))) (append-map cnvd-prods (cdr e)))
        (#t '())))
(define (cnvd-mul-type! p)
  (if (not (dk-asm? (list 'IN p 'RR)))
      (begin
        (if (cnvd-prod? (cadr p)) (cnvd-mul-type! (cadr p)))
        (if (cnvd-prod? (caddr p)) (cnvd-mul-type! (caddr p)))
        (dk-cite! 'rr-mul-in-rr (cadr p) (caddr p)))))
;;; (bb2-lin! TYPINGS PREMS): every product in PREMS and in the GOAL named, then dk-ineq!
(define (cnvd-lin! typings prems)
  (let* ((ps (let loop ((l (append (append-map cnvd-prods prems) (cnvd-prods (dk-goal)))) (acc '()))
               (cond ((null? l) (reverse acc)) ((member (car l) acc) (loop (cdr l) acc))
                     (#t (loop (cdr l) (cons (car l) acc))))))
         (names (map (lambda (p)
                       (cnvd-mul-type! p)
                       (cons p (dk-name! p)))
                     ps))
         (new (map (lambda (f)
                     (let loop ((f f) (ns names))
                       (cond ((null? ns) f)
                             ((dk-contains? f (caar ns)) (loop (dk-rewrite-h! f (caar ns) (cdar ns)) (cdr ns)))
                             (#t (loop f (cdr ns))))))
                   prems)))
    (for-each (lambda (n) (if (dk-contains? (dk-goal) (car n)) (subst (list '= (car n) (cdr n))))) names)
    (apply dk-ineq! (append typings (map (lambda (n) (list 'IN (cdr n) 'RR)) names) new))))
;;; the least-bound clause of opnorm-spec for T (spec split into context first)
(define (cnvd-least t)
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'd_) (dk-contains? h t)
                            (dk-contains? h 'CNVS-OPNORM)))
           "the least-bound clause"))
;;; the bound clause  forall x in VEC v. ||t x|| <= d ||x||
(define (cnvd-ub v w t d)
  (list 'FORALL 'cbx_ (list 'IMPLIES (list 'IN 'cbx_ (list 'VEC v))
     (list '<= (list (list 'VNRM w) (list t 'cbx_)) (list '* d (list (list 'VNRM v) 'cbx_))))))
;;; ||x|| typed and nonnegative
(define (cnvd-nt! v x) (dk-cite! 'cnvd-norm-in-rr v x) (dk-cite! 'cnvd-norm-nonneg v x))

;;; ---- PART A: the operator constructions, pointwise; closure of L(v, w) -----------------------
(define cnvd-C2 '((IS-COMPLEX-NORMED-VECTOR-SPACE v) (IS-COMPLEX-NORMED-VECTOR-SPACE w)))

;;; the values of the constructions at a point
(sp (make-wff (forall-guarded '(v w s_ t_ x_)
   '((IS-COMPLEX-NORMED-VECTOR-SPACE w) (IN s_ (FUN (VEC v) (VEC w))) (IN t_ (FUN (VEC v) (VEC w))) (IN x_ (VEC v)))
   '(= ((CBOP-SUM v w s_ t_) x_) ((VADD w) (s_ x_) (t_ x_))))))
(dk-peel!)
(fluid-let ((cnvd-v 'w)) (cnvd-vt! '((VADD w) (s_ x_) (t_ x_))))
(mac 'CBOP-SUM) (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl))
(cnvd-qed! 'cbop-sum-apply)

(sp (make-wff (forall-guarded '(v w t_ x_)
   '((IS-COMPLEX-NORMED-VECTOR-SPACE w) (IN t_ (FUN (VEC v) (VEC w))) (IN x_ (VEC v)))
   '(= ((CBOP-NEG v w t_) x_) ((VNEG w) (t_ x_))))))
(dk-peel!)
(fluid-let ((cnvd-v 'w)) (cnvd-vt! '((VNEG w) (t_ x_))))
(mac 'CBOP-NEG) (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl))
(cnvd-qed! 'cbop-neg-apply)

(sp (make-wff (forall-guarded '(v w c_ t_ x_)
   '((IS-COMPLEX-NORMED-VECTOR-SPACE w) (IN c_ CC) (IN t_ (FUN (VEC v) (VEC w))) (IN x_ (VEC v)))
   '(= ((CBOP-SCALE v w c_ t_) x_) ((CACT w) c_ (t_ x_))))))
(dk-peel!)
(fluid-let ((cnvd-v 'w)) (cnvd-vt! '((CACT w) c_ (t_ x_))))
(mac 'CBOP-SCALE) (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl))
(cnvd-qed! 'cbop-scale-apply)

(sp (make-wff (forall-guarded '(v w x_)
   '((IS-COMPLEX-NORMED-VECTOR-SPACE w) (IN x_ (VEC v)))
   '(= ((CBOP-ZERO v w) x_) (VZERO w)))))
(dk-peel!)
(dk-cite! 'nvs-vzero-in-vec-cnvs-as-nvs 'w)
(mac 'CBOP-ZERO) (dk-lam-b!) (if (not (proof-done? *ps*)) (rfl))
(cnvd-qed! 'cbop-zero-apply)


;;; ---- closure ---------------------------------------------------------------------------------
;;; the vector typing of an operator value in w
(define (cnvd-wt! e) (fluid-let ((cnvd-v 'w)) (cnvd-vt! e)))
(define (cnvd-vvt! e) (fluid-let ((cnvd-v 'v)) (cnvd-vt! e)))
(define (cnvd-weq! a b) (fluid-let ((cnvd-v 'w)) (cnvd-vec-eq! a b)))
;;; IS-LINEAR-OP v w OP for a construction OP, given its value law APP! (a procedure of the point
;;; that rewrites (OP x) in the goal) and the vector identity closer
(define (cnvd-linear! op app! fun!)
  (dk-have! (list 'IS-CNVS-LINEAR-OP 'v 'w op)
    (lambda ()
      (mac 'IS-CNVS-LINEAR-OP)
      (dk-conj-close!
       (lambda ()
         (let ((g (dk-goal)))
           (cond
             ((dk-head-is? g 'IN) (fun!))
             ((dk-contains? g '(VADD v))
              (dk-peel!)
              (let* ((s (cadr (cadr (dk-goal)))) (x (cadr s)) (y (caddr s)))
                (cnvd-vvt! s)
                (app! s) (app! x) (app! y)
                (cnvd-lin-close! 'add x y)))
             (#t
              (dk-peel!)
              (let* ((s (cadr (cadr (dk-goal)))) (c (cadr s)) (x (caddr s)))
                (cnvd-vvt! s)
                (app! s) (app! x)
                (cnvd-lin-close! 'CACT c x))))))))))
;;; after the value laws: rewrite the component operators by bop-add / bop-act, then the vector
;;; identity in w
(define cnvd-comps '())
(define (cnvd-lin-close! kind a b)
  (for-each (lambda (t)
              (if (eq? kind 'add)
                  (if (dk-contains? (dk-goal) (list t (list '(VADD v) a b)))
                      (subst (dk-cite! 'cbop-add 'v 'w t a b)))
                  (if (dk-contains? (dk-goal) (list t (list '(CACT v) a b)))
                      (subst (dk-cite! 'cbop-act 'v 'w t a b)))))
            cnvd-comps)
  (let ((g (dk-goal)))
    ((dk-lane (lambda () (cnvd-weq! (cadr g) (caddr g)) (dk-lane-if! ass))))))
;;; the FUN typing of a construction (mac its head, dk-lam-type!)
(define (cnvd-fun! head)
  (lambda ()
    (mac head)
    (dk-lam-type! (lambda () (dk-peel!) (cnvd-wt! (cadr (dk-goal))) (if (not (proof-done? *ps*)) (ass)))
                  (lambda () (dk-cite! 'cnvs-vec-set 'v) (ass)))))
;;; the bound clause for OP with bound MM, its pointwise proof PT! a procedure of the point
(define (cnvd-bound! op mm pt!)
  (dk-have! (cnvd-ub 'v 'w op mm)
    (lambda ()
      (dk-peel!)
      (pt! (cadr (caddr (caddr (dk-goal))))))))
(define (cnvd-bop-pre!)
  (dk-peel!)
  (set! cnvd-v 'w)
  (for-each (lambda (t) (dk-cite! 'cbop-fun 'v 'w t)) cnvd-comps))

(set! cnvd-comps '(s_ t_))
(sp (make-wff (forall-guarded '(v w s_ t_) (append cnvd-C2 '((IN s_ (CNVS-BOUNDED-OPS v w)) (IN t_ (CNVS-BOUNDED-OPS v w))))
   '(IN (CBOP-SUM v w s_ t_) (CNVS-BOUNDED-OPS v w)))))
(cnvd-bop-pre!)
(let* ((op '(CBOP-SUM v w s_ t_))
       (app! (lambda (x) (subst (dk-cite! 'cbop-sum-apply 'v 'w 's_ 't_ x)))))
  (cnvd-linear! op app! (cnvd-fun! 'CBOP-SUM))
  (let* ((m1 (dk-skolem! (dk-cite! 'cbop-bound-exists 'v 'w 's_)))
         (l1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m1))) "bound of s"))
         (m2 (dk-skolem! (dk-cite! 'cbop-bound-exists 'v 'w 't_)))
         (l2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m2))) "bound of t"))
         (mm (list '+ m1 m2)))
    (dk-split-all!)
    (dk-cite! 'rr-add-in-rr m1 m2)
    (dk-have! (list '<= 0 mm) (lambda () (dk-ineq! (list 'IN m1 'RR) (list 'IN m2 'RR) (list '<= 0 m1) (list '<= 0 m2))))
    (cnvd-bound! op mm
      (lambda (x)
        (let* ((sx (list 's_ x)) (tx (list 't_ x)) (st (list '(VADD w) sx tx)))
          (cnvd-wt! st)
          (app! x)
          (dk-cite! 'nvs-vnrm-triangle-cnvs-as-nvs 'w sx tx)
          (cnvd-nt! 'v x) (cnvd-nt! 'w sx) (cnvd-nt! 'w tx) (cnvd-nt! 'w st)
          (dk-apply! l1 x) (dk-apply! l2 x)
          (let ((nx (list (list 'VNRM 'v) x)))
            (dk-have! (list '= (list '* mm nx) (list '+ (list '* m1 nx) (list '* m2 nx))) (lambda () (crs)))
            (cnvd-lin! (list (list 'IN (list (list 'VNRM 'w) st) 'RR) (list 'IN (list (list 'VNRM 'w) sx) 'RR)
                            (list 'IN (list (list 'VNRM 'w) tx) 'RR) (list 'IN nx 'RR) (list 'IN m1 'RR) (list 'IN m2 'RR)
                            (list 'IN mm 'RR))
                      (list (list '<= (list (list 'VNRM 'w) st) (list '+ (list (list 'VNRM 'w) sx) (list (list 'VNRM 'w) tx)))
                            (list '<= (list (list 'VNRM 'w) sx) (list '* m1 nx))
                            (list '<= (list (list 'VNRM 'w) tx) (list '* m2 nx))
                            (list '= (list '* mm nx) (list '+ (list '* m1 nx) (list '* m2 nx)))))))))
    (dk-cite! 'cbop-intro 'v 'w op mm)
    (ass)))
(cnvd-qed! 'cbop-sum-bounded)

(set! cnvd-comps '(t_))
(sp (make-wff (forall-guarded '(v w t_) (append cnvd-C2 '((IN t_ (CNVS-BOUNDED-OPS v w))))
   '(IN (CBOP-NEG v w t_) (CNVS-BOUNDED-OPS v w)))))
(cnvd-bop-pre!)
(let* ((op '(CBOP-NEG v w t_))
       (app! (lambda (x) (subst (dk-cite! 'cbop-neg-apply 'v 'w 't_ x)))))
  (cnvd-linear! op app! (cnvd-fun! 'CBOP-NEG))
  (let* ((m1 (dk-skolem! (dk-cite! 'cbop-bound-exists 'v 'w 't_)))
         (l1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m1))) "bound of t")))
    (dk-split-all!)
    (cnvd-bound! op m1
      (lambda (x)
        (let* ((tx (list 't_ x)))
          (cnvd-wt! tx)
          (app! x)
          (subst (dk-cite! 'cnvd-norm-vneg 'w tx))
          (dk-apply! l1 x)
          (ass))))
    (dk-cite! 'cbop-intro 'v 'w op m1)
    (ass)))
(cnvd-qed! 'cbop-neg-bounded)

(set! cnvd-comps '(t_))
(sp (make-wff (forall-guarded '(v w c_ t_) (append cnvd-C2 '((IN c_ CC) (IN t_ (CNVS-BOUNDED-OPS v w))))
   '(IN (CBOP-SCALE v w c_ t_) (CNVS-BOUNDED-OPS v w)))))
(cnvd-bop-pre!)
(let* ((op '(CBOP-SCALE v w c_ t_))
       (app! (lambda (x) (subst (dk-cite! 'cbop-scale-apply 'v 'w 'c_ 't_ x)))))
  (cnvd-linear! op app! (cnvd-fun! 'CBOP-SCALE))
  (let* ((m1 (dk-skolem! (dk-cite! 'cbop-bound-exists 'v 'w 't_)))
         (l1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m1))) "bound of t"))
         (mc '(magnitude c_))
         (mm (list '* mc m1)))
    (dk-split-all!)
    (dk-cite! 'cc-magnitude-closed 'c_) (dk-cite! 'cc-magnitude-nonneg 'c_)
    (dk-cite! 'rr-mul-in-rr mc m1)
    (cnvd-have-and! (list 'IN mc 'RR) (list 'IN m1 'RR))
    (cnvd-have-and! (list '<= 0 mc) (list '<= 0 m1))
    (dk-cite! 'rr-leq-mul-nonneg mc m1)
    (cnvd-bound! op mm
      (lambda (x)
        (let* ((tx (list 't_ x)) (nx (list (list 'VNRM 'v) x)) (ntx (list (list 'VNRM 'w) tx)))
          (cnvd-wt! tx)
          (app! x)
          (subst (dk-cite! 'cnvs-vnrm-cact 'w 'c_ tx))
          (cnvd-nt! 'v x) (cnvd-nt! 'w tx)
          (dk-apply! l1 x)
          (dk-cite! 'rr-mul-in-rr m1 nx)
          (dk-cite! 'rr-mul-le-right ntx (list '* m1 nx) mc)
          (dk-have! (list '= (list '* mc ntx) (list '* ntx mc)) (lambda () (crs)))
          (dk-have! (list '= (list '* (list '* m1 nx) mc) (list '* mm nx)) (lambda () (crs)))
          (cnvd-lin! (list (list 'IN ntx 'RR) (list 'IN nx 'RR) (list 'IN mc 'RR) (list 'IN m1 'RR))
                    (list (list '<= (list '* ntx mc) (list '* (list '* m1 nx) mc))
                          (list '= (list '* mc ntx) (list '* ntx mc))
                          (list '= (list '* (list '* m1 nx) mc) (list '* mm nx)))))))
    (dk-cite! 'cbop-intro 'v 'w op mm)
    (ass)))
(cnvd-qed! 'cbop-scale-bounded)

(set! cnvd-comps '())
(sp (make-wff (forall-guarded '(v w) cnvd-C2 '(IN (CBOP-ZERO v w) (CNVS-BOUNDED-OPS v w)))))
(cnvd-bop-pre!)
(let* ((op '(CBOP-ZERO v w))
       (app! (lambda (x) (subst (dk-cite! 'cbop-zero-apply 'v 'w x)))))
  (cnvd-linear! op app! (cnvd-fun! 'CBOP-ZERO))
  (dk-have! '(IN 0 RR) (lambda () (arith)))
  (dk-have! '(<= 0 0) (lambda () (arith)))
  (cnvd-bound! op 0
    (lambda (x)
      (app! x)
      (subst (dk-cite! 'nvs-vnrm-vzero-cnvs-as-nvs 'w))
      (cnvd-nt! 'v x)
      (dk-ineq! (list 'IN (list (list 'VNRM 'v) x) 'RR))))
  (dk-cite! 'cbop-intro 'v 'w op 0)
  (ass))
(cnvd-qed! 'cbop-zero-bounded)

;;; ---- PART B: the module laws of L(v, w), the norm laws of OPNORM, composition, the adjoint ----
;;; The device: an operator identity is FUNCTION EXTENSIONALITY (dk-fun-ext!) with a pointwise
;;; proof that rewrites every application of a construction at the point by its value law and
;;; closes the resulting vector identity by expansion (bb2-vec-eq!).

(define cnvd-dv 'v)                      ; the domain space of the operators of the current proof
(define cnvd-cw 'w)                      ; the codomain space
(define (cnvd-dvt! e) (fluid-let ((cnvd-v cnvd-dv)) (cnvd-vt! e)))
(define (cnvd-cvt! e) (fluid-let ((cnvd-v cnvd-cw)) (cnvd-vt! e)))
(define cnvd-cons '(CBOP-SUM CBOP-NEG CBOP-SCALE CBOP-ZERO CBOP-COMP CBOP-ID OP-ADJOINT))
(define (cnvd-cons? e) (and (pair? e) (memq (car e) cnvd-cons)))
;;; land (IN e (BOUNDED-OPS d c)) and (IN e (FUN (VEC d) (VEC c))) for an operator term
(define (cnvd-optype! e)
  (let ((d cnvd-dv) (c cnvd-cw))
    (cond ((not (pair? e)) #t)
          ((eq? (car e) 'CBOP-SUM) (cnvd-optype! (cadddr e)) (cnvd-optype! (car (cddddr e)))
           (dk-cite! 'cbop-sum-bounded d c (cadddr e) (car (cddddr e))))
          ((eq? (car e) 'CBOP-NEG) (cnvd-optype! (cadddr e)) (dk-cite! 'cbop-neg-bounded d c (cadddr e)))
          ((eq? (car e) 'CBOP-SCALE) (cnvd-ct! (cadddr e)) (cnvd-optype! (car (cddddr e)))
           (dk-cite! 'cbop-scale-bounded d c (cadddr e) (car (cddddr e))))
          ((eq? (car e) 'CBOP-ZERO) (dk-cite! 'cbop-zero-bounded d c))
          ((eq? (car e) 'CBOP-COMP) (cnvd-optype! (caddr e)) (cnvd-optype! (cadddr e))
           (dk-cite! 'cbop-comp-bounded d (caddr e) (cadddr e)))
          ((eq? (car e) 'CBOP-ID) (dk-cite! 'cbop-id-bounded d))
          (#t #t))
    (if (not (dk-asm? (list 'IN e (list 'FUN (list 'VEC d) (list 'VEC c)))))
        (dk-cite! 'cbop-fun d c e))))
;;; the first application in E that a value law opens
(define cnvd-atoms '())                  ; the atomic operators of the proof
(define (cnvd-app-redex e)
  (cond ((not (pair? e)) #f)
        ((and (= (length e) 2) (cnvd-cons? (car e)) (not (eq? (car (car e)) 'OP-ADJOINT))) e)
        ((and (= (length e) 2) (memq (car e) cnvd-atoms) (pair? (cadr e)) (pair? (car (cadr e)))
              (memq (car (car (cadr e))) '(VADD CACT VNEG)) (equal? (cadr (car (cadr e))) cnvd-dv))
         e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((cnvd-app-redex (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
(define (cnvd-open-app! r)
  (let* ((f (car r)) (x (cadr r)) (d cnvd-dv) (c cnvd-cw))
    (cond ((memq f cnvd-atoms)
           (let ((op (car (car x))))
             (cond ((eq? op 'VADD) (cnvd-dvt! (cadr x)) (cnvd-dvt! (caddr x))
                    (dk-cite! 'cbop-add d c f (cadr x) (caddr x)))
                   ((eq? op 'CACT) (cnvd-ct! (cadr x)) (cnvd-dvt! (caddr x))
                    (dk-cite! 'cbop-act d c f (cadr x) (caddr x)))
                   (#t (cnvd-dvt! (cadr x)) (dk-cite! 'cbop-vneg d c f (cadr x))))))
          (#t
           (cnvd-dvt! x)
           (case (car f)
             ((CBOP-SUM) (dk-cite! 'cbop-sum-apply d c (cadddr f) (car (cddddr f)) x))
             ((CBOP-NEG) (dk-cite! 'cbop-neg-apply d c (cadddr f) x))
             ((CBOP-SCALE) (dk-cite! 'cbop-scale-apply d c (cadddr f) (car (cddddr f)) x))
             ((CBOP-ZERO) (dk-cite! 'cbop-zero-apply d c x))
             ((CBOP-COMP) (dk-cite! 'cbop-comp-apply d (caddr f) (cadddr f) x))
             ((CBOP-ID) (dk-cite! 'cbop-id-apply d x)))))))
(define (cnvd-unapp!)
  (let loop ((fuel 60))
    (if (<= fuel 0) (error "bb2-unapp!: out of fuel"))
    (let ((r (cnvd-app-redex (dk-goal))))
      (if r (begin (subst (cnvd-open-app! r)) (loop (- fuel 1)))))))
;;; the operator identity LHS = RHS by extensionality
(define (cnvd-ext! lhs rhs)
  (cnvd-optype! lhs) (cnvd-optype! rhs)
  (for-each (lambda (t) (dk-cite! 'cbop-fun cnvd-dv cnvd-cw t)) cnvd-atoms)
  (dk-fun-ext! lhs rhs (list 'VEC cnvd-dv) (list 'VEC cnvd-cw) #f #f
    (lambda (x)
      (cnvd-unapp!)
      (let ((g (dk-goal)))
        (if (equal? (cadr g) (caddr g)) (rfl)
            ((dk-lane (lambda () (fluid-let ((cnvd-v cnvd-cw)) (cnvd-vec-eq! (cadr g) (caddr g)))
                                 (dk-lane-if! ass)))))))))
;;; a law: (bb2-law! NAME VARS HYPS LHS RHS)
(define (cnvd-op-law! name vars hyps lhs rhs atoms)
  (sp (make-wff (forall-guarded vars hyps (list '= lhs rhs))))
  (dk-peel!)
  (set! cnvd-atoms atoms)
  (cnvd-ext! lhs rhs)
  (cnvd-qed! name))

(define cnvd-BO '(CNVS-BOUNDED-OPS v w))
(define (cnvd-in-bo . ts) (map (lambda (t) (list 'IN t cnvd-BO)) ts))
(set! cnvd-dv 'v) (set! cnvd-cw 'w)
(define (cnvd-s a b) (list 'CBOP-SUM 'v 'w a b))
(define (cnvd-sc c a) (list 'CBOP-SCALE 'v 'w c a))
(define cnvd-z '(CBOP-ZERO v w))

;;; the abelian group
(cnvd-op-law! 'cbop-sum-assoc '(v w r_ s_ t_) (append cnvd-C2 (cnvd-in-bo 'r_ 's_ 't_))
  (cnvd-s (cnvd-s 'r_ 's_) 't_) (cnvd-s 'r_ (cnvd-s 's_ 't_)) '(r_ s_ t_))
(cnvd-op-law! 'cbop-sum-comm '(v w s_ t_) (append cnvd-C2 (cnvd-in-bo 's_ 't_))
  (cnvd-s 's_ 't_) (cnvd-s 't_ 's_) '(s_ t_))
(cnvd-op-law! 'cbop-sum-zero-left '(v w t_) (append cnvd-C2 (cnvd-in-bo 't_))
  (cnvd-s cnvd-z 't_) 't_ '(t_))
(cnvd-op-law! 'cbop-sum-zero-right '(v w t_) (append cnvd-C2 (cnvd-in-bo 't_))
  (cnvd-s 't_ cnvd-z) 't_ '(t_))
(cnvd-op-law! 'cbop-sum-neg-left '(v w t_) (append cnvd-C2 (cnvd-in-bo 't_))
  (cnvd-s '(CBOP-NEG v w t_) 't_) cnvd-z '(t_))
(cnvd-op-law! 'cbop-sum-neg-right '(v w t_) (append cnvd-C2 (cnvd-in-bo 't_))
  (cnvd-s 't_ '(CBOP-NEG v w t_)) cnvd-z '(t_))
;;; the action
(cnvd-op-law! 'cbop-scale-sum '(v w c_ s_ t_) (append cnvd-C2 '((IN c_ CC)) (cnvd-in-bo 's_ 't_))
  (cnvd-sc 'c_ (cnvd-s 's_ 't_)) (cnvd-s (cnvd-sc 'c_ 's_) (cnvd-sc 'c_ 't_)) '(s_ t_))
(cnvd-op-law! 'cbop-scale-add '(v w c_ d_ t_) (append cnvd-C2 '((IN c_ CC) (IN d_ CC)) (cnvd-in-bo 't_))
  (cnvd-sc '(+ c_ d_) 't_) (cnvd-s (cnvd-sc 'c_ 't_) (cnvd-sc 'd_ 't_)) '(t_))
(cnvd-op-law! 'cbop-scale-mul '(v w c_ d_ t_) (append cnvd-C2 '((IN c_ CC) (IN d_ CC)) (cnvd-in-bo 't_))
  (cnvd-sc '(* c_ d_) 't_) (cnvd-sc 'c_ (cnvd-sc 'd_ 't_)) '(t_))
(cnvd-op-law! 'cbop-scale-one '(v w t_) (append cnvd-C2 (cnvd-in-bo 't_))
  (cnvd-sc 1 't_) 't_ '(t_))
;;; ---- PART C: the norm laws of OPNORM; ||I|| = 1 on a nontrivial space; the adjoint is additive
;;; and conjugate linear ----------------------------------------------------------------------------
(set! cnvd-dv 'v) (set! cnvd-cw 'w)
(define (cnvd-opn t) (list 'CNVS-OPNORM 'v 'w t))
(define (cnvd-opn-facts! t)
  (dk-cite! 'cnvs-opnorm-in-rr 'v 'w t) (dk-cite! 'cnvs-opnorm-nonneg 'v 'w t) (dk-cite! 'cnvs-opnorm-bound 'v 'w t))
(define (cnvd-bound-of t)
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h (cnvd-opn t))
                            (not (eq? (cadr h) 'd_))))
           "the bound clause"))
(define (cnvd-spec! t) (dk-split-all! (list (dk-cite! 'cnvs-opnorm-spec 'v 'w t))))
(define (cnvd-antisym! a b)              ; a = b from a <= b, b <= a and the typings in context
  (for-each (lambda (z) (if (and (number? z) (not (dk-asm? (list 'IN z 'RR))))
                            (dk-have! (list 'IN z 'RR) (lambda () (arith)))))
            (list a b))
  (cnvd-have-and! (list 'IN a 'RR) (list 'IN b 'RR))
  (cnvd-have-and! (list '<= a b) (list '<= b a))
  (dk-cite! 'rr-leq-antisymmetric a b))
(define (cnvd-recip-pos! nx)             ; nx in RR, 0 <= nx, nx /= 0 in context
  (dk-cite! 'neq-sym nx 0)
  (dk-have! (list '< 0 nx) (lambda () (mac '<) (from-context!)))
  (cnvd-have-and! (list 'IN nx 'RR) (list 'NOT (list '= nx 0)))
  (dk-cite! 'rr-recip-closed nx)
  (dk-cite! 'rr-recip-pos nx)
  (dk-cite! 'rr-recip-inverse nx)
  (dk-have! (list '<= 0 (list 'recip nx))
            (lambda () (mac-h '< (list '< 0 (list 'recip nx))) (dk-split-all!) (ass))))

;;; ||0|| = 0
(sp (make-wff (forall-guarded '(v w) cnvd-C2 '(= (CNVS-OPNORM v w (CBOP-ZERO v w)) 0))))
(dk-peel!)
(set! cnvd-v 'w)
(let ((z '(CBOP-ZERO v w)))
  (dk-cite! 'cbop-zero-bounded 'v 'w)
  (cnvd-spec! z)
  (dk-have! '(IN 0 RR) (lambda () (arith)))
  (dk-have! '(<= 0 0) (lambda () (arith)))
  (dk-have! (cnvd-ub 'v 'w z 0)
    (lambda ()
      (dk-peel!)
      (let ((x (cadr (caddr (caddr (dk-goal))))))
        (subst (dk-cite! 'cbop-zero-apply 'v 'w x))
        (subst (dk-cite! 'nvs-vnrm-vzero-cnvs-as-nvs 'w))
        (cnvd-nt! 'v x)
        (dk-ineq! (list 'IN (list (list 'VNRM 'v) x) 'RR)))))
  (dk-apply! (cnvd-least z) 0)
  (cnvd-antisym! (cnvd-opn z) 0)
  (ass))
(cnvd-qed! 'cnvs-opnorm-zero)

;;; ||T|| = 0 => T = 0
(sp (make-wff (forall-guarded '(v w t_) (append cnvd-C2 '((IN t_ (CNVS-BOUNDED-OPS v w)) (= (CNVS-OPNORM v w t_) 0)))
   '(= t_ (CBOP-ZERO v w)))))
(dk-peel!)
(set! cnvd-v 'w)
(set! cnvd-atoms '(t_))
(cnvd-optype! 't_) (cnvd-optype! '(CBOP-ZERO v w))
(cnvd-opn-facts! 't_)
(let ((lb (cnvd-bound-of 't_)))
  (dk-fun-ext! 't_ '(CBOP-ZERO v w) '(VEC v) '(VEC w) #f #f
    (lambda (x)
      (cnvd-unapp!)
      (let* ((tx (list 't_ x)) (ntx (list (list 'VNRM 'w) tx)) (nx (list (list 'VNRM 'v) x))
             (h (dk-apply! lb x))
             (h2 (dk-rewrite-h! h (cnvd-opn 't_) 0)))
        (cnvd-wt! tx)
        (cnvd-nt! 'v x) (cnvd-nt! 'w tx)
        (dk-have! (list '= ntx 0)
          (lambda () (dk-have! (list '<= ntx 0) (lambda () (dk-ineq! h2 (list 'IN nx 'RR) (list 'IN ntx 'RR))))
                     (cnvd-antisym! ntx 0) (ass)))
        (dk-cite! 'cnvd-norm-zero-vector 'w tx)
        (ass)))))
(cnvd-qed! 'cnvs-opnorm-zero-imp)

(sp (make-wff (forall-guarded '(v w t_) (append cnvd-C2 '((IN t_ (CNVS-BOUNDED-OPS v w))))
   '(IFF (= (CNVS-OPNORM v w t_) 0) (= t_ (CBOP-ZERO v w))))))
(dk-peel!)
(dk-iff! (lambda (g) (equal? g '(= t_ (CBOP-ZERO v w))))
  (lambda () (dk-cite! 'cnvs-opnorm-zero-imp 'v 'w 't_) (ass))
  (lambda () (subst '(= t_ (CBOP-ZERO v w))) (dk-cite! 'cnvs-opnorm-zero 'v 'w) (ass)))
(cnvd-qed! 'cnvs-opnorm-definite)

;;; ||S + T|| <= ||S|| + ||T||
(sp (make-wff (forall-guarded '(v w s_ t_) (append cnvd-C2 '((IN s_ (CNVS-BOUNDED-OPS v w)) (IN t_ (CNVS-BOUNDED-OPS v w))))
   '(<= (CNVS-OPNORM v w (CBOP-SUM v w s_ t_)) (+ (CNVS-OPNORM v w s_) (CNVS-OPNORM v w t_))))))
(dk-peel!)
(set! cnvd-v 'w)
(let* ((op '(CBOP-SUM v w s_ t_)) (m1 (cnvd-opn 's_)) (m2 (cnvd-opn 't_)) (mm (list '+ m1 m2)))
  (cnvd-optype! op)
  (cnvd-opn-facts! 's_) (cnvd-opn-facts! 't_)
  (let ((l1 (cnvd-bound-of 's_)) (l2 (cnvd-bound-of 't_)))
    (dk-cite! 'rr-add-in-rr m1 m2)
    (dk-have! (list '<= 0 mm) (lambda () (dk-ineq! (list 'IN m1 'RR) (list 'IN m2 'RR) (list '<= 0 m1) (list '<= 0 m2))))
    (dk-have! (cnvd-ub 'v 'w op mm)
      (lambda ()
        (dk-peel!)
        (let* ((x (cadr (caddr (caddr (dk-goal)))))
               (sx (list 's_ x)) (tx (list 't_ x)) (st (list '(VADD w) sx tx)) (nx (list (list 'VNRM 'v) x)))
          (cnvd-wt! st)
          (subst (dk-cite! 'cbop-sum-apply 'v 'w 's_ 't_ x))
          (dk-cite! 'nvs-vnrm-triangle-cnvs-as-nvs 'w sx tx)
          (cnvd-nt! 'v x) (cnvd-nt! 'w sx) (cnvd-nt! 'w tx) (cnvd-nt! 'w st)
          (dk-apply! l1 x) (dk-apply! l2 x)
          (dk-have! (list '= (list '* mm nx) (list '+ (list '* m1 nx) (list '* m2 nx))) (lambda () (crs)))
          (cnvd-lin! (list (list 'IN (list (list 'VNRM 'w) st) 'RR) (list 'IN (list (list 'VNRM 'w) sx) 'RR)
                          (list 'IN (list (list 'VNRM 'w) tx) 'RR) (list 'IN nx 'RR) (list 'IN m1 'RR) (list 'IN m2 'RR)
                          (list 'IN mm 'RR))
                    (list (list '<= (list (list 'VNRM 'w) st) (list '+ (list (list 'VNRM 'w) sx) (list (list 'VNRM 'w) tx)))
                          (list '<= (list (list 'VNRM 'w) sx) (list '* m1 nx))
                          (list '<= (list (list 'VNRM 'w) tx) (list '* m2 nx))
                          (list '= (list '* mm nx) (list '+ (list '* m1 nx) (list '* m2 nx))))))))
    (cnvd-spec! op)
    (dk-apply! (cnvd-least op) mm)
    (ass)))
(cnvd-qed! 'cnvs-opnorm-triangle)

;;; ||-T|| = ||T||
(sp (make-wff (forall-guarded '(v w t_) (append cnvd-C2 '((IN t_ (CNVS-BOUNDED-OPS v w))))
   '(= (CNVS-OPNORM v w (CBOP-NEG v w t_)) (CNVS-OPNORM v w t_)))))
(dk-peel!)
(set! cnvd-v 'w)
(let* ((op '(CBOP-NEG v w t_)) (n (cnvd-opn 't_)) (n2 (cnvd-opn op)))
  (cnvd-optype! op)
  (cnvd-opn-facts! 't_) (cnvd-opn-facts! op)
  (let ((l1 (cnvd-bound-of 't_)) (l2 (cnvd-bound-of op)))
    (dk-have! (cnvd-ub 'v 'w op n)
      (lambda ()
        (dk-peel!)
        (let* ((x (cadr (caddr (caddr (dk-goal))))) (tx (list 't_ x)))
          (cnvd-wt! tx)
          (subst (dk-cite! 'cbop-neg-apply 'v 'w 't_ x))
          (subst (dk-cite! 'cnvd-norm-vneg 'w tx))
          (dk-apply! l1 x)
          (ass))))
    (dk-have! (cnvd-ub 'v 'w 't_ n2)
      (lambda ()
        (dk-peel!)
        (let* ((x (cadr (caddr (caddr (dk-goal))))) (tx (list 't_ x)) (ntx (list '(VNEG w) tx)))
          (cnvd-wt! tx)
          (dk-cite! 'cbop-neg-apply 'v 'w 't_ x)
          (cnvd-wt! ntx)
          (dk-cite! 'cnvd-norm-vneg 'w tx)
          (let* ((h (dk-apply! l2 x))
                 (h2 (dk-rewrite-h! h (list op x) ntx))
                 (h3 (dk-rewrite-h! h2 (list (list 'VNRM 'w) ntx) (list (list 'VNRM 'w) tx))))
            (ass)))))
    (cnvd-spec! op)
    (dk-apply! (cnvd-least op) n)
    (cnvd-spec! 't_)
    (dk-apply! (cnvd-least 't_) n2)
    (cnvd-antisym! n2 n)
    (ass)))
(cnvd-qed! 'cnvs-opnorm-neg)


;;; ||c T|| = |c| ||T||
(sp (make-wff (forall-guarded '(v w c_ t_) (append cnvd-C2 '((IN c_ CC) (IN t_ (CNVS-BOUNDED-OPS v w))))
   '(= (CNVS-OPNORM v w (CBOP-SCALE v w c_ t_)) (* (magnitude c_) (CNVS-OPNORM v w t_))))))
(dk-peel!)
(set! cnvd-v 'w)
(let* ((op '(CBOP-SCALE v w c_ t_)) (n (cnvd-opn 't_)) (p (cnvd-opn op)) (mc '(magnitude c_)) (mn (list '* mc n)))
  (cnvd-optype! op)
  (cnvd-opn-facts! 't_) (cnvd-opn-facts! op)
  (dk-cite! 'cc-magnitude-closed 'c_) (dk-cite! 'cc-magnitude-nonneg 'c_)
  (dk-cite! 'rr-mul-in-rr mc n)
  (cnvd-have-and! (list 'IN mc 'RR) (list 'IN n 'RR))
  (cnvd-have-and! (list '<= 0 mc) (list '<= 0 n))
  (dk-cite! 'rr-leq-mul-nonneg mc n)
  (let ((l1 (cnvd-bound-of 't_)) (l2 (cnvd-bound-of op)))
    ;; (<=) |c| ||T|| bounds c T
    (dk-have! (cnvd-ub 'v 'w op mn)
      (lambda ()
        (dk-peel!)
        (let* ((x (cadr (caddr (caddr (dk-goal))))) (tx (list 't_ x))
               (nx (list (list 'VNRM 'v) x)) (ntx (list (list 'VNRM 'w) tx)))
          (cnvd-wt! tx)
          (subst (dk-cite! 'cbop-scale-apply 'v 'w 'c_ 't_ x))
          (subst (dk-cite! 'cnvs-vnrm-cact 'w 'c_ tx))
          (cnvd-nt! 'v x) (cnvd-nt! 'w tx)
          (dk-apply! l1 x)
          (dk-cite! 'rr-mul-in-rr n nx)
          (dk-cite! 'rr-mul-le-right ntx (list '* n nx) mc)
          (dk-have! (list '= (list '* mc ntx) (list '* ntx mc)) (lambda () (crs)))
          (dk-have! (list '= (list '* (list '* n nx) mc) (list '* mn nx)) (lambda () (crs)))
          (cnvd-lin! (list (list 'IN ntx 'RR) (list 'IN nx 'RR) (list 'IN mc 'RR) (list 'IN n 'RR))
                    (list (list '<= (list '* ntx mc) (list '* (list '* n nx) mc))
                          (list '= (list '* mc ntx) (list '* ntx mc))
                          (list '= (list '* (list '* n nx) mc) (list '* mn nx)))))))
    (cnvd-spec! op)
    (dk-apply! (cnvd-least op) mn)
    ;; (>=)
    (use-em '(= c_ 0)
      (lambda ()
        (dk-have! (list '= mc 0) (lambda () (subst '(= c_ 0)) (dk-cite! 'cc-magnitude-zero) (ass)))
        (dk-have! (list '= mn 0) (lambda () (subst (list '= mc 0)) (crs)))
        (dk-have! (list '<= mn p) (lambda () (dk-ineq! (list '= mn 0) (list '<= 0 p) (list 'IN p 'RR) (list 'IN mn 'RR))))
        (cnvd-antisym! p mn) (ass))
      (lambda ()
        (dk-cite! 'cc-magnitude-zero-iff 'c_)
        (dk-have! (list 'NOT (list '= mc 0))
          (lambda () (dk-only! (iff-for (list '= mc 0)) '(NOT (= c_ 0))) (prop)))
        (cnvd-recip-pos! mc)
        (let ((q (list 'recip mc)) (pq (list '* p (list 'recip mc))))
          (dk-cite! 'rr-mul-in-rr p q)
          (cnvd-have-and! (list 'IN p 'RR) (list 'IN q 'RR))
          (cnvd-have-and! (list '<= 0 p) (list '<= 0 q))
          (dk-cite! 'rr-leq-mul-nonneg p q)
          (dk-have! (cnvd-ub 'v 'w 't_ pq)
            (lambda ()
              (dk-peel!)
              (let* ((x (cadr (caddr (caddr (dk-goal))))) (tx (list 't_ x))
                     (nx (list (list 'VNRM 'v) x)) (ntx (list (list 'VNRM 'w) tx)) (mt (list '* mc ntx)))
                (cnvd-wt! tx)
                (cnvd-nt! 'v x) (cnvd-nt! 'w tx)
                (dk-cite! 'cbop-scale-apply 'v 'w 'c_ 't_ x)
                (cnvd-wt! (list '(CACT w) 'c_ tx))
                (dk-cite! 'cnvs-vnrm-cact 'w 'c_ tx)
                (let* ((h (dk-apply! l2 x))
                       (h2 (dk-rewrite-h! h (list op x) (list '(CACT w) 'c_ tx)))
                       (h3 (dk-rewrite-h! h2 (list (list 'VNRM 'w) (list '(CACT w) 'c_ tx)) mt)))
                  (dk-cite! 'rr-mul-in-rr mc ntx)
                  (dk-cite! 'rr-mul-in-rr p nx)
                  (dk-cite! 'rr-mul-le-right mt (list '* p nx) q)
                  (let ((e1 (list '= (list '* mt q) (list '* (list '* mc q) ntx)))
                        (e2 (list '= (list '* mt q) ntx))
                        (e3 (list '= (list '* (list '* p nx) q) (list '* pq nx))))
                    (dk-have! e1 (lambda () (crs)))
                    (dk-have! e2 (lambda () (subst e1) (subst (list '= (list '* mc q) 1)) (crs)))
                    (dk-have! e3 (lambda () (crs)))
                    (cnvd-lin! (list (list 'IN ntx 'RR) (list 'IN nx 'RR) (list 'IN mc 'RR) (list 'IN p 'RR)
                                    (list 'IN q 'RR))
                              (list (list '<= (list '* mt q) (list '* (list '* p nx) q)) e2 e3)))))))
          (cnvd-spec! 't_)
          (dk-apply! (cnvd-least 't_) pq)
          (dk-cite! 'rr-mul-le-right n pq mc)
          (let ((e4 (list '= (list '* pq mc) p)) (e5 (list '= mn (list '* n mc))))
            (dk-have! e4 (lambda () (dk-have! (list '= (list '* pq mc) (list '* p (list '* mc q))) (lambda () (crs)))
                                    (subst (list '= (list '* pq mc) (list '* p (list '* mc q))))
                                    (subst (list '= (list '* mc q) 1)) (crs)))
            (dk-have! e5 (lambda () (crs)))
            (dk-have! (list '<= mn p)
              (lambda () (cnvd-lin! (list (list 'IN n 'RR) (list 'IN mc 'RR) (list 'IN p 'RR) (list 'IN pq 'RR))
                                   (list (list '<= (list '* n mc) (list '* pq mc)) e4 e5))))
            (cnvd-antisym! p mn) (ass)))))))
(cnvd-qed! 'cnvs-opnorm-scale)

