;;; d(c a, c b) <= |c| d(a, b) in w
(sp (make-wff (forall-guarded '(w c_ a_ b_)
   '((IS-COMPLEX-NORMED-VECTOR-SPACE w) (IN c_ CC) (IN a_ (VEC w)) (IN b_ (VEC w)))
   (list '<= (cnvd-dw '((CACT w) c_ a_) '((CACT w) c_ b_)) (list '* '(magnitude c_) (cnvd-dw 'a_ 'b_))))))
