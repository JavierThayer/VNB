;;; d(a + b, c + d) <= d(a, c) + d(b, d) in w
(sp (make-wff (forall-guarded '(w a_ b_ c_ e_)
   '((IS-COMPLEX-NORMED-VECTOR-SPACE w) (IN a_ (VEC w)) (IN b_ (VEC w)) (IN c_ (VEC w)) (IN e_ (VEC w)))
