;;; ipf-form-plus.scm -- H_Q+ IS A COMPLEX INNER PRODUCT SPACE (BanachAlgebras.pdf ch. 3, the space of
;;; Prop 3.16 / 3.17): the instance of cips-of-inner-product-form at FORM-PLUS-SPACE.
;;; Agent BA-1111-A2, 2026-11-11.  Destination: theorem-library/ipf-form-plus.scm.  Library:
;;; operator-algebras (FORM-PLUS-SPACE is ba-unbdd-vocab's).  Helper prefix fps-.
;;;
;;;   form-plus-module-{scal,vec,vadd,vzero,vneg,act}  the read-offs of the module view of SUB-CIPS(v, dd)
;;;   form-plus-space-as-module-with-form              FORM-PLUS-SPACE(v, dd, q) ==
;;;                                                    MODULE-WITH-FORM(CIPS-AS-MODULE(SUB-CIPS(v, dd)), FORM-PLUS(v, dd, q))
;;;   form-plus-inner-product-form                     Q+ is an inner product form on that module
;;;   form-plus-space-is-cips                          IS-POSITIVE-FORM(v, dd, q) gives
;;;                                                    IS-COMPLEX-INNER-PRODUCT-SPACE(FORM-PLUS-SPACE(v, dd, q))
;;;
;;; The module is the subspace dd of v with v's operations (SUB-CIPS, th3a2-vocab, and its module view):
;;; sub-cips-is-cips makes it a module, and the only work is the form: Q+(x, y) = Q(x, y) + <x | y> is
;;; sesquilinear and hermitian because Q and <.|.> are, real and >= 0 on the diagonal because both
;;; terms are, and definite because <x | x> alone is.
;;;
;;; LOAD WINDOW: after theorem-library/ipf-laws (cips-of-inner-product-form), theorem-library/th3a2-compact
;;; (sub-cips-is-cips and the sub-cips-* read-offs), structure-library/ba-unbdd-vocab.

(define (fps-open?) (pair? (dk-open-leaves)))
(define (fps-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; FPS OPEN ") (display (expression->string (dk-goal-of l))) (newline)
                  (for-each (lambda (a) (display ";;    asm ") (display (expression->string a)) (newline)) (dk-asms-of l)))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))
(define fps-R '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define fps-S '(SUB-CIPS v dd))
(define fps-M '(COMPLEX-INNER-PRODUCT-SPACE-AS-MODULE (SUB-CIPS v dd)))
(define fps-FP '(FORM-PLUS v dd q))
(define fps-H '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-SUBMODULE v dd)))
(define (fps-has-head? h e)
  (and (pair? e) (or (eq? (car e) h) (fps-has-head? h (car e))
                     (let loop ((l (cdr e))) (and (pair? l) (or (fps-has-head? h (car l)) (loop (cdr l))))))))
(define (fps-has-subterm? t e)
  (or (equal? t e) (and (pair? e) (let loop ((l e)) (and (pair? l) (or (fps-has-subterm? t (car l)) (loop (cdr l))))))))
(define (fps-owed-rfl!)
  (let loop ((fuel 12))
    (let ((k (find-first (lambda (n) (let ((g (dk-goal-of n))) (and (dk-head-is? g '=) (equal? (cadr g) (caddr g)))))
                         (dk-open-leaves))))
      (if (and k (> fuel 0)) (begin (dk-focus! k) (rfl) (loop (- fuel 1)))))))

(define (fps-base!)
  (if (not (dk-asm? '(SUBSET dd (VEC v)))) (dk-cite! 'submodule-subset 'v 'dd))
  (if (not (dk-asm? '(IN dd SET)))
      (begin (dk-cite! 'cips-vec-set 'v) (dk-cite! 'subclass-of-set-is-set 'dd '(VEC v))))
  (if (not (dk-asm? '(IN CC SET))) (fact 'cc-is-set))
  (if (not (dk-asm? '(IS-NORMED-FIELD CC-NORMED-FIELD))) (fact 'cc-is-normed-field))
  (if (not (dk-asm? (list 'IS-COMMUTATIVE-RING fps-R)))
      (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD))
  (if (not (dk-asm? (list 'IS-COMPLEX-INNER-PRODUCT-SPACE fps-S))) (dk-cite! 'sub-cips-is-cips 'v 'dd))
  (if (not (dk-asm? (list 'IS-MODULE fps-M)))
      (dk-cite! 'complex-inner-product-space-as-module-is-module fps-S)))

;;; normalise both sides of an == by reducing ACC to its projection through the view and SUB-CIPS
(define (fps-normalise! accs)
  (let loop ((fuel 8))
    (if (and (> fuel 0) (fps-open?))
        (let ((g0 (dk-goal)))
          (for-each (lambda (a) (if (and (fps-open?) (fps-has-head? a (dk-goal))) (slot a))) accs)
          (if (and (fps-open?) (fps-has-head? 'COMPLEX-INNER-PRODUCT-SPACE-AS-MODULE (dk-goal)))
              (mac 'COMPLEX-INNER-PRODUCT-SPACE-AS-MODULE))
          (if (and (fps-open?) (fps-has-head? 'SUB-CIPS (dk-goal))) (mac 'SUB-CIPS))
          (if (and (fps-open?) (fps-has-head? 'NTH (dk-goal))) (nth-r))
          (if (and (fps-open?) (not (equal? (dk-goal) g0))) (loop (- fuel 1)))))))
(define fps-accs '(SCAL VEC VADD VZERO VNEG ACT IP))
(define fps-sub-ro '((SCAL . sub-cips-scal) (VEC . sub-cips-vec) (VADD . sub-cips-vadd) (VZERO . sub-cips-vzero)
                     (VNEG . sub-cips-vneg) (ACT . sub-cips-act)))

;;; ---- the read-offs of the module view of SUB-CIPS(v, dd) -------------------------------------
(define (fps-read-off! name acc val)
  (sp (make-wff (forall-guarded '(v dd) fps-H (list '== (list acc fps-M) val))))
  (dk-peel!)
  (fps-base!)
  (slot acc)
  (mac 'COMPLEX-INNER-PRODUCT-SPACE-AS-MODULE)
  (nth-r)
  (subst (dk-cite! (cdr (assq acc fps-sub-ro)) 'v 'dd))
  (let loop ((fuel 3))
    (if (and (> fuel 0) (fps-open?) (fps-has-head? acc (dk-goal))) (begin (slot acc) (loop (- fuel 1)))))
  (if (fps-open?) (qrfl))
  (fps-owed-rfl!)
  (fps-qed! name))
(fps-read-off! 'form-plus-module-scal 'SCAL fps-R)
(fps-read-off! 'form-plus-module-vec 'VEC 'dd)
(fps-read-off! 'form-plus-module-vadd 'VADD '(VNB-LAMBDA (LIST tsbx_ tsby_) (CARTESIAN dd dd) ((VADD v) tsbx_ tsby_)))
(fps-read-off! 'form-plus-module-vzero 'VZERO '(VZERO v))
(fps-read-off! 'form-plus-module-vneg 'VNEG '(VNB-LAMBDA tsbx_ dd ((VNEG v) tsbx_)))
(fps-read-off! 'form-plus-module-act 'ACT '(VNB-LAMBDA (LIST tsbc_ tsbx_) (CARTESIAN CC dd) ((ACT v) tsbc_ tsbx_)))
(define fps-readoffs '(form-plus-module-scal form-plus-module-vec form-plus-module-vadd form-plus-module-vzero
                       form-plus-module-vneg form-plus-module-act))

;;; ---- FORM-PLUS-SPACE is MODULE-WITH-FORM of that module ------------------------------------
(sp (make-wff (forall-guarded '(v dd q) fps-H
  (list '== '(FORM-PLUS-SPACE v dd q) (list 'MODULE-WITH-FORM fps-M fps-FP)))))
(dk-peel!)
(fps-base!)
(mac 'MODULE-WITH-FORM)
(for-each (lambda (ro) (subst (dk-cite! ro 'v 'dd))) fps-readoffs)
(mac 'FORM-PLUS-SPACE)
(if (fps-open?) (qrfl))
(fps-owed-rfl!)
(fps-qed! 'form-plus-space-as-module-with-form)

;;; ---- typing in dd, in VEC v, in CC ----------------------------------------------------------
(define (fps-cscal! c)                ; c in CC => c in CARR(SCAL v)
  (let ((g (list 'IN c '(CARR (SCAL v)))))
    (if (not (dk-asm? g))
        (begin (dk-cite! 'cips-scal-carrier 'v)
               (dk-have! g (lambda () (subst '(= (CARR (SCAL v)) CC)) (ass)))))))
(define (fps-dt! e)                   ; land (IN e dd)
  (let ((g (list 'IN e 'dd)))
    (cond ((dk-asm? g) g)
          ((equal? e '(VZERO v)) (dk-cite! 'submodule-vzero-in 'v 'dd) g)
          ((and (pair? e) (equal? (car e) '(VADD v)))
           (fps-dt! (cadr e)) (fps-dt! (caddr e)) (dk-cite! 'submodule-vadd-closed 'v 'dd (cadr e) (caddr e)) g)
          ((and (pair? e) (equal? (car e) '(VNEG v)))
           (fps-dt! (cadr e)) (dk-cite! 'submodule-vneg-closed 'v 'dd (cadr e)) g)
          ((and (pair? e) (equal? (car e) '(ACT v)))
           (fps-cscal! (cadr e)) (fps-dt! (caddr e)) (dk-cite! 'submodule-act-closed 'v 'dd (cadr e) (caddr e)) g)
          (#t (error "fps-dt!: no dd typing for" (expression->string e))))))
(define (fps-vv! e)                   ; land (IN e (VEC v)) for e in dd
  (let ((g (list 'IN e '(VEC v))))
    (if (not (dk-asm? g)) (begin (fps-dt! e) (dk-cite! 'subset-mem-fwd 'dd '(VEC v) e)))
    g))
(define (fps-ct! c)                   ; land (IN c CC)
  (let ((g (list 'IN c 'CC)))
    (cond ((dk-asm? g) g)
          ((and (pair? c) (equal? (car c) '(IP v)))
           (fps-vv! (cadr c)) (fps-vv! (caddr c)) (dk-cite! 'cips-ip-type 'v (cadr c) (caddr c)) g)
          ((and (pair? c) (eq? (car c) 'q) (= (length c) 3))
           (fps-dt! (cadr c)) (fps-dt! (caddr c))
           (dk-have! g (lambda ()
             (dk-cite! 'pair-in-cartesian 'dd 'dd (cadr c) (caddr c))
             (dk-cite! 'fun-apply-type-c 'q '(CARTESIAN dd dd) 'CC (list 'LIST (cadr c) (caddr c)))
             (subst (dk-cite! 'apply-tupling-2 'q (cadr c) (caddr c)))
             (dk-ass!)))
           g)
          ((and (pair? c) (memq (car c) '(+ *)) (= (length c) 3))
           (fps-ct! (cadr c)) (fps-ct! (caddr c))
           (dk-have! (list 'AND (list 'IN (cadr c) 'CC) (list 'IN (caddr c) 'CC)) (lambda () (dk-conj-close! dk-ass!)))
           (dk-cite! (if (eq? (car c) '*) 'cc-mul-closed 'cc-add-closed) (cadr c) (caddr c)) g)
          ((and (pair? c) (eq? (car c) 'conjugate))
           (fps-ct! (cadr c)) (dk-cite! 'cc-conjugate-closed (cadr c)) g)
          (#t (dk-have! g (lambda () (type-term))) g))))

;;; type every q- and IP-application in an expression
(define (fps-type-scalars! e)
  (cond ((not (pair? e)) #t)
        ((and (or (eq? (car e) 'q) (equal? (car e) '(IP v))) (= (length e) 3)) (fps-ct! e))
        (#t (for-each fps-type-scalars! e))))

;;; the laws of Q, as they land from IS-QUADRATIC-FORM (binders of ba-unbdd-vocab)
(define fps-q-add
  '(FORALL ubx_ (IMPLIES (IN ubx_ dd) (FORALL uby_ (IMPLIES (IN uby_ dd) (FORALL ubz_ (IMPLIES (IN ubz_ dd)
     (= (q ((VADD v) ubx_ uby_) ubz_) (+ (q ubx_ ubz_) (q uby_ ubz_))))))))))
(define fps-q-homog
  '(FORALL ubk_ (IMPLIES (IN ubk_ CC) (FORALL ubx_ (IMPLIES (IN ubx_ dd) (FORALL uby_ (IMPLIES (IN uby_ dd)
     (= (q ((ACT v) ubk_ ubx_) uby_) (* ubk_ (q ubx_ uby_))))))))))
(define fps-q-herm
  '(FORALL ubx_ (IMPLIES (IN ubx_ dd) (FORALL uby_ (IMPLIES (IN uby_ dd) (= (q uby_ ubx_) (conjugate (q ubx_ uby_))))))))
(define fps-q-pos
  '(FORALL ubx_ (IMPLIES (IN ubx_ dd) (AND (IN (q ubx_ ubx_) RR) (<= 0 (q ubx_ ubx_))))))
(define (fps-need! f) (if (not (dk-asm? f)) (error "fps: expected in context" (expression->string f))) f)

;;; beta every redex, typing first what the redexes owe
(define (fps-has-lam? g)
  (and (pair? g) (or (and (pair? (car g)) (eq? (caar g) 'VNB-LAMBDA))
                     (let loop ((l g)) (and (pair? l) (or (fps-has-lam? (car l)) (loop (cdr l))))))))
(define (fps-beta!) (if (and (fps-open?) (fps-has-lam? (dk-goal))) (dk-lam-b!)))
;;; Q+ at typed points: unfold FORM-PLUS and beta (the arguments typed in dd first)
(define (fps-args-of-fp e acc)
  (cond ((not (pair? e)) acc)
        ((and (equal? (car e) fps-FP) (= (length e) 3)) (cons (cadr e) (cons (caddr e) acc)))
        (#t (fold-left (lambda (a x) (fps-args-of-fp x a)) acc e))))
(define (fps-open-fp!)
  (for-each fps-dt! (fps-args-of-fp (dk-goal) '()))
  (if (fps-has-head? 'FORM-PLUS (dk-goal)) (mac 'FORM-PLUS))
  (fps-beta!))

;;; ---- Q+ is an inner product form on the module ---------------------------------------------
(sp (make-wff (forall-guarded '(v dd q) (append fps-H '((IS-POSITIVE-FORM v dd q)))
  (list 'IS-INNER-PRODUCT-FORM fps-M fps-FP))))
(dk-peel!)
(fps-base!)
(mac-h 'is-positive-form '(IS-POSITIVE-FORM v dd q)) (dk-split-all!)
(mac-h 'is-quadratic-form '(IS-QUADRATIC-FORM v dd q)) (dk-split-all!)
(mac 'IS-INNER-PRODUCT-FORM) (mac 'IS-PSD-FORM) (mac 'IS-HERMITIAN-FORM)
(for-each (lambda (pr) (if (fps-has-subterm? (car pr) (dk-goal)) (subst (dk-cite! (cdr pr) 'v 'dd))))
          (list (cons (list 'VEC fps-M) 'form-plus-module-vec) (cons (list 'VADD fps-M) 'form-plus-module-vadd)
                (cons (list 'VZERO fps-M) 'form-plus-module-vzero) (cons (list 'VNEG fps-M) 'form-plus-module-vneg)
                (cons (list 'ACT fps-M) 'form-plus-module-act)))
(define (fps-peel!)
  (let loop ()
    (if (and (fps-open?) (memq (dk-head (dk-goal)) '(FORALL IMPLIES))) (begin (di) (loop)))))
(define (fps-law!)
  (let ((g (dk-goal)))
    (cond
      ((dk-asm? g) (ass))
      ((and (dk-head-is? g 'IN) (equal? (cadr g) fps-FP))          ; the typing of Q+
       (mac 'FORM-PLUS)
       (dk-lam-type! (lambda ()
                       (fps-peel!)
                       (fps-beta!)
                       (fps-type-scalars! (dk-goal))
                       (fps-ct! (cadr (dk-goal)))
                       (dk-close-if-asm!))))
      (#t
       (fps-peel!)
       (fps-beta!)                                                 ; the operations of dd
       (fps-open-fp!)                                              ; Q+ at the points
       (let ((g (dk-goal)))
         (fps-type-scalars! g)
         (cond
           ((dk-head-is? g '=)                                     ; a sesquilinearity / symmetry law
            (let ()
              (cond
                ;; additivity
                ((and (pair? (cadr g)) (eq? (car (cadr g)) '+) (pair? (cadr (cadr g)))
                      (pair? (cadr (cadr (cadr g)))) (equal? (car (cadr (cadr (cadr g)))) '(VADD v)))
                 (let* ((qa (cadr (cadr g))) (s (cadr qa)) (z (caddr qa)) (a (cadr s)) (b (caddr s)))
                   (for-each fps-vv! (list a b z))
                   (subst (dk-apply! (fps-need! fps-q-add) a b z))
                   (subst (dk-cite! 'cips-ip-add-left 'v a b z))
                   (fps-type-scalars! (dk-goal))
                   (crs)))
                ;; homogeneity
                ((and (pair? (cadr g)) (eq? (car (cadr g)) '+) (pair? (cadr (cadr g)))
                      (pair? (cadr (cadr (cadr g)))) (equal? (car (cadr (cadr (cadr g)))) '(ACT v)))
                 (let* ((qa (cadr (cadr g))) (s (cadr qa)) (y (caddr qa)) (k (cadr s)) (x (caddr s)))
                   (for-each fps-vv! (list x y))
                   (subst (dk-apply! (fps-need! fps-q-homog) k x y))
                   (subst (dk-cite! 'cips-ip-homog-left 'v k x y))
                   (fps-type-scalars! (dk-goal))
                   (crs)))
                ;; conjugate symmetry: q(y,x) + <y,x> = conj(q(x,y) + <x,y>)
                ((dk-head-is? (caddr g) 'conjugate)
                 (let* ((qa (cadr (cadr g))) (y (cadr qa)) (x (caddr qa)))
                   (for-each fps-vv! (list x y))
                   (fps-ct! (list 'q x y)) (fps-ct! (list '(IP v) x y))
                   (dk-have! (list 'AND (list 'IN (list 'q x y) 'CC) (list 'IN (list '(IP v) x y) 'CC)) (lambda () (dk-conj-close! dk-ass!)))
                   (subst (dk-cite! 'cc-conjugate-add (list 'q x y) (list '(IP v) x y)))
                   (subst (dk-apply! (fps-need! fps-q-herm) x y))
                   (subst (dk-cite! 'cips-ip-conj-sym 'v x y))
                   (dk-close-if! (lambda () #t) (lambda () (rfl)))))
                (#t (error "fps-law!: unexpected equation" (expression->string g))))))
           ((and (dk-head-is? g 'IN) (eq? (caddr g) 'RR))            ; q(x,x) + <x,x> in RR
            (let* ((s (cadr g)) (qa (cadr s)) (x (cadr qa)))
              (fps-vv! x)
              (dk-split! (dk-apply! (fps-need! fps-q-pos) x))
              (dk-cite! 'cips-ip-self-real 'v x)
              (dk-cite! 'rr-add-in-rr (cadr s) (caddr s))
              (dk-close-if-asm!)))
           ((dk-head-is? g '<=)                                      ; 0 <= q(x,x) + <x,x>
            (let* ((s (caddr g)) (qa (cadr s)) (x (cadr qa)))
              (fps-vv! x)
              (dk-split! (dk-apply! (fps-need! fps-q-pos) x))
              (dk-cite! 'cips-ip-self-real 'v x)
              (dk-cite! 'cips-ip-self-nonneg 'v x)
              (dk-ineq! (list 'IN (cadr s) 'RR) (list 'IN (caddr s) 'RR) (list '<= 0 (cadr s)) (list '<= 0 (caddr s)))))
           (#t (error "fps-law!: unexpected goal" (expression->string g)))))))))
;;; the definiteness conjunct: q(x,x) + <x,x> = 0 => x = 0
(define (fps-definite!)
  (di)
  (if (not (dk-head-is? (dk-goal) 'IMPLIES)) (error "fps-definite!: expected an implication" (expression->string (dk-goal))))
  (fps-open-fp!)
  (di)
  (let* ((h (find-first (lambda (f) (and (dk-head-is? f '=) (pair? (cadr f)) (eq? (car (cadr f)) '+))) (dk-asms)))
         (s (cadr h)) (qa (cadr s)) (ia (caddr s)) (x (cadr qa)))
    (fps-vv! x)
    (dk-split! (dk-apply! (fps-need! fps-q-pos) x))
    (dk-cite! 'cips-ip-self-real 'v x)
    (dk-cite! 'cips-ip-self-nonneg 'v x)
    (dk-have! (list '<= ia 0) (lambda () (dk-ineq! (list 'IN qa 'RR) (list 'IN ia 'RR) (list '<= 0 qa) h)))
    (dk-have! '(IN 0 RR) (lambda () (arith)))
    (dk-have! (list 'AND (list 'IN ia 'RR) '(IN 0 RR)) (lambda () (dk-conj-close! dk-ass!)))
    (dk-have! (list 'AND (list '<= ia 0) (list '<= 0 ia)) (lambda () (dk-conj-close! dk-ass!)))
    (dk-cite! 'rr-leq-antisymmetric ia 0)
    (let ((iff (dk-cite! 'cips-ip-definite 'v x)))
      (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))))
    (dk-close-if-asm!)))
(dk-conj-close! (lambda ()
  (if (fps-open?)
      (let ((g (dk-goal)))
        (if (and (dk-head-is? g 'FORALL) (fps-has-head? 'VZERO g) (not (fps-has-head? 'VADD g)))
            (fps-definite!)
            (fps-law!))))))
(fps-owed-rfl!)
(fps-qed! 'form-plus-inner-product-form)

;;; ---- THE THEOREM -----------------------------------------------------------------------------
(sp (make-wff (forall-guarded '(v dd q) (append fps-H '((IS-POSITIVE-FORM v dd q)))
  '(IS-COMPLEX-INNER-PRODUCT-SPACE (FORM-PLUS-SPACE v dd q)))))
(dk-peel!)
(fps-base!)
(dk-cite! 'form-plus-inner-product-form 'v 'dd 'q)
(dk-have! (list '= (list 'SCAL fps-M) fps-R)
  (lambda () (subst (dk-cite! 'form-plus-module-scal 'v 'dd)) (dk-close-if! (lambda () #t) (lambda () (rfl)))))
(dk-cite! 'cips-of-inner-product-form fps-M fps-FP)
(subst (dk-cite! 'form-plus-space-as-module-with-form 'v 'dd 'q))
(dk-close-if-asm!)
(fps-owed-rfl!)
(fps-qed! 'form-plus-space-is-cips)
