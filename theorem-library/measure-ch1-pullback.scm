;;; (0) the ma- kit (file-local; most from push-forward.scm's pfw- kit and product-measure.scm's pms- kit)

(define (ma-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; dk-project!, except that a claim equal to the focus goal is proved in place
(define (ma-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
;;; sequential map (MIT evaluates arguments right to left)
(define (ma-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (ma-for-each f l) (let loop ((l l)) (if (pair? l) (begin (f (car l)) (loop (cdr l))))))
;;; the right-hand conjuncts of an IFF in context whose left side is in context, landed (by prop, on a lane)
(define (ma-iff-parts! iff0)
  (let* ((iff (or (dk-ctx-form iff0) (error "ma-iff-parts!: not in context" (expression->string iff0))))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    ;; the conjunct that is the focus goal (closed in place) goes LAST: closing it moves the focus
    (let* ((goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
           (late  (filter goal? cs))
           (early (filter (lambda (c) (not (goal? c))) cs)))
      (ma-map (lambda (c) (ma-by-prop! c (list iff (cadr iff)))) (append early late))
      cs)))
;;; the LEFT side of an IFF in context whose right side is in context, landed
(define (ma-iff-back! iff0)
  (let ((iff (or (dk-ctx-form iff0) (error "ma-iff-back!: not in context" (expression->string iff0)))))
    (ma-by-prop! (cadr iff)
      (cons iff (let ((r (caddr iff)))
                  (if (dk-asm? r)
                      (list r)
                      (let loop ((r r) (acc '()))
                        (if (and (pair? r) (eq? (car r) 'AND) (not (dk-asm? r)))
                            (loop (caddr r) (cons (cadr r) acc))
                            (reverse (cons r acc))))))))))
;;; CLAIM by prop from the formulas FS: on a lane, or in place when CLAIM is the focus goal; returns CLAIM
(define (ma-by-prop! claim fs)
  (cond ((dk-asm? claim) (dk-ctx-form claim))
        ((eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
         (ma-prop-with! fs) claim)
        (#t (dk-have! claim (lambda () (ma-prop-with! fs))) (dk-ctx-form claim))))
;;; (IN w (SEP v A P)) in context: land (IN w A) and P[w], the membership kept; return P[w].
(define (ma-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s (caddr m)) (v (cadr s)) (dom (caddr s))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "ma-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (let ((c (dk-ctx-form conj))) (if c (ai c)))))
    p))
;;; class extensionality, each direction driven: FWD / BWD procedures of the element; lands lhs = rhs
(define (ma-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'mew_ (list 'IFF (list 'IN 'mew_ lhs) (list 'IN 'mew_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs)
  (list '= lhs rhs))
;;; w in BIG-UNION(v, D, g(v)) gives the index and w in g(index): returns (k . formula)
(define (ma-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (caddr bu)))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
;;; prove the focus goal (IN w bu) at the index k (k in D and w in the k-th term in context)
(define (ma-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
;;; prop on the named formulas only
(define (ma-prop-with! fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))
;;; (IN z (UNION a b)) from (IN z a) / (IN z b) in context
(define (ma-in-union-left! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-l) (dk-ass!))))
(define (ma-in-union-right! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-r) (dk-ass!))))
;;; (IN x (PAIR x x)), x in SET in context
(define (ma-in-singleton! xv)
  (dk-have! (list 'IN xv (list 'PAIR xv xv))
    (lambda ()
      (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
      (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) xv)))
        (dk-have! (list '= xv xv) (lambda () (rfl)))
        (ma-prop-with! (list pm (list '= xv xv)))))))
;;; with (IN b (PAIR x x)) and x in SET in context, land b = x
(define (ma-singleton-eq! b xv)
  (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
  (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) b)))
    (dk-have! (list '= b xv)
      (lambda () (ma-prop-with! (list pm (list 'IN b (list 'PAIR xv xv))))))
    (list '= b xv)))

;;; FINITE-SET INDUCTION (pms-induct!, product-measure.scm).  PROP-OF builds P(s); BASE! proves P(EMPTY-SET)
;;; on its leaf; (STEP! sv xv u ih) proves P(u), u = sv u {xv}, with ih = P(sv) in context.  Returns P(xs).
(define (ma-class prop-of) (list 'COMP 'miu_ (prop-of 'miu_)))
(define (ma-step-formula c)
  (list 'FORALL 'is_
    (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ c)))
      (list 'FORALL 'ix_
        (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
          (list 'IN '(UNION is_ (PAIR ix_ ix_)) c))))))
(define (ma-induct! xs prop-of base! step!)
  (let* ((c     (ma-class prop-of))
         (stepf (ma-step-formula c)))
    (have! (list 'IN 'EMPTY-SET c)
      (lambda ()
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) '(in empty-set set))
                (begin (fact 'empty-set-is-set) (ass))
                (base!)))
          (dk-opened (lambda () (comp-mi))))))
    (have! stepf
      (lambda ()
        (let* ((landed (dk-peel!))
               (g      (dk-goal))
               (u      (cadr g))
               (sv     (cadr u))
               (xv     (cadr (caddr u))))
          (dk-split-all! landed)
          (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
          (fact 'pairing xv xv)
          (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET)))
          (fact 'union-set-closure sv (list 'PAIR xv xv))
          (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv c)))))
                 (ih (car (filter (lambda (f) (not (equal? f (list 'in sv 'set)))) ls))))
            (for-each
              (lambda (leaf)
                (dk-focus! leaf)
                (if (equal? (dk-goal) (list 'in u 'set))
                    (ass)
                    (step! sv xv u ih)))
              (dk-opened (lambda () (comp-mi))))))))
    (dk-have! (list 'AND (list 'IN 'EMPTY-SET c) stepf))
    (let ((ind (dk-fact! 'finite-set-induction c)))
      (dk-have! (list 'AND (list 'IN xs 'SET) (list 'IN (list 'CARD xs) 'NN)))
      (let* ((inx (dk-apply! ind xs))
             (ls  (dk-landed (lambda () (comp-me inx)))))
        (car (filter (lambda (f) (not (equal? f (list 'in xs 'set)))) ls))))))
;;; the membership laws whose instances make the two memberships propositionally equivalent
(define (ma-ext-prop! lhs rhs cites)
  (let ((side (lambda (have)
                (lambda (w)
                  (let ((fs (ma-map (lambda (c) (apply dk-cite! (car c) (cdr c))) (cites w))))
                    (ma-prop-with! (cons (list 'IN w have) fs)))))))
    (ma-ext2! lhs rhs (side lhs) (side rhs))))

;;; (SUBSET (SEP v d p) d)
(define (ma-sep-subset! sep)
  (dk-have! (list 'SUBSET sep (caddr sep))
    (lambda ()
      (mac 'subset-def)
      (let ((z (dk-di-var!)))
        (ma-sep-parts! (list 'IN z sep))
        (ass)))))
;;; s subset of the finite set ca (ca in SET, CARD ca in NN in context): land (IN s SET), (IN (CARD s) NN)
(define (ma-finite-sub! s ca)
  (fact 'subclass-of-set-is-set s ca)
  (dk-have! (list 'AND (list 'IN ca 'SET) (list 'IN (list 'CARD ca) 'NN)))
  (let ((cs (dk-fact! 'card-subset-nn ca)))
    (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s ca z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))))
    (dk-apply! cs s)))

;;; case split on a right-nested disjunction ORF in context, one THUNK per disjunct (each run with that
;;; disjunct in context, on its own leaf)
(define (ma-or-split! orf thunks)
  (let* ((o (or (dk-ctx-form orf) (error "ma-or-split!: not in context" (expression->string orf))))
         (l (cadr o)) (r (caddr o)))
    (for-each
      (lambda (leaf)
        (dk-focus! leaf)
        (cond ((dk-asm? l) ((car thunks)))
              ((pair? (cddr thunks)) (ma-or-split! r (cdr thunks)))
              (#t ((cadr thunks)))))
      (dk-opened (lambda () (ai o))))))
;;; f in FUN(NN, A) and every f(k) in B: f in FUN(NN, B)   (pfw-retype!, push-forward.scm)
(define (ma-retype! fv a b in-b!)
  (dk-have! (list 'IN fv (list 'FUN 'NN b))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c fv 'NN a kv)
                (ma-then-ass! (lambda () (in-b! (list fv kv)))))
              (begin
                (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN fv (list 'FUN 'NN a))))))
                (ass))))))))
;;; a function symbol G in FUN(DOM, COD) with G(k) == BODY(k): returns (G . VALUE-EQUATION)   (pfw-abstract!)
(define (ma-abstract! dom cod body-of typer pre)
  (let* ((body  (body-of 'mak_))
         (lam   (list 'VNB-LAMBDA 'mak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'mak_ (list 'IMPLIES (list 'IN 'mak_ dom)
                                                    (list '== (list g 'mak_) body)))))
         (claim (list 'FORSOME 'mag_ (list 'AND (list 'IN 'mag_ (list 'FUN dom cod))
                                            (vals 'mag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!))))
                (let ((kv (dk-di-var!)))
                  (pre kv)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "ma-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "ma-abstract!: the value equation did not land"))))
      (cons g ve))))

;;; (16) the pullback sigma-algebra (Prop. 1.14)
(define (ma-pre om f b) (list 'SEP 'mpx_ om (list 'IN (list f 'mpx_) b)))
(define ma-pb '(PULLBACK-SIGMA omega cB f))
(define (ma-pb-body a) (list 'FORSOME 'mpb_ (list 'AND '(IN mpb_ cB) (list '= a (ma-pre 'omega 'f 'mpb_)))))
(define ma-pb-sep (list 'SEP 'mpa_ '(POWER omega) (ma-pb-body 'mpa_)))

(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cB (list 'FORALL 'f (list '== ma-pb ma-pb-sep))))))
(dk-peel!)
(mac 'PULLBACK-SIGMA)
(qrfl)
(qed 'pullback-sigma-unfold)

;;; membership: a in PB iff a in POWER(omega) and a = f^-1(b) for some b in cB
(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cB (list 'FORALL 'f (list 'FORALL 'a
  (list 'IFF (list 'IN 'a ma-pb) (list 'AND '(IN a (POWER omega)) (ma-pb-body 'a)))))))))
(dk-peel!)
(dk-cite! 'pullback-sigma-unfold 'omega 'cB 'f)
(subst (list '= ma-pb ma-pb-sep))
(dk-iff! (lambda (g) (dk-head-is? g 'AND))
  (lambda () (ma-sep-parts! (list 'IN 'a ma-pb-sep)) (dk-conj-close! dk-ass!))
  (lambda () (dk-split-all!) (in-sep! dk-ass! dk-ass!)))
(qed 'pullback-sigma-membership)

;;; with (IN a PB) in context: land a in POWER(omega), b in cB, a = f^-1(b); return b
(define (ma-pb-open! a)
  (let* ((ps (ma-iff-parts! (dk-cite! 'pullback-sigma-membership 'omega 'cB 'f a))))
    (dk-skolem! (dk-ctx-form (cadr ps)))))
;;; (IN f^-1(b) PB) for b in cB (omega in SET, f in FUN(omega, omega2) in context)
(define (ma-pb-in! b)
  (let ((pre (ma-pre 'omega 'f b)))
    (dk-have! (list 'IN pre ma-pb)
      (lambda ()
        (ma-sep-subset! pre)
        (fact 'subclass-of-set-is-set pre 'omega)
        (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ pre) '(IN z_ omega)))
          (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd pre 'omega z) (ass))))
        (dk-apply! (dk-cite! 'power-mem-intro 'omega pre))
        (dk-have! (list 'AND (list 'IN pre '(POWER omega)) (ma-pb-body pre))
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (begin (ew b) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))))
        (ma-iff-back! (dk-cite! 'pullback-sigma-membership 'omega 'cB 'f pre))))))

(define ma-sig-hyps '((IS-SIGMA-ALGEBRA omega2 cB) (IN f (FUN omega omega2))))

(sp (make-wff (forall-guarded '(omega cB omega2 f) ma-sig-hyps (list 'IS-SIGMA-ALGEBRA 'omega ma-pb))))
(dk-peel!)
(fact 'fun-domain-in-set 'omega 'omega2 'f)
(fact 'power-set 'omega)
(fact 'sigma-algebra-whole-in 'omega2 'cB)
(dk-project! '(SUBSET cB (POWER omega2)) 'is-sigma-algebra '(IS-SIGMA-ALGEBRA omega2 cB))
(let ((fw! (lambda (w) (fact 'fun-apply-type-c 'f 'omega 'omega2 w))))
  (mac 'is-sigma-algebra)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-ass!) #t)
              ((dk-head-is? g 'SUBSET)
               (mac 'subset-def)
               (let ((z (dk-di-var!)))
                 (ma-iff-parts! (dk-cite! 'pullback-sigma-membership 'omega 'cB 'f z))
                 (ass)))
              ((dk-head-is? g 'IN)
               ;; omega = f^-1(omega2)
               (ma-pb-in! 'omega2)
               (ma-ext2! (ma-pre 'omega 'f 'omega2) 'omega
                 (lambda (w) (ma-sep-parts! (list 'IN w (ma-pre 'omega 'f 'omega2))) (ass))
                 (lambda (w) (fw! w) (in-sep! dk-ass! dk-ass!)))
               (dk-rewrite-h! (list 'IN (ma-pre 'omega 'f 'omega2) ma-pb) (ma-pre 'omega 'f 'omega2) 'omega)
               (ass))
              ((dk-contains? g 'COMPLEMENT-IN)
               (let* ((ls (dk-peel!)) (av (cadr (car ls)))
                      (bv (ma-pb-open! av))
                      (cb (list 'COMPLEMENT-IN 'omega2 bv))
                      (lhs (list 'COMPLEMENT-IN 'omega av)))
                 (fact 'sigma-algebra-complement-closed 'omega2 'cB bv)
                 (ma-pb-in! cb)
                 (subst (list '= av (ma-pre 'omega 'f bv)))
                 (let ((pb (ma-pre 'omega 'f bv)) (pc (ma-pre 'omega 'f cb)))
                   (ma-ext2! (list 'COMPLEMENT-IN 'omega pb) pc
                     (lambda (w)
                       (ma-iff-parts! (dk-cite! 'complement-in-membership 'omega pb w))
                       (fw! w)
                       (in-sep! dk-ass!
                         (lambda ()
                           (mac 'complement-in-membership)
                           (dk-conj-close!
                             (lambda ()
                               (if (not (dk-ass!))
                                   (begin
                                     (di)
                                     (dk-have! (list 'IN w pb) (lambda () (in-sep! dk-ass! dk-ass!)))
                                     (ma-prop-with! (list (list 'IN w pb) (list 'NOT (list 'IN w pb)))))))))))
                     (lambda (w)
                       (ma-sep-parts! (list 'IN w pc))
                       (ma-iff-parts! (dk-cite! 'complement-in-membership 'omega2 bv (list 'f w)))
                       (mac 'complement-in-membership)
                       (dk-conj-close!
                         (lambda ()
                           (if (not (dk-ass!))
                               (begin
                                 (di)
                                 (ma-sep-parts! (list 'IN w pb))
                                 (ma-prop-with! (list (list 'IN (list 'f w) bv) (list 'NOT (list 'IN (list 'f w) bv)))))))))))
                 (subst (list '= (list 'COMPLEMENT-IN 'omega (ma-pre 'omega 'f bv)) (ma-pre 'omega 'f cb)))
                 (ass)))
              (#t
               (let* ((landed (dk-peel!))
                      (gv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (dk-head-is? (caddr f) 'FUN))) landed)))
                      (tgt (cadr (dk-goal)))
                      (sk (lambda (k) (list 'SEP 'mpc_ 'cB (list '= (list gv k) (ma-pre 'omega 'f 'mpc_)))))
                      (gk! (lambda (k)
                             ;; g(k) = f^-1(CHOICE S(k)), CHOICE S(k) in cB
                             (fact 'fun-apply-type-c gv 'NN ma-pb k)
                             (let ((b (ma-pb-open! (list gv k))))
                               (dk-have! (list 'IN b (sk k)) (lambda () (in-sep! dk-ass! dk-ass!)))
                               (dk-have! (list 'FORSOME 'cv_ (list 'IN 'cv_ (sk k))) (lambda () (ew b) (ass)))
                               (fact 'choice-axiom (sk k))
                               (ma-sep-parts! (list 'IN (list 'CHOICE (sk k)) (sk k))))))
                      (gr (ma-abstract! 'NN 'cB (lambda (k) (list 'CHOICE (sk k)))
                            (lambda (k) (ma-then-ass! (lambda () (gk! k))))
                            (lambda (k) (gk! k))))
                      (gg (car gr)) (ge (cdr gr))
                      (gfacts! (lambda (k)
                                 (gk! k)
                                 (fact 'fun-apply-type-c gg 'NN 'cB k)
                                 (dk-apply! ge k)
                                 (dk-rewrite-h! (list '= (list gv k) (ma-pre 'omega 'f (list 'CHOICE (sk k))))
                                                (list 'CHOICE (sk k)) (list gg k))))
                      (bug (list 'BIG-UNION 'n_ 'NN (list gg 'n_))))
                 (fact 'sigma-algebra-union-closed 'omega2 'cB gg)
                 (ma-pb-in! bug)
                 (ma-ext2! tgt (ma-pre 'omega 'f bug)
                   (lambda (w)
                     (let* ((r (ma-bu-open! w tgt)) (k (car r)))
                       (gfacts! k)
                       (let ((h (dk-rewrite-h! (cdr r) (list gv k) (ma-pre 'omega 'f (list gg k)))))
                         (ma-sep-parts! h)
                         (in-sep! dk-ass! (lambda () (ma-bu-close! k))))))
                   (lambda (w)
                     (ma-sep-parts! (list 'IN w (ma-pre 'omega 'f bug)))
                     (let* ((r (ma-bu-open! (list 'f w) bug)) (k (car r)))
                       (gfacts! k)
                       (dk-have! (list 'IN w (ma-pre 'omega 'f (list gg k))) (lambda () (in-sep! dk-ass! dk-ass!)))
                       (dk-rewrite-h! (list 'IN w (ma-pre 'omega 'f (list gg k))) (ma-pre 'omega 'f (list gg k)) (list gv k))
                       (ma-bu-close! k))))
                 (dk-rewrite-h! (list 'IN (ma-pre 'omega 'f bug) ma-pb) (ma-pre 'omega 'f bug) tgt)
                 (ass))))))))
(qed 'pullback-sigma-is-sigma-algebra)

(sp (make-wff (forall-guarded '(omega cB omega2 f) ma-sig-hyps
  (list 'IS-MEASURABLE-MAP 'omega ma-pb 'omega2 'cB 'f))))
(dk-peel!)
(fact 'fun-domain-in-set 'omega 'omega2 'f)
(dk-apply! (dk-cite! 'pullback-sigma-is-sigma-algebra 'omega 'cB 'omega2 'f))
(mac 'is-measurable-map)
(dk-conj-close!
  (lambda ()
    (if (not (dk-ass!))
        (let* ((ls (dk-peel!)) (b (cadr (car ls))))
          (ma-pb-in! b)
          (ass)))))
(qed 'pullback-sigma-measurable)

(sp (make-wff (forall-guarded '(omega cB omega2 f) ma-sig-hyps
  (forall-guarded '(mpcc) '((IS-SIGMA-ALGEBRA omega mpcc) (IS-MEASURABLE-MAP omega mpcc omega2 cB f))
    (list 'SUBSET ma-pb 'mpcc)))))
(dk-peel!)
(mac 'subset-def)
(let* ((a (dk-di-var!)) (b (ma-pb-open! a))
       (mm (dk-project! (forall-guarded '(b_) '((IN b_ cB)) '(IN (SEP x_ omega (IN (f x_) b_)) mpcc))
             'is-measurable-map '(IS-MEASURABLE-MAP omega mpcc omega2 cB f))))
  (dk-apply! mm b)
  (subst (list '= a (ma-pre 'omega 'f b)))
  (ass))
(qed 'pullback-sigma-smallest)

;;; PROP. 1.14 as the notes state it
(sp (make-wff (forall-guarded '(omega cB omega2 f) ma-sig-hyps
  (list 'AND (list 'IS-SIGMA-ALGEBRA 'omega ma-pb)
    (list 'AND (list 'IS-MEASURABLE-MAP 'omega ma-pb 'omega2 'cB 'f)
      (forall-guarded '(mpcc) '((IS-SIGMA-ALGEBRA omega mpcc) (IS-MEASURABLE-MAP omega mpcc omega2 cB f))
        (list 'SUBSET ma-pb 'mpcc)))))))
(dk-peel!)
(dk-apply! (dk-cite! 'pullback-sigma-is-sigma-algebra 'omega 'cB 'omega2 'f))
(dk-apply! (dk-cite! 'pullback-sigma-measurable 'omega 'cB 'omega2 'f))
(dk-apply! (dk-cite! 'pullback-sigma-smallest 'omega 'cB 'omega2 'f))
(dk-conj-close! dk-ass!)
(qed 'pullback-sigma-algebra)

;;; (17) the pullback of a measure along a surjection (Prop. 1.22)
(define ma-onto '(FORALL mpsy_ (IMPLIES (IN mpsy_ omega2) (FORSOME mpsx_ (AND (IN mpsx_ omega) (= (f mpsx_) mpsy_))))))
(define ma-pm '(PULLBACK-MEASURE omega cB f nu))
(define ma-pm-lam (list 'VNB-LAMBDA 'mpm_ ma-pb '(nu (IMAGE f mpm_))))

(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cB (list 'FORALL 'f (list 'FORALL 'nu (list '== ma-pm ma-pm-lam)))))))
(dk-peel!)
(mac 'PULLBACK-MEASURE)
(qrfl)
(qed 'pullback-measure-unfold)

;;; the image of the empty set
(sp (make-wff '(FORALL f (= (IMAGE f EMPTY-SET) EMPTY-SET))))
(dk-peel!)
(ma-ext2! '(IMAGE f EMPTY-SET) 'EMPTY-SET
  (lambda (w)
    (let* ((ps (ma-iff-parts! (dk-cite! 'image-membership-iff 'f 'EMPTY-SET w)))
           (x (dk-skolem! (dk-ctx-form (cadr ps)))))
      (dk-cite! 'empty-set-has-no-members x)
      (ma-prop-with! (list (list 'IN x 'EMPTY-SET) (list 'NOT (list 'IN x 'EMPTY-SET))))))
  (lambda (w)
    (dk-cite! 'empty-set-has-no-members w)
    (ma-prop-with! (list (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET))))))
(ass)
(qed 'image-of-empty-set)

;;; f onto omega2: the image of the preimage of a subset of omega2 is that subset
(sp (make-wff (forall-guarded '(omega omega2 f) (list '(IN f (FUN omega omega2)) ma-onto)
  (forall-guarded '(b) '((SUBSET b omega2)) (list '= (list 'IMAGE 'f (ma-pre 'omega 'f 'b)) 'b)))))
(dk-peel!)
(let ((pre (ma-pre 'omega 'f 'b)))
  (ma-ext2! (list 'IMAGE 'f pre) 'b
    (lambda (w)
      (let* ((ps (ma-iff-parts! (dk-cite! 'image-membership-iff 'f pre w)))
             (x (dk-skolem! (dk-ctx-form (cadr ps)))))
        (ma-sep-parts! (list 'IN x pre))
        (dk-rewrite-h! (list 'IN (list 'f x) 'b) (list 'f x) w)
        (ass)))
    (lambda (w)
      (fact 'subset-mem-fwd 'b 'omega2 w)
      (fact 'membership-implies-sethood w 'b)
      (let ((x (dk-skolem! (dk-apply! (dk-ctx-form ma-onto) w))))
        (mac 'image-membership-iff)
        (dk-conj-close!
          (lambda ()
            (cond ((dk-ass!) #t)
                  (#t (ew x)
                      (dk-conj-close!
                        (lambda ()
                          (cond ((dk-ass!) #t)
                                (#t (in-sep! dk-ass! (lambda () (subst (list '= (list 'f x) w)) (ass))))))))))))))
  (ass))
(qed 'image-preimage-of-surjection)

;;; the image of a countable union
(sp (make-wff (list 'FORALL 'f (list 'FORALL 'g (list 'FORALL 'hh
  (list 'IMPLIES '(FORALL mak_ (IMPLIES (IN mak_ NN) (== (hh mak_) (IMAGE f (g mak_)))))
    '(= (IMAGE f (BIG-UNION n_ NN (g n_))) (BIG-UNION n_ NN (hh n_)))))))))
(dk-peel!)
(let* ((ug '(BIG-UNION n_ NN (g n_))) (uh '(BIG-UNION n_ NN (hh n_)))
       (ve '(FORALL mak_ (IMPLIES (IN mak_ NN) (== (hh mak_) (IMAGE f (g mak_)))))))
  (ma-ext2! (list 'IMAGE 'f ug) uh
    (lambda (w)
      (let* ((ps (ma-iff-parts! (dk-cite! 'image-membership-iff 'f ug w)))
             (x (dk-skolem! (dk-ctx-form (cadr ps))))
             (r (ma-bu-open! x ug)) (k (car r)))
        (dk-apply! (dk-ctx-form ve) k)
        (dk-have! (list 'IN w (list 'IMAGE 'f (list 'g k)))
          (lambda ()
            (mac 'image-membership-iff)
            (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew x) (dk-conj-close! dk-ass!)))))))
        (dk-rewrite-h! (list 'IN w (list 'IMAGE 'f (list 'g k))) (list 'IMAGE 'f (list 'g k)) (list 'hh k))
        (ma-bu-close! k)))
    (lambda (w)
      (let* ((r (ma-bu-open! w uh)) (k (car r)))
        (dk-apply! (dk-ctx-form ve) k)
        (let* ((h (dk-rewrite-h! (cdr r) (list 'hh k) (list 'IMAGE 'f (list 'g k))))
               (ps (ma-iff-parts! (dk-cite! 'image-membership-iff 'f (list 'g k) w)))
               (x (dk-skolem! (dk-ctx-form (cadr ps)))))
          (dk-have! (list 'IN x ug) (lambda () (ma-bu-close! k)))
          (mac 'image-membership-iff)
          (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew x) (dk-conj-close! dk-ass!)))))))))
  (ass))
(qed 'image-of-countable-union)

(define ma-pm-hyps (list '(IS-MEASURE omega2 cB nu) '(IN f (FUN omega omega2)) ma-onto))
(define (ma-measure-basics!)
  (let ((h '(IS-MEASURE omega2 cB nu)))
    (dk-project! '(IS-SIGMA-ALGEBRA omega2 cB) 'is-measure h)
    (dk-project! '(IN nu (FUN cB RR-POS-STAR)) 'is-measure h)
    (dk-project! '(= (nu EMPTY-SET) 0) 'is-measure h)
    (dk-project! '(SUBSET cB (POWER omega2)) 'is-sigma-algebra '(IS-SIGMA-ALGEBRA omega2 cB))
    (fact 'fun-domain-in-set 'omega 'omega2 'f)
    (dk-apply! (dk-cite! 'pullback-sigma-is-sigma-algebra 'omega 'cB 'omega2 'f))))
;;; b in cB: b is a subset of omega2
(define (ma-b-sub! b)
  (dk-have! (list 'SUBSET b 'omega2)
    (lambda ()
      (mac 'subset-def)
      (let ((z (dk-di-var!)))
        (fact 'subset-mem-fwd 'cB '(POWER omega2) b)
        (fact 'power-mem-in 'omega2 b z)
        (ass)))))

;;; the value at a member of the pullback
(sp (make-wff (forall-guarded '(omega cB omega2 f nu) ma-pm-hyps
  (forall-guarded '(a) (list (list 'IN 'a ma-pb))
    (list 'AND '(IN (IMAGE f a) cB) (list '= (list ma-pm 'a) '(nu (IMAGE f a))))))))
(dk-peel!)
(ma-measure-basics!)
(let ((b (ma-pb-open! 'a)))
  (ma-b-sub! b)
  (dk-apply! (dk-cite! 'image-preimage-of-surjection 'omega 'omega2 'f) b)
  (dk-cite! 'pullback-measure-unfold 'omega 'cB 'f 'nu)
  (dk-have! '(IN (IMAGE f a) cB) (lambda () (subst (list '= 'a (ma-pre 'omega 'f b))) (subst (list '= (list 'IMAGE 'f (ma-pre 'omega 'f b)) b)) (ass)))
  (dk-have! (list '= (list ma-pm 'a) '(nu (IMAGE f a)))
    (lambda ()
      (subst (list '= ma-pm ma-pm-lam))
      (dk-lam-b!)
      (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
  (dk-conj-close! dk-ass!))
(qed 'pullback-measure-at)

(sp (make-wff (forall-guarded '(omega cB omega2 f nu) ma-pm-hyps
  (forall-guarded '(b) '((IN b cB)) (list '= (list ma-pm (ma-pre 'omega 'f 'b)) '(nu b))))))
(dk-peel!)
(ma-measure-basics!)
(ma-pb-in! 'b)
(ma-b-sub! 'b)
(dk-apply! (dk-cite! 'image-preimage-of-surjection 'omega 'omega2 'f) 'b)
(dk-split! (dk-apply! (dk-cite! 'pullback-measure-at 'omega 'cB 'omega2 'f 'nu) (ma-pre 'omega 'f 'b)))
(subst (list '= (list ma-pm (ma-pre 'omega 'f 'b)) (list 'nu (list 'IMAGE 'f (ma-pre 'omega 'f 'b)))))
(subst (list '= (list 'IMAGE 'f (ma-pre 'omega 'f 'b)) 'b))
(rfl)
(qed 'pullback-measure-value)

(sp (make-wff (forall-guarded '(omega cB omega2 f nu) ma-pm-hyps (list 'IN ma-pm (list 'FUN ma-pb 'RR-POS-STAR)))))
(dk-peel!)
(ma-measure-basics!)
(dk-project! (list 'SUBSET ma-pb '(POWER omega)) 'is-sigma-algebra (list 'IS-SIGMA-ALGEBRA 'omega ma-pb))
(fact 'power-set 'omega)
(fact 'subclass-of-set-is-set ma-pb '(POWER omega))
(dk-cite! 'pullback-measure-unfold 'omega 'cB 'f 'nu)
(subst (list '= ma-pm ma-pm-lam))
(dk-lam-type!
  (lambda ()
    (let ((a (dk-di-var!)))
      (dk-split! (dk-apply! (dk-cite! 'pullback-measure-at 'omega 'cB 'omega2 'f 'nu) a))
      (fact 'fun-apply-type-c 'nu 'cB 'RR-POS-STAR (list 'IMAGE 'f a))
      (ass)))
  (lambda () (ass)))
(qed 'pullback-measure-type)

(sp (make-wff (forall-guarded '(omega cB omega2 f nu) ma-pm-hyps (list 'IS-MEASURE 'omega ma-pb ma-pm))))
(dk-peel!)
(ma-measure-basics!)
(dk-apply! (dk-cite! 'pullback-measure-type 'omega 'cB 'omega2 'f 'nu))
(define (ma-at! a) (dk-split! (dk-apply! (dk-cite! 'pullback-measure-at 'omega 'cB 'omega2 'f 'nu) a)))
(mac 'is-measure)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-ass!) #t)
        ((not (dk-head-is? g 'FORALL))
         ;; the empty set
         (fact 'sigma-algebra-empty-in 'omega ma-pb)
         (ma-at! 'EMPTY-SET)
         (fact 'image-of-empty-set 'f)
         (subst (list '= (list ma-pm 'EMPTY-SET) '(nu (IMAGE f EMPTY-SET))))
         (subst '(= (IMAGE f EMPTY-SET) EMPTY-SET))
         (ass))
        (#t
         ;; countable additivity
         (let* ((ls (dk-peel!))
                (gv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (dk-head-is? (caddr f) 'FUN))) ls)))
                (disj (find-first (lambda (f) (dk-head-is? f 'FORALL)) ls))
                (gk! (lambda (k) (fact 'fun-apply-type-c gv 'NN ma-pb k) (ma-at! (list gv k))))
                (gr (ma-abstract! 'NN 'cB (lambda (k) (list 'IMAGE 'f (list gv k)))
                      (lambda (k) (ma-then-ass! (lambda () (gk! k))))
                      (lambda (k) (gk! k))))
                (hh (car gr)) (ve (cdr gr))
                (hk! (lambda (k) (gk! k) (fact 'fun-apply-type-c hh 'NN 'cB k) (dk-apply! ve k)))
                (ug (list 'BIG-UNION 'n_ 'NN (list gv 'n_)))
                (uh (list 'BIG-UNION 'n_ 'NN (list hh 'n_)))
                (l1 (list 'VNB-LAMBDA 'n_ 'NN (list 'nu (list hh 'n_))))
                (l2 (list 'VNB-LAMBDA 'n_ 'NN (list ma-pm (list gv 'n_))))
                (hdisj (forall-guarded '(i_ j_) '((IN i_ NN) (IN j_ NN) (NOT (= i_ j_)))
                         (list '= (list 'INTERSECTION (list hh 'i_) (list hh 'j_)) 'EMPTY-SET)))
                (nuadd (forall-guarded '(f_)
                         (list '(IN f_ (FUN NN cB))
                               (forall-guarded '(i_ j_) '((IN i_ NN) (IN j_ NN) (NOT (= i_ j_)))
                                 '(= (INTERSECTION (f_ i_) (f_ j_)) EMPTY-SET)))
                         '(= (nu (BIG-UNION n_ NN (f_ n_))) (ESUM (VNB-LAMBDA n_ NN (nu (f_ n_))))))))
           (fact 'sigma-algebra-union-closed 'omega ma-pb gv)
           (ma-at! ug)
           (dk-apply! (dk-cite! 'image-of-countable-union 'f gv hh))
           ;; the images are pairwise disjoint
           (dk-have! hdisj
             (lambda ()
               (let* ((ls2 (dk-peel!))
                      (ne (cadr (find-first (lambda (f) (dk-head-is? f 'NOT)) ls2)))
                      (i (cadr ne)) (j (caddr ne)))
                 (hk! i) (hk! j)
                 (dk-apply! disj i j)
                 (let* ((side (lambda (k)
                                (let ((b (ma-pb-open! (list gv k))))
                                  (ma-b-sub! b)
                                  (dk-apply! (dk-cite! 'image-preimage-of-surjection 'omega 'omega2 'f) b)
                                  b)))
                        (bi (side i)) (bj (side j))
                        (land! (lambda (w k b)
                                 ;; w in H(k) gives w in b
                                 (let* ((h1 (dk-rewrite-h! (list 'IN w (list hh k)) (list hh k) (list 'IMAGE 'f (list gv k))))
                                        (h2 (dk-rewrite-h! h1 (list gv k) (ma-pre 'omega 'f b))))
                                   (dk-rewrite-h! h2 (list 'IMAGE 'f (ma-pre 'omega 'f b)) b))))
                        (back! (lambda (x w k b)
                                 (dk-have! (list 'IN x (ma-pre 'omega 'f b))
                                   (lambda () (in-sep! dk-ass! (lambda () (subst (list '= (list 'f x) w)) (ass)))))
                                 (dk-rewrite-h! (list 'IN x (ma-pre 'omega 'f b)) (ma-pre 'omega 'f b) (list gv k)))))
                   (ma-ext2! (list 'INTERSECTION (list hh i) (list hh j)) 'EMPTY-SET
                     (lambda (w)
                       (ma-iff-parts! (dk-cite! 'intersection-membership (list hh i) (list hh j) w))
                       (land! w i bi)
                       (land! w j bj)
                       (fact 'subset-mem-fwd bi 'omega2 w)
                       (let ((x (dk-skolem! (dk-apply! (dk-ctx-form ma-onto) w))))
                         (back! x w i bi)
                         (back! x w j bj)
                         (dk-have! (list 'IN x (list 'INTERSECTION (list gv i) (list gv j)))
                           (lambda () (mac 'intersection-membership) (dk-conj-close! dk-ass!)))
                         (let ((h0 (dk-rewrite-h! (list 'IN x (list 'INTERSECTION (list gv i) (list gv j)))
                                                  (list 'INTERSECTION (list gv i) (list gv j)) 'EMPTY-SET)))
                           (dk-cite! 'empty-set-has-no-members x)
                           (ma-prop-with! (list h0 (list 'NOT h0))))))
                     (lambda (w)
                       (dk-cite! 'empty-set-has-no-members w)
                       (ma-prop-with! (list (list 'IN w 'EMPTY-SET) (list 'NOT (list 'IN w 'EMPTY-SET))))))
                   (ass)))))
           ;; additivity of nu along the images
           (let* ((nua (dk-project! nuadd 'is-measure '(IS-MEASURE omega2 cB nu)))
                  (e1 (dk-apply! nua hh)))
             (dk-fun-ext! l1 l2 'NN 'RR-POS-STAR
               (lambda ()
                 (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (hk! k) (fact 'fun-apply-type-c 'nu 'cB 'RR-POS-STAR (list hh k)) (ass)))
                               (lambda () (fact 'nn-is-set) (ass))))
               (lambda ()
                 (dk-lam-type! (lambda () (let ((k (dk-di-var!))) (gk! k) (fact 'fun-apply-type-c ma-pm ma-pb 'RR-POS-STAR (list gv k)) (ass)))
                               (lambda () (fact 'nn-is-set) (ass))))
               (lambda (v)
                 (hk! v)
                 (dk-lam-b!)
                 (subst (list '= (list ma-pm (list gv v)) (list 'nu (list 'IMAGE 'f (list gv v)))))
                 (subst (list '== (list hh v) (list 'IMAGE 'f (list gv v))))
                 (fact 'fun-apply-type-c 'nu 'cB 'RR-POS-STAR (list 'IMAGE 'f (list gv v)))
                 (rfl)))
             (dk-rewrite-h! e1 l1 l2)
             (subst (list '= (list ma-pm ug) (list 'nu (list 'IMAGE 'f ug))))
             (subst (list '= (list 'IMAGE 'f ug) uh))
             (ass))))))))
(qed 'pullback-measure-is-measure)

(sp (make-wff (forall-guarded '(omega cB omega2 f nu) ma-pm-hyps
  (forall-guarded '(mu) (list (list 'IS-MEASURE 'omega ma-pb 'mu)
                              (forall-guarded '(b) '((IN b cB)) (list '= (list 'mu (ma-pre 'omega 'f 'b)) '(nu b))))
    (list '= 'mu ma-pm)))))
(dk-peel!)
(ma-measure-basics!)
(dk-apply! (dk-cite! 'pullback-measure-type 'omega 'cB 'omega2 'f 'nu))
(dk-project! (list 'IN 'mu (list 'FUN ma-pb 'RR-POS-STAR)) 'is-measure (list 'IS-MEASURE 'omega ma-pb 'mu))
(let ((vals (forall-guarded '(b) '((IN b cB)) (list '= (list 'mu (ma-pre 'omega 'f 'b)) '(nu b)))))
  (dk-fun-ext! 'mu ma-pm ma-pb 'RR-POS-STAR #f #f
    (lambda (a)
      (let ((b (ma-pb-open! a)))
        (subst (list '= a (ma-pre 'omega 'f b)))
        (dk-apply! (dk-ctx-form vals) b)
        (dk-apply! (dk-cite! 'pullback-measure-value 'omega 'cB 'omega2 'f 'nu) b)
        (fact 'fun-apply-type-c 'nu 'cB 'RR-POS-STAR b)
        (subst (list '= (list 'mu (ma-pre 'omega 'f b)) (list 'nu b)))
        (subst (list '= (list ma-pm (ma-pre 'omega 'f b)) (list 'nu b)))
        (rfl)))))
(qed 'pullback-measure-unique)

;;; PROP. 1.22 as the notes state it
(sp (make-wff (forall-guarded '(omega cB omega2 f nu) ma-pm-hyps
  (list 'AND (list 'IS-MEASURE 'omega ma-pb ma-pm)
    (list 'AND (forall-guarded '(b) '((IN b cB)) (list '= (list ma-pm (ma-pre 'omega 'f 'b)) '(nu b)))
      (forall-guarded '(mu) (list (list 'IS-MEASURE 'omega ma-pb 'mu)
                                  (forall-guarded '(b) '((IN b cB)) (list '= (list 'mu (ma-pre 'omega 'f 'b)) '(nu b))))
        (list '= 'mu ma-pm)))))))
(dk-peel!)
(dk-apply! (dk-cite! 'pullback-measure-is-measure 'omega 'cB 'omega2 'f 'nu))
(dk-apply! (dk-cite! 'pullback-measure-value 'omega 'cB 'omega2 'f 'nu))
(dk-apply! (dk-cite! 'pullback-measure-unique 'omega 'cB 'omega2 'f 'nu))
(dk-conj-close! dk-ass!)
(qed 'pullback-measure-exists-unique)
