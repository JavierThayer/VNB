;; (IN (+ a b) ZZ) and its RR typing, for a, b in ZZ
(define (c3f-zadd! a b)
  (dk-have-and! `(IN ,a ZZ) `(IN ,b ZZ))
  (dk-cite! 'zz-add-closed a b)
  (dk-cite! 'zz-in-rr `(+ ,a ,b)))
(define (c3f-zneg! a) (dk-cite! 'zz-neg-closed a) (dk-cite! 'zz-in-rr `(- ,a)))
;; type the step coefficient c = -(a (f p)(m1)) in CARR k (p in LAURENT-SET, m1 in ZZ in context)
(define (c3f-coef! k f a p m1)
  (let* ((fp `(LAURENT-MUL ,k ,f ,p)) (x `(,fp ,m1)))
    (dk-cite! 'laurent-mul-in k f p)
    (c3f-lfun! k fp)
    (c3f-app! k fp m1)
    (dk-cite! 'ring-carrier-closed-mul k a x)
    (dk-cite! 'ring-neg-in-carr k `((MUL ,k) ,a ,x))))
