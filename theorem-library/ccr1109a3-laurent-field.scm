;;; ---- f g = 1 ----
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-COMMUTATIVE-RING kq_) ,(c3f-all 'fq_ c3f-ls (c3f-all 'oq_ 'ZZ (c3f-all 'aq_ '(CARR kq_)
   `(IMPLIES ,(c3f-below 'kq_ 'fq_ 'oq_) (IMPLIES (= ((MUL kq_) (fq_ oq_) aq_) (ONE kq_))
      (= (LAURENT-MUL kq_ fq_ ,c3f-ser) (LAURENT-ONE kq_)))))))))))
(dk-peel!)
(let* ((k 'kq_) (f 'fq_) (o 'oq_) (a 'aq_) (g c3f-ser) (lhs `(LAURENT-MUL ,k ,f ,g)) (one '(LAURENT-ONE kq_)))
  (dk-chain-ass! (dk-cite! 'commutative-ring-is-ring k))
  (dk-cite! 'ring-zero-in k) (dk-cite! 'ring-one-in k)
  (dk-cite! 'zz-in-rr o) (fact 'rr-zero-in) (fact 'zz-zero-in)
  (c3f-zneg! o) (c3f-lfun! k f)
  (dk-cite! 'laurent-inv-ser-in k f o a) (dk-cite! 'laurent-inv-ser-fun k f o a) (dk-cite! 'laurent-inv-ser-low k f o a)
  (dk-cite! 'laurent-mul-in k f g) (dk-cite! 'laurent-one-in k)
  (dk-fun-ext! lhs one 'ZZ `(CARR ,k)
    (lambda () (c3f-lfun! k lhs) (dk-close-if-asm!))
    (lambda () (c3f-lfun! k one) (dk-close-if-asm!))
    (lambda (n)
      (dk-cite! 'zz-in-rr n)
      (use-em `(< ,n 0)
        (lambda ()
          (mac 'LAURENT-MUL)
          (dk-chain-ass! (dk-cite! 'laurent-mul-vanish2 k f g o `(- ,o)))
          (dk-have! `(< ,n (+ ,o (- ,o))) (lambda () (dk-ineq! `(< ,n 0))))
          (subst (dk-chain-ass! (dk-apply! (c3f-below k (c3f-mm k f g) `(+ ,o (- ,o))) n)))
          (dk-have! `(NOT (= ,n 0)) (lambda () (di) (dk-absurd! `(= ,n 0) `(< ,n 0))))
          (subst (dk-chain-ass! (dk-cite! 'laurent-one-off k n)))
          (c3f-rfl!))
        (lambda ()
          (dk-chain-ass! (dk-cite! 'rr-not-lt-ge n 0))
          (let ((finish!
                  (lambda (b)
                    (let* ((nb `(+ ,n (- ,b))) (bm `(+ ,nb ,o)) (t `(+ ,bm (- ,o))) (pm (c3f-pre bm)))
                      (dk-cite! 'zz-in-rr b) (c3f-zneg! b) (c3f-zadd! n `(- ,b)) (c3f-zadd! nb o)
                      (dk-have! `(<= 0 ,bm) (lambda () (dk-ineq! `(<= 0 ,n) `(<= ,b ,o))))
                      (dk-chain-ass! (dk-cite! 'zz-nonneg-in-nn bm))
                      (c3f-zadd! bm `(- ,o))
                      (dk-chain-ass! (dk-cite! 'laurent-inv-pre-in bm k f o a)) (dk-split-all!)
                      (c3f-lfun! k pm)
                      (dk-chain-ass! (dk-cite! 'laurent-below-mono k f o b))
                      (dk-chain-ass! (dk-cite! 'laurent-below-mono k g `(- ,o) b))
                      (dk-chain-ass! (dk-cite! 'laurent-below-mono k pm `(- ,o) b))
                      (dk-cite! 'laurent-inv-ser-agree k f o a bm)
                      (dk-have! (c3f-agree f f t)
                        (lambda () (dk-peel!) (let ((j (cadr (cadr (dk-goal))))) (c3f-app! k f j) (c3f-rfl!))))
                      (dk-have! `(<= ,n (+ ,t ,b)) (lambda () (dk-ineq!)))
                      (dk-have! `(<= ,n ,bm) (lambda () (dk-ineq! `(<= ,b ,o))))
                      (let* ((loc (dk-chain-ass! (dk-cite! 'laurent-mul-local k f f g pm b t n)))
                            (unit (dk-chain-ass! (dk-cite! 'laurent-inv-pre-unit bm k f o a n))))
                        (dk-cite! 'laurent-mul-unfold k f pm)
                        (dk-rewrite-h! unit `(LAURENT-MUL ,k ,f ,pm) (c3f-mm k f pm))
                        (mac 'LAURENT-MUL)
                        (subst loc)
                        (dk-close-if-asm!))))))
            (use-em `(<= ,o (- ,o))
              (lambda ()
                (dk-have! `(<= ,o ,o) (lambda () (dk-ineq!)))
                (finish! o))
              (lambda ()
                (dk-chain-ass! (dk-cite! 'rr-not-le-lt o `(- ,o)))
                (dk-have! `(<= (- ,o) ,o) (lambda () (dk-ineq! `(< (- ,o) ,o))))
                (dk-have! `(<= (- ,o) (- ,o)) (lambda () (dk-ineq!)))
                (finish! `(- ,o))))))))))
(qed 'laurent-inv-ser-right)

;;; ---- CCR 1.35: K((x)) is a field when K is ----
(sp (make-wff '(FORALL kq_ (IMPLIES (IS-FIELD-RING kq_) (IS-FIELD-RING (LAURENT-RING kq_))))))
(dk-peel!)
(let* ((k 'kq_) (lr '(LAURENT-RING kq_)) (lz '(LAURENT-ZERO kq_)) (lo '(LAURENT-ONE kq_)))
  (dk-chain-ass! (dk-cite! 'field-ring-is-integral-domain k))
  (dk-chain-ass! (dk-cite! 'integral-domain-is-commutative-ring k))
  (dk-chain-ass! (dk-cite! 'commutative-ring-is-ring k))
  (dk-cite! 'ring-zero-in k) (dk-cite! 'ring-one-in k)
  (dk-chain-ass! (dk-cite! 'ladet-field-one-ne k))
  (let* ((kiff (dk-cite! 'is-field-ring-def k))
         (law (begin (dk-iff-fwd! kiff)
                     (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (string-search-forward "forsome" (string-downcase (expression->string h)) 0)
                                                  (string-search-forward "carr(kq_)" (string-downcase (expression->string h)) 0)))
                                 (dk-asms))))
         (iff (dk-cite! 'is-field-ring-def lr)))
    (if (not law) (error "c3f: the inverse law of K not found"))
    (dk-chain-ass! (dk-cite! 'laurent-ring-is-commutative-ring k))
    (dk-cite! 'laurent-zero-in k) (dk-cite! 'laurent-one-in k)
    (dk-have! (caddr iff)
      (lambda ()
        (for-each (lambda (nm) (subst (dk-cite! nm k)))
                  '(laurent-ring-carr laurent-ring-zero laurent-ring-one laurent-ring-mul))
        (dk-conj-close!
          (lambda ()
            (let ((g (dk-goal)))
              (cond
                ((dk-asm? g) (dk-ass!))
                ((dk-head-is? g 'NOT)
                 ;; 1 /= 0 in K((x)): compare the coefficients at 0
                 (di)
                 (fact 'zz-zero-in)
                 (c3f-lfun! k lz) (c3f-app! k lz 0)
                 (let ((e (dk-have! `(= (,lo 0) (,lz 0)) (lambda () (subst `(= ,lo ,lz)) (c3f-rfl!)))))
                   (dk-cite! 'laurent-one-zero k) (dk-cite! 'laurent-zero-apply k 0)
                   (dk-rewrite-h! `(= (,lo 0) (,lz 0)) `(,lo 0) `(ONE ,k))
                   (dk-rewrite-h! `(= (ONE ,k) (,lz 0)) `(,lz 0) `(ZERO ,k))
                   (keep `(NOT (= (ONE ,k) (ZERO ,k))) `(= (ONE ,k) (ZERO ,k)))
                   (prop)))
                ((dk-head-is? g 'FORALL)
                 ;; every f /= 0 has the inverse LAURENT-INV-SER(f, ord f, f(ord f)^-1)
                 (let* ((landed (dk-landed (lambda () (dk-peel!))))
                        (f (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) '(LAURENT-SET kq_)) (symbol? (cadr h)))) landed)))
                        (o (dk-skolem! (dk-chain-ass! (dk-cite! 'laurent-nonzero-ord k f)))))
                   (dk-split-all!)
                   (for-each (lambda (c) (if (not (dk-asm? c)) (error "c3f: missing after skolem" c)))
                             (list `(IN ,o ZZ) `(NOT (= (,f ,o) (ZERO ,k))) (c3f-below k f o)))
                   (c3f-lfun! k f) (c3f-app! k f o)
                   (let* ((a (dk-skolem! (dk-chain-ass! (dk-apply! law `(,f ,o))))))
                     (dk-split-all!)
                     (for-each (lambda (c) (if (not (dk-asm? c)) (error "c3f: missing after skolem" c)))
                               (list `(IN ,a (CARR ,k)) `(= ((MUL ,k) (,f ,o) ,a) (ONE ,k))))
                     (let ((g `(LAURENT-INV-SER ,k ,f ,o ,a)))
                       (dk-cite! 'laurent-inv-ser-in k f o a)
                       (dk-chain-ass! (dk-cite! 'laurent-inv-ser-right k f o a))
                       (ew g)
                       (dk-conj-close!
                         (lambda ()
                           (if (dk-asm? (dk-goal)) (dk-ass!)
                               (begin (dk-lam-b!) (dk-close-if-asm!)))))))))
                (#t (error "c3f: unexpected conjunct" (expression->string g)))))))))
    (dk-iff-bwd! iff)
    (dk-close-if-asm!)))
(qed 'laurent-ring-is-field-ring)

;;; =======================================================================
;;; K((x)) as a non-archimedean valued field: LAURENT-NF(K, r), |f| = r^ord(f), 0 < r < 1
;;; =======================================================================
;; 1 /= 0 in K((x))
(sp (make-wff '(FORALL kq_ (IMPLIES (IS-RING kq_) (IMPLIES (NOT (= (ONE kq_) (ZERO kq_))) (NOT (= (LAURENT-ZERO kq_) (LAURENT-ONE kq_))))))))
(dk-peel!)
(let ((k 'kq_) (lz '(LAURENT-ZERO kq_)) (lo '(LAURENT-ONE kq_)))
  (di)
  (dk-cite! 'ring-zero-in k) (dk-cite! 'ring-one-in k)
  (fact 'zz-zero-in)
  (dk-cite! 'laurent-zero-in k) (c3f-lfun! k lz) (c3f-app! k lz 0)
  (dk-have! `(= (,lo 0) (,lz 0)) (lambda () (subst `(= ,lo ,lz)) (c3f-rfl!)))
  (dk-cite! 'laurent-one-zero k) (dk-cite! 'laurent-zero-apply k 0)
  (dk-rewrite-h! `(= (,lo 0) (,lz 0)) `(,lo 0) `(ONE ,k))
  (dk-rewrite-h! `(= (ONE ,k) (,lz 0)) `(,lz 0) `(ZERO ,k))
  (keep `(NOT (= (ONE ,k) (ZERO ,k))) `(= (ONE ,k) (ZERO ,k)))
  (prop))
(qed 'laurent-zero-ne-one)

;; |f| = 0 iff f = 0
(sp (make-wff `(FORALL kq_ (IMPLIES (IS-RING kq_) ,(c3f-all 'rq_ 'RR `(IMPLIES (< 0 rq_) ,(c3f-all 'fq_ c3f-ls
   '(IFF (= (LAURENT-ABS kq_ rq_ fq_) 0) (= fq_ (LAURENT-ZERO kq_))))))))))
(dk-peel!)
(let ((k 'kq_) (r 'rq_) (f 'fq_) (lz '(LAURENT-ZERO kq_)))
  (dk-iff! (lambda (g) (or (equal? g `(= ,f ,lz)) (and (dk-head-is? g 'IMPLIES) (equal? (caddr g) `(= ,f ,lz)))))
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
      (pbc)
      (dk-chain-ass! (dk-cite! 'laurent-abs-nonzero k r f)) (dk-split-all!)
      (dk-cite! 'laurent-abs-in-rr k r f) (dk-split-all!)
      (dk-absurd! `(= (LAURENT-ABS ,k ,r ,f) 0) `(< 0 (LAURENT-ABS ,k ,r ,f))))
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IMPLIES) (di))
      (subst `(= ,f ,lz))
      (dk-cite! 'laurent-abs-zero k r)
      (dk-close-if-asm!))))
(qed 'laurent-abs-zero-iff)

;; the slots of LAURENT-NF typed (what certifies the LIST defined): K commutative, 0 < r, in context
(define c3f-lr '(LAURENT-RING kq_))
(define c3f-nrm '(VNB-LAMBDA lrf_ (CARR (LAURENT-RING kq_)) (LAURENT-ABS kq_ rq_ lrf_)))
(define (c3f-nf-setup!)
  (let ((k 'kq_) (r 'rq_) (lr c3f-lr))
    (dk-chain-ass! (dk-cite! 'commutative-ring-is-ring k))
    (dk-chain-ass! (dk-cite! 'laurent-ring-is-ring k))
    (dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'IS-RING `(IS-RING ,lr))))))
    (dk-chain-ass! (dk-cite! 'laurent-ring-is-ring k))
    (dk-have! `(IN ,c3f-nrm (FUN (CARR ,lr) RR))
      (lambda ()
        (dk-cite! 'laurent-ring-carr k)
        (dk-rewrite-h! `(IN (CARR ,lr) SET) `(CARR ,lr) '(LAURENT-SET kq_))
        (subst `(== (CARR ,lr) (LAURENT-SET kq_)))
        (dk-each-leaf! (lambda () (lam-t))
          (lambda ()
            (if (dk-head-is? (dk-goal) 'FORALL)
                (let* ((landed (dk-landed (lambda () (dk-peel!))))
                       (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(LAURENT-SET kq_)))) landed))))
                  (dk-cite! 'laurent-abs-in-rr k r x) (dk-split-all!)
                  (dk-close-if-asm!))
                (dk-close-if-asm!))))))
    (dk-cite! 'membership-implies-sethood c3f-nrm `(FUN (CARR ,lr) RR))))
(define (c3f-nf-readoff! name acc rhs)
  (dk-sp-qed! (make-wff `(FORALL kq_ (IMPLIES (IS-COMMUTATIVE-RING kq_) ,(c3f-all 'rq_ 'RR `(IMPLIES (< 0 rq_) (== (,acc (LAURENT-NF kq_ rq_)) ,rhs))))))
    (lambda ()
      (dk-peel!) (c3f-nf-setup!) (slot acc) (mac 'LAURENT-NF) (nth-r)
      ;; `slot' read the ring's accessors on the right as NTHs too: read them back
      (for-each (lambda (ia)
                  (let ((r (list 'NTH (car ia) '(LAURENT-RING kq_))) (src (list (cdr ia) '(LAURENT-RING kq_))))
                    (if (string-search-forward (string-downcase (expression->string r)) (string-downcase (expression->string (dk-goal))) 0)
                        (begin (dk-have! (list '== r src) (lambda () (slot (cdr ia)) (qrfl)))
                               (subst (list '== r src))))))
                '((1 . CARR) (2 . ADD) (3 . MUL) (4 . NEG) (5 . ZERO) (6 . ONE)))
      (qrfl))
    name))
(c3f-nf-readoff! 'laurent-nf-carr 'CARR '(CARR (LAURENT-RING kq_)))
(c3f-nf-readoff! 'laurent-nf-add 'ADD '(ADD (LAURENT-RING kq_)))
(c3f-nf-readoff! 'laurent-nf-mul 'MUL '(MUL (LAURENT-RING kq_)))
(c3f-nf-readoff! 'laurent-nf-neg 'NEG '(NEG (LAURENT-RING kq_)))
(c3f-nf-readoff! 'laurent-nf-zero 'ZERO '(ZERO (LAURENT-RING kq_)))
(c3f-nf-readoff! 'laurent-nf-one 'ONE '(ONE (LAURENT-RING kq_)))
(c3f-nf-readoff! 'laurent-nf-fnrm 'FNRM '(VNB-LAMBDA lrf_ (CARR (LAURENT-RING kq_)) (LAURENT-ABS kq_ rq_ lrf_)))

;; a point x of CARR(LAURENT-RING K) in context: land x in LAURENT-SET K
(define (c3f-pt! x)
  (if (not (dk-asm? `(IN ,x (LAURENT-SET kq_))))
      (begin (dk-cite! 'laurent-ring-carr 'kq_)
             (dk-rewrite-h! `(IN ,x (CARR ,c3f-lr)) `(CARR ,c3f-lr) '(LAURENT-SET kq_)))))
;; a Laurent series term t in LAURENT-SET in context: land it in CARR(LAURENT-RING K) too
(define (c3f-in-lr! t)
  (if (not (dk-asm? `(IN ,t (CARR ,c3f-lr))))
      (begin (dk-cite! 'laurent-ring-carr 'kq_)
             (dk-rewrite-h! `(IN ,t (LAURENT-SET kq_)) '(LAURENT-SET kq_) `(CARR ,c3f-lr)))))
(define (c3f-abs x) `(LAURENT-ABS kq_ rq_ ,x))
(define (c3f-nf-hyps body)
  `(FORALL kq_ (IMPLIES (IS-FIELD-RING kq_) ,(c3f-all 'rq_ 'RR `(IMPLIES (< 0 rq_) (IMPLIES (< rq_ 1) ,body))))))
(define (c3f-k-setup!)
  (let ((k 'kq_))
    (dk-chain-ass! (dk-cite! 'field-ring-is-integral-domain k))
    (dk-chain-ass! (dk-cite! 'integral-domain-is-commutative-ring k))
    (dk-chain-ass! (dk-cite! 'ladet-field-one-ne k))
    (c3f-nf-setup!)))

(define (c3f-norm-body!)
  (let* ((k 'kq_) (r 'rq_) (lr c3f-lr)
         (landed (dk-landed (lambda () (dk-peel!))))
         (a (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed))))
    (c3f-pt! a)
    (for-each (lambda (nm) (subst (dk-cite! nm k))) '(laurent-ring-zero laurent-ring-mul laurent-ring-add))
    (let disp ()
      (if (and (not (dk-head-is? (dk-goal) 'AND)) (not (dk-head-is? (dk-goal) 'FORALL)) (dk--redex? (dk-goal))) (dk-lam-b!))
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (dk-ass!))
          ((dk-head-is? g 'AND) (for-each (lambda (l) (if (not (sequent-node-grounded? l)) (begin (dk-focus! l) (disp)))) (dk-opened (lambda () (di)))))
          ((dk-head-is? g 'IFF) (dk-cite! 'laurent-abs-zero-iff k r a) (dk-close-if-asm!))
          ((and (dk-head-is? g '<=) (eqv? (cadr g) 0)) (dk-cite! 'laurent-abs-in-rr k r a) (dk-split-all!) (dk-close-if-asm!))
          ((dk-head-is? g 'FORALL)
           (let* ((landed2 (dk-landed (lambda () (dk-peel!))))
                  (b (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed2)))
                  (ab `(LAURENT-MUL ,k ,a ,b)) (sb `(LAURENT-ADD ,k ,a ,b)))
             (c3f-pt! b)
             (dk-cite! 'laurent-mul-in k a b) (dk-cite! 'laurent-add-in k a b)
             (c3f-in-lr! ab) (c3f-in-lr! sb)
             (disp)))
          ((dk-head-is? g '=)
           (let ((b (cadddr (cadddr (cadr g)))))
             (dk-cite! 'laurent-abs-mul k r a b) (dk-close-if-asm!)))
          ((dk-head-is? g '<=)
           (let* ((b (cadddr (cadddr (cadr g)))) (ax (c3f-abs a)) (ay (c3f-abs b)) (s (c3f-abs `(LAURENT-ADD ,k ,a ,b))))
             (dk-cite! 'laurent-abs-ultra k r a b)
             (dk-cite! 'laurent-abs-in-rr k r a) (dk-cite! 'laurent-abs-in-rr k r b)
             (dk-cite! 'laurent-abs-in-rr k r `(LAURENT-ADD ,k ,a ,b)) (dk-split-all!)
             (dk-cite! 'rr-max-closed ax ay)
             (dk-have-and! `(IN ,ax RR) `(IN ,ay RR)) (dk-cite! 'rr-add-closed ax ay)
             (dk-have! `(<= ,ax (+ ,ax ,ay)) (lambda () (dk-ineq! `(<= 0 ,ay))))
             (dk-have! `(<= ,ay (+ ,ax ,ay)) (lambda () (dk-ineq! `(<= 0 ,ax))))
             (dk-chain-ass! (dk-cite! 'rr-max-le ax ay `(+ ,ax ,ay)))
             (dk-ineq! `(<= ,s (MAX ,ax ,ay)) `(<= (MAX ,ax ,ay) (+ ,ax ,ay)))))
          (#t (error "c3f-norm-body!: unexpected" (expression->string g))))))))

(define (c3f-inverse-body!)
  (let* ((k 'kq_) (lr c3f-lr)
         (landed (dk-landed (lambda () (dk-peel!))))
         (a (cadr (find-first (lambda (f) (dk-head-is? f 'IN)) landed)))
         (law (dk-project! `(FORALL a_ (IMPLIES (IN a_ (CARR ,lr)) (IMPLIES (NOT (= a_ (ZERO ,lr)))
                                (FORSOME b_ (AND (IN b_ (CARR ,lr)) (= ((MUL ,lr) a_ b_) (ONE ,lr)))))))
                           'is-field-ring-def `(IS-FIELD-RING ,lr)))
         (b (dk-skolem! (dk-chain-ass! (dk-apply! law a)))))
    (dk-split-all!)
    (ew b)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((dk-asm? g) (dk-ass!))
            ((dk-head-is? g 'NOT)
             (di)
             (let* ((e0 `(= ((MUL ,lr) ,a ,b) (ONE ,lr)))
                    (e1 (dk-rewrite-h! e0 b `(ZERO ,lr)))
                    (z (dk-chain-ass! (dk-cite! 'ring-mul-zero-right lr a)))
                    (e2 (dk-rewrite-h! e1 `((MUL ,lr) ,a (ZERO ,lr)) `(ZERO ,lr))))
               (keep e2 `(NOT (= (ZERO ,lr) (ONE ,lr))))
               (prop)))
            (#t (error "c3f-inverse-body!: unexpected" (expression->string g)))))))))

;;; K((x)) with |f| = r^ord(f) is a normed field (K a field, 0 < r < 1)
(sp (make-wff (c3f-nf-hyps '(IS-NORMED-FIELD (LAURENT-NF kq_ rq_)))))
(dk-peel!)
(let* ((k 'kq_) (r 'rq_) (lr c3f-lr))
  (c3f-k-setup!)
  (dk-chain-ass! (dk-cite! 'laurent-ring-is-field-ring k))
  (dk-chain-ass! (dk-cite! 'laurent-ring-is-commutative-ring k))
  (dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'is-commutative-ring-def `(IS-COMMUTATIVE-RING ,lr))))))
  (dk-chain-ass! (dk-cite! 'laurent-ring-is-commutative-ring k))
  (dk-have! `(NOT (= (ZERO ,lr) (ONE ,lr)))
    (lambda () (subst (dk-cite! 'laurent-ring-zero k)) (subst (dk-cite! 'laurent-ring-one k))
               (dk-chain-ass! (dk-cite! 'laurent-zero-ne-one k)) (dk-close-if-asm!)))
  (mac 'IS-NORMED-FIELD)
  (dk-isx-set!)
  (for-each mac '(laurent-nf-carr laurent-nf-add laurent-nf-mul laurent-nf-neg laurent-nf-zero laurent-nf-one laurent-nf-fnrm))
  (let split ((fuel 40))
    (let ((andl (find-first (lambda (s) (dk-head-is? (dk-goal-of s) 'AND)) (dk-open-leaves))))
      (when andl
        (if (= fuel 0) (error "c3f: AND split did not terminate"))
        (dk-focus! andl) (di) (split (- fuel 1)))))
  (for-each
    (lambda (l)
      (if (not (sequent-node-grounded? l))
          (begin
            (dk-focus! l)
            (let ((g (dk-goal)))
              (cond ((dk-asm? g) (dk-ass!))
                    ((and (dk-head-is? g '=) (dk-head-is? (cadr g) 'LENGTH)) (mac 'LAURENT-NF) (len-r) (arith))
                    ((dk-head-is? g 'is-commutative) (mac 'is-commutative) (dk-close-if-asm!))
                    ((dk-head-is? g 'is-norm)
                     (mac 'is-norm)
                     (for-each (lambda (l2) (dk-focus! l2) (if (dk-asm? (dk-goal)) (dk-ass!) (c3f-norm-body!)))
                               (dk-opened (lambda () (di)))))
                    ((dk-head-is? g 'FORALL) (c3f-inverse-body!))
                    (#t (error "c3f nf: unexpected conjunct" (expression->string g))))))))
    (dk-open-leaves)))
(qed 'laurent-nf-is-normed-field)

;;; ... and non-archimedean: |f + g| <= max(|f|, |g|)  (CCR 1.35 / Remark 1.36)
(sp (make-wff (c3f-nf-hyps '(IS-NV-FIELD (LAURENT-NF kq_ rq_)))))
(dk-peel!)
(let* ((k 'kq_) (r 'rq_) (lr c3f-lr))
  (dk-chain-ass! (dk-cite! 'laurent-nf-is-normed-field k r))
  (c3f-k-setup!)
  (mac 'IS-NV-FIELD)
  (for-each mac '(laurent-nf-carr laurent-nf-add laurent-nf-fnrm))
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (dk-ass!)
          (let* ((landed (dk-landed (lambda () (dk-peel!))))
                 (vs (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) landed)))
                 (x (car vs)) (y (cadr vs)) (sb `(LAURENT-ADD ,k ,x ,y)))
            (c3f-pt! x) (c3f-pt! y)
            (subst (dk-cite! 'laurent-ring-add k))
            (dk-cite! 'laurent-add-in k x y) (c3f-in-lr! sb)
            (dk-lam-b!)
            (dk-cite! 'laurent-abs-ultra k r x y)
            (dk-close-if-asm!))))))
(qed 'laurent-nf-is-nv-field)
