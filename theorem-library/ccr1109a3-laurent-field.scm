      (lambda ()
        (dk-chain-ass! (dk-cite! 'rr-not-lt-ge n 0))
        (dk-have-and! `(IN ,n RR) '(IN 0 RR))
        (dk-have-and! `(<= ,n 0) `(<= 0 ,n))
        (dk-chain-ass! (dk-cite! 'rr-leq-antisymmetric n 0))
        (subst `(= ,n 0))
        (let ((top (dk-chain-ass! (dk-cite! 'laurent-mul-mono-top k f o a `(- ,o)))))
          (dk-have! `(= (+ ,o (- ,o)) 0) (lambda () (crs)))
          (dk-rewrite-h! top `(+ ,o (- ,o)) 0)
          (subst `(= ((LAURENT-MUL ,k ,f ,g0) 0) ((MUL ,k) ,u ,a))))
        (subst `(= ((MUL ,k) ,u ,a) (ONE ,k)))
        (subst (dk-cite! 'laurent-one-zero k))
        (c3f-rfl!))))
  ;; ---- step: P_(m+1) = P_m + c x^(m+1-o) ----
  (dk-focus! st)
  (dk-peel!)
  (common!)
  (mac 'laurent-inv-pre-succ)
  (let* ((p (c3f-pre m)) (m1 `(+ ,m 1)) (fp `(LAURENT-MUL ,k ,f ,p)) (x `(,fp ,m1))
         (c `((NEG ,k) ((MUL ,k) ,a ,x))) (t `(+ ,m1 (- ,o))) (mo (c3f-mono k c t)) (fmo `(LAURENT-MUL ,k ,f ,mo)))
    (dk-cite! 'nn-subset-zz m) (dk-cite! 'zz-in-rr m) (fact 'zz-one-in) (dk-cite! 'nn-zero-le m)
    (c3f-zadd! m 1) (c3f-zadd! m1 `(- ,o))
    (dk-chain-ass! (dk-cite! 'laurent-inv-pre-in m k f o a)) (dk-split-all!)
    (c3f-coef! k f a p m1)
    (dk-cite! 'laurent-mono-in k c t) (dk-cite! 'laurent-mono-fun k c t)
    (subst (dk-cite! 'laurent-mul-distrib-left k f p mo))
    (dk-cite! 'laurent-mul-in k f mo)
    (subst (dk-cite! 'laurent-add-apply k fp fmo n))
    (dk-cite! (quote nn-succ-plus-one) m)
    (dk-rewrite-h! `(<= ,n (succ ,m)) `(succ ,m) m1)
    (dk-cite! 'laurent-one-in k) (c3f-lfun! k '(LAURENT-ONE kq_))
    (use-em `(<= ,n ,m)
      (lambda ()
        (subst (dk-chain-ass! (dk-apply! ih n)))
        (dk-have! `(< ,n (+ ,o ,t)) (lambda () (dk-ineq! `(<= ,n ,m))))
        (subst (dk-chain-ass! (dk-cite! 'laurent-mul-mono-low k f o c t n)))
        (c3f-app! k '(LAURENT-ONE kq_) n)
        (subst (dk-cite! 'ring-add-right-id k `((LAURENT-ONE ,k) ,n)))
        (c3f-rfl!))
      (lambda ()
        (dk-chain-ass! (dk-cite! 'rr-not-le-lt n m))
        (dk-cite! 'nn-subset-zz m)
        (dk-chain-ass! (dk-cite! 'zz-lt-succ-le m n))
        (dk-have-and! `(IN ,n RR) `(IN ,m1 RR))
        (dk-have-and! `(<= ,n ,m1) `(<= ,m1 ,n))
        (dk-chain-ass! (dk-cite! 'rr-leq-antisymmetric n m1))
        (subst `(= ,n ,m1))
        (let ((top (dk-chain-ass! (dk-cite! 'laurent-mul-mono-top k f o c t))))
          (dk-have! `(= (+ ,o ,t) ,m1) (lambda () (crs)))
          (dk-rewrite-h! top `(+ ,o ,t) m1)
          (subst `(= (,fmo ,m1) ((MUL ,k) ,u ,c))))
        (dk-have! `(NOT (= ,m1 0)) (lambda () (di) (dk-absurd! `(= ,m1 0) `(<= 0 ,m))))
        (subst (dk-chain-ass! (dk-cite! 'laurent-one-off k m1)))
        (let ((lhs `((ADD ,k) ,x ((MUL ,k) ,u ,c)))
              (mid `((ADD ,k) ,x ((NEG ,k) ((MUL ,k) ((MUL ,k) ,u ,a) ,x)))))
          (dk-have! `(= ,lhs ,mid) (lambda () (crs)))
          (subst `(= ,lhs ,mid))
          (subst `(= ((MUL ,k) ,u ,a) (ONE ,k)))
          (crs))))))
(qed 'laurent-inv-pre-unit)

;;; ---- the inverse series g = LAURENT-INV-SER: g(j) = P_(j+o)(j) for j >= -o, 0 below ----
(define c3f-ser '(LAURENT-INV-SER kq_ fq_ oq_ aq_))
(define (c3f-ser-if j) `(IF (<= (- oq_) ,j) (,(c3f-pre `(+ ,j oq_)) ,j) (ZERO kq_)))
;; type (IF (<= -o j) P_(j+o)(j) 0) in CARR k (the prefix hypotheses and j in ZZ in context)
(define (c3f-ser-type! j)
  (let ((k 'kq_) (f 'fq_) (o 'oq_) (a 'aq_) (ift (c3f-ser-if j)))
    (dk-cite! 'ring-zero-in k)
    (dk-have! `(IN ,ift (CARR ,k))
      (lambda ()
        (dk-case-if! ift
          (lambda (tv val)
            (if tv
                (let ((jo `(+ ,j ,o)))
                  (dk-cite! 'zz-in-rr j) (dk-cite! 'zz-in-rr o)
                  (c3f-zadd! j o)
                  (dk-have! `(<= 0 ,jo) (lambda () (dk-ineq! `(<= (- ,o) ,j))))
                  (dk-chain-ass! (dk-cite! 'zz-nonneg-in-nn jo))
                  (dk-chain-ass! (dk-cite! 'laurent-inv-pre-in jo k f o a)) (dk-split-all!)
                  (c3f-lfun! k (c3f-pre jo))
                  (c3f-app! k (c3f-pre jo) j)))
            (dk-close-if-asm!)))))))

(sp (make-wff (c3f-pre-stmt (c3f-all 'jq_ 'ZZ `(== (,c3f-ser jq_) ,(c3f-ser-if 'jq_))))))
(dk-peel!)
(c3f-ser-type! 'jq_)
(dk-cite! 'membership-implies-sethood (c3f-ser-if 'jq_) '(CARR kq_))
(mac 'LAURENT-INV-SER) (dk-lam-b!)
(if (pair? (dk-open-leaves)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (qrfl)))
(qed 'laurent-inv-ser-apply)

(sp (make-wff (c3f-pre-stmt `(IN ,c3f-ser ,(c3f-funk 'kq_)))))
(dk-peel!)
(dk-cite! 'ring-zero-in 'kq_)
(dk-each-leaf! (lambda () (mac 'LAURENT-INV-SER) (lam-t))
  (lambda ()
    (if (dk-head-is? (dk-goal) 'FORALL)
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'ZZ))) landed))))
          (c3f-ser-type! x)
          (dk-close-if-asm!))
        (begin (fact 'zz-is-set) (dk-close-if-asm!)))))
(qed 'laurent-inv-ser-fun)

(sp (make-wff (c3f-pre-stmt (c3f-below 'kq_ c3f-ser '(- oq_)))))
(dk-peel!)
(let ((j (c3f-goal-arg)) (o 'oq_))
  (dk-cite! 'ring-zero-in 'kq_)
  (dk-cite! 'zz-in-rr j) (dk-cite! 'zz-in-rr o)
  (subst (dk-cite! 'laurent-inv-ser-apply 'kq_ 'fq_ o 'aq_ j))
  (dk-if-branch! #f (c3f-ser-if j) (lambda () (di) (dk-absurd! `(<= (- ,o) ,j) `(< ,j (- ,o))))
    (lambda () (c3f-rfl!))))
(qed 'laurent-inv-ser-low)

(sp (make-wff (c3f-pre-stmt `(IN ,c3f-ser ,c3f-ls))))
(dk-peel!)
(dk-cite! 'laurent-inv-ser-fun 'kq_ 'fq_ 'oq_ 'aq_)
(dk-cite! 'laurent-inv-ser-low 'kq_ 'fq_ 'oq_ 'aq_)
(c3f-zneg! 'oq_)
(dk-chain-ass! (dk-cite! 'laurent-set-in 'kq_ c3f-ser '(- oq_)))
(dk-close-if-asm!)
(qed 'laurent-inv-ser-in)

;; g agrees with every prefix P_M up to M - o
(sp (make-wff (c3f-pre-stmt (c3f-all 'mb_ 'NN (c3f-agree c3f-ser (c3f-pre 'mb_) '(+ mb_ (- oq_)))))))
(dk-peel!)
(let* ((k 'kq_) (f 'fq_) (o 'oq_) (a 'aq_) (bm 'mb_) (j (c3f-goal-arg)) (pm (c3f-pre bm)))
  (dk-cite! 'ring-zero-in k)
  (dk-cite! 'zz-in-rr j) (dk-cite! 'zz-in-rr o) (dk-cite! 'nn-subset-zz bm) (dk-cite! 'zz-in-rr bm)
  (c3f-zneg! o)
  (dk-chain-ass! (dk-cite! 'laurent-inv-pre-in bm k f o a)) (dk-split-all!)
  (use-em `(< ,j (- ,o))
    (lambda ()
      (dk-cite! 'laurent-inv-ser-low k f o a)
      (subst (dk-chain-ass! (dk-apply! (c3f-below k c3f-ser `(- ,o)) j)))
      (subst (dk-chain-ass! (dk-apply! (c3f-below k pm `(- ,o)) j)))
      (c3f-rfl!))
    (lambda ()
      (dk-chain-ass! (dk-cite! 'rr-not-lt-ge j `(- ,o)))
      (subst (dk-cite! 'laurent-inv-ser-apply k f o a j))
      (dk-if-branch! #t (c3f-ser-if j) (lambda () (dk-ass!))
        (lambda ()
          (let ((jo `(+ ,j ,o)))
            (c3f-zadd! j o)
            (dk-have! `(<= 0 ,jo) (lambda () (dk-ineq! `(<= (- ,o) ,j))))
            (dk-chain-ass! (dk-cite! 'zz-nonneg-in-nn jo))
            (dk-have! `(<= ,jo ,bm) (lambda () (dk-ineq! `(<= ,j (+ ,bm (- ,o))))))
            (dk-have! `(<= ,j (+ ,jo (- ,o))) (lambda () (dk-ineq!)))
            (subst (dk-chain-ass! (dk-cite! 'laurent-inv-pre-stable bm k f o a jo j)))
            (dk-chain-ass! (dk-cite! 'laurent-inv-pre-in jo k f o a)) (dk-split-all!)
            (c3f-lfun! k (c3f-pre jo))
            (c3f-app! k (c3f-pre jo) j)
            (c3f-rfl!)))))))
(qed 'laurent-inv-ser-agree)

;;; ---- LAURENT-MUL unfolded, as a theorem (mac-h / dk-rewrite-h! can name it) ----
(sp (make-wff '(FORALL kq_ (FORALL fq_ (FORALL gq_ (== (LAURENT-MUL kq_ fq_ gq_) (MONALG-MUL kq_ ZZ-ADD-MONOID fq_ gq_)))))))
(dk-peel!)
