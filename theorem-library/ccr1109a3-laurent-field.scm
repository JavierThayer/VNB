      ,(c3f-all 'nq_ 'ZZ `(IMPLIES (<= nq_ mq_) (= ((LAURENT-MUL kq_ fq_ ,(c3f-pre 'mq_)) nq_) ((LAURENT-ONE kq_) nq_))))))))))))))
