  `(FORALL kq_ (IMPLIES (IS-RING kq_) ,(c3f-all 'fq_ (c3f-funk 'kq_) (c3f-all 'oq_ 'ZZ `(IMPLIES ,(c3f-below 'kq_ 'fq_ 'oq_)
     ,(c3f-all 'cq_ '(CARR kq_) (c3f-all 'tq_ 'ZZ body))))))))
