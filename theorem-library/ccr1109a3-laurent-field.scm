(define (c3f-rfl!) (dk-close-if-asm!) (if (pair? (dk-open-leaves)) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))
(define (c3f-below k f b) `(FORALL lzj (IMPLIES (IN lzj ZZ) (IMPLIES (< lzj ,b) (= (,f lzj) (ZERO ,k))))))
(define (c3f-agree f f2 t) `(FORALL lzj (IMPLIES (IN lzj ZZ) (IMPLIES (<= lzj ,t) (= (,f lzj) (,f2 lzj))))))
(define (c3f-all v c body) `(FORALL ,v (IMPLIES (IN ,v ,c) ,body)))
(define (c3f-funk k) `(FUN ZZ (CARR ,k)))
(define (c3f-mm k f g) `(MONALG-MUL ,k ZZ-ADD-MONOID ,f ,g))
(define (c3f-mono k c t) `(LAURENT-MONO ,k ,c ,t))
(define (c3f-pre m) `(LAURENT-INV-PRE kq_ fq_ oq_ aq_ ,m))
(define c3f-ls '(LAURENT-SET kq_))
(define (c3f-app! k f x)
  (dk-have-and! `(IN ,f (FUN ZZ (CARR ,k))) `(IN ,x ZZ))
  (dk-cite! 'fun-apply-type f 'ZZ `(CARR ,k) x))
(define (c3f-lfun! k f)
  (if (not (dk-asm? `(IN ,f ,(c3f-funk k))))
      (begin (dk-chain-ass! (dk-cite! 'laurent-set-out k f))
