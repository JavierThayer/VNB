(let* ((k 'kq_) (f 'fq_) (o 'oq_) (c 'cq_) (t 'tq_) (mo (c3f-mono k c t)))
  (mac 'LAURENT-MUL)
  (dk-cite! 'laurent-mono-fun k c t)
  (dk-cite! 'laurent-mono-below k c t)
  (subst (dk-chain-ass! (dk-cite! 'laurent-mul-lowest k f mo o t)))
  (subst (dk-cite! 'laurent-mono-at k c t))
  (c3f-app! k f o)
  (dk-cite! 'ring-carrier-closed-mul k `(,f ,o) c)
  (c3f-rfl!))
(qed 'laurent-mul-mono-top)

