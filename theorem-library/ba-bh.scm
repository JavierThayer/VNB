;;; ==== bbh-helpers.scm
;;; bbh helpers: copies of hilbert-projection.scm's bbh- expansion helpers (prefix renamed), plus operator typing.
(define bbh-v 'v)
(define (bbh-ip a b) (list (list 'IP bbh-v) a b))
(define (bbh-sub a b) (list (list 'VADD bbh-v) a (list (list 'VNEG bbh-v) b)))
(define (bbh-add a b) (list (list 'VADD bbh-v) a b))
(define (bbh-act c a) (list (list 'ACT bbh-v) c a))
(define (bbh-q a) (bbh-ip a a))

(define (bbh-op? e op)
  (and (pair? e) (pair? (car e)) (eq? (car (car e)) op) (equal? (cadr (car e)) bbh-v)))
(define (bbh-zero? e) (equal? e (list 'VZERO bbh-v)))

;;; land (IN e (VEC v)) for a vector term built from typed atoms
(define (bbh-vt! e)
  (let ((goal (list 'IN e (list 'VEC bbh-v))))
    (cond ((and (dk-asm? goal) (not (or (bbh-op? e 'VADD) (bbh-op? e 'VNEG) (bbh-op? e 'ACT))))
           goal)
          ((dk-asm? goal)                  ; typed: still type the parts, which the laws need
           (cond ((bbh-op? e 'VADD) (bbh-vt! (cadr e)) (bbh-vt! (caddr e)))
                 ((bbh-op? e 'VNEG) (bbh-vt! (cadr e)))
                 ((bbh-op? e 'ACT)  (bbh-ct! (cadr e)) (bbh-vt! (caddr e))))
           goal)
          ((bbh-op? e 'VADD) (bbh-vt! (cadr e)) (bbh-vt! (caddr e))
                             (dk-cite! 'cips-vadd-type bbh-v (cadr e) (caddr e)) goal)
          ((bbh-op? e 'VNEG) (bbh-vt! (cadr e))
                             (dk-cite! 'cips-vneg-type bbh-v (cadr e)) goal)
          ((bbh-op? e 'ACT)  (bbh-ct! (cadr e)) (bbh-vt! (caddr e))
                             (dk-cite! 'cips-act-type bbh-v (cadr e) (caddr e)) goal)
          ((bbh-zero? e) (dk-cite! 'cips-vzero-in bbh-v) goal)
          ((bbh-app-fun e) => (lambda (ft) (bbh-arg-t! (cadr e) (cadr (caddr ft)))
                                    (dk-cite! 'fun-apply-type-c (car e) (cadr (caddr ft)) (caddr (caddr ft)) (cadr e))
                                    goal))
          (#t (error "bbh-vt!: no typing for the vector" (expression->string e))))))

;;; an application (f a) with (IN f (FUN D (VEC v))) in context: that typing
(define (bbh-app-fun e)
  (and (pair? e) (= (length e) 2)
       (find-first (lambda (h) (and (dk-head-is? h 'IN) (equal? (cadr h) (car e))
                                    (pair? (caddr h)) (eq? (car (caddr h)) 'FUN)
                                    (= (length (caddr h)) 3)
                                    (equal? (caddr (caddr h)) (list 'VEC bbh-v))))
                   (dk-asms))))
;;; type the argument a in D: by recursion when D is VEC v, else from context
(define (bbh-arg-t! a d)
  (cond ((dk-asm? (list 'IN a d)) #t)
        ((equal? d (list 'VEC bbh-v)) (bbh-vt! a))
        ((and (pair? d) (eq? (car d) 'VEC))
         (fluid-let ((bbh-v (cadr d))) (bbh-vt! a)))
        (#t (error "bbh-arg-t!: argument not typed" (expression->string (list 'IN a d))))))

;;; land (IN c CC) for a scalar term
(define (bbh-ct! c)
  (let ((goal (list 'IN c 'CC)))
    (cond ((dk-asm? goal) goal)
          ((eqv? c +i) (dk-cite! 'cc-i-in) goal)
          ((number? c) (dk-have! goal (lambda () (arith))) goal)
          ((dk-asm? (list 'IN c 'RR)) (dk-cite! 'rr-subset-cc c) goal)
          ((bbh-op? c 'IP) (bbh-vt! (cadr c)) (bbh-vt! (caddr c))
                           (dk-cite! 'cips-ip-type bbh-v (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) 'conjugate))
           (bbh-ct! (cadr c)) (dk-cite! 'cc-conjugate-closed (cadr c)) goal)
          ((and (pair? c) (memq (car c) '(* +)) (= (length c) 3))
           (bbh-ct! (cadr c)) (bbh-ct! (caddr c))
           (bbh-have-and! (list 'IN (cadr c) 'CC) (list 'IN (caddr c) 'CC))
           (dk-cite! (if (eq? (car c) '*) 'cc-mul-closed 'cc-add-closed) (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 3))
           (bbh-ct! (cadr c)) (bbh-ct! (caddr c))
           (dk-cite! 'cc-sub-in-cc (cadr c) (caddr c)) goal)
          ((and (pair? c) (eq? (car c) '-) (= (length c) 2))
           (bbh-ct! (cadr c)) (dk-cite! 'cc-neg-closed (cadr c)) goal)
          (#t (dk-have! goal (lambda () (type-term))) goal))))

;;; the first inner-product term in E (preorder) with a compound argument
(define (bbh-find-redex e)
  (cond ((not (pair? e)) #f)
        ((and (bbh-op? e 'IP) (= (length e) 3)
              (or (bbh-compound? (cadr e)) (bbh-compound? (caddr e))))
         e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((bbh-find-redex (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))
(define (bbh-compound? e)
  (or (bbh-op? e 'VADD) (bbh-op? e 'VNEG) (bbh-op? e 'ACT) (bbh-zero? e)))

;;; the law instance that opens the redex <a, b>
(define (bbh-open-law! r)
  (let ((a (cadr r)) (b (caddr r)))
    (bbh-vt! a) (bbh-vt! b)
    (cond ((bbh-op? a 'VADD) (dk-cite! 'cips-ip-add-left bbh-v (cadr a) (caddr a) b))
          ((bbh-op? a 'VNEG) (dk-cite! 'cips-ip-neg-left bbh-v (cadr a) b))
          ((bbh-op? a 'ACT)  (dk-cite! 'cips-ip-homog-left bbh-v (cadr a) (caddr a) b))
          ((bbh-zero? a)     (dk-cite! 'cips-ip-zero-left bbh-v b))
          ((bbh-op? b 'VADD) (dk-cite! 'cips-ip-add-right bbh-v a (cadr b) (caddr b)))
          ((bbh-op? b 'VNEG) (dk-cite! 'cips-ip-neg-right bbh-v a (cadr b)))
          ((bbh-op? b 'ACT)  (dk-cite! 'cips-ip-conj-homog-right bbh-v (cadr b) a (caddr b)))
          ((bbh-zero? b)     (dk-cite! 'cips-ip-zero-right bbh-v a))
          (#t (error "bbh-open-law!: not a redex" (expression->string r))))))

;;; a conjugate that can be pushed inwards: of a real (a numeral, or typed RR
;;; in context), of a product, sum, negation or conjugate, of an inner product
(define (bbh-conj-redex? e)
  (and (pair? e) (eq? (car e) 'conjugate) (= (length e) 2)
       (let ((x (cadr e)))
         (or (number? x) (dk-asm? (list 'IN x 'RR))
             (and (pair? x) (memq (car x) '(* + conjugate)))
             (and (pair? x) (eq? (car x) '-) (= (length x) 2))
             (and (bbh-op? x 'IP) (= (length x) 3))))))
(define (bbh-find-real-conj e)
  (cond ((not (pair? e)) #f)
        ((bbh-conj-redex? e) e)
        (#t (let loop ((l e))
              (cond ((not (pair? l)) #f)
                    ((bbh-find-real-conj (car l)) => (lambda (x) x))
                    (#t (loop (cdr l))))))))

;;; EXPAND the goal: every inner product of a constructed vector is opened by
;;; its law (first argument first), and every conjugate of a real is dropped,
;;; until the goal is a polynomial in inner products of ATOMS.  Loops on a redex
;;; test, never on a count.
(define (bbh-expand!)
  (let loop ((fuel 200))
    (if (<= fuel 0) (error "bbh-expand!: out of fuel"))
    (let ((r (bbh-find-redex (dk-goal))))
      (if r
          (let ((eq (bbh-open-law! r)))
            (subst eq)
            (loop (- fuel 1)))
          (let ((c (bbh-find-real-conj (dk-goal))))
            (if c
                (begin
                  (bbh-push-conj! c)
                  (loop (- fuel 1)))))))))

;;; one step of pushing a conjugate inwards
(define (bbh-push-conj! c)
  (let ((x (cadr c)))
    (cond ((or (number? x) (dk-asm? (list 'IN x 'RR)))
           (if (number? x) (dk-have! (list 'IN x 'RR) (lambda () (arith))))
           (subst (dk-cite! 'cc-conjugate-fixes-rr x)))
          ((bbh-op? x 'IP)
           (bbh-vt! (cadr x)) (bbh-vt! (caddr x))
           (dk-cite! 'cips-ip-conj-sym bbh-v (cadr x) (caddr x))
           (subst (list '= c (bbh-ip (caddr x) (cadr x)))))
          ((eq? (car x) 'conjugate)
           (bbh-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-involution (cadr x))))
          ((eq? (car x) '-)
           (bbh-ct! (cadr x)) (subst (dk-cite! 'cc-conjugate-neg (cadr x))))
          (#t
           (bbh-ct! (cadr x)) (bbh-ct! (caddr x))
           (bbh-have-and! (list 'IN (cadr x) 'CC) (list 'IN (caddr x) 'CC))
           (subst (dk-cite! (if (eq? (car x) '*) 'cc-conjugate-mul 'cc-conjugate-add)
                            (cadr x) (caddr x)))))))

;;; with (IN a RR) and (0 <= a) in context: land (IN (SQRT a) RR), 0 <= SQRT(a)
;;; and SQRT(a) * SQRT(a) = a
(define (bbh-sqrt! a)
  (if (not (dk-asm? (list 'IN (list 'SQRT a) 'RR)))
      (begin
        (dk-have! (list 'AND (list 'IN a 'RR) (list '<= 0 a)))
        (dk-split! (dk-cite! 'sqrt-nonneg a))
        (dk-cite! 'sqrt-sq a))))

;;; <u,u> is real and nonnegative
(define (bbh-q-facts! u)
  (bbh-vt! u)
  (dk-cite! 'cips-ip-self-real bbh-v u)
  (dk-cite! 'cips-ip-self-nonneg bbh-v u))

;;; rewrite ||u|| * ||u|| in the goal to <u, u>
(define (bbh-norm-sq! u)
  (bbh-vt! u)
  (subst (dk-cite! 'ip-norm-unfold bbh-v u))
  (bbh-q-facts! u)
  (bbh-sqrt! (bbh-q u))
  (subst (dk-cite! 'sqrt-sq (bbh-q u))))
(define (bbh-nsq u) (list '* (list 'IP-NORM bbh-v u) (list 'IP-NORM bbh-v u)))

;;; an IFF instance used forwards: cite THM at ARGS, land its right side (split)
(define (bbh-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))

;;; an IFF instance used backwards: its right side's conjuncts are in context;
;;; land the left side and return it
(define (bbh-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))

;;; the right-nested conjunction of FS, landed from its conjuncts in context
(define (bbh-and fs)
  (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (bbh-and (cdr fs)))))
(define (bbh-have-and! . fs)
  (let ((c (bbh-and fs)))
    (dk-have! c (lambda () (dk-conj-close! dk-ass!)))
    c))

;;; type every inner product of atoms in the goal (crs wants its atoms in CC)
(define (bbh-type-ips! e)
  (cond ((not (pair? e)) #t)
        ((bbh-op? e 'IP) (bbh-ct! e))
        ((and (eq? (car e) 'conjugate) (= (length e) 2)) (bbh-ct! e))
        (#t (for-each bbh-type-ips! e))))

(define (bbh-qd p xi) (bbh-q (bbh-sub p xi)))
(define (bbh-vec-eq! a b)
  (let ((goal (list '= a b)))
    (if (not (dk-asm? goal))
        (begin
          (bbh-vt! a) (bbh-vt! b)
          (dk-have! (list '= (bbh-qd a b) 0)
            (lambda () (bbh-expand!) (bbh-type-ips! (dk-goal)) (crs)))
          (dk-cite! 'cips-eq-of-dist-sq-zero bbh-v a b)))
    goal))

;;; Q(A) = Q(B) for two expressions of one vector, by expansion
(define (bbh-q-eq! a b)
  (let ((goal (list '= (bbh-q a) (bbh-q b))))
    (if (not (dk-asm? goal))
        (begin (bbh-vt! a) (bbh-vt! b)
               (dk-have! goal (lambda () (bbh-expand!) (bbh-type-ips! (dk-goal)) (crs)))))
    goal))

;;; ---- BA-BH additions -------------------------------------------------------------------
;;; qed, or a dump of the open leaves and an error
(define (bbh-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** BBH: ") (display name) (display " did NOT close.  Open leaves:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "BBH: unfinished" name))))
;;; dump the focus leaf (debugging)
(define (bbh-show! tag)
  (display "\n--- BBH ") (display tag) (display " GOAL: ") (display (expression->string (dk-goal))) (newline)
  (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline)) (dk-asms)))
;;; x in ks, ks a submodule of v: x in VEC v
(define (bbh-sub! ks x)
  (dk-cite! 'submodule-subset bbh-v ks)
  (dk-cite! 'subset-mem-fwd ks (list 'VEC bbh-v) x))
;;; c in CC => c in CARR(SCAL v)
(define (bbh-scal! c)
  (dk-cite! 'cips-scal-carrier bbh-v)
  (dk-have! (list 'IN c (list 'CARR (list 'SCAL bbh-v)))
            (lambda () (subst (list '= (list 'CARR (list 'SCAL bbh-v)) 'CC)) (ass))))

;;; ==== part1-proj.scm
;;; ---- PART 1: Theorem 1.53, E_K as a term, Proposition 1.55 (first half), K-perp-perp ----

;;; E_K is the orthogonal projection onto K
(set! bbh-v 'v)
(sp (make-wff '(FORALL v (FORALL kk (IMPLIES (IS-HILBERT-SPACE v) (IMPLIES (IS-SUBMODULE v kk)
   (IMPLIES (IS-CLOSED (IP-METRIC-SPACE v) kk) (IS-ORTHOGONAL-PROJECTION v kk (PROJ-OP v kk)))))))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(mac 'PROJ-OP)
(let ((io (cadddr (dk-goal))))
  (for-each
   (lambda (k)
     (dk-focus! k)
     (if (dk-head-is? (dk-goal) 'FORSOME)
         (let* ((ex (dk-cite! 'orthogonal-projection-exists 'v 'kk))
                (w  (dk-skolem! ex)))
           (ew w)
           (for-each
            (lambda (k2)
              (dk-focus! k2)
              (if (dk-head-is? (dk-goal) 'FORALL)
                  (begin
                    (dk-peel!)
                    (dk-split-all!)
                    (let* ((g (dk-goal)) (y (if (equal? (cadr g) w) (caddr g) (cadr g))))
                      (dk-cite! 'orthogonal-projection-unique 'v 'kk (cadr g) (caddr g))
                      (if (not (sequent-node-grounded? k2)) (ass))))
                  (ass)))
            (dk-opened (lambda () (di)))))
         (ass)))
   (dk-opened (lambda () (iota-d io)))))
(bbh-qed! 'proj-op-is-orthogonal-projection)

;;; ... hence E_K is the one map with that property
(sp (make-wff '(FORALL v (FORALL kk (FORALL pk (IMPLIES (IS-HILBERT-SPACE v) (IMPLIES (IS-SUBMODULE v kk)
   (IMPLIES (IS-CLOSED (IP-METRIC-SPACE v) kk) (IMPLIES (IS-ORTHOGONAL-PROJECTION v kk pk)
     (= (PROJ-OP v kk) pk))))))))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'proj-op-is-orthogonal-projection 'v 'kk)
(dk-cite! 'orthogonal-projection-unique 'v 'kk '(PROJ-OP v kk) 'pk)
(ass)
(bbh-qed! 'proj-op-unique)

;;; E_K is a linear operator (Theorem 1.53, last sentence)
(sp (make-wff '(FORALL v (FORALL kk (IMPLIES (IS-HILBERT-SPACE v) (IMPLIES (IS-SUBMODULE v kk)
   (IMPLIES (IS-CLOSED (IP-METRIC-SPACE v) kk) (IS-LINEAR-OP v v (PROJ-OP v kk)))))))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'proj-op-is-orthogonal-projection 'v 'kk)
(dk-cite! 'orthogonal-projection-type 'v 'kk '(PROJ-OP v kk))
(mac 'is-linear-op)
(dk-conj-close!
 (lambda ()
   (if (dk-head-is? (dk-goal) 'IN)
       (ass)
       (let* ((lk (dk-peel!))
              (g (dk-goal)))
         (if (bbh-op? (cadr (cadr g)) 'VADD)
             (let ((xy (cadr g)))
               (dk-cite! 'orthogonal-projection-additive 'v 'kk '(PROJ-OP v kk) (cadr (cadr xy)) (caddr (cadr xy))))
             (let ((cx (cadr (cadr g))))
               (dk-cite! 'orthogonal-projection-homogeneous 'v 'kk '(PROJ-OP v kk) (cadr cx) (caddr cx))))
         (ass)))))
(bbh-qed! 'proj-op-linear)

;;; Theorem 1.53, first part: a minimizer a of ||xi - a|| over K has xi - a orthogonal to K
(set! bbh-v 'v)
(sp (make-wff '(FORALL v (FORALL kk (FORALL xi (FORALL a_
  (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v) (IMPLIES (IS-SUBMODULE v kk)
  (IMPLIES (IN xi (VEC v)) (IMPLIES (IN a_ kk)
  (IMPLIES (FORALL hdp_ (IMPLIES (IN hdp_ kk)
             (<= ((IP v) ((VADD v) a_ ((VNEG v) xi)) ((VADD v) a_ ((VNEG v) xi)))
                 ((IP v) ((VADD v) hdp_ ((VNEG v) xi)) ((VADD v) hdp_ ((VNEG v) xi))))))
    (IN ((VADD v) xi ((VNEG v) a_)) (PERP v kk)))))))))))))
(dk-peel!)
(define bbh-p1-min (dk-pick (dk-head? 'FORALL) "the minimizing hypothesis"))
(bbh-sub! 'kk 'a_)
(bbh-vt! (bbh-sub 'xi 'a_))
(dk-have! (list 'FORALL 'prk_ (list 'IMPLIES '(IN prk_ kk) (list '= (bbh-ip (bbh-sub 'xi 'a_) 'prk_) 0)))
  (lambda ()
    (let* ((lk (dk-peel!))
           (e (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'kk))) lk))))
           (w (bbh-sub 'a_ 'xi)))
      (bbh-sub! 'kk e)
      (bbh-vt! w)
      (dk-have! (list 'FORALL 'hvt_ (list 'IMPLIES '(IN hvt_ CC)
                  (list '<= (bbh-q w) (bbh-q (bbh-add w (bbh-act 'hvt_ e))))))
        (lambda ()
          (let* ((lk2 (dk-peel!))
                 (t (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC))) lk2))))
                 (b (bbh-add 'a_ (bbh-act t e))))
            (bbh-scal! t)
            (dk-cite! 'submodule-act-closed 'v 'kk t e)
            (dk-cite! 'submodule-vadd-closed 'v 'kk 'a_ (bbh-act t e))
            (dk-apply! bbh-p1-min b)
            (bbh-q-eq! (bbh-sub b 'xi) (bbh-add w (bbh-act t e)))
            (subst (list '= (bbh-q (bbh-add w (bbh-act t e))) (bbh-q (bbh-sub b 'xi))))
            (ass))))
      (dk-cite! 'cips-variational 'v w e)
      (bbh-vt! (bbh-sub 'xi 'a_))
      (dk-have! (list '= (bbh-ip (bbh-sub 'xi 'a_) e) (list '- (bbh-ip w e)))
        (lambda () (bbh-expand!) (bbh-type-ips! (dk-goal)) (crs)))
      (subst (list '= (bbh-ip (bbh-sub 'xi 'a_) e) (list '- (bbh-ip w e))))
      (subst (list '= (bbh-ip w e) 0))
      (arith))))
(bbh-iff-bwd! 'perp-membership 'v 'kk (bbh-sub 'xi 'a_))
(ass)
(bbh-qed! 'minimizer-orthogonal)

;;; Theorem 1.53, second part: exactly one a in K has xi - a orthogonal to K
(sp (make-wff '(FORALL v (FORALL kk (FORALL xi (FORALL a1_ (FORALL a2_
  (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v) (IMPLIES (IS-SUBMODULE v kk)
  (IMPLIES (IN xi (VEC v)) (IMPLIES (IN a1_ kk) (IMPLIES (IN a2_ kk)
  (IMPLIES (IN ((VADD v) xi ((VNEG v) a1_)) (PERP v kk))
  (IMPLIES (IN ((VADD v) xi ((VNEG v) a2_)) (PERP v kk))
    (= a1_ a2_)))))))))))))))
(dk-peel!)
(bbh-sub! 'kk 'a1_)
(bbh-sub! 'kk 'a2_)
(let ((b1 (bbh-sub 'xi 'a1_)) (b2 (bbh-sub 'xi 'a2_)))
  (bbh-vec-eq! (bbh-add 'a1_ b1) (bbh-add 'a2_ b2))
  (dk-split! (dk-cite! 'hilbert-decomposition-unique 'v 'kk 'a1_ 'a2_ b1 b2))
  (ass))
(bbh-qed! 'orthogonal-point-unique)

;;; OP-RANGE unfolds
(sp (make-wff '(FORALL bov_ (FORALL bow_ (FORALL bot_ (== (OP-RANGE bov_ bow_ bot_)
  (SEP boy_ (VEC bow_) (FORSOME box_ (AND (IN box_ (VEC bov_)) (= boy_ (bot_ box_)))))))))))
(di) (mac 'OP-RANGE) (qrfl)
(bbh-qed! 'op-range-unfold)

(sp (make-wff '(FORALL bov_ (FORALL bow_ (FORALL bot_ (FORALL y_ (IFF (IN y_ (OP-RANGE bov_ bow_ bot_))
  (AND (IN y_ (VEC bow_)) (FORSOME box_ (AND (IN box_ (VEC bov_)) (= y_ (bot_ box_))))))))))))
(dk-peel!)
(let ((u (dk-cite! 'op-range-unfold 'bov_ 'bow_ 'bot_)))
  (subst u)
  (let ((sep (caddr u)))
    (dk-iff! (lambda (g) (dk-head-is? g 'AND))
      (lambda () (sep-me (list 'IN 'y_ sep)) (dk-split-all!) (dk-conj-close! dk-ass!))
      (lambda () (dk-split-all!) (in-sep! dk-ass! (lambda () (ass)))))))
(bbh-qed! 'op-range-membership)

;;; Proposition 1.55, first half: ran E_K = K
(set! bbh-v 'v)
(sp (make-wff '(FORALL v (FORALL kk (IMPLIES (IS-HILBERT-SPACE v) (IMPLIES (IS-SUBMODULE v kk)
   (IMPLIES (IS-CLOSED (IP-METRIC-SPACE v) kk) (= (OP-RANGE v v (PROJ-OP v kk)) kk))))))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'proj-op-is-orthogonal-projection 'v 'kk)
(dk-cite! 'orthogonal-projection-type 'v 'kk '(PROJ-OP v kk))
(define bbh-p1-e '(PROJ-OP v kk))
(dk-have! (list 'FORALL 'brx_ (list 'IFF (list 'IN 'brx_ (list 'OP-RANGE 'v 'v bbh-p1-e)) '(IN brx_ kk)))
  (lambda ()
    (dk-peel!)
    (let ((x (cadr (cadr (dk-goal)))))
      (dk-iff! (lambda (g) (equal? (caddr g) 'kk))
        (lambda ()
          (bbh-iff-fwd! 'op-range-membership 'v 'v bbh-p1-e x)
          (let ((y (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the preimage"))))
            (dk-split-all!)
            (dk-split! (dk-cite! 'orthogonal-projection-apply 'v 'kk bbh-p1-e y))
            (subst (list '= x (list bbh-p1-e y)))
            (ass)))
        (lambda ()
          (bbh-sub! 'kk x)
          (dk-cite! 'orthogonal-projection-fixes 'v 'kk bbh-p1-e x)
          (dk-have! (list 'FORSOME 'box_ (list 'AND (list 'IN 'box_ '(VEC v)) (list '= x (list bbh-p1-e 'box_))))
            (lambda () (ew x)
              (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) '=)
                                             (begin (subst (list '= (list bbh-p1-e x) x)) (rfl))
                                             (ass))))))
          (bbh-iff-bwd! 'op-range-membership 'v 'v bbh-p1-e x)
          (ass))))))
(dk-cite! 'class-extensionality (list 'OP-RANGE 'v 'v bbh-p1-e) 'kk)
(ass)
(bbh-qed! 'proj-op-range)

;;; K-perp-perp = K for a closed subspace K of a Hilbert space
(set! bbh-v 'v)
(sp (make-wff '(FORALL v (FORALL kk (IMPLIES (IS-HILBERT-SPACE v) (IMPLIES (IS-SUBMODULE v kk)
   (IMPLIES (IS-CLOSED (IP-METRIC-SPACE v) kk) (= (PERP v (PERP v kk)) kk))))))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'submodule-subset 'v 'kk)
(dk-cite! 'perp-subset 'v 'kk)
(dk-have! '(FORALL brx_ (IFF (IN brx_ (PERP v (PERP v kk))) (IN brx_ kk)))
  (lambda ()
    (dk-peel!)
    (let ((x (cadr (cadr (dk-goal)))))
      (dk-iff! (lambda (g) (equal? (caddr g) 'kk))
        (lambda ()
          (bbh-iff-fwd! 'perp-membership 'v '(PERP v kk) x)
          (let* ((ex (dk-cite! 'hilbert-projection-exists 'v 'kk x))
                 (a (dk-skolem! ex)))
            (dk-split-all!)
            (let ((b (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the perp part"))))
              (dk-split-all!)
              (bbh-sub! 'kk a)
              (dk-cite! 'subset-mem-fwd '(PERP v kk) '(VEC v) b)
              (dk-cite! 'perp-orth 'v '(PERP v kk) x b)
              (dk-cite! 'perp-orth 'v 'kk b a)
              (dk-have! (list '= (bbh-ip a b) 0)
                (lambda ()
                  (subst (dk-cite! 'cips-ip-conj-sym 'v b a))
                  (subst (list '= (bbh-ip b a) 0))
                  (dk-have! '(IN 0 RR) (lambda () (arith)))
                  (subst (dk-cite! 'cc-conjugate-fixes-rr 0))
                  (rfl)))
              (dk-have! (list '= (bbh-ip (bbh-add a b) b) 0)
                (lambda () (subst (list '= (bbh-add a b) x)) (ass)))
              (dk-have! (list '= (bbh-q b) 0)
                (lambda ()
                  (dk-have! (list '= (bbh-q b) (list '- (bbh-ip (bbh-add a b) b) (bbh-ip a b)))
                    (lambda () (bbh-expand!) (bbh-type-ips! (dk-goal)) (crs)))
                  (subst (list '= (bbh-q b) (list '- (bbh-ip (bbh-add a b) b) (bbh-ip a b))))
                  (subst (list '= (bbh-ip (bbh-add a b) b) 0))
                  (subst (list '= (bbh-ip a b) 0))
                  (arith)))
              (dk-cite! 'cips-ip-zero-vector 'v b)
              (subst (list '= x (bbh-add a b)))
              (subst (list '= b '(VZERO v)))
              (bbh-vec-eq! (bbh-add a '(VZERO v)) a)
              (subst (list '= (bbh-add a '(VZERO v)) a))
              (ass))))
        (lambda ()
          (bbh-sub! 'kk x)
          (dk-have! (list 'FORALL 'prk_ (list 'IMPLIES '(IN prk_ (PERP v kk)) (list '= (bbh-ip x 'prk_) 0)))
            (lambda ()
              (let* ((lk (dk-peel!))
                     (z (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(PERP v kk)))) lk)))))
                (dk-cite! 'subset-mem-fwd '(PERP v kk) '(VEC v) z)
                (dk-cite! 'perp-orth 'v 'kk z x)
                (subst (dk-cite! 'cips-ip-conj-sym 'v z x))
                (subst (list '= (bbh-ip z x) 0))
                (dk-have! '(IN 0 RR) (lambda () (arith)))
                (subst (dk-cite! 'cc-conjugate-fixes-rr 0))
                (rfl))))
          (bbh-iff-bwd! 'perp-membership 'v '(PERP v kk) x)
          (ass))))))
(dk-cite! 'class-extensionality '(PERP v (PERP v kk)) 'kk)
(ass)
(bbh-qed! 'perp-perp-closed)

;;; ==== part2-ops.scm
;;; ---- PART 2: the induced norm, bounded operators, the operator norm ---------------------

(define (bbh-n u) (list 'IP-NORM bbh-v u))
(define (bbh-nw u) (list 'IP-NORM bbh-w u))
(define bbh-w 'w)

;;; ||x|| is a nonnegative real
(sp (make-wff '(FORALL v (FORALL x_ (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v) (IMPLIES (IN x_ (VEC v))
   (IN (IP-NORM v x_) RR)))))))
(dk-peel!)
(set! bbh-v 'v)
(bbh-q-facts! 'x_)
(bbh-sqrt! (bbh-q 'x_))
(subst (dk-cite! 'ip-norm-unfold 'v 'x_))
(ass)
(bbh-qed! 'ip-norm-in-rr)

(sp (make-wff '(FORALL v (FORALL x_ (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v) (IMPLIES (IN x_ (VEC v))
   (<= 0 (IP-NORM v x_))))))))
(dk-peel!)
(bbh-q-facts! 'x_)
(bbh-sqrt! (bbh-q 'x_))
(subst (dk-cite! 'ip-norm-unfold 'v 'x_))
(ass)
(bbh-qed! 'ip-norm-nonneg)

;;; ||x|| ||x|| = <x, x>
(sp (make-wff '(FORALL v (FORALL x_ (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v) (IMPLIES (IN x_ (VEC v))
   (= (* (IP-NORM v x_) (IP-NORM v x_)) ((IP v) x_ x_))))))))
(dk-peel!)
(bbh-norm-sq! 'x_)
(rfl)
(bbh-qed! 'ip-norm-sq)

;;; ||x|| = 0 => x = 0
(sp (make-wff '(FORALL v (FORALL x_ (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v) (IMPLIES (IN x_ (VEC v))
   (IMPLIES (= (IP-NORM v x_) 0) (= x_ (VZERO v)))))))))
(dk-peel!)
(dk-cite! 'ip-norm-sq 'v 'x_)
(dk-have! (list '= (bbh-q 'x_) 0)
  (lambda ()
    (subst (list '= (bbh-q 'x_) (list '* (bbh-n 'x_) (bbh-n 'x_))))
    (subst (list '= (bbh-n 'x_) 0))
    (arith)))
(dk-cite! 'cips-ip-zero-vector 'v 'x_)
(ass)
(bbh-qed! 'ip-norm-zero-vector)

(sp (make-wff '(FORALL v (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v) (= (IP-NORM v (VZERO v)) 0)))))
(dk-peel!)
(dk-cite! 'cips-vzero-in 'v)
(subst (dk-cite! 'ip-norm-unfold 'v '(VZERO v)))
(subst (dk-cite! 'cips-ip-zero-left 'v '(VZERO v)))
(subst (dk-cite! 'sqrt-zero))
(rfl)
(bbh-qed! 'ip-norm-zero)

;;; ||c x|| = |c| ||x||
(sp (make-wff '(FORALL v (FORALL c_ (FORALL x_ (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v)
   (IMPLIES (IN c_ CC) (IMPLIES (IN x_ (VEC v))
   (= (IP-NORM v ((ACT v) c_ x_)) (* (magnitude c_) (IP-NORM v x_)))))))))))
(dk-peel!)
(let* ((cx (bbh-act 'c_ 'x_)))
  (bbh-vt! cx)
  (dk-cite! 'ip-norm-in-rr 'v cx) (dk-cite! 'ip-norm-nonneg 'v cx)
  (dk-cite! 'ip-norm-in-rr 'v 'x_) (dk-cite! 'ip-norm-nonneg 'v 'x_)
  (dk-cite! 'cc-magnitude-closed 'c_) (dk-cite! 'cc-magnitude-nonneg 'c_)
  (let ((m '(magnitude c_)))
    (dk-have! (list 'AND (list 'IN m 'RR) (list 'IN (bbh-n 'x_) 'RR)) (lambda () (dk-conj-close! dk-ass!)))
    (dk-cite! 'rr-mul-closed m (bbh-n 'x_))
    (dk-have! (list 'AND (list '<= 0 m) (list '<= 0 (bbh-n 'x_))) (lambda () (dk-conj-close! dk-ass!)))
    (dk-cite! 'rr-leq-mul-nonneg m (bbh-n 'x_))
    (dk-have! (list '= (list '* (bbh-n cx) (bbh-n cx)) (list '* (list '* m (bbh-n 'x_)) (list '* m (bbh-n 'x_))))
      (lambda ()
        (subst (dk-cite! 'ip-norm-sq 'v cx))
        (dk-have! (list '= (list '* (list '* m (bbh-n 'x_)) (list '* m (bbh-n 'x_)))
                        (list '* (list '* m m) (list '* (bbh-n 'x_) (bbh-n 'x_))))
                  (lambda () (crs)))
        (subst (list '= (list '* (list '* m (bbh-n 'x_)) (list '* m (bbh-n 'x_)))
                        (list '* (list '* m m) (list '* (bbh-n 'x_) (bbh-n 'x_)))))
        (subst (dk-cite! 'ip-norm-sq 'v 'x_))
        (subst (dk-cite! 'cc-magnitude-sq-conjugate 'c_))
        (bbh-expand!) (bbh-type-ips! (dk-goal)) (crs)))
    (dk-have! (list 'AND (list 'IN (bbh-n cx) 'RR) (list 'IN (list '* m (bbh-n 'x_)) 'RR)) (lambda () (dk-conj-close! dk-ass!)))
    (dk-have! (list 'AND (list '<= 0 (bbh-n cx)) (list '<= 0 (list '* m (bbh-n 'x_)))) (lambda () (dk-conj-close! dk-ass!)))
    (dk-cite! 'sqrt-unique (bbh-n cx) (list '* m (bbh-n 'x_)))
    (ass)))
(bbh-qed! 'ip-norm-act)

;;; ---- bounded operators ------------------------------------------------------------------
(sp (make-wff '(FORALL bov_ (FORALL bow_ (== (BOUNDED-OPS bov_ bow_)
   (SEP bot_ (FUN (VEC bov_) (VEC bow_)) (IS-BOUNDED-OP bov_ bow_ bot_)))))))
(di) (mac 'BOUNDED-OPS) (qrfl)
(bbh-qed! 'bounded-ops-unfold)

(sp (make-wff '(FORALL v (FORALL w (FORALL t_ (IFF (IN t_ (BOUNDED-OPS v w))
   (AND (IN t_ (FUN (VEC v) (VEC w))) (IS-BOUNDED-OP v w t_))))))))
(dk-peel!)
(let ((u (dk-cite! 'bounded-ops-unfold 'v 'w)))
  (subst u)
  (let ((sep (caddr u)))
    (dk-iff! (lambda (g) (dk-head-is? g 'AND))
      (lambda () (sep-me (list 'IN 't_ sep)) (dk-split-all!) (dk-conj-close! dk-ass!))
      (lambda () (dk-split-all!) (in-sep! dk-ass! (lambda () (ass)))))))
(bbh-qed! 'bounded-ops-membership)

;;; the laws of a bounded operator, as citable universals
(define (bbh-bop-law! name concl)
  (sp (make-wff (list 'FORALL 'v (list 'FORALL 'w (list 'FORALL 't_
       (list 'IMPLIES '(IN t_ (BOUNDED-OPS v w)) concl))))))
  (dk-peel!)
  (bbh-iff-fwd! 'bounded-ops-membership 'v 'w 't_)
  (mac-h 'is-bounded-op '(IS-BOUNDED-OP v w t_))
  (dk-split-all!)
  (if (not (dk-asm? (dk-goal)))
      (begin (mac-h 'is-linear-op '(IS-LINEAR-OP v w t_)) (dk-split-all!)))
  (ass)
  (bbh-qed! name))

(bbh-bop-law! 'bop-fun '(IN t_ (FUN (VEC v) (VEC w))))
(bbh-bop-law! 'bop-linear '(IS-LINEAR-OP v w t_))
(bbh-bop-law! 'bop-bound-exists
  '(FORSOME bom_ (AND (IN bom_ RR) (AND (<= 0 bom_)
     (FORALL box_ (IMPLIES (IN box_ (VEC v)) (<= (IP-NORM w (t_ box_)) (* bom_ (IP-NORM v box_)))))))))

(sp (make-wff (forall-guarded '(v w t_ x_ y_) '((IN t_ (BOUNDED-OPS v w)) (IN x_ (VEC v)) (IN y_ (VEC v)))
   '(= (t_ ((VADD v) x_ y_)) ((VADD w) (t_ x_) (t_ y_))))))
(dk-peel!)
(dk-cite! 'bop-linear 'v 'w 't_)
(mac-h 'is-linear-op '(IS-LINEAR-OP v w t_))
(dk-split-all!)
(dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(VADD v)))) "additivity") 'x_ 'y_)
(ass)
(bbh-qed! 'bop-add)

(sp (make-wff (forall-guarded '(v w t_ c_ x_) '((IN t_ (BOUNDED-OPS v w)) (IN c_ CC) (IN x_ (VEC v)))
   '(= (t_ ((ACT v) c_ x_)) ((ACT w) c_ (t_ x_))))))
(dk-peel!)
(dk-cite! 'bop-linear 'v 'w 't_)
(mac-h 'is-linear-op '(IS-LINEAR-OP v w t_))
(dk-split-all!)
(dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(ACT v)))) "homogeneity") 'c_ 'x_)
(ass)
(bbh-qed! 'bop-act)

;;; introduction: a linear operator with a bound is bounded
(sp (make-wff (forall-guarded '(v w t_ m_) '((IS-LINEAR-OP v w t_) (IN m_ RR) (<= 0 m_)
     (FORALL box_ (IMPLIES (IN box_ (VEC v)) (<= (IP-NORM w (t_ box_)) (* m_ (IP-NORM v box_))))))
   '(IN t_ (BOUNDED-OPS v w)))))
(dk-peel!)
(dk-have! '(IN t_ (FUN (VEC v) (VEC w)))
  (lambda () (mac-h 'is-linear-op '(IS-LINEAR-OP v w t_)) (dk-split-all!) (ass)))
(dk-have! '(IS-BOUNDED-OP v w t_)
  (lambda () (mac 'is-bounded-op)
    (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'FORSOME)
                                   (begin (ew 'm_) (dk-conj-close! dk-ass!))
                                   (ass))))))
(bbh-iff-bwd! 'bounded-ops-membership 'v 'w 't_)
(ass)
(bbh-qed! 'bop-intro)

;;; ---- the operator norm ------------------------------------------------------------------
(define (bbh-A t)
  (list 'SEP 'boa_ 'RR
    (list 'OR '(= boa_ 0)
      (list 'FORSOME 'box_ (list 'AND '(IN box_ (VEC v))
        (list 'AND '(NOT (= (IP-NORM v box_) 0))
          (list '= 'boa_ (list '* (list 'IP-NORM 'w (list t 'box_)) '(recip (IP-NORM v box_))))))))))

(define (bbh-mul-in! u w2)
  (dk-have! (list 'AND (list 'IN u 'RR) (list 'IN w2 'RR)) (lambda () (dk-conj-close! dk-ass!)))
  (dk-cite! 'rr-mul-closed u w2))

;;; typings of a vector xv of v and of t xv
(define (bbh-type-pt! t xv)
  (dk-cite! 'ip-norm-in-rr 'v xv)
  (dk-cite! 'ip-norm-nonneg 'v xv)
  (dk-cite! 'fun-apply-type-c t '(VEC v) '(VEC w) xv)
  (dk-cite! 'ip-norm-in-rr 'w (list t xv))
  (dk-cite! 'ip-norm-nonneg 'w (list t xv)))

(define (bbh-recip-pos! nx)
  (dk-cite! 'neq-sym nx 0)
  (dk-have! (list '< 0 nx) (lambda () (mac '<) (from-context!)))
  (dk-have! (list 'AND (list 'IN nx 'RR) (list 'NOT (list '= nx 0))) (lambda () (dk-conj-close! dk-ass!)))
  (dk-cite! 'rr-recip-closed nx)
  (dk-cite! 'rr-recip-pos nx)
  (dk-have! (list '<= 0 (list 'recip nx))
            (lambda () (mac-h '< (list '< 0 (list 'recip nx))) (dk-split-all!) (ass))))

;;; every bound c of t bounds A(t)
(define (bbh-upper-bound! t c ub-law)
  (let ((A (bbh-A t)))
    (mac 'RR-UPPER-BOUND)
    (both!
     (lambda () (ass))
     (lambda ()
       (dk-peel!)
       (let* ((u (cadr (dk-goal)))
              (cnd (car (filter (dk-head? 'OR) (dk-landed (lambda () (sep-me (list 'IN u A))))))))
         (use-cases (list (list '= u 0) (caddr cnd))
           (lambda () (subst (list '= u 0)) (ass))
           (lambda ()
             (let* ((xv (dk-skolem! (caddr cnd)))
                    (nx (list 'IP-NORM 'v xv))
                    (fx (list 'IP-NORM 'w (list t xv))))
               (dk-split-all!)
               (bbh-type-pt! t xv)
               (bbh-recip-pos! nx)
               (dk-apply! ub-law xv)
               (bbh-mul-in! c nx)
               (dk-cite! 'rr-le-scale-nonneg-right fx (list '* c nx) (list 'recip nx))
               (dk-cite! 'rr-mul-recip-cancel c nx)
               (subst (list '= u (list '* fx (list 'recip nx))))
               (subst (list '= c (list '* (list '* c nx) (list 'recip nx))))
               (ass)))))))))

(define (bbh-ub t d)
  (list 'FORALL 'x_ (list 'IMPLIES '(IN x_ (VEC v))
     (list '<= (list 'IP-NORM 'w (list t 'x_)) (list '* d '(IP-NORM v x_))))))

(sp (make-wff (list 'FORALL 'v (list 'FORALL 'w (list 'FORALL 't_
  (list 'IMPLIES '(IS-COMPLEX-INNER-PRODUCT-SPACE v) (list 'IMPLIES '(IS-COMPLEX-INNER-PRODUCT-SPACE w)
  (list 'IMPLIES '(IN t_ (BOUNDED-OPS v w))
    (list 'AND '(IN (OPNORM v w t_) RR)
      (list 'AND '(<= 0 (OPNORM v w t_))
        (list 'AND (bbh-ub 't_ '(OPNORM v w t_))
          (list 'FORALL 'd_ (list 'IMPLIES '(IN d_ RR) (list 'IMPLIES '(<= 0 d_)
            (list 'IMPLIES (bbh-ub 't_ 'd_) '(<= (OPNORM v w t_) d_))))))))))))))))
(dk-peel!)
(dk-cite! 'bop-fun 'v 'w 't_)
(define bbh-c0 (dk-skolem! (dk-cite! 'bop-bound-exists 'v 'w 't_)))
(dk-split-all!)
(define bbh-ub0 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h bbh-c0))) "the bound law"))
(mac 'OPNORM)
(define bbh-AA (bbh-A 't_))
(define bbh-sup (list 'SUP bbh-AA))
(dk-have! (list 'SUBSET bbh-AA 'RR)
  (lambda () (mac 'subset-def) (dk-peel!)
    (let ((u (cadr (dk-goal)))) (sep-me (list 'IN u bbh-AA)) (dk-split-all!) (ass))))
(dk-have! (list 'IN 0 bbh-AA)
  (lambda () (in-sep! (lambda () (dk-cite! 'rr-zero-in) (ass)) (lambda () (oi-l) (rfl)))))
(dk-have! (list 'FORSOME 'x (list 'IN 'x bbh-AA)) (lambda () (ew 0) (ass)))
(define bbh-c1 bbh-c0)
(dk-have! (list 'RR-BOUNDED-ABOVE bbh-AA)
  (lambda () (mac 'RR-BOUNDED-ABOVE) (ew bbh-c1) (bbh-upper-bound! 't_ bbh-c1 (bbh-ub 't_ bbh-c1))))
(dk-cite! 'rr-sup-in bbh-AA)
(dk-cite! 'rr-sup-upper bbh-AA)
(define bbh-supub (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x bbh-AA) (list '<= 'x bbh-sup))))
(dk-have! bbh-supub
  (lambda () (mac-h 'RR-UPPER-BOUND (list 'RR-UPPER-BOUND bbh-AA bbh-sup)) (dk-split-all!) (ass)))
(dk-have! (list '<= 0 bbh-sup) (lambda () (dk-apply! bbh-supub 0) (ass)))
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
       ((not (dk-head-is? g 'FORALL)) (ass))
       ((eq? (cadr g) 'd_)
        (dk-peel!)
        (let ((dv (caddr (dk-goal))))
          (dk-have! (list 'RR-UPPER-BOUND bbh-AA dv)
                    (lambda () (bbh-upper-bound! 't_ dv (bbh-ub 't_ dv))))
          (dk-cite! 'rr-sup-least bbh-AA dv)
          (ass)))
       (#t
        (let* ((lk (dk-peel!))
               (xv (cadr (car (filter (dk-head? 'IN) lk))))
               (nx (list 'IP-NORM 'v xv))
               (fx (list 'IP-NORM 'w (list 't_ xv))))
          (bbh-type-pt! 't_ xv)
          (dk-apply! bbh-ub0 xv)
          (bbh-mul-in! bbh-c1 nx)
          (bbh-mul-in! bbh-sup nx)
          (use-em (list '= nx 0)
            (lambda ()
              (dk-have! (list '= (list '* bbh-c1 nx) 0)
                        (lambda () (subst (list '= nx 0)) (dk-cite! 'rr-mul-zero bbh-c1) (ass)))
              (dk-have! (list '= (list '* bbh-sup nx) 0)
                        (lambda () (subst (list '= nx 0)) (dk-cite! 'rr-mul-zero bbh-sup) (ass)))
              (dk-ineq! (list '<= fx (list '* bbh-c1 nx))
                        (list '= (list '* bbh-c1 nx) 0)
                        (list '= (list '* bbh-sup nx) 0)
                        (list 'IN (list '* bbh-c1 nx) 'RR)
                        (list 'IN (list '* bbh-sup nx) 'RR)
                        (list 'IN fx 'RR)))
            (lambda ()
              (bbh-recip-pos! nx)
              (let ((q (list '* fx (list 'recip nx))))
                (bbh-mul-in! fx (list 'recip nx))
                (dk-have! (list 'IN q bbh-AA)
                  (lambda ()
                    (in-sep! (lambda () (ass))
                             (lambda () (oi-r) (ew xv)
                                        (dk-conj-close!
                                         (lambda () (if (dk-head-is? (dk-goal) '=) (rfl) (ass))))))))
                (dk-apply! bbh-supub q)
                (dk-cite! 'rr-le-scale-nonneg-right q bbh-sup nx)
                (dk-cite! 'rr-recip-cancel-right fx nx)
                (subst (list '= fx (list '* q nx)))
                (ass))))))))))
(bbh-qed! 'opnorm-spec)

;;; the four corollaries
(define (bbh-opnorm-cor! name concl)
  (sp (make-wff (list 'FORALL 'v (list 'FORALL 'w (list 'FORALL 't_
       (list 'IMPLIES '(IS-COMPLEX-INNER-PRODUCT-SPACE v) (list 'IMPLIES '(IS-COMPLEX-INNER-PRODUCT-SPACE w)
       (list 'IMPLIES '(IN t_ (BOUNDED-OPS v w)) concl))))))))
  (dk-peel!)
  (dk-split-all! (list (dk-cite! 'opnorm-spec 'v 'w 't_)))
  (if (eq? name 'opnorm-bound)
      (let ((law (find-first (lambda (h) (and (dk-head-is? h 'FORALL) (let ((b (cadr h))) (or (eq? b 'x_) (and (pair? b) (eq? (car b) 'x_)))))) (dk-asms))))
        (dk-apply! law 'x_)
        (if (not (proof-done? *ps*)) (ass)))
      (ass))
  (bbh-qed! name))
(bbh-opnorm-cor! 'opnorm-in-rr '(IN (OPNORM v w t_) RR))
(bbh-opnorm-cor! 'opnorm-nonneg '(<= 0 (OPNORM v w t_)))
(bbh-opnorm-cor! 'opnorm-bound (bbh-ub 't_ '(OPNORM v w t_)))

;;; ==== part3-adj.scm
;;; ---- PART 3: a bounded functional is continuous; the adjoint T* (Riesz) and its laws ------

;;; ---- (a) a linear functional bounded by m ||x|| is continuous --------------------------------
(define bbh-cfb-bound
  '(FORALL bcx_ (IMPLIES (IN bcx_ (VEC v)) (<= (magnitude (f bcx_)) (* m_ (IP-NORM v bcx_))))))

(define (bbh-pts-in! x)          ; (IN x (VEC v)) from (IN x (PTS (IP-METRIC-SPACE v)))
  (if (not (dk-asm? (list 'IN x '(VEC v))))
      (dk-have! (list 'IN x '(VEC v))
        (lambda () (subst '(= (VEC v) (PTS (IP-METRIC-SPACE v)))) (ass)))))

(sp (make-wff (forall-guarded '(v f m_)
   (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) '(IS-CC-LINEAR-FUNCTIONAL v f) '(IN m_ RR) '(<= 0 m_)
         bbh-cfb-bound)
   '(IS-CONTINUOUS (IP-METRIC-SPACE v) CC-MS f))))
(dk-peel!)
(set! bbh-v 'v)
(dk-cite! 'ip-metric-space-is-metric-space 'v)
(fact 'cc-is-metric-space)
(dk-cite! 'ip-metric-space-pts 'v)
(dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
(dk-split-all! (list (dk-cite! 'cc-linear-functional-laws 'v 'f)))
(dk-split-all! (list (dk-cite! 'cc-linear-functional-zero-neg 'v 'f)))
(dk-have! '(IN f (FUN (PTS (IP-METRIC-SPACE v)) (PTS CC-MS)))
  (lambda () (subst '(= (PTS (IP-METRIC-SPACE v)) (VEC v))) (subst '(= (PTS CC-MS) CC)) (ass)))
(dk-cite! 'rr-add-in-rr 'm_ 1)
(dk-have! '(< 0 (+ m_ 1)) (lambda () (dk-ineq! '(IN m_ RR) '(<= 0 m_))))
(dk-cite! 'rr-pos-ne-zero '(+ m_ 1))
(bbh-have-and! '(IN (+ m_ 1) RR) '(NOT (= (+ m_ 1) 0)))
(dk-cite! 'rr-recip-closed '(+ m_ 1))
(dk-cite! 'rr-recip-pos '(+ m_ 1))
(dk-cite! 'rr-recip-inverse '(+ m_ 1))
(define bbh-cfb-D (dk-name! '(recip (+ m_ 1))))
(dk-rewrite-h! '(< 0 (recip (+ m_ 1))) '(recip (+ m_ 1)) bbh-cfb-D)
(dk-rewrite-h! '(= (* (+ m_ 1) (recip (+ m_ 1))) 1) '(recip (+ m_ 1)) bbh-cfb-D)
(dk-cite! 'rr-mul-in-rr 'm_ bbh-cfb-D)
(define bbh-cfb-P (dk-name! (list '* 'm_ bbh-cfb-D)))
(dk-have! (list '= (list '+ bbh-cfb-P bbh-cfb-D) 1)
  (lambda ()
    (subst (list '= 1 (list '* '(+ m_ 1) bbh-cfb-D)))
    (subst (list '= bbh-cfb-P (list '* 'm_ bbh-cfb-D)))
    (crs)))
(dk-have! (list '<= bbh-cfb-P 1)
  (lambda () (dk-ineq! (list 'IN bbh-cfb-P 'RR) (list 'IN bbh-cfb-D 'RR) (list '< 0 bbh-cfb-D)
                       (list '= (list '+ bbh-cfb-P bbh-cfb-D) 1))))

;;; ineq over premises with products: name every product (* a b) of non-numerals first
(define (bbh-prod? t) (and (pair? t) (eq? (car t) '*) (= (length t) 3)
                           (not (number? (cadr t))) (not (number? (caddr t)))))
(define (bbh-prods e)
  (cond ((bbh-prod? e) (list e))
        ((and (pair? e) (memq (car e) '(<= < = + -))) (append-map bbh-prods (cdr e)))
        (#t '())))
(define (bbh-mul-type! p)          ; (IN p RR) for a product of typed factors (recursively)
  (if (not (dk-asm? (list 'IN p 'RR)))
      (begin
        (if (bbh-prod? (cadr p)) (bbh-mul-type! (cadr p)))
        (if (bbh-prod? (caddr p)) (bbh-mul-type! (caddr p)))
        (dk-cite! 'rr-mul-in-rr (cadr p) (caddr p)))))
;;; (bbh-lin! TYPINGS PREMS): every product in PREMS and in the GOAL named, then dk-ineq!
(define (bbh-lin! typings prems)
  (let* ((ps (let loop ((l (append (append-map bbh-prods prems) (bbh-prods (dk-goal)))) (acc '()))
               (cond ((null? l) (reverse acc)) ((member (car l) acc) (loop (cdr l) acc))
                     (#t (loop (cdr l) (cons (car l) acc))))))
         (names (map (lambda (p)
                       (bbh-mul-type! p)
                       (cons p (dk-name! p)))
                     ps))
         (new (map (lambda (f)
                     (let loop ((f f) (ns names))
                       (cond ((null? ns) f)
                             ((dk-contains? f (caar ns)) (loop (dk-rewrite-h! f (caar ns) (cdar ns)) (cdr ns)))
                             (#t (loop f (cdr ns))))))
                   prems)))
    (for-each (lambda (n) (if (dk-contains? (dk-goal) (car n)) (subst (list '= (car n) (cdr n))))) names)
    (apply dk-ineq! (append typings (map (lambda (n) (list 'IN (cdr n) 'RR)) names) new))))

(define (bbh-cfb-point! a b e e2)
  (let* ((D bbh-cfb-D) (P bbh-cfb-P)
         (bound (dk-ctx-form bbh-cfb-bound))
         (add (or (dk-ctx-form '(FORALL hlx_ (IMPLIES (IN hlx_ (VEC v)) (FORALL hly_ (IMPLIES (IN hly_ (VEC v))
                                   (= (f ((VADD v) hlx_ hly_)) (+ (f hlx_) (f hly_))))))))
                  (error "bbh-cfb: no additivity")))
         (neg (or (dk-ctx-form '(FORALL x_ (IMPLIES (IN x_ (VEC v)) (= (f ((VNEG v) x_)) (- (f x_))))))
                  (error "bbh-cfb: no f(-x)")))
         (nb (list '(VNEG v) b))
         (ab (bbh-sub a b))
         (N (bbh-n ab))
         (fa (list 'f a)) (fb (list 'f b)) (fab (list 'f ab)))
    (bbh-pts-in! b)
    (bbh-vt! ab)
    (dk-cite! 'ip-metric-space-dist 'v a b)
    (dk-cite! 'ip-norm-unfold 'v ab)
    (dk-cite! 'ip-norm-in-rr 'v ab)
    (dk-cite! 'ip-norm-nonneg 'v ab)
    (dk-have! (list '<= N e2)
      (lambda ()
        (subst (list '= N (list 'SQRT (bbh-q ab))))
        (subst (list '= (list 'SQRT (bbh-q ab)) (list '(DIST (IP-METRIC-SPACE v)) a b)))
        (ass)))
    (for-each (lambda (z) (dk-cite! 'fun-apply-type-c 'f '(VEC v) 'CC z)) (list a b nb ab))
    (dk-apply! bound ab)
    (dk-apply! add a nb)
    (dk-apply! neg b)
    (dk-have! (list '= (list '- fa fb) fab)
      (lambda ()
        (subst (list '= fab (list '+ fa (list 'f nb))))
        (subst (list '= (list 'f nb) (list '- fb)))
        (crs)))
    (dk-cite! 'cc-ms-dist fa fb)
    (subst (list '= (list '(DIST CC-MS) fa fb) (list 'magnitude (list '- fa fb))))
    (subst (list '= (list '- fa fb) fab))
    (dk-cite! 'cc-magnitude-closed fab)
    (dk-cite! 'rr-mul-le-right N e2 'm_)
    (dk-have! (list '= (list '* 'm_ N) (list '* N 'm_)) (lambda () (crs)))
    (dk-have! (list '= (list '* e2 'm_) (list '* P e))
      (lambda ()
        (subst (list '= e2 (list '* e D)))
        (subst (list '= P (list '* 'm_ D)))
        (crs)))
    (dk-have! (list '<= 0 e) (lambda () (dk-ineq! (list 'IN e 'RR) (list '< 0 e))))
    (dk-cite! 'rr-mul-le-right P 1 e)
    (bbh-lin! (list (list 'IN (list 'magnitude fab) 'RR) (list 'IN N 'RR) '(IN m_ RR) (list 'IN e2 'RR)
                    (list 'IN P 'RR) (list 'IN e 'RR))
         (list (list '<= (list 'magnitude fab) (list '* 'm_ N))
              (list '<= (list '* N 'm_) (list '* e2 'm_))
              (list '= (list '* 'm_ N) (list '* N 'm_))
              (list '= (list '* e2 'm_) (list '* P e))
              (list '<= (list '* P e) (list '* 1 e))))))

(define (bbh-cfb-at!)
  (dk-peel!)
  (let ((a (list-ref (dk-goal) 4)))
    (bbh-pts-in! a)
    (mac 'is-continuous-at)
    (dk-conj-close!
     (lambda ()
       (if (not (dk-head-is? (dk-goal) 'FORALL))
           (ass)
           (let* ((lk (dk-peel!))
                  (e (cadr (car (filter (dk-head? 'POS-RR) lk)))))
             (dk-cite! 'rr-lt-of-pos-rr e)
             (dk-cite! 'rr-pos-rr-in-rr e)
             (dk-cite! 'rr-mul-in-rr e bbh-cfb-D)
             (dk-cite! 'rr-mul-pos e bbh-cfb-D)
             (let ((e2 (dk-name! (list '* e bbh-cfb-D))))
               (dk-rewrite-h! (list '< 0 (list '* e bbh-cfb-D)) (list '* e bbh-cfb-D) e2)
               (dk-cite! 'rr-pos-rr-of-lt e2)
               (ew e2)
               (dk-conj-close!
                (lambda ()
                  (if (not (dk-head-is? (dk-goal) 'FORALL))
                      (ass)
                      (begin
                        (dk-peel!)
                        (let ((b (cadr (caddr (cadr (dk-goal))))))
                          (bbh-cfb-point! a b e e2)))))))))))))

(mac 'is-continuous)
(dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) 'FORALL) (bbh-cfb-at!) (ass))))
(bbh-qed! 'cc-functional-continuous-of-bound)

;;; ---- (b) x |-> <T x, y> is a bounded linear functional ---------------------------------------
(define (bbh-gy t y) (list 'VNB-LAMBDA 'bax_ '(VEC v) (list '(IP w) (list t 'bax_) y)))
(define bbh-tlaw
  '(FORALL box_ (IMPLIES (IN box_ (VEC v)) (<= (IP-NORM w (t_ box_)) (* m_ (IP-NORM v box_))))))

;;; |<T x, y>| <= (m ||y||) ||x||
(sp (make-wff (forall-guarded '(v w t_ m_ y_)
   (list '(IS-COMPLEX-INNER-PRODUCT-SPACE v) '(IS-COMPLEX-INNER-PRODUCT-SPACE w) '(IN t_ (FUN (VEC v) (VEC w)))
         '(IN m_ RR) '(<= 0 m_) bbh-tlaw '(IN y_ (VEC w)))
   '(FORALL bcx_ (IMPLIES (IN bcx_ (VEC v))
      (<= (magnitude ((IP w) (t_ bcx_) y_)) (* (* m_ (IP-NORM w y_)) (IP-NORM v bcx_))))))))
(dk-peel!)
(let* ((x (caddr (caddr (caddr (dk-goal)))))
       (tx (list 't_ x))
       (Nx (bbh-n x)) (Ny (bbh-nw 'y_)) (Ntx (bbh-nw tx))
       (mg (list 'magnitude (list '(IP w) tx 'y_))))
  (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) x)
  (dk-cite! 'ip-norm-in-rr 'v x) (dk-cite! 'ip-norm-nonneg 'v x)
  (dk-cite! 'ip-norm-in-rr 'w 'y_) (dk-cite! 'ip-norm-nonneg 'w 'y_)
  (dk-cite! 'ip-norm-in-rr 'w tx)
  (dk-cite! 'cips-ip-type 'w tx 'y_)
  (dk-cite! 'cc-magnitude-closed (list '(IP w) tx 'y_))
  (dk-apply! (dk-ctx-form bbh-tlaw) x)
  (dk-cite! 'cips-ip-magnitude-le 'w tx 'y_)
  (dk-cite! 'rr-mul-in-rr 'm_ Nx)
  (dk-cite! 'rr-mul-in-rr 'm_ Ny)
  (dk-cite! 'rr-mul-le-right Ntx (list '* 'm_ Nx) Ny)
  (dk-cite! 'rr-mul-in-rr Ntx Ny)
  (dk-cite! 'rr-mul-in-rr (list '* 'm_ Nx) Ny)
  (dk-cite! 'rr-mul-in-rr (list '* 'm_ Ny) Nx)
  (let* ((a1 (dk-name! (list '* Ntx Ny)))
         (a2 (dk-name! (list '* (list '* 'm_ Nx) Ny)))
         (b  (dk-name! (list '* (list '* 'm_ Ny) Nx))))
    (dk-rewrite-h! (list '<= mg (list '* Ntx Ny)) (list '* Ntx Ny) a1)
    (let ((h (dk-rewrite-h! (list '<= (list '* Ntx Ny) (list '* (list '* 'm_ Nx) Ny)) (list '* Ntx Ny) a1)))
      (dk-rewrite-h! h (list '* (list '* 'm_ Nx) Ny) a2))
    (dk-have! (list '= a2 b)
      (lambda ()
        (subst (list '= a2 (list '* (list '* 'm_ Nx) Ny)))
        (subst (list '= b (list '* (list '* 'm_ Ny) Nx)))
        (crs)))
    (subst (list '= (list '* (list '* 'm_ Ny) Nx) b))
    (dk-ineq! (list 'IN mg 'RR) (list 'IN a1 'RR) (list 'IN a2 'RR) (list 'IN b 'RR)
              (list '<= mg a1) (list '<= a1 a2) (list '= a2 b))))
(bbh-qed! 'bop-ip-bound)

(sp (make-wff (forall-guarded '(v w t_ y_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN t_ (BOUNDED-OPS v w)) (IN y_ (VEC w)))
   (list 'IS-CC-LINEAR-FUNCTIONAL 'v (bbh-gy 't_ 'y_)))))
(dk-peel!)
(set! bbh-v 'v)
(dk-cite! 'bop-fun 'v 'w 't_)
(mac 'is-cc-linear-functional)
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
       ((dk-head-is? g 'IN)
        (dk-lam-type! (lambda ()
                        (dk-peel!)
                        (fluid-let ((bbh-v 'w)) (bbh-ct! (cadr (dk-goal))))
                        (ass))
                      (lambda () (dk-cite! 'cips-vec-set 'v) (ass))))
       ((dk-contains? g '(VADD v))
        (dk-peel!)
        (let* ((s (cadr (cadr (dk-goal)))) (x (cadr s)) (y (caddr s)))
          (bbh-vt! s)
          (dk-lam-b!)
          (fluid-let ((bbh-v 'w)) (bbh-vt! (list 't_ x)) (bbh-vt! (list 't_ y)))
          (subst (dk-cite! 'bop-add 'v 'w 't_ x y))
          (subst (dk-cite! 'cips-ip-add-left 'w (list 't_ x) (list 't_ y) 'y_))
          (rfl)))
       (#t
        (dk-peel!)
        (let* ((s (cadr (cadr (dk-goal)))) (c (cadr s)) (x (caddr s)))
          (bbh-vt! s)
          (dk-lam-b!)
          (fluid-let ((bbh-v 'w)) (bbh-vt! (list 't_ x)))
          (subst (dk-cite! 'bop-act 'v 'w 't_ c x))
          (subst (dk-cite! 'cips-ip-homog-left 'w c (list 't_ x) 'y_))
          (rfl)))))))
(bbh-qed! 'bop-ip-functional-linear)

(sp (make-wff (forall-guarded '(v w t_ y_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN t_ (BOUNDED-OPS v w)) (IN y_ (VEC w)))
   (list 'IS-CONTINUOUS '(IP-METRIC-SPACE v) 'CC-MS (bbh-gy 't_ 'y_)))))
(dk-peel!)
(dk-cite! 'bop-fun 'v 'w 't_)
(dk-cite! 'bop-ip-functional-linear 'v 'w 't_ 'y_)
(let* ((m (dk-skolem! (dk-cite! 'bop-bound-exists 'v 'w 't_))))
  (let* ((bd (dk-cite! 'bop-ip-bound 'v 'w 't_ m 'y_))
         (k (list '* m '(IP-NORM w y_))))
    (dk-cite! 'ip-norm-in-rr 'w 'y_) (dk-cite! 'ip-norm-nonneg 'w 'y_)
    (dk-cite! 'rr-mul-in-rr m '(IP-NORM w y_))
    (bbh-have-and! (list '<= 0 m) '(<= 0 (IP-NORM w y_)))
    (bbh-have-and! (list 'IN m 'RR) '(IN (IP-NORM w y_) RR))
    (dk-cite! 'rr-leq-mul-nonneg m '(IP-NORM w y_))
    (dk-have! (list 'FORALL 'bcx_ (list 'IMPLIES '(IN bcx_ (VEC v))
                (list '<= (list 'magnitude (list (bbh-gy 't_ 'y_) 'bcx_)) (list '* k '(IP-NORM v bcx_)))))
      (lambda ()
        (dk-peel!)
        (let ((x (cadr (cadr (cadr (dk-goal))))))
          (dk-lam-b!)
          (dk-apply! bd x)
          (ass))))
    (dk-cite! 'cc-functional-continuous-of-bound 'v (bbh-gy 't_ 'y_) k)
    (ass)))
(bbh-qed! 'bop-ip-functional-continuous)

;;; ---- (c) the adjoint: <T x, y> = <x, T* y> ----------------------------------------------------
(sp (make-wff '(FORALL bov_ (FORALL bow_ (FORALL bot_ (== (OP-ADJOINT bov_ bow_ bot_)
  (VNB-LAMBDA boy_ (VEC bow_)
     (IOTA boz_ (AND (IN boz_ (VEC bov_))
                     (FORALL box_ (IMPLIES (IN box_ (VEC bov_))
                       (= ((IP bow_) (bot_ box_) boy_) ((IP bov_) box_ boz_)))))))))))))
(di) (mac 'OP-ADJOINT) (qrfl)
(bbh-qed! 'op-adjoint-unfold)

(define bbh-adj '(OP-ADJOINT v w t_))
(sp (make-wff (forall-guarded '(v w t_ y_)
   '((IS-HILBERT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN t_ (BOUNDED-OPS v w)) (IN y_ (VEC w)))
   '(AND (IN ((OP-ADJOINT v w t_) y_) (VEC v))
         (FORALL bax_ (IMPLIES (IN bax_ (VEC v))
           (= ((IP w) (t_ bax_) y_) ((IP v) bax_ ((OP-ADJOINT v w t_) y_)))))))))
(dk-peel!)
(set! bbh-v 'v)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'bop-fun 'v 'w 't_)
(dk-cite! 'bop-ip-functional-linear 'v 'w 't_ 'y_)
(dk-cite! 'bop-ip-functional-continuous 'v 'w 't_ 'y_)
(let* ((z (dk-skolem! (dk-cite! 'riesz-representation-exists 'v (bbh-gy 't_ 'y_))))
       (rep (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h z))) "the representation"))
       (repr (list 'FORALL 'bay_ (list 'IMPLIES '(IN bay_ (VEC v))
                (list '= '((IP w) (t_ bay_) y_) (list '(IP v) 'bay_ z))))))
  (dk-have! repr
    (lambda ()
      (dk-peel!)
      (let ((x (cadr (cadr (cadr (dk-goal))))))
        (let ((h (dk-apply! rep x)))
          (dk-lam-b-h! h)
          (ass)))))
  (subst (dk-cite! 'op-adjoint-unfold 'v 'w 't_))
  (dk-lam-b!)
  (let ((io (cadr (cadr (dk-goal)))))
    (for-each
     (lambda (k)
       (dk-focus! k)
       (if (dk-head-is? (dk-goal) 'FORSOME)
           (begin
             (ew z)
             (dk-conj-close!
              (lambda ()
                (if (not (and (dk-head-is? (dk-goal) 'FORALL)
                              (dk-head-is? (cadr (caddr (dk-goal))) 'AND)))
                    (ass)
                    (let ((g (dk-goal)))
                      (if #f
                          #f
                          (begin
                            (dk-peel!)
                            (dk-split-all!)
                            (let* ((g (dk-goal)) (y2 (if (equal? (cadr g) z) (caddr g) (cadr g)))
                                   (r2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h y2)
                                                                 (dk-contains? h '(IP w)))) "y2 rep")))
                              (dk-have! (list 'FORALL 'bay_ (list 'IMPLIES '(IN bay_ (VEC v))
                                          (list '= (list '(IP v) 'bay_ (cadr g)) (list '(IP v) 'bay_ (caddr g)))))
                                (lambda ()
                                  (dk-peel!)
                                  (let ((x (cadr (cadr (dk-goal)))))
                                    (dk-apply! r2 x)
                                    (dk-apply! (dk-ctx-form repr) x)
                                    (subst (list '= (list '(IP v) x y2) (list '(IP w) (list 't_ x) 'y_)))
                                    (subst (list '= (list '(IP v) x z) (list '(IP w) (list 't_ x) 'y_)))
                                    (rfl))))
                              (dk-cite! 'cips-ip-separates 'v (cadr g) (caddr g))
                              (ass)))))))))
           (ass)))
     (dk-opened (lambda () (iota-d io))))))
(bbh-qed! 'op-adjoint-spec)

(define (bbh-adj-cor! name concl)
  (sp (make-wff (forall-guarded '(v w t_ y_)
     '((IS-HILBERT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN t_ (BOUNDED-OPS v w)) (IN y_ (VEC w)))
     concl)))
  (dk-peel!)
  (dk-split-all! (list (dk-cite! 'op-adjoint-spec 'v 'w 't_ 'y_)))
  (ass)
  (bbh-qed! name))
(bbh-adj-cor! 'op-adjoint-type '(IN ((OP-ADJOINT v w t_) y_) (VEC v)))
(sp (make-wff (forall-guarded '(v w t_ x_ y_)
   '((IS-HILBERT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN t_ (BOUNDED-OPS v w)) (IN x_ (VEC v)) (IN y_ (VEC w)))
   '(= ((IP w) (t_ x_) y_) ((IP v) x_ ((OP-ADJOINT v w t_) y_))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'op-adjoint-spec 'v 'w 't_ 'y_)))
(dk-apply! (dk-ctx-form '(FORALL bax_ (IMPLIES (IN bax_ (VEC v))
           (= ((IP w) (t_ bax_) y_) ((IP v) bax_ ((OP-ADJOINT v w t_) y_)))))) 'x_)
(ass)
(bbh-qed! 'op-adjoint-ip)

;;; ==== part4-adjlaws.scm
;;; ---- PART 4: the laws of the adjoint; composition and identity -------------------------------

(define bbh-H '((IS-HILBERT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN t_ (BOUNDED-OPS v w))))
(define bbh-TS '(OP-ADJOINT v w t_))
(define (bbh-H0!)
  (dk-peel!)
  (set! bbh-v 'v)
  (dk-cite! 'hilbert-space-is-cips 'v)
  (dk-cite! 'bop-fun 'v 'w 't_))
(define (bbh-ipv a b) (list '(IP v) a b))
(define (bbh-ipw a b) (list '(IP w) a b))

;;; T* : w -> v
(sp (make-wff (forall-guarded '(v w t_) bbh-H (list 'IN bbh-TS '(FUN (VEC w) (VEC v))))))
(bbh-H0!)
(let ((u (dk-cite! 'op-adjoint-unfold 'v 'w 't_)))
  (subst u)
  (dk-lam-type!
   (lambda ()
     (let* ((lk (dk-peel!))
            (y (cadr (car (filter (dk-head? 'IN) lk)))))
       (dk-cite! 'op-adjoint-type 'v 'w 't_ y)
       (let ((h (dk-rewrite-h! (list 'IN (list bbh-TS y) '(VEC v)) bbh-TS (caddr u))))
         (if (not (dk-lam-b-h! h)) (ass)))))
   (lambda () (dk-cite! 'cips-vec-set 'w) (ass))))
(bbh-qed! 'op-adjoint-fun)

;;; T* is the only map g with <T x, y> = <x, g y>
(define bbh-adj-rel
  '(FORALL bax_ (IMPLIES (IN bax_ (VEC v)) (FORALL bay_ (IMPLIES (IN bay_ (VEC w))
     (= ((IP w) (t_ bax_) bay_) ((IP v) bax_ (g_ bay_))))))))
(sp (make-wff (forall-guarded '(v w t_ g_) (append bbh-H (list '(IN g_ (FUN (VEC w) (VEC v))) bbh-adj-rel))
   (list '= bbh-TS 'g_))))
(bbh-H0!)
(dk-cite! 'op-adjoint-fun 'v 'w 't_)
(let ((hyp (dk-ctx-form bbh-adj-rel)))
  (dk-fun-ext! bbh-TS 'g_ '(VEC w) '(VEC v) #f #f
    (lambda (y)
      (let ((ty (list bbh-TS y)) (gy (list 'g_ y)))
        (dk-cite! 'op-adjoint-type 'v 'w 't_ y)
        (dk-cite! 'fun-apply-type-c 'g_ '(VEC w) '(VEC v) y)
        (dk-have! (list 'FORALL 'bbz_ (list 'IMPLIES '(IN bbz_ (VEC v)) (list '= (bbh-ipv 'bbz_ ty) (bbh-ipv 'bbz_ gy))))
          (lambda ()
            (dk-peel!)
            (let ((x (cadr (cadr (dk-goal)))))
              (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) x)
              (dk-cite! 'op-adjoint-ip 'v 'w 't_ x y)
              (dk-apply! hyp x y)
              (subst (list '= (bbh-ipv x ty) (bbh-ipw (list 't_ x) y)))
              (subst (list '= (bbh-ipv x gy) (bbh-ipw (list 't_ x) y)))
              (rfl))))
        (dk-cite! 'cips-ip-separates 'v ty gy)
        (ass)))))
(bbh-qed! 'op-adjoint-unique)

;;; ||T* y|| <= m ||y|| for every bound m of T
(sp (make-wff (forall-guarded '(v w t_ m_ y_)
   (append bbh-H (list '(IN m_ RR) '(<= 0 m_) bbh-tlaw '(IN y_ (VEC w))))
   (list '<= (list 'IP-NORM 'v (list bbh-TS 'y_)) '(* m_ (IP-NORM w y_))))))
(bbh-H0!)
(let* ((ty (list bbh-TS 'y_)) (ny '(IP-NORM w y_)))
  (dk-cite! 'op-adjoint-type 'v 'w 't_ 'y_)
  (dk-cite! 'ip-norm-in-rr 'w 'y_) (dk-cite! 'ip-norm-nonneg 'w 'y_)
  (dk-cite! 'rr-mul-in-rr 'm_ ny)
  (bbh-have-and! '(<= 0 m_) (list '<= 0 ny))
  (bbh-have-and! '(IN m_ RR) (list 'IN ny 'RR))
  (dk-cite! 'rr-leq-mul-nonneg 'm_ ny)
  (let ((bd (dk-cite! 'bop-ip-bound 'v 'w 't_ 'm_ 'y_)))
    (dk-have! (list 'FORALL 'hrx_ (list 'IMPLIES '(IN hrx_ (VEC v))
                (list '<= (list 'magnitude (bbh-ipv 'hrx_ ty)) (list '* (list '* 'm_ ny) '(IP-NORM v hrx_)))))
      (lambda ()
        (dk-peel!)
        (let ((x (cadr (cadr (cadr (dk-goal))))))
          (dk-cite! 'op-adjoint-ip 'v 'w 't_ x 'y_)
          (subst (list '= (bbh-ipv x ty) (bbh-ipw (list 't_ x) 'y_)))
          (dk-apply! bd x)
          (ass))))
    (dk-cite! 'cips-ip-bound-least 'v ty (list '* 'm_ ny))
    (ass)))
(bbh-qed! 'op-adjoint-bound)

;;; T* is linear
(define (bbh-adj-sep! lhs rhs prove-ip!)   ; lhs = rhs in VEC v, by <x, lhs> = <x, rhs> for all x
  (dk-have! (list 'FORALL 'bbz_ (list 'IMPLIES '(IN bbz_ (VEC v)) (list '= (bbh-ipv 'bbz_ lhs) (bbh-ipv 'bbz_ rhs))))
    (lambda ()
      (dk-peel!)
      (let ((x (cadr (cadr (dk-goal)))))
        (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) x)
        (prove-ip! x))))
  (dk-cite! 'cips-ip-separates 'v lhs rhs)
  (ass))

(sp (make-wff (forall-guarded '(v w t_) bbh-H (list 'IS-LINEAR-OP 'w 'v bbh-TS))))
(bbh-H0!)
(dk-cite! 'op-adjoint-fun 'v 'w 't_)
(mac 'is-linear-op)
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
       ((dk-head-is? g 'IN) (ass))
       ((dk-contains? g '(VADD w))
        (dk-peel!)
        (let* ((s (cadr (cadr (dk-goal)))) (y1 (cadr s)) (y2 (caddr s))
               (t1 (list bbh-TS y1)) (t2 (list bbh-TS y2)) (ts (list bbh-TS s)))
          (fluid-let ((bbh-v 'w)) (bbh-vt! s))
          (for-each (lambda (y) (dk-cite! 'op-adjoint-type 'v 'w 't_ y)) (list s y1 y2))
          (bbh-vt! (caddr (dk-goal)))
          (bbh-adj-sep! ts (caddr (dk-goal))
            (lambda (x)
              (let ((tx (list 't_ x)))
                (for-each (lambda (y) (dk-cite! 'op-adjoint-ip 'v 'w 't_ x y)) (list s y1 y2))
                (subst (list '= (bbh-ipv x ts) (bbh-ipw tx s)))
                (subst (dk-cite! 'cips-ip-add-right 'w tx y1 y2))
                (subst (dk-cite! 'cips-ip-add-right 'v x t1 t2))
                (subst (list '= (bbh-ipv x t1) (bbh-ipw tx y1)))
                (subst (list '= (bbh-ipv x t2) (bbh-ipw tx y2)))
                (rfl))))))
       (#t
        (dk-peel!)
        (let* ((s (cadr (cadr (dk-goal)))) (c (cadr s)) (y (caddr s))
               (t1 (list bbh-TS y)) (ts (list bbh-TS s)))
          (fluid-let ((bbh-v 'w)) (bbh-vt! s))
          (for-each (lambda (y) (dk-cite! 'op-adjoint-type 'v 'w 't_ y)) (list s y))
          (bbh-vt! (caddr (dk-goal)))
          (bbh-adj-sep! ts (caddr (dk-goal))
            (lambda (x)
              (let ((tx (list 't_ x)))
                (for-each (lambda (y) (dk-cite! 'op-adjoint-ip 'v 'w 't_ x y)) (list s y))
                (subst (list '= (bbh-ipv x ts) (bbh-ipw tx s)))
                (subst (dk-cite! 'cips-ip-conj-homog-right 'w c tx y))
                (subst (dk-cite! 'cips-ip-conj-homog-right 'v c x t1))
                (subst (list '= (bbh-ipv x t1) (bbh-ipw tx y)))
                (rfl))))))))))
(bbh-qed! 'op-adjoint-linear)

;;; T* is bounded
(sp (make-wff (forall-guarded '(v w t_) bbh-H (list 'IN bbh-TS '(BOUNDED-OPS w v)))))
(bbh-H0!)
(dk-cite! 'op-adjoint-linear 'v 'w 't_)
(let ((m (dk-skolem! (dk-cite! 'bop-bound-exists 'v 'w 't_))))
  (dk-have! (list 'FORALL 'box_ (list 'IMPLIES '(IN box_ (VEC w))
              (list '<= (list 'IP-NORM 'v (list bbh-TS 'box_)) (list '* m '(IP-NORM w box_)))))
    (lambda ()
      (dk-peel!)
      (let ((y (caddr (caddr (caddr (dk-goal))))))
        (dk-cite! 'op-adjoint-bound 'v 'w 't_ m y)
        (ass))))
  (dk-cite! 'bop-intro 'w 'v bbh-TS m)
  (ass))
(bbh-qed! 'op-adjoint-bounded)

;;; ||T*|| <= ||T||
(sp (make-wff (forall-guarded '(v w t_) bbh-H
   (list '<= (list 'OPNORM 'w 'v bbh-TS) '(OPNORM v w t_)))))
(bbh-H0!)
(dk-cite! 'op-adjoint-bounded 'v 'w 't_)
(dk-cite! 'opnorm-in-rr 'v 'w 't_)
(dk-cite! 'opnorm-nonneg 'v 'w 't_)
(dk-cite! 'opnorm-bound 'v 'w 't_)
(dk-have! (list 'FORALL 'box_ (list 'IMPLIES '(IN box_ (VEC w))
            (list '<= (list 'IP-NORM 'v (list bbh-TS 'box_)) '(* (OPNORM v w t_) (IP-NORM w box_)))))
  (lambda ()
    (dk-peel!)
    (let ((y (caddr (caddr (caddr (dk-goal))))))
      (dk-cite! 'op-adjoint-bound 'v 'w 't_ '(OPNORM v w t_) y)
      (ass))))
(dk-split-all! (list (dk-cite! 'opnorm-spec 'w 'v bbh-TS)))
(dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'd_) (dk-contains? h 'OP-ADJOINT)))
                    "the least-bound clause")
           '(OPNORM v w t_))
(ass)
(bbh-qed! 'op-adjoint-opnorm-le)

;;; T** = T
(sp (make-wff (forall-guarded '(v w t_) '((IS-HILBERT-SPACE v) (IS-HILBERT-SPACE w) (IN t_ (BOUNDED-OPS v w)))
   (list '= (list 'OP-ADJOINT 'w 'v bbh-TS) 't_))))
(dk-peel!)
(set! bbh-v 'v)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'hilbert-space-is-cips 'w)
(dk-cite! 'bop-fun 'v 'w 't_)
(dk-cite! 'op-adjoint-bounded 'v 'w 't_)
(dk-have! (list 'FORALL 'bax_ (list 'IMPLIES '(IN bax_ (VEC w)) (list 'FORALL 'bay_ (list 'IMPLIES '(IN bay_ (VEC v))
            (list '= (bbh-ipv (list bbh-TS 'bax_) 'bay_) (bbh-ipw 'bax_ '(t_ bay_)))))))
  (lambda ()
    (dk-peel!)
    (let* ((g (dk-goal)) (y (cadr (cadr (cadr g)))) (x (caddr (cadr g))) (ty (list bbh-TS y)))
      (dk-cite! 'op-adjoint-type 'v 'w 't_ y)
      (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) x)
      (subst (dk-cite! 'cips-ip-conj-sym 'v x ty))
      (dk-cite! 'op-adjoint-ip 'v 'w 't_ x y)
      (subst (list '= (bbh-ipv x ty) (bbh-ipw (list 't_ x) y)))
      (subst (dk-cite! 'cips-ip-conj-sym 'w (list 't_ x) y))
      (rfl))))
(dk-cite! 'op-adjoint-unique 'w 'v bbh-TS 't_)
(ass)
(bbh-qed! 'op-adjoint-involutive)

;;; ---- composition and identity ------------------------------------------------------------------
(sp (make-wff (forall-guarded '(v s_ t_ x_)
   '((IN s_ (FUN (VEC v) (VEC v))) (IN t_ (FUN (VEC v) (VEC v))) (IN x_ (VEC v)))
   '(= ((BOP-COMP v s_ t_) x_) (s_ (t_ x_))))))
(dk-peel!)
(dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) 'x_)
(dk-cite! 'fun-apply-type-c 's_ '(VEC v) '(VEC v) '(t_ x_))
(mac 'BOP-COMP)
(dk-lam-b!)
(rfl)
(bbh-qed! 'bop-comp-apply)

(sp (make-wff (forall-guarded '(v x_) '((IN x_ (VEC v))) '(= ((BOP-ID v) x_) x_))))
(dk-peel!)
(mac 'BOP-ID)
(dk-lam-b!)
(rfl)
(bbh-qed! 'bop-id-apply)

(define bbh-C '(BOP-COMP v s_ t_))
(define (bbh-capp! x)                   ; rewrite (C x) to s(t x) in the goal
  (bbh-vt! x)
  (subst (dk-cite! 'bop-comp-apply 'v 's_ 't_ x)))

(sp (make-wff (forall-guarded '(v s_ t_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN s_ (BOUNDED-OPS v v)) (IN t_ (BOUNDED-OPS v v)))
   (list 'IN bbh-C '(BOUNDED-OPS v v)))))
(dk-peel!)
(set! bbh-v 'v)
(dk-cite! 'bop-fun 'v 'v 's_)
(dk-cite! 'bop-fun 'v 'v 't_)
(dk-have! (list 'IS-LINEAR-OP 'v 'v bbh-C)
  (lambda ()
    (mac 'is-linear-op)
    (dk-conj-close!
     (lambda ()
       (let ((g (dk-goal)))
         (cond
           ((dk-head-is? g 'IN)
            (mac 'BOP-COMP)
            (dk-lam-type! (lambda () (dk-peel!) (bbh-vt! (cadr (dk-goal))) (ass))
                          (lambda () (dk-cite! 'cips-vec-set 'v) (ass))))
           ((dk-contains? g '(VADD v))
            (dk-peel!)
            (let* ((s (cadr (cadr (dk-goal)))) (x (cadr s)) (y (caddr s)))
              (bbh-capp! s) (bbh-capp! x) (bbh-capp! y)
              (bbh-vt! (list 't_ x)) (bbh-vt! (list 't_ y))
              (subst (dk-cite! 'bop-add 'v 'v 't_ x y))
              (subst (dk-cite! 'bop-add 'v 'v 's_ (list 't_ x) (list 't_ y)))
              (rfl)))
           (#t
            (dk-peel!)
            (let* ((s (cadr (cadr (dk-goal)))) (c (cadr s)) (x (caddr s)))
              (bbh-capp! s) (bbh-capp! x)
              (bbh-vt! (list 't_ x))
              (subst (dk-cite! 'bop-act 'v 'v 't_ c x))
              (subst (dk-cite! 'bop-act 'v 'v 's_ c (list 't_ x)))
              (rfl)))))))))
(let* ((m1 (dk-skolem! (dk-cite! 'bop-bound-exists 'v 'v 's_)))
       (l1 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m1))) "bound of s"))
       (m2 (dk-skolem! (dk-cite! 'bop-bound-exists 'v 'v 't_)))
       (l2 (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h m2))) "bound of t"))
       (mm (list '* m1 m2)))
  (dk-cite! 'rr-mul-in-rr m1 m2)
  (bbh-have-and! (list 'IN m1 'RR) (list 'IN m2 'RR))
  (bbh-have-and! (list '<= 0 m1) (list '<= 0 m2))
  (dk-cite! 'rr-leq-mul-nonneg m1 m2)
  (dk-have! (list 'FORALL 'box_ (list 'IMPLIES '(IN box_ (VEC v))
              (list '<= (list 'IP-NORM 'v (list bbh-C 'box_)) (list '* mm '(IP-NORM v box_)))))
    (lambda ()
      (dk-peel!)
      (let* ((x (caddr (caddr (caddr (dk-goal)))))
             (tx (list 't_ x)) (stx (list 's_ tx))
             (nx (bbh-n x)) (ntx (bbh-n tx)) (nstx (bbh-n stx)))
        (bbh-capp! x)
        (bbh-vt! stx)
        (for-each (lambda (z) (dk-cite! 'ip-norm-in-rr 'v z) (dk-cite! 'ip-norm-nonneg 'v z)) (list x tx stx))
        (dk-apply! l1 tx)
        (dk-apply! l2 x)
        (dk-cite! 'rr-mul-in-rr m2 nx)
        (dk-cite! 'rr-mul-le-right ntx (list '* m2 nx) m1)
        (dk-have! (list '= (list '* m1 ntx) (list '* ntx m1)) (lambda () (crs)))
        (dk-have! (list '= (list '* (list '* m2 nx) m1) (list '* mm nx)) (lambda () (crs)))
        (bbh-lin! (list (list 'IN nstx 'RR) (list 'IN ntx 'RR) (list 'IN nx 'RR) (list 'IN m1 'RR) (list 'IN m2 'RR))
                  (list (list '<= nstx (list '* m1 ntx))
                        (list '<= (list '* ntx m1) (list '* (list '* m2 nx) m1))
                        (list '= (list '* m1 ntx) (list '* ntx m1))
                        (list '= (list '* (list '* m2 nx) m1) (list '* mm nx)))))))
  (dk-cite! 'bop-intro 'v 'v bbh-C mm)
  (ass))
(bbh-qed! 'bop-comp-bounded)

(sp (make-wff (forall-guarded '(v) '((IS-COMPLEX-INNER-PRODUCT-SPACE v)) '(IN (BOP-ID v) (BOUNDED-OPS v v)))))
(dk-peel!)
(set! bbh-v 'v)
(dk-have! '(IS-LINEAR-OP v v (BOP-ID v))
  (lambda ()
    (mac 'is-linear-op)
    (dk-conj-close!
     (lambda ()
       (let ((g (dk-goal)))
         (cond
           ((dk-head-is? g 'IN)
            (mac 'BOP-ID)
            (dk-lam-type! (lambda () (dk-peel!) (ass))
                          (lambda () (dk-cite! 'cips-vec-set 'v) (ass))))
           (#t
            (dk-peel!)
            (let ((s (cadr (cadr (dk-goal)))))
              (bbh-vt! s)
              (for-each (lambda (z) (subst (dk-cite! 'bop-id-apply 'v z)))
                        (if (bbh-op? s 'VADD) (list s (cadr s) (caddr s)) (list s (caddr s))))
              (rfl)))))))))
(dk-have! '(FORALL box_ (IMPLIES (IN box_ (VEC v)) (<= (IP-NORM v ((BOP-ID v) box_)) (* 1 (IP-NORM v box_)))))
  (lambda ()
    (dk-peel!)
    (let ((x (caddr (caddr (caddr (dk-goal))))))
      (subst (dk-cite! 'bop-id-apply 'v x))
      (dk-cite! 'ip-norm-in-rr 'v x)
      (dk-ineq! (list 'IN (bbh-n x) 'RR)))))
(dk-have! '(IN 1 RR) (lambda () (arith)))
(dk-have! '(<= 0 1) (lambda () (arith)))
(dk-cite! 'bop-intro 'v 'v '(BOP-ID v) 1)
(ass)
(bbh-qed! 'bop-id-bounded)

;;; (S T)* = T* S*
(sp (make-wff (forall-guarded '(v s_ t_) '((IS-HILBERT-SPACE v) (IN s_ (BOUNDED-OPS v v)) (IN t_ (BOUNDED-OPS v v)))
   (list '= (list 'OP-ADJOINT 'v 'v bbh-C) '(BOP-COMP v (OP-ADJOINT v v t_) (OP-ADJOINT v v s_))))))
(dk-peel!)
(set! bbh-v 'v)
(dk-cite! 'hilbert-space-is-cips 'v)
(let* ((ss '(OP-ADJOINT v v s_)) (ts '(OP-ADJOINT v v t_)) (g (list 'BOP-COMP 'v ts ss)))
  (dk-cite! 'op-adjoint-bounded 'v 'v 's_)
  (dk-cite! 'op-adjoint-bounded 'v 'v 't_)
  (dk-cite! 'bop-comp-bounded 'v 's_ 't_)
  (dk-cite! 'bop-comp-bounded 'v ts ss)
  (for-each (lambda (f) (dk-cite! 'bop-fun 'v 'v f)) (list 's_ 't_ ss ts g))
  (dk-have! (list 'FORALL 'bax_ (list 'IMPLIES '(IN bax_ (VEC v)) (list 'FORALL 'bay_ (list 'IMPLIES '(IN bay_ (VEC v))
              (list '= (bbh-ipv (list bbh-C 'bax_) 'bay_) (bbh-ipv 'bax_ (list g 'bay_)))))))
    (lambda ()
      (dk-peel!)
      (let* ((gl (dk-goal)) (x (cadr (cadr (cadr gl)))) (y (caddr (cadr gl)))
             (tx (list 't_ x)) (sy (list ss y)))
        (subst (dk-cite! 'bop-comp-apply 'v 's_ 't_ x))
        (dk-cite! 'op-adjoint-type 'v 'v 's_ y)
        (subst (dk-cite! 'bop-comp-apply 'v ts ss y))
        (bbh-vt! tx)
        (dk-cite! 'op-adjoint-type 'v 'v 't_ sy)
        (subst (dk-cite! 'op-adjoint-ip 'v 'v 's_ tx y))
        (subst (dk-cite! 'op-adjoint-ip 'v 'v 't_ x sy))
        (rfl))))
  (dk-cite! 'op-adjoint-unique 'v 'v bbh-C g)
  (ass))
(bbh-qed! 'op-adjoint-comp)

;;; I* = I
(sp (make-wff (forall-guarded '(v) '((IS-HILBERT-SPACE v)) '(= (OP-ADJOINT v v (BOP-ID v)) (BOP-ID v)))))
(dk-peel!)
(set! bbh-v 'v)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'bop-id-bounded 'v)
(dk-cite! 'bop-fun 'v 'v '(BOP-ID v))
(dk-have! '(FORALL bax_ (IMPLIES (IN bax_ (VEC v)) (FORALL bay_ (IMPLIES (IN bay_ (VEC v))
            (= ((IP v) ((BOP-ID v) bax_) bay_) ((IP v) bax_ ((BOP-ID v) bay_)))))))
  (lambda ()
    (dk-peel!)
    (let* ((gl (dk-goal)) (x (cadr (cadr (cadr gl)))) (y (caddr (cadr gl))))
      (subst (dk-cite! 'bop-id-apply 'v x))
      (subst (dk-cite! 'bop-id-apply 'v y))
      (rfl))))
(dk-cite! 'op-adjoint-unique 'v 'v '(BOP-ID v) '(BOP-ID v))
(ass)
(bbh-qed! 'op-adjoint-id)

;;; ==== part5-cstar.scm
;;; ---- PART 5: ||S T|| <= ||S|| ||T|| and the C* identity ||T* T|| = ||T||^2 ----------------------

(define (bbh-opn t) (list 'OPNORM 'v 'v t))
(define (bbh-least t)                    ; the least-bound clause of opnorm-spec for t, in context
  (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'd_) (dk-contains? h (bbh-opn t))))
           "the least-bound clause"))

;;; ||S T|| <= ||S|| ||T||
(sp (make-wff (forall-guarded '(v s_ t_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN s_ (BOUNDED-OPS v v)) (IN t_ (BOUNDED-OPS v v)))
   (list '<= (bbh-opn bbh-C) (list '* (bbh-opn 's_) (bbh-opn 't_))))))
(dk-peel!)
(set! bbh-v 'v)
(dk-cite! 'bop-fun 'v 'v 's_)
(dk-cite! 'bop-fun 'v 'v 't_)
(dk-cite! 'bop-comp-bounded 'v 's_ 't_)
(let* ((m1 (bbh-opn 's_)) (m2 (bbh-opn 't_)) (mm (list '* m1 m2))
       (l1 (dk-cite! 'opnorm-bound 'v 'v 's_))
       (l2 (dk-cite! 'opnorm-bound 'v 'v 't_)))
  (for-each (lambda (f) (dk-cite! 'opnorm-in-rr 'v 'v f) (dk-cite! 'opnorm-nonneg 'v 'v f)) (list 's_ 't_))
  (dk-cite! 'rr-mul-in-rr m1 m2)
  (bbh-have-and! (list 'IN m1 'RR) (list 'IN m2 'RR))
  (bbh-have-and! (list '<= 0 m1) (list '<= 0 m2))
  (dk-cite! 'rr-leq-mul-nonneg m1 m2)
  (dk-have! (list 'FORALL 'box_ (list 'IMPLIES '(IN box_ (VEC v))
              (list '<= (list 'IP-NORM 'v (list bbh-C 'box_)) (list '* mm '(IP-NORM v box_)))))
    (lambda ()
      (dk-peel!)
      (let* ((x (caddr (caddr (caddr (dk-goal)))))
             (tx (list 't_ x)) (stx (list 's_ tx))
             (nx (bbh-n x)) (ntx (bbh-n tx)) (nstx (bbh-n stx)))
        (bbh-capp! x)
        (bbh-vt! stx)
        (for-each (lambda (z) (dk-cite! 'ip-norm-in-rr 'v z) (dk-cite! 'ip-norm-nonneg 'v z)) (list x tx stx))
        (dk-apply! l1 tx)
        (dk-apply! l2 x)
        (dk-cite! 'rr-mul-in-rr m2 nx)
        (dk-cite! 'rr-mul-le-right ntx (list '* m2 nx) m1)
        (dk-have! (list '= (list '* m1 ntx) (list '* ntx m1)) (lambda () (crs)))
        (dk-have! (list '= (list '* (list '* m2 nx) m1) (list '* mm nx)) (lambda () (crs)))
        (bbh-lin! (list (list 'IN nstx 'RR) (list 'IN ntx 'RR) (list 'IN nx 'RR) (list 'IN m1 'RR) (list 'IN m2 'RR))
                  (list (list '<= nstx (list '* m1 ntx))
                        (list '<= (list '* ntx m1) (list '* (list '* m2 nx) m1))
                        (list '= (list '* m1 ntx) (list '* ntx m1))
                        (list '= (list '* (list '* m2 nx) m1) (list '* mm nx)))))))
  (dk-split-all! (list (dk-cite! 'opnorm-spec 'v 'v bbh-C)))
  (dk-apply! (bbh-least bbh-C) mm)
  (ass))
(bbh-qed! 'opnorm-comp-le)

;;; THE C* IDENTITY: ||T* T|| = ||T|| ||T||
(define bbh-ta '(BOP-COMP v (OP-ADJOINT v v t_) t_))
(sp (make-wff (forall-guarded '(v t_) '((IS-HILBERT-SPACE v) (IN t_ (BOUNDED-OPS v v)))
   (list '= (bbh-opn bbh-ta) (list '* (bbh-opn 't_) (bbh-opn 't_))))))
(dk-peel!)
(set! bbh-v 'v)
(dk-cite! 'hilbert-space-is-cips 'v)
(let* ((ts '(OP-ADJOINT v v t_))
       (n (bbh-opn 't_)) (nn (list '* n n))
       (ns (bbh-opn ts))
       (c (bbh-opn bbh-ta)))
  (dk-cite! 'op-adjoint-bounded 'v 'v 't_)
  (dk-cite! 'bop-comp-bounded 'v ts 't_)
  (for-each (lambda (f) (dk-cite! 'bop-fun 'v 'v f)) (list 't_ ts bbh-ta))
  (for-each (lambda (f) (dk-cite! 'opnorm-in-rr 'v 'v f) (dk-cite! 'opnorm-nonneg 'v 'v f)) (list 't_ ts bbh-ta))
  (dk-cite! 'rr-mul-in-rr n n)
  ;; (<=) ||T* T|| <= ||T*|| ||T|| <= ||T|| ||T||
  (dk-cite! 'opnorm-comp-le 'v ts 't_)
  (dk-cite! 'op-adjoint-opnorm-le 'v 'v 't_)
  (dk-cite! 'rr-mul-le-right ns n n)
  (dk-have! (list '<= c nn)
    (lambda ()
      (bbh-lin! (list (list 'IN c 'RR) (list 'IN ns 'RR) (list 'IN n 'RR))
                (list (list '<= c (list '* ns n)) (list '<= (list '* ns n) nn)))))
  ;; (>=) with s = sqrt ||T* T||: ||T x|| <= s ||x||, hence ||T|| <= s and ||T||^2 <= s^2
  (bbh-have-and! (list 'IN c 'RR) (list '<= 0 c))
  (dk-split-all! (list (dk-cite! 'sqrt-prop c)))
  (let* ((s (dk-name! (list 'SQRT c)))
         (_r1 (dk-rewrite-h! (list '<= 0 (list 'SQRT c)) (list 'SQRT c) s))
         (_r2 (dk-rewrite-h! (list '= (list '* (list 'SQRT c) (list 'SQRT c)) c) (list 'SQRT c) s))
         (la (dk-cite! 'opnorm-bound 'v 'v bbh-ta)))
    (dk-have! (list 'FORALL 'box_ (list 'IMPLIES '(IN box_ (VEC v))
                (list '<= '(IP-NORM v (t_ box_)) (list '* s '(IP-NORM v box_)))))
      (lambda ()
        (dk-peel!)
        (let* ((x (caddr (caddr (caddr (dk-goal)))))
               (tx (list 't_ x)) (atx (list ts tx))
               (nx (bbh-n x)) (ntx (bbh-n tx)) (natx (bbh-n atx))
               (q (bbh-ipv tx tx)) (p (bbh-ipv x atx)))
          (bbh-vt! tx)
          (dk-cite! 'op-adjoint-type 'v 'v 't_ tx)
          (for-each (lambda (z) (dk-cite! 'ip-norm-in-rr 'v z) (dk-cite! 'ip-norm-nonneg 'v z)) (list x tx atx))
          (dk-cite! 'ip-norm-sq 'v tx)
          (dk-cite! 'cips-ip-self-real 'v tx)
          (dk-cite! 'op-adjoint-ip 'v 'v 't_ x tx)
          (dk-cite! 'rr-le-abs q)
          (let ((h (dk-cite! 'rr-magnitude-is-abs q)))
            (dk-rewrite-h! (list '<= q (list 'abs q)) (list 'abs q) (list 'magnitude q)))
          (dk-cite! 'rr-subset-cc q)
          (dk-cite! 'cc-magnitude-closed q)
          (let ((h (dk-cite! 'cips-ip-magnitude-le 'v x atx)))
            (dk-rewrite-h! h p q))
          (dk-cite! 'bop-comp-apply 'v ts 't_ x)
          (let ((h (dk-apply! la x)))
            (dk-rewrite-h! h (list bbh-ta x) atx))
          (dk-cite! 'rr-mul-in-rr c nx)
          (dk-cite! 'rr-mul-le-right natx (list '* c nx) nx)
          (dk-cite! 'rr-mul-in-rr s nx)
          (bbh-have-and! (list '<= 0 s) (list '<= 0 nx))
          (bbh-have-and! (list 'IN s 'RR) (list 'IN nx 'RR))
          (dk-cite! 'rr-leq-mul-nonneg s nx)
          (dk-have! (list '= (list '* nx natx) (list '* natx nx)) (lambda () (crs)))
          (dk-have! (list '= (list '* (list '* c nx) nx) (list '* (list '* s nx) (list '* s nx)))
            (lambda () (subst (list '= c (list '* s s))) (crs)))
          (dk-have! (list '<= (list '* ntx ntx) (list '* (list '* s nx) (list '* s nx)))
            (lambda ()
              (bbh-lin! (list (list 'IN ntx 'RR) (list 'IN nx 'RR) (list 'IN natx 'RR) (list 'IN q 'RR)
                              (list 'IN (list 'magnitude q) 'RR) (list 'IN c 'RR) (list 'IN s 'RR))
                        (list (list '= (list '* ntx ntx) q)
                              (list '<= q (list 'magnitude q))
                              (list '<= (list 'magnitude q) (list '* nx natx))
                              (list '<= (list '* natx nx) (list '* (list '* c nx) nx))
                              (list '= (list '* nx natx) (list '* natx nx))
                              (list '= (list '* (list '* c nx) nx) (list '* (list '* s nx) (list '* s nx)))))))
          (dk-cite! 'rr-square-le-imp-le ntx (list '* s nx))
          (ass))))
    (dk-split-all! (list (dk-cite! 'opnorm-spec 'v 'v 't_)))
    (dk-apply! (bbh-least 't_) s)
    (dk-cite! 'rr-square-mono n s)
    (dk-have! (list '<= nn c)
      (lambda ()
        (bbh-lin! (list (list 'IN n 'RR) (list 'IN s 'RR) (list 'IN c 'RR))
                  (list (list '<= nn (list '* s s)) (list '= (list '* s s) c)))))
    (bbh-have-and! (list 'IN c 'RR) (list 'IN nn 'RR))
    (bbh-have-and! (list '<= c nn) (list '<= nn c))
    (dk-cite! 'rr-leq-antisymmetric c nn)
    (ass)))
(bbh-qed! 'bh-c-star-identity)

;;; ==== part6-proj.scm
;;; ---- PART 6: Proposition 1.55, second half: a self-adjoint idempotent is E_{ran E} --------------

(define bbh-G '((IS-HILBERT-SPACE v) (IS-PROJECTION-OP v e_)))
(define bbh-R '(OP-RANGE v v e_))
(define bbh-Kr '(OP-KERNEL v v e_))
(define (bbh-G0!)                      ; peel, open IS-PROJECTION-OP, type e_
  (dk-peel!)
  (set! bbh-v 'v)
  (dk-cite! 'hilbert-space-is-cips 'v)
  (let ((c (bbh-and '((IN e_ (BOUNDED-OPS v v)) (= (OP-ADJOINT v v e_) e_) (= (BOP-COMP v e_ e_) e_)))))
    (if (not (dk-asm? '(= (BOP-COMP v e_ e_) e_)))
        (begin
          (dk-have! c (lambda () (mac-h 'is-projection-op '(IS-PROJECTION-OP v e_)) (dk-split-all!) (dk-conj-close! dk-ass!)))
          (dk-split-all! (list c)))))
  (dk-cite! 'bop-fun 'v 'v 'e_))

;;; T(-x) = -T(x)
(sp (make-wff (forall-guarded '(v w t_ x_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN t_ (BOUNDED-OPS v w)) (IN x_ (VEC v)))
   '(= (t_ ((VNEG v) x_)) ((VNEG w) (t_ x_))))))
(dk-peel!)
(dk-cite! 'bop-fun 'v 'w 't_)
(dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC w) 'x_)
(let* ((e1 (dk-cite! 'cips-act-neg-one 'v 'x_))
       (m1 (cadr (cadr e1)))
       (e2 (dk-cite! 'cips-act-neg-one 'w '(t_ x_))))
  (dk-have! (list 'IN m1 'CC) (lambda () (arith)))
  (subst (list '= (caddr e1) (cadr e1)))
  (subst (dk-cite! 'bop-act 'v 'w 't_ m1 'x_))
  (subst (list '= (caddr e2) (cadr e2)))
  (rfl))
(bbh-qed! 'bop-vneg)

;;; the kernel
(sp (make-wff '(FORALL bov_ (FORALL bow_ (FORALL bot_ (== (OP-KERNEL bov_ bow_ bot_)
  (SEP box_ (VEC bov_) (= (bot_ box_) (VZERO bow_)))))))))
(di) (mac 'OP-KERNEL) (qrfl)
(bbh-qed! 'op-kernel-unfold)

(sp (make-wff '(FORALL bov_ (FORALL bow_ (FORALL bot_ (FORALL y_ (IFF (IN y_ (OP-KERNEL bov_ bow_ bot_))
  (AND (IN y_ (VEC bov_)) (= (bot_ y_) (VZERO bow_))))))))))
(dk-peel!)
(let ((u (dk-cite! 'op-kernel-unfold 'bov_ 'bow_ 'bot_)))
  (subst u)
  (let ((sep (caddr u)))
    (dk-iff! (lambda (g) (dk-head-is? g 'AND))
      (lambda () (sep-me (list 'IN 'y_ sep)) (dk-split-all!) (dk-conj-close! dk-ass!))
      (lambda () (dk-split-all!) (in-sep! dk-ass! (lambda () (ass)))))))
(bbh-qed! 'op-kernel-membership)

(sp (make-wff '(FORALL v (FORALL w (FORALL t_ (IMPLIES (IS-COMPLEX-INNER-PRODUCT-SPACE v)
   (SUBSET (OP-KERNEL v w t_) (VEC v))))))))
(dk-peel!)
(let ((u (dk-cite! 'op-kernel-unfold 'v 'w 't_)))
  (subst u)
  (mac 'subset-def)
  (dk-peel!)
  (let ((x (cadr (dk-goal))))
    (sep-me (list 'IN x (caddr u)))
    (dk-split-all!)
    (ass)))
(bbh-qed! 'op-kernel-subset)

;;; a projection is symmetric: <E x, y> = <x, E y>
(sp (make-wff (forall-guarded '(v e_ x_ y_) (append bbh-G '((IN x_ (VEC v)) (IN y_ (VEC v))))
   '(= ((IP v) (e_ x_) y_) ((IP v) x_ (e_ y_))))))
(bbh-G0!)
(dk-cite! 'fun-apply-type-c 'e_ '(VEC v) '(VEC v) 'y_)
(subst (dk-cite! 'op-adjoint-ip 'v 'v 'e_ 'x_ 'y_))
(subst '(= (OP-ADJOINT v v e_) e_))
(rfl)
(bbh-qed! 'projection-op-symmetric)

;;; E E x = E x
(sp (make-wff (forall-guarded '(v e_ x_) (append bbh-G '((IN x_ (VEC v))))
   '(= (e_ (e_ x_)) (e_ x_)))))
(bbh-G0!)
(dk-cite! 'fun-apply-type-c 'e_ '(VEC v) '(VEC v) 'x_)
(dk-cite! 'fun-apply-type-c 'e_ '(VEC v) '(VEC v) '(e_ x_))
(let ((ca (dk-cite! 'bop-comp-apply 'v 'e_ 'e_ 'x_)))
  (subst (list '= '(e_ (e_ x_)) (cadr ca)))
  (subst '(= (BOP-COMP v e_ e_) e_))
  (rfl))
(bbh-qed! 'projection-op-idempotent)

;;; E (x - E x) = 0
(define bbh-dx '((VADD v) x_ ((VNEG v) (e_ x_))))
(sp (make-wff (forall-guarded '(v e_ x_) (append bbh-G '((IN x_ (VEC v))))
   (list '= (list 'e_ bbh-dx) '(VZERO v)))))
(bbh-G0!)
(bbh-vt! bbh-dx)
(bbh-vt! '(e_ (e_ x_)))
(subst (dk-cite! 'bop-add 'v 'v 'e_ 'x_ '((VNEG v) (e_ x_))))
(subst (dk-cite! 'bop-vneg 'v 'v 'e_ '(e_ x_)))
(subst (dk-cite! 'projection-op-idempotent 'v 'e_ 'x_))
(subst (dk-cite! 'cips-vadd-vneg 'v '(e_ x_)))
(rfl)
(bbh-qed! 'projection-op-kills-complement)

;;; E fixes its range
(sp (make-wff (forall-guarded '(v e_ k_) (append bbh-G (list (list 'IN 'k_ bbh-R)))
   '(= (e_ k_) k_))))
(bbh-G0!)
(bbh-iff-fwd! 'op-range-membership 'v 'v 'e_ 'k_)
(let ((y (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the preimage"))))
  (dk-split-all!)
  (subst (list '= 'k_ (list 'e_ y)))
  (dk-cite! 'projection-op-idempotent 'v 'e_ y)
  (ass))
(bbh-qed! 'projection-op-fixes-range)

;;; ran E = (ker E)-perp
(define bbh-PK (list 'PERP 'v bbh-Kr))
(sp (make-wff (forall-guarded '(v e_) bbh-G (list '= bbh-R bbh-PK))))
(bbh-G0!)
(dk-cite! 'op-kernel-subset 'v 'v 'e_)
(dk-have! (list 'FORALL 'brx_ (list 'IFF (list 'IN 'brx_ bbh-R) (list 'IN 'brx_ bbh-PK)))
  (lambda ()
    (dk-peel!)
    (let ((x (cadr (cadr (dk-goal)))))
      (dk-iff! (lambda (g) (equal? (caddr g) bbh-PK))
        ;; x = E y is orthogonal to ker E
        (lambda ()
          (bbh-iff-fwd! 'op-range-membership 'v 'v 'e_ x)
          (let ((y (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the preimage"))))
            (dk-split-all!)
            (dk-have! (list 'FORALL 'prk_ (list 'IMPLIES (list 'IN 'prk_ bbh-Kr) (list '= (bbh-ipv x 'prk_) 0)))
              (lambda ()
                (dk-peel!)
                (let ((k (caddr (cadr (dk-goal)))))
                  (bbh-iff-fwd! 'op-kernel-membership 'v 'v 'e_ k)
                  (subst (list '= x (list 'e_ y)))
                  (subst (dk-cite! 'projection-op-symmetric 'v 'e_ y k))
                  (subst (list '= (list 'e_ k) '(VZERO v)))
                  (subst (dk-cite! 'cips-ip-zero-right 'v y))
                  (rfl))))
            (bbh-iff-bwd! 'perp-membership 'v bbh-Kr x)
            (ass)))
        ;; x orthogonal to ker E: d = x - E x lies in ker E, so <d, d> = <x, d> - <E x, d> = 0
        (lambda ()
          (bbh-iff-fwd! 'perp-membership 'v bbh-Kr x)
          (let* ((ex (list 'e_ x))
                 (d (bbh-sub x ex))
                 (orth (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'prk_))) "orthogonality")))
            (bbh-vt! d)
            (dk-cite! 'projection-op-kills-complement 'v 'e_ x)
            (bbh-iff-bwd! 'op-kernel-membership 'v 'v 'e_ d)
            (dk-apply! orth d)
            (dk-cite! 'projection-op-symmetric 'v 'e_ x d)
            (dk-cite! 'cips-ip-zero-right 'v x)
            (dk-have! (list '= (bbh-q d) 0)
              (lambda ()
                (subst (dk-cite! 'cips-ip-add-left 'v x (list '(VNEG v) ex) d))
                (subst (dk-cite! 'cips-ip-neg-left 'v ex d))
                (subst (list '= (bbh-ipv x d) 0))
                (subst (list '= (bbh-ipv ex d) (bbh-ipv x (list 'e_ d))))
                (subst (list '= (list 'e_ d) '(VZERO v)))
                (subst (list '= (bbh-ipv x '(VZERO v)) 0))
                (arith)))
            (dk-cite! 'cips-eq-of-dist-sq-zero 'v x ex)
            (dk-have! (list 'FORSOME 'box_ (list 'AND '(IN box_ (VEC v)) (list '= x '(e_ box_))))
              (lambda () (ew x) (dk-conj-close! dk-ass!)))
            (bbh-iff-bwd! 'op-range-membership 'v 'v 'e_ x)
            (ass)))))))
(dk-cite! 'class-extensionality bbh-R bbh-PK)
(ass)
(bbh-qed! 'projection-op-range-perp-kernel)

;;; Proposition 1.55, second half: ran E is closed (a subspace), and E = E_{ran E}
(sp (make-wff (forall-guarded '(v e_) bbh-G
   (list 'AND (list 'IS-SUBMODULE 'v bbh-R) (list 'IS-CLOSED '(IP-METRIC-SPACE v) bbh-R)))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(subst (dk-cite! 'projection-op-range-perp-kernel 'v 'e_))
(dk-cite! 'op-kernel-subset 'v 'v 'e_)
(dk-cite! 'perp-is-submodule 'v bbh-Kr)
(dk-cite! 'perp-is-closed 'v bbh-Kr)
(dk-conj-close! dk-ass!)
(bbh-qed! 'projection-op-range-closed)

(sp (make-wff (forall-guarded '(v e_) bbh-G (list '= (list 'PROJ-OP 'v bbh-R) 'e_))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'projection-op-range-closed 'v 'e_)))
(bbh-G0!)
(dk-have! (list 'IS-ORTHOGONAL-PROJECTION 'v bbh-R 'e_)
  (lambda ()
    (mac 'is-orthogonal-projection)
    (dk-conj-close!
     (lambda ()
       (if (dk-head-is? (dk-goal) 'FORALL)
           (let* ((lk (dk-peel!))
                  (z (cadr (car (filter (dk-head? 'IN) lk))))
                  (ez (list 'e_ z)) (d (bbh-sub z ez)))
             (bbh-vt! d)
             (dk-conj-close!
              (lambda ()
                (if (equal? (dk-goal) (list 'IN ez bbh-R))
                    (begin
                      (dk-have! (list 'FORSOME 'box_ (list 'AND '(IN box_ (VEC v)) (list '= ez '(e_ box_))))
                        (lambda () (ew z) (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) '=) (rfl) (ass))))))
                      (bbh-iff-bwd! 'op-range-membership 'v 'v 'e_ ez)
                      (ass))
                    (begin
                      (dk-cite! 'projection-op-kills-complement 'v 'e_ z)
                      (dk-have! (list 'FORALL 'prk_ (list 'IMPLIES (list 'IN 'prk_ bbh-R) (list '= (bbh-ipv d 'prk_) 0)))
                        (lambda ()
                          (dk-peel!)
                          (let ((k (caddr (cadr (dk-goal)))))
                            (dk-cite! 'projection-op-fixes-range 'v 'e_ k)
                            (bbh-iff-fwd! 'op-range-membership 'v 'v 'e_ k)
                            (dk-cite! 'projection-op-symmetric 'v 'e_ d k)
                            (subst (list '= k (list 'e_ k)))
                            (subst (list '= (bbh-ipv d (list 'e_ k)) (bbh-ipv (list 'e_ d) k)))
                            (subst (list '= (list 'e_ d) '(VZERO v)))
                            (subst (dk-cite! 'cips-ip-zero-left 'v k))
                            (rfl))))
                      (bbh-iff-bwd! 'perp-membership 'v bbh-R d)
                      (ass))))))
           (ass))))))
(dk-cite! 'proj-op-unique 'v bbh-R 'e_)
(ass)
(bbh-qed! 'projection-op-is-proj-op-of-range)

;;; ==== part7-pi.scm
;;; ---- PART 7: partial isometries -- Proposition 2.1 (1) => (2), (1) <=> (3); Corollary 2.4 -----

(define bbh-Us '(OP-ADJOINT v v u_))
(define bbh-UU '(BOP-COMP v (OP-ADJOINT v v u_) u_))
(define bbh-UUs '(BOP-COMP v u_ (OP-ADJOINT v v u_)))
(define bbh-g0 '((IS-HILBERT-SPACE v) (IN u_ (BOUNDED-OPS v v))))
(define bbh-g1 (append bbh-g0 (list (list 'IS-PROJECTION-OP 'v bbh-UU))))
(define (bbh-u0!)
  (dk-peel!)
  (set! bbh-v 'v)
  (dk-cite! 'hilbert-space-is-cips 'v)
  (dk-cite! 'op-adjoint-bounded 'v 'v 'u_)
  (dk-cite! 'bop-comp-bounded 'v bbh-Us 'u_)
  (dk-cite! 'bop-comp-bounded 'v 'u_ bbh-Us)
  (for-each (lambda (f) (dk-cite! 'bop-fun 'v 'v f)) (list 'u_ bbh-Us bbh-UU bbh-UUs)))

;;; land (IN (t w) (OP-RANGE v v t)), w the witness (the instance's own binder, no capture)
(define (bbh-range-in! t w)
  (let ((iff (dk-cite! 'op-range-membership 'v 'v t (list t w))))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff)
          (lambda ()
            (dk-conj-close!
             (lambda ()
               (if (dk-head-is? (dk-goal) 'FORSOME)
                   (begin (ew w) (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) '=) (rfl) (ass)))))
                   (ass)))))))
    (bbh-iff-bwd! 'op-range-membership 'v 'v t (list t w))))

;;; T(0) = 0
(sp (make-wff (forall-guarded '(v w t_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-COMPLEX-INNER-PRODUCT-SPACE w) (IN t_ (BOUNDED-OPS v w)))
   '(= (t_ (VZERO v)) (VZERO w)))))
(dk-peel!)
(set! bbh-v 'v)
(dk-cite! 'bop-fun 'v 'w 't_)
(let ((z '(VZERO v)))
  (bbh-vt! (list '(VNEG v) z))
  (fluid-let ((bbh-v 'w)) (bbh-vt! (list 't_ z)))
  (let ((e (dk-cite! 'cips-vadd-vneg 'v z)))
    (subst (list '= z (cadr e))))
  (subst (dk-cite! 'bop-add 'v 'w 't_ z (list '(VNEG v) z)))
  (subst (dk-cite! 'bop-vneg 'v 'w 't_ z))
  (subst (dk-cite! 'cips-vadd-vneg 'w (list 't_ z)))
  (rfl))
(bbh-qed! 'bop-zero-value)

;;; <x, U*U y> = <U x, U y>
(sp (make-wff (forall-guarded '(v u_ x_ y_) (append bbh-g0 '((IN x_ (VEC v)) (IN y_ (VEC v))))
   (list '= (bbh-ipv 'x_ (list bbh-UU 'y_)) '((IP v) (u_ x_) (u_ y_))))))
(bbh-u0!)
(bbh-vt! '(u_ y_))
(subst (dk-cite! 'bop-comp-apply 'v bbh-Us 'u_ 'y_))
(subst (dk-cite! 'op-adjoint-ip 'v 'v 'u_ 'x_ '(u_ y_)))
(rfl)
(bbh-qed! 'adjoint-square-ip)

;;; U*U x = 0 => U x = 0
(sp (make-wff (forall-guarded '(v u_ x_) (append bbh-g0 (list '(IN x_ (VEC v)) (list '= (list bbh-UU 'x_) '(VZERO v))))
   '(= (u_ x_) (VZERO v)))))
(bbh-u0!)
(bbh-vt! '(u_ x_))
(dk-cite! 'adjoint-square-ip 'v 'u_ 'x_ 'x_)
(dk-have! '(= ((IP v) (u_ x_) (u_ x_)) 0)
  (lambda ()
    (subst (list '= '((IP v) (u_ x_) (u_ x_)) (bbh-ipv 'x_ (list bbh-UU 'x_))))
    (subst (list '= (list bbh-UU 'x_) '(VZERO v)))
    (subst (dk-cite! 'cips-ip-zero-right 'v 'x_))
    (rfl)))
(dk-cite! 'cips-ip-zero-vector 'v '(u_ x_))
(ass)
(bbh-qed! 'adjoint-square-kernel)

;;; (1) gives U E = U
(sp (make-wff (forall-guarded '(v u_ x_) (append bbh-g1 '((IN x_ (VEC v))))
   (list '= (list 'u_ (list bbh-UU 'x_)) '(u_ x_)))))
(bbh-u0!)
(let* ((ex (list bbh-UU 'x_)) (d (bbh-sub 'x_ ex)) (uex (list 'u_ ex)))
  (bbh-vt! d)
  (bbh-vt! uex) (bbh-vt! '(u_ x_))
  (dk-cite! 'projection-op-kills-complement 'v bbh-UU 'x_)
  (dk-cite! 'adjoint-square-kernel 'v 'u_ d)
  (dk-cite! 'bop-add 'v 'v 'u_ 'x_ (list '(VNEG v) ex))
  (dk-cite! 'bop-vneg 'v 'v 'u_ ex)
  (let ((h (dk-rewrite-h! (list '= (list 'u_ d) '(VZERO v)) (list 'u_ d) (list '(VADD v) '(u_ x_) (list 'u_ (list '(VNEG v) ex))))))
    (let ((h2 (dk-rewrite-h! h (list 'u_ (list '(VNEG v) ex)) (list '(VNEG v) uex))))
      (dk-have! (list '= (bbh-q (bbh-sub '(u_ x_) uex)) 0)
        (lambda ()
          (subst (list '= (bbh-sub '(u_ x_) uex) '(VZERO v)))
          (dk-cite! 'cips-vzero-in 'v)
          (subst (dk-cite! 'cips-ip-zero-left 'v '(VZERO v)))
          (rfl)))
      (dk-cite! 'cips-eq-of-dist-sq-zero 'v '(u_ x_) uex)
      (subst (list '= uex '(u_ x_)))
      (rfl))))
(bbh-qed! 'adjoint-square-projection-absorbs)

;;; Proposition 2.1, (1) => (2): if U*U is a projection, U is a partial isometry (K = ran U*U)
(sp (make-wff (forall-guarded '(v u_) bbh-g1 '(IS-PARTIAL-ISOMETRY v u_))))
(bbh-u0!)
(let ((kk (list 'OP-RANGE 'v 'v bbh-UU)))
  (dk-split-all! (list (dk-cite! 'projection-op-range-closed 'v bbh-UU)))
  (mac 'is-partial-isometry)
  (dk-conj-close!
   (lambda ()
     (if (not (dk-head-is? (dk-goal) 'FORSOME))
         (ass)
         (begin
           (ew kk)
           (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond
                  ((dk-head-is? g 'IS-ISOMETRIC-ON)
                   (mac 'is-isometric-on)
                   (dk-peel!)
                   (let* ((x (caddr (caddr (dk-goal)))) (ux (list 'u_ x)))
                     (bbh-iff-fwd! 'op-range-membership 'v 'v bbh-UU x)
                     (dk-cite! 'projection-op-fixes-range 'v bbh-UU x)
                     (bbh-vt! ux)
                     (dk-cite! 'adjoint-square-ip 'v 'u_ x x)
                     (for-each (lambda (z) (dk-cite! 'ip-norm-in-rr 'v z) (dk-cite! 'ip-norm-nonneg 'v z)
                                 (dk-cite! 'ip-norm-sq 'v z)) (list x ux))
                     (dk-have! (list '= (bbh-nsq ux) (bbh-nsq x))
                       (lambda ()
                         (subst (list '= (bbh-nsq ux) (bbh-q ux)))
                         (subst (list '= (bbh-q ux) (bbh-ipv x (list bbh-UU x))))
                         (subst (list '= (list bbh-UU x) x))
                         (subst (list '= (bbh-nsq x) (bbh-q x)))
                         (rfl)))
                     (bbh-have-and! (list 'IN (bbh-n ux) 'RR) (list 'IN (bbh-n x) 'RR))
                     (bbh-have-and! (list '<= 0 (bbh-n ux)) (list '<= 0 (bbh-n x)))
                     (dk-cite! 'sqrt-unique (bbh-n ux) (bbh-n x))
                     (ass)))
                  ((dk-head-is? g 'FORALL)
                   (dk-peel!)
                   (let* ((x (cadr (cadr (dk-goal)))) (ex (list bbh-UU x)))
                     (bbh-iff-fwd! 'perp-membership 'v kk x)
                     (bbh-vt! ex)
                     (bbh-range-in! bbh-UU x)
                     (dk-cite! 'perp-orth 'v kk x ex)
                     (dk-have! (list '= (bbh-q ex) 0)
                       (lambda ()
                         (subst (dk-cite! 'projection-op-symmetric 'v bbh-UU x ex))
                         (subst (dk-cite! 'projection-op-idempotent 'v bbh-UU x))
                         (ass)))
                     (dk-cite! 'cips-ip-zero-vector 'v ex)
                     (dk-cite! 'adjoint-square-kernel 'v 'u_ x)
                     (ass)))
                  (#t (ass)))))))))))
(bbh-qed! 'partial-isometry-of-projection)

;;; Proposition 2.1, (1) => (3): U*U a projection => U U* a projection
(sp (make-wff (forall-guarded '(v u_) bbh-g1 (list 'IS-PROJECTION-OP 'v bbh-UUs))))
(bbh-u0!)
(dk-cite! 'op-adjoint-involutive 'v 'v 'u_)
(mac 'is-projection-op)
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
       ((dk-head-is? g 'IN) (ass))
       ((dk-head-is? (cadr g) 'OP-ADJOINT)
        (subst (dk-cite! 'op-adjoint-comp 'v 'u_ bbh-Us))
        (subst (list '= (list 'OP-ADJOINT 'v 'v bbh-Us) 'u_))
        (rfl))
       (#t
        (dk-cite! 'bop-comp-bounded 'v bbh-UUs bbh-UUs)
        (dk-cite! 'bop-fun 'v 'v (list 'BOP-COMP 'v bbh-UUs bbh-UUs))
        (dk-fun-ext! (cadr g) bbh-UUs '(VEC v) '(VEC v) #f #f
          (lambda (x)
            (let* ((sx (list bbh-Us x)) (usx (list 'u_ sx)) (ssx (list bbh-Us usx)))
              (bbh-vt! usx) (bbh-vt! ssx)
              (subst (dk-cite! 'bop-comp-apply 'v bbh-UUs bbh-UUs x))
              (subst (dk-cite! 'bop-comp-apply 'v 'u_ bbh-Us x))
              (subst (dk-cite! 'bop-comp-apply 'v 'u_ bbh-Us usx))
              (dk-cite! 'bop-comp-apply 'v bbh-Us 'u_ sx)
              (dk-cite! 'adjoint-square-projection-absorbs 'v 'u_ sx)
              (subst (list '= ssx (list bbh-UU sx)))
              (subst (list '= (list 'u_ (list bbh-UU sx)) usx))
              (rfl)))))))))
(bbh-qed! 'adjoint-square-projection-swap)

;;; Proposition 2.1, (3) => (1)
(sp (make-wff (forall-guarded '(v u_) (append bbh-g0 (list (list 'IS-PROJECTION-OP 'v bbh-UUs)))
   (list 'IS-PROJECTION-OP 'v bbh-UU))))
(bbh-u0!)
(let ((uss (list 'OP-ADJOINT 'v 'v bbh-Us)))
  (dk-cite! 'op-adjoint-involutive 'v 'v 'u_)
  (dk-have! (list 'IS-PROJECTION-OP 'v (list 'BOP-COMP 'v uss bbh-Us))
    (lambda () (subst (list '= uss 'u_)) (ass)))
  (let ((c (dk-cite! 'adjoint-square-projection-swap 'v bbh-Us)))
    (dk-rewrite-h! c uss 'u_)
    (ass)))
(bbh-qed! 'adjoint-square-projection-swap-back)

;;; Corollary 2.4 (38): E_{supp U} = U*U
(sp (make-wff (forall-guarded '(v u_) bbh-g1 (list '= '(PROJ-OP v (OP-SUPPORT v v u_)) bbh-UU))))
(bbh-u0!)
(let* ((ku '(OP-KERNEL v v u_)) (ke (list 'OP-KERNEL 'v 'v bbh-UU)))
  (dk-have! (list 'FORALL 'brx_ (list 'IFF (list 'IN 'brx_ ku) (list 'IN 'brx_ ke)))
    (lambda ()
      (dk-peel!)
      (let ((x (cadr (cadr (dk-goal)))))
        (dk-iff! (lambda (g) (equal? (caddr g) ke))
          (lambda ()
            (bbh-iff-fwd! 'op-kernel-membership 'v 'v 'u_ x)
            (dk-have! (list '= (list bbh-UU x) '(VZERO v))
              (lambda ()
                (subst (dk-cite! 'bop-comp-apply 'v bbh-Us 'u_ x))
                (subst (list '= (list 'u_ x) '(VZERO v)))
                (subst (dk-cite! 'bop-zero-value 'v 'v bbh-Us))
                (rfl)))
            (bbh-iff-bwd! 'op-kernel-membership 'v 'v bbh-UU x)
            (ass))
          (lambda ()
            (bbh-iff-fwd! 'op-kernel-membership 'v 'v bbh-UU x)
            (dk-cite! 'adjoint-square-kernel 'v 'u_ x)
            (bbh-iff-bwd! 'op-kernel-membership 'v 'v 'u_ x)
            (ass))))))
  (dk-cite! 'class-extensionality ku ke)
  (mac 'OP-SUPPORT)
  (subst (list '= ku ke))
  (dk-cite! 'projection-op-range-perp-kernel 'v bbh-UU)
  (subst (list '= (list 'PERP 'v ke) (list 'OP-RANGE 'v 'v bbh-UU)))
  (dk-cite! 'projection-op-is-proj-op-of-range 'v bbh-UU)
  (ass))
(bbh-qed! 'support-projection-of-partial-isometry)

;;; Corollary 2.4 (39): E_{ran U} = U U*
(sp (make-wff (forall-guarded '(v u_) bbh-g1 (list '= '(PROJ-OP v (OP-RANGE v v u_)) bbh-UUs))))
(bbh-u0!)
(dk-cite! 'adjoint-square-projection-swap 'v 'u_)
(let* ((ru '(OP-RANGE v v u_)) (rf (list 'OP-RANGE 'v 'v bbh-UUs)))
  (dk-have! (list 'FORALL 'brx_ (list 'IFF (list 'IN 'brx_ ru) (list 'IN 'brx_ rf)))
    (lambda ()
      (dk-peel!)
      (let ((x (cadr (cadr (dk-goal)))))
        (dk-iff! (lambda (g) (equal? (caddr g) rf))
          (lambda ()
            (bbh-iff-fwd! 'op-range-membership 'v 'v 'u_ x)
            (let* ((y (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the preimage")))
                   (uy (list 'u_ y)))
              (dk-split-all!)
              (bbh-vt! uy)
              (dk-cite! 'adjoint-square-projection-absorbs 'v 'u_ y)
              (dk-have! (list 'FORSOME 'box_ (list 'AND '(IN box_ (VEC v)) (list '= x (list bbh-UUs 'box_))))
                (lambda ()
                  (ew uy)
                  (dk-conj-close!
                   (lambda ()
                     (if (dk-head-is? (dk-goal) '=)
                         (begin
                           (subst (dk-cite! 'bop-comp-apply 'v 'u_ bbh-Us uy))
                           (subst (list '= x uy))
                           (dk-cite! 'bop-comp-apply 'v bbh-Us 'u_ y)
                           (subst (list '= (list bbh-Us uy) (list bbh-UU y)))
                           (subst (list '= (list 'u_ (list bbh-UU y)) uy))
                           (rfl))
                         (ass))))))
              (bbh-iff-bwd! 'op-range-membership 'v 'v bbh-UUs x)
              (ass)))
          (lambda ()
            (bbh-iff-fwd! 'op-range-membership 'v 'v bbh-UUs x)
            (let* ((y (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the preimage")))
                   (sy (list bbh-Us y)))
              (dk-split-all!)
              (bbh-vt! sy)
              (dk-have! (list 'FORSOME 'box_ (list 'AND '(IN box_ (VEC v)) (list '= x '(u_ box_))))
                (lambda ()
                  (ew sy)
                  (dk-conj-close!
                   (lambda ()
                     (if (dk-head-is? (dk-goal) '=)
                         (begin (subst (list '= x (list bbh-UUs y)))
                                (subst (dk-cite! 'bop-comp-apply 'v 'u_ bbh-Us y))
                                (rfl))
                         (ass))))))
              (bbh-iff-bwd! 'op-range-membership 'v 'v 'u_ x)
              (ass)))))))
  (dk-cite! 'class-extensionality ru rf)
  (subst (list '= ru rf))
  (dk-cite! 'projection-op-is-proj-op-of-range 'v bbh-UUs)
  (ass))
(bbh-qed! 'range-projection-of-partial-isometry)

;;; ==== part8-polar.scm
;;; ---- PART 8: polarization; Proposition 2.1 (2) => (1); the equivalences; Corollary 2.4 -------

;;; <p + c q, p + c q> = <p,p> + conj(c) <p,q> + c <q,p> + c conj(c) <q,q>
(define (bbh-pol-rhs p q c)
  (list '+ (list '+ (bbh-ipv p p) (list '* (list 'conjugate c) (bbh-ipv p q)))
           (list '+ (list '* c (bbh-ipv q p)) (list '* (list '* c (list 'conjugate c)) (bbh-ipv q q)))))
(define (bbh-pz p q c) (list '(VADD v) p (list '(ACT v) c q)))
(sp (make-wff (forall-guarded '(v c_ p_ q_)
   '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN c_ CC) (IN p_ (VEC v)) (IN q_ (VEC v)))
   (list '= (bbh-ipv (bbh-pz 'p_ 'q_ 'c_) (bbh-pz 'p_ 'q_ 'c_)) (bbh-pol-rhs 'p_ 'q_ 'c_)))))
(dk-peel!)
(set! bbh-v 'v)
(bbh-vt! (bbh-pz 'p_ 'q_ 'c_))
(bbh-expand!)
(bbh-type-ips! (dk-goal))
(crs)
(bbh-qed! 'cips-expand-scaled)

;;; an isometry on a subspace preserves the inner product there (polarization)
(define bbh-isof '(FORALL box_ (IMPLIES (IN box_ kk) (= (IP-NORM v (u_ box_)) (IP-NORM v box_)))))
(define (bbh-sq! z)                     ; <u z, u z> = <z, z> for z in kk, typed
  (let ((uz (list 'u_ z)))
    (bbh-vt! uz)
    (dk-apply! (dk-ctx-form bbh-isof) z)
    (dk-cite! 'ip-norm-sq 'v z) (dk-cite! 'ip-norm-sq 'v uz)
    (dk-have! (list '= (bbh-q uz) (bbh-q z))
      (lambda ()
        (subst (list '= (bbh-q uz) (bbh-nsq uz)))
        (subst (list '= (bbh-n uz) (bbh-n z)))
        (subst (list '= (bbh-nsq z) (bbh-q z)))
        (rfl)))))
(define (bbh-eqn! c ua ub)              ; the expansions of <u z, u z> = <z, z> at z = a + c b
  (let* ((cb (list '(ACT v) c 'b_)) (z (bbh-pz 'a_ 'b_ c))
         (ucb (list 'u_ cb)) (uz (list 'u_ z)) (zz (bbh-pz ua ub c)))
    (bbh-ct! c)
    (dk-have! (list 'IN c '(CARR (SCAL v))) (lambda () (subst '(= (CARR (SCAL v)) CC)) (ass)))
    (dk-cite! 'submodule-act-closed 'v 'kk c 'b_)
    (dk-cite! 'submodule-vadd-closed 'v 'kk 'a_ cb)
    (bbh-vt! z) (bbh-vt! zz)
    (bbh-sq! z)
    (dk-cite! 'bop-add 'v 'v 'u_ 'a_ cb)
    (dk-cite! 'bop-act 'v 'v 'u_ c 'b_)
    (let* ((l1 (dk-cite! 'cips-expand-scaled 'v c ua ub))
           (r1 (dk-cite! 'cips-expand-scaled 'v c 'a_ 'b_))
           (lc (caddr l1)) (rc (caddr r1)))
      (dk-have! (list '= lc rc)
        (lambda ()
          (subst (list '= lc (cadr l1)))
          (subst (list '= rc (cadr r1)))
          (subst (list '= (list '(ACT v) c ub) ucb))
          (subst (list '= (list '(VADD v) ua ucb) uz))
          (ass)))
      (list lc rc))))

(define bbh-iso-hyps '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IS-SUBMODULE v kk) (IN u_ (BOUNDED-OPS v v))
                       (IS-ISOMETRIC-ON v v u_ kk) (IN a_ kk) (IN b_ kk)))
(sp (make-wff (forall-guarded '(v kk u_ a_ b_) bbh-iso-hyps '(= ((IP v) (u_ a_) (u_ b_)) ((IP v) a_ b_)))))
(dk-peel!)
(set! bbh-v 'v)
(dk-cite! 'bop-fun 'v 'v 'u_)
(dk-cite! 'cips-scal-carrier 'v)
(bbh-sub! 'kk 'a_)
(bbh-sub! 'kk 'b_)
(dk-have! bbh-isof (lambda () (mac-h 'is-isometric-on '(IS-ISOMETRIC-ON v v u_ kk)) (ass)))
(let* ((ua '(u_ a_)) (ub '(u_ b_))
       (P (bbh-ipv ua ub)) (P2 (bbh-ipv 'a_ 'b_)))
  (bbh-vt! ua) (bbh-vt! ub)
  (bbh-sq! 'a_) (bbh-sq! 'b_)
  (let* ((e1 (bbh-eqn! 1 ua ub)) (ei (bbh-eqn! +i ua ub))
         (big (list '+ P2 (list '* 1/2 (list '+ (list '- (car e1) (cadr e1))
                                               (list '* +i (list '- (car ei) (cadr ei))))))))
    (bbh-type-ips! (list P P2 (bbh-ipv ub ua) (bbh-ipv 'b_ 'a_) (bbh-q ua) (bbh-q ub) (bbh-q 'a_) (bbh-q 'b_)))
    (dk-have! '(= (conjugate 1) 1) (lambda () (arith)))
    (dk-have! '(= (conjugate +i) (- +i)) (lambda () (arith)))
    (dk-have! (list '= P big)
      (lambda ()
        (subst (list '= (bbh-q ua) (bbh-q 'a_)))
        (subst (list '= (bbh-q ub) (bbh-q 'b_)))
        (subst '(= (conjugate 1) 1))
        (subst '(= (conjugate +i) (- +i)))
        (crs)))
    (subst (list '= P big))
    (subst (list '= (car e1) (cadr e1)))
    (subst (list '= (car ei) (cadr ei)))
    (bbh-type-ips! (dk-goal))
    (crs)))
(bbh-qed! 'isometric-on-preserves-ip)

;;; ---- Proposition 2.1, (2) => (1) ---------------------------------------------------------------
(define bbh-pf
  '(FORSOME bok_ (AND (IS-SUBMODULE v bok_) (AND (IS-CLOSED (IP-METRIC-SPACE v) bok_)
     (AND (IS-ISOMETRIC-ON v v u_ bok_)
          (FORALL box_ (IMPLIES (IN box_ (PERP v bok_)) (= (u_ box_) (VZERO v)))))))))
;;; with (= (u d) 0) for d = y - e y in context: land (= (u y) (u (e y)))
(define (bbh-absorb! e y)
  (let* ((ey (list e y)) (d (bbh-sub y ey)) (uy (list 'u_ y)) (uey (list 'u_ ey))
         (ke (list '= (list 'u_ d) '(VZERO v))))
    (bbh-vt! d) (bbh-vt! uy) (bbh-vt! uey)
    (dk-cite! 'bop-add 'v 'v 'u_ y (list '(VNEG v) ey))
    (dk-cite! 'bop-vneg 'v 'v 'u_ ey)
    (let* ((h (dk-rewrite-h! ke (list 'u_ d) (list '(VADD v) uy (list 'u_ (list '(VNEG v) ey)))))
           (h2 (dk-rewrite-h! h (list 'u_ (list '(VNEG v) ey)) (list '(VNEG v) uey))))
      (dk-have! (list '= (bbh-q (bbh-sub uy uey)) 0)
        (lambda ()
          (subst (list '= (bbh-sub uy uey) '(VZERO v)))
          (dk-cite! 'cips-vzero-in 'v)
          (subst (dk-cite! 'cips-ip-zero-left 'v '(VZERO v)))
          (rfl)))
      (dk-cite! 'cips-eq-of-dist-sq-zero 'v uy uey))))

(sp (make-wff (forall-guarded '(v u_) (append bbh-g0 '((IS-PARTIAL-ISOMETRY v u_))) (list 'IS-PROJECTION-OP 'v bbh-UU))))
(bbh-u0!)
(dk-have! bbh-pf (lambda () (mac-h 'is-partial-isometry '(IS-PARTIAL-ISOMETRY v u_)) (dk-split-all!) (ass)))
(let* ((kk (dk-skolem! (dk-ctx-form bbh-pf)))
       (e (list 'PROJ-OP 'v kk))
       (zf (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'PERP) (dk-contains? h 'u_))) "u = 0 on K-perp")))
  (dk-cite! 'proj-op-is-orthogonal-projection 'v kk)
  (dk-cite! 'orthogonal-projection-type 'v kk e)
  (let ((pa! (lambda (y)               ; (IN (E y) kk), and u y = u (E y)
               (let ((d (bbh-sub y (list e y))))
                 (dk-split! (dk-cite! 'orthogonal-projection-apply 'v kk e y))
                 (bbh-vt! (list e y))
                 (dk-apply! zf d)
                 (bbh-absorb! e y)))))
    (dk-have! (list 'FORALL 'bbw_ (list 'IMPLIES '(IN bbw_ (VEC v)) (list '= (list bbh-UU 'bbw_) (list e 'bbw_))))
      (lambda ()
        (dk-peel!)
        (let* ((x (cadr (cadr (dk-goal)))) (ex (list e x)) (ux (list bbh-UU x)))
          (pa! x)
          (bbh-vt! ux)
          (dk-have! (list 'FORALL 'bbz_ (list 'IMPLIES '(IN bbz_ (VEC v)) (list '= (bbh-ipv 'bbz_ ux) (bbh-ipv 'bbz_ ex))))
            (lambda ()
              (dk-peel!)
              (let* ((y (cadr (cadr (dk-goal)))) (ey (list e y)) (dy (bbh-sub y ey))
                     (a (bbh-ipv y ex)) (b (bbh-ipv ey ex)))
                (pa! y)
                (dk-cite! 'adjoint-square-ip 'v 'u_ y x)
                (dk-cite! 'isometric-on-preserves-ip 'v kk 'u_ ey ex)
                (dk-cite! 'perp-orth 'v kk dy ex)
                (bbh-vt! dy)
                (bbh-type-ips! (list a b))
                (dk-have! (list '= (list '+ a (list '- b)) 0)
                  (lambda ()
                    (subst (list '= 0 (bbh-ipv dy ex)))
                    (subst (dk-cite! 'cips-ip-add-left 'v y (list '(VNEG v) ey) ex))
                    (subst (dk-cite! 'cips-ip-neg-left 'v ey ex))
                    (rfl)))
                (subst (list '= (bbh-ipv y ux) (bbh-ipv (list 'u_ y) (list 'u_ x))))
                (subst (list '= (list 'u_ y) (list 'u_ ey)))
                (subst (list '= (list 'u_ x) (list 'u_ ex)))
                (subst (list '= (bbh-ipv (list 'u_ ey) (list 'u_ ex)) b))
                (dk-have! (list '= a (list '+ b (list '+ a (list '- b)))) (lambda () (crs)))
                (subst (list '= a (list '+ b (list '+ a (list '- b)))))
                (subst (list '= (list '+ a (list '- b)) 0))
                (crs))))
          (dk-cite! 'cips-ip-separates 'v ux ex)
          (ass))))
    (let ((pt (dk-ctx-form (list 'FORALL 'bbw_ (list 'IMPLIES '(IN bbw_ (VEC v)) (list '= (list bbh-UU 'bbw_) (list e 'bbw_)))))))
      (dk-cite! 'op-adjoint-involutive 'v 'v 'u_)
      (mac 'is-projection-op)
      (dk-conj-close!
       (lambda ()
         (let ((g (dk-goal)))
           (cond
             ((dk-head-is? g 'IN) (ass))
             ((dk-head-is? (cadr g) 'OP-ADJOINT)
              (subst (dk-cite! 'op-adjoint-comp 'v bbh-Us 'u_))
              (subst (list '= (list 'OP-ADJOINT 'v 'v bbh-Us) 'u_))
              (rfl))
             (#t
              (dk-cite! 'bop-comp-bounded 'v bbh-UU bbh-UU)
              (dk-cite! 'bop-fun 'v 'v (list 'BOP-COMP 'v bbh-UU bbh-UU))
              (dk-fun-ext! (cadr g) bbh-UU '(VEC v) '(VEC v) #f #f
                (lambda (x)
                  (let ((ex (list e x)))
                    (bbh-vt! (list bbh-UU x))
                    (bbh-vt! ex)
                    (subst (dk-cite! 'bop-comp-apply 'v bbh-UU bbh-UU x))
                    (dk-apply! pt x)
                    (dk-apply! pt ex)
                    (subst (list '= (list bbh-UU x) ex))
                    (subst (list '= (list bbh-UU ex) (list e ex)))
                    (subst (dk-cite! 'orthogonal-projection-idempotent 'v kk e x))
                    (rfl))))))))))))
(bbh-qed! 'projection-of-partial-isometry)

;;; ---- Proposition 2.1: the equivalences ----------------------------------------------------------
(sp (make-wff (forall-guarded '(v u_) bbh-g0
   (list 'IFF (list 'IS-PROJECTION-OP 'v bbh-UU) '(IS-PARTIAL-ISOMETRY v u_)))))
