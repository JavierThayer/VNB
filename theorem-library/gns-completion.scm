;;; gns-completion.scm -- THEOREM 4.13 ON THE HILBERT COMPLETION: the GNS representation of a
;;; unital involutive Banach algebra on H_phi, the operators of the pre-Hilbert stage
;;; (theorem-library/ba4-gns.scm) "extended by continuity" through COMPLETION-LIFT
;;; (theorem-library/completion-lift.scm).  F. J. Thayer, "Banach Algebras and Applications",
;;; Theorem 4.13; Definition 4.25 and Proposition 4.30 (the radical).
;;; Agent BA-1117-GNS2, 2026-11-17.  Destination: theorem-library/gns-completion.scm.
;;; Library: operator-algebras.  Load window: after ba4-gns, completion-lift, ba-rep-vocab's
;;; proof files (bh-*), and structure-library/ba-gns2-vocab.
;;; Prefix g4s-.

(define (g4s-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (if (and (not (sequent-node-grounded? l))
                           (let ((g (dk-goal-of l))) (and (pair? g) (memq (car g) '(= ==)) (equal? (cadr g) (caddr g)))))
                      (begin (dk-focus! l) (if (eq? (car (dk-goal)) '=) (rfl) (qrfl)))))
                (dk-open-leaves)))
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** gns-completion: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "gns-completion: unfinished" name))))
(define (g4s-close-eq!)
  (if (not (proof-done? *ps*))
      (let ((g (dk-goal)))
        (if (and (pair? g) (memq (car g) '(= ==)) (equal? (cadr g) (caddr g)))
            (if (eq? (car g) '=) (rfl) (qrfl))))))
(define (g4s-cite*! . args)
  (let loop ((r (apply dk-cite! args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (loop (if (dk-asm? (caddr r)) (caddr r) (if (dk-asm? (cadr r))
                  (dk-landed-1 (lambda () (detach! r)))
                  (detach-with! r (lambda () (dk-conj-close! (lambda () (dk-ass!))))))))
        r)))
(define (g4s-have! f thunk) (if (not (dk-asm? f)) (dk-have! f thunk)) f)
(define (g4s-occurs? x t) (or (equal? x t) (and (pair? t) (or (g4s-occurs? x (car t)) (g4s-occurs? x (cdr t))))))
(define (g4s-mulr! a b)
  (g4s-have! (list 'IN (list '* a b) 'RR) (lambda () (g4s-cite*! 'rr-mul-closed a b) (dk-ass!))))
(define (g4s-c2! thm a b h1 h2 claim)
  (g4s-have! claim
    (lambda ()
      (g4s-have! (list 'AND (list 'IN a 'RR) h1) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
      (g4s-have! (list 'AND (list 'IN b 'RR) h2) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
      (let* ((r (dk-cite! thm a))
             (fa (if (dk-head-is? r 'IMPLIES) (caddr r) r)))
        (if (not (dk-asm? fa)) (detach! r))
        (dk-apply! fa b)
        (dk-ass!)))))

