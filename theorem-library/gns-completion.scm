;;; ==== the pre-Hilbert operator x |-> GNS-OP(x) as a Lipschitz map of A / N_phi ====
(define (g4s-allx body) (list 'FORALL 'x (list 'IMPLIES '(IN x (VEC a)) body)))
(define (g4s-allu body) (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u g4s-VP) body)))
(define (g4s-x-of t) (cadddr (car t)))     ; ((GNS-OP a f x) arg) -> x
(define (g4s-T-typed! x u)                 ; T x in FUN(VP, VP), T x (u) in VP
  (g4s-cite*! 'gns-op-type 'a 'f x)
  (dk-cite! 'fun-apply-type-c (g4s-T x) g4s-VP g4s-VP u))

(sp (g4s-st (g4s-allx (g4s-allu (list '= (list (g4s-T 'x) (list (list 'VNEG g4s-P) 'u)) (list (list 'VNEG g4s-P) (list (g4s-T 'x) 'u)))))))
(dk-peel!) (g4s-base!)
(let* ((g (dk-goal)) (x (g4s-x-of (cadr g))) (u (cadr (cadr (cadr g)))) (tu (list (g4s-T x) u)))
  (g4s-T-typed! x u)
  (let* ((ng (g4s-cite*! 'cips-act-neg-one g4s-P))
         (e1 (dk-apply! ng u))
         (e2 (dk-apply! ng tu))
         (c (cadr (cadr e1))))
    (subst (list '= (caddr e1) (cadr e1)))
    (subst (list '= (caddr e2) (cadr e2)))
    (g4s-have! (list 'IN c 'CC) (lambda () (arith)))
    (subst (g4s-cite*! 'gns-op-act 'a 'f x c u))
    (g4s-close-eq!)))
(g4s-qed! 'gns-op-vneg)

(sp (g4s-st (g4s-allx (g4s-allu (list '<= (list 'IP-NORM g4s-P (list (g4s-T 'x) 'u)) (list '* (g4s-nx 'x) (list 'IP-NORM g4s-P 'u)))))))
(dk-peel!) (g4s-base!)
(let* ((g (dk-goal)) (u (caddr (caddr (caddr g)))) (x (g4s-x-of (caddr (cadr g))))
       (nx (g4s-nx x)) (tu (list (g4s-T x) u)) (ipP (list 'IP g4s-P))
       (pl (list ipP tu tu)) (px (list ipP u u)) (bb (list '* nx nx)) (bpx (list '* bb px)))
  (g4s-T-typed! x u)
  (subst (dk-cite! 'ip-norm-unfold g4s-P tu))
  (subst (dk-cite! 'ip-norm-unfold g4s-P u))
  (g4s-cite*! 'cips-ip-self-real g4s-P u) (g4s-cite*! 'cips-ip-self-nonneg g4s-P u)
  (g4s-cite*! 'cips-ip-self-real g4s-P tu) (g4s-cite*! 'cips-ip-self-nonneg g4s-P tu)
  (dk-split! (g4s-cite*! 'uiba-vnrm-real 'a x))
  (g4s-mulr! nx nx) (g4s-mulr! bb px)
  (g4s-cite*! 'gns-op-bounded 'a 'f x u)
  (g4s-cite*! 'rr-mul-le-right 0 nx nx)
  (g4s-have! (list '= (list '* 0 nx) 0) (lambda () (crs)))
  (dk-rewrite-h! (list '<= (list '* 0 nx) bb) (list '* 0 nx) 0)
  (let* ((sm (g4s-c2! 'sqrt-mono pl bpx (list '<= 0 pl) (list '<= pl bpx) (list '<= (list 'SQRT pl) (list 'SQRT bpx))))
         (e1 (g4s-c2! 'sqrt-mul bb px (list '<= 0 bb) (list '<= 0 px)
                      (list '= (list 'SQRT bpx) (list '* (list 'SQRT bb) (list 'SQRT px)))))
         (e2 (dk-cite! 'sqrt-of-sq nx))
         (e3 (g4s-cite*! 'rr-abs-of-nonneg nx)))
    (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! sm (cadr e1) (caddr e1)) (cadr e2) (caddr e2)) (cadr e3) (caddr e3))
    (dk-ass!)))
(g4s-qed! 'gns-op-norm-bound)

;;; the hypotheses of completion-lift-bounded, at md := GNS-HMOD, fq := GNS-HFORM, t := GNS-OP(x)
(define (g4s-lipf t b)
  (list 'FORALL 'g4u_ (list 'IMPLIES (list 'IN 'g4u_ g4s-PM) (list 'FORALL 'g4w_ (list 'IMPLIES (list 'IN 'g4w_ g4s-PM)
    (list '<= (list (list 'DIST g4s-M) (list t 'g4u_) (list t 'g4w_)) (list '* b (list (list 'DIST g4s-M) 'g4u_ 'g4w_))))))))
(define (g4s-ptw body) (list 'FORALL 'g4v_ (list 'IMPLIES (list 'IN 'g4v_ g4s-PM) (body 'g4v_))))
(define (g4s-ptw2 body)
  (list 'FORALL 'g4v_ (list 'IMPLIES (list 'IN 'g4v_ g4s-PM)
    (list 'FORALL 'g4z_ (list 'IMPLIES (list 'IN 'g4z_ g4s-PM) (body 'g4v_ 'g4z_))))))
(define (g4s-add-hyp t) (g4s-ptw2 (lambda (v z) (list '= (list t (list (list 'VADD g4s-HM) v z)) (list (list 'VADD g4s-HM) (list t v) (list t z))))))
(define (g4s-hom-hyp t)
  (list 'FORALL 'g4c_ (list 'IMPLIES '(IN g4c_ CC)
    (g4s-ptw (lambda (v) (list '= (list t (list (list 'ACT g4s-HM) 'g4c_ v)) (list (list 'ACT g4s-HM) 'g4c_ (list t v))))))))
(define (g4s-bound-hyp t cq) (g4s-ptw (lambda (v) (list '<= (list g4s-HF (list t v) (list t v)) (list '* cq (list g4s-HF v v))))))
(define (g4s-vp! v) (g4s-have! (list 'IN v g4s-VP) (lambda () (subst (list '= g4s-VP g4s-PM)) (dk-ass!))))
(define (g4s-pms!) (dk-cite! 'gns-ms-pts 'a 'f))

(sp (g4s-st (g4s-allx (list 'IN (g4s-T 'x) (list 'FUN g4s-PM g4s-PM)))))
(dk-peel!) (g4s-base!) (g4s-pms!)
(subst (list '= g4s-PM g4s-VP))
(g4s-cite*! 'gns-op-type 'a 'f 'x)
(dk-ass!)
(g4s-qed! 'gns-op-pm-type)

(sp (g4s-st (g4s-allx (g4s-lipf (g4s-T 'x) (g4s-nx 'x)))))
(dk-peel!) (g4s-base!) (g4s-pms!)
(let* ((g (dk-goal)) (u (cadr (caddr (caddr g)))) (w (caddr (caddr (caddr g))))
       (x (g4s-x-of (cadr (cadr g)))) (T (g4s-T x)))
  (g4s-vp! u) (g4s-vp! w)
  (g4s-T-typed! x u) (g4s-T-typed! x w)
  (subst (dk-cite! 'gns-ms-eq 'a 'f))
  (subst (g4s-cite*! 'ipms-dist-norm g4s-P (list T u) (list T w)))
  (subst (g4s-cite*! 'ipms-dist-norm g4s-P u w))
  (let* ((nw (list (list 'VNEG g4s-P) w))
         (e (g4s-cite*! 'gns-op-vneg 'a 'f x w)))
    (g4s-cite*! 'cips-vneg-type g4s-P w)
    (subst (list '= (caddr e) (cadr e)))
    (let ((e2 (g4s-cite*! 'gns-op-vadd 'a 'f x u nw)))
      (subst (list '= (caddr e2) (cadr e2))))
    (let ((z (list (list 'VADD g4s-P) u nw)))
      (g4s-cite*! 'cips-vadd-type g4s-P u nw)
      (g4s-cite*! 'gns-op-norm-bound 'a 'f x z)
      (dk-ass!))))
(g4s-qed! 'gns-op-lipschitz)

(sp (g4s-st (g4s-allx (g4s-add-hyp (g4s-T 'x)))))
(dk-peel!) (g4s-base!) (g4s-pms!)
(let* ((g (dk-goal)) (x (g4s-x-of (cadr g))) (v (cadr (cadr (cadr g)))) (z (caddr (cadr (cadr g)))))
  (g4s-vp! v) (g4s-vp! z)
  (subst (dk-cite! 'gns-hmod-vadd 'a 'f))
  (subst (g4s-cite*! 'gns-op-vadd 'a 'f x v z))
  (g4s-close-eq!))
(g4s-qed! 'gns-op-add-pm)

(sp (g4s-st (g4s-allx (g4s-hom-hyp (g4s-T 'x)))))
(dk-peel!) (g4s-base!) (g4s-pms!)
(let* ((g (dk-goal)) (x (g4s-x-of (cadr g))) (c (cadr (cadr (cadr g)))) (v (caddr (cadr (cadr g)))))
  (g4s-vp! v)
  (subst (dk-cite! 'gns-hmod-act 'a 'f))
  (subst (g4s-cite*! 'gns-op-act 'a 'f x c v))
  (g4s-close-eq!))
(g4s-qed! 'gns-op-hom-pm)

(sp (g4s-st (g4s-allx (g4s-bound-hyp (g4s-T 'x) (list '* (g4s-nx 'x) (g4s-nx 'x))))))
(dk-peel!) (g4s-base!) (g4s-pms!)
(let* ((g (dk-goal)) (x (g4s-x-of (cadr (cadr g)))) (v (cadr (cadr (cadr g)))))
  (g4s-vp! v)
  (subst (dk-cite! 'gns-hform-ip 'a 'f))
  (g4s-cite*! 'gns-op-bounded 'a 'f x v)
  (dk-ass!))
(g4s-qed! 'gns-op-bound-pm)

;;; ---- the algebra laws of GNS-OP, read as pointwise identities on PTS(FORM-MS)
(define (g4s-ally body) (list 'FORALL 'y (list 'IMPLIES '(IN y (VEC a)) body)))
(define (g4s-allc body) (list 'FORALL 'c (list 'IMPLIES '(IN c CC) body)))
(define (g4s-pm-law! lemma args)      ; peel, type v, rewrite HM/HF accessors to P, cite the ba4-gns law
  (dk-peel!) (g4s-base!) (g4s-pms!)
  (for-each (lambda (h) (if (and (dk-head-is? h 'IN) (equal? (caddr h) g4s-PM)) (g4s-vp! (cadr h)))) (dk-asms))
  (if (g4s-occurs? (list 'VADD g4s-HM) (dk-goal)) (subst (dk-cite! 'gns-hmod-vadd 'a 'f)))
  (if (g4s-occurs? (list 'ACT g4s-HM) (dk-goal)) (subst (dk-cite! 'gns-hmod-act 'a 'f)))
  (if (g4s-occurs? g4s-HF (dk-goal)) (subst (dk-cite! 'gns-hform-ip 'a 'f)))
  (subst (apply g4s-cite*! lemma 'a 'f (args (dk-goal))))
  (g4s-close-eq!))

(sp (g4s-st (g4s-allx (g4s-ally (g4s-ptw (lambda (v)
  (list '= (list (g4s-T '((VADD a) x y)) v) (list (list 'VADD g4s-HM) (list (g4s-T 'x) v) (list (g4s-T 'y) v)))))))))
(g4s-pm-law! 'gns-op-sum (lambda (g) (let ((arg (cadddr (car (cadr g))))) (list (cadr arg) (caddr arg) (cadr (cadr g))))))
(g4s-qed! 'gns-op-sum-pm)

(sp (g4s-st (g4s-allx (g4s-ally (g4s-ptw (lambda (v)
  (list '= (list (g4s-T '((VMUL a) x y)) v) (list (g4s-T 'x) (list (g4s-T 'y) v)))))))))
(g4s-pm-law! 'gns-op-mul (lambda (g) (let ((arg (cadddr (car (cadr g))))) (list (cadr arg) (caddr arg) (cadr (cadr g))))))
(g4s-qed! 'gns-op-mul-pm)

(sp (g4s-st (g4s-ptw (lambda (v) (list '= (list (g4s-T '(VONE a)) v) v)))))
(g4s-pm-law! 'gns-op-unit (lambda (g) (list (cadr (cadr g)))))
(g4s-qed! 'gns-op-unit-pm)

(sp (g4s-st (g4s-allc (g4s-allx (g4s-ptw (lambda (v)
  (list '= (list (g4s-T '((ACT a) c x)) v) (list (list 'ACT g4s-HM) 'c (list (g4s-T 'x) v)))))))))
(g4s-pm-law! 'gns-op-scale (lambda (g) (let ((arg (cadddr (car (cadr g))))) (list (cadr arg) (caddr arg) (cadr (cadr g))))))
(g4s-qed! 'gns-op-scale-pm)

(sp (g4s-st (g4s-allx (g4s-ptw2 (lambda (v z)
  (list '= (list g4s-HF (list (g4s-T 'x) v) z) (list g4s-HF v (list (g4s-T '((VSTAR a) x)) z))))))))
(g4s-pm-law! 'gns-op-adjoint
  (lambda (g) (let* ((l (cadr g))) (list (g4s-x-of (cadr l)) (cadr (cadr l)) (caddr l)))))
(g4s-qed! 'gns-op-adj-pm)

;;; ---- the lifts are bounded operators of H_phi; pi(x) is the lift of GNS-OP(x)
(define (g4s-L t) (list 'COMPLETION-LIFT g4s-M t))
(define (g4s-lift-hyps! x)
  (g4s-cite*! 'gns-hmod-is-module 'a 'f) (g4s-cite*! 'gns-hmod-scal 'a 'f) (g4s-cite*! 'gns-hform-ipf 'a 'f)
  (g4s-cite*! 'gns-op-pm-type 'a 'f x)
  (dk-split! (g4s-cite*! 'uiba-vnrm-real 'a x))
  (g4s-cite*! 'gns-op-lipschitz 'a 'f x))

(sp (g4s-st (g4s-allx (list 'IN (g4s-L (g4s-T 'x)) (list 'BOUNDED-OPS g4s-HC g4s-HC)))))
(dk-peel!) (g4s-base!)
(let* ((x (cadddr (caddr (cadr (dk-goal))))))
  (g4s-lift-hyps! x)
  (g4s-cite*! 'gns-op-add-pm 'a 'f x) (g4s-cite*! 'gns-op-hom-pm 'a 'f x) (g4s-cite*! 'gns-op-bound-pm 'a 'f x)
  (g4s-cite*! 'completion-lift-bounded g4s-HM g4s-HF (g4s-T x) (g4s-nx x))
  (dk-ass!))
(g4s-qed! 'gns-lift-bounded)

(sp (g4s-st (list '== g4s-H g4s-HC)))
(dk-peel!) (mac 'GNS-SPACE) (qrfl)
(g4s-qed! 'gns-space-eq)

