(define g4s-GM '(GNS-MODULE a))
(define g4s-GF '(GNS-FORM a f))
(define g4s-N (list 'FORM-NULL g4s-GM g4s-GF))
(define g4s-QM (list 'QUOTIENT-MODULE g4s-GM g4s-N))
(define g4s-HM '(GNS-HMOD a f))
