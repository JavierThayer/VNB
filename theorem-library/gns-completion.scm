;;; ---- Theorem 4.13, first half: (H_phi, pi_phi) is a representation
(define (g4s-law!)
  (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!))
  (let ((g (dk-goal)))
    (if (not (dk-head-is? g '=))
        (dk-ass!)
        (let* ((arg (cadr (cadr g))) (op (car arg)) (H g4s-H) (pi g4s-pi))
          (cond ((equal? op '(VADD a))
                 (let ((x (cadr arg)) (y (caddr arg)))
                   (g4s-cite*! 'gns-rep-bounded 'a 'f x) (g4s-cite*! 'gns-rep-bounded 'a 'f y)
                   (subst (g4s-cite*! 'bh-vadd-value H (list pi x) (list pi y)))
                   (g4s-cite*! 'gns-rep-sum 'a 'f x y)))
                ((equal? op '(ACT a))
                 (let ((c (cadr arg)) (x (caddr arg)))
                   (g4s-cite*! 'gns-rep-bounded 'a 'f x)
                   (subst (g4s-cite*! 'bh-act-value H c (list pi x)))
                   (g4s-cite*! 'gns-rep-scale 'a 'f c x)))
                ((equal? op '(VMUL a))
                 (let ((x (cadr arg)) (y (caddr arg)))
                   (g4s-cite*! 'gns-rep-bounded 'a 'f x) (g4s-cite*! 'gns-rep-bounded 'a 'f y)
                   (subst (g4s-cite*! 'bh-vmul-value H (list pi x) (list pi y)))
                   (g4s-cite*! 'gns-rep-mul 'a 'f x y)))
                ((equal? op '(VSTAR a))
                 (let ((x (cadr arg)))
                   (g4s-cite*! 'gns-rep-bounded 'a 'f x)
                   (subst (g4s-cite*! 'bh-vstar-value H (list pi x)))
                   (g4s-cite*! 'gns-rep-star 'a 'f x)))
                ((eq? op 'VONE) (g4s-cite*! 'gns-rep-unit 'a 'f))
                (#t (error "g4s-law!: no law for" (expression->string g))))
          (dk-ass!)))))

(sp (g4s-st (list 'IS-REPRESENTATION 'a g4s-H g4s-pi)))
(dk-peel!) (g4s-base!)
(let ((H g4s-H))
  (g4s-cite*! 'gns-space-is-hilbert 'a 'f)
  (g4s-cite*! 'gns-space-is-cips 'a 'f)
  (g4s-cite*! 'gns-rep-type 'a 'f)
  (mac 'IS-REPRESENTATION) (mac 'IS-STAR-HOM) (mac 'IS-ALG-HOM)
  (for-each (lambda (ro) (subst (dk-cite! ro H)))
            '(bh-ro-vec bh-ro-vadd bh-ro-act bh-ro-vmul bh-ro-vone bh-ro-vstar))
  (dk-conj-close! g4s-law!))
(g4s-qed! 'gns-rep-is-representation)

