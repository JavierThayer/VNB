(define g4s-HC (list 'HILBERT-COMPLETION g4s-HM g4s-HF))
(define g4s-H '(GNS-SPACE a f))
(define (g4s-T x) (list 'GNS-OP 'a 'f x))
(define (g4s-nx x) (list '(VNRM a) x))

