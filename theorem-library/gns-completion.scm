;;; ---- xi is a cyclic vector: E(A / N_phi) is dense and lies in the orbit pi(A) xi
(define g4s-E (list 'HC-EMBED g4s-HM g4s-HF))
(define g4s-u0 '(GNS-VECTOR a f))
(define (g4s-hc-facts!)
  (g4s-cite*! 'gns-hmod-is-module 'a 'f) (g4s-cite*! 'gns-hmod-scal 'a 'f) (g4s-cite*! 'gns-hform-ipf 'a 'f)
  (g4s-cite*! 'hilbert-completion-is-cips g4s-HM g4s-HF)
  (dk-cite! 'gns-hmod-vec 'a 'f)
  (g4s-cite*! 'gns-vector-in 'a 'f)
  (g4s-have! (list 'IN g4s-u0 (list 'VEC g4s-HM)) (lambda () (subst (list '= (list 'VEC g4s-HM) g4s-VP)) (dk-ass!))))
(sp (g4s-st (list 'IS-CYCLIC-VECTOR-REP 'a g4s-H g4s-pi g4s-xi)))
(dk-peel!) (g4s-base!)
(g4s-hc-facts!)
(let* ((Eu (list g4s-E g4s-u0)) (S (list 'IP-METRIC-SPACE g4s-HC)) (PS (list 'PTS S)) (VH g4s-VH)
       (O (list 'REP-ORBIT 'a g4s-HC g4s-pi Eu)) (CL (list 'CLOSURE S O))
       (I (list 'IMAGE g4s-E (list 'VEC g4s-HM))) (CI (list 'CLOSURE S I)))
  (g4s-have! (list 'IN g4s-xi (list 'VEC g4s-H))
    (lambda () (mac 'GNS-XI) (subst (dk-cite! 'gns-space-eq 'a 'f)) (g4s-cite*! 'hc-embed-type g4s-HM g4s-HF g4s-u0) (dk-ass!)))
  (mac 'IS-CYCLIC-VECTOR-REP) (mac 'GNS-XI)
  (subst (dk-cite! 'gns-space-eq 'a 'f))
  (g4s-cite*! 'hc-embed-type g4s-HM g4s-HF g4s-u0)
  (g4s-cite*! 'ip-metric-space-is-metric-space g4s-HC)
  (dk-cite! 'ip-metric-space-pts g4s-HC)
  ;; the orbit lies in H
  (g4s-have! (list 'SUBSET O PS)
    (lambda ()
      (subst (list '= PS VH))
      (mac 'REP-ORBIT) (mac 'SUBSET) (di)
      (let* ((m (car (filter (lambda (h) (and (dk-head-is? h 'IN) (dk-head-is? (caddr h) 'SEP))) (dk-asms))))
             (l (dk-landed (lambda () (sep-me m)))))
        (for-each (lambda (h) (if (dk-head-is? h 'AND) (dk-split! h))) l)
        (dk-ass!))))
  ;; E(A / N_phi) lies in the orbit (gns-cyclic + completion-lift-embed)
  (g4s-have! (list 'SUBSET I O)
    (lambda ()
      (mac 'SUBSET) (di)
      (let* ((w (cadr (dk-goal))))
        (dk-iff-fwd! (dk-cite! 'image-membership-iff g4s-E (list 'VEC g4s-HM) w))
        (let* ((ex (car (filter (lambda (h) (dk-head-is? h 'FORSOME)) (dk-asms))))
               (x0 (dk-skolem! ex #t)))
          (g4s-have! (list 'IN x0 g4s-VP) (lambda () (subst (list '= g4s-VP (list 'VEC g4s-HM))) (dk-ass!)))
          (let* ((ex2 (g4s-cite*! 'gns-cyclic 'a 'f x0))
                 (b (dk-skolem! ex2 #t)))
            (g4s-lift-hyps! b)
            (g4s-T-typed! b g4s-u0)
            (g4s-have! (list 'IN (list (g4s-T b) g4s-u0) (list 'VEC g4s-HM))
              (lambda () (subst (list '= (list 'VEC g4s-HM) g4s-VP)) (dk-ass!)))
            (mac 'REP-ORBIT)
            (in-sep!
              (lambda ()
                (subst (list '= w (list g4s-E x0)))
                (g4s-cite*! 'hc-embed-type g4s-HM g4s-HF x0)
                (dk-ass!))
              (lambda ()
                (ew b)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-asm? (dk-goal)) (dk-ass!)
                        (begin
                          (subst (list '= w (list g4s-E x0)))
                          (subst (list '= x0 (list (g4s-T b) g4s-u0)))
                          (subst (g4s-cite*! 'gns-rep-value 'a 'f b))
                          (subst (g4s-cite*! 'completion-lift-embed g4s-HM g4s-HF (g4s-T b) (g4s-nx b) g4s-u0))
                          (g4s-cite*! 'hc-embed-type g4s-HM g4s-HF (list (g4s-T b) g4s-u0))
                          (g4s-close-eq!))))))))))))
  ;; closure(O) = H
  (g4s-cite*! 'hc-embed-dense g4s-HM g4s-HF)
  (dk-iff-fwd! (dk-cite! 'is-dense S I))
  (g4s-cite*! 'closure-in-carrier S O)
  (g4s-cite*! 'closure-contains S O)
  (g4s-cite*! 'subset-trans I O CL)
  (g4s-cite*! 'closure-is-closed S O)
  (g4s-cite*! 'closure-in-closed S I CL)
  (g4s-cite*! 'subset-trans PS CI CL)
  (g4s-cite*! 'bmx-subset-antisym CL PS)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (dk-ass!)
          (begin (subst (list '= VH PS)) (dk-ass!))))))
(g4s-qed! 'gns-rep-cyclic)

