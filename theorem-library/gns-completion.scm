;;; ==== DEFINITION 4.25 and PROPOSITION 4.30: a positive functional vanishes on the radical ====
(define g4s-rad-body
  '(SEP g4hx_ (VEC a)
     (FORALL g4hv_ (FORALL g4hq_ (IMPLIES (IS-REPRESENTATION a g4hv_ g4hq_)
       (= (g4hq_ g4hx_) (BOP-ZERO g4hv_ g4hv_)))))))
(sp (make-wff (list 'FORALL 'a (list '== '(RADICAL a) g4s-rad-body))))
(dk-peel!) (mac 'RADICAL) (qrfl)
(g4s-qed! 'radical-unfold)

(sp (g4s-st '(FORALL x (IMPLIES (IN x (RADICAL a)) (= (f x) 0)))))
(dk-peel!) (g4s-base!)
(let* ((x (cadr (cadr (dk-goal)))) (H g4s-H) (pi g4s-pi) (xi g4s-xi))
  (dk-cite! 'radical-unfold 'a)
  (let* ((m (dk-rewrite-h! (list 'IN x '(RADICAL a)) '(RADICAL a) g4s-rad-body))
         (l (dk-landed (lambda () (sep-me m)))))
    (for-each (lambda (h) (if (dk-head-is? h 'AND) (dk-split! h))) l))
  (let ((hy (car (filter (lambda (h) (and (dk-head-is? h 'FORALL) (g4s-occurs? 'IS-REPRESENTATION h)
                                          (g4s-occurs? x h)))
                         (dk-asms)))))
    (g4s-cite*! 'gns-space-is-hilbert 'a 'f)
    (g4s-cite*! 'gns-space-is-cips 'a 'f)
    (g4s-cite*! 'gns-rep-type 'a 'f)
    (g4s-hc-facts!)
    (g4s-have! (list 'IN xi (list 'VEC H))
      (lambda () (mac 'GNS-XI) (subst (dk-cite! 'gns-space-eq 'a 'f)) (g4s-cite*! 'hc-embed-type g4s-HM g4s-HF g4s-u0) (dk-ass!)))
    (g4s-cite*! 'gns-rep-is-representation 'a 'f)
    (let ((z (dk-apply! hy H pi)))
      (subst (g4s-cite*! 'gns-rep-represents 'a 'f x))
      (subst z)
      (subst (g4s-cite*! 'bop-zero-apply H H xi))
      (subst (g4s-cite*! 'cips-ip-zero-left H xi))
      (g4s-close-eq!))))
(g4s-qed! 'radical-positive-vanishes)
