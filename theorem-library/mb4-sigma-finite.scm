;;; mb4-sigma-finite.scm -- construction of measures, Proposition 7.7 (M-B4, 2026-10-26): a Borel measure on a
;;; separable metric space whose balls of radius r < r0 have finite measure (inequality (192)) is sigma-finite:
;;; the balls of a fixed radius r < r0 around a dense sequence cover X.  Library: measure.  Helper prefix mbf-.
;;;
;;;   ball-finite-sigma-finite   (Prop 7.7)
;;;
;;; Load window: after theorem-library/push-forward (pfw-open-borel), the metric laws (ball-is-open,
;;; ball-membership, metric-sym) and the measure vocabulary (IS-MEASURE, IS-SIGMA-FINITE).
(define (mbf-close-open!) (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))
(define (mbf-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (mbf-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
(define (mbf-iff-parts! iff)
  (let* ((rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (mbf-map (lambda (c) (mbf-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))) cs)))
(define (mbf-sep-open! sp0)
  (let* ((iff (dk-cite! 'is-separable sp0)) (rhs (caddr iff)) (ex (caddr rhs)))
    (dk-project! (list 'IS-METRIC-SPACE sp0) (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (dk-project! ex (lambda () (dk-only! iff (list 'IS-SEPARABLE sp0))))
    (let ((d (dk-skolem! ex))) (dk-split-all!) d)))
(define (mbf-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs))
(define (mbf-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
(define (mbf-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
(define (mbf-chain! ch)
  (let loop ((c ch))
    (cond ((not (dk-head-is? c 'IMPLIES)) c)
          ((dk-asm? (cadr c))
           (let ((new (dk-landed* (lambda () (detach! c)))))
             (loop (if (pair? new) (car new) (caddr c)))))
          (#t (loop (detach-with! c (lambda () (dk-conj-close! (lambda () (ass))))))))))

(sp (make-wff '(FORALL s (IMPLIES (IS-SEPARABLE s) (FORALL mu (IMPLIES (IS-MEASURE (PTS s) (BOREL-SETS s) mu)
  (FORALL r0 (IMPLIES (IN r0 RR-POS-STAR) (IMPLIES (< 0 r0)
    (IMPLIES (FORALL x (IMPLIES (IN x (PTS s)) (FORALL r (IMPLIES (POS-RR r) (IMPLIES (< r r0)
               (AND (< 0 (mu (BALL s x r))) (IN (mu (BALL s x r)) RR)))))))
      (IS-SIGMA-FINITE (PTS s) (BOREL-SETS s) mu)))))))))))
(define mbf-lk (dk-peel!))
(define mbf-hyp (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'BALL))) mbf-lk))
(define mbf-e (mbf-sep-open! 's))
(dk-cite! 'ms-pts-is-set 's)
(define mbf-dense (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS s)) (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
  (list 'FORSOME 'n (list 'AND '(IN n NN) (list '< (list '(DIST s) 'x (list mbf-e 'n)) 'eps))))))))
(define (mbf-body! r)
  (let* ((ball (lambda (n) (list 'BALL 's (list mbf-e n) r)))
         (lam (list 'VNB-LAMBDA 'mbn_ 'NN (ball 'mbn_)))
         (ex (list 'FORSOME 'mbb_ (list 'AND '(IN mbb_ (FUN NN (BOREL-SETS s)))
               (list 'FORALL 'mbn_ (list 'IMPLIES '(IN mbn_ NN) (list '== '(mbb_ mbn_) (ball 'mbn_))))))))
    (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
    (dk-have! (list 'NOT (list '= 0 r))
      (lambda () (di) (dk-have! '(< 0 0) (lambda () (dk-ineq! (list '< 0 r) (list '= 0 r)))) (ai (dk-cite! 'rr-lt-irrefl 0))))
    (dk-have! ex
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type!
                  (lambda ()
                    (let ((n (dk-di-var!)))
                      (dk-cite! 'fun-apply-type-c mbf-e 'NN '(PTS s) n)
                      (mbf-chain! (dk-fact! 'ball-is-open 's (list mbf-e n) r))
                      (dk-cite! 'pfw-open-borel 's (ball n))
                      (mbf-close-open!))))
                (let ((n (dk-di-var!))) (dk-close-if! (lambda () (dk-lam-b!)) qrfl)))))))
    (let* ((b (dk-skolem! ex))
           (val (begin (dk-split-all!) (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f b) (dk-contains? f 'BALL))) "the value clause")))
           (bu (list 'BIG-UNION 'sfk_ 'NN (list b 'sfk_))))
      (mac 'is-sigma-finite)
      (ew b)
      (dk-conj-close!
        (lambda ()
          (let ((g0 (dk-goal)))
            (cond
              ((dk-asm? g0) (ass))
              ((dk-head-is? g0 'FORALL)
               (let ((n (dk-di-var!)))
                 (dk-apply! val n)
                 (subst (list '= (list b n) (ball n)))
                 (dk-cite! 'fun-apply-type-c mbf-e 'NN '(PTS s) n)
                 (dk-split-all! (list (dk-apply! mbf-hyp (list mbf-e n) r)))
                 (mbf-close-open!)))
              (#t
               (mbf-ext2! (cadr g0) '(PTS s)
                 (lambda (w)
                   (let* ((ka (mbf-bu-open! w (cadr g0))) (k (car ka)) (app (cdr ka)))
                     (dk-apply! val k)
                     (let ((app2 (dk-rewrite-h! app (list b k) (ball k))))
                       (mac-h 'ball-membership app2)
                       (dk-split-all!)
                       (mbf-close-open!))))
                 (lambda (w)
                   (let* ((n (dk-skolem! (dk-apply! mbf-dense w r)))
                          (_0 (dk-split-all!))
                          (en (list mbf-e n))
                          (d1 (list '(DIST s) w en)) (d2 (list '(DIST s) en w)))
                     (dk-cite! 'fun-apply-type-c mbf-e 'NN '(PTS s) n)
                     (dk-cite! 'metric-dist-real 's w en) (dk-cite! 'metric-dist-real 's en w)
                     (dk-cite! 'metric-sym 's w en)
                     (dk-have! (list 'IN w (ball n))
                       (lambda ()
                         (mac 'ball-membership)
                         (dk-conj-close!
                           (lambda ()
                             (let ((g1 (dk-goal)))
                               (cond ((dk-asm? g1) (ass))
                                     ((dk-head-is? g1 'NOT)
                                      (di)
                                      (dk-absurd! (list '< d1 r) (list '= d1 d2) (list '= d2 r)))
                                     (#t (dk-ineq! (list '< d1 r) (list '= d1 d2)))))))))
                     (dk-apply! val n)
                     (dk-have! (list 'IN w (list b n)) (lambda () (subst (list '= (list b n) (ball n))) (mbf-close-open!)))
                     (mbf-bu-close! n))))
               (mbf-close-open!)))))))))
(use-cases (car (mbf-iff-parts! (dk-cite! 'rr-pos-star-membership 'r0)))
  (lambda ()
    (dk-split-all!)
    (let ((r '(* 1/2 r0)))
      (dk-type! r 'RR)
      (dk-have! (list '< 0 r) (lambda () (dk-ineq! '(< 0 r0))))
      (dk-have! (list '< r 'r0) (lambda () (dk-ineq! '(< 0 r0))))
      (dk-cite! 'rr-pos-rr-of-lt r)
      (mbf-body! r)))
  (lambda ()
    (dk-type! 1 'RR)
    (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
    (dk-cite! 'rr-pos-rr-of-lt 1)
    (dk-have! '(< 1 r0) (lambda () (subst '(= r0 POS-INF)) (dk-cite! 'rr-lt-pos-inf 1) (mbf-close-open!)))
    (mbf-body! 1)))
(qed 'ball-finite-sigma-finite)
(topic! 'ball-finite-sigma-finite 'analysis)
