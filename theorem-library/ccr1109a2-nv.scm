(dk-cite! 'nf-add-in-carr 'K '(ONE K) '((NEG K) x))
(dk-cite! 'nv-domain-neg 'K 'A 'x)
(dk-cite! 'nv-domain-add 'K 'A '(ONE K) '((NEG K) x))
(define c9a-z (dk-name! c9a-zt-x '(CARR K)))
(let* ((zv c9a-z) (zt c9a-zt-x) (r (c9a-n zv)) (f (c9a-f zv)) (seqv (c9a-seq zv)))
  (dk-have! `(IN ,zv A) (lambda () (subst `(= ,zv ,zt)) (dk-ass!)))
  (c9a-typek! zv)
  (c9a-in-view! zv)
  (let ((sym (dk-cite! 'nf-norm-sub-sym 'K '(ONE K) 'x)))
    (dk-have! `(< ,r 1) (lambda () (subst `(= ,zv ,zt)) (subst sym) (dk-ass!))))
  (dk-have! `(= x ((ADD K) (ONE K) ((NEG K) ,zv))) (lambda () (subst `(= ,zv ,zt)) (c9a-crs! '(x))))
  ;; the inverse y of x in K, |y| = 1
  (dk-have! '(NOT (= x (ZERO K)))
    (lambda ()
      (di)
      (dk-absurd! (dk-rewrite-h! `(= ,(c9a-n 'x) 1) 'x '(ZERO K)) `(= ((FNRM K) (ZERO K)) 0))))
  (let* ((y (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-inverse 'K 'x))))
         (exy `(= ((MUL K) x ,y) (ONE K))))
    (c9a-typek! y)
    (let ((my (dk-cite! 'nf-norm-mult 'K 'x y)))
      (dk-have! `(= ,(c9a-n y) 1)
        (lambda () (dk-ineq! (dk-rewrite-h! (dk-rewrite-h! my `((MUL K) x ,y) '(ONE K)) (c9a-n 'x) 1) `(= ,(c9a-n '(ONE K)) 1)))))
    ;; the summands and the partial sums are typed, and lie in A
    (dk-have! `(IN ,f (FUN NN (CARR ,c9a-v)))
      (lambda () (dk-lam-type! (lambda () (let ((w (dk-di-var!))) (dk-cite! 'ring-power-type c9a-v zv w) (dk-close-if-asm!))))))
    (dk-have! `(IN (IDEN ,c9a-ag) A)
      (lambda () (subst `(= (IDEN ,c9a-ag) (ZERO ,c9a-v))) (subst `(= (ZERO ,c9a-v) (ZERO K))) (dk-ass!)))
    (dk-have! `(FORALL x_ (IMPLIES (IN x_ A) (FORALL y_ (IMPLIES (IN y_ A) (IN ((OPR ,c9a-ag) x_ y_) A)))))
      (lambda ()
        (let* ((ls (dk-peel!))
               (vs (map cadr (filter (lambda (h) (and (dk-head-is? h 'IN) (equal? (caddr h) 'A))) ls))))
          (subst `(= (OPR ,c9a-ag) (ADD ,c9a-v))) (subst `(= (ADD ,c9a-v) (ADD K)))
          (dk-cite! 'nv-domain-add 'K 'A (car vs) (cadr vs))
          (dk-close-if-asm!))))
    (define (c9a-s-typed! n)
      (let ((s (c9a-s zv n)))
        (dk-cite! 'sum-ag-type-ring-additive-ag c9a-v f n)
        (c9a-from-view! s)
        (dk-have! `(FORALL i_ (IMPLIES (IN i_ (ORD-SEGMENT ,n)) (IN (,f i_) A)))
