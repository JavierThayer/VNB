                               ((MUL K) ,s ((ADD K) (ONE K) ((NEG K) ((MUL K) x ,y)))))))
          (dk-cite! 'ring-power-type c9a-v zv n)
          (c9a-from-view! p)
          (dk-cite! 'nf-neg-in-carr 'K y)
          (dk-cite! 'power-real-closed r n)
          (dk-have! `(= ((ADD K) ,s ,ny) ,rhs1) (lambda () (c9a-crs! (list s y 'x))))
          (dk-have! `(= ((ADD K) ,s ,ny) ((MUL K) ,ny ,p))
            (lambda ()
              (subst `(= ((ADD K) ,s ,ny) ,rhs1))
              (subst exy)
              (subst g)
              (c9a-crs! (list s y p))))
          (subst (dk-cite! 'nf-metric-distance 'K s y))
          (subst `(= ((ADD K) ,s ,ny) ((MUL K) ,ny ,p)))
          (subst (dk-cite! 'nf-norm-mult 'K ny p))
          (subst (dk-cite! 'nf-norm-neg 'K y))
          (subst `(= ,(c9a-n y) 1))
          (subst (dk-cite! 'nv-pow-norm-power 'K zv n))
          (dk-ineq!))))
    ;; s_n -> y in K
    (let* ((ab (dk-chain-ass! (dk-cite! 'rr-abs-of-nonneg r)))
           (_ (dk-have! `(< (ABS ,r) 1) (lambda () (subst ab) (dk-ass!))))
           (_1 (dk-have-and! `(IN ,r RR) `(< (ABS ,r) 1)))
           (pc (dk-chain-ass! (dk-cite! 'power-tends-to-zero r)))
           (lamr (caddr pc))
           (piff (dk-cite! 'converges-to 'RR-MS lamr 0))
           (_2 (dk-iff-fwd! piff))
           (rlaw (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'POS-RR) (dk-contains? h 'RR-MS))) "the real limit law"))
           (civ (dk-cite! 'converges-to c9a-s0 seqv y)))
      (dk-have! (caddr civ)
        (lambda ()
          (dk-conj-close!
            (lambda ()
              (cond ((dk-ass!) #t)
                    ((dk-head-is? (dk-goal) 'IN)
                     (subst `(== (PTS ,c9a-s0) (CARR K)))
                     (if (dk-head-is? (caddr (dk-goal)) 'FUN)
                         (dk-lam-type! (lambda () (let ((w (dk-di-var!)))
                                                     (dk-cite! 'sum-ag-type-ring-additive-ag c9a-v f w)
                                                     (subst `(= (CARR K) (CARR ,c9a-v)))
                                                     (dk-ass!))))
                         (dk-ass!)))
                    (#t
                     (let* ((ls (dk-peel!))
                            (eps (dk-landed-eps ls))
                            (_e (dk-cite! 'rr-pos-rr-in-rr eps))
                            (nb (dk-skolem! (dk-chain-ass! (dk-apply! rlaw eps))))
                            (tl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nb) (dk-contains? h 'RR-MS))) "the tail law")))
                       (ew nb)
                       (dk-conj-close!
                         (lambda ()
                           (if (not (dk-ass!))
                               (let* ((ls2 (dk-peel!))
                                      (n (cadr (find-first (lambda (h) (and (dk-head-is? h 'IN) (eq? (caddr h) 'NN))) ls2)))
                                      (h0 (dk-chain-ass! (dk-apply! tl n)))
                                      (p `(power ,r ,n)))
                                 (dk-lam-b-h! h0)
                                 (dk-cite! 'power-real-closed r n)
                                 (dk-cite! 'rr-ms-dist p 0)
                                 (let* ((h1 (dk-pick (lambda (h) (and (dk-head-is? h '<=) (dk-contains? h 'RR-MS) (dk-contains? h p))) "the reduced tail bound"))
                                        (h2 (dk-rewrite-h! h1 `((DIST RR-MS) ,p 0) `(ABS (- ,p 0)))))
                                   (dk-type! `(- ,p 0))
                                   (dk-cite! 'rr-le-abs `(- ,p 0))
                                   (dk-lam-b!)
                                   (subst (dk-chain-ass! (dk-apply! c9a-dist n)))
                                   (dk-ineq! h2 `(<= (- ,p 0) (ABS (- ,p 0))))))))))))))))
      (dk-iff-bwd! civ))
    ;; Cauchy in K, Cauchy in A, a limit L in A, L = y
    (dk-chain-ass! (dk-cite! 'metric-converges-to-cauchy c9a-s0 seqv y))
    (dk-have! `(IN ,seqv (FUN NN A))
      (lambda () (dk-lam-type! (lambda () (let ((w (dk-di-var!))) (c9a-s-typed! w) (dk-close-if-asm!))))))
    (dk-iff-bwd! (dk-chain-ass! (dk-cite! 'subspace-is-cauchy-seq c9a-s0 'A seqv)))
    (let* ((cv (dk-chain-ass! (dk-cite! 'complete-cauchy-converges c9a-s1 seqv)))
           (ci (dk-cite! 'converges c9a-s1 seqv))
           (_ (dk-iff-fwd! ci))
           (l (dk-skolem! (caddr ci))))
      (dk-iff-fwd! (dk-cite! 'converges-to c9a-s1 seqv l))
      (dk-have! `(IN ,l A) (lambda () (subst `(== A (PTS ,c9a-s1))) (dk-ass!)))
      (dk-iff-fwd! (dk-chain-ass! (dk-cite! 'subspace-converges-to c9a-s0 'A seqv l)))
      (dk-chain-ass! (dk-cite! 'metric-limit-unique c9a-s0 seqv l y))
      (dk-have! `(IN ,y A) (lambda () (subst `(= ,y ,l)) (dk-ass!)))
      (ew y)
      (dk-conj-close!
        (lambda ()
          (cond ((dk-ass!) #t)
                (#t (subst `(= ,zt ,zv)) (dk-ass!))))))))
(qed 'ccr-1-47-neumann)

;; Proposition 1.47: x in U1(A) is invertible in A, and U1(A) is a subgroup of U(A)
(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-COMPLETE-NV-DOMAIN K A) (FORALL x (IMPLIES (IN x (NV-U1 K A)) (IN x (NV-UNITS K A)))))))))
(dk-peel!)
(dk-cite! 'nv-complete-domain 'K 'A)
(dk-cite! 'nv-u1-sub 'K 'A 'x)
(let ((y (dk-skolem! (dk-chain-ass! (dk-cite! 'ccr-1-47-neumann 'K 'A 'x)))))
  (subst (dk-cite! 'nv-units-unfold 'K 'A))
  (in-sep! (lambda () (dk-ass!))
           (lambda () (ew y) (dk-conj-close! (lambda () (dk-ass!))))))
(qed 'ccr-1-47-unit)

(sp (make-wff '(FORALL K (FORALL A (IMPLIES (IS-COMPLETE-NV-DOMAIN K A)
  (AND (SUBSET (NV-U1 K A) (NV-UNITS K A))
  (AND (IN (ONE K) (NV-U1 K A))
  (AND (FORALL x (IMPLIES (IN x (NV-U1 K A)) (FORALL y (IMPLIES (IN y (NV-U1 K A)) (IN ((MUL K) x y) (NV-U1 K A))))))
       (FORALL x (IMPLIES (IN x (NV-U1 K A)) (FORSOME y (AND (IN y (NV-U1 K A)) (= ((MUL K) x y) (ONE K))))))))))))))
(dk-peel!)
(dk-cite! 'nv-complete-domain 'K 'A)
(dk-cite! 'nv-u1-one 'K 'A)
(dk-conj-close!
  (lambda ()
    (cond ((dk-ass!) #t)
          ((dk-head-is? (dk-goal) 'SUBSET)
           (mac 'subset-def)
           (let ((w (dk-di-var!))) (dk-chain-ass! (dk-cite! 'ccr-1-47-unit 'K 'A w)) (dk-close-if-asm!)))
          ((dk-contains? (dk-goal) 'FORSOME)
           (let* ((w (dk-di-var!))
                  (y (dk-skolem! (dk-chain-ass! (dk-cite! 'ccr-1-47-neumann 'K 'A w)))))
             (dk-chain-ass! (dk-cite! 'nv-u1-inverse-in 'K 'A w y))
             (ew y)
             (dk-conj-close! (lambda () (dk-ass!)))))
          (#t
           (let* ((ls (dk-peel!))
                  (vs (map cadr (filter (lambda (h) (dk-head-is? h 'IN)) ls))))
             (dk-chain-ass! (dk-cite! 'nv-u1-mul 'K 'A (car vs) (cadr vs)))
             (dk-close-if-asm!))))))
(qed 'ccr-1-47-subgroup)
