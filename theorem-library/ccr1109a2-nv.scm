        s))
    ;; x s_n = 1 - z^n
    (define c9a-geo
      `(FORALL cnn_ (IMPLIES (IN cnn_ NN) (= ((MUL K) x ,(c9a-s zv 'cnn_)) ((ADD K) (ONE K) ((NEG K) ,(c9a-pw zv 'cnn_)))))))
    (dk-have! c9a-geo
      (lambda ()
        (let ((n (dk-di-var!)))
          (dk-cite! 'ring-geometric-partial-sum c9a-v zv n)
          (subst `(= x ((ADD K) (ONE K) ((NEG K) ,zv))))
          (for-each (lambda (op) (subst `(= (,op K) (,op ,c9a-v)))) '(MUL ADD NEG ONE))
          (dk-close-if-asm!))))
    ;; d(s_n, y) = |z|^n
    (define c9a-dist
      `(FORALL cnn_ (IMPLIES (IN cnn_ NN) (= ((DIST ,c9a-s0) ,(c9a-s zv 'cnn_) ,y) (power ,r cnn_)))))
    (dk-have! c9a-dist
      (lambda ()
        (let* ((n (dk-di-var!))
               (s (c9a-s-typed! n))
               (p (c9a-pw zv n))
