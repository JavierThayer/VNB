;;; 3. Proposition 1.47: the Neumann series converges to an inverse in A.

(define c9a-stmt
  `(FORALL K (FORALL A (IMPLIES (IS-COMPLETE-NV-DOMAIN K A) (FORALL x (IMPLIES (IN x (NV-U1 K A))
     (FORSOME y (AND (IN y A) (AND (= ((MUL K) x y) (ONE K)) (CONVERGES-TO ,c9a-s0 ,(c9a-seq (c9a-zt 'x)) y))))))))))

(sp (make-wff c9a-stmt))
