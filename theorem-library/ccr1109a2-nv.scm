;;; ccr1109a2-nv.scm -- CCR.pdf Proposition 1.47: in a complete NV domain A, every x in U1(A) is invertible,
;;; its inverse is the sum of the Neumann series sum_k (1 - x)^k, and U1(A) is a subgroup of U(A).
;;; Vocabulary: structure-library/ccr1109a2-vocab.scm (IS-COMPLETE-NV-DOMAIN, NV-U1).  Agent CCR-1109-A2, wave
;;; 2026-11-09.  Destination: theorem-library/ccr1109a2-nv.scm.  Library: analysis.  Helper prefix c9a-.
;;; Variables: K the field, A the domain.
;;;
;;; The notes' series (17) reads sum (x - 1_A)^k; the Neumann series of x = 1 - z is sum z^k with z = 1 - x
;;; (fixed silently).  The partial sums are SUM-AG over RING-ADDITIVE-AG of the commutative-ring view of K, the
;;; powers RING-POWER of that view (the convention of nv-pow-in-domain, ccr2-nv).
;;;
;;; THE PROOF.  |x| = 1 (ultrametric, |x - 1| < 1), so x /= 0 has an inverse y in K with |y| = 1.  z = 1 - x is in
;;; A with |z| < 1.  The geometric identity (ring-geometric-partial-sum) gives x s_n = 1 - z^n, hence
;;; s_n - y = -y z^n and d(s_n, y) = |z|^n -> 0 (power-tends-to-zero): s_n -> y in K.  So (s_n) is Cauchy in K
;;; (metric-converges-to-cauchy), hence in the subspace A (subspace-is-cauchy-seq), whose completeness gives a
;;; limit L in A; L is also a limit in K (subspace-converges-to), so L = y (metric-limit-unique) and y is in A.
;;;
;;; LOAD WINDOW: after structure-library/ccr1109a2-vocab, theorem-library/ccr2-nv (nv-pow-in-domain,
;;; nv-pow-norm-power, nf-inverse, nv-ultra), ccr1109a2-geom (ring-geometric-partial-sum), ccr1109a2-metric
;;; (metric-converges-to-cauchy), rake-series2 (power-tends-to-zero), the metric subspace laws
;;; (subspace-is-cauchy-seq, subspace-converges-to); i.e. right after theorem-library/ccr2-nv.  Nothing cites it.

;; a ring identity in K over the variables VS (each in CARR K): `crs' through the commutative-ring view
(define (c9a-crs! vs)
  (let ((view '(NORMED-FIELD-AS-COMMUTATIVE-RING K)))
    (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
    (for-each (lambda (r) (dk-cite! r 'K))
              '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
                normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one))
    (for-each (lambda (u)
                (dk-have! `(IN ,u (CARR ,view)) (lambda () (subst `(= (CARR ,view) (CARR K))) (dk-ass!))))
              vs)
    (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,view)))))
              '(ADD MUL NEG ZERO ONE))
    (crs)))

(define c9a-v '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define c9a-ag `(RING-ADDITIVE-AG ,c9a-v))
(define c9a-s0 '(NF-METRIC-SPACE K))
(define c9a-s1 '(SUBSPACE-MS (NF-METRIC-SPACE K) A))
(define (c9a-n t) `((FNRM K) ,t))
(define (c9a-pw z n) `(RING-POWER ,c9a-v ,z ,n))
(define (c9a-f z) `(VNB-LAMBDA cgk NN ,(c9a-pw z 'cgk)))
(define (c9a-s z n) `(SUM-AG ,c9a-ag ,(c9a-f z) ,n))
(define (c9a-seq z) `(VNB-LAMBDA cnn_ NN ,(c9a-s z 'cnn_)))
(define (c9a-zt x) `((ADD K) (ONE K) ((NEG K) ,x)))
(define (c9a-m1 x) `((ADD K) ,x ((NEG K) (ONE K))))      ; x - 1

