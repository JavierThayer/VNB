;;; l2b-b.scm -- FUBINI FOR AN INTEGRABLE (SIGNED) FUNCTION ON X x Y (TH3-L2B, 2026-11-09).
;;; Helper prefix: tlb-.
;;;
;;; F1 (TH3-L2 report).  For f integrable on X x Y with respect to the product measure rho of
;;; two sigma-finite measures:
;;;   * off a mu-null set of x, the section f(x, .) is nu-integrable;
;;;   * the function G(x) = U(x) - V(x), U and V the inner integrals of f+ and f- truncated to
;;;     0 where they are +inf (a mu-null set), is mu-integrable, equals RINTEGRAL(f(x, .)) off
;;;     that null set, and its integral is RINTEGRAL(f) on X x Y.
;;; Route: tonelli-product on f+ and f-; integral-finite-ae-finite (a function with finite
;;; integral is finite a.e.); the truncation lemma below; rintegral-decomposition.
;;; The function G is written with IF so that it is a total real function on X: the tree's
;;; convention (real-integral.scm) has total functions and "a.e." as a clause.  Any real
;;; measurable g that agrees with x |-> RINTEGRAL(f(x, .)) off a null set then has the same
;;; integral (rintegral-ae-eq).
;;;
;;; LOAD WINDOW: after theorem-library/real-integral, theorem-library/lp-inequalities
;;; (integral-finite-ae-finite), theorem-library/integral-convergence (integral-sub,
;;; measurable-fn-sub), theorem-library/sip-c (ae-null-union) and l2c-b (tonelli-product,
;;; measurable-fn-in-fun).  Library: measure.  No new vocabulary.

(define (tlb-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** l2b-b: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "l2b-b: unfinished" name))))

(define (tlb-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (tlb-open?) (not (proof-done? *ps*)))
(define (tlb-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
(define (tlb-lb!) (let loop () (if (dk--redex? (dk-goal)) (begin (dk-lam-b!) (loop)))))
(define (tlb-parts! pred args)
  (let* ((iff (apply dk-cite! (cons pred args)))
         (cs (let loop ((r (caddr iff)) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (tlb-map (lambda (c) (if (dk-asm? c) c
                             (dk-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))))
             cs)))
(define (tlb-ptwise var dom body) (list 'FORALL var (list 'IMPLIES (list 'IN var dom) body)))

;;; ==========================================================================================
;;; (1) TRUNCATION: a [0, +inf] function with finite integral, set to 0 where it is +inf
;;; ==========================================================================================
(define (tlb-trunc u om) (list 'VNB-LAMBDA 'tdx_ om (list 'IF (list 'IN (list u 'tdx_) 'RR) (list u 'tdx_) 0)))
(define (tlb-infset u om) (list 'SEP 'x_ om (list '= (list u 'x_) 'POS-INF)))

(define tlb-t (tlb-trunc 'u 'omega))
(define tlb-inf (tlb-infset 'u 'omega))
(sp (make-wff (forall-guarded '(omega cA mu u)
   '((IS-MEASURE omega cA mu) (IS-MEASURABLE-FN omega cA u) (IN (INTEGRAL omega cA mu u) RR))
   (list 'AND (list 'IS-MEASURABLE-FN 'omega 'cA tlb-t)
     (list 'AND (tlb-ptwise 'x 'omega (list 'IN (list tlb-t 'x) 'RR))
       (list 'AND (list '= (list 'INTEGRAL 'omega 'cA 'mu tlb-t) '(INTEGRAL omega cA mu u))
         (list 'AND (list 'IS-NULL-SET 'omega 'cA 'mu tlb-inf)
           (tlb-ptwise 'x 'omega (list 'IMPLIES (list 'NOT (list 'IN 'x tlb-inf))
                                       (list 'AND '(IN (u x) RR) (list '= (list tlb-t 'x) '(u x))))))))))))
(dk-peel!)
(tlb-parts! 'is-measure '(omega cA mu))
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(dk-cite! 'measurable-fn-in-fun 'omega 'cA 'u)
(fact 'zero-in-rr-pos-star)
(fact 'rr-zero-in)
(let* ((z0 '(VNB-LAMBDA cx_ omega 0))
       (hh (list 'VNB-LAMBDA 'dx_ 'omega (list 'IF '(IN (u dx_) RR) (list '- '(u dx_) (list z0 'dx_)) 0)))
       (it (list 'INTEGRAL 'omega 'cA 'mu tlb-t))
       (ih (list 'INTEGRAL 'omega 'cA 'mu hh))
       (iu '(INTEGRAL omega cA mu u)))
  (fact 'measurable-fn-const 'omega 'cA 0)
  (fact 'integral-zero-fn 'omega 'cA 'mu)
  (dk-have! (tlb-ptwise 'x 'omega (list '<= (list z0 'x) '(u x)))
    (lambda () (let ((w (dk-di-var!)))
                 (fact 'fun-apply-type-c 'u 'omega 'RR-POS-STAR w)
                 (tlb-lb!)
                 (tlb-then-ass! (lambda () (fact 'rr-pos-star-nonneg (list 'u w)))))))
  (fact 'measurable-fn-sub 'omega 'cA 'u z0)
  (let ((ise (dk-cite! 'integral-sub 'omega 'cA 'mu 'u z0)))
    ;; T is a [0, +inf] function and agrees with H pointwise
    (dk-have! (list 'IN tlb-t '(FUN omega RR-POS-STAR))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((w (dk-di-var!)))
              (fact 'fun-apply-type-c 'u 'omega 'RR-POS-STAR w)
              (tlb-lb!)
              (dk-case-if! (list 'IF (list 'IN (list 'u w) 'RR) (list 'u w) 0)
                (lambda (t? v) (if (tlb-open?) (ass))))))
          (lambda () (ass)))))
    (dk-have! (tlb-ptwise 'x 'omega (list '= (list hh 'x) (list tlb-t 'x)))
      (lambda ()
        (let ((w (dk-di-var!)))
          (fact 'fun-apply-type-c 'u 'omega 'RR-POS-STAR w)
          (tlb-lb!)
          (let ((i1 (list 'IF (list 'IN (list 'u w) 'RR) (list '- (list 'u w) 0) 0))
                (i2 (list 'IF (list 'IN (list 'u w) 'RR) (list 'u w) 0)))
            (dk-case-if! i1
              (lambda (t? v)
                (dk-if-branch! t? i2 #f
                  (lambda () (if (tlb-open?) (if t? (crs) (rfl)))))))))))
    (dk-cite! 'measurable-fn-in-fun 'omega 'cA hh)
    (fact 'measurable-fn-congruence-ptwise 'omega 'cA hh tlb-t)
    (fact 'integral-congruence-ptwise 'omega 'cA 'mu hh tlb-t)
    (fact 'integral-in 'omega 'cA 'mu hh)
    (let* ((e1 (dk-rewrite-h! ise (list 'INTEGRAL 'omega 'cA 'mu z0) 0))
           (ez (dk-cite! 'eplus-zero-right ih))
           (e2 (dk-rewrite-h! e1 (list 'eplus ih 0) ih)))
      (dk-have! (list '= it iu)
        (lambda () (subst (list '= it ih)) (ass)))))
  ;; T real-valued
  (dk-have! (tlb-ptwise 'x 'omega (list 'IN (list tlb-t 'x) 'RR))
    (lambda ()
      (let ((w (dk-di-var!)))
        (fact 'fun-apply-type-c 'u 'omega 'RR-POS-STAR w)
        (tlb-lb!)
        (dk-case-if! (list 'IF (list 'IN (list 'u w) 'RR) (list 'u w) 0)
          (lambda (t? v) (if (tlb-open?) (ass)))))))
  ;; the infinite set is null
  (fact 'rr-lt-pos-inf iu)
  (dk-split! (dk-cite! 'integral-finite-ae-finite 'omega 'cA 'mu 'u))
  (dk-have! (list 'IS-NULL-SET 'omega 'cA 'mu tlb-inf)
    (lambda () (mac 'IS-NULL-SET) (ew tlb-inf) (fact 'subset-refl tlb-inf) (dk-conj-close! dk-ass!)))
  ;; off it, u is real and T = u
  (dk-have! (tlb-ptwise 'x 'omega (list 'IMPLIES (list 'NOT (list 'IN 'x tlb-inf))
                                       (list 'AND '(IN (u x) RR) (list '= (list tlb-t 'x) '(u x)))))
    (lambda ()
      (let ((w (dk-di-var!)))
        (di)
        (fact 'fun-apply-type-c 'u 'omega 'RR-POS-STAR w)
        (let ((iff (dk-cite! 'rr-pos-star-membership (list 'u w)))
              (ne (list 'NOT (list '= (list 'u w) 'POS-INF))))
          (dk-have! ne
            (lambda ()
              (di)
              (dk-have! (list 'IN w tlb-inf) (lambda () (in-sep! (lambda () (ass)))))
              (keep (list 'IN w tlb-inf) (list 'NOT (list 'IN w tlb-inf)))
              (prop)))
          (dk-have! (list 'IN (list 'u w) 'RR)
            (lambda () (keep iff ne (list 'IN (list 'u w) 'RR-POS-STAR)) (prop)))
          (dk-have! (list '= (list tlb-t w) (list 'u w))
            (lambda ()
              (tlb-lb!)
              (dk-if-branch! #t (list 'IF (list 'IN (list 'u w) 'RR) (list 'u w) 0) #f
                (lambda () (if (tlb-open?) (rfl))))))
          (dk-conj-close! dk-ass!)))))
  (dk-conj-close! dk-ass!))
(tlb-qed! 'integral-finite-truncate)

;;; ==========================================================================================
;;; (2) THE PARTS OF A SECTION ARE THE SECTIONS OF THE PARTS
;;; ==========================================================================================
(define tlb-xy '(CARTESIAN xs ys))
(define tlb-ps '(PRODUCT-SIGMA xs cA ys cB))
(define tlb-rho '(PRODUCT-MEASURE xs cA mu ys cB nu))
(define (tlb-xsi f) (list 'X-SECTION-INTEGRAL 'xs 'ys 'cB 'nu f))
(define (tlb-fxs f x) (list 'FN-X-SECTION 'ys f x))
(define tlb-pf (list 'POS-PART tlb-xy 'f))
(define tlb-nf (list 'NEG-PART tlb-xy 'f))

;;; f real measurable on X x Y, x in X: the section is real measurable, and the integrals of
;;; its parts are the inner integrals of f+ and f- at x
(sp (make-wff (forall-guarded '(xs cA ys cB nu f x)
   (list '(IS-SIGMA-ALGEBRA xs cA) '(IS-MEASURE ys cB nu) (list 'IS-REAL-MEASURABLE-FN tlb-xy tlb-ps 'f) '(IN x xs))
   (list 'AND (list 'IS-REAL-MEASURABLE-FN 'ys 'cB (tlb-fxs 'f 'x))
     (list 'AND (list '= (list 'INTEGRAL 'ys 'cB 'nu (list 'POS-PART 'ys (tlb-fxs 'f 'x))) (list (tlb-xsi tlb-pf) 'x))
                (list '= (list 'INTEGRAL 'ys 'cB 'nu (list 'NEG-PART 'ys (tlb-fxs 'f 'x))) (list (tlb-xsi tlb-nf) 'x)))))))
(dk-peel!)
(tlb-parts! 'is-measure '(ys cB nu))
(tlb-parts! 'is-real-measurable-fn (list tlb-xy tlb-ps 'f))
(fact 'sigma-algebra-ambient-set 'ys 'cB)
(let* ((sec (tlb-fxs 'f 'x)))
  (dk-have! (list 'IN sec '(FUN ys RR))
    (lambda ()
      (mac 'FN-X-SECTION)
      (dk-lam-type!
        (lambda ()
          (let ((w (dk-di-var!)))
            (fact 'pair-in-cartesian 'xs 'ys 'x w)
            (tlb-then-ass! (lambda () (fact 'fun-apply-type-c 'f tlb-xy 'RR (list 'LIST 'x w))))))
        (lambda () (ass)))))
  (fact 'pos-part-fun 'ys sec)
  (fact 'neg-part-fun 'ys sec)
  (for-each
    (lambda (pp)
      (let* ((part (car pp)) (pf (list part tlb-xy 'f)) (ps (list part 'ys sec)) (val (cadr pp))
             (fs (tlb-fxs pf 'x)))
        (fact 'fn-x-section-measurable 'xs 'cA 'ys 'cB pf 'x)
        (dk-cite! 'measurable-fn-in-fun 'ys 'cB fs)
        (dk-have! (tlb-ptwise 'icx_ 'ys (list '= (list fs 'icx_) (list ps 'icx_)))
          (lambda ()
            (let* ((w (dk-di-var!)) (pr (list 'LIST 'x w)))
              (fact 'pair-in-cartesian 'xs 'ys 'x w)
              (fact 'fun-apply-type-c 'f tlb-xy 'RR pr)
              (dk-split! (dk-cite! 'part-values-at tlb-xy 'f pr))
              (subst (dk-cite! 'fn-x-section-apply 'ys pf 'x w))
              (subst (dk-cite! val 'ys sec w))
              (subst (dk-cite! 'fn-x-section-apply 'ys 'f 'x w))
              (let ((ve (dk-cite! val tlb-xy 'f pr)))
                (subst (list '= (caddr ve) (cadr ve))))
              (if (tlb-open?) (rfl)))))
        (fact 'measurable-fn-congruence-ptwise 'ys 'cB fs ps)
        (fact 'integral-congruence-ptwise 'ys 'cB 'nu fs ps)
        (dk-cite! 'x-section-integral-apply 'xs 'ys 'cB 'nu pf 'x)
        (fact 'integral-in 'ys 'cB 'nu ps)
        (dk-have! (list '= (list 'INTEGRAL 'ys 'cB 'nu ps) (list (tlb-xsi pf) 'x))
          (lambda ()
            (subst (list '= (list (tlb-xsi pf) 'x) (list 'INTEGRAL 'ys 'cB 'nu fs)))
            (subst (list '= (list 'INTEGRAL 'ys 'cB 'nu fs) (list 'INTEGRAL 'ys 'cB 'nu ps)))
            (if (tlb-open?) (rfl))))))
    '((POS-PART pos-part-value) (NEG-PART neg-part-value)))
  (dk-have! (list 'IS-REAL-MEASURABLE-FN 'ys 'cB sec)
    (lambda () (mac 'IS-REAL-MEASURABLE-FN) (dk-conj-close! dk-ass!)))
  (dk-conj-close! dk-ass!))
(tlb-qed! 'section-parts)

;;; ==========================================================================================
;;; (3) FUBINI FOR AN INTEGRABLE FUNCTION
;;; ==========================================================================================
(define tlb-u (tlb-xsi tlb-pf))
(define tlb-v (tlb-xsi tlb-nf))
(define tlb-tu (tlb-trunc tlb-u 'xs))
(define tlb-tv (tlb-trunc tlb-v 'xs))
(define tlb-g
  (list 'VNB-LAMBDA 'sgx_ 'xs
        (list '- (list 'IF (list 'IN (list tlb-u 'sgx_) 'RR) (list tlb-u 'sgx_) 0)
                 (list 'IF (list 'IN (list tlb-v 'sgx_) 'RR) (list tlb-v 'sgx_) 0))))
(define (tlb-gval w)
  (list '- (list 'IF (list 'IN (list tlb-u w) 'RR) (list tlb-u w) 0)
           (list 'IF (list 'IN (list tlb-v w) 'RR) (list tlb-v w) 0)))

(sp (make-wff (forall-guarded '(xs cA mu ys cB nu f)
   (list '(IS-MEASURE xs cA mu) '(IS-MEASURE ys cB nu) '(IS-SIGMA-FINITE xs cA mu) '(IS-SIGMA-FINITE ys cB nu)
         (list 'IS-INTEGRABLE tlb-xy tlb-ps tlb-rho 'f))
   (list 'AND (list 'IS-INTEGRABLE 'xs 'cA 'mu tlb-g)
     (list 'AND (list '= (list 'RINTEGRAL 'xs 'cA 'mu tlb-g) (list 'RINTEGRAL tlb-xy tlb-ps tlb-rho 'f))
       (list 'FORSOME 'en_
         (list 'AND '(IS-NULL-SET xs cA mu en_)
           (tlb-ptwise 'x 'xs (list 'IMPLIES '(NOT (IN x en_))
              (list 'AND (list 'IS-INTEGRABLE 'ys 'cB 'nu (tlb-fxs 'f 'x))
                         (list '= (list tlb-g 'x) (list 'RINTEGRAL 'ys 'cB 'nu (tlb-fxs 'f 'x)))))))))))))
(dk-peel!)
(tlb-parts! 'is-measure '(xs cA mu))
(tlb-parts! 'is-measure '(ys cB nu))
(fact 'sigma-algebra-ambient-set 'xs 'cA)
(fact 'product-sigma-is-sigma-algebra 'xs 'cA 'ys 'cB)
(fact 'product-measure-is-measure 'xs 'cA 'mu 'ys 'cB 'nu)
(tlb-parts! 'is-integrable (list tlb-xy tlb-ps tlb-rho 'f))
(tlb-parts! 'is-real-measurable-fn (list tlb-xy tlb-ps 'f))
(fact 'rr-zero-in)
(let* ((trs
        (tlb-map
          (lambda (pf)
            (let* ((uu (tlb-xsi pf))
                   (fb (dk-cite! 'fubini 'xs 'cA 'mu 'ys 'cB 'nu pf))
                   (m (dk-project! (list 'IS-MEASURABLE-FN 'xs 'cA uu) (lambda () (dk-split-all! (list fb)))))
                   (tp (dk-cite! 'tonelli-product 'xs 'cA 'mu 'ys 'cB 'nu pf)))
              (dk-have! (list 'IN (list 'INTEGRAL 'xs 'cA 'mu uu) 'RR)
                (lambda () (subst (list '= (list 'INTEGRAL 'xs 'cA 'mu uu) (list 'INTEGRAL tlb-xy tlb-ps tlb-rho pf))) (ass)))
              (dk-split! (dk-cite! 'integral-finite-truncate 'xs 'cA 'mu uu))))
          (list tlb-pf tlb-nf)))
       (tu tlb-tu) (tv tlb-tv)
       (tlb-ptw (lambda (l) (find-first (lambda (q) (and (dk-head-is? q 'FORALL) (not (dk-contains? q 'NOT)))) l)))
       (tlb-off (lambda (l) (find-first (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q 'NOT))) l)))
       (ptw-u (tlb-ptw (car trs))) (ptw-v (tlb-ptw (cadr trs))))
  ;; G is T_U - T_V pointwise, and real
  (define (tlb-g-real! w)
    (let ((a (dk-apply! ptw-u w)) (b (dk-apply! ptw-v w)))
      (dk-lam-b-h! a) (dk-lam-b-h! b)
      (tlb-lb!)
      (tlb-then-ass! (lambda () (fact 'rr-sub-in-rr (list 'IF (list 'IN (list tlb-u w) 'RR) (list tlb-u w) 0)
                                                     (list 'IF (list 'IN (list tlb-v w) 'RR) (list tlb-v w) 0))))))
  (dk-have! (tlb-ptwise 'x 'xs (list 'IN (list tlb-g 'x) 'RR))
    (lambda () (tlb-g-real! (dk-di-var!))))
  (dk-have! (list 'IN tlb-g '(FUN xs RR))
    (lambda () (dk-lam-type! (lambda () (tlb-g-real! (dk-di-var!)))
                             (lambda () (ass)))))
  (dk-have! (tlb-ptwise 'x 'xs (list '= (list tlb-g 'x) (list '- (list tu 'x) (list tv 'x))))
    (lambda ()
      (let ((w (dk-di-var!)))
        (let ((a (dk-apply! ptw-u w)) (b (dk-apply! ptw-v w)))
          (dk-lam-b-h! a) (dk-lam-b-h! b)
          (tlb-lb!)
          (if (tlb-open?) (rfl))))))
  (for-each (lambda (tt uu)
              (dk-have! (list 'IN (list 'INTEGRAL 'xs 'cA 'mu tt) 'RR)
                (lambda () (subst (list '= (list 'INTEGRAL 'xs 'cA 'mu tt) (list 'INTEGRAL 'xs 'cA 'mu uu))) (ass))))
            (list tu tv) (list tlb-u tlb-v))
  (let ((dc (dk-split! (dk-cite! 'rintegral-decomposition 'xs 'cA 'mu tlb-g tu tv))))
    (dk-have! (list '= (list 'RINTEGRAL 'xs 'cA 'mu tlb-g) (list 'RINTEGRAL tlb-xy tlb-ps tlb-rho 'f))
      (lambda ()
        (subst (list '= (list 'RINTEGRAL 'xs 'cA 'mu tlb-g)
                     (list '- (list 'INTEGRAL 'xs 'cA 'mu tu) (list 'INTEGRAL 'xs 'cA 'mu tv))))
        (subst (list '= (list 'INTEGRAL 'xs 'cA 'mu tu) (list 'INTEGRAL 'xs 'cA 'mu tlb-u)))
        (subst (list '= (list 'INTEGRAL 'xs 'cA 'mu tv) (list 'INTEGRAL 'xs 'cA 'mu tlb-v)))
        (subst (list '= (list 'INTEGRAL 'xs 'cA 'mu tlb-u) (list 'INTEGRAL tlb-xy tlb-ps tlb-rho tlb-pf)))
        (subst (list '= (list 'INTEGRAL 'xs 'cA 'mu tlb-v) (list 'INTEGRAL tlb-xy tlb-ps tlb-rho tlb-nf)))
        (subst (dk-cite! 'rintegral-unfold tlb-xy tlb-ps tlb-rho 'f))
        (if (tlb-open?) (rfl)))))
  ;; the exceptional set
  (let* ((iu (tlb-infset tlb-u 'xs)) (iv (tlb-infset tlb-v 'xs))
         (en (list 'UNION iu iv))
         (off-u (tlb-off (car trs))) (off-v (tlb-off (cadr trs))))
    (fact 'ae-null-union 'xs 'cA 'mu iu iv)
    (dk-have! (list 'FORSOME 'en_
                (list 'AND '(IS-NULL-SET xs cA mu en_)
                  (tlb-ptwise 'x 'xs (list 'IMPLIES '(NOT (IN x en_))
                     (list 'AND (list 'IS-INTEGRABLE 'ys 'cB 'nu (tlb-fxs 'f 'x))
                                (list '= (list tlb-g 'x) (list 'RINTEGRAL 'ys 'cB 'nu (tlb-fxs 'f 'x))))))))
      (lambda ()
        (ew en)
        (dk-conj-close!
          (lambda ()
            (if (dk-asm? (dk-goal)) (ass)
                (let ((w (dk-di-var!)))
                  (di)
                  (let ((um (dk-cite! 'union-membership iu iv w)))
                    (dk-have! (list 'NOT (list 'IN w iu)) (lambda () (keep um (list 'NOT (list 'IN w en))) (prop)))
                    (dk-have! (list 'NOT (list 'IN w iv)) (lambda () (keep um (list 'NOT (list 'IN w en))) (prop))))
                  (dk-split! (dk-apply! off-u w))
                  (dk-split! (dk-apply! off-v w))
                  (let* ((sec (tlb-fxs 'f w))
                         (sp3 (dk-split! (dk-cite! 'section-parts 'xs 'cA 'ys 'cB 'nu 'f w)))
                         (ipos (list 'INTEGRAL 'ys 'cB 'nu (list 'POS-PART 'ys sec)))
                         (ineg (list 'INTEGRAL 'ys 'cB 'nu (list 'NEG-PART 'ys sec))))
                    (dk-have! (list 'IN ipos 'RR) (lambda () (subst (list '= ipos (list tlb-u w))) (ass)))
                    (dk-have! (list 'IN ineg 'RR) (lambda () (subst (list '= ineg (list tlb-v w))) (ass)))
                    (dk-have! (list 'IS-INTEGRABLE 'ys 'cB 'nu sec)
                      (lambda () (mac 'IS-INTEGRABLE) (dk-conj-close! dk-ass!)))
                    (dk-have! (list '= (list tlb-g w) (list 'RINTEGRAL 'ys 'cB 'nu sec))
                      (lambda ()
                        (tlb-lb!)
                        (subst (dk-cite! 'rintegral-unfold 'ys 'cB 'nu sec))
                        (subst (list '= ipos (list tlb-u w)))
                        (subst (list '= ineg (list tlb-v w)))
                        (dk-if-branch! #t (list 'IF (list 'IN (list tlb-u w) 'RR) (list tlb-u w) 0) #f
                          (lambda ()
                            (dk-if-branch! #t (list 'IF (list 'IN (list tlb-v w) 'RR) (list tlb-v w) 0) #f
                              (lambda () (if (tlb-open?) (rfl))))))))
                    (dk-conj-close! dk-ass!))))))))
    (dk-conj-close! dk-ass!)))
(tlb-qed! 'signed-fubini)
(alias! 'signed-fubini "Fubini for an integrable function on a product of sigma-finite measure spaces: almost every section is integrable and the iterated integral is the integral")
