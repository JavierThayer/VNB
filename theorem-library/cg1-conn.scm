;;; cg1-conn.scm -- connectedness in topological spaces and the connected component of a
;;; topological group (compact-groups notes, Lemma 5.7 and Proposition 5.8).
;;; Agent ISOM, 2026-10-26.  Helper prefix: cgc-.  Library: analysis.

(define (cgc-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (cgc-and! a b) (dk-have! (list 'AND a b) (lambda () (dk-conj-close! (lambda () (ass))))))
(define (cgc-head g) (and (pair? g) (car g)))
;; land the right side of an IFF instance whose left side is in context, split
(define (cgc-rhs! iff)
  (dk-have! (caddr iff) (lambda () (if (dk-only! iff (cadr iff)) (prop))))
  (dk-split-all! (list (caddr iff))))
;; land the left side of an IFF instance from its right side, built by THUNK
(define (cgc-lhs! iff thunk)
  (dk-have! (caddr iff) thunk)
  (dk-have! (cadr iff) (lambda () (if (dk-only! iff (caddr iff)) (prop)))))
(define (cgc-lc f)
  (list 'FORALL 'lz_ (list 'IMPLIES '(IN lz_ (PTS s)) (list 'FORALL 'lw_ (list 'IMPLIES '(IN lw_ (OPENS s))
    (list 'IMPLIES (list 'IN (list f 'lz_) 'lw_)
      (list 'FORSOME 'lu_ (list 'AND '(IN lu_ (OPENS s)) (list 'AND '(IN lz_ lu_)
        (list 'FORALL 'lq_ (list 'IMPLIES '(IN lq_ lu_) (list 'IN (list f 'lq_) 'lw_))))))))))))
(define (cgc-in-open! q V)                ; q in an open V: q in PTS s
  (dk-cite! 'top-open-subset 's V)
  (dk-cite! 'subset-mem-fwd V '(PTS s) q))
(define (cgc-pre-parts! a W)
  (cgc-rhs! (dk-cite! 'preimage-membership 's 'f W a)))
(define (cgc-pre-intro! a W)
  (let ((iff (dk-cite! 'preimage-membership 's 'f W a)))
    (cgc-lhs! iff (lambda () (dk-conj-close! (lambda () (cgc-ass!)))))))

;;; ---- local continuity gives open preimages ----
(sp (make-wff (list 'FORALL 's (list 'FORALL 'f (list 'IMPLIES '(IS-TOP-SPACE s) (list 'IMPLIES '(IN f (FUN (PTS s) (PTS s)))
   (list 'IMPLIES (cgc-lc 'f) '(FORALL W (IMPLIES (IN W (OPENS s)) (IN (PREIMAGE s f W) (OPENS s)))))))))))
(dk-peel!)
(define cgc-lcf (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'lz_))) "local continuity"))
(dk-have! '(SUBSET (PREIMAGE s f W) (PTS s))
  (lambda () (mac 'subset-def)
             (let ((a (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
               (cgc-pre-parts! a 'W) (cgc-ass!))))
(dk-have! '(FORALL a (IMPLIES (IN a (PREIMAGE s f W)) (FORSOME W2 (AND (IN W2 (OPENS s)) (AND (IN a W2) (SUBSET W2 (PREIMAGE s f W)))))))
  (lambda ()
    (let* ((a (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
      (cgc-pre-parts! a 'W)
      (let* ((u (dk-skolem! (dk-apply! cgc-lcf a 'W)))
             (cl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u))) "the image clause")))
        (dk-split-all!)
        (ew u)
        (dk-conj-close!
         (lambda ()
           (if (dk-head-is? (dk-goal) 'SUBSET)
               (begin (mac 'subset-def)
                      (let ((q (cadr (car (filter (lambda (h) (dk-head-is? h 'IN)) (dk-peel!))))))
                        (cgc-in-open! q u)
                        (dk-apply! cl q)
                        (cgc-pre-intro! q 'W)
                        (cgc-ass!)))
               (cgc-ass!))))))))
(dk-cite! 'top-open-of-local 's '(PREIMAGE s f W))
(cgc-ass!)
(qed 'local-continuity-preimage-open)
(topic! 'local-continuity-preimage-open 'analysis)

;;; ---- the image of a connected set under a locally continuous map is connected ----
(define (cgc-img-elim! w st)              ; (IN w (IMAGE f st)): returns x with x in st, f(x) = w
  (cgc-rhs! (dk-cite! 'image-membership-iff 'f st w))
  (let ((x (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h w) (dk-contains? h st))) "the preimage point"))))
    (dk-split-all!)
    x))
(define (cgc-img-intro! pt st)             ; pt in st, st inside PTS: (IN (f pt) (IMAGE f st))
  (dk-cite! 'subset-mem-fwd st '(PTS s) pt)
  (dk-cite! 'fun-apply-type-c 'f '(PTS s) '(PTS s) pt)
  (dk-cite! 'membership-implies-sethood (list 'f pt) '(PTS s))
  (let ((iff (dk-cite! 'image-membership-iff 'f st (list 'f pt))))
    (cgc-lhs! iff (lambda () (dk-conj-close!
                              (lambda () (if (dk-head-is? (dk-goal) 'FORSOME)
                                             (begin (ew pt) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))))
                                             (cgc-ass!))))))))
(define cgc-IMG '(IMAGE f A))
(sp (make-wff (list 'FORALL 's (list 'FORALL 'f (list 'IMPLIES '(IS-TOP-SPACE s) (list 'IMPLIES '(IN f (FUN (PTS s) (PTS s)))
   (list 'IMPLIES (cgc-lc 'f) '(FORALL A (IMPLIES (IS-CONNECTED-T s A) (IS-CONNECTED-T s (IMAGE f A)))))))))))
(dk-peel!)
(cgc-rhs! (dk-cite! 'is-connected-t 's 'A))
(define cgc-CA (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'ctu_))) "the connectedness of A"))
(dk-have! (list 'SUBSET cgc-IMG '(PTS s))
  (lambda () (mac 'subset-def)
             (let* ((w (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!)))))
                    (x (cgc-img-elim! w 'A)))
               (dk-cite! 'subset-mem-fwd 'A '(PTS s) x)
               (dk-cite! 'fun-apply-type-c 'f '(PTS s) '(PTS s) x)
               (subst (list '= w (list 'f x)))
               (cgc-ass!))))
(let ((iff (dk-cite! 'is-connected-t 's cgc-IMG)))
  (cgc-lhs! iff
   (lambda ()
     (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'SUBSET)
            (cgc-ass!)
            (let* ((pl (dk-peel!))
                   (ops (map cadr (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) '(OPENS s)))) pl)))
                   (cov (car (filter (lambda (q) (dk-head-is? q 'SUBSET)) pl)))
                   (u (cadr (caddr cov))) (v (caddr (caddr cov)))
                   (dis (car (filter (lambda (q) (dk-head-is? q 'FORALL)) pl)))
                   (mt (car (filter (lambda (q) (dk-head-is? q 'FORSOME)) pl)))
                   (pu (list 'PREIMAGE 's 'f u)) (pv (list 'PREIMAGE 's 'f v)))
              (dk-apply! (dk-cite! 'local-continuity-preimage-open 's 'f) u)
              (dk-apply! (dk-cite! 'local-continuity-preimage-open 's 'f) v)
              ;; A is covered by the two preimages
              (dk-have! (list 'SUBSET 'A (list 'UNION pu pv))
                (lambda () (mac 'subset-def)
                           (let ((a (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
                             (cgc-img-intro! a 'A)
                             (dk-cite! 'subset-mem-fwd cgc-IMG (list 'UNION u v) (list 'f a))
                             (cgc-rhs! (dk-cite! 'union-membership u v (list 'f a)))
                             (let ((iffu (dk-cite! 'union-membership pu pv a)))
                               (use-em (list 'IN (list 'f a) u)
                                 (lambda () (cgc-pre-intro! a u) (cgc-lhs! iffu (lambda () (oi-l) (cgc-ass!))))
                                 (lambda ()
                                   (dk-have! (list 'IN (list 'f a) v)
                                     (lambda () (if (dk-only! (list 'OR (list 'IN (list 'f a) u) (list 'IN (list 'f a) v)) (list 'NOT (list 'IN (list 'f a) u))) (prop))))
                                   (cgc-pre-intro! a v) (cgc-lhs! iffu (lambda () (oi-r) (cgc-ass!)))))))))
              ;; ... with no common point in A
              (dk-have! (list 'FORALL 'ctx_ (list 'IMPLIES '(IN ctx_ A) (list 'NOT (list 'AND (list 'IN 'ctx_ pu) (list 'IN 'ctx_ pv)))))
                (lambda ()
                  (let ((a (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
                    (di)
                    (dk-split-all!)
                    (cgc-pre-parts! a u) (cgc-pre-parts! a v)
                    (cgc-img-intro! a 'A)
                    (dk-apply! dis (list 'f a))
                    (dk-have! (list 'AND (list 'IN (list 'f a) u) (list 'IN (list 'f a) v)) (lambda () (dk-conj-close! (lambda () (cgc-ass!)))))
                    (ai (list 'NOT (list 'AND (list 'IN (list 'f a) u) (list 'IN (list 'f a) v)))))))
              ;; A meets the first preimage
              (let* ((y (dk-skolem! mt)))
                (dk-split-all!)
                (let ((x (cgc-img-elim! y 'A)))
                  (dk-have! (list 'IN (list 'f x) u) (lambda () (subst (list '= (list 'f x) y)) (cgc-ass!)))
                  (dk-cite! 'subset-mem-fwd 'A '(PTS s) x)
                  (cgc-pre-intro! x u)
                  (dk-have! (list 'FORSOME 'ctx_ (list 'AND '(IN ctx_ A) (list 'IN 'ctx_ pu))) (lambda () (ew x) (dk-conj-close! (lambda () (cgc-ass!)))))))
              (dk-apply! cgc-CA pu pv)
              ;; so A misses the second preimage, and the image misses v
              (di)
              (let* ((y2 (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h v) (dk-contains? h cgc-IMG))) "a point in v"))))
                (dk-split-all!)
                (let ((x2 (cgc-img-elim! y2 'A)))
                  (dk-have! (list 'IN (list 'f x2) v) (lambda () (subst (list '= (list 'f x2) y2)) (cgc-ass!)))
                  (dk-cite! 'subset-mem-fwd 'A '(PTS s) x2)
                  (cgc-pre-intro! x2 v)
                  (dk-have! (list 'FORSOME 'ctx_ (list 'AND '(IN ctx_ A) (list 'IN 'ctx_ pv))) (lambda () (ew x2) (dk-conj-close! (lambda () (cgc-ass!)))))
                  (ai (list 'NOT (list 'FORSOME 'ctx_ (list 'AND '(IN ctx_ A) (list 'IN 'ctx_ pv))))))))))))))
(qed 'image-connected-t)
(topic! 'image-connected-t 'analysis)

;;; ---- connected sets with a common point: their union is connected ----
(define (cgc-disj C u v)
  (list 'FORALL 'ctx_ (list 'IMPLIES (list 'IN 'ctx_ C) (list 'NOT (list 'AND (list 'IN 'ctx_ u) (list 'IN 'ctx_ v))))))
(define (cgc-meets C u) (list 'FORSOME 'ctx_ (list 'AND (list 'IN 'ctx_ C) (list 'IN 'ctx_ u))))
;; C connected, inside S, where S is covered by u, v without common points: if C meets u it misses v
(define (cgc-conn-use! C S u v)
  (let ((parts (caddr (dk-cite! 'is-connected-t 's C))))
    (if (not (dk-asm? (caddr parts))) (cgc-rhs! (dk-cite! 'is-connected-t 's C)))
    (dk-have! (list 'SUBSET C (list 'UNION u v))
      (lambda () (dk-cite! 'subset-trans C S (list 'UNION u v)) (cgc-ass!)))
    (dk-have! (cgc-disj C u v)
      (lambda ()
        (let ((z (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
          (dk-cite! 'subset-mem-fwd C S z)
          (dk-apply! (dk-ctx-form (cgc-disj S u v)) z)
          (cgc-ass!))))
    (dk-apply! (dk-ctx-form (caddr parts)) u v)))
(define (cgc-sep-hyps!)                  ; peel the separation hypotheses of an IS-CONNECTED-T goal clause; returns (u v x0)
  (let* ((pl (dk-peel!))
         (cov (car (filter (lambda (q) (dk-head-is? q 'SUBSET)) pl)))
         (u (cadr (caddr cov))) (v (caddr (caddr cov)))
         (mt (car (filter (lambda (q) (dk-head-is? q 'FORSOME)) pl)))
         (x0 (dk-skolem! mt)))
    (dk-split-all!)
    (list u v x0 (cadr cov))))

(define cgc-AB '(UNION A B))
(sp (make-wff '(FORALL s (FORALL A (FORALL B (FORALL p (IMPLIES (IS-TOP-SPACE s) (IMPLIES (IS-CONNECTED-T s A) (IMPLIES (IS-CONNECTED-T s B)
   (IMPLIES (IN p A) (IMPLIES (IN p B) (IS-CONNECTED-T s (UNION A B)))))))))))))
(dk-peel!)
(cgc-rhs! (dk-cite! 'is-connected-t 's 'A))
(cgc-rhs! (dk-cite! 'is-connected-t 's 'B))
(define (cgc-ab-parts! z)                ; z in A u B: the OR
  (cgc-rhs! (dk-cite! 'union-membership 'A 'B z)))
(for-each (lambda (C left?)
            (dk-have! (list 'SUBSET C cgc-AB)
              (lambda () (mac 'subset-def)
                         (let ((z (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
                           (cgc-lhs! (dk-cite! 'union-membership 'A 'B z) (lambda () (if left? (oi-l) (oi-r)) (cgc-ass!)))
                           (cgc-ass!)))))
          '(A B) '(#t #f))
(let ((iff (dk-cite! 'is-connected-t 's cgc-AB)))
  (cgc-lhs! iff
   (lambda ()
     (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'SUBSET)
            (begin (mac 'subset-def)
                   (let ((z (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
                     (cgc-ab-parts! z)
                     (use-em (list 'IN z 'A)
                       (lambda () (dk-cite! 'subset-mem-fwd 'A '(PTS s) z) (cgc-ass!))
                       (lambda () (dk-have! (list 'IN z 'B) (lambda () (if (dk-only! (list 'OR (list 'IN z 'A) (list 'IN z 'B)) (list 'NOT (list 'IN z 'A))) (prop))))
                                  (dk-cite! 'subset-mem-fwd 'B '(PTS s) z) (cgc-ass!)))))
            (let* ((uvx (cgc-sep-hyps!)) (u (car uvx)) (v (cadr uvx)) (x0 (caddr uvx)))
              (di)
              (let ((y (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h v) (dk-contains? h cgc-AB))) "a point in v"))))
                (dk-split-all!)
                ;; both A and B miss v once one of them meets u through p
                (dk-cite! 'subset-mem-fwd 'A cgc-AB 'p)
                (dk-cite! 'subset-mem-fwd cgc-AB (list 'UNION u v) 'p)
                (cgc-rhs! (dk-cite! 'union-membership u v 'p))
                (let ((piece (lambda (C D)       ; C contains x0 and meets u: C misses v; then p not in v ...
                               #t)))
                  (use-em (list 'IN 'p u)
                    (lambda ()
                      (dk-have! (cgc-meets 'A u) (lambda () (ew 'p) (dk-conj-close! (lambda () (cgc-ass!)))))
                      (dk-have! (cgc-meets 'B u) (lambda () (ew 'p) (dk-conj-close! (lambda () (cgc-ass!)))))
                      (cgc-conn-use! 'A cgc-AB u v)
                      (cgc-conn-use! 'B cgc-AB u v)
                      (cgc-ab-parts! y)
                      (use-em (list 'IN y 'A)
                        (lambda () (dk-have! (cgc-meets 'A v) (lambda () (ew y) (dk-conj-close! (lambda () (cgc-ass!)))))
                                   (ai (list 'NOT (cgc-meets 'A v))))
                        (lambda () (dk-have! (list 'IN y 'B) (lambda () (if (dk-only! (list 'OR (list 'IN y 'A) (list 'IN y 'B)) (list 'NOT (list 'IN y 'A))) (prop))))
                                   (dk-have! (cgc-meets 'B v) (lambda () (ew y) (dk-conj-close! (lambda () (cgc-ass!)))))
                                   (ai (list 'NOT (cgc-meets 'B v))))))
                    (lambda ()
                      ;; p in v: the piece containing x0 meets u and contains p, a point of v
                      (dk-have! (list 'IN 'p v) (lambda () (if (dk-only! (list 'OR (list 'IN 'p u) (list 'IN 'p v)) (list 'NOT (list 'IN 'p u))) (prop))))
                      (cgc-ab-parts! x0)
                      (use-em (list 'IN x0 'A)
                        (lambda () (dk-have! (cgc-meets 'A u) (lambda () (ew x0) (dk-conj-close! (lambda () (cgc-ass!)))))
                                   (cgc-conn-use! 'A cgc-AB u v)
                                   (dk-have! (cgc-meets 'A v) (lambda () (ew 'p) (dk-conj-close! (lambda () (cgc-ass!)))))
                                   (ai (list 'NOT (cgc-meets 'A v))))
                        (lambda () (dk-have! (list 'IN x0 'B) (lambda () (if (dk-only! (list 'OR (list 'IN x0 'A) (list 'IN x0 'B)) (list 'NOT (list 'IN x0 'A))) (prop))))
                                   (dk-have! (cgc-meets 'B u) (lambda () (ew x0) (dk-conj-close! (lambda () (cgc-ass!)))))
                                   (cgc-conn-use! 'B cgc-AB u v)
                                   (dk-have! (cgc-meets 'B v) (lambda () (ew 'p) (dk-conj-close! (lambda () (cgc-ass!)))))
                                   (ai (list 'NOT (cgc-meets 'B v))))))))))))))))
(qed 'union-connected-t)
(topic! 'union-connected-t 'analysis)

;;; ---- the connected component: unfold, elimination, introduction ----
(define cgc-H '(CONNECTED-COMPONENT s x))
(define cgc-BU '(BIG-UNION ccc_ (SEP ccc_ (POWER (PTS s)) (AND (IS-CONNECTED-T s ccc_) (IN x ccc_))) ccc_))
(sp (make-wff (list 'FORALL 's (list 'FORALL 'x (list '== cgc-H cgc-BU)))))
(dk-peel!)
(mac 'CONNECTED-COMPONENT)
(qrfl)
(qed 'connected-component-unfold)
(topic! 'connected-component-unfold 'plumbing)

(sp (make-wff '(FORALL s (FORALL x (FORALL y (IMPLIES (IN y (CONNECTED-COMPONENT s x))
   (FORSOME C (AND (IS-CONNECTED-T s C) (AND (IN x C) (IN y C))))))))))
(dk-peel!)
(dk-cite! 'connected-component-unfold 's 'x)
(dk-have! (list 'IN 'y cgc-BU) (lambda () (subst (list '= cgc-BU cgc-H)) (ass)))
(let* ((landed (dk-landed (lambda () (bu-me (list 'IN 'y cgc-BU)))))
       (mem (car (filter (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP))) landed)))
       (C (cadr mem)))
  (dk-split-all! (filter (lambda (f) (dk-head-is? f 'AND)) (dk-landed (lambda () (sep-me mem)))))
  (ew C)
  (dk-conj-close! (lambda () (ass))))
(qed 'connected-component-elim)
(topic! 'connected-component-elim 'analysis)

(sp (make-wff '(FORALL s (IMPLIES (IS-TOP-SPACE s) (FORALL C (FORALL x (FORALL y (IMPLIES (IS-CONNECTED-T s C)
   (IMPLIES (IN x C) (IMPLIES (IN y C) (IN y (CONNECTED-COMPONENT s x))))))))))))
(dk-peel!)
(cgc-rhs! (dk-cite! 'is-connected-t 's 'C))
(cgc-rhs! (dk-cite! 'is-top-space 's))
(dk-cite! 'subclass-of-set-is-set 'C '(PTS s))
(dk-have! '(FORALL z_ (IMPLIES (IN z_ C) (IN z_ (PTS s))))
  (lambda () (let ((z (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
               (dk-cite! 'subset-mem-fwd 'C '(PTS s) z) (cgc-ass!))))
(dk-cite! 'power-mem-intro '(PTS s) 'C)
(mac 'CONNECTED-COMPONENT)
(dk-each-leaf! (lambda () (bu-mi 'C))
  (lambda () (if (dk-head-is? (caddr (dk-goal)) 'SEP)
                 (in-sep! (lambda () (cgc-ass!)) (lambda () (dk-conj-close! (lambda () (cgc-ass!)))))
                 (cgc-ass!))))
(qed 'connected-component-intro)
(topic! 'connected-component-intro 'analysis)

;;; ---- a point is connected ----
(sp (make-wff '(FORALL s (IMPLIES (IS-TOP-SPACE s) (FORALL x (IMPLIES (IN x (PTS s)) (IS-CONNECTED-T s (SINGLETON x))))))))
(dk-peel!)
(let ((iff (dk-cite! 'is-connected-t 's '(SINGLETON x))))
  (cgc-lhs! iff
   (lambda ()
     (dk-conj-close!
      (lambda ()
        (if (dk-head-is? (dk-goal) 'SUBSET)
            (begin (mac 'subset-def)
                   (let ((z (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
                     (cgc-rhs! (dk-cite! 'singleton-membership 'x z))
                     (subst (list '= z 'x)) (cgc-ass!)))
            (let* ((uvx (cgc-sep-hyps!)) (u (car uvx)) (v (cadr uvx)) (x0 (caddr uvx)))
              (di)
              (let ((y (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h v))) "a point in v"))))
                (dk-split-all!)
                (cgc-rhs! (dk-cite! 'singleton-membership 'x x0))
                (cgc-rhs! (dk-cite! 'singleton-membership 'x y))
                (dk-rewrite-h! (list 'IN y v) y 'x)
                (dk-rewrite-h! (list 'IN 'x v) 'x x0)
                (dk-apply! (dk-ctx-form (cgc-disj '(SINGLETON x) u v)) x0)
                (if (dk-only! (list 'NOT (list 'AND (list 'IN x0 u) (list 'IN x0 v))) (list 'IN x0 u) (list 'IN x0 v)) (prop))))))))))
(qed 'singleton-connected-t)
(topic! 'singleton-connected-t 'analysis)

(sp (make-wff '(FORALL s (IMPLIES (IS-TOP-SPACE s) (FORALL x (IMPLIES (IN x (PTS s)) (IN x (CONNECTED-COMPONENT s x))))))))
(dk-peel!)
(dk-cite! 'singleton-connected-t 's 'x)
(dk-cite! 'membership-implies-sethood 'x '(PTS s))
(cgc-lhs! (dk-cite! 'singleton-membership 'x 'x) (lambda () (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))
(dk-cite! 'connected-component-intro 's '(SINGLETON x) 'x 'x)
(cgc-ass!)
(qed 'connected-component-self)
(topic! 'connected-component-self 'analysis)

;;; ---- the component is connected ----
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-TOP-SPACE s) (list 'FORALL 'x (list 'IS-CONNECTED-T 's cgc-H))))))
(dk-peel!)
(define (cgc-piece! z)                   ; z in H: a connected C with x, z in C and C inside H
  (let ((C (dk-skolem! (dk-cite! 'connected-component-elim 's 'x z))))
    (dk-split-all!)
    (dk-have! (list 'SUBSET C cgc-H)
      (lambda () (mac 'subset-def)
                 (let ((w (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!))))))
                   (dk-cite! 'connected-component-intro 's C 'x w) (cgc-ass!))))
    C))
