  (mbn-subset! un an0 (lambda (w) (dk-cite! 'union-membership a n w) (dk-cite! 'union-membership a n0 w)
                          (dk-cite! 'subset-mem-fwd n n0 w)))
  (dk-cite! 'measure-monotone 'omega mbn-cs 'nu a un)
  (dk-cite! 'measure-monotone 'omega mbn-cs 'nu un an0)
  (inst*! agree a)
  (inst*! agree an0)
  (mbn-null-of-zero! n0)
