;;; uniqueness: a measure on the completion that agrees with mu on cA is mu-bar
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL nu
  (IMPLIES (IS-MEASURE omega cA mu)
    (IMPLIES (IS-MEASURE omega (COMPLETION-SIGMA omega cA mu) nu)
