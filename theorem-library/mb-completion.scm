(define mbn-cm-typing (list 'IN mbn-cm (list 'FUN mbn-cs 'RR-POS-STAR)))
(dk-have! mbn-cm-typing
  (lambda ()
    (subst (list '== mbn-cm (caddr (dk-cite! 'completion-measure-unfold 'omega 'cA 'mu))))
    (mbn-and! (list 'IN mbn-out '(FUN (POWER omega) RR-POS-STAR)) (list 'SUBSET mbn-cs '(POWER omega)))
    (dk-cite! 'res-codomain '(POWER omega) mbn-cs 'RR-POS-STAR mbn-out)
    (dk-ass!)))
(let* ((iff (dk-fact! 'is-measure 'omega mbn-cara mbn-rc))
       (rhs (caddr iff))
       (add (caddr (caddr (caddr rhs)))))
  (dk-project! add 'IS-MEASURE (list 'IS-MEASURE 'omega mbn-cara mbn-rc))
  (mac 'IS-MEASURE)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-ass!) #t)
          ;; mu-bar(empty) = mu(empty) = 0
          ((dk-head-is? g '=)
           (fact 'sigma-algebra-empty-in 'omega 'cA)
           (dk-cite! 'completion-measure-extends 'omega 'cA 'mu 'EMPTY-SET)
           (subst (list '= (list mbn-cm 'EMPTY-SET) '(mu EMPTY-SET)))
           (if (not (dk-ass!))
               (begin (mac-h 'IS-MEASURE '(IS-MEASURE omega cA mu)) (dk-split-all!) (ass))))
          ;; countable additivity, read off the Caratheodory measure
          (#t
           (let* ((landed (dk-peel!))
                  (fv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'FUN))) landed)))
                  (fu (list 'BIG-UNION 'n_ 'NN (list fv 'n_)))
                  (lam-cm (list 'VNB-LAMBDA 'n_ 'NN (list mbn-cm (list fv 'n_))))
                  (lam-rc (list 'VNB-LAMBDA 'n_ 'NN (list mbn-rc (list fv 'n_)))))
             (dk-have! (list 'SUBSET mbn-cs mbn-cara)
               (lambda ()
                 (mac 'subset-def)
                 (let ((w (dk-di-var!)))
                   (dk-cite! 'completion-sigma-subset-cara 'omega 'cA 'mu w)
                   (dk-ass!))))
             (dk-cite! 'fun-codomain-superset fv 'NN mbn-cs mbn-cara)
             (let ((inst (inst*! add fv)))
               (if (not (memq (car inst) '(= ==)))
                   (let loop ((f inst))
                     (if (and (dk-head-is? f 'IMPLIES) (dk-asm? (cadr f)))
                         (begin (detach! f) (loop (caddr f)))))))
             ;; U f is in the completion; there the two measures agree
             (dk-cite! 'sigma-algebra-union-closed 'omega mbn-cs fv)
             (dk-cite! 'completion-measure-is-cara-measure 'omega 'cA 'mu fu)
             (subst (list '= (list mbn-cm fu) (list mbn-rc fu)))
             ;; the two summand sequences are the same function
             (dk-fun-ext! lam-cm lam-rc 'NN 'RR-POS-STAR
               (lambda () (dk-lam-type! (lambda ()
                 (let ((kv (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                   (fact 'fun-apply-type-c fv 'NN mbn-cs kv)
                   (dk-cite! 'fun-apply-type-c mbn-cm mbn-cs 'RR-POS-STAR (list fv kv))
                   (dk-ass!)))))
               (lambda () (dk-lam-type! (lambda ()
                 (let ((kv (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                   (fact 'fun-apply-type-c fv 'NN mbn-cara kv)
                   (dk-cite! 'caratheodory-measure 'omega mbn-out)
                   (dk-project! (list 'IN mbn-rc (list 'FUN mbn-cara 'RR-POS-STAR)) 'IS-MEASURE
                                (list 'IS-MEASURE 'omega mbn-cara mbn-rc))
                   (dk-cite! 'fun-apply-type-c mbn-rc mbn-cara 'RR-POS-STAR (list fv kv))
                   (dk-ass!)))))
               (lambda (kv)
                 (fact 'fun-apply-type-c fv 'NN mbn-cs kv)
                 (fact 'fun-apply-type-c fv 'NN mbn-cara kv)
                 (dk-lam-b!)
                 (dk-cite! 'completion-measure-is-cara-measure 'omega 'cA 'mu (list fv kv))
                 (dk-ass!)))
             (subst (list '= lam-cm lam-rc))
             (dk-ass!))))))))
(mbn-qed! 'completion-measure-is-measure)

;;; a measurable set of measure 0 is null
(define (mbn-null-of-zero! a)
  (dk-have! (list 'IS-NULL-SET 'omega 'cA 'mu a)
    (lambda ()
      (dk-cite! 'subset-refl a)
      (mac 'IS-NULL-SET) (ew a) (dk-conj-close! dk-ass!))))

;;; X subset Y from the membership facts MEMB! cites at the point, by prop
(define (mbn-subset! x y memb!)
  (dk-have! (list 'SUBSET x y)
    (lambda ()
      (mac 'subset-def)
      (let ((w (dk-di-var!)))
        (memb! w)
        (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop))))))

