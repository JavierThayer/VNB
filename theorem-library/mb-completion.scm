;;; mu-bar is a countably additive measure on the completion
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu
  (IMPLIES (IS-MEASURE omega cA mu)
    (IS-MEASURE omega (COMPLETION-SIGMA omega cA mu) (COMPLETION-MEASURE omega cA mu))))))))
