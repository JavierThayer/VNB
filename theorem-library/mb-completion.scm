(dk-peel!)
(mbn-measure-parts! 'omega 'cA 'mu)
(mbn-measure-parts! 'omega mbn-cs 'nu)
(let* ((agree (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'nu) (dk-contains? f '(mu aa))))
                       "the agreement hypothesis"))
       (an (mbn-rep! 'x)) (a (car an)) (n (cdr an))
       (un (list 'UNION a n))
       ;; the two facts that need N null, before the skolemisation consumes it
