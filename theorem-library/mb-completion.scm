;;; mb-completion.scm -- construction-of-measures.pdf Prop. 3.3 (the completion of a measure)
;;; and the countable union of null sets it rests on.  Agent M-B, 2026-10-26.
;;; DESTINATION: theorem-library/mb-completion.scm.  Library: measure.
;;;
;;;   null-countable-union      a sequence of null sets has a null union (the missing half of
;;;                             the 2.9 row: countable choice of measurable null covers,
;;;                             rmm-nn-choice, then measure-countably-subadditive)
;;;
;;; CITATIONS: rmm-nn-choice (riesz-markov-model), measure-countably-subadditive, esum-nn-zero,
;;; sigma-algebra-union-closed, subset-mem-fwd, fun-apply-type-c, rr-pos-star-le-real-in-rr,
;;; rr-pos-star-nonneg, rr-leq-antisymmetric.
;;; LOAD WINDOW: after theorem-library/riesz-markov-model (3048), measure-laws (3498),
;;; outer-measure-construction (3631), mb-complete.
;;; Helper prefix: mbn-.

(define (mbn-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l)
                  (display ";; OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))

(define (mbn-measure-parts! om ca mu)
  (let* ((iff (dk-fact! 'is-measure om ca mu))
         (rhs (caddr iff))
         (c1 (cadr rhs)) (c2 (cadr (caddr rhs))))
    (map (lambda (c) (dk-project! c 'IS-MEASURE (list 'IS-MEASURE om ca mu)))
         (list c1 c2))))

(define (mbn-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))))

;;; (= (mu X) 0) from (<= (mu X) 0), (IN (mu X) RR-POS-STAR)
(define (mbn-zero! mux)
  (dk-have! (list '= mux 0)
    (lambda ()
      (fact 'rr-zero-in)
      (mbn-and! (list 'IN mux 'RR-POS-STAR) '(IN 0 RR))
      (dk-cite! 'rr-pos-star-le-real-in-rr mux 0)
      (dk-cite! 'rr-pos-star-nonneg mux)
      (mbn-and! (list 'IN mux 'RR) '(IN 0 RR))
      (mbn-and! (list '<= mux 0) (list '<= 0 mux))
      (dk-cite! 'rr-leq-antisymmetric mux 0)
      (ass))))

;;; open (IN W BU) for a BIG-UNION BU: return (index-typing . member)
(define (mbn-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (eq? (car f) 'IN) (not (equal? (cadr f) w)))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons ein app)))

;;; goal (IN W (BIG-UNION v D (body))) with index E: bu-mi E, close both leaves from context
(define (mbn-bu-in! e)
  (for-each (lambda (n) (dk-focus! n) (ass)) (dk-opened (lambda () (bu-mi e)))))

;;; (IN cA SET) from the sigma-algebra (ambient set, POWER, subclass)
(define (mbn-ca-set! om ca)
  (if (not (dk-asm? (list 'IN ca 'SET)))
      (let ((sig (list 'IS-SIGMA-ALGEBRA om ca)))
        (dk-project! (list 'SUBSET ca (list 'POWER om)) 'IS-SIGMA-ALGEBRA sig)
        (dk-cite! 'sigma-algebra-ambient-set om ca)
        (dk-cite! 'power-set om)
        (dk-cite! 'subclass-of-set-is-set ca (list 'POWER om)))))

;;; (IN (SEP ...) SET) for a separation over a set already typed SET in context
(define (mbn-sep-set! sep)
  (if (not (dk-asm? (list 'IN sep 'SET)))
      (dk-have! (list 'IN sep 'SET) (lambda () (sep-set) (ass)))))

;;; ---------------------------------------------------------------------------
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL f_
  (IMPLIES (IS-MEASURE omega cA mu)
    (IMPLIES (IN f_ (FUN NN (POWER omega)))
      (IMPLIES (FORALL k (IMPLIES (IN k NN) (IS-NULL-SET omega cA mu (f_ k))))
        (IS-NULL-SET omega cA mu (BIG-UNION n_ NN (f_ n_))))))))))))
(dk-peel!)
(mbn-measure-parts! 'omega 'cA 'mu)
(mbn-ca-set! 'omega 'cA)
(let* ((nullall (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-NULL-SET)))
                         "the null hypothesis"))
       (fam '(VNB-LAMBDA kq_ NN (SEP nw_ cA (AND (SUBSET (f_ kq_) nw_) (= (mu nw_) 0)))))
       (sepk (lambda (kv) (list 'SEP 'nw_ 'cA (list 'AND (list 'SUBSET (list 'f_ kv) 'nw_) '(= (mu nw_) 0)))))
       (impl (dk-fact! 'rmm-nn-choice 'cA fam)))
  ;; every f(k) has a measurable null cover
  (dk-have! (cadr impl)
    (lambda ()
      (let ((kv (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
        (mbn-sep-set! (sepk kv))
        (dk-lam-b!)
        (inst*! nullall kv)
        (fact 'fun-apply-type-c 'f_ 'NN '(POWER omega) kv)
        (let ((nla (dk-skolem! (dk-landed-1 (lambda () (mac-h 'IS-NULL-SET (list 'IS-NULL-SET 'omega 'cA 'mu (list 'f_ kv)))))
                               #t)))
          (ew nla)
          (dk-conj-close!
            (lambda ()
              (if (dk-asm? (dk-goal))
                  (ass)
                  (in-sep! (lambda () (ass)) (lambda () (dk-conj-close! dk-ass!))))))))))
  (detach! impl)
  (let* ((gv (dk-skolem! (caddr impl) #t))
         (gk (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f gv))) "the choice"))
         (gu (list 'BIG-UNION 'n_ 'NN (list gv 'n_)))
         (fu '(BIG-UNION n_ NN (f_ n_)))
         (esf (list 'VNB-LAMBDA 'n_ 'NN (list 'mu (list gv 'n_))))
         ;; at K in NN: land (SUBSET (f_ K) (g K)) and (= (mu (g K)) 0)
         (at! (lambda (kv)
                (let ((s (list 'SUBSET (list 'f_ kv) (list gv kv)))
                      (z (list '= (list 'mu (list gv kv)) 0)))
                  (if (not (dk-asm? s))
                      (begin
                        (fact 'fun-apply-type-c gv 'NN 'cA kv)
                        (for-each
                          (lambda (c)
                            (dk-have! c
                              (lambda ()
                                (let ((m (inst*! gk kv)))
                                  (mbn-sep-set! (sepk kv))
                                  (dk-lam-b-h! m)
                                  (let ((m2 (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list gv kv))
                                                                      (dk-head-is? (caddr f) 'SEP)))
                                                     "the reduced choice")))
                                    (sep-me m2)
                                    (dk-split-all!)
                                    (ass))))))
                          (list s z))))))))
    (fact 'sigma-algebra-union-closed 'omega 'cA gv)
    (fact 'measure-countably-subadditive 'omega 'cA 'mu gv)
    (dk-have! (list 'IN esf '(FUN NN RR-POS-STAR))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((kv (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
              (fact 'fun-apply-type-c gv 'NN 'cA kv)
              (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR (list gv kv))
              (ass))))))
    (dk-have! (list 'FORALL 'ozn (list 'IMPLIES '(IN ozn NN) (list '= (list esf 'ozn) 0)))
      (lambda ()
        (let ((kv (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
          (fact 'fun-apply-type-c gv 'NN 'cA kv)
          (dk-lam-b!)
          (at! kv)
          (ass))))
    (fact 'esum-nn-zero esf)
    (dk-rewrite-h! (list '<= (list 'mu gu) (list 'ESUM esf)) (list 'ESUM esf) 0)
    (fact 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR gu)
    (mbn-zero! (list 'mu gu))
    ;; U f subset U g
    (dk-have! (list 'SUBSET fu gu)
      (lambda ()
        (mac 'subset-def)
        (let* ((w (dk-di-var!))
               (r (mbn-bu-open! w fu))
               (e (cadr (car r))))
          (at! e)
          (fact 'fun-apply-type-c 'f_ 'NN '(POWER omega) e)
          (fact 'fun-apply-type-c gv 'NN 'cA e)
          (dk-cite! 'subset-mem-fwd (list 'f_ e) (list gv e) w)
          (mbn-bu-in! e))))
    (mac 'IS-NULL-SET)
    (ew gu)
    (dk-conj-close! dk-ass!)))
(mbn-qed! 'null-countable-union)

