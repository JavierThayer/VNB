;;; THE COMPLETION as objects: unfolds, membership, the value mu-bar(A u N) = mu(A).

(define mbn-cs '(COMPLETION-SIGMA omega cA mu))
(define mbn-cm '(COMPLETION-MEASURE omega cA mu))
(define mbn-out '(METHOD-I-OUTER omega cA mu))
(define mbn-cara (list 'CARATHEODORY-SETS 'omega mbn-out))

(sp (make-wff '(FORALL omega (FORALL ca (FORALL mu
  (== (COMPLETION-SIGMA omega ca mu)
      (SEP cps_ (POWER omega)
        (FORSOME cpa_ (AND (IN cpa_ ca)
          (FORSOME cpn_ (AND (IN cpn_ (POWER omega)) (AND (IS-NULL-SET omega ca mu cpn_) (= cps_ (UNION cpa_ cpn_))))))))))))))
(dk-peel!)
(mac 'COMPLETION-SIGMA)
(qrfl)
(mbn-qed! 'completion-sigma-unfold)

(sp (make-wff '(FORALL omega (FORALL ca (FORALL mu
  (== (COMPLETION-MEASURE omega ca mu)
      (RES (METHOD-I-OUTER omega ca mu) (COMPLETION-SIGMA omega ca mu))))))))
(dk-peel!)
(mac 'COMPLETION-MEASURE)
(qrfl)
(mbn-qed! 'completion-measure-unfold)

;;; membership
(sp (make-wff '(FORALL omega (FORALL ca (FORALL mu (FORALL x
  (IFF (IN x (COMPLETION-SIGMA omega ca mu))
       (AND (IN x (POWER omega))
            (FORSOME cpa_ (AND (IN cpa_ ca)
              (FORSOME cpn_ (AND (IN cpn_ (POWER omega)) (AND (IS-NULL-SET omega ca mu cpn_) (= x (UNION cpa_ cpn_)))))))))))))))
(dk-peel!)
(let ((x (cadr (cadr (dk-goal)))))
  (fact 'completion-sigma-unfold 'omega 'ca 'mu)
  (subst (list '== '(COMPLETION-SIGMA omega ca mu) (caddr (dk-cite! 'completion-sigma-unfold 'omega 'ca 'mu))))
  (dk-iff! (lambda (g) (or (dk-head-is? g 'AND)
                           (and (dk-head-is? g 'IMPLIES) (dk-head-is? (caddr (cadr g)) 'SEP))))
    (lambda ()
      (dk-peel!)
      (let ((h (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) x) (dk-head-is? (caddr f) 'SEP)))
                        "the SEP membership")))
        (sep-me h)
        (dk-split-all!)
        (dk-conj-close! dk-ass!)))
    (lambda ()
      (dk-peel!)
      (dk-split-all!)
      (in-sep! (lambda () (ass)) (lambda () (ass))))))
(mbn-qed! 'completion-sigma-membership)

;;; the completion is a family of subsets of omega
(sp (make-wff '(FORALL omega (FORALL ca (FORALL mu
  (SUBSET (COMPLETION-SIGMA omega ca mu) (POWER omega)))))))
(dk-peel!)
(mac 'subset-def)
(let ((w (dk-di-var!)))
  (let ((i (dk-cite! 'completion-sigma-membership 'omega 'ca 'mu w)))
    (if (dk-only! i (list 'IN w '(COMPLETION-SIGMA omega ca mu))) (prop))))
(mbn-qed! 'completion-sigma-subset-power)

;;; X subset omega  =>  X in POWER(omega)   (omega a set)
(define (mbn-in-power! x)
  (if (not (dk-asm? (list 'IN x '(POWER omega))))
      (dk-have! (list 'IN x '(POWER omega))
        (lambda ()
          (dk-cite! 'subclass-of-set-is-set x 'omega)
          (let ((s (caddr (dk-cite! 'subset-def x 'omega))))
            (dk-have! s (lambda () (mac-h 'subset-def (list 'SUBSET x 'omega)) (ass)))
            (dk-cite! 'power-mem-intro 'omega x)
            (dk-ass!))))))

;;; A in cA, N null  =>  A u N in the completion
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL aa (FORALL ns
  (IMPLIES (IS-MEASURE omega cA mu)
    (IMPLIES (IN aa cA)
      (IMPLIES (IS-NULL-SET omega cA mu ns)
        (IN (UNION aa ns) (COMPLETION-SIGMA omega cA mu))))))))))))
(dk-peel!)
(mbn-measure-parts! 'omega 'cA 'mu)
(dk-cite! 'sigma-algebra-ambient-set 'omega 'cA)
(dk-project! '(SUBSET cA (POWER omega)) 'IS-SIGMA-ALGEBRA '(IS-SIGMA-ALGEBRA omega cA))
(dk-cite! 'subset-mem-fwd 'cA '(POWER omega) 'aa)
(dk-cite! 'null-set-in-omega 'omega 'cA 'mu 'ns)
(dk-have! '(SUBSET (UNION aa ns) omega)
  (lambda ()
    (mac 'subset-def)
    (let ((w (dk-di-var!)))
      (dk-cite! 'union-membership 'aa 'ns w)
      (dk-cite! 'power-mem-in 'omega 'aa w)
      (dk-cite! 'subset-mem-fwd 'ns 'omega w)
      (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop)))))
(mbn-in-power! '(UNION aa ns))
(mbn-in-power! 'ns)
(let ((i (dk-cite! 'completion-sigma-membership 'omega 'cA 'mu '(UNION aa ns))))
  (dk-have! (caddr i)
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (cond ((dk-ass!) #t)
                (#t (ew 'aa)
                    (dk-conj-close!
                      (lambda ()
                        (cond ((dk-ass!) #t)
                              (#t (ew 'ns)
                                  (dk-conj-close!
                                    (lambda () (if (not (dk-ass!)) (rfl))))))))))))))
  (if (dk-only! i (caddr i)) (prop)))
(mbn-qed! 'completion-sigma-rep-in)

;;; THE VALUE: mu-bar(A u N) = mu(A)
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL aa (FORALL ns
  (IMPLIES (IS-MEASURE omega cA mu)
    (IMPLIES (IN aa cA)
      (IMPLIES (IS-NULL-SET omega cA mu ns)
        (= ((COMPLETION-MEASURE omega cA mu) (UNION aa ns)) (mu aa))))))))))))
(dk-peel!)
(mbn-measure-parts! 'omega 'cA 'mu)
(let ((un '(UNION aa ns)))
  (dk-cite! 'sigma-algebra-ambient-set 'omega 'cA)
  (dk-cite! 'completion-sigma-rep-in 'omega 'cA 'mu 'aa 'ns)
  (dk-cite! 'completion-sigma-subset-power 'omega 'cA 'mu)
  (fact 'method-i-outer-type 'omega 'cA 'mu)
  (dk-project! (list 'IN mbn-out '(FUN (POWER omega))) 'fun-codomain-iff
               (list 'IN mbn-out '(FUN (POWER omega) RR-POS-STAR)))
  (let ((ext (dk-cite! 'method-i-outer-extends-completion 'omega 'cA 'mu 'aa 'ns)))
    (dk-split! ext))
  (fact 'method-i-outer-is-outer-measure 'omega 'cA 'mu)
  (dk-cite! 'measure-is-premeasure 'omega 'cA 'mu)
  (dk-cite! 'method-i-outer-is-outer-measure 'omega 'cA 'mu)
  (dk-cite! 'caratheodory-measurable-sigma-algebra 'omega mbn-out)
  (dk-project! (list 'SUBSET mbn-cara '(POWER omega)) 'IS-SIGMA-ALGEBRA (list 'IS-SIGMA-ALGEBRA 'omega mbn-cara))
  (mbn-and! (list 'IN mbn-out '(FUN (POWER omega))) (list 'SUBSET mbn-cs '(POWER omega)) (list 'IN un mbn-cs))
  (dk-cite! 'res-apply '(POWER omega) mbn-cs mbn-out un)
  (mbn-and! (list 'IN mbn-out '(FUN (POWER omega))) (list 'SUBSET mbn-cara '(POWER omega)) (list 'IN un mbn-cara))
  (dk-cite! 'res-apply '(POWER omega) mbn-cara mbn-out un)
  (subst (list '== mbn-cm (caddr (dk-cite! 'completion-measure-unfold 'omega 'cA 'mu))))
  (subst (list '= (list (list 'RES mbn-out mbn-cs) un) (list mbn-out un)))
  (subst (list '= (list mbn-out un) (list (list 'RES mbn-out mbn-cara) un)))
  (ass))
(mbn-qed! 'completion-measure-value)

;;; mu-bar extends mu
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL aa
  (IMPLIES (IS-MEASURE omega cA mu)
    (IMPLIES (IN aa cA)
      (= ((COMPLETION-MEASURE omega cA mu) aa) (mu aa))))))))))
(dk-peel!)
(dk-cite! 'ae-null-empty 'omega 'cA 'mu)
(dk-cite! 'completion-measure-value 'omega 'cA 'mu 'aa 'EMPTY-SET)
(dk-cite! 'union-empty-right 'aa)
(dk-rewrite-h! (list '= (list mbn-cm '(UNION aa EMPTY-SET)) '(mu aa)) '(UNION aa EMPTY-SET) 'aa)
(ass)
(mbn-qed! 'completion-measure-extends)

;;; ===========================================================================
;;; THE COMPLETION IS A SIGMA-ALGEBRA (Prop. 3.3, first sentence).

;;; skolemise a FORSOME in context, splitting the body; return the witness
(define (mbn-sk! ex) (dk-skolem! ex #t))

;;; X in the completion in context: land (IN A cA), (IS-NULL-SET .. N), (= X (UNION A N));
;;; return (A . N)
(define (mbn-rep! x)
  (let* ((i (dk-cite! 'completion-sigma-membership 'omega 'cA 'mu x)))
    (dk-have! (caddr i) (lambda () (if (dk-only! i (list 'IN x mbn-cs)) (prop))))
    (let* ((parts (dk-split! (caddr i)))
           (ex1 (find-first (lambda (f) (dk-head-is? f 'FORSOME)) parts))
           (a (mbn-sk! ex1))
           (ex2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f a) (dk-contains? f x)))
                         "the null part"))
           (n (mbn-sk! ex2)))
      (cons a n))))

(define (mbn-ext2! x y memb!)
  (dk-have! (list 'FORALL 'mnw_ (list 'IFF (list 'IN 'mnw_ x) (list 'IN 'mnw_ y)))
    (lambda ()
      (let ((w (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (memb! w)
        (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop)))))
  (fact 'class-extensionality x y))

(define mbn-sa-c3 (list 'IN 'omega mbn-cs))
(define mbn-sa-c4 (list 'FORALL 'a_ (list 'IMPLIES (list 'IN 'a_ mbn-cs) (list 'IN '(COMPLEMENT-IN omega a_) mbn-cs))))
(define mbn-sa-c5 (list 'FORALL 'f_ (list 'IMPLIES (list 'IN 'f_ (list 'FUN 'NN mbn-cs))
                                          (list 'IN '(BIG-UNION n_ NN (f_ n_)) mbn-cs))))
(define (mbn-sa-close!)
  (begin
    (let ((g (dk-goal)))
      (cond
        ((dk-ass!) #t)
        ;; omega = omega u {} is in the completion
        ((and (dk-head-is? g 'IN) (eq? (cadr g) 'omega))
         (dk-cite! 'sigma-algebra-whole-in 'omega 'cA)
         (dk-cite! 'completion-sigma-rep-in 'omega 'cA 'mu 'omega 'EMPTY-SET)
         (dk-cite! 'union-empty-right 'omega)
         (dk-rewrite-h! (list 'IN '(UNION omega EMPTY-SET) mbn-cs) '(UNION omega EMPTY-SET) 'omega)
         (ass))
        ;; complements: omega \ (A u N) = (omega \ (A u N0)) u ((N0 \ N) n (omega \ A))
        ((and (dk-head-is? g 'FORALL) (dk-contains? g 'COMPLEMENT-IN))
         (let* ((x (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
                (an (mbn-rep! x)) (a (car an)) (n (cdr an))
                (n0 (mbn-sk! (dk-landed-1 (lambda () (mac-h 'IS-NULL-SET (list 'IS-NULL-SET 'omega 'cA 'mu n))))))
                (an0 (list 'UNION a n0))
                (a2 (list 'COMPLEMENT-IN 'omega an0))
                (n2 (list 'INTERSECTION (list 'COMPLEMENT-IN n0 n) (list 'COMPLEMENT-IN 'omega a)))
                (un (list 'UNION a n))
                (u2 (list 'UNION a2 n2)))
           (fact 'sigma-algebra-union-closed-2 'omega 'cA a n0)
           (fact 'sigma-algebra-complement-closed 'omega 'cA an0)
           (dk-have! (list 'SUBSET n2 n0)
             (lambda ()
               (mac 'subset-def)
               (let ((w (dk-di-var!)))
                 (dk-cite! 'intersection-membership (list 'COMPLEMENT-IN n0 n) (list 'COMPLEMENT-IN 'omega a) w)
                 (dk-cite! 'complement-in-membership n0 n w)
                 (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop)))))
           (dk-have! (list 'IS-NULL-SET 'omega 'cA 'mu n2)
             (lambda () (mac 'IS-NULL-SET) (ew n0) (dk-conj-close! dk-ass!)))
           (dk-cite! 'completion-sigma-rep-in 'omega 'cA 'mu a2 n2)
           (subst (list '= x un))
           (let ((lhs (list 'COMPLEMENT-IN 'omega un)))
             (dk-have! (list 'FORALL 'mnw_ (list 'IFF (list 'IN 'mnw_ lhs) (list 'IN 'mnw_ u2)))
               (lambda ()
                 (let* ((w (dk-di-var! (lambda (g) (cadr (cadr g)))))
                        (iw (lambda (t) (list 'IN w t)))
                        (i1 (dk-cite! 'complement-in-membership 'omega un w))
                        (i2 (dk-cite! 'union-membership a n w))
                        (i3 (dk-cite! 'union-membership a2 n2 w))
                        (i4 (dk-cite! 'complement-in-membership 'omega an0 w))
                        (i5 (dk-cite! 'union-membership a n0 w))
                        (i6 (dk-cite! 'intersection-membership (list 'COMPLEMENT-IN n0 n) (list 'COMPLEMENT-IN 'omega a) w))
                        (i7 (dk-cite! 'complement-in-membership n0 n w))
                        (i8 (dk-cite! 'complement-in-membership 'omega a w))
                        (i9 (dk-cite! 'subset-mem-fwd n n0 w))
                        (lf (list 'IFF (iw lhs) (list 'AND (iw 'omega) (list 'NOT (list 'OR (iw a) (iw n))))))
                        (rf (list 'IFF (iw u2)
                                  (list 'OR (list 'AND (iw 'omega) (list 'NOT (list 'OR (iw a) (iw n0))))
                                        (list 'AND (list 'AND (iw n0) (list 'NOT (iw n)))
                                                   (list 'AND (iw 'omega) (list 'NOT (iw a))))))))
                   (dk-have! lf (lambda () (if (dk-only! i1 i2) (prop))))
                   (dk-have! rf (lambda () (if (dk-only! i3 i4 i5 i6 i7 i8) (prop))))
                   (if (dk-only! lf rf i9) (prop)))))
             (fact 'class-extensionality lhs u2))
           (subst (list '= (list 'COMPLEMENT-IN 'omega un) u2))
           (ass)))
        ;; countable unions: choose the measurable parts, then the null parts
        (#t
         (let* ((fv (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
                (fu (list 'BIG-UNION 'n_ 'NN (list fv 'n_)))
                (fam1 (list 'VNB-LAMBDA 'kq_ 'NN
                        (list 'SEP 'ra_ 'cA (list 'FORSOME 'rn_ (list 'AND '(IN rn_ (POWER omega)) (list 'AND '(IS-NULL-SET omega cA mu rn_)
                                                                  (list '= (list fv 'kq_) '(UNION ra_ rn_))))))))
                (sep1 (lambda (k) (list 'SEP 'ra_ 'cA (list 'FORSOME 'rn_ (list 'AND '(IN rn_ (POWER omega)) (list 'AND '(IS-NULL-SET omega cA mu rn_)
                                                                             (list '= (list fv k) '(UNION ra_ rn_))))))))
                (impl1 (dk-fact! 'rmm-nn-choice 'cA fam1)))
           (dk-have! (cadr impl1)
             (lambda ()
               (let ((kv (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                 (mbn-sep-set! (sep1 kv))
                 (dk-lam-b!)
                 (fact 'fun-apply-type-c fv 'NN mbn-cs kv)
                 (let* ((an (mbn-rep! (list fv kv))) (a (car an)) (n (cdr an)))
                   (ew a)
                   (dk-conj-close!
                     (lambda ()
                       (if (not (dk-ass!))
                           (in-sep! (lambda () (ass))
                                    (lambda () (ew n) (dk-conj-close! dk-ass!))))))))))
           (detach! impl1)
           (let* ((ga (mbn-sk! (caddr impl1)))
                  (gak (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ga))) "choice 1"))
                  (fam2 (list 'VNB-LAMBDA 'kq_ 'NN
                          (list 'SEP 'rm_ '(POWER omega)
                                (list 'AND '(IS-NULL-SET omega cA mu rm_)
                                      (list '= (list fv 'kq_) (list 'UNION (list ga 'kq_) 'rm_))))))
                  (sep2 (lambda (k) (list 'SEP 'rm_ '(POWER omega)
                                          (list 'AND '(IS-NULL-SET omega cA mu rm_)
                                                (list '= (list fv k) (list 'UNION (list ga k) 'rm_))))))
                  (impl2 (dk-fact! 'rmm-nn-choice '(POWER omega) fam2)))
             (dk-have! (cadr impl2)
               (lambda ()
                 (let ((kv (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                   (mbn-sep-set! (sep2 kv))
                   (mbn-sep-set! (sep1 kv))
                   (dk-lam-b!)
                   (fact 'fun-apply-type-c ga 'NN 'cA kv)
                   (let ((m (inst*! gak kv)))
                     (dk-lam-b-h! m))
                   (let* ((m2 (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list ga kv))
                                                        (dk-head-is? (caddr f) 'SEP)))
                                       "the reduced choice 1")))
                     (sep-me m2)
                     (dk-split-all!)
                     (let* ((ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f (list ga kv))))
                                         "the null part at k"))
                            (n (mbn-sk! ex)))
                       (dk-cite! 'null-set-in-omega 'omega 'cA 'mu n)
                       (mbn-in-power! n)
                       (ew n)
                       (dk-conj-close!
                         (lambda ()
                           (if (not (dk-ass!))
                               (in-sep! (lambda () (ass)) (lambda () (dk-conj-close! dk-ass!)))))))))))
             (detach! impl2)
             (let* ((gn (mbn-sk! (caddr impl2)))
                    (gnk (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f gn))) "choice 2"))
                    (ua (list 'BIG-UNION 'n_ 'NN (list ga 'n_)))
                    (un (list 'BIG-UNION 'n_ 'NN (list gn 'n_)))
                    ;; at K: land (IS-NULL-SET .. (gn K)) and (= (fv K) (UNION (ga K) (gn K)))
                    (at! (lambda (kv)
                           (let ((z (list '= (list fv kv) (list 'UNION (list ga kv) (list gn kv)))))
                             (if (not (dk-asm? z))
                                 (begin
                                   (fact 'fun-apply-type-c gn 'NN '(POWER omega) kv)
                                   (fact 'fun-apply-type-c ga 'NN 'cA kv)
                                   (fact 'fun-apply-type-c fv 'NN mbn-cs kv)
                                   (for-each
                                     (lambda (c)
                                       (dk-have! c
                                         (lambda ()
                                           (let ((m (inst*! gnk kv)))
                                             (mbn-sep-set! (sep2 kv))
                                             (dk-lam-b-h! m)
                                             (let ((m2 (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) (list gn kv))
                                                                                 (dk-head-is? (caddr f) 'SEP)))
                                                                "the reduced choice 2")))
                                               (sep-me m2)
                                               (dk-split-all!)
                                               (ass))))))
                                     ;; z first: the null claim may BE the goal of the caller's lane, and proving it
                                     ;; there closes the lane
                                     (list z (list 'IS-NULL-SET 'omega 'cA 'mu (list gn kv))))))))))
               (fact 'sigma-algebra-union-closed 'omega 'cA ga)
               (dk-have! (list 'FORALL 'mnk_ (list 'IMPLIES '(IN mnk_ NN) (list 'IS-NULL-SET 'omega 'cA 'mu (list gn 'mnk_))))
                 (lambda ()
                   (let ((kv (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                     (at! kv)
                     (ass))))
               (dk-cite! 'null-countable-union 'omega 'cA 'mu gn)
               (dk-cite! 'completion-sigma-rep-in 'omega 'cA 'mu ua un)
               ;; U f = (U gA) u (U gN)
               (dk-have! (list 'FORALL 'mnw_ (list 'IFF (list 'IN 'mnw_ fu) (list 'IN 'mnw_ (list 'UNION ua un))))
                 (lambda ()
                   (let ((w (dk-di-var! (lambda (g) (cadr (cadr g))))))
                     (dk-cite! 'union-membership ua un w)
                     (for-each
                       (lambda (l)
                         (dk-focus! l)
                         (if (equal? (dk-goal) (list 'IN w (list 'UNION ua un)))
                             ;; w in f(e) = gA(e) u gN(e)
                             (let* ((r (mbn-bu-open! w fu)) (e (cadr (car r))))
                               (at! e)
                               (dk-rewrite-h! (list 'IN w (list fv e)) (list fv e)
                                              (list 'UNION (list ga e) (list gn e)))
                               (dk-cite! 'union-membership (list ga e) (list gn e) w)
                               (dk-have! (list 'IMPLIES (list 'IN w (list ga e)) (list 'IN w ua))
                                 (lambda () (di) (mbn-bu-in! e)))
                               (dk-have! (list 'IMPLIES (list 'IN w (list gn e)) (list 'IN w un))
                                 (lambda () (di) (mbn-bu-in! e)))
                               (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop)))
                             ;; w in U gA or in U gN
                             (let ((pa (list 'IN w ua)) (pn (list 'IN w un)))
                               (dk-have! (list 'OR pa pn)
                                 (lambda () (if (dk-only! (list 'IN w (list 'UNION ua un))
                                                          (dk-pick (lambda (f) (and (dk-head-is? f 'IFF)
                                                                                    (equal? (cadr f) (list 'IN w (list 'UNION ua un)))))
                                                                   "union iff"))
                                                (prop))))
                               (use-cases (list pa pn)
                                 (lambda ()
                                   (let* ((r (mbn-bu-open! w ua)) (e (cadr (car r))))
                                     (at! e)
                                     (dk-cite! 'union-membership (list ga e) (list gn e) w)
                                     (dk-have! (list 'IN w (list 'UNION (list ga e) (list gn e)))
                                       (lambda () (if (dk-only! (list 'IN w (list ga e))
                                                                (dk-pick (lambda (f) (and (dk-head-is? f 'IFF)
                                                                                          (equal? (cadr f) (list 'IN w (list 'UNION (list ga e) (list gn e))))))
                                                                         "union iff e"))
                                                      (prop))))
                                     (dk-rewrite-h! (list 'IN w (list 'UNION (list ga e) (list gn e)))
                                                    (list 'UNION (list ga e) (list gn e)) (list fv e))
                                     (mbn-bu-in! e)))
                                 (lambda ()
                                   (let* ((r (mbn-bu-open! w un)) (e (cadr (car r))))
                                     (at! e)
                                     (dk-cite! 'union-membership (list ga e) (list gn e) w)
                                     (dk-have! (list 'IN w (list 'UNION (list ga e) (list gn e)))
                                       (lambda () (if (dk-only! (list 'IN w (list gn e))
                                                                (dk-pick (lambda (f) (and (dk-head-is? f 'IFF)
                                                                                          (equal? (cadr f) (list 'IN w (list 'UNION (list ga e) (list gn e))))))
                                                                         "union iff e"))
                                                      (prop))))
                                     (dk-rewrite-h! (list 'IN w (list 'UNION (list ga e) (list gn e)))
                                                    (list 'UNION (list ga e) (list gn e)) (list fv e))
                                     (mbn-bu-in! e)))))))
                       (dk-opened (lambda () (di)))))))
               (fact 'class-extensionality fu (list 'UNION ua un))
               (subst (list '= fu (list 'UNION ua un)))
               (ass)))))))))
