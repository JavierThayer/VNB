;;; ccr4b-remark418.scm -- CCR.pdf Remark 4.18: if x = sum_{k >= n} a_k w^k with a_n /= 0 then |x| = |w|^n
;;; (here |w^n|, w^n = NV-ZPOW).  Agent CCR-1109-C3, 2026-11-09.  Destination: theorem-library/ccr4b-remark418.scm.
;;; Library: analysis.  Helper prefix bzs-.
;;;
;;; PLAN (C's transport route, CCR-1109-C-REPORT section 5): the tail bound nv-tail (CCR-1109-C2) at m = 1 gives
;;; |x - a_n w^n| <= |w^(n+1)| = |w^n| |w| < |w^n| = |a_n w^n| (a_n is a nonzero element of the representative set,
;;; so |a_n| = 1: nv-rep-set-norm-one), and the strict ultrametric dominance gives |x| = |a_n w^n|.
;;;
;;; LOAD WINDOW: after theorem-library/ccr4x-unique (CCR-1109-C2: nv-tail, nv-zpow-norm-succ, nv-zpow-nonzero),
;;; ccr4x-series (CCR-1109-C: nv-psum-zero, nv-psum-succ), ccr4x-zpow (nv-zpow-def, nv-rep-set-sub,
;;; nv-rep-set-norm-one) and ccr4b-base (ccr-remark-4-4-norm).  ccr4x-unique and ccr4b-base are the latest.

(define bzs-view '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define (bzs-n x) `((FNRM K) ,x))
(define (bzs-mul x y) `((MUL K) ,x ,y))
(define (bzs-add x y) `((ADD K) ,x ,y))
(define (bzs-sub x y) `((ADD K) ,x ((NEG K) ,y)))
(define (bzs-zp e) `(NV-ZPOW K w ,e))
(define (bzs-typek! x) (dk-cite! 'nf-norm-in-rr 'K x) (dk-cite! 'nf-norm-nonneg 'K x))
(define (bzs-view!)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
  (dk-cite! 'commutative-ring-is-ring bzs-view)
  (for-each (lambda (r) (dk-cite! r 'K))
            '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
              normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one)))
(define (bzs-in-view! x)
  (if (not (dk-asm? `(IN ,x (CARR ,bzs-view))))
      (dk-have! `(IN ,x (CARR ,bzs-view)) (lambda () (subst `(= (CARR ,bzs-view) (CARR K))) (dk-ass!)))))
(define (bzs-crs! vs)
  (bzs-view!)
  (for-each bzs-in-view! vs)
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,bzs-view))))) '(ADD MUL NEG))
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,bzs-view))))) '(ZERO ONE))
  (crs))
(define (bzs-and! . fs)
  (let ((c (let loop ((fs fs)) (if (null? (cdr fs)) (car fs) `(AND ,(car fs) ,(loop (cdr fs)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
;; X /= ZERO K in context: land 0 < |X|
(define (bzs-norm-pos! x)
  (bzs-typek! x)
  (dk-have! `(NOT (= 0 ,(bzs-n x)))
    (lambda ()
      (di)
      (let ((iff (dk-cite! 'nf-norm-zero-iff 'K x)))
        (dk-have! `(= ,(bzs-n x) 0) (lambda () (subst `(= ,(bzs-n x) 0)) (rfl)))
        (dk-have! `(= ,x (ZERO K)) (lambda () (ai iff) (detach! `(IMPLIES (= ,(bzs-n x) 0) (= ,x (ZERO K)))) (dk-ass!)))
        (ai `(NOT (= ,x (ZERO K)))))))
  (bzs-and! `(<= 0 ,(bzs-n x)) `(NOT (= 0 ,(bzs-n x))))
  (dk-cite! 'rr-le-ne-lt 0 (bzs-n x)))

(define bzs-hyps '((IS-COMPACT-NV-DOMAIN K A) (IN w A) (= (NV-MAXIMAL K A) (NV-PRINCIPAL K A w)) (NOT (= w (ZERO K)))
                   (= A (NV-INTEGERS K)) (IS-NV-REP-SET K A RP)))
(define (bzs-curry fs body) (fold-right (lambda (p acc) `(IMPLIES ,p ,acc)) body fs))

(sp (make-wff `(FORALL K (FORALL A (FORALL w (FORALL RP ,(bzs-curry bzs-hyps
  `(FORALL n (IMPLIES (IN n ZZ) (FORALL dga (FORALL x (IMPLIES (IS-NV-EXPANSION K w RP dga n x)
     (IMPLIES (NOT (= (dga n) (ZERO K))) (= ,(bzs-n 'x) ,(bzs-n (bzs-zp 'n))))))))))))))))
(dk-peel!)
(dk-cite! 'nv-compact-domain 'K 'A)
(dk-cite! 'nv-domain-normed 'K 'A)
(dk-cite! 'nv-domain-sub 'K 'A 'w)
(dk-cite! 'nf-zero-in-carr 'K)
(fact 'rr-zero-in) (fact 'rr-one-in) (fact 'nn-one-in) (fact 'zz-one-in)
(dk-split-all! (list (dk-iff-fwd! (dk-cite! 'is-nv-expansion 'K 'w 'RP 'dga 'n 'x))))
(let* ((cv (dk-pick (dk-head? 'CONVERGES-TO) "the convergence"))
       (an '(dga n)) (zn (bzs-zp 'n)) (tn (bzs-mul an zn))
       (s1 '(NV-PSUM K w dga n 1)) (z1 (bzs-zp '(+ n 1))))
  (dk-iff-fwd! (dk-cite! 'converges-to '(NF-METRIC-SPACE K) (caddr cv) 'x))
  (dk-cite! 'nf-metric-carrier 'K)
  (dk-have! '(IN x (CARR K)) (lambda () (subst '(== (CARR K) (PTS (NF-METRIC-SPACE K)))) (dk-ass!)))
  ;; the digit a_n: in RP, in A, in K, of absolute value 1
  (dk-cite! 'fun-apply-type-c 'dga 'ZZ 'RP 'n)
  (dk-cite! 'nv-rep-set-sub 'K 'A 'RP an)
  (dk-cite! 'nv-domain-sub 'K 'A an)
  (dk-cite! 'nv-rep-set-norm-one 'K 'A 'w 'RP an)
  ;; w^n, w^(n+1)
  (dk-split-all! (list (dk-cite! 'nv-zpow-def 'K 'w 'n)))
  (bzs-and! '(IN n ZZ) '(IN 1 ZZ))
  (dk-chain-ass! (dk-cite! 'zz-add-closed 'n 1))
  (dk-split-all! (list (dk-cite! 'nv-zpow-def 'K 'w '(+ n 1))))
  (dk-cite! 'nv-zpow-nonzero 'K 'w 'n)
  (bzs-norm-pos! zn)
  (bzs-typek! z1) (bzs-typek! 'w)
  (dk-cite! 'nv-zpow-norm-succ 'K 'w 'n)
  (dk-split-all! (list (dk-cite! 'ccr-remark-4-4-norm 'K 'A 'w)))
  ;; |w^(n+1)| < |w^n|
  (dk-have! `(<= ,(bzs-n zn) ,(bzs-n zn)) (lambda () (dk-ineq!)))
  (dk-chain-ass! (dk-cite! 'rr-prod-lt-gen-right (bzs-n zn) (bzs-n 'w) (bzs-n zn) 1))
  (dk-have! `(= (* ,(bzs-n zn) 1) ,(bzs-n zn)) (lambda () (crs)))
  (dk-have! `(< ,(bzs-n z1) ,(bzs-n zn))
    (lambda ()
      (dk-rewrite-h! `(< (* ,(bzs-n zn) ,(bzs-n 'w)) (* ,(bzs-n zn) 1)) `(* ,(bzs-n zn) 1) (bzs-n zn))
      (subst `(= ,(bzs-n z1) (* ,(bzs-n zn) ,(bzs-n 'w))))
      (dk-ass!)))
  ;; the first term and S_1 = a_n w^n
  (dk-cite! 'nf-mul-in-carr 'K an zn)
  (dk-cite! 'nf-norm-mult 'K an zn)
  (bzs-typek! tn)
  (dk-have! `(= ,(bzs-n tn) ,(bzs-n zn))
    (lambda () (subst `(= ,(bzs-n tn) (* ,(bzs-n an) ,(bzs-n zn)))) (subst `(= ,(bzs-n an) 1)) (crs)))
  (fact 'nn-zero-in)
  (dk-cite! 'nn-one-is-succ-zero)
  (let* ((e0 (dk-cite! 'nv-psum-succ 'K 'w 'dga 'n 0))
         (e1 (dk-rewrite-h! e0 '(succ 0) 1))
         (z0 (dk-cite! 'nv-psum-zero 'K 'w 'dga 'n)))
    (dk-cite! 'zz-in-rr 'n)
    (dk-have! '(= (+ n 0) n) (lambda () (crs)))
    (dk-have! `(= ,s1 ,tn)
      (lambda ()
        (subst e1)
        (subst z0)
        (subst '(= (+ n 0) n))
        (bzs-crs! (list an zn))))
    (let ((h (dk-chain-ass! (dk-cite! 'nv-tail 'K 'A 'w 'RP 'dga 'n 'x 1))))
      (dk-rewrite-h! h s1 tn)
      (dk-cite! 'nf-neg-in-carr 'K tn)
      (dk-cite! 'nf-add-in-carr 'K 'x `((NEG K) ,tn))
      (bzs-typek! (bzs-sub 'x tn))
      (dk-have! `(< ,(bzs-n (bzs-sub 'x tn)) ,(bzs-n tn))
        (lambda () (dk-ineq! `(<= ,(bzs-n (bzs-sub 'x tn)) ,(bzs-n z1)) `(< ,(bzs-n z1) ,(bzs-n zn)) `(= ,(bzs-n tn) ,(bzs-n zn)))))
      (dk-cite! 'nv-domain-field 'K 'A)
      (dk-cite! 'nv-strict-dominance 'K (bzs-sub 'x tn) tn)
      (dk-cite! 'nf-sub-add-back 'K 'x tn)
      (subst `(= x ,(bzs-add (bzs-sub 'x tn) tn)))
      (subst `(= ,(bzs-n (bzs-add (bzs-sub 'x tn) tn)) ,(bzs-n tn)))
      (dk-ass!))))
(qed 'ccr-remark-4-18)
