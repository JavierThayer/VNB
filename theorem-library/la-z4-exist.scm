;;; la-z4-exist.scm -- linear algebra 3.50, existence: a finitely generated abelian group is
;;; isomorphic to Z/(a_1) + ... + Z/(a_l) with invariant factors a_1 | ... | a_l, a_i >= 0,
;;; a_i /= 1 (LA-Z4, 2026-10-24).  Vocabulary: structure-library/la-z4-vocab (ZZ-POW, ZZ-UNITS,
;;; CYCLIC-SUM, IS-INVARIANT-FACTORS).  Prefix lzx-.
;;;
;;; PLAN (the notes' proof of 3.50).  E generated by u_1, ..., u_n.  The homomorphism
;;; pi : Z^n -> E, x |-> x_1 u_1 + ... + x_n u_n (free-lift-hom) is onto; its kernel K is a
;;; submodule (hom-kernel-submodule).  3.44 (principal-sequence-exists) gives a basis e of Z^n
;;; and b_1 | ... | b_n, b_i >= 0, with b_1 e_1, ..., b_n e_n spanning K; 3.49
;;; (quotient-by-diagonal-subgroup) gives Z^n / K = Z/(b_1) + ... + Z/(b_n), and the first
;;; isomorphism theorem Z^n / K = E.  The b_i equal to 1 form an initial run b_1 .. b_k
;;; (lzx-ones-prefix: a nonnegative divisor of 1 is 1); those summands are zero
;;; (zz-mod-one-trivial) and are dropped (dsum-drop-iso), leaving a_i = b_(k+i).
;;;
;;; Destination theorem-library/.  Library: linear-algebra.  LOAD WINDOW: after
;;; theorem-library/la-z4-free, la-z4-dsum, la-z3-smith (principal-sequence-exists) and
;;; la-z3-struct (quotient-by-diagonal-subgroup, first-isomorphism-module, lzt-fam-modules).

(define (lzx-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z4-exist: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'algebra))
(define (lzx-split-all! f)
  (if (dk-head-is? f 'AND) (for-each lzx-split-all! (dk-split! f))))
(define (lzx-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!) #f))
(define (lzx-iv-var ld cls)
  (let ((f (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cls))) ld)))
    (if (not f) (error "lzx-iv-var: no typing in" (expression->string cls)))
    (cadr f)))
(define (lzx-iv! i a b)
  (fact 'interval-elt-in-nn a b i)
  (fact 'interval-lo a b i)
  (fact 'interval-hi a b i))
(define (lzx-skolem-split! ex)
  (let ((w (dk-skolem! ex)))
    (let loop ()
      (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f w))) (dk-asms))))
        (if cj (begin (dk-split! cj) (loop)))))
    w))

;;; ---- 1 divides every integer ---------------------------------------------------------
(sp (make-wff '(FORALL z (IMPLIES (IN z ZZ) (ZZ-DIVIDES 1 z)))))
(dk-peel!)
(fact 'zz-one-in)
(fact 'zz-in-rr 'z)
(mac 'ZZ-DIVIDES)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (ass))
            ((dk-head-is? g 'FORSOME)
             (ew 'z)
             (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq!)))))
            (#t (error "lzx-one-divides: unexpected" (expression->string g)))))))
(lzx-done! 'lzx-one-divides)

;;; ---- the entries equal to 1 of a nonnegative divisibility chain are an initial run ---------
(define LZX-NONNEG '(FORALL psi_ (IMPLIES (IN psi_ (INTERVAL 1 n)) (<= 0 (ENTRY dm psi_ psi_)))))
(define LZX-CHAIN '(FORALL psi_ (FORALL psj_ (IMPLIES (IN psi_ (INTERVAL 1 n)) (IMPLIES (IN psj_ (INTERVAL 1 n))
          (IMPLIES (<= psi_ psj_) (ZZ-DIVIDES (ENTRY dm psi_ psi_) (ENTRY dm psj_ psj_))))))))
(define LZX-T '(SEP pft_ NN (AND (IN pft_ (INTERVAL 1 n)) (NOT (= (ENTRY dm pft_ pft_) 1)))))
(define (lzx-d i) (list 'ENTRY 'dm i i))
(define (lzx-in-t! i)                     ; i in [1,n], NOT d_i = 1 in context: land (IN i T)
  (if (not (dk-asm? (list 'IN i LZX-T)))
      (dk-have! (list 'IN i LZX-T)
        (lambda ()
          (in-sep! (lambda () (fact 'interval-elt-in-nn 1 'n i) (ass))
                   (lambda () (dk-conj-close! (lambda () (ass)))))))))
(define (lzx-ones-claim k)
  (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n)) (list 'IMPLIES (list '<= 'i k) (list '= (lzx-d 'i) 1)))))
(define (lzx-notones-claim k)
  (list 'FORALL 'i (list 'IMPLIES '(IN i (INTERVAL 1 n)) (list 'IMPLIES (list 'NOT (list '<= 'i k)) (list 'NOT (list '= (lzx-d 'i) 1))))))
(sp (make-wff (forall-guarded '(n dm) (list '(IN n NN) '(IN dm (MAT n n ZZ)) LZX-NONNEG LZX-CHAIN)
  (list 'FORSOME 'k (list 'AND '(IN k NN) (list 'AND '(<= k n) (list 'AND (lzx-ones-claim 'k) (lzx-notones-claim 'k))))))))
(dk-peel!)
(fact 'nn-one-in)
(let ((ex (list 'FORSOME 'pfu_ (list 'IN 'pfu_ LZX-T))))
  (use-em ex
    (lambda ()                            ; some entry /= 1: k = (least such index) - 1
      (dk-have! (list 'SUBSET LZX-T 'NN)
        (lambda ()
          (mac 'subset-def)
          (let* ((ld (dk-peel!)) (x (cadr (car ld)))
                 (m (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) x) (dk-head-is? (caddr f) 'SEP))) (dk-asms))))
            (dk-landed (lambda () (sep-me m)))
            (dk-split-all!)
            (ass))))
      (dk-have! (list 'AND (list 'SUBSET LZX-T 'NN) ex) (lambda () (dk-conj-close! (lambda () (ass)))))
      (let* ((m0 (lzx-skolem-split! (dk-cite! 'nn-least-element LZX-T)))
             (minall (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f m0))) (dk-asms))))
        (for-each (lambda (want)
                    (if (not (dk-asm? want))
                        (dk-have! want (lambda ()
                                         (dk-landed (lambda () (sep-me (dk-ctx-form (list 'IN m0 LZX-T)))))
                                         (dk-split-all!) (ass)))))
                  (list (list 'IN m0 'NN) (list 'IN m0 '(INTERVAL 1 n)) (list 'NOT (list '= (lzx-d m0) 1))))
        (lzx-iv! m0 1 'n)
        (let ((k0 (list 'NN-MINUS m0 1)))
          (fact 'nn-minus-in-nn m0 1)
          (let ((def (dk-cite! 'nn-minus-def m0 1)))
            (dk-have! (list '= k0 (list '- m0 1))
              (lambda () (subst def) (dk-if-branch! #t (caddr def) #f (lambda () (rfl))))))
          (ew k0)
          (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond
                  ((dk-asm? g) (ass))
                  ((dk-head-is? g '<=) (dk-nn! (list '= k0 (list '- m0 1)) (list '<= m0 'n)))
                  ((dk-head-is? (caddr (caddr g)) 'IMPLIES)
                   (let* ((ld (dk-peel!)) (i (lzx-iv-var ld '(INTERVAL 1 n))))
                     (if (dk-head-is? (dk-goal) 'NOT)
                         ;; NOT (i <= k0): d_i /= 1
                         (begin
                           (lzx-iv! i 1 'n)
                           (di)
                           (fact 'nn-not-le-succ-le i k0)
                           (dk-have! (list '<= m0 i) (lambda () (dk-nn! (list '<= (list 'succ k0) i) (list '= k0 (list '- m0 1)))))
                           (let* ((dv (dk-apply! LZX-CHAIN m0 i))
                                  (dv1 (dk-rewrite-h! dv (lzx-d i) 1)))
                             (fact 'entry-in-carrier 'n 'n 'ZZ 'dm m0 m0)
                             (fact 'zz-in-rr (lzx-d m0))
                             (dk-cite! 'lzx-one-divides (lzx-d m0))
                             (dk-apply! LZX-NONNEG m0)
                             (let ((or-f (dk-cite! 'zz-divides-antisym (lzx-d m0) 1)))
                               (for-each
                                 (lambda (l)
                                   (dk-focus! l)
                                   (if (dk-asm? (list '= (lzx-d m0) 1))
                                       (ai (list 'NOT (list '= (lzx-d m0) 1)))
                                       (dk-absurd! (list '<= 0 (lzx-d m0))
                                                   (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) (lzx-d m0)))) (dk-asms)))))
                                 (dk-opened (lambda () (ai or-f)))))))
                         ;; i <= k0: d_i = 1
                         (begin
                           (lzx-iv! i 1 'n)
                           (dk-have! (list 'NOT (list '<= m0 i))
                             (lambda () (dk-nn! (list '<= i k0) (list '= k0 (list '- m0 1)))))
                           (pbc)
                           (lzx-in-t! i)
                           (dk-apply! minall i)
                           (ai (list 'NOT (list '<= m0 i)))))))
                  (#t (error "lzx-ones-prefix: unexpected conjunct" (expression->string g))))))))))
    (lambda ()                            ; every entry is 1: k = n
      (fact 'nn-le-refl 'n)
      (ew 'n)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond
              ((dk-asm? g) (ass))
              (#t
               (let* ((ld (dk-peel!)) (i (lzx-iv-var ld '(INTERVAL 1 n))))
                 (lzx-iv! i 1 'n)
                 (if (dk-head-is? (dk-goal) 'NOT)
                     (begin (di) (ai (list 'NOT (list '<= i 'n))))
                     (begin
                       (pbc)
                       (lzx-in-t! i)
                       (dk-have! ex (lambda () (ew i) (ass)))
                       (ai (list 'NOT ex)))))))))))))
(lzx-done! 'lzx-ones-prefix)
(gloss! 'lzx-ones-prefix "In a nonnegative divisibility chain b_1 | b_2 | ... | b_n the entries equal to 1 are exactly b_1, ..., b_k for some k.")

;;; =====================================================================
;;; 3.50, existence
;;; =====================================================================
;; index i of the new sequence: k0 + i in [1,n]
(define (lzx-sh! k0 l0 i)
  (if (not (dk-asm? (list 'IN (list '+ k0 i) '(INTERVAL 1 n))))
      (dk-split! (dk-cite! 'lzu-shift-in 'n k0 l0 i))))
(define (lzx-ent! dm1 j)                  ; (IN (ENTRY dm1 j j) ZZ) and in CARR ZZ-RING
  (let ((e (list 'ENTRY dm1 j j)))
    (if (not (dk-asm? (list 'IN e 'ZZ)))
        (begin
          (fact 'entry-in-carrier 'n 'n 'ZZ dm1 j j)
          (dk-rewrite-h! (list 'IN e 'ZZ) 'ZZ '(CARR ZZ-RING))))))
(define LZX-P '(ZZ-POW n))
(define LZX-U0 '(ZZ-UNITS n))
(define LZX-ROWS '(MAT 1 n (CARR (SCAL (ZZ-POW n)))))
(define LZX-KAP (list 'INVERSE-BIJ (list 'VNB-LAMBDA 'lcc_ LZX-ROWS '(LINCOMB (ZZ-POW n) n lcc_ (ZZ-UNITS n))) LZX-ROWS '(VEC (ZZ-POW n))))
(define LZX-PI (list 'VNB-LAMBDA 'lex_ '(VEC (ZZ-POW n)) (list 'LINCOMB 'E 'n (list LZX-KAP 'lex_) 'u)))
(define LZX-K (list 'SEP 'kx_ '(VEC (ZZ-POW n)) (list '= (list LZX-PI 'kx_) '(VZERO E))))
(define LZX-QM (list 'QUOTIENT-MODULE LZX-P LZX-K))
(define LZX-DPI (list 'DESCEND (list 'QMOD-SETOID LZX-P LZX-K) LZX-PI))
(define (lzx-f0 dm) (list 'VNB-LAMBDA 'fmi_ '(INTERVAL 1 n) (list 'ZZ-MOD (list 'ENTRY dm 'fmi_ 'fmi_))))
(define (lzx-a0 dm k l) (list 'VNB-LAMBDA 'ifa_ (list 'INTERVAL 1 l) (list 'ENTRY dm (list '+ k 'ifa_) (list '+ k 'ifa_))))
(define (lzx-g0 a l) (list 'VNB-LAMBDA 'csi_ (list 'INTERVAL 1 l) (list 'ZZ-MOD (list a 'csi_))))

(sp (make-wff (forall-guarded '(E) '((IS-MODULE E) (= (SCAL E) ZZ-RING))
  (forall-guarded '(n u) '((IN n NN) (IN u (MAT n 1 (VEC E))) (GENERATES E n u))
    '(FORSOME l (FORSOME a (FORSOME f (AND (IN l NN) (AND (<= l n)
       (AND (IS-INVARIANT-FACTORS l a) (IS-ISO-MODULE (CYCLIC-SUM l a) E f)))))))))))
(dk-peel!)
(fact 'nn-one-in)
(fact 'one-in-interval-1)
(fact 'zz-is-ring)
(fact 'zz-is-commutative-ring)
(dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl)))
(fact 'zz-pow-is-module 'n)
(fact 'zz-pow-scal 'n)
(fact 'zz-units-type 'n)
(fact 'zz-units-generate 'n)
(fact 'zz-units-rel-free 'n)
(dk-have! (list '= '(SCAL E) (list 'SCAL LZX-P)) (lambda () (subst (list '= (list 'SCAL LZX-P) 'ZZ-RING)) (ass)))
;; pi : Z^n -> E onto, kernel K
(fact 'free-lift-hom LZX-P 'n LZX-U0 'E 'u)
(fact 'hom-kernel-submodule LZX-P 'E LZX-PI)
(define LZX-SURJ (list 'FORALL 'y_ (list 'IMPLIES '(IN y_ (VEC E)) (list 'FORSOME 'x_ (list 'AND (list 'IN 'x_ (list 'VEC LZX-P)) (list '= (list LZX-PI 'x_) 'y_))))))
(define LZX-KERF (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ (list 'VEC LZX-P)) (list 'IFF (list '= (list LZX-PI 'x_) '(VZERO E)) (list 'IN 'x_ LZX-K)))))
(dk-have! LZX-SURJ
  (lambda ()
    (let* ((ld (dk-peel!)) (y (lzx-iv-var ld '(VEC E)))
           (gen (dk-meta-iff-r! (dk-meta-iff! 'generates 'E 'n 'u)))
           (c (lzx-skolem-split! (dk-apply! gen y)))
           (x (list 'LINCOMB LZX-P 'n c LZX-U0)))
      (dk-have! (list 'IN c LZX-ROWS)
        (lambda () (subst (list '= (list 'SCAL LZX-P) 'ZZ-RING)) (subst '(= ZZ-RING (SCAL E))) (ass)))
      (fact 'lincomb-type LZX-P 'n c LZX-U0)
      (ew x)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal))
              (ass)
              (begin
                (subst (dk-cite! 'free-lift-lincomb LZX-P 'n LZX-U0 'E 'u c))
                (dk-cite! 'equality-symmetry y (list 'LINCOMB 'E 'n c 'u))
                (ass))))))))
(dk-have! LZX-KERF
  (lambda ()
    (let* ((ld (dk-peel!)) (x (lzx-iv-var ld (list 'VEC LZX-P)))
           (a (list '= (list LZX-PI x) '(VZERO E))) (b (list 'IN x LZX-K)))
      (dk-have! (list 'IMPLIES a b) (lambda () (di) (in-sep! (lambda () (ass)) (lambda () (ass)))))
      (dk-have! (list 'IMPLIES b a)
        (lambda () (di) (dk-landed (lambda () (sep-me (dk-ctx-form b)))) (dk-split-all!) (ass)))
      (dk-only! (list 'IMPLIES a b) (list 'IMPLIES b a))
      (prop))))
(fact 'first-isomorphism-module LZX-P 'E LZX-PI LZX-K)
;; 3.44 on K, then 3.49
(let* ((es1 (dk-skolem! (dk-cite! 'principal-sequence-exists LZX-P 'n LZX-U0 LZX-K)))
       (dm1 (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f es1))) (dk-asms))))
       (ps (lzx-split-all! (dk-meta-iff-r! (dk-meta-iff! 'is-principal-sequence LZX-P 'n LZX-K es1 dm1))))
       (f1 (dk-skolem! (dk-cite! 'quotient-by-diagonal-subgroup LZX-P 'n es1 dm1 LZX-K)))
       (f0 (lzx-f0 dm1))
       (tt (list 'DIRECT-SUM 'ZZ-RING 'n f0))
       (f1i (list 'INVERSE-BIJ f1 (list 'VEC LZX-QM) (list 'VEC tt))))
  (dk-cite! 'iso-module-inverse LZX-QM tt f1)
  (dk-cite! 'iso-module-compose tt LZX-QM 'E f1i LZX-DPI)
  (dk-split! (dk-cite! 'lzt-fam-modules LZX-P 'n es1 dm1 LZX-K))
  ;; the run of ones
  (let* ((nonneg (subst-free 'dm dm1 LZX-NONNEG))
         (k0 (lzx-skolem-split! (dk-cite! 'lzx-ones-prefix 'n dm1)))
         (ones (subst-free 'dm dm1 (subst-free 'k k0 (lzx-ones-claim 'k))))
         (notones (subst-free 'dm dm1 (subst-free 'k k0 (lzx-notones-claim 'k))))
         (l0 (list 'NN-MINUS 'n k0))
         (a0 (lzx-a0 dm1 k0 l0))
         (g0 (lzx-g0 a0 l0))
         (ds-g (list 'DIRECT-SUM 'ZZ-RING l0 g0))
         (drop (list 'VNB-LAMBDA 'dpx_ (list 'VEC tt) (list 'VNB-LAMBDA 'dpi_ (list 'INTERVAL 1 l0) (list 'dpx_ (list '+ k0 'dpi_)))))
         (dropi (list 'INVERSE-BIJ drop (list 'VEC tt) (list 'VEC ds-g)))
         (ff (list 'COMPOSE (list 'COMPOSE LZX-DPI f1i) dropi)))
    (fact 'nn-minus-in-nn 'n k0)
    (let ((def (dk-cite! 'nn-minus-def 'n k0)))
      (dk-have! (list '= l0 (list '- 'n k0))
        (lambda () (subst def) (dk-if-branch! #t (caddr def) #f (lambda () (rfl))))))
    (dk-have! (list '= 'n (list '+ k0 l0)) (lambda () (dk-nn! (list '= l0 (list '- 'n k0)))))
    ;; the hypotheses of dsum-drop-iso for F0 on [1,n] and G0 on [1,l0]
    (dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 l0)) (list 'IS-MODULE (list g0 'i_))))
      (lambda ()
        (let* ((ld (dk-peel!)) (i (lzx-iv-var ld (list 'INTERVAL 1 l0))))
          (lzx-sh! k0 l0 i)
          (lzx-ent! dm1 (list '+ k0 i))
          (if (not (lzx-beta!))
              (begin (fact 'zz-mod-is-module (list 'ENTRY dm1 (list '+ k0 i) (list '+ k0 i))) (ass))))))
    (dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 l0)) (list '= (list 'SCAL (list g0 'i_)) 'ZZ-RING)))
      (lambda ()
        (let* ((ld (dk-peel!)) (i (lzx-iv-var ld (list 'INTERVAL 1 l0))))
          (lzx-sh! k0 l0 i)
          (lzx-ent! dm1 (list '+ k0 i))
          (if (not (lzx-beta!))
              (begin (subst (dk-cite! 'zz-mod-scal (list 'ENTRY dm1 (list '+ k0 i) (list '+ k0 i)))) (rfl))))))
    (dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 l0)) (list '= (list g0 'i_) (list f0 (list '+ k0 'i_)))))
      (lambda ()
        (let* ((ld (dk-peel!)) (i (lzx-iv-var ld (list 'INTERVAL 1 l0))))
          (lzx-sh! k0 l0 i)
          (lzx-ent! dm1 (list '+ k0 i))
          (fact 'zz-mod-is-module (list 'ENTRY dm1 (list '+ k0 i) (list '+ k0 i)))
          (if (not (lzx-beta!)) (rfl)))))
    (dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (list 'INTERVAL 1 k0))
                (list 'FORALL 'x_ (list 'IMPLIES (list 'IN 'x_ (list 'VEC (list f0 'i_))) (list '= 'x_ (list 'VZERO (list f0 'i_)))))))
      (lambda ()
        (let* ((ld (dk-peel!))
               (i (lzx-iv-var ld (list 'INTERVAL 1 k0)))
               (x (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'VEC))) ld))))
          (fact 'interval-widen k0 'n 1 i)
          (lzx-iv! i 1 'n)
          (fact 'interval-hi 1 k0 i)
          (dk-apply! ones i)
          (lzx-ent! dm1 i)
          (let* ((h1 (dk-lam-b-h! (list 'IN x (list 'VEC (list f0 i)))))
                 (h2 (dk-rewrite-h! (list 'IN x (list 'VEC (list 'ZZ-MOD (list 'ENTRY dm1 i i)))) (list 'ENTRY dm1 i i) 1)))
            (lzx-beta!)
            (subst (list '= (list 'ENTRY dm1 i i) 1))
            (fact 'zz-mod-one-trivial x)
            (ass)))))
    (fact 'dsum-drop-iso 'ZZ-RING 'n k0 l0 f0 g0)
    (dk-cite! 'iso-module-inverse tt ds-g drop)
    (dk-cite! 'iso-module-compose ds-g tt 'E dropi (list 'COMPOSE LZX-DPI f1i))
    ;; the witnesses
    (ew l0) (ew a0) (ew ff)
    (dk-conj-close!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((dk-asm? g) (ass))
            ((dk-head-is? g '<=) (dk-nn! (list '= l0 (list '- 'n k0))))
            ((dk-head-is? g 'IS-ISO-MODULE) (mac 'CYCLIC-SUM) (ass))
            ((dk-head-is? g 'IS-INVARIANT-FACTORS)
             (mac 'IS-INVARIANT-FACTORS)
             (dk-conj-close!
               (lambda ()
                 (let ((g2 (dk-goal)))
                   (cond
                     ((dk-head-is? g2 'IN)        ; a0 in FUN([1,l0], ZZ)
                      (dk-lam-type!
                        (lambda ()
                          (let* ((ld (dk-peel!)) (i (lzx-iv-var ld (list 'INTERVAL 1 l0))))
                            (lzx-sh! k0 l0 i)
                            (lzx-ent! dm1 (list '+ k0 i))
                            (if (not (lzx-beta!)) (ass))))
                        (lambda () (fact 'interval-in-set 1 l0) (ass))))
                     ((dk-head-is? (caddr g2) 'FORALL)   ; the chain
                      (let* ((ld (dk-peel!))
                             (ivs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'INTERVAL 1 l0)))) ld)))
                             (le (find-first (dk-head? '<=) ld))
                             (i (cadr le)) (j (caddr le)))
                        (lzx-sh! k0 l0 i) (lzx-sh! k0 l0 j)
                        (lzx-iv! i 1 l0) (lzx-iv! j 1 l0)
                        (dk-have! (list '<= (list '+ k0 i) (list '+ k0 j)) (lambda () (dk-nn! le)))
                        (lzx-beta!)
                        (dk-apply! (subst-free 'dm dm1 LZX-CHAIN) (list '+ k0 i) (list '+ k0 j))
                        (ass)))
                     (#t
                      (let* ((ld (dk-peel!)) (i (lzx-iv-var ld (list 'INTERVAL 1 l0))))
                        (lzx-sh! k0 l0 i)
                        (lzx-beta!)
                        (if (dk-head-is? (dk-goal) 'NOT)
                            (dk-apply! notones (list '+ k0 i))
                            (dk-apply! nonneg (list '+ k0 i)))
                        (ass))))))))
            (#t (error "3.50 existence: unexpected conjunct" (expression->string g)))))))))
(lzx-done! 'fg-abelian-group-structure-exists)
(gloss! 'fg-abelian-group-structure-exists "Linear algebra 3.50 (existence): an abelian group E generated by n elements is isomorphic to Z/(a_1) + ... + Z/(a_l), l <= n, with a_1 | a_2 | ... | a_l, every a_i >= 0 and a_i /= 1 (a summand Z/(0) is a copy of Z).")

