;;; =====================================================================
;;; a closed trace of a compact subspace is compact (the notes: "the intersection of a
;;; closed set with a compact one is compact")
;;; =====================================================================
(define (m6-subseq-type! f phi A)       ; SUBSEQ(f, phi) in FUN(NN, A)
  (let ((claim (list 'IN (list 'SUBSEQ f phi) (list 'FUN 'NN A))))
    (if (not (dk-asm? claim))
        (dk-have! claim
          (lambda ()
            (if (not (dk-asm? (list 'IN phi '(FUN NN NN))))
                (dk-project! (list 'IN phi '(FUN NN NN)) 'strictly-mono-nn (list 'STRICTLY-MONO-NN phi)))
            (if (not (dk-asm? '(IN NN SET))) (fact 'nn-is-set))
            (mac 'SUBSEQ)
            (for-each
             (lambda (kn)
               (if (not (sequent-node-grounded? kn))
                   (begin
                     (dk-focus! kn)
                     (if (and (eq? (car (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
                         (ass)
                         (let ((j (dk-di-var!)))
                           (fact 'fun-apply-type-c phi 'NN 'NN j)
                           (dk-close-if! (lambda () (fact 'fun-apply-type-c f 'NN A (list phi j))) ass))))))
             (dk-opened (lambda () (lam-t)))))))
    claim))
