;;; =====================================================================
;;; Lemma 6.12 (metric form): K compact in U u V  ==>  K = A u B, A, B compact, A in U, B in V
;;; =====================================================================
(define (m6-cmp O) (list 'COMPLEMENT-IN '(PTS s) O))
(define m6-C1 (list 'INTERSECTION 'K (m6-cmp 'V)))
(define m6-C2 (list 'INTERSECTION 'K (m6-cmp 'U)))
(define (m6-nb C h) (list 'SEP 'm6z_ '(PTS s) (list 'FORSOME 'm6w_ (list 'AND (list 'IN 'm6w_ C) (list '< (m6-ds 'm6z_ 'm6w_) h)))))
(define (m6-in-int! x A B)             ; x in INTERSECTION(A, B) in context: land both
  (dk-split-all! (dk-landed (lambda () (dk-project! (list 'AND (list 'IN x A) (list 'IN x B)) 'intersection-membership (list 'IN x (list 'INTERSECTION A B)))))))
(define (m6-in-cmp! x O)               ; x in COMPLEMENT-IN(pts s, O): land x in pts s, x not in O
  (dk-split-all! (dk-landed (lambda () (dk-project! (list 'AND (list 'IN x '(PTS s)) (list 'NOT (list 'IN x O))) 'complement-in-membership (list 'IN x (m6-cmp O)))))))
;;; IS-OPEN(s, NB(C, h)) for C subset pts s, h > 0
(define (m6-nb-open! C h)
  (let ((N (m6-nb C h)))
    (dk-have! (list 'IS-OPEN 's N)
      (lambda ()
        (mac 'is-open)
        (dk-conj-close!
         (lambda ()
           (let ((g (dk-goal)))
             (cond
              ((eq? (m6-head g) 'SUBSET)
               (mac 'subset-def)
               (let ((x (dk-di-var!))) (m6-sep-open! x) (ass)))
              ((eq? (m6-head g) 'FORALL)
               (let* ((z (dk-di-var!))
                      (_1 (m6-sep-open! z))
                      (w (dk-skolem! (dk-pick (lambda (q) (and (eq? (m6-head q) 'FORSOME) (dk-contains? q 'm6w_))) "the witness")))
                      (dzw (m6-ds z w))
                      (rho (list '- h dzw)))
                 (fact 'subset-mem-fwd C '(PTS s) w)
                 (fact 'metric-dist-real 's z w)
                 (fact 'rr-pos-rr-in-rr h)
                 (fact 'rr-sub-in-rr h dzw)
                 (dk-have! (list '< 0 rho) (lambda () (dk-ineq! (list '< dzw h) (list 'IN dzw 'RR) (list 'IN h 'RR) (list 'IN rho 'RR))))
                 (fact 'rr-pos-rr-of-lt rho)
                 (ew rho)
                 (dk-conj-close!
                  (lambda ()
                    (if (eq? (m6-head (dk-goal)) 'SUBSET)
                        (begin
                          (mac 'subset-def)
                          (let* ((q (dk-di-var!)) (dzq (m6-ds z q)) (dqw (m6-ds q w)) (dqz (m6-ds q z)))
                            (m8-ball-lt! 's z rho q)
                            (fact 'metric-dist-real 's q w)
                            (fact 'metric-dist-real 's q z)
                            (fact 'metric-triangle 's q z w)
                            (fact 'metric-sym 's q z)
                            (for-each
                             (lambda (leaf)
                               (if (not (sequent-node-grounded? leaf))
                                   (begin
                                     (dk-focus! leaf)
                                     (if (eq? (m6-head (dk-goal)) 'FORSOME)
                                         (begin
                                           (ew w)
                                           (dk-conj-close!
                                            (lambda ()
                                              (if (eq? (m6-head (dk-goal)) '<)
                                                  (dk-ineq! (list '<= dqw (list '+ dqz dzw)) (list '= dqz dzq) (list '< dzq rho)
                                                            (list 'IN dqw 'RR) (list 'IN dqz 'RR) (list 'IN dzq 'RR) (list 'IN dzw 'RR)
                                                            (list 'IN h 'RR) (list 'IN rho 'RR))
                                                  (ass)))))
                                         (ass)))))
                             (dk-opened (lambda () (sep-mi))))))
                        (ass))))))
              (#t (ass))))))))
      N))

(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s)
