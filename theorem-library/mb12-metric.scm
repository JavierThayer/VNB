;;; =====================================================================
;;; A.8, the lower bound: kk d_t <= d_s everywhere iff B_s(x, kk r) subset B_t(x, r)
;;; =====================================================================
(define m8-lower '(FORALL x (IMPLIES (IN x (PTS s)) (FORALL y (IMPLIES (IN y (PTS s))
                     (<= (* kk ((DIST t) x y)) ((DIST s) x y)))))))
(define m8-lballs '(FORALL x (IMPLIES (IN x (PTS s)) (FORALL r (IMPLIES (POS-RR r)
                     (SUBSET (BALL s x (* kk r)) (BALL t x r)))))))
(define (m8-mul-lt! c a b)            ; 0 < c, a < b (reals): land c a < c b
  (let ((dlt (list '- b a)))
    (dk-have! (list 'IN dlt 'RR) (lambda () (type-term)))
    (dk-have! (list 'IN (list '* c a) 'RR) (lambda () (type-term)))
    (dk-have! (list 'IN (list '* c b) 'RR) (lambda () (type-term)))
    (let ((dw (dk-name! dlt 'RR)))
      (dk-have! (list '< 0 dw) (lambda () (subst (list '= dw dlt)) (dk-ineq! (list '< a b) (list 'IN a 'RR) (list 'IN b 'RR))))
      (fact 'rr-mul-pos c dw)
      (dk-have! (list '= (list '* c dw) (list '- (list '* c b) (list '* c a))) (lambda () (subst (list '= dw dlt)) (crs)))
      (dk-have! (list 'IN (list '* c dw) 'RR) (lambda () (type-term)))
      (dk-have! (list '< (list '* c a) (list '* c b))
        (lambda () (dk-ineq! (list '< 0 (list '* c dw)) (list '= (list '* c dw) (list '- (list '* c b) (list '* c a)))
                             (list 'IN (list '* c dw) 'RR) (list 'IN (list '* c a) 'RR) (list 'IN (list '* c b) 'RR)))))))
(sp (make-wff (list 'FORALL 's (list 'FORALL 't (list 'FORALL 'kk
     (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'IMPLIES '(IS-METRIC-SPACE t)
       (list 'IMPLIES '(= (PTS t) (PTS s)) (list 'IMPLIES '(POS-RR kk)
         (list 'IFF m8-lower m8-lballs))))))))))
(dk-peel!)
(fact 'rr-pos-rr-in-rr 'kk)
(fact 'rr-lt-of-pos-rr 'kk)
(dk-iff! (lambda (g) (dk-contains? g 'BALL))
  ;; bound => balls: d_s < kk r and kk d_t <= d_s give d_t < r
  (lambda ()
    (let* ((bnd (dk-pick (lambda (h) (and (eq? (m6-head h) 'FORALL) (dk-contains? h '(DIST t)) (not (dk-contains? h 'BALL)))) "the bound"))
           (pl (dk-peel!))
           (x (cadr (car (filter (lambda (q) (eq? (m6-head q) 'IN)) pl))))
           (r (cadr (car (filter (lambda (q) (eq? (m6-head q) 'POS-RR)) pl)))))
      (fact 'rr-pos-rr-in-rr r)
      (mac 'subset-def)
      (let ((y (dk-di-var!)))
        (dk-have! (list 'IN (list '* 'kk r) 'RR) (lambda () (type-term)))
        (m8-ball-lt! 's x (list '* 'kk r) y)
        (m8-in-t! x) (m8-in-t! y)
        (dk-apply! bnd x y)
        (fact 'metric-dist-real 't x y)
        (mac 'ball-membership)
        (let ((dt (m8-tt x y)) (ds (m8-st x y)))
          (dk-have! (list '< dt r)
            (lambda ()
              (use-em (list '< dt r)
                (lambda () (ass))
                (lambda ()
                  (fact 'metric-pos 't x y)
                  (fact 'rr-lt-of-pos-rr r)
                  (for-each (lambda (tm)
                              (dk-have! (list 'IN tm 'RR-POS-STAR)
                                (lambda () (mac 'rr-pos-star-membership) (oi-l)
                                           (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 0 r) (list 'IN r 'RR))))))))
                            (list dt r))
                  (dk-close-if! (lambda () (fact 'rps-not-lt-le dt r)) (lambda () #t))
                  (let ((rd (list '- dt r)))
                    (dk-have! (list 'IN rd 'RR) (lambda () (type-term)))
                    (let ((dw (dk-name! rd 'RR)))
                      (dk-have! (list '<= 0 dw) (lambda () (subst (list '= dw rd)) (dk-ineq! (list '<= r dt) (list 'IN r 'RR) (list 'IN dt 'RR))))
                      (dk-have! (list '<= 0 (list '* 'kk dw))
                        (lambda ()
                          (dk-have! '(<= 0 kk) (lambda () (dk-ineq! '(< 0 kk) '(IN kk RR))))
                          (m6-and! '(IN kk RR) (list 'IN dw 'RR))
                          (m6-and! '(<= 0 kk) (list '<= 0 dw))
                          (dk-close-if! (lambda () (fact 'rr-leq-mul-nonneg 'kk dw)) ass)))
                      (dk-have! (list '= (list '* 'kk dw) (list '- (list '* 'kk dt) (list '* 'kk r))) (lambda () (subst (list '= dw rd)) (crs)))
                      (dk-have! (list 'IN (list '* 'kk dw) 'RR) (lambda () (type-term)))
                      (dk-have! (list 'IN (list '* 'kk dt) 'RR) (lambda () (type-term)))
                      (dk-absurd! (list '<= 0 (list '* 'kk dw)) (list '= (list '* 'kk dw) (list '- (list '* 'kk dt) (list '* 'kk r)))
                                  (list '<= (list '* 'kk dt) ds) (list '< ds (list '* 'kk r))
                                  (list 'IN (list '* 'kk dw) 'RR) (list 'IN (list '* 'kk dt) 'RR) (list 'IN (list '* 'kk r) 'RR)
                                  (list 'IN ds 'RR))))))))
          (dk-conj-close!
           (lambda ()
             (let ((g (dk-goal)))
               (cond ((eq? (m6-head g) '<=) (dk-ineq! (list '< dt r) (list 'IN dt 'RR) (list 'IN r 'RR)))
                     ((eq? (m6-head g) 'NOT) (di) (dk-absurd! (list '= dt r) (list '< dt r) (list 'IN dt 'RR) (list 'IN r 'RR)))
                     (#t (ass))))))))))
  ;; balls => bound: for e > 0, r = q (d_s + e), q = 1/kk
  (lambda ()
    (let* ((bl (dk-pick (lambda (h) (and (eq? (m6-head h) 'FORALL) (dk-contains? h 'BALL))) "the ball inclusion"))
           (pl (dk-peel!))
           (gl (dk-goal))
           (x (cadr (caddr (cadr gl)))) (y (caddr (caddr (cadr gl))))
           (dt (m8-tt x y)) (ds (m8-st x y)) (kdt (list '* 'kk dt)))
      (m8-in-t! x) (m8-in-t! y)
      (fact 'metric-dist-real 's x y)
      (fact 'metric-dist-real 't x y)
      (fact 'metric-pos 's x y)
      (dk-have! (list 'IN kdt 'RR) (lambda () (type-term)))
      (dk-have! '(NOT (= kk 0)) (lambda () (di) (dk-absurd! '(= kk 0) '(< 0 kk) '(IN kk RR))))
      (m6-and! '(IN kk RR) '(NOT (= kk 0)))
      (fact 'rr-recip-closed 'kk)
      (fact 'rr-recip-pos 'kk)
      (fact 'rr-recip-inverse 'kk)
      (let ((q (dk-name! '(recip kk) 'RR)))
        (dk-have! (list '= (list '* 'kk q) 1) (lambda () (subst (list '= q '(recip kk))) (ass)))
        (dk-have! (list '< 0 q) (lambda () (subst (list '= q '(recip kk))) (ass)))
        (dk-have! (list 'FORALL 'm8e_ (list 'IMPLIES '(POS-RR m8e_) (list '<= kdt (list '+ ds 'm8e_))))
          (lambda ()
            (let* ((pe (dk-peel!))
                   (e (cadr (car (filter (lambda (q2) (eq? (m6-head q2) 'POS-RR)) pe))))
                   (se (list '+ ds e))
                   (r (list '* q se)))
              (fact 'rr-pos-rr-in-rr e)
              (fact 'rr-lt-of-pos-rr e)
              (dk-have! (list 'IN se 'RR) (lambda () (type-term)))
              (dk-have! (list 'IN r 'RR) (lambda () (type-term)))
              (dk-have! (list '< 0 se) (lambda () (dk-ineq! (list '<= 0 ds) (list '< 0 e) (list 'IN ds 'RR) (list 'IN e 'RR))))
              (fact 'rr-mul-pos q se)
              (fact 'rr-pos-rr-of-lt r)
              (dk-have! (list '= (list '* 'kk r) se)
                (lambda ()
                  (dk-have! (list '= (list '* 'kk r) (list '* (list '* 'kk q) se)) (lambda () (crs)))
                  (subst (list '= (list '* 'kk r) (list '* (list '* 'kk q) se)))
                  (subst (list '= (list '* 'kk q) 1))
                  (crs)))
              (dk-apply! bl x r)
              (dk-have! (list 'IN y (list 'BALL 's x (list '* 'kk r)))
                (lambda ()
                  (subst (list '= (list '* 'kk r) se))
                  (mac 'ball-membership)
                  (dk-conj-close!
                   (lambda ()
                     (let ((g (dk-goal)))
                       (cond ((eq? (m6-head g) '<=) (dk-ineq! (list '< 0 e) (list 'IN ds 'RR) (list 'IN e 'RR)))
                             ((eq? (m6-head g) 'NOT) (di) (dk-absurd! (list '= ds se) (list '< 0 e) (list 'IN ds 'RR) (list 'IN e 'RR)))
                             (#t (ass))))))))
              (fact 'subset-mem-fwd (list 'BALL 's x (list '* 'kk r)) (list 'BALL 't x r) y)
              (m8-ball-lt! 't x r y)
              (m8-mul-lt! 'kk dt r)
              (dk-ineq! (list '< kdt (list '* 'kk r)) (list '= (list '* 'kk r) se)
                        (list 'IN kdt 'RR) (list 'IN (list '* 'kk r) 'RR) (list 'IN ds 'RR) (list 'IN e 'RR))))))
      (dk-close-if! (lambda () (fact 'rr-le-of-le-add-all-pos kdt ds)) ass))))
(qed 'lipschitz-lower-iff-balls)
