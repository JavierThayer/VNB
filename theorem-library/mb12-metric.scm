       (dk-opened (lambda () (sep-mi)))))))
;;; A subset U (and B subset V)
(define (m6-part-sub! P Nb W C)        ; P = K minus Nb, C = K minus W:  P subset W
  (dk-have! (list 'SUBSET P W)
    (lambda ()
      (mac 'subset-def)
      (let ((x (dk-di-var!)))
        (m6-in-int! x 'K (m6-cmp Nb))
        (m6-in-cmp! x Nb)
        (use-em (list 'IN x W)
          (lambda () (ass))
          (lambda ()
            (dk-have! (list 'IN x C)
              (lambda () (mac 'intersection-membership)
                         (dk-conj-close!
                          (lambda ()
                            (if (dk-asm? (dk-goal)) (ass)
                                (begin (mac 'complement-in-membership) (dk-conj-close! (lambda () (ass)))))))))
            (m6-self-nb! x C)
            (if (dk-only! (list 'IN x Nb) (list 'NOT (list 'IN x Nb))) (prop))))))))
(m6-part-sub! m6-A m6-Ut 'U m6-C2)
(m6-part-sub! m6-B m6-Vt 'V m6-C1)
;;; K = A u B
(dk-have! (list '= 'K (list 'UNION m6-A m6-B))
  (lambda ()
    (dk-have! (list 'FORALL 'x (list 'IFF '(IN x K) (list 'IN 'x (list 'UNION m6-A m6-B))))
      (lambda ()
        (let ((x (dk-di-var! (lambda (g) (cadr (cadr g))))))
          (dk-iff! (lambda (g) (dk-contains? g 'UNION))
            (lambda ()
              (fact 'subset-mem-fwd 'K '(PTS s) x)
              (mac 'union-membership)
              (use-em (list 'IN x m6-Ut)
                (lambda ()
                  (oi-r)
                  (m6-sep-open! x)
                  (let* ((w2 (dk-skolem! (dk-pick (lambda (q) (and (eq? (m6-head q) 'FORSOME) (dk-contains? q m6-C2))) "the near point of C2"))))
                    (mac 'intersection-membership)
                    (dk-conj-close!
                     (lambda ()
                       (if (dk-asm? (dk-goal)) (ass)
                           (begin
                             (mac 'complement-in-membership)
                             (dk-conj-close!
                              (lambda ()
                                (if (dk-asm? (dk-goal)) (ass)
                                    (begin
                                      (di)
                                      (m6-sep-open! x)
                                      (let* ((w1 (dk-skolem! (dk-pick (lambda (q) (and (eq? (m6-head q) 'FORSOME) (dk-contains? q m6-C1))) "the near point of C1"))))
                                        (fact 'subset-mem-fwd m6-C1 '(PTS s) w1)
                                        (fact 'subset-mem-fwd m6-C2 '(PTS s) w2)
                                        (dk-apply! m6-sep w1 w2)
                                        (fact 'metric-triangle 's w1 x w2)
                                        (fact 'metric-sym 's w1 x)
                                        (for-each (lambda (pq) (fact 'metric-dist-real 's (car pq) (cadr pq)))
                                                  (list (list w1 x) (list x w1) (list x w2) (list w1 w2)))
                                        (dk-absurd! (list '<= m6-r (m6-ds w1 w2)) (list '<= (m6-ds w1 w2) (list '+ (m6-ds w1 x) (m6-ds x w2)))
                                                    (list '= (m6-ds w1 x) (m6-ds x w1)) (list '< (m6-ds x w1) m6-h) (list '< (m6-ds x w2) m6-h)
                                                    (list '= (list '+ m6-h m6-h) m6-r)
                                                    (list 'IN (m6-ds w1 w2) 'RR) (list 'IN (m6-ds w1 x) 'RR) (list 'IN (m6-ds x w1) 'RR)
                                                    (list 'IN (m6-ds x w2) 'RR) (list 'IN m6-r 'RR) (list 'IN m6-h 'RR)))))))))))))
                (lambda ()
                  (oi-l)
                  (mac 'intersection-membership)
                  (dk-conj-close!
                   (lambda ()
                     (if (dk-asm? (dk-goal)) (ass)
                         (begin (mac 'complement-in-membership) (dk-conj-close! (lambda () (ass))))))))))
            (lambda ()
              (dk-split-all! (dk-landed (lambda () (mac-h 'union-membership (list 'IN x (list 'UNION m6-A m6-B))))))
              (use-cases (dk-pick (lambda (q) (eq? (m6-head q) 'OR)) "the union")
                (lambda () (m6-in-int! x 'K (m6-cmp m6-Ut)) (ass))
                (lambda () (m6-in-int! x 'K (m6-cmp m6-Vt)) (ass))))))))
    (dk-close-if! (lambda () (fact 'class-extensionality 'K (list 'UNION m6-A m6-B))) ass)))
(ew m6-A)
(ew m6-B)
(dk-conj-close! (lambda () (ass)))
(qed 'compact-split-open-cover)
(topic! 'compact-split-open-cover 'analysis)
(alias! 'compact-split-open-cover "a compact K in U u V is A u B with A, B compact, A in U, B in V")
