(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (FORALL O (IMPLIES (IS-OPEN s O)
     (IS-CLOSED s (COMPLEMENT-IN (PTS s) O))))))))
(dk-peel!)
