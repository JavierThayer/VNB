;;; mb12-metric.scm -- construction-of-measures.pdf Appendix A.3 (metric odds and ends):
;;; A.6 (a compact set and a disjoint closed set are at positive distance), and more below.
;;; Agent ISOM (brief M-B1B2), 2026-10-26.
;;;
;;;   compact-closed-positive-distance   (A.6) K compact, F closed, K and F disjoint
;;;                                      ==>  SET-DIST(s, K, F) /= 0
;;;
;;; A.6.  The notes argue by sequences; here the countable cover of calc3-uniform.scm:
;;;   W_n = { x in K : some c in pts(s) has d(c, x) < r_n and d(c, y) >= 2 r_n for all y in F },
;;;   r_n = 1/(n+1).  W_n is open in the subspace K, the W_n cover K (x not in F, F closed, a
;;;   ball around x misses F), so finitely many do; then r_N bounds d(x, y) below.
;;;   SET-DIST is an extended infimum in [0, +inf]; "d(K, F) > 0" is stated as
;;;   SET-DIST(s, K, F) /= 0, the form of set-dist-pos-intro / set-dist-pos-elim.
;;;
;;; WINDOW.  Citations: compact-closed-countable-subcover (metric-finite-subcover),
;;; carrier-is-closed (scratchpad/isom/isom-uc.scm, UNWIRED), compact-subspace-is-closed
;;; (calc3-compact-closed, load.scm 3736, the latest citation), set-dist-pos-intro /
;;; set-dist-pos-elim (metric-outer-measure), rps-not-lt-le (integral-convergence),
;;; subspace-*, ball-membership, nn-recip-succ-*.  lo = after calc3-compact-closed.scm and
;;; isom-uc.scm; hi = none.  Library: measure (set-dist-pos-* and rps-not-lt-le are measure
;;; theorems).

;;; Helper prefix: m6-.

(define (m6-head g) (and (pair? g) (car g)))
(define (m6-ds a b) (list '(DIST s) a b))
(define (m6-r n) (list 'recip (list '+ n 1)))
(define (m6-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass))))))
    f))
(define (m6-iff-rhs! iff)
  (let ((rhs (caddr iff)))
    (dk-have! rhs (lambda () (prop)))
    (if (eq? (m6-head rhs) 'AND) (dk-split-all! (list rhs)))
    rhs))

;;; W_n
(define (m6-w n)
  (let ((r (m6-r n)))
    (list 'SEP 'm6x_ 'K
      (list 'FORSOME 'm6c_
        (list 'AND (list 'IN 'm6c_ '(PTS s))
         (list 'AND (list '< (m6-ds 'm6c_ 'm6x_) r)
           (list 'FORALL 'm6y_ (list 'IMPLIES (list 'IN 'm6y_ 'F)
             (list '<= (list '+ r r) (m6-ds 'm6c_ 'm6y_))))))))))
(define (m6-into-w! C lt-proof)        ; the focus goal (IN P W_n): sep-mi, centre C
  (for-each
   (lambda (leaf)
     (if (not (sequent-node-grounded? leaf))
         (begin
           (dk-focus! leaf)
           (if (eq? (m6-head (dk-goal)) 'FORSOME)
               (begin
                 (ew C)
                 (dk-conj-close!
                  (lambda ()
                    (cond ((eq? (m6-head (dk-goal)) '<) (lt-proof))
                          (#t (ass))))))
               (ass)))))
   (dk-opened (lambda () (sep-mi)))))
(define (m6-sep-open! P)
  (let ((m (dk-pick (lambda (h) (and (eq? (m6-head h) 'IN) (equal? (cadr h) P) (dk-head-is? (caddr h) 'SEP)))
                    "the SEP membership")))
    (dk-split-all! (dk-landed (lambda () (sep-me m))))))

(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s)
     (FORALL K (IMPLIES (SUBSET K (PTS s)) (IMPLIES (IS-COMPACT (SUBSPACE-MS s K))
       (FORALL F (IMPLIES (IS-CLOSED s F)
         (IMPLIES (FORALL x (IMPLIES (IN x K) (NOT (IN x F))))
           (NOT (= (SET-DIST s K F) 0))))))))))))
(dk-peel!)
(define m6-sub '(SUBSPACE-MS s K))
(define m6-disj (dk-pick (lambda (h) (and (eq? (m6-head h) 'FORALL) (dk-contains? h 'NOT))) "K, F disjoint"))
(dk-project! '(IN (PTS s) SET) 'is-metric-space '(IS-METRIC-SPACE s))
(dk-have! '(IN K SET) (lambda () (dk-close-if! (lambda () (fact 'subclass-of-set-is-set 'K '(PTS s))) ass)))
(fact 'subspace-is-metric-space 's 'K)
(fact 'subspace-pts 's 'K)
(m6-iff-rhs! (dk-cite! 'is-closed 's 'F))
(define m6-L (list 'VNB-LAMBDA 'm6n_ 'NN (m6-w 'm6n_)))
(define m6-inst (dk-cite! 'compact-closed-countable-subcover m6-sub 'K m6-L))
;;; (a) K is closed in its own subspace
(dk-have! (cadr m6-inst)
  (lambda ()
    (fact 'carrier-is-closed m6-sub)
    (dk-have! (list '= (list 'PTS m6-sub) 'K) (lambda () (subst (list '== (list 'PTS m6-sub) 'K)) (rfl)))
    (dk-rewrite-h! (list 'IS-CLOSED m6-sub (list 'PTS m6-sub)) (list 'PTS m6-sub) 'K)
    (ass)))
;;; (b) the W_n are open in the subspace
(dk-have! (cadr (caddr m6-inst))
  (lambda ()
    (let* ((n (dk-di-var!)) (rn (m6-r n)))
      (dk-lam-b!)
      (fact 'nn-recip-succ-pos n)
      (fact 'rr-pos-rr-in-rr rn)
      (mac 'IS-OPEN)
      (dk-conj-close!
       (lambda ()
         (let ((g (dk-goal)))
           (cond
            ((eq? (m6-head g) 'SUBSET)
             (subst (list '== (list 'PTS m6-sub) 'K))
             (mac 'subset-def)
             (let ((x (dk-di-var!))) (m6-sep-open! x) (ass)))
            ((eq? (m6-head g) 'FORALL)
             (let* ((y (dk-di-var!))
                    (yin (m6-sep-open! y))
                    (c (dk-skolem! (dk-pick (lambda (h) (and (eq? (m6-head h) 'FORSOME) (dk-contains? h 'm6y_)))
                                            "the centre")))
                    (dcy (m6-ds c y))
                    (rho (list '- rn dcy)))
               (fact 'subset-mem-fwd 'K '(PTS s) y)
               (fact 'metric-dist-real 's c y)
               (fact 'rr-sub-in-rr rn dcy)
               (dk-have! (list '< 0 rho)
                 (lambda () (dk-ineq! (list '< dcy rn) (list 'IN dcy 'RR) (list 'IN rn 'RR) (list 'IN rho 'RR))))
               (fact 'rr-pos-rr-of-lt rho)
               (ew rho)
               (dk-conj-close!
                (lambda ()
                  (if (eq? (m6-head (dk-goal)) 'SUBSET)
                      (begin
                        (mac 'subset-def)
                        (let* ((z (dk-di-var!)) (dyz (m6-ds y z)) (dcz (m6-ds c z)))
                          (m6-iff-rhs! (dk-cite! 'subspace-ball-membership 's 'K y rho z))
                          (mac-h 'ball-membership (list 'IN z (list 'BALL 's y rho)))
                          (dk-split-all!)
                          (fact 'metric-dist-real 's y z)
                          (fact 'metric-dist-real 's c z)
                          (m6-and! (list '<= dyz rho) (list 'NOT (list '= dyz rho)))
                          (fact 'rr-le-ne-lt dyz rho)
                          (fact 'metric-triangle 's c y z)
                          (m6-into-w! c
                            (lambda ()
                              (dk-ineq! (list '<= dcz (list '+ dcy dyz)) (list '< dyz rho)
                                        (list 'IN dcy 'RR) (list 'IN dyz 'RR) (list 'IN dcz 'RR)
                                        (list 'IN rn 'RR) (list 'IN rho 'RR))))))
                      (ass))))))
            (#t (ass)))))))))
;;; (c) the W_n cover K
(define m6-open-cl (dk-pick (lambda (h) (and (eq? (m6-head h) 'IS-OPEN) (dk-contains? h 'COMPLEMENT-IN))) "the open complement"))
(dk-split-all! (dk-landed (lambda () (dk-project! (list 'FORALL 'm6q_ (list 'IMPLIES (list 'IN 'm6q_ '(COMPLEMENT-IN (PTS s) F))
                                                    (list 'FORSOME 'm6p_ (list 'AND '(POS-RR m6p_) (list 'SUBSET '(BALL s m6q_ m6p_) '(COMPLEMENT-IN (PTS s) F))))))
                                              'is-open m6-open-cl))))
(define m6-ocl (dk-pick (lambda (h) (and (eq? (m6-head h) 'FORALL) (dk-contains? h 'm6p_))) "the openness clause"))
(define (m6-far! x y del)              ; y in F, the ball B(x, del) misses F: del <= d(x, y)
  (let ((dxy (m6-ds x y)))
    (fact 'subset-mem-fwd 'F '(PTS s) y)
    (fact 'metric-dist-real 's x y)
    (dk-have! (list '<= del dxy)
      (lambda ()
        (use-em (list '< dxy del)
          (lambda ()
            (dk-have! (list 'IN y (list 'BALL 's x del))
              (lambda ()
                (mac 'ball-membership)
                (dk-conj-close!
                 (lambda ()
                   (let ((g2 (dk-goal)))
                     (cond ((eq? (m6-head g2) '<=) (dk-ineq! (list '< dxy del) (list 'IN dxy 'RR) (list 'IN del 'RR)))
                           ((eq? (m6-head g2) 'NOT) (di) (dk-absurd! (list '= dxy del) (list '< dxy del)))
                           (#t (ass))))))))
            (fact 'subset-mem-fwd (list 'BALL 's x del) '(COMPLEMENT-IN (PTS s) F) y)
            (dk-split-all! (dk-landed (lambda () (mac-h 'complement-in-membership (list 'IN y '(COMPLEMENT-IN (PTS s) F))))))
            (if (dk-only! (list 'IN y 'F) (list 'NOT (list 'IN y 'F))) (prop)))
          (lambda ()
            (fact 'metric-pos 's x y)
            (fact 'rr-lt-of-pos-rr del)
            (for-each (lambda (t)
                        (dk-have! (list 'IN t 'RR-POS-STAR)
                          (lambda () (mac 'rr-pos-star-membership) (oi-l)
                                     (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 0 del) (list 'IN del 'RR))))))))
                      (list dxy del))
            (dk-close-if! (lambda () (fact 'rps-not-lt-le dxy del)) ass)))))))
(define (m6-cover-closer! x del hd rn)  ; a leaf of x in W_n with centre x
  (let ((g (dk-goal)))
    (cond
     ((eq? (m6-head g) '<)
      (dk-ineq! (list '= (m6-ds x x) 0) (list '< 0 rn) (list 'IN (m6-ds x x) 'RR) (list 'IN rn 'RR)))
     ((eq? (m6-head g) 'FORALL)
      (let* ((y (dk-di-var!)) (dxy (m6-ds x y)))
        (m6-far! x y del)
        (dk-ineq! (list '<= del dxy) (list '< rn hd) (list '= (list '+ hd hd) del)
                  (list 'IN dxy 'RR) (list 'IN del 'RR) (list 'IN hd 'RR) (list 'IN rn 'RR))))
     (#t (ass)))))
(define (m6-cover-leaf! x del hd rn)
  (if (eq? (m6-head (dk-goal)) 'FORSOME)
      (begin (ew x) (dk-conj-close! (lambda () (m6-cover-closer! x del hd rn))))
      (ass)))
(dk-have! (cadr (caddr (caddr m6-inst)))
  (lambda ()
    (let* ((x (dk-di-var!)))
      (fact 'subset-mem-fwd 'K '(PTS s) x)
      (dk-apply! m6-disj x)
      (dk-have! (list 'IN x '(COMPLEMENT-IN (PTS s) F))
        (lambda () (mac 'complement-in-membership) (dk-conj-close! (lambda () (ass)))))
      (let* ((del (dk-skolem! (dk-apply! m6-ocl x)))
             (hd (dk-halve! del))
             (n (dk-skolem! (dk-cite! 'nn-recip-succ-small hd)))
             (rn (m6-r n)))
        (fact 'nn-recip-succ-pos n)
        (fact 'rr-pos-rr-in-rr rn)
        (fact 'rr-lt-of-pos-rr rn)
        (fact 'rr-pos-rr-in-rr del)
        (fact 'rr-pos-rr-in-rr hd)
        (fact 'metric-self-zero 's x)
        (fact 'metric-dist-real 's x x)
        (ew n)
        (dk-conj-close!
         (lambda ()
           (if (and (eq? (m6-head (dk-goal)) 'IN) (dk-contains? (dk-goal) 'VNB-LAMBDA))
               (begin
                 (dk-lam-b!)
                 (for-each (lambda (leaf)
                             (if (not (sequent-node-grounded? leaf))
                                 (begin (dk-focus! leaf) (m6-cover-leaf! x del hd rn))))
                           (dk-opened (lambda () (sep-mi)))))
               (ass))))))))
;;; (d) the finite subcover and the lower bound r_N
(define m6-nf (dk-skolem! (dk-apply! m6-inst)))
(define m6-cover (dk-pick (lambda (h) (and (eq? (m6-head h) 'FORALL) (dk-contains? h m6-nf))) "the subcover clause"))
(define m6-rN (m6-r m6-nf))
(fact 'nn-recip-succ-pos m6-nf)
(fact 'rr-pos-rr-in-rr m6-rN)
(fact 'nn-in-rr m6-nf)
(dk-have! (list 'FORALL 'mxx_ (list 'IMPLIES '(IN mxx_ K) (list 'FORALL 'myy_ (list 'IMPLIES '(IN myy_ F)
            (list '<= m6-rN (m6-ds 'mxx_ 'myy_))))))
  (lambda ()
    (let* ((pl (dk-peel!))
           (x (cadr (car (filter (lambda (q) (and (eq? (m6-head q) 'IN) (eq? (caddr q) 'K))) pl))))
           (y (cadr (car (filter (lambda (q) (and (eq? (m6-head q) 'IN) (eq? (caddr q) 'F))) pl))))
           (n (dk-skolem! (dk-apply! m6-cover x)))
           (rn (m6-r n))
           (mem (dk-pick (lambda (h) (and (eq? (m6-head h) 'IN) (eq? (cadr h) x) (dk-contains? h 'VNB-LAMBDA))) "x in L(n)")))
      (dk-lam-b-h! mem)
      (m6-sep-open! x)
      (let* ((c (dk-skolem! (dk-pick (lambda (h) (and (eq? (m6-head h) 'FORSOME) (dk-contains? h 'm6y_))) "the centre")))
             (fcl (dk-pick (lambda (h) (and (eq? (m6-head h) 'FORALL) (dk-contains? h c) (dk-contains? h 'F))) "the F clause")))
        (fact 'subset-mem-fwd 'F '(PTS s) y)
        (fact 'subset-mem-fwd 'K '(PTS s) x)
        (dk-apply! fcl y)
        (fact 'metric-dist-real 's c x)
        (fact 'metric-dist-real 's x y)
        (fact 'metric-dist-real 's c y)
        (fact 'metric-triangle 's c x y)
        (fact 'nn-recip-succ-pos n)
        (fact 'rr-pos-rr-in-rr rn)
        (fact 'nn-in-rr n)
        (dk-have! (list '<= n m6-nf) (lambda () (dk-ineq! (list '< n m6-nf) (list 'IN n 'RR) (list 'IN m6-nf 'RR))))
        (fact 'nn-recip-succ-antitone n m6-nf)
        (dk-ineq! (list '<= (list '+ rn rn) (m6-ds c y)) (list '< (m6-ds c x) rn)
                  (list '<= (m6-ds c y) (list '+ (m6-ds c x) (m6-ds x y)))
                  (list '<= m6-rN rn)
                  (list 'IN (m6-ds c x) 'RR) (list 'IN (m6-ds x y) 'RR) (list 'IN (m6-ds c y) 'RR)
                  (list 'IN rn 'RR) (list 'IN m6-rN 'RR))))))
(dk-close-if! (lambda () (fact 'set-dist-pos-intro 's 'K 'F m6-rN)) ass)
(qed 'compact-closed-positive-distance)
(topic! 'compact-closed-positive-distance 'analysis)
(alias! 'compact-closed-positive-distance "a compact set and a disjoint closed set are at positive distance")

;;; =====================================================================
;;; A.8 (one-sided): d_s <= K d_t everywhere iff B_t(x, r) subset B_s(x, K r)
;;; (s and t two metrics on the same points)
;;; =====================================================================
(define (m8-st a b) (list '(DIST s) a b))
(define (m8-tt a b) (list '(DIST t) a b))
(define m8-bound '(FORALL x (IMPLIES (IN x (PTS s)) (FORALL y (IMPLIES (IN y (PTS s))
                     (<= ((DIST s) x y) (* K ((DIST t) x y))))))))
(define m8-balls '(FORALL x (IMPLIES (IN x (PTS s)) (FORALL r (IMPLIES (POS-RR r)
                     (SUBSET (BALL t x r) (BALL s x (* K r))))))))
(sp (make-wff (list 'FORALL 's (list 'FORALL 't (list 'FORALL 'K
     (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'IMPLIES '(IS-METRIC-SPACE t)
       (list 'IMPLIES '(= (PTS t) (PTS s)) (list 'IMPLIES '(POS-RR K)
         (list 'IFF m8-bound m8-balls))))))))))
(dk-peel!)
(fact 'rr-pos-rr-in-rr 'K)
(fact 'rr-lt-of-pos-rr 'K)
(define (m8-in-t! y)                   ; y in pts s: y in pts t
  (if (not (dk-asm? (list 'IN y '(PTS t))))
      (dk-have! (list 'IN y '(PTS t)) (lambda () (subst '(= (PTS t) (PTS s))) (ass)))))
(define (m8-ball-lt! sp c r y)         ; (IN y (BALL sp c r)) in context: y in pts sp, d(c, y) < r
  (dk-split-all! (dk-landed (lambda () (mac-h 'ball-membership (list 'IN y (list 'BALL sp c r))))))
  (let ((d (list (list 'DIST sp) c y)))
    (fact 'metric-dist-real sp c y)
    (m6-and! (list '<= d r) (list 'NOT (list '= d r)))
    (fact 'rr-le-ne-lt d r)))
(dk-iff! (lambda (g) (dk-contains? g 'BALL))
  ;; bound => balls
  (lambda ()
    (let* ((bnd (dk-pick (lambda (h) (and (eq? (m6-head h) 'FORALL) (dk-contains? h '(DIST t)) (not (dk-contains? h 'BALL)))) "the bound"))
           (pl (dk-peel!))
           (x (cadr (car (filter (lambda (q) (eq? (m6-head q) 'IN)) pl))))
           (r (cadr (car (filter (lambda (q) (eq? (m6-head q) 'POS-RR)) pl)))))
      (fact 'rr-pos-rr-in-rr r)
      (mac 'subset-def)
      (let ((y (dk-di-var!)))
        (m8-in-t! x)
        (m8-ball-lt! 't x r y)
        (dk-have! (list 'IN y '(PTS s)) (lambda () (subst '(= (PTS s) (PTS t))) (ass)))
        (dk-apply! bnd x y)
        (fact 'metric-dist-real 's x y)
        (dk-have! (list 'IN (list '* 'K r) 'RR) (lambda () (type-term)))
        (dk-have! (list 'IN (list '* 'K (m8-tt x y)) 'RR) (lambda () (type-term)))
        (dk-have! (list '< (list '* 'K (m8-tt x y)) (list '* 'K r))
          (lambda ()
            (let ((dlt (list '- r (m8-tt x y))))
              (fact 'metric-dist-real 't x y)
              (dk-have! (list 'IN dlt 'RR) (lambda () (type-term)))
              (dk-have! (list '< 0 dlt) (lambda () (dk-ineq! (list '< (m8-tt x y) r) (list 'IN (m8-tt x y) 'RR) (list 'IN r 'RR))))
              (let ((dw (dk-name! dlt 'RR)))
                (dk-have! (list '< 0 dw) (lambda () (subst (list '= dw dlt)) (ass)))
                (fact 'rr-mul-pos 'K dw)
                (dk-have! (list '= (list '* 'K dw) (list '- (list '* 'K r) (list '* 'K (m8-tt x y))))
                  (lambda () (subst (list '= dw dlt)) (crs)))
                (dk-have! (list 'IN (list '* 'K dw) 'RR) (lambda () (type-term)))
                (dk-ineq! (list '< 0 (list '* 'K dw)) (list '= (list '* 'K dw) (list '- (list '* 'K r) (list '* 'K (m8-tt x y))))
                          (list 'IN (list '* 'K dw) 'RR)
                          (list 'IN (list '* 'K r) 'RR) (list 'IN (list '* 'K (m8-tt x y)) 'RR))))))
        (mac 'ball-membership)
        (dk-conj-close!
         (lambda ()
           (let ((g (dk-goal)))
             (cond ((eq? (m6-head g) '<=)
                    (dk-ineq! (list '<= (m8-st x y) (list '* 'K (m8-tt x y))) (list '< (list '* 'K (m8-tt x y)) (list '* 'K r))
                              (list 'IN (m8-st x y) 'RR) (list 'IN (list '* 'K (m8-tt x y)) 'RR) (list 'IN (list '* 'K r) 'RR)))
                   ((eq? (m6-head g) 'NOT)
                    (di)
                    (dk-absurd! (list '= (m8-st x y) (list '* 'K r)) (list '<= (m8-st x y) (list '* 'K (m8-tt x y)))
                                (list '< (list '* 'K (m8-tt x y)) (list '* 'K r))
                                (list 'IN (m8-st x y) 'RR) (list 'IN (list '* 'K (m8-tt x y)) 'RR) (list 'IN (list '* 'K r) 'RR)))
                   (#t (ass)))))))))
  ;; balls => bound
  (lambda ()
    (let* ((bl (dk-pick (lambda (h) (and (eq? (m6-head h) 'FORALL) (dk-contains? h 'BALL))) "the ball inclusion"))
           (pl (dk-peel!))
           (gl (dk-goal))
           (x (cadr (cadr gl))) (y (caddr (cadr gl)))
           (dt (m8-tt x y)) (ds (m8-st x y)) (Kdt (list '* 'K dt)))
      (m8-in-t! x) (m8-in-t! y)
      (fact 'metric-dist-real 's x y)
      (fact 'metric-dist-real 't x y)
      (fact 'metric-pos 't x y)
      (dk-have! (list 'IN Kdt 'RR) (lambda () (type-term)))
      (dk-have! (list 'FORALL 'm8e_ (list 'IMPLIES '(POS-RR m8e_) (list '<= ds (list '+ Kdt 'm8e_))))
        (lambda ()
          (let* ((pe (dk-peel!))
                 (e (cadr (car (filter (lambda (q) (eq? (m6-head q) 'POS-RR)) pe)))))
            (fact 'rr-pos-rr-in-rr e)
            (fact 'rr-lt-of-pos-rr e)
            (dk-have! '(NOT (= K 0)) (lambda () (di) (dk-absurd! '(= K 0) '(< 0 K) '(IN K RR))))
            (m6-and! '(IN K RR) '(NOT (= K 0)))
            (fact 'rr-recip-closed 'K)
            (m6-and! (list 'IN e 'RR) '(IN (recip K) RR))
            (fact 'rr-mul-closed e '(recip K))
            (let* ((q (dk-name! (list '* e '(recip K)) 'RR))
                   (r (list '+ dt q)))
              (dk-have! (list '= (list '* 'K q) e)
                (lambda ()
                  (subst (list '= q (list '* e '(recip K))))
                  (fact 'rr-recip-inverse 'K)
                  (dk-have! (list '= (list '* 'K (list '* e '(recip K))) (list '* e (list '* 'K '(recip K)))) (lambda () (dk-crs-opaque!)))
                  (subst (list '= (list '* 'K (list '* e '(recip K))) (list '* e (list '* 'K '(recip K)))))
                  (subst (list '= (list '* 'K '(recip K)) 1))
                  (crs)))
              (dk-have! (list '< 0 q)
                (lambda ()
                  (fact 'rr-recip-pos 'K)
                  (subst (list '= q (list '* e '(recip K))))
                  (fact 'rr-mul-pos e '(recip K))
                  (ass)))
              (dk-have! (list 'IN r 'RR) (lambda () (type-term)))
              (dk-have! (list '< 0 r) (lambda () (dk-ineq! (list '<= 0 dt) (list '< 0 q) (list 'IN dt 'RR) (list 'IN q 'RR))))
              (fact 'rr-pos-rr-of-lt r)
              (dk-have! (list 'IN y (list 'BALL 't x r))
                (lambda ()
                  (mac 'ball-membership)
                  (dk-conj-close!
                   (lambda ()
                     (let ((g (dk-goal)))
                       (cond ((eq? (m6-head g) '<=) (dk-ineq! (list '< 0 q) (list 'IN dt 'RR) (list 'IN q 'RR)))
                             ((eq? (m6-head g) 'NOT) (di) (dk-absurd! (list '= dt r) (list '< 0 q) (list 'IN dt 'RR) (list 'IN q 'RR)))
                             (#t (ass))))))))
              (fact 'subset-mem-fwd (list 'BALL 't x r) (list 'BALL 's x (list '* 'K r)) y)
              (dk-apply! bl x r)
              (fact 'subset-mem-fwd (list 'BALL 't x r) (list 'BALL 's x (list '* 'K r)) y)
              (dk-have! (list 'IN (list '* 'K r) 'RR) (lambda () (type-term)))
              (m8-ball-lt! 's x (list '* 'K r) y)
              (dk-have! (list '= (list '* 'K r) (list '+ Kdt (list '* 'K q))) (lambda () (crs)))
              (dk-have! (list 'IN (list '* 'K q) 'RR) (lambda () (type-term)))
              (dk-ineq! (list '< ds (list '* 'K r)) (list '= (list '* 'K r) (list '+ Kdt (list '* 'K q)))
                        (list '= (list '* 'K q) e)
                        (list 'IN ds 'RR) (list 'IN (list '* 'K r) 'RR) (list 'IN Kdt 'RR) (list 'IN (list '* 'K q) 'RR)
                        (list 'IN e 'RR))))))
      (dk-close-if! (lambda () (fact 'rr-le-of-le-add-all-pos ds Kdt)) ass))))
(qed 'lipschitz-bound-iff-balls)
