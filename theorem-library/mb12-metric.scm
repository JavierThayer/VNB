 (lambda ()
   (let ((g (dk-goal)))
     (cond ((eq? (m6-head g) 'SUBSET) (dk-close-if! (lambda () (fact 'complement-in-subset 'O '(PTS s))) ass))
           ((eq? (m6-head g) 'IS-OPEN)
            (fact 'complement-in-double '(PTS s) 'O)
            (subst '(= (COMPLEMENT-IN (PTS s) (COMPLEMENT-IN (PTS s) O)) O))
            (ass))
           (#t (ass))))))
(qed 'open-complement-closed)
