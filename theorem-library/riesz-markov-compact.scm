;;; theorem-library/riesz-markov-compact.scm -- RIESZ-MARKOV on a compact metric space
;;; (RM-3A follow-up, 2026-10-10).  Prefix rmz-.  Source: the user's notes-63, form (b).
;;;
;;; THE THEOREM (rmz-riesz-markov).  s a compact metric space with a point, lamx a
;;; positive linear functional on CONT-FNS(s) (IS-POSITIVE-FUNCTIONAL).  Then some nu is a
;;; measure on exactly BOREL-SETS(s) (IS-MEASURE(PTS s, BOREL-SETS s, nu)) such that every f
;;; in CONT-FNS(s) is nu-integrable and RINTEGRAL(PTS s, BOREL-SETS s, nu, f) = lamx(f).
;;; The witness is RM-3B's push-forward NU of rmk-riesz-markov-from-k.
;;;
;;; THE ROUTE.  rmm-dense-seq-exists gives dseq, hence K = RM-KMS(s, dseq) and
;;; pi = RM-PI(s, dseq) (RM-1).  vs = { f o pi : f in CONT-FNS(s) } (a SEP of CONT-FNS(K))
;;; is closed under sums and real multiples and holds 1 = 1 o pi (each by function
;;; extensionality on K).  The functional is lm(g) = lamx(x |-> g(RM-CODE(s, dseq, x))):
;;; RM-CODE is pi's section (rmm-pi-code: pi(code x) = x), so lm(f o pi) = lamx(f)
;;; (rmz-lm-val) and no well-definedness argument or IOTA is needed; positivity of lm uses
;;; that pi is ONTO (rmm-pi-onto).  pex-positive-extension extends lm to plam, positive on
;;; CONT-FNS(K); plam(f o pi) = lamx(f); rmk-riesz-markov-from-k concludes.
;;; rmz-riesz-markov-dense is the theorem for a given dense sequence.
;;; The EMPTY space is not covered (CONT-FNS of it is {the empty function}, and a zero-
;;; measure statement would need integral facts the tree does not have ready): skipped.
;;;
;;; LOAD WINDOW: [after theorem-library/riesz-markov AND theorem-library/positive-extension,
;;; end).  Latest citations: rmk-riesz-markov-from-k (riesz-markov), pex-positive-extension,
;;; pex-c-set (positive-extension), rmc-cont-fns-*, rmc-pf-add/-scale (riesz-markov-cantor),
;;; rmm-dense-seq-exists, rmm-pi-*, rmm-code-in-k, rmm-k-compact, rmm-kms-* (riesz-markov-
;;; model), pfw-comp-fun (push-forward), ms-compose-continuous-at, ms-const-continuous-at.
;;; Library: measure.  No late tactic, no top-level macro (compilable).

(define rmz-ks '(RM-KMS s dseq))
(define rmz-kp '(PTS (RM-KMS s dseq)))
(define rmz-pi '(RM-PI s dseq))
(define rmz-cs '(CONT-FNS s))
(define rmz-ck '(CONT-FNS (RM-KMS s dseq)))
(define (rmz-comp f) (list 'VNB-LAMBDA 'pwz_ rmz-kp (list f (list rmz-pi 'pwz_))))
(define (rmz-code x) (list 'RM-CODE 's 'dseq x))
(define (rmz-back g) (list 'VNB-LAMBDA 'rzx_ '(PTS s) (list g (rmz-code 'rzx_))))
(define rmz-vs (list 'SEP 'rzg_ rmz-ck (list 'FORSOME 'rzf_ (list 'AND (list 'IN 'rzf_ rmz-cs) (list '= 'rzg_ (rmz-comp 'rzf_))))))
(define rmz-lm (list 'VNB-LAMBDA 'rzg_ rmz-vs (list 'lamx (rmz-back 'rzg_))))
(define (rmz-hyps body)
  (list 'FORALL 's (list 'FORALL 'dseq (list 'FORALL 'lamx
    (list 'IMPLIES '(IS-COMPACT s) (list 'IMPLIES '(IS-DENSE-SEQ s dseq) (list 'IMPLIES '(IS-POSITIVE-FUNCTIONAL s lamx) body)))))))
(define (rmz-fa v dom body) (list 'FORALL v (list 'IMPLIES (list 'IN v dom) body)))

(define (rmz-qed! name)
  (if (not (proof-done? *ps*))
      (error "riesz-markov-compact: proof did not close" name (expression->string (dk-goal))))
  (qed name)
  (topic! name 'analysis))
(define (rmz-prop! . keepers) (if (apply dk-only! keepers) (prop)))
(define (rmz-redex? t)
  (and (pair? t)
       (or (and (pair? (car t)) (eq? (car (car t)) 'VNB-LAMBDA))
           (any-pred rmz-redex? t))))
(define (rmz-reduce!)
  (let loop ()
    (if (and (not (proof-done? *ps*)) (rmz-redex? (dk-goal)))
        (let ((leaf (proof-state-focus *ps*)) (g0 (dk-goal)))
          (quietly (lambda () (lam-b)))
          (if (and (not (sequent-node-grounded? leaf)) (eq? leaf (proof-state-focus *ps*))
                   (not (equal? g0 (dk-goal))))
              (loop))))))

;;; the facts about K and pi every proof below opens with
(define (rmz-open!)
  (dk-peel!)
  (dk-cite! 'rmm-kms-metric 's 'dseq)
  (dk-cite! 'rmm-kms-pts 's 'dseq)
  (dk-cite! 'rmm-k-set 's 'dseq)
  (dk-cite! 'rmm-k-compact 's 'dseq)
  (dk-have! (list 'IN rmz-kp 'SET) (lambda () (subst (list '== rmz-kp '(RM-K s dseq))) (ass)))
  (dk-cite! 'rmm-pi-continuous 's 'dseq)
  (let ((pic (list 'IS-CONTINUOUS rmz-ks 's rmz-pi)))
    (dk-project! '(IS-METRIC-SPACE s) 'is-continuous pic)
    (dk-project! (list 'IN rmz-pi (list 'FUN rmz-kp '(PTS s))) 'is-continuous pic)
    (dk-project! (list 'FORALL 'a (list 'IMPLIES (list 'IN 'a rmz-kp) (list 'IS-CONTINUOUS-AT rmz-ks 's rmz-pi 'a)))
                 'is-continuous pic))
  (dk-cite! 'ms-pts-is-set 's))
(define (rmz-lamx-fun!)
  (dk-project! (list 'IN 'lamx (list 'FUN rmz-cs 'RR)) 'is-positive-functional '(IS-POSITIVE-FUNCTIONAL s lamx)))
(define (rmz-lamx-val! f) (rmz-lamx-fun!) (dk-cite! 'fun-apply-type-c 'lamx rmz-cs 'RR f))
(define (rmz-pts-set!) (dk-cite! 'ms-pts-is-set 's))
(define (rmz-pi-pt! z) (dk-cite! 'fun-apply-type-c rmz-pi rmz-kp '(PTS s) z))
(define (rmz-cont-parts! f) (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 's f))))

;;; f o pi is continuous
(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'IMPLIES '(IS-COMPACT s) (list 'IMPLIES '(IS-DENSE-SEQ s dseq)
  (rmz-fa 'f rmz-cs (list 'IN (rmz-comp 'f) rmz-ck))))))))
(rmz-open!)
(rmz-cont-parts! 'f)
(dk-cite! 'pfw-comp-fun rmz-kp '(PTS s) 'RR 'f rmz-pi)
(dk-have! (list 'FORALL 'a (list 'IMPLIES (list 'IN 'a rmz-kp) (list 'IS-CONTINUOUS-AT rmz-ks 'RR-MS (rmz-comp 'f) 'a)))
  (lambda ()
    (let ((av (dk-di-var!)))
      (dk-apply! (dk-ctx-form (list 'FORALL 'a (list 'IMPLIES (list 'IN 'a rmz-kp) (list 'IS-CONTINUOUS-AT rmz-ks 's rmz-pi 'a)))) av)
      (rmz-pi-pt! av)
      (dk-apply! (dk-ctx-form '(FORALL a (IMPLIES (IN a (PTS s)) (IS-CONTINUOUS-AT s RR-MS f a)))) (list rmz-pi av))
      (dk-cite! 'ms-compose-continuous-at rmz-ks 's 'RR-MS rmz-pi 'f av)
      (ass))))
(dk-cite! 'rmc-cont-fns-intro rmz-ks (rmz-comp 'f))
(ass)
(rmz-qed! 'rmz-comp-cont)

;;; the constant 1 is continuous
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (IN (VNB-LAMBDA sx_ (PTS s) 1) (CONT-FNS s))))))
(dk-peel!)
(dk-cite! 'ms-pts-is-set 's)
(dk-cite! 'rr-one-in)
(dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl)))
(fact 'rr-is-metric-space)
(dk-have! '(IN 1 (PTS RR-MS)) (lambda () (subst '(== (PTS RR-MS) RR)) (ass)))
(dk-have! '(IN (VNB-LAMBDA sx_ (PTS s) 1) (FUN (PTS s) RR))
  (lambda () (dk-lam-type! (lambda () (dk-di-var!) (ass)))))
(dk-have! '(FORALL a (IMPLIES (IN a (PTS s)) (IS-CONTINUOUS-AT s RR-MS (VNB-LAMBDA sx_ (PTS s) 1) a)))
  (lambda ()
    (let ((a (dk-di-var!)))
      (dk-cite! 'ms-const-continuous-at 's 'RR-MS 1 a)
      (ass))))
(dk-cite! 'rmc-cont-fns-intro 's '(VNB-LAMBDA sx_ (PTS s) 1))
(ass)
(rmz-qed! 'rmz-one-cont)

;;; (IN (code x) KP), x in PTS s, and pi(code x) = x
(define (rmz-code! x)
  (dk-cite! 'rmm-code-in-k 's 'dseq x)
  (dk-have! (list 'IN (rmz-code x) rmz-kp)
    (lambda () (subst (list '== rmz-kp '(RM-K s dseq))) (ass)))
  (dk-cite! 'rmm-pi-code 's 'dseq x))
;;; T a function term on PTS s whose value at x reduces to f(pi(code x)): T = f
(define (rmz-eq-back! t f)
  (let ((pt! (lambda (x)
               (rmz-code! x)
               (rmz-reduce!)
               (if (rmz-redex? (dk-goal)) (dk-lam-b!))
               (if (dk-contains? (dk-goal) (list rmz-pi (rmz-code x)))
                   (subst (list '= (list rmz-pi (rmz-code x)) x))))))
    (dk-fun-ext! t f '(PTS s) 'RR
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((x (dk-di-var!)))
              (pt! x)
              (dk-cite! 'fun-apply-type-c f '(PTS s) 'RR x)
              (ass)))))
      #f
      (lambda (x)
        (pt! x)
        (dk-cite! 'fun-apply-type-c f '(PTS s) 'RR x)
        (if (not (proof-done? *ps*)) (if (dk-asm? (dk-goal)) (ass) (rfl)))))))

;;; f o pi lies in vs, and lm(f o pi) = lamx(f)
(sp (make-wff (rmz-hyps (rmz-fa 'f rmz-cs
  (list 'AND (list 'IN (rmz-comp 'f) rmz-vs) (list '= (list rmz-lm (rmz-comp 'f)) '(lamx f)))))))
(rmz-open!)
(rmz-cont-parts! 'f)
(dk-cite! 'rmz-comp-cont 's 'dseq 'f)
(dk-have! (list 'IN (rmz-comp 'f) rmz-vs)
  (lambda ()
    (for-each (lambda (l)
                (if (not (sequent-node-grounded? l))
                    (begin (dk-focus! l)
                           (if (dk-asm? (dk-goal)) (ass)
                               (begin (ew 'f) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl)))))))))
              (dk-opened (lambda () (sep-mi))))))
(dk-conj-close!
  (lambda ()
    (if (dk-asm? (dk-goal)) (ass)
      (begin
        (if (and (pair? (cadr (dk-goal))) (equal? (car (cadr (dk-goal))) rmz-lm)) (rmz-reduce!))
        (let ((t (cadr (cadr (dk-goal)))))
          (rmz-eq-back! t 'f)
          (subst (list '= t 'f))
          (rmz-lamx-val! 'f)
          (if (not (proof-done? *ps*)) (rfl)))))))
(rmz-qed! 'rmz-lm-val)

;;; =====================================================================
;;; THE ASSEMBLY, for a fixed dense sequence
;;; =====================================================================
(define (rmz-sumk f g) (list 'VNB-LAMBDA 'sx_ rmz-kp (list '+ (list f 'sx_) (list g 'sx_))))
(define (rmz-sclk c f) (list 'VNB-LAMBDA 'sx_ rmz-kp (list '* c (list f 'sx_))))
(define rmz-onek (list 'VNB-LAMBDA 'sx_ rmz-kp 1))
(define (rmz-sums f g) (list 'VNB-LAMBDA 'sx_ '(PTS s) (list '+ (list f 'sx_) (list g 'sx_))))
(define (rmz-scls c f) (list 'VNB-LAMBDA 'sx_ '(PTS s) (list '* c (list f 'sx_))))
(define rmz-ones '(VNB-LAMBDA sx_ (PTS s) 1))
(define (rmz-reduce-strict!)
  (let loop () (if (and (not (proof-done? *ps*)) (rmz-redex? (dk-goal))) (if (not (dk-lam-b!)) (loop)))))
;;; g in vs: land the witness a with (IN a C_s) and (= g (comp a)); return a
(define (rmz-vs-split! g)
  (let* ((parts (dk-landed (lambda () (dk-have! (list 'FORSOME 'rzf_ (list 'AND (list 'IN 'rzf_ rmz-cs) (list '= g (rmz-comp 'rzf_))))
                                          (lambda () (dk-split-all! (dk-landed (lambda () (sep-me (dk-ctx-form (list 'IN g rmz-vs))))))
                                                     (ass))))))
         (a (dk-skolem! (car parts))))
    (rmz-cont-parts! a)
    a))
;;; L = R, two members of CONT-FNS(K) equal pointwise; FNS the functions of C_s to type at pi(z)
(define (rmz-eq-k! l r fns)
  (dk-fun-ext! l r rmz-kp 'RR
    (lambda () (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts rmz-ks l))) (ass))
    (lambda () (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts rmz-ks r))) (ass))
    (lambda (z)
      (rmz-pi-pt! z)
      (for-each (lambda (f) (dk-cite! 'fun-apply-type-c f '(PTS s) 'RR (list rmz-pi z))) fns)
      (rmz-reduce-strict!)
      (if (not (proof-done? *ps*)) (crs)))))

(define rmz-concl
  '(FORSOME nu (AND (IS-MEASURE (PTS s) (BOREL-SETS s) nu)
     (FORALL f (IMPLIES (IN f (CONT-FNS s))
       (AND (IS-INTEGRABLE (PTS s) (BOREL-SETS s) nu f)
            (= (RINTEGRAL (PTS s) (BOREL-SETS s) nu f) (lamx f))))))))

(sp (make-wff (rmz-hyps rmz-concl)))
(rmz-open!)
(rmz-lamx-fun!)
(dk-cite! 'rmz-one-cont 's)
(dk-cite! 'rmz-one-cont rmz-ks)
(dk-cite! 'pex-c-set rmz-ks)
(dk-have! (list 'IN rmz-vs 'SET) (lambda () (dk-close-all! (lambda () (sep-set)))))
(define (rmz-in-c! f) (dk-split-all! (list (dk-cite! 'rmz-lm-val 's 'dseq 'lamx f))) (dk-cite! 'rmz-comp-cont 's 'dseq f))
(define (rmz-ant! a)
  (cond
    ((dk-asm? a) #t)
    ((dk-head-is? a 'SUBSET)
     (dk-have! a (lambda () (mac 'subset-def) (let ((g (dk-di-var!))) (rmz-vs-split! g)
                   (dk-have! (list 'IN g rmz-ck) (lambda () (dk-split-all! (dk-landed (lambda () (sep-me (dk-ctx-form (list 'IN g rmz-vs)))))) (ass)))))))
    ((and (dk-head-is? a 'IN) (equal? (cadr a) rmz-onek))
     (dk-have! a (lambda ()
       (rmz-in-c! rmz-ones)
       (rmz-eq-k! rmz-onek (rmz-comp rmz-ones) (list rmz-ones))
       (subst (list '= rmz-onek (rmz-comp rmz-ones)))
       (ass))))
    ((and (dk-head-is? a 'IN) (equal? (cadr a) rmz-lm))
     (dk-have! a (lambda ()
       (dk-lam-type!
         (lambda ()
           (let* ((g (dk-di-var!)) (af (rmz-vs-split! g)))
             (subst (list '= g (rmz-comp af)))
             (rmz-eq-back! (rmz-back (rmz-comp af)) af)
             (subst (list '= (rmz-back (rmz-comp af)) af))
             (rmz-lamx-val! af)
             (ass)))
         (lambda () (ass))))))
    (#t
     (dk-have! a (lambda ()
       (dk-peel!)
       (let ((g (dk-goal)))
         (cond
           ;; closure under sums / multiples
           ((dk-head-is? g 'IN)
            (let* ((t (cadr g)) (body (cadddr t)))
              (if (eq? (car body) '+)
                  (let* ((f1 (car (cadr body))) (f2 (car (caddr body)))
                         (a1 (rmz-vs-split! f1)) (a2 (rmz-vs-split! f2)))
                    (subst (list '= f1 (rmz-comp a1))) (subst (list '= f2 (rmz-comp a2)))
                    (dk-cite! 'rmc-cont-fns-add 's a1 a2)
                    (rmz-in-c! (rmz-sums a1 a2)) (rmz-in-c! a1) (rmz-in-c! a2)
                    (dk-cite! 'rmc-cont-fns-add rmz-ks (rmz-comp a1) (rmz-comp a2))
                    (rmz-eq-k! (rmz-sumk (rmz-comp a1) (rmz-comp a2)) (rmz-comp (rmz-sums a1 a2)) (list a1 a2))
                    (subst (list '= (rmz-sumk (rmz-comp a1) (rmz-comp a2)) (rmz-comp (rmz-sums a1 a2))))
                    (ass))
                  (let* ((c (cadr body)) (f1 (car (caddr body))) (a1 (rmz-vs-split! f1)))
                    (subst (list '= f1 (rmz-comp a1)))
                    (dk-cite! 'rmc-cont-fns-scale 's c a1)
                    (rmz-in-c! (rmz-scls c a1)) (rmz-in-c! a1)
                    (dk-cite! 'rmc-cont-fns-scale rmz-ks c (rmz-comp a1))
                    (rmz-eq-k! (rmz-sclk c (rmz-comp a1)) (rmz-comp (rmz-scls c a1)) (list a1))
                    (subst (list '= (rmz-sclk c (rmz-comp a1)) (rmz-comp (rmz-scls c a1))))
                    (ass)))))
           ;; additivity / homogeneity of lm
           ((dk-head-is? g '=)
            (let* ((t (cadr (cadr g))) (body (cadddr t)))
              (if (eq? (car body) '+)
                  (let* ((f1 (car (cadr body))) (f2 (car (caddr body)))
                         (a1 (rmz-vs-split! f1)) (a2 (rmz-vs-split! f2)))
                    (subst (list '= f1 (rmz-comp a1))) (subst (list '= f2 (rmz-comp a2)))
                    (dk-cite! 'rmc-cont-fns-add 's a1 a2)
                    (rmz-in-c! (rmz-sums a1 a2)) (rmz-in-c! a1) (rmz-in-c! a2)
                    (dk-cite! 'rmc-cont-fns-add rmz-ks (rmz-comp a1) (rmz-comp a2))
                    (rmz-eq-k! (rmz-sumk (rmz-comp a1) (rmz-comp a2)) (rmz-comp (rmz-sums a1 a2)) (list a1 a2))
                    (subst (list '= (rmz-sumk (rmz-comp a1) (rmz-comp a2)) (rmz-comp (rmz-sums a1 a2))))
                    (subst (list '= (list rmz-lm (rmz-comp (rmz-sums a1 a2))) (list 'lamx (rmz-sums a1 a2))))
                    (subst (list '= (list rmz-lm (rmz-comp a1)) (list 'lamx a1)))
                    (subst (list '= (list rmz-lm (rmz-comp a2)) (list 'lamx a2)))
                    (dk-cite! 'rmc-pf-add 's 'lamx a1 a2)
                    (ass))
                  (let* ((c (cadr body)) (f1 (car (caddr body))) (a1 (rmz-vs-split! f1)))
                    (subst (list '= f1 (rmz-comp a1)))
                    (dk-cite! 'rmc-cont-fns-scale 's c a1)
                    (rmz-in-c! (rmz-scls c a1)) (rmz-in-c! a1)
                    (dk-cite! 'rmc-cont-fns-scale rmz-ks c (rmz-comp a1))
                    (rmz-eq-k! (rmz-sclk c (rmz-comp a1)) (rmz-comp (rmz-scls c a1)) (list a1))
                    (subst (list '= (rmz-sclk c (rmz-comp a1)) (rmz-comp (rmz-scls c a1))))
                    (subst (list '= (list rmz-lm (rmz-comp (rmz-scls c a1))) (list 'lamx (rmz-scls c a1))))
                    (subst (list '= (list rmz-lm (rmz-comp a1)) (list 'lamx a1)))
                    (dk-cite! 'rmc-pf-scale 's 'lamx c a1)
                    (ass)))))
           ;; positivity
           (#t
            (let* ((f1 (cadr (caddr g)))
                   (hyp (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h f1) (dk-contains? h rmz-kp))) "f >= 0 on K"))
                   (a1 (rmz-vs-split! f1)))
              (dk-have! (rmz-fa 'pfx_ '(PTS s) (list '<= 0 (list a1 'pfx_)))
                (lambda ()
                  (let* ((y (dk-di-var!))
                         (es (dk-skolem! (dk-cite! 'rmm-pi-onto 's 'dseq y))))
                    (dk-have! (list 'IN es rmz-kp) (lambda () (subst (list '== rmz-kp '(RM-K s dseq))) (ass)))
                    (let* ((h1 (dk-apply! hyp es))
                           (h2 (dk-rewrite-h! h1 f1 (rmz-comp a1))))
                      (dk-lam-b-h! h2)
                      (subst (list '= y (list rmz-pi es)))
                      (ass)))))
              (subst (list '= f1 (rmz-comp a1)))
              (rmz-in-c! a1)
              (subst (list '= (list rmz-lm (rmz-comp a1)) (list 'lamx a1)))
              (let ((pos (dk-project! (rmz-fa 'pff_ rmz-cs (list 'IMPLIES (rmz-fa 'pfx_ '(PTS s) '(<= 0 (pff_ pfx_))) '(<= 0 (lamx pff_))))
                                      'is-positive-functional '(IS-POSITIVE-FUNCTIONAL s lamx))))
                (dk-apply! pos a1)
                (ass)))))))))))
;;; the antecedents of pex-positive-extension at (K, vs, lm), proved first; then the citation detaches them all
(let loop ((f (lookup-theorem 'pex-positive-extension)) (ts (list rmz-ks rmz-vs rmz-lm)))
  (cond ((and (dk-head-is? f 'FORALL) (pair? ts)) (loop (subst-free (cadr f) (car ts) (caddr f)) (cdr ts)))
        ((dk-head-is? f 'IMPLIES) (rmz-ant! (cadr f)) (loop (caddr f) ts))))
(let ((f (dk-cite! 'pex-positive-extension rmz-ks rmz-vs rmz-lm)))
  (if (not (dk-head-is? f 'FORSOME)) (error "rmz: pex-positive-extension did not detach" (expression->string f)))
      (let* ((plam (dk-skolem! f))
             (ext (dk-ctx-form (list 'EXTENDS-ON rmz-vs plam rmz-lm))))
        (dk-have! (rmz-fa 'f rmz-cs (list '= (list plam (rmz-comp 'f)) '(lamx f)))
          (lambda ()
            (let ((fv (dk-di-var!)))
              (rmz-in-c! fv)
              (rmz-lamx-val! fv)
              (let ((e (dk-project! (rmz-fa 'x_ rmz-vs (list '= (list plam 'x_) (list rmz-lm 'x_))) 'extends-on ext)))
                (dk-apply! e (rmz-comp fv))
                (subst (list '= (list plam (rmz-comp fv)) (list rmz-lm (rmz-comp fv))))
                (subst (list '= (list rmz-lm (rmz-comp fv)) (list 'lamx fv)))
                (rfl)))))
        (let* ((res (dk-cite! 'rmk-riesz-markov-from-k 's 'dseq plam 'lamx))
               (nu (cadddr (cadr res))))
          (dk-split-all! (list res))
          (ew nu)
          (dk-conj-close! (lambda () (ass))))))
(rmz-qed! 'rmz-riesz-markov-dense)

;;; =====================================================================
;;; RIESZ-MARKOV.  X a non-empty compact metric space, lamx a positive linear
;;; functional on CONT-FNS(X): some measure nu on the Borel sets of X integrates
;;; every continuous f, with integral lamx(f).
;;; =====================================================================
(sp (make-wff (list 'FORALL 's (list 'FORALL 'lamx
  (list 'IMPLIES '(IS-COMPACT s) (list 'IMPLIES '(FORSOME x (IN x (PTS s)))
    (list 'IMPLIES '(IS-POSITIVE-FUNCTIONAL s lamx) rmz-concl)))))))
(dk-peel!)
(let ((dq (dk-skolem! (dk-cite! 'rmm-dense-seq-exists 's))))
  (dk-cite! 'rmz-riesz-markov-dense 's dq 'lamx)
  (ass))
(rmz-qed! 'rmz-riesz-markov)
