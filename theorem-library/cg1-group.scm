;;; cg1-group.scm -- the connected component of the identity of a topological group is a
;;; normal subgroup (compact-groups notes, Lemma 5.7, the algebraic half; "closed" needs CLOSURE).
;;; Inversion, left translation and conjugation are locally continuous self-maps; each maps
;;; the component into itself (connected-component-self-map), which gives the three closures.
;;; Agent ISOM, 2026-10-26.  Helper prefix: cgg-.  Library: analysis.

(define (cgg-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (cgg-lc f)
  (list 'FORALL 'lz_ (list 'IMPLIES '(IN lz_ (PTS s)) (list 'FORALL 'lw_ (list 'IMPLIES '(IN lw_ (OPENS s))
    (list 'IMPLIES (list 'IN (list f 'lz_) 'lw_)
      (list 'FORSOME 'lu_ (list 'AND '(IN lu_ (OPENS s)) (list 'AND '(IN lz_ lu_)
        (list 'FORALL 'lq_ (list 'IMPLIES '(IN lq_ lu_) (list 'IN (list f 'lq_) 'lw_))))))))))))
(define (cgg-valeq f ex) (list 'FORALL 'vw_ (list 'IMPLIES '(IN vw_ (PTS s)) (list '= (list f 'vw_) (ex 'vw_)))))
(define cgg-cont
  '(FORALL tga_ (IMPLIES (IN tga_ (CARR g)) (FORALL tgb_ (IMPLIES (IN tgb_ (CARR g))
     (FORALL tgw_ (IMPLIES (IN tgw_ (OPENS s)) (IMPLIES (IN ((OPR g) tga_ ((INV g) tgb_)) tgw_)
       (FORSOME tgu_ (AND (IN tgu_ (OPENS s)) (AND (IN tga_ tgu_)
         (FORSOME tgv_ (AND (IN tgv_ (OPENS s)) (AND (IN tgb_ tgv_)
           (FORALL tgp_ (IMPLIES (IN tgp_ tgu_) (FORALL tgq_ (IMPLIES (IN tgq_ tgv_)
             (IN ((OPR g) tgp_ ((INV g) tgq_)) tgw_)))))))))))))))))))
(define (cgg-parts!)
  (dk-split-all! (list (dk-cite! 'top-group-parts-gt 's 'g)))
  (fact 'group-identity-in 'g)
  (dk-pick (lambda (h) (alpha-equiv? h cgg-cont)) "continuity"))
(define (cgg-op a b) (list '(OPR g) a b))
(define (cgg-inv a) (list '(INV g) a))
(define cgg-E '(IDEN g))
;; t in CARR(g), for a term built from points of the space by OPR and INV
(define (cgg-type! t)
  (cond ((dk-asm? (list 'IN t '(CARR g))) #t)
        ((equal? t cgg-E) (fact 'group-identity-in 'g))
        ((and (pair? t) (equal? (car t) '(INV g)))
         (cgg-type! (cadr t)) (dk-cite! 'group-inv-in 'g (cadr t)))
        ((and (pair? t) (equal? (car t) '(OPR g)))
         (cgg-type! (cadr t)) (cgg-type! (caddr t)) (dk-cite! 'group-carrier-closed-opr 'g (cadr t) (caddr t)))
        (#t (dk-rewrite-h! (list 'IN t '(PTS s)) '(PTS s) '(CARR g)))))
(define (cgg-pts! t)
  (cgg-type! t)
  (if (not (dk-asm? (list 'IN t '(PTS s))))
      (dk-rewrite-h! (list 'IN t '(CARR g)) '(CARR g) '(PTS s))))
(define (cgg-in-open! q V)                ; a point of an open set is a point of the group
  (dk-cite! 'top-open-subset 's V)
  (dk-cite! 'subset-mem-fwd V '(PTS s) q)
  (cgg-type! q))
(define (cgg-cont-at! cont a b W)         ; returns (U V clause)
  (let* ((u (dk-skolem! (dk-apply! cont a b W)))
         (ex (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h u) (eq? (cadr h) 'tgv_))) "the second neighbourhood"))
         (v (dk-skolem! ex))
         (cl (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h u) (dk-contains? h v))) "the product clause")))
    (list u v cl)))
(define (cgg-peel-var!) (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!)))))
;; the set-up of a local-continuity goal: returns (z W), with EX(z) in W landed
(define (cgg-lc-setup! ex)
  (dk-peel!)
  (if (dk-head-is? (dk-goal) 'FORALL) (dk-peel!))
  (let* ((cont (cgg-parts!))
         (h (dk-pick (lambda (h) (and (dk-head-is? h 'IN) (pair? (cadr h)) (eq? (car (cadr h)) 'f))) "f(z) in W"))
         (z (cadr (cadr h))) (W (caddr h)))
    (cgg-type! z)
    (dk-apply! (dk-ctx-form (cgg-valeq 'f ex)) z)
    (dk-have! (list 'IN (ex z) W) (lambda () (subst (list '= (ex z) (list 'f z))) (ass)))
    (list z W cont)))
;; the last clause: forall q in U, f(q) in W, given a procedure landing EX(q) in W
(define (cgg-lc-close! ex body . sep-prop)
  (dk-conj-close!
   (lambda ()
     (cond
      ((and (dk-head-is? (dk-goal) 'IN) (dk-head-is? (caddr (dk-goal)) 'SEP))
       (in-sep! (lambda () (cgg-ass!)) (car sep-prop)))
      ((dk-head-is? (dk-goal) 'FORALL)
         (let ((q (cgg-peel-var!)))
           (body q)
           (cgg-pts! q)
           (dk-apply! (dk-ctx-form (cgg-valeq 'f ex)) q)
           (subst (list '= (list 'f q) (ex q)))
           (ass)))
      (#t (cgg-ass!))))))

;;; ---- the lift to the structure (2026-10-26): each NAME-gt is proved for a group topology
;;; (s, g); NAME restates it for a TOP-GROUP G at s := TOP-GROUP-SPACE(G),
;;; g := TOP-GROUP-GROUP(G), by top-group-group-topology (tb11/tg-struct.scm).
(define cgx-stmts '())
(define (cgx-keep! nm f) (set! cgx-stmts (cons (cons nm f) cgx-stmts)) f)
(define (cgx-subst e)
  (cond ((eq? e 's) '(TOP-GROUP-SPACE G)) ((eq? e 'g) '(TOP-GROUP-GROUP G))
        ((pair? e) (map cgx-subst e)) (#t e)))
(define (cgx-lift! nm-gt nm)
  (let* ((f (cdr (assq nm-gt cgx-stmts)))          ; (FORALL s (FORALL g (IMPLIES HYP BODY)))
         (body (caddr (caddr (caddr f)))))
    (dk-sp-qed! (make-wff (list 'FORALL 'G (list 'IMPLIES '(IS-TOP-GROUP G) (cgx-subst body))))
      (lambda ()
        (di) (di)
        (dk-cite! 'top-group-space-is-top-space 'G)
        (dk-cite! 'top-group-group-is-group 'G)
        (dk-cite! 'top-group-group-topology 'G)
        (dk-cite! nm-gt '(TOP-GROUP-SPACE G) '(TOP-GROUP-GROUP G))
        (ass))
      nm)
    (topic! nm 'analysis)))


;;; ---- inversion ----
(define (cgg-ex-inv w) (cgg-inv w))
(sp (make-wff (cgx-keep! 'top-group-inversion-locally-continuous-gt (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN (PTS s) (PTS s)))
     (list 'IMPLIES (cgg-valeq 'f cgg-ex-inv) (cgg-lc 'f))))))))))
(let* ((zw (cgg-lc-setup! cgg-ex-inv)) (cont (caddr zw)) (z (car zw)) (W (cadr zw)) (iz (cgg-inv z)))
  (cgg-type! iz)
  (dk-cite! 'group-left-id 'g iz)
  (dk-have! (list 'IN (cgg-op cgg-E iz) W) (lambda () (subst (list '= (cgg-op cgg-E iz) iz)) (ass)))
  (let* ((uvc (cgg-cont-at! cont cgg-E z W)) (V (cadr uvc)) (cl (caddr uvc)))
    (ew V)
    (cgg-lc-close! cgg-ex-inv
      (lambda (q)
        (cgg-in-open! q V)
        (cgg-type! (cgg-inv q))
        (dk-apply! cl cgg-E q)
        (dk-cite! 'group-left-id 'g (cgg-inv q))
        (dk-have! (list 'IN (cgg-inv q) W) (lambda () (subst (list '= (cgg-inv q) (cgg-op cgg-E (cgg-inv q)))) (ass)))))))
(qed 'top-group-inversion-locally-continuous-gt)
(topic! 'top-group-inversion-locally-continuous-gt 'analysis)
(cgx-lift! 'top-group-inversion-locally-continuous-gt 'top-group-inversion-locally-continuous)

;;; ---- left translation by a ----
(define (cgg-ex-lt w) (cgg-op 'a w))
(define (cgg-trans-set b V) (list 'SEP 'tz_ '(PTS s) (list 'IN (cgg-op (cgg-inv b) 'tz_) V)))
(sp (make-wff (cgx-keep! 'top-group-left-translation-locally-continuous-gt (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (list 'FORALL 'a (list 'IMPLIES '(IN a (CARR g)) (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN (PTS s) (PTS s)))
     (list 'IMPLIES (cgg-valeq 'f cgg-ex-lt) (cgg-lc 'f))))))))))))
(let* ((zw (cgg-lc-setup! cgg-ex-lt)) (cont (caddr zw)) (z (car zw)) (W (cadr zw))
       (ia (cgg-inv 'a)) (iia (cgg-inv ia)) (U (cgg-trans-set ia W)))
  (cgg-type! ia)
  (dk-cite! 'top-group-translate-open-gt 's 'g ia W)
  (dk-cite! 'group-inv-inv 'g 'a)
  (cgg-pts! z)
  (ew U)
  (cgg-lc-close! cgg-ex-lt
    (lambda (q)
      (let ((m (list 'IN (cgg-op iia q) W)))
        (dk-landed (lambda () (sep-me (list 'IN q U))))
        (dk-rewrite-h! m iia 'a)))
    (lambda () (subst (list '= iia 'a)) (cgg-ass!))))
(qed 'top-group-left-translation-locally-continuous-gt)
(topic! 'top-group-left-translation-locally-continuous-gt 'analysis)
(cgx-lift! 'top-group-left-translation-locally-continuous-gt 'top-group-left-translation-locally-continuous)

;;; ---- conjugation by u ----
(define (cgg-ex-cj w) (cgg-op (cgg-op 'u w) (cgg-inv 'u)))
(sp (make-wff (cgx-keep! 'top-group-conjugation-locally-continuous-gt (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (list 'FORALL 'u (list 'IMPLIES '(IN u (CARR g)) (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN (PTS s) (PTS s)))
     (list 'IMPLIES (cgg-valeq 'f cgg-ex-cj) (cgg-lc 'f))))))))))))
(let* ((zw (cgg-lc-setup! cgg-ex-cj)) (cont (caddr zw)) (z (car zw)) (W (cadr zw))
       (uz (cgg-op 'u z)) (iu (cgg-inv 'u)) (iiu (cgg-inv iu)))
  (cgg-type! uz)
  (let* ((uvc (cgg-cont-at! cont uz 'u W)) (U1 (car uvc)) (V (cadr uvc)) (cl (caddr uvc)) (U (cgg-trans-set iu U1)))
    (cgg-type! iu)
    (dk-cite! 'top-group-translate-open-gt 's 'g iu U1)
    (dk-cite! 'group-inv-inv 'g 'u)
    (cgg-pts! z)
    (ew U)
    (cgg-lc-close! cgg-ex-cj
      (lambda (q)
        (dk-landed (lambda () (sep-me (list 'IN q U))))
        (dk-rewrite-h! (list 'IN (cgg-op iiu q) U1) iiu 'u)
        (cgg-type! q)
        (cgg-type! (cgg-op 'u q))
        (dk-apply! cl (cgg-op 'u q) 'u))
      (lambda () (subst (list '= iiu 'u)) (cgg-ass!)))))
(qed 'top-group-conjugation-locally-continuous-gt)
(topic! 'top-group-conjugation-locally-continuous-gt 'analysis)
(cgx-lift! 'top-group-conjugation-locally-continuous-gt 'top-group-conjugation-locally-continuous)

;;; ---- Lemma 5.7 (algebraic half): the component of e is a normal subgroup ----
(define cgg-H (list 'CONNECTED-COMPONENT 's cgg-E))
;; a map f in FUN(PTS s, PTS s) with f(w) = EX(w): returns f
(define (cgg-mk-map! ex)
  (let ((claim (list 'FORSOME 'mf_ (list 'AND '(IN mf_ (FUN (PTS s) (PTS s))) (cgg-valeq 'mf_ ex)))))
    (dk-have! claim
      (lambda ()
        (ew (list 'VNB-LAMBDA 'tv_ '(PTS s) (ex 'tv_)))
        (dk-conj-close!
         (lambda ()
           (if (dk-head-is? (dk-goal) 'IN)
               (dk-lam-type! (lambda () (let ((w (cgg-peel-var!)))
                                          (cgg-type! (ex w))
                                          (subst '(= (PTS s) (CARR g)))
                                          (cgg-ass!)))
                             (lambda () (cgg-ass!)))
               (let ((w (cgg-peel-var!)))
                 (cgg-type! w)
                 (cgg-type! (ex w))
                 (if (not (dk-lam-b!)) (rfl))))))))
    (let ((f (dk-skolem! (dk-ctx-form claim) #t)))
      f)))
;; y in H  ==>  EX(y) in H, for the map EX whose local continuity LC-THM gives (extra arguments EXTRA);
;; E-THUNK proves EX(e) in H
(define (cgg-closed! ex lc-thm extra y e-thunk)
  (let ((f (cgg-mk-map! ex)))
    (if (not (dk-asm? (list 'IN (list f cgg-E) '(PTS s)))) #t)
    (apply dk-cite! lc-thm 's 'g (append extra (list f)))
    (dk-apply! (dk-ctx-form (cgg-valeq f ex)) cgg-E)
    (dk-cite! 'subset-mem-fwd cgg-H '(PTS s) y)
    (dk-apply! (dk-ctx-form (cgg-valeq f ex)) y)
    (dk-have! (list 'IN (ex cgg-E) cgg-H) e-thunk)
    (dk-have! (list 'IN (list f cgg-E) cgg-H) (lambda () (subst (list '= (list f cgg-E) (ex cgg-E))) (ass)))
    (dk-cite! 'connected-component-self-map 's f cgg-E y)
    (dk-have! (list 'IN (ex y) cgg-H) (lambda () (subst (list '= (ex y) (list f y))) (ass)))))

(sp (make-wff (cgx-keep! 'top-group-component-normal-subgroup-gt (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g) (list 'IS-NORMAL-SUBGROUP 'g cgg-H)))))))
(dk-peel!)
(cgg-parts!)
(cgg-pts! cgg-E)
(dk-cite! 'group-carr-set 'g)
(dk-rewrite-h! '(IN (CARR g) SET) '(CARR g) '(PTS s))

(dk-cite! 'connected-component-connected 's cgg-E)
(define (cgg-rhs! iff)
  (dk-have! (caddr iff) (lambda () (if (dk-only! iff (cadr iff)) (prop))))
  (dk-split-all! (list (caddr iff))))
(cgg-rhs! (dk-cite! 'is-connected-t 's cgg-H))
(dk-cite! 'connected-component-self 's cgg-E)
(define cgg-C1 (list 'SUBSET cgg-H '(CARR g)))
(define cgg-C3 (list 'FORALL 'sga_ (list 'IMPLIES (list 'IN 'sga_ cgg-H) (list 'FORALL 'sgb_ (list 'IMPLIES (list 'IN 'sgb_ cgg-H)
                 (list 'IN '((OPR g) sga_ sgb_) cgg-H))))))
(define cgg-C4 (list 'FORALL 'sga_ (list 'IMPLIES (list 'IN 'sga_ cgg-H) (list 'IN '((INV g) sga_) cgg-H))))
(define cgg-N (list 'FORALL 'sgu_ (list 'IMPLIES '(IN sgu_ (CARR g)) (list 'FORALL 'sga_ (list 'IMPLIES (list 'IN 'sga_ cgg-H)
                 (list 'IN '((OPR g) ((OPR g) sgu_ sga_) ((INV g) sgu_)) cgg-H))))))
(dk-have! cgg-C1 (lambda () (subst '(= (CARR g) (PTS s))) (cgg-ass!)))
(define (cgg-in-H! a)                    ; a in H: a in CARR g
  (dk-cite! 'subset-mem-fwd cgg-H '(CARR g) a))
(dk-have! cgg-C3
  (lambda ()
    (dk-peel!)
    (let* ((gl (cadr (dk-goal))) (a (cadr gl)) (b (caddr gl)))
      (cgg-in-H! a)
      (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g a)))
      (cgg-closed! (lambda (w) (cgg-op a w)) 'top-group-left-translation-locally-continuous-gt (list a) b
        (lambda () (subst (list '= (cgg-op a cgg-E) a)) (cgg-ass!)))
      (cgg-ass!))))
(dk-have! cgg-C4
  (lambda ()
    (dk-peel!)
    (let ((a (cadr (cadr (dk-goal)))))
      (fact 'group-inv-iden 'g)
      (cgg-closed! cgg-inv 'top-group-inversion-locally-continuous-gt '() a
        (lambda () (subst (list '= (cgg-inv cgg-E) cgg-E)) (cgg-ass!)))
      (cgg-ass!))))
(dk-have! cgg-N
  (lambda ()
    (dk-peel!)
    (let* ((gl (cadr (dk-goal))) (u (cadr (cadr gl))) (a (caddr (cadr gl))))
      (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g u)))
      (cgg-closed! (lambda (w) (cgg-op (cgg-op u w) (cgg-inv u))) 'top-group-conjugation-locally-continuous-gt (list u) a
        (lambda () (subst (list '= (cgg-op u cgg-E) u)) (subst (list '= (cgg-op u (cgg-inv u)) cgg-E)) (cgg-ass!)))
      (cgg-ass!))))
(let ((sg (dk-cite! 'is-subgroup 'g cgg-H)))
  (dk-have! (caddr sg) (lambda () (dk-conj-close! (lambda () (cgg-ass!)))))
  (dk-have! (cadr sg) (lambda () (if (dk-only! sg (caddr sg)) (prop)))))
(let ((ns (dk-cite! 'is-normal-subgroup 'g cgg-H)))
  (dk-have! (caddr ns) (lambda () (dk-conj-close! (lambda () (cgg-ass!)))))
  (if (dk-only! ns (caddr ns)) (prop)))
(qed 'top-group-component-normal-subgroup-gt)
(topic! 'top-group-component-normal-subgroup-gt 'analysis)
(cgx-lift! 'top-group-component-normal-subgroup-gt 'top-group-component-normal-subgroup)

;;; ---- an open subgroup has an open complement (the notes' "any open subgroup is closed") ----
(define cgg-K '(SEP cz_ (PTS s) (NOT (IN cz_ H))))
(define cgg-prod '(FORALL sga_ (IMPLIES (IN sga_ H) (FORALL sgb_ (IMPLIES (IN sgb_ H) (IN ((OPR g) sga_ sgb_) H))))))
(define cgg-invc '(FORALL sga_ (IMPLIES (IN sga_ H) (IN ((INV g) sga_) H))))
(sp (make-wff (cgx-keep! 'top-group-open-subgroup-complement-open-gt (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (list 'FORALL 'H (list 'IMPLIES '(IS-SUBGROUP g H) (list 'IMPLIES '(IN H (OPENS s)) (list 'IN cgg-K '(OPENS s)))))))))))
(dk-peel!)
(cgg-parts!)
(cgg-rhs! (dk-cite! 'is-subgroup 'g 'H))
(dk-have! (list 'SUBSET cgg-K '(PTS s))
  (lambda () (mac 'subset-def)
             (let ((z (cgg-peel-var!)))
               (dk-landed (lambda () (sep-me (list 'IN z cgg-K))))
               (cgg-ass!))))
(dk-have! (list 'FORALL 'a (list 'IMPLIES (list 'IN 'a cgg-K) (list 'FORSOME 'W (list 'AND '(IN W (OPENS s)) (list 'AND '(IN a W) (list 'SUBSET 'W cgg-K))))))
  (lambda ()
    (let* ((x (cgg-peel-var!)) (ix (cgg-inv x)) (trs (cgg-trans-set x 'H)))
      (dk-have! (list 'IN x '(PTS s)) (lambda () (dk-cite! 'subset-mem-fwd cgg-K '(PTS s) x) (cgg-ass!)))
      (cgg-type! x)
      (cgg-type! ix)
      (dk-cite! 'top-group-translate-open-gt 's 'g x 'H)
      (dk-cite! 'group-inv-inv 'g x)
      (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g ix)))
      (dk-rewrite-h! (list '= (cgg-op ix (cgg-inv ix)) cgg-E) (cgg-inv ix) x)
      (ew trs)
      (dk-conj-close!
       (lambda ()
         (cond
          ((dk-head-is? (dk-goal) 'SUBSET)
           (mac 'subset-def)
           (let* ((t (cgg-peel-var!)) (m (cgg-op ix t)) (im (cgg-inv m)))
             (dk-landed (lambda () (sep-me (list 'IN t trs))))
             (cgg-type! t) (cgg-type! m) (cgg-type! im) (cgg-type! (cgg-inv t))
             (in-sep! (lambda () (cgg-ass!))
                      (lambda ()
                        (di)
                        (dk-apply! (dk-ctx-form cgg-invc) m)
                        (dk-apply! (dk-ctx-form cgg-prod) t im)
                        (dk-cite! 'group-inv-opr 'g ix t)
                        (dk-rewrite-h! (list 'IN (cgg-op t im) 'H) im (cgg-op (cgg-inv t) (cgg-inv ix)))
                        (dk-rewrite-h! (list 'IN (cgg-op t (cgg-op (cgg-inv t) (cgg-inv ix))) 'H) (cgg-inv ix) x)
                        (dk-cite! 'group-mul-inv-cancel 'g t x)
                        (dk-rewrite-h! (list 'IN (cgg-op t (cgg-op (cgg-inv t) x)) 'H) (cgg-op t (cgg-op (cgg-inv t) x)) x)
                        (dk-landed (lambda () (sep-me (list 'IN x cgg-K))))
                        (ai (list 'NOT (list 'IN x 'H)))))))
          ((and (dk-head-is? (dk-goal) 'IN) (dk-head-is? (caddr (dk-goal)) 'SEP))
           (in-sep! (lambda () (cgg-ass!))
                    (lambda () (subst (list '= (cgg-op ix x) cgg-E)) (cgg-ass!))))
          (#t (cgg-ass!))))))))
(dk-cite! 'top-open-of-local 's cgg-K)
(cgg-ass!)
(qed 'top-group-open-subgroup-complement-open-gt)
(topic! 'top-group-open-subgroup-complement-open-gt 'analysis)
(cgx-lift! 'top-group-open-subgroup-complement-open-gt 'top-group-open-subgroup-complement-open)

;;; ---- an open connected subgroup is the connected component of e ----
(sp (make-wff (cgx-keep! 'top-group-open-connected-subgroup-is-component-gt (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g)
   (list 'FORALL 'H (list 'IMPLIES '(IS-SUBGROUP g H) (list 'IMPLIES '(IN H (OPENS s)) (list 'IMPLIES '(IS-CONNECTED-T s H)
     (list '= 'H cgg-H)))))))))))
(dk-peel!)
(cgg-parts!)
(cgg-pts! cgg-E)
(cgg-rhs! (dk-cite! 'is-subgroup 'g 'H))
(dk-cite! 'top-group-open-subgroup-complement-open-gt 's 'g 'H)
(dk-cite! 'connected-component-connected 's cgg-E)
(cgg-rhs! (dk-cite! 'is-connected-t 's cgg-H))
(define (cgg-meets C u) (list 'FORSOME 'ctx_ (list 'AND (list 'IN 'ctx_ C) (list 'IN 'ctx_ u))))
