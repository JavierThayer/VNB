;;; (0) the ma- kit (file-local copy of scratchpad/ma/final/kit-body.scm)
;;; (0) the ma- kit (file-local; most from push-forward.scm's pfw- kit and product-measure.scm's pms- kit)

(define (ma-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; dk-project!, except that a claim equal to the focus goal is proved in place
(define (ma-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
;;; sequential map (MIT evaluates arguments right to left)
(define (ma-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (ma-for-each f l) (let loop ((l l)) (if (pair? l) (begin (f (car l)) (loop (cdr l))))))
;;; the right-hand conjuncts of an IFF in context whose left side is in context, landed (by prop, on a lane)
(define (ma-iff-parts! iff0)
  (let* ((iff (or (dk-ctx-form iff0) (error "ma-iff-parts!: not in context" (expression->string iff0))))
         (rhs (caddr iff))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    ;; the conjunct that is the focus goal (closed in place) goes LAST: closing it moves the focus
    (let* ((goal? (lambda (c) (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) c))))))
           (late  (filter goal? cs))
           (early (filter (lambda (c) (not (goal? c))) cs)))
      (ma-map (lambda (c) (ma-by-prop! c (list iff (cadr iff)))) (append early late))
      cs)))
;;; the LEFT side of an IFF in context whose right side is in context, landed
(define (ma-iff-back! iff0)
  (let ((iff (or (dk-ctx-form iff0) (error "ma-iff-back!: not in context" (expression->string iff0)))))
    (ma-by-prop! (cadr iff)
      (cons iff (let ((r (caddr iff)))
                  (if (dk-asm? r)
                      (list r)
                      (let loop ((r r) (acc '()))
                        (if (and (pair? r) (eq? (car r) 'AND) (not (dk-asm? r)))
                            (loop (caddr r) (cons (cadr r) acc))
                            (reverse (cons r acc))))))))))
;;; CLAIM by prop from the formulas FS: on a lane, or in place when CLAIM is the focus goal; returns CLAIM
(define (ma-by-prop! claim fs)
  (cond ((dk-asm? claim) (dk-ctx-form claim))
        ((eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
         (ma-prop-with! fs) claim)
        (#t (dk-have! claim (lambda () (ma-prop-with! fs))) (dk-ctx-form claim))))
;;; (IN w (SEP v A P)) in context: land (IN w A) and P[w], the membership kept; return P[w].
(define (ma-sep-parts! m0)
  (let* ((m (->raw-formula m0))
         (w (cadr m)) (s (caddr m)) (v (cadr s)) (dom (caddr s))
         (d (list 'IN w dom))
         (p (subst-free v w (cadddr s)))
         (conj (list 'AND d p)))
    (if (not (dk-asm? m)) (error "ma-sep-parts!: not in context" (expression->string m)))
    (if (not (and (dk-asm? d) (dk-asm? p)))
        (begin
          (if (not (dk-asm? conj))
              (dk-have! conj (lambda () (sep-me (dk-ctx-form m)) (vnb-guard (lambda () (dk-split-all!)))
                                        (dk-conj-close! dk-ass!))))
          (let ((c (dk-ctx-form conj))) (if c (ai c)))))
    p))
;;; class extensionality, each direction driven: FWD / BWD procedures of the element; lands lhs = rhs
(define (ma-ext2! lhs rhs fwd bwd)
  (dk-have! (list 'FORALL 'mew_ (list 'IFF (list 'IN 'mew_ lhs) (list 'IN 'mew_ rhs)))
    (lambda ()
      (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (dk-iff! (lambda (g) (equal? g (list 'IN wv rhs)))
          (lambda () (fwd wv))
          (lambda () (bwd wv))))))
  (fact 'class-extensionality lhs rhs)
  (list '= lhs rhs))
;;; w in BIG-UNION(v, D, g(v)) gives the index and w in g(index): returns (k . formula)
(define (ma-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (caddr bu)))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
;;; prove the focus goal (IN w bu) at the index k (k in D and w in the k-th term in context)
(define (ma-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))
;;; prop on the named formulas only
(define (ma-prop-with! fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))
;;; (IN z (UNION a b)) from (IN z a) / (IN z b) in context
(define (ma-in-union-left! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-l) (dk-ass!))))
(define (ma-in-union-right! z a b)
  (dk-have! (list 'IN z (list 'UNION a b))
    (lambda () (mac 'union-membership) (oi-r) (dk-ass!))))
;;; (IN x (PAIR x x)), x in SET in context
(define (ma-in-singleton! xv)
  (dk-have! (list 'IN xv (list 'PAIR xv xv))
    (lambda ()
      (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
      (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) xv)))
        (dk-have! (list '= xv xv) (lambda () (rfl)))
        (ma-prop-with! (list pm (list '= xv xv)))))))
;;; with (IN b (PAIR x x)) and x in SET in context, land b = x
(define (ma-singleton-eq! b xv)
  (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
  (let ((pm (dk-apply! (dk-cite! 'pairing-membership xv xv) b)))
    (dk-have! (list '= b xv)
      (lambda () (ma-prop-with! (list pm (list 'IN b (list 'PAIR xv xv))))))
    (list '= b xv)))

;;; FINITE-SET INDUCTION (pms-induct!, product-measure.scm).  PROP-OF builds P(s); BASE! proves P(EMPTY-SET)
;;; on its leaf; (STEP! sv xv u ih) proves P(u), u = sv u {xv}, with ih = P(sv) in context.  Returns P(xs).
(define (ma-class prop-of) (list 'COMP 'miu_ (prop-of 'miu_)))
(define (ma-step-formula c)
  (list 'FORALL 'is_
    (list 'IMPLIES (list 'AND '(IN is_ SET) (list 'AND '(IN (CARD is_) NN) (list 'IN 'is_ c)))
      (list 'FORALL 'ix_
        (list 'IMPLIES '(AND (IN ix_ SET) (NOT (IN ix_ is_)))
          (list 'IN '(UNION is_ (PAIR ix_ ix_)) c))))))
(define (ma-induct! xs prop-of base! step!)
  (let* ((c     (ma-class prop-of))
         (stepf (ma-step-formula c)))
    (have! (list 'IN 'EMPTY-SET c)
      (lambda ()
        (for-each
          (lambda (leaf)
            (dk-focus! leaf)
            (if (equal? (dk-goal) '(in empty-set set))
                (begin (fact 'empty-set-is-set) (ass))
                (base!)))
          (dk-opened (lambda () (comp-mi))))))
    (have! stepf
      (lambda ()
        (let* ((landed (dk-peel!))
               (g      (dk-goal))
               (u      (cadr g))
               (sv     (cadr u))
               (xv     (cadr (caddr u))))
          (dk-split-all! landed)
          (dk-have! (list 'AND (list 'IN xv 'SET) (list 'IN xv 'SET)))
          (fact 'pairing xv xv)
          (dk-have! (list 'AND (list 'IN sv 'SET) (list 'IN (list 'PAIR xv xv) 'SET)))
          (fact 'union-set-closure sv (list 'PAIR xv xv))
          (let* ((ls (dk-landed (lambda () (comp-me (list 'IN sv c)))))
                 (ih (car (filter (lambda (f) (not (equal? f (list 'in sv 'set)))) ls))))
            (for-each
              (lambda (leaf)
                (dk-focus! leaf)
                (if (equal? (dk-goal) (list 'in u 'set))
                    (ass)
                    (step! sv xv u ih)))
              (dk-opened (lambda () (comp-mi))))))))
    (dk-have! (list 'AND (list 'IN 'EMPTY-SET c) stepf))
    (let ((ind (dk-fact! 'finite-set-induction c)))
      (dk-have! (list 'AND (list 'IN xs 'SET) (list 'IN (list 'CARD xs) 'NN)))
      (let* ((inx (dk-apply! ind xs))
             (ls  (dk-landed (lambda () (comp-me inx)))))
        (car (filter (lambda (f) (not (equal? f (list 'in xs 'set)))) ls))))))
;;; the membership laws whose instances make the two memberships propositionally equivalent
(define (ma-ext-prop! lhs rhs cites)
  (let ((side (lambda (have)
                (lambda (w)
                  (let ((fs (ma-map (lambda (c) (apply dk-cite! (car c) (cdr c))) (cites w))))
                    (ma-prop-with! (cons (list 'IN w have) fs)))))))
    (ma-ext2! lhs rhs (side lhs) (side rhs))))

;;; (SUBSET (SEP v d p) d)
(define (ma-sep-subset! sep)
  (dk-have! (list 'SUBSET sep (caddr sep))
    (lambda ()
      (mac 'subset-def)
      (let ((z (dk-di-var!)))
        (ma-sep-parts! (list 'IN z sep))
        (ass)))))
;;; s subset of the finite set ca (ca in SET, CARD ca in NN in context): land (IN s SET), (IN (CARD s) NN)
(define (ma-finite-sub! s ca)
  (fact 'subclass-of-set-is-set s ca)
  (dk-have! (list 'AND (list 'IN ca 'SET) (list 'IN (list 'CARD ca) 'NN)))
  (let ((cs (dk-fact! 'card-subset-nn ca)))
    (dk-have! (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s ca z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z s) (list 'IN 'z ca)))))
    (dk-apply! cs s)))

;;; case split on a right-nested disjunction ORF in context, one THUNK per disjunct (each run with that
;;; disjunct in context, on its own leaf)
(define (ma-or-split! orf thunks)
  (let* ((o (or (dk-ctx-form orf) (error "ma-or-split!: not in context" (expression->string orf))))
         (l (cadr o)) (r (caddr o)))
    (for-each
      (lambda (leaf)
        (dk-focus! leaf)
        (cond ((dk-asm? l) ((car thunks)))
              ((pair? (cddr thunks)) (ma-or-split! r (cdr thunks)))
              (#t ((cadr thunks)))))
      (dk-opened (lambda () (ai o))))))
;;; f in FUN(NN, A) and every f(k) in B: f in FUN(NN, B)   (pfw-retype!, push-forward.scm)
(define (ma-retype! fv a b in-b!)
  (dk-have! (list 'IN fv (list 'FUN 'NN b))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c fv 'NN a kv)
                (ma-then-ass! (lambda () (in-b! (list fv kv)))))
              (begin
                (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN fv (list 'FUN 'NN a))))))
                (ass))))))))
;;; a function symbol G in FUN(DOM, COD) with G(k) == BODY(k): returns (G . VALUE-EQUATION)   (pfw-abstract!)
(define (ma-abstract! dom cod body-of typer pre)
  (let* ((body  (body-of 'mak_))
         (lam   (list 'VNB-LAMBDA 'mak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'mak_ (list 'IMPLIES (list 'IN 'mak_ dom)
                                                    (list '== (list g 'mak_) body)))))
         (claim (list 'FORSOME 'mag_ (list 'AND (list 'IN 'mag_ (list 'FUN dom cod))
                                            (vals 'mag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!))))
                (let ((kv (dk-di-var!)))
                  (pre kv)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "ma-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "ma-abstract!: the value equation did not land"))))
      (cons g ve))))

(define (ap-absurd!) (dk-cite! 'rr-lt-irrefl 0) (ma-prop-with! (list '(< 0 0) '(NOT (< 0 0)))))
;;; helpers repeated from the earlier ALGNUM files (file-local there)


;;; ==================================================================== from grp1x.scm
;;; (44) ALGEBRAIC-NUMBERS ch. 1, bundle B5 (shared with galois-theory B7): the group kit -- right inverse and
;;; identity, cosets, LAGRANGE (Prop. 1.28) and Cor. 1.29.  Purely algebraic.  Helper prefix gk-.
(define (gk-op g a b) (list (list 'OPR g) a b))
(define (gk-inv g a) (list (list 'INV g) a))
(define (gk-e g) (list 'IDEN g))
(define (gk-cos g a h) (list 'LEFT-COSET g a h))
(define (gk-cos-sep g a h) (list 'SEP 'gcx_ (list 'CARR g) (list 'FORSOME 'gcy_ (list 'AND (list 'IN 'gcy_ h) (list '= 'gcx_ (gk-op g a 'gcy_))))))
(define (gk-coss g h) (list 'LEFT-COSETS g h))
(define (gk-coss-sep g h) (list 'SEP 'gcc_ (list 'POWER (list 'CARR g)) (list 'FORSOME 'gca_ (list 'AND (list 'IN 'gca_ (list 'CARR g)) (list '= 'gcc_ (gk-cos g 'gca_ h))))))
(define (gk-rfl!) (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl)))

(sp (make-wff (list 'FORALL 'g (list 'FORALL 'a (list 'FORALL 'h (list '== (gk-cos 'g 'a 'h) (gk-cos-sep 'g 'a 'h)))))))
(dk-peel!) (mac 'LEFT-COSET) (qrfl)
(qed 'left-coset-unfold)
(sp (make-wff (list 'FORALL 'g (list 'FORALL 'h (list '== (gk-coss 'g 'h) (gk-coss-sep 'g 'h))))))
(dk-peel!) (mac 'LEFT-COSETS) (qrfl)
(qed 'left-cosets-unfold)

;;; the right inverse and the right identity (IS-GROUP's two-sided laws)
(define (gk-group-parts! g)
  (dk-project! (list 'HAS-INVERSES (list 'OPR g) (gk-e g) (list 'INV g) (list 'CARR g)) 'is-group (list 'IS-GROUP g))
  (dk-project! (list 'IS-IDENTITY (list 'OPR g) (gk-e g) (list 'CARR g)) 'is-group (list 'IS-GROUP g)))
;;; group-right-inv-id: proven in tb11/tg-group.scm (the same statement); this copy omits it


;;; a^-1 (a b) = b and a (a^-1 b) = b
(sp (make-wff (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP g) (list 'FORALL 'a (list 'IMPLIES '(IN a (CARR g)) (list 'FORALL 'b (list 'IMPLIES '(IN b (CARR g))
  (list 'AND (list '= (gk-op 'g (gk-inv 'g 'a) (gk-op 'g 'a 'b)) 'b) (list '= (gk-op 'g 'a (gk-op 'g (gk-inv 'g 'a) 'b)) 'b))))))))))
(dk-peel!)
(fact 'group-inv-in 'g 'a)
(dk-split-all! (list (dk-apply! (dk-cite! 'group-right-inv-id) 'g 'a)))
(fact 'group-left-inv 'g 'a)
(fact 'group-left-id 'g 'b)
(dk-cite! 'group-assoc 'g (gk-inv 'g 'a) 'a 'b)
(dk-have! (list '= (gk-op 'g (gk-inv 'g 'a) (gk-op 'g 'a 'b)) 'b)
  (lambda ()
    (subst (list '= (gk-op 'g (gk-inv 'g 'a) (gk-op 'g 'a 'b)) (gk-op 'g (gk-op 'g (gk-inv 'g 'a) 'a) 'b)))
    (subst (list '= (gk-op 'g (gk-inv 'g 'a) 'a) (gk-e 'g)))
    (ass)))
(dk-have! (list '= (gk-op 'g 'a (gk-op 'g (gk-inv 'g 'a) 'b)) 'b)
  (lambda ()
    (dk-cite! 'group-assoc 'g 'a (gk-inv 'g 'a) 'b)
    (subst (list '= (gk-op 'g 'a (gk-op 'g (gk-inv 'g 'a) 'b)) (gk-op 'g (gk-op 'g 'a (gk-inv 'g 'a)) 'b)))
    (subst (list '= (gk-op 'g 'a (gk-inv 'g 'a)) (gk-e 'g)))
    (ass)))
(dk-conj-close! dk-ass!)
(qed 'group-inv-cancel)

(define (gk-sub-forms g h)
  (list (list 'SUBSET h (list 'CARR g)) (list 'IN (gk-e g) h)
        (list 'FORALL 'sga_ (list 'IMPLIES (list 'IN 'sga_ h) (list 'FORALL 'sgb_ (list 'IMPLIES (list 'IN 'sgb_ h) (list 'IN (gk-op g 'sga_ 'sgb_) h)))))
        (list 'FORALL 'sga_ (list 'IMPLIES (list 'IN 'sga_ h) (list 'IN (gk-inv g 'sga_) h)))))
(define (gk-sub-parts! g h)
  (ma-for-each (lambda (p) (if (not (dk-asm? p)) (dk-project! p 'is-subgroup (list 'IS-SUBGROUP g h)))) (gk-sub-forms g h)))
(define (gk-sub-op! g h a b) (dk-apply! (dk-ctx-form (caddr (gk-sub-forms g h))) a b))
(define (gk-sub-inv! g h a) (dk-apply! (dk-ctx-form (cadddr (gk-sub-forms g h))) a))
(define (gk-in-carr! g h y) (fact 'subset-mem-fwd h (list 'CARR g) y))

;;; a y lies in aH for y in H
(sp (make-wff (forall-guarded '(g a h y) '((IS-GROUP g) (IN a (CARR g)) (SUBSET h (CARR g)) (IN y h)) (list 'IN (gk-op 'g 'a 'y) (gk-cos 'g 'a 'h)))))
(dk-peel!)
(gk-in-carr! 'g 'h 'y)
(fact 'group-carrier-closed-opr 'g 'a 'y)
(subst (dk-cite! 'left-coset-unfold 'g 'a 'h))
(in-sep! dk-ass! (lambda () (ew 'y) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))
(qed 'left-coset-member)

;;; b in aH gives bH = aH
(sp (make-wff (forall-guarded '(g h a b) '((IS-GROUP g) (IS-SUBGROUP g h) (IN a (CARR g)) (IN b (LEFT-COSET g a h)))
  (list '= (gk-cos 'g 'b 'h) (gk-cos 'g 'a 'h)))))
(dk-peel!)
(gk-sub-parts! 'g 'h)
(dk-cite! 'left-coset-unfold 'g 'a 'h)
(let* ((sa (gk-cos-sep 'g 'a 'h)) (sb (gk-cos-sep 'g 'b 'h))
       (m (dk-rewrite-h! (list 'IN 'b (gk-cos 'g 'a 'h)) (gk-cos 'g 'a 'h) sa))
       (y0 (dk-skolem! (ma-sep-parts! m))))
  (gk-in-carr! 'g 'h y0)
  (fact 'group-inv-in 'g y0)
  (subst (dk-cite! 'left-coset-unfold 'g 'b 'h))
  (subst (dk-cite! 'left-coset-unfold 'g 'a 'h))
  (ma-ext2! sb sa
    (lambda (w)
      (let ((y1 (dk-skolem! (ma-sep-parts! (list 'IN w sb)))))
        (gk-in-carr! 'g 'h y1)
        (gk-sub-op! 'g 'h y0 y1)
        (in-sep! dk-ass!
          (lambda ()
            (ew (gk-op 'g y0 y1))
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (begin
                      (subst (list '= w (gk-op 'g 'b y1)))
                      (subst (list '= 'b (gk-op 'g 'a y0)))
                      (dk-cite! 'group-assoc 'g 'a y0 y1)
                      (ass)))))))))
    (lambda (w)
      (let ((y2 (dk-skolem! (ma-sep-parts! (list 'IN w sa)))))
        (gk-in-carr! 'g 'h y2)
        (gk-sub-inv! 'g 'h y0)
        (gk-sub-op! 'g 'h (gk-inv 'g y0) y2)
        (in-sep! dk-ass!
          (lambda ()
            (ew (gk-op 'g (gk-inv 'g y0) y2))
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (begin
                      (gk-in-carr! 'g 'h (gk-op 'g (gk-inv 'g y0) y2))
                      (subst (list '= 'b (gk-op 'g 'a y0)))
                      (dk-cite! 'group-assoc 'g 'a y0 (gk-op 'g (gk-inv 'g y0) y2))
                      (subst (list '= (gk-op 'g (gk-op 'g 'a y0) (gk-op 'g (gk-inv 'g y0) y2)) (gk-op 'g 'a (gk-op 'g y0 (gk-op 'g (gk-inv 'g y0) y2)))))
                      (dk-split-all! (list (dk-apply! (dk-cite! 'group-inv-cancel) 'g y0 y2)))
                      (subst (list '= (gk-op 'g y0 (gk-op 'g (gk-inv 'g y0) y2)) y2))
                      (ass)))))))))))
  (ass)
(qed 'left-coset-eq)

;;; a subset of a finite set is a finite set
(define (gk-fin! s sup)
  (fact 'subclass-of-set-is-set s sup)
  (dk-have! (list 'AND (list 'IN sup 'SET) (list 'IN (list 'CARD sup) 'NN)))
  (let ((cs (dk-cite! 'card-subset-nn sup)))
    (dk-have! (list 'FORALL 'gkv_ (list 'IMPLIES (list 'IN 'gkv_ s) (list 'IN 'gkv_ sup)))
      (lambda () (let ((z (dk-di-var!))) (fact 'subset-mem-fwd s sup z) (ass))))
    (dk-have! (list 'AND (list 'IN s 'SET) (list 'FORALL 'gkv_ (list 'IMPLIES (list 'IN 'gkv_ s) (list 'IN 'gkv_ sup)))))
    (dk-apply! cs s)))

;;; PROP. 1.28 (LAGRANGE): for a subgroup H of a finite group G, card G = card H x card(G/H).  The bijection
;;; G -> G/H x H, x |-> (xH, r(xH)^-1 x), r(c) = CHOICE(c) the chosen representative of the coset c.
(sp (make-wff (forall-guarded '(gg hh) '((IS-GROUP gg) (IS-SUBGROUP gg hh) (IN (CARD (CARR gg)) NN))
  '(= (CARD (CARR gg)) (* (CARD hh) (CARD (LEFT-COSETS gg hh)))))))
(dk-peel!)
(gk-sub-parts! 'gg 'hh)
(let* ((c '(CARR gg)) (q (gk-coss 'gg 'hh)) (qs (gk-coss-sep 'gg 'hh)) (cq (list 'CARTESIAN q 'hh))
       (cx (lambda (x) (gk-cos 'gg x 'hh)))
       (rx (lambda (x) (list 'CHOICE (gk-cos 'gg x 'hh))))
       (sx (lambda (x) (gk-op 'gg (gk-inv 'gg (rx x)) x)))
       (phi (list 'VNB-LAMBDA 'lgx_ c (list 'LIST (cx 'lgx_) (sx 'lgx_))))
       (cos-set! (lambda (x)
                   ;; x in G: xH is a subset of G and a set, in G/H; x in xH; r(xH) in xH and in G
                   (let* ((cxx (cx x)) (sep (gk-cos-sep 'gg x 'hh)))
                     (dk-cite! 'left-coset-unfold 'gg x 'hh)
                     (ma-sep-subset! sep)
                     (dk-have! (list 'SUBSET cxx c) (lambda () (subst (list '= cxx sep)) (ass)))
                     (fact 'subclass-of-set-is-set cxx c)
                     (fact 'group-identity-in 'gg)
                     (dk-apply! (dk-cite! 'left-coset-member) 'gg x 'hh (gk-e 'gg))
                     (dk-split-all! (list (dk-apply! (dk-cite! 'group-right-inv-id) 'gg x)))
                     (dk-rewrite-h! (list 'IN (gk-op 'gg x (gk-e 'gg)) cxx) (gk-op 'gg x (gk-e 'gg)) x)
                     (dk-have! (list 'FORSOME 'cv_ (list 'IN 'cv_ cxx)) (lambda () (ew x) (ass)))
                     (fact 'choice-axiom cxx)
                     (fact 'subset-mem-fwd cxx c (rx x))
                     (dk-cite! 'left-cosets-unfold 'gg 'hh)
                     (dk-have! (list 'IN cxx q)
                       (lambda ()
                         (subst (list '= q qs))
                         (ma-iff-parts! (dk-cite! 'subset-def cxx c))
                         (in-sep!
                           (lambda ()
                             (ma-iff-back! (dk-cite! 'power-set-membership c cxx)))
                           (lambda () (ew x) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl))))))))
                     ;; r(xH) = x y0, y0 in H; r(xH)^-1 x = y0^-1 in H
                     (let* ((rv (dk-name! (rx x) c))
                            (m0 (dk-rewrite-h! (list 'IN (rx x) cxx) (rx x) rv))
                            (m (dk-rewrite-h! m0 cxx sep))
                            (y0 (dk-skolem! (ma-sep-parts! m))))
                       (gk-in-carr! 'gg 'hh y0)
                       (fact 'group-inv-in 'gg y0) (fact 'group-inv-in 'gg rv) (fact 'group-inv-in 'gg (rx x))
                       (gk-sub-inv! 'gg 'hh y0)
                       (dk-split-all! (list (dk-apply! (dk-cite! 'group-right-inv-id) 'gg y0)))
                       (dk-cite! 'group-assoc 'gg x y0 (gk-inv 'gg y0))
                       (dk-have! (list '= x (gk-op 'gg rv (gk-inv 'gg y0)))
                         (lambda ()
                           (subst (list '= rv (gk-op 'gg x y0)))
                           (subst (list '= (gk-op 'gg (gk-op 'gg x y0) (gk-inv 'gg y0)) (gk-op 'gg x (gk-op 'gg y0 (gk-inv 'gg y0)))))
                           (subst (list '= (gk-op 'gg y0 (gk-inv 'gg y0)) (gk-e 'gg)))
                           (subst (list '= (gk-op 'gg x (gk-e 'gg)) x))
                           (gk-rfl!)))
                       (dk-split-all! (list (dk-apply! (dk-cite! 'group-inv-cancel) 'gg rv (gk-inv 'gg y0))))
                       (dk-have! (list 'IN (gk-op 'gg (gk-inv 'gg rv) x) 'hh)
                         (lambda ()
                           (subst (list '= x (gk-op 'gg rv (gk-inv 'gg y0))))
                           (subst (list '= (gk-op 'gg (gk-inv 'gg rv) (gk-op 'gg rv (gk-inv 'gg y0))) (gk-inv 'gg y0)))
                           (ass)))
                       (dk-rewrite-h! (list 'IN (gk-op 'gg (gk-inv 'gg rv) x) 'hh) rv (rx x))))))
       (val! (lambda (x) (dk-have! (list '= (list phi x) (list 'LIST (cx x) (sx x))) (lambda () (let ((leaf (proof-state-focus *ps*))) (dk-lam-b!) (if (not (sequent-node-grounded? leaf)) (rfl))))))))
  ;; finiteness
  (dk-project! '(IN (CARR gg) SET) 'is-group '(IS-GROUP gg))
  (gk-fin! 'hh c)
  (fact 'power-set c)
  (dk-have! (list 'AND (list 'IN c 'SET) (list 'IN (list 'CARD c) 'NN))) (fact 'card-power-nn c)
  (dk-cite! 'left-cosets-unfold 'gg 'hh)
  (ma-sep-subset! qs)
  (dk-have! (list 'SUBSET q (list 'POWER c)) (lambda () (subst (list '= q qs)) (ass)))
  (gk-fin! q (list 'POWER c))
  ;; the bijection
  (let* ((iff (dk-cite! 'bijection-membership-iff c cq phi)) (rhs (caddr iff)))
    (dk-have! (cadr rhs)
      (lambda ()
        (dk-lam-type!
          (lambda () (let ((x (dk-di-var!))) (cos-set! x) (dk-apply! (dk-cite! 'pair-in-cartesian) q 'hh (cx x) (sx x)) (ass)))
          (lambda () (ass)))))
    (dk-have! (cadr (caddr rhs))
      (lambda ()
        (dk-peel!)
        (let* ((g (dk-goal)) (a (cadr g)) (b (caddr g)))
          (cos-set! a) (cos-set! b) (val! a) (val! b)
          (let* ((h (dk-rewrite-h! (dk-rewrite-h! (dk-ctx-form (list '= (list phi a) (list phi b))) (list phi a) (list 'LIST (cx a) (sx a))) (list phi b) (list 'LIST (cx b) (sx b)))))
            (dk-split-all! (list (dk-apply! (dk-cite! 'node-pair-injective) (cx a) (sx a) (cx b) (sx b))))
            (let ((h2 (dk-rewrite-h! (list '= (sx a) (sx b)) (cx b) (cx a))))
              (dk-apply! (dk-cite! 'group-cancel-left) 'gg a 'b (gk-inv 'gg (rx a)))
              (ass))))))
    (dk-have! (caddr (caddr rhs))
      (lambda ()
        (let* ((w (dk-di-var!)) (w1 (list 'NTH 1 w)) (w2 (list 'NTH 2 w)))
          (ma-iff-parts! (dk-cite! 'cartesian-membership-nth q 'hh w))
          (gk-in-carr! 'gg 'hh w2)
          (let* ((m (dk-rewrite-h! (list 'IN w1 q) q qs))
                 (a (dk-skolem! (ma-sep-parts! m))))
            (cos-set! a)
            (let* ((r (rx a)) (x (gk-op 'gg r w2)))
              (fact 'group-carrier-closed-opr 'gg r w2)
              ;; x lies in aH, so xH = aH = w1
              (let* ((rv (dk-name! r c))
                     (ma (dk-rewrite-h! (dk-rewrite-h! (list 'IN r (cx a)) r rv) (cx a) (gk-cos-sep 'gg a 'hh)))
                     (y1 (dk-skolem! (ma-sep-parts! ma))))
                (gk-in-carr! 'gg 'hh y1)
                (gk-sub-op! 'gg 'hh y1 w2)
                (dk-apply! (dk-cite! 'left-coset-member) 'gg a 'hh (gk-op 'gg y1 w2))
                (dk-cite! 'group-assoc 'gg a y1 w2)
                (dk-have! (list 'IN x (cx a))
                  (lambda ()
                    (subst (list '= r rv))
                    (subst (list '= rv (gk-op 'gg a y1)))
                    (subst (list '= (gk-op 'gg (gk-op 'gg a y1) w2) (gk-op 'gg a (gk-op 'gg y1 w2))))
                    (ass))))
              (dk-apply! (dk-cite! 'left-coset-eq) 'gg 'hh a x)
              (cos-set! x)
              (val! x)
              (dk-split-all! (list (dk-apply! (dk-cite! 'group-inv-cancel) 'gg r w2)))
              (ew x)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin
                        (subst (list '= (list phi x) (list 'LIST (cx x) (sx x))))
                        (subst (list '= (cx x) (cx a)))
                        (subst (list '= (gk-op 'gg (gk-inv 'gg r) (gk-op 'gg r w2)) w2))
                        (subst (list '= (cx a) w1))
                        (subst (list '= (list 'LIST w1 w2) w))
                        (gk-rfl!))))))))))
    (ma-iff-back! iff))
  (dk-apply! (dk-cite! 'card-bijection-eq) c cq phi)
  (dk-have! (list 'AND (list 'IN q 'SET) (list 'IN (list 'CARD q) 'NN)))
  (dk-apply! (dk-cite! 'card-cartesian q) 'hh)
  (subst (list '= (list 'CARD c) (list 'CARD cq)))
  (subst (list '= (list 'CARD cq) (list '* (list 'CARD q) '(CARD hh))))
  (crs))
(qed 'lagrange)

;;; the subgroup generated by x is a subgroup holding x
(define (gk-gen-sep g x) (list 'SEP 'gcy_ (list 'CARR g) (list 'FORALL 'gcs_ (list 'IMPLIES (list 'IN 'gcs_ (list 'POWER (list 'CARR g)))
  (list 'IMPLIES (list 'IS-SUBGROUP g 'gcs_) (list 'IMPLIES (list 'IN x 'gcs_) (list 'IN 'gcy_ 'gcs_)))))))
(sp (make-wff (list 'FORALL 'g (list 'FORALL 'x (list '== (list 'GENERATED-SUBGROUP 'g 'x) (gk-gen-sep 'g 'x))))))
(dk-peel!) (mac 'GENERATED-SUBGROUP) (qrfl)
(qed 'generated-subgroup-unfold)
(sp (make-wff (forall-guarded '(g x) '((IS-GROUP g) (IN x (CARR g))) '(AND (IS-SUBGROUP g (GENERATED-SUBGROUP g x)) (IN x (GENERATED-SUBGROUP g x))))))
(dk-peel!)
(fact 'group-identity-in 'g)
(let* ((s (gk-gen-sep 'g 'x))
       (inall! (lambda (y)
                 ;; prove (IN y s) from (IN y CARR) and a thunk proving (IN y t) for a subgroup t holding x
                 #t))
       (cond-of (lambda (y) (list 'FORALL 'gcs_ (list 'IMPLIES (list 'IN 'gcs_ (list 'POWER '(CARR g))) (list 'IMPLIES (list 'IS-SUBGROUP 'g 'gcs_) (list 'IMPLIES '(IN x gcs_) (list 'IN y 'gcs_)))))))
       (prove-in! (lambda (y body!)
                    ;; goal-free: land (IN y s); body! gets the peeled subgroup t
                    (dk-have! (list 'IN y s)
                      (lambda ()
                        (in-sep! dk-ass!
                          (lambda ()
                            (dk-peel!)
                            (let ((t (caddr (dk-goal))))
                              (body! t)))))))))
  (subst (dk-cite! 'generated-subgroup-unfold 'g 'x))
  (ma-sep-subset! s)
  (prove-in! (gk-e 'g) (lambda (t) (dk-landed (lambda () (mac-h 'is-subgroup (list 'IS-SUBGROUP 'g t)))) (vnb-guard (lambda () (dk-split-all!))) (ass)))
  (prove-in! 'x (lambda (t) (ass)))
  (dk-have! (list 'FORALL 'sga_ (list 'IMPLIES (list 'IN 'sga_ s) (list 'FORALL 'sgb_ (list 'IMPLIES (list 'IN 'sgb_ s) (list 'IN (gk-op 'g 'sga_ 'sgb_) s)))))
    (lambda ()
      (dk-peel!)
      (let* ((gp (cadr (dk-goal))) (a (cadr gp)) (b (caddr gp)))
        (ma-sep-parts! (list 'IN a s)) (ma-sep-parts! (list 'IN b s))
        (fact 'group-carrier-closed-opr 'g a b)
        (in-sep! dk-ass!
          (lambda ()
            (dk-peel!)
            (let ((t (caddr (dk-goal))))
              (gk-sub-parts! 'g t)
              (dk-apply! (dk-ctx-form (cond-of a)) t)
              (dk-apply! (dk-ctx-form (cond-of b)) t)
              (gk-sub-op! 'g t a b)
              (ass)))))))
  (dk-have! (list 'FORALL 'sga_ (list 'IMPLIES (list 'IN 'sga_ s) (list 'IN (gk-inv 'g 'sga_) s)))
    (lambda ()
      (let ((a (dk-di-var!)))
        (ma-sep-parts! (list 'IN a s))
        (fact 'group-inv-in 'g a)
        (in-sep! dk-ass!
          (lambda ()
            (dk-peel!)
            (let ((t (caddr (dk-goal))))
              (gk-sub-parts! 'g t)
              (dk-apply! (dk-ctx-form (cond-of a)) t)
              (gk-sub-inv! 'g t a)
              (ass)))))))
  (dk-have! (list 'IS-SUBGROUP 'g s) (lambda () (mac 'is-subgroup) (dk-conj-close! dk-ass!)))
  (dk-conj-close! dk-ass!))
(qed 'generated-subgroup-is-subgroup)

;;; COR. 1.29: in a finite group, the cardinality of the subgroup generated by x divides the cardinality of G
(sp (make-wff (forall-guarded '(g x) '((IS-GROUP g) (IN (CARD (CARR g)) NN) (IN x (CARR g)))
  '(ZZ-DIVIDES (CARD (GENERATED-SUBGROUP g x)) (CARD (CARR g))))))
(dk-peel!)
(let* ((gs '(GENERATED-SUBGROUP g x)) (c '(CARR g)) (q (gk-coss 'g gs)) (qs (gk-coss-sep 'g gs)))
  (dk-split-all! (list (dk-apply! (dk-cite! 'generated-subgroup-is-subgroup) 'g 'x)))
  (gk-sub-parts! 'g gs)
  (dk-project! '(IN (CARR g) SET) 'is-group '(IS-GROUP g))
  (gk-fin! gs c)
  (fact 'power-set c)
  (dk-have! (list 'AND (list 'IN c 'SET) (list 'IN (list 'CARD c) 'NN))) (fact 'card-power-nn c)
  (dk-cite! 'left-cosets-unfold 'g gs)
  (ma-sep-subset! qs)
  (dk-have! (list 'SUBSET q (list 'POWER c)) (lambda () (subst (list '= q qs)) (ass)))
  (gk-fin! q (list 'POWER c))
  (dk-apply! (dk-cite! 'lagrange) 'g gs)
  (ma-for-each (lambda (t) (dk-type! t 'ZZ)) (list (list 'CARD gs) (list 'CARD c) (list 'CARD q)))
  (mac 'zz-divides)
  (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew (list 'CARD q)) (dk-conj-close! dk-ass!))))))
(qed 'lagrange-element-order)

