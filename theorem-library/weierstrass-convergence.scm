(dk-rewrite-h! '(IN wcvq_ (PTS RR-MS)) '(PTS RR-MS) 'RR)
(define wcv-3-clause
  (dk-pick (lambda (f) (and (wcv-op? f 'FORALL 3) (dk-contains? f 'DIST))) "the eps clause"))
(let* ((ex (dk-apply! wcv-3-clause 'wcve_))
       (n (dk-skolem! ex 'top))
       (inner (dk-pick (lambda (f) (and (wcv-op? f 'FORALL 3) (dk-contains? f 'DIST) (dk-contains? f n))) "the tail clause")))
  (ew n)
