      (FORALL wcvj_ (IMPLIES (IN wcvj_ NN) (IMPLIES (<= wcvn_ wcvj_)
        (<= (ABS (- (wcvb_ (wcvg_ wcvj_)) wcvq_)) wcve_)))))))))))))))
