    (let* ((h (dk-di-var!))
           (_1 (dk-rewrite-h! (list 'IN h (list 'FUN 'NN (list 'PTS wcv-S))) (list 'PTS wcv-S) wcv-D))
           (bre '(+ (ABS (real-part wcvc_)) wcvr_))
