(define (wcv-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (wcv-first-of l)
  (if (null? l) (error "wcv: a landing expected by the driver is missing; the goal" (expression->string (dk-goal))) (car l)))
(define (wcv-need f what)
  (if (not (dk-asm? f)) (error (string-append "wcv: missing " what) (expression->string f)))
  f)
(define (wcv-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (wcv-pts-cc!)
  (if (not (dk-asm? '(== (PTS CC-MS) CC)))
      (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (wcv-pts-rr!)
  (if (not (dk-asm? '(== (PTS RR-MS) RR)))
      (dk-have! '(== (PTS RR-MS) RR) (lambda () (slot 'PTS) (qrfl)))))
;;; (IN t RR) for a real-part / imag-part / abs / difference / sum term of typed atoms
(define (wcv-rr! t)
  (let ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((wcv-op? t 'real-part 2) (wcv-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((wcv-op? t 'imag-part 2) (wcv-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((wcv-op? t 'magnitude 2) (wcv-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((wcv-op? t 'ABS 2) (wcv-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((wcv-op? t '- 3) (wcv-rr! (cadr t)) (wcv-rr! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((wcv-op? t '+ 3) (wcv-rr! (cadr t)) (wcv-rr! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          (#t (dk-type! t 'RR)))))
(define (wcv-cc! t)
  (let ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((wcv-op? t '- 3) (wcv-cc! (cadr t)) (wcv-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((wcv-op? t '+ 3) (wcv-cc! (cadr t)) (wcv-cc! (caddr t))
           (wcv-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((wcv-op? t '* 3) (wcv-cc! (cadr t)) (wcv-cc! (caddr t))
           (wcv-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((dk-asm? (list 'IN t 'RR)) (fact 'rr-subset-cc t) typ)
          (#t (dk-type! t 'CC)))))

