                                        (lambda () (dk-ineq! (list '< (list 'magnitude (list '- y z)) s) (list '< s2 s) (list '= (list '+ s s) d1) (list '= (list '+ d1 d1) rho) (list '< 0 s))))
                                      (wcv-ball-in-ball! y s2 z rho)
