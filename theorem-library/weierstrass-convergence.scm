(define (wcv-part-bound! sel dist-thm)
  (let* ((x (list sel 'wcvz_)) (y (list sel 'wcvc_)) (xy (list '- x y)))
    (wcv-rr! x) (wcv-rr! y) (wcv-rr! xy)
    (wcv-rr! (list 'ABS xy)) (wcv-rr! (list 'ABS y)) (wcv-rr! (list 'ABS x))
    (wcv-rr! '(magnitude (- wcvz_ wcvc_)))
    (fact dist-thm 'wcvz_ 'wcvc_)
    (wcv-and! (list 'IN xy 'RR) (list 'IN y 'RR))
    (let ((tri (dk-cite! 'rr-abs-triangle xy y)))
      (dk-have! (list '= (list '+ xy y) x) (lambda () (crs)))
      (dk-rewrite-h! tri (list '+ xy y) x)
      (dk-have! (list '<= (list 'ABS x) (list '+ (list 'ABS y) 'wcvr_))
        (lambda ()
          (dk-ineq! (list '<= (list 'ABS x) (list '+ (list 'ABS xy) (list 'ABS y)))
                    (list '<= (list 'ABS xy) '(magnitude (- wcvz_ wcvc_)))
                    '(<= (magnitude (- wcvz_ wcvc_)) wcvr_)))))))

