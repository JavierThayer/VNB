(sp (make-wff '(FORALL wcvb_ (FORALL wcvg_ (IMPLIES (STRICTLY-MONO-NN wcvg_) (FORALL wcvq_
  (IMPLIES (CONVERGES-TO RR-MS (SUBSEQ wcvb_ wcvg_) wcvq_)
