;;; weierstrass-convergence.scm -- UNIFORM CONVERGENCE ON COMPACT SUBSETS AND
;;; PROPOSITION 3.44 OF complex-analysis.pdf (with Weierstrass's complement: the
;;; derivatives converge too).  Agent CA-AC, 2026-10-14.
;;; Vocabulary: structure-library/ca-ac-vocab.scm (UNIF-ON-COMPACTA, new; the user's to confirm).
;;;
;;; CONTENTS.
;;;  (1) cc-closed-ball-mem, cc-closed-ball-mem-intro   z in CB(c, r) <=> z in CC and |z - c| <= r
;;;  (2) cc-parts-bound-of-dist          |z - c| <= r => |Re z| <= |Re c| + r and |Im z| <= |Im c| + r
;;;  (3) rr-subseq-converges-abs         CONVERGES-TO(RR-MS, SUBSEQ(b, g), q) in absolute-value form
;;;                                      at the indices g(j)
;;;  (4) cc-closed-ball-compact          HEINE-BOREL FOR A CLOSED DISC OF CC:
;;;                                      IS-COMPACT(SUBSPACE-MS(CC-MS, CLOSED-BALL(CC-MS, c, r)))
;;;  (5) unif-on-compacta-locally        on an open u: uniform convergence on the compact subsets
;;;                                      gives the LOCALLY uniform convergence of morera.scm
;;;  (6) holomorphic-limit-on-compacta   PROPOSITION 3.44
;;;  (7) compact-cover-by-balls          a compact K inside CC is covered by finitely many of the
;;;                                      balls B(x, h(x)), x in K, for any radius function h > 0
;;;  (8) locally-uniform-on-compacta     the converse of (5) (u inside CC)
;;;  (9) holomorphic-limit-derivatives   the derivatives converge to the derivative of the limit,
;;;                                      uniformly on the compact subsets
;;;
;;; THE ROUTES.
;;; * (4): Bolzano-Weierstrass twice (rr-bolzano-weierstrass, on the real parts and then on the
;;;   imaginary parts of the first subsequence), the limit L = p + q i, |h(phi(psi j)) - L| <=
;;;   |Re - p| + |Im - q| (cc-dist-le-coords); L lies in the disc (rr-le-of-le-add-all-pos) and is a
;;;   CLUSTER POINT of h (the index phi(psi(m + N)) is >= m: strictly-mono-ge-id twice), so
;;;   compact-iff-cluster-point gives compactness.  No composition of subsequences is formed.
;;; * (6): the notes prove 3.44 from Morera (3.43) through the triangle integrals; the tree already
;;;   has that argument for LOCALLY uniform convergence (morera.scm, holomorphic-uniform-limit), and
;;;   on an open set of CC uniform convergence on compacta gives it by (4) and (5): about each
;;;   point the closed disc CB(z, rho/2) is compact and inside u.
;;; * (9): about z, B(z, 4s) inside u; for y in B(z, s) Cauchy's estimate (cauchy-estimate-derivative,
;;;   k = 1) for fam(k) - f on the circle C(y, s), which lies in the compact disc CB(z, 2s), bounds
;;;   |fam(k)'(y) - f'(y)| by (sup on the circle)/s; the derivative of the difference is read by
;;;   dk-diff!, moved to the small ball by diff-on-shrink, and identified with the first
;;;   NTH-DERIV-ON; then (8).
;;;
;;; NOTHING asserted, no support, no stamp.  Helper prefixes wcv- and wcx- (wcx-: the cie- helpers
;;; of cauchy-estimates.scm, copied: a helper is local to its file); theorem binders wcv*_ and the
;;; binders of the cited theorems where an instance must match (u, fam, f, eps, k, aicap_, aiy_,
;;; mrlz_, mrlr_).

(define wcx-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (wcx-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (wcx-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u)
    (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS wcx-nfm u) wcx-nfm f 'rgy_))))
(define (wcx-imps hyps body)
  (if (null? hyps) body (list 'IMPLIES (car hyps) (wcx-imps (cdr hyps) body))))
(define (wcx-all vars body)
  (if (null? vars) body (list 'FORALL (car vars) (wcx-all (cdr vars) body))))
(define (wcx-and! a b)
  (let* ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (wcx-pz z) (list 'DIFFERENCE 'CC (list 'SINGLETON z)))

(define (wcx-rr! t)
  (let* ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((eq? t 'PI) (dk-split-all! (list (dk-cite! 'pi-pos))) typ)
          ((number? t) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((wcx-op? t 'succ 2) (wcx-nn! t) (fact 'nn-in-rr t) typ)
          ((wcx-op? t '* 3) (wcx-rr! (cadr t)) (wcx-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((wcx-op? t '+ 3) (wcx-rr! (cadr t)) (wcx-rr! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((wcx-op? t '- 3) (wcx-rr! (cadr t)) (wcx-rr! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((wcx-op? t '- 2) (wcx-rr! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((wcx-op? t 'magnitude 2) (wcx-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((wcx-op? t 'real-part 2) (wcx-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((wcx-op? t 'imag-part 2) (wcx-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((wcx-op? t 'abs 2) (wcx-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((wcx-op? t 'recip 2)
           (wcx-rr! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (if (dk-asm? (list '< 0 (cadr t)))
                   (fact 'rr-pos-ne-zero (cadr t))
                   (error "wcx-rr!: land the non-vanishing first" (expression->string (cadr t)))))
           (wcx-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t))
           typ)
          (#t (dk-real! t) typ))))
(define (wcx-nn! t)
  (let* ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((wcx-op? t 'succ 2) (wcx-nn! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          (#t (dk-type! t 'NN)))))
(define (wcx-cc! t)
  (let* ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((or (and (number? t) (real? t)) (eq? t 'PI) (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
               (wcx-op? t 'succ 2)
               (wcx-op? t 'magnitude 2) (wcx-op? t 'real-part 2) (wcx-op? t 'imag-part 2))
           (wcx-rr! t) (fact 'rr-subset-cc t) typ)
          ((wcx-op? t '- 3) (wcx-cc! (cadr t)) (wcx-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((wcx-op? t '- 2) (wcx-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((wcx-op? t '+ 3) (wcx-cc! (cadr t)) (wcx-cc! (caddr t))
           (wcx-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((wcx-op? t '* 3) (wcx-cc! (cadr t)) (wcx-cc! (caddr t))
           (wcx-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((wcx-op? t 'power 3) (wcx-cc! (cadr t)) (wcx-nn! (caddr t))
           (wcx-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((wcx-op? t 'CC-EXP 2) (wcx-cc! (cadr t))
           (dk-split-all! (list (dk-cite! 'cc-exp-converges (cadr t)))) typ)
          ((wcx-op? t 'recip 2) (wcx-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "wcx-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (wcx-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (dk-type! t 'CC)))))

;;; y in CC \ {z}: land y in CC, y /= z, y - z /= 0
(define (wcx-sub-nz! y z)
  (let* ((nz (list 'NOT (list '= (list '- y z) 0))))
    (dk-have! nz
      (lambda ()
        (di)
        (dk-cite! 'cc-sub-zero-eq y z)
        (ai (dk-ctx-form (list 'NOT (list '= y z))))))
    nz))
(define (wcx-steps . thunks)
  ;; run THUNKS in order while the leaf focused at the start stays open
  (let* ((leaf (proof-state-focus *ps*)))
    (let loop ((ts thunks))
      (if (and (pair? ts) (not (sequent-node-grounded? leaf)))
          (begin ((car ts)) (loop (cdr ts)))))))
(define (wcx-pz-open! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (wcx-steps
      (lambda () (dk-have! (list 'IN y 'CC) (lambda () (wcx-only-prop! iff (list 'IN y (wcx-pz z))))))
      (lambda () (dk-have! (list 'NOT (list '= y z)) (lambda () (wcx-only-prop! iff (list 'IN y (wcx-pz z))))))
      (lambda () (wcx-sub-nz! y z)))))
(define (wcx-pz-in! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (dk-have! (list 'IN y (wcx-pz z))
      (lambda () (wcx-only-prop! iff (list 'IN y 'CC) (list 'NOT (list '= y z)))))))
;;; the punctured plane: open (both spellings), a set
(define (wcx-pz-setup! z)
  (let* ((d (wcx-pz z)))
    (fact 'nf-cc-is-metric-space)
    (dk-cite! 'cc-punctured-open z)
    (let* ((iff (dk-cite! 'cc-ms-open-iff d)))
      (dk-have! (list 'IS-OPEN wcx-nfm d) (lambda () (wcx-only-prop! iff (list 'IS-OPEN 'CC-MS d)))))
    (fact 'cc-is-set)
    (dk-cite! 'difference-set 'CC (list 'SINGLETON z))
    (dk-cite! 'cc-open-subset-cc d)))
;;; (wcx-lam-typ! LAM DOM TYPER) -- LAM in FUN(DOM, CC); TYPER of the eigenvariable
(define (wcx-lam-typ! lam dom pre)
  (dk-have! (list 'IN lam (list 'FUN dom 'CC))
    (lambda ()
      (dk-lam-type! (lambda ()
                      (let* ((v (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                        (wcx-steps
                          (lambda () (pre v))
                          (lambda () (if (dk--redex? (dk-goal)) (dk-lam-b!)))
                          (lambda () (if (not (dk-asm? (dk-goal))) (wcx-cc! (cadr (dk-goal)))))
                          (lambda () (ass)))))))))
;;; detach an implication whose antecedent THUNK proves
(define (wcx-detach! imp thunk)
  (if (and (pair? imp) (eq? (car imp) 'IMPLIES))
      (begin (dk-have! (cadr imp) thunk)
             (dk-landed-1 (lambda () (detach! imp))))
      imp))
(define (wcx-only-prop! . fs) (if (apply dk-only! fs) (prop)))
(define (wcx-lam-b-if!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
;;; subst, then ass on the SAME leaf unless the subst closed it
(define (wcx-subst-ass! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; 2 pi i: in CC and non-zero, its reciprocal in CC
(define wcx-tpi '(* (* 2 PI) +i))
(define (wcx-tpi!)
  (wcx-rr! '(* 2 PI))
  (dk-have! '(< 0 (* 2 PI)) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'rr-pos-ne-zero '(* 2 PI))
  (wcx-cc! '(* 2 PI))
  (fact 'cc-i-in)
  (dk-have! '(NOT (= +i 0))
    (lambda ()
      (di)
      (fact 'cc-i-squared)
      (dk-have! '(= (* 0 0) -1) (lambda () (subst '(= 0 +i)) (ass)))
      (dk-have! '(NOT (= (* 0 0) -1)) (lambda () (arith)))
      (ai '(NOT (= (* 0 0) -1)))))
  (dk-cite! 'cc-mul-nonzero '(* 2 PI) +i)
  (wcx-cc! wcx-tpi)
  (wcx-cc! (list 'recip wcx-tpi))
  (wcx-and! (list 'IN wcx-tpi 'CC) (list 'NOT (list '= wcx-tpi 0)))
  (dk-cite! 'cc-recip-inverse wcx-tpi))
;;; x in CC, c in CC, s in RR, |x - c| < s in context: land x in BALL(CC-MS, c, s)
(define (wcx-in-ball! x c s)
  (let* ((m (list 'magnitude (list '- x c))))
    (fact 'cc-is-metric-space)
    (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
    (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (dk-have! (list 'IN c '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (wcx-rr! m)
    (dk-cite! 'cc-ms-dist c x)
    (dk-cite! 'cc-magnitude-sub-sym c x)
    (dk-have! (list '<= (list '(DIST CC-MS) c x) m)
      (lambda ()
        (subst (list '= (list '(DIST CC-MS) c x) (list 'magnitude (list '- c x))))
        (if (not (equal? c x)) (subst (list '= (list 'magnitude (list '- c x)) m)))
        (dk-ineq!)))
    (let* ((cj (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list 'IN m 'RR) (list 'AND (list 'IN s 'RR)
                (list 'AND (list '<= (list '(DIST CC-MS) c x) m) (list '< m s)))))))
      (dk-have! cj (lambda () (dk-conj-close! dk-ass!)))
      (dk-cite! 'ball-mem-from-le 'CC-MS c x m s))))
;;; subst EQ in a == goal, then qrfl on the same leaf unless the subst closed it
(define (wcx-subst-qrfl! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (qrfl))))
;;; x in BALL(CC-MS, c, r) in context: land x in CC and |x - c| < r; return the latter
(define (wcx-ball-open! c r x)
  ;; x in BALL(CC-MS, c, r) in context: land x in CC and |x - c| < r (stops early when a
  ;; landing closes the focus leaf, the claim being the goal)
  (let* ((dcx (list '(DIST CC-MS) c x))
         (mag (list 'magnitude (list '- c x)))
         (mag2 (list 'magnitude (list '- x c)))
         (cj  (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list '<= dcx r) (list 'NOT (list '= dcx r))))))
    (wcx-steps
      (lambda () (fact 'cc-is-metric-space))
      (lambda () (let* ((iff (dk-cite! 'ball-membership 'CC-MS c r x)))
                   (dk-have! cj (lambda () (wcx-only-prop! iff (list 'IN x (list 'BALL 'CC-MS c r)))))))
      (lambda () (dk-split-all! (list (dk-ctx-form cj))))
      (lambda () (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl))))
      (lambda () (dk-have! (list 'IN x 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass))))
      (lambda () (dk-cite! 'cc-ms-dist c x))
      (lambda () (wcx-rr! mag))
      (lambda () (wcx-rr! mag2))
      (lambda () (dk-cite! 'cc-magnitude-sub-sym c x))
      (lambda () (dk-have! (list 'AND (list '<= mag r) (list 'NOT (list '= mag r)))
                   (lambda () (subst (list '= mag dcx)) (dk-conj-close! dk-ass!))))
      (lambda () (dk-cite! 'rr-le-ne-lt mag r))
      (lambda () (dk-have! (list '< mag2 r) (lambda () (dk-ineq! (list '< mag r) (list '= mag mag2))))))))

(define (wcx-subst-sym e from to)
  (cond ((eq? e from) to)
        ((pair? e) (cons (wcx-subst-sym (car e) from to) (wcx-subst-sym (cdr e) from to)))
        (#t e)))
;;; a point x of the trace, the trace already known inside CC \ {c} (and CC \ {z} ...):
;;; land x in CC, x /= c, x - c /= 0 (the same for each z in ZS)
(define (wcx-tpt! x . zs)
  (wcx-steps
    (lambda () (fact 'subset-mem-fwd wcx-T (wcx-pz 'c) x))
    (lambda () (wcx-pz-open! 'c x))
    (lambda () (for-each (lambda (z) (fact 'subset-mem-fwd wcx-T (wcx-pz z) x) (wcx-pz-open! z x)) zs))))
(define (wcx-dump-open!)
  (for-each (lambda (l) (display "\n;; OPEN: ") (display (expression->string (dk-goal-of l)))) (dk-open-leaves)))
(define (wcx-center-in-ball! a r)
  ;; a in CC, r in RR, 0 < r: land a in BALL(CC-MS, a, r) (which also certifies the ball DEFINED)
  (let* ((d (list '- a a)) (m (list 'magnitude d)))
    (wcx-rr! m)
    (wcx-cc! d)
    (dk-have! (list '= d 0) (lambda () (crs)))
    (let ((iff (dk-cite! 'cc-magnitude-zero-iff d)))
      (dk-have! (list '= m 0) (lambda () (wcx-only-prop! iff (list '= d 0)))))
    (dk-have! (list '< m r) (lambda () (dk-ineq! (list '= m 0) (list '< 0 r))))
    (wcx-in-ball! a a r)))

(define (wcx-R c) (list 'VNB-LAMBDA 'cifv_ (wcx-pz c) (list 'recip (list '- 'cifv_ c))))
(define (wcx-S c) (list 'VNB-LAMBDA 'cifv_ (wcx-pz c) (list '- 'cifv_ c)))
(define (wcx-P c n) (list 'VNB-LAMBDA 'cifv_ (wcx-pz c) (list 'power (list 'recip (list '- 'cifv_ c)) n)))
(define (wcx-sq-recip w c) (list '* (list 'recip (list '- w c)) (list 'recip (list '- w c))))
(define (wcx-pd-goal j)
  (list 'FORALL 'cifc_ (list 'IMPLIES '(IN cifc_ CC)
    (list 'FORALL 'cifw_ (list 'IMPLIES (list 'IN 'cifw_ (wcx-pz 'cifc_))
      (list 'IS-DIFF-ON 'CC-NORMED-FIELD (wcx-pz 'cifc_) (wcx-P 'cifc_ (list 'succ j)) 'cifw_
            (list '* (list '- (list 'succ j)) (list 'power (list 'recip (list '- 'cifw_ 'cifc_)) (list 'succ (list 'succ j))))))))))
(define (wcx-pow-succ! a n)
  (wcx-cc! a) (wcx-nn! n)
  (wcx-and! (list 'IN a 'CC) (list 'IN n 'NN))
  (dk-cite! 'power-succ a n))
(define (wcx-carr-typ! lam d)
  (fact 'cc-nf-carr)
  (dk-have! (list 'IN lam (list 'FUN d '(CARR CC-NORMED-FIELD)))
    (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass))))
(define wcx-tp '(* 2 PI))
(define wcx-I (list 'CCINT 0 wcx-tp))
(define wcx-C '(CIRCLE-PATH c r))
(define wcx-Cd '(CIRCLE-DERIV c r))
(define wcx-T (list 'TRACE wcx-C 0 wcx-tp))
(define (wcx-kern z) (list 'VNB-LAMBDA 'wnw_ (wcx-pz z) (list 'recip (list '- 'wnw_ z))))
(define (wcx-in-I! v)
  (dk-have! (list 'IN v wcx-I)
    (lambda () (mac 'ccint-membership)
               (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 0 wcx-tp) '(< 0 PI))))))))
(define (wcx-circle-basics!)
  (fact 'rr-zero-in)
  (wcx-rr! wcx-tp)
  (dk-have! (list '< 0 wcx-tp) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'circle-is-road 'c 'r)
  (fact 'is-road-is-path wcx-C wcx-Cd 0 wcx-tp)
  (fact 'is-path-in-fun wcx-C 0 wcx-tp)
  (dk-cite! 'trace-subset-cc wcx-C 0 wcx-tp))
(define (wcx-circ-pt! y)
  ;; y in the trace of the circle (c, r in context, 0 < r): y in CC, |y - c| = r,
  ;; r <= |y - c|, y /= c, y - c /= 0, y in CC \ {c}
  (let* ((m (list 'magnitude (list '- y 'c))))
    (wcx-steps
      (lambda () (fact 'subset-mem-fwd wcx-T 'CC y))
      (lambda () (dk-cite! 'circle-trace-magnitude 'c 'r y))
      (lambda () (wcx-rr! m))
      (lambda () (dk-have! (list '<= 'r m) (lambda () (dk-ineq! (list '= m 'r)))))
      (lambda ()
        (dk-have! (list 'NOT (list '= y 'c))
          (lambda ()
            (di)
            (dk-have! (list '= m 0)
              (lambda () (subst (list '= y 'c))
                         (dk-have! '(= (- c c) 0) (lambda () (crs)))
                         (subst '(= (- c c) 0))
                         (fact 'cc-magnitude-zero)
                         (ass)))
            (dk-absurd! (list 'IN m 'RR) '(IN r RR) (list '= m 0) (list '= m 'r) '(< 0 r)))))
      (lambda () (wcx-sub-nz! y 'c))
      (lambda () (wcx-pz-in! 'c y)))))
(define (wcx-circ-not-z! y)
  ;; y in the trace, |z - c| < r: y /= z, y in CC \ {z}
  (wcx-steps
    (lambda ()
      (dk-have! (list 'NOT (list '= y 'z))
        (lambda ()
          (di)
          (dk-have! '(= (magnitude (- z c)) r)
            (lambda () (subst (list '= 'z y)) (ass)))
          (wcx-rr! '(magnitude (- z c)))
          (dk-absurd! '(IN (magnitude (- z c)) RR) '(IN r RR) '(= (magnitude (- z c)) r) '(< (magnitude (- z c)) r)))))
    (lambda () (wcx-sub-nz! y 'z))
    (lambda () (wcx-pz-in! 'z y))))
(define (wcx-Hk g k)
  (list 'VNB-LAMBDA 'aiw_ wcx-T (list '* (list g 'aiw_) (list 'power '(recip (- aiw_ c)) (list 'succ k)))))
(define (wcx-LI f) (list 'LINE-INT f wcx-C wcx-Cd 0 wcx-tp))
(define (wcx-trace-in-pz! p)
  (dk-have! (list 'SUBSET wcx-T (wcx-pz p))
    (lambda ()
      (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
        (wcx-circ-pt! y)
        (if (eq? p 'z) (wcx-circ-not-z! y))
        (if (not (sequent-node-grounded? leaf)) (ass))))))
