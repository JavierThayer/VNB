           ;; the real parts
           (as (list 'VNB-LAMBDA 'wcvk_ 'NN (list 'real-part (list h 'wcvk_)))))
      (wcv-rr! bre) (wcv-rr! bim)
      (wcv-rr-seq! as (lambda (k) (wcv-pt! h k) (wcv-rr! (list 'real-part (list h k)))))
      (dk-have! (list 'FORALL 'wcvi_ (list 'IMPLIES '(IN wcvi_ NN) (list '<= (list 'ABS (list as 'wcvi_)) bre)))
        (lambda () (let ((i (dk-di-var!))) (wcv-pt! h i) (if (not (dk-lam-b!)) (ass)))))
      (let* ((bw1 (dk-cite! 'rr-bolzano-weierstrass as bre))
             (phi (dk-skolem! bw1 'top))
             (p (dk-skolem! (dk-pick (lambda (f) (and (wcv-op? f 'FORSOME 3) (dk-contains? f 'CONVERGES-TO) (dk-contains? f phi)))
                                     "the real-part limit")))
             (_2 (wcv-mono-fun! phi))
             (bs (list 'VNB-LAMBDA 'wcvk_ 'NN (list 'imag-part (list h (list phi 'wcvk_))))))
        (wcv-rr-seq! bs (lambda (k) (wcv-nn-app! phi k) (wcv-pt! h (list phi k)) (wcv-rr! (list 'imag-part (list h (list phi k))))))
        (dk-have! (list 'FORALL 'wcvi_ (list 'IMPLIES '(IN wcvi_ NN) (list '<= (list 'ABS (list bs 'wcvi_)) bim)))
          (lambda () (let ((i (dk-di-var!))) (wcv-nn-app! phi i) (wcv-pt! h (list phi i)) (if (not (dk-lam-b!)) (ass)))))
        (let* ((bw2 (dk-cite! 'rr-bolzano-weierstrass bs bim))
               (psi (dk-skolem! bw2 'top))
               (q (dk-skolem! (dk-pick (lambda (f) (and (wcv-op? f 'FORSOME 3) (dk-contains? f 'CONVERGES-TO) (dk-contains? f psi)))
                                       "the imaginary-part limit")))
               (_3 (wcv-mono-fun! psi))
               (sa (list 'SUBSEQ as phi))
               (_4 (fact 'subseq-of-convergent 'RR-MS sa psi p))
               (lt (list '+ p (list '* q +i)))
               (_5 (wcv-cc! lt))
               (v (dk-name! lt 'CC))
               (_6 (dk-split-all! (list (dk-cite! 'cc-re-im-of v p q))))
               (w (lambda (j) (list h (list phi (list psi j)))))
               ;; E: |h(phi(psi j)) - v| <= eps eventually
               (E (list 'FORALL 'wcve_ (list 'IMPLIES '(POS-RR wcve_) (list 'FORSOME 'wcvn_ (list 'AND '(IN wcvn_ NN)
                    (list 'FORALL 'wcvj_ (list 'IMPLIES '(IN wcvj_ NN) (list 'IMPLIES '(<= wcvn_ wcvj_)
                      (list '<= (list 'magnitude (list '- (w 'wcvj_) v)) 'wcve_))))))))))
          (dk-have! E
            (lambda ()
              (let* ((e (cadr (wcv-first-of (filter (lambda (f) (wcv-op? f 'POS-RR 2)) (dk-peel!)))))
                     (d (begin (fact (quote rr-pos-rr-in-rr) e) (dk-halve! e)))
                     (x1 (dk-cite! 'rr-subseq-converges-abs sa psi p d))
                     (n1 (dk-skolem! x1 'top))
                     (c1 (dk-pick (lambda (f) (and (wcv-op? f 'FORALL 3) (dk-contains? f n1) (dk-contains? f 'ABS))) "clause 1"))
                     (x2 (dk-cite! 'rr-subseq-converges-abs bs psi q d))
                     (n2 (dk-skolem! x2 'top))
                     (c2 (dk-pick (lambda (f) (and (wcv-op? f 'FORALL 3) (dk-contains? f n2) (dk-contains? f 'ABS))) "clause 2"))
                     (nn (list '+ n1 n2)))
                (wcv-and! (list 'IN n1 'NN) (list 'IN n2 'NN))
                (fact 'nn-add-closed n1 n2)
                (ew nn)
                (dk-conj-close!
                  (lambda ()
                    (if (dk-head-is? (dk-goal) 'IN)
                        (ass)
                        (let* ((j (cadr (wcv-first-of (filter (lambda (f) (and (wcv-op? f 'IN 3) (eq? (caddr f) 'NN))) (dk-peel!)))))
                               (pj (list psi j)) (ppj (list phi pj)) (wj (w j)))
                          (wcv-nn-app! psi j) (wcv-nn-app! phi pj)
                          (wcv-pt! h ppj)
                          (dk-have! (list '<= n1 j) (lambda () (dk-nn! (list '<= nn j))))
                          (dk-have! (list '<= n2 j) (lambda () (dk-nn! (list '<= nn j))))
                          (let* ((a1 (dk-apply! c1 j))
                                 (_a (fact 'subseq-apply as phi pj))
                                 (a1b (begin (dk-rewrite-h! a1 (list sa pj) (list as ppj))
                                             (list '<= (list 'ABS (list '- (list as ppj) p)) d)))
                                 (_b (dk-lam-b-h! a1b))
                                 (a1c (wcv-need (list '<= (list 'ABS (list '- (list 'real-part wj) p)) d) "the real-part estimate"))
                                 (a2 (dk-apply! c2 j))
                                 (_c (dk-lam-b-h! a2))
                                 (a2c (wcv-need (list '<= (list 'ABS (list '- (list 'imag-part wj) q)) d) "the imaginary-part estimate"))
                                 (co (dk-cite! 'cc-dist-le-coords wj v))
                                 (co1 (begin (dk-rewrite-h! co (list 'real-part v) p)
                                             (list '<= (list 'magnitude (list '- wj v))
                                                   (list '+ (list 'ABS (list '- (list 'real-part wj) p))
                                                            (list 'ABS (list '- (list 'imag-part wj) (list 'imag-part v)))))))
                                 (co2 (begin (dk-rewrite-h! co1 (list 'imag-part v) q)
                                             (list '<= (list 'magnitude (list '- wj v))
                                                   (list '+ (list 'ABS (list '- (list 'real-part wj) p))
                                                            (list 'ABS (list '- (list 'imag-part wj) q)))))))
                            (wcv-rr! (list 'magnitude (list '- wj v)))
                            (wcv-rr! (list 'ABS (list '- (list 'real-part wj) p)))
                            (wcv-rr! (list 'ABS (list '- (list 'imag-part wj) q)))
                            (dk-ineq! co2 a1c a2c (list '= (list '+ d d) e))))))))))
          (set! wcv-E-ctx (dk-ctx-form E))
          ;; v lies in the disc
          (dk-have! (list '<= (list 'magnitude (list '- v 'wcvc_)) 'wcvr_)
            (lambda ()
              (wcv-rr! (list 'magnitude (list '- v 'wcvc_)))
              (dk-have! (list 'FORALL 'wcvd_ (list 'IMPLIES '(POS-RR wcvd_) (list '<= (list 'magnitude (list '- v 'wcvc_)) '(+ wcvr_ wcvd_))))
                (lambda ()
                  (let* ((dd (cadr (wcv-first-of (filter (lambda (f) (wcv-op? f 'POS-RR 2)) (dk-peel!)))))
                         (_d (begin (fact 'rr-pos-rr-in-rr dd) (fact 'rr-lt-of-pos-rr dd)))
                         (n0 (dk-skolem! (dk-apply! wcv-E-ctx dd) 'top))
                         (cl (dk-pick (lambda (f) (and (wcv-op? f 'FORALL 3) (dk-contains? f n0) (dk-contains? f 'magnitude))) "the estimate at dd"))
                         (_e (fact 'nn-le-refl n0))
                         (pj (list psi n0)) (ppj (list phi pj)) (wj (w n0)))
                    (wcv-nn-app! psi n0) (wcv-nn-app! phi pj) (wcv-pt! h ppj)
                    (dk-apply! cl n0)
                    (wcv-cc! (list '- v wj)) (wcv-cc! (list '- wj 'wcvc_))
                    (wcv-and! (list 'IN (list '- v wj) 'CC) (list 'IN (list '- wj 'wcvc_) 'CC))
                    (let ((tri (dk-cite! 'cc-magnitude-triangle (list '- v wj) (list '- wj 'wcvc_))))
                      (dk-have! (list '= (list '+ (list '- v wj) (list '- wj 'wcvc_)) (list '- v 'wcvc_)) (lambda () (crs)))
                      (dk-rewrite-h! tri (list '+ (list '- v wj) (list '- wj 'wcvc_)) (list '- v 'wcvc_))
                      (fact 'cc-magnitude-sub-sym v wj)
                      (wcv-rr! (list 'magnitude (list '- v wj))) (wcv-rr! (list 'magnitude (list '- wj v)))
                      (wcv-rr! (list 'magnitude (list '- wj 'wcvc_)))
                      (dk-ineq! (list '<= (list 'magnitude (list '- v 'wcvc_))
                                      (list '+ (list 'magnitude (list '- v wj)) (list 'magnitude (list '- wj 'wcvc_))))
                                (list '= (list 'magnitude (list '- v wj)) (list 'magnitude (list '- wj v)))
                                (list '<= (list 'magnitude (list '- wj v)) dd)
                                (list '<= (list 'magnitude (list '- wj 'wcvc_)) 'wcvr_))))))
              (dk-cite! 'rr-le-of-le-add-all-pos (list 'magnitude (list '- v 'wcvc_)) 'wcvr_)
              (ass)))
          (dk-cite! 'cc-closed-ball-mem-intro 'wcvc_ 'wcvr_ v)
          ;; v is a cluster point of h in the subspace
          (ew v)
          (mac 'CLUSTER-POINT)
          (dk-conj-close!
            (lambda ()
              (cond ((dk-head-is? (dk-goal) 'IS-METRIC-SPACE) (ass))
                    ((and (dk-head-is? (dk-goal) 'IN) (equal? (cadr (dk-goal)) v))
                     (subst (list '== (list 'PTS wcv-S) wcv-D)) (ass))
                    ((dk-head-is? (dk-goal) 'IN) (ass))
                    (#t
                     (let* ((ls (dk-peel!))
                            (e (cadr (wcv-first-of (filter (lambda (f) (wcv-op? f 'POS-RR 2)) ls))))
                            (m (cadr (wcv-first-of (filter (lambda (f) (and (wcv-op? f 'IN 3) (eq? (caddr f) 'NN))) ls))))
                            (d (begin (fact (quote rr-pos-rr-in-rr) e) (dk-halve! e)))
                            (n0 (dk-skolem! (dk-apply! wcv-E-ctx d) 'top))
                            (cl (dk-pick (lambda (f) (and (wcv-op? f 'FORALL 3) (dk-contains? f n0) (dk-contains? f 'magnitude))) "the estimate at d"))
                            (t (list '+ m n0))
                            (pt (list psi t)) (n (list phi pt)) (hn (list h n)))
                       (wcv-and! (list 'IN m 'NN) (list 'IN n0 'NN))
                       (fact 'nn-add-closed m n0)
                       (fact 'nn-le-add-left m n0)
                       (fact 'nn-le-add-right n0 m)
                       (wcv-nn-app! psi t) (wcv-nn-app! phi pt)
                       (fact 'strictly-mono-ge-id psi t)
                       (fact 'strictly-mono-ge-id phi pt)
                       (wcv-pt! h n)
                       (dk-have! (list '<= m n)
                         (lambda () (dk-nn! (list '<= m t) (list '<= t pt) (list '<= pt n))))
                       (dk-apply! cl t)
                       (fact 'subspace-dist 'CC-MS wcv-D hn v)
                       (fact 'cc-ms-dist hn v)
                       (wcv-rr! (list 'magnitude (list '- hn v)))
                       (ew n)
                       (dk-conj-close!
                         (lambda ()
                           (cond ((dk-head-is? (dk-goal) 'IN) (ass))
                                 ((dk-head-is? (dk-goal) '<=) (ass))
                                 (#t
                                  (subst (list '= (list (list 'DIST wcv-S) hn v) (list '(DIST CC-MS) hn v)))
                                  (subst (list '= (list '(DIST CC-MS) hn v) (list 'magnitude (list '- hn v))))
                                  (dk-ineq! (list '<= (list 'magnitude (list '- hn v)) d)
                                            (list '= (list '+ d d) e) (list (quote <) 0 d))))))))))))))))
(prop)
(qed 'cc-closed-ball-compact)
;;; ======================================================================
;;; (5) UNIFORM CONVERGENCE ON COMPACTA IS LOCALLY UNIFORM (on an open set of CC):
;;; the hypothesis of `holomorphic-uniform-limit' (morera.scm), its binders verbatim
;;; ======================================================================
(define wcv-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (wcv-unif S)
  (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'aicap_ (list 'AND '(IN aicap_ NN)
      (list 'FORALL 'k (list 'IMPLIES '(IN k NN) (list 'IMPLIES '(<= aicap_ k)
        (list 'FORALL 'aiy_ (list 'IMPLIES (list 'IN 'aiy_ S)
          '(<= (magnitude (- ((fam k) aiy_) (f aiy_))) eps)))))))))))
(define wcv-LU
  (list 'FORALL 'mrlz_ (list 'IMPLIES '(IN mrlz_ u)
    (list 'FORSOME 'mrlr_ (list 'AND '(POS-RR mrlr_)
      (list 'AND '(SUBSET (BALL CC-MS mrlz_ mrlr_) u) (wcv-unif '(BALL CC-MS mrlz_ mrlr_))))))))
(define wcv-famhol '(FORALL k (IMPLIES (IN k NN) (HOLOMORPHIC-ON u (fam k)))))

;;; z in u, u open in NFM: land a radius rho with POS-RR(rho) and BALL(CC-MS, z, rho) inside u; return rho
(define (wcv-open-ball! z)
  (fact 'cc-open-subset-cc 'u)
  (fact 'subset-mem-fwd 'u 'CC z)
  (fact 'cc-is-metric-space) (wcv-pts-cc!)
  (if (not (dk-asm? (list 'IN z '(PTS CC-MS))))
      (dk-have! (list 'IN z '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass))))
  (if (not (dk-asm? '(IS-OPEN CC-MS u)))
      (begin
        (dk-split-all! (list (dk-cite! 'cc-ms-open-iff 'u)))
        (dk-have! '(IS-OPEN CC-MS u) (lambda () (prop)))))
  (let* ((oiff (dk-cite! 'is-open 'CC-MS 'u))
         (oball (let loop ((r (caddr oiff))) (if (eq? (car r) 'AND) (loop (caddr r)) r))))
    (if (not (dk-asm? oball))
        (dk-have! oball (lambda () (if (dk-only! oiff '(IS-OPEN CC-MS u)) (prop)))))
    (let ((rho (dk-skolem! (dk-apply! oball z))))
      (dk-split-all!)
      rho)))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN wcv-nfm 'u)
  (list 'FORALL 'fam (list 'FORALL 'f (list 'IMPLIES '(UNIF-ON-COMPACTA u fam f) wcv-LU)))))))
(define wcv-5-ls (dk-peel!))
(define wcv-5-body
  (let ((ci (dk-cite! 'unif-on-compacta 'u 'fam 'f)))
    (dk-have! (caddr ci) (lambda () (prop)))
    (caddr ci)))
(let* ((z (cadr (wcv-first-of (filter (lambda (fm) (and (wcv-op? fm 'IN 3) (eq? (caddr fm) 'u))) wcv-5-ls))))
       (rho (wcv-open-ball! z))
       (d (dk-halve! rho))
       (cb (list 'CLOSED-BALL 'CC-MS z d))
       (bl (list 'BALL 'CC-MS z d))
       (bigb (list 'BALL 'CC-MS z rho)))
  (wcv-need (list 'SUBSET bigb 'u) "the ball inside u")
  (fact 'rr-pos-rr-in-rr rho) (fact 'rr-lt-of-pos-rr rho)
  (dk-have! (list '< d rho) (lambda () (dk-ineq! (list '= (list '+ d d) rho) (list '< 0 d))))
  (fact 'closed-ball-in-ball 'CC-MS z d rho)
  (fact 'subset-trans cb bigb 'u)
  (fact 'ball-in-closed-ball 'CC-MS z d)
  (fact 'subset-trans bl cb 'u)
  (dk-cite! 'cc-closed-ball-compact z d)
  (let ((ucb (dk-apply! (dk-ctx-form wcv-5-body) cb)))
    (ew d)
    (dk-conj-close!
      (lambda ()
        (cond ((dk-head-is? (dk-goal) 'POS-RR) (ass))
              ((dk-head-is? (dk-goal) 'SUBSET) (ass))
              (#t
               (let* ((e (cadr (wcv-first-of (filter (lambda (fm) (wcv-op? fm 'POS-RR 2)) (dk-peel!)))))
                      (n (dk-skolem! (dk-apply! ucb e) 'top))
                      (cl (dk-pick (lambda (fm) (and (wcv-op? fm 'FORALL 3) (dk-contains? fm n) (dk-contains? fm 'magnitude)))
                                   "the uniform clause on the closed disc")))
                 (ew n)
                 (dk-conj-close!
                   (lambda ()
                     (if (dk-head-is? (dk-goal) 'IN)
                         (ass)
                         (let* ((ls (dk-peel!))
                                (k (cadr (wcv-first-of (filter (lambda (fm) (and (wcv-op? fm 'IN 3) (eq? (caddr fm) 'NN))) ls))))
                                (y (cadr (wcv-first-of (filter (lambda (fm) (and (wcv-op? fm 'IN 3) (equal? (caddr fm) bl))) ls)))))
                           (fact 'subset-mem-fwd bl cb y)
                           (dk-apply! cl k y)
                           (ass))))))))))))
(qed 'unif-on-compacta-locally)

;;; ======================================================================
;;; (6) PROPOSITION 3.44: the limit of a sequence of holomorphic functions on an open
;;; set u, uniform on the compact subsets of u, is holomorphic on u
;;; ======================================================================
(sp (make-wff (list 'FORALL 'u (list 'IMPLIES (list 'IS-OPEN wcv-nfm 'u)
  (list 'FORALL 'fam (list 'IMPLIES wcv-famhol
    (list 'FORALL 'f (list 'IMPLIES '(IN f (FUN u CC))
      (list 'IMPLIES '(UNIF-ON-COMPACTA u fam f) '(HOLOMORPHIC-ON u f))))))))))
(dk-peel!)
(dk-cite! 'unif-on-compacta-locally 'u 'fam 'f)
(dk-cite! 'holomorphic-uniform-limit 'u 'fam 'f)
(ass)
(qed 'holomorphic-limit-on-compacta)
;;; ======================================================================
;;; (7) A COMPACT SUBSET OF CC IS COVERED BY FINITELY MANY OF ANY GIVEN BALLS ABOUT
;;; ITS POINTS: for a radius function h > 0 on K there is a finite P inside K with
;;; K inside the union of the balls B(x, h(x)), x in P.  (The technique both directions
;;; of "uniformly on compacta" and Corollary 2.13 use; the radius function is chosen
;;; by the caller, as a CHOICE over the radii that serve.)
;;; ======================================================================
(define wcv-K 'wcvs_)
(define wcv-KS (list 'SUBSPACE-MS 'CC-MS 'wcvs_))
(define wcv-bl (list 'VNB-LAMBDA 'wcvt_ 'wcvs_ (list 'BALL wcv-KS 'wcvt_ '(wcvh_ wcvt_))))
(define wcv-Cv (list 'IMAGE wcv-bl 'wcvs_))
(define (wcv-head g) (and (pair? g) (car g)))
(define (wcv-csub-and! closer)
  (if (eq? (wcv-head (dk-goal)) 'AND)
      (for-each (lambda (k) (dk-focus! k) (wcv-csub-and! closer))
                (dk-opened (lambda () (di))))
      (closer)))
(define (wcv-extensional! rhs body)
  (let ((bu (cadr (dk-goal))))
    (dk-have! (list 'FORALL 'zz_ (list 'IFF (list 'IN 'zz_ bu) (list 'IN 'zz_ rhs)))
      (lambda ()
        (let ((z (dk-di-var! (lambda (g) (cadr (cadr g))))))
          (body z bu))))
    (fact 'class-extensionality bu rhs)
    (subst (list '= bu rhs))
    (qrfl)))
(define (wcv-bu-skolem! mem fam)
  (let* ((new (dk-landed (lambda () (bu-me mem))))
         (f   (or (find-first (lambda (h) (and (pair? h) (eq? (car h) 'IN) (equal? (caddr h) fam))) new)
                  (error "wcv-bu-skolem!: no landed membership in" fam))))
    (cadr f)))
;;; x in K: land x in PTS(KS), x in CC, h(x) in RR, the radius conjunction, the ball typed
(define (wcv-cov-pt! x)
  (let* ((r (list 'wcvh_ x)))
    (if (not (dk-asm? (list 'IN x (list 'PTS wcv-KS))))
        (dk-have! (list 'IN x (list 'PTS wcv-KS)) (lambda () (subst (list '== (list 'PTS wcv-KS) 'wcvs_)) (ass))))
    (fact 'subset-mem-fwd 'wcvs_ 'CC x)
    (fact 'fun-apply-type-c 'wcvh_ 'wcvs_ 'RR x)
    (dk-apply! (dk-ctx-form '(FORALL wcvx_ (IMPLIES (IN wcvx_ wcvs_) (< 0 (wcvh_ wcvx_))))) x)
    (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
    (dk-have! (list 'NOT (list '= 0 r)) (lambda () (di) (dk-absurd! (list '= 0 r) (list '< 0 r))))
    (wcv-and! (list 'IN r 'RR) (wcv-and! (list '<= 0 r) (list 'NOT (list '= 0 r))))
    (fact 'ball-is-set wcv-KS x r)))
;;; V in Cv: return x with x in K and BALL(KS, x, h x) = V landed
(define (wcv-cv-pt! V)
  (let* ((iff (dk-cite! 'image-membership-iff wcv-bl 'wcvs_ V)))
    (dk-have! (caddr iff) (lambda () (prop)))
    (dk-split! (caddr iff))
    (let* ((x (dk-skolem! (dk-pick (lambda (f) (and (wcv-op? f 'FORSOME 3) (dk-contains? f V) (dk-contains? f 'wcvt_))) "the centre"))))
      (dk-lam-b-h! (list '= (list wcv-bl x) V))
      (wcv-need (list '= (list 'BALL wcv-KS x (list 'wcvh_ x)) V) "the ball equation")
      x)))

(sp (make-wff '(FORALL wcvs_ (IMPLIES (SUBSET wcvs_ CC) (IMPLIES (IS-COMPACT (SUBSPACE-MS CC-MS wcvs_))
  (FORALL wcvh_ (IMPLIES (IN wcvh_ (FUN wcvs_ RR)) (IMPLIES (FORALL wcvx_ (IMPLIES (IN wcvx_ wcvs_) (< 0 (wcvh_ wcvx_))))
    (FORSOME wcvp_ (AND (SUBSET wcvp_ wcvs_) (AND (IN (CARD wcvp_) NN)
      (FORALL wcvy_ (IMPLIES (IN wcvy_ wcvs_) (FORSOME wcvx_ (AND (IN wcvx_ wcvp_)
        (IN wcvy_ (BALL CC-MS wcvx_ (wcvh_ wcvx_))))))))))))))))))
(dk-peel!)
(fact 'cc-is-metric-space) (wcv-pts-cc!)
(fact 'cc-is-set)
(fact 'subclass-of-set-is-set 'wcvs_ 'CC)
(dk-have! '(SUBSET wcvs_ (PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (ass)))
(fact 'subspace-is-metric-space 'CC-MS 'wcvs_)
(fact 'subspace-pts 'CC-MS 'wcvs_)
(fact 'image-set wcv-bl 'wcvs_)
;; the balls form an open cover of the subspace
(dk-have! (list 'IS-OPEN-COVER wcv-KS wcv-Cv)
  (lambda ()
    (mac 'IS-OPEN-COVER)
    (wcv-csub-and!
      (lambda ()
        (let ((g (dk-goal)))
          (cond
            ((eq? (wcv-head g) 'IS-METRIC-SPACE) (ass))
            ((eq? (wcv-head g) 'FORALL)
             (let* ((V (dk-di-var!)) (x (wcv-cv-pt! V)))
               (wcv-cov-pt! x)
               (subst (list '= V (list 'BALL wcv-KS x (list 'wcvh_ x))))
               (dk-cite! 'ball-is-open wcv-KS x (list 'wcvh_ x))
               (ass)))
            (#t
             (wcv-extensional! (list 'PTS wcv-KS)
               (lambda (z bu)
                 (dk-iff!
                   (lambda (g) (dk-contains? g 'BIG-UNION))
                   ;; z in PTS(KS) ==> z in the union
                   (lambda ()
                     (dk-peel!)
                     (dk-rewrite-h! (list 'IN z (list 'PTS wcv-KS)) (list 'PTS wcv-KS) 'wcvs_)
                     (wcv-cov-pt! z)
                     (let ((bz (list 'BALL wcv-KS z (list 'wcvh_ z))))
                       (dk-cite! 'ball-center-in wcv-KS z (list 'wcvh_ z))
                       (dk-have! (list 'IN bz wcv-Cv)
                         (lambda ()
                           (let ((iff (dk-cite! 'image-membership-iff wcv-bl 'wcvs_ bz)))
                             (dk-have! (caddr iff)
                               (lambda ()
                                 (wcv-csub-and!
                                   (lambda ()
                                     (if (dk-asm? (dk-goal))
                                         (ass)
                                         (begin
                                           (ew z)
                                           (wcv-csub-and!
                                             (lambda ()
                                               (if (dk-asm? (dk-goal)) (ass)
                                                   (begin (dk-lam-b!) (rfl)))))))))))
                             (prop))))
                       (for-each
                         (lambda (k)
                           (if (not (sequent-node-grounded? k))
                               (begin (dk-focus! k) (ass))))
                         (dk-opened (lambda () (bu-mi bz))))))
                   ;; z in the union ==> z in PTS(KS)
                   (lambda ()
                     (dk-peel!)
                     (let* ((V (wcv-bu-skolem! (list 'IN z bu) wcv-Cv))
                            (x (wcv-cv-pt! V)))
                       (wcv-cov-pt! x)
                       (dk-have! (list 'IN z (list 'BALL wcv-KS x (list 'wcvh_ x)))
                         (lambda () (subst (list '= (list 'BALL wcv-KS x (list 'wcvh_ x)) V)) (ass)))
                       (let ((bi (dk-cite! 'ball-membership wcv-KS x (list 'wcvh_ x) z)))
                         (prop))))))))))))))
;; a finite subcover, and the finite set of its centres
