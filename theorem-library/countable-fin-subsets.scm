;;; Library: analysis.

;;; cf-1.scm -- the finite subsets of a countable set form a countable set.
;;; Agent BA-ONB4, 2026-11-09.  Prefix cfs-.  Nothing asserted.
;;; For X nonempty with an enumeration en : NN -> X onto (countable-enum-nonempty), FIN-SUBSETS(X)
;;; is the union over k in NN of IMAGE(T |-> IMAGE(en, T), POWER(ORD-SEGMENT k)), each piece
;;; finite (card-power-nn, card-segment); a finite S <= X lies in the piece of a bound n0 of the
;;; least-chosen preimages of its points (nn-finite-subset-bounded over an IMAGE), as the image of
;;; T = {m < n0 : en m in S}.  For X empty, FIN-SUBSETS(X) <= {EMPTY-SET}.

(define (cfs-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display ";; cfs: OPEN LEAVES before qed ") (display name) (newline)
        (for-each (lambda (l)
                    (display ";;   ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;     | ") (display (expression->string a)) (newline))
                              (list-head (dk-asms-of l) (min 6 (length (dk-asms-of l))))))
                  (dk-open-leaves))
        (error "cfs: proof not complete" name)))
  (qed name)
  (topic! name 'analysis))
(define (cfs-open?) (not (sequent-node-grounded? (proof-state-focus *ps*))))
(define (cfs-close!) (cond ((not (cfs-open?)) #t) ((dk-asm? (dk-goal)) (ass)) (#t (rfl))))
(define (cfs-and! . fs)
  (let ((c (let loop ((fs fs)) (if (null? (cdr fs)) (car fs) (list 'AND (car fs) (loop (cdr fs)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
;; land CLAIM by prop from the formulas KEEP (all in context)
(define (cfs-prop! claim . keep)
  (if (not (dk-asm? claim))
      (dk-have! claim (lambda () (let ((leaf (proof-state-focus *ps*)))
                                   (apply dk-only! keep)
                                   (if (not (sequent-node-grounded? leaf)) (prop))))))
  claim)
;; the extensionality IFF at a, b (both sets in context)
(define (cfs-ext! a b)
  (cfs-and! (list 'IN a 'SET) (list 'IN b 'SET))
  (let ((e0 (dk-cite! 'extensionality a b)))
    (if (dk-head-is? e0 'IMPLIES) (begin (detach! e0) (caddr e0)) e0)))
;; peel an unguarded FORALL whose body is (IFF (IN x A) ...); return the eigenvariable
(define (cfs-di-bare!)
  (di)
  (let ((g (dk-goal)))
    (if (not (and (dk-head-is? g 'IFF) (dk-head-is? (cadr g) 'IN)))
        (error "cfs-di-bare!: unexpected goal" (expression->string g)))
    (cadr (cadr g))))
;; the right side of an IFF instance
(define (cfs-rhs iff) (caddr iff))

        ;; the piece at k: POWER(seg k) is a finite set inside POWER(NN), its image under h is a set
        (define (cfs-piece-facts! k h pn)
          (let ((sg (list 'ORD-SEGMENT k)))
            (fact 'nn-subset-ord k)
            (fact 'ord-segment-is-set k)
            (fact 'power-set sg)
            (fact 'image-set h (list 'POWER sg))
            (fact 'card-segment k)
            (dk-have! (list 'IN (list 'CARD sg) 'NN) (lambda () (subst (list '= (list 'CARD sg) k)) (dk-ass!)))
            (cfs-and! (list 'IN sg 'SET) (list 'IN (list 'CARD sg) 'NN))
            (fact 'card-power-nn sg)
            (dk-have! (list 'SUBSET (list 'POWER sg) pn)
              (lambda ()
                (mac 'subset-def)
                (let ((tt (dk-di-var!)))
                  (fact 'power-mem-sethood sg tt)
                  (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ tt) (list 'IN 'z_ 'NN)))
                    (lambda ()
                      (let ((z (dk-di-var!)))
                        (fact 'power-mem-in sg tt z)
                        (fact 'ord-segment-nn-subset k z)
                        (dk-ass!))))
                  (fact 'power-mem-intro 'NN tt)
                  (dk-ass!))))))

(sp (make-wff '(FORALL cfx_ (IMPLIES (IS-COUNTABLE cfx_) (IS-COUNTABLE (FIN-SUBSETS cfx_))))))
(dk-peel!)
(define cfs-X 'cfx_)
(define cfs-FS '(FIN-SUBSETS cfx_))
(let ((cc (dk-cite! 'countable-cases cfs-X)))
  (if (dk-head-is? cc 'AND) (dk-split! cc)))
(fact 'fin-subsets-is-set cfs-X)
(fact 'empty-set-is-set)
;; S in FS: S in SET, S <= X (pointwise), CARD S in NN
(define (cfs-fs-parts! s)
  (let* ((iff (dk-cite! 'fin-subsets-membership cfs-X s))
         (r (cfs-prop! (cfs-rhs iff) iff (list 'IN s cfs-FS))))
    (dk-split-all! (list r))))
(use-em '(FORSOME cfz_ (IN cfz_ cfx_))
  ;; ---- X nonempty
  (lambda ()
    (let* ((ex (dk-cite! 'countable-enum-nonempty cfs-X))
           (en (dk-skolem! ex)))
      (dk-split-all!)
      (let* ((onto (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a en) (dk-contains? a 'rqn_))) "onto"))
             (pn '(POWER NN))
             (h (list 'VNB-LAMBDA 'cft_ pn (list 'IMAGE en 'cft_)))
             (seg (lambda (k) (list 'ORD-SEGMENT k)))
             (pud (list 'VNB-LAMBDA 'cfk_ 'NN (list 'IMAGE h (list 'POWER '(ORD-SEGMENT cfk_))))))
        (fact 'nn-is-set)
        (fact 'power-set 'NN)
        (dk-have! (list 'IN h (list 'FUN pn 'SET))
          (lambda ()
            (dk-lam-type!
              (lambda ()
                (let ((tt (dk-di-var!)))
                  (fact 'power-mem-sethood 'NN tt)
                  (fact 'image-set en tt)
                  (dk-ass!)))
              (lambda () (ass)))))
        ;; hypothesis 1: every piece is countable
        (dk-have! (list 'FORALL 'cfk_ (list 'IMPLIES '(IN cfk_ NN) (list 'IS-COUNTABLE (list pud 'cfk_))))
          (lambda ()
            (let* ((k (dk-di-var!)) (sg (seg k)))
              (cfs-piece-facts! k h pn)
              (dk-lam-b!)
              (fact 'finite-implies-countable (list 'POWER sg))
              (fact 'countable-image (list 'POWER sg) h pn 'SET)
              (cfs-close!))))
        ;; hypothesis 2: every finite subset of X lies in some piece
        (dk-have! (list 'FORALL 'cfy_ (list 'IMPLIES (list 'IN 'cfy_ cfs-FS)
                    (list 'FORSOME 'cfk_ (list 'AND '(IN cfk_ NN) (list 'IN 'cfy_ (list pud 'cfk_))))))
          (lambda ()
            (let* ((ss (dk-di-var!))
                   (gl (list 'VNB-LAMBDA 'cfs_ ss (list 'CHOICE (list 'SEP 'cfn_ 'NN (list '= (list en 'cfn_) 'cfs_)))))
                   (sub-x (begin (cfs-fs-parts! ss)
                                 (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a (list 'IN (cadr a) cfs-X)))) "S <= X"))))
              ;; G1: for s in S, g s in NN and en (g s) = s
              (define g1 (list 'FORALL 'cfq_ (list 'IMPLIES (list 'IN 'cfq_ ss)
                           (list 'AND (list 'IN (list gl 'cfq_) 'NN) (list '= (list en (list gl 'cfq_)) 'cfq_)))))
              (dk-have! g1
                (lambda ()
                  (let* ((s (dk-di-var!))
                         (sep (list 'SEP 'cfn_ 'NN (list '= (list en 'cfn_) s)))
                         (ch (list 'CHOICE sep)))
                    (dk-apply! sub-x s)
                    (let* ((ex2 (dk-apply! onto s))
                           (n (dk-skolem! ex2)))
                      (dk-split-all!)
                      (dk-have! (list 'FORSOME 'cfw_ (list 'IN 'cfw_ sep))
                        (lambda ()
                          (ew n)
                          (in-sep! (lambda () (ass))
                                   (lambda () (subst (list '= s (list en n))) (cfs-close!)))))
                      (fact 'choice-axiom sep)
                      (let ((pr (dk-landed (lambda () (sep-me (list 'IN ch sep))))))
                        (fact 'membership-implies-sethood ch 'NN)
                        (dk-lam-b!)
                        (dk-conj-close! (lambda () (dk-ass!))))))))
              ;; t = IMAGE g S: a finite subset of NN, bounded by n0
              (let* ((tt (list 'IMAGE gl ss)))
                (fact 'image-set gl ss)
                (fact 'card-image-finite gl ss)
                (dk-have! (list 'SUBSET tt 'NN)
                  (lambda ()
                    (mac 'subset-def)
                    (let* ((y (dk-di-var!))
                           (iff (dk-cite! 'image-membership-iff gl ss y))
                           (r (cfs-prop! (cfs-rhs iff) iff (list 'IN y tt))))
                      (dk-split-all! (list r))
                      (let* ((ex3 (dk-pick (dk-head? 'FORSOME) "the preimage"))
                             (x (dk-skolem! ex3)))
                        (dk-split-all!)
                        (dk-split-all! (list (dk-apply! g1 x)))
                        (subst (list '= y (list gl x)))
                        (dk-ass!)))))
                (let* ((bd (dk-cite! 'nn-finite-subset-bounded tt))
                       (n0 (dk-skolem! bd)))
                  (dk-split-all!)
                  (let* ((bnd (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a n0) (dk-contains? a tt))) "the bound"))
                         (sg (seg n0))
                         (T0 (list 'SEP 'cfm_ sg (list 'IN (list en 'cfm_) ss)))
                         (img (list 'IMAGE en T0)))
                    (cfs-piece-facts! n0 h pn)
                    (ew n0)
                    (dk-conj-close!
                      (lambda ()
                        (cond
                          ((dk-ass!) #t)
                          (#t
                           (dk-lam-b!)
                           ;; T0 <= seg, T0 in SET, T0 in POWER(seg), T0 in POWER(NN)
                           (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ T0) (list 'IN 'z_ sg)))
                             (lambda () (let ((z (dk-di-var!))) (dk-landed (lambda () (sep-me (list 'IN z T0)))) (dk-ass!))))
                           (dk-have! (list 'SUBSET T0 sg) (lambda () (mac 'subset-def) (dk-ass!)))
                           (fact 'subclass-of-set-is-set T0 sg)
                           (fact 'power-mem-intro sg T0)
                           (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ T0) (list 'IN 'z_ 'NN)))
                             (lambda () (let ((z (dk-di-var!)))
                                          (dk-landed (lambda () (sep-me (list 'IN z T0))))
                                          (fact 'ord-segment-nn-subset n0 z) (dk-ass!))))
                           (fact 'power-mem-intro 'NN T0)
                           (fact 'image-set en T0)
                           ;; h T0 = IMAGE en T0
                           (dk-have! (list '= (list h T0) img) (lambda () (dk-close-if! dk-lam-b! cfs-close!)))
                           ;; IMAGE en T0 = S, by extensionality
                           (let* ((ext (cfs-ext! img ss))
                                  (rh (cfs-rhs ext)))
                             (dk-have! rh
                               (lambda ()
                                 (let ((x (cfs-di-bare!)))
                                   (dk-iff!
                                     (lambda (g) (equal? g (list 'IN x ss)))
                                     ;; x in IMAGE en T0 => x in S
                                     (lambda ()
                                       (let* ((iff (dk-cite! 'image-membership-iff en T0 x))
                                              (r (cfs-prop! (cfs-rhs iff) iff (list 'IN x img))))
                                         (dk-split-all! (list r))
                                         (let* ((m (dk-skolem! (dk-pick (dk-head? 'FORSOME) "the preimage"))))
                                           (dk-split-all!)
                                           (if (not (dk-asm? (list 'IN (list en m) ss)))
                                               (dk-landed (lambda () (sep-me (list 'IN m T0)))))
                                           (subst (list '= x (list en m)))
                                           (dk-ass!))))
                                     ;; x in S => x in IMAGE en T0
                                     (lambda ()
                                       (let ((gx (list gl x)))
                                         (dk-split-all! (list (dk-apply! g1 x)))
                                         (fact 'membership-implies-sethood x ss)
                                         ;; g x in t
                                         (let* ((iff (dk-cite! 'image-membership-iff gl ss gx)))
                                           (fact 'membership-implies-sethood gx 'NN)
                                           (dk-have! (cfs-rhs iff)
                                             (lambda () (dk-conj-close! (lambda () (cond ((dk-ass!) #t) (#t (ew x) (dk-conj-close! (lambda () (cfs-close!)))))))))
                                           (cfs-prop! (list 'IN gx tt) iff (cfs-rhs iff)))
                                         ;; g x < n0
                                         (dk-have! (list 'NOT (list '<= n0 gx))
                                           (lambda ()
                                             (di)
                                             (dk-apply! bnd gx)
                                             (cfs-prop! 'FALSITY (list 'NOT (list 'IN gx tt)) (list 'IN gx tt))))
                                         (fact 'nn-in-rr n0)
                                         (fact 'nn-in-rr gx)
                                         (cfs-and! (list 'IN n0 'RR) (list 'IN gx 'RR))
                                         (fact 'rr-not-le-lt n0 gx)
                                         (let ((iff (dk-cite! 'seg-mem-lt n0 gx)))
                                           (cfs-prop! (list 'IN gx sg) iff (list '< gx n0)))
                                         (dk-have! (list 'IN gx T0)
                                           (lambda () (in-sep! (lambda () (ass))
                                                               (lambda () (subst (list '= (list en gx) x)) (cfs-close!)))))
                                         (let ((iff (dk-cite! 'image-membership-iff en T0 x)))
                                           (dk-have! (cfs-rhs iff)
                                             (lambda () (dk-conj-close! (lambda () (cond ((dk-ass!) #t) (#t (ew gx) (dk-conj-close! (lambda () (cfs-close!)))))))))
                                           (cfs-prop! (list 'IN x img) iff (cfs-rhs iff))
                                           #t)))))))
                             (cfs-prop! (list '= img ss) ext rh))
                           ;; S in IMAGE h (POWER seg)
                           (let ((iff (dk-cite! 'image-membership-iff h (list 'POWER sg) ss)))
                             (dk-have! (cfs-rhs iff)
                               (lambda ()
                                 (dk-conj-close!
                                   (lambda ()
                                     (cond ((dk-ass!) #t)
                                           (#t (ew T0)
                                               (dk-conj-close!
                                                 (lambda ()
                                                   (cond ((dk-ass!) #t)
                                                         (#t (subst (list '= (list h T0) img)) (subst (list '= img ss)) (cfs-close!)))))))))))
                             (cfs-prop! (list 'IN ss (list 'IMAGE h (list 'POWER sg))) iff (cfs-rhs iff))
                             #t)))))))))))
        (fact 'countable-union-nn pud cfs-FS)
        (cfs-close!))))
  ;; ---- X empty: every finite subset is EMPTY-SET
  (lambda ()
    (let ((pe '(PAIR EMPTY-SET EMPTY-SET)))
      (dk-have! (list 'SUBSET cfs-FS pe)
        (lambda ()
          (mac 'subset-def)
          (let* ((ss (dk-di-var!)))
            (cfs-fs-parts! ss)
            (let* ((sub-x (dk-pick (lambda (a) (and (dk-head-is? a 'FORALL) (dk-contains? a (list 'IN (cadr a) cfs-X)))) "S <= X"))
                   (ext (cfs-ext! ss 'EMPTY-SET))
                   (rh (cfs-rhs ext)))
              (dk-have! rh
                (lambda ()
                  (let ((x (cfs-di-bare!)))
                    (fact 'empty-set-has-no-members x)
                    (dk-have! (list 'NOT (list 'IN x ss))
                      (lambda ()
                        (di)
                        (dk-apply! sub-x x)
                        (dk-have! '(FORSOME cfz_ (IN cfz_ cfx_)) (lambda () (ew x) (dk-ass!)))
                        (cfs-prop! 'FALSITY '(FORSOME cfz_ (IN cfz_ cfx_)) '(NOT (FORSOME cfz_ (IN cfz_ cfx_))))))
                    (cfs-prop! (dk-goal) (list 'NOT (list 'IN x ss)) (list 'NOT (list 'IN x 'EMPTY-SET))))))
              (cfs-prop! (list '= ss 'EMPTY-SET) ext rh)
              (cfs-and! '(IN EMPTY-SET SET) '(IN EMPTY-SET SET))
              (let ((pm (dk-cite! 'pairing-membership 'EMPTY-SET 'EMPTY-SET ss)))
                (cfs-prop! (list 'IN ss pe) pm (list '= ss 'EMPTY-SET)))
              #t))))
      (fact 'countable-singleton 'EMPTY-SET)
      (fact 'countable-subset cfs-FS pe)
      (cfs-close!))))
(cfs-done! 'countable-fin-subsets)
