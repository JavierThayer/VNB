(define (z4-amax k) `(MAX ,k 0))
(define (z4-bmax k) `(MAX (- ,k) 0))
(define (z4-and! . fs)
  (let ((c (let loop ((fs fs)) (if (null? (cdr fs)) (car fs) `(AND ,(car fs) ,(loop (cdr fs)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
    c))
(define (z4-typek! x)
  (dk-cite! 'nf-norm-in-rr 'K x)
  (dk-cite! 'nf-norm-nonneg 'K x))
(define (z4-view!)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
  (dk-cite! 'commutative-ring-is-ring z4-view)
  (for-each (lambda (r) (dk-cite! r 'K))
            '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
              normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one)))
(define (z4-in-view! x)
  (if (not (dk-asm? `(IN ,x (CARR ,z4-view))))
      (dk-have! `(IN ,x (CARR ,z4-view)) (lambda () (subst `(= (CARR ,z4-view) (CARR K))) (dk-ass!)))))
(define (z4-crs! vs)
  (z4-view!)
  (for-each z4-in-view! vs)
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,z4-view))))) '(ADD MUL NEG))
  (for-each (lambda (op) (if (dk-contains? (dk-goal) `(,op K)) (subst `(= (,op K) (,op ,z4-view))))) '(ZERO ONE))
  (crs))
(define (z4-ring-eq! eq vs) (dk-have! eq (lambda () (z4-crs! vs))) eq)
;; X in CARR K, N in NN: land X^N in CARR K and |X^N| = |X|^N, |X|^N in RR
(define (z4-pow! x n)
  (z4-view!)
  (z4-in-view! x)
  (dk-cite! 'ring-power-type z4-view x n)
  (dk-have! `(IN ,(z4-pw x n) (CARR K)) (lambda () (subst `(= (CARR K) (CARR ,z4-view))) (dk-ass!)))
  (dk-cite! 'nv-pow-norm-power 'K x n)
  (z4-typek! x)
  (dk-cite! 'power-real-closed (z4-n x) n)
  (z4-typek! (z4-pw x n)))
;; X /= ZERO K in context: land 0 < |X|
(define (z4-norm-pos! x)
  (z4-typek! x)
  (dk-have! `(NOT (= 0 ,(z4-n x)))
    (lambda ()
      (di)
      (let ((iff (dk-cite! 'nf-norm-zero-iff 'K x)))
        (dk-have! `(= ,(z4-n x) 0) (lambda () (subst `(= ,(z4-n x) 0)) (rfl)))
        (dk-have! `(= ,x (ZERO K)) (lambda () (ai iff) (detach! `(IMPLIES (= ,(z4-n x) 0) (= ,x (ZERO K)))) (dk-ass!)))
        (ai `(NOT (= ,x (ZERO K)))))))
  (z4-and! `(<= 0 ,(z4-n x)) `(NOT (= 0 ,(z4-n x))))
  (dk-cite! 'rr-le-ne-lt 0 (z4-n x)))
;; 0 < |W| in context: land W^N /= 0
(define (z4-pow-nonzero! wv n)
  (let* ((p (z4-pw wv n)) (pw `(power ,(z4-n wv) ,n)))
    (dk-cite! 'rr-power-pos (z4-n wv) n)
    (dk-cite! 'nf-norm-of-zero 'K)
    (dk-have! `(NOT (= ,p (ZERO K)))
      (lambda ()
        (di)
        (dk-have! `(= ,(z4-n p) 0) (lambda () (subst `(= ,p (ZERO K))) (dk-ass!)))
        (dk-absurd! `(= ,(z4-n p) 0) `(= ,(z4-n p) ,pw) `(< 0 ,pw))))))

