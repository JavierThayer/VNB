;;; ALSO HERE.  Section 4: Remark 4.9 (ccr-remark-4-9: the nonzero values of |.| are the |w^k|, k in ZZ).
;;; Section 5: the FINDING on Definition 4.20 / Proposition 4.21 (nv-fractions-of-maximal: every element of K is a
;;; quotient of two elements of M(K), so the field of fractions B_F(K) of Z_F(K) is K for every F).  Section 6:
;;; representative sets (IS-NV-REP-SET): projections, the digit step and its uniqueness, |r| = 1 for r /= 0.

(define z4-view '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define (z4-n x) `((FNRM K) ,x))
(define (z4-mul x y) `((MUL K) ,x ,y))
(define (z4-pw x n) `(RING-POWER ,z4-view ,x ,n))
