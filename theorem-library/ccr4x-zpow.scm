            (subst `(= x ,(z4-mul z u)))
            (subst `(= ,(z4-n (z4-mul z u)) (* ,(z4-n z) ,(z4-n u))))
            (subst `(= ,(z4-n u) 1))
            (dk-ineq! `(IN ,(z4-n z) RR)))))))
(qed 'ccr-remark-4-9)

;;; -----------------------------------------------------------------------
;;; 5. FINDING on Definition 4.20 / Proposition 4.21: Z_F(K) contains M(K) (the elements of M map to 0, which
;;; lies in every subfield F), and every element of K is a quotient of two elements of M(K).  Hence the field
;;; of fractions B_F(K) of Z_F(K) is K itself for EVERY F; Proposition 4.21's claim Z(B_F(K)) = Z_F(K) then
;;; fails as soon as F is a proper subfield of the residue field.
(define z4-Z '(NV-INTEGERS K))
(define z4-M '(NV-MAXIMAL K (NV-INTEGERS K)))
;; V in CARR K and |V| < 1 in context: land V in Z(K) and V in M(K)
(define (z4-in-M! v)
  (dk-have! `(IN ,v ,z4-Z) (lambda () (subst (dk-cite! 'nv-integers-unfold 'K)) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ineq! `(< ,(z4-n v) 1))))))
  (dk-have! `(IN ,v ,z4-M) (lambda () (subst (dk-cite! 'nv-maximal-unfold 'K z4-Z)) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!))))))
;; land (* P Q) in RR
(define (z4-rr-mul! p q)
  (if (not (dk-asm? `(IN (* ,p ,q) RR)))
      (begin
        (if (not (dk-asm? `(AND (IN ,p RR) (IN ,q RR))))
            (dk-have! `(AND (IN ,p RR) (IN ,q RR)) (lambda () (dk-conj-close! (lambda () (dk-ass!))))))
        (dk-cite! 'rr-mul-closed p q))))
;; T in CARR K, 0 < |T| in context: land T /= ZERO K
(define (z4-nonzero-of-pos! t)
  (dk-cite! 'nf-norm-of-zero 'K)
  (dk-have! `(NOT (= ,t (ZERO K)))
    (lambda ()
      (di)
      (dk-have! `(= ,(z4-n t) 0) (lambda () (subst `(= ,t (ZERO K))) (dk-ass!)))
      (dk-absurd! `(= ,(z4-n t) 0) `(< 0 ,(z4-n t))))))

;; the body of IS-FRACTIONS-OF(K, M(K)) with this file's binders (the definition's own binder cwx_ is also the
;; binder of NV-INTEGERS, and an eigenvariable of that name collides with it under the unfolds)
(define z4-frac-body
  `(FORALL x (IMPLIES (IN x (CARR K))
     (FORSOME fu (AND (IN fu ,z4-M) (FORSOME fv (AND (IN fv ,z4-M) (AND (NOT (= fv (ZERO K))) (= ((MUL K) x fv) fu)))))))))
(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL w (IMPLIES (IN w (CARR K)) (IMPLIES (NOT (= w (ZERO K)))
  (IMPLIES (< ,(z4-n 'w) 1) ,z4-frac-body))))))))
(dk-peel!)
(dk-cite! 'nv-field-normed 'K)
(dk-cite! 'nf-zero-in-carr 'K) (dk-cite! 'nf-one-in-carr 'K) (dk-cite! 'nf-norm-of-zero 'K) (dk-cite! 'nf-norm-one 'K)
(fact 'rr-zero-in)
(z4-norm-pos! 'w)
(let ((x 'x))
  (z4-typek! x)
  (fact 'rr-one-in)
  (z4-and! `(IN ,(z4-n x) RR) '(IN 1 RR))
  (dk-or-each! (dk-cite! 'rr-leq-total (z4-n x) 1)
    (lambda (c)
      (if (equal? c `(<= ,(z4-n x) 1))
          ;; x = (x w) / w
          (let ((xw (z4-mul x 'w)))
            (dk-cite! 'nf-mul-in-carr 'K x 'w)
            (dk-cite! 'nf-norm-mult 'K x 'w)
            (z4-typek! xw)
            (dk-cite! 'rr-mul-le-right (z4-n x) 1 (z4-n 'w))
            (z4-rr-mul! (z4-n x) (z4-n 'w)) (z4-rr-mul! 1 (z4-n 'w))
            (dk-have! `(< ,(z4-n xw) 1)
              (lambda () (dk-ineq! `(= ,(z4-n xw) (* ,(z4-n x) ,(z4-n 'w))) `(<= (* ,(z4-n x) ,(z4-n 'w)) (* 1 ,(z4-n 'w)))
                                   `(< ,(z4-n 'w) 1) `(IN ,(z4-n 'w) RR) `(IN ,(z4-n x) RR))))
            (z4-in-M! xw)
            (z4-in-M! 'w)
            (ew xw)
            (dk-conj-close! (lambda () (if (not (dk-ass!)) (begin (ew 'w) (dk-conj-close! (lambda () (if (not (dk-ass!)) (rfl)))))))))
          ;; 1 <= |x|: x = w / (y w) with x y = 1
          (let* ((y (begin
                      (dk-have! `(< 0 ,(z4-n x)) (lambda () (dk-ineq! c `(IN ,(z4-n x) RR))))
                      (z4-nonzero-of-pos! x)
                      (dk-skolem! (dk-chain-ass! (dk-cite! 'nf-inverse 'K x)))))
                 (wy (z4-mul y 'w)))
            (z4-typek! y)
            (z4-norm-pos! y)
            (dk-cite! 'nf-norm-mult 'K x y)
            (dk-have! `(= (* ,(z4-n x) ,(z4-n y)) 1)
              (lambda () (subst `(= (* ,(z4-n x) ,(z4-n y)) ,(z4-n (z4-mul x y)))) (subst `(= ,(z4-mul x y) (ONE K))) (dk-ass!)))
            (dk-cite! 'rr-mul-le-right 1 (z4-n x) (z4-n y))
            (z4-rr-mul! (z4-n x) (z4-n y)) (z4-rr-mul! 1 (z4-n y))
            (dk-have! `(<= ,(z4-n y) 1)
              (lambda () (dk-ineq! `(<= (* 1 ,(z4-n y)) (* ,(z4-n x) ,(z4-n y))) `(= (* ,(z4-n x) ,(z4-n y)) 1) `(IN ,(z4-n y) RR))))
            (dk-cite! 'rr-mul-le-right (z4-n y) 1 (z4-n 'w))
            (z4-rr-mul! (z4-n y) (z4-n 'w)) (z4-rr-mul! 1 (z4-n 'w))
            (dk-cite! 'nf-mul-in-carr 'K y 'w)
            (dk-cite! 'nf-norm-mult 'K y 'w)
            (z4-typek! wy)
            (dk-have! `(< ,(z4-n wy) 1)
              (lambda () (dk-ineq! `(= ,(z4-n wy) (* ,(z4-n y) ,(z4-n 'w))) `(<= (* ,(z4-n y) ,(z4-n 'w)) (* 1 ,(z4-n 'w)))
                                   `(< ,(z4-n 'w) 1) `(IN ,(z4-n y) RR) `(IN ,(z4-n 'w) RR))))
            (z4-and! `(< 0 ,(z4-n y)) `(< 0 ,(z4-n 'w)))
            (dk-cite! 'rr-mul-pos (z4-n y) (z4-n 'w))
            (dk-have! `(< 0 ,(z4-n wy)) (lambda () (subst `(= ,(z4-n wy) (* ,(z4-n y) ,(z4-n 'w)))) (dk-ass!)))
            (z4-nonzero-of-pos! wy)
            (z4-in-M! 'w)
            (z4-in-M! wy)
            (ew 'w)
            (dk-conj-close!
              (lambda ()
                (if (not (dk-ass!))
                    (begin
                      (ew wy)
                      (dk-conj-close!
                        (lambda ()
                          (if (not (dk-ass!))
                              (begin
                                (subst (z4-ring-eq! `(= ,(z4-mul x wy) ,(z4-mul 'w (z4-mul x y))) (list x 'w y)))
                                (subst `(= ,(z4-mul x y) (ONE K)))
                                (z4-crs! (list 'w)))))))))))))))
(qed 'nv-fractions-of-maximal-explicit)

(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL w (IMPLIES (IN w (CARR K)) (IMPLIES (NOT (= w (ZERO K)))
  (IMPLIES (< ,(z4-n 'w) 1) (IS-FRACTIONS-OF K ,z4-M)))))))))
(dk-peel!)
(mac 'is-fractions-of)
(dk-cite! 'nv-fractions-of-maximal-explicit 'K 'w)
(dk-ass!)
(qed 'nv-fractions-of-maximal)

;;; -----------------------------------------------------------------------
;;; 6. Section 4.4: representative sets (IS-NV-REP-SET, ccr4x-vocab).  The projections, the digit step of the
;;; proof of Proposition 4.17 (every z in Z(K) is r + d w with r in R, d in Z(K)), its uniqueness (the notes'
;;; "if x, y in R and x = y mod M then x = y", carried to the remainder), and the fact used in Remark 4.18 that
;;; the nonzero elements of R have absolute value 1.
(define (z4-add x y) `((ADD K) ,x ,y))
(define (z4-d x y) `((ADD K) ,x ((NEG K) ,y)))
(define (z4-open-sep! name h)
  (let ((s (car (dk-landed (lambda () (mac-h name h))))))
    (dk-landed (lambda () (sep-me s)))))
(define (z4-rep-proj! name concl)
  (dk-sp-qed! (make-wff `(FORALL K (FORALL A (FORALL RP (IMPLIES (IS-NV-REP-SET K A RP) ,concl)))))
              (lambda ()
                (di) (di)
                (mac-h 'is-nv-rep-set '(IS-NV-REP-SET K A RP))
                (dk-split-all!)
                (dk-ass!))
              name))
(z4-rep-proj! 'nv-rep-set-sub '(FORALL rpx_ (IMPLIES (IN rpx_ RP) (IN rpx_ A))))
(z4-rep-proj! 'nv-rep-set-zero '(IN (ZERO K) RP))
(z4-rep-proj! 'nv-rep-set-one '(IN (ONE K) RP))
(z4-rep-proj! 'nv-rep-set-exists
  '(FORALL rpx_ (IMPLIES (IN rpx_ A) (FORSOME rpy_ (AND (IN rpy_ RP) (< ((FNRM K) ((ADD K) rpx_ ((NEG K) rpy_))) 1))))))
(z4-rep-proj! 'nv-rep-set-unique
  '(FORALL rpx_ (IMPLIES (IN rpx_ RP) (FORALL rpy_ (IMPLIES (IN rpy_ RP)
     (IMPLIES (< ((FNRM K) ((ADD K) rpx_ ((NEG K) rpy_))) 1) (= rpx_ rpy_)))))))

(define z4-rhyps (append z4-hyps '((IS-NV-REP-SET K A RP))))
;; |w| < 1 (w lies in its own principal ideal = M(A))
(define (z4-w-small!)
  (dk-cite! 'nv-domain-one 'K 'A)
  (dk-have! '(IN w (NV-PRINCIPAL K A w))
    (lambda ()
      (subst (dk-cite! 'nv-principal-unfold 'K 'A 'w))
      (in-sep! (lambda () (dk-ass!))
               (lambda () (ew '(ONE K)) (dk-conj-close! (lambda () (if (not (dk-ass!)) (z4-crs! (list 'w)))))))))
  (let ((hm (dk-rewrite-h! '(IN w (NV-PRINCIPAL K A w)) '(NV-PRINCIPAL K A w) '(NV-MAXIMAL K A))))
    (z4-open-sep! 'nv-maximal-unfold hm)))

(sp (make-wff `(FORALL K (FORALL A (FORALL w (FORALL RP ,(z4-curry z4-rhyps
  `(FORALL z (IMPLIES (IN z A)
     (FORSOME ra (AND (IN ra RP) (FORSOME d (AND (IN d A) (= z ,(z4-add 'ra (z4-mul 'd 'w))))))))))))))))
(dk-peel!)
(z4-setup!)
(let* ((ra (dk-skolem! (dk-cite! 'nv-rep-set-exists 'K 'A 'RP 'z)))
       (t (z4-d 'z ra)))
  (dk-cite! 'nv-rep-set-sub 'K 'A 'RP ra)
  (dk-cite! 'nv-domain-sub 'K 'A ra) (dk-cite! 'nv-domain-sub 'K 'A 'z)
  (dk-cite! 'nv-domain-neg 'K 'A ra)
  (dk-cite! 'nv-domain-add 'K 'A 'z `((NEG K) ,ra))
  (dk-cite! 'nv-domain-sub 'K 'A t)
  (dk-have! `(IN ,t (NV-MAXIMAL K A))
    (lambda () (subst (dk-cite! 'nv-maximal-unfold 'K 'A)) (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!)))))
  (let* ((h (dk-rewrite-h! `(IN ,t (NV-MAXIMAL K A)) '(NV-MAXIMAL K A) '(NV-PRINCIPAL K A w)))
         (ls (z4-open-sep! 'nv-principal-unfold h))
         (d (dk-skolem! (car (filter (lambda (f) (dk-head-is? f 'FORSOME)) ls)))))
    (dk-cite! 'nv-domain-sub 'K 'A d)
    (ew ra)
    (dk-conj-close!
      (lambda ()
        (if (not (dk-ass!))
            (begin
              (ew d)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin (subst `(= ,(z4-mul d 'w) ,t)) (z4-crs! (list 'z ra))))))))))))
(qed 'nv-rep-digit-step)

(sp (make-wff `(FORALL K (FORALL A (FORALL w (FORALL RP ,(z4-curry z4-rhyps
  `(FORALL ra (IMPLIES (IN ra RP) (FORALL rb (IMPLIES (IN rb RP) (FORALL d (IMPLIES (IN d A) (FORALL d2 (IMPLIES (IN d2 A)
     (IMPLIES (= ,(z4-add 'ra (z4-mul 'd 'w)) ,(z4-add 'rb (z4-mul 'd2 'w))) (AND (= ra rb) (= d d2))))))))))))))))))
(dk-peel!)
(z4-setup!)
(z4-w-small!)
(let* ((dw (z4-mul 'd 'w)) (d2w (z4-mul 'd2 'w)) (dd (z4-d 'd2 'd))
       (h `(= ,(z4-add 'ra dw) ,(z4-add 'rb d2w)))
       (e `(= ,(z4-d 'ra 'rb) ,(z4-mul dd 'w))))
  (for-each (lambda (x) (dk-cite! 'nv-rep-set-sub 'K 'A 'RP x)) '(ra rb))
  (for-each (lambda (x) (dk-cite! 'nv-domain-sub 'K 'A x)) '(ra rb d d2))
  (dk-cite! 'nv-domain-neg 'K 'A 'd)
  (dk-cite! 'nv-domain-add 'K 'A 'd2 '((NEG K) d))
  (dk-cite! 'nv-domain-sub 'K 'A dd)
  (dk-cite! 'nv-domain-norm 'K 'A dd)
  (dk-cite! 'nf-mul-in-carr 'K 'd 'w) (dk-cite! 'nf-mul-in-carr 'K 'd2 'w)
  (dk-have! e
    (lambda ()
      (subst (z4-ring-eq! `(= ,(z4-d 'ra 'rb) ,(z4-add (z4-d (z4-add 'ra dw) (z4-add 'rb d2w)) (z4-mul dd 'w)))
                          (list 'ra 'rb 'd 'd2 'w)))
      (subst h)
      (z4-crs! (list 'rb 'd2 'd 'w))))
  (dk-cite! 'nf-mul-in-carr 'K dd 'w)
  (dk-cite! 'nf-norm-mult 'K dd 'w)
  (z4-typek! dd) (z4-typek! (z4-mul dd 'w))
  (fact 'rr-one-in)
  (dk-cite! 'rr-mul-le-right (z4-n dd) 1 (z4-n 'w))
  (z4-rr-mul! (z4-n dd) (z4-n 'w)) (z4-rr-mul! 1 (z4-n 'w))
  (dk-have! `(< ,(z4-n (z4-d 'ra 'rb)) 1)
    (lambda ()
      (subst e)
      (dk-ineq! `(= ,(z4-n (z4-mul dd 'w)) (* ,(z4-n dd) ,(z4-n 'w))) `(<= (* ,(z4-n dd) ,(z4-n 'w)) (* 1 ,(z4-n 'w)))
                `(< ,(z4-n 'w) 1) `(IN ,(z4-n 'w) RR))))
  (dk-cite! 'nv-rep-set-unique 'K 'A 'RP 'ra 'rb)
  (dk-have! `(= ,dw ,d2w)
    (lambda ()
      (subst (z4-ring-eq! `(= ,dw ,(z4-add (z4-add 'ra dw) '((NEG K) ra))) (list 'ra 'd 'w)))
      (subst h)
      (subst '(= rb ra))
      (z4-crs! (list 'ra 'd2 'w))))
  (dk-cite! 'nf-mul-cancel 'K 'd 'd2 'w)
  (dk-conj-close! (lambda () (dk-ass!))))
(qed 'nv-rep-digit-unique)

(sp (make-wff `(FORALL K (FORALL A (FORALL w (FORALL RP ,(z4-curry z4-rhyps
  `(FORALL ra (IMPLIES (IN ra RP) (IMPLIES (NOT (= ra (ZERO K))) (= ,(z4-n 'ra) 1)))))))))))
(dk-peel!)
(z4-setup!)
(dk-cite! 'nv-rep-set-sub 'K 'A 'RP 'ra)
(dk-cite! 'nv-domain-sub 'K 'A 'ra)
(dk-cite! 'nv-domain-norm 'K 'A 'ra)
(dk-cite! 'nv-rep-set-zero 'K 'A 'RP)
(z4-typek! 'ra)
(fact 'rr-one-in)
(dk-have! `(NOT (< ,(z4-n 'ra) 1))
  (lambda ()
    (di)
    (dk-have! `(= ,(z4-d 'ra '(ZERO K)) ra) (lambda () (z4-crs! (list 'ra))))
    (dk-have! `(< ,(z4-n (z4-d 'ra '(ZERO K))) 1) (lambda () (subst `(= ,(z4-d 'ra '(ZERO K)) ra)) (dk-ass!)))
    (dk-cite! 'nv-rep-set-unique 'K 'A 'RP 'ra '(ZERO K))
    (ai '(NOT (= ra (ZERO K))))))
(dk-cite! 'rr-not-lt-ge (z4-n 'ra) 1)
(dk-ineq! `(<= ,(z4-n 'ra) 1) `(<= 1 ,(z4-n 'ra)) `(IN ,(z4-n 'ra) RR))
(qed 'nv-rep-set-norm-one)
