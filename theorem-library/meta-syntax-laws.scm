          (let ((o2 (dk-meta-union-open! d)))
            (oi-r)
            (dk-meta-or-each! o2
              (lambda (d2)
                (if (equal? (caddr d2) '(CARTESIAN (PAIR 1 1) NN)) (oi-l) (oi-r))
