(define mx-sn '(EXPR-STAGE n))
(define mx-c3 '(CARTESIAN (PAIR 3 3) NN (TUPLES (EXPR-STAGE n))))
(define mx-c4 '(CARTESIAN (PAIR 4 4) NN NN (TUPLES (EXPR-STAGE n)) (EXPR-STAGE n)))

(sp (make-wff '(FORALL n (FORALL m
   (IMPLIES (IN n NN) (IMPLIES (IN m (EXPR-STAGE (succ n)))
     (OR (IN m (EXPR-STAGE n))
         (OR (FORSOME h (AND (IN h NN) (FORSOME l (AND (IN l (TUPLES (EXPR-STAGE n))) (= m (EAPP h l))))))
             (FORSOME h (AND (IN h NN) (FORSOME nb (AND (IN nb NN)
               (FORSOME a (AND (IN a (TUPLES (EXPR-STAGE n)))
                 (FORSOME b (AND (IN b (EXPR-STAGE n)) (= m (EBIND h nb a b))))))))))))))))))
(dk-peel!)
(let ((o1 (dk-meta-union-open! (dk-meta-stage-open! 'm '(succ n)))))
  (dk-meta-or-each! o1
    (lambda (d)
      (if (equal? (caddr d) mx-sn)
          (begin (oi-l) (ass))
          (let ((o2 (dk-meta-union-open! d)))
            (oi-r)
            (dk-meta-or-each! o2
              (lambda (d2)
                (if (equal? (caddr d2) mx-c3) (oi-l) (oi-r))
                (mx-ex-close! (cdr (dk-meta-unpack! (dk-meta-cart-open! d2)))))))))))
(qed 'expr-stage-succ-cases)

;;; S_j is included in S_(j + d).  The induction variable d is OUTERMOST, as `ni' needs it.
(sp (make-wff '(FORALL d (IMPLIES (IN d NN)
   (FORALL j (FORALL m
     (IMPLIES (IN j NN) (IMPLIES (IN m (EXPR-STAGE j)) (IN m (EXPR-STAGE (+ j d)))))))))))
(let ((cs (dk-meta-ni-cases!)))
  (dk-focus! (car cs))
  (dk-peel!)
  (subst (dk-cite! 'nn-add-zero 'j))
  (ass)
  (dk-focus! (cadr cs))
  (let* ((landed (dk-peel!))
         (ih (or (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)
                 (error "expr-stage-add: no induction hypothesis")))
         (g (dk-goal))                          ; (IN m (EXPR-STAGE (+ j (succ n))))
         (m (cadr g)) (sum (cadr (caddr g)))
         (j (cadr sum)) (n (cadr (caddr sum))))
    (subst (dk-cite! 'nn-add-succ j n))
    (dk-meta-and! `(IN ,j NN) `(IN ,n NN))
    (fact 'nn-add-closed j n)
    (dk-apply! ih j m)
    (fact 'expr-stage-keep `(+ ,j ,n) m)
    (ass)))
(qed 'expr-stage-add)

