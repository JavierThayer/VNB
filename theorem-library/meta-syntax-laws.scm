(sp (make-wff '(FORALL m (IMPLIES (IN m (EXPR-STAGE 0))
   (OR (FORSOME c (AND (IN c NN) (= m (EFVAR c))))
       (OR (FORSOME c (AND (IN c NN) (= m (EBVAR c))))
           (FORSOME c (AND (IN c NN) (= m (ECONST c))))))))))
(dk-peel!)
(let ((o1 (dk-meta-union-open! (dk-meta-stage-open! 'm 0))))
