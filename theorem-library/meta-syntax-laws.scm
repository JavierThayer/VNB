;; section META (prefix dk-meta-); the ones below are local to this file.


(define mx-constructors '(EFVAR EBVAR ECONST EAPP EBIND))

;; The goal (= m X), X built by the constructors: unfold them, replace m by the literal list the
;; context equates it with, the tag variable by its numeral.
(define (mx-eq-close!)
  (for-each (lambda (f) (if (dk-contains? (dk-goal) f) (mac f))) mx-constructors)
  (if (equal? (cadr (dk-goal)) (caddr (dk-goal)))
      (rfl)
      (let* ((g (dk-goal)) (m (cadr g))
             (meq (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) m)
                                               (dk-head-is? (caddr f) 'LIST)))
                              (dk-asms))))
        (if (not meq) (error "mx-eq-close!: no list equation for" m))
        (subst meq)
        (let ((tagv (cadr (caddr meq))))
          (if (symbol? tagv)
              (subst (or (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) tagv)
                                                      (number? (caddr f))))
                                     (dk-asms))
                         (error "mx-eq-close!: no tag equation for" tagv)))))
        (rfl))))

;; Close FORSOME x1 (AND (IN x1 C1) (FORSOME x2 ... (= m X))) with the witnesses WS.
(define (mx-ex-close! ws)
  (if (null? ws)
      (mx-eq-close!)
      (begin
        (ew (car ws))
        (dk-each-leaf! (lambda () (di))
          (lambda ()
            (cond ((dk-head-is? (dk-goal) 'FORSOME) (mx-ex-close! (cdr ws)))
                  ((dk-head-is? (dk-goal) '=) (mx-eq-close!))
                  (#t (dk-meta-close-in!))))))))


