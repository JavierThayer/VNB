;;; 2. The class of expressions.

(sp (make-wff '(FORALL n (FORALL m
   (IMPLIES (IN n NN) (IMPLIES (IN m (EXPR-STAGE n)) (IN m EXPR-SET)))))))
(dk-peel!)
(subst (dk-cite! 'expr-set-def))
(dk-each-leaf! (lambda () (bu-mi 'n)) (lambda () (ass)))
(qed 'expr-set-intro)

(sp (make-wff '(FORALL m
   (IMPLIES (IN m EXPR-SET) (FORSOME n (AND (IN n NN) (IN m (EXPR-STAGE n))))))))
(dk-peel!)
(let* ((eqn (dk-cite! 'expr-set-def))
       (bu `(IN m ,(caddr eqn))))
  (dk-have! bu (lambda () (subst `(= ,(caddr eqn) EXPR-SET)) (ass)))
  (let ((before (dk-asms)))
    (bu-me bu)
    (let ((typ (find-first (lambda (f) (and (not (member f before)) (dk-head-is? f 'IN)
                                            (eq? (caddr f) 'NN)))
                           (dk-asms))))
      (ew (cadr typ))
      (dk-conj-close! (lambda () (ass))))))
(qed 'expr-set-elim)


;; (IN t SET) for t built from symbols with a sethood in context, NN, numeral singletons, UNION,
;; TUPLES and CARTESIAN (binary, ternary, 5-ary).
(define (mx-set! t)
  (let ((goal `(IN ,t SET)))
    (cond
      ((dk-asm? goal) goal)
      ((eq? t 'NN) (fact 'nn-is-set) goal)
      ((and (pair? t) (eq? (car t) 'PAIR))
       (dk-meta-num-set! (cadr t))
       (dk-meta-and! `(IN ,(cadr t) SET) `(IN ,(caddr t) SET))
       (fact 'pairing (cadr t) (caddr t))
       goal)
      ((and (pair? t) (eq? (car t) 'UNION))
       (mx-set! (cadr t)) (mx-set! (caddr t))
       (dk-meta-and! `(IN ,(cadr t) SET) `(IN ,(caddr t) SET))
       (fact 'union-set-closure (cadr t) (caddr t))
       goal)
      ((and (pair? t) (eq? (car t) 'TUPLES))
       (mx-set! (cadr t))
       (fact 'tuples-sethood (cadr t))
       goal)
      ((and (pair? t) (eq? (car t) 'CARTESIAN) (= (length t) 3))
       (mx-set! (cadr t)) (mx-set! (caddr t))
       (let ((both (dk-meta-and! `(IN ,(cadr t) SET) `(IN ,(caddr t) SET))))
         (fact 'cartesian-set-iff (cadr t) (caddr t))
         (dk-have! goal (lambda () (dk-meta-keep-prop! (iff-for goal) both)))
         goal))
      ((and (pair? t) (eq? (car t) 'CARTESIAN) (= (length t) 4))
       (for-each mx-set! (cdr t))
       (fact 'cartesian3-set (cadr t) (caddr t) (cadddr t))
       goal)
      ((and (pair? t) (eq? (car t) 'CARTESIAN) (= (length t) 6))
       (for-each mx-set! (cdr t))
       (apply fact 'cartesian5-set (cdr t))
       goal)
      (#t (error "mx-set!: no route to the sethood of" (expression->string t))))))

(define (mx-set-close!)
  (let ((g (dk-goal)))
    (mx-set! (cadr g))
    (if (and (alpha-equiv? (dk-goal) g) (dk-asm? g)) (ass))))

;;; The 5-ary product is a set by REPLACEMENT over the nested binary product (cartesian3-set's
;;; device, two storeys higher).
(define mx-phi5
  '(VNB-LAMBDA mxq_ (CARTESIAN mxa1_ (CARTESIAN mxa2_ (CARTESIAN mxa3_ (CARTESIAN mxa4_ mxa5_))))
     (LIST (NTH 1 mxq_) (NTH 1 (NTH 2 mxq_)) (NTH 1 (NTH 2 (NTH 2 mxq_)))
           (NTH 1 (NTH 2 (NTH 2 (NTH 2 mxq_)))) (NTH 2 (NTH 2 (NTH 2 (NTH 2 mxq_)))))))

(sp (make-wff '(FORALL mxa1_ (FORALL mxa2_ (FORALL mxa3_ (FORALL mxa4_ (FORALL mxa5_
   (IMPLIES (IN mxa1_ SET) (IMPLIES (IN mxa2_ SET) (IMPLIES (IN mxa3_ SET) (IMPLIES (IN mxa4_ SET)
     (IMPLIES (IN mxa5_ SET) (IN (CARTESIAN mxa1_ mxa2_ mxa3_ mxa4_ mxa5_) SET)))))))))))))
(dk-peel!)
(let* ((p45 '(CARTESIAN mxa4_ mxa5_))
       (p345 `(CARTESIAN mxa3_ ,p45))
       (p2345 `(CARTESIAN mxa2_ ,p345))
       (ww `(CARTESIAN mxa1_ ,p2345))
       (img `(IMAGE ,mx-phi5 ,ww))
       (sub `(SUBSET (CARTESIAN mxa1_ mxa2_ mxa3_ mxa4_ mxa5_) ,img)))
  (mx-set! ww)
  (fact 'image-set mx-phi5 ww)
  (dk-have! sub
    (lambda ()
      (mac 'subset-def)
      (di)
      (let* ((x (cadr (dk-goal)))
             (vs (dk-meta-unpack! (dk-meta-cart-open! `(IN ,x (CARTESIAN mxa1_ mxa2_ mxa3_ mxa4_ mxa5_)))))
             (a1 (car vs)) (a2 (cadr vs)) (a3 (caddr vs)) (a4 (cadddr vs)) (a5 (car (cddddr vs)))
             (q45 `(LIST ,a4 ,a5)) (q345 `(LIST ,a3 ,q45)) (q2345 `(LIST ,a2 ,q345))
             (pr `(LIST ,a1 ,q2345)))
        (dk-image-goal!)
        (ew pr)
        (fact 'pair-in-cartesian 'mxa4_ 'mxa5_ a4 a5)
        (fact 'pair-in-cartesian 'mxa3_ p45 a3 q45)
        (fact 'pair-in-cartesian 'mxa2_ p345 a2 q345)
        (fact 'pair-in-cartesian 'mxa1_ p2345 a1 q2345)
        (dk-each-leaf! (lambda () (di))
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (ass)
                (begin
                  (dk-lam-b!)
                  (let loop () (if (dk-contains? (dk-goal) 'NTH) (begin (nth-r) (loop))))
                  (subst (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) x))) (dk-asms)))
                  (rfl))))))))
  (fact 'subclass-of-set-is-set '(CARTESIAN mxa1_ mxa2_ mxa3_ mxa4_ mxa5_) img)
  (ass))
(qed 'cartesian5-set)

(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (IN (EXPR-STAGE n) SET)))))
(let ((cs (dk-meta-ni-cases!)))
  (dk-focus! (car cs))
  (subst (dk-meta-stage-eq 0))
  (mx-set-close!)
  (dk-focus! (cadr cs))
  (let* ((landed (dk-peel!))
         (stage (cadr (dk-goal)))
         (n (cadr (cadr stage))))
    (subst (dk-meta-stage-eq `(succ ,n)))
    (mx-set-close!)))
(qed 'expr-stage-set)

(sp (make-wff '(IN EXPR-SET SET)))
(subst (dk-cite! 'expr-set-def))
(dk-each-leaf! (lambda () (bu-set))
  (lambda ()
    (if (dk-head-is? (dk-goal) 'IN)
        (begin (fact 'nn-is-set) (ass))
        (begin (dk-peel!)
               (fact 'expr-stage-set (cadr (cadr (dk-goal))))
               (ass)))))
(qed 'expr-set-is-set)


;;; A list of expressions has all its entries in ONE stage.
(define mx-lis-class
  '(SEP mxy_ (TUPLES EXPR-SET)
        (FORSOME mxst_ (AND (IN mxst_ NN) (IN mxy_ (TUPLES (EXPR-STAGE mxst_)))))))

(sp (make-wff '(FORALL l (IMPLIES (IN l (TUPLES EXPR-SET))
   (FORSOME n (AND (IN n NN) (IN l (TUPLES (EXPR-STAGE n)))))))))
(dk-peel!)
(let* ((ind0 (lookup-theorem 'tuples-induction))
       (ind (subst-free (quantifier-var (quantifier-body ind0)) mx-lis-class
              (quantifier-body (subst-free (quantifier-var ind0) 'EXPR-SET (quantifier-body ind0)))))
       (prem (cadr ind))
       (h-base (cadr prem))
       (h-step (caddr prem)))
  (dk-have! h-base
    (lambda ()
      (in-sep! (lambda () (fact 'empty-in-tuples 'EXPR-SET) (ass))
               (lambda ()
                 (ew 0)
                 (dk-conj-close!
                   (lambda ()
                     (if (equal? (cadr (dk-goal)) 0)
                         (begin (fact 'nn-zero-in) (ass))
                         (begin (dk-meta-type-stages! '(EXPR-STAGE 0))
                                (fact 'empty-in-tuples '(EXPR-STAGE 0)) (ass)))))))))
  (dk-have! h-step
    (lambda ()
      (dk-peel!)
      (dk-split-all!)
      (let* ((g (dk-goal))                          ; (IN (CONS x M) C)
             (x (cadr (cadr g))) (mm (caddr (cadr g)))
             (j (begin (sep-me `(IN ,mm ,mx-lis-class))
                       (dk-skolem! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME)
                                                                (dk-contains? f mm)))
                                               (dk-asms)))))
             (i (dk-meta-set-open! x))
             (sij `(EXPR-STAGE (+ ,i ,j))))
        (dk-meta-and! `(IN ,i NN) `(IN ,j NN))
        (fact 'nn-add-closed i j)
        (fact 'expr-stage-add j i x)                    ; x in S_(i + j)
        (dk-meta-tuples-lift! mm `(EXPR-STAGE ,j) sij
          (lambda (w)
            (fact 'expr-stage-add i j w)                ; w in S_(j + i)
            (fact 'nn-add-comm i j)
            (subst `(= (+ ,i ,j) (+ ,j ,i)))
            (ass)))
        (dk-meta-and! `(IN ,x ,sij) `(IN ,mm (TUPLES ,sij)))
        (fact 'cons-in-tuples sij x mm)
        (in-sep! (lambda ()
                   (dk-meta-and! `(IN ,x EXPR-SET) `(IN ,mm (TUPLES EXPR-SET)))
                   (fact 'cons-in-tuples 'EXPR-SET x mm)
                   (ass))
                 (lambda ()
                   (ew `(+ ,i ,j))
                   (dk-conj-close! (lambda () (ass))))))))
  (dk-have! prem (lambda () (dk-conj-close! (lambda () (ass)))))
  (let ((all (dk-cite! 'tuples-induction 'EXPR-SET mx-lis-class)))
    (dk-apply! all 'l)
    (sep-me `(IN l ,mx-lis-class))
    (ass)))
(qed 'expr-list-in-some-stage)

;;; The five introductions into EXPR-SET.
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (IN (EFVAR n) EXPR-SET)))))
(dk-peel!)
(fact 'expr-stage-fvar 'n)
(fact 'nn-zero-in)
(fact 'expr-set-intro 0 '(EFVAR n))
(ass)
