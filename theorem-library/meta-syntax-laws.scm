(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (IN (EBVAR k) EXPR-SET)))))
(dk-peel!)
(fact 'expr-stage-bvar 'k)
(fact 'nn-zero-in)
(fact 'expr-set-intro 0 '(EBVAR k))
(ass)
(qed 'ebvar-in-expr)

(sp (make-wff '(FORALL c (IMPLIES (IN c NN) (IN (ECONST c) EXPR-SET)))))
(dk-peel!)
(fact 'expr-stage-const 'c)
(fact 'nn-zero-in)
(fact 'expr-set-intro 0 '(ECONST c))
(ass)
(qed 'econst-in-expr)

(sp (make-wff '(FORALL h (FORALL l (IMPLIES (IN h NN) (IMPLIES (IN l (TUPLES EXPR-SET))
   (IN (EAPP h l) EXPR-SET)))))))
(dk-peel!)
(let ((n (dk-skolem! (dk-cite! 'expr-list-in-some-stage 'l))))
  (fact 'expr-stage-app n 'h 'l)
  (fact 'nn-succ-closed n)
  (fact 'expr-set-intro `(succ ,n) '(EAPP h l))
  (ass))
(qed 'eapp-in-expr)

(sp (make-wff '(FORALL h (FORALL nb (FORALL a (FORALL b
   (IMPLIES (IN h NN) (IMPLIES (IN nb NN) (IMPLIES (IN a (TUPLES EXPR-SET)) (IMPLIES (IN b EXPR-SET)
     (IN (EBIND h nb a b) EXPR-SET)))))))))))
(dk-peel!)
(let* ((i (dk-skolem! (dk-cite! 'expr-list-in-some-stage 'a)))
       (j (dk-meta-set-open! 'b))
       (sij `(EXPR-STAGE (+ ,i ,j))))
  (dk-meta-and! `(IN ,i NN) `(IN ,j NN))
  (fact 'nn-add-closed i j)
  (dk-meta-tuples-lift! 'a `(EXPR-STAGE ,i) sij
    (lambda (w) (fact 'expr-stage-add j i w) (ass)))
  (fact 'expr-stage-add i j 'b)
  (fact 'nn-add-comm i j)
  (dk-have! `(IN b ,sij) (lambda () (subst `(= (+ ,i ,j) (+ ,j ,i))) (ass)))
  (fact 'expr-stage-bind `(+ ,i ,j) 'h 'nb 'a 'b)
  (fact 'nn-succ-closed `(+ ,i ,j))
  (fact 'expr-set-intro `(succ (+ ,i ,j)) '(EBIND h nb a b))
  (ass))
(qed 'ebind-in-expr)

;;; STRUCTURAL INDUCTION, class form, five clauses.
(define mx-ind-stmt
  '(FORALL CLS
   (IMPLIES (FORALL mxjn_ (IMPLIES (IN mxjn_ NN) (IN (EFVAR mxjn_) CLS)))
   (IMPLIES (FORALL mxjk_ (IMPLIES (IN mxjk_ NN) (IN (EBVAR mxjk_) CLS)))
   (IMPLIES (FORALL mxjc_ (IMPLIES (IN mxjc_ NN) (IN (ECONST mxjc_) CLS)))
   (IMPLIES (FORALL mxjh_ (FORALL mxjl_ (IMPLIES (IN mxjh_ NN) (IMPLIES (IN mxjl_ (TUPLES EXPR-SET))
              (IMPLIES (FORALL mxji_ (IMPLIES (IN mxji_ NN) (IMPLIES (<= 1 mxji_) (IMPLIES (<= mxji_ (LENGTH mxjl_))
                                    (IN (NTH mxji_ mxjl_) CLS)))))
                       (IN (EAPP mxjh_ mxjl_) CLS))))))
   (IMPLIES (FORALL mxjh_ (FORALL mxjnb_ (FORALL mxja_ (FORALL mxjb_
              (IMPLIES (IN mxjh_ NN) (IMPLIES (IN mxjnb_ NN) (IMPLIES (IN mxja_ (TUPLES EXPR-SET))
              (IMPLIES (IN mxjb_ EXPR-SET)
              (IMPLIES (FORALL mxji_ (IMPLIES (IN mxji_ NN) (IMPLIES (<= 1 mxji_) (IMPLIES (<= mxji_ (LENGTH mxja_))
                                    (IN (NTH mxji_ mxja_) CLS)))))
              (IMPLIES (IN mxjb_ CLS) (IN (EBIND mxjh_ mxjnb_ mxja_ mxjb_) CLS)))))))))))
     (FORALL mxje_ (IMPLIES (IN mxje_ EXPR-SET) (IN mxje_ CLS))))))))))

;; the components of the list L (in TUPLES(SN)) are in CC, from IH: forall m in SN. m in CC.
(define (mx-comps-in! l sn cc ih)
  (let ((comps `(FORALL mxi_ (IMPLIES (IN mxi_ NN) (IMPLIES (<= 1 mxi_)
                   (IMPLIES (<= mxi_ (LENGTH ,l)) (IN (NTH mxi_ ,l) ,cc)))))))
    (dk-have! comps
      (lambda ()
        (dk-peel!)
        (let ((i (cadr (cadr (dk-goal)))))
          (dk-meta-nth-in! sn i l)
          (dk-apply! ih `(NTH ,i ,l))
          (ass))))
    comps))

(sp (make-wff mx-ind-stmt))
(let* ((landed (dk-peel!))
       (g0 (dk-goal)) (m0 (cadr g0)) (cc (caddr g0))
       (hyp-with (lambda (k)
                   (or (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f k))) landed)
                       (error "expr-induction: no hypothesis for" k))))
       (h-fvar (hyp-with 'EFVAR)) (h-bvar (hyp-with 'EBVAR)) (h-const (hyp-with 'ECONST))
       (h-app (hyp-with 'EAPP)) (h-bind (hyp-with 'EBIND))
       (claim `(FORALL mxn_ (IMPLIES (IN mxn_ NN)
                 (FORALL mxm_ (IMPLIES (IN mxm_ (EXPR-STAGE mxn_)) (IN mxm_ ,cc)))))))
  (dk-have! claim
    (lambda ()
      (let ((cs (dk-meta-ni-cases!)))
        ;; base: a member of stage 0 is an FVAR, a BVAR or a CONST
        (dk-focus! (car cs))
        (dk-peel!)
        (let ((m (cadr (dk-goal))))
          (dk-meta-or-each! (dk-cite! 'expr-stage-zero-cases m)
            (lambda (d)
              (let* ((c (car (dk-meta-unpack! d)))
                     (eqn (find-first (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) m))) (dk-asms)))
                     (k (car (caddr eqn))))
                (dk-apply! (cond ((eq? k 'EFVAR) h-fvar) ((eq? k 'EBVAR) h-bvar) (#t h-const)) c)
                (subst eqn)
                (ass)))))
        ;; step
        (dk-focus! (cadr cs))
        (let* ((landed (dk-peel!))
               (ih (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed))
               (m (cadr (dk-goal)))
               (n (cadr (cadr (caddr (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) m)))
                                                 landed)))))
               (sn `(EXPR-STAGE ,n))
               (o (dk-cite! 'expr-stage-succ-cases n m)))
          (dk-meta-or-each! o
            (lambda (d)
              (cond
                ((dk-head-is? d 'IN) (dk-apply! ih m) (ass))
                ((dk-contains? d 'EAPP)
                 (let* ((vs (dk-meta-unpack! d)) (h (car vs)) (l (cadr vs)))
                   (dk-meta-lift-to-expr! l n)
                   (mx-comps-in! l sn cc ih)
                   (dk-apply! h-app h l)
                   (subst `(= ,m (EAPP ,h ,l)))
                   (ass)))
                (#t
                 (let* ((vs (dk-meta-unpack! d)) (h (car vs)) (nb (cadr vs)) (a (caddr vs)) (b (cadddr vs)))
                   (dk-meta-lift-to-expr! a n)
                   (fact 'expr-set-intro n b)
                   (mx-comps-in! a sn cc ih)
                   (dk-apply! ih b)
                   (dk-apply! h-bind h nb a b)
                   (subst `(= ,m (EBIND ,h ,nb ,a ,b)))
                   (ass))))))))))
  (let ((n (dk-meta-set-open! m0)))
    (dk-apply! claim n m0)
    (ass)))
(qed 'expr-induction)


;;; -----------------------------------------------------------------------
;;; 3. The rank: the least stage holding an expression; an expression is NEW at its rank.

(sp (make-wff '(FORALL e (IMPLIES (IN e EXPR-SET)
   (AND (IN (EXPR-RANK e) NN)
        (AND (IN e (EXPR-STAGE (EXPR-RANK e)))
             (FORALL j (IMPLIES (IN j NN) (IMPLIES (IN e (EXPR-STAGE j)) (<= (EXPR-RANK e) j))))))))))
(dk-peel!)
(mac 'EXPR-RANK)
(define mx-io
  (let find ((e (dk-goal)))
    (cond ((and (pair? e) (eq? (car e) 'IOTA)) e)
          ((pair? e) (or (find (car e)) (find (cdr e))))
          (#t #f))))
(define mx-ss '(SEP mxw2_ NN (IN e (EXPR-STAGE mxw2_))))
(define (mx-in-ss! j)
  (dk-have! `(IN ,j ,mx-ss) (lambda () (in-sep! (lambda () (ass)) (lambda () (ass))))))
(dk-each-leaf! (lambda () (iota-d mx-io))
  (lambda ()
    (if (not (dk-head-is? (dk-goal) 'FORSOME))
        (ass)
        (let* ((n0 (dk-meta-set-open! 'e)))
          (dk-have! `(AND (SUBSET ,mx-ss NN) (FORSOME n (IN n ,mx-ss)))
            (lambda ()
              (dk-conj-close!
                (lambda ()
                  (if (dk-head-is? (dk-goal) 'SUBSET)
                      (begin (mac 'subset-def) (dk-peel!) (sep-me `(IN ,(cadr (dk-goal)) ,mx-ss)) (ass))
                      (begin (ew n0) (in-sep! (lambda () (ass)) (lambda () (ass)))))))))
          (let* ((ex (dk-cite! 'nn-least-element mx-ss))
                 (r (dk-skolem! ex))
                 (least (or (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-meta-has-le? f r)))
                                        (dk-asms))
                            (error "expr-rank-prop: no least-element universal"))))
            (sep-me `(IN ,r ,mx-ss))
            (ew r)
            (dk-each-leaf! (lambda () (di))
              (lambda ()
                (if (dk-head-is? (dk-goal) 'AND)
                    (dk-conj-close!
                      (lambda ()
                        (if (dk-head-is? (dk-goal) 'FORALL)
                            (let* ((landed (dk-peel!)) (j (caddr (dk-goal))))
                              (mx-in-ss! j)
                              (dk-apply! least j)
                              (ass))
                            (ass))))
                    (let* ((landed (dk-peel!))
                           (y (caddr (dk-goal))))
                      (dk-split-all!)
                      (mx-in-ss! y)
                      (dk-apply! least y)
                      (dk-apply! (or (find-first (lambda (f) (and (dk-head-is? f 'FORALL)
                                                                  (dk-meta-has-le? f y)))
                                                 (dk-asms))
                                     (error "expr-rank-prop: no minimality for the second index"))
                                 r)
                      (fact 'nn-le-antisym r y)
                      (ass))))))))))
(qed 'expr-rank-prop)


;; X (a constructor term of tag >= 3) is in S_0: absurd.
(define (mx-not-stage0! x)
  (dk-meta-or-each! (dk-cite! 'expr-stage-zero-cases x)
    (lambda (d) (dk-meta-unpack! d) (dk-meta-absurd-eq! (dk-meta-eq-of x)))))

;;; The stage-0 nodes have rank 0.
(define (mx-rank0! ctor stage-law)
  (lambda ()
    (dk-peel!)
    (let ((x (cadr (cadr (dk-goal)))))
      (fact stage-law (cadr x))
      (fact 'nn-zero-in)
      (fact 'expr-set-intro 0 x)
      (let ((r (dk-meta-rank! x)))
        (dk-apply! (dk-meta-rank-min x) 0)
        (dk-nn! `(<= ,r 0))))))

(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (= (EXPR-RANK (EFVAR n)) 0)))))
((mx-rank0! 'EFVAR 'expr-stage-fvar))
(qed 'expr-rank-fvar)
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (= (EXPR-RANK (EBVAR n)) 0)))))
((mx-rank0! 'EBVAR 'expr-stage-bvar))
(qed 'expr-rank-bvar)
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (= (EXPR-RANK (ECONST n)) 0)))))
((mx-rank0! 'ECONST 'expr-stage-const))
(qed 'expr-rank-const)

;; Driver of the two "new at its rank" laws: X the node (in EXPR-SET, in context); WITNESS-CASE
;; is called on the succ-cases disjunct of X's own kind with the unpacked variables, and must
;; land the injectivity equations.
(define (mx-rank-new! x own-kind finish)
  (let* ((r (dk-meta-rank! x))
         (o (dk-cite! 'nn-zero-or-succ r)))
    (dk-each-leaf! (lambda () (ai o))
      (lambda ()
        (if (dk-asm? `(= ,r 0))
            (begin
              (dk-have! `(IN ,x (EXPR-STAGE 0)) (lambda () (subst `(= 0 ,r)) (ass)))
              (mx-not-stage0! x))
            (let* ((q (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f r)))
                                           "the predecessor of the rank"))))
              (dk-split-all!)
              (dk-have! `(IN ,x (EXPR-STAGE (succ ,q))) (lambda () (subst `(= (succ ,q) ,r)) (ass)))
              (dk-have! `(NOT (IN ,x (EXPR-STAGE ,q)))
                (lambda ()
                  (di)
                  (dk-apply! (dk-meta-rank-min x) q)
                  (fact 'nn-le-imp-neq-succ q r)
                  (ai `(NOT (= ,r (succ ,q))))))
              (dk-meta-or-each! (dk-cite! 'expr-stage-succ-cases q x)
                (lambda (d)
                  (cond ((dk-head-is? d 'IN) (ai `(NOT (IN ,x (EXPR-STAGE ,q)))))
                        ((eq? (dk-meta-disjunct-kind d) own-kind)
                         (let ((vs (dk-meta-unpack! d)))
                           (finish q vs)))
                        (#t (dk-meta-unpack! d) (dk-meta-absurd-eq! (dk-meta-eq-of x))))))))))))

(sp (make-wff '(FORALL h (FORALL l (IMPLIES (IN h NN) (IMPLIES (IN l (TUPLES EXPR-SET))
   (FORSOME k (AND (IN k NN) (AND (= (EXPR-RANK (EAPP h l)) (succ k))
     (AND (IN l (TUPLES (EXPR-STAGE k))) (NOT (IN (EAPP h l) (EXPR-STAGE k)))))))))))))
(dk-peel!)
(fact 'eapp-in-expr 'h 'l)
(mx-rank-new! '(EAPP h l) 'EAPP
  (lambda (q vs)
    (let ((h2 (car vs)) (l2 (cadr vs)))
      (fact 'eapp-injective 'h 'l h2 l2)
      (dk-split-all!)
      (ew q)
      (dk-conj-close!
        (lambda ()
          (cond ((dk-asm? (dk-goal)) (ass))
                ((dk-head-is? (dk-goal) 'IN) (subst `(= l ,l2)) (ass))
                (#t (error "expr-rank-app: unexpected conjunct" (dk-goal)))))))))
(qed 'expr-rank-app)

(sp (make-wff '(FORALL h (FORALL nb (FORALL a (FORALL b
   (IMPLIES (IN h NN) (IMPLIES (IN nb NN) (IMPLIES (IN a (TUPLES EXPR-SET)) (IMPLIES (IN b EXPR-SET)
     (FORSOME k (AND (IN k NN) (AND (= (EXPR-RANK (EBIND h nb a b)) (succ k))
       (AND (IN a (TUPLES (EXPR-STAGE k)))
            (AND (IN b (EXPR-STAGE k)) (NOT (IN (EBIND h nb a b) (EXPR-STAGE k))))))))))))))))))
(dk-peel!)
(fact 'ebind-in-expr 'h 'nb 'a 'b)
(mx-rank-new! '(EBIND h nb a b) 'EBIND
  (lambda (q vs)
    (let ((h2 (car vs)) (nb2 (cadr vs)) (a2 (caddr vs)) (b2 (cadddr vs)))
      (fact 'ebind-injective 'h 'nb 'a 'b h2 nb2 a2 b2)
      (dk-split-all!)
      (ew q)
      (dk-conj-close!
        (lambda ()
          (cond ((dk-asm? (dk-goal)) (ass))
                ((and (dk-head-is? (dk-goal) 'IN) (equal? (cadr (dk-goal)) 'a)) (subst `(= a ,a2)) (ass))
                ((dk-head-is? (dk-goal) 'IN) (subst `(= b ,b2)) (ass))
                (#t (error "expr-rank-bind: unexpected conjunct" (dk-goal)))))))))
(qed 'expr-rank-bind)

;;; A member of MAKE-SET(l) for l in TUPLES(C) is in C.
(sp (make-wff '(FORALL CLS (FORALL l (FORALL w
   (IMPLIES (IN l (TUPLES CLS)) (IMPLIES (IN w (MAKE-SET l)) (IN w CLS))))))))
(dk-peel!)
(fact 'make-set-membership 'w 'l)
(let ((iff (iff-for '(IN w (MAKE-SET l)))))
  (dk-have! (caddr iff) (lambda () (dk-meta-keep-prop! iff '(IN w (MAKE-SET l)))))
  (dk-split-all!)
  (let ((i (dk-skolem! (dk-pick (lambda (f) (dk-head-is? f 'FORSOME)) "the index"))))
    (dk-split-all!)
    (dk-meta-nth-in! 'CLS i 'l)
    (subst `(= w (NTH ,i l)))
    (ass)))
(qed 'makeset-member-in)

;;; -----------------------------------------------------------------------
;;; 4. THE STRUCTURAL-RECURSION KIT (route A): for a per-stage map F_n (a def-by-nn-recursion
;;; whose step has the keep clause) and the operation G(e) = F_rank(e)(e), three laws, by one
;;; driver each, parameterised by the map:
;;;     STEP  F_(succ k)(e) == F_k(e)            for e in S_k        (one beta, one IF)
;;;     COH   F_(j + d)(e) == F_j(e)             for e in S_j        (induction on d)
;;;     AT    G(e) == F_j(e)                     for e in S_j        (the rank, nn-le-gap, COH)
;;; This is the interface a `def-by-structural-recursion' form would generate (report, s.2).


;;; -----------------------------------------------------------------------
;;; 5. FV.

(dk-meta-struct-laws! (lambda (n) `(FV-STAGE ,n)) (lambda (e) `(EXPR-FV ,e)) '()
                 'fv-stage-zero 'fv-stage-succ 'fv-stage-step 'fv-stage-coh 'expr-fv-at)


;; the element step for an operation read off at stage k: w in MAKE-SET(l), l in TUPLES(S_k).
(define (mx-elem-at! at pv k l)
  (lambda (w)
    (dk-meta-type-stages! `(EXPR-STAGE ,k))
    (fact 'makeset-member-in `(EXPR-STAGE ,k) l w)
    (apply dk-cite! at (append pv (list k w)))))


(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (== (EXPR-FV (EFVAR n)) (PAIR n n))))))
(dk-peel!)
(dk-meta-val0! '(EFVAR n) 'expr-stage-fvar 'expr-fv-at 'fv-stage-zero '() '(#t)
  (lambda () (dk-meta-nth-r!) (qrfl)))
(qed 'fv-efvar)

(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (== (EXPR-FV (EBVAR k)) EMPTY-SET)))))
(dk-peel!)
(dk-meta-val0! '(EBVAR k) 'expr-stage-bvar 'expr-fv-at 'fv-stage-zero '() '(#f) (lambda () (qrfl)))
(qed 'fv-ebvar)

(sp (make-wff '(FORALL c (IMPLIES (IN c NN) (== (EXPR-FV (ECONST c)) EMPTY-SET)))))
(dk-peel!)
(dk-meta-val0! '(ECONST c) 'expr-stage-const 'expr-fv-at 'fv-stage-zero '() '(#f) (lambda () (qrfl)))
(qed 'fv-econst)

(sp (make-wff '(FORALL h (FORALL l (IMPLIES (IN h NN) (IMPLIES (IN l (TUPLES EXPR-SET))
   (== (EXPR-FV (EAPP h l)) (BIG-UNION mxw_ (MAKE-SET l) (EXPR-FV mxw_)))))))))
(dk-peel!)
(dk-meta-makeset-set! 'l)
(let ((k (dk-meta-new-at! '(EAPP h l))))
  (dk-meta-val-succ! '(EAPP h l) k 'expr-fv-at 'fv-stage-succ '() '(#t)
    (lambda ()
      (dk-meta-nth-r!)
      (let ((g (dk-goal)))
        (subst (dk-meta-bu-eq! (cadr g) (caddr g) (mx-elem-at! 'expr-fv-at '() k 'l)))
        (qrfl)))))
(qed 'fv-eapp)

(sp (make-wff '(FORALL h (FORALL nb (FORALL a (FORALL b
   (IMPLIES (IN h NN) (IMPLIES (IN nb NN) (IMPLIES (IN a (TUPLES EXPR-SET)) (IMPLIES (IN b EXPR-SET)
     (== (EXPR-FV (EBIND h nb a b))
         (UNION (BIG-UNION mxw_ (MAKE-SET a) (EXPR-FV mxw_)) (EXPR-FV b)))))))))))))
(dk-peel!)
(dk-meta-makeset-set! 'a)
(let ((k (dk-meta-new-at! '(EBIND h nb a b))))
  (dk-meta-val-succ! '(EBIND h nb a b) k 'expr-fv-at 'fv-stage-succ '() '(#f)
    (lambda ()
      (dk-meta-nth-r!)
      (dk-cite! 'expr-fv-at k 'b)
      (subst `(= ((FV-STAGE ,k) b) (EXPR-FV b)))
      (let ((g (dk-goal)))
        (subst (dk-meta-bu-eq! (cadr (cadr g)) (cadr (caddr g)) (mx-elem-at! 'expr-fv-at '() k 'a)))
        (qrfl)))))
(qed 'fv-ebind)

;;; -----------------------------------------------------------------------
;;; A finite union of finite subsets of NN is a finite subset of NN (finite-set-induction over the
;;; index set, the class relativised to subsets of the fixed index set).


;; (SUBSET A B) in context: land and return the universal (FORALL v (IMPLIES (IN v A) (IN v B))).
(define (mx-subset-univ! a b)
  (fact 'subset-def a b)
  (let* ((iff (iff-for `(SUBSET ,a ,b))) (u (caddr iff)))
    (dk-have! u (lambda () (dk-meta-keep-prop! iff `(SUBSET ,a ,b))))
    u))

;; the goal (SUBSET A B): THUNK runs on the leaf (IN v B) with (IN v A) in context, v returned.
(define (mx-subset-intro! thunk)
  (mac 'subset-def)
  (dk-peel!)
  (thunk (cadr (dk-goal))))

;; the goal (IN z (UNION A B)) with (IN z A) or (IN z B) in context.
(define (mx-fv-typed! t)                      ; (IN (EXPR-FV t) SET) for t in EXPR-SET in context
  (if (not (dk-asm? `(IN (EXPR-FV ,t) SET)))
      (begin (fact 'fv-finite t) (dk-split-all!))))
(define (mx-union-in! z a b)
  (let ((side (if (dk-asm? `(IN ,z ,a)) `(IN ,z ,a) `(IN ,z ,b))))
    (fact 'union-membership a b z)
    (dk-meta-keep-prop! (iff-for `(IN ,z (UNION ,a ,b))) side)))

;; P(EMPTY-SET), proved on the focus goal.
(define (mx-p-empty!)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((equal? g '(IN EMPTY-SET SET)) (fact 'empty-set-is-set) (ass))
              ((dk-head-is? g 'SUBSET)
               (mx-subset-intro! (lambda (v) (ai (dk-cite! 'empty-set-has-no-members v)))))
              (#t (fact 'card-empty) (subst '(= (CARD EMPTY-SET) 0)) (fact 'nn-zero-in) (ass)))))))

;; P(UNION A B) on the focus goal, from P(A) and P(B) split into the context.
(define (mx-p-union! a b)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-head-is? g 'IN)
               (if (dk-head-is? (cadr g) 'CARD)
                   (begin (fact 'card-union-nn a b) (ass))
                   (begin (dk-meta-and! `(IN ,a SET) `(IN ,b SET)) (fact 'union-set-closure a b) (ass))))
              (#t
               (let ((ua (mx-subset-univ! a 'NN)) (ub (mx-subset-univ! b 'NN)))
                 (mx-subset-intro!
                   (lambda (v)
                     (dk-meta-or-each! (dk-meta-union-open! `(IN ,v (UNION ,a ,b)))
                       (lambda (d) (dk-apply! (if (equal? (caddr d) a) ua ub) v) (ass))))))))))))

(sp (make-wff '(FORALL mxds_ (IMPLIES (IN mxds_ SET) (IMPLIES (IN (CARD mxds_) NN) (FORALL mxfm_
   (IMPLIES (FORALL mxv5_ (IMPLIES (IN mxv5_ mxds_)
              (AND (IN (mxfm_ mxv5_) SET) (AND (SUBSET (mxfm_ mxv5_) NN) (IN (CARD (mxfm_ mxv5_)) NN)))))
     (AND (IN (BIG-UNION mxw_ mxds_ (mxfm_ mxw_)) SET)
          (AND (SUBSET (BIG-UNION mxw_ mxds_ (mxfm_ mxw_)) NN)
               (IN (CARD (BIG-UNION mxw_ mxds_ (mxfm_ mxw_))) NN))))))))))
(let* ((landed (dk-peel!))
       (hf (or (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed) (error "bu-finite-nn: no family hypothesis")))
       (bu0 (cadr (cadr (dk-goal))))
       (ds (caddr bu0)) (ff (car (cadddr bu0)))
       (bu-of (lambda (s) `(BIG-UNION mxw_ ,s (,ff mxw_))))
       (cls `(SEP mxs_ SET (IMPLIES (SUBSET mxs_ ,ds) ,(dk-meta-finsub (bu-of 'mxs_)))))
       (ind0 (lookup-theorem 'finite-set-induction))
       (ind (subst-free (quantifier-var ind0) cls (quantifier-body ind0)))
       (prem (cadr ind))
       (h-base (cadr prem))
       (h-step (caddr prem)))
  ;; base: the union over the empty index set is empty
  (dk-have! h-base
    (lambda ()
      (in-sep! (lambda () (fact 'empty-set-is-set) (ass))
               (lambda ()
                 (di)
                 (let* ((b0 (bu-of 'EMPTY-SET))
                        (eqn `(= ,b0 EMPTY-SET)))
                   (dk-have! eqn
                     (lambda ()
                       (let ((univ `(FORALL mxx_ (IFF (IN mxx_ ,b0) (IN mxx_ EMPTY-SET)))))
                         (dk-have! univ
                           (lambda ()
                             (dk-peel!)
                             (dk-iff! (lambda (g) (equal? (caddr g) 'EMPTY-SET))
                               (lambda ()
                                 (let* ((z (cadr (dk-goal)))
                                        (landed (dk-landed (lambda () (bu-me `(IN ,z ,b0)))))
                                        (wm (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) 'EMPTY-SET))) landed)))
                                   (ai (dk-cite! 'empty-set-has-no-members (cadr wm)))))
                               (lambda ()
                                 (ai (dk-cite! 'empty-set-has-no-members (cadr (dk-goal))))))))
                         (fact 'class-extensionality b0 'EMPTY-SET)
                         (ass))))
                   (subst eqn)
                   (mx-p-empty!))))))
  ;; step: add one index
  (dk-have! h-step
    (lambda ()
      (dk-peel!)
      (dk-split-all!)
      (let* ((g (dk-goal)) (u (cadr g)) (s (cadr u)) (pxx (caddr u)) (x (cadr pxx))
             (ih (begin (sep-me `(IN ,s ,cls))
                        (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (equal? (cadr f) `(SUBSET ,s ,ds))))
                                 "the class property of s"))))
        (in-sep!
          (lambda ()
            (dk-meta-and! `(IN ,x SET) `(IN ,x SET))
            (fact 'pairing x x)
            (dk-meta-and! `(IN ,s SET) `(IN ,pxx SET))
            (fact 'union-set-closure s pxx)
            (ass))
          (lambda ()
            (di)
            (let ((uu (mx-subset-univ! u ds)))
              (fact 'pair-self-member x)
              (dk-have! `(IN ,x ,u) (lambda () (mx-union-in! x s pxx)))
              (dk-apply! uu x)
              (dk-have! `(SUBSET ,s ,ds)
                (lambda ()
                  (mx-subset-intro!
                    (lambda (v)
                      (dk-have! `(IN ,v ,u) (lambda () (mx-union-in! v s pxx)))
                      (dk-apply! uu v)
                      (ass)))))
              (detach! ih)
              (dk-split-all!)
              (dk-apply! hf x)
              (dk-split-all!)
              (let* ((bs (bu-of s)) (fx `(,ff ,x)) (bu (bu-of u))
                     (eqn `(= ,bu (UNION ,bs ,fx))))
                (dk-have! eqn
                  (lambda ()
                    (let ((univ `(FORALL mxx_ (IFF (IN mxx_ ,bu) (IN mxx_ (UNION ,bs ,fx))))))
                      (dk-have! univ
                        (lambda ()
                          (dk-peel!)
                          (dk-iff! (lambda (g) (equal? (caddr g) `(UNION ,bs ,fx)))
                            (lambda ()
                              (let* ((z (cadr (dk-goal)))
                                     (landed (dk-landed (lambda () (bu-me `(IN ,z ,bu)))))
                                     (wm (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) u))) landed))
                                     (w (cadr wm)))
                                (dk-meta-or-each! (dk-meta-union-open! wm)
                                  (lambda (d)
                                    (if (equal? (caddr d) s)
                                        (begin
                                          (dk-have! `(IN ,z ,bs)
                                            (lambda () (dk-each-leaf! (lambda () (bu-mi w)) (lambda () (ass)))))
                                          (mx-union-in! z bs fx))
                                        (begin
                                          (fact 'pair-self-eq x w)
                                          (dk-have! `(IN ,z ,fx) (lambda () (subst `(= ,x ,w)) (ass)))
                                          (mx-union-in! z bs fx)))))))
                            (lambda ()
                              (let ((z (cadr (dk-goal))))
                                (dk-meta-or-each! (dk-meta-union-open! `(IN ,z (UNION ,bs ,fx)))
                                  (lambda (d)
                                    (if (equal? (caddr d) bs)
                                        (let* ((landed (dk-landed (lambda () (bu-me d))))
                                               (wm (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) s))) landed))
                                               (w (cadr wm)))
                                          (dk-each-leaf! (lambda () (bu-mi w))
                                            (lambda () (if (dk-asm? (dk-goal)) (ass) (mx-union-in! w s pxx)))))
                                        (dk-each-leaf! (lambda () (bu-mi x))
                                          (lambda () (if (dk-asm? (dk-goal)) (ass) (mx-union-in! x s pxx))))))))))))
                      (fact 'class-extensionality bu `(UNION ,bs ,fx))
                      (ass))))
                (subst eqn)
                (mx-p-union! bs fx))))))))
  (dk-have! prem (lambda () (dk-conj-close! (lambda () (ass)))))
  (let ((all (dk-cite! 'finite-set-induction cls)))
    (dk-meta-and! `(IN ,ds SET) `(IN (CARD ,ds) NN))
    (dk-apply! all ds)
    (sep-me `(IN ,ds ,cls))
    (fact 'subset-refl ds)
    (detach! (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (equal? (cadr f) `(SUBSET ,ds ,ds))))
                      "the class property of the index set"))
    (dk-split-all!)
    (dk-conj-close! (lambda () (ass)))))
(qed 'bu-finite-nn)

;;; -----------------------------------------------------------------------
;;; FV(e) is a finite subset of NN.

(define mx-fvf '(VNB-LAMBDA mxw3_ EXPR-SET (EXPR-FV mxw3_)))

;; w in MAKE-SET(l) in context: land an index i with its range and (= w (NTH i l)); return i.
(define (mx-makeset-index! w l)
  (fact 'make-set-membership w l)
  (let ((iff (iff-for `(IN ,w (MAKE-SET ,l)))))
    (dk-have! (caddr iff) (lambda () (dk-meta-keep-prop! iff `(IN ,w (MAKE-SET ,l)))))
    (dk-split-all!)
    (let ((i (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f l))) "the index"))))
      (dk-split-all!)
      i)))

;; (IN (CARD (MAKE-SET l)) NN) for l in TUPLES(EXPR-SET) in context.
(define (mx-makeset-card! l)
  (fact 'length-in-nn 'EXPR-SET l)
  (dk-have! `(= (LENGTH ,l) (LENGTH ,l)) (lambda () (rfl)))
  (fact 'makeset-card-bound-strong `(LENGTH ,l) 'EXPR-SET l)
  (dk-split-all!))

;; P(BU over MAKE-SET(l) of EXPR-FV) on the focus goal, with every entry of l in the class CLS
;; (whose condition is P(EXPR-FV z)) through the components hypothesis COMPS.
(define (mx-p-bu-fv! l cls comps)
  (let* ((ds `(MAKE-SET ,l))
         (bu-fv `(BIG-UNION mxw_ ,ds (EXPR-FV mxw_)))
         (bu-fvf `(BIG-UNION mxw_ ,ds (,mx-fvf mxw_)))
         (fam `(FORALL mxv5_ (IMPLIES (IN mxv5_ ,ds) ,(dk-meta-finsub `(,mx-fvf mxv5_))))))
    (dk-meta-makeset-set! l)
    (mx-makeset-card! l)
    (dk-have! fam
      (lambda ()
        (dk-peel!)
        (let ((w (cadr (cadr (cadr (dk-goal))))))
          (fact 'makeset-member-in 'EXPR-SET l w)
          (dk-lam-b!)
          (let ((i (mx-makeset-index! w l)))
            (dk-apply! comps i)
            (sep-me `(IN (NTH ,i ,l) ,cls))
            (subst `(= ,w (NTH ,i ,l)))
            (dk-split-all!)
            (dk-conj-close! (lambda () (ass)))))))
    (fact 'bu-finite-nn ds mx-fvf)
    (dk-split-all!)
    (let ((eqn (dk-meta-bu-eq! bu-fvf bu-fv
                 (lambda (w)
                   (fact 'makeset-member-in 'EXPR-SET l w)
                   (dk-have! `(== (,mx-fvf ,w) (EXPR-FV ,w))
                     (lambda () (if (not (dk-lam-b!)) (qrfl))))))))
      (subst `(= ,bu-fv ,bu-fvf))
      (dk-conj-close! (lambda () (ass))))))

(sp (make-wff `(FORALL e (IMPLIES (IN e EXPR-SET) ,(dk-meta-finsub '(EXPR-FV e))))))
(dk-peel!)
(let* ((cls `(SEP mxz_ EXPR-SET ,(dk-meta-finsub '(EXPR-FV mxz_))))
       (hs (dk-meta-ind-hyps cls)))
  ;; FVAR
  (dk-have! (list-ref hs 0)
    (lambda ()
      (dk-peel!)
      (let ((n (cadr (cadr (dk-goal)))))
        (fact 'efvar-in-expr n)
        (in-sep! (lambda () (ass))
                 (lambda ()
                   (subst (dk-cite! 'fv-efvar n))
                   (dk-meta-set-of! n 'NN)
                   (dk-conj-close!
                     (lambda ()
                       (let ((g (dk-goal)))
                         (cond ((equal? g `(IN (PAIR ,n ,n) SET))
                                (dk-meta-and! `(IN ,n SET) `(IN ,n SET)) (fact 'pairing n n) (ass))
                               ((dk-head-is? g 'SUBSET)
                                (mx-subset-intro!
                                  (lambda (v) (fact 'pair-self-eq n v) (subst `(= ,v ,n)) (ass))))
                               (#t (subst (dk-cite! 'card-singleton n))
                                   (fact 'nn-zero-in) (fact 'nn-succ-closed 0) (ass)))))))))))
  ;; BVAR, CONST
  (for-each
    (lambda (hk law in-law)
      (dk-have! (list-ref hs hk)
        (lambda ()
          (dk-peel!)
          (let ((n (cadr (cadr (dk-goal)))))
            (fact in-law n)
            (in-sep! (lambda () (ass))
                     (lambda () (subst (dk-cite! law n)) (mx-p-empty!)))))))
    '(1 2) '(fv-ebvar fv-econst) '(ebvar-in-expr econst-in-expr))
  ;; APP
  (dk-have! (list-ref hs 3)
    (lambda ()
      (let* ((landed (dk-peel!))
             (x (cadr (dk-goal))) (h (cadr x)) (l (caddr x))
             (comps (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
        (fact 'eapp-in-expr h l)
        (in-sep! (lambda () (ass))
                 (lambda ()
                   (subst (dk-cite! 'fv-eapp h l))
                   (mx-p-bu-fv! l cls comps))))))
  ;; BIND
  (dk-have! (list-ref hs 4)
    (lambda ()
      (let* ((landed (dk-peel!))
             (x (cadr (dk-goal))) (h (cadr x)) (nb (caddr x)) (a (cadddr x)) (b (car (cddddr x)))
             (comps (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
        (fact 'ebind-in-expr h nb a b)
        (in-sep! (lambda () (ass))
                 (lambda ()
                   (subst (dk-cite! 'fv-ebind h nb a b))
                   (let ((bu `(BIG-UNION mxw_ (MAKE-SET ,a) (EXPR-FV mxw_))))
                     (dk-have! (dk-meta-finsub bu) (lambda () (mx-p-bu-fv! a cls comps)))
                     (dk-split-all!)
                     (sep-me `(IN ,b ,cls))
                     (dk-split-all!)
                     (mx-p-union! bu `(EXPR-FV ,b))))))))
  (dk-apply! (dk-cite! 'expr-induction cls) 'e)
  (sep-me `(IN e ,cls))
  (dk-split-all!)
  (dk-conj-close! (lambda () (ass))))
(qed 'fv-finite)

;;; -----------------------------------------------------------------------
;;; 6. THE LIST MAP.  MAPL(g, l) is a list over CLS of the length of l with i-th entry
;;; g(NTH(i, l)), whenever those values are in CLS (tuple-tabulation for existence,
;;; tuple-extensionality for uniqueness).

;; the entry universal "forall i in [1, LEN]. NTH(i, LST) = VAL(i)"
(define (mx-ent-univ lst val-of len)
  `(FORALL mxi_ (IMPLIES (IN mxi_ NN) (IMPLIES (<= 1 mxi_) (IMPLIES (<= mxi_ ,len)
      (= (NTH mxi_ ,lst) ,(val-of 'mxi_)))))))

;; (= A B) by tuple-extensionality over SET: A, B in TUPLES(SET), (= (LENGTH A) LEN),
;; (= (LENGTH B) LEN) in context; (ENTRY! k) lands (= (NTH k A) (NTH k B)) on a leaf with
;; k in NN, 1 <= k, k <= LEN in context.
(define (mx-tuple-ext! a b len entry!)
  (let ((claim `(= ,a ,b)))
    (dk-have! claim
      (lambda ()
        (dk-have! `(= (LENGTH ,a) (LENGTH ,b))
          (lambda ()
            (if (not (equal? `(LENGTH ,a) len)) (subst `(= (LENGTH ,a) ,len)))
            (if (not (equal? `(LENGTH ,b) len)) (subst `(= (LENGTH ,b) ,len)))
            (rfl)))
        (dk-have! `(FORALL mxk_ (IMPLIES (AND (IN mxk_ NN) (AND (<= 1 mxk_) (<= mxk_ (LENGTH ,a))))
                                         (= (NTH mxk_ ,a) (NTH mxk_ ,b))))
          (lambda ()
            (dk-peel!)
            (dk-split-all!)
            (let ((k (cadr (cadr (dk-goal)))))
              (if (not (dk-asm? `(<= ,k ,len)))
                  (dk-have! `(<= ,k ,len) (lambda () (subst `(= ,len (LENGTH ,a))) (ass))))
              (entry! k))))
        (fact 'tuple-extensionality 'SET a b)
        (ass)))
    claim))

;; from an entry universal U (for list LST, values VAL-OF) land the instance at k (typed).
(define (mx-ent-at! u k)
  (dk-apply! u k))

;; The proof of the map laws, for MAPL and MAPLK: VAL the i-th value, TABF its tabulating lambda.
(define (mx-map-prop! mapname val tabf)
  (let* ((landed (dk-peel!))
         (hv (or (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed) (error "map-prop: no value hypothesis")))
         (len '(LENGTH l))
         (tabh `(FORALL i_ (IMPLIES (AND (IN i_ NN) (AND (<= 1 i_) (<= i_ ,len))) (IN (,tabf i_) CLS)))))
    ;; the tabulation over CLS
    (dk-have! tabh
      (lambda ()
        (dk-peel!)
        (dk-split-all!)
        (let ((i (cadr (cadr (dk-goal)))))
          (dk-lam-b!)
          (dk-apply! hv i)
          (ass))))
    (fact 'tuple-tabulation len 'CLS tabf)
    (let* ((ex (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f 'mxi2_))) "the tabulation"))
           (ll (dk-skolem! ex)))
      (dk-split-all!)
      (let* ((tu (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f ll) (dk-contains? f 'mxi2_)))
                          "the tabulated entries"))
             (ent-l (mx-ent-univ ll val len))
             (incl (dk-meta-incl! 'CLS 'SET (lambda (w) (fact 'membership-implies-sethood w 'CLS) (ass)))))
        ;; the entries of L in the curried form
        (dk-have! ent-l
          (lambda ()
            (dk-peel!)
            (let ((i (cadr (cadr (dk-goal)))))
              (dk-meta-and! `(IN ,i NN) `(<= 1 ,i) `(<= ,i ,len))
              (dk-apply! tu i)
              (subst `(= (NTH ,i ,ll) (,tabf ,i)))
              (if (not (dk-lam-b!)) (begin (dk-apply! hv i) (rfl))))))
        (dk-apply! (dk-cite! 'tuples-mono 'CLS 'SET) ll)
        (mac mapname)
        (let* ((io (let find ((e (dk-goal)))
                     (cond ((and (pair? e) (eq? (car e) 'IOTA)) e)
                           ((pair? e) (or (find (car e)) (find (cdr e))))
                           (#t #f))))
               (same! (lambda (other ent-other)      ; (= ll other) for another list with P
                        (mx-tuple-ext! ll other len
                          (lambda (k)
                            (dk-apply! ent-l k)
                            (dk-apply! ent-other k)
                            (dk-apply! hv k)
                            (subst `(= (NTH ,k ,ll) ,(val k)))
                            (subst `(= (NTH ,k ,other) ,(val k)))
                            (rfl))))))
          (dk-each-leaf! (lambda () (iota-d io))
            (lambda ()
              (if (dk-head-is? (dk-goal) 'FORSOME)
                  ;; existence and uniqueness, in TUPLES(SET)
                  (begin
                    (ew ll)
                    (dk-each-leaf! (lambda () (di))
                      (lambda ()
                        (if (dk-head-is? (dk-goal) 'FORALL)
                            (let* ((landed (dk-peel!))
                                   (y (caddr (dk-goal))))
                              (dk-split-all!)
                              (let ((ent-y (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(NTH mxi_ ,y))))
                                                    "the entries of the second list")))
                                (same! y ent-y)))
                            (dk-conj-close! (lambda () (ass)))))))
                  ;; the description: it is L, which is in TUPLES(CLS)
                  (let* ((ent-io (begin
                                   (dk-split-all!)
                                   (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(NTH mxi_ ,io))))
                                          "the entries of the description"))))
                    (let ((eqn (same! io ent-io)))
                      (subst `(= ,io ,ll))
                      (dk-conj-close! (lambda () (ass)))))))))))))

(sp (make-wff '(FORALL CLS (FORALL mxg_ (FORALL l (IMPLIES (IN (LENGTH l) NN)
   (IMPLIES (FORALL i (IMPLIES (IN i NN) (IMPLIES (<= 1 i) (IMPLIES (<= i (LENGTH l)) (IN (mxg_ (NTH i l)) CLS)))))
     (AND (IN (MAPL mxg_ l) (TUPLES CLS))
          (AND (= (LENGTH (MAPL mxg_ l)) (LENGTH l))
               (FORALL i (IMPLIES (IN i NN) (IMPLIES (<= 1 i) (IMPLIES (<= i (LENGTH l))
                 (= (NTH i (MAPL mxg_ l)) (mxg_ (NTH i l))))))))))))))))
(mx-map-prop! 'MAPL (lambda (i) `(mxg_ (NTH ,i l))) '(VNB-LAMBDA mxi2_ NN (mxg_ (NTH mxi2_ l))))
(qed 'mapl-prop)

(sp (make-wff '(FORALL CLS (FORALL mxg_ (FORALL l (FORALL ix (IMPLIES (IN (LENGTH l) NN)
   (IMPLIES (FORALL i (IMPLIES (IN i NN) (IMPLIES (<= 1 i) (IMPLIES (<= i (LENGTH l)) (IN (mxg_ (NTH i l) ix) CLS)))))
     (AND (IN (MAPLK mxg_ l ix) (TUPLES CLS))
          (AND (= (LENGTH (MAPLK mxg_ l ix)) (LENGTH l))
               (FORALL i (IMPLIES (IN i NN) (IMPLIES (<= 1 i) (IMPLIES (<= i (LENGTH l))
                 (= (NTH i (MAPLK mxg_ l ix)) (mxg_ (NTH i l) ix))))))))))))))))
(mx-map-prop! 'MAPLK (lambda (i) `(mxg_ (NTH ,i l) ix)) '(VNB-LAMBDA mxi2_ NN (mxg_ (NTH mxi2_ l) ix)))
(qed 'maplk-prop)


;;; -----------------------------------------------------------------------
;;; 7. SUBST.

;; the IF tower of a stage map on a new node: resolve both IFs, unfold, reduce; return the value.
(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL m (FORALL u (IMPLIES (IN u EXPR-SET)
   (IN (SUBST-STAGE m u n) (FUN (EXPR-STAGE n) EXPR-SET)))))))))
(define (mx-stage-set-closer! n)
  (lambda () (dk-meta-type-stages! `(EXPR-STAGE ,n)) (ass)))
(let ((cs (dk-meta-ni-cases!)))
  (dk-focus! (car cs))
  (dk-peel!)
  (subst (dk-cite! 'subst-stage-zero 'm 'u))
  (dk-lam-type!
    (lambda ()
      (dk-peel!)
      (let* ((g (dk-goal)) (ift (cadr g)))
        (dk-case-if! ift
          (lambda (t? v)
            (if t? (ass) (begin (fact 'nn-zero-in) (fact 'expr-set-intro 0 (cadr (cadr ift))) (ass)))))))
    (mx-stage-set-closer! 0))
  (dk-focus! (cadr cs))
  (let* ((landed (dk-peel!))
         (ih (or (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed) (error "subst-stage-fun: no IH")))
         (g (dk-goal)) (st (cadr g)) (m (cadr st)) (u (caddr st)) (n (cadr (cadddr st)))
         (fn `(SUBST-STAGE ,m ,u ,n)) (sn `(EXPR-STAGE ,n)))
    (dk-apply! ih m u)
    (subst (dk-cite! 'subst-stage-succ m u n))
    (dk-lam-type!
      (lambda ()
        (dk-peel!)
        (let* ((ift (cadr (dk-goal))) (e (cadr (cadr ift))))
          (dk-case-if! ift
            (lambda (t? v)
              (if t?
                  (begin (dk-meta-app-type! fn sn 'EXPR-SET e) (ass))
                  (dk-meta-or-each! (dk-cite! 'expr-stage-succ-cases n e)
                    (lambda (d)
                      (cond
                        ((dk-head-is? d 'IN) (ai `(NOT (IN ,e ,sn))))
                        ((eq? (dk-meta-disjunct-kind d) 'EAPP)
                         (let* ((vs (dk-meta-unpack! d)) (h (car vs)) (l (cadr vs)))
                           (subst `(= ,e (EAPP ,h ,l)))
                           (mac 'EAPP)
                           (dk-meta-if-left! #t
                             (lambda ()
                               (dk-meta-nth-r!)
                               (let* ((mm (dk-meta-mapl! fn l sn 'EXPR-SET)))
                                 (dk-cite! 'eapp-unfold h mm)
                                 (subst `(= (LIST 3 ,h ,mm) (EAPP ,h ,mm)))
                                 (fact 'eapp-in-expr h mm)
                                 (ass))))))
                        (#t
                         (let* ((vs (dk-meta-unpack! d)) (h (car vs)) (nb (cadr vs)) (a (caddr vs)) (b (cadddr vs)))
                           (subst `(= ,e (EBIND ,h ,nb ,a ,b)))
                           (mac 'EBIND)
                           (dk-meta-if-left! #f
                             (lambda ()
                               (dk-meta-nth-r!)
                               (let* ((mm (dk-meta-mapl! fn a sn 'EXPR-SET)))
                                 (dk-meta-app-type! fn sn 'EXPR-SET b)
                                 (dk-cite! 'ebind-unfold h nb mm `(,fn ,b))
                                 (subst `(= (LIST 4 ,h ,nb ,mm (,fn ,b)) (EBIND ,h ,nb ,mm (,fn ,b))))
                                 (fact 'ebind-in-expr h nb mm `(,fn ,b))
                                 (ass))))))))))))))
      (mx-stage-set-closer! `(succ ,n)))))
(qed 'subst-stage-fun)

(dk-meta-struct-laws! (lambda (n) `(SUBST-STAGE m u ,n)) (lambda (e) `(EXPR-SUBST ,e m u)) '(m u)
                 'subst-stage-zero 'subst-stage-succ 'subst-stage-step 'subst-stage-coh 'expr-subst-at)

(sp (make-wff '(FORALL m (FORALL u (IMPLIES (IN u EXPR-SET) (FORALL e (IMPLIES (IN e EXPR-SET)
   (IN (EXPR-SUBST e m u) EXPR-SET))))))))
(dk-peel!)
(let ((r (dk-meta-rank! 'e)))
  (fact 'subst-stage-fun r 'm 'u)
  (subst (dk-cite! 'expr-subst-at 'm 'u r 'e))
  (dk-meta-app-type! `(SUBST-STAGE m u ,r) `(EXPR-STAGE ,r) 'EXPR-SET 'e)
  (ass))
(qed 'subst-in-expr)

(define mx-sfl '(VNB-LAMBDA mxw_ EXPR-SET (EXPR-SUBST mxw_ m u)))

;; (= (MAPL FK l) (MAPL mx-sfl l)), FK = SUBST-STAGE(m, u, k), l in TUPLES(S_k), u in EXPR-SET.
(define (mx-subst-mapl-eq! k l)
  (let* ((fk `(SUBST-STAGE m u ,k)) (sk `(EXPR-STAGE ,k)))
    (fact 'subst-stage-fun k 'm 'u)
    (dk-meta-lift-to-expr! l k)
    (let* ((m1 (dk-meta-mapl! fk l sk 'EXPR-SET))
           (m2 (dk-meta-mapl! mx-sfl l 'EXPR-SET 'EXPR-SET
                 (lambda (i)
                   (dk-lam-b!)
                   (fact 'subst-in-expr 'm 'u `(NTH ,i ,l))
                   (ass))))
           (len `(LENGTH ,l)))
      (dk-meta-incl! 'EXPR-SET 'SET (lambda (w) (fact 'membership-implies-sethood w 'EXPR-SET) (ass)))
      (dk-apply! (dk-cite! 'tuples-mono 'EXPR-SET 'SET) m1)
      (dk-apply! (dk-cite! 'tuples-mono 'EXPR-SET 'SET) m2)
      (mx-tuple-ext! m1 m2 len
        (lambda (i)
          (let ((w `(NTH ,i ,l)))
            (dk-meta-nth-in! sk i l)
            (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f m1))) "m1 entries") i)
            (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f m2))) "m2 entries") i)
            (subst `(= (NTH ,i ,m1) (,fk ,w)))
            (subst `(= (NTH ,i ,m2) (,mx-sfl ,w)))
            (fact 'expr-set-intro k w)
            (dk-lam-b!)
            (subst (dk-cite! 'expr-subst-at 'm 'u k w))
            (dk-meta-app-type! fk sk 'EXPR-SET w)
            (rfl)))))))

(sp (make-wff '(FORALL m (FORALL u (IMPLIES (IN u EXPR-SET) (IMPLIES (IN m NN) (== (EXPR-SUBST (EFVAR m) m u) u)))))))
(dk-peel!)
(dk-meta-val0! '(EFVAR m) 'expr-stage-fvar 'expr-subst-at 'subst-stage-zero '(m u) '(#t) (lambda () (qrfl)))
(qed 'subst-efvar-hit)

(sp (make-wff '(FORALL m (FORALL u (FORALL n (IMPLIES (IN u EXPR-SET) (IMPLIES (IN n NN) (IMPLIES (NOT (= n m))
   (== (EXPR-SUBST (EFVAR n) m u) (EFVAR n))))))))))
(dk-peel!)
(dk-meta-val0! '(EFVAR n) 'expr-stage-fvar 'expr-subst-at 'subst-stage-zero '(m u) '()
  (lambda ()
    (dk-meta-if-left! #f (lambda () (qrfl))
      (lambda ()
        (di)
        (dk-have! '(= n m) (lambda () (dk-meta-component! '(LIST 0 n) '(LIST 0 m) 2)))
        (ai '(NOT (= n m)))))))
(qed 'subst-efvar-miss)

(define (mx-subst-other0! x stage-law)
  (dk-peel!)
  (dk-meta-val0! x stage-law 'expr-subst-at 'subst-stage-zero '(m u) '()
    (lambda ()
      (dk-meta-if-left! #f (lambda () (qrfl))
        (lambda ()
          (di)
          (let ((eqn (dk-pick (lambda (f) (and (dk-head-is? f '=) (dk-head-is? (cadr f) 'LIST))) "the list equation")))
            (dk-meta-tag-absurd! (cadr eqn) (caddr eqn))))))))

(sp (make-wff '(FORALL m (FORALL u (FORALL k (IMPLIES (IN u EXPR-SET) (IMPLIES (IN k NN) (== (EXPR-SUBST (EBVAR k) m u) (EBVAR k)))))))))
(mx-subst-other0! '(EBVAR k) 'expr-stage-bvar)
(qed 'subst-ebvar)

(sp (make-wff '(FORALL m (FORALL u (FORALL c (IMPLIES (IN u EXPR-SET) (IMPLIES (IN c NN) (== (EXPR-SUBST (ECONST c) m u) (ECONST c)))))))))
(mx-subst-other0! '(ECONST c) 'expr-stage-const)
(qed 'subst-econst)

(sp (make-wff '(FORALL m (FORALL u (FORALL h (FORALL l
   (IMPLIES (IN u EXPR-SET) (IMPLIES (IN h NN) (IMPLIES (IN l (TUPLES EXPR-SET))
     (== (EXPR-SUBST (EAPP h l) m u) (EAPP h (MAPL (SUBST-FUN m u) l))))))))))))
(dk-peel!)
(mac 'SUBST-FUN)
(let ((k (dk-meta-new-at! '(EAPP h l))))
  (dk-meta-val-succ! '(EAPP h l) k 'expr-subst-at 'subst-stage-succ '(m u) '(#t)
    (lambda ()
      (dk-meta-nth-r!)
      (subst (mx-subst-mapl-eq! k 'l))
      (qrfl))))
(qed 'subst-eapp)

(sp (make-wff '(FORALL m (FORALL u (FORALL h (FORALL nb (FORALL a (FORALL b
   (IMPLIES (IN u EXPR-SET) (IMPLIES (IN h NN) (IMPLIES (IN nb NN) (IMPLIES (IN a (TUPLES EXPR-SET))
     (IMPLIES (IN b EXPR-SET)
       (== (EXPR-SUBST (EBIND h nb a b) m u)
           (EBIND h nb (MAPL (SUBST-FUN m u) a) (EXPR-SUBST b m u))))))))))))))))
(dk-peel!)
(mac 'SUBST-FUN)
(let ((k (dk-meta-new-at! '(EBIND h nb a b))))
  (dk-meta-val-succ! '(EBIND h nb a b) k 'expr-subst-at 'subst-stage-succ '(m u) '(#f)
    (lambda ()
      (dk-meta-nth-r!)
      (subst (mx-subst-mapl-eq! k 'a))
      (dk-cite! 'expr-subst-at 'm 'u k 'b)
      (subst `(= ((SUBST-STAGE m u ,k) b) (EXPR-SUBST b m u)))
      (qrfl))))
(qed 'subst-ebind)

;;; -----------------------------------------------------------------------
;;; The two substitution lemmas.


;; (IN x (EXPR-FV CHILD)) in context, CHILD = (NTH i l) an entry of the list l of the node X
;; (an EAPP, or the domain list of an EBIND): land (IN x (EXPR-FV X)).
(define (mx-fv-up-entry! x node i l)
  (let ((claim `(IN ,x (EXPR-FV ,node))))
    (dk-have! claim
      (lambda ()
        (case (car node)
          ((EAPP) (subst (apply dk-cite! 'fv-eapp (cdr node))))
          ((EBIND) (subst (apply dk-cite! 'fv-ebind (cdr node)))))
        (let ((bu (if (eq? (car node) 'EAPP) (caddr (dk-goal)) (cadr (caddr (dk-goal))))))
          (if (eq? (car node) 'EBIND)
              (dk-have! `(IN ,x ,bu) (lambda () (mx-fv-bu-in! x bu i l)))
              (mx-fv-bu-in! x bu i l))
          (if (eq? (car node) 'EBIND)
              (begin (mx-fv-typed! (car (cddddr node)))
                     (dk-meta-makeset-set! (cadddr node))
                     (mx-union-in! x bu `(EXPR-FV ,(car (cddddr node))))))
          )))
    claim))
(define (mx-fv-bu-in! x bu i l)
  (dk-each-leaf! (lambda () (bu-mi `(NTH ,i ,l)))
    (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-meta-in-makeset! i l 'EXPR-SET)))))

;; (IN x (EXPR-FV b)) in context, b the body of the EBIND node: land (IN x (EXPR-FV node)).
(define (mx-fv-up-body! x node)
  (let ((claim `(IN ,x (EXPR-FV ,node))) (b (car (cddddr node))))
    (dk-have! claim
      (lambda ()
        (subst (apply dk-cite! 'fv-ebind (cdr node)))
        (let ((g (dk-goal)))
          (mx-fv-typed! b)
          (dk-meta-makeset-set! (cadddr node))
          (mx-union-in! x (cadr (caddr g)) `(EXPR-FV ,b)))))
    claim))

;; MAPL(mx-sfl, l) typed, lifted to TUPLES(SET), with l; return it.
(define (mx-sfl-mapl! l)
  (let ((mm (dk-meta-mapl! mx-sfl l 'EXPR-SET 'EXPR-SET
              (lambda (i) (dk-lam-b!) (fact 'subst-in-expr 'm 'u `(NTH ,i ,l)) (ass)))))
    (dk-meta-incl! 'EXPR-SET 'SET (lambda (w) (fact 'membership-implies-sethood w 'EXPR-SET) (ass)))
    (dk-meta-tuples-lift! mm 'EXPR-SET 'SET (lambda (w) (fact 'membership-implies-sethood w 'EXPR-SET) (ass)))
    (dk-meta-tuples-lift! l 'EXPR-SET 'SET (lambda (w) (fact 'membership-implies-sethood w 'EXPR-SET) (ass)))
    mm))

(define (mx-entries-of mm)
  (define (concl f) (if (dk-head-is? f 'IMPLIES) (concl (caddr f)) f))
  (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL)
                            (let ((c (concl (caddr f))))
                              (and (dk-head-is? c '=) (dk-head-is? (cadr c) 'NTH)
                                   (equal? (cadr (cadr c)) (cadr f))
                                   (equal? (caddr (cadr c)) mm)))))
           "the map's entries"))

(sp (make-wff '(FORALL m (FORALL u (IMPLIES (IN u EXPR-SET) (FORALL e (IMPLIES (IN e EXPR-SET)
   (IMPLIES (NOT (IN m (EXPR-FV e))) (= (EXPR-SUBST e m u) e)))))))))
(dk-peel!)
(let* ((cls '(SEP mxz_ EXPR-SET (IMPLIES (NOT (IN m (EXPR-FV mxz_))) (= (EXPR-SUBST mxz_ m u) mxz_))))
       (hs (dk-meta-ind-hyps cls))
       ;; the class membership of the node X from the proof of its condition
       (intro! (lambda (x in-law args cond!)
                 (apply fact in-law args)
                 (in-sep! (lambda () (ass)) (lambda () (di) (cond! x)))))
       ;; the induction hypothesis at the child C: (= (EXPR-SUBST C m u) C), given that m is
       ;; not free in C because it is not free in X (UP! lands (IN m (EXPR-FV X)) from (IN m (EXPR-FV C)))
       (child! (lambda (x c up!)
                 (sep-me `(IN ,c ,cls))
                 (dk-have! `(NOT (IN m (EXPR-FV ,c)))
                   (lambda () (di) (up!) (ai `(NOT (IN m (EXPR-FV ,x))))))
                 (detach! `(IMPLIES (NOT (IN m (EXPR-FV ,c))) (= (EXPR-SUBST ,c m u) ,c)))))
       ;; (= (MAPL mx-sfl l) l) for the list l of X, entries in cls through COMPS
       (list-id! (lambda (x l comps)
                   (let ((mm (mx-sfl-mapl! l)))
                     (mx-tuple-ext! mm l `(LENGTH ,l)
                       (lambda (k)
                         (let ((c `(NTH ,k ,l)))
                           (dk-apply! (mx-entries-of mm) k)
                           (subst `(= (NTH ,k ,mm) (,mx-sfl ,c)))
                           (dk-meta-nth-in! 'EXPR-SET k l)
                           (dk-lam-b!)
                           (dk-apply! comps k)
                           (child! x c (lambda () (mx-fv-up-entry! 'm x k l)))
                           (ass))))))))
  ;; FVAR
  (dk-have! (list-ref hs 0)
    (lambda ()
      (dk-peel!)
      (let* ((x (cadr (dk-goal))) (n (cadr x)))
        (intro! x 'efvar-in-expr (list n)
          (lambda (x)
            (use-em `(= ,n m)
              (lambda ()
                (dk-have! `(IN m (EXPR-FV ,x))
                  (lambda ()
                    (subst (dk-cite! 'fv-efvar n))
                    (subst `(= m ,n))
                    (dk-meta-set-of! n 'NN)
                    (fact 'pair-self-member n)
                    (ass)))
                (ai `(NOT (IN m (EXPR-FV ,x)))))
              (lambda ()
                (subst (dk-cite! 'subst-efvar-miss 'm 'u n))
                (rfl))))))))
  ;; BVAR, CONST
  (for-each
    (lambda (hk law in-law)
      (dk-have! (list-ref hs hk)
        (lambda ()
          (dk-peel!)
          (let* ((x (cadr (dk-goal))) (n (cadr x)))
            (intro! x in-law (list n)
              (lambda (x) (subst (dk-cite! law 'm 'u n)) (rfl)))))))
    '(1 2) '(subst-ebvar subst-econst) '(ebvar-in-expr econst-in-expr))
  ;; APP
  (dk-have! (list-ref hs 3)
    (lambda ()
      (let* ((landed (dk-peel!))
             (x (cadr (dk-goal))) (h (cadr x)) (l (caddr x))
             (comps (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
        (intro! x 'eapp-in-expr (list h l)
          (lambda (x)
            (subst (dk-cite! 'subst-eapp 'm 'u h l))
            (mac 'SUBST-FUN)
            (subst (list-id! x l comps))
            (rfl))))))
  ;; BIND
  (dk-have! (list-ref hs 4)
    (lambda ()
      (let* ((landed (dk-peel!))
             (x (cadr (dk-goal))) (h (cadr x)) (nb (caddr x)) (a (cadddr x)) (b (car (cddddr x)))
             (comps (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f a))) landed)))
        (intro! x 'ebind-in-expr (list h nb a b)
          (lambda (x)
            (subst (dk-cite! 'subst-ebind 'm 'u h nb a b))
            (mac 'SUBST-FUN)
            (subst (list-id! x a comps))
            (child! x b (lambda () (mx-fv-up-body! 'm x)))
            (subst `(= (EXPR-SUBST ,b m u) ,b))
            (rfl))))))
  (dk-apply! (dk-cite! 'expr-induction cls) 'e)
  (sep-me `(IN e ,cls))
  (detach! '(IMPLIES (NOT (IN m (EXPR-FV e))) (= (EXPR-SUBST e m u) e)))
  (ass))
(qed 'subst-fresh)

(sp (make-wff '(FORALL m (FORALL u (== (SUBST-FUN m u) (VNB-LAMBDA mxw_ EXPR-SET (EXPR-SUBST mxw_ m u)))))))
(di) (mac 'SUBST-FUN) (qrfl)
(qed 'subst-fun-unfold)

;; the hypothesis F in context: rewrite it by the landed equation EQN (left to right); return it.
(define (mx-rw-h! f eqn) (dk-rewrite-h! f (cadr eqn) (caddr eqn)))

(sp (make-wff '(FORALL m (FORALL u (IMPLIES (IN u EXPR-SET) (FORALL e (IMPLIES (IN e EXPR-SET)
   (FORALL x (IMPLIES (IN x (EXPR-FV (EXPR-SUBST e m u)))
     (OR (AND (IN x (EXPR-FV e)) (NOT (= x m))) (IN x (EXPR-FV u))))))))))))
(dk-peel!)
(let* ((cond-of (lambda (z c) `(OR (AND (IN ,z (EXPR-FV ,c)) (NOT (= ,z m))) (IN ,z (EXPR-FV u)))))
       (cls `(SEP mxz_ EXPR-SET (FORALL mxx2_ (IMPLIES (IN mxx2_ (EXPR-FV (EXPR-SUBST mxz_ m u)))
                                                     ,(cond-of 'mxx2_ 'mxz_)))))
       (hs (dk-meta-ind-hyps cls))
       ;; the class membership of X: COND! gets z and the hypothesis (IN z (EXPR-FV (EXPR-SUBST X m u)))
       (intro! (lambda (x in-law args cond!)
                 (apply fact in-law args)
                 (in-sep! (lambda () (ass))
                          (lambda ()
                            (dk-peel!)
                            (let* ((g (dk-goal))
                                   (z (cadr (cadr (cadr g)))))
                              (cond! z `(IN ,z (EXPR-FV (EXPR-SUBST ,x m u)))))))))
       ;; the induction hypothesis at the child C applied to z, its two cases handed on
       (ih! (lambda (c z left! )
              (let ((u2 (begin (sep-me `(IN ,c ,cls))
                               (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(EXPR-SUBST ,c m u))))
                                        "the class condition at the child"))))
                (dk-meta-or-each! (dk-apply! u2 z)
                  (lambda (d)
                    (if (dk-head-is? d 'AND)
                        (begin (dk-split-all!) (oi-l) (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (left!)))))
                        (begin (oi-r) (ass))))))))
       ;; z in FV(NTH(i, MAPL(sfl, l))) for an index i: through the entry, the child's hypothesis
       (entry! (lambda (x l comps z w)
                 (let* ((mm `(MAPL ,mx-sfl ,l))
                        (i (mx-makeset-index! w mm)))
                   (dk-have! `(<= ,i (LENGTH ,l))
                     (lambda () (subst `(= (LENGTH ,l) (LENGTH ,mm))) (ass)))
                   (let ((c `(NTH ,i ,l)))
                     (dk-meta-nth-in! 'EXPR-SET i l)
                     (dk-apply! (mx-entries-of mm) i)
                     (dk-have! `(= (NTH ,i ,mm) (EXPR-SUBST ,c m u))
                       (lambda () (subst `(= (NTH ,i ,mm) (,mx-sfl ,c))) (if (not (dk-lam-b!)) (begin (fact 'subst-in-expr 'm 'u c) (rfl)))))
                     (dk-have! `(IN ,z (EXPR-FV (EXPR-SUBST ,c m u)))
                       (lambda ()
                         (subst `(= (EXPR-SUBST ,c m u) (NTH ,i ,mm)))
                         (subst `(= (NTH ,i ,mm) ,w))
                         (ass)))
                     (dk-apply! comps i)
                     (ih! c z (lambda () (mx-fv-up-entry! z x i l)))))))
       ;; the hypothesis on FV(EAPP / EBIND of the mapped list): open the big union
       (bu-open! (lambda (hyp)
                   (let* ((bu (caddr hyp))
                          (landed (dk-landed (lambda () (bu-me hyp))))
                          (wm (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (caddr bu)))) landed)))
                     (cadr wm)))))
  ;; FVAR
  (dk-have! (list-ref hs 0)
    (lambda ()
      (dk-peel!)
      (let* ((x (cadr (dk-goal))) (n (cadr x)))
        (intro! x 'efvar-in-expr (list n)
          (lambda (z hyp)
            (use-em `(= ,n m)
              (lambda ()
                (dk-have! '(IN m NN) (lambda () (subst `(= m ,n)) (ass)))
                (let* ((h2 (dk-rewrite-h! hyp n 'm))
                       (h3 (mx-rw-h! h2 (dk-cite! 'subst-efvar-hit 'm 'u))))
                  (oi-r) (ass)))
              (lambda ()
                (let* ((h2 (mx-rw-h! hyp (dk-cite! 'subst-efvar-miss 'm 'u n)))
                       (h3 (mx-rw-h! h2 (dk-cite! 'fv-efvar n))))
                  (dk-meta-set-of! n 'NN)
                  (fact 'pair-self-eq n z)
                  (oi-l)
                  (dk-conj-close!
                    (lambda ()
                      (if (dk-asm? (dk-goal))
                          (ass)
                          (begin (di)
                                 (dk-have! `(= ,n m) (lambda () (subst `(= ,n ,z)) (ass)))
                                 (ai `(NOT (= ,n m)))))))))))))))
  ;; BVAR, CONST
  (for-each
    (lambda (hk slaw flaw in-law)
      (dk-have! (list-ref hs hk)
        (lambda ()
          (dk-peel!)
          (let* ((x (cadr (dk-goal))) (n (cadr x)))
            (intro! x in-law (list n)
              (lambda (z hyp)
                (let* ((h2 (mx-rw-h! hyp (dk-cite! slaw 'm 'u n)))
                       (h3 (mx-rw-h! h2 (dk-cite! flaw n))))
                  (ai (dk-cite! 'empty-set-has-no-members z)))))))))
    '(1 2) '(subst-ebvar subst-econst) '(fv-ebvar fv-econst) '(ebvar-in-expr econst-in-expr))
  ;; APP
  (dk-have! (list-ref hs 3)
    (lambda ()
      (let* ((landed (dk-peel!))
             (x (cadr (dk-goal))) (h (cadr x)) (l (caddr x))
             (comps (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
        (intro! x 'eapp-in-expr (list h l)
          (lambda (z hyp)
            (let* ((h2 (mx-rw-h! hyp (dk-cite! 'subst-eapp 'm 'u h l)))
                   (h3 (mx-rw-h! h2 (dk-cite! 'subst-fun-unfold 'm 'u)))
                   (mm (mx-sfl-mapl! l))
                   (h4 (mx-rw-h! h3 (dk-cite! 'fv-eapp h mm)))
                   (w (bu-open! h4)))
              (entry! x l comps z w)))))))
  ;; BIND
  (dk-have! (list-ref hs 4)
    (lambda ()
      (let* ((landed (dk-peel!))
             (x (cadr (dk-goal))) (h (cadr x)) (nb (caddr x)) (a (cadddr x)) (b (car (cddddr x)))
             (comps (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f a))) landed)))
        (intro! x 'ebind-in-expr (list h nb a b)
          (lambda (z hyp)
            (let* ((h2 (mx-rw-h! hyp (dk-cite! 'subst-ebind 'm 'u h nb a b)))
                   (h3 (mx-rw-h! h2 (dk-cite! 'subst-fun-unfold 'm 'u)))
                   (mm (mx-sfl-mapl! a))
                   (sb (begin (fact 'subst-in-expr 'm 'u b) `(EXPR-SUBST ,b m u)))
                   (h4 (mx-rw-h! h3 (dk-cite! 'fv-ebind h nb mm sb))))
              (dk-meta-or-each! (dk-meta-union-open! h4)
                (lambda (d)
                  (if (dk-head-is? (caddr d) 'BIG-UNION)
                      (entry! x a comps z (bu-open! d))
                      (ih! b z (lambda () (mx-fv-up-body! z x))))))))))))
  (dk-apply! (dk-cite! 'expr-induction cls) 'e)
  (sep-me `(IN e ,cls))
  (let ((u2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(EXPR-SUBST e m u)))) "the class condition")))
    (dk-apply! u2 'x)
    (ass)))
(qed 'fv-subst)

;;; -----------------------------------------------------------------------
;;; 8. OPEN.  The stage map takes the pair (e, index): VNB-LAMBDA (LIST e k) over S_n x NN.


(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (FORALL u (IMPLIES (IN u EXPR-SET)
   (IN (OPEN-STAGE u n) (FUN (CARTESIAN (EXPR-STAGE n) NN) EXPR-SET))))))))
(define (mx-cart-set-closer! n)
  (lambda () (dk-meta-type-stages! `(EXPR-STAGE ,n)) (mx-set-close!)))
(let ((cs (dk-meta-ni-cases!)))
  (dk-focus! (car cs))
  (dk-peel!)
  (subst (dk-cite! 'open-stage-zero 'u))
  (dk-lam-type!
    (lambda ()
      (dk-peel!)
      (let* ((ift (cadr (dk-goal))))
        (dk-case-if! ift
          (lambda (t? v)
            (if t? (ass) (begin (fact 'nn-zero-in) (fact 'expr-set-intro 0 (cadr (cadr ift))) (ass)))))))
    (mx-cart-set-closer! 0))
  (dk-focus! (cadr cs))
  (let* ((landed (dk-peel!))
         (ih (or (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed) (error "open-stage-fun: no IH")))
         (g (dk-goal)) (st (cadr g)) (u (cadr st)) (n (cadr (caddr st)))
         (fn `(OPEN-STAGE ,u ,n)) (sn `(EXPR-STAGE ,n)))
    (dk-apply! ih u)
    (subst (dk-cite! 'open-stage-succ u n))
    (dk-lam-type!
      (lambda ()
        (dk-peel!)
        (let* ((ift (cadr (dk-goal))) (e (cadr (cadr ift))) (k (caddr (caddr ift))))
          (dk-case-if! ift
            (lambda (t? v)
              (if t?
                  (begin (dk-meta-app2-type! fn sn 'EXPR-SET e k) (ass))
                  (dk-meta-or-each! (dk-cite! 'expr-stage-succ-cases n e)
                    (lambda (d)
                      (cond
                        ((dk-head-is? d 'IN) (ai `(NOT (IN ,e ,sn))))
                        ((eq? (dk-meta-disjunct-kind d) 'EAPP)
                         (let* ((vs (dk-meta-unpack! d)) (h (car vs)) (l (cadr vs)))
                           (subst `(= ,e (EAPP ,h ,l)))
                           (mac 'EAPP)
                           (dk-meta-if-left! #t
                             (lambda ()
                               (dk-meta-nth-r!)
                               (let* ((mm (dk-meta-maplk! fn l k sn 'EXPR-SET)))
                                 (dk-cite! 'eapp-unfold h mm)
                                 (subst `(= (LIST 3 ,h ,mm) (EAPP ,h ,mm)))
                                 (fact 'eapp-in-expr h mm)
                                 (ass))))))
                        (#t
                         (let* ((vs (dk-meta-unpack! d)) (h (car vs)) (nb (cadr vs)) (a (caddr vs)) (b (cadddr vs)))
                           (subst `(= ,e (EBIND ,h ,nb ,a ,b)))
                           (mac 'EBIND)
                           (dk-meta-if-left! #f
                             (lambda ()
                               (dk-meta-nth-r!)
                               (let* ((mm (dk-meta-maplk! fn a k sn 'EXPR-SET))
                                      (kb `(+ ,k ,nb)))
                                 (dk-meta-and! `(IN ,k NN) `(IN ,nb NN))
                                 (fact 'nn-add-closed k nb)
                                 (dk-meta-app2-type! fn sn 'EXPR-SET b kb)
                                 (dk-cite! 'ebind-unfold h nb mm `(,fn ,b ,kb))
                                 (subst `(= (LIST 4 ,h ,nb ,mm (,fn ,b ,kb)) (EBIND ,h ,nb ,mm (,fn ,b ,kb))))
                                 (fact 'ebind-in-expr h nb mm `(,fn ,b ,kb))
                                 (ass))))))))))))))
      (mx-cart-set-closer! `(succ ,n)))))
(qed 'open-stage-fun)

(dk-meta-struct-laws! (lambda (n) `(OPEN-STAGE u ,n)) (lambda (e) `(EXPR-OPEN ,e ix u)) '(u)
                 'open-stage-zero 'open-stage-succ 'open-stage-step 'open-stage-coh 'expr-open-at
                 '(ix) '((IN ix NN)))

(sp (make-wff '(FORALL u (IMPLIES (IN u EXPR-SET) (FORALL ix (IMPLIES (IN ix NN) (FORALL e (IMPLIES (IN e EXPR-SET)
   (IN (EXPR-OPEN e ix u) EXPR-SET)))))))))
(dk-peel!)
(let ((r (dk-meta-rank! 'e)))
  (fact 'open-stage-fun r 'u)
  (subst (dk-cite! 'expr-open-at 'u r 'e 'ix))
  (dk-meta-app2-type! `(OPEN-STAGE u ,r) `(EXPR-STAGE ,r) 'EXPR-SET 'e 'ix)
  (ass))
(qed 'open-in-expr)

(define mx-ofl '(VNB-LAMBDA (LIST mxw_ mxj_) (CARTESIAN EXPR-SET NN) (EXPR-OPEN mxw_ mxj_ u)))

;; (= (MAPLK FK l ix) (MAPLK mx-ofl l ix)), FK = OPEN-STAGE(u, k), l in TUPLES(S_k), u, ix typed.
(define (mx-open-maplk-eq! k l)
  (let* ((fk `(OPEN-STAGE u ,k)) (sk `(EXPR-STAGE ,k)))
    (fact 'open-stage-fun k 'u)
    (let* ((m1 (dk-meta-maplk! fk l 'ix sk 'EXPR-SET))
           (m2 (dk-meta-maplk! mx-ofl l 'ix 'EXPR-SET 'EXPR-SET
                 (lambda (i)
                   (dk-lam-b!)
                   (fact 'open-in-expr 'u 'ix `(NTH ,i ,l))
                   (ass))))
           (len `(LENGTH ,l)))
      (dk-meta-incl! 'EXPR-SET 'SET (lambda (w) (fact 'membership-implies-sethood w 'EXPR-SET) (ass)))
      (dk-apply! (dk-cite! 'tuples-mono 'EXPR-SET 'SET) m1)
      (dk-apply! (dk-cite! 'tuples-mono 'EXPR-SET 'SET) m2)
      (mx-tuple-ext! m1 m2 len
        (lambda (i)
          (let ((w `(NTH ,i ,l)))
            (dk-meta-nth-in! sk i l)
            (dk-apply! (mx-entries-of m1) i)
            (dk-apply! (mx-entries-of m2) i)
            (subst `(= (NTH ,i ,m1) (,fk ,w ix)))
            (subst `(= (NTH ,i ,m2) (,mx-ofl ,w ix)))
            (fact 'expr-set-intro k w)
            (dk-lam-b!)
            (subst (dk-cite! 'expr-open-at 'u k w 'ix))
            (dk-meta-app2-type! fk sk 'EXPR-SET w 'ix)
            (rfl)))))))

(sp (make-wff '(FORALL u (FORALL ix (IMPLIES (IN u EXPR-SET) (IMPLIES (IN ix NN)
   (== (EXPR-OPEN (EBVAR ix) ix u) u)))))))
(dk-peel!)
(parameterize ((dk-meta-val-ex '(ix)))
  (dk-meta-val0! '(EBVAR ix) 'expr-stage-bvar 'expr-open-at 'open-stage-zero '(u) '(#t) (lambda () (qrfl))))
(qed 'open-ebvar-hit)

(sp (make-wff '(FORALL u (FORALL ix (FORALL j (IMPLIES (IN u EXPR-SET) (IMPLIES (IN ix NN) (IMPLIES (IN j NN)
   (IMPLIES (NOT (= j ix)) (== (EXPR-OPEN (EBVAR j) ix u) (EBVAR j)))))))))))
(dk-peel!)
(parameterize ((dk-meta-val-ex '(ix)))
  (dk-meta-val0! '(EBVAR j) 'expr-stage-bvar 'expr-open-at 'open-stage-zero '(u) '()
    (lambda ()
      (dk-meta-if-left! #f (lambda () (qrfl))
        (lambda ()
          (di)
          (dk-have! '(= j ix) (lambda () (dk-meta-component! '(LIST 1 j) '(LIST 1 ix) 2)))
          (ai '(NOT (= j ix))))))))
(qed 'open-ebvar-miss)

(define (mx-open-other0! x stage-law)
  (dk-peel!)
  (parameterize ((dk-meta-val-ex '(ix)))
    (dk-meta-val0! x stage-law 'expr-open-at 'open-stage-zero '(u) '()
      (lambda ()
        (dk-meta-if-left! #f (lambda () (qrfl))
          (lambda ()
            (di)
            (let ((eqn (dk-pick (lambda (f) (and (dk-head-is? f '=) (dk-head-is? (cadr f) 'LIST))) "the list equation")))
              (dk-meta-tag-absurd! (cadr eqn) (caddr eqn)))))))))

(sp (make-wff '(FORALL u (FORALL ix (FORALL n (IMPLIES (IN u EXPR-SET) (IMPLIES (IN ix NN) (IMPLIES (IN n NN)
   (== (EXPR-OPEN (EFVAR n) ix u) (EFVAR n))))))))))
(mx-open-other0! '(EFVAR n) 'expr-stage-fvar)
(qed 'open-efvar)

(sp (make-wff '(FORALL u (FORALL ix (FORALL c (IMPLIES (IN u EXPR-SET) (IMPLIES (IN ix NN) (IMPLIES (IN c NN)
   (== (EXPR-OPEN (ECONST c) ix u) (ECONST c))))))))))
(mx-open-other0! '(ECONST c) 'expr-stage-const)
(qed 'open-econst)

(sp (make-wff '(FORALL u (FORALL ix (FORALL h (FORALL l
   (IMPLIES (IN u EXPR-SET) (IMPLIES (IN ix NN) (IMPLIES (IN h NN) (IMPLIES (IN l (TUPLES EXPR-SET))
     (== (EXPR-OPEN (EAPP h l) ix u) (EAPP h (MAPLK (OPEN-FUN u) l ix)))))))))))))
(dk-peel!)
(mac 'OPEN-FUN)
(let ((k (dk-meta-new-at! '(EAPP h l))))
  (parameterize ((dk-meta-val-ex '(ix)))
    (dk-meta-val-succ! '(EAPP h l) k 'expr-open-at 'open-stage-succ '(u) '(#t)
      (lambda ()
        (dk-meta-nth-r!)
        (subst (mx-open-maplk-eq! k 'l))
        (qrfl)))))
(qed 'open-eapp)

(sp (make-wff '(FORALL u (FORALL ix (FORALL h (FORALL nb (FORALL a (FORALL b
   (IMPLIES (IN u EXPR-SET) (IMPLIES (IN ix NN) (IMPLIES (IN h NN) (IMPLIES (IN nb NN)
   (IMPLIES (IN a (TUPLES EXPR-SET)) (IMPLIES (IN b EXPR-SET)
     (== (EXPR-OPEN (EBIND h nb a b) ix u)
         (EBIND h nb (MAPLK (OPEN-FUN u) a ix) (EXPR-OPEN b (+ ix nb) u)))))))))))))))))
(dk-peel!)
(mac 'OPEN-FUN)
(let ((k (dk-meta-new-at! '(EBIND h nb a b))))
  (parameterize ((dk-meta-val-ex '(ix)))
    (dk-meta-val-succ! '(EBIND h nb a b) k 'expr-open-at 'open-stage-succ '(u) '(#f)
      (lambda ()
        (dk-meta-nth-r!)
        (subst (mx-open-maplk-eq! k 'a))
        (dk-meta-and! '(IN ix NN) '(IN nb NN))
        (fact 'nn-add-closed 'ix 'nb)
        (dk-cite! 'expr-open-at 'u k 'b '(+ ix nb))
        (subst `(= ((OPEN-STAGE u ,k) b (+ ix nb)) (EXPR-OPEN b (+ ix nb) u)))
        (qrfl)))))
(qed 'open-ebind)

;;; -----------------------------------------------------------------------
;;; 9. LC: the closing depths.

(dk-meta-struct-laws! (lambda (n) `(LCD-STAGE ,n)) (lambda (e) `(EXPR-LCD ,e)) '()
                 'lcd-stage-zero 'lcd-stage-succ 'lcd-stage-step 'lcd-stage-coh 'expr-lcd-at)


(define (mx-lcd-elem! k)       ; t in S_k (or in MAKE-SET of a list in TUPLES(S_k)) -> the AT equation
  (lambda (t)
    (if (not (dk-asm? `(IN ,t (EXPR-STAGE ,k))))
        (let ((ml (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) t) (dk-head-is? (caddr f) 'MAKE-SET)))
                              (dk-asms))))
          (dk-meta-type-stages! `(EXPR-STAGE ,k))
          (fact 'makeset-member-in `(EXPR-STAGE ,k) (cadr (caddr ml)) t)))
    (dk-cite! 'expr-lcd-at k t)))

(sp (make-wff '(FORALL n (IMPLIES (IN n NN) (== (EXPR-LCD (EFVAR n)) NN)))))
(dk-peel!)
(dk-meta-val0! '(EFVAR n) 'expr-stage-fvar 'expr-lcd-at 'lcd-stage-zero '() '(#f) (lambda () (qrfl)))
(qed 'lcd-efvar)

(sp (make-wff '(FORALL c (IMPLIES (IN c NN) (== (EXPR-LCD (ECONST c)) NN)))))
(dk-peel!)
(dk-meta-val0! '(ECONST c) 'expr-stage-const 'expr-lcd-at 'lcd-stage-zero '() '(#f) (lambda () (qrfl)))
(qed 'lcd-econst)

(sp (make-wff '(FORALL k (IMPLIES (IN k NN) (== (EXPR-LCD (EBVAR k)) (SEP mxd_ NN (< k mxd_)))))))
(dk-peel!)
(dk-meta-val0! '(EBVAR k) 'expr-stage-bvar 'expr-lcd-at 'lcd-stage-zero '() '(#t) (lambda () (dk-meta-nth-r!) (qrfl)))
(qed 'lcd-ebvar)

(sp (make-wff '(FORALL h (FORALL l (IMPLIES (IN h NN) (IMPLIES (IN l (TUPLES EXPR-SET))
   (== (EXPR-LCD (EAPP h l))
       (SEP mxd_ NN (FORALL mxw_ (IMPLIES (IN mxw_ (MAKE-SET l)) (IN mxd_ (EXPR-LCD mxw_))))))))))))
(dk-peel!)
(dk-meta-makeset-set! 'l)
(let ((k (dk-meta-new-at! '(EAPP h l))))
  (dk-meta-val-succ! '(EAPP h l) k 'expr-lcd-at 'lcd-stage-succ '() '(#t)
    (lambda ()
      (dk-meta-nth-r!)
      (let ((g (dk-goal)))
        (subst (dk-meta-sep-eq! (cadr g) (caddr g)
                 (lambda (t) `((LCD-STAGE ,k) ,t)) (lambda (t) `(EXPR-LCD ,t)) (mx-lcd-elem! k)))
        (qrfl)))))
(qed 'lcd-eapp)

(sp (make-wff '(FORALL h (FORALL nb (FORALL a (FORALL b
   (IMPLIES (IN h NN) (IMPLIES (IN nb NN) (IMPLIES (IN a (TUPLES EXPR-SET)) (IMPLIES (IN b EXPR-SET)
     (== (EXPR-LCD (EBIND h nb a b))
         (SEP mxd_ NN (AND (FORALL mxw_ (IMPLIES (IN mxw_ (MAKE-SET a)) (IN mxd_ (EXPR-LCD mxw_))))
                           (IN (+ mxd_ nb) (EXPR-LCD b)))))))))))))))
(dk-peel!)
(dk-meta-makeset-set! 'a)
(let ((k (dk-meta-new-at! '(EBIND h nb a b))))
  (dk-meta-val-succ! '(EBIND h nb a b) k 'expr-lcd-at 'lcd-stage-succ '() '(#f)
    (lambda ()
      (dk-meta-nth-r!)
      (let ((g (dk-goal)))
        (subst (dk-meta-sep-eq! (cadr g) (caddr g)
                 (lambda (t) `((LCD-STAGE ,k) ,t)) (lambda (t) `(EXPR-LCD ,t)) (mx-lcd-elem! k)))
        (qrfl)))))
(qed 'lcd-ebind)

;;; OPEN of an expression closed at a depth d <= the index is the identity.

;; MAPLK(mx-ofl, l, y) typed and lifted to TUPLES(SET), with l; return it.
(define (mx-ofl-maplk! l y)
  (let ((mm (dk-meta-maplk! mx-ofl l y 'EXPR-SET 'EXPR-SET
              (lambda (i) (dk-lam-b!) (fact 'open-in-expr 'u y `(NTH ,i ,l)) (ass)))))
    (dk-meta-tuples-lift! mm 'EXPR-SET 'SET (lambda (w) (fact 'membership-implies-sethood w 'EXPR-SET) (ass)))
    (dk-meta-tuples-lift! l 'EXPR-SET 'SET (lambda (w) (fact 'membership-implies-sethood w 'EXPR-SET) (ass)))
    mm))

(sp (make-wff '(FORALL u (IMPLIES (IN u EXPR-SET) (FORALL e (IMPLIES (IN e EXPR-SET)
   (FORALL ix (FORALL d (IMPLIES (IN ix NN) (IMPLIES (IN d NN) (IMPLIES (<= d ix)
     (IMPLIES (IN d (EXPR-LCD e)) (= (EXPR-OPEN e ix u) e)))))))))))))
(dk-peel!)
(let* ((cls '(SEP mxz_ EXPR-SET (FORALL mxix_ (FORALL mxd2_ (IMPLIES (IN mxix_ NN) (IMPLIES (IN mxd2_ NN)
               (IMPLIES (<= mxd2_ mxix_) (IMPLIES (IN mxd2_ (EXPR-LCD mxz_)) (= (EXPR-OPEN mxz_ mxix_ u) mxz_)))))))))
       (hs (dk-meta-ind-hyps cls))
       (intro! (lambda (x in-law args cond!)
                 (apply fact in-law args)
                 (in-sep! (lambda () (ass))
                          (lambda ()
                            (dk-peel!)
                            (let* ((g (dk-goal)) (ix (caddr (cadr g)))
                                   (dm (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) `(EXPR-LCD ,x))))
                                                "the depth hypothesis")))
                              (cond! ix (cadr dm) dm))))))
       ;; the induction hypothesis at C (in cls), at the index IX and the depth D
       (ih! (lambda (c ix d)
              (sep-me `(IN ,c ,cls))
              (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(EXPR-OPEN ,c mxix_ u))))
                                  "the class condition at the child")
                         ix d)))
       ;; (= (MAPLK ofl l ix) l), the depth universal DU (from the LCD of the node) in context
       (list-id! (lambda (l ix d du comps)
                   (let ((mm (mx-ofl-maplk! l ix)))
                     (mx-tuple-ext! mm l `(LENGTH ,l)
                       (lambda (k)
                         (let ((c `(NTH ,k ,l)))
                           (dk-apply! (mx-entries-of mm) k)
                           (subst `(= (NTH ,k ,mm) (,mx-ofl ,c ,ix)))
                           (dk-meta-nth-in! 'EXPR-SET k l)
                           (dk-lam-b!)
                           (dk-have! `(IN ,c (MAKE-SET ,l)) (lambda () (dk-meta-in-makeset! k l 'EXPR-SET)))
                           (dk-apply! du c)
                           (dk-apply! comps k)
                           (ih! c ix d)
                           (ass))))))))
  ;; FVAR, CONST
  (for-each
    (lambda (hk law in-law)
      (dk-have! (list-ref hs hk)
        (lambda ()
          (dk-peel!)
          (let* ((x (cadr (dk-goal))) (n (cadr x)))
            (intro! x in-law (list n)
              (lambda (ix d dm) (subst (dk-cite! law 'u ix n)) (rfl)))))))
    '(0 2) '(open-efvar open-econst) '(efvar-in-expr econst-in-expr))
  ;; BVAR
  (dk-have! (list-ref hs 1)
    (lambda ()
      (dk-peel!)
      (let* ((x (cadr (dk-goal))) (j (cadr x)))
        (intro! x 'ebvar-in-expr (list j)
          (lambda (ix d dm)
            (let ((h2 (mx-rw-h! dm (dk-cite! 'lcd-ebvar j))))
              (sep-me h2)
              (dk-have! `(NOT (= ,j ,ix)) (lambda () (dk-nn! `(< ,j ,d) `(<= ,d ,ix))))
              (subst (dk-cite! 'open-ebvar-miss 'u ix j))
              (rfl)))))))
  ;; APP
  (dk-have! (list-ref hs 3)
    (lambda ()
      (let* ((landed (dk-peel!))
             (x (cadr (dk-goal))) (h (cadr x)) (l (caddr x))
             (comps (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
        (intro! x 'eapp-in-expr (list h l)
          (lambda (ix d dm)
            (let* ((h2 (mx-rw-h! dm (dk-cite! 'lcd-eapp h l)))
                   (du (begin (sep-me h2)
                              (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(MAKE-SET ,l))
                                                        (dk-contains? f 'EXPR-LCD)))
                                       "the depth universal"))))
              (subst (dk-cite! 'open-eapp 'u ix h l))
              (mac 'OPEN-FUN)
              (subst (list-id! l ix d du comps))
              (rfl)))))))
  ;; BIND
  (dk-have! (list-ref hs 4)
    (lambda ()
      (let* ((landed (dk-peel!))
             (x (cadr (dk-goal))) (h (cadr x)) (nb (caddr x)) (a (cadddr x)) (b (car (cddddr x)))
             (comps (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f a))) landed)))
        (intro! x 'ebind-in-expr (list h nb a b)
          (lambda (ix d dm)
            (let* ((h2 (mx-rw-h! dm (dk-cite! 'lcd-ebind h nb a b))))
              (sep-me h2)
              (dk-split-all!)
              (let ((du (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(MAKE-SET ,a))
                                                  (dk-contains? f 'EXPR-LCD)))
                                 "the depth universal")))
                (subst (dk-cite! 'open-ebind 'u ix h nb a b))
                (mac 'OPEN-FUN)
                (subst (list-id! a ix d du comps))
                (dk-meta-and! `(IN ,ix NN) `(IN ,nb NN))
                (fact 'nn-add-closed ix nb)
                (dk-meta-and! `(IN ,d NN) `(IN ,nb NN))
                (fact 'nn-add-closed d nb)
                (dk-have! `(<= (+ ,d ,nb) (+ ,ix ,nb)) (lambda () (dk-nn! `(<= ,d ,ix))))
                (ih! b `(+ ,ix ,nb) `(+ ,d ,nb))
                (subst `(= (EXPR-OPEN ,b (+ ,ix ,nb) u) ,b))
                (rfl))))))))
  (dk-apply! (dk-cite! 'expr-induction cls) 'e)
  (sep-me `(IN e ,cls))
  (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(EXPR-OPEN e mxix_ u))))
                      "the class condition") 'ix 'd)
  (ass))
(qed 'lcd-open)

(sp (make-wff '(FORALL u (IMPLIES (IN u EXPR-SET) (FORALL e (IMPLIES (IN e EXPR-SET) (IMPLIES (EXPR-LC e)
   (FORALL ix (IMPLIES (IN ix NN) (= (EXPR-OPEN e ix u) e))))))))))
(dk-peel!)
(fact 'expr-lc 'e)
(dk-have! '(IN 0 (EXPR-LCD e)) (lambda () (dk-meta-keep-prop! (iff-for '(EXPR-LC e)) '(EXPR-LC e))))
(fact 'nn-zero-in)
(dk-have! '(<= 0 ix) (lambda () (dk-nn!)))
(fact 'lcd-open 'u 'e 'ix 0)
(ass)
(qed 'lc-open)

;;; -----------------------------------------------------------------------
;;; 10. SUBST and OPEN commute -- for a LOCALLY CLOSED replacement v.
;;; The brief's statement 5 has no hypothesis on v, and is FALSE without one: e = EFVAR(n),
;;; v = EBVAR(k), u = ECONST(0): SUBST(OPEN(e, k, u), n, v) = SUBST(EFVAR n) = EBVAR(k), but
;;; OPEN(SUBST(e, n, v), k, SUBST(u, n, v)) = OPEN(EBVAR k, k, ECONST 0) = ECONST(0).  The
;;; standard lemma (Aydemir et al., subst_open) carries lc(v); so does this one.

(define (mx-sfl-of nm rp) `(VNB-LAMBDA mxw_ EXPR-SET (EXPR-SUBST mxw_ ,nm ,rp)))
(define (mx-ofl-of op) `(VNB-LAMBDA (LIST mxw_ mxj_) (CARTESIAN EXPR-SET NN) (EXPR-OPEN mxw_ mxj_ ,op)))

;; the two maps over a list L in TUPLES(EXPR-SET), typed; return the MAPL / MAPLK term.
(define (mx-sfl-map! nm rp l)
  (dk-meta-mapl! (mx-sfl-of nm rp) l 'EXPR-SET 'EXPR-SET
    (lambda (i) (dk-lam-b!) (fact 'subst-in-expr nm rp `(NTH ,i ,l)) (ass))))
(define (mx-ofl-map! op l y)
  (dk-meta-maplk! (mx-ofl-of op) l y 'EXPR-SET 'EXPR-SET
    (lambda (i) (dk-lam-b!) (fact 'open-in-expr op y `(NTH ,i ,l)) (ass))))

(define (mx-to-set-tuples! l)
  (dk-meta-tuples-lift! l 'EXPR-SET 'SET (lambda (w) (fact 'membership-implies-sethood w 'EXPR-SET) (ass))))

;; the entry of a map at the typed index i: (= (NTH i M) VALUE), VALUE beta-reduced; landed.
(define (mx-map-entry! mm i val)
  (dk-apply! (mx-entries-of mm) i)
  (let ((app (caddr (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (cadr f) `(NTH ,i ,mm)))) "the entry"))))
    (dk-have! `(= (NTH ,i ,mm) ,val)
      (lambda ()
        (subst `(= (NTH ,i ,mm) ,app))
        (if (not (dk-lam-b!))
            (begin (mx-type-op! val) (rfl)))))))

;; (IN T EXPR-SET) for T = (EXPR-OPEN e y op) or (EXPR-SUBST e nm rp), the arguments typed.
(define (mx-type-op! t)
  (if (not (dk-asm? `(IN ,t EXPR-SET)))
      (case (car t)
        ((EXPR-OPEN) (fact 'open-in-expr (cadddr t) (caddr t) (cadr t)))
        ((EXPR-SUBST) (fact 'subst-in-expr (caddr t) (cadddr t) (cadr t)))
        (else (error "mx-type-op!: no typing for" t)))))

(sp (make-wff '(FORALL n (FORALL u (FORALL v (IMPLIES (IN u EXPR-SET) (IMPLIES (IN v EXPR-SET) (IMPLIES (EXPR-LC v)
   (FORALL e (IMPLIES (IN e EXPR-SET) (FORALL ix (IMPLIES (IN ix NN)
     (= (EXPR-SUBST (EXPR-OPEN e ix u) n v)
        (EXPR-OPEN (EXPR-SUBST e n v) ix (EXPR-SUBST u n v)))))))))))))))
(dk-peel!)
(fact 'subst-in-expr 'n 'v 'u)
(let* ((u2 '(EXPR-SUBST u n v))
       (lhs-of (lambda (z y) `(EXPR-SUBST (EXPR-OPEN ,z ,y u) n v)))
       (rhs-of (lambda (z y) `(EXPR-OPEN (EXPR-SUBST ,z n v) ,y ,u2)))
       (cls `(SEP mxz_ EXPR-SET (FORALL mxix_ (IMPLIES (IN mxix_ NN) (= ,(lhs-of 'mxz_ 'mxix_) ,(rhs-of 'mxz_ 'mxix_))))))
       (hs (dk-meta-ind-hyps cls))
       (intro! (lambda (x in-law args cond!)
                 (apply fact in-law args)
                 (in-sep! (lambda () (ass))
                          (lambda () (dk-peel!) (cond! (caddr (cadr (cadr (dk-goal)))))))))
       (ih! (lambda (c y)
              (sep-me `(IN ,c ,cls))
              (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f `(EXPR-OPEN ,c mxix_ u))))
                                  "the class condition at the child")
                         y)))
       ;; the list part: with L the node's list, (= (MAPL sfl (MAPLK ofl l y)) (MAPLK ofl' (MAPL sfl l) y)),
       ;; after the four maps are typed; returns that equation and the right-hand list
       (lists! (lambda (l y comps)
                 (let* ((l1 (mx-ofl-map! 'u l y))
                        (l2 (mx-sfl-map! 'n 'v l))
                        (l3 (mx-sfl-map! 'n 'v l1))
                        (l4 (mx-ofl-map! u2 l2 y)))
                   (for-each mx-to-set-tuples! (list l3 l4))
                   (dk-have! `(= (LENGTH ,l4) (LENGTH ,l))
                     (lambda () (subst `(= (LENGTH ,l4) (LENGTH ,l2))) (ass)))
                   (dk-have! `(= (LENGTH ,l3) (LENGTH ,l))
                     (lambda () (subst `(= (LENGTH ,l3) (LENGTH ,l1))) (ass)))
                   (let ((eqn
                          (mx-tuple-ext! l3 l4 `(LENGTH ,l)
                            (lambda (k)
                              (let ((c `(NTH ,k ,l)))
                                (dk-meta-nth-in! 'EXPR-SET k l)
                                (dk-have! `(<= ,k (LENGTH ,l1)) (lambda () (subst `(= (LENGTH ,l1) (LENGTH ,l))) (ass)))
                                (dk-have! `(<= ,k (LENGTH ,l2)) (lambda () (subst `(= (LENGTH ,l2) (LENGTH ,l))) (ass)))
                                (mx-map-entry! l1 k `(EXPR-OPEN ,c ,y u))
                                (mx-map-entry! l2 k `(EXPR-SUBST ,c n v))
                                (dk-meta-nth-in! 'EXPR-SET k l1)
                                (dk-meta-nth-in! 'EXPR-SET k l2)
                                (mx-map-entry! l3 k `(EXPR-SUBST (NTH ,k ,l1) n v))
                                (mx-map-entry! l4 k `(EXPR-OPEN (NTH ,k ,l2) ,y ,u2))
                                (subst `(= (NTH ,k ,l3) (EXPR-SUBST (NTH ,k ,l1) n v)))
                                (subst `(= (NTH ,k ,l4) (EXPR-OPEN (NTH ,k ,l2) ,y ,u2)))
                                (subst `(= (NTH ,k ,l1) (EXPR-OPEN ,c ,y u)))
                                (subst `(= (NTH ,k ,l2) (EXPR-SUBST ,c n v)))
                                (dk-apply! comps k)
                                (ih! c y)
                                (ass))))))
                     (list eqn l4))))))
  ;; FVAR
  (dk-have! (list-ref hs 0)
    (lambda ()
      (dk-peel!)
      (let* ((x (cadr (dk-goal))) (c (cadr x)))
        (intro! x 'efvar-in-expr (list c)
          (lambda (y)
            (subst (dk-cite! 'open-efvar 'u y c))
            (use-em `(= ,c n)
              (lambda ()
                (dk-have! '(IN n NN) (lambda () (subst `(= n ,c)) (ass)))
                (subst `(= ,c n))
                (subst (dk-cite! 'subst-efvar-hit 'n 'v))
                (fact 'lc-open u2 'v y)
                (subst `(= (EXPR-OPEN v ,y ,u2) v))
                (rfl))
              (lambda ()
                (subst (dk-cite! 'subst-efvar-miss 'n 'v c))
                (subst (dk-cite! 'open-efvar u2 y c))
                (rfl))))))))
  ;; BVAR
  (dk-have! (list-ref hs 1)
    (lambda ()
      (dk-peel!)
      (let* ((x (cadr (dk-goal))) (j (cadr x)))
        (intro! x 'ebvar-in-expr (list j)
          (lambda (y)
            (use-em `(= ,j ,y)
              (lambda ()
                (subst `(= ,j ,y))
                (subst (dk-cite! 'open-ebvar-hit 'u y))
                (subst (dk-cite! 'subst-ebvar 'n 'v y))
                (subst (dk-cite! 'open-ebvar-hit u2 y))
                (rfl))
              (lambda ()
                (subst (dk-cite! 'open-ebvar-miss 'u y j))
                (subst (dk-cite! 'subst-ebvar 'n 'v j))
                (subst (dk-cite! 'open-ebvar-miss u2 y j))
                (rfl))))))))
  ;; CONST
  (dk-have! (list-ref hs 2)
    (lambda ()
      (dk-peel!)
      (let* ((x (cadr (dk-goal))) (c (cadr x)))
        (intro! x 'econst-in-expr (list c)
          (lambda (y)
            (subst (dk-cite! 'open-econst 'u y c))
            (subst (dk-cite! 'subst-econst 'n 'v c))
            (subst (dk-cite! 'open-econst u2 y c))
            (rfl))))))
  ;; APP
  (dk-have! (list-ref hs 3)
    (lambda ()
      (let* ((landed (dk-peel!))
             (x (cadr (dk-goal))) (h (cadr x)) (l (caddr x))
             (comps (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed)))
        (intro! x 'eapp-in-expr (list h l)
          (lambda (y)
            (subst (dk-cite! 'open-eapp 'u y h l))
            (subst (dk-cite! 'subst-eapp 'n 'v h l))
            (mac 'OPEN-FUN) (mac 'SUBST-FUN)
            (let* ((l1 (mx-ofl-map! 'u l y)) (l2 (mx-sfl-map! 'n 'v l)))
              (subst (dk-cite! 'subst-eapp 'n 'v h l1))
              (subst (dk-cite! 'open-eapp u2 y h l2))
              (mac 'OPEN-FUN) (mac 'SUBST-FUN)
              (let* ((r (lists! l y comps)) (l4 (cadr r)))
                (subst (car r))
                (fact 'eapp-in-expr h l4)
                (rfl))))))))
  ;; BIND
  (dk-have! (list-ref hs 4)
    (lambda ()
      (let* ((landed (dk-peel!))
             (x (cadr (dk-goal))) (h (cadr x)) (nb (caddr x)) (a (cadddr x)) (b (car (cddddr x)))
             (comps (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f a))) landed)))
        (intro! x 'ebind-in-expr (list h nb a b)
          (lambda (y)
            (let ((yb `(+ ,y ,nb)))
              (dk-meta-and! `(IN ,y NN) `(IN ,nb NN))
              (fact 'nn-add-closed y nb)
              (subst (dk-cite! 'open-ebind 'u y h nb a b))
              (subst (dk-cite! 'subst-ebind 'n 'v h nb a b))
              (mac 'OPEN-FUN) (mac 'SUBST-FUN)
              (let* ((l1 (mx-ofl-map! 'u a y)) (l2 (mx-sfl-map! 'n 'v a))
                     (ob `(EXPR-OPEN ,b ,yb u)) (sb `(EXPR-SUBST ,b n v)))
                (fact 'open-in-expr 'u yb b)
                (fact 'subst-in-expr 'n 'v b)
                (subst (dk-cite! 'subst-ebind 'n 'v h nb l1 ob))
                (subst (dk-cite! 'open-ebind u2 y h nb l2 sb))
                (mac 'OPEN-FUN) (mac 'SUBST-FUN)
                (let* ((r (lists! a y comps)) (l4 (cadr r)))
                  (subst (car r))
                  (ih! b yb)
                  (subst `(= (EXPR-SUBST ,ob n v) (EXPR-OPEN ,sb ,yb ,u2)))
                  (fact 'open-in-expr u2 yb sb)
                  (fact 'ebind-in-expr h nb l4 `(EXPR-OPEN ,sb ,yb ,u2))
                  (rfl)))))))))
  (dk-apply! (dk-cite! 'expr-induction cls) 'e)
  (sep-me `(IN e ,cls))
  (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '(EXPR-OPEN e mxix_ u))))
                      "the class condition") 'ix)
  (ass))
(qed 'subst-open-commute)
