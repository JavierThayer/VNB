(sp (make-wff '(FORALL n (FORALL h (FORALL nb (FORALL a (FORALL b
   (IMPLIES (IN n NN) (IMPLIES (IN h NN) (IMPLIES (IN nb NN) (IMPLIES (IN a (TUPLES (EXPR-STAGE n)))
     (IMPLIES (IN b (EXPR-STAGE n)) (IN (EBIND h nb a b) (EXPR-STAGE (succ n)))))))))))))))
(dk-peel!)
