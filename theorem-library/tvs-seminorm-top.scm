;;; tb-top.scm -- topological-vector-space.pdf Def 1.3 / Prop 1.4: the topology of a separating family of
;;; seminorms is a vector space topology.  Agent TB-01, 2026-10-26.
;;; DESTINATION: theorem-library/tvs-seminorm-top.scm.  Library: analysis.
;;; Helper prefix: tbt-.

(define (tbt-qed! name)
  (if (not (proof-done? *ps*))
      (for-each (lambda (l) (display ";; OPEN ") (display (expression->string (dk-goal-of l))) (newline))
                (dk-open-leaves)))
  (qed name) (topic! name 'analysis))

(define tbt-fam '(IS-SEMINORM-FAMILY-ON fld m ix pf))
;;; project a conjunct of the family hypothesis (it survives)
(define (tbt-fam! c)
  (if (not (dk-asm? c))
      (dk-have! c (lambda () (mac-h 'IS-SEMINORM-FAMILY-ON (dk-ctx-form tbt-fam)) (dk-split-all!) (ass)))))
(define (tbt-and! . fs)
  (let ((c (let loop ((l fs)) (if (null? (cdr l)) (car l) (list 'AND (car l) (loop (cdr l)))))))
    (if (not (dk-asm? c)) (dk-have! c (lambda () (dk-conj-close! (lambda () (ass))))))))
(define (tbt-sub m a b) (list (list 'VADD m) a (list (list 'VNEG m) b)))

;;; ---------------------------------------------------------------------------
;;; the unfold of SN-BALL, as a theorem mac-h can name
(sp (make-wff '(FORALL m (FORALL pf (FORALL ff (FORALL x (FORALL eps
  (== (SN-BALL m pf ff x eps)
      (SEP snby_ (VEC m)
        (FORALL sni_ (IMPLIES (IN sni_ ff) (<= ((pf sni_) ((VADD m) snby_ ((VNEG m) x))) eps))))))))))))
(dk-peel!)
(mac 'SN-BALL)
(qrfl)
(tbt-qed! 'sn-ball-unfold)

;;; membership in a basic neighbourhood
(sp (make-wff '(FORALL m (FORALL pf (FORALL ff (FORALL x (FORALL eps (FORALL y
  (IFF (IN y (SN-BALL m pf ff x eps))
       (AND (IN y (VEC m))
            (FORALL sni_ (IMPLIES (IN sni_ ff) (<= ((pf sni_) ((VADD m) y ((VNEG m) x))) eps)))))))))))))
(dk-peel!)
(let ((y (cadr (cadr (dk-goal)))))
  (subst (list '== '(SN-BALL m pf ff x eps) (caddr (dk-cite! 'sn-ball-unfold 'm 'pf 'ff 'x 'eps))))
  (dk-iff! (lambda (g) (or (dk-head-is? g 'AND)
                           (and (dk-head-is? g 'IMPLIES) (dk-head-is? (caddr (cadr g)) 'SEP))))
    (lambda ()
      (dk-peel!)
      (sep-me (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) y) (dk-head-is? (caddr f) 'SEP)))
                       "the SEP membership"))
      (dk-split-all!)
      (dk-conj-close! dk-ass!))
    (lambda ()
      (dk-peel!)
      (dk-split-all!)
      (in-sep! (lambda () (ass)) (lambda () (ass))))))
(tbt-qed! 'sn-ball-membership)

;;; the two slots of SEMINORM-TOP
(define (tbt-slot! name acc val)        ; through dk-sp-qed!: a helper never calls bare sp / qed
  (dk-sp-qed! (make-wff (list 'FORALL 'm (list 'FORALL 'ix (list 'FORALL 'pf
                (list 'IMPLIES '(IN (VEC m) SET) (list '== (list acc '(SEMINORM-TOP m ix pf)) val))))))
    (lambda ()
      (dk-peel!)
      (dk-cite! 'power-set '(VEC m))
      (mac 'SEMINORM-TOP)
      (slot acc)
      (nth-r)
      (qrfl))
    name)
  (topic! name 'analysis))
(tbt-slot! 'sntop-pts 'PTS '(VEC m))
(tbt-slot! 'sntop-opens 'OPENS '(SEP snu_ (POWER (VEC m)) (IS-SN-OPEN m ix pf snu_)))

;;; ===========================================================================
;;; Statement builders (structure, not hand-counted parentheses)
(define (tbt-alls vars body) (fold-right (lambda (v acc) (list 'FORALL v acc)) body vars))
(define (tbt-imps hyps concl) (fold-right (lambda (h acc) (list 'IMPLIES h acc)) concl hyps))
(define (tbt-ball ff x e) (list 'SN-BALL 'm 'pf ff x e))

;;; (IN v (VEC m)) for a vector term built from typed atoms by VADD / VNEG / ACT
(define (tbt-vec! v)
  (let ((ty (list 'IN v '(VEC m))))
    (if (not (dk-asm? ty))
        (cond ((and (pair? v) (equal? (car v) '(VADD m)))
               (tbt-vec! (cadr v)) (tbt-vec! (caddr v))
               (dk-cite! 'module-vadd-type 'm (cadr v) (caddr v)))
              ((and (pair? v) (equal? (car v) '(VNEG m)))
               (tbt-vec! (cadr v))
               (dk-cite! 'module-vneg-type 'm (cadr v)))
              ((and (pair? v) (equal? (car v) '(ACT m)))
               (tbt-vec! (caddr v))
               (dk-cite! 'module-act-type 'm (cadr v) (caddr v)))
              ((equal? v '(VZERO m)) (dk-cite! 'module-vzero-in 'm))
              (#t (error "tbt-vec!: cannot type" (expression->string v)))))
    ty))
;;; (IN ((pf i) v) RR), i in ix in context, v a vector term; pf typing in context
(define (tbt-pval! i v)
  (let ((ty (list 'IN (list (list 'pf i) v) 'RR)))
    (if (not (dk-asm? ty))
        (begin
          (tbt-vec! v)
          (if (not (dk-asm? (list 'IN (list 'pf i) '(FUN (VEC m) RR))))
              (dk-cite! 'fun-apply-type-c 'pf 'ix '(FUN (VEC m) RR) i))
          (dk-cite! 'fun-apply-type-c (list 'pf i) '(VEC m) 'RR v)))
    ty))
;;; land the parts of the family hypothesis that the proofs use
(define (tbt-fam-parts!)
  (tbt-fam! '(IS-MODULE m))
  (tbt-fam! '(IN pf (FUN ix (FUN (VEC m) RR))))
  (dk-cite! 'frm-module-vec-set 'm))
;;; X subset Y by membership facts at a fresh point, prop
(define (tbt-subset! x y memb!)
  (dk-have! (list 'SUBSET x y)
    (lambda ()
      (mac 'subset-def)
      (let ((w (dk-di-var!)))
        (memb! w)
        (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop))))))
;;; the two parts of IS-SN-OPEN(m, ix, pf, u), on lanes (the hypothesis survives)
(define (tbt-open-parts! u)
  (let* ((h (list 'IS-SN-OPEN 'm 'ix 'pf u))
         (iff (dk-cite! 'is-sn-open 'm 'ix 'pf u))
         (rhs (caddr iff)))
    (dk-have! (cadr rhs) (lambda () (mac-h 'IS-SN-OPEN (dk-ctx-form h)) (dk-split-all!) (ass)))
    (dk-have! (caddr rhs) (lambda () (mac-h 'IS-SN-OPEN (dk-ctx-form h)) (dk-split-all!) (ass)))
    (caddr rhs)))
;;; from the forall part of IS-SN-OPEN(u) at X in u: skolemise (ff, eps); return (ff . eps)
(define (tbt-basic! all x)
  (let* ((ex (inst*! all x))
         (ff (dk-skolem! ex #t))
         (ex2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f ff) (dk-contains? f x)))
                       "the radius"))
         (e (dk-skolem! ex2 #t)))
    (cons ff e)))

;;; ---------------------------------------------------------------------------
;;; the empty set and the whole space are open
(sp (make-wff (tbt-alls '(m ix pf) (tbt-imps '((IS-MODULE m)) '(IS-SN-OPEN m ix pf EMPTY-SET)))))
(dk-peel!)
(mac 'is-sn-open)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'SUBSET)
        (begin (fact 'empty-subset-any '(VEC m)) (dk-ass!))
        (let ((x (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
          (fact 'empty-set-has-no-members x)
          (ai (list 'NOT (list 'IN x 'EMPTY-SET)))))))
(tbt-qed! 'sn-open-empty)

(sp (make-wff (tbt-alls '(m ix pf) (tbt-imps '((IS-MODULE m)) '(IS-SN-OPEN m ix pf (VEC m))))))
(dk-peel!)
(mac 'is-sn-open)
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) 'SUBSET)
        (begin (fact 'subset-refl '(VEC m)) (dk-ass!))
        (let ((x (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
          (fact 'empty-set-is-set)
          (fact 'card-empty)
          (fact 'nn-zero-in)
          (dk-have! '(IN (CARD EMPTY-SET) NN) (lambda () (subst '(= (CARD EMPTY-SET) 0)) (ass)))
          (fact 'empty-subset-any 'ix)
          (ew 'EMPTY-SET)
          (dk-conj-close!
            (lambda ()
              (if (not (dk-ass!))
                  (begin
                    (ew 1)
                    (dk-conj-close!
                      (lambda ()
                        (cond ((dk-ass!) #t)
                              ((dk-head-is? (dk-goal) 'POS-RR)
                               (fact 'rr-one-in) (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
                               (dk-cite! 'rr-pos-rr-of-lt 1) (dk-ass!))
                              (#t
                               (mac 'subset-def)
                               (let* ((w (dk-di-var!))
                                      (i (dk-cite! 'sn-ball-membership 'm 'pf 'EMPTY-SET x 1 w)))
                                 (if (dk-only! i (list 'IN w (tbt-ball 'EMPTY-SET x 1))) (prop)))))))))))))))
(tbt-qed! 'sn-open-whole)

;;; ---------------------------------------------------------------------------
;;; a smaller index set or a larger radius gives a larger basic neighbourhood
(sp (make-wff (tbt-alls '(fld m ix pf ff gg x e1 e2)
  (tbt-imps (list tbt-fam '(SUBSET ff gg) '(SUBSET gg ix) '(IN x (VEC m)) '(IN e1 RR) '(IN e2 RR) '(<= e1 e2))
    '(SUBSET (SN-BALL m pf gg x e1) (SN-BALL m pf ff x e2))))))
(dk-peel!)
(tbt-fam-parts!)
(mac 'subset-def)
(let* ((y (dk-di-var!))
       (i1 (dk-cite! 'sn-ball-membership 'm 'pf 'gg 'x 'e1 y))
       (i2 (dk-cite! 'sn-ball-membership 'm 'pf 'ff 'x 'e2 y))
       (r1 (caddr i1)) (r2 (caddr i2)))
  (dk-have! r1 (lambda () (if (dk-only! i1 (list 'IN y (tbt-ball 'gg 'x 'e1))) (prop))))
  (dk-split! r1)
  (dk-have! r2
    (lambda ()
      (dk-conj-close!
        (lambda ()
          (if (not (dk-ass!))
              (let* ((i (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
                     (v (tbt-sub 'm y 'x)))
                (dk-cite! 'subset-mem-fwd 'ff 'gg i)
                (dk-cite! 'subset-mem-fwd 'gg 'ix i)
                (inst*! (caddr r1) i)
                (tbt-pval! i v)
                (dk-ineq! (list 'IN (list (list 'pf i) v) 'RR) '(IN e1 RR) '(IN e2 RR)
                          (list '<= (list (list 'pf i) v) 'e1) '(<= e1 e2))))))))
  (if (dk-only! i2 r2) (prop)))
(tbt-qed! 'sn-ball-mono)

;;; ---------------------------------------------------------------------------
;;; finite intersections: the union of the two index sets, the smaller radius
(sp (make-wff (tbt-alls '(fld m ix pf u v)
  (tbt-imps (list tbt-fam '(IS-SN-OPEN m ix pf u) '(IS-SN-OPEN m ix pf v))
    '(IS-SN-OPEN m ix pf (INTERSECTION u v))))))
(dk-peel!)
(tbt-fam-parts!)
(let ((au (tbt-open-parts! 'u))
      (av (tbt-open-parts! 'v)))
  (mac 'is-sn-open)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'SUBSET)
          (begin
            (mac 'subset-def)
            (let ((w (dk-di-var!)))
              (dk-cite! 'intersection-membership 'u 'v w)
              (dk-cite! 'subset-mem-fwd 'u '(VEC m) w)
              (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms))) (prop))))
          (let* ((x (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
                 (im (dk-cite! 'intersection-membership 'u 'v x)))
            (dk-have! (list 'IN x 'u) (lambda () (if (dk-only! im (list 'IN x '(INTERSECTION u v))) (prop))))
            (dk-have! (list 'IN x 'v) (lambda () (if (dk-only! im (list 'IN x '(INTERSECTION u v))) (prop))))
            (dk-cite! 'subset-mem-fwd 'u '(VEC m) x)
            (let* ((p1 (tbt-basic! au x)) (f1 (car p1)) (e1 (cdr p1))
                   (p2 (tbt-basic! av x)) (f2 (car p2)) (e2 (cdr p2))
                   (ff (list 'UNION f1 f2))
                   (mn (list 'min e1 e2)))
              (dk-cite! 'rr-pos-rr-in-rr e1) (dk-cite! 'rr-pos-rr-in-rr e2)
              (dk-cite! 'rr-lt-of-pos-rr e1) (dk-cite! 'rr-lt-of-pos-rr e2)
              (tbt-and! (list 'IN f1 'SET) (list 'IN f2 'SET))
              (dk-cite! 'union-set-closure f1 f2)
              (dk-cite! 'card-union-nn f1 f2)
              (tbt-subset! ff 'ix
                (lambda (w) (dk-cite! 'union-membership f1 f2 w)
                            (dk-cite! 'subset-mem-fwd f1 'ix w) (dk-cite! 'subset-mem-fwd f2 'ix w)))
              (tbt-subset! f1 ff (lambda (w) (dk-cite! 'union-membership f1 f2 w)))
              (tbt-subset! f2 ff (lambda (w) (dk-cite! 'union-membership f1 f2 w)))
              (dk-cite! 'rr-min-closed e1 e2)
              (dk-cite! 'rr-min-le-left e1 e2)
              (dk-cite! 'rr-min-le-right e1 e2)
              (fact 'rr-zero-in)
              (dk-cite! 'rr-lt-min 0 e1 e2)
              (dk-cite! 'rr-pos-rr-of-lt mn)
              (dk-cite! 'sn-ball-mono 'fld 'm 'ix 'pf f1 ff x mn e1)
              (dk-cite! 'sn-ball-mono 'fld 'm 'ix 'pf f2 ff x mn e2)
              (dk-cite! 'subset-trans (tbt-ball ff x mn) (tbt-ball f1 x e1) 'u)
              (dk-cite! 'subset-trans (tbt-ball ff x mn) (tbt-ball f2 x e2) 'v)
              (ew ff)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin
                        (ew mn)
                        (dk-conj-close!
                          (lambda ()
                            (if (not (dk-ass!))
                                (begin
                                  (mac 'subset-def)
                                  (let ((w (dk-di-var!)))
                                    (dk-cite! 'subset-mem-fwd (tbt-ball ff x mn) 'u w)
                                    (dk-cite! 'subset-mem-fwd (tbt-ball ff x mn) 'v w)
                                    (dk-cite! 'intersection-membership 'u 'v w)
                                    (if (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms)))
                                        (prop)))))))))))))))))
(tbt-qed! 'sn-open-inter)

;;; ---------------------------------------------------------------------------
;;; arbitrary unions
;;; land (IMPLIES (IN W E) (IN W BU)) for E a member of the family of BU = (BIG-UNION u fam u)
(define (tbt-bu-in-imp! w e bu)
  (dk-have! (list 'IMPLIES (list 'IN w e) (list 'IN w bu))
    (lambda ()
      (di)
      (for-each (lambda (n) (dk-focus! n) (ass)) (dk-opened (lambda () (bu-mi e)))))))
(sp (make-wff (tbt-alls '(m ix pf fam)
  (tbt-imps '((IS-MODULE m) (FORALL tow_ (IMPLIES (IN tow_ fam) (IS-SN-OPEN m ix pf tow_))))
    '(IS-SN-OPEN m ix pf (BIG-UNION u fam u))))))
(dk-peel!)
(let ((hall (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'IS-SN-OPEN))) "the opens"))
      (bu '(BIG-UNION u fam u)))
  (mac 'is-sn-open)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'SUBSET)
          (begin
            (mac 'subset-def)
            (let* ((w (dk-di-var!))
                   (landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
                   (e (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'fam))) landed)))))
              (inst*! hall e)
              (tbt-open-parts! e)
              (dk-cite! 'subset-mem-fwd e '(VEC m) w)
              (dk-ass!)))
          (let* ((x (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!)))))
                 (landed (dk-landed (lambda () (bu-me (list 'IN x bu)))))
                 (e (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'fam))) landed)))))
            (inst*! hall e)
            (let* ((ae (tbt-open-parts! e))
                   (pr (tbt-basic! ae x)) (ff (car pr)) (eps (cdr pr)))
              (tbt-subset! e bu (lambda (w) (tbt-bu-in-imp! w e bu)))
              (dk-cite! 'subset-trans (tbt-ball ff x eps) e bu)
              (ew ff)
              (dk-conj-close!
                (lambda ()
                  (if (not (dk-ass!))
                      (begin (ew eps) (dk-conj-close! dk-ass!)))))))))))
(tbt-qed! 'sn-open-union)

;;; ---------------------------------------------------------------------------
;;; Def 1.3: the family's topology is a topology
(define tbt-opens '(SEP snu_ (POWER (VEC m)) (IS-SN-OPEN m ix pf snu_)))
(define tbt-top '(SEMINORM-TOP m ix pf))
;;; (IN X (POWER (VEC m))) from IS-SN-OPEN(m, ix, pf, X) in context
(define (tbt-pow-of-open! x)
  (if (not (dk-asm? (list 'IN x '(POWER (VEC m)))))
      (begin
        (tbt-open-parts! x)
        (dk-cite! 'subclass-of-set-is-set x '(VEC m))
        (let ((s (caddr (dk-cite! 'subset-def x '(VEC m)))))
          (dk-have! s (lambda () (mac-h 'subset-def (list 'SUBSET x '(VEC m))) (ass))))
        (dk-cite! 'power-mem-intro '(VEC m) x))))
;;; from (IN W opens) in context, on a lane: IS-SN-OPEN(m, ix, pf, W)
(define (tbt-open-of-mem! w)
  (let ((c (list 'IS-SN-OPEN 'm 'ix 'pf w)))
    (if (not (dk-asm? c))
        (dk-have! c (lambda () (sep-me (dk-ctx-form (list 'IN w tbt-opens))) (dk-split-all!) (ass))))))
;;; goal (IN X opens) from IS-SN-OPEN(X) in context
(define (tbt-into-opens! x)
  (tbt-pow-of-open! x)
  (in-sep! (lambda () (ass)) (lambda () (ass))))

(sp (make-wff (tbt-alls '(fld m ix pf) (tbt-imps (list tbt-fam) '(IS-TOP-SPACE (SEMINORM-TOP m ix pf))))))
(dk-peel!)
(tbt-fam-parts!)
(dk-cite! 'sntop-pts 'm 'ix 'pf)
(dk-cite! 'sntop-opens 'm 'ix 'pf)
(dk-cite! 'power-set '(VEC m))
(dk-have! (list 'IN tbt-opens 'SET) (lambda () (sep-set) (ass)))
(dk-cite! 'empty-set-is-set)
(dk-cite! 'sn-open-empty 'm 'ix 'pf)
(dk-cite! 'sn-open-whole 'm 'ix 'pf)
(mac 'is-top-space)
(dk-isx-set!)                ; W1J-A: the conjunct t in SET, from the typings
(subst (list '== (list 'PTS tbt-top) '(VEC m)))
(subst (list '== (list 'OPENS tbt-top) tbt-opens))
(dk-conj-close!
  (lambda ()
    (let ((g0 (dk-goal)))
      (cond
        ((dk-ass!) #t)
        ((dk-head-is? g0 '=) (mac 'SEMINORM-TOP) (len-r) (arith))
        ((and (dk-head-is? g0 'IN) (equal? (cadr g0) tbt-opens))
         (mac 'power-set-membership)
         (dk-conj-close!
           (lambda ()
             (if (not (dk-ass!))
                 (let ((z (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                   (sep-me (dk-ctx-form (list 'IN z tbt-opens)))
                   (dk-split-all!)
                   (ass))))))
        ((and (dk-head-is? g0 'IN) (memq (cadr g0) '(EMPTY-SET)))
         (fact 'empty-subset-any '(VEC m))
         (tbt-into-opens! 'EMPTY-SET))
        ((and (dk-head-is? g0 'IN) (equal? (cadr g0) '(VEC m)))
         (tbt-into-opens! '(VEC m)))
        ((dk-contains? g0 'INTERSECTION)
         (let* ((ld (dk-peel!))
                (uv (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) ld)))
                (u (car uv)) (v (cadr uv)))
           (tbt-open-of-mem! u)
           (tbt-open-of-mem! v)
           (dk-cite! 'sn-open-inter 'fld 'm 'ix 'pf u v)
           (tbt-into-opens! (list 'INTERSECTION u v))))
        (#t
         (let* ((ld (dk-peel!))
                (fv (cadr (car (filter (lambda (f) (dk-head-is? f 'SUBSET)) ld)))))
           (dk-have! (list 'FORALL 'tow_ (list 'IMPLIES (list 'IN 'tow_ fv) '(IS-SN-OPEN m ix pf tow_)))
             (lambda ()
               (let ((w (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                 (dk-cite! 'subset-mem-fwd fv tbt-opens w)
                 (tbt-open-of-mem! w)
                 (dk-ass!))))
           (dk-cite! 'sn-open-union 'm 'ix 'pf fv)
           (tbt-into-opens! (list 'BIG-UNION 'u fv 'u))))))))
(tbt-qed! 'sntop-is-top-space)
