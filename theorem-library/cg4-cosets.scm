;;; cg4-cosets.scm -- a compact topological group is the union of finitely many left cosets of an
;;; open subgroup (compact-groups notes, Lemma 5.33: "G/H is finite"; stated without the quotient
;;; G/H, and needing neither the invariant metric nor normality of H).
;;; Agent ISOM, 2026-10-26.  Helper prefix: cc4-.  Library: analysis.

(define (cc4-ass!) (if (dk-asm? (dk-goal)) (ass)))
(define (cc4-ass-rfl!) (if (dk-asm? (dk-goal)) (ass) (rfl)))
(define (cc4-peel-var!) (cadr (car (filter (lambda (q) (dk-head-is? q 'IN)) (dk-peel!)))))
(define (cc4-split-if! pred)
  (let ((hs (filter (lambda (h) (and (dk-head-is? h 'AND) (pred h))) (dk-asms))))
    (if (pair? hs) (dk-split-all! hs))))
(define (cc4-op x y) (list '(OPR g) x y))
(define (cc4-inv x) (list '(INV g) x))
(define (cc4-coset x) (list 'SEP 'lcz_ '(PTS s) (list 'IN (cc4-op (cc4-inv x) 'lcz_) 'H)))
(define cc4-CV (list 'SEP 'lcu_ '(POWER (PTS s)) (list 'FORSOME 'lcx_ (list 'AND '(IN lcx_ (CARR g)) (list '= 'lcu_ (cc4-coset 'lcx_))))))
(define cc4-LC '(PTS-LEFT-COSETS s g H))
(define cc4-BU (list 'BIG-UNION 'U cc4-CV 'U))

;;; ---- the lift (as in cg1-group.scm) ----
(define cc4-stmts '())
(define (cc4-keep! nm f) (set! cc4-stmts (cons (cons nm f) cc4-stmts)) f)
(define (cc4-subst e)
  (cond ((eq? e 's) '(TOP-GROUP-SPACE G)) ((eq? e 'g) '(TOP-GROUP-GROUP G))
        ((pair? e) (map cc4-subst e)) (#t e)))
(define (cc4-lift! nm-gt nm)
  (let* ((f (cdr (assq nm-gt cc4-stmts)))
         (body (caddr (caddr (caddr f)))))
    (dk-sp-qed! (make-wff (list 'FORALL 'G (list 'IMPLIES '(IS-TOP-GROUP G) (cc4-subst body))))
      (lambda ()
        (di) (di)
        (dk-cite! 'top-group-space-is-top-space 'G)
        (dk-cite! 'top-group-group-is-group 'G)
        (dk-cite! 'top-group-group-topology 'G)
        (dk-cite! nm-gt '(TOP-GROUP-SPACE G) '(TOP-GROUP-GROUP G))
        (ass))
      nm)
    (topic! nm 'analysis)))

(sp (make-wff (list 'FORALL 's (list 'FORALL 'g (list 'FORALL 'H (list '== cc4-LC cc4-CV))))))
(dk-peel!)
(mac 'PTS-LEFT-COSETS)
(qrfl)
(qed 'pts-left-cosets-unfold)
(topic! 'pts-left-cosets-unfold 'plumbing)

(sp (make-wff (cc4-keep! 'top-group-compact-finitely-many-cosets-gt
  (list 'FORALL 's (list 'FORALL 'g (list 'IMPLIES '(IS-GROUP-TOPOLOGY s g) (list 'IMPLIES '(IS-COMPACT-T s)
   (list 'FORALL 'H (list 'IMPLIES '(IS-SUBGROUP g H) (list 'IMPLIES '(IN H (OPENS s))
     (list 'FORSOME 'F (list 'AND (list 'SUBSET 'F cc4-LC) (list 'AND '(IN (CARD F) NN) '(== (BIG-UNION U F U) (PTS s)))))))))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'top-group-parts-gt 's 'g)))
(fact 'group-identity-in 'g)
(dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-subgroup 'g 'H))))
(dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-top-space 's))))
(dk-cite! 'power-set '(PTS s))
;; the members of the cover are open
(dk-have! (list 'FORALL 'U (list 'IMPLIES (list 'IN 'U cc4-CV) '(IN U (OPENS s))))
  (lambda ()
    (let ((U (cc4-peel-var!)))
      (dk-landed (lambda () (sep-me (list 'IN U cc4-CV))))
      (let ((x (dk-skolem! (dk-pick (lambda (h) (and (dk-head-is? h 'FORSOME) (dk-contains? h U))) "U's representative"))))
        (cc4-split-if! (lambda (h) (dk-contains? h x)))
        (dk-cite! 'top-group-translate-open-gt 's 'g x 'H)
        (subst (list '= U (cc4-coset x)))
        (cc4-ass!)))))
;; they cover the space
(dk-have! (list 'FORALL 'x (list 'IFF (list 'IN 'x cc4-BU) '(IN x (PTS s))))
  (lambda ()
    (let ((x (begin (dk-peel!) (cadr (cadr (dk-goal))))))
      (dk-iff! (lambda (g0) (equal? (caddr g0) '(PTS s)))
        (lambda ()
          (let* ((landed (dk-landed (lambda () (bu-me (list 'IN x cc4-BU)))))
                 (um (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) cc4-CV))) landed)))
                 (U (cadr um)))
            (dk-landed (lambda () (sep-me um)))
            (dk-cite! 'power-mem-in '(PTS s) U x)
            (cc4-ass!)))
        (lambda ()
          (let ((xc (cc4-coset x)) (ix (cc4-inv x)))
            (dk-rewrite-h! (list 'IN x '(PTS s)) '(PTS s) '(CARR g))
            (dk-rewrite-h! (list 'IN x '(CARR g)) '(CARR g) '(PTS s))
            (dk-cite! 'group-inv-in 'g x)
            (dk-cite! 'group-inv-inv 'g x)
            (dk-split-all! (list (dk-cite! 'group-right-inv-id 'g ix)))
            (dk-rewrite-h! (list '= (cc4-op ix (cc4-inv ix)) '(IDEN g)) (cc4-inv ix) x)
            (dk-have! (list 'IN x xc) (lambda () (in-sep! (lambda () (cc4-ass!)) (lambda () (subst (list '= (cc4-op ix x) '(IDEN g))) (cc4-ass!)))))
            (dk-have! (list 'IN xc 'SET) (lambda () (dk-close-all! (lambda () (sep-set)))))
            (dk-have! (list 'FORALL 'pz_ (list 'IMPLIES (list 'IN 'pz_ xc) '(IN pz_ (PTS s))))
              (lambda () (let ((z (cc4-peel-var!))) (dk-landed (lambda () (sep-me (list 'IN z xc)))) (cc4-ass!))))
            (dk-cite! 'power-mem-intro '(PTS s) xc)
            (dk-have! (list 'IN xc cc4-CV)
              (lambda () (in-sep! (lambda () (cc4-ass!))
                                  (lambda () (ew x) (dk-conj-close! cc4-ass-rfl!)))))
            (dk-each-leaf! (lambda () (bu-mi xc)) (lambda () (cc4-ass!)))))))))
(dk-cite! 'class-extensionality cc4-BU '(PTS s))
(dk-have! (list '== cc4-BU '(PTS s)) (lambda () (subst (list '= cc4-BU '(PTS s))) (qrfl)))
(dk-split-all! (list (dk-meta-iff-r! (dk-cite! 'is-compact-t 's))))
(define cc4-F (dk-skolem! (dk-apply! (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (eq? (cadr h) 'C))) "compactness") cc4-CV)))
(cc4-split-if! (lambda (h) (dk-contains? h cc4-F)))
(cc4-split-if! (lambda (h) (dk-contains? h cc4-F)))
(dk-cite! 'pts-left-cosets-unfold 's 'g 'H)
(ew cc4-F)
(dk-conj-close!
 (lambda ()
   (if (dk-head-is? (dk-goal) 'SUBSET)
       (begin (subst (list '= cc4-LC cc4-CV)) (cc4-ass!))
       (cc4-ass!))))
(qed 'top-group-compact-finitely-many-cosets-gt)
(topic! 'top-group-compact-finitely-many-cosets-gt 'analysis)
(cc4-lift! 'top-group-compact-finitely-many-cosets-gt 'top-group-compact-finitely-many-cosets)
