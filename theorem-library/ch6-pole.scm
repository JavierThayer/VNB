;;; ---- helper defines COPIED 2026-10-30 (wave-2 integration) from ch6/ch6-fun.scm, ch6/ch6-mult.scm, ch6/ch6-prod.scm, ch6/ch6-quot.scm, ch6/ch6-weier.scm, ch6/zero-order-laws.scm:
;;; the probe loaded this chain in ONE environment; load.scm gives each file its own.
(define (c6-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (c6-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (c6-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (c6-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))
(define (c6-nn! n) (fact 'nn-in-rr n) (fact 'rr-subset-cc n))
(define (c6-steps!)                          ; peel FORALL / IMPLIES; return the landed formulas
  (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
(define (c6-var new cls) (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (c6-mag! t) (fact 'cc-magnitude-closed t) (fact 'cc-magnitude-nonneg t) (list 'magnitude t))
(define (c6-chain-end f) (if (c6-op? f 'IMPLIES 3) (c6-chain-end (caddr f)) f))
(define (c6-cite! . args)                     ; dk-cite! that refuses to return an undetached implication link
  (let ((r (apply dk-cite! args)))
    (cond ((not (c6-op? r 'IMPLIES 3)) r)
          ((dk-asm? (c6-chain-end r)) (dk-ctx-form (c6-chain-end r)))     ; the consequent was already in context
          (#t (error "c6-cite!: the chain stopped at an antecedent not in context" (car args) (expression->string (cadr r)))))))
(define (c6-pts!)
  (fact 'cc-is-metric-space)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (c6-sk! ex) (dk-skolem! (dk-ctx-form ex) #t))
(define c6-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (c6f-rfl-close!) (dk-close-if! (lambda () #t) (lambda () (rfl))))
(define (c6f-cc-and-closed! law x y)            ; law cc-mul-closed / cc-add-closed: (IN (op x y) CC)
  (c6-and! (list 'IN x 'CC) (list 'IN y 'CC)) (fact law x y))
(define (c6w-cc-setup!) (fact 'cc-is-set) (fact 'cc-one-in) (fact 'cc-zero-in) (fact 'nn-zero-in) (fact 'rr-zero-in) (fact 'rr-one-in))
(define (c6w-induct-on! v base step)             ; after (ni) on the variable V: the step leaf is the one whose goal mentions V
  (let* ((ls (dk-open-leaves)) (st (find-first (lambda (l) (dk-contains? (dk-goal-of l) v)) ls))
         (b (find-first (lambda (l) (not (eq? l st))) ls)))
    (if (not (and b st)) (error "c6w-induct-on!: leaves not found"))
    (dk-focus! b) (base) (dk-focus! st) (step)))
(define (zol-hol-basics! u f)                     ; HOLOMORPHIC-ON(u, f) in context: f in FUN(u, CC), u open, u subset CC
  (dk-cite! 'holomorphic-on-in-fun u f) (dk-cite! 'holomorphic-on-open u f) (dk-cite! 'cc-open-subset-cc u)
  (fact 'cc-is-set) (fact 'cc-one-in) (fact 'cc-zero-in) (fact 'nn-zero-in))
(define (zol-hzo-open! hz)                        ; HAS-ZERO-OF-ORDER in context: open it on the main branch; returns h
  (dk-split-all! (dk-landed (lambda () (mac-h 'HAS-ZERO-OF-ORDER hz))))
  (let ((ex (find-first (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q 'zox_))) (dk-asms))))
    (dk-skolem! ex #t)))
(define (zol-fac u f a m h) (list 'FORALL 'zox_ (list 'IMPLIES (list 'IN 'zox_ u) (list '= (list f 'zox_) (list '* (list 'power (list '- 'zox_ a) m) (list h 'zox_))))))
(define (c6m-cc-open!)
  (c6w-cc-setup!) (fact 'nn-is-set) (fact 'cc-is-metric-space) (c6-pts!)
  (fact 'carrier-is-open 'CC-MS)
  (dk-have! '(IS-OPEN CC-MS CC) (lambda () (subst '(== CC (PTS CC-MS))) (dk-ass!)))
  (let ((oi (c6-cite! 'cc-ms-open-iff 'CC))) (dk-have! (list 'IS-OPEN c6-nfm 'CC) (lambda () (keep oi '(IS-OPEN CC-MS CC)) (prop))))
  (dk-have! '(SUBSET CC CC) (lambda () (let ((iff (dk-cite! 'subset-def 'CC 'CC)))
                                         (dk-have! (caddr iff) (lambda () (dk-di-var!) (dk-ass!)))
                                         (keep iff (caddr iff)) (prop)))))
(define (c6q-recip-nz! t)                          ; t in CC, t /= 0, t recip(t) = 1 in context: recip(t) /= 0
  (let ((r (list 'NOT (list '= (list 'recip t) 0))))
    (if (not (dk-asm? r))
        (dk-have! r (lambda () (di) (dk-have! '(= 1 0) (lambda () (subst (list '= 1 (list '* t (list 'recip t)))) (subst (list '= (list 'recip t) 0)) (crs))) (dk-absurd! '(= 1 0)))))
    r))
;;; ---- end of copied helpers ----

(define (c6p-sub-nz! y z)
  (let* ((nz (list 'NOT (list '= (list '- y z) 0))))
    (dk-have! nz
      (lambda ()
        (di)
        (dk-cite! 'cc-sub-zero-eq y z)
        (ai (dk-ctx-form (list 'NOT (list '= y z))))))
    nz))
(define (c6p-steps . thunks)
  ;; run THUNKS in order while the leaf focused at the start stays open
  (let* ((leaf (proof-state-focus *ps*)))
    (let loop ((ts thunks))
      (if (and (pair? ts) (not (sequent-node-grounded? leaf)))
          (begin ((car ts)) (loop (cdr ts)))))))
(define (c6p-pz-in! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (dk-have! (list 'IN y (c6p-pz z))
      (lambda () (c6p-only-prop! iff (list 'IN y 'CC) (list 'NOT (list '= y z)))))))
(define (c6p-only-prop! . fs) (if (apply dk-only! fs) (prop)))
(define (c6p-B e r) (list 'BALL 'CC-MS e r))
(define (c6p-PB e r) (list 'DIFFERENCE (c6p-B e r) (list 'SINGLETON e)))
(define (c6p-pz e) (list 'DIFFERENCE 'CC (list 'SINGLETON e)))
(define (c6p-pb-in! e r y)              ; y in B(e, r), y /= e (in context): y in B(e, r) \ {e}
  (let ((iff (dk-cite! 'difference-membership (c6p-B e r) (list 'SINGLETON e) y))
        (sf (begin (fact 'membership-implies-sethood y (c6p-B e r)) (dk-cite! 'singleton-membership e y))))
    (dk-have! (list 'NOT (list 'IN y (list 'SINGLETON e))) (lambda () (c6p-only-prop! sf (list 'NOT (list '= y e)))))
    (dk-have! (list 'IN y (c6p-PB e r)) (lambda () (c6p-only-prop! iff (list 'IN y (c6p-B e r)) (list 'NOT (list 'IN y (list 'SINGLETON e))))))))
(define (c6p-pb-open! e r y)            ; y in B(e, r) \ {e}: y in B, y in CC, y /= e, y - e /= 0, y in CC \ {e}
  (c6p-steps
    (lambda () (let ((iff (dk-cite! 'difference-membership (c6p-B e r) (list 'SINGLETON e) y)))
                 (if (not (and (dk-asm? (list 'IN y (c6p-B e r))) (dk-asm? (list 'NOT (list 'IN y (list 'SINGLETON e))))))
                     (begin
                       (dk-have! (list 'AND (list 'IN y (c6p-B e r)) (list 'NOT (list 'IN y (list 'SINGLETON e))))
                         (lambda () (c6p-only-prop! iff (list 'IN y (c6p-PB e r)))))
                       (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN y (c6p-B e r)) (list 'NOT (list 'IN y (list 'SINGLETON e)))))))))))
    (lambda () (c6p-ball-pt! e r y))
    (lambda () (fact 'membership-implies-sethood y 'CC))
    (lambda () (let ((iff (dk-cite! 'singleton-membership e y)))
                 (dk-have! (list 'NOT (list '= y e))
                   (lambda () (c6p-only-prop! iff (list 'NOT (list 'IN y (list 'SINGLETON e))) (list 'IN y 'SET))))))
    (lambda () (c6p-sub-nz! y e))
    (lambda () (c6p-pz-in! e y))))
(define (c6p-ball-pt! e r y)            ; y in B(e, r): y in CC, |y - e| < r
  (if (not (and (dk-asm? (list 'IN y 'CC)) (dk-asm? (list '< (list 'magnitude (list '- y e)) r))))
  (let ((iff (dk-cite! 'cc-ms-ball-membership e r y)))
    (dk-have! (list 'AND (list 'IN y 'CC) (list '< (list 'magnitude (list '- y e)) r))
      (lambda () (c6p-only-prop! iff (list 'IN y (c6p-B e r)))))
    (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN y 'CC) (list '< (list 'magnitude (list '- y e)) r))))))))

;;; ---------------------------------------------------------------- 1 / x^m = (1 / x)^m
(sp (make-wff '(FORALL c6pm_ (IMPLIES (IN c6pm_ NN) (FORALL c6px_ (IMPLIES (IN c6px_ CC) (IMPLIES (NOT (= c6px_ 0))
  (= (recip (power c6px_ c6pm_)) (power (recip c6px_) c6pm_)))))))))
(ni)
(c6w-induct-on! 'c6pm_
  (lambda ()
    (let* ((new (c6-steps!)) (x (c6-var new 'CC)))
      (c6w-cc-setup!) (c6-and! (list 'IN x 'CC) (list 'NOT (list '= x 0))) (fact 'cc-recip-closed x)
      (subst (dk-fact! 'power-zero x)) (subst (dk-fact! 'power-zero (list 'recip x)))
      (dk-have! '(NOT (= 1 0)) (lambda () (di) (dk-absurd! '(= 1 0))))
      (c6-and! '(IN 1 CC) '(NOT (= 1 0))) (fact 'cc-recip-closed 1) (fact 'cc-recip-inverse 1)
      (dk-have! '(= (recip 1) 1) (lambda () (dk-have! '(= (recip 1) (* 1 (recip 1))) (lambda () (crs))) (subst '(= (recip 1) (* 1 (recip 1)))) (dk-ass!)))
      (subst '(= (recip 1) 1)) (c6f-rfl-close!)))
  (lambda ()
    (let* ((new (c6-steps!)) (n (c6-var new 'NN)) (x (c6-var new 'CC))
           (ih (find-first (lambda (q) (c6-op? q 'FORALL 3)) new)) (rx (list 'recip x)) (pn (list 'power x n)))
      (c6w-cc-setup!) (c6-and! (list 'IN x 'CC) (list 'NOT (list '= x 0))) (fact 'cc-recip-closed x)
      (c6-and! (list 'IN x 'CC) (list 'IN n 'NN)) (c6-and! (list 'IN rx 'CC) (list 'IN n 'NN))
      (fact 'power-typing-nonneg x n) (fact 'power-typing-nonneg rx n)
      (dk-cite! 'cc-power-nonzero n x)
      (let ((ihe (dk-apply! ih x)))
        (subst (dk-fact! 'power-succ x n)) (subst (dk-fact! 'power-succ rx n))
        (subst (c6-cite! 'cc-recip-mul x pn))
        (subst ihe)
        (c6f-rfl-close!)))))
(qed 'cc-recip-power)

;;; ---------------------------------------------------------------- a zero of order m >= 1 of F is a pole of order m of 1/F
(sp (make-wff (list 'FORALL 'zpf_ (list 'IMPLIES '(HOLOMORPHIC-ON CC zpf_) (list 'FORALL 'zpa_ (list 'IMPLIES '(IN zpa_ CC)
  (list 'FORALL 'zpm_ (list 'IMPLIES '(IN zpm_ NN) (list 'IMPLIES '(<= 1 zpm_) (list 'IMPLIES '(HAS-ZERO-OF-ORDER CC zpf_ zpa_ zpm_)
    (list 'FORALL 'zpg_ (list 'FORALL 'zpr_ (list 'IMPLIES '(IN zpr_ RR) (list 'IMPLIES '(< 0 zpr_)
      (list 'IMPLIES (list 'FORALL 'zpz_ (list 'IMPLIES (list 'IN 'zpz_ (c6p-PB 'zpa_ 'zpr_)) '(= (zpg_ zpz_) (recip (zpf_ zpz_)))))
        '(IS-POLE zpg_ zpa_ zpm_))))))))))))))))
(let* ((new (c6-steps!)) (hh (find-first (lambda (q) (dk-head-is? q 'HOLOMORPHIC-ON)) new)) (ff (caddr hh))
       (hz (find-first (lambda (q) (dk-head-is? q 'HAS-ZERO-OF-ORDER)) new)) (a (cadddr hz)) (m (list-ref hz 4))
       (fe (find-first (lambda (q) (c6-op? q 'FORALL 3)) new))
       (g (car (cadr (caddr (caddr fe))))) (rf (cadddr (cadr (caddr (cadr (caddr fe)))))))
  (c6m-cc-open!) (zol-hol-basics! 'CC ff) (fact 'cc-plane-connected)
  (let* ((h (zol-hzo-open! hz))
         (hfac (dk-ctx-form (zol-fac 'CC ff a m h)))
         (hh0 (list 'NOT (list '= (list h a) 0))))
    (zol-hol-basics! 'CC h) (fact 'fun-apply-type-c h 'CC 'CC a)
    ;; h has no zero near a
    (dk-have! (list 'NOT (list 'ZEROS-ACCUMULATE-AT 'CC h a))
      (lambda () (di) (let ((ip (c6-cite! 'holomorphic-identity-principle 'CC h a))) (dk-apply! ip a) (ai hh0))))
    (let* ((r0 (c6-sk! (c6-cite! 'zeros-not-accumulating 'CC h a)))
           (pz (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q r0) (dk-contains? q h))) (dk-asms))))
      (fact 'rr-pos-rr-in-rr r0) (fact 'rr-lt-of-pos-rr r0)
      (let* ((w (dk-skolem! (dk-cite! 'rr-min-pos r0 rf) #t)) (b (list 'BALL 'CC-MS a w))
             (gg (list 'VNB-LAMBDA 'c6pw_ b (list 'recip (list h 'c6pw_)))))
        (dk-have! (list 'IN a '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (dk-ass!)))
        (dk-have! (list '<= 0 w) (lambda () (dk-ineq! (list '< 0 w))))
        (dk-have! (list 'NOT (list '= 0 w)) (lambda () (di) (dk-absurd! (list '= 0 w) (list '< 0 w))))
        (c6-and! (list 'IN w 'RR) (c6-and! (list '<= 0 w) (list 'NOT (list '= 0 w))))
        (dk-cite! 'ball-is-open 'CC-MS a w) (dk-cite! 'ball-center-in 'CC-MS a w)
        (let ((oi (c6-cite! 'cc-ms-open-iff b))) (dk-have! (list 'IS-OPEN c6-nfm b) (lambda () (dk-close-if! (lambda () (keep oi (list 'IS-OPEN 'CC-MS b))) (lambda () (prop))))))
        (dk-have! (list 'FORALL 'dkdoy_ (list 'IMPLIES (list 'IN 'dkdoy_ b) '(IN dkdoy_ CC)))
          (lambda () (let* ((y (dk-di-var!)) (bm (dk-cite! 'cc-ms-ball-membership a w y))) (keep bm (list 'IN y b)) (prop))))
        (let ((dom (dk-ctx-form (list 'FORALL 'dkdoy_ (list 'IMPLIES (list 'IN 'dkdoy_ b) '(IN dkdoy_ CC))))))
          (dk-have! (list 'SUBSET b 'CC)
            (lambda () (let ((iff (dk-cite! 'subset-def b 'CC))) (dk-have! (caddr iff) (lambda () (dk-ass!))) (keep iff (caddr iff)) (prop))))
          ;; ball(a, w) inside ball(a, r0) and ball(a, rf)
          (let ((inball! (lambda (y r)
                           (let* ((b1 (dk-cite! 'cc-ms-ball-membership a w y)) (b2 (dk-cite! 'cc-ms-ball-membership a r y)) (ya (list '- y a)))
                             (if (not (dk-asm? (list '< (list 'magnitude ya) w)))
                                 (begin
                                   (dk-have! (list 'AND (list 'IN y 'CC) (list '< (list 'magnitude ya) w)) (lambda () (dk-close-if! (lambda () (keep b1 (list 'IN y b) (list 'IN y 'CC))) (lambda () (prop)))))
                                   (dk-split-all! (list (list 'AND (list 'IN y 'CC) (list '< (list 'magnitude ya) w))))))
                             (c6-cc! ya) (c6-mag! ya)
                             (if (not (dk-asm? (list '< (list 'magnitude ya) r)))
                                 (dk-have! (list '< (list 'magnitude ya) r) (lambda () (dk-ineq! (list '< (list 'magnitude ya) w) (list '<= w r)))))
                             (if (not (dk-asm? (list 'IN y (list 'BALL 'CC-MS a r))))
                                 (dk-have! (list 'IN y (list 'BALL 'CC-MS a r)) (lambda () (dk-close-if! (lambda () (keep b2 (list 'IN y 'CC) (list '< (list 'magnitude ya) r))) (lambda () (prop))))))))))
            (dk-have! (list 'FORALL 'dkdoy_ (list 'IMPLIES (list 'IN 'dkdoy_ b) (list 'NOT (list '= (list h 'dkdoy_) 0))))
              (lambda ()
                (let ((y (dk-di-var!)))
                  (dk-apply! dom y)
                  (fact 'fun-apply-type-c h 'CC 'CC y)
                  (di)
                  (dk-have! (list 'NOT (list '= y a))
                    (lambda () (di) (dk-have! (list '= (list h a) 0) (lambda () (subst (list '= a y)) (dk-ass!))) (ai hh0)))
                  (inball! y r0)
                  (dk-apply! pz y)
                  (ai (list 'NOT (list '= (list h y) 0))))))
            (let ((hnz (dk-ctx-form (list 'FORALL 'dkdoy_ (list 'IMPLIES (list 'IN 'dkdoy_ b) (list 'NOT (list '= (list h 'dkdoy_) 0)))))))
              (dk-have! (list 'HOLOMORPHIC-ON b gg) (lambda () (dk-holomorphic! b gg)))
              (mac 'IS-POLE)
              (dk-conj-close!
                (lambda ()
                  (cond
                    ((dk-asm? (dk-goal)) (dk-ass!))
                    ((dk-head-is? (dk-goal) 'FORSOME)
                     (ew w)
                     (dk-conj-close!
                       (lambda ()
                         (cond
                           ((dk-asm? (dk-goal)) (dk-ass!))
                           ((dk-head-is? (dk-goal) 'FORSOME)
                            (ew gg)
                            (dk-conj-close!
                              (lambda ()
                                (cond
                                  ((dk-asm? (dk-goal)) (dk-ass!))
                                  ((dk-head-is? (dk-goal) 'NOT)
                                   (dk-lam-b!)
                                   (fact 'cc-recip-inverse (list h a)) (c6-and! (list 'IN (list h a) 'CC) hh0) (fact 'cc-recip-inverse (list h a))
                                   (dk-close-if! (lambda () (c6q-recip-nz! (list h a))) (lambda () (dk-ass!))))
                                  (#t
                                   (let* ((nz (c6-steps!)) (z (cadr (find-first (lambda (q) (dk-head-is? q 'IN)) nz)))
                                          (za (list '- z a)) (rza (list 'recip za)))
                                     (c6p-pb-open! a w z)
                                     (inball! z rf) (c6p-pb-in! a rf z)
                                     (dk-apply! fe z)
                                     (dk-apply! hnz z)
                                     (fact 'fun-apply-type-c h 'CC 'CC z)
                                     (c6-cc! za) (c6-and! (list 'IN za 'CC) (list 'IN m 'NN)) (fact 'power-typing-nonneg za m)
                                     (dk-cite! 'cc-power-nonzero m za)
                                     (subst (list '= (list g z) (list 'recip (list ff z))))
                                     (subst (dk-apply! hfac z))
                                     (subst (c6-cite! 'cc-recip-mul (list 'power za m) (list h z)))
                                     (subst (c6-cite! 'cc-recip-power m za))
                                     (c6-and! (list 'IN za 'CC) (list 'NOT (list '= za 0))) (fact 'cc-recip-closed za)
                                     (c6-and! (list 'IN rza 'CC) (list 'IN m 'NN)) (fact 'power-typing-nonneg rza m)
                                     (c6-and! (list 'IN (list h z) 'CC) (list 'NOT (list '= (list h z) 0))) (fact 'cc-recip-closed (list h z))
                                     (c6f-cc-and-closed! 'cc-mul-closed (list 'power rza m) (list 'recip (list h z)))
                                     (dk-lam-b!)
                                     (dk-close-if! (lambda () #t) (lambda () (c6f-rfl-close!)))))))))
                           (#t (dk-ass!))))))
                    (#t (dk-ass!))))))))))))
(qed 'zero-to-pole)


;;; ---------------------------------------------------------------- Definition 6.27: Gamma = 1 / RECIP-GAMMA off the non-positive integers
(define c6p-npi '(SEP egu_ CC (FORALL egn_ (IMPLIES (IN egn_ NN) (NOT (= egu_ (- egn_)))))))
(def-constant 'GAMMA-PRODUCT (list 'gamma-product-def (list '== 'GAMMA-PRODUCT (list 'VNB-LAMBDA 'egw_ c6p-npi '(recip (RECIP-GAMMA egw_))))))
(notation! 'GAMMA-PRODUCT 'kind 'constant 'arity 0 'english "the Gamma function of Definition 6.27 (the reciprocal of the canonical product)")
(define c6p-gl (list 'VNB-LAMBDA 'egw_ c6p-npi '(recip (RECIP-GAMMA egw_))))
(define (c6p-npi-in! z)                          ; z in CC with z /= -k for every k in NN (the universal in context): z in NPI
  (let ((e (list 'IN z c6p-npi)))
    (if (not (dk-asm? e)) (dk-have! e (lambda () (in-sep! (lambda () (dk-ass!)) (lambda () (dk-ass!))))))
    e))
(define (c6p-gamma-at! z)                        ; z in NPI, RECIP-GAMMA(z) /= 0 in context: GAMMA-PRODUCT(z) = recip(RECIP-GAMMA(z)), in CC
  (let* ((rg (list 'RECIP-GAMMA z)) (e (list '= (list 'GAMMA-PRODUCT z) (list 'recip rg))))
    (c6-and! (list 'IN rg 'CC) (list 'NOT (list '= rg 0))) (fact 'cc-recip-closed rg)
    (if (not (dk-asm? e))
        (dk-have! e (lambda () (fact 'gamma-product-def)
                               (subst (dk-cite! 'apply-congruence-1 'GAMMA-PRODUCT c6p-gl z))
                               (dk-lam-b!) (dk-close-if! (lambda () #t) (lambda () (c6f-rfl-close!))))))
    e))

;;; PROPOSITION 6.28 for Gamma itself: a pole of order 1 at every -n, n >= 0, and no zero
(sp (make-wff '(AND (FORALL egn_ (IMPLIES (IN egn_ NN) (IS-POLE GAMMA-PRODUCT (- egn_) 1)))
                    (FORALL egw_ (IMPLIES (IN egw_ (SEP egu_ CC (FORALL egn_ (IMPLIES (IN egn_ NN) (NOT (= egu_ (- egn_)))))))
                                          (NOT (= (GAMMA-PRODUCT egw_) 0)))))))
(c6w-cc-setup!) (c6m-cc-open!)
(let* ((p628 (c6-cite! 'proposition-6-28)))
  (dk-split-all! (list p628))
  (let* ((hzs (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'HAS-ZERO-OF-ORDER))) (dk-asms)))
         (nzs (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q '(RECIP-GAMMA egw_)))) (dk-asms)))
         (rgw! (lambda (w)                       ; w in CC, the NPI universal for w in context: RECIP-GAMMA(w) /= 0, in CC
                 (dk-cite! 'holomorphic-on-in-fun 'CC 'RECIP-GAMMA) (fact 'fun-apply-type-c 'RECIP-GAMMA 'CC 'CC w)
                 (dk-apply! nzs w))))
    (dk-conj-close!
      (lambda ()
        (if (dk-contains? (dk-goal) 'IS-POLE)
            ;; the poles
            (let* ((n (dk-di-var!)) (a (list '- n)))
              (c6-nn! n) (c6-rr! a) (fact 'rr-subset-cc a) (fact 'rr-one-in) (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
              (dk-apply! hzs n)
              (dk-have! (list 'FORALL 'zpz_ (list 'IMPLIES (list 'IN 'zpz_ (c6p-PB a 1)) '(= (GAMMA-PRODUCT zpz_) (recip (RECIP-GAMMA zpz_)))))
                (lambda ()
                  (let ((z (dk-di-var!)))
                    (c6p-pb-open! a 1 z)
                    ;; z is no non-positive integer: |z - (-n)| < 1 and z /= -n
                    (dk-have! (list 'FORALL 'egn_ (list 'IMPLIES '(IN egn_ NN) (list 'NOT (list '= z '(- egn_)))))
                      (lambda ()
                        (let ((k (dk-di-var!)))
                          (c6-nn! k) (c6-rr! (list '- k)) (fact 'rr-subset-cc (list '- k))
                          (di)
                          (let* ((x (list '- (list '- k) a)) (lt (list '< (list 'magnitude (list '- z a)) 1)))
                            (dk-have! (list 'NOT (list '= k n))
                              (lambda () (di) (dk-have! (list '= z a) (lambda () (subst (list '= z (list '- k))) (subst (list '= k n)) (c6f-rfl-close!)))
                                         (ai (list 'NOT (list '= z a)))))
                            (c6-rr! x) (fact 'rr-subset-cc x)
                            (let* ((l1 (dk-rewrite-h! lt z (list '- k)))
                                   (ma (c6-cite! 'rr-magnitude-is-abs x))
                                   (l2 (dk-rewrite-h! l1 (list 'magnitude x) (list 'abs x)))
                                   (pa (begin (c6-rr! (list 'abs x)) (fact 'rr-one-in) (c6-cite! 'rr-abs-lt-parts x 1))))
                              (dk-split-all! (list pa))
                              (fact 'nn-succ-plus-one k) (fact 'nn-succ-plus-one n)
                              (use-em (list '< k n)
                                (lambda () (c6-cite! 'nn-lt-succ-le k n) (fact 'nn-succ-closed k) (c6-nn! (list 'succ k))
                                           (dk-absurd! (list '< x 1) (list '<= (list 'succ k) n) (list '= (list 'succ k) (list '+ k 1))))
                                (lambda () (c6-cite! 'nn-not-lt-le k n)
                                           (dk-have! (list 'NOT (list '= n k)) (lambda () (di) (dk-have! (list '= k n) (lambda () (subst (list '= k n)) (c6f-rfl-close!))) (ai (list 'NOT (list '= k n)))))
                                           (c6-and! (list '<= n k) (list 'NOT (list '= n k))) (c6-cite! 'rr-le-ne-lt n k)
                                           (c6-cite! 'nn-lt-succ-le n k) (fact 'nn-succ-closed n) (c6-nn! (list 'succ n))
                                           (dk-absurd! (list '< (list '- 1) x) (list '<= (list 'succ n) k) (list '= (list 'succ n) (list '+ n 1))))))))))
                    (rgw! z)
                    (c6p-npi-in! z)
                    (c6p-gamma-at! z)
                    (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))))
              (c6-cite! 'zero-to-pole 'RECIP-GAMMA a 1 'GAMMA-PRODUCT 1)
              (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))
            ;; no zeros
            (let* ((nw (c6-steps!)) (w (cadr (find-first (lambda (q) (dk-head-is? q 'IN)) nw))))
              (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN w c6p-npi)))))
              (rgw! w)
              (c6p-npi-in! w)
              (subst (c6p-gamma-at! w))
              (fact 'cc-recip-inverse (list 'RECIP-GAMMA w))
              (c6q-recip-nz! (list 'RECIP-GAMMA w))
              (dk-close-if! (lambda () #t) (lambda () (dk-ass!)))))))))
(qed 'proposition-6-28-gamma)
  
