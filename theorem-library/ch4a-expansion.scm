;;; (11) THE COEFFICIENT FUNCTIONAL f |-> LAURENT-COEFS(f, c, rho)(k): its integrands, its linearity, and the
;;; Cauchy estimate in terms of a bound of |f| on the circle (used by Proposition 5.26, ch4a-coefcont).
;;; For f holomorphic on an open u holding the circle |w - c| = rho and k in NN:
;;;   (a) the two integrands are continuous functions on the trace, and c_k, c_-(k+1) are 1/(2 pi i) times their integrals;
;;;   (b) |f| <= M on the trace gives |c_k| <= rho (1/rho)^(k+1) M and |c_-(k+1)| <= rho rho^k M;
;;;   (c) h = f + g on u gives c_k(h) = c_k(f) + c_k(g); (d) h = s f on u gives c_k(h) = s c_k(f).
(define (lx11-stmt fns extra body)
  (list 'FORALL 'u (lx-all fns (list 'FORALL 'c (list 'IMPLIES '(IN c CC)
    (list 'FORALL 'rho (list 'IMPLIES '(IN rho RR) (list 'IMPLIES '(< 0 rho)
      (lx-imps (append (list (list 'IS-OPEN lx-nfm 'u)) (map (lambda (fn) (list 'HOLOMORPHIC-ON 'u fn)) fns)
                       (list (list 'SUBSET (lx-Ti 'rho) 'u)) extra)
        body)))))))))
(define (lx11-setup! fns)
  (set! lx-cpt! lx-cpt0!)
  (fact 'rr-zero-in) (fact 'cc-zero-in) (fact 'rr-one-in) (fact 'cc-one-in)
  (lx-rr! lx-tp)
  (dk-have! (list '< 0 lx-tp) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-have! '(<= 0 rho) (lambda () (dk-ineq! '(< 0 rho))))
  (for-each (lambda (fn) (dk-cite! 'holomorphic-on-in-fun 'u fn) (dk-cite! 'holomorphic-on-continuous 'u fn)) fns)
  (dk-cite! 'cc-open-subset-cc 'u)
  (lx-tpi!)
  (dk-cite! 'circle-is-road 'c 'rho)
  (fact 'is-road-is-path (lx-Ci 'rho) (lx-Cdi 'rho) 0 lx-tp)
  (fact 'is-path-in-fun (lx-Ci 'rho) 0 lx-tp)
  (dk-cite! 'trace-subset-cc (lx-Ci 'rho) 0 lx-tp)
  (lx-FT! 'rho)
  (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ (lx-Ti 'rho)) '(NOT (= aix_ c))))
    (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*))) (lx-cpt0! 'rho x) (if (not (sequent-node-grounded? leaf)) (ass))))))
(define (lx11-find-k g cf)            ; the k of the first application (CF k) in g
  (cond ((not (pair? g)) #f)
        ((and (equal? (car g) cf) (pair? (cdr g))) (cadr g))
        (#t (or (lx11-find-k (car g) cf) (lx11-find-k (cdr g) cf)))))
;; (a) the integrands
(define (lx11-int-body k)
  (let ((Mp (lx-Mp 'rho k)) (Mn (lx-Mn 'rho k)) (T (lx-Ti 'rho)))
    (list 'AND (list 'IN Mp (list 'FUN T 'CC)) (list 'AND (lx-cont T Mp)
      (list 'AND (list 'IN Mn (list 'FUN T 'CC)) (list 'AND (lx-cont T Mn)
        (list 'AND (list '= (list lx-CF k) (lx-A k)) (list '= (list lx-CF (list '- (list '+ k 1))) (lx-B k)))))))))
(sp (make-wff (lx11-stmt '(f) '() (list 'FORALL 'lxk_ (list 'IMPLIES '(IN lxk_ NN) (lx11-int-body 'lxk_))))))
(dk-peel!)
(lx11-setup! '(f))
(let* ((g (dk-goal)) (k (lx11-find-k g lx-CF)))
  (fact 'nn-succ-closed k)
  (lx-LIp! 'rho k)
  (lx-LIn! 'rho k)
  (lx-cf-pos! k)
  (lx-cf-neg! k)
  (dk-conj-close! (lambda () (ass))))
(qed 'laurent-coef-integrands)
;; (b) the estimate from a bound M of |f| on the circle
(define (lx11-p-mag!)
  (dk-have! (list '= (list 'magnitude lx9-p) (list 'recip lx-tp))
    (lambda ()
      (dk-cite! 'aif-magnitude-recip lx-tpi)
      (subst (list '= (list 'magnitude lx9-p) (list 'recip (list 'magnitude lx-tpi))))
      (fact 'cc-i-in) (fact 'rr-subset-cc lx-tp)
      (dk-have! (list 'AND (list 'IN lx-tp 'CC) '(IN +i CC)))
      (dk-cite! 'cc-magnitude-mul lx-tp '+i)
      (subst (list '= (list 'magnitude lx-tpi) (list '* (list 'magnitude lx-tp) '(magnitude +i))))
      (dk-cite! 'cc-magnitude-i)
      (subst '(= (magnitude +i) 1))
      (dk-cite! 'rr-magnitude-is-abs lx-tp)
      (dk-have! (list '<= 0 lx-tp) (lambda () (dk-ineq! (list '< 0 lx-tp))))
      (dk-cite! 'rr-abs-of-nonneg lx-tp)
      (subst (list '= (list 'magnitude lx-tp) (list 'abs lx-tp)))
      (subst (list '= (list 'abs lx-tp) lx-tp))
      (dk-have! (list '= (list '* lx-tp 1) lx-tp) (lambda () (crs)))
      (subst (list '= (list '* lx-tp 1) lx-tp))
      (lx-rr! (list 'recip lx-tp))
      (rfl)))
  (fact 'cc-magnitude-closed lx9-p) (fact 'cc-magnitude-nonneg lx9-p)
  (lx-rr! (list 'recip lx-tp))
  (fact 'rr-recip-pos lx-tp)
  (fact 'rr-recip-inverse lx-tp)
  (dk-have! (list '<= 0 (list 'recip lx-tp)) (lambda () (dk-ineq! (list 'IN (list 'recip lx-tp) 'RR) (list '< 0 (list 'recip lx-tp))))))
(define (lx11-li-bound! pos? k M)     ; lands (<= |LI_rho(Mx k)| (* (* tp rho) (* M fac))); returns (claim . fac)
  (let* ((s 'rho) (b0 (if pos? '(recip rho) 'rho)) (n (if pos? (list 'succ k) k))
         (fac (list 'power b0 n))
         (Mi (if pos? (lx-LIp! s k) (lx-LIn! s k)))
         (bnd (list '* M fac))
         (claim (list '<= (list 'magnitude (lx-LIi s Mi)) (list '* (list '* lx-tp s) bnd))))
    (fact 'power-real-closed b0 n)
    (fact 'rr-power-nonneg n b0)
    (dk-type! bnd 'RR)
    (if (not (dk-asm? claim))
      (dk-have! claim
        (lambda ()
          (dk-have! (list 'FORALL 'bny_ (list 'IMPLIES (list 'IN 'bny_ (lx-Ti s)) (list '<= (list 'magnitude (list Mi 'bny_)) bnd)))
            (lambda ()
              (let* ((y (dk-di-var!)) (d (list '- y 'c)) (b (if pos? (list 'recip d) d)))
                (lx-cpt0! s y)
                (dk-lam-b!)
                (lx-cc! b) (lx-cc! (list 'power b n))
                (dk-have! (list 'AND (list 'IN (list 'f y) 'CC) (list 'IN (list 'power b n) 'CC)))
                (dk-cite! 'cc-magnitude-mul (list 'f y) (list 'power b n))
                (subst (list '= (list 'magnitude (list '* (list 'f y) (list 'power b n))) (list '* (list 'magnitude (list 'f y)) (list 'magnitude (list 'power b n)))))
                (dk-cite! 'cc-magnitude-power n b)
                (subst (list '= (list 'magnitude (list 'power b n)) (list 'power (list 'magnitude b) n)))
                (if pos? (begin (dk-cite! 'aif-magnitude-recip d) (subst (list '= (list 'magnitude b) (list 'recip (list 'magnitude d))))))
                (subst (list '= (list 'magnitude d) s))
                (dk-apply! (dk-ctx-form (list 'FORALL 'aiy_ (list 'IMPLIES (list 'IN 'aiy_ (lx-Ti s)) (list '<= '(magnitude (f aiy_)) M)))) y)
                (fact 'cc-magnitude-closed (list 'f y))
                (dk-have! (list 'AND (list '<= (list 'magnitude (list 'f y)) M) (list '<= 0 fac)))
                (fact 'rr-mul-le-right (list 'magnitude (list 'f y)) M fac)
                (if (pair? (dk-open-leaves)) (ass)))))
          (dk-cite! 'line-int-length-bound (lx-Ti s) Mi (lx-Ci s) (lx-Cdi s) 0 lx-tp)
          (dk-apply! (dk-ctx-form (list 'FORALL 'bnd (list 'IMPLIES '(IN bnd RR)
                       (list 'IMPLIES (list 'FORALL 'bny_ (list 'IMPLIES (list 'IN 'bny_ (lx-Ti s)) (list '<= (list 'magnitude (list Mi 'bny_)) 'bnd)))
                         (list '<= (list 'magnitude (lx-LIi s Mi)) (list '* (list 'ROAD-LENGTH (lx-Cdi s) 0 lx-tp) 'bnd))))))
                     bnd)
          (subst (list '= (list '* lx-tp s) (list 'ROAD-LENGTH (lx-Cdi s) 0 lx-tp)))
          (if (pair? (dk-open-leaves)) (ass)))))
    (cons claim fac)))
(define (lx11-scale! cf-eq claim fac M)
  ;; focus goal (<= (magnitude CF) (* (* rho fac) M)); cf-eq (= CF (* p LIS)); claim (<= |LIS| B)
  (let* ((lis (caddr (caddr cf-eq))) (B (caddr claim)) (ml (list 'magnitude lis))
         (lhs (list '* (list 'recip lx-tp) B)) (target (list '* (list '* 'rho fac) M)))
    (subst cf-eq)
    (fact 'cc-magnitude-closed lis) (fact 'cc-magnitude-nonneg lis)
    (dk-have! (list 'AND (list 'IN lx9-p 'CC) (list 'IN lis 'CC)))
    (dk-cite! 'cc-magnitude-mul lx9-p lis)
    (subst (list '= (list 'magnitude (list '* lx9-p lis)) (list '* (list 'magnitude lx9-p) ml)))
    (subst (list '= (list 'magnitude lx9-p) (list 'recip lx-tp)))
    (dk-type! B 'RR)
    (dk-have! (list 'AND (list '<= 0 (list 'recip lx-tp)) (list '<= ml B)))
    (fact 'rr-le-scale-nonneg (list 'recip lx-tp) ml B)
    (dk-type! target 'RR)
    (dk-have! (list '= lhs target)
      (lambda ()
        (let* ((tv (dk-name! lx-tp 'RR)) (rtv (dk-name! (list 'recip lx-tp) 'RR)) (pv (dk-name! fac 'RR)))
          (subst (list '= fac pv))
          (subst (list '= (list 'recip lx-tp) rtv)) (subst (list '= lx-tp tv))
          (dk-have! (list '= (list '* tv rtv) 1) (lambda () (subst (list '= tv lx-tp)) (subst (list '= rtv (list 'recip lx-tp))) (ass)))
          (let ((l2 (cadr (dk-goal))))
            (dk-have! (list '= l2 (list '* (list '* tv rtv) (list '* (list '* 'rho pv) M))) (lambda () (crs)))
            (subst (list '= l2 (list '* (list '* tv rtv) (list '* (list '* 'rho pv) M))))
            (subst (list '= (list '* tv rtv) 1))
            (crs)))))
    (dk-type! lhs 'RR)
    (dk-type! (list '* (list 'recip lx-tp) ml) 'RR)
    (dk-ineq! (list '<= (list '* (list 'recip lx-tp) ml) lhs) (list '= lhs target)
              (list 'IN (list '* (list 'recip lx-tp) ml) 'RR) (list 'IN lhs 'RR) (list 'IN target 'RR))))
(define lx11-fbound (list 'FORALL 'aiy_ (list 'IMPLIES (list 'IN 'aiy_ (lx-Ti 'rho)) '(<= (magnitude (f aiy_)) lxbm_))))
(sp (make-wff (lx11-stmt '(f) '()
  (list 'FORALL 'lxbm_ (list 'IMPLIES '(IN lxbm_ RR) (list 'IMPLIES '(<= 0 lxbm_) (list 'IMPLIES lx11-fbound
    (list 'FORALL 'lxk_ (list 'IMPLIES '(IN lxk_ NN)
      (list 'AND (list '<= (list 'magnitude (list lx-CF 'lxk_)) (list '* (list '* 'rho '(power (recip rho) (succ lxk_))) 'lxbm_))
                 (list '<= (list 'magnitude (list lx-CF '(- (+ lxk_ 1)))) (list '* (list '* 'rho '(power rho lxk_)) 'lxbm_))))))))))))
(dk-peel!)
(lx11-setup! '(f))
(dk-cite! 'circle-road-length 'c 'rho)
(fact 'rr-pos-ne-zero 'rho)
(dk-have! '(AND (IN rho RR) (NOT (= rho 0))))
(fact 'rr-recip-closed 'rho) (fact 'rr-recip-pos 'rho)
(dk-have! '(<= 0 (recip rho)) (lambda () (dk-ineq! '(IN (recip rho) RR) '(< 0 (recip rho)))))
(lx11-p-mag!)
(let* ((g (dk-goal)) (k (lx11-find-k g lx-CF)) (M (caddr (caddr (cadr g)))))
  (fact 'nn-succ-closed k)
  (let* ((eqp (lx-cf-pos! k)) (eqn (lx-cf-neg! k))
         (bp (lx11-li-bound! #t k M)) (bn (lx11-li-bound! #f k M)))
    (dk-conj-close!
      (lambda ()
        (if (dk-contains? (dk-goal) '(recip rho))
            (lx11-scale! eqp (car bp) (cdr bp) M)
            (lx11-scale! eqn (car bn) (cdr bn) M))))))
(qed 'laurent-coef-sup-bound)
;; (c), (d) linearity
(define (lx11-cf F) (list 'LAURENT-COEFS F 'c 'rho))
(define (lx11-M pos? F k)
  (lx-repl (if pos? (lx-Mp 'rho k) (lx-Mn 'rho k)) 'f F))
(define (lx11-lin! fns k pos? ptw-rhs combine)
  ;; fns = (f g h) or (f h); lands the integrand facts of each, the pointwise law of h's integrand, and rewrites
  ;; the focus goal (= CF_h(kk) (combine CF ...)) to an identity closed by crs over named terms
  (let* ((T (lx-Ti 'rho)) (kk (if pos? k (list '- (list '+ k 1)))))
    (for-each (lambda (F) (dk-split-all! (list (dk-cite! 'laurent-coef-integrands 'u F 'c 'rho k)))) fns)
    (let* ((Ms (map (lambda (F) (lx11-M pos? F k)) fns))
           (h (car (last-pair fns))) (Mh (car (last-pair Ms))))
      (for-each (lambda (M) (dk-cite! 'line-int-in-cc T M (lx-Ci 'rho) (lx-Cdi 'rho) 0 lx-tp)) Ms)
      (dk-cite! 'trace-is-set (lx-Ci 'rho) 0 lx-tp)
      (fact 'subset-refl T)
      (dk-have! (list 'FORALL 'liz_ (list 'IMPLIES (list 'IN 'liz_ T) (list '== (list Mh 'liz_) (ptw-rhs (lambda (i) (list (list-ref Ms i) 'liz_))))))
        (lambda ()
          (let* ((x (dk-di-var!)))
            (lx-cpt0! 'rho x)
            (for-each (lambda (F) (fact 'fun-apply-type-c F 'u 'CC x)) fns)
            (dk-lam-b!)
            (dk-apply! (dk-ctx-form (list 'FORALL 'lxz_ (list 'IMPLIES '(IN lxz_ u)
                                      (list '== (list h 'lxz_) (ptw-rhs (lambda (i) (list (list-ref fns i) 'lxz_)))))))
                       x)
            (subst (list '== (list h x) (ptw-rhs (lambda (i) (list (list-ref fns i) x)))))
            (let* ((g (dk-goal)) (P (caddr (cadr g))))
              (lx-cc! P)
              (let* ((pv (dk-name! P 'CC)))
                (subst (list '= P pv))
                (let* ((g2 (dk-goal)) (L (cadr g2)) (R (caddr g2)))
                  (dk-have! (list '= L R) (lambda () (crs)))
                  (subst (list '= L R))
                  (if (pair? (dk-open-leaves)) (qrfl))))))))
      (let* ((li-eq (if (= (length fns) 3)
                        (dk-apply! (dk-cite! 'line-int-sum T (car Ms) (cadr Ms) (lx-Ci 'rho) (lx-Cdi 'rho) 0 lx-tp) Mh)
                        (dk-apply! (dk-cite! 'line-int-scalar T (car Ms) (lx-Ci 'rho) (lx-Cdi 'rho) 0 lx-tp) 'lxs_ Mh)))
             (cfeqs (map (lambda (F M) (list '= (list (lx11-cf F) kk) (list '* lx-p (lx-LIi 'rho M)))) fns Ms)))
        (for-each (lambda (e) (subst e)) cfeqs)
        (subst li-eq)
        (let* ((pv (dk-name! lx-p 'CC))
               (lvs (map (lambda (M) (dk-name! (lx-LIi 'rho M) 'CC)) (list-head Ms (- (length Ms) 1)))))
          (subst (list '= lx-p pv))
          (for-each (lambda (M v) (subst (list '= (lx-LIi 'rho M) v))) (list-head Ms (- (length Ms) 1)) lvs)
          (crs))))))
(sp (make-wff (lx11-stmt '(f g h) (list '(FORALL lxz_ (IMPLIES (IN lxz_ u) (== (h lxz_) (+ (f lxz_) (g lxz_))))))
  (list 'FORALL 'lxk_ (list 'IMPLIES '(IN lxk_ NN)
    (list 'AND (list '= (list (lx11-cf 'h) 'lxk_) (list '+ (list (lx11-cf 'f) 'lxk_) (list (lx11-cf 'g) 'lxk_)))
               (list '= (list (lx11-cf 'h) '(- (+ lxk_ 1))) (list '+ (list (lx11-cf 'f) '(- (+ lxk_ 1))) (list (lx11-cf 'g) '(- (+ lxk_ 1)))))))))))
(dk-peel!)
(lx11-setup! '(f g h))
(let* ((g (dk-goal)) (k (lx11-find-k g (lx11-cf 'h))))
  (fact 'nn-succ-closed k)
  (dk-conj-close!
    (lambda ()
      (lx11-lin! '(f g h) k (not (dk-contains? (dk-goal) (list '- (list '+ k 1))))
                 (lambda (at) (list '+ (at 0) (at 1))) #f))))
(qed 'laurent-coef-add)
(sp (make-wff (list 'FORALL 'lxs_ (list 'IMPLIES '(IN lxs_ CC)
 (lx11-stmt '(f h) (list '(FORALL lxz_ (IMPLIES (IN lxz_ u) (== (h lxz_) (* lxs_ (f lxz_))))))
  (list 'FORALL 'lxk_ (list 'IMPLIES '(IN lxk_ NN)
    (list 'AND (list '= (list (lx11-cf 'h) 'lxk_) (list '* 'lxs_ (list (lx11-cf 'f) 'lxk_)))
               (list '= (list (lx11-cf 'h) '(- (+ lxk_ 1))) (list '* 'lxs_ (list (lx11-cf 'f) '(- (+ lxk_ 1)))))))))))))
(dk-peel!)
(lx11-setup! '(f h))
(let* ((g (dk-goal)) (k (lx11-find-k g (lx11-cf 'h))))
  (fact 'nn-succ-closed k)
  (dk-conj-close!
    (lambda ()
      (lx11-lin! '(f h) k (not (dk-contains? (dk-goal) (list '- (list '+ k 1))))
                 (lambda (at) (list '* 'lxs_ (at 0))) #f))))
(qed 'laurent-coef-scale)
