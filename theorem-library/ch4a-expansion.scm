(dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ (lx-Ti 's)) '(NOT (= aix_ c))))
  (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*))) (lx-cpt0! 's x) (if (not (sequent-node-grounded? leaf)) (ass)))))
(define lx-M8 (dk-skolem! (dk-fact! 'aif-trace-bounded 'u 'f (lx-Ci 's) 0 lx-tp)))
(dk-split-all!)
(dk-cite! 'circle-road-length 'c 's)
(fact 'rr-pos-ne-zero 's)
(dk-have! '(AND (IN s RR) (NOT (= s 0))))
(fact 'rr-recip-closed 's) (fact 'rr-recip-pos 's)
(dk-have! '(<= 0 (recip s)) (lambda () (dk-ineq! '(IN (recip s) RR) '(< 0 (recip s)))))
(ew lx-M8)
(dk-conj-close!
  (lambda ()
    (if (not (dk-head-is? (dk-goal) 'FORALL)) (ass)
        (let* ((k (dk-di-var!)))
          (fact 'nn-succ-closed k)
          (dk-conj-close!
            (lambda ()
              (let* ((pos? (dk-contains? (dk-goal) '(recip s)))
                     (fac (if pos? (list 'power '(recip s) (list 'succ k)) (list 'power 's k)))
                     (M (if pos? (lx-LIp! 's k) (lx-LIn! 's k)))
                     (bnd (list '* lx-M8 fac)))
                (fact 'power-real-closed (if pos? '(recip s) 's) (if pos? (list 'succ k) k))
                (fact 'rr-power-nonneg (if pos? (list 'succ k) k) (if pos? '(recip s) 's))
                (dk-type! bnd 'RR)
                (dk-have! (list 'FORALL 'bny_ (list 'IMPLIES (list 'IN 'bny_ (lx-Ti 's)) (list '<= (list 'magnitude (list M 'bny_)) bnd)))
                  (lambda ()
                    (let* ((y (dk-di-var!)) (d (list '- y 'c)) (b (if pos? (list 'recip d) d)) (n (if pos? (list 'succ k) k)))
                      (lx-cpt0! 's y)
                      (dk-lam-b!)
                      (lx-cc! b) (lx-cc! (list 'power b n))
                      (dk-have! (list 'AND (list 'IN (list 'f y) 'CC) (list 'IN (list 'power b n) 'CC)))
                      (dk-cite! 'cc-magnitude-mul (list 'f y) (list 'power b n))
                      (subst (list '= (list 'magnitude (list '* (list 'f y) (list 'power b n))) (list '* (list 'magnitude (list 'f y)) (list 'magnitude (list 'power b n)))))
                      (dk-cite! 'cc-magnitude-power n b)
                      (subst (list '= (list 'magnitude (list 'power b n)) (list 'power (list 'magnitude b) n)))
                      (if pos? (begin (dk-cite! 'aif-magnitude-recip d) (subst (list '= (list 'magnitude b) (list 'recip (list 'magnitude d))))))
                      (subst (list '= (list 'magnitude d) 's))
                      (dk-apply! (dk-ctx-form (list 'FORALL 'aiy_ (list 'IMPLIES (list 'IN 'aiy_ (lx-Ti 's)) (list '<= '(magnitude (f aiy_)) lx-M8)))) y)
                      (fact 'cc-magnitude-closed (list 'f y))
                      (dk-have! (list 'AND (list '<= (list 'magnitude (list 'f y)) lx-M8) (list '<= 0 fac)))
                      (fact 'rr-mul-le-right (list 'magnitude (list 'f y)) lx-M8 fac)
                      (if (pair? (dk-open-leaves)) (ass)))))
                (dk-cite! 'line-int-length-bound (lx-Ti 's) M (lx-Ci 's) (lx-Cdi 's) 0 lx-tp)
                (dk-apply! (dk-ctx-form (list 'FORALL 'bnd (list 'IMPLIES '(IN bnd RR)
                             (list 'IMPLIES (list 'FORALL 'bny_ (list 'IMPLIES (list 'IN 'bny_ (lx-Ti 's)) (list '<= (list 'magnitude (list M 'bny_)) 'bnd)))
                               (list '<= (list 'magnitude (lx-LIi 's M)) (list '* (list 'ROAD-LENGTH (lx-Cdi 's) 0 lx-tp) 'bnd))))))
                           bnd)
                (subst (list '= (list '* lx-tp 's) (list 'ROAD-LENGTH (lx-Cdi 's) 0 lx-tp)))
                (if (pair? (dk-open-leaves)) (ass)))))))))
(qed 'laurent-coef-estimate)

;;; (9) THE RADII OF LAURENT-COEFS: f holomorphic on an open u holding the punctured disc A(c, 0, R), 0 < rho < R:
;;;   rp < CPS-RADIUS(k |-> LAURENT-COEFS(f, c, rho)(k))            for every real rp < R,
;;;   1/rm < CPS-RADIUS(l |-> LAURENT-COEFS(f, c, rho)(-(l+1)))      for every rm > 0.
;;; Cauchy estimates on a circle of radius s (laurent-coef-estimate), moved to rho (laurent-coef-radius-free),
;;; give |c_k| <= M (1/s)^k and |c_-(l+1)| <= s M s^l; cps-radius-from-bound turns them into radii.
(define lx9-cp (list 'VNB-LAMBDA 'lak_ 'NN (list lx-CF 'lak_)))
(define lx9-cn (list 'VNB-LAMBDA 'lak_ 'NN (list lx-CF '(- (+ lak_ 1)))))
(define lx9-punct '(FORALL lxb_ (IMPLIES (IN lxb_ CC) (IMPLIES (< 0 (magnitude (- lxb_ c))) (IMPLIES (< (magnitude (- lxb_ c)) R) (IN lxb_ u))))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'R (list 'IMPLIES '(IN R RR)
  (list 'FORALL 'rho (list 'IMPLIES '(IN rho RR) (list 'IMPLIES '(< 0 rho) (list 'IMPLIES '(< rho R)
    (lx-imps (list (list 'IS-OPEN lx-nfm 'u) '(HOLOMORPHIC-ON u f) lx9-punct)
      (list 'AND (list 'FORALL 'lrp_ (list 'IMPLIES '(IN lrp_ RR) (list 'IMPLIES '(< lrp_ R) (list '< 'lrp_ (list 'CPS-RADIUS lx9-cp)))))
                 (list 'FORALL 'lrm_ (list 'IMPLIES '(IN lrm_ RR) (list 'IMPLIES '(< 0 lrm_) (list '< '(recip lrm_) (list 'CPS-RADIUS lx9-cn)))))))))))))))))))
(dk-peel!)
(set! lx-cpt! lx-cpt0!)
(fact 'rr-zero-in) (fact 'cc-zero-in) (fact 'rr-one-in) (fact 'cc-one-in)
(lx-rr! lx-tp)
(dk-have! (list '< 0 lx-tp) (lambda () (dk-ineq! '(< 0 PI))))
(dk-have! '(<= 0 rho) (lambda () (dk-ineq! '(< 0 rho))))
(dk-cite! 'holomorphic-on-in-fun 'u 'f)
(dk-cite! 'holomorphic-on-open 'u 'f)
(dk-cite! 'cc-open-subset-cc 'u)
(dk-cite! 'holomorphic-on-continuous 'u 'f)
(lx-tpi!)
(define (lx9-in-u! x m)              ; x in CC, 0 < m = |x - c| < R in context: x in u
  (dk-apply! (dk-ctx-form lx9-punct) x))
(define (lx9-band! lo hi)            ; 0 < lo < hi < R: the band hypothesis for u
  (dk-have! (lx-repl (lx-repl lx-band 'r1 lo) 'r2 hi)
    (lambda ()
      (let* ((x (dk-di-var!)))
        (di) (di)
        (let ((m (list 'magnitude (list '- x 'c))) (leaf (proof-state-focus *ps*)))
          (fact 'cc-sub-in-cc x 'c) (lx-rr! m)
          (dk-have! (list '< 0 m) (lambda () (dk-ineq! (list '<= lo m) (list '< 0 lo) (list 'IN lo 'RR) (list 'IN m 'RR))))
          (dk-have! (list '< m 'R) (lambda () (dk-ineq! (list '<= m hi) (list '< hi 'R) (list 'IN hi 'RR) (list 'IN m 'RR) '(IN R RR))))
          (lx9-in-u! x m)
          (if (not (sequent-node-grounded? leaf)) (ass)))))))
(define (lx9-trace! s)               ; 0 < s < R: the circle of radius s, its trace in u, FT(s) continuous, avoiding c
  (dk-cite! 'circle-is-road 'c s)
  (fact 'is-road-is-path (lx-Ci s) (lx-Cdi s) 0 lx-tp)
  (fact 'is-path-in-fun (lx-Ci s) 0 lx-tp)
  (dk-cite! 'trace-subset-cc (lx-Ci s) 0 lx-tp)
  (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list '< 0 s))))
  (dk-have! (list 'SUBSET (lx-Ti s) 'u)
    (lambda ()
      (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)) (m (list 'magnitude (list '- y 'c))))
        (fact 'subset-mem-fwd (lx-Ti s) 'CC y)
        (dk-cite! 'circle-trace-magnitude 'c s y)
        (fact 'cc-sub-in-cc y 'c) (lx-rr! m)
        (dk-have! (list '< 0 m) (lambda () (dk-ineq! (list '= m s) (list '< 0 s) (list 'IN s 'RR))))
        (dk-have! (list '< m 'R) (lambda () (dk-ineq! (list '= m s) (list '< s 'R) (list 'IN s 'RR) '(IN R RR))))
        (lx9-in-u! y m)
        (if (not (sequent-node-grounded? leaf)) (ass)))))
  (lx-FT! s)
  (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ (lx-Ti s)) '(NOT (= aix_ c))))
    (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*))) (lx-cpt0! s x) (if (not (sequent-node-grounded? leaf)) (ass))))))
;; |1/(2 pi i)| = 1/(2 pi)
(define lx9-p (list 'recip lx-tpi))
(dk-have! (list '= (list 'magnitude lx9-p) (list 'recip lx-tp))
  (lambda ()
    (dk-cite! 'aif-magnitude-recip lx-tpi)
    (subst (list '= (list 'magnitude lx9-p) (list 'recip (list 'magnitude lx-tpi))))
    (fact 'cc-i-in) (fact 'rr-subset-cc lx-tp)
    (dk-have! (list 'AND (list 'IN lx-tp 'CC) '(IN +i CC)))
    (dk-cite! 'cc-magnitude-mul lx-tp '+i)
    (subst (list '= (list 'magnitude lx-tpi) (list '* (list 'magnitude lx-tp) '(magnitude +i))))
    (dk-cite! 'cc-magnitude-i)
    (subst '(= (magnitude +i) 1))
    (dk-cite! 'rr-magnitude-is-abs lx-tp)
    (dk-have! (list '<= 0 lx-tp) (lambda () (dk-ineq! (list '< 0 lx-tp))))
    (dk-cite! 'rr-abs-of-nonneg lx-tp)
    (subst (list '= (list 'magnitude lx-tp) (list 'abs lx-tp)))
    (subst (list '= (list 'abs lx-tp) lx-tp))
    (dk-have! (list '= (list '* lx-tp 1) lx-tp) (lambda () (crs)))
    (subst (list '= (list '* lx-tp 1) lx-tp))
    (lx-rr! (list 'recip lx-tp))
    (rfl)))
(fact 'cc-magnitude-closed lx9-p) (fact 'cc-magnitude-nonneg lx9-p)
(lx-rr! (list 'recip lx-tp))
(fact 'rr-recip-pos lx-tp)
(dk-cite! 'rr-recip-inverse lx-tp)
(lx9-trace! 'rho)
;; |p X| <= C F^k from |X| <= (2 pi s) (M G): the scaling by |p| = 1/(2 pi), the rest by IDENT (names, crs)
(define (lx9-bound-goal! coef-eq li-eq est target-of)
  ;; focus goal: (<= (magnitude CF) TARGET).  coef-eq: (= CF (* p LIR)); li-eq: (= LIR LIS); est: (<= (magnitude LIS) B).
  (let* ((cfk (cadr coef-eq)) (lir (caddr (caddr coef-eq))) (lis (caddr li-eq)) (B (caddr est)))
    (subst coef-eq)
    (subst li-eq)
    (fact 'cc-magnitude-closed lis) (fact 'cc-magnitude-nonneg lis)
    (dk-have! (list 'AND (list 'IN lx9-p 'CC) (list 'IN lis 'CC)))
    (dk-cite! 'cc-magnitude-mul lx9-p lis)
    (subst (list '= (list 'magnitude (list '* lx9-p lis)) (list '* (list 'magnitude lx9-p) (list 'magnitude lis))))
    (subst (list '= (list 'magnitude lx9-p) (list 'recip lx-tp)))
    (dk-type! B 'RR)
    (dk-have! '(<= 0 (recip (* 2 PI))) (lambda () (dk-ineq! '(IN (recip (* 2 PI)) RR) '(< 0 (recip (* 2 PI))))))
    (dk-have! (list 'AND (list '<= 0 (list 'recip lx-tp)) (list '<= (list 'magnitude lis) B)))
    (fact 'rr-le-scale-nonneg (list 'recip lx-tp) (list 'magnitude lis) B)
    (target-of B)))
;; c_k = 1/(2 pi i) LI_rho(...) for all k in NN, proven once (outside any typing lane), instantiated at k
(define lx9-cf-univ (list 'FORALL 'lxq_ (list 'IMPLIES '(IN lxq_ NN) (list '= (list lx-CF 'lxq_) (lx-A 'lxq_)))))
(define (lx9-cf-all!)
  (if (not (dk-asm? lx9-cf-univ))
      (dk-have! lx9-cf-univ (lambda () (let ((k (dk-di-var!))) (lx-cf-pos! k) (if (pair? (dk-open-leaves)) (ass)))))))
(define (lx9-cf-at! k)                ; k in NN: (= (CF k) A(k)) landed, A(k) typed
  (dk-apply! (dk-ctx-form lx9-cf-univ) k)
  (lx-LIp! 'rho k)
  (lx-cc! (lx-A k))
  (list '= (list lx-CF k) (lx-A k)))
(define (lx9-pos! s hyp)
  (let ((prem (list hyp '(IN rho RR) '(IN R RR) '(IN lrp_ RR) '(< 0 rho) '(< rho R) '(< lrp_ R))))
    (dk-type! s 'RR)
    (for-each (lambda (cl) (dk-have! cl (lambda () (apply dk-ineq! (cons (list 'IN s 'RR) prem)))))
              (list (list '< 'rho s) (list '< s 'R) (list '< 'lrp_ s) (list '< 0 s))))
  (lx9-trace! s)
  (lx9-band! 'rho s)
  (let* ((rf (dk-cite! 'laurent-coef-radius-free 'u 'f 'c 'rho s))
         (M (dk-skolem! (dk-cite! 'laurent-coef-estimate 'u 'f 'c s)))
         (rs (list 'recip s)))
    (dk-split-all!)
    (fact 'rr-pos-ne-zero s)
    (dk-have! (list 'AND (list 'IN s 'RR) (list 'NOT (list '= s 0))))
    (fact 'rr-recip-closed s) (fact 'rr-recip-pos s) (fact 'rr-recip-inverse s)
    (lx9-cf-all!)
    (dk-have! (list 'IN lx9-cp '(FUN NN CC))
      (lambda () (dk-lam-type! (lambda () (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                            (lx9-cf-at! k)
                                            (if (not (sequent-node-grounded? leaf)) (begin (if (dk--redex? (dk-goal)) (dk-lam-b!)) (subst (list '= (list lx-CF k) (lx-A k))) (if (not (sequent-node-grounded? leaf)) (ass)))))))))
    (dk-have! (list 'FORALL 'lrk_ (list 'IMPLIES '(IN lrk_ NN) (list '<= (list 'magnitude (list lx9-cp 'lrk_)) (list '* M (list 'power rs 'lrk_)))))
      (lambda ()
        (let* ((k (dk-di-var!)) (eq (lx9-cf-at! k)))
          (fact 'nn-succ-closed k)
          (lx-LIp! s k)
          (let* ((r1 (dk-apply! rf k)) (_ (dk-split! r1)) (e1 (dk-apply! (dk-ctx-form (list 'FORALL 'lxk_ (list 'IMPLIES '(IN lxk_ NN)
                                    (list 'AND (list '<= (list 'magnitude (lx-LIi s (lx-Mp s 'lxk_))) (list '* (list '* lx-tp s) (list '* M (list 'power rs '(succ lxk_)))))
                                               (list '<= (list 'magnitude (lx-LIi s (lx-Mn s 'lxk_))) (list '* (list '* lx-tp s) (list '* M (list 'power s 'lxk_)))))))) k)))
            (dk-split! e1)
            (dk-lam-b!)
            (lx9-bound-goal! eq (list '= (lx-LIi 'rho (lx-Mp 'rho k)) (lx-LIi s (lx-Mp s k))) (cadr e1)
              (lambda (B)
                (let* ((tv (dk-name! lx-tp 'RR)) (rtv (dk-name! (list 'recip lx-tp) 'RR)) (sv s)
                       (pw (list 'power rs k)))
                  (fact 'power-real-closed rs k) (fact 'rr-subset-cc rs)
                  (dk-have! (list 'AND (list 'IN rs 'CC) (list 'IN k 'NN)))
                  (dk-cite! 'power-succ rs k)
                  (fact 'rr-recip-inverse lx-tp)
                  (let ((target (list '* M pw)) (lhs (list '* (list 'recip lx-tp) B)))
                    (dk-have! (list '= lhs target)
                      (lambda ()
                        (subst (list '= (list 'power rs (list 'succ k)) (list '* rs pw)))
                        (let* ((pv (dk-name! pw 'RR)) (rv (dk-name! rs 'RR)))
                          (subst (list '= pw pv)) (subst (list '= rs rv))
                          (subst (list '= (list 'recip lx-tp) rtv)) (subst (list '= lx-tp tv))
                          (dk-have! (list '= (list '* tv rtv) 1) (lambda () (subst (list '= tv lx-tp)) (subst (list '= rtv (list 'recip lx-tp))) (ass)))
                          (dk-have! (list '= (list '* s rv) 1) (lambda () (subst (list '= rv rs)) (ass)))
                          (let ((l2 (cadr (dk-goal))))
                            (dk-have! (list '= l2 (list '* (list '* (list '* tv rtv) (list '* s rv)) (list '* M pv))) (lambda () (crs)))
                            (subst (list '= l2 (list '* (list '* (list '* tv rtv) (list '* s rv)) (list '* M pv))))
                            (subst (list '= (list '* tv rtv) 1)) (subst (list '= (list '* s rv) 1))
                            (crs)))))
                    (dk-type! lhs 'RR) (dk-type! target 'RR)
                    (dk-type! (list '* (list 'recip lx-tp) (list 'magnitude (lx-LIi s (lx-Mp s k)))) 'RR)
                    (dk-ineq! (list '<= (list '* (list 'recip lx-tp) (list 'magnitude (lx-LIi s (lx-Mp s k)))) lhs) (list '= lhs target)
                              (list 'IN (list '* (list 'recip lx-tp) (list 'magnitude (lx-LIi s (lx-Mp s k)))) 'RR) (list 'IN lhs 'RR) (list 'IN target 'RR))))))))))
    (dk-apply! (dk-cite! 'cps-radius-from-bound lx9-cp M s) 'lrp_)
    (if (pair? (dk-open-leaves)) (ass))))
(define lx9-posclaim (list 'FORALL 'lrp_ (list 'IMPLIES '(IN lrp_ RR) (list 'IMPLIES '(< lrp_ R) (list '< 'lrp_ (list 'CPS-RADIUS lx9-cp))))))
(dk-have! lx9-posclaim
  (lambda ()
    (dk-peel!)
    (use-em '(<= lrp_ rho)
      (lambda () (lx9-pos! '(* 1/2 (+ rho R)) '(<= lrp_ rho)))
      (lambda () (fact 'rr-not-le-lt 'lrp_ 'rho) (lx9-pos! '(* 1/2 (+ lrp_ R)) '(< rho lrp_))))))
;; c_-(l+1) = 1/(2 pi i) LI_rho(f (w - c)^l) for all l in NN
(define lx9-cfn-univ (list 'FORALL 'lxq_ (list 'IMPLIES '(IN lxq_ NN) (list '= (list lx-CF '(- (+ lxq_ 1))) (lx-B 'lxq_)))))
(dk-have! lx9-cfn-univ (lambda () (let ((l (dk-di-var!))) (lx-cf-neg! l) (if (pair? (dk-open-leaves)) (ass)))))
(define (lx9-cfn-at! l)
  (dk-apply! (dk-ctx-form lx9-cfn-univ) l)
  (lx-LIn! 'rho l)
  (lx-cc! (lx-B l))
  (list '= (list lx-CF (list '- (list '+ l 1))) (lx-B l)))
(define (lx9-recip-half! a)            ; a in RR, 0 < a: (= (recip (* 1/2 a)) (* 2 (recip a)))
  (let* ((h (list '* 1/2 a)) (t (list 'recip h)) (ra (list 'recip a)))
    (dk-type! h 'RR)
    (dk-have! (list '< 0 h) (lambda () (dk-ineq! (list '< 0 a) (list 'IN a 'RR) (list 'IN h 'RR))))
    (fact 'rr-pos-ne-zero h) (fact 'rr-pos-ne-zero a)
    (dk-have! (list 'AND (list 'IN h 'RR) (list 'NOT (list '= h 0))))
    (dk-have! (list 'AND (list 'IN a 'RR) (list 'NOT (list '= a 0))))
    (fact 'rr-recip-closed h) (fact 'rr-recip-closed a) (fact 'rr-recip-pos h) (fact 'rr-recip-pos a)
    (fact 'rr-recip-inverse h) (fact 'rr-recip-inverse a)
    (dk-have! (list '= t (list '* 2 ra))
      (lambda ()
        (let* ((tv (dk-name! t 'RR)) (rv (dk-name! ra 'RR)))
          (subst (list '= t tv)) (subst (list '= ra rv))
          (dk-have! (list '= (list '* h tv) 1) (lambda () (subst (list '= tv t)) (ass)))
          (dk-have! (list '= (list '* a rv) 1) (lambda () (subst (list '= rv ra)) (ass)))
          (dk-have! (list '= tv (list '* tv (list '* a rv))) (lambda () (subst (list '= (list '* a rv) 1)) (crs)))
          (subst (list '= tv (list '* tv (list '* a rv))))
          (dk-have! (list '= (list '* tv (list '* a rv)) (list '* (list '* h tv) (list '* 2 rv))) (lambda () (crs)))
          (subst (list '= (list '* tv (list '* a rv)) (list '* (list '* h tv) (list '* 2 rv))))
          (subst (list '= (list '* h tv) 1))
          (crs))))))
(define (lx9-neg! s hyp)
  (let ((prem (list hyp '(IN rho RR) '(IN R RR) '(IN lrm_ RR) '(< 0 rho) '(< rho R) '(< 0 lrm_))))
    (dk-type! s 'RR)
    (for-each (lambda (cl) (dk-have! cl (lambda () (apply dk-ineq! (cons (list 'IN s 'RR) prem)))))
              (list (list '< s 'rho) (list '< s 'R) (list '< s 'lrm_) (list '< 0 s))))
  (lx9-trace! s)
  (lx9-band! s 'rho)
  (let* ((rf (dk-cite! 'laurent-coef-radius-free 'u 'f 'c s 'rho))
         (M (dk-skolem! (dk-cite! 'laurent-coef-estimate 'u 'f 'c s)))
         (rs (list 'recip s)) (C (list '* s M)))
    (dk-split-all!)
    (fact 'rr-pos-ne-zero s)
    (dk-have! (list 'AND (list 'IN s 'RR) (list 'NOT (list '= s 0))))
    (fact 'rr-recip-closed s) (fact 'rr-recip-pos s) (fact 'rr-recip-inverse s)
    (dk-cite! 'rr-recip-recip-pos s)
    (dk-type! C 'RR)
    (dk-have! (list '<= 0 C) (lambda () (dk-have! (list 'AND (list 'IN s 'RR) (list 'IN M 'RR))) (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list '< 0 s))))
                                         (dk-have! (list 'AND (list '<= 0 s) (list '<= 0 M))) (fact 'rr-leq-mul-nonneg s M) (ass)))
    (dk-have! (list 'IN lx9-cn '(FUN NN CC))
      (lambda () (dk-lam-type! (lambda () (let* ((l (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                            (lx9-cfn-at! l)
                                            (if (not (sequent-node-grounded? leaf))
                                                (begin (if (dk--redex? (dk-goal)) (dk-lam-b!))
                                                       (subst (list '= (list lx-CF (list '- (list '+ l 1))) (lx-B l)))
                                                       (if (not (sequent-node-grounded? leaf)) (ass)))))))))
    (dk-have! (list 'FORALL 'lrk_ (list 'IMPLIES '(IN lrk_ NN) (list '<= (list 'magnitude (list lx9-cn 'lrk_)) (list '* C (list 'power (list 'recip rs) 'lrk_)))))
      (lambda ()
        (let* ((l (dk-di-var!)) (eq (lx9-cfn-at! l)))
          (lx-LIn! s l)
          (let* ((r1 (dk-apply! rf l)) (_ (dk-split! r1))
                 (e1 (dk-apply! (dk-ctx-form (list 'FORALL 'lxk_ (list 'IMPLIES '(IN lxk_ NN)
                                    (list 'AND (list '<= (list 'magnitude (lx-LIi s (lx-Mp s 'lxk_))) (list '* (list '* lx-tp s) (list '* M (list 'power rs '(succ lxk_)))))
                                               (list '<= (list 'magnitude (lx-LIi s (lx-Mn s 'lxk_))) (list '* (list '* lx-tp s) (list '* M (list 'power s 'lxk_)))))))) l)))
            (dk-split! e1)
            (dk-lam-b!)
            (subst (list '= (list 'recip rs) s))
            (lx9-bound-goal! eq (list '= (lx-LIi 'rho (lx-Mn 'rho l)) (lx-LIi s (lx-Mn s l))) (caddr e1)
              (lambda (B)
                (let* ((tv (dk-name! lx-tp 'RR)) (rtv (dk-name! (list 'recip lx-tp) 'RR)) (pw (list 'power s l)))
                  (fact 'power-real-closed s l)
                  (let ((target (list '* C pw)) (lhs (list '* (list 'recip lx-tp) B)))
                    (dk-have! (list '= lhs target)
                      (lambda ()
                        (let* ((pv (dk-name! pw 'RR)))
                          (subst (list '= pw pv))
                          (subst (list '= (list 'recip lx-tp) rtv)) (subst (list '= lx-tp tv))
                          (dk-have! (list '= (list '* tv rtv) 1) (lambda () (subst (list '= tv lx-tp)) (subst (list '= rtv (list 'recip lx-tp))) (ass)))
                          (let ((l2 (cadr (dk-goal))))
                            (dk-have! (list '= l2 (list '* (list '* tv rtv) (list '* (list '* s M) pv))) (lambda () (crs)))
                            (subst (list '= l2 (list '* (list '* tv rtv) (list '* (list '* s M) pv))))
                            (subst (list '= (list '* tv rtv) 1))
                            (crs)))))
                    (dk-type! lhs 'RR) (dk-type! target 'RR)
                    (dk-type! (list '* (list 'recip lx-tp) (list 'magnitude (lx-LIi s (lx-Mn s l)))) 'RR)
                    (dk-ineq! (list '<= (list '* (list 'recip lx-tp) (list 'magnitude (lx-LIi s (lx-Mn s l)))) lhs) (list '= lhs target)
                              (list 'IN (list '* (list 'recip lx-tp) (list 'magnitude (lx-LIi s (lx-Mn s l)))) 'RR) (list 'IN lhs 'RR) (list 'IN target 'RR))))))))))
    ;; 1/rm < 1/s: s = a/2 with a = rm or a = rho >= ... ; 1/s = 2/a
    (fact 'rr-pos-ne-zero 'lrm_)
    (dk-have! '(AND (IN lrm_ RR) (NOT (= lrm_ 0))))
    (fact 'rr-recip-closed 'lrm_) (fact 'rr-recip-pos 'lrm_)
    (let* ((a (caddr s)) (ra (list 'recip a)))
      (lx9-recip-half! a)
      (if (eq? a 'lrm_)
          (dk-have! (list '< '(recip lrm_) rs)
            (lambda () (dk-ineq! (list '= rs (list '* 2 ra)) (list '< 0 ra) (list 'IN ra 'RR) (list 'IN rs 'RR))))
          (begin
            (dk-have! '(<= rho lrm_) (lambda () (dk-ineq! '(< rho lrm_))))
            (dk-cite! 'rr-recip-antitone 'rho 'lrm_)
            (dk-have! (list '< '(recip lrm_) rs)
              (lambda () (dk-ineq! (list '= rs (list '* 2 ra)) (list '< 0 ra) (list 'IN ra 'RR) (list 'IN rs 'RR)
                                   (list '<= '(recip lrm_) ra) '(IN (recip lrm_) RR)))))))
    (dk-apply! (dk-cite! 'cps-radius-from-bound lx9-cn C rs) '(recip lrm_))
    (if (pair? (dk-open-leaves)) (ass))))
(define lx9-negclaim (list 'FORALL 'lrm_ (list 'IMPLIES '(IN lrm_ RR) (list 'IMPLIES '(< 0 lrm_) (list '< '(recip lrm_) (list 'CPS-RADIUS lx9-cn))))))
(dk-have! lx9-negclaim
  (lambda ()
    (dk-peel!)
    (use-em '(<= lrm_ rho)
      (lambda () (lx9-neg! '(* 1/2 lrm_) '(<= lrm_ rho)))
      (lambda () (fact 'rr-not-le-lt 'lrm_ 'rho) (lx9-neg! '(* 1/2 rho) '(< rho lrm_))))))
(dk-conj-close! (lambda () (ass)))
(qed 'laurent-coefs-radii)

;;; (10) LAURENT-COEFS(f, c, rho) is a family in fun(zz, cc) when f is holomorphic on an open u holding the circle
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'FORALL 'c (list 'IMPLIES '(IN c CC)
  (list 'FORALL 'rho (list 'IMPLIES '(IN rho RR) (list 'IMPLIES '(< 0 rho)
