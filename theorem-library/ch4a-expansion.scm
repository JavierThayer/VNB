;;; Library: complex-analysis.

;;; ch4a-expansion.scm -- Proposition 4.5 (CH4-A, 2026-10-28): the Laurent expansion of a function holomorphic on
;;; an annulus.  For f holomorphic on an open u holding the closed annulus r1 <= |w - a| <= r2 and r1 < |z - a| < r2:
;;;   2 pi i f(z) = int_{C(a, r2)} f(w)/(w - z) dw - int_{C(a, r1)} f(w)/(w - z) dw          (the notes' (110) step)
;;; and the two integrals expand as a power series in (z - a) (Lemma 3.33) and a series in 1/(z - a) (Lemma 4.4,
;;; second half).  Library: complex-analysis.  Load window: after ch4a-annulus (annulus-cauchy), ch4a-outer,
;;; cauchy-integral-formula, ch3a-schwarz (holomorphic-removable-point), cauchy-centre-mean-value, winding-number-laws, morera.  Prefix lx-.
;;; The helpers lx-* down to lx-kern-setup! are copied from cauchy-integral-formula.scm (cif-*), renamed.

   ; KIT-9 link skipping, opt-in per file (integrator, 2026-10-29)
(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

(define lx-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (lx-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (lx-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u)
    (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS lx-nfm u) lx-nfm f 'rgy_))))
(define (lx-imps hyps body)
  (if (null? hyps) body (list 'IMPLIES (car hyps) (lx-imps (cdr hyps) body))))
(define (lx-all vars body)
  (if (null? vars) body (list 'FORALL (car vars) (lx-all (cdr vars) body))))
(define (lx-and! a b)
  (let* ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (lx-pz z) (list 'DIFFERENCE 'CC (list 'SINGLETON z)))

(define (lx-rr! t)
  (let* ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((eq? t 'PI) (dk-split-all! (list (dk-cite! 'pi-pos))) typ)
          ((number? t) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((lx-op? t 'succ 2) (lx-nn! t) (fact 'nn-in-rr t) typ)
          ((lx-op? t '* 3) (lx-rr! (cadr t)) (lx-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((lx-op? t '+ 3) (lx-rr! (cadr t)) (lx-rr! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((lx-op? t '- 3) (lx-rr! (cadr t)) (lx-rr! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((lx-op? t '- 2) (lx-rr! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((lx-op? t 'magnitude 2) (lx-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((lx-op? t 'real-part 2) (lx-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((lx-op? t 'imag-part 2) (lx-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((lx-op? t 'abs 2) (lx-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((lx-op? t 'recip 2)
           (lx-rr! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (if (dk-asm? (list '< 0 (cadr t)))
                   (fact 'rr-pos-ne-zero (cadr t))
                   (error "lx-rr!: land the non-vanishing first" (expression->string (cadr t)))))
           (lx-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t))
           typ)
          (#t (dk-real! t) typ))))
(define (lx-nn! t)
  (let* ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((lx-op? t 'succ 2) (lx-nn! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          (#t (dk-type! t 'NN)))))
(define (lx-cc! t)
  (let* ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((or (and (number? t) (real? t)) (eq? t 'PI) (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
               (lx-op? t 'succ 2)
               (lx-op? t 'magnitude 2) (lx-op? t 'real-part 2) (lx-op? t 'imag-part 2))
           (lx-rr! t) (fact 'rr-subset-cc t) typ)
          ((lx-op? t '- 3) (lx-cc! (cadr t)) (lx-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((lx-op? t '- 2) (lx-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((lx-op? t '+ 3) (lx-cc! (cadr t)) (lx-cc! (caddr t))
           (lx-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((lx-op? t '* 3) (lx-cc! (cadr t)) (lx-cc! (caddr t))
           (lx-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((lx-op? t 'power 3) (lx-cc! (cadr t)) (lx-nn! (caddr t))
           (lx-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((lx-op? t 'CC-EXP 2) (lx-cc! (cadr t))
           (dk-split-all! (list (dk-cite! 'cc-exp-converges (cadr t)))) typ)
          ((lx-op? t 'recip 2) (lx-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "lx-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (lx-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (dk-type! t 'CC)))))

;;; y in CC \ {z}: land y in CC, y /= z, y - z /= 0
(define (lx-sub-nz! y z)
  (let* ((nz (list 'NOT (list '= (list '- y z) 0))))
    (dk-have! nz
      (lambda ()
        (di)
        (dk-cite! 'cc-sub-zero-eq y z)
        (ai (dk-ctx-form (list 'NOT (list '= y z))))))
    nz))
(define (lx-steps . thunks)
  ;; run THUNKS in order while the leaf focused at the start stays open
  (let* ((leaf (proof-state-focus *ps*)))
    (let loop ((ts thunks))
      (if (and (pair? ts) (not (sequent-node-grounded? leaf)))
          (begin ((car ts)) (loop (cdr ts)))))))
(define (lx-pz-open! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (lx-steps
      (lambda () (dk-have! (list 'IN y 'CC) (lambda () (lx-only-prop! iff (list 'IN y (lx-pz z))))))
      (lambda () (dk-have! (list 'NOT (list '= y z)) (lambda () (lx-only-prop! iff (list 'IN y (lx-pz z))))))
      (lambda () (lx-sub-nz! y z)))))
(define (lx-pz-in! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (dk-have! (list 'IN y (lx-pz z))
      (lambda () (lx-only-prop! iff (list 'IN y 'CC) (list 'NOT (list '= y z)))))))
;;; the punctured plane: open (both spellings), a set
(define (lx-pz-setup! z)
  (let* ((d (lx-pz z)))
    (fact 'nf-cc-is-metric-space)
    (dk-cite! 'cc-punctured-open z)
    (let* ((iff (dk-cite! 'cc-ms-open-iff d)))
      (dk-have! (list 'IS-OPEN lx-nfm d) (lambda () (lx-only-prop! iff (list 'IS-OPEN 'CC-MS d)))))
    (fact 'cc-is-set)
    (dk-cite! 'difference-set 'CC (list 'SINGLETON z))
    (dk-cite! 'cc-open-subset-cc d)))
;;; (lx-lam-typ! LAM DOM TYPER) -- LAM in FUN(DOM, CC); TYPER of the eigenvariable
(define (lx-lam-typ! lam dom pre)
  (dk-have! (list 'IN lam (list 'FUN dom 'CC))
    (lambda ()
      (dk-lam-type! (lambda ()
                      (let* ((v (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                        (lx-steps
                          (lambda () (pre v))
                          (lambda () (if (dk--redex? (dk-goal)) (dk-lam-b!)))
                          (lambda () (if (not (dk-asm? (dk-goal))) (lx-cc! (cadr (dk-goal)))))
                          (lambda () (ass)))))))))
;;; detach an implication whose antecedent THUNK proves
(define (lx-detach! imp thunk)
  (if (and (pair? imp) (eq? (car imp) 'IMPLIES))
      (begin (dk-have! (cadr imp) thunk)
             (dk-landed-1 (lambda () (detach! imp))))
      imp))
(define (lx-only-prop! . fs) (if (apply dk-only! fs) (prop)))
(define (lx-lam-b-if!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
;;; subst, then ass on the SAME leaf unless the subst closed it
(define (lx-subst-ass! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; 2 pi i: in CC and non-zero, its reciprocal in CC
(define lx-tpi '(* (* 2 PI) +i))
(define (lx-tpi!)
  (lx-rr! '(* 2 PI))
  (dk-have! '(< 0 (* 2 PI)) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'rr-pos-ne-zero '(* 2 PI))
  (lx-cc! '(* 2 PI))
  (fact 'cc-i-in)
  (dk-have! '(NOT (= +i 0))
    (lambda ()
      (di)
      (fact 'cc-i-squared)
      (dk-have! '(= (* 0 0) -1) (lambda () (subst '(= 0 +i)) (ass)))
      (dk-have! '(NOT (= (* 0 0) -1)) (lambda () (arith)))
      (ai '(NOT (= (* 0 0) -1)))))
  (dk-cite! 'cc-mul-nonzero '(* 2 PI) +i)
  (lx-cc! lx-tpi)
  (lx-cc! (list 'recip lx-tpi))
  (lx-and! (list 'IN lx-tpi 'CC) (list 'NOT (list '= lx-tpi 0)))
  (dk-cite! 'cc-recip-inverse lx-tpi))
;;; x in CC, c in CC, s in RR, |x - c| < s in context: land x in BALL(CC-MS, c, s)
(define (lx-in-ball! x c s)
  (let* ((m (list 'magnitude (list '- x c))))
    (fact 'cc-is-metric-space)
    (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
    (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (dk-have! (list 'IN c '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (lx-rr! m)
    (dk-cite! 'cc-ms-dist c x)
    (dk-cite! 'cc-magnitude-sub-sym c x)
    (dk-have! (list '<= (list '(DIST CC-MS) c x) m)
      (lambda ()
        (subst (list '= (list '(DIST CC-MS) c x) (list 'magnitude (list '- c x))))
        (if (not (equal? c x)) (subst (list '= (list 'magnitude (list '- c x)) m)))
        (dk-ineq!)))
    (let* ((cj (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list 'IN m 'RR) (list 'AND (list 'IN s 'RR)
                (list 'AND (list '<= (list '(DIST CC-MS) c x) m) (list '< m s)))))))
      (dk-have! cj (lambda () (dk-conj-close! dk-ass!)))
      (dk-cite! 'ball-mem-from-le 'CC-MS c x m s))))
;;; subst EQ in a == goal, then qrfl on the same leaf unless the subst closed it
(define (lx-subst-qrfl! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (qrfl))))
;;; x in BALL(CC-MS, c, r) in context: land x in CC and |x - c| < r; return the latter
(define (lx-ball-open! c r x)
  ;; x in BALL(CC-MS, c, r) in context: land x in CC and |x - c| < r (stops early when a
  ;; landing closes the focus leaf, the claim being the goal)
  (let* ((dcx (list '(DIST CC-MS) c x))
         (mag (list 'magnitude (list '- c x)))
         (mag2 (list 'magnitude (list '- x c)))
         (cj  (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list '<= dcx r) (list 'NOT (list '= dcx r))))))
    (lx-steps
      (lambda () (fact 'cc-is-metric-space))
      (lambda () (let* ((iff (dk-cite! 'ball-membership 'CC-MS c r x)))
                   (dk-have! cj (lambda () (lx-only-prop! iff (list 'IN x (list 'BALL 'CC-MS c r)))))))
      (lambda () (dk-split-all! (list (dk-ctx-form cj))))
      (lambda () (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl))))
      (lambda () (dk-have! (list 'IN x 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass))))
      (lambda () (dk-cite! 'cc-ms-dist c x))
      (lambda () (lx-rr! mag))
      (lambda () (lx-rr! mag2))
      (lambda () (dk-cite! 'cc-magnitude-sub-sym c x))
      (lambda () (dk-have! (list 'AND (list '<= mag r) (list 'NOT (list '= mag r)))
                   (lambda () (subst (list '= mag dcx)) (dk-conj-close! dk-ass!))))
      (lambda () (dk-cite! 'rr-le-ne-lt mag r))
      (lambda () (dk-have! (list '< mag2 r) (lambda () (dk-ineq! (list '< mag r) (list '= mag mag2))))))))

(define (lx-subst-sym e from to)
  (cond ((eq? e from) to)
        ((pair? e) (cons (lx-subst-sym (car e) from to) (lx-subst-sym (cdr e) from to)))
        (#t e)))
;;; a point x of the trace, the trace already known inside CC \ {c} (and CC \ {z} ...):
;;; land x in CC, x /= c, x - c /= 0 (the same for each z in ZS)
(define (lx-tpt! x . zs)
  (lx-steps
    (lambda () (fact 'subset-mem-fwd lx-T (lx-pz 'c) x))
    (lambda () (lx-pz-open! 'c x))
    (lambda () (for-each (lambda (z) (fact 'subset-mem-fwd lx-T (lx-pz z) x) (lx-pz-open! z x)) zs))))
(define (lx-dump-open!)
  (for-each (lambda (l) (display "\n;; OPEN: ") (display (expression->string (dk-goal-of l)))) (dk-open-leaves)))
(define (lx-center-in-ball! a r)
  ;; a in CC, r in RR, 0 < r: land a in BALL(CC-MS, a, r) (which also certifies the ball DEFINED)
  (let* ((d (list '- a a)) (m (list 'magnitude d)))
    (lx-rr! m)
    (lx-cc! d)
    (dk-have! (list '= d 0) (lambda () (crs)))
    (let ((iff (dk-cite! 'cc-magnitude-zero-iff d)))
      (dk-have! (list '= m 0) (lambda () (lx-only-prop! iff (list '= d 0)))))
    (dk-have! (list '< m r) (lambda () (dk-ineq! (list '= m 0) (list '< 0 r))))
    (lx-in-ball! a a r)))
;;; (1) an open set minus a point is open
(define lx-tp '(* 2 PI))
(define lx-I (list 'CCINT 0 lx-tp))
(define lx-C '(CIRCLE-PATH c r))
(define lx-Cd '(CIRCLE-DERIV c r))
(define lx-T (list 'TRACE lx-C 0 lx-tp))
(define (lx-kern z) (list 'VNB-LAMBDA 'wnw_ (lx-pz z) (list 'recip (list '- 'wnw_ z))))
(define (lx-in-I! v)
  (dk-have! (list 'IN v lx-I)
    (lambda () (mac 'ccint-membership)
               (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 0 lx-tp) '(< 0 PI))))))))
(define (lx-circle-basics!)
  (fact 'rr-zero-in)
  (lx-rr! lx-tp)
  (dk-have! (list '< 0 lx-tp) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'circle-is-road 'c 'r)
  (fact 'is-road-is-path lx-C lx-Cd 0 lx-tp)
  (fact 'is-path-in-fun lx-C 0 lx-tp)
  (dk-cite! 'trace-subset-cc lx-C 0 lx-tp))

(define (lx-circ-pt! y)
  ;; y in the trace of the circle (c, r in context, 0 < r): y in CC, |y - c| = r,
  ;; r <= |y - c|, y /= c, y - c /= 0, y in CC \ {c}
  (let* ((m (list 'magnitude (list '- y 'c))))
    (lx-steps
      (lambda () (fact 'subset-mem-fwd lx-T 'CC y))
      (lambda () (dk-cite! 'circle-trace-magnitude 'c 'r y))
      (lambda () (lx-rr! m))
      (lambda () (dk-have! (list '<= 'r m) (lambda () (dk-ineq! (list '= m 'r)))))
      (lambda ()
        (dk-have! (list 'NOT (list '= y 'c))
          (lambda ()
            (di)
            (dk-have! (list '= m 0)
              (lambda () (subst (list '= y 'c))
                         (dk-have! '(= (- c c) 0) (lambda () (crs)))
                         (subst '(= (- c c) 0))
                         (fact 'cc-magnitude-zero)
                         (ass)))
            (dk-absurd! (list 'IN m 'RR) '(IN r RR) (list '= m 0) (list '= m 'r) '(< 0 r)))))
      (lambda () (lx-sub-nz! y 'c))
      (lambda () (lx-pz-in! 'c y)))))
(define (lx-LI f) (list 'LINE-INT f lx-C lx-Cd 0 lx-tp))
;;; the trace lies in CC \ {p} (p = c or z); land it
(define (lx-trace-in-pz! p)
  (dk-have! (list 'SUBSET lx-T (lx-pz p))
    (lambda ()
      (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)))
        (lx-circ-pt! y)
        (if (eq? p 'z) (lx-circ-not-z! y))
        (if (not (sequent-node-grounded? leaf)) (ass))))))
;;; the winding kernel about p: typed, continuous on CC \ {p}
(define (lx-kern-setup! p)
  (let* ((dd (lx-pz p)) (k (lx-kern p)))
    (dk-cite! 'winding-integrand-holomorphic p)
    (dk-cite! 'holomorphic-on-in-fun dd k)
    (dk-cite! 'holomorphic-on-continuous dd k)
    (dk-cite! 'holomorphic-on-open dd k)
    (dk-cite! 'cc-open-subset-cc dd)))


;; y on the trace, z off the circle (|z - c| /= r): y /= z, y - z /= 0, y in CC \ {z}
(define (lx-circ-not-z! y)
  (lx-steps
    (lambda ()
      (dk-have! (list 'NOT (list '= y 'z))
        (lambda ()
          (di)
          (dk-have! '(= (magnitude (- z c)) r)
            (lambda () (subst (list '= 'z y)) (ass)))
          (ai '(NOT (= (magnitude (- z c)) r))))))
    (lambda () (lx-sub-nz! y 'z))
    (lambda () (lx-pz-in! 'z y))))

;;; (1) one circle: int f(w)/(w - z) = int q + f(z) int 1/(w - z), for a factor q of f at z continuous on u
(define lx-fac
  '(FORALL lxx_ (IMPLIES (IN lxx_ u) (= (- (f lxx_) (f z)) (* (lxq_ lxx_) (- lxx_ z))))))
(define (lx-f1 z) (list 'VNB-LAMBDA 'cifw_ lx-T (list '* '(f cifw_) (list 'recip (list '- 'cifw_ z)))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(HOLOMORPHIC-ON u f)
  (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'r (list 'IMPLIES '(IN r RR) (list 'IMPLIES '(< 0 r)
    (list 'IMPLIES (list 'SUBSET lx-T 'u)
      (list 'FORALL 'z (list 'IMPLIES '(IN z u) (list 'IMPLIES '(NOT (= (magnitude (- z c)) r))
        (list 'FORALL 'lxq_ (list 'IMPLIES '(IN lxq_ (FUN u CC)) (list 'IMPLIES (lx-cont 'u 'lxq_) (list 'IMPLIES lx-fac
          (list '= (lx-LI (lx-f1 'z)) (list '+ (lx-LI 'lxq_) (list '* '(f z) (lx-LI (lx-kern 'z)))))))))))))))))))))))
(dk-peel!)
(lx-circle-basics!)
(dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
(dk-cite! 'trace-is-set lx-C 0 lx-tp)
(fact 'subset-refl lx-T)
(fact 'nf-cc-is-metric-space)
(fact 'cc-is-normed-field)
(dk-cite! 'holomorphic-on-in-fun 'u 'f)
(dk-cite! 'holomorphic-on-open 'u 'f)
(dk-cite! 'cc-open-subset-cc 'u)
(fact 'subset-mem-fwd 'u 'CC 'z)
(fact 'fun-apply-type-c 'f 'u 'CC 'z)
(lx-pz-setup! 'z)
(lx-kern-setup! 'z)
(lx-trace-in-pz! 'z)
(lx-pz-setup! 'c)
(lx-trace-in-pz! 'c)
(define (lx-t-pt! x)
  (lx-steps
    (lambda () (lx-tpt! x 'z))
    (lambda () (fact 'subset-mem-fwd lx-T 'u x))
    (lambda () (fact 'fun-apply-type-c 'f 'u 'CC x))
    (lambda () (fact 'fun-apply-type-c 'lxq_ 'u 'CC x))))
;; on the trace, q(w) = (f(w) - f(z)) / (w - z)
(define lx-g2 (list 'VNB-LAMBDA 'cifw_ lx-T '(* (- (f cifw_) (f z)) (recip (- cifw_ z)))))
(lx-lam-typ! lx-g2 lx-T (lambda (v) (lx-t-pt! v)))
(dk-have! (list 'FORALL 'wnx_ (list 'IMPLIES (list 'IN 'wnx_ lx-T) (list '== (list lx-g2 'wnx_) '(lxq_ wnx_))))
  (lambda ()
    (let* ((x (dk-di-var!)) (px (list 'lxq_ x)) (d (list '- x 'z)))
      (lx-t-pt! x)
      (dk-lam-b!)
      (dk-apply! (dk-ctx-form lx-fac) x)
      (subst (list '= (list '- (list 'f x) '(f z)) (list '* px d)))
      (lx-cc! d)
      (lx-and! (list 'IN d 'CC) (list 'NOT (list '= d 0)))
      (dk-cite! 'cc-recip-inverse d)
      (lx-cc! (list 'recip d))
      (let* ((a (dk-name! (list 'recip d) 'CC)))
        (subst (list '= (list 'recip d) a))
        (dk-have! (list '= (list '* d a) 1) (lambda () (subst (list '= a (list 'recip d))) (ass)))
        (dk-have! (list '= (list '* (list '* px d) a) (list '* px (list '* d a))) (lambda () (crs)))
        (subst (list '= (list '* (list '* px d) a) (list '* px (list '* d a))))
        (subst (list '= (list '* d a) 1))
        (dk-have! (list '= (list '* px 1) px) (lambda () (crs)))
        (lx-subst-qrfl! (list '= (list '* px 1) px))))))
(define lx-e1 (dk-cite! 'line-int-domain-congruence 'u 'lxq_ lx-C lx-Cd 0 lx-tp lx-T lx-g2))
;; g2 = f1 + f2', f2' = -f(z) / (w - z)
(define lx-f1z (lx-f1 'z))
(define lx-FT (list 'VNB-LAMBDA 'cifw_ lx-T '(f cifw_)))
(define lx-kt (list 'VNB-LAMBDA 'cifw_ lx-T '(recip (- cifw_ z))))
(define lx-f2 (list 'VNB-LAMBDA 'cifw_ lx-T '(* (- 0 (f z)) (recip (- cifw_ z)))))
(lx-cc! '(- 0 (f z)))
(for-each (lambda (lam) (lx-lam-typ! lam lx-T (lambda (v) (lx-t-pt! v)))) (list lx-f1z lx-FT lx-kt lx-f2))
(dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ lx-T) (list '== (list lx-FT 'aix_) '(f aix_))))
  (lambda () (let* ((x (dk-di-var!))) (lx-t-pt! x) (dk-lam-b!) (if (pair? (dk-open-leaves)) (qrfl)))))
(dk-cite! 'aif-cont-holo-restrict 'u 'f lx-T lx-FT)
(dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ lx-T) (list '== (list lx-kt 'aix_) (list (lx-kern 'z) 'aix_))))
  (lambda () (let* ((x (dk-di-var!))) (lx-t-pt! x) (dk-lam-b!) (if (pair? (dk-open-leaves)) (qrfl)))))
(dk-cite! 'aif-cont-holo-restrict (lx-pz 'z) (lx-kern 'z) lx-T lx-kt)
(dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ lx-T) (list '== (list lx-f1z 'aix_) (list '* (list lx-FT 'aix_) (list lx-kt 'aix_)))))
  (lambda () (let* ((x (dk-di-var!))) (lx-t-pt! x) (dk-lam-b!) (if (pair? (dk-open-leaves)) (qrfl)))))
(dk-cite! 'aif-cont-product lx-T lx-FT lx-kt lx-f1z)
(dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ lx-T) (list '== (list lx-f2 'aix_) (list '* '(- 0 (f z)) (list lx-kt 'aix_)))))
  (lambda () (let* ((x (dk-di-var!))) (lx-t-pt! x) (dk-lam-b!) (if (pair? (dk-open-leaves)) (qrfl)))))
(dk-cite! 'aif-cont-scale lx-T '(- 0 (f z)) lx-kt lx-f2)
(dk-have! (list 'FORALL 'liz_ (list 'IMPLIES (list 'IN 'liz_ lx-T)
            (list '== (list lx-g2 'liz_) (list '+ (list lx-f1z 'liz_) (list lx-f2 'liz_)))))
  (lambda ()
    (let* ((x (dk-di-var!)) (d (list '- x 'z)))
      (lx-t-pt! x)
      (dk-lam-b!)
      (lx-cc! (list 'recip d))
      (let* ((a (dk-name! (list 'recip d) 'CC)))
        (subst (list '= (list 'recip d) a))
        (let* ((eq (list '= (list '* (list '- (list 'f x) '(f z)) a) (list '+ (list '* (list 'f x) a) (list '* '(- 0 (f z)) a)))))
          (dk-have! eq (lambda () (crs)))
          (lx-subst-qrfl! eq))))))
(define lx-e2 (dk-apply! (dk-cite! 'line-int-sum lx-T lx-f1z lx-f2 lx-C lx-Cd 0 lx-tp) lx-g2))
(define lx-e3 (dk-apply! (dk-cite! 'line-int-scalar lx-T lx-kt lx-C lx-Cd 0 lx-tp) '(- 0 (f z)) lx-f2))
(define lx-e4 (dk-cite! 'line-int-domain-congruence (lx-pz 'z) (lx-kern 'z) lx-C lx-Cd 0 lx-tp lx-T lx-kt))
(dk-cite! 'line-int-in-cc lx-T lx-f1z lx-C lx-Cd 0 lx-tp)
(dk-cite! 'line-int-in-cc (lx-pz 'z) (lx-kern 'z) lx-C lx-Cd 0 lx-tp)
;; LI(f1) = LI(g2) + f(z) LI(kern) = LI(q) + f(z) LI(kern)
(let* ((A (lx-LI lx-f1z)) (K (lx-LI (lx-kern 'z))) (G (lx-LI lx-g2)) (Q (lx-LI 'lxq_)))
  (dk-have! (list '= G (list '+ A (list '* '(- 0 (f z)) K)))
    (lambda () (subst lx-e2) (subst lx-e3) (subst lx-e4) (if (pair? (dk-open-leaves)) (rfl))))
  (subst (list '= Q G))
  (subst (list '= G (list '+ A (list '* '(- 0 (f z)) K))))
  (crs))
(qed 'laurent-circle-split)

;;; (2) a removable point: CH3-A's holomorphic-removable-point (ch3a-schwarz.scm) is cited; the copy that stood
;;; here (laurent-removable-point, the same statement and proof) was removed on 2026-10-29.

;;; helpers of (3) and (4)
(define (lx-Ci r) (list 'CIRCLE-PATH 'c r))
(define (lx-Cdi r) (list 'CIRCLE-DERIV 'c r))
(define (lx-Ti r) (list 'TRACE (lx-Ci r) 0 lx-tp))
(define (lx-LIi r f) (list 'LINE-INT f (lx-Ci r) (lx-Cdi r) 0 lx-tp))
(define (lx-F1i r) (list 'VNB-LAMBDA 'cifw_ (lx-Ti r) '(* (f cifw_) (recip (- cifw_ z)))))
(define lx-band '(FORALL lxb_ (IMPLIES (IN lxb_ CC) (IMPLIES (<= r1 (magnitude (- lxb_ c))) (IMPLIES (<= (magnitude (- lxb_ c)) r2) (IN lxb_ u))))))
(define (lx-trace-in-u! r)
  (dk-cite! 'circle-is-road 'c r)
  (fact 'is-road-is-path (lx-Ci r) (lx-Cdi r) 0 lx-tp)
  (fact 'is-path-in-fun (lx-Ci r) 0 lx-tp)
  (dk-cite! 'trace-subset-cc (lx-Ci r) 0 lx-tp)
  (dk-have! (list 'SUBSET (lx-Ti r) 'u)
    (lambda ()
      (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)) (m (list 'magnitude (list '- y 'c))))
        (fact 'subset-mem-fwd (lx-Ti r) 'CC y)
        (dk-have! (list '<= 0 r) (lambda () (dk-ineq! '(< 0 r1) (list '<= 'r1 r) (list 'IN r 'RR))))
        (dk-cite! 'circle-trace-magnitude 'c r y)
        (lx-rr! m)
        (dk-have! (list '<= 'r1 m) (lambda () (dk-ineq! (list '= m r) (list '<= 'r1 r) (list 'IN r 'RR))))
        (dk-have! (list '<= m 'r2) (lambda () (dk-ineq! (list '= m r) (list '<= r 'r2) (list 'IN r 'RR))))
        (dk-apply! (dk-ctx-form lx-band) y)
        (if (not (sequent-node-grounded? leaf)) (ass))))))
(define (lx-trace-in-pzi! r)
  (dk-have! (list 'SUBSET (lx-Ti r) (lx-pz 'z))
    (lambda ()
      (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)) (m (list 'magnitude (list '- y 'c))))
        (fact 'subset-mem-fwd (lx-Ti r) 'CC y)
        (dk-cite! 'circle-trace-magnitude 'c r y)
        (lx-steps
          (lambda ()
            (dk-have! (list 'NOT (list '= y 'z))
              (lambda ()
                (di)
                (dk-have! (list '= '(magnitude (- z c)) r) (lambda () (subst (list '= 'z y)) (ass)))
                (ai (list 'NOT (list '= '(magnitude (- z c)) r))))))
          (lambda () (lx-pz-in! 'z y)))))))
(define (lx-W r) (list 'WINDING (lx-Ci r) (lx-Cdi r) 0 lx-tp 'z))
(define (lx-K r) (lx-LIi r (lx-kern 'z)))
(define (lx-li-from-w! r wv)
  (let* ((wn (lx-W r)) (lk (lx-K r)))
    (dk-cite! 'line-int-in-cc (lx-pz 'z) (lx-kern 'z) (lx-Ci r) (lx-Cdi r) 0 lx-tp)
    (dk-have! (list '= lk (list '* lx-tpi wv))
      (lambda ()
        (dk-have! (list '== wn (list '* (list 'recip lx-tpi) lk)) (lambda () (mac 'WINDING) (qrfl)))
        (dk-have! (list '= (list '* (list 'recip lx-tpi) lk) wv)
          (lambda () (subst (list '== (list '* (list 'recip lx-tpi) lk) wn)) (ass)))
        (let* ((a (dk-name! (list 'recip lx-tpi) 'CC)) (lv (dk-name! lk 'CC)))
          (subst (list '= lk lv))
          (dk-have! (list '= (list '* a lv) wv)
            (lambda () (subst (list '= a (list 'recip lx-tpi))) (subst (list '= lv lk)) (ass)))
          (dk-have! (list '= (list '* lx-tpi a) 1)
            (lambda () (subst (list '= a (list 'recip lx-tpi))) (ass)))
          (dk-have! (list '= lv (list '* (list '* lx-tpi a) lv)) (lambda () (subst (list '= (list '* lx-tpi a) 1)) (crs)))
          (subst (list '= lv (list '* (list '* lx-tpi a) lv)))
          (dk-have! (list '= (list '* (list '* lx-tpi a) lv) (list '* lx-tpi (list '* a lv))) (lambda () (crs)))
          (subst (list '= (list '* (list '* lx-tpi a) lv) (list '* lx-tpi (list '* a lv))))
          (subst (list '= (list '* a lv) wv))
          (if (pair? (dk-open-leaves)) (crs)))))))
(define lx-rz '(magnitude (- z c)))

;;; (3) THE NOTES' (110) STEP: 2 pi i f(z) = int_{C2} f(w)/(w - z) - int_{C1} f(w)/(w - z)
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'FORALL 'c (list 'IMPLIES '(IN c CC)
  (list 'FORALL 'r1 (list 'IMPLIES '(IN r1 RR) (list 'FORALL 'r2 (list 'IMPLIES '(IN r2 RR)
    (lx-imps (list (list 'IS-OPEN lx-nfm 'u) '(HOLOMORPHIC-ON u f) '(< 0 r1) '(< r1 r2) lx-band)
      (list 'FORALL 'z (lx-imps (list '(IN z CC) '(< r1 (magnitude (- z c))) '(< (magnitude (- z c)) r2))
        (list '= (list '* lx-tpi '(f z)) (list '- (lx-LIi 'r2 (lx-F1i 'r2)) (lx-LIi 'r1 (lx-F1i 'r1)))))))))))))))))
(dk-peel!)
(fact 'rr-zero-in)
(lx-rr! lx-tp)
(dk-have! (list '< 0 lx-tp) (lambda () (dk-ineq! '(< 0 PI))))
(dk-have! '(< 0 r2) (lambda () (dk-ineq! '(< 0 r1) '(< r1 r2))))
(dk-cite! 'holomorphic-on-in-fun 'u 'f)
(dk-cite! 'holomorphic-on-open 'u 'f)
(dk-cite! 'cc-open-subset-cc 'u)
(lx-rr! '(magnitude (- z c)))
;; z in u
(dk-have! '(IN z u)
  (lambda () (dk-have! '(<= r1 (magnitude (- z c))) (lambda () (dk-ineq! '(< r1 (magnitude (- z c))))))
             (dk-have! '(<= (magnitude (- z c)) r2) (lambda () (dk-ineq! '(< (magnitude (- z c)) r2))))
             (dk-apply! (dk-ctx-form lx-band) 'z)
             (if (pair? (dk-open-leaves)) (ass))))
(fact 'fun-apply-type-c 'f 'u 'CC 'z)
;; the traces lie in u
(dk-have! '(<= r1 r1) (lambda () (dk-ineq! '(IN r1 RR))))
(dk-have! '(<= r2 r2) (lambda () (dk-ineq! '(IN r2 RR))))
(dk-have! '(<= r1 r2) (lambda () (dk-ineq! '(< r1 r2))))
(lx-trace-in-u! 'r1)
(lx-trace-in-u! 'r2)
;; the factor q of f at z: continuous on u, holomorphic off z, hence on u
(define lx-q (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-difference-quotient 'u 'f) 'z)))
(dk-split-all!)
(dk-cite! 'holomorphic-removable-point 'u lx-q 'z)
;; the two circles
(dk-have! '(NOT (= (magnitude (- z c)) r1))
  (lambda () (di) (dk-absurd! '(IN r1 RR) '(IN (magnitude (- z c)) RR) '(< r1 (magnitude (- z c))) '(= (magnitude (- z c)) r1))))
(dk-have! '(NOT (= (magnitude (- z c)) r2))
  (lambda () (di) (dk-absurd! '(IN r2 RR) '(IN (magnitude (- z c)) RR) '(< (magnitude (- z c)) r2) '(= (magnitude (- z c)) r2))))
(define lx-s1 (dk-cite! 'laurent-circle-split 'u 'f 'c 'r1 'z lx-q))
(define lx-s2 (dk-cite! 'laurent-circle-split 'u 'f 'c 'r2 'z lx-q))
;; the winding numbers: 1 about z for the outer circle, 0 for the inner one
(lx-tpi!)
(lx-pz-setup! 'z)
(lx-kern-setup! 'z)
(dk-have! '(<= 0 r1) (lambda () (dk-ineq! '(< 0 r1))))
(dk-have! '(<= 0 r2) (lambda () (dk-ineq! '(< 0 r2))))
(lx-trace-in-pzi! 'r1)
(lx-trace-in-pzi! 'r2)
;; from WINDING = w, land LI(kern) = 2 pi i w
(dk-cite! 'winding-circle-inside 'c 'r2 'z)
(fact 'cc-one-in)
(lx-li-from-w! 'r2 1)
;; outside the inner circle: the trace lies in the ball of radius |z - c|, z does not
(dk-have! (list '< 0 lx-rz) (lambda () (dk-ineq! '(< 0 r1) (list '< 'r1 lx-rz))))
(dk-cite! 'circle-path-closed 'c 'r1)
(dk-have! (list 'SUBSET (lx-Ti 'r1) (list 'BALL 'CC-MS 'c lx-rz))
  (lambda ()
    (let* ((y (subset-by-element!)) (leaf (proof-state-focus *ps*)) (m (list 'magnitude (list '- y 'c))))
      (fact 'subset-mem-fwd (lx-Ti 'r1) 'CC y)
      (dk-have! '(<= 0 r1) (lambda () (dk-ineq! '(< 0 r1))))
      (dk-cite! 'circle-trace-magnitude 'c 'r1 y)
      (lx-rr! m)
      (dk-have! (list '< m lx-rz) (lambda () (dk-ineq! (list '= m 'r1) (list '< 'r1 lx-rz) (list 'IN lx-rz 'RR))))
      (lx-in-ball! y 'c lx-rz)
      (if (not (sequent-node-grounded? leaf)) (ass)))))
(dk-have! (list 'NOT (list 'IN 'z (list 'BALL 'CC-MS 'c lx-rz)))
  (lambda ()
    (di)
    (lx-ball-open! 'c lx-rz 'z)
    (dk-absurd! (list 'IN lx-rz 'RR) (list '< lx-rz lx-rz))))
(dk-cite! 'circle-is-road 'c 'r1)
(dk-cite! 'winding-zero-outside-disc (lx-Ci 'r1) (lx-Cdi 'r1) 0 lx-tp 'c lx-rz 'z)
(lx-li-from-w! 'r1 0)
;; Cauchy on the annulus for q, and the bookkeeping
(let* ((A1 (lx-LIi 'r1 (lx-F1i 'r1))) (A2 (lx-LIi 'r2 (lx-F1i 'r2)))
       (Q1 (lx-LIi 'r1 lx-q)) (Q2 (lx-LIi 'r2 lx-q)) (K1 (lx-K 'r1)) (K2 (lx-K 'r2)))
  (dk-cite! 'annulus-cauchy 'u lx-q 'c 'r1 'r2)
  (subst (list '= A2 (list '+ Q2 (list '* '(f z) K2))))
  (subst (list '= A1 (list '+ Q1 (list '* '(f z) K1))))
  (subst (list '= K2 (list '* lx-tpi 1)))
  (subst (list '= K1 (list '* lx-tpi 0)))
  (subst (list '= Q1 Q2))
  (dk-cite! 'line-int-in-cc 'u lx-q (lx-Ci 'r2) (lx-Cdi 'r2) 0 lx-tp)
  (crs))
(qed 'laurent-cauchy-difference)


;;; (4) PROPOSITION 4.5: the two series.  For r1 < |z - c| < r2:
;;;   sum_k [int_{C2} f(w) (1/(w - c))^(k+1) dw] (z - c)^k          converges to  int_{C2} f(w)/(w - z) dw,
;;;   sum_k [int_{C1} f(w) (w - c)^k dw] (1/(z - c))^(k+1)            converges to  int_{C1} f(w)/(z - w) dw,
;;; and 2 pi i f(z) is the sum of the two limits.
(define (lx-PS r) (list 'VNB-LAMBDA 'lxk_ 'NN
  (list '* (lx-LIi r (list 'VNB-LAMBDA 'cifw_ (lx-Ti r) '(* (f cifw_) (power (recip (- cifw_ c)) (succ lxk_)))))
           '(power (- z c) lxk_))))
(define (lx-NS r) (list 'VNB-LAMBDA 'lxk_ 'NN
  (list '* (lx-LIi r (list 'VNB-LAMBDA 'cifw_ (lx-Ti r) '(* (f cifw_) (power (- cifw_ c) lxk_))))
           '(power (recip (- z c)) (succ lxk_)))))
(define (lx-G1i r) (list 'VNB-LAMBDA 'cifw_ (lx-Ti r) '(* (f cifw_) (recip (- z cifw_)))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'FORALL 'c (list 'IMPLIES '(IN c CC)
  (list 'FORALL 'r1 (list 'IMPLIES '(IN r1 RR) (list 'FORALL 'r2 (list 'IMPLIES '(IN r2 RR)
    (lx-imps (list (list 'IS-OPEN lx-nfm 'u) '(HOLOMORPHIC-ON u f) '(< 0 r1) '(< r1 r2) lx-band)
      (list 'FORALL 'z (lx-imps (list '(IN z CC) '(< r1 (magnitude (- z c))) '(< (magnitude (- z c)) r2))
        (list 'AND (list 'CC-SERIES-CONVERGES-TO (lx-PS 'r2) (lx-LIi 'r2 (lx-F1i 'r2)))
          (list 'AND (list 'CC-SERIES-CONVERGES-TO (lx-NS 'r1) (lx-LIi 'r1 (lx-G1i 'r1)))
            (list '= (list '* lx-tpi '(f z)) (list '+ (lx-LIi 'r2 (lx-F1i 'r2)) (lx-LIi 'r1 (lx-G1i 'r1)))))))))))))))))))
(dk-peel!)
(fact 'rr-zero-in) (fact 'cc-zero-in) (fact 'cc-one-in)
(lx-rr! lx-tp)
(dk-have! (list '< 0 lx-tp) (lambda () (dk-ineq! '(< 0 PI))))
(dk-have! '(< 0 r2) (lambda () (dk-ineq! '(< 0 r1) '(< r1 r2))))
(dk-have! '(<= 0 r1) (lambda () (dk-ineq! '(< 0 r1))))
(dk-have! '(<= 0 r2) (lambda () (dk-ineq! '(< 0 r2))))
(dk-have! '(<= r1 r1) (lambda () (dk-ineq! '(IN r1 RR))))
(dk-have! '(<= r2 r2) (lambda () (dk-ineq! '(IN r2 RR))))
(dk-have! '(<= r1 r2) (lambda () (dk-ineq! '(< r1 r2))))
(dk-cite! 'holomorphic-on-in-fun 'u 'f)
(dk-cite! 'holomorphic-on-open 'u 'f)
(dk-cite! 'cc-open-subset-cc 'u)
(lx-rr! '(magnitude (- z c)))
(lx-cc! '(- z c))
(lx-trace-in-u! 'r1)
(lx-trace-in-u! 'r2)
(lx-tpi!)
(dk-have! '(NOT (= (magnitude (- z c)) r1))
  (lambda () (di) (dk-absurd! '(IN r1 RR) '(IN (magnitude (- z c)) RR) '(< r1 (magnitude (- z c))) '(= (magnitude (- z c)) r1))))
(dk-have! '(NOT (= (magnitude (- z c)) r2))
  (lambda () (di) (dk-absurd! '(IN r2 RR) '(IN (magnitude (- z c)) RR) '(< (magnitude (- z c)) r2) '(= (magnitude (- z c)) r2))))
;; a point of the circle of radius r: typed, f(v) complex, v - c, v - z, z - v nonzero
(define (lx-cpt! r v)
  (let ((m (list 'magnitude (list '- v 'c))))
    (lx-steps
      (lambda () (fact 'subset-mem-fwd (lx-Ti r) 'CC v))
      (lambda () (fact 'subset-mem-fwd (lx-Ti r) 'u v))
      (lambda () (fact 'fun-apply-type-c 'f 'u 'CC v))
      (lambda () (dk-cite! 'circle-trace-magnitude 'c r v))
      (lambda () (lx-rr! m))
      (lambda () (dk-have! (list 'NOT (list '= v 'c))
                   (lambda () (di)
                     (dk-have! (list '= m 0) (lambda () (subst (list '= v 'c)) (dk-have! '(= (- c c) 0) (lambda () (crs)))
                                                         (subst '(= (- c c) 0)) (fact 'cc-magnitude-zero) (ass)))
                     (dk-absurd! (list 'IN m 'RR) (list 'IN r 'RR) (list '= m 0) (list '= m r) (list '< 0 r)))))
      (lambda () (lx-sub-nz! v 'c))
      (lambda () (dk-have! (list 'NOT (list '= v 'z))
                   (lambda () (di)
                     (dk-have! (list '= '(magnitude (- z c)) r) (lambda () (subst (list '= 'z v)) (ass)))
                     (ai (list 'NOT (list '= '(magnitude (- z c)) r))))))
      (lambda () (lx-sub-nz! v 'z))
      (lambda () (dk-have! (list 'NOT (list '= 'z v)) (lambda () (di) (dk-have! (list '= v 'z) (lambda () (subst (list '= 'z v)) (rfl))) (ai (list 'NOT (list '= v 'z))))))
      (lambda () (lx-sub-nz! 'z v)))))

;; the two series
(define (lx-FT r) (list 'VNB-LAMBDA 'cifw_ (lx-Ti r) '(f cifw_)))
(define (lx-FT! r)
  (let ((FT (lx-FT r)))
    (dk-cite! 'trace-is-set (lx-Ci r) 0 lx-tp)
    (lx-lam-typ! FT (lx-Ti r) (lambda (v) (lx-cpt! r v)))
    (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ (lx-Ti r)) (list '== (list FT 'aix_) '(f aix_))))
      (lambda () (let* ((x (dk-di-var!))) (lx-cpt! r x) (dk-lam-b!) (if (pair? (dk-open-leaves)) (qrfl)))))
    (dk-cite! 'aif-cont-holo-restrict 'u 'f (lx-Ti r) FT)
    (dk-cite! 'trace-is-set (lx-Ci r) 0 lx-tp)
    (fact 'subset-refl (lx-Ti r))
    FT))
(dk-have! '(NOT (= (- z c) 0))
  (lambda () (di)
    (dk-have! '(= (magnitude (- z c)) 0) (lambda () (subst '(= (- z c) 0)) (fact 'cc-magnitude-zero) (ass)))
    (dk-absurd! '(IN r1 RR) '(IN (magnitude (- z c)) RR) '(< 0 r1) '(< r1 (magnitude (- z c))) '(= (magnitude (- z c)) 0))))
(define lx-FT2 (lx-FT! 'r2))
(define lx-FT1 (lx-FT! 'r1))
(dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ (lx-Ti 'r2)) (list '<= 'r2 '(magnitude (- aix_ c)))))
