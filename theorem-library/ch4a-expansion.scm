(dk-have! '(NOT (= (magnitude (- z c)) r2))
  (lambda () (di) (dk-absurd! '(IN r2 RR) '(IN (magnitude (- z c)) RR) '(< (magnitude (- z c)) r2) '(= (magnitude (- z c)) r2))))
(for-each (lambda (r)
            (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ (lx-Ti r)) '(NOT (= aix_ z))))
              (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                           (lx-cpt0! r x)
                           (dk-have! (list 'NOT (list '= x 'z))
                             (lambda () (di)
                               (dk-have! (list '= '(magnitude (- z c)) r) (lambda () (subst (list '= 'z x)) (ass)))
                               (ai (list 'NOT (list '= '(magnitude (- z c)) r)))))
                           (if (not (sequent-node-grounded? leaf)) (ass))))))
          '(r1 r2))
(define (lx-zpt! r x)                ; x on the circle r: also x - z, z - x nonzero
  (lx-cpt0! r x)
  (dk-apply! (dk-ctx-form (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ (lx-Ti r)) '(NOT (= aix_ z))))) x)
  (lx-sub-nz! x 'z)
