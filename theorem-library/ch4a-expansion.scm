(lx-rr! lx-tp)
(dk-have! (list '< 0 lx-tp) (lambda () (dk-ineq! '(< 0 PI))))
(dk-have! '(<= 0 rho) (lambda () (dk-ineq! '(< 0 rho))))
(dk-cite! 'holomorphic-on-in-fun 'u 'f)
(dk-cite! 'holomorphic-on-open 'u 'f)
