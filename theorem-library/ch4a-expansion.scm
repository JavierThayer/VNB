;;; (8) CAUCHY ESTIMATES FOR THE COEFFICIENT INTEGRALS: with M a bound of |f| on the circle |w - c| = s,
;;;   |int f(w) (1/(w - c))^(k+1) dw| <= (2 pi s) M (1/s)^(k+1),   |int f(w) (w - c)^k dw| <= (2 pi s) M s^k.
(define lx-est-concl
  (list 'FORSOME 'lxm_ (list 'AND '(IN lxm_ RR) (list 'AND '(<= 0 lxm_)
    (list 'FORALL 'lxk_ (list 'IMPLIES '(IN lxk_ NN)
      (list 'AND (list '<= (list 'magnitude (lx-LIi 's (lx-Mp 's 'lxk_))) (list '* (list '* lx-tp 's) (list '* 'lxm_ (list 'power '(recip s) '(succ lxk_)))))
                 (list '<= (list 'magnitude (lx-LIi 's (lx-Mn 's 'lxk_))) (list '* (list '* lx-tp 's) (list '* 'lxm_ (list 'power 's 'lxk_)))))))))))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'FORALL 'c (list 'IMPLIES '(IN c CC)
  (list 'FORALL 's (list 'IMPLIES '(IN s RR) (list 'IMPLIES '(< 0 s)
    (lx-imps (list (list 'IS-OPEN lx-nfm 'u) '(HOLOMORPHIC-ON u f) (list 'SUBSET (lx-Ti 's) 'u))
      lx-est-concl))))))))))
