;; a lambda over T(r) built from f and a factor: typed, and continuous as FT(r) times the factor lambda
(define (lx-lam r body-of) (list 'VNB-LAMBDA 'cifw_ (lx-Ti r) (body-of 'cifw_)))
(define (lx-typ! r lam)
  (if (not (dk-asm? (list 'IN (lx-Ti r) 'SET))) (dk-cite! 'trace-is-set (lx-Ci r) 0 lx-tp))
  (if (not (dk-asm? (list 'IN lam (list 'FUN (lx-Ti r) 'CC)))) (lx-lam-typ! lam (lx-Ti r) (lambda (v) (lx-cpt! r v)))))
(define (lx-ptw! r lam rhs-of)
  (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ (lx-Ti r)) (list '== (list lam 'aix_) (rhs-of 'aix_))))
    (lambda () (let* ((x (dk-di-var!))) (lx-cpt! r x) (dk-lam-b!) (if (pair? (dk-open-leaves)) (qrfl))))))
;; the factor lambdas and their continuity
(define (lx-cont-factor! r kind j)
  ;; kind: 'rp  x |-> (1/(x - c))^(succ j);  'pw  x |-> (x - c)^j;  'rz  x |-> 1/(z - x).  Returns the lambda.
  (let* ((T (lx-Ti r)))
    (cond
      ((eq? kind 'rp)
       (let* ((rlam (lx-lam r (lambda (w) (list 'recip (list '- w 'c)))))
              (P (lx-lam r (lambda (w) (list 'power (list 'recip (list '- w 'c)) (list 'succ j))))))
         (fact 'nn-succ-closed j)
         (lx-typ! r rlam) (lx-typ! r P)
         (lx-ptw! r rlam (lambda (x) (list 'recip (list '- x 'c))))
         (dk-cite! 'aif-cont-recip-shift T 'c rlam)
         (lx-ptw! r P (lambda (x) (list 'power (list rlam x) (list 'succ j))))
         (dk-cite! 'aif-cont-power-of T rlam (list 'succ j) P)
         P))
      ((eq? kind 'pw)
       (let* ((L (lx-lam r (lambda (w) (list '- w 'c))))
              (P (lx-lam r (lambda (w) (list 'power (list '- w 'c) j)))))
         (lx-typ! r L) (lx-typ! r P)
         (lx-ptw! r L (lambda (x) (list '- x 'c)))
         (dk-cite! 'aif-cont-shift T 'c L)
         (lx-ptw! r P (lambda (x) (list 'power (list L x) j)))
         (dk-cite! 'aif-cont-power-of T L j P)
         P))
      ((eq? kind 'rw)
       (let* ((rlam (lx-lam r (lambda (w) (list 'recip (list '- w 'z))))))
         (lx-typ! r rlam)
         (lx-ptw! r rlam (lambda (x) (list 'recip (list '- x 'z))))
         (dk-cite! 'aif-cont-recip-shift T 'z rlam)
         rlam))
      (#t
       (let* ((rlam (lx-lam r (lambda (w) (list 'recip (list '- 'z w))))))
         (lx-typ! r rlam)
         (lx-ptw! r rlam (lambda (x) (list 'recip (list '- 'z x))))
         (dk-cite! 'out-cont-recip-rev T 'z rlam)
         rlam)))))
;; M = x |-> f(x) * factor(x): typed, continuous, integral in CC
(define (lx-prod! r factor body-of)
  (let* ((M (lx-lam r body-of)) (T (lx-Ti r)) (FT (lx-FT r)))
    (lx-typ! r M)
    (lx-ptw! r M (lambda (x) (list '* (list FT x) (list factor x))))
    (dk-cite! 'aif-cont-product T FT factor M)
    (dk-cite! 'line-int-in-cc T M (lx-Ci r) (lx-Cdi r) 0 lx-tp)
    M))
;; (= H M) for H the cited lemma's lambda (FT inside) and M the statement's (f inside)
(define (lx-same! r H M)
  (lx-typ! r H)
  (dk-fun-ext! H M (lx-Ti r) 'CC #f #f
    (lambda (v) (lx-cpt! r v) (dk-lam-b!) (if (pair? (dk-open-leaves)) (begin (lx-cc! (cadr (dk-goal))) (rfl)))))
  (list '= H M))
