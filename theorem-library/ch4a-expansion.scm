;; the statement's integrands at j
(define (lx-repl e from to)
  (cond ((eq? e from) to) ((pair? e) (cons (lx-repl (car e) from to) (lx-repl (cdr e) from to))) (#t e)))
(define (lx-H-at S j) (lx-repl (cadr (cadr (cadddr S))) (cadr S) j))   ; S = (VNB-LAMBDA k NN (* (LINE-INT H ..) ..))
;; S (the lemma's series) = S2 (the statement's), termwise: kind 'rp (P side, radius r2) or 'pw (N side, r1)
(define (lx-series-eq! r kind S S2 body-of)
  (let ((prep! (lambda (j)
                 (let* ((P (lx-cont-factor! r kind j))
                        (M (lx-prod! r P (lambda (w) (body-of w j))))
                        (H (lx-H-at S j)))
                   (lx-same! r H M)
                   (if (not (dk-asm? (list 'IN (lx-LIi r H) 'CC)))
                       (dk-have! (list 'IN (lx-LIi r H) 'CC) (lambda () (subst (list '= H M)) (ass))))
                   (list H M)))))
    (dk-fun-ext! S S2 'NN 'CC
      (lambda () (dk-lam-type! (lambda () (let* ((j (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                            (prep! j) (fact 'nn-succ-closed j)
                                            (if (not (sequent-node-grounded? leaf))
                                                (begin (lx-cc! (cadr (dk-goal))) (if (not (sequent-node-grounded? leaf)) (ass))))))))
      (lambda () (dk-lam-type! (lambda () (let* ((j (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                            (prep! j) (fact 'nn-succ-closed j)
                                            (if (not (sequent-node-grounded? leaf))
                                                (begin (lx-cc! (cadr (dk-goal))) (if (not (sequent-node-grounded? leaf)) (ass))))))))
      (lambda (j)
        (let ((hm (prep! j)))
          (fact 'nn-succ-closed j)
          (dk-lam-b!)
          (subst (list '= (car hm) (cadr hm)))
          (if (pair? (dk-open-leaves)) (begin (lx-cc! (cadr (dk-goal))) (rfl))))))
    (list '= S S2)))
