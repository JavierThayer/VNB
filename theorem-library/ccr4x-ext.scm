(define (x4-side!)
  (let ((g (dk-goal)))
    (cond ((dk-asm? g) (ass))
          ((and (dk-head-is? g 'IMPLIES) (dk-head-is? (cadr g) '=) (equal? (caddr (cadr g)) 0))
           (let ((x (cadr (cadr g))))
             (di)
             (if (equal? x 1) (dk-nn-absurd! '(= 1 0)) (dk-nn-absurd! `(<= 1 ,x) `(= ,x 0)))))
          (#t (error "x4-side!: cannot close" (expression->string g))))))
(define (x4-chain! c . opt)
  (let ((pf (if (pair? opt) (car opt) #f)))
    (let loop ((c c))
      (if (not (dk-head-is? c 'IMPLIES)) c
          (begin
            (if (not (dk-asm? (cadr c)))
                (dk-have! (cadr c) (if (and pf (dk-head-is? (cadr c) 'FORALL)) pf x4-side!)))
            (let ((new (dk-landed* (lambda () (detach! c)))))
              (loop (if (pair? new) (car new) (caddr c)))))))))
(define (x4-app! f . ts)
  (let loop ((f f) (ts ts)) (if (null? ts) f (loop (x4-chain! (dk-apply! f (car ts))) (cdr ts)))))
(define (x4-c! . args) (x4-chain! (apply dk-cite! args)))
(define (x4-close-by! thunk)          ; run THUNK; close the leaf it left by `ass' unless it is grounded
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (and (not (sequent-node-grounded? leaf)) (dk-asm? (dk-goal))) (ass))))
(define (x4-one-11!)
  (if (not (dk-asm? '(IN 1 (INTERVAL 1 1))))
      (begin (fact 'nn-one-in) (dk-have! '(<= 1 1) (lambda () (dk-nn!))) (x4-c! 'interval-mem-intro 1 1 1))))
(define (x4-hom-fun! f)
  (let ((c `(IN ,f (FUN (VEC md) (VEC md)))))
    (if (not (dk-asm? c))
        (dk-project! c (lambda () (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! 'is-hom-module-def 'md 'md f)))))))))

;;; -----------------------------------------------------------------------
;;; A. the matrix of an operator in a basis

;; the column (g(h(u_i)))_i is the image of the column (h(u_i))_i under g
(sp (make-wff '(FORALL vs (FORALL hh (FORALL gg (FORALL rh (IMPLIES (IN hh (FUN vs vs)) (IMPLIES (IN gg (FUN vs vs))
  (IMPLIES (IN rh (FUN vs vs)) (IMPLIES (FORALL x4z (IMPLIES (IN x4z vs) (= (rh x4z) (gg (hh x4z)))))
    (FORALL n (IMPLIES (IN n NN) (FORALL u (IMPLIES (IN u (MAT n 1 vs))
      (= (MAP-SEQ rh n u) (MAP-SEQ gg n (MAP-SEQ hh n u)))))))))))))))))
(dk-peel!)
(x4-c! 'map-seq-type 'hh 'vs 'vs 'n 'u)
(x4-c! 'map-seq-type 'gg 'vs 'vs 'n '(MAP-SEQ hh n u))
(x4-c! 'map-seq-type 'rh 'vs 'vs 'n 'u)
(x4-one-11!)
(x4-close-by! (lambda ()
  (x4-chain! (dk-cite! 'matrix-entry-extensionality 'n 1 'vs '(MAP-SEQ rh n u) '(MAP-SEQ gg n (MAP-SEQ hh n u)))
    (lambda ()
      (dk-peel!)
      (let* ((g (dk-goal)) (i (caddr (cadr g))) (j (cadddr (cadr g))))
        (x4-c! 'interval-lo 1 1 j) (x4-c! 'interval-hi 1 1 j) (x4-c! 'interval-elt-in-nn 1 1 j)
        (dk-have! `(= ,j 1) (lambda () (dk-nn! `(<= 1 ,j) `(<= ,j 1))))
        (subst `(= ,j 1))
        (x4-c! 'entry-in-carrier 'n 1 'vs 'u i 1)
        (x4-c! 'entry-in-carrier 'n 1 'vs '(MAP-SEQ hh n u) i 1)
        (subst (x4-c! 'map-seq-entry 'rh 'vs 'vs 'n 'u i))
        (subst (x4-c! 'map-seq-entry 'gg 'vs 'vs 'n '(MAP-SEQ hh n u) i))
        (subst (x4-c! 'map-seq-entry 'hh 'vs 'vs 'n 'u i))
        (x4-close-by! (lambda ()
          (x4-chain! (dk-apply! '(FORALL x4z (IMPLIES (IN x4z vs) (= (rh x4z) (gg (hh x4z))))) `(ENTRY u ,i 1))))))))))
(qed 'map-seq-compose)

;; the column (r(u_i))_i is u when r is the identity on the u_i
(sp (make-wff '(FORALL vs (FORALL rh (IMPLIES (IN rh (FUN vs vs)) (IMPLIES (FORALL x4z (IMPLIES (IN x4z vs) (= (rh x4z) x4z)))
  (FORALL n (IMPLIES (IN n NN) (FORALL u (IMPLIES (IN u (MAT n 1 vs)) (= (MAP-SEQ rh n u) u)))))))))))
(dk-peel!)
(x4-c! 'map-seq-type 'rh 'vs 'vs 'n 'u)
(x4-one-11!)
(x4-close-by! (lambda ()
  (x4-chain! (dk-cite! 'matrix-entry-extensionality 'n 1 'vs '(MAP-SEQ rh n u) 'u)
    (lambda ()
      (dk-peel!)
      (let* ((g (dk-goal)) (i (caddr (cadr g))) (j (cadddr (cadr g))))
        (x4-c! 'interval-lo 1 1 j) (x4-c! 'interval-hi 1 1 j) (x4-c! 'interval-elt-in-nn 1 1 j)
        (dk-have! `(= ,j 1) (lambda () (dk-nn! `(<= 1 ,j) `(<= ,j 1))))
        (subst `(= ,j 1))
        (x4-c! 'entry-in-carrier 'n 1 'vs 'u i 1)
        (subst (x4-c! 'map-seq-entry 'rh 'vs 'vs 'n 'u i))
        (x4-close-by! (lambda ()
          (x4-chain! (dk-apply! '(FORALL x4z (IMPLIES (IN x4z vs) (= (rh x4z) x4z))) `(ENTRY u ,i 1))))))))))
(qed 'map-seq-ident)

(define x4-basis-hyps
  '((IS-MODULE md) (IN n NN) (<= 1 n) (IN u (MAT n 1 (VEC md))) (GENERATES md n u) (REL-FREE md n u)))
(define (x4-curry fs body) (fold-right (lambda (p acc) `(IMPLIES ,p ,acc)) body fs))
(define (x4-basis body) `(FORALL md (FORALL n (FORALL u ,(x4-curry x4-basis-hyps body)))))
(define (x4-om tt) `(OP-MAT md n u ,tt))

;; the matrix of an operator exists and is characterised by T u = OP-MAT(T) u
(sp (make-wff (x4-basis `(FORALL tt (IMPLIES (IN tt (FUN (VEC md) (VEC md)))
  (AND (IN ,(x4-om 'tt) (MAT n n (CARR (SCAL md)))) (= (MAP-SEQ tt n u) (MATACT md ,(x4-om 'tt) u))))))))
(dk-peel!)
(x4-c! 'map-seq-type 'tt '(VEC md) '(VEC md) 'n 'u)
(mac 'OP-MAT)
(let* ((io (cadr (cadr (dk-goal))))
       (ls (dk-opened (lambda () (iota-d io)))))
  (for-each
    (lambda (l)
      (if (not (sequent-node-grounded? l))
          (begin
            (dk-focus! l)
            (if (dk-head-is? (dk-goal) 'FORSOME)
                (let ((cm (dk-skolem! (x4-c! 'generates-coeff-matrix 'md 'n 'n 'u '(MAP-SEQ tt n u)))))
                  (ew cm)
                  (dk-conj-close!
                    (lambda ()
                      (cond ((dk-asm? (dk-goal)) (ass))
                            (#t
                             (dk-peel!)
                             (dk-split-all!)
                             (let ((y (caddr (dk-goal))))
                               (dk-have! `(= (MATACT md ,cm u) (MATACT md ,y u))
                                 (lambda () (subst `(= (MATACT md ,cm u) (MAP-SEQ tt n u))) (ass)))
                               (x4-close-by! (lambda () (x4-c! 'rel-free-matact-cancel 'md 'n 'n 'u cm y)))))))))
                (ass)))))
    ls))
(qed 'op-mat-spec)

;; a matrix a with T u = a u is the matrix of T
(sp (make-wff (x4-basis `(FORALL tt (IMPLIES (IN tt (FUN (VEC md) (VEC md))) (FORALL am (IMPLIES (IN am (MAT n n (CARR (SCAL md))))
  (IMPLIES (= (MAP-SEQ tt n u) (MATACT md am u)) (= ,(x4-om 'tt) am)))))))))
(dk-peel!)
(dk-split-all! (list (x4-c! 'op-mat-spec 'md 'n 'u 'tt)))
(dk-have! `(= (MATACT md ,(x4-om 'tt) u) (MATACT md am u))
  (lambda () (subst `(= (MATACT md ,(x4-om 'tt) u) (MAP-SEQ tt n u))) (ass)))
(x4-close-by! (lambda () (x4-c! 'rel-free-matact-cancel 'md 'n 'n 'u (x4-om 'tt) 'am)))
(qed 'op-mat-unique)

;; the matrix of S o T is OP-MAT(T) OP-MAT(S)
(sp (make-wff (x4-basis `(FORALL tt (FORALL ss (FORALL rr_ (IMPLIES (IS-HOM-MODULE md md tt) (IMPLIES (IS-HOM-MODULE md md ss)
  (IMPLIES (IN rr_ (FUN (VEC md) (VEC md))) (IMPLIES (FORALL x4z (IMPLIES (IN x4z (VEC md)) (= (rr_ x4z) (ss (tt x4z)))))
    (= ,(x4-om 'rr_) (MATMUL (SCAL md) ,(x4-om 'tt) ,(x4-om 'ss)))))))))))))
(dk-peel!)
(x4-hom-fun! 'tt) (x4-hom-fun! 'ss)
(x4-c! 'module-scalar-ring 'md)
(dk-split-all! (list (x4-c! 'op-mat-spec 'md 'n 'u 'tt)))
(dk-split-all! (list (x4-c! 'op-mat-spec 'md 'n 'u 'ss)))
(let* ((at (x4-om 'tt)) (as (x4-om 'ss)) (ats `(MATMUL (SCAL md) ,at ,as)))
  (x4-c! 'matmul-type '(SCAL md) 'n 'n 'n at as)
  (x4-c! 'map-seq-type 'ss '(VEC md) '(VEC md) 'n 'u)
  (let* ((assoc (x4-c! 'matact-assoc 'md 'n 'n 'n 1 at as 'u))
         (hm (x4-c! 'hom-matact 'md 'ss 'n 'n at 'u))
         (cmp (x4-c! 'map-seq-compose '(VEC md) 'tt 'ss 'rr_ 'n 'u)))
    (dk-have! `(= (MAP-SEQ rr_ n u) (MATACT md ,ats u))
      (lambda ()
        (subst assoc)
        (subst `(= (MATACT md ,as u) (MAP-SEQ ss n u)))
        (subst hm)
        (subst `(= (MATACT md ,at u) (MAP-SEQ tt n u)))
        (ass)))
    (x4-close-by! (lambda () (x4-c! 'op-mat-unique 'md 'n 'u 'rr_ ats)))))
(qed 'op-mat-compose)

;; the matrix of the identity is I
(sp (make-wff (x4-basis `(FORALL rr_ (IMPLIES (IN rr_ (FUN (VEC md) (VEC md)))
  (IMPLIES (FORALL x4z (IMPLIES (IN x4z (VEC md)) (= (rr_ x4z) x4z))) (= ,(x4-om 'rr_) (IDENTMAT (SCAL md) n))))))))
(dk-peel!)
(x4-c! 'module-scalar-ring 'md)
(x4-c! 'identmat-type '(SCAL md) 'n)
(let* ((mi (x4-c! 'matact-identmat 'md 'n 1 'u))
       (ms (x4-c! 'map-seq-ident '(VEC md) 'rr_ 'n 'u)))
  (dk-have! `(= (MAP-SEQ rr_ n u) (MATACT md (IDENTMAT (SCAL md) n) u))
    (lambda () (subst mi) (ass)))
  (x4-close-by! (lambda () (x4-c! 'op-mat-unique 'md 'n 'u 'rr_ '(IDENTMAT (SCAL md) n)))))
(qed 'op-mat-id)

;;; -----------------------------------------------------------------------
;;; B. the multiplication matrices of a finite extension

(define x4-V '(NORMED-FIELD-AS-COMMUTATIVE-RING K))
(define (x4-mo xi) `(MULT-OP F ,xi))
(define (x4-mm xi) `(MULT-MAT md n u F ,xi))
(define (x4-en xi) `(EXT-NORM K F md n u ,xi))
(define (x4-ea xi) `(EXT-ABS K F md n u ,xi))
(define (x4-fm a b) `((MUL F) ,a ,b))
(define (x4-ext body) `(FORALL K (FORALL F (FORALL md (FORALL n (FORALL u (IMPLIES (IS-FIN-EXT K F md n u) ,body)))))))

;; the multiplication operator is a function on F, with the obvious values
(sp (make-wff '(FORALL F (IMPLIES (IS-RING F) (FORALL xi (IMPLIES (IN xi (CARR F)) (IN (MULT-OP F xi) (FUN (CARR F) (CARR F)))))))))
(dk-peel!)
(x4-c! 'ring-carr-in-set 'F)
(mac 'MULT-OP)
(dk-lam-type!
  (lambda ()
    (let ((p (dk-di-var!)))
      (x4-close-by! (lambda () (x4-c! 'ring-carrier-closed-mul 'F 'xi p)))))
  (lambda () (ass)))
(qed 'mult-op-type)

(sp (make-wff '(FORALL F (IMPLIES (IS-RING F) (FORALL xi (IMPLIES (IN xi (CARR F)) (FORALL x4w (IMPLIES (IN x4w (CARR F))
  (= ((MULT-OP F xi) x4w) ((MUL F) xi x4w))))))))))
(dk-peel!)
(x4-c! 'ring-carrier-closed-mul 'F 'xi 'x4w)
(mac 'MULT-OP)
(dk-lam-b!)
(if (pair? (dk-open-leaves)) (rfl))
(qed 'mult-op-value)

;; open IS-FIN-EXT and land the standing facts
(define (x4-ext-open!)
  (if (not (dk-asm? '(IS-MODULE md)))
      (begin
        (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! 'is-fin-ext 'K 'F 'md 'n 'u))))
        (dk-split-all! (list (dk-meta-iff-r! (dk-meta-iff! 'is-field-ring-def 'F))))
        (x4-c! 'commutative-ring-is-ring 'F)
        (x4-c! 'module-scalar-ring 'md)
        (x4-c! 'normed-field-as-commutative-ring-is-commutative-ring 'K)
        (x4-c! 'commutative-ring-is-ring x4-V)
        (for-each (lambda (r) (dk-cite! r 'K))
                  '(normed-field-ring-view-carr normed-field-ring-view-add normed-field-ring-view-mul
                    normed-field-ring-view-neg normed-field-ring-view-zero normed-field-ring-view-one))
        (dk-rewrite-h! '(IN u (MAT n 1 (CARR F))) '(CARR F) '(VEC md))
        (x4-c! 'ring-one-in 'F) (x4-c! 'ring-zero-in 'F))))
(define (x4-inf! x)                     ; x in VEC md  ->  x in CARR F
  (if (not (dk-asm? `(IN ,x (CARR F)))) (dk-rewrite-h! `(IN ,x (VEC md)) '(VEC md) '(CARR F))))
(define (x4-mul-t! a b)
  (if (not (dk-asm? `(IN ,(x4-fm a b) (CARR F)))) (x4-c! 'ring-carrier-closed-mul 'F a b)))
(define (x4-val! xi x)                  ; rewrite (MULT-OP F xi)(x) to xi x in the goal
  (subst (x4-c! 'mult-op-value 'F xi x)))
(define (x4-mo-t! xi)
  (if (not (dk-asm? `(IN ,(x4-mo xi) (FUN (VEC md) (VEC md)))))
      (begin
        (x4-c! 'mult-op-type 'F xi)
        (dk-rewrite-h! `(IN ,(x4-mo xi) (FUN (CARR F) (CARR F))) '(CARR F) '(VEC md)))))

;; multiplication by xi is K-linear
(sp (make-wff (x4-ext '(FORALL xi (IMPLIES (IN xi (CARR F)) (IS-HOM-MODULE md md (MULT-OP F xi)))))))
(dk-peel!)
(x4-ext-open!)
(x4-mo-t! 'xi)
(let ((alg (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'ACT) (dk-contains? h '(MUL F)))) "the algebra law")))
  (mac 'is-hom-module-def)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond
          ((dk-asm? g) (ass))
          ((dk-head-is? g '=)
           (if (equal? (cadr g) (caddr g)) (rfl)
               (begin                   ; f(0) = 0
                 (subst '(= (VZERO md) (ZERO F)))
                 (x4-val! 'xi '(ZERO F))
                 (crs))))
          (#t
           (let* ((landed (dk-landed (lambda () (dk-peel!))))
                  (vs (map cadr (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) '(VEC md)))) landed)))
                  (cs (map cadr (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) '(CARR (SCAL md))))) landed))))
             (for-each x4-inf! vs)
             (cond
               ((pair? cs)                ; f(c x) = c f(x)
                (let ((c (car cs)) (x (car vs)))
                  (dk-rewrite-h! `(IN ,c (CARR (SCAL md))) '(SCAL md) x4-V)
                  (dk-rewrite-h! `(IN ,c (CARR ,x4-V)) `(CARR ,x4-V) '(CARR K))
                  (x4-c! 'module-act-type 'md c x)
                  (x4-inf! `((ACT md) ,c ,x))
                  (x4-mul-t! 'xi x)
                  (x4-val! 'xi `((ACT md) ,c ,x))
                  (x4-val! 'xi x)
                  (x4-close-by! (lambda () (x4-app! alg c 'xi x)))))
               ((dk-contains? g 'VADD)
                (let ((x (car vs)) (y (cadr vs)))
                  (subst '(= (VADD md) (ADD F)))
                  (x4-c! 'ring-add-closed 'F x y)
                  (x4-val! 'xi `((ADD F) ,x ,y)) (x4-val! 'xi x) (x4-val! 'xi y)
                  (crs)))
               (#t                        ; f(-x) = -f(x)
                (let ((x (car vs)))
                  (subst '(= (VNEG md) (NEG F)))
                  (x4-c! 'ring-neg-in-carr 'F x)
                  (x4-val! 'xi `((NEG F) ,x)) (x4-val! 'xi x)
                  (crs)))))))))))
(qed 'ext-mult-op-hom)

;; M(xi) is an n-by-n matrix over K with xi u = M(xi) u
(sp (make-wff (x4-ext `(FORALL xi (IMPLIES (IN xi (CARR F))
  (AND (IN ,(x4-mm 'xi) (MAT n n (CARR K))) (= (MAP-SEQ (MULT-OP F xi) n u) (MATACT md ,(x4-mm 'xi) u))))))))
(dk-peel!)
(x4-ext-open!)
(x4-mo-t! 'xi)
(dk-split-all! (list (x4-c! 'op-mat-spec 'md 'n 'u (x4-mo 'xi))))
(mac 'MULT-MAT)
(let* ((om (x4-om (x4-mo 'xi))) (h1 `(IN ,om (MAT n n (CARR (SCAL md))))))
  (dk-rewrite-h! (dk-rewrite-h! h1 '(SCAL md) x4-V) `(CARR ,x4-V) '(CARR K))
  (dk-conj-close! (lambda () (ass))))
(qed 'ext-mult-mat-spec)

(define (x4-mm! xi)                     ; land M(xi) typed over K and over the view
  (if (not (dk-asm? `(IN ,(x4-mm xi) (MAT n n (CARR K)))))
      (begin
        (dk-split-all! (list (x4-c! 'ext-mult-mat-spec 'K 'F 'md 'n 'u xi)))
        (dk-rewrite-h! `(IN ,(x4-mm xi) (MAT n n (CARR K))) '(CARR K) `(CARR ,x4-V)))))

;; M(xi eta) = M(eta) M(xi)
(sp (make-wff (x4-ext `(FORALL xi (IMPLIES (IN xi (CARR F)) (FORALL eta (IMPLIES (IN eta (CARR F))
  (= ,(x4-mm (x4-fm 'xi 'eta)) (MATMUL ,x4-V ,(x4-mm 'eta) ,(x4-mm 'xi))))))))))
(dk-peel!)
(x4-ext-open!)
(x4-mul-t! 'xi 'eta)
(x4-mo-t! 'xi) (x4-mo-t! 'eta) (x4-mo-t! (x4-fm 'xi 'eta))
(x4-c! 'ext-mult-op-hom 'K 'F 'md 'n 'u 'xi)
(x4-c! 'ext-mult-op-hom 'K 'F 'md 'n 'u 'eta)
(dk-have! `(FORALL x4z (IMPLIES (IN x4z (VEC md)) (= (,(x4-mo (x4-fm 'xi 'eta)) x4z) (,(x4-mo 'xi) (,(x4-mo 'eta) x4z)))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (x4-inf! z)
      (x4-mul-t! 'eta z)
      (x4-val! 'eta z)
      (x4-val! 'xi (x4-fm 'eta z))
      (x4-val! (x4-fm 'xi 'eta) z)
      (crs))))
(mac 'MULT-MAT)
(subst `(= ,x4-V (SCAL md)))
(x4-close-by! (lambda () (x4-c! 'op-mat-compose 'md 'n 'u (x4-mo 'eta) (x4-mo 'xi) (x4-mo (x4-fm 'xi 'eta)))))
(qed 'ext-mult-mat-mul)

;; M(1) = I
(sp (make-wff (x4-ext `(= ,(x4-mm '(ONE F)) (IDENTMAT ,x4-V n)))))
(dk-peel!)
(x4-ext-open!)
(x4-mo-t! '(ONE F))
(dk-have! `(FORALL x4z (IMPLIES (IN x4z (VEC md)) (= (,(x4-mo '(ONE F)) x4z) x4z)))
  (lambda ()
    (let ((z (dk-di-var!)))
      (x4-inf! z)
      (x4-val! '(ONE F) z)
      (crs))))
(mac 'MULT-MAT)
(subst `(= ,x4-V (SCAL md)))
(x4-close-by! (lambda () (x4-c! 'op-mat-id 'md 'n 'u (x4-mo '(ONE F)))))
(qed 'ext-mult-mat-one)

(define (x4-det! xi)                    ; det M(xi) typed in K and in the view
  (x4-mm! xi)
  (if (not (dk-asm? `(IN (DET ,x4-V n ,(x4-mm xi)) (CARR K))))
      (begin
        (x4-c! 'det-in-carrier x4-V 'n (x4-mm xi))
        (dk-rewrite-h! `(IN (DET ,x4-V n ,(x4-mm xi)) (CARR ,x4-V)) `(CARR ,x4-V) '(CARR K)))))

;; |xi|_F is a non-negative real
(sp (make-wff (x4-ext `(FORALL xi (IMPLIES (IN xi (CARR F)) (AND (IN ,(x4-ea 'xi) RR) (<= 0 ,(x4-ea 'xi))))))))
(dk-peel!)
(x4-ext-open!)
(x4-det! 'xi)
(mac 'EXT-ABS) (mac 'EXT-NORM)
(x4-c! 'nf-norm-in-rr 'K `(DET ,x4-V n ,(x4-mm 'xi)))
(x4-c! 'nf-norm-nonneg 'K `(DET ,x4-V n ,(x4-mm 'xi)))
(dk-conj-close! (lambda () (ass)))
(qed 'ext-abs-type)

;; |xi eta|_F = |xi|_F |eta|_F
(sp (make-wff (x4-ext `(FORALL xi (IMPLIES (IN xi (CARR F)) (FORALL eta (IMPLIES (IN eta (CARR F))
  (= ,(x4-ea (x4-fm 'xi 'eta)) (* ,(x4-ea 'xi) ,(x4-ea 'eta))))))))))
(dk-peel!)
(x4-ext-open!)
(x4-mul-t! 'xi 'eta)
(x4-det! 'xi) (x4-det! 'eta)
(let* ((dx `(DET ,x4-V n ,(x4-mm 'xi))) (de `(DET ,x4-V n ,(x4-mm 'eta))))
  (mac 'EXT-ABS) (mac 'EXT-NORM)
  (subst (x4-c! 'ext-mult-mat-mul 'K 'F 'md 'n 'u 'xi 'eta))
  (subst (x4-c! 'det-multiplicative x4-V 'n (x4-mm 'eta) (x4-mm 'xi)))
  (subst `(= (MUL ,x4-V) (MUL K)))
  (subst (x4-c! 'nf-norm-mult 'K de dx))
  (x4-c! 'nf-norm-in-rr 'K dx) (x4-c! 'nf-norm-in-rr 'K de)
  (crs))
(qed 'ext-abs-mul)

;; |1|_F = 1
(sp (make-wff (x4-ext `(= ,(x4-ea '(ONE F)) 1))))
(dk-peel!)
(x4-ext-open!)
(mac 'EXT-ABS) (mac 'EXT-NORM)
(subst (x4-c! 'ext-mult-mat-one 'K 'F 'md 'n 'u))
(subst (x4-c! 'det-identity-ind x4-V 'n))
(subst `(= (ONE ,x4-V) (ONE K)))
(x4-close-by! (lambda () (x4-c! 'nf-norm-one 'K)))
(qed 'ext-abs-one)

;; xi /= 0 implies |xi|_F /= 0
(sp (make-wff (x4-ext `(FORALL xi (IMPLIES (IN xi (CARR F)) (IMPLIES (NOT (= xi (ZERO F))) (NOT (= ,(x4-ea 'xi) 0))))))))
(dk-peel!)
(x4-ext-open!)
(let* ((inv (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'FORSOME) (dk-contains? h '(ONE F)))) "the inverse law"))
       (b (dk-skolem! (x4-chain! (dk-apply! inv 'xi))))
       (a (x4-ea 'xi)) (c (x4-ea b)))
  (dk-split-all! (list (x4-c! 'ext-abs-type 'K 'F 'md 'n 'u 'xi)))
  (dk-split-all! (list (x4-c! 'ext-abs-type 'K 'F 'md 'n 'u b)))
  (let* ((m (x4-c! 'ext-abs-mul 'K 'F 'md 'n 'u 'xi b))
         (m1 (dk-rewrite-h! m (x4-fm 'xi b) '(ONE F)))
         (o1 (x4-c! 'ext-abs-one 'K 'F 'md 'n 'u))
         (m2 (dk-rewrite-h! m1 (x4-ea '(ONE F)) 1)))
    (di)
    (let ((m3 (dk-rewrite-h! `(= 1 (* ,a ,c)) a 0)))
      (fact 'rr-zero-in)
      (dk-absurd! m3 `(IN ,c RR)))))
(qed 'ext-abs-nonzero)

;;; -----------------------------------------------------------------------
;;; C. additivity: M(xi + eta) = M(xi) + M(eta)

(define (x4-landed-typings landed cls)
  (map cadr (filter (lambda (q) (and (dk-head-is? q 'IN) (equal? (caddr q) cls))) landed)))

;; row i of (P + Q) u is row i of P u plus row i of Q u
(sp (make-wff '(FORALL md (IMPLIES (IS-MODULE md) (FORALL m (FORALL n (IMPLIES (IN m NN) (IMPLIES (IN n NN) (IMPLIES (<= 1 n)
  (FORALL pm (FORALL qm (FORALL u (IMPLIES (IN pm (MAT m n (CARR (SCAL md)))) (IMPLIES (IN qm (MAT m n (CARR (SCAL md))))
    (IMPLIES (IN u (MAT n 1 (VEC md))) (FORALL x4i (IMPLIES (IN x4i (INTERVAL 1 m))
      (= (ENTRY (MATACT md (MATADD (SCAL md) pm qm) u) x4i 1)
         ((VADD md) (ENTRY (MATACT md pm u) x4i 1) (ENTRY (MATACT md qm u) x4i 1))))))))))))))))))))
(dk-peel!)
(x4-c! 'module-scalar-ring 'md)
(x4-c! 'module-vector-ag-is-abelian-group 'md)
(x4-c! 'mvag-carr 'md) (x4-c! 'mvag-op 'md)
(fact 'nn-one-in)
(x4-one-11!)
(x4-c! 'interval-in-set 1 'n) (x4-c! 'interval-card-in-nn 1 'n)
(let* ((S '(SCAL md)) (I '(INTERVAL 1 n)) (ag '(MODULE-VECTOR-AG md))
       (pq `(MATADD ,S pm qm)))
  (x4-c! 'matadd-type S 'm 'n 'pm 'qm)
  (let* ((e-pq (x4-app! (x4-c! 'matact-entry 'md 'm 'n 1 pq 'u) 'x4i 1))
         (e-p (x4-app! (x4-c! 'matact-entry 'md 'm 'n 1 'pm 'u) 'x4i 1))
         (e-q (x4-app! (x4-c! 'matact-entry 'md 'm 'n 1 'qm 'u) 'x4i 1))
         (lpq (caddr (caddr e-pq))) (lp (caddr (caddr e-p))) (lq (caddr (caddr e-q)))
         (sumt
          (lambda (lam mat)
      (if (not (dk-asm? `(IN ,lam (FUN ,I (CARR ,ag)))))
          (dk-have! `(IN ,lam (FUN ,I (CARR ,ag)))
            (lambda ()
              (subst `(= (CARR ,ag) (VEC md)))
              (dk-lam-type!
                (lambda ()
                  (let ((j (dk-di-var!)))
                    (x4-c! 'entry-in-carrier 'm 'n `(CARR ,S) mat 'x4i j)
                    (x4-c! 'entry-in-carrier 'n 1 '(VEC md) 'u j 1)
                    (x4-close-by! (lambda () (x4-c! 'module-act-type 'md `(ENTRY ,mat x4i ,j) `(ENTRY u ,j 1))))))
                (lambda () (ass)))))))))
    (subst e-pq) (subst e-p) (subst e-q)
    (sumt lp 'pm) (sumt lq 'qm) (sumt lpq pq)
    (let* ((add (x4-c! 'finsum-add-ag ag I lp lq))
           (lsum (caddr (cadr add))))
      (dk-have! `(FORALL x4q (IMPLIES (IN x4q ,I) (= (,lpq x4q) (,lsum x4q))))
        (lambda ()
          (let ((j (dk-di-var!)))
            (x4-c! 'entry-in-carrier 'm 'n `(CARR ,S) 'pm 'x4i j)
            (x4-c! 'entry-in-carrier 'm 'n `(CARR ,S) 'qm 'x4i j)
            (x4-c! 'entry-in-carrier 'n 1 '(VEC md) 'u j 1)
            (dk-lam-b!)
            (subst `(= (OPR ,ag) (VADD md)))
            (subst (x4-app! (x4-c! 'matadd-entry S 'm 'n 'pm 'qm) 'x4i j))
            (x4-close-by! (lambda () (x4-c! 'module-act-distrib-scalar 'md `(ENTRY pm x4i ,j) `(ENTRY qm x4i ,j) `(ENTRY u ,j 1)))))))
      (let ((cg (x4-c! 'finsum-congruence-q ag I lpq lsum)))
        (subst cg)
        (subst `(= (VADD md) (OPR ,ag)))
        (ass)))))
(qed 'matact-matadd-entry)

;; the matrix of T + S is OP-MAT(T) + OP-MAT(S)
(sp (make-wff (x4-basis `(FORALL tt (FORALL ss (FORALL rr_ (IMPLIES (IN tt (FUN (VEC md) (VEC md))) (IMPLIES (IN ss (FUN (VEC md) (VEC md)))
  (IMPLIES (IN rr_ (FUN (VEC md) (VEC md))) (IMPLIES (FORALL x4z (IMPLIES (IN x4z (VEC md)) (= (rr_ x4z) ((VADD md) (tt x4z) (ss x4z)))))
    (= ,(x4-om 'rr_) (MATADD (SCAL md) ,(x4-om 'tt) ,(x4-om 'ss)))))))))))))
(dk-peel!)
(x4-c! 'module-scalar-ring 'md)
(dk-split-all! (list (x4-c! 'op-mat-spec 'md 'n 'u 'tt)))
(dk-split-all! (list (x4-c! 'op-mat-spec 'md 'n 'u 'ss)))
(x4-one-11!)
(let* ((at (x4-om 'tt)) (as (x4-om 'ss)) (aa `(MATADD (SCAL md) ,at ,as)))
  (x4-c! 'matadd-type '(SCAL md) 'n 'n at as)
  (x4-c! 'map-seq-type 'rr_ '(VEC md) '(VEC md) 'n 'u)
  (x4-c! 'map-seq-type 'tt '(VEC md) '(VEC md) 'n 'u)
  (x4-c! 'map-seq-type 'ss '(VEC md) '(VEC md) 'n 'u)
  (x4-c! 'matact-type 'md 'n 'n 1 aa 'u)
  (dk-have! `(= (MAP-SEQ rr_ n u) (MATACT md ,aa u))
    (lambda ()
      (x4-close-by! (lambda ()
        (x4-chain! (dk-cite! 'matrix-entry-extensionality 'n 1 '(VEC md) '(MAP-SEQ rr_ n u) `(MATACT md ,aa u))
          (lambda ()
            (dk-peel!)
            (let* ((g (dk-goal)) (i (caddr (cadr g))) (j (cadddr (cadr g))))
              (x4-c! 'interval-lo 1 1 j) (x4-c! 'interval-hi 1 1 j) (x4-c! 'interval-elt-in-nn 1 1 j)
              (dk-have! `(= ,j 1) (lambda () (dk-nn! `(<= 1 ,j) `(<= ,j 1))))
              (subst `(= ,j 1))
              (x4-c! 'entry-in-carrier 'n 1 '(VEC md) 'u i 1)
              (subst (x4-c! 'matact-matadd-entry 'md 'n 'n at as 'u i))
              (subst `(= (MATACT md ,at u) (MAP-SEQ tt n u)))
              (subst `(= (MATACT md ,as u) (MAP-SEQ ss n u)))
              (subst (x4-c! 'map-seq-entry 'tt '(VEC md) '(VEC md) 'n 'u i))
              (subst (x4-c! 'map-seq-entry 'ss '(VEC md) '(VEC md) 'n 'u i))
              (subst (x4-c! 'map-seq-entry 'rr_ '(VEC md) '(VEC md) 'n 'u i))
              (x4-close-by! (lambda ()
                (x4-app! '(FORALL x4z (IMPLIES (IN x4z (VEC md)) (= (rr_ x4z) ((VADD md) (tt x4z) (ss x4z))))) `(ENTRY u ,i 1)))))))))))
  (x4-close-by! (lambda () (x4-c! 'op-mat-unique 'md 'n 'u 'rr_ aa))))
(qed 'op-mat-add)

;; M(xi + eta) = M(xi) + M(eta)
(sp (make-wff (x4-ext `(FORALL xi (IMPLIES (IN xi (CARR F)) (FORALL eta (IMPLIES (IN eta (CARR F))
  (= ,(x4-mm '((ADD F) xi eta)) (MATADD ,x4-V ,(x4-mm 'xi) ,(x4-mm 'eta))))))))))
(dk-peel!)
(x4-ext-open!)
(x4-c! 'ring-add-closed 'F 'xi 'eta)
(x4-mo-t! 'xi) (x4-mo-t! 'eta) (x4-mo-t! '((ADD F) xi eta))
(dk-have! `(FORALL x4z (IMPLIES (IN x4z (VEC md)) (= (,(x4-mo '((ADD F) xi eta)) x4z) ((VADD md) (,(x4-mo 'xi) x4z) (,(x4-mo 'eta) x4z)))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (x4-inf! z)
      (x4-val! 'xi z) (x4-val! 'eta z) (x4-val! '((ADD F) xi eta) z)
      (subst '(= (VADD md) (ADD F)))
      (crs))))
(mac 'MULT-MAT)
(subst `(= ,x4-V (SCAL md)))
(x4-close-by! (lambda () (x4-c! 'op-mat-add 'md 'n 'u (x4-mo 'xi) (x4-mo 'eta) (x4-mo '((ADD F) xi eta)))))
(qed 'ext-mult-mat-add)

;;; -----------------------------------------------------------------------
;;; D. scalars: M(c 1) = c I and |c 1|_F = |c|^n

;; row i of (c I) u is c u_i
(sp (make-wff '(FORALL md (IMPLIES (IS-MODULE md) (FORALL n (IMPLIES (IN n NN) (IMPLIES (<= 1 n)
  (FORALL x4c (IMPLIES (IN x4c (CARR (SCAL md))) (FORALL u (IMPLIES (IN u (MAT n 1 (VEC md)))
    (FORALL x4i (IMPLIES (IN x4i (INTERVAL 1 n))
      (= (ENTRY (MATACT md (MATSCALE (SCAL md) x4c (IDENTMAT (SCAL md) n)) u) x4i 1) ((ACT md) x4c (ENTRY u x4i 1))))))))))))))))
(dk-peel!)
(x4-c! 'module-scalar-ring 'md)
(x4-c! 'module-vector-ag-is-abelian-group 'md)
(x4-c! 'mvag-carr 'md) (x4-c! 'mvag-id 'md)
(fact 'nn-one-in)
(x4-one-11!)
(x4-c! 'interval-in-set 1 'n) (x4-c! 'interval-card-in-nn 1 'n)
(let* ((S '(SCAL md)) (I '(INTERVAL 1 n)) (ag '(MODULE-VECTOR-AG md))
       (id `(IDENTMAT ,S n)) (cm `(MATSCALE ,S x4c ,id)))
  (x4-c! 'identmat-type S 'n)
  (x4-c! 'matscale-type S 'n 'n 'x4c id)
  (x4-c! 'ring-zero-in S) (x4-c! 'ring-one-in S)
  (let* ((e (x4-app! (x4-c! 'matact-entry 'md 'n 'n 1 cm 'u) 'x4i 1))
         (lam (caddr (caddr e)))
         (sent (x4-app! (x4-c! 'matscale-entry S 'n 'n 'x4c id) 'x4i)))
    (subst e)
    (dk-have! `(IN ,lam (FUN ,I (CARR ,ag)))
      (lambda ()
        (subst `(= (CARR ,ag) (VEC md)))
        (dk-lam-type!
          (lambda ()
            (let ((j (dk-di-var!)))
              (x4-c! 'entry-in-carrier 'n 'n `(CARR ,S) cm 'x4i j)
              (x4-c! 'entry-in-carrier 'n 1 '(VEC md) 'u j 1)
              (x4-close-by! (lambda () (x4-c! 'module-act-type 'md `(ENTRY ,cm x4i ,j) `(ENTRY u ,j 1))))))
          (lambda () (ass)))))
    (dk-have! `(FORALL x4q (IMPLIES (IN x4q ,I) (IMPLIES (NOT (= x4q x4i)) (= (,lam x4q) (IDEN ,ag)))))
      (lambda ()
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (j (car (x4-landed-typings landed I))))
          (x4-c! 'entry-in-carrier 'n 1 '(VEC md) 'u j 1)
          (dk-lam-b!)
          (subst (x4-chain! (dk-apply! sent j)))
          (dk-have! `(NOT (= x4i ,j))
            (lambda () (di) (dk-have! `(= ,j x4i) (lambda () (subst `(= ,j x4i)) (rfl))) (ai `(NOT (= ,j x4i)))))
          (subst (x4-c! 'identmat-entry-off S 'n 'x4i j))
          (subst (x4-c! 'ring-mul-zero-right S 'x4c))
          (subst `(= (IDEN ,ag) (VZERO md)))
          (x4-close-by! (lambda () (x4-c! 'module-zero-act 'md `(ENTRY u ,j 1)))))))
    (subst (x4-c! 'finsum-single-support ag I lam 'x4i))
    (x4-c! 'entry-in-carrier 'n 1 '(VEC md) 'u 'x4i 1)
    (dk-lam-b!)
    (subst (x4-chain! (dk-apply! sent 'x4i)))
    (subst (x4-c! 'identmat-entry-diag S 'n 'x4i))
    (subst (x4-c! 'ring-mul-right-id S 'x4c))
    (x4-c! 'module-act-type 'md 'x4c '(ENTRY u x4i 1))
    (if (pair? (dk-open-leaves)) (if (not (dk-asm? (dk-goal))) (rfl) (ass)))))
(qed 'matact-scal-ident-entry)

(define (x4-rfl!)
  (if (pair? (dk-open-leaves))
      (let ((g (dk-goal))) (if (and (dk-head-is? g '=) (equal? (cadr g) (caddr g))) (rfl)))))

;; the matrix of x |-> c x is c I
(sp (make-wff (x4-basis `(FORALL x4c (IMPLIES (IN x4c (CARR (SCAL md))) (FORALL rr_ (IMPLIES (IN rr_ (FUN (VEC md) (VEC md)))
  (IMPLIES (FORALL x4z (IMPLIES (IN x4z (VEC md)) (= (rr_ x4z) ((ACT md) x4c x4z))))
    (= ,(x4-om 'rr_) (MATSCALE (SCAL md) x4c (IDENTMAT (SCAL md) n)))))))))))
(dk-peel!)
(x4-c! 'module-scalar-ring 'md)
(x4-one-11!)
(let* ((S '(SCAL md)) (id `(IDENTMAT ,S n)) (cm `(MATSCALE ,S x4c ,id)))
  (x4-c! 'identmat-type S 'n)
  (x4-c! 'matscale-type S 'n 'n 'x4c id)
  (x4-c! 'map-seq-type 'rr_ '(VEC md) '(VEC md) 'n 'u)
  (x4-c! 'matact-type 'md 'n 'n 1 cm 'u)
  (dk-have! `(= (MAP-SEQ rr_ n u) (MATACT md ,cm u))
    (lambda ()
      (x4-close-by! (lambda ()
        (x4-chain! (dk-cite! 'matrix-entry-extensionality 'n 1 '(VEC md) '(MAP-SEQ rr_ n u) `(MATACT md ,cm u))
          (lambda ()
            (dk-peel!)
            (let* ((g (dk-goal)) (i (caddr (cadr g))) (j (cadddr (cadr g))))
              (x4-c! 'interval-lo 1 1 j) (x4-c! 'interval-hi 1 1 j) (x4-c! 'interval-elt-in-nn 1 1 j)
              (dk-have! `(= ,j 1) (lambda () (dk-nn! `(<= 1 ,j) `(<= ,j 1))))
              (subst `(= ,j 1))
              (x4-c! 'entry-in-carrier 'n 1 '(VEC md) 'u i 1)
              (subst (x4-c! 'matact-scal-ident-entry 'md 'n 'x4c 'u i))
              (subst (x4-c! 'map-seq-entry 'rr_ '(VEC md) '(VEC md) 'n 'u i))
              (x4-close-by! (lambda ()
                (x4-app! '(FORALL x4z (IMPLIES (IN x4z (VEC md)) (= (rr_ x4z) ((ACT md) x4c x4z)))) `(ENTRY u ,i 1)))))))))))
  (x4-close-by! (lambda () (x4-c! 'op-mat-unique 'md 'n 'u 'rr_ cm))))
(qed 'op-mat-scal)

;; the scalar c of K is the element c 1 of F; land its typings
(define (x4-scal! c)
  (let ((a `((ACT md) ,c (ONE F))))
    (if (not (dk-asm? `(IN ,a (CARR F))))
        (begin
          (if (not (dk-asm? `(IN ,c (CARR (SCAL md)))))
              (dk-rewrite-h! (dk-rewrite-h! `(IN ,c (CARR K)) '(CARR K) `(CARR ,x4-V)) x4-V '(SCAL md)))
          (if (not (dk-asm? '(IN (ONE F) (VEC md)))) (dk-rewrite-h! '(IN (ONE F) (CARR F)) '(CARR F) '(VEC md)))
          (x4-c! 'module-act-type 'md c '(ONE F))
          (x4-inf! a)))
    a))

;; M(c 1) = c I
(sp (make-wff (x4-ext `(FORALL x4l (IMPLIES (IN x4l (CARR K))
  (= ,(x4-mm '((ACT md) x4l (ONE F))) (MATSCALE ,x4-V x4l (IDENTMAT ,x4-V n))))))))
(dk-peel!)
(x4-ext-open!)
(let* ((a (x4-scal! 'x4l))
       (alg (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'ACT) (dk-contains? h '(MUL F)))) "the algebra law")))
  (x4-mo-t! a)
  (dk-have! `(FORALL x4z (IMPLIES (IN x4z (VEC md)) (= (,(x4-mo a) x4z) ((ACT md) x4l x4z))))
    (lambda ()
      (let ((z (dk-di-var!)))
        (x4-inf! z)
        (x4-c! 'module-act-type 'md 'x4l z)
        (x4-val! a z)
        (dk-have! `(= ,(x4-fm a z) ,(x4-fm z a)) (lambda () (crs)))
        (subst `(= ,(x4-fm a z) ,(x4-fm z a)))
        (subst (x4-app! alg 'x4l z '(ONE F)))
        (dk-have! `(= ,(x4-fm z '(ONE F)) ,z) (lambda () (crs)))
        (subst `(= ,(x4-fm z '(ONE F)) ,z))
        (x4-rfl!))))
  (mac 'MULT-MAT)
  (subst `(= ,x4-V (SCAL md)))
  (x4-close-by! (lambda () (x4-c! 'op-mat-scal 'md 'n 'u 'x4l (x4-mo a)))))
(qed 'ext-mult-mat-scalar)

;; a product of n copies of c is c^n
(sp (make-wff '(FORALL s (IMPLIES (IN s NN) (FORALL r (IMPLIES (IS-COMMUTATIVE-RING r) (FORALL x4c (IMPLIES (IN x4c (CARR r))
  (FORALL g (IMPLIES (FORALL x4z (IMPLIES (IN x4z (INTERVAL 1 s)) (= (g x4z) x4c)))
    (= (PROD-RING r g (INTERVAL 1 s)) (RING-POWER r x4c s))))))))))))
(let* ((rs (dk-use-induction-fixed! '(r x4c g)))
       (base (cdr (assq 'base rs))) (step (cdr (assq 'step rs))) (ih (cdr (assq 'ih rs))) (v (cdr (assq 'var rs))))
  (dk-focus! base)
  (if (dk-head-is? (dk-goal) 'IMPLIES) (dk-peel!))
  (x4-c! 'commutative-ring-is-ring 'r)
  (subst (x4-c! 'interval-1-0-empty))
  (subst (x4-c! 'prod-ring-empty 'r 'g))
  (subst (x4-c! 'ring-power-zero 'r 'x4c))
  (x4-rfl!)
  (dk-focus! step)
  (if (dk-head-is? (dk-goal) 'IMPLIES) (dk-peel!))
  (x4-c! 'commutative-ring-is-ring 'r)
  (let* ((sv `(succ ,v))
         (h (dk-pick (lambda (q) (and (dk-head-is? q 'FORALL) (dk-contains? q sv) (dk-contains? q 'g))) "the hypothesis at succ")))
    (x4-c! 'nn-succ-closed v)
    (x4-c! 'nn-le-succ v)
    (dk-have! `(FORALL x4y (IMPLIES (IN x4y (INTERVAL 1 ,sv)) (IN (g x4y) (CARR r))))
      (lambda () (let ((z (dk-di-var!))) (x4-app! h z) (subst `(= (g ,z) x4c)) (ass))))
    (subst (x4-c! 'lzd-prod-succ 'r v 'g))
    (dk-have! (cadr ih)
      (lambda ()
        (let ((z (dk-di-var!)))
          (x4-c! 'interval-widen v sv 1 z)
          (x4-close-by! (lambda () (x4-app! h z))))))
    (subst (x4-chain! ih))
    (fact 'nn-one-in)
    (dk-have! `(<= 1 ,sv) (lambda () (dk-nn!)))
    (dk-have! `(<= ,sv ,sv) (lambda () (dk-nn!)))
    (x4-c! 'interval-mem-intro 1 sv sv)
    (subst (x4-app! h sv))
    (x4-c! 'ring-power-type 'r 'x4c v)
    (subst (x4-c! 'ring-power-succ 'r 'x4c v))
    (x4-c! 'ring-carrier-closed-mul 'r `(RING-POWER r x4c ,v) 'x4c)
    (x4-rfl!)))
(qed 'prod-ring-const)

;; det(c I) = c^n
(sp (make-wff '(FORALL r (IMPLIES (IS-COMMUTATIVE-RING r) (FORALL n (IMPLIES (IN n NN) (FORALL x4c (IMPLIES (IN x4c (CARR r))
  (= (DET r n (MATSCALE r x4c (IDENTMAT r n))) (RING-POWER r x4c n))))))))))
(dk-peel!)
(x4-c! 'commutative-ring-is-ring 'r)
(x4-c! 'ring-zero-in 'r)
(let* ((id '(IDENTMAT r n)) (d `(MATSCALE r x4c ,id)))
  (x4-c! 'identmat-type 'r 'n)
  (x4-c! 'matscale-type 'r 'n 'n 'x4c id)
  (let ((sent (x4-c! 'matscale-entry 'r 'n 'n 'x4c id)))
    (dk-have! `(IS-UPPER-TRIANGULAR r n ,d)
      (lambda ()
        (mac 'is-upper-triangular)
        (let* ((landed (dk-landed (lambda () (dk-peel!))))
               (eg (cadr (dk-goal)))
               (a (caddr eg)) (b (cadddr eg)))
          (x4-c! 'interval-elt-in-nn 1 'n a) (x4-c! 'interval-elt-in-nn 1 'n b)
          (subst (x4-app! sent a b))
          (dk-have! `(NOT (= ,a ,b)) (lambda () (di) (dk-nn-absurd! `(< ,b ,a) `(= ,a ,b))))
          (subst (x4-c! 'identmat-entry-off 'r 'n a b))
          (subst (x4-c! 'ring-mul-zero-right 'r 'x4c))
          (x4-rfl!))))
    (subst (x4-c! 'det-upper-triangular 'r 'n d))
    (let* ((g (dk-goal)) (lam (caddr (cadr g))))
      (dk-have! `(FORALL x4z (IMPLIES (IN x4z (INTERVAL 1 n)) (= (,lam x4z) x4c)))
        (lambda ()
          (let ((z (dk-di-var!)))
            (dk-lam-b!)
            (subst (x4-app! sent z z))
            (subst (x4-c! 'identmat-entry-diag 'r 'n z))
            (subst (x4-c! 'ring-mul-right-id 'r 'x4c))
            (x4-rfl!))))
      (x4-close-by! (lambda () (x4-c! 'prod-ring-const 'n 'r 'x4c lam))))))
(qed 'det-scal-ident)

;; |c 1|_F = |c|^n: on K, |.|_F is the n-th power of |.|
(sp (make-wff (x4-ext `(FORALL x4l (IMPLIES (IN x4l (CARR K))
  (= ,(x4-ea '((ACT md) x4l (ONE F))) (power ((FNRM K) x4l) n)))))))
(dk-peel!)
(x4-ext-open!)
(x4-scal! 'x4l)
(dk-rewrite-h! '(IN x4l (CARR K)) '(CARR K) `(CARR ,x4-V))
(mac 'EXT-ABS) (mac 'EXT-NORM)
(subst (x4-c! 'ext-mult-mat-scalar 'K 'F 'md 'n 'u 'x4l))
(subst (x4-c! 'det-scal-ident x4-V 'n 'x4l))
(x4-close-by! (lambda () (x4-c! 'nv-pow-norm-power 'K 'x4l 'n)))
(qed 'ext-abs-scalar)

;; |0|_F = 0
(sp (make-wff (x4-ext `(= ,(x4-ea '(ZERO F)) 0))))
(dk-peel!)
(x4-ext-open!)
(x4-c! 'nf-zero-in-carr 'K)
(x4-scal! '(ZERO K))
(let* ((z0 (x4-c! 'module-zero-act 'md '(ONE F)))
       (z1 (dk-rewrite-h! z0 '(SCAL md) x4-V))
       (z2 (dk-rewrite-h! z1 `(ZERO ,x4-V) '(ZERO K)))
       (z3 (dk-rewrite-h! z2 '(VZERO md) '(ZERO F))))
  (subst `(= (ZERO F) ((ACT md) (ZERO K) (ONE F))))
  (subst (x4-c! 'ext-abs-scalar 'K 'F 'md 'n 'u '(ZERO K)))
  (subst (x4-c! 'nf-norm-of-zero 'K))
  (let ((q (dk-skolem! (x4-c! 'nn-pos-is-succ 'n))))
    (subst `(= n (succ ,q)))
    (x4-close-by! (lambda () (x4-c! 'power-zero-base q)))))
(qed 'ext-abs-zero)

;;; -----------------------------------------------------------------------
;;; E. Proposition 4.2, with Proposition 3.6 as a hypothesis.
;;;
;;; THE HYPOTHESIS (Proposition 3.6 on the algebra A = {M(xi) : xi in F}): for xi, eta in F,
;;;     |det(M(xi) + M(eta))|_K <= max(|det M(xi)|_K, |det M(eta)|_K).
;;; The notes apply 3.6 to the algebra generated by M(theta), which contains every M(xi) (CCR.pdf, after (27));
;;; 3.6 itself is CCR-1109-B2's target and is not proven in the tree.

(define (x4-det-abs m) `((FNRM K) (DET ,x4-V n ,m)))
(define x4-h36
  `(FORALL x4s (IMPLIES (IN x4s (CARR F)) (FORALL x4t (IMPLIES (IN x4t (CARR F))
     (<= ,(x4-det-abs `(MATADD ,x4-V ,(x4-mm 'x4s) ,(x4-mm 'x4t)))
         (MAX ,(x4-det-abs (x4-mm 'x4s)) ,(x4-det-abs (x4-mm 'x4t)))))))))

(sp (make-wff (x4-ext `(IMPLIES ,x4-h36
  (AND (IS-NV-VALUATION F (VNB-LAMBDA x4v (CARR F) ,(x4-ea 'x4v)))
       (FORALL x4l (IMPLIES (IN x4l (CARR K)) (= ,(x4-ea '((ACT md) x4l (ONE F))) (power ((FNRM K) x4l) n)))))))))
(dk-peel!)
(x4-ext-open!)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ((dk-head-is? g 'FORALL)
         (let ((l (dk-di-var!)))
           (x4-close-by! (lambda () (x4-c! 'ext-abs-scalar 'K 'F 'md 'n 'u l)))))
        (#t
         (mac 'IS-NV-VALUATION)
         (dk-conj-close!
           (lambda ()
             (let ((g2 (dk-goal)))
               (cond
                 ((dk-asm? g2) (ass))
                 ((dk-head-is? g2 'IN)
                  (x4-c! 'ring-carr-in-set 'F)
                  (dk-lam-type!
                    (lambda ()
                      (let ((x (dk-di-var!)))
                        (dk-split-all! (list (x4-c! 'ext-abs-type 'K 'F 'md 'n 'u x)))
                        (ass)))
                    (lambda () (ass))))
                 ((dk-contains? g2 'IFF)
                  (let ((x (dk-di-var!)))
                    (dk-lam-b!)
                    (dk-iff! (lambda (gl) (equal? (cadr gl) x))
                      (lambda ()
                        (let ((imp (dk-cite! 'ext-abs-nonzero 'K 'F 'md 'n 'u x))
                              (z (dk-pick (lambda (q) (and (dk-head-is? q '=) (equal? (caddr q) 0) (dk-contains? q 'EXT-ABS))) "the zero norm")))
                          (keep imp z)
                          (prop)))
                      (lambda ()
                        (subst `(= ,x (ZERO F)))
                        (x4-close-by! (lambda () (x4-c! 'ext-abs-zero 'K 'F 'md 'n 'u)))))))
                 (#t
                  (let* ((landed (dk-landed (lambda () (dk-peel!))))
                         (xs (x4-landed-typings landed '(CARR F))))
                    (cond
                      ((null? (cdr xs))     ; nu >= 0
                       (dk-lam-b!)
                       (dk-split-all! (list (x4-c! 'ext-abs-type 'K 'F 'md 'n 'u (car xs))))
                       (ass))
                      ((dk-contains? g2 'MAX)  ; the ultrametric inequality, from the hypothesis
                       (let ((x (car xs)) (y (cadr xs)))
                         (x4-c! 'ring-add-closed 'F x y)
                         (dk-lam-b!)
                         (mac 'EXT-ABS) (mac 'EXT-NORM)
                         (subst (x4-c! 'ext-mult-mat-add 'K 'F 'md 'n 'u x y))
                         (x4-close-by! (lambda () (x4-app! x4-h36 x y)))))
                      (#t                      ; multiplicativity
                       (let ((x (car xs)) (y (cadr xs)))
                         (x4-mul-t! x y)
                         (dk-lam-b!)
                         (x4-close-by! (lambda () (x4-c! 'ext-abs-mul 'K 'F 'md 'n 'u x y)))))))))))))))))
(qed 'ccr-4-2)

;; the normalised |.|_F^(1/n) restricts to |.| on K: |c 1|_F^(1/n) = |c|
(sp (make-wff (x4-ext `(FORALL x4l (IMPLIES (IN x4l (CARR K))
  (= (EXT-ABS-ROOT K F md n u ((ACT md) x4l (ONE F))) ((FNRM K) x4l)))))))
(dk-peel!)
(x4-ext-open!)
(mac 'EXT-ABS-ROOT)
(subst (x4-c! 'ext-abs-scalar 'K 'F 'md 'n 'u 'x4l))
(let ((nr '((FNRM K) x4l)))
  (x4-c! 'nf-norm-in-rr 'K 'x4l) (x4-c! 'nf-norm-nonneg 'K 'x4l)
  (x4-c! 'nn-in-rr 'n)
  (x4-c! 'recip-star-in-rr 'n)
  (x4-c! 'recip-star-nn-pos 'n)
  (use-em `(= ,nr 0)
    (lambda ()
      (subst `(= ,nr 0))
      (let ((q (dk-skolem! (x4-c! 'nn-pos-is-succ 'n))))
        (dk-have! '(= (power 0 n) 0) (lambda () (subst `(= n (succ ,q))) (x4-close-by! (lambda () (x4-c! 'power-zero-base q)))))
        (subst '(= (power 0 n) 0))
        (x4-close-by! (lambda () (x4-c! 'rpow-star-zero-base '(RECIP-STAR n))))))
    (lambda ()
      (dk-have! `(NOT (= 0 ,nr))
        (lambda () (di) (dk-have! `(= ,nr 0) (lambda () (subst `(= ,nr 0)) (rfl))) (ai `(NOT (= ,nr 0)))))
      (dk-have-and! `(<= 0 ,nr) `(NOT (= 0 ,nr)))
      (x4-c! 'rr-le-ne-lt 0 nr)
      (dk-have! '(NOT (= n 0)) (lambda () (di) (dk-nn-absurd! '(<= 1 n) '(= n 0))))
      (x4-c! 'rpow-star-nat 'n nr)
      (subst `(= (power ,nr n) (RPOW-STAR ,nr n)))
      (subst (x4-c! 'rpow-star-pow nr 'n '(RECIP-STAR n)))
      (subst (x4-c! 'recip-star-inverse 'n))
      (x4-close-by! (lambda () (x4-c! 'rpow-star-one nr))))))
(qed 'ext-abs-root-scalar)
