;;; ch6-weier.scm -- WAVE 2 (2026-10-27..30), wired 2026-10-30 from scratchpad/ch6/ch6-weier.scm.
;;; Library: complex-analysis.

;;; ch6-weier.scm -- CH6-B: Weierstrass products (section 6.3).  Loads AFTER ch6-prod.scm and ch6-fun.scm
;;; (c6- and c6f- helpers); own prefix c6w-.  Library: complex-analysis.
;;; Q_n(w) = sum_{k=1}^n w^k / k is written CC-SERIES-PARTIAL-SUM(k -> RECIP-STAR(k) w^k, n + 1) (the k = 0 term
;;; is 0), the coefficients of cc-log-one-minus-disc: log(1 - w) = - sum_k RECIP-STAR(k) w^k.

;;; the coefficient lambda is written with cc-log-one-minus-disc's own binder clhk_, so that its series is LITERALLY the
;;; theorem's (ineq and the lookups compare terms, not alpha classes)
;;; KIT-9 link skipping, opt-in per file since 2026-10-29 (this file was developed with it on); guarded for bands that predate it

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

;;; ---- helper defines COPIED 2026-10-30 (wave-2 integration) from ch6/ch6-fun.scm, ch6/ch6-prod.scm:
;;; the probe loaded this chain in ONE environment; load.scm gives each file its own.
(define (c6-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (c6-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (c6-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (c6-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))
(define (c6-nn! n) (fact 'nn-in-rr n) (fact 'rr-subset-cc n))
(define (c6-has-sub? t u) (or (equal? t u) (and (pair? t) (any-pred (lambda (x) (c6-has-sub? x u)) t))))
(define (c6-induct! base step)               ; after (ni): BASE on the base leaf, STEP on the step leaf
  (let* ((ls (dk-open-leaves))
         (step? (lambda (l) (let ((g (dk-goal-of l)))
                              (and (c6-op? g 'FORALL 3) (c6-op? (caddr g) 'IMPLIES 3)
                                   (c6-op? (cadr (caddr g)) 'IN 3) (eq? (caddr (cadr (caddr g))) 'NN)
                                   (eq? (cadr (cadr (caddr g))) (cadr g))
                                   (c6-has-sub? g (list 'succ (cadr g)))))))
         (b (find-first (lambda (l) (not (step? l))) ls))
         (st (find-first step? ls)))
    (if (not (and b st)) (error "c6-induct!: leaves not found" (map dk-goal-of ls)))
    (dk-focus! b) (base)
    (dk-focus! st) (step)))
(define (c6-steps!)                          ; peel FORALL / IMPLIES; return the landed formulas
  (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
(define (c6-var new cls) (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (c6-vars new cls) (map cadr (filter (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (c6-succ-var new) (let ((vs (c6-vars new 'NN))) (find-first (lambda (v) (c6-has-sub? (dk-goal) (list 'succ v))) vs)))
(define (c6-lam-typ! lam cod typer)          ; (IN lam (FUN NN cod)); TYPER gets the eigenvariable, must ground
  (let ((typ (list 'IN lam (list 'FUN 'NN cod))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda () (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*))) (typer k) (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
              (lambda () (fact 'nn-is-set) (dk-ass!))))))
    typ))
(define (c6-mag! t) (fact 'cc-magnitude-closed t) (fact 'cc-magnitude-nonneg t) (list 'magnitude t))
(define c6-debug #f)
(define (c6-first-map f l) (cond ((null? l) #f) ((f (car l)) => (lambda (x) x)) (#t (c6-first-map f (cdr l)))))
(define (c6-prod-sub t)
  (cond ((not (pair? t)) #f)
        ((not (memq (car t) '(+ - * < <= = AND))) #f)                ; any other head is an atom for ineq
        (#t (or (c6-first-map c6-prod-sub (cdr t))
                (and (eq? (car t) '*) (= (length t) 3) (not (number? (cadr t))) (not (number? (caddr t))) t)))))
(define (c6-ineq*! . prems)
  (let loop ((prems prems))
    (let ((pt (c6-first-map c6-prod-sub (cons (dk-goal) prems))))
      (if (not pt)
          (begin
            (if c6-debug (for-each (lambda (q) (display ";; C6I ") (display (expression->string q)) (newline)) (cons (dk-goal) prems)))
            (apply dk-ineq! prems))
          (begin
            (c6-rr! pt)
            (let ((v (dk-name! pt 'RR)))
              (if (dk-contains? (dk-goal) pt) (subst (list '= pt v)))
              (loop (map (lambda (f) (if (dk-contains? f pt) (dk-rewrite-h! f pt v) f)) prems))))))))
(define (c6-nonneg r) (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list '<= 0 (list r 'c6i_)))))
(define (c6-chain-end f) (if (c6-op? f 'IMPLIES 3) (c6-chain-end (caddr f)) f))
(define (c6-cite! . args)                     ; dk-cite! that refuses to return an undetached implication link
  (let ((r (apply dk-cite! args)))
    (cond ((not (c6-op? r 'IMPLIES 3)) r)
          ((dk-asm? (c6-chain-end r)) (dk-ctx-form (c6-chain-end r)))     ; the consequent was already in context
          (#t (error "c6-cite!: the chain stopped at an antecedent not in context" (car args) (expression->string (cadr r)))))))
(define (c6-pts!)
  (fact 'cc-is-metric-space)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (c6-sk! ex) (dk-skolem! (dk-ctx-form ex) #t))
(define (c6-slit w) (list 'NOT (list 'AND (list '= (list 'imag-part w) 0) (list '<= (list 'real-part w) 0))))
(define (c6-pow2! x)                           ; (= (power x 2) (* x x)), x in CC
  (let ((e (list '= (list 'power x 2) (list '* x x))))
    (if (not (dk-asm? e))
        (dk-have! e
          (lambda ()
            (fact 'nn-two-is-succ-succ-zero) (subst '(= 2 (succ (succ 0))))
            (fact 'nn-zero-in) (fact 'nn-succ-closed 0)
            (c6-and! (list 'IN x 'CC) '(IN (succ 0) NN)) (subst (dk-fact! 'power-succ x '(succ 0)))
            (c6-and! (list 'IN x 'CC) '(IN 0 NN)) (subst (dk-fact! 'power-succ x 0))
            (subst (dk-fact! 'power-zero x))
            (crs))))
    e))
(define (c6-nk! nv k)                         ; nv, k in NN: (+ nv k) in NN, RR, CC and nv <= nv + k
  (let ((j (list '+ nv k)))
    (c6-and! (list 'IN nv 'NN) (list 'IN k 'NN)) (fact 'nn-add-closed nv k) (c6-nn! nv) (c6-nn! k) (c6-nn! j) (fact 'nn-zero-le k)
    (if (not (dk-asm? (list '<= nv j))) (dk-have! (list '<= nv j) (lambda () (dk-ineq! (list '<= 0 k)))))
    j))
(define (c6-csps f n) (list 'CC-SERIES-PARTIAL-SUM f n))
(define (c6-csps-typ! f n) (dk-cite! 'cc-series-partial-sum-in-cc n f) (c6-csps f n))
(define (c6-csps-succ! f n)                  ; f in FUN(NN, CC), n in NN: S(f, succ n) == S(f, n) + f(n)
  (c6-csps-typ! f n) (fact 'fun-apply-type-c f 'NN 'CC n)
  (dk-cite! 'cc-series-partial-sum-succ f n))
(define (c6-fv! f u k y)                        ; f in FUN(NN, FUN(u, CC)), k in NN, y in u: f_k in FUN(u, CC), f_k(y) in CC
  (fact 'fun-apply-type-c f 'NN (list 'FUN u 'CC) k) (fact 'fun-apply-type-c (list f k) u 'CC y))
(define (c6-opx f x) (list 'VNB-LAMBDA 'c6k_ 'NN (list '+ 1 (list (list f 'c6k_) x))))
(define (c6-famhol u f) (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list 'HOLOMORPHIC-ON u (list f 'c6i_)))))
(define (c6f-famcont u f) (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list 'IN (list f 'c6i_) (list 'CC-CONT-FNS u)))))
(define (c6f-typ-on! lam u typer)              ; (IN lam (FUN u CC)); TYPER gets the eigenvariable
  (let ((typ (list 'IN lam (list 'FUN u 'CC))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*))) (typer x) (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
              (lambda () (dk-ass!))))))
    typ))
(define (c6f-cont-close! h u)                  ; goal (IN h (CC-CONT-FNS u)); h in FUN(u, CC) and its continuity in context
  (let* ((iff (c6-cite! 'cc-cont-fns-membership u h)) (rhs (caddr iff)))
    (dk-have! rhs (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
    (keep iff rhs) (prop)))
(define (c6f-ptw u h rhs-of)                   ; forall y in u. h(y) == RHS(y)
  (list 'FORALL 'c6y_ (list 'IMPLIES (list 'IN 'c6y_ u) (list '== (list h 'c6y_) (rhs-of 'c6y_)))))
(define (c6f-lb!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
(define (c6f-tl-eq tv gv nv) (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list '= (list tv 'c6j_) (list gv (list '+ nv 'c6j_))))))
(define (c6f-kx u n) (list 'CC-EXHAUST u n))
(define (c6f-lk u f n j) (list 'VNB-LAMBDA 'c6x_ (c6f-kx u n) (list 'CC-LOG (list '+ 1 (list (list f j) 'c6x_)))))
(define (c6f-lgf u f n nv) (list 'VNB-LAMBDA 'c6k_ 'NN (c6f-lk u f n (list '+ nv 'c6k_))))
(define (c6f-guardk u f n nv)
  (list 'FORALL 'c6q_ (list 'IMPLIES '(IN c6q_ NN) (list 'IMPLIES (list '<= nv 'c6q_)
    (list 'FORALL 'c6w_ (list 'IMPLIES (list 'IN 'c6w_ (c6f-kx u n)) (c6-slit (list '+ 1 (list (list f 'c6q_) 'c6w_)))))))))
(define (c6f-logside u f)
  (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN)
    (list 'FORSOME 'c6m_ (list 'AND '(IN c6m_ NN) (list 'AND (c6f-guardk u f 'c6n_ 'c6m_)
      (list 'IS-NORMALLY-CONVERGENT (c6f-lgf u f 'c6n_ 'c6m_) (c6f-kx u 'c6n_))))))))
(define (c6f-rfl-close!) (dk-close-if! (lambda () #t) (lambda () (rfl))))
(define (c6f-lb-close!) (dk-close-if! (lambda () (c6f-lb!)) (lambda () (dk-ass!))))
(define (c6f-rr-mul-nonneg! x y)               ; 0 <= x, 0 <= y in context: lands 0 <= x * y
  (let ((r (list '<= 0 (list '* x y))))
    (if (not (dk-asm? r))
        (let ((k (c6-cite! 'rr-mul-le-right 0 x y)))
          (dk-have! (list '= (list '* 0 y) 0) (lambda () (crs)))
          (dk-have! r (lambda () (dk-ineq! (dk-rewrite-h! k (list '* 0 y) 0))))))
    r))
(define (c6f-cc-and-closed! law x y)            ; law cc-mul-closed / cc-add-closed: (IN (op x y) CC)
  (c6-and! (list 'IN x 'CC) (list 'IN y 'CC)) (fact law x y))
;;; ---- end of copied helpers ----

(define (c6w-coef w) (list 'VNB-LAMBDA 'clhk_ 'NN (list '* (list 'RECIP-STAR 'clhk_) (list 'power w 'clhk_))))
(define (c6w-qs w m) (list 'CC-SERIES-PARTIAL-SUM (c6w-coef w) m))
(define (c6w-e n w) (list '* (list '- 1 w) (list 'CC-EXP (c6w-qs w (list 'succ n)))))   ; E_n(w) = (1 - w) e^{Q_n(w)}
(define (c6w-exp-typ! q) (if (not (dk-asm? (list 'IN (list 'CC-EXP q) 'CC))) (dk-split-all! (list (dk-cite! 'cc-exp-converges q)))))
;;; w in CC, n in NN: E_n(w) in CC
(define (c6w-e-typ! n w)
  (let ((q (c6w-qs w (list 'succ n))))
    (fact 'nn-succ-closed n) (c6w-coef-typ! w) (dk-cite! 'cc-series-partial-sum-in-cc (list 'succ n) (c6w-coef w))
    (c6w-exp-typ! q) (fact 'cc-one-in) (c6-cc! (list '- 1 w))
    (if (not (dk-asm? (list 'IN (c6w-e n w) 'CC))) (c6f-cc-and-closed! 'cc-mul-closed (list '- 1 w) (list 'CC-EXP q)))))
(define (c6w-mul-nonneg! x y)                    ; x, y in RR and >= 0 in context: 0 <= x y (no typing of the product needed)
  (c6-and! (list 'IN x 'RR) (list 'IN y 'RR)) (c6-and! (list '<= 0 x) (list '<= 0 y)) (fact 'rr-leq-mul-nonneg x y))
(define (c6w-cc-setup!) (fact 'cc-is-set) (fact 'cc-one-in) (fact 'cc-zero-in) (fact 'nn-zero-in) (fact 'rr-zero-in) (fact 'rr-one-in))
(define (c6w-hol-transfer! lam tg)               ; HOLOMORPHIC-ON(CC, tg), lam in FUN(CC, CC), lam == tg pointwise in context
  (c6-cite! 'holomorphic-transfer-ptwise-eq 'CC lam tg))
(define (c6w-pow-typ! w m)                       ; w in CC, m in NN: w^m in CC
  (c6-and! (list 'IN w 'CC) (list 'IN m 'NN)) (fact 'power-typing-nonneg w m) (list 'IN (list 'power w m) 'CC))

;;; z -> (z c)^m is entire
(define (c6w-pl c m) (list 'VNB-LAMBDA 'c6x_ 'CC (list 'power (list '* 'c6x_ c) m)))
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6c_ (list 'IMPLIES '(IN c6c_ CC)
  (list 'HOLOMORPHIC-ON 'CC (c6w-pl 'c6c_ 'c6n_))))))))
(define (c6w-pl-typ! c m)
  (c6f-typ-on! (c6w-pl c m) 'CC (lambda (x) (c6f-cc-and-closed! 'cc-mul-closed x c) (c6w-pow-typ! (list '* x c) m))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (c (c6-var new 'CC)) (l0 (c6w-pl c 0)) (one (list 'VNB-LAMBDA 'c6x_ 'CC 1)))
      (c6w-cc-setup!)
      (dk-have! (list 'HOLOMORPHIC-ON 'CC one) (lambda () (dk-holomorphic! 'CC one)))
      (c6w-pl-typ! c 0)
      (dk-have! (c6f-ptw 'CC l0 (lambda (y) (list one y)))
        (lambda () (let ((x (dk-di-var!))) (c6f-cc-and-closed! 'cc-mul-closed x c) (dk-lam-b!)
                     (subst (dk-fact! 'power-zero (list '* x c))) (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
      (c6w-hol-transfer! l0 one)
      (dk-ass!)))
  (lambda ()
    (let* ((new (c6-steps!)) (m (c6-succ-var new)) (c (c6-var new 'CC))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'HOLOMORPHIC-ON))) new))
           (l0 (c6w-pl c m)) (l1 (c6w-pl c (list 'succ m))))
      (c6w-cc-setup!) (fact 'nn-succ-closed m)
      (let* ((hp (dk-apply! ih c)))
        (c6w-pl-typ! c m) (c6w-pl-typ! c (list 'succ m))
        (let* ((pv (dk-name! l0 '(FUN CC CC)))
               (tg (list 'VNB-LAMBDA 'c6x_ 'CC (list '* (list '* 'c6x_ c) (list pv 'c6x_)))))
          (dk-rewrite-h! hp l0 pv)
          (dk-have! (list 'HOLOMORPHIC-ON 'CC tg) (lambda () (dk-holomorphic! 'CC tg)))
          (dk-have! (c6f-ptw 'CC l1 (lambda (y) (list tg y)))
            (lambda ()
              (let* ((x (dk-di-var!)) (xc (list '* x c)))
                (c6f-cc-and-closed! 'cc-mul-closed x c) (c6w-pow-typ! xc m)
                (dk-lam-b!)
                (subst (list '= pv l0))
                (dk-lam-b!)
                (c6-and! (list 'IN xc 'CC) (list 'IN m 'NN))
                (subst (dk-fact! 'power-succ xc m))
                (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
          (c6w-hol-transfer! l1 tg)
          (dk-ass!))))))
(qed 'cc-pow-lin-holomorphic)

;;; z -> sum_{k<m} RECIP-STAR(k) (z c)^k is entire
(define (c6w-ql c m) (list 'VNB-LAMBDA 'c6x_ 'CC (c6w-qs (list '* 'c6x_ c) m)))
(define (c6w-coef-typ! w)                         ; w in CC: k -> RECIP-STAR(k) w^k in FUN(NN, CC)
  (c6-lam-typ! (c6w-coef w) 'CC (lambda (k) (c6-nn! k) (fact 'recip-star-in-rr k) (fact 'rr-subset-cc (list 'RECIP-STAR k))
                                    (c6w-pow-typ! w k) (c6f-cc-and-closed! 'cc-mul-closed (list 'RECIP-STAR k) (list 'power w k)))))
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6c_ (list 'IMPLIES '(IN c6c_ CC)
  (list 'HOLOMORPHIC-ON 'CC (c6w-ql 'c6c_ 'c6n_))))))))
(define (c6w-ql-typ! c m)
  (c6f-typ-on! (c6w-ql c m) 'CC (lambda (x) (c6f-cc-and-closed! 'cc-mul-closed x c) (c6w-coef-typ! (list '* x c))
                                  (dk-cite! 'cc-series-partial-sum-in-cc m (c6w-coef (list '* x c))))))
(ni)
(c6-induct!
  (lambda ()
    (let* ((new (c6-steps!)) (c (c6-var new 'CC)) (l0 (c6w-ql c 0)) (zero (list 'VNB-LAMBDA 'c6x_ 'CC 0)))
      (c6w-cc-setup!)
      (dk-have! (list 'HOLOMORPHIC-ON 'CC zero) (lambda () (dk-holomorphic! 'CC zero)))
      (c6w-ql-typ! c 0)
      (dk-have! (c6f-ptw 'CC l0 (lambda (y) (list zero y)))
        (lambda () (let ((x (dk-di-var!))) (dk-lam-b!)
                     (subst (dk-cite! 'cc-series-partial-sum-zero (c6w-coef (list '* x c)))) (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
      (c6w-hol-transfer! l0 zero)
      (dk-ass!)))
  (lambda ()
    (let* ((new (c6-steps!)) (m (c6-succ-var new)) (c (c6-var new 'CC))
           (ih (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'HOLOMORPHIC-ON))) new))
           (l0 (c6w-ql c m)) (l1 (c6w-ql c (list 'succ m))) (pl (c6w-pl c m)) (rs (list 'RECIP-STAR m)))
      (c6w-cc-setup!) (fact 'nn-succ-closed m) (c6-nn! m) (fact 'recip-star-in-rr m) (fact 'rr-subset-cc rs)
      (let* ((hp (dk-apply! ih c)) (hq (c6-cite! 'cc-pow-lin-holomorphic m c)))
        (c6w-ql-typ! c m) (c6w-ql-typ! c (list 'succ m)) (c6w-pl-typ! c m)
        (let* ((sv (dk-name! l0 '(FUN CC CC))) (pw (dk-name! pl '(FUN CC CC)))
               (tg (list 'VNB-LAMBDA 'c6x_ 'CC (list '+ (list sv 'c6x_) (list '* rs (list pw 'c6x_))))))
          (dk-rewrite-h! hp l0 sv) (dk-rewrite-h! hq pl pw)
          (dk-have! (list 'HOLOMORPHIC-ON 'CC tg) (lambda () (dk-holomorphic! 'CC tg)))
          (dk-have! (c6f-ptw 'CC l1 (lambda (y) (list tg y)))
            (lambda ()
              (let* ((x (dk-di-var!)) (xc (list '* x c)) (cf (c6w-coef xc)))
                (c6f-cc-and-closed! 'cc-mul-closed x c) (c6w-coef-typ! xc)
                (dk-lam-b!)
                (subst (list '= sv l0)) (subst (list '= pw pl))
                (dk-lam-b!)
                (subst (c6-csps-succ! cf m))
                (dk-lam-b!)
                (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
          (c6w-hol-transfer! l1 tg)
          (dk-ass!))))))
(qed 'weier-q-holomorphic)

;;; z -> E_n(z c) - 1 is entire
(define (c6w-el c n) (list 'VNB-LAMBDA 'c6x_ 'CC (list '- (c6w-e n (list '* 'c6x_ c)) 1)))
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6c_ (list 'IMPLIES '(IN c6c_ CC)
  (list 'HOLOMORPHIC-ON 'CC (c6w-el 'c6c_ 'c6n_))))))))
(let* ((new (c6-steps!)) (n (c6-var new 'NN)) (c (c6-var new 'CC)) (sn (list 'succ n))
       (ql (c6w-ql c sn)) (el (c6w-el c n)))
  (c6w-cc-setup!) (fact 'nn-succ-closed n)
  (let ((hq (c6-cite! 'weier-q-holomorphic sn c)))
    (c6w-ql-typ! c sn)
    (c6f-typ-on! el 'CC (lambda (x) (let* ((xc (list '* x c)) (q (c6w-qs xc sn)))
                                      (c6f-cc-and-closed! 'cc-mul-closed x c) (c6w-coef-typ! xc)
                                      (dk-cite! 'cc-series-partial-sum-in-cc sn (c6w-coef xc))
                                      (c6w-exp-typ! q) (c6-cc! (list '- 1 xc))
                                      (c6f-cc-and-closed! 'cc-mul-closed (list '- 1 xc) (list 'CC-EXP q))
                                      (c6-cc! (list '- (c6w-e n xc) 1)))))
    (let* ((qv (dk-name! ql '(FUN CC CC)))
           (tg (list 'VNB-LAMBDA 'c6x_ 'CC (list '- (list '* (list '- 1 (list '* 'c6x_ c)) (list 'CC-EXP (list qv 'c6x_))) 1))))
      (dk-rewrite-h! hq ql qv)
