            (dk-have! (list '< (list '- 'PI) rz) (lambda () (dk-ineq! ab (dk-ctx-form (list '<= (list '- (list 'abs rz)) rz)) '(< 3 PI) (list '<= mz 1/2))))
            (dk-have! (list '< rz 'PI) (lambda () (dk-ineq! ab (dk-ctx-form (list '<= rz (list 'abs rz))) '(< 3 PI) (list '<= mz 1/2))))
            (c6-cite! 'cc-log-exp z)
            (dk-ass!))))))
(qed 'cc-log-exp-small)

;;; |w| <= 1/2 in context: 1 - w is in dom log (Re(1 - w) >= 1/2), log(1 - w) in CC
(define (c6w-one-minus-log! w)
  (let ((u (list '- 1 w)))
    (if (not (dk-asm? (list 'IN (list 'CC-LOG u) 'CC)))
        (let* ((rs (c6-cite! 'cc-re-sub 1 w)) (r1 (begin (fact 'rr-one-in) (c6-cite! 'cc-re-of-real 1))) (re (c6-cite! 'cc-abs-re-le-magnitude w)))
          (fact 'cc-one-in) (c6-cc! u) (c6-mag! w)
          (fact 'real-part-in-rr w) (fact 'real-part-in-rr u) (fact 'rr-abs-closed (list 'real-part w)) (c6-cite! 'rr-le-abs (list 'real-part w))
          (dk-have! (list '< 0 (list 'real-part u))
            (lambda () (c6-ineq*! (dk-rewrite-h! rs (list 'real-part 1) 1) re (dk-ctx-form (list '<= (list 'real-part w) (list 'abs (list 'real-part w))))
                                  (list '<= (list 'magnitude w) 1/2))))
          (dk-have! (list 'NOT (list '<= (list 'real-part u) 0))
            (lambda () (di) (dk-absurd! (list '< 0 (list 'real-part u)) (list '<= (list 'real-part u) 0))))
          (dk-have! (c6-slit u) (lambda () (keep (list 'NOT (list '<= (list 'real-part u) 0))) (prop)))
          (dk-split-all! (list (c6-cite! 'cc-log-spec u)))))))
;;; |w| <= 1/2: E_n(w) = exp(log(1 - w) + Q_n(w))
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6z_ (list 'IMPLIES '(IN c6z_ CC) (list 'IMPLIES '(<= (magnitude c6z_) 1/2)
  (list '= (c6w-e 'c6n_ 'c6z_) (list 'CC-EXP (list '+ '(CC-LOG (- 1 c6z_)) (c6w-qs 'c6z_ '(succ c6n_))))))))))))
(let* ((new (c6-steps!)) (n (c6-var new 'NN)) (w (c6-var new 'CC)) (m (list 'succ n)) (q (c6w-qs w m))
       (u (list '- 1 w)) (lg (list 'CC-LOG u)))
  (c6w-cc-setup!) (fact 'nn-succ-closed n) (c6w-coef-typ! w) (dk-cite! 'cc-series-partial-sum-in-cc m (c6w-coef w))
  (c6-cc! u) (c6-mag! w)
  (c6w-one-minus-log! w)
  (c6w-exp-typ! q)
  (subst (c6-cite! 'cc-exp-add lg q))
  (subst (c6-cite! 'cc-exp-log u))
  (c6f-rfl-close!))
(qed 'weier-e-exp)

;;; E_n(w) = 0 exactly when w = 1
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6z_ (list 'IMPLIES '(IN c6z_ CC)
  (list 'IFF (list '= (c6w-e 'c6n_ 'c6z_) 0) '(= c6z_ 1))))))))
(let* ((new (c6-steps!)) (n (c6-var new 'NN)) (w (c6-var new 'CC)) (m (list 'succ n)) (q (c6w-qs w m))
       (u (list '- 1 w)) (eq (list 'CC-EXP q)))
  (c6w-cc-setup!) (fact 'nn-succ-closed n) (c6w-coef-typ! w) (dk-cite! 'cc-series-partial-sum-in-cc m (c6w-coef w))
  (c6-cc! u) (c6w-exp-typ! q) (c6-cite! 'cc-exp-nonzero q)
  (dk-iff! (lambda (g) (equal? g (list '= w 1)))
    (lambda ()
      (c6-cite! 'cc-mul-zero-left u eq)
      (dk-have! (list '= w (list '- 1 u)) (lambda () (crs)))
      (subst (list '= w (list '- 1 u))) (subst (list '= u 0)) (crs))
    (lambda ()
      (let ((v (dk-name! eq 'CC)))
        (subst (list '= eq v)) (subst (list '= w 1)) (crs)))))
(qed 'weier-e-zero-iff)

;;; |w| <= 1/4: E_m(w) is in dom log and |log E_m(w)| <= 2 |w|^{m+1} / (m + 1)
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6z_ (list 'IMPLIES '(IN c6z_ CC) (list 'IMPLIES '(<= (magnitude c6z_) 1/4)
  (list 'AND (c6-slit (c6w-e 'c6n_ 'c6z_))
             (list '<= (list 'magnitude (list 'CC-LOG (c6w-e 'c6n_ 'c6z_))) (c6w-tb 'c6z_ '(succ c6n_)))))))))))
(let* ((new (c6-steps!)) (n (c6-var new 'NN)) (w (c6-var new 'CC))
       (st (c6w-tail-setup! n w)) (m (car st)) (r (cadr st)) (t (caddr st)) (bb (cadddr st))
       (q (c6w-qs w m)) (lg (list 'CC-LOG (list '- 1 w))) (rr (list '+ lg q)) (e (c6w-e n w)))
  (dk-have! (list '<= r 1/2) (lambda () (dk-ineq! (list '<= r 1/4))))
  (let ((tb (c6-cite! 'log-series-tail n w)))
    (dk-cite! 'cc-series-partial-sum-in-cc m (c6w-coef w))
    (c6-cc! (list '- 1 w))
    (c6-cite! 'weier-e-exp n w)
    (c6w-one-minus-log! w)
    ;; |R| <= 1/2
    (let* ((rs (list 'recip m)) (rm1 (begin (fact 'rr-recip-one) (dk-have! (list '<= 1 m) (lambda () (fact 'nn-zero-le n) (fact 'nn-succ-plus-one n) (dk-ineq! (list '<= 0 n) (list '= m (list '+ n 1)))))
                                       (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
                                       (dk-rewrite-h! (c6-cite! 'rr-recip-antitone 1 m) (list 'recip 1) 1)))
           (ps (begin (c6-and! (list 'IN r 'CC) (list 'IN n 'NN)) (dk-fact! 'power-succ r n)))
           (pn (begin (fact 'power-real-closed r n) (fact 'rr-power-nonneg n r)))
           (k1 (begin (dk-have! (list '<= r 1) (lambda () (dk-ineq! (list '<= r 1/4)))) (c6-and! (list '<= 0 r) (list '<= r 1)) (c6-cite! 'rr-power-le-one n r)))
           (k2 (c6-cite! 'rr-mul-le-right (list 'power r n) 1 r))
           (k3 (c6-cite! 'rr-mul-le-right rs 1 t)))
      (dk-have! (list '= (list '* 1 r) r) (lambda () (crs))) (dk-have! (list '= (list '* 1 t) t) (lambda () (crs)))
      (dk-have! (list '= (list '* (list 'power r n) r) (list '* r (list 'power r n))) (lambda () (crs)))
      (dk-have! (list '= (list '* rs t) (list '* t rs)) (lambda () (crs)))
      (c6-cc! rr) (c6-mag! rr)
      (dk-have! (list '<= (list 'magnitude rr) 1/2)
        (lambda () (c6-ineq*! tb ps k2 k3 (list '= (list '* 1 r) r) (list '= (list '* 1 t) t) (list '= (list '* (list 'power r n) r) (list '* r (list 'power r n)))
                              (list '= (list '* rs t) (list '* t rs)) (list '<= r 1/4)))))
    (c6-cc! rr)
    (dk-split-all! (list (c6-cite! 'cc-log-exp-small rr)))
    (subst (list '= e (list 'CC-EXP rr)))
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal)) (dk-ass!)
          (begin (subst (list '= (list 'CC-LOG (list 'CC-EXP rr)) rr)) (dk-ass!)))))))
(qed 'weier-factor-log-bound)

;;; the factor 1 + (E_m(z / a) - 1) vanishes exactly at z = a
(sp (make-wff (list 'FORALL 'c6n_ (list 'IMPLIES '(IN c6n_ NN) (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ CC) (list 'IMPLIES '(NOT (= c6a_ 0))
  (list 'FORALL 'c6z_ (list 'IMPLIES '(IN c6z_ CC)
    (list 'IFF (list '= (list '+ 1 (list '- (c6w-e 'c6n_ '(* c6z_ (recip c6a_))) 1)) 0) '(= c6z_ c6a_)))))))))))
(let* ((new (c6-steps!)) (n (c6-var new 'NN)) (zs (c6-vars new 'CC))
       (a (cadr (cadr (find-first (lambda (q) (dk-head-is? q 'NOT)) new)))) (z (find-first (lambda (v) (not (eq? v a))) zs))
       (ra (list 'recip a)) (w (list '* z ra)) (e (c6w-e n w)))
  (c6w-cc-setup!) (fact 'nn-succ-closed n)
  (c6-and! (list 'IN a 'CC) (list 'NOT (list '= a 0))) (fact 'cc-recip-closed a) (fact 'cc-recip-inverse a)
  (c6f-cc-and-closed! 'cc-mul-closed z ra)
  (c6w-coef-typ! w) (dk-cite! 'cc-series-partial-sum-in-cc (list 'succ n) (c6w-coef w)) (c6w-exp-typ! (c6w-qs w (list 'succ n)))
  (c6-cc! (list '- 1 w)) (c6f-cc-and-closed! 'cc-mul-closed (list '- 1 w) (list 'CC-EXP (c6w-qs w (list 'succ n))))
  (let* ((v (dk-name! e 'CC)) (zi (c6-cite! 'weier-e-zero-iff n w)) (wz (list 'IFF (list '= w 1) (list '= z a))))
    (dk-have! (list '= (list '+ 1 (list '- e 1)) e) (lambda () (subst (list '= e v)) (crs)))
    (subst (list '= (list '+ 1 (list '- e 1)) e))
    (dk-have! wz
      (lambda ()
        (dk-iff! (lambda (g) (equal? g (list '= z a)))
          (lambda ()
            (let* ((rv (dk-name! ra 'CC))
                   (i1 (dk-rewrite-h! (list '= (list '* a ra) 1) ra rv))
                   (h1 (dk-rewrite-h! (list '= w 1) ra rv))
                   (g0 (list '= (list '* (list '* z rv) a) (list '* z (list '* a rv)))))
              (dk-have! g0 (lambda () (crs)))
              (let ((g2 (dk-rewrite-h! (dk-rewrite-h! g0 (list '* a rv) 1) (list '* z rv) 1)))
                (dk-have! (list '= z (list '* z 1)) (lambda () (crs)))
                (dk-have! (list '= a (list '* 1 a)) (lambda () (crs)))
                (subst (list '= z (list '* z 1))) (subst (list '= a (list '* 1 a)))
                (subst g2) (c6f-rfl-close!))))
          (lambda () (subst (list '= z a)) (dk-ass!)))))
    (keep zi wz) (prop)))
(qed 'weier-factor-zero-iff)

;;; |x| <= r, 4 (r + 1) <= |a|: |x / a| <= 1/4 and |x / a| <= r / |a|
(sp (make-wff '(FORALL c6a_ (IMPLIES (IN c6a_ CC) (IMPLIES (NOT (= c6a_ 0)) (FORALL c6r_ (IMPLIES (IN c6r_ RR) (IMPLIES (<= 0 c6r_)
  (IMPLIES (<= (* 4 (+ c6r_ 1)) (magnitude c6a_)) (FORALL c6z_ (IMPLIES (IN c6z_ CC) (IMPLIES (<= (magnitude c6z_) c6r_)
    (AND (<= (magnitude (* c6z_ (recip c6a_))) 1/4) (<= (magnitude (* c6z_ (recip c6a_))) (* c6r_ (recip (magnitude c6a_)))))))))))))))))
(let* ((new (c6-steps!)) (r (c6-var new 'RR))
       (a (cadr (cadr (find-first (lambda (q) (dk-head-is? q 'NOT)) new)))) (z (find-first (lambda (v) (not (eq? v a))) (c6-vars new 'CC)))
       (ra (list 'recip a)) (ma (list 'magnitude a)) (rma (list 'recip ma)) (mz (list 'magnitude z)) (w (list '* z ra)))
  (c6w-cc-setup!) (c6-mag! a) (c6-mag! z)
  (c6-and! (list 'IN a 'CC) (list 'NOT (list '= a 0))) (fact 'cc-recip-closed a) (c6f-cc-and-closed! 'cc-mul-closed z ra) (c6-mag! w) (c6-mag! ra)
  (dk-have! (list '< 0 ma) (lambda () (dk-ineq! (list '<= (list '* 4 (list '+ r 1)) ma) (list '<= 0 r))))
  (c6-cite! 'rr-pos-ne-zero ma) (c6-and! (list 'IN ma 'RR) (list 'NOT (list '= ma 0))) (fact 'rr-recip-closed ma) (c6-cite! 'rr-recip-pos ma)
  (fact 'rr-recip-inverse ma)
  (dk-have! (list '<= 0 rma) (lambda () (dk-ineq! (list '< 0 rma))))
  (c6-and! (list 'IN z 'CC) (list 'IN ra 'CC))
  (let* ((cv (begin (c6-cite! 'aif-magnitude-recip a) (dk-name! (list 'magnitude w) 'RR)))
         (e0 (dk-rewrite-h! (dk-rewrite-h! (dk-fact! 'cc-magnitude-mul z ra) (list 'magnitude w) cv) (list 'magnitude ra) rma))
         (k1 (c6-cite! 'rr-mul-le-right mz r rma))
         (q4 (list '* 1/4 ma)))
    (c6-rr! q4)
    (dk-have! (list '<= r q4) (lambda () (dk-ineq! (list '<= (list '* 4 (list '+ r 1)) ma))))
    (let ((k2 (c6-cite! 'rr-mul-le-right r q4 rma))
          (e2 (list '= (list '* q4 rma) (list '* 1/4 (list '* ma rma)))))
      (dk-have! e2 (lambda () (dk-crs-opaque!)))
      (dk-have! (list '= (list '* mz rma) (list '* mz rma)) (lambda () (c6f-rfl-close!)))
      (dk-conj-close!
        (lambda () (c6-ineq*! e0 k1 k2 e2 (list '= (list '* ma rma) 1) (list '= cv (list 'magnitude w))))))))
(qed 'weier-ratio-bound)

(define (c6w-nn-redex? g)                      ; a redex whose operator is a lambda over NN
  (and (pair? g) (or (and (pair? (car g)) (eq? (car (car g)) 'VNB-LAMBDA) (eq? (caddr (car g)) 'NN)) (any-pred c6w-nn-redex? g))))
(define (c6w-sup-arg g) (cond ((not (pair? g)) #f) ((and (eq? (car g) 'CC-SUP-NORM) (= (length g) 3)) (cadr g)) (#t (c6-first-map c6w-sup-arg g))))
;;; the IS-NORMALLY-CONVERGENT clause of the log side of 6.16 for the Weierstrass family on K_n (focus goal)
(define (c6w-inc! a mu n nv kn lgf h167 pt! fe!)
  (let* ((fam (c6w-fam a mu))
         (gb (lambda (k) (list '* (list 'power (list '* n (list 'recip (list 'magnitude (list a k)))) (list 'succ (list mu k))) (list 'recip (list 'succ (list mu k))))))
         (gl (list 'VNB-LAMBDA 'c6k_ 'NN (gb 'c6k_)))
         (tl (list 'VNB-LAMBDA 'c6k_ 'NN (gb (list '+ nv 'c6k_))))
         (h2 (list 'VNB-LAMBDA 'c6k_ 'NN (list '* 2 (gb (list '+ nv 'c6k_)))))
         (gtyp! (lambda (k)                       ; G(k) real, >= 0
                  (let* ((ma (list 'magnitude (list a k))) (rma (list 'recip ma)) (b (list '* n rma)) (m (list 'succ (list mu k))))
                    (fact 'fun-apply-type-c a 'NN 'CC k) (fact 'fun-apply-type-c mu 'NN 'NN k) (dk-apply! (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'NOT) (dk-contains? q a))) (dk-asms)) k)
                    (c6-mag! (list a k)) (fact 'nn-succ-closed (list mu k)) (c6-nn! m)
                    (let ((iff (c6-cite! 'cc-magnitude-zero-iff (list a k))))
                      (dk-have! (list 'NOT (list '= ma 0)) (lambda () (keep iff (list 'NOT (list '= (list a k) 0))) (prop))))
                    (c6-and! (list 'IN ma 'RR) (list 'NOT (list '= ma 0))) (fact 'rr-recip-closed ma)
                    (dk-have! (list '<= 0 rma) (lambda () (dk-have! (list 'NOT (list '= 0 ma)) (lambda () (di) (dk-have! (list '= ma 0) (lambda () (subst (list '= 0 ma)) (c6f-rfl-close!))) (ai (list 'NOT (list '= ma 0)))))
                                                          (c6-and! (list '<= 0 ma) (list 'NOT (list '= 0 ma))) (c6-cite! 'rr-le-ne-lt 0 ma) (c6-cite! 'rr-recip-pos ma) (dk-ineq! (list '< 0 rma))))
                    (c6-rr! b) (c6f-rr-mul-nonneg! n rma) (fact 'power-real-closed b m) (fact 'power-closed-at m b) (c6-rr! (list 'power b m)) (fact 'rr-power-nonneg m b)
                    (dk-have! (list '< 0 m) (lambda () (fact 'nn-zero-le (list mu k)) (c6-nn! (list mu k)) (fact 'nn-succ-plus-one (list mu k))
                                                 (dk-ineq! (list '<= 0 (list mu k)) (list '= m (list '+ (list mu k) 1)))))
                    (c6-cite! 'rr-pos-ne-zero m) (c6-and! (list 'IN m 'RR) (list 'NOT (list '= m 0))) (fact 'rr-recip-closed m) (c6-cite! 'rr-recip-pos m)
                    (dk-have! (list '<= 0 (list 'recip m)) (lambda () (dk-ineq! (list '< 0 (list 'recip m)))))
                    (c6w-mul-nonneg! (list 'power b m) (list 'recip m)) (c6-rr! (gb k))
                    (gb k))))
         (bnd! (lambda (j)                        ; ||lk||_{K_n} real, >= 0, <= 2 G(N + j), lk read off the focus goal
                 (let* ((k (c6-nk! nv j)) (lk (c6w-sup-arg (dk-goal))) (hb (list '* 2 (gb k))))
                   (if (not (dk-asm? (list '<= (list 'CC-SUP-NORM lk kn) hb)))
                       (begin
                         (gtyp! k) (c6-rr! hb)
                         (dk-have! (list '<= 0 hb) (lambda () (dk-ineq! (list '<= 0 (gb k)))))
                         (let ((lx! (lambda (x)        ; the point facts; returns (e w m)
                                      (let* ((r (pt! k x)) (w (car r)) (mk (cadr r)) (e (c6w-e mk w)))
                                        (c6w-e-typ! mk w)
                                        (dk-split-all! (list (c6-cite! 'cc-log-spec e)))
                                        (let ((v (dk-name! e 'CC))) (dk-have! (list '= (list '+ 1 (list '- e 1)) e) (lambda () (subst (list '= e v)) (crs))))
                                        (list e w (list 'succ mk))))))
                           (dk-have! (list 'FORALL 'c6v_ (list 'IMPLIES (list 'IN 'c6v_ kn) (list 'IN (list lk 'c6v_) 'CC)))
                             (lambda () (let* ((x (dk-di-var!)) (r (lx! x)) (e (car r)))
                                          (dk-lam-b!) (subst (fe! k x)) (subst (list '= (list '+ 1 (list '- e 1)) e)) (dk-ass!))))
                           (dk-have! (list 'FORALL 'c6v_ (list 'IMPLIES (list 'IN 'c6v_ kn) (list '<= (list 'magnitude (list lk 'c6v_)) hb)))
                             (lambda () (let* ((x (dk-di-var!)) (r (lx! x)) (e (car r)) (w (cadr r)) (m (caddr r))
                                               (mw (list 'magnitude w)) (b (list '* n (list 'recip (list 'magnitude (list a k))))))
                                          (dk-lam-b!) (subst (fe! k x)) (subst (list '= (list '+ 1 (list '- e 1)) e))
                                          (c6-mag! w) (fact 'power-real-closed mw m) (c6-mag! (list 'CC-LOG e))
                                          (let* ((pm (c6-cite! 'rr-power-mono-base m mw b))
                                                 (k1 (c6-cite! 'rr-mul-le-right (list 'power mw m) (list 'power b m) (list 'recip m))))
                                            (c6-ineq*! (dk-ctx-form (list '<= (list 'magnitude (list 'CC-LOG e)) (c6w-tb w m))) k1)))))
                           (dk-split-all! (list (c6-cite! 'cc-sup-norm-bound lk kn hb))))))
                   (list k lk hb)))))
    (dk-apply! h167 n)
    (mac 'IS-NORMALLY-CONVERGENT)
    (let ((sg (cadr (caddr (dk-goal)))))
      (c6-lam-typ! sg 'RR (lambda (j) (c6-nk! nv j) (if (c6w-nn-redex? (dk-goal)) (dk-lam-b!)) (dk-close-if! (lambda () (bnd! j)) (lambda () (dk-ass!)))))
      (dk-have! (c6-nonneg sg) (lambda () (let ((j (dk-di-var!))) (c6-nk! nv j) (if (c6w-nn-redex? (dk-goal)) (dk-lam-b!)) (dk-close-if! (lambda () (bnd! j)) (lambda () (dk-ass!))))))
      (c6-lam-typ! gl 'RR (lambda (k) (c6-nn! k) (gtyp! k)))
      (dk-have! (c6-nonneg gl) (lambda () (let ((k (dk-di-var!))) (gtyp! k) (c6f-lb-close!))))
      (c6-lam-typ! tl 'RR (lambda (j) (gtyp! (c6-nk! nv j))))
      (c6-lam-typ! h2 'RR (lambda (j) (let ((k (c6-nk! nv j))) (gtyp! k) (c6-rr! (list '* 2 (gb k))))))
      (dk-have! (c6f-tl-eq tl gl nv) (lambda () (let* ((j (dk-di-var!)) (k (c6-nk! nv j))) (gtyp! k) (c6f-lb!) (c6f-rfl-close!))))
      (c6-cite! 'rseries-tail-converges nv gl tl)
      (dk-have! (c6-nonneg tl) (lambda () (let* ((j (dk-di-var!)) (k (c6-nk! nv j))) (gtyp! k) (c6f-lb-close!))))
      (dk-have! '(IN 2 RR) (lambda () (arith))) (dk-have! '(<= 0 2) (lambda () (arith)))
      (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list '= (list h2 'c6j_) (list '* 2 (list tl 'c6j_)))))
        (lambda () (let* ((j (dk-di-var!)) (k (c6-nk! nv j))) (gtyp! k) (c6-rr! (list '* 2 (gb k))) (c6f-lb!) (c6f-rfl-close!))))
      (c6-cite! 'series-scale-converges tl 2 h2)
      (dk-have! (c6-nonneg h2) (lambda () (let* ((j (dk-di-var!)) (k (c6-nk! nv j))) (gtyp! k) (c6f-lb!) (dk-ineq! (list '<= 0 (gb k))))))
      (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES '(<= 0 c6j_) (list '<= (list sg 'c6j_) (list h2 'c6j_)))))
        (lambda () (let* ((nk (c6-steps!)) (j (c6-var nk 'NN))) (c6-nk! nv j) (if (c6w-nn-redex? (dk-goal)) (dk-lam-b!)) (dk-close-if! (lambda () (bnd! j)) (lambda () (dk-ass!))))))
      (c6-cite! 'series-eventually-dominated-converges sg h2 0)
      (dk-conj-close!
        (lambda ()
          (if (dk-asm? (dk-goal)) (dk-ass!)
            (let ((j (dk-di-var!))) (c6-nk! nv j) (if (c6w-nn-redex? (dk-goal)) (dk-lam-b!)) (dk-close-if! (lambda () (bnd! j)) (lambda () (dk-ass!))))))))))

;;; ---------------------------------------------------------------- THEOREM 6.20
(define (c6w-fam a mu) (list 'VNB-LAMBDA 'c6k_ 'NN (c6w-el (list 'recip (list a 'c6k_)) (list mu 'c6k_))))
(define (c6w-h167 a mu)
  (list 'FORALL 'c6r_ (list 'IMPLIES '(IN c6r_ RR) (list 'IMPLIES '(<= 0 c6r_)
    (list 'SERIES-CONVERGES (list 'VNB-LAMBDA 'c6k_ 'NN (list '* (list 'power (list '* 'c6r_ (list 'recip (list 'magnitude (list a 'c6k_)))) (list 'succ (list mu 'c6k_)))
                                                          (list 'recip (list 'succ (list mu 'c6k_))))))))))
(define (c6w-grow a)
  (list 'FORALL 'c6r_ (list 'IMPLIES '(IN c6r_ RR)
    (list 'FORSOME 'c6m_ (list 'AND '(IN c6m_ NN) (list 'FORALL 'c6q_ (list 'IMPLIES '(IN c6q_ NN) (list 'IMPLIES '(<= c6m_ c6q_) (list '<= 'c6r_ (list 'magnitude (list a 'c6q_)))))))))))
(define (c6w-anz a) (list 'FORALL 'c6q_ (list 'IMPLIES '(IN c6q_ NN) (list 'NOT (list '= (list a 'c6q_) 0)))))

;;; the family f_k(x) = E_{mu_k}(x / a_k) - 1, given by its values
(define (c6w-feq f a mu)
  (list 'FORALL 'c6k_ (list 'IMPLIES '(IN c6k_ NN) (list 'FORALL 'c6x_ (list 'IMPLIES '(IN c6x_ CC)
    (list '= (list (list f 'c6k_) 'c6x_) (list '- (c6w-e (list mu 'c6k_) (list '* 'c6x_ (list 'recip (list a 'c6k_)))) 1)))))))
(define (c6w-concl f a)
  (list 'AND (list 'PROD-NORMAL-ON-COMPACTA 'CC f)
    (list 'AND (list 'HOLOMORPHIC-ON 'CC (list 'PROD-FUN 'CC f))
      (list 'FORALL 'c6z_ (list 'IMPLIES '(IN c6z_ CC)
        (list 'IFF (list '= (list (list 'PROD-FUN 'CC f) 'c6z_) 0)
                   (list 'FORSOME 'c6q_ (list 'AND '(IN c6q_ NN) (list '= 'c6z_ (list a 'c6q_))))))))))

;;; THEOREM 6.20, for a family f given by its values f_k(x) = E_{mu_k}(x / a_k) - 1.
(sp (make-wff (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC)) (list 'IMPLIES (c6w-anz 'c6a_) (list 'IMPLIES (c6w-grow 'c6a_)
  (list 'FORALL 'c6u_ (list 'IMPLIES '(IN c6u_ (FUN NN NN)) (list 'IMPLIES (c6w-h167 'c6a_ 'c6u_)
    (list 'FORALL 'c6f_ (list 'IMPLIES '(IN c6f_ (FUN NN (FUN CC CC))) (list 'IMPLIES (c6w-feq 'c6f_ 'c6a_ 'c6u_)
      (c6w-concl 'c6f_ 'c6a_)))))))))))))
(let* ((new (c6-steps!))
       (a (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) '(FUN NN CC)))) new)))
       (mu (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) '(FUN NN NN)))) new)))
       (fam (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) '(FUN NN (FUN CC CC))))) new)))
       (anz (dk-ctx-form (c6w-anz a))) (grow (dk-ctx-form (c6w-grow a))) (h167 (dk-ctx-form (c6w-h167 a mu)))
       (feq (dk-ctx-form (c6w-feq fam a mu)))
       (pf (list 'PROD-FUN 'CC fam))
       (ak! (lambda (k)                       ; a_k, recip a_k, mu_k typed
              (fact 'fun-apply-type-c a 'NN 'CC k) (fact 'fun-apply-type-c mu 'NN 'NN k) (dk-apply! anz k)
              (c6-and! (list 'IN (list a k) 'CC) (list 'NOT (list '= (list a k) 0))) (fact 'cc-recip-closed (list a k))))
       (fe! (lambda (k x) (ak! k) (dk-apply! feq k x)))
       (el-typ! (lambda (c n)                 ; x -> E_n(x c) - 1 in FUN(CC, CC)
                  (c6f-typ-on! (c6w-el c n) 'CC
                    (lambda (x) (let ((xc (list '* x c)))
                                  (c6f-cc-and-closed! 'cc-mul-closed x c) (c6w-e-typ! n xc)
                                  (c6-cc! (list '- (c6w-e n xc) 1)))))))
       (fk-hol! (lambda (k)                   ; HOLOMORPHIC-ON(CC, f_k)
                  (let* ((c (list 'recip (list a k))) (el (c6w-el c (list mu k))))
                    (ak! k) (fact 'fun-apply-type-c fam 'NN '(FUN CC CC) k)
                    (el-typ! c (list mu k))
                    (c6-cite! 'weier-e-holomorphic (list mu k) c)
                    (dk-have! (c6f-ptw 'CC (list fam k) (lambda (y) (list el y)))
                      (lambda () (let ((y (dk-di-var!))) (subst (fe! k y)) (dk-lam-b!) (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
                    (c6-cite! 'holomorphic-transfer-ptwise-eq 'CC (list fam k) el)))))
  (c6w-cc-setup!) (fact 'nn-is-set) (fact 'cc-is-metric-space) (c6-pts!)
  (fact 'carrier-is-open 'CC-MS)
  (dk-have! '(IS-OPEN CC-MS CC) (lambda () (subst '(== CC (PTS CC-MS))) (dk-ass!)))
  (dk-have! '(SUBSET CC CC) (lambda () (let ((iff (dk-cite! 'subset-def 'CC 'CC)))
                                         (dk-have! (caddr iff) (lambda () (dk-di-var!) (dk-ass!)))
                                         (keep iff (caddr iff)) (prop))))
  ;; the family: holomorphic, continuous
  (dk-have! (c6-famhol 'CC fam) (lambda () (let ((k (dk-di-var!))) (dk-close-if! (lambda () (fk-hol! k)) (lambda () (dk-ass!))))))
  (dk-have! (c6f-famcont 'CC fam)
    (lambda () (let ((k (dk-di-var!)))
                 (fk-hol! k)
                 (c6-cite! 'holomorphic-on-continuous 'CC (list fam k))
                 (c6f-cont-close! (list fam k) 'CC))))
  ;; normal convergence on compacta, by Corollary 6.16
  (dk-have! (c6f-logside 'CC fam)
    (lambda ()
      (let* ((n (dk-di-var!)) (kn (c6f-kx 'CC n)) (r1 (list '* 4 (list '+ n 1))))
        (c6-nn! n) (fact 'nn-zero-le n) (c6-rr! r1)
        (let* ((nv (c6-sk! (dk-apply! grow r1)))
               (gr (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q nv) (dk-contains? q 'magnitude))) (dk-asms)))
               (pt! (lambda (k x)                ; k >= N, x in K_n: |w| bounds, guard, |log(1 + f_k(x))| bound
                      (let* ((w (list '* x (list 'recip (list a k)))) (mk (list mu k)))
                        (ak! k) (dk-apply! gr k)
                        (let ((mem (c6-cite! 'cc-exhaust-membership 'CC n x)))
                          (dk-have! (list 'IN x 'CC) (lambda () (keep mem (list 'IN x kn)) (prop)))
                          (dk-have! (list '<= (list 'magnitude x) n) (lambda () (keep mem (list 'IN x kn)) (prop))))
                        (c6f-cc-and-closed! 'cc-mul-closed x (list 'recip (list a k)))
                        (dk-split-all! (list (c6-cite! 'weier-ratio-bound (list a k) n x)))
                        (dk-split-all! (list (c6-cite! 'weier-factor-log-bound mk w)))
                        (list w mk))))
               (lgf (c6f-lgf 'CC fam n nv)))
          (c6-nn! nv)
          (ew nv)
          (dk-conj-close!
            (lambda ()
              (cond
               ((dk-asm? (dk-goal)) (dk-ass!))
               ((dk-head-is? (dk-goal) 'FORALL)
                (let* ((nq (c6-steps!)) (q (find-first (lambda (v) (not (eq? v n))) (c6-vars nq 'NN)))
                       (x (cadr (find-first (lambda (f) (and (c6-op? f 'IN 3) (equal? (caddr f) kn))) nq)))
                       (r (pt! q x)) (e (c6w-e (cadr r) (car r))))
                  (subst (fe! q x))
                  (c6w-e-typ! (cadr r) (car r)) (let ((v (dk-name! e 'CC))) (dk-have! (list '= (list '+ 1 (list '- e 1)) e) (lambda () (subst (list '= e v)) (crs))))
                  (subst (list '= (list '+ 1 (list '- e 1)) e))
                  (dk-ass!)))
               (#t (c6w-inc! a mu n nv kn lgf h167 pt! fe!)))))))))
  (c6-cite! 'corollary-6-16 'CC fam)
  (c6-cite! 'prod-fun-holomorphic 'CC fam)
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (dk-ass!)
        (let* ((z (dk-di-var!)) (ox (c6-opx fam z)) (pv (list 'PROD-VALUE ox)) (fz (list pf z)))
          (c6-lam-typ! ox 'CC (lambda (k) (c6-fv! fam 'CC k z) (c6-cc! (list '+ 1 (list (list fam k) z)))))
          (dk-split-all! (list (c6-cite! 'prop-6-11 'CC fam z)))
          (dk-split-all! (list (c6-cite! 'prod-value-spec ox)))
          (dk-have! (list '= fz pv) (lambda () (mac 'PROD-FUN) (dk-lam-b!) (c6f-rfl-close!)))
          (subst (list '= fz pv))
          (let* ((zx (find-first (lambda (q) (and (dk-head-is? q 'IFF) (dk-contains? q 'c6q_))) (dk-asms)))
                 (ex (caddr zx)) (tg (caddr (dk-goal))))
            (dk-have! (list 'IFF ex tg)
              (lambda ()
                (dk-iff! (lambda (g) (equal? g tg))
                  (lambda ()
                    (let* ((q (c6-sk! ex)) (eqi (fe! q z)) (e0 (list '= (list '+ 1 (list (list fam q) z)) 0))
                           (red (dk-rewrite-h! e0 (list (list fam q) z) (list '- (c6w-e (list mu q) (list '* z (list 'recip (list a q)))) 1)))
                           (zi (c6-cite! 'weier-factor-zero-iff (list mu q) (list a q) z)))
                      (dk-have! (list '= z (list a q)) (lambda () (keep zi red) (prop)))
                      (ew q) (dk-conj-close! (lambda () (dk-ass!)))))
                  (lambda ()
                    (let* ((q (c6-sk! tg)) (eqi (fe! q z)) (zi (c6-cite! 'weier-factor-zero-iff (list mu q) (list a q) z)))
                      (ew q)
                      (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!)
                                                   (begin (subst eqi) (keep zi (list '= z (list a q))) (prop))))))))))
            (keep zx (list 'IFF ex tg)) (prop)))))))
(qed 'theorem-6-20-family)

;;; THEOREM 6.20.  a_k /= 0, |a_k| -> oo, mu_k in NN with sum_k (R / |a_k|)^{mu_k + 1} / (mu_k + 1) < oo for every
;;; R >= 0: the product prod_k E_{mu_k}(z / a_k) (factors written 1 + f_k) is normally convergent on compact subsets
;;; of C, its value is entire, and it vanishes exactly at the points a_k.
(sp (make-wff (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC)) (list 'IMPLIES (c6w-anz 'c6a_) (list 'IMPLIES (c6w-grow 'c6a_)
  (list 'FORALL 'c6u_ (list 'IMPLIES '(IN c6u_ (FUN NN NN)) (list 'IMPLIES (c6w-h167 'c6a_ 'c6u_)
    (c6w-concl (c6w-fam 'c6a_ 'c6u_) 'c6a_))))))))))
(let* ((new (c6-steps!))
       (a (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) '(FUN NN CC)))) new)))
       (mu (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) '(FUN NN NN)))) new)))
       (anz (dk-ctx-form (c6w-anz a))) (fam (c6w-fam a mu))
       (ak! (lambda (k) (fact 'fun-apply-type-c a 'NN 'CC k) (fact 'fun-apply-type-c mu 'NN 'NN k) (dk-apply! anz k)
                        (c6-and! (list 'IN (list a k) 'CC) (list 'NOT (list '= (list a k) 0))) (fact 'cc-recip-closed (list a k)))))
  (c6w-cc-setup!) (fact 'nn-is-set)
  (c6-lam-typ! fam '(FUN CC CC)
    (lambda (k) (ak! k)
      (c6f-typ-on! (c6w-el (list 'recip (list a k)) (list mu k)) 'CC
        (lambda (x) (let ((xc (list '* x (list 'recip (list a k)))))
                      (c6f-cc-and-closed! 'cc-mul-closed x (list 'recip (list a k))) (c6w-e-typ! (list mu k) xc)
                      (c6-cc! (list '- (c6w-e (list mu k) xc) 1)))))))
  (dk-have! (c6w-feq fam a mu)
    (lambda () (let* ((nk (c6-steps!)) (k (c6-var nk 'NN)) (x (begin (ak! k) (c6-var nk 'CC))) (xc (list '* x (list 'recip (list a k)))))
                 (c6f-cc-and-closed! 'cc-mul-closed x (list 'recip (list a k))) (c6w-e-typ! (list mu k) xc)
                 (c6-cc! (list '- (c6w-e (list mu k) xc) 1))
                 (dk-lam-b!) (c6f-rfl-close!))))
  (c6-cite! 'theorem-6-20-family a mu fam)
  (dk-ass!))
(qed 'theorem-6-20)

  
