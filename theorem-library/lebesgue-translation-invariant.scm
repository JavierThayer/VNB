;;; ====================================================================
;;; theorem-library/lebesgue-translation-invariant.scm -- MEASURE-5-A, 2026-10-10.
;;; A translation-invariant Borel measure on the line with 0 < mu([0, 1]) = k < +inf
;;; is k times Lebesgue measure on the Borel sets.
;;;
;;; Notation as in lebesgue-measure-unique.scm: lam* = METHOD-I-OUTER(RR,
;;; CLOSED-INTERVALS, ols_ |-> INTERVAL-LENGTH(ols_)), C = CARATHEODORY-SETS(RR, lam*),
;;; Lebesgue measure lam = RES(lam*, C), the Borel sets BOREL-SETS(RR-MS), and
;;; TRANSLATE(es, c) = { z in RR : z - c in es }.  "mu invariant" below is the
;;; hypothesis: for es Borel and c real, TRANSLATE(es, c) Borel implies
;;; mu(TRANSLATE(es, c)) = mu(es) (the guard is harmless: only intervals are translated).
;;;
;;; THE THEOREMS (every one `modulo 0'):
;;;   translate-ccint                       [a, b] + c = [a + c, b + c]
;;;   invariant-measure-ccint-shift         mu invariant: mu([a, b]) = mu([0, b - a])
;;;   invariant-measure-points-null         mu invariant, mu([0, 1]) real: mu([x, x]) = 0
;;;   null-points-ccint-split               any Borel measure with null points:
;;;                                         mu([a, b]) = mu([a, c]) + mu([c, b]), a <= c <= b
;;;   invariant-measure-ccint-additive      F(s + t) = F(s) + F(t), F(t) = mu([0, t]), s, t >= 0
;;;   translation-invariant-measure-nn      mu([0, 1]) = 1: F(m) = m on NN
;;;   translation-invariant-measure-finite  mu([0, 1]) = 1: F(t) real for t >= 0
;;;   translation-invariant-measure-nn-mul  mu([0, 1]) = 1: F(j s) = j F(s), j in NN, s >= 0
;;;   translation-invariant-measure-ccint-zero   mu([0, 1]) = 1: F(t) = t, t >= 0
;;;   translation-invariant-measure-ccint   mu([0, 1]) = 1: mu([a, b]) = b - a, a <= b
;;;   translation-invariant-measure-lebesgue     mu([0, 1]) = 1: mu = lam on the Borel sets
;;;   lebesgue-translation-invariant        THE COROLLARY: mu invariant, k real, 0 < k,
;;;                                         mu([0, 1]) = k ==> mu(es) = k lam(es), es Borel
;;;
;;; THE ROUTE (MEASURE-4-A report s.6, with one change: the measure is normalised FIRST).
;;;   1. Points are null.  The points recip(n + 1), n in NN, are distinct and lie in
;;;      [0, 1], so by countable additivity mu of their union is ESUM of the constant
;;;      family mu([0, 0]) and is at most mu([0, 1]) < +inf; the tail of a finite ESUM is
;;;      small (esum-nn-tail-small) and every tail of a constant family is the family, so
;;;      ESUM <= eps for all eps > 0 and the constant is 0.
;;;   2. [a, b] splits at c: mu([a, b]) = mu([a, c]) + mu([a, b] \ [a, c]) by finite
;;;      additivity, and [a, b] \ [a, c] sits between [c, b] minus the point c and [c, b].
;;;   3. F(t) = mu([0, t]) is additive (2 + translation).  Normalised (mu([0, 1]) = 1):
;;;      F(m) = m on NN by induction, hence F is real-valued (monotone, archimedean);
;;;      F(j s) = j F(s) by induction; so F(1/q) = 1/q for q = n + 1, F(j/q) = j/q, and for
;;;      j/q <= t < (j+1)/q (rr-nn-floor-mul) the squeeze gives |F(t) - t| <= 1/q, with
;;;      1/q below any eps (recip-succ-small).  So F(t) = t, and mu([a, b]) = b - a.
;;;   4. lebesgue-measure-unique then gives mu = lam on the Borel sets (normalised case).
;;;   5. General k: recip(k) mu is a measure (measure-scale, esum-scale.scm), invariant, of
;;;      unit mass on [0, 1]; so it is lam, and mu = k (recip(k) mu) = k lam.
;;;   The finiteness of k is used (step 1 needs mu([0, 1]) real); it is in "k real".
;;;
;;; LOAD WINDOW: immediately after "theorem-library/lebesgue-measure-unique" (load.scm
;;; 3504), which gives lebesgue-measure-unique, translate-membership, ccint-closed-rr-ms
;;; and rr-closed-borel; measure-scale is theorem-library/esum-scale.scm (after
;;; integral-laws, 3387); esum-nn-tail-small is metric-outer-measure (3492);
;;; esum-nn-term-le outer-measure-construction (3483); measure-monotone and
;;; measure-finitely-additive measure-laws (3386); the real-number lemmas earlier.
;;; Nothing in the tree cites these names.  libraries.sexp: library measure.
;;; ====================================================================

;;; ====================================================================
;;; (0) file-local kit (lti- prefix)
;;; ====================================================================

(define lti-lam '(METHOD-I-OUTER RR CLOSED-INTERVALS (VNB-LAMBDA ols_ CLOSED-INTERVALS (INTERVAL-LENGTH ols_))))
(define lti-cs (list 'CARATHEODORY-SETS 'RR lti-lam))
(define lti-leb (list 'RES lti-lam lti-cs))
(define lti-bor '(BOREL-SETS RR-MS))
(define lti-pw '(POWER RR))
(define (lti-ism m) (list 'IS-MEASURE 'RR lti-bor m))
;;; The bound set is ltv_, not es: the corollary binds es outside this hypothesis, and an inner
;;; binder of the same name is flagged by the case-fold audit (renamed at integration, 2026-10-10).
(define (lti-inv m)
  (forall-guarded '(ltv_ c_) (list (list 'IN 'ltv_ lti-bor) '(IN c_ RR) (list 'IN '(TRANSLATE ltv_ c_) lti-bor))
    (list '= (list m '(TRANSLATE ltv_ c_)) (list m 'ltv_))))
(define (lti-null m)
  (forall-guarded '(x_) '((IN x_ RR)) (list '= (list m '(CCINT x_ x_)) 0)))
(define (lti-disj f)
  (forall-guarded '(i_ j_) '((IN i_ NN) (IN j_ NN) (NOT (= i_ j_)))
    (list '= (list 'INTERSECTION (list f 'i_) (list f 'j_)) 'EMPTY-SET)))
(define (lti-add m)
  (forall-guarded '(f_) (list (list 'IN 'f_ (list 'FUN 'NN lti-bor)) (lti-disj 'f_))
    (list '= (list m '(BIG-UNION n_ NN (f_ n_)))
          (list 'ESUM (list 'VNB-LAMBDA 'n_ 'NN (list m '(f_ n_)))))))
(define (lti-cc0 t) (list 'CCINT 0 t))

;;; an IFF instance used forwards / backwards (as lmu-iff-fwd! / lmu-iff-bwd!)
(define (lti-iff-fwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (ai iff)
    (detach! (list 'IMPLIES (cadr iff) (caddr iff)))
    (if (dk-head-is? (caddr iff) 'AND) (dk-split-all! (list (caddr iff))))
    (caddr iff)))
(define (lti-iff-bwd! thm . args)
  (let ((iff (apply dk-cite! thm args)))
    (if (not (dk-asm? (caddr iff)))
        (dk-have! (caddr iff) (lambda () (dk-conj-close! dk-ass!))))
    (ai iff)
    (detach! (list 'IMPLIES (caddr iff) (cadr iff)))
    (cadr iff)))

;;; the goal (= A B) by class extensionality
(define (lti-class-eq! a b ab ba)
  (let ((ext (list 'FORALL 'ltx_ (list 'IFF (list 'IN 'ltx_ a) (list 'IN 'ltx_ b)))))
    (dk-have! ext
      (lambda ()
        (dk-peel!)
        (let ((xv (cadr (cadr (dk-goal)))))
          (dk-iff! (lambda (g) (equal? g (list 'IN xv b)))
                   (lambda () (ab xv))
                   (lambda () (ba xv))))))
    (fact 'class-extensionality a b)
    (ass)))

;;; (IN t RR) by the typing planner
(define (lti-real! t)
  (if (not (dk-asm? (list 'IN t 'RR)))
      (dk-have! (list 'IN t 'RR) (lambda () (type-term)))))
;;; a claim by `ineq' from the named premises
(define (lti-ineq! claim . prems)
  (if (not (dk-asm? claim))
      (dk-have! claim (lambda () (apply dk-ineq! prems)))))
;;; a lane body: run THUNK, then `ass' while the lane's leaf is still open
(define (lti-lane-ass thunk)
  (dk-lane (lambda () (thunk) (dk-lane-if! ass))))
;;; the conjunction of P ..., each in context
(define (lti-and! . ps)
  (let ((f (let build ((l ps)) (if (null? (cdr l)) (car l) (list 'AND (car l) (build (cdr l)))))))
    (dk-have! f (lambda () (dk-conj-close! dk-ass!)))
    f))
;;; cite THM at ARGS, detach every antecedent (each in context), return the consequent
(define (lti-cite! thm . args)
  (let loop ((r (apply dk-cite! thm args)))
    (if (and (pair? r) (eq? (car r) 'IMPLIES))
        (if (dk-asm? (caddr r))
            (loop (caddr r))
            (loop (dk-landed-1 (lambda () (detach! r)))))
        r)))
;;; (IN (CCINT a b) BOREL-SETS(RR-MS)), a, b real in context
(define (lti-ccbor! a b)
  (let ((f (list 'IN (list 'CCINT a b) lti-bor)))
    (if (not (dk-asm? f))
        (begin (fact 'ccint-closed-rr-ms a b)
               (fact 'rr-closed-borel (list 'CCINT a b))))
    f))
;;; the conjuncts of IS-MEASURE(RR, BOREL-SETS(RR-MS), m)
(define (lti-measure-parts! m)
  (let ((ism (lti-ism m)))
    (if (not (dk-asm? (list 'IS-SIGMA-ALGEBRA 'RR lti-bor)))
        (dk-project! (list 'IS-SIGMA-ALGEBRA 'RR lti-bor) 'IS-MEASURE ism))
    (if (not (dk-asm? (list 'IN m (list 'FUN lti-bor 'RR-POS-STAR))))
        (dk-project! (list 'IN m (list 'FUN lti-bor 'RR-POS-STAR)) 'IS-MEASURE ism))))
;;; (IN (m s) RR-POS-STAR) for s Borel in context
(define (lti-mty! m s)
  (let ((f (list 'IN (list m s) 'RR-POS-STAR)))
    (if (not (dk-asm? f)) (fact 'fun-apply-type-c m lti-bor 'RR-POS-STAR s))
    f))
;;; (IN c RR-POS-STAR) from (IN c RR), (<= 0 c)
(define (lti-rps! c)
  (if (not (dk-asm? (list 'IN c 'RR-POS-STAR)))
      (let ((inst (dk-cite! 'rr-pos-star-membership c)))
        (dk-have! (list 'IN c 'RR-POS-STAR)
          (lambda () (dk-only! inst (list 'IN c 'RR) (list '<= 0 c)) (prop))))))
;;; (IN (etimes x y) RR-POS-STAR) from x, y in RR-POS-STAR
(define (lti-et! x y)
  (let ((ty (list 'IN (list 'etimes x y) 'RR-POS-STAR)))
    (if (not (dk-asm? ty))
        (begin (lti-and! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR))
               (fact 'etimes-closed x y)))
    ty))
;;; x <= y between members of [0, +inf] (monotonicity of m on Borel sets x subset y)
(define (lti-mono! m x y)
  (lti-cite! 'measure-monotone 'RR lti-bor m x y))

;;; ====================================================================
;;; (1) the translate of a closed interval
;;; ====================================================================

(sp (make-wff (forall-guarded '(a_ b_ c_) '((IN a_ RR) (IN b_ RR) (IN c_ RR))
   '(= (TRANSLATE (CCINT a_ b_) c_) (CCINT (+ a_ c_) (+ b_ c_))))))
(dk-peel!)
(lti-real! '(+ a_ c_))
(lti-real! '(+ b_ c_))
(lti-class-eq! '(TRANSLATE (CCINT a_ b_) c_) '(CCINT (+ a_ c_) (+ b_ c_))
  (lambda (xv)
    (let ((y (list '- xv 'c_)))
      (lti-iff-fwd! 'translate-membership '(CCINT a_ b_) 'c_ xv)
      (lti-iff-fwd! 'ccint-membership 'a_ 'b_ y)
      (let ((ps (list (list 'IN xv 'RR) '(IN a_ RR) '(IN b_ RR) '(IN c_ RR) (list '<= 'a_ y) (list '<= y 'b_))))
        (apply lti-ineq! (list '<= '(+ a_ c_) xv) ps)
        (apply lti-ineq! (list '<= xv '(+ b_ c_)) ps))
      (lti-iff-bwd! 'ccint-membership '(+ a_ c_) '(+ b_ c_) xv)
      (ass)))
  (lambda (xv)
    (let ((y (list '- xv 'c_)))
      (lti-iff-fwd! 'ccint-membership '(+ a_ c_) '(+ b_ c_) xv)
      (lti-real! y)
      (let ((ps (list (list 'IN xv 'RR) '(IN a_ RR) '(IN b_ RR) '(IN c_ RR) (list '<= '(+ a_ c_) xv) (list '<= xv '(+ b_ c_)))))
        (apply lti-ineq! (list '<= 'a_ y) ps)
        (apply lti-ineq! (list '<= y 'b_) ps))
      (lti-iff-bwd! 'ccint-membership 'a_ 'b_ y)
      (lti-iff-bwd! 'translate-membership '(CCINT a_ b_) 'c_ xv)
      (ass))))
(qed 'translate-ccint)
(topic! 'translate-ccint 'plumbing)

;;; ====================================================================
;;; (2) an invariant measure gives [a, b] the measure of [0, b - a]
;;; ====================================================================

(sp (make-wff (forall-guarded '(mu a_ b_) (list (lti-ism 'mu) (lti-inv 'mu) '(IN a_ RR) '(IN b_ RR))
   '(= (mu (CCINT a_ b_)) (mu (CCINT 0 (- b_ a_)))))))
(dk-peel!)
(let* ((w '(- b_ a_))
       (es0 (lti-cc0 w)))
  (lti-real! w)
  (lti-real! 0)
  (lti-ccbor! 0 w)
  (lti-ccbor! 'a_ 'b_)
  (let* ((e0 (dk-cite! 'translate-ccint 0 w 'a_))
         (_ (lti-ineq! '(= (+ 0 a_) a_) '(IN a_ RR)))
         (_ (lti-ineq! (list '= (list '+ w 'a_) 'b_) '(IN a_ RR) '(IN b_ RR)))
         (e1 (dk-rewrite-h! e0 '(+ 0 a_) 'a_))
         (e2 (dk-rewrite-h! e1 (list '+ w 'a_) 'b_))
         (tr (cadr e2)))
    (dk-have! (list 'IN tr lti-bor) (lambda () (subst e2) (ass)))
    (let ((iv (dk-apply! (lti-inv 'mu) es0 'a_)))
      (dk-rewrite-h! iv tr '(CCINT a_ b_))
      (ass))))
(qed 'invariant-measure-ccint-shift)
(topic! 'invariant-measure-ccint-shift 'inequalities)
;;; ====================================================================
;;; (3) points are null for an invariant measure finite on [0, 1]
;;; ====================================================================

;;; with k in NN in context: land the facts of r = recip(k + 1) -- real, 0 < r,
;;; 0 <= r, r <= 1 -- and return r
(define (lti-rk! k)
  (let* ((k1 (list '+ k 1)) (r (list 'recip k1)))
    (if (not (dk-asm? (list '<= r 1)))
        (begin
          (fact 'nn-in-rr k)
          (fact 'nn-zero-le k)
          (lti-real! k1)
          (lti-real! 1)
          (lti-real! 0)
          (lti-ineq! (list '< 0 k1) (list 'IN k 'RR) (list '<= 0 k))
          (lti-ineq! (list '<= 1 k1) (list 'IN k 'RR) (list '<= 0 k))
          (lti-ineq! '(< 0 1))
          (dk-have! (list 'NOT (list '= k1 0)) (lambda () (di) (dk-absurd! (list '= k1 0) (list '< 0 k1))))
          (lti-and! (list 'IN k1 'RR) (list 'NOT (list '= k1 0)))
          (fact 'rr-recip-closed k1)
          (fact 'rr-recip-pos k1)
          (lti-ineq! (list '<= 0 r) (list '< 0 r))
          (fact 'rr-recip-one)
          (let ((an (lti-cite! 'rr-recip-antitone 1 k1)))
            (dk-rewrite-h! an '(recip 1) 1))))
    r))

;;; m invariant (hypotheses in context), x real: land (= (m (CCINT x x)) (m (CCINT 0 0)))
(define (lti-pt! m x)
  (let ((f (list '= (list m (list 'CCINT x x)) (list m (lti-cc0 0)))))
    (if (not (dk-asm? f))
        (let ((sh (lti-cite! 'invariant-measure-ccint-shift m x x)))
          (lti-ineq! (list '= (list '- x x) 0) (list 'IN x 'RR))
          (dk-rewrite-h! sh (list '- x x) 0)))
    f))

(sp (make-wff (forall-guarded '(mu) (list (lti-ism 'mu) (lti-inv 'mu) (list 'IN (list 'mu (lti-cc0 1)) 'RR))
   (lti-null 'mu))))
(dk-peel!)
(let* ((g0 (dk-goal))
       (xv (cadr (cadr (cadr g0))))
       (m0 (list 'mu (lti-cc0 0)))
       (u01 (lti-cc0 1)))
  (lti-measure-parts! 'mu)
  (lti-real! 0)
  (lti-real! 1)
  (lti-ccbor! 0 0)
  (lti-ccbor! 0 1)
  (lti-mty! 'mu (lti-cc0 0))
  (lti-mty! 'mu u01)
  (subst (lti-pt! 'mu xv))
  ;; the points recip(k + 1), k in NN, as a family g of Borel sets
  (let* ((ab (dk-abstract! 'NN lti-bor (lambda (k) (let ((r (list 'recip (list '+ k 1)))) (list 'CCINT r r)))
               (lambda (k) ((lti-lane-ass (lambda () (let ((r (lti-rk! k))) (lti-ccbor! r r))))))))
         (g (car ab))
         (ve (cdr ab))
         (bu (list 'BIG-UNION 'n_ 'NN (list g 'n_)))
         (phi (list 'VNB-LAMBDA 'n_ 'NN (list 'mu (list g 'n_))))
         (pv (list 'FORALL 'ltj_ (list 'IMPLIES '(IN ltj_ NN) (list '= (list phi 'ltj_) m0)))))
    ;; the points are distinct, so the family is disjoint
    (dk-have! (lti-disj g)
      (lambda ()
        (dk-peel!)
        (let* ((g1 (dk-goal))
               (iv (cadr (cadr (cadr g1))))
               (jv (cadr (caddr (cadr g1))))
               (ri (lti-rk! iv))
               (rj (lti-rk! jv)))
          (subst (dk-apply! ve iv))
          (subst (dk-apply! ve jv))
          (lti-class-eq! (list 'INTERSECTION (list 'CCINT ri ri) (list 'CCINT rj rj)) 'EMPTY-SET
            (lambda (zv)
              (lti-iff-fwd! 'intersection-membership (list 'CCINT ri ri) (list 'CCINT rj rj) zv)
              (lti-iff-fwd! 'ccint-membership ri ri zv)
              (lti-iff-fwd! 'ccint-membership rj rj zv)
              (lti-ineq! (list '= ri rj) (list 'IN zv 'RR) (list 'IN ri 'RR) (list 'IN rj 'RR)
                         (list '<= ri zv) (list '<= zv ri) (list '<= rj zv) (list '<= zv rj))
              (let* ((i1 (list '+ iv 1)) (j1 (list '+ jv 1))
                     (e1 (lti-cite! 'rr-recip-recip-pos i1))
                     (e2 (lti-cite! 'rr-recip-recip-pos j1))
                     (e1b (dk-rewrite-h! e1 ri rj)))
                (dk-have! (list 'NOT (list '= rj 0)) (lambda () (di) (dk-absurd! (list '= rj 0) (list '< 0 rj))))
                (lti-and! (list 'IN rj 'RR) (list 'NOT (list '= rj 0)))
                (fact 'rr-recip-closed rj)
                (lti-ineq! (list '= iv jv) e1b e2 (list 'IN (list 'recip rj) 'RR) (list 'IN iv 'RR) (list 'IN jv 'RR))
                (dk-only! (list '= iv jv) (list 'NOT (list '= iv jv)))
                (prop)))
            (lambda (zv)
              (fact 'empty-set-has-no-members zv)
              (dk-only! (list 'IN zv 'EMPTY-SET) (list 'NOT (list 'IN zv 'EMPTY-SET)))
              (prop))))))
    ;; their union lies in [0, 1]
    (fact 'sigma-algebra-union-closed 'RR lti-bor g)
    (lti-mty! 'mu bu)
    (dk-have! (list 'SUBSET bu u01)
      (lambda ()
        (mac 'subset-def)
        (let* ((zv (dk-di-var!))
               (landed (dk-landed (lambda () (bu-me (list 'IN zv bu)))))
               (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
               (ev (cadr ein))
               (r (lti-rk! ev)))
          (dk-apply! ve ev)
          (dk-rewrite-h! (list 'IN zv (list g ev)) (list g ev) (list 'CCINT r r))
          (lti-iff-fwd! 'ccint-membership r r zv)
          (lti-ineq! (list '<= 0 zv) (list '<= 0 r) (list '<= r zv) (list 'IN zv 'RR) (list 'IN r 'RR))
          (lti-ineq! (list '<= zv 1) (list '<= r 1) (list '<= zv r) (list 'IN zv 'RR) (list 'IN r 'RR))
          (lti-iff-bwd! 'ccint-membership 0 1 zv)
          (ass))))
    (lti-mono! 'mu bu u01)
    ;; countable additivity: mu(bu) = ESUM(phi), finite
    (dk-project! (lti-add 'mu) 'IS-MEASURE (lti-ism 'mu))
    (dk-apply! (lti-add 'mu) g)
    (lti-and! (list 'IN (list 'mu bu) 'RR-POS-STAR) (list 'IN (list 'mu u01) 'RR))
    (fact 'rr-pos-star-le-real-in-rr (list 'mu bu) (list 'mu u01))
    (dk-have! (list 'IN (list 'ESUM phi) 'RR)
      (lambda () (subst (list '= (list 'ESUM phi) (list 'mu bu))) (ass)))
    (fact 'nn-is-set)
    (dk-have! (list 'IN phi '(FUN NN RR-POS-STAR))
      (lambda ()
        (dk-lam-type!
          (lambda ()
            (let ((kv (dk-di-var!)))
              (fact 'fun-apply-type-c g 'NN lti-bor kv)
              (lti-mty! 'mu (list g kv))
              (ass)))
          (lambda () (ass)))))
    ;; every term of phi is mu([0, 0])
    (dk-have! pv
      (lambda ()
        (let* ((jv (dk-di-var!))
               (r (lti-rk! jv)))
          (fact 'fun-apply-type-c g 'NN lti-bor jv)
          (lti-mty! 'mu (list g jv))
          (dk-lam-b!)
          (subst (dk-apply! ve jv))
          (lti-pt! 'mu r)
          (ass))))
    ;; m0 <= ESUM(phi), so m0 is real
    (fact 'nn-zero-in)
    (let* ((p0 (dk-apply! pv 0))
           (t0 (lti-cite! 'esum-nn-term-le phi 0))
           (t1 (dk-rewrite-h! t0 (list phi 0) m0)))
      (lti-and! (list 'IN m0 'RR-POS-STAR) (list 'IN (list 'ESUM phi) 'RR))
      (fact 'rr-pos-star-le-real-in-rr m0 (list 'ESUM phi))
      ;; the tails of a finite sum are small, and every tail of phi is phi
      (let ((ts (lti-cite! 'esum-nn-tail-small phi)))
        (dk-have! (list 'FORALL 'ltd_ (list 'IMPLIES '(POS-RR ltd_) (list '<= m0 '(+ 0 ltd_))))
          (lambda ()
            (let* ((landed (dk-peel!))
                   (dv (cadr (car landed))))
              (fact 'rr-pos-rr-in-rr dv)
              (let* ((ex (dk-apply! ts dv))
                     (nv (dk-skolem! ex #t)))
                (dk-split-all!)
                (let* ((fg (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h nv) (dk-contains? h 'ESUM)))
                                    "the tail bound")))
                  (dk-have! (list 'FORALL 'ltj_ (list 'IMPLIES '(IN ltj_ NN)
                                    (list '<= (list phi 'ltj_) (list phi (list '+ nv 'ltj_)))))
                    (lambda ()
                      (let ((jv (dk-di-var!)))
                        (lti-and! (list 'IN nv 'NN) (list 'IN jv 'NN))
                        (fact 'nn-add-closed nv jv)
                        (subst (dk-apply! pv jv))
                        (subst (dk-apply! pv (list '+ nv jv)))
                        (fact 'rr-pos-star-le-refl m0)
                        (ass))))
                  (dk-apply! fg phi)
                  (dk-ineq! (list '<= m0 (list 'ESUM phi)) (list '<= (list 'ESUM phi) dv)
                            (list 'IN m0 'RR) (list 'IN (list 'ESUM phi) 'RR) (list 'IN dv 'RR))))))))
      (lti-cite! 'rr-le-of-le-add-all-pos m0 0)
      (fact 'rr-pos-star-nonneg m0)
      (dk-ineq! (list '<= m0 0) (list '<= 0 m0) (list 'IN m0 'RR)))))
(qed 'invariant-measure-points-null)
(topic! 'invariant-measure-points-null 'inequalities)

;;; ====================================================================
;;; (4) with null points, [a, b] splits at any c in between
;;; ====================================================================

(sp (make-wff (forall-guarded '(mu a_ c_ b_)
   (list (lti-ism 'mu) (lti-null 'mu) '(IN a_ RR) '(IN c_ RR) '(IN b_ RR) '(<= a_ c_) '(<= c_ b_))
   '(= (mu (CCINT a_ b_)) (eplus (mu (CCINT a_ c_)) (mu (CCINT c_ b_)))))))
(dk-peel!)
(lti-measure-parts! 'mu)
(let* ((aa '(CCINT a_ c_)) (bb '(CCINT c_ b_)) (uu '(CCINT a_ b_)) (pp '(CCINT c_ c_))
       (dd (list 'COMPLEMENT-IN uu aa))
       (dp (list 'UNION dd pp)))
  (for-each (lambda (s) (lti-ccbor! (cadr s) (caddr s)) (lti-mty! 'mu s)) (list aa bb uu pp))
  (lti-ineq! '(<= a_ a_) '(IN a_ RR))
  (lti-ineq! '(<= a_ b_) '(<= a_ c_) '(<= c_ b_) '(IN a_ RR) '(IN b_ RR) '(IN c_ RR))
  (lti-cite! 'ccint-subset-ccint 'a_ 'b_ 'a_ 'c_)
  (fact 'sigma-algebra-difference-closed 'RR lti-bor uu aa)
  (lti-mty! 'mu dd)
  ;; mu(U) = mu(A) + mu(D), D = U \ A
  (lti-cite! 'union-complement-in aa uu)
  (fact 'intersection-complement-in-empty aa uu)
  (let ((fa (lti-cite! 'measure-finitely-additive 'RR lti-bor 'mu aa dd)))
    (dk-rewrite-h! fa (list 'UNION aa dd) uu))
  ;; D subset B
  (dk-have! (list 'SUBSET dd bb)
    (lambda ()
      (mac 'subset-def)
      (let ((zv (dk-di-var!)))
        (lti-iff-fwd! 'complement-in-membership uu aa zv)
        (lti-iff-fwd! 'ccint-membership 'a_ 'b_ zv)
        (lti-and! (list 'IN zv 'RR) '(IN c_ RR))
        (let ((orf (lti-cite! 'rr-leq-total zv 'c_)))
          (use-cases (list (cadr orf) (caddr orf))
            (lambda ()
              (lti-iff-bwd! 'ccint-membership 'a_ 'c_ zv)
              (dk-only! (list 'IN zv aa) (list 'NOT (list 'IN zv aa)))
              (prop))
            (lambda ()
              (lti-iff-bwd! 'ccint-membership 'c_ 'b_ zv)
              (ass)))))))
  ;; B subset D u P
  (dk-have! (list 'SUBSET bb dp)
    (lambda ()
      (mac 'subset-def)
      (let ((zv (dk-di-var!)))
        (lti-iff-fwd! 'ccint-membership 'c_ 'b_ zv)
        (use-em (list 'IN zv aa)
          (lambda ()
            (lti-iff-fwd! 'ccint-membership 'a_ 'c_ zv)
            (lti-iff-bwd! 'ccint-membership 'c_ 'c_ zv)
            (dk-have! (list 'OR (list 'IN zv dd) (list 'IN zv pp))
              (lambda () (dk-only! (list 'IN zv pp)) (prop)))
            (lti-iff-bwd! 'union-membership dd pp zv)
            (ass))
          (lambda ()
            (lti-ineq! (list '<= 'a_ zv) '(<= a_ c_) (list '<= 'c_ zv) (list 'IN zv 'RR) '(IN a_ RR) '(IN c_ RR))
            (lti-iff-bwd! 'ccint-membership 'a_ 'b_ zv)
            (lti-iff-bwd! 'complement-in-membership uu aa zv)
            (dk-have! (list 'OR (list 'IN zv dd) (list 'IN zv pp))
              (lambda () (dk-only! (list 'IN zv dd)) (prop)))
            (lti-iff-bwd! 'union-membership dd pp zv)
            (ass))))))
  ;; D n P = empty
  (dk-have! (list '= (list 'INTERSECTION dd pp) 'EMPTY-SET)
    (lambda ()
      (lti-class-eq! (list 'INTERSECTION dd pp) 'EMPTY-SET
        (lambda (zv)
          (lti-iff-fwd! 'intersection-membership dd pp zv)
          (lti-iff-fwd! 'complement-in-membership uu aa zv)
          (lti-iff-fwd! 'ccint-membership 'c_ 'c_ zv)
          (lti-ineq! (list '<= 'a_ zv) '(<= a_ c_) (list '<= 'c_ zv) (list 'IN zv 'RR) '(IN a_ RR) '(IN c_ RR))
          (lti-iff-bwd! 'ccint-membership 'a_ 'c_ zv)
          (dk-only! (list 'IN zv aa) (list 'NOT (list 'IN zv aa)))
          (prop))
        (lambda (zv)
          (fact 'empty-set-has-no-members zv)
          (dk-only! (list 'IN zv 'EMPTY-SET) (list 'NOT (list 'IN zv 'EMPTY-SET)))
          (prop)))))
  (fact 'sigma-algebra-union-closed-2 'RR lti-bor dd pp)
  (lti-mty! 'mu dp)
  (let* ((fa2 (lti-cite! 'measure-finitely-additive 'RR lti-bor 'mu dd pp))
         (nz (dk-apply! (lti-null 'mu) 'c_))
         (fa3 (dk-rewrite-h! fa2 (list 'mu pp) 0))
         (ez (lti-cite! 'eplus-zero-right (list 'mu dd)))
         (fa4 (dk-rewrite-h! fa3 (cadr ez) (caddr ez))))
    (lti-mono! 'mu dd bb)
    (let* ((m2 (lti-mono! 'mu bb dp))
           (m3 (dk-rewrite-h! m2 (list 'mu dp) (list 'mu dd))))
      (lti-and! (list 'IN (list 'mu dd) 'RR-POS-STAR) (list 'IN (list 'mu bb) 'RR-POS-STAR))
      (lti-and! (list '<= (list 'mu dd) (list 'mu bb)) (list '<= (list 'mu bb) (list 'mu dd)))
      (fact 'rr-pos-star-le-antisymm (list 'mu dd) (list 'mu bb))))
  (lti-and! (list 'IN (list 'mu aa) 'RR-POS-STAR) (list 'IN (list 'mu bb) 'RR-POS-STAR))
  (fact 'eplus-closed (list 'mu aa) (list 'mu bb))
  (subst (list '= (list 'mu uu) (list 'eplus (list 'mu aa) (list 'mu dd))))
  (subst (list '= (list 'mu dd) (list 'mu bb)))
  (if (not (proof-done? *ps*)) (rfl)))
(qed 'null-points-ccint-split)
(topic! 'null-points-ccint-split 'inequalities)
;;; ====================================================================
;;; (5) F(t) = mu([0, t]) is additive
;;; ====================================================================

(define (lti-fin m) (list 'IN (list m (lti-cc0 1)) 'RR))
(define (lti-unit m) (list '= (list m (lti-cc0 1)) 1))
;;; with the unit hypothesis in context: land (IN (m [0, 1]) RR)
(define (lti-fin! m)
  (if (not (dk-asm? (lti-fin m)))
      (dk-have! (lti-fin m) (lambda () (subst (lti-unit m)) (type-term)))))
;;; eplus of two reals >= 0 is their sum: land and return (= (eplus x y) (+ x y))
(define (lti-eplus-real! x y)
  (let ((f (list '= (list 'eplus x y) (list '+ x y))))
    (if (not (dk-asm? f))
        (dk-have! f
          (lambda ()
            (lti-cite! 'eplus-real-defined x y)
            (subst (list '= (list 'eplus x y) (list 'binplus x y)))
            (fact 'binplus-apply x y)
            (subst (list '== (list 'binplus x y) (list '+ x y)))
            (lti-real! (list '+ x y))
            (rfl))))
    f))

(sp (make-wff (forall-guarded '(mu s_ t_)
   (list (lti-ism 'mu) (lti-inv 'mu) (lti-fin 'mu) '(IN s_ RR) '(IN t_ RR) '(<= 0 s_) '(<= 0 t_))
   '(= (mu (CCINT 0 (+ s_ t_))) (eplus (mu (CCINT 0 s_)) (mu (CCINT 0 t_)))))))
(dk-peel!)
(lti-measure-parts! 'mu)
(lti-real! 0)
(lti-real! '(+ s_ t_))
(lti-cite! 'invariant-measure-points-null 'mu)
(lti-ineq! '(<= s_ (+ s_ t_)) '(IN s_ RR) '(IN t_ RR) '(<= 0 t_))
(let* ((sp1 (lti-cite! 'null-points-ccint-split 'mu 0 's_ '(+ s_ t_)))
       (sh (lti-cite! 'invariant-measure-ccint-shift 'mu 's_ '(+ s_ t_))))
  (lti-ineq! '(= (- (+ s_ t_) s_) t_) '(IN s_ RR) '(IN t_ RR))
  (let ((sh2 (dk-rewrite-h! sh '(- (+ s_ t_) s_) 't_)))
    (for-each (lambda (b) (lti-ccbor! 0 b) (lti-mty! 'mu (lti-cc0 b))) '(s_ t_))
    (lti-and! (list 'IN '(mu (CCINT 0 s_)) 'RR-POS-STAR) (list 'IN '(mu (CCINT 0 t_)) 'RR-POS-STAR))
    (fact 'eplus-closed '(mu (CCINT 0 s_)) '(mu (CCINT 0 t_)))
    (subst sp1)
    (subst sh2)
    (if (not (proof-done? *ps*)) (rfl))))
(qed 'invariant-measure-ccint-additive)
(topic! 'invariant-measure-ccint-additive 'inequalities)

;;; ====================================================================
;;; (6) normalised by mu([0, 1]) = 1: mu([0, m]) = m on NN, finiteness, multiples
;;; ====================================================================

(sp (make-wff (forall-guarded '(mu) (list (lti-ism 'mu) (lti-inv 'mu) (lti-unit 'mu))
   (forall-guarded '(m_) '((IN m_ NN)) '(= (mu (CCINT 0 m_)) m_)))))
(di)
(let loop () (if (dk-head-is? (dk-goal) 'IMPLIES) (begin (di) (loop))))
(lti-measure-parts! 'mu)
(lti-fin! 'mu)
(lti-real! 0)
(lti-real! 1)
(let ((null (lti-cite! 'invariant-measure-points-null 'mu)))
  (for-each
    (lambda (l)
      (dk-focus! l)
      ((dk-lane (lambda ()
      (if (not (dk-contains? (dk-goal) 'succ))
          (begin (dk-apply! null 0) (ass))
          (let* ((landed (dk-peel!))
                 (nin (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
                 (nv (cadr nin))
                 (ih (find-first (lambda (f) (dk-head-is? f '=)) landed)))
            (fact 'nn-succ-plus-one nv)
            (subst (list '= (list 'succ nv) (list '+ nv 1)))
            (fact 'nn-in-rr nv)
            (fact 'nn-zero-le nv)
            (lti-ineq! '(<= 0 1))
            (subst (lti-cite! 'invariant-measure-ccint-additive 'mu nv 1))
            (subst ih)
            (subst (lti-unit 'mu))
            (let ((f (lti-eplus-real! nv 1)))
              (dk-lane-if! (lambda () (subst f) (dk-lane-if! (lambda () (if (not (dk-ass!)) (rfl)))))))))))))
    (dk-opened (lambda () (ni)))))
(qed 'translation-invariant-measure-nn)
(topic! 'translation-invariant-measure-nn 'inequalities)

(sp (make-wff (forall-guarded '(mu t_) (list (lti-ism 'mu) (lti-inv 'mu) (lti-unit 'mu) '(IN t_ RR) '(<= 0 t_))
   '(IN (mu (CCINT 0 t_)) RR))))
(dk-peel!)
(lti-measure-parts! 'mu)
(lti-real! 0)
(lti-real! 1)
(lti-ineq! '(< 0 1))
(fact 'rr-pos-rr-of-lt 1)
(let* ((ex (dk-apply! (lti-cite! 'rr-archimedean-multiple 1) 't_))
       (nv (dk-skolem! ex #t)))
  (dk-split-all!)
  (fact 'nn-in-rr nv)
  (lti-ineq! (list '<= 't_ nv) (list '<= 't_ (list '* nv 1)) (list 'IN nv 'RR) '(IN t_ RR))
  (lti-ineq! '(<= 0 0))
  (let ((e (dk-apply! (lti-cite! 'translation-invariant-measure-nn 'mu) nv)))
    (lti-cite! 'ccint-subset-ccint 0 nv 0 't_)
    (lti-ccbor! 0 't_)
    (lti-ccbor! 0 nv)
    (lti-mty! 'mu '(CCINT 0 t_))
    (let* ((m1 (lti-mono! 'mu '(CCINT 0 t_) (lti-cc0 nv)))
           (m2 (dk-rewrite-h! m1 (cadr e) (caddr e))))
      (lti-and! '(IN (mu (CCINT 0 t_)) RR-POS-STAR) (list 'IN nv 'RR))
      (fact 'rr-pos-star-le-real-in-rr '(mu (CCINT 0 t_)) nv)
      (ass))))
(qed 'translation-invariant-measure-finite)
(topic! 'translation-invariant-measure-finite 'inequalities)

;;; F(j s) = j F(s), by induction on j (stated with j outermost, for `ni')
(sp (make-wff (list 'FORALL 'j_ (list 'IMPLIES '(IN j_ NN)
   (forall-guarded '(mu s_) (list (lti-ism 'mu) (lti-inv 'mu) (lti-unit 'mu) '(IN s_ RR) '(<= 0 s_))
     '(= (mu (CCINT 0 (* j_ s_))) (* j_ (mu (CCINT 0 s_)))))))))
(for-each
  (lambda (l)
    (dk-focus! l)
    ((dk-lane (lambda ()
    (if (not (dk-contains? (dk-goal) 'succ))
        ;; j = 0
        (begin
          (dk-peel!)
          (let* ((g0 (dk-goal))
                 (mv (car (cadr g0)))
                 (sv (caddr (caddr (cadr (cadr g0)))))
                 (hh (list mv (lti-cc0 sv))))
            (lti-measure-parts! mv)
            (lti-fin! mv)
            (lti-real! 0)
            (lti-cite! 'translation-invariant-measure-finite mv sv)
            (lti-ineq! (list '= (list '* 0 sv) 0) (list 'IN sv 'RR))
            (lti-ineq! (list '= (list '* 0 hh) 0) (list 'IN hh 'RR))
            (subst (list '= (list '* 0 sv) 0))
            (subst (list '= (list '* 0 hh) 0))
            (dk-apply! (lti-cite! 'invariant-measure-points-null mv) 0)
            (dk-lane-if! ass)))
        ;; j -> j + 1
        (let* ((landed (dk-peel!))
               (g0 (dk-goal))
               (mv (car (cadr g0)))
               (prod (caddr (cadr (cadr g0))))
               (sv (caddr prod))
               (nv (cadr (cadr prod)))
               (ih (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f nv))) landed))
               (hh (list mv (lti-cc0 sv)))
               (ns (list '* nv sv))
               (nh (list '* nv hh)))
          (lti-measure-parts! mv)
          (lti-fin! mv)
          (lti-real! 0)
          (fact 'nn-succ-plus-one nv)
          (subst (list '= (list 'succ nv) (list '+ nv 1)))
          (fact 'nn-in-rr nv)
          (fact 'nn-zero-le nv)
          (lti-real! ns)
          (lti-and! (list 'IN nv 'RR) (list 'IN sv 'RR))
          (lti-and! (list '<= 0 nv) (list '<= 0 sv))
          (fact 'rr-leq-mul-nonneg nv sv)
          (dk-have! (list '= (list '* (list '+ nv 1) sv) (list '+ ns sv)) (lambda () (crs)))
          (subst (list '= (list '* (list '+ nv 1) sv) (list '+ ns sv)))
          (subst (lti-cite! 'invariant-measure-ccint-additive mv ns sv))
          (subst (dk-apply! ih mv sv))
          (lti-cite! 'translation-invariant-measure-finite mv sv)
          (lti-ccbor! 0 sv)
          (lti-mty! mv (lti-cc0 sv))
          (fact 'rr-pos-star-nonneg hh)
          (lti-real! nh)
          (lti-and! (list 'IN nv 'RR) (list 'IN hh 'RR))
          (lti-and! (list '<= 0 nv) (list '<= 0 hh))
          (fact 'rr-leq-mul-nonneg nv hh)
          (subst (lti-eplus-real! nh hh))
          (dk-lane-if! crs)))))))
  (dk-opened (lambda () (ni))))
(qed 'translation-invariant-measure-nn-mul)
(topic! 'translation-invariant-measure-nn-mul 'inequalities)

;;; ====================================================================
;;; (7) the squeeze: F(t) = t
;;; ====================================================================

;;; with POS-RR(dv) and the hypotheses on mu, t_ in context, H = mu([0, t_]) real:
;;; land (<= H (+ t_ dv)) and (<= t_ (+ H dv))
(define (lti-squeeze! dv upper?)
  (let ((hh '(mu (CCINT 0 t_))))
    (fact 'rr-pos-rr-in-rr dv)
    (fact 'rr-lt-of-pos-rr dv)
    (let* ((ex (lti-cite! 'recip-succ-small dv))
           (n0 (dk-skolem! ex #t)))
      (dk-split-all!)
      (let ((fm (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h n0))) "the recip bound")))
        (fact 'nn-in-rr n0)
        (lti-ineq! (list '<= n0 n0) (list 'IN n0 'RR))
        (dk-apply! fm n0))
      (let* ((r (lti-rk! n0))
             (q (list '+ n0 1))
             (hr (list 'mu (lti-cc0 r))))
        ;; q in NN
        (fact 'nn-succ-closed n0)
        (fact 'nn-succ-plus-one n0)
        (dk-rewrite-h! (list 'IN (list 'succ n0) 'NN) (list 'succ n0) q)
        ;; F(r) = r, since q F(r) = F(q r) = F(1) = 1
        (lti-cite! 'translation-invariant-measure-finite 'mu r)
        (let* ((m1 (dk-apply! (lti-cite! 'translation-invariant-measure-nn-mul q) 'mu r))
               (iv (lti-cite! 'rr-recip-inverse q))
               (m2 (dk-rewrite-h! m1 (list '* q r) 1))
               (m3 (dk-rewrite-h! m2 (list 'mu (lti-cc0 1)) 1))
               (sv (lti-cite! 'rr-recip-solve q 1 hr)))
          (lti-ineq! (list '= hr r) sv (list 'IN r 'RR) (list 'IN hr 'RR)))
        ;; the floor: j r <= t < j r + r
        (fact 'rr-pos-rr-of-lt r)
        (let* ((fl (lti-cite! 'rr-nn-floor-mul 't_))
               (ex2 (dk-apply! fl r))
               (jv (dk-skolem! ex2 #t))
               (jr (list '* jv r))
               (jr1 (list '+ jr r)))
          (dk-split-all!)
          (fact 'nn-in-rr jv)
          (fact 'nn-zero-le jv)
          (lti-real! jr)
          (lti-real! jr1)
          (lti-and! (list 'IN jv 'RR) (list 'IN r 'RR))
          (lti-and! (list '<= 0 jv) (list '<= 0 r))
          (fact 'rr-leq-mul-nonneg jv r)
          ;; F(j r) = j r and F(j r + r) = j r + r
          (let* ((e1 (dk-apply! (lti-cite! 'translation-invariant-measure-nn-mul jv) 'mu r))
                 (e2 (dk-rewrite-h! e1 hr r))
                 (a1 (lti-cite! 'invariant-measure-ccint-additive 'mu jr r))
                 (a2 (dk-rewrite-h! a1 (list 'mu (lti-cc0 jr)) jr))
                 (a3 (dk-rewrite-h! a2 hr r))
                 (ep (lti-eplus-real! jr r))
                 (a4 (dk-rewrite-h! a3 (cadr ep) (caddr ep))))
            ;; [0, j r] inside [0, t] inside [0, j r + r]
            (lti-ineq! '(<= 0 0))
            (lti-ineq! (list '<= 't_ jr1) (list '< 't_ jr1))
            (lti-cite! 'ccint-subset-ccint 0 't_ 0 jr)
            (lti-cite! 'ccint-subset-ccint 0 jr1 0 't_)
            (for-each (lambda (b) (lti-ccbor! 0 b) (lti-mty! 'mu (lti-cc0 b))) (list jr 't_ jr1))
            (let* ((o1 (lti-mono! 'mu (lti-cc0 jr) (lti-cc0 't_)))
                   (o2 (dk-rewrite-h! o1 (list 'mu (lti-cc0 jr)) jr))
                   (p1 (lti-mono! 'mu (lti-cc0 't_) (lti-cc0 jr1)))
                   (p2 (dk-rewrite-h! p1 (list 'mu (lti-cc0 jr1)) jr1))
                   (ty (list (list 'IN hh 'RR) (list 'IN jr 'RR) (list 'IN r 'RR) '(IN t_ RR) (list 'IN dv 'RR))))
              (if upper?
                  (apply lti-ineq! (list '<= hh (list '+ 't_ dv)) p2 (list '<= jr 't_) (list '<= r dv) ty)
                  (apply lti-ineq! (list '<= 't_ (list '+ hh dv)) (list '< 't_ jr1) o2 (list '<= r dv) ty)))))))))

(sp (make-wff (forall-guarded '(mu t_) (list (lti-ism 'mu) (lti-inv 'mu) (lti-unit 'mu) '(IN t_ RR) '(<= 0 t_))
   '(= (mu (CCINT 0 t_)) t_))))
(dk-peel!)
(lti-measure-parts! 'mu)
(lti-fin! 'mu)
(lti-real! 0)
(lti-real! 1)
(lti-cite! 'translation-invariant-measure-finite 'mu 't_)
(let ((hh '(mu (CCINT 0 t_))))
  (dk-have! (list 'FORALL 'ltd_ (list 'IMPLIES '(POS-RR ltd_) (list '<= hh '(+ t_ ltd_))))
    (lti-lane-ass (lambda () (lti-squeeze! (cadr (car (dk-peel!))) #t))))
  (dk-have! (list 'FORALL 'ltd_ (list 'IMPLIES '(POS-RR ltd_) (list '<= 't_ (list '+ hh 'ltd_))))
    (lti-lane-ass (lambda () (lti-squeeze! (cadr (car (dk-peel!))) #f))))
  (lti-cite! 'rr-le-of-le-add-all-pos hh 't_)
  (lti-cite! 'rr-le-of-le-add-all-pos 't_ hh)
  (dk-ineq! (list '<= hh 't_) (list '<= 't_ hh) (list 'IN hh 'RR) '(IN t_ RR)))
(qed 'translation-invariant-measure-ccint-zero)
(topic! 'translation-invariant-measure-ccint-zero 'inequalities)
;;; ====================================================================
;;; (8) normalised: mu([a, b]) = b - a, hence mu is Lebesgue measure on the Borel sets
;;; ====================================================================

(define lti-len
  (forall-guarded '(a_ b_) '((IN a_ RR) (IN b_ RR) (<= a_ b_)) '(= (mu (CCINT a_ b_)) (- b_ a_))))

(sp (make-wff (forall-guarded '(mu) (list (lti-ism 'mu) (lti-inv 'mu) (lti-unit 'mu)) lti-len)))
(dk-peel!)
(let ((w '(- b_ a_)))
  (lti-real! w)
  (lti-ineq! (list '<= 0 w) '(<= a_ b_) '(IN a_ RR) '(IN b_ RR))
  (subst (lti-cite! 'invariant-measure-ccint-shift 'mu 'a_ 'b_))
  (subst (lti-cite! 'translation-invariant-measure-ccint-zero 'mu w))
  (if (not (proof-done? *ps*)) (if (not (dk-ass!)) (rfl))))
(qed 'translation-invariant-measure-ccint)
(topic! 'translation-invariant-measure-ccint 'inequalities)

(sp (make-wff (forall-guarded '(mu es) (list (lti-ism 'mu) (lti-inv 'mu) (lti-unit 'mu) (list 'IN 'es lti-bor))
   (list '= '(mu es) (list lti-leb 'es)))))
(dk-peel!)
(lti-cite! 'translation-invariant-measure-ccint 'mu)
(lti-cite! 'lebesgue-measure-unique 'mu 'es)
(ass)
(qed 'translation-invariant-measure-lebesgue)
(topic! 'translation-invariant-measure-lebesgue 'set-quotient)

;;; ====================================================================
;;; (9) THE COROLLARY: a translation-invariant Borel measure with
;;;     0 < mu([0, 1]) = k < +inf is k times Lebesgue measure
;;; ====================================================================

(sp (make-wff (forall-guarded '(mu k es)
   (list (lti-ism 'mu) (lti-inv 'mu) '(IN k RR) '(< 0 k) (list '= (list 'mu (lti-cc0 1)) 'k) (list 'IN 'es lti-bor))
   (list '= '(mu es) (list 'etimes 'k (list lti-leb 'es))))))
(dk-peel!)
(lti-measure-parts! 'mu)
(let* ((r '(recip k))
       (u01 (lti-cc0 1)))
  (dk-have! '(NOT (= k 0)) (lambda () (di) (dk-absurd! '(= k 0) '(< 0 k))))
  (lti-and! '(IN k RR) '(NOT (= k 0)))
  (fact 'rr-recip-closed 'k)
  (fact 'rr-recip-pos 'k)
  (fact 'rr-recip-inverse 'k)
  (lti-ineq! (list '<= 0 r) (list '< 0 r))
  (lti-ineq! '(<= 0 k) '(< 0 k))
  (lti-rps! r)
  (lti-rps! 'k)
  (lti-and! (list 'IN r 'RR) '(IN k RR))
  (fact 'rr-mul-comm r 'k)
  (dk-have! (list '= (list '* r 'k) 1)
    (lambda () (subst (list '= (list '* r 'k) (list '* 'k r))) (ass)))
  (let* ((nsm (dk-apply! (lti-cite! 'measure-scale 'RR lti-bor 'mu) r))
         (nu (cadddr nsm))
         ;; nu(x) = r mu(x) for a Borel x
         (nu-at! (lambda (x)
                   (let ((f (list '= (list nu x) (list 'etimes r (list 'mu x)))))
                     (lti-mty! 'mu x)
                     (lti-et! r (list 'mu x))
                     (if (not (dk-asm? f))
                         (dk-have! f (lti-lane-ass (lambda () (if (not (dk-lam-b!)) (dk-lane-if! rfl))))))
                     f))))
    ;; nu is invariant
    (dk-have! (lti-inv nu)
      (dk-lane (lambda ()
        (dk-peel!)
        (let* ((tr (cadr (cadr (dk-goal))))
               (ev (cadr tr))
               (cv (caddr tr)))
          (subst (nu-at! tr))
          (subst (nu-at! ev))
          (subst (dk-apply! (lti-inv 'mu) ev cv))
          (dk-lane-if! (lambda () (if (not (dk-ass!)) (rfl))))))))
    ;; nu([0, 1]) = r k = 1
    (lti-real! 0)
    (lti-real! 1)
    (lti-ccbor! 0 1)
    (dk-have! (lti-unit nu)
      (dk-lane (lambda ()
        (subst (nu-at! u01))
        (subst (list '= (list 'mu u01) 'k))
        (lti-cite! 'etimes-real-defined r 'k)
        (subst (list '= (list 'etimes r 'k) (list 'bintimes r 'k)))
        (fact 'bintimes-apply r 'k)
        (subst (list '== (list 'bintimes r 'k) (list '* r 'k)))
        (subst (list '= (list '* r 'k) 1))
        (dk-lane-if! (lambda () (if (not (dk-ass!)) (rfl)))))))
    ;; nu is Lebesgue measure on the Borel sets; scale back by k
    (let* ((le (lti-cite! 'translation-invariant-measure-lebesgue nu 'es))
           (mes '(mu es)))
      (nu-at! 'es)
      (subst (list '= (list lti-leb 'es) (list nu 'es)))
      (subst (list '= (list nu 'es) (list 'etimes r mes)))
      (subst (lti-cite! 'etimes-assoc-real 'k r mes))
      (subst (list '= (list '* 'k r) 1))
      (subst (lti-cite! 'etimes-one-left mes))
      (if (not (proof-done? *ps*)) (if (not (dk-ass!)) (rfl))))))
(qed 'lebesgue-translation-invariant)
(topic! 'lebesgue-translation-invariant 'set-quotient)

(gloss! 'invariant-measure-points-null
  "A translation-invariant Borel measure on the line that is finite on [0, 1] gives every
   point measure zero.")
(gloss! 'translation-invariant-measure-lebesgue
  "A translation-invariant Borel measure on the line with mu([0, 1]) = 1 is Lebesgue measure
   on the Borel sets.")
(gloss! 'lebesgue-translation-invariant
  "A translation-invariant Borel measure mu on the line with 0 < mu([0, 1]) = k < +inf is k
   times Lebesgue measure: mu(E) = k lam(E) for every Borel set E.")
