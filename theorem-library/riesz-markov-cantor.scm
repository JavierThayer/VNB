;;; g1 + g2 <= f pointwise => lam(g1) + lam(g2) <= lam(f)
(sp (make-wff (list 'FORALL 's (list 'FORALL 'lam (list 'FORALL 'f (list 'FORALL 'g1 (list 'FORALL 'g2
  (list 'IMPLIES '(IS-POSITIVE-FUNCTIONAL s lam) (list 'IMPLIES '(IN f (CONT-FNS s))
  (list 'IMPLIES '(IN g1 (CONT-FNS s)) (list 'IMPLIES '(IN g2 (CONT-FNS s))
