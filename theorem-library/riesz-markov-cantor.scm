;;; ---- indicators under the functional -----------------------------------

;;; (rmc-num-true? F): F a relation between ground numeric terms; its truth.
(define (rmc-ev e)
  (cond ((number? e) e)
        ((and (pair? e) (eq? (car e) '+)) (+ (rmc-ev (cadr e)) (rmc-ev (caddr e))))
        ((and (pair? e) (eq? (car e) '*)) (* (rmc-ev (cadr e)) (rmc-ev (caddr e))))
        ((and (pair? e) (eq? (car e) '-) (null? (cddr e))) (- (rmc-ev (cadr e))))
        ((and (pair? e) (eq? (car e) '-)) (- (rmc-ev (cadr e)) (rmc-ev (caddr e))))
        (#t (error "rmc-ev: not a ground numeric term" e))))
(define (rmc-num-true? f)
  (let ((a (rmc-ev (cadr f))) (b (rmc-ev (caddr f))))
    (case (car f) ((<=) (<= a b)) ((<) (< a b)) ((=) (= a b)) (else (error "rmc-num-true?" f)))))

;;; (rmc-ind-cases! OMEGA SETS X FACTS): the goal is a relation between sums of
;;; indicator values ((INDICATOR OMEGA A) X), A in SETS, X in OMEGA in context.
;;; Split on X in A for each A, replace the value by 1 / 0, and close each leaf
;;; by `arith' when the numbers say so, else by `prop' from FACTS (the
;;; membership iffs relating the sets) and the case literals.
(define (rmc-ind-cases! omega sets x facts . lits0)
  (let loop ((sets sets) (lits (if (pair? lits0) (car lits0) '())))
    (if (null? sets)
        (if (rmc-num-true? (dk-goal))
            (arith)
            (apply rmc-prop! (append facts lits)))
        (let* ((a (car sets))
               (t (list (list 'INDICATOR omega a) x))
               (p (list 'IN x a)))
          (define (yes)
            (if (dk--occurs? t (dk-goal))
                (begin (dk-cite! 'indicator-value-in omega a x) (subst (list '= t 1))))
            (loop (cdr sets) (cons p lits)))
          (define (no)
            (if (dk--occurs? t (dk-goal))
                (begin (dk-cite! 'indicator-value-out omega a x) (subst (list '= t 0))))
            (loop (cdr sets) (cons (list 'NOT p) lits)))
          (cond ((dk-asm? p) (yes))
                ((dk-asm? (list 'NOT p)) (no))
                (#t (use-em p yes no)))))))

(define (rmc-ind s u) (list 'INDICATOR (list 'PTS s) u))

;;; lam(1_u) is a nonnegative real
(sp (make-wff '(FORALL s (FORALL lam (FORALL u (IMPLIES (IS-POSITIVE-FUNCTIONAL s lam) (IMPLIES (IN u (CLOPEN-SETS s))
  (AND (IN (lam (INDICATOR (PTS s) u)) RR) (<= 0 (lam (INDICATOR (PTS s) u)))))))))))
(dk-peel!)
