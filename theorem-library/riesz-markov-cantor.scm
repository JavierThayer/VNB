;;; (rmc-ext! LHS RHS CITE!): land (= LHS RHS) by class extensionality; CITE!
;;; is run on the eigenvariable x with goal (IFF (IN x LHS) (IN x RHS)) and
;;; must land the membership iffs `prop' needs.
(define (rmc-ext! lhs rhs cite!)
  (dk-have! (list '= lhs rhs)
    (lambda ()
      (dk-have! (list 'FORALL 'rxe_ (list 'IFF (list 'IN 'rxe_ lhs) (list 'IN 'rxe_ rhs)))
        (lambda ()
          (let ((x (dk-di-var! (lambda (g) (cadr (cadr g))))))
            (cite! x)
            (prop))))
      (dk-cite! 'class-extensionality lhs rhs)
      (ass))))

