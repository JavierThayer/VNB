;;; (rmc-closed-by-compl! S W C EQ): IS-CLOSED S W from W subset PTS S, the open
;;; set C, and EQ = (= (COMPLEMENT-IN (PTS S) W) C) in context.
(define (rmc-closed-by-compl! s w c)
  (dk-have! (list 'IS-OPEN s (list 'COMPLEMENT-IN (list 'PTS s) w))
    (lambda () (subst (list '= (list 'COMPLEMENT-IN (list 'PTS s) w) c)) (ass)))
  (let ((cc (dk-cite! 'is-closed s w)))
    (dk-have! (list 'IS-CLOSED s w)
      (lambda () (rmc-prop! cc (list 'IS-METRIC-SPACE s) (list 'SUBSET w (list 'PTS s))
                            (list 'IS-OPEN s (list 'COMPLEMENT-IN (list 'PTS s) w)))))))

;;; (rmc-clopen-pair! S U V): the parts of the clopen sets U, V and of their
;;; complements in context.
(define (rmc-clopen-pair! s u v)
  (dk-split-all! (list (dk-cite! 'rmc-clopen-parts s u)))
  (dk-split-all! (list (dk-cite! 'rmc-clopen-parts s v)))
  (let ((cu (list 'COMPLEMENT-IN (list 'PTS s) u))
        (cv (list 'COMPLEMENT-IN (list 'PTS s) v)))
    (dk-cite! 'rmc-clopen-compl s u)
    (dk-cite! 'rmc-clopen-compl s v)
    (dk-split-all! (list (dk-cite! 'rmc-clopen-parts s cu)))
    (dk-split-all! (list (dk-cite! 'rmc-clopen-parts s cv)))
    (let ((cc (dk-cite! 'is-closed s u)))
      (dk-have! (list 'IS-METRIC-SPACE s) (lambda () (rmc-prop! cc (list 'IS-CLOSED s u)))))))

(sp (make-wff '(FORALL s (FORALL u (FORALL v (IMPLIES (IN u (CLOPEN-SETS s)) (IMPLIES (IN v (CLOPEN-SETS s))
  (IN (INTERSECTION u v) (CLOPEN-SETS s)))))))))
(dk-peel!)
(rmc-clopen-pair! 's 'u 'v)
(dk-have! '(AND (IS-OPEN s u) (IS-OPEN s v)) (lambda () (dk-conj-close! (lambda () (ass)))))
(dk-cite! 'inter-of-opens-open 's 'u 'v)
(dk-cite! 'rmc-open-union 's '(COMPLEMENT-IN (PTS s) u) '(COMPLEMENT-IN (PTS s) v))
(dk-cite! 'rmc-compl-inter '(PTS s) 'u 'v)
(dk-have! '(SUBSET (INTERSECTION u v) (PTS s))
