(rmc-lam-real! 's 'lam 'g)
(rmc-lam-real! 's 'lam rmc-f1)
(rmc-lam-real! 's 'lam rmc-h)
(dk-ineq! (list '<= 0 (list 'lam rmc-h))
          (list '= (list 'lam rmc-h) (list '+ '(lam g) (list 'lam rmc-f1)))
          (list '= (list 'lam rmc-f1) (list '* -1 '(lam f)))
          '(IN (lam f) RR) '(IN (lam g) RR) (list 'IN (list 'lam rmc-f1) 'RR) (list 'IN (list 'lam rmc-h) 'RR))
(qed 'rmc-pf-mono)

