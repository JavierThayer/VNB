;;; ITEM 2a: the clopen sets of a metric space form an algebra of sets.
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (IS-ALGEBRA-OF-SETS (PTS s) (CLOPEN-SETS s))))))
(dk-peel!)
(dk-cite! 'ms-pts-is-set 's)
(dk-cite! 'rmc-clopen-sub-power 's)
(dk-split-all! (list (dk-cite! 'rmc-clopen-empty-whole 's)))
(mac 'is-algebra-of-sets)
(for-each
  (lambda (leaf)
    (dk-focus! leaf)
    (let ((g (dk-goal)))
      (cond ((dk-head-is? g 'FORSOME) (ew 'EMPTY-SET) (ass))
            ((dk-head-is? g 'FORALL)
             (let* ((u (dk-di-var!))
                    (g2 (dk-goal))
                    (t2 (cadr g2)))
               (cond ((dk-head-is? t2 'COMPLEMENT-IN) (dk-cite! 'rmc-clopen-compl 's u) (ass))
                     ((dk-head-is? t2 'UNION) (dk-cite! 'rmc-clopen-union 's (cadr t2) (caddr t2)) (ass))
                     (#t (dk-cite! 'rmc-clopen-inter 's (cadr t2) (caddr t2)) (ass)))))
            (#t (ass)))))
  (rmc-split-goal!))
(qed 'rmc-clopen-algebra)

;;; (rmc-antisym! A B): close (= A B) -- or land it -- from A <= B, B <= A and
;;; the typings A, B in RR, all in context.
(define (rmc-antisym! a b)
  (dk-have! (list 'AND (list 'IN a 'RR) (list 'IN b 'RR)) (lambda () (dk-conj-close! (lambda () (ass)))))
  (dk-have! (list 'AND (list '<= a b) (list '<= b a)) (lambda () (dk-conj-close! (lambda () (ass)))))
  (dk-have! (list '= a b) (lambda () (dk-cite! 'rr-leq-antisymmetric a b) (ass))))

;;; ---- the positive functional ------------------------------------------

;;; (rmc-pf-open! S LAM): with (IS-POSITIVE-FUNCTIONAL S LAM) in context, land
;;; its four clauses; return them as (typing additive homogeneous positive).
(define (rmc-pf-open! s lam)
  (let* ((c (dk-cite! 'is-positive-functional s lam))
         (body (caddr c))
         (c1 (cadr body))
         (c2 (cadr (caddr body)))
         (c3 (cadr (caddr (caddr body))))
         (c4 (caddr (caddr (caddr body)))))
    (for-each (lambda (k) (dk-have! k (lambda () (rmc-prop! c (list 'IS-POSITIVE-FUNCTIONAL s lam)))))
              (list c1 c2 c3 c4))
    (list c1 c2 c3 c4)))

;;; (rmc-lam-real! S LAM F): (IN (LAM F) RR), F in CONT-FNS(S) and the typing
;;; clause of LAM in context.
(define (rmc-lam-real! s lam f)
  (dk-cite! 'fun-apply-type-c lam (list 'CONT-FNS s) 'RR f))

;;; (rmc-fval! S F X): (IN (F X) RR) for F in CONT-FNS(S), X in PTS S.
(define (rmc-fval! s f x)
  (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts s f)))
  (dk-cite! 'fun-apply-type-c f (list 'PTS s) 'RR x))

;;; the additivity and homogeneity clauses as citable laws
(sp (make-wff (list 'FORALL 's (list 'FORALL 'lam (list 'FORALL 'f (list 'FORALL 'g
  (list 'IMPLIES '(IS-POSITIVE-FUNCTIONAL s lam) (list 'IMPLIES '(IN f (CONT-FNS s)) (list 'IMPLIES '(IN g (CONT-FNS s))
    (list '= (list 'lam (rmc-sum 's 'f 'g)) '(+ (lam f) (lam g))))))))))))
(dk-peel!)
(define rmc-cl (rmc-pf-open! 's 'lam))
(dk-apply! (list-ref rmc-cl 1) 'f 'g)
(ass)
(qed 'rmc-pf-add)

(sp (make-wff (list 'FORALL 's (list 'FORALL 'lam (list 'FORALL 'c (list 'FORALL 'f
  (list 'IMPLIES '(IS-POSITIVE-FUNCTIONAL s lam) (list 'IMPLIES '(IN c RR) (list 'IMPLIES '(IN f (CONT-FNS s))
    (list '= (list 'lam (rmc-scl 's 'c 'f)) '(* c (lam f))))))))))))
(dk-peel!)
(define rmc-cl (rmc-pf-open! 's 'lam))
(dk-apply! (list-ref rmc-cl 2) 'c 'f)
