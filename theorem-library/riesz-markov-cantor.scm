;;; the union of two open sets is open
(sp (make-wff '(FORALL s (FORALL u (FORALL v (IMPLIES (IS-OPEN s u) (IMPLIES (IS-OPEN s v)
  (IS-OPEN s (UNION u v)))))))))
(dk-peel!)
(define rmc-ou (dk-cite! 'is-open 's 'u))
(define rmc-ov (dk-cite! 'is-open 's 'v))
(dk-have! '(IS-METRIC-SPACE s) (lambda () (rmc-prop! rmc-ou '(IS-OPEN s u))))
(dk-have! '(SUBSET u (PTS s)) (lambda () (rmc-prop! rmc-ou '(IS-OPEN s u))))
(dk-have! '(SUBSET v (PTS s)) (lambda () (rmc-prop! rmc-ov '(IS-OPEN s v))))
(define rmc-ucl (caddr (caddr (caddr rmc-ou))))
(define rmc-vcl (caddr (caddr (caddr rmc-ov))))
(dk-have! rmc-ucl (lambda () (rmc-prop! rmc-ou '(IS-OPEN s u))))
(dk-have! rmc-vcl (lambda () (rmc-prop! rmc-ov '(IS-OPEN s v))))
(mac 'is-open)
(define (rmc-ball-into! y cl w)
  ;; with (IN y w) in context: ew the radius of CL at y; close (SUBSET (BALL ...) (UNION u v))
  (let ((r (dk-skolem! (dk-apply! cl y))))
    (ew r)
    (rmc-and-focus! 'SUBSET)
    (mac 'subset-def)
    (let* ((z (dk-di-var!))
           (c1 (dk-cite! 'subset-mem-fwd (list 'BALL 's y r) w z))
           (c2 (dk-cite! 'union-membership 'u 'v z)))
      (rmc-prop! c1 c2 (list 'IN z (list 'BALL 's y r))))))
(for-each
  (lambda (leaf)
    (dk-focus! leaf)
    (let ((g (dk-goal)))
      (cond ((dk-head-is? g 'SUBSET)
             (mac 'subset-def)
             (let* ((x (dk-di-var!))
                    (c1 (dk-cite! 'union-membership 'u 'v x))
                    (c2 (dk-cite! 'subset-mem-fwd 'u '(PTS s) x))
                    (c3 (dk-cite! 'subset-mem-fwd 'v '(PTS s) x)))
               (rmc-prop! c1 c2 c3 (list 'IN x '(UNION u v)))))
            ((dk-head-is? g 'FORALL)
             (let ((y (dk-di-var!)))
               (dk-cite! 'union-membership 'u 'v y)
               (use-em (list 'IN y 'u)
                 (lambda () (rmc-ball-into! y rmc-ucl 'u))
                 (lambda ()
                   (dk-have! (list 'IN y 'v)
                     (lambda () (rmc-prop! (list 'IFF (list 'IN y '(UNION u v)) (list 'OR (list 'IN y 'u) (list 'IN y 'v)))
                                           (list 'IN y '(UNION u v)) (list 'NOT (list 'IN y 'u)))))
                   (rmc-ball-into! y rmc-vcl 'v)))))
            (#t (ass)))))
  (rmc-split-goal!))
(qed 'rmc-open-union)

