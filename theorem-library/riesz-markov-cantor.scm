(dk-cite! 'rmc-clopen-diff 's 'a 'c)
(dk-cite! 'rmc-indicator-cont 's 'a)
(dk-cite! 'rmc-indicator-cont 's 'c)
(dk-cite! 'rmc-indicator-cont 's '(DIFFERENCE a c))
(rmc-ptwise-ind!
  (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS s))
    (list '<= (list (rmc-ind 's 'a) 'x)
              (list '+ (list (rmc-ind 's '(DIFFERENCE a c)) 'x) (list (rmc-ind 's 'c) 'x)))))
  '(a c (DIFFERENCE a c))
  (lambda (x) (list (dk-cite! 'difference-membership 'a 'c x))))
(dk-cite! 'rmc-pf-le-sum 's 'lam (rmc-ind 's 'a) (rmc-ind 's '(DIFFERENCE a c)) (rmc-ind 's 'c))
(ass)
