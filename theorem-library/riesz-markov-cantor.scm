;;; the content of the empty set is 0
(sp (make-wff '(FORALL s (FORALL lam (IMPLIES (IS-POSITIVE-FUNCTIONAL s lam) (IMPLIES (IS-METRIC-SPACE s)
  (= (lam (INDICATOR (PTS s) EMPTY-SET)) 0)))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'rmc-clopen-empty-whole 's)))
(dk-cite! 'rmc-indicator-cont 's 'EMPTY-SET)
(rmc-ptwise-ind!
  (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS s))
    (list '<= (list '+ (list (rmc-ind 's 'EMPTY-SET) 'x) (list (rmc-ind 's 'EMPTY-SET) 'x))
              (list (rmc-ind 's 'EMPTY-SET) 'x))))
  '(EMPTY-SET)
  (lambda (x) (list (dk-cite! 'empty-set-has-no-members x))))
(dk-cite! 'rmc-pf-ge-sum 's 'lam (rmc-ind 's 'EMPTY-SET) (rmc-ind 's 'EMPTY-SET) (rmc-ind 's 'EMPTY-SET))
(dk-split-all! (list (dk-cite! 'rmc-ind-nonneg 's 'lam 'EMPTY-SET)))
(define rmc-l0 (list 'lam (rmc-ind 's 'EMPTY-SET)))
(dk-have! (list '<= rmc-l0 0) (lambda () (dk-ineq! (list '<= (list '+ rmc-l0 rmc-l0) rmc-l0) (list 'IN rmc-l0 'RR))))
(dk-have! '(IN 0 RR) (lambda () (from-context!)))
(rmc-antisym! rmc-l0 0)
(qed 'rmc-ind-empty)

;;; ITEM 2b: FINITE ADDITIVITY of the content on disjoint clopen sets
(sp (make-wff '(FORALL s (FORALL lam (FORALL u (FORALL v
  (IMPLIES (IS-POSITIVE-FUNCTIONAL s lam) (IMPLIES (IN u (CLOPEN-SETS s)) (IMPLIES (IN v (CLOPEN-SETS s))
    (IMPLIES (= (INTERSECTION u v) EMPTY-SET)
      (= (lam (INDICATOR (PTS s) (UNION u v)))
         (+ (lam (INDICATOR (PTS s) u)) (lam (INDICATOR (PTS s) v))))))))))))))
(dk-peel!)
(dk-cite! 'rmc-clopen-union 's 'u 'v)
(dk-cite! 'rmc-indicator-cont 's 'u)
(dk-cite! 'rmc-indicator-cont 's 'v)
(dk-cite! 'rmc-indicator-cont 's '(UNION u v))
(define (rmc-uv-facts x)
  (let* ((f1 (dk-cite! 'union-membership 'u 'v x))
         (f2 (dk-cite! 'intersection-membership 'u 'v x))
         (f3 (dk-cite! 'empty-set-has-no-members x))
         (f4 (dk-have! (list 'NOT (list 'IN x '(INTERSECTION u v)))
               (lambda () (subst '(= (INTERSECTION u v) EMPTY-SET)) (ass)))))
    (list f1 f2 (list 'NOT (list 'IN x '(INTERSECTION u v))))))
(rmc-ptwise-ind!
  (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS s))
    (list '<= (list (rmc-ind 's '(UNION u v)) 'x)
              (list '+ (list (rmc-ind 's 'u) 'x) (list (rmc-ind 's 'v) 'x)))))
  '(u v (UNION u v))
  rmc-uv-facts)
(rmc-ptwise-ind!
  (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS s))
    (list '<= (list '+ (list (rmc-ind 's 'u) 'x) (list (rmc-ind 's 'v) 'x))
              (list (rmc-ind 's '(UNION u v)) 'x))))
  '(u v (UNION u v))
  rmc-uv-facts)
(dk-cite! 'rmc-pf-le-sum 's 'lam (rmc-ind 's '(UNION u v)) (rmc-ind 's 'u) (rmc-ind 's 'v))
(dk-cite! 'rmc-pf-ge-sum 's 'lam (rmc-ind 's '(UNION u v)) (rmc-ind 's 'u) (rmc-ind 's 'v))
(dk-split-all! (list (dk-cite! 'rmc-ind-nonneg 's 'lam 'u)))
(dk-split-all! (list (dk-cite! 'rmc-ind-nonneg 's 'lam 'v)))
(dk-split-all! (list (dk-cite! 'rmc-ind-nonneg 's 'lam '(UNION u v))))
(dk-have! (list 'IN (list '+ (list 'lam (rmc-ind 's 'u)) (list 'lam (rmc-ind 's 'v))) 'RR) (lambda () (in-rr)))
(rmc-antisym! (list 'lam (rmc-ind 's '(UNION u v))) (list '+ (list 'lam (rmc-ind 's 'u)) (list 'lam (rmc-ind 's 'v))))
(qed 'rmc-ind-additive)

;;; =====================================================================
;;; (D) COMPACTNESS: A COUNTABLE OPEN COVER OF A CLOSED SET HAS A FINITE
;;;     SUBCOVER; COUNTABLE SUBADDITIVITY OF THE CONTENT (item 3)
;;; =====================================================================

;;; The finite subcover (rmc-finite-subcover, with its countable-choice helpers) MOVED
;;; 2026-10-20 to theorem-library/metric-finite-subcover.scm (analysis) as
;;; compact-closed-countable-subcover; the citations below name it there.

;;; ---- [0, +inf] bookkeeping (copied from outer-measure-construction.scm's
;;; omc- kit) --------------------------------------------------------------
(define (rmc-and2! p q)
  (dk-have! (list 'AND p q) (lambda () (dk-conj-close! dk-ass!))))
(define (rmc-and3! p q r)
  (dk-have! (list 'AND p (list 'AND q r)) (lambda () (dk-conj-close! dk-ass!))))
;;; x <= z from x <= y, y <= z, all typed in [0, +inf]
(define (rmc-trans! x y z)
  (rmc-and3! (list 'IN x 'RR-POS-STAR) (list 'IN y 'RR-POS-STAR) (list 'IN z 'RR-POS-STAR))
  (rmc-and2! (list '<= x y) (list '<= y z))
  (fact 'rr-pos-star-le-trans x y z))
;;; DOM f = NN and f in FUN(DOM f, RR-POS-STAR); then ESUM f typed
(define (rmc-dom! fv)
  (fact 'nn-is-set)
  (dk-project! (list 'IN fv '(FUN NN)) 'fun-codomain-iff (list 'IN fv '(FUN NN RR-POS-STAR)))
  (rmc-and2! (list 'IN fv '(FUN NN)) '(IN NN SET))
  (fact 'dom-of-fun 'NN fv)
  (dk-split-all! (list (dk-ctx-form (list 'AND (list 'IN (list 'DOM fv) 'SET)
                                          (list '= (list 'DOM fv) 'NN)))))
  (dk-have! (list 'IN fv (list 'FUN (list 'DOM fv) 'RR-POS-STAR))
            (lambda () (subst (list '= (list 'DOM fv) 'NN)) (ass))))
(define (rmc-esum-type! fv)
  (if (not (dk-asm? (list 'IN (list 'ESUM fv) 'RR-POS-STAR)))
      (begin (rmc-dom! fv) (fact 'esum-in fv))))

;;; a nonnegative real is in [0, +inf]
(sp (make-wff '(FORALL x (IMPLIES (IN x RR) (IMPLIES (<= 0 x) (IN x RR-POS-STAR))))))
(dk-peel!)
(let ((c (dk-cite! 'rr-pos-star-membership 'x)))
  (rmc-prop! c '(IN x RR) '(<= 0 x)))
(qed 'rmc-rps-of-nonneg)

;;; the clopen sets of a metric space form a set
(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (IN (CLOPEN-SETS s) SET)))))
(dk-peel!)
(dk-cite! 'ms-pts-is-set 's)
(dk-cite! 'power-set '(PTS s))
(mac 'CLOPEN-SETS)
(sep-set)
(ass)
(qed 'rmc-clopen-set)

;;; THE CONTENT mu0 = u |-> lam(1_u) on CLOPEN-SETS(s), and the sequence of its
;;; values along a sequence csq of clopen sets.
(define (rmc-mu0 s lam) (list 'VNB-LAMBDA 'rcu_ (list 'CLOPEN-SETS s) (list lam (list 'INDICATOR (list 'PTS s) 'rcu_))))
(define (rmc-fseq s lam csq) (list 'VNB-LAMBDA 'cvk_ 'NN (list (rmc-mu0 s lam) (list csq 'cvk_))))
(define (rmc-prefix s lam csq n) (list 'FINSUM 'RR-POS-STAR-ADD-MONOID (rmc-fseq s lam csq) (list 'ORD-SEGMENT n)))

(sp (make-wff (list 'FORALL 's (list 'FORALL 'lam (list 'FORALL 'u
  (list 'IMPLIES '(IS-POSITIVE-FUNCTIONAL s lam) (list 'IMPLIES '(IN u (CLOPEN-SETS s))
    (list '= (list (rmc-mu0 's 'lam) 'u) '(lam (INDICATOR (PTS s) u))))))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'rmc-ind-nonneg 's 'lam 'u)))
(dk-lam-b!)
(rfl)
(qed 'rmc-mu0-value)

(sp (make-wff (list 'FORALL 's (list 'FORALL 'lam (list 'FORALL 'csq
  (list 'IMPLIES '(IS-POSITIVE-FUNCTIONAL s lam) (list 'IMPLIES '(IN csq (FUN NN (CLOPEN-SETS s)))
    (list 'AND (list 'IN (rmc-fseq 's 'lam 'csq) '(FUN NN RR-POS-STAR))
      (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
        (list '= (list (rmc-fseq 's 'lam 'csq) 'k) '(lam (INDICATOR (PTS s) (csq k))))))))))))))
(dk-peel!)
(dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
            (list '= (list (rmc-fseq 's 'lam 'csq) 'k) '(lam (INDICATOR (PTS s) (csq k))))))
  (lambda ()
    (let ((k (dk-di-var!)))
      (dk-cite! 'fun-apply-type-c 'csq 'NN '(CLOPEN-SETS s) k)
      (dk-split-all! (list (dk-cite! 'rmc-ind-nonneg 's 'lam (list 'csq k))))
      (dk-lam-b!)
      (rfl))))
(dk-have! (list 'IN (rmc-fseq 's 'lam 'csq) '(FUN NN RR-POS-STAR))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((k (dk-di-var!)))
          (dk-cite! 'fun-apply-type-c 'csq 'NN '(CLOPEN-SETS s) k)
          (dk-split-all! (list (dk-cite! 'rmc-ind-nonneg 's 'lam (list 'csq k))))
          (dk-lam-b!)
          (dk-cite! 'rmc-rps-of-nonneg (list 'lam (list 'INDICATOR '(PTS s) (list 'csq k))))
          (ass))))))
(dk-conj-close! (lambda () (ass)))
(qed 'rmc-fseq-laws)

;;; THE FINITE STAGE, by induction on the bound: a clopen a covered by csq(n),
;;; n < nq_, has content at most the prefix sum of the contents of csq(n), n < nq_.
(define (rmc-cover-below a csq nb)
  (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x a)
    (list 'FORSOME 'n (list 'AND '(IN n NN) (list 'AND (list '< 'n nb) (list 'IN 'x (list csq 'n))))))))
(sp (make-wff (list 'FORALL 'nq_ (list 'IMPLIES '(IN nq_ NN)
  (list 'FORALL 's (list 'FORALL 'lam (list 'FORALL 'csq
    (list 'IMPLIES '(IS-POSITIVE-FUNCTIONAL s lam) (list 'IMPLIES '(IS-METRIC-SPACE s)
    (list 'IMPLIES '(IN csq (FUN NN (CLOPEN-SETS s)))
      (list 'FORALL 'a (list 'IMPLIES '(IN a (CLOPEN-SETS s))
        (list 'IMPLIES (rmc-cover-below 'a 'csq 'nq_)
          (list '<= '(lam (INDICATOR (PTS s) a)) (rmc-prefix 's 'lam 'csq 'nq_)))))))))))))))
(define rmc-lv (dk-opened (lambda () (ni))))
;; base: nothing lies below 0, so a is empty
(dk-focus! (car rmc-lv))
(dk-peel!)
(dk-have! '(FORALL rxa_ (NOT (IN rxa_ a)))
  (lambda ()
    (let ((x (dk-di-var! (lambda (g) (cadr (cadr g))))))
      (di)
      (let ((n (dk-skolem! (dk-apply! (dk-ctx-form (rmc-cover-below 'a 'csq 0)) x))))
        (dk-cite! 'nn-zero-le n)
        (dk-cite! 'nn-in-rr n)
        (dk-absurd! (list '<= 0 n) (list '< n 0) (list 'IN n 'RR))))))
(rmc-ext! 'a 'EMPTY-SET
  (lambda (x)
    (dk-apply! (dk-ctx-form '(FORALL rxa_ (NOT (IN rxa_ a)))) x)
    (dk-cite! 'empty-set-has-no-members x)))
(subst '(= a EMPTY-SET))
(dk-cite! 'rmc-ind-empty 's 'lam)
(dk-cite! 'rps-prefix-zero (rmc-fseq 's 'lam 'csq))
(subst '(= (lam (INDICATOR (PTS s) EMPTY-SET)) 0))
(subst (list '= (rmc-prefix 's 'lam 'csq 0) 0))
(arith)
;; step
(dk-focus! (cadr rmc-lv))
(define rmc-n (dk-di-var!))
(di)
(define rmc-ih (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 's))) "the induction hypothesis"))
(dk-peel!)
(define rmc-c (list 'csq rmc-n))
(define rmc-a1 (list 'DIFFERENCE 'a rmc-c))
(dk-cite! 'fun-apply-type-c 'csq 'NN '(CLOPEN-SETS s) rmc-n)
(dk-cite! 'rmc-clopen-diff 's 'a rmc-c)
;; a \ csq(n) is covered below n
(dk-have! (rmc-cover-below rmc-a1 'csq rmc-n)
  (lambda ()
    (let* ((x (dk-di-var!))
           (dm (dk-cite! 'difference-membership 'a rmc-c x)))
      (dk-have! '(IN x a) (lambda () (rmc-prop! dm (list 'IN x rmc-a1))))
      (dk-have! (list 'NOT (list 'IN x rmc-c)) (lambda () (rmc-prop! dm (list 'IN x rmc-a1))))
      (let ((m (dk-skolem! (dk-apply! (dk-ctx-form (rmc-cover-below 'a 'csq (list 'succ rmc-n))) x))))
        (dk-cite! 'nn-succ-closed rmc-n)
        (use-em (list '< m rmc-n)
          (lambda () (ew m) (dk-conj-close! (lambda () (ass))))
          (lambda ()
            (dk-cite! 'nn-not-lt-le m rmc-n)
            (dk-have! (list 'NOT (list '< rmc-n m))
              (lambda ()
                (di)
                (dk-cite! 'nn-lt-succ-le rmc-n m)
                (dk-cite! 'nn-in-rr (list 'succ rmc-n))
                (dk-cite! 'nn-in-rr m)
                (dk-absurd! (list '<= (list 'succ rmc-n) m) (list '< m (list 'succ rmc-n))
                            (list 'IN (list 'succ rmc-n) 'RR) (list 'IN m 'RR))))
            (dk-cite! 'nn-not-lt-le rmc-n m)
            (dk-cite! 'nn-in-rr m)
            (dk-cite! 'nn-in-rr rmc-n)
            (rmc-antisym! m rmc-n)
            (dk-rewrite-h! (list 'IN 'x (list 'csq m)) m rmc-n)
            (rmc-prop! (list 'IN 'x rmc-c) (list 'NOT (list 'IN 'x rmc-c)))))))))
(define rmc-ih2 (dk-apply! rmc-ih 's 'lam 'csq))
(define rmc-x1 (list 'lam (rmc-ind 's rmc-a1)))
(define rmc-y1 (list 'lam (rmc-ind 's rmc-c)))
(define rmc-la (list 'lam (rmc-ind 's 'a)))
(define rmc-pn (rmc-prefix 's 'lam 'csq rmc-n))
(define rmc-fs (rmc-fseq 's 'lam 'csq))
(dk-apply! rmc-ih2 rmc-a1)
(dk-cite! 'rmc-ind-cover-le 's 'lam 'a rmc-c)
(dk-split-all! (list (dk-cite! 'rmc-ind-nonneg 's 'lam rmc-a1)))
(dk-split-all! (list (dk-cite! 'rmc-ind-nonneg 's 'lam rmc-c)))
(dk-split-all! (list (dk-cite! 'rmc-ind-nonneg 's 'lam 'a)))
(dk-split-all! (list (dk-cite! 'rmc-fseq-laws 's 'lam 'csq)))
(dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'k) (dk--occurs? rmc-fs f))) "fseq value") rmc-n)
(dk-cite! 'rps-prefix-succ rmc-fs rmc-n)
(dk-cite! 'rps-prefix-type rmc-fs rmc-n)
(dk-cite! 'fun-apply-type-c rmc-fs 'NN 'RR-POS-STAR rmc-n)
(dk-cite! 'rmc-rps-of-nonneg rmc-x1)
(dk-cite! 'rmc-rps-of-nonneg rmc-y1)
(dk-cite! 'rmc-rps-of-nonneg rmc-la)
(dk-cite! 'eplus-real-defined rmc-x1 rmc-y1)
(dk-cite! 'binplus-apply rmc-x1 rmc-y1)
(define rmc-e1 (list 'eplus rmc-x1 rmc-y1))
(define rmc-fn (list rmc-fs rmc-n))
(define rmc-e2 (list 'eplus rmc-pn rmc-fn))
;; lam(1_a) <= x + y = eplus(x, y)
(dk-have! (list '<= rmc-la rmc-e1)
  (lambda ()
    (subst (list '= rmc-e1 (list 'binplus rmc-x1 rmc-y1)))
    (subst (list '== (list 'binplus rmc-x1 rmc-y1) (list '+ rmc-x1 rmc-y1)))
    (ass)))
;; eplus(x, y) <= eplus(prefix_n, F(n))
(dk-have! (list '<= rmc-y1 rmc-fn)
  (lambda () (subst (list '= rmc-fn rmc-y1)) (dk-ineq! (list 'IN rmc-y1 'RR))))
(rmc-and2! (list '<= rmc-x1 rmc-pn) (list '<= rmc-y1 rmc-fn))
(dk-have! (list 'AND (list 'IN rmc-x1 'RR-POS-STAR) (list 'AND (list 'IN rmc-y1 'RR-POS-STAR)
            (list 'AND (list 'IN rmc-pn 'RR-POS-STAR) (list 'IN rmc-fn 'RR-POS-STAR))))
  (lambda () (dk-conj-close! (lambda () (ass)))))
(dk-cite! 'eplus-mono rmc-x1 rmc-y1 rmc-pn rmc-fn)
(rmc-and2! (list 'IN rmc-x1 'RR-POS-STAR) (list 'IN rmc-y1 'RR-POS-STAR))
(dk-cite! 'eplus-closed rmc-x1 rmc-y1)
(rmc-and2! (list 'IN rmc-pn 'RR-POS-STAR) (list 'IN rmc-fn 'RR-POS-STAR))
(dk-cite! 'eplus-closed rmc-pn rmc-fn)
(rmc-trans! rmc-la rmc-e1 rmc-e2)
(subst (list '= (rmc-prefix 's 'lam 'csq (list 'succ rmc-n)) rmc-e2))
(ass)
(qed 'rmc-prefix-bound)

;;; ITEM 3: COUNTABLE SUBADDITIVITY OF THE CONTENT on a compact space: a clopen
;;; set covered by a sequence of clopen sets has content at most the sum of
;;; theirs (the cover has a finite subcover, compact-closed-countable-subcover; then the
;;; finite stage, rmc-prefix-bound).  This is what the outer measure needs.
(sp (make-wff (list 'FORALL 's (list 'FORALL 'lam (list 'FORALL 'csq (list 'FORALL 'a
  (list 'IMPLIES '(IS-POSITIVE-FUNCTIONAL s lam) (list 'IMPLIES '(IS-COMPACT s)
  (list 'IMPLIES '(IN csq (FUN NN (CLOPEN-SETS s))) (list 'IMPLIES '(IN a (CLOPEN-SETS s))
    (list 'IMPLIES '(SUBSET a (BIG-UNION cvn_ NN (csq cvn_)))
      (list '<= '(lam (INDICATOR (PTS s) a)) (list 'ESUM (rmc-fseq 's 'lam 'csq))))))))))))))
(dk-peel!)
(define rmc-kc (dk-cite! 'is-compact 's))
(dk-have! '(IS-METRIC-SPACE s) (lambda () (rmc-prop! rmc-kc '(IS-COMPACT s))))
(dk-split-all! (list (dk-cite! 'rmc-clopen-parts 's 'a)))
(dk-have! '(FORALL n (IMPLIES (IN n NN) (IS-OPEN s (csq n))))
  (lambda ()
    (let ((n (dk-di-var!)))
      (dk-cite! 'fun-apply-type-c 'csq 'NN '(CLOPEN-SETS s) n)
      (dk-split-all! (list (dk-cite! 'rmc-clopen-parts 's (list 'csq n))))
      (ass))))
(dk-have! '(FORALL x (IMPLIES (IN x a) (FORSOME n (AND (IN n NN) (IN x (csq n))))))
  (lambda ()
    (let* ((x (dk-di-var!))
           (bu '(BIG-UNION cvn_ NN (csq cvn_))))
      (dk-cite! 'subset-mem-fwd 'a bu x)
      (let* ((l1 (dk-landed (lambda () (bu-me (list 'IN x bu)))))
             (jin (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) l1)))
        (ew (cadr jin))
        (dk-conj-close! (lambda () (ass)))))))
(define rmc-nf (dk-skolem! (dk-cite! 'compact-closed-countable-subcover 's 'a 'csq)))
(define rmc-pb (dk-apply! (dk-apply! (dk-cite! 'rmc-prefix-bound rmc-nf) 's 'lam 'csq) 'a))
(define rmc-fs (rmc-fseq 's 'lam 'csq))
(dk-split-all! (list (dk-cite! 'rmc-fseq-laws 's 'lam 'csq)))
(dk-apply! (dk-cite! 'esum-nn-prefix-le rmc-fs) rmc-nf)
(rmc-esum-type! rmc-fs)
(dk-cite! 'rps-prefix-type rmc-fs rmc-nf)
(dk-split-all! (list (dk-cite! 'rmc-ind-nonneg 's 'lam 'a)))
(dk-cite! 'rmc-rps-of-nonneg '(lam (INDICATOR (PTS s) a)))
(rmc-trans! '(lam (INDICATOR (PTS s) a)) (rmc-prefix 's 'lam 'csq rmc-nf) (list 'ESUM rmc-fs))
(ass)
(qed 'rmc-countable-subadditive)

;;; ITEM 3 (end): mu0 is a pre-measure on the clopen sets.
(sp (make-wff (list 'FORALL 's (list 'FORALL 'lam
  (list 'IMPLIES '(IS-POSITIVE-FUNCTIONAL s lam) (list 'IMPLIES '(IS-METRIC-SPACE s)
    (list 'IS-PREMEASURE '(PTS s) '(CLOPEN-SETS s) (rmc-mu0 's 'lam))))))))
(dk-peel!)
(dk-cite! 'ms-pts-is-set 's)
(dk-cite! 'rmc-clopen-sub-power 's)
(dk-split-all! (list (dk-cite! 'rmc-clopen-empty-whole 's)))
(dk-cite! 'rmc-clopen-set 's)
(dk-have! (list 'IN (rmc-mu0 's 'lam) '(FUN (CLOPEN-SETS s) RR-POS-STAR))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((u (dk-di-var!)))
          (dk-split-all! (list (dk-cite! 'rmc-ind-nonneg 's 'lam u)))
          (dk-cite! 'rmc-rps-of-nonneg (list 'lam (list 'INDICATOR '(PTS s) u)))
          (ass)))
      (lambda () (ass)))))
(dk-have! (list '= (list (rmc-mu0 's 'lam) 'EMPTY-SET) 0)
  (lambda ()
    (dk-cite! 'rmc-mu0-value 's 'lam 'EMPTY-SET)
    (dk-cite! 'rmc-ind-empty 's 'lam)
    (subst (list '= (list (rmc-mu0 's 'lam) 'EMPTY-SET) '(lam (INDICATOR (PTS s) EMPTY-SET))))
    (ass)))
(mac 'is-premeasure)
(dk-conj-close! (lambda () (ass)))
(qed 'rmc-premeasure)

;;; =====================================================================
;;; (E) THE OUTER MEASURE OF THE CONTENT AND ITS CARATHEODORY MEASURE (item 4)
;;; =====================================================================
;;; OUT = METHOD-I-OUTER(PTS s, CLOPEN-SETS s, mu0); SIG = CARATHEODORY-SETS(PTS s,
;;; OUT); MU = RES(OUT, SIG).  Written out in the statements (a function-valued
;;; term does not unfold in applied position; see outer-measure-construction.scm).
(define (rmc-out s lam) (list 'METHOD-I-OUTER (list 'PTS s) (list 'CLOPEN-SETS s) (rmc-mu0 s lam)))
(define (rmc-cs s lam e) (list 'COVER-SUMS (list 'PTS s) (list 'CLOPEN-SETS s) (rmc-mu0 s lam) e))
(define (rmc-sig s lam) (list 'CARATHEODORY-SETS (list 'PTS s) (rmc-out s lam)))
(define (rmc-mu s lam) (list 'RES (rmc-out s lam) (rmc-sig s lam)))

(sp (make-wff '(FORALL a (FORALL x (IMPLIES (IN x (POWER a)) (SUBSET x a))))))
(dk-peel!)
(mac 'subset-def)
(let ((z (dk-di-var!)))
  (dk-cite! 'power-mem-in 'a 'x z)
  (ass))
(qed 'rmc-power-subset)

;;; (rmc-basics! S LAM): the pre-measure, the outer measure, the clopen sets'
;;; sethood and inclusion in POWER(PTS S); needs PF and IS-METRIC-SPACE S.
(define (rmc-basics! s lam)
  (dk-cite! 'ms-pts-is-set s)
  (dk-cite! 'rmc-clopen-set s)
  (dk-cite! 'rmc-clopen-sub-power s)
  (dk-cite! 'rmc-premeasure s lam)
  (dk-cite! 'method-i-outer-is-outer-measure (list 'PTS s) (list 'CLOPEN-SETS s) (rmc-mu0 s lam))
  (let ((pc (dk-cite! 'is-premeasure (list 'PTS s) (list 'CLOPEN-SETS s) (rmc-mu0 s lam))))
    (dk-have! (list 'IN (rmc-mu0 s lam) (list 'FUN (list 'CLOPEN-SETS s) 'RR-POS-STAR))
      (lambda () (rmc-prop! pc (list 'IS-PREMEASURE (list 'PTS s) (list 'CLOPEN-SETS s) (rmc-mu0 s lam)))))))

;;; ITEM 4a: on a compact space the outer measure agrees with the content on clopen sets
(sp (make-wff (list 'FORALL 's (list 'FORALL 'lam (list 'FORALL 'a
  (list 'IMPLIES '(IS-POSITIVE-FUNCTIONAL s lam) (list 'IMPLIES '(IS-COMPACT s)
  (list 'IMPLIES '(IN a (CLOPEN-SETS s))
    (list '= (list (rmc-out 's 'lam) 'a) '(lam (INDICATOR (PTS s) a)))))))))))
(dk-peel!)
(define rmc-kc (dk-cite! 'is-compact 's))
(dk-have! '(IS-METRIC-SPACE s) (lambda () (rmc-prop! rmc-kc '(IS-COMPACT s))))
(rmc-basics! 's 'lam)
(dk-split-all! (list (dk-cite! 'rmc-clopen-parts 's 'a)))
(dk-cite! 'subset-mem-fwd '(CLOPEN-SETS s) '(POWER (PTS s)) 'a)
(define rmc-la '(lam (INDICATOR (PTS s) a)))
(define rmc-ei (list 'EINF (rmc-cs 's 'lam 'a)))
(dk-cite! 'method-i-outer-value '(PTS s) '(CLOPEN-SETS s) (rmc-mu0 's 'lam) 'a)
(subst (list '= (list (rmc-out 's 'lam) 'a) rmc-ei))
(dk-split-all! (list (dk-cite! 'rmc-ind-nonneg 's 'lam 'a)))
(dk-cite! 'rmc-rps-of-nonneg rmc-la)
(dk-have! '(SUBSET a a) (lambda () (mac 'subset-def) (dk-di-var!) (ass)))
(define rmc-le1 (dk-cite! 'method-i-outer-le-single '(PTS s) '(CLOPEN-SETS s) (rmc-mu0 's 'lam) 'a 'a))
(dk-cite! 'rmc-mu0-value 's 'lam 'a)
(dk-rewrite-h! rmc-le1 (list (rmc-mu0 's 'lam) 'a) rmc-la)
(dk-cite! 'cover-sums-subset '(PTS s) '(CLOPEN-SETS s) (rmc-mu0 's 'lam) 'a)
(dk-have! (list 'FORALL 'cpsx_ (list 'IMPLIES (list 'IN 'cpsx_ (rmc-cs 's 'lam 'a)) (list '<= rmc-la 'cpsx_)))
  (lambda ()
    (let* ((v (dk-di-var!))
           (cvs (dk-skolem! (dk-cite! 'cover-sums-elim '(PTS s) '(CLOPEN-SETS s) (rmc-mu0 's 'lam) 'a v))))
      (dk-cite! 'rmc-countable-subadditive 's 'lam cvs 'a)
      (subst (list '= v (list 'ESUM (rmc-fseq 's 'lam cvs))))
      (ass))))
(dk-cite! 'einf-greatest (rmc-cs 's 'lam 'a) rmc-la)
(dk-cite! 'einf-in (rmc-cs 's 'lam 'a))
(rmc-and2! (list 'IN rmc-ei 'RR-POS-STAR) (list 'IN rmc-la 'RR-POS-STAR))
(rmc-and2! (list '<= rmc-ei rmc-la) (list '<= rmc-la rmc-ei))
(dk-cite! 'rr-pos-star-le-antisymm rmc-ei rmc-la)
(ass)
(qed 'rmc-outer-on-clopen)

;;; ITEM 4b: every clopen set is Caratheodory-measurable for the outer measure.
;;; A cover csq of e gives the covers csq n a of e n a and csq \ a of e \ a, and
;;; lam(1_{c n a}) + lam(1_{c \ a}) <= lam(1_c) termwise (rmc-ind-split-ge).
(sp (make-wff (list 'FORALL 's (list 'FORALL 'lam (list 'FORALL 'a
  (list 'IMPLIES '(IS-POSITIVE-FUNCTIONAL s lam) (list 'IMPLIES '(IS-METRIC-SPACE s)
  (list 'IMPLIES '(IN a (CLOPEN-SETS s))
    (list 'IS-CARATHEODORY-MEASURABLE '(PTS s) (rmc-out 's 'lam) 'a)))))))))
(dk-peel!)
(rmc-basics! 's 'lam)
(dk-split-all! (list (dk-cite! 'rmc-clopen-parts 's 'a)))
(dk-cite! 'subset-mem-fwd '(CLOPEN-SETS s) '(POWER (PTS s)) 'a)
(define rmc-out1 (rmc-out 's 'lam))
(define rmc-m0 (rmc-mu0 's 'lam))
(define (rmc-ein e) (list 'EINF (rmc-cs 's 'lam e)))
(define rmc-claim
  (list 'FORALL 'a_ (list 'IMPLIES '(IN a_ (POWER (PTS s)))
    (list '<= (list 'eplus (list rmc-out1 '(INTERSECTION a_ a)) (list rmc-out1 '(DIFFERENCE a_ a)))
              (list rmc-out1 'a_)))))
(dk-have! rmc-claim
  (lambda ()
    (let* ((e (dk-di-var!))
           (e1 (list 'INTERSECTION e 'a))
           (e2 (list 'DIFFERENCE e 'a))
           (b (list 'eplus (rmc-ein e1) (rmc-ein e2))))
      (dk-cite! 'rmc-power-subset '(PTS s) e)
      (dk-cite! 'power-inter-closed '(PTS s) e 'a)
      (dk-cite! 'power-complement-closed '(PTS s) 'a)
      (dk-cite! 'power-inter-closed '(PTS s) e '(COMPLEMENT-IN (PTS s) a))
      (dk-cite! 'rmc-diff-inter '(PTS s) e 'a)
      (dk-have! (list 'IN e2 '(POWER (PTS s)))
        (lambda () (subst (list '= e2 (list 'INTERSECTION e '(COMPLEMENT-IN (PTS s) a)))) (ass)))
      (for-each (lambda (x)
                  (dk-cite! 'method-i-outer-value '(PTS s) '(CLOPEN-SETS s) rmc-m0 x)
                  (subst (list '= (list rmc-out1 x) (rmc-ein x)))
                  (dk-cite! 'cover-sums-subset '(PTS s) '(CLOPEN-SETS s) rmc-m0 x)
                  (dk-cite! 'einf-in (rmc-cs 's 'lam x)))
                (list e1 e2 e))
      (rmc-and2! (list 'IN (rmc-ein e1) 'RR-POS-STAR) (list 'IN (rmc-ein e2) 'RR-POS-STAR))
      (dk-cite! 'eplus-closed (rmc-ein e1) (rmc-ein e2))
      (dk-have! (list 'FORALL 'cpsx_ (list 'IMPLIES (list 'IN 'cpsx_ (rmc-cs 's 'lam e)) (list '<= b 'cpsx_)))
        (lambda ()
          (let* ((v (dk-di-var!))
                 (cvs (dk-skolem! (dk-cite! 'cover-sums-elim '(PTS s) '(CLOPEN-SETS s) rmc-m0 e v)))
                 (bu  (list 'BIG-UNION 'cvn_ 'NN (list cvs 'cvn_)))
                 (q1  (list 'VNB-LAMBDA 'rqk_ 'NN (list 'INTERSECTION (list cvs 'rqk_) 'a)))
                 (q2  (list 'VNB-LAMBDA 'rqk_ 'NN (list 'DIFFERENCE (list cvs 'rqk_) 'a)))
                 (f0  (rmc-fseq 's 'lam cvs))
                 (f1  (rmc-fseq 's 'lam q1))
                 (f2  (rmc-fseq 's 'lam q2)))
            ;; the two derived sequences of clopen sets
            (for-each
              (lambda (q thm)
                (dk-have! (list 'IN q '(FUN NN (CLOPEN-SETS s)))
                  (lambda ()
                    (dk-lam-type!
                      (lambda ()
                        (let ((k (dk-di-var!)))
                          (dk-cite! 'fun-apply-type-c cvs 'NN '(CLOPEN-SETS s) k)
                          (dk-cite! thm 's (list cvs k) 'a)
                          (ass)))))))
              (list q1 q2) (list 'rmc-clopen-inter 'rmc-clopen-diff))
            ;; they cover e n a and e \ a
            (for-each
              (lambda (q ex memthm)
                (dk-have! (list 'SUBSET ex (list 'BIG-UNION 'cvn_ 'NN (list q 'cvn_)))
                  (lambda ()
                    (mac 'subset-def)
                    (let* ((x (dk-di-var!))
                           (m1 (dk-cite! memthm e 'a x)))
                      (dk-have! (list 'IN x e) (lambda () (rmc-prop! m1 (list 'IN x ex))))
                      (dk-cite! 'subset-mem-fwd e bu x)
                      (let* ((l1 (dk-landed (lambda () (bu-me (list 'IN x bu)))))
                             (jin (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) l1))
                             (j (cadr jin))
                             (cj (list cvs j)))
                        (for-each
                          (lambda (l)
                            (dk-focus! l)
                            (if (equal? (dk-goal) (list 'IN j 'NN))
                                (ass)
                                (begin
                                  (dk-lam-b!)
                                  (let ((m2 (dk-cite! memthm cj 'a x)))
                                    (rmc-prop! m1 m2 (list 'IN x ex) (list 'IN x cj))))))
                          (dk-opened (lambda () (bu-mi j)))))))))
              (list q1 q2) (list e1 e2) (list 'intersection-membership 'difference-membership))
            ;; the cover sums of e n a and e \ a bound their EINFs
            (for-each
              (lambda (q ex fq)
                (dk-cite! 'cover-sums-intro '(PTS s) '(CLOPEN-SETS s) rmc-m0 ex q)
                (dk-cite! 'einf-lower (rmc-cs 's 'lam ex) (list 'ESUM fq)))
              (list q1 q2) (list e1 e2) (list f1 f2))
            ;; termwise: lam(1_{c n a}) + lam(1_{c \ a}) <= lam(1_c)
            (dk-split-all! (list (dk-cite! 'rmc-fseq-laws 's 'lam cvs)))
            (dk-split-all! (list (dk-cite! 'rmc-fseq-laws 's 'lam q1)))
            (dk-split-all! (list (dk-cite! 'rmc-fseq-laws 's 'lam q2)))
            (for-each rmc-esum-type! (list f0 f1 f2))
            (dk-have! (list 'FORALL 'k (list 'IMPLIES '(IN k NN)
                        (list '<= (list 'eplus (list f1 'k) (list f2 'k)) (list f0 'k))))
              (lambda ()
                (let* ((k (dk-di-var!))
                       (ck (list cvs k))
                       (x1 (list 'lam (rmc-ind 's (list 'INTERSECTION ck 'a))))
                       (y1 (list 'lam (rmc-ind 's (list 'DIFFERENCE ck 'a))))
                       (z1 (list 'lam (rmc-ind 's ck))))
                  (dk-cite! 'fun-apply-type-c cvs 'NN '(CLOPEN-SETS s) k)
                  (dk-cite! 'rmc-clopen-inter 's ck 'a)
                  (dk-cite! 'rmc-clopen-diff 's ck 'a)
                  (for-each (lambda (fq) (dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'k) (dk--occurs? fq f))) "value clause") k))
                            (list f0 f1 f2))
                  (subst (list '= (list f0 k) (list 'lam (rmc-ind 's ck))))
                  (subst (list '= (list f1 k) (list 'lam (rmc-ind 's (list q1 k)))))
                  (subst (list '= (list f2 k) (list 'lam (rmc-ind 's (list q2 k)))))
                  (dk-lam-b!)
                  (dk-split-all! (list (dk-cite! 'rmc-ind-nonneg 's 'lam (list 'INTERSECTION ck 'a))))
                  (dk-split-all! (list (dk-cite! 'rmc-ind-nonneg 's 'lam (list 'DIFFERENCE ck 'a))))
                  (dk-cite! 'rmc-ind-split-ge 's 'lam ck 'a)
                  (dk-cite! 'eplus-real-defined x1 y1)
                  (dk-cite! 'binplus-apply x1 y1)
                  (subst (list '= (list 'eplus x1 y1) (list 'binplus x1 y1)))
                  (subst (list '== (list 'binplus x1 y1) (list '+ x1 y1)))
                  (ass))))
            (dk-cite! 'esum-nn-superadditive f1 f2 f0)
            (let ((s1 (list 'ESUM f1)) (s2 (list 'ESUM f2)) (s0 (list 'ESUM f0)))
              (dk-have! (list 'AND (list 'IN (rmc-ein e1) 'RR-POS-STAR) (list 'AND (list 'IN (rmc-ein e2) 'RR-POS-STAR)
                          (list 'AND (list 'IN s1 'RR-POS-STAR) (list 'IN s2 'RR-POS-STAR))))
                (lambda () (dk-conj-close! (lambda () (ass)))))
              (rmc-and2! (list '<= (rmc-ein e1) s1) (list '<= (rmc-ein e2) s2))
              (dk-cite! 'eplus-mono (rmc-ein e1) (rmc-ein e2) s1 s2)
              (rmc-and2! (list 'IN s1 'RR-POS-STAR) (list 'IN s2 'RR-POS-STAR))
              (dk-cite! 'eplus-closed s1 s2)
              (subst (list '= v s0))
              (rmc-trans! b (list 'eplus s1 s2) s0)
              (ass)))))
      (dk-cite! 'einf-greatest (rmc-cs 's 'lam e) b)
      (ass))))
(dk-cite! 'caratheodory-superadditive-suffices '(PTS s) rmc-out1 'a)
(ass)
(qed 'rmc-clopen-measurable)

;;; ITEM 4c: THE MEASURE.  On a compact space s, a positive functional lam gives
;;; a measure MU on the sigma-algebra SIG of the Caratheodory sets of OUT; SIG
;;; contains the clopen sets and MU(u) = lam(1_u) on them.
(sp (make-wff (list 'FORALL 's (list 'FORALL 'lam
  (list 'IMPLIES '(IS-POSITIVE-FUNCTIONAL s lam) (list 'IMPLIES '(IS-COMPACT s)
    (list 'AND (list 'IS-MEASURE '(PTS s) (rmc-sig 's 'lam) (rmc-mu 's 'lam))
      (list 'AND (list 'SUBSET '(CLOPEN-SETS s) (rmc-sig 's 'lam))
        (list 'FORALL 'u (list 'IMPLIES '(IN u (CLOPEN-SETS s))
          (list '= (list (rmc-mu 's 'lam) 'u) '(lam (INDICATOR (PTS s) u)))))))))))))
(dk-peel!)
(define rmc-kc (dk-cite! 'is-compact 's))
(dk-have! '(IS-METRIC-SPACE s) (lambda () (rmc-prop! rmc-kc '(IS-COMPACT s))))
(rmc-basics! 's 'lam)
(define rmc-o (rmc-out 's 'lam))
(define rmc-sg (rmc-sig 's 'lam))
(dk-cite! 'caratheodory-measure '(PTS s) rmc-o)
(define rmc-oc (dk-cite! 'is-outer-measure '(PTS s) rmc-o))
(dk-have! (list 'IN rmc-o '(FUN (POWER (PTS s)) RR-POS-STAR))
  (lambda () (rmc-prop! rmc-oc (list 'IS-OUTER-MEASURE '(PTS s) rmc-o))))
(dk-project! (list 'IN rmc-o '(FUN (POWER (PTS s)))) 'fun-codomain-iff (list 'IN rmc-o '(FUN (POWER (PTS s)) RR-POS-STAR)))
(dk-have! (list 'SUBSET rmc-sg '(POWER (PTS s)))
  (lambda ()
    (mac 'subset-def)
    (let* ((x (dk-di-var!))
           (c (dk-cite! 'caratheodory-sets-membership '(PTS s) rmc-o x)))
      (rmc-prop! c (list 'IN x rmc-sg)))))
(dk-have! (list 'SUBSET '(CLOPEN-SETS s) rmc-sg)
  (lambda ()
    (mac 'subset-def)
    (let* ((u (dk-di-var!)))
      (dk-cite! 'subset-mem-fwd '(CLOPEN-SETS s) '(POWER (PTS s)) u)
      (dk-cite! 'rmc-clopen-measurable 's 'lam u)
      (let ((c (dk-cite! 'caratheodory-sets-membership '(PTS s) rmc-o u)))
        (rmc-prop! c (list 'IN u '(POWER (PTS s))) (list 'IS-CARATHEODORY-MEASURABLE '(PTS s) rmc-o u))))))
(dk-have! (list 'FORALL 'u (list 'IMPLIES '(IN u (CLOPEN-SETS s))
            (list '= (list (rmc-mu 's 'lam) 'u) '(lam (INDICATOR (PTS s) u)))))
  (lambda ()
    (let ((u (dk-di-var!)))
      (dk-cite! 'subset-mem-fwd '(CLOPEN-SETS s) rmc-sg u)
      (rmc-and3! (list 'IN rmc-o '(FUN (POWER (PTS s)))) (list 'SUBSET rmc-sg '(POWER (PTS s))) (list 'IN u rmc-sg))
      (dk-cite! 'res-apply '(POWER (PTS s)) rmc-sg rmc-o u)
      (dk-cite! 'rmc-outer-on-clopen 's 'lam u)
      (subst (list '= (list (rmc-mu 's 'lam) u) (list rmc-o u)))
      (ass))))
(dk-conj-close! (lambda () (ass)))
(qed 'rmc-measure)

;;; =====================================================================
;;; (F) ON THE CANTOR MODEL K: EVERY OPEN SET, HENCE EVERY BOREL SET, IS MEASURABLE
;;; =====================================================================
(define rmc-ks '(RM-KMS s dseq))
(define rmc-kp '(PTS (RM-KMS s dseq)))
(define (rmc-cyl e nb) (list 'RM-CYL 's 'dseq e nb))

;;; points of one cylinder have the same cylinders: e' in CYL(e, nb) => CYL(e', nb) = CYL(e, nb)
(sp (make-wff '(FORALL s (FORALL dseq (FORALL e (FORALL ep_ (FORALL nb
  (IMPLIES (IN e (RM-K s dseq)) (IMPLIES (IN ep_ (RM-CYL s dseq e nb))
    (= (RM-CYL s dseq ep_ nb) (RM-CYL s dseq e nb)))))))))))
(dk-peel!)
(dk-cite! 'rmc-cyl-set 's 'dseq 'e 'nb)
(dk-cite! 'rmc-cyl-set 's 'dseq 'ep_ 'nb)
(define rmc-ag (dk-cite! 'rmm-cyl-mem 's 'dseq 'e 'nb 'ep_))
(define rmc-agf (caddr (caddr rmc-ag)))
(dk-have! rmc-agf (lambda () (rmc-prop! rmc-ag '(IN ep_ (RM-CYL s dseq e nb)))))
(rmc-ext! '(RM-CYL s dseq ep_ nb) '(RM-CYL s dseq e nb)
  (lambda (x)
    (let* ((c1 (dk-cite! 'rmm-cyl-mem 's 'dseq 'ep_ 'nb x))
           (c2 (dk-cite! 'rmm-cyl-mem 's 'dseq 'e 'nb x))
           (agp (caddr (caddr c1)))
           (age (caddr (caddr c2))))
      (dk-have! (list 'IFF agp age)
        (lambda ()
          (dk-iff! (lambda (g) (equal? g age))
            (lambda ()
              (let ((i (dk-di-var!)))
                (di)
                (dk-apply! agp i)
                (dk-apply! rmc-agf i)
                (subst (list '= (list x i) (list 'ep_ i)))
                (ass)))
            (lambda ()
              (let ((i (dk-di-var!)))
                (di)
                (dk-apply! age i)
                (dk-apply! rmc-agf i)
                (subst (list '= (list 'ep_ i) (list 'e i)))
                (ass)))))))))
(qed 'rmc-cyl-same)

;;; (rmc-kpts!): (== (PTS (RM-KMS s dseq)) (RM-K s dseq)), K's metric and sethood, in context
(define (rmc-kpts!)
  (dk-cite! 'rmm-kms-pts 's 'dseq)
  (dk-cite! 'rmm-kms-metric 's 'dseq)
  (dk-cite! 'rmm-k-set 's 'dseq))

(define (rmc-saturated w nb)
  (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y w)
    (list 'FORALL 'z (list 'IMPLIES (list 'IN 'z (rmc-cyl 'y nb)) (list 'IN 'z w))))))

;;; a subset of K that contains, with each point, its cylinder of length nb, is open in K
(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'FORALL 'w (list 'FORALL 'nb
  (list 'IMPLIES '(IN nb NN) (list 'IMPLIES '(SUBSET w (RM-K s dseq))
    (list 'IMPLIES (rmc-saturated 'w 'nb) (list 'IS-OPEN rmc-ks 'w))))))))))
(dk-peel!)
(rmc-kpts!)
(define rmc-satf (dk-ctx-form (rmc-saturated 'w 'nb)))
(mac 'is-open)
(for-each
  (lambda (leaf)
    (dk-focus! leaf)
    (let ((g (dk-goal)))
      (cond ((dk-head-is? g 'SUBSET) (subst (list '== rmc-kp '(RM-K s dseq))) (ass))
            ((dk-head-is? g 'FORALL)
             (let* ((y (dk-di-var!)))
               (dk-cite! 'subset-mem-fwd 'w '(RM-K s dseq) y)
               (dk-cite! 'rmm-cyl-self 's 'dseq y 'nb)
               (dk-cite! 'rmm-cyl-open 's 'dseq y 'nb)
               (let* ((oc (dk-cite! 'is-open rmc-ks (rmc-cyl y 'nb)))
                      (ocl (caddr (caddr (caddr oc)))))
                 (dk-have! ocl (lambda () (rmc-prop! oc (list 'IS-OPEN rmc-ks (rmc-cyl y 'nb)))))
                 (let ((r (dk-skolem! (dk-apply! ocl y))))
                   (ew r)
                   (rmc-and-focus! 'SUBSET)
                   (mac 'subset-def)
                   (let ((z (dk-di-var!)))
                     (dk-cite! 'subset-mem-fwd (list 'BALL rmc-ks y r) (rmc-cyl y 'nb) z)
                     (dk-apply! rmc-satf y z)
                     (ass))))))
            (#t (ass)))))
  (rmc-split-goal!))
(qed 'rmc-saturated-open)

;;; ... and closed: its complement in K is saturated too.  So it is clopen.
(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'FORALL 'w (list 'FORALL 'nb
  (list 'IMPLIES '(IN nb NN) (list 'IMPLIES '(SUBSET w (RM-K s dseq))
    (list 'IMPLIES (rmc-saturated 'w 'nb) (list 'IN 'w (list 'CLOPEN-SETS rmc-ks)))))))))))
(dk-peel!)
(rmc-kpts!)
(define rmc-satf (dk-ctx-form (rmc-saturated 'w 'nb)))
(dk-cite! 'rmc-saturated-open 's 'dseq 'w 'nb)
(define rmc-cw (list 'COMPLEMENT-IN rmc-kp 'w))
(dk-cite! 'complement-in-subset 'w rmc-kp)
(dk-cite! 'complement-in-subset 'w '(RM-K s dseq))
(dk-have! (list 'SUBSET rmc-cw '(RM-K s dseq))
  (lambda () (subst (list '== rmc-kp '(RM-K s dseq))) (ass)))
(dk-have! (rmc-saturated rmc-cw 'nb)
  (lambda ()
    (let* ((y (dk-di-var!))
           (z (cadr (dk-goal)))
           (cy (dk-cite! 'complement-in-membership rmc-kp 'w y))
           (cz (dk-cite! 'complement-in-membership rmc-kp 'w z)))
      (dk-have! (list 'IN y rmc-kp) (lambda () (rmc-prop! cy (list 'IN y rmc-cw))))
      (dk-have! (list 'NOT (list 'IN y 'w)) (lambda () (rmc-prop! cy (list 'IN y rmc-cw))))
      (dk-rewrite-h! (list 'IN y rmc-kp) rmc-kp '(RM-K s dseq))
      (let ((zm (dk-cite! 'rmm-cyl-mem 's 'dseq y 'nb z)))
        (dk-have! (list 'IN z '(RM-K s dseq)) (lambda () (rmc-prop! zm (list 'IN z (rmc-cyl y 'nb))))))
      (dk-have! (list 'IN z rmc-kp) (lambda () (subst (list '== rmc-kp '(RM-K s dseq))) (ass)))
      (dk-have! (list 'NOT (list 'IN z 'w))
        (lambda ()
          (di)
          (dk-cite! 'rmc-cyl-same 's 'dseq y z 'nb)
          (dk-cite! 'rmm-cyl-self 's 'dseq y 'nb)
          (dk-have! (list 'IN y (rmc-cyl z 'nb))
            (lambda () (subst (list '= (rmc-cyl z 'nb) (rmc-cyl y 'nb))) (ass)))
          (dk-apply! rmc-satf z y)
          (rmc-prop! (list 'IN y 'w) (list 'NOT (list 'IN y 'w)))))
      (rmc-prop! cz (list 'IN z rmc-kp) (list 'NOT (list 'IN z 'w))))))
(dk-cite! 'rmc-saturated-open 's 'dseq rmc-cw 'nb)
(dk-have! (list 'SUBSET 'w rmc-kp) (lambda () (subst (list '== rmc-kp '(RM-K s dseq))) (ass)))
(define rmc-clc (dk-cite! 'is-closed rmc-ks 'w))
(dk-have! (list 'IS-CLOSED rmc-ks 'w)
  (lambda () (rmc-prop! rmc-clc (list 'IS-METRIC-SPACE rmc-ks) (list 'SUBSET 'w rmc-kp) (list 'IS-OPEN rmc-ks rmc-cw))))
(dk-cite! 'rmc-clopen-intro rmc-ks 'w)
(ass)
(qed 'rmc-saturated-clopen)

;;; W(ou_, nb): the points of K whose cylinder of length nb lies in ou_.
(define (rmc-w ou nb) (list 'SEP 'rwe_ '(RM-K s dseq) (list 'SUBSET (rmc-cyl 'rwe_ nb) ou)))
(define (rmc-wf ou) (list 'VNB-LAMBDA 'rwk_ 'NN (rmc-w ou 'rwk_)))

(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'FORALL 'ou_ (list 'FORALL 'nb (list 'FORALL 'x
  (list 'IFF (list 'IN 'x (rmc-w 'ou_ 'nb)) (list 'AND '(IN x (RM-K s dseq)) (list 'SUBSET (rmc-cyl 'x 'nb) 'ou_))))))))))
(dk-peel!)
(rmc-sep-iff!)
(qed 'rmc-w-mem)

;;; W(ou_, nb) is clopen in K (for ANY ou_): it is saturated
(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'FORALL 'ou_ (list 'FORALL 'nb
  (list 'IMPLIES '(IN nb NN) (list 'IN (rmc-w 'ou_ 'nb) (list 'CLOPEN-SETS rmc-ks)))))))))
(dk-peel!)
(rmc-kpts!)
(define rmc-ww (rmc-w 'ou_ 'nb))
(dk-have! (list 'SUBSET rmc-ww '(RM-K s dseq))
  (lambda ()
    (mac 'subset-def)
    (let* ((x (dk-di-var!))
           (c (dk-cite! 'rmc-w-mem 's 'dseq 'ou_ 'nb x)))
      (rmc-prop! c (list 'IN x rmc-ww)))))
(dk-have! (rmc-saturated rmc-ww 'nb)
  (lambda ()
    (let* ((y (dk-di-var!))
           (z (cadr (dk-goal)))
           (cy (dk-cite! 'rmc-w-mem 's 'dseq 'ou_ 'nb y))
           (cz (dk-cite! 'rmc-w-mem 's 'dseq 'ou_ 'nb z)))
      (dk-have! (list 'IN y '(RM-K s dseq)) (lambda () (rmc-prop! cy (list 'IN y rmc-ww))))
      (dk-have! (list 'SUBSET (rmc-cyl y 'nb) 'ou_) (lambda () (rmc-prop! cy (list 'IN y rmc-ww))))
      (let ((zm (dk-cite! 'rmm-cyl-mem 's 'dseq y 'nb z)))
        (dk-have! (list 'IN z '(RM-K s dseq)) (lambda () (rmc-prop! zm (list 'IN z (rmc-cyl y 'nb))))))
      (dk-cite! 'rmc-cyl-same 's 'dseq y z 'nb)
      (dk-have! (list 'SUBSET (rmc-cyl z 'nb) 'ou_)
        (lambda () (subst (list '= (rmc-cyl z 'nb) (rmc-cyl y 'nb))) (ass)))
      (rmc-prop! cz (list 'IN z '(RM-K s dseq)) (list 'SUBSET (rmc-cyl z 'nb) 'ou_)))))
(dk-cite! 'rmc-saturated-clopen 's 'dseq rmc-ww 'nb)
(ass)
(qed 'rmc-w-clopen)

;;; an open set of K is the union of its W's (rmm-cyl-base)
(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'FORALL 'ou_
  (list 'IMPLIES (list 'IS-OPEN rmc-ks 'ou_)
    (list '= 'ou_ (list 'BIG-UNION 'n_ 'NN (list (rmc-wf 'ou_) 'n_)))))))))
(dk-peel!)
(rmc-kpts!)
(define rmc-oc (dk-cite! 'is-open rmc-ks 'ou_))
(dk-have! (list 'SUBSET 'ou_ rmc-kp) (lambda () (rmc-prop! rmc-oc (list 'IS-OPEN rmc-ks 'ou_))))
(define rmc-bu (list 'BIG-UNION 'n_ 'NN (list (rmc-wf 'ou_) 'n_)))
(rmc-ext! 'ou_ rmc-bu
  (lambda (x)
    (dk-have! (list 'IMPLIES (list 'IN x 'ou_) (list 'IN x rmc-bu))
      (lambda ()
        (di)
        (dk-cite! 'subset-mem-fwd 'ou_ rmc-kp x)
        (dk-rewrite-h! (list 'IN x rmc-kp) rmc-kp '(RM-K s dseq))
        (let ((nb (dk-skolem! (dk-cite! 'rmm-cyl-base 's 'dseq 'ou_ x))))
          (for-each
            (lambda (l)
              (dk-focus! l)
              (if (equal? (dk-goal) (list 'IN nb 'NN))
                  (ass)
                  (begin
                    (dk-lam-b!)
                    (let ((c (dk-cite! 'rmc-w-mem 's 'dseq 'ou_ nb x)))
                      (rmc-prop! c (list 'IN x '(RM-K s dseq)) (list 'SUBSET (rmc-cyl x nb) 'ou_))))))
            (dk-opened (lambda () (bu-mi nb)))))))
    (dk-have! (list 'IMPLIES (list 'IN x rmc-bu) (list 'IN x 'ou_))
      (lambda ()
        (di)
        (let* ((l1 (dk-landed (lambda () (bu-me (list 'IN x rmc-bu)))))
               (jin (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) l1))
               (j (cadr jin))
               (h (find-first (lambda (f) (and (dk-head-is? f 'IN) (equal? (cadr f) x))) l1)))
          (dk-lam-b-h! h)
          (let ((c (dk-cite! 'rmc-w-mem 's 'dseq 'ou_ j x)))
            (dk-have! (list 'IN x '(RM-K s dseq)) (lambda () (rmc-prop! c (list 'IN x (rmc-w 'ou_ j)))))
            (dk-have! (list 'SUBSET (rmc-cyl x j) 'ou_) (lambda () (rmc-prop! c (list 'IN x (rmc-w 'ou_ j))))))
          (dk-cite! 'rmm-cyl-self 's 'dseq x j)
          (dk-cite! 'subset-mem-fwd (rmc-cyl x j) 'ou_ x)
          (ass))))))
(qed 'rmc-open-union-w)

;;; ITEM 4d: on K, every open set is measurable, hence every Borel set.
(define (rmc-ksig lam) (rmc-sig rmc-ks lam))
(define (rmc-kmu lam) (rmc-mu rmc-ks lam))

;;; (rmc-k-measure-parts! LAM): with PF(K, LAM) in context, land the measure,
;;; the sigma-algebra and its countable-union clause; return the clause.
(define (rmc-k-measure-parts! lam)
  (dk-cite! 'rmm-k-compact 's 'dseq)
  (dk-split-all! (list (dk-cite! 'rmc-measure rmc-ks lam)))
  (let* ((mc (dk-cite! 'is-measure rmc-kp (rmc-ksig lam) (rmc-kmu lam)))
         (sa (list 'IS-SIGMA-ALGEBRA rmc-kp (rmc-ksig lam))))
    (dk-have! sa (lambda () (rmc-prop! mc (list 'IS-MEASURE rmc-kp (rmc-ksig lam) (rmc-kmu lam)))))
    (let* ((sc (dk-cite! 'is-sigma-algebra rmc-kp (rmc-ksig lam)))
           (ucl (caddr (caddr (caddr (caddr (caddr sc)))))))
      (dk-have! ucl (lambda () (rmc-prop! sc sa)))
      ucl)))

(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'FORALL 'lam (list 'FORALL 'ou_
  (list 'IMPLIES (list 'IS-POSITIVE-FUNCTIONAL rmc-ks 'lam) (list 'IMPLIES (list 'IS-OPEN rmc-ks 'ou_)
    (list 'IN 'ou_ (rmc-ksig 'lam))))))))))
(dk-peel!)
(rmc-kpts!)
(define rmc-ucl (rmc-k-measure-parts! 'lam))
(define rmc-wfo (rmc-wf 'ou_))
(dk-have! (list 'IN rmc-wfo (list 'FUN 'NN (rmc-ksig 'lam)))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((k (dk-di-var!)))
          (dk-cite! 'rmc-w-clopen 's 'dseq 'ou_ k)
          (dk-cite! 'subset-mem-fwd (list 'CLOPEN-SETS rmc-ks) (rmc-ksig 'lam) (rmc-w 'ou_ k))
          (ass))))))
(dk-apply! rmc-ucl rmc-wfo)
(dk-cite! 'rmc-open-union-w 's 'dseq 'ou_)
(subst (list '= 'ou_ (list 'BIG-UNION 'n_ 'NN (list rmc-wfo 'n_))))
(ass)
(qed 'rmc-k-open-measurable)

;;; ITEM 4, THE STATEMENT ON K: a positive functional lam on C(K) gives a measure
;;; MU on a sigma-algebra SIG containing every Borel set of K, with MU(u) =
;;; lam(1_u) on every clopen u (in particular on every cylinder).
(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'FORALL 'lam
  (list 'IMPLIES (list 'IS-POSITIVE-FUNCTIONAL rmc-ks 'lam)
    (list 'AND (list 'IS-MEASURE rmc-kp (rmc-ksig 'lam) (rmc-kmu 'lam))
      (list 'AND (list 'SUBSET (list 'BOREL-SETS rmc-ks) (rmc-ksig 'lam))
        (list 'AND (list 'SUBSET (list 'CLOPEN-SETS rmc-ks) (rmc-ksig 'lam))
          (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u (list 'CLOPEN-SETS rmc-ks))
            (list '= (list (rmc-kmu 'lam) 'u) (list 'lam (list 'INDICATOR rmc-kp 'u))))))))))))))
(dk-peel!)
(rmc-kpts!)
(define rmc-ucl (rmc-k-measure-parts! 'lam))
(define rmc-sa (list 'IS-SIGMA-ALGEBRA rmc-kp (rmc-ksig 'lam)))
(define rmc-opens (list 'SEP 'mou_ (list 'POWER rmc-kp) (list 'IS-OPEN rmc-ks 'mou_)))
(dk-have! (list 'SUBSET rmc-opens (rmc-ksig 'lam))
  (lambda ()
    (mac 'subset-def)
    (let* ((u (dk-di-var!)))
      (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN u rmc-opens)))))
      (dk-cite! 'rmc-k-open-measurable 's 'dseq 'lam u)
      (ass))))
(dk-have! (list 'SUBSET (list 'BOREL-SETS rmc-ks) (rmc-ksig 'lam))
  (lambda ()
    (mac 'subset-def)
    (let* ((x (dk-di-var!)))
      (dk-cite! 'borel-sets-unfold rmc-ks)
      (dk-rewrite-h! (list 'IN x (list 'BOREL-SETS rmc-ks)) (list 'BOREL-SETS rmc-ks) (list 'SIGMA-GENERATED rmc-kp rmc-opens))
      (dk-cite! 'sigma-generated-in-every rmc-kp rmc-opens x (rmc-ksig 'lam))
      (ass))))
(dk-conj-close! (lambda () (ass)))
(qed 'rmc-k-measure)

;;; =====================================================================
;;; (G) CONTINUOUS FUNCTIONS: OPEN TAILS, BOUNDEDNESS ON A COMPACT SPACE
;;; =====================================================================

;;; (rmc-tail-open-proof! DIR): the proof of IS-OPEN m {x : g(x) < c} (DIR 'lt)
;;; or {x : c < g(x)} (DIR 'gt), after dk-peel!.
(define (rmc-tail-open-proof! dir)
  (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 'm 'g)))
  (let* ((rel (lambda (t) (if (eq? dir 'lt) (list '< t 'c) (list '< 'c t))))
         (st  (list 'SEP 'x_ '(PTS m) (rel '(g x_))))
         (ccl (dk-ctx-form '(FORALL a (IMPLIES (IN a (PTS m)) (IS-CONTINUOUS-AT m RR-MS g a))))))
    (mac 'is-open)
    (for-each
      (lambda (leaf)
        (dk-focus! leaf)
        (let ((goal (dk-goal)))
          (cond
            ((dk-head-is? goal 'SUBSET)
             (mac 'subset-def)
             (let ((z (dk-di-var!)))
               (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN z st)))))
               (ass)))
            ((dk-head-is? goal 'FORALL)
             (let* ((y (dk-di-var!))
                    (_ (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN y st))))))
                    (gy (list 'g y))
                    (e (if (eq? dir 'lt) (list '- 'c gy) (list '- gy 'c))))
               (dk-cite! 'fun-apply-type-c 'g '(PTS m) 'RR y)
               (dk-have! (list 'IN e 'RR) (lambda () (in-rr)))
               (dk-have! (list '< 0 e) (lambda () (dk-ineq! (rel gy) (list 'IN gy 'RR) '(IN c RR))))
               (dk-cite! 'rr-pos-rr-of-lt e)
               (let* ((e2 (dk-halve! e))
                      (_2 (dk-apply! ccl y))
                      (cc (dk-cite! 'is-continuous-at 'm 'RR-MS 'g y))
                      (cl (caddr (caddr (caddr (caddr (caddr cc)))))))
                 (dk-have! cl (lambda () (rmc-prop! cc (list 'IS-CONTINUOUS-AT 'm 'RR-MS 'g y))))
                 (let* ((d (dk-skolem! (dk-apply! cl e2)))
                        (dcl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'b) (dk--occurs? d f))) "delta clause")))
                   (rmc-pos! d)
                   (ew d)
                   (rmc-and-focus! 'SUBSET)
                   (mac 'subset-def)
                   (let* ((z (dk-di-var!))
                          (bm (dk-cite! 'ball-membership 'm y d z))
                          (zb (list 'IN z (list 'BALL 'm y d))))
                     (dk-have! (list 'IN z '(PTS m)) (lambda () (rmc-prop! bm zb)))
                     (dk-have! (list '<= (rmc-d 'm y z) d) (lambda () (rmc-prop! bm zb)))
                     (let* ((u1 (dk-apply! dcl z))
                            (gz (list 'g z)))
                       (dk-cite! 'fun-apply-type-c 'g '(PTS m) 'RR z)
                       (dk-cite! 'rr-ms-dist gy gz)
                       (let* ((u2 (dk-rewrite-h! u1 (rmc-d 'RR-MS gy gz) (list 'abs (list '- gy gz))))
                              (df (list '- gy gz)))
                         (dk-have! (list 'IN df 'RR) (lambda () (in-rr)))
                         (dk-split-all! (list (dk-cite! 'rr-abs-le-parts df e2)))
                         (dk-have! (rel gz)
                           (lambda () (dk-ineq! (list '<= (list '- e2) df) (list '<= df e2)
                                                (list '= (list '+ e2 e2) e) (list '< 0 e2)
                                                (list 'IN gy 'RR) (list 'IN gz 'RR) '(IN c RR) (list 'IN e2 'RR))))
                         (dk-close-all! (lambda () (sep-mi))))))))))
            (#t (ass)))))
      (rmc-split-goal!))))

(sp (make-wff '(FORALL m (FORALL g (FORALL c (IMPLIES (IN g (CONT-FNS m)) (IMPLIES (IN c RR)
  (IS-OPEN m (SEP x_ (PTS m) (< (g x_) c))))))))))
(dk-peel!)
(rmc-tail-open-proof! 'lt)
(qed 'rmc-lt-set-open)

(sp (make-wff '(FORALL m (FORALL g (FORALL c (IMPLIES (IN g (CONT-FNS m)) (IMPLIES (IN c RR)
  (IS-OPEN m (SEP x_ (PTS m) (< c (g x_)))))))))))
(dk-peel!)
(rmc-tail-open-proof! 'gt)
(qed 'rmc-gt-set-open)


;;; A CONTINUOUS REAL FUNCTION ON A COMPACT SPACE IS BOUNDED: the open sets
;;; { -n < g < n } cover the space; a finite subcover (compact-closed-countable-subcover).
(define rmc-bset '(VNB-LAMBDA rbn_ NN (INTERSECTION (SEP x_ (PTS m) (< (g x_) rbn_)) (SEP x_ (PTS m) (< (- rbn_) (g x_))))))
(define (rmc-bset-at n) (list 'INTERSECTION (list 'SEP 'x_ '(PTS m) (list '< '(g x_) n)) (list 'SEP 'x_ '(PTS m) (list '< (list '- n) '(g x_)))))
(sp (make-wff '(FORALL m (FORALL g (IMPLIES (IS-COMPACT m) (IMPLIES (IN g (CONT-FNS m))
  (FORSOME bd_ (AND (IN bd_ RR) (AND (<= 0 bd_)
    (FORALL x (IMPLIES (IN x (PTS m)) (<= (abs (g x)) bd_))))))))))))
(dk-peel!)
(define rmc-kc (dk-cite! 'is-compact 'm))
(dk-have! '(IS-METRIC-SPACE m) (lambda () (rmc-prop! rmc-kc '(IS-COMPACT m))))
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts 'm 'g)))
(dk-have! '(SUBSET (PTS m) (PTS m)) (lambda () (mac 'subset-def) (dk-di-var!) (ass)))
(dk-cite! 'complement-in-of-subset-empty '(PTS m) '(PTS m))
(dk-cite! 'empty-is-open 'm)
(rmc-closed-by-compl! 'm '(PTS m) 'EMPTY-SET)
(dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IS-OPEN 'm (list rmc-bset 'n))))
  (lambda ()
    (let* ((n (dk-di-var!))
           (a1 (list 'SEP 'x_ '(PTS m) (list '< '(g x_) n)))
           (a2 (list 'SEP 'x_ '(PTS m) (list '< (list '- n) '(g x_)))))
      (dk-lam-b!)
      (dk-cite! 'nn-in-rr n)
      (dk-have! (list 'IN (list '- n) 'RR) (lambda () (in-rr)))
      (dk-cite! 'rmc-lt-set-open 'm 'g n)
      (dk-cite! 'rmc-gt-set-open 'm 'g (list '- n))
      (rmc-and2! (list 'IS-OPEN 'm a1) (list 'IS-OPEN 'm a2))
      (dk-cite! 'inter-of-opens-open 'm a1 a2)
      (ass))))
;;; (rmc-in-bset! X N): with (IN X (PTS m)), (< (g X) N), (< (- N) (g X)) in context,
;;; close the goal (IN X (bset N)) after beta.
(define (rmc-in-bset! x n)
  (dk-lam-b!)
  (mac 'intersection-membership)
  (dk-conj-close! (lambda () (dk-close-all! (lambda () (sep-mi))))))
(dk-have! (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS m)) (list 'FORSOME 'n (list 'AND '(IN n NN) (list 'IN 'x (list rmc-bset 'n))))))
  (lambda ()
    (let* ((x (dk-di-var!))
           (gx (list 'g x))
           (t (list '+ (list 'abs gx) 1)))
      (dk-cite! 'fun-apply-type-c 'g '(PTS m) 'RR x)
      (dk-cite! 'rr-abs-closed gx)
      (dk-have! (list 'IN t 'RR) (lambda () (in-rr)))
      (dk-have! '(IN 1 RR) (lambda () (from-context!)))
      (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
      (dk-cite! 'rr-pos-rr-of-lt 1)
      (let ((nv (dk-skolem! (dk-cite! 'rr-archimedean-multiple 1 t))))
        (dk-cite! 'nn-in-rr nv)
        (dk-have! (list '<= (list 'abs gx) (list 'abs gx)) (lambda () (dk-ineq! (list 'IN (list 'abs gx) 'RR))))
        (dk-split-all! (list (dk-cite! 'rr-abs-le-parts gx (list 'abs gx))))
        (let ((prem (list (list '<= t (list '* nv 1)) (list '<= (list '- (list 'abs gx)) gx) (list '<= gx (list 'abs gx))
                          (list 'IN gx 'RR) (list 'IN (list 'abs gx) 'RR) (list 'IN nv 'RR))))
          (dk-have! (list '< gx nv) (lambda () (apply dk-ineq! prem)))
          (dk-have! (list '< (list '- nv) gx) (lambda () (apply dk-ineq! prem))))
        (ew nv)
        (dk-conj-close!
          (lambda ()
            (if (eq? (caddr (dk-goal)) 'NN)
                (ass)
                (rmc-in-bset! x nv))))))))
(define rmc-n0 (dk-skolem! (dk-cite! 'compact-closed-countable-subcover 'm '(PTS m) rmc-bset)))
(define rmc-cb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk--occurs? rmc-n0 f) (dk--occurs? rmc-bset f))) "the finite cover"))
(dk-cite! 'nn-in-rr rmc-n0)
(dk-cite! 'nn-zero-le rmc-n0)
(ew rmc-n0)
(rmc-and-focus! 'FORALL)
(define rmc-x (dk-di-var!))
(define rmc-n (dk-skolem! (dk-apply! rmc-cb rmc-x)))
(define rmc-gx (list 'g rmc-x))
(dk-lam-b-h! (list 'IN rmc-x (list rmc-bset rmc-n)))
(define rmc-im (dk-cite! 'intersection-membership (list 'SEP 'x_ '(PTS m) (list '< '(g x_) rmc-n))
                         (list 'SEP 'x_ '(PTS m) (list '< (list '- rmc-n) '(g x_))) rmc-x))
(dk-have! (list 'IN rmc-x (list 'SEP 'x_ '(PTS m) (list '< '(g x_) rmc-n)))
  (lambda () (rmc-prop! rmc-im (list 'IN rmc-x (rmc-bset-at rmc-n)))))
(dk-have! (list 'IN rmc-x (list 'SEP 'x_ '(PTS m) (list '< (list '- rmc-n) '(g x_))))
  (lambda () (rmc-prop! rmc-im (list 'IN rmc-x (rmc-bset-at rmc-n)))))
(dk-split-all! (dk-landed (lambda () (sep-me (list 'IN rmc-x (list 'SEP 'x_ '(PTS m) (list '< '(g x_) rmc-n)))))))
(dk-split-all! (dk-landed (lambda () (sep-me (list 'IN rmc-x (list 'SEP 'x_ '(PTS m) (list '< (list '- rmc-n) '(g x_))))))))
(dk-cite! 'fun-apply-type-c 'g '(PTS m) 'RR rmc-x)
(dk-cite! 'nn-in-rr rmc-n)
(dk-have! '(IN 0 RR) (lambda () (from-context!)))
(rmc-abs-le! rmc-gx rmc-n0 (list '< rmc-gx rmc-n) (list '< (list '- rmc-n) rmc-gx) (list '< rmc-n rmc-n0)
             (list 'IN rmc-gx 'RR) (list 'IN rmc-n 'RR) (list 'IN rmc-n0 'RR))
(ass)
(qed 'rmc-cont-bounded)

;;; =====================================================================
;;; (H) ON K: A CONTINUOUS FUNCTION VARIES BY AT MOST eps ON THE CYLINDERS OF
;;;     SOME LEVEL (uniform continuity in cylinder form)
;;; =====================================================================

;;; longer cylinders are smaller
(sp (make-wff '(FORALL s (FORALL dseq (FORALL e (FORALL n (FORALL mb_
  (IMPLIES (IN n NN) (IMPLIES (IN mb_ NN) (IMPLIES (<= n mb_)
    (SUBSET (RM-CYL s dseq e mb_) (RM-CYL s dseq e n))))))))))))
(dk-peel!)
;; 2026-10-11 (META round 3): subset-def owes its match DEFINED; RM-CYL(...) is not
;; certified, the SEPs it unfolds to are (the Cantor space a metric space in context).
(fact 'rmm-cantor-metric)
(mac 'RM-CYL)
(mac 'RM-K)
(mac 'subset-def)
(define rmc-x (dk-di-var!))
(dk-split-all! (dk-landed (lambda () (sep-me (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (dk-head-is? (caddr f) 'SEP)
                                                                    (equal? (cadr f) rmc-x) (dk-contains? f 'mb_)))
                                                       "the cylinder membership")))))
(define rmc-ag1 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f rmc-x) (dk-contains? f 'mb_)))
                         "agreement below mb_"))
(in-sep!
  (lambda () (ass))
  (lambda ()
    (let ((i (dk-di-var!)))
      (di)
      (dk-cite! 'nn-in-rr i)
      (dk-cite! 'nn-in-rr 'n)
      (dk-cite! 'nn-in-rr 'mb_)
      (dk-have! (list '< i 'mb_) (lambda () (dk-ineq! (list '< i 'n) '(<= n mb_) (list 'IN i 'RR) '(IN n RR) '(IN mb_ RR))))
      (dk-apply! rmc-ag1 i)
      (ass))))
(qed 'rmc-cyl-mono)

(define (rmc-osc-set n)
  (list 'SEP 'rux_ '(RM-K s dseq)
    (list 'FORALL 'ruy_ (list 'IMPLIES (list 'IN 'ruy_ (rmc-cyl 'rux_ n))
      (list 'FORALL 'ruz_ (list 'IMPLIES (list 'IN 'ruz_ (rmc-cyl 'rux_ n))
        '(<= (abs (- (g ruy_) (g ruz_))) eps)))))))
(define rmc-osc (list 'VNB-LAMBDA 'run_ 'NN (rmc-osc-set 'run_)))

(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'FORALL 'g (list 'FORALL 'eps
  (list 'IMPLIES (list 'IN 'g (list 'CONT-FNS rmc-ks)) (list 'IMPLIES '(POS-RR eps)
    (list 'FORSOME 'nl_ (list 'AND '(IN nl_ NN)
      (list 'FORALL 'x (list 'IMPLIES '(IN x (RM-K s dseq))
        (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y (rmc-cyl 'x 'nl_))
          '(<= (abs (- (g y) (g x))) eps)))))))))))))))
(dk-peel!)
(rmc-kpts!)
(rmc-pos! 'eps)
(dk-cite! 'rmm-k-compact 's 'dseq)
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts rmc-ks 'g)))
(define rmc-gcl (dk-ctx-form (list 'FORALL 'a (list 'IMPLIES (list 'IN 'a rmc-kp) (list 'IS-CONTINUOUS-AT rmc-ks 'RR-MS 'g 'a)))))
;; each oscillation set is open
(dk-have! (list 'FORALL 'n (list 'IMPLIES '(IN n NN) (list 'IS-OPEN rmc-ks (list rmc-osc 'n))))
  (lambda ()
    (let* ((n (dk-di-var!))
           (w (rmc-osc-set n)))
      (dk-lam-b!)
      (dk-have! (list 'SUBSET w '(RM-K s dseq))
        (lambda () (mac 'subset-def)
          (let ((x (dk-di-var!)))
            (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN x w)))))
            (ass))))
      (dk-have! (rmc-saturated w n)
        (lambda ()
          (let* ((y (dk-di-var!))
                 (z (cadr (dk-goal))))
            (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN y w)))))
            (let ((zm (dk-cite! 'rmm-cyl-mem 's 'dseq y n z)))
              (dk-have! (list 'IN z '(RM-K s dseq)) (lambda () (rmc-prop! zm (list 'IN z (rmc-cyl y n))))))
            (dk-cite! 'rmc-cyl-same 's 'dseq y z n)
            (for-each (lambda (l)
                        (dk-focus! l)
                        (if (dk-head-is? (dk-goal) 'IN)
                            (ass)
                            (begin (subst (list '= (rmc-cyl z n) (rmc-cyl y n)))
                                   (ass))))
                      (dk-opened (lambda () (sep-mi)))))))
      (dk-cite! 'rmc-saturated-clopen 's 'dseq w n)
      (dk-split-all! (list (dk-cite! 'rmc-clopen-parts rmc-ks w)))
      (ass))))
;; they cover K
(define rmc-e2 (dk-halve! 'eps))
(dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x rmc-kp) (list 'FORSOME 'n (list 'AND '(IN n NN) (list 'IN 'x (list rmc-osc 'n))))))
  (lambda ()
    (let* ((x (dk-di-var!)))
      (dk-rewrite-h! (list 'IN x rmc-kp) rmc-kp '(RM-K s dseq))
      (dk-apply! rmc-gcl x)
      (let* ((cc (dk-cite! 'is-continuous-at rmc-ks 'RR-MS 'g x))
             (cl (caddr (caddr (caddr (caddr (caddr cc)))))))
        (dk-have! cl (lambda () (rmc-prop! cc (list 'IS-CONTINUOUS-AT rmc-ks 'RR-MS 'g x))))
        (let* ((d (dk-skolem! (dk-apply! cl rmc-e2)))
               (dcl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'b) (dk--occurs? d f))) "delta clause"))
               (bl (list 'BALL rmc-ks x d)))
          (rmc-pos! d)
          (dk-have! (list 'AND (list 'IN d 'RR) (list 'AND (list '<= 0 d) (list 'NOT (list '= 0 d))))
            (lambda () (dk-conj-close! (lambda () (cond ((dk-head-is? (dk-goal) 'IN) (ass))
                                                        ((dk-head-is? (dk-goal) 'NOT) (di) (dk-absurd! (list '= 0 d) (list '< 0 d) (list 'IN d 'RR)))
                                                        (#t (dk-ineq! (list '< 0 d) (list 'IN d 'RR))))))))
          (dk-cite! 'ball-is-open rmc-ks x d)
          (dk-cite! 'ball-center-in rmc-ks x d)
          (let ((nb (dk-skolem! (dk-cite! 'rmm-cyl-base 's 'dseq bl x))))
            (ew nb)
            (dk-conj-close!
              (lambda ()
                (if (eq? (caddr (dk-goal)) 'NN)
                    (ass)
                    (begin
                      (dk-lam-b!)
                      (for-each
                        (lambda (l)
                          (dk-focus! l)
                          (if (dk-head-is? (dk-goal) 'IN)
                              (ass)
                              (begin
                                (let* ((y (dk-di-var!))
                                       (z (cadr (caddr (cadr (cadr (dk-goal)))))))
                                  (dk-cite! 'fun-apply-type-c 'g rmc-kp 'RR x)
                                  (for-each
                                    (lambda (w)
                                      (let* ((bm (dk-cite! 'ball-membership rmc-ks x d w))
                                             (wb (list 'IN w bl)))
                                        (dk-cite! 'subset-mem-fwd (rmc-cyl x nb) bl w)
                                        (dk-have! (list 'IN w rmc-kp) (lambda () (rmc-prop! bm wb)))
                                        (dk-have! (list '<= (rmc-d rmc-ks x w) d) (lambda () (rmc-prop! bm wb)))
                                        (dk-cite! 'fun-apply-type-c 'g rmc-kp 'RR w)
                                        (let ((u1 (dk-apply! dcl w)))
                                          (dk-cite! 'rr-ms-dist (list 'g x) (list 'g w))
                                          (let ((u2 (dk-rewrite-h! u1 (rmc-d 'RR-MS (list 'g x) (list 'g w))
                                                                   (list 'abs (list '- (list 'g x) (list 'g w))))))
                                            (dk-have! (list 'IN (list '- (list 'g x) (list 'g w)) 'RR) (lambda () (in-rr)))
                                            (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list '- (list 'g x) (list 'g w)) rmc-e2)))))))
                                    (list y z))
                                  (rmc-abs-le! (list '- (list 'g y) (list 'g z)) 'eps
                                    (list '<= (list '- rmc-e2) (list '- (list 'g x) (list 'g y))) (list '<= (list '- (list 'g x) (list 'g y)) rmc-e2)
                                    (list '<= (list '- rmc-e2) (list '- (list 'g x) (list 'g z))) (list '<= (list '- (list 'g x) (list 'g z)) rmc-e2)
                                    (list '= (list '+ rmc-e2 rmc-e2) 'eps)
                                    (list 'IN (list 'g x) 'RR) (list 'IN (list 'g y) 'RR) (list 'IN (list 'g z) 'RR) (list 'IN rmc-e2 'RR) '(IN eps RR))
                                  (ass)))))
                        (dk-opened (lambda () (sep-mi))))))))))))))
;; a finite subcover; the oscillation sets increase with n
(dk-have! (list 'SUBSET rmc-kp rmc-kp) (lambda () (mac 'subset-def) (dk-di-var!) (ass)))
(dk-cite! 'complement-in-of-subset-empty rmc-kp rmc-kp)
(dk-cite! 'empty-is-open rmc-ks)
(rmc-closed-by-compl! rmc-ks rmc-kp 'EMPTY-SET)
(define rmc-n0 (dk-skolem! (dk-cite! 'compact-closed-countable-subcover rmc-ks rmc-kp rmc-osc)))
(define rmc-cb (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk--occurs? rmc-n0 f) (dk--occurs? rmc-osc f))) "the finite cover"))
(ew rmc-n0)
(rmc-and-focus! 'FORALL)
(define rmc-x (dk-di-var!))
(define rmc-y (cadr (cadr (cadr (cadr (dk-goal))))))
(dk-have! (list 'IN rmc-x rmc-kp) (lambda () (subst (list '== rmc-kp '(RM-K s dseq))) (ass)))
(define rmc-n (dk-skolem! (dk-apply! rmc-cb rmc-x)))
(dk-lam-b-h! (list 'IN rmc-x (list rmc-osc rmc-n)))
(dk-split-all! (dk-landed (lambda () (sep-me (list 'IN rmc-x (rmc-osc-set rmc-n))))))
(dk-cite! 'nn-in-rr rmc-n)
(dk-cite! 'nn-in-rr rmc-n0)
(dk-have! (list '<= rmc-n rmc-n0) (lambda () (dk-ineq! (list '< rmc-n rmc-n0) (list 'IN rmc-n 'RR) (list 'IN rmc-n0 'RR))))
(dk-cite! 'rmc-cyl-mono 's 'dseq rmc-x rmc-n rmc-n0)
(dk-cite! 'subset-mem-fwd (rmc-cyl rmc-x rmc-n0) (rmc-cyl rmc-x rmc-n) rmc-y)
(dk-cite! 'rmm-cyl-self 's 'dseq rmc-x rmc-n)
(define rmc-ocl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'ruy_) (dk--occurs? rmc-x f))) "the oscillation clause"))
(dk-apply! rmc-ocl rmc-y rmc-x)
(ass)
(qed 'rmc-uniform-level)

;;; =====================================================================
;;; (I) THE INTEGRAL SIDE: bounded measurable functions are integrable;
;;;     indicators, sums and scalar multiples of "good" functions are good
;;; =====================================================================

;;; A REAL FUNCTION WITH MEASURABLE TAILS, BOUNDED BY bd_, ON A SPACE OF FINITE
;;; MEASURE IS INTEGRABLE: |f| <= bd_ 1_omega, whose integral is bd_ mu(omega).
(sp (make-wff '(FORALL omega (FORALL cA (FORALL mu (FORALL f (FORALL bd_
  (IMPLIES (IS-MEASURE omega cA mu) (IMPLIES (IN (mu omega) RR) (IMPLIES (IN f (FUN omega RR))
  (IMPLIES (FORALL al (IMPLIES (IN al RR) (IN (SEP x_ omega (< al (f x_))) cA)))
  (IMPLIES (IN bd_ RR) (IMPLIES (<= 0 bd_)
  (IMPLIES (FORALL x (IMPLIES (IN x omega) (<= (abs (f x)) bd_)))
    (IS-INTEGRABLE omega cA mu f)))))))))))))))
(dk-peel!)
(define rmc-mc (dk-cite! 'is-measure 'omega 'cA 'mu))
(dk-have! '(IS-SIGMA-ALGEBRA omega cA) (lambda () (rmc-prop! rmc-mc '(IS-MEASURE omega cA mu))))
(dk-have! '(IN mu (FUN cA RR-POS-STAR)) (lambda () (rmc-prop! rmc-mc '(IS-MEASURE omega cA mu))))
(define rmc-sc (dk-cite! 'is-sigma-algebra 'omega 'cA))
(dk-have! '(IN omega cA) (lambda () (rmc-prop! rmc-sc '(IS-SIGMA-ALGEBRA omega cA))))
(dk-cite! 'real-measurable-of-tails 'omega 'cA 'f)
(dk-split-all! (list (dk-cite! 'integral-abs-fn 'omega 'cA 'mu 'f)))
(define rmc-one '(INDICATOR omega omega))
(define rmc-hh (list 'PTWISE-SCALE 'omega 'bd_ rmc-one))
(dk-cite! 'measurable-fn-indicator 'omega 'cA 'omega)
(dk-cite! 'ptwise-scale-measurable 'omega 'cA rmc-one 'bd_)
(dk-have! (list 'PTWISE-LE 'omega '(ABS-FN omega f) rmc-hh)
  (lambda ()
    (mac 'ptwise-le)
    (let* ((x (dk-di-var!))
           (fx (list 'f x)))
      (dk-cite! 'fun-apply-type-c 'f 'omega 'RR x)
      (dk-cite! 'abs-fn-value 'omega 'f x)
      (subst (list '== (list '(ABS-FN omega f) x) (list 'abs fx)))
      (dk-cite! 'ptwise-scale-value-q 'omega 'bd_ rmc-one x)
      (subst (list '== (list rmc-hh x) (list 'etimes 'bd_ (list rmc-one x))))
      (dk-cite! 'indicator-value-in 'omega 'omega x)
      (subst (list '= (list rmc-one x) 1))
      (dk-have! '(IN 1 RR) (lambda () (from-context!)))
      (dk-have! '(<= 0 1) (lambda () (arith)))
      (dk-cite! 'etimes-real-defined 'bd_ 1)
      (dk-cite! 'bintimes-apply 'bd_ 1)
      (subst '(= (etimes bd_ 1) (bintimes bd_ 1)))
      (subst '(== (bintimes bd_ 1) (* bd_ 1)))
      (dk-apply! (dk-ctx-form '(FORALL x (IMPLIES (IN x omega) (<= (abs (f x)) bd_)))) x)
      (dk-cite! 'rr-abs-closed fx)
      (dk-ineq! (list '<= (list 'abs fx) 'bd_) (list 'IN (list 'abs fx) 'RR) '(IN bd_ RR)))))
(dk-cite! 'integral-monotone 'omega 'cA 'mu '(ABS-FN omega f) rmc-hh)
(dk-cite! 'integral-homogeneous 'omega 'cA 'mu rmc-one 'bd_)
(dk-cite! 'integral-indicator 'omega 'cA 'mu 'omega)
(dk-cite! 'fun-apply-type-c 'mu 'cA 'RR-POS-STAR 'omega)
(dk-cite! 'rr-pos-star-nonneg '(mu omega))
(dk-cite! 'etimes-real-defined 'bd_ '(mu omega))
(dk-cite! 'bintimes-apply 'bd_ '(mu omega))
(define rmc-ih (list 'INTEGRAL 'omega 'cA 'mu rmc-hh))
(define rmc-ia '(INTEGRAL omega cA mu (ABS-FN omega f)))
(dk-have! (list 'IN rmc-ih 'RR)
  (lambda ()
    (subst (list '= rmc-ih (list 'etimes 'bd_ (list 'INTEGRAL 'omega 'cA 'mu rmc-one))))
    (subst (list '= (list 'INTEGRAL 'omega 'cA 'mu rmc-one) '(mu omega)))
    (subst '(= (etimes bd_ (mu omega)) (bintimes bd_ (mu omega))))
    (subst '(== (bintimes bd_ (mu omega)) (* bd_ (mu omega))))
    (in-rr)))
(dk-cite! 'integral-in 'omega 'cA 'mu '(ABS-FN omega f))
(rmc-and2! (list 'IN rmc-ia 'RR-POS-STAR) (list 'IN rmc-ih 'RR))
(dk-cite! 'rr-pos-star-le-real-in-rr rmc-ia rmc-ih)
(define rmc-ic (dk-cite! 'integrable-iff-abs-finite 'omega 'cA 'mu 'f))
(rmc-prop! rmc-ic (list 'IN rmc-ia 'RR))
(qed 'rmc-bounded-integrable)

;;; "GOOD" functions on K for (lam): continuous, integrable for the measure of
;;; lam, and integrating to their lam-value.
(define (rmc-rint h) (list 'RINTEGRAL rmc-kp (rmc-ksig 'lam) (rmc-kmu 'lam) h))
(define (rmc-good h)
  (list 'AND (list 'IN h (list 'CONT-FNS rmc-ks))
    (list 'AND (list 'IS-INTEGRABLE rmc-kp (rmc-ksig 'lam) (rmc-kmu 'lam) h)
               (list '= (rmc-rint h) (list 'lam h)))))
(define rmc-kmeas (list 'IS-MEASURE rmc-kp (rmc-ksig 'lam) (rmc-kmu 'lam)))

;;; the indicator of a clopen set of K is good
(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'FORALL 'lam (list 'FORALL 'u
  (list 'IMPLIES (list 'IS-POSITIVE-FUNCTIONAL rmc-ks 'lam) (list 'IMPLIES (list 'IN 'u (list 'CLOPEN-SETS rmc-ks))
    (rmc-good (list 'INDICATOR rmc-kp 'u))))))))))
(dk-peel!)
(rmc-kpts!)
(rmc-k-measure-parts! 'lam)
(define rmc-iu (list 'INDICATOR rmc-kp 'u))
(define rmc-z0 (list 'VNB-LAMBDA 'cx_ rmc-kp 0))
(define rmc-sg (rmc-ksig 'lam))
(define rmc-mm (rmc-kmu 'lam))
(dk-cite! 'rmc-indicator-cont rmc-ks 'u)
(dk-cite! 'subset-mem-fwd (list 'CLOPEN-SETS rmc-ks) rmc-sg 'u)
(dk-cite! 'ms-pts-is-set rmc-ks)
(dk-cite! 'rmc-indicator-fun rmc-kp 'u)
(dk-cite! 'measurable-fn-indicator rmc-kp rmc-sg 'u)
(dk-have! '(IN 0 RR) (lambda () (from-context!)))
(dk-have! '(<= 0 0) (lambda () (arith)))
(dk-cite! 'rmc-rps-of-nonneg 0)
(dk-cite! 'measurable-fn-const rmc-kp rmc-sg 0)
(dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x rmc-kp) (list 'IN (list rmc-iu 'x) 'RR)))
  (lambda () (let ((x (dk-di-var!))) (dk-split-all! (list (dk-cite! 'rmc-indicator-values rmc-kp 'u x))) (ass))))
(dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x rmc-kp) (list 'IN (list rmc-z0 'x) 'RR)))
  (lambda () (dk-di-var!) (dk-lam-b!) (ass)))
(dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x rmc-kp) (list '= (list rmc-iu 'x) (list '- (list rmc-iu 'x) (list rmc-z0 'x)))))
  (lambda ()
    (let ((x (dk-di-var!)))
      (dk-split-all! (list (dk-cite! 'rmc-indicator-values rmc-kp 'u x)))
      (dk-lam-b!)
      (crs))))
(define rmc-i1 (list 'INTEGRAL rmc-kp rmc-sg rmc-mm rmc-iu))
(define rmc-i2 (list 'INTEGRAL rmc-kp rmc-sg rmc-mm rmc-z0))
(define rmc-lu (list 'lam rmc-iu))
(dk-cite! 'integral-indicator rmc-kp rmc-sg rmc-mm 'u)
(dk-cite! 'integral-zero-fn rmc-kp rmc-sg rmc-mm)
(dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'u) (dk--occurs? rmc-mm f))) "the value clause") 'u)
(dk-split-all! (list (dk-cite! 'rmc-ind-nonneg rmc-ks 'lam 'u)))
(dk-have! (list '= rmc-i1 rmc-lu)
  (lambda () (subst (list '= rmc-i1 (list rmc-mm 'u))) (subst (list '= (list rmc-mm 'u) rmc-lu)) (rfl)))
(dk-have! (list 'IN rmc-i1 'RR) (lambda () (subst (list '= rmc-i1 rmc-lu)) (ass)))
(dk-have! (list 'IN rmc-i2 'RR) (lambda () (subst (list '= rmc-i2 0)) (ass)))
(dk-split-all! (list (dk-cite! 'rintegral-decomposition rmc-kp rmc-sg rmc-mm rmc-iu rmc-iu rmc-z0)))
(dk-conj-close!
  (lambda ()
    (if (dk-head-is? (dk-goal) '=)
        (begin
          (subst (list '= (rmc-rint rmc-iu) (list '- rmc-i1 rmc-i2)))
          (subst (list '= rmc-i1 rmc-lu))
          (subst (list '= rmc-i2 0))
          (crs))
        (ass))))
(qed 'rmc-good-ind)

;;; good functions are closed under scalar multiples ...
(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'FORALL 'lam (list 'FORALL 'c (list 'FORALL 'f
