;;; =====================================================================
;;; (J) THE LAYER INDUCTION: a function constant on the cylinders of level nl_
;;;     with values in [c, c + (n+1) eps] is within eps of a good function
;;; =====================================================================
(define (rmc-local f nl)
  (list 'FORALL 'x (list 'IMPLIES '(IN x (RM-K s dseq))
    (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y (rmc-cyl 'x nl)) (list '= (list f 'y) (list f 'x)))))))
(define (rmc-range f c eps n)
  (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x rmc-kp)
    (list 'AND (list '<= c (list f 'x)) (list '<= (list f 'x) (list '+ c (list '* (list '+ n 1) eps)))))))
(define (rmc-close f h eps)
  (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x rmc-kp)
    (list '<= (list 'abs (list '- (list f 'x) (list h 'x))) eps))))

(sp (make-wff (list 'FORALL 'n (list 'IMPLIES '(IN n NN)
  (list 'FORALL 's (list 'FORALL 'dseq (list 'FORALL 'lam (list 'FORALL 'nl_ (list 'FORALL 'c (list 'FORALL 'eps (list 'FORALL 'f
    (list 'IMPLIES (list 'IS-POSITIVE-FUNCTIONAL rmc-ks 'lam) (list 'IMPLIES '(IN nl_ NN) (list 'IMPLIES '(IN c RR)
    (list 'IMPLIES '(POS-RR eps) (list 'IMPLIES (list 'IN 'f (list 'FUN rmc-kp 'RR))
    (list 'IMPLIES (rmc-local 'f 'nl_) (list 'IMPLIES (rmc-range 'f 'c 'eps 'n)
      (list 'FORSOME 'lh_ (list 'AND (rmc-good 'lh_) (rmc-close 'f 'lh_ 'eps)))))))))))))))))))))
(define rmc-lv (dk-opened (lambda () (ni))))

;;; ---- base: the constant c ----
(dk-focus! (car rmc-lv))
(dk-peel!)
(rmc-kpts!)
(rmc-pos! 'eps)
(dk-split-all! (list (dk-cite! 'rmc-clopen-empty-whole rmc-ks)))
(dk-cite! 'rmc-good-ind 's 'dseq 'lam rmc-kp)
(define rmc-one (list 'INDICATOR rmc-kp rmc-kp))
(dk-split-all! (list (dk-cite! 'rmc-good-scale 's 'dseq 'lam 'c rmc-one)))
(define rmc-h0 (rmc-scl rmc-ks 'c rmc-one))
(ew rmc-h0)
(rmc-and-focus! 'FORALL)
(define rmc-x (dk-di-var!))
(dk-split-all! (list (dk-apply! (dk-ctx-form (rmc-range 'f 'c 'eps 0)) rmc-x)))
(dk-cite! 'fun-apply-type-c 'f rmc-kp 'RR rmc-x)
(dk-lam-b!)
(dk-cite! 'indicator-value-in rmc-kp rmc-kp rmc-x)
(subst (list '= (list rmc-one rmc-x) 1))
(dk-have! (list '= (list '* (list '+ 0 1) 'eps) 'eps) (lambda () (crs)))
(dk-rewrite-h! (list '<= (list 'f rmc-x) (list '+ 'c (list '* (list '+ 0 1) 'eps))) (list '* (list '+ 0 1) 'eps) 'eps)
(rmc-abs-le! (list '- (list 'f rmc-x) (list '* 'c 1)) 'eps
  (list '<= 'c (list 'f rmc-x)) (list '<= (list 'f rmc-x) (list '+ 'c 'eps)) (list '< 0 'eps)
  (list 'IN (list 'f rmc-x) 'RR) '(IN c RR) '(IN eps RR))
(ass)

;;; ---- step ----
(dk-focus! (cadr rmc-lv))
(define rmc-n (dk-di-var!))
(di)
(define rmc-ih (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 's))) "the induction hypothesis"))
(dk-peel!)
(rmc-kpts!)
(rmc-pos! 'eps)
(define rmc-A (list '* (list '+ rmc-n 1) 'eps))
(define rmc-A2 (list '* (list '+ (list 'succ rmc-n) 1) 'eps))
(define rmc-t0 (list '+ 'c rmc-A))
(dk-cite! 'nn-in-rr rmc-n)
(dk-cite! 'nn-zero-le rmc-n)
(dk-cite! 'nn-succ-plus-one rmc-n)
(dk-have! (list 'IN rmc-A 'RR) (lambda () (in-rr)))
(dk-have! (list 'IN (list '+ rmc-n 1) 'RR) (lambda () (in-rr)))
(dk-cite! 'nn-succ-closed rmc-n)
(dk-cite! 'nn-in-rr (list 'succ rmc-n))
(dk-have! (list 'IN rmc-A2 'RR) (lambda () (in-rr)))
(dk-have! (list '= rmc-A2 (list '+ rmc-A 'eps))
  (lambda () (subst (list '= (list 'succ rmc-n) (list '+ rmc-n 1))) (crs)))
(dk-have! '(IN 1 RR) (lambda () (from-context!)))
(dk-have! (list '<= 1 (list '+ rmc-n 1)) (lambda () (dk-ineq! (list '<= 0 rmc-n) (list 'IN rmc-n 'RR))))
(dk-have! '(<= 0 eps) (lambda () (dk-ineq! '(< 0 eps) '(IN eps RR))))
(dk-cite! 'rr-mul-le-right 1 (list '+ rmc-n 1) 'eps)
(dk-have! '(= (* 1 eps) eps) (lambda () (crs)))
(dk-rewrite-h! (list '<= '(* 1 eps) rmc-A) '(* 1 eps) 'eps)
;; the top layer b and its indicator
(define rmc-b (list 'SEP 'rbx_ rmc-kp (list '< rmc-t0 '(f rbx_))))
(define rmc-ib (list 'INDICATOR rmc-kp rmc-b))
(define rmc-locf (dk-ctx-form (rmc-local 'f 'nl_)))
(define (rmc-in-k->p! x) (dk-have! (list 'IN x rmc-kp) (lambda () (subst (list '== rmc-kp '(RM-K s dseq))) (ass))))
(define (rmc-b-elim! x)
  (dk-split-all! (dk-landed (lambda () (sep-me (list 'IN x rmc-b))))))
(dk-have! (list 'SUBSET rmc-b '(RM-K s dseq))
  (lambda ()
    (mac 'subset-def)
    (let ((x (dk-di-var!)))
      (rmc-b-elim! x)
      (dk-rewrite-h! (list 'IN x rmc-kp) rmc-kp '(RM-K s dseq))
      (ass))))
(dk-have! (rmc-saturated rmc-b 'nl_)
  (lambda ()
    (let* ((y (dk-di-var!))
           (z (cadr (dk-goal))))
      (rmc-b-elim! y)
      (dk-rewrite-h! (list 'IN y rmc-kp) rmc-kp '(RM-K s dseq))
      (let ((zm (dk-cite! 'rmm-cyl-mem 's 'dseq y 'nl_ z)))
        (dk-have! (list 'IN z '(RM-K s dseq)) (lambda () (rmc-prop! zm (list 'IN z (rmc-cyl y 'nl_))))))
      (rmc-in-k->p! z)
      (dk-apply! rmc-locf y z)
      (for-each (lambda (l)
                  (dk-focus! l)
                  (if (equal? (dk-goal) (list 'IN z rmc-kp))
                      (ass)
                      (begin (subst (list '= (list 'f z) (list 'f y))) (ass))))
                (dk-opened (lambda () (sep-mi)))))))
(dk-cite! 'rmc-saturated-clopen 's 'dseq rmc-b 'nl_)
(dk-cite! 'ms-pts-is-set rmc-ks)
(dk-cite! 'rmc-indicator-fun rmc-kp rmc-b)
;; f' = f - eps 1_b
(define rmc-fp (list 'VNB-LAMBDA 'rfy_ rmc-kp (list '- '(f rfy_) (list '* 'eps (list rmc-ib 'rfy_)))))
(define (rmc-vals! x)
  (dk-cite! 'fun-apply-type-c 'f rmc-kp 'RR x)
  (dk-split-all! (list (dk-cite! 'rmc-indicator-values rmc-kp rmc-b x))))
(dk-have! (list 'IN rmc-fp (list 'FUN rmc-kp 'RR))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((x (dk-di-var!)))
          (rmc-vals! x)
          (in-rr))))))
;;; (rmc-not-lt-le! A B): with (NOT (< A B)) and A, B in RR in context, land (<= B A).
(define (rmc-not-lt-le! a b)
  (dk-have! (list '<= b a)
    (lambda ()
      (use-em (list '<= b a)
        (lambda () (ass))
        (lambda ()
          (dk-cite! 'rr-not-le-lt b a)
          (rmc-prop! (list '< a b) (list 'NOT (list '< a b))))))))
;;; (rmc-b-case! X YES NO): split on X in b; YES / NO run with the indicator value landed
(define (rmc-b-case! x yes no)
  (use-em (list 'IN x rmc-b)
    (lambda ()
      (dk-cite! 'indicator-value-in rmc-kp rmc-b x)
      (yes))
    (lambda ()
      (dk-cite! 'indicator-value-out rmc-kp rmc-b x)
      (no))))
(dk-have! (rmc-local rmc-fp 'nl_)
  (lambda ()
    (let* ((x (dk-di-var!))
           (y (cadr (cadr (dk-goal)))))
      (rmc-in-k->p! x)
      (let ((ym (dk-cite! 'rmm-cyl-mem 's 'dseq x 'nl_ y)))
        (dk-have! (list 'IN y '(RM-K s dseq)) (lambda () (rmc-prop! ym (list 'IN y (rmc-cyl x 'nl_))))))
      (rmc-in-k->p! y)
      (dk-apply! rmc-locf x y)
      (rmc-vals! x)
      (rmc-vals! y)
      (dk-lam-b!)
      (subst (list '= (list 'f y) (list 'f x)))
      (rmc-b-case! x
        (lambda ()
          (rmc-b-elim! x)
          (dk-have! (list 'IN y rmc-b)
            (lambda ()
              (for-each (lambda (l)
                          (dk-focus! l)
                          (if (equal? (dk-goal) (list 'IN y rmc-kp))
                              (ass)
                              (begin (subst (list '= (list 'f y) (list 'f x))) (ass))))
                        (dk-opened (lambda () (sep-mi))))))
          (dk-cite! 'indicator-value-in rmc-kp rmc-b y)
          (subst (list '= (list rmc-ib x) 1))
          (subst (list '= (list rmc-ib y) 1))
          (crs))
        (lambda ()
          (dk-have! (list 'NOT (list 'IN y rmc-b))
            (lambda ()
              (di)
              (rmc-b-elim! y)
              (dk-have! (list 'IN x rmc-b)
                (lambda ()
                  (for-each (lambda (l)
                              (dk-focus! l)
                              (if (equal? (dk-goal) (list 'IN x rmc-kp))
                                  (ass)
                                  (begin (subst (list '= (list 'f x) (list 'f y))) (ass))))
                            (dk-opened (lambda () (sep-mi))))))
              (rmc-prop! (list 'IN x rmc-b) (list 'NOT (list 'IN x rmc-b)))))
          (dk-cite! 'indicator-value-out rmc-kp rmc-b y)
          (subst (list '= (list rmc-ib x) 0))
          (subst (list '= (list rmc-ib y) 0))
          (crs))))))
(dk-have! (rmc-range rmc-fp 'c 'eps rmc-n)
  (lambda ()
    (let* ((x (dk-di-var!))
           (fx (list 'f x)))
      (dk-split-all! (list (dk-apply! (dk-ctx-form (rmc-range 'f 'c 'eps (list 'succ rmc-n))) x)))
      (rmc-vals! x)
      (dk-lam-b!)
      (let ((prem (list (list '<= 'c fx) (list '<= fx (list '+ 'c rmc-A2)) (list '= rmc-A2 (list '+ rmc-A 'eps))
                        (list '<= 'eps rmc-A) (list 'IN fx 'RR) '(IN c RR) '(IN eps RR) (list 'IN rmc-A 'RR) (list 'IN rmc-A2 'RR))))
        (rmc-b-case! x
          (lambda ()
            (rmc-b-elim! x)
            (subst (list '= (list rmc-ib x) 1))
            (dk-conj-close! (lambda () (apply dk-ineq! (cons (list '< rmc-t0 fx) prem)))))
          (lambda ()
            (dk-have! (list 'NOT (list '< rmc-t0 fx))
              (lambda ()
                (di)
                (dk-have! (list 'IN x rmc-b) (lambda () (dk-close-all! (lambda () (sep-mi)))))
                (rmc-prop! (list 'IN x rmc-b) (list 'NOT (list 'IN x rmc-b)))))
            (dk-have! (list 'IN rmc-t0 'RR) (lambda () (in-rr)))
            (rmc-not-lt-le! rmc-t0 fx)
            (subst (list '= (list rmc-ib x) 0))
            (dk-have! '(= (* eps 0) 0) (lambda () (crs)))
            (subst '(= (* eps 0) 0))
            (dk-conj-close! (lambda () (dk-ineq! (list '<= fx rmc-t0) (list '<= 'c fx) (list 'IN fx 'RR) '(IN c RR) (list 'IN rmc-A 'RR))))))
        ))))
;; the induction hypothesis at f'
(define rmc-hp (dk-skolem! (dk-apply! rmc-ih 's 'dseq 'lam 'nl_ 'c 'eps rmc-fp)))
(define rmc-hclose (dk-ctx-form (rmc-close rmc-fp rmc-hp 'eps)))
(dk-cite! 'rmc-good-ind 's 'dseq 'lam rmc-b)
(dk-have! '(IN eps RR) (lambda () (ass)))
(dk-cite! 'rmc-good-scale 's 'dseq 'lam 'eps rmc-ib)
(define rmc-sb (rmc-scl rmc-ks 'eps rmc-ib))
(dk-have! (rmc-good rmc-hp) (lambda () (dk-conj-close! (lambda () (ass)))))
(dk-split-all! (list (dk-cite! 'rmc-good-add 's 'dseq 'lam rmc-hp rmc-sb)))
(define rmc-hn (rmc-sum rmc-ks rmc-hp rmc-sb))
(ew rmc-hn)
(rmc-and-focus! 'FORALL)
(define rmc-x (dk-di-var!))
(rmc-vals! rmc-x)
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts rmc-ks rmc-hp)))
(dk-cite! 'fun-apply-type-c rmc-hp rmc-kp 'RR rmc-x)
(define rmc-c1 (dk-apply! rmc-hclose rmc-x))
(define rmc-c2 (dk-lam-b-h! rmc-c1))
(dk-lam-b!)
(define rmc-fx (list 'f rmc-x))
(define rmc-ix (list rmc-ib rmc-x))
(define rmc-hx (list rmc-hp rmc-x))
(dk-have! (list '= (list '- rmc-fx (list '+ rmc-hx (list '* 'eps rmc-ix)))
                   (list '- (list '- rmc-fx (list '* 'eps rmc-ix)) rmc-hx))
  (lambda () (crs)))
(subst (list '= (list '- rmc-fx (list '+ rmc-hx (list '* 'eps rmc-ix)))
                (list '- (list '- rmc-fx (list '* 'eps rmc-ix)) rmc-hx)))
(ass)
(qed 'rmc-layer)

;;; =====================================================================
;;; (K) EVERY CONTINUOUS g ON K IS WITHIN 2 eps OF A GOOD FUNCTION
;;; =====================================================================
;;; f = g o r, r(x) = a chosen point of the cylinder of x of the uniform level:
;;; f is constant on those cylinders, within eps of g, and bounded by the bound
;;; of g; the layer induction approximates f.
(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'FORALL 'lam (list 'FORALL 'g (list 'FORALL 'eps
  (list 'IMPLIES (list 'IS-POSITIVE-FUNCTIONAL rmc-ks 'lam) (list 'IMPLIES (list 'IN 'g (list 'CONT-FNS rmc-ks))
    (list 'IMPLIES '(POS-RR eps)
      (list 'FORSOME 'ah_ (list 'AND (rmc-good 'ah_)
        (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x rmc-kp)
          (list '<= (list 'abs (list '- '(g x) '(ah_ x))) '(+ eps eps))))))))))))))))
(dk-peel!)
(rmc-kpts!)
(rmc-pos! 'eps)
(dk-cite! 'rmm-k-compact 's 'dseq)
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts rmc-ks 'g)))
(define rmc-nl (dk-skolem! (dk-cite! 'rmc-uniform-level 's 'dseq 'g 'eps)))
(define rmc-ul (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'x) (dk--occurs? rmc-nl f))) "the uniform level clause"))
(define rmc-bd (dk-skolem! (dk-cite! 'rmc-cont-bounded rmc-ks 'g)))
(define rmc-bdc (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk--occurs? rmc-bd f))) "the bound clause"))
(define (rmc-cylx x) (rmc-cyl x rmc-nl))
(define (rmc-ch x) (list 'CHOICE (rmc-cylx x)))
;;; (rmc-choice! X): X in PTS K in context; land CHOICE(CYL(X, N)) in CYL(X, N), in K,
;;; in PTS K, and g of it in RR.
(define (rmc-choice! x)
  (dk-rewrite-h! (list 'IN x rmc-kp) rmc-kp '(RM-K s dseq))
  (dk-cite! 'rmc-cyl-set 's 'dseq x rmc-nl)
  (dk-cite! 'rmm-cyl-self 's 'dseq x rmc-nl)
  (dk-have! (list 'FORSOME 'rcz_ (list 'IN 'rcz_ (rmc-cylx x))) (lambda () (ew x) (ass)))
  (dk-cite! 'choice-axiom (rmc-cylx x))
  (dk-cite! 'rmm-cyl-sub 's 'dseq x rmc-nl)
  (dk-cite! 'subset-mem-fwd (rmc-cylx x) '(RM-K s dseq) (rmc-ch x))
  (rmc-in-k->p! (rmc-ch x))
  (dk-cite! 'fun-apply-type-c 'g rmc-kp 'RR (rmc-ch x)))
(define (rmc-in-k->p! x) (dk-have! (list 'IN x rmc-kp) (lambda () (subst (list '== rmc-kp '(RM-K s dseq))) (ass))))
(define rmc-f (list 'VNB-LAMBDA 'rfx_ rmc-kp (list 'g (list 'CHOICE (rmc-cyl 'rfx_ rmc-nl)))))
(dk-cite! 'ms-pts-is-set rmc-ks)
(dk-have! (list 'IN rmc-f (list 'FUN rmc-kp 'RR))
  (lambda () (dk-lam-type! (lambda () (let ((x (dk-di-var!))) (rmc-choice! x) (ass))))))
(dk-have! (rmc-local rmc-f rmc-nl)
  (lambda ()
    (let* ((x (dk-di-var!))
           (y (cadr (cadr (dk-goal)))))
      (rmc-in-k->p! x)
      (let ((ym (dk-cite! 'rmm-cyl-mem 's 'dseq x rmc-nl y)))
        (dk-have! (list 'IN y '(RM-K s dseq)) (lambda () (rmc-prop! ym (list 'IN y (rmc-cylx x))))))
      (rmc-in-k->p! y)
      (rmc-choice! x)
      (dk-lam-b!)
      (dk-cite! 'rmc-cyl-same 's 'dseq x y rmc-nl)
      (subst (list '= (rmc-cylx y) (rmc-cylx x)))
      (rfl))))
;; f is within eps of g, and in [-B, B]
(dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x rmc-kp)
            (list 'AND (list '<= (list 'abs (list '- (list rmc-f 'x) '(g x))) 'eps)
                       (list 'AND (list '<= (list '- rmc-bd) (list rmc-f 'x)) (list '<= (list rmc-f 'x) rmc-bd)))))
  (lambda ()
    (let ((x (dk-di-var!)))
      (dk-cite! 'fun-apply-type-c 'g rmc-kp 'RR x)
      (rmc-choice! x)
      (dk-lam-b!)
      (dk-apply! rmc-ul x (rmc-ch x))
      (dk-apply! rmc-bdc (rmc-ch x))
      (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list 'g (rmc-ch x)) rmc-bd)))
      (dk-conj-close! (lambda () (if (dk-head-is? (dk-goal) '<=)
                                     (let ((g0 (dk-goal)))
                                       (if (dk-head-is? (cadr g0) 'abs) (ass) (ass)))
                                     (ass)))))))
;; the number of layers
(define rmc-2b (list '+ rmc-bd rmc-bd))
(dk-have! (list 'IN rmc-2b 'RR) (lambda () (in-rr)))
(define rmc-nv (dk-skolem! (dk-cite! 'rr-archimedean-multiple 'eps rmc-2b)))
(dk-cite! 'nn-in-rr rmc-nv)
(define rmc-A (list '* (list '+ rmc-nv 1) 'eps))
(define rmc-Z (list '* rmc-nv 'eps))
(dk-have! (list 'IN rmc-A 'RR) (lambda () (in-rr)))
(dk-have! (list 'IN rmc-Z 'RR) (lambda () (in-rr)))
(dk-have! (list '= rmc-A (list '+ rmc-Z 'eps)) (lambda () (crs)))
(define rmc-mb (list '- rmc-bd))
(dk-have! (list 'IN rmc-mb 'RR) (lambda () (in-rr)))
(dk-have! (rmc-range rmc-f rmc-mb 'eps rmc-nv)
  (lambda ()
    (let ((x (dk-di-var!)))
      (dk-split-all! (list (dk-apply! (dk-ctx-form (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x rmc-kp)
            (list 'AND (list '<= (list 'abs (list '- (list rmc-f 'x) '(g x))) 'eps)
                       (list 'AND (list '<= (list '- rmc-bd) (list rmc-f 'x)) (list '<= (list rmc-f 'x) rmc-bd)))))) x)))
      (dk-cite! 'fun-apply-type-c rmc-f rmc-kp 'RR x)
      (let ((fx (list rmc-f x)))
        (dk-conj-close!
          (lambda ()
            (dk-ineq! (list '<= (list '- rmc-bd) fx) (list '<= fx rmc-bd) (list '<= rmc-2b rmc-Z)
                      (list '= rmc-A (list '+ rmc-Z 'eps)) (list '< 0 'eps)
                      (list 'IN fx 'RR) (list 'IN rmc-bd 'RR) '(IN eps RR) (list 'IN rmc-Z 'RR) (list 'IN rmc-A 'RR))))))))
(define rmc-h (dk-skolem! (dk-apply! (dk-cite! 'rmc-layer rmc-nv) 's 'dseq 'lam rmc-nl rmc-mb 'eps rmc-f)))
(define rmc-hcl (dk-ctx-form (rmc-close rmc-f rmc-h 'eps)))
(ew rmc-h)
(rmc-and-focus! 'FORALL)
(define rmc-x (dk-di-var!))
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts rmc-ks rmc-h)))
(dk-cite! 'fun-apply-type-c rmc-h rmc-kp 'RR rmc-x)
(dk-cite! 'fun-apply-type-c rmc-f rmc-kp 'RR rmc-x)
(dk-cite! 'fun-apply-type-c 'g rmc-kp 'RR rmc-x)
(define rmc-fx (list rmc-f rmc-x))
(define rmc-hx (list rmc-h rmc-x))
(define rmc-gx (list 'g rmc-x))
(dk-apply! rmc-hcl rmc-x)
(dk-split-all! (list (dk-apply! (dk-ctx-form (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x rmc-kp)
            (list 'AND (list '<= (list 'abs (list '- (list rmc-f 'x) '(g x))) 'eps)
                       (list 'AND (list '<= (list '- rmc-bd) (list rmc-f 'x)) (list '<= (list rmc-f 'x) rmc-bd)))))) rmc-x)))
(dk-have! (list 'IN (list '- rmc-fx rmc-hx) 'RR) (lambda () (in-rr)))
(dk-have! (list 'IN (list '- rmc-fx rmc-gx) 'RR) (lambda () (in-rr)))
(dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list '- rmc-fx rmc-hx) 'eps)))
(dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list '- rmc-fx rmc-gx) 'eps)))
(dk-have! '(IN (+ eps eps) RR) (lambda () (in-rr)))
(rmc-abs-le! (list '- rmc-gx rmc-hx) '(+ eps eps)
  (list '<= (list '- 'eps) (list '- rmc-fx rmc-hx)) (list '<= (list '- rmc-fx rmc-hx) 'eps)
  (list '<= (list '- 'eps) (list '- rmc-fx rmc-gx)) (list '<= (list '- rmc-fx rmc-gx) 'eps)
  (list 'IN rmc-fx 'RR) (list 'IN rmc-hx 'RR) (list 'IN rmc-gx 'RR) '(IN eps RR))
(ass)
(qed 'rmc-approx)

;;; =====================================================================
;;; (L) THE THEOREM: for g continuous on K, g is integrable for the measure of
;;;     lam and its integral is lam(g)
;;; =====================================================================

;;; (rmc-rint-real! H): with IS-INTEGRABLE of H in context, land (IN (RINTEGRAL .. H) RR)
(define (rmc-rint-real! h)
  (let* ((ic (dk-cite! 'is-integrable rmc-kp (rmc-ksig 'lam) (rmc-kmu 'lam) h))
         (ip (list 'INTEGRAL rmc-kp (rmc-ksig 'lam) (rmc-kmu 'lam) (list 'POS-PART rmc-kp h)))
         (in (list 'INTEGRAL rmc-kp (rmc-ksig 'lam) (rmc-kmu 'lam) (list 'NEG-PART rmc-kp h)))
         (hi (list 'IS-INTEGRABLE rmc-kp (rmc-ksig 'lam) (rmc-kmu 'lam) h)))
    (dk-have! (list 'IN ip 'RR) (lambda () (rmc-prop! ic hi)))
    (dk-have! (list 'IN in 'RR) (lambda () (rmc-prop! ic hi)))
    (dk-cite! 'rintegral-unfold rmc-kp (rmc-ksig 'lam) (rmc-kmu 'lam) h)
    (dk-have! (list 'IN (rmc-rint h) 'RR)
      (lambda () (subst (list '== (rmc-rint h) (list '- ip in))) (in-rr)))))

(sp (make-wff (list 'FORALL 's (list 'FORALL 'dseq (list 'FORALL 'lam (list 'FORALL 'g
  (list 'IMPLIES (list 'IS-POSITIVE-FUNCTIONAL rmc-ks 'lam) (list 'IMPLIES (list 'IN 'g (list 'CONT-FNS rmc-ks))
    (list 'AND (list 'IS-INTEGRABLE rmc-kp (rmc-ksig 'lam) (rmc-kmu 'lam) 'g)
               (list '= (rmc-rint 'g) '(lam g)))))))))))
(dk-peel!)
(rmc-kpts!)
(rmc-k-measure-parts! 'lam)
(define rmc-sg (rmc-ksig 'lam))
(define rmc-mm (rmc-kmu 'lam))
(define rmc-cl (rmc-pf-open! rmc-ks 'lam))
(dk-split-all! (list (dk-cite! 'rmc-clopen-empty-whole rmc-ks)))
(define rmc-one (list 'INDICATOR rmc-kp rmc-kp))
(define rmc-L (list 'lam rmc-one))
(dk-split-all! (list (dk-cite! 'rmc-ind-nonneg rmc-ks 'lam rmc-kp)))
(dk-apply! (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'u) (dk--occurs? rmc-mm f))) "the value clause") rmc-kp)
(dk-have! (list 'IN (list rmc-mm rmc-kp) 'RR) (lambda () (subst (list '= (list rmc-mm rmc-kp) rmc-L)) (ass)))
(dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts rmc-ks 'g)))
(dk-cite! 'rmm-k-compact 's 'dseq)
(define rmc-bd (dk-skolem! (dk-cite! 'rmc-cont-bounded rmc-ks 'g)))
(dk-have! (list 'FORALL 'al (list 'IMPLIES '(IN al RR) (list 'IN (list 'SEP 'x_ rmc-kp '(< al (g x_))) rmc-sg)))
  (lambda ()
    (let ((al (dk-di-var!)))
      (dk-cite! 'rmc-gt-set-open rmc-ks 'g al)
      (dk-cite! 'rmc-k-open-measurable 's 'dseq 'lam (list 'SEP 'x_ rmc-kp (list '< al '(g x_))))
      (ass))))
(dk-cite! 'rmc-bounded-integrable rmc-kp rmc-sg rmc-mm 'g rmc-bd)
(define rmc-gi (list 'IS-INTEGRABLE rmc-kp rmc-sg rmc-mm 'g))
(rmc-rint-real! 'g)
(rmc-lam-real! rmc-ks 'lam 'g)
(define rmc-dd (list '- (rmc-rint 'g) '(lam g)))
(dk-have! (list 'IN rmc-dd 'RR) (lambda () (in-rr)))
(dk-have! (list 'FORALL 'eps (list 'IMPLIES '(POS-RR eps) (list '<= (list 'abs rmc-dd) 'eps)))
  (lambda ()
    (let* ((eps (dk-di-var! (lambda (g0) (cadr (cadr g0)))))
           (_ (di))
           (a (list '* 4 rmc-L)))
      (rmc-pos! eps)
      (dk-have! (list 'IN a 'RR) (lambda () (in-rr)))
      (dk-have! (list '<= 0 a) (lambda () (dk-ineq! (list '<= 0 rmc-L) (list 'IN rmc-L 'RR))))
      (let* ((e1 (dk-skolem! (dk-cite! 'r8e-eps-over a eps)))
             (ecl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk--occurs? e1 f))) "the eps-over clause")))
        (rmc-pos! e1)
        (dk-have! (list '<= e1 e1) (lambda () (dk-ineq! (list 'IN e1 'RR))))
        (dk-apply! ecl e1)
        (let* ((h (dk-skolem! (dk-cite! 'rmc-approx 's 'dseq 'lam 'g e1)))
               (hcl (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (eq? (cadr f) 'x) (dk--occurs? h f))) "the approximation"))
               (ee (list '+ e1 e1))
               (me (list '- ee))
               (su (rmc-scl rmc-ks ee rmc-one))
               (sv (rmc-scl rmc-ks me rmc-one))
               (u (rmc-sum rmc-ks h su))
               (v (rmc-sum rmc-ks h sv)))
          (dk-have! (list 'IN ee 'RR) (lambda () (in-rr)))
          (dk-have! (list 'IN me 'RR) (lambda () (in-rr)))
          (dk-cite! 'rmc-good-ind 's 'dseq 'lam rmc-kp)
          (dk-cite! 'rmc-good-scale 's 'dseq 'lam ee rmc-one)
          (dk-cite! 'rmc-good-scale 's 'dseq 'lam me rmc-one)
          (dk-have! (rmc-good h) (lambda () (dk-conj-close! (lambda () (ass)))))
          (dk-cite! 'rmc-good-add 's 'dseq 'lam h su)
          (dk-cite! 'rmc-good-add 's 'dseq 'lam h sv)
          (for-each (lambda (k) (dk-split-all! (list (dk-ctx-form (rmc-good k))))) (list su sv u v))
          ;; g <= u and v <= g pointwise
          (for-each
            (lambda (claim-of)
              (dk-have! (list 'FORALL 'x (list 'IMPLIES (list 'IN 'x rmc-kp) (claim-of 'x)))
                (lambda ()
                  (let* ((x (dk-di-var!))
                         (gx (list 'g x))
                         (hx (list h x)))
                    (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts rmc-ks h)))
                    (dk-cite! 'fun-apply-type-c h rmc-kp 'RR x)
                    (dk-cite! 'fun-apply-type-c 'g rmc-kp 'RR x)
                    (dk-apply! hcl x)
                    (dk-have! (list 'IN (list '- gx hx) 'RR) (lambda () (in-rr)))
                    (dk-split-all! (list (dk-cite! 'rr-abs-le-parts (list '- gx hx) ee)))
                    (dk-lam-b!)
                    (dk-cite! 'indicator-value-in rmc-kp rmc-kp x)
                    (subst (list '= (list rmc-one x) 1))
                    (dk-ineq! (list '<= (list '- ee) (list '- gx hx)) (list '<= (list '- gx hx) ee)
                              (list 'IN gx 'RR) (list 'IN hx 'RR) (list 'IN ee 'RR) (list 'IN e1 'RR))))))
            (list (lambda (x) (list '<= (list 'g x) (list u x)))
                  (lambda (x) (list '<= (list v x) (list 'g x)))))
          (dk-cite! 'rintegral-monotone rmc-kp rmc-sg rmc-mm 'g u)
          (dk-cite! 'rintegral-monotone rmc-kp rmc-sg rmc-mm v 'g)
          (dk-cite! 'rmc-pf-mono rmc-ks 'lam 'g u)
          (dk-cite! 'rmc-pf-mono rmc-ks 'lam v 'g)
          (let* ((r1 (dk-rewrite-h! (list '<= (rmc-rint 'g) (rmc-rint u)) (rmc-rint u) (list 'lam u)))
                 (r2 (dk-rewrite-h! (list '<= (rmc-rint v) (rmc-rint 'g)) (rmc-rint v) (list 'lam v))))
            (dk-cite! 'rmc-pf-add rmc-ks 'lam h su)
            (dk-cite! 'rmc-pf-add rmc-ks 'lam h sv)
            (dk-cite! 'rmc-indicator-cont rmc-ks rmc-kp)
            (dk-cite! 'rmc-pf-scale rmc-ks 'lam ee rmc-one)
            (dk-cite! 'rmc-pf-scale rmc-ks 'lam me rmc-one)
            (if (not (dk-asm? (list 'IN h (list 'FUN rmc-kp 'RR))))
                (dk-split-all! (list (dk-cite! 'rmc-cont-fns-parts rmc-ks h))))
            (for-each (lambda (k) (rmc-lam-real! rmc-ks 'lam k)) (list h u v))
            (let ((pp (list '* a e1)))
              (dk-have! (list 'IN pp 'RR) (lambda () (in-rr)))
              (dk-have! (list '= (list '- (list 'lam u) (list 'lam v)) pp)
                (lambda ()
                  (subst (list '= (list 'lam u) (list '+ (list 'lam h) (list 'lam su))))
                  (subst (list '= (list 'lam v) (list '+ (list 'lam h) (list 'lam sv))))
                  (subst (list '= (list 'lam su) (list '* ee rmc-L)))
                  (subst (list '= (list 'lam sv) (list '* me rmc-L)))
                  (crs)))
              (let ((pn (dk-name! pp)))
                (dk-rewrite-h! (list '= (list '- (list 'lam u) (list 'lam v)) pp) pp pn)
                (dk-rewrite-h! (list '<= pp eps) pp pn)
                (rmc-abs-le! rmc-dd eps
                  (list '<= (rmc-rint 'g) (list 'lam u)) (list '<= (list 'lam v) (rmc-rint 'g))
                  (list '<= '(lam g) (list 'lam u)) (list '<= (list 'lam v) '(lam g))
                  (list '= (list '- (list 'lam u) (list 'lam v)) pn) (list '<= pn eps)
                  (list 'IN (rmc-rint 'g) 'RR) '(IN (lam g) RR) (list 'IN (list 'lam u) 'RR)
                  (list 'IN (list 'lam v) 'RR) (list 'IN pn 'RR) (list 'IN eps 'RR))
                (ass)))))))))
(dk-cite! 'rr-abs-closed rmc-dd)
(dk-cite! 'rr-le-all-pos-nonpos (list 'abs rmc-dd))
(dk-cite! 'rr-abs-nonneg rmc-dd)
(dk-have! '(IN 0 RR) (lambda () (from-context!)))
(rmc-antisym! (list 'abs rmc-dd) 0)
(define rmc-az (dk-cite! 'rr-abs-zero rmc-dd))
(dk-have! (list '= rmc-dd 0) (lambda () (rmc-prop! rmc-az (list '= (list 'abs rmc-dd) 0))))
(dk-have! (list '<= (rmc-rint 'g) '(lam g)) (lambda () (dk-ineq! (list '= rmc-dd 0) (list 'IN (rmc-rint 'g) 'RR) '(IN (lam g) RR))))
(dk-have! (list '<= '(lam g) (rmc-rint 'g)) (lambda () (dk-ineq! (list '= rmc-dd 0) (list 'IN (rmc-rint 'g) 'RR) '(IN (lam g) RR))))
(rmc-antisym! (rmc-rint 'g) '(lam g))
(dk-conj-close! (lambda () (ass)))
(qed 'rmc-riesz-markov-k)
