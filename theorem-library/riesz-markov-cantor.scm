(dk-cite! 'rmc-indicator-cont 's 'u)
(rmc-lam-real! 's 'lam (rmc-ind 's 'u))
(dk-have! (list 'FORALL 'pfx_ (list 'IMPLIES '(IN pfx_ (PTS s)) (list '<= 0 (list (rmc-ind 's 'u) 'pfx_))))
  (lambda ()
    (let ((x (dk-di-var!)))
      (dk-split-all! (list (dk-cite! 'rmc-indicator-values '(PTS s) 'u x)))
      (ass))))
(dk-apply! (list-ref rmc-cl 3) (rmc-ind 's 'u))
(dk-conj-close! (lambda () (ass)))
(qed 'rmc-ind-nonneg)

;;; splitting a clopen set c along a clopen set a does not increase the content:
;;; lam(1_{c n a}) + lam(1_{c \ a}) <= lam(1_c)
(sp (make-wff '(FORALL s (FORALL lam (FORALL c (FORALL a
  (IMPLIES (IS-POSITIVE-FUNCTIONAL s lam) (IMPLIES (IN c (CLOPEN-SETS s)) (IMPLIES (IN a (CLOPEN-SETS s))
    (<= (+ (lam (INDICATOR (PTS s) (INTERSECTION c a))) (lam (INDICATOR (PTS s) (DIFFERENCE c a))))
        (lam (INDICATOR (PTS s) c))))))))))))
(dk-peel!)
(dk-cite! 'rmc-clopen-inter 's 'c 'a)
(dk-cite! 'rmc-clopen-diff 's 'c 'a)
(dk-cite! 'rmc-indicator-cont 's 'c)
(dk-cite! 'rmc-indicator-cont 's '(INTERSECTION c a))
(dk-cite! 'rmc-indicator-cont 's '(DIFFERENCE c a))
(define (rmc-ptwise-ind! claim sets facts-of)
  (dk-have! claim
    (lambda ()
      (let* ((x (dk-di-var!))
             (facts (facts-of x)))
        (rmc-ind-cases! '(PTS s) sets x facts)))))
(rmc-ptwise-ind!
  (list 'FORALL 'x (list 'IMPLIES '(IN x (PTS s))
    (list '<= (list '+ (list (rmc-ind 's '(INTERSECTION c a)) 'x) (list (rmc-ind 's '(DIFFERENCE c a)) 'x))
              (list (rmc-ind 's 'c) 'x))))
  '(c a (INTERSECTION c a) (DIFFERENCE c a))
  (lambda (x)
    (let* ((f1 (dk-cite! 'intersection-membership 'c 'a x))
           (f2 (dk-cite! 'difference-membership 'c 'a x)))
      (list f1 f2))))
(dk-cite! 'rmc-pf-ge-sum 's 'lam (rmc-ind 's 'c) (rmc-ind 's '(INTERSECTION c a)) (rmc-ind 's '(DIFFERENCE c a)))
(ass)
(qed 'rmc-ind-split-ge)

;;; covering: lam(1_a) <= lam(1_{a \ c}) + lam(1_c)
(sp (make-wff '(FORALL s (FORALL lam (FORALL a (FORALL c
  (IMPLIES (IS-POSITIVE-FUNCTIONAL s lam) (IMPLIES (IN a (CLOPEN-SETS s)) (IMPLIES (IN c (CLOPEN-SETS s))
    (<= (lam (INDICATOR (PTS s) a))
        (+ (lam (INDICATOR (PTS s) (DIFFERENCE a c))) (lam (INDICATOR (PTS s) c)))))))))))))
