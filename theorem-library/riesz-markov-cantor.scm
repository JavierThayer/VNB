;;; (rmc-in-ball! S A R B D): with (POS-RR D), (= (+ D D) R), B in PTS S and
;;; d(A, B) <= D in context, land (IN B (BALL S A R)).
(define (rmc-in-ball! s a r b d)
  (let ((dab (rmc-d s a b)))
    (dk-cite! 'metric-dist-real s a b)
    (rmc-pos! d)
    (rmc-pos! r)
    (dk-have! (list '<= dab r)
      (lambda () (dk-ineq! (list '<= dab d) (list '= (list '+ d d) r) (list '< 0 d)
                           (list 'IN dab 'RR) (list 'IN d 'RR) (list 'IN r 'RR))))
    (dk-have! (list 'NOT (list '= dab r))
      (lambda ()
        (di)
        (dk-absurd! (list '= dab r) (list '<= dab d) (list '= (list '+ d d) r) (list '< 0 d)
                    (list 'IN dab 'RR) (list 'IN d 'RR) (list 'IN r 'RR))))
    (let ((c (dk-cite! 'ball-membership s a r b)))
      (dk-have! (list 'IN b (list 'BALL s a r))
        (lambda () (rmc-prop! c (list 'IN b (list 'PTS s)) (list '<= dab r) (list 'NOT (list '= dab r))))))))

;;; (rmc-abs-le! X C PREMISE ...): land (<= (abs X) C) from -C <= X <= C, each
;;; by dk-ineq! on the named premises; (IN C RR) must be in context.
(define (rmc-abs-le! x c . prems)
  (dk-have! (list 'IN x 'RR) (lambda () (in-rr)))
  (dk-have! (list '<= (list '- c) x) (lambda () (apply dk-ineq! prems)))
  (dk-have! (list '<= x c) (lambda () (apply dk-ineq! prems)))
  (dk-cite! 'rr-abs-le-of-parts x c))


;;; the indicator of any set is a real function on a set omega
(sp (make-wff '(FORALL omega (FORALL a (IMPLIES (IN omega SET) (IN (INDICATOR omega a) (FUN omega RR)))))))
(dk-peel!)
(mac 'INDICATOR)
(dk-have! '(IN 0 RR) (lambda () (from-context!)))
(dk-have! '(IN 1 RR) (lambda () (from-context!)))
(define (rmc-if! true? t)
  (let* ((lv (dk-opened (lambda () (if true? (if-true t) (if-false t)))))
         (p  (if true? (cadr t) (list 'NOT (cadr t))))
         (side (filter (lambda (l) (equal? (dk-goal-of l) p)) lv))
         (main (filter (lambda (l) (not (equal? (dk-goal-of l) p))) lv)))
    (for-each (lambda (l) (dk-focus! l) (ass)) side)
    (if (not (= (length main) 1)) (error "rmc-if!: expected one main leaf" (length main)))
    (dk-focus! (car main))))
(dk-lam-type!
  (lambda ()
    (let* ((x (dk-di-var!))
           (t (list 'IF (list 'IN x 'a) 1 0)))
      (use-em (cadr t)
        (lambda () (rmc-if! #t t) (subst (list '= t 1)) (ass))
        (lambda () (rmc-if! #f t) (subst (list '= t 0)) (ass))))))
(qed 'rmc-indicator-fun)

;;; the values of an indicator lie in [0, 1]
(sp (make-wff '(FORALL omega (FORALL a (FORALL x (IMPLIES (IN x omega)
  (AND (IN ((INDICATOR omega a) x) RR)
       (AND (<= 0 ((INDICATOR omega a) x)) (<= ((INDICATOR omega a) x) 1)))))))))
(dk-peel!)
(define rmc-iv '((INDICATOR omega a) x))
(use-em '(IN x a)
  (lambda ()
    (dk-cite! 'indicator-value-in 'omega 'a 'x)
    (subst (list '= rmc-iv 1))
    (dk-conj-close! (lambda () (arith))))
  (lambda ()
    (dk-cite! 'indicator-value-out 'omega 'a 'x)
    (subst (list '= rmc-iv 0))
    (dk-conj-close! (lambda () (arith)))))
(qed 'rmc-indicator-values)

;;; ITEM 1: the indicator of a clopen set is continuous.
(sp (make-wff '(FORALL s (FORALL u (IMPLIES (IN u (CLOPEN-SETS s)) (IN (INDICATOR (PTS s) u) (CONT-FNS s)))))))
(dk-peel!)
(dk-split-all! (list (dk-cite! 'rmc-clopen-parts 's 'u)))
(define rmc-cc (dk-cite! 'is-closed 's 'u))
(dk-have! '(IS-METRIC-SPACE s) (lambda () (rmc-prop! rmc-cc '(IS-CLOSED s u))))
(define rmc-co '(COMPLEMENT-IN (PTS s) u))
(dk-have! (list 'IS-OPEN 's rmc-co) (lambda () (rmc-prop! rmc-cc '(IS-CLOSED s u))))
(dk-cite! 'ms-pts-is-set 's)
(define rmc-ind '(INDICATOR (PTS s) u))
(dk-cite! 'rmc-indicator-fun '(PTS s) 'u)
(dk-have! (list 'FORALL 'a (list 'IMPLIES '(IN a (PTS s)) (list 'IS-CONTINUOUS-AT 's 'RR-MS rmc-ind 'a)))
  (lambda ()
    (let ((a (dk-di-var!)))
      (use-em (list 'IN a 'u)
        (lambda ()
          (dk-cite! 'indicator-value-in '(PTS s) 'u a)
          (dk-have! (list 'FORALL 'y (list 'IMPLIES '(IN y u) (list '= (list rmc-ind 'y) (list rmc-ind a))))
            (lambda ()
              (let ((y (dk-di-var!)))
                (dk-cite! 'subset-mem-fwd 'u '(PTS s) y)
                (dk-cite! 'indicator-value-in '(PTS s) 'u y)
                (subst (list '= (list rmc-ind y) 1))
                (subst (list '= (list rmc-ind a) 1))
                (arith))))
          (dk-cite! 'rmc-cont-at-locally-const 's rmc-ind a 'u)
          (ass))
        (lambda ()
          (dk-cite! 'indicator-value-out '(PTS s) 'u a)
          (let ((cm (dk-cite! 'complement-in-membership '(PTS s) 'u a)))
            (dk-have! (list 'IN a rmc-co) (lambda () (rmc-prop! cm (list 'IN a '(PTS s)) (list 'NOT (list 'IN a 'u))))))
          (dk-have! (list 'FORALL 'y (list 'IMPLIES (list 'IN 'y rmc-co) (list '= (list rmc-ind 'y) (list rmc-ind a))))
            (lambda ()
              (let* ((y (dk-di-var!))
                     (cm (dk-cite! 'complement-in-membership '(PTS s) 'u y)))
                (dk-have! (list 'IN y '(PTS s)) (lambda () (rmc-prop! cm (list 'IN y rmc-co))))
                (dk-have! (list 'NOT (list 'IN y 'u)) (lambda () (rmc-prop! cm (list 'IN y rmc-co))))
                (dk-cite! 'indicator-value-out '(PTS s) 'u y)
                (subst (list '= (list rmc-ind y) 0))
                (subst (list '= (list rmc-ind a) 0))
                (arith))))
          (dk-cite! 'rmc-cont-at-locally-const 's rmc-ind a rmc-co)
          (ass))))))
(dk-cite! 'rmc-cont-fns-intro 's rmc-ind)
(ass)
(qed 'rmc-indicator-cont)

