;;; MONOTONICITY: f <= g pointwise => lam(f) <= lam(g).
(sp (make-wff '(FORALL s (FORALL lam (FORALL f (FORALL g
  (IMPLIES (IS-POSITIVE-FUNCTIONAL s lam) (IMPLIES (IN f (CONT-FNS s)) (IMPLIES (IN g (CONT-FNS s))
    (IMPLIES (FORALL x (IMPLIES (IN x (PTS s)) (<= (f x) (g x))))
      (<= (lam f) (lam g))))))))))))
(dk-peel!)
(define rmc-cl (rmc-pf-open! 's 'lam))
(dk-have! '(IN -1 RR) (lambda () (from-context!)))
(define rmc-f1 (rmc-scl 's -1 'f))
(dk-cite! 'rmc-cont-fns-scale 's -1 'f)
(define rmc-h (rmc-sum 's 'g rmc-f1))
(dk-cite! 'rmc-cont-fns-add 's 'g rmc-f1)
(dk-have! (list 'FORALL 'pfx_ (list 'IMPLIES '(IN pfx_ (PTS s)) (list '<= 0 (list rmc-h 'pfx_))))
  (lambda ()
    (let ((x (dk-di-var!)))
      (rmc-fval! 's 'f x)
      (rmc-fval! 's 'g x)
      (dk-apply! (dk-ctx-form '(FORALL x (IMPLIES (IN x (PTS s)) (<= (f x) (g x))))) x)
      (dk-lam-b!)
      (dk-ineq! (list '<= (list 'f x) (list 'g x)) (list 'IN (list 'f x) 'RR) (list 'IN (list 'g x) 'RR)))))
(dk-apply! (list-ref rmc-cl 3) rmc-h)
(dk-apply! (list-ref rmc-cl 1) 'g rmc-f1)
(dk-apply! (list-ref rmc-cl 2) -1 'f)
