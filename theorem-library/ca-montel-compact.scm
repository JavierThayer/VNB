;;; ca-montel-compact.scm -- Theorem 5.7 of the complex analysis notes in SET form (CA-MONTEL, 2026-10-26)
;;;
;;;   cc-montel-compact      u open, a subset of H(u) bounded (CC-HOL-BOUNDED) and CLOSED IN H(u)
;;;                          (H(u) with the metric of C(u), the FR-METRIC-SPACE of the seminorms
;;;                          p_n = sup over K_n): a is COMPACT in that metric.
;;;   cc-montel-compact-in-c the same with a closed in C(u).
;;;
;;; Proof (the notes' route through Montel for sequences): a compact metric space is a sequentially
;;; compact one (seq-compact-implies-compact).  A sequence in a has bounded image, so cc-montel gives a
;;; subsequence converging uniformly on compacta to some g in H(u); that is convergence in the metric
;;; (cc-fr-conv-iff-unif-on-compacta, frm-converges-of-conv), hence in the subspace H(u), and a is
;;; closed there, so g is in a.
;;;
;;; Library: complex-analysis.  Load window: after theorem-library/ca6-hurwitz (cc-hol-bounded-mono,
;;; subseq-fun-typing); nothing cites it.
(define cmc-V '(CC-CONT-FNS u))
(define cmc-H '(CC-HOL-FNS u))
(define cmc-MV (list 'CC-FN-MODULE 'u cmc-V))
(define cmc-FAM (list 'CC-EXHAUST-SEMINORMS 'u cmc-V))
(define cmc-X (list 'FR-METRIC-SPACE cmc-MV cmc-FAM))
(define cmc-SH (list 'SUBSPACE-MS cmc-X cmc-H))
(define cmc-SA (list 'SUBSPACE-MS cmc-X 'a))

(define (cmc-close-open!)
  (if (and (pair? (dk-open-leaves)) (dk-asm? (dk-goal))) (ass)))

;; the common part; AMB is the space a is closed in (cmc-SH or cmc-X)
(define (cmc-drive! amb)
  (dk-peel!)
  (fact 'cc-open-subset-cc 'u)
  (fact 'cc-is-set) (fact 'subclass-of-set-is-set 'u 'CC)
  (dk-cite! 'cc-cont-fns-is-set 'u)
  (dk-cite! 'cc-hol-fns-subset-cont 'u)
  (fact 'subclass-of-set-is-set cmc-H cmc-V)
  (dk-cite! 'cc-fn-module-is-module 'u)
  (dk-cite! 'cc-exhaust-seminorms-family 'u)
  (dk-cite! 'frm-metric-space-is-metric-space 'CC-NORMED-FIELD cmc-MV cmc-FAM)
  (dk-cite! 'frm-metric-space-pts 'CC-NORMED-FIELD cmc-MV cmc-FAM)
  (dk-cite! 'cc-fn-module-vec 'u cmc-V)
  (dk-have! (list 'SUBSET cmc-H (list 'PTS cmc-X))
    (lambda ()
      (subst (list '== (list 'PTS cmc-X) (list 'VEC cmc-MV)))
      (subst (list '== (list 'VEC cmc-MV) cmc-V))
      (ass)))
  (dk-cite! 'subspace-is-metric-space cmc-X cmc-H)
  (dk-cite! 'subspace-pts cmc-X cmc-H)
  ;; a subset of the space it is closed in
  (let* ((ci (dk-cite! 'is-closed amb 'a)) (cr (caddr ci)))
    (dk-have! cr (lambda () (dk-only! ci (list 'IS-CLOSED amb 'a)) (prop)))
    (dk-split-all! (list cr)))
  (if (equal? amb cmc-SH)
      (dk-rewrite-h! (list 'SUBSET 'a (list 'PTS cmc-SH)) (list 'PTS cmc-SH) cmc-H)
      (let* ((bi (dk-cite! 'cc-hol-bounded 'u 'a)) (br (caddr bi)))
        (dk-have! br (lambda () (dk-only! bi '(CC-HOL-BOUNDED u a)) (prop)))
        (dk-split-all! (list br))))
  (if (not (dk-asm? (list 'SUBSET 'a (list 'PTS cmc-X))))
      (fact 'subset-trans 'a cmc-H (list 'PTS cmc-X)))
  (fact 'subclass-of-set-is-set 'a cmc-H)
  (dk-cite! 'subspace-is-metric-space cmc-X 'a)
  (dk-cite! 'subspace-pts cmc-X 'a)
  (dk-have! (list 'SEQ-COMPACT cmc-SA)
    (lambda ()
      (let* ((sci (dk-cite! 'seq-compact cmc-SA)) (scr (caddr sci)))
        (dk-have! scr
          (lambda ()
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal))
                    (ass)
                    (let* ((lk (dk-peel!))
                           (fin (car (filter (lambda (fm) (dk-head-is? fm 'IN)) lk)))
                           (f (cadr fin)))
                      (dk-rewrite-h! fin (list 'PTS cmc-SA) 'a)
                      (fact 'fun-codomain-superset f 'NN 'a cmc-H)
                      (dk-have! (list 'SUBSET (list 'IMAGE f 'NN) 'a)
                        (lambda ()
                          (let ((w (subset-by-element!)))
                            (fact 'image-subset-codomain 'NN 'a f w)
                            (cmc-close-open!))))
                      (dk-cite! 'cc-hol-bounded-mono 'u 'a (list 'IMAGE f 'NN))
                      (let* ((phi (dk-skolem! (dk-cite! 'cc-montel 'u f)))
                             (_0 (dk-split-all!))
                             (gex (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm phi)))
                                           "the limit"))
                             (g (dk-skolem! gex))
                             (_1 (dk-split-all!))
                             (t (list 'SUBSEQ f phi)))
                        (fact 'subseq-fun-typing f 'a phi)
                        (fact 'fun-codomain-superset t 'NN 'a cmc-H)
                        (fact 'fun-codomain-superset t 'NN cmc-H cmc-V)
                        (fact 'subset-mem-fwd cmc-H cmc-V g)
                        (let* ((ui (dk-cite! 'cc-fr-conv-iff-unif-on-compacta 'u t g))
                               (fc (cadr ui)))
                          (dk-have! fc (lambda () (dk-only! ui (list 'UNIF-ON-COMPACTA 'u t g)) (prop))))
                        (dk-have! (list 'IN t (list 'FUN 'NN (list 'VEC cmc-MV)))
                          (lambda () (subst (list '== (list 'VEC cmc-MV) cmc-V)) (ass)))
                        (dk-have! (list 'IN g (list 'VEC cmc-MV))
                          (lambda () (subst (list '== (list 'VEC cmc-MV) cmc-V)) (ass)))
                        (dk-cite! 'frm-converges-of-conv 'CC-NORMED-FIELD cmc-MV cmc-FAM t g)
                        (if (equal? amb cmc-SH)
                            (let ((si (dk-cite! 'subspace-converges-to cmc-X cmc-H t g)))
                              (dk-have! (list 'CONVERGES-TO cmc-SH t g)
                                (lambda () (dk-only! si (list 'CONVERGES-TO cmc-X t g)) (prop)))))
                        (dk-cite! 'closed-limit-in amb 'a t g)
                        (let ((si (dk-cite! 'subspace-converges-to cmc-X 'a t g)))
                          (dk-have! (list 'CONVERGES-TO cmc-SA t g)
                            (lambda () (dk-only! si (list 'CONVERGES-TO cmc-X t g)) (prop))))
                        (ew phi)
                        (dk-conj-close!
                          (lambda ()
                            (if (dk-asm? (dk-goal))
                                (ass)
                                (begin
                                  (ew g)
                                  (dk-conj-close!
                                    (lambda ()
                                      (if (dk-asm? (dk-goal))
                                          (ass)
                                          (begin (subst (list '== (list 'PTS cmc-SA) 'a)) (ass))))))))))))))))
        (dk-only! sci scr)
        (prop))))
  (dk-close-if! (lambda () (dk-cite! 'seq-compact-implies-compact cmc-SA)) ass))

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u)
  (list 'FORALL 'a (list 'IMPLIES '(CC-HOL-BOUNDED u a)
    (list 'IMPLIES (list 'IS-CLOSED cmc-SH 'a) (list 'IS-COMPACT cmc-SA))))))))
(cmc-drive! cmc-SH)
(qed 'cc-montel-compact)
(topic! 'cc-montel-compact 'analysis)

(sp (make-wff (list 'FORALL 'u (list 'IMPLIES '(IS-OPEN (NF-METRIC-SPACE CC-NORMED-FIELD) u)
  (list 'FORALL 'a (list 'IMPLIES '(CC-HOL-BOUNDED u a)
    (list 'IMPLIES (list 'IS-CLOSED cmc-X 'a) (list 'IS-COMPACT cmc-SA))))))))
(cmc-drive! cmc-X)
(qed 'cc-montel-compact-in-c)
(topic! 'cc-montel-compact-in-c 'analysis)
