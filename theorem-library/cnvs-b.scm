        '(ACT (CMOD-RACT m)) '(VNRM nfn)))
(for-each (lambda (p)
            (cnvb-read-off! (symbol-append 'cmod-nvs- (car p)) 'CMOD-NVS (car p) (cadr p))
            (cnvb-read-off! (symbol-append 'cmod-cnvs- (car p)) 'CMOD-CNVS (car p) (cadr p)))
          cnvb-nvs-vals)
