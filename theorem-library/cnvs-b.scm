;;; cnvs-b.scm -- THE REALIFICATION BRIDGE: a module over the complex numbers with a complex-
;;; homogeneous norm is a COMPLEX-NORMED-VECTOR-SPACE (CNVS, 2026-11-09).  All PROVEN modulo 0.
;;; Destination: theorem-library/cnvs-b.scm.  Vocabulary: structure-library/cnvs-vocab.scm.
;;;
;;; THE ONE MECHANISM.  Every complex normed space in the tree is presented with COMPLEX
;;; scalars: COMPLEX-INNER-PRODUCT-SPACE, COMPLEX-NORMED-ALGEBRA (ba-vocab.scm), the CSIP-CIPS
;;; tuple of a complex pre-Hilbert space.  Each has a MODULE view whose scalar ring is the
;;; complex numbers.  CMOD-CNVS(m, nf) restricts the scalars to the reals and takes J to be
;;; multiplication by i; the theorem
;;;     cmod-cnvs-is-cnvs:  IS-MODULE(m), SCAL(m) = CC-ring, IS-CMOD-NORM(m, nf)
;;;                         => IS-COMPLEX-NORMED-VECTOR-SPACE(CMOD-CNVS(m, nf))
;;; turns each bridge into a check of the four norm laws (cnvs-c.scm, cnvs-d.scm).  On the
;;; realification CACT is the module's own action (cmod-cact-value).
;;;
;;; METHOD (sip-b.scm's for CIPS-RSIP): each conjunct of the two structure predicates, with the
;;; tuple substituted for the structure variable, is a theorem of its own; the statements are
;;; GENERATED from the definitions (cnvb-conjuncts), the accessors of the literal tuple are
;;; replaced by their read-offs, the scalar ring's operations by their values, the maps by beta.
;;;
;;; Helper prefix: cnvb-.
;;; LOAD WINDOW: after theorem-library/cnvs-a and structure-library/cnvs-vocab (for the
;;; companions; nothing of cnvs-a is cited), after theorem-library/sip-b (sip-cc-ring-*,
;;; sip-rr-ring-*-value) and rake-asm-b3 (cc-re-im-decompose).  Library: analysis.

(define (cnvb-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** cnvs-b: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (proof-leaves))
        (error "cnvs-b: unfinished" name))))

(define cnvb-ccr '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define cnvb-rrr '(NORMED-FIELD-AS-COMMUTATIVE-RING RR-NORMED-FIELD))
