(define cnvb-N '(CMOD-NVS m nfn))
(define (cnvb-has-head? h e)
  (and (pair? e) (or (equal? (car e) h) (cnvb-has-head? h (car e)) (cnvb-has-head? h (cdr e)))))
(define (cnvb-perms xs)
  (if (null? xs) '(())
      (append-map (lambda (x) (map (lambda (p) (cons x p)) (cnvb-perms (delete x xs)))) xs)))
;;; forall m. module m => scal m = CC-ring => BODY
(define (cnvb-mstmt body)
  (list 'FORALL 'm (list 'IMPLIES '(IS-MODULE m) (list 'IMPLIES (list '= '(SCAL m) cnvb-ccr) body))))
;;; ... and forall nfn. IS-CMOD-NORM(m, nfn) => BODY
(define (cnvb-stmt body)
  (cnvb-mstmt (list 'FORALL 'nfn (list 'IMPLIES '(IS-CMOD-NORM m nfn) body))))

