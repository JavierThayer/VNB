;;; a landed formula about ADD/MUL/ONE/NEG of SCAL m: rewrite to CC's operations
(define (cnvb-scal-norm! f)
  (let loop ((f (dk-rewrite-h! f '(SCAL m) cnvb-ccr)) (fuel 8))
    (let ((rx (let find ((e f))
                (and (pair? e) (list? e)
                     (or (let inner ((xs e)) (cond ((null? xs) #f) ((find (car xs))) (#t (inner (cdr xs)))))
                         (and (or (equal? (car e) (list 'ADD cnvb-ccr)) (equal? (car e) (list 'MUL cnvb-ccr))) (= (length e) 3) e)
                         (and (equal? (car e) (list 'NEG cnvb-ccr)) (= (length e) 2) e)))))
          (one (list 'ONE cnvb-ccr)))
      (cond ((and (dk--occurs? one f) (> fuel 0))
             (fact 'sip-cc-ring-one)
             (loop (dk-rewrite-h! f one 1) (- fuel 1)))
            ((and rx (> fuel 0))
             (let ((e (cond ((equal? (car rx) (list 'ADD cnvb-ccr)) (dk-cite! 'sip-cc-ring-add-value (cadr rx) (caddr rx)))
                            ((equal? (car rx) (list 'MUL cnvb-ccr)) (dk-cite! 'sip-cc-ring-mul-value (cadr rx) (caddr rx)))
                            (#t (if (not (dk-asm? (list 'IN (cadr rx) 'CC))) (fact 'cc-one-in))
                                (dk-cite! 'sip-cc-ring-neg-value (cadr rx))))))
               (loop (dk-rewrite-h! f rx (caddr e)) (- fuel 1))))
            (#t f)))))

