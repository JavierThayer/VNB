(define (cnvb-read-off! name fn acc val)
  (sp (make-wff (cnvb-stmt (list '== (list acc (list fn 'm 'nfn)) val))))
  (dk-peel!)
  (fact 'rr-is-normed-field)
  (fact 'normed-field-as-commutative-ring-is-commutative-ring 'RR-NORMED-FIELD)
  (fact 'cmod-norm-fun 'm 'nfn)
  (slot acc)
  (mac fn)
  (nth-r)
  (if (and (not (proof-done? *ps*)) (cnvb-has-head? acc (dk-goal))) (slot acc))
  (if (not (proof-done? *ps*)) (qrfl))
  (cnvb-qed! name))
