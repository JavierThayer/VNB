(define (cnvb-nproj! name conj)
  (sp (make-wff (list 'FORALL 'm (list 'FORALL 'nfn (list 'IMPLIES '(IS-CMOD-NORM m nfn) conj)))))
  (di) (di)
  (dk-split-all! (list (dk-landed-1 (lambda () (mac-h 'IS-CMOD-NORM '(IS-CMOD-NORM m nfn))))))
  (ass)
  (cnvb-qed! name))
(cnvb-nproj! 'cmod-norm-fun '(IN nfn (FUN (VEC m) RR)))
(cnvb-nproj! 'cmod-norm-nonneg '(FORALL cnx_ (IMPLIES (IN cnx_ (VEC m)) (<= 0 (nfn cnx_)))))
(cnvb-nproj! 'cmod-norm-zero-iff '(FORALL cnx_ (IMPLIES (IN cnx_ (VEC m)) (IFF (= (nfn cnx_) 0) (= cnx_ (VZERO m))))))
(cnvb-nproj! 'cmod-norm-homog
  '(FORALL cnc_ (IMPLIES (IN cnc_ CC) (FORALL cnx_ (IMPLIES (IN cnx_ (VEC m))
     (= (nfn ((ACT m) cnc_ cnx_)) (* (magnitude cnc_) (nfn cnx_))))))))
(cnvb-nproj! 'cmod-norm-triangle
  '(FORALL cnx_ (IMPLIES (IN cnx_ (VEC m)) (FORALL cny_ (IMPLIES (IN cny_ (VEC m))
     (<= (nfn ((VADD m) cnx_ cny_)) (+ (nfn cnx_) (nfn cny_))))))))

