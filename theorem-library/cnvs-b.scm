;;; ==========================================================================================
;;; THE DRIVE of a conjunct
;;; ==========================================================================================
;;; the conjuncts of a structure predicate's definition at the tuple T, the trailing (IN T SET)
;;; dropped (dk-isx-set! proves it)
(define (cnvb-conjuncts def-name tuple)
  (let* ((f (lookup-theorem def-name))          ; (FORALL s (IFF (IS-X s) BODY))
         (s (cadr f))
         (body (subst-free s tuple (caddr (caddr f)))))
    (let loop ((b body) (acc '()))
      (if (dk-head-is? b 'AND)
          (loop (caddr b) (cons (cadr b) acc))
          (reverse acc)))))                    ; the last conjunct, (IN T SET), is dropped
(define cnvb-props '(IS-REAL-LINEAR-OP IS-SQUARE-MINUS-ID))
(define (cnvb-readoffs! prefix)
  (for-each (lambda (p)
              (let ((e (dk-cite! (symbol-append prefix (car p)) 'm 'nfn)))
                (if (dk--occurs? (cadr e) (dk-goal)) (subst (list '= (cadr e) (caddr e))))))
            (append cnvb-nvs-vals (if (eq? prefix 'cmod-cnvs-) '((JOP (CMOD-J m))) '()))))
(define (cnvb-prefix!)                  ; peel m, the two hypotheses, nfn, the norm hypothesis
  (let loop ((k 0))
    (if (not (dk-asm? '(IS-CMOD-NORM m nfn)))
        (begin (if (> k 6) (error "cnvb-prefix!: no norm hypothesis")) (di) (loop (+ k 1))))))
(define (cnvb-law-open! prefix)
  (cnvb-prefix!)
  (fact 'rr-is-normed-field)
  (fact 'normed-field-as-commutative-ring-is-commutative-ring 'RR-NORMED-FIELD)
  (fact 'commutative-ring-is-ring cnvb-rrr)
  (cnvb-open-m!)
  (fact 'cmod-norm-fun 'm 'nfn)
  (cnvb-readoffs! prefix)
  (if (and (pair? (dk-goal)) (memq (car (dk-goal)) cnvb-props))
      (begin (mac (car (dk-goal))) (cnvb-readoffs! prefix)))
  (for-each (lambda (mm) (if (dk--occurs? (list (car mm) cnvb-rrr) (dk-goal)) (mac (cadr mm))))
            '((CARR rr-scalar-ring-carr) (ONE rr-scalar-ring-one))))
;;; after the peel: type what the betas will owe
(define (cnvb-pretype! lk)
  (let ((vs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) '(VEC m)))) lk)))
        (ss (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) lk)))
        (cs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'CC))) lk))))
    (dk-have! '(IN 1 RR) (lambda () (arith)))
    (if (not (dk-asm? '(IN 1 CC))) (fact 'cc-one-in))
    (for-each cnvb-cc! ss)
    (for-each (lambda (r) (for-each (lambda (s) (dk-real! (list '+ r s)) (dk-real! (list '* r s))
                                       (cnvb-cc! (list '+ r s)) (cnvb-cc! (list '* r s))) ss)) ss)
    (for-each (lambda (x) (for-each (lambda (y) (dk-cite! 'module-vadd-type 'm x y)) vs)) vs)
    (for-each (lambda (x)
                (for-each (lambda (s) (dk-cite! 'cmod-act-type-cc 'm s x))
                          (cons '+i (cons 1 (append ss (append-map (lambda (r) (append-map (lambda (s) (list (list '+ r s) (list '* r s))) ss)) ss))))))
              vs)
    (for-each (lambda (x) (for-each (lambda (s) (dk-cite! 'cmod-act-type-cc 'm s (list '(ACT m) '+i x))
                                                (dk-cite! 'cmod-act-type-cc 'm '+i (list '(ACT m) s x)))
                                    (cons '+i ss))) vs)
    ;; the pairs a destructuring beta of CMOD-RACT owes
    (if (pair? ss)
        (let* ((sc (append (list 1) ss (append-map (lambda (r) (append-map (lambda (s) (list (list '+ r s) (list '* r s))) ss)) ss)))
               (vt (filter (lambda (t) (dk-asm? (list 'IN t '(VEC m))))
                           (append vs
                                   (append-map (lambda (x) (map (lambda (y) (list '(VADD m) x y)) vs)) vs)
                                   (append-map (lambda (x) (map (lambda (s) (list '(ACT m) s x)) sc)) vs)))))
          (if (not (dk-asm? '(IN RR SET))) (fact 'rr-is-set))
          (if (not (dk-asm? '(IN (VEC m) SET))) (fact 'frm-module-vec-set 'm))
          (for-each (lambda (r) (for-each (lambda (x)
                                            (if (not (dk-asm? (list 'IN (list 'LIST r x) '(CARTESIAN RR (VEC m)))))
                                                (dk-cite! 'pair-in-cartesian 'RR '(VEC m) r x)))
                                          vt))
                    (filter (lambda (r) (dk-asm? (list 'IN r 'RR))) sc))))
    (list ss vs cs)))
(define (cnvb-reduce!)
  (let loop ((fuel 6))
    (let* ((g (dk-goal))
           (ra (let find ((e g)) (cond ((not (pair? e)) #f)
                                       ((and (equal? (car e) (list 'ADD cnvb-rrr)) (= (length e) 3)) e)
                                       ((and (equal? (car e) (list 'MUL cnvb-rrr)) (= (length e) 3)) e)
                                       (#t (or (find (car e)) (find (cdr e))))))))
      (if (and ra (> fuel 0))
          (begin (subst (dk-cite! (if (equal? (car ra) (list 'ADD cnvb-rrr)) 'sip-rr-ring-add-value 'sip-rr-ring-mul-value)
                                  (cadr ra) (caddr ra)))
                 (loop (- fuel 1))))))
  (let* ((app-of? (lambda (pred)
                    (lambda (e) (let walk ((e e))
                                  (and (pair? e) (list? e)
                                       (or (pred (car e)) (any-pred walk e)))))))
         (applied? (lambda (f) ((app-of? (lambda (h) (equal? h (list f 'm)))) (dk-goal)))))
    (for-each (lambda (f) (if (applied? f) (mac f))) '(CMOD-RACT CMOD-J))
    (if ((app-of? (lambda (h) (and (pair? h) (eq? (car h) 'VNB-LAMBDA)))) (dk-goal))
        (dk-lam-b!))))
;;; cite each LEMMA at m (and nfn when WITH-N) and every ordering of the scalars then the
;;; vectors, until the goal is in context
(define (cnvb-cite-closer with-n . lemmas)
  (lambda (sv)
    (let ((ss (car sv)) (vs (cadr sv)) (head (if with-n '(m nfn) '(m))))
      (let try ((ls lemmas))
        (cond ((sequent-node-grounded? (proof-state-focus *ps*)) #t)
              ((dk-asm? (dk-goal)) (ass))
              ((null? ls) (error "cnvb-cite-closer: no citation gives the goal" (expression->string (dk-goal))))
              (#t (for-each (lambda (ps) (for-each (lambda (pv)
                                                     (if (not (dk-asm? (dk-goal)))
                                                         (vnb-guard (lambda () (apply fact (car ls) (append head ps pv))))))
                                                   (cnvb-perms vs)))
                            (cnvb-perms ss))
                  (try (cdr ls))))))))
(define (cnvb-law! name prefix conj closer)
  (sp (make-wff (cnvb-stmt conj)))
  (cnvb-law-open! prefix)
  (dk-conj-close!
    (lambda ()
      (let* ((g (dk-goal))
             (sv (if (dk-head-is? g 'FORALL) (cnvb-pretype! (dk-peel!)) (list '() '() '()))))
        (cnvb-reduce!)
        (closer sv))))
  (cnvb-qed! name))
(define (cnvb-length-closer n)
  (lambda (sv) (mac (if (= n 7) 'CMOD-NVS 'CMOD-CNVS)) (len-r) (if (not (proof-done? *ps*)) (arith))))
(define (cnvb-ass! sv) (ass))

;;; ==========================================================================================
;;; IS-NORMED-VECTOR-SPACE(CMOD-NVS(m, nfn)), conjunct by conjunct
;;; ==========================================================================================
(define cnvb-nvs-closers
  (list (cons 'cmod-nvs-length (cnvb-length-closer 7))
        (cons 'cmod-nvs-scal-ring cnvb-ass!)
        (cons 'cmod-nvs-vec-set (cnvb-cite-closer #f 'frm-module-vec-set))
        (cons 'cmod-nvs-vadd-fun (cnvb-cite-closer #f 'cmod-vadd-fun))
        (cons 'cmod-nvs-vzero-in (cnvb-cite-closer #f 'module-vzero-in))
        (cons 'cmod-nvs-vneg-fun (cnvb-cite-closer #f 'cmod-vneg-fun))
        (cons 'cmod-nvs-act-fun (cnvb-cite-closer #f 'cmod-ract-fun))
        (cons 'cmod-nvs-vnrm-fun cnvb-ass!)
        (cons 'cmod-nvs-assoc (cnvb-cite-closer #f 'cmod-assoc-prop))
        (cons 'cmod-nvs-comm (cnvb-cite-closer #f 'cmod-comm-prop))
        (cons 'cmod-nvs-identity (cnvb-cite-closer #f 'cmod-identity-prop))
        (cons 'cmod-nvs-inverses (cnvb-cite-closer #f 'cmod-inverses-prop))
        (cons 'cmod-nvs-scal-pin (lambda (sv) (rfl)))
        (cons 'cmod-nvs-act-vadd (cnvb-cite-closer #f 'cmod-act-vadd-cc))
        (cons 'cmod-nvs-act-add (cnvb-cite-closer #f 'cmod-act-add-cc))
        (cons 'cmod-nvs-act-mul (cnvb-cite-closer #f 'cmod-act-mul-cc))
        (cons 'cmod-nvs-act-one (cnvb-cite-closer #f 'cmod-act-one))
        (cons 'cmod-nvs-nonneg (cnvb-cite-closer #t 'cmod-norm-nonneg))
        (cons 'cmod-nvs-definite (cnvb-cite-closer #t 'cmod-norm-zero-iff))
        (cons 'cmod-nvs-homog (cnvb-cite-closer #t 'cmod-norm-homog-rr))
        (cons 'cmod-nvs-triangle (cnvb-cite-closer #t 'cmod-norm-triangle))))
(define cnvb-nvs-conjs (cnvb-conjuncts 'is-normed-vector-space cnvb-N))
(if (not (= (length cnvb-nvs-conjs) (length cnvb-nvs-closers)))
    (error "cnvs-b: IS-NORMED-VECTOR-SPACE has" (length cnvb-nvs-conjs) 'conjuncts 'not (length cnvb-nvs-closers)))
(for-each (lambda (conj nc) (cnvb-law! (car nc) 'cmod-nvs- conj (cdr nc))) cnvb-nvs-conjs cnvb-nvs-closers)

(sp (make-wff (cnvb-stmt '(IS-NORMED-VECTOR-SPACE (CMOD-NVS m nfn)))))
(dk-peel!)
(fact 'cmod-nvs-length 'm 'nfn)
(mac 'IS-NORMED-VECTOR-SPACE)
(dk-isx-set!)
(for-each (lambda (nc) (fact (car nc) 'm 'nfn)) cnvb-nvs-closers)
(dk-conj-close! (lambda () (ass)))
(cnvb-qed! 'cmod-nvs-is-nvs)

;;; ==========================================================================================
;;; IS-COMPLEX-NORMED-VECTOR-SPACE(CMOD-CNVS(m, nfn)), conjunct by conjunct
;;; ==========================================================================================
;;; CACT on the realification is the module's action
(sp (make-wff (cnvb-stmt (list 'FORALL 'cnc_ (list 'IMPLIES '(IN cnc_ CC) (list 'FORALL 'cnx_ (list 'IMPLIES '(IN cnx_ (VEC m))
  (list '= (list (list 'CACT cnvb-L) 'cnc_ 'cnx_) '((ACT m) cnc_ cnx_)))))))))
(cnvb-law-open! 'cmod-cnvs-)
(dk-peel!)
(dk-cite! 'real-part-in-rr 'cnc_) (dk-cite! 'imag-part-in-rr 'cnc_)
(fact 'cmod-act-type-cc 'm '+i 'cnx_)
(cnvb-cc! '(real-part cnc_)) (cnvb-cc! '(imag-part cnc_))
(fact 'cmod-act-type-cc 'm '(real-part cnc_) 'cnx_)
(fact 'cmod-act-type-cc 'm '(imag-part cnc_) '((ACT m) +i cnx_))
(fact 'cmod-act-type-cc 'm 'cnc_ 'cnx_)
(mac 'CACT)
(cnvb-readoffs! 'cmod-cnvs-)
(dk-lam-b!)
(cnvb-reduce!)
(if (not (proof-done? *ps*))
    (begin (fact 'cmod-cact-decompose 'm 'cnc_ 'cnx_) (ass)))
(cnvb-qed! 'cmod-cact-value)

(define cnvb-cnvs-closers
  (list (cons 'cmod-cnvs-length (cnvb-length-closer 8))
        (cons 'cmod-cnvs-scal-ring cnvb-ass!)
        (cons 'cmod-cnvs-vec-set (cnvb-cite-closer #f 'frm-module-vec-set))
        (cons 'cmod-cnvs-vadd-fun (cnvb-cite-closer #f 'cmod-vadd-fun))
        (cons 'cmod-cnvs-vzero-in (cnvb-cite-closer #f 'module-vzero-in))
        (cons 'cmod-cnvs-vneg-fun (cnvb-cite-closer #f 'cmod-vneg-fun))
        (cons 'cmod-cnvs-act-fun (cnvb-cite-closer #f 'cmod-ract-fun))
        (cons 'cmod-cnvs-vnrm-fun cnvb-ass!)
        (cons 'cmod-cnvs-jop-fun (cnvb-cite-closer #f 'cmod-j-fun))
        (cons 'cmod-cnvs-nvs
              (lambda (sv)
                (fact 'cmod-nvs-is-nvs 'm 'nfn)
                (fact 'cmod-nvs-unfold 'm 'nfn)
                (subst (list '= (caddr (lookup-theorem-instance-cnvb)) cnvb-N))
                (ass)))
        (cons 'cmod-cnvs-real-linear (cnvb-cite-closer #f 'cmod-j-fun 'cmod-j-add 'cmod-j-act))
        (cons 'cmod-cnvs-square (cnvb-cite-closer #f 'cmod-j-sq))
        (cons 'cmod-cnvs-cact-homog
              (lambda (sv)
                (let ((c (car (caddr sv))) (x (car (cadr sv))))
                  (subst (dk-cite! 'cmod-cact-value 'm 'nfn c x))
                  (fact 'cmod-norm-homog 'm 'nfn c x)
                  (ass))))))
(define (lookup-theorem-instance-cnvb)       ; the unfold equation, as landed
  (dk-pick (lambda (f) (and (dk-head-is? f '==) (equal? (cadr f) cnvb-N))) "the CMOD-NVS unfold"))
(define cnvb-cnvs-conjs (cnvb-conjuncts 'is-complex-normed-vector-space cnvb-L))
(if (not (= (length cnvb-cnvs-conjs) (length cnvb-cnvs-closers)))
    (error "cnvs-b: IS-COMPLEX-NORMED-VECTOR-SPACE has" (length cnvb-cnvs-conjs) 'conjuncts 'not (length cnvb-cnvs-closers)))
(for-each (lambda (conj nc) (cnvb-law! (car nc) 'cmod-cnvs- conj (cdr nc))) cnvb-cnvs-conjs cnvb-cnvs-closers)

;;; THE REALIFICATION THEOREM
(sp (make-wff (cnvb-stmt '(IS-COMPLEX-NORMED-VECTOR-SPACE (CMOD-CNVS m nfn)))))
(dk-peel!)
(fact 'cmod-cnvs-length 'm 'nfn)
(mac 'IS-COMPLEX-NORMED-VECTOR-SPACE)
(dk-isx-set!)
(for-each (lambda (nc) (fact (car nc) 'm 'nfn)) cnvb-cnvs-closers)
(dk-conj-close! (lambda () (ass)))
(cnvb-qed! 'cmod-cnvs-is-cnvs)
