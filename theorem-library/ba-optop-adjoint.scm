;;; ba-optop-adjoint.scm -- Thayer, Banach Algebras and Applications, Prop 5.11, third clause:
;;; S |-> S* is continuous for the weak operator topology.  The proof is the notes':
;;;     p_(xi,eta)(S*) = |<S* xi | eta>| = |<xi | S eta>| = |<S eta | xi>| = p_(eta,xi)(S),
;;; with the seminorm continuity condition for a map that is only ADDITIVE (S* is conjugate-linear,
;;; so IS-LINEAR-MAP fails): sn-cont-of-single-bound-sub (tvs-sub-bound.scm).
;;; Agent BA-1111-C, 2026-11-11.  DESTINATION: theorem-library/ba-optop-adjoint.scm, after
;;; ba-optop.scm and tvs-sub-bound.scm.  Vocabulary: structure-library/ba-optop-vocab.scm.
;;; Library: operator-algebras.  Helper prefix: oa-.

(define (oa-done?) (sequent-node-grounded? (proof-state-focus *ps*)))
(define (oa-qed! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** ba-optop-adjoint: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'analysis))

(define oa-ccr '(NORMED-FIELD-AS-COMMUTATIVE-RING CC-NORMED-FIELD))
(define oa-BO '(BOUNDED-OPS v v))
(define oa-M '(BH-MODULE v))
(define oa-VV '(CARTESIAN (VEC v) (VEC v)))
(define oa-HV '((IS-HILBERT-SPACE v)))
(define (oa-has? h e) (or (equal? h e) (and (pair? e) (or (oa-has? h (car e)) (oa-has? h (cdr e))))))
(define (oa-adj t) (list 'OP-ADJOINT 'v 'v t))

(define (oa-typings!)
  (dk-cite! 'hilbert-space-is-cips 'v)
  (dk-cite! 'bounded-ops-is-set 'v 'v)
  (for-each (lambda (n) (dk-cite! n 'v)) '(bh-vadd-type bh-vneg-type bh-act-type))
  (dk-cite! 'bop-zero-bounded 'v 'v)
  (dk-cite! 'cips-vec-set 'v)
  (dk-cite! 'cc-is-normed-field)
  (dk-cite! 'normed-field-as-commutative-ring-is-commutative-ring 'CC-NORMED-FIELD)
  (dk-cite! 'commutative-ring-is-ring oa-ccr))
(define oa-accs '(SCAL VEC VADD VZERO VNEG ACT))
(define oa-vals (list oa-ccr oa-BO '(BH-VADD v) '(BOP-ZERO v v) '(BH-VNEG v) '(BH-ACT v)))
(define (oa-mod-setup!)
  (oa-typings!)
  (dk-cite! 'bh-module-is-module 'v)
  (for-each (lambda (acc) (dk-cite! (symbol-append 'bh-module- acc) 'v)) oa-accs))
(define (oa-mod-subst!)
  (for-each (lambda (acc val) (if (oa-has? (list acc oa-M) (dk-goal)) (subst (list '== (list acc oa-M) val))))
            oa-accs oa-vals)
  (if (oa-has? (list 'CARR oa-ccr) (dk-goal)) (subst (dk-cite! 'cc-scalar-ring-carr))))
(define (oa-p12! p)
  (let ((cn (dk-cite! 'cartesian-nth p '(VEC v) '(VEC v))))
    (if (not (dk-asm? (list 'IN (list 'NTH 1 p) '(VEC v)))) (dk-split! cn)))
  (list (list 'NTH 1 p) (list 'NTH 2 p)))
(define (oa-adj-typed! s)              ; s in BO: land s* in BO and in FUN
  (dk-cite! 'op-adjoint-bounded 'v 'v s)
  (dk-cite! 'bop-fun 'v 'v (oa-adj s)))

;;; ---------------------------------------------------------------------------------------------
;;; (-T)* = -(T*)
(sp (make-wff (forall-guarded '(v t_) (append oa-HV (list (list 'IN 't_ oa-BO)))
                (list '= (oa-adj '(BOP-NEG v v t_)) (list 'BOP-NEG 'v 'v (oa-adj 't_))))))
(dk-peel!)
(dk-cite! 'hilbert-space-is-cips 'v)
(dk-cite! 'bop-fun 'v 'v 't_)
(dk-cite! 'bop-neg-bounded 'v 'v 't_)
(oa-adj-typed! 't_)
(dk-cite! 'bop-neg-bounded 'v 'v (oa-adj 't_))
(dk-cite! 'bop-fun 'v 'v (list 'BOP-NEG 'v 'v (oa-adj 't_)))
(let* ((g (list 'BOP-NEG 'v 'v (oa-adj 't_)))
       (u (dk-cite! 'op-adjoint-unique 'v 'v '(BOP-NEG v v t_) g))
       (imp (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-head-is? (cadr f) 'FORALL)
                                      (dk-head-is? (caddr f) '=) (equal? (caddr (caddr f)) g)))
                     "the uniqueness implication")))
  (dk-have! (cadr imp)
    (lambda ()
      (let* ((pl (dk-peel!)) (x (cadr (car pl))) (y (cadr (cadr pl)))
             (tx (list 't_ x)) (ay (list (oa-adj 't_) y)))
        (dk-cite! 'fun-apply-type-c 't_ '(VEC v) '(VEC v) x)
        (dk-cite! 'fun-apply-type-c (oa-adj 't_) '(VEC v) '(VEC v) y)
        (subst (dk-cite! 'bop-neg-apply 'v 'v 't_ x))
        (subst (dk-cite! 'bop-neg-apply 'v 'v (oa-adj 't_) y))
        (subst (dk-cite! 'cips-ip-neg-left 'v tx y))
        (subst (dk-cite! 'cips-ip-neg-right 'v x ay))
        (subst (dk-cite! 'op-adjoint-ip 'v 'v 't_ x y))
        (dk-cite! 'cips-ip-type 'v x ay)
        (if (not (oa-done?)) (rfl)))))
  (detach! imp)
  (if (not (oa-done?)) (ass)))
(oa-qed! 'op-adjoint-neg)

;;; ---------------------------------------------------------------------------------------------
;;; the adjoint map S |-> S* on L(H): its typing and the subtraction law in the module L(H)
(define oa-adjmap (list 'VNB-LAMBDA 'ots_ oa-BO (oa-adj 'ots_)))
(define oa-fun (list 'IN oa-adjmap (list 'FUN (list 'VEC oa-M) (list 'VEC oa-M))))
;;; the sublaw of tvs-sub-bound.scm at m1 = m2 = L(H), tt = the adjoint map
(define oa-sublaw
  (list 'FORALL 'sba_ (list 'IMPLIES (list 'IN 'sba_ (list 'VEC oa-M)) (list 'FORALL 'sbb_ (list 'IMPLIES (list 'IN 'sbb_ (list 'VEC oa-M))
     (list '= (list oa-adjmap (list (list 'VADD oa-M) 'sba_ (list (list 'VNEG oa-M) 'sbb_)))
              (list (list 'VADD oa-M) (list oa-adjmap 'sba_) (list (list 'VNEG oa-M) (list oa-adjmap 'sbb_)))))))))

(sp (make-wff (forall-guarded '(v) oa-HV oa-fun)))
(dk-peel!)
(oa-mod-setup!)
(oa-mod-subst!)
(dk-lam-type! (lambda () (let ((s (dk-di-var!))) (dk-cite! 'op-adjoint-bounded 'v 'v s) (if (not (oa-done?)) (ass)))))
(oa-qed! 'bh-adjoint-map-type)

(sp (make-wff (forall-guarded '(v) oa-HV oa-sublaw)))
(let* ((pl0 (dk-peel!))
       (_0 (oa-mod-setup!))
       (bs (map cadr (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) (list 'VEC oa-M)))) pl0)))
       (a (car bs)) (b (cadr bs)))
  (for-each (lambda (x) (dk-rewrite-h! (list 'IN x (list 'VEC oa-M)) (list 'VEC oa-M) oa-BO)) bs)
  (oa-mod-subst!)
  (dk-cite! 'bop-neg-bounded 'v 'v b)
  (subst (dk-cite! 'bh-vneg-value 'v b))
  (subst (dk-cite! 'bh-vadd-value 'v a (list 'BOP-NEG 'v 'v b)))
  (dk-cite! 'bop-sum-bounded 'v 'v a (list 'BOP-NEG 'v 'v b))
  (dk-lam-b!)
  (oa-adj-typed! a) (oa-adj-typed! b)
  (dk-cite! 'bop-neg-bounded 'v 'v (oa-adj b))
  (subst (dk-cite! 'op-adjoint-sum 'v 'v a (list 'BOP-NEG 'v 'v b)))
  (subst (dk-cite! 'op-adjoint-neg 'v b))
  (if (oa-has? (list (list 'BH-VNEG 'v) (oa-adj b)) (dk-goal))
      (subst (dk-cite! 'bh-vneg-value 'v (oa-adj b))))
  (if (oa-has? (list 'BH-VADD 'v) (dk-goal))
      (subst (dk-cite! 'bh-vadd-value 'v (oa-adj a) (list 'BOP-NEG 'v 'v (oa-adj b)))))
  (if (not (oa-done?)) (let ((g (dk-goal))) (if (equal? (cadr g) (caddr g)) (rfl) (qrfl)))))
(oa-qed! 'bh-adjoint-map-sub)

;;; ---------------------------------------------------------------------------------------------
;;; Prop 5.11, third clause: S |-> S* is WOT -> WOT continuous
(define (oa-le-one! n) (dk-cite! 'rr-one-in) (dk-ineq! (list 'IN n 'RR)))
(sp (make-wff (forall-guarded '(v) oa-HV (list 'IS-HOM-TOP-SPACE '(WOT v) '(WOT v) oa-adjmap))))
(dk-peel!)
(oa-mod-setup!)
(dk-cite! 'wot-seminorm-family 'v)
(dk-cite! 'bh-adjoint-map-type 'v)
(dk-cite! 'bh-adjoint-map-sub 'v)
(dk-cite! 'sn-cont-of-single-bound-sub 'CC-NORMED-FIELD oa-M oa-VV '(WOT-PF v) oa-M oa-VV '(WOT-PF v) oa-adjmap)
(mac 'WOT)
(let ((imp (dk-pick (lambda (f) (and (dk-head-is? f 'IMPLIES) (dk-head-is? (caddr f) 'IS-HOM-TOP-SPACE)
                                     (dk-head-is? (cadr f) 'FORALL)))
                    "the bound implication")))
  (dk-have! (cadr imp)
    (lambda ()
      (let* ((p (dk-di-var!)) (pc (oa-p12! p)) (p1 (car pc)) (p2 (cadr pc)) (q (list 'LIST p2 p1)))
        (dk-cite! 'pair-in-cartesian '(VEC v) '(VEC v) p2 p1)
        (dk-cite! 'rr-one-in) (dk-have! '(<= 0 1) (lambda () (dk-ineq!)))
        (ew q)
        (dk-conj-close!
          (lambda ()
            (cond
              ((oa-done?) #t)
              ((dk-asm? (dk-goal)) (ass))
              (#t
               (ew 1)
               (dk-conj-close!
                 (lambda ()
                   (cond
                     ((oa-done?) #t)
                     ((dk-asm? (dk-goal)) (ass))
                     (#t
                      (oa-mod-subst!)
                      (let* ((s (dk-di-var!)) (as (oa-adj s)) (ap1 (list as p1)) (sp2 (list s p2)))
                        (dk-lam-b!)
                        (oa-adj-typed! s)
                        (dk-cite! 'bop-fun 'v 'v s)
                        (dk-cite! 'fun-apply-type-c as '(VEC v) '(VEC v) p1)
                        (dk-cite! 'fun-apply-type-c s '(VEC v) '(VEC v) p2)
                        (subst (dk-cite! 'wot-pf-apply 'v p as))
                        (subst (dk-cite! 'wot-pf-apply-pair 'v p2 p1 s))
                        (subst (dk-cite! 'cips-ip-conj-sym 'v p2 ap1))
                        (let ((e (dk-cite! 'op-adjoint-ip 'v 'v s p2 p1)))
                          (subst (list '= (caddr e) (cadr e))))
                        (dk-cite! 'cips-ip-type 'v sp2 p1)
                        (subst (dk-cite! 'cc-magnitude-conjugate (list '(IP v) sp2 p1)))
                        (dk-cite! 'cc-magnitude-closed (list '(IP v) sp2 p1))
                        (oa-le-one! (list 'magnitude (list '(IP v) sp2 p1)))))))))))))))
  (detach! imp)
  (if (not (oa-done?)) (ass)))
(oa-qed! 'bop-adjoint-wot-continuous)

;;; =============================================================================================
;;; THE BOUND (107) OF A STRONGLY CONTINUOUS FUNCTIONAL: the first step of the necessity in
;;; Prop 5.1.  phi in L.(H) gives a finite set F of vectors and c > 0 with |phi(T)| <= c max_(xi in F) ||T xi||,
;;; stated without forming the maximum (tvs-continuity.scm's convention): for every t >= 0 with
;;; ||T xi|| <= t for all xi in F, |phi(T)| <= c t.  An instance of sn-bound-of-cont-cc.
(define oa-ccpf '(VNB-LAMBDA otk_ (PAIR 0 0) (VNB-LAMBDA otz_ CC (magnitude otz_))))
(define oa-sd-sep
  '(SEP otf_ (FUN (BOUNDED-OPS v v) CC)
     (AND (IS-LINEAR-MAP (BH-MODULE v) CC-SN-MODULE otf_) (IS-HOM-TOP-SPACE (SOT v) CC-SN-TOP otf_))))
(sp (make-wff (list 'FORALL 'v (list '== '(STRONG-DUAL v) oa-sd-sep))))
(dk-peel!) (mac 'STRONG-DUAL) (mac 'OP-DUAL) (qrfl)
(oa-qed! 'strong-dual-unfold-sot)
(sp (make-wff '(FORALL v (== (SOT v) (SEMINORM-TOP (BH-MODULE v) (VEC v) (SOT-PF v))))))
(dk-peel!) (mac 'SOT) (qrfl)
(oa-qed! 'sot-unfold)

(define oa-sd-bound
  '(FORSOME sbf_ (AND (IN sbf_ SET) (AND (IN (CARD sbf_) NN) (AND (SUBSET sbf_ (VEC v))
     (FORSOME sbc_ (AND (IN sbc_ RR) (AND (POS-RR sbc_)
       (FORALL sbx_ (IMPLIES (IN sbx_ (BOUNDED-OPS v v))
         (FORALL sbt_ (IMPLIES (IN sbt_ RR) (IMPLIES (<= 0 sbt_)
           (IMPLIES (FORALL sbi_ (IMPLIES (IN sbi_ sbf_) (<= (IP-NORM v (sbx_ sbi_)) sbt_)))
             (<= (magnitude (f_ sbx_)) (* sbc_ sbt_))))))))))))))))
(sp (make-wff (forall-guarded '(v f_) '((IS-COMPLEX-INNER-PRODUCT-SPACE v) (IN f_ (STRONG-DUAL v))) oa-sd-bound)))
(dk-peel!)
(dk-cite! 'bounded-ops-is-set 'v 'v)
(dk-cite! 'cc-is-set)
(dk-cite! 'strong-dual-unfold-sot 'v)
(sep-me (dk-rewrite-h! '(IN f_ (STRONG-DUAL v)) '(STRONG-DUAL v) oa-sd-sep))
(dk-split-all!)
(dk-cite! 'sot-unfold 'v)
(dk-cite! 'cc-sn-top-def)
(dk-cite! 'cc-sn-pf-def)
(let* ((h1 (dk-rewrite-h! '(IS-HOM-TOP-SPACE (SOT v) CC-SN-TOP f_) '(SOT v) '(SEMINORM-TOP (BH-MODULE v) (VEC v) (SOT-PF v))))
       (h2 (dk-rewrite-h! h1 'CC-SN-TOP '(SEMINORM-TOP CC-SN-MODULE (PAIR 0 0) CC-SN-PF)))
       (h3 (dk-rewrite-h! h2 'CC-SN-PF oa-ccpf))
       (fam2 (dk-rewrite-h! (dk-cite! 'cc-sn-family) 'CC-SN-PF oa-ccpf)))
  (dk-cite! 'sot-seminorm-family 'v)
  (dk-cite! 'nn-zero-in)
  (dk-cite! 'membership-implies-sethood 0 'NN)
  (dk-have! '(AND (IN 0 SET) (IN 0 SET)))
  (dk-cite! 'pairing 0 0)
  (dk-cite! 'pair-self-member 0)
  (dk-cite! 'bh-module-vec 'v)
  (let* ((all (dk-cite! 'sn-bound-of-cont-cc oa-M '(VEC v) '(SOT-PF v) 'CC-SN-MODULE '(PAIR 0 0) oa-ccpf 'f_))
         (all2 (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f 'sbf_) (not (dk-contains? f 'IS-HOM-TOP-SPACE))))
                        "the bound for every j"))
         (ex (dk-apply! all2 0))
         (ff (dk-skolem! ex #t))
         (cb (dk-skolem! (dk-pick (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f ff))) "constant") #t))
         (body (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f cb))) "the bound")))
    (ew ff)
    (dk-conj-close!
      (lambda ()
        (cond
          ((oa-done?) #t)
          ((dk-ass!) #t)
          (#t
           (ew cb)
           (dk-conj-close!
             (lambda ()
               (cond
                 ((oa-done?) #t)
                 ((dk-ass!) #t)
                 (#t
                  (let* ((ld (dk-peel!))
                         (tv (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (equal? (caddr f) oa-BO))) ld))))
                         (t (cadr (car (filter (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'RR))) ld))))
                         (hh (car (filter (lambda (f) (dk-head-is? f 'FORALL)) ld)))
                         (allf (list 'FORALL 'sbi_ (list 'IMPLIES (list 'IN 'sbi_ ff)
                                 (list '<= (list (list '(SOT-PF v) 'sbi_) tv) t)))))
                    (dk-have! (list 'IN tv (list 'VEC oa-M)) (lambda () (subst (list '== (list 'VEC oa-M) oa-BO)) (dk-ass!)))
                    (dk-have! allf
                      (lambda ()
                        (let ((i (car (map cadr (filter (lambda (f) (dk-head-is? f 'IN)) (dk-peel!))))))
                          (dk-cite! 'subset-mem-fwd ff '(VEC v) i)
                          (dk-apply! hh i)
                          (subst (dk-cite! 'sot-pf-apply 'v i tv))
                          (dk-ass!))))
                    (dk-cite! 'fun-apply-type-c 'f_ oa-BO 'CC tv)
                    (let ((le (dk-apply! body tv t)))
                      (dk-lam-b-h! le)
                      (let ((le2 (dk-pick (lambda (f) (and (dk-head-is? f '<=) (dk-contains? f 'otz_) (dk-contains? f cb))) "the half-reduced bound")))
                        (dk-lam-b-h! le2)))
                    (if (not (oa-done?)) (dk-ass!)))))))))))))
(oa-qed! 'strong-dual-bound)

