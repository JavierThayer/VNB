;;; la-z5-card52.scm -- linear algebra 3.52: if E is a finitely generated free abelian
;;; group, F a subgroup and N_E(F) /= 0, then card(E/F) = N_E(F) (LA-Z5, 2026-10-25).
;;; Prefix lz5q-.
;;;
;;; THE THEOREMS.
;;;   diagonal-det-prod: the determinant of a diagonal integer matrix is the product of
;;;       its diagonal (a diagonal matrix is upper triangular: det-upper-triangular).
;;;   principal-sequence-of-presentation: when F has a relation-free spanning sequence
;;;       ys = am . u of the length n of a free generating sequence u of E (IS-NORM-DATA),
;;;       3.44's adapted basis es, dm can be chosen with dm . es relation-free (it is
;;;       U . ys for an invertible U).
;;;   cyclic-dsum-card: for an n-by-n integer matrix dm with every dm_ii >= 1,
;;;       Z/(dm_11) + ... + Z/(dm_nn) has dm_11 * ... * dm_nn elements.
;;;   quotient-card-norm (3.52): E = VEC(md) over ZZ-RING with a free generating
;;;       sequence u of length n, F = sm a submodule, N_E(F) /= 0:
;;;       CARD(VEC(QUOTIENT-MODULE(md, sm))) = SUBMODULE-NORM(md, sm).
;;; PLAN (the notes' route).  N_E(F) /= 0 forces the presentation data of the norm; the
;;; adapted basis gives IS-NORM-DATA(es, dm . es, dm), so N_E(F) = |det dm| (3.45 through
;;; submodule-norm-value); det dm = dm_11 ... dm_nn, so no dm_ii is 0 and all are >= 1;
;;; 3.49 gives E/F isomorphic to the direct sum of the Z/(dm_ii), whose cardinality is the
;;; product (cyclic-dsum-card); an isomorphism is a bijection (card-bijection-eq).
;;;
;;; Destination theorem-library/.  Library: linear-algebra.  LOAD WINDOW: after
;;; theorem-library/la-z4-free (iso-module-inverse; load.scm 2686), la-z3-struct
;;; (quotient-by-diagonal-subgroup, 2685), la-z3-smith (integer-normal-form-elementary,
;;; 2194), and the LA-Z5 files la-z5-norm, la-z5-zzmod, la-z5-dsumcard.  Nothing in the
;;; tree cites the file.

(define (lz5q-done! name)
  (if (not (proof-done? *ps*))
      (begin
        (display "\n*** la-z5-card52: ") (display name) (display " did NOT close.\n")
        (for-each (lambda (l)
                    (display ";;   leaf: ")
                    (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display ";;      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))))
  (qed name)
  (topic! name 'algebra))
(define (lz5q-detach-all! inst)
  (let loop ((f inst))
    (if (and (pair? f) (eq? (car f) 'IMPLIES))
        (let ((a (cadr f)))
          (if (not (dk-asm? a)) (dk-have! a (dk-lane (lambda () (dk-lane-if! prop)))))
          (loop (if (dk-asm? (caddr f)) (dk-ctx-form (caddr f))
                    (dk-landed-1 (lambda () (detach! f))))))
        f)))
(define (lz5q-cite! thm . args) (lz5q-detach-all! (apply dk-cite! thm args)))
(define (lz5q-ass-ctx!) (if (and (not (sequent-node-grounded? (proof-state-focus *ps*))) (dk-asm? (dk-goal))) (ass)))
(define (lz5q-ass-if! g)
  (if (and (not (sequent-node-grounded? (proof-state-focus *ps*))) (equal? (dk-goal) g)) (ass)))
(define (lz5q-by! thunk) (let ((g0 (dk-goal))) (thunk) (lz5q-ass-if! g0)))
(define (lz5q-split! r) (if (dk-head-is? r 'AND) (dk-split! r)) r)
(define (lz5q-iff-l! iff)
  (let ((rhs (caddr iff)))
    (dk-have! rhs (dk-lane (lambda () (dk-only! iff (cadr iff)) (dk-lane-if! prop))))
    rhs))
(define (lz5q-zsetup!)
  (fact 'zz-is-commutative-ring)
  (fact 'zz-is-ring)
  (fact 'zz-is-euclidean-ring)
  (dk-have! '(== (CARR ZZ-RING) ZZ) (lambda () (slot 'CARR) (qrfl))))
(define (lz5q-diag m) (list 'VNB-LAMBDA 'dgk_ (list 'INTERVAL 1 m) (list 'ENTRY 'dm 'dgk_ 'dgk_)))
(define (lz5q-prod m) (list 'PROD-RING 'ZZ-RING (lz5q-diag m) (list 'INTERVAL 1 m)))

;;; ---- the determinant of a diagonal matrix ----
(sp (make-wff (forall-guarded '(n dm) '((IN n NN) (IN dm (MAT n n ZZ)) (IS-DIAGONAL ZZ-RING n n dm))
  (list '= '(DET ZZ-RING n dm) (lz5q-prod 'n)))))
(dk-peel!)
(lz5q-zsetup!)
(dk-rewrite-h! '(IN dm (MAT n n ZZ)) 'ZZ '(CARR ZZ-RING))
(define LZ5Q-DIAG-IFF (dk-cite! 'is-diagonal 'ZZ-RING 'n 'n 'dm))
(define LZ5Q-DIAG-ALL (lz5q-iff-l! LZ5Q-DIAG-IFF))
(dk-have! '(IS-UPPER-TRIANGULAR ZZ-RING n dm)
  (lambda ()
    (mac 'IS-UPPER-TRIANGULAR)
    (let* ((ld (dk-peel!))
           (lt (find-first (dk-head? '<) ld))
           (v (cadr lt)) (u (caddr lt)))
      (for-each (lambda (x) (lz5q-cite! 'interval-elt-in-nn 1 'n x) (lz5q-cite! 'nn-in-rr x)) (list u v))
      (dk-have! (list 'NOT (list '= u v)) (lambda () (di) (dk-absurd! (list '< v u) (list '= u v))))
      (lz5q-by! (lambda () (lz5q-detach-all! (dk-apply! (dk-ctx-form LZ5Q-DIAG-ALL) u v)))))))
(lz5q-by! (lambda () (lz5q-cite! 'det-upper-triangular 'ZZ-RING 'n 'dm)))
(lz5q-done! 'diagonal-det-prod)
(gloss! 'diagonal-det-prod "The determinant of a diagonal integer matrix is the product of its diagonal entries.")

;;; ---- 3.44 for a presentation: the adapted basis with dm . es relation-free ----
(define LZ5Q-S '(SCAL md))
(define (lz5q-iv n) (list 'INTERVAL 1 n))
(define (lz5q-up! f)                    ; F over ZZ-RING => F over (SCAL md), by rewriting the GOAL
  (let ((g (dk--replace f 'ZZ-RING LZ5Q-S)))
    (dk-have! g (lambda () (subst (list '= LZ5Q-S 'ZZ-RING)) (ass)))
    g))
(define (lz5q-mm rg a b) (list 'MATMUL rg a b))
(define (lz5q-split-on! w)
  (let loop ()
    (let ((cj (find-first (lambda (f) (and (dk-head-is? f 'AND) (dk-contains? f w))) (dk-asms))))
      (if cj (begin (dk-split! cj) (loop))))))
(define (lz5q-skolem-split! ex) (let ((w (dk-skolem! ex))) (lz5q-split-on! w) w))
(define (lz5q-nonneg d m n)
  (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ (lz5q-iv m)) (list 'IMPLIES (list 'IN 'i_ (lz5q-iv n)) (list '<= 0 (list 'ENTRY d 'i_ 'i_))))))
(define (lz5q-chain d m n)
  (list 'FORALL 'ci_ (list 'FORALL 'cj_
    (list 'IMPLIES (list 'IN 'ci_ (lz5q-iv m)) (list 'IMPLIES (list 'IN 'ci_ (lz5q-iv n))
    (list 'IMPLIES (list 'IN 'cj_ (lz5q-iv m)) (list 'IMPLIES (list 'IN 'cj_ (lz5q-iv n))
    (list 'IMPLIES '(<= ci_ cj_) (list 'ZZ-DIVIDES (list 'ENTRY d 'ci_ 'ci_) (list 'ENTRY d 'cj_ 'cj_))))))))))
(sp (make-wff (forall-guarded '(md) '((IS-MODULE md) (= (SCAL md) ZZ-RING))
  (forall-guarded '(sm n u ys am) '((IS-SUBMODULE md sm) (IS-NORM-DATA md sm n u ys am))
    '(FORSOME es (FORSOME dm (AND (IS-PRINCIPAL-SEQUENCE md n sm es dm) (REL-FREE md n (MATACT md dm es)))))))))
(dk-peel!)
(let* ((iff (dk-cite! 'is-norm-data 'md 'sm 'n 'u 'ys 'am))
       (rhs (lz5q-iff-l! iff)))
  (let loop ((todo (list (dk-ctx-form rhs))))
    (if (pair? todo)
        (if (dk-head-is? (car todo) 'AND) (loop (append (dk-split! (car todo)) (cdr todo))) (loop (cdr todo))))))
(fact 'module-scalar-ring 'md)
(lz5q-zsetup!)
(let* ((cm 'am)
       (um (lz5q-skolem-split! (dk-cite! 'integer-normal-form-elementary 'n 'n cm)))
       (vm (lz5q-skolem-split! (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f um))) (dk-asms))))
       (vi (lz5q-skolem-split! (dk-cite! 'elem-gen-inverse 'ZZ-RING 'n vm)))
       (dz (lz5q-mm 'ZZ-RING (lz5q-mm 'ZZ-RING um cm) vm))
       (xs (lz5q-mm LZ5Q-S um cm))
       (ds (lz5q-mm LZ5Q-S xs vm))
       (es (list 'MATACT 'md vi 'u)))
  (dk-have! (list 'IN cm (list 'MAT 'n 'n '(CARR ZZ-RING))) (lambda () (subst '(== (CARR ZZ-RING) ZZ)) (ass)))
  (lz5q-up! (list 'IN cm (list 'MAT 'n 'n '(CARR ZZ-RING))))
  (for-each (lambda (x) (fact 'elem-gen-mat 'ZZ-RING 'n x)) (list um vm vi))
  (for-each (lambda (x) (lz5q-up! (list 'IN x '(MAT n n (CARR ZZ-RING))))) (list um vm vi))
  (fact 'elem-gen-invertible 'ZZ-RING 'n um)
  (fact 'elem-gen-invertible 'ZZ-RING 'n vi)
  (lz5q-up! (list 'IS-INVERTIBLE-MAT 'ZZ-RING 'n um))
  (lz5q-up! (list 'IS-INVERTIBLE-MAT 'ZZ-RING 'n vi))
  (dk-have! (list 'IN dz '(MAT n n (CARR ZZ-RING))) dk-typ-close!)
  (dk-rewrite-h! (list 'IN dz '(MAT n n (CARR ZZ-RING))) '(CARR ZZ-RING) 'ZZ)
  (dk-have! (list 'IN xs (list 'MAT 'n 'n (list 'CARR LZ5Q-S))) dk-typ-close!)
  (dk-have! (list 'IN ds (list 'MAT 'n 'n (list 'CARR LZ5Q-S))) dk-typ-close!)
  (let ((dseq (list '= ds dz)))
    (dk-have! dseq (lambda () (subst (list '= LZ5Q-S 'ZZ-RING)) (rfl)))
    (lz5q-cite! 'matact-type 'md 'n 'n 1 vi 'u)
    (fact 'generates-transport 'md 'n 'u vi)
    (fact 'free-transport 'md 'n 'u vi)
    (lz5q-cite! 'matmul-assoc LZ5Q-S 'n 'n 'n 'n xs vm vi)
    (let* ((e1 (lz5q-cite! 'matact-assoc 'md 'n 'n 'n 1 ds vi 'u))
           (e3 (lz5q-up! (list '= (lz5q-mm 'ZZ-RING vm vi) '(IDENTMAT ZZ-RING n))))
           (e4 (dk-cite! 'identmat-right-identity LZ5Q-S 'n 'n xs))
           (e5 (lz5q-cite! 'matact-assoc 'md 'n 'n 'n 1 um cm 'u))
           (sp0 (fact 'spans-transport 'md 'n 'ys um 'sm))
           (rf0 (fact 'free-transport 'md 'n 'ys um))
           (dses (list 'MATACT 'md ds es))
           (eqd (list '= dses (list 'MATACT 'md um 'ys))))
      (dk-have! eqd
        (lambda ()
          (subst (list '= (list 'MATACT 'md ds es) (list 'MATACT 'md (lz5q-mm LZ5Q-S ds vi) 'u)))
          (subst (list '= (lz5q-mm LZ5Q-S ds vi) (lz5q-mm LZ5Q-S xs (lz5q-mm LZ5Q-S vm vi))))
          (subst (list '= (lz5q-mm LZ5Q-S vm vi) (list 'IDENTMAT LZ5Q-S 'n)))
          (subst (list '= (lz5q-mm LZ5Q-S xs (list 'IDENTMAT LZ5Q-S 'n)) xs))
          (subst (list '= (list 'MATACT 'md xs 'u) (list 'MATACT 'md um (list 'MATACT 'md cm 'u))))
          (subst (list '= (list 'MATACT 'md cm 'u) 'ys))
          (lz5q-cite! 'matact-type 'md 'n 'n 1 um 'ys)
          (rfl)))
      (dk-have! (list 'SPANS 'md 'n dses 'sm) (lambda () (subst eqd) (ass)))
      (dk-have! (list 'REL-FREE 'md 'n dses) (lambda () (subst eqd) (ass)))
      (dk-rewrite-h! (list 'IN dz '(MAT n n ZZ)) dz ds)
      (dk-rewrite-h! (list 'IS-DIAGONAL 'ZZ-RING 'n 'n dz) dz ds)
      (ew es) (ew ds)
      (dk-conj-close!
        (lambda ()
          (let ((g (dk-goal)))
            (cond ((dk-asm? g) (ass))
                  ((dk-head-is? g 'IS-PRINCIPAL-SEQUENCE)
                   (mac 'IS-PRINCIPAL-SEQUENCE)
                   (dk-conj-close!
                     (lambda ()
                       (let ((g (dk-goal)))
                         (cond ((dk-asm? g) (ass))
                               ((and (dk-head-is? g 'FORALL) (dk-head-is? (caddr g) 'FORALL))
                                (let* ((ld (dk-peel!))
                                       (le (find-first (dk-head? '<=) ld)))
                                  (dk-apply! (lz5q-chain dz 'n 'n) (cadr le) (caddr le))
                                  (subst dseq)
                                  (ass)))
                               ((dk-head-is? g 'FORALL)
                                (let* ((ld (dk-peel!))
                                       (x (cadr (car ld))))
                                  (dk-apply! (lz5q-nonneg dz 'n 'n) x)
                                  (subst dseq)
                                  (ass)))
                               (#t (error "lz5q 3.44: unexpected conjunct" (expression->string g))))))))
                  (#t (error "lz5q 3.44: unexpected goal" (expression->string g))))))))))
(lz5q-done! 'principal-sequence-of-presentation)
(gloss! 'principal-sequence-of-presentation "Linear algebra 3.44 for a submodule F of rank n in a free Z-module E of rank n: the adapted basis e and principal sequence b can be taken with b_1 e_1, ..., b_n e_n relation-free (they are an invertible change of a relation-free spanning sequence of F).")

;;; ---- Z/(d_1) + ... + Z/(d_n) has d_1 ... d_n elements ----
(define LZ5Q-FAM '(VNB-LAMBDA fmi_ (INTERVAL 1 n) (ZZ-MOD (ENTRY dm fmi_ fmi_))))
(define LZ5Q-T (list 'DIRECT-SUM 'ZZ-RING 'n LZ5Q-FAM))
(define LZ5Q-DV (list 'DSUM-VEC 'n LZ5Q-FAM))
(define LZ5Q-GE1 '(FORALL i_ (IMPLIES (IN i_ (INTERVAL 1 n)) (<= 1 (ENTRY dm i_ i_)))))
(define (lz5q-ent! i)                   ; i in [1, n]: dm_ii in ZZ, CARR ZZ-RING, RR, NN, 1 <= dm_ii
  (let ((d (list 'ENTRY 'dm i i)))
    (if (not (dk-asm? (list 'IN d 'ZZ)))
        (begin
          (lz5q-cite! 'entry-in-carrier 'n 'n 'ZZ 'dm i i)
          (dk-have! (list 'IN d '(CARR ZZ-RING)) (lambda () (subst '(== (CARR ZZ-RING) ZZ)) (ass)))
          (lz5q-cite! 'zz-in-rr d)
          (dk-apply! LZ5Q-GE1 i)
          (dk-have! (list '<= 0 d) (lambda () (dk-ineq! (list '<= 1 d))))
          (lz5q-cite! 'zz-nonneg-in-nn d)))
    d))
(define (lz5q-beta!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
(define (lz5q-pt body)                  ; forall i_ in [1, n]. body(i_)
  (list 'FORALL 'i_ (list 'IMPLIES '(IN i_ (INTERVAL 1 n)) (body 'i_))))
(define (lz5q-pt-proof! body-closer)
  (lambda ()
    (let ((i (dk-di-var!)))
      (lz5q-ent! i)
      (lz5q-beta!)
      (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
          (lz5q-by! (lambda () (body-closer i)))))))
(sp (make-wff (forall-guarded '(n dm) (list '(IN n NN) '(IN dm (MAT n n ZZ)) LZ5Q-GE1)
  (list 'AND (list 'IN (list 'VEC LZ5Q-T) 'SET)
    (list 'AND (list 'IN (list 'CARD (list 'VEC LZ5Q-T)) 'NN)
               (list '= (list 'CARD (list 'VEC LZ5Q-T)) (lz5q-prod 'n)))))))
(dk-peel!)
(lz5q-zsetup!)
(fact 'interval-in-set 1 'n)
(lz5q-cite! 'interval-card-in-nn 1 'n)
(dk-have! (lz5q-pt (lambda (i) (list 'IS-MODULE (list LZ5Q-FAM i))))
  (lz5q-pt-proof! (lambda (i) (lz5q-cite! 'zz-mod-is-module (list 'ENTRY 'dm i i)))))
(dk-have! (lz5q-pt (lambda (i) (list '= (list 'SCAL (list LZ5Q-FAM i)) 'ZZ-RING)))
  (lz5q-pt-proof! (lambda (i) (subst (lz5q-cite! 'zz-mod-scal (list 'ENTRY 'dm i i))) (rfl))))
(dk-have! (lz5q-pt (lambda (i) (list 'IN (list 'VEC (list LZ5Q-FAM i)) 'SET)))
  (lz5q-pt-proof! (lambda (i) (lz5q-cite! 'zz-mod-vec-set (list 'ENTRY 'dm i i)))))
(dk-have! (lz5q-pt (lambda (i) (list 'IN (list 'CARD (list 'VEC (list LZ5Q-FAM i))) 'NN)))
  (lz5q-pt-proof! (lambda (i) (let ((d (list 'ENTRY 'dm i i)))
                                (lz5q-cite! 'zz-mod-card d)
                                (subst (list '= (list 'CARD (list 'VEC (list 'ZZ-MOD d))) d)) (ass)))))
(lz5q-cite! 'dsum-ro-vec 'ZZ-RING 'n LZ5Q-FAM)
(lz5q-cite! 'dsum-vec-set2 'ZZ-RING 'n LZ5Q-FAM)
(define LZ5Q-DC (lz5q-split! (lz5q-cite! 'dsum-card 'n LZ5Q-FAM)))
(define LZ5Q-CP (caddr (caddr LZ5Q-DC)))      ; PROD-RING(ZZ-RING, k |-> CARD(VEC(FAM k)), [1, n])
(define LZ5Q-CG (caddr LZ5Q-CP))
(dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ (INTERVAL 1 n)) (list '= (list LZ5Q-CG 'z_) (list (lz5q-diag 'n) 'z_))))
  (lambda ()
    (let ((z (dk-di-var!)))
      (lz5q-ent! z)
      (dk-lam-b!)
      (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
          (lz5q-by! (lambda () (lz5q-cite! 'zz-mod-card (list 'ENTRY 'dm z z))))))))
(lz5q-cite! 'prod-ring-congruence-q 'ZZ-RING '(INTERVAL 1 n) LZ5Q-CG (lz5q-diag 'n))
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-asm? g) (ass))
            ((dk-head-is? g 'IN)
             (subst (list '== (list 'VEC LZ5Q-T) LZ5Q-DV)) (ass))
            (#t
             (subst (list '== (list 'VEC LZ5Q-T) LZ5Q-DV))
             (subst (list '= (list 'CARD LZ5Q-DV) LZ5Q-CP))
             (subst (list '== LZ5Q-CP (lz5q-prod 'n)))
             (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                 (begin
                   (fact 'zz-is-commutative-ring)
                   (dk-have! (list 'FORALL 'z_ (list 'IMPLIES '(IN z_ (INTERVAL 1 n)) (list 'IN (list (lz5q-diag 'n) 'z_) '(CARR ZZ-RING))))
                     (lambda () (let ((z (dk-di-var!))) (lz5q-ent! z) (dk-lam-b!) (lz5q-ass-ctx!))))
                   (lz5q-cite! 'prod-ring-type-ptwise 'ZZ-RING '(INTERVAL 1 n) (lz5q-diag 'n))
                   (rfl))))))))
(lz5q-done! 'cyclic-dsum-card)
(gloss! 'cyclic-dsum-card "If d_1, ..., d_n >= 1 then Z/(d_1) + ... + Z/(d_n) has d_1 d_2 ... d_n elements.")

;;; ---- 3.52 ----
(define (lz5q-open-all! pred . args)    ; unfold a defined predicate in context, split to atoms
  (let* ((iff (apply dk-cite! pred args))
         (rhs (lz5q-iff-l! iff)))
    (let loop ((todo (list (dk-ctx-form rhs))))
      (if (pair? todo)
          (if (dk-head-is? (car todo) 'AND) (loop (append (dk-split! (car todo)) (cdr todo))) (loop (cdr todo)))))))
(define LZ5Q-N '(SUBMODULE-NORM md sm))
(define LZ5Q-Q '(VEC (QUOTIENT-MODULE md sm)))
(define LZ5Q-EX '(FORSOME nmn_ (FORSOME nmx_ (FORSOME nmy_ (FORSOME nma_ (IS-NORM-DATA md sm nmn_ nmx_ nmy_ nma_))))))
(define (lz5q-absurd! notf) (if (not (eq? (dk-goal) 'FALSITY)) (pbc)) (ai notf))
(sp (make-wff (forall-guarded '(md) '((IS-MODULE md) (= (SCAL md) ZZ-RING))
  (forall-guarded '(n u sm)
    (list '(IN n NN) '(IN u (MAT n 1 (VEC md))) '(GENERATES md n u) '(REL-FREE md n u) '(IS-SUBMODULE md sm)
          (list 'NOT (list '= LZ5Q-N 0)))
    (list '= (list 'CARD LZ5Q-Q) LZ5Q-N)))))
(dk-peel!)
(lz5q-zsetup!)
(fact 'module-scalar-ring 'md)
(define (lz5q-main! n1 x1 y1 a1)
  (lz5q-open-all! 'is-norm-data 'md 'sm n1 x1 y1 a1)
  (let* ((ex (lz5q-cite! 'principal-sequence-of-presentation 'md 'sm n1 x1 y1 a1))
         (es (dk-skolem! ex))
         (ex2 (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f es))) (dk-asms)))
         (dm (dk-skolem! ex2)))
    (lz5q-split-on! dm)
    (lz5q-open-all! 'is-principal-sequence 'md n1 'sm es dm)
    (let* ((des (list 'MATACT 'md dm es))
           (det (list 'DET 'ZZ-RING n1 dm))
           (ivl (list 'INTERVAL 1 n1))
           (diag (list 'VNB-LAMBDA 'dgk_ ivl (list 'ENTRY dm 'dgk_ 'dgk_)))
           (prod (list 'PROD-RING 'ZZ-RING diag ivl))
           (fam (list 'VNB-LAMBDA 'fmi_ ivl (list 'ZZ-MOD (list 'ENTRY dm 'fmi_ 'fmi_))))
           (tsum (list 'DIRECT-SUM 'ZZ-RING n1 fam))
           (tsv (list 'VEC tsum)))
      ;; the norm is |det dm|
      (dk-have! (list 'IN dm (list 'MAT n1 n1 (list 'CARR LZ5Q-S)))
        (lambda () (subst (list '= LZ5Q-S 'ZZ-RING)) (subst '(== (CARR ZZ-RING) ZZ)) (ass)))
      (lz5q-cite! 'matact-type 'md n1 n1 1 dm es)
      (dk-have! (list 'IS-NORM-DATA 'md 'sm n1 es des dm)
        (lambda ()
          (mac 'IS-NORM-DATA)
          (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (rfl))))))
      (lz5q-cite! 'submodule-norm-value 'md 'sm n1 es des dm)
      (lz5q-cite! 'diagonal-det-prod n1 dm)
      ;; every dm_ii >= 1: a zero on the diagonal would make the norm 0
      (dk-have! (list 'FORALL 'i_ (list 'IMPLIES (list 'IN 'i_ ivl) (list '<= 1 (list 'ENTRY dm 'i_ 'i_))))
        (lambda ()
          (let* ((i (dk-di-var!))
                 (d (list 'ENTRY dm i i)))
            (lz5q-cite! 'entry-in-carrier n1 n1 'ZZ dm i i)
            (lz5q-cite! 'zz-in-rr d)
            (dk-apply! (find-first (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f '<=) (not (dk-contains? f 'ZZ-DIVIDES))
                                                    (dk-contains? f dm)))
                                   (dk-asms))
                       i)
            (use-em (list '= d 0)
              (lambda ()
                (dk-have! (list 'FORALL 'pzz_ (list 'IMPLIES (list 'IN 'pzz_ ivl) (list 'IN (list diag 'pzz_) '(CARR ZZ-RING))))
                  (lambda () (let ((z (dk-di-var!)))
                               (lz5q-cite! 'entry-in-carrier n1 n1 'ZZ dm z z)
                               (dk-lam-b!)
                               (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                   (begin (subst '(== (CARR ZZ-RING) ZZ)) (ass))))))
                (fact 'zz-ring@zero)
                (dk-have! (list '= (list diag i) '(ZERO ZZ-RING))
                  (lambda () (dk-lam-b!) (if (not (sequent-node-grounded? (proof-state-focus *ps*)))
                                             (begin (subst '(== (ZERO ZZ-RING) 0)) (subst (list '= d 0)) (rfl)))))
                (let ((zf (lz5q-cite! 'prod-ring-zero-factor 'ZZ-RING n1 diag)))
                  (lz5q-detach-all! (dk-apply! zf i)))
                (dk-have! '(IN 0 RR) (lambda () (type-term)))
                (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
                (lz5q-cite! 'rr-abs-of-nonneg 0)
                (dk-have! (list '= LZ5Q-N 0)
                  (lambda ()
                    (subst (list '= LZ5Q-N (list 'abs det)))
                    (subst (list '= det prod))
                    (subst (list '= prod '(ZERO ZZ-RING)))
                    (subst '(== (ZERO ZZ-RING) 0))
                    (ass)))
                (lz5q-absurd! (list 'NOT (list '= LZ5Q-N 0))))
              (lambda ()
                (lz5q-cite! 'zz-nonneg-in-nn d)
                (fact 'nn-zero-in)
                (dk-have! (list 'NOT (list '= 0 d))
                  (lambda () (di)
                             (dk-have! (list '= d 0) (lambda () (subst (list '= d 0)) (rfl)))
                             (ai (list 'NOT (list '= d 0)))))
                (lz5q-cite! 'ladet-nn-lt-of-le-ne 0 d)
                (lz5q-by! (lambda () (lz5q-cite! 'zz-discrete d))))))))
      ;; the quotient is the direct sum of the Z/(dm_ii), with dm_11 ... dm_nn elements
      (lz5q-split! (lz5q-cite! 'cyclic-dsum-card n1 dm))
      (let* ((iso (lz5q-cite! 'quotient-by-diagonal-subgroup 'md n1 es dm 'sm))
             (f (dk-skolem! iso))
             (g (list 'INVERSE-BIJ f LZ5Q-Q tsv)))
        (lz5q-cite! 'iso-module-inverse '(QUOTIENT-MODULE md sm) tsum f)
        (lz5q-open-all! 'is-iso-module tsum '(QUOTIENT-MODULE md sm) g)
        (lz5q-cite! 'card-bijection-eq tsv LZ5Q-Q g)
        (lz5q-cite! 'nn-in-rr (list 'CARD tsv))
        (lz5q-cite! 'nn-zero-le (list 'CARD tsv))
        (dk-have! (list 'IN prod 'RR) (lambda () (subst (list '= prod (list 'CARD tsv))) (ass)))
        (dk-have! (list '<= 0 prod) (lambda () (subst (list '= prod (list 'CARD tsv))) (ass)))
        (lz5q-cite! 'rr-abs-of-nonneg prod)
        (subst (list '= (list 'CARD LZ5Q-Q) (list 'CARD tsv)))
        (subst (list '= (list 'CARD tsv) prod))
        (subst (list '= LZ5Q-N (list 'abs det)))
        (subst (list '= det prod))
        (subst (list '= (list 'abs prod) prod))
        (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (rfl))))))
(use-em LZ5Q-EX
  (lambda ()
    (let* ((ex (dk-ctx-form LZ5Q-EX))
           (ws (let loop ((ex ex) (acc '()))
                 (let* ((v #f)
                        (landed (dk-landed (lambda () (set! v (dk-skolem! ex)))))
                        (nxt (find-first (dk-head? 'FORSOME) landed)))
                   (if nxt (loop nxt (append acc (list v))) (append acc (list v)))))))
      (apply lz5q-main! ws)))
  (lambda ()
    (lz5q-cite! 'submodule-norm-zero 'md 'sm)
    (lz5q-absurd! (list 'NOT (list '= LZ5Q-N 0)))))
(lz5q-done! 'quotient-card-norm)
(gloss! 'quotient-card-norm "Linear algebra 3.52: if E is a finitely generated free abelian group, F a subgroup and N_E(F) /= 0, then card(E/F) = N_E(F).")
