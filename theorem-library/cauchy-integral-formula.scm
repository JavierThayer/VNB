;;; (8) THE WINDING NUMBER OF THE CIRCLE IS 1 AT EVERY POINT OF THE OPEN DISC.
;;; Lemma 3.33 (cauchy-kernel-integral-series) with the weight 1 on the trace:
;;; int 1/(w - z) = sum_k a_k (z - c)^k, a_k = int (1/(w - c))^(k+1); a_k = 0 for
;;; k >= 1 (cif-recip-power-closed-zero), so the sum is a_0 = int 1/(w - c).
(define (cif-circ-pt! y)
  ;; y in the trace of the circle (c, r in context, 0 < r): y in CC, |y - c| = r,
  ;; r <= |y - c|, y /= c, y - c /= 0, y in CC \ {c}
  (let* ((m (list 'magnitude (list '- y 'c))))
    (cif-steps
      (lambda () (fact 'subset-mem-fwd cif-T 'CC y))
      (lambda () (dk-cite! 'circle-trace-magnitude 'c 'r y))
      (lambda () (cif-rr! m))
      (lambda () (dk-have! (list '<= 'r m) (lambda () (dk-ineq! (list '= m 'r)))))
      (lambda ()
        (dk-have! (list 'NOT (list '= y 'c))
          (lambda ()
            (di)
            (dk-have! (list '= m 0)
              (lambda () (subst (list '= y 'c))
                         (dk-have! '(= (- c c) 0) (lambda () (crs)))
                         (subst '(= (- c c) 0))
                         (fact 'cc-magnitude-zero)
                         (ass)))
            (dk-absurd! (list 'IN m 'RR) '(IN r RR) (list '= m 0) (list '= m 'r) '(< 0 r)))))
      (lambda () (cif-sub-nz! y 'c))
      (lambda () (cif-pz-in! 'c y)))))
(define (cif-circ-not-z! y)
  ;; y in the trace, |z - c| < r: y /= z, y in CC \ {z}
  (cif-steps
    (lambda ()
      (dk-have! (list 'NOT (list '= y 'z))
        (lambda ()
          (di)
          (dk-have! '(= (magnitude (- z c)) r)
            (lambda () (subst (list '= 'z y)) (ass)))
          (cif-rr! '(magnitude (- z c)))
          (dk-absurd! '(IN (magnitude (- z c)) RR) '(IN r RR) '(= (magnitude (- z c)) r) '(< (magnitude (- z c)) r)))))
    (lambda () (cif-sub-nz! y 'z))
    (lambda () (cif-pz-in! 'z y))))
