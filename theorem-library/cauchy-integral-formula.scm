(dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ cif-T) (list '== (list cif-fr-f1 'aix_) (list '* (list cif-rf 'aix_) (list cif-fr-kt 'aix_)))))
