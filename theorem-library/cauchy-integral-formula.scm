(dk-cite! 'aif-cont-product cif-T cif-rf cif-fr-kt cif-fr-f1)
(dk-have! (list 'FORALL 'wnx_ (list 'IMPLIES (list 'IN 'wnx_ cif-T) (list '== (list (cif-f1r 'z) 'wnx_) (list cif-fr-f1 'wnx_))))
