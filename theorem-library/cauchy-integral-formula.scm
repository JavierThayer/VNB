;;; (11) THEOREM 3.35: f holomorphic on u, B(c, s) inside u, 0 < r < s: f is the sum of
;;; its power series on B(c, r), with the coefficients of Remark 3.34
(define (cif-h3 z)
  (list 'VNB-LAMBDA 'aitk_ 'NN
    (list '* (list '* cif-kap (cif-LI (list 'VNB-LAMBDA 'aiw_ cif-T
                                            (list '* (list cif-rf 'aiw_) (list 'power '(recip (- aiw_ c)) '(succ aitk_))))))
             (list 'power (list '- z 'c) 'aitk_))))
(define cif-formula-r
  (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (list 'IMPLIES '(< (magnitude (- z c)) r)
    (list '= '(f z) (list '* cif-kap (cif-LI (cif-f1r 'z))))))))
(sp (make-wff (cif-under-disc
  (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (list 'IMPLIES '(< (magnitude (- z c)) r)
    (list 'CC-SERIES-CONVERGES-TO (cif-h3 'z) '(f z))))))))
(dk-peel!)
(cif-disc-setting!)
(cif-tpi!)
(dk-have! cif-formula-r
  (lambda ()
    (let* ((lk (dk-peel!)))
      (let* ((z1 (cadr (car (filter (dk-head? 'IN) lk)))))
        (dk-cite! 'cauchy-integral-formula-disc-restrict 'u 'f 'c 'cifs_ 'r z1)
        (ass)))))
(dk-cite! 'analytic-from-integral-formula cif-T 'c 'r cif-rf cif-C cif-Cd 0 cif-tp cif-kap 'f 'z)
(ass)
(qed 'holomorphic-power-series-disc)

;;; (12) holomorphic => analytic: IS-ANALYTIC-AT at every point of the open set
(sp (make-wff '(FORALL u (FORALL f (IMPLIES (HOLOMORPHIC-ON u f)
  (FORALL c (IMPLIES (IN c u) (IS-ANALYTIC-AT f u c))))))))
(dk-peel!)
(dk-cite! 'holomorphic-on-open-cc-ms 'u 'f)
(dk-cite! 'holomorphic-on-in-fun 'u 'f)
(dk-cite! 'holomorphic-on-open 'u 'f)
(dk-cite! 'cc-open-subset-cc 'u)
(fact 'subset-mem-fwd 'u 'CC 'c)
(define cif-ha-ex
  (dk-project! '(FORALL y (IMPLIES (IN y u) (FORSOME r (AND (POS-RR r) (SUBSET (BALL CC-MS y r) u)))))
               'is-open '(IS-OPEN CC-MS u)))
(define cif-ha-s (dk-skolem! (dk-apply! cif-ha-ex 'c)))
(dk-cite! 'rr-pos-rr-in-rr cif-ha-s)
(dk-cite! 'rr-lt-of-pos-rr cif-ha-s)
(define cif-ha-r (list '* 1/2 cif-ha-s))
(cif-rr! cif-ha-r)
(dk-have! (list '< 0 cif-ha-r) (lambda () (dk-ineq! (list '< 0 cif-ha-s))))
(dk-have! (list '< cif-ha-r cif-ha-s) (lambda () (dk-ineq! (list '< 0 cif-ha-s))))
(define cif-ha-rv (dk-name! cif-ha-r))
(dk-have! (list '< 0 cif-ha-rv) (lambda () (dk-ineq! (list '< 0 cif-ha-r) (list '= cif-ha-rv cif-ha-r))))
(dk-have! (list '< cif-ha-rv cif-ha-s) (lambda () (dk-ineq! (list '< cif-ha-r cif-ha-s) (list '= cif-ha-rv cif-ha-r))))
(dk-have! (list 'SUBSET (list 'BALL 'CC-MS 'c cif-ha-rv) 'u)
  (lambda ()
    (let* ((x (subset-by-element!)))
      (cif-ball-open! 'c cif-ha-rv x)
      (dk-have! (list '< (list 'magnitude (list '- x 'c)) cif-ha-s)
        (lambda () (dk-ineq! (list '< (list 'magnitude (list '- x 'c)) cif-ha-rv) (list '< cif-ha-rv cif-ha-s))))
      (cif-in-ball! x 'c cif-ha-s)
      (fact 'subset-mem-fwd (list 'BALL 'CC-MS 'c cif-ha-s) 'u x)
      (ass))))
(cif-tpi!)
(let* ((s cif-ha-s) (r cif-ha-rv)
       (T (list 'TRACE (list 'CIRCLE-PATH 'c r) 0 cif-tp))
       (rf (list 'RESTRICT 'f T))
       (form (list 'FORALL 'z (list 'IMPLIES '(IN z CC) (list 'IMPLIES (list '< '(magnitude (- z c)) r)
               (list '= '(f z) (list '* cif-kap
                 (list 'LINE-INT (list 'VNB-LAMBDA 'aiw_ T (list '* (list rf 'aiw_) '(recip (- aiw_ z))))
                       (list 'CIRCLE-PATH 'c r) (list 'CIRCLE-DERIV 'c r) 0 cif-tp))))))))
  (dk-have! form
    (lambda ()
      (let* ((lk (dk-peel!)))
        (let* ((z1 (cadr (car (filter (dk-head? 'IN) lk)))))
          (dk-cite! 'cauchy-integral-formula-disc-restrict 'u 'f 'c s r z1)
          (ass)))))
  ;; the hypotheses of analytic-at-from-integral-formula about T and the weight
  (dk-cite! 'circle-is-road 'c r)
  (fact 'is-road-is-path (list 'CIRCLE-PATH 'c r) (list 'CIRCLE-DERIV 'c r) 0 cif-tp)
  (fact 'is-path-in-fun (list 'CIRCLE-PATH 'c r) 0 cif-tp)
  (dk-cite! 'trace-subset-cc (list 'CIRCLE-PATH 'c r) 0 cif-tp)
  (fact 'subset-refl T)
  (dk-have! (list 'FORALL 'aix_ (list 'IMPLIES (list 'IN 'aix_ T) (list '<= r '(magnitude (- aix_ c)))))
    (lambda ()
      (let* ((y (dk-di-var!)) (m (list 'magnitude (list '- y 'c))))
        (fact 'subset-mem-fwd T 'CC y)
        (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
        (dk-cite! 'circle-trace-magnitude 'c r y)
        (cif-rr! m)
        (dk-ineq! (list '= m r)))))
  (fact 'nf-cc-is-metric-space)
  (fact 'nf-metric-carrier 'CC-NORMED-FIELD)
  (fact 'cc-nf-carr)
  (dk-have! (list '== (list 'PTS cif-nfm) 'CC)
    (lambda () (subst (list '== (list 'PTS cif-nfm) '(CARR CC-NORMED-FIELD))) (ass)))
  (dk-have! (list 'SUBSET 'u (list 'PTS cif-nfm))
    (lambda () (subst (list '== (list 'PTS cif-nfm) 'CC)) (ass)))
  (dk-cite! 'holomorphic-on-continuous 'u 'f)
  (dk-have! (list 'SUBSET T 'u)
    (lambda ()
      (let* ((y (subset-by-element!)))
        (fact 'subset-mem-fwd T 'CC y)
        (dk-have! (list '<= 0 r) (lambda () (dk-ineq! (list '< 0 r))))
        (dk-cite! 'circle-trace-magnitude 'c r y)
        (cif-rr! (list 'magnitude (list '- y 'c)))
        (dk-have! (list '< (list 'magnitude (list '- y 'c)) s)
          (lambda () (dk-ineq! (list '= (list 'magnitude (list '- y 'c)) r) (list '< r s))))
        (cif-in-ball! y 'c s)
        (fact 'subset-mem-fwd (list 'BALL 'CC-MS 'c s) 'u y)
        (ass))))
  (dk-cite! 'restrict-in-fun 'f 'u 'CC T)
  (dk-have! (cif-cont T rf)
    (lambda ()
      (let* ((y (dk-di-var!)))
        (fact 'subset-mem-fwd T 'u y)
        (dk-apply! (dk-ctx-form (cif-cont 'u 'f)) y)
        (dk-cite! 'subspace-restrict-continuous-at cif-nfm 'u T cif-nfm 'f y)
        (ass))))
  (dk-cite! 'analytic-at-from-integral-formula T 'c r rf (list 'CIRCLE-PATH 'c r) (list 'CIRCLE-DERIV 'c r) 0 cif-tp
            cif-kap 'u 'f)
  (ass))
(qed 'holomorphic-analytic-at)
;;; (13) THE DERIVATIVE OF A HOLOMORPHIC FUNCTION IS HOLOMORPHIC (3.35 with 2.10: on a
;;; disc where f is the sum of its power series, f' is the sum of the derived series)
(define cif-dh-d '(VNB-LAMBDA cifdw_ u (DERIV-ON CC-NORMED-FIELD u f cifdw_)))
;;; v in u: land L with IS-DIFF-ON(u, f, v, L), DERIV-ON(u, f, v) = L, L in CC; return L
(define (cif-dh-dv! v)
  (let* ((l (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff 'u 'f) v)))
         (dd (dk-pick (lambda (fm) (and (dk-head-is? fm 'IS-DIFF-ON) (dk-contains? fm l))) "the derivative")))
    (dk-project! (list 'IN l '(CARR CC-NORMED-FIELD)) 'IS-DIFF-ON dd)
    (dk-have! (list 'IN l 'CC) (lambda () (subst '(= CC (CARR CC-NORMED-FIELD))) (ass)))
    (dk-cite! 'cc-deriv-on-of-is-diff-on 'u 'f v l)
    l))
(sp (make-wff (list 'FORALL 'u (list 'FORALL 'f (list 'IMPLIES '(HOLOMORPHIC-ON u f)
  (list 'HOLOMORPHIC-ON 'u cif-dh-d))))))
(dk-peel!)
(fact 'cc-nf-carr)
(dk-cite! 'holomorphic-on-in-fun 'u 'f)
(dk-cite! 'holomorphic-on-open 'u 'f)
(dk-cite! 'cc-open-subset-cc 'u)
(fact 'cc-is-set)
(fact 'subclass-of-set-is-set 'u 'CC)
(dk-have! (list 'IN cif-dh-d '(FUN u CC))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let* ((v (dk-di-var!)) (leaf (proof-state-focus *ps*)))
          (cif-lam-b-if!)
          (let* ((l (cif-dh-dv! v)))
            (subst (list '= (list 'DERIV-ON 'CC-NORMED-FIELD 'u 'f v) l))
            (if (not (sequent-node-grounded? leaf)) (ass))))))))
(mac 'HOLOMORPHIC-ON)
(dk-conj-close!
  (lambda ()
    (let* ((g (dk-goal)))
      (cond
        ((dk-asm? g) (ass))
        ((not (dk-head-is? g 'FORALL)) (error "cif: unexpected conjunct" (expression->string g)))
        (#t
         (let* ((a (dk-di-var!)))
           (fact 'subset-mem-fwd 'u 'CC a)
           (dk-cite! 'holomorphic-analytic-at 'u 'f a)
           (mac-h 'IS-ANALYTIC-AT (dk-pick (dk-head? 'IS-ANALYTIC-AT) "analytic at a"))
           (dk-split-all!)
           (let* ((cf (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm 'CPS-RADIUS))) "the coefficients")))
                  (r (dk-skolem! (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORSOME) (dk-contains? fm 'CPS-RADIUS))) "the radius"))))
             (dk-split-all!)
             (let* ((bl (list 'BALL 'CC-MS a r))
                    (rep (dk-pick (lambda (fm) (and (dk-head-is? fm 'FORALL) (dk-contains? fm 'CC-SERIES-LIMIT) (dk-contains? fm cf))) "the representation"))
                    (pr (dk-abstract! 'NN 'CC (lambda (k) (list '* (list 'succ k) (list cf (list 'succ k))))
                                      (lambda (k) (fact 'nn-succ-closed k) (fact 'fun-apply-type-c cf 'NN 'CC (list 'succ k))
                                                  (cif-cc! (list '* (list 'succ k) (list cf (list 'succ k)))) (ass))))
                    (dcf (car pr)) (dve (cdr pr))
                    (gc (list 'VNB-LAMBDA 'algz_ bl (list 'CC-SERIES-LIMIT (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list cf 'cpsk_) (list 'power '(- algz_ a) 'cpsk_))))))
                    (gd (list 'VNB-LAMBDA 'algz_ bl (list 'CC-SERIES-LIMIT (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list dcf 'cpsk_) (list 'power '(- algz_ a) 'cpsk_))))))
                    (vald (lambda (w) (list 'CC-SERIES-LIMIT (list 'VNB-LAMBDA 'cpsk_ 'NN (list '* (list dcf 'cpsk_) (list 'power (list '- w a) 'cpsk_)))))))
               (set! gc (cif-subst-sym gc 'a a))
               (set! gd (cif-subst-sym gd 'a a))
               (dk-have! (list 'FORALL 'cpdj_ (list 'IMPLIES '(IN cpdj_ NN) (list '= (list dcf 'cpdj_) (list '* '(succ cpdj_) (list cf '(succ cpdj_))))))
                 (lambda ()
                   (let* ((k (dk-di-var!)))
                     (fact 'nn-succ-closed k)
                     (fact 'fun-apply-type-c cf 'NN 'CC (list 'succ k))
                     (cif-cc! (list '* (list 'succ k) (list cf (list 'succ k))))
                     (subst (dk-apply! dve k))
                     (rfl))))
               (dk-cite! 'cps-radius-derived cf dcf)
               (dk-have! (list '< r (list 'CPS-RADIUS dcf))
                 (lambda () (cif-subst-ass! (list '= (list 'CPS-RADIUS dcf) (list 'CPS-RADIUS cf)))))
               (dk-cite! 'cps-translate-holomorphic dcf a r)
               (let* ((tdiff (dk-cite! 'cps-translate-diff cf dcf a r)))
                 ;; f = Gc on the ball, so f has derivative Vd(w) at w on u
                 (dk-have! (list 'FORALL 'cexx_ (list 'IMPLIES (list 'IN 'cexx_ bl) (list '= '(f cexx_) (list gc 'cexx_))))
                   (lambda ()
                     (let* ((x (dk-di-var!)))
                       (fact 'subset-mem-fwd bl 'u x)
                       (fact 'fun-apply-type-c 'f 'u 'CC x)
                       (dk-apply! rep x)
                       (dk-lam-b!)
                       (ass))))
                 (dk-have! (list 'FORALL 'cexx_ (list 'IMPLIES (list 'IN 'cexx_ bl) (list '= (list cif-dh-d 'cexx_) (list gd 'cexx_))))
                   (lambda ()
                     (let* ((x (dk-di-var!)) (dx (dk-apply! tdiff x)))
                       (fact 'subset-mem-fwd bl 'u x)
                       (dk-project! (list 'IN (vald x) '(CARR CC-NORMED-FIELD)) 'IS-DIFF-ON dx)
                       (dk-have! (list 'IN (vald x) 'CC) (lambda () (subst '(= CC (CARR CC-NORMED-FIELD))) (ass)))
                       (dk-cite! 'cc-diff-on-local 'u 'f bl gc x (vald x))
                       (dk-cite! 'cc-deriv-on-of-is-diff-on 'u 'f x (vald x))
                       (cif-lam-b-if!)
                       (ass))))
                 ;; Gd is holomorphic on the ball, so D is differentiable at a on u
                 (cif-center-in-ball! a r)
                 (let* ((l (dk-skolem! (dk-apply! (dk-cite! 'holomorphic-on-diff bl gd) a))))
                   (dk-cite! 'cc-diff-on-local 'u cif-dh-d bl gd a l)
                   (ew l)
                   (ass)))))))))))
(qed 'holomorphic-deriv-holomorphic)
