;;; cauchy-integral-formula.scm -- CAUCHY WITH AN EXCEPTIONAL POINT ON A DISC, THE WINDING
;;; NUMBER OF A CIRCLE INSIDE IT, THE CAUCHY INTEGRAL FORMULA ON A DISC, THEOREM 3.35
;;; (HOLOMORPHIC => ANALYTIC) AND THE HOLOMORPHY OF THE DERIVATIVE.
;;; (complex-analysis.pdf ch. 3: Cor 3.9 with one exceptional point, Example 3.13 /
;;; Cor 3.30 for the circle, 3.7 (first form of the integral formula), Theorem 3.35.)
;;; Agent CA-3 of week 2 of the October roadmap (scratchpad/triage/WEEK2.md), 2026-10-04.
;;;
;;; CONTENTS (in proof order).
;;;  (1) cif-open-minus-point            an open set minus a point is open
;;;  (2) cauchy-convex-sub-except        f continuous on an open u, holomorphic on u \ {x}: the
;;;                                      integral over a closed road in a convex open v inside u
;;;                                      is 0 (x in v or not)
;;;  (3) cauchy-disc-except              the same for an open disc B(c, r) inside u
;;;  (4) cif-recip-shift-diff            (1/(w - c))' = -(1/(w - c))^2 on CC \ {c}
;;;  (5) cif-recip-power-diff            ((1/(w - c))^(j+1))' = -(j+1) (1/(w - c))^(j+2)   (induction)
;;;  (6) cif-recip-power-closed-zero     int over a closed road off c of (1/(w - c))^(j+2) = 0
;;;  (7) circle-trace-magnitude          |w - c| = r on the trace of CIRCLE-PATH(c, r)
;;;      circle-path-closed              CIRCLE-PATH(c, r)(2 pi) = CIRCLE-PATH(c, r)(0)
;;;  (8) winding-circle-inside           WINDING(circle(c, r), z) = 1 for every |z - c| < r
;;;  (9) cauchy-integral-formula-disc    f(z) = 1/(2 pi i) int_C(c,r) f(w)/(w - z) dw
;;; (10) cauchy-integral-formula-disc-restrict   the same, the weight spelled RESTRICT(f, trace)
;;;                                      as analytic-from-integral.scm spells it
;;; (11) holomorphic-power-series-disc   THEOREM 3.35: f is the sum of its power series on B(c, r)
;;; (12) holomorphic-analytic-at         HOLOMORPHIC-ON(u, f), c in u  =>  IS-ANALYTIC-AT(f, u, c)
;;; (13) holomorphic-deriv-holomorphic   HOLOMORPHIC-ON(u, f) => HOLOMORPHIC-ON(u, w |-> DERIV-ON(u, f, w))
;;;
;;; THE ROUTES.
;;; * (8), WITHOUT A LOGARITHM.  Lemma 3.33 (cauchy-kernel-integral-series, CA-2) with the
;;;   weight 1 on the trace T of the circle (every point of T is at distance exactly r from
;;;   c): int 1/(w - z) = sum_k a_k (z - c)^k with a_k = int (1/(w - c))^(k+1).  For k >= 1
;;;   the integrand has the primitive -(1/k) (1/(w - c))^k on CC \ {c} ((4)-(6), by the
;;;   product rule and induction), so a_k = 0 on the closed circle; the series is then
;;;   a_k 0^k termwise and cps-sum-at-zero sums it to a_0 = int 1/(w - c), whose winding
;;;   number is 1 (winding-circle-center).  The log route the brief proposed is not needed.
;;; * (9): the Caratheodory factor p of f at z (the witness of IS-DIFF-ON(u, f, z, f'(z)))
;;;   is continuous at z, equals (f(w) - f(z))/(w - z) off z (holomorphic there: hence
;;;   continuous on all of u), so (3) gives int p = 0 over the circle; on the trace
;;;   p = (f(w) - f(z))/(w - z), linearity splits the integral, and (8) gives
;;;   int 1/(w - z) = 2 pi i.
;;; * (11), (12): analytic-from-integral-formula / analytic-at-from-integral-formula (CA-2) fed
;;;   with (10).  (12) takes the disc B(c, s/2) inside the ball B(c, s) that the openness of u
;;;   gives at c.
;;; * (13): at a point a of u, (12) gives f = G_cf on a ball B(a, r) (G_cf the sum of a
;;;   power series centred at a); cps-translate-diff gives G_cf' = G_dcf (dcf the derived
;;;   coefficients, cps-radius-derived: same radius), cc-diff-on-local carries it to u, so
;;;   DERIV-ON(u, f, w) = G_dcf(w) on the ball; G_dcf is holomorphic (cps-translate-holomorphic),
;;;   so the derivative function is differentiable at a (cc-diff-on-local again).
;;;
;;; STATEMENT CHECKS.  The disc hypotheses are B(c, s) SUBSET u with 0 < r < s (an OPEN disc
;;; strictly larger than the circle), not "the closed disc D(c, r) inside u": the two are
;;; equivalent by the compactness of the closed disc (a Lebesgue-number argument), which the
;;; tree does not have as a lemma; (12) shows that nothing is lost for analyticity.  z is
;;; typed (IN z CC) and |z - c| < r, the spelling of analytic-from-integral.scm.  The circle
;;; is CA-1's CIRCLE-PATH / CIRCLE-DERIV on [0, 2 pi]; 1/(2 pi i) is recip((2 pi) i), the
;;; spelling of WINDING.  The integrand of (9) is a VNB-LAMBDA over the trace T (f is
;;; defined there since T lies in u); (10)-(11) use RESTRICT(f, T), the weight phi of
;;; CA-2's statements, so that they compose by one citation.  "The derivative" of (13) is
;;; the function w |-> DERIV-ON(CC-NORMED-FIELD, u, f, w) on u (structure-library/diff-on.scm).
;;;
;;; NOTHING asserted, no definition.  Helper prefix cif-; theorem binders cif*_ and the
;;; binders of the cited theorems where an instance must match (u, f, c, r, z, pgam, dgam,
;;; a, b, aiw_, aitk_, wnw_).
;;; LOAD WINDOW: lo = theorem-library/analytic-from-integral (cauchy-kernel-integral-series,
;;; analytic-from-integral-formula, analytic-at-from-integral-formula, aif-cont-*; load.scm
;;; line 3539), above winding-number-laws (3538: cauchy-disc, line-int-domain-congruence,
;;; holomorphic-on-restrict, winding-integrand-holomorphic, winding-circle-center,
;;; circle-is-road, cc-punctured-membership/-open), analytic-log-laws (3535:
;;; cps-translate-diff, cps-translate-holomorphic), goursat-exceptional (3519:
;;; cauchy-convex-closed-except), goursat (3518), goursat-bricks (3493:
;;; line-int-closed-road-of-derivative), cps-taylor-coefficients (3475: cps-sum-at-zero),
;;; cc-power-series-deriv (3472: cps-radius-derived, cc-diff-on-quadratic).  hi: none.
;;; Tactics: the early kit only (dk-*, use-em, use-cases, use-induction, prop, crs, ineq).
;;; piece 1: open minus a point, Cauchy with an exceptional point on a convex set / disc
(define cif-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (cif-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (cif-cont u f)
  (list 'FORALL 'rgy_ (list 'IMPLIES (list 'IN 'rgy_ u)
    (list 'IS-CONTINUOUS-AT (list 'SUBSPACE-MS cif-nfm u) cif-nfm f 'rgy_))))
(define (cif-imps hyps body)
  (if (null? hyps) body (list 'IMPLIES (car hyps) (cif-imps (cdr hyps) body))))
(define (cif-all vars body)
  (if (null? vars) body (list 'FORALL (car vars) (cif-all (cdr vars) body))))
(define (cif-and! a b)
  (let* ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! dk-ass!))))
    f))
(define (cif-pz z) (list 'DIFFERENCE 'CC (list 'SINGLETON z)))

(define (cif-rr! t)
  (let* ((typ (list 'IN t 'RR)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'rr-zero-in) typ)
          ((eqv? t 1) (fact 'rr-one-in) typ)
          ((eq? t 'PI) (dk-split-all! (list (dk-cite! 'pi-pos))) typ)
          ((number? t) (dk-have! typ (lambda () (arith))) typ)
          ((dk-asm? (list 'IN t 'NN)) (fact 'nn-in-rr t) typ)
          ((cif-op? t 'succ 2) (cif-nn! t) (fact 'nn-in-rr t) typ)
          ((cif-op? t '* 3) (cif-rr! (cadr t)) (cif-rr! (caddr t)) (fact 'rr-mul-in-rr (cadr t) (caddr t)) typ)
          ((cif-op? t '+ 3) (cif-rr! (cadr t)) (cif-rr! (caddr t)) (fact 'rr-add-in-rr (cadr t) (caddr t)) typ)
          ((cif-op? t '- 3) (cif-rr! (cadr t)) (cif-rr! (caddr t)) (fact 'rr-sub-in-rr (cadr t) (caddr t)) typ)
          ((cif-op? t '- 2) (cif-rr! (cadr t)) (fact 'rr-neg-closed (cadr t)) typ)
          ((cif-op? t 'magnitude 2) (cif-cc! (cadr t)) (fact 'cc-magnitude-closed (cadr t)) typ)
          ((cif-op? t 'real-part 2) (cif-cc! (cadr t)) (fact 'real-part-in-rr (cadr t)) typ)
          ((cif-op? t 'imag-part 2) (cif-cc! (cadr t)) (fact 'imag-part-in-rr (cadr t)) typ)
          ((cif-op? t 'abs 2) (cif-rr! (cadr t)) (fact 'rr-abs-closed (cadr t)) typ)
          ((cif-op? t 'recip 2)
           (cif-rr! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (if (dk-asm? (list '< 0 (cadr t)))
                   (fact 'rr-pos-ne-zero (cadr t))
                   (error "cif-rr!: land the non-vanishing first" (expression->string (cadr t)))))
           (cif-and! (list 'IN (cadr t) 'RR) (list 'NOT (list '= (cadr t) 0)))
           (fact 'rr-recip-closed (cadr t))
           typ)
          (#t (dk-real! t) typ))))
(define (cif-nn! t)
  (let* ((typ (list 'IN t 'NN)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'nn-zero-in) typ)
          ((cif-op? t 'succ 2) (cif-nn! (cadr t)) (fact 'nn-succ-closed (cadr t)) typ)
          (#t (dk-type! t 'NN)))))
(define (cif-cc! t)
  (let* ((typ (list 'IN t 'CC)))
    (cond ((dk-asm? typ) typ)
          ((eqv? t 0) (fact 'cc-zero-in) typ)
          ((eqv? t +i) (fact 'cc-i-in) typ)
          ((or (and (number? t) (real? t)) (eq? t 'PI) (dk-asm? (list 'IN t 'RR)) (dk-asm? (list 'IN t 'NN))
               (cif-op? t 'succ 2)
               (cif-op? t 'magnitude 2) (cif-op? t 'real-part 2) (cif-op? t 'imag-part 2))
           (cif-rr! t) (fact 'rr-subset-cc t) typ)
          ((cif-op? t '- 3) (cif-cc! (cadr t)) (cif-cc! (caddr t)) (fact 'cc-sub-in-cc (cadr t) (caddr t)) typ)
          ((cif-op? t '- 2) (cif-cc! (cadr t)) (fact 'cc-neg-closed (cadr t)) typ)
          ((cif-op? t '+ 3) (cif-cc! (cadr t)) (cif-cc! (caddr t))
           (cif-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-add-closed (cadr t) (caddr t)) typ)
          ((cif-op? t '* 3) (cif-cc! (cadr t)) (cif-cc! (caddr t))
           (cif-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'CC)) (fact 'cc-mul-closed (cadr t) (caddr t)) typ)
          ((cif-op? t 'power 3) (cif-cc! (cadr t)) (cif-nn! (caddr t))
           (cif-and! (list 'IN (cadr t) 'CC) (list 'IN (caddr t) 'NN)) (fact 'power-typing-nonneg (cadr t) (caddr t)) typ)
          ((cif-op? t 'CC-EXP 2) (cif-cc! (cadr t))
           (dk-split-all! (list (dk-cite! 'cc-exp-converges (cadr t)))) typ)
          ((cif-op? t 'recip 2) (cif-cc! (cadr t))
           (if (not (dk-asm? (list 'NOT (list '= (cadr t) 0))))
               (error "cif-cc!: land the non-vanishing first" (expression->string (cadr t))))
           (cif-and! (list 'IN (cadr t) 'CC) (list 'NOT (list '= (cadr t) 0)))
           (fact 'cc-recip-closed (cadr t)) typ)
          (#t (dk-type! t 'CC)))))

;;; y in CC \ {z}: land y in CC, y /= z, y - z /= 0
(define (cif-sub-nz! y z)
  (let* ((nz (list 'NOT (list '= (list '- y z) 0))))
    (dk-have! nz
      (lambda ()
        (di)
        (dk-cite! 'cc-sub-zero-eq y z)
        (ai (dk-ctx-form (list 'NOT (list '= y z))))))
    nz))
(define (cif-steps . thunks)
  ;; run THUNKS in order while the leaf focused at the start stays open
  (let* ((leaf (proof-state-focus *ps*)))
    (let loop ((ts thunks))
      (if (and (pair? ts) (not (sequent-node-grounded? leaf)))
          (begin ((car ts)) (loop (cdr ts)))))))
(define (cif-pz-open! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (cif-steps
      (lambda () (dk-have! (list 'IN y 'CC) (lambda () (cif-only-prop! iff (list 'IN y (cif-pz z))))))
      (lambda () (dk-have! (list 'NOT (list '= y z)) (lambda () (cif-only-prop! iff (list 'IN y (cif-pz z))))))
      (lambda () (cif-sub-nz! y z)))))
(define (cif-pz-in! z y)
  (let* ((iff (dk-cite! 'cc-punctured-membership z y)))
    (dk-have! (list 'IN y (cif-pz z))
      (lambda () (cif-only-prop! iff (list 'IN y 'CC) (list 'NOT (list '= y z)))))))
;;; the punctured plane: open (both spellings), a set
(define (cif-pz-setup! z)
  (let* ((d (cif-pz z)))
    (fact 'nf-cc-is-metric-space)
    (dk-cite! 'cc-punctured-open z)
    (let* ((iff (dk-cite! 'cc-ms-open-iff d)))
      (dk-have! (list 'IS-OPEN cif-nfm d) (lambda () (cif-only-prop! iff (list 'IS-OPEN 'CC-MS d)))))
    (fact 'cc-is-set)
    (dk-cite! 'difference-set 'CC (list 'SINGLETON z))
    (dk-cite! 'cc-open-subset-cc d)))
;;; (cif-lam-typ! LAM DOM TYPER) -- LAM in FUN(DOM, CC); TYPER of the eigenvariable
(define (cif-lam-typ! lam dom pre)
  (dk-have! (list 'IN lam (list 'FUN dom 'CC))
    (lambda ()
      (dk-lam-type! (lambda ()
                      (let* ((v (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                        (cif-steps
                          (lambda () (pre v))
                          (lambda () (if (dk--redex? (dk-goal)) (dk-lam-b!)))
                          (lambda () (if (not (dk-asm? (dk-goal))) (cif-cc! (cadr (dk-goal)))))
                          (lambda () (ass)))))))))
;;; detach an implication whose antecedent THUNK proves
(define (cif-detach! imp thunk)
  (if (and (pair? imp) (eq? (car imp) 'IMPLIES))
      (begin (dk-have! (cadr imp) thunk)
             (dk-landed-1 (lambda () (detach! imp))))
      imp))
(define (cif-only-prop! . fs) (if (apply dk-only! fs) (prop)))
(define (cif-lam-b-if!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
;;; subst, then ass on the SAME leaf unless the subst closed it
(define (cif-subst-ass! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (ass))))
;;; 2 pi i: in CC and non-zero, its reciprocal in CC
(define cif-tpi '(* (* 2 PI) +i))
(define (cif-tpi!)
  (cif-rr! '(* 2 PI))
  (dk-have! '(< 0 (* 2 PI)) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'rr-pos-ne-zero '(* 2 PI))
  (cif-cc! '(* 2 PI))
  (fact 'cc-i-in)
  (dk-have! '(NOT (= +i 0))
    (lambda ()
      (di)
      (fact 'cc-i-squared)
      (dk-have! '(= (* 0 0) -1) (lambda () (subst '(= 0 +i)) (ass)))
      (dk-have! '(NOT (= (* 0 0) -1)) (lambda () (arith)))
      (ai '(NOT (= (* 0 0) -1)))))
  (dk-cite! 'cc-mul-nonzero '(* 2 PI) +i)
  (cif-cc! cif-tpi)
  (cif-cc! (list 'recip cif-tpi))
  (cif-and! (list 'IN cif-tpi 'CC) (list 'NOT (list '= cif-tpi 0)))
  (dk-cite! 'cc-recip-inverse cif-tpi))
;;; x in CC, c in CC, s in RR, |x - c| < s in context: land x in BALL(CC-MS, c, s)
(define (cif-in-ball! x c s)
  (let* ((m (list 'magnitude (list '- x c))))
    (fact 'cc-is-metric-space)
    (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
    (dk-have! (list 'IN x '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (dk-have! (list 'IN c '(PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
    (cif-rr! m)
    (dk-cite! 'cc-ms-dist c x)
    (dk-cite! 'cc-magnitude-sub-sym c x)
    (dk-have! (list '<= (list '(DIST CC-MS) c x) m)
      (lambda ()
        (subst (list '= (list '(DIST CC-MS) c x) (list 'magnitude (list '- c x))))
        (if (not (equal? c x)) (subst (list '= (list 'magnitude (list '- c x)) m)))
        (dk-ineq!)))
    (let* ((cj (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list 'IN m 'RR) (list 'AND (list 'IN s 'RR)
                (list 'AND (list '<= (list '(DIST CC-MS) c x) m) (list '< m s)))))))
      (dk-have! cj (lambda () (dk-conj-close! dk-ass!)))
      (dk-cite! 'ball-mem-from-le 'CC-MS c x m s))))
;;; subst EQ in a == goal, then qrfl on the same leaf unless the subst closed it
(define (cif-subst-qrfl! eq)
  (let* ((leaf (proof-state-focus *ps*)))
    (subst eq)
    (if (not (sequent-node-grounded? leaf)) (qrfl))))
;;; x in BALL(CC-MS, c, r) in context: land x in CC and |x - c| < r; return the latter
(define (cif-ball-open! c r x)
  ;; x in BALL(CC-MS, c, r) in context: land x in CC and |x - c| < r (stops early when a
  ;; landing closes the focus leaf, the claim being the goal)
  (let* ((dcx (list '(DIST CC-MS) c x))
         (mag (list 'magnitude (list '- c x)))
         (mag2 (list 'magnitude (list '- x c)))
         (cj  (list 'AND (list 'IN x '(PTS CC-MS)) (list 'AND (list '<= dcx r) (list 'NOT (list '= dcx r))))))
    (cif-steps
      (lambda () (fact 'cc-is-metric-space))
      (lambda () (let* ((iff (dk-cite! 'ball-membership 'CC-MS c r x)))
                   (dk-have! cj (lambda () (cif-only-prop! iff (list 'IN x (list 'BALL 'CC-MS c r)))))))
      (lambda () (dk-split-all! (list (dk-ctx-form cj))))
      (lambda () (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl))))
      (lambda () (dk-have! (list 'IN x 'CC) (lambda () (subst '(= CC (PTS CC-MS))) (ass))))
      (lambda () (dk-cite! 'cc-ms-dist c x))
      (lambda () (cif-rr! mag))
      (lambda () (cif-rr! mag2))
      (lambda () (dk-cite! 'cc-magnitude-sub-sym c x))
      (lambda () (dk-have! (list 'AND (list '<= mag r) (list 'NOT (list '= mag r)))
                   (lambda () (subst (list '= mag dcx)) (dk-conj-close! dk-ass!))))
      (lambda () (dk-cite! 'rr-le-ne-lt mag r))
      (lambda () (dk-have! (list '< mag2 r) (lambda () (dk-ineq! (list '< mag r) (list '= mag mag2))))))))

(define (cif-subst-sym e from to)
  (cond ((eq? e from) to)
        ((pair? e) (cons (cif-subst-sym (car e) from to) (cif-subst-sym (cdr e) from to)))
        (#t e)))
;;; a point x of the trace, the trace already known inside CC \ {c} (and CC \ {z} ...):
;;; land x in CC, x /= c, x - c /= 0 (the same for each z in ZS)
(define (cif-tpt! x . zs)
  (cif-steps
    (lambda () (fact 'subset-mem-fwd cif-T (cif-pz 'c) x))
    (lambda () (cif-pz-open! 'c x))
    (lambda () (for-each (lambda (z) (fact 'subset-mem-fwd cif-T (cif-pz z) x) (cif-pz-open! z x)) zs))))
(define (cif-dump-open!)
  (for-each (lambda (l) (display "\n;; OPEN: ") (display (expression->string (dk-goal-of l)))) (dk-open-leaves)))
(define (cif-center-in-ball! a r)
  ;; a in CC, r in RR, 0 < r: land a in BALL(CC-MS, a, r) (which also certifies the ball DEFINED)
  (let* ((d (list '- a a)) (m (list 'magnitude d)))
    (cif-rr! m)
    (cif-cc! d)
    (dk-have! (list '= d 0) (lambda () (crs)))
    (let ((iff (dk-cite! 'cc-magnitude-zero-iff d)))
      (dk-have! (list '= m 0) (lambda () (cif-only-prop! iff (list '= d 0)))))
    (dk-have! (list '< m r) (lambda () (dk-ineq! (list '= m 0) (list '< 0 r))))
    (cif-in-ball! a a r)))
;;; (1) an open set minus a point is open
(sp (make-wff (list 'FORALL 'cifv_ (list 'IMPLIES (list 'IS-OPEN cif-nfm 'cifv_)
  (list 'FORALL 'cifx_ (list 'IMPLIES '(IN cifx_ CC)
    (list 'IS-OPEN cif-nfm '(DIFFERENCE cifv_ (SINGLETON cifx_)))))))))
(dk-peel!)
(let* ((v 'cifv_) (x 'cifx_) (d (list 'DIFFERENCE v (list 'SINGLETON x)))
       (p (cif-pz x)) (i (list 'INTERSECTION v p)))
  (fact 'nf-cc-is-metric-space)
  (dk-cite! 'cc-open-subset-cc v)
  (dk-cite! 'cc-punctured-open x)
  (let* ((iff (dk-cite! 'cc-ms-open-iff p)))
    (dk-have! (list 'IS-OPEN cif-nfm p) (lambda () (cif-only-prop! iff (list 'IS-OPEN 'CC-MS p)))))
  (dk-have! (list 'FORALL 'cify_ (list 'IFF (list 'IN 'cify_ d) (list 'IN 'cify_ i)))
    (lambda ()
      (let* ((y (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (let* ((f1 (dk-cite! 'difference-membership v (list 'SINGLETON x) y))
              (f2 (dk-cite! 'intersection-membership v p y))
              (f3 (dk-cite! 'difference-membership 'CC (list 'SINGLETON x) y))
              (f4 (dk-cite! 'subset-mem-fwd v 'CC y)))
          (cif-only-prop! f1 f2 f3 f4)))))
  (dk-cite! 'class-extensionality d i)
  (subst (list '= d i))
  (cif-and! (list 'IS-OPEN cif-nfm v) (list 'IS-OPEN cif-nfm p))
  (dk-cite! 'inter-of-opens-open cif-nfm v p)
  (ass))
(qed 'cif-open-minus-point)

;;; (2) Cauchy for a closed road in a convex open subset of an open set where f is
;;; continuous, and holomorphic except at one point
(define cif-ux '(DIFFERENCE u (SINGLETON cifx_)))
(define cif-E
  (list (list 'IS-OPEN cif-nfm 'u) '(IN f (FUN u CC)) (cif-cont 'u 'f) '(IN cifx_ u)
        (list 'HOLOMORPHIC-ON cif-ux (list 'RESTRICT 'f cif-ux))))
(define cif-road-h '((IS-ROAD pgam dgam a b)))
(sp (make-wff (cif-all '(u f cifx_) (cif-imps cif-E
  (list 'FORALL 'cifv_ (cif-imps (list (list 'IS-OPEN cif-nfm 'cifv_) '(IS-CONVEX cifv_) '(SUBSET cifv_ u))
    (cif-all '(pgam dgam a b)
      (cif-imps (list '(IS-ROAD pgam dgam a b) '(SUBSET (TRACE pgam a b) cifv_) '(= (pgam b) (pgam a)))
        '(= (LINE-INT f pgam dgam a b) 0)))))))))
(dk-peel!)
(let* ((v 'cifv_) (x 'cifx_) (g (list 'RESTRICT 'f v)) (tr '(TRACE pgam a b))
       (hux (list 'RESTRICT 'f cif-ux)))
  (fact 'nf-cc-is-metric-space)
  (fact 'nf-metric-carrier 'CC-NORMED-FIELD)
  (fact 'cc-nf-carr)
  (dk-have! (list '== (list 'PTS cif-nfm) 'CC)
    (lambda () (subst (list '== (list 'PTS cif-nfm) '(CARR CC-NORMED-FIELD))) (ass)))
  (dk-cite! 'cc-open-subset-cc 'u)
  (dk-cite! 'cc-open-subset-cc v)
  (dk-have! (list 'SUBSET 'u (list 'PTS cif-nfm))
    (lambda () (subst (list '== (list 'PTS cif-nfm) 'CC)) (ass)))
  (dk-cite! 'holomorphic-on-open cif-ux hux)
  (dk-cite! 'holomorphic-on-in-fun cif-ux hux)
  (dk-cite! 'subset-trans tr v 'u)
  (dk-cite! 'restrict-in-fun 'f 'u 'CC v)
  (dk-have! (cif-cont v g)
    (lambda ()
      (let* ((y (dk-di-var!)))
        (fact 'subset-mem-fwd v 'u y)
        (dk-apply! (dk-ctx-form (cif-cont 'u 'f)) y)
        (dk-cite! 'subspace-restrict-continuous-at cif-nfm 'u v cif-nfm 'f y)
        (ass))))
  (dk-have! (list 'FORALL 'wnx_ (list 'IMPLIES (list 'IN 'wnx_ tr) (list '== (list g 'wnx_) '(f wnx_))))
    (lambda ()
      (let* ((z (dk-di-var!)))
        (fact 'subset-mem-fwd tr v z)
        (dk-cite! 'restrict-apply 'f v z)
        (ass))))
  (dk-cite! 'line-int-domain-congruence 'u 'f 'pgam 'dgam 'a 'b v g)
  (subst (list '= '(LINE-INT f pgam dgam a b) (list 'LINE-INT g 'pgam 'dgam 'a 'b)))
  (fact 'subset-mem-fwd 'u 'CC x)
  (use-em (list 'IN x v)
    (lambda ()
      (let* ((w (list 'DIFFERENCE v (list 'SINGLETON x)))
             (gw (list 'RESTRICT g w)) (hw (list 'RESTRICT hux w)))
        (dk-cite! 'cif-open-minus-point v x)
        (dk-have! (list 'SUBSET w v)
          (lambda () (let* ((z (subset-by-element!)))
                       (let* ((f1 (dk-cite! 'difference-membership v (list 'SINGLETON x) z)))
                         (cif-only-prop! f1 (list 'IN z w))))))
        (dk-have! (list 'SUBSET w cif-ux)
          (lambda () (let* ((z (subset-by-element!)))
                       (let* ((f1 (dk-cite! 'difference-membership v (list 'SINGLETON x) z))
                             (f2 (dk-cite! 'difference-membership 'u (list 'SINGLETON x) z))
                             (f3 (dk-cite! 'subset-mem-fwd v 'u z)))
                         (cif-only-prop! f1 f2 f3 (list 'IN z w))))))
        (dk-cite! 'holomorphic-on-restrict cif-ux hux w)
        (dk-cite! 'restrict-in-fun g v 'CC w)
        (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ w) (list '== (list gw 'hbx_) (list hw 'hbx_))))
          (lambda ()
            (let* ((z (dk-di-var!)))
              (fact 'subset-mem-fwd w v z)
              (fact 'subset-mem-fwd w cif-ux z)
              (dk-cite! 'restrict-apply g w z) (dk-cite! 'restrict-apply 'f v z)
              (dk-cite! 'restrict-apply hux w z) (dk-cite! 'restrict-apply 'f cif-ux z)
              (subst (list '== (list gw z) (list g z)))
              (subst (list '== (list g z) (list 'f z)))
              (subst (list '== (list hw z) (list hux z)))
              (subst (list '== (list hux z) (list 'f z)))
              (qrfl))))
        (dk-cite! 'holomorphic-transfer-ptwise-eq w gw hw)
        (dk-cite! 'cauchy-convex-closed-except v g x 'pgam 'dgam 'a 'b)
        (ass)))
    (lambda ()
      (let* ((hv (list 'RESTRICT hux v)))
        (dk-have! (list 'SUBSET v cif-ux)
          (lambda ()
            (let* ((z (subset-by-element!)))
              (fact 'subset-mem-fwd v 'u z)
              (dk-have! (list 'NOT (list 'IN z (list 'SINGLETON x)))
                (lambda ()
                  (di)
                  (let* ((sm (dk-cite! 'singleton-membership x z)))
                    (dk-have! (list '= z x) (lambda () (cif-only-prop! sm (list 'IN z (list 'SINGLETON x)))))
                    (dk-have! (list 'IN x v) (lambda () (subst (list '= x z)) (ass)))
                    (ai (dk-ctx-form (list 'NOT (list 'IN x v)))))))
              (let* ((f1 (dk-cite! 'difference-membership 'u (list 'SINGLETON x) z)))
                (cif-only-prop! f1 (list 'IN z 'u) (list 'NOT (list 'IN z (list 'SINGLETON x))))))))
        (dk-cite! 'holomorphic-on-restrict cif-ux hux v)
        (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ v) (list '== (list g 'hbx_) (list hv 'hbx_))))
          (lambda ()
            (let* ((z (dk-di-var!)))
              (fact 'subset-mem-fwd v cif-ux z)
              (dk-cite! 'restrict-apply 'f v z)
              (dk-cite! 'restrict-apply hux v z) (dk-cite! 'restrict-apply 'f cif-ux z)
              (subst (list '== (list g z) (list 'f z)))
              (subst (list '== (list hv z) (list hux z)))
              (subst (list '== (list hux z) (list 'f z)))
              (qrfl))))
        (dk-cite! 'holomorphic-transfer-ptwise-eq v g hv)
        (dk-cite! 'cauchy-convex-closed v g 'pgam 'dgam 'a 'b)
        (ass)))))
(qed 'cauchy-convex-sub-except)

;;; (3) the same for an open disc B(c, r) inside u
(sp (make-wff (cif-all '(u f cifx_) (cif-imps cif-E
  '(FORALL c (IMPLIES (IN c CC) (FORALL r (IMPLIES (IN r RR) (IMPLIES (< 0 r)
    (IMPLIES (SUBSET (BALL CC-MS c r) u)
      (FORALL pgam (FORALL dgam (FORALL a (FORALL b
        (IMPLIES (IS-ROAD pgam dgam a b) (IMPLIES (SUBSET (TRACE pgam a b) (BALL CC-MS c r))
          (IMPLIES (= (pgam b) (pgam a)) (= (LINE-INT f pgam dgam a b) 0))))))))))))))))))
(dk-peel!)
(let* ((bl '(BALL CC-MS c r)))
  (fact 'cc-is-metric-space)
  (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))
  (dk-have! '(IN c (PTS CC-MS)) (lambda () (subst '(= (PTS CC-MS) CC)) (ass)))
  (dk-have! '(<= 0 r) (lambda () (dk-ineq! '(< 0 r))))
  (dk-have! '(NOT (= 0 r)) (lambda () (fact 'rr-zero-in) (dk-split-all! (list (dk-cite! 'pw-lt-ne 0 'r))) (ass)))
  (cif-and! '(IN r RR) (cif-and! '(<= 0 r) '(NOT (= 0 r))))
  (dk-cite! 'ball-is-open 'CC-MS 'c 'r)
  (let* ((iff (dk-cite! 'cc-ms-open-iff bl)))
    (dk-have! (list 'IS-OPEN cif-nfm bl) (lambda () (cif-only-prop! iff (list 'IS-OPEN 'CC-MS bl)))))
  (dk-cite! 'cc-ball-is-convex 'c 'r)
  (dk-cite! 'cauchy-convex-sub-except 'u 'f 'cifx_ bl 'pgam 'dgam 'a 'b)
  (ass))
(qed 'cauchy-disc-except)
;;; (4) the derivative of w |-> 1/(w - c) on CC \ {c}
(define (cif-R c) (list 'VNB-LAMBDA 'cifv_ (cif-pz c) (list 'recip (list '- 'cifv_ c))))
(define (cif-S c) (list 'VNB-LAMBDA 'cifv_ (cif-pz c) (list '- 'cifv_ c)))
(define (cif-P c n) (list 'VNB-LAMBDA 'cifv_ (cif-pz c) (list 'power (list 'recip (list '- 'cifv_ c)) n)))
(define (cif-sq-recip w c) (list '* (list 'recip (list '- w c)) (list 'recip (list '- w c))))
(sp (make-wff (list 'FORALL 'cifc_ (list 'IMPLIES '(IN cifc_ CC)
  (list 'FORALL 'cifw_ (list 'IMPLIES (list 'IN 'cifw_ (cif-pz 'cifc_))
    (list 'IS-DIFF-ON 'CC-NORMED-FIELD (cif-pz 'cifc_) (cif-R 'cifc_) 'cifw_
          (list '- (cif-sq-recip 'cifw_ 'cifc_)))))))))
(dk-peel!)
(let* ((c 'cifc_) (w 'cifw_) (d (cif-pz c)) (S (cif-S c)) (R (cif-R c)))
  (cif-pz-setup! c)
  (cif-pz-open! c w)
  (cif-lam-typ! S d (lambda (v) (cif-pz-open! c v)))
  (cif-lam-typ! R d (lambda (v) (cif-pz-open! c v)))
  (fact 'rr-zero-in) (fact 'cc-one-in)
  (dk-have! '(<= 0 0) (lambda () (dk-ineq!)))
  (let* ((imp (dk-cite! 'cc-diff-on-quadratic d S w 1 0)))
    (cif-detach! imp
      (lambda ()
        (let* ((x (dk-di-var!)))
          (cif-pz-open! c x)
          (dk-lam-b!)
          (let* ((g (dk-goal)) (e (cadr (cadr g))) (mm (caddr (caddr g))))
            (dk-have! (list '= e 0) (lambda () (crs)))
            (subst (list '= e 0))
            (fact 'cc-magnitude-zero)
            (subst '(= (magnitude 0) 0))
            (cif-rr! mm)
            (dk-have! (list '= (list '* 0 mm) 0) (lambda () (crs)))
            (subst (list '= (list '* 0 mm) 0))
            (dk-ineq!))))))
  (dk-have! (list 'FORALL 'cry_ (list 'IMPLIES (list 'IN 'cry_ d) (list 'NOT (list '= (list S 'cry_) 0))))
    (lambda () (let* ((y (dk-di-var!))) (cif-pz-open! c y) (dk-lam-b!) (ass))))
  (dk-have! (list 'FORALL 'cry_ (list 'IMPLIES (list 'IN 'cry_ d) (list '== (list R 'cry_) (list 'recip (list S 'cry_)))))
    (lambda () (let* ((y (dk-di-var!))) (cif-pz-open! c y) (dk-lam-b!) (qrfl))))
  (let* ((r1 (dk-cite! 'diff-on-recip-cc d S w 1 R))
         (v1 (list-ref r1 5))
         (gv (list-ref (dk-goal) 5))
         (a (list 'recip (list '- w c))))
    (cif-cc! a)
    (dk-have! (list '= gv v1)
      (lambda ()
        (dk-lam-b!)
        (subst (dk-cite! 'cc-recip-mul (list '- w c) (list '- w c)))
        (crs)))
    (subst (list '= gv v1))
    (ass)))
(qed 'cif-recip-shift-diff)

;;; (5) the derivative of w |-> (1/(w - c))^(j+1): -(j+1) (1/(w - c))^(j+2)
(define (cif-pd-goal j)
  (list 'FORALL 'cifc_ (list 'IMPLIES '(IN cifc_ CC)
    (list 'FORALL 'cifw_ (list 'IMPLIES (list 'IN 'cifw_ (cif-pz 'cifc_))
      (list 'IS-DIFF-ON 'CC-NORMED-FIELD (cif-pz 'cifc_) (cif-P 'cifc_ (list 'succ j)) 'cifw_
            (list '* (list '- (list 'succ j)) (list 'power (list 'recip (list '- 'cifw_ 'cifc_)) (list 'succ (list 'succ j))))))))))
;;; a typed in CC, n in NN: land a^succ(n) = a * a^n
(define (cif-pow-succ! a n)
  (cif-cc! a) (cif-nn! n)
  (cif-and! (list 'IN a 'CC) (list 'IN n 'NN))
  (dk-cite! 'power-succ a n))
(define (cif-carr-typ! lam d)
  (fact 'cc-nf-carr)
  (dk-have! (list 'IN lam (list 'FUN d '(CARR CC-NORMED-FIELD)))
    (lambda () (subst '(== (CARR CC-NORMED-FIELD) CC)) (ass))))
(sp (make-wff (list 'FORALL 'cifj_ (list 'IMPLIES '(IN cifj_ NN) (cif-pd-goal 'cifj_)))))
(define cif-pd-br (use-induction))
(dk-focus! (cdr (assq 'base cif-pd-br)))
(dk-peel!)
(let* ((c 'cifc_) (w 'cifw_) (d (cif-pz c)) (R (cif-R c)) (P (cif-P c '(succ 0)))
       (a (list 'recip (list '- w c))))
  (cif-pz-setup! c)
  (cif-pz-open! c w)
  (fact 'nn-zero-in)
  (fact 'nn-succ-closed 0)
  (cif-lam-typ! P d (lambda (v) (cif-pz-open! c v)))
  (cif-carr-typ! P d)
  (dk-cite! 'cif-recip-shift-diff c w)
  (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ d) (list '== (list P 'hbx_) (list R 'hbx_))))
    (lambda ()
      (let* ((x (dk-di-var!)) (ax (list 'recip (list '- x c))))
        (cif-pz-open! c x)
        (dk-lam-b!)
        (subst (cif-pow-succ! ax 0))
        (subst (dk-cite! 'power-zero ax))
        (dk-have! (list '= (list '* ax 1) ax) (lambda () (crs)))
        (subst (list '= (list '* ax 1) ax))
        (qrfl))))
  (dk-cite! 'diff-on-transfer-ptwise-eq 'CC-NORMED-FIELD d P R w (list '- (cif-sq-recip w c)))
  (let* ((gv (list-ref (dk-goal) 5)))
    (cif-cc! a)
    (dk-have! (list '= gv (list '- (cif-sq-recip w c)))
      (lambda ()
        (subst (cif-pow-succ! a '(succ 0)))
        (subst (cif-pow-succ! a 0))
        (subst (dk-cite! 'power-zero a))
        (crs)))
    (subst (list '= gv (list '- (cif-sq-recip w c))))
    (ass)))
(dk-focus! (cdr (assq 'step cif-pd-br)))
(define cif-pd-n (cdr (assq 'var cif-pd-br)))
(define cif-pd-ih (cdr (assq 'ih cif-pd-br)))
(dk-peel!)
(let* ((n cif-pd-n) (sn (list 'succ n)) (ssn (list 'succ sn))
       (c (cadr (dk-pick (lambda (f) (and (cif-op? f 'IN 3) (eq? (caddr f) 'CC))) "c")))
       (wt (dk-pick (lambda (f) (and (cif-op? f 'IN 3) (pair? (caddr f)) (eq? (car (caddr f)) 'DIFFERENCE))) "w"))
       (w (cadr wt))
       (d (cif-pz c)) (R (cif-R c)) (Pn (cif-P c sn)) (P (cif-P c ssn))
       (a (list 'recip (list '- w c))))
  (cif-pz-setup! c)
  (cif-pz-open! c w)
  (fact 'nn-succ-closed n)
  (fact 'nn-succ-closed sn)
  (cif-lam-typ! P d (lambda (v) (cif-pz-open! c v)))
  (cif-lam-typ! Pn d (lambda (v) (cif-pz-open! c v)))
  (cif-lam-typ! R d (lambda (v) (cif-pz-open! c v)))
  (cif-carr-typ! P d)
  (fact 'cc-is-normed-field)
  (let* ((dr (dk-cite! 'cif-recip-shift-diff c w))
         (dp (dk-apply! cif-pd-ih c w))
         (l (list-ref dr 5)) (m (list-ref dp 5))
         (pr (dk-cite! 'diff-on-product 'CC-NORMED-FIELD d R Pn w l m))
         (plam (list-ref pr 3)) (pval (list-ref pr 5)))
    (dk-have! (list 'FORALL 'hbx_ (list 'IMPLIES (list 'IN 'hbx_ d) (list '== (list P 'hbx_) (list plam 'hbx_))))
      (lambda ()
        (let* ((x (dk-di-var!)) (ax (list 'recip (list '- x c))) (q (list 'power ax sn)))
          (cif-pz-open! c x)
          (dk-lam-b!)
          (cif-cc! q)
          (subst (dk-cite! 'cc-nf-mul-apply ax q))
          (subst (cif-pow-succ! ax sn))
          (qrfl))))
    (dk-cite! 'diff-on-transfer-ptwise-eq 'CC-NORMED-FIELD d P plam w pval)
    (let* ((gv (list-ref (dk-goal) 5))
           (q (list 'power a sn)))
      (cif-cc! a) (cif-cc! q) (cif-cc! l) (cif-cc! m)
      (dk-have! (list '= gv pval)
        (lambda ()
          (dk-lam-b!)
          (cif-cc! (list '* l q)) (cif-cc! (list '* m a))
          (subst (dk-cite! 'cc-nf-mul-apply l q))
          (subst (dk-cite! 'cc-nf-mul-apply m a))
          (subst (dk-cite! 'cc-nf-add-apply (list '* l q) (list '* m a)))
          (subst (cif-pow-succ! a ssn))
          (subst (cif-pow-succ! a sn))
          (subst (dk-cite! 'nn-succ-plus-one sn))
          (let* ((qv (dk-name! q 'CC)))
            (subst (list '= q qv))
            (cif-cc! sn)
            (let* ((sv (dk-name! sn 'CC)))
              (subst (list '= sn sv))
              (crs)))))
      (subst (list '= gv pval))
      (ass))))
(qed 'cif-recip-power-diff)
;;; (6) the integral of (1/(w - c))^(j+2) over a closed road off c is 0: the
;;; primitive is -(1/(j+1)) (1/(w - c))^(j+1)
(sp (make-wff (list 'FORALL 'cifj_ (list 'IMPLIES '(IN cifj_ NN)
  (list 'FORALL 'cifc_ (list 'IMPLIES '(IN cifc_ CC)
    (cif-all '(pgam dgam a b)
      (cif-imps (list '(IS-ROAD pgam dgam a b) (list 'SUBSET '(TRACE pgam a b) (cif-pz 'cifc_)) '(= (pgam b) (pgam a)))
        (list '= (list 'LINE-INT (cif-P 'cifc_ '(succ (succ cifj_))) 'pgam 'dgam 'a 'b) 0)))))))))
(dk-peel!)
(let* ((j 'cifj_) (c 'cifc_) (d (cif-pz c)) (sj (list 'succ j)) (ssj (list 'succ sj))
       (Pj (cif-P c sj)) (df (cif-P c ssj))
       (k (list '- (list 'recip sj)))
       (F (list 'VNB-LAMBDA 'cexy_ d (list '* k (list Pj 'cexy_)))))
  (cif-pz-setup! c)
  (fact 'nn-succ-closed j)
  (fact 'nn-succ-closed sj)
  (cif-cc! sj)
  (dk-cite! 'nn-succ-nonzero j)
  (cif-cc! k)
  (cif-lam-typ! Pj d (lambda (v) (cif-pz-open! c v)))
  (cif-lam-typ! df d (lambda (v) (cif-pz-open! c v)))
  (cif-lam-typ! F d (lambda (v) (cif-pz-open! c v) (cif-cc! (list 'power (list 'recip (list '- v c)) sj))))
  (cif-and! (list 'IN sj 'CC) (list 'NOT (list '= sj 0)))
  (dk-cite! 'cc-recip-inverse sj)
  (dk-have! (list 'FORALL 'hbz_ (list 'IMPLIES (list 'IN 'hbz_ d) (list 'IS-DIFF-ON 'CC-NORMED-FIELD d F 'hbz_ (list df 'hbz_))))
    (lambda ()
      (let* ((z (dk-di-var!))
             (az (list 'recip (list '- z c)))
             (p2 (list 'power az ssj))
             (dp (dk-cite! 'cif-recip-power-diff j c z))
             (m (list-ref dp 5))
             (sc (dk-cite! 'cc-diff-on-scale d Pj z m k)))
        (cif-pz-open! c z)
        (cif-cc! p2)
        (dk-have! (list '= (list df z) (list '* k m))
          (lambda ()
            (dk-lam-b!)
            (let* ((rv (dk-name! (list 'recip sj) 'CC))
                  (pv (dk-name! p2 'CC)))
              (subst (list '= p2 pv))
              (subst (list '= (list 'recip sj) rv))
              (dk-have! (list '= (list '* (list '- rv) (list '* (list '- sj) pv)) (list '* (list '* sj rv) pv)) (lambda () (crs)))
              (subst (list '= (list '* (list '- rv) (list '* (list '- sj) pv)) (list '* (list '* sj rv) pv)))
              (dk-have! (list '= (list '* sj rv) 1) (lambda () (subst (list '= rv (list 'recip sj))) (ass)))
              (subst (list '= (list '* sj rv) 1))
              (crs))))
        (subst (list '= (list df z) (list '* k m)))
        (ass))))
  (dk-have! (list 'HOLOMORPHIC-ON d F)
    (lambda ()
      (mac 'HOLOMORPHIC-ON)
      (dk-conj-close!
        (lambda ()
          (let* ((g (dk-goal)))
            (cond ((dk-asm? g) (ass))
                  ((cif-op? g 'FORALL 3)
                   (let* ((z (dk-di-var!)))
                     (ew (list df z))
                     (dk-apply! (dk-ctx-form (list 'FORALL 'hbz_ (list 'IMPLIES (list 'IN 'hbz_ d)
                                   (list 'IS-DIFF-ON 'CC-NORMED-FIELD d F 'hbz_ (list df 'hbz_))))) z)
                     (ass)))
                  (#t (error "cif: unexpected holomorphy conjunct" (expression->string g)))))))))
  (dk-cite! 'line-int-closed-road-of-derivative d F df 'pgam 'dgam 'a 'b)
  (ass))
(qed 'cif-recip-power-closed-zero)
;;; (7) the circle: its trace lies at distance r from the centre; it is closed
(define cif-tp '(* 2 PI))
(define cif-I (list 'CCINT 0 cif-tp))
(define cif-C '(CIRCLE-PATH c r))
(define cif-Cd '(CIRCLE-DERIV c r))
(define cif-T (list 'TRACE cif-C 0 cif-tp))
(define (cif-kern z) (list 'VNB-LAMBDA 'wnw_ (cif-pz z) (list 'recip (list '- 'wnw_ z))))
(define (cif-in-I! v)
  (dk-have! (list 'IN v cif-I)
    (lambda () (mac 'ccint-membership)
               (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (ass) (dk-ineq! (list '< 0 cif-tp) '(< 0 PI))))))))
(define (cif-circle-basics!)
  (fact 'rr-zero-in)
  (cif-rr! cif-tp)
  (dk-have! (list '< 0 cif-tp) (lambda () (dk-ineq! '(< 0 PI))))
  (dk-cite! 'circle-is-road 'c 'r)
  (fact 'is-road-is-path cif-C cif-Cd 0 cif-tp)
  (fact 'is-path-in-fun cif-C 0 cif-tp)
  (dk-cite! 'trace-subset-cc cif-C 0 cif-tp))

(sp (make-wff (list 'FORALL 'c (list 'IMPLIES '(IN c CC) (list 'FORALL 'r (list 'IMPLIES '(IN r RR) (list 'IMPLIES '(<= 0 r)
  (list 'FORALL 'cify_ (list 'IMPLIES (list 'IN 'cify_ cif-T) '(= (magnitude (- cify_ c)) r))))))))))
(dk-peel!)
(let* ((y 'cify_) (img (list 'IN y (list 'IMAGE cif-C cif-I))))
  (cif-circle-basics!)
  (fact 'trace-unfold cif-C 0 cif-tp)
  (dk-have! img (lambda () (subst (list '== (list 'IMAGE cif-C cif-I) cif-T)) (ass)))
  (let* ((ex (car (dk-landed (lambda () (mac-h 'image-membership-iff (dk-ctx-form img))))))
         (ex2 (if (dk-head-is? ex 'AND) (begin (dk-split! ex) (dk-pick (dk-head? 'FORSOME) "image witness")) ex))
