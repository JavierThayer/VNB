                                (dk-le-chain! (cd8-n `((ADD K) ,wmv ,nwmu)) `(max ,(cd8-n wmv) ,(cd8-n nwmu)) ev))))))
                      (dk-cite! 'rr-nonneg-below-all-zero (cd8-n d))
                      (dk-cite! 'nf-norm-zero-implies 'K d)
                      (dk-cite! 'nf-sub-zero-eq 'K u v)
                      (dk-ass!))))
                (dk-cite! 'matrix-entry-extensionality 'n 'n '(CARR K) (cd8-mm bv 'tm) (cd8-mm 'tm bv))
                (dk-ass!)))
            ;; CLAIM 2: det B = 0
            (let* ((db `(DET ,cd8-v n ,bv)))
              (dk-cite! 'det-in-carrier cd8-v 'n bv)
              (cd8-in-k! db)
              (cd8-real! (cd8-n db))
              (dk-have! `(FORALL cd8e_ (IMPLIES (POS-RR cd8e_) (<= ,(cd8-n db) cd8e_)))
                (lambda ()
                  (let* ((l2 (dk-peel!)) (ev (caddr (dk-goal))))
                    (dk-cite! 'rr-pos-rr-in-rr ev)
                    (dk-cite! 'rr-lt-of-pos-rr ev)
                    (dk-have! `(<= 0 ,ev) (lambda () (dk-ineq! `(< 0 ,ev) `(IN ,ev RR))))
                    (dk-cite! 'rr-one-in)
                    (let* ((ax (dk-cite! 'rr-archimedean-multiple ev 1))
                           (nv (dk-skolem! ax #t))
                           (ig (dk-split-all!))
                           (nr (near! ev))
                           (cv (car nr))
                           (k0 `(+ ,cv ,nv)))
                      (dk-have! `(AND (IN ,cv NN) (IN ,nv NN)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                      (dk-cite! 'nn-add-closed cv nv)
                      (dk-have! `(<= ,cv ,k0) (lambda () (dk-nn!)))
                      (dk-apply! (cdr nr) k0)
                      (dk-cite! 'strictly-mono-ge-id phv k0)
                      (let* ((cls (at-phi! k0))
                             (bkk (bk k0))
                             (pk `(,phv ,k0))
                             (s `(+ ,pk 1))
                             (dk `(DET ,cd8-v n ,bkk))
                             (ndk (cd8-n dk)))
                        (dk-cite! 'ccr-det-close 'K 'n bkk bv ev)
                        (cd8-to-v! bkk 'n 'n)
                        (dk-cite! 'det-in-carrier cd8-v 'n bkk)
                        (cd8-in-k! dk)
                        (cd8-real! ndk)
                        (dk-cite! 'nn-one-in)
                        (dk-have! `(AND (IN ,pk NN) (IN 1 NN)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
                        (dk-cite! 'nn-add-closed pk 1)
                        (dk-cite! 'nn-in-rr s) (dk-cite! 'nn-in-rr nv) (dk-cite! 'nn-in-rr pk)
                        (dk-have! `(<= ,nv ,s) (lambda () (dk-nn! `(<= ,k0 ,pk) `(IN ,cv NN) `(IN ,nv NN) `(IN ,pk NN))))
                        (dk-have! `(< 0 ,s) (lambda () (dk-nn! `(IN ,pk NN))))
                        (dk-cite! 'rr-mul-le-right nv s ev)
                        (dk-have! `(= (* ,s ,ev) (* ,ev ,s)) (lambda () (crs)))
                        (dk-have! `(<= (* ,ndk ,s) (* ,ev ,s))
                          (lambda () (dk-le-chain! `(* ,ndk ,s) 1 `(* ,nv ,ev) `(* ,s ,ev) `(* ,ev ,s))))
                        (dk-cite! 'rr-mul-le-cancel-pos ndk s ev)
                        ;; det B = det Bk + -(det Bk - det B)
                        (let* ((dmb (cd8-sub dk db)) (ndmb `((NEG K) ,dmb)))
                          (dk-cite! 'nf-neg-in-carr 'K db) (dk-cite! 'nf-add-in-carr 'K dk `((NEG K) ,db))
                          (dk-cite! 'nf-neg-in-carr 'K dmb)
                          (cd8-crs! `(= ,db ((ADD K) ,dk ,ndmb)) (list dk db))
                          (dk-cite! 'nv-ultra 'K dk ndmb)
                          (dk-cite! 'nf-norm-neg 'K dmb)
                          (cd8-real! (cd8-n dmb))
                          (dk-cite! 'rr-max-le ndk (cd8-n dmb) ev)
                          (dk-cite! 'rr-max-closed ndk (cd8-n dmb))
                          (cd8-real! (cd8-n ndmb))
                          (dk-cite! 'rr-max-closed ndk (cd8-n ndmb))
                          (dk-have! `(<= (max ,ndk ,(cd8-n ndmb)) ,ev)
                            (lambda () (subst `(= ,(cd8-n ndmb) ,(cd8-n dmb))) (dk-ass!)))
                          (dk-cite! 'nf-add-in-carr 'K dk ndmb)
                          (cd8-real! (cd8-n `((ADD K) ,dk ,ndmb)))
                          (dk-have! `(<= ,(cd8-n `((ADD K) ,dk ,ndmb)) ,ev)
                            (lambda () (dk-le-chain! (cd8-n `((ADD K) ,dk ,ndmb)) `(max ,ndk ,(cd8-n ndmb)) ev)))
                          (subst `(= ,db ((ADD K) ,dk ,ndmb)))
                          (dk-ass!)))))))
              (dk-cite! 'rr-nonneg-below-all-zero (cd8-n db))
              (dk-cite! 'nf-norm-zero-implies 'K db))
            ;; so B = 0
            (dk-cite! 'ccr-3-4-commutant 'K 'n 'tm bv)
            ;; but the g(phi k) keep an entry of norm 1
            (dk-have! '(POS-RR 1/2) (lambda () (mac 'pos-rr) (dk-conj-close! (lambda () (arith)))))
            (let* ((nr (near! '1/2))
                   (cv (car nr))
                   (ig (dk-have! `(<= ,cv ,cv) (lambda () (dk-nn!))))
                   (clk (dk-apply! (cdr nr) cv))
                   (cls (at-phi! cv))
                   (bkk (bk cv))
                   (ig1 (dk-skolem! (list-ref cls 3) #t))
                   (ig2 (dk-split-all!))
                   (ig3 (let loop ()
                          (let ((fx (find-first (lambda (f) (and (dk-head-is? f 'FORSOME) (dk-contains? f bkk) (dk-contains? f 'ENTRY))) (dk-asms))))
                            (if fx (begin (dk-skolem! fx #t) (dk-split-all!) (loop))))))
                   (eqn (dk-pick (lambda (f) (and (dk-head-is? f '=) (equal? (caddr f) 1) (pair? (cadr f))
                                                  (pair? (cadr (cadr f))) (eq? (car (cadr (cadr f))) 'ENTRY)
                                                  (equal? (cadr (cadr (cadr f))) bkk))) "the unit entry"))
                   (ix (caddr (cadr (cadr eqn))))
                   (jx (cadddr (cadr (cadr eqn))))
                   (wc (cd8-close-parts! bkk bv 'n 'n '1/2))
                   (h0 (dk-apply! wc ix jx))
                   (x `(ENTRY ,bkk ,ix ,jx))
                   (h1 (dk-rewrite-h! h0 bv zb)))
              (dk-cite! 'entry-of-zeromat cd8-v 'n 'n ix jx)
              (let* ((h2 (dk-rewrite-h! h1 `(ENTRY ,zb ,ix ,jx) `(ZERO ,cd8-v)))
                     (h3 (dk-rewrite-h! h2 `(ZERO ,cd8-v) '(ZERO K))))
                (cd8-to-v! bkk 'n 'n)
                (dk-cite! 'entry-in-carrier 'n 'n '(CARR K) bkk ix jx)
                (dk-cite! 'nf-zero-in-carr 'K)
                (cd8-crs! `(= ,(cd8-sub x '(ZERO K)) ,x) (list x))
                (let ((h4 (dk-rewrite-h! h3 (cd8-sub x '(ZERO K)) x)))
                  (cd8-real! (cd8-n x))
                  (dk-absurd! h4 `(= ,(cd8-n x) 1) `(IN ,(cd8-n x) RR)))))))))))
(cd8-qed! 'ccr-3-4-comm)

;;; ccr-3-4 -- Lemma 3.4 in the notes' form: X = T in ccr-3-4-comm.
(sp (make-wff `(FORALL K (IMPLIES (IS-LOCAL-NV-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL tm
