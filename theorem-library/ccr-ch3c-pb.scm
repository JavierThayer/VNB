       (mx (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f j0))) "the max"))
       (c `(ENTRY A ,i0 ,j0)))
  (dk-cite! 'entry-in-carrier 'n 'n '(CARR K) 'A i0 j0)
  (cd8-real! (cd8-n c))
  (ew (cd8-n c))
  (dk-conj-close!
    (lambda ()
      (if (dk-asm? (dk-goal)) (dk-ass!)
          (begin
            (mac 'is-mat-bound)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (dk-ass!)
                    (let* ((landed (dk-peel!)) (en (cadr (cadr (dk-goal)))))
                      (dk-apply! mx (caddr en) (cadddr en))
                      (dk-ass!))))))))))
(cd8-qed! 'cd8-mat-has-bound)

;;; 6. The ultrametric bound on a difference of finite sums: |sum fa - sum fb| <= r when every
;;;    |fa(z) - fb(z)| <= r.  (The finite-sum half of the det-continuity step, as a lemma.)

(define (cd8-pt fa fb r)
  `(FORALL cd8z_ (IMPLIES (IN cd8z_ sq) (AND (IN (,fa cd8z_) (CARR K)) (AND (IN (,fb cd8z_) (CARR K))
     (<= ,(cd8-n (cd8-sub `(,fa cd8z_) `(,fb cd8z_))) ,r))))))
(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL sq (IMPLIES (IN sq SET) (IMPLIES (IN (CARD sq) NN)
  (FORALL fa (FORALL fb (FORALL r (IMPLIES (IN r RR) (IMPLIES (<= 0 r) (IMPLIES ,(cd8-pt 'fa 'fb 'r)
    (<= ,(cd8-n (cd8-sub `(FINSUM ,cd8-ag fa sq) `(FINSUM ,cd8-ag fb sq))) r))))))))))))))
(dk-peel!)
(dk-cite! 'nv-field-normed 'K)
(cd8-view!)
(dk-cite! 'ring-additive-ag-is-abelian-group cd8-v)
(dk-cite! 'raag-carr cd8-v)
(dk-cite! 'raag-opr cd8-v)
(let* ((pt (dk-ctx-form (cd8-pt 'fa 'fb 'r)))
       (fd `(VNB-LAMBDA cd8d_ sq ,(cd8-sub '(fa cd8d_) '(fb cd8d_))))
       (fbl `(VNB-LAMBDA cd8e_ sq (fb cd8e_)))
       (sa `(FINSUM ,cd8-ag fa sq)) (sb `(FINSUM ,cd8-ag fb sq))
       (sd `(FINSUM ,cd8-ag ,fd sq)) (sbl `(FINSUM ,cd8-ag ,fbl sq))
       (typ! (lambda (z)
               (let ((p (dk-apply! pt z)))
                 (if (dk-head-is? p 'AND) (dk-split-all! (list p))))
               (dk-cite! 'nf-neg-in-carr 'K `(fb ,z))
               (dk-cite! 'nf-add-in-carr 'K `(fa ,z) `((NEG K) (fb ,z)))))
       (to-ag! (lambda () (subst `(= (CARR ,cd8-ag) (CARR ,cd8-v))) (subst `(= (CARR ,cd8-v) (CARR K))))))
  ;; (i) the difference summand: typed and bounded
  (dk-have! `(FORALL cw3z_ (IMPLIES (IN cw3z_ sq) (AND (IN (,fd cw3z_) (CARR K)) (<= ,(cd8-n `(,fd cw3z_)) r))))
    (lambda ()
      (let* ((landed (dk-peel!)) (zv (cadr (car landed))))
        (typ! zv)
        (dk-lam-b!)
        (dk-conj-close! (lambda () (dk-ass!))))))
  (dk-cite! 'nv-finsum-le 'K 'sq fd 'r)
  ;; (ii) FUN typings of fd and of the lambda of fb
  (for-each
    (lambda (f)
      (dk-have! `(IN ,f (FUN sq (CARR ,cd8-ag)))
        (lambda ()
          (dk-lam-type!
            (lambda ()
              (let* ((landed (dk-peel!)) (zv (cadr (car landed))))
                (typ! zv)
                (to-ag!)
                (dk-ass!)))))))
    (list fd fbl))
  ;; (iii) sum fa = sum fd + sum fbl, and sum fbl = sum fb
  (let* ((add-eq (dk-cite! 'finsum-add-ag cd8-ag 'sq fd fbl))
         (lam (caddr (cadr add-eq))))
    (dk-have! `(FORALL cd8w_ (IMPLIES (IN cd8w_ sq) (= (,lam cd8w_) (fa cd8w_))))
      (lambda ()
        (let* ((landed (dk-peel!)) (zv (cadr (car landed))))
          (typ! zv)
          (dk-lam-b!)
          (subst `(= (OPR ,cd8-ag) (ADD ,cd8-v)))
          (subst `(= (ADD ,cd8-v) (ADD K)))
          (dk-cite! 'nf-sub-add-back 'K `(fa ,zv) `(fb ,zv))
          (dk-ass!))))
    (dk-have! `(FORALL cd8w_ (IMPLIES (IN cd8w_ sq) (IN (,lam cd8w_) (CARR ,cd8-ag))))
      (lambda ()
        (let* ((landed (dk-peel!)) (zv (cadr (car landed))))
          (typ! zv)
          (dk-lam-b!)
          (subst `(= (OPR ,cd8-ag) (ADD ,cd8-v)))
          (subst `(= (ADD ,cd8-v) (ADD K)))
          (dk-cite! 'nf-add-in-carr 'K (cd8-sub `(fa ,zv) `(fb ,zv)) `(fb ,zv))
          (to-ag!)
          (dk-ass!))))
    (dk-cite! 'finsum-congruence cd8-ag 'sq lam 'fa)
    (dk-have! `(FORALL cd8w_ (IMPLIES (IN cd8w_ sq) (= (,fbl cd8w_) (fb cd8w_))))
      (lambda ()
        (let* ((landed (dk-peel!)) (zv (cadr (car landed))))
          (typ! zv)
          (if (not (dk-lam-b!)) (rfl)))))
    (dk-have! `(FORALL cd8w_ (IMPLIES (IN cd8w_ sq) (IN (,fbl cd8w_) (CARR ,cd8-ag))))
      (lambda ()
        (let* ((landed (dk-peel!)) (zv (cadr (car landed))))
          (typ! zv)
          (dk-lam-b!)
          (to-ag!)
          (dk-ass!))))
    (dk-cite! 'finsum-congruence cd8-ag 'sq fbl 'fb)
    (for-each
      (lambda (f)
        (dk-have! `(FORALL cd6u_ (IMPLIES (IN cd6u_ sq) (IN (,f cd6u_) (CARR ,cd8-ag))))
          (lambda ()
            (let* ((landed (dk-peel!)) (zv (cadr (car landed))))
              (typ! zv)
              (dk-lam-b!)
              (to-ag!)
              (dk-ass!))))
        (dk-cite! 'finsum-type-ptwise cd8-ag 'sq f))
      (list fd fbl))
    (for-each (lambda (s) (dk-have! `(IN ,s (CARR K)) (lambda () (subst `(= (CARR K) (CARR ,cd8-v))) (subst `(= (CARR ,cd8-v) (CARR ,cd8-ag))) (dk-ass!))))
              (list sd sbl))
    (subst `(= ,sa (FINSUM ,cd8-ag ,lam sq)))
    (subst add-eq)
    (subst `(= ,sb ,sbl))
    (subst `(= (OPR ,cd8-ag) (ADD ,cd8-v)))
    (subst `(= (ADD ,cd8-v) (ADD K)))
    (dk-cite! 'cd6-add-sub-cancel 'K sd sbl)
    (subst `(= ,(cd8-sub `((ADD K) ,sd ,sbl) sbl) ,sd))
    (dk-ass!)))
(cd8-qed! 'cd8-finsum-diff-le)

;;; 7. Products of e-close matrices with a c-bounded one are (e c)-close, on either side.

(define (cd8-nonneg-prod! a b)          ; 0 <= a, 0 <= b, both real in context: land a * b in RR and 0 <= a * b
  (dk-have! `(AND (IN ,a RR) (IN ,b RR)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
  (dk-cite! 'rr-mul-closed a b)
  (dk-have! `(<= 0 (* ,a ,b))
    (lambda ()
      (dk-cite! 'rr-zero-in)
      (dk-have! '(<= 0 0) (lambda () (dk-ineq! '(IN 0 RR))))
      (dk-cite! 'rr-prod-le-gen 0 0 a b)
      (dk-have! '(= (* 0 0) 0) (lambda () (crs)))
      (dk-le-chain! 0 '(* 0 0) `(* ,a ,b)))))

(define (cd8-close-mul-drive! right?)
  (dk-peel!)
  (dk-cite! 'nv-field-normed 'K)
  (cd8-view!)
  (let* ((cl (cd8-close-parts! 'A 'B 'n 'n 'e))
         (bnd (cd8-bound-parts! 'tm 'n 'n 'c))
         (pa (if right? (cd8-mm 'A 'tm) (cd8-mm 'tm 'A)))
         (pb (if right? (cd8-mm 'B 'tm) (cd8-mm 'tm 'B)))
         (r (if right? '(* e c) '(* c e))))
    (for-each (lambda (m) (cd8-to-v! m 'n 'n)) '(A B tm))
    (dk-have! '(IMPLIES (= n 0) (OR (= n 0) (= n 0))) (lambda () (di) (prop)))
    (for-each (lambda (pr)
                (dk-cite! 'matmul-type cd8-v 'n 'n 'n (cadr pr) (caddr pr))
                (cd8-to-k! (car pr) 'n 'n))
              (if right? `((,pa A tm) (,pb B tm)) `((,pa tm A) (,pb tm B))))
    (cd8-nonneg-prod! (cadr r) (caddr r))
    (mac 'is-mat-close)
    (dk-conj-close!
      (lambda ()
        (if (dk-asm? (dk-goal))
            (dk-ass!)
            (let* ((landed (dk-peel!)) (g (dk-goal))
                   (e1 (cadr (cadr (cadr g)))) (e2 (cadr (caddr (cadr (cadr g)))))
                   (iv (caddr e1)) (jv (cadddr e1))
                   (sq '(INTERVAL 1 n)))
              (dk-cite! 'interval-lo 1 'n iv) (dk-cite! 'interval-hi 1 'n iv)
              (dk-cite! 'interval-elt-in-nn 1 'n iv)
              (dk-have! '(<= 1 n) (lambda () (dk-nn!)))
              (let* ((ea (if right? (dk-cite! 'matmul-entry cd8-v 'n 'n 'n 'A 'tm iv jv)
                                    (dk-cite! 'matmul-entry cd8-v 'n 'n 'n 'tm 'A iv jv)))
                     (eb (if right? (dk-cite! 'matmul-entry cd8-v 'n 'n 'n 'B 'tm iv jv)
                                    (dk-cite! 'matmul-entry cd8-v 'n 'n 'n 'tm 'B iv jv)))
                     (la (caddr (caddr ea))) (lb (caddr (caddr eb))))
                (subst ea)
                (subst eb)
                (dk-cite! 'interval-in-set 1 'n)
                (dk-cite! 'interval-card-in-nn 1 'n)
                (dk-have! `(FORALL cd8z_ (IMPLIES (IN cd8z_ ,sq) (AND (IN (,la cd8z_) (CARR K)) (AND (IN (,lb cd8z_) (CARR K))
                             (<= ,(cd8-n (cd8-sub `(,la cd8z_) `(,lb cd8z_))) ,r)))))
                  (lambda ()
                    (let* ((l2 (dk-peel!)) (zv (cadr (car l2)))
                           (a (if right? `(ENTRY A ,iv ,zv) `(ENTRY A ,zv ,jv)))
                           (b (if right? `(ENTRY B ,iv ,zv) `(ENTRY B ,zv ,jv)))
                           (t (if right? `(ENTRY tm ,zv ,jv) `(ENTRY tm ,iv ,zv)))
                           (amb (cd8-sub a b))
                           (pa1 (if right? `((MUL K) ,a ,t) `((MUL K) ,t ,a)))
                           (pb1 (if right? `((MUL K) ,b ,t) `((MUL K) ,t ,b)))
                           (pd (if right? `((MUL K) ,amb ,t) `((MUL K) ,t ,amb))))
                      (dk-lam-b!)
                      (subst `(= (MUL ,cd8-v) (MUL K)))
                      (for-each (lambda (m)
                                  (if right?
                                      (begin (dk-cite! 'entry-in-carrier 'n 'n '(CARR K) m iv zv))
                                      (begin (dk-cite! 'entry-in-carrier 'n 'n '(CARR K) m zv jv))))
                                '(A B))
                      (if right? (dk-cite! 'entry-in-carrier 'n 'n '(CARR K) 'tm zv jv)
                                 (dk-cite! 'entry-in-carrier 'n 'n '(CARR K) 'tm iv zv))
                      (dk-cite! 'nf-mul-in-carr 'K (cadr pa1) (caddr pa1))
                      (dk-cite! 'nf-mul-in-carr 'K (cadr pb1) (caddr pb1))
                      (dk-cite! 'nf-neg-in-carr 'K b)
                      (dk-cite! 'nf-add-in-carr 'K a `((NEG K) ,b))
                      (cd8-crs! `(= ,(cd8-sub pa1 pb1) ,pd) (list a b t))
                      (dk-cite! 'nf-norm-mult 'K (cadr pd) (caddr pd))
                      (cd8-real! (cd8-n amb)) (cd8-real! (cd8-n t))
                      (if right? (dk-apply! cl iv zv) (dk-apply! cl zv jv))
                      (if right? (dk-apply! bnd zv jv) (dk-apply! bnd iv zv))
                      (if right?
                          (dk-cite! 'rr-prod-le-gen (cd8-n amb) (cd8-n t) 'e 'c)
                          (dk-cite! 'rr-prod-le-gen (cd8-n t) (cd8-n amb) 'c 'e))
                      (dk-conj-close!
                        (lambda ()
                          (if (dk-asm? (dk-goal))
                              (dk-ass!)
                              (begin
                                (subst `(= ,(cd8-sub pa1 pb1) ,pd))
                                (subst `(= ,(cd8-n pd) (* ,(cd8-n (cadr pd)) ,(cd8-n (caddr pd)))))
                                (dk-ass!))))))))
                (dk-cite! 'cd8-finsum-diff-le 'K sq la lb r)
                (dk-ass!))))))))

(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL A (FORALL B (FORALL tm (FORALL e (FORALL c
  (IMPLIES (IN e RR) (IMPLIES (<= 0 e) (IMPLIES (IN c RR) (IMPLIES (<= 0 c)
  (IMPLIES (IS-MAT-CLOSE K n n A B e) (IMPLIES (IS-MAT-BOUND K n n tm c)
    (IS-MAT-CLOSE K n n ,(cd8-mm 'A 'tm) ,(cd8-mm 'B 'tm) (* e c)))))))))))))))))))
(cd8-close-mul-drive! #t)
(cd8-qed! 'cd8-close-mul-right)

(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL A (FORALL B (FORALL tm (FORALL e (FORALL c
  (IMPLIES (IN e RR) (IMPLIES (<= 0 e) (IMPLIES (IN c RR) (IMPLIES (<= 0 c)
  (IMPLIES (IS-MAT-CLOSE K n n A B e) (IMPLIES (IS-MAT-BOUND K n n tm c)
    (IS-MAT-CLOSE K n n ,(cd8-mm 'tm 'A) ,(cd8-mm 'tm 'B) (* c e)))))))))))))))))))
(cd8-close-mul-drive! #f)
(cd8-qed! 'cd8-close-mul-left)

;;; 8. MAT-POWER stays in the matrices; a matrix that is not power bounded has, for every c, an
;;;    entry of some power of norm > c.

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL X (IMPLIES (IN X ,(cd8-mat 'n 'n))
  (FORALL cdk (IMPLIES (IN cdk NN) (IN (MAT-POWER K n X cdk) ,(cd8-mat 'n 'n))))))))))))
(dk-peel!)
(cd8-view!)
(dk-cite! 'cb3-mr-ring 'K 'n)
(dk-cite! 'ring-multiplicative-monoid-is-monoid cd8-mr)
(dk-cite! 'rmm-carr cd8-mr)
(dk-cite! 'cb3-mr-carr 'K 'n)
(dk-have! `(IN X (CARR ,cd8-mrm))
  (lambda () (subst `(= (CARR ,cd8-mrm) (CARR ,cd8-mr))) (subst `(= (CARR ,cd8-mr) ,(cd8-mat 'n 'n))) (dk-ass!)))
(dk-cite! 'mpow-type cd8-mrm 'X 'cdk)
(dk-cite! 'cb3-mat-power-unfold 'K 'n 'X 'cdk)
(subst `(= (MAT-POWER K n X cdk) (MPOW ,cd8-mrm X cdk)))
(subst `(= ,(cd8-mat 'n 'n) (CARR ,cd8-mr)))
(subst `(= (CARR ,cd8-mr) (CARR ,cd8-mrm)))
(dk-ass!)
(cd8-qed! 'cd8-mpow-type)

(define (cd8-unb-goal c)
  `(FORSOME cdj (AND (IN cdj NN) (FORSOME cdi (AND (IN cdi (INTERVAL 1 n)) (FORSOME cdl (AND (IN cdl (INTERVAL 1 n))
     (< ,c ,(cd8-n '(ENTRY (MAT-POWER K n X cdj) cdi cdl))))))))))
(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL X (IMPLIES (IN X ,(cd8-mat 'n 'n))
  (IMPLIES (NOT (IS-POWER-BOUNDED K n X))
    (FORALL c (IMPLIES (IN c RR) (IMPLIES (<= 0 c) ,(cd8-unb-goal 'c)))))))))))))
(dk-peel!)
(let ((g (dk-goal)) (npb '(NOT (IS-POWER-BOUNDED K n X))))
  (use-em g
    (lambda () (dk-ass!))
    (lambda ()
      (let ((ng (list 'NOT g)))
        (dk-have! '(IS-POWER-BOUNDED K n X)
          (lambda ()
            (mac 'is-power-bounded)
            (ew 'c)
            (mac 'is-power-bounded-by)
            (dk-conj-close!
              (lambda ()
                (if (dk-asm? (dk-goal)) (dk-ass!)
                    (let* ((l1 (dk-peel!)) (kv (cadr (car l1)))
                           (p `(MAT-POWER K n X ,kv)))
                      (dk-cite! 'cd8-mpow-type 'K 'n 'X kv)
                      (mac 'is-mat-bound)
                      (dk-conj-close!
                        (lambda ()
                          (if (dk-asm? (dk-goal)) (dk-ass!)
                              (let* ((l2 (dk-peel!)) (gg (dk-goal)) (en (cadr (cadr gg)))
                                     (iv (caddr en)) (lv (cadddr en)))
                                (dk-cite! 'entry-in-carrier 'n 'n '(CARR K) p iv lv)
                                (cd8-real! (cd8-n en))
                                (use-em gg
                                  (lambda () (dk-ass!))
                                  (lambda ()
                                    (dk-cite! 'rr-not-le-lt (cd8-n en) 'c)
                                    (dk-have! g
                                      (lambda ()
                                        (ew kv)
                                        (dk-conj-close!
                                          (lambda ()
                                            (if (dk-asm? (dk-goal)) (dk-ass!)
                                                (begin
                                                  (ew iv)
                                                  (dk-conj-close!
                                                    (lambda ()
                                                      (if (dk-asm? (dk-goal)) (dk-ass!)
                                                          (begin
                                                            (ew lv)
                                                            (dk-conj-close! (lambda () (dk-ass!)))))))))))))
                                    (dk-only! g ng)
                                    (prop)))))))))))))
        (dk-only! '(IS-POWER-BOUNDED K n X) npb)
        (prop)))))
(cd8-qed! 'cd8-unbounded)

;;; 9. Scalars and products: (y P) T = T (y P) when P T = T P, and y P = (y I) P  (n >= 1).

(define (cd8-succ-of-n!)                 ; (<= 1 n) in context: land n = succ q, return q
  (dk-have! '(NOT (= n 0)) (lambda () (dk-nn! '(<= 1 n))))
  (let ((q (dk-skolem! (dk-cite! 'nn-nonzero-is-succ 'n) #t)))
    (dk-split-all!)
    q))

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN) (IMPLIES (<= 1 n)
  (FORALL cdP (FORALL tm (FORALL cdy (IMPLIES (IN cdP ,(cd8-mat 'n 'n)) (IMPLIES (IN tm ,(cd8-mat 'n 'n)) (IMPLIES (IN cdy (CARR K))
    (IMPLIES (= ,(cd8-mm 'tm 'cdP) ,(cd8-mm 'cdP 'tm))
      (= ,(cd8-mm `(MATSCALE ,cd8-v cdy cdP) 'tm) ,(cd8-mm 'tm `(MATSCALE ,cd8-v cdy cdP)))))))))))))))))
(dk-peel!)
(cd8-view!)
(let* ((q (cd8-succ-of-n!)) (sn `(succ ,q)))
  (cd8-to-v! 'cdP 'n 'n) (cd8-to-v! 'tm 'n 'n) (cd8-in-v! 'cdy)
  (dk-rewrite-h! `(IN cdP ,(cd8-matv 'n 'n)) 'n sn)
  (dk-rewrite-h! `(IN tm ,(cd8-matv 'n 'n)) 'n sn)
  (dk-cite! 'matmul-matscale-left cd8-v q 'cdP 'tm 'cdy)
  (dk-cite! 'matmul-matscale-right cd8-v q 'tm 'cdP 'cdy)
  (subst `(= ,(cd8-mm `(MATSCALE ,cd8-v cdy cdP) 'tm) (MATSCALE ,cd8-v cdy ,(cd8-mm 'cdP 'tm))))
  (subst `(= ,(cd8-mm 'tm `(MATSCALE ,cd8-v cdy cdP)) (MATSCALE ,cd8-v cdy ,(cd8-mm 'tm 'cdP))))
  (subst `(= ,(cd8-mm 'cdP 'tm) ,(cd8-mm 'tm 'cdP)))
  (rfl))
(cd8-qed! 'cd8-scale-commute)

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN) (IMPLIES (<= 1 n)
  (FORALL cdP (FORALL cdy (IMPLIES (IN cdP ,(cd8-mat 'n 'n)) (IMPLIES (IN cdy (CARR K))
    (= (MATSCALE ,cd8-v cdy cdP) ,(cd8-mm `(MATSCALE ,cd8-v cdy (IDENTMAT ,cd8-v n)) 'cdP)))))))))))))
(dk-peel!)
(cd8-view!)
(let* ((q (cd8-succ-of-n!)) (sn `(succ ,q)))
  (cd8-to-v! 'cdP 'n 'n) (cd8-in-v! 'cdy)
  (dk-cite! 'matscale-type cd8-v 'n 'n 'cdy 'cdP)
  (dk-rewrite-h! `(IN cdP ,(cd8-matv 'n 'n)) 'n sn)
  (dk-cite! 'nn-succ-closed q)
  (dk-cite! 'identmat-type cd8-v sn)
  (subst `(= n ,sn))
  (dk-cite! 'matmul-matscale-left cd8-v q `(IDENTMAT ,cd8-v ,sn) 'cdP 'cdy)
  (dk-cite! 'identmat-left-identity cd8-v sn sn 'cdP)
  (subst `(= ,(cd8-mm `(MATSCALE ,cd8-v cdy (IDENTMAT ,cd8-v ,sn)) 'cdP) (MATSCALE ,cd8-v cdy ,(cd8-mm `(IDENTMAT ,cd8-v ,sn) 'cdP))))
  (subst `(= ,(cd8-mm `(IDENTMAT ,cd8-v ,sn) 'cdP) cdP))
  (rfl))
(cd8-qed! 'cd8-scale-as-mul)

;;; 10. THE STEP: if X commutes with T, |det X| <= 1 and X is not power bounded, then for every k there is
;;;     a matrix Y with ||Y|| <= 1, an entry of norm 1, Y T = T Y and |det Y| (k + 1) <= 1.

(define (cd8-good kk y)
  `(AND (IS-MAT-BOUND K n n ,y 1)
   (AND (= ,(cd8-mm y 'tm) ,(cd8-mm 'tm y))
   (AND (<= (* ,(cd8-n `(DET ,cd8-v n ,y)) (+ ,kk 1)) 1)
        (FORSOME cd8i_ (AND (IN cd8i_ (INTERVAL 1 n)) (FORSOME cd8j_ (AND (IN cd8j_ (INTERVAL 1 n))
          (= ,(cd8-n `(ENTRY ,y cd8i_ cd8j_)) 1)))))))))
(define cd8-step-hyps
  `((IN X ,(cd8-mat 'n 'n)) (IN tm ,(cd8-mat 'n 'n)) (= ,(cd8-mm 'X 'tm) ,(cd8-mm 'tm 'X))
    (<= ,(cd8-n `(DET ,cd8-v n X)) 1) (NOT (IS-POWER-BOUNDED K n X))))
(define (cd8-implies hyps body)
  (if (null? hyps) body `(IMPLIES ,(car hyps) ,(cd8-implies (cdr hyps) body))))

(sp (make-wff `(FORALL K (IMPLIES (IS-NV-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL X (FORALL tm
