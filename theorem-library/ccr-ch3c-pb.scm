                    (dk-cite! 'nf-norm-in-rr 'K `(ENTRY A (NNFST ,tv) (NNSND ,tv)))
                    (dk-ass!))
                  (begin (dk-cite! 'rr-zero-in) (dk-ass!))))))))))
(let* ((mx (dk-cite! 'cd8-argmax-nn cd8-cbound cd8-fl))
       (t0 (dk-skolem! mx #t))
       (ignore (dk-split-all!))
       (mxu (dk-pick (lambda (f) (and (dk-head-is? f 'FORALL) (dk-contains? f t0) (dk-contains? f 'cd8t_))) "the max"))
       (rest!
        (lambda (i0 j0 f0-eq)
          ;; f0-eq: (= (fl t0) v0) in context; close the goal with witnesses i0 j0
          (let ((v0 (caddr f0-eq)))
            (ew i0)
            (dk-conj-close!
