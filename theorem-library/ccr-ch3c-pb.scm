;;; ======================================================================
;;; ccr-3-6-ultra-inv -- the ultrametric half of Proposition 3.6, for S with a two-sided inverse P:
;;; S, R commute with an irreducible T, P S = S P = I and |det R| <= |det S| give
;;; |det(S + R)| <= |det S|.  Route (the notes' proof, repaired as CCR-1109-B2 4.3): X = P R commutes
;;; with T (P does, since S does), |det X| = |det P| |det R| <= |det P| |det S| = |det I| = 1, so X is
;;; power bounded (ccr-3-4-comm), |det(I + X)| <= 1 (cb3-det-shift-bound), and S + R = S (I + X).
(define cd8-id `(IDENTMAT ,cd8-v n))
(define (cd8-mtype! a b)
  (dk-cite! 'matmul-type cd8-v 'n 'n 'n a b)
  (cd8-to-k! (cd8-mm a b) 'n 'n))
(define (cd8-assoc! a b c)       ; lands (a b) c = a (b c); a b c typed in V-form
  (dk-cite! 'matmul-assoc cd8-v 'n 'n 'n 'n a b c))

(sp (make-wff `(FORALL K (IMPLIES (IS-LOCAL-NV-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL tm
  (IMPLIES (IS-IRREDUCIBLE-MAT K n tm)
  (FORALL sa (IMPLIES (IN sa ,(cd8-mat 'n 'n)) (FORALL ra (IMPLIES (IN ra ,(cd8-mat 'n 'n))
  (FORALL pa (IMPLIES (IN pa ,(cd8-mat 'n 'n))
    (IMPLIES (= ,(cd8-mm 'sa 'tm) ,(cd8-mm 'tm 'sa))
    (IMPLIES (= ,(cd8-mm 'ra 'tm) ,(cd8-mm 'tm 'ra))
    (IMPLIES (= ,(cd8-mm 'pa 'sa) ,cd8-id)
    (IMPLIES (= ,(cd8-mm 'sa 'pa) ,cd8-id)
    (IMPLIES (<= ,(cd8-n `(DET ,cd8-v n ra)) ,(cd8-n `(DET ,cd8-v n sa)))
      (<= ,(cd8-n `(DET ,cd8-v n (MATADD ,cd8-v sa ra))) ,(cd8-n `(DET ,cd8-v n sa))))))))))))))))))))))
(dk-peel!)
(dk-project! '(IS-NV-FIELD K) (lambda () (mac-h 'is-local-nv-field '(IS-LOCAL-NV-FIELD K))))
(dk-project! `(IN tm ,(cd8-mat 'n 'n)) (lambda () (mac-h 'is-irreducible-mat '(IS-IRREDUCIBLE-MAT K n tm))))
(dk-cite! 'nv-field-normed 'K)
(cd8-view!)
(for-each (lambda (a) (cd8-to-v! a 'n 'n)) '(tm sa ra pa))
(dk-have! '(IMPLIES (= n 0) (OR (= n 0) (= n 0))) (lambda () (di) (prop)))
(dk-have! '(IMPLIES (= n 0) (OR (= n 0) (AND (= n 0) (= n 0)))) (lambda () (di) (prop)))
(dk-cite! 'identmat-type cd8-v 'n)
(cd8-to-k! cd8-id 'n 'n)
(let* ((tp (cd8-mm 'tm 'pa)) (pt (cd8-mm 'pa 'tm)) (xa (cd8-mm 'pa 'ra))
       (ix `(MATADD ,cd8-v ,cd8-id ,xa)) (sr `(MATADD ,cd8-v sa ra))
       (dn (lambda (a) (cd8-n `(DET ,cd8-v n ,a)))))
  (for-each (lambda (ab) (cd8-mtype! (car ab) (cadr ab)))
            `((tm pa) (pa tm) (pa ra) (sa tm) (tm sa) (sa pa) (pa sa) (ra tm) (tm ra)))
  (cd8-to-v! tp 'n 'n) (cd8-to-v! xa 'n 'n)
  (cd8-mtype! 'sa tp) (cd8-to-v! (cd8-mm 'sa tp) 'n 'n)
  (cd8-mtype! 'pa (cd8-mm 'sa tp))
  ;; e1: S (T P) = T
  (dk-have! `(= ,(cd8-mm 'sa tp) tm)
    (lambda ()
      (cd8-assoc! 'sa 'tm 'pa)
      (subst `(= ,(cd8-mm 'sa tp) ,(cd8-mm (cd8-mm 'sa 'tm) 'pa)))
      (subst `(= ,(cd8-mm 'sa 'tm) ,(cd8-mm 'tm 'sa)))
      (cd8-assoc! 'tm 'sa 'pa)
      (subst `(= ,(cd8-mm (cd8-mm 'tm 'sa) 'pa) ,(cd8-mm 'tm (cd8-mm 'sa 'pa))))
      (subst `(= ,(cd8-mm 'sa 'pa) ,cd8-id))
      (dk-cite! 'identmat-right-identity cd8-v 'n 'n 'tm)
      (dk-ass!)))
  ;; e2: P (S (T P)) = P T  and  = T P
  (dk-have! `(= ,(cd8-mm 'pa (cd8-mm 'sa tp)) ,pt)
    (lambda () (subst `(= ,(cd8-mm 'sa tp) tm)) (rfl)))
  (dk-have! `(= ,(cd8-mm 'pa (cd8-mm 'sa tp)) ,tp)
    (lambda ()
      (cd8-assoc! 'pa 'sa tp)
      (subst `(= ,(cd8-mm 'pa (cd8-mm 'sa tp)) ,(cd8-mm (cd8-mm 'pa 'sa) tp)))
      (subst `(= ,(cd8-mm 'pa 'sa) ,cd8-id))
      (dk-cite! 'identmat-left-identity cd8-v 'n 'n tp)
      (dk-ass!)))
  (dk-have! `(= ,pt ,tp)
    (lambda () (subst `(= ,pt ,(cd8-mm 'pa (cd8-mm 'sa tp)))) (dk-ass!)))
  ;; X = P R commutes with T
  (cd8-mtype! xa 'tm) (cd8-mtype! 'tm xa)
  (dk-have! `(= ,(cd8-mm xa 'tm) ,(cd8-mm 'tm xa))
    (lambda ()
      (cd8-assoc! 'pa 'ra 'tm)
      (subst `(= ,(cd8-mm xa 'tm) ,(cd8-mm 'pa (cd8-mm 'ra 'tm))))
      (subst `(= ,(cd8-mm 'ra 'tm) ,(cd8-mm 'tm 'ra)))
      (cd8-assoc! 'pa 'tm 'ra)
      (subst `(= ,(cd8-mm 'pa (cd8-mm 'tm 'ra)) ,(cd8-mm pt 'ra)))
      (subst `(= ,pt ,tp))
      (cd8-assoc! 'tm 'pa 'ra)
      (dk-ass!)))
  ;; |det X| <= 1
  (for-each (lambda (a) (cd8-to-v! a 'n 'n) (dk-cite! 'det-in-carrier cd8-v 'n a) (cd8-in-k! `(DET ,cd8-v n ,a)) (cd8-real! (dn a)))
            (list 'pa 'ra 'sa xa (cd8-mm 'pa 'sa)))
  (dk-cite! 'ccr-3-6-multiplicative 'K 'n 'pa 'ra)
  (dk-cite! 'ccr-3-6-multiplicative 'K 'n 'pa 'sa)
  (dk-cite! 'det-identity-ind cd8-v 'n)
  (dk-cite! 'nf-norm-one 'K)
  (dk-have! `(= ,(dn (cd8-mm 'pa 'sa)) 1)
    (lambda ()
      (subst `(= ,(cd8-mm 'pa 'sa) ,cd8-id))
      (subst `(= (DET ,cd8-v n ,cd8-id) (ONE ,cd8-v)))
      (subst `(= (ONE ,cd8-v) (ONE K)))
      (dk-ass!)))
  (dk-cite! 'rr-mul-le-right (dn 'ra) (dn 'sa) (dn 'pa))
  (dk-have! `(= (* ,(dn 'pa) ,(dn 'ra)) (* ,(dn 'ra) ,(dn 'pa))) (lambda () (crs)))
  (dk-have! `(= (* ,(dn 'sa) ,(dn 'pa)) (* ,(dn 'pa) ,(dn 'sa))) (lambda () (crs)))
  (dk-have! `(<= ,(dn xa) 1)
    (lambda () (dk-le-chain! (dn xa) `(* ,(dn 'pa) ,(dn 'ra)) `(* ,(dn 'ra) ,(dn 'pa)) `(* ,(dn 'sa) ,(dn 'pa))
                             `(* ,(dn 'pa) ,(dn 'sa)) (dn (cd8-mm 'pa 'sa)) 1)))
  ;; X power bounded, |det(I + X)| <= 1
  (dk-cite! 'ccr-3-4-comm 'K 'n xa 'tm)
  (dk-cite! 'cb3-det-shift-bound 'K 'n xa)
  ;; S + R = S (I + X)
  (dk-cite! 'matadd-type cd8-v 'n 'n cd8-id xa)
  (dk-cite! 'matadd-type cd8-v 'n 'n 'sa 'ra)
  (cd8-to-k! ix 'n 'n) (cd8-to-k! sr 'n 'n)
  (cd8-mtype! 'sa ix) (cd8-mtype! 'sa xa) (cd8-to-v! (cd8-mm 'sa 'pa) 'n 'n)
  (dk-have! `(= ,(cd8-mm 'sa ix) ,sr)
    (lambda ()
      (dk-cite! 'matmul-left-dist-guarded cd8-v 'n 'n 'n 'sa cd8-id xa)
      (subst `(= ,(cd8-mm 'sa ix) (MATADD ,cd8-v ,(cd8-mm 'sa cd8-id) ,(cd8-mm 'sa xa))))
      (dk-cite! 'identmat-right-identity cd8-v 'n 'n 'sa)
      (subst `(= ,(cd8-mm 'sa cd8-id) sa))
      (cd8-assoc! 'sa 'pa 'ra)
      (subst `(= ,(cd8-mm 'sa xa) ,(cd8-mm (cd8-mm 'sa 'pa) 'ra)))
      (subst `(= ,(cd8-mm 'sa 'pa) ,cd8-id))
      (dk-cite! 'identmat-left-identity cd8-v 'n 'n 'ra)
      (subst `(= ,(cd8-mm cd8-id 'ra) ra))
      (rfl)))
  ;; the estimate
  (for-each (lambda (a) (cd8-to-v! a 'n 'n) (dk-cite! 'det-in-carrier cd8-v 'n a) (cd8-in-k! `(DET ,cd8-v n ,a)) (cd8-real! (dn a)))
            (list ix (cd8-mm 'sa ix)))
  (dk-cite! 'ccr-3-6-multiplicative 'K 'n 'sa ix)
  (dk-cite! 'rr-one-in)
  (dk-cite! 'rr-mul-le-right (dn ix) 1 (dn 'sa))
  (dk-have! `(= (* ,(dn 'sa) ,(dn ix)) (* ,(dn ix) ,(dn 'sa))) (lambda () (crs)))
  (dk-have! `(= (* 1 ,(dn 'sa)) ,(dn 'sa)) (lambda () (crs)))
  (subst `(= ,sr ,(cd8-mm 'sa ix)))
  (dk-le-chain! (dn (cd8-mm 'sa ix)) `(* ,(dn 'sa) ,(dn ix)) `(* ,(dn ix) ,(dn 'sa)) `(* 1 ,(dn 'sa)) (dn 'sa)))
(cd8-qed! 'ccr-3-6-ultra-inv)

;;; ccr-3-6-ultra -- the ultrametric inequality of Proposition 3.6 on the commutant of an irreducible T,
;;; for matrices that are invertible as soon as their determinant is non-zero (on K[T] that is every
;;; element; the tree has no adjugate, so the inverse is a hypothesis):
;;;   |det(S + R)| <= max(|det S|, |det R|).
;;; The case det S = 0 (S the larger) is S = 0 by ccr-3-4-commutant, not a spectrum argument.
(define (cd8-inv-hyp a)
  `(IMPLIES (NOT (= (DET ,cd8-v n ,a) (ZERO K)))
     (FORSOME cd8p_ (AND (IN cd8p_ ,(cd8-mat 'n 'n))
       (AND (= ,(cd8-mm 'cd8p_ a) ,cd8-id) (= ,(cd8-mm a 'cd8p_) ,cd8-id))))))
;; goal |det(big + small)| <= |det big|, with |det small| <= |det big|, both commuting with tm
(define (cd8-ultra-case! big small)
  (let ((ab `(MATADD ,cd8-v ,big ,small)) (hb (cd8-inv-hyp big)))
    (use-em `(= (DET ,cd8-v n ,big) (ZERO K))
      (lambda ()
        (dk-cite! 'ccr-3-4-commutant 'K 'n 'tm big)
        (dk-cite! 'matadd-zero-left cd8-v 'n 'n small)
        (dk-have! `(= ,ab ,small)
          (lambda () (subst `(= ,big (ZEROMAT ,cd8-v n n))) (dk-ass!)))
        (subst `(= ,ab ,small))
        (dk-ass!))
      (lambda ()
        (let* ((ex (detach! hb))
               (pv (dk-skolem! (or (dk-ctx-form (caddr hb)) (error "cd8-ultra-case!: no inverse")) #t)))
          (dk-split-all!)
          (dk-cite! 'ccr-3-6-ultra-inv 'K 'n 'tm big small pv)
          (dk-ass!))))))

(sp (make-wff `(FORALL K (IMPLIES (IS-LOCAL-NV-FIELD K) (FORALL n (IMPLIES (IN n NN) (FORALL tm
  (IMPLIES (IS-IRREDUCIBLE-MAT K n tm)
  (FORALL sa (IMPLIES (IN sa ,(cd8-mat 'n 'n)) (FORALL ra (IMPLIES (IN ra ,(cd8-mat 'n 'n))
    (IMPLIES (= ,(cd8-mm 'sa 'tm) ,(cd8-mm 'tm 'sa))
    (IMPLIES (= ,(cd8-mm 'ra 'tm) ,(cd8-mm 'tm 'ra))
    (IMPLIES ,(cd8-inv-hyp 'sa)
    (IMPLIES ,(cd8-inv-hyp 'ra)
      (<= ,(cd8-n `(DET ,cd8-v n (MATADD ,cd8-v sa ra)))
          (MAX ,(cd8-n `(DET ,cd8-v n sa)) ,(cd8-n `(DET ,cd8-v n ra))))))))))))))))))))
(dk-peel!)
(dk-project! '(IS-NV-FIELD K) (lambda () (mac-h 'is-local-nv-field '(IS-LOCAL-NV-FIELD K))))
(dk-project! `(IN tm ,(cd8-mat 'n 'n)) (lambda () (mac-h 'is-irreducible-mat '(IS-IRREDUCIBLE-MAT K n tm))))
(dk-cite! 'nv-field-normed 'K)
(cd8-view!)
(for-each (lambda (a) (cd8-to-v! a 'n 'n)) '(tm sa ra))
(let* ((dn (lambda (a) (cd8-n `(DET ,cd8-v n ,a)))))
  (for-each (lambda (a) (dk-cite! 'det-in-carrier cd8-v 'n a) (cd8-in-k! `(DET ,cd8-v n ,a)) (cd8-real! (dn a)))
            '(sa ra))
  (use-em `(<= ,(dn 'ra) ,(dn 'sa))
    (lambda ()
      (dk-cite! 'rr-max-left-le (dn 'sa) (dn 'ra))
      (subst `(= (MAX ,(dn 'sa) ,(dn 'ra)) ,(dn 'sa)))
      (cd8-ultra-case! 'sa 'ra))
    (lambda ()
      (let ((nf `(NOT (<= ,(dn 'ra) ,(dn 'sa)))))
        (dk-have! `(AND (IN ,(dn 'ra) RR) (IN ,(dn 'sa) RR)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
        (let ((orf (dk-cite! 'rr-leq-total (dn 'ra) (dn 'sa))))
          (dk-have! `(<= ,(dn 'sa) ,(dn 'ra)) (lambda () (dk-only! orf nf) (prop)))))
      (dk-cite! 'rr-max-right-le (dn 'sa) (dn 'ra))
      (subst `(= (MAX ,(dn 'sa) ,(dn 'ra)) ,(dn 'ra)))
      (dk-cite! 'matadd-comm cd8-v 'n 'n 'sa 'ra)
      (subst `(= (MATADD ,cd8-v sa ra) (MATADD ,cd8-v ra sa)))
      (cd8-ultra-case! 'ra 'sa))))
(cd8-qed! 'ccr-3-6-ultra)
