      (FORALL cdi (IMPLIES (IN cdi (INTERVAL 1 n)) (FORALL cdj (IMPLIES (IN cdj (INTERVAL 1 n))
        (<= ,(cd8-n '(ENTRY A cdi cdj)) ,(cd8-n '(ENTRY A cdi0 cdj0))))))))))))))))))))
(dk-peel!)
(dk-have! '(AND (IN n NN) (IN n NN)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
(dk-cite! 'nn-add-closed 'n 'n)
(dk-cite! 'trinum-type '(+ n n))
(dk-have! '(AND (IN (TRINUM (+ n n)) NN) (IN n NN)) (lambda () (dk-conj-close! (lambda () (dk-ass!)))))
(dk-cite! 'nn-add-closed '(TRINUM (+ n n)) 'n)
;; f in FUN(NN, RR)
(dk-have! `(IN ,cd8-fl (FUN NN RR))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let* ((landed (dk-peel!)) (tv (cadr (car landed))) (ift (cadr (dk-goal))))
