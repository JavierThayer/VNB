;;; 4. A finite argmax over the entries of a square matrix (n >= 1), through the Cantor codes:
;;;    f(t) = |A(NNFST t, NNSND t)| when the index pair is in range, 0 otherwise.

(define (cd8-cond t) `(AND (IN (NNFST ,t) (INTERVAL 1 n)) (IN (NNSND ,t) (INTERVAL 1 n))))
(define (cd8-fval t) `(IF ,(cd8-cond t) ,(cd8-n `(ENTRY A (NNFST ,t) (NNSND ,t))) 0))
(define cd8-fl `(VNB-LAMBDA cd8t_ NN ,(cd8-fval 'cd8t_)))
(define cd8-cbound '(+ (TRINUM (+ n n)) n))

;; (fl t) = |A(i, j)| for t = NNPAIR(i, j) with i, j in range (or for t itself when the condition holds)
(define (cd8-fl-value! t iv jv)
  (let ((want `(= (,cd8-fl ,t) ,(cd8-n `(ENTRY A ,iv ,jv)))))
    (dk-have! want
      (lambda ()
        (if (not (dk-lam-b!))
            (begin
              (if (not (equal? iv `(NNFST ,t)))
                  (begin (subst `(= (NNFST ,t) ,iv)) (subst `(= (NNSND ,t) ,jv))))
              (let ((ift (cadr (dk-goal))))
                (dk-if-branch! #t ift (lambda () (dk-conj-close! (lambda () (dk-ass!))))
                  (lambda () (rfl))))))))
    want))

(sp (make-wff `(FORALL K (IMPLIES (IS-NORMED-FIELD K) (FORALL n (IMPLIES (IN n NN) (IMPLIES (<= 1 n)
  (FORALL A (IMPLIES (IN A ,(cd8-mat 'n 'n))
