;;; l2b-d.scm -- THE INTEGRAL OPERATOR OF A REAL L^2 KERNEL (th-main 3.40 (i)-(ii), real case)
;;; (TH3-L2B, 2026-11-09).  Helper prefix: tld-.
;;;
;;; For k in L^2(X x Y, mu x nu) (sigma-finite) and xi in L^2(Y, nu), the function
;;;     (T_k xi)(x) = int_Y k(x, y) xi(y) dnu(y)
;;; is defined for almost every x, is (a.e. equal to) a member of L^2(X, mu), and
;;;     int_X (T_k xi)^2 dmu <= ||k||_2^2 ||xi||_2^2.
;;; T_k xi is written as the canonical total function G_F of l2b-b (inner integrals of F+ and
;;; F-, truncated where infinite) for F(x, y) = k(x, y) xi(y).  Measurability of G_F needs no
;;; integrability of F on X x Y (which fails in general when mu(X) is infinite): it is
;;; Tonelli's measurability of the inner integrals of F+ and F- (fubini) plus the truncation.
;;;
;;; LOAD WINDOW: after l2b-c (and l2c-c: measurable-fn-pullback-second).  Library: measure.
;;; No new vocabulary.

(define (tld-qed! name)
  (if (proof-done? *ps*)
      (begin (qed name) (topic! name 'analysis))
      (begin
        (display "\n*** l2b-d: ") (display name) (display " did NOT close.  Open goals:\n")
        (for-each (lambda (l)
                    (display "   GOAL: ") (display (expression->string (dk-goal-of l))) (newline)
                    (for-each (lambda (a) (display "      asm: ") (display (expression->string a)) (newline))
                              (dk-asms-of l)))
                  (dk-open-leaves))
        (error "l2b-d: unfinished" name))))

(define (tld-map f l) (let loop ((l l) (acc '())) (if (null? l) (reverse acc) (loop (cdr l) (cons (f (car l)) acc)))))
(define (tld-open?) (not (proof-done? *ps*)))
(define (tld-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
(define (tld-lb!) (let loop () (if (dk--redex? (dk-goal)) (begin (dk-lam-b!) (loop)))))
(define (tld-parts! pred args)
  (let* ((iff (apply dk-cite! (cons pred args)))
         (cs (let loop ((r (caddr iff)) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (tld-map (lambda (c) (if (dk-asm? c) c
                             (dk-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))))
             cs)))
(define (tld-ptwise var dom body) (list 'FORALL var (list 'IMPLIES (list 'IN var dom) body)))
(define (tld-off var dom nset body) (tld-ptwise var dom (list 'IMPLIES (list 'NOT (list 'IN var nset)) body)))
(define (tld-pick pred) (find-first pred (dk-asms)))

(define tld-xy '(CARTESIAN xs ys))
(define tld-ps '(PRODUCT-SIGMA xs cA ys cB))
(define tld-rho '(PRODUCT-MEASURE xs cA mu ys cB nu))
(define tld-meas2 '((IS-MEASURE xs cA mu) (IS-MEASURE ys cB nu)))
(define tld-sf2 '((IS-SIGMA-FINITE xs cA mu) (IS-SIGMA-FINITE ys cB nu)))
(define (tld-fxs f x) (list 'FN-X-SECTION 'ys f x))
(define (tld-sq f om) (list 'VNB-LAMBDA 'lx_ om (list '* (list f 'lx_) (list f 'lx_))))
(define (tld-xsi f) (list 'X-SECTION-INTEGRAL 'xs 'ys 'cB 'nu f))
(define (tld-trunc u om) (list 'VNB-LAMBDA 'tdx_ om (list 'IF (list 'IN (list u 'tdx_) 'RR) (list u 'tdx_) 0)))
(define (tld-ifv u w) (list 'IF (list 'IN (list u w) 'RR) (list u w) 0))
(define (tld-g f)
  (let ((u (tld-xsi (list 'POS-PART tld-xy f))) (v (tld-xsi (list 'NEG-PART tld-xy f))))
    (list 'VNB-LAMBDA 'sgx_ 'xs
          (list '- (list 'IF (list 'IN (list u 'sgx_) 'RR) (list u 'sgx_) 0)
                   (list 'IF (list 'IN (list v 'sgx_) 'RR) (list v 'sgx_) 0)))))
(define (tld-base!)
  (tld-parts! 'is-measure '(xs cA mu))
  (tld-parts! 'is-measure '(ys cB nu))
  (fact 'sigma-algebra-ambient-set 'xs 'cA)
  (fact 'sigma-algebra-ambient-set 'ys 'cB)
  (fact 'product-sigma-is-sigma-algebra 'xs 'cA 'ys 'cB)
  (fact 'product-measure-is-measure 'xs 'cA 'mu 'ys 'cB 'nu))

;;; ==========================================================================================
;;; (1) A REAL FUNCTION OF THE SECOND COORDINATE IS REAL MEASURABLE ON THE PRODUCT
;;; ==========================================================================================
(define tld-xp '(VNB-LAMBDA tw_ (CARTESIAN xs ys) (xi (NTH 2 tw_))))
(sp (make-wff (forall-guarded '(xs cA ys cB xi) '((IS-SIGMA-ALGEBRA xs cA) (IS-SIGMA-ALGEBRA ys cB) (IS-REAL-MEASURABLE-FN ys cB xi))
   (list 'IS-REAL-MEASURABLE-FN tld-xy tld-ps tld-xp))))
(dk-peel!)
(tld-parts! 'is-real-measurable-fn '(ys cB xi))
(fact 'sigma-algebra-ambient-set 'xs 'cA)
(fact 'sigma-algebra-ambient-set 'ys 'cB)
(dk-have! (list 'IN tld-xy 'SET) (lambda () (mac 'cartesian-set-iff) (dk-conj-close! dk-ass!)))
(dk-have! (list 'IN tld-xp (list 'FUN tld-xy 'RR))
  (lambda ()
    (dk-lam-type!
      (lambda ()
        (let ((w (dk-di-var!)))
          (dk-split! (dk-cite! 'cartesian-nth w 'xs 'ys))
          (tld-then-ass! (lambda () (fact 'fun-apply-type-c 'xi 'ys 'RR (list 'NTH 2 w))))))
      (lambda () (ass)))))
(fact 'pos-part-fun tld-xy tld-xp)
(fact 'neg-part-fun tld-xy tld-xp)
(for-each
  (lambda (pp)
    (let* ((part (car pp)) (val (cadr pp))
           (pb (list part 'ys 'xi))
           (pull (list 'VNB-LAMBDA 'tw_ tld-xy (list pb '(NTH 2 tw_))))
           (lhs (list part tld-xy tld-xp)))
      (fact 'measurable-fn-pullback-second 'xs 'cA 'ys 'cB pb)
      (dk-cite! 'measurable-fn-in-fun tld-xy tld-ps pull)
      (dk-have! (tld-ptwise 'icx_ tld-xy (list '= (list pull 'icx_) (list lhs 'icx_)))
        (lambda ()
          (let* ((w (dk-di-var!)) (n2 (list 'NTH 2 w)))
            (dk-split! (dk-cite! 'cartesian-nth w 'xs 'ys))
            (fact 'fun-apply-type-c 'xi 'ys 'RR n2)
            (dk-split! (dk-cite! 'part-values-at 'ys 'xi n2))
            (subst (dk-cite! val tld-xy tld-xp w))
            (tld-lb!)
            (let ((ve (dk-cite! val 'ys 'xi n2)))
              (subst (list '= (caddr ve) (cadr ve))))
            (if (tld-open?) (rfl)))))
      (fact 'measurable-fn-congruence-ptwise tld-xy tld-ps pull lhs)))
  '((POS-PART pos-part-value) (NEG-PART neg-part-value)))
(mac 'IS-REAL-MEASURABLE-FN)
(dk-conj-close! dk-ass!)
(tld-qed! 'real-measurable-pullback-second)

;;; ==========================================================================================
;;; (2) TRUNCATION KEEPS MEASURABILITY (no finiteness of the integral needed)
;;; ==========================================================================================
(define tld-t (tld-trunc 'u 'omega))
(sp (make-wff (forall-guarded '(omega cA u) '((IS-SIGMA-ALGEBRA omega cA) (IS-MEASURABLE-FN omega cA u))
   (list 'AND (list 'IS-MEASURABLE-FN 'omega 'cA tld-t) (tld-ptwise 'x 'omega (list 'IN (list tld-t 'x) 'RR))))))
(dk-peel!)
(fact 'sigma-algebra-ambient-set 'omega 'cA)
(dk-cite! 'measurable-fn-in-fun 'omega 'cA 'u)
(fact 'zero-in-rr-pos-star)
(fact 'rr-zero-in)
(let* ((z0 '(VNB-LAMBDA cx_ omega 0))
       (hh (list 'VNB-LAMBDA 'dx_ 'omega (list 'IF '(IN (u dx_) RR) (list '- '(u dx_) (list z0 'dx_)) 0))))
  (fact 'measurable-fn-const 'omega 'cA 0)
  (dk-have! (tld-ptwise 'x 'omega (list '<= (list z0 'x) '(u x)))
    (lambda () (let ((w (dk-di-var!)))
                 (fact 'fun-apply-type-c 'u 'omega 'RR-POS-STAR w)
                 (tld-lb!)
                 (tld-then-ass! (lambda () (fact 'rr-pos-star-nonneg (list 'u w)))))))
  (fact 'measurable-fn-sub 'omega 'cA 'u z0)
  (dk-have! (list 'IN tld-t '(FUN omega RR-POS-STAR))
    (lambda ()
      (dk-lam-type!
        (lambda ()
          (let ((w (dk-di-var!)))
            (fact 'fun-apply-type-c 'u 'omega 'RR-POS-STAR w)
            (tld-lb!)
            (dk-case-if! (tld-ifv 'u w) (lambda (t? v) (if (tld-open?) (ass))))))
        (lambda () (ass)))))
  (dk-have! (tld-ptwise 'x 'omega (list '= (list hh 'x) (list tld-t 'x)))
    (lambda ()
      (let ((w (dk-di-var!)))
        (fact 'fun-apply-type-c 'u 'omega 'RR-POS-STAR w)
        (tld-lb!)
        (dk-case-if! (list 'IF (list 'IN (list 'u w) 'RR) (list '- (list 'u w) 0) 0)
          (lambda (t? v)
            (dk-if-branch! t? (tld-ifv 'u w) #f
              (lambda () (if (tld-open?) (if t? (crs) (rfl))))))))))
  (fact 'measurable-fn-congruence-ptwise 'omega 'cA hh tld-t)
  (dk-have! (tld-ptwise 'x 'omega (list 'IN (list tld-t 'x) 'RR))
    (lambda ()
      (let ((w (dk-di-var!)))
        (fact 'fun-apply-type-c 'u 'omega 'RR-POS-STAR w)
        (tld-lb!)
        (dk-case-if! (tld-ifv 'u w) (lambda (t? v) (if (tld-open?) (ass)))))))
  (dk-conj-close! dk-ass!))
(tld-qed! 'truncate-measurable)

;;; ==========================================================================================
;;; (3) THE SECTION INTEGRAL OF A REAL MEASURABLE FUNCTION IS REAL MEASURABLE
;;; ==========================================================================================
(define tld-u (tld-xsi (list 'POS-PART tld-xy 'f)))
(define tld-v (tld-xsi (list 'NEG-PART tld-xy 'f)))
(define tld-gf (tld-g 'f))
(sp (make-wff (forall-guarded '(xs cA mu ys cB nu f)
   (append tld-meas2 tld-sf2 (list (list 'IS-REAL-MEASURABLE-FN tld-xy tld-ps 'f)))
   (list 'AND (list 'IS-REAL-MEASURABLE-FN 'xs 'cA tld-gf)
     (tld-ptwise 'x 'xs (list 'IMPLIES (list 'IS-INTEGRABLE 'ys 'cB 'nu (tld-fxs 'f 'x))
                             (list '= (list tld-gf 'x) (list 'RINTEGRAL 'ys 'cB 'nu (tld-fxs 'f 'x)))))))))
(dk-peel!)
(tld-base!)
(tld-parts! 'is-real-measurable-fn (list tld-xy tld-ps 'f))
(fact 'rr-zero-in)
(let* ((trs (tld-map
              (lambda (pf)
                (let* ((uu (tld-xsi pf))
                       (fb (dk-cite! 'fubini 'xs 'cA 'mu 'ys 'cB 'nu pf)))
                  (dk-project! (list 'IS-MEASURABLE-FN 'xs 'cA uu) (lambda () (dk-split-all! (list fb))))
                  (dk-split! (dk-cite! 'truncate-measurable 'xs 'cA uu))))
              (list (list 'POS-PART tld-xy 'f) (list 'NEG-PART tld-xy 'f))))
       (ptw-u (find-first (lambda (q) (dk-head-is? q 'FORALL)) (car trs)))
       (ptw-v (find-first (lambda (q) (dk-head-is? q 'FORALL)) (cadr trs)))
       (tu (tld-trunc tld-u 'xs)) (tv (tld-trunc tld-v 'xs)))
  (define (g-real! w)
    (let ((a (dk-apply! ptw-u w)) (b (dk-apply! ptw-v w)))
      (dk-lam-b-h! a) (dk-lam-b-h! b)
      (tld-lb!)
      (tld-then-ass! (lambda () (fact 'rr-sub-in-rr (tld-ifv tld-u w) (tld-ifv tld-v w))))))
  (dk-have! (list 'IN tld-gf '(FUN xs RR))
    (lambda () (dk-lam-type! (lambda () (g-real! (dk-di-var!))) (lambda () (ass)))))
  (dk-have! (tld-ptwise 'x 'xs (list '= (list tld-gf 'x) (list '- (list tu 'x) (list tv 'x))))
    (lambda ()
      (let ((w (dk-di-var!)))
        (let ((a (dk-apply! ptw-u w)) (b (dk-apply! ptw-v w)))
          (dk-lam-b-h! a) (dk-lam-b-h! b)
          (tld-lb!)
          (if (tld-open?) (rfl))))))
  (fact 'pos-part-measurable-of-diff 'xs 'cA tld-gf tu tv)
  (fact 'neg-part-measurable-of-diff 'xs 'cA tld-gf tu tv)
  (dk-have! (list 'IS-REAL-MEASURABLE-FN 'xs 'cA tld-gf)
    (lambda () (mac 'IS-REAL-MEASURABLE-FN) (dk-conj-close! dk-ass!)))
  (dk-have! (tld-ptwise 'x 'xs (list 'IMPLIES (list 'IS-INTEGRABLE 'ys 'cB 'nu (tld-fxs 'f 'x))
                                    (list '= (list tld-gf 'x) (list 'RINTEGRAL 'ys 'cB 'nu (tld-fxs 'f 'x)))))
    (lambda ()
      (let* ((w (dk-di-var!)) (sec (tld-fxs 'f w))
             (ipos (list 'INTEGRAL 'ys 'cB 'nu (list 'POS-PART 'ys sec)))
             (ineg (list 'INTEGRAL 'ys 'cB 'nu (list 'NEG-PART 'ys sec))))
        (di)
        (tld-parts! 'is-integrable (list 'ys 'cB 'nu sec))
        (dk-split! (dk-cite! 'section-parts 'xs 'cA 'ys 'cB 'nu 'f w))
        (dk-have! (list 'IN (list tld-u w) 'RR) (lambda () (subst (list '= (list tld-u w) ipos)) (ass)))
        (dk-have! (list 'IN (list tld-v w) 'RR) (lambda () (subst (list '= (list tld-v w) ineg)) (ass)))
        (tld-lb!)
        (subst (dk-cite! 'rintegral-unfold 'ys 'cB 'nu sec))
        (subst (list '= ipos (list tld-u w)))
        (subst (list '= ineg (list tld-v w)))
        (dk-if-branch! #t (tld-ifv tld-u w) #f
          (lambda ()
            (dk-if-branch! #t (tld-ifv tld-v w) #f
              (lambda () (if (tld-open?) (rfl)))))))))
  (dk-conj-close! dk-ass!))
(tld-qed! 'section-integral-real-measurable)

;;; ==========================================================================================
;;; (4) CAUCHY-SCHWARZ IN L^2, AS INTEGRALS
;;; ==========================================================================================
(define (tld-pr f g om) (list 'VNB-LAMBDA 'lx_ om (list '* (list f 'lx_) (list g 'lx_))))
(sp (make-wff (forall-guarded '(omega cA mu f g) '((IS-MEASURE omega cA mu) (IN f (L2-SET omega cA mu)) (IN g (L2-SET omega cA mu)))
   (list '<= (list '* (list 'RINTEGRAL 'omega 'cA 'mu (tld-pr 'f 'g 'omega)) (list 'RINTEGRAL 'omega 'cA 'mu (tld-pr 'f 'g 'omega)))
             (list '* (list 'RINTEGRAL 'omega 'cA 'mu (tld-pr 'f 'f 'omega)) (list 'RINTEGRAL 'omega 'cA 'mu (tld-pr 'g 'g 'omega)))))))
(dk-peel!)
(let* ((ls '(L2-SPACE omega cA mu))
       (vec (list 'VEC ls)) (rip (list 'RIP ls)))
  (fact 'l2-space-is-sip 'omega 'cA 'mu)
  (dk-cite! 'l2-space-vec 'omega 'cA 'mu)
  (dk-cite! 'l2-space-rip 'omega 'cA 'mu)
  (dk-have! (list 'IN 'f vec) (lambda () (subst (list '= vec '(L2-SET omega cA mu))) (ass)))
  (dk-have! (list 'IN 'g vec) (lambda () (subst (list '= vec '(L2-SET omega cA mu))) (ass)))
  (dk-cite! 'l2-rip-value 'omega 'cA 'mu 'f 'f)
  (dk-cite! 'l2-rip-value 'omega 'cA 'mu 'g 'g)
  (dk-cite! 'l2-rip-value 'omega 'cA 'mu 'f 'g)
  (let* ((cs (dk-cite! 'sip-schwarz ls 'f 'g))
         (c1 (dk-rewrite-h! cs rip '(L2-RIP omega cA mu)))
         (c2 (dk-rewrite-h! c1 '((L2-RIP omega cA mu) f g) (list 'RINTEGRAL 'omega 'cA 'mu (tld-pr 'f 'g 'omega))))
         (c3 (dk-rewrite-h! c2 '((L2-RIP omega cA mu) f f) (list 'RINTEGRAL 'omega 'cA 'mu (tld-pr 'f 'f 'omega))))
         (c4 (dk-rewrite-h! c3 '((L2-RIP omega cA mu) g g) (list 'RINTEGRAL 'omega 'cA 'mu (tld-pr 'g 'g 'omega)))))
    (if (tld-open?) (ass))))
(tld-qed! 'l2-schwarz)
