;;; =====================================================================
;;; (0) file-local kit (the omc- kit of outer-measure-construction.scm).
;;; =====================================================================

(define (mcl-forall! body) (let ((zv (dk-di-var!))) (body zv)))
(define (mcl-and2! p q)
  (dk-have! (list 'AND p q) (lambda () (dk-conj-close! dk-ass!))))
(define (mcl-then-ass! thunk)
  (let ((leaf (proof-state-focus *ps*)))
    (thunk)
    (if (not (sequent-node-grounded? leaf)) (ass))))
(define mcl-mac-heads
  '((intersection-membership . INTERSECTION) (complement-in-membership . COMPLEMENT-IN)
    (union-membership . UNION)))
(define (mcl-has-in-head? x h)
  (and (pair? x)
       (or (and (eq? (car x) 'IN) (pair? (cdr x)) (pair? (cddr x))
                (pair? (caddr x)) (eq? (car (caddr x)) h))
           (let loop ((xs x))
             (and (pair? xs)
                  (or (mcl-has-in-head? (car xs) h) (loop (cdr xs))))))))
(define (mcl-unfold-sets!)
  (let loop ((fuel 12))
    (let ((m (find-first (lambda (p) (mcl-has-in-head? (dk-goal) (cdr p))) mcl-mac-heads)))
      (if (and m (> fuel 0))
          (begin (mac (car m)) (loop (- fuel 1)))))))
;;; dk-project!, except that a claim equal to the focus goal is proved in place
(define (mcl-project! claim opener)
  (if (eq? #t (vnb-guard (lambda () (alpha-equiv? (dk-goal) claim))))
      (let ((leaf (proof-state-focus *ps*)))
        (opener)
        (if (not (sequent-node-grounded? leaf)) (vnb-guard (lambda () (dk-split-all!))))
        (if (not (sequent-node-grounded? leaf)) (ass))
        claim)
      (dk-project! claim opener)))
;;; `prop' on the formulas mentioning the element W (prop's atom cap)
(define (mcl-prop-on! w)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! (filter (lambda (f) (dk-contains? f w)) (dk-asms)))
    (if (not (sequent-node-grounded? leaf)) (prop))))
;;; (SUBSET lhs rhs) by unfolding the set operations and `prop'; PRE (a procedure of
;;; the element, run with (IN w lhs) in context) lands what prop needs
(define (mcl-subset! lhs rhs pre)
  (dk-have! (list 'SUBSET lhs rhs)
    (lambda ()
      (mac 'subset-def)
      (let ((wv (dk-di-var!)))
        (mcl-unfold-sets!)
        (let ((h (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (cadr f) wv) (equal? (caddr f) lhs))) "the element")))
          (pre wv)
          (dk-have! (list 'IMPLIES h (dk-goal))
            (lambda () (mcl-unfold-sets!) (mcl-prop-on! wv)))
          (detach! (list 'IMPLIES h (dk-goal)))
          (ass))))))
;;; class extensionality, the membership iff by unfolding and `prop'
(define (mcl-ext! lhs rhs pre)
  (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ rhs)))
    (lambda ()
      (let ((w (dk-di-var! (lambda (g) (cadr (cadr g))))))
        (mcl-unfold-sets!)
        (pre w)
        (mcl-prop-on! w))))
  (fact 'class-extensionality lhs rhs))
;;; the conjuncts of a predicate's defining iff, landed (hypothesis kept)
(define (mcl-parts! pred args)
  (let* ((iff (apply dk-cite! (cons pred args)))
         (rhs (caddr iff))
         (hyp (cons (string->symbol (string-upcase (symbol->string pred))) args))
         (cs (let loop ((r rhs) (acc '()))
               (if (and (pair? r) (eq? (car r) 'AND))
                   (loop (caddr r) (cons (cadr r) acc))
                   (reverse (cons r acc))))))
    (map (lambda (c) (dk-project! c (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))) cs)))
;;; (IN x (POWER omega)) from (SUBSET x omega), omega in SET in context
(define (mcl-sub-pow! x)
  (if (not (dk-asm? (list 'IN x '(POWER omega))))
      (begin
        (fact 'subclass-of-set-is-set x 'omega)
        (dk-have! (list 'FORALL 'z_ (list 'IMPLIES (list 'IN 'z_ x) '(IN z_ omega)))
          (lambda () (mcl-forall! (lambda (zv) (fact 'subset-mem-fwd x 'omega zv) (ass)))))
        (fact 'power-mem-intro 'omega x))))
;;; (SUBSET x omega) from (IN x (POWER omega))
(define (mcl-pow-sub! x)
  (dk-have! (list 'SUBSET x 'omega)
    (lambda () (mac 'subset-def) (mcl-forall! (lambda (zv) (fact 'power-mem-in 'omega x zv) (ass))))))

;;; =====================================================================
;;; (1) the algebra of sets: projections and the finite unions.
;;; =====================================================================

(define mcl-alg '(IS-ALGEBRA-OF-SETS omega cA))
;;; parts: (0) omega SET (1) cA subset POWER (2) nonempty (3) complement (4) union (5) intersection
(define (mcl-alg-parts!) (mcl-parts! 'is-algebra-of-sets '(omega cA)))

(sp (make-wff (forall-guarded '(omega cA a_) (list mcl-alg '(IN a_ cA))
   '(IN (COMPLEMENT-IN omega a_) cA))))
(dk-peel!)
(dk-apply! (list-ref (mcl-alg-parts!) 3) 'a_)
(ass)
(qed 'algebra-complement-closed)
(topic! 'algebra-complement-closed 'set-quotient)

(sp (make-wff (forall-guarded '(omega cA a_ b_) (list mcl-alg '(IN a_ cA) '(IN b_ cA))
   '(IN (UNION a_ b_) cA))))
(dk-peel!)
(dk-apply! (list-ref (mcl-alg-parts!) 4) 'a_ 'b_)
(ass)
(qed 'algebra-union-closed)
(topic! 'algebra-union-closed 'set-quotient)

(sp (make-wff (forall-guarded '(omega cA a_ b_) (list mcl-alg '(IN a_ cA) '(IN b_ cA))
   '(IN (INTERSECTION a_ b_) cA))))
(dk-peel!)
(dk-apply! (list-ref (mcl-alg-parts!) 5) 'a_ 'b_)
(ass)
(qed 'algebra-inter-closed)
(topic! 'algebra-inter-closed 'set-quotient)

;;; omega and the empty set are members
(sp (make-wff (forall-guarded '(omega cA) (list mcl-alg)
   '(AND (IN omega cA) (IN EMPTY-SET cA)))))
(dk-peel!)
(let* ((parts (mcl-alg-parts!))
       (av (dk-skolem! (list-ref parts 2)))
       (ca (list 'COMPLEMENT-IN 'omega av))
       (u (list 'UNION av ca)))
  (fact 'subset-mem-fwd 'cA '(POWER omega) av)
  (mcl-pow-sub! av)
  (fact 'algebra-complement-closed 'omega 'cA av)
  (fact 'algebra-union-closed 'omega 'cA av ca)
  (mcl-ext! u 'omega (lambda (w) (fact 'subset-mem-fwd av 'omega w)))
  (dk-have! '(IN omega cA) (lambda () (subst (list '= 'omega u)) (ass)))
  (fact 'algebra-complement-closed 'omega 'cA 'omega)
  (fact 'subset-refl 'omega)
  (fact 'complement-in-of-subset-empty 'omega 'omega)
  (dk-have! '(IN EMPTY-SET cA) (lambda () (subst '(= EMPTY-SET (COMPLEMENT-IN omega omega))) (ass)))
  (dk-conj-close! dk-ass!))
(qed 'algebra-whole-empty-in)
(topic! 'algebra-whole-empty-in 'set-quotient)

;;; A_0 u ... u A_{k-1} is in the algebra
(sp (make-wff '(FORALL k (IMPLIES (IN k NN)
   (FORALL omega (FORALL cA (FORALL f
     (IMPLIES (IS-ALGEBRA-OF-SETS omega cA)
       (IMPLIES (IN f (FUN NN cA))
         (IN (BIG-UNION uj_ (ORD-SEGMENT k) (f uj_)) cA))))))))))
(for-each
  (lambda (l)
    (dk-focus! l)
    (if (dk-contains? (dk-goal-of l) '(ORD-SEGMENT 0))
        (begin
          (dk-peel!)
          (let* ((gl (dk-goal)) (bu (cadr gl)) (fv (car (cadddr bu))))
            (fact 'bu-seg-zero fv)
            (subst (list '= bu 'EMPTY-SET))
            (dk-split! (dk-fact! 'algebra-whole-empty-in 'omega 'cA))
            (ass)))
        (let* ((landed (dk-landed (lambda () (di))))
               (nin (find-first (lambda (f) (and (pair? f) (eq? (car f) 'IN) (eq? (caddr f) 'NN))) landed))
               (kv (cadr nin))
               (ih (dk-landed-1 (lambda () (di))))
               (_ (dk-peel!))
               (gl (dk-goal)) (bu (cadr gl)) (fv (car (cadddr bu)))
               (bk (list 'BIG-UNION (cadr bu) (list 'ORD-SEGMENT kv) (cadddr bu))))
          (fact 'bu-seg-succ kv 'cA fv)
          (subst (list '= bu (list 'UNION bk (list fv kv))))
          (dk-apply! ih 'omega 'cA fv)
          (fact 'fun-apply-type-c fv 'NN 'cA kv)
          (fact 'algebra-union-closed 'omega 'cA bk (list fv kv))
          (ass))))
  (dk-opened (lambda () (ni))))
(qed 'algebra-seg-union-in)
(topic! 'algebra-seg-union-in 'set-quotient)

;;; =====================================================================
;;; (2) PROPOSITION 1.11: an algebra closed under countable monotone unions is a
;;;     sigma-algebra.  B_n = A_0 u ... u A_{n-1} is nondecreasing, in the
;;;     algebra, and has the union of the A_n as its union.
;;; =====================================================================

(sp (make-wff (forall-guarded '(omega cA)
   (list mcl-alg
         '(FORALL mcf_ (IMPLIES (IN mcf_ (FUN NN cA))
            (IMPLIES (FORALL mcn_ (IMPLIES (IN mcn_ NN) (SUBSET (mcf_ mcn_) (mcf_ (succ mcn_)))))
                     (IN (BIG-UNION mck_ NN (mcf_ mck_)) cA)))))
   '(IS-SIGMA-ALGEBRA omega cA))))
(dk-peel!)
(let* ((parts (mcl-alg-parts!))
       (mono (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'succ))) "monotone unions")))
  (dk-split! (dk-fact! 'algebra-whole-empty-in 'omega 'cA))
  (mac 'IS-SIGMA-ALGEBRA)
  (dk-conj-close!
    (lambda ()
      (cond ((dk-ass!) #t)
            ((dk-contains? (dk-goal) 'BIG-UNION)
             (let* ((fv (dk-di-var!))
                    (bl (list 'VNB-LAMBDA 'obn_ 'NN (list 'BIG-UNION 'uj_ '(ORD-SEGMENT obn_) (list fv 'uj_))))
                    (bseg (lambda (k) (list 'BIG-UNION 'uj_ (list 'ORD-SEGMENT k) (list fv 'uj_))))
                    (bub (list 'BIG-UNION 'mck_ 'NN (list bl 'mck_)))
                    (buf (list 'BIG-UNION 'n_ 'NN (list fv 'n_))))
               (dk-have! (list 'IN bl '(FUN NN cA))
                 (lambda () (dk-lam-type! (lambda () (let ((kv (cadr (car (dk-peel!)))))
                                                       (mcl-then-ass! (lambda () (fact 'algebra-seg-union-in kv 'omega 'cA fv))))))))
               (dk-have! (list 'FORALL 'mcn_ (list 'IMPLIES '(IN mcn_ NN) (list 'SUBSET (list bl 'mcn_) (list bl '(succ mcn_)))))
                 (lambda ()
                   (let ((nv (dk-di-var!)))
                     (fact 'nn-succ-closed nv)
                     (dk-lam-b!)
                     (fact 'bu-seg-succ nv 'cA fv)
                     (subst (list '= (bseg (list 'succ nv)) (list 'UNION (bseg nv) (list fv nv))))
                     (mcl-then-ass! (lambda () (mcl-subset! (bseg nv) (list 'UNION (bseg nv) (list fv nv)) (lambda (w) #t)))))))
               (dk-apply! mono bl)
               ;; the two unions agree
               (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ bub) (list 'IN 'w_ buf)))
                 (lambda ()
                   (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
                     (for-each
                       (lambda (l)
                         (dk-focus! l)
                         (if (equal? (dk-goal) (list 'IN wv buf))
                             (let* ((l1 (dk-landed (lambda () (bu-me (list 'IN wv bub)))))
                                    (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) l1))
                                    (ev (cadr ein))
                                    (app (find-first (lambda (f) (not (eq? f ein))) l1)))
                               (fact 'algebra-seg-union-in ev 'omega 'cA fv)
                               (fact 'membership-implies-sethood (bseg ev) 'cA)
                               (dk-lam-b-h! app)
                               (let* ((l2 (dk-landed (lambda () (bu-me (list 'IN wv (bseg ev))))))
                                      (jin (find-first (lambda (f) (and (dk-head-is? f 'IN) (not (eq? (cadr f) wv)))) l2))
                                      (jv (cadr jin)))
                                 (fact 'ord-segment-nn-subset ev jv)
                                 (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
                                           (dk-opened (lambda () (bu-mi jv))))))
                             (let* ((l1 (dk-landed (lambda () (bu-me (list 'IN wv buf)))))
                                    (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) l1))
                                    (kv (cadr ein))
                                    (sk (list 'succ kv)))
                               (fact 'nn-succ-closed kv)
                               (fact 'algebra-seg-union-in sk 'omega 'cA fv)
                               (fact 'membership-implies-sethood (bseg sk) 'cA)
                               (fact 'bu-seg-succ kv 'cA fv)
                               (for-each (lambda (n)
                                           (if (not (sequent-node-grounded? n))
                                               (begin
                                                 (dk-focus! n)
                                                 (if (equal? (dk-goal) (list 'IN sk 'NN))
                                                     (ass)
                                                     (begin
                                                       (dk-lam-b!)
                                                       (subst (list '= (bseg sk) (list 'UNION (bseg kv) (list fv kv))))
                                                       (mac 'union-membership)
                                                       (oi-r)
                                                       (ass))))))
                                         (dk-opened (lambda () (bu-mi sk)))))))
                       (dk-opened (lambda () (di)))))))
               (fact 'class-extensionality bub buf)
               (mcl-then-ass! (lambda () (subst (list '= buf bub))))))
            ((dk-head-is? (dk-goal) 'FORALL)
             (let ((av (dk-di-var!)))
               (fact 'algebra-complement-closed 'omega 'cA av)
               (ass)))
            (#t (ass))))))
(qed 'algebra-monotone-union-sigma-algebra)
(topic! 'algebra-monotone-union-sigma-algebra 'set-quotient)
(gloss! 'algebra-monotone-union-sigma-algebra
  "Thayer, Construction of Measures, Prop. 1.11 (p. 2): an algebra of subsets of X
   which is closed under the union of every nondecreasing sequence of its members is a
   sigma-algebra.")

;;; =====================================================================
;;; (3) MONOTONE-CLASS-GENERATED: membership, and it is a monotone class.
;;; =====================================================================

(define mcl-mcg '(MONOTONE-CLASS-GENERATED omega cE))
(define mcl-mcg-body
  '(SEP mca_ (POWER omega)
     (FORALL mcb_ (IMPLIES (AND (IS-MONOTONE-CLASS omega mcb_) (SUBSET cE mcb_)) (IN mca_ mcb_)))))
(sp (make-wff (list 'FORALL 'omega (list 'FORALL 'cE (list '== mcl-mcg mcl-mcg-body)))))
(di)
(mac 'MONOTONE-CLASS-GENERATED)
(qrfl)
(qed 'monotone-class-generated-unfold)
(topic! 'monotone-class-generated-unfold 'plumbing)

(sp (make-wff '(FORALL omega (FORALL cE (FORALL a_
   (IFF (IN a_ (MONOTONE-CLASS-GENERATED omega cE))
        (AND (IN a_ (POWER omega))
             (FORALL mcb_ (IMPLIES (AND (IS-MONOTONE-CLASS omega mcb_) (SUBSET cE mcb_)) (IN a_ mcb_))))))))))
(di)
(dk-iff! (lambda (g) (dk-head-is? g 'AND))
  (lambda ()
    (mac-h 'monotone-class-generated-unfold '(IN a_ (MONOTONE-CLASS-GENERATED omega cE)))
    (sep-me (dk-pick (lambda (f) (and (dk-head-is? f 'IN) (eq? (cadr f) 'a_))) "the SEP membership"))
    (dk-split-all!)
    (dk-conj-close! dk-ass!))
  (lambda ()
    (dk-split-all!)
    (mac 'MONOTONE-CLASS-GENERATED)
    (in-sep! dk-ass! dk-ass!)))
(qed 'monotone-class-generated-membership)
(topic! 'monotone-class-generated-membership 'set-quotient)

;;; the read-offs
(define (mcl-mcg-open! a)
  (let ((iff (dk-cite! 'monotone-class-generated-membership 'omega 'cE a)))
    (list (dk-project! (list 'IN a '(POWER omega)) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!)))
          (dk-project! (caddr (caddr iff)) (lambda () (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!))))))
;;; a in MCG, B a monotone class containing cE: a in B
(define (mcl-mcg-in! a b)
  (let ((every (cadr (mcl-mcg-open! a))))
    (mcl-and2! (list 'IS-MONOTONE-CLASS 'omega b) (list 'SUBSET 'cE b))
    (dk-apply! every b)))
;;; prove the focus goal (IN a MCG): POW proves (IN a (POWER omega)); EVERY, a procedure of
;;; the eigenvariable B, proves (IN a B) from (IS-MONOTONE-CLASS omega B), (SUBSET cE B)
(define (mcl-into-mcg! pow every)
  (mac 'monotone-class-generated-membership)
  (dk-conj-close!
    (lambda ()
      (if (dk-head-is? (dk-goal) 'IN)
          (pow)
          (let* ((landed (dk-peel!))
                 (cj (find-first (lambda (f) (dk-head-is? f 'AND)) landed))
                 (bv (caddr (cadr cj))))
            (dk-split! cj)
            (every bv))))))

;;; the four conjuncts of IS-MONOTONE-CLASS(omega, M): SET, inside POWER, unions, intersections
(define (mcl-mc-parts! m) (mcl-parts! 'is-monotone-class (list 'omega m)))

;;; f in FUN(NN, A) and every f(k) in B: f in FUN(NN, B)
(define (mcl-retype! fv a b in-b!)
  (dk-have! (list 'IN fv (list 'FUN 'NN b))
    (lambda ()
      (mac 'fun-codomain-iff)
      (dk-conj-close!
        (lambda ()
          (if (dk-head-is? (dk-goal) 'FORALL)
              (let ((kv (dk-di-var!)))
                (fact 'fun-apply-type-c fv 'NN a kv)
                (mcl-then-ass! (lambda () (in-b! (list fv kv)))))
              (begin
                (dk-split! (dk-landed-1 (lambda () (mac-h 'fun-codomain-iff (list 'IN fv (list 'FUN 'NN a))))))
                (ass))))))))

(sp (make-wff (forall-guarded '(omega cE) '((IN omega SET) (SUBSET cE (POWER omega)))
   '(IS-MONOTONE-CLASS omega (MONOTONE-CLASS-GENERATED omega cE)))))
(dk-peel!)
(mac 'IS-MONOTONE-CLASS)
(dk-conj-close!
  (lambda ()
    (let ((g (dk-goal)))
      (cond ((dk-ass!) #t)
            ((dk-head-is? g 'SUBSET)
             (mac 'subset-def)
             (mcl-forall! (lambda (zv)
                            (let ((iff (dk-cite! 'monotone-class-generated-membership 'omega 'cE zv)))
                              (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!) (ass)))))
            (#t
             (let* ((landed (dk-peel!))
                    (inter? (dk-head-is? (cadr (dk-goal)) 'COMPLEMENT-IN))
                    (fv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (dk-head-is? (caddr f) 'FUN))) landed)))
                    (mon (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed))
                    (tgt (cadr (dk-goal))))
               ;; the target is a subset of omega
               (mcl-retype! fv mcl-mcg '(POWER omega)
                 (lambda (x) (let ((iff (dk-cite! 'monotone-class-generated-membership 'omega 'cE x)))
                               (ai iff) (detach! (list 'IMPLIES (cadr iff) (caddr iff))) (dk-split-all!))))
               (if inter?
                   (fact 'power-complement-closed 'omega (caddr tgt))
                   (fact 'power-fun-union-closed 'omega fv))
               (mcl-into-mcg!
                 (lambda () (ass))
                 (lambda (bv)
                   (let ((parts (mcl-mc-parts! bv)))
                     (mcl-retype! fv mcl-mcg bv (lambda (x) (mcl-mcg-in! x bv)))
                     (dk-apply! (list-ref parts (if inter? 3 2)) fv)
                     (ass))))))))))
(qed 'monotone-class-generated-is-monotone-class)
(topic! 'monotone-class-generated-is-monotone-class 'set-quotient)

;;; =====================================================================
;;; (4) the two sections of a monotone class are monotone classes (the sets
;;;     A_D of eq. (2) and A' of eq. (4) in the proof of Thm. 1.13).
;;; =====================================================================

;;; dk-abstract! with a PRE run in the value lane on the index (to land the
;;; sethood of the value, which beta owes): returns (G . VALUE-EQUATION)
(define (mcl-abstract! dom cod body-of typer pre)
  (let* ((body  (body-of 'mlak_))
         (lam   (list 'VNB-LAMBDA 'mlak_ dom body))
         (vals  (lambda (g) (list 'FORALL 'mlak_ (list 'IMPLIES (list 'IN 'mlak_ dom)
                                                    (list '== (list g 'mlak_) body)))))
         (claim (list 'FORSOME 'mlag_ (list 'AND (list 'IN 'mlag_ (list 'FUN dom cod))
                                            (vals 'mlag_)))))
    (dk-have! claim
      (lambda ()
        (ew lam)
        (dk-conj-close!
          (lambda ()
            (if (dk-head-is? (dk-goal) 'IN)
                (dk-lam-type! (lambda () (typer (dk-di-var!))))
                (let ((kv (dk-di-var!)))
                  (pre kv)
                  (if (not (dk-lam-b!)) (qrfl))))))))
    (let* ((g  (dk-skolem! (or (dk-ctx-form claim)
                               (error "mcl-abstract!: the existential did not land"))))
           (ve (or (dk-ctx-form (vals g))
                   (error "mcl-abstract!: the value equation did not land"))))
      (cons g ve))))

;;; w in BIG-UNION(n_, NN, g(n_)) gives the index and w in g(index): returns (k . formula)
(define (mcl-bu-open! w bu)
  (let* ((landed (dk-landed (lambda () (bu-me (list 'IN w bu)))))
         (ein (find-first (lambda (f) (and (dk-head-is? f 'IN) (eq? (caddr f) 'NN))) landed))
         (app (find-first (lambda (f) (not (eq? f ein))) landed)))
    (cons (cadr ein) app)))
;;; prove the focus goal (IN w bu) at the index k (w in the k-th term in context)
(define (mcl-bu-close! k)
  (for-each (lambda (n) (if (not (sequent-node-grounded? n)) (begin (dk-focus! n) (ass))))
            (dk-opened (lambda () (bu-mi k)))))


;;; the membership iffs at w, as facts
(define (mcl-cin! a b w) (fact 'complement-in-membership a b w))
(define (mcl-uni! a b w) (fact 'union-membership a b w))
(define (mcl-buf fv) (list 'BIG-UNION 'mcj_ 'NN (list 'COMPLEMENT-IN 'omega (list fv 'mcj_))))
(define (mcl-int fv) (list 'COMPLEMENT-IN 'omega (mcl-buf fv)))
(define (mcl-bun fv) (list 'BIG-UNION 'mck_ 'NN (list fv 'mck_)))

;;; union clause of the union section: D u U f = U g
(define (mcl-union-section-union! fv gv gk! tgt)
  (let* ((sec (lambda (x) (list 'UNION 'dd x)))
         (bug (mcl-bun gv)))
    (fact 'power-fun-union-closed 'omega fv)
    (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ (sec tgt)) (list 'IN 'w_ bug)))
      (lambda ()
        (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
          (dk-iff! (lambda (g) (equal? g (list 'IN wv bug)))
            (lambda ()
              (mcl-uni! 'dd tgt wv)
              (use-em (list 'IN wv 'dd)
                (lambda ()
                  (fact 'nn-zero-in)
                  (gk! 0)
                  (mcl-uni! 'dd (list fv 0) wv)
                  (dk-have! (list 'IN wv (list gv 0))
                    (lambda () (subst (list '= (list gv 0) (sec (list fv 0)))) (mcl-prop-on! wv)))
                  (mcl-bu-close! 0))
                (lambda ()
                  (dk-have! (list 'IN wv tgt) (lambda () (mcl-prop-on! wv)))
                  (let* ((r (mcl-bu-open! wv tgt)) (kv (car r)))
                    (gk! kv)
                    (mcl-uni! 'dd (list fv kv) wv)
                    (dk-have! (list 'IN wv (list gv kv))
                      (lambda () (subst (list '= (list gv kv) (sec (list fv kv)))) (mcl-prop-on! wv)))
                    (mcl-bu-close! kv)))))
            (lambda ()
              (let* ((r (mcl-bu-open! wv bug)) (kv (car r)))
                (gk! kv)
                (dk-rewrite-h! (cdr r) (list gv kv) (sec (list fv kv)))
                (mcl-uni! 'dd (list fv kv) wv)
                (mcl-uni! 'dd tgt wv)
                (dk-have! (list 'IMPLIES (list 'IN wv (list fv kv)) (list 'IN wv tgt))
                  (lambda () (di) (mcl-bu-close! kv)))
                (mcl-prop-on! wv)))))))
    (fact 'class-extensionality (sec tgt) bug)
    (in-sep! dk-ass! (lambda () (mcl-then-ass! (lambda () (subst (list '= (sec tgt) bug))))))))

;;; intersection clause of the union section: D u I f = I g
(define (mcl-prop-with! fs)
  (let ((leaf (proof-state-focus *ps*)))
    (apply dk-only! fs)
    (if (not (sequent-node-grounded? leaf)) (prop))))
(define (mcl-union-section-inter! fv gv gk! tgt)
  (let* ((sec (lambda (x) (list 'UNION 'dd x)))
         (buf (mcl-buf fv)) (bug (mcl-buf gv)) (big (mcl-int gv)))
    (fact 'power-complement-closed 'omega buf)
    (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ (sec tgt)) (list 'IN 'w_ big)))
      (lambda ()
        (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
          (dk-iff! (lambda (g) (equal? g (list 'IN wv big)))
            (lambda ()
              (let* ((h0 (list 'IN wv (sec tgt)))
                     (u1 (dk-cite! 'union-membership 'dd tgt wv))
                     (c1 (dk-cite! 'complement-in-membership 'omega buf wv))
                     (c2 (dk-cite! 'complement-in-membership 'omega bug wv))
                     (s1 (begin (fact 'subset-mem-fwd 'dd 'omega wv)
                                (or (dk-ctx-form (list 'IMPLIES (list 'IN wv 'dd) (list 'IN wv 'omega)))
                                    (error "mcl: subset-mem-fwd")))))
                (dk-have! (list 'NOT (list 'IN wv bug))
                  (lambda ()
                    (di)
                    (let* ((r (mcl-bu-open! wv bug)) (kv (car r)) (fk (list fv kv)))
                      (gk! kv)
                      (let* ((h1 (dk-rewrite-h! (cdr r) (list gv kv) (sec fk)))
                             (c3 (dk-cite! 'complement-in-membership 'omega (sec fk) wv))
                             (u2 (dk-cite! 'union-membership 'dd fk wv))
                             (c4 (dk-cite! 'complement-in-membership 'omega fk wv))
                             (im (list 'IMPLIES (list 'IN wv (list 'COMPLEMENT-IN 'omega fk)) (list 'IN wv buf))))
                        (dk-have! im (lambda () (di) (mcl-bu-close! kv)))
                        (mcl-prop-with! (list h0 u1 c1 s1 h1 c3 u2 c4 im))))))
                (mcl-prop-with! (list h0 u1 c1 c2 s1 (list 'NOT (list 'IN wv bug))))))
            (lambda ()
              (let* ((h0 (list 'IN wv big))
                     (u1 (dk-cite! 'union-membership 'dd tgt wv))
                     (c1 (dk-cite! 'complement-in-membership 'omega buf wv))
                     (c2 (dk-cite! 'complement-in-membership 'omega bug wv))
                     (nn (list 'IMPLIES (list 'NOT (list 'IN wv 'dd)) (list 'NOT (list 'IN wv buf)))))
                (dk-have! nn
                  (lambda ()
                    (di) (di)
                    (let* ((r (mcl-bu-open! wv buf)) (kv (car r)) (fk (list fv kv)))
                      (gk! kv)
                      (let* ((c3 (dk-cite! 'complement-in-membership 'omega fk wv))
                             (u2 (dk-cite! 'union-membership 'dd fk wv))
                             (c4 (dk-cite! 'complement-in-membership 'omega (sec fk) wv))
                             (im (list 'IMPLIES (list 'IN wv (list 'COMPLEMENT-IN 'omega (sec fk))) (list 'IN wv bug))))
                        (dk-have! im
                          (lambda ()
                            (let ((h (dk-landed-1 (lambda () (di)))))
                              (dk-rewrite-h! h (sec fk) (list gv kv))
                              (mcl-bu-close! kv))))
                        (mcl-prop-with! (list h0 c2 (cdr r) (list 'NOT (list 'IN wv 'dd)) c3 u2 c4 im))))))
                (mcl-prop-with! (list h0 u1 c1 c2 nn))))))))
    (fact 'class-extensionality (sec tgt) big)
    (in-sep! dk-ass! (lambda () (mcl-then-ass! (lambda () (subst (list '= (sec tgt) big))))))))

;;; the union section: E |-> D u E pulls a monotone class back to a monotone class
(define mcl-ad '(SEP mde_ (POWER omega) (IN (UNION dd mde_) mm)))
(sp (make-wff (forall-guarded '(omega mm dd) '((IS-MONOTONE-CLASS omega mm) (IN dd (POWER omega)))
   (list 'IS-MONOTONE-CLASS 'omega mcl-ad))))
(dk-peel!)
(let* ((parts (mcl-mc-parts! 'mm))
       (ad mcl-ad)
       (sec (lambda (x) (list 'UNION 'dd x)))
       ;; x in A_D gives x in POWER(omega) and D u x in mm
       (ad-open! (lambda (x)
                   (let ((m (or (dk-ctx-form (list 'IN x ad)) (error "ad-open!: not in context" x))))
                     (mcl-project! (list 'IN x '(POWER omega)) (lambda () (sep-me m) (dk-split-all!)))
                     (mcl-project! (list 'IN (sec x) 'mm) (lambda () (sep-me m) (dk-split-all!)))))))
  (mcl-pow-sub! 'dd)
  (mac 'IS-MONOTONE-CLASS)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-ass!) #t)
              ((dk-head-is? g 'SUBSET)
               (mac 'subset-def)
               (mcl-forall! (lambda (zv) (sep-me (list 'IN zv ad)) (dk-split-all!) (ass))))
              (#t
               (let* ((landed (dk-peel!))
                      (inter? (dk-head-is? (cadr (dk-goal)) 'COMPLEMENT-IN))
                      (fv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (dk-head-is? (caddr f) 'FUN))) landed)))
                      (mon (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed))
                      (tgt (cadr (dk-goal)))
                      (fk! (lambda (kv) (fact 'fun-apply-type-c fv 'NN ad kv) (ad-open! (list fv kv))))
                      (gr (mcl-abstract! 'NN 'mm (lambda (k) (sec (list fv k)))
                            (lambda (kv) (mcl-then-ass! (lambda () (fk! kv))))
                            (lambda (kv) (fk! kv) (fact 'membership-implies-sethood (sec (list fv kv)) 'mm))))
                      (gv (car gr)) (ge (cdr gr))
                      (gk! (lambda (kv) (fk! kv) (dk-apply! ge kv)
                              (list '== (list gv kv) (sec (list fv kv))))))
                 (mcl-retype! fv ad '(POWER omega)
                   (lambda (x) (mcl-project! (list 'IN x '(POWER omega))
                                 (lambda () (sep-me (dk-ctx-form (list 'IN x ad))) (dk-split-all!)))))
                 ;; g is monotone in the same sense as f
                 (dk-have! (list 'FORALL 'mcn_ (list 'IMPLIES '(IN mcn_ NN)
                             (if inter?
                                 (list 'SUBSET (list gv '(succ mcn_)) (list gv 'mcn_))
                                 (list 'SUBSET (list gv 'mcn_) (list gv '(succ mcn_))))))
                   (lambda ()
                     (let* ((nv (dk-di-var!)) (sn (list 'succ nv)))
                       (fact 'nn-succ-closed nv)
                       (gk! nv) (gk! sn)
                       (dk-apply! mon nv)
                       (subst (list '= (list gv nv) (sec (list fv nv))))
                       (subst (list '= (list gv sn) (sec (list fv sn))))
                       (mcl-then-ass! (lambda () (if inter?
                           (mcl-subset! (sec (list fv sn)) (sec (list fv nv)) (lambda (w) (fact 'subset-mem-fwd (list fv sn) (list fv nv) w)))
                           (mcl-subset! (sec (list fv nv)) (sec (list fv sn)) (lambda (w) (fact 'subset-mem-fwd (list fv nv) (list fv sn) w)))))))))
                 (dk-apply! (list-ref parts (if inter? 3 2)) gv)
                 (if inter?
                     (mcl-union-section-inter! fv gv gk! tgt)
                     (mcl-union-section-union! fv gv gk! tgt)))))))))
(qed 'monotone-class-union-section)
(topic! 'monotone-class-union-section 'set-quotient)

;;; the complement section: E |-> omega \ E pulls a monotone class back to a monotone class
(define mcl-ac '(SEP mdc_ (POWER omega) (IN (COMPLEMENT-IN omega mdc_) mm)))

;;; union clause: omega \ U f = I g, g(k) = omega \ f(k)
(define (mcl-comp-section-union! fv gv gk! tgt)
  (let* ((cpl (lambda (x) (list 'COMPLEMENT-IN 'omega x)))
         (bug (mcl-buf gv)) (big (mcl-int gv)) (lhs (cpl tgt)))
    (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ big)))
      (lambda ()
        (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
          (dk-iff! (lambda (g) (equal? g (list 'IN wv big)))
            (lambda ()
              (let* ((h0 (list 'IN wv lhs))
                     (c1 (dk-cite! 'complement-in-membership 'omega tgt wv))
                     (c2 (dk-cite! 'complement-in-membership 'omega bug wv))
                     (nb (list 'NOT (list 'IN wv bug))))
                (dk-have! nb
                  (lambda ()
                    (di)
                    (let* ((r (mcl-bu-open! wv bug)) (kv (car r)) (fk (list fv kv)))
                      (gk! kv)
                      (let* ((h1 (dk-rewrite-h! (cdr r) (list gv kv) (cpl fk)))
                             (c3 (dk-cite! 'complement-in-membership 'omega (cpl fk) wv))
                             (c4 (dk-cite! 'complement-in-membership 'omega fk wv))
                             (im (list 'IMPLIES (list 'IN wv fk) (list 'IN wv tgt))))
                        (dk-have! im (lambda () (di) (mcl-bu-close! kv)))
                        (mcl-prop-with! (list h0 c1 h1 c3 c4 im))))))
                (mcl-prop-with! (list h0 c1 c2 nb))))
            (lambda ()
              (let* ((h0 (list 'IN wv big))
                     (c1 (dk-cite! 'complement-in-membership 'omega tgt wv))
                     (c2 (dk-cite! 'complement-in-membership 'omega bug wv))
                     (nt (list 'IMPLIES (list 'IN wv 'omega) (list 'NOT (list 'IN wv tgt)))))
                (dk-have! nt
                  (lambda ()
                    (di) (di)
                    (let* ((r (mcl-bu-open! wv tgt)) (kv (car r)) (fk (list fv kv)))
                      (gk! kv)
                      (let* ((c3 (dk-cite! 'complement-in-membership 'omega fk wv))
                             (c4 (dk-cite! 'complement-in-membership 'omega (cpl fk) wv))
                             (im (list 'IMPLIES (list 'IN wv (list 'COMPLEMENT-IN 'omega (cpl fk))) (list 'IN wv bug))))
                        (dk-have! im
                          (lambda ()
                            (let ((h (dk-landed-1 (lambda () (di)))))
                              (dk-rewrite-h! h (cpl fk) (list gv kv))
                              (mcl-bu-close! kv))))
                        (mcl-prop-with! (list h0 c2 (cdr r) (list 'IN wv 'omega) c3 c4 im))))))
                (mcl-prop-with! (list h0 c1 c2 nt))))))))
    (fact 'class-extensionality lhs big)
    (in-sep! dk-ass! (lambda () (mcl-then-ass! (lambda () (subst (list '= lhs big))))))))

;;; intersection clause: omega \ I f = U g, g(k) = omega \ f(k)
(define (mcl-comp-section-inter! fv gv gk! tgt)
  (let* ((cpl (lambda (x) (list 'COMPLEMENT-IN 'omega x)))
         (buf (mcl-buf fv)) (bug (mcl-bun gv)) (lhs (cpl tgt)))
    (dk-have! (list 'FORALL 'w_ (list 'IFF (list 'IN 'w_ lhs) (list 'IN 'w_ bug)))
      (lambda ()
        (let ((wv (dk-di-var! (lambda (g) (cadr (cadr g))))))
          (dk-iff! (lambda (g) (equal? g (list 'IN wv bug)))
            (lambda ()
              (let* ((h0 (list 'IN wv lhs))
                     (c1 (dk-cite! 'complement-in-membership 'omega tgt wv))
                     (c2 (dk-cite! 'complement-in-membership 'omega buf wv))
                     (ib (list 'IN wv buf)))
                (dk-have! ib (lambda () (mcl-prop-with! (list h0 c1 c2))))
                (let* ((r (mcl-bu-open! wv buf)) (kv (car r)) (fk (list fv kv)))
                  (gk! kv)
                  (dk-have! (list 'IN wv (list gv kv))
                    (lambda () (subst (list '= (list gv kv) (cpl fk))) (ass)))
                  (mcl-bu-close! kv))))
            (lambda ()
              (let* ((r (mcl-bu-open! wv bug)) (kv (car r)) (fk (list fv kv)))
                (gk! kv)
                (let* ((h1 (dk-rewrite-h! (cdr r) (list gv kv) (cpl fk)))
                       (c1 (dk-cite! 'complement-in-membership 'omega tgt wv))
                       (c2 (dk-cite! 'complement-in-membership 'omega buf wv))
                       (c3 (dk-cite! 'complement-in-membership 'omega fk wv))
                       (ib (list 'IN wv buf)))
                  (dk-have! ib (lambda () (mcl-bu-close! kv)))
                  (mcl-prop-with! (list h1 c1 c2 c3 ib)))))))))
    (fact 'class-extensionality lhs bug)
    (in-sep! dk-ass! (lambda () (mcl-then-ass! (lambda () (subst (list '= lhs bug))))))))

(sp (make-wff (forall-guarded '(omega mm) '((IS-MONOTONE-CLASS omega mm))
   (list 'IS-MONOTONE-CLASS 'omega mcl-ac))))
(dk-peel!)
(let* ((parts (mcl-mc-parts! 'mm))
       (ac mcl-ac)
       (cpl (lambda (x) (list 'COMPLEMENT-IN 'omega x)))
       (ac-open! (lambda (x)
                   (let ((m (or (dk-ctx-form (list 'IN x ac)) (error "ac-open!: not in context" x))))
                     (mcl-project! (list 'IN x '(POWER omega)) (lambda () (sep-me m) (dk-split-all!)))
                     (mcl-project! (list 'IN (cpl x) 'mm) (lambda () (sep-me m) (dk-split-all!)))))))
  (mac 'IS-MONOTONE-CLASS)
  (dk-conj-close!
    (lambda ()
      (let ((g (dk-goal)))
        (cond ((dk-ass!) #t)
              ((dk-head-is? g 'SUBSET)
               (mac 'subset-def)
               (mcl-forall! (lambda (zv) (sep-me (list 'IN zv ac)) (dk-split-all!) (ass))))
              (#t
               (let* ((landed (dk-peel!))
                      (inter? (dk-head-is? (cadr (dk-goal)) 'COMPLEMENT-IN))
                      (fv (cadr (find-first (lambda (f) (and (dk-head-is? f 'IN) (pair? (caddr f)) (dk-head-is? (caddr f) 'FUN))) landed)))
                      (mon (find-first (lambda (f) (dk-head-is? f 'FORALL)) landed))
                      (tgt (cadr (dk-goal)))
                      (fk! (lambda (kv) (fact 'fun-apply-type-c fv 'NN ac kv) (ac-open! (list fv kv))))
                      (gr (mcl-abstract! 'NN 'mm (lambda (k) (cpl (list fv k)))
                            (lambda (kv) (mcl-then-ass! (lambda () (fk! kv))))
                            (lambda (kv) (fk! kv) (fact 'membership-implies-sethood (cpl (list fv kv)) 'mm))))
                      (gv (car gr)) (ge (cdr gr))
                      (gk! (lambda (kv) (fk! kv) (dk-apply! ge kv))))
                 (mcl-retype! fv ac '(POWER omega)
                   (lambda (x) (mcl-project! (list 'IN x '(POWER omega))
                                 (lambda () (sep-me (dk-ctx-form (list 'IN x ac))) (dk-split-all!)))))
                 ;; g is monotone in the opposite sense to f
                 (dk-have! (list 'FORALL 'mcn_ (list 'IMPLIES '(IN mcn_ NN)
                             (if inter?
                                 (list 'SUBSET (list gv 'mcn_) (list gv '(succ mcn_)))
                                 (list 'SUBSET (list gv '(succ mcn_)) (list gv 'mcn_)))))
                   (lambda ()
                     (let* ((nv (dk-di-var!)) (sn (list 'succ nv)))
                       (fact 'nn-succ-closed nv)
                       (gk! nv) (gk! sn)
                       (dk-apply! mon nv)
                       (subst (list '= (list gv nv) (cpl (list fv nv))))
                       (subst (list '= (list gv sn) (cpl (list fv sn))))
                       (mcl-then-ass! (lambda () (if inter?
                           (mcl-subset! (cpl (list fv nv)) (cpl (list fv sn)) (lambda (w) (fact 'subset-mem-fwd (list fv sn) (list fv nv) w)))
                           (mcl-subset! (cpl (list fv sn)) (cpl (list fv nv)) (lambda (w) (fact 'subset-mem-fwd (list fv nv) (list fv sn) w)))))))))
                 (dk-apply! (list-ref parts (if inter? 2 3)) gv)
                 (if inter?
                     (begin (fact 'power-complement-closed 'omega (mcl-buf fv))
                            (mcl-comp-section-inter! fv gv gk! tgt))
                     (begin (fact 'power-fun-union-closed 'omega fv)
                            (mcl-comp-section-union! fv gv gk! tgt))))))))))
(qed 'monotone-class-complement-section)
(topic! 'monotone-class-complement-section 'set-quotient)

;;; =====================================================================
;;; (5) THEOREM 1.13 (the monotone class theorem).  The smallest monotone
;;;     class A_M containing the algebra is closed under unions (the sections
;;;     A_D, eq. (2)) and complements (the section A', eq. (4)), hence is an
;;;     algebra, hence (Prop. 1.11) a sigma-algebra.
;;; =====================================================================

(define mcl-am '(MONOTONE-CLASS-GENERATED omega cE))
(define (mcl-sec-u d) (list 'SEP 'mde_ '(POWER omega) (list 'IN (list 'UNION d 'mde_) mcl-am)))
(define mcl-sec-c (list 'SEP 'mdc_ '(POWER omega) (list 'IN '(COMPLEMENT-IN omega mdc_) mcl-am)))
;;; x in AM gives x in POWER(omega)
(define (mcl-am-pow! x) (car (mcl-mcg-open! x)))
;;; cE inside the section S: (SUBSET cE S), PROP-OF proving its SEP condition at the element
(define (mcl-ce-into-sec! sec prop-of)
  (dk-have! (list 'SUBSET 'cE sec)
    (lambda ()
      (mac 'subset-def)
      (mcl-forall!
        (lambda (ev)
          (fact 'subset-mem-fwd 'cE '(POWER omega) ev)
          (in-sep! dk-ass! (lambda () (prop-of ev))))))))
;;; x in a section, read off its SEP condition
(define (mcl-sec-read! x sec cond)
  (mcl-project! cond (lambda () (sep-me (dk-ctx-form (list 'IN x sec))) (dk-split-all!))))

(sp (make-wff (forall-guarded '(omega mc cE)
   '((IS-MONOTONE-CLASS omega mc) (IS-ALGEBRA-OF-SETS omega cE) (SUBSET cE mc))
   '(SUBSET (SIGMA-GENERATED omega cE) mc))))
(dk-peel!)
(let* ((aparts (mcl-parts! 'is-algebra-of-sets '(omega cE)))
       (am mcl-am))
  (fact 'monotone-class-generated-is-monotone-class 'omega 'cE)
  (let ((amparts (mcl-mc-parts! am)))
    ;; cE inside AM
    (dk-have! (list 'SUBSET 'cE am)
      (lambda ()
        (mac 'subset-def)
        (mcl-forall!
          (lambda (zv)
            (fact 'subset-mem-fwd 'cE '(POWER omega) zv)
            (mcl-into-mcg! (lambda () (ass))
                           (lambda (bv) (fact 'subset-mem-fwd 'cE bv zv) (ass)))))))
    ;; (a) D in cE, C in AM: D u C in AM
    (dk-have! (list 'FORALL 'mdd_ (list 'IMPLIES '(IN mdd_ cE) (list 'FORALL 'mdk_ (list 'IMPLIES (list 'IN 'mdk_ am) (list 'IN '(UNION mdd_ mdk_) am)))))
      (lambda ()
        (let* ((landed (dk-peel!))
               (g (dk-goal))
               (dv (cadr (cadr g))) (cv (caddr (cadr g)))
               (sec (mcl-sec-u dv)))
          (fact 'subset-mem-fwd 'cE '(POWER omega) dv)
          (fact 'monotone-class-union-section 'omega am dv)
          (mcl-ce-into-sec! sec
            (lambda (ev)
              (fact 'algebra-union-closed 'omega 'cE dv ev)
              (fact 'subset-mem-fwd 'cE am (list 'UNION dv ev))
              (ass)))
          (mcl-mcg-in! cv sec)
          (mcl-then-ass! (lambda () (mcl-sec-read! cv sec (list 'IN (list 'UNION dv cv) am)))))))
    (let ((step-a (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h 'mdk_))) "step (a)")))
      ;; (b) C, D in AM: C u D in AM
      (dk-have! (list 'FORALL 'mdx_ (list 'IMPLIES (list 'IN 'mdx_ am) (list 'FORALL 'mdk_ (list 'IMPLIES (list 'IN 'mdk_ am) (list 'IN '(UNION mdx_ mdk_) am)))))
        (lambda ()
          (let* ((landed (dk-peel!))
                 (g (dk-goal))
                 (cv (cadr (cadr g))) (dv (caddr (cadr g)))
                 (sec (mcl-sec-u cv)))
            (mcl-am-pow! cv)
            (fact 'monotone-class-union-section 'omega am cv)
            (mcl-ce-into-sec! sec
              (lambda (ev)
                (dk-apply! step-a ev cv)
                (mcl-ext! (list 'UNION cv ev) (list 'UNION ev cv) (lambda (w) #t))
                (subst (list '= (list 'UNION cv ev) (list 'UNION ev cv)))
                (ass)))
            (mcl-mcg-in! dv sec)
            (mcl-then-ass! (lambda () (mcl-sec-read! dv sec (list 'IN (list 'UNION cv dv) am))))))))
    ;; (c) C in AM: omega \ C in AM
    (dk-have! (list 'FORALL 'mdx_ (list 'IMPLIES (list 'IN 'mdx_ am) (list 'IN '(COMPLEMENT-IN omega mdx_) am)))
      (lambda ()
        (let ((cv (dk-di-var!)))
          (fact 'monotone-class-complement-section 'omega am)
          (mcl-ce-into-sec! mcl-sec-c
            (lambda (ev)
              (fact 'algebra-complement-closed 'omega 'cE ev)
              (fact 'subset-mem-fwd 'cE am (list 'COMPLEMENT-IN 'omega ev))
              (ass)))
          (mcl-mcg-in! cv mcl-sec-c)
          (mcl-then-ass! (lambda () (mcl-sec-read! cv mcl-sec-c (list 'IN (list 'COMPLEMENT-IN 'omega cv) am)))))))
    (let ((step-b (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(UNION mdx_ mdk_)))) "step (b)"))
          (step-c (dk-pick (lambda (h) (and (dk-head-is? h 'FORALL) (dk-contains? h '(COMPLEMENT-IN omega mdx_)))) "step (c)")))
      ;; AM is an algebra
      (dk-have! (list 'IS-ALGEBRA-OF-SETS 'omega am)
        (lambda ()
          (mac 'IS-ALGEBRA-OF-SETS)
          (dk-conj-close!
            (lambda ()
              (let ((g (dk-goal)))
                (cond ((dk-ass!) #t)
                      ((dk-head-is? g 'FORSOME)
                       (let ((av (dk-skolem! (list-ref aparts 2))))
                         (fact 'subset-mem-fwd 'cE am av)
                         (ew av)
                         (ass)))
                      ((dk-contains? g 'COMPLEMENT-IN)
                       (let ((av (dk-di-var!))) (dk-apply! step-c av) (ass)))
                      ((dk-contains? g 'UNION)
                       (let* ((landed (dk-peel!)) (gg (dk-goal)))
                         (dk-apply! step-b (cadr (cadr gg)) (caddr (cadr gg)))
                         (ass)))
                      (#t
                       (let* ((landed (dk-peel!)) (gg (dk-goal))
                              (av (cadr (cadr gg))) (bv (caddr (cadr gg)))
                              (ca (list 'COMPLEMENT-IN 'omega av)) (cb (list 'COMPLEMENT-IN 'omega bv))
                              (u (list 'UNION ca cb)) (cu (list 'COMPLEMENT-IN 'omega u)))
                         (mcl-am-pow! av) (mcl-am-pow! bv)
                         (dk-apply! step-c av) (dk-apply! step-c bv)
                         (dk-apply! step-b ca cb)
                         (dk-apply! step-c u)
                         (mcl-ext! (list 'INTERSECTION av bv) cu
                           (lambda (w) (fact 'power-mem-in 'omega av w) (fact 'power-mem-in 'omega bv w)))
                         (subst (list '= (list 'INTERSECTION av bv) cu))
                         (ass)))))))))
      ;; AM is a sigma-algebra (Prop. 1.11), so it holds the generated sigma-algebra
      (fact 'algebra-monotone-union-sigma-algebra 'omega am)
      (mac 'subset-def)
      (mcl-forall!
        (lambda (zv)
          (fact 'sigma-generated-in-every 'omega 'cE zv am)
          (mcl-mcg-in! zv 'mc)
          (ass))))))
(qed 'monotone-class-theorem)
(topic! 'monotone-class-theorem 'set-quotient)
(gloss! 'monotone-class-theorem
  "Thayer, Construction of Measures, Thm. 1.13 (p. 3), the monotone class theorem: a
   monotone class over X containing an algebra of subsets of X contains the
   sigma-algebra the algebra generates.")
