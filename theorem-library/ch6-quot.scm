;;; Library: complex-analysis.

;;; ch6-quot.scm -- CH6-B: the quotient of two entire functions with the same zero orders, then 6.21, 6.22.
;;; Loads after ch6-prod, ch6-fun, ch6-weier, zero-order-vocab, zero-order-laws, ch6-mult.  Prefix c6q-.

;;; zq(f, p, x): the value at x of the quotient f/p, read off any pair of factorisations of f and p at x with
;;; the exponent ZERO-ORDER(CC, p, x)
;;; KIT-9 link skipping, opt-in per file since 2026-10-29 (this file was developed with it on); guarded for bands that predate it

(dk-skip-links!)   ; KIT-9 link skipping, opt-in per file (wave-2 files were developed with it on)

;;; ---- helper defines COPIED 2026-10-30 (wave-2 integration) from ch6/ch6-fun.scm, ch6/ch6-mult.scm, ch6/ch6-prod.scm, ch6/ch6-weier.scm, ch6/zero-order-laws.scm:
;;; the probe loaded this chain in ONE environment; load.scm gives each file its own.
(define (c6-op? t op n) (and (pair? t) (eq? (car t) op) (= (length t) n)))
(define (c6-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (c6-rr! t) (if (not (dk-asm? (list 'IN t 'RR))) (dk-have! (list 'IN t 'RR) (lambda () (type-term)))) (list 'IN t 'RR))
(define (c6-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass)))))) f))
(define (c6-nn! n) (fact 'nn-in-rr n) (fact 'rr-subset-cc n))
(define (c6-steps!)                          ; peel FORALL / IMPLIES; return the landed formulas
  (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
(define (c6-var new cls) (cadr (find-first (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (c6-vars new cls) (map cadr (filter (lambda (q) (and (c6-op? q 'IN 3) (equal? (caddr q) cls))) new)))
(define (c6-lam-typ! lam cod typer)          ; (IN lam (FUN NN cod)); TYPER gets the eigenvariable, must ground
  (let ((typ (list 'IN lam (list 'FUN 'NN cod))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda () (let* ((k (dk-di-var!)) (leaf (proof-state-focus *ps*))) (typer k) (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
              (lambda () (fact 'nn-is-set) (dk-ass!))))))
    typ))
(define (c6-mag! t) (fact 'cc-magnitude-closed t) (fact 'cc-magnitude-nonneg t) (list 'magnitude t))
(define c6-debug #f)
(define (c6-first-map f l) (cond ((null? l) #f) ((f (car l)) => (lambda (x) x)) (#t (c6-first-map f (cdr l)))))
(define (c6-prod-sub t)
  (cond ((not (pair? t)) #f)
        ((not (memq (car t) '(+ - * < <= = AND))) #f)                ; any other head is an atom for ineq
        (#t (or (c6-first-map c6-prod-sub (cdr t))
                (and (eq? (car t) '*) (= (length t) 3) (not (number? (cadr t))) (not (number? (caddr t))) t)))))
(define (c6-ineq*! . prems)
  (let loop ((prems prems))
    (let ((pt (c6-first-map c6-prod-sub (cons (dk-goal) prems))))
      (if (not pt)
          (begin
            (if c6-debug (for-each (lambda (q) (display ";; C6I ") (display (expression->string q)) (newline)) (cons (dk-goal) prems)))
            (apply dk-ineq! prems))
          (begin
            (c6-rr! pt)
            (let ((v (dk-name! pt 'RR)))
              (if (dk-contains? (dk-goal) pt) (subst (list '= pt v)))
              (loop (map (lambda (f) (if (dk-contains? f pt) (dk-rewrite-h! f pt v) f)) prems))))))))
(define (c6-nonneg r) (list 'FORALL 'c6i_ (list 'IMPLIES '(IN c6i_ NN) (list '<= 0 (list r 'c6i_)))))
(define (c6-chain-end f) (if (c6-op? f 'IMPLIES 3) (c6-chain-end (caddr f)) f))
(define (c6-cite! . args)                     ; dk-cite! that refuses to return an undetached implication link
  (let ((r (apply dk-cite! args)))
    (cond ((not (c6-op? r 'IMPLIES 3)) r)
          ((dk-asm? (c6-chain-end r)) (dk-ctx-form (c6-chain-end r)))     ; the consequent was already in context
          (#t (error "c6-cite!: the chain stopped at an antecedent not in context" (car args) (expression->string (cadr r)))))))
(define (c6-pts!)
  (fact 'cc-is-metric-space)
  (if (not (dk-asm? '(== (PTS CC-MS) CC))) (dk-have! '(== (PTS CC-MS) CC) (lambda () (slot 'PTS) (qrfl)))))
(define (c6-sk! ex) (dk-skolem! (dk-ctx-form ex) #t))
(define c6-nfm '(NF-METRIC-SPACE CC-NORMED-FIELD))
(define (c6f-typ-on! lam u typer)              ; (IN lam (FUN u CC)); TYPER gets the eigenvariable
  (let ((typ (list 'IN lam (list 'FUN u 'CC))))
    (if (not (dk-asm? typ))
        (dk-have! typ
          (lambda ()
            (dk-lam-type!
              (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*))) (typer x) (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
              (lambda () (dk-ass!))))))
    typ))
(define (c6f-ptw u h rhs-of)                   ; forall y in u. h(y) == RHS(y)
  (list 'FORALL 'c6y_ (list 'IMPLIES (list 'IN 'c6y_ u) (list '== (list h 'c6y_) (rhs-of 'c6y_)))))
(define (c6f-lb!) (if (dk--redex? (dk-goal)) (dk-lam-b!)))
(define (c6f-rfl-close!) (dk-close-if! (lambda () #t) (lambda () (rfl))))
(define (c6f-lb-close!) (dk-close-if! (lambda () (c6f-lb!)) (lambda () (dk-ass!))))
(define (c6f-cc-and-closed! law x y)            ; law cc-mul-closed / cc-add-closed: (IN (op x y) CC)
  (c6-and! (list 'IN x 'CC) (list 'IN y 'CC)) (fact law x y))
(define (c6w-coef w) (list 'VNB-LAMBDA 'clhk_ 'NN (list '* (list 'RECIP-STAR 'clhk_) (list 'power w 'clhk_))))
(define (c6w-qs w m) (list 'CC-SERIES-PARTIAL-SUM (c6w-coef w) m))
(define (c6w-e n w) (list '* (list '- 1 w) (list 'CC-EXP (c6w-qs w (list 'succ n)))))
(define (c6w-exp-typ! q) (if (not (dk-asm? (list 'IN (list 'CC-EXP q) 'CC))) (dk-split-all! (list (dk-cite! 'cc-exp-converges q)))))
(define (c6w-e-typ! n w)
  (let ((q (c6w-qs w (list 'succ n))))
    (fact 'nn-succ-closed n) (c6w-coef-typ! w) (dk-cite! 'cc-series-partial-sum-in-cc (list 'succ n) (c6w-coef w))
    (c6w-exp-typ! q) (fact 'cc-one-in) (c6-cc! (list '- 1 w))
    (if (not (dk-asm? (list 'IN (c6w-e n w) 'CC))) (c6f-cc-and-closed! 'cc-mul-closed (list '- 1 w) (list 'CC-EXP q)))))
(define (c6w-mul-nonneg! x y)                    ; x, y in RR and >= 0 in context: 0 <= x y (no typing of the product needed)
  (c6-and! (list 'IN x 'RR) (list 'IN y 'RR)) (c6-and! (list '<= 0 x) (list '<= 0 y)) (fact 'rr-leq-mul-nonneg x y))
(define (c6w-cc-setup!) (fact 'cc-is-set) (fact 'cc-one-in) (fact 'cc-zero-in) (fact 'nn-zero-in) (fact 'rr-zero-in) (fact 'rr-one-in))
(define (c6w-pow-typ! w m)                       ; w in CC, m in NN: w^m in CC
  (c6-and! (list 'IN w 'CC) (list 'IN m 'NN)) (fact 'power-typing-nonneg w m) (list 'IN (list 'power w m) 'CC))
(define (c6w-coef-typ! w)                         ; w in CC: k -> RECIP-STAR(k) w^k in FUN(NN, CC)
  (c6-lam-typ! (c6w-coef w) 'CC (lambda (k) (c6-nn! k) (fact 'recip-star-in-rr k) (fact 'rr-subset-cc (list 'RECIP-STAR k))
                                    (c6w-pow-typ! w k) (c6f-cc-and-closed! 'cc-mul-closed (list 'RECIP-STAR k) (list 'power w k)))))
(define (c6w-el c n) (list 'VNB-LAMBDA 'c6x_ 'CC (list '- (c6w-e n (list '* 'c6x_ c)) 1)))
(define (c6w-fam a mu) (list 'VNB-LAMBDA 'c6k_ 'NN (c6w-el (list 'recip (list a 'c6k_)) (list mu 'c6k_))))
(define (c6w-h167 a mu)
  (list 'FORALL 'c6r_ (list 'IMPLIES '(IN c6r_ RR) (list 'IMPLIES '(<= 0 c6r_)
    (list 'SERIES-CONVERGES (list 'VNB-LAMBDA 'c6k_ 'NN (list '* (list 'power (list '* 'c6r_ (list 'recip (list 'magnitude (list a 'c6k_)))) (list 'succ (list mu 'c6k_)))
                                                          (list 'recip (list 'succ (list mu 'c6k_))))))))))
(define (c6w-grow a)
  (list 'FORALL 'c6r_ (list 'IMPLIES '(IN c6r_ RR)
    (list 'FORSOME 'c6m_ (list 'AND '(IN c6m_ NN) (list 'FORALL 'c6q_ (list 'IMPLIES '(IN c6q_ NN) (list 'IMPLIES '(<= c6m_ c6q_) (list '<= 'c6r_ (list 'magnitude (list a 'c6q_)))))))))))
(define (c6w-anz a) (list 'FORALL 'c6q_ (list 'IMPLIES '(IN c6q_ NN) (list 'NOT (list '= (list a 'c6q_) 0)))))
(define (c6w-feq f a mu)
  (list 'FORALL 'c6k_ (list 'IMPLIES '(IN c6k_ NN) (list 'FORALL 'c6x_ (list 'IMPLIES '(IN c6x_ CC)
    (list '= (list (list f 'c6k_) 'c6x_) (list '- (c6w-e (list mu 'c6k_) (list '* 'c6x_ (list 'recip (list a 'c6k_)))) 1)))))))
(define (zol-steps!) (dk-landed (lambda () (let lp () (if (memq (car (dk-goal)) '(FORALL IMPLIES)) (begin (di) (lp)))))))
(define (zol-cc! t) (if (not (dk-asm? (list 'IN t 'CC))) (dk-have! (list 'IN t 'CC) (lambda () (type-term)))) (list 'IN t 'CC))
(define (zol-and! a b) (let ((f (list 'AND a b))) (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (dk-ass!)))))) f))
(define (zol-pow-cc! w m) (zol-and! (list 'IN w 'CC) (list 'IN m 'NN)) (fact 'power-typing-nonneg w m) (list 'IN (list 'power w m) 'CC))
(define (zol-rfl!) (dk-close-if! (lambda () #t) (lambda () (rfl))))
(define (zol-pt! u x) (fact 'subset-mem-fwd u 'CC x))
(define (zol-hzo-open! hz)                        ; HAS-ZERO-OF-ORDER in context: open it on the main branch; returns h
  (dk-split-all! (dk-landed (lambda () (mac-h 'HAS-ZERO-OF-ORDER hz))))
  (let ((ex (find-first (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q 'zox_))) (dk-asms))))
    (dk-skolem! ex #t)))
(define (zol-fac u f a m h) (list 'FORALL 'zox_ (list 'IMPLIES (list 'IN 'zox_ u) (list '= (list f 'zox_) (list '* (list 'power (list '- 'zox_ a) m) (list h 'zox_))))))
(define (zol-pw u c d) (list 'VNB-LAMBDA 'zlx_ u (list 'power (list '- 'zlx_ c) d)))
(define (zol-pw-typ! u c d)
  (let ((lam (zol-pw u c d)))
    (if (not (dk-asm? (list 'IN lam (list 'FUN u 'CC))))
        (dk-have! (list 'IN lam (list 'FUN u 'CC))
          (lambda () (dk-lam-type!
                       (lambda () (let* ((x (dk-di-var!)) (leaf (proof-state-focus *ps*)))
                                    (zol-pt! u x) (zol-cc! (list '- x c)) (zol-pow-cc! (list '- x c) d)
                                    (if (not (sequent-node-grounded? leaf)) (dk-ass!))))
                       (lambda () (dk-ass!))))))))
(define (c6z-mag-s! xa s)
  (let ((e (list '= (list 'magnitude xa) s)))
    (if (not (dk-asm? e))
        (begin
          (dk-cite! 'rr-magnitude-is-abs s) (dk-have! (list '<= 0 s) (lambda () (dk-ineq! (list '< 0 s)))) (dk-cite! 'rr-abs-of-nonneg s)
          (fact 'rr-abs-closed s)
          (dk-have! e (lambda () (subst (list '= xa s)) (subst (list '= (list 'magnitude s) (list 'abs s))) (subst (list '= (list 'abs s) s)) (zol-rfl!)))))
    e))
(define (zol-za-ball! u g a r0 vanish!)
  (let ((zi (dk-cite! 'zeros-accumulate-at u g a)))
    (dk-have! (caddr zi)
      (lambda ()
        (let* ((r (cadr (find-first (lambda (q) (dk-head-is? q 'POS-RR)) (zol-steps!)))))
          (fact 'rr-pos-rr-in-rr r) (fact 'rr-lt-of-pos-rr r) (fact 'rr-pos-rr-in-rr r0) (fact 'rr-lt-of-pos-rr r0)
          (let* ((w (dk-skolem! (dk-cite! 'rr-min-pos r r0) #t)) (s (list '* 1/2 w)) (x (list '+ a s)) (xa (list '- x a)))
            (dk-have! (list 'IN s 'RR) (lambda () (type-term)))
            (fact 'rr-subset-cc s) (zol-cc! x) (zol-cc! xa)
            (dk-have! (list '< 0 s) (lambda () (dk-ineq! (list '< 0 w))))
            (dk-have! (list '= xa s) (lambda () (crs)))
            (fact 'cc-magnitude-closed xa) (c6z-mag-s! xa s)
            (let* ((bm1 (dk-cite! 'cc-ms-ball-membership a r x)) (bm2 (dk-cite! 'cc-ms-ball-membership a r0 x)))
              (dk-have! (list '< (list 'magnitude xa) r) (lambda () (dk-ineq! (list '= (list 'magnitude xa) s) (list '<= w r) (list '< 0 w) (list '< 0 r))))
              (dk-have! (list '< (list 'magnitude xa) r0) (lambda () (dk-ineq! (list '= (list 'magnitude xa) s) (list '<= w r0) (list '< 0 w) (list '< 0 r0))))
              (dk-have! (list 'IN x (list 'BALL 'CC-MS a r)) (lambda () (keep bm1 (list 'IN x 'CC) (list '< (list 'magnitude xa) r)) (prop)))
              (dk-have! (list 'IN x (list 'BALL 'CC-MS a r0)) (lambda () (keep bm2 (list 'IN x 'CC) (list '< (list 'magnitude xa) r0)) (prop)))
              (fact 'subset-mem-fwd (list 'BALL 'CC-MS a r0) u x))
            (dk-have! (list 'NOT (list '= xa 0))
              (lambda () (di) (dk-have! (list '= s 0) (lambda () (subst (list '= s xa)) (dk-ass!))) (dk-absurd! (list '< 0 s) (list '= s 0))))
            (dk-have! (list 'NOT (list '= x a))
              (lambda () (di) (dk-have! (list '= xa 0) (lambda () (subst (list '= x a)) (crs))) (ai (list 'NOT (list '= xa 0)))))
            (ew x)
            (dk-conj-close! (lambda () (if (dk-asm? (dk-goal)) (dk-ass!) (vanish! x))))))))
    (dk-have! (list 'ZEROS-ACCUMULATE-AT u g a) (lambda () (keep zi (caddr zi)) (prop)))))
(define (c6m-cc-open!)
  (c6w-cc-setup!) (fact 'nn-is-set) (fact 'cc-is-metric-space) (c6-pts!)
  (fact 'carrier-is-open 'CC-MS)
  (dk-have! '(IS-OPEN CC-MS CC) (lambda () (subst '(== CC (PTS CC-MS))) (dk-ass!)))
  (let ((oi (c6-cite! 'cc-ms-open-iff 'CC))) (dk-have! (list 'IS-OPEN c6-nfm 'CC) (lambda () (keep oi '(IS-OPEN CC-MS CC)) (prop))))
  (dk-have! '(SUBSET CC CC) (lambda () (let ((iff (dk-cite! 'subset-def 'CC 'CC)))
                                         (dk-have! (caddr iff) (lambda () (dk-di-var!) (dk-ass!)))
                                         (keep iff (caddr iff)) (prop)))))
;;; ---- end of copied helpers ----

(define (c6q-fac f h x p) (list 'FORALL 'zqy_ (list 'IMPLIES '(IN zqy_ CC) (list '= (list f 'zqy_) (list '* (list 'power (list '- 'zqy_ x) (list 'ZERO-ORDER 'CC p x)) (list h 'zqy_))))))
;;; (binders confined to sets: NBG refuses a lambda over an unconfined description)
(define (c6q-P f p x v)
  (list 'FORSOME 'zqh_ (list 'AND '(IN zqh_ (FUN CC CC)) (list 'FORSOME 'zqk_ (list 'AND '(IN zqk_ (FUN CC CC))
    (list 'AND '(HOLOMORPHIC-ON CC zqh_) (list 'AND '(HOLOMORPHIC-ON CC zqk_)
    (list 'AND (list 'NOT (list '= (list 'zqk_ x) 0)) (list 'AND (c6q-fac f 'zqh_ x p) (list 'AND (c6q-fac p 'zqk_ x p)
      (list '= v (list '* (list 'zqh_ x) (list 'recip (list 'zqk_ x))))))))))))))
(define (c6q-zq f p x) (list 'IOTA 'zqv_ (list 'AND '(IN zqv_ CC) (c6q-P f p x 'zqv_))))

;;; P(v) in context: v = h(x) / k(x) for the given factor pair (h, k)
(define (c6q-eqv! pv0 f p x h k)
  (let* ((zo (list 'ZERO-ORDER 'CC p x))
         (pv (if (dk-head-is? pv0 'AND)
                 (begin (dk-split-all! (list pv0)) (find-first (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q 'zqh_) (dk-contains? q x))) (dk-asms)))
                 pv0))
         (h2 (dk-skolem! pv #t))
         (k2 (dk-skolem! (find-first (lambda (q) (and (dk-head-is? q 'FORSOME) (dk-contains? q h2))) (dk-asms)) #t))
         (same! (lambda (g g2 fn)            ; g(x) = g2(x) from fn = P g = P g2
                  (let ((fg (dk-ctx-form (c6q-fac fn g x p))) (fg2 (dk-ctx-form (c6q-fac fn g2 x p))))
                    (dk-have! (list 'FORALL 'zly_ (list 'IMPLIES '(IN zly_ CC) (list '= (list '* (list 'power (list '- 'zly_ x) zo) (list g 'zly_)) (list '* (list 'power (list '- 'zly_ x) zo) (list g2 'zly_)))))
                      (lambda () (let* ((y (dk-di-var!)) (py (list 'power (list '- y x) zo)))
                                   (dk-apply! fg y)
                                   (subst (list '= (list '* py (list g y)) (list fn y)))
                                   (dk-close-if! (lambda () (dk-apply! fg2 y)) (lambda () (dk-ass!))))))
                    (c6-cite! 'zero-factor-value-unique 'CC g g2 x zo)))))
    (dk-cite! 'holomorphic-on-in-fun 'CC h2) (dk-cite! 'holomorphic-on-in-fun 'CC k2)
    (same! h h2 f) (same! k k2 p)
    (list h2 k2)))

;;; the value of the quotient at x
(sp (make-wff (list 'FORALL 'c6f_ (list 'FORALL 'c6p_ (list 'IMPLIES '(HOLOMORPHIC-ON CC c6f_) (list 'IMPLIES '(HOLOMORPHIC-ON CC c6p_)
  (list 'FORALL 'c6x_ (list 'IMPLIES '(IN c6x_ CC) (list 'IMPLIES '(IN (ZERO-ORDER CC c6p_ c6x_) NN)
    (list 'FORALL 'c6g_ (list 'FORALL 'c6h_ (list 'IMPLIES '(HOLOMORPHIC-ON CC c6g_) (list 'IMPLIES '(HOLOMORPHIC-ON CC c6h_)
      (list 'IMPLIES '(NOT (= (c6h_ c6x_) 0)) (list 'IMPLIES (c6q-fac 'c6f_ 'c6g_ 'c6x_ 'c6p_) (list 'IMPLIES (c6q-fac 'c6p_ 'c6h_ 'c6x_ 'c6p_)
        (list '= (c6q-zq 'c6f_ 'c6p_ 'c6x_) '(* (c6g_ c6x_) (recip (c6h_ c6x_))))))))))))))))))))
(let* ((new (c6-steps!)) (hs (map caddr (filter (lambda (q) (dk-head-is? q 'HOLOMORPHIC-ON)) new)))
       (fq (filter (lambda (q) (c6-op? q 'FORALL 3)) new))
       (x (c6-var new 'CC))
       (ff (find-first (lambda (q) (dk-contains? q '(* (power (- zqy_ c6x_) (ZERO-ORDER CC c6p_ c6x_)) (c6g_ zqy_)))) fq))
       (f 'c6f_) (p 'c6p_) (g 'c6g_) (h 'c6h_) (io (c6q-zq 'c6f_ 'c6p_ 'c6x_))
       (v0 (list '* (list g x) (list 'recip (list h x)))))
  (c6m-cc-open!)
  (dk-cite! 'holomorphic-on-in-fun 'CC g) (dk-cite! 'holomorphic-on-in-fun 'CC h)
  (fact 'fun-apply-type-c g 'CC 'CC x) (fact 'fun-apply-type-c h 'CC 'CC x)
  (c6-and! (list 'IN (list h x) 'CC) (list 'NOT (list '= (list h x) 0))) (fact 'cc-recip-closed (list h x))
  (c6f-cc-and-closed! 'cc-mul-closed (list g x) (list 'recip (list h x)))
  (for-each
    (lambda (l)
      (dk-focus! l)
      (if (dk-head-is? (dk-goal) 'FORSOME)
          (begin
            (ew v0)
            (letrec ((clo (lambda ()
                            (cond ((dk-asm? (dk-goal)) (dk-ass!))
                                  ((and (dk-head-is? (dk-goal) 'FORSOME) (eq? (cadr (dk-goal)) 'zqh_)) (ew g) (dk-conj-close! clo))
                                  ((and (dk-head-is? (dk-goal) 'FORSOME) (eq? (cadr (dk-goal)) 'zqk_)) (ew h) (dk-conj-close! clo))
                                  ((dk-head-is? (dk-goal) '=) (c6f-rfl-close!))
                                  (#t (dk-ass!))))))
            (dk-conj-close!
              (lambda ()
                (cond ((not (dk-head-is? (dk-goal) 'FORALL)) (clo))
                      (#t
                       (let* ((nv (c6-steps!)) (pv (find-first (lambda (q) (dk-head-is? q 'AND)) nv)) (y (caddr (dk-goal))))
                         (let* ((r (c6q-eqv! pv f p x g h)) (h2 (car r)) (k2 (cadr r)))
                           (subst (list '= y (list '* (list h2 x) (list 'recip (list k2 x)))))
                           (subst (list '= (list h2 x) (list g x))) (subst (list '= (list k2 x) (list h x)))
                           (c6f-rfl-close!)))))))))
          (let* ((pv (find-first (lambda (q) (and (dk-head-is? q 'AND) (dk-contains? q io))) (dk-asms)))
                 (r (c6q-eqv! pv f p x g h)) (h2 (car r)) (k2 (cadr r)))
            (subst (list '= io (list '* (list h2 x) (list 'recip (list k2 x)))))
            (subst (list '= (list h2 x) (list g x))) (subst (list '= (list k2 x) (list h x)))
            (c6f-rfl-close!))))
    (dk-opened (lambda () (iota-d io)))))
(qed 'quot-value)

;;; x in CC, the order hypothesis ordh in context: the factor pair (h, k) at x and zq(x) = h(x) / k(x)
(define (c6q-at! ordh f p x)
  (let* ((m (c6-sk! (dk-apply! ordh x))) (zo (list 'ZERO-ORDER 'CC p x)))
    (c6-cite! 'zero-order-value 'CC p x m)
    (let* ((h (zol-hzo-open! (list 'HAS-ZERO-OF-ORDER 'CC f x m)))
           (k (zol-hzo-open! (list 'HAS-ZERO-OF-ORDER 'CC p x m)))
           (fh (dk-ctx-form (zol-fac 'CC f x m h))) (fk (dk-ctx-form (zol-fac 'CC p x m k))))
      (dk-cite! 'holomorphic-on-in-fun 'CC h) (dk-cite! 'holomorphic-on-in-fun 'CC k)
      (fact 'fun-apply-type-c h 'CC 'CC x) (fact 'fun-apply-type-c k 'CC 'CC x)
      (dk-have! (list 'IN zo 'NN) (lambda () (subst (list '= zo m)) (dk-ass!)))
      (dk-have! (c6q-fac f h x p) (lambda () (let ((y (dk-di-var!))) (subst (list '= zo m)) (dk-close-if! (lambda () (dk-apply! fh y)) (lambda () (dk-ass!))))))
      (dk-have! (c6q-fac p k x p) (lambda () (let ((y (dk-di-var!))) (subst (list '= zo m)) (dk-close-if! (lambda () (dk-apply! fk y)) (lambda () (dk-ass!))))))
      (c6-cite! 'quot-value f p x h k)
      (c6-and! (list 'IN (list k x) 'CC) (list 'NOT (list '= (list k x) 0))) (fact 'cc-recip-closed (list k x)) (fact 'cc-recip-inverse (list k x))
      (c6f-cc-and-closed! 'cc-mul-closed (list h x) (list 'recip (list k x)))
      (list h k m fh fk))))
;;; the instance at x of a factorisation f = (y - a)^m h, landed once
(define (c6q-inst! fh f h x a m)
  (let ((e (list '= (list f x) (list '* (list 'power (list '- x a) m) (list h x)))))
    (if (dk-asm? e) (dk-ctx-form e) (dk-apply! fh x))))
(define (c6q-recip-nz! t)                          ; t in CC, t /= 0, t recip(t) = 1 in context: recip(t) /= 0
  (let ((r (list 'NOT (list '= (list 'recip t) 0))))
    (if (not (dk-asm? r))
        (dk-have! r (lambda () (di) (dk-have! '(= 1 0) (lambda () (subst (list '= 1 (list '* t (list 'recip t)))) (subst (list '= (list 'recip t) 0)) (crs))) (dk-absurd! '(= 1 0)))))
    r))

;;; f, p entire, p not identically 0, f and p have the same zero order at every point: f = p q with q entire, nowhere 0
(define (c6q-ordh-form f p)
  (list 'FORALL 'c6z_ (list 'IMPLIES '(IN c6z_ CC)
    (list 'FORSOME 'c6qm_ (list 'AND '(IN c6qm_ NN) (list 'AND (list 'HAS-ZERO-OF-ORDER 'CC f 'c6z_ 'c6qm_) (list 'HAS-ZERO-OF-ORDER 'CC p 'c6z_ 'c6qm_)))))))
;;; the quotient is entire
(sp (make-wff (list 'FORALL 'c6f_ (list 'FORALL 'c6p_ (list 'IMPLIES '(HOLOMORPHIC-ON CC c6f_) (list 'IMPLIES '(HOLOMORPHIC-ON CC c6p_)
  (list 'IMPLIES '(FORSOME c6w_ (AND (IN c6w_ CC) (NOT (= (c6p_ c6w_) 0))))
    (list 'IMPLIES (c6q-ordh-form 'c6f_ 'c6p_)
      (list 'HOLOMORPHIC-ON 'CC (list 'VNB-LAMBDA 'c6qx_ 'CC (c6q-zq 'c6f_ 'c6p_ 'c6qx_)))))))))))
(let* ((new (c6-steps!)) (f 'c6f_) (p 'c6p_)
       (wnz (find-first (lambda (q) (dk-head-is? q 'FORSOME)) new))
       (ordh (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'HAS-ZERO-OF-ORDER))) new))
       (q (list 'VNB-LAMBDA 'c6qx_ 'CC (c6q-zq f p 'c6qx_))))
  (c6m-cc-open!)
  (dk-cite! 'holomorphic-on-in-fun 'CC f) (dk-cite! 'holomorphic-on-in-fun 'CC p)
  (c6f-typ-on! q 'CC (lambda (x) (let* ((r (c6q-at! ordh f p x)) (h (car r)) (k (cadr r)))
                                   (subst (list '= (c6q-zq f p x) (list '* (list h x) (list 'recip (list k x)))))
                                   (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))))
         (mac 'HOLOMORPHIC-ON)
         (dk-conj-close!
           (lambda ()
             (if (dk-asm? (dk-goal)) (dk-ass!)
               (let* ((a (dk-di-var!)) (r (c6q-at! ordh f p a)) (h (car r)) (k (cadr r)) (m (caddr r)) (fh (cadddr r)) (fk (list-ref r 4)))
                 (dk-have! (list 'NOT (list 'ZEROS-ACCUMULATE-AT 'CC p a))
                   (lambda () (di) (fact 'cc-plane-connected)
                     (let* ((ip (c6-cite! 'holomorphic-identity-principle 'CC p a)) (w (c6-sk! wnz)))
                       (dk-apply! ip w) (ai (list 'NOT (list '= (list p w) 0))))))
                 (let* ((rr0 (c6-sk! (c6-cite! 'zeros-not-accumulating 'CC p a)))
                        (pz (find-first (lambda (g) (and (c6-op? g 'FORALL 3) (dk-contains? g rr0) (dk-contains? g p))) (dk-asms)))
                        (b (list 'BALL 'CC-MS a rr0))
                        (g (list 'VNB-LAMBDA 'c6qw_ b (list '* (list h 'c6qw_) (list 'recip (list k 'c6qw_)))))
                        (pr3 (list 'AND (list 'IN rr0 'RR) (list 'AND (list '<= 0 rr0) (list 'NOT (list '= 0 rr0))))))
                   (let ((pi (c6-cite! 'pos-rr rr0))) (dk-have! pr3 (lambda () (keep pi (list 'POS-RR rr0)) (prop))))
                   (dk-have! (list 'IN a '(PTS CC-MS)) (lambda () (subst '(== (PTS CC-MS) CC)) (dk-ass!)))
                   (dk-cite! 'ball-is-open 'CC-MS a rr0)
                   (dk-cite! 'ball-center-in 'CC-MS a rr0)
                   (fact 'rr-pos-rr-in-rr rr0)
                   (let ((oi (c6-cite! 'cc-ms-open-iff b))) (dk-have! (list 'IS-OPEN c6-nfm b) (lambda () (keep oi (list 'IS-OPEN 'CC-MS b)) (prop))))
                   (dk-have! (list 'FORALL 'dkdoy_ (list 'IMPLIES (list 'IN 'dkdoy_ b) '(IN dkdoy_ CC)))
                     (lambda () (let* ((y (dk-di-var!)) (bm (dk-cite! 'cc-ms-ball-membership a rr0 y)))
                                  (keep bm (list 'IN y b)) (prop))))
                   (let ((dom (dk-ctx-form (list 'FORALL 'dkdoy_ (list 'IMPLIES (list 'IN 'dkdoy_ b) '(IN dkdoy_ CC))))))
                     (dk-have! (list 'SUBSET b 'CC)
                       (lambda () (let ((iff (dk-cite! 'subset-def b 'CC))) (dk-have! (caddr iff) (lambda () (dk-ass!))) (keep iff (caddr iff)) (prop))))
                     (dk-have! (list 'FORALL 'dkdoy_ (list 'IMPLIES (list 'IN 'dkdoy_ b) (list 'NOT (list '= (list k 'dkdoy_) 0))))
                       (lambda ()
                         (let ((y (dk-di-var!)))
                           (dk-apply! dom y)
                           (use-em (list '= y a)
                             (lambda () (subst (list '= y a)) (dk-ass!))
                             (lambda ()
                               (dk-apply! pz y)
                               (di)
                               (let ((ya (list '- y a)))
                                 (c6-cc! ya) (zol-pow-cc! ya m) (fact 'fun-apply-type-c k 'CC 'CC y)
                                 (dk-have! (list '= (list p y) 0)
                                   (lambda () (subst (dk-apply! fk y)) (subst (list '= (list k y) 0)) (crs)))
                                 (ai (list 'NOT (list '= (list p y) 0)))))))))
                     (let ((knz (dk-ctx-form (list 'FORALL 'dkdoy_ (list 'IMPLIES (list 'IN 'dkdoy_ b) (list 'NOT (list '= (list k 'dkdoy_) 0)))))))
                       (dk-have! (list 'HOLOMORPHIC-ON b g) (lambda () (dk-holomorphic! b g)))
                       (let* ((hd (dk-cite! 'holomorphic-on-diff b g)) (ex (dk-apply! hd a))
                              (l (c6-sk! ex)))
                         (dk-have! (list 'FORALL 'cexx_ (list 'IMPLIES (list 'IN 'cexx_ b) (list '= (list q 'cexx_) (list g 'cexx_))))
                           (lambda ()
                             (let ((x (dk-di-var!)))
                               (dk-apply! dom x)
                               (dk-lam-b!)
                               (use-em (list '= x a)
                                 (lambda () (subst (list '= x a)) (dk-ass!))
                                 (lambda ()
                                   (let* ((zo (list 'ZERO-ORDER 'CC p x)) (xa (list '- x a)) (pp (list 'power xa m))
                                          (hx (list h x)) (kx (list k x)))
                                     (dk-apply! pz x)
                                     (fact 'fun-apply-type-c f 'CC 'CC x) (fact 'fun-apply-type-c p 'CC 'CC x)
                                     (fact 'fun-apply-type-c h 'CC 'CC x) (fact 'fun-apply-type-c k 'CC 'CC x)
                                     (let ((zi (c6-cite! 'zero-order-zero-iff 'CC p x)))
                                       (dk-have! (cadr zi) (lambda () (keep zi (caddr zi)) (prop))))
                                     (fact 'nn-zero-in)
                                     (c6-cite! 'zero-order-value 'CC p x 0)
                                     (dk-have! (list 'IN zo 'NN) (lambda () (subst (list '= zo 0)) (dk-ass!)))
                                     (for-each (lambda (fn)
                                                 (dk-have! (c6q-fac fn fn x p)
                                                   (lambda () (let* ((y (dk-di-var!)) (yx (list '- y x)))
                                                                (fact 'fun-apply-type-c fn 'CC 'CC y) (c6-cc! yx)
                                                                (subst (list '= zo 0)) (subst (dk-cite! 'power-zero yx)) (crs)))))
                                               (list f p))
                                     (subst (c6-cite! 'quot-value f p x f p))
                                     (c6-cc! xa) (zol-pow-cc! xa m)
                                     (dk-have! (list 'NOT (list '= xa 0))
                                       (lambda () (di) (dk-have! (list '= x a)
                                                         (lambda () (dk-have! (list '= x (list '+ xa a)) (lambda () (crs)))
                                                                    (subst (list '= x (list '+ xa a))) (subst (list '= xa 0)) (crs)))
                                                  (ai (list 'NOT (list '= x a)))))
                                     (dk-cite! 'cc-power-nonzero m xa)
                                     (if (not (dk-asm? (list 'NOT (list '= kx 0)))) (dk-apply! knz x))
                                     (subst (c6q-inst! fh f h x a m)) (subst (c6q-inst! fk p k x a m))
                                     (c6-and! (list 'IN pp 'CC) (list 'NOT (list '= pp 0))) (fact 'cc-recip-closed pp) (fact 'cc-recip-inverse pp)
                                     (c6-and! (list 'IN kx 'CC) (list 'NOT (list '= kx 0))) (fact 'cc-recip-closed kx)
                                     (subst (c6-cite! 'cc-recip-mul pp kx))
                                     (let* ((rp (dk-name! (list 'recip pp) 'CC)) (rk (dk-name! (list 'recip kx) 'CC))
                                            (e (list '= (list '* (list '* pp hx) (list '* rp rk)) (list '* (list '* hx rk) (list '* pp rp)))))
                                       (subst (list '= (list 'recip pp) rp)) (subst (list '= (list 'recip kx) rk))
                                       (dk-rewrite-h! (list '= (list '* pp (list 'recip pp)) 1) (list 'recip pp) rp)
                                       (dk-have! e (lambda () (crs)))
                                       (subst e) (subst (list '= (list '* pp rp) 1)) (crs))))))))
                         (c6-cite! 'cc-diff-on-local 'CC q b g a l)
                         (ew l)
                         (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))))))))))
(qed 'quot-holomorphic)

(sp (make-wff (list 'FORALL 'c6f_ (list 'FORALL 'c6p_ (list 'IMPLIES '(HOLOMORPHIC-ON CC c6f_) (list 'IMPLIES '(HOLOMORPHIC-ON CC c6p_)
  (list 'IMPLIES '(FORSOME c6w_ (AND (IN c6w_ CC) (NOT (= (c6p_ c6w_) 0))))
    (list 'IMPLIES (c6q-ordh-form 'c6f_ 'c6p_)
      '(FORSOME c6q_ (AND (HOLOMORPHIC-ON CC c6q_) (AND (FORALL c6z_ (IMPLIES (IN c6z_ CC) (NOT (= (c6q_ c6z_) 0))))
                                                        (FORALL c6z_ (IMPLIES (IN c6z_ CC) (= (c6f_ c6z_) (* (c6p_ c6z_) (c6q_ c6z_))))))))))))))))
(let* ((new (c6-steps!)) (f 'c6f_) (p 'c6p_)
       (wnz (find-first (lambda (q) (dk-head-is? q 'FORSOME)) new))
       (ordh (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q 'HAS-ZERO-OF-ORDER))) new))
       (q (list 'VNB-LAMBDA 'c6qx_ 'CC (c6q-zq f p 'c6qx_))))
  (c6m-cc-open!)
  (dk-cite! 'holomorphic-on-in-fun 'CC f) (dk-cite! 'holomorphic-on-in-fun 'CC p)
  (c6f-typ-on! q 'CC (lambda (x) (let* ((r (c6q-at! ordh f p x)) (h (car r)) (k (cadr r)))
                                   (subst (list '= (c6q-zq f p x) (list '* (list h x) (list 'recip (list k x)))))
                                   (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))))
  (let ((clo (lambda ()
      (cond
        ((dk-asm? (dk-goal)) (dk-ass!))
        ((dk-head-is? (caddr (caddr (dk-goal))) 'NOT)
         (let* ((z (dk-di-var!)) (r (c6q-at! ordh f p z)) (h (car r)) (k (cadr r)))
           (dk-lam-b!)
           (subst (list '= (c6q-zq f p z) (list '* (list h z) (list 'recip (list k z)))))
           (c6q-recip-nz! (list k z))
           (dk-close-if! (lambda () (dk-cite! 'cc-mul-nonzero (list h z) (list 'recip (list k z)))) (lambda () (dk-ass!)))))
        (#t
         (let* ((z (dk-di-var!)) (r (c6q-at! ordh f p z)) (h (car r)) (k (cadr r)) (m (caddr r)) (fh (cadddr r)) (fk (list-ref r 4))
                (zz (list '- z z)) (pp (list 'power zz m)) (hz (list h z)) (kz (list k z)))
           (dk-lam-b!)
           (subst (list '= (c6q-zq f p z) (list '* hz (list 'recip kz))))
           (c6-cc! zz) (zol-pow-cc! zz m)
           (subst (c6q-inst! fh f h z z m)) (subst (c6q-inst! fk p k z z m))
           (let* ((rk (dk-name! (list 'recip kz) 'CC))
                  (e (list '= (list '* (list '* pp kz) (list '* hz rk)) (list '* (list '* pp hz) (list '* kz rk)))))
             (subst (list '= (list 'recip kz) rk))
             (dk-rewrite-h! (list '= (list '* kz (list 'recip kz)) 1) (list 'recip kz) rk)
             (dk-have! e (lambda () (crs)))
             (subst e) (subst (list '= (list '* kz rk) 1)) (crs))))))))
    (let ((c1 (list 'HOLOMORPHIC-ON 'CC q))
          (c2 (list 'FORALL 'c6z_ (list 'IMPLIES '(IN c6z_ CC) (list 'NOT (list '= (list q 'c6z_) 0)))))
          (c3 (list 'FORALL 'c6z_ (list 'IMPLIES '(IN c6z_ CC) (list '= (list f 'c6z_) (list '* (list p 'c6z_) (list q 'c6z_)))))))
      (c6-cite! 'quot-holomorphic f p) (dk-have! c2 clo) (dk-have! c3 clo)
      (ew q)
      (dk-conj-close! (lambda () (dk-ass!))))))

(qed 'entire-quotient-same-orders)

;;; ---------------------------------------------------------------- 6.21
(define (c6q-lam-b-goal-safe!) (if (dk--redex? (dk-goal)) (lam-b)))
(define c6q-mid '(VNB-LAMBDA c6mk_ NN c6mk_))     ; mu_k = k
;;; (r / |a_k|)^{k+1} / (k + 1): real and >= 0 (r >= 0, a_k /= 0)
(define (c6q-gnn! a r k)
  (let* ((ma (list 'magnitude (list a k))) (rma (list 'recip ma)) (b (list '* r rma)) (m (list 'succ k))
         (gb (list '* (list 'power b m) (list 'recip m))))
    (if (not (dk-asm? (list '<= 0 gb)))
        (begin
          (fact 'fun-apply-type-c a 'NN 'CC k) (dk-apply! (dk-ctx-form (c6w-anz a)) k)
          (c6-mag! (list a k)) (c6-nn! k) (fact 'nn-succ-closed k) (c6-nn! m)
          (let ((iff (c6-cite! 'cc-magnitude-zero-iff (list a k))))
            (dk-have! (list 'NOT (list '= ma 0)) (lambda () (keep iff (list 'NOT (list '= (list a k) 0))) (prop))))
          (c6-and! (list 'IN ma 'RR) (list 'NOT (list '= ma 0))) (fact 'rr-recip-closed ma) (fact 'rr-recip-inverse ma)
          (dk-have! (list 'NOT (list '= 0 ma)) (lambda () (di) (dk-have! (list '= ma 0) (lambda () (subst (list '= 0 ma)) (c6f-rfl-close!))) (ai (list 'NOT (list '= ma 0)))))
          (c6-and! (list '<= 0 ma) (list 'NOT (list '= 0 ma))) (c6-cite! 'rr-le-ne-lt 0 ma) (c6-cite! 'rr-recip-pos ma)
          (dk-have! (list '<= 0 rma) (lambda () (dk-ineq! (list '< 0 rma))))
          (c6-rr! b) (c6w-mul-nonneg! r rma) (fact 'power-real-closed b m) (fact 'rr-power-nonneg m b)
          (dk-have! (list '< 0 m) (lambda () (fact 'nn-zero-le k) (fact 'nn-succ-plus-one k) (dk-ineq! (list '<= 0 k) (list '= m (list '+ k 1)))))
          (c6-cite! 'rr-pos-ne-zero m) (c6-and! (list 'IN m 'RR) (list 'NOT (list '= m 0))) (fact 'rr-recip-closed m) (c6-cite! 'rr-recip-pos m)
          (dk-have! (list '<= 0 (list 'recip m)) (lambda () (dk-ineq! (list '< 0 (list 'recip m)))))
          (c6w-mul-nonneg! (list 'power b m) (list 'recip m)) (c6-rr! gb)))
    gb))
;;; with |a_k| -> oo, mu_k = k satisfies (167): every R >= 0 gives sum (R / |a_k|)^{k+1} / (k + 1) < oo
(sp (make-wff (list 'FORALL 'c6a_ (list 'IMPLIES '(IN c6a_ (FUN NN CC)) (list 'IMPLIES (c6w-anz 'c6a_) (list 'IMPLIES (c6w-grow 'c6a_)
  (c6w-h167 'c6a_ c6q-mid)))))))
(let* ((new (c6-steps!)) (a (c6-var new '(FUN NN CC))) (grow (dk-ctx-form (c6w-grow a)))
       (r (c6-var new 'RR)) (sg (cadr (dk-goal)))
       (gs (list 'VNB-LAMBDA 'n 'NN '(power 1/2 n)))
       (g2 (list 'VNB-LAMBDA 'c6k_ 'NN '(power 1/2 (succ c6k_)))))
  (fact 'rr-zero-in) (fact 'rr-one-in) (fact 'nn-zero-in) (fact 'cc-one-in)
  (dk-have! '(IN 1/2 RR) (lambda () (arith))) (fact 'rr-subset-cc 1/2)
  (c6-lam-typ! gs 'RR (lambda (k) (fact 'power-real-closed 1/2 k)))
  (c6-lam-typ! g2 'RR (lambda (k) (fact 'nn-succ-closed k) (fact 'power-real-closed 1/2 (list 'succ k))))
  (c6-lam-typ! sg 'RR (lambda (k) (c6q-gnn! a r k) (c6f-lb-close!)))
  (dk-have! (c6-nonneg sg) (lambda () (let ((k (dk-di-var!))) (c6q-gnn! a r k) (c6f-lb-close!))))
  (dk-have! '(<= 0 1/2) (lambda () (arith)))
  (dk-have! (c6-nonneg gs) (lambda () (let ((k (dk-di-var!))) (fact 'rr-power-nonneg k 1/2) (c6f-lb-close!))))
  (dk-have! (c6-nonneg g2) (lambda () (let ((k (dk-di-var!))) (fact 'nn-succ-closed k) (fact 'rr-power-nonneg (list 'succ k) 1/2) (c6f-lb-close!))))
  ;; the geometric series
  (fact 'rr-abs-closed 1/2) (c6-cite! 'rr-abs-of-nonneg 1/2)
  (dk-have! '(< (abs 1/2) 1) (lambda () (dk-ineq! '(= (abs 1/2) 1/2))))
  (c6-and! '(IN 1/2 RR) '(< (abs 1/2) 1))
  (let ((gc (dk-fact! 'geometric-series-converges-to 1/2)))
    (dk-have! '(IN (recip (- 1 1/2)) RR) (lambda () (arith)))
    (c6-cite! 'series-converges-to-converges gs '(recip (- 1 1/2))))
  (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list '= (list g2 'c6j_) (list '* 1/2 (list gs 'c6j_)))))
    (lambda () (let ((k (dk-di-var!))) (fact 'nn-succ-closed k) (fact 'power-real-closed 1/2 k) (fact 'rr-subset-cc 1/2) (c6-and! '(IN 1/2 CC) (list 'IN k 'NN))
                 (dk-lam-b!) (subst (dk-fact! 'power-succ 1/2 k)) (c6f-rfl-close!))))
  (c6-cite! 'series-scale-converges gs 1/2 g2)
  ;; eventually (R / |a_k|) <= 1/2
  (let* ((r2 (list '* 2 r)))
    (c6-rr! r2)
    (let* ((nv (c6-sk! (dk-apply! grow r2)))
           (gr (find-first (lambda (q) (and (c6-op? q 'FORALL 3) (dk-contains? q nv) (dk-contains? q 'magnitude))) (dk-asms))))
      (c6-nn! nv)
      (dk-have! (list 'FORALL 'c6j_ (list 'IMPLIES '(IN c6j_ NN) (list 'IMPLIES (list '<= nv 'c6j_) (list '<= (list sg 'c6j_) (list g2 'c6j_)))))
        (lambda ()
          (let* ((nk (c6-steps!)) (k (c6-var nk 'NN)) (gb (c6q-gnn! a r k))
                 (ma (list 'magnitude (list a k))) (rma (list 'recip ma)) (b (list '* r rma)) (m (list 'succ k)) (pb (list 'power b m)))
            (dk-apply! gr k)
            (c6-rr! (list '* 1/2 ma))
            (dk-have! (list '<= r (list '* 1/2 ma)) (lambda () (dk-ineq! (list '<= r2 ma))))
            (let* ((k1 (c6-cite! 'rr-mul-le-right r (list '* 1/2 ma) rma))
                   (e1 (list '= (list '* (list '* 1/2 ma) rma) (list '* 1/2 (list '* ma rma)))))
              (dk-have! e1 (lambda () (dk-crs-opaque!)))
              (dk-have! (list '<= b 1/2) (lambda () (c6-ineq*! k1 e1 (list '= (list '* ma rma) 1))))
              (dk-have! (list '<= 0 b) (lambda () (dk-ass!)))
              (let* ((pm (c6-cite! 'rr-power-mono-base m b 1/2))
                     (rm1 (begin (fact 'rr-recip-one) (dk-have! (list '<= 1 m) (lambda () (fact 'nn-zero-le k) (fact 'nn-succ-plus-one k) (dk-ineq! (list '<= 0 k) (list '= m (list '+ k 1)))))
                                 (dk-have! '(< 0 1) (lambda () (dk-ineq!)))
                                 (dk-rewrite-h! (c6-cite! 'rr-recip-antitone 1 m) (list 'recip 1) 1)))
                     (k2 (c6-cite! 'rr-mul-le-right (list 'recip m) 1 pb)))
                (fact 'power-real-closed 1/2 m)
