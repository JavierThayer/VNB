    (let* ((pv (dk-name! pw '(FUN CC CC))) (qv (dk-name! pp '(FUN CC CC)))
           (tg (list 'VNB-LAMBDA 'c6x_ 'CC (list '* (list pv 'c6x_) (list qv 'c6x_)))))
      (dk-rewrite-h! (list 'HOLOMORPHIC-ON 'CC pw) pw pv) (dk-rewrite-h! (list 'HOLOMORPHIC-ON 'CC pp) pp qv)
      (dk-have! (list 'HOLOMORPHIC-ON 'CC tg) (lambda () (dk-holomorphic! 'CC tg)))
      (dk-have! (c6f-ptw 'CC p (lambda (y) (list tg y)))
        (lambda () (let ((y (dk-di-var!))) (subst (list '= pp qv)) (dk-lam-b!) (subst (list '= pv pw)) (dk-lam-b!) (dk-close-if! (lambda () #t) (lambda () (qrfl))))))
      (c6-cite! 'holomorphic-transfer-ptwise-eq 'CC p tg)
      (set! ppn qv))
    ;; p(x) = (x - 0)^m P(x), read at a point
    (let* ((pval! (lambda (x)                  ; lands (= (p x) (* (power x m) (P x))) ; returns it
                    (let ((e (list '= (list p x) (list '* (list 'power x m) (list pp x)))))
                      (pz! x) (fact 'fun-apply-type-c ppn 'CC 'CC x)
                      (if (not (dk-asm? e))
                          (dk-have! e (lambda () (subst (list '= pp ppn)) (dk-lam-b!) (subst (list '= (list '- x 0) x)) (c6f-rfl-close!))))
                      e)))
           (vanish! (lambda (x)                 ; p(x) /= 0 in context, goal d(x) = 0 or e^{g1 x} = e^{g2 x}
                      (let* ((e1 (list 'CC-EXP (list g1 x))) (e2 (list 'CC-EXP (list g2 x))) (px (list '* (list 'power x m) (list pp x)))
                             (y (list '- e1 e2)))
                        (fact 'fun-apply-type-c g1 'CC 'CC x) (fact 'fun-apply-type-c g2 'CC 'CC x)
                        (c6w-exp-typ! (list g1 x)) (c6w-exp-typ! (list g2 x)) (c6-cc! y)
                        (pval! x)
                        (dk-have! (list 'NOT (list '= px 0)) (lambda () (subst (list '= px (list p x))) (dk-ass!)))
                        (dk-apply! r1 x) (dk-apply! r2 x)
                        (dk-have! (list '= (list '* y px) 0)
                          (lambda ()
                            (let* ((ev1 (dk-name! e1 'CC)) (ev2 (dk-name! e2 'CC)) (pm (dk-name! (list 'power x m) 'CC)) (pv (dk-name! (list pp x) 'CC)))
                              (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (dk-ctx-form (c6q-rep f g1 m a t x)) e1 ev1) (list 'power x m) pm) (list pp x) pv)
                              (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! (dk-ctx-form (c6q-rep f g2 m a t x)) e2 ev2) (list 'power x m) pm) (list pp x) pv)
                              (subst (list '= e1 ev1)) (subst (list '= e2 ev2)) (subst (list '= (list 'power x m) pm)) (subst (list '= (list pp x) pv))
                              (dk-have! (list '= (list '* (list '- ev1 ev2) (list '* pm pv)) (list '- (list '* (list '* pm ev1) pv) (list '* (list '* pm ev2) pv))) (lambda () (crs)))
                              (subst (list '= (list '* (list '- ev1 ev2) (list '* pm pv)) (list '- (list '* (list '* pm ev1) pv) (list '* (list '* pm ev2) pv))))
                              (subst (list '= (list '* (list '* pm ev1) pv) (list f x)))
                              (subst (list '= (list '* (list '* pm ev2) pv) (list f x)))
                              (fact 'fun-apply-type-c f 'CC 'CC x)
                              (crs))))
                        (c6-cite! 'cc-mul-zero-left y px)))))
      ;; a point w with p(w) /= 0, and zeros of p not accumulating there
      (let* ((w (c6-sk! wnz)) (pw-e (pval! w)) (px (list '* (list 'power w m) (list pp w))))
        (dk-have! (list 'NOT (list '= (list p w) 0))
          (lambda () (di)
            (let* ((ev1 (list 'CC-EXP (list g1 w))))
              (fact 'fun-apply-type-c g1 'CC 'CC w) (c6w-exp-typ! (list g1 w))
              (dk-apply! r1 w)
              (dk-have! (list '= (list f w) 0)
                (lambda () (subst (dk-ctx-form (c6q-rep f g1 m a t w)))
                           (let* ((v1 (dk-name! ev1 'CC)) (pm (dk-name! (list 'power w m) 'CC)) (pv (dk-name! (list pp w) 'CC)))
                             (subst (list '= ev1 v1)) (subst (list '= (list 'power w m) pm)) (subst (list '= (list pp w) pv))
                             (dk-rewrite-h! (dk-rewrite-h! (dk-rewrite-h! pw-e (list 'power w m) pm) (list pp w) pv) (list p w) 0)
                             (dk-have! (list '= (list '* (list '* pm v1) pv) (list '* (list '* pm pv) v1)) (lambda () (crs)))
                             (subst (list '= (list '* (list '* pm v1) pv) (list '* (list '* pm pv) v1)))
                             (subst (list '= (list '* pm pv) 0)) (crs))))
              (ai (list 'NOT (list '= (list f w) 0))))))
        (dk-cite! 'holomorphic-on-continuous 'CC p)
        (dk-have! (list 'NOT (list 'ZEROS-ACCUMULATE-AT 'CC p w))
          (lambda () (di) (c6-cite! 'zeros-accumulate-value 'CC p w) (ai (list 'NOT (list '= (list p w) 0)))))
        (let* ((rr0 (c6-sk! (c6-cite! 'zeros-not-accumulating 'CC p w)))
               (pzh (find-first (lambda (g) (and (c6-op? g 'FORALL 3) (dk-contains? g rr0) (dk-contains? g p))) (dk-asms)))
               (b (list 'BALL 'CC-MS w rr0)))
          (dk-have! (list 'SUBSET b 'CC)
            (lambda () (let ((iff (dk-cite! 'subset-def b 'CC)))
                         (dk-have! (caddr iff) (lambda () (let* ((y (dk-di-var!)) (bm (begin (fact 'rr-pos-rr-in-rr rr0) (dk-cite! 'cc-ms-ball-membership w rr0 y)))) (keep bm (list 'IN y b)) (prop))))
                         (keep iff (caddr iff)) (prop))))
          (dk-have! (list 'HOLOMORPHIC-ON 'CC d) (lambda () (dk-holomorphic! 'CC d)))
          (dk-cite! 'holomorphic-on-in-fun 'CC d) (dk-cite! 'holomorphic-on-continuous 'CC d)
          (zol-za-ball! 'CC d w rr0
            (lambda (x) (dk-apply! pzh x) (vanish! x) (dk-lam-b!) (dk-close-if! (lambda () #t) (lambda () (dk-ass!)))))
          (fact 'cc-plane-connected)
          (let ((ip (c6-cite! 'holomorphic-identity-principle 'CC d w)))
            (dk-have! (list 'FORALL 'c6z_ (list 'IMPLIES '(IN c6z_ CC) (list '= (list 'CC-EXP (list g1 'c6z_)) (list 'CC-EXP (list g2 'c6z_)))))
              (lambda () (let* ((z (dk-di-var!)) (e1 (list 'CC-EXP (list g1 z))) (e2 (list 'CC-EXP (list g2 z))))
                           (fact 'fun-apply-type-c g1 'CC 'CC z) (fact 'fun-apply-type-c g2 'CC 'CC z) (c6w-exp-typ! (list g1 z)) (c6w-exp-typ! (list g2 z))
                           (dk-lam-b-h! (dk-apply! ip z))
                           (dk-have! (list '= e1 (list '+ (list '- e1 e2) e2)) (lambda () (crs)))
                           (subst (list '= e1 (list '+ (list '- e1 e2) e2))) (subst (list '= (list '- e1 e2) 0)) (crs)))))
          (let* ((gl (dk-goal)) (pz (cadr (cadr (cadr gl)))) (rz (cadr (cadr (caddr gl)))))
            (dk-apply! (c6-cite! 'exp-equal-diff-constant 'CC g1 g2) pz rz))
          (dk-close-if! (lambda () #t) (lambda () (dk-ass!))))))))
(qed 'prop-6-22)

  
