;;; isom2-group.scm -- the isometries of a metric space onto itself form a GROUP under
;;; composition, and for a compact space the sup metric makes it a compact METRIC GROUP
;;; (calculus.pdf ch. 3 sec. 8, after Prop 3.37: "In fact, Gamma is a compact metric
;;; group").  Agent ISOM, 2026-10-26.
;;;
;;;   isometry-group-compose-in, isometry-group-id-in, isometry-group-inverse-in
;;;                                    Gamma is closed under o, contains id, and inverses
;;;   isometry-group-grp-*             the read-offs of ISOMETRY-GROUP-GRP
;;;   isometry-group-grp-is-group      Gamma is a group (s a metric space)
;;;   isometry-group-compose-dist      d(u o v, u' o v') <= d(u, u') + d(v, v')
;;;   isometry-group-inverse-dist      d(u^-1, w^-1) <= d(u, w)
;;;   isometry-group-is-metric-group   s compact: IS-METRIC-GROUP(Gamma-ms, Gamma-grp)
;;;   isometry-group-compact-metric-group
;;;                                    s compact: Gamma is a compact metric group
;;;
;;; The two distance estimates are the whole content of the continuity: u is an isometry,
;;; so d(u(v x), u(v' x)) = d(v x, v' x); and d(u^-1 x, w^-1 x) = d(x, u(w^-1 x)) =
;;; d(w y, u y) with y = w^-1 x.  Both operations are therefore uniformly continuous.
;;;
;;; WINDOW.  Citations: isom-supdist.scm and isom-group.scm (scratchpad/isom), the
;;; vocabulary isom2-vocab.scm, bijection-compose / bijection-identity (bijection.scm),
;;; inverse-bij-* (rake-inverse-bij), is-group.  lo = after isom-group.scm; hi = none.
;;; Library: analysis.
;;;
;;; Helper prefix: igr-.

(define (igr-head g) (and (pair? g) (car g)))
(define (igr-iff-rhs! iff)
  (let ((rhs (caddr iff)))
    (dk-have! rhs (lambda () (prop)))
    (if (eq? (igr-head rhs) 'AND) (dk-split-all! (list rhs)))
    rhs))
(define (igr-and! a b)
  (let ((f (list 'AND a b)))
    (if (not (dk-asm? f)) (dk-have! f (lambda () (dk-conj-close! (lambda () (ass))))))
    f))
(define (igr-ds a b) (list '(DIST s) a b))
(define igr-G '(ISOMETRY-GROUP s))
(define igr-F '(FUN (PTS s) (PTS s)))
(define igr-B '(BIJECTION (PTS s) (PTS s)))
(define (igr-comp u v) (list 'VNB-LAMBDA 'igx_ '(PTS s) (list u (list v 'igx_))))
(define igr-id '(VNB-LAMBDA igx_ (PTS s) igx_))
(define (igr-inv u) (list 'INVERSE-BIJ u '(PTS s) '(PTS s)))
(define igr-opr-lam '(VNB-LAMBDA (LIST igu_ igv_) (CARTESIAN (ISOMETRY-GROUP s) (ISOMETRY-GROUP s))
                       (VNB-LAMBDA igx_ (PTS s) (igu_ (igv_ igx_)))))
(define igr-inv-lam '(VNB-LAMBDA igi_ (ISOMETRY-GROUP s) (INVERSE-BIJ igi_ (PTS s) (PTS s))))
(define igr-grp '(ISOMETRY-GROUP-GRP s))

;;; f in FUN(pts s, pts s), from Gamma
(define (igr-fun! f)
  (if (not (dk-asm? (list 'IN f igr-F))) (fact 'isometry-group-in-fun 's f))
  f)
(define (igr-bij! f)               ; f in Gamma: f in BIJECTION(pts s, pts s)
  (let ((b (list 'IN f igr-B)))
    (if (not (dk-asm? b))
        (dk-project! b 'isometry-group-membership (list 'IN f igr-G)))
    b))
(define (igr-pt! f x)
  (if (not (dk-asm? (list 'IN (list f x) '(PTS s)))) (fact 'fun-apply-type-c f '(PTS s) '(PTS s) x))
  (list f x))
(define (igr-real! a b)
  (let ((t (list 'IN (igr-ds a b) 'RR)))
    (if (not (dk-asm? t)) (fact 'metric-dist-real 's a b))
    t))
;;; the isometry equation of phi in Gamma at a, b
(define (igr-iso! phi a b)
  (let ((e (list '= (igr-ds (list phi a) (list phi b)) (igr-ds a b)))
        (cl (list 'FORALL 'igra_ (list 'IMPLIES '(IN igra_ (PTS s))
              (list 'FORALL 'igrb_ (list 'IMPLIES '(IN igrb_ (PTS s))
                (list '= (igr-ds (list phi 'igra_) (list phi 'igrb_)) (igr-ds 'igra_ 'igrb_))))))))
    (if (not (dk-asm? e))
        (begin
          (if (not (dk-asm? cl))
              (begin
                (dk-project! (list 'IS-ISOMETRY 's 's phi) 'isometry-group-membership (list 'IN phi igr-G))
                (dk-project! cl 'is-isometry (list 'IS-ISOMETRY 's 's phi))))
          (dk-have! e (lambda () (dk-close-if! (lambda () (inst*! (dk-ctx-form cl) a b)) ass)))))
    e))
;;; prove the focus goal IS-ISOMETRY(s, s, h) for a lambda h in BIJECTION(pts s, pts s)
;;; in context; PTWISE closes d(h x, h y) = d(x, y) (after beta) given x, y
(define (igr-isometry! h ptwise)
  (mac 'is-isometry)
  (dk-conj-close!
   (lambda ()
     (let ((g (dk-goal)))
       (cond
        ((and (eq? (igr-head g) 'IN) (equal? (caddr g) igr-F))
         (if (dk-asm? g) (ass)
             (dk-close-if! (lambda () (fact 'bijection-in-fun '(PTS s) '(PTS s) h)) ass)))
        ((eq? (igr-head g) 'FORALL)
         (dk-peel!)
         (let* ((gl (dk-goal))
                (x (cadr (caddr gl))) (y (caddr (caddr gl))))
           (if (dk-contains? (dk-goal) 'VNB-LAMBDA) (dk-lam-b!))
           (ptwise x y)))
        (#t (ass)))))))

;;; =====================================================================
;;; closure of Gamma
;;; =====================================================================
(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s)
     (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u igr-G)
       (list 'FORALL 'v (list 'IMPLIES (list 'IN 'v igr-G)
         (list 'IN (igr-comp 'u 'v) igr-G)))))))))
(dk-peel!)
(igr-bij! 'u) (igr-bij! 'v)
(igr-fun! 'u) (igr-fun! 'v)
(igr-and! (list 'IN 'v igr-B) (list 'IN 'u igr-B))
(fact 'bijection-compose '(PTS s) '(PTS s) '(PTS s) 'v 'u)
(mac 'isometry-group-membership)
(dk-conj-close!
 (lambda ()
   (if (eq? (igr-head (dk-goal)) 'IS-ISOMETRY)
       (igr-isometry! (igr-comp 'u 'v)
         (lambda (x y)
           (let ((vx (igr-pt! 'v x)) (vy (igr-pt! 'v y)))
             (igr-iso! 'u vx vy)
             (igr-iso! 'v x y)
             (igr-real! x y)
             (subst (list '= (igr-ds (list 'u vx) (list 'u vy)) (igr-ds vx vy)))
             (subst (list '= (igr-ds vx vy) (igr-ds x y)))
             (rfl))))
       (ass))))
(qed 'isometry-group-compose-in)
(topic! 'isometry-group-compose-in 'analysis)

(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s) (list 'IN igr-id igr-G)))))
(dk-peel!)
(dk-project! '(IN (PTS s) SET) 'is-metric-space '(IS-METRIC-SPACE s))
(fact 'bijection-identity '(PTS s))
(mac 'isometry-group-membership)
(dk-conj-close!
 (lambda ()
   (if (eq? (igr-head (dk-goal)) 'IS-ISOMETRY)
       (igr-isometry! igr-id (lambda (x y) (igr-real! x y) (rfl)))
       (ass))))
(qed 'isometry-group-id-in)
(topic! 'isometry-group-id-in 'analysis)

(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s)
     (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u igr-G) (list 'IN (igr-inv 'u) igr-G)))))))
(dk-peel!)
(igr-bij! 'u)
(fact 'inverse-bij-is-bijection '(PTS s) '(PTS s) 'u)
(fact 'inverse-bij-in-fun '(PTS s) '(PTS s) 'u)
(mac 'isometry-group-membership)
(dk-conj-close!
 (lambda ()
   (if (eq? (igr-head (dk-goal)) 'IS-ISOMETRY)
       (igr-isometry! (igr-inv 'u)
         (lambda (x y)
           (let* ((w (igr-inv 'u)) (wx (igr-pt! w x)) (wy (igr-pt! w y)))
             (igr-fun! 'u)
             (igr-iso! 'u wx wy)
             (fact 'inverse-bij-right '(PTS s) '(PTS s) 'u x)
             (fact 'inverse-bij-right '(PTS s) '(PTS s) 'u y)
             (igr-pt! 'u wx) (igr-pt! 'u wy)
             (dk-rewrite-h! (list '= (igr-ds (list 'u wx) (list 'u wy)) (igr-ds wx wy)) (list 'u wx) x)
             (dk-rewrite-h! (list '= (igr-ds x (list 'u wy)) (igr-ds wx wy)) (list 'u wy) y)
             (igr-real! wx wy)
             (subst (list '= (igr-ds wx wy) (igr-ds x y)))
             (igr-real! x y)
             (rfl))))
       (ass))))
(qed 'isometry-group-inverse-in)
(topic! 'isometry-group-inverse-in 'analysis)

;;; =====================================================================
;;; the components of ISOMETRY-GROUP-GRP are typed; the read-offs
;;; =====================================================================
(define (igr-each-leaf! opener body)
  (for-each (lambda (kn) (if (not (sequent-node-grounded? kn)) (begin (dk-focus! kn) (body))))
            (dk-opened opener)))

(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s)
     (list 'IN igr-opr-lam (list 'FUN (list 'CARTESIAN igr-G igr-G) igr-G))))))
(dk-peel!)
(fact 'isometry-group-is-set 's)
(igr-each-leaf! (lambda () (lam-t))
  (lambda ()
    (if (and (eq? (igr-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
        (begin (mac 'cartesian-set-iff) (dk-conj-close! (lambda () (ass))))
        (begin
          (dk-peel!)
          (let* ((L (cadr (dk-goal))) (body (cadddr L)) (A (car body)) (B (car (cadr body))))
            (dk-close-if! (lambda () (fact 'isometry-group-compose-in 's A B)) ass))))))
(qed 'isometry-group-grp-opr-type)
(topic! 'isometry-group-grp-opr-type 'plumbing)

(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s)
     (list 'IN igr-inv-lam (list 'FUN igr-G igr-G))))))
(dk-peel!)
(fact 'isometry-group-is-set 's)
(igr-each-leaf! (lambda () (lam-t))
  (lambda ()
    (if (and (eq? (igr-head (dk-goal)) 'IN) (eq? (caddr (dk-goal)) 'SET))
        (ass)
        (let ((u (dk-di-var!)))
          (dk-close-if! (lambda () (fact 'isometry-group-inverse-in 's u)) ass)))))
(qed 'isometry-group-grp-inv-type)
(topic! 'isometry-group-grp-inv-type 'plumbing)

(define (igr-typings!)               ; IS-METRIC-SPACE s in context
  (fact 'isometry-group-is-set 's)
  (fact 'isometry-group-grp-opr-type 's)
  (fact 'isometry-group-grp-inv-type 's)
  (fact 'isometry-group-id-in 's))

(define (igr-readoff! name acc slotn val)
  (sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-METRIC-SPACE s)
       (list '== (list acc igr-grp) val)))))
  (dk-peel!)
  (igr-typings!)
  (mac 'ISOMETRY-GROUP-GRP)
  (slot acc)
  (nth-r)
  (qrfl)
  (qed name)
  (topic! name 'plumbing))
(igr-readoff! 'isometry-group-grp-carr 'CARR 1 igr-G)
(igr-readoff! 'isometry-group-grp-opr 'OPR 2 igr-opr-lam)
(igr-readoff! 'isometry-group-grp-iden 'IDEN 3 igr-id)
(igr-readoff! 'isometry-group-grp-inv 'INV 4 igr-inv-lam)

;;; =====================================================================
;;; isometry-group-grp-is-group
;;; =====================================================================
;;; the focus goal (= L R), L and R members of Gamma written as lambdas: extensionality.
;;; TYPE-L / TYPE-R prove (IN L Gamma) / (IN R Gamma); PTWISE proves (= (L z) (R z)).
(define (igr-ext! type-l type-r ptwise)
  (let* ((g (dk-goal)) (L (cadr g)) (R (caddr g)))
    (dk-fun-ext! L R '(PTS s) '(PTS s)
      (lambda () (type-l L) (dk-close-if! (lambda () (fact 'isometry-group-in-fun 's L)) ass))
      (lambda () (type-r R) (dk-close-if! (lambda () (fact 'isometry-group-in-fun 's R)) ass))
      ptwise)))
(define (igr-comp-in! L)               ; L = (VNB-LAMBDA v D (A (B v))), A, B in Gamma in context
  (let* ((body (cadddr L)) (A (car body)) (B (car (cadr body))))
    (if (not (dk-asm? (list 'IN L igr-G))) (fact 'isometry-group-compose-in 's A B))))
(define (igr-beta! )                   ; lam-b while it changes the goal
  (let loop ((fuel 8))
    (let ((g (dk-goal)))
      (if (and (> fuel 0) (dk-contains? g 'VNB-LAMBDA))
          (begin (lam-b) (if (not (equal? g (dk-goal))) (loop (- fuel 1))))))))
(define (igr-beta-rfl! z)              ; z in pts s; reduce the goal and close by rfl
  (igr-beta!)
  (rfl))

(define (igr-op-redex? t)              ; an applied operation lambda of the group
  (and (pair? t)
       (or (and (pair? (car t)) (eq? (caar t) 'VNB-LAMBDA)
                (pair? (cdar t)) (member (cadar t) '((LIST igu_ igv_) igi_)))
           (any-pred igr-op-redex? t))))
(define (igr-reduce-ops!)              ; beta the group operations at typed arguments
  (let loop ((fuel 8))
    (let ((g (dk-goal)))
      (if (and (> fuel 0) (igr-op-redex? g))
          (begin (lam-b) (if (not (equal? g (dk-goal))) (loop (- fuel 1))))))))
(define (igr-type-points! fs z)       ; every f(z), g(f(z)), h(g(f(z))) for f, g, h in fs
  (for-each (lambda (a) (igr-pt! a z)) fs)
  (for-each (lambda (a) (for-each (lambda (b) (igr-pt! a (list b z))) fs)) fs)
  (for-each (lambda (a) (for-each (lambda (b) (for-each (lambda (c) (igr-pt! a (list b (list c z)))) fs)) fs)) fs))
(define (igr-assoc!)
  (mac 'is-associative)
  (let* ((pl (dk-peel!))
         (vs (map cadr (filter (lambda (f) (and (eq? (igr-head f) 'IN) (equal? (caddr f) igr-G))) pl)))
         (u (car vs)) (v (cadr vs)) (w (caddr vs)))
    (for-each igr-fun! vs)
    (fact 'isometry-group-compose-in 's u v)
    (fact 'isometry-group-compose-in 's v w)
    (igr-reduce-ops!)
    (igr-ext! igr-comp-in! igr-comp-in!
      (lambda (z) (igr-type-points! vs z) (igr-beta-rfl! z)))))
(define (igr-ident!)
  (mac 'is-identity)
  (let ((u (dk-di-var!)))
    (igr-fun! u)
    (dk-conj-close!
     (lambda ()
       (igr-reduce-ops!)
       (igr-ext! igr-comp-in! (lambda (R) #t)
         (lambda (z) (igr-pt! u z) (igr-beta-rfl! z)))))))
(define (igr-inverses!)
  (mac 'has-inverses)
  (let* ((u (dk-di-var!)) (w (igr-inv u)))
    (igr-fun! u)
    (igr-bij! u)
    (fact 'isometry-group-inverse-in 's u)
    (igr-fun! w)
    (dk-conj-close!
     (lambda ()
       (igr-reduce-ops!)
       (igr-ext! igr-comp-in! (lambda (R) #t)
         (lambda (z)
           (igr-pt! u z) (igr-pt! w z)
           (fact 'inverse-bij-left '(PTS s) '(PTS s) u z)
           (fact 'inverse-bij-right '(PTS s) '(PTS s) u z)
           (igr-beta!)
           (cond ((dk-asm? (dk-goal)) (ass))
                 (#t
                  (if (dk-contains? (dk-goal) (list w (list u z))) (subst (list '= (list w (list u z)) z)))
                  (if (dk-contains? (dk-goal) (list u (list w z))) (subst (list '= (list u (list w z)) z)))
                  (rfl)))))))))
(define (igr-group-leaf!)
  (let ((g (dk-goal)))
    (if (and (eq? (igr-head g) '=) (dk-head-is? (cadr g) 'LENGTH))
        (begin (mac 'ISOMETRY-GROUP-GRP) (len-r)
               (if (not (sequent-node-grounded? (proof-state-focus *ps*))) (vnb-guard (lambda () (arith)))))
        (begin
          (if (dk-contains? (dk-goal) (list 'CARR igr-grp)) (subst (list '== (list 'CARR igr-grp) igr-G)))
          (if (dk-contains? (dk-goal) (list 'OPR igr-grp)) (subst (list '== (list 'OPR igr-grp) igr-opr-lam)))
          (if (dk-contains? (dk-goal) (list 'IDEN igr-grp)) (subst (list '== (list 'IDEN igr-grp) igr-id)))
          (if (dk-contains? (dk-goal) (list 'INV igr-grp)) (subst (list '== (list 'INV igr-grp) igr-inv-lam)))
          (let ((h (igr-head (dk-goal))))
            (cond ((eq? h 'IS-ASSOCIATIVE) (igr-assoc!))
                  ((eq? h 'IS-IDENTITY) (igr-ident!))
                  ((eq? h 'HAS-INVERSES) (igr-inverses!))
                  (#t (ass))))))))

(sp (make-wff '(FORALL s (IMPLIES (IS-METRIC-SPACE s) (IS-GROUP (ISOMETRY-GROUP-GRP s))))))
(dk-peel!)
(igr-typings!)
(fact 'isometry-group-grp-carr 's)
(fact 'isometry-group-grp-opr 's)
(fact 'isometry-group-grp-iden 's)
(fact 'isometry-group-grp-inv 's)
(mac 'is-group)
(dk-isx-set!)   ; W1J-B: the conjunct t in SET, from the typings
(dk-conj-close! igr-group-leaf!)
(qed 'isometry-group-grp-is-group)
(topic! 'isometry-group-grp-is-group 'analysis)
(alias! 'isometry-group-grp-is-group "the isometries of a metric space onto itself form a group under composition")

;;; =====================================================================
;;; the two distance estimates
;;; =====================================================================
(define (igr-S a b) (list 'SUP-DIST 's 's a b))
(define igr-M '(ISOMETRY-GROUP-MS s))
(define (igr-D a b) (list '(DIST (ISOMETRY-GROUP-MS s)) a b))
(define igr-B0 #f)
(define igr-bcl #f)
(define (igr-bound!)                   ; the diameter bound B of s, once
  (if (not igr-B0)
      (begin
        (set! igr-B0 (dk-skolem! (dk-cite! 'compact-dist-bound 's)))
        (set! igr-bcl (dk-pick (lambda (h) (and (eq? (igr-head h) 'FORALL) (dk-contains? h igr-B0))) "the bound")))))
;;; a, b in FUN(pts s, pts s): S(a, b) real, 0 <= S(a, b)
(define (igr-S-real! a b)
  (if (not (dk-asm? (list 'IN (igr-S a b) 'RR)))
      (let ((fa (list 'FORALL 'igrx_ (list 'IMPLIES '(IN igrx_ (PTS s))
                       (list '<= (igr-ds (list a 'igrx_) (list b 'igrx_)) igr-B0)))))
        (dk-have! fa
          (lambda ()
            (let ((x (dk-di-var!)))
              (igr-pt! a x) (igr-pt! b x)
              (dk-close-if! (lambda () (inst*! igr-bcl (list a x) (list b x))) ass))))
        (dk-split-all! (list (dk-cite! 'sup-dist-bound 's 's a b igr-B0))))))
(define (igr-up! a b x)                ; d(a x, b x) <= S(a, b)
  (dk-apply! (dk-cite! 'sup-dist-upper 's 's a b) x))

(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-COMPACT s)
     (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u igr-G)
     (list 'FORALL 'v (list 'IMPLIES (list 'IN 'v igr-G)
     (list 'FORALL 'p (list 'IMPLIES (list 'IN 'p igr-G)
     (list 'FORALL 'q (list 'IMPLIES (list 'IN 'q igr-G)
       (list '<= (igr-S (igr-comp 'u 'v) (igr-comp 'p 'q))
                 (list '+ (igr-S 'u 'p) (igr-S 'v 'q)))))))))))))))
(dk-peel!)
(set! igr-B0 #f)
(dk-project! '(IS-METRIC-SPACE s) 'is-compact '(IS-COMPACT s))
(igr-bound!)
(for-each igr-fun! '(u v p q))
(define igr-L1 (igr-comp 'u 'v))
(define igr-L2 (igr-comp 'p 'q))
(fact 'isometry-group-compose-in 's 'u 'v)
(fact 'isometry-group-compose-in 's 'p 'q)
(igr-fun! igr-L1) (igr-fun! igr-L2)
(igr-S-real! 'u 'p) (igr-S-real! 'v 'q)
(define igr-sum (list '+ (igr-S 'u 'p) (igr-S 'v 'q)))
(fact 'rr-add-in-rr (igr-S 'u 'p) (igr-S 'v 'q))
(dk-have! (list '<= 0 igr-sum)
  (lambda () (dk-ineq! (list '<= 0 (igr-S 'u 'p)) (list '<= 0 (igr-S 'v 'q))
                       (list 'IN (igr-S 'u 'p) 'RR) (list 'IN (igr-S 'v 'q) 'RR))))
(dk-have! (list 'FORALL 'igrx_ (list 'IMPLIES '(IN igrx_ (PTS s))
            (list '<= (igr-ds (list igr-L1 'igrx_) (list igr-L2 'igrx_)) igr-sum)))
  (lambda ()
    (let* ((x (dk-di-var!))
           (vx (igr-pt! 'v x)) (qx (igr-pt! 'q x))
           (uvx (igr-pt! 'u vx)) (uqx (igr-pt! 'u qx)) (pqx (igr-pt! 'p qx)))
      (igr-beta!)
      (igr-iso! 'u vx qx)
      (igr-up! 'v 'q x)
      (igr-up! 'u 'p qx)
      (fact 'metric-triangle 's uvx uqx pqx)
      (apply dk-ineq!
             (list (list '<= (igr-ds uvx pqx) (list '+ (igr-ds uvx uqx) (igr-ds uqx pqx)))
                   (list '= (igr-ds uvx uqx) (igr-ds vx qx))
                   (list '<= (igr-ds vx qx) (igr-S 'v 'q))
                   (list '<= (igr-ds uqx pqx) (igr-S 'u 'p))
                   (igr-real! uvx pqx) (igr-real! uvx uqx) (igr-real! uqx pqx) (igr-real! vx qx)
                   (list 'IN (igr-S 'u 'p) 'RR) (list 'IN (igr-S 'v 'q) 'RR))))))
(dk-split-all! (list (dk-cite! 'sup-dist-bound 's 's igr-L1 igr-L2 igr-sum)))
(ass)
(qed 'isometry-group-compose-dist)
(topic! 'isometry-group-compose-dist 'analysis)

(sp (make-wff (list 'FORALL 's (list 'IMPLIES '(IS-COMPACT s)
     (list 'FORALL 'u (list 'IMPLIES (list 'IN 'u igr-G)
     (list 'FORALL 'w (list 'IMPLIES (list 'IN 'w igr-G)
       (list '<= (igr-S (igr-inv 'u) (igr-inv 'w)) (igr-S 'w 'u))))))))))
(dk-peel!)
(set! igr-B0 #f)
(dk-project! '(IS-METRIC-SPACE s) 'is-compact '(IS-COMPACT s))
(igr-bound!)
(for-each igr-fun! '(u w))
(igr-bij! 'u) (igr-bij! 'w)
(fact 'isometry-group-inverse-in 's 'u)
(fact 'isometry-group-inverse-in 's 'w)
(igr-fun! (igr-inv 'u)) (igr-fun! (igr-inv 'w))
(igr-S-real! 'w 'u)
(define igr-bw (igr-S 'w 'u))
(dk-have! (list 'FORALL 'igrx_ (list 'IMPLIES '(IN igrx_ (PTS s))
            (list '<= (igr-ds (list (igr-inv 'u) 'igrx_) (list (igr-inv 'w) 'igrx_)) igr-bw)))
  (lambda ()
    (let* ((x (dk-di-var!))
           (ux (igr-pt! (igr-inv 'u) x)) (y (igr-pt! (igr-inv 'w) x))
           (uy (igr-pt! 'u y)) (wy (igr-pt! 'w y)) (uux (igr-pt! 'u ux)))
      (igr-iso! 'u ux y)
      (fact 'inverse-bij-right '(PTS s) '(PTS s) 'u x)
      (fact 'inverse-bij-right '(PTS s) '(PTS s) 'w x)
      (igr-real! x uy) (igr-real! wy uy) (igr-real! uux uy) (igr-real! ux y)
      (dk-have! (list '= (igr-ds uux uy) (igr-ds x uy))
        (lambda () (subst (list '= uux x)) (rfl)))
      (dk-have! (list '= (igr-ds x uy) (igr-ds wy uy))
        (lambda () (subst (list '= wy x)) (rfl)))
      (igr-up! 'w 'u y)
      (dk-ineq! (list '= (igr-ds uux uy) (igr-ds ux y))
                (list '= (igr-ds uux uy) (igr-ds x uy))
                (list '= (igr-ds x uy) (igr-ds wy uy))
                (list '<= (igr-ds wy uy) igr-bw)
                (igr-real! x uy) (igr-real! wy uy) (igr-real! uux uy) (igr-real! ux y)
                (list 'IN igr-bw 'RR)))))
(dk-split-all! (list (dk-cite! 'sup-dist-bound 's 's (igr-inv 'u) (igr-inv 'w) igr-bw)))
(ass)
(qed 'isometry-group-inverse-dist)
(topic! 'isometry-group-inverse-dist 'analysis)

;;; =====================================================================
;;; isometry-group-is-metric-group, isometry-group-compact-metric-group
;;; =====================================================================
;;; a, b in Gamma: D(a, b) and S(a, b) real and equal (M a metric space, read-offs in context)
(define (igr-DS! a b)
  (let ((D (igr-D a b)) (S (igr-S a b)))
    (for-each (lambda (z)
                (if (not (dk-asm? (list 'IN z (list 'PTS igr-M))))
                    (dk-have! (list 'IN z (list 'PTS igr-M))
                      (lambda () (subst (list '== (list 'PTS igr-M) igr-G)) (ass)))))
              (list a b))
    (if (not (dk-asm? (list 'IN D 'RR))) (fact 'metric-dist-real igr-M a b))
    (let ((ro (list '== D S)))
      (if (not (dk-asm? ro)) (fact 'isometry-group-ms-dist 's a b))
      (if (not (dk-asm? (list 'IN S 'RR)))
          (dk-have! (list 'IN S 'RR) (lambda () (subst (list '== S D)) (ass))))
      (if (not (dk-asm? (list '= D S)))
          (dk-have! (list '= D S) (lambda () (subst (list '== S D)) (rfl)))))))
(define (igr-in-G! a)                  ; (IN a (PTS M)) in context -> (IN a Gamma)
  (if (not (dk-asm? (list 'IN a igr-G)))
      (dk-have! (list 'IN a igr-G) (lambda () (subst (list '== igr-G (list 'PTS igr-M))) (ass)))))

(sp (make-wff '(FORALL s (IMPLIES (IS-COMPACT s)
     (IS-GROUP-METRIC (ISOMETRY-GROUP-MS s) (ISOMETRY-GROUP-GRP s))))))
(dk-peel!)
(dk-project! '(IS-METRIC-SPACE s) 'is-compact '(IS-COMPACT s))
(igr-typings!)
(fact 'isometry-group-ms-is-metric-space 's)
(fact 'isometry-group-ms-pts 's)
(fact 'isometry-group-grp-is-group 's)
(fact 'isometry-group-grp-carr 's)
(fact 'isometry-group-grp-opr 's)
(fact 'isometry-group-grp-inv 's)
(mac 'IS-GROUP-METRIC)
(subst (list '== (list 'CARR igr-grp) igr-G))
(subst (list '== (list 'OPR igr-grp) igr-opr-lam))
(subst (list '== (list 'INV igr-grp) igr-inv-lam))
(dk-conj-close!
 (lambda ()
   (let ((g (dk-goal)))
     (cond
      ((eq? (igr-head g) '=)
       (subst (list '== (list 'PTS igr-M) igr-G))
       (rfl))
      ;; the product is continuous: delta = eps / 2
      ((eq? (igr-head g) 'FORALL)
       (let* ((pl (dk-peel!))
              (vs (map cadr (filter (lambda (f) (and (eq? (igr-head f) 'IN) (equal? (caddr f) igr-G))) pl)))
              (u (car vs)) (v (cadr vs))
              (e (cadr (car (filter (lambda (f) (eq? (igr-head f) 'POS-RR)) pl))))
              (h (dk-halve! e)))
         (ew h)
         (dk-conj-close!
          (lambda ()
            (if (not (eq? (igr-head (dk-goal)) 'FORALL))
                (ass)
                (let* ((pk (dk-peel!))
                       (ws (map cadr (filter (lambda (f) (and (eq? (igr-head f) 'IN) (equal? (caddr f) igr-G))) pk)))
                       (p (car ws)) (q (cadr ws)))
                  (igr-reduce-ops!)
                  (fact 'isometry-group-compose-in 's u v)
                  (fact 'isometry-group-compose-in 's p q)
                  (igr-DS! u p) (igr-DS! v q)
                  (igr-DS! (igr-comp u v) (igr-comp p q))
                  (fact 'isometry-group-compose-dist 's u v p q)
                  (fact 'rr-pos-rr-in-rr e)
                  (fact 'rr-pos-rr-in-rr h)
                  (dk-ineq! (list '<= (igr-S (igr-comp u v) (igr-comp p q)) (list '+ (igr-S u p) (igr-S v q)))
                            (list '= (igr-D (igr-comp u v) (igr-comp p q)) (igr-S (igr-comp u v) (igr-comp p q)))
                            (list '= (igr-D u p) (igr-S u p)) (list '= (igr-D v q) (igr-S v q))
                            (list '<= (igr-D u p) h) (list '<= (igr-D v q) h)
                            (list '= (list '+ h h) e)
                            (list 'IN (igr-D (igr-comp u v) (igr-comp p q)) 'RR)
                            (list 'IN (igr-S (igr-comp u v) (igr-comp p q)) 'RR)
                            (list 'IN (igr-D u p) 'RR) (list 'IN (igr-S u p) 'RR)
                            (list 'IN (igr-D v q) 'RR) (list 'IN (igr-S v q) 'RR)
                            (list 'IN h 'RR) (list 'IN e 'RR))))))))
      ;; the inverse is continuous: delta = eps
      ((eq? (igr-head g) 'IS-CONTINUOUS)
       (mac 'is-continuous)
       (subst (list '== (list 'PTS igr-M) igr-G))
       (dk-conj-close!
        (lambda ()
          (if (not (eq? (igr-head (dk-goal)) 'FORALL))
              (ass)
              (let ((a (dk-di-var!)))
                (mac 'is-continuous-at)
                (subst (list '== (list 'PTS igr-M) igr-G))
                (dk-conj-close!
                 (lambda ()
                   (if (not (eq? (igr-head (dk-goal)) 'FORALL))
                       (ass)
                       (let* ((pe (dk-peel!))
                              (e (cadr (car (filter (lambda (f) (eq? (igr-head f) 'POS-RR)) pe)))))
                         (ew e)
                         (dk-conj-close!
                          (lambda ()
                            (if (not (eq? (igr-head (dk-goal)) 'FORALL))
                                (ass)
                                (let ((b (dk-di-var!)))
                                  (dk-peel!)
                                  (igr-reduce-ops!)
                                  (fact 'isometry-group-inverse-in 's a)
                                  (fact 'isometry-group-inverse-in 's b)
                                  (igr-DS! a b) (igr-DS! b a)
                                  (igr-DS! (igr-inv a) (igr-inv b))
                                  (fact 'isometry-group-inverse-dist 's a b)
                                  (fact 'metric-sym igr-M a b)
                                  (fact 'rr-pos-rr-in-rr e)
                                  (dk-ineq! (list '<= (igr-S (igr-inv a) (igr-inv b)) (igr-S b a))
                                            (list '= (igr-D (igr-inv a) (igr-inv b)) (igr-S (igr-inv a) (igr-inv b)))
                                            (list '= (igr-D b a) (igr-S b a))
                                            (list '= (igr-D a b) (igr-D b a))
                                            (list '<= (igr-D a b) e)
                                            (list 'IN (igr-D (igr-inv a) (igr-inv b)) 'RR)
                                            (list 'IN (igr-S (igr-inv a) (igr-inv b)) 'RR)
                                            (list 'IN (igr-D b a) 'RR) (list 'IN (igr-S b a) 'RR)
                                            (list 'IN (igr-D a b) 'RR) (list 'IN e 'RR)))))))))))))))
      (#t (ass))))))
(qed 'isometry-group-is-metric-group-gm)
(topic! 'isometry-group-is-metric-group-gm 'analysis)
(alias! 'isometry-group-is-metric-group-gm
        "the isometry group of a compact metric space, with composition and the sup metric, is a metric group")

(sp (make-wff '(FORALL s (IMPLIES (IS-COMPACT s)
     (AND (IS-COMPACT (ISOMETRY-GROUP-MS s))
          (IS-GROUP-METRIC (ISOMETRY-GROUP-MS s) (ISOMETRY-GROUP-GRP s)))))))
(dk-peel!)
(fact 'isometry-group-compact 's)
(fact 'isometry-group-is-metric-group-gm 's)
(dk-conj-close! (lambda () (ass)))
(qed 'isometry-group-compact-metric-group-gm)
(topic! 'isometry-group-compact-metric-group-gm 'analysis)
(alias! 'isometry-group-compact-metric-group-gm
        "the isometry group of a compact metric space is a compact metric group")
